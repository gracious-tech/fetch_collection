<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZK" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ህዝቄላ ማፃፋ</para>
  <para style="toc1">ህዝቄላ ማፃፋ</para>
  <para style="toc3">ህዝ</para>
  <para style="toc2">ህዝቄላ</para>
  <para style="mt">ህዝቄላ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ህዝቄል ክ.የ.ስ. 597 ላይን ድኤትድ ባብሎነ ብዳ አሳፐ እሱዋ፥ ሽን እያ ዎደን ደእዳ ኤርምያስ ድኤትድ ቦና የሩሳላመን አትስ። ሄ ዎደ ካዎይ ዮአክን፥ ይሁዳፐ እያራ እስፈ ድኤትድ ብስ (<char style="xt"><ref loc="2KI 24:11-16">2 ካዎ 24:11-16</ref>፤ <ref loc="EZK 1:2">ህዝ 1:2</ref></char>)። ባብሎነት እያ በሳን ሰደቅያሳ ካዎ ኦድ ሹምዶሶና (<char style="xt"><ref loc="2KI 24:17-25:21">2 ካዎ 24:17—25:21</ref>፤ <ref loc="JER 1:3">ኤርም 1:3</ref></char>)። ናብያ ህዝቄል፥ የሩሳላመይ ላለታናፐ ስንነ ላለትዳፐ ጉየ፥ ድኤትድ ባብሎነን ደእስ። እ ትንብተ ኦድዳይ ባብሎነን ድኤትድ ደእያ አሳስነ የሩሳላመን ደእያ አሳሳ።</para>
  <para style="ip">ህዝቄል ግታ አማኖይ ደእያ አስነ ሃስድ ቆፕያ አስ። ስንፈ ሀናናባ ኡባ ቆንጨን በእስ። እያ ኪታፐ ዳሮ ባጋይ ቆንጭዳይ ሌምሶና። ህዝቄል፥ አስ ባ ጋ አሳተን፥ ባ ዎዛናንነ ባ አያናን ኦራፃናዉ ኮሸይሳነ እስ እስ አስ ባ ናጋራን ኦይሸታናዉ ደኤይሳ ፓድድ በስስ (<char style="xt"><ref loc="EZK 36:22-38">36:22-38</ref>፤ <ref loc="EZK 37:26">37:26</ref>፤ <ref loc="EZK 18:19-20">18:19-20</ref></char>)። ህዝቄል ካህነነ ናበ ግድያ ግሾ፥ ፆሳ ኬባነ ጌሻተባ ዱማይድ በስስ። ህዝቄል ባዉ ዱማትዳ አስ፤ እ በእዳ ቆንጨት አሳስ እማ፤ እ ባ ኪታ ኦዳናዉ ጎኤትዳ ኦገትካ እማ። እስራኤለነ ይሁዳ ሀኖታ በሳናዉ ባንታ አዝና አግድ ላይማታናዉ ከይዳ ጌላኦታ ሌምሶን በሴስ (ሸም 16፥ 23)።</para>
  <para style="ip">ህዝቄል ትንብተ ኦድዳይ ባንታ ቢታን ደእያ ይሁዳ አሳስ ግዶናሽን፥ እያራ እስፈ ድኤትድ ባብሎነን ዋየንነ መቶን ደእያ አሳሳ (ሸም 4-24)። እያ ኪታይ ፆሳ ቦንቾነ ጌሻተ ቦላ ጫድድ ኦዴስ። እስራኤለይ ፆሳራ ገልዳ ጫቁዋ መንሱ (ሸም 16-17)፤ ፆሳ ኬ፥ የሩሳላመ ካታማነ ቢታ ኩመ ቱንሳሱ። ሄሳ ግሾ፥ ፆሳይ ባ አሳ ላላናነ ፕርዳና፤ የሩሳላመ ካታማይ ያና። የሩሳላመይ ተቀታናይስነ ያናይስ እያዉ ኦደትያ ዎደ (<char style="xt"><ref loc="EZK 24:1-14">24:1-14</ref></char>)፥ እያ ማችያ ሀይቃናይስካ እያዉ ኦደትስ። እ ባ ማቼስ ዬኮና መላ እያዉ ኦደትስ፤ ሄስካ ድኦን ደእያ አሳይ የሩሳላመይ ይያ ዎደ ዬኮና መላ ኦዳናሳ (<char style="xt"><ref loc="EZK 24:15-27">24:15-27</ref></char>)።</para>
  <para style="ip">ፆሳይ ባ ጫቁዋ ናግያ ግሾ፥ ባ ሱን ቦንችያ ግሾነ ባ አሳ አሻናዉ ኮያ ግሾ፥ እ ባ አሳ ጌሻናነ ዛሪድ ኤንታ፥ ኤንታ ቢታን ኤሳና።</para>
  <para style="ip">ህዝቄላ ማፃፋይ ኦይዱ ክፍለታን ሻከቴስ።</para>
  <para style="ipi">1. ፆሳ ፕርዳይ አሳ ቦላ ያናዉ ማትዳይሳነ የሩሳላመ ኦይከተይነ ላለተይ ጋክዳይሳ ምንድ ኤርስያ ክፍልያ (ሸም 1—3)።</para>
  <para style="ipi">2. ፆሳይ ባ ደርያ ኡንኤድ ሃርዳ ዱማ ዱማ ካዎተታ ሴራናዉ ደኤይሳ ኦድያ ክፍልያ (ሸም 4—24)።</para>
  <para style="ipi">3. የሩሳላመ ኩንደፈ ጉየ እስራኤለ አሳ ምንናዉ እመትዳ ኪታነ ስንፈ ሎኦ ቃድ ደኤይሳ ኦድያ ኡፋይሳ ቃል ደእያ ክፍልያ (ሸም 25—32)።</para>
  <para style="ipi">4. ፆሳ ኬነ እስራኤለ ካዎተይ በን ባ በሳ ስማናይሳ ህዝቄል ምስለን ቆንጭስዳ ክፍልያ (ሸም 33—48)።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ህዝቄላ ፄገተነ ቆንጨ (<char style="ior"><ref loc="EZK 1:1-3:27">1:1—3:27</ref></char>)</para>
  <para style="io1">የሩሳላመነ ይሁዳ ቦላ ኦደትዳ ፕርዳ (<char style="ior"><ref loc="EZK 4:1-24:27">4:1—24:27</ref></char>)</para>
  <para style="io2">ያና ፕርዳ በሲያ ማላታ (<char style="ior"><ref loc="EZK 4:1-5:17">4:1—5:17</ref></char>)</para>
  <para style="io2">ያና ፕርዳ በሲያ ኪታታ (<char style="ior"><ref loc="EZK 6:1-7:27">6:1—7:27</ref></char>)</para>
  <para style="io2">ያና ፕርዳ በሲያ ቆንጨታ (<char style="ior"><ref loc="EZK 8:1-11:25">8:1—11:25</ref></char>)</para>
  <para style="io2">ያና ፕርዳ በሲያ ሌምሶታ (<char style="ior"><ref loc="EZK 12:1-24:27">12:1—24:27</ref></char>)</para>
  <para style="io1">አላጋ ካዎተታስ ኦደትዳ ፕርዳ (<char style="ior"><ref loc="EZK 25:1-32:32">25:1—32:32</ref></char>)</para>
  <para style="io1">ያና ኡፋይሳ ኦድያ ትንብተ (<char style="ior"><ref loc="EZK 33:1-39:28">33:1—39:28</ref></char>)</para>
  <para style="io1">ያና ኡፋይሳ በሲያ ቆንጨ (<char style="ior"><ref loc="EZK 40:1-48:35">40:1—48:35</ref></char>)</para>
  <chapter number="1" style="c" sid="EZK 1"/>
  <para style="s1">ፆሳ ቦንቹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 1:1"/>ሀስታማን ላይን፥ ኦይዳን አጌናን፥ እቻሻን ጋላስ፥ ታኒ ኮቦራ ሻፋን ድኤትዳ አሳ ግዶን ደእሽን ሳሎት ዶየትን፥ ፆሳ ቆንጨ በአስ። <verse eid="EZK 1:1"/><verse number="2" style="v" sid="EZK 1:2"/>ካዎይ ዮአክን ድኤትዳ እቻሻን ላይን፥ ሄ አጌናን እቻሻን ጋላሳን፥ <verse eid="EZK 1:2"/><verse number="3" style="v" sid="EZK 1:3"/>ካልዳወታ ቢታን ኮቦራ ሻፋ ማታን ደእያ ታኮ፥ ቡዛ ናኣ፥ ካህንያ ህዝቄላኮ፥ ጎዳ ቃላይ ይስ፤ ጎዳ ዎልቃይ ታና ሃርስ።<verse eid="EZK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 1:4"/>ታ ፄልያ ዎደ ጎተይ ፑደሀ ባጋፈ ይሽን በአስ፤ ዎልቃማ ሻራ ግዶፈ ዎልአን በንቴስ፤ እያ ዩሹዋን ደእያ ሳሎይ ፖእስ። ታማ ግዶ ባጋይ ጶልያ ናሰ ብራታ ዳኔስ። <verse eid="EZK 1:4"/><verse number="5" style="v" sid="EZK 1:5"/>እያ ግዶን ኦይዱ ደኦን ደእያ መተት ደኦሶና። ኤንታ ማላይ አሳ ማላ ዳኔስ። <verse eid="EZK 1:5"/><verse number="6" style="v" sid="EZK 1:6"/>ኤንታ እሱዋስ እሱዋስ ኦይዱ ኦይዱ ሶምኦይነ ኦይዱ ኦይዱ ቀፈይ ደኤስ። <verse eid="EZK 1:6"/><verse number="7" style="v" sid="EZK 1:7"/>ኤንታ ገዳይ ስት ግስ፤ ኤንታ ቶሆይ መሄ ቅንጫፍለ መላ፤ ሄ ቶሆት ቁችድ ጌሽዳ ናሰ ብራታዳ ጶሌስ። <verse eid="EZK 1:7"/><verse number="8" style="v" sid="EZK 1:8"/>ኤንታ ቀፍያፐ ጋርሳራ ኦይዱ ባጋራ አሳ ኩሸ ዳንያ ኩሸይ ደኤስ። ሄ ኦይዱ መተታስ ሶምኦይነ ቀፈይ ደኤስ። <verse eid="EZK 1:8"/><verse number="9" style="v" sid="EZK 1:9"/>ኤንታ ቀፈይ እሶይ እሱዋ ቦቼስ፤ ኤንቲ ኡባይ ያ ሃ ስሞና ስት ግድ ስን ቦሶና። <verse eid="EZK 1:9"/><verse number="10" style="v" sid="EZK 1:10"/>ኤንታ እሱዋስ እሱዋስ ስን ባጋራ አሳ ሶምኦይ ደኤስ፤ ኡሻቻ ባጋራ ጋሞ ሶምኦይ ደኤስ፤ ሀድርሳ ባጋራ ቦራ ሶምኦይ ደኤስ፤ ጉየ ባጋራ አርጋን ሶምኦይ ደኤስ። <verse eid="EZK 1:10"/><verse number="11" style="v" sid="EZK 1:11"/>ኤንታ ቀፈይ ቁ ግድ ምጨትድ ኡትስ፤ ኤንታ እሱዋ እሱዋ ናምኡ ቀፈይ ናምኡ ባጋራ ሀንኮ መተታ ቀፈይ ቦቼስ፤ ናምኡ ቀፈይ ኤንታ አሳተ ካሜስ። <verse eid="EZK 1:11"/><verse number="12" style="v" sid="EZK 1:12"/>ኤንቲ ኡባይ ስት ግድ ስን ቦሶና፤ ያ ሃ ስሞና፥ ፆሳ አያናይ ብያ ሶ አዉካ ቦሶና። <verse eid="EZK 1:12"/><verse number="13" style="v" sid="EZK 1:13"/>ሀ ደኦን ደእያ መተታ ግዶን እስ ኤፅያ ታማ ቦንቆ ዳነይስ ደኤስ። ሄ ታማይ ስንነ ጉየ ቃፅያ፥ ኤፅያ ፆምፐ ዳኔስ፤ ሄ ታማይ ጶሌስ፤ እያ ግዶፈ ዎልአን ከዬስ። <verse eid="EZK 1:13"/><verse number="14" style="v" sid="EZK 1:14"/>ሀ ደኦን ደእያ መተት ዎልአንዳ ስንነ ጉየ ኤሶን ስመረቶሶና።<verse eid="EZK 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 1:15"/>ሄኮ፥ ሀ ኦይዱ መተታ ታ በእያ ዎደ፥ ኤንታ ምየን፥ ሳአን ደእያ ገርቶታ በአስ፤ እስ እስ መተ ምየን እስ እስ ገርቶይ ደኤስ። <verse eid="EZK 1:15"/><verse number="16" style="v" sid="EZK 1:16"/>ሀ ገርቶት አልኦ ሹቻዳ ጶሎሶና፤ ኤንቲ ኦይዳይ መንነ ማላን እሶይ እሱዋ ዳኖሶና። እስ ገርቶይ ሀንኮ ገርቱዋ ግዶራ ካንድ አዳባ ዳኔስ። <verse eid="EZK 1:16"/><verse number="17" style="v" sid="EZK 1:17"/>ኤንቲ ብያ ዎደ ኦይዱ ባጋፈ አዉ ስሚድ ባነኮ ያ ሃ ስሞና ቦሶና። <verse eid="EZK 1:17"/><verse number="18" style="v" sid="EZK 1:18"/>ግታነ ያሽያ ኦይዱ ገርቶት ደኦሶና፤ ሄ ገርቶታስ ጋፅ ደኤስ፤ ሄ ጋፃ ዩሾይ አይፈን ኩምድ ኡትስ።<verse eid="EZK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 1:19"/>ሀ መተት ብያ ዎደ፥ ኤንታ ምየን ደእያ ገርቶት ገንደረቶሶና። ሄ መተት ቢታፈ ፑደ ደንድያ ዎደ ገርቶትካ ደንዶሶና። <verse eid="EZK 1:19"/><verse number="20" style="v" sid="EZK 1:20"/>አያናይ ብያ አዉካ ኤንቲ ደንድድ ቦሶና። ሄስ ሀነይ፥ ደኦ አያናይ ገርቶታ ግዶን ደእያ ግሾሳ። <verse eid="EZK 1:20"/><verse number="21" style="v" sid="EZK 1:21"/>ደኦ አያናይ ገርቶታ ግዶን ደእያ ግሾ፥ መተት ብያ ዎደ ገርቶት ቦሶና፤ መተት ኤቅያ ዎደ ገርቶት ኤቆሶና፤ መተት ቢታፈ ፑደ ደንድያ ዎደ ገርቶት ኤንታራ ደንዶሶና።<verse eid="EZK 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 1:22"/>ደኦን ደእያ መተታ ሁጰ ሶፐ ቦላ ባጋራ ማስቶተዳ ጶልድ አይፈ ጫድያ ሳሎ ጉፋን ዳንያባይ ምጨትድ ደኤስ። <verse eid="EZK 1:22"/><verse number="23" style="v" sid="EZK 1:23"/>ሄ ሳሎ ጉፋንዋፈ ጋርሳ ባጋራ ኤንታ ቀፈይ ስት ግድ፥ እሶይ እሱዋኮ ምጨትድ ኡትስ። ኤንታ ኡባስ ባንታ አሳተ ካምያ ናምኡ ናምኡ ቀፈይ ደኤስ። <verse eid="EZK 1:23"/><verse number="24" style="v" sid="EZK 1:24"/>መተት ፓልያ ዎደ ኤንታ ቀፍያ ግርሳይ ሃ ክፃ ጉንዳ፥ ኡባ ዳንዳእያ ፆሳ ቃላዳነ ዳሮ ኦላንቾታ ኮሽንቻዳ ሀነይሳ ስአስ። ኤንቲ ፓሎ አግያ ዎደ ባንታ ቀፍያ ሺሽድ ኤኮሶና።<verse eid="EZK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 1:25"/>ኤንቲ ባንታ ቀፍያ ሺሽ ኤክድ፥ ሄ በሳን ኤቅዳሽን፥ ኤንታ ሁጰ ሶፐ ቦላ ባጋራ ደእያ ሳሎ ጉፋንዋፈ ቦላ ቃፈ ግርስ ስኤትስ። <verse eid="EZK 1:25"/><verse number="26" style="v" sid="EZK 1:26"/>ሳሎ ጉፋንዋፈ ቦላ ባጋራ ሳንፓረ ጌተትያ አልኦ ሹቻፈ መትዳ አራታ ዳነይስ ደኤስ፤ አራታ ዳነይሳ ቦላ አሰ ዳነይስ ኡትስ። <verse eid="EZK 1:26"/><verse number="27" style="v" sid="EZK 1:27"/>ታኒ እያ በእያ ዎደ እያዉ ፄሰ ዳነይሳፈ ቦላ ባጋይ ታማን ደእያ ናሰ ብራታዳ ጶሌስ። እያፐ ጋርሳ ባጋይ ታማ ዳኔስ፤ እያ ዩሾን ጶልያ ፖኦይ ደኤስ። <verse eid="EZK 1:27"/><verse number="28" style="v" sid="EZK 1:28"/>እያ ዩሹዋን ደእያ ጶልያ ፖኦይ እራ ዎደ ሻራን ኤቅያ ዙላ ዳኔስ።</para>
  <para style="p" vid="EZK 1:28">ሀይስ ጎዳ ቦንቾ ቆንጨ ዳኔስ። ታኒ ሄሳ በእዳ ዎደ ቢታን ዱገ ጉፋናዳ እስ ቃላ ግርስ ስአስ።<verse eid="EZK 1:28"/></para>
  <chapter eid="EZK 1"/>
  <chapter number="2" style="c" sid="EZK 2"/>
  <para style="s1">ህዝቄላ ፄገተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 2:1"/>እ ታኮ፥ “አሳ ናአዉ፥ ደንዳ ኤቃ። ታ ኔራ ኦደታናዉ ኮያይስ” ያግስ። <verse eid="EZK 2:1"/><verse number="2" style="v" sid="EZK 2:2"/>እ ታራ ኦደትያ ዎደ ፆሳ አያን ታ ግዶ ገልድ፥ ታና ታ ቶሁዋን ኤስስ፤ እ ታዉ ኦደይሳ ስአስ።<verse eid="EZK 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 2:3"/>“አሳ ናአዉ፥ ታ ነና እስራኤለ አሳኮ፥ ታ ቦላ ማካልዳ ደርያኮ ኪታይስ። ኤንትነ ኤንታ ማይዛት ሀች ጋካናዉ ታ ቦላ ማካልዳ መላ ደኦሶና። <verse eid="EZK 2:3"/><verse number="4" style="v" sid="EZK 2:4"/>ኤንቲ ዎዛና ሙመነ ዬል ባይናይሳታ ግድያ ግሾ፥ ታ ነና ኤንታኮ ኪታይስ። ታኒ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጋይስ። <verse eid="EZK 2:4"/><verse number="5" style="v" sid="EZK 2:5"/>ሀ ማካላንቾ አሳይ ስእን፥ ስኦና እፅን፥ ናበይ ኤንታ ግዶን ደኤይሳ ኤንቲ ኤራና። <verse eid="EZK 2:5"/><verse number="6" style="v" sid="EZK 2:6"/>አሳ ናአዉ፥ ኤንታዉነ ኤንታ ቃላስ ያዮፋ! ክንቾተይነ ፁንዱቀይ ነ ዩሾን ደእኮካ፥ ቃስ ኮርነታ ግዶን ነ ኡትኮካ ያዮፋ። ኤንቲ ማካላንቾ ኮቸ ግድያ ግሾ ኤንታዉ ዎይኮ ኤንታ ቃላስ ያዮፋ። <verse eid="EZK 2:6"/><verse number="7" style="v" sid="EZK 2:7"/>ኤንቲ ማካላንቾ ኮቸ ግድያ ግሾ ኤንቲ ስእን፥ ስኦና እፅን ታ ቃላ ኤንታዉ ኦዳ። <verse eid="EZK 2:7"/><verse number="8" style="v" sid="EZK 2:8"/>ሽን፥ አሳ ናአዉ፥ ታ ነዉ ኦደይሳ ስአ። ሀ ማካላንቾ አሳዳ ነካ ማካላንቾ ግዶፓ፤ ነ ዶና ዶያዳ ታ ነዉ እመይሳ ማ” ያግስ።<verse eid="EZK 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 2:9"/>ታ ፄልያ ዎደ፥ ሄኮ፥ ታኮ ምጨትዳ ኩሸ በአስ፤ ሄ ኩሽያን ፃ ማፃፍ ደኤስ። <verse eid="EZK 2:9"/><verse number="10" style="v" sid="EZK 2:10"/>እ ታ ስንን ሄ ፃ ማፃፋ ብልስ፤ ሄ ማፃፋስ ናምኡ ባጋራ ዬሆይ፥ አዛኖይነ ዘለልስ ሁጰ ቆፋ ግድድ ፃፈትስ።<verse eid="EZK 2:10"/></para>
  <chapter eid="EZK 2"/>
  <chapter number="3" style="c" sid="EZK 3"/>
  <para style="p">
    <verse number="1" style="v" sid="EZK 3:1"/>ፆሳይ፥ “አሳ ናአዉ፥ ነ ስንን ደኤይሳ ማ፤ ሀ ፃ ማፃፋ ማ፤ ባዳ፥ እስራኤለ አሳስ ኦዳ” ያግስ። <verse eid="EZK 3:1"/><verse number="2" style="v" sid="EZK 3:2"/>ሄሳ ግሾ፥ ታኒ ታ ዶና ዶይን፥ እ ታና ፃፃ ማፃፋ ባርስስ። <verse eid="EZK 3:2"/><verse number="3" style="v" sid="EZK 3:3"/>እ ታኮ፥ “አሳ ናአዉ፥ ሀ ታ ነና ባርስያ ፃ ማፃፋ ማ፤ እያራ ነ ኡሉዋ ኩን” ያግስ። ታ ምያ ዎደ ታ ዶናን ኤሳዳ ማልእስ።<verse eid="EZK 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 3:4"/>ፆሳይ ታኮ፥ “አሳ ናአዉ፥ ደንዳዳ፥ እስራኤለ አሳኮ ባ፤ ታ ቃላ ኤንታዉ ኦዳ። <verse eid="EZK 3:4"/><verse number="5" style="v" sid="EZK 3:5"/>ኔኒ ኪተትዳይ፥ ኤንታ ዶናይ ኤረቶናነ ቃላይ ገሎና አሳኮ ግደና፤ ሽን ኔኒ እስራኤለ አሳኮ ኪተታዳሳ። <verse eid="EZK 3:5"/><verse number="6" style="v" sid="EZK 3:6"/>ታኒ ነና ኤንታ ቃላይ ገሎና፥ ኤንታ ዶናይ ኤረቶናነ አኬካናዉ መትያ ዳሮ ደርያኮ ታ ነና ኪታብከ። ታ ነና ኤንታኮ ኪትዳባ ግድያኮ፥ ኤንቲ ነ ኦድያባ ስአናሽን። <verse eid="EZK 3:6"/><verse number="7" style="v" sid="EZK 3:7"/>እስራኤለ አሳይ ታ ኦድያባ ስአናዉ ኮዮና ግሾ፥ ነ ኦደይሳ ስኦኮና። እስራኤለ አሳይ ዎዛና ሙመነ ዬል ባይናይሳታ ግድያ ግሾ ነ ኦድያባ ስኦኮና። <verse eid="EZK 3:7"/><verse number="8" style="v" sid="EZK 3:8"/>ሽን ታኒ ነና ኤንታዳ ዎዛና ሙመነ ዬል ባይናይሳ ኦና። <verse eid="EZK 3:8"/><verse number="9" style="v" sid="EZK 3:9"/>ታኒ ነና ያሽ ባይናነ ዛላፈ አዳ ምኖ ኦና። ኤንቲ ማካላንቾ ግድኮካ፥ ኤንታዉ ያዮፋ፤ ኤንታዉ ዳጋሞፋ” ያግስ።<verse eid="EZK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 3:10"/>ጉጅድ ፆሳይ፥ “አሳ ናአዉ፥ ታ ነዉ ኦድያ ቃላ ኡባ ምንዳ ስአ፤ አኬካ። <verse eid="EZK 3:10"/><verse number="11" style="v" sid="EZK 3:11"/>ድኦን ደእያ ነ አሳኮ ባዳ ኤንታዉ ኦዳ። ኤንቲ ስእን፥ ስኦና እፅን፥ ታኒ ኡባ ሃርያ ጎዳይ ኦደይሳ ኤንታዉ ኦዳ” ያግስ።<verse eid="EZK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 3:12"/>ሄሳፈ ጉየ፥ አያናይ ታና ፑደ ደንስ፤ ጎዳ ቦንቾይ ባ በሳፈ ፑደ ደንድያ ዎደ<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">እስ እስ ማፃፋታን “ሳሎን ደእያ ጎዳ ቦንቾይ ጋላተቶ” ያጌስ፤</char></note> ታፐ ጉየራ ዎልቃማ ጉን ስአስ። <verse eid="EZK 3:12"/><verse number="13" style="v" sid="EZK 3:13"/>ሄስካ፥ ደኦን ደእያ መተታ ቀፈይ እሶይ እሱዋራ ቦሸትያ ግርሳይነ ኤንታ ምየን ደእያ ገርቶታ ግርሳራ ጋሄትድ፥ ዎልቃማ ጉን ግርስ ስአስ። <verse eid="EZK 3:13"/><verse number="14" style="v" sid="EZK 3:14"/>አያናይ ታና ፑደ ደንስ፤ ታና ኤክድ ሀራ በሲ ኤፍስ፤ ጎዳ ግታ ዎልቃይ ታና ሃርስ፤ ታ አያናን ጫመታሸነ ይሎታሸ ባስ። <verse eid="EZK 3:14"/><verse number="15" style="v" sid="EZK 3:15"/>ኮቦራ ሻፋ ማታን፥ ተል-አብባን ደእያ ድኤትዳ አሳኮ ጋካስ። ታኒ ዳጋማዳ ያን ኤንታራ ላፑን ጋላስ ጋምአስ።<verse eid="EZK 3:15"/></para>
  <para style="s1">ህዝቄል ናግሶ አስ</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 3:16"/>ላፑን ጋላስ ዉርሰን ጎዳ ቃላይ ታኮ ሀይሳዳ ያግሸ ይስ፦ <verse eid="EZK 3:16"/><verse number="17" style="v" sid="EZK 3:17"/>“አሳ ናአዉ፥ ታ ነና እስራኤለ አሳ ናግያ አስ ኦስ። ታ ዶናፐ ከይያ ቃላ ስእዲ፥ ናጋና መላ ኤንታዉ ኦዳ። <verse eid="EZK 3:17"/><verse number="18" style="v" sid="EZK 3:18"/>ታኒ ናጋራንቹዋ፥ ‘ቱማ ኔኒ ሀይቃና’ ግያ ዎደ፥ ነ ባዳ እያዉ ኦዶና እፅኮ፥ እ ባ ኢታ ኦግያፐ ስማና መላነ እያ ሸምፖይ አታና መላ ነ እያ ናግሶና እፅኮ፥ እ ባ ናጋራን ሀይቃና፤ ሽን እያ ሱ ግሾ ታ ነና ኦይቻና። <verse eid="EZK 3:18"/><verse number="19" style="v" sid="EZK 3:19"/>ኔኒ ናጋራንቹዋስ ኦድን፥ እ ባ ናጋራፐነ ባ ኢታ ኦግያፐ ስሞና እፅኮ፥ እ ባ ናጋራን ሀይቃና፤ ሽን ኔኒ ነ ሁጵያ አሻና።<verse eid="EZK 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 3:20"/>“ፅሎ አስ ባ ፅሎተፈ ጉየ ስሚድ፥ ኢታ ኦያ ዎደ ታ እያ ስንን በ ዎን፥ እ ሀይቃና። እ ስማና መላ ነ እያዉ ኦዶና ግሾ እ ባ ናጋራን ሀይቃና። እ ካሰ ኦዳ ፅሎ ኦሶይ ዛሪድ ቆፈተና፤ ሽን ታኒ እያ ሱ ግሾ ነና ኦይካና። <verse eid="EZK 3:20"/><verse number="21" style="v" sid="EZK 3:21"/>ሽን ፅሎ አስ ናጋራ ኦና መላ ነ እያዉ ኦድን፥ እ ነ ኪታ ስእድ፥ ናጋራ ኦና አግኮ፥ ቱማ እ ደኦን ዳና፤ ኔኒ ነና አሻና” ያግስ።<verse eid="EZK 3:21"/></para>
  <para style="s1">ህዝቄላ ዶናይ ሙምስ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 3:22"/>ሄ በሳን ጎዳ ዎልቃይ ታና ሃርስ፤ እ ታኮ፥ “ደንዳዳ ዛንጋራ ባ፤ ያን ታ ነዉ ኦዳና” ያግስ። <verse eid="EZK 3:22"/><verse number="23" style="v" sid="EZK 3:23"/>ታ ደንዳዳ፥ ዛንጋራ ባስ። ሄ በሳን ካሰ ኮቦራ ሻፋ ማታን ታ በእዳይሳዳ፥ ያን ጎዳ ቦንቹዋ በአስ፤ ታኒ ሳአን ሶምኦራ ጉፋናስ።<verse eid="EZK 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 3:24"/>ሽን አያናይ ታ ግዶ ገልድ፥ ታና ታ ቶሃን ኤስስ። ጎዳይ ታኮ፥ “ነ ሶ ባዳ፥ ነ ቦላ ፐንግያ ጎርዳዳ ኡታ። <verse eid="EZK 3:24"/><verse number="25" style="v" sid="EZK 3:25"/>አሳ ናአዉ፥ ነ ዎዶሮን ቃሸታና፤ አሳኮ ከያናዉ ዳንዳአካ። <verse eid="EZK 3:25"/><verse number="26" style="v" sid="EZK 3:26"/>ሀ ማካላንቾ አሳስ ነ ኦዶና መላነ ኤንታ ቦላ ሀንቀቶና መላ ታ ነ ዶና ሙምሳና። <verse eid="EZK 3:26"/><verse number="27" style="v" sid="EZK 3:27"/>ሽን ታ ነዉ ኦድያ ዎደነ ነ ዶና ዶይያ ዎደ ኔኒ፥ ‘ኡባ ሃርያ ጎዳይ፥ ኤንቲ ማካላንቾ ግድያ ግሾ፥ ስእያ ኦንካ ስኦ፤ ስኦና እፅያ ኦንካ ስኦፖ’ ያጋዳ” ኦዳና።<verse eid="EZK 3:27"/></para>
  <chapter eid="EZK 3"/>
  <chapter number="4" style="c" sid="EZK 4"/>
  <para style="s1">የሩሳላመ ተቀተ ሌምሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 4:1"/>“ነኖ አሳ ናአዉ፥ ቢታፈ መዳ ፁበ ኤካዳ፥ ነ ስንን ዎ፤ ያታዳ የሩሳላመ ካታማ ምስለ እያ ቦላ መ። <verse eid="EZK 4:1"/><verse number="2" style="v" sid="EZK 4:2"/>ካታማ ዩሹዋ ድራ፤ እያ ቢታ ዶራ፤ ሚፃ ኬ፤ ኦላንቾት ኡትያ በሲ ጊግሳ፤ ግምብያ ላልያ ዱሩማ እያ ዩሾን ጊግሳ። <verse eid="EZK 4:2"/><verse number="3" style="v" sid="EZK 4:3"/>ብራታ ባሸ ኤካዳ፥ ነ ግዶንነ ካታማ ግዶን ድርስ ኦዳ ኤሳ። ነ ሶምኡዋ እያኮ ዛራዳ ደሬቃ፤ ካታማ ዩሹዋ ተቃ፤ እያ ተቀይካ ነና፤ ሄስካ እስራኤለ አሳስ ማላ ግዳና።<verse eid="EZK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 4:4"/>“እስራኤለ አሳ ሴረተስ ማላ ግዳና መላ ኔኒ ነ ሀድርሳ ምየን ዝንአ። ኔኒ ነ ሀድርሳ ምየን ዝንእያ ጋላሳታ ታይቡዋን እስራኤለ አሳይ ዋንድ ሴረታናዉ ደእያኮ በሳና። <verse eid="EZK 4:4"/><verse number="5" style="v" sid="EZK 4:5"/>እስራኤለ አሳይ ዋንድ ሴረታናዉ ደእያኮ በሳናዉ ኔኒ ዝንአና መላ ሄ ፄታነ ኡዱፉን ታሙ ጋላስ ነዉ እማስ፤ እስ ጋላስ እስ ላይራ ግና ግዳና።<verse eid="EZK 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 4:6"/>“ኔኒ ሄ ጋላሳታ ፖልዳፐ ጉየ፥ ዛራዳ፥ ይሁዳ አሳይ ዋንድ ሴረታናዉ ደእያኮ በሳናዉ ነ ኡሻቻ ምየን ዝንአና መላ ኦይታሙ ጋላስ ነዉ እማስ። እስ ጋላስ እስ ላይራ ግና ግዳና። <verse eid="EZK 4:6"/><verse number="7" style="v" sid="EZK 4:7"/>ነ ሶምኡዋ ተቀትዳ የሩሳላመኮ ዛራዳ፥ ነ ኩሽያ ደንዳ ማንዳሸ፥ የሩሳላመ ቦላ ትንብተ ኦዳ። <verse eid="EZK 4:7"/><verse number="8" style="v" sid="EZK 4:8"/>ሄ ተቀይ ዉራና ጋካናዉ እስ ምየፐ ሀራ ምየ ሽረቶና መላ ታ ነና ዎዶሮን ቃቻና።<verse eid="EZK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 4:9"/>“ኔኒ ግስተነ ባንጋ፥ ቆምኦሎነ ምስረ፥ ማልዶነ ሙርቃ ኤካዳ፥ ካ ዎያ ሚሸን ቆላዳ፥ ኔኒ ዝንእያ ሄ ፄታነ ኡዱፉን ታሙ ጋላስ እያፐ ካዳ ማና። <verse eid="EZK 4:9"/><verse number="10" style="v" sid="EZK 4:10"/>ጋላስ ጋላስ ነ ምያ ካ ማዛና፤ እካ ናምኡ ፄታነ ሀስታሙ ግራመ ግዶ፤ ሄሳ እያ ዎደን ዎደን ማ። <verse eid="EZK 4:10"/><verse number="11" style="v" sid="EZK 4:11"/>ጋላስ ጋላስ ነ ኡያ ሃይካ ልከራ ግዶ፤ እካ ናምኡ ኩባያ ግዶ፤ ሄሳ እያ ዎደን ዎደን ኡያ። <verse eid="EZK 4:11"/><verse number="12" style="v" sid="EZK 4:12"/>ዎራ ሼሻ ከምኤለ ኤዳ፥ አሳይ ፄልሽን፥ ሄ ዋላክዳ ካ ባንጋ ኡይዳ ኡካዳ ማ። <verse eid="EZK 4:12"/><verse number="13" style="v" sid="EZK 4:13"/>ሄስ እስራኤለ አሳይ ታ ኤንታ ላልያ ካዎተታ ግዶን ደእሸ፥ ቱንዳ ካ ማናዉ ደኤይሳስ ማላ” ያግስ።<verse eid="EZK 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 4:14"/>ታኒ፥ “ሀይእ! ኡባ ሃርያ ጎዳዉ፥ ሄስ ሀነና፤ ታኒ ቱናዳ ኤርከ። ታ ናአተፈ ዶማዳ ሀች ጋካናዉ፥ ባዉታ ዎይኮ ዶእ ዎዳባ ማ ኤርከ፤ ቱንዳ አሾይ ታ ዶናኮ ሺቅ ኤረና” ያጋስ።<verse eid="EZK 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 4:15"/>እ ዛሪድ፥ “ሎኦ፥ ያትኮ፥ ዎራ ሼሻ ከምኤለን ኡከይሳ አጋዳ፥ ኦሻ ከምኤለን ነ ኡይ ኡካ” ያግስ።<verse eid="EZK 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 4:16"/>እ ጉጅድ፥ “ነኖ፥ አሳ ናአዉ፥ አኬካ! የሩሳላመ ካታማ ካ ገሎና መላ ታኒ ተቃና ሀናይስ። አሳይ ካ ህርግሸ ማክድ ማና፤ ሃ ያይሸ ልክድ ኡያና። <verse eid="EZK 4:16"/><verse number="17" style="v" sid="EZK 4:17"/>ህዛ፥ ኤንታዉ ደእያ ካይነ ሃይ ዉራና፤ ኤንቲ ዳጋማን እሶይ እሱዋ ፄላና፤ ባንታ ናጋራ ጋሶን ሴረትድ ግልቃና።<verse eid="EZK 4:17"/></para>
  <chapter eid="EZK 4"/>
  <chapter number="5" style="c" sid="EZK 5"/>
  <para style="p">
    <verse number="1" style="v" sid="EZK 5:1"/>“ነኖ፥ አሳ ናአዉ፥ ኦጮ ማሽ ኤካዳ፥ ማቅላራ ሜድያዳ ነ ሁጵያነ ነ ቡቻ ሜዳ። ሄ ሁጵያ ምዛነን ማዛና፤ ነ ብናና ሄ በሳን ሻካ። <verse eid="EZK 5:1"/><verse number="2" style="v" sid="EZK 5:2"/>ኔኒ ተቅያ ጋላሳይ ዉርያ ዎደ፥ ነ ሻክዳ ብናናፐ ስኩዋ ነ ጊግስዳ ካታማ ምስልያስ ግዱን ዎዳ ታማን ፁጋ። ናምአን ስኩዋ ሄ ካታማ ዩሹዋ ኡባን ማሻን ቃንፀረ። ሄን ስኩዋ ጫርኮ ቦላ ላላ፤ ታ ኤንታ ማሻን የደና። <verse eid="EZK 5:2"/><verse number="3" style="v" sid="EZK 5:3"/>እያፐ ጉ ብናና ኤካዳ፥ ነ ማኡዋ ማጫራን ቃቻ። <verse eid="EZK 5:3"/><verse number="4" style="v" sid="EZK 5:4"/>ቃስ እያፐ ጉራ ኤካዳ፥ ታማን የጋዳ ፁጋ። ያን ዶምዳ ታማይ እስራኤለ አሳ ኡባ ጋካና” ያግስ።<verse eid="EZK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 5:5"/>ኡባ ሃርያ ጎዳይ፥ “ካዎተታ ኡባ እያ ዩሾን ኤሳዳ፥ እያ ግዶን ዎዳ፥ የሩሳላመ ካታማ ሀይሳ በአ። <verse eid="EZK 5:5"/><verse number="6" style="v" sid="EZK 5:6"/>ሽን እ ባ ኢታ ኦሱዋን ባ ዩሹዋን ደእያ ቢታታፐነ ካዎተታፐ አድ ታ ህግያነ ታ ዎጋ ቦላ ማካልስ። ቱማ እ ታ ህግያ መንስ፤ ታ ዎጋ ካልቤና” ያጌስ።<verse eid="EZK 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 5:7"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ፥ “ነ ዩሹዋን ደእያ ካዎተታፐ አዳ መቶ መዳሳ፤ ታ ህግያ መንዳሳ፤ ታ ዎጋ ናጎና እፃዳሳ። ሀር አቶሽን፥ ነ ዩሹዋን ደእያ ካዎተታ ዎጋዳካ ደእቤከታ” ያጌስ። <verse eid="EZK 5:7"/><verse number="8" style="v" sid="EZK 5:8"/>ሄሳ ጋሶን፥ ኡባ ሃርያ ጎዳይ፥ “ነኖ፥ የሩሳላመ፥ ታኒ ነ ቦላ ደንዳና፤ ሀራ ካዎተት ኡባይ በእሽን፥ ነ ቦላ ታኒ ፕርዳ ኤሀና። <verse eid="EZK 5:8"/><verse number="9" style="v" sid="EZK 5:9"/>እፀትዳ ኤቃ ጎይኖ ኡባ ነ ኦዳ ግሾ፥ ሀይሳፈ ካሰ ኦቦና፥ ስንፈካ ዮና ፕርዳ ታ ነ ቦላ ኤሀና። <verse eid="EZK 5:9"/><verse number="10" style="v" sid="EZK 5:10"/>ሄሳ ጋሶን፥ ነ ግዶን አዋት ባንታ ናይታ ማና፤ ናይት ባንታ አዋታ ማና። ታ ህንተና ፕርዳና፤ አትዳይሳታ ጫርኮ ቦላ ላላና። <verse eid="EZK 5:10"/><verse number="11" style="v" sid="EZK 5:11"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ፥ ታኒ ታ ደኡዋን ጫቃይስ። ህንተ ኤቃታንነ እፀትዳ ኦሶታን ታ ኬ ቱንስዳ ግሾ፥ ታ ህንተና ቢታፈ ፕታዳ ይሳና። ታ ህንተዉ ቃትከ፤ ህንተና ማርከ። <verse eid="EZK 5:11"/><verse number="12" style="v" sid="EZK 5:12"/>ነ ግዶን ደእያ አሳፐ እስ ስኮይ ካታማ ግዶን ቦሻንነ ኮሻን ሀይቃና፤ ናምአን ስኮይ ማሻን ዉራና፤ ሄን ስኩዋ ጫርኮ ቦላ ላላዳ፥ ኤንታ ማሻን የደና” ያጌስ።<verse eid="EZK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 5:13"/>“ታ ይሎይ ኤንታ ቦላ ፖለታና፤ ታ ዎልቃማ ሀንቆይ እርፃና። ታኒ ታ ሀንቁዋ ኤንታ ቦላ ዉርስያ ዎደ ታኒ ቃናተን ኦድዳይሳ ኤንቲ ኤራና።<verse eid="EZK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 5:14"/>“ነ ዩሹዋን ደእያ ካዎተታ ግዶንነ ህንተ ማታራ አያ ኡባ ስንን ታ ህንተና ባይሳ ኦና፤ ህንተና ሚቻስ አጋና። <verse eid="EZK 5:14"/><verse number="15" style="v" sid="EZK 5:15"/>ታ ህንተና ታ ሀንቁዋን፥ ታ ይሉዋንነ፥ ቃይ ባይና ሴራን ፕርድያ ዎደ ህንተ ዩሹዋን ደእያ ካዎተታ ስንን ቀልቅሰስ፥ ጫሻስ፥ ህንተና በእዳ አስ ናገትያባነ ዳጋምያባ ኦና። <verse eid="EZK 5:15"/><verse number="16" style="v" sid="EZK 5:16"/>ዱክያ ዶንጌ ቶራዳ፥ ታ ህንተና ዎያነ ይስያ ኮሻ ህንተ ቦላ የዳና። ታኒ ዛራ ዛራ ኮሻ ህንተ ቦላ ኤሀና፤ ካ የሩሳላመ ገሎና መላ ተቃና። <verse eid="EZK 5:16"/><verse number="17" style="v" sid="EZK 5:17"/>ታኒ ኮሻነ ዶአ ህንተ ቦላ የዳና፤ ኤንቲ ህንተ ናይታ ይሳና፤ ቦሻነ ሸምፖ ዎ ህንተ ቦላ ኤሀና” ያጌስ ጎዳይ።<verse eid="EZK 5:17"/></para>
  <chapter eid="EZK 5"/>
  <chapter number="6" style="c" sid="EZK 6"/>
  <para style="s1">እስራኤለ ዙማታስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 6:1"/>ጎዳ ቃላይ ታኮ ሀይሳዳ ያግሸ ይስ። <verse eid="EZK 6:1"/><verse number="2" style="v" sid="EZK 6:2"/>“ነኖ፥ አሳ ናአዉ፥ እስራኤለ ዙማታ ደሬቃ ፄላሸ፥ ኤንታ ቦላ ትንብተ ኦዳ። <verse eid="EZK 6:2"/><verse number="3" style="v" sid="EZK 6:3"/>ህንተኖ፥ እስራኤለ ደረቶ፥ ኡባ ሃርያ ጎዳ ቃላ ስእተ። ኡባ ሃርያ ጎዳይ እስራኤለ ዙማታኮ፥ ዞዘታኮ፥ ዛንጋራታኮነ ካካታኮ ሀይሳዳ ያጌስ፦ ‘አሳይ ኤቃ ጎይንያ በሳታ ታኒ ይሳናዉ ማሻ የዳና። <verse eid="EZK 6:3"/><verse number="4" style="v" sid="EZK 6:4"/>ህንተ ያርሾ ፃርጴዛቲ ላለታና፤ ህንተ እፃነ ጩይስያ ሚሸት መቃና፤ ሀይቅዳ ህንተ አሳይ ህንተ ኤቃታ ስንን የገታና። <verse eid="EZK 6:4"/><verse number="5" style="v" sid="EZK 6:5"/>ታኒ እስራኤለ አሳ አሀ ኤንታ ኤቃታ ስንን ዝንእሳና፤ ህንተ መቀታ ህንተ ያርሾ ፃርጴዛታ ዩሾን ላላና። <verse eid="EZK 6:5"/><verse number="6" style="v" sid="EZK 6:6"/>ህንተ ደእያ በሳ ኡባን፥ ህንተ ካታማትነ ህንተ ጎይኖ በሳት ላለታና። ሄሳዳካ፥ ህንተ ያርሾ በሳይ ቱናናነ ላለታና፤ ህንተ ኤቃት መቃና፤ ህንተ እፃነ ጩይስያ ሚሸት መቃና፤ ህንተ ኦዳባ ኡባይ ፕተትድ ያና። <verse eid="EZK 6:6"/><verse number="7" style="v" sid="EZK 6:7"/>ሀይቅዳ አሳይ ህንተ ግዶን ኩንዳና። ታኒ ጎዳ ግደይሳ ህንተ ሄሳን ኤራና። <verse eid="EZK 6:7"/><verse number="8" style="v" sid="EZK 6:8"/>ታኒ ህንተ ግዶን ማሻፈ አትዳ ጉታ ፓፃ አሻና፤ ህንተ ቢታታንነ ካዎተታ ግዶን ላለታና። <verse eid="EZK 6:8"/><verse number="9" style="v" sid="EZK 6:9"/>ማሻፈ አትዳ ኤንቲ፥ ድኤትድ ብዳ ካዎተታ ግዶን ደእሸ ታና ሀሳያና። ኤንቲ ባንታ ላይማ ዎዛናንነ አሞትያ አይፍያን ኤቃ ጎይናናዉ ስሚድ ታ ዎዛና መንዳይሳ ኤንቲ አኬካና። ኤንቲ ባንታ ኢታ ኦሱንነ እፀትዳ ኤቃ ጎይኖ ጋሶን ባንታና ሻተታና። <verse eid="EZK 6:9"/><verse number="10" style="v" sid="EZK 6:10"/>ታኒ ጎዳ ግደይሳ ኤንቲ ኤራና። ታኒ ኤንታ ቦላ ኢታባ ኤሀና ግዳይ ጮ ባብሶ ግዶናይሳ ኤንቲ አኬካና’ ” ያጌስ።<verse eid="EZK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 6:11"/>ኡባ ሃርያ ጎዳይ ታኮ ሀይሳዳ ያጌስ፦ “እስራኤለ አሳይ እፀትዳ ኤቃ ጎይንዳ ግሾ፥ ነ ሀንቁዋ ብራ ማላዳ በሳ፤ ነ ይሉዋ ቢታ ቃካዳ ቆንጭሳ። ኤንታና አየ! ኤንቲ ኦላን፥ ኮሻንነ ጋዶን ዉራና። <verse eid="EZK 6:11"/><verse number="12" style="v" sid="EZK 6:12"/>ሃሆን ደኤይ ጋዶን ያና፤ ማታን ደኤይ ኦላን ሀይቃና፤ ፓፃ አትዳይ፥ ኮሻን ዉራና። ሄሳዳ ኦዳ፥ ታ ሀንቁዋ ኤንታ ቦላ ፖላና። <verse eid="EZK 6:12"/><verse number="13" style="v" sid="EZK 6:13"/>ኤንታ አሀይ ኤንታ ኤቃታ ግዶ ኡባን፥ ኤንታ ያርሾ በሳ ዩሾ ኡባን፥ ዙማታ ቦላ ኡባን፥ ደረ ቦላ ኡባን፥ ጭልኦ ም ጋርሳ ኡባን፥ ዳሻ ም ጋርሳ ኡባን፥ ባንታ ኤቃታስ ሳውያ ያርሾ ያርሽዳ በሳ ኡባን ኩንድዳ ዎደ ታኒ ጎዳ ግደይሳ ኤራና። <verse eid="EZK 6:13"/><verse number="14" style="v" sid="EZK 6:14"/>ታኒ ታ ኩሽያ የዳዳ፥ ኤንቲ ደእያ ቢታ ኡባ፥ ዱገሀ መላ ቢታፈ ብድ ፑደሀን ደእያ ደብላታ ጋካናዉ ባይሳ ኦና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄሳን ኤራና” ያጌስ።<verse eid="EZK 6:14"/></para>
  <chapter eid="EZK 6"/>
  <chapter number="7" style="c" sid="EZK 7"/>
  <para style="s1">ዉርሰ ጋክስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 7:1"/>ጎዳ ቃላይ ታኮ ሀይሳዳ ያግሸ ይስ። <verse eid="EZK 7:1"/><verse number="2" style="v" sid="EZK 7:2"/>“ነኖ አሳ ናአዉ፥ ኡባ ሃርያ ጎዳይ እስራኤለ ቢታኮ ሀይሳዳ ያጌስ፦ ‘ዉርሰ ማትስ፤ ኡባ ባጋራ ሀ ቢታ ቦላ ዉርሰ ይስ። <verse eid="EZK 7:2"/><verse number="3" style="v" sid="EZK 7:3"/>ሀእ፥ ዉርሰ ህንተ ቦላ ጋክስ፤ ታኒ ታ ሀንቁዋ ህንተ ቦላ የዳና። ታኒ ህንተ ኦሱዋዳ፥ ህንተ ቦላ ፕርዳና፤ ህንተ እፀትዳ ኤቃ ጎይንዳ ግሾ ህንተና ሴራና። <verse eid="EZK 7:3"/><verse number="4" style="v" sid="EZK 7:4"/>ታኒ ህንተዉ ቃትከ፤ ህንተና ማርከ። ህንተ ኢታ ኦሱዋዳ ህንተ ቦላ ፕርዳና፤ ህንተ ግዶን ደእያ እፀትዳ ኤቃ ጎይኖታ ቆንጭሳና። ታኒ ጎዳ ግደይሳ ህንተ ሄሳን ኤራና’ ” ያጌስ።<verse eid="EZK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 7:5"/>ኡባ ሃርያ ጎዳይ፥ “ሄኮ፥ ጋዶይ ጋክስ፤ ጋዶይ ጋዶ ቦላ ዬስ። <verse eid="EZK 7:5"/><verse number="6" style="v" sid="EZK 7:6"/>ዉርሰ ጋክስ፤ ዉርሰ ማትስ፤ እ ህንተ ቦላ ደንድስ፤ ሄኮ፥ ጋክስ። <verse eid="EZK 7:6"/><verse number="7" style="v" sid="EZK 7:7"/>ቢታ ቦላ ደኤይሳቶ፥ ህንተ ፕርዳይ ጋክስ፤ ዎደይ ማትስ፤ ጋላሳይ ማታትስ። ሄስ ዳጋማ ጋላስፐ አትሽን፥ ዙማታ ቦላ ኡፋይሳን እልልያ ጋላስ ግደና። <verse eid="EZK 7:7"/><verse number="8" style="v" sid="EZK 7:8"/>ሀእ ማታ ዎደ ታኒ ታ ሀንቁዋ ህንተ ቦላ ጉሳና፤ ታ ይሉዋ ህንተ ቦላ ዉርሳና። ታኒ ህንተ ኦሱዋ ግሾ ህንተ ቦላ ፕርዳና፤ እፀትዳ ኤቃ ጎይንዳ ግሾ ህንተና ሴራና። <verse eid="EZK 7:8"/><verse number="9" style="v" sid="EZK 7:9"/>ታ ህንተዉ ቃትከ፤ ህንተና ማርከ። ህንተ ኢታ ኦሱዋዳ ህንተ ቦላ ፕርዳና፤ ህንተ ግዶን ደእያ እፀትዳ ኤቃ ጎይኖታ ቆንጭሳና። ሄ ዎደ ህንተና ሴረይ ታና ጎዳ ግደይሳ ህንተ ኤራና።<verse eid="EZK 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 7:10"/>“ሄኮ፥ ጋላሳይ! ሄ ጋላሳይ ጋክስ! ህንተ ዮይ ማትስ! ህንተ ኢታተይ ጋምቡፅስ፤ ህንተ ኦቶሮይ ጪይስ። <verse eid="EZK 7:10"/><verse number="11" style="v" sid="EZK 7:11"/>ጌላተ ጋሶን ኢታ ኦሶይ ዳርስ። ኤንታፈ እሶይካ አተና፤ ኤንታ ሻሉዋፐ ዎይኮ ኤንታ አሳፐ ዎይኮ ኤንታ ቦንቹዋፈ አታናባይ ባዋ። <verse eid="EZK 7:11"/><verse number="12" style="v" sid="EZK 7:12"/>ዎደይ ጋክስ፤ ጋላሳይ ማትስ፤ ታ ሀንቆይ አሳ ኡባ ቦላ ግድያ ግሾ ሻመይስ ኡፋይቶፎ፤ ባይዘይስ አዛኖፖ። <verse eid="EZK 7:12"/><verse number="13" style="v" sid="EZK 7:13"/>ናምአይ ደኦን ደእያ ዎደ ኡባን፥ ባይዝዳይስ ባ ባይዝዳባ ኤካናዉ ጉየ ስመና። እስራኤለ አሳ ኡባ ቦላ ኦደትዳ ሀ ቆንጨይ ፖለቶና አተና። ኤንታ ናጋራ ጋሶን ኤንታፈ እሶይካ ባ ሸምፑዋ አሸና። <verse eid="EZK 7:13"/><verse number="14" style="v" sid="EZK 7:14"/>ታ ሀንቆይ አሳ ኡባ ቦላ ቆንጫናዉ ደእያ ግሾ ኤንቲ ኦላስ ሞይዘ ፑንድ ጊገቶኮና፤ ኦንካ ኦላስ ከየና።<verse eid="EZK 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 7:15"/>“ካረን ኦል ደኤስ፤ ሶን ቦሽነ ኮሽ ደኤስ። ካታማፐ ካረን ደኤይ ኦላን ሀይቃና፤ ካታማ ግዶን ደኤይ ቦሻንነ ኮሻንነ ዉራና። <verse eid="EZK 7:15"/><verse number="16" style="v" sid="EZK 7:16"/>ከስ ኤክድ አትዳይሳት፥ ዛንጋራፐ ያሻን ደረ ቦላ ፕራድ ከይዳ ሆለዳ፥ ባንታ ናጋራ ግሾ ደረ ቦላ ዘሌላና። <verse eid="EZK 7:16"/><verse number="17" style="v" sid="EZK 7:17"/>ኩሸ ኡባይ ዶጫና፤ ኡባይ ያሻን ኮኮርድ ሼሽ የጋና። <verse eid="EZK 7:17"/><verse number="18" style="v" sid="EZK 7:18"/>ኤንቲ ካዮ ማኦ ማአና፤ ያሻን ኮኮራና። ኤንታ ኡባ ሶምኦይ ዬላ ማአና፤ ኤንታ ኡባ ሁጰይ ሜደታና። <verse eid="EZK 7:18"/><verse number="19" style="v" sid="EZK 7:19"/>ኤንቲ ባንታ ብራ ኦገን ሆላና፤ ኤንታ ዎርቃይ ቱናባ ግዳና። ጎዳ ዎልቃማ ሀንቆ ጋላስ ኤንታ ብራይነ ኤንታ ዎርቃይ ኤንታ አሻናዉ ዳንዳኤና። ኤንታዉ በ ግድድ፥ ናጋራን ገልስዳ፥ ብራይነ ዎርቃይ ኡሎ ኩምድ፥ ኤንታ ኮሻፐ አሸና።<verse eid="EZK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 7:20"/>“ኤንቲ ባንታ አልኦ አሌቆታ ኦቶርትድ፥ እፀትዳ ኤቃነ ዬላይያ ምስለ መናዉ ጎኤትዶሶና። ሄሳ ግሾ፥ ታኒ ሄ አልኦ አሌቆታ ኤንታዉ ቱናባ ከሳስ። <verse eid="EZK 7:20"/><verse number="21" style="v" sid="EZK 7:21"/>ታኒ ኤንታ አሌቁዋ አላጋ ቢታ አሳስ ድኦ፥ ቢታን ደእያ ኢታ አሳስ ቦንቀ አዳ እማና፤ ኤንቲ እያ ቱንሳና። <verse eid="EZK 7:21"/><verse number="22" style="v" sid="EZK 7:22"/>ሄ ዎደ ታኒ ታ ሶምኡዋ ሀራ ሶ ዛራና፤ ታ ቦንቾ ኬ ፓንጋት ገልድ ቱንሳና።<verse eid="EZK 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 7:23"/>“ሱረ ፕርዳ ዮን ቢታይ ሱን ኩምዳ ግሾነ ካታማይ ጌላ ኦሶን ኩምዳ ግሾ ሳንላታ ጊግሳ። <verse eid="EZK 7:23"/><verse number="24" style="v" sid="EZK 7:24"/>ታኒ ኢታ ካዎተታ ኤሀዳ ኤንታ ኬታ ቦንቃና መላ ኦና። ዎልቃማታ ኦቶሩዋ ይሳና፤ ኤንታ ጌሻ ጎይኖ በሳት ቱናና። <verse eid="EZK 7:24"/><verse number="25" style="v" sid="EZK 7:25"/>ኤንቲ ዳጋምያ ዎደ ሳሮ ኮያና፤ ሽን ደሞኮና። <verse eid="EZK 7:25"/><verse number="26" style="v" sid="EZK 7:26"/>እስ ጋዶይ ሀራ ጋዶ ካለና፤ እስ ዎረይ ሀራ ዎረ ካልድ ያና። ኤንቲ ናበታፐ ቆንጨ ኮያና፤ ካህነታስ ታማርስያባይ ያና፤ ጭማታስ ዞርያባይ ያና። <verse eid="EZK 7:26"/><verse number="27" style="v" sid="EZK 7:27"/>ካዎይ ዬካና፤ ሀላቃይ ኡፋይስ ቃንፃና፤ አሳይ ያሻን ኮኮራና። ታኒ ኤንታዉ ኤንታ ኦሱዋዳ ኦና፤ ኤንቲ ሀራታ ቦላ ፕርድዳይሳዳ ታ ኤንታ ቦላ ፕርዳና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄሳን ኤራና” ያጌስ።<verse eid="EZK 7:27"/></para>
  <chapter eid="EZK 7"/>
  <chapter number="8" style="c" sid="EZK 8"/>
  <para style="s1">ፆሳ ኬን ደእያ ላይማተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 8:1"/>ኑኒ ድኤትዳ ኡሱፑን ላይን፥ ኡሱፑን አጌናን፥ እቻሻን ጋላሳን፥ ታኒ ታ ሶን ኡትዳሽን፥ ይሁዳ ጭማትካ ታ ስንን ኡትዳሽን፥ ኡባ ሃርያ ጎዳ ዎልቃይ ታና ሃርስ። <verse eid="EZK 8:1"/><verse number="2" style="v" sid="EZK 8:2"/>ሄኮ፥ ታኒ ቁ ጋዳ ፄልያ ዎደ አሰ ዳነይሳ በአስ። እያዉ ፄሰ ዳነይሳፈ ጋርሳ ባጋይ ታማ ላጮ ዳኔስ፤ ቦላ ባጋይ ጶልያ ናሰ ብራታ ዳኔስ። <verse eid="EZK 8:2"/><verse number="3" style="v" sid="EZK 8:3"/>እ ኩሸ ዳንያባ ታኮ የድድ፥ ታ ብናና ኦይክስ። አያናይ ታና ሳአፐነ ሳሎፐ ግዶ ፑደ ደንድ፥ ፆሳ ቆንጨን ታና የሩሳላመ ኤፍስ። ያን ቆሞ ባጋራ ፆሳ ኬ ግዶ ዳባባ ገልያ ፐንግያራ ገልስድ፥ ጎዳ ቃናትያ ደንያ ኤቃይ ኤቅዳ በሳ በስስ። <verse eid="EZK 8:3"/><verse number="4" style="v" sid="EZK 8:4"/>ሄኮ፥ ካሰ ታኒ ዛንጋራን በእዳይሳዳ፥ እስራኤለ ፆሳ ቦንቹዋ ያን በአስ።<verse eid="EZK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 8:5"/>ጎዳይ ታኮ፥ “ነኖ አሳ ናአዉ፥ ፑደሀ ባጋ ፄላ” ያግስ። ታኒ ፄልያ ዎደ ቃናተ ደንያ ኤቃይ፥ ድርሳ ፐንግያ ስንን ደእያ ያርሾ በሳ ማታን ደኤይሳ በአስ። <verse eid="EZK 8:5"/><verse number="6" style="v" sid="EZK 8:6"/>እ ታኮ፥ “ነኖ፥ አሳ ናአዉ፥ ኤንቲ ኦያባ በአይ? ታና ታ ጌሻ ኬፈ ሃሳናዉ፥ እስራኤለ አሳይ ኦያ እፀትዳ ኤቃ ጎይኑዋ በአይ? ሀይሳፈ አያ እፀትዳ ኤቃ ጎይኖ ኔኒ ቡሮ በአና” ያግስ።<verse eid="EZK 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 8:7"/>እ ታና ፆሳ ኬ ዳባባ ፐንገ ኤህን፥ ታኒ ፄልያ ዎደ፥ ሄኮ፥ ጎዳ ቦላ ፆኤ በአስ። <verse eid="EZK 8:7"/><verse number="8" style="v" sid="EZK 8:8"/>እ ታኮ፥ “ነኖ፥ አሳ ናአዉ፥ ጎዳ ቦካ” ያግን፥ ታ ቦክያ ዎደ እስ ፐንገ ያን በአስ። <verse eid="EZK 8:8"/><verse number="9" style="v" sid="EZK 8:9"/>እ ታኮ፥ “ገላዳ ኤንቲ ያን ኦያ ኢታ ኦሱዋነ እፀትዳ ኤቃ በአ” ያግስ። <verse eid="EZK 8:9"/><verse number="10" style="v" sid="EZK 8:10"/>ታ ግዶ ገላዳ ፄልያ ዎደ፥ ሄኮ፥ ሳአራ ጎሸትያ ዱማ ዱማ መተታ ምስለይ፥ ቱና ዶአታ ምስለይነ እስራኤለ አሳ ኤቃታ ኡባ ምስለይ ጎዳ ቦላ ዩይ አድ መት ኡትዳይሳ በአስ። <verse eid="EZK 8:10"/><verse number="11" style="v" sid="EZK 8:11"/>ኤንታፈ ስን ባጋራ እስራኤለ አሳፐ ላፑን ታሙ ጭማት ኤቅዶሶና፤ ሳፋና ናኣ ያእዛን ኤንታ ግዶን ኤቅስ። ኡባይ እፃነ ጩይስያባ ባንታ ኩሸን ኦይክዶሶና፤ እፃንያ ጩያይ ቱቁ ጌስ።<verse eid="EZK 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 8:12"/>ጎዳይ ታኮ፥ “ነኖ፥ አሳ ናአዉ፥ እስራኤለ አሳ ጭማት ኡባይ ማን ባንታ ኤቃ ምስልያ ኬን ኦያባ በአይ? ኤንቲ፥ ጎዳይ ኑና በኤና፤ ጎዳይ ሀ ቢታ አግስ” ያጎሶና። <verse eid="EZK 8:12"/><verse number="13" style="v" sid="EZK 8:13"/>እ ታኮ፥ “ሀይሳፈ አያ እፀትዳ ኤቃ ጎይኖ ኔኒ ቡሮ በአና” ያግስ።<verse eid="EZK 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 8:14"/>ሄሳፈ ጉየ፥ ፑደሀ ባጋን ደእያ ፆሳ ኬ ፐንግያኮ ኤፍን፥ ሄኮ፥ ማጫሳይ ያን ኡትድ፥ ታሙዛ ጌተትያ ባንታ ፆሳስ ዬክሽን በአስ። <verse eid="EZK 8:14"/><verse number="15" style="v" sid="EZK 8:15"/>እ ታኮ፥ “ነኖ አሳ ናአዉ፥ ሀይሳ በአይ? ሀይሳፈ አያ እፀትዳ ኤቃ ጎይኖ ኔኒ ቡሮ በአና” ያግስ።<verse eid="EZK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 8:16"/>ሄሳፈ ጉየ፥ እ ታና ፆሳ ኬ ግዶ ዳባባ ኤፍስ፤ ያን ፆሳ ኬ ፐንግያ ማታን፥ ባራንዳፈነ ያርሾ በሳፈ ግዶን፥ ላታማነ እቻሹ ግድያ አሳታ በአስ። ኤንቲ ባንታ ዞኩዋ ፆሳ ኬኮ፥ ባንታ ሶምኡዋ ዶሎሀኮ ዛሪድ፥ ዶሎሀራ ከይያ አዋ ጎይኖሶና።<verse eid="EZK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 8:17"/>ጎዳይ ታኮ፥ “ነኖ አሳ ናአዉ፥ ሀይሳ በአዲ? ይሁዳ አሳይ ሀ እፀትዳ ኤቃ ጎይኖይ ሀይሳን ኦይስ ኤንታዉ ላፋባ ግድዴ? ኤንቲ ቢታ ጌላ ኦሶን ኩንድ፥ ዛሪ ዛሪድ ታና ሀንቀናዉ በሲ? ኤንቲ ባንታዉ ዳንዳኤትዳ መላ ታና ኢስድ ጫዮሶና። <verse eid="EZK 8:17"/><verse number="18" style="v" sid="EZK 8:18"/>ሄሳ ግሾ፥ ታ ኤንታራ ሀንቆን ጋሄታና፤ ታ ኤንታዉ ቃትከ፤ ኤንታፈ እሱዋካ አሽከ። ኤንቲ ባንታ ቃላ ቃ ኦድ ዋስንካ፥ ታ ኤንታ ስእከ” ያግስ።<verse eid="EZK 8:18"/></para>
  <chapter eid="EZK 8"/>
  <chapter number="9" style="c" sid="EZK 9"/>
  <para style="s1">ኤቃ ጎይነይሳት ሀይቅዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 9:1"/>ሄሳፈ ጉየ፥ “ካታማ ሴራናዉ ዶረትዳ አሳት፥ ኦላ ሚሸ ባንታ ኩሸን ኦይክድ ሃ ዮሶና” ያግድ ዋስሽን ታኒ ስአስ። <verse eid="EZK 9:1"/><verse number="2" style="v" sid="EZK 9:2"/>ሄኮ፥ ዎያ ኦላ ሚሸ ባንታ ኩሸን ኦይክዳ ኡሱፑን አሳት፥ ፑደሀ ባጋን ደእያ ቆሞ ፐንግያፈ ይዶሶና። ኤንታራ እስፈ ሊኖፐ ኦሰትዳ ማኦ ማእድ፥ ባ ምየን ፃፍያባ ኮሮጆን ኦይክዳ እስ አስ ደኤስ። ኤንቲ ግዶ ገልድ፥ ናሰ ብራታፐ ኦሰትዳ ያርሾ በሳ ማታን ኤቅዶሶና።<verse eid="EZK 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 9:3"/>እስራኤለ ፆሳ ቦንቾይ ባ ደእያ ክሩበታፐ ደንድድ፥ ፆሳ ኬ ፐንገ ብስ። ጎዳይ ሊኖ ማእድ፥ ባ ምየን ፃፍያባ ኮሮጆን ኦይክዳ አድያ ፄግድ፥ <verse eid="EZK 9:3"/><verse number="4" style="v" sid="EZK 9:4"/>“የሩሳላመ ካታማ ግዶ ካንዳ ባሸ፥ ያን ኦሰትያ እፀትዳ ኤቃ ጎይኑዋ ግሾ አዛንሸነ ኦልሸ ደእያ አሳ ሶምኦን ማላ ዎ” ያግስ።<verse eid="EZK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 9:5"/>ታ ስእሽን፥ ፆሳይ ሀራታኮ ሀይሳዳ ያግስ፦ “እያ ጌዶ ካልድ፥ ካታማ ግዶ ካንድ ዎተ። እሱዋካ ማሮፕተ፤ ኦደስካ ቃቶፍተ። <verse eid="EZK 9:5"/><verse number="6" style="v" sid="EZK 9:6"/>ጭማታ፥ ፓንታ፥ ጌላኦታ፥ ማጫሳታነ ናይታ ኡባ ሹክተ፤ ሽን ሶምኦን ማል ደእያ አሰ ኦናካ ቦቾፍተ። ታ ኬን ዎ ዶምተ” ያግስ። ኤንቲ ፆሳ ኬ ስንን ኤቅዳ ጭማታን ዎ ዶምዶሶና። <verse eid="EZK 9:6"/><verse number="7" style="v" sid="EZK 9:7"/>ፆሳይ፥ “ብድ ፆሳ ኬ ቱንስተ፤ ዳባባታ አሀን ኩንተ” ያግስ። ኤንቲ ከይድ፥ ካታማ ግዶ ኡባን ዎ ዶምዶሶና።<verse eid="EZK 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 9:8"/>ኤንቲ ዎሽን፥ ታኒ ታርካ አታዳ፥ ታ ሶምኡዋራ ቢታን ጉፋናዳ፥ ታ ቃላ ቁ ኦዳ፥ “አቤት ኡባ ሃርያ ጎዳዉ፥ ኔኒ የሩሳላመ ቦላ ጉስያ ነ ሀንቁዋን እስራኤለፐ አትዳይሳታ ኩመ ይሳኔ?” ያጋስ።<verse eid="EZK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 9:9"/>እ ዛሪድ፥ “እስራኤለነ ይሁዳ አሳ ናጋራይ ዳሮ፤ ቢታ ኡባይ ሱን ኩምስ። ካታማ ኡባን ሱረ ፕርዲ ባዋ። አሳይ፥ ‘ጎዳይ ሀ ቢታ አግስ፤ ጎዳይ በኤና’ ያጎሶና። <verse eid="EZK 9:9"/><verse number="10" style="v" sid="EZK 9:10"/>ሄሳ ግሾ፥ ታ ኤንታዉ ቃትከ፤ ኤንታና ማርከ። ታኒ ኤንታ ኦግያ መላ ኤንታዉ ዛራና” ያግስ።<verse eid="EZK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 9:11"/>ሄሳፈ ጉየ፥ ሊኖ ማእድ፥ ባ ምየን ፃፍያባ ኮሮጆን ኦይክዳ አደይ፥ ጉየ ስሚድ፥ “ነ ታና ኪትዳይሳዳ ኦስ” ያግስ።<verse eid="EZK 9:11"/></para>
  <chapter eid="EZK 9"/>
  <chapter number="10" style="c" sid="EZK 10"/>
  <para style="s1">ቦንቾይ ፆሳ ኬፈ ሻከትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 10:1"/>ታኒ ክሩበታ ሁጰፐ ቦላ ባጋራ ደእያ ሳሎ ጉፋን ዳነይሳ በአስ። ክሩቤላ ቦላ ሳንፓረ አልኦ ሹቻፈ ኦሰትዳ አራታ በአስ። <verse eid="EZK 10:1"/><verse number="2" style="v" sid="EZK 10:2"/>ጎዳይ ሊኖ ማእዳ አድያኮ፥ “ክሩቤላፐ ጋርሳ ባጋራ ገርቶታ ግዶራ ካንዳ ባ። ፂፋ ቦንቆ ነ ኩሸን ኮጰታ ኤካዳ፥ ካታማ ቦላ ላላ” ያግስ።</para>
  <para style="p" vid="EZK 10:2">ታ ፄልሽን ታማ ኤካናዉ ገልስ። <verse eid="EZK 10:2"/><verse number="3" style="v" sid="EZK 10:3"/>አደይ ሶ ገልያ ዎደ ክሩቤቲ ፆሳ ኬፈ ጋርሳ ባጋራ ኤቅዶሶና፤ ግዶ ዳባባን ሻር ኩምስ። <verse eid="EZK 10:3"/><verse number="4" style="v" sid="EZK 10:4"/>ጎዳ ቦንቾይ ክሩቤላ ቦላፈ ደንድድ፥ ፆሳ ኬ ፐንገ ብስ። ሻር ኬ ኩምስ፤ ዳባባይ ጎዳ ቦንቾ ጶለን ኩምስ። <verse eid="EZK 10:4"/><verse number="5" style="v" sid="EZK 10:5"/>ክሩቤላ ቀፍያ ግርሳይ ኡባ ሃርያ ጎዳ ግርሳዳ ካረ ዳባባን ስኤቴስ።<verse eid="EZK 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 10:6"/>ጎዳይ ሊኖ ማእዳ አድያ፥ “ክሩቤላ ጋርሳ ባጋን ደእያ ገርቶታ ግዶፈ ታማ ኤካ” ያግድ ኪትን፥ እ ገልድ እስ ገርቱዋ ማታን ኤቅስ። <verse eid="EZK 10:6"/><verse number="7" style="v" sid="EZK 10:7"/>ክሩቤላፐ እሶይ ባንታ ግዶን ደእያ ታማን ባ ኩሽያ የድድ፥ እያፐ ጉራ ኤክድ፥ ሊኖ ማእዳ አድያ ኩሸን ዎን፥ እ ኤክድ ከይስ። <verse eid="EZK 10:7"/><verse number="8" style="v" sid="EZK 10:8"/>ክሩቤላ ቀፍያፐ ጋርሳ ባጋራ አሳ ኩሸ ዳንያባይ ደኤስ።<verse eid="EZK 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 10:9"/>ታ ፄልያ ዎደ ክሩቤላ ማታን ኦይዱ ገርቶይ ደኤስ። እስ እስ ክሩብያ ማታን እስ እስ ገርቶይ ደኤይሳ በአስ፤ ሄ ገርቶይ አልኦ ሹቻዳ ጶሌስ። <verse eid="EZK 10:9"/><verse number="10" style="v" sid="EZK 10:10"/>ኤንቲ ኦይዳይ እሶይ እሱዋ ዳኖሶና፤ እስ እስ ገርቶይ ሀራ ገርቶ ግዶራ ካን አድ መትዳ ዳኔስ። <verse eid="EZK 10:10"/><verse number="11" style="v" sid="EZK 10:11"/>ክሩቤቲ ብያ ዎደ ኦይዱ ባጋ ያ ሃ ስሞና ቦሶና፤ እስ ገርቶት ብዳ ግንደ ሀንኮ ገርቶይ ያ ሃ ስሞና ስት ግድ ቦሶና። <verse eid="EZK 10:11"/><verse number="12" style="v" sid="EZK 10:12"/>ኤንታ ኩመ ቦላ፥ ሄስካ ኤንታ ዞኩዋን፥ ኤንታ ኩሽያን፥ ኤንታ ቀፍያንነ ኤንታ ኦይዱ ገርቶታን ፄልያ አይፈይ ኩምስ። <verse eid="EZK 10:12"/><verse number="13" style="v" sid="EZK 10:13"/>ታ ስእሽን፥ ገርቶት ዩይያ ገርቶታ ጌተትድ ፄገትዶሶና። <verse eid="EZK 10:13"/><verse number="14" style="v" sid="EZK 10:14"/>እስ እስ ክሩብያስ ኦይዱ ሶምኦይ ደኤስ። ኮይሮ ሶምኦይ ክሩበ ሶምኦ፥ ናምአንይ አሳ ሶምኦ፥ ሄንይ ጋሞ ሶምኦ፤ ኦይዳንይ አርጋን ሶምኦ።<verse eid="EZK 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 10:15"/>ክሩበት ፑደ ደንድዶሶና። ኤንቲ ታኒ ኮቦራ ሻፋ ማታን በእዳ ደኦን ደእያ መታታ። <verse eid="EZK 10:15"/><verse number="16" style="v" sid="EZK 10:16"/>ክሩበት ብያ ዎደ፥ ኤንታ ምየን ደእያ ገርቶት ቦሶና፤ ክሩበት ቢታፈ ፑደ ደንዳናዉ ባንታ ቀፍያ ምጭያ ዎደ ገርቶት ኤንታ ምየፐ ሻከቶኮና። <verse eid="EZK 10:16"/><verse number="17" style="v" sid="EZK 10:17"/>ደኦን ደእያ መተታ አያናይ ገርቶታ ግዶን ደእያ ግሾ፥ ኤንቲ ኤቅያ ዎደ ገርቶት ኤቆሶና፤ ኤንቲ ቢታፈ ፑደ ደንድያ ዎደ ኤንቲ ደንዶሶና።<verse eid="EZK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 10:18"/>ሄሳፈ ጉየ፥ ጎዳ ቦንቾይ ፆሳ ኬ ፐንገፈ ደንድድ፥ ክሩበታፐ ቦላ ባጋን ኤቅስ። <verse eid="EZK 10:18"/><verse number="19" style="v" sid="EZK 10:19"/>ታ ፄልሽን፥ ክሩበት ባንታ ቀፍያ ምጭድ፥ ክርክሮታራ እስፈ ቢታፈ ፑደ ደንድዶሶና። ኤንቲ ፆሳ ኬፈ ዶሎሀ ባጋ ፐንግያ ማታን ኤቅዶሶና። እስራኤለ ፆሳ ቦንቾይ ኤንታፈ ቦላ ባጋራ ደኤስ።<verse eid="EZK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 10:20"/>ኤንቲ ኮቦራ ሻፋን እስራኤለ ፆሳፈ ጋርሳ ባጋራ በእዳ ደኦን ደእያ መታታ። ኤንቲ ክሩበታ ግደይሳ ታ ኤራስ። <verse eid="EZK 10:20"/><verse number="21" style="v" sid="EZK 10:21"/>ኤንታ ኡባስ ኦይዱ ሶምኦትነ፥ ኦይዱ ቀፈት ደኦሶና፤ ኤንታ ቀፈታፐ ጋርሳ ባጋራ አሳ ኩሸ ዳንያባይ ደኤስ። <verse eid="EZK 10:21"/><verse number="22" style="v" sid="EZK 10:22"/>ኤንታ ሶምኦት ኮቦራ ሻፋ ማታን ታ በእዳ ሶምኦታ ዳኖሶና። ኤንቲ ኡባይ ስት ግድ ስን ቦሶና።<verse eid="EZK 10:22"/></para>
  <chapter eid="EZK 10"/>
  <chapter number="11" style="c" sid="EZK 11"/>
  <para style="s1">እስራኤለ ካለይሳት ፕርደታና</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 11:1"/>ፆሳ አያናይ ታና ደንድ፥ ፆሳ ኬስ ዶሎሀ ባጋ ፐንግያኮ ኤፍስ። ፐንግያ ማታን ላታማነ እቻሹ አደት ደኦሶና፤ ኤንታ ግዶን አሳ ካለያ አዙራ ናኣ ያእዛና ባናያ ናኣ ፓላፃ በአስ። <verse eid="EZK 11:1"/><verse number="2" style="v" sid="EZK 11:2"/>ጎዳይ ታኮ፥ “ነኖ አሳ ናአዉ፥ ሀ አሳይ ካታማ ቦላ ኢታ ቆፋ ቆፖሶና፤ ኢታ ዞረ ዞረቶሶና። <verse eid="EZK 11:2"/><verse number="3" style="v" sid="EZK 11:3"/>ኤንቲ፥ ‘ኑኒ ኬ ዛሪድ ኬፃና ዎደይ ማታትስ። ሀ ካታማይ አሾ ፃሮ፤ ኑኒ ቃስ አሾ’ ያጎሶና። <verse eid="EZK 11:3"/><verse number="4" style="v" sid="EZK 11:4"/>ሄሳ ግሾ፥ ትንብተ ኦዳ፤ አሳ ናአዉ፥ ኤንታ ቦላ ትንብተ ኦዳ” ያግስ።<verse eid="EZK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 11:5"/>ጎዳ አያናይ ታ ቦላ ዎድ፥ ታኮ ሀይሳዳ ያግስ፦ “እስራኤለ አሳዉ፥ ህንተ ሄሳዳ ጌታ፤ ሽን ታ ህንተ አይ ቆፕያኮ ኤራይስ። <verse eid="EZK 11:5"/><verse number="6" style="v" sid="EZK 11:6"/>ሀ ካታማን ህንተ ዳሮ አሳ ዎድ፥ ኦገ ኡባን አሀ ኩንደታ” ያጌስ።<verse eid="EZK 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 11:7"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ “ህንተ ዎድ የግዳ አሀይ አሾ፤ ሀ ካታማይ አሾ ፃሮ፤ ሽን ታ ህንተና ሀ ካታማፐ የደዳ ከሳና። <verse eid="EZK 11:7"/><verse number="8" style="v" sid="EZK 11:8"/>ህንተ ኦላስ ያይደታ፤ ሽን ታ ህንተ ያይዳ ኦላ ህንተ ቦላ ኤሀና። <verse eid="EZK 11:8"/><verse number="9" style="v" sid="EZK 11:9"/>ታ ህንተና ሀ ካታማፐ ከሳዳ፥ አላጋታ ኩሸን አዳ እማና፤ ታ ህንተና ህንቴ ዛዋን ፕርዳና። <verse eid="EZK 11:9"/><verse number="10" style="v" sid="EZK 11:10"/>ህንተ ኦላን ዉራና፤ ታ ህንተና ህንተ ቢታን ፕርዳና። ሄ ዎደ ህንተ ታ ጎዳ ግደይሳ ኤራና። <verse eid="EZK 11:10"/><verse number="11" style="v" sid="EZK 11:11"/>ሀ ካታማይ ህንተዉ አሾ ፃሮ ግደና፤ ህንተካ እያ ግዶን አሾ ግደከታ። ታ ህንተ ቦላ እስራኤለ ዛዋን ፕርዳና። <verse eid="EZK 11:11"/><verse number="12" style="v" sid="EZK 11:12"/>ህንተ ታ ህግያነ ታ ዎጋ ሻርድ ህንተ ዩሹዋን ደእያ ካዎተታ ዎጋ መላ ደእዳ ግሾ ህንተ ቦላ ፕርደይ ጎዳ ግደይሳ ህንተ ኤራና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 11:13"/>ታ ትንብተ ኦድያ ዎደ ባናያ ናኣ ፓላፅ ሀይቅን፥ ታኒ ጉፋናዳ፥ ታ ቃላ ቁ ኦዳ፥ “አቤት ኡባ ሃርያ ጎዳዉ፥ እስራኤለፐ አትዳይሳታ ኩመ ዉርሳና ሀናዬ?” ያጋዳ ዋሳስ።<verse eid="EZK 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 11:14"/>ጎዳ ቃላይ ታኮ ሀይሳዳ ያግድ ይስ፤ <verse eid="EZK 11:14"/><verse number="15" style="v" sid="EZK 11:15"/>“ነኖ አሳ ናአዉ፥ የሩሳላመን ደእያ እስራኤለ አሳይ ነባነ ድኦን ደእያ ነ ዳቦታባ፥ ‘ኤንቲ ጎዳፐ ሃክዶሶና፤ ሀ ቢታይ ኑስ ላታ ግድድ እመትስ’ ” ያግድ ሃሳዮሶና።<verse eid="EZK 11:15"/></para>
  <para style="s1">ድኦፐ ስሞ ኡፋይስ ደኤስ</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 11:16"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታ ኤንታ ሃሆን ደእያ ካዎተታ ግዶ የድኮካ፥ ቢታ ኡባን ላልኮካ፥ ኤንቲ ብዳ ቢታታን ጉ ዎደስ ኤንታራ ግዳና” ያጌስ።<verse eid="EZK 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 11:17"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታ ህንተና ካዎተታፐነ ህንተ ላለትዳ ቢታታፐ ሺሻና፤ እስራኤለ ቢታ ዛራዳ ህንተዉ እማና። <verse eid="EZK 11:17"/><verse number="18" style="v" sid="EZK 11:18"/>ኤንቲ ጉየ ስሚድ ያ ዎደ ቱና ምስለታነ ኤቃታ ቢታፈ ይሳና። <verse eid="EZK 11:18"/><verse number="19" style="v" sid="EZK 11:19"/>ታኒ ኤንታዉ እስ ዎዛና እማና፤ ኦራ አያና ኤንታ ግዶን ዎና። ኤንታፈ ሹቻ ዎዛና ድጋዳ፥ አሾ ዎዛና ኤንታዉ እማና። <verse eid="EZK 11:19"/><verse number="20" style="v" sid="EZK 11:20"/>ሄ ዎደ ኤንቲ ታ ህግያ ካላና፤ ታ ኪታ ናጋና። ኤንቲ ታ አሰ ግዳና፤ ታኒ ኤንታ ፆሳ ግዳና። <verse eid="EZK 11:20"/><verse number="21" style="v" sid="EZK 11:21"/>ግዶሽን፥ እፀትዳ ምስልያነ ቱና ኤቃ ጎይናናዉ ዶሰይሳታ ታኒ ኤንታ ኦሱዋዳ ኦና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 11:22"/>ሄ ዎደ ክሩበት ባንታ ቀፍያ ምጭዶሶና፤ ኤንታ ምየን ገርቶት ደኦሶና። እስራኤለ ፆሳ ቦንቾይ ኤንታፈ ቦላራ ደኤስ። <verse eid="EZK 11:22"/><verse number="23" style="v" sid="EZK 11:23"/>ጎዳ ቦንቾይ ካታማ ግዶፈ ደንድድ፥ ዶሎሀ ባጋን ደእያ ዙማ ቦላ ኤቅስ። <verse eid="EZK 11:23"/><verse number="24" style="v" sid="EZK 11:24"/>ፆሳ አያናይ ታዉ እምዳ ቆንጨን አያናይ ታና ቢታፈ ደንድ፥ ካልዳወታ ቢታን ደእያ ድኤትዳይሳታኮ ኤፍስ። ሄሳፈ ጉየ፥ ቆንጨይ ታፐ ሻከትስ። <verse eid="EZK 11:24"/><verse number="25" style="v" sid="EZK 11:25"/>ጎዳይ ታና በስዳባ ኡባ ድኦን ደኤይሳታስ ኦዳስ።<verse eid="EZK 11:25"/></para>
  <chapter eid="EZK 11"/>
  <chapter number="12" style="c" sid="EZK 12"/>
  <para style="s1">ድኤትድ ቡሳ ሌምሰትሦ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 12:1"/>ጎዳ ቃላይ ታኮ ሀይሳዳ ያግድ ይስ፤ <verse eid="EZK 12:1"/><verse number="2" style="v" sid="EZK 12:2"/>“ነኖ አሳ ናአዉ፥ ኔኒ ጌላ አሳ ግዶን ደኣሳ። ኤንቲ ጌላ አስ ግድያ ግሾ ኤንታዉ አይፈይ ደኤስ፥ ሽን ደሞኮና፤ ሀይ ደኤስ፥ ሽን ስኦኮና። <verse eid="EZK 12:2"/><verse number="3" style="v" sid="EZK 12:3"/>ሄሳ ግሾ፥ አሳ ናአዉ፥ ድኦን ብያ አሳዳ፥ ኔኒ ኤፋናዉ ዳንዳእያባ ኡባ ሺሻ ቃቻዳ፥ ጋላስ ኤንቲ በእሽን ከያዳ፥ ነ ደእያ በሳፈ ሀራ በሲ ባ። ኦን ኤር ኤንቲ ጌላ አስ ግድኮካ አኬካና። <verse eid="EZK 12:3"/><verse number="4" style="v" sid="EZK 12:4"/>ጋላስ ኤንቲ ፄልሽን፥ ድኦ ብያ አሳዳ፥ ነ ቃችዳባ ካረ ከሳ፤ ኦማርስ ኤንቲ ፄልሽን፥ ድኤትድ ብያ አሳዳ ከያ። <verse eid="EZK 12:4"/><verse number="5" style="v" sid="EZK 12:5"/>ኤንቲ ፄልሽን፥ ነ ኬ ጎዳ ሉካዳ ፆእያራ ከያ። <verse eid="EZK 12:5"/><verse number="6" style="v" sid="EZK 12:6"/>ነ ከስዳ ሚሽያ ኤንቲ ፄልሽን፥ ነ ሀሸን ቶካዳ፥ ለምእሽን ደንዳዳ ባ። ነ አዉ ብያኮ በኦና መላ ነ ሶምኡዋ ካማ። ነ ሀንያባይ እስራኤለ አሳስ ማላ ግዳና” ያግስ።<verse eid="EZK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 12:7"/>ታኒ እ ታና ኪትዳይሳዳ ኦስ። ድኤትድ ብያ አሳዳ፥ ጋላስ ታ ቃችዳባ ካረ ከሳስ። ኦማርስ ታ ኬ ጎዳ ታ ኩሸን ሉካዳ ከያስ፤ ታ ከስዳ ሚሽያ ኤንቲ ፄልሽን፥ ታ ሀሸን ቶካዳ፥ ለምእሽን ባስ።<verse eid="EZK 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 12:8"/>ዎንታ ጉራ ጎዳ ቃላይ ታኮ ሀይሳዳ ያግድ ይስ። <verse eid="EZK 12:8"/><verse number="9" style="v" sid="EZK 12:9"/>“ነኖ አሳ ናአዉ፥ ጌላ እስራኤለ አሳይ፥ ‘ነ ኦያባይ አይቤ?’ ግድ ነና ኦይችቦኮና? <verse eid="EZK 12:9"/><verse number="10" style="v" sid="EZK 12:10"/>ኤንታዉ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ። ‘ሀ ትንብተይ የሩሳላመን ደእያ ሀላቃባነ እስራኤለ አሳባ ኦዴስ።’ <verse eid="EZK 12:10"/><verse number="11" style="v" sid="EZK 12:11"/>ነ ሀንያባይ ኤንታዉ ማላ ግደይሳ ኦዳ፤ ኤንቲ ድኤትድ ሀራ ቢታ ባና። <verse eid="EZK 12:11"/><verse number="12" style="v" sid="EZK 12:12"/>ኤንታ ግዶን ደእያ ሀላቃይ ጎዳ ሉክድ ባ ሚሽያ ባ ሀሸን ቶክድ፥ ለምእሽን ባና፤ ቢታ በኦና መላ ባ ሶምኡዋ ካማና። <verse eid="EZK 12:12"/><verse number="13" style="v" sid="EZK 12:13"/>ታ ግተ እያ ስንን የጋዳ ኦይካና። ታኒ እያ ካልዳወታ ቢታ ባብሎነ ካታማ ኤሀና፤ ሽን እ ሄ ካታማ በኦና ሀይቃና። <verse eid="EZK 12:13"/><verse number="14" style="v" sid="EZK 12:14"/>እያ ዩሾን ደእያ እያ ማደይሳታነ እያ ኦላንቾታ ኡባ ታ ኡባ በሲ ፕስክ ኦና፤ ታ ኤንታ ማሻን የደና።<verse eid="EZK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 12:15"/>“ኤንታ ታ ሀራ ቢታታነ ካዎተታ ግዶ ላልያ ዎደ ታ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና። <verse eid="EZK 12:15"/><verse number="16" style="v" sid="EZK 12:16"/>ኤንቲ ቢያ ካዎተታ ግዶን ባንታ ቱና ኦሶ ፓፃና መላ ኤንታፈ ጉታ ኦላፐ፥ ኮሻፐነ ሀርገፐ አትዲ አከካናዳ ኦና። ታ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና” ያግስ። <verse eid="EZK 12:16"/><verse number="17" style="v" sid="EZK 12:17"/>ጎዳ ቃላይ ታኮ ሀይሳዳ ያግድ ይስ፤ <verse eid="EZK 12:17"/><verse number="18" style="v" sid="EZK 12:18"/>“ነኖ አሳ ናአዉ፥ ነ ካ ዳጋማን ማ፤ ነ ሃ ያሻን ኮኮራሸ ኡያ። <verse eid="EZK 12:18"/><verse number="19" style="v" sid="EZK 12:19"/>ቢታን ደእያ አሳኮ ሀይሳዳ ያጋ። ኡባ ሃርያ ጎዳይ እስራኤለ ቢታን ደእያ የሩሳላመ አሳባ ሀይሳዳ ያጌስ፦ ‘ቢታን ደእያ አሳ ኡባይ ገነ ኦያ ግሾ ኤንታ ቢታይ ካሎ አታና፥ ኤንቲ ባንታ ኡይ ህርጋን ማና፤ ባንታ ሃ ዳጋማን ኡያና። <verse eid="EZK 12:19"/><verse number="20" style="v" sid="EZK 12:20"/>ሀእ አስ ኩምዳ ካታማት ያና፤ ቢታይ ባይሳ ግዳና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና’ ” ያጌስ።<verse eid="EZK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 12:21"/>ጎዳ ቃላይ ታኮ ሀይሳዳ ያግድ ይስ፤ <verse eid="EZK 12:21"/><verse number="22" style="v" sid="EZK 12:22"/>“ነኖ አሳ ናአዉ፥ ህንተ እስራኤለ ቢታን፥ ዎደ አዱቅስ ቆንጨ ኡባይ ሀዳ ግድስ አስ ያግድ ሌምሰይ እ አይቤ? <verse eid="EZK 12:22"/><verse number="23" style="v" sid="EZK 12:23"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ ‘ታኒ ሀ ሌምሶይ ናምአን ኦደቶና መላ ኦና፤ ኤንቲ ዛሪድ፥ እስራኤለ ቢታን ሌምሶኮና’ ያጌስ። ‘ጋላሳይ ማታትስ፤ ቆንጨ ኡባይ ፖለታና ሀኔስ’ ያጋ። <verse eid="EZK 12:23"/><verse number="24" style="v" sid="EZK 12:24"/>ህዛፐ ጉየ እስራኤለ አሳ ግዶን ዎርዶ ቆንጨነ ሙሩኖ ዴና። <verse eid="EZK 12:24"/><verse number="25" style="v" sid="EZK 12:25"/>ታ ጎዳይ ኦዳናዉ ኮይዳባ ኦዳና፤ ሄስካ ጋምኦና ፖለታና። ህንተኖ፥ ጌላቶ፥ ታ ኦድያባ ኡባ ህንተ ላይን ፖላና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 12:26"/>ቃስካ ጎዳ ቃላይ ታኮ ሀይሳዳ ያግድ ይስ። <verse eid="EZK 12:26"/><verse number="27" style="v" sid="EZK 12:27"/>“ነኖ አሳ ናአዉ፥ እስራኤለ አሳይ፥ ‘እ በእዳ ቆንጨይነ እ ኦድያ ትንብተይ ዳሮ ላይፈ ጉየ ሀናናባ’ ያግድ ኦዶሶና። <verse eid="EZK 12:27"/><verse number="28" style="v" sid="EZK 12:28"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ ‘ታ ኦድያ ቃላይ ፖለታናፐ አትሽን፥ እሶይካ ጋምኤና’ ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 12:28"/></para>
  <chapter eid="EZK 12"/>
  <chapter number="13" style="c" sid="EZK 13"/>
  <para style="s1">ዎርዶ ናበታ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 13:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 13:1"/><verse number="2" style="v" sid="EZK 13:2"/>“ነኖ አሳ ናአዉ፥ እስራኤለን ትንብተ ኦድያ ናበታ ቦላ ነ ትንብተ ኦዳ። ባንታዉ መ ከስድ ትንብተ ኦደይሳታ ሀይሳዳ ያጋ፤ ጎዳ ቃላ ስእተ። <verse eid="EZK 13:2"/><verse number="3" style="v" sid="EZK 13:3"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ ‘አይባካ በኦና ባንታ ቆፋን ደንድድ ትንብተ ኦድያ ኤያ ናበታ አየ!’ <verse eid="EZK 13:3"/><verse number="4" style="v" sid="EZK 13:4"/>እስራኤለ አሳዉ፥ ህንተ ናበት ላለትዳ ካታማን ደእያ ዎርካናታ መላ። <verse eid="EZK 13:4"/><verse number="5" style="v" sid="EZK 13:5"/>ጎዳ ጋላሳን ኦላን ምንድ ኤቃና መላ እስራኤለ አሳ ድርሳ ግምብያ ምንድ ኤስቤከታ፤ ፑደ ላለትዳ በሳ ከይበከታ። <verse eid="EZK 13:5"/><verse number="6" style="v" sid="EZK 13:6"/>ኤንታ ቆንጨይነ ኤንታ ብታይ ዎርዶ። ኤንቲ ጎዳይ ኪቶናሽን፥ ጎዳይ ሀይሳዳ ያጌስ ያጎሶና። ኤንቲ ኦደይሳ ጎዳይ ፖላና ግድ ናጎሶና። <verse eid="EZK 13:6"/><verse number="7" style="v" sid="EZK 13:7"/>ታኒ ኦዶናሽን፥ ጎዳይ ሀይሳዳ ያጌስ ያግድ ኦድያነ ዎርዶ ቆንጨ በኤይሳታነ ሙራንቾታ ግደከቲ?” ያጌስ።<verse eid="EZK 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 13:8"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ “ህንተ በእዳ ቆንጨነ ህንተ ኦድዳ ትንብተይ ዎርዶ ግድያ ግሾ ታ ህንተዉ ሞርከ ግዳና። <verse eid="EZK 13:8"/><verse number="9" style="v" sid="EZK 13:9"/>ዎርዶ ቆንጨ በእያነ ሙራንችያ ናበታ ቦላ ታኒ ታ ኩሽያ ደንና። ኤንቲ ታ አሳ ዞረታን ገሎኮና፤ እስራኤለ አሳ ማዝጋበን ፃፈቶኮና፤ ኤንቲ እስራኤለ ቢታ ገሎኮና። ሄ ዎደ ታ ኡባ ሃርያ ጎዳ ግደይሳ ህንተ ኤራና።<verse eid="EZK 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 13:10"/>“ሳሮይ ባይናሽን ሳእ ሳሮ ያግድ ታ አሳ ባለሶና። አሳይ ሹቹ ኬልድ ዶርን፥ ኤንቲ ቦቅንተ ትዮሶና። <verse eid="EZK 13:10"/><verse number="11" style="v" sid="EZK 13:11"/>ሀ ቦቅንተ ትየይሳታስ፤ ሀ ህንተ ትይዳ ግምበይ ኩንዳና፤ ዎልቃማ እር ቡካና። ታኒ ግታ ሻች የጋና፤ ዎልቃማ ጎተይ ደንዳና። <verse eid="EZK 13:11"/><verse number="12" style="v" sid="EZK 13:12"/>ሄ ግምበይ ኩንድያ ዎደ አሳይ ህንተ ትይዳ ኖራይ አኔ? ያግድ ኦይቾና አጋነ” ያጌስ።<verse eid="EZK 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 13:13"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታኒ ግምብያ ላላናዉ፤ ታ ሀንቁዋን ዎልቃማ ጎተ የዳና፤ ታ ይሉዋን ግታ ሻቻ ኪታና፥ ታ ሸንያን ዎልቃማ እራ ቡክሳና። <verse eid="EZK 13:13"/><verse number="14" style="v" sid="EZK 13:14"/>ህንተ ቦቅንተ ትይዳ ግምብያ ታ መንረና፤ ባሶይ በንታና ጋካናዉ ላላና። እ ኩንድያ ዎደ ህንተ እያ ግዶን ሀይቃና፤ ሄ ዎደ ታኒ ጎዳ ግደይሳ ህንተ ኤራና። <verse eid="EZK 13:14"/><verse number="15" style="v" sid="EZK 13:15"/>ታ ሀንቆይ ግምብያ ቦላነ ግምብያ ቦቅንተ ትይዳ አሳታ ቦላ ዎና። ታ ህንተኮ፥ ‘ግምበይ ባዋ፤ ግምብያ ቦቅንተ ትይዳይሳትካ ዶኮና። <verse eid="EZK 13:15"/><verse number="16" style="v" sid="EZK 13:16"/>እስራኤለን ደእያ ናበት፥ የሩሳላመባ ትንብተ ኦደይሳት፥ ሳሮይ ባይናሽን ሳሮ ቆንጨ በኤይሳት ዶኮና’ ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 13:17"/>“ነኖ አሳ ናአዉ፥ ባንታ ቆፋን ደንድድ፥ ትንብተ ኦድያ ማጫሳ ደሬቃ ፄላዳ ኤንታ ቦላ ትንብተ ኦዳ። <verse eid="EZK 13:17"/><verse number="18" style="v" sid="EZK 13:18"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ ‘ሀራ አሳ ቦላ ዎልቅ ዳናዳ፥ ኤንታ ሀሽያ ቦላ ሙሩኖባ ስክያነ አሳስ ኡባስ ቢታ ቃጨ ጊግስያ ማጫሳ አየ! ህንተ ታ አሳ ፅሄን ኦይክድ ህንተ ሸምፑዋ አሻኔ? <verse eid="EZK 13:18"/><verse number="19" style="v" sid="EZK 13:19"/>እስ ኮጰ ባንጋ ዎይኮ እስ ባሶ ኡይ ደማናዉ፥ ዬላያባ ኦድ፥ ታ አሳ ስንን ታና ካዉሼታ። ህንተ ሀይቃናዉ በሶናይሳታ ዎድ ዳናዉ በሶናይሳታ አሼታ። ያትድ ታ አሳ ዎርዶ ኦዴታ፤ ኤንትካ ህንተ ዎርዱዋ ስኦሶና’ ” ያጌስ።<verse eid="EZK 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 13:20"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ህንተዉ ሀራ አሳ ቦላ ዎልቅ ዳና መላ ህንተ ኩሸን ቃችዳ ሙሩኑዋ ቃጭያ ታ ዳፋ ኤካና። ታ እያ ህንተ ኩሽያፐ ዱ ሆላና፤ ፅሄፐ ከስ ኤክያ ካፎዳ ታ ኤንታ ህንተ ፅህያፐ ከሳ ኤካና። <verse eid="EZK 13:20"/><verse number="21" style="v" sid="EZK 13:21"/>ታኒ ህንተ ሻሽያ ቃራ ኤካዳ፥ ታ አሳ መርናዉ ህንተ ኩሸፐ አሻና። ታኒ ጎዳ ህንተ ሄ ዎደ ኤራና። <verse eid="EZK 13:21"/><verse number="22" style="v" sid="EZK 13:22"/>ታኒ አዛንቦና ፅሎ አሳ ዎዛና ህንተ ዎርዶን አዛንደታ፤ ናጋራንቾት ባንታ ኢታ ኦሱዋፐ ስሚድ፥ ባንታ ሸምፑዋ አሾና መላ ኤንታ ምንደታ። <verse eid="EZK 13:22"/><verse number="23" style="v" sid="EZK 13:23"/>ህዛፐ ህንተ ዎርዶ ቆንጨ በኤከታ፤ ሙሩነከታ። ታኒ ታ አሳ ህንተ ኩሸፐ ከሳ ኤካና። ታኒ ጎዳ ግደይሳ ህንተ ሄ ዎደ ኤራና” ያጌስ።<verse eid="EZK 13:23"/></para>
  <chapter eid="EZK 13"/>
  <chapter number="14" style="c" sid="EZK 14"/>
  <para style="s1">ኤቃ ጎይኖይ እፀትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 14:1"/>እስራኤለ ጭማታፐ እሶት እሶት ታኮ ይድ፥ ታ ስንን ኡትዶሶና። <verse eid="EZK 14:1"/><verse number="2" style="v" sid="EZK 14:2"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 14:2"/><verse number="3" style="v" sid="EZK 14:3"/>“አሳ ናአዉ፥ ሀ አሳት ባንታ ዎዛናን ኤቃ ኤስዶሶና፤ ኤንታ ናጋራይ ኤንታዉ በ ሹች ግድስ። ያትን፥ ኤንቲ ታና ኦይቻና መላ ኦዬ?” <verse eid="EZK 14:3"/><verse number="4" style="v" sid="EZK 14:4"/>ነ ኤንታዉ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ፤ “እስራኤለ አሳፐ ኦንካ ኤቃ ባ ዎዛናን ዎድ፥ እያ ናጋራይ እያዉ በ ሹቹ ግድን፥ ናበ ኦይቻናዉ ቢኮ፥ ታኒ ታ ሁጰን እያ ኤቃታ ዳሮተዳ እያዉ ዛራና። <verse eid="EZK 14:4"/><verse number="5" style="v" sid="EZK 14:5"/>ሄ ኤቃት እስራኤለ አሳ ታፐ ሃስዶሶና፤ ሽን ሀእ ታ ኤንታዉ እምያ ዛሩዋን ኤንታ ዎዛና ታኮ ዛራና” ያጌስ።<verse eid="EZK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 14:6"/>“ሄሳ ግሾ፥ እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ። ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ ናጋራ ፓፅተ፤ ህንተ ኤቃ አግተ፤ ህንተ ቱና ኦሶ ኡባፈ ስምተ።<verse eid="EZK 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 14:7"/>“እስራኤለ አሳ ግድን ዎይኮ እስራኤለ ቢታን ደእያ አላጋ ቢታ አሳ ግድን፥ ታፐ ሃክድ፥ ባ ዎዛናን ኤቃ ዎድ፥ እያ ናጋራይ እያዉ በ ሹቹ ግድን፥ ታና ዞረ ኦይቻናዉ ናበኮ ቢኮ፥ ታኒ ጎዳይ ታ ሁጰን እያዉ ዛሮ እማና። <verse eid="EZK 14:7"/><verse number="8" style="v" sid="EZK 14:8"/>ታኒ ሄ ኡራ ሞርካና፤ ታ እያ አሳ ማላስነ ሚቻስ አሻና፤ ታኒ እያ ታ አሳ ግዶፈ ይሳና፤ ታ ጎዳ ግደይሳ ህንተ ሄ ዎደ ኤራና። <verse eid="EZK 14:8"/><verse number="9" style="v" sid="EZK 14:9"/>እስ ናበይ ጭመትድ ትንብተ ኦድኮ፥ ሄ ናበይ ኦዳና መላ ጭምዳይ ታና ጎዳ። ታኒ እያ ቦላ ታ ኩሽያ ዎዳ፥ ታ አሳ ግዶፈ እያ ይሳና። <verse eid="EZK 14:9"/><verse number="10" style="v" sid="EZK 14:10"/>ኤንቲ ባንታ ናጋራ ሴራ ቶካና፤ ናበይነ ናብያ ኦይቸይስ እስ ግና ሴረታና። <verse eid="EZK 14:10"/><verse number="11" style="v" sid="EZK 14:11"/>ህዛፐ ጉየ እስራኤለ አሳይ ኦገ ባለትድ ታፐ ሃከና፤ ባንታ ናጋራን ባንታና ቱንሶኮና። ኤንቲ ታ አሰ ግዳና፤ ታንካ ኤንታ ፆሳ ግዳና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 14:11"/></para>
  <para style="s1">ኖሄ፥ ዳነላነ እዮባ</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 14:12"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ፦ <verse eid="EZK 14:12"/><verse number="13" style="v" sid="EZK 14:13"/>“አሳ ናአዉ፥ እስ ቢታ አሳይ ናጋራ ኦድ፥ ታዉ አማነቶና እፅኮ፥ ታኒ ታ ኩሽያ ደንዳ፥ ኤንታ ካ ይሳዳ፥ ኮሻ ኤሀና፤ አሳነ መህያ ዎና። <verse eid="EZK 14:13"/><verse number="14" style="v" sid="EZK 14:14"/>ሀር አቶሽን ሀ ሄ አሳት ኖሄይ፥ ዳነልነ እዮብ ሄ ቢታን ደእያኮካ፥ ኤንቲ ባንታ ፅሎተን ባንታ ሸምፑዋ ፃላላ አሻና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 14:15"/>“ታኒ ኤንታ ቢታ ቦላ ዎራ ዶአታ የዳዳ፥ ሄ ቢታይ አስ ባይናነ ኦንካ ካንና መላ ባይሳ ኦና። <verse eid="EZK 14:15"/><verse number="16" style="v" sid="EZK 14:16"/>ታኒ ኡባ ሃርያ ጎዳይ ታ ደኡዋን ጫቃስ። ሀር አቶሽን፥ ሀ ሄ አሳት ሄ ቢታን ደእያኮካ፥ ኤንቲ ባንታ ናይታ አሻናዉ ዳንዳኦኮና። ኤንቲ ባንታዉ አታና፤ ሽን ቢታይ ባይሳ ግዳና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 14:17"/>“ታኒ ሄ ቢታ ቦላ ቶራ የዳዳ፥ ያን ደእያ አሳነ መህያ ዎኮ፥ <verse eid="EZK 14:17"/><verse number="18" style="v" sid="EZK 14:18"/>ታኒ ኡባ ሃርያ ጎዳይ ታ ደኡዋን ጫቃስ። ሀ ሄ አሳት ሄ ቢታን ደእያኮካ፥ ባንታ ናይታ አሻናዉ ዳንዳኦኮና። ኤንቲ ባንታዉ አታና” ያጌስ ጎዳይ።<verse eid="EZK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 14:19"/>“ታኒ ሄ ቢታ ቦላ ኢታ ሀርገ የዳዳ፥ ታ ሀንቁዋን ሱ ጉካና መላ ኦኮ፥ ያን ደእያ አሳነ መህያ ዎኮ፥ <verse eid="EZK 14:19"/><verse number="20" style="v" sid="EZK 14:20"/>ታኒ ኡባ ሃርያ ጎዳይ ታ ደኡዋን ጫቃስ። ሀር አቶሽን፥ ኖሄይ፥ ዳነልነ እዮብ ሄ ቢታን ደእያኮካ፥ ኤንቲ ባንታ ፅሎተን ባንታ ሸምፑዋ አሻናፐ አትሽን፥ ባንታ ናይታ አሾኮና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 14:21"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ “ታኒ አሳነ መህያ ዎናዉ የሩሳላመ ቦላ ኦይዱ ኢታ ፕርዳታ፦ ቶራ፥ ኮሻ፥ ዎራ ዶአታነ ሀርገ የዳና። <verse eid="EZK 14:21"/><verse number="22" style="v" sid="EZK 14:22"/>ግዶሽን፥ አትድ ከይዳ ጉ አሳት፤ ማጫ ናይትነ አደ ናይት ያፐ ከያና። ኤንቲ ህንተኮ ያ ዎደ ኤንታ ሀኖታነ ኤንታ ኦሱዋ ህንተ በእድ፥ ታ የሩሳላመ ቦላ ኤህዳ ጋዶይ ልከ ግደይሳ አኬካና። <verse eid="EZK 14:22"/><verse number="23" style="v" sid="EZK 14:23"/>ህንተ ኤንታ ሀኖታነ ኤንታ ኦሱዋ በእድ፥ ታ ኤንታ ቦላ ጮ ፕርዶናይሳ ኤራና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 14:23"/></para>
  <chapter eid="EZK 14"/>
  <chapter number="15" style="c" sid="EZK 15"/>
  <para style="s1">ዎይነ ሌምሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 15:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 15:1"/><verse number="2" style="v" sid="EZK 15:2"/>“አሳ ናአዉ፥ ዎይነይ ዎራን ደእያ ሀራ ምፈ አይብን አ? <verse eid="EZK 15:2"/><verse number="3" style="v" sid="EZK 15:3"/>ጎእ ደእያ ባ ኦናዉ ቃንፀትድ ኤርዬ? አይኮባ ካቅያ ኮጫ እያፐ ከሳናዉ ዳንዳኤቲ? <verse eid="EZK 15:3"/><verse number="4" style="v" sid="EZK 15:4"/>እያ ታማ ኦይሰናዉ ታማን የግን፥ ፄራይነ ዱለይ ታማን ሜተትን አትዳ ዱንቻይ አይ ማዳኔ? <verse eid="EZK 15:4"/><verse number="5" style="v" sid="EZK 15:5"/>ፁገቶና ደእሸ፥ አይኮ ማዶናይስ ታም ምን ምጭድ አይ ማዳኔ?”<verse eid="EZK 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 15:6"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታኒ ዎራን ደእያ ም ግዶፈ ዎይነ ም ታማስ አዳ እምዳይሳዳ የሩሳላመን ደእያ አሳ ሄሳዳ ኦና። <verse eid="EZK 15:6"/><verse number="7" style="v" sid="EZK 15:7"/>ታኒ ታ ሶምኡዋ ኤንታ ቦላ ዛራና፤ ኤንቲ እስ ታማፐ ከይኮካ፥ ሀራ ታም ኤንታ ማና። ታኒ ታ ሶምኡዋ ኤንታ ቦላ ዛርያ ዎደ ታኒ ጎዳ ግደይሳ ህንተ ኤራና። <verse eid="EZK 15:7"/><verse number="8" style="v" sid="EZK 15:8"/>ኤንቲ ታናን አማነቶና አግዳ ግሾ ታ ኤንታ ቢታ ባይሳ ከሳና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 15:8"/></para>
  <chapter eid="EZK 15"/>
  <chapter number="16" style="c" sid="EZK 16"/>
  <para style="s1">አማነቶና የሩሳላመ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 16:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 16:1"/><verse number="2" style="v" sid="EZK 16:2"/>“አሳ ናአዉ፥ የሩሳላመ እያ ቱና ኦሶታ ኤርሳ። <verse eid="EZK 16:2"/><verse number="3" style="v" sid="EZK 16:3"/>ኡባ ሃርያ ጎዳይ የሩሳላመኮ ሀይሳዳ ያጌስ። ነ ማይዛነ ነ ሼሻይ ካናነ ቢታና፤ ነ አዋይ አሞረ፤ ነ አይያ ህተ አስ። <verse eid="EZK 16:3"/><verse number="4" style="v" sid="EZK 16:4"/>ነ የላትያ ጋላስ ነ ጉልአይ ቃንፀትበና፤ ዎይኮ ነና ጌሻናዉ ሃን ሜጨታባካ፤ ዎይኮ ማፅነን ጎርፐታዳ ጩርቃን ፃፀታባካ። <verse eid="EZK 16:4"/><verse number="5" style="v" sid="EZK 16:5"/>ሀ ጌተትዳይሳታፐ ሀር አቶሽን እሱዋ ኦናዉ ነዉ ምሸትዳይ ባዋ። ነ የለትዳ ጋላስ ቦረትዳ ግሾ ዎራ የገታዳሳፐ አትሽን፥ ነዉ ኦንካ ቃትቤና።<verse eid="EZK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 16:6"/>“ታ ያራ አያ ዎደ ኔኒ ነ ሱን ኢታዳ ዞሄትሽን በአዳ፥ ኔኒ ነ ሱን ዝንእዳ ደእሽን፥ ‘ደኦን ደአ’ ያጋስ። <verse eid="EZK 16:6"/><verse number="7" style="v" sid="EZK 16:7"/>ታ ነና አራዳ ቢታን ደእያ ካዳ ድቻስ። ኔኒ ድጫ አዱቃዳ፥ ጋማ ጋካዳሳ። ነ ንይ ኡትስ፤ ነ ሁጰይ ድጭስ፤ ሽን ነ ካሎ ደኣሳ።<verse eid="EZK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 16:8"/>“ዛራዳ ታ ያራ አሸ ነና ፄልያ ዎደ፥ ኔኒ ገሎስ ጋካዳ፥ ካሎ ቦርሰትያ አሰ ግዳዳሳ። ታ አፍላ ማጫራ ነ ቦላ የጋዳ፥ ነ ካሉዋ ካማስ፤ ታ ኔራ ጫቃዳ ነና ታዉ ቡዞ ኦስ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 16:9"/>“ሱን ኢትዳ ነ አሳተ ሃን ሜጫ ጌሻዳ፥ ዛይተን ትያስ። <verse eid="EZK 16:9"/><verse number="10" style="v" sid="EZK 16:10"/>ታኒ ነና አሌቆ ማኦ ማይዛስ፤ ሎኦ ጋልባፈ ኦሰትዳ ጫማ አስሳስ፤ ሊኖ ሻሸ ነና ቃጭሳስ፤ አልኦ ኩታ ጉልንትሳስ። <verse eid="EZK 16:10"/><verse number="11" style="v" sid="EZK 16:11"/>ነና አሌቆን አሌቅሳስ፤ ነ ኩሸን ሳጋዮ አስ፤ ነ ቆያ ዎርቃን ማይዛስ። <verse eid="EZK 16:11"/><verse number="12" style="v" sid="EZK 16:12"/>ነ ስንነ፥ ነ ሀይን ዎርቃ፥ ነ ሁጰን ሎኦ ካላቻ ዎስ። <verse eid="EZK 16:12"/><verse number="13" style="v" sid="EZK 16:13"/>ነ ዎርቃንነ ብራን አሌቀታዳሳ፤ ነ ማኦ ኡባይ አልኦ ሊኖ፥ አልኦ ኩታነ አሌቆ ቃምሰ። ነ ምያ ካይ ሎኦ ለ፥ ኤስነ ዛይተ። ኔኒ ዳሮ ፑላታዳ፥ ካዎ ግዳናዉ ጋካዳሳ። <verse eid="EZK 16:13"/><verse number="14" style="v" sid="EZK 16:14"/>ታ ነዉ እምዳ ቦንቹዋ ጋሶን፥ ነ ዳሮ ፑላትዳ ግሾ ካዎተታ ኡባን ኤረታዳሳ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 16:15"/>“ሽን ኔኒ ነ ፑላን አማነታዳ፥ ሀራታን ኤረትዳ ግሾ ኦገራ አያ ኡባስ ነና አ እማዳሳ። <verse eid="EZK 16:15"/><verse number="16" style="v" sid="EZK 16:16"/>ነ ማኡዋፐ ባጋ ኤካዳ፥ ነ ጎይኖ በሳታ አሌቅሳዳሳ፤ ያን ላይማታዳሳ። ሄሳ መላባይ ሀይሳፈ ካሰ ሀንቤና፤ ስንፈካ ሀናናዉ በሰና። <verse eid="EZK 16:16"/><verse number="17" style="v" sid="EZK 16:17"/>ታ ነዉ እምዳ ዎርቃፈነ ብራፐ ኦሰትዳ ሎኦ አሌቆ፥ አደ ምስለታ ኦዳ ኤንታራ ላይማታዳሳ። <verse eid="EZK 16:17"/><verse number="18" style="v" sid="EZK 16:18"/>ታ እምዳ አሌቆ ማኡዋ ሄ ምስለታ ማይዛዳሳ፤ ታ ዛይትያነ ታ እፃንያ ኤንታዉ ሺሻዳሳ። <verse eid="EZK 16:18"/><verse number="19" style="v" sid="EZK 16:19"/>ታ ነዉ እምዳ ሎኦ ልያ፥ ዛይትያነ ኤሳ ኤንታ ስንን ሳዎ ቶንኩ ግያ ያርሾ ኦዳ ሺሻዳሳ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 16:20"/>ነ ላይማተይ ጉፅቤናሽን፥ ነ ታዉ የልዳ አደ ናይታነ ማጫ ናይታ ኤፋዳ፥ ኤቃታስ ያርሻዳሳ። <verse eid="EZK 16:20"/><verse number="21" style="v" sid="EZK 16:21"/>ነ ታ ናይታ ሹካዳ፥ ኤቃታስ ታማን ያርሻዳሳ። <verse eid="EZK 16:21"/><verse number="22" style="v" sid="EZK 16:22"/>ነ ቱናተንነ ነ ላይማተን ኡባን ደአሸ፥ ካሰ ነ ያላጋተ ላይ፥ ካሎ ሱን ሙከታዳ ዞሄትያ ዎድያ ዶጋዳሳ።<verse eid="EZK 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 16:23"/>ኡባ ሃርያ ጎዳይ፥ “አየ! ነና አየ!” ያጌስ። ሀ ኢታተ ኡባ ቦላ ጉጃዳ፥ <verse eid="EZK 16:23"/><verse number="24" style="v" sid="EZK 16:24"/>ዳባባ ኡባን ቃ ኤቃ ጎይንያ በሳታ ነዉ ጊግሳዳሳ። <verse eid="EZK 16:24"/><verse number="25" style="v" sid="EZK 16:25"/>ኦገ ዶናን ላይማትያ በሳታ ኬፃዳ፥ ነ ፑላ ቱንሳዳሳ፤ ኦገራ አያ ኡባስ ነ አሳተ አ እማዳ፥ ላይማተ ዳርሳዳሳ። <verse eid="EZK 16:25"/><verse number="26" style="v" sid="EZK 16:26"/>ኔኒ አሞን ኩምዳ፥ ነ ሾሮ ግድዳ ግብፀታራ ላይማታዳሳ፤ ነ ላይማተን ታና ይሎያዳሳ። <verse eid="EZK 16:26"/><verse number="27" style="v" sid="EZK 16:27"/>ሄሳ ግሾ፥ ታኒ ታ ኩሽያ ነ ቦላ ደንስ፤ ነና ጋክያ ነ አንጁዋ ጉስ። ታኒ ነና ነ ፖኮ ሀኖታን ዬላትያ፥ ነና ሞርክያ ፍልስፄመታስ አዳ እማስ። <verse eid="EZK 16:27"/><verse number="28" style="v" sid="EZK 16:28"/>ነ አሎና አስ ግድያ ግሾ፥ አሶረ አሳራ ላይማታዳሳ። ሄ ኡባን ታዉ ግዳና ጋባካ። <verse eid="EZK 16:28"/><verse number="29" style="v" sid="EZK 16:29"/>ዛልኤን አቅያ ካልዳወታራ ላይማታዳሳ፥ ሽን ሄስ ታዉ ግዳና ጋባካ።<verse eid="EZK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 16:30"/>ኡባ ሃርያ ጎዳይ፥ “ኔኒ ዬል ባይና ላይማ ማጫሳዳ ሀንያራ፥ ነ አይብ ላፋ አሰ! <verse eid="EZK 16:30"/><verse number="31" style="v" sid="EZK 16:31"/>ኔኒ ኦገ ዶናን ላይማትያ በሳታ ነዉ ኬፅያ ዎደነ ዳባባ ኡባን ኤቃስ ጎይንያ በሳታ ጊግሳዳሳ። ግዶሽን፥ ሀራ ላይማ ማጫሳት ኤክያ ሚሸ ኤካባካ። <verse eid="EZK 16:31"/><verse number="32" style="v" sid="EZK 16:32"/>ኔኒ ባ አዝናይ ደእሽን፥ አላጋ አደታራ ላይማትያ ማጫሳ መላ። <verse eid="EZK 16:32"/><verse number="33" style="v" sid="EZK 16:33"/>ላይማ ማጫሳስ ሚሸይ ቃንፀቴስ፥ ሽን ኔኒ ነ ላገታስ እሞታ እማሳ፤ ኤንቲ ኡባ በሳፈ ኔኮ ያና መላ ኤንታዉ ሚሸ እማሳ። <verse eid="EZK 16:33"/><verse number="34" style="v" sid="EZK 16:34"/>ኔኒ ላይማትያ ሀራ ማጫሳታፐ ዱማ፤ ኔራ ላይማታናዉ ነና ካልያ ኦንካ ባዋ። ኔኒ ገደ እሞታ እማሳፐ አትሽን፥ ሃ ኤካካ፤ ኔኒ ሀራታፐ ዱማ” ያጌስ። <verse eid="EZK 16:34"/><verse number="35" style="v" sid="EZK 16:35"/>ነኖ፥ ላይማ የሩሳላመ ጎዳ ቃላ ስአ። <verse eid="EZK 16:35"/><verse number="36" style="v" sid="EZK 16:36"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ “ኔኒ ነ ላይማተ አሙዋን ነ ላገታስ ነ አሳተ ቃርዳ ግሾ፥ ነ ኤቃታ ኡባ ግሾነ ነ ናይታ ሱ ነ ኤንታዉ ጉስዳ ግሾ፥ <verse eid="EZK 16:36"/><verse number="37" style="v" sid="EZK 16:37"/>ነ ኤንታን ኡፋይትዳ ነ ላገታ ኡባ፥ ነ ዶሰይሳታነ ነ እፀይሳታ ታ ነዉ ሞርከ ኦዳ ሺሻና። ታኒ ኤንታ ዱማ ዱማ በሳፈ ነ ዩሹዋን ሺሻዳ፥ ኤንታ ስንን ነና ቃራና፤ ኤንቲ ነ ካሉዋ በአና። <verse eid="EZK 16:37"/><verse number="38" style="v" sid="EZK 16:38"/>ታኒ ላይማ ማጫሳታ ቦላነ ሱ ጉስያ ማጫሳታ ቦላ ፕርደይሳዳ ነ ቦላ ፕርዳና፤ ታ ሀንቁዋንነ ታ ቃናትያን ነ ቦላ ሀይቆ ኤሀና። <verse eid="EZK 16:38"/><verse number="39" style="v" sid="EZK 16:39"/>ታ ነና ነ ላገታስ አዳ እማና፤ ኤንቲ ነ ላይማትያ በሳታነ ኤቃ ጎይኖ በሳታ ላላና። ኤንቲ ነ ማኡዋ ቃርድ፥ ነ ሎኦ አሌቁዋ ኤክድ፥ ነና ፅረ ካሎ አሻና። <verse eid="EZK 16:39"/><verse number="40" style="v" sid="EZK 16:40"/>ነና ሹቻን ጫድድ፥ ማሻን ቃንፀረድ ዎያ አሳ ነ ቦላ ኤንቲ ደንና። <verse eid="EZK 16:40"/><verse number="41" style="v" sid="EZK 16:41"/>ኤንቲ ነ ኬ ፁግድ፥ ዳሮ ማጫሳ ስንን ነ ቦላ ፕርዳና። ታ ነ ላይማተ አግሳና፤ ነ ላገታስ ገደ ሚሸ ቃንፃካ። <verse eid="EZK 16:41"/><verse number="42" style="v" sid="EZK 16:42"/>ሄሳን ነ ቦላ ደእያ ታ ይሎይ እርፃና፤ ታ ቃናትያ ኔፐ ሃሳና፤ ህዛፐ ስእ ጋና፤ ዛራዳ ሀንቀትከ። <verse eid="EZK 16:42"/><verse number="43" style="v" sid="EZK 16:43"/>ኔኒ ነ ናአተ ላይ ዶጋዳ፥ ሀ ኢታ ኦሶ ኡባን ታና ሀንቀዳሳ። ሄሳ ግሾ፥ ነ ኦዳባ ኡባ ታ ነ ቦላ ዛራና። ነ ቱና ኦሶ ኡባ ቦላ ላይማተ አይስ ጉጃዲ?” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 16:43"/></para>
  <para style="s1">ናእያ አየ መላ</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 16:44"/>“የሩሳላመ፥ አሳይ ነና፥ ‘ናእያ አየ ማላ’ ግድ ሌምሳና። <verse eid="EZK 16:44"/><verse number="45" style="v" sid="EZK 16:45"/>ቱማ ኔኒ ባ አዝናነ ባ ናይታ ሻተትያ ነ አየ መላ፤ ባንታ አዝናታነ ባንታ ናይታ ሻተትያ ነ ምቸታ መላ፤ ነ አይያ ህተ አስ፤ ነ አዋይ አሞረ አስ። <verse eid="EZK 16:45"/><verse number="46" style="v" sid="EZK 16:46"/>ነ ባይራ ምችያ፥ ባ ጉታራ ኔፐ ፑደሀ ባጋን ደእያ ሳማረነ እ ማጫ ናይታ፤ ነ ካሎ ምችያ ባ ጉታራ ኔፐ ዱገሀ ባጋን ደእያ ሶዶመነ እ ማጫ ናይታ። <verse eid="EZK 16:46"/><verse number="47" style="v" sid="EZK 16:47"/>ነ ኤንታ ኦግያ ካላዳ ኤንታ ቱና ኦሶታ ፖሎ ፃላላ ግዶናሽን፥ ጉ ዎደን ኤንታፈ አዳ ኢታ ኦዳሳ።<verse eid="EZK 16:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="EZK 16:48"/>“ታኒ ኡባ ሃርያ ጎዳይ ታ ደኡዋን ጫቃስ። ኔንነ ነ ጉታን ደኤይሳት ኦዳይሳዳ ነ ምችያ ሶዶመነ እ ማጫ ናይት ኦቦኮና። <verse eid="EZK 16:48"/><verse number="49" style="v" sid="EZK 16:49"/>ነ ምችያ ሶዶመ ኦዳ ናጋራይ ሀይሳ፦ እያነ እ ማጫ ናይት ኦቶራንቾ፥ ኤንቲ ካልዳይሳታነ እንጀ ዱሱ ደእኮካ ኤንቲ መቶታንቾታነ ማንቆታ ማድቦኮና። <verse eid="EZK 16:49"/><verse number="50" style="v" sid="EZK 16:50"/>ኤንቲ ኦቶራንቾ ግድድ፥ ታ ስንን ቱና ኦሶ ኦዶሶና። ሄሳ ግሾ፥ ህንተ በእዳይሳታ ታ ኤንታ ይሳስ።<verse eid="EZK 16:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="EZK 16:51"/>“ሳማረይ ነ ኦዳ ናጋራስ ባጋካ ኦቡኩ፤ ነ ኢፐ አዳ ሻትያ ቱና ኦዳሳ። ነ ኦዳ ቱና ኦሶታ ኡባ ጋሶን ነ ምቸት ፅሎ አዛና መላ ኦዳሳ። <verse eid="EZK 16:51"/><verse number="52" style="v" sid="EZK 16:52"/>ኔኒ ነ ምቸታ ሱረ አስ ከስዳ ግሾ ዬላ ማአ። ነ ናጋራይ ኤንታይሳፈ አድ ኢትን፥ ኤንቲ ኔፐ ፅሎ ዳንዶሶና። ሄሳ ግሾ፥ ካዉያዳ ዬላ ማአ።<verse eid="EZK 16:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="EZK 16:53"/>“ግዶሽን፥ ሶዶመነ እ ማጫ ናይታ፥ ሳማረነ እ ማጫ ናይታ ታኒ ኤንታ ሻሉዋ ዛርያ ዎደ ነ ሻሉዋካ ዛራና። <verse eid="EZK 16:53"/><verse number="54" style="v" sid="EZK 16:54"/>ነባን ኔኒ ዳሮ ዬላታና፤ ነ ካዉሻተይ ዳሮ ግድያ ግሾ ነ ምቸት ሄሳን ምነታና። <verse eid="EZK 16:54"/><verse number="55" style="v" sid="EZK 16:55"/>ነ ምቸት፥ ሶዶመ ባ ጉታታራነ ሳማርያ ባ ማጫ ናይታራ ባንታ ካሰ ዱሳኮ ስማና፤ ነካ ነ ማጫ ናይታራ ካሰ ነ ዱሳኮ ስማና። <verse eid="EZK 16:55"/><verse number="56" style="v" sid="EZK 16:56"/>ነ ኦቶርትያ ዎደ ነ ምቸ ሶዶም ቦላ ቀልቅሳብኪ? <verse eid="EZK 16:56"/><verse number="57" style="v" sid="EZK 16:57"/>ሄስ ሀንዳይ ነ ናጋራይ ቆንጫናፐ ካሰ ግደኔ? ሀእ ኔኒ ነ ዩሹዋን ደእያ ኤዶመስ ምቾታስነ እ ሾሮታስ፥ ፍልስፄመስነ እ ምቸ ናይታስ፤ ሄሳዳካ ነና እፅያ ኡባስ ቦረስ አታዳሳ። <verse eid="EZK 16:57"/><verse number="58" style="v" sid="EZK 16:58"/>ነ ላይማተ ግሾነ ነ ቱና ኦሶታ ግሾ ነ ሴረታና” ያጌስ ጎዳይ።<verse eid="EZK 16:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="EZK 16:59"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ “ኔኒ ኡፋይሳ ቃላ መንዳ፥ ጫቁዋ ላልዳ ግሾ ነ ኦዳ ኦሱዋዳ ታ ነዉ ኦና። <verse eid="EZK 16:59"/><verse number="60" style="v" sid="EZK 16:60"/>ግዶሽን፥ ታ ነ ናአተ ዎድያን ኔራ ጫቅዳ ጫቆ ቃላ ሀሳያና፤ መርናዉ ኔራ ጫቃና። <verse eid="EZK 16:60"/><verse number="61" style="v" sid="EZK 16:61"/>ነ ባይራነ ነ ካሎ ምቸታ ታ ኔኮ ኤህያ ዎደ ኔኒ ነ ሄመ ሀሳያዳ ዬላታና። ሽን ሄስ ታ ኔራ ጫቅዳ ጫቁዋ መላ ግዶና እፅኮካ፥ ታ ኤንታ ነዉ ናአ ኦዳ እማና። <verse eid="EZK 16:61"/><verse number="62" style="v" sid="EZK 16:62"/>ታኒ ታ ጫቁዋ ኔራ ኦራና፤ ሄ ዎደ ታ ጎዳ ግደይሳ ነ ኤራና። <verse eid="EZK 16:62"/><verse number="63" style="v" sid="EZK 16:63"/>ነ ኦዳ ናጋራ ኡባ ታኒ አቶ ግያ ዎደ ነ ኦዳባ ሀሳያዳ፥ ዬላስ ነ ዶና ኦይካና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 16:63"/></para>
  <chapter eid="EZK 16"/>
  <chapter number="17" style="c" sid="EZK 17"/>
  <para style="s1">አርጋንነ ዎይነ ሌምሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 17:1"/>ጎዳ ቃላይ ሀይሳዳ ያግድ ታኮ ይስ፦ <verse eid="EZK 17:1"/><verse number="2" style="v" sid="EZK 17:2"/>“አሳ ናአዉ፥ እስራኤለ አሳስ ቃንእሽን ኦዳ፤ ሌምሶን ቆንጭሳ። <verse eid="EZK 17:2"/><verse number="3" style="v" sid="EZK 17:3"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ። ‘ግታ ቀፈይነ ዱማ ዱማ ማላራ ደእያ ባለት ደእያ እስ አርጋን ደኤስ። ሄ አርጋንይ ልባኖሰ ይድ ዝጋ ፄራን ኦይክስ። <verse eid="EZK 17:3"/><verse number="4" style="v" sid="EZK 17:4"/>ሄ ዝጋ ፄራ መን ኤክድ፥ ዛልኤይ ዳርያ ቢታ ኤፍድ ዛልአንቾታ ካታማን ቶክስ። <verse eid="EZK 17:4"/><verse number="5" style="v" sid="EZK 17:5"/>እ እስራኤለ ቢታፈ አጫ ኤፍድ፥ አራዳ ቢታን፥ ሃ ማታን ቶክስ። <verse eid="EZK 17:5"/><verse number="6" style="v" sid="EZK 17:6"/>አጫይ ዳሮ አዱቆና ደእሸ ዳይድ አርጋንኮ ስሚድ ድጭስ፤ ሽን እያ ፃጶይ ቢታ ግዶ ገልስ። ሄ ዎይነይ ዳሮ ታሸነ ሀይ ከስስ። <verse eid="EZK 17:6"/><verse number="7" style="v" sid="EZK 17:7"/>ሄሳዳካ፥ ግታ ቀፈይነ ዳሮ ባለት ደእያ ሀራ አርጋን ደኤስ። ሃ ደማናዉ ሄ ዎይነይ ባ ቶከትዳ በሳፈ ሄ አርጋንይ ደእያ በሳኮ ባ ፃጱዋነ ባ ታሽያ የድስ። <verse eid="EZK 17:7"/><verse number="8" style="v" sid="EZK 17:8"/>ሽን፥ ሄ ዎይነይ ታሸ ከሳና መላ፥ አይፈ አይፋና መላነ ሎኦ ዎይነ ግዳና መላ አራዳ ቢታን፥ ዳሮ ሃ ደእያ በሳን ቶከትስ’ ” ያጌስ።<verse eid="EZK 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 17:9"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ። “ሄ ዎይነይ ድጫኔ? ኮይሮ እያ ቶክዳ አርጋንይ እያ ሾደኔ? እያ አይፈታ ቆቆፍድ፥ እያ እርፃ ሀይታ መልሰኔ? እያ ሄ በሳፈ ፃጶራ ሾዳናዉ ግታ ዎልቃ ዎይኮ ዳሮ አስ ኮሸና። <verse eid="EZK 17:9"/><verse number="10" style="v" sid="EZK 17:10"/>እያ ሾድድ፥ ሀራ በሳን ቶክያኮ እ ድጫኔ? ዶሎሀ ባጋ ጫርኮይ ሾጭን ባ ቶከትዳ በሳን መለኔ?”<verse eid="EZK 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 17:11"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ፦ <verse eid="EZK 17:11"/><verse number="12" style="v" sid="EZK 17:12"/>“ሄ ሌምሱዋ ብርሸይ አይበኮ አነ ሀ ጌላ አሳታ ኦይቻ። ሄስ አይበ ጊኮ፥ ባብሎነ ካዎይ የሩሳላመ ይድ፥ ኤንታ ካዋነ ኤንታ ሀላቃታ ድእድ፥ ባብሎነ ኤፍስ። <verse eid="EZK 17:12"/><verse number="13" style="v" sid="EZK 17:13"/>ካዋ ሶ አሳፐ እሱዋ ኤክድ፥ ባራ ጫቅስድ፥ አሳ ግዶፈ ኤረትዳይሳታ ድእድ ኤፍስ። <verse eid="EZK 17:13"/><verse number="14" style="v" sid="EZK 17:14"/>ሄሳ ኦዳይ ኤንታ ካዎተይ ዎልቃ ይድ፥ ዛሪድ ደንዶናዳ ባንታ ጫቁዋ ፃላላ ናግድ ዳና መላሳ። <verse eid="EZK 17:14"/><verse number="15" style="v" sid="EZK 17:15"/>ሽን ይሁዳ ካዎይ ማካልድ፥ ፓራታነ ዳሮ ኦላንቾታ የዳና መላ ግብፀ ኪትስ። ያትን ሄስ ሀናንዴ? ሄሳ ኦዳ እ ከስ ኤካንዴ? እ ጫቁዋ መንድ ሴረቶና አታንዴ?”<verse eid="EZK 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 17:16"/>“ታኒ ኡባ ሃርያ ጎዳይ ታ ደኡዋን ጫቃስ። ባና ካዎዳ ካዋ ጫቁዋ መንዳ ግሾነ ጫቁዋ ካዳ ግሾ፥ ሄ ካዋ ቢታን፥ ባብሎነን እ ሀይቃና። <verse eid="EZK 17:16"/><verse number="17" style="v" sid="EZK 17:17"/>ባብሎነ ኦላንቾት ዳሮ አሳ ዎናዉ ግምብያ ዩሾን ቢታ ዶርድ ድርስ ጊግስያ ዎደ፥ ግብፀ ካዎይ ባ ኦላንቾታራነ ባ ዳሮ አሳራ ይድ አይኮካ ማደና። <verse eid="EZK 17:17"/><verse number="18" style="v" sid="EZK 17:18"/>እ ጫቆ ካድ መንዳ ግሾነ ባ ኩሽያ እምድ፥ ባ ግዳ ባ ኡባ ፖሎና አግዳ ግሾ ከስ ኤካናዉ ዳንዳኤና።”<verse eid="EZK 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 17:19"/>“ታኒ ኡባ ሃርያ ጎዳይ ታ ደኡዋን ጫቃስ። እ ጫቁዋ ካድ ታ ጫቁዋ መንዳ ግሾ ታ ሱንን ጫቅዳስ ታ እያ ቦላ ዛራዳ ኤሀና። <verse eid="EZK 17:19"/><verse number="20" style="v" sid="EZK 17:20"/>ታኒ ታ ግትያ እያ ቦላ ምጭን፥ እ ታ ፅህያን ኦይከታና። እ ታዉ አማነቶና እፅዳ ግሾ ታ እያ ባብሎነ ኤፋዳ፥ ያን እያ ቦላ ፕርዳና። <verse eid="EZK 17:20"/><verse number="21" style="v" sid="EZK 17:21"/>ዶረትዳ እያ ኦላንቾት ማሻን ሀይቃና፤ አትዳይሳት ዱማ ዱማ በሳራ ላለታና።” ሄሳ ኦደይ ታና፥ ጎዳ ግደይሳ ህንተ ኤራና።<verse eid="EZK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 17:22"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ “ታኒ ታ ሁጰን አዱሳ ዝጋ ፄራ ቃንፃ ኤካዳ፥ ቃነ አዱሳ ዙማ ሁጰን ቶካና። <verse eid="EZK 17:22"/><verse number="23" style="v" sid="EZK 17:23"/>ታኒ እያ እስራኤለ ዙማ ሁጰን ቶካና፤ ያን ዳያና፤ አይፈ አይፋናነ ሎኦ ዝጋ ግዳና። ካፎ ኮቸ ኡባይ እያን ኬፃና፤ ኤንቲ እያ ታሽያ ኩያን ሸምፓና። <verse eid="EZK 17:23"/><verse number="24" style="v" sid="EZK 17:24"/>አዱሳ ም ዝቅ ኦይነ ቃን ም ቁ ኦይ፥ ቃስ ጭልኦ ም መልሰይነ መላ ም አጭሰይ ታና ጎዳ ግደይሳ ቢታን ደእያ ም ኡባይ ኤራና። ታኒ ጎዳይ ሀይሳ ኦዳስ፤ ታ ኦድዳይሳ ታ ኦና” ያጌስ።<verse eid="EZK 17:24"/></para>
  <chapter eid="EZK 17"/>
  <chapter number="18" style="c" sid="EZK 18"/>
  <para style="s1">ናጋራ ኦያ ሸምፕያ ሀይቃና</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 18:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 18:1"/><verse number="2" style="v" sid="EZK 18:2"/>“እስራኤለ ቢታባ አሳይ፥ ‘አዋቲ ቃዉኤ ዎይነ ምን፥ ናይታ አቻይ ሀይቅስ’ ያግድ ኦድያ ሌምሶይ አይቤ? <verse eid="EZK 18:2"/><verse number="3" style="v" sid="EZK 18:3"/>ታኒ ኡባ ሃርያ ጎዳይ ታ ደኡዋን ጫቃስ። ህዛፐ ጉየ ህንተ እስራኤለ ቢታን ሀ ሌምሱዋ ሌምሰከታ። <verse eid="EZK 18:3"/><verse number="4" style="v" sid="EZK 18:4"/>አሳ ኡባ ሸምፖይ ታባ፤ አዋ ሸምፖይነ ናኣ ሸምፖይ ታባ። ናጋራ ኦያ ሸምፖይ እ፥ ባዉ ሀይቃና።<verse eid="EZK 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 18:5"/>“እስ አስ ፅሎ ግድኮ፥ ቱማ ፕርዳነ ሱረባ ኦኮ፥ <verse eid="EZK 18:5"/><verse number="6" style="v" sid="EZK 18:6"/>እ ደርያ ቦላ ደእያ ኤቃ ጎይንያ በሳን ሜና፤ እስራኤለ አሳ ኤቃ ጎይነና፤ ባ ሾሩዋ ማችዉ ቱንሰና፤ ኩሸ መቶራ ደእያ ማጫራ አቀና፤ <verse eid="EZK 18:6"/><verse number="7" style="v" sid="EZK 18:7"/>ኦናካ ኡንኤና፤ አጮስ ኦይክዳባ ጉየ ዛሬስ፥ ቦንቀና፤ ኮሻትዳ አስ ሙዜስ፤ ካሎትዳ አስ ማይዜስ፤ <verse eid="EZK 18:7"/><verse number="8" style="v" sid="EZK 18:8"/>ባ ሚሽያ የሎራ ታልኤና፤ ባ ኩሽያ ኢታባፐ ናጌስ፤ አሰ ስገሸ ፅሎ ፕርዴስ። <verse eid="EZK 18:8"/><verse number="9" style="v" sid="EZK 18:9"/>ታ ህግያ ናጌስ፤ ታ ዎጋ አማነተን ፖሌስ፤ ሄ ኡራይ ፅሎ አስ ግድያ ግሾ እ ደኦን ዳና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 18:10"/>ግዶሽን፥ ሄ ኡራስ ሸምፖ ዎያ ዎይኮ ካልድ ደኤይሳታፐ እሱዋ ኦያ ኢታ ናእ ደእኮ፥ <verse eid="EZK 18:10"/><verse number="11" style="v" sid="EZK 18:11"/>እያ አዋይ ሀይሳታፐ እሱዋካ ኦና አግን፥ እያ ናአይ ደረ ቦላ ኤቃ ጎይኖ በሳታን ሚኮ፥ አሳ ማቾ ቱንስኮ፥ <verse eid="EZK 18:11"/><verse number="12" style="v" sid="EZK 18:12"/>መቶታንቾታነ ማንቆታ ኡንኤኮ፥ ቦንቅኮ፥ አጮስ ኦይክዳባ ዛሮና እፅኮ፥ ኤቃ ጎይንኮ፥ ቱናባ ኦኮ፥ <verse eid="EZK 18:12"/><verse number="13" style="v" sid="EZK 18:13"/>ባ ሚሽያ የሎራ ታልእድ ዎ ኤክኮ፥ ሄሳ መላ አስ ደኦን ደአኔ? እ ደኦን ዴና! እ ሄሳ መላ ቱናባ ኦዳ ግሾ ቱማ ሀይቃና፤ እያ ጎመይ እያ ኦይካና።<verse eid="EZK 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 18:14"/>“ሀ ኢታ ኡራስ ናእ ደእኮ ሄ ናአይ ባ አዋይ ኦያ ሀ ናጋራ ኡባ በእሸ፥ ሄሳ መላባ ኦና እፅኮ፥ <verse eid="EZK 18:14"/><verse number="15" style="v" sid="EZK 18:15"/>እ ደረ ቦላ ደእያ ኤቃ ጎይኖ በሳታን ሞና እፅኮ፥ እስራኤለ አሳ ኤቃ ጎይኖና እፅኮ፥ ባ ላግያ ማችዉ ቱንሶና እፅኮ፥ <verse eid="EZK 18:15"/><verse number="16" style="v" sid="EZK 18:16"/>ኦናካ ኡንኤና እፅክ፥ አጮስ ኦይክዳባ ጉየ ዛርኮ፥ ቦንቆና እፅኮ፥ ኮሻትዳይሳ ሙዝኮ፥ ካሎትዳይሳ ማይዝኮ፥ <verse eid="EZK 18:16"/><verse number="17" style="v" sid="EZK 18:17"/>ኢታ ኦሶፐ ባ ኩሽያ ተቅኮ ዎ ኤካናዉ የሎራ ታልኦና እፅኮ፥ ታ ህግያ ናግኮ፥ ታ ዎጋ ካልኮ፥ ያትኮ፥ ሄ ናአይ ደኦን ዳናፐ አትሽን፥ ባ አዋ ናጋራ ጋሶን ሀይቀና። <verse eid="EZK 18:17"/><verse number="18" style="v" sid="EZK 18:18"/>ሽን እያ አዋይ አሳ ማታ ሱግዳ ግሾ፥ ባ እሻታ ቦንቅዳ ግሾነ ባ አሳ ግዶን ኢታ ኦዳ ግሾ ባ ናጋራ ጋሶን ሀይቃና።<verse eid="EZK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 18:19"/>“ሽን ህንተ፥ ‘ናአይ ባ አዋ ናጋራ ጋሶን አይስ ሴረተኔ?’ ” ያጌታ። ናአይ ቱማ ፕርዳነ ሱረ ኦድ፥ ታ ህግያ ምንድ ናግኮ፥ ቱማ ደኦን ዳና። <verse eid="EZK 18:19"/><verse number="20" style="v" sid="EZK 18:20"/>ናጋራ ኦያ ኡራይ ባዉ ሀይቃና። ናአይ አዋ ናጋራ ጋሶን ሴረተና፤ ሄሳዳካ፥ አዋይ ናኣ ናጋራ ጋሶን ሴረተና። ፅሎ አስ ባ ፅሎተ ጋትያ ኤካና፤ ኢታ አስ ባ ኢታተን ሴረታና።<verse eid="EZK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 18:21"/>ሽን ኢታ አስ ባ ናጋራ ኡባፈ ስሚድ፥ ታ ኪታ ናግኮ ቱማ ፕርዳነ ሱረ ኦኮ፥ እ ቱማ ደኦን ዳናፐ አትሽን፥ ሀይቀና። <verse eid="EZK 18:21"/><verse number="22" style="v" sid="EZK 18:22"/>እ ኦዳ ናጋራፐ እሶይካ ቆፈተና፤ ባ ኦዳ ፅሎ ኦሱዋ ጋሶን እ ደኦን ዳና። <verse eid="EZK 18:22"/><verse number="23" style="v" sid="EZK 18:23"/>ታኒ ኡባ ሃርያ ጎዳይ፥ ኢታ አስ ባ ኢታ ኦግያፐ ስሚድ፥ ደኦን ደኤይሳን ኡፋይታይስፐ አትሽን፥ እያ ሀይቁዋን ኡፋይትከ።<verse eid="EZK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 18:24"/>ሽን ፅሎ አስ ባ ፅሎተ አግድ፥ ኢታ አስ ኦያ ቱና ኦሶታ ኡባ ኦኮ፥ እ ደኦን ዳኔ? ሀነና፥ እ ኦዳ ፅሎ ኦሱዋፐ እሶይካ ቆፈተና፤ እ አማነቶና እፅዳ ግሾነ እ ኦዳ ናጋራ ግሾ እ ሀይቃና።<verse eid="EZK 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 18:25"/>ግዶሽን፥ “ህንተ፥ ‘ጎዳ ኦገይ ሱረ ግደና’ ጌታ። እስራኤለ አሳዉ፥ ስእተ፤ ሱረ ግዶናይ ታ ኦግያዬ? ህንተ ኦግያ ግደኔ? <verse eid="EZK 18:25"/><verse number="26" style="v" sid="EZK 18:26"/>ፅሎ አስ ባ ፅሎተ አግድ፥ ኢታ ኦያ ዎደ ባ ናጋራን ሀይቄስ፤ ባ ኦዳ ቆሁዋ ጋሶን ደኦን ደኤና። <verse eid="EZK 18:26"/><verse number="27" style="v" sid="EZK 18:27"/>ሽን ኢታ አስ ባ ኢታተ አግድ፥ ቱማ ፕርዳነ ሱረ ኦያ ዎደ ባ ሸምፑዋ አሻና። <verse eid="EZK 18:27"/><verse number="28" style="v" sid="EZK 18:28"/>እ ባ ኦዳ ናጋራ ቆፕድ ጉየ ስምዳ ግሾ፥ እ ቱማ ደኦን ዳናፐ አትሽን፥ ሀይቀና። <verse eid="EZK 18:28"/><verse number="29" style="v" sid="EZK 18:29"/>ሽን እስራኤለ አሳይ፥ ‘ጎዳ ኦገይ ሱረ ግደና’ ያግዶሶና። እስራኤለ አሳዉ፥ ሱረ ግዶናይ ታ ኦግያ? ህንተ ኦግያ ግደኔ?<verse eid="EZK 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 18:30"/>“ህንተኖ፥ እስራኤለ አሳዉ፥ ታ ህንተና ህንተ ኦሱዋ ኦሱዋ ፕርዳና። ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ ናጋር ህንተዉ ዮስ ጋሶ ግዶና መላ ፓፅተ፤ ህንተ ባላ ኡባፈ ስምተ። <verse eid="EZK 18:30"/><verse number="31" style="v" sid="EZK 18:31"/>ህንተ ኢታ ኦሱዋ ኡባ ዎራ የግድ፥ ኦራ ዎዛናነ ኦራ አያና ኤክተ። ህንተኖ፥ እስራኤለ አሳዉ፥ አይስ ሀይቄቲ? <verse eid="EZK 18:31"/><verse number="32" style="v" sid="EZK 18:32"/>ታኒ እስ አሳ ሀይቆንካ ኡፋይትከ። ሄሳ ግሾ፥ ህንተ ናጋራ ፓፅድ፥ ደኦን ደእተ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 18:32"/></para>
  <chapter eid="EZK 18"/>
  <chapter number="19" style="c" sid="EZK 19"/>
  <para style="s1">እስራኤለ ካዎታስ ከስዳ ዘለልስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 19:1"/>ጎዳይ ህዝቄላኮ፥ እስራኤለ ሀላቃታስ ሀይሳዳ ያጋዳ ዘሌላ፦<verse eid="EZK 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="EZK 19:2"/>“ህንተ አይያ ጋሞታ ግዶን ዋንዳ ጋሞ!</para>
  <para style="q2" vid="EZK 19:2">ያላጋ ጋሞታ ግዶን ዝንአዳ፥ ባ ማራታ ድቻሱ።<verse eid="EZK 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 19:3"/>እያ ባ ማራታፐ እሱዋ ድችን፥</para>
  <para style="q2" vid="EZK 19:3">እ ዎዳላ ጋሞ ግድስ፤</para>
  <para style="q2" vid="EZK 19:3">ሻንካ ታማርስ፤ አሰ ሙሱ ዶምስ።<verse eid="EZK 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 19:4"/>ካዎተት ኡባይ እያባ ስእዶሶና፤</para>
  <para style="q2" vid="EZK 19:4">ኤንቲ ቦክዳ ኦላን ገልድ ኦይከትስ፤</para>
  <para style="q2" vid="EZK 19:4">ሲን ዎዶሮ አድ ግብፀ ቢታ ኤፍዶሶና።<verse eid="EZK 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 19:5"/>እያ አይያ ናግዳይስ ሀኖና እፅን፥</para>
  <para style="q2" vid="EZK 19:5">እ ኡፋይሳይ ይዳይሳ በእዳ ዎደ፥</para>
  <para style="q2" vid="EZK 19:5">ባ ማራታፐ እሱዋ ድቻዳ፥ ዎዳላ ጋሞ ከሳሱ።<verse eid="EZK 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 19:6"/>እ ዎዳላ ጋሞ ግድድ፥ ሀራ ጋሞታራ ስመረትስ፤</para>
  <para style="q2" vid="EZK 19:6">እ ሻንካ ታማርስ፤ አሰ ሙሱ ኦይክስ።<verse eid="EZK 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 19:7"/>እ ኤንታ ሚፃ መንረስ፤ ካታማታ ይስስ፤</para>
  <para style="q2" vid="EZK 19:7">እ ጉድያ ዎደ ቢታን ደእያ አሳ ኡባይ ዳጋሜስ።<verse eid="EZK 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 19:8"/>እያ ዩሹዋን ደእያ ካዎተት ኡባይ</para>
  <para style="q2" vid="EZK 19:8">እያ ኦይካናዉ ፅሄ ዎዶሶና፤</para>
  <para style="q2" vid="EZK 19:8">ባንታ ግትያ ምጭዶሶና፤ ኤንታ ኦላን እ ኦይከትስ፤<verse eid="EZK 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 19:9"/>ኤንቲ እያ ስን ዎዶሮ አድ ሆን የግድ፥</para>
  <para style="q2" vid="EZK 19:9">ባብሎነ ካዋኮ ኤፍዶሶና።</para>
  <para style="q1" vid="EZK 19:9">እ ጉደይስ ዛሪድ እስራኤለን ስኤቶና መላ</para>
  <para style="q2" vid="EZK 19:9">ኤንቲ እያ ቃሾ ኬን የግዶሶና።<verse eid="EZK 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 19:10"/>ነ አይያ ሃ ዶናን ቶከትዳ ዎይነ መላ፤</para>
  <para style="q2" vid="EZK 19:10">ዳሮ ሃ ደእያ ግሾ</para>
  <para style="q2" vid="EZK 19:10">ዎይነይ ዳሻንነ አይፈን ኩምድ ደኤስ።<verse eid="EZK 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 19:11"/>እያ ታሸት ምኖ ግድያ ግሾ</para>
  <para style="q2" vid="EZK 19:11">ካዎታ ፃምአ ግድዶሶና።</para>
  <para style="q1" vid="EZK 19:11">ዎይነይ ዎራን ደእያ ምታፐ አድ ድጭስ፤</para>
  <para style="q2" vid="EZK 19:11">ባ ታሽያ ዳሮተንነ አዱሳተን</para>
  <para style="q2" vid="EZK 19:11">ኡባፈ ቦላራ በንትስ።<verse eid="EZK 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 19:12"/>ሽን ሄ ዎይነይ ሀንቆን ሾደትድ ሳአን የገትስ፤</para>
  <para style="q2" vid="EZK 19:12">ዶሎሀ ጫርኮይ እያ አይፍያ መልስስ፤</para>
  <para style="q2" vid="EZK 19:12">እያ ምኖ ታሸይ መልን ታም ምስ።<verse eid="EZK 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 19:13"/>ሀእ እ ሃ ባይና</para>
  <para style="q2" vid="EZK 19:13">መላ ቢታን ቶከትስ።<verse eid="EZK 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 19:14"/>ታም እያ ኡባፈ ከይድ፥</para>
  <para style="q2" vid="EZK 19:14">እያ አይፍያነ ታሽያ ምስ።</para>
  <para style="q1" vid="EZK 19:14">ካዎታ ፃምአ ግዳና ምኖ ታሸይ፥</para>
  <para style="q2" vid="EZK 19:14">እያ ቦላ በንትቤና።</para>
  <para style="m" vid="EZK 19:14">ሀይስ ዬሆ ዘለልስ፤ ሀይሳ ዘለልስ ከስያ ዎደ ጎኤታናዉ በሴስ” ያግስ።<verse eid="EZK 19:14"/></para>
  <chapter eid="EZK 19"/>
  <chapter number="20" style="c" sid="EZK 20"/>
  <para style="s1">ጌላ እስራኤለ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 20:1"/>ኑ ድኤትዳ ላፑን ላይን፥ እቻሻን አጌናን፥ ታማን ጋላሳን፥ እስራኤለ ጭማታፐ ጉት ጎዳ ሸንያ ኦይቻናዉ ይድ፥ ታ ስንን ኡትዶሶና።<verse eid="EZK 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 20:2"/>ሄ ዎደ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ፤ <verse eid="EZK 20:2"/><verse number="3" style="v" sid="EZK 20:3"/>“አሳ ናአዉ፥ ኡባ ሃርያ ጎዳይ፥ እስራኤለ ጭማታኮ ጎዳይ ሀይሳዳ ያጌስ ያጋ፦ ‘ህንተ ታ ሸንያ ኦይቻናዉ ይደቲ? ታኒ ኡባ ሃርያ ጎዳይ ታ ደኡዋን ጫቃስ፦ ህንተ ታና ኦይቻና መላ ታ ኮይከ።’<verse eid="EZK 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 20:4"/>“አሳ ናአ ነ ኤንታ ቦላ ፕርዳኔ? ቱማ ኤንታ ቦላ ፕርዳኔ? ሄሳ ግድኮ፥ ኤንታ ማይዛታ ቱና ኦሱዋ ኤንታ ኤርሳ። <verse eid="EZK 20:4"/><verse number="5" style="v" sid="EZK 20:5"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኤንታዉ ኦዳ። ‘ታኒ እስራኤለ ዶርዳ ዎደ ታ ኩሽያ ደንዳ ያይቆባ ዘረስ ጫቃስ። ታኒ ታናተ ግብፀ ቢታን ኤንታዉ ቆንጭሳስ። ታ ኩሽያ ደንዳ፥ ታኒ ጎዳ፥ ህንተ ፆሳ። <verse eid="EZK 20:5"/><verse number="6" style="v" sid="EZK 20:6"/>ታ ህንተና ግብፀፈ ከሳዳ፥ ህንተዉ ዶርዳ ቢታ፥ ማነ ኤስ ጎግያ ቢታ፥ ሀራ ቢታ ኡባፈ አዳ ሎኦ ቢታ ኤሀና’ ጋዳ ጫቃስ። <verse eid="EZK 20:6"/><verse number="7" style="v" sid="EZK 20:7"/>ታ ኤንታኮ፥ ‘ህንተ እሶይ እሶይ ዶስያ ቱና ኤቃታ ድግተ፤ ግብፀ ኤቃታን ህንተና ቱንሶፕተ። ታኒ ጎዳ ህንተ ፆሳ’ ” ያጋስ።<verse eid="EZK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 20:8"/>ግዶሽን፥ ኤንቲ ታዉ ማካልድ፥ ታ ኦድያባ ስኦና እፅዶሶና። ኤንቲ ባንታ አሞትዳ ቱና ኤቃታ ድግቦኮና፤ ግብፀ ኤቃታ ጎይኖ አግቦኮና። ሄሳ ግሾ፥ ኤንቲ ግብፀን ደእሽን፥ ታ ሀንቁዋ ኤንታ ቦላ ጉሳናዉ ቆፓስ። ታ ሸንያ ዉርሳናዉ ቆፋ ቃቻስ። <verse eid="EZK 20:8"/><verse number="9" style="v" sid="EZK 20:9"/>ሽን ኤንቲ ደእያ ካዎተታ ግዶንነ እስራኤለ አሳ ግብፀፈ ከሳናዉ ጫቅያ ዎደ ታ ታናተ ኤርስዳ አሳ ስንን ታ ሱንይ ቱኖና መላ ኦስ። <verse eid="EZK 20:9"/><verse number="10" style="v" sid="EZK 20:10"/>ሄሳ ግሾ፥ ታ ኤንታ ግብፀፈ ከሳዳ መላ ቢታ ኤሀስ። <verse eid="EZK 20:10"/><verse number="11" style="v" sid="EZK 20:11"/>ኪተትያ ኡባስ ደኦ እምያ ታ ህግያ ኤንታዉ እማስ፤ ታ ዎጋ ኤንታ ታማርሳስ። <verse eid="EZK 20:11"/><verse number="12" style="v" sid="EZK 20:12"/>ኤንታ ጌሸይ ታና ጎዳ ግደይሳ ኤንቲ ኤራና መላ፥ ታ ሳምባታ ታፐነ ኤንታፈ ግዶን ማላ ኦዳ እማስ።<verse eid="EZK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 20:13"/>ሽን እስራኤለ አሳይ መላ ቢታን ታ ቦላ ማካልዶሶና። ኪተትይዳ ኡባስ ደኦ እምያ ታ ህግያ መንዶሶና፤ ታ ዎጋ ካልቦኮና፤ ታ ሳምባታ ቱንስዶሶና። ታኒ መላ ቢታን ታ ሀንቁዋ ኤንታ ቦላ ጉሳዳ ኤንታ ይሳናዉ ቆፓስ። <verse eid="EZK 20:13"/><verse number="14" style="v" sid="EZK 20:14"/>ሽን ታ ኤንታ ግብፀፈ ከስያ ዎደ በእዳ ካዎተታ ስንን ታ ሱንይ ቱኖና መላ ኤንታ ይሳብከ። <verse eid="EZK 20:14"/><verse number="15" style="v" sid="EZK 20:15"/>ኤንቲ መላ ቢታን ደእሽን፥ ኤንታዉ እምዳ፥ ሀራ ቢታ ኡባፈ ሎኦ ግድዳ ማነ ኤስ ጎግያ ቢታ፥ ኤንታ ገልስከ ጋዳ ጫቃስ። <verse eid="EZK 20:15"/><verse number="16" style="v" sid="EZK 20:16"/>ሄስ ሀንዳይ ኤንቲ ኤቃ ጎይንድ፥ ታ ህግያ መንዳ ግሾ፥ ታ ዎጋ ካልቦና ግሾነ ታ ሳምባታ ቱንስዳ ግሾሳ። <verse eid="EZK 20:16"/><verse number="17" style="v" sid="EZK 20:17"/>ግዶሽን፥ ታ ኤንታዉ ቃትዳ ግሾ፥ መላ ቢታን ኤንታ ዉርሳ ይሳብከ።<verse eid="EZK 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 20:18"/>ኤንቲ መላ ቢታ ደእሽን፥ ኤንታ ናይታኮ ሀይሳዳ ያጋስ፤ “ህንተ አዋታ ዎጋ ካሎፍተ፤ ኤንታ ህግያ ናጎፕተ፤ ዎይኮ ኤንታ ኤቃታን ቱኖፕተ። <verse eid="EZK 20:18"/><verse number="19" style="v" sid="EZK 20:19"/>ታኒ ጎዳ ህንተ ፆሳ። ታ ዎጋስ ኪተትተ፤ ታ ህግያ ናግተ። <verse eid="EZK 20:19"/><verse number="20" style="v" sid="EZK 20:20"/>ታ ህንተራ ጫቅዳ ጫቁዋስ ማላ ግዳና መላነ ታኒ ጎዳ ህንተ ፆሳ ግደይሳ ህንተ ኤራና መላ ሳምባታ ዱማይተ” ያጋስ።<verse eid="EZK 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 20:21"/>“ሽን ኤንታ ናይት ታ ቦላ ማካልዶሶና፤ ኪተትያ ኡባስ ደኦ እምያ ታ ዎጋ መንዶሶና፤ ታ ህግያ ናግቦኮና፤ ታ ሳምባታ ቱንስዶሶና። ያትን፥ መላ ቢታን ታ ሀንቁዋ ኤንታ ቦላ ጉሳዳ ታ ይሎይ ዉራና ጋካናዉ ኤንታና ይሳናዉ ቆፓስ። <verse eid="EZK 20:21"/><verse number="22" style="v" sid="EZK 20:22"/>ሽን ታኒ ኤንታ ግብፀፈ ከስያ ዎደ በእዳ ካዎተታ ስንን ታ ሱንይ ቱኖና መላ ኤንታ ይሳብከ። <verse eid="EZK 20:22"/><verse number="23" style="v" sid="EZK 20:23"/>ኤንታ ሀራ ካዎተታ ግዶነ ዱማ ዱማ ቢታ ላላናዉ መላ ቢታን ታ ኩሽያ ደንዳ ጫቃስ። <verse eid="EZK 20:23"/><verse number="24" style="v" sid="EZK 20:24"/>ኤንቲ ታ ዎጋስ ኪተቶና እፅዶሶና፤ ታ ህግያ መንዶሶና፤ ታ ሳምባታ ቱንስዶሶና፤ ባንታ አዋታ ኤቃ አሞትዶሶና። <verse eid="EZK 20:24"/><verse number="25" style="v" sid="EZK 20:25"/>ያትን፥ ኤንታዉ ሎኦ ግዶና ዎጋታነ ደኦ እሞና ህገታ እማስ። <verse eid="EZK 20:25"/><verse number="26" style="v" sid="EZK 20:26"/>ኤንቲ ባንታ ያርሹዋን ቱናናዳ፥ ባንታ ባይራ ናይታ ያርሻናዳ፥ ታ ኤንታ የዳ በሳስ። ታ ሄሳ ኦዳይ ኤንታ ዳጋንናሳነ ታኒ ጎዳ ግደይሳ ኤንቲ ኤራና መላሳ” ያግስ።<verse eid="EZK 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 20:27"/>“ሄሳ ግሾ፥ አሳ ናአዉ፥ እስራኤለ አሳስ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ፦ ሄሳ ኦድ ህንተ አዋት አማነቶና እፅድ ታና ጫይዶሶና። <verse eid="EZK 20:27"/><verse number="28" style="v" sid="EZK 20:28"/>ታ ኤንታዉ እማና ጋዳ ታ ኩሽያ ደን ጫቅዳ ቢታ ኤንታ ኤህዳ ዎደ፥ ኤንቲ ደረታ ኡባነ እርፃ ም ኡባ በእዶሶና። ያን ባንታ ያርሹዋ ያርሽዶሶና። ባንታ፥ እፃንያንነ ኡሻ ያርሹዋን ታና ይሎይዶሶና። <verse eid="EZK 20:28"/><verse number="29" style="v" sid="EZK 20:29"/>ታኒ፥ ‘ሀይስ ህንተ ብያ ቃ በሳይ አይቤ?’ ያጋዳ ኦይቻስ። ሀች ጋካናዉ ሄ በሳይ ‘ባማ’ ጌተቴስ እያ ብርሸይ ‘ቃ ጎይኖ በሳታ’ ጌተትድ ፄገቴስ” ያጌስ።<verse eid="EZK 20:29"/></para>
  <para style="s1">ሴራነ ማሮታ</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 20:30"/>“ሄሳ ግሾ፥ እስራኤለ አሳስ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ያጋዳ ኦዳ፦ ‘ህንተ ማይዛት ኦዳ ናጋራ ኦድ፥ አይስ ህንተና ቱንሴቲ? ኤንታ ቱና ኤቃ ጎይናናዉ አሞትድ አይስ ካሌቲ?’ <verse eid="EZK 20:30"/><verse number="31" style="v" sid="EZK 20:31"/>ሀችካ ህንተ ያርሹዋ ያርሽያ ዎደ ህንተ ናይታ ታማን ያርሽድ፥ ኤቃ ኡባን ህንተና ቱንሴታ። ህንተኖ፥ እስራኤለ አሳዉ፥ ታኒ ህንተናን ኦይሸቶ? ታኒ ኡባ ሃርያ ጎዳይ ታ ደኡዋን ጫቃስ፦ ታ ህንተናን ኦይሸትከ። <verse eid="EZK 20:31"/><verse number="32" style="v" sid="EZK 20:32"/>ህንተ፥ ‘ኑኒ ምነ ሹቹ ጎይንያ ሀራ ካዎተታ መላነ ቢታን ደእያ ሀራ አሳ መላ ግዳና ያግድ ቆፔታ። ሽን ህንተ ቆፋይ ፖሎ ሀነና።’ ”<verse eid="EZK 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 20:33"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታ ምኖ ቀስያን፥ ታ ምጨትዳ ኩሽያንነ ታ ሀንቁዋን ህንተ ቦላ ካዎታና። <verse eid="EZK 20:33"/><verse number="34" style="v" sid="EZK 20:34"/>ካዎተታ ግዶፈ ታ ህንተና ከሳና፤ ህንተ ላለትዳ ቢታ ኡባፈ ታ ምኖ ቀስያን፥ ታ ምጨትዳ ኩሽያንነ ታ ሀንቁዋን ህንተና ሺሻና። <verse eid="EZK 20:34"/><verse number="35" style="v" sid="EZK 20:35"/>ታ ህንተና ‘ካዎተታ መላ ቢታ’ ግያ መላ ቢታ ኤሀዳ፥ ህንተና ታ ስንን ኤሳዳ፥ ህንተ ቦላ ፕርዳና። <verse eid="EZK 20:35"/><verse number="36" style="v" sid="EZK 20:36"/>ግብፀ መላ ቢታን ህንተ ማይዛታ ቦላ ፕርድዳይሳዳ፥ ህንተ ቦላ ፕርዳና። <verse eid="EZK 20:36"/><verse number="37" style="v" sid="EZK 20:37"/>ታኒ ህንተና ታ ካዎተ ፃምአ ጋርሳን ሃራና፤ ህንተ ታ ጫቁዋ ናጋና መላ ኦና። <verse eid="EZK 20:37"/><verse number="38" style="v" sid="EZK 20:38"/>ማካላንቾታነ ናጋራንቾታ ታ ህንተ ግዶፈ ድጋና፤ ሀእ ኤንቲ ደእያ ቢታፈ ታ ኤንታ ከሳና። ሽን ኤንቲ እስራኤለ ቢታ ገሎና መላ ተቃና፤ ሄ ዎደ ታኒ ጎዳ ግደይሳ ህንተ ኤራና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="EZK 20:39"/>እስራኤለ አሳዉ፥ ህንተኮ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ሀእ ታ ኦደይሳ ህንተ ስኦና እፅኮ፥ ኡባይ ብድ ህንተ ኤቃ ጎይንተ። ሽን ህዛፐ ጉየ፥ ህንተ እሞታንነ ህንተ ኤቃታን ታ ጌሻ ሱን ቱንሶፕተ። <verse eid="EZK 20:39"/><verse number="40" style="v" sid="EZK 20:40"/>ታ ጌሻ ዙማ ቦላ፥ ቃ እስራኤለ ዙማ ቦላ ህንተ እስራኤለ አሳይ ታና፥ ኡባ ሃርያ ጎዳ ጎይናና። ታኒ ህንተና ኤካና፤ ህንተ ያርሹዋ፥ ህንተ ዶርዳ እሙዋነ ህንተ ጌሻ እሙዋ ታ ህንተፈ ኮያና። <verse eid="EZK 20:40"/><verse number="41" style="v" sid="EZK 20:41"/>ህንተ ላለትዳ ካዎተታ ግዶፈ ታኒ ህንተና ኤህያ ዎደነ ሀራ ቢታታፐ ታ ህንተና ሺሽያ ዎደ ሳዎ ቶንኩ ግያ ያርሾዳ ታ ህንተና ኤካና። ካዎተት ፄልሽን፥ ህንተ ግዶን ታ ጌሻተ ቆንጭሳና። <verse eid="EZK 20:41"/><verse number="42" style="v" sid="EZK 20:42"/>ካሰ ህንተ ማይዛታስ እማና ጋዳ ታ ኩሽያ ደንዳ ጫቅዳ እስራኤለ ቢታ ህንተና ዛራዳ ኤህዳ ዎደ ታኒ ጎዳ ግደይሳ ህንተ ኤራና። <verse eid="EZK 20:42"/><verse number="43" style="v" sid="EZK 20:43"/>ህንተ ኢታ ሀኖታነ ህንተ ቱና ኦሱዋ ህንተ ሄ በሳን ሀሳያና፤ ህንተ ኦዳ ኢታ ኦሶ ኡባ ህንተ ሻተታና። <verse eid="EZK 20:43"/><verse number="44" style="v" sid="EZK 20:44"/>ህንተኖ፥ እስራኤለ አሳዉ፥ ህንተ ኢታ ሀኖታ መላነ ህንተ ቱና ኦሱዋ መላ ግዶናሽን፥ ታ ሱን ግሾ ታ ኦያ ዎደ ታኒ ጎዳ ግደይሳ ህንተ ኤራና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 20:44"/></para>
  <para style="s1">ዱገሀ ባጋ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="45" style="v" sid="EZK 20:45"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 20:45"/><verse number="46" style="v" sid="EZK 20:46"/>“አሳ ናአዉ፥ ዱገሀ ባጋ ስማዳ ፄላ፤ ዱገሀ ባጋስ ኦዳ፤ ዱገሀ ዎራ ቦላ ትንብተ ኦዳ። <verse eid="EZK 20:46"/><verse number="47" style="v" sid="EZK 20:47"/>ዱገሀ ዎራስ፥ ኡባ ሃርያ ጎዳይ ኦድያባ ስአ ያጋዳ ኦዳ። ‘ታ ነ ግዶን ታማ የዳና፤ ሄ ታማይ ጭልኦ ምነ መላ ም ኡባ ማና። ሄ ኤፅያ ታማይ ቶኤና፤ ዱገሀፐ ብድ፥ ፑደሀ ባጋ ጋካናዉ ደእያ አሳ ሶምኦ ኡባ ሄ ላጮይ ላባና። <verse eid="EZK 20:47"/><verse number="48" style="v" sid="EZK 20:48"/>ሄ ታማ ኦይዳይ ታና ጎዳ ግደይሳ አሳ ኡባይ በአና። ሄ ታማይ ቶኤና’ ” ያጌስ።<verse eid="EZK 20:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="EZK 20:49"/>ታኒ ዛራዳ፥ “ኡባ ሃርያ ጎዳዉ፥ ሄሳ ኦዳ ጋዳ ታና ኪቶፋ። ኤንቲ፥ ‘እ ኡባ ዎደ ሌምሶን ኦዴስ ግደኔ?’ ያጎሶና” ያጋስ።<verse eid="EZK 20:49"/></para>
  <chapter eid="EZK 20"/>
  <chapter number="21" style="c" sid="EZK 21"/>
  <para style="s1">ባብሎነ ማሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 21:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 21:1"/><verse number="2" style="v" sid="EZK 21:2"/>“አሳ ናአዉ፥ ነ ሶምኡዋ የሩሳላመኮ ዛራዳ፥ አሳይ ጎይንያ በሳታ ቦላነ እስራኤለ ቢታ ቦላ ትንብተ ኦዳ። <verse eid="EZK 21:2"/><verse number="3" style="v" sid="EZK 21:3"/>ሀይሳዳ ያጋ፦ ‘ታኒ ነዉ ሞርከ። ታኒ ታ ማሻ ሾሁዋፐ ሾዳዳ፥ ነ ግዶፐ ፅሎ አሳነ ኢታ አሳ ኡባ ዉርሳና። <verse eid="EZK 21:3"/><verse number="4" style="v" sid="EZK 21:4"/>ፅሉዋነ ናጋራንቹዋ ኡባ ይሳናዉ ዱገሀፐ ፑደሀ ጋካናዉ ደእያ አሳ ኡባ ቦላ ታ ማሻ ሾዳና። <verse eid="EZK 21:4"/><verse number="5" style="v" sid="EZK 21:5"/>ታኒ ጎዳይ፥ ታ ማሻ ሾሁዋፐ ሾድዳይሳነ ጉየ ዛሮናይሳ አሳ ኡባይ ኤራና’ ” ያጌስ።<verse eid="EZK 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 21:6"/>“ሄሳ ግሾ፥ አሳ ናአዉ፥ አሳ ኡባይ ፄልሽን፥ ነ ዎዛናይ መቅን፥ ጫመታዳ ኦላ። <verse eid="EZK 21:6"/><verse number="7" style="v" sid="EZK 21:7"/>‘አይስ ኦላይ?’ ያግድ ኤንቲ ነና ኦይችኮ፥ ‘ስንራ ያ ኢታ ዎርያ ግሾ ኦላይስ’ ያጋ። ሄ ዎርያን፥ ‘ዎዛን ኡባይ ያሻን ሴራና፤ ኩሸ ኡባይ አርጋጫና፤ ጎባተ ኡባይ ኤከታና፤ ጉልባት ኡባይ ኮኮራና። ሄ ዎደይ ጋክስ፤ ቱማ ፖለታና’ ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 21:8"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ፦ <verse eid="EZK 21:8"/><verse number="9" style="v" sid="EZK 21:9"/>“አሳ ናአዉ፥ ትንብተ ኦዳ፤ ታኒ ጎዳይ ኦድያባ አሳስ ኦዳ፤ ማሻ፤ ሌፈትዳነ ቁሸትዳ ማሻ።<verse eid="EZK 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 21:10"/>“ጎራአናዉ ሌፈትስ፤</para>
  <para style="q2" vid="EZK 21:10">ዎልአን መላ ጶላናዉ ቁሸትስ።</para>
  <para style="q1" vid="EZK 21:10">ታ አሳይ እመትዳ ሴራ እፅዳ ግሾ፥</para>
  <para style="q2" vid="EZK 21:10">ህዛፐ ጉየ፥ ኦንካ ኡፋይተና።<verse eid="EZK 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 21:11"/>ጎኤታናዉ ማሻይ ቁሸትስ፤</para>
  <para style="q2" vid="EZK 21:11">ሌፈትድነ ቁሸትድ፥ ጎራኤይሳስ እመታናሳ።<verse eid="EZK 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 21:12"/>አሳ ናአዉ፥ ዬካነ ዘሌላ፤</para>
  <para style="q2" vid="EZK 21:12">ሀ ማሻይ ጊገትዳይ ታ አሳ ቦላነ</para>
  <para style="q2" vid="EZK 21:12">እስራኤለ ሀላቃታ ቦላና።</para>
  <para style="q1" vid="EZK 21:12">ሀላቃት ታ አሳራ እስፈ ማሻን ሀይቃና፤</para>
  <para style="q2" vid="EZK 21:12">ሄሳ ግሾ፥ አዛናዳ ነ ትራ ቆፃ።<verse eid="EZK 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 21:13"/>ታኒ ታ አሳ ፓጫና፤</para>
  <para style="q2" vid="EZK 21:13">ኤንቲ ናጋራ ፓፆና እፅኮ፥</para>
  <para style="q2" vid="EZK 21:13">ሀ መቶይ ኡባይ ኤንታ ቦላ ያና፤</para>
  <para style="m" vid="EZK 21:13">ኡባ ሃርያ ጎዳይ ሀይሳ ኦድስ።<verse eid="EZK 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 21:14"/>“ሀእካ አሳ ናአዉ፥ ትንብተ ኦዳ፤ ነ ኩሽያ ባቃ። ሄ ዎደ ማሽ ናምኡ ቶሆ ሄ ቶሆ ዛሪድ ሾጫና፤ ሄስካ ዳጋንያ፥ ዩሹዋ ኡባን ዎያነ ሹክያ ማሽ። <verse eid="EZK 21:14"/><verse number="15" style="v" sid="EZK 21:15"/>ሄስ ኤንታ ዎዛናይ ትልአናዳነ ኤንታፈ ዳሮት በታናዳ ኦና። ህንተና አየ! ህንተ ፐንገን ማሽ ዎልአን መላ ዎልአሜስ፤ ሹካናዉ ሾሆፐ ሾደትስ። <verse eid="EZK 21:15"/><verse number="16" style="v" sid="EZK 21:16"/>ነኖ፥ ቃራ ማሻዉ፥ ኡሻችነ ሀድርስ ስምዳ ነ ስምዳ ባጋ ኡባ ቡ። <verse eid="EZK 21:16"/><verse number="17" style="v" sid="EZK 21:17"/>ህዛ ታኒ ታ ኩሽያ ባቃና፤ ታ ሀንቆይ ዶቻና” ያጌስ ጎዳይ። <verse eid="EZK 21:17"/><verse number="18" style="v" sid="EZK 21:18"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 21:18"/><verse number="19" style="v" sid="EZK 21:19"/>“አሳ ናአዉ፥ ባብሎነ ካዋ ማሻይ ያ ናምኡ ኦገታን ማላ ዎ። ናምኡ ኦገት እስ ቢታፈ ደንዶሶና፤ ኦገይ ካታማኮ ስምያ ኦገን ማላታ ቱሱ ኤሳ። <verse eid="EZK 21:19"/><verse number="20" style="v" sid="EZK 21:20"/>እስ ኦግያን ደእያ ማላ ራባ ጌተትያ አሞነ ካታማ ብያ ኦግያ ማሌስ፤ ሀንኮይ ኦገይ ግምበትዳ ይሁዳን ደእያ የሩሳላመ ካታማ ብያ ኦግያ ማሌስ። <verse eid="EZK 21:20"/><verse number="21" style="v" sid="EZK 21:21"/>ባብሎነ ካዎይ ኦገት ጋሄትያ ዳጋላን፥ ማላ ቱሳታ ማታን ኤቄስ። እ አዉ ኦግያራ ባነኮ ኤራናዉ፥ ዶንገ ቶራን ሳማ የጋና፤ ባ ኤቃታ ዞረ ኦይቻና፤ ማራጭያ በአና። <verse eid="EZK 21:21"/><verse number="22" style="v" sid="EZK 21:22"/>ግምብያ ፐንግያ ላልያ ዱሩማ ኤሀና መላ፥ ዎ ኪታ አና መላ፥ ጬቀታና መላ፥ ድርሳ ፐንግያ ላልያ ዱሩማ ካታማ ፐንገን ኤሳና መላ፥ ቢታ ዶራና መላነ ሚፃ ጊግሳና መላ የሩሳላመ ሳም እያዉ ኡሻቻ ኩሸን ከይስ። <verse eid="EZK 21:22"/><verse number="23" style="v" sid="EZK 21:23"/>የሩሳላመ አሳይ ባብሎነ ካዉዋራ ጫቅዳ ግሾ፥ ሄስ ባንታ ቦላ ጋካና ግድ ቆፕቦኮና። ሽን ባብሎነ ካዎይ ኤንታ ድእያ ዎደ ኤንቲ ባንታ ናጋራ ሀሳያና። <verse eid="EZK 21:23"/><verse number="24" style="v" sid="EZK 21:24"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ ህንተ ናጋራይ ቆንጭስ፤ ህንተ ባላ ግደይሳ አሳ ኡባይ ኤሬስ፤ ህንተ ኦሶይ ህንተ ናጋራንቾ ግደይሳ በሴስ። ሄሳ ግሾ፥ ህንተ ኢታ ኦሶይ ሀሳየታና፤ ህንተ፥ ህንተ ሞርከታስ አድ እመታና።<verse eid="EZK 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 21:25"/>“ነኖ፥ ኢታነ ቱና ግድዳ እስራኤለ ሀላቃዉ፥ ነ ፕርዳ ጋላሳይ ጋክስ። <verse eid="EZK 21:25"/><verse number="26" style="v" sid="EZK 21:26"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ ነ ሁጵያፐ ካላቻ ደን፤ ነ ሁጰ ፃ ቃራ። ህዛፐ ጉየ ካሰይሳዳ ሀናናባይ ባዋ፤ ዝቃይ ቁ ጋና፤ ቃይ ዝቅ ጋነ። <verse eid="EZK 21:26"/><verse number="27" style="v" sid="EZK 21:27"/>ጋዶ! ጋዶ! ታኒ ሀ ካታማ ይሳና። ፕርዳናዉ ማት ደኤይስ ያና ጋካናዉ ሀ ካታማይ ዛሪድ ኬፀተና። እ ያ ዎደ ታ እያዉ አዳ እማና” ያጌስ።<verse eid="EZK 21:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 21:28"/>አሳ ናአዉ፥ ሀይሳዳ ያጋዳ ትንብተ ኦዳ። እስራኤለ ጫይያ አሞነታ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ።</para>
  <para style="q1" vid="EZK 21:28">“ይስያ ማሽ ሾሆፐ ሾደትስ፤</para>
  <para style="q2" vid="EZK 21:28">ዎናዉ ዎልአሜስ፤</para>
  <para style="q2" vid="EZK 21:28">ዉርሳናዉ ቁሸቴስ።<verse eid="EZK 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZK 21:29"/>ህንተ በእያ ቆንጨይ ዎርዶ፤</para>
  <para style="q2" vid="EZK 21:29">ህንተ ኦድያ ትንብተይ ዎርዶ።</para>
  <para style="q1" vid="EZK 21:29">ህንተ ኢታነ ቱና አስ፤</para>
  <para style="q2" vid="EZK 21:29">ህንተ ፕርዳ ጋላሳይ ጋክስ</para>
  <para style="q2" vid="EZK 21:29">ህንተ ቆን ማሽ ዎና ሀኔስ።<verse eid="EZK 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="EZK 21:30"/>ማሻ ሾሁዋን ዛርተ፤</para>
  <para style="q2" vid="EZK 21:30">ህንተ መትዳ በሳን፥ ህንተ የለትዳ ቢታን</para>
  <para style="q2" vid="EZK 21:30">ታ ህንተ ቦላ ፕርዳና።<verse eid="EZK 21:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZK 21:31"/>ታኒ ታ ሀንቁዋ ህንተ ቦላ ጉሳና፤</para>
  <para style="q2" vid="EZK 21:31">ታ ሀንቆ ታማይ ህንተ ቦላ ኤፃና፤</para>
  <para style="q2" vid="EZK 21:31">ይሶ ሜዘትዳ፥ ዎዛና ምኖ አሳስ አዳ እማና።<verse eid="EZK 21:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="EZK 21:32"/>ህንተ ታማን ያና፤</para>
  <para style="q2" vid="EZK 21:32">ህንተ ሱይ ህንተ ቢታን ጉካና፤</para>
  <para style="q2" vid="EZK 21:32">ህንተ ዛሪድ ሀሳየተከታ።</para>
  <para style="q2" vid="EZK 21:32">ታኒ ጎዳይ ሀይሳ ኦዳስ” ያግስ።<verse eid="EZK 21:32"/></para>
  <chapter eid="EZK 21"/>
  <chapter number="22" style="c" sid="EZK 22"/>
  <para style="s1">የሩሳላመ ናጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 22:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 22:1"/><verse number="2" style="v" sid="EZK 22:2"/>“አሳ ናአዉ፥ ሸምፖ ዎይሳት ኩምዳ ካታማ ቦላ ፕርዳናዉ ጊጋዲ? ያትኮ፥ እ ኦዳ ቱና ኦሶ ኡባ እያዉ ኦዳ። <verse eid="EZK 22:2"/><verse number="3" style="v" sid="EZK 22:3"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ፦ ነ ዳሮ አሳ ዎዳ ግሾነ ኤቃ ጎይኖን ነና ቱንስዳ ግሾ ነ ዮ ዎደይ ጋክስ። <verse eid="EZK 22:3"/><verse number="4" style="v" sid="EZK 22:4"/>ነ ጉስዳ ሱን ባላ ግዳዳሳ፤ ነ ኦዳ ኤቃን ቱናዳሳ። ነ ፕርዳ ጋላሳይ ማታትስ፤ ነ ዮ ዎደይ ጋክስ። ሄሳ ግሾ፥ ታ ነና ካዎተታስ ሚቻስነ ሀራ ቢታታስ ቀልቅሴስ አጋና። <verse eid="EZK 22:4"/><verse number="5" style="v" sid="EZK 22:5"/>ነኖ፥ ነ ሱንይ ኢትዳ ዳጋም ኩምዳ ካታማዉ፥ ማታንነ ሃሆን ደኤይሳት ነና ቀልቅሳና።<verse eid="EZK 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 22:6"/>“ነ ግዶን ደእያ እስራኤለ ሀላቃት ኡባይ ሱ ጉሳናዉ ባንታ ዎልቃ አይ መላ ጎኤትያኮ በአ። <verse eid="EZK 22:6"/><verse number="7" style="v" sid="EZK 22:7"/>ነ ግዶን ደኤይሳት ባንታ አዋነ ባንታ አይዉ ቦንቾኮና። ኤንቲ በተ አሳ ጭሞሶና፤ አምኤታነ አዉ አይያ ባይና ናይታ ናቆሶና። <verse eid="EZK 22:7"/><verse number="8" style="v" sid="EZK 22:8"/>ኤንቲ ታ ጌሻ ሚሸታ ካኦሶና፤ ታ ሳምባታ ቱንሶሶና። <verse eid="EZK 22:8"/><verse number="9" style="v" sid="EZK 22:9"/>ነ ግዶን እሶት እሶት ሀራታ ዎሳናዉ ዎርዶን ኦዶሶና፤ ሀራት ኤቃስ ያርሸትዳባ ሞሶና፤ ሀራት ላይማቶሶና። <verse eid="EZK 22:9"/><verse number="10" style="v" sid="EZK 22:10"/>ነ ግዶን እሶት እሶት ባ አዋ ማቸራ ቱኖሶና፤ ሀራት ኩሸ መቶይ ደእያ ማጫሳራ ዎልቃን ቱንሶሶና። <verse eid="EZK 22:10"/><verse number="11" style="v" sid="EZK 22:11"/>ነ ግዶን እሶት እሶት ባ ሾሩዋ ማቸራ ቱኖሶና፤ አዋይ ባ ናአ ማቸራ ቱኔስ፤ ባ አዋ ናእዉ፥ ባ ምችዉ ዎልቃን ኢስድ ዬላዬስ። <verse eid="EZK 22:11"/><verse number="12" style="v" sid="EZK 22:12"/>ነ ግዶን እሶት እሶት ሚሸ ኤክድ፥ ሸምፖ ዎኦሶና፤ ሀራት ባንታ ሚሽያ ባንታ ያራ ግድዳ እስራኤለታስ የሎራ ታልኦሶና፤ ኤንታ ቦንቅድ ባንታዉ ዱረቶሶና፤ ታና ኩመ ዶግዶሶና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 22:13"/>“አሳይ በሶና ሚሸ ኤክያ ግሾነ ሸምፖ ዎያ ግሾ፥ ታኒ ታ ኩሽያ ህንተ ቦላ ደንና። <verse eid="EZK 22:13"/><verse number="14" style="v" sid="EZK 22:14"/>ታ ነና ሴርያ ዎደ ነ ጎባተይ ኔራ ዳኔ? ዎይኮ ነ ኩሸይ ምኖ ግዳኔ? ታኒ ጎዳይ ሀይሳ ኦዳስ፤ ታ ኦድዳይሳዳ ኦና። <verse eid="EZK 22:14"/><verse number="15" style="v" sid="EZK 22:15"/>ታ ነና ካዎተታ ግዶንነ ቢታታ ግዶን ላላና፤ ነ ቱናተ ኔፐ ድጋና። <verse eid="EZK 22:15"/><verse number="16" style="v" sid="EZK 22:16"/>ሀራ ካዎተታ ስንን ነ ካዉያና፤ ታኒ ጎዳ ግደይሳ ነ ኤራና” ያግስ።<verse eid="EZK 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 22:17"/>ጎዳይ ታኮ ሀይሳዳ ያግስ፦ <verse eid="EZK 22:17"/><verse number="18" style="v" sid="EZK 22:18"/>“አሳ ናአዉ፥ እስራኤለ አሳይ አይኮካ ፓኮና፤ ኤንቲ ኡባይ ብራ ሼሽያ ዎደ ናሰ ብራታፐ፥ ቆርቆሮፐ፥ ብራታፐነ እርሳሰፐ ከያ ሻአ መላ። <verse eid="EZK 22:18"/><verse number="19" style="v" sid="EZK 22:19"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ ‘ህንተ ኡባይ አታላ መላ ግድዳ ግሾ ታ ህንተና ኡባ የሩሳላመ ሺሻና። <verse eid="EZK 22:19"/><verse number="20" style="v" sid="EZK 22:20"/>ብራ፥ ናሰ ብራታ፥ ብራታ፥ እርሳሰነ ቆርቆሮ ታማን ሁብድ ሼሸይሳዳ ታ ህንተና ሺሻዳ ታ ሀንቁዋና ትልእሳና። <verse eid="EZK 22:20"/><verse number="21" style="v" sid="EZK 22:21"/>ታ ህንተና የሩሳላመ ሺሻዳ፥ ታ ሀንቆ ታማ ህንተ ቦላ ኤዳ ህንተና ያን ትልእሳና። <verse eid="EZK 22:21"/><verse number="22" style="v" sid="EZK 22:22"/>ብር ጮጨን ሼኤይሳዳ ህንተ የሩሳላመን ትልአና። ሄ ዎደ ታኒ ጎዳይ ታ ሀንቁዋ ህንተ ቦላ ጉስዳይሳ ህንተ ኤራና’ ” ያጌስ።<verse eid="EZK 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 22:23"/>ዛሪድ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 22:23"/><verse number="24" style="v" sid="EZK 22:24"/>“አሳ ናአዉ፥ ኤንታ ቢታይ ቱንዳ ግሾ፥ ታ ሀንቁዋን እር ቡኮና መላ ድጋዳ ኤንታ ሴራ ዶምዳሳ እስራኤለ አሳስ ኦዳ። <verse eid="EZK 22:24"/><verse number="25" style="v" sid="EZK 22:25"/>ነ ግዶን ኤንታ ሀላቃት ዎዳባ ጉድሸ መንረያ ጋሞ መላ፤ ኤንቲ ዎኦሶና፤ ሚሸ ግድን፥ ሀራ ቡቁራ ግድን፥ ኡባ ባንታዉ ኤኮሶና፤ ዳሮ ማጫሳታ አምኦ ኦዶሶና። <verse eid="EZK 22:25"/><verse number="26" style="v" sid="EZK 22:26"/>ካህነት ታ ህግያ መንዶሶና፤ ታ ጌሻባታ ቦንችቦኮና። ጌሽነ ጌሽ ግዶና ባ ሻኮኮና፤ ቱናነ ቱና ግዶና ባ ሻክድ ታማርሶኮና፤ ታ ሳምባታ የግ አግደታ። ሄሳ ጋሶን ታ እስራኤለ አሳ ግዶን ቦንቸታብከ። <verse eid="EZK 22:26"/><verse number="27" style="v" sid="EZK 22:27"/>ሀላቃት ባንታ ዎዳባ ዱሰረያ ሱመ መላ፤ ኤንቲ ባንታዉ በሶና ዱረተ ደማናዉ ሸምፖ ዎኦሶና። <verse eid="EZK 22:27"/><verse number="28" style="v" sid="EZK 22:28"/>ናበት ጎዳ ቦቅንተ ትይያ አሳዳ፥ ዎርዶ ቆንጨ በእድ፥ ዎርዶ ትንብተ ኦድድ ኤንታ ናጋራ ገንሶና። ጎዳይ ኦዶና ደእሽን፥ ‘ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ’ ያጎሶና። <verse eid="EZK 22:28"/><verse number="29" style="v" sid="EZK 22:29"/>ቢታን ደእያ አሳይ ቦንቆሶና፤ ማንቆታነ መቶታንቾታ ኡንኤሶና፤ ኤንቲ ሱረ ፕርዳ ድግድ በተ አሳ ጌላዮሶና።<verse eid="EZK 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 22:30"/>“ታኒ ቢታ ይሶና መላ ድርሳ ግምብያ ኬፀይ፥ ላለትዳ ድርሳ ግምብያ ባጋራ ታ ስንን ኤቅድ ናግያ እስ አስ ኮያስ፤ ሽን ኦናካ ደማብከ። <verse eid="EZK 22:30"/><verse number="31" style="v" sid="EZK 22:31"/>ሄሳ ግሾ፥ ታ ሀንቁዋ ኤንታ ቦላ ጉሳና፤ ታኒ ታ ይሉዋን ኤንታ ይሳና፤ ኤንቲ ኦሱዋ ኤንታ ቦላ ዛራና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 22:31"/></para>
  <chapter eid="EZK 22"/>
  <chapter number="23" style="c" sid="EZK 23"/>
  <para style="s1">ናምኡ ላይማ ምቸታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 23:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ፦ <verse eid="EZK 23:1"/><verse number="2" style="v" sid="EZK 23:2"/>“አሳ ናአዉ፥ እስ አየፐ የለትዳ ናምኡ ምቸት ደኦሶና። <verse eid="EZK 23:2"/><verse number="3" style="v" sid="EZK 23:3"/>ኤንቲ ግብፀን ደእሸ፥ ባንታ ናአተፈ ዶምድ፥ ላይማ ግድዶሶና። ሄ ቢታን ደእያ አደት ኤንታ ንን ካእዶሶና፤ ኤንታ ጌላኦተይ ኤከትስ። <verse eid="EZK 23:3"/><verse number="4" style="v" sid="EZK 23:4"/>ኤንታፈ ባይረ ሱንይ ኦሆሎ፤ ካሎ ምቸ ሱንይ ኦሆልባ። ኤንታ ናምአ ታኒ ማችን፥ ታዉ አደነ ማጫ ናአ የልዶሶና። ኦሆላ ሳማረ፤ ኦሆልባ ቃስ የሩሳላመ።”<verse eid="EZK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 23:5"/>“ኦሆላ ታዉ ማቾ ግዳዳ ደአሸ ላይማታሱ፤ እያ ባ ኦላንቾ ግድዳ አሶረ ላገታ ካላዳ ባዉሱ። <verse eid="EZK 23:5"/><verse number="6" style="v" sid="EZK 23:6"/>ኤንቲ ካሎሰ ዳንያ ማኦ ማእዳ ኦላንቾታ፥ ቢታ ሃረይሳታነ ቶራ ሞጮናታ፤ ኤንቲ ኡባይ ናአተነ ማላ ሎኦ ግድዳ ፓራ ቶግያ አሳታ። <verse eid="EZK 23:6"/><verse number="7" style="v" sid="EZK 23:7"/>እያ ባና ላይማ ኦዳ፥ ኡባፈ ሎእያ አሶረ አደታስ ባና አዳ እማሱ። እ ላይማተይ እያ አሶረ ኤቃታ ጎይናዳ ቱናና መላ ኦስ። <verse eid="EZK 23:7"/><verse number="8" style="v" sid="EZK 23:8"/>እያ ግብፀን ዶምዳ ላይማተ ሀእካ አጋቡኩ፤ እ ናአተፈ ዶምድ፥ አደት እ ን ካኦሶናነ ኢራ ላይማቶሶና።”<verse eid="EZK 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 23:9"/>“ሄሳ ግሾ፥ እያ ምንዳ ሲቅያ አሶረ ላገታስ ታኒ እዮ አዳ እማስ። <verse eid="EZK 23:9"/><verse number="10" style="v" sid="EZK 23:10"/>ኤንቲ እዮ ቃርድ ካሎይዶሶና፤ እ አደነ ማጫ ናይታ ድእድ ኦይክዶሶና፤ እዮ ማሻን ዎዶሶና። እዮ ጋክዳ ፕርዳ ጋሶን፥ ማጫሳ ግዶን ቀልቅሰስ አታሱ።”<verse eid="EZK 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 23:11"/>“እ ምችያ ኦሆልባ ሄሳ በአሱ፤ እያ ባ አሙዋንነ ባ ላይማተን ባ ምቸፈ አዳ ቱና ግዳሱ። <verse eid="EZK 23:11"/><verse number="12" style="v" sid="EZK 23:12"/>እያካ አሶረ ሃረይሳት፥ ቶራ ሞጮናታ፥ ሎኦ ማኦ ማእዳ ኦላንቾታነ ፓራ ቶግያ አሳታ፥ ናአተነ ማላ ሎኦ አሳታ ምንዳ ሲቃሱ። <verse eid="EZK 23:12"/><verse number="13" style="v" sid="EZK 23:13"/>እያካ ባና ቱንስዳይሳ በአስ፤ ኤንቲ ናምአይ እስ ኦገን ቦሶና።”<verse eid="EZK 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 23:14"/>“እያ ባ ላይማተ ያ ዳርሳሱ፤ እያ ጎዳ ቦላ ዎጨትድ ኦሰትድ ዞኦ ቃላመን ትየታዳ ካልዳወታ አደ ምስለ በአሱ። <verse eid="EZK 23:14"/><verse number="15" style="v" sid="EZK 23:15"/>ኤንቲ ባንታ ፄሳን ዝናረ ዳንጭዶሶና፤ ባንታ ሁጵያን ሎኦ ጫርቀ ፃፅዶሶና። ኤንቲ ኡባይ ካልዳወ ቢታፈ ይዳ ካልዳወታ ሀላቃታ ዳኖሶና። <verse eid="EZK 23:15"/><verse number="16" style="v" sid="EZK 23:16"/>እያ ኤንታ ምስለታ በእዳ ዎደ ዳሮ ሲቃዳ፥ ኤንታ ፄጋናዉ ካልዳወታ ቢታ አሰ ኪታሱ። <verse eid="EZK 23:16"/><verse number="17" style="v" sid="EZK 23:17"/>ባብሎነት ኢኮ ይድ፥ ኢራ ላይማትድ እዮ ቱንስዶሶና። ኤንቲ እዮ ዳሮ ቱንስዳፐ ጉየ፥ እያ ኤንታ ሻተታሱ። <verse eid="EZK 23:17"/><verse number="18" style="v" sid="EZK 23:18"/>እያ ባ ላይማተ ቆንጨን ኦዳ ዎደነ ባ ካሉዋ ቃራ በስዳ ዎደ፥ ታኒ እ ምችዉ አግዳይሳዳ እዮካ ሻተታዳ አጋስ። <verse eid="EZK 23:18"/><verse number="19" style="v" sid="EZK 23:19"/>ሽን እያ ግብፀን ላይማ ግዳዳ ደእያ፥ ባ ያላጋተ ዎድያ ሀሳያዳ፥ ባ ላይማተ ካሰይሳፈ ያ ዳርሳሱ። <verse eid="EZK 23:19"/><verse number="20" style="v" sid="EZK 23:20"/>ኤንታ አቱንይ ሀረይሳ መላ፥ ኤንታ ኮቻይ ፓራይሳ መላ ግድዳ ባ ላገታ ካላዳ ባሱ። <verse eid="EZK 23:20"/><verse number="21" style="v" sid="EZK 23:21"/>ነኖ፥ ኦሆልበ፥ ነ ያላጋተ ዎድያን ግብፀ አደት ነ ንን ካእሽን፥ ነ ጌላኦተ ኤክሽን፥ ኔኒ ፖልዳ ላይማተ ዛራዳ ሀእ ኦናዉ አሞታሳ።”<verse eid="EZK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 23:22"/>ሄሳ ግሾ፥ ኦሆልበ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታኒ ነ ላገታ፥ ነ ሻተታ አግዳይሳታ ነ ቦላ ደንና፤ ታ ኤንታ ነ ቦላ ኡባ በሳራ ኤሀና። <verse eid="EZK 23:22"/><verse number="23" style="v" sid="EZK 23:23"/>ባብሎነታነ ካልዳወታ ኡባ፥ ፋቁዳ፥ ሶሃነ ቆኣና፥ አሶረታ ኡባ፥ ናአተነ ማላ ሎኦ አሳታ፥ ቢታ ሃረይሳታ፥ ቶራ ሞጮናታ፥ ኦላንቾታ፥ ሀላቃታነ ፓራ ቶግያ አሳታ ነ ቦላ ኤሀና። <verse eid="EZK 23:23"/><verse number="24" style="v" sid="EZK 23:24"/>ኤንቲ ኦላ ፓራ ጋረታራ፥ ጫና ጋረታራነ ዳሮ ኦላንቾታራ ፑደሀ ባጋፈ ህንተ ቦላ ያና። ኤንቲ ዎጋ ጎንዳለነ ጉ ጎንዳለ ኦይክድ፥ ብራታ ባርኔፃ ዎድ፥ ነ ዩሹዋን ሳልፓና። ታኒ ነና ኤንታዉ አዳ እማና፤ ኤንቲ ነና ባንታ ዎጋ መላ ፕርዳና። <verse eid="EZK 23:24"/><verse number="25" style="v" sid="EZK 23:25"/>ታኒ ታ ሀንቁዋ ነ ቦላ የዳና፤ ኤንቲ ኔራ ሀንቆ ሱላን ጋሄታና። ኤንቲ ነ ሲያነ ነ ሀይ ቃንፃና፤ አትዳይሳት ማሻን ዉራና። ኤንቲ ነ አደ ናይታነ ነ ማጫ ናይታ ኦይካና፤ አትዳይሳታ ታማን ፁጋና። <verse eid="EZK 23:25"/><verse number="26" style="v" sid="EZK 23:26"/>ኤንቲ ነ ማኦ ኡባ ኔፐ ቃርድ ኤካና፤ ነ አሌቆ ኡባ ኔፐ ከስድ ኤካና። <verse eid="EZK 23:26"/><verse number="27" style="v" sid="EZK 23:27"/>ሄሳዳ ኦዳ፥ ነ ግብፀፈ ኤህዳ ላይማተ አሙዋ ኔፐ ድጋና። ኔኒ ናምአን ግብፀታ ኤቃ ምስለታ ቁ ጋዳ ፄሎናዳ ዎይኮ ኤንታ ሀሳዮናዳ ኦና።”<verse eid="EZK 23:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 23:28"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታኒ ነና ነ እፀይሳታ፥ ነ ሻተታዳ አግዳይሳታስ አዳ እማና። <verse eid="EZK 23:28"/><verse number="29" style="v" sid="EZK 23:29"/>ኤንቲ ነና እፃና፤ ነ ዳቡራዳ ደምዳባ ኡባ ቦንቅድ፥ ነና ፅረ ካሎ አሻና። ነ ላይማተ አሞይ ቆንጫናዳ ኦና። ነ ላይማተ አሞይ፥ <verse eid="EZK 23:29"/><verse number="30" style="v" sid="EZK 23:30"/>ሄሳ ነ ቦላ ኤህስ። ኔኒ ካዎተታራ ላይማታዳሳ፤ ኤንታ ኤቃታራ ነና ቱንሳዳሳ። <verse eid="EZK 23:30"/><verse number="31" style="v" sid="EZK 23:31"/>ነ ምችያ ብዳ ኦግያ ነካ ባዳሳ። ሄሳ ግሾ፥ ነና እ ፁኣ ኡሻና።”<verse eid="EZK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 23:32"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ኔኒ ነ ምቸ ፁአፐ ኡያና፤ ሄ ፁአይ ግታነ ጪሞ። እ ትግን፥ ዳሮ ኤክያ ግሾ፥ አስ ኡባይ ነ ቦላ ሚጫናነ ነና ቅና። <verse eid="EZK 23:32"/><verse number="33" style="v" sid="EZK 23:33"/>ኔኒ ማታ ጋንድጋራናነ አዛናና። ሄስ ነ ምቸ ሳማረ ፁአይ ነዉ ዳጋማነ ዮ ኤሀና። <verse eid="EZK 23:33"/><verse number="34" style="v" sid="EZK 23:34"/>ነ እያ ፂዞዳ ኡያና፤ ፁአ መንና፤ ኩንአን ነ ን ጋራና።” ታኒ ኡባ ሃርያ ጎዳይ ሀይሳ ኦዳይስ።<verse eid="EZK 23:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 23:35"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ኔኒ ታና ዶግዳ ግሾ፥ ታዉ ዞኮ ዛርዳ ግሾነ ነ ላይማተ አሙዋስ ጋተ ኤካና።”<verse eid="EZK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 23:36"/>ጎዳይ ታኮ ሀይሳዳ ያግስ፦ “አሳ ናአዉ፥ ኦሆል ቦላነ ኦሆልብ ቦላ ፕርዳናዉ ጊገታዲ? ኤንቲ ኦዳ ቱና ኦሱዋ ኤንታዉ ኦዳ። <verse eid="EZK 23:36"/><verse number="37" style="v" sid="EZK 23:37"/>ኤንቲ ናምአይ ላይማትዶሶና፤ ሸምፖ ዎዶሶና። ኤንቲ ባንታ ኤቃ ጎይንዶሶና። ሀር አቶሽን፥ ኤንቲ ታዉ የልዳ ባንታ አደ ናይታ ባንታ ኤቃታስ ካ ኦድ ያርሽዶሶና። <verse eid="EZK 23:37"/><verse number="38" style="v" sid="EZK 23:38"/>ሄሳፈ አድ ሀራ ኢታባ ታ ቦላ ኦዶሶና፤ ኤንቲ ታ ኬ ቱንስዶሶና፤ ሄ ዎደ ታ ሳምባታካ ሻርዶሶና። <verse eid="EZK 23:38"/><verse number="39" style="v" sid="EZK 23:39"/>ኤንቲ ባንታ ናይታ ኤቃታስ ያርሽዳ ጋላስ፥ ኤንቲ ታ ኬ ገልድ ቱንስዶሶና፤ ኤንቲ ታ ኬን ኦዳይ ሀይሳ።” <verse eid="EZK 23:39"/><verse number="40" style="v" sid="EZK 23:40"/>ኤንቲ ሃሆ በሳፈ አደት ያና መላ አሰ ኪትን፥ ኤንቲ ይዶሶና። ህንተ ናምኡ ምቸት ህንተ ቦላ ሜጨትደታ፤ ህንተ አይፍያ ትየትደታ፤ አሌቆ አደታ። <verse eid="EZK 23:40"/><verse number="41" style="v" sid="EZK 23:41"/>ሎኦ አርጄታ ቦላ ኡትደታ፤ ፃርጴዛ ቦላ ታ እፃንያነ ታ ሻማሆ ዛይትያ ዎደታ። <verse eid="EZK 23:41"/><verse number="42" style="v" sid="EZK 23:42"/>ኡፋይትያ አሳ ኮይሰ ህንተ ማታን ስኤቴስ። ማትዳ አሳይ መላ ቢታ ይዶሶና። ህንተ ኩሸን ሳጋዮ ዎዶሶና፤ ሎኦ ካላቻታ ህንተ ሁጰን ጎፅዶሶና። <verse eid="EZK 23:42"/><verse number="43" style="v" sid="EZK 23:43"/>ታኒ ታ ዎዛናን፥ “ሀ አደት አሳተይ ላይማተን ግልቅዳ ማጫሴራ ላይማቶሶና” ያጋስ። <verse eid="EZK 23:43"/><verse number="44" style="v" sid="EZK 23:44"/>አደይ ማጫሳራ ላይማተይሳዳ፥ ሀይሳቲ ኤንታራ ላይማትዶሶና። ኤንቲ ላይማታናዉ አሞትያ ኦሆልራነ ኦሆልብራ ላይማትዶሶና። <verse eid="EZK 23:44"/><verse number="45" style="v" sid="EZK 23:45"/>ኤንቲ ላይማ ግድያ ግሾነ ሸምፖ ዎያ ግሾ፥ ፅሎ አሳት ላይማትያነ ሸምፖ ዎያ ኤንታ ቦላ ፕርዳና።<verse eid="EZK 23:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="EZK 23:46"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ዳሮ አሳ ደንዳ ኤንታ ቦላ ኤሀ። ኤንታ ዳጋንያነ ኤንታ ቦንቅያ አሳታስ አ እማ። <verse eid="EZK 23:46"/><verse number="47" style="v" sid="EZK 23:47"/>ሀ ዳጋንያ አሳት ይድ፥ ኤንታ ሹቻን ጫዶ፤ ማሻን ቡ፤ ኤንታ አደነ ማጫ ናይታ ዎ፤ ኤንታ ኬ ታማን ፁጎ። <verse eid="EZK 23:47"/><verse number="48" style="v" sid="EZK 23:48"/>ማጫስ ኡባይ ናገታና መላ ታኒ ቢታ ኡባፈ ላይማተ ይሳና። <verse eid="EZK 23:48"/><verse number="49" style="v" sid="EZK 23:49"/>ህንተ ናምኡ ምቸት ህንተ ላይማተ ግሾነ ኤቃታ ህንተ ጎይንዳ ናጋራ ግሾ ህንተና ፕርዳና። ታኒ ኡባ ሃርያ ጎዳ ግደይሳ ህንተ ሄ ዎደ ኤራና” ያጌስ።<verse eid="EZK 23:49"/></para>
  <chapter eid="EZK 23"/>
  <chapter number="24" style="c" sid="EZK 24"/>
  <para style="s1">ድስተ ሌምሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 24:1"/>ኑኒ ድኤትዳ ኡዱፉን ላይን፥ ታማን አጌናን፥ ታማን ጋላስ፥ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 24:1"/><verse number="2" style="v" sid="EZK 24:2"/>“አሳ ናአዉ፥ ሀች ጋላስ ማዝጋበን ፃፋ። ባብሎነ ካዎይ የሩሳላመ ተቅዳይ ሀች። <verse eid="EZK 24:2"/><verse number="3" style="v" sid="EZK 24:3"/>ሀ ማካላንቾ አሳስ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ሀ ሌምሱዋ ኦዳ። ማዳበ ድስተ ታማ ቦላ ዎዳ ሃ እያን ትጋ። <verse eid="EZK 24:3"/><verse number="4" style="v" sid="EZK 24:4"/>ገዳነ አንጋሱዋ፥ ሎኦ አሾ ኡባ ሙፃዳ፥ እያን የጋ፤ ሎኦ መቀ ቃንፀረዳ እያን ኩን። <verse eid="EZK 24:4"/><verse number="5" style="v" sid="EZK 24:5"/>ሄሳስ ነ ኤካና ዶርሳይ ዉድያፐ ዶረትዳይሳ ግዶ። ድስትያ ጋርሳን ም ዎዳ አሹዋነ መቀ ካፃና ጋካናዉ ዶይሳ።”<verse eid="EZK 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 24:6"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ሱ ጉስያ ካታማ አየ! እያ ሽእድ ጌዮና እፅዳ ናሰ ብራታ ድስተ መላ ግዳሱ። እ ግዶን ደእያ ሙፀትዳ አሹዋ ሳማ የጎና ኩሸን ጋሄትዳይሳ ከሳ ከሳ ኤካ። <verse eid="EZK 24:6"/><verse number="7" style="v" sid="EZK 24:7"/>ሄ ካታማይ ዎዳ አሳ ሱይ ሀኖ ጋካናዉ እን ደኤስ። ሱ ጉሳሸ፥ አይብካ ካሞና ዳንዳኦና ዛላ ቦላ ጉሳሱፐ አትሽን፥ ባናን ካማና ቢታ ቦላ ጉሳቡኩ። <verse eid="EZK 24:7"/><verse number="8" style="v" sid="EZK 24:8"/>ሀሎ ከያናዉ፥ ታ ሀንቁዋ ደንናዳ፥ ካመቶና መላ እያ ጉስዳ ሱ ታኒ ዛላ ቦላ ዎስ።”<verse eid="EZK 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 24:9"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ሱ ጉስያ ካታማ አየ! ታኒ ም ጉጃዳ ዎና። <verse eid="EZK 24:9"/><verse number="10" style="v" sid="EZK 24:10"/>ዳሮ ም ዎ፤ ታማ ኤ። አሹዋ ሎይዳ ዶይሳ፤ ጫምባ ማልኤ፤ መቀ ፁጋ። <verse eid="EZK 24:10"/><verse number="11" style="v" sid="EZK 24:11"/>ካይሳ ማዳበ ድስተ ታማ ቦላ ዎ። እያ ቦላ ደእያ ቡቃይ ሴርድ ክቻና ጋካናዉነ እያ ቦላ ደእያ ሽአይ ፁገትድ ያና ጋካናዉ ሱልድ ምቻና መላ ታማ ቦላ ዎ። <verse eid="EZK 24:11"/><verse number="12" style="v" sid="EZK 24:12"/>ሄ ዳቡራይ ኡባይ ጮ መላ ግድስ፤ እያ ቦላ ደእያ ዳሮ ሽአይ ሀር አቶሽን፥ ታማን ክችቤና። <verse eid="EZK 24:12"/><verse number="13" style="v" sid="EZK 24:13"/>የሩሳላመ፥ ነነ ቱንዳይ ነ ኢታ ኦሱዋና። ታ ሀንቆይ ነ ቦላ ዉራና ጋካናዉ ህዛፐ ኔኒ ጌያካ። ነ ቱናተፈ ነና ጌሻናዉ ኮያስ ሽን፥ ነ ጌያናዉ ኮያባካ። <verse eid="EZK 24:13"/><verse number="14" style="v" sid="EZK 24:14"/>ታኒ ጎዳይ ሀይሳ ኦዳስ፤ ሄስ ሀናና። ታኒ ጉየ ስምከ፤ ነዉ ቃትከ፤ ታ ቆፋ ላምከ። ነ ኦግያዳነ ነ ኦሱዋዳ ታኒ ነና ፕርዳና። ታኒ ኡባ ሃርያ ጎዳይ ሀይሳ ኦዳይስ” ያግስ።<verse eid="EZK 24:14"/></para>
  <para style="s1">ህዝቄላ ማቸ ሀይቁዋ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 24:15"/>ቃስካ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 24:15"/><verse number="16" style="v" sid="EZK 24:16"/>“አሳ ናአዉ፥ ነ ሲቅያነ ነ አይፈ ስንን ሎእያ ነ ማችዉ አኬኮና ዎና። ሄሳን ካዮቶፋ፥ ዬኮፋነ አፉፆፋ። <verse eid="EZK 24:16"/><verse number="17" style="v" sid="EZK 24:17"/>ኦላ፥ ሽን ነ ኦልያ አስ ስኦፖ፤ ሀይቅዳርስ ካዮቶፋ። ኔኒ ነ ሁጰን ቃጨ ፃፃ፤ ነ ቶሁዋን ጫማ አ። ነ ዶና ካሞፋ፤ ሾች ሞፓ።”<verse eid="EZK 24:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 24:18"/>ዎንታ ታኒ አሳስ ኦዳስ፤ ኦማርስ ታ ማችያ ሀይቃሱ። ዎንተ ጋላስ ጎዳይ ታና ኪትዳይሳዳ ኦስ። <verse eid="EZK 24:18"/><verse number="19" style="v" sid="EZK 24:19"/>አሳይ ታኮ፥ “ሀ ኔኒ ኦያባስ ብርሸይ አይበኮ ኑስ አይስ ኦድኪ?” ያግስ።<verse eid="EZK 24:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 24:20"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ ያጋዳ ኤንታዉ ኦዳስ። <verse eid="EZK 24:20"/><verse number="21" style="v" sid="EZK 24:21"/>ኡባ ሃርያ ጎዳይ እስራኤለ አሳ ሀይሳዳ ያጌስ፤ “ህንተ ጬቀትያ፥ ህንተ አይፈ አሙዋነ ህንተ ሸምፖይ አሞትያ ታ ኬ ታኒ ቱንሳና ሀናይስ። ህንተ ጉየ አሽዳ ህንተ አደ ናይትነ ህንተ ማጫ ናይት ማሻን ዉራና። <verse eid="EZK 24:21"/><verse number="22" style="v" sid="EZK 24:22"/>ሄ ዎደ ታ ኦዳይሳዳ ህንተ ኦና። ህንተ ዶና ካመከታ፤ ሾቹ ሜከታ። <verse eid="EZK 24:22"/><verse number="23" style="v" sid="EZK 24:23"/>ህንተ ሁጵያ ፃፅተ፤ ህንተ ቶሁዋን ጫማ አተ። ካዮተከታ ዎይኮ ዬከከታ። ሽን ህንተ ህንተ ናጋራ ጋሶን ግልቃናነ እሶይ እሱዋራ ኦላና። <verse eid="EZK 24:23"/><verse number="24" style="v" sid="EZK 24:24"/>ሄ ዎደ ህዝቄል ህንተዉ ማላታ ግዳና፤ እ ኦዳይሳዳ፥ ህንተ ኦና። ሄስ ሀንያ ዎደ፥ ታኒ ኡባ ሃርያ ጎዳ ግደይሳ ህንተ ኤራና።<verse eid="EZK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 24:25"/>“አሳ ናአዉ፥ ታኒ ኤንታ ኡፋይሳነ ቦንቹዋ፥ ኤንታ አይፈን ሎእያባነ ኤንታ ዎዛናይ አሞትያባ ምኖ በሳ፥ ቃስ ኤንታ አደ ናይታነ ኤንታ ማጫ ናይታ ኤንታፈ ኤካና። <verse eid="EZK 24:25"/><verse number="26" style="v" sid="EZK 24:26"/>ሄ ጋላስ ነዉ ዎረ ኦዳናዉ እስ አስ ከስ ኤክድ ያና። <verse eid="EZK 24:26"/><verse number="27" style="v" sid="EZK 24:27"/>ሄ ጋላስ ነ ዶናይ ዶየታና፤ ነ እያራ ኦደታና፤ ዛራዳ ሙመ ግዳካ። ሄሳዳ ሀናዳ፥ ነ አሳስ ማላታ ግዳና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና” ያግስ።<verse eid="EZK 24:27"/></para>
  <chapter eid="EZK 24"/>
  <chapter number="25" style="c" sid="EZK 25"/>
  <para style="s1">አሞነ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 25:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 25:1"/><verse number="2" style="v" sid="EZK 25:2"/>“አሳ ናአዉ፥ ነ ሶምኡዋ አሞነኮ ዛራዳ፥ ኤንታ ቦላ ትንብተ ኦዳ። <verse eid="EZK 25:2"/><verse number="3" style="v" sid="EZK 25:3"/>ኡባ ሃርያ ጎዳይ ኦድያ ቃላ ስእተ። ህንተ ታ ኬ ቱንስያ ዎደ፥ እስራኤለ ቢታይ ባይሳ አትያ ዎደነ ይሁዳ አሳይ ድኤትያ ዎደ ሀሹ ግደታ። <verse eid="EZK 25:3"/><verse number="4" style="v" sid="EZK 25:4"/>ታኒ ህንተና ዶሎሀ ባጋ ቢታ አሳስ ላታ ኦዳ እማና። ኤንቲ ህንተ ግዶን ካምበ ኬፅድ ዳና። ህንተ ም አይፍያ ኤንቲ ማና፤ ህንተ ማ ኤንቲ ኡያና። <verse eid="EZK 25:4"/><verse number="5" style="v" sid="EZK 25:5"/>ታኒ ራባ ካታማ ግማለት ሄመትያ በሲ ከሳና፤ አሞነታ ቢታ ዶርሳ ዉደይ ፔእያ በሲ ኦና። ታኒ ጎዳ ግደይሳ ህንተ ሄ ዎደ ኤራና። <verse eid="EZK 25:5"/><verse number="6" style="v" sid="EZK 25:6"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ ‘ህንተ እስራኤለ ዩዋን ኩሸ ባቅዳ ግሾ፥ ጉፕዳ ግሾነ ኡፋይትድ ቀልቅስዳ ግሾ፥ <verse eid="EZK 25:6"/><verse number="7" style="v" sid="EZK 25:7"/>ታኒ ህንተ ቦላ ታ ኩሽያ ደንስ። ህንተና ካዎተታስ ድኦ ኦዳ እማና። ታ ህንተና አሳፐ ሾዳና፤ ካዎተታ ግዶፈ ይሳና። ታኒ ጎዳ ግደይሳ ህንተ ሄ ዎደን ኤራና’ ” ያጌስ።<verse eid="EZK 25:7"/></para>
  <para style="s1">ሞአበ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 25:8"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ሞአበይነ ሳይረ፥ ‘ይሁድ ሀራ ካዎተታ ኡባ መላ’ ያግዳ ግሾ፥ <verse eid="EZK 25:8"/><verse number="9" style="v" sid="EZK 25:9"/>ታኒ ሞአበ ቢታ ተቃና፤ እያ ዛዋ ናግያ፥ ኤረትዳ ቤት-ያሽሞታ፥ ባኣል-ማኦናነ ቅራታይማ ካታማታ ይሳና። <verse eid="EZK 25:9"/><verse number="10" style="v" sid="EZK 25:10"/>ህዛፐ ጉየ አሞነታ ጉጃዳ፥ ኤንቲ ካዎተታ ግዶን ሀሳየቶና መላ ኤንታ ዶሎሀ ባጋ ቢታፈ ይዳ አሳስ አዳ እማና። <verse eid="EZK 25:10"/><verse number="11" style="v" sid="EZK 25:11"/>ታኒ ሞአበ ፕርዳና፤ ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና” ያጌስ።<verse eid="EZK 25:11"/></para>
  <para style="s1">ኤዶመ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 25:12"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ “ኤዶመይ ይሁዳ ቦላ ሀሎ ከይዳ ግሾነ ቆህዳ ግሾ፥ <verse eid="EZK 25:12"/><verse number="13" style="v" sid="EZK 25:13"/>ታኒ ኩሽያ ኤዶመ ቦላ ደንና። ያን ደእያ አሳነ መህያ ኩመ ይሳዳ ባይሳ ከሳና። ተማናፐ ብድ፥ ደዳና ካታማ ጋካናዉ ኤንቲ ማሻን ዉራና። <verse eid="EZK 25:13"/><verse number="14" style="v" sid="EZK 25:14"/>ታኒ እስራኤለ ባጋራ ኤዶመ ቦላ ሀሎ ከያና። እስራኤለት ኤንታ ቦላ ታ ይሉዋ መላ ኦና። ታኒ ሀሎ ከይዳይሳ ኤዶመይ ኤራና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 25:14"/></para>
  <para style="s1">ፍልስፄመ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 25:15"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ፍልስፄመት ባንታ ዎዛና ኢታተን ሀሎ ከይዳ ግሾነ አቅዳ ሞርከን ይሁዳ ካድ ይሳናዉ ኮይዳ ግሾ፥ <verse eid="EZK 25:15"/><verse number="16" style="v" sid="EZK 25:16"/>ታኒ ታ ኩሽያ ፍልስፄመታ ቦላ ደንና። ታኒ ከልታወታ ቃንፃና፤ አባ ዶናን አትዳይሳታ ኡባ ይሳና። <verse eid="EZK 25:16"/><verse number="17" style="v" sid="EZK 25:17"/>ታ ኤንታ ቦላ ግታ ሀሎ ከያና፤ ታ ሀንቁዋን ኤንታ ሴራና። ታኒ ኤንታ ቦላ ሀሎ ከይያ ዎደ፥ ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና” ያጌስ።<verse eid="EZK 25:17"/></para>
  <chapter eid="EZK 25"/>
  <chapter number="26" style="c" sid="EZK 26"/>
  <para style="s1">ፅሮሳ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 26:1"/>ኑኒ ድኤትዳ ታማነ እሳን ላይን፥ አጌና ኮይሮ ጋላሳን፥ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 26:1"/><verse number="2" style="v" sid="EZK 26:2"/>“አሳ ናአዉ፥ ፅሮሳ አሳይ ኡፋይትሸ፥ ‘ሀሹ! የሩሳላመይ ኩንድስ፤ እያ ፐንገይ ዋግ ግድ ዶየትስ። እ ላለትድ ዶየትዳ ግሾ ህዛፐ ጉየ ኑ ዱረታና’ ያጎሶና። <verse eid="EZK 26:2"/><verse number="3" style="v" sid="EZK 26:3"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ ‘ነኖ፥ ፅሮሳ፥ ታኒ ነዉ ሞርከ። አባ ዙለይ ደንደይሳዳ ታኒ ዳሮ ካዎተታ ነ ቦላ ኤሀና። <verse eid="EZK 26:3"/><verse number="4" style="v" sid="EZK 26:4"/>ኤንቲ ነ ድርሳ ግምብያ ላላና፤ ነ ግምበ ሻኮታ መንና። ታ ነና ቢታ ኡባ ቁችድ ኤፍን፥ ካሎ ደእያ ዛላ ኦና። <verse eid="EZK 26:4"/><verse number="5" style="v" sid="EZK 26:5"/>ኔኒ አባ ግዶን አሳይ ባንታ ሞሎ ግትያ መልሳናዉ ምጭያ በሲ ግዳና። ሀራ ካዎተት ፅሮሳ ቦንቃና። <verse eid="EZK 26:5"/><verse number="6" style="v" sid="EZK 26:6"/>ዋና ቢታን ደእያ ጉታታ ማሻን ዉርሳና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና’ ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 26:7"/>“ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ ‘ፅሮሳ ቦላ ኦላ ደንና መላ ካዎታ ካዎ ግድዳ ባብሎነ ካዋ ናቡካዳናፆራ፥ ፓራታራ፥ ፓራ ጋረታራነ ዳሮ ኦላንቾታራ ፑደሀ ባጋፈ ኤሀና። <verse eid="EZK 26:7"/><verse number="8" style="v" sid="EZK 26:8"/>ኤንቲ ዋና ቢታን ደእያ ጉታታ ማሻን ዉርሳና። ኤንቲ ነና ተቅድ፥ ነ ድርሳ ግምብያ ጋድ፥ ቢታ ዶራና፤ ባንታ ጎንዳልያ ነ ቦላ ደንና። <verse eid="EZK 26:8"/><verse number="9" style="v" sid="EZK 26:9"/>ድርሳ ግምበታ ዶምእድ ላልያ ሚሸን ነ ድርሳ ግምብያ መንረና፤ ባንታ ኦላ ሚሸን ነ አዱሳ ግምበታ ላላና። <verse eid="EZK 26:9"/><verse number="10" style="v" sid="EZK 26:10"/>እያ ፓራት ዳሮ ግድያ ግሾ፥ ኤንቲ ደንያ ባናይ ነና ካማና። ፓራትነ ፓራታ ጋረት ላለትዳ ካታማ ድርሳ ፐንግያራ ገልያ ዎደ ኤንቲ ስስያ ጋርማሞይ ነ ድርሳ ግምብያ ቃና። <verse eid="EZK 26:10"/><verse number="11" style="v" sid="EZK 26:11"/>ኤንታ ፓራት ኦገታ ኡባ የና። ነ አሳ ማሻን ዉርሳና፤ ነ ዎልቃማ ቱሳት ሳአን ኩንዳና። <verse eid="EZK 26:11"/><verse number="12" style="v" sid="EZK 26:12"/>ነ ሻሎይ ድኤታና፤ ነ ዛልእያ ሚሸት ቦንቀታና። ነ ድርሳ ግምበታነ ነ ሎኦ ኬታ ኡባ ይሳና፤ ነ ሹቻታ፥ ነ ሳንቃነ ላለትዳ ኡባ ኤፍድ አባን የጋና። <verse eid="EZK 26:12"/><verse number="13" style="v" sid="EZK 26:13"/>ነ ማልኦ የ ታ ተቃና፤ ነ ዲ ግርሳይ ዛር ስኤተና። <verse eid="EZK 26:13"/><verse number="14" style="v" sid="EZK 26:14"/>ታ ነና ካሎ ደእያ ዛላ ኦና፤ ኔኒ አሳይ ባንታ ሞሎ ግትያ ምጭያ በሲ ግዳና። ታኒ ጎዳይ ሀይሳ ኦድዳ ግሾ፥ ኔኒ ዛራዳ ኬፀታካ’ ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 26:15"/>“ኡባ ሃርያ ጎዳይ ፅሮሳ ካታማኮ ሀይሳዳ ያጌስ፦ ‘ነ ሞርከት ነ ቦላ ደንድያ ዎደ ዩሾይ አባን ተቀትዳ ቢታን ደእያ አሳይ፥ ነ ጎይረትያ ዎደ ዋስያ ዋሱዋ ስእድ፥ ያሻን ኮኮራና። <verse eid="EZK 26:15"/><verse number="16" style="v" sid="EZK 26:16"/>አባ ዶናን ደእያ ሃረይሳት ባንታ አራታፐ ዎና። ባንታ ቦንቾ ማኡዋነ አሌቀትድ ኦሰትዳ ማኡዋ ቃርድ ያሻን ኮኮርሸ ቢታን ኡታና። ነ ቦላ ጋክዳ መቱዋ ቆፕድ፥ ኤንቲ ዳሮ ዳጋማና፤ ኤንቲ ኡባ ዎደ ኮኮርሸ ዳና።’ <verse eid="EZK 26:16"/><verse number="17" style="v" sid="EZK 26:17"/>ኤንቲ ነዉ ሀይሳዳ ያግድ ዘለልስ ከሳና፦</para>
  <para style="q1" vid="EZK 26:17">“አባ ዶናን ደእያ ያሽያ ካታማታ፤</para>
  <para style="q2" vid="EZK 26:17">ዎልቃማ አሳይ ደእያ ካታመ፥</para>
  <para style="q2" vid="EZK 26:17">ኔኒ ዋና ላለታዲ?</para>
  <para style="q1" vid="EZK 26:17">ኔንነ ነ ግዶን ደእዳ አሳይ</para>
  <para style="q2" vid="EZK 26:17">አባ ዶናን ደእያ አሳ ኡባ ያሽሳዳሳሽን።<verse eid="EZK 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 26:18"/>ኔኒ ኩንድያ ጋላስ</para>
  <para style="q2" vid="EZK 26:18">ዩሾይ አባን ተቀትዳ ቢታት ኮኮርዶሶና።</para>
  <para style="q1" vid="EZK 26:18">ሃን ተቀትዳ ቢታት</para>
  <para style="q2" vid="EZK 26:18">ነ ዩዋን ዳጋምዶሶና” ያግስ።<verse eid="EZK 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 26:19"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ሀእ ኦንካ ዶና ካታማታዳ ታ ነና ባይሳ ከሳና። ታኒ አባ ሃ ነ ቦላ ኤህን፥ ዳሮ ሃይ ነና ካማና። <verse eid="EZK 26:19"/><verse number="20" style="v" sid="EZK 26:20"/>ኔኒ ስኦለ ገላዳ በን ሀይቅዳ አሳራ ዋላከታና መላ ኦና። ኔኒ ቢታፈ ጋርሳን፥ በን ሞገትድ፥ መርናዉ ላለትድ አትዳይሳታራ ዳና መላ ኦና። ኔኒ ዛራዳ አስ ደእያ ካታማ ግዳካ፤ ደኦን ደኤይሳታ ቢታን ዛራዳ በሰ ደማካ። <verse eid="EZK 26:20"/><verse number="21" style="v" sid="EZK 26:21"/>ታኒ ነ ዉርሰ ዳጋንያ ዉርሰ ኦና፤ ነዉ ሄስ ዉርሰ ግዳና። አስ ነና ኮያና፤ ሽን ኔኒ ዛራዳ በንታካ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 26:21"/></para>
  <chapter eid="EZK 26"/>
  <chapter number="27" style="c" sid="EZK 27"/>
  <para style="s1">ፅሮሳስ ከስዳ ዘለልስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 27:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 27:1"/><verse number="2" style="v" sid="EZK 27:2"/>“አሳ ናአዉ፥ ፅሮሳስ ዘለልስ ከሳ። <verse eid="EZK 27:2"/><verse number="3" style="v" sid="EZK 27:3"/>ዩሾይ አባን ተቀትዳ ቢታን ደእያነ አባ ጋፃን ደእያ ዳሮ አሳራ ዛልእያ፥ ካታማስ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ።</para>
  <para style="q1" vid="EZK 27:3">“ ‘ነኖ ፅሮሳ፥ ታኒ ፑላነ</para>
  <para style="q2" vid="EZK 27:3">ቦረይ ባይና ማላ ሎኦ’ ” ያጋዳሳ።<verse eid="EZK 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 27:4"/>ነ ዛዋይ አባ ጉልኣና፤</para>
  <para style="q2" vid="EZK 27:4">ነና ኬፀይሳት ሎይድ ኦድ ኬፅዶሶና።<verse eid="EZK 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 27:5"/>ነ ሳንቃ ሳንራ ፂዳን ኦዶሶና፤</para>
  <para style="q2" vid="EZK 27:5">ነ ማርካብያ ቱሳ ልባኖሰ ዝጋን ጊግስዶሶና።<verse eid="EZK 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 27:6"/>ሃ ፕያ ምት</para>
  <para style="q2" vid="EZK 27:6">ባሳነ ዎላፐ ኦሰትዶሶና።</para>
  <para style="q1" vid="EZK 27:6">ነ ማርካብያ ሂፃይ ቆጵሮሳ ፂዳን፥</para>
  <para style="q2" vid="EZK 27:6">እያ ዩሾይ ዳንጋርሳ ዛለን አሌቀትስ።<verse eid="EZK 27:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 27:7"/>ነ ሻራይ ባንድራዳ ሃሆን በንታና መላ፥</para>
  <para style="q2" vid="EZK 27:7">ግብፀታ ሊኖፐ አሌቀትድ ኦሰትስ።</para>
  <para style="q1" vid="EZK 27:7">ነ ካማ ገሸይ ቆጵሮሳፐ ይዳ፥</para>
  <para style="q2" vid="EZK 27:7">ካሎሰ ኦቻ ቴራ ዳንያ ማኦፐ ኦሰትዳይሳታ።<verse eid="EZK 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 27:8"/>ነ ማርካብያ ኮልፅሰይሳት ስዶናነ አርዋዳ ካታማታፐ ይዳይሳታ፤</para>
  <para style="q2" vid="EZK 27:8">ነ ማርካብያ ላገይሳት ሎህዳ ነ አሳታ።<verse eid="EZK 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 27:9"/>ማርካብያ ጊግሰይሳት ገባላፐ ይዳ ኤራንቾታነ ካለያ ሂላንቾታ፤</para>
  <para style="q2" vid="EZK 27:9">አባን ብያ ማርካበ ኡባን ደእያ ኦሳንቾት ዎ ከያ ግድ ነ ግዶን ዛልኦሶና።<verse eid="EZK 27:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 27:10"/>“ፋርሰፈ፥ ሊደፐነ ሊበፐ ይዳ ኦላንቾት፥</para>
  <para style="q2" vid="EZK 27:10">ነ ኦላንቾታ ማድድ ኦለትዶሶና።</para>
  <para style="q1" vid="EZK 27:10">ባንታ ጎንዳልያነ ባንታ ኦላ ባርኔፃ ነ ግዶን ካቅዶሶና፤</para>
  <para style="q2" vid="EZK 27:10">ኤንቲ ነና ቦንችዳ አሳታ።<verse eid="EZK 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 27:11"/>አርዋዳነ ሄለካ ኦላንቾት፥</para>
  <para style="q2" vid="EZK 27:11">ነ ድርሳ ግምብያ ናጎሶና።</para>
  <para style="q1" vid="EZK 27:11">ጋማዳ አሳይ ነ አዱሳ ግምብ ሻኮ ቦላ ናጎሶና፤</para>
  <para style="q2" vid="EZK 27:11">ባንታ ጎንዳልያ ነ ግምብያ ቦላ ካቅዶሶና፤</para>
  <para style="q2" vid="EZK 27:11">ነ ፑላታና መላ ኦዳይ ኤንታና።<verse eid="EZK 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 27:12"/>ነ ዳሮ ዱረተ ጋሶን ታርሰስ ኔራ ዛልእስ፤</para>
  <para style="q2" vid="EZK 27:12">እ ብራ፥ ብራታ፥ ቆርቆሮነ እርሳሰ ኔራ ላምድ ዛልኦሶና።<verse eid="EZK 27:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 27:13"/>ያዋን፥ ቱባልነ ሞሳህ ኔራ ዛልእዶሶና፤</para>
  <para style="q2" vid="EZK 27:13">አይለታነ ናሰ ብራታ እምድ፥ ነ ሚሽያራ ላምዶሶና።<verse eid="EZK 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 27:14"/>ቤት-ቶርጋማ አሳይ</para>
  <para style="q2" vid="EZK 27:14">ቶጋ ፓራታ፥ ኦላ ፓራታነ ባቁሎታ እምድ፥ ነ ሚሽያራ ላምስ። <verse eid="EZK 27:14"/><verse number="15" style="v" sid="EZK 27:15"/>ድዳና አሳይ ኔራ ዛልእዶሶና፤ ዩሾይ አባን ተቀትዳ ቢታታን ደእያ አሳይ ዳንጋርሳ ዛለነ ዞጰ ም ነዉ ኤሆሶና።<verse eid="EZK 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 27:16"/>“ነ ዳሮ ዱረተ ጋሶን፥ ሶረ አሳት ኔራ ዛልእዶሶና፤ ኤንቲ ጭሊሎ አልኦ ሹች፥ ዞኦ አልኦ ሹች፥ የሌሎ አሌቆ፥ ኦቻ ቴራ ዳንያ ማኡዋ፥ አልኦ ሊኖነ አሌቀትዳ ማኦ ኤህድ ነ ሚሽያራ ላምዶሶና። <verse eid="EZK 27:16"/><verse number="17" style="v" sid="EZK 27:17"/>ይሁዳነ እስራኤለ አሳይ ኔራ ዛልእዶሶና፤ ኤንቲ ምንተ ጋደ ግስተ፥ ማልዶ፥ ኤስ፥ ዛይተነ ልያ ባልሳመ ዛይተ ነ ሚሽያራ ላምዶሶና። <verse eid="EZK 27:17"/><verse number="18" style="v" sid="EZK 27:18"/>ነ ዳሮ ዱረተነ ሻሎይ ደእያ ግሾ፥ ዳማስቆይ፥ ከልቦና፥ ዎይንያነ ዛሃራ ዶርሳ እክሰ እምድ ነ ሚሽያራ ላምዶሶና። <verse eid="EZK 27:18"/><verse number="19" style="v" sid="EZK 27:19"/>ኡዛለን ደእያ ዳነነ ያዋና አሳይ ነ ዱማ ዱማ ሚሸታ ሻምዶሶና። ኤንቲ ነ ሚሽያራ ላማናዉ አሌቀትዳ ብራታነ ዱማ ዱማ ሳዎ ኤህዶሶና።<verse eid="EZK 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 27:20"/>“ድዳና አሳይ ኮራ ግላሰ ኤህድ ዛልእዶሶና። <verse eid="EZK 27:20"/><verse number="21" style="v" sid="EZK 27:21"/>አራበትነ ቀዳረ ሀላቃት ኡባይ ነ ዛልኤ ሚሽያስ ዶርሳ ኡርገታ፥ ማራዘታነ ዴሻታ ኤህዶሶና። <verse eid="EZK 27:21"/><verse number="22" style="v" sid="EZK 27:22"/>ሳባነ ራማ ዛልአንቾት አልኦ ሹቹ፥ ዎርቃነ ዶረትዳ ሳዎታ እምድ፥ ነ ሚሽያራ ላምዶሶና። <verse eid="EZK 27:22"/><verse number="23" style="v" sid="EZK 27:23"/>ካራነ፥ ካነ፥ ኤደነ፥ ሳባ አሶረነ ከልማዳ ካታማት ኡባይ ኔራ ዛልእዶሶና። <verse eid="EZK 27:23"/><verse number="24" style="v" sid="EZK 27:24"/>ኤንቲ ሎኦ ማኦታ፥ ካሎሰ ዳንያ ማኡዋ፥ አሌቀትዳ ማኡዋ፥ ጋዛ ስጋጃታ፥ ሎይ ዶቅዳ ስባጎታነ ዎዶሮታ እምድ፥ ነ ግያን ዛልኦሶና።<verse eid="EZK 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 27:25"/>“ታርሰሳ ማርካበት ነ ሚሸታ ጫንዶሶና። ኔኒ ዳሮባይ ጫነትን፥ አባ ቦላ ብያ ማርካበ መላ ግዳዳሳ። <verse eid="EZK 27:25"/><verse number="26" style="v" sid="EZK 27:26"/>ነ ማርካብያ ላገይሳት ነና ኤክድ፥ አባ ግዶ ግና ኤፍዶሶና፤ ሽን ዶሎሀ ጫርኮይ ነና አባ ግዶን መንረስ። <verse eid="EZK 27:26"/><verse number="27" style="v" sid="EZK 27:27"/>ኔኒ መቀረትዳ ዎደ ነ ዱረተይነ ነ ዛልኤ ሚሸ ኡባይ፥ ነ ማርካብያ ላገይሳት፥ ነ ማርካብያ ጊግሰይሳት፥ ነ ዛልአንቾትነ ነ ግዶን ደእያ ኦላንቾት ኡባይ አባ ግዶን ሙከትዶሶና። <verse eid="EZK 27:27"/><verse number="28" style="v" sid="EZK 27:28"/>ኤንታ ዋሶይ አባ ጋፃ ደእያ ቢታ ዳጋንስ።<verse eid="EZK 27:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 27:29"/>“ማርካብያ ቦላ ኡትድ ሃ ፕይሳት ኡባይ ማርካበታፐ ከይድ፥ አባ ጋፃን ኤቅዶሶና። <verse eid="EZK 27:29"/><verse number="30" style="v" sid="EZK 27:30"/>ኤንቲ ኡባይ ባንታ ሁጰን ባና ቆልድ፥ ብዶን ጎንዶረትሸ፥ ነ ዩዋ ግሾ ኢታ ዬሆ ዬክዶሶና። <verse eid="EZK 27:30"/><verse number="31" style="v" sid="EZK 27:31"/>ነዉ ካዮትድ፥ ባንታ ሁጵያ ሜድድ፥ ካዮ ማኦ ማእዶሶና፤ ኤንቲ ዳሮ አዛንድ ነዉ ዬክዶሶና። <verse eid="EZK 27:31"/><verse number="32" style="v" sid="EZK 27:32"/>ኤንቲ ሀይሳዳ ያግድ ነዉ ዘሌልዶሶና፦</para>
  <para style="q1" vid="EZK 27:32">“ሀእ አባ ግዶን ስእ ግዳ፥</para>
  <para style="q2" vid="EZK 27:32">ፅሮሳ መል ኦኔ?”<verse eid="EZK 27:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 27:33"/>“ነ ዛልኤ ሚሸይ አባ ፕንድ ያ ዎደ፥</para>
  <para style="q2" vid="EZK 27:33">ዳሮ አሳ ካልሳዳሳ፤</para>
  <para style="q2" vid="EZK 27:33">ነ ሻሉዋን ቢታን ደእያ ካዎት ዱረትዶሶና።<verse eid="EZK 27:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 27:34"/>ሽን ሀእ ጪሞ አባን መቀረታዳሳ፤</para>
  <para style="q2" vid="EZK 27:34">ነ ዛልኤ ሚሸይነ ነዉ ኦያ አሳ ኡባይ፥</para>
  <para style="q2" vid="EZK 27:34">ኔራ አባ ግዶን ሙከትድ ይዶሶና።<verse eid="EZK 27:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="EZK 27:35"/>ዩሾይ አባን ተቀትዳ ቢታን ደእያ አሳ ኡባይ</para>
  <para style="q2" vid="EZK 27:35">ነ ቦላ ጋክዳባ በእድ ዳጋምዶሶና።</para>
  <para style="q1" vid="EZK 27:35">ኤንታ ካዎት ዳሮ ያይዶሶና፤</para>
  <para style="q2" vid="EZK 27:35">ኤንታ ሶምኦይ ያሻን ሹልስ።<verse eid="EZK 27:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="EZK 27:36"/>ነ ዉርሰይ ዳጋንያባ ግድስ፤</para>
  <para style="q2" vid="EZK 27:36">ኔኒ ዛራዳ ዳካ።</para>
  <para style="q1" vid="EZK 27:36">ሄሳ ግሾ፥ ቢታ ኡባን ደእያ</para>
  <para style="q2" vid="EZK 27:36">ዛልአንቾት፥ ሽንቻለ ግዶሶና” ያግስ።<verse eid="EZK 27:36"/></para>
  <chapter eid="EZK 27"/>
  <chapter number="28" style="c" sid="EZK 28"/>
  <para style="s1">ፅሮሳ ካዋ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 28:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 28:1"/><verse number="2" style="v" sid="EZK 28:2"/>“አሳ ናአዉ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ፅሮሳ ሀላቃስ ኦዳ፦ ‘ነ ዎዛናይ ኦቶርትዳ ግሾ፥ ታኒ ፆሰ፤ ታኒ አባ ግዶን፥ ፆሳታ አራታን ኡታስ’ ያጋዳሳ። ኔኒ፥ ‘ታኒ ፆሳዳ፥ ጭንጫ ግዳስ ጋዳ ቆፕኮካ ነ አሰፐ አትሽን፥ ፆሰ ግዳካ። <verse eid="EZK 28:2"/><verse number="3" style="v" sid="EZK 28:3"/>ነ ዳነላፐ አዳ ጭንጫይ? አይ ፁርካ ኔፐ ጌመኔ? <verse eid="EZK 28:3"/><verse number="4" style="v" sid="EZK 28:4"/>ቱማ ነ ጭንጫተንነ ነ አኬካን ዱረ ግዳዳሳ፤ ነ ቡቁራ ምንጃ ኬን ብራነ ዎርቃ ሺሻዳሳ። <verse eid="EZK 28:4"/><verse number="5" style="v" sid="EZK 28:5"/>ነ ዛልእያ ኤራን ዳሮ ዎ ደማዳሳ፤ ነ ዱረተ ጋሶን ነ ዎዛናይ ኦቶርትስ’ ” ያጌስ።<verse eid="EZK 28:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 28:6"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታኒ ፆሳዳ ጭንጫ ጋዳ ቆፕያ ግሾ፥ <verse eid="EZK 28:6"/><verse number="7" style="v" sid="EZK 28:7"/>ታ ነ ቦላ ቃይ ባይና ዎዛና ምኖ ሞርከታ ኤሀና፤ ኤንቲ ኔኒ ጭንጫተንነ ኤራተን ሺሽዳ ሻሎ ኡባ ማሻን ይሳና፤ ኤንቲ ነ ቦንቹዋ ቱንሳና። <verse eid="EZK 28:7"/><verse number="8" style="v" sid="EZK 28:8"/>ኤንቲ ነና ስኦለ የዳና፥ ነካ ጪሞ አባን ሀይቃና። <verse eid="EZK 28:8"/><verse number="9" style="v" sid="EZK 28:9"/>ኤንቲ ነና ዎናዉ ያ ዎደ ኔኒ፥ ‘ታኒ ፆሳ’ ጋኔ? ነና ዎያ አሳ ኩሸን ነ ኩንድያ ዎደ ነ አሰፐ አትሽን፥ ፆሰ ግዳካ። <verse eid="EZK 28:9"/><verse number="10" style="v" sid="EZK 28:10"/>ኔኒ አላጋታ ኩሸን አማኖና አስ ሀይቅያ ሀይቆ ሀይቃና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 28:11"/>ቃስ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 28:11"/><verse number="12" style="v" sid="EZK 28:12"/>“አሳ ናአዉ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ፅሮሳ ካዋስ ዘሌላ፦ ‘ኔኒ ካሰ ጭንጫተን ኩማዳሳ፤ ኔኒ አስ ሌምስድ ኦድያ ፑላነ ጭንጫ ግዳዳሳ። <verse eid="EZK 28:12"/><verse number="13" style="v" sid="EZK 28:13"/>ኔኒ ኤደነን፥ ፆሳ ጋናትያን ካሰ ደአዳሳ፤ ሳርድዮነ፥ ቶጳዘ፥ አልማዘ፥ ብርለ፥ ማርግደ፥ ያስጵደ፥ ሳንፓረነ ባሉረ ጌተትያ አልኦ ሹቻን አሌቀታዳ፥ ሎኦ ዎርቃ አሌቆ ካሰ ማአዳሳ፤ ነ መትዳ ጋላስ ሄ ኡባይ ነዉ ጊግስ። <verse eid="EZK 28:13"/><verse number="14" style="v" sid="EZK 28:14"/>ነና ናግያ ክሩበ ኦዳ ሹማስ፤ ነና ትያስ። ታ ጌሻ ዙማ ቦላ ነ ደአዳሳ፤ ታማዳ ጶልያ አልኦ ሹቻታ ግዶን ስመረታዳሳ። <verse eid="EZK 28:14"/><verse number="15" style="v" sid="EZK 28:15"/>ነ መትዳ ጋላሳፐ ዶማዳ፥ ኢታባይ ነ ቦላ በንታና ጋካናዉ ቦረይ ባይና ደአዳሳ። <verse eid="EZK 28:15"/><verse number="16" style="v" sid="EZK 28:16"/>ነ ዳሮ ዛልኤን ማትዳ ግሾ ቡቀን ኩማዳ፥ ናጋራ ኦዳሳ። ሄሳ ግሾ፥ ታ ጌሻ ዙማፐ ነና ዎልቃን ከሳስ። ነና ናግያ ክሩበይ፥ ሄ ታማዳ ጶልያ አልኦ ሹቻታ ግዶፈ የደስ። <verse eid="EZK 28:16"/><verse number="17" style="v" sid="EZK 28:17"/>ኔኒ ማላ ሎኦ ግድያ ግሾ ዳሮ ኦቶርታዳሳ፤ ነ ቦንቾ ኮያዳ ጭንጫተ ካዉሻዳሳ። ሄሳ ግሾ፥ ታ ነና ሳአን የጋስ፤ ሀራ ካዎት ነና በእድ ባያና መላ ኦስ። <verse eid="EZK 28:17"/><verse number="18" style="v" sid="EZK 28:18"/>ነ ናጋራንነ ነ ባለያ ዛልእያን፥ ነ ጎይኖ በሳታ ቱንሳዳሳ። ሄሳ ግሾ፥ ታም ነ ግዶፈ ከያናዳ ኦስ፤ እካ ነና ምስ። ኡባይ ፄልሽን፥ ታ ነና ፁጋዳ ሳኣ ቦላ ብዶ ከሳስ። <verse eid="EZK 28:18"/><verse number="19" style="v" sid="EZK 28:19"/>ነና ካሰ ኤርያ ካዎተት ኡባይ ዳጋምዶሶና። ነ ዉርሰይ ያሽያባ ግድስ፤ ኔኒ ዛራዳ በንታካ’ ” ያግስ።<verse eid="EZK 28:19"/></para>
  <para style="s1">ስዶና ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 28:20"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 28:20"/><verse number="21" style="v" sid="EZK 28:21"/>“አሳ ናአዉ፥ ነ ሶምኡዋ ስዶናኮ ዛራዳ እያ ቦላ ትንብተ ኦዳ። <verse eid="EZK 28:21"/><verse number="22" style="v" sid="EZK 28:22"/>ነኖ፥ ስዶና፥ ታ ነዉ ሞርከ ግዳና። ታኒ ነ ቦላ ኦያባን ታ ቦንቾይ ቆንጫና። ነ ግዶን ደኤይሳት ፕርዳን ታኒ ታ ጌሻተ በሲያ ዎደ፥ ታኒ ጎዳ ግደይሳ ኤንቲ ኡባይ ኤራና። <verse eid="EZK 28:22"/><verse number="23" style="v" sid="EZK 28:23"/>ታ ነ ቦላ ኢታ ሀርገ የዳና፤ ኦገ ኡባን ሱ ጉካናዳ ኦና። ኡባ ባጋራ ያ ኦላ ጋሶን ነ አሳይ ማሻን ሀይቃና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና። <verse eid="EZK 28:23"/><verse number="24" style="v" sid="EZK 28:24"/>ህዛፐ ጉየ እስራኤለ ዩሾን ደእያ፥ እያ ካድ ፄልያ፥ ቢታ ኡባን አጉንዳነ ክንቾተዳ ቆህያ ኦንካ ዴና። ታኒ ኡባ ሃርያ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 28:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 28:25"/>“እስራኤለ አሳ ላለትዳ ቢታ ኡባፈ ሺሻዳ ኤህያ ዎደነ ካዎተታ ኡባ ስንን ታኒ ታ ጌሻተ በሲያ ዎደ፥ ታኒ ታ አይልያ ያይቆባስ እምዳ ባንታ ቢታን ኤንቲ ዳና። <verse eid="EZK 28:25"/><verse number="26" style="v" sid="EZK 28:26"/>ያን ኤንቲ ሳሮነ ናገትድ ዳና፤ ኬ ኬፃና፤ ዎይነ ቶካና። ኤንታ ካድ ፄልያ ኤንታ ሾሮታ ኡባ ታኒ ፕርድያ ዎደ እስራኤለ አሳይ ሳሮ ዳና። ታኒ ጎዳ ኤንታ ፆሳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 28:26"/></para>
  <chapter eid="EZK 28"/>
  <chapter number="29" style="c" sid="EZK 29"/>
  <para style="s1">ግብፀ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 29:1"/>ኑኒ ድኤትዳ ታማን ላይን፥ ታማን አጌናን፥ ታማነ ናምአን ጋላስ፥ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 29:1"/><verse number="2" style="v" sid="EZK 29:2"/>“አሳ ናአዉ፥ ነ ሶምኡዋ ግብፀ ካዋኮ ዛራዳ፥ እያ ቦላነ ግብፀ ቢታ ኡባ ቦላ ትንብተ ኦዳ። <verse eid="EZK 29:2"/><verse number="3" style="v" sid="EZK 29:3"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ። ‘ነኖ፥ ናይለ ሻፋ ግዶን ዝንእዳ፥ ግታነ ያሽያ ዶአ ዳነይሶ። ናይለ ሻፋይ ታባ፤ እያ መዳይ ታና’ ግያ ግብፀ ካዋዉ፥ ታ ነዉ ሞርከ ግዳና። <verse eid="EZK 29:3"/><verse number="4" style="v" sid="EZK 29:4"/>ታ ነ ሲን ዳፎ አና፤ ነ ሻፋን ደእያ ሞሎታ ቀፈይ ነ ጋልባራ ኦይከታና መላ ኦና፤ ሞሎት ነ ጎጋራ ኦይከትድ ኡትዳሽን፥ ታ ነና ሃፈ ጎቻዳ ጋፃ ከሳና። <verse eid="EZK 29:4"/><verse number="5" style="v" sid="EZK 29:5"/>ታ ነናነ ነ ሻፋን ደእያ ሞሎታ ኡባ መላ ቢታ ሆላና፤ ነ አሀይ ደንባን የገትድ አታና፤ ነ አሀ ሺሽድ ሞግያ አስ ያና። ታ ነና ሳሎ ካፎታስነ ሳኣ ዶአታስ ካ ኦና። <verse eid="EZK 29:5"/><verse number="6" style="v" sid="EZK 29:6"/>ግብፀን ደእያ አሳ ኡባይ ታኒ ጎዳ ግደይሳ ሄ ዎደ ኤራና።</para>
  <para style="p" vid="EZK 29:6">“ኔኒ እስራኤለ አሳስ ማቃ ፃምአ ግዳዳሳ፤ <verse eid="EZK 29:6"/><verse number="7" style="v" sid="EZK 29:7"/>ኤንቲ ነና ኦይክዳ ዎደ መቃዳ ኤንታ ሾጰን ጫዳዳሳ፤ ኤንቲ ነናን ዘምፕዳ ዎደ መቃዳ ኤንታ ዞኩዋ ዱዳሳ። <verse eid="EZK 29:7"/><verse number="8" style="v" sid="EZK 29:8"/>ሄሳ ግሾ፥ ታኒ ኡባ ሃርያ ጎዳይ፥ ነ ቦላ ማሸ ደንይሳታ ኤሀና፤ ኤንቲ ነ አሳነ ነ መህያ ኡባ ዉርሳና። <verse eid="EZK 29:8"/><verse number="9" style="v" sid="EZK 29:9"/>ግብፀ ላለትድ ባይሳ ቢታ ግዳና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና። ኔኒ፥ ‘ናይለ ሻፋይ ታባ፤ እያ መዳይ ታና’ ያግዳ ግሾ፥ <verse eid="EZK 29:9"/><verse number="10" style="v" sid="EZK 29:10"/>ታኒ ነ ቦላነ ነ ሻፋ ቦላ ደንዳስ። ፑደሀ ባጋራ ምግዶላፐ ዶማዳ፥ ዱገሀ ባጋራ አስዋና ጋካናዉ፥ ያራ ካንድ ቶጰ ዛዋ ጋካናዉ ግብፀ ኡባ አስ ባይና ባይሳ በሰ ከሳና። <verse eid="EZK 29:10"/><verse number="11" style="v" sid="EZK 29:11"/>አሰ ግድን መሄ ግድን ያራ ካንና፤ ኦይታሙ ላይ ዉራና ጋካናዉ፥ አይብካ ያን ዴና። <verse eid="EZK 29:11"/><verse number="12" style="v" sid="EZK 29:12"/>ታኒ ግብፀ ቢታ ኡባፈ አዳ ባይሳ ቢታ ኦና፤ እያ ካታማት ኦይታሙ ላይ ዉራና ጋካናዉ፥ ሀራ ላለትዳ ካታማ ኡባፈ አድ ላለትዳ ካታማ ግዳና። ግብፀ አሳ ታኒ ካዎተታ ግዶንነ ሀራ አሳ ግዶን ላላና” ያጌስ።<verse eid="EZK 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 29:13"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ኦይታሙ ላይፈ ጉየ፥ ታኒ ግብፀይ ላለትዳ ካዎተታ ግዶፈ ሺሻና። <verse eid="EZK 29:13"/><verse number="14" style="v" sid="EZK 29:14"/>ታኒ ነና ዛራዳ ጋሽትሳና ኤንታ የለትዳ ዱገሀ ግብፀን ደእያ ጳትሮሳ ቢታ ዛራና፤ ያን ኤንቲ ላፋ ካዎተ ግድድ ዳና። <verse eid="EZK 29:14"/><verse number="15" style="v" sid="EZK 29:15"/>ግብፀይ ሀራ ካዎተታ ኡባፈ ላፋ ካዎተ ግዳና። ዛሪድ ሀራ ካዎተታ ቦላ ባና ቁ ቁ ኦና፤ እ ሀራ ካዎተ ሃሮናዳ ታኒ እያ ጉና። <verse eid="EZK 29:15"/><verse number="16" style="v" sid="EZK 29:16"/>እስራኤለይ ዛሪድ ማዶ ደማናዉ ግብፀን አማነተና፤ ግብፀን አማነትዳ አማነተይ አይ መላ ቆሆኮ እስራኤለይ አኬካና። ታኒ ኡባ ሃርያ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና” ያጌስ።<verse eid="EZK 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 29:17"/>ኑኒ ድኤትዳ ላታማነ ላፑን ላይን፥ ኮይሮ አጌናን፥ ኮይሮ ጋላሳን፥ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 29:17"/><verse number="18" style="v" sid="EZK 29:18"/>“አሳ ናአዉ፥ ባብሎነ ካዎይ ናቡካዳናፆር ፅሮሳ ቦላ ኦላ ደንናዉ ጊግስ። ኤንታ ሁጰይ ቆለታና ጋካናዉነ ኤንታ ሀሸይ ሾለታና ጋካናዉ ኦላንቾት ዴፆ ቶሆ ቶካና መላ ኦዶሶና። ግዶሽን፥ ካዎይነ ኦላንቾት ሀ ዳቡራ ኡባን ፅሮሳፐ ደምዳባይ ባዋ። <verse eid="EZK 29:18"/><verse number="19" style="v" sid="EZK 29:19"/>‘ታኒ ግብፀ ቢታ ባብሎነ ካዋ ናቡካዳናፆራስ አዳ እማና፤ እካ ባ ኦላንቾታስ ዳሞዘ ግዳና መላ ድኦንነ ቦንቀን ኦይክዳባ ኡባ ኤክድ ባና። <verse eid="EZK 29:19"/><verse number="20" style="v" sid="EZK 29:20"/>እነ እያ ኦላንቾት ታዉ ኦዳ ግሾ፥ ታኒ እያዉ ግብፀ ቢታ ኤንታ ዳቡራስ ዳሞዘ ኦዳ እማና’ ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 29:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 29:21"/>“ሄ ጋላስ ታኒ እስራኤለ ደርያ ምንና። ህዝቄላ፥ ነካ አሳስ ኦዳና መላ ታ ነና ምንና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና” ያግስ።<verse eid="EZK 29:21"/></para>
  <chapter eid="EZK 29"/>
  <chapter number="30" style="c" sid="EZK 30"/>
  <para style="s1">ግብፀስ ከስዳ ዘለልስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 30:1"/>ቃስካ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ፦ <verse eid="EZK 30:1"/><verse number="2" style="v" sid="EZK 30:2"/>“አሳ ናአዉ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ትንብተ ኦዳ።</para>
  <para style="q1" vid="EZK 30:2">“ ‘ሄ ጋላሳ አየ!</para>
  <para style="q2" vid="EZK 30:2">ያጋዳ ዘሌላ።’<verse eid="EZK 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 30:3"/>ሄ ጋላሳይ ማትስ!</para>
  <para style="q2" vid="EZK 30:3">ጎዳ ጋላሳይ ጋክስ!</para>
  <para style="q1" vid="EZK 30:3">ሄ ጋላሳይ ሻር ካምዳ ጋላስ</para>
  <para style="q2" vid="EZK 30:3">ካዎተታ ኡባስ መቶ ጋላስ ግዳና።<verse eid="EZK 30:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="EZK 30:4"/>ግብፀ ቦላ ኦል ያና፤</para>
  <para style="q2" vid="EZK 30:4">ቶጰ ቦላ ኡንእ ያና።</para>
  <para style="q1" vid="EZK 30:4">ዳሮት ግብፀ ቢታን ሀይቃና፤</para>
  <para style="q2" vid="EZK 30:4">እያ ዱረተይ ቦንቀታና፤ እያ ባሶይ ሾደታና።<verse eid="EZK 30:4"/></para>
  <para style="m">
    <verse number="5" style="v" sid="EZK 30:5"/>ሄ ኦላይ ቶጰ፥ ሊደ፥ ሊበ፥ አራበነ ጫቆ ደረ ኡባይ ግብፀራ እስፈ ማሻን ዉርሳና” ያጌስ።<verse eid="EZK 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 30:6"/>ግብፀ ማደይሳት ኩንዳና፤ እያ ኦቶሩዋ ዎልቃይ ዉራና። ምግዶላፐ ብድ አስዋና ጋካናዉ፥ ኤንቲ ማሻን ሀይቃና። ታኒ ኡባ ሃርያ ጎዳይ ሄሳ ኦዳይስ። <verse eid="EZK 30:6"/><verse number="7" style="v" sid="EZK 30:7"/>ግብፀይ ቢታ ኡባፈ አዳ ባይሳ ቢታ ግዳና፤ እያ ካታማት ሀራ ላለትዳ ካታማ ኡባፈ አድ ላለትድ አታና። <verse eid="EZK 30:7"/><verse number="8" style="v" sid="EZK 30:8"/>ታኒ ግብፀ ታማን ኦይያ ዎደነ እያ ማደይሳት ኡባይ ሀይቅድ ዉርያ ዎደ፥ ታኒ ጎዳ ግደይሳ ኤንቲ ኤራና።<verse eid="EZK 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 30:9"/>“ሄ ዎደ ታኒ ሳሮ ደእያ ቶጰ አሳ ዳጋንናዉ አሳታ ማርካበን ኪታና። ግብፀይ ፕርደትያ ጋላስ ቶጰ አሳ ቦላ ዋየይ ያና። ሄ ጋላሳይ ጋክስ” ያጌስ።<verse eid="EZK 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 30:10"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ባብሎነ ካዋ ናቡካዳናፆራ ኩሸን ታኒ ግብፀ ዱረተ ይሳና። <verse eid="EZK 30:10"/><verse number="11" style="v" sid="EZK 30:11"/>ካዎተታ ኡባፈ አድ፥ ዎዛና ምኖ ኦላንቾታ ካለድ ይድ፥ ቢታ ይሳና፤ ኤንቲ ግብፀ አሳ ቦላ ማሸ ሾድድ፥ ቢታን አሀ ኩንና። <verse eid="EZK 30:11"/><verse number="12" style="v" sid="EZK 30:12"/>ናይለ ሻፋ ታኒ መልሳና፤ ታኒ ግብፀ ኢታ አሳታ ኩሸን አዳ እማና፤ ሄ ቢታነ ያን ደእያባ ኡባ አላጋታን ይሳና። ታኒ ጎዳይ ሀይሳ ኦዳስ” ያጌስ።<verse eid="EZK 30:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 30:13"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “መምፕሳ ካታማን ደእያ ኤቃታነ ምስለታ ኡባ ታ ይሳና፤ ግብፀ ቢታን ዛሪድ ሀላቃይ ዴና፤ ቢታ ኡባ ታኒ ያሽሳና። <verse eid="EZK 30:13"/><verse number="14" style="v" sid="EZK 30:14"/>ታኒ ጳትሮሳ ጌተትያ ዱገሀ ባጋ ግብፀ ባይሳ ከሳና፤ ፑደሀ ባጋራ ደእያ ፆኣነ ካታማን ታማ የዳና፤ ተብሳ ካታማ ፕርዳና። <verse eid="EZK 30:14"/><verse number="15" style="v" sid="EZK 30:15"/>ግብፀ ሚፃ ግድዳ ፐሉስያማን ታ ሀንቁዋ ጉሳና፤ ተብሳ አሳ ኡባ ዉርሳና። <verse eid="EZK 30:15"/><verse number="16" style="v" sid="EZK 30:16"/>ታኒ ግብፀን ታማ ኦይና፤ ፐሉስያም ዳሮ ዋየታና፤ ተብሳ ድርሳ ግምበይ ላለታና፤ መምፕሳ ካታማ ዱፆና መቶይ ጋካና። <verse eid="EZK 30:16"/><verse number="17" style="v" sid="EZK 30:17"/>ኦናንነ ቡባስቱ ካታማን ደእያ ናአተት ኡባይ ማሻን ዉራና፤ ማጫሳይ ድኤትድ ባና። <verse eid="EZK 30:17"/><verse number="18" style="v" sid="EZK 30:18"/>ግብፀ ዎልቃ ታ መንረያ ዎደ ፃፍናሳን ጋላስ ቃማና፤ እ ኦቶሩዋ ዎልቃይ ዉራና፤ ግብፀ ሻር ካማና፤ ሄ ካታማ ዩሾን ደእያ ጉታቲ ኡባ ድኤትድ ባና። <verse eid="EZK 30:18"/><verse number="19" style="v" sid="EZK 30:19"/>ታኒ ግብፀ ሄሳዳ ኦዳ ፕርዳና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና” ያጌስ።<verse eid="EZK 30:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 30:20"/>ኑኒ ድኤትዳ ታማነ እስን ላይን፥ ኮይሮ አጌናን፥ ላፑን ጋላሳን፥ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 30:20"/><verse number="21" style="v" sid="EZK 30:21"/>“አሳ ናአዉ፥ ታ ግብፀ ካዋ ቀስያ መንስ፤ እያ ዎይሻንነ ጩርቃን ፃፅድ፥ ኮልድ ፓያ ሂል ባዋ፤ ህዛፐ ጉየ እ ምኖተ ደምድ ማሸ ኦይካናዉ ዳንዳኤና። <verse eid="EZK 30:21"/><verse number="22" style="v" sid="EZK 30:22"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ። ታኒ ግብፀ ካዋስ ሞርከ ግዳና። ካሰ እያዉ መቅዳ ቀስያነ ሎኦ ደእያ ቀስያ ናምኣካ ታ መንና፤ እያ ማሻይ እያ ኩሸፐ ሳአን ዎናዳ ኦና። <verse eid="EZK 30:22"/><verse number="23" style="v" sid="EZK 30:23"/>ታኒ ግብፀታ ካዎተታ ግዶንነ ሀራ ቢታታን ላላና። <verse eid="EZK 30:23"/><verse number="24" style="v" sid="EZK 30:24"/>ታኒ ባብሎነ ካዋ ናምኡ ቀስያ ምንዳ፥ ታ ማሻ እያ ኦይና። ሽን ግብፀ ካዋ ቀስያ መንና፤ ባ ሞርክያ ስንን እ ሀይቃና ሀንያ አሳዳ ኦላና። <verse eid="EZK 30:24"/><verse number="25" style="v" sid="EZK 30:25"/>ታኒ ግብፀ ካዋ ቀስያ ዳቡርሳዳ፥ ባብሎነ ካዋ ቀስያ ምንና። ታኒ ባብሎነ ካዋ ታ ማሻ ኦይያ ዎደነ እ ግብፀ ቦላ ደንያ ዎደ ግብፀት ታኒ ጎዳ ግደይሳ ኤራና። <verse eid="EZK 30:25"/><verse number="26" style="v" sid="EZK 30:26"/>ግብፀታ ታኒ ካዎተታ ግዶንነ ቢታ ኡባን ላላና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና” ያጌስ።<verse eid="EZK 30:26"/></para>
  <chapter eid="EZK 30"/>
  <chapter number="31" style="c" sid="EZK 31"/>
  <para style="s1">ልባኖሰ ዝጋ ሌምሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 31:1"/>ኑኒ ድኤትዳ ታማነ እስን ላይን፥ ሄን አጌናን፥ ኮይሮ ጋላሳን፥ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 31:1"/><verse number="2" style="v" sid="EZK 31:2"/>“አሳ ናአዉ፥ ግብፀ ካዋስነ አሳ ኡባስ ሀይሳዳ ያጋዳ ኦዳ፦ ‘ነ ግታተ ታ ኦደራ ጋደዮ?’ ”<verse eid="EZK 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 31:3"/>ነ ሎኦ ዳሻ ኩያይ ደእያ ልባኖሰ ዝጋ መላ፤</para>
  <para style="q2" vid="EZK 31:3">እ ድጭስ፤ እያ ፄራይ ሻራ ጋክስ።<verse eid="EZK 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 31:4"/>ያን እያ ድችያ ሃ ደኤስ፤</para>
  <para style="q2" vid="EZK 31:4">ፑልቶ ጪሞት እያ ድችዶሶና።</para>
  <para style="q1" vid="EZK 31:4">ሻፋት ጎግድ እያ ዩሹዋ እርፅስዶሶና፤</para>
  <para style="q2" vid="EZK 31:4">ፑልቶት ምይ ዶልያ በሳ ኡባ ኡሾሶና።<verse eid="EZK 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 31:5"/>ሄ ምይ ዎራን ደእያ ም ኡባፈ አዱቅስ፤</para>
  <para style="q2" vid="EZK 31:5">እያ ዳሻይ ዳርስ፤ ታሸይ አዱቅስ፤</para>
  <para style="q2" vid="EZK 31:5">ሃ ዳርዳ ግሾ ኦርድስ።<verse eid="EZK 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 31:6"/>ሳሎ ካፎት እያ ዳሻን ባንታ ኬ ኬፅዶሶና፤</para>
  <para style="q2" vid="EZK 31:6">ባዞ ዶአት እያ ኩያ ጋርሳን ናአ የልዶሶና፤</para>
  <para style="q2" vid="EZK 31:6">ግታ ካዎተት ኡባይ እያ ኩያን ሸምፖሶና።<verse eid="EZK 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 31:7"/>ባ ፃጱዋ ጪሞ ሃን ዱገ የድዳ ግሾ</para>
  <para style="q2" vid="EZK 31:7">ሄ ምይ ባ ዳሻ ታሽያራ ዋንድ ሎእ!<verse eid="EZK 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 31:8"/>ሀር አቶሽን ፆሳ ጋናትያን ሄ ዝጋራ ግንያ ዝግ ባዋ፤</para>
  <para style="q2" vid="EZK 31:8">እያ መላ ዳሽ ደእያ ፂድካ ባዋ።</para>
  <para style="q1" vid="EZK 31:8">ሄሳ መላ ኦቻ ም፥</para>
  <para style="q2" vid="EZK 31:8">ፆሳ ጋናትያን ሄሳ መላ ሎኦ ም ባዋ።<verse eid="EZK 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 31:9"/>ታኒ እያ ዳሮ ዳሻን ፑላያስ፤</para>
  <para style="q2" vid="EZK 31:9">ኤደነ ጌተትያ ፆሳ ጋናትያን</para>
  <para style="q2" vid="EZK 31:9">ደእያ ምት ኡባይ እያ ቃናቶሶና።<verse eid="EZK 31:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 31:10"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ሄ ምይ አዱቅድ ድጭዳ ግሾ፥ እያ ፄራይ ሻራ ጋክዳ ግሾነ እ ባ ጌሳን ኦቶርትዳ ግሾ፥ <verse eid="EZK 31:10"/><verse number="11" style="v" sid="EZK 31:11"/>ታ እያ የጋ አጋስ፤ ዎልቃማ፥ አላጋ ካዋስ አዳ እማስ። ሄ ካዎይ እያ ኢታተ መላ እያ ቦላ ኦና። <verse eid="EZK 31:11"/><verse number="12" style="v" sid="EZK 31:12"/>ዎዛና ምኖ አላጋት ሄ ም ቃንፅድ የጋና፤ ቃንፅዳ ታሸት ደረታን፥ ኦላታንነ ዛንጋራታን የገትድ አታና። እያ ኩያን ሸምፕያ ካዎተት ኡባይ ሄ በሳ አግድ ባና። <verse eid="EZK 31:12"/><verse number="13" style="v" sid="EZK 31:13"/>ሳሎ ካፎት ይድ ኩንድዳ ም ቦላ ኡታና፤ ባዞ ዶአት እያ ታሸታ የና። <verse eid="EZK 31:13"/><verse number="14" style="v" sid="EZK 31:14"/>ሃ ማታን ድጭያ ምታ ግዶን እያ መላ አዱቅድ፥ ፄራይ ሻራ ጋክያ ም ዴና። ሀይቅያ አሳ ቦላ ጋክያ ሀይቆ ፕርዳይ ሄ ም ቦላ ጋካና፤ እ ዱፎን ደኤይሳታራ ግዳና” ያጌስ።<verse eid="EZK 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 31:15"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ሄ ምይ ዱፎ ገልያ ጋላስ ጪሞ ፑልቶ ሃት እያዉ ካዮታና መላ ኦና። ሄ ፑልቶ ሃይ ጎጎና መላ ኦና፤ ልባኖሰይ እያ ግሾ አዛናና መላ ኦና፤ ዎራ ም ኡባይ ሹላና። <verse eid="EZK 31:15"/><verse number="16" style="v" sid="EZK 31:16"/>ታ ሄ ም ዱፎን ሆልያ ዎደ፥ እያ ኩንደ ግርሳን ካዎተ ኡባይ ቃፃና። ኩንድድ ዱፎን ገልዳ ኤደነ ምትነ ሃ ኡይድ ኦርድዳ ሎኦ ልባኖሰ ምት ኡባይ እያ ኩንደን ምንተና። <verse eid="EZK 31:16"/><verse number="17" style="v" sid="EZK 31:17"/>ካዎተታ ግዶን እያራ እስፍዳይሳትነ እያ ኩያን ደእያ ኡባይ ካሰ ማሻን ሀይቅዳይሳታራ ጋሄታናዉ እያራ እስፈ ዱፎ ገላና። <verse eid="EZK 31:17"/><verse number="18" style="v" sid="EZK 31:18"/>ኤደነ ጋናትያን ደእያ ምታ ግዶን ሄሳ መላ ግትነ ሎኦይ ባዋ። ሽን ሀእ ኤደነ ምታዳ እካ ሀይቅድ ዱፎን ገሌስ፤ ያን እ ማሻን ሀይቅዳ አማኖናይሳታራ ጋሄታና።</para>
  <para style="p" vid="EZK 31:18">“ሄ ምይ ግብፀ ካዋነ እያ አሳ ሌምሶ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 31:18"/></para>
  <chapter eid="EZK 31"/>
  <chapter number="32" style="c" sid="EZK 32"/>
  <para style="s1">ፓሮናስ ከስዳ ዘለልስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 32:1"/>ኑኒ ድኤትዳ ታማነ ናምአን ላይን፥ ታማነ ናምአን አጌናን፥ ኮይሮ ጋላሳን፥ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 32:1"/><verse number="2" style="v" sid="EZK 32:2"/>“አሳ ናአዉ፥ ግብፀ ካዋስ ሀይሳዳ ያጋዳ ዘሌላ። ኔኒ ካዎተታስ ግዶን ነና ጋሞ መላ ከሳዳሳ፤ ሽን ነ አባ ግዶን ደእያ ዬሩን መላ። ነ ሃፈ ከያዳሳ፤ ነ ቶሁዋን የዳ፥ ሃ ቡሎያዳሳ። <verse eid="EZK 32:2"/><verse number="3" style="v" sid="EZK 32:3"/>ዳሮ አሳይ ሺቅያ ዎደ ታኒ ታ ግትያን ነና ኦይካና፤ አሳይ ነና ጎችድ፥ ሃፈ ጋፃ ከሳና። <verse eid="EZK 32:3"/><verse number="4" style="v" sid="EZK 32:4"/>ታኒ ነና ቢታን ሆላ አጋና፤ ሳአ ቦላ ምጫና፤ ሳሎ ካፎታ ነ ቦላ ኡትሳና፤ ባዞ ዶአታ ነ አሹዋ ካልሳና። <verse eid="EZK 32:4"/><verse number="5" style="v" sid="EZK 32:5"/>ታ ነ አሹዋ ደረታ ቦላ ላላና፤ ዛንጋራታ ነ አሀን ኩንና። <verse eid="EZK 32:5"/><verse number="6" style="v" sid="EZK 32:6"/>ሻፋታ ኩምድ ደረታ ካማና፥ ጋካናዉ፥ ነ ሱይ ጉካና መላ ኦና። <verse eid="EZK 32:6"/><verse number="7" style="v" sid="EZK 32:7"/>ታ ነና ይስያ ዎደ ሳሎይ ጎዘታና፤ ፆልንቶት ማና፤ አዋይ ሻራን ካመታና፤ አጌናይ ባ ፖኡዋ ድጋና። <verse eid="EZK 32:7"/><verse number="8" style="v" sid="EZK 32:8"/>ኔፐ ቦላራ ደእያ ሳሎ ፖኦታ ኡባ ይሳዳ፥ ቢታ ምሳና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 32:9"/>ነ ቦላ ጋክዳ ዩዋ ነ ኤሮና ካዎተታ ስስያ ዎደ ዳሮ አሳ ዎዛናይ ኡንኤታና። <verse eid="EZK 32:9"/><verse number="10" style="v" sid="EZK 32:10"/>ዳሮ ካዎተት ነና በእድ ዳጋማና። ታኒ ታ ማሻ ኤንታ ስንን ሾዳዳ ሴስያ ዎደ፥ ካዎተት ያሻን ኮኮራና፤ ነ ኩንድያ ዎደ ኤንቲ ኡባይ ባንታ ሸምፑዋስ ያያና።<verse eid="EZK 32:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 32:11"/>ኡባ ሃርያ ጎዳይ ግብፀ ካዋኮ ሀይሳዳ ያጌስ፦ “ባብሎነ ካዋ ማሻይ ነ ቦላ ያና። <verse eid="EZK 32:11"/><verse number="12" style="v" sid="EZK 32:12"/>ሀራ ካዎተታፐ አዳ፥ ዎዛና ምኖ ኦላንቾት ባንታ ማሻን ዳሮ አሳ ዉርሳናዳ ታኒ ኦና። ኤንቲ ግብፀ ኦቶሩዋ ይሳና፤ ዳሮ አሳይ ዉራና። <verse eid="EZK 32:12"/><verse number="13" style="v" sid="EZK 32:13"/>ዳሮ ሃ ማታን ደእያ መሄ ኡባ ታ ይሳና፤ ህዛፐ ጉየ፥ ሃ ቡሎያ አስ ዎይኮ መሄይ ዴና። <verse eid="EZK 32:13"/><verse number="14" style="v" sid="EZK 32:14"/>ሄ ዎደ ታኒ ነ ሃታ ፅልሳና፤ ነ ሻፋታ ዎፑ ኦዳ ጎግሳና። ታኒ ኡባ ሃርያ ጎዳይ ሀይሳ ኦዳይስ። <verse eid="EZK 32:14"/><verse number="15" style="v" sid="EZK 32:15"/>ታኒ ግብፀ ባይሳ ከስያ ዎደ እያን ደእያ ኡባ ቁቻዳ ይስያ ዎደነ እያን ደእያ አሳ ኡባ ሾጭያ ዎደ ታኒ ጎዳ ግደይሳ ኤንቲ ኤራና። <verse eid="EZK 32:15"/><verse number="16" style="v" sid="EZK 32:16"/>ሀ ኡባይ ኤንታዉ ዘሌለትያ ዘለልስ ግዳና። ካዎተታ ማጫሳት ግብፀስነ እያ ዳሮ አሳስ ዘሌላና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 32:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 32:17"/>ኑኒ ድኤትዳ ታማነ ናምአን ላይን፥ ሄ አጌናን፥ ታማነ እቻሻን ጋላሳን፥ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ፦ <verse eid="EZK 32:17"/><verse number="18" style="v" sid="EZK 32:18"/>“አሳ ናአዉ፥ ዳሮ ግድዳ ግብፀ ኦላንቾታ ግሾ ዬካ። እዮነ፥ ዎልቃማ ካዎተታ ማጫ ናይታ ሀይቅድ ዱፎ ገለይሳታራ እስፈ ዱገ ዱፎ ሞይዛ። <verse eid="EZK 32:18"/><verse number="19" style="v" sid="EZK 32:19"/>ኤንታኮ፥ ‘ህንተኖ ግብፀቶ፥ ህንተ ሀራታፐ አድ ማላ ሎኦ? ህንተ ዱፎ ገላና፤ ያን ህንተ ጎዳ ቃፃረቶናይሳታራ እስፈ ሞገታና።’ <verse eid="EZK 32:19"/><verse number="20" style="v" sid="EZK 32:20"/>ግብፀ ቢታስ ማሽ ሾደትድ ኡትዳ ግሾ፥ ኤንቲ ማሻን ሀይቅዳይሳታ ግዶን ኩንዳና፤ ግብፀይ ባ ዳሮ አሳራ ዱገ ጎሸታና። <verse eid="EZK 32:20"/><verse number="21" style="v" sid="EZK 32:21"/>ዱፎን ደእያ ዎልቃማ ሀላቃት ግብፀባነ ግብፀራ እስፍዳይሳታባ ሃሳይሸ፥ ‘ኤንቲ ዱገ ይዶሶና፤ ጎዳ ቃፃረቶናይሳታ ማሻን ሀይቅዳይሳታራ ኤንቲ ዝንእዶሶና’ ያጎሶና።<verse eid="EZK 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 32:22"/>“አሶረይ ዱፎን ደኤስ። ኦላን ሀይቅዳ አሶረ ኦላንቾታ ዱፎት እያ ዩሹዋ ተቅድ ኡትዶሶና። <verse eid="EZK 32:22"/><verse number="23" style="v" sid="EZK 32:23"/>ኤንታ ዱፎት ኦላስ ዉርሰ ጋፃን ደኦሶና። እያ ኦላንቾት ዱፉዋ ዩሾን ኬለትዶሶና፤ ካሰ ደኦን ደእያ አሳ ሄራን ቡቀ ደንያ አሳይ ሹከትዶሶና፤ ማሻን ዉርዶሶና።<verse eid="EZK 32:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 32:24"/>“ኤላም ዱፎን ደኤስ፤ እያ ኦላንቾት ኡባይ ሹከትዶሶና ማሻን ኩንድዶሶና። ደኦን ደእያ አሳ ማታን ቡቀ ደንዳሳት ኡባይ ቃፃረቶና ቢታ ጋርስ አዶሶና ዱፎ ገልድ ዝንእዶሶና። <verse eid="EZK 32:24"/><verse number="25" style="v" sid="EZK 32:25"/>ሀይቅዳይሳታ ግዶን ኤላማስ በሲ ጊግድ ኡትስ። ኤላማ ኦላንቾታ ዱፎት እያ ዩሹዋን ደኦሶና፤ ኤንቲ ኡባይ ማሻን ሀይቅዶሶና። ኤንቲ ኡባይ ቃፃረትቦናይሳታነ ማሻን ሀይቅዳይሳታ ኤንቲ ደኦን ደኤይሳታ ግዶን ቡቀ ደንዳ ግሾ ዱፎ ጌልዳይስታራ እስፈ ዝንእዶሶና።<verse eid="EZK 32:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 32:26"/>“ሞሳህነ ቶባል ባንታ ኦላንቾታራ ዱፎን ደኦሶና፤ ኤንቲ ካሰ ካዎተታ ኡባ ያሻን ኮኮርስዳይሳታ ግድኮካ፥ ኤንቲ ኡባይ ማሻን ሀይቅዶሶና። ኤንቲ ኡባይ ቃፃረቶናይሳታ። ኤንቲ ደኦን ደኤይሳታ ግዶን ቡቀ ደንዳ ግሾ ማሻን ሀይቅዶሶና። <verse eid="EZK 32:26"/><verse number="27" style="v" sid="EZK 32:27"/>ኤንቲ በን ጎባ ኦላንቾት ባንታ ኦላ ሚሽያ ዳንጭድ ባንታ ጎንዳልያ ትራን ዎድ ባንታ ማሻ ቦርኮትድ ሞገተይሳዳ ቦንቾን ሞገትቦኮና። ሀ ኦላንቾታ ደኦን ደእያ አሳ ግዶን ቡቀ ደንዳ ግሾ ኤንታ ናጋራይ ኤንታ መቀ ቦላ ደኤስ።<verse eid="EZK 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 32:28"/>“ህንተ ግብፀ አሳት ፆነታናነ ማሻን ሀይቅዳ፥ አማኖና አሳታራ እስፈ ዝንአና።<verse eid="EZK 32:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 32:29"/>“ኤዶመይ ባ ካዎታራነ ባ ሀላቃታራ እስፈ ዱፎን ደኤስ፤ ኤንቲ ካሰ ምኖ ኦላንቾታ፤ ሽን ሀእ ኦላን ሀይቅዳ፥ አማኖና አሳታራ ኦላን ገልዶሶና።<verse eid="EZK 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 32:30"/>“ፑደሀ ባጋ ሀላቃትነ ስዶና አሳይ ዱፎን ደኦሶና። ኤንቲ ካሰ ባንታ ዎልቃን አሳ ያሽስዶሶና፤ ሽን ሀእ ኤንቲ ባንታ ዬላራ ያ ገልዶሶና። ማሻን ሀይቅዳ ቃፃረትቦና አሳራ እስፈ ዱፎ ገሎሶና።<verse eid="EZK 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZK 32:31"/>“ግብፀ ካዎይነ እያ ኦላንቾት፥ ማሻን ሀይቅዳ ኦላንቾታ ያን በእድ ምነታና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 32:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 32:32"/>“ታ ሀይሳፈ ካሰ ካዎተት ግብፀ ካዋስ ያያና መላ ኦዳባ ግድኮካ፥ እነ እያ ኦላንቾት ጎዳ አማኖና፥ ማሻን ሀይቅዳ አሳታራ እስፈ ዝንአና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 32:32"/></para>
  <chapter eid="EZK 32"/>
  <chapter number="33" style="c" sid="EZK 33"/>
  <para style="s1">ህዝቄል ዎችያ አስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 33:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 33:1"/><verse number="2" style="v" sid="EZK 33:2"/>“አሳ ናአዉ፥ ነ ቢታ አሳስ ሀይሳዳ ያጋዳ ኦዳ፦ ‘ታ እስ ቢታ ቦላ ኦላ ኤህያ ዎደ ሄ ቢታ አሳይ ባንታ ቦላ ያባ ዎችያ አስ ዶሮ ባንታ ግዶፈ ዶሮ። <verse eid="EZK 33:2"/><verse number="3" style="v" sid="EZK 33:3"/>ሄ ዎችያ ኡራይ ሞርከይ ይሽን በእድ፥ አሳይ ናገታና መላ ሞይዘ ፑንኮ፥ <verse eid="EZK 33:3"/><verse number="4" style="v" sid="EZK 33:4"/>ኦንካ ሞይዘ ፑኑዋ ስእድ፥ ናገቶና እፅን፥ ኦል ይድ እያ ዎኮ፥ ሱ አጮይ እያ ኦይኮ። <verse eid="EZK 33:4"/><verse number="5" style="v" sid="EZK 33:5"/>እ ሞይዘ ፑኑዋ ስእድ፥ ናገቶና እፅዳ ግሾ እያ ሱ አጮይ እያ ቦላና። እ ስእድ ናገትዳባ ግድያኮ ሀይቆፐ አታናሽን። <verse eid="EZK 33:5"/><verse number="6" style="v" sid="EZK 33:6"/>ሽን ዎቸይስ ሞርከይ የይሳ በእሸ፥ ሞይዘ ፑንድ አሳ ኤርሶና አግኮ፥ ኦላይ ይድ፥ ሄ አሳፐ እስ አስ ዎኮ፥ ሄ ኡራይ ባ ናጋራን ሀይቄስ፤ ሽን ታኒ እያ ሱ ዎቸይሳ ኩሸፐ ኤካና’ ” ያጋ።<verse eid="EZK 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 33:7"/>“አሳ ናአዉ፥ ታ ነና እስራኤለ አሳስ ዎችያ አስ ኦስ፤ ታ ነዉ ኦደይሳ ስአዳ አሳ አኬክሳ። <verse eid="EZK 33:7"/><verse number="8" style="v" sid="EZK 33:8"/>ታኒ እስ ኢታ አስ፥ ‘ኔኒ ቱማ ሀይቃና’ ግያ ዎደ፥ እ ባ ናጋራፐ ስማና መላ ነ እያዉ ኦዶና እፅኮ፥ ሄ ኡራይ ባ ናጋራን ሀይቄስ፤ ሽን ታኒ እያ ሱ ግሾ ነና አቻና። <verse eid="EZK 33:8"/><verse number="9" style="v" sid="EZK 33:9"/>ሽን ናጋራንቾይ ባ ናጋራፐ ስማና መላ ነ ኦድን፥ እ እፅኮ፥ እ ባ ናጋራን ሀይቄስ፤ ሽን ነ ነ ሸምፑዋ አሻሳ።”<verse eid="EZK 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 33:10"/>“አሳ ናአዉ፥ እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፦ ‘ህንተ፥ ኑ ናጋራይ ኑ ቆሆይ ኑ ቦላ ደኤስ፤ ሄሳ ጋሶን ኑ ግልቅዳ። ያትን፥ ኑ ዋንድ ፓፃ ዳናዉ ዳንዳኦና?’ ” ያጌታ። <verse eid="EZK 33:10"/><verse number="11" style="v" sid="EZK 33:11"/>ታኒ ኡባ ሃርያ ጎዳይ ታ ደኡዋን ጫቃይስ፦ “ናጋራንቾይ ባ ናጋራ አግድ፥ ደኦን ዳና መላ ኮያይስፐ አትሽን፥ ናጋራንቹዋ ሀይቁዋን ኡፋይትከ። ህንተኖ፥ እስራኤለ አሳዉ፥ ስምተ፤ ህንተ ኢታ ኦሱዋ አግተ! አይስ ሀይቃናዉ ኮዬቲ?” ያግስ።<verse eid="EZK 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 33:12"/>አሳ ናአዉ፥ ነ ቢታ አሳስ ኦዳ። “ፅሎ አስ ናጋራ ኦኮ፥ እያ ካሰ ፅሎተይ እያ አሸና፤ ቃስ ናጋራንቾይ ባ ናጋራፐ ስምኮ፥ ካሰ ናጋራ ግሾ እ ፕርደተና። ፅሎ አስ ናጋራ ኦኮ፥ ካሰ ፅሎተ ግሾ ደኦን ዳናዉ ዳንዳኤና። <verse eid="EZK 33:12"/><verse number="13" style="v" sid="EZK 33:13"/>ታኒ ፅሎ አሳኮ፥ ‘ኔኒ ቱማ ደኦን ዳና’ ያግዳ ዎደ፥ እ ባ ፅሎተን አማነትድ ናጋራ ኦኮ፥ ባ ኦዳ ናጋራን እ ሀይቃናፐ አትሽን፥ ካሰ ፅሎተይ እያው ቆፈተና። <verse eid="EZK 33:13"/><verse number="14" style="v" sid="EZK 33:14"/>ቃስ ታኒ ናጋራንቾ አሳኮ፥ ‘ኔኒ ቱማ ሀይቃና’ ያግዳ ዎደ እ ባ ናጋራፐ ስሚድ፥ ቱማነ ሱረ ኦሶ ኦኮ፥ <verse eid="EZK 33:14"/><verse number="15" style="v" sid="EZK 33:15"/>ሚሸ ታልአናዉ ኦይክዳባ ዛርኮ፥ ካይሶትዳባ ጉየ እምኮ፥ ናጋራ ኦሶ አግድ፥ ደኦ እምያ ህግያ ናግኮ፥ እ ቱማ ደኦን ዳናፐ አትሽን፥ ሀይቀና። <verse eid="EZK 33:15"/><verse number="16" style="v" sid="EZK 33:16"/>እ ካሰ ኦዳ ናጋራይ እሶይ ቆፈተና፤ ሀእ ቱማነ ሱረ ኦሶ ኦዳ ግሾ፥ እ ቱማ ደኦን ዳና።<verse eid="EZK 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 33:17"/>“ግዶሽን፥ ነ ቢታ አሳይ፥ ‘ጎዳ ኦገይ ልከ ግደና’ ያጎሶና፤ ሽን ልከ ግዶናይ ኤንታ ኦግያ። <verse eid="EZK 33:17"/><verse number="18" style="v" sid="EZK 33:18"/>ፅሎ አስ ባ ፅሎተ አግድ፥ ናጋራ ኦኮ፥ እ ባ ናጋራን ሀይቃና። <verse eid="EZK 33:18"/><verse number="19" style="v" sid="EZK 33:19"/>ቃስ ናጋራንቾ አስ ባ ናጋራፐ ስሚድ፥ ቱማነ ሱረ ኦሶ ኦኮ፥ ሄ ኦሱዋን እ ደኦን ዳና። <verse eid="EZK 33:19"/><verse number="20" style="v" sid="EZK 33:20"/>ሽን ህንተ፥ ‘ጎዳ ኦገ ልከ ግደና’ ያጌታ። እስራኤለ አሳዉ፥ ታ ህንተ እሱዋ እሱዋ ቦላ ህንተ ኦሱዋዳ ፕርዳና” ያግስ።<verse eid="EZK 33:20"/></para>
  <para style="s1">የሩሳላመ ኩንደ</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 33:21"/>ኑኒ ድኤትዳ ታማነ ናምአን ላይን፥ ታማን አጌናን፥ እቻሻን ጋላሳን፥ የሩሳላመፐ ከስ ኤክድ ይዳ እስ አስ ካታማይ ኩንድዳይሳ ታዉ ኦድስ። <verse eid="EZK 33:21"/><verse number="22" style="v" sid="EZK 33:22"/>ሄ ኡራይ ያናፐ እስ ጋላስ ስን፥ ኦማርሳ ዎደ ጎዳ ኩሸይ ታ ቦላ ደኤስ፤ ታ ዶናይ ዶየትስ፤ ዎንተ ጋላስ ሄ ኡራይ ታኮ ጋክያ ዎደ ታኒ ኦዳ ዶማስ።<verse eid="EZK 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 33:23"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 33:23"/><verse number="24" style="v" sid="EZK 33:24"/>“አሳ ናአዉ፥ እስራኤለ ቢታን ላለትዳ ካታማታን ደእያ አሳይ ሀይሳዳ ያጎሶና፦ ‘አብራሃመይ ባርካ ደእያ እስ አስ፤ እ ሀ ቢታ ላትስ፤ ሽን ኑኒ ዳሮ፤ ቢታይ ቱማ ኑስ ላታ ግድድ እመትስ’ ” ያጎሶና።<verse eid="EZK 33:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 33:25"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኤንታዉ ኦዳ። “ህንተ ሀእካ ሱራ ደእያ አሾ ሜታ፤ ኤቃ ጎይነታ፤ ሸምፖ ዎታ። ሀይሳ ኡባ ኦሸ ህንተ ቱማ ቢታ ላታኔ? <verse eid="EZK 33:25"/><verse number="26" style="v" sid="EZK 33:26"/>ህንተ ህንተ ማሻን አማነተታ፤ ቱና ኦሶ ኦታ፤ ህንተ ኡባይ ህንተ ሾሩዋ ማቸታ ቱንሴታ። ሀይሳ ኡባ ኦሸ ህንተ ቱማ ቢታ ላታኔ?” ያጌስ።<verse eid="EZK 33:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 33:27"/>ኡባ ሃርያ ጎዳይ ባ ደኡዋን ጫቅድ ሀይሳዳ ያጌስ፦ “ላለትዳ ካታማታን ደእያ አሳይ ማሻን ሀይቃና፤ ካታማፐ ጋፃን ደእያ አሳ ታኒ ባዞ ዶኣስ ካ ኦና፤ ደረ ቦላነ ጎንጎሎ ግዶን ደእያ አሳይ ኢታ ሀርገን ሀይቃና። <verse eid="EZK 33:27"/><verse number="28" style="v" sid="EZK 33:28"/>ታ ሄ ቢታ ካሎነ ባይስ ከሳና፤ ኤንቲ ኦቶርትያ ዎልቃይ ዉራና፤ እስራኤለ ደረት አይ አስካ ያራ ካንና ባይስ ግዳና። <verse eid="EZK 33:28"/><verse number="29" style="v" sid="EZK 33:29"/>ኤንቲ ኦዳ ቱና ጋሶን ታኒ ቢታ ካሎነ ባይስ ከስያ ዎደ፥ ታኒ ጎዳ ግደይሳ ኤንቲ ኤራና” ያጌስ።<verse eid="EZK 33:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 33:30"/>“አሳ ናአዉ፥ አሳይ ካታማ ድርሳ ማታንነ ባንታ ኬታ ፐንገን ኤቅድ፥ እሶይ እሱዋራ ሀይሳዳ ያግድ፥ ነባ ኦደቴስ። ‘ሃይተ፤ ጎዳ ማታፐ ይዳ ቃላይ ዎይግያኮ አነ ስኦስ’ ያጎሶና። <verse eid="EZK 33:30"/><verse number="31" style="v" sid="EZK 33:31"/>ኤንቲ ካሰ አሳይ የይሳዳ ኔኮ ዮሶና፤ ታ አሳዳ ነ ስንን ኡቶሶና፤ ነ ኦደይሳ ስኦሶና፤ ሽን ኦኮና። ኤንቲ ሲቆባ ሃሳዮሶና፤ ሽን ኤንታ ዎዛናይ ጎአ ፃላላ ያረቴስ። <verse eid="EZK 33:31"/><verse number="32" style="v" sid="EZK 33:32"/>ነ ኤንታዉ እስ ሲቆ ማዝሙረ ሎኦ ግርሳን የፅያነ ዲ ሎይድ ዲፅያ አሳ መላ። ኤንቲ ነ ኦደይሳ ስኦሶና፤ ሽን ኦኮና። <verse eid="EZK 33:32"/><verse number="33" style="v" sid="EZK 33:33"/>ሽን ነ ኦደይስ ቱማ ፖለታና፤ ፖለትያ ዎደ፥ ናበይ ኤንታ ግዶን ደኤይሳ ኤንቲ ኤራና” ያግስ።<verse eid="EZK 33:33"/></para>
  <chapter eid="EZK 33"/>
  <chapter number="34" style="c" sid="EZK 34"/>
  <para style="s1">እስራኤለ ሄንንቾታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 34:1"/>ጎዳ ቃላይ ሀይሳዳ ያግድ ታኮ ይስ። <verse eid="EZK 34:1"/><verse number="2" style="v" sid="EZK 34:2"/>“አሳ ናአዉ፥ እስራኤለ ሄንንቾታ ቦላ ሀይሳዳ ያጋዳ ትንብተ ኦዳ፦ ህንተኖ፥ ህንተና ሄምያ እስራኤለ ሄንንቾቶ፥ ህንተና አየ! ህንተ ዶርሳታ ሄማናዉ በሰኔ? <verse eid="EZK 34:2"/><verse number="3" style="v" sid="EZK 34:3"/>ኤንታ ማ ኡዬታ፤ ኤንታ እክስያፐ ዳደትዳ ሱፍያ ማኤታ፤ ኤንታፈ ሞዋ ሹክድ ሜታ፤ ሽን ዶርሳታ ሱረ ሄመከታ። <verse eid="EZK 34:3"/><verse number="4" style="v" sid="EZK 34:4"/>ዳቡርዳይሳታ ጋሽትስበከታ፤ ሀርግዳይሳታ ፓቤከታ፤ መቅዳይሳታ ኮልቤከታ፤ በትዳይሳታ ዛርቤከታ፤ ይዳይሳታ ኮይበከታ። ሄሳ አግድ ኤንታ ዎልቃን ኡንኤድ ሃርደታ። <verse eid="EZK 34:4"/><verse number="5" style="v" sid="EZK 34:5"/>ዶርሳት ኡባይ ሄምያ አስ ይን ላለትዶሶና፤ ባዞ ዶአታስ ካ ግድዶሶና። <verse eid="EZK 34:5"/><verse number="6" style="v" sid="EZK 34:6"/>ታ ዶርሳት ላለትዶሶና፤ ኤንቲ ዙማታ ቦላነ ደረታ ቦላ ቶይላትዶሶና። ቢታ ጋፃ ጋካናዉ ላለትዶሶና፤ ሽን ኤንታ ፆሞሰይ ዎይኮ ኮየይ ባዋ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 34:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 34:7"/>ሄሳ ግሾ፥ ህንተኖ፥ ሄንንቾቶ፥ ጎዳ ቃላ ስእተ። <verse eid="EZK 34:7"/><verse number="8" style="v" sid="EZK 34:8"/>“ታኒ ታ ደኡዋን ጫቃይስ፦ ታ ዶርሳታ ሄምያ አስ ይን፥ ታ ዶርሳት ኦይከትድ፥ ባዞ ዶአታስ ካ ግድዶሶና። ታ ሄንንቾት ታ ዶርሳታ ኮይቦና ግሾነ ኤንቲ ታ ዶርሳታ ሄሞና አግድ፥ ባንታና ሄምዳ ግሾ፥ <verse eid="EZK 34:8"/><verse number="9" style="v" sid="EZK 34:9"/>ህንተኖ፥ ሄንንቾቶ፥ ጎዳ ቃላ ስእተ። <verse eid="EZK 34:9"/><verse number="10" style="v" sid="EZK 34:10"/>ታ ህንተዉ፥ ሄንንቾሆታስ ሞርከ ግዳና፤ ታ ዶርሳታ ታኒ ህንተፈ ኤካና፤ ታ ህንተና ናምአን ኤንታዉ ሄንንቾ ኦከ። ህዛፐ ጉየ ህንተ ህንተና ሄምሸ ደኤከታ። ታ ዶርሳታ ታ ህንተፈ ኤካና፤ ህዛፐ ኤንቲ ህንተዉ ካ ግዶኮና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 34:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 34:11"/>“ታኒ ታ ሁጰን ታ ዶርሳታ ፆሞሳናነ ኮያና። <verse eid="EZK 34:11"/><verse number="12" style="v" sid="EZK 34:12"/>ሄንንቾይ ባ ዶርሳታፐ ይን ኮየይሳዳ፥ ታኒ ታ ዶርሳታ ኮያና፤ ሻርነ ም ጎዝዳ ጋላስ ኤንቲ ይዳ በሳፈ ታ ኤንታ ሺሻና። <verse eid="EZK 34:12"/><verse number="13" style="v" sid="EZK 34:13"/>ታኒ ካዎተታ ግዶፈነ ሀራ ቢታ ኡባፈ ሺሻዳ፥ ኤንታና፥ ኤንታ ቢታ ኤሀና። እስራኤለ ደረታን፥ ፑልቶታንነ አሳይ ደእያ በሳታን ኤንታ ሄማና። <verse eid="EZK 34:13"/><verse number="14" style="v" sid="EZK 34:14"/>ታኒ ኤንታ ሎኦ ቆሮን ሄማና፤ እስራኤለ ዙማት ኤንቲ ሄመትያ በሰ ግዳና። ኤንቲ ሎኦ ቆሮይ ደእያ እስራኤለ ዙማታ ቦላ ሄመታናነ አላታና። <verse eid="EZK 34:14"/><verse number="15" style="v" sid="EZK 34:15"/>ታኒ ታ ሁጰን ታ ዶርሳታ ሄማናነ ሸምፕሳና። <verse eid="EZK 34:15"/><verse number="16" style="v" sid="EZK 34:16"/>ታኒ ይዳይሳ ኮያና፤ በትዳይሳ ዛራና፤ መቅዳይሳ ኮላና፤ ሀርግዳይሳ ፓና። ሽን ታኒ ሱረ ፕርድያ ሄንንቾ ግድያ ግሾ ገነን ሞዳይሳነ ምንዳይሳ ይሳና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 34:17"/>ህንተኖ፥ ታ ዶርሳቶ፥ “ህንተና ኡባ ታ ፕርዳና፤ ኬሀ ኢታፐ፥ ዶርሳ ዴሻፐ ታ ሻካና። <verse eid="EZK 34:17"/><verse number="18" style="v" sid="EZK 34:18"/>ህንተ ሎኦ ቆሮን ሄመተይስ ግዶና እፅን፥ አትዳ ማታ ቶሆን የቲ? ቃስ ህንተ ፅሎ ሃ ኡየይስ ግዶና እፅን፥ አትዳ ሃ ቶሆን ቡሎየቲ? <verse eid="EZK 34:18"/><verse number="19" style="v" sid="EZK 34:19"/>ታ ዶርሳት ህንተ ቶሆን የዳ ማታ ማናዉነ ህንተ ቶሆን ቡሎይዳ ሃ ኡያናዉ በሲ?” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 34:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 34:20"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ኤንታኮ ሀይሳዳ ያጌስ፦ “ሞ መህያ ግዶንነ ግልቃ መህያ ግዶን ታ ታ ሁጰን ፕርዳና። <verse eid="EZK 34:20"/><verse number="21" style="v" sid="EZK 34:21"/>ዳቡራንቾታ፥ ህንተ፥ ህንተ ምያነ ህንተ ሀሽያን ሱግያ ግሾነ ጋፃ ከሳና ጋካናዉ ህንተ ኤንታ ህንተ ካጭያን ቃይጭያ ግሾ፥ <verse eid="EZK 34:21"/><verse number="22" style="v" sid="EZK 34:22"/>ታኒ ታ ዶርሳታ አሻና። ህዛፐ ጉየ ኦንካ ኤንታ ኦይከና፤ ታ ኬሀ ዶርሳታ ግዶንነ ኢታ ዶርሳታ ግዶን ታ ፕርዳና። <verse eid="EZK 34:22"/><verse number="23" style="v" sid="EZK 34:23"/>ታ ኤንታ ቦላ እስ ሄንንቹዋ፥ ታ አይልያ ዳዊታ ሹማና፤ እ ኤንታ ሄማናነ ኤንታዉ ሄንንቾ ግዳና። <verse eid="EZK 34:23"/><verse number="24" style="v" sid="EZK 34:24"/>ህዛፐ ጉየ ታ ጎዳይ ኤንታ ፆሳ ግዳና፤ ታ አይለይ ዳዊቲ ኤንታ ግዶን ሀላቃ ግዳና” ያጌስ ጎዳይ።<verse eid="EZK 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 34:25"/>“ታ ኤንታራ ሳሮተ ጫቆ ጫቃና፤ ኢታ ዶአታ ታኒ ቢታፈ ድጋና፤ ታ ዶርሳት ባዞን ሳሮ ዳና፤ ዎራ ጋርሳን ህርግ ባይና አላታና። <verse eid="EZK 34:25"/><verse number="26" style="v" sid="EZK 34:26"/>ታ ኤንታነ ታ ዙማ ዩሾን ደእያ በሳታ አንጃና። ኤንታዉ ኮሽያ እራ ዎደን ዎደን እማና፤ ሄ እራይ ኤንታዉ አንጆ ግዳና። <verse eid="EZK 34:26"/><verse number="27" style="v" sid="EZK 34:27"/>ጋደን ደእያ ምት አይፋና፤ ቢታይ ካ ዶልሳና፤ ኡባይ ባንታ ቢታን ሳሮ ዳና። ታ ኤንታ ቃምባራ መንዳ፥ ኤንታ አይለ ኦድ ሃርዳይሳታ ኩሸፐ ከስያ ዎደ ታኒ ጎዳ ግደይሳ ኤንቲ ኤራና። <verse eid="EZK 34:27"/><verse number="28" style="v" sid="EZK 34:28"/>ሀራ ካዎተት ኤንታ ቦንቆኮና፤ ቢታን ደእያ ዶአት ኤንታ ሞኮና፤ አይኮይካ ዳጋንና ኤንቲ ሳሮ ዳና። <verse eid="EZK 34:28"/><verse number="29" style="v" sid="EZK 34:29"/>ታ ኤንታዉ አራዳ ቢታ እማና፤ ኤንቲ ዛሪድ ኮሻን ዉሮኮና፤ ዎይኮ ሀራ ካዎተታስ ጫሻስ አቶኮና። <verse eid="EZK 34:29"/><verse number="30" style="v" sid="EZK 34:30"/>ሄ ዎደ ኤንቲ ታኒ ጎዳይ፥ ኤንታ ፆሳይ ኤንታራ ደኤይሳነ እስራኤለ አሳይ ታ አሰ ግደይሳ ኤንቲ ኤራና። <verse eid="EZK 34:30"/><verse number="31" style="v" sid="EZK 34:31"/>ህንተኖ፥ እስራኤለ አሳዉ፥ ህንተ ታ ዉደ፤ ታ ቆሮን ምያ ታ ዉድያ፤ ህንተ ታ አሰ፥ ታኒ ህንተ ፆሳ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 34:31"/></para>
  <chapter eid="EZK 34"/>
  <chapter number="35" style="c" sid="EZK 35"/>
  <para style="s1">ኤዶመ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 35:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 35:1"/><verse number="2" style="v" sid="EZK 35:2"/>“አሳ ናአዉ፥ ሳይረ ዙማኮ ነ ሶምኡዋ ዛራዳ ትንብተ ኦዳ፦ <verse eid="EZK 35:2"/><verse number="3" style="v" sid="EZK 35:3"/>‘ነኖ፥ ሳይረ ዙማዉ፥ ታ ነዉ ሞርከ ግዳና፤ ታኒ ታ ኩሽያ ነ ቦላ ደንዳ፥ ነና ካሎነ ባይሳ ከሳና። <verse eid="EZK 35:3"/><verse number="4" style="v" sid="EZK 35:4"/>ታኒ ነ ካታማታ ላላና፤ ነ ባይሳ ግዳና። ታኒ ጎዳ ግደይሳ ነ ሄ ዎደ ኤራና’ ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 35:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 35:5"/>ነዉ እስራኤለራ ዉሮና ሞርከተ ደእያ ግሾ፥ ኤንታ ኡንኣ ዎደነ ኤንታ ዉርሰ ፕርዳ ዎደ፥ ኤንታ ነ ማሻስ አዳ እማዳሳ። <verse eid="EZK 35:5"/><verse number="6" style="v" sid="EZK 35:6"/>ታ ኡባ ሃርያ ጎዳይ ታ ደኡዋን ጫቃይስ፦ ታኒ ነና ሀይቆን ፕርዳና፤ ነ ሀይቆፐ ከሳ ኤካናዉ ዳንዳአካ። ነ አሰ ዎ እፆና ግሾ አሰ ዎይ ነና ካላና። <verse eid="EZK 35:6"/><verse number="7" style="v" sid="EZK 35:7"/>ታኒ ሳይረ ዙማ ካሎነ ባይሳ ከሳና፤ ያራ ኦንካ አና መላ ኦና። <verse eid="EZK 35:7"/><verse number="8" style="v" sid="EZK 35:8"/>ታኒ ነ ደረታ ኡባ አሀን ኩንና፤ ደረት፥ ሻፋትነ ዛንጋራት ማሻን ሀይቅዳይሳታ አሀን ካመታና። <verse eid="EZK 35:8"/><verse number="9" style="v" sid="EZK 35:9"/>ታ ነና መርናዉ ባይሳ ኦና፤ ነ ካታማት ካሎ አታና፤ ታኒ ጎዳ ግደይሳ ህንተ ሄ ዎደ ኤራና።<verse eid="EZK 35:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 35:10"/>“ታኒ ጎዳይ እስራኤለንነ ይሁዳን ደእሽን ህንተ፥ ‘ሀ ናምኡ ካዎተታነ ሀ ናምኡ ቢታታ ኑ ኦይካና፤ ኤንቲ ኑባ ግዳና ግዳ ግሾ፥ <verse eid="EZK 35:10"/><verse number="11" style="v" sid="EZK 35:11"/>ህንተ ኤንታ ሞርክድ፥ ኤንታ ቦላ ይሎትዳ ግሾነ ቃናትዳ ግሾ ታ ህንተና ሴራና። ታ ህንተና ፕርድያ ዎደ ታኒ ታና ግደይሳ ህንተና ኤርሳና።’ <verse eid="EZK 35:11"/><verse number="12" style="v" sid="EZK 35:12"/>ህንተ፥ ‘እስራኤለ ደረት ባይሳ አትዶሶና፤ ኑኒ ምድ ይሳና መላ ኑስ እመትዶሶና’ ግድ፥ ጫይዳ ጫሻ ኡባ ታኒ ጎዳይ ስእዳይሳ ህንተ ሄ ዎደ ኤራና። <verse eid="EZK 35:12"/><verse number="13" style="v" sid="EZK 35:13"/>ነ ታ ቦላ ኦቶሮን ኦደትዳ ኦዳነ ዛው ባይና ሃሳይዳ ሃሳያ ታኒ ስአስ። <verse eid="EZK 35:13"/><verse number="14" style="v" sid="EZK 35:14"/>ቢታ ኡባይ ኡፋይትያ ዎደ ታኒ ህንተና ባይሳ ከሳና። <verse eid="EZK 35:14"/><verse number="15" style="v" sid="EZK 35:15"/>እስራኤለ ላታ ቢታይ ባይሳ ግድዳ ዎደ ህንተ ኡፋይትዳ ግሾ፥ ሳይረ ዙማዉ ኤዶመ ቢታ ኡባ ታኒ ባይሳ ኦና። ታኒ ጎዳ ግደይሳ ህንተ ሄ ዎደ ኤራና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 35:15"/></para>
  <chapter eid="EZK 35"/>
  <chapter number="36" style="c" sid="EZK 36"/>
  <para style="s1">እስራኤለ ዙማታስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 36:1"/>“አሳ ናአዉ፥ እስራኤለ ዙማታ ሀይሳዳ ያጋዳ ትንብተ ኦዳ፦ ‘ህንተኖ፥ እስራኤለ ዙማቶ፥ ጎዳ ቃላ ስእተ።’ <verse eid="EZK 36:1"/><verse number="2" style="v" sid="EZK 36:2"/>ህንተ ሞርከት፥ ‘ሀሹ! በን ቃ ደረት ኡባይ ኑ ላታ ግድዶሶና’ ያግዶሶና። <verse eid="EZK 36:2"/><verse number="3" style="v" sid="EZK 36:3"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ትንብተ ኦዳ። ኤንቲ ህንተና ኡባ በሳራ መንረድ ባይሳ ኦዳ ግሾነ ህንተ ሀራ ካዎተታን ሃረታና መላ ኦዳ ግሾ ህንተና ጫሻስነ ሚቻስ አግስ። <verse eid="EZK 36:3"/><verse number="4" style="v" sid="EZK 36:4"/>ጎዳ ቃላ ስእተ! ኡባ ሃርያ ጎዳይ ደረታኮ፥ ዙማታኮ፥ ዛንጋራታኮ፥ ኦላታኮ፥ ዩሹዋን ደእያ ሀራ ካዎተን ቦንቀትዳ፥ ቀልቅሰትዳነ ባይሳ አትዳ ካታማታኮ ሀይሳዳ ያጌስ። <verse eid="EZK 36:4"/><verse number="5" style="v" sid="EZK 36:5"/>ታኒ፥ ታ ኤፅያ ቃናትያን ሀራ ካዎተታ ቦላነ ኤዶመ ኡባ ቦላ ቱማ ኦዳስ። ኤንቲ ኡፋይትሸነ ካሸ ታ ቢታ ባንታዉ ኤክዶሶና፤ ሄን ጋደታ ላትዶሶና። <verse eid="EZK 36:5"/><verse number="6" style="v" sid="EZK 36:6"/>ሄሳ ግሾ፥ እስራኤለ ቢታ ቦላ ትንብተ ኦዳ። ካዎተታ ጫሻ ግሾ፥ ታ ቃናተን ኤፃዳ ደረታስ፥ ዙማታስ፥ ዛንጋራትስነ ኦላታስ ኦደይሳ ኦዳ። <verse eid="EZK 36:6"/><verse number="7" style="v" sid="EZK 36:7"/>ህንተ ዩሹዋን ደእያ ካዎተት ኡባይ ካዉያናይሳ ታኒ ኡባ ሃርያ ጎዳይ ህንተዉ ታ ኩሽያ ደንዳ ጫቃዳ ኦዳይስ።<verse eid="EZK 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 36:8"/>“ሽን፥ እስራኤለ ደረታ ቦላ ደእያ ምት ታ አሳ እስራኤለስ ዛሪድ አጫና፤ አይፈ አይፋና፤ ኤንቲ ኤሶን ባንታ ቢታ ስማና። <verse eid="EZK 36:8"/><verse number="9" style="v" sid="EZK 36:9"/>ታ ህንተራ ደአይስ፤ ታ ህንተኮ ስማና፤ ህንተ ቢታይ ጎየታናነ ዘረታና። <verse eid="EZK 36:9"/><verse number="10" style="v" sid="EZK 36:10"/>ታ እስራኤለ አሳ ታይቡዋ ሀ ቢታን ዳርሳና፤ አሳይ ካታማታን ዳና፤ ላለትዳ በሳት ዛሪድ ግምበታና። <verse eid="EZK 36:10"/><verse number="11" style="v" sid="EZK 36:11"/>ታኒ አሳነ መህያ ህንተዉ ዳርሳና፤ ኤንቲ የለታናነ ዳራና። በን ህንተ ደእዳይሳዳ ዳና፤ ካሰይሳፈ አዳ ታ ህንተና ዱረያና። ሄ ዎደ ህንተ፥ ታኒ ጎዳ ግደይሳ ኤራና። <verse eid="EZK 36:11"/><verse number="12" style="v" sid="EZK 36:12"/>ታኒ ታ አሳ እስራኤለ፥ ሀ ቢታን ዛሪድ ዳና መላ ኦና። ዛሪድ ሄ ቢታይ ህንተ ናይታ ይሰና፤ ቢታይ ህንተ ላታ ቢታ ግዳና” ያጌስ።<verse eid="EZK 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 36:13"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ አሳይ ህንተና፥ “ቢታይ አሰ ምያ ቢታ” ካዎተውካ፥ “ናእ ባይና አስ ኦሱ” ያገይስ ቱማ። <verse eid="EZK 36:13"/><verse number="14" style="v" sid="EZK 36:14"/>ህዛፐ ጉየ፥ ቢታይ፥ “አሰ ምያ ቢታ” ግዱኩ፤ ቃስ ካዎተት፥ “ናእ ባይና አስ ግዶኮና” ያጌስ ኡባ ሃርያ ጎዳይ። <verse eid="EZK 36:14"/><verse number="15" style="v" sid="EZK 36:15"/>“ህዛፐ ጉየ፥ ካዎተታ ጫሻ ታ ህንተና ስስከ፤ ህዛፐ ጉየ ዬላተከታ፤ ሄ ቢታይ ህንተዉ በ ግዱኩ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 36:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 36:16"/>ዛሪድ፥ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 36:16"/><verse number="17" style="v" sid="EZK 36:17"/>“አሳ ናአዉ፥ እስራኤለ አሳይ ባንታ ቢታን ደእያ ዎደ፥ ባንታ ሀኖታንነ ባንታ ኦሱዋን ቢታ ቱንስዶሶና፤ ኤንታ ሀኖይ ታ ስንን ማጫሳ ኩሸ መቶ መላ። <verse eid="EZK 36:17"/><verse number="18" style="v" sid="EZK 36:18"/>ኤንቲ ቢታን ሱ ጉስዳ ግሾነ ባንታ ኤቃን ቢታ ቱንስዳ ግሾ ታ ሀንቁዋ ኤንታ ቦላ ጉሳስ። <verse eid="EZK 36:18"/><verse number="19" style="v" sid="EZK 36:19"/>ታኒ ኤንታ ካዎተታ ግዶን ላላስ፤ ቢታ ኡባን ዘራስ። ታኒ ኤንታ ሀኖታነ ኤንታ ኦሱዋ መላ ፕርዳስ። <verse eid="EZK 36:19"/><verse number="20" style="v" sid="EZK 36:20"/>ኤንቲ ብዳ በሰ ኡባን አሳይ ኤንታ፥ ‘ሀይሳቲ ጎዳ አሳታ፤ ኤንቲ እያ ቢታፈ ከይዳይሳታ’ ” ያግድ ታ ጌሻ ሱን ቱንሳና መላ ኦዶሶና። <verse eid="EZK 36:20"/><verse number="21" style="v" sid="EZK 36:21"/>ሽን እስራኤለ አሳይ ብዳ ካዎተታ ኡባን ቱንስዳ ታ ጌሻ ሱንይ ታና ቆፍሴስ።<verse eid="EZK 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 36:22"/>“ሄሳ ግሾ፥ ታኒ ኡባ ሃርያ ጎዳይ፥ እስራኤለ አሳስ ግያባ ኦዳ። ‘ህንተኖ፥ እስራኤለ አሳዉ፥ ታ ሄሳ ኦይ፥ ህንተ ብዳ ካዎተታ ግዶን ቱንስዳ ታ ጌሻ ሱን ግሾፐ አትሽን፥ ህንተ ግሾ ግደና። <verse eid="EZK 36:22"/><verse number="23" style="v" sid="EZK 36:23"/>ህንተ ቱንስዳ፥ ካዎተታ ግዶን ቱንዳ ታ ግታ ሱን ጌሻተ ታ በሳና። ኤንቲ ፄልሽን፥ ህንተ ባጋራ ታ ጌሻተ በሲያ ዎደ፥ ታኒ ጎዳ ግደይሳ ኤንቲ ኤራና’ ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 36:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 36:24"/>“ታኒ ህንተና ካዎተታ ግዶፈ ከሳና፤ ቢታ ኡባፈ ሺሻዳ ህንተ ቢታ ዛራዳ ኤሀና። <verse eid="EZK 36:24"/><verse number="25" style="v" sid="EZK 36:25"/>ታ ህንተ ቦላ ፅሎ ሃ ርጫና፤ ህንተካ ጌያና። ህንተና ህንተ ቱናተ ኡባፈነ ኤቃ ጎይኖ ኡባፈ ጌሻና። <verse eid="EZK 36:25"/><verse number="26" style="v" sid="EZK 36:26"/>ታ ህንተዉ ኦራ ዎዛና እማና፤ ኦራ አያና ህንተ ግዶን ዎና፤ ሹቻ ዎዛና ህንተፈ ከሳዳ፥ አሾ ዎዛና ህንተዉ እማና። <verse eid="EZK 36:26"/><verse number="27" style="v" sid="EZK 36:27"/>ታ አያና ህንተ ግዶን ዎና፤ ታ ዎጋነ ታ ህግያ ናጋና መላ ኦና። <verse eid="EZK 36:27"/><verse number="28" style="v" sid="EZK 36:28"/>ታ ህንተ ማይዛታስ እምዳ ቢታን ህንተ ዳና፤ ህንተ ታ አሰ ግዳና፤ ታካ ህንተ ፆሳ ግዳና። <verse eid="EZK 36:28"/><verse number="29" style="v" sid="EZK 36:29"/>ህንተ ቱና ኡባፈ ታ ህንተና አሻና፤ ካይ ህንተዉ ዳራና መላ ኦና፤ ዛራዳ ህንተ ቦላ ኮሻ ኤህከ። <verse eid="EZK 36:29"/><verse number="30" style="v" sid="EZK 36:30"/>ኮሻ ጋሶን ህንተ ካዎተታ ግዶን ካዉዮና መላ ህንተ ም አይፍያነ ህንተ ጎሻ ካን ኩንና። <verse eid="EZK 36:30"/><verse number="31" style="v" sid="EZK 36:31"/>ሄ ዎደ ህንተ፥ ህንተ ኢታ ሀኖታነ ኢታ ኦግያ ሀሳያና። ህንተ ናጋራነ ህንተ ቱና ኦሱዋ ግሾ፥ ህንተ ህንተና ሻተታና። <verse eid="EZK 36:31"/><verse number="32" style="v" sid="EZK 36:32"/>ታ ሄሳ ኡባ ኦይ ህንተ ግሾ ግዶናይሳ ኤርተ። ህንተኖ፥ እስራኤለ አሳዉ፥ ህንተ ሀኖታን ዬላትተነ ካዉይተ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 36:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 36:33"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታ ህንተና፥ ህንተ ናጋራ ኡባፈ ጌሽያ ዎደ፥ ህንተ ካታማታን ዛሪድ ዳና መላ ኦና፤ ላለትዳይሳት ዛሪድ ግምበታና። <verse eid="EZK 36:33"/><verse number="34" style="v" sid="EZK 36:34"/>እያ ማታራ አያ አሳ ስንን ባይሳ ግድድ ደእያ ቢታይ ጎሻ ቢታ ግዳና። <verse eid="EZK 36:34"/><verse number="35" style="v" sid="EZK 36:35"/>አሳይ፥ ‘ሀይስ ካሰ ባይሳ ግድዳ ቢታይ ሀእ ዋንድ ኤደነ ጋናተ ግድዴ? ካሰ ላለትዳ፥ አስ ዶናነ ባይሳ ካታማት ሀእ ዋንድ ዩሾይ ግምበትዳነ አስ ደእያ ካታማታ ግድዶና?’ ያጋና። <verse eid="EZK 36:35"/><verse number="36" style="v" sid="EZK 36:36"/>ሄ ዎደ ህንተ ዩሹዋን ደእያ አትዳ ካዎተት፥ ታኒ ላለትዳ ካታማታ ዛራዳ ኬፅዳይሳነ ባይሳ ቢታይ ዛሪድ ካ ዶላና መላ ኦዳይ ታና ጎዳ ግደይሳ ኤንቲ ኤራና። ታኒ ጎዳይ ሄሳ ኦዳስ፤ ታ ኦድዳይሳ ታ ኦና” ያጌስ።<verse eid="EZK 36:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 36:37"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ “እስራኤለ አሳይ እስ ቶሆ ታና ማዶ ኦይቻና መላ ኦና፤ ኤንታ ታይቡዋ ዉደዳ ዳርሳና። <verse eid="EZK 36:37"/><verse number="38" style="v" sid="EZK 36:38"/>ባኣለ ጋላስ ያርሾስ ይዳ ዉደ መሄን የሩሳላመይ ኩመይሳዳ፥ ላለትዳ ካታማታን አሰ ኩንና። ሄ ዎደ ኤንቲ ታኒ ጎዳ ግደይሳ ኤራና” ያግስ።<verse eid="EZK 36:38"/></para>
  <chapter eid="EZK 36"/>
  <chapter number="37" style="c" sid="EZK 37"/>
  <para style="s1">መልዳ መቀ ደእያ ዛንጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 37:1"/>ጎዳ ኩሸይ ታ ቦላ ደኤስ፤ እያ አያናይ ታና መቀ ኩምዳ ዛንጋራን ዎስ። <verse eid="EZK 37:1"/><verse number="2" style="v" sid="EZK 37:2"/>እ ታና ኤንታ ግዶን ያነ ሃነ ዩሽስ፤ ታ ህንች ግድ መልዳ ዳሮ መቀታ ዛንጋራ ግዶን በአስ። <verse eid="EZK 37:2"/><verse number="3" style="v" sid="EZK 37:3"/>እ፥ “አሳ ናአዉ፥ ሀ መቀት ዛሪድ፥ ሸምፖራ ዳናዉ ዳንዳኦና?” ያግስ።</para>
  <para style="p" vid="EZK 37:3">ታኒ፥ “ኡባ ሃርያ ጎዳዉ፥ ሀይሳ ነ ኤራሳ” ያጋስ።<verse eid="EZK 37:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 37:4"/>እ ታኮ፥ “ሀ መቀታስ ሀይሳዳ ያጋዳ ትንብተ ኦዳ፤ ህንተኖ፥ መልዳ መቀቶ፥ ጎዳ ቃላ ስእተ። <verse eid="EZK 37:4"/><verse number="5" style="v" sid="EZK 37:5"/>ኡባ ሃርያ ጎዳይ ሀ መቀታኮ ሀይሳዳ ያጌስ፦ ‘ታኒ ሸምፖ ህንተ ግዶ ገልሳና፤ ዛሪድ ህንተ ደኦን ዳና። <verse eid="EZK 37:5"/><verse number="6" style="v" sid="EZK 37:6"/>ታ ህንተ ቦላ ሻያ ዎና፤ ህንተና አሾ ማይዛና፤ ህንተና ጎጋን ካማና። ህንተ ደኦን ዳና መላ ታ ህንተ ግዶ ሸምፖ ገልሳና። ሄ ዎደ ህንተ ታኒ ጎዳ ግደይሳ ኤራና’ ” ያጌስ።<verse eid="EZK 37:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 37:7"/>እ ታና ኪትዳይሳዳ ትንብተ ኦዳስ፤ ታ ትንብተ ኦዶ ዶምያ ዎደ ግርስ ስኤትስ፤ መቀት ሺቅድ፥ ባ በሳን በሳን ኦይከትዶሶና። <verse eid="EZK 37:7"/><verse number="8" style="v" sid="EZK 37:8"/>ታ ፄልያ ዎደ፥ ኤንታ ቦላ ሻይ ደኤስ፤ አሾይ ኤንታ ቦላ በንትስ፤ ጋልባ ማእዶሶና፤ ሽን ሸምፖይ ኤንታ ግዶን ዴና።<verse eid="EZK 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 37:9"/>እ ታኮ፥ “አሳ ናአዉ፥ ጫርኩዋስ ትንብተ ኦዳ፤ ነኖ፥ ጫርኩዋዉ፥ ኦይዱ ባጋፈ ሃ ያ፤ ኤንቲ ደኦን ዳና መላ ሀ ሀይቅዳይሳታ ቦላ ሸምፖ ፑና” ያግስ። <verse eid="EZK 37:9"/><verse number="10" style="v" sid="EZK 37:10"/>እ ታና ኪትዳይሳዳ ትንብተ ኦዳስ፤ ሸምፖይ ኤንታ ግዶ ገልስ፤ ደኦ ደምዶሶና፤ ኤንቲ ዳሮ ኦላንቾ ግድድ ባንታ ቶሆን ኤቅዶሶና።<verse eid="EZK 37:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 37:11"/>እ ታኮ፥ “አሳ ናአዉ፥ ሀ መቀት እስራኤለ አሳ ሌምሶ፤ እስራኤለ አሳይ፥ ‘ኑ መቀት መልዶሶና፤ ኑ ኡፋይሳይ ይስ፤ ኑባይ ኩመ ሀልስ’ ያጎሶና። <verse eid="EZK 37:11"/><verse number="12" style="v" sid="EZK 37:12"/>ሄሳ ግሾ፥ ኤንታዉ ሀይሳዳ ያጋዳ ትንብተ ኦዳ፤ ‘ህንተኖ፥ ታ አሳዉ፥ ታኒ ህንተ ዱፉዋ ዶያና፤ ህንተና ያፐ ከሳና፤ ታ ህንተና ዛራዳ፥ እስራኤለ ቢታ ኤሀና። <verse eid="EZK 37:12"/><verse number="13" style="v" sid="EZK 37:13"/>ታ አሳዉ፥ ታ ህንተ ዱፉዋ ዶይያ ዎደነ ህንተና ከስያ ዎደ፥ ታ ጎዳ ግደይሳ ህንተ ኤራና። <verse eid="EZK 37:13"/><verse number="14" style="v" sid="EZK 37:14"/>ታኒ ታ አያና ህንተ ግዶን ዎና፤ ህንተ ደኦን ዳና። ታኒ ህንተና፥ ህንተ ቢታን ዎና። ሄ ዎደ ታኒ ጎዳይ ኦድዳይሳነ ኦዳይሳ ህንተ ኤራና’ ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 37:14"/></para>
  <para style="s1">እስ ዳረነ እስ ካዎ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 37:15"/>ዛሪድ ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ፦ <verse eid="EZK 37:15"/><verse number="16" style="v" sid="EZK 37:16"/>“አሳ ናአዉ፥ እስ ም ፃምአ ኤካዳ፥ እያ ቦላ፥ ‘ሀይስ ይሁዳስነ እያራ ደእያ እስራኤለ አሳሳ’ ያጋዳ ፃፋ። ቃስ ሀራ ፃምአ ኤካዳ፥ እያ ቦላ፥ ‘ሀይስ ኤፍሬማ፤ ዮሰፋነ እያራ ደእያ እስራኤለ አሳሳ’ ያጋዳ ፃፋ። <verse eid="EZK 37:16"/><verse number="17" style="v" sid="EZK 37:17"/>ሄሳፈ ጉየ፥ ኤንቲ ነ ኩሸን እስ ፃምአ ግዳና መላ ናምአ እስፈ ጋዳ ኦይካ። <verse eid="EZK 37:17"/><verse number="18" style="v" sid="EZK 37:18"/>ነ ቢታ አሳይ ኔኮ፥ ‘ሀይስ ነ ኦይስ አይቤ? ኑስ ብርሸ ኦዳ’ ያግድ ኦይችኮ፥ <verse eid="EZK 37:18"/><verse number="19" style="v" sid="EZK 37:19"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ፦ ታኒ ኤፍሬማ ኩሸን ደእያ ዮሰፋ ፃምአነ እያራ ደእያ እስራኤለ ኮቻታ ኤካናዉ ሀናይስ፤ ኤንታ ናምኣ እስ ፃምአ ኦናዉ፥ ይሁዳ ፃምአራ ጋና። ኤንቲ ናምአይ ታ ኩሸን እሶ ግዳና” ያጌስ ኡባ ሃርያ ጎዳይ ያጋዳ ኦዳ።<verse eid="EZK 37:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 37:20"/>“ሄ ነ ኤንታ ቦላ ፃፍዳ ናምኡ ፃምአታ ኤንታ ስንን ኦይካዳ፥ <verse eid="EZK 37:20"/><verse number="21" style="v" sid="EZK 37:21"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ። ታኒ እስራኤለ አሳ ኤንቲ ላለትዳ ካዎተታ ግዶፈ ከሳና፤ ታ ኤንታ ሺሻዳ፥ ኤንታ ቢታ ዛራዳ ኤሀና። <verse eid="EZK 37:21"/><verse number="22" style="v" sid="EZK 37:22"/>እስራኤለ ደረታ ቦላነ ኤንታ ቢታን ታ ኤንታ እስ ካዎተ ኦና፤ ኤንታ ኡባ ቦላ እስ ካዎ ካዎና። ቃስ ኤንቲ ዛሪድ ናምኡ ቢታ ግዶኮና፤ ናምኡ ካዎተ ግድድ ሻከቶኮና። <verse eid="EZK 37:22"/><verse number="23" style="v" sid="EZK 37:23"/>ህዛፐ ጉየ፥ ኤንቲ ባንታ ኤቃታን፥ ባንታ እፀትዳባታንነ ባንታ ናጋራ ኡባን ባንታና ቱንሶኮና። ታኒ ኤንታ ኩንድዳ በሳፈ ደንዳ ናጋራ ኡባፈ ጌሻና። ኤንቲ ታ አሰ ግዳና፤ ታካ ኤንታዉ ፆሰ ግዳና።<verse eid="EZK 37:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 37:24"/>“ታ አይለይ ዳዊቲ ኤንታዉ ካዎ ግዳና፤ ኤንታ ኡባስ እስ ሄንንቾ ፃላል ዳና። ኤንቲ ታ ህግያ ካላና፤ ታ ዎጋ ምንድ ናጋና። <verse eid="EZK 37:24"/><verse number="25" style="v" sid="EZK 37:25"/>ታኒ ታ አይልያ ያይቆባስ እምዳነ ኤንታ ማይዛት ደእዳ ቢታን ኤንቲ ዳና። ሄ ቢታን ኤንቲ፥ ኤንታ ናይትነ ኤንታ ናይታ ናይት መርናዉ ዳና፤ ታ አይለይ ዳዊቲ ኤንታ ቦላ መርናዉ ካዎ ግዳና። <verse eid="EZK 37:25"/><verse number="26" style="v" sid="EZK 37:26"/>ታ ኤንታራ ሳሮተ ጫቆ ጫቃና፤ ሄ ጫቆይ መርና ጫቆ ግዳና። ታኒ ኤንታ ምንዳ ኤሳና፤ ኤንታ ታይቡዋ ዳርሳና፤ ታ ኬ መርናዉ ኤንታ ግዶን ዎና። <verse eid="EZK 37:26"/><verse number="27" style="v" sid="EZK 37:27"/>ታኒ ያን ኤንታራ ዳና፤ ኤንታዉ ፆሰ ግዳና፤ ኤንቲ ታ አሰ ግዳና። <verse eid="EZK 37:27"/><verse number="28" style="v" sid="EZK 37:28"/>ፆሳ ኬይ ኤንታ ግዶን መርናዉ ደእያ ዎደ፥ እስራኤለ ጌሸይ ታን፥ ጎዳ ግደይሳ ካዎተት ኤራና” ያግስ።<verse eid="EZK 37:28"/></para>
  <chapter eid="EZK 37"/>
  <chapter number="38" style="c" sid="EZK 38"/>
  <para style="s1">ጎገ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 38:1"/>ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ። <verse eid="EZK 38:1"/><verse number="2" style="v" sid="EZK 38:2"/>“አሳ ናአዉ፥ ማጎገ ቢታን ደእያ ሞሳሀነ ቶቤላ አሳ ቦላ ዋና ሀላቃ ግድዳ ጎገ ቦላ ትንብተ ኦዳ። <verse eid="EZK 38:2"/><verse number="3" style="v" sid="EZK 38:3"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ። ሞሳሀነ ቶቤላ ዋና ሀላቃ ግድዳ ጎገ ታ ነ ቦላ ደንዳስ። <verse eid="EZK 38:3"/><verse number="4" style="v" sid="EZK 38:4"/>ታ ነና ጉየ ዛራና፤ ነ ስን ዳፎ አዳ፥ ነ ኦላንቾታራ፥ ነ ፓራታራ፥ ኦላ ሚሸ ማእዳ ነ ፓራ አሳታራ፥ ባንታ ማሻ ሌፍዳ፥ ግታነ ጉ ጎንዳለ ኦይክዳ አሳራ ነና ጎቻዳ ከሳና። <verse eid="EZK 38:4"/><verse number="5" style="v" sid="EZK 38:5"/>ፋርሰፈ፥ ቶጰፈነ ሊበፐ ይዳ አሳይ ጎንዳለ ኦይክድ፥ ሁጰን ብራታ ባርኔፃ ዎድ፥ ኤንታራ ግዳና። <verse eid="EZK 38:5"/><verse number="6" style="v" sid="EZK 38:6"/>ጎመርነ እያ ኦላንቾት ኡባይ፥ ፑደሀ ባጋን ደእያ ቤት-ቶርጋምነ እያ ኦላንቾት ኔራ ግዳና።<verse eid="EZK 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 38:7"/>“ነነ ኔኮ ሺቅዳ አሳ ኡባይ ደንድተ፤ ህንተና ጊግስተ፤ ነ ኤንታዉ ሀላቃ ግዳ። <verse eid="EZK 38:7"/><verse number="8" style="v" sid="EZK 38:8"/>ዳሮ ዎደፐ ጉየ፥ ነ ኦላስ ኮየታና፤ ስንፈ ያና ላይታን ዳሮ ዎደ ባይሳ ግድድ ደእዳ ቢታ፥ ኦላፐ ሸምፕዳ ቢታነ፥ እያን ደእያ አሳይ ዳሮ ካዎተታፐ እስራኤለ ደረታ ሺቅዳ ቢታ ኦላናዉ ነ ደንዳና። ኤንቲ ዳሮ ካዎተታፐ ሺቅዳይሳታነ ኡባይ ሀእ ሳሮ ደኤይሳታ። <verse eid="EZK 38:8"/><verse number="9" style="v" sid="EZK 38:9"/>ኔኒ፥ ነ ኦላንቾትነ ኔራ ደእያ ዳሮ ካዎተት ጎተዳ ደንዳና፤ ህንተ ሻራዳ ቢታ ካማና” ያጌስ።<verse eid="EZK 38:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 38:10"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ሄ ዎደ ቆፍ ነ ዎዛና ግዶ ይን፥ ነ ኢታባ ሀልቻና። <verse eid="EZK 38:10"/><verse number="11" style="v" sid="EZK 38:11"/>ኔኒ፥ ‘ታኒ ድረትቦና ጉታታ ኦላና፤ ዎፑ ግድ፥ ህርግ ባይና ደእያ አሳታ፥ ድርስ፥ ፐንገይ ዎይኮ ጎርደይ ባይና ካታማታ ታ ኦላና። <verse eid="EZK 38:11"/><verse number="12" style="v" sid="EZK 38:12"/>ታኒ ኤንታ ድአናነ ቦንቃና፤ ካሰ ባይሳ ግድዳ ቢታ ይድ ኡትዳ፥ ካዎተታ ግዶፈ ሺቅዳ፥ መሄነ ሚሸ ሃርዳ፥ ቢታስ ጉልአን ኡትዳ አሳ ቦላ ታ ኩሽያ ደንና’ ያጋና። <verse eid="EZK 38:12"/><verse number="13" style="v" sid="EZK 38:13"/>ሳባ አሳይነ ድዳና አሳይ ታርሰሳ ዛልአንቾትነ ናአተ ኦላንቾት ኡባይ፥ ‘ነ ቦንቃናዉ ያዲ? ነ ኦላንቾታ ድኦ ቶሳናዉ፥ ብራነ ዎርቃ ጋዝሳናዉ፥ መሄነ ሚሸ ኤካናዉነ ድኡዋ ቦንቃናዉ ዳሮ አስ ሺሻዲ?’ ” ያጋና።<verse eid="EZK 38:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 38:14"/>ሄሳ ግሾ፥ አሳ ናአዉ፥ ጎገ ቦላ ሀይሳዳ ያጋዳ ትንብተ ኦዳ። ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ሄ ዎደ፥ ታ አሳይ እስራኤለ ህርግ ባይና ደእያ ዎደ፥ ኔኒ አኬክኪ? <verse eid="EZK 38:14"/><verse number="15" style="v" sid="EZK 38:15"/>ኔኒ ደእያ ፑደሀ ባጋ ቢታፈ ያና። ነነ ኔራ ደእያ ዳሮ ካዎተት ፓራ ቶግድ፥ ምኖ ኦላንቾ ግድድ፥ ያና። <verse eid="EZK 38:15"/><verse number="16" style="v" sid="EZK 38:16"/>ቢታ ካምያ ሻራዳ፥ ነ ታ አሳ እስራኤለ ቦላ ያና። ጎገ ስንፈ ያና ዎድያን ታ ነና ታ ቢታ ቦላ ደንና። ሄሳ ታ ኦይ ካዎተት ታና ኤራና መላነ ታኒ ነ ባጋራ ኦያባይ ታ ጌሻተ ኤንታ ስንን በሳና መላሳ” ያጌስ።<verse eid="EZK 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 38:17"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታኒ ታ አይለ ግድዳ እስራኤለ ናበታ ባጋራ፥ ካሰ ዎደ ዛራ ዛራዳ እስራኤለን ትንብተ ኦዳስ። <verse eid="EZK 38:17"/><verse number="18" style="v" sid="EZK 38:18"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ ‘ጎገይ እስራኤለ ቦላ ደንድያ ዎደ ታ ሀንቆይ ሱላና። <verse eid="EZK 38:18"/><verse number="19" style="v" sid="EZK 38:19"/>ሄ ዎደ እስራኤለ ቢታን ዎልቃማ ቢታ ቃፆይ ሀናና፤ ታኒ ታ ሸንያንነ ታ ኤፅያ ሀንቁዋን አዋጃስ። <verse eid="EZK 38:19"/><verse number="20" style="v" sid="EZK 38:20"/>አባ ሞሎይ፥ ሳሎ ካፎይ፥ ደረን ደእያ መሄይነ ዶአይ፥ ሳአ ቦላ ዎፅ ቃፅያ መተ ኡባይነ ሳአን ደእያ አሳ ኡባይ ታ ስንን ኮኮራና። ደረት ኩንዳና፤ አፎት ዎዳና፤ ድርሳ ግምበ ኡባይ ላለታና። <verse eid="EZK 38:20"/><verse number="21" style="v" sid="EZK 38:21"/>ታ ዙማታን ኡባን ጎገ ቦላ ማሽ ደንዳና መላ ኦና፤ ኦላንቾት ባንታ ማሻ ባንታ ቦላ ዛሪድ፥ እሶይ እሱዋ ዎና። ታኒ ኡባ ሃርያ ጎዳይ ሀይሳ ኦዳስ። <verse eid="EZK 38:21"/><verse number="22" style="v" sid="EZK 38:22"/>ታኒ ሀርገንነ ሀይቆን እያ ሴራና፤ ዎልቃማ እራ፥ ሻች፥ ፁግያ ዲነ እያ ቦላ፥ እያ ኦላንቾታ ቦላነ እያራ ደእያ ካዎተታ ቦላ ቡክሳና። <verse eid="EZK 38:22"/><verse number="23" style="v" sid="EZK 38:23"/>ሄሳዳ ኦዳ፥ ታኒ ታ ግታተነ ታ ጌሻተ በሳና። ዳሮ ካዎተታ ታኒ ታናተ ኤርሳና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና’ ” ያግስ።<verse eid="EZK 38:23"/></para>
  <chapter eid="EZK 38"/>
  <chapter number="39" style="c" sid="EZK 39"/>
  <para style="p">
    <verse number="1" style="v" sid="EZK 39:1"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “አሳ ናአዉ፥ ጎገ ቦላ ሀይሳዳ ያጋዳ ትንብተ ኦዳ። ሞሳሀነ ቶቤላ አሳስ ዋና ሀላቃ ግድዳ ጎገ፥ ታ ነዉ ሞርከ። <verse eid="EZK 39:1"/><verse number="2" style="v" sid="EZK 39:2"/>ታ ነና ጉየ ዛራና፤ ሃሆ ግድዳ ፑደሀ ባጋ ቢታፈ ጎቻ ከሳዳ፥ እስራኤለ ደረታ ቦላ ነና ኤሀና። <verse eid="EZK 39:2"/><verse number="3" style="v" sid="EZK 39:3"/>ታኒ ነ ሀድርሳ ኩሽያፐ ዶንገታ ባቃ የጋና፥ ነ ኡሻቻ ኩሽያፐ ዶንገ ቶራታ የግሳና። <verse eid="EZK 39:3"/><verse number="4" style="v" sid="EZK 39:4"/>ኔኒ፥ ነ ኦላንቾትነ ኔራ ደእያ ካዎተት ኡባይ እስራኤለ ደርያ ቦላ ኩንድድ አታና። ታኒ ህንተ አሹዋ ካፎታስነ ባዞ ዶአታስ ካ ኦዳ እማና። <verse eid="EZK 39:4"/><verse number="5" style="v" sid="EZK 39:5"/>ታኒ ኡባ ሃርያ ጎዳይ ሄሳ ኦድዳ ግሾ፥ ህንተ ኡባይ ደንባን ኩንድድ አታና። <verse eid="EZK 39:5"/><verse number="6" style="v" sid="EZK 39:6"/>ማጎገ ቢታንነ ዩሾይ አባን ተቀትዳ ቢታታን፥ ህርግ ባይና ኡትዳ አሳ ቦላ ታኒ ኤፅያ ታማ የዳና። ታኒ ጎዳ ግደይሳ ኤንቲ ሄ ዎደ ኤራና። <verse eid="EZK 39:6"/><verse number="7" style="v" sid="EZK 39:7"/>ታ ጌሻ ሱንይ ታ አሳ እስራኤለ ግዶን ኤረታናዳ ኦና። ህዛፐ ጉየ ታ ጌሻ ሱንይ ጫየተና። ካዎተት ታኒ ጎዳ፥ እስራኤለ ጌሻ ግደይሳ ኤራና” ያግስ።<verse eid="EZK 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 39:8"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ሄ ጋላሳይ ያና፤ አተና” ያጋዳ ታ ኦድዳ ጋላሳይ ሀይሳ።<verse eid="EZK 39:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 39:9"/>“ሄ ዎደ እስራኤለ ካታማታን ደእያ አሳይ ከይድ፥ ኦላ ሚሸታ ኡባ ታማን ኤና፤ ሄስካ ጉነ ግታ ጎንዳለታ፥ ዶንገታ፥ ዶንገ ቶራ፥ ቶራታነ ፃምአታ ኡባ ፁጋና። ላፑን ላይ ኩመ ኤንቲ ኤሶ ም ኦድ ጎኤታና። <verse eid="EZK 39:9"/><verse number="10" style="v" sid="EZK 39:10"/>ኤንቲ ም ምፃናዉ ዎይኮ ዎራፐ ም ቃንፃናዉ ኮሸና። ኤንቲ ሺሽዳ ኦላ ሚሸታ ኤሶ ም ኦድ ጎኤታና። ባንታና ቦንቅዳይሳታ ዛሪድ ቦንቃና፤ ኤንታባ ኤክዳይሳታፐ ኤንቲ ዛሪድ ኤካና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 39:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 39:11"/>ሄ ጋላስ ጎገ ሞገትያ በሲ ታኒ እያዉ እስራኤለ ቢታን እማና። ሄ በሳይ አባፈ ዶሎሀ ባጋራ ደእያ ኦገ አሳታ ዛንጋራ ጌተትያ ዛንጋራ ግዶን ግዳና። ጎገይነ እያ ኦላንቾት ኡባይ ያን ሞገትያ ግሾ፥ ኤንታ ዱፎይ ያራ ሄመትያ አሳስ ኦገ ጎርዳና። ሄ በሳይ፥ “ጎገ ኦላንቾታ ዛንጋራ” ጌተትድ ፄገታና።<verse eid="EZK 39:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 39:12"/>“እስራኤለ አሳይ ቢታ ጌሻናዉ፥ ላፑን አጌና ኩመ አሀ ሞግሸ ጋምአና። <verse eid="EZK 39:12"/><verse number="13" style="v" sid="EZK 39:13"/>ሄ ቢታን ደእያ አሳ ኡባይ አሀ ሞጎን ማደታና፤ ሄሳን፥ ታኒ ታ ቦንቹዋ ቆንጭስያ ዎደ ኤንታዉ ቦንቾ ግዳና” ያጌስ ኡባ ሃርያ ጎዳይ። <verse eid="EZK 39:13"/><verse number="14" style="v" sid="EZK 39:14"/>ላፑን አጌናፐ ጉየ አትዳ አህ ደእኮ፥ ሞጋና መላ አስ ዶረታና፤ ሄ አሳይ ቢታይ ጌያና ጋካናዉ ኡባ ዎደ ቢታ ኡባን ዩይድ አትዳ አሀ ደምድ ሞጎሶና። <verse eid="EZK 39:14"/><verse number="15" style="v" sid="EZK 39:15"/>ኤንቲ ቢታን ዩይሽን፥ አሳ መቀ በንትኮ፥ ሄ መቀ ማታን ማላ ዎድ አና። ሞገይሳት ይድ፥ ጎገ ኦላንቾታ ዛንጋራን ሞጋና። <verse eid="EZK 39:15"/><verse number="16" style="v" sid="EZK 39:16"/>ሄ ካታማ ሱንይ ሀሞና ጌተታና። ኤንቲ ቢታ ዛሪድ ጌሻና። እያ ሄራን፥ “ኦላንቾታ ካታማ” ጌተትድ ፄገትያ ካታም ዳና።<verse eid="EZK 39:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 39:17"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “አሳ ናአዉ፥ ካፎ ኮቸነ ሳአ ዶአታስ ሀይሳዳ ያጋዳ ፄጋ። ታ ህንተዉ እስራኤለ ደረታ ቦላ ጊግስዳ ግታ ያርሾ ባለን አሾ ማናዉነ ሱ ኡያናዉ ኡባ በሳፈ ሺቅድ ሃይተ። <verse eid="EZK 39:17"/><verse number="18" style="v" sid="EZK 39:18"/>ህንተ ምኖ አሳታ አሹዋ ማና፤ ቢታ ሀላቃታ ሱ ኡያና። ኤንቲ ህንተዉ ባሳነ ሞ ኡርገ ዶርሳዳ፥ ማራዘዳ፥ ኮለዳነ ቦራ መላ ግዳና። <verse eid="EZK 39:18"/><verse number="19" style="v" sid="EZK 39:19"/>ታኒ ህንተዉ ጊግስዳ ያርሾ ባለን ህንተ ካላና ጋካናዉ፥ ሞ ማና፤ ማታና ጋካናዉ፥ ሱ ኡያና። <verse eid="EZK 39:19"/><verse number="20" style="v" sid="EZK 39:20"/>ታ ህንተዉ ጊግስያ ግብራፐ ፓራታ፥ ፓራ አሳታ፥ ምኖ ቶራ አሳታነ ሀራ ኦላንቾታ ኡባ አሹዋ ህንተ ካላና ጋካናዉ ማና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 39:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 39:21"/>“ታኒ ካዎተታ ግዶን ታ ቦንቹዋ ቆንጭሳና። ካዎተት ኡባይ ታ ኤንታ ፕርድዳ ፕርዳነ ታ ኤንታ ቦላ ደንዳ ታ ኩሽያ በአና። <verse eid="EZK 39:21"/><verse number="22" style="v" sid="EZK 39:22"/>ሄ ዎድያፐ ዶምድ፥ እስራኤለ አሳይ ታኒ ጎዳ፥ ኤንታ ፆሳ ግደይሳ ኤራና። <verse eid="EZK 39:22"/><verse number="23" style="v" sid="EZK 39:23"/>እስራኤለ አሳይ ድኤትድ ብዳይ ባንታ ናጋራ ጋሶን፥ ግደይሳ ሀራ ካዎተት ኤራና። ኤንቲ ታዉ አማነቶና እፅዳ ግሾ፥ ታኒ ታ ሶምኡዋ ኤንታፈ ደንዳ፥ ኤንታ ሞርከታስ ኤንታ አዳ እምን፥ ኤንቲ ኡባይ ኦላን ሀይቅዶሶና። <verse eid="EZK 39:23"/><verse number="24" style="v" sid="EZK 39:24"/>ኤንታ ቱናተነ ኤንታ ኢታተ መላ ኤንታዉ በሲያ ሴራ ሴራስ፤ ታ ሶምኡዋ ኤንታፈ ገንስ” ያግስ።<verse eid="EZK 39:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 39:25"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ። “ሀእ ታኒ ያይቆባ ኮቻታ ድኦፐ ዛራዳ ጋሽትሳና፤ እስራኤለ አሳ ኡባስ ቃታና። ታ ጌሻ ሱንስ ምሸታዳ ጫየቶና መላ ኦና። <verse eid="EZK 39:25"/><verse number="26" style="v" sid="EZK 39:26"/>ኤንታ ያሽያባይ ባይና፥ ባንታ ቢታን ሳሮ ዱሱ ዶምያ ዎደ ካሰ ባንታ ዬላነ ታዉ አማነቶና እፅዳይሳ ዶጋና። <verse eid="EZK 39:26"/><verse number="27" style="v" sid="EZK 39:27"/>ታኒ ኤንታ ካዎተታ ኡባ ግዶፈ ዛራዳ ኤሀና፤ ሞርከታ ቢታፈ ኤንታ ሺሻና። ሄሳዳ ኦዳ፥ ታኒ ጌሽ ግደይሳ ኤንታ ባጋራ ካዎተታ ኡባ በሳና። <verse eid="EZK 39:27"/><verse number="28" style="v" sid="EZK 39:28"/>ኤንቲ ድኤትድ ባና መላ ኦዳይ ታና ግድያ ግሾነ ኤንታ ሺሻዳ፥ ኤንታ ቢታ ዛርዳ ግሾ፥ ታኒ ጎዳ ኤንታ ፆሳ ግደይሳ ኤንቲ ኤራና። ታኒ ኤንታፈ እሱዋካ ካዎተታ ግዶን አግከ። <verse eid="EZK 39:28"/><verse number="29" style="v" sid="EZK 39:29"/>ታኒ ታ አያና እስራኤለ አሳ ቦላ ጉሳና፤ ዛራዳ ታ ሶምኡዋ ኤንታፈ ገንከ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 39:29"/></para>
  <chapter eid="EZK 39"/>
  <chapter number="40" style="c" sid="EZK 40"/>
  <para style="s1">ኦራ ፆሳ ኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 40:1"/>ኑኒ ድኤትዳ ላታማነ እቻሻን ላይን፥ የሩሳላመይ ፆነትዳ ታማነ ኦይዳን ላይን፥ ኮይሮ አጌናን፥ ታማን ጋላሳን ጎዳ ኩሸይ ታ ቦላ ደኤስ። እ ታና ደንድ የሩሳላመ ኤፍስ። <verse eid="EZK 40:1"/><verse number="2" style="v" sid="EZK 40:2"/>ፆሳይ ታና ቆንጨን እስራኤለ ቢታ ኤፍድ፥ እስ ዙማ ቦላ ኤስስ። ሄ ዙማፐ ዱገሀ ባጋራ ዳሮ ኬ ኬፀትዳ ካታማ ዳንያባ በአስ። <verse eid="EZK 40:2"/><verse number="3" style="v" sid="EZK 40:3"/>እ ታና ያ ኤፍን ታኒ ናሰ ብራታዳ ጶልያ እስ አድያ በአስ። ሄ ኡራይ ሊኖፐ ኦሰትዳ ዎዶሮነ ዋ ፃምአ ኦይክድ፥ ድርሳ ፐንግያ ማታን ኤቅስ። <verse eid="EZK 40:3"/><verse number="4" style="v" sid="EZK 40:4"/>እ ታኮ፥ “አሳ ናአዉ፥ ታ ነና ሀ በሳ ኤህዳይ ታ ነና በሲያባ ኡባ ነ ምን አኬካና መላሳ። ሄሳ ግሾ፥ ነ አይፍያን ፄላ፤ ነ ሀይን ስአ፤ ነ ዎዛናን ዎ። ነ በእያባ ኡባ እስራኤለ አሳስ ኦዳ” ያግስ።<verse eid="EZK 40:4"/></para>
  <para style="s1">ዶሎሀ ባጋ ፐንግያ</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 40:5"/>ታኒ ፆሳ ኬ ዩይ አዳ ድርሳ ግምብያ በአስ። ሄ አድያ ኩሸን ኡሱፑን ዋ አዱሰ ግድዳ ፃምእ ደኤስ። እስ አዱሳ ዋይ እስ ዋ ቦላ ኦይዱ ብራታ ጉጃ ግዴስ። ድርሳ ግምብያ ልክያ ዎደ ዳልጋተይ እስ ዋነ ታካ፤ ጎምፓይነ አዱሳተይ ኡሱፑን ዋ።<verse eid="EZK 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 40:6"/>ሄሳፈ ጉየ፥ ዶሎሀ ባጋራ ደእያ ድርሳ ፐንግያኮ ብስ። ደ ከይድ፥ ገልያ ፐንግያ ዋያ ዎደ ኡሱፑን ዋ ግድስ። <verse eid="EZK 40:6"/><verse number="7" style="v" sid="EZK 40:7"/>ያራ አያ ዎደ ኡሻቻራነ ሀድርሳራ ፐንገ ናገይሳት ኤቅያ ሄ ሄ ክፍለት ደኦሶና። እስ እስ ክፍለይ ኡሱፑን ዋ አዱሰነ ኡሱፑን ዋ ዳልጋ። ኤንታ ግዶን ደእያ ጎዳት እቻሹ ዋ ኦርደ። ፐንግያ ናገይሳታ ክፍለታፐ ያ ባጋራ፥ ፆሳ ኬኮ ስምዳ ኡሱፑን ዋ ባራንድ ደኤስ።<verse eid="EZK 40:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 40:8"/>ሄ ኡራይ ገልያ በሳ ባራንዳ ዋን፥ ሆስፑን ዋ ግድስ። <verse eid="EZK 40:8"/><verse number="9" style="v" sid="EZK 40:9"/>ፆሳ ኬኮ ስምዳ ፐንገይ ዉርሰን ደኤስ። ሄ ባራንዳ ቱቀታ ኦርደተይ ናምኡ ዋ። <verse eid="EZK 40:9"/><verse number="10" style="v" sid="EZK 40:10"/>ዶሎሀ ባጋ ፐንግያን ኡሻቻንነ ሀድርሳ ባጋን እስ ግና ግድዳ ሄ ናጎ ኬ ደኤስ።<verse eid="EZK 40:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 40:11"/>ሄ ኡራይ ድርሳ ፐንግያ ዋያ ዎደ ዳልጋተይ ታሙ ዋ፥ አዱሳተይ ታማነ ሄ ዋ። <verse eid="EZK 40:11"/><verse number="12" style="v" sid="EZK 40:12"/>እስ እስ ፐንገ ናገይሳታ ክፍልያ ስንን አዱሳተይ እስ ዋ፥ ዳልጋተይ እስ ዋ ግድዳ ጎድ ደኤስ፤ ናገይሳታ ክፍለት ናምኡ ባጋራ ኡሱፑን ኡሱፑን ዋ።<verse eid="EZK 40:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 40:13"/>ሀፍንን ደእያ ናገይሳታ ክፍለት ጉየ ባጋፈ ሄፍንን ደእያ ናገይሳታ ክፍለታ ጉየ ባጋ ጋካናዉ ደእያ በሳይ ላታማነ እቻሹ ዋ ግድስ። <verse eid="EZK 40:13"/><verse number="14" style="v" sid="EZK 40:14"/>ሄ ኡራይ ዳባባ ስንን ደእያ ዉርሰ ክፍልያ ዋን፥ ላታሙ ዋ ግድስ። <verse eid="EZK 40:14"/><verse number="15" style="v" sid="EZK 40:15"/>ፐንግያ ገልያ በሳፈ ብድ፥ ዉርሰን ደእያ እያ ባራንዳ ጋካናዉ ደእያ ፐንግያ አዱሳተይ እሻታሙ ዋ። <verse eid="EZK 40:15"/><verse number="16" style="v" sid="EZK 40:16"/>ክፍለታ ኡባስ ካረ ባጋ ስምዳ ጉ ማስኮተት ደኦሶና፤ ክፍለታፐ ግዶን ደእያ ጎዳታስ ማስኮተት ደኦሶና። ያነ ሃነ ሻክያ ጎዳታ ቦላ ዛምባ ምስለይ ደኤስ።<verse eid="EZK 40:16"/></para>
  <para style="s1">ካረ ዳባባ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 40:17"/>ሄ ኡራይ ታና ካረ ዳባባኮ ኤፍስ። ያን ታኒ ዳባባ ዩሾን ደእያ ሹች ሂፀትዳ ባሱዋነ ሄ ባሱዋ ኬፀትዳ ሀስታሙ ክፍለታ በአስ። <verse eid="EZK 40:17"/><verse number="18" style="v" sid="EZK 40:18"/>ሹቻይ ሂፀትዳ ባሶይ ዳባባ ዩሾ ኡባ ጋክስ፤ ካረ ዳባባይ ግዶ ዳባባፐ ዝቄስ። <verse eid="EZK 40:18"/><verse number="19" style="v" sid="EZK 40:19"/>ግዶ ዳባባ ጋያ፥ ቃን ኦሰትዳ፥ ድርሳ ፐንገይ ደኤስ። ሄ ኡራይ ናምኡ ፐንገታፐ ግዶን ደእያ በሳ ዋን፥ ጎምፓይ ዉሎሀ ባጋ ፄቱ ዋ ዶሎሀ ባጋይ ፄቱ ዋ ግድስ።<verse eid="EZK 40:19"/></para>
  <para style="s1">ፑደሀ ፐንግያ</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 40:20"/>ሄ ኡራይ ታና ቆሞ ባጋ ኤፍድ፥ ካረ ባጋ ዳባባ ስንን ደእያ ድርሳ ፐንግያ ዋስ። <verse eid="EZK 40:20"/><verse number="21" style="v" sid="EZK 40:21"/>ዉሎሀፐ ኡሻቻንነ ሀድርሳ ባጋራ ደእያ ሄ ናገይሳታ ክፍለት፥ ኤንታፈ ግዶን ደእያ ጎዳትነ እያ ባራንዳይ ኮይሮ ዶሎሀ ፐንግያ ባጋን ዋን እስ ግና ግድዶሶና። ድርሳ ፐንገ አዱሳተይ እቻሹ ዋ፤ ዳልጋተይ ላታማነ እቻሹ ዋ። <verse eid="EZK 40:21"/><verse number="22" style="v" sid="EZK 40:22"/>ባራንዳይ፥ ማስኮተትነ ዛምባ ምስለይ ካሰ ዶሎሀ ፐንግያ ባጋን በእዳይሳዳ እስ ግና። ያ ጋያ ላፑን ደት ደኦሶና። ባራንዳይ ዳባባ ስን ባጋራ ደኤስ። <verse eid="EZK 40:22"/><verse number="23" style="v" sid="EZK 40:23"/>ዶሎሀ ባጋን፥ ቆሞ ባጋ ግዶ ዳባባስ ሀራ ፐንገይ ደኤስ። ሄ ኡራይ ሀ ናምኡ ድርሳ ፐንገታፐ ግዶን ደእያ በሳ ዋን፥ ፄቱ ዋ ግድስ።<verse eid="EZK 40:23"/></para>
  <para style="s1">ዱገሀ ፐንግያ</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 40:24"/>ሄ ኡራይ ታና ጋርሳ ባጋ ድርሳ ፐንግያኮ ካለን፥ ያን ሀራ ድርሳ ፐንገ በአስ። እ ቱቀታነ ግዶ ክፍለታ ዋያ ዎደ ሀራታራ ግና ግድስ። <verse eid="EZK 40:24"/><verse number="25" style="v" sid="EZK 40:25"/>ሄ ድርሳ ፐንግያ ማታን ደእያ ክፍለታ ኡባስ ማስኮተት ደኦሶና። ድርሳ ፐንግያ አዱሳተይ እሻታሙ ዋ፤ ዳልጋተይ ላታማነ እቻሹ ዋ። <verse eid="EZK 40:25"/><verse number="26" style="v" sid="EZK 40:26"/>ያ ጋያ ላፑን ደት ደኦሶና። ባራንዳይ ዳባባ ስንን ደኤስ። ፐንግያ ቦላ ያ ባጋራነ ሀ ባጋራ ዛምባ ምስለይ ደኤስ። <verse eid="EZK 40:26"/><verse number="27" style="v" sid="EZK 40:27"/>ግዶ ዳባባስ ሀራ ፐንገይ ደኤስ። ሄ ኡራይ ሀ ናምኡ ድርሳ ፐንገታፐ ግዶን ደእያ በሳ ዋን፥ ፄቱ ዋ ግድስ።<verse eid="EZK 40:27"/></para>
  <para style="s1">ግዶ ዳባባ ገልስያ ፐንገታ</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 40:28"/>ሄ ኡራይ ታና ጋርሳ ድርሳ ፐንግያ ባጋራ ግዶ ዳባባኮ ኤፍስ። እ ድርሳ ፐንግያ ዋን፥ ሀራ ፐንገታራ ግና ግድስ። <verse eid="EZK 40:28"/><verse number="29" style="v" sid="EZK 40:29"/>ናገይሳታ ክፍለት፥ ጎዳትነ ባራንዳት ኡባይ ሀራ ድርሳ ፐንገታራ እስ ግና። ሄ ድርሳ ፐንግያ ዩሾን ደእያ ክፍለታ ኡባስ ማስኮተት ደኦሶና። ሀ ፐንግያ አዱሳተይ እሻታሙ ዋ፤ ጎምፓይ ላታማነ እቻሹ ዋ። <verse eid="EZK 40:29"/><verse number="30" style="v" sid="EZK 40:30"/>ሄ ድርሳ ፐንገይ ዩሹዋን ባራንዳት ደኦሶና፤ ኤንታ አዱሳተይ ላታማነ እቻሹ ዋ፤ ጎምፓይ እቻሹ ዋ። <verse eid="EZK 40:30"/><verse number="31" style="v" sid="EZK 40:31"/>ሄ ባራንዳት ካረ ባጋ ዳባባ ስንን ደኦሶና። ፐንግያ ቦላ ያ ባጋራነ ሀ ባጋራ ዛምባ ምስለይ ደኤስ። ያ ጋያ ሆስፑን ደት ደኦሶና።<verse eid="EZK 40:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 40:32"/>ሄ ኡራይ ታና ዶሎሀ ባጋ ድርሳ ፐንግያራ ግዶ ዳባባኮ ኤፍስ። እ ሄ ድርሳ ፐንግያ ዋን፥ ሀራ ፐንገታራ ግና ግድስ። <verse eid="EZK 40:32"/><verse number="33" style="v" sid="EZK 40:33"/>ናገይሳታ ክፍለት፥ ጎዳትነ ባራንዳይ ሀንኮ ድርሳ ፐንገታራ እስ ግና። ሄ ድርሳ ፐንግያ ዩሾን ደእያ ክፍለታ ኡባስ ማስኮተት ደኦሶና። ሄ ፐንግያ አዱሳተይ እሻታሙ ዋ፤ ጎምፓይ ላታማነ እቻሹ ዋ። <verse eid="EZK 40:33"/><verse number="34" style="v" sid="EZK 40:34"/>ባራንዳይ ካረ ባጋ ዳባባ ስንን ደኤስ። ፐንግያ ቦላ ያ ባጋራነ ሀ ባጋራ ዛምባ ምስለይ ደኤስ። ያ ጋያ ሆስፑን ደት ደኦሶና።<verse eid="EZK 40:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 40:35"/>ሄ ኡራይ ታና ፑደሀ ባጋ ድርሳ ፐንግያኮ ኤፍስ። እ ሄ ድርሳ ፐንግያ ዋን፥ ሀንኮ ፐንገታራ እስ ግና ግድስ። <verse eid="EZK 40:35"/><verse number="36" style="v" sid="EZK 40:36"/>ናገይሳታ ክፍለት፥ ጎዳትነ ባራንዳይ ሀንኮ ድርሳ ፐንገታራ እስ ግና። ሄ ድርሳ ፐንግያ ዩሾን ማስኮተት ደኦሶና። ሄ ፐንግያ አዱሳተይ እሻታሙ ዋ፤ ጎምፓይ ላታማነ እቻሹ ዋ። <verse eid="EZK 40:36"/><verse number="37" style="v" sid="EZK 40:37"/>ባራንዳይ ካረ ባጋ ዳባባ ስንን ደኤስ። ፐንግያ ቦላ ያ ባጋራነ ሀ ባጋራ ዛምባ ምስለይ ደኤስ። ያ ጋያ ሆስፑን ደት ደኦሶና።<verse eid="EZK 40:37"/></para>
  <para style="s1">ፑደሀ ፐንግያ ማታን ደእያ ኬታ</para>
  <para style="p">
    <verse number="38" style="v" sid="EZK 40:38"/>ካረ ዳባባ ቆሞ ባጋራ፥ ግዶ ድርሳ ፐንግያ ባራንዳራ ኦይከትድ፥ ሀራ ክፍለይ ደኤስ። ፁሳ ያርሾ ኤህያ መሄ አሾይ ሜጨተይ ሄ ክፍልያና። <verse eid="EZK 40:38"/><verse number="39" style="v" sid="EZK 40:39"/>ሄ ባራንዳን ሀ ባጋራ ናምኡ ፃርጴዛት፥ ያ ባጋራ ናምኡ ፃርጴዛት ደኦሶና፤ ፁሳ ያርሾስ፥ ናጋራ ያርሾስነ ናቆ ያርሾስ መሄ ኡባይ ሹከትያ ሄ ፃርጴዛታ ቦላና። <verse eid="EZK 40:39"/><verse number="40" style="v" sid="EZK 40:40"/>ባራንዳፈ ካረ ባጋራ ቆሞ ድርሳ ፐንግያ ማታን ናምኡ ፃርጴዛት ሀ ባጋራ፥ ናምኡ ፃርጴዛት ያ ባጋራ ደኦሶና። <verse eid="EZK 40:40"/><verse number="41" style="v" sid="EZK 40:41"/>ሄሳ ግሾ፥ ያርሾስ ሺቅዳ መሄይ ሹከትያ ሆስፑን ፃርጴዛት ደኦሶና፤ ኤንታፈ ኦይዳት ባራንዳን ደኦሶና፤ ኦይዳት ካረ ዳባባን ደኦሶና። <verse eid="EZK 40:41"/><verse number="42" style="v" sid="EZK 40:42"/>ፁሳ ያርሾ ዎናዉ ጊግስዳ፥ ሹቻፈ ማሰትድ ኦሰትዳ ኦይዱ ፃርጴዛት ደኦሶና። ኤንታዉ አዱሳተይ እስ ዋነ ታካ፤ እስ ዋነ ታካ፤ ዳልጋተይ እስ ዋነ ታካ። ፁሳ ያርሾነ ሀራ ያርሾ ኡባ ሹክያ ሚሸት ሄ ፃርጴዛታ ቦላ ኡቶሶና። <verse eid="EZK 40:42"/><verse number="43" style="v" sid="EZK 40:43"/>ኦይዱ ብራ አዱቅያ ካቆታ ጎዳ ቦላ ዩይ አድ ሸትድ ኡትዶሶና። ያርሾስ ሺሽያ አሾ ኡባይ ሄ ፃርጴዛታ ቦላ ኡቴስ።<verse eid="EZK 40:43"/></para>
  <para style="s1">ካህነታ ክፍለታ</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 40:44"/>ሄ ኡራይ ታና ግዶ ዳባባ ገልስስ። ያን ፐንገት ግዶ ዳባባኮ ዶየትያ ናምኡ ክፍለት ደኦሶና። ኤንታፈ እስ ክፍለይ ቆሞ ድርሳ ፐንግያ ማታራ ጋርሳ ባጋ ስምስ፤ ናምአንይ ጋርሳ ድርሳ ፐንግያ ማታራ ቆሞ ባጋ ስምስ። <verse eid="EZK 40:44"/><verse number="45" style="v" sid="EZK 40:45"/>ሄ ኡራይ፥ “ዱገሀ ባጋ ስምዳ ክፍለይ ፆሳ ኬን ኦያ ካህነታባ። <verse eid="EZK 40:45"/><verse number="46" style="v" sid="EZK 40:46"/>ቆሞ ባጋ ስምዳ ክፍለይ ያርሾ በሳን ኦያ ካህነታባ። ካህነት ኡባይ ሳዶቃ ያራፐ የለትዳ ሌወታ፤ ጎዳ ስንን ኤቅድ ኦናዉ በሰይሳት ሀይሳታ ፃላላ” ያግስ።<verse eid="EZK 40:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="EZK 40:47"/>ሄ ኡራይ ዳባባ ዋን፥ አዱሳተይ ፄቱ ዋ፥ ዳልጋተይ ፄቱ ዋ ግድስ። ዳባባን ፆሳ ኬፈ ስን ባጋራ እስ ያርሾ በሲ ደኤስ። <verse eid="EZK 40:47"/><verse number="48" style="v" sid="EZK 40:48"/>እ ታና ፆሳ ኬ ባራንዳኮ ኤፍስ። ባራንዳ ገልያ በሳን ኤቅዳ ጎባነታ ዋን፥ አዱሳተይ እቻሹ ዋ፤ ዳልጋተይ ታማነ ኦይዱ ዋ። ሀድርሳራነ ኡሻቻራ ደእያ ጎዳታ ኦርደተይ ሄ ዋ ግድስ። <verse eid="EZK 40:48"/><verse number="49" style="v" sid="EZK 40:49"/>ባራንዳ አዱሳተይ ላታሙ ዋ፤ ጎምፓይ ታሙ ዋ። ያ ጋያ ታሙ ደት ደኦሶና። ገልያ በሳን ኡሻቻራነ ሀድርሳራ ኤቅዳ ናምኡ ቱቀት ደኦሶና።<verse eid="EZK 40:49"/></para>
  <chapter eid="EZK 40"/>
  <chapter number="41" style="c" sid="EZK 41"/>
  <para style="p">
    <verse number="1" style="v" sid="EZK 41:1"/>ሄሳፈ ጉየ፥ ሄ ኡራይ ታና ፆሳ ኬን ደእያ ጌሻ በሳ ገልስስ። ሄ ጌሻ በሳ ግዶራ አያ ኦግያ ልክን ኡሱፑን ዋ ግድስ። <verse eid="EZK 41:1"/><verse number="2" style="v" sid="EZK 41:2"/>ጎምፓይ ታሙ ዋ ግድስ። ሀድርሳራነ ኡሻቻራ ደእያ ጎዳታ ጎምፓይ እቻሹ ዋ። እ ጌሻ በሳ ዋን አዱሳተይ ኦይታሙ ዋ፥ ጎምፓይ ላታሙ ዋ ግድስ።<verse eid="EZK 41:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 41:3"/>ሄሳፈ ጉየ፥ ቆልአ ገልስ። ቆልአ ገልያ ኦግያ ዋን፥ ናምኡ ዋ ግድስ፤ ጎምፓይ ኡሱፑን ዋ ግድስ፤ ሀድርሳራነ ኡሻቻራ ደእያ ጎዳታ ጎምፓይ ላፑን ዋ ግድስ። <verse eid="EZK 41:3"/><verse number="4" style="v" sid="EZK 41:4"/>እ ቆልአ ዋን፥ አዱሳተይ ላታሙ ዋ፥ ዳልጋተይ ላታሙ ዋ ግድስ። ሄሳፈ ጉየ፥ “ሀይስ ኡባፈ ጌሻ በሳ” ያግስ።<verse eid="EZK 41:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 41:5"/>ሄ ኡራይ ፆሳ ኬ ጎዳ ዋን፥ ኦርደተይ ኡሱፑን ዋ ግድስ። ሄ ጎዳራ ኦይከትድ፥ ፆሳ ኬ ግዶ ባጋ ዩሹዋን ኬፀትዳ ኦይዱ ኦይዱ ዋ ዳልግያ ዳሮ ክፍለት ደኦሶና። <verse eid="EZK 41:5"/><verse number="6" style="v" sid="EZK 41:6"/>ሄ ክፍለት እሶይ እሱዋ ቦላ ኬፀትዳ ሄ ፖቀ ግድን፥ እስ እስ ፖቅያ ቦላ ሀስታሙ ክፍለት ደኦሶና። ግምብያ ዩሾን ደእያ ክፍለታ ቶክያ ቱቀት ደኦሶና። ሽን ሄ ቱቀት ግምብያ ግዶ ኩመ ገልቦኮና። <verse eid="EZK 41:6"/><verse number="7" style="v" sid="EZK 41:7"/>ፆሳ ኬ ዩሾን ደእያ ክፍለታ ዳልጋተይ ፖቀይ ጉጅያ ዎደ ጉጄስ። ፆሳ ኬ ዩሾን ደእያ ኬ ኦሶይ ጋርሳፈ ፑደ ዳልግሸ ብያ ግሾ ኬይ ፑደ ጉዠትዳ ዎደ ኡባን ክፍለታ ዳልጋተይ ጉጅሸ ቤስ። ግዶ ፖቅያራ ካንድ፥ ቆሞ ዉርሰ ፖቅያ ጋካናዉ ኤፍያ ደት ደኦሶና።<verse eid="EZK 41:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 41:8"/>ፆሳ ኬ ዩሾን ቁ ግዳ ባሶይ ደኤይሳ በአስ። እያ ዩሹዋን ደእያ ክፍለት ሄ ባሱዋ ቦላ ኬፀትዶሶና፤ ሄ ባሶይ ግዶ ዳባባፐ ኡሱፑን ዋ ቄስ። <verse eid="EZK 41:8"/><verse number="9" style="v" sid="EZK 41:9"/>ሄ ክፍለታ ካረ ባጋ ጎዳ ኦርደተይ እቻሹ ዋ። ካይሳ በሳይ ፆሳ ኬፈነ፥ <verse eid="EZK 41:9"/><verse number="10" style="v" sid="EZK 41:10"/>ካህነታ ክፍልያፐ ግዶን ደኤስ፤ እያ ኦርደተይ ላታሙ ዋ። <verse eid="EZK 41:10"/><verse number="11" style="v" sid="EZK 41:11"/>ካይሳ በሳፈ ኡሻቻንነ ሀድርሳ ባጋን ደእያ ክፍለታ ገልስያ ፐንገት ደኦሶና። ሄ ፐንገት እሶይ ቆሞ ባጋራ፥ እሶይ ቃስ ጋርሳ ባጋራ ደኤስ። ካይሳ በሳ ዩሹዋ ጋሰያ ባሱዋ ዳልጋተይ እቻሹ ዋ።<verse eid="EZK 41:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 41:12"/>ፆሳ ኬፈ ዉሎሀ ባጋራ ደእያ ካይሳ በሳፈ ስን ባጋራ እስ ኬ ደኤስ። ሄ ኬ አዱሳተይ ኡዱፉን ታሙ ዋ፤ ጎምፓይ ላፑን ታሙ ዋ። ሄ ኬ ጎዳ ኦርደተይ እቻሹ ዋ።<verse eid="EZK 41:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 41:13"/>ሄ ኡራይ ፆሳ ኬ ካረ ባጋ ዋን፥ አዱሳተይ ፄቱ ዋ። ፆሳ ኬፈ ጉየ ባጋራ ደእያ ካይሳ በሳ ካንድ ዉሎሀ ባጋ ኬ ጋካናዉ ደእያ በሳ ዋን ፄቱ ዋ ግድስ። <verse eid="EZK 41:13"/><verse number="14" style="v" sid="EZK 41:14"/>ዶሎሀ ባጋራ ደእያ ፆሳ ኬ ጎምፓይ ናምኡ ካይሳ በሳታ ጉጅድ ዋን ፄቱ ዋ ግድስ። <verse eid="EZK 41:14"/><verse number="15" style="v" sid="EZK 41:15"/>ናምኡ ባጋራ ደእያ አያ በሳታ ጉጅድ፥ ዉሎሀ ባጋራ ደእያ ኬ አዱሳተ ዋን፥ ፄቱ ዋ ግድስ።</para>
  <para style="p" vid="EZK 41:15">ፆሳ ኬ ጌሻ በሳይ፥ እያ ቆልአይነ እያ ባራንዳይ <verse eid="EZK 41:15"/><verse number="16" style="v" sid="EZK 41:16"/>ዉይገፐ ብድ፥ ማስኮተታ ጋካናዉ ደእያ በሳይ ምን ልጨትድ ኡትስ፤ ማስኮተትካ ምን ልጨትድ ኡትዶሶና። <verse eid="EZK 41:16"/><verse number="17" style="v" sid="EZK 41:17"/>ፆሳ ኬ ሶ ባጋ ክፍለታ ጎዳይ፥ ፐንገታፐ ቦላ አና ጋካናዉ አሌቀትድ ኡትስ። <verse eid="EZK 41:17"/><verse number="18" style="v" sid="EZK 41:18"/>ክፍለታ ዩሾን፥ ዛምባ ምንነ ክሩበታ ምስለይ አሌቀትስ። ሄ ዛምባ ም ምስለት አሌቀትዳይ ናምኡ ክሩበታፐ ግዶና። ክሩበታስ ናምኡ ናምኡ ሶምኦይ ደኤስ። <verse eid="EZK 41:18"/><verse number="19" style="v" sid="EZK 41:19"/>እስ ባጋራ አሳ ሶምኦ ዳንያ ሶምኦይ ዛምባ ምስልያ ፄሌስ፤ ሀንኮ ባጋራ ጋሞ ሶምኦ ዳንያ ሶምኦይ ዛምባ ምስልያ ፄሌስ። <verse eid="EZK 41:19"/><verse number="20" style="v" sid="EZK 41:20"/>ጌሻ በሲ ዉይገፐ ብድ፥ ፐንገታፐ ቦላ ባጋን ደእያ በሳ ጋካናዉ፥ ጎዳ ዩሾ ኡባይ ሄሳዳ አሌቀትስ። <verse eid="EZK 41:20"/><verse number="21" style="v" sid="EZK 41:21"/>ፆሳ ኬ ፐንገ ፃንገት ኡባይ ኦይዱ ማዛነይ ደእያ ኡባይ እስ ልከ።</para>
  <para style="p" vid="EZK 41:21">ኡባፈ ጌሻ በሳ ገልያ በሳ ስንን <verse eid="EZK 41:21"/><verse number="22" style="v" sid="EZK 41:22"/>ምፈ ኦሰትዳ ያርሾ በሲ ዳንያ በሲ በንቴስ። እካ ኦይዱ ማዛነይ ግድድ፥ ዳልጋተይነ አዱሳተይ እስ ግና፤ እሶይ እሶይ ናምኡ ዋ፤ አዱሳተይ ሄ ዋ። ማዛነታ ቱሳት፥ ባሶትነ ምየ ባጋን ደእያ ሳንቃት ኡባይ ምፈ ኦሰትዶሶና። ሄ ኡራይ ታኮ፥ “ሀይስ ጎዳ ስንን ደእያ ፃርጴዛ” ያግስ።<verse eid="EZK 41:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 41:23"/>ጌሻ በሳ ገልስያ እስ ፐንገይ ደኤስ፤ ኡባፈ ጌሻ በሳ ገልስያ እስ ፐንገይ ደኤስ። <verse eid="EZK 41:23"/><verse number="24" style="v" sid="EZK 41:24"/>እስ እስ ፐንግያስ ግዶን ዳኮትድ ዶየትያ ናምኡ ሳንቃት ደኦሶና። <verse eid="EZK 41:24"/><verse number="25" style="v" sid="EZK 41:25"/>ጎዳታ ቦላ መትዳይሳዳ ጌሻ በሳ ፐንገታ ሳንቃታ ቦላ ክሩበታነ ዛምባታ ምስለይ መትድ ኡትስ። ጋ ገልያ ክፍልያ ስንን፥ ካረ ባጋራ ምፈ ኦሰትዳ ካም ደኤስ። <verse eid="EZK 41:25"/><verse number="26" style="v" sid="EZK 41:26"/>ሄ ክፍልያ ገልያ ጎዳታ ምየን ማስኮተት ደኦሶና። ጎዳት ዛምባ ምስለን አሌቀትዶሶና። ሄ ክፍልያ ገልያ ኡሻቻንነ ሀድርሳን ደእያ ክፍለታ ደ ባጋራ ካምያ ካር ደኤስ።<verse eid="EZK 41:26"/></para>
  <chapter eid="EZK 41"/>
  <chapter number="42" style="c" sid="EZK 42"/>
  <para style="s1">ፆሳ ኬ ማታን ኬፀትዳ ኬታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 42:1"/>ሄሳፈ ጉየ፥ ሄ ኡራይ ታና ፑደሀ ባጋ ፐንግያራ ካረ ዳባባኮ ካለድ ፆሳ ኬ ግዶ ዳባባ ግምብያራ ኦይከትዳ ኬኮ ታና ኤህስ። <verse eid="EZK 42:1"/><verse number="2" style="v" sid="EZK 42:2"/>ሄ ኬ ዉላይ ፑደሀ ባጋ ስምስ። ሀ ኬይ ፄቱ ዋ አዱሰነ እሻታሙ ዋ ዳልጋ። <verse eid="EZK 42:2"/><verse number="3" style="v" sid="EZK 42:3"/>ግዶ ዳባባፐ ላታሙ ዋ ሃክድ፥ ቃስ ስን ባጋራ ካረ ዳባባን ደእያ ሂፀትዳ ሹቻፈ ስን ባጋራ ዎልኮ ስምዳ ሄ ደ ደእያ ፖቀይ ደኤስ። <verse eid="EZK 42:3"/><verse number="4" style="v" sid="EZK 42:4"/>ሄ ክፍለታ ፐንገት ፑደ ፄሎሶና። ኤንታፈ ስን ባጋራ ታሙ ዋ ዳልጋነ ፄቱ ዋ አዱሰ ግድዳ ግዶራ አያ ኦገይ ደኤስ። <verse eid="EZK 42:4"/><verse number="5" style="v" sid="EZK 42:5"/>ሄ ኬስ ቦላ ሄን ፖቀይ ናምአን ፖቅያፐ ፁሜስ፤ ናምአንይ ኮይሩዋፐ ፁሜስ። ሄስ ሀንዳይ ኤንቲ እሶይ እሱዋፈ ጉየ ሺቅድ ግምበትዳ ግሾሳ። <verse eid="EZK 42:5"/><verse number="6" style="v" sid="EZK 42:6"/>ሄ ፖቅያስ ቦላ ባጋ ክፍለት ግዶ ክፍለታፐነ ጋርሳ ባጋ ክፍለታፐ ፁምያ ግሾ፥ ካረ ዳባባን ደእያ ሀራ ኬታዳ ኤንታዉ ቱስ ባዋ። <verse eid="EZK 42:6"/><verse number="7" style="v" sid="EZK 42:7"/>ሄ ክፍለታፐ ስን ባጋራ እሻታሙ ዋ አዱቅያ ካረ ዳባባ ባጋራ ደእያ እስ ግምበይ ደኤስ። <verse eid="EZK 42:7"/><verse number="8" style="v" sid="EZK 42:8"/>ካረ ዳባባ ባጋራ ደእያ ክፍለታ አዱሳተይ እሻታሙ ዋ ግድሽን፥ ፆሳ ኬ ስንን ደእያ ክፍለታ አዱሳተይ ፄቱ ዋ። <verse eid="EZK 42:8"/><verse number="9" style="v" sid="EZK 42:9"/>ካረ ዳባባፐ ጋ ገልያ ዎደ ዶሎሀ ባጋራ ጋርሳ ክፍለታ ገልያ ፐንገይ ደኤስ።<verse eid="EZK 42:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 42:10"/>ዱገሀ ባጋራ ካረ ዳባባ ካልድ ፆሳ ኬ ዳባባራ ኦይከትድ ኬፀትዳ ካረ ዳባባኮ ስምዳ ክፍለይ ደኤስ። <verse eid="EZK 42:10"/><verse number="11" style="v" sid="EZK 42:11"/>ሄ ኬ ክፍለታ ስንን ኦገይ ደኤስ። ሄ ኬይ ቆሞ ባጋን ደእያ ኬራ እስ ግና፤ አዱሳተይ፥ ዳልጋተይ፥ ክፍለትነ ፐንገት ኡባይ እስ ግና። <verse eid="EZK 42:11"/><verse number="12" style="v" sid="EZK 42:12"/>ድርሳ ግምበይ ዉርያ ዶሎሀ ባጋ ጋፃ ዶምድ ግምብያስ ዱገሀ ባጋራ ደእያ ክፍለታ ገልያ ፐንገይ ደኤስ።<verse eid="EZK 42:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 42:13"/>ሄ ኡራይ ታኮ፥ “ፆሳ ኬ ዳባባ ስንን፥ ፑደሀ ባጋንነ ዱገሀ ባጋን ደእያ ክፍለት ካህነታሳ። ሄ ክፍለታ ግዶን ጎዳ ስንን ኦያ ካህነት ኡባፈ ጌሻ ካ ማና። ሄ ክፍለት ጌሽ ግድያ ግሾ፥ ኡባፈ ጌሻ እሞታ፥ ሄስካ ካ ያርሾ፥ ናጋራ ያርሾነ ናቆ ያርሾ ኤንቲ ያን ዎና። <verse eid="EZK 42:13"/><verse number="14" style="v" sid="EZK 42:14"/>ካህነት እስ ቶሆ ኡባፈ ጌሻ በሳ ገልዳፐ ጉየ፥ ፆሳስ ኦያ ዎደ ማእያ ማኦት ጌሽ ግድያ ግሾ፥ ባንታ ኦሶ ማኡዋ ላሞናሽን ካረ ዳባባ ከያናዉ ዳንዳኦኮና። ኤንቲ አሳኮ ካረ ከይሸ ካሰ ማእያ ሀራ ማኦታ ማእድ ከያናዉ ኮሼስ” ያግስ።<verse eid="EZK 42:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 42:15"/>ሄ ኡራይ ፆሳ ኬ ጋ ባጋ ዋድ ዉርስዳፐ ጉየ ዶሎሀ ባጋ ድርሳ ፐንግያራ ታና ካረ ከስድ፥ ፆሳ ኬ ካረ ባጋ ዩሹዋ ኡባ ዋስ። <verse eid="EZK 42:15"/><verse number="16" style="v" sid="EZK 42:16"/>ዋ ፃምአ ኤክድ፥ ዶሎሀ ባጋ ዋን፥ እቻሹ ፄቱ ዋ ግድስ። <verse eid="EZK 42:16"/><verse number="17" style="v" sid="EZK 42:17"/>ፑደሀ ባጋ ሄ ፃምአን ዋን፥ እቻሹ ፄቱ ዋ ግድስ። <verse eid="EZK 42:17"/><verse number="18" style="v" sid="EZK 42:18"/>ዱገሀ ባጋ ዋን፥ እቻሹ ፄቱ ዋ ግድስ። <verse eid="EZK 42:18"/><verse number="19" style="v" sid="EZK 42:19"/>ዉሎሀ ባጋ ዋን፥ እቻሹ ፄቱ ዋ ግድስ። <verse eid="EZK 42:19"/><verse number="20" style="v" sid="EZK 42:20"/>ሄሳዳ ኦድ፥ እ ኦይዱ ባጋ ኡባ ዋስ። እያ ዩሹዋን እቻሹ ፄቱ ዋ አዱቅያ፥ ቃስ እቻሹ ፄቱ ዋ ዳልግያ ድርሳ ግምበይ ደኤስ። ሄ ግምበይ ጌሻ በሳነ ጮ በሳ ሻካናሳ።<verse eid="EZK 42:20"/></para>
  <chapter eid="EZK 42"/>
  <chapter number="43" style="c" sid="EZK 43"/>
  <para style="s1">ቦንቾይ ፆሳ ኬ ስምስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 43:1"/>ሄ ኡራይ ታና ዶሎሀ ባጋ ፐንግያኮ ኤህስ። <verse eid="EZK 43:1"/><verse number="2" style="v" sid="EZK 43:2"/>ታኒ እስራኤለ ፆሳ ቦንቾይ ዶሎሀ ባጋፈ የይሳ በአስ። እያ ዩሳ ግርሳይ ክፃ ሃ ጉን መላ፤ ቢታይ እያ ቦንቹዋን ፖእስ። <verse eid="EZK 43:2"/><verse number="3" style="v" sid="EZK 43:3"/>ታ በእዳ ቆንጨይ ካሰ ጎዳይ የሩሳላመ ካታማ ይሳናዉ ይዳ ዎደ በእዳ ቆንጨ ዳኔስ። ኮቦራ ሻፋ ማታን ታኒ በእዳ ቆንጨ ዳኔስ። ሄ ዎደ ታ ሶምኡዋ ሳአ ጋዳ ጉፋናስ። <verse eid="EZK 43:3"/><verse number="4" style="v" sid="EZK 43:4"/>ጎዳ ቦንቾይ ዶሎሀ ፐንግያራ ፆሳ ኬ ግዶ ገልስ። <verse eid="EZK 43:4"/><verse number="5" style="v" sid="EZK 43:5"/>ሄ ዎደ ጎዳ አያናይ ታና ደንድ፥ ግዶ ዳባባ ገልስን፥ ሄኮ፥ ጎዳ ቦንቾይ ፆሳ ኬ ኩምስ።<verse eid="EZK 43:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 43:6"/>ያን ሄ ኡራይ ታ ማታን ኤቅዳሽን፥ ፆሳ ኬ ግዶፈ ጎዳይ ታዉ ኦድሽን ስአስ። <verse eid="EZK 43:6"/><verse number="7" style="v" sid="EZK 43:7"/>እ ታኮ፥ “አሳ ናአዉ፥ ሀይስ ታ አራታይ ኡትያነ ታ ቶሆይ የያ በሰ። ታ እስራኤለ አሳ ግዶን መርናዉ ዳና። ህዛፐ ጉየ እስራኤለ አሳ ግድን፥ ኤንታ ካዎታ ግድን፥ ኤቃ ጎይንድ ዎይኮ ባንታ ካዎታ ሀዉልተ ጎይንሸ ታ ጌሻ ሱን ቱንሶኮና። <verse eid="EZK 43:7"/><verse number="8" style="v" sid="EZK 43:8"/>እስ ጎዳ ፃላል ታናነ ኤንታ ሻክን፥ ባንታ ፐንግያ ታ ፐንግያ ማታን፥ ባንታ ፐንገ ዝዝግያ ታ ፐንገ ም ማታን ኤስዶሶና። ባንታ እፀትዳ ኦሱዋን ታ ጌሻ ሱን ቱንስዶሶና። ሄሳ ግሾ፥ ታኒ ታ ሀንቁዋን ኤንታ ይሳስ። <verse eid="EZK 43:8"/><verse number="9" style="v" sid="EZK 43:9"/>ህዛ ኤቃ ጎይኖ አጎ፤ ባንታ ካዎታ ሀዉልተ ታ ማታፐ ድጎ። ያትኮ፥ ታ ኤንታ ግዶን መርናዉ ዳና።”<verse eid="EZK 43:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 43:10"/>ዛሪድ ጎዳይ ታኮ፥ “አሳ ናአዉ፥ ታ ነና በስዳ ፆሳ ኬ ኦሱዋ እስራኤለ አሳስ ኦዳ፤ ኤንቲ ባንታ ኦዳ ናጋራን ዬላታና መላ እያ መዋባ ኤንታዉ ኦዳ። <verse eid="EZK 43:10"/><verse number="11" style="v" sid="EZK 43:11"/>ኤንቲ ባንታ ኦዳባን ዬላትያባ ግድኮ፥ ፆሳ ኬ ማላ፥ እ ኬፀትዳ ሀኖታ፥ ከይያ ደታ፥ ገልያ ፐንገታነ እያ ኩመ ምስልያ ኤንታዉ ቆንጭሳ። ሄሳዳካ፥ እያ ዎጋ፥ እያ ህግያ ኡባ ኤንታ ኤርሳ። ሄ ኬ ሀኖታ ካላና መላ እያ ህግያነ ዎጋ ናጋና መላ ኤንቲ ፄልሽን ፃፋ። <verse eid="EZK 43:11"/><verse number="12" style="v" sid="EZK 43:12"/>ፆሳ ኬ ህገይ ሀይሳ፥ ዙማ ሁጰን፥ ፆሳ ኬ ዩሹዋን ደእያ በሳ ኡባይ ኡባፈ ጌሽ ግዳና።”<verse eid="EZK 43:12"/></para>
  <para style="s1">ያርሾ በሳ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 43:13"/>ያርሾ በሳይ ካሰ ፆሳ ኬ ዋዳይሳዳ፥ እስ ዋነ ኦይዱ ብራ ጉጅድ ዋትስ። ያርሾ በሳ ባሱዋ ዩሾን እስ ዋ ዝቃነ እስ ዋ ዳልግያ ኦል ደኤስ፤ ሄ ኦላይ ካረ ባጋራ እስ ታካ ቄስ፤ ሄስ ያርሾ በሳ ቃተ። <verse eid="EZK 43:13"/><verse number="14" style="v" sid="EZK 43:14"/>ባሱዋፐ ብድ፥ ኮይሮ ደ ጋካናዉ ቃተይ ናምኡ ዋ፤ ጎምፓይ እስ ዋ። ጉ ደፈ ብድ ግታ ደ ጋካናዉ ቃተይ ኦይዱ ዋ፤ ቃስ ጎምፓይ እስ ዋ። <verse eid="EZK 43:14"/><verse number="15" style="v" sid="EZK 43:15"/>ያርሾይ ፁሳ ጮጨይ ደእያ ዉርሰ ደይ ኦይዱ ዋ ቃ። እ ኦይዱ ማዛነ ግድድ፥ ኦይዱ ማዛንያ ቦላ እስ እስ ካጨይ ደኤስ፤ <verse eid="EZK 43:15"/><verse number="16" style="v" sid="EZK 43:16"/>ታማይ ኤፅያ ጮጨይ ኦይዱ ማዛነ ግድድ፥ አዱሳተይነ ዳልጋተይ ታማነ ናምኡ ዋ። <verse eid="EZK 43:16"/><verse number="17" style="v" sid="EZK 43:17"/>ናምአን ደይ ሄሳ መላ ኦይዱ ማዛነ ግድድ፥ አዱሳተይነ ዳልጋተይ ታማነ ኦይዱ ዋ። ሄ ደ ካረ ባጋ ጋፃይ እስ ታካ ቄስ፤ ዩሾን እስ ዋ ኦል ደኤስ። ያርሾ በሳ ፑደ ኤፍያ ደት ዶሎሀ ባጋን ደኦሶና።<verse eid="EZK 43:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 43:18"/>ኡባ ሃርያ ጎዳይ ታኮ፥ “አሳ ናአዉ፥ ፁሳ ያርሾ ያርሻናዉነ ሱ ዉርፃናዉ፥ ያርሾ በሳ ግምብድ ዉርስያ ጋላስ ኦሰታና ዎጋይ ሀይሳ። <verse eid="EZK 43:18"/><verse number="19" style="v" sid="EZK 43:19"/>ታ ስንን ኤቅድ ኦያ ሳዶቃ ያራፐ የለትዳ ሌወ ኮቸ ግድዳ ካህነታስ ናጋራ ያርሾ ኦዳ እስ ዎፋኖ እማ” ያጌስ ኡባ ሃርያ ጎዳይ። <verse eid="EZK 43:19"/><verse number="20" style="v" sid="EZK 43:20"/>ኔኒ ሄ ሱፈ ኤካዳ፥ ኦይዱ ካጨታ፥ ናምአን ደ ኦይዱ ማዛነታነ ሄ ደ ጋፃ ትያ። ሄሳዳ ኦዳ፥ ያርሾ በሳ ጌሻ። <verse eid="EZK 43:20"/><verse number="21" style="v" sid="EZK 43:21"/>ናጋራ ያርሾስ እመትዳ ኮርማ ኤካዳ፥ ፆሳ ኬስ ተቀትዳ ጌሻ በሳፈ ካረ ባጋራ እያዉ ጊግዳ በሳን ፁጋ።<verse eid="EZK 43:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 43:22"/>ዎንተ ጋላስ ቦረይ ባይና እስ ኮለ ኤካዳ፥ ናጋራ ያርሾ ኦዳ ያርሻ። ካሰ ኮርማ ሱን ጌሽዳይሳዳ ሄ ኮልያ ሱን ያርሾ በሳ ጌሻ። <verse eid="EZK 43:22"/><verse number="23" style="v" sid="EZK 43:23"/>ጌሻ ስማዳ ቦረይ ባይና እስ ዎፋኖነ እስ ማራዘ ኤካዳ፥ <verse eid="EZK 43:23"/><verse number="24" style="v" sid="EZK 43:24"/>ናምኣካ ጎዳ ስን ሺሻ። ካህነት ኤንታ ቦላ ማፅነ ላልድ፥ ጎዳስ ፁሳ ያርሾ ኦድ ያርሾ።<verse eid="EZK 43:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 43:25"/>“ላፑን ጋላስ ኩመ፥ እስ እስ ጋላስ፥ እስ ኮለ፥ እስ ዎፋኖነ እስ ማራዘ ናጋራ ያርሾ ኦዳ ያርሻ። <verse eid="EZK 43:25"/><verse number="26" style="v" sid="EZK 43:26"/>ካህነት ላፑን ጋላስ ኩመ ያርሾ በሳ ጌሽድ ጎዳስ ዱማዮ። <verse eid="EZK 43:26"/><verse number="27" style="v" sid="EZK 43:27"/>ሀ ጋላሳት ዉርያ ዎደ፥ ሆስፑን ጋላሳፐ ዶምድ፥ ካህነት ፁሳ ያርሾነ እስፈተ ያርሾ ሺሾ። ሄ ዎደ ታ ህንተናን ኡፋይታና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 43:27"/></para>
  <chapter eid="EZK 43"/>
  <chapter number="44" style="c" sid="EZK 44"/>
  <para style="s1">ዶሎሀ ፐንግያ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 44:1"/>ሄሳፈ ጉየ፥ ሄ ኡራይ ታና ጉየ ዛሪድ፥ ፆሳ ኬስ ዶሎሀ ባጋራ ደእያ ካረ ባጋ ድርሳ ፐንግያኮ ኤህያ ዎደ ድርሳ ፐንገይ ጎርደትድ ኡትስ። <verse eid="EZK 44:1"/><verse number="2" style="v" sid="EZK 44:2"/>ጎዳይ ታኮ፥ “ሀ ፐንገይ ጎርዳን ዳናፐ አትሽን፥ ናምአን ዶየተና። ጎዳይ እስራኤለ ፆሳይ ያራ ገልዳ ግሾ ኦንካ ያራ ገለና። ሄሳ ግሾ፥ ሄ ፐንገይ ጎርዳን ዳና። <verse eid="EZK 44:2"/><verse number="3" style="v" sid="EZK 44:3"/>ግዶሽን፥ እስራኤለ ሀላቃይ፥ ጎዳ ስንን ኡይ ማናዉ ያን ኡታናዉ ዳንዳኤስ። ፐንግያ ባራንዳራ እ ገላናዉነ ከያናዉ ዳንዳኤስ” ያግስ።<verse eid="EZK 44:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 44:4"/>ሄ ኡራይ ታና ፑደሀ ፐንግያኮ ኤፍያ ኦግያራ ኤፍድ፥ ፆሳ ኬስ ስን ባጋ ጋስ። ያን ግዳዳ ታ በእያ ዎደ፥ ሄኮ፥ ጎዳ ቦንቾይ ፆሳ ኬ ኩምድ ኡትዳይሳ በአዳ ሶምኦራ ሳአን ጉፋናስ።<verse eid="EZK 44:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 44:5"/>ጎዳይ ታኮ፥ “አሳ ናአዉ፥ ፆሳ ኬ ዎጋታነ እያ ህገታ ኡባ ነ በኤይሳነ ስኤይሳ ሎይዳ ናጋ። ፆሳ ኬ ገላናዉነ ከያናዉ በሲያ አሳትነ በሶና አሳት ኦናንተኮ ሎይዳ አኬካ። <verse eid="EZK 44:5"/><verse number="6" style="v" sid="EZK 44:6"/>ማካላንቾ እስራኤለ አሳስ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ። ‘ህንተኖ፥ እስራኤለ አሳዉ፥ ህንተ ኦያ ቱና ኦሶታ አግተ። <verse eid="EZK 44:6"/><verse number="7" style="v" sid="EZK 44:7"/>ህንተ ታዉ ታ ካ፥ ሞዋነ ሱ ያርሾ ኦድ ሺሽያ ዎደ ዎዛናይነ አሾይ ቃፃረትቦና አላጋ አሳታ ፆሳ ኬ ገልስድ ታ ኬ ቱንስደታ፤ ታ ጫቁዋ መንደታ። <verse eid="EZK 44:7"/><verse number="8" style="v" sid="EZK 44:8"/>ታ ጌሻ ሚሸታ ቦላ አዋቶና እፅድ፥ ታ ኬን አላጋታ አዋይደታ’ ” ያጌስ።<verse eid="EZK 44:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 44:9"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “እስራኤለ አሳ ግዶን ደእያ አላጋ አስ፥ ባ ዎዛናንነ ባ አሹዋ ቃፃረትቦና፥ ኦንካ ታ ኬ ገሎፖ።”<verse eid="EZK 44:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 44:10"/>“ታና አግድ፥ እስራኤለ አሳራ ኤቃ ጎይንዳ ሌወታ ታ ሴራና። <verse eid="EZK 44:10"/><verse number="11" style="v" sid="EZK 44:11"/>ኤንቲ ታ ኬን ኦሳንቾ ግዶ፤ ታ ኬ ድርሳ ፐንገታ ናጎ፤ ፆሳ ኬ ኦሱዋካ ኦ። ኤንቲ ፁሳ ያርሾነ አሳይ ኤህያ ሀራ ያርሾ ሹኮ፤ ቃስ አሳስ ኦናዉ አሳኮ ሺቆ። <verse eid="EZK 44:11"/><verse number="12" style="v" sid="EZK 44:12"/>ሽን ኤንቲ ካሰ እስራኤለ አሳ ኤቃ ጎይንስዳ ግሾነ አሳ ናጋራኮ ካለዳ ግሾ፥ ኤንቲ ባንታ ናጋራ ሴራ ኤካና መላ ታ ኩሸ ደንዳ ጫቃስ” ያጌስ ኡባ ሃርያ ጎዳይ። <verse eid="EZK 44:12"/><verse number="13" style="v" sid="EZK 44:13"/>ኤንቲ ካህነ ግድድ ኦናዉ ታኮ ሺቆፖ፤ ዎይኮ ታዉ ዱማትዳ ጌሻባኮነ ኡባፈ ጌሻ በሳኮ ሺቆፖ። ኤንቲ ባንታ ኦዳ ቱና ኦሱዋ ግሾ፥ ኦይሸታና። <verse eid="EZK 44:13"/><verse number="14" style="v" sid="EZK 44:14"/>ሄሳ ግሾ ኤንቲ ፆሳ ኬን አዋታናዳነ እያ ግዶን ኦናዉ ደእያ ኦሶ ኡባ ኦና መላ ታ ኤንታ ሹማና።<verse eid="EZK 44:14"/></para>
  <para style="s1">ካህነተ ዎጋ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 44:15"/>“ሽን እስራኤለ አሳይ ታና አግድ፥ ታ ስንፈ ሃክዳ ዎደ ፆሳ ኬ ዎጋ አማነትድ ፖልዳ፥ ሌወ ኮቸ ግድዳ ካህነት፥ ሳዶቃ ያራት፥ ታዉ ኦናዉ ታኮ ሺቆ። ሞዋነ ሱ ሺሽድ ኤንቲ ታ ስንን ኦ” ያጌስ ኡባ ሃርያ ጎዳይ። <verse eid="EZK 44:15"/><verse number="16" style="v" sid="EZK 44:16"/>ፆሳ ኬ ኤንቲ ገሎ፤ ታዉ ኦናዉ ታ ያርሾ በሳ ኤንቲ ሺቆ፤ አዋተ ኤንቲ ኦይኮ። <verse eid="EZK 44:16"/><verse number="17" style="v" sid="EZK 44:17"/>ኤንቲ ፆሳ ኬስ ግዶ ዳባባ ገልያ ዎደ፥ ሊኖፐ ዳደትዳ ማኦ ማኦ፤ ግዶ ዳባባ ፐንገን ዎይኮ ፆሳ ኬ ግዶን ኦያ ዎደ ሱፈ ማኦ ማኦፋ። <verse eid="EZK 44:17"/><verse number="18" style="v" sid="EZK 44:18"/>ኤንቲ ባንታ ሁጰን ሊኖ ጎፅድ፤ ባንታ ፄሳን ሊኖ ቃን ሱረ ዳንጮ፤ ጫዋያ ማኦ ማኦፎ። <verse eid="EZK 44:18"/><verse number="19" style="v" sid="EZK 44:19"/>አሳይ ደእያ ካረ ዳባባ ኤንቲ ከያናፐ ስን ፆሳ ኬን ኦሸ ማእዳ ማኡዋ ቃርድ፥ ጌሻ ክፍለታን ዎ። ሄስካ፥ አሳይ ኤንታ ጌሻ ማኡዋ ቦችድ ቆሄቶና መላሳ።<verse eid="EZK 44:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 44:20"/>“ካህነት ባንታ ሁጵያ ሜደቶፎ ዎይኮ አዱስድ ድቾፎ፤ ባንታ ሁጵያ ማራን ቃንፀቶ። <verse eid="EZK 44:20"/><verse number="21" style="v" sid="EZK 44:21"/>አይ ካህነት ግዶ ዳባባ ገልያ ዎደ ዎይነ ኡሽ ኡዮፖ። <verse eid="EZK 44:21"/><verse number="22" style="v" sid="EZK 44:22"/>ኤንቲ አዝን ሀይቅዳ፥ ዎይኮ ሳዮ ማጫስ ኤኮፎ። እስራኤለ አሳፐ ጌላኦ ኤኮ፤ ዎይኮ አዝናይ ካህነ ግድድ ደእሸ ሀይቅዳ ማጫስ ኤኮ።<verse eid="EZK 44:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 44:23"/>“ካህነት ጎዳስ ዱማትዳባነ ዱማቶናባ ግዶን ደእያ ዱማተ ታ አሳ ታማርሶ፤ ጌሽነ ቱና ግዶን ደእያ ዱማተ ኤንታ በሶ። <verse eid="EZK 44:23"/><verse number="24" style="v" sid="EZK 44:24"/>አይ ሞቶይ ደንድኮካ፥ ካህነት ህገይ ኦደይሳዳ ፕርዶ። ታ ህገይነ ታ ዎጋይ ገይሳዳ ታ ባለታ ቦንቾ፤ ታ ሳምባታ ዱማይድ ቦንቾ።<verse eid="EZK 44:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 44:25"/>“ካህነይ ሀይቅዳ አሀኮ ሺቅድ፥ ባና ቱንሶፖ። ግዶሽን፥ ሀይቅዳይ አዋ ዎይኮ አዮ ዎይኮ እያ አደ ናአ ዎይኮ ማጫ ናአ ዎይኮ እሻ ዎይኮ አዝና ገላቦና ምቾ ግድኮ ባና ቱንሶ። <verse eid="EZK 44:25"/><verse number="26" style="v" sid="EZK 44:26"/>ቱንዳፐ ጉየ፥ ላፑን ጋላስ ጋምኦ፤ ሄሳፈ ጉየ፥ እ ጌሽ ግዳና። <verse eid="EZK 44:26"/><verse number="27" style="v" sid="EZK 44:27"/>ጌሻ በሳን ሀጋዛናዉ ግዶ ዳባባ ገልያ ዎደ ባ ናጋራ ግሾ ያርሾ ሺሾ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 44:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 44:28"/>ካህነታስ ላት ባዋ፤ ታ ኤንታዉ ላታ። እስራኤለ ቢታን ኤንታዉ አይ ላታካ እሞፕተ፤ ኤንታ ላታይ ታና። <verse eid="EZK 44:28"/><verse number="29" style="v" sid="EZK 44:29"/>ኤንቲ ካ ያርሾ፥ ናጋራ ያርሾነ ናቆ ያርሾ ሞ። እስራኤለ ቢታን ጎዳስ ዱማይዳባ ኡባይ ኤንታሳ። <verse eid="EZK 44:29"/><verse number="30" style="v" sid="EZK 44:30"/>ኮይሮ ጋክያ ዱማ ዱማ ካ ፄራ አይፈይነ ህንተ ጎዳስ እምያ እሞታ ኡባይ ካህነታሳ። ህንተ ኬይ አንጀታና መላ ህንተ ልያፈ ኮይሮ ኩሽያ ኤንታዉ እምተ። <verse eid="EZK 44:30"/><verse number="31" style="v" sid="EZK 44:31"/>ካህነት ባዉታ ዎይኮ ዶእ ዎዳ ካፎ አሾ ዎይኮ መሄ አሾ ሞፖ።<verse eid="EZK 44:31"/></para>
  <chapter eid="EZK 44"/>
  <chapter number="45" style="c" sid="EZK 45"/>
  <para style="s1">ጎዳስ ዱማትዳ ግሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 45:1"/>“ቢታ ላታናዉ ህንተ ሳማን ሻክያ ዎደ ሄ ቢታፈ እስ ሳማ ጎዳስ ዱማይተ። ሄስካ ታማነ ናምኡ ክሎ ምትረነ ባጋ አዱቅያነ ታሙ ክሎ ምትረ ዳልግያ በሰ ግዶ። ሄ በሳይ ኡባይ ጌሻ በሰ ግዶ። <verse eid="EZK 45:1"/><verse number="2" style="v" sid="EZK 45:2"/>ሄ በሳፈ ኦይዱ ማዛነ ደእያ አዱሳተይነ ዳልጋተይ እስ ግና ግድያ እቻሹ ፄቱ ዋ፥ በሲ ፆሳ ኬስ ተቀቶ፤ እያ ዩሾን እሻታሙ ዋ ግድዳ ካይሳ በሲ ደኦ። <verse eid="EZK 45:2"/><verse number="3" style="v" sid="EZK 45:3"/>ሄ ጎዳስ ዱማይዳ በሳፈ አዱሳተይ ታማነ ናምኡ ክሎ ምትረነ ባጋ፥ ጎምፓይ እቻሹ ክሎ ምትረ ግድዳ በሰ ዋዳ ሻካ። ሄ በሳይ ኡባፈ ጌሻ በሳይ ደእያ ፆሳ ኬስ፥ ግድድ ደኦ። <verse eid="EZK 45:3"/><verse number="4" style="v" sid="EZK 45:4"/>ሄስ ፆሳ ኬ ግዶን ጎዳስ ሀጋዛናዉ፥ እያኮ ሺቅያ ካህነታስ ዱማትዳ ጌሻ በሲ ግዶ። ሄስ ካህነታ ኬይነ ፆሳ ኬይ ኬፀትያ በሰ ግዶ። <verse eid="EZK 45:4"/><verse number="5" style="v" sid="EZK 45:5"/>ቃስ አትዳ ታማነ ናምኡ ክሎ ምትረ ባጋ አዱቅያነ እቻሹ ክሎ ምትረ ባጋ ዳልግያ በሳይ ፆሳ ኬን ኦያ ሌወታስ ላታ ግዶ፤ ኤንቲ ባንታዉ ዱሳ ካታማታ ያን ኬፆ።<verse eid="EZK 45:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 45:6"/>“ጎዳስ ዱማይዳ በሳ ማታን ታማነ ናምኡ ክሎ ምትረነ ባጋ አዱቅያነ ናምኡ ክሎ ምትረነ ባጋ ዳልግያ በሳይ ካታማ ኬፃናዉ ደኦ፤ ሄ በሳይ እስራኤለ አሳ ኡባስ ግዶ። <verse eid="EZK 45:6"/><verse number="7" style="v" sid="EZK 45:7"/>እስራኤለ ሀላቃስ እመትዳ ግሾይ ናምኡ ባጋራ ጎዳስ ዱማይዳ በሳንነ ካታማ በሳን ዛዋቴስ። እ ዉሎሀ ባጋራ መደትራነ አባ ጋኬስ፤ ዶሎሀ ባጋራ እስራኤለ ቢታ ዛዋ ጋኬስ። እያ አዱሳተይ እስራኤለ ኮቻፈ እሱዋ ግሹዋዳ ዉሎሀ ባጋ ዛዋፐ ብድ፥ ዶሎሀ ባጋ ዛዋ ጋኬስ። <verse eid="EZK 45:7"/><verse number="8" style="v" sid="EZK 45:8"/>ሄ ግሾይ እስራኤለ ሀላቃስ ላታ ጋደ ግዶ። ህዛፐ ጉየ ታ ሀላቃት ታ አሳ ኡንኤፎ፤ ኤንቲ እስራኤለ አሳ ኡባይ ባ ኮቻን ኮቻን ቢታ ኤካናዳ ኦና” ያጌስ።<verse eid="EZK 45:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 45:9"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፤ “ህንተኖ፥ እስራኤለ ሀላቃቶ፥ ህንተዉ ሀእ ግዳና! ቡቀነ አሳ ኡንኤ አግተ፤ ሱረ ፕርድተ፤ ፅሎተ ኦተ። ታ አሳ ኤንታ ላታ ቢታፈ ሾድድ ጎደይሳ አግተ። ሀይሳ ኦደይ ታና ኡባ ሃርያ ጎዳ። <verse eid="EZK 45:9"/><verse number="10" style="v" sid="EZK 45:10"/>ህንተዉ እሱዋስ እሱዋስ ልከ ምዛነይነ ማካ ሚሸይ ደኦ። <verse eid="EZK 45:10"/><verse number="11" style="v" sid="EZK 45:11"/>ማካ ሚሸ ኡባስ ግዶ ግድያ ጎማረ ጌተትያ ማካ ሚሸ ግዶ። መላባ ማክያ እፋ ጌተትያ ሚሸይነ ጉክያባ ማክያ ባተ ጌተትያ ሚሸይ እስ ልከ ግዶ። ሄሳ ጉሳይ፥ እስ ጎመረይ ታሙ እፋራነ ታሙ ባተራ እስ ግና ግዴስ። <verse eid="EZK 45:11"/><verse number="12" style="v" sid="EZK 45:12"/>ጉባ ማክያ ዎደ ህንተ ማካ ሚሸይ ሳቅለ ግዶ። ላታሙ ጌር እስ ሳቅለ ግዶ፤ ኡሱፑን ታሙ ሳቅለይ እስ ምናነ ግዶ።<verse eid="EZK 45:12"/></para>
  <para style="s1">ያርሾታነ ጌሻ ጋላሳታ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 45:13"/>“ህንተ እሙዋ እምሸ ሀይሳዳ እምተ። ህንተ ሺሽያ ግስተፈ ኡሱፑን ታማፈ እስ ኩሸ፥ ባንጋፈ ኡሱፑን ታማፈ እስ ኩሸ ግዶ። <verse eid="EZK 45:13"/><verse number="14" style="v" sid="EZK 45:14"/>ሻማሆ ዛይትያፐ ፄታፐ እስ ኩሸ እምተ። ሄሳ ማክያ ዎደ ነ ማክያ ሚሸይ ባተ ግዶ። ታሙ ባተይ እስ ጎማረ ዎይኮ እስ ቆረ ግዴስ። <verse eid="EZK 45:14"/><verse number="15" style="v" sid="EZK 45:15"/>እስራኤለ አሳይ ሄምያ ናምኡ ፄቱ መሄፐ ደእያ እስ ዉድያፐ እስ እስ መሄ እምተ። ሄስ አሳ ናጋራ አቶተስ ያርሸትያ፥ ካ ያርሾራ፥ ፁሳ ያርሾራነ እስፈተ ያርሾራ ሺቃና” ያጌስ ኡባ ሃርያ ጎዳይ። <verse eid="EZK 45:15"/><verse number="16" style="v" sid="EZK 45:16"/>ቢታን ደእያ አሳ ኡባይ ሄሳ ኡባ እስራኤለ ሀላቃስ እሞ። <verse eid="EZK 45:16"/><verse number="17" style="v" sid="EZK 45:17"/>ሀላቃይ ኦያ ኦሶይ፥ እስራኤለ አሳይ ቦንችያ ባለታን፥ አጌና ፄሮን ሳምባታታ ጋላሳን፥ ፁሳ ያርሾ፥ ካ ያርሾነ ኡሻ ያርሾ ሺሾ። እስራኤለ አሳ ናጋራ አቶተስ ናጋራ ያርሾ፥ ካ ያርሾ፥ ፁሳ ያርሾነ እስፈተ ያርሾ ኮሽያባ እሞ።<verse eid="EZK 45:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 45:18"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ኮይሮ አጌናን፥ ኮይሮ ጋላሳን ቦረይ ባይና እስ ዎፋኖ ፆሳ ኬ ጌሻናዉ ሺሻ። <verse eid="EZK 45:18"/><verse number="19" style="v" sid="EZK 45:19"/>ካህነይ ናጋራ ያርሾ ሱፈ ኤክድ፥ ፆሳ ኬ ፐንገ ፃንገታ፥ ያርሾ በሳ ዩሾን ደእያ ደን ደእያ ኦይዱ ማዛነታነ ግዶ ዳባባ ኤፍያ ድርሳ ፐንገ ፃንገታ ትዮ። <verse eid="EZK 45:19"/><verse number="20" style="v" sid="EZK 45:20"/>ኦንካ ቆፖና ዎይኮ ኤሮና ኦዳ ናጋራ አቶተስ፥ ሄ አጌናን ላፑን ጋላስ ሄሳዳ ኦ። ያታዳ ፆሳ ኬ ጌሻ።<verse eid="EZK 45:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 45:21"/>“ኮይሮ አጌናን፥ ታማነ ኦይዳን ጋላስ ፓስካ ባኣለ ቦንችተ፤ ላፑን ጋላስ ጋካናዉ፥ እርሾይ ባይና ኡይ ሚተ። <verse eid="EZK 45:21"/><verse number="22" style="v" sid="EZK 45:22"/>ኮይሮ ጋላስ ሀላቃይ ባ ግሾነ ባ አሳ ግሾ ናጋራ ያርሾ ኦድ እስ ኮርማ ሺሾ። <verse eid="EZK 45:22"/><verse number="23" style="v" sid="EZK 45:23"/>ሄ ባለይ ቦንቸትያ ላፑን ጋላሳታን ጋላስ ጋላስ ቦረይ ባይና ላፑን ኮርማታነ ላፑን ማራዘ ዶርስ ፁሳ ያርሾ ኦድ፥ ጎዳስ ሺሾ። ሄሳራ ጋድ ናጋራ ያርሾስ ጋላስ ጋላስ እስ ዴሻ ኮለ ሺሾ። <verse eid="EZK 45:23"/><verse number="24" style="v" sid="EZK 45:24"/>እስ እስ ኮርማነ ማራዘ ያርሽያ ዎደ፥ ካ ያርሾስ ታማነ ላፑን ክሎ ግራመ ግስተነ ሄ ልትሮ ዛይተ ሺሾ።<verse eid="EZK 45:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 45:25"/>“ላፑን አጌናን፥ ታማነ እቻሻን ጋላሳን ዶምያ ላፑን ጋላሳ ባኣለ ዎደ ናጋራ ያርሾ፥ ፁሳ ያርሾ፥ ካ ያርሾነ ዛይተ ካሰይሳፈ ዱማዮና ሀላቃይ ሺሾ” ያጌስ።<verse eid="EZK 45:25"/></para>
  <chapter eid="EZK 45"/>
  <chapter number="46" style="c" sid="EZK 46"/>
  <para style="p">
    <verse number="1" style="v" sid="EZK 46:1"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ግዶ ዳባባ ገልስያ ዶሎሀ ባጋ ድርሳ ፐንገይ ኡሱፑን ኦሶ ጋላሳታን ጎርደትድ ጋምኦ፤ ሽን ሳምባታ ጋላስነ አጌና ፄሮ ጋላሳን ዶየቶ። <verse eid="EZK 46:1"/><verse number="2" style="v" sid="EZK 46:2"/>እስራኤለ ሀላቃይ ድርሳ ፐንግያ ባጋራ ካረ ዳባባፐ ጋ ገልድ፥ ድርሳ ፐንግያ ማታን ኤቆ። ካህነት እ እምዳ ፁሳ ያርሾነ እስፈተ ያርሾ ሺሾ። እ ያን ድርሳ ፐንግያ ማታን ጎይንድ ስሚድ ካረ ከዮ። ሽን ድርሳ ፐንገይ ኦማርስ ጋካናዉ ጎርደተና። <verse eid="EZK 46:2"/><verse number="3" style="v" sid="EZK 46:3"/>ሄ ቢታ አሳይ ሳምባታንነ አጌና ፄሮ ዎደ ሄ ግዶ ዳባባ ፐንግያ ስንን ጎዳ ጎይኖ። <verse eid="EZK 46:3"/><verse number="4" style="v" sid="EZK 46:4"/>ሀላቃይ ሳምባታ ጋላስ ጎዳስ ፁሳ ያርሾ ኦድ፥ ቦረይ ባይና ኡሱፑን ኡርገ ዶርሳታነ እስ ማራዘ ዶርስ ሺሾ። <verse eid="EZK 46:4"/><verse number="5" style="v" sid="EZK 46:5"/>እስ ዶርሳ ኡርግያራ ታማነ ላፑን ክሎ ግራመ ካ ያርሾ እሞ። ኡርገ ዶርሳታር ሺቅያ ካ ያርሾይ ሀላቃይ ባዉ ሺሻናዉ ኮየይሳ መላ ግዶ። ቃስ እስ እስ ታማነ ላፑን ክሎ ግራመ ካራ ሄ ሄ ልትሮ ዛይተይ እሞ። <verse eid="EZK 46:5"/><verse number="6" style="v" sid="EZK 46:6"/>አጌና ፄሮ ጋላስ ቦረይ ባይና እስ ዎፋኖ፥ ኡሱፑን ኡርገ ዶርሳታነ እስ ማራዘ ሺሾ። <verse eid="EZK 46:6"/><verse number="7" style="v" sid="EZK 46:7"/>እስ እስ ዎፋኖነ ኡርገ ዶርስ ያርሽያ ዎደ ካ ያርሾስ እስ እስ ታማነ ላፑን ክሎ ግራመ ግስተነ ሄ ሄ ልትሮ ዛይተ ሺሾ። ኡርገ ዶርሳታራ ሺቅያ ካ ያርሾይ ሀላቃይ ባዉ ሺሻናዉ ኮይዳይሳ መላ ግዶ። <verse eid="EZK 46:7"/><verse number="8" style="v" sid="EZK 46:8"/>ሀላቃይ ገልሸ፥ ድርሳ ፐንገ ባራንዳራ አድ ገሎ፤ ከይሸካ ያራ ከዮ።<verse eid="EZK 46:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 46:9"/>“አሳይ ባኣለ ጋላስ ጎዳ ጎይናናዉ ያ ዎደ ጎይናናዉ ፑደሀ ፐንግያራ ገልዳይሳት ጋርሳ ፐንግያራ ከዮ፤ ዱገሀ ፐንገራ ገልዳይሳት ፑደሀ ፐንገራ ከዮ። ኦንካ ባ ስንን ደእያ ፐንግያራ ስት ግድ ከዮፖ አትሽን፥ ባ ገልዳ ፐንግያራ ከዮፖ። <verse eid="EZK 46:9"/><verse number="10" style="v" sid="EZK 46:10"/>ኤንቲ ገልያ ዎደ፥ ሀላቃይ ኤንታራ ገሎ፤ ኤንቲ ከይያ ዎደ ኤንታራ ከዮ።<verse eid="EZK 46:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 46:11"/>“ኡፋይሳ ጋላሳታንነ ላይ ባለታን እስ እስ ኮርማራነ እስ እስ ማራዝያራ ሺቅያ ካ ያርሾይ እስ እስ ታማነ ላፑን ክሎ ግራመ ግስተራ ሄ ሄ ልትሮ ዛይተራ ግዶ። ቃስ ኡርገ ዶርሳራ ሺቅያ ያርሾይ ሀላቃይ ባዉ ሺሻናዉ ኮይዳይሳ መላ ግዶ። <verse eid="EZK 46:11"/><verse number="12" style="v" sid="EZK 46:12"/>ሀላቃይ ባ ዶሳን እምያ ያርሾ፥ ሄስካ ፁሳ ያርሾ ዎይኮ እስፈተ ያርሾ ጎዳስ ኤህያ ዎደ፥ ዶሎሀ ባጋ ድርሳ ፐንገይ እያዉ ዶየቶ። ባ ፁሳ ያርሹዋ ዎይኮ እስፈተ ያርሹዋ ሳምባታ ጋላስ እ ሺሸይሳዳ ሺሾ። እ ከይድ ብን፥ ድርሳ ፐንገይ ጎርደቶ።<verse eid="EZK 46:12"/></para>
  <para style="s1">ጋላሳ ያርሾ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 46:13"/>“ሀላቃይ ጋላስ ጋላስ ቦረይ ባይና እስ ላይ ግድዳ እስ ዶርሰ ፁሳ ያርሾ ኦድ፥ ጎዳስ ሺሾ፤ እ ሄሳ ዎንታ ጉራ ፓጨይ ባይና ኦ። <verse eid="EZK 46:13"/><verse number="14" style="v" sid="EZK 46:14"/>ሄሳዳካ ናምኡ ክሎ ግራመ ለይ እስ ልትሮ ዛይተራ ሙኑቀትድ፥ ዎንታ ጉራ ካ ያርሾ ግድድ ሺቆ። ሄስ ህንተ ጎዳስ ጋላስ ጋላስ ሺሽያ ያርሾ ዎጋ። <verse eid="EZK 46:14"/><verse number="15" style="v" sid="EZK 46:15"/>ሀይስ ኡርገ ዶርሳይ፥ ካነ ዛይተይ ፓጭ ባይና ዎንታ ዎንታ ፁሳ ያርሾ ግድድ ሺቃናዉ በሴስ” ያጌስ።<verse eid="EZK 46:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 46:16"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ሀላቃይ ባ ጋድያፐ ሻክድ፥ ባ አደ ናይታፐ እሱዋስ እምኮ፥ ሄስ ሄ ናኣስነ እያ ናይታስ ላታ ግዴስ። <verse eid="EZK 46:16"/><verse number="17" style="v" sid="EZK 46:17"/>ሽን ሀላቃይ ባ ጋድያፐ ሻክድ፥ ባ አይለታፐ እሱዋስ እምኮ፥ እሻታማን ላይ ባለይ ጋካናዉ፥ ሄ ጋደይ እያባ ግዴስ። ሄሳፈ ጉየ፥ ሀላቃስ ስሞ፤ ሄስ ሀላቃሳ ግድያ ግሾ፥ መርናዉ እያዉነ እያ ናይታስ ላታ ግዴስ። <verse eid="EZK 46:17"/><verse number="18" style="v" sid="EZK 46:18"/>ሀላቃይ አሰ ናቅድ፥ አሳ ላታ ጋድያ ዎልቃን ኤኮፎ። ታ አሳይ ባ ላታ ጋድያፐ ሾደቶና መላ እ ባ አደ ናይታስ ባ ጋድያፐ እሞ” ያጌስ።<verse eid="EZK 46:18"/></para>
  <para style="s1">ያርሾ ጊግስያ በሳታ</para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 46:19"/>ሄሳፈ ጉየ፥ ሄ ኡራይ ታና ቆሞ ባጋን ደእያ ካህነታ ክፍለታ ገልያ ፐንግያኮ ኤህስ። ሄሳት ግዶ ዳባባ ጋያ ጋርሳ ባጋ ድርሳ ፐንግያ ማታን ደኤይሳታ። ክፍለታፐ ዉሎሀ ባጋራ ታኒ እስ በሲ በአስ። <verse eid="EZK 46:19"/><verse number="20" style="v" sid="EZK 46:20"/>እ ታኮ፥ “ሀ በሳይ ካህነት ናጋራ ያርሾነ ናቆ ያርሾ አሹዋ ዶይስያ በስነ ካ ያርሾ ኡክያ በሲ። ሄ በሳን ጎኤትያ ጋሶይ አሳ ቆሆይ ጋኮና መላ ጌሻ ያርሹዋፈ ካረ ዳባባ ከየና” ያግስ።<verse eid="EZK 46:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 46:21"/>ሄሳፈ ጉየ፥ ሄ ኡራይ ታና ካረ ባጋ ዳባባ ኤፍድ፥ ዳባባ ኦይዱ ማዛነታ ዩሽድ በስስ። እስ እስ ማዛንያን ጉ ዳባብ ደኤስ። <verse eid="EZK 46:21"/><verse number="22" style="v" sid="EZK 46:22"/>ኦይዱ ማዛነታን ደእያ ዳባባት እስ ግና፤ ኤንቲ ኦይታሙ ዋ አዱሰ፤ ሀስታሙ ዋ ኦርደ። <verse eid="EZK 46:22"/><verse number="23" style="v" sid="EZK 46:23"/>ሄ ኦይዱ ዳባባታ ዩሾን ሹቻ ግምበይ ደኤስ፤ ግምብያ ጋርሳን ታማ ኤያ በሲ ደኤስ። <verse eid="EZK 46:23"/><verse number="24" style="v" sid="EZK 46:24"/>ሄ ኡራይ ታኮ፥ “ሀይስ ኡባይ ፆሳ ኬን ኦይሳት አሳይ ኤህያ ያርሹዋ ዶይስያ በሳታ” ያግስ።<verse eid="EZK 46:24"/></para>
  <chapter eid="EZK 46"/>
  <chapter number="47" style="c" sid="EZK 47"/>
  <para style="s1">ፆሳ ኬ ጋርሳፈ ፑልትያ ሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 47:1"/>ሄ ኡራይ ዛሪድ፥ ታና ፆሳ ኬ ገልያ ፐንግያኮ ኤፍስ። ፆሳ ኬ ገልያ ፐንግያፈ ጋርሳራ ሃ ፑልትድ፥ ፆሳ ኬፈ ዶሎሀ ባጋ ጎጌስ። ፆሳ ኬስ ጋርሳ ባጋራ ዱገ ጎግድ፥ ያርሾ በሳፈ ጋርሳ ባጋራ ካንስ። <verse eid="EZK 47:1"/><verse number="2" style="v" sid="EZK 47:2"/>እ ታና ቆሞ ፐንግያ ባጋራ ከስድ፥ ዶሎሀ ፐንግያኮ ዩሽስ። ሄ ፐንግያፈ ጋርሳ ባጋራ ሃ ጎጌስ።<verse eid="EZK 47:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 47:3"/>ሄ ኡራይ ዋ ዎዶሮ ባ ኩሸን ኦይክድ፥ ዶሎሀ ባጋ ብድ፥ ጎግያ ሃ ካልድ፥ እስ ሙኩሉ ዋስ። ታና ሃ ግዶራ ካለስ፤ ሃይ ታዉ ሹቁለ ጋክስ። <verse eid="EZK 47:3"/><verse number="4" style="v" sid="EZK 47:4"/>ዛሪድ እስ ሙኩሉ ዋድ፥ ሃ ግዶራ ታና ካለስ። ሃይ ታዉ ጉልባታ ጋክስ። ቃስ እስ ሙኩሉ ዋድ፥ ታና ሃ ግዶራ ካለስ። ሄ ዎደ ሃይ ታዉ ፄሰ ጋክስ። <verse eid="EZK 47:4"/><verse number="5" style="v" sid="EZK 47:5"/>እ ቃስ እስ ሙኩሉ ዋስ። ሽን ሄ ሃይ ዳሮ ጪሞ ግድያ ግሾ፥ ታ ፕናናዉ ዳንዳአብከ፤ እ አስ ዋና ፕናናዉ ዳንዳኦና ሻፋ ግድስ። <verse eid="EZK 47:5"/><verse number="6" style="v" sid="EZK 47:6"/>ሄ ኡራይ ታኮ፥ “አሳ ናአዉ፥ ሀይሳ አኬካዳ በአይ?” ያግስ።</para>
  <para style="p" vid="EZK 47:6">ሄሳፈ ጉየ፥ እ ታና ሻፋ ጋፃ ጉየ ዛርስ። <verse eid="EZK 47:6"/><verse number="7" style="v" sid="EZK 47:7"/>ታ ያ ጋክያ ዎደ ሻፋ ጋፃን ሀ ባጋራነ ያ ባጋራ ዳሮ ም ደኤይሳ በአስ። <verse eid="EZK 47:7"/><verse number="8" style="v" sid="EZK 47:8"/>እ ታኮ፥ “ሀ ሃይ ዶሎሀ ባጋ ጎግድ፥ አራበ ዛንጋራነ ማፅነ አባን ገሌስ። ሃይ ማፅነ አባ ገልያ ዎደ ማፅነ አባይ ኦራፅድ ፅሎ ሃ ግዴስ። <verse eid="EZK 47:8"/><verse number="9" style="v" sid="EZK 47:9"/>ሻፋይ ጎግድ ብያ በሳን ዱማ ዱማ መተት ደኦሶና። ሄ ሻፋይ ያራ ጎግያ ግሾነ ሄ ሃ ኦራድ ፅልስያ ግሾ ዳሮ ሞሎት ያን ደኦሶና። ሄሳ ግሾ ሃይ ጎግያ በሳን ደእያ መተት ኡባይ ደኦን ዳና። <verse eid="EZK 47:9"/><verse number="10" style="v" sid="EZK 47:10"/>ሞሎ ኦይክያ አሳት አባ ጋፃን ኤቃና፤ ኤንጋዳፐ ብድ ኤን ኤግላይማ ጋካናዉ ደእያ በሳይ ሞሎ ኦይካናዉ ግተ የግያ በሰ ግዳና። መደትራነ አባን ደእያ ሞሎታዳ፥ ያን ዳሮ ዱማ ዱማ ሞሎት ዳና። <verse eid="EZK 47:10"/><verse number="11" style="v" sid="EZK 47:11"/>ሽን አባ ጋፃን ደእያ ኤለይነ ጫፋ ሃይ ማፅነ ግድድ አታናፐ አትሽን፥ ኦራፅድ ፅለና። <verse eid="EZK 47:11"/><verse number="12" style="v" sid="EZK 47:12"/>ሄ ሻፋ ዶናን ሀ ባጋራነ ያ ባጋራ ሜተትያ አይፈ እምያ፥ ዱማ ዱማ ቆሞ ምት ደኦሶና። ኤንታ ሀይይ ቆቆፈተና፤ አይፈ አጎኮና። ፆሳ ኬፈ ከይያ ሃይ ኤንታኮ ጎግያ ግሾ፥ ኤንቲ አጌናን አጌናን ኦራ አይፈ አይፋና። ኤንቲ አይፍያ አይፈይ ካ ግዳና፤ ኤንታ ሀይይ ለ ግዳና” ያጌስ።<verse eid="EZK 47:12"/></para>
  <para style="s1">ቢታ ዛዋታ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 47:13"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታማነ ናምኡ እስራኤለ ዘረስ ላታ ቢታ ኦዳ፥ ነ ሻካና ዛዋይ ሀይሳ። ዮሰፋ ኮቻስ ናምኡ ሳም እመቶ። <verse eid="EZK 47:13"/><verse number="14" style="v" sid="EZK 47:14"/>ታኒ ካሰ ህንተ ማይዛታ ሀ ቢታ ላትሳናዉ ጫቃስ፤ ሀእ ህንተ ኡባይ ሻክድ ላትተ።<verse eid="EZK 47:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 47:15"/>“ፑደሀ ባጋ ቢታ ዛዋይ ሀይሳ፦ መደትራነ አባፈ ደንድድ፥ ሄትሎናነ ሀማታ ካንድ፥ ፀዳዳ ጋኬስ። <verse eid="EZK 47:15"/><verse number="16" style="v" sid="EZK 47:16"/>ዳማስቆፈነ ሀማታፐ ግዶን ደእያ በሮታነ ስብራይማ ካታማታ ካንድ፥ ሀዉራና ዛዋን ደእያ ትኮና ካታማ ጋኬስ። <verse eid="EZK 47:16"/><verse number="17" style="v" sid="EZK 47:17"/>እስራኤለ ቢታ ፑደሀ ባጋ ዛዋይ ሀማታ ቢታ ፑደሀ ባጋን አግድ፥ መደትራነ አባፈ ዶሎሀ ባጋ ብድ፥ ዳማስቆ ዛዋን ደእያ ሀፃር-ኤናና ካታማ ጋኬስ።<verse eid="EZK 47:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 47:18"/>“ዶሎሀ ባጋ ዛዋይ ሀፃር-ኤናናፐ ደንድድ፥ ዳማስቆፈነ ሀዉራናፐ ግዱዋራ ካንስ። እስራኤለፐነ ጋላዳፐ ግዶን ደእያ ዮርዳኖሰ ሻፋን ዛዋትድ ማፅነ አባ ካንድ ታማረ ካታማ ጋኬስ።<verse eid="EZK 47:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 47:19"/>“ዱገሀ ባጋ ዛዋይ ታማራፐ ደንድድ፥ ማርባ ቃደሳን ደእያ ሃ ጋኬስ። ያፐ ግብፀ ሻፋፐ ብድ መደትራነ አባ ጋኬስ። ሄስ ዱገሀ ዛዋ።<verse eid="EZK 47:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 47:20"/>“ዉሎሀ ባጋ ዛዋይ መደትራነ አባ ግድድ፥ ፑደሀ ባጋራ ሀማታ ስንራ ካንድ ዉሎሀ ባጋ ጋኬስ።<verse eid="EZK 47:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 47:21"/>“ሀ ቢታ እስራኤለ ዛረት ሻክድ ኤክተ። <verse eid="EZK 47:21"/><verse number="22" style="v" sid="EZK 47:22"/>ህንተነ ህንተ ግዶን ናአ የልድ ደእያ በተ አሳስ ላታ ቢታ ኦድ ሻክተ። ኤንታ ህንተ፥ ህንተ ቢታን የለትዳ እስራኤለ አሳዳ ፄልተ። ኤንቲ እስራኤለ ኮቻታራ ታይበትድ ቢታ ሳማን ሻከትድ ኤኮ። <verse eid="EZK 47:22"/><verse number="23" style="v" sid="EZK 47:23"/>በተ አስ እስራኤለን ኮቻራ አዉንካ ደእኮ፥ ሄ እ ደእያ ኮቻ ግዶን እያዉ ላታ ቢታ እምተ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="EZK 47:23"/></para>
  <chapter eid="EZK 47"/>
  <chapter number="48" style="c" sid="EZK 48"/>
  <para style="s1">ቢታ ሻሁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 48:1"/>“ቢታ ሻካናዉ ማዝጋበትዳ ኮቻታ ሱንይ ሀይሳ፦ ፑደሀ ባጋራ እስ ሳም ዳነ ኮቻስ እመቶ። ሄስካ ሄትሎናፐ ሀማታ ኤፍያ ኦግያ ካልድ፥ ያፐ ዳማስቆ ቢታን ደእያ ሀፃር-ኤናና ካታማ ጋኬስ። ሄስ ዶሎሀፐ ብድ ዉሎሀ ጋካናዉ ደእያ በሳስ ፑደሀ ባጋ ዛዋ ግዳና። <verse eid="EZK 48:1"/><verse number="2" style="v" sid="EZK 48:2"/>ዳነ ዛዋራ ኦይከትድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማይ አሴራ ኮቻስ እመቶ። <verse eid="EZK 48:2"/><verse number="3" style="v" sid="EZK 48:3"/>አሴራ ዛዋራ ኦይከትድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማይ ንፍታለመ ኮቻስ እመቶ። <verse eid="EZK 48:3"/><verse number="4" style="v" sid="EZK 48:4"/>ንፍታለመ ዛዋራ ኦይከትድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማይ ምናሰ ኮቻስ እመቶ። <verse eid="EZK 48:4"/><verse number="5" style="v" sid="EZK 48:5"/>ምናሰ ዛዋራ ኦይከትድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማይ ኤፍሬማ ኮቻስ እመቶ። <verse eid="EZK 48:5"/><verse number="6" style="v" sid="EZK 48:6"/>ኤፍሬማ ዛዋራ ኦይከትድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማይ ሮቤላ ኮቻስ እመቶ። <verse eid="EZK 48:6"/><verse number="7" style="v" sid="EZK 48:7"/>ሮቤላ ዛዋራ ኦይከትድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማይ ይሁዳ ኮቻስ እመቶ።<verse eid="EZK 48:7"/></para>
  <para style="s1">ቢታ ግና ግሸን ደእያ በሳ</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 48:8"/>“ይሁዳ ዛዋራ ኦይከትድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማ ዱማያ ዎ። እያ ጎምፓይ ታማነ ናምኡ ክሎ ምትረነ ባጋ ግዶ። ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ አዱሳተይ እስ ኮቻ ሻክን ጋክያ ሳማራ ግና። እያዉ ግዶ ግናን ፆሳ ኬ ደኤስ።<verse eid="EZK 48:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 48:9"/>“ሄ በሳፈ ኔኒ ጎዳስ ዱማያዳ ዎያ በሳይ ታማነ ናምኡ ክሎ ምትረነ ባጋ አዱሰነ ታሙ ክሎ ምትረ ዳልጋ ግዶ። <verse eid="EZK 48:9"/><verse number="10" style="v" sid="EZK 48:10"/>ሄ በሳፈ ባጋይ ካህነታስ ዱማትዳ በሰ ግዶ፤ እ ፑደሀ ባጋራ ታማነ ናምኡ ክሎ ምትረነ ባጋ አዱሰ፤ ዉሎሀ ባጋራነ ዶሎሀ ባጋራ እቻሹ ክሎ ምትረ ዳልጋ ግዶ። ፆሳ ኬይ እያዉ ግዶ ግናን ደኤስ። <verse eid="EZK 48:10"/><verse number="11" style="v" sid="EZK 48:11"/>ሀ ዱማትዳ በሳይ እስራኤለ አሳይ ታ ኦግያፐ ካረ ካረ ከይዳ ዎደ ኤንታራ ካረ ከይዳ ሌወታዳ ግዶና፥ አማነትድ ታዉ ኦሸ ጋምእዳ፥ ጌሻ ካህነታስ፥ ሳዶቃ ያራታስ እመቶ። <verse eid="EZK 48:11"/><verse number="12" style="v" sid="EZK 48:12"/>ሄስ ጎዳስ ዱማትዳ ቢታፈ ኤንታዉ ዱማ ግሾ፤ እ ኡባፈ ጌሻ በሲ። ኤንታ ዛዋይ ሌወታስ ሳማን እመቶ።<verse eid="EZK 48:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 48:13"/>“ካህነታ ዛዋራ ኦይከትድ፥ ሌወታስ አዱሳተይ ታማነ ናምኡ ክሎ ምትረ ባጋ፥ ዳልጋተይ እቻሹ ክሎ ምትረ ግድዳ እስ ሳም እመቶ። <verse eid="EZK 48:13"/><verse number="14" style="v" sid="EZK 48:14"/>ኤንቲ ሄ ቢታፈ ባይዛናዉ ዎይኮ ላማናዉ ኮሸና። ሄ ቢታይ ሎኦ ቢታ ግድያ ግሾ፥ ሀራ አሳ ኩሸን ገላናዉ በሰና፤ ጎዳስ እ ጌሻ በሰ።<verse eid="EZK 48:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 48:15"/>“አትዳ ናምኡ ክሎ ምትረነ ባጋ ዳልጋነ ታማነ ናምኡ ክሎ ምትረነ ባጋ አዱሳ በሳይ ካታማ አሳ ኡባይ ኬስነ መሄ ሄምያ በሰ ግዶ፤ ካታማይ ሄ ቢታ ግዶ ግናን ደኦ። <verse eid="EZK 48:15"/><verse number="16" style="v" sid="EZK 48:16"/>ሄ ካታማይ ኦይዱ ማዛነራ ደኤስ። ፑደሀ ባጋይ ኦይዱ ሙኩሉነ እቻሹ ፄቱ ዋ፤ ዱገሀ ባጋይ ኦይዱ ሙኩሉነ እቻሹ ፄቱ ዋ፤ ዶሎሀ ባጋይ ኦይዱ ሙኩሉነ እቻሹ ፄቱ ዋ፤ ዉሎሀ ባጋይ ኦይዱ ሙኩሉነ እቻሹ ፄቱ ዋ። <verse eid="EZK 48:16"/><verse number="17" style="v" sid="EZK 48:17"/>ካታማስ ሄን ጋደይ ደኦ፤ ሄ ጋደይ ፑደሀ ባጋራ፥ ዱገሀ ባጋራ፥ ዶሎሀ ባጋራነ ዉሎሀ ባጋራ ናምኡ ፄታነ እሻታሙ ዋ ዳልጋ ግዶ። <verse eid="EZK 48:17"/><verse number="18" style="v" sid="EZK 48:18"/>ፆሳ ኬይ ኬፀትድ ስምን፥ ጌሻ በሳን አትዳ በሳይ ዶሎሀ ባጋራ አዱሳተይ እቻሹ ክሎ ምትረ፤ ዉሎሀ ባጋራ አዱሳተይ እቻሹ ክሎ ምትረ ግዶ። አትዳ ቢታይ ሄ ካታማን ደእያ አሳስ ጎሻ ቢታ ግዳና። <verse eid="EZK 48:18"/><verse number="19" style="v" sid="EZK 48:19"/>ሄ ካታማን ደእያ እስራኤለ ዛረ ግድዳ ኦንካ ሄ ቢታ ጎ ያናዉ ዳንዳኤስ። <verse eid="EZK 48:19"/><verse number="20" style="v" sid="EZK 48:20"/>ህንተ ዱማያ በሳ ኦይዱ ማዛነይ ታማነ ናምኡ ክሎ ምትረነ ባጋ አዱቆ። ሄ በሳይ ካታማይ ኬፀትዳ በሳነ ጌሻ በሳ ጉጄስ።<verse eid="EZK 48:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 48:21"/>“ጌሻ በሳፈነ ካታማ በሳፈ አትዳ ቢታይ ሀላቃ ግሾ ግዶ። ሄስካ ታማነ ናምኡ ክሎ ምትረነ ባጋ ግድዳ ጌሻ በሳፈ ብድ ዶሎሀ ባጋ ዛዋ ጋኬስ። ዉሎሀ ባጋን ደእያ ታማነ ናምኡ ክሎ ምትረ ግድዳ ካታማ ቢታይ ዉሎሀ ባጋ ዛዋ ጋኬስ። ሄሳዳ ሀንድ ጌሻ በሳይነ ፆሳይ ኬይ ግዶን ግዳና። <verse eid="EZK 48:21"/><verse number="22" style="v" sid="EZK 48:22"/>ሄሳ ግሾ፥ ሌወታ ቢታይነ ካታማ ቢታይ ሀላቃስ እመትዳ ቢታፈ ግዶን ግዳና። ሄ ሀላቃ ቢታይ ፑደሀ ባጋራ ይሁዳ ላታን፥ ጋርሳ ባጋራ ብንያመ ላታን ዛዋቴስ።<verse eid="EZK 48:22"/></para>
  <para style="s1">አትዳ ኮቻታስ እመትዳ ቢታ</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 48:23"/>“አትዳ ኮቻታስ ቢታይ ሀይሳዳ ሀንድ ሻከትስ። ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማይ ብንያመ ኮቻስ እመቶ። <verse eid="EZK 48:23"/><verse number="24" style="v" sid="EZK 48:24"/>ብንያመ ዛዋራ ኦይከትድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማይ ስሞና ኮቻስ እመቶ። <verse eid="EZK 48:24"/><verse number="25" style="v" sid="EZK 48:25"/>ስሞና ዛዋራ ኦይከትድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማይ ይሳኮራ ኮቻስ እመቶ። <verse eid="EZK 48:25"/><verse number="26" style="v" sid="EZK 48:26"/>ይሳኮራ ዛዋራ ኦይከትድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማይ ዛብሎና ኮቻስ እመቶ። <verse eid="EZK 48:26"/><verse number="27" style="v" sid="EZK 48:27"/>ዛብሎና ዛዋራ ኦይከትድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ እስ ሳማይ ጋደ ኮቻስ እመቶ። <verse eid="EZK 48:27"/><verse number="28" style="v" sid="EZK 48:28"/>ጋደ ዱገሀ ዛዋይ ታማራ ካታማፐ ደንድድ፥ ማርባ ቃደሳን ደእያ ፑልቷ ጋክድ፥ ግብፀ ሻፋ ካልድ፥ መደትራነ አባ ጋኬስ።<verse eid="EZK 48:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 48:29"/>“ህንተ እስራኤለ አሳስ ሻካና ቢታይ ሀይሳ፤ ሄስ ኤንታ ግሹዋ” ያግድ ኡባ ሃርያ ጎዳይ ኦድስ።<verse eid="EZK 48:29"/></para>
  <para style="s1">ካታማ ፐንገታ</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 48:30"/>ካታማፐ ከይያ ፐንገት ሀይሳታ። ፑደሀ ባጋራ ደእያ ኦይዱ ሙኩሉነ እቻሹ ፄቱ አዱቅያ ፐንግያፈ ዶምድ፥ <verse eid="EZK 48:30"/><verse number="31" style="v" sid="EZK 48:31"/>ካታማ ፐንገት እስራኤለ ኮቻታ ሱንን ፄገታና። ፑደሀ ባጋራ ደእያ ሄ ፐንገት ሮቤላ ፐንገ፥ ይሁዳ ፐንገነ ሌወ ፐንገ ግዳና። <verse eid="EZK 48:31"/><verse number="32" style="v" sid="EZK 48:32"/>ዶሎሀ ባጋራ ኦይዱ ሙኩሉነ እቻሹ ፄቱ ዋ አዱቅያ ሄ ፐንገት፥ ዮሰፋ ፐንገ፥ ብንያመ ፐንገነ ዳነ ፐንገ ግዳና። <verse eid="EZK 48:32"/><verse number="33" style="v" sid="EZK 48:33"/>ዱገሀ ባጋራ ኦይዱ ሙኩሉነ እቻሹ ፄቱ አዱቅያ ሄ ፐንገት፥ ስሞና ፐንገ፥ ይሳኮራ ፐንገነ ዛብሎና ፐንገ ግዳና። <verse eid="EZK 48:33"/><verse number="34" style="v" sid="EZK 48:34"/>ዉሎሀ ባጋራ ኦይዱ ሙኩሉነ እቻሹ ፄቱ ዋ አዱቅያ ሄ ፐንገት፥ ጋደ ፐንገ፥ አሴራ ፐንገነ ንፍታለመ ፐንገ ግዳና።<verse eid="EZK 48:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 48:35"/>“ካታማ ዩሾይ ኩመ ዋን፥ ታማነ ሆስፑን ሙኩሉ ዋ ግዳና። ሄ ዎደፐ ዶምድ ሄ ካታማይ፥ ‘ጎዳይ ያን ደኤስ’ ጌተትድ ፄገታና” ያጌስ።<verse eid="EZK 48:35"/></para>
  <chapter eid="EZK 48"/>
</usx>
