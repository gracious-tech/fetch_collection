<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ማቶሳ ዎንገላ</para>
  <para style="toc1">ማቶሳ ዎንገላ</para>
  <para style="toc3">ማቶ</para>
  <para style="toc2">ማቶሳ</para>
  <para style="mt1">ማቶስ ፃፍዳ</para>
  <para style="mt2">የሱስ ክርስቶሳ ዎንገላ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ማቶሳ ዎንገላይ፥ ያና ጌተትድ ኡፋይሳን ናገተይ አሽያ የሱሳ ግደይሳነ ፆሳይ ጋልአ ጫቁዋን ባ አሳስ እምዳ ኡፋይሳ ቃላ ፖልዳይ እያ ባጋራ ግደይሳ ኦድያ ዎንገላ። ሀ ዎንገላይ የሱሲ ኤንታ ግዶን የለትድ ድጭዳ አይሁደታ ፃላላስ ግዶናሽን፥ ኩመ አላምያሳ።</para>
  <para style="ip">ማቶስ ባ ማፃፋ የሱሳ የለተን ዶምድ፥ እያ ፃማቀተነ እያ ፓጨተ ኦዴስ። ካልድ፥ እ ጋልላን ሳባክዳባ፥ ታማርስዳባነ ሀርጋንቾታ ፓዳባ ኦዴስ። የሱሲ ጋልላፐ የሩሳላመ ብዳይሳነ ሳአ ቦላ ደእሸ ዉርሰ ሳምንታን ሀንዳባታ፥ ሄስካ፦ እያ ካቀተ፥ እያ ሀይቁዋነ እያ ደንዱዋ ቆንጭሴስ።</para>
  <para style="ip">ሀ ዎንገላይ፥ የሱሲ ፆሳ ህገ ብርሻናዉ ማት ደኤይሳነ ፆሳ ካዎተባ ታማርስያ ግታ አስታማረ ኦድ ኤኬስ። እያ ትምርተይ፥ ዱማ ዱማ ማራን ጊገትዳ እቻሹ ክፍለታን ሻከቴስ።</para>
  <para style="ipi">1. ፆሳ ካዎተን ደእያ አሳ ሀኖታ፥ ማታነ ዉርሰ ቃዳ ኦድያ ዙማ ቦላ ትምርትያ (ሸም 5—7)።</para>
  <para style="ipi">2. ታማነ ናምኡ ታማረት ዎንገላ ኦዳናዉ ብያ ዎደ ኤንታዉ እመትዳ ኪታ (ሸም 10)።</para>
  <para style="ipi">3. ፆሳ ካዎተባ ታማርሳናዉ ሺቅዳ ዱማ ዱማ ሌምሶታ (ሸም 13)።</para>
  <para style="ipi">4. የሱሳ ታማረ ገይሳስ ብርሸይ አይ ጉሰኮ ታማርስያ ትምርተ (ሸም 18)።</para>
  <para style="ipi">5. ዎደ ዉርሰነ ፆሳ ካዎተ ዩሳባ ኦድያ ትምርተ (ሸም 24—25)።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">የሱስ ክርስቶሳ የለተነ እያ ሱሳ (<char style="ior"><ref loc="MAT 1:1-2:23">1:1—2:23</ref></char>)</para>
  <para style="io1">ፃማቅያ ዮሃንሳ ኦሱዋ (<char style="ior"><ref loc="MAT 3:1-12">3:1-12</ref></char>)</para>
  <para style="io1">የሱሳ ፅንቃተነ ፓጨተ (<char style="ior"><ref loc="MAT 3:13-4:11">3:13—4:11</ref></char>)</para>
  <para style="io1">የሱሲ ጋልላን ባ ኦሱዋ ኦይከ (<char style="ior"><ref loc="MAT 4:12-18:35">4:12—18:35</ref></char>)</para>
  <para style="io1">ጋልላፐ የሩሳላመ ጋካናዉ (<char style="ior"><ref loc="MAT 19:1-20:34">19:1—20:34</ref></char>)</para>
  <para style="io1">የሩሳላመ ሄራን አድ ዉርሰ ሳምንታ (<char style="ior"><ref loc="MAT 21:1-27:66">21:1—27:66</ref></char>)</para>
  <para style="io1">ጎዳ ሀይቆፐ ደንዱዋነ አሳስ ቆንጨ (<char style="ior"><ref loc="MAT 28:1-20">28:1-20</ref></char>)</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">የሱሳ የለታ ሱሳ</para>
  <para style="r">(<ref loc="LUK 3:23-38">ሉቃ 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>ሀይሳፈ ካልድ ፃፈትዳይስ ዳዊታ ናአ አብራሃመ ናአ ግድዳ የሱስ ክርስቶሳ የለተ።<verse eid="MAT 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2"/>አብራሃመይ ይሳቃ የልስ፤</para>
  <para style="q1" vid="MAT 1:2">ይሳቅ ያይቆባ የልስ፤</para>
  <para style="q1" vid="MAT 1:2">ያይቆብ ይሁዳነ እያ እሻታ የልስ፤<verse eid="MAT 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 1:3"/>ይሁድ ትማርፐ ፋረሳነ ዛራ የልስ፤</para>
  <para style="q1" vid="MAT 1:3">ፋረስ አስሮመ የልስ፤</para>
  <para style="q1" vid="MAT 1:3">አስሮመይ ራመ የልስ፤<verse eid="MAT 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 1:4"/>ራመይ አምናዳበ የልስ፤</para>
  <para style="q1" vid="MAT 1:4">አምናዳበይ ናአሶና የልስ፤</para>
  <para style="q1" vid="MAT 1:4">ናአሶን ሳልሞና የልስ፤<verse eid="MAT 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 1:5"/>ሳልሞና ራብፐ ቦኤዛ የልስ፤</para>
  <para style="q1" vid="MAT 1:5">ቦኤዝ ኡሩትፐ እዮቤዳ የልስ፤</para>
  <para style="q1" vid="MAT 1:5">እዮቤድ እሰየ የልስ፤<verse eid="MAT 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 1:6"/>እሰየይ ካዋ ዳዊታ የልስ፤</para>
  <para style="q1" vid="MAT 1:6">ዳዊቲ ኮይሮ ኦርዮ ማቸፈ ሶሎሞነ የልስ፤<verse eid="MAT 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 1:7"/>ሶሎሞነይ ኦሮብኣማ የልስ፤</para>
  <para style="q1" vid="MAT 1:7">ኦሮብኣመይ አብያ የልስ፤</para>
  <para style="q1" vid="MAT 1:7">አብይ አሳፋ የልስ፤<verse eid="MAT 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 1:8"/>አሳፍ እዮሳፈፃ የልስ፤</para>
  <para style="q1" vid="MAT 1:8">እዮሳፈፅ እዮራማ የልስ፤</para>
  <para style="q1" vid="MAT 1:8">እዮራም ኦዝያና የልስ፤<verse eid="MAT 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 1:9"/>ኦዝያን እዮአታመ የልስ፤</para>
  <para style="q1" vid="MAT 1:9">እዮአታም አካዛ የልስ፤</para>
  <para style="q1" vid="MAT 1:9">አካዝ ህዝቅያሳ የልስ፤<verse eid="MAT 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 1:10"/>ህዝቅያስ ምናሰ የልስ፤</para>
  <para style="q1" vid="MAT 1:10">ምናሰይ አሞነ የልስ፤</para>
  <para style="q1" vid="MAT 1:10">አሞን እዮስያሳ የልስ፤<verse eid="MAT 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 1:11"/>እስራኤለ አሳይ ድኤትድ ባብሎነ ቢታ ብዳ ዎደ እዮስያስ እኮንያናነ እያ እሻታ የልስ።<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 ካዎ 24:14-15</ref>፤ <ref loc="2CH 36:10">2 ታር 36:10</ref>፤ <ref loc="JER 27:20">ኤርም 27:20</ref>.</char></note><verse eid="MAT 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 1:12"/>ባብሎነ ቢታ እስራኤለ አሳይ ድኤትድ ብዳፐ ጉየ እኮንያን ሳላትያላ የልስ።</para>
  <para style="q1" vid="MAT 1:12">ሳላትያል ዛሩባበላ የልስ፤<verse eid="MAT 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 1:13"/>ዛሩባበል አብድዩ የልስ፤</para>
  <para style="q1" vid="MAT 1:13">አብድዩይ ኤልያቄመ የልስ፤</para>
  <para style="q1" vid="MAT 1:13">ኤልያቄም አዛራ የልስ፤<verse eid="MAT 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MAT 1:14"/>አዛር ሳዶቃ የልስ፤</para>
  <para style="q1" vid="MAT 1:14">ሳዶቅ አክመ የልስ፤</para>
  <para style="q1" vid="MAT 1:14">አክመይ ኤልዩዳ የልስ፤<verse eid="MAT 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 1:15"/>ኤልዩድ አላዛራ የልስ፤</para>
  <para style="q1" vid="MAT 1:15">አላዛር ማታነ የልስ፤</para>
  <para style="q1" vid="MAT 1:15">ማታነይ ያይቆባ የልስ፤<verse eid="MAT 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 1:16"/>ያይቆብ ዮሰፋ የልስ፤</para>
  <para style="q1" vid="MAT 1:16">ዮሰፍ ክርስቶሳ ጌተትያ የሱሳ የልዳ ማይራም አዝና።<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>ህዛ፥ የለተይ አብራሃመፐ ዳዊታ ጋካናዉ ታማነ ኦይዳ። ዳዊታፐ ብድ ባብሎነ ድኡዋ ጋካናዉ ታማነ ኦይዳ። ባብሎነ ድኡዋፐ ብድ ክርስቶሳ ጋካናዉ ታማነ ኦይዱ የለተ ግዴስ።<verse eid="MAT 1:17"/></para>
  <para style="s1">የሱስ ክርስቶሳ የለተ</para>
  <para style="r">(<ref loc="LUK 2:1-7">ሉቃ 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>የሱስ ክርስቶሳ የለተ ታርከይ ሀይሳፈ ካለይሳ። እያ አይያ ማይራማ ዮሰፋስ ኦይሸታ ደአሸ ዮሰፋራ ጋሄቶና ጌሻ አያናፐ ቃንታሱ።<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="LUK 1:27">ሉቃ 1:27</ref>.</char></note> <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>ዮሰፍ ፅሎ አስ ግድዳ ግሾ እዮ አሳን ከሳናዉ ኮይቤና። ያንያ ግሾ ቆሳን እዮ አጋናዉ ቆፕስ። <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>እ ሄ ቆፋን ደእሽን ፆሳ ኪታንቾይ አሙሆን ቆንጭድ፥ “ዳዊታ ናአዉ፥ ዮሰፋ፥ ማይራማ ቃንትዳይ ጌሻ አያናፐ ግድያ ግሾ እዮ ኤካናዉ ያዮፋ” ያግስ። <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>እያ አደ ናአ የላና፥ እ ባ ደርያ ኤንታ ናጋራፐ አሽያ ግሾ እያ ሱን ነ የሱሳ ጋዳ ፄጋና።<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">ሉቃ 1:31</ref>.</char></note><verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>ጎዳይ ናብያ እሳያሳ ዶናን፥ <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>“ሄኮ ጌላእያ ቃንታና፤ አደ ናአ የላና፤ እያ ሱንይ አማኑኤላ” ጌተታና ጎይስ ፖለታና መላ ሀ ኡባይ ሀንስ። አማኑኤላ ገይሳስ ብርሸይ “ፆሳይ ኑራ ደኤስ” ጉሱ።<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">እሳ 7:14</ref>.</char></note><verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>ዮሰፍ ስኮፈ ባርክድ ጎዳ ኪታንቾይ ኪትዳይሳ መላ ማይራሞ ባ ሶ ኤፍስ። <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>ሽን ባ ባይራ ናአ የላና ጋካናዉ እዮ ቦችቤና፤<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="fk" closed="false">እዮ ቦችቤና፦ </char><char style="ft" closed="false">ማችራ አዝናራ አቀይሳዳ እስፈ አቅቦኮና ጉሱ።</char></note> የለትዳ ናአካ የሱሳ ግድ ፄግስ።<note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">ሉቃ 2:21</ref>.</char></note><verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">ዶሎሀፐ ይዳ አሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>ካዋ ሄሮዲሳ ዎደን የሱሲ ይሁዳ ቢታን ቤተለመ ካታማን የለትዳፐ ጉየ ፆልንቶ ታይብያ አሳት ዶሎሀፐ የሩሳላመ ይድ፥ <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>“የለትዳ አይሁደ ካዎይ አዉን ደኢ? ኑኒ ዶሎሀ ባጋራ ከይዳ እያ ፆልንቱዋ በእድ እያዉ ጎይናናዉ ይዳ” ያግድ ኦይችዶሶና። <verse eid="MAT 2:2"/><verse number="3" style="v" sid="MAT 2:3"/>ካዎይ ሄሮዲስ ሄሳ ስእዳ ዎደ ዳጋምስ። የሩሳላመን ደእያ አሳ ኡባይካ ዳጋምዶሶና። <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>ሄሮዲስ ካህነ ሀላቃታነ ህገ አስታማረታ ባኮ ፄግድ፥ “ክርስቶስ አዉን የለታንደሻ?” ያግድ ኤንታ ኦይችስ።<verse eid="MAT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5"/>ኤንትካ፥ “ይሁዳ ቤተለመና፤ ናበይ፥<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>‘ይሁዳን ደእያ ቤተለመ፥<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">ምክ 5:2</ref>.</char></note></para>
  <para style="q2" vid="MAT 2:6">ይሁዳን ደእያ ጎባ ካታማታፐ፥</para>
  <para style="q2" vid="MAT 2:6">ኔኒ አይብንካ ጉፃካ።</para>
  <para style="q1" vid="MAT 2:6">ታ ደርያ እስራኤለ አይሳናይስ፥</para>
  <para style="q2" vid="MAT 2:6">ኔፐ ከያና’ ግድ ፃፍስ”</para>
  <para style="m" vid="MAT 2:6">ያግዶሶና።<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>ሄሳፈ ጉየ፥ ሄሮዲስ ዶሎሀፐ ይዳ አሳታ ጌማን ፄግድ፥ ፆልንቱዋ ኤንቲ በእዳ ዎድያ ኤንታፈ ጌሽድ ኤርስ። <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>እ ኤንታና ቤተለመ የድሸ፥ “ብድ የለትዳ ናኣ ምንድ ኮይተ፤ እያ ህንተ ደምዳ ዎደ ታካ ባዳ እያዉ ጎይናና መላ ስሚድ ይሸ ታዉ ኦድተ” ያግስ። <verse eid="MAT 2:8"/><verse number="9" style="v" sid="MAT 2:9"/>ኤንትካ ካዎይ ሄሮዲስ ግዳይሳ ስእድ ብዶሶና። ኤንቲ ዶሎሀ ባጋራ በእዳ ፆልንቶይ ኤንታና ካለሸ ናአይ ደእያሱዋ ጋካናዉ ኤፍስ። <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>ኤንቲ ሄ ፆልንቱዋ በእዳ ዎደ ግታ ኡፋይስ ኡፋይትዶሶና። <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>ሶ ገልድ ናኣ ባ አየ ማይራምራ ደኤይሳ በእዶሶና። እያዉ ጉልባትድ ጎይንዶሶና። ባንታ ሳፅንያ ዶይድ ዎርቃ፥ እፃነነ ካርበ እያዉ እምዶሶና። <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>ኤንቲ ሄሮዲሳኮ ጉየ ስሞና መላ ፆሳይ አሙሆን ኤንታዉ ኦድን፥ ሀራ ኦገራ ባንታ ቢታ ስምዶሶና።<verse eid="MAT 2:12"/></para>
  <para style="s1">ግብፀ ባቃቶ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>ዶሎሀ ባጋፈ ይዳ አሳት ብዳፐ ጉየ፥ ጎዳ ኪታንቾይ ዮሰፋስ አሙሆን ቆንጭድ፥ “ሄሮዲስ ናኣ ዎናዉ ኮይያ ግሾ ደንዳ፤ ኤለሳዳ ናኣነ ናኣ አይዉ ኤካዳ ግብፀ ቢታ ባ። ነ ስማና ዎድያ ታ ነዉ ኦዳና ጋካናዉ ያን ጋምአ” ያግስ።<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>ሄሳ ግሾ፥ ዮሰፍ ሄ ቃማን ደንድድ፥ ናኣነ ናኣ አይዉ ኤክድ ግብፀ ብስ። <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>ናብያ ዶናን ፆሳይ፥ “ታኒ፥ ታ ናኣ፥ ግብፀ ቢታፈ ፄጋስ”<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">ሆሰ 11:1</ref>.</char></note> ጌተትዳ ቃላይ ፖለታና መላ ሄሮዲስ ሀይቃና ጋካናዉ እ ያን ደእስ።<verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>ሄሳፈ ጉየ፥ ዶሎሀ ባጋፈ ይዳ አሳት እያ ጭምዳይሳ ኤርዳ ዎደ ዳሮ ይሎትስ። እ ካሰ ኤንታፈ ስእዳይሳዳ ቤተለመንነ ሄ ሄራን ደእያ ናምኡ ላይ ኩምዳይሳታነ ናምኡ ላይፈ ጋርሳን ደእያ አደ ናይታ ኡባ ባ ዎታዳረታ የድድ ዎስስ።<verse eid="MAT 2:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" sid="MAT 2:17-18"/>ናብያ ኤርምያሳ ዶናን፥</para>
  <para style="q1" vid="MAT 2:17-18">“ዬሆይነ ዘለልስ፥</para>
  <para style="q2" vid="MAT 2:17-18">ራማ ካታማን ስኤትስ።</para>
  <para style="q1" vid="MAT 2:17-18">ራሄላ ባ ናይታስ ዬካዉሱ፤</para>
  <para style="q2" vid="MAT 2:17-18">ኤንቲ ሀይቅዳ ግሾ</para>
  <para style="q2" vid="MAT 2:17-18">ምነታናዉ ዳንዳአቡኩ”</para>
  <para style="m" vid="MAT 2:17-18">ግድ ኦድዳይስ ፖለትስ።<note caller="-" style="x"><char style="xo" closed="false">2:17-18 </char><char style="xt" closed="false"><ref loc="JER 31:15">ኤርም 31:15</ref>.</char></note><verse eid="MAT 2:17-18"/></para>
  <para style="s1">ናዝረተ ስሙዋ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>ሄሮዲስ ሀይቅዳፐ ጉየ ግብፀን ጎዳ ኪታንቾይ ዮሰፋስ አሙሆን ቆንጭድ፥ <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>“ናኣ ዎናዉ ኮይያ አሳት ሀይቅዳ ግሾ፥ ደንዳዳ ናኣነ ናኣ አይዉ ኤካዳ እስራኤለ ቢታ ስማ” ያግስ።<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>ዮሰፍ ደንድድ ናኣነ ናኣ አይዉ ኤክድ እስራኤለ ቢታ ስምስ። <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>ሽን አርከልዮስ ይሁዳን ባ አዋ ሄሮዲሳ በሳን ካዎትዳይሳ ስእዳ ዎደ ያ ባናዉ ያይስ። ፆሳይ አሙሆን እያዉ ቆንጭስን ጋልላ ቢታ ብስ። <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>ናበታ ዶናን፥ “ናዝረተ አስ ጌተታና” ግድ ኦደትዳይስ ፖለታና መላ ናዝረተ ካታማ ብድ ያን ደእስ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:24">ማር 1:24</ref>፤ <ref loc="LUK 2:39">ሉቃ 2:39</ref>፤ <ref loc="JHN 1:45">ዮሀ 1:45</ref>.</char></note><verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">ፃማቅያ ዮሃንስ ኦገ ጊግሷ</para>
  <para style="r">(<ref loc="MRK 1:1-8">ማር 1:1-8</ref>፤ <ref loc="LUK 3:1-17">ሉቃ 3:1-17</ref>፤ <ref loc="JHN 1:19-28">ዮሀ 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1-2" style="v" sid="MAT 3:1-2"/>ሄ ዎደ ፃማቅያ ዮሃንስ፥ “ፆሳ ካዎተይ ማታትዳ ግሾ ህንተ ናጋራፐ ስምተ” ያግድ ሳባክሸ ይሁዳ መላ ቢታ ብስ።<note caller="-" style="x"><char style="xo" closed="false">3:1-2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">ማቶ 4:17</ref>፤ <ref loc="MRK 1:15">ማር 1:15</ref>.</char></note> <verse eid="MAT 3:1-2"/><verse number="3" style="v" sid="MAT 3:3"/>ናብያ እሳያስ ዮሃንሳባ ኦድዳይሳ መላ፥</para>
  <para style="q1" vid="MAT 3:3">“መላ ቢታን፥</para>
  <para style="q2" vid="MAT 3:3">እሶይ ባ ቃላ ቁ ኦድ፥</para>
  <para style="q1" vid="MAT 3:3">‘ጎዳ ኦግያ ጊግስተ።</para>
  <para style="q1" vid="MAT 3:3">እያ ሆሮጋ ፕድ ኦተ’ ግስ”<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">እሳ 40:3</ref>.</char></note></para>
  <para style="m" vid="MAT 3:3">ያገትዳይ እያሳ ያግስ።<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>ዮሃንስ ግማለ እክሰፐ ኦሰትዳ አፍላ ማኤስ። ባ ፄሳን ዳፎ ዳንጬስ። እ ምያ ካይካ ቦለነ ደገራ ኤስ።<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ካዎ 1:8</ref>.</char></note> <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>አሳይ ሄ ዎደ የሩሳላመ ካታማፐ፥ ይሁዳ ቢታ ኡባፈነ ዮርዳኖሰ ሻፋ ሄራፐ እያኮ ዮሶና። <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>ባንታ ናጋራ ፓፅድ ዮርዳኖሰ ሻፋን ዮሃንሳ ኩሸን ፃማቀቶሶና።<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>ዮሃንስ፥ ዳሮ ፋርሳወትነ ሳዱቃወት ፃማቀታናዉ ባኮ የይሳታ በእድ፥ ኤንታኮ፥ “ሀ ኢታ ሾሻቶ፥ ያና ፆሳ ሀንቁዋፈ ባቃታና መላ ህንተና ኦነ ዞርዳይ?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ 12:34</ref>፤ <ref loc="MAT 23:33">23:33</ref>.</char></note> <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>ህዛ፥ ህንተ፥ ህንተ ናጋራፐ ስምዳይሳ ኤርስያባ ኦተ። <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>ህንተ፥ ህንተ ዎዛናን፥ ‘አብራሃመይ፥ ኑ አዋይ ደኤስ’ ግድ ቆፖፍተ። ሎይ ስእተ! ፆሳይ ሀ ሹቻታፐ አብራሃመስ ናአ ከሳናዉ ዳንዳኤስ።<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">ዮሀ 8:33</ref>.</char></note> <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>ቤፀይ ም ፃጶን ጊግድ ኡትስ፤ ሎኦ አይፈ አይፎና ም ኡባይ ቃንፀትድ ታማን የገታና።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶ 7:19</ref>.</char></note><verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>“ህንተ፥ ህንተ ናጋራፐ ስምዳይሳ ኤርሳናዉ ታኒ ህንተና ሃን ፃማቃይስ። ሽን ታፐ ጉየራ የይስ ህንተና ጌሻ አያናንነ ታማን ፃማቃና። እ ታፐ ዳሮ ዎልቃሜስ፤ ታኒ ሀር አቶሽን እያ ጫማ ቶካናዉካ በስከ። <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>ካ ጌሽያ ፕይ እያ ኩሸን ደኤስ። ካ ሎይ ጌሼስ፤ ግስትያ ባ ሻልያን ቆላና፥ ሽን ፑኑዋ ቶኦና ታማን ፁጋና” ያግስ።<verse eid="MAT 3:12"/></para>
  <para style="s1">የሱሳ ፃማቀተ</para>
  <para style="r">(<ref loc="MRK 1:9-11">ማር 1:9-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>ሄ ዎደ የሱሲ ዮሃንሳ ኩሸን ፃማቀታናዉ ጋልላፐ ዮርዳኖሰ ሻፋ ብስ። <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>ሽን ዮሃንስ እያ ድጋናዉ ኮይድ፥ “ታኒ ነናን ፃማቀታናዉ ኮሽሽን ኔኒ ታኮ ያይ?” ያግስ። <verse eid="MAT 3:14"/><verse number="15" style="v" sid="MAT 3:15"/>ሽን የሱሲ ዛሪድ፥ “ፆሳይ ኑፐ ኮያባ ኡባ ኑ ፖላናዉ በሲያ ግሾ፥ ሀእ ታዉ ኤሮ ጋ” ያግስ። ዮሃንስ እያዉ ኤሮ ግድ ኤክስ። <verse eid="MAT 3:15"/><verse number="16" style="v" sid="MAT 3:16"/>የሱሲ ፃማቀትዳ መላ ሃፈ ከይስ። ኢራካ ሳሎይ ዶየትን ፆሳ አያናይ ሆለዳ ይሽን ቃስ ባ ቦላ ዎልአምድ ዎሽን በእስ። <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>ሄ ዎደ፥ “ታ ዶስያ፥ እያን ታና ኡፋይስያ ታ ናአይ ሀይሳ” ግያ ቃላይ ሳሎፐ ይስ።<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="MAT 12:18">ማቶ 12:18</ref>፤ <ref loc="MAT 17:5">17:5</ref>፤ <ref loc="MRK 1:11">ማር 1:11</ref>፤ <ref loc="LUK 9:35">ሉቃ 9:35</ref>.</char></note><verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">የሱሳ ፓጨተ</para>
  <para style="r">(<ref loc="MRK 1:12-13">ማር 1:12-13</ref>፤ <ref loc="LUK 4:1-13">ሉቃ 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>ሄሳፈ ጉየ፥ ፃላሄይ የሱሳ ፓጫና መላ ጌሻ አያናይ የሱሳ መላ ቢታ ኤፍስ።<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">እብራ 2:18</ref>፤ <ref loc="HEB 4:15">4:15</ref>.</char></note> <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>ኦይታሙ ቃማነ ኦይታሙ ጋላስ ፆምዳፐ ጉየ ኮሻትስ። <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>ፃላሄይ የሱሳኮ ይድ “ኔኒ ፆሳ ናአ ግድኮ፥ አነ ሀ ሹቻት ኡይ ግዳና መላ ኪታ” ያግስ።<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>የሱሲ ዛሪድ፥ “ ‘አስ ፆሳ ዶናፐ ከይያ ቃላ ኡባን ደኤስፐ አትሽን፥ ኡይ ፃላላን ዴና’ ጌተትድ ፆሳ ቃላን ፃፈትስ”<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ዛረ 8:3</ref>.</char></note> ያግስ።<verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>ካልድካ፥ ፃላሄይ የሱሳ ጌሻ ካታማ ኤፍድ፥ ፆሳ ኬ ሁጵያ ከስድ፥ <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>“ኔኒ ፆሳ ናአ ግድኮ፥ አነ ዱገ ሳአን ኩንዳ።<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11">ማዝ 91:11</ref>.</char></note></para>
  <para style="q1" vid="MAT 4:6">“ ‘ነ ቶሆይ ሹቻን በቶና መላ፥</para>
  <para style="q2" vid="MAT 4:6">ባንታ ኩሽያን ነና ደንና መላ፥</para>
  <para style="q2" vid="MAT 4:6">ፆሳይ ባ ኪታንቾታ ነ ግሾ ኪታና’</para>
  <para style="m" vid="MAT 4:6">ጌተትድ ፆሳ ቃላን ፃፈትስ” ያግስ።<verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>የሱሲ እያኮ፥ “ቃስካ፥ ‘ፆሳ ቃላን ነ ጎዳ፥ ነ ፆሳ ፓጮፋ’ ያገትድ ፃፈትስ” ግድ ዛርስ።<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">ዛረ 6:16</ref>.</char></note><verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>ዉርሰን ፃላሄይ የሱሳ እስ ዎልቃማ ዙማ ሁጰ ከስድ አላምያ ካዎተታ ኤንታ ቦንቹዋራ እስፈ በስድ፥ <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>“ነ ታዉ ኩንዳዳ ጎይንኮ ታ ነዉ ሀ ኡባ እማና” ያግስ።<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>የሱሲ ዛሪድ፥ “ሀ ፃላህያዉ፥ ታፐ ሃካ! ‘ነ ጎዳ፥ ነ ፆሳ ጎይና፥ እያ ፃላላ ሀጋዛ’ ጌተትድ ፆሳ ቃላን ፃፈትስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ዛረ 6:13</ref>.</char></note><verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>ሄሳፈ ጉየ፥ ፃላሄይ አግድ ብስ፤ ኪታንቾት ይድ እያ ሀጋዝዶሶና።<verse eid="MAT 4:11"/></para>
  <para style="s1">የሱሳ ታማርሶ ዶመ</para>
  <para style="r">(<ref loc="MRK 1:14-15">ማር 1:14-15</ref>፤ <ref loc="LUK 4:14-15">ሉቃ 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>የሱሲ፥ ዮሃንስ ቃሸቶይሳ ስእዳ ዎደ ጋልላ ቢታ ብስ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">ማቶ 14:3</ref>፤ <ref loc="MRK 6:17">ማር 6:17</ref>፤ <ref loc="LUK 3:19-20">ሉቃ 3:19-20</ref>.</char></note> <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>ናዝረተ ካታማ አግድ ዛብሎናንነ ንፍታለመ ሄራን፥ አባ ማታን ደእያ ቅፍርናሆማ ካታማ ብድ ያን ደእስ።<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">ዮሀ 2:12</ref>.</char></note> <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>ሄስ ሀንዳይ ናብያ እሳያሳ ዶናን፥<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>“ዛብሎና ቢታን፥ ንፍታለመ ቢታን፥</para>
  <para style="q2" vid="MAT 4:15">ዮርዳኖሰ ሻፋፐ ሄፍንን፥</para>
  <para style="q2" vid="MAT 4:15">አባ ኦግያ ጋፃን ደእያ፥</para>
  <para style="q2" vid="MAT 4:15">አይሁደ ግዶና ደረይ ደእያ ጋልላን፥<note caller="-" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">እሳ 9:1-2</ref>.</char></note><verse eid="MAT 4:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="MAT 4:16"/>ማን ደእያ ደረይ፥</para>
  <para style="q2" vid="MAT 4:16">ዎልቃማ ፖኦ በእስ።</para>
  <para style="q1" vid="MAT 4:16">ሀይቆ ኩያ ቢታን፥</para>
  <para style="q2" vid="MAT 4:16">ደኤይሳታስ ፖኦይ ከይስ”</para>
  <para style="m" vid="MAT 4:16">ያግድ ኦደትዳ ቃላይ ፖለታና መላሳ።<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>ሄ ዎደፐ ዶምድ የሱሲ፥ “ፆሳ ካዎተይ ማታትዳ ግሾ ህንተ ናጋራፐ ስምተ” ያግድ ቃላ ሳባኬስ።<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቶ 3:2</ref>.</char></note><verse eid="MAT 4:17"/></para>
  <para style="s1">ኮይሮ ታማረታ ፄገ</para>
  <para style="r">(<ref loc="MRK 1:16-20">ማር 1:16-20</ref>፤ <ref loc="LUK 5:1-11">ሉቃ 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>የሱሲ ጋልላ አባ ማታራ አሸ ናምኡ እሻታ፥ ጰፅሮሳ ጌተትያ ስሞናነ እያ እሻ እንድርያሳ በእስ። ኤንቲ ሞሎ ኦይከይሳታ ግድዳ ግሾ ባንታ ግትያ አባን የጎሶና። <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>የሱሲ ኤንታና፥ “ሃ ዪተ፤ ታና ካልተ፤ ታኒ ህንተና አሰ ኦይ ታማርሳና” ያግስ። <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>ኤንትካ፥ ኤለስድ ባንታ ግትያ የግ አግድ የሱሳ ካልዶሶና።<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>የሱሲ ያፐ ቡሮ ገደ ስን አሸ ሀራ ናምኡ እሻታ፥ ዛብድዮሳ ናይታ፥ ያይቆባነ ዮሃንሳ በእስ። ባንታ አዋ ዛብድዮሳራ እስፈ ዎጎሉዋ ግዶን ባንታ ግትያ ጊግሰይሳታ ፄግስ። <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>ኤንትካ፥ ኤለስድ ባንታ ዎጎሉዋነ ባንታ አዋ አግድ የሱሳ ካልዶሶና።<verse eid="MAT 4:22"/></para>
  <para style="s1">የሱሲ ሀርጋንቾታ ፓስ</para>
  <para style="r">(<ref loc="LUK 6:17-19">ሉቃ 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>የሱሲ አይሁደ ዎሳ ኬታን ታማርስሸ፥ ሳሎ ካዎተ ዎንገላ ኦድሸነ ዱማ ዱማ ሀርግያፈ አሳ ፓሸ ጋልላ ቢታ ኡባን ዩይስ።<note caller="-" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">ማቶ 9:35</ref>፤ <ref loc="MRK 1:39">ማር 1:39</ref>.</char></note><verse eid="MAT 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 4:24"/>ሄሳፈ ደንዶይሳን እያ ሱንይ ሶረ ቢታ ኡባን ከይስ። ዱማ ዱማ ሀርገን ኦይከትዳይሳታነ ዋየተይሳታ፥ ቱና አያናን ኦይከትዳይሳታ፥ ሾጭ የግያ ሀርገን ኦይከትዳይሳታነ፥ ጉንዳታ እያኮ ኤህዶሶና፤ እካ ኤንታና ፓስ።<verse eid="MAT 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 4:25"/>አሳይ ጋልላፐ፥ ታሙ ካታማታፐ፥ የሩሳላመፐ፥ ይሁዳፐነ ዮርዳኖሰ ሻፋ ሄፍንን ደእያ ቢታፈ ይዳ ዳሮ አሳይ እያ ካልዶሶና።<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">ደረ ቦላ ታማርስዳ ትምርተ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>ዳሮ ደረይ ሺቅዳይሳ የሱሲ በእዳ ዎደ ዙማ ቦላ ከይድ ኡትስ። እያ ታማረት እያኮ ሺቅን፥ <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>ሀይሳዳ ያግድ ታማርስስ፦<verse eid="MAT 5:2"/></para>
  <para style="s1">ቱማ ኡፋይስ</para>
  <para style="r">(<ref loc="LUK 6:2-23">ሉቃ 6:2-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>“ባንታ አያናን ማንቆት አንጀትዳይሳታ፥</para>
  <para style="q2" vid="MAT 5:3">ሳሎ ካዎተይ ኤንታሳ።<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>ዬከይሳት አንጀትዳይሳታ፥</para>
  <para style="q2" vid="MAT 5:4">ኤንቲ ምን ደማና።<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="ISA 61:2">እሳ 61:2</ref>.</char></note><verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>ባንታ ዎዛናን አሽከት አንጀትዳይሳታ፥</para>
  <para style="q2" vid="MAT 5:5">ኤንቲ ሳኣ ላታና።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">ማዝ 37:11</ref>.</char></note><verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>ፅሎባ ኦናዉ ኮሻተይሳትነ ሳሞተይሳት አንጀትዳይሳታ፥</para>
  <para style="q2" vid="MAT 5:6">ኤንቲ ካላና።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">እሳ 55:1</ref>.</char></note><verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>ማረይሳት አንጀትዳይሳታ፥</para>
  <para style="q2" vid="MAT 5:7">ኤንቲ ማሮተ ደማና።<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>ዎዛና ጌሻት አንጀትዳይሳታ፥</para>
  <para style="q2" vid="MAT 5:8">ኤንቲ ፆሳ በአና።<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 24:3">ማዝ 24:3</ref>.</char></note><verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>ስገይሳት አንጀትዳይሳታ፥</para>
  <para style="q2" vid="MAT 5:9">ኤንቲ ፆሳ ናይታ ጌተትድ ፄገታና።<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>ፅሎባ ኦያ ግሾ ግድ፥</para>
  <para style="q2" vid="MAT 5:10">ጎደተይሳት አንጀትዳይሳታ፥</para>
  <para style="q2" vid="MAT 5:10">ሳሎ ካዎተይ ኤንታሳ።<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 ጰፅ 3:14</ref>.</char></note><verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>“አሳይ ህንተና ታ ግሾ ግድ ጫይያ ዎደ፥ ጎድያ ዎደነ ህንተ ቦላ ኢታባ ኡባ ዎርዶን ኦድስያ ዎደ ህንተ አንጀትዳይሳታ።<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 ጰፅ 4:14</ref>.</char></note> <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>ህንተ ዎይቶይ ሳሎን ግታ ግድያ ግሾ ኡፋይትተ፥ ሀሹ ጊተ። ህንተፈ ካሰ ደእያ ናበታ ሄሳዳ ጎድዶሶና።<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 ታር 36:16</ref>፤ <ref loc="ACT 7:52">ሀዋ 7:52</ref>.</char></note><verse eid="MAT 5:12"/></para>
  <para style="s1">ማፅነነ ፖኦ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>“ህንተ ቢታስ ማፅነ፤ ማፅነይ ባ ማፅነተ አግኮ፥ ባ ማልኦተ ዋት ዛር ደማኔ? ካረ ሆልን አሳን የታናፐ አትሽን፥ አይብስካ ማደና።<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="MRK 9:50">ማር 9:50</ref>፤ <ref loc="LUK 14:34-35">ሉቃ 14:34-35</ref>.</char></note><verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>“ህንተ ቢታስ ፖኦ፤ ዙማ ቦላ ደእያ ካታምያ ቆሰታናዉ ዳንዳኡኩ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">ዮሀ 8:12</ref>፤ <ref loc="JHN 9:5">9:5</ref>.</char></note> <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>ፆምፐ ኦይድ ሶን ደእያ አሳ ኡባስ ፖአና መላ ቃ ሶን ዎስፐ አትሽን፥ ዳሎ ግዶን ዎይ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">ማር 4:21</ref>፤ <ref loc="LUK 8:16">ሉቃ 8:16</ref>፤ <ref loc="LUK 11:33">11:33</ref>.</char></note> <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>ሄሳ መላ አሳይ ህንተ ሎኦ ኦሱዋ በእድ፥ ሳሎን ደእያ ህንተ አዋ ቦንቻና መላ ህንተ ፖኦይ አሳ ስንን ፖኦ።<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 ጰፅ 2:12</ref>.</char></note><verse eid="MAT 5:16"/></para>
  <para style="s1">ሙሰ ህገ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>“ታኒ ሙሰ ህግያነ ናበታ ቃላ ሻራናዉ ይዳ ህንተዉ ዳኖፖ። ታኒ፥ ኤንቲ ኦድዳይስ ቱማ ግደይሳ ቆንጭሳናዉ ያስፐ አትሽን፥ ሻራናዉ ያቢከ። <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>ታ ህንተዉ ቱማ ኦዳይስ፤ ሳሎይነ ሳእ አና ጋካናዉ ህገ ኡባይ ፖለታናፐ አትሽን፥ ህግያፈ እስ ቃላይ ዎይኮ ፕዳለይ አና።<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">ሉቃ 16:17</ref>.</char></note> <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>ሄሳ ግሾ፥ ሀ ኪታታፐ ጉፅያ እስ ኪታ መንያ ኦንካ ቃስ ሀራታ ሄሳ ኦና መላ ታማርሰይ ኦንካ ሳሎ ካዎተን ኡባፈ ጉ ግዳና። ሽን ሀ ኪታ ፖለይስነ ሀራታካ ፖላና መላ ታማርሰይ ሳሎ ካዎተን ግታ ግዳና። <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>ታ ህንተዉ ኦዳይስ፤ ህንተ ፅሎተይ ፋርሳወታ ፅሎተፈነ ህገ አስታማረታ ፅሎተፈ አና እፅኮ፥ ሳሎ ካዎተ ገለከታ።<verse eid="MAT 5:20"/></para>
  <para style="s1">ዎባ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>“ህንተ ማይዛታስ፥ ‘ዎፕተ፤ ሸምፖ ዎዳ ኦንካ ፕርደታና’ ጌተቶይሳ ስእደታ።<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">ከሳ 20:13</ref>፤ <ref loc="DEU 5:17">ዛረ 5:17</ref>.</char></note> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>ሽን ታ ህንተዉ ኦዳይስ፤ ባ እሻ ቦላ ሀንቀትያ ኡባይ ፕርደታና። ባ እሻ ጫይያ ኦንካ ዳይና ስን ፕርዳስ ሺቃና። ባ እሻኮ፥ ‘ኤያይ’ ግያ ኦንካ ቃስ ጋናመ ታማን ፕርደታና።<verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>“ሄሳ ግሾ፥ ኔኒ ነ ያርሹዋ ያርሽያ ዎደ፥ ነ እሻ ቆህዳባይ ነዉ አኬከትኮ፥ <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>ነ ያርሹዋ ሄ በሳን አጋዳ ባ፤ ኮይሮታ ባዳ ነ እሻራ ጊጋ፤ ያታ ስማዳ፥ ነ ያርሹዋ ፆሳስ ያርሻ።<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>“ነና ሞተይሳራ ፕርዳ ኬ ባሸ ኦገ ቦላ እያራ ጊጋ። ሄስ አቶ ጊኮ እ ነና ዳይና ስን ኤፋና። ዳይናይ ነና ቃቸይሳስ አድ እማና፤ እ ነና ዎይነን የጋና። <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>ታ ቱማ ኦዳይስ፤ ነ ቦላ ፕርደትዳ አጩዋ እስ ሳንትመይ አቶና ጭጋ ኦንጋና ጋካናዉ ቃሾ ኬፈ ከያካ።<verse eid="MAT 5:26"/></para>
  <para style="s1">ላይማተባ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>“ሀይሳፈ ካሰ፥ ‘ላይማቶፕተ’ ጌተቶይሳ ስእደታ።<note caller="-" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">ከሳ 20:14</ref>፤ <ref loc="DEU 5:18">ዛረ 5:18</ref>.</char></note> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>ሽን ታ ህንተዉ ኦዳይስ፥ ማጫስ ፄልድ፥ አሞትዳ ኡባይ ባ ዎዛናን ኢራ ላይማቴስ። <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>ነ ኡሻቻ አይፈይ ነዉ ናጋራስ ጋሶ ግድኮ፥ ከሳ ሆላ። ነ አሳተይ ኩመ ጋናመ ታማን ዎናፐ ነ አሳተፈ እሶይ ይኮ ነዉ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">ማቶ 18:9</ref>፤ <ref loc="MRK 9:47">ማር 9:47</ref>.</char></note> <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>ነ ኡሻቻ ኩሸይ ነዉ ናጋራስ ጋሶ ግድኮ፥ እያ ቃንፃ ሆላ። ነ አሳተይ ኩመ ጋናመ ታማን ዎናፐ ነ አሳተፈ እሶይ ይኮ፥ ነዉ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">ማቶ 18:8</ref>፤ <ref loc="MRK 9:43">ማር 9:43</ref>.</char></note><verse eid="MAT 5:30"/></para>
  <para style="s1">ማቾ አንጆባ</para>
  <para style="r">(<ref loc="MAT 19:9">ማቶ 19:9</ref>፤ <ref loc="MRK 10:11-12">ማር 10:11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>“ ‘ባ ማቼስ አንጆ ዎርቃተ እሞ’ ጌተትስ።<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="MAT 19:7">ማቶ 19:7</ref>፤ <ref loc="MRK 10:4">ማር 10:4</ref>.</char></note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>ሽን ታ ህንተዉ ኦዳይስ፤ ባ ማቹያ ላይማቶና ደእሽን ብልያ ኦንካ እያ ላይማታና መላ ኦስ። ሄሳዳካ፥ አንጀትዳ ማጫስዉ ኤክያ ኡባይ ላይማቴስ።<note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">ማቶ 19:9</ref>፤ <ref loc="MRK 10:11-12">ማር 10:11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ 16:18</ref>፤ <ref loc="2CO 7:10-11">2 ቆሮ 7:10-11</ref>.</char></note><verse eid="MAT 5:32"/></para>
  <para style="s1">ጫቆባ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>“ህንተ ማይዛታኮ፥ ‘ዎርዶን ጫቆፍተ፤ ህንተ ፆሳ ስንን ጫቅዳይሳ ፖልተ’ ጌተትዳይሳ ስእደታ።<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ሌወ 19:12</ref>፤ <ref loc="NUM 30:2">ታይቦ 30:2</ref>፤ <ref loc="DEU 23:21">ዛረ 23:21</ref>.</char></note> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>ሽን ታ ህንተዉ ኦዳይስ፤ ኡባራካ ጫቆፍተ። ፆሳይ ኡትያ አራታ ግድያ ግሾ፥ ሳሎን ጫቆፍተ።<note caller="-" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="MAT 23:22">ማቶ 23:22</ref>.</char></note> <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>እያ ቶሆይ የያ ሶ ግድያ ግሾ፥ ሳአንካ ጫቆፍተ። ግታ ካዋ ካታማ ግድያ ግሾ፥ የሩሳላመንካ ጫቆፍተ።<note caller="-" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">እሳ 66:1</ref>፤ <ref loc="PSA 48:2">ማዝ 48:2</ref>.</char></note> <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>ህንተ ብናናፐ እሱዋካ ቦ ዎይኮ ካሬ ኦናዉ ዳንዳኦና ግሾ፥ ህንተ፥ ህንተ ሁጰንካ ጫቆፍተ። <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>ሄሳ ግሾ፥ ህንተ ቃላይ፥ ‘ኤ’ ዎይኮ ‘አካይ’ ግዶ። ሄሳፈ ካረ ከየይ ፃላሄፐ ዬስ።<verse eid="MAT 5:37"/></para>
  <para style="s1">ሀሎ ከዮፓ</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>“ ‘አይፈ ግሾ አይፈ፤ አቻ ግሾ አቸ’ ጌተትዳይሳ ስእደታ።<note caller="-" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">ከሳ 21:24</ref>፤ <ref loc="LEV 24:20">ሌወ 24:20</ref>፤ <ref loc="DEU 19:19">ዛረ 19:19</ref>.</char></note> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>ሽን ታ ህንተዉ ኦዳይስ፤ ህንተ ቦላ ኢታባ ኦያ ኡራራ ኤቀቶፍተ። ኦንካ ነ ኡሻቻ ሻካላ ባቅኮ ነ ሀድርሳ ሻካላ በሳ። <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>እስ አስ ነ ሻምዝያ ኤካናዉ ነና ሞትኮ፥ ነ ኮትያ ጉጃዳ እማ። <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>እስ አስ ነና ዎልቃን ባባ ቶስድ እስ ሳተ ኦገ ባራ ባና መላ ነና ኡንኤኮ፥ እያራ ናምኡ ሳተ ኦገ ባ። <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>ዎስያ ኦደስካ እማ፤ ኔፐ ታልአናዉ ኮይያ ኦናካ ድጎፋ።<verse eid="MAT 5:42"/></para>
  <para style="s1">ነ ሞርከታ ዶሳ</para>
  <para style="r">(<ref loc="LUK 6:27-36">ሉቃ 6:27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>“ ‘ነና ዶሰይሳ ዶሳ፤ ነና እፀይሳ እፃ’ ጌተቶይሳ ስእደታ። <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>ሽን ታ ህንተዉ ኦዳይስ፤ ህንተ ሞርከታ ዶስተ፤ ህንተና ቆሄይሳታስ ዎስተ። <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>ሄሳ ህንተ ኦኮ፥ ሳሎን ደእያ ህንተ አዋስ ህንተ ናይታ ግዳና። እ ኢታታስነ ሎኦታስ አዋ ከሴስ፤ ፅሎታስነ ናጋራንቾታስ ባ እራ ቡክሴስ። <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>ህንተና ዶስያ አሳ ፃላላ ህንተ ዶስኮ፥ ህንተዉ አይ ዎይቶይ ደኢ? ሀር አቶሽን፥ ቃራፃ ቃንፅሰይሳትካ ሄሳ ኦሶና። <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>ህንተ፥ ህንተ እሻታ ፃላላ ሳሮኮ፥ ሀራታፐ አይ ሀራ አያባ ኦደቲ? ሀር አቶሽን፥ ፆሳ አማኖና አሳይካ ሄሳ ኦሶና። <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>ህዛ፥ ሳሎን ደእያ ህንተ አዋይ ፖሎ ግዶይሳዳ ህንተካ ፖሎ ግድተ።”<note caller="-" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">ሌወ 19:2</ref>፤ <ref loc="DEU 18:13">ዛረ 18:13</ref>.</char></note><verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">ማንቆታስ እሞባ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>“አስ በኦ ግድ ህንተ ሎኦ ኦሱዋ አሳ ስንን ኦናዳ ናገትተ። ሄሳ ሀኖና እፅኮ ሳሎን ደእያ ህንተ አዋፐ ዎይቶ ደመከታ።<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="MAT 23:5">ማቶ 23:5</ref>.</char></note><verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>“ህንተ ማንቆታስ እምያ ዎደ አሳ ስንን ቦንቸታናዉ ግድ ጩቦት ኦግያ ዶናንነ አይሁደ ዎሳ ኬታን ኦይሳዳ አስ በኦ ግድ ኦፍተ። ታ ህንተዉ ቱማ ኦዳይስ፤ ኤንቲ ባንታ ኩመ ዎይቱዋ ኤክዶሶና። <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>ሽን ህንተ ማንቆታስ እምያ ዎደ ህንተ ኡሻቻ ኩሸይ ኦይሳ ህንተ ሀድርሳ ኩሸይ ኤሮፖ፤ <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>ህንተ እሞይ ጌማን ግዶ። ጌማን ኦይሳ በእያ ህንተ አዋይ ህንተዉ ዎይቱዋ ቆንጨን እማና።<verse eid="MAT 6:4"/></para>
  <para style="s1">ዎሳባ</para>
  <para style="r">(<ref loc="LUK 11:2-4">ሉቃ 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>“ዎሳ ዎስሸ ጩቦታ ሀኖፕተ። ኤንቲ፥ ባንታና አስ በኦ ግድ አይሁደ ዎሳ ኬንነ ኦግያ ዶናን ኤቅድ ዎሰይሳ ዶሶሶና። ታ ህንተዉ ቱማ ኦዳይስ፤ ኤንቲ ባንታ ኩመ ዎይቱዋ ኤክዶሶና።<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">ሉቃ 18:10-14</ref>.</char></note> <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>ሽን ኔኒ ዎስያ ዎደ፥ ነ ሶ ገላ፥ ዉላ ጎርዳዳ ጌማን ደእያ ነ አዋኮ ዎሳ፤ ጌማን ኦሰትዳይሳ በእያ ነ አዋይ ነዉ ዎይቱዋ እማና። <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>ህንተ ዎስያ ዎደ አማኖና አሳ ጮ ቃላ ዳርስድ ዎሶፍተ። ኤንቲ አዱስ ዎስን ፆሳይ ስኤስ ግድ ቆፖሶና። <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>ሄሳ ግሾ፥ ኤንታይሳዳ ሀኖፕተ። አይስ ጊኮ፥ ህንተ አዋይ ህንተዉ አይ ኮሽያኮ ህንተ ዎሳናፐ ስንትድ ኤሬስ።<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>“ህዛ፥ ህንተ ያግድ ዎስተ፦</para>
  <para style="q1" vid="MAT 6:9">“ ‘ሳሎን ደእያ ኑ አዋዉ፥</para>
  <para style="q2" vid="MAT 6:9">ነ ጌሻ ሱንይ አንጀቶ።<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>ነ ካዎተይ ዮ፥</para>
  <para style="q2" vid="MAT 6:10">ነ ሸነይ ሳሎን ሀንዳይሳዳ</para>
  <para style="q2" vid="MAT 6:10">ሳአንካ ሀኖ።<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>ጋላሳ ካ ሀች ሀች ኑስ እማ።<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>ኑኒ ኑና ቆህዳይሳታ፥ አቶ ገይሳዳ፥</para>
  <para style="q2" vid="MAT 6:12">ኑስካ ኑ ቆሁዋ አቶ ጋ።<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>ኑና ኢታፐ አሻፈ አትሽን፥</para>
  <para style="q2" vid="MAT 6:13">ፓጨን ገልሶፋ።</para>
  <para style="q1" vid="MAT 6:13">[ካዎተይ፥ ዎልቃይነ ቦንቾይ</para>
  <para style="q2" vid="MAT 6:13">መርናዉ ኔሳ፤ አምንእ።’]<verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>“ህንተ ህንተና ቆህዳይሳታ አቶ ጊኮ፥ ሳሎን ደእያ ህንተ አዋይ ህንተ ቆሁዋካ አቶ ጋና።<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MRK 11:25-26">ማር 11:25-26</ref>.</char></note> <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>ሽን ህንተ ሀራ አሳ ናጋራ አቶ ጎና እፅኮ ህንተ አዋይ ህንተ ናጋራ አቶ ጌና።<verse eid="MAT 6:15"/></para>
  <para style="s1">ፆማባ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>“ህንተ ፆምያ ዎደ ጩቦታ ካዮቶፍተ። አይስ ጊኮ፥ ኤንቲ ፆመይሳ አስ ኤራና መላ ባንታ ሶምኡዋ ቅታዮሶና። ታ ቱማ ኦዳይስ፤ ኤንቲ ባንታ ዎይቱዋ ኤክዶሶና።<verse eid="MAT 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 6:17"/>“ሽን ኔኒ ፆምያ ዎደ ነ ሶምኡዋ ሜጫ፥ ነ ሁጵያ ትየታ። <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>ሄሳዳ ነ ኦኮ ነ ፆምያ ፆማይ አሳፐ ጌምዳይሳ፥ ሽን ጌማን ደእያ ነ አዋይ ኤርያ ፆማ ግዳና። ጌማን ኦሰትዳይሳ በእያ ነ አዋይ ነዉ ዎይቱዋ እማና።<verse eid="MAT 6:18"/></para>
  <para style="s1">ሳሎን ሻሎ ሺሾ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>“ብል ምያ በሳን፥ ብራት ሽእያሶን፥ ካይሶይ ቦክድ ኤክያሶን፥ ሀ ሳአን፥ ህንተዉ ሻሎ ሺሾፕተ።<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="JAS 5:2">ያይ 5:2</ref>.</char></note> <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>ሽን ብል ሞናሶን፥ ብራት ሽኦናሶን፥ ካይሶይ ቦክድ ኤኮናሶን ሳሎን ህንተዉ ሻሎ ሺሽተ። <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>ነ ሻሎይ ደእያሱዋን ነ ዎዛናይ ደአና።<verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>“አይፈይ አሳተስ ፆምፐ። ሄሳ ግሾ፥ ነ አይፈይ ፓፃ ግድኮ ነ ኩመ አሳተይ ፖኦ ግዴስ። <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>ነ አይፈይ ሀርጋንቾ ግድኮ ነ ኩመ አሳተይ ማ ግዴስ። ህዛ፥ ነናን ደእያ ፖኦይ ማ ግድኮ፥ ማይ አይ መላ አድ ማንዴሻ!<verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>“እስ አስ ናምኡ ጎዳስ ሃረታናዉ ዳንዳኤና። እሱዋ ዶስኮ ሀንኩዋ እፄስ፤ ዎይኮ እሱዋ ቦንችኮ ሀንኩዋ ካስ። ፆሳስነ ሚሸስ ሃረታናዉ ዳንዳኤከታ።<verse eid="MAT 6:24"/></para>
  <para style="s1">ኡንኤቶፍተ</para>
  <para style="r">(<ref loc="LUK 12:22-31">ሉቃ 12:22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>“ህዛ፥ ስእተ! ህንተ ደኦን ዳናዉ፥ ‘አይ ማኔ? አይ ኡያኔ? አይ ማአኔ?’ ግድ ኡንኤቶፍተ፤ ደኦይ ካፈ ዎይኮ አሳተ ማኦፐ አኔ? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>ሳሎ ካፎታ ፄልተ፤ ኤንቲ ዘሮኮና፥ ቡጮኮና፥ ሻለን የጎኮና፥ ሽን ህንተ ሳሎ አዋይ ኤንታ ሙዜስ። ህንተ ኤንታፈ ዳሮ አከቲ? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>ህንተ ግዶፈ ዳሮ ኡንኤትድ ባ ላይ ቦላ እስ ጋላስ ጉጃናዉ ዳንዳኤይ ደኢ?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>“ቃስ ህንተ ማእያባስ አይስ ኡንኤተቲ? አነ ጪሻታ በእተ፥ ኦሶን ዳቡሮኮና ዎይኮ ሱቆኮና። <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>ስእተ! ሀር አቶሽን፥ ካዋ ሶሎሞነይ ባ ቦንቾ ኡባን ሀ ጪሻታፐ እሱዋ መላካ ማእቤና።<note caller="-" style="x"><char style="xo" closed="false">6:29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 ካዎ 10:4-7</ref>፤ <ref loc="2CH 9:3-6">2 ታር 9:3-6</ref>.</char></note> <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>ህንተኖ፥ አማኖይ ፓጭዳይሳቶ፥ ፆሳይ ሀች በንትድ ዎንቶ ታማን ዎናዉ ደእያ ማታ ያትድ ማይዝያባ ግድኮ፥ ህንተና ኤንታፈ አድ ዋት ማይዘኔ? <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>ሄሳ ግሾ፥ ‘አይ ማኔ? አይ ኡያኔ? አይ ማአኔ?’ ግድ ኡንኤቶፍተ። <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>ሄ ኡባ ፆሳ አማኖና አሳይ ዳርስድ ደማናዉ ኡንኤቶሶና። ህንተ ሳሎ አዋይ ሄ ኡባይ ህንተዉ ኮሸይሳ ኤሬስ። <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>ሽን ኡባፈ ስን ፆሳ ካዎተነ እያ ፅሎተ ኮይተ፤ ሄ ኡባይ ህንተዉ ጉጅ እመታና። <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>ሄሳ ግሾ፥ ዎንቶስ ቆፕሸ ኡንኤቶፍተ። ዎንቶይስ ዎንቶስ አቆ፤ እስ እስ ጋላሳይ ባዉ ግድያ መቶራ ደኤስ።<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">አሳ ቦላ ፕርዶፋ</para>
  <para style="r">(<ref loc="LUK 6:37-42">ሉቃ 6:37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>“ህንተ ቦላ ፕርደቶና መላ ሀራታ ቦላ ፕርዶፍተ። <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>አይስ ጊኮ፥ ሀራታ ቦላ ህንተ ፕርደይሳዳ ህንተ ቦላ ፕርደታና፤ ህንተ ሀራታስ ማክዳባን ህንተዉ ዛር ማከታና።<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">ማር 4:24</ref>.</char></note> <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/>ነ አይፈን ደእያ ቱሱ ዳነይሳ በኦና ነ እሻ አይፈን ደእያ ቡርያ አይስ በአይ? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>ነ አይፈን ቱስ ደእሽን ነ እሻ አይፈን ደእያ ቡርያ ከሶ ጋናዉ ዋና ዳንዳአይ? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>ነኖ ጩቡዋዉ፥ ኮይሮታዳ ነ አይፈን ደእያ ቱስ ዳነይሳ ከሳ። እያፐ ጉየ፥ ነ እሻ አይፈን ደእያ ቡርያ ከሳናዉ ነ ጌሻ ፄላና።<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>“ጉየ ስሚድ ህንተና ሳፆና መላ ጌሻባ ካናታስ የጎፍተ። ባንታ ቶሁዋን የድ ኢሶና መላ ህንተ አልኦ እንቁዋ ጉዱንታ ስንን የጎፍተ።<verse eid="MAT 7:6"/></para>
  <para style="s1">ዎስተ ኮይተ ፄግተ</para>
  <para style="r">(<ref loc="LUK 11:9-13">ሉቃ 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>“ዎስተ ህንተዉ እመታና፥ ኮይተ ህንተ ደማና፥ ካረ ይድ ፄግተ ህንተዉ ዶየታና። <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>ዎስያ ኦደስካ እመታና፥ ኮይያ ኦደስካ በንታና፥ ካረ ይድ ፄግያ ኦደስካ ዶየተና።<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>“ህንተ ግዶፈ ባ ናእ ኡይ ዎስኮ ሹች እመይ ኦኔ? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>ዎይኮ ሞሎ ዎስኮ ሾሽ እመይ ደኢ? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>ያትን ህንተ ኢታ ግድሸ ህንተ ናይታስ ሎኦባ እሞ ኤርኮ፥ ህንተ ሳሎ አዋይ ባና ዎሰይሳታስ ሎኦባ ዋት ዳርስድ እመኔ? <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>ሀራት ህንተዉ ኦና መላ ህንተ ኮያባ ኡባ ህንተካ ሀራታስ ኦተ። አይስ ጊኮ፥ ሙሰ ህገይነ ናበት ታማርሰይ ሀይሳ።<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="LUK 6:31">ሉቃ 6:31</ref>.</char></note><verse eid="MAT 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>“ፁን ዉላራ ገልተ፤ አይስ ጊኮ፥ ዮስ ኤፍያ ኦገይ ዎጋ፥ ዉላይካ ዳልጋ። እያራ ገልያ አሳይካ ዳሮ። <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>ሽን ደኡዋኮ ኤፍያ ኦገይነ ዉላይ ፁን፤ ያ ገልያ አሳይካ ጉ።<verse eid="MAT 7:14"/></para>
  <para style="s1">ም ባ አይፈን ኤረቴስ</para>
  <para style="r">(<ref loc="LUK 6:43-44">ሉቃ 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>“ቦላ ባጋራ ዶርሰ ዳንድ ባንታ ጋን ሱመ ግድድ ህንተ ግዶ ገልያ ዎርዳንቾ ናበታፐ ናገትተ። <figure style="fig" alt="Sheep and wolves" file="LB00011B.tif" size="col" ref="7:15">ዶርሰነ ሱማ</figure> <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>ህንተ ኤንታ፥ ኤንታ አይፍያፐ ኤራና፤ አጉንፈ ዎይነይ፥ ክንቾተፐ ላደይ ማፀተና። <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>ሄሳ መላ ሎኦ ም ኡባይ ሎኦ አይፈ አይፌስ፤ ኢታ ም ኢታ አይፈ አይፌስ። <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>ሎኦ ም ኢታ አይፈ አይፈና፥ ቃስ ኢታ ም ሎኦ አይፈ አይፋናዉ ዳንዳኤና። <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>ሎኦ አይፈ አይፎና ም ኡባይ ቃንፀትድ ታማን ፁገታና።<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">ማቶ 3:10</ref>፤ <ref loc="LUK 3:9">ሉቃ 3:9</ref>.</char></note> <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>ሄሳ ግሾ፥ ህንተ ኤንታ፥ ኤንታ አይፍያን ኤራና።<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 12:33">ማቶ 12:33</ref>.</char></note><verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>“ሳሎን ደእያ ታ አዋ ሸንያ ኦያ ኡራይ ሳሎ ካዎተ ገላናፐ አትሽን፥ ጮ ታና ‘ጎዳዉ፥ ጎዳዉ’ ግያ ኡባይ ሳሎ ካዎተ ገለና። <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>ፕርዳ ጋላስ ዳሮት፥ ‘ጎዳዉ፥ ጎዳዉ፥ ነ ሱንን ትንብተ ኦድቦኮ? ነ ሱንን ቱና አያናታ ከስቦኮ? ነ ሱንን ማላታታ ኦቦኮ?’ ያጋና። <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>ሄ ዎደ ታኒ፥ ‘ታ ህንተና ኡባራካ ኤርከ፥ ህንተ ኢታ ኦይሳት ታፐ ሃክተ’ ያጋና።<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">ማዝ 6:8</ref>.</char></note><verse eid="MAT 7:23"/></para>
  <para style="s1">ኬ ኬፅያ ናምኡ አሳታ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>“ህዛ፥ ሀ ታ ቃላ ስእድ ኦያ ኦንካ ባ ኬ ሹቻ ቦላ ኬፅዳ ዎዛናማ አሳ መላ። <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>እራይ ቡክስ፥ ድኦይ ድእስ፥ ጫርኮይካ ጫርክድ ሄ ኬ ሱግስ። ሽን ኬይ ሹቻ ባሶ ቦላ ኬፀትዳ ግሾ ኩንድቤና። <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>ሀ ታ ቃላ ስእድ ኦና ኦንካ ባ ኬ ሻፈ ቦላ ኬፅዳ ኤያ ኡራ መላ። <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>እራይ ቡክድ፥ ድኦይ ድእድ፥ ጫርኮይካ ጫርክድ፥ ሄ ኬ ሱግን፥ ሄ ኬይ ኩንድስ፤ እያ ኩንደይካ ዎልቃማ” ያግስ።<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28-29" style="v" sid="MAT 7:28-29"/>የሱሲ ባ ኦዳ ኦንግዳ ዎደ እያ ትምርተይ ህገ አስታማረታ መላ ግዶናሽን፥ ማታራ ግድያ ግሾ አሳይ እያ ትምርትያን ማላለትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">7:28-29 </char><char style="xt" closed="false"><ref loc="MRK 1:22">ማር 1:22</ref>፤ <ref loc="LUK 4:32">ሉቃ 4:32</ref>.</char></note><verse eid="MAT 7:28-29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">ባሮ ሀርጋንቾይ ፓፅስ</para>
  <para style="r">(<ref loc="MRK 1:40-45">ማር 1:40-45</ref>፤ <ref loc="LUK 5:12-16">ሉቃ 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>የሱሲ ዙማፐ ዎያ ዎደ ዳሮ አሳይ እያ ካልዶሶና። <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>ሄኮ እስ ባሮ ሀርጋንቾይ እያኮ ሺቅድ፥ እያ ስንን ጉልባትድ፥ “ጎዳዉ፥ ነ ሸነ ግድኮ ታና ጌሻዳ ፓናዉ ዳንዳኣሳ” ያግስ። <verse eid="MAT 8:2"/><verse number="3" style="v" sid="MAT 8:3"/>የሱሲ ባ ኩሽያ የድድ እያ ቦችድ፥ “ኤ፥ ታ ሸነ፥ ፓፃ” ያግስ። ኡራይ ኢራካ ጌይ አግስ። <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>የሱሲ እያኮ፥ “ነ ፓፁዋ ኦደስካ ኦዶፓ። ሽን ባዳ ነ ጌያዳ ፓፆይሳ ካህነ በሳ። ነ ፓፁዋስ ማርካ ግዳና መላ ባዳ ሙሰይ ኪትዳ ያርሹዋ ያርሻ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="LEV 14:1">ሌወ 14:1</ref>.</char></note><verse eid="MAT 8:4"/></para>
  <para style="s1">ማቶ ሀላቃ አማኖ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>የሱሲ ቅፍርናሆማ ካታማ ጋክዳ ዎደ፥ እስ ማቶ ሀላቃይ እያኮ ሺቅድ፥ <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>“ጎዳዉ፥ ታ አይለይ አሳተይ ጉንድን ዳሮ ሀርገትድ፥ ሶን ዝንእድ ደኤስ” ያግድ ዎስስ።<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>የሱሲ ዛሪድ፥ “ታኒ ባዳ እያ ፓና” ያግስ።<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>ሽን ማቶ ሀላቃይ ዛሪድ፥ “ጎዳዉ፥ ነ ታ ሶ ገላናዉ በሲያ አስ ግድከ፥ ሽን ነ ሀን ኡታዳ ቃላ ፃላላ ኦዳ፥ ታ አይለይ ፓፃና። <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>አይስ ጊኮ፥ ታፐ ቦላራ ታና ኪትያ አሳት ደኦሶና፥ ቃስ ታፐ ጋርሳራ ታዉ ኪተተይሳት ደኦሶና። ኤንታፈ እሱዋ፥ ‘ባ’ ግያደ ቤስ፤ ሀንኩዋ ቃስ ‘ሃያ!’ ግያደ ዬስ። ታ አይልያ፥ ‘ሀይሳ ኦ’ ግያደ ኦስ” ያግስ።<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>የሱሲ ሄሳ ስእዳ ዎደ ማላለትድ፥ ባና ካልያ አሳኮ፥ “ታ ህንተዉ ቱማ ኦዳይስ፤ ታኒ ሀይሳ መላ አማኖ እስራኤለ አሳንካ በአብከ። <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>ታ ህንተዉ ኦዳይስ፤ ዳሮት ዶሎሀፐነ ዉሎሀፐ ይድ፥ ሳሎ ካዎተን አብራሃመራ፥ ይሳቃራነ ያይቆባራ እስፈ እማቶ ቦላ ኡታና።<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">ሉቃ 13:29</ref>.</char></note> <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>ሽን ሳሎ ካዎተ ላታናዉ በስሽን አትዳይሳት ካረ ማን ሆለታና። ያን ኤንታዉ ዬሆነ አቻ ጋርጨ ግዳና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 22:13">ማቶ 22:13</ref>፤ <ref loc="MAT 25:30">25:30</ref>፤ <ref loc="LUK 13:28">ሉቃ 13:28</ref>.</char></note><verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>የሱሲ ማቶ ሀላቃኮ፥ “ነ ሶ ባ፥ ነ አማኑዋ ነዉ ሀኖ” ያግስ። እያ አይለይ ኢራካ ፓፅ አግስ።<verse eid="MAT 8:13"/></para>
  <para style="s1">የሱሲ ዳሮ ሀርጋንቾታ ፓስ</para>
  <para style="r">(<ref loc="MRK 1:29-34">ማር 1:29-34</ref>፤ <ref loc="LUK 4:38-41">ሉቃ 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>የሱሲ ጰፅሮሳ ሶ ገልያ ዎደ፥ ጰፅሮሳ ማቸ አይያ ቆፆ ምሻ ሀርገን ሳከታዳ ዝንእዳሮ በእስ። <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>የሱሲ እ ኩሽያ ቦችዳ ዎደ ቆፆይነ ምሻይ አጋግስ። ፓፃ ደንዳዳ እያ ሞካሱ።<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>ሄ ዎደ ኦማርስ ቱና አያናን ኦይከትዳ ዳሮ አሳታ፥ አሳይ የሱሳኮ ኤህዶሶና። እካ ቱና አያናታ ባ ቃላን ከስስ፥ ሀርጋንቾታ ኡባ ፓስ። <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>ሄሳንካ ናብያ እሳያስ፥</para>
  <para style="q1" vid="MAT 8:17">“እ ኑ ሀርግያ ባዉ ኤክስ፥</para>
  <para style="q2" vid="MAT 8:17">ኑ ዳቡራ ቶክስ”</para>
  <para style="m" vid="MAT 8:17">ግዳ ቃላይ ፖለትስ።<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">እሳ 53:4</ref>.</char></note><verse eid="MAT 8:17"/></para>
  <para style="s1">የሱሳ ካሎይ ጭግስያ ጋተ</para>
  <para style="r">(<ref loc="LUK 9:57-62">ሉቃ 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>የሱሲ ዳሮ አሳይ እያ ዩሹዋን ኤቅዳይሳ በእድ፥ አባፈ ሄፍን ፕናና መላ ባ ታማረታ ኪትስ። <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>ህገ አስታማረታፐ እሶይ፥ “አስታማርያዉ፥ ነ ብያ በሳ ኡባ ታ ካላና” ያግስ።<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>የሱሲ እያኮ “ዎርካናታስ ኦል ደኤስ፥ ሳሎ ካፎታስ ኬ ደኤስ። ሽን አሳ ናኣስ ባ ሁጵያ ሸምፕስያ በሲ ባዋ” ያግስ።<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>የሱሳ ካልያ አሳታፐ እሶይ፥ “ጎዳዉ፥ ታኒ ስንታ ባዳ ታ አዋ ሞጋዳ ያና” ያግስ።<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>ሽን የሱሲ፥ “ሀይቅዳይሳት ባንታ ሀይቆታ ሞጎ፤ ኔኒ ታና ካላ” ያግስ።<verse eid="MAT 8:22"/></para>
  <para style="s1">የሱሲ ሆቢያ ሴርስ</para>
  <para style="r">(<ref loc="MRK 4:35-41">ማር 4:35-41</ref>፤ <ref loc="LUK 8:22-25">ሉቃ 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>የሱሲ ባናዉ ዎጎሉዋን ገልዳ ዎደ፥ እያ ታማረትካ እያራ ባናዉ ገልዶሶና። <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>ኤንቲ ቆፖና ደእሽን፥ ዎልቃማ ሆበይ ሃ ቦላ ደንድን ዎጎሎይ ምተታናዉ ጋክስ። ሽን የሱሲ ስክስ። <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>እያ ታማረት እያኮ ሺቅድ እያ ባርከድ፥ “ጎዳዉ፥ ኑ ዮስ ኑና አሻርክ” ያግዶሶና።<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>የሱሲ ኤንታኮ፥ “ህንተኖ፥ አማኖይ ፓጭዳይሳቶ፥ አይስ ያየቲ?” ያግስ። ደንድድ፥ ሆቢያነ ጎትያ ኤስስ። ኤለስድ ኡባባይ ስእ ግስ።<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>እያ ታማረት ማላለትድ፥ “ሀይስ፥ ሀር አቶሽን፥ ሆበይነ ጎተይ ኪተተይስ ዋንዳ አሴ?” ያግዶሶና።<verse eid="MAT 8:27"/></para>
  <para style="s1">ቱና አያን ኦይክዳ ናምኡ አሳታ</para>
  <para style="r">(<ref loc="MRK 5:1-20">ማር 5:1-20</ref>፤ <ref loc="LUK 8:26-39">ሉቃ 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>የሱሲ አባፈ ሄፍንን ደእያ ገርገሶነ ቢታ ጋክዳ ዎደ ቱና አያናይ ኦይክዳ ናምኡ አሳት ዱፎፐ ከይድ እያራ ጋሄትዶሶና። ኤንቲ ዳሮ ኢታነ ያሽያ አሳታ ግድያ ግሾ አስ ሄ በሳራ አናዉ ዳንዳኤና። <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>ኤንትካ፥ “ፆሳ ናአዉ፥ ኑናነ ነና አይበ ጋይ? ዎደይ ጋኮና ደእሽን ኑና ፕርዳናዉ ያዲ?” ግድ ዋስዶሶና።<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>ኤንታፈ ዳሮ ሃኮና ጉዱን ዉደይ ሄመቴስ። <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>ቱና አያናት የሱሳ፥ “ነ ኑና ከሳናባ ግድኮ፥ ህን ጉዱን ዉድያ ግዶ የዳርክ” ያግድ ዎስዶሶና።<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>የሱሲ፥ “ቢተ” ያግስ። ቱና አያናት አሳታፐ ከይድ ጉዱንታን ገልዶሶና። ጉዱንት ኡባይ አፎ ዶናራ ድርግድ ብድ አባን ምተትድ ሀይቅዶሶና።<verse eid="MAT 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33"/>ጉዱን ዉድያ ሄመይሳት ባቃትድ ካታማ ብድ፥ ሀንዳባነ ቱና አያናይ ኦይክዳ አሳታ ቦላ ኦሰትዳባ ኡባ ኦድዶሶና። <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>ያትን፥ ካታማን ደእያ አሳ ኡባይ የሱሳ በአናዉ ከይዶሶና። ኤንቲ የሱሳ በእዳ ዎደ ባንታ ቢታፈ ከይድ ባና መላ ዎስዶሶና።<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">ጉንዳ ኡራ</para>
  <para style="r">(<ref loc="MRK 2:1-12">ማር 2:1-12</ref>፤ <ref loc="LUK 5:17-26">ሉቃ 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>ሄሳፈ ጉየ፥ የሱሲ ዎጎሉዋን ገልድ፥ አባ ፕንድ ባ ካታማ ብስ። <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>ሀንዳ ጉ አሳት እስ ጉንዳ ኡራ አልጋራ ቶክድ የሱሳኮ ኤህዶሶና። የሱሲ ኤንታ አማኑዋ በእድ፥ ጉንዳ ኡራ፥ “ታ ናአዉ፥ ያዮፋ፤ ነ ናጋራይ አቶ ጌተትስ” ያግስ።<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>ሄ ሳትያን፥ አይሁደ ህገ አስታማረታፐ እሶት እሶት፥ “ሀይስ ፆሳ ጫሸ ግደነ” ያግድ ባንታ ዎዛናን ቆፕዶሶና።<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>የሱሲ ኤንታ ቆፋ ኤርድ፥ “ኢታባ ህንተ ዎዛናን አይስ ቆፔቲ? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>ሀኖሽን፥ ‘ነ ናጋራይ አቶ ጌተትስ’ ገይሳፈነ ‘ደንዳ ኤቃዳ ባ’ ገይሳፈ አዉስ ካዉዪ? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>ሽን ሳአ ቦላ ናጋራ አቶ ጋናዉ አሳ ናኣስ ማት ደኤይሳ ታ ህንተና ኤርሳና” ያግድ፥ ጉንዳ አድያኮ፥ “ደንዳ ኤቃ፥ ነ አልጋ ቶካዳ፥ ነ ሶ ባ” ያግስ።<verse eid="MAT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7"/>ጉንዳ ኡራይ ደንድድ ባ ሶ ብስ። <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>ደረይ ሄሳ በእድ ማላለትዶሶና። ሄሳ መላ ማታ አሳስ እምዳ ፆሳ ጋላትዶሶና።<verse eid="MAT 9:8"/></para>
  <para style="s1">ማቶሳ ፄገተ</para>
  <para style="r">(<ref loc="MRK 2:13-17">ማር 2:13-17</ref>፤ <ref loc="LUK 5:27-32">ሉቃ 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>የሱሲ ያፐ ደንድድ ብሸ ማቶሳ ገይሳ ቃራፃ ቃንፅስያ በሳን ኡትዳሽን በእድ፥ “ታና ካላ” ያግስ።</para>
  <para style="p" vid="MAT 9:9">እካ ደንድድ ካልስ።<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>የሱሲ ማቶሳ ሶን ጋይታ ቦላ ኡትዳሽን፥ ቃራፃ ቃንፅስያ ዳሮ አሳትነ ናጋራንቾት ይድ እያራነ እያ ታማረታራ እስፈ ማናዉ ኡትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">ሉቃ 15:1-2</ref>.</char></note> <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>እስ እስ ፋርሳወት ሄሳ በእድ፥ የሱሳ ታማረታ፥ “ህንተ አስታማረይ ቃራፃ ቃንፅሰይሳታራነ ናጋራንቾታራ አይስ ሚ?” ያግዶሶና።<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>የሱሲ ሄሳ ስእድ፥ “ለ ኮሸይ ሀርጋንቾታሳፈ አትሽን፥ ፓፃታሳ ግደና። <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>ሽን ህንተ ብድ፥ ‘ታኒ ህንተ ያርሹዋ ግዶናሽን ህንተ ሀራታ ማራና መላ ኮያይስ’ ጌተትድ ፃፈትዳይስ አይ ጉሰኮ ኤርተ። አይስ ጊኮ፥ ታኒ ናጋራንቾታ ፄጋናዉ ያስፐ አትሽን፥ ፅሎታ ፄጋናዉ ያቢከ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAT 12:7">ማቶ 12:7</ref>፤ <ref loc="HOS 6:6">ሆሰ 6:6</ref>.</char></note><verse eid="MAT 9:13"/></para>
  <para style="s1">የሱሲ ፆማባ ኦይሸትስ</para>
  <para style="r">(<ref loc="MRK 2:18-22">ማር 2:18-22</ref>፤ <ref loc="LUK 5:33-39">ሉቃ 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>ሄ ዎደ ዮሃንሳ ታማረት የሱሳኮ ሺቅድ፥ “ኑነ ፋርሳወት ፆሞስ፥ ሽን ነ ታማረት አይስ ፆሞኮና?” ያግድ ኦይችዶሶና።<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>የሱሲ ዛሪድ ኤንታኮ፥ “ማችዉ ኤከይስ ኤንታራ ደእሽን ፄገትድ ይዳ አሳይ ካዮታናዉ ዳንዳኦና? ሙሹራይ ኤንታ ማታፐ ኤከታና ዎደይ ያና፥ ኤንቲ ሄ ዎደ ፆማና።<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>“ኦራ ማኦፐ ፔድ ጋልአ ማኦ ቦላ ስከይ ኦንካ ባዋ። ሄሳ ኦኮ ኦራይ ጋልአ ፔስ። ፔይካ ጉጅ ዳልጌስ። <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>ኦራ ዎይነ ጋልአ ኦጎሮን ቆልያ ኦንካ ባዋ። ሄሳ ኦኮ ኦራ ዎይነይ ጋልአ ኦጎሩዋ ሴስ ዎይነይካ ጉኬስ፤ ኦጎሮይካ ናምአን ማዶናባ ግዴስ። ሽን ኦራ ዎይነይ ኦራ ኦጎሮን ቆለታናዉ በሴስ። ሄሳ ኦሰትኮ ናምአይካ ኢቶና ናገቶሶና” ያግስ።<figure style="fig" alt="Wineskin" file="LB00145B.tif" size="col" ref="9:17">ዎይነ ኦጎሮ</figure><verse eid="MAT 9:17"/></para>
  <para style="s1">ሀይቅዳ ናእዉነ ሀርገትያ ማጫስዉ</para>
  <para style="r">(<ref loc="MRK 5:21-43">ማር 5:21-43</ref>፤ <ref loc="LUK 8:40-56">ሉቃ 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>የሱሲ ሄሳ ኦዶ ቦላ ደእሽን፥ አይሁደ ሀላቃታፐ እሶይ እያኮ ይድ፥ እያ ስንን ጉልባትድ፥ “ታ ናእያ ሀእ ሀይቃሱ፥ ሽን እያ ፓፃና መላ ኔኒ ያዳ ነ ኩሽያ እ ቦላ ዎርክ” ግድ ዎስስ። <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>የሱሲ ደንድድ እያራ ብስ፤ እያ ታማረትካ ካልዶሶና።<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>እ ብሽን ታማነ ናምኡ ላይ ኩመ ሱ ጎግድ ዋይስያ እስ ማጫስያ ጉየራ ሺቃዳ የሱሳ አፍላ ማጫራ ቦቻሱ። <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>እያ ባ ዎዛናን፥ “ታ እያ አፍላ ማጫራ ፃላላ ቦችያኮ ፓፃና” ያጋዳ ቆፓሱ።<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>የሱሲ ጉየ ስም እዮ ፄልድ፥ “ታ ናተ፥ ያዮፋ! ነና ነ አማኖይ ፓስ” ያግስ። ማጫስያ ኤለሳዳ ፓፃ አጋሱ።<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>የሱሲ አይሁደ ሀላቃ ሶ ጋክያ ዎደ ዛየ ፑነይሳታነ ዬከይሳታ በእድ፥ <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>“አነ ክችተ፤ ጉ ናእያ ስካሱፐ አትሽን፥ ሀይቃቡኩ” ያግስ። ሽን አሳይ እያ ቦላ ሚጭዶሶና። <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>አሳ ካረ ከስዳፐ ጉየ ሶ ገልድ፥ ናኤ ኩሽያ ኦይክስ፥ ናእያ ደንዳ ኤቃሱ። <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>ሄ ዎረይ ሄ ቢታ ኡባ ጋክስ።<verse eid="MAT 9:26"/></para>
  <para style="s1">ናምኡ ቆቀ አሳታ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>የሱሲ ያፐ ደንድድ ገደ ስን ብያ ዎደ ናምኡ ቆቀት ባንታ ቃላ ቁ ኦድ፥ “ዳዊታ ናአዉ፥ ኑና ማራርክ” ያግሸ እያ ካልዶሶና።<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>የሱሲ ሶ ገልዳ ዎደ ቆቀት እያ ካልድ ይዶሶና። የሱሲ ኤንታኮ፥ “ታኒ ሄሳ ኦናዉ ዳንዳኤይሳ ህንተ አማነቲ?” ያግስ።</para>
  <para style="p" vid="MAT 9:28">ኤንትካ፥ “ኤ፥ ጎዳዉ” ያግድ ዛርዶሶና።<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>ሄሳፈ ጉየ፥ የሱሲ ኤንታ አይፍያ ቦችድ ኤንታኮ፥ “ህንተዉ፥ ህንተ አማኑዋ ሀኖ” ያግስ። <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>ኤንታ አይፈይካ ዶየትስ። የሱሲ ኤንታኮ፥ “ሀይሳ ኦደስካ ኦዶፕተ” ያግድ ምን ኦድስ። <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>ሽን አሳት ብድ የሱሳባ ሄ ቢታ ኡባን ኦድዶሶና።<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>ኤንቲ ያፐ ከይያ ዎደ አሳይ ቱና አያናይ ኦይክድ ሙምስዳ እስ አስ የሱሳኮ ኤህዶሶና። <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>ቱና አያናይ ከይዳፐ ጉየ ሙመ ኡራይ ኦደትስ። ደረይካ ማላለትድ፥ “ሀይሳ መላ ኦራባይ እስራኤለ ቢታን ሀንቤና” ያግዶሶና።<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>ሽን ፋርሳወት፥ “ቱና አያናታ ሀላቃን ቱና አያናታ ከሴስ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">ማቶ 10:25</ref>፤ <ref loc="MAT 12:24">12:24</ref>፤ <ref loc="MRK 3:22">ማር 3:22</ref>፤ <ref loc="LUK 11:15">ሉቃ 11:15</ref>.</char></note><verse eid="MAT 9:34"/></para>
  <para style="s1">ኦሳንቾት ጉ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>የሱሲ አይሁደ ዎሳ ኬታን ታማርስሸ፥ ሳሎ ካዎተ ዎንገላ ሳባክሸ፥ አሳ ሀርገ ኡባፈ ፓሸ ካታማታንነ ጉታ ኡባን ዩይስ።<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቶ 4:23</ref>፤ <ref loc="MRK 1:39">ማር 1:39</ref>፤ <ref loc="LUK 4:44">ሉቃ 4:44</ref>.</char></note> <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>ዳሮ ደረይ፥ ሄምያ አስ ባይና ዶርሳዳ ኤንታና በእያ አስ ይን ኡንኤትድ ደኤይሳታ በእድ ኤንታዉ ቃትስ።<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ታይቦ 27:17</ref>፤ <ref loc="1KI 22:17">1 ካዎ 22:17</ref>፤ <ref loc="2CH 18:16">2 ታር 18:16</ref>፤ <ref loc="EZK 34:5">ህዝ 34:5</ref>፤ <ref loc="MRK 6:34">ማር 6:34</ref>.</char></note> <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>ባ ታማረታኮ፥ “ሺቃና ካይ ዳሮ፥ ሽን ካ ሺሽያ አሳይ ጉ።<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="LUK 10:2">ሉቃ 10:2</ref>.</char></note> <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>ሄሳ ግሾ፥ ጎዳይ ካ ሺሽያ ኦሳንቾታ የዳና መላ ዎስተ” ያግስ።<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">ታማነ ናምኡ ሀዋረታ</para>
  <para style="r">(<ref loc="MRK 3:13-19">ማር 3:13-19</ref>፤ <ref loc="LUK 6:12-16">ሉቃ 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>የሱሲ ታማነ ናምኡ ታማረታ ባኮ ፄግድ፥ ቱና አያናታ ከሳና መላነ ሀርገ ኡባ ፓና መላ ኤንታዉ ማታ እሚስ።<verse eid="MAT 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2"/>የሱሲ ኪትዳ ታማነ ናምኡ ሀዋረታ ሱንይ፦ ኮይሮይ ጰፅሮሳ ጌተትያ ስሞናነ እያ እሻ እንድርያሳ፥ ዛብድዮሳ ናኣ ያይቆባነ እያ እሻ ዮሃንሳ፥ <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>ፍልጶሳነ ባርተለሞሳ፥ ቶማሳነ ቃራፃ ቃንፅስያ ማቶሳ፥ እልፍዮሳ ናኣ ያይቆባ፥ ታድዮሳ፥ <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>ባ ቢታስ ምሸትያ ስሞናነ የሱሳ አድ እምዳ አስቆሮታ ይሁዳ።<verse eid="MAT 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>ሄ ታማነ ናምአታ የሱሲ ኪትድ የድሸ፥ “አይሁደ ግዶና ደርያኮ ቦፕተ፥ ቃስ ሳማረታ ካታማካ ገሎፕተ። <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>ሽን እስራኤለ ኬፈ ግድዳ ህን ይዳ ዶርሳታኮ ቢተ። <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>ያ ብድ፥ ‘ሳሎ ካዎተይ ማታትስ’ ግድ ኦድተ።<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">ሉቃ 10:4-12</ref>.</char></note> <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>ሀርጋንቾታ ፓተ፥ ሀይቅዳይሳታ ሀይቆፐ ደንተ፥ ባሮ ሀርጋንቾታ ጌሽ ፓተ፥ ቱና አያናታ ከስተ። ህንተ ጮ ኤክዳይሳ ጮ እምተ። <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>ህንተ ኪሰን ዎርቃ፥ ዎይኮ ብራ ሳንትመ ኦይኮፍተ። <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>ህንተ ኦግያስ ካርፂቶ፥ ናምኡ አፍላ፥ ዎይኮ ጫማ ዎይኮ ፃምአ ኦይኮፍተ፤ ኦሳንቹዋስ ጋላሳ ካ ኮሼስ።<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="2CO 9:14">2 ቆሮ 9:14</ref>፤ <ref loc="1TI 5:18">1 ፅሞ 5:18</ref>.</char></note><verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>“ህንተ እስ ካታማ ዎይኮ ጉታ ገልያ ዎደ ህንተና ሞክድ ኤካናዉ ኡፋይትያ ኡራ ኮይድ እያ ሶን ሸምፕተ፤ ህንተ ባና ጋካናዉ ያን ጋምእተ። <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>ቃስ ኦደ ሶካ ገልሸ ሳሮተ። <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>ሄ ኬይ ህንተና ሞክኮ ህንተ ሳሮዳ ሳሮይ ኤንታና ጋኮ፥ ሽን ኤንቲ ሞኮና እፅኮ ህንተ ሳሮዳ ሳሮይ ህንተዉ ጉየ ስሞ። <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>ኦንካ ህንተና ሞኮናነ ህንተ ኦድያባ ስኦና እፅኮ ሄ ኬፈ ዎይኮ ሄ ካታማፐ ከይሸ ህንተ ቶሁዋን ደእያ ባና ፕትድ ከይተ።<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሀዋ 13:51</ref>.</char></note> <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>ታ ህንተዉ ቱማ ኦዳይስ፤ ፆሳ ፕርዳ ጋላሳን ሄ ካታማፐ ሶዶመስነ ጋሞራ ካታማታስ ፕርዳይ ካዉያና።<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">ማቶ 11:24</ref>፤ <ref loc="GEN 19:24">መ 19:24</ref>.</char></note><verse eid="MAT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>“ታ ህንተና ዶርሳታዳ ሱመታ ግዶ የዳና። ሄሳ ግሾ፥ ሾሻዳ ጭንጫታ፥ ሆለዳ አዳታ ግድተ።<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">ሉቃ 10:3</ref>.</char></note> <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>አሳይ ህንተና ፕርዳ ዳይናታስ አድ እማና፥ ቃስ አይሁደ ዎሳ ኬን ህንተና ጋራፋና። ሄሳ ግሾ፥ ኤንታፈ ናገትተ።<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">ማር 13:9-11</ref>፤ <ref loc="LUK 12:11-12">ሉቃ 12:11-12</ref>፤ <ref loc="LUK 21:12-15">21:12-15</ref>.</char></note> <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>ታ ግሾ ግድ ህንተና ደርያ ሃረይሳታ ስንነ ካዎታ ስን ኤፋና። ኤንታ ስንንነ አይሁደ ግዶና ደርያ ስንን ኤቅድ ህንተ ታባ ማርካታና። <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>ሽን ህንተና ፕርዳስ አድ እምያ ዎደ፥ ዎይግድ ዛርኖ ግድ ኡንኤቶፍተ፤ ሄ ሳትያን ህንተ ጋናባ ፆሳይ ህንተዉ እማና። <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>አይስ ጊኮ፥ ህንተናን ኦደተይ ህንተ አዋ ጌሻ አያናፐ አትሽን፥ ህንተና ግደከታ።<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>“እሻይ ባ እሻ፥ አዋይ ባ ናአ፥ ሀይቆስ አድ እማና፥ ናይት ባንታና የልዳይሳታ ቦላ ደንድድ ኤንታ ዎሳና።<note caller="-" style="x"><char style="xo" closed="false">10:21 </char><char style="xt" closed="false"><ref loc="MRK 13:12">ማር 13:12</ref>፤ <ref loc="LUK 21:16">ሉቃ 21:16</ref>.</char></note> <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>ታ ግሾ ግድ አሳ ኡባይ ህንተና እፃና፥ ሽን ዉርሰ ጋካናዉ ምንዳይ አታና።<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">ማቶ 24:9</ref>፤ <ref loc="MRK 13:13">ማር 13:13</ref>፤ <ref loc="LUK 21:17">ሉቃ 21:17</ref>፤ <ref loc="MAT 24:13">ማቶ 24:13</ref>፤ <ref loc="MRK 13:13">ማር 13:13</ref>.</char></note> <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>እስ ሄራፐ ህንተና ኤንቲ ጎድኮ ሀራ ካታማ ባቃትተ። ታኒ ህንተዉ ቱማ ኦዳይስ፤ አሳ ናአይ ያና ጋካናዉ፥ ህንተ እስራኤለ ካታማ ኡባ ካንከታ።<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>“ታማረይ ባ አስታማርያፐ፥ አይለይ ባ ጎዳፐ አና።<note caller="-" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">ሉቃ 6:40</ref>፤ <ref loc="JHN 13:16">ዮሀ 13:16</ref>፤ <ref loc="JHN 15:20">15:20</ref>.</char></note> <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>ታማረይ ባ አስታማርያ፥ አይለይ ባ ጎዳ ዳንኮ እያዉ ግዳና። ኬ ጎዳ ብኤል-ዘቡላ ጊኮ እያ ሶ አሳ ዋትድ ኢስድ ፄገኔ?<note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ 9:34</ref>፤ <ref loc="MAT 12:24">12:24</ref>፤ <ref loc="MRK 3:22">ማር 3:22</ref>፤ <ref loc="LUK 11:15">ሉቃ 11:15</ref>.</char></note><verse eid="MAT 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>“ህዛ፥ አሳስ ያዮፍተ። ካመትዳባይ ቆንጮና፥ ቆሰትዳባይ ጌሽ ከዮና አተና።<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር 4:22</ref>፤ <ref loc="LUK 8:17">ሉቃ 8:17</ref>.</char></note> <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>ታኒ ህንተዉ ማን ኦድያባ ህንተ ፖኦን ኦድተ፤ ታ ህንተዉ ሀይን ካልካሽዳባ ዳባባን አዋጅተ። <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>አሾፐ አትሽን፥ ሸምፖ ዎናዉ ዳንዳኦናይሳታስ ያዮፍተ። ሽን ሸምፑዋነ አሹዋ ጋናመን ይሳናዉ ዳንዳእያ ፆሳስ ያይተ። <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>ናምኡ ቡበት እስ ሳንትመን ባይዘቶኮናዬ? ሀኖፐ አትሽን፥ ኤንታፈ እስናካ ህንተ ፆሳይ ጎና ደእሽን ሳአን ዎኩ። <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>ሀር አቶሽን፥ ህንተ ሁጰ ብናናይካ ፓይደትድ ደኤስ። <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>ህዛ፥ ዳሮ ቡበታፐ ህንተ አያ ግሾ ያዮፍተ።<verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>“አሳ ስንን ታዉ ማርካትያ ኡባስ ታንካ ሳሎን ደእያ ታ አዋ ስንን ማርካታና። <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>ሽን አሳ ስንን ታና ካደይሳ ታንካ ሳሎን ደእያ ታ አዋ ስንን ካዳና።<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 ፅሞ 2:12</ref>.</char></note><verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>“ታኒ ሳአን ሳሮ ኤሀናዉ ይዳ ህንተዉ ዳኖፖ። ታኒ ቶራፐ አትሽን፥ ሳሮተ ኤሀናዉ ያቢከ። <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>ታኒ ይዳይ፥</para>
  <para style="q1" vid="MAT 10:35">“ ‘ናኣ አዋፐ</para>
  <para style="q2" vid="MAT 10:35">ማጫ ናእዉ አየፐ</para>
  <para style="q2" vid="MAT 10:35">ናኣ ማችዉ አዝና አየፐ ሻካናሳ።<note caller="-" style="x"><char style="xo" closed="false">10:35 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ምክ 7:6</ref>.</char></note><verse eid="MAT 10:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36"/>አሳስ ሞርከት እያ ሶ አሳታ ግዳና።’<verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>“ታፐ አድ ባ አዋ ዎይኮ ባ አይዉ ዶሰይ፥ ታባ ግዳናዉ በሰና። ባ አደ ናአ ዎይኮ ባ ማጫ ናእዉ ታፐ አድ ዶሰይ፥ ታባ ግዳናዉ በሰና። <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>ባ ማስቃልያ ቶክድ ታና ካሎና ኦንካ ታባ ግዳናዉ በሰና።<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">ማቶ 16:24</ref>፤ <ref loc="MRK 8:34">ማር 8:34</ref>፤ <ref loc="LUK 9:23">ሉቃ 9:23</ref>.</char></note> <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>ባ ሸምፑዋ አሻናዉ ኮየይ ይሳና፥ ሽን ባ ሸምፑዋ ታ ግሾ አድ እመይ አሻና።<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">ማቶ 16:25</ref>፤ <ref loc="MRK 8:35">ማር 8:35</ref>፤ <ref loc="LUK 9:24">ሉቃ 9:24</ref>፤ <ref loc="LUK 17:33">17:33</ref>፤ <ref loc="JHN 12:25">ዮሀ 12:25</ref>.</char></note><verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>“ህንተና ሞከይ ታና ሞኬስ፥ ታና ሞከይ ቃስ ታና ኪትዳይሳ ሞኬስ።<note caller="-" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="LUK 10:16">ሉቃ 10:16</ref>፤ <ref loc="JHN 13:20">ዮሀ 13:20</ref>፤ <ref loc="MRK 9:37">ማር 9:37</ref>፤ <ref loc="LUK 9:48">ሉቃ 9:48</ref>.</char></note> <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>ናብያ ናበ ሱንን ሞከይ፥ ናብያ ዎይተታና፤ ቃስ ፅሉዋ ፅሎ ሱንን ሞከይ፥ ፅሉዋ ዎይተታና። <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>ታ ህንተዉ ቱማ ኦዳይስ፤ ሀ ታ ታማረታፐ ጉፅያ እሱዋስ ታና ካልያ ግሾ ሀር አቶሽን ጉ እርፃ ሃ እምኮ እያ ዎይቶይ የና” ያግስ።<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">ፃማቅያ ዮሃንስ ኪትዳ አሳታ</para>
  <para style="r">(<ref loc="LUK 7:18-35">ሉቃ 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>የሱሲ ታማነ ናምኡ ታማረታ ኪትዳፐ ጉየ ያፐ ደንድድ ታማርሳናዉነ ሳባካናዉ ጋልላ ካታማታ ብስ።<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>ዮሃንስ ቃሾ ኬን ደእሸ ክርስቶስ ኦያባታ ስእድ፥ ባ ታማረታፐ እያኮ ኪትድ፥ <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>“ያና ጌተትዳይ ነነዬ? ዎይኮ ኑኒ ሀራ ናግኖ?” ያግድ ኦይችስ።<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>የሱሲ ኤንታኮ ዛሪድ፥ “ብድ ህንተ ስእያባነ ህንተ በእያባ ዮሃንሳስ ኦድተ። <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>ቆቀት ፄሎሶና፥ ዎበት ሄመቶሶና፥ ባሮ ሀርጋንቾት ፓፆሶና፥ ቱለት ስኦሶና፥ ሀይቅዳይሳት ሀይቆፐ ደንዶሶና፤ ማንቆታስ ዎንገላይ ሳባከቴስ።<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5">እሳ 35:5</ref>.</char></note> <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>ታናን በቶናይ አንጀትዳይሳ” ያግስ።<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>ዮሃንሳ ታማረት ጉየ ስሚድ ብን፥ የሱሲ ደርያስ ዮሃንሳባ ኦድሸ፥ “ሀ መላ ቢታ አይ በአናዉ ከይደቲ? ጫርኮይ ቃያ ማይረ በአናዉ ይደትዬ? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>ያትን፥ አይ በአናዉ ከይደቲ? ኮይሰ ማኦ ማእዳ አሰ በአናሰዬ? ኮይሰ ማኦ ማእዳ አሳት ካዎ ጋን ደኦሶና። <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>ያትን፥ አይ በአናዉ ከይደቲ? ናበ በአናሰዬ? ሄኮ፥ ህንተ ናበፐ አይሳ በኤታ።<verse eid="MAT 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 11:10"/>“ነ ኦግያ ነ ስንን ጊግስያ</para>
  <para style="q2" vid="MAT 11:10">ታ ኪታንቹዋ ኔፐ ስን ኪታና”</para>
  <para style="m" vid="MAT 11:10">ጌተትድ ፃፈትዳይ እያሳ።<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ምልክ 3:1</ref>.</char></note><verse eid="MAT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11"/>ታ ህንተዉ ቱማ ኦዳይስ፤ ማጫሳፐ የለትዳይሳታ ግዶፈ ዮሃንሳፐ አይ ኦንካ ባዋ፤ ሳሎ ካዎተን ኡባፈ ጉፀይ እ፥ እያፐ አና። <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>ፃማቅያ ዮሃንሳ ዎድያፐ ዶምድ ሀች ጋካናዉ ሳሎ ካዎተይ ዳሮ ናቀቴስ፥ ምንዳ አሳት ዎልቃን ያ ገላና።<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="LUK 16:16">ሉቃ 16:16</ref>.</char></note> <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>ናበት ኡባይነ ሙሰ ህገይ ዮሃንሳ ዎደ ጋካናዉ ሳሎ ካዎተባ ትንብተ ኦድዶሶና። <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>ህዛ፥ ህንተ ኤንታ ኪታ አማናና ግድኮ፥ ያና ጌተትዳ ኤልያስ፥ እ ዮሃንሳ።<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ምልክ 4:5</ref>፤ <ref loc="MAT 17:10">ማቶ 17:10</ref>.</char></note> <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>ህዛ፥ ስእያ ሀይ ደኤይ ስኦ።<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>“ህዛ፥ ሀ ዎድያ የለተ አይብራ ዳንሶ? ግያ ግዶን ኡትድ ዎል ፄግድ፥<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>‘ኑ ህንተዉ ሱሱልኤ ፑንን፤</para>
  <para style="q2" vid="MAT 11:17">ህንተ የፀከታ።</para>
  <para style="q1" vid="MAT 11:17">ኑ ሳቢድ ዘሌልን፤</para>
  <para style="q2" vid="MAT 11:17">ህንተ ዬከከታ’</para>
  <para style="m" vid="MAT 11:17">ግያ ናይታ ዳኖሶና። <verse eid="MAT 11:17"/><verse number="18" style="v" sid="MAT 11:18"/>ፃማቅያ ዮሃንስ ሞናነ ኡዮና ይን፥ ‘ቱና አያን ደኤስ’ ያግደታ። <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>አሳ ናአይ ምሸነ ኡይሸ ይን፥ ‘ያራምባነ ኡሻንቾ፥ ቃራፃ ቃንፅሰይሳታነ ናጋራንቾታ ዳቦ’ ያግደታ። ህዛ፥ ጭንጫተ ቱማተይ እያ ኦሱዋን ቆንጬስ” ያግስ።<verse eid="MAT 11:19"/></para>
  <para style="s1">አማኖና እፅዳ ካታማታ</para>
  <para style="r">(<ref loc="LUK 10:13-15">ሉቃ 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>ሄሳፈ ጉየ፥ የሱሲ ዳሮ ማላታታ ኦዳ ካታማታን ደእያ አሳት ባንታ ናጋራፐ ስሚድ ማሮታን ገሎና እፅዳ ግሾ ኤንታና፥ <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>“ኮራዝነ ካታማዉ ነና አየ! ቤተሳይዳ ካታማዉ ነና አየ! አይስ ጊኮ፥ ህንተ ግዶን ኦሰትዳ ማላታት ፅሮሳንነ ስዶናን ኦሰትዳ ግድያኮ፥ ኤንቲ በን ብዶ ትየትድ፥ ካዮ ማኦ ማእድ ባንታ ናጋራፐ ስም አጋና።<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">እሳ 23:1-18</ref>፤ <ref loc="JOL 3:4-8">እዩ 3:4-8</ref>፤ <ref loc="AMO 1:9-10">አሞ 1:9-10</ref>፤ <ref loc="ZEC 9:2-4">ዛካ 9:2-4</ref>.</char></note> <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>ሽን ታ ህንተዉ ኦዳይስ፤ ፕርዳ ጋላስ ህንተፈ አድ ፅሮሳስነ ስዶናስ ፕርዳይ ካዉያና። <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>ቃስ፥ ቅፍርናሆማ፥ ኔኒ ፑደ ሳሎ ከያናዉ ኮያይ? ሀነና! ኔኒ ስኦለን የገታና። አይስ ጊኮ፥ ነ ግዶን ኦሰትዳ ማላታት ሶዶመን ኦሰትዳባ ግድያኮ፥ ሶዶመይ ሀች ጋካናዉ ደአናሽን።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ISA 14:13">እሳ 14:13</ref>.</char></note> <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>ሽን ታ ነዉ ኦዳይስ፤ ፕርዳ ጋላስ ኔፐ አድ ሶዶመስ ፕርዳይ ካዉያና” ያግድ ሀንቀትስ።<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">ማቶ 10:15</ref>፤ <ref loc="LUK 10:12">ሉቃ 10:12</ref>.</char></note><verse eid="MAT 11:24"/></para>
  <para style="s1">ክርስቶስ እምያ ሸምፖ</para>
  <para style="r">(<ref loc="LUK 10:21-22">ሉቃ 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>ሄ ዎደ የሱሲ፥ “አዋዉ፥ ሳሉዋነ ሳኣ ጎዳዉ፥ ኔኒ ሀይሳ ኤራንቾታፐነ ጭንጫታፐ ገንዳ ናይታስ ቆንጭስዳ ግሾ፥ ነና ጋላታይስ። <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>ኤ፥ ታ አዋዉ፥ ሀይስ ነ ሎኦ ሸንያዳ ሀንስ።<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>“ኡባይ ታዉ ታ አዋፐ እመትስ። አዋፐ ሀር ናአ ኤረይ ባዋ፥ ናኣፐነ እ ኤንታዉ ቆንጭሳናዉ ኮየይሳታፐ ሀር አዋ ኤራናዉ ዳንዳኤይ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="JHN 1:18">ዮሀ 1:18</ref>፤ <ref loc="JHN 3:35">3:35</ref>፤ <ref loc="JHN 10:15">10:15</ref>.</char></note><verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>“ህንተኖ፥ ዳቡራንቾቶ፥ ቶሆይ ዴፅዳ ኡባይ ታኮ ሃ ዪተ፤ ታኒ ህንተና ሸምፕሳና። <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>ታኒ ታ ዎዛናን አሽከነ አዳ ግድያ ግሾ፥ ታ ቃምባራን ገልተ፥ ታፐ ታማርተ፤ ህንተ፥ ህንተ ሸምፑዋስ ሸምፖ ደማና።<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JER 6:16">ኤርም 6:16</ref>.</char></note> <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>ታ ቃምባራይ ሊቆ፥ ቃስ ታ ቶሆይካ ካዉሸ” ያግስ።<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">ሳምባታ ቦንቻናዉ በሲ?</para>
  <para style="r">(<ref loc="MRK 2:23-28">ማር 2:23-28</ref>፤ <ref loc="LUK 6:1-5">ሉቃ 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>ሄሳፈ ጉየ፥ ሳምባታ ጋላስ፥ የሱሲ ጋደ ግዶራ አስ። የሱሳ ታማረት ኮሻትዳ ግሾ ትያ ባንጋ ሽርክድ ሞሶና።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ዛረ 23:25</ref>.</char></note> <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>ሽን ፋርሳወት ሄሳ በእድ የሱሳኮ፥ “ሄኮ፥ ነ ታማረት ሳምባታ ጋላስ ኦናዉ በሶናባ ኦሶና” ያግዶሶና።<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>የሱሲ ዛሪድ፥ “ዳዊቲ ኮሻትዳ ዎደ እያራ ደኤይሳታራ አይ ኦዳኮ ናባብበከቲ?<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳሜ 21:1-6</ref>.</char></note> <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>ዳዊቲ ፆሳ ኬ ገልድ ካህነታ ፃላላፐ አትሽን፥ እነ እያራ ደኤይሳታስ በሶና ጌሻ ዳቡዋ ምስ።<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌወ 24:9</ref>.</char></note> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>ዎይኮ ካህነት ሳምባታ ዎጋ ሻርድ ፆሳ ኬን ሳምባታ ጋላስ ኦሶ ኦኮ ኤንታዉ ባላ ግዶናይሳ ሙሰ ህግያን ናባብበከቲ?<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">ታይቦ 28:9-10</ref>.</char></note> <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>ሽን ስእተ! ፆሳ ኬፈ አይ ሀይሳን ደኤስ። <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>‘ታኒ ህንተ ያርሹዋ ግዶናሽን ሀራታ ማራና መላ ኮያይስ’ ግያ ቃላይ ወይ ጉሰኮ ህንተ ኤርዳኮ፥ ፅሎ አሳ ቦላ ፕርደከታ።<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">ማቶ 9:13</ref>፤ <ref loc="HOS 6:6">ሆሰ 6:6</ref>.</char></note> <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>አሳ ናአይ ሳምባታ ጎዳ” ያግስ።<verse eid="MAT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>የሱሲ ያፐ ብድ አይሁደ ዎሳ ኬ ገልስ። <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>ያን ኩሸይ ጉንድዳ እስ ኡራይ ደኤስ። የሱሳ ሞታናዉ ጋሶ ኮይያ አሳት፥ “ሳምባታ ጋላስ ፓናዉ በሲ በሰኔ?” ያግድ ኦይችዶሶና።<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>እ ኤንታኮ፥ “ህንተ ግዶፈ እሱዋስ ዶርስ ሳምባታ ጋላስ አፎን ዉልኮ፥ ጎችድ ከሶናይ ኦኔ?<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">ሉቃ 14:5</ref>.</char></note> <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>ያትን አስ ዶርሳፈ ዋንድ ዳሮ አኔ? ሄሳ ግሾ፥ ሳምባታ ጋላስ ሎኦባ ኦሶይ በሴስ” ያግስ።<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>ሄሳፈ ጉየ፥ የሱሲ አድያኮ፥ “ነ ኩሽያ ፕድ ኦ” ያግን፥ ኡራይ ፕድ ኦስ። እያ ኩሸይ ፓፅድ ሀንኮ ኩሽያዳ ሀንስ። <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>ሽን ፋርሳወት ያፐ ካረ ከይድ፥ የሱሳ ዋት ዎነኮ ማቀትዶሶና።<verse eid="MAT 12:14"/></para>
  <para style="s1">ዶረትዳ ፆሳ አይልያ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>የሱሲ ኤንታ ቆፋ ኤርድ ሄ በሳ አግድ ሀራ ሶ ብስ። ዳሮ አሳይ እያ ካልድ ብዶሶና፥ ሀርጋንቾታ ኡባ ፓስ። <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>የሱሲ፥ “ታባ ሀራ ኦደስካ ኦዶፕተ” ያግድ ምን ኦድስ። <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>ሄስካ ናብያ እሳያስ፥<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>“ሄኮ ታ ዶርዳ አይለይ፥</para>
  <para style="q2" vid="MAT 12:18">ታ ዶሰይስ፥ ታና ኡፋይሰይስ፥</para>
  <para style="q2" vid="MAT 12:18">ታኒ ታ አያና፥ እያ ቦላ ሸምፕሳና፤<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">እሳ 42:1-4</ref>.</char></note></para>
  <para style="q2" vid="MAT 12:18">እ፥ አይሁደ ግዶና ደርያስ ሱረ ፕርዳባ አዋጃና።<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>እ ፓላመና ዎይኮ ካጨና፤</para>
  <para style="q2" vid="MAT 12:19">ባ ቃላካ ደንባን ጮ ስሰና።<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>ሱረ ፕርዳን ፆኖ ደማና ጋካናዉ፥</para>
  <para style="q2" vid="MAT 12:20">ድንጨትዳ ማይረ መንና፥</para>
  <para style="q2" vid="MAT 12:20">ጩይያ ሙቃዳ ቶይሰና።<verse eid="MAT 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21"/>አይሁደ ግዶና ደረይ ኡባይ እያን ኡፋይስ ዎና”</para>
  <para style="m" vid="MAT 12:21">ያግድ ፃፍዳይስ ፖለታና መላሳ።<verse eid="MAT 12:21"/></para>
  <para style="s1">የሱሳነ ብኤል-ዘቡላ</para>
  <para style="r">(<ref loc="MRK 3:20-30">ማር 3:20-30</ref>፤ <ref loc="LUK 11:14-23">ሉቃ 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>ሄሳፈ ጉየ፥ ቱና አያናን ኦይከትዳ ቆቀነ ሙመ አሰ ደኤይሳ እያኮ ኤህዶሶና። የሱሲ ኡራ ፓን፥ ኡራይ ፄልስ፤ ኦደትስ። <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>አሳ ኡባይ ማላለትድ፥ “ሀይስ ዳዊታ ናኣ ግዳንደሻ?” ያግዶሶና።<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>ሽን ፋርሳወት ሄሳ ስእድ፥ “ሀ ኡራይ ቱና አያናታ ከሰይ ቱና አያናታ ሀላቃ ብኤል-ዘቡላ ዎልቃና” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ 9:34</ref>፤ <ref loc="MAT 10:25">10:25</ref>.</char></note><verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>የሱሲ ኤንታ ቆፋ ኤርድ፥ “ዎል ግዶን ሻከትያ ካዎተ ኡባይ ኩንዳና፤ ቃስ ዎል ግዶን ሻከትያ ካታማይ ዎይኮ ኬይ ምንድ ኤቀና። <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>ፃላሄይ ፃላሄ ከስያባ ግድኮ ባ ግዶን ሻከትስ ጉሱ። ሄሳ ሀንያባ ግድኮ እያ ካዎተይ ዋንድ ምንድ ኤቃናዉ ዳንዳኢ? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>ታኒ ቱና አያና ከሰይ ብኤል-ዘቡላ ዎልቃን ግድኮ ህንተና ካልያ አሳት ኦደ ዎልቃን ከሳኔ? ሄሳ ግሾ፥ ህንተና ካልያ አሳት ህንተና ፕርዳና። <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>ሽን ታኒ ቱና አያናታ ከሰይ ፆሳ አያናን ግድኮ፥ ፆሳ ካዎተይ ህንተኮ ይስ።<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>“ዎይኮ እስ አስ ዎልቃማ አሳ ሶ ገልድ እያ ሻሉዋ ቦንቃናዉ ኮይኮ ኮይሮትድ ሄ ኡራ ቃቾና እፅኮ ዋትድ ዳንዳኢ? ያትኮ እያ ሻሉዋ ቦንቃናዉ ዳንዳኤስ።<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>“ታራ ግዶናይ ኦንካ ታራ ኤቀቴስ፤ ቃስ ታራ እስፈ ሺሾና ኡባይ ላሌስ።<note caller="-" style="x"><char style="xo" closed="false">12:30 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር 9:40</ref>.</char></note> <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>ሄሳ ግሾ፥ ስእተ፤ አሳይ ኦያ አይ ናጋርነ ጫሻ ቃል ኡባይ አቶ ጌተታና፥ ሽን ጌሻ አያና ጫይያ ኦደስካ እያ ናጋራይ አቶ ጌተተና።<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ 12:10</ref>.</char></note> <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>ኦንካ አሳ ናአ ቦላ ኢታባ ኦደትኮ እያዉ አቶ ጌተታና፥ ሽን ጌሻ አያና ቦላ ኢታባ ኦደትያ ኦደስካ ሀ ሳአን ግድን ያና አላምያን እያ ናጋራይ አቶ ጌተተና።<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ 12:10</ref>.</char></note><verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>“ሎኦ ምይ ሎኦ አይፈ አይፌስ፤ ቃስ ኢታ ምይ ኢታ አይፌስ። ህዛ፥ ምይ ኤረተይ ባ አይፍያና። <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>ህንተኖ፥ ሾሻ ናይቶ፥ ህንተ ኢታ ግድሸ ዋንድ ሎኦባ ኦደታናዉ ዳንዳኤቲ? አስ ባ ዎዛናን ኩምዳባፐ ዶናን ኦደቴስ።<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ 3:7</ref>፤ <ref loc="MAT 23:33">23:33</ref>፤ <ref loc="LUK 3:7">ሉቃ 3:7</ref>፤ <ref loc="MAT 15:18">ማቶ 15:18</ref>፤ <ref loc="LUK 6:45">ሉቃ 6:45</ref>.</char></note> <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>ሎኦ አስ ባ ዎዛናን ዎዳ ሎኦባፐ፥ ሎኦባ ከሴስ፤ ኢታ አስ ባ ዎዛናን ዎዳ ኢታባፐ፥ ኢታባ ከሴስ። <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>ሽን ስእተ፥ አሳይ ኦደትያ ጮ ኦዳ ኡባስ ፕርዳ ጋላስ ዛሮ እማና። <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>አይስ ጊኮ፥ ነ ኦደትያ ነ ቃላን ፅላና፤ ነ ኦደትያ ነ ቃላይ ነ ቦላ ፕርዳና” ያግስ።<verse eid="MAT 12:37"/></para>
  <para style="s1">ዮናሳ ማላታ</para>
  <para style="r">(<ref loc="MRK 8:11-12">ማር 8:11-12</ref>፤ <ref loc="LUK 11:29-32">ሉቃ 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>ሄሳፈ ጉየ፥ እስ እስ ፋርሳወትነ ህገ አስታማረት የሱሳኮ፥ “አስታማርያዉ፥ ኔኒ ማላታ ኦዳ ኑና በሳ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">ማቶ 16:1</ref>፤ <ref loc="MRK 8:11">ማር 8:11</ref>፤ <ref loc="LUK 11:16">ሉቃ 11:16</ref>.</char></note><verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>ሽን የሱሲ ዛሪድ፥ “አማነቶናነ ኢታ የለተይ ማላታ ኮዬስ። ሽን ናብያ ዮናሳ ማላታፐ ሀራ ማላት እያዉ እመተና።<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">ማቶ 16:4</ref>፤ <ref loc="MRK 8:12">ማር 8:12</ref>.</char></note> <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>ዮናስ ግታ ሞሎ ኡሎን ሄ ጋላስነ ሄ ቃማ ጋምእዳይሳ መላ አሳ ናአይ ሄ ጋላስነ ሄ ቃማ ቢታ ጋርሳን ጋምአና።<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="JHN 1:17">ዮሀ 1:17</ref>.</char></note> <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>ናናወ አሳይ ፕርዳ ጋላስ ደንድድ ሀ የለተ ቦላ ፕርዳና፤ አይስ ጊኮ፥ ኤንቲ ዮናስ ሳባክን፥ ስእድ ባንታ ናጋራፐ ስምዶሶና። ሄኮ፥ ዮናሳፐ አይስ ሀይሳን ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JHN 3:5">ዮሀ 3:5</ref>.</char></note> <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>ፕርዳ ጋላስ ዱገሀ ካውያ ደንዳዳ ሀ የለተ ቦላ ፕርዳና፤ አይስ ጊኮ፥ እያ ሶሎሞነ ጭንጫተ ስአናዉ ቢታ ጋፃፐ ያሱ። ሄኮ፥ ሶሎሞነፐ አይ ሀይሳን ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 ካዎ 10:1-10</ref>፤ <ref loc="2CH 9:1-12">2 ታር 9:1-12</ref>.</char></note><verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>“ቱና አያናይ አሳፐ ከይዳፐ ጉየ ባዉ ሸምፕያ በሲ ኮይድ ሃ ባይና መላ በሳን ዳቡሬስ፥ ሽን ባ ኮይያ ሸምፑዋ ደመና። <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>ያንን፥ ‘ታ አጋ ከይዳ ኬ ስማዳ ባና’ ያጌስ። እ ስምያ ዎደ ኬይ ካይስ ግደይሳነ ፕተትድ ጊግድ ኡትዳይሳ ደሜስ። <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>ህዛ፥ ስም ብድ፥ ባፐ ኢትያ ሀራ ላፑን ኢታ አያናታ ኤክድ ዬስ፤ ኤንትካ ኡራ ግዶ ገልድ ደኦሶና። ሄ ኡራስ ካሰይሳፈ ጉየይስ ዳሮ ኢቴስ። ሀ ኢታ የለተ ቦላ ሄሳ መላ ሀናና” ያግስ።<verse eid="MAT 12:45"/></para>
  <para style="s1">የሱሳ አይዉነ እያ እሻታ</para>
  <para style="r">(<ref loc="MRK 3:31-35">ማር 3:31-35</ref>፤ <ref loc="LUK 8:19-21">ሉቃ 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>የሱሲ ደርያስ ኦዳ ቦላ ደእሽን እያ አያነ እያ እሻት እያ ኦድሳናዉ ኮይድ ካረን ኤቅዶሶና። <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>እስ አስ እያኮ፥ “ነ አያነ ነ እሻት ነና ኦድሳናዉ ኮይድ ካረን ኤቅዶሶና” ያግስ።<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>የሱሲ ዛሪድ፥ “ታ አይያ ኦኔ? ታ እሻትካ ኦናንቴ?” ያግስ። <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>ባ ኩሽያራ ታማረታ ማልሸ፥ “በእተ፥ ታ አያነ ታ እሻት ሀይሳታ። <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>ሳሎን ደእያ ታ አዋ ሸንያ ኦያ ኡባይ ታ እሻ፥ ታ ምቾነ ታ አዮ” ያግስ።<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">ዘረ ዘርያ ኡራ ሌምሶ</para>
  <para style="r">(<ref loc="MRK 4:1-9">ማር 4:1-9</ref>፤ <ref loc="LUK 8:4-8">ሉቃ 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>ሄ ጋላስ የሱሲ ሶፐ ከይድ አባ ጋፃን ኡትስ። <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>ዳሮ ደረይ እያ ዩሹዋን ሺቅን አሳ አባ ጋፃን አጋግድ ዎጎሎን ገልድ ኡትስ።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1">ሉቃ 5:1</ref>.</char></note> <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>አሳስ ዳሮባ ሌምሶን ያግድ ኦድስ፦</para>
  <para style="p" vid="MAT 13:3">“እስ ጎሻንቾይ ዘረ ዘራናዉ ከይስ። <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>እ ዘርያ ዎደ እስ እስ ዘረት ኦገ ጋፃን ዎዶሶና፤ ኤንታካ ካፎት ይድ ማፅ ምዶሶና። <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>እስ እስ ዘረት ጋርሳን ሻሎይ ደእያ ቢታ ቦላ ዎዶሶና። ዳሮ ቢት ባይና ግሾ ኤለስድ ዶልስ። <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>ሽን አዋይ ከይን ሹልስ፤ ፃጶይ ባይና ግሾ መልስ። <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>እስ እስ ዘረይ አጉን ግዶን ዎስ፤ አጉንይ ድጭድ ሄ ዶላ ጩልስ። <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>ሀራት ቃስ አራዳ ቢታ ቦላ ዎስ፤ ዶልድ አይፈ አይፍስ። እሶይ ፄታ፥ እሶይ ኡሱፑን ታማ፥ እሶይ ቃስ ሀስታማ አይፍስ። <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>ስእያ ሀይ ደእያ ኡራይ ስኦ” ያግስ።<verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>የሱሳ ታማረት እያኮ ሺቅድ፥ “አይስ ኔኒ ደርያስ ሌምሶን ኦዳይ?” ያግድ ኦይችዶሶና።<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>እ ዛሪድ፥ “ህንተዉ ሳሎ ካዎተ ፁራ ኤራይ እመትስ፥ ሽን ኤንታዉ እመትቤና። <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>ደእያ ኡባስ ጉዠታና፥ እያዉ ዳራና፥ ሽን ባይናይሳፈ ሀር አቶሽን እያዉ ደእያራካ ኤከታና።<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶ 25:29</ref>፤ <ref loc="MRK 4:25">ማር 4:25</ref>፤ <ref loc="LUK 8:18">ሉቃ 8:18</ref>፤ <ref loc="LUK 19:26">19:26</ref>.</char></note> <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>ሄሳ ግሾ፥ ታኒ ኤንቲ፥ ፄልሸ ደሞና መላ፥ ስእሸ ስኦና መላ ዎይኮ አኬኮና መላ ኤንታዉ ሌምሶን ኦዳይስ።<verse eid="MAT 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14"/>“እሳያስ ባ ማፃፋን ኦድዳይስ ኤንታ ቦላ ፖለትስ። እ ኦድሸ፥</para>
  <para style="q1" vid="MAT 13:14">“ ‘ህንተ ስስ ስኤታ፥ ሽን አኬከከታ፤</para>
  <para style="q2" vid="MAT 13:14">ህንተ ፄለታ፥ ሽን በኤከታ።<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>አይስ ጊኮ፥ ሀ አሳ ዎዛናይ ዘልኡምስ፤</para>
  <para style="q2" vid="MAT 13:15">ባንታ ሀይ ኤርሸ ቱልስዶሶና፥</para>
  <para style="q2" vid="MAT 13:15">ባንታ አይፍያ ጎዝዶሶና።</para>
  <para style="q2" vid="MAT 13:15">ሄስ ባይነኮ ኤንቲ ባንታ አይፍያን በእድ፥</para>
  <para style="q2" vid="MAT 13:15">ባንታ ሀይን ስእድ፥</para>
  <para style="q2" vid="MAT 13:15">ባንታ ዎዛናን አኬክድ፥</para>
  <para style="q2" vid="MAT 13:15">ታኮ ስማና፥</para>
  <para style="q2" vid="MAT 13:15">ታካ ኤንታ ፓናሽን’ ያግስ።<verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>“ሽን ህንተ አይፈት በእያ ግሾነ ህንተ ሀይት ስእያ ግሾ ህንተ አንጀትዳይሳታ።<note caller="-" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">ሉቃ 10:23-24</ref>.</char></note> <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>ታ ህንተዉ ቱማ ኦዳይስ፤ ዳሮ ናበትነ ፅሎት ህንተ በኤይሳ በአናዉነ ህንተ ስኤይሳ ስአናዉ አሞትዶሶና፥ ሽን ኤንታዉ ሀንቤና።<verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>“ህዛ፥ ሀ ዘረ ዘርያ ኡራ ሌምሱዋ ስእተ። <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>ኦገ ጋፃን ዎዳ ዘረ ሌምሶይ ሀይሳ፦ ሳሎ ካዎተ ቃላ ስእድ አኬኮና ኡራ ዎዛናፐ ፃላሄይ ይድ እያ ዎዛናን ደእያ ዘረ ማፅ ድጌስ። <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>ሻሎይ ጋርሳን ደእያ ቢታ ቦላ ዘረትዳይስ ቃላ ስእድ ኤለስድ ኡፋይሳን ኤከይሳታ። <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>ሽን ፃጶ የዳናዉ ዳንዳኦና ግሾ ዳሮ ጋምኦኮና። ቃላ ጋሶን መቶይ ዎይኮ ጎደተ ያ ዎደ ኤለስ በቶሶና። <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>አጉን ጋን ዘረትዳይስ ቃላ ስእስ፥ ሽን ሀ አላምያ ዱሳ ህርጋይነ ዱረተ ቆፋይ ቃላ ጩልያ ግሾ አይፈ አይፎና አቴስ። <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>ሽን አራዳ ቢታን ዘረትዳ ዘረይ አኬካን ቃላ ስእያ ኡራ። እ አይፈ አይፌስ፤ እሶይ ፄታ፥ እሶይ ኡሱፑን ታማ እሶይ ቃስ ሀስታማ አይፌስ” ያግስ።<verse eid="MAT 13:23"/></para>
  <para style="s1">ሌሾ ሌምሶ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>የሱሲ ኤንታዉ ሀራ ሌምሶ ኦድስ፥ “ፆሳ ካዎተይ ባ ጎሻን ሎኦ ዘረ ዘርዳ ኡራ ዳኔስ። <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>ሽን አስ ኡባይ ስክን እያ ሞርከይ ይድ ግስትያ ግዶን ሌሾ ዘርድ ብስ። <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>ግስተይ ድጭድ አይፍያ ዎደ ሌሾይ እያ ግዶን በንትስ።<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>“ጋድያ ጎዳ አይለት ጎዳኮ ብድ፥ ‘ጎዳዉ፥ ነ ጎሻን ነ ሎኦ ዘረ ዘራብክሾ? ያትን፥ ሌሾይ አዉፐ ይዴ?’ ያግዶሶና።<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>“እ ኤንታኮ፥ ‘ሄሳ ሞርከይ ኦስ’ ያግስ።</para>
  <para style="p" vid="MAT 13:28">“አይለት ጎዳኮ፥ ‘ኑ ብድ ሌሹዋ ሾዳና መላ ኮያይ?’ ያግዶሶና።<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>“ሽን እ፥ ‘አቶ ቦቾፍተ፤ ህንተ ሌሹዋ ሾዳይስ ግሽን ግስተይ ሾደታና። <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>ቦቾፍተ፤ ጫካ ዎደይ ጋካናዉ እስፈ ድጮ። ሄ ዎደ ጫክያ አሳታ ሌሹዋ ስንትድ ማፅድ ታማን ፁጋናዉ ምርቀን ምርቀን ቃችተ። ሽን ግስትያ ሺሽድ ታ ሻልያን ቆልተ’ ያጋና” ያግስ።<verse eid="MAT 13:30"/></para>
  <para style="s1">አይፈ ጉ ም ሌምሶ</para>
  <para style="r">(<ref loc="MRK 4:30-32">ማር 4:30-32</ref>፤ <ref loc="LUK 13:18-19">ሉቃ 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>ቃስ ሀራ ሌምሶ ያግድ ኦድስ፤ “ሳሎ ካዎተይ እስ አስ ባ ጎሻን ባክዳ ጉ ም አይፈ ዳኔስ። <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>ሄ ም አይፈይ ሀራ ም አይፈታፐ ጉ፥ ሽን እያ ዶላ ድጭዳ ሀራ ምታ ኡባፈ አዳ ግታታዉሱ። እ ታሽያን ካፎት ኬፅድ ኡታና ጋካናዉ ዎልቃማ ም ግዳዉሱ” ያግስ።<verse eid="MAT 13:32"/></para>
  <para style="s1">እርሾ ሌምሶ</para>
  <para style="r">(<ref loc="LUK 13:20-21">ሉቃ 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>ካልድካ፥ የሱሲ ሀራ ሌምሶ ኦድስ፤ “ሳሎ ካዎተይ እስ ማጫስ ሄ ጋባተ ለ ኤካ ሙኑቃዳ፥ ሙኑቃይ ደንዳና መላ እያን ጉጅዳ እርሾ ዳኔስ” ያግስ።<verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>የሱሲ ደርያስ ሄ ሌምሱዋ ኡባ ኦድስ። ሌምሶይ ባይና እስባካ ኦድቤና። <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>ናበይ ባ ማፃፋን፥</para>
  <para style="q1" vid="MAT 13:35">“ታኒ ታ ዶና፥ ሌምሶን ዶያና፤</para>
  <para style="q2" vid="MAT 13:35">ሳሎይነ ሳእ መቶሳፐ፥</para>
  <para style="q2" vid="MAT 13:35">ጌምዳይሳ ኦዳይስ”</para>
  <para style="m" vid="MAT 13:35">ያግድ ኦድዳይስ ሄሳን ፖለትስ።<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">ማዝ 78:2</ref>.</char></note><verse eid="MAT 13:35"/></para>
  <para style="s1">ሌሾ ሌምሶ ብርሸ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>የሱሲ ደርያ ሞይዝድ ሶ ገልስ። እያ ታማረት እያኮ ሺቅድ፥ “ጎሻን ደእያ ሌሹዋ ብርሸ ኑስ ኦዳ” ያግዶሶና።<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>እ ዛሪድ፥ “ሎኦ ዘረ ዘርዳይ አሳ ናአ። <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>ጎሻይ ሀ አላምያ። ሎኦ ዘረይ ሳሎ ካዎተ ናይታ። ሌሾይ ፃላሄ ናይታ። <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>ሌሹዋ ዘርዳይ ሞርክያ ፃላሄ። ጫካ ዎደይ፥ ዎደ ዉርሰ፤ ጫከይሳት ኪታንቾታ።<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>“ሌሾይ ማፀትድ ታማን ፁገተይሳ መላ ዎድያ ዉርሰን ሄሳዳ ሀናና። <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>አሳ ናአይ ባ ኪታንቾታ ኪታና። ኤንቲ ናጋራስ ጋሶ ግደይሳታነ ኢታ ኦያ ኡባ ማፅድ እያ ካዎተፈ ከሳና። <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>ማፅ ሺሽድ ዬሆይነ አቻ ጋርጨ ደእያ ቶኦና ታማን የጋና። <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>ሄ ዎደ ፅሎት ባንታ አዋ ካዎተን አዋዳ ፖአና። ስእያ ሀይ ደኤይ ስኦ!<verse eid="MAT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>“ፆሳ ካዎተይ ጎሻን ሞገትዳ ሚሸ ዳኔስ። እስ አስ ሄ ሚሽያ ደምድ ዛር ሞግስ። ዳሮ ኡፋይትድ ብድ ባዉ ደእያባ ኡባ ባይዝድ ሄ ጎሻ ጋድያ ሻምስ።<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>“ሄሳዳካ፥ ቃስ ሳሎ ካዎተይ እንቁ ጌተትያ አልኦ ሹቻታ ኮይያ ዛልአንቾ ዳኔስ። <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>ዳሮ አልኦ እንቁዋ ደምድ ብድ ባዉ ደእያባ ኡባ ባይዝድ እያ ሻምስ።<verse eid="MAT 13:46"/></para>
  <para style="s1">ሞሎ ኦይክያ ግተ ሌምሶ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>“ቃስ ፆሳ ካዎተይ አባን የገትዳ ዱማ ዱማ ቆሞ ሞሎ ኦይክያ ግትያ ዳኔስ። <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>ሞሎ ኦይክያ አሳት ሞሎይ ግትያን ኩምን አባፈ ጋፃ ከስዶሶና። ያን ኡትድ ሎኡዋ ቆር ቆር ዳቾን የግዶሶና፥ ሽን ኢታ ሞሎታ ዎራ ሆልዶሶና። <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>ዎድያ ዉርሰን ሄሳ ሀናና። ኪታንቾት ይድ ናጋራንቾታ ፅሎታፐ ሻክድ፥ <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>ዬሆይነ አቻ ጋርጨ ደእያ ቶኦና ታማን የጋና።<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>“ሀ ኡባይ ህንተዉ ገልዴ?” ያግድ ኤንታ ኦይችስ።</para>
  <para style="p" vid="MAT 13:51">ኤንቲ ዛሪድ፥ “ኤ” ያግዶሶና።<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>የሱሲ፥ “ህዛ፥ ሳሎ ካዎተ ኤራ ኤክድ ህግያ ታማርስያ ኡባይ፥ ባ ምንጅዳ ሻሉዋፐ ኦራነ ጋልአ ከስያ አሰ ዳኔስ” ያግስ።<verse eid="MAT 13:52"/></para>
  <para style="s1">የሱሲ ናዝረተን እፀትስ</para>
  <para style="r">(<ref loc="MRK 6:1-6">ማር 6:1-6</ref>፤ <ref loc="LUK 4:16-30">ሉቃ 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>የሱሲ ሀ ሌምሱዋ ኦድ ዉርስዳፐ ጉየ ያፐ ደንድድ ብስ። <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>ባ የለትዳ ቢታ ብድ አይሁደ ዎሳ ኬን ደርያ ታማርስስ። ኤንቲ ማላለትድ፥ “ሀ ኡራይ ሀ ጭንጫተነ ሀ ማላታታ ኦያ ዎልቃ አዉፐ ኤክዴ? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>ሀይስ አናፅያ ናኣ ግደነዬ? እያ አየ ሱንይ ማይራሞ ግደኔ? እያ እሻት ያይቆባ፥ ዮሰፋ፥ ስሞናነ ይሁዳ ግዶኮናዬ? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>እያ ምቸት ኑራ ደኦሶና ግዶኮና? ያትን፥ ሀ ኡራይ ሀ ኡባ አዉፐ ኤክዴ?” ያግዶሶና። <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>ሄሳ ግሾ፥ እ ግያባ ኤኮና እፅዶሶና።<note caller="-" style="x"><char style="xo" closed="false">13:57 </char><char style="xt" closed="false"><ref loc="JHN 4:43">ዮሀ 4:43</ref>.</char></note></para>
  <para style="p" vid="MAT 13:57">ሽን የሱሲ፥ “ናበይ ባ የለትዳ ቢታንነ ባ ሶ አሳ ማታን ቦንቸተና” ያግስ። <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>ኤንቲ አማኖና እፅዳ ግሾ ዳሮ ማላታታ ሄ በሳን ኦቤና።<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">ፃማቅያ ዮሃንሳ ሀይቁዋ</para>
  <para style="r">(<ref loc="MRK 6:14-29">ማር 6:14-29</ref>፤ <ref loc="LUK 9:7-9">ሉቃ 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>ሄ ዎደ ጋልላ አይስያ ሄሮዲስ<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="fq" closed="false">ሄሮዲስ፦ </char><char style="ft" closed="false">ሀይስ ካዋ ሄሮዲሳ አንትጳሳ። እ፥ ይሁዳነ ፔርያ ክርስቶስ የለታናፐ ስን 4-39 ምልክ ጋካናዉ ሃርስ። እ ካዋ ሄሮዲሳስ ናአ።</char></note> የሱሳባ ስእስ። <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>ባ አይለታኮ፥ “ሀይስ ፃማቅያ ዮሃንሳ፤ እ ሀይቆፐ ደንድስ። ያንዳ ግሾ፥ ሀ ኡባ ማላታታ እ ኦስ” ያግስ።<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>እ ሄሳ ግዳይ ሄሮዲስ ባ እሻ ፍልጶሳ ማቸ ሄሮድያድ ጋሶን ዮሃንሳ ቃሾ ኬ ገልስዳ ግሾሳ። <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>ዮሃንስ ሄሮዲሳ፥ “ነ እዮ ኤካናዉ ዎጋ ግደና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">ሉቃ 3:19-20</ref>፤ <ref loc="LEV 18:16">ሌወ 18:16</ref>፤ <ref loc="LEV 20:21">20:21</ref>.</char></note> <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>ሄሮዲስ ዮሃንሳ ዎናዉ ኮይስ፥ ሽን ደረይ ዮሃንሳ ናበ ኦድ በእያ ግሾ ያሸትስ።<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>ሄሮዲስ ባ የለትዳ ጋላሳ ቦንችያ ዎደ፥ ሄሮድያዳ ናእያ አሳ ስንን የን ዱራዳ እያ ኡፋይሳሱ። <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>ያትን፥ እ፥ “እያ ኮያባ ኡባ እማና ግድ” ጫቅስ። <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>ናእያ ባ አየ ዞርያ ስአዳ ሄሮዲሳኮ፥ “ፃማቅያ ዮሃንሳ ሁጵያ ከረን ዎዳ ታዉ እማ” ያጋሱ። <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>እያ ያግን ካዎይ ቂሮትስ፥ ሽን ባ ጫቁዋ ግሾነ ባራ ደእያ እማታ ግሾ ግድ እ ኦይሻይ ፖለታና መላ ኪትስ። <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>ካዎይ አሰ ኪትድ ዮሃንስ ቃሾ ኬን ደእሽን እያ ቆያ ጎራእስስ። <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>ሁጵያ ከረን ዎ ኤህድ ናኤስ እምዶሶና፤ ናእያካ ኤካዳ ባ አየስ ኤፋሱ። <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>ዮሃንሳ ታማረት ይድ እያ አሀ ኤፍድ ሞግዶሶና። እያፐ ጉየ ሀንዳባ ኡባ ብድ የሱሳስ ኦድዶሶና።<verse eid="MAT 14:12"/></para>
  <para style="s1">እቻሹ ሙኩሉ አሳ</para>
  <para style="r">(<ref loc="MRK 6:30-44">ማር 6:30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ 9:10-17</ref>፤ <ref loc="JHN 6:1-14">ዮሀ 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>የሱሲ ሀንዳባ ስእዳ ዎደ ዎጎሎን ገልድ ሄ በሳፈ እስ ጌምያ ሶ ባርካ ብስ። አሳይ ሄሳ ስእድ ካታማታፐ ደንድድ ቶሆን እያ ካልዶሶና። <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>የሱሲ ዎጎሉዋፐ ዎድ ዳሮ አሳ በእድ ኤንታዉ ቃትስ። ኤንታ ግዶን ደእያ ሀርጋንቾታ ፓስ።<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>ሳአይ ኦማርስሸ ብያ ዎደ የሱሳ ታማረት እያኮ ሺቅድ፥ “ሀ በሳይ አስ ባይና በሲ፥ ሳእካ ቃምስ። ያንያ ግሾ፥ ሄራን ደእያ ጉታታ ብድ ባንታዉ ሻምድ ማና መላ ደርያ የዳ” ያግዶሶና።<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>ሽን የሱሲ ኤንታኮ፥ “ደረይ ሞና ባናዉ ኮሸና፤ ኤንቲ ማናባ ህንተ እምተ” ያግስ።<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>ኤንቲ ዛሪድ፥ “ኑስ ሀይሳን እቻሹ ኡይፈነ ናምኡ ሞሎፐ ሀር ባዋ” ያግዶሶና።<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>እካ፥ “አነ ኤንታ ሃ ኤህተ” ያግስ። <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>ካልድካ፥ ደረይ ማታን ኡታና መላ ኦድስ። እቻሹ ኡይነ ናምኡ ሞሎታ ኤክድ፥ ሳሎ ፄልድ ጋላት ስሚድ፥ ኡይ መንድ ባ ታማረታስ እሚስ፤ ኤንቲ ቃስ ደርያስ እምዶሶና። <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>ኡባይ ምድ ካልዶሶና። የሱሳ ታማረት ምሽን አትዳይሳ ታማነ ናምኡ ጋይታ ደንዶሶና። <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>ካ ምዳ አሳይ ማጫሳይነ ናይት አትሽን፥ እቻሹ ሙኩሉ ግዴስ።<verse eid="MAT 14:21"/></para>
  <para style="s1">የሱሲ አባ ቦላራ ሄመትስ</para>
  <para style="r">(<ref loc="MRK 6:45-52">ማር 6:45-52</ref>፤ <ref loc="JHN 6:15-21">ዮሀ 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>የሱሲ ባ ታማረት ዎጎሎን ገልድ ባፐ ስንትድ አባፈ ሄ ፕን ፕናና መላ ኪትድ ባዉ ደርያ ሞይዛናዉ ጉየ አትስ። <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>ደርያ ሞይዝ ስሚድ ባርካ ዎሳናዉ እስ ዙማ ቦላ ከይስ። ሳአይ ቃምንካ እ ባርካ ያን ጋምእስ። <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>ሄ ዎደ ዎጎሎይ አባ ቦላ ብሽን ስን ባጋራ ጫርኮይ ደንድን ሆበይ ዎጎሉዋ ኡንኤስ።<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>ዎንትማ ቦላ የሱሲ አባ ቦላ ሄመትሸ ባ ታማረታኮ ይስ። <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>እያ ታማረት፥ እ አባ ቦላ ሄመትሸ ባንታኮ የይሳ በእድ ያይዶሶና። ኤንትካ፥ “ሀይስ ሞይትለ” ግድ ያይድ ዋስዶሶና።<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>ሽን የሱሲ ኤለስድ፥ “አይኮይ ባዋ! ያዮፍተ! ታናባይ” ያግስ።<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>ጰፅሮስ እያኮ፥ “ጎዳዉ፥ ነና ግድኮ፥ ታኒ ሃ ቦላራ ሄመታዳ ኔኮ ባና መላ ታና ኪታ” ያግስ።<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>የሱሲ ጰፅሮሳኮ፥ “ሃያ” ያግስ።</para>
  <para style="p" vid="MAT 14:29">ጰፅሮስ ዎጎሉዋፐ ዎድ ሃ ቦላራ ሄመትሸ የሱሳኮ ቡሱ ኦይክስ። <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>ሽን ዎልቃማ ጫርኩዋ በእድ ያይስ። ሃን ምተተ ኦይክዳ ዎደ፥ “ጎዳዉ! ታና አሻርክ!” ያግድ ዋስስ።<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>የሱሲ ኤለስድ ባ ኩሽያ የድ እያ ኦይክድ፥ “ነኖ፥ አማኖይ ፓጭዳይሶ አይስ ስይ” ያግስ።<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>የሱሳራነ ጰፅሮሳራ ዎጎሉዋን ገልዳ ዎደ ጫርኮይ ስእ ግስ። <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>ዎጎሉዋ ግዶን ደእያ እያ ታማረት፥ “ኔኒ ቱማካ ፆሳ ናአ” ግድ ጎይንዶሶና።<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>ኤንቲ አባ ፕንድ ገንሳሬፀ ቢታ ጋክዶሶና። <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>ሄ ቢታን ደእያ አሳይ የሱሳ ኤርዳ ዎደ ባንታ ሄራን ደእያ ጉታ ኡባ ኪታ የድዶሶና። አሳይ ሀርጋንቾታ ኡባ እያኮ ኤህዶሶና። <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>ሀርጋንቾት እያ አፍላ ማጫራ ፃላላ ቦቻና መላ ዎስዶሶና። ቦችዳ ኡባይካ ፓፅዶሶና።<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">ፋርሳወታ ዎጋ</para>
  <para style="r">(<ref loc="MRK 7:1-13">ማር 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>ሄሳፈ ጉየ፥ እስ እስ ፋርሳወትነ ህገ አስታማረት የሩሳላመፐ የሱሳኮ ይድ፥ <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“ነ ታማረት አይስ ኑ አዋታ ዎጋ መንና? ኤንቲ ካ ማናፐ ስን ባንታ ኩሽያ ሜጨቶኮና” ያግድ ኦይችዶሶና።<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>የሱሲ ዛሪድ፥ “ህንተ፥ ህንተ ዎጋ ግሾ፥ ፆሳ ኪታ ፖለይሳ አይስ እፄቲ? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>አይስ ጊኮ፥ ፆሳይ፥ ‘ነ አዋነ ነ አይዉ ቦንቻ። እ ባ አዋ ዎይኮ ባ አይዉ ጫየይስ ሀይቆ ግቤኔ?’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከሳ 20:12</ref>፤ <ref loc="DEU 5:16">ዛረ 5:16</ref>፤ <ref loc="EXO 21:17">ከሳ 21:17</ref>፤ <ref loc="LEV 20:9">ሌወ 20:9</ref>.</char></note> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>ሽን ህንተ፥ እስ አስ ባ አዋ ዎይኮ ባ አይዉ ማዳናባይ ደእሽን፥ ‘ሀይሳ ታ ፆሳስ ያርሻስ ጊኮ፥ <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>ባ አዋ ዎይኮ ባ አይዉ ቦንቻናዉ በሰና’ ያጌታ። ያትድ ህንተ፥ ህንተ ዎጋ ፖላናዉ ፆሳ ቃላ መንታ። <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>ህንተኖ፥ ጩቦቶ፥ እሳያስ ህንተባ ልከ ኦድስ፥<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>“ ‘ሀ አሳይ ታና ባንታ ዶናን ቦንቼስ፥</para>
  <para style="q2" vid="MAT 15:8">ሽን ኤንታ ዎዛናይ ታፐ ሃሆን ደኤስ።<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>አሳይ ታና ጮ ጎይኖሶና፤</para>
  <para style="q2" vid="MAT 15:9">ኤንቲ አስ መዳ ኪታ</para>
  <para style="q2" vid="MAT 15:9">ፆሳ ህገ ዳንስድ ታማርሶሶና’ ግስ” ያግስ።<verse eid="MAT 15:9"/></para>
  <para style="s1">አሰ ቱንስያባታ</para>
  <para style="r">(<ref loc="MRK 7:14-23">ማር 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>የሱሲ ዳሮ አሳ ባኮ ፄግድ፥ “ስእተ! አኬክተ! <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>አሰ ቱንስያባይ ዶናራ ገልያባ ግዶናሽን ዶናፐ ከያባ” ያግስ።<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>ሄሳፈ ጉየ፥ የሱሳ ታማረት እያኮ ይድ፥ “ፋርሳወት ኔኒ ግዳይሳ ስእድ በትዳይሳ አኬካይ?” ያግዶሶና።<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>ሽን የሱሲ ዛሪድ፥ “ሳሎን ደእያ ታ አዋይ ቶክቦና ም ኡባይ ሾደታና። <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>ኤንታባ ህርጎፍተ፤ ኤንቲ ቆቀ ካለያ ቆቀታ። ቆቀይ ቆቀ ካለኮ፥ ናምአይካ ኦላን ኩንዳና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">ሉቃ 6:39</ref>.</char></note><verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>ጰፅሮስ ዛሪድ፥ “ሀ ሌምሱዋ ብርሸ ኑስ ኦዳርኪ” ያግስ።<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>የሱሲ ኤንታኮ፥ “ህንተዉካ ሀእ ጋካናዉ ገልቤኔ? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>ዶናራ ገልያባ ኡባይ ኡሎ ገልድ ካረ ከየይሳ ኤረከቲ? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>ሽን ዶናራ ከያባይ ዎዛናፐ ከዬስ። አሰ ቱንስያባት ሄሳታ።<note caller="-" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ 12:34</ref>.</char></note> <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>ኤንትካ፦ አሳ ዎዛና ግዶፈ ከይያ ኢታ ቆፋ፥ ዎ፥ ላይማተ፥ ኢታ ኦሶ፥ ካይሶ፥ ዎርዶ ማርካተ፥ ጫሸ። <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>ሄሳ ዳንያባት አሰ ቱንሴስፐ አትሽን፥ ሜጨቶና ኩሸራ መይስ ቱንሰና” ያግስ።<verse eid="MAT 15:20"/></para>
  <para style="s1">እስ ማጫሰ አማኖ</para>
  <para style="r">(<ref loc="MRK 7:24-30">ማር 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>ሄሳፈ ጉየ፥ የሱሲ ያፐ ከይድ ፅሮሳነ ስዶና ካታማት ደእያ ቢታ ብስ። <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>እስ ካናነ ቢታ ማጫስ የሱሳኮ ያዳ፥ ባ ቃላ ቁ ኦዳ፥ “ጎዳዉ፥ ዳዊታ ናአዉ፥ ታዉ ቃታርክ፤ ታ ናእዉ ቱና አያናይ ኦይክድ ኢታ ዋይሴስ” ያጋሱ።<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>ሽን የሱሲ እስ ቃላካ ዛሮና ስእ ግስ። የሱሳ ታማረት እያኮ ይድ፥ “ሀ ማጫስያ ኑ ጌዶ ካላ ካላዳ፥ ዎሳዉሱ። ሄሳ ግሾ፥ ኔኒ እዮ ሞይዛርክ” ያግድ ዎስዶሶና።<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>የሱሲ ዛሪድ፥ “ታኒ ዉደፐ ይዳ ዶርሳዳ እስራኤለ ኬፈ ይዳ አሳታ ፃላላስ ኪተታስ” ያግስ።<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>ሽን እያ፥ እያ ስንን ኩንዳዳ፥ “ጎዳዉ፥ ታና ማዳርኪ?” ያጋሱ።<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>እ ዛሪድ፥ “ናይታ ካ ኤክድ ካናታስ የገይስ ሎኦ ግደና” ያግስ።<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>ማጫስያካ፥ “ጎዳዉ፥ ሄስ ቱማ፥ ሽን ሀር አቶሽን ካናት ባንታ ጎዳት ምሽን፥ ጋይታፐ ዎያ ቲፍያ ሞሶና” ያጋሱ።<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>የሱሲ ዛሪድ፥ “ሀ ማጫሰተ፥ ነ አማኖይ ግታ፤ ነ ኮይዳይሳዳ ነዉ ሀኖ” ያግስ። እ ናእያ ኢራካ ፓፃ አጋሱ።<verse eid="MAT 15:28"/></para>
  <para style="s1">ዳሮ ሀርጋንቾት ፓፅዶሶና</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>የሱሲ ያፐ ደንድድ ጋልላ አባ ማት ብስ። እስ ዙማ ቦላ ከይድ፥ ያን ኡትስ። <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>ዳሮ አሳይ ባንታራ፥ ዎበታ፥ ቆቀታ፥ ኩናታ፥ ዶና ሙመታነ፥ ሀራ ዳሮ ሀርጋንቾታ ኤክድ፥ እያኮ ኤህድ እያ ስንን ዎዶሶና። የሱሲ ኤንታና ፓስ። <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>ሄሳ ግሾ፥ ሙመት ኦደትሽን፥ ኩናት ፕድ ግሽን፥ ዎበት ሄመትሽን፥ ቆቀት ፄልሽን አሳይ በእድ ማላለትድ፥ እስራኤለ ፆሳ ጋላትዶሶና።<verse eid="MAT 15:31"/></para>
  <para style="s1">ኦይዱ ሙኩሉ አሳ</para>
  <para style="r">(<ref loc="MRK 8:1-10">ማር 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>የሱሲ ባ ታማረታ ባኮ ፄግድ፥ “ሀ ዳሮ አሳይ ታራ ሄ ጋላስ ጋምእዳ ግሾነ ኤንታዉ ሀእ ምያባይ ባይና ግሾ ታኒ ኤንታዉ ቃታይስ። ኤንቲ ኦገን ዳቡርድ ኩንዶና መላ አይኮ ሙዞና ኤንታ መላ የዳናዉ ኮይከ” ያግስ።<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>እያ ታማረት ዛሪድ፥ “ኑኒ ሀ ባዙዋን ሀይሳ ኬና አሳስ ግድያ ካ አዉፐ ደማኔ?” ያግዶሶና።<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>የሱሲ ኤንታኮ፥ “ህንተዉ አፑን ኡይ ደኢ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="MAT 15:34">ኤንቲ ዛሪድ፥ “ላፑን ኡይነ ላፋ ሞሎታፐ ጉ ደኤስ” ያግዶሶና።<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>የሱሲ ደርያ ሳአን ኡትተ ያግድ ኪትስ። <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>ሄሳፈ ጉየ፥ ሄ ላፑን ኡይነ ሞሉዋ ኤክድ ፆሳ ጋላትስ። መንድ ባ ታማረታስ እሚስ። እያ ታማረት ዳሮ አሳስ ግሽዶሶና።<verse eid="MAT 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 15:37"/>አሳ ኡባይ ምድ ካልዶሶና። እያ ታማረት፥ ምሽን አትዳ ቲፍያ ላፑን ግታ ጋይታ ኩመ ደንዶሶና። <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>ምዳ አሳይ ማጫስነ ናአ ፓይዶና አደ ፃላል ኦይዱ ሙኩሉ። <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>የሱሲ ደርያ የድዳፐ ጉየ ዎጎሉዋን ገልድ ማገዶና ቢታ ብስ።<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">ማላታ በአናዉ ኦይችዳ ኦይሻ</para>
  <para style="r">(<ref loc="MRK 8:11-13">ማር 8:11-13</ref>፤ <ref loc="LUK 12:54-56">ሉቃ 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>ፋርሳወትነ ሳዱቃወት የሱሳኮ ይዶሶና። እያ ፓጫናዉ ኮይድ፥ ባንታና ሳሎፐ ማላታ በሶ ግድ ኦይችዶሶና።<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ 12:38</ref>፤ <ref loc="LUK 11:16">ሉቃ 11:16</ref>.</char></note> <verse eid="MAT 16:1"/><verse number="2" style="v" sid="MAT 16:2"/>ሽን እ ኤንታኮ፥ “ሳእ ኦማርስያ ዎደ፥ ‘ሳሎይ ዞእዳ ግሾ ዎንቶ ቦቃላና’ ያጌታ። <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>ዎንትያ ዎደ፥ ‘ሳሎይ ዞእድ ሻራትዳ ግሾ እሪ ቡካና’ ያጌታ። ያትን ህንተ ሳሎ ማላ በእድ ኤሬታ፥ ሽን ዎድያ ማላ ኤራናዉ ዳንዳእቤከታ። <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>ኢታነ አማኖና የለተይ ማላታ ኮዬስ። ሽን እያዉ ዮናሳ ማላታፐ ሀራ ማላት እመተና” ያግስ። ሄሳፈ ጉየ፥ ኤንታና ያን አግድ ሀራ ሶ ብስ።<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">ማቶ 12:39</ref>፤ <ref loc="LUK 11:29">ሉቃ 11:29</ref>.</char></note><verse eid="MAT 16:4"/></para>
  <para style="s1">ፋርሳወታነ ሳዱቃወታ እርሾ</para>
  <para style="r">(<ref loc="MRK 8:14-21">ማር 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>ኤንቲ አባፈ ሄፍን ፕንዳ ዎደ ዳቦ ኤክድ ያናይሳ ዶግዶሶና። <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>የሱሲ ኤንታኮ፥ “ፋርሳወታፐነ ሳዱቃወታ እርሹዋፈ ናገትተ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ 12:1</ref>.</char></note> <verse eid="MAT 16:6"/><verse number="7" style="v" sid="MAT 16:7"/>ኤንትካ ባንታ ጋርሳን፥ “እ ሄሳ ግዳይ ኑ ዳቦ ኤክድ ዮና ግሾሳ ግዳና” ያግዶሶና። <verse eid="MAT 16:7"/><verse number="8" style="v" sid="MAT 16:8"/>የሱሲ ኤንታ ቆፋ ኤርድ፥ “ህንተኖ፥ አማኖይ ፓጭዳይሳቶ! ዳቦ ኤኮና ይዳ ግሾ ዎል ግዶን አይስ ኦደቴቲ? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>ሀእካ ህንተ አኬከቲ? እቻሹ ሙኩሉ አሳስ እቻሹ ኡይ ግሽዳይሳነ ኤንቲ ምድ ካልን ህንተ አፑን ጋይታ ኩመ ደንዳኮ ዶግደቲ?<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17">ማቶ 14:17</ref>.</char></note> <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>ሄሳዳካ፥ ላፑን ኡይ ኦይዱ ሙኩሉ አሳስ ግሽዳይሳነ ኤንቲ ምድ ካልን፥ ህንተ አፑን ግታ ጋይታ ኩመ ደንዳኮ አኬከከቲ?<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34">ማቶ 15:34</ref>.</char></note> <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>ህዛ፥ ታኒ ፋርሳወታነ ሳዱቃወታ እርሹዋፈ ናገትተ ጋዳ ኦደይስ ዳቦባ ግዶናይሳ አኬከከቲ?” ያግስ። <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>ያትን፥ እያ ታማረት የሱሲ ኦደይ ሙኑቃ ደንናዉ የገትያ እርሾባ ግዶናሽን ፋርሳወታነ ሳዱቃወታ ትምርትያፈ ናገታናይሳ ግደይሳ አኬክዶሶና።<verse eid="MAT 16:12"/></para>
  <para style="s1">ጰፅሮሳ ማርካተ</para>
  <para style="r">(<ref loc="MRK 8:27-30">ማር 8:27-30</ref>፤ <ref loc="LUK 9:18-21">ሉቃ 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>የሱሲ ቅሳረ ፍልጶሳ ቢታ ጋክዳ ዎደ ባ ታማረታኮ፥ “አሳይ፥ አሳ ናኣ ኦና ጎና?” ያግድ ኦይችስ።<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>ኤንትካ፥ “እሶት እሶት ፃማቅያ ዮሃንሳ፥ ሀራት ኤልያሳ ቃስ ሀንኮት ኤርምያሳ ዎይኮ ናበታፐ እሱዋ ጎሶና” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="MAT 14:1">ማቶ 14:1</ref>.</char></note><verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>የሱሲ ዛሪድ፥ “ያትን፥ ህንተ ታና ኦና ጌቲ?” ግድ ኤንታ ኦይችስ።<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>ስሞና ጰፅሮስ ዛሪድ፥ “ኔኒ ክርስቶሳ፥ ደኦ ፆሳ ናአ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="JHN 6:68">ዮሀ 6:68</ref>.</char></note><verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>የሱሲ ጰፅሮሳኮ፥ “ዮና ናኣ ስሞና፥ ኔኒ አንጀትዳይሳ! ሀይሳ ነዉ ቆንጭስዳይ ሳሉዋን ደእያ ታ አዋፐ አትሽን፥ አሰ ግደና። <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>ታ ነዉ ኦዳይስ ጰፅሮሳ፥ ኔኒ ዛላ! ታኒ ሀ ዛላ ቦላ ታ ዎሳ ኬ ኬፃና። ሀይቆ ዎልቃትካ እዮ ፆኖኮና። <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>ሳሎ ካዎተ ቁልፐታ ታ ነዉ እማና። ሳአን ኔኒ ድግያባይ ኡባይ ሳሎን ፆሳ ማታን ድገትዳባ ግዳና። ሳአን ኔኒ ሀኖ ግያባይ ኡባይ ሳሎን ፆሳ ማታን ሀንዳባ ግዳና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">ማቶ 18:18</ref>፤ <ref loc="JHN 20:23">ዮሀ 20:23</ref>.</char></note><verse eid="MAT 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20"/>ሄሳፈ ጉየ፥ እ፥ ክርስቶሳ ግደይሳ ኦደስካ ኦዶና መላ ባ ታማረታ ምንድ ኪትስ።<verse eid="MAT 16:20"/></para>
  <para style="s1">የሱሲ ባና ጋካና ዋያ ኦድስ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>ሄ ዎድያፐ ዶምድ የሱሲ ባ ታማረታስ፥ “ታኒ የሩሳላመ ባናዉ በሴስ። ያን ደርያ ጭማታን፥ ካህነ ሀላቃታነ ህገ አስታማረታ ኩሸን ዋየ ኤካናዉ በሴስ። ኤንቲ ታና ዎና፥ ሽን ታኒ ሄን ጋላስ ሀይቆፐ ደንዳና” ያግድ ቆንጭስስ።<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>ጰፅሮስ የሱሳ ጋፃ ከስድ፥ “ጎዳዉ፥ ሄስ ሀነና! ሄሳ መላባይ ነና ኡባራካ ጋኮፎ!” ያግድ ሀንቀትስ።<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>የሱሲ ጰፅሮሳኮ ጉየ ስሚድ፥ “ሀ ፃላህያዉ፥ ታፐ ሃካ! ኔኒ አሳ ቆፋ ቆፓሳፐ አትሽን፥ ፆሳ ቆፋ ቆፖና ግሾ ታዉ በ ግዳሳ” ያግስ።<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>ሄሳፈ ጉየ፥ የሱሲ ባ ታማረታኮ፥ “ኦንካ ታና ካላናዉ ኮያባ ግድኮ ባና ካዶ፥ ባ ማስቃልያ ቶክድ ታና ካሎ።<note caller="-" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ 10:38</ref>፤ <ref loc="LUK 14:27">ሉቃ 14:27</ref>.</char></note> <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>ባ ደኡዋ አሻናዉ ኮይያ ኡባይ ይሴስ። ሽን ባ ደኡዋ ታ ግሾ ግድ አድ እመይስ አሼስ።<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ 10:39</ref>፤ <ref loc="LUK 17:33">ሉቃ 17:33</ref>፤ <ref loc="JHN 12:25">ዮሀ 12:25</ref>.</char></note> <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>አስ አላመ ኩመ ባዉ ኦድ፥ ግዶሽን ባ ሸምፑዋ ይስኮ እያ አይ ማዲ? ዎይኮ አስ ባ ሸምፑዋ ላመ አይ እማናዉ ዳንዳኢ? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>አሳ ናአይ ባ አዋ ቦንቹዋን ባ ኪታንቾታራ ያና። ሄ ዎደ እስ እስ ኡራስ እያ ኦሱዋዳ እማና።<note caller="-" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ 25:31</ref>፤ <ref loc="PSA 62:12">ማዝ 62:12</ref>፤ <ref loc="ROM 2:6">ሮመ 2:6</ref>.</char></note> <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>ታ ቱማ ኦዳይስ፤ ሀይሳን ኤቅዳ አሳታፐ አሳ ናአይ ካዎ ግድድ ስመይሳ በአና ጋካናዉ ሀይቆናይሳት ሀይሳን ደኦሶና” ያግስ።<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">የሱሳ ማላይ ላመትስ</para>
  <para style="r">(<ref loc="MRK 9:2-13">ማር 9:2-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>ኡሱፑን ጋላሳፐ ጉየ የሱሲ፥ ጰፅሮሳ፥ ያይቆባነ እያ እሻ ዮሃንሳ ባራ ኤክድ ባንታርካ ግዳናዉ ዙማ ቦላ ከይስ።<note caller="-" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጰፅ 1:17-18</ref>.</char></note> <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>ያን ኤንታ ስንን የሱሳ ማላይ ኩመ ላመትስ፤ እያ ሶምኦይካ አዋዳ ፆልቅስ። እያ ማኦይካ ዳሮ ቦፅስ። <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>ሄኮ፥ ሙሰይነ ኤልያስ እያራ ኦደትሽን በእዶሶና። <verse eid="MAT 17:3"/><verse number="4" style="v" sid="MAT 17:4"/>ጰፅሮስ የሱሳኮ፥ “ኑኒ ሀይሳ ሀሹ ይዳ። ነ ኮይኮ እስኖ ነዉ፥ እስኖ ሙሰስ፥ እስኖ ኤልያሳስ ሀይሳን ሄ ሻቃራ ሻቃራና” ያግስ። <verse eid="MAT 17:4"/><verse number="5" style="v" sid="MAT 17:5"/>ጰፅሮስ ሄሳ ቡሮ ኦድሽን ቦ ሻራይ ኤንታና ካምስ። ሻራ ግዶራ፥ “ታና ኡፋይስያ፥ ታ ዶስያ ናአይ ሀይሳ፥ እያ ስእተ!” ግያ ቃላይ ይስ።<note caller="-" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">መ 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ 2:7</ref>፤ <ref loc="ISA 42:1">እሳ 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ 3:17</ref>፤ <ref loc="MAT 12:18">12:18</ref>፤ <ref loc="MRK 1:11">ማር 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃ 3:22</ref>፤ <ref loc="DEU 18:15">ዛረ 18:15</ref>.</char></note> <verse eid="MAT 17:5"/><verse number="6" style="v" sid="MAT 17:6"/>የሱሳ ታማረት ሄሳ ስእዳ ዎደ ዳጋምድ ባንታ ሶምኡዋራ ሳአን ኩንድዶሶና። <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>ሽን የሱሲ ኤንታኮ ሺቅድ ኤንታ ቦችድ፥ “ደንድተ፥ ያዮፍተ!” ያግስ። <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>ኤንቲ ቁ ግድ በእያ ዎደ የሱሳፐ ሀራ ኦናካ በእቦኮና።<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>ኤንቲ ዙማ ቦላፈ ዎሽን የሱሲ ኤንታኮ፥ “አሳ ናአይ ሀይቆፐ ደንዳና ጋካናዉ ሀ ህንተ በእዳባ ኦደስካ ኦዶፕተ” ግድ ኪትስ። <verse eid="MAT 17:9"/><verse number="10" style="v" sid="MAT 17:10"/>የሱሳ ታማረት፥ “ያትን፥ ህገ አስታማረት ኤልያስ ክርስቶሳፐ ካሰትድ ያና ግዳይ አይብሴ?” ያግድ ኦይችዶሶና።<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ምልክ 4:5</ref>.</char></note><verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>የሱሲ ዛሪድ፥ “ኤ! ኤልያስ ካሰት ይድ ኡባባ ጊግሳና። <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>ሽን ታ ህንተዉ ቱማ ኦዳይስ፤ ኤልያስ ካሰትድ ይስ። ኤንትካ እያ ቦላ ኮይዳባ ኦዶሶናፐ አትሽን፥ እያ ሻክ ኤርቦኮና። ሄሳዳ አሳ ናአይ ኤንታ ኩሸን ዋየታና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">ማቶ 11:14</ref>.</char></note><verse eid="MAT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13"/>ሄ ዎደ የሱሲ ግዳይ ፃማቅያ ዮሃንሳባ ግደይሳ አኬክዶሶና።<verse eid="MAT 17:13"/></para>
  <para style="s1">ቱና አያን ኦይክዳ ናአ</para>
  <para style="r">(<ref loc="MRK 9:14-29">ማር 9:14-29</ref>፤ <ref loc="LUK 9:37-43">ሉቃ 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>ኤንቲ ደርያፐ አሳኮ ስምያ ዎደ እስ አስ የሱሳ ስንን ጉልባትድ፥ <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>“ጎዳዉ፥ ሀያና ታ ናኣስ ቃታርክ፤ እያ ሾጭድ የግያ ሀርገይ ዳሮ ኡንኤድ ታማንነ ሃን የጌስ። <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>ነ ታማረታኮ ኤሀስ፥ ሽን ኤንቲ ፓናዉ ዳንዳእቦኮና” ያግስ።<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>የሱሲ ዛሪድ፥ “ህንተኖ፥ አማኖና ጌላ የለተዉ አዉደ ጋካናዉ ታ ህንተራ ዳኔ? አዉደ ጋካናዉ ታ ህንተና ዳንዳአኔ? አነ ናኣ ሃ ኤክ ዪተ” ያግስ። <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>የሱሲ ቱና አያና ሀንቅን፥ ቱና አያናይ ናኣፐ ከይስ፤ ሄ ሳተንካ ናአይ ፓፅስ። <verse eid="MAT 17:18"/><verse number="19" style="v" sid="MAT 17:19"/>ሄሳፈ ጉየ፥ የሱሳ ታማረት ባንታርካ እያኮ ሺቅድ፥ “ኑኒ ቱና አያና ከሳናዉ ዳንዳእቦናይ አይብሴ?” ያግድ ኦይችዶሶና። <verse eid="MAT 17:19"/><verse number="20" style="v" sid="MAT 17:20"/>እ ኤንታኮ፥ “ህንተዉ አማኖይ ላፍዳ ግሾሳ። ታ ህንተዉ ቱማ ኦዳይስ፤ ጋሸ አይፈ መላ አማኖይ ህንተዉ ደእኮ ‘ሀ ዙማ ሀይሳፈ ደንዳዳ ገደ አ’ ጊኮ ህንተዉ ኪተታና። ህንተዉ ዳንዳኤቶናባይ ዴና። <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>[ሽን ሄሳ መላይ ዎሳፐነ ፆማፐ አትሽን፥ ሀራን ከየና”] ያግስ።<note caller="-" style="x"><char style="xo" closed="false">17:21 </char><char style="xt" closed="false"><ref loc="MAT 21:21">ማቶ 21:21</ref>፤ <ref loc="MRK 11:23">ማር 11:23</ref>፤ <ref loc="2CO 13:2">2 ቆሮ 13:2</ref>.</char></note><note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">እስ እስ በን ማፃፋታን ፓይዶ 21 ዴና።</char></note><verse eid="MAT 17:21"/></para>
  <para style="s1">የሱሲ ባ ሀይቁዋባ ዛሪድ ኦድስ</para>
  <para style="r">(<ref loc="MRK 9:30-32">ማር 9:30-32</ref>፤ <ref loc="LUK 9:43-45">ሉቃ 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>የሱሳ ታማረት ጋልላን ሺቅድ ደእሽን የሱሲ ኤንታኮ፥ “አሳ ናእ አሳ ኩሸን አድ እመታና። <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>ኤንቲ እያ ዎና፥ ሽን እ ሄን ጋላስ ሀይቆፐ ደንዳና” ያግስ።</para>
  <para style="p" vid="MAT 17:23">እያ ታማረትካ ዳሮ ቂሮትዶሶና።<verse eid="MAT 17:23"/></para>
  <para style="s1">ፆሳ ኬ ጊራ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>የሱሳራነ እያ ታማረታራ ቅፍርናሆማ ካታማ ጋክዳ ዎደ ፆሳ ኬ ጊራ ቃንፅሰይሳት ጰፅሮሳኮ ይድ፥ “ህንተ አስታማረይ ፆሳ ኬ ጊራ ጊሪ?” ያግድ ኦይችዶሶና።<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">ከሳ 30:13</ref>.</char></note><verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>ጰፅሮስ ዛሪድ፥ “ጊሬስ” ያግስ። ጰፅሮስ ሶ ገልያ ዎደ የሱሲ ካሰትድ፥ “ጰፅሮሳ፥ ነዉ አይ ዳኒ? ሀ ሳኣ ካዎተት ቃራፃነ ጊራ ኦፐ ኤኮና? ጋደ አሳፐየ ዎይኮ አሳ ጋደ አሳፔ?”<note caller="+" style="f"><char style="fr" closed="false">17:25 </char><char style="fk" closed="false">ጋደ አሳፐየ ዎይኮ አሳ ጋደ አሳፔ </char><char style="ft" closed="false">ሄ ዎደ ካዎተት ባንታ ጋደ አሳፐ ጊራ ኤኮኮና።</char></note> ያግድ ኦይችስ።<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>ጰፅሮስ “አሳ ጋደ አሳፐ” ግድ ዛርስ።</para>
  <para style="p" vid="MAT 17:26">የሱሲ ዛሪድ፥ “ጋደ አሳይ ጊራ ጊሮኮና ጉሱ። <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>ሽን ኤንቲ በቶና መላ አባ ባዳ ሞሎ ኦይካናዉ ማንፃቆ የጋ። ኮይሮ ነ ኦይክያ ሞሉዋ ዶና ዶያዳ ጊራስ ግድያ ሚሸ ነ ግሾነ ታ ግሾ ኤፋዳ ጊራ” ያግስ።<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">ኡባፈ አይ ኦኔ?</para>
  <para style="r">(<ref loc="MRK 9:33-37">ማር 9:33-37</ref>፤ <ref loc="LUK 9:46-48">ሉቃ 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>ሄ ዎደ የሱሳ ታማረት ይድ፥ “ሳሎ ካዎተን ኡባፈ አይ ኦኔ?” ያግድ ኦይችዶሶና።<note caller="-" style="x"><char style="xo" closed="false">18:1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ 22:24</ref>.</char></note> <verse eid="MAT 18:1"/><verse number="2" style="v" sid="MAT 18:2"/>የሱሲ እስ ጉ ናአ ፄግድ ኤንታ ግዶን ኤስድ ሀይሳዳ ያግስ። <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>“ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተ ላመቶናነ ጉ ናይታዳ ሀኖና እፅኮ ሳሎ ካዎተ ኡባራካ ገላናዉ ዳንዳኤከታ።<note caller="-" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">ማር 10:15</ref>፤ <ref loc="LUK 18:17">ሉቃ 18:17</ref>.</char></note> <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>ህዛ፥ ሀ ጉ ናአዳ ባና ካዉሽያ ኦንካ ሳሎ ካዎተን ኡባፈ አይሳ ግዳና። <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>ሀይሳ መላ ናአ ታ ሱንን ሞክያ ኦንካ ታና ሞኬስ።<verse eid="MAT 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>“ሽን ታናን አማንያ ሀ ጉታፐ እሱዋ ናጋራ ኦና መላ በ ግድያ ኦንካ ግታ ጋቻ ዎፃ ባ ቆን ቃችድ ጪሞ አባን ምተትኮ እያዉ ሎኦ። <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/>አላመን አሳይ ናጋራ ኦና መላ ኦያባት ደእያ ግሾ አላምያ አየ! ሄሳ መላባት ዮና አተና፥ ሽን በይ እያ ጋሶን ያ ኡራ አየ!<verse eid="MAT 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8"/>“ነ ኩሸይ ዎይኮ ነ ቶሆይ ነና ባለኮ ኔፐ ቃንፃ የጋ። ኔኒ ናምኡ ኩሸራ ዎይኮ ናምኡ ቶሆራ መርና ታማን የገታናፐ ኩሸ ዎይኮ ቶሆ ዱፃ ግዳዳ መርና ደኦ ደመይስ ነዉ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቶ 5:30</ref>.</char></note> <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>ቃስ ነ አይፈይ ነና ባለኮ እዮ ዎጫ ከሳዳ ዎራ ሆላ። ኔኒ ናምኡ አይፈራ ጋናመ ታማን የገተይሳፈ እስ አይፈራ መርና ደኡዋ ገለይስ ነዉ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቶ 5:29</ref>.</char></note><verse eid="MAT 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>“ታ ህንተዉ ኦዳይስ፤ ሳሎን ደእያ ኤንታ ናግያ ኪታንቾት ኡባ ዎደ ሳሎን ደእያ ታ አዋ ስንን ደእያ ግሾ፥ ህንተ ሀ ጉታፐ እሱዋካ ካና መላ ናገትተ።<note caller="-" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="LUK 19:10">ሉቃ 19:10</ref>.</char></note> <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>አሳ ናአይ ይዳይሳታ አሻናዉ ይስ”<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="fq" closed="false">አሳ ናአይ ይዳይሳታ አሻናዉ ይስ፦ </char><char style="ft" closed="false">እስ እስ በን ማፃፋት ፓይዶ 11 ጉጆሶና።</char></note> ያግስ።<verse eid="MAT 18:11"/></para>
  <para style="s1">ይዳ ዶርሳ ሌምሶ</para>
  <para style="r">(<ref loc="LUK 15:3-7">ሉቃ 15:3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>ቃስ የሱሲ፥ “ህንተዉ አይ ዳኒ? እስ ኡራስ ፄቱ ዶርሳት ደኤይሳታፐ እሶይ ይኮ ኡዱፉን ታማነ ኡዱፉናታ ደርያ ቦላ የግ አግድ ሄ ይዳይሳ ኮያናዉ ቤኔ? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>ታ ቱማ ኦዳይስ፤ እ ደምዳ ዎደ ኡዱፉን ታማነ ኡዱፉናታፐ አድ ይድ በንትዳ እስ ዶርሳ ግሾ ኡፋይቴስ። <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>ሄሳዳካ፥ ሳሎን ደእያ ህንተ አዋይ ሀ ጉታፐ እሶይ ያና መላ ኮየና።<verse eid="MAT 18:14"/></para>
  <para style="s1">ቆህዳ አስ ዋታኔ?</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>“ነ እሻይ ነና ቆህኮ ነርካ እያኮ ባዳ እያ ቆሁዋ እያዉ ኦዳ። እ ነና ስእኮ እያ ነዉ እሻ ኦ።<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">ሉቃ 17:3</ref>.</char></note> <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>ሽን እ ነና ስኦና እፅኮ፥ ናምኡ ዎይኮ ሄ አሳ ማርካን ሞቶይ ላሰትያ ግሾ፥ እስ ዎይኮ ናምኡ አስ ኤካዳ እያኮ ባ።<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">ዛረ 19:15</ref>.</char></note> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>እ ኤንታና ስኦና እፅኮ፥ ዎሳ ኬስ ኦዳ። ዎሳ ኬ ግያባ ስኦና እፅኮ አማኖና አሳዳ ዎይኮ ቃራፃ ቃንፅስያ አሳዳ እያ ፓይዳ።<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>“ታ ህንተዉ ቱማ ኦዳይስ፤ ሳአን ህንተ ድግያባት ኡባይ ሳሎን ፆሳ ማታን ድገትዳባ ግዳና። ሳአን ህንተ ሀኖ ግያባት ኡባይ ሳሎን ፆሳ ማታን ሀንዳባ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">ማቶ 16:19</ref>፤ <ref loc="JHN 20:23">ዮሀ 20:23</ref>.</char></note><verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>“ቃስካ ታ ህንተዉ ኦዳይስ፤ ሳአን ህንተፈ ናምአይ ባንታ ዎስያባስ እስ ዎዛናን ግድድ ፆሳ ዎስያባ ግድኮ ሳሎን ደእያ ታ አዋይ ህንተዉ ኦና። <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>ታና ካለይሳታፐ ናምአ ዎይኮ ሄ ግድድ ሺቅያ በሳን ታኒ ኤንታ ግዶን በንታና” ያግስ።<verse eid="MAT 18:20"/></para>
  <para style="s1">አቶ ጉሳባ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>ሄ ዎደ ጰፅሮስ የሱሳኮ ይድ፥ “ጎዳዉ፥ ታ እሻይ ታና ቆህኮ አፑን ቶሆ ታኒ አቶ ጋናዉ በሲ? ላፑን ቶሆ ጋካናሰዬ?” ግድ ኦይችስ።<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">ሉቃ 17:3-4</ref>.</char></note><verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>የሱሲ ዛሪድ፥ “ግደና፥ ላፑን ታሙ ቶሆ ላፑናፐ አትሽን፥ ላፑን ቶሆ ግደና።<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="GEN 4:24">መ 4:24</ref>.</char></note><verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>“ሄሳ ግሾ፥ ፆሳ ካዎተይ ባ ኦሳንቾታራ ባ ሚሸይ ፓጭዳኮነ ፓላህዳኮ በአናዉ ቆፕዳ ካዋ ዳኔስ። <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>ሄ ካዎይ ሚሸይ ፓጭዳኮነ ፓላህዳኮ በእያ ዎደ ዳሮ ግንድግንዳ አጮይ ደእያ እስ ኡራ እያኮ ኤህዶሶና። <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>ሽን ሄ አይለይ አጩዋ ቃንፃናዉ ፆነትን እያራ፥ እያ ማቸራ፥ እያ ናይትነ እያዉ ደእያባይ ኡባይ ባይዘትድ አጮይ ጭገታና መላ እያ ጎዳይ ኪትስ። <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/>ያትን አይለይ ባ ጎዳ ቶሁዋ ቦላ ጉልባትድ፥ ‘ታ ጎዳዉ፥ ሀያና ጉ ዎደ ታካርክ፥ ታ አጩዋ ኡባ ታ ጭጋና’ ያግድ ዎስስ። <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>ካዎይ እያዉ ቃትድ፥ የድ አግስ፤ እያ አጩዋ ማርስ።<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>“ሽን ሄ አይለይ ከይ ብድ ባ ላገ ኦሳንቾታፐ እሶይ ባፐ ዳሮ ጉ ሚሸ ታልእዳይሳ፥ ‘ነ ቦላ ደእያ ታ ሚሽያ ታዉ ጭጋ’ ግድ ቆ ኦይክስ።<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>“ሄ እያ ላገ አይሌይ እያ ስንን ጉልባትድ፥ ‘ሀያና ጉ ዎደ ታካርክ ታኒ ታ አጩዋ ኡባ ጭጋና’ ያግድ ዎስስ።<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>“ሽን እፅድ ኤክ ኤፍድ ባ ላገይ አጩዋ ቃንፃና ጋካናዉ ቃሾ ኬ ገልስስ። <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>ሄሳ ግሾ፥ ሀራ ላገ ኦሳንቾት ሄሳ በእዳ ዎደ ዳሮ ይሎትድ፥ ብድ ባንታ ጎዳስ እ ኦዳባ ኡባ ኦድዶሶና።<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>“ያትን ካዎይ ሄ አይልያ ፄግስድ፥ ‘ሀ ኢታ አይልያዉ፥ ኔኒ ታና ዎስዳ ግሾ፥ ታ ነ አጩዋ ኡባ ነዉ ማራስ። <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>ያትን፥ ታኒ ነ አጩዋ ማርዳይሳዳ ኔኒ ነ ላገ አይልያ አጩዋ ማራናዉ ነዉ በሰኔ?’ ያግስ። <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>ሄሳ ግሾ፥ ካዎይ ዳሮ ይሎትድ፥ እ ባ አጩዋ ኡባ ጭጋና ጋካናዉ ፓፃ ካኤታና መላ ቃሾ ኬን የግስ።<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>“ሄሳዳካ፥ ህንተ እሶይ እሶይ ህንተ እሻ ዎዛናፐ ማሮና እፅኮ ሳሎን ደእያ ታ አዋይ ህንተና ሄሳዳ ኦና” ያግስ።<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">ኤኮ ገሎባ</para>
  <para style="r">(<ref loc="MRK 10:1-12">ማር 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>የሱሲ ሄሳ ኦድ ኦንግዳፐ ጉየ፥ ጋልላፐ ደንድድ ዮርዳኖሰ ሻፋፐ ሄፍንን ደእያ ይሁዳ ቢታ ብስ። <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>ዳሮ አሳይ እያ ካልድ ብን ኤንታ ግዶፈ ሀርጋንቾታ ፓስ።<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>ፋርሳወት እያ ፓጫናዉ ኮይድ እያኮ ይድ፥ “እስ አስ አይ ጋሶንካ ባ ማችዉ የዳናዉ በሲ?” ያግድ ኦይችዶሶና።<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>የሱሲ ዛሪድ፥ “ፆሳይ ኮይሮ አደነ ማጫስ ኦ መዳይሳ ህንተ ናባብበከቲ?<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">መ 1:27</ref>፤ <ref loc="GEN 5:1">5:1</ref>.</char></note> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>‘ሄሳ ግሾ፥ እስ አስ ባ አዋነ ባ አይዉ አግድ ባ ማቸራ እስኖ ግዴስ፥ ናምአይካ እስ አሾ ግዶሶና።’<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መ 2:24</ref>.</char></note> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>ሄሳ ግሾ፥ ኤንቲ እስ አስ ግዶሶናፐ አትሽን፥ ናምኡ አስ ግዶኮና። ህዛ፥ ፆሲ ቃችዳይሳ አስ ሻኮፎ” ያግስ።<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>ፋርሳወት፥ “ያትን፥ ሙሰይ እስ አስ አንጆ ዎርቃተ እምድ የዳና መላ አይስ ኪትዴ?” ያግድ ኦይችዶሶና።<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="GEN 24:1">መ 24:1</ref>.</char></note><verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>የሱሲ ዛሪድ፥ “ህንተ፥ ህንተ ማቸታ የዳና መላ ሙሰይ ህንተና ኪትዳይ፥ ህንተ ዎዛና ምኖተ ግሾፐ አትሽን፥ ኮይሮፐ ሄሳ መላ ግደና። <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>ታ ህንተዉ ኦዳይስ፤ ባ ማችያ ላይማቶና ደእሽን የድድ ሀራ ኤክያ ኦንካ ላሜስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ 5:32</ref>፤ <ref loc="2CO 7:10">2 ቆሮ 7:10</ref>.</char></note><verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>እያ ታማረት እያኮ፥ “አዝናባይነ ማችባይ ሄሳ መላ ግድኮ ኤኮ ገሎይ አትኮ ሎኦ” ያግዶሶና።<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>የሱሲ ዛሪድ፥ “ሄሳ መላ ትምርተይ ፆሳይ ዳንዳአ እምዳይሳታሳፈ አትሽን፥ አሳ ኡባሳ ግደና። <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>ህዛ፥ የለትሸ ሹፋ ግድድ የለትዳይሳት ደኦሶና፥ ቃስ አስ ቃራትዳይሳት ደኦሶና፥ ቃስ ሳሎ ካዎተ ግሾ ግድ ባንታና ሹፋይዳይሳት ደኦሶና። ሄሳ ግሾ፥ ሀይሳ ኤካናዉ ዳንዳእያ ኦንካ ኤኮ” ያግስ።<verse eid="MAT 19:12"/></para>
  <para style="s1">የሱሲ ዮጋ ናይታ አንጅስ</para>
  <para style="r">(<ref loc="MRK 10:13-16">ማር 10:13-16</ref>፤ <ref loc="LUK 18:15-17">ሉቃ 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>የሱሲ ባ ኩሽያ ጉ ናይታ ቦላ ዎድ ኤንታዉ ዎሳና መላ እስ እስ አሳይ ናይታ እያኮ ኤህዶሶና። ሽን እያ ታማረት አሳ ሀንቀትዶሶና። <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>ሽን የሱሲ፥ “ፆሳ ካዎተይ ሀይሳታ መላሳ ግድያ ግሾ፥ ጉ ናይት ታኮ የይሳ ድጎፍተ፤ ዮ ጊተ” ያግስ።<verse eid="MAT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15"/>ባ ኩሽያ ኤንታ ቦላ ዎዳፐ ጉየ ሄ በሳፈ አግድ ብስ።<verse eid="MAT 19:15"/></para>
  <para style="s1">ዱረ ናአተ ኡራ</para>
  <para style="r">(<ref loc="MRK 10:17-31">ማር 10:17-31</ref>፤ <ref loc="LUK 18:18-30">ሉቃ 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>እስ ጋላስ እስ ኡራይ የሱሳኮ ይድ፥ “አስታማርያዉ፥ ታኒ መርና ደኦ ደማናዉ አይ ሎኦባ ኦ?” ያግስ። <verse eid="MAT 19:16"/><verse number="17" style="v" sid="MAT 19:17"/>የሱሲ እያኮ፥ “ሎኦባ ነ ታና አይስ ኦይቻይ? እስ ፆሳፈ አትሽን፥ ሀር ሎኦይ ባዋ። ሽን ኔኒ መርና ደኡዋ ኤካናዉ ኮይኮ ኪታታ ናጋ” ያግስ።<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>ኡራይ ዛሪድ፥ “አዉሳ ኪታታ” ያግድ ኦይችስ።</para>
  <para style="p" vid="MAT 19:18">የሱሲ ዛሪድ፥ “ዎፓ፥ ላይማቶፓ፥ ካይሶቶፓ፥ ዎርዶ ማርካቶፋ፥<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">ከሳ 20:13-16</ref>፤ <ref loc="DEU 5:17-20">ዛረ 5:17-20</ref>.</char></note> <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>ነ አዋነ ነ አይዉ ቦንቻ፥ ነ ሾሩዋ ነ ሁጰዳ ዶሳ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከሳ 20:12</ref>፤ <ref loc="DEU 5:16">ዛረ 5:16</ref>፤ <ref loc="LEV 19:18">ሌወ 19:18</ref>.</char></note><verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>ሄ ናአተይ፥ “ታኒ ሀይሳታ ኡባ ናአተፈ ዶማዳ ናጋስ። ያትን፥ ሀር ታዉ ፓጭያባይ አይቤ?” ያግድ ኦይችስ።<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>የሱሲ ዛሪድ፥ “ኔኒ ፖሎ ግዳናዉ ኮይኮ ባዳ ነዉ ደእያባ ባይዛዳ ማንቆታስ እማ፤ ኔኒ ሳሎን ዱረታና። ያታ ስማ ያዳ ታና ካላ” ያግስ።<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>ሽን ሄ ናአተ ኡራይ ዳሮ ዱረ ግድያ ግሾ፥ ሄሳ ስእዳ ዎደ አዛንሸ አግድ ብስ። <verse eid="MAT 19:22"/><verse number="23" style="v" sid="MAT 19:23"/>ሄሳፈ ጉየ፥ የሱሲ ባ ታማረታ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ዱረይ ሳሎ ካዎተ ገላናይስ ዳሮ መቶ። <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>ዱረ አስ ፆሳ ካዎተ ገላናይሳፈ ግማለይ ናርፐ ሉሆራ አይስ ካዉዬስ” ያግስ።<figure style="fig" alt="Man leading unloaded camel" file="LB00039B.tif" size="span" ref="19:24">ግማለ ጎችያ አስ</figure><verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>የሱሳ ታማረት ሄሳ ስእድ ማላለትድ፥ “ያትን፥ ኦን አታናዉ ዳንዳኢ?” ያግድ ኦይችዶሶና።<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>የሱሲ ኤንታ ጫድ ፄልድ፥ “ሀይስ አሳስ ዳንዳኤተና፥ ሽን ፆሳስ ኡባይ ዳንዳኤቴስ” ያግስ።<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>ጰፅሮስ ዛሪድ፥ “ኑኒ ኡባባ አግድ ነና ካልዳ። ያትን፥ ኑኒ አይ ደማኔ?” ያግስ። <verse eid="MAT 19:27"/><verse number="28" style="v" sid="MAT 19:28"/>የሱሲ ኤንታኮ ሀይሳዳ ያግስ፦ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ አሳ ናአይ ያና አላምያን ባ ቦንቾ አራታን ኡትያ ዎደ ህንተ ታማነ ናምአት፥ ታና ካልዳይሳት፥ ታማነ ናምኡ አራታን ኡትድ ታማነ ናምኡ እስራኤለ ዘረታ ቦላ ፕርዳና።<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ 25:31</ref>፤ <ref loc="LUK 22:30">ሉቃ 22:30</ref>.</char></note> <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>ታ ሱን ግሾ ኬ ዎይኮ እሻታ ዎይኮ ምቸታ ዎይኮ አዋ ዎይኮ አይዉ ዎይኮ ናይታ ዎይኮ ጋዴ አግዳይ ኦንካ ፄቱ ኩሸ ኤካና። ቃስ መርና ደኡዋካ ኤካና። <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>ሽን ዳሮት ሀእ ደን ስን ግድዳይሳት ጉየ ግዳና፥ ቃስ ጉየ ግድዳይሳት ስን ግዳና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">ማቶ 20:16</ref>፤ <ref loc="LUK 13:30">ሉቃ 13:30</ref>.</char></note><verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">ኡነ ኦያ አሳ ሌምሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>“ፆሳ ካዎተይ ባ ዎይነ ጋደን ኡነ ኦያ አስ ኦስሳናዉ ዎንታ ጉራ ከይዳ ኡራ ዳኔስ። <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>እ ሄ ኡነ ኦያ አሳ ሀች ሀች እስ ድናረ<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="fq" closed="false">እስ ድናረ፦ </char><char style="ft" closed="false">እስ አስ እስ ጋላስ ኦ ፔእድ ኤክያ ሚሸ።</char></note> ቃንፃናዉ ኤንታራ ጊግድ፥ ኤንታ ባ ዎይነ ጋድያ ግዶ የድስ።<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>“ቃስ ዎንታፈ ሄ ሳተ ግድሽን ከይድ ኦሶ ይድ ግያ ቦላ ኤቅዳ ሀራ አሳታ ደምስ። <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>እ ኤንታኮ፥ ‘ህንተካ ታ ዎይነ ጋዴ ግዶ ብድ ኦተ፥ ታኒ ህንተዉ በሲያ ጋትያ ቃንፃና’ ያግስ። <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>ኤንትካ ብዶሶና። ቃስካ እ ኡሱፑን ሳተንነ ኡዱፉን ሳተን ከይድ ሄሳዳ ኦስ። <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>ታማነ እስ ሳተ ግድሽን እ ከይያ ዎደ ሀራት ያን ኤቅዳይሳታ ደምድ፥ ‘ህንተ ኦሶ ኦና ጋላስ ኩመ ሀይሳን አይስ ኤቅድ ፔእደቲ?’ ያግስ።<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>“ኤንቲ ዛሪድ፥ ‘ኑና ኡነ ኦስስያ አስ ይዳ ግሾሳ’ ያግዶሶና።</para>
  <para style="p" vid="MAT 20:7">“እካ፥ ‘ህንተካ ታ ዎይነ ጋድያ ግዶ ብድ ኦተ’ ያግስ።<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>“ሳእ ኦማርስን፥ ዎይነ ጋድያ ጎዳይ ኦሳንቾታ ሀላቃኮ፥ ‘ኦሳንቾታ ፄጋዳ ዉርሰን ኦሶ ገልዳይሳታፐ ዶማዳ ኮይሮ ገልዳይሳታ ጋካናዉ ኤንታ ጋትያ ቃንፃ’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">ሌወ 19:13</ref>፤ <ref loc="DEU 24:15">ዛረ 24:15</ref>.</char></note> <verse eid="MAT 20:8"/><verse number="9" style="v" sid="MAT 20:9"/>ታማነ እስ ሳተን ኦሶ ኦይክዳይሳት ይድ፥ ሁጰን ሁጰን እስ እስ ድናረ ኤክዶሶና። <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>ኮይሮ ኦሶ ኦይክዳይሳት ይድ፥ ባንታዉ ዳሮ እመታና ግድ ቆፕዶሶና። ሽን ኤንትካ ሁጰን ሁጰን እስ እስ ድናረ ኤክዶሶና። <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>ባንታ ሚሽያ ኤክ ስሚድ ጎዳ ቦላ ዙዙምዶሶና። <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>‘ሀይሳቲ ጉየፐ ይድ እስ ሳተ ፃላላ ኦዶሶና። ሽን ጋላስ ኩመ አዋ ሱላን ዳቡርድ ፔእዳ ኑራ ኤንቲ ዋንድ እስኖ ግዶና’ ያግዶሶና።<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>“ዎይንያ ጎዳይ ኦሳንቾታፐ እሱዋኮ፥ ‘ታ እሻዉ፥ ታኒ ነና ቆሀብከ፤ ነ ታራ ጊግዳይ እስ ድናረሳ ግደኔ? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>ነ ሚሽያ ኤካዳ ነ ሶ ባ። ታ ኦማርስ ይዳይሳስካ ነይሳ መላ እማናዉ ኮያይስ። <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>ታኒ ታ ሚሽያን ኮይዳባ ኦናዉ ታዉ ማት ባዌ? ዎይኮ ታኒ ኬሀ ግድዳ ግሾ ኔኒ ቃናታይ?’ ያግስ።<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>“ሄሳዳ ሀእ ደን ጉየ ግድዳይሳት ስንታና፥ ስንትዳይሳት ቃስ ጉየታና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶ 19:30</ref>፤ <ref loc="MRK 10:31">ማር 10:31</ref>፤ <ref loc="LUK 13:30">ሉቃ 13:30</ref>.</char></note><verse eid="MAT 20:16"/></para>
  <para style="s1">የሱሲ ባ ሀይቁዋባ ሄን ኦድስ</para>
  <para style="r">(<ref loc="MRK 10:32-34">ማር 10:32-34</ref>፤ <ref loc="LUK 18:31-34">ሉቃ 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>የሱሲ የሩሳላመ ብሸ፥ ታማነ ናምኡ ታማረታ ዱማ ጋፃ ከስድ ኤንታኮ ያግስ፦ <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>“ሄኮ፥ ኑኒ ሀእ የሩሳላመ ቡሳ ቦላ ደኦስ። ያን አሳ ናአይ ካህነ ሀላቃታስነ ህገ አስታማረታስ አድ እመታና። ኤንቲ እያ ቦላ ሀይቆ ፕርዳ ፕርዳና። <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>እያ አይሁደ ግዶና ደርያስ አድ እማና። ኤንቲ እያ ካዉሻና፥ ጋራፋና፥ ያትድ እያ ማስቃልያ ቦላ ካቃና። ሽን እ ሄን ጋላስ ሀይቆፐ ደንዳና” ያግስ።<verse eid="MAT 20:19"/></para>
  <para style="s1">ዛብድዮሳ ናይታ አየ ዎሳ</para>
  <para style="r">(<ref loc="MRK 10:35-45">ማር 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>ሄ ዎደ ዛብድዮሳ ማችያ ባ ናምኡ አደ ናይታራ የሱሳኮ ያዳ፥ እያ ስንን ጉልባታዳ እስባ እያ ዎሳሱ።<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>የሱሲ ኢኮ፥ “ነ አይ ኮያይ?” ያግስ።</para>
  <para style="p" vid="MAT 20:21">እያ ዛራዳ፥ “ነ ካዎተን ሀ ታ ናምኡ ናይት እሶይ ነ ኡሻቻን እሶይ ነ ሀድርሳን ኡቶ ጋርክ!” ያጋሱ።<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>ሽን የሱሲ ናይታኮ ዛሪድ፥ “ህንተ አይ ዎስያኮ ኤረከታ፤ ታኒ ኡያናዉ ደእያ ዋየ ፁኣ ኡያናዉ ዳንዳኤቲ?” ያግስ።</para>
  <para style="p" vid="MAT 20:22">ኤንትካ፥ “ኤ ዳንዳኦስ” ያግዶሶና።<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>የሱሲ፥ “ቱማካ ታኒ ኡያናዉ ደእያ ፁአፐ ህንተ ኡያና። ሽን ታ ኡሻቻንነ ሀድርሳን ኡታናይሳታ ዶረይ ታና ግድከ። ሄ በሳይ እመተይ፥ ታ አዋይ እማናዉ ጊግስዳ አሳታሳ” ያግስ።<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>አትዳ ታሙ እያ ታማረት ሄሳ ስእዳ ዎደ ናምኡ እሻታ ቦላ ሀንቀትዶሶና። <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>ሽን የሱሲ ኤንታ ኡባ ፄግድ ሀይሳዳ ያግስ። “አይሁደ ግዶና አሳ ሃረይሳት ባንታ አሳ ቦላ ጎዳተይሳነ ኤንታ ካለይሳት ዎልቃን ሃረይሳ ህንተ ኤሬታ። <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>ሽን ህንተ ግዶን ሄሳዳ ግዶፖ። ህንተፈ ግታታናዉ ኮይያ ኦንካ ህንተዉ አይለ ግዶ።<note caller="-" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ 23:11</ref>፤ <ref loc="MRK 9:35">ማር 9:35</ref>፤ <ref loc="LUK 22:26">ሉቃ 22:26</ref>.</char></note> <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>ህንተ ግዶን ኡባፈ ቦላ ግዳናዉ ኮይያ ኦንካ ህንተዉ አይለ ግዳናዉ በሴስ። <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>ሄሳዳካ፥ አሳ ናአይ አሰ ሀጋዛናዉነ ዳሮ አሳ ዎዛናዉ ባ ሸምፑዋ እማናዉ ይስፐ አትሽን፥ አሳን ሀጋዘታናዉ ይቤና” ያግስ።<verse eid="MAT 20:28"/></para>
  <para style="s1">ናምኡ ቆቀት ፓፅዶሶና</para>
  <para style="r">(<ref loc="MRK 10:46-52">ማር 10:46-52</ref>፤ <ref loc="LUK 18:35-43">ሉቃ 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>ሄሳፈ ጉየ፥ የሱሲ ባ ታማረታራ እያርኮፈ ከይድ ብሽን፥ ዳሮ አሳይ ኤንታና ካልዶሶና። <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>ኦገ ጋፃን ኡትዳ ናምኡ ቆቀት የሱሲ ያራ አይሳ ስእድ፥ “ጎዳዉ፥ ዳዊታ ናአዉ፥ ኑስ ቃታርክ” ያግድ ዋስዶሶና። <verse eid="MAT 20:30"/><verse number="31" style="v" sid="MAT 20:31"/>ዳሮ አሳይ ኤንታና፥ “ሀይዝተ” ያግድ ካጭዶሶና። ሽን ኤንቲ፥ “ጎዳዉ፥ ዳዊታ ናአዉ፥ ኑስ ቃታርክ” ግድ ጉጅ ዋስዶሶና።<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>የሱሲ ኤቅድ፥ ኤንታ ፄግድ፥ “ታ ህንተዉ አይ ኦና መላ ኮዬቲ?” ያግድ ኦይችስ።<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>ኤንትካ፥ “ጎዳዉ፥ ኑ አይፈይ ፄላና መላ ኮዮስ” ያግዶሶና። <verse eid="MAT 20:33"/><verse number="34" style="v" sid="MAT 20:34"/>የሱሲ ኤንታዉ ቃትድ፥ ኤንታ አይፍያ ቦችስ። ኤለስድ ኤንታ አይፈይ ፄልስ፤ ኤንቲ እያ ካልድ ብዶሶና።<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">ግታ ቦንቾን የሩሳላመ ገሉዋ</para>
  <para style="r">(<ref loc="MRK 11:1-11">ማር 11:1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ 19:28-40</ref>፤ <ref loc="JHN 12:12-19">ዮሀ 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>የሱሳራነ እያ ታማረታራ የሩሳላመ ማትድ፥ ሻማሆ ዙማ ቦላ ደእያ ቤተፋገ ጌተትያ ጉታ ጋክሸ፥ የሱሲ ባ ታማረታፐ ናምአታ ባፐ ስን ያግድ ኪትስ፦ <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>“ህንተፈ ስንን ደእያ ጉታ ቢተ። ያን እስ ሀረይ ቃሾን ደእያሮ እ ማራራ ህንተ ደማና። ኤንታ ብልድ ሃ ኤክ ዪተ። <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>ኦንካ ህንተና ኦይችኮ፥ ‘ጎዳይ ኤንታና ኮዬስ’ ያግተ። እ ኤንታና ኢራካ የድ አጋና” ያግስ።<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>ሄስካ ናበይ፥<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>“ፅዮነ ካታማስ፥</para>
  <para style="q2" vid="MAT 21:5">‘ሄኮ፥ ነ ካዎይ አሽከ ግድድ፥ ሀረ ቦላነ</para>
  <para style="q2" vid="MAT 21:5">ሀረ ማራ ቦላ ኡትድ፥ ኔኮ ዬስ’ ያግተ”</para>
  <para style="m" vid="MAT 21:5">ያግድ ፃፍዳይስ ፖለታና መላ ሄስ ሀንስ።<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዛካ 9:9</ref>.</char></note><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>እያ ታማረት ብድ የሱሲ ኤንታ ኪትዳይሳዳ ኦዶሶና። <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>ሃሪውነ ሀረ ማራ ኤህድ ቦላራ ማእዳ ባንታ ማኡዋ ኤንታ ዞኮን የግዶሶና። የሱሲ ማኦታ ቦላ ኡትስ። <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>ዳሮ አሳይ ባንታ ማኡዋ ኦግያን ሂፅዶሶና። ሀራት ቦንጮ ታሽድ ኦገ ቦላ የግዶሶና። <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>የሱሳፐ ስንራ ሄመተይሳትነ እያፐ ጉየራ ካልያ ዳሮ አሳይ፥</para>
  <para style="q1" vid="MAT 21:9">“ሆሳና!<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="fk" closed="false">ሆሳና፦ </char><char style="ft" closed="false">እብራወ ዶናን ሆሳና ጉሳይ “ኑና አሻ” ጉሱ። ቃስ አሳይ ፆሳ ጋላታናዉ ጎኤትያ ቃላ።</char></note> ዳዊታ ናአይ ጋላተቶ!</para>
  <para style="q2" vid="MAT 21:9">ጎዳ ሱንን የይስ አንጀትዳይሳ!</para>
  <para style="q1" vid="MAT 21:9">ቦንቾይ ኡባፈ ቃ ሳሉዋን ፆሳስ ግዶ!”</para>
  <para style="m" vid="MAT 21:9">ያግድ ዋስዶሶና።<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">ማዝ 118:25</ref>.</char></note><verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>የሱሲ የሩሳላመ ካታማ ገልዳ ዎደ ሄ ካታማን ደእያ አሳ ኡባይ፥ “ሀይስ ኦኔ?” ያግድ ያርክዶሶና።<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>አሳይ፥ “ሀይስ ጋልላን ደእያ ናዝረተ ካታማፐ ይዳ ናብያ የሱሳ” ያግዶሶና።<verse eid="MAT 21:11"/></para>
  <para style="s1">ፆሳ ኬፈ ዛልኤይሳታ ከስስ</para>
  <para style="r">(<ref loc="MRK 11:15-19">ማር 11:15-19</ref>፤ <ref loc="LUK 19:45-48">ሉቃ 19:45-48</ref>፤ <ref loc="JHN 2:13-22">ዮሀ 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>የሱሲ ፆሳ ኬ ገልድ፥ ያን ባይዘይሳታነ ሻመይሳታ ኡባ ካረ ጎድስ። ሚሸ ላመይሳታ ፃርጴዛታነ ሆለታ ባይዝያ ኦይደታ ሽር የግስ። <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>እካ ኤንታኮ፥ “ፆሳ ቃላን፥ ‘ታ ኬይ ፆሳ ዎስያ ኬ ጌተታና’ ጌተትድ ፃፈትስ። ሽን ህንተ ፓንጋት ቆሰትያ ጎንጎሎ ኦደታ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">እሳ 56:7</ref>፤ <ref loc="JER 7:11">ኤርም 7:11</ref>.</char></note><verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>የሱሲ ፆሳ ኬን ደእሽን ቆቀትነ ጉንዳት እያኮ ይን ኤንታ ፓስ። <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>ሽን ካህነ ሀላቃትነ ህገ አስታማረት የሱሲ ኦዳ ማላልስያባታ በእዳይሳስነ ጉ ናይት ፆሳ ኬን፥ “ዳዊታ ናአይ፥ ጋላተቶ” ያግድ ዋሰይሳ ስእድ ሀንቀትዶሶና። <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>ኤንቲ የሱሳኮ፥ “ሀይሳቲ ገይሳ ነ ስአይ?” ያግዶሶና።</para>
  <para style="p" vid="MAT 21:16">የሱሲ፥ “ኤ ስአይስ፥ ፆሳ ቃላን፥ ‘ጉ ናይታ ዶናንነ ምያ ናይታ ዶናን ጋላታ ዎዳሳ’ ጌተትድ ፃፈትዳይሳ ህንተ ናባብበከቲ?” ያግስ። <verse eid="MAT 21:16"/><verse number="17" style="v" sid="MAT 21:17"/>ኤንታና ያን አግድ ብታነ ካታማ ብድ አቅስ።<verse eid="MAT 21:17"/></para>
  <para style="s1">የሱሲ ባድዳ ባላሰ ምዉ</para>
  <para style="r">(<ref loc="MRK 11:12-14">ማር 11:12-14</ref>፥ <ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>የሱሲ ዎንታ ጉራ ካታማ ስሚድ ይሸ ኮሻትስ። <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>ኦገ ጋፃን እስ ባላሰ ም በእድ ኢኮ ብስ። ሽን ሀይፈ አትሽን፥ ሀራ አይኮካ ደምቤና። ሄሳ ግሾ፥ እዮ፥ “ህዛፐ ናምአን አይፈ አይፎፓ!” ያግስ። ሄ ባላሰ ምያ ኤለሳዳ መላ አጋሱ።<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>እያ ታማረት ሄሳ በእድ፥ “ሀ ባላስያ ዋናዳ ኤለሳ መላዴ?” ያግድ ማላለትዶሶና።<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>የሱሲ ዛሪድ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተዉ አማኖይ ደእኮ፥ ቃስ ህንተ ስና እፅኮ ባላሰ ቦላ ታኒ ኦዳይሳ መላ ፃላላ ኦከታ፥ ሽን ‘ሀ ዙማ ሾደታዳ አባን ዎ’ ያግኮ ሀናና።<note caller="-" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ 17:20</ref>፤ <ref loc="2CO 13:2">2 ቆሮ 13:2</ref>.</char></note> <figure style="fig" alt="Fig tree" file="LB00085B.tif" size="col" ref="21:22">ባላስ ም</figure> <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>አማንድ ህንተ ዎስያባ አይብባ ግድኮካ ህንተ ኤካና” ያግስ።<verse eid="MAT 21:22"/></para>
  <para style="s1">የሱሳ ማታይ ኦይሸተ</para>
  <para style="r">(<ref loc="MRK 11:27-33">ማር 11:27-33</ref>፤ <ref loc="LUK 20:1-8">ሉቃ 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>የሱሲ ፆሳ ኬ ገልድ ታማርስሽን፥ ካህነ ሀላቃትነ አይሁደ ጭማት እያኮ ይድ፥ “ኔኒ ሀይሳ ኦና መላ ነዉ አይ ማት ደኢ? ነዉ ሀ ማታ እምዳይ ኦኔ?” ያግድ ኦይችዶሶና።<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>የሱሲ ኤንታኮ፥ “ታንካ ህንተና እስባ ኦይቻይስ፤ ህንተ ታዉ ሄሳ ዛርኮ፥ ታኒ አይ ማታን ኦያኮ ህንተዉ ኦዳና። <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>ዮሃንስ ፃማቃና መላ ማታይ አዉፐ እመትዴ? ፆሳፈየ አሳፔ?” ያግስ።</para>
  <para style="p" vid="MAT 21:25">ኤንቲ ባንታ ግዶን ዞረትድ፥ “ኑኒ፥ ‘ፆሳፈ’ ጊኮ፥ እ ኑና፥ ‘ያትን አይስ አማንበከቲ?’ ያጋና። <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>ኑኒ፥ ‘አሳፐ’ ጊኮ፥ አሳ ኡባይ ዮሃንሳ ናበ ኦ ፄልያ ግሾ፥ አሳ ያዮስ” ያግዶሶና። <verse eid="MAT 21:26"/><verse number="27" style="v" sid="MAT 21:27"/>ሄሳ ግሾ፥ “ኑኒ ኤሮኮ” ያግድ ዛርዶሶና።</para>
  <para style="p" vid="MAT 21:27">እካ፥ “ህዛ፥ ታንካ ሀይሳ አይ ማታን ኦያኮ ህንተዉ ኦድከ” ያግስ።<verse eid="MAT 21:27"/></para>
  <para style="s1">ናምኡ ናይታ ሌምሶ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>“የሱሲ ካልድካ ሀይሳዳ ያግስ፦ ናምኡ አደ ናይት ደእያ እስ ኡራይ ደኤስ። ሄ ኡራይ ባይራ ናኣኮ ብድ፥ ‘ታ ናአዉ፥ ሀች ዎይነ ግዶ ባዳ ኦ’ ያግስ። <verse eid="MAT 21:28"/><verse number="29" style="v" sid="MAT 21:29"/>ናአይ ዛሪድ፥ ‘አቶ ቢከ’ ያግስ። ሽን ጉየፐ ባ ዎዛናን ቆፕ ኤክድ ኦናዉ ብስ። <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/>አዋይ ባ ካሎ ናኣኮ ብድ፥ ባ ባይራ ናኣኮ ግዳይሳዳ ኪትስ። እካ፥ ‘ኤሮ፥ ታ አዋዉ’ ያግስ። ሽን ብቤና። <verse eid="MAT 21:30"/><verse number="31" style="v" sid="MAT 21:31"/>ሀ ናምኡ ናይታፐ ባ አዋስ ኪተትዳይስ አዉሴ?” ያግስ።</para>
  <para style="p" vid="MAT 21:31">ኤንትካ፥ “ባይራ” ያግዶሶና።</para>
  <para style="p" vid="MAT 21:31">የሱሲ ኤንታኮ፥ “ታ ህንተዉ ቱማ ኦዳይስ፤ ቃራፃ ቃንፅሰይሳትነ ላይማተይሳት ህንተፈ ስንትድ ፆሳ ካዎተ ገላና። <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>ፃማቅያ ዮሃንስ ሱረ ኦግያ ታማርስሸ ይን እ ገይሳ አማንበከታ። ሽን ቃራፃ ቃንፅሰይሳትነ ላይማተይሳት አማንዶሶና። ህንተ ሀር አቶሽን፥ ኤንታ በእድካ ህንተ ናጋራፐ ስሚድ አማንበከታ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">ሉቃ 3:12</ref>፤ <ref loc="LUK 7:29-30">7:29-30</ref>.</char></note><verse eid="MAT 21:32"/></para>
  <para style="s1">ጎሻንቾታ ሌምሶ</para>
  <para style="r">(<ref loc="MRK 12:1-12">ማር 12:1-12</ref>፤ <ref loc="LUK 20:9-19">ሉቃ 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>ቃስካ የሱሲ ሀይሳዳ ያግስ፤ “ሀራ ሌምሶ ስእተ፥ ዎይነ ቶክዳ እስ ኡራይ ደኤስ። ሄ ዎይንያ ዩሹዋ ድርስ። ዎይነ ጉምእያ ኦላ ቦክስ። ዎይንያ ናጋናዉ ሻኮ ሻክስ። ሄሳፈ ጉየ፥ ጋድያ ኮ እምድ ሀራ ቢታ ብስ።<note caller="-" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">እሳ 5:1-2</ref>.</char></note> <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>ዎይነ አይፍያ ማፅያ ዎደይ ጋክን ባና ጋክያ ባጋ ኤክድ ያና መላ ባ አይለታ ኤንታኮ የድስ። <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/>ኮ አዋት እያ አይለታ ኦይክድ እሱዋ ዋዶሶና፥ ሀንኩዋ ዎዶሶና ቃስ አትዳይሳ ሹቻን ጫድዶሶና። <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>ዎይነ አታክልትያ ጎዳይ ካሰይሳታፐ ዳርያ ሀራ አይለታ ኪትስ። ኮ አዋት ኤንታ ቦላካ ሀንኮይሳታ ቦላ ኦዳይሳዳ ኦዶሶና። <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>ዉርሰን እ፥ ‘ታ ናኣ ኤንቲ ቦንቻና!’ ያግድ ባ ናኣ ኤንታኮ ኪትስ።<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>“ሽን ኮ አዋት ናኣ በእድ ባንታ ግዶን ‘ጋድያ ላታናይስ ሀይሳ፥ እያ ዎድ ጋድያ ኑኒ ላቶስ!’ ያግዶሶና። <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>ናአ ኦይክድ ዎይነ ጋድያ ግዶፈ ጋፃ ከስድ ዎዶሶና።<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>“ህዛ፥ ዎይነ ጋድያ ጎዳይ ያ ዎደ ሄ ኮ አዋታ ዋታኔ?” ያግድ ኦይችስ።<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>ኤንቲ ዛሪድ፥ “እ ሄ ኢታ አሳታ ኢታ ዎ ዎድ፥ ዎይነይ አይፍያ ዎደ እያ ጋክያ ባጋ ዎደን ዎደን እምያ ሀራ ኮ አዋታስ እማና” ያግዶሶና።<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>የሱሲ ዛሪድ ኤንታኮ፥ ፆሳ ቃላን፥</para>
  <para style="q1" vid="MAT 21:42">“ ‘ግምበይሳት ቦርድ እፅዳ ሹቻይ፥</para>
  <para style="q2" vid="MAT 21:42">ጎዳ ፃጱዋ ምንያ፥ ኡባፈ አያ ሹቻ ግድስ።</para>
  <para style="q1" vid="MAT 21:42">ሀይስ ጎዳይ ኦዳባ፤</para>
  <para style="q2" vid="MAT 21:42">ኑ አይፍያስ ማላልስያባ’</para>
  <para style="m" vid="MAT 21:42">ጌተትድ ፃፈትዳይሳ ናባብበከቲ?<note caller="-" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዝ 118:22</ref>.</char></note><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>“ሄሳ ግሾ፥ ታኒ ህንተዉ ኦዳይስ፤ ፆሳ ካዎተይ ህንተፈ ኤከትድ ሎኦ አይፈ አይፍያ አሳታስ እመታና። <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>[ሀ ሹቻ ቦላ ኩንድያ ኦንካ መቀረታና። ቃስ ሀ ሹቻይ እያ ቦላ ዎያ ኡራይካ ጋጨታና”]<note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">እስ እስ በን ማፃፋት ፓይዶ 44 ጉጆሶና። (ሉቃ 20:18 ፄልተ)</char></note> ያግስ።<verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>ካህነ ሀላቃትነ ፋርሳወት የሱሲ ኦድዳ ሌምሱዋን ባንታና ኦድዳይሳ ኤርዶሶና። <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>ኤንቲ የሱሳ ኦይካናዉ ኮይዶሶና፥ ሽን አሳይ የሱሳ ናበ ኦድ ፄልያ ግሾ፥ አሳስ ያይዶሶና።<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">ያጋኖ ፄሳ ሌምሶ</para>
  <para style="r">(<ref loc="LUK 14:15-24">ሉቃ 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>የሱሲ አሳስ ዛሪድ ሀይሳዳ ያግድ ሌምሶ ኦድስ። <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>“ፆሳ ካዎተይ ባ ናኣስ ያጋኖ ጊግስዳ ካዋ ዳኔስ። <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>ሄ ካዎይ ያጋኖ ያና መላ ኦድ ዎዳ አሳታ ፄጋናዉ ባ አይለታ ኪትስ። ሽን አሳት ያናዉ ኮይቦኮና። <verse eid="MAT 22:3"/><verse number="4" style="v" sid="MAT 22:4"/>ቃስ ሀራ አይለታ ፄግድ፥ ፄገትዳ አሳታኮ ብድ፥ ‘ታኒ ታ ሳንጋታነ ሞዳ ጋታርመንታ ሹካስ፤ ኡባባይ ጊግስ። ታ ያጋኑዋ ሃ ዪተ ያግተ’ ያግድ ኪትስ። <verse eid="MAT 22:4"/><verse number="5" style="v" sid="MAT 22:5"/>ሽን ፄገትዳይሳት ፄሳ እፅድ፥ ባንታ ኦሶስ ኦሶስ ብዶሶና። እሶይ ባ ጎሻስ፥ ሀንኮይ ባ ዛልእያስ ብስ። <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>ሀራት ቃስ ካዋ አይለታ ኦይክድ፥ ካዉሽ ዋድ ዎዶሶና።<verse eid="MAT 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7"/>“ካዎይ ዳሮ ይሎትድ፥ ባ ዎታዳረታ የድድ ሸምፖ ዎዳይሳታ ዎስስ፥ ኤንታ ካታማካ ፁግስ። <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/>ሄሳፈ ጉየ፥ ባ አይለታኮ፥ ‘ያጋኖይ ጊግስ፥ ሽን ፄገትዳይሳት ያጋኑዋስ በሲያ አስ ግዶኮና። <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>ሄሳ ግሾ፥ ዎጋ ኦገታ ብድ፥ ደምዳ አስ ኡባ ያጋኑዋ ያና መላ ፄግተ’ ያግስ። <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>አይለት ኦግያ ቦላ ብድ ባንታ ደምዳ አስ ኡባ ሎኦታነ ኢታታ ኤህድ ያጋኖ ሻቃራ ገልስድ ኩንዶሶና።<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>“ሽን ካዎይ ካ ማናዉ ኡትዳ አሳ በአናዉ ገልዳ ዎደ ያጋኖ ማኦ ማእቦና እስ አስ ደምስ። <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>እያኮ፥ ‘ላ፥ ነ ያጋኖ ማኦ ማኦና ዋናዳ ሀይሳ ገላዲ?’ ያግስ። ሽን ኡራይ ስእ ግስ።<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>“ካዎይ ባ አይለታኮ፥ ‘ሀ ኡራ ኩሽያነ ቶሁዋ ቃችድ፥ ካረ ማ ከስ የግተ። ያን እያዉ ዬሆነ አቻ ጋርጨ ግዳና’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ 8:12</ref>፤ <ref loc="MAT 25:30">25:30</ref>፤ <ref loc="LUK 13:28">ሉቃ 13:28</ref>.</char></note><verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>“ሄሳዳካ፥ ፆሳ ካዎተስ ፄገትዳይሳት ዳሮ ሽን ዶረትዳይሳት ጉ” ያግስ።<verse eid="MAT 22:14"/></para>
  <para style="s1">ጊራባ</para>
  <para style="r">(<ref loc="MRK 12:13-17">ማር 12:13-17</ref>፤ <ref loc="LUK 20:20-26">ሉቃ 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>ሄሳፈ ጉየ፥ ፋርሳወት ብድ፥ የሱሳ ዋት ኦዳን ኦይካኔኮ ዞረትዶሶና። <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>ባንታ ታማረታነ ሄሮዲሳ ባጋታፐ እሶታ እሶታ ኪትዶሶና። ኤንትካ፥ “አስታማርያዉ፥ ነ ቱማ ኦደይሳ ኑ ኤሮስ። ኔኒ አሳፐ አሰ ሻካካ፥ አሳ ዎይጋንደስ ጋዳ አይኮካ ኦካ፥ ፆሳ ኦገ ቱማተን ታማርሳሳ። <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>አነ ኑስ ኦዳ፥ ኑኒ ሮመ ካዋስ ጊራ ጊራናዉ በሲ በሰኔ?” ያግዶሶና።<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>ሽን የሱሲ ኤንታ ኢታ ቆፋ ኤርድ፥ “ሀ ጩቦቶ፥ ታና አይስ ፓጨቲ? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>ጊራ ጊርያ ሚሽያ ታና በስተ” ያግስ። ኤንትካ እያዉ ሳንትመ ኤህዶሶና። <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>እ፥ “ሀ ሱንይነ ምስለይ ኦደባዬ?” ያግስ።<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>ኤንቲ፥ “ሮመ ካዎይሳ” ያግዶሶና።</para>
  <para style="p" vid="MAT 22:21">ያትን የሱሲ ኤንታኮ፥ “ህዛ፥ ካዋስ በሰይሳ ካዋስ፥ ፆሳስ በሰይሳ ፆሳስ እምተ” ያግስ።<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>ኤንቲ ሄሳ ስእዳ ዎደ ማላለትድ እያ ማታፐ አግድ ብዶሶና።<verse eid="MAT 22:22"/></para>
  <para style="s1">ሀይቆፐ ደንዶባ</para>
  <para style="r">(<ref loc="MRK 12:18-27">ማር 12:18-27</ref>፤ <ref loc="LUK 20:27-40">ሉቃ 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>ሄ ጋላስ ሀይቆፐ ደንዶይ ባዋ ግያ ሳዱቃወት የሱሳኮ ይድ፥ ያግድ እያ ኦይችዶሶና።<note caller="-" style="x"><char style="xo" closed="false">22:23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሀዋ 23:8</ref>.</char></note> <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>“አስታማርያዉ፥ ‘ሙሰይ፥ እስ አስ ናአ የሎና ሀይቅኮ፥ ሄ ሀይቅዳይሳ እሻይ እያ ማችዉ ኤክድ፥ ባ እሻስ ናአ የሎ’ ያግድ ኪትስ።<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዛረ 25:5</ref>.</char></note> <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>ኑ ኤርያ ላፑን እሻት ደኦሶና። ባይራይ ማቾ ኤክድ ናአ የሎና ሀይቅስ። እያ ማችዉ እያ ካሎ እሻይ ኤክስ። <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>ሄሳዳካ፥ ሄ ማጫስዉ ኤክዳ ናምአንይካ፥ ሄንይካ፥ ብድ ላፑናት ዉራና ጋካናዉ ኡባይ ሀይቅዶሶና። <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>ኡባፈ ጉየ ሄ ማጫስያ ሀይቃሱ። <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>ያትን፥ ላፑናት ኡባይ እዮ ኤክዳ ግሾ፥ ሀይቆፐ ደንድያ ጋላስ፥ ሄ ማጫስያ ላፑናታፐ አዉሳስ ማቾ ግዳኔ?” ያግዶሶና።<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>የሱሲ ዛሪድ፥ “ህንተ ፆሳ ቃላይ ታማርስያባ ዎይኮ እያ ዎልቃ ኤሮና ግሾ ባሌታ። <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>አሳይ ሀይቆፐ ደንድያ ዎደ ሳሎን ደእያ ኪታንቾታ መላ ግዳናፐ አትሽን፥ ኤኮኮና ገሎኮና። <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>ቃስ ሀይቅዳ አሳት ሀይቆፐ ደንዳናባ ፆሳይ ህንተዉ ኦድዳይሳ ናባብበከቲ? <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>ፆሳይ፥ ‘ታኒ አብራሃመ ፆሳ፥ ይሳቃ ፆሳ፥ ያይቆባ ፆሳ’ ያግስ። ሄሳ ግሾ፥ ፆሳይ ፓፃ ደኤይሳታ ፆሳፈ አትሽን፥ ሀይቅዳይሳታ ፆሳ ግደና”<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="fq" closed="false">ፆሳይ ፓፃ ደኤይሳታ ፆሳፈ አትሽን፥ ሀይቅዳይሳታ ፆሳ ግደና፦ </char><char style="ft" closed="false">የሱሲ ሀ በሳን ኦደይ ፆሳይ ሀ ሀይቅዳ ሄታስ ፆሰ ግድኮ ኤንቲ ደኦን ደኦሶና ያገይሳ።</char></note> ያግስ።<note caller="-" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከሳ 3:6</ref>.</char></note><verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>ዳሮ አሳይ ሄሳ ስእድ፥ እያ ትምርትያን ማላለትዶሶና።<verse eid="MAT 22:33"/></para>
  <para style="s1">ኡባፈ ባይራ ኪታ</para>
  <para style="r">(<ref loc="MRK 12:28-34">ማር 12:28-34</ref>፤ <ref loc="LUK 10:25-28">ሉቃ 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>የሱሲ ሳዱቃወታስ ጋናባ ይስዳይሳ ፋርሳወት ስእዳ ዎደ እስፈ ሺቅዶሶና። <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>ኤንታ ግዶፈ እስ ህገ አስታማረይ የሱሳ ፓጨ ኦይሾ ኦይችስ። <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>“አስታማርያዉ፥ ህገ ኡባፈ አይስ አዉሴ?” ያግድ ኦይችስ።<verse eid="MAT 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37"/>የሱሲ ዛሪድ፥ “ ‘ነ ጎዳ፥ ነ ፆሳ፥ ነ ኩመ ዎዛናፐ፥ ነ ኩመ ሸምፑዋፈ፥ ነ ኩመ ቆፋፐ ዶሳ።<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">ዛረ 6:5</ref>.</char></note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>ኡባፈ አይስነ ባይራ ኪታይ ሀይሳ። <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>ናምአን ኡባፈ አያ ኪታይ፥ አሰ ኡባ ነ ሁጵያ ነ ዶሰይሳዳ ዶሳ’ ያገይሳ።<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌወ 19:18</ref>.</char></note> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>ሙሰ ህገይነ ናበታ ትምርተይ ኡባይ ሀ ኪታታ ቦላ ካቶሶና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">22:40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ 10:25-28</ref>.</char></note><verse eid="MAT 22:40"/></para>
  <para style="s1">ክርስቶስ ኦደ ናኤ?</para>
  <para style="r">(<ref loc="MRK 12:35-37">ማር 12:35-37</ref>፤ <ref loc="LUK 20:41-44">ሉቃ 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>ፋርሳወት እስ ቦላ ሺቅድ ደእሽን፥ የሱሲ ኤንታና፥ <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>“ክርስቶሳባ ህንተ ዎይገቲ? እ ኦደ ናኤ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="MAT 22:42">ኤንቲ፥ “እ ካዋ ዳዊታ ናአ” ያግድ ዛርዶሶና።<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>የሱሲ ኤንታኮ፥ “ያትን፥ ዳዊቲ ጌሻ አያናን ግድድ ዋትድ ክርስቶሳ፥ ‘ጎዳ’ ግድ ፄጊ? ዳዊታ ግሸ፥<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>“ ‘ጎዳ ፆሳይ፥ ታ ጎዳኮ፥<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="fk" closed="false">ታ ጎዳኮ፦ </char><char style="ft" closed="false">ሀ በሳን ዳዊቲ ታ ጎዳ ግድ ፄገይ ክርስቶሳ።</char></note><note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ 110:1</ref>.</char></note></para>
  <para style="q2" vid="MAT 22:44">ነ ሞርከታ ነ ቶሆይ የያሶ ኦና ጋካናዉ፥</para>
  <para style="q2" vid="MAT 22:44">ሀይሳን ታፐ ኡሻቻ ባጋን<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="fk" closed="false">ኡሻቻ ባጋን፦ </char><char style="ft" closed="false">ማታነ ቦንቾ በሲ።</char></note> ኡታ’ ግስ።<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ 110:1</ref>.</char></note><verse eid="MAT 22:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="MAT 22:45"/>ህዛ፥ ዳዊቲ ክርስቶሳ ጎዳ ግድ ፄግኮ፥ ዋንድ ክርስቶስ ዳዊታ ናአ ግዲ?”</para>
  <para style="m" vid="MAT 22:45">ያግስ።<verse eid="MAT 22:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46"/>የሱሳስ እስ ቃላ ዛራናዉ ዳንዳእዳ አስ ኦንካ ባዋ። ቃስ ሄ ጋላሳፐ ዶምድ ሀራ ኦይሻ ኦይቻናዉ ኦንካ ዳንዳእቤና።<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">ህገ አስታማረታነ ፋርሳወታ አየ!</para>
  <para style="r">(<ref loc="MRK 12:38-39">ማር 12:38-39</ref>፤ <ref loc="LUK 11:43-46">ሉቃ 11:43-46</ref>፤ <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>ሄሳፈ ጉየ፥ የሱሲ ሺቅዳ አሳስነ ባ ታማረታስ ሀይሳዳ ያግስ። <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>“ህገ አስታማረትነ ፋርሳወት ሙሰ ህግያ ብላናዉ ማታራ ደኦሶና። <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>ሄሳ ግሾ፥ ኤንቲ ህንተና ኪትያ ኡባ ኦተነ ናግተ። ሽን ኤንቲ ኦይሳዳ ኦፍተ። አይስ ጊኮ፥ ኤንቲ ኦደይሳዳ ኦኮና። <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>ኤንቲ ቶካናዉ ዳንዳኤቶና ቶሆ ቃችድ አሳ ቶሶሶና። ሽን ባንታዉ ሀር አቶሽን፥ ሄ ቶሁዋ አሳይ ቶክያ ዎደ ብራ ፄራን ቦቻናዉ ኮዮኮና።<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>“ሽን ኤንቲ ባንታ ኦሶ ኡባ አስ በኦና መላ ኦሶና። ባንታ ሶምኦንነ ቀሰን ቃችያ ማፃፋ ፅቅሰይ ደእያ ክታፈ ዳልግሶሶና፥ ባንታ ማኡዋ ማጫራ አዱሶሶና።<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="fq" closed="false">ሶምኦንነ ቀሰን ቃችያ ማፃፋ፥ ማኡዋ ማጫራ አዱሶሶና፦ </char><char style="ft" closed="false">ሄሳ ኤንቲ ኦይ ታኒ ፆሳስ እመታስ ግያ ማላ በሳናሳ (ዛረ 15:37-41)።</char></note><note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">ማቶ 6:1</ref>፤ <ref loc="DEU 6:8">ዛረ 6:8</ref>፤ <ref loc="NUM 15:38">ታይቦ 15:38</ref>.</char></note> <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>ሞከትያ በሳን ቦንቾ በስነ አይሁደ ዎሳ ኬታን ዳሮ ሎእያ ኦይደ ዶሶሶና። <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>አሳይ ግያን ኤንታና ቦንቾን ሳሮናይሳነ ‘አስታማርያዉ’ ግድ ፄጋናይሳ ኮዮሶና።<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>“ሽን ህንተ አስታማረይ እሱዋ ፃላላ ግድዳ ግሾነ ህንተ ኡባይ እሻታ ግድዳ ግሾ፥ ‘አስታማርያዉ’ ጌተትድ ፄገቶፍተ። <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>ህንተዉ ሳሎን እስ አዋ ፃላል ደእያ ግሾ፥ ሀ ሳአን ኦናካ ‘አዋዉ’ ግድ ፄጎፕተ። <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>ህንተዉ እስ ጎዳይ ክርስቶሳ ፃላል ደእያ ግሾ ‘ጎዳዉ’ ጌተትድ ፄገቶፍተ። <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>ህንተ ግዶን ባይራተይ ህንተ አይለ ግዶ።<note caller="-" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26">ማቶ 20:26</ref>.</char></note> <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>ባና ግታያ ኦንካ ካዉያና፤ ባና ካዉሽያ ኦንካ ግታታና።<note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">ሉቃ 14:11</ref>፤ <ref loc="LUK 18:14">18:14</ref>.</char></note><verse eid="MAT 23:12"/></para>
  <para style="s1">ህገ አስታማረትነ ፋርሳወት ቦረትዶሶና</para>
  <para style="r">(<ref loc="MRK 12:40">ማር 12:40</ref>፤ <ref loc="LUK 11:39-42">ሉቃ 11:39-42</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>“ህንተኖ፥ ጩቦቶ፥ ህገ አስታማረቶነ ፋርሳወቶ፥ አሳ ስንን ሳሎ ካዎተ ጎርደይሳቶ ህንተና አየ! ህንተ፥ ህንተ ሁጰን ገለከታ ቃስ ሀራታካ ገልሰከታ።<verse eid="MAT 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14"/>[“ህንተኖ ጩቦቶ፥ ህገ አስታማረቶነ፥ ፋርሳወቶ፥ አምኤታ ኬ ህንተ ቦንቅሸ፥ አስ በኦ ግድ ዎሳ አዱሰታ። ሄሳ ግሾ፥ ህንተና አየ! ኡባፈ አያ ፕርዳይ ህንተና ናጌስ።]<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">እስ እስ በን ማፃፋት ፓይዶ 14 ጉጆሶና።</char></note><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>“ህንተኖ፥ ጩቦቶ፥ ህገ አስታማረቶነ ፋርሳወቶ፥ ህንተ እስ ኡራ አማንናዉ አባራነ ሳአራ ዩየታ። ሽን ህንተ እያ አማንዳ ዎደ ሄ ኡራ ህንተፈ አድ ጋናመስ ጊገትዳይሳ ኦያ ግሾ፥ ህንተና አየ!<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>“ኦንካ ፆሳ ኬን ጫቅኮ አይኮይካ ባዋ። ሽን ፆሳ ኬን ደእያ ዎርቃን ጫቅኮ፥ ሄ ጫቆይ እያ ጎማና ግያ ቆቀቶ፥ ህንተዉ ቆቅድ ሀራታ ካለይሳቶ፥ ህንተና አየ! <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>ህንተኖ፥ ኤያቶ፥ ቆቀቶ፥ ዎርቃይ አዬ? ዎርቅያ ፆሳስ ዱማያ ፆሳ ኬይ አ? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>ቃስ ‘ኦንካ ያርሾ በሳን ጫቅኮ፥ አይኮይካ ባዋ። ሽን ኦንካ እያ ቦላ ደእያ ያርሹዋን ጫቅኮ፥ ሄ ጫቆይ እያ ጎማና’ ያግድ ታማርሴታ። <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>ህንተኖ፥ ቆቀቶ፥ ያርሾይ አዬ? ያርሹዋ ፆሳስ ዱማያ በሳይ አ? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>ሄሳ ግሾ፥ ያርሾ በሳን ጫቅያ ኡራይ፥ ሄ ያርሾ በሳንነ እያ ቦላ ደእያ ኡባባን ጫቄስ። <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>ፆሳ ኬን ጫቅያ ኡራይ፥ ሄ ፆሳ ኬንነ እያን ደእያ ፆሳን ጫቄስ። <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>ሳሎን ጫቅያ ኡራይ ፆሳ አራታንነ ሄ አራታ ቦላ ኡትያ ፆሳን ጫቄስ።<note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">እሳ 66:1</ref>፤ <ref loc="MAT 5:34">ማቶ 5:34</ref>.</char></note><verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>“ህንተኖ፥ ጩቦቶ፥ ህገ አስታማረቶነ ፋርሳወቶ፥ ህንተና አየ! ህንተ ካሬ ሳዎፐ፥ ናትሮፐነ ኦካሸፐ አስራታ ከሴታ። ሽን ህገን ደእያ አድ ኮሸይሳታ አግደታ። ሄስካ፥ ሱረ ፕርዳ፥ ቃተነ ኡባባን አማነተ። ሀራታካ አጎናሽን ሀይሳታ ህንተ ኦናዉ በሴስ።<note caller="-" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">ሌወ 27:30</ref>.</char></note> <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>ህንተዉ ቆቅድ ሀራ አስ ካለይሳቶ፥ ህንተ ኡሻፈ ኡዱንፀ ከስድ ግማለ ምቴታ።<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>“ህንተኖ፥ ጩቦቶ፥ ህገ አስታማረቶነ ፋርሳወቶ፥ ህንተና አየ! ህንተ ሻትያስነ ከርያስ ቦላ ባጋ ጌሼታ። ሽን ኤንታዉ ጋርሳን ቦንቀይነ ኡዘተ ኩም ኡትስ። <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>ነኖ ቆቀ ፋርሳውያዉ፥ ሻትያስነ ከርያስ ጋርሳ ካሰታዳ ጌሻ። ሄሳፈ ጉየ፥ ቦላ ባጋይካ ጌሽ ግዳና።<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>“ህንተኖ፥ ጩቦቶ፥ ህገ አስታማረቶነ ፋርሳወቶ፥ ህንተና አየ! ካረ ባጋራ ቃላመ ትየትድ ሎእድ፥ ግዶን መቀነ ዎቅዳባይ ኩምዳ ዱፎታ ዳነታ።<note caller="-" style="x"><char style="xo" closed="false">23:27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">ሀዋ 23:3</ref>.</char></note> <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>ሄሳዳካ፥ ቦላ ባጋራ አሳስ ሎኦ ዳነታ። ሽን ህንተ ጋርሳን ጩቦተነ ኢታተ ኩምስ።<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>“ህንተኖ፥ ጩቦቶ፥ ህገ አስታማረቶነ ፋርሳወቶ፥ ህንተና አየ! ህንተ ናበታስ ዱፎ ኬፀታ፥ ቃስ ፅሎታ ዱፉዋካ ሎይታ። <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>ቃስ ህንተ፥ ‘ኑኒ በን ኑ አዋታ ዎደ ደእዳባ ግድያኮ፥ ኤንታራ እስፈ ናበታ ሱ ጉሶኮሽን’ ያጌታ። <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>ሄሳ ግሾ፥ ህንተ ናበታ ዎዳ አሳ ናይታ ግደይሳ ህንተ ህንተ ሁጰን ማርካቴታ። <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>ህዛ፥ ህንተ አዋት ዶምዳይሳ ህንተ ፖልተ።<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>“ሀ ሾሻቶ፥ ሾሻ ናይቶ፥ ህንተ ጋናመ ፕርዳፈ ዋንድ አታኔ?<note caller="-" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ 3:7</ref>፤ <ref loc="MAT 12:34">12:34</ref>፤ <ref loc="LUK 3:7">ሉቃ 3:7</ref>.</char></note> <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>ሄሳ ግሾ፥ ሄኮ፥ ታኒ ናበታ፥ ጭንጫ አሳታነ አስታማረታ ህንተኮ ኪታና። ኤንታፈ እሶታ እሶታ ህንተ ዎናነ ማስቃላ ቦላ ካቃና። ባጋታ አይሁደ ዎሳ ኬታን ልሶን ጋራፋናነ ካታማፐ ካታማ ጎዳና። <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>ሄሳ ግሾ፥ ፅሉዋ አበላ ዎዳ ዎደፐ ዶምድ፥ ፆሳ ኬስነ ያርሾ በሳፈ ግዶን ህንተ ዎዳ ባራካ ናአ ዛካርያሳ ዎደ ጋካናዉ ሀይቅዳ ፅሎ አሳ ኡባ ግሾ፥ ህንተ ሴረታና።<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">መ 4:8</ref>፤ <ref loc="2CH 24:20">2 ታር 24:20</ref>.</char></note> <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተነ ህንተ አዋት ኦዳ ናጋራስ ሀ ፕርዳ ኡባይ ሀ የለተ ቦላ ጋካና።<verse eid="MAT 23:36"/></para>
  <para style="s1">የሱሲ የሩሳላመስ ዬክስ</para>
  <para style="r">(<ref loc="LUK 13:34-35">ሉቃ 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>“የሩሳላመ፥ የሩሳላመ፥ ናበታ ዎያረ! ፆሳይ ኔኮ ኪትዳይሳታ ሹቻን ጫድያረ! ኩቶይ ባ ናይታ ባ ቀፈን ሀጰይሳዳ ታኒ ነ አሳ ታ ቀስያን ገቻናዉ አፑን ቶሆ ኮያድና! ሽን ታና ድጋዳሳ። <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>ህዛ፥ ሄኮ፥ ህንተ ኬይ ካይስ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="JER 22:5">ኤርም 22:5</ref>.</char></note> <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>ታኒ ህንተዉ ኦዳይስ፤ ‘ጎዳ ሱንን የይስ አንጀትዳይሳ’ ህንተ ጋና ጋካናዉ ናምአን ታና በኤከታ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዝ 118:26</ref>.</char></note><verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">ፆሳ ኬይ ላለቶና አተና</para>
  <para style="r">(<ref loc="MRK 13:1-2">ማር 13:1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>የሱሲ ፆሳ ኬፈ ከይድ ብሽን፥ እያ ታማረት እያኮ ይድ፥ ማላለትድ ፆሳ ኬ ግምብያ በስዶሶና። <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>የሱሲ ኤንታኮ ዛሪድ፥ “ኤ! ሀይሳ ኡባ በኤቲ? ታኒ ህንተዉ ቱማ ኦዳይስ፤ ሹች ሹቻ ቦላ ግምበትዳ መላ ላለቶና አተና” ያግስ።<verse eid="MAT 24:2"/></para>
  <para style="s1">ስንፈ ሀናናባታ</para>
  <para style="r">(<ref loc="MRK 13:3-13">ማር 13:3-13</ref>፤ <ref loc="LUK 21:7-19">ሉቃ 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>የሱሲ ሻማሆ ዙማ ቦላ ኡትዳሽን፥ እያ ታማረት ባንታርካ እያኮ ይድ፥ “ሄስ አዉደ ሀናኔኮ ኑስ ኦዳ። ቃስ ነ ዩሳስነ ዎድያ ዉርሰስ ማላታይ አይቤ?” ያግድ ኦይችዶሶና።<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>የሱሲ ዛሪድ፥ “ህንተና ኦንካ ባለና መላ ናገትተ! <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>አይስ ጊኮ፥ ዳሮ አሳት ታ ሱንን፥ ‘ታኒ ክርስቶሳ፥ ፆሳይ አሳ አሻናዉ ኪትዳይሳ’ ያግሸ ይድ ዳሮ አሳ ባለና። <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>ማታን ደእያ ኦላ ግርሳ፥ ሃሆን ደእያ ኦላ ዎረ ስአናዉ ደኤታ። ሄሳ መላባይ ሀናናዉ በሲያ ግሾ ህርጎፍተ። ሽን ዉርሰይ ቡሮና። <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>ደረይ ደርያራ፥ እስ ካዎተይ ሀራ ካዎተራ ኦለታና። ኮሻይነ ቢታ ቃፆይ ኡባ በሳን ሀናና። <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>ሄስ ኡባይ የሎ እቀስ ዞከ መላ።<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>“ሄ ዎደ አሳይ ህንተና ዋዬስ አድ እማና፥ ቃቻናነ ዎና። ታ ሱን ግሾ አሳ ኡባይ ህንተና እፃና።<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ 10:22</ref>.</char></note> <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>ሄ ዎደ ዳሮት አማኖ አጋና። ባንታ ግዶን እሶይ እሱዋ አድ እማና፥ እሶይ እሱዋ እፃና። <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>ቃስ ዳሮ ዎርዶ ናበት ደንድድ ዳሮታ ባለና። <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>ጌላተ ዳርያ ግሾ፥ ዳሮ አሳ ሲቆይ እርፃና። <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>ሽን ዉርሰ ጋካናዉ ገንጭያ ኡራይ አታና።<note caller="-" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ 10:22</ref>.</char></note> <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>አሳ ኡባስ ማርካ ግዳና መላ ፆሳ ካዎተ ዎንገላይ ቢታ ኡባን ኦደታና። ሄሳፈ ጉየ፥ ዉርሰይ ያና።<verse eid="MAT 24:14"/></para>
  <para style="s1">ቱና ዮ</para>
  <para style="r">(<ref loc="MRK 13:14-23">ማር 13:14-23</ref>፤ <ref loc="LUK 21:20-24">ሉቃ 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>“ሄሳ ግሾ፥ ናብያ ዳነል ኦድዳ ዮ ቱናተይ ጌሻ በሳን ኤቅዳይሳ ህንተ በአና።<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DEU 9:27">ዛረ 9:27</ref>፤ <ref loc="DEU 11:31">11:31</ref>፤ <ref loc="DEU 12:11">12:11</ref>.</char></note> (አኬክሶ፦ ሄስ ዎይ ጉሰኮ ናባበይስ አኬኮ!) <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>ሄ ዎደ ይሁዳ ቢታን ደኤይሳት ደርያኮ ባቃቶ። <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>ኬ ሁጰን ደእያ ኡራይ ባ ሶን ደእያባ ኤካናዉ ሶ ገሎና ባቃቶ።<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ 17:31</ref>.</char></note> <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>ጋደን ደኤይስ ባ ማኡዋ ኤካናዉ ጉየ ስሞፎ። <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>ሄ ዎደ ቃን ማጫሳታስነ ንያ ማጫሳታስ ዳሮ ኡንአ ግዳና። <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>ባልጎን ዎይኮ ሳምባታን ህንተ ባቃቶይ ግዶና መላ ፆሳ ዎስተ። <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>አይስ ጊኮ፥ ሳእ መቶሳፐ ሀች ጋካናዉ ሀኖናባይ፥ ቃስ ስንፈካ ኡባራካ ሀኖና ዋየይ ሄ ዎደ ሀናና።<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="GEN 12:1">መ 12:1</ref>፤ <ref loc="REV 7:14">ቆን 7:14</ref>.</char></note> <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>ፆሳይ ሄ ጋላሳታ ታይቡዋ ጉናኮ አሰ ግድዳ ኦንካ አተና። ሽን እ ባ ዶርዳ አሳታ ግሾ፥ ሄ ጋላሳታ ታይቡዋ ጉና።<verse eid="MAT 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23"/>“ሄ ዎደ ኦንካ ህንተና፥ ‘ሄኮ፥ ክርስቶስ ሀይሳን’ ዎይኮ ‘ህንን ደኤስ’ ያግኮ አማኖፕተ። <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>አይስ ጊኮ፥ ዎርዶ ክርስቶሳትነ ዎርዶ ናበት ደንዳና። ኤንታዉ ዳንዳኤትኮ፥ ሀር አቶሽን ፆሳይ ዶርዳይሳታካ ባለናዉ ግታ ማላታታነ ማላልስያባታ ኦና። <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>አኬክተ፥ ታኒ ህንተዉ ሀይሳ ካሰታዳ ኦዳስ።<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>“ሄሳ ግሾ፥ አሳይ ህንተኮ፥ ‘ሄኮ፥ ክርስቶስ ባዞን ደኤስ’ ጊኮ፥ ያ ቦፕተ። ዎይኮ ህንተኮ፥ ‘ሄኮ፥ ቆልአን ደኤስ’ ጊኮ፥ ኤንታባ አማኖፕተ።<note caller="-" style="x"><char style="xo" closed="false">24:26 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">ሉቃ 17:23-24</ref>.</char></note> <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>አይስ ጊኮ፥ ዎልአን ሳሎን ዎልአምድ፥ ዶሎሀፐ ዉሎሀ ጋካናዉ በንተይሳዳ፥ አሳ ናኣ ዩሳይ ሄሳዳ ሀናና።<verse eid="MAT 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28"/>“ባዉት ደእያሶን አንኮት ሺቃና።<note caller="-" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">ሉቃ 17:37</ref>.</char></note><verse eid="MAT 24:28"/></para>
  <para style="s1">ክርስቶስ ናምአን ያና</para>
  <para style="r">(<ref loc="MRK 13:24-27">ማር 13:24-27</ref>፤ <ref loc="LUK 21:25-28">ሉቃ 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>“ሄ ዎደ ሄ ዋየ ጋላሳታፐ ጉየ፥</para>
  <para style="q2" vid="MAT 24:29">ኤለስድ አዋይ ማና፥</para>
  <para style="q2" vid="MAT 24:29">አጌናይ ባ ፖኡዋ ድጋና።<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">እሳ 13:10</ref>፤ <ref loc="JER 2:10">ኤርም 2:10</ref>.</char></note></para>
  <para style="q1" vid="MAT 24:29">ፆልንቶት ሳሎፐ ዎና፥</para>
  <para style="q2" vid="MAT 24:29">ቃስ ሳሎን ደእያ ዎልቃት ቡቀታና።<verse eid="MAT 24:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 24:30"/>ሄ ዎደ አሳ ናኣ ዩሳ ማላይ ሳሉዋ ቦላ በንታና። ሳአን ደእያ አስ ኡባይ ዬካና። ቃስ አሳ ናአይ፥ ዎልቃራነ ግታ ቦንቹዋራ ሳሉዋ ሻራ ግዶራ ይሽን ኤንቲ በአና።<note caller="-" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="DEU 7:13">ዛረ 7:13</ref>፤ <ref loc="ZEC 12:10">ዛካ 12:10</ref>.</char></note> <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>እ ባ ኪታንቾታ ግታ ሞይዘ ፑኖራ ኪታና። ኤንቲ ሳኣ ኦይዱ ባጋ ብድ፥ ሀ ጋፃፐ ያ ጋፃ ጋካናዉ ደእያ እያዉ ዶረትዳይሳታ ሺሻና።<verse eid="MAT 24:31"/></para>
  <para style="s1">ባላሰ ም ሌምሶ</para>
  <para style="r">(<ref loc="MRK 13:28-31">ማር 13:28-31</ref>፤ <ref loc="LUK 21:29-33">ሉቃ 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>“ባላሰ ምፈ ታማርተ። እያ አጫዳ ሀይፅያ ዎደ ቶርቸይ ማታትዳይሳ ህንተ ኤሬታ። <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>ሄሳዳካ፥ ህንተ ሀ ኡባባ በእያ ዎደ የሱሲ ማትድ ፐንገን ደኤይሳ ኤርተ። <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ሀ ኡባባይ ፖለታና ጋካናዉ፥ ሀ የለተይ አና። <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>ሳሎይነ ሳእ አና፥ ሽን ታ ቃላይ ኡባካ አና።<note caller="-" style="x"><char style="xo" closed="false">24:35 </char><char style="xt" closed="false"><ref loc="GEN 6:5">መ 6:5</ref>.</char></note><verse eid="MAT 24:35"/></para>
  <para style="s1">የሱሲ ያና ዎደ ኦንካ ኤረና</para>
  <para style="r">(<ref loc="MRK 13:32-37">ማር 13:32-37</ref>፤ <ref loc="LUK 17:26-30">ሉቃ 17:26-30</ref>፥ <ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>“ሄ ጋላሳነ ሄ ሳትያ ሳሎን ደእያ ታ አዋፐ አትሽን፥ ሀር ሳሎ ኪታንቾታ ግድን ዎይኮ ናኣ ግድን ኦንካ ኤረና። <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>አሳ ናኣ ዩሳይ፥ ኖሄ ዎደ ሀንዳይሳ መላ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5">መ 6:5</ref>.</char></note> <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>ሄ ዎደ ዮ ሃይ ያናፐ ስን ኖሄይ ማርካብያን ገልዳ ጋላሳ ጋካናዉ፥ አሳይ ምሸነ ኡይሸ፥ ኤክሸነ ገልሸ ጋምእስ። <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>ዮ ሃይ ይድ፥ ኤንታ ኡባ ይሳና ጋካናዉ አኬክቦኮና። አሳ ናኣ ዩሳይካ ሄሳዳ ሀናና።<verse eid="MAT 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 24:40"/>“ሄ ዎደ ናምኡ አሳት ጋደን ኦና። ኤንታፈ እሶይ ኤከታና፥ ሀንኮይ አታና። <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>ናምኡ ማጫሳት እስፈ ጋጫና። ኤንታፈ እስንያ ኤከታና ሀንክያ አታና።<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>“ህዛ፥ ህንተ ጎዳይ አይ ጋላስ ያነኮ ህንተ ኤሮና ግሾ፥ ምንድ ናግተ። <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>ሽን ካይሶይ ቃማፈ አይ ሳተን ያነኮ ጎዳይ ኤርያኮ፥ ባ ኬይ ቦከቶና መላ ባርክድ ናጋናሽን።<note caller="-" style="x"><char style="xo" closed="false">24:43 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">ሉቃ 12:39-40</ref>.</char></note> <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>ሄሳዳካ፥ አሳ ናአይ ህንተ ቆፖና ሳተን ያና ግሾ፥ ህንተካ ጊግድ ደእተ።<verse eid="MAT 24:44"/></para>
  <para style="s1">ኢታነ ሎኦ አይለ ሌምሶ</para>
  <para style="r">(<ref loc="LUK 12:41-48">ሉቃ 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>“ያትን፥ ባ ሶ አሳስ ካ ኮሽያ ዎድያን እማና መላ እያ ጎዳይ ዶርዳ አማንይስነ ዎዛናማ አይለይ ኦኔ? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>እ ባ ጎዳይ ኪትዳይሳ ኦሽን እያ ጎዳይ ይድ ደምያ አይለይ አንጀትዳይሳ። <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ጎዳይ ሄ አይልያ ባባ ኡባ ቦላ ሹማና። <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>ሽን ሄ አይለይ ኢታ ግድኮ፥ ‘ታ ጎዳይ ጋምእድ ያና’ ያግድ ባ ዎዛናን ቆፕድ፥ <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>ባ ላገ ኦሳንቾታ ዋ ዶምኮ፥ ማተይሳታራ ሚኮነ ኡይኮ፥ <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>ሄ አይልያ ጎዳይ እ ቆፖና ጋላስነ እ ኤሮና ሳተን፥ <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>ይድ እያ ቃንፀረና። እያ ቃዳ ጩቦታራ ኦና። ሄ በሳን እያዉ ዬሆነ አቸ ጋርጨ ግዳና።<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">ታሙ ጌላኦታ ሌምሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>“ሄ ዎደ ሳሎ ካዎተይ ባንታ ፆምፐ ኦይክድ፥ ማቾ ኤሀናዉ ብዳ አድያ ሞካናዉ ከይዳ ታሙ ጌላኦታ ዳኔስ።<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">ሉቃ 12:35</ref>.</char></note> <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>ኤንታፈ እቻሻት ኤያ፥ ቃስ እቻሻት ጭንጫ። <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>ኤያት ፆምፐ ኦይክዶሶና፥ ሽን ጉዣ ዛይተ ኦይክቦኮና። <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>ሽን ጭንጫት ባንታ ፆምፐነ ሀራ ጉዣ ዛይተ ኦይክዶሶና። <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>ማችዉ ኤከይስ ጋምእን፥ ሄ ጌላኦት ባንታና ስኮይ ኦይክን ስክዶሶና።<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>“ግድ ብላሄ ግድያ ዎደ፥ ‘ሄኮ፥ ማችዉ ኤሄይስ ጋክስ፥ እያ ሞካናዉ ከይተ’ ግያ ግታ ጫቦይ ስኤትስ።<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>“ሄ ዎደ ሄ ጌላኦት ኡባይ ባርክድ፥ ባንታ ፆምፕያ ጊግስዶሶና። <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>ኤያት ጭንጫታኮ፥ ‘ኑ ፆምፐይ ቶአና ሀንያ ግሾ፥ ህንተ ዛይትያፐ ኑስ እመርከት’ ያግዶሶና።<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>“ሽን ጭንጫት ዛሪድ፥ ‘አካይ፥ ኑስነ ህንተዉ ግድያ ዛይተይ ባዋ። ሄሳ ግሾ፥ ብድ ህንተዉ ሻምድ ኤክተ’ ያግዶሶና። <verse eid="MAT 25:9"/><verse number="10" style="v" sid="MAT 25:10"/>ኤያ ጌላኦት ዛይተ ሻማናዉ ብን፥ ማችዉ ኤከይስ ፑቱ ግስ። ጊገት ኡትዳ እቻሹ ጌላኦት እያራ እስፈ ያጋኖ ኬ ገልዶሶና፤ ካረይካ ጎርደት አግስ።<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>“ጉየፐ ሀንኮ ጌላኦት ይድ፥ ‘ጎዳዉ፥ ጎዳዉ፥ ኑስ ዶያርክ’ ያግዶሶና።<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>“ሽን እ ዛሪድ፥ ‘ታኒ ህንተዉ ቱማ ኦዳይስ፤ ታ ህንተና ኤርከ!’<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>“ህዛ፥ አሳ ናአይ ያና ጋላሳ ዎይኮ ሳትያ ህንተ ኤሮና ግሾ ባርክድ ናግተ።<verse eid="MAT 25:13"/></para>
  <para style="s1">ሄ ኦሳንቾታ ሌምሶ</para>
  <para style="r">(<ref loc="LUK 19:11-27">ሉቃ 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>“ፆሳ ካዎተይ ባ ኦሳንቾታ ፄግድ ባዉ ደእያባ ኤንታዉ ሼድ ኦገ ባናዉ ከይዳ ኡራ ዳኔስ።<note caller="-" style="x"><char style="xo" closed="false">25:14 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">ሉቃ 19:11-27</ref>.</char></note> <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>ኤንታዉ ሁጰን ሁጰን ኤንታ ዎልቃ መላ እሱዋስ እቻሹ ካርፂተ ብራ፥ እሱዋስ ናምኡ ካርፂተ ብራ ቃስ እሱዋስ እስ ካርፂተ ብራ እምድ ባ ኦግያ ብስ። <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>እቻሹ ካርፂተ ብራ ኤክዳ አይለይ ኤለስ ብድ ዛልእድ፥ ሀራ እቻሹ ካርፂተ ብራ ዎስስ። <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>ሄሳዳካ፥ ቃስ ናምኡ ካርፂተ ብራ ኤክዳ አይለይ ሀራ ናምኡ ካርፂተ ብራ ዎስስ። <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>ሽን እስ ካርፂተ ብራ ኤክዳይስ ብድ፥ ኦላ ቦክድ፥ ባ ጎዳ ሚሽያ ሞግስ።<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>“ዳሮ ዎደፐ ጉየ ሄ አይለታ ጎዳይ ይድ፥ ባ ሚሽያ ኤንታራ ሳላእስ። <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>እቻሹ ካርፂተ ብራ ኤክዳ አይለይ ይድ፥ ሀራ እቻሹ ካርፂተ ብራ ኤህድ፥ ‘ታ ጎዳዉ፥ ኔኒ ታዉ እቻሹ ካርፂተ ብራ እማዳሳ። ሽን ታኒ ሀራ እቻሹ ካርፂተ ብራ ዎሳስ’ ያግስ። <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/>እያ ጎዳይ፥ ‘ዛምቦይ! ኔኒ ሎኦነ አማንያ አይለ፤ ኔኒ ጉባን አማነታዳሳ። ታኒ ነና ዳሮባ ቦላ ሹማና፤ ሃ ገላዳ ነ ጎዳራ ኡፋይታ’ ያግስ።<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>“ቃስ ናምኡ ካርፂተ ብራ ኤክዳይስ ይድ፥ ‘ታ ጎዳዉ፥ ኔኒ ታዉ ናምኡ ካርፂተ ብራ እማዳሳ። ሽን ታኒ ሀራ ናምኡ ካርፂተ ብራ ዎሳስ’ ያግስ። <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/>እያ ጎዳይ፥ ‘ዛምቦይ! ኔኒ ሎኦነ አማንያ አይለ፤ ኔኒ ጉባን አማነታዳሳ። ታኒ ነና ዳሮባ ቦላ ሹማና፤ ሃ ገላዳ ነ ጎዳራ ኡፋይታ’ ያግስ።<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>“ቃስ እስ ካርፂተ ብራ ኤክዳይስ ይድ፥ ‘ታ ጎዳዉ፥ ኔኒ ዘሮና በሳፈ ጫክያነ ርጮና በሳፈ ማፅያ ኢታ አስ ግደይሳ ታኒ ኤራይስ። <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>ሄሳ ግሾ፥ ያያዳ ነ ብራ ቢታን ሞጋስ። ነ ሚሸይ ሀይስሽ’ ያግስ።<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>“እያ ጎዳይ ዛሪድ፥ ‘ሀ ኢታ አዛላ አይልያዉ፥ ታኒ ዘሮና በሳፈ ጫከይሳነ ርጮና በሳፈ ማፅያ አስ ግደይሳ ኤራዳሳ። <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>ያትን፥ ኔኒ ታ ሚሽያ ባንከን ዎዳባ ግድያኮ፥ ታኒ ስምያ ዎደ ታ ሚሽያ ዎራ ኤካናይሳ ድጋዳሳ። <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>ሄሳ ግሾ፥ ሚሽያ እያፐ ኤክድ፥ ታሙ ካርፂተ ብር ደኤይሳስ እምተ። <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>አይስ ጊኮ፥ ደእያ ኡባስ ጉዠታናነ ዳራና። ሽን ባይናይሳፈ ሀር አቶሽን፥ ሄ እያዉ ደእያ ጉያካ ኤከታና።<note caller="-" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ 13:12</ref>፤ <ref loc="MRK 4:25">ማር 4:25</ref>፤ <ref loc="LUK 8:18">ሉቃ 8:18</ref>.</char></note> <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>ሀ ማዶና አይልያ ካረ ማ ከስ የግተ። ያን እያዉ ዬሆነ አቸ ጋርጨ ግዳና’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ 8:12</ref>፤ <ref loc="MAT 22:13">22:13</ref>፤ <ref loc="LUK 13:28">ሉቃ 13:28</ref>.</char></note><verse eid="MAT 25:30"/></para>
  <para style="s1">ዎደ ዉርሰ ፕርዳ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>“አሳ ናአይ፥ ኪታንቾ ኡባታራ፥ ባ ቦንቹዋራ ያ ዎደ እ ባ ቦንቾ ካዎተ አራታ ቦላ ኡታና።<note caller="-" style="x"><char style="xo" closed="false">25:31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">ማቶ 16:27</ref>፤ <ref loc="MAT 19:28">ማቶ 19:28</ref>.</char></note> <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>ቢታን ደእያ አስ ኡባይ እያ ስን ሺቃና። ሄንንቾይ ዶርሳታ ዴሻታፐ ሻከይሳዳ እ ሄ አሳ ናምአን ሻካና። <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>ቃስ ዶርሳታ ኡሻቻ ባጋራ ዴሻታ ሀድርሳ ባጋራ ኤሳና።<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>“ሄሳፈ ጉየ፥ ካዎይ ኡሻቻ ባጋራ ደኤይሳታኮ ሀይሳዳ ያጋና፦ ‘ታ አዋይ አንጅዳይሳቶ፥ ሀ ይድ ሳእ መትያ ዎደፐ ዶምድ ህንተዉ ጊግዳ ካዎተ ላትተ። <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>አይስ ጊኮ፥ ታኒ ኮሻትን ሙዝደታ፥ ሳሞትን ኡሽደታ፥ ኤረቶና እማ አስ ግዳዳ ብን ሞክደታ፥ <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>ካሎትን ማይዝደታ፥ ሀርገትን ሀርግስደታ፥ ቃሸትን ታና ኦይችደታ’ ያጋና።<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>“ሄሳፈ ጉየ፥ ፅሎት ዛሪድ፥ ‘ጎዳዉ፥ ኔኒ ኮሻትን አዉደ በእድ ሙዝዶ? ዎይኮ ኔኒ ሳሞትን አዉደ በእድ ኡሽዶ? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>ኔኒ እማ ግዳዳ ይን አዉደ በእድ ሞክዶ? ዎይኮ ኔኒ ካሎትን አዉደ ማይዝዶ? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>ኔኒ ሀርግን ዎይኮ ቃሸትን ኔኮ ብድ ነና አዉደ ኦይችዶ?’ ያጋና። <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/>ካዎይ ዛሪድ፥ ‘ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተ ታና ካልያ ሀ ኡባፈ ጉፀይሳስ ኦዳይሳ ታዉ ኦደታ’ ያጋና።<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>“ሄ ዎደ ሀድርሳ ባጋራ ደኤይሳታኮ፥ ‘ሀ ባደትዳይሳቶ፥ ታ ማታፐ ሃክተ። ፃላሄስነ እያ ኪታንቾታስ ጊግዳ መርና ታማን ቢተ። <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>አይስ ጊኮ፥ ኮሻትን ታና ሙዝቤከታ፤ ሳሞትን ኡሽቤከታ። <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>ታኒ እማ ግዳዳ ብን ታና ሞክበከታ፥ ካሎትን ማይዝቤከታ፥ ሀርግንነ ቃሸትን ታና ኦይችቤከታ’ ያጋና።<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>“ሄ ዎደ ኤንቲ፥ ‘ጎዳዉ፥ ኔኒ ኮሻትን ዎይኮ ሳሞትን ዎይኮ እማ ግዳዳ ብን ዎይኮ ካሎትን ዎይኮ ሀርግን ዎይኮ ቃሸትን በእድ ነና አዉደ ማዶና እፅዶ?’ ያግድ ዛራና።<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>“ሄ ዎደ ካዎይ ዛሪድ ኤንታኮ፥ ‘ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተ ታና ካልያ ሀ ኡባፈ ጉፀይሳ ማዶና እፅዳይስ፥ ታና ማዶና እፅዳይሳ’ ያጋና። <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/>ሄሳ ግሾ፥ ሄ አሳት መርና ፕርዳስ ቃስ ፅሎት መርና ደኡዋስ ባና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳነ 12:2</ref>.</char></note><verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">የሱሳ ቦላ ማቀትዶሶና</para>
  <para style="r">(<ref loc="MRK 14:1-2">ማር 14:1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ 22:1-2</ref>፤ <ref loc="JHN 11:45-53">ዮሀ 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>የሱሲ ሀ ትምርትያ ኡባ ዉርስዳ ዎደ ባ ታማረታኮ፥ <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>“ናምኡ ጋላሳፐ ጉየ፥ ፓስካ ባኣለ ቦንችያ ጋላስ ግደይሳ ኤሬታ። ሄ ጋላስ አሳ ናእ ማስቃለ ቦላ ካቀታናዉ አሳ ኩሸን አድ እመታና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="EXO 12:1">ከሳ 12:1</ref>.</char></note><verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>ሄ ዎደ ካህነ ሀላቃትነ ጭማት፥ ቃያፋ ጌተትያ ካህነ ሀላቃ ኬን ሺቅድ፥ <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>አስ ኤሮና የሱሳ ኦይክድ፥ ዎናዉ ማቀትዶሶና። <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>ሽን ኤንቲ፥ “አሳይ ኦሽ ከሶና መላ ግድ፥ ፓስካ ቦንችያ ጋላስ ሄሳ ኦኮ” ያግዶሶና።<verse eid="MAT 26:5"/></para>
  <para style="s1">የሱሳ ሽቶ ትይዳ ማጫስዉ</para>
  <para style="r">(<ref loc="MRK 14:3-9">ማር 14:3-9</ref>፤ <ref loc="JHN 12:1-8">ዮሀ 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>የሱሲ ብታነ ካታማን ባሮ ሀርግዳ ስሞና ሶን ደኤስ። <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>የሱሲ እማቱዋ ቦላ ደእሽን እስ ማጫስያ አልባስፅሮሳ ብልቃፀ ኩመ ዳሮ አልኦ ሽቶ ኤካ ያዳ የሱሳ ሁጰን ትጋሱ።<note caller="-" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="LUK 7:37">ሉቃ 7:37</ref>.</char></note> <verse eid="MAT 26:7"/><verse number="8" style="v" sid="MAT 26:8"/>ሽን የሱሳ ታማረት ሄሳ በእድ ሀንቀትድ፥ “ሀ ሽቶይ ጮ ኢተይ አይብሴ? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>ሀ ሽቶይ አልኦ ጋተን ባይዘትድ፥ ሚሸይ ማንቆታስ እመታናዉ ዳንዳኤቴስ” ያግዶሶና።<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>የሱሲ ኤንቲ ገይሳ ኤርድ፥ ኤንታኮ፥ “ሀ ማጫስዉ አይስ ዋይሰቲ? እያ ታዉ ሎኦባ ኦሱ። <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>ማንቆት ኡባ ዎደ ህንተራ ዳና። ሽን ታኒ ህንተራ ኡባ ዎደ ደእከ።<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ዛረ 15:11</ref>.</char></note> <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>እያ ሀ ሽቱዋ ታ ቦላ ትግዳይስ ታና ሞጋናዉ ጊግሳናሳ። <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ቢታ ኡባን ሀ ዎንገላይ ሳባከትያ በሳን አዉንካ፥ አሳይ እዮ ሀሳያና መላ እያ ኦዳይስ ኦደታና” ያግስ።<verse eid="MAT 26:13"/></para>
  <para style="s1">ይሁድ የሱሳ አድ እሙዋ</para>
  <para style="r">(<ref loc="MRK 14:10-11">ማር 14:10-11</ref>፤ <ref loc="LUK 22:3-6">ሉቃ 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>ሄ ዎደ ታማነ ናምኡ የሱሳ ታማረታፐ እሶይ፥ አስቆሮታ ይሁዳ ጌተተይስ ካህነ ሀላቃታኮ፥ <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>ብድ፥ “ታኒ ህንተዉ የሱሳ አ እምኮ፥ ህንተ ታዉ አይ እማኔ?” ያግድ ኤንታ ኦይችስ።<note caller="-" style="x"><char style="xo" closed="false">26:15 </char><char style="xt" closed="false"><ref loc="ZEC 11:12">ዛካ 11:12</ref>.</char></note> ኤንቲ ዞረትድ ሀስታሙ ብራ ሳንትመ<note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="fq" closed="false">ብራ ሳንትመ፦ </char><char style="ft" closed="false">አይኮይካ ጉዠትቦና ጌሻ ብራ ሳንትመ ጉሱ።</char></note><note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="fq" closed="false">ሀስታሙ ብራ ሳንትመ፦ </char><char style="ft" closed="false">ሀስታሙ ብራ ሳንትመይ እስራኤለ ቢታን አይለይ ሻመትያነ ባይዘትያ ጋተ።</char></note> እምዶሶና። <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>ሄሳፈ ጉየ፥ ይሁድ የሱሳ አድ እማናዉ እንጀትያ ዎደ ዎቼስ።<verse eid="MAT 26:16"/></para>
  <para style="s1">ጎዳ ካሁዋ</para>
  <para style="r">(<ref loc="MRK 14:22-26">ማር 14:22-26</ref>፤ <ref loc="LUK 22:15-20">ሉቃ 22:15-20</ref>፤ <ref loc="2CO 11:23-25">2 ቆሮ 11:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>ኡይ ባኣለ ቦንችያ ኮይሮ ጋላስ፥ የሱሳ ታማረት እያኮ ይድ፥ “ፓስካ ቦንችያ ጋላስ ኔኒ ማና ካ ኑኒ አዉን ጊግስኖ?” ያግዶሶና።<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>የሱሲ ኤንታኮ፥ “ካታማን ደእያ አድያኮ ብድ፥ ‘አስታማረይ፥ ታዉ ዎደይ ጋክዳ ግሾ፥ ታ ታማረታራ ፓስካ ቦንችያ ጋላሳ ነ ሶን አና ያጌስ’ ያግተ” ያግስ።<verse eid="MAT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19"/>እያ ታማረት የሱሲ ባንታና ኪትዳይሳዳ ኦድ፥ ፓስካ ባኣለ ጋላስ ማና ካ ጊግስዶሶና።<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>ሳአይ ኦማርስያ ዎደ፥ የሱሲ ታማነ ናምኡ ሀዋረታራ ካ ማናዉ ኡትስ። <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>ኤንቲ ምሽን፥ የሱሲ ኤንታኮ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተፈ እስ ኡራይ ታና አድ እማና” ያግስ።<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>ኤንቲ ዳሮ ዳጋምድ፥ እሶይ እሶይ፥ “ጎዳዉ፥ ቱማ ታነሻ?” ግድ እያ ኦይችዶሶና።<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>የሱሲ ዛሪድ፥ “ባ ኩሽያ ታራ እስፈ ሻትያን የደይስ እ ታና አድ እማና።<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ 41:9</ref>.</char></note> <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>አሳ ናአይ፥ ፆሳ ቃላን እያዉ ፃፈትዳይሳዳ ሀይቃና። ሽን አሳ ናኣ አድ እምያ ኡራ አየ! ሄ ኡራይ የለቶና አትዳኮ እያዉ ሎኦሽን” ያግስ።<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>እያ አድ እማናዉ ደእያ ይሁድ ዛሪድ፥ “አስታማርያዉ፥ ኔኒ ገይ ታነዬ?” ያግስ።</para>
  <para style="p" vid="MAT 26:25">የሱሲ ዛሪድ፥ “ኔኒ ነ ሁጰን ጋዳሳ” ያግስ።<verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>ኤንቲ ምሽን፥ የሱሲ ኡይ ኤክድ ፆሳ ጋላትስ። ሄ ኡይ መንድ ባ ታማረታስ እምድ፥ “ሄእተ፥ ሚተ፥ ሀይስ ታ አሹዋ” ያግስ።<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>ፁኣ ኤክድ፥ ፆሳ ጋላትስ። ኤንታዉ እምድ፥ “ኡባይ ሀይሳፈ ኡይተ። <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>ሀይስ ዳሮ አሳ ናጋራ አቶተስ መላ ጉክያ ታ ሱ። ሀ ሱይ ፆሳይ ህንተራ ገልያ ጫቁዋ ምንይሳ።<note caller="-" style="x"><char style="xo" closed="false">26:28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ከሳ 24:8</ref>፤ <ref loc="JER 31:31">ኤርም 31:31</ref>.</char></note> <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>ሽን ታኒ ህንተዉ ኦዳይስ፤ ታኒ ታ አዋ ካዎተን ኦራ ዎይነ ኡሻ ህንተራ ኡያና ጋላሳ ጋካናዉ ናምአን ሀ ዎይነ ኡሻ ኡይከ” ያግስ።<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>ጋላታ ማዝሙረ የፅዳፐ ጉየ፥ ሻማሆ ዙማ ብዶሶና።<verse eid="MAT 26:30"/></para>
  <para style="s1">ጰፅሮስ የሱሳ ካዳናይስ ኦደትስ</para>
  <para style="r">(<ref loc="MRK 14:27-31">ማር 14:27-31</ref>፤ <ref loc="LUK 22:31-34">ሉቃ 22:31-34</ref>፤ <ref loc="JHN 13:36-38">ዮሀ 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>ሄ ዎደ የሱሲ ኤንታኮ፥</para>
  <para style="q1" vid="MAT 26:31">“ ‘ፆሳይ ሄንንቹዋ ሾጫና</para>
  <para style="q2" vid="MAT 26:31">ዶርሳትካ ላለታና’</para>
  <para style="m" vid="MAT 26:31">ጌተትድ ፆሳ ቃላን ፃፈትዳይሳ መላ ሀች ቃማ ህንተ ኡባይ ታና አግድ ባቃታና።<note caller="-" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዛካ 13:7</ref>.</char></note> <verse eid="MAT 26:31"/><verse number="32" style="v" sid="MAT 26:32"/>ሽን ታኒ ሀይቆፐ ደንድዳፐ ጉየ ህንተፈ ስንታዳ ጋልላ ባና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">26:32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቶ 28:16</ref>.</char></note><verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>ጰፅሮስ ዛሪድ፥ “ኤንቲ ኡባይ ነና አግድ ባቃትኮካ፥ ታኒ ነና አግከ” ያግስ።<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>የሱሲ ጰፅሮሳኮ፥ “ታኒ ነዉ ቱማ ኦዳይስ፤ ሀች ቃማ ኩቶይ ዋሳናፐ ስን ኔኒ ታና ሄ ቶሆ ካዳና” ያግስ።<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>ጰፅሮስ ዛሪድ፥ “ታኒ ኔራ እስፈ ሀይቆፐ አትሽን፥ ነና ኡባካ ካድከ” ያግስ።</para>
  <para style="p" vid="MAT 26:35">ሀንኮ እያ ታማረት ኡባይካ ሄሳዳ ግዶሶና።<verse eid="MAT 26:35"/></para>
  <para style="s1">የሱሲ ጌታሳማነን ዎስስ</para>
  <para style="r">(<ref loc="MRK 14:32-42">ማር 14:32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>ያትድ፥ የሱሲ ባ ታማረታራ ጌታሰማነ ጌተትያ በሳ ብድ፥ ኤንታኮ፥ “ታኒ ህን ባዳ ፆሳ ዎሳሻና፥ ህንተ ሀይሳን ኡትተ” ያግስ። <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>ጰፅሮሳነ ዛብድዮሳ ናይታ ናምአታ ባራ ኤክ ብድ ዳሮ አዛኖነ ኡንኤተ ዶምስ። <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>ቃስካ ኤንታኮ፥ “ታኒ ሀይቆስ ጋያ ኡንአ ኡንኤታስ። ሀይሳን ታራ ጋምእተነ ምንድ ናግተ” ያግስ።<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>ጉ ስን ብድ ቢታን ጉፋንድ፥ “ታ አዋዉ፥ ዳንዳኤትያባ ግድኮ ሀ ዋየ ፁኣ ታፐ ድጋ። ሽን ነ ሸነይ ሀኖፐ አትሽን፥ ታ ሸነይ ሀኖፖ” ያግድ ፆሳ ዎስስ።<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>የሱሲ ባ ታማረታኮ ስም ይድ ኤንቲ ስክዳሽን ደምስ። ጰፅሮሳኮ፥ “ህንተ እስ ሳተኮካ ስኮና ታራ ምናናዉ ዳንዳእቤከቲ? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>ፓጨን ህንተ ገሎና መላ ባርክድ ናግተነ ፆሳ ዎስተ። ህንተዉ ሎኦ አሞይ ደኤስ፥ ሽን ህንተ ዳቡራንቾ አስ” ያግስ።<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>የሱሲ ቃስ ናምአን ብድ፥ “ታ አዋዉ፥ ታኒ ሀ ዋየ ፁአፐ ኡዮና ደእሸ አናዉ ዳንዳኤቶናባ ግድኮ ነ ሸነይ ሀኖ” ያግድ ፆሳ ዎስስ። <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>ቃስካ ስም ያ ዎደ እያ ታማረታ አይፍያ ስኮይ ጎዝን፥ ዝንእዳሽን ደምስ።<verse eid="MAT 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44"/>ቃስካ ኤንታ አግድ፥ ብድ ካሰ ቃላ ዛር ሄን ዎስስ። <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>ሄሳፈ ጉየ፥ ባ ታማረታኮ ይድ፥ “ሀእ ጋካናዉ ስከትነ ሸምፐቲ? ሄኮ፥ አሳ ናእ፥ ናጋራንቾታ ኩሸን አድ እመትያ ሳተይ ጋክስ። <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>ደንድድ የተ፥ ታና አድ እመይስ ሀይስሽ ጋክስ” ያግስ።<verse eid="MAT 26:46"/></para>
  <para style="s1">የሱሲ ኦይከትስ</para>
  <para style="r">(<ref loc="MRK 14:43-50">ማር 14:43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ 22:47-53</ref>፤ <ref loc="JHN 18:3-12">ዮሀ 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>የሱሲ ቡሮ ሄሳ ሃሳይሽን፥ ታማነ ናምኡ ታማረታፐ እሶይ፥ ይሁድ ጋክ ዎስ። ካህነ ሀላቃትነ ደርያ ጭማት ኪትዳ ዳሮ አሳት ማሸነ ፃምአ ኦይክድ እያራ እስፈ ይዶሶና። <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>የሱሳ አድ እምያ ይሁድ ሄ ዳሮ አሳኮ፥ “ታኒ ዬረይስ ህንተ ኮየይስ እያ፥ እያ ኦይክተ” ያግድ ማላ እም ዎስ።<verse eid="MAT 26:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49"/>ኢራካ የሱሳኮ ሺቅድ፥ “አስታማርያዉ፥ ሳሮ ደአይ” ያግድ እያ ዬርስ።<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>የሱሲ እያኮ፥ “ታ ላግያዉ፥ ኔኒ ኦናባ ኦ አጋ”<note caller="+" style="f"><char style="fr" closed="false">26:50 </char><char style="ft" closed="false">ታ ላግያዉ፥ ኔኒ ኦናባ ኦ አጋ፦ ዎይኮ ሀራ ብርሸይ ታ ላግያዉ፥ ነ ሀይሳን አይ ኦይ?</char></note> ያግስ።</para>
  <para style="p" vid="MAT 26:50">ሄሳፈ ጉየ፥ ሺቅድ፥ የሱሳ ኦይክዶሶና። <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>የሱሳራ ደኤይሳታፐ እሶይ ባ ማሻ ሾድድ ካህነ ሀላቃ አይልያ ሾጭድ፥ እያ ሀይ ቃንፅድ የግስ። <verse eid="MAT 26:51"/><verse number="52" style="v" sid="MAT 26:52"/>ሽን የሱሲ፥ “ነ ማሻ ጉየ ሾሁዋን ዛራ። አይስ ጊኮ፥ ማሻ ሾድያ ኡባይ ማሻን ሀይቃና። <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>ታ፥ ታ አዋ ዎስያኮ ዳሮ ሙኩሉን ታይበትያ ኪታንቾታ የዳናዉ ዳንዳኦናባ ነዉ ዳኒ? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>ያትን፥ ፆሳ ቃላን ሄሳዳ ሀናናዉ በሴስ ጌተትዳይስ ዋንድ ፖለታኔ?” ያግስ።<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>ሄ ሳትያን፥ የሱሲ ሄ ሺቅዳ ዳሮ አሳኮ፥ “ታና ፓንጋ ኦድ ኦይካናዉ ማሻነ ፃምአ ኦይክድ ይደቲ? ታኒ ፆሳ ኬን ጋላስ ጋላስ ታማርሳሸ ህንተራ ደእያ ዎደ ታና ኦይክቤከታ።<note caller="-" style="x"><char style="xo" closed="false">26:55 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ 19:47</ref>፤ <ref loc="LUK 21:37">21:37</ref>.</char></note> <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>ሽን ሀይስ ኡባይ ሀንዳይስ ናበት ፆሳ ቃላን ፃፍዳይስ ፖለታና መላሳ” ያግስ።</para>
  <para style="p" vid="MAT 26:56">ሄ ዎደ እያ ታማረት ኡባይ እያ አግድ ባቃትዶሶና።<verse eid="MAT 26:56"/></para>
  <para style="s1">የሱሲ ፕርዳ ሻንጎ ስንን</para>
  <para style="r">(<ref loc="MRK 14:53-65">ማር 14:53-65</ref>፤ <ref loc="LUK 22:54-55">ሉቃ 22:54-55</ref>፥ <ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ዮሀ 18:13-14</ref>፥ <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>የሱሳ ኦይክዳይሳት ካህነ ሀላቃ ቃያፋኮ እያ ኤፍዶሶና። ያን ህገ አስታማረትነ ቢታ ጭማት ሺቅድ ደኦሶና። <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>ሽን ጰፅሮስ ካህነ ሀላቃ ዛባ ጋካናዉ ሃሆን እያ ካልስ። እያ ዉርሰይ ሻከታና ጋካናዉ ዛባ ገልድ ናገይሳታራ ኡትስ።<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>ካህነ ሀላቃትነ ሺቅዳ አሳ ኡባይ የሱሳ ዎናዉ እያ ቦላ ዎርዶ ማርካ ኮይዶሶና። <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>ዳሮት ይድ እያ ቦላ ዎርዶ ማርካ ማርካትዶሶና፥ ሽን አይኮካ ደምቦኮና። ጉየፐ ናምኡ አሳት ይድ፥ <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>“ሀ ኡራይ፥ ‘ታኒ ፆሳ ኬ ላላዳ ሄ ጋላሳን ዛራ ኬፃናዉ ዳንዳአይስ’ ያግስ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ዮሀ 2:19</ref>.</char></note><verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>ካህነታ ሀላቃይ ደንድ ኤቅድ የሱሳኮ፥ “ሀይሳቲ ነና ሞትያ ሞቱዋስ ኔኒ ዛርያባይ ባዌ?” ያግስ። <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>ሽን የሱሲ ስእ ግስ። ቃስካ ካህነ ሀላቃይ፥ “ታኒ ነና ደኦ ፆሳ ሱንን ኦይካይስ፤ ኔኒ ፆሳ ናኣ ክርስቶሳ ግድኮ ኑስ ኦዳ” ያግስ።<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>የሱሲ ዛሪድ፥ “ኔኒ ነ ሁጰንካ ጋዳሳ። ሽን ታኒ ህንተዉ ኦዳይስ፤ ህዛፐ ጉየ፥ አሳ ናአይ ዎልቃማ ፆሳ ኡሻቻ ባጋን ኡትዳሽን፥ ቃስ ሳሎ ሻራራ ይሽን ህንተ በአና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">26:64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳነ 7:13</ref>.</char></note><verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>ሄ ዎደ ካህነ ሀላቃይ ዳሮ ይሎትድ ባ ማኡዋ ፔድ፥ “ሀይሳ በእተ ፆሳ ጫይስ! ኑና ሀራ ማርካ አይ ኮሺ? እ ሀእ ጫይዳይሳ ህንተ ስእደታ።<note caller="-" style="x"><char style="xo" closed="false">26:65 </char><char style="xt" closed="false"><ref loc="LEV 24:15-16">ሌወ 24:15-16</ref>.</char></note> <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>ህንተ ቆፋይ አይቤ?” ያግስ።</para>
  <para style="p" vid="MAT 26:66">ኤንትካ፥ “እያዉ ሀይቆ በሴስ” ያግድ ዛርዶሶና።<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>ያትን፥ ኤንቲ እያ ሶምኦን ጩትድ ደችዶሶና። ሀራት እያ ባቅድ፥<note caller="-" style="x"><char style="xo" closed="false">26:67 </char><char style="xt" closed="false"><ref loc="ISA 50:6">እሳ 50:6</ref>.</char></note> <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>“ክርስቶሳ! ነና ደችዳይ ኦኔ? አነ ኑስ ኦዳ” ያግዶሶና።<verse eid="MAT 26:68"/></para>
  <para style="s1">ጰፅሮስ የሱሳ ካድስ</para>
  <para style="r">(<ref loc="MRK 14:66-72">ማር 14:66-72</ref>፤ <ref loc="LUK 22:56-62">ሉቃ 22:56-62</ref>፤ <ref loc="JHN 18:15-18">ዮሀ 18:15-18</ref>፥ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>ጰፅሮስ ዛባን ኡትዳሽን፥ እስ አይልያ እያኮ ያዳ፥ “ኔንካ ጋልላ የሱሳራ እስፈ ደኣሳ” ያጋሱ።<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>ሽን እ ኤንታ ኡባ ስንን ሄ አይለኮ፥ “ኔኒ ግያባይ አይበኮ ታኒ ኤርከ” ያግድ ካድስ።<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>ቃስ ብድ ድርሳ ፐንገኮ ጋክሽን ሀራ አይልያ እያ በአዳ፥ ያን ደእያ አሳኮ፥ “ሀ ኡራይ ናዝረተ የሱሳራ ደኤስ” ያጋሱ።<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>ጰፅሮስ ናምአን ጫቅድ፥ “ታኒ ሄ ኡራ ኤርከ!” ያግስ።<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>ጉ ጋምእሽን፥ ያን ኤቅዳ አሳት ጰፅሮሳኮ ይድ፥ “ነካ ቱማ ኤንታራ እስፈ ደኣሳ፤ ኔኒ ነ ኦዳን ኤረታሳ” ያግዶሶና።<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>ሄሳፈ ጉየ፥ ጰፅሮስ፥ “ታኒ ሄ ኡራ ኤርከ!” ያግድ፥ ባና ባደነ ጫቆ ዶምስ።</para>
  <para style="p" vid="MAT 26:74">ሄ ዎደ ኢራካ ኩቶይ ዋስ አግስ። <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>የሱሲ እያኮ፥ “ኔኒ ኩቶይ ዋሳናፐ ስን ታና ሄ ቶሆ ካዳና” ግዳይሳ ጰፅሮስ አኬክድ፥ ካረ ከይድ ኢታ ዬሆ ዬክስ።<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">ይሁድ ሱለትድ ሀይቅስ</para>
  <para style="r">(<ref loc="MRK 15:1">ማር 15:1</ref>፤ <ref loc="LUK 23:1-3">ሉቃ 23:1-3</ref>፤ <ref loc="JHN 18:28-32">ዮሀ 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>ዎንታ ጉራ ካህነ ሀላቃትነ ቢታ ጭማት ኡባይ የሱሳ ዎሳናዉ ማቀትዶሶና። <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>ኤንቲ የሱሳ ቃች ኤፍድ ደርያ ሃርያ ጵላፆሳስ አድ እምዶሶና።<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>ሄ ዎደ የሱሳ ኦይዳ ይሁድ፥ ጵላፆስ የሱሳ ቦላ ፕርድዳይሳ በእድ፥ ቂሮትድ፥ ሄ ሀስታሙ ብራ ሳንትመ ካህነ ሀላቃታስነ ደርያ ጭማታስ ጉየ ዛርስ።<note caller="-" style="x"><char style="xo" closed="false">27:3 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">ሀዋ 1:18-19</ref>.</char></note> <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>“ታኒ ፅሎ አስ ሀይቆስ አ እማዳ ናጋራ ኦስ” ያግስ።</para>
  <para style="p" vid="MAT 27:4">ሽን ኤንቲ፥ “ሄስ ኑ መቶ ግደና ነ መቶ” ያግዶሶና።<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>ይሁድ ሚሽያ ፆሳ ኬን የግ አግድ ኤንታ ማታፐ ብድ፥ ሱለትድ ሀይቅስ።<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>ካህነ ሀላቃት ሚሽያ ኤክድ፥ “ሀ ሚሸይ ሱ ሚሸ ግድያ ግሾ፥ ኑኒ ፆሳ ኬ ሚሽያራ ጋይስ ዎጋ ግደና” ያግዶሶና። <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>ሄሳፈ ጉየ፥ እስፈ ዞረትድ፥ በተ አስ ሞጋናዉ ማና ቢታ ሻምዶሶና። <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>ሄሳ ግሾ፥ ሄ ጋደይ ሀች ጋካናዉ ሱ ቢታ ጌተትድ ፄገቴስ።<verse eid="MAT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9"/>ናብያ ኤርምያስ፥ “እስራኤለ አሳይ እያዉ ቃንፃናዉ ጋማትዳ ሀስታሙ ብራ ሳንትመ ኤክዶሶና።<note caller="-" style="x"><char style="xo" closed="false">27:9 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">ዛካ 11:12-13</ref>.</char></note> <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>ጎዳይ ታና ኪትዳይሳዳ ማና ቢታ ሻማናዉ እምዶሶና” ግዳይስ ሄ ዎደ ፖለትስ።<verse eid="MAT 27:10"/></para>
  <para style="s1">የሱሲ ጵላፆሳ ስንን</para>
  <para style="r">(<ref loc="MRK 15:2-5">ማር 15:2-5</ref>፤ <ref loc="LUK 23:3-5">ሉቃ 23:3-5</ref>፤ <ref loc="JHN 18:33-38">ዮሀ 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>የሱሲ ደርያ ሃርያ ጵላፆሳ ስን ሺቅን፥ ጵላፆስ እያኮ፥ “ኔኒ አይሁደ ካዎ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="MAT 27:11">የሱሲ ዛሪድ፥ “ነ ጋዳሳ” ያግስ።<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>ካህነ ሀላቃትነ ቢታ ጭማት እያ ሞትያ ዎደ ኤንታዉ አይብ ዛሮካ እምቤና።<verse eid="MAT 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13"/>ሄ ዎደ ጵላፆስ የሱሳኮ፥ “ሀይሳቲ ነና ሞትያ ሞቱዋ ኡባ ስእኪ?” ያግስ።<verse eid="MAT 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14"/>የሱሲ ሀር አቶሽን፥ እስ ቃላካ ዛሮና እፅን፥ ደርያ ሃረይስ ዳሮ ማላለትስ።<verse eid="MAT 27:14"/></para>
  <para style="s1">የሱሲ ሀይቆ ፕርደትስ</para>
  <para style="r">(<ref loc="MRK 15:6-15">ማር 15:6-15</ref>፤ <ref loc="LUK 23:13-25">ሉቃ 23:13-25</ref>፤ <ref loc="JHN 18:39-40">ዮሀ 18:39-40</ref>፤ <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>ደርያ ሃረይስ ላይን ላይን ፓስካ ባኣለ ቦንችያ ጋላሳን፥ አሳይ ኮይያ እስ አስ ቃሾፐ ብርሽያ ዎግ ደኤስ። <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>ሄ ዎደ እስ ባርባና የሱሳ ጌተትያ ዳሮ ኤረትዳ ኢታ አስ ቃሾ ኬን ደኤስ። <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>ሄሳ ግሾ፥ ዳሮ አሳይ ሺቅድ ደእሽን ጵላፆስ፥ “ታኒ ህንተዉ ባርባና ብሎየ ዎይኮ የሱሳ ጌተትያ ክርስቶሳ ብሎ?” ያግድ አሳ ኦይችስ። <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>እ ሄሳ ግዳይ ኤንቲ ቃናትድ የሱሳ ኦይዳይሳ ኤርያ ግሾሳ።<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>ጵላፆስ ፕርዳ ኬን ኡትዳሽን፥ እያ ማችያ፥ “ታኒ ሀች ቃማ አሙሆን እያባ ዳሮ ዋየታሸ አቅዳ ግሾ፥ ሄ ፅሎ ኡራ ቦላ አይብባካ ኦፋ” ያጋዳ ኪታሱ።<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>ሄ ዎደ ካህነ ሀላቃት፥ “ባርባን ብለቶ፥ የሱሲ ሀይቆ” ግድ ጵላፆሳ ዎሳና መላ አሳ ጭምዶሶና።<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>ጵላፆስ ዛሪድ፥ “ታኒ ኤንታ ናምኣፈ ህንተዉ ኦና ብላና መላ ኮዬቲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="MAT 27:21">ኤንቲ፥ “ባርባና ብላና መላ ኮዮስ” ያግዶሶና።<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>ጵላፆስ፥ “ያትን፥ የሱሳ ጌተትያ ክርስቶሳ ዋቶ?” ያግድ ኤንታ ኦይችስ።</para>
  <para style="p" vid="MAT 27:22">ኡባይ ዛሪድ፥ “ማስቃልያ ቦላ እያ ካቃ” ያግዶሶና።<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>ጵላፆስ አሳኮ፥ “አይስ? እ አይ ኢታባ ኦዴ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="MAT 27:23">ሽን አሳይ ካሰይሳፈ አድ፥ “ማስቃልያ ቦላ እያ ካቃ” ግድ ዋስዶሶና።<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>ኦሽ ደንፈ ሀራ አይብባካ ኦናዉ ዳንዳኤቶናይሳ ጵላፆስ በእድ፥ ሃ ኤክድ፥ “ሀ ኡራ ሀይቁዋን ታኒ ደእከ። ሄሳ ኦይ ህንተና” ያግድ አሳ ስንን ባ ኩሽያ ሜጨትስ።<note caller="-" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="DEU 21:6">ዛረ 21:6</ref>.</char></note><verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>አሳ ኡባይ ዛሪድ፥ “እያ ሱ ጎመይ ኑናነ ኑ ናይታ ጋኮ” ያግዶሶና።<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>ያትን፥ ጵላፆስ ባርባና ኤንታዉ ብልድ፥ የሱሳ ልሶን ጋራፍድ፥ ማስቃልያ ቦላ ካቀትድ ሀይቃና መላ ኤንታዉ አድ እሚስ።<verse eid="MAT 27:26"/></para>
  <para style="s1">የሱሳ ቦላ ቀልቅስዶሶና</para>
  <para style="r">(<ref loc="MRK 15:16-20">ማር 15:16-20</ref>፤ <ref loc="JHN 19:2-3">ዮሀ 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>ሄሳፈ ጉየ፥ ጵላፆሳ ዎታዳረት የሱሳ ደርያ ሃረይሳ ሶ ኤክ ኤፍን፥ ዎታዳረት ኡባይ እያ ዩሹዋን ኤቅዶሶና። <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>እያ አፍላ ቃር ኤክድ ዞኦ አፍላ<note caller="+" style="f"><char style="fr" closed="false">27:28 </char><char style="fq" closed="false">ዞኦ አፍላ፦ </char><char style="ft" closed="false">በን ዎደ ካዎት ቦላራ ማእያ አፍላ።</char></note> ማይዝዶሶና። <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>ቃስ አጉን ካላቻ ጊግስድ፥ እያ ሁጰን ዎዶሶና። እያ ኡሻቻ ኩሽያን ማይረ ፃምአ ኦይድ፥ እያ ስንን ጉልባትድ፥ “አይሁደ ካዋዉ፥ ሙኩሉ ላይ ካዎታ!” ያግድ፥ እያ ቦላ ቀልቅስዶሶና። <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>እያ ቦላ ጩትዶሶና። ሄ ማይረ ፃምኣ ኤክድ፥ እያ ሁጰን ሾጭዶሶና። <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>ኤንቲ እያ ቦላ ቀልቅስዳፐ ጉየ፥ ዞኦ አፍላ እያፐ ቃር ኤክድ፥ እያ አፍላ እያ ማይዝዶሶና። ማስቃልያ ቦላ እያ ካቃናዉ ኤክ ኤፍዶሶና።<verse eid="MAT 27:31"/></para>
  <para style="s1">የሱሲ ካቀትስ</para>
  <para style="r">(<ref loc="MRK 15:21-32">ማር 15:21-32</ref>፤ <ref loc="LUK 23:25-43">ሉቃ 23:25-43</ref>፤ <ref loc="JHN 19:17-27">ዮሀ 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>ኤንቲ ካረ ከይድ፥ እስ ስሞና ጌተትያ ቀሬና ቢታ አስ ደምድ፥ የሱሳ ማስቃልያ ዎልቃን ቶስዶሶና። <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>ጎልጎታ ጌተትያ በሲ ጋክዶሶና። “ጎልጎታ” ጉሳይ “ጉገ በሲ” ጉሱ። <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>ሄሳን ኤንቲ ጪየ ዋላከትዳ ዎይነ ኡሻ ኡዮ ግድ እያዉ እምዶሶና። ሽን እ ሄሳ ጋንፅ ኤክድ፥ ኡዮና እፅስ።<note caller="-" style="x"><char style="xo" closed="false">27:34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ 69:21</ref>.</char></note><verse eid="MAT 27:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35"/>ኤንቲ ማስቃልያ ቦላ እያ ካቅዳይሳፈ ጉየ፥ እያ አፍላ ሻክድ፥ ሳማ የግድ ኤክዶሶና።<note caller="-" style="x"><char style="xo" closed="false">27:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ 22:18</ref>.</char></note> <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>ሄሳፈ ጉየ፥ ያን ኡትድ እያ ናግዶሶና። <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>ቃስ፥ “ሀይስ አይሁደ ካዋ የሱሳ” ግያ ሞቶ ፁፍያ እያ ሁጰ ሶን ዎዶሶና። <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>የሱሳራ ሄ ዎደ ናምኡ ፓንጋታ እሱዋ እያፐ ኡሻቻ ባጋን፥ ሀንኩዋ እያፐ ሀድርሳ ባጋራ፥ ማስቃልያ ቦላ ካቅዶሶና።<verse eid="MAT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39"/>ኦግያራ አያ አሳይ የሱሳ ቦርድ፥ እያ ቦላ ጩትሸ፥<note caller="-" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">ማዝ 22:7</ref>፤ <ref loc="PSA 109:25">109:25</ref>.</char></note> <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>“ፆሳ ኬ ላላዳ ሄ ጋላሳ ግዶን ኬፀይሶ፥ ነና አሻ። ኔኒ ፆሳ ናአ ግድኮ፥ አነ ማስቃልያ ቦላፈ ዎ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">ማቶ 26:61</ref>፤ <ref loc="JHN 2:19">ዮሀ 2:19</ref>.</char></note><verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>ሄሳዳካ፥ ካህነ ሀላቃት፥ ህገ አስታማረትነ ቢታ ጭማት እስፈ የሱሳ ቦላ ቀልቅስዶሶና። ሀይሳዳ ያግዶሶና፦ <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>“ሀራታ አሽስ፥ ሽን ባና አሻናዉ ዳንዳእቤና። እ እስራኤለ ካዎ ግድኮ፥ አነ ማስቃልያ ቦላፈ ሀእ ዎ፥ ኑካ እያ አማናና። <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>ፆሳን እ አማነቴስ፥ ፆሳይ እያ አሻናዉ ኮይኮ አነ አሾ። አይስ ጊኮ፥ እ ባና፥ ‘ታኒ ፆሳ ናአ’ ጌስ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">27:43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">ማዝ 22:8</ref>.</char></note><verse eid="MAT 27:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44"/>ቃስ ሀር አቶሽን፥ እያራ ማስቃልያ ቦላ ካቀትዳ ፓንጋትካ ሄሳዳ ግድ እያ ቦላ ቀልቅስዶሶና።<verse eid="MAT 27:44"/></para>
  <para style="s1">የሱሳ ሀይቁዋ</para>
  <para style="r">(<ref loc="MRK 15:33-41">ማር 15:33-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ 23:44-49</ref>፤ <ref loc="JHN 19:28-30">ዮሀ 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>ኡሱፑን ሳተፐ ብድ፥ ኡዱፉን ሳተ ጋካናዉ ቢታ ኡባይ ምስ። <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>ኡዱፉን ሳተ ግድያ ዎደ የሱሲ፥ “ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታኒ?” ግድ ግታ ዋሶ ዋስስ። “ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታኒ?” ገይሳ ብርሸይ “ታ ፆሳዉ፥ ታ ፆሳዉ፥ ታና አይስ አጋዲ?” ጉሱ።<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">ማዝ 22:1</ref>.</char></note><verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>ሄሳን ኤቅዳ አሳፐ እሶት እሶት ሄሳ ስእድ፥ “ሀ ኡራይ ኤልያሳ ፄጌስ” ያግዶሶና። <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/>ኢራ ኤንታፈ እሶይ ዎፅ ብድ፥ እስፖንጀ ኤክድ፥ ጫላ ዎይነ ኡሻ ኩንስ። ሄሳ ማይረ ፃምአ ፄራን ዎድ ኡሻናዉ እያ ዶናኮ ሺሽስ።<note caller="-" style="x"><char style="xo" closed="false">27:48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ 69:21</ref>.</char></note> <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>ሽን ሀንኮት፥ “ናጋ፥ ኤልያስ እያ አሻናዉ ያነኮ አነ በኦስ” ያግዶሶና። <verse eid="MAT 27:49"/><verse number="50" style="v" sid="MAT 27:50"/>የሱሲ ናምአን ግታ ዋሶ ዋስድ፥ ሀይቅ አግስ።<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>ሄ ሳተን ፆሳ ኬን ካቀትዳ ማጋራጆይ ቆሞፈ ዱገ ጋካናዉ ናምኡ ከይድ፥ ፔት ዎስ። ቢታይ ቃፅስ፥ ዛላይካ ጳልቀትስ።<note caller="-" style="x"><char style="xo" closed="false">27:51 </char><char style="xt" closed="false"><ref loc="EXO 26:31">ከሳ 26:31</ref>.</char></note> <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>ዱፎት ዶየትን ፆሳ አሳታፐ ዳሮት ሀይቆፐ ደንድዶሶና። <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>ኤንቲ ዱፎፐ ከይድ፥ የሱሲ ሀይቆፐ ደንድዳፐ ጉየ፥ ጌሻ ካታማ ብዶሶና፤ ያን ኤንቲ ዳሮ አሳስ በንትዶሶና።<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>ማቶ ሀላቃይነ እያራ የሱሳ ናግያ ዎታዳረት ቢታይ ቃፅዳይሳነ ሄሳን ሀንዳባ በእዳ ዎደ ዳሮ ያይድ “ቱማ ሀይስ ፆሳ ናኣ” ያግዶሶና።<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>ሄሳን ዳሮ ማጫሳት፥ ጋልላፐ ዶምድ የሱሳ ሀጋዝሸ ካልዳይሳት ሃሆን ኤቅድ ፄሎሶና።<note caller="-" style="x"><char style="xo" closed="false">27:55 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ 8:2-3</ref>.</char></note> <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>ኤንታ ግዶን ማግደላ ማይራማ፥<note caller="+" style="f"><char style="fr" closed="false">27:56 </char><char style="fqa" closed="false">ማግደላ ማይራሞ፦ </char><char style="ft" closed="false">ጉሳይ ማግደላ ካታማፐ ይዳ ማይራሞ ጉሱ።</char></note> ያይቆባነ ዮሰፋ አይያ ማይራማነ ዛብድዮሳ ማችያ ደኦሶና።<verse eid="MAT 27:56"/></para>
  <para style="s1">የሱሲ ሞገትስ</para>
  <para style="r">(<ref loc="MRK 15:42-47">ማር 15:42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ 23:50-56</ref>፤ <ref loc="JHN 19:38-42">ዮሀ 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>ሳአይ ኦማርስያ ዎደ ዮሰፋ ጌተትያ እስ ዱረ አደይ፥ አርማተ ካታማፐ ይስ። እ ባ ሁጰንካ የሱሳ ካልያ አስ። <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>ዮሰፍ ጵላፆሳኮ ብድ፥ የሱሳ አሀ ኤካናዉ ዎስስ። ጵላፆስ አሀይ ዮሰፋስ እመታና መላ ኪትስ። <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>የሱሳ አሀ ኤክድ፥ ጌሻ ሞጎ አፍላን ፃፅስ። <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>ባዉ ሞገታናዉ ሹቻፈ ዎጭዳ ኦራ ጎንጎሎን እያ አሀ ዎስ። ቃስ ሄ ጎንጎሉዋ ዶናን ግታ ሹቻ ጎንዶርስ ዎድ፥ አግድ ብስ። <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>ማግደላ ማይራማነ ሀንኮ ማይራማ ሄ ጎንጎሉዋኮ ስሚድ ኡትዶሶና።<verse eid="MAT 27:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>ዎንተ ሳምባታ ጋላስ፥ ካህነ ሀላቃትነ ፋርሳወት ጵላፆሳኮ ይድ፥ ሀይሳዳ ያግዶሶና፦ <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>“ጎዳዉ፥ ሀ ዎርዳንቾይ ፓፃ ደእሸ፥ ‘ታኒ ሄ ጋላሳፐ ጉየ፥ ሀይቆፐ ደንዳና’ ያግዳይስ ኑስ ሀሳየትስ።<note caller="-" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቶ 16:21</ref>፤ <ref loc="MAT 17:23">17:23</ref>፤ <ref loc="MAT 20:19">20:19</ref>፤ <ref loc="MRK 8:31">ማር 8:31</ref>፤ <ref loc="MRK 9:31">9:31</ref>፤ <ref loc="MRK 10:33">10:33</ref>.</char></note> <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>ሄሳ ግሾ፥ እ ሞገትዳ ጎንጎሉዋ ሄ ጋላስ ጋካናዉ፥ ምን ናጋና መላ ኪታርክ። ሄስ ሀኖና እፅኮ፥ እያ ታማረት ብድ እያ አሀ ካይስ ይስድ፥ ‘ሀይቆፐ ደንድስ’ ያግድ አሳስ ኦድኮ ናምአን ባለሶይ ኮይሮይሳፈ ኡባ ሃ ኢታና” ያግዶሶና።<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>ጵላፆስ ኤንታኮ፥ “ህንተዉ ናገይሳት ደኦሶና፤ ብድ ህንተዉ ዳንዳኤትዳ መላ ናግስተ” ያግስ።<verse eid="MAT 27:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66"/>ሄሳ ግሾ፥ ኤንቲ ብድ ዱፎይ ቦሸቶና መላ ሹቻ ቦላ ማታመ ዎድ ዎታዳረታን ናግስዶሶና።<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">የሱሲ ሀይቆፐ ደንዱዋ</para>
  <para style="r">(<ref loc="MRK 16:1-10">ማር 16:1-10</ref>፤ <ref loc="LUK 24:1-12">ሉቃ 24:1-12</ref>፤ <ref loc="JHN 20:1-10">ዮሀ 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>ሳምባት አን፥ ዎጋ ዎደ ዎንታ ጉራ፥ ማግደላ ማይራማነ ሀንኮ ማይራማ የሱሲ ሞገትዳ ጎንጎሉዋ በአናዉ ብዶሶና። <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>ቆፖና ዎልቃማ ቢታ ቃፆይ ሀንስ። ጎዳ ኪታንቾይ ሳሎፐ ዎድ ዱፉዋ ዶናን ደእያ ሹቻ ጎንዶርስድ እያ ቦላ ኡትስ። <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>እያ ማላይ ዎልአን ዳኔስ። እያ ማኦይካ ሻቻዳ ቦ። <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>ናገይሳት ኪታንቹዋ በእድ፥ ያሻን ኮኮርድ፥ ሀይቅዳ አሳዳ ሀንዶሶና።<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>ኪታንቾይ ማጫሳታኮ፥ “ህንተ ማስቃልያ ቦላ ካቀትዳ የሱሳ ኮየይሳ ታኒ ኤርያ ግሾ፥ ያዮፍተ። <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>እ ካሰ ኦድዳይሳ መላ ሀይቆፐ ደንድስ፤ ሀይሳን ዴና። ሃ ይድ እያ ዝንእስዳ በሳ በእተ። <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>ህንተ ሀእ ኤለስ ብድ፥ እያ ታማረታስ፥ ‘የሱሲ ሀይቆፐ ደንድስ። ቃስ እ ህንተፈ ስንትድ ጋልላ ባና፤ ህንተ እያ ያን በአና’ ያግድ ኦድተ። ታኒ ህንተዉ ሀይሳ ኦዳናዉ ያስ” ያግስ።<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>ኤንቲ ያይሸነ ዳሮ ኡፋይትሸ፥ ዱፉዋ ማታፐ ኤለስድ ብድ፥ እያ ታማረታስ ኦዳናዉ ዎፅዶሶና።<verse eid="MAT 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9"/>ቆፖና የሱሲ ኤንታራ ጋሄትድ ኤንታኮ፥ “ሳሮይ ህንተዉ ግዶ” ያግስ። ኤንቲ እያኮ ሺቅድ፥ እያ ቶሁዋ ኦይክድ እያዉ ጎይንዶሶና። <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>ሄ ዎደ የሱሲ ኤንታኮ፥ “ያዮፍተ፤ ብድ ታ ታማረት ጋልላ ባና መላ ኤንታዉ ኦድተ። ኤንቲ ያን ታና በአና” ያግስ።<verse eid="MAT 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>ሄ ማጫሳት ብሽን፥ ዱፉዋ ናግያ ዎታዳረታፐ ባጋት ካታማ ብድ፥ ሀንዳባ ኡባ ካህነ ሀላቃታስ ኦድዶሶና። <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>ካህነ ሀላቃትነ ጭማት ሺቅድ ዞረትድ፥ ዎታዳረታስ ዳሮ ሚሸ እምድ፥ <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>“ ‘ኑኒ ስክዳሽን እያ ታማረት ቃማ ይድ፥ እያ አሀ ካይስዶሶና’ ያግተ። <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>ሀ ኦዳ ደርያ ሃረይስ ስእኮ፥ ሄስ ህንተ ባላ ግዶናይሳ ኑኒ እያ ኦድ አማንና። ህንተና አይብካ ህርግሶፖ” ያግዶሶና።<verse eid="MAT 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15"/>ዎታዳረት ሚሽያ ኤክድ፥ ኪተትዳይሳዳ ኦዶሶና። ሀ ኦዳይ አይሁደ ማታን ሀች ጋካናዉ ኦደትሸ ደኤስ።<verse eid="MAT 28:15"/></para>
  <para style="s1">ግታ ኪታ</para>
  <para style="r">(<ref loc="MRK 16:14-18">ማር 16:14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ 24:36-49</ref>፤ <ref loc="JHN 20:19-23">ዮሀ 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ሀዋ 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>ታማነ እስ እያ ታማረት የሱሲ ባንታና ቢተ ግዳ ጋልላ ዙማ ቦላ ከይዶሶና።<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="MAT 26:32">ማቶ 26:32</ref>፤ <ref loc="MRK 14:28">ማር 14:28</ref>.</char></note> <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>ያን ኤንቲ እያ በእዳ ዎደ እያዉ ጎይንዶሶና፥ ሽን ኤንታፈ እሶት እሶት ስዶሶና።<verse eid="MAT 28:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18"/>የሱሲ ኤንታኮ ሺቅድ፥ “ሳሎንነ ሳአን ማት ኡባይ ታዉ እመትስ። <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>ህዛ፥ ህንተ ኡባ በሲ ብድ፥ አዋ፥ ናኣ፥ ጌሻ አያና ሱንን አሰ ኡባ ፃማቅድ ታና ካለይሳታ ኦተ።<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ሀዋ 1:8</ref>.</char></note> <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>ታኒ ህንተና ኪትዳባ ኡባ ኤንቲ ናጋና መላ ኤንታ ታማርስተ። ታኒ ዎድያ ዉርሰ ጋካናዉ ኡባ ዎደ ህንተራ ደአይስ” ያግስ።<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
