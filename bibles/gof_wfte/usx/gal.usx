<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ጋላትያ ኪታ</para>
  <para style="toc1">ጋላትያ ኪታ</para>
  <para style="toc3">ጋላ</para>
  <para style="toc2">ጋላትያ</para>
  <para style="mt1">ጳዉሎስ ጋላትያ አሳስ</para>
  <para style="mt2">ፃፍዳ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ጋላትያን ደእያ ዎሳ ኬስ ፃፈትዳ ኪታን፥ ጳዉሎስ ቱማ ሀዋረ ግደይሳነ እያ ኪታይካ ቱማ ግደይሳ፥ ባ ኪታ ናባብያ አሳይ አኬካና መላ ቆፍሴስ (<char style="xt"><ref loc="GAL 1:1-10">1:1-10</ref></char>)። እ ሄሳ ግዳይ፥ እስ እስ አሳይ “ጳዉሎስ ዎርዶ ሀዋረ ቃስ እያ ኪታይካ ዎርዶ” ግድ ኦደትያ ግሾሳ። ጳዉሎስ፥ አይሁደ ግዶና አሳስ ዎንገላ ሳባካና መላ ፄገትዳ ቱማ ሀዋረ (<char style="xt"><ref loc="GAL 1:18-2:10">1:18—2:10</ref></char>)።</para>
  <para style="ip">ኦንካ የሱሳ አማንዳ ዎደ ኦራ ደኦ ደምስ፤ ሄሳ ግሾ፥ ሙሰ ህገ ናጋናዉ ኮሸና። ጳዉሎስ፥ “አስ ፆሳ ስንን ፅላናዉ ዳንዳኤይ አማኖ ፃላላን” ያግድ ታማርስስ። ሽን ጉ ኢሰን፥ ጋላትያ ቢታን ደእያ ዎሳ ኬን፥ “አስ ፆሳ ስንን ፅላናዉ የሱሳ አማኖ ፃላላ ግዶናሽን፥ ሙሰ ህገካ ናጋናዉ ኮሼስ” ያግድ ጳዉሎሳ ትምርትያ ጳልቅያ አሳት ደንድዶሶና።</para>
  <para style="ip">ጳዉሎስ ጋላትያ ኪታ ፃፍዳይ፥ ሀ ዎርዶ ትምርትያን ጭመትዳ አሳ ቱማ አማኖኮነ አማኖ ደኦኮ ዛራናሳ። ጳዉሎስ የሱሳ ሀዋረ ግደይሳ ትላይድ ኦድስ። እያ ሀዋረ ኦድ ፄግዳይ አሰ ግዶናሽን፥ ፆሰ ግደይሳነ እ ኪተትዳይ አይሁደ ግዶና አሳስ ግደይሳ ቆንጭስድ ኦድስ።</para>
  <para style="ip">መርና ደኦ ኤካናዉ ቁልፐይ አማኖ ፃላላ። ሄሳስ ሌምሶ ግደይ፥ አብራሃመይ ፅልዳይ አማኖናፐ አትሽን፥ ኦሶን ዎይኮ ህገ ናጎን ግዶናይሳ ኤንታዉ ማርካ ኦድ እሜስ። አማኖይ እያዉ አይበኮ ጳዉሎስ ኦድሸ፥ “ታኒ ፆሳስ ዳና መላ ህገ ባጋራ ህገስ ሀይቃስ። ታኒ ክርስቶሳራ ማስቃልያ ቦላ ካቀታስ። ታኒ ህዛፐ ታዉ ደእከ፥ ሽን ክርስቶስ ታናን ደኤስ። ታኒ ሀእ ደእያ ደኡዋ፥ ታና ዶስድ ታ ግሾ ባና አድ እምዳ ፆሳ ናኣ አማናዳ ደአይስ” (<char style="xt"><ref loc="GAL 2:19-20">2:19-20</ref></char>)።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ገሎ ቆፋ (<char style="ior"><ref loc="GAL 1:1-10">1:1-10</ref></char>)</para>
  <para style="io1">ጳዉሎስ ሀዋረተስ ዶረትስ (<char style="ior"><ref loc="GAL 1:11-24">1:11-24</ref></char>)</para>
  <para style="io1">ጳዉሎስ ባ ኪታስ ሞተቴስ (<char style="ior"><ref loc="GAL 2:1-21">2:1-21</ref></char>)</para>
  <para style="io1">አቶተስ ኦገይ አማኖ ፃላላ (<char style="ior"><ref loc="GAL 3:1-4:31">3:1—4:31</ref></char>)</para>
  <para style="io1">ጌሻ አያናንነ ሲቆን ደእተ (<char style="ior"><ref loc="GAL 5:1-6:10">5:1—6:10</ref></char>)</para>
  <para style="io1">አኬክሶነ ሳሮ (<char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref></char>)</para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>አሳፐ ዎይኮ አሳ ባጋራ ግዶናሽን፥ የሱስ ክርስቶሳፐነ እያ ሀይቆፐ ደንዳ ፆሳ አዋፐ ሀዋረ ግዳና መላ ኪተትዳ ታ ጳዉሎስ፥ <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>ታራ ደእያ አማንያ እሻት ኡባይ፥ ጋላትያን ደእያ ዎሳ ኬታስ ኪትዳ ኪታ።<verse eid="GAL 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>ፆሳይ ኑ አዋይነ ኑ ጎዳ የሱስ ክርስቶሲ ህንተዉ አ ኬሀተነ ሳሮተ እሞ።<verse eid="GAL 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4"/>ሀ ኢታ ዎድያፐ ኑና አሻናዉ፥ ኑ ፆሳ፥ ኑ አዋ ሸነን ክርስቶስ ኑ ናጋራ ግሾ ባና አድ እሚስ። <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>ፆሳስ መርናፐ መርና ጋካናዉ ቦንቾይ ግዶ። አምንእ።<verse eid="GAL 1:5"/></para>
  <para style="s1">ቱማ ዎንገላይ እስኖ</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>ክርስቶሳ አ ኬሀተን ህንተና ፄግዳ ፆሳ አግድ፥ ሀራ ዎንገላኮ፥ ህንተ ኤለስድ፥ ዋንድ ስምዳኮ ታና ማላልሴስ። <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>ህንተና ባለናዉነ ክርስቶሳ ዎንገላ ዎብሳናዉ ኮይያ ጉ አሳት ደኦሶናፐ አትሽን፥ ቱማ ዎንገላይ እስኖ። <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>ሽን ኑና ግድን ዎይኮ ሳሎ ኪታንቾ ግድን ኑኒ ህንተዉ ኮይሮ ኦድዳ ዎንገላፐ ዱማትያ ሀራ ዎንገላ ህንተዉ ኦድያባ ግድኮ፥ እ ባደትዳባ ግዶ። <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>ሀይሳፈ ስን ኑኒ ግዳይሳዳ ሀእካ ዛራዳ ጋይስ። ህንተ ኤክዳ ዎንገላፐ ዱማትያ ዎንገላ ኦንካ ህንተዉ ኦድኮ ሄ ኡራይ ባደትዳባ ግዶ።<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>ያትን፥ ታና አስ ናሻና መላ ኮያናዬ? ዎይኮ ፆሲ ናሻና መላ ኮያይና? ዎይኮ ታ አሰ ኡፋይሳናዉ ኮያይና? ታ አሰ ኡፋይሳናዉ ኮያባ ግድኮ፥ ክርስቶሳ አይለ ግድከ።<verse eid="GAL 1:10"/></para>
  <para style="s1">ጳዉሎሳ ፄገተ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>ታ እሻቶ፥ ታ ህንተዉ ኦድዳ ዎንገላይ አሳፐ ግዶናይሳ ህንተ ኤራና መላ ታ ኮያይስ። <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>ታዉ ሀ ዎንገላ የሱሲ ክርስቶስ ቆንጭስስፐ አትሽን፥ አሳፐ ኤካብከ ዎይኮ አስ ታና ታማርስቤና።<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>ታ ካሰ አይሁደ አማኖን ደእያ ዎደ ዋና ደእዳኮ፥ ህንተ ስእደታ። ታ ዎሳ ኬ ቃይ ባይና ጎዳናዉነ ይሳናዉ ባፀታስ።<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሀዋ 8:3</ref>፤ <ref loc="ACT 22:4-5">22:4-5</ref>፤ <ref loc="ACT 26:9-11">26:9-11</ref>.</char></note> <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>አይሁደ አማኖ ናጎን፥ ታ ዎደን ደእያ አይሁደ እሻታፐ አይስ። ኑ አዋታ ዎጋስ አዳ ምሸታይስ።<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 22:3">ሀዋ 22:3</ref>.</char></note><verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>ሽን ታ ቡሮ ታ አየ ኡሎን ደእሽን ፆሳይ ታና ዶርስ፤ ባ አ ኬሀተን ታና ፄግስ።<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">ሀዋ 9:3-6</ref>፤ <ref loc="ACT 22:6-10">22:6-10</ref>፤ <ref loc="ACT 26:13-18">26:13-18</ref>.</char></note> <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>አይሁደ ግዶና አሳስ ዎንገላ ኦዳና መላ ፆሳይ ባ ናኣ ታዉ ቆንጭስዳ ዎደ ታ ኦደራካ ዞረታብከ። <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>ዎይኮ ታፐ ስን ሀዋረ ግድዳይሳታራ ጋሄታናዉ የሩሳላመ ባብከ። ሽን ታ ካሰታዳ አራበ ቢታ ባስ፤ ሄሳፈ ስማዳ ዳማስቆ ካታማ ያስ። <verse eid="GAL 1:17"/><verse number="18" style="v" sid="GAL 1:18"/>ሄ ላይፈ ጉየ፥ ጰፅሮሳራ ጋሄታናዉ የሩሳላመ ባዳ እያራ ታማነ እቻሹ ጋላስ ኡታስ።<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="ACT 9:26-30">ሀዋ 9:26-30</ref>.</char></note> <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>ሽን ጎዳ እሻ ያይቆባፐ አትሽን፥ ሀንኮ ሀዋረታ በአብከ።<verse eid="GAL 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20"/>ታ ህንተዉ ፃፍይዳይስ ዎርዶ ግዶናይሳ ፆሳ ስንን ህንተዉ ቆንጭሳይስ።<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>ሄሳፈ ጉየ፥ ታኒ ሶረ ቢታነ ክልቅያ ቢታ ባስ። <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>ይሁዳን ደእያ ዎሳ ኬ አሳይ ታና በእድ ኤርቦኮና። <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>ሽን ኤንቲ፥ “ካሰ ኑና ጎድያ ኡራይ፥ ሀእ ሄ እ ይሳናዉ ኮይያ አማኑዋባ ሳባኬስ” ያገይሳ ስእዶሶና። <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>ስእዳ ኡባይ ታ ጋሶን ፆሳ ጋላትዶሶና።<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s1">ሀዋረት ጳዉሎሳ ኤክዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>ታማነ ኦይዱ ላይፈ ጉየ፥ ባርናባሳራ ዛራዳ የሩሳላመ ባስ። ሄ ዎደ ትቶ ታራ ኤካዳ ባስ።<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="ACT 11:30">ሀዋ 11:30</ref>፤ <ref loc="ACT 15:2">15:2</ref>.</char></note> <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>ፆሳይ ታዉ ቆንጭስዳ ቆንጨን ያ ባዳ አይሁደ ግዶና አሳ ግዶን ታ ሳባክያ ዎንገላ ኤንታዉ ቆንጭሳስ። ካሰ ታ ዎፅዳ ዎይነ ሀእካ ታ ዎፅያ ዎይ ሀዳ ግዶና መላ ጋዳ ካለይሳታ ዱማ ሺሻዳ ኤንታዉ ኦዳስ። <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>ሀር አቶሽን፥ ታራ ደእያ ትቶይ ግርከ አስ ግድኮካ፥ ቃፃረቶ ግድ ኡንኤቦኮና። <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>ግዶሽን፥ አማንያ እሻታ ዳንድ ኑ ግዶ ገልዳ እሶት እሶት እ ቃፃረታና መላ ኮይዶሶና። ሄ አሳት ክርስቶስ የሱሳን ኑስ ደእያ ላአተ ዎችድ በአናዉ ጌማን ኑ ግዶ ገልድ ዛሪድ ኑና አይለ ኦናዉ ኮዮሶና። <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>ሽን ቱማ ዎንገላይ ህንተናን ምንድ ዳና መላ ኑኒ ሀር አቶሽን፥ ጉ ዎደስካ ኤንታዉ ኩሸ እምቦኮ።<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>ሽን ሀላቃ ዳንያ አሳታ ኦናተይ ታዉ አይኮካ ግደና። ፆሳይ አሳ ሶምኦ በእድ ፕርደና። ሀ አሳት ታ ማርካትያ ዎንገላ ቦላ ጉጅዳባይ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ዛረ 10:17</ref>.</char></note> <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>ሽን ጰፅሮስ፥ አይሁደታስ ዎንገላ ኦዳና መላ ፆሳይ እያዉ ሀዳራ እምዳይሳዳ ታዉካ አይሁደ ግዶና አሳስ ዎንገላ ኦድያ ሀዳራ እምዳይሳ ኤንቲ ጉየፐ በእዶሶና። <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>ህዛ፥ ጰፅሮስ አይሁደታ ሀዋረ ግዳና መላ ኦዳ ፆሳይ፥ ታካ አይሁደ ግዶና አሳስ ሀዋረ ግዳና መላ ኦስ። <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>ቃስ ቱሱ ዳንድ በንትያ ያይቆብ፥ ጰፅሮስነ ዮሃንስ፥ ታዉ እመትዳ አ ኬሀተ በእዳ ዎደ ኑራ እስፍዳይሳ ቆንጭሳናዉ ታ ኩሽያነ ባርናባሳ ኩሽያ ኦይክዶሶና። ኑኒ አይሁደ ግዶና አሳኮ፥ ቃስ ኤንቲ አይሁደ አሳኮ ባናዉ ጊግዶሶና። <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>ኤንቲ ኑና ምንድ ሀዳራ ግዳይ፥ ኑኒ ማንቆታስ ቆፓናይሳ። ካሰካ ታ ሄሳ ኦናዉ አሞታይስ።<verse eid="GAL 2:10"/></para>
  <para style="s1">ጳዉሎስ ጰፅሮሳ ትምርትያ ጳልቅስ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>ጰፅሮስ አንፆከ ካታማ ይዳ ዎደ እ ባልዳ ግሾ ታኒ እያ ሶምኦን “ኔኒ ባላዳሳ” ጋስ። <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>ያይቆብ ኪትዳ ጉ አሳይ ያናፐ ስን እ አይሁደ ግዶና አሳራ ሜስ፥ ሽን ኤንቲ ይዳፐ ጉየ፥ “አይሁደ ግዶና አሳፐ አማንዳይሳት ቃፃረታናዉ በሴስ” ግያ አሳስ ያይድ ኤንታፈ ሻከትስ። <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>ቃስ ሀንኮ አማንዳ አይሁደት ጰፅሮሳ ሀኑዋ ካልዶሶና። ሀር አቶሽን፥ ባርናባስካ እያ ቆፋን ጎሸትስ።<verse eid="GAL 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14"/>ሽን ኤንቲ ዎንገላ ቱማተን ሱረ ሄመቶናይሳ በአዳ፥ ጰፅሮሳ አሳ ኡባ ስንን፥ “ኔኒ አይሁደ ግዳሸ፥ አይሁደ ዎጋ ግዶናሽን፥ አይሁደ ግዶና አሳዳ ደኣሳ፤ ያትን፥ ዋናዳ አይሁደ ግዶናይሳታ፥ ‘አይሁደ ዎጋን ደእተ ጋዳ ዎልቃታይ?’ ” ያጋስ።<verse eid="GAL 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>ኑኒ የለታን አይሁደ፥ ሽን ናጋራንቾ ግድዳ አይሁደ ግዶና አሳ መላ ግዶኮ። <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>ሽን አስ የሱስ ክርስቶሳ አማንድ ፅሌስፐ አትሽን፥ ህገ ናግድ ፅሎናይሳ ኤሮስ። ኦንካ ህገ ናግድ ፅሎና ግሾ፥ ኑካ ህገ ናግድ ግዶናሽን፥ ክርስቶሳን አማንድ ፅላና መላ ክርስቶስ የሱሳ አማንዳ።<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="PSA 143:2">ማዝ 143:2</ref>፤ <ref loc="ROM 3:20">ሮመ 3:20</ref>፥ <ref loc="ROM 3:22">22</ref>.</char></note><verse eid="GAL 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17"/>ኑ አይሁደትካ ክርስቶሳ ባጋራ ፅላናዉ ኮሼስ። ሄሳ ግድኮ ኑካ ሀራ አሳዳ ናጋራንቾ ግደይሳ በኦስ። ያትን፥ ኑ ናጋራ ኦና መላ ደንይ ክርስቶሳ ጉሰዬ? ኡባካ ግደና! <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>ህዛ፥ ታ ላልዳይሳ ዛራዳ ኬፅያባ ግድኮ ታኒ ታ ሁጰን ህገ መንይሳ ግደይሳ ቆንጭሳይስ። <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>ታኒ ፆሳስ ዳና መላ ህገ ባጋራ ህገስ ሀይቃስ። <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>ታኒ ክርስቶሳራ ማስቃልያ ቦላ ካቀታስ። ታኒ ህዛፐ ታዉ ደእከ፥ ሽን ክርስቶስ ታናን ደኤስ። ታ ሀእ ደእያ ደኦይ፥ ታና ዶስድ ታ ግሾ ባና አድ እምዳ ፆሳ ናኣ አማናዳ ደአይስ። <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>ታኒ ፆሳ አ ኬሀተ ሀዳ ኦከ። ፅሎተ አሳስ ህገ ባጋራ በንትያባ ግድያኮ፥ ክርስቶስ ጮ ሀይቅስ ጉሱ።<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s1">ፅሎተ አማኖና</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>ህንተኖ፥ አኬክ ባይና ጋላትያ አሳቶ፥ ህንተ አይፍያ ስንን ክርስቶስ ማስቃለ ቦላ ካቀትዳ ምስለዳ ቆንጭድ በንቴስ። ያትን፥ ቱማስ ህንተ ኪተቶና መላ ህንተና ብትዳይ ኦኔ?<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="DEU 27:26">ዛረ 27:26</ref>.</char></note> <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>ታ እስባ ኤራናዉ ኮያይስ፤ ህንተ ጌሻ አያና ኤክዳይ ህገ ናግድየ ዎይኮ ህንተ ስእዳ ዎንገላ አማንድ ኤክደቲ? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>ህንተ ሄሳ መላ ኤዬ? ህንተ ፆሳ አያናን ዶምድ፥ ሀእ ዎልቃን ፖላናዉ ኮዬቲ? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>ህንተ ዎንገላ ጋሶን ዳሮ ዋየትዳይ መሌ? ሄ ዋየ ኡባይ ጮ ግድዴ? <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>ፆሳይ ህንተዉ ጌሻ አያና እመይነ ህንተ ግዶን ማላታታ ኦይ፥ ህንተ ህገ ናግዳ ግሾየ ዎይኮ ዎንገላ ስእድ አማንዳ ግሾ?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>አነ አብራሃመ በእተ፥ “እ ፆሳ አማንስ፤ ፆሳይ እያዉ ሄሳ ፅሎተ ኦድ ኤክስ”<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 15:6">መ 15:6</ref>፤ <ref loc="ROM 4:3">ሮመ 4:3</ref>.</char></note> ጌተትድ ፃፈትስ። <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>ህዛ፥ አማነይሳት አብራሃመ ናይታ ግደይሳ ኤርተ።<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 4:16">ሮመ 4:16</ref>.</char></note> <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>ፆሳይ አይሁደ ግዶና አሳ አማኖን ፅልሳናይሳ ጌሻ ማፃፋይ በእድ፥ “ካዎተ ኡባይ ነናን አንጀታና” ያግድ፥ ዎንገላ አብራሃመስ ካሰትድ ኦድስ።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="GEN 12:3">መ 12:3</ref>.</char></note> <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>ሄሳ ግሾ፥ አማንያ ኡባይ አማንዳ አብራሃመራ እስፈ አንጀትዶሶና።<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>ህገ ናግድ ፅላና ግያ ኦንካ ባደትዳይሳ። አይስ ጊኮ፥ ጌሻ ማፃፋን፥ “ህገ ማፃፋን ፃፈትዳ ኡባ ናጎና ኦንካ ባደትዳይሳ ግዶ” ጌተትድ ፃፈትስ።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="DEU 27:26">ዛረ 27:26</ref>.</char></note> <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>“ፅሎይ አማኖን ዳና” ጌተትድ ፃፈትዳ ግሾ፥ ኦንካ ፆሳ ስንን ህገ ናግድ ፅሎናይስ ኤረትዳባ።<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="HEB 2:4">እብራ 2:4</ref>.</char></note> <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>ህገይ አማኖን ዘምፐና። ሽን፥ “ህግያ ናግያ ኦንካ ህግያን ደኦን ዳና” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ሌወ 18:5</ref>.</char></note><verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>“ም ቦላ ካቀትድ ሀይቅያ ኦንካ ባደትዳይሳ” ጌተትድ ፃፈትዳ ግሾ፥ ክርስቶስ ኑ ግሾ ባደትዳይሳ ግድድ፥ ኑና ህገ ባደፈ ዎዝስ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="DEU 21:23">ዛረ 21:23</ref>.</char></note> <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>ፆሳይ አብራሃመስ እምዳ አንጆይ፥ የሱስ ክርስቶሳ ባጋራ አይሁደ ግዶና አሳ ጋካና መላነ ፆሳይ እማና ግዳ ጌሻ አያና ኑኒ አማኖን ኤካና መላ ሄሳ ኦስ።<verse eid="GAL 3:14"/></para>
  <para style="s1">ህገነ ኡፋይሳ ቃላ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>ታ እሻቶ፥ ታ ህንተዉ አሳ ደኦን ሜዘ ግድድ ደእያባ ሌምሶ ኦዳ ኦዳይስ። አስ ጫቅዳ ጫቆይ ምንዳፐ ጉየ፥ ኦንካ ሄ ጫቁዋ ሻራናዉ ዎይኮ እያ ቦላ ሀራ ጉጃናዉ ዳንዳኤና። <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>ፆሳይ ሄ ኬከ ቃላ አብራሃመስነ እያ ዘረስ እሚስ። ጌሻ ማፃፋይ፥ ዳሮ አሳስ ኦድያዳ፥ “ነ ዘረታስ” ጌና። ሽን እስ አሳስ ኦድያዳ፥ “ነ ዘረስ” ያጌስ፤ እካ ክርስቶሳ።<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="GEN 12:7">መ 12:7</ref>.</char></note><verse eid="GAL 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 3:17"/>ታኒ ገይ ሀይሳ፤ ኦይዱ ፄታነ ሀስታሙ ላይፈ ጉየ እመትዳ ህገይ፥ ኮይሮ ፆሳይ ምንዳ ጫቁዋ ሻርድ ኡፋይሳ ቃላ ይሳናዉ ዳንዳኤና።<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="EXO 12:40">ከሳ 12:40</ref>.</char></note> <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>ፆሳይ እምያ ላታይ ህገን ኤከትያባ ግድያኮ ፆሳይ እምዳ ኡፋይሳ ባጋራ ግደይስ አቴስ። ሽን ፆሳይ ባ አ ኬሀተን ላታ አብራሃመስ ኡፋይሳ ቃላ ባጋራ እሚስ።<note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ROM 4:14">ሮመ 4:14</ref>.</char></note><verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>ያትን፥ ህገይ አይስ እመትዴ? ህገይ እመትዳይ፥ አብራሃመስ ኡፋይሳ ቃል እመትዳ ኮቻይ ያና ጋካናዉ ኢታ ኦሶይ አይበኮ ኤርሳናሳ። ህገይ ኪታንቾታ ባጋራ እመትድ፥ ግዶ ግድድ ስገያ እስ አሳ ባጋራ ኦሶ ቦላ ፔእስ። <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>ግዶ ግድድ ስገያ ኡራይ እስ አሳ ፃላላስ ግደና፥ ሽን ፆሳይ እስኖ።<verse eid="GAL 3:20"/></para>
  <para style="s1">አይለታነ ናይታ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>ያትን፥ ህገይ ፆሳ ኡፋይሳ ቃላራ ኤቀትዬ? አካይ፥ ግደና! ህገይ እመትዳይ አሳስ ደኦ እማናዉ ግድያኮ፥ ፅሎተ ህገ ባጋራ በንታናሽን። <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>ሽን የሱስ ክርስቶሳ አማንን በንትያ ኡፋይሳ ቃላይ አማነይሳታስ እመታና መላ ኩመ አላመይ ናጋራስ ሃረትድ ደኤይሳ ጌሻ ማፃፋይ ኦዴስ።<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>ሽን አማኖይ ያናፐ ካሰ ህገይ ኑና ቃች ዎስ። ሄ አማኖይ ቆንጫና ጋካናዉ ህገይ ኑ ቦላ ጎርድ ዎስ። <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>ሄሳ ግሾ፥ ኑኒ አማኖን ፅላና መላ ክርስቶስ ያና ጋካናዉ ህገይ ናአ ናግያ አሳ መላ ኑና ናገይሳ ግድስ። <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>ሽን ሀእ አማኖይ ይዳ ግሾ፥ ህገይ ህዛፐ ጉየ ናአ ናግያ አሳ መላ ኑና ናገይስ አትስ።<verse eid="GAL 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>ህንተ ኡባይ የሱስ ክርስቶሳ አማንድ ፆሳ ናይታ ግድደታ። <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>ክርስቶሳራ እስኖ ግዳናዉ ፃማቀትዳ ኡባይ ክርስቶሳ ማኦዳ ማእደታ። <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>ህንተ ኡባይ ክርስቶሳን እስኖ ግድያ ግሾ፥ አይሁደ አሳ ግዶንነ ግርከ አሳ ግዶን፥ አይለ ግዶንነ ዎማኖ ግዶን፥ አደ ግዶንነ ማጫሳ ግዶን ዱማተ ባዋ። <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>ህዛ፥ ህንተ ክርስቶሳባ ግድኮ ህንተ አብራሃመ ዛረ። ፆሳ ኡፋይሳ ቃላዳ ህንተ ላተይሳታ።<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="ROM 4:13">ሮመ 4:13</ref>.</char></note><verse eid="GAL 3:29"/></para>
  <para style="b"/>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>ታ ገይስ ሀይሳ። ላተይ ናኣ ግድ ደእሸ፥ ሻሎ ኡባይ እያባ ግድኮካ፥ እ አይለፈ አይኮካ ዱማተና። <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>ሽን እያ አዋይ ግዳ ዎደይ ጋካናዉ እ ሀዳራ ኤክዳይሳታ ኩሸንነ ናገይሳታ ኩሸን ደኤስ። <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>ሄሳዳካ፥ ኑኒ ናአተን ደእያ ዎደ አላምያ ዎጋስ አይለትድ ደእዳ። <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>ሽን ዎደይ ጋክዳ ዎደ ፆሳይ ህገፈ ጋርሳን፥ ማጫሳፐ የለትዳ ባ ናኣ ኪትስ። <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>እ ሄሳ ኦዳይ፥ ህገስ ሃረትድ ደኤይሳታ ዎዛናዉነ ኑና ባ ናይታ ኦናሳ።<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="ROM 8:15-17">ሮመ 8:15-17</ref>.</char></note><verse eid="GAL 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6"/>ኑ ፆሳ ናይታ ግድያ ግሾ፥ “አባ፥ አዋዉ” ግድ ፄግያ ባ ናኣ አያና ኑ ዎዛና ግዶ ኪትስ። <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>ሄሳ ግሾ፥ ህዛፐ ኔኒ ፆሳ ናአፐ አትሽን፥ አይለ ግዳካ። ኔኒ እያ ናአ ግድኮ፥ ፆሳ ላተይሳ ግዳዳሳ።<verse eid="GAL 4:7"/></para>
  <para style="s1">ጳዉሎስ ጋላትያ አሳስ ቆፔስ</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>ህንተ ካሰ ፆሳ ኤሮና ዎደ ፆሰ ግዶናይሳታስ አይለ ግድድ ሃረትደታ። <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>ሽን ሀእ ህንተ ፆሳ ኤርደታ፤ ኡባራካ ፆሳን ኤረትደታ። ያትን ፓናነ ጎኦና አላመ ዎጋታኮ ጉየ ዋንድ ስመቲ? ዎ ኤቅድ፥ ዋንድ ኤንታዉ አይለ ግዳናዉ ኮዬቲ? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>ዱማ ግድዳ ጋላሳታ፥ አጌናታ፥ ዎደታነ ላይታ ህንተ ሎይ ቦንቸታ። <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>ታና ህንተባይ ያሼስ፤ ታ ህንተዉ ጮ ዳቡራድናሻ?<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>ታ እሻቶ፥ ታ ህንተዳ ሀንዳ ግሾ፥ ህንተካ ታዳ ሀንተ ጋዳ ህንተና ዎሳይስ። ህንተ ታና አይብንካ ቆህቤከታ። <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>ታኒ ኮይሮ ሀርገታሸ ህንተዉ ዎንገላ ኦድዳይሳ ህንተ ኤሬታ። <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>ታ ሀርገይ ህንተዉ ፓጨ ግድኮካ፥ ታና ሳለትበከታ፤ እፅበከታ። ሽን ታና ፆሳ ኪታንቾ ዎይኮ ክርስቶስ የሱሳ ሞከይሳዳ ሞክደታ።<verse eid="GAL 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 4:15"/>ያትን፥ ሄ ህንተዉ ደእያ ኡፋይሳይ ኡባይ አዉ ብዴ? ህንተዉ ዳንዳኤትዳኮ፥ ህንተ ታዉ፥ ህንተ አይፍያ ከስድ እምያኮ እፆናይሳ ታ ማርካታይስ። <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>ያትን፥ ታ ህንተዉ ቱማ ኦድዳ ግሾ ህንተዉ ሞርከ ግዳድናዬ?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>ሄ አሳት ህንተና ባንታኮ ዛራናዉ ኮዮሶና፥ ሽን ኤንታ ቆፋይ ሎኦሳ ግደና። ኤንታ ቆፋይ ህንተና ሻካናሳነ ህንተ ኤንታዉ ቆፓና መላ ኦናሳ። <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>ሎኦባ ኦናዉ አሞትኮ ሎኦ፥ ሽን ሄስ ታ ህንተራ ደእያ ዎደ ፃላላ ግዶናሽን ኡባ ዎደ ግዶ።<verse eid="GAL 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 4:19"/>ታ ሲቆ ናይቶ፥ ክርስቶስ ህንተናን ምስለታና ጋካናዉ ማጫስ የሎስ እቀተይሳዳ ታ ህንተ ግሾ እቀታይስ። <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>ህንተባይ ታዉ ሀድርን ታ ኡንኤታስ፤ ሀእ ህንተ ግዶን ታ በንታዳ ሸነታዳ ኦድያኮ አይ መላ ዶሳይናሽን።<verse eid="GAL 4:20"/></para>
  <para style="s1">አጋሮነ ሳሮ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>ሙሰ ህገን ሃረትድ ዳናዉ ኮየይሳቶ፥ አነ ታዉ ኦድተ፤ ህገይ አይ ግያኮ ኤረከቲ? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>ጌሻ ማፃፋይ፥ “አብራሃመስ ጋንደፈነ ጎዳተፈ የለትዳ ናምኡ ናይት ደኦሶና” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="GEN 16:15">መ 16:15</ref>፤ <ref loc="GEN 21:2">21:2</ref>.</char></note> <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>ጋንደ ናአይ አስ ናአ የልያ ማራን የለትስ፥ ሽን ጎዳተ ናአይ ፆሳ ኡፋይሳ ቃላን የለትስ።<verse eid="GAL 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24"/>ሀ ማጫሳት ናምኡ ጫቆታስ ሌምሶ ግድድ ኤከቶሶና። ኤንታፈ እስንያ፥ ሲና ዙማፐ ይዳራ፥ ባ ናይታ አይለተስ የላሱ፤ እያካ አጋሮ። <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>አጋራ አራበ ቢታን ደእያ ሲና ዙማን ሌምሰታዳ ሀእ ደእያ የሩሳላመ ዳናዉሱ። አይስ ጊኮ፥ እያ ባ ናይታራ አይለተን ደአዉሱ። <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>ሽን ሳሎን ደእያ የሩሳላመይ አይለተን ደኡኩ፤ እያ ኑ ኡባስ አዮ። <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>ጌሻ ማፃፋይ፥</para>
  <para style="q1" vid="GAL 4:27">“ናተ፥ የሎና ማይንተ ኡፋይታ፤</para>
  <para style="q2" vid="GAL 4:27">ናተ እቀታ ኤሮናረ እልላ።</para>
  <para style="q1" vid="GAL 4:27">አዝናራ ደእያ ማጫሴፐ፥</para>
  <para style="q2" vid="GAL 4:27">አዝን ባይና ማጫሴስ ናይት ዳሮ” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="ISA 54:1">እሳ 54:1</ref>.</char></note><verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>ታ እሻቶ፥ ህንተ ይሳቃዳ ፆሳ ኡፋይሳ ቃላን የለትዳ ናይታ። <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>ሽን ሄ ዎደ አሳ ማራዳ የለትዳይስ፥ አያና ዎልቃን የለትዳይሳ ጎድስ። ሀችካ ሄሳ መላ።<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="GEN 21:9">መ 21:9</ref>.</char></note> <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>ሽን ጌሻ ማፃፋይ ዎይጊ? “ጋንደ ናአይ ጎዳተ ናኣራ እስፈ ላቶና ግሾ፥ አይልዉ እ ናኣራ ዎላ ከሳ የዳ” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">4:30 </char><char style="xt" closed="false"><ref loc="GEN 21:10">መ 21:10</ref>.</char></note> <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>ሄሳ ግሾ፥ ታ እሻቶ፥ ኑኒ ጎዳተ ናይታፐ አትሽን፥ ጋንደ ናይታ ግዶኮ።<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s1">ክርስቶሳን ደእያ ላአተ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>ኑኒ ላአተን ዳና መላ ክርስቶስ ኑና አይለተፈ ከስስ። ህዛ፥ ምንድ ኤቅተ፤ ዛሪድ አይለተ ቃምባራን ገሎፕተ።<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>ታ፥ ጳዉሎስ፥ ገይሳ ስእተ። ህንተ ቃፃረታናዉ ኮይኮ፥ ክርስቶስ ህንተና አይኮካ ማደና። <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>ቃፃረትያ ኦንካ ህገይ ኪትያ ኡባ ፖላናዉ በሰይሳ ጉጃዳ ታ ኦዳይስ። <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>ህገ ናግድ ፅላናዉ ኮየይሳቶ፥ ክርስቶሳፐ ሻከትደታ፤ ፆሳ አ ኬሀተፈ ኩንድደታ። <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>ሽን ኑኒ ፆሳ አያና ባጋራ አማኖን ፅላናዉ ኡፋይሳን ናጎስ። <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>ህዛ፥ ክርስቶስ የሱሳን ደእኮ፥ ሲቆን ቆንጭያ አማኖፐ አትሽን፥ ቃፃረትን፥ ቃፃረቶና አግን ኑና አይኮካ ማደና።<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>ካሰ ህንተ ሎኦ ዎፄታ፥ ሽን ሀእ ቱማስ ኪተቶና መላ ህንተና ድግዳይ ኦኔ? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>ሀይሳ መላ ኢታ ጭሞይ ህንተና ፄግዳ ፆሳፈ ይቤና። <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>ሄስካ፥ “ጉ እርሾይ ሙኑቃ ኡባ ደንስ”<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="2CO 5:6">2 ቆሮ 5:6</ref>.</char></note> ጌተትድ ፃፈትዳይሳ መላ። <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>ህንተዉ ሀራ ቆፍ ባይናይሳስ ታ ጎዳን አማነታይስ። ሽን ህንተና ቡቅያ ኦንካ ፆሳፈ ባ ፕርዳ ኤካና።<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>ታ እሻቶ፥ ታ ሀእ ጋካናዉ ቃፃአረተ ሳባክያባ ግድኮ፥ ያትን ታና አይስ ጎዶና? ሄስ ቱማ ግድያኮ ክርስቶሳ ማስቃልያባ ታማርሶይ አሳስ በ ግደናሽን። <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>ህንተና ቡቀይሳት ቃፃረተ ፃላላ ግዶናሽን፥ ባንታና ቃራትያኮካ ታ ዶሳይስ።<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>ታ እሻቶ፥ ህንተ ላአ ዳናዉ ፄገትደታ። ግዶሽን፥ ህንተ ላአተይ አሾ አሞ ፖላናዉ ህንተዉ ጋሶ ግዶፖ፤ ሄሳፈ አድ እሶይ እሱዋ ሲቆን ማድተ። <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>ህገ ኡባይ፥ “አሰ ኔዳ ዶሳ” ግያ እስ ቃላን ቃሸትስ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌወ 19:18</ref>.</char></note> <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>ሽን ህንተ እሶይ እሱዋራ ሳፀትያባነ ሜተትያባ ግድኮ፥ ህንተ ዎል ዉርሶና መላ ናገትተ።<verse eid="GAL 5:15"/></para>
  <para style="s1">አያና ደኦነ አሾ ደኦ</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>ህዛ፥ ታ ህንተዉ ኦዳይስ፤ አያናን ደእተ፤ ህንተ አሾ አሙዋ ፖሎፕተ። <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>አሾ አሞይ አያና አሙዋራ ሞርከ፤ ቃስ አያና አሞይካ አሾ አሙዋራ ሞርከ። ኤንቲ እሶይ እሱዋራ እፀትያ ግሾ ህንተ ዶስያባ ኦናዉ ዳንዳኤከታ።<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ROM 7:15-23">ሮመ 7:15-23</ref>.</char></note> <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>ሽን አያናይ ህንተና ካለያባ ግድኮ ህገይ ህንተና ሃረና።<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>አሾ ኦሶት ኤረትዳይሳታ፤ ኤንትካ፥ ላይማተ፥ ቱናተ፥ ቃይፀ፥ <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>ኤቃ ጎይኖ፥ ብታ፥ ሞርከተ፥ ካች፥ ቃናተ፥ ሀንቆ፥ ባና ዶሶ፥ ሻከተ፥ ኢታ ቶቦ <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>ገነ፥ ማ፥ የነ ሄሳ ሄሳ መላታ። ካሰ ታ ህንተዉ ኦድዳይሳዳ ሀእካ ታ ህንተዉ ኦዳይስ። ሀይሳ መላባታ ኦይሳት ፆሳ ካዎተ ላቶኮና።<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>ሽን አያና አይፈይ፥ ሲቆ፥ ኡፋይስ፥ ሳሮተ፥ ዳንዳአ፥ ኬሀተ፥ ሎኦተ፥ አማኖ፥ <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>አሽከተ፥ ባና ሃሮ። ሀይሳ መላባታ እፅያ ህገይ ባዋ።<verse eid="GAL 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 5:24"/>ክርስቶስ የሱሳባ ግድዳይሳት ባንታ አሹዋ እያ ኢታ ቆፋራነ እያ አሙዋራ እስፈ ማስቃልያ ቦላ ካቅዶሶና። <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>ኑ አያናን ደእያባ ግድኮ፥ ኑና አያናይ ካለ። <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>አነ እሶይ እሱዋ ይሎይሸነ ቃናትሸ ጮ ጬቀተይሳ አጎስ።<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s1">እሶይ እሱዋ ማድተ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>ታ እሻቶ፥ እስ አስ ናጋራን ኩንድኮ፥ አያናን ደእያ ህንተ ሄ ኡራ አሽከተን ሱርስተ። ሽን ኔኒ ሄሳ መላባን ፓጨቶና መላ ነና ናጋ። <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>እሶይ እሱዋ ዴፆ ቶሁዋ ቶክተ። ያትኮ ክርስቶሳ ህግያ ፖሌታ። <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>እስ አስ አይኮይካ ባዋሽን፥ ባና ሀራታፐ ሎኦ ግድ ቆፕኮ፥ እ ባና ጭሜስ። <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>ሽን እስ እስ አስ ባ ኦሱዋ ፓጮ። ሄሳፈ ጉየ፥ ሀራታራ ባና ጋደየይሳ አግድ ባዉ ጬቀትያባ ደሜስ። <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>እስ እስ አስ ባ ቶሁዋ ባዉ ቶካናዉ በሴስ።<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>ፆሳ ቃላ ታማርያ ኦንካ ሎኦባ ኡባ ባ አስታማርያራ ሻከቴስ።<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>ህንተ፥ ህንተና ጭሞፍተ። አስ ባ ዘርዳባ ዛሪድ ጫክያ ግሾ ፆሳ ቦላ ቀልቅሶፕተ። <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>ባ አሾ አሙዋ ኩንናዉ ዘርያ ኦንካ፥ ባ አሾ አሙዋፐ ሀይቆ ቡጫና። ሽን አያና ኡፋይሳናዉ ዘርያ ኦንካ አያናፐ መርና ደኦ ጫካና። <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>አነ ሎኦ ኦሶ ኦናዉ አዛለይሳ አጎስ። ኑኒ አዛሎና እፅኮ ዎደይ ጋክያ ዎደ ኑ ዘርዳይሳ ጫካና። <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>ኑ እንጀ ዎደ ደምኮ፥ አሳ ኡባስ፥ አድካ አማንያ አሳስ ሎኦባ ኦስ።<verse eid="GAL 6:10"/></para>
  <para style="s1">ዞረነ ሳሮ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>ታኒ ታ ኩሸን፥ አይ መላ ግታ ፕዳለን ህንተዉ ፃፍዳኮ በእተ። <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>አሳ ስንን ሎኦ ግድድ በንታናዉ ኮይያ አሳት ህንተ ቃፃረታና መላ ኮዮሶና። ሽን ሄሳ ኤንቲ ኦይ፥ ክርስቶሳ ማስቃልያ ግሾ ኤንታና ጎድ ጋኮና መላሳ። <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>ኤንቲ ህንተ ቃፃረተን ጬቀታናዉ ኮይድ ህንተና ቃፃረቶ ጎሶናፐ አትሽን፥ ቃፃረትዳይሳትካ ባንታ ሁጰን ህግያ ናጎኮና።<verse eid="GAL 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 6:14"/>ሽን አላመይ ታዉ ካቀትዳይሳፈነ ታንካ አላምያስ ካቀትዳ፥ ጎዳ የሱስ ክርስቶሳ ማስቃልያፐ አትሽን፥ ሀራ ጬቆይ ታፐ ሃኮ። <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>ህዛ፥ ቃፃረትን ቃፃረቶና አግን አይኮካ ማደና። ማደይ ኦራ መተ ግዶ። <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>ሀ ዎጋ ካልያ ኡባስነ ፆሳ ደረ ግድዳ እስራኤለስ ሳሮተነ ማሮተ ግዶ።<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>ታኒ የሱሳስ ማዱንፅዳ ቤታ ታ አሳተን ቶክዳ ግሾ፥ ህዛፐ ታና ኦንካ ዋይሶፖ።<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>ታ እሻቶ፥ ኑ ጎዳ የሱስ ክርስቶሳ አ ኬሀተይ ህንተራ ግዶ። አምንእ።<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
