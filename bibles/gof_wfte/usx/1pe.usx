<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">1 ጰፅሮሳ ኪታ</para>
  <para style="toc1">1 ጰፅሮሳ ኪታ</para>
  <para style="toc3">1 ጰፅ</para>
  <para style="toc2">1 ጰፅሮሳ</para>
  <para style="mt1">ጰፅሮስ ፃፍዳ</para>
  <para style="mt2">ኮይሮ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሀዋርያ ጰፅሮስ ፃፍዳ ኮይሮ ኪታይ፥ “ዶረትዳ ፆሳ አሳታ” ጌተትድ ፄገትዳይሳታስነ ጉ ኢሰን ፑደሀ ባጋን ላለትዳ አማንያ አሳሳ። ሀ ኪታይ ፃፈትዳ ጋሶይ፥ አማኖ ጋሶን መቶይነ ዋየይ ጋክዳ አሳ ምንናሳ። ሀ ማፃፋ ፃፈይ፥ እያ ሀይቁዋ፥ እያ ደንዱዋ፥ እያ ናምአን ዩሳ ኦድያ የሱስ ክርስቶሳ ዎንገላ ቃላ ኤንታ አኬክሴስ። የሱስ ክርስቶሳ ደኡዋ ሌምሶ ኦ ፄልድ፥ መቶ ዳንዳአን ካንና መላ ኤንታ ቆፍሴስ። ሄሳራ ጋድ፥ መቶይ ኤንታ አማኑዋ ፓጨይሳነ የሱስ ክርስቶሲ ቆንጭያ ጋላስ በሲያ ዎይቶ ኤንቲ ኤካናዉ ደኤይሳ ሀሳይሴስ።</para>
  <para style="ip">ፃፈይ፥ ኤንቲ መቶ ዳንዳአና መላ ምን ስሚድ፥ ክርስቶሳ ካልያ አሳት ደኤይሳዳ ኤንቲ ዳና መላ ቆፍሴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሳሮ (<char style="ior"><ref loc="1PE 1:1-2">1:1-2</ref></char>)</para>
  <para style="io1">ፆሳይ ኑስ እምዳ አቶተ (<char style="ior"><ref loc="1PE 1:3-12">1:3-12</ref></char>)</para>
  <para style="io1">ጌሻተን ዱሱ (<char style="ior"><ref loc="1PE 1:13-2:17">1:13—2:17</ref></char>)</para>
  <para style="io1">ክርስቶሳ ዋይያ ሌምሶ (<char style="ior"><ref loc="1PE 2:18-25">2:18-25</ref></char>)</para>
  <para style="io1">መቶ ዎደ አማንያ አሳ ሀኖታ (<char style="ior"><ref loc="1PE 3:1-4:19">3:1—4:19</ref></char>)</para>
  <para style="io1">ጭማታስነ ናአተታስ እመትዳ ዞረ (<char style="ior"><ref loc="1PE 5:1-11">5:1-11</ref></char>)</para>
  <para style="io1">ሞይዞ ሳሮ (<char style="ior"><ref loc="1PE 5:12-14">5:12-14</ref></char>)</para>
  <chapter number="1" style="c" sid="1PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1"/>ታኒ፥ የሱስ ክርስቶሳ ሀዋረይ ጰፅሮስ፤ ጳንፆሳን፥ ጋላትያን፥ ቃጳዶቃን፥ ኢሰንነ ብታነን በታንቾዳ ላለትድ ደእያ ፆሳይ ዶርዳ፥ አሳስ ሀ ዳብዳብያ ፃፋስ። <verse eid="1PE 1:1"/><verse number="2" style="v" sid="1PE 1:2"/>የሱስ ክርስቶሳስ ህንተ ኪተታና መላነ እያ ሱን ጌያና መላ፥ ፆሳ አዋይ ባ ካሰ ኤራን ዶርዳይሳታስነ ጌሻ አያናን ጌይዳ፥ ህንተዉ አ ኬሀተይነ ሳሮተይ ግዶ።<verse eid="1PE 1:2"/></para>
  <para style="s1">ዮና ኡፋይስ</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3"/>የሱስ ክርስቶሳ ሀይቆፐ ደንድ ባ ግታ ማሮተን ናምአን የለተነ ዮና ኡፋይሳ እምዳ ኑ ጎዳ የሱስ ክርስቶሳ አዋይ፥ ፆሳይ ጋላተቶ። <verse eid="1PE 1:3"/><verse number="4" style="v" sid="1PE 1:4"/>ቃስ ፆሳይ ህንተዉ ዮና፥ ኢቶናነ ቡቆና ላታ ሳሎን ጊግስስ። <verse eid="1PE 1:4"/><verse number="5" style="v" sid="1PE 1:5"/>ሄ ላታይ ዎደ ዉርሰን ቆንጫናዉ ደእያ አቶተስ ፆሳ ዎልቃን አማኖን ህንተዉ ናገትድ ደኤስ።<verse eid="1PE 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6"/>ሀእ ጉ ዎደስ ህንተ ዱማ ዱማ ፓጨን ኡንኤትኮካ ሄሳን ኡፋይትተ። <verse eid="1PE 1:6"/><verse number="7" style="v" sid="1PE 1:7"/>ሄ ፓጨይ ህንተና ጋክዳይ፥ ታማን የግን ይያ ዎርቃፈ ህንተ አማኖይ አነ ቱማ ግደይሳ በሳናሳ። ሄ ፓጨትዳ አማኑዋን የሱስ ክርስቶሲ ቆንጭያ ዎደ ጋላታ፥ ቦንቾነ ሳባ ህንተ ኤካና። <verse eid="1PE 1:7"/><verse number="8" style="v" sid="1PE 1:8"/>ህንተ የሱሳ በእቤከታ፥ ሽን እያ ሲቀታ። ህንተ ሀእ እያ በእቦናባ ግድኮካ፥ እያ አማነታ። ቃስ ኦዳን ቆንጭሳናዉ ዳንዳኤቶና ኡፋይሳንነ ቦንቾን ኩምደታ። <verse eid="1PE 1:8"/><verse number="9" style="v" sid="1PE 1:9"/>ህንተ አማኖን ናግያ ህንተ ሸምፑዋ አቶተ ኤካና።<verse eid="1PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10"/>አ ኬሀተ ባጋራ ህንተዉ ጊግዳ ሀ አቶተባ ናበት ኤራናዉ ግታ ኮሻንነ ናጎን ኮይዶሶና። <verse eid="1PE 1:10"/><verse number="11" style="v" sid="1PE 1:11"/>ኤንታን ደእያ ክርስቶሳ አያናይ እያ ዋያባነ ሄሳፈ ጉየ ያና ቦንቹዋባ ካሰትድ ማርካትሸ፥ አዉደ ዎይኮ ዋንድ ሀናኔኮ አኬካን ፕልግዶሶና። <verse eid="1PE 1:11"/><verse number="12" style="v" sid="1PE 1:12"/>ናበት ኦድዳ ትንብተይ ባንታዉ ግዶናሽን፥ ህንተዉ ግደይሳ ፆሳይ ህንተዉ ቆንጭስስ። ሀእ አሳይ ህንተዉ ኦድዳ ዎንገላ ሳሎፐ ኪተትዳ ጌሻ አያና ዎልቃን ህንተዉ ኦድዶሶና። ኪታንቾትካ ሄሳ በአናዉ አሞትዶሶና።<verse eid="1PE 1:12"/></para>
  <para style="s1">ጌሻተን ደእተ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13"/>ሄሳ ግሾ፥ ኦሶስ ህንተና ጊግስተ፤ ህንተና ሃርተ። የሱስ ክርስቶሲ ቆንጭያ ዎደ ህንተ ኤካና አ ኬሀተ ኡፋይሳን ናግተ። <verse eid="1PE 1:13"/><verse number="14" style="v" sid="1PE 1:14"/>ፆሳ ናይታዳ እያዉ ኪተትተ፤ ህንተ ካሰ ኤሮና ኦዳ ኢታ አሙዋ ካሎፍተ። <verse eid="1PE 1:14"/><verse number="15" style="v" sid="1PE 1:15"/>ሽን ህንተና ፄግዳ ፆሳይ ጌሽ ግድዳይሳዳ ህንተካ ህንተ ዱሳ ኡባን ጌሽ ግድተ። <verse eid="1PE 1:15"/><verse number="16" style="v" sid="1PE 1:16"/>ጌሻ ማፃፋን፥ “ታኒ ጌሽ ግድዳ ግሾ ህንተካ ጌሽ ግድተ” ጌተትድ ፃፈትስ።<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="LEV 11:44-45">ሌወ 11:44-45</ref>፤ <ref loc="LEV 19:2">19:2</ref>.</char></note><verse eid="1PE 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17"/>አሳ ሶምኦ በኦና እያ ኦሱዋዳ ፕርድያ ፆሳ፥ “ኑ አዋዉ” ግድ ፄግያባ ግድኮ፥ ሀ ሳኣ እማተ ዱሳ ያሻን ደእተ። <verse eid="1PE 1:17"/><verse number="18" style="v" sid="1PE 1:18"/>ህንተ፥ ህንተ አዋታፐ ላትዳ ፓና ደኡዋፐ ዎዘትዳይስ፥ ይያ ብራን ዎይኮ ዎርቃን ግዶናይሳ ኤሬታ። <verse eid="1PE 1:18"/><verse number="19" style="v" sid="1PE 1:19"/>ቦረይ ዎይኮ ቦርሶይ ባይና ዶርሳ ሱዳ አልኦ ግድዳ ክርስቶሳ ሱን ዎዘትደታ። <verse eid="1PE 1:19"/><verse number="20" style="v" sid="1PE 1:20"/>ፆሳይ አላመይ መታናፐ ካሰ ክርስቶሳ ዶርስ፥ ሽን ሀ ዉርሰ ዎድያን ክርስቶስ ህንተ ግሾ ቆንጭስ። <verse eid="1PE 1:20"/><verse number="21" style="v" sid="1PE 1:21"/>ህንተ አማኖይነ ህንተ ኡፋይሳይ ፆሳን ግዳና መላ እያ ሀይቆፐ ደንድ፥ ቦንችዳ ክርስቶሳ ባጋራ ፆሳን አማነታ።<verse eid="1PE 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22"/>ህንተ ቱማተስ ኪተትድ ህንተናተ ጌሽደታ። ህንተ እሶይ እሱዋ ዎዛናፐ ሲቀታ፥ ሽን ሀእካ ቱማ ዎዛናፐ ምንድ ሲቅተ።<verse eid="1PE 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1PE 1:23"/>ህንተ ናምአን የለትዳይ ይያ ዘረፈ ግዶናሽን፥ መርናዉ ደእያ ፆሳ ቃላን ዮና ኮቻፈ የለትደታ። <verse eid="1PE 1:23"/><verse number="24" style="v" sid="1PE 1:24"/>ፆሳ ቃላይ፥</para>
  <para style="q1" vid="1PE 1:24">“አስ ኡባይ ማታ መላ፤</para>
  <para style="q2" vid="1PE 1:24">እያ ቦንቾ ኡባይ ጪሻ መላ።</para>
  <para style="q1" vid="1PE 1:24">ማታይ መሌስ፥ ጪሻይካ ቆለቴስ።<note caller="-" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="ISA 40:6-8">እሳ 40:6-8</ref>.</char></note><verse eid="1PE 1:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25"/>ሽን ጎዳ ቃላይ መርናዉ ደኤስ”</para>
  <para style="m" vid="1PE 1:25">ያጌስ። ህንተዉ ኦደትዳ ዎንገላ ቃላይ ሀይሳ።<verse eid="1PE 1:25"/></para>
  <chapter eid="1PE 1"/>
  <chapter number="2" style="c" sid="1PE 2"/>
  <para style="s1">ደኦ ሹችነ ጌሻ ደረ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1"/>ህዛ፥ ኢታተ ኡባ፥ ጭሞ ኡባ፥ ጩቦተ ቃናተነ ዝግርስ ኡባ ህንተፈ ድግተ። <verse eid="1PE 2:1"/><verse number="2-3" style="v" sid="1PE 2:2-3"/>ጎዳይ ኬሀ ግደይሳ ህንተ ኤርድ ሜዘትዳይሳዳ ሀእ የለትዳ ጉ ናይታዳ ህንተ አቶተን ድጭሸ ባናዉ ፆሳ ጌሻ ቃላ ማ ኡባ ዎደ አሞትተ።<note caller="-" style="x"><char style="xo" closed="false">2:2-3 </char><char style="xt" closed="false"><ref loc="PSA 34:8">ማዝ 34:8</ref>.</char></note><verse eid="1PE 2:2-3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4"/>አሳን ቦረትድ ፆሳን ዶረትዳ አልኦ ግድዳ ደኦ ሹቻ፥ ጎዳ የሱሳኮ ሺቅተ። <verse eid="1PE 2:4"/><verse number="5" style="v" sid="1PE 2:5"/>ህንተ አያና ኬ ኬፀትያ ደኦ ሹቻታ። ህንተ የሱስ ክርስቶሳ ባጋራ ፆሳ ኡፋይስያ አያና ያርሾ ያርሽያ ጌሻ ካህነታ። <verse eid="1PE 2:5"/><verse number="6" style="v" sid="1PE 2:6"/>ጌሻ ማፃፋን፥</para>
  <para style="q1" vid="1PE 2:6">“ሄኮ፥ ታኒ ፅዮነ ካታማን ጎዳ ፃጱዋ ምንያ፥</para>
  <para style="q2" vid="1PE 2:6">ዶረትዳ፥ አልኦ ሹቻ ዎስ፤</para>
  <para style="q2" vid="1PE 2:6">እያን አማንያ ኦንካ ዬላተና”</para>
  <para style="m" vid="1PE 2:6">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="ISA 28:16">እሳ 28:16</ref>.</char></note> <verse eid="1PE 2:6"/><verse number="7" style="v" sid="1PE 2:7"/>ሀ ሹቻይ ህንተዉ አማነይሳታስ አልኦ፥ ሽን አማኖናይሳታስ፥</para>
  <para style="q1" vid="1PE 2:7">“ግምበይሳት ካድ እፅዳ ሹቻይ</para>
  <para style="q2" vid="1PE 2:7">ጎዳ ፃጱዋ ምንያ፥</para>
  <para style="q2" vid="1PE 2:7">ኡባፈ አያ ሹቹ ግድስ።”<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዝ 118:22</ref>.</char></note><verse eid="1PE 2:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8"/>ቃስካ፥</para>
  <para style="q1" vid="1PE 2:8">“ሀ ሹቻይ አሰ ብያ ሹቻነ አሰ ኩንድስያ ዛላ”</para>
  <para style="m" vid="1PE 2:8">ያጌስ። ኤንቲ ሄሳስ ቃደትዳ ግሾ ፆሳ ቃላ ኪተቶና እፅድ በትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 8:14-15">እሳ 8:14-15</ref>.</char></note><verse eid="1PE 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9"/>ሽን ፆሳይ ማፐ ማላልስያ ባ ፖኡዋኮ ህንተና ፄግዳይ፥ ህንተ እያ ሎኦተ ሀራታስ ኦዳናዉ ዶረትዳ ኮቸ፥ ካዎ ካህነ፥ ጌሻ ደረነ ፆሳ ዱማ ደረ።<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="EXO 19:5-6">ከሳ 19:5-6</ref>፤ <ref loc="ISA 43:20-21">እሳ 43:20-21</ref>፤ <ref loc="DEU 4:20">ዛረ 4:20</ref>፤ <ref loc="DEU 7:6">7:6</ref>፤ <ref loc="DEU 14:2">14:2</ref>፤ <ref loc="TIT 2:14">ትቶ 2:14</ref>፤ <ref loc="ISA 9:2">እሳ 9:2</ref>.</char></note> <verse eid="1PE 2:9"/><verse number="10" style="v" sid="1PE 2:10"/>ህንተ ካሰ ፆሳ ደረ ግደከታ፥ ሽን ሀእ ህንተ እያ ደረ። ህንተ ካሰ ማሮተ ደምበከታ፥ ሽን ሀእ ማሮተ ደምደታ።<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="HOS 2:23">ሆሰ 2:23</ref>.</char></note><verse eid="1PE 2:10"/></para>
  <para style="s1">ፆሳ አሳዳ ደእተ</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11"/>ታ እሻቶ፥ ህንተ ሀ ሳአን እማነ በተ አስ ግድዳይሳዳ ህንተ ሸምፑዋ ኦልያ አሾ አሞፐ ሃካና መላ ታኒ ህንተና ዎሳይስ። <verse eid="1PE 2:11"/><verse number="12" style="v" sid="1PE 2:12"/>አማኖና አሳይ ህንተና ኢታ ኦያ አሳዳ ዝግርያ ዎደ ፆሳይ ኑና በአናዉ ያ ጋላስ፥ ኤንቲ ህንተ ሎኦ ኦሱዋ በእድ ፆሳ ጋላታና መላ ህንተዉ ሎኦ ደኦይ ደኦ።<verse eid="1PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13"/>ጎዳ ግሾ ግድ ማታራ ደእያ አሳታስ ሃረትተ፤ ኡባፈ ቦላ ግድያ ግሾ ካዋስካ ሃረትተ። <verse eid="1PE 2:13"/><verse number="14" style="v" sid="1PE 2:14"/>ኤንቲ ኢታ ኦይሳታ ሴራናዉነ ሎኦ ኦይሳታ ሳባናዉ ካዉዋፐ ኪተትዳ ግሾ ደርያ አይሰይሳታስ ሃረትተ። <verse eid="1PE 2:14"/><verse number="15" style="v" sid="1PE 2:15"/>ህንተ፥ ህንተ ሎኦ ኦሱዋን ኤሮና ኤያ አሳ ዶና ኦይናይስ ፆሳ ሸነ። <verse eid="1PE 2:15"/><verse number="16" style="v" sid="1PE 2:16"/>ፆሳ አይለ ግድድ ላአተን ደእተፐ አትሽን፥ ህንተ ላአተ ኢታ ኦሶስ ካማ ኦፍተ። <verse eid="1PE 2:16"/><verse number="17" style="v" sid="1PE 2:17"/>አሳ ኡባ ቦንችተ፤ አማንያ አሳ ሲቅተ፤ ፆሳ ያይተ፤ ካዎ ቦንችተ።<verse eid="1PE 2:17"/></para>
  <para style="s1">ክርስቶሳ ዋየ ሌምሶ</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18"/>አይለቶ ሎኦ ጎዳታስነ ኬሀ ጎዳታ ፃላላስ ግዶናሽን፥ ኢታታስካ ቦንቾን ሃረትተ። <verse eid="1PE 2:18"/><verse number="19" style="v" sid="1PE 2:19"/>አስ ፆሳ ግሾ ግድ በሶና ዋየ ዋየትኮ ፆሳይ እያ አንጃና። <verse eid="1PE 2:19"/><verse number="20" style="v" sid="1PE 2:20"/>ሽን ህንተ ናጋራ ኦን ህንተና ደችያ ዎደ ህንተ ዳንዳእኮ ህንተዉ አይ ጋላት ደኢ? ሽን ሎኦባ ኦድ ዋየ ዳንዳእኮ ፆሳይ ህንተና ሄሳስ አንጃና። <verse eid="1PE 2:20"/><verse number="21" style="v" sid="1PE 2:21"/>ፆሳይ ህንተና ፄግዳይ ሄሳ ግሾሳ፤ ክርስቶስ ህንተዉ ዋየትስ፤ ህንተ እያ ካላና መላ፥ ህንተዉ ሌምሶ ግድስ። <verse eid="1PE 2:21"/><verse number="22" style="v" sid="1PE 2:22"/>እ ናጋራ ኦቤና፤ እያ ዶናን ዎርዶይ በንትቤና።<note caller="-" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="ISA 53:9">እሳ 53:9</ref>.</char></note> <verse eid="1PE 2:22"/><verse number="23" style="v" sid="1PE 2:23"/>ኤንቲ እያ ጫይያ ዎደ፥ ዛሪድ ጫይቤና። ሽን ዋየ ኤክሸ ፅሎ ፕርድያ ፆሳስ ባ ፕርዳ አጋግስፐ አትሽን፥ ማንድቤና።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="ISA 53:7">እሳ 53:7</ref>.</char></note> <verse eid="1PE 2:23"/><verse number="24" style="v" sid="1PE 2:24"/>ኑኒ ናጋራስ ሀይቅድ ፅሎተስ ዳና መላ ክርስቶስ ባ አሹዋን ኑ ናጋራ ማስቃልያ ቦላ ቶክስ፤ ህንተ እያ ማዱንን ፓፅደታ።<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ISA 53:5">እሳ 53:5</ref>.</char></note> <verse eid="1PE 2:24"/><verse number="25" style="v" sid="1PE 2:25"/>ካሰ ህንተ ኦገ ባልድ ይዳ ዶርሳታ መላ፥ ሽን ሀእ ህንተ ሸምፑዋ ሄመይሳኮነ ናገይሳኮ ስምደታ።<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="ISA 53:6">እሳ 53:6</ref>.</char></note><verse eid="1PE 2:25"/></para>
  <chapter eid="1PE 2"/>
  <chapter number="3" style="c" sid="1PE 3"/>
  <para style="s1">አዝናባነ ማችባ</para>
  <para style="p">
    <verse number="1-2" style="v" sid="1PE 3:1-2"/>ሄሳዳካ፥ ማቸቶ፥ ህንተ አዝናታፐ ፆሳ ቃላስ ኪተቶናይሳት ደእኮካ አይኮካ ኦደቶናሽን፥ ህንተ ያሻተነ ህንተ ጌሻ ደኡዋ በእድ አማናና መላ ኤንታዉ ሃረትተ።<note caller="-" style="x"><char style="xo" closed="false">3:1-2 </char><char style="xt" closed="false"><ref loc="EPH 5:22">ኤፈ 5:22</ref>፤ <ref loc="COL 3:18">ቆላ 3:18</ref>.</char></note> <verse eid="1PE 3:1-2"/><verse number="3" style="v" sid="1PE 3:3"/>ህንተ፥ ህንተ ሁጰ ፕፆንነ ዎርቃ አሌቆን ዎይኮ ሎኦ ማኦን ህንተ ቦላ አሳተ ሎይሶን ግዶፖ።<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="1TI 2:9">1 ፅሞ 2:9</ref>.</char></note> <verse eid="1PE 3:3"/><verse number="4" style="v" sid="1PE 3:4"/>ሽን ህንተ ዎዛና ግዶን ደእያ የገልሳተይ ፆሳ ስንን ህንተዉ ዳሮ አልኦ ግድድ ዮና፥ አሽከነ ዎፑ ግዳ አያና ግዶ። <verse eid="1PE 3:4"/><verse number="5" style="v" sid="1PE 3:5"/>ፆሳይ እማና ግዳይሳ አማንዳ ጌሻ ማጫሳት በን ዎደ ባንታ አዝናታስ ሃረትድ፥ ባንታና ሄሳዳ ዳሮ ሎይዶሶና። <verse eid="1PE 3:5"/><verse number="6" style="v" sid="1PE 3:6"/>ሄሳዳ ሳራ አብራሃመ፥ “ታ ጎዳዉ” ያጋዳ ፄጋሸ፥ እያዉ ኪተታሱ፤ ህንተካ አይኮካ ያዮና ሎኦባ ኦኮ እ ናይታ።<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 18:12">መ 18:12</ref>.</char></note><verse eid="1PE 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7"/>አዝናቶ፥ ህንተ ማቸት ህንተፈ ዳቡራንቾ መታ ግደይሳ ኤርድ፥ ኤንታና ቦንችተ፤ ህንተ ዎሳ ቦና መላ ፆሳይ እምዳ ደኡዋ ኤንቲ ህንተራ እስፈ ላትያ ግሾ ኤንታ ቦንችተ።<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="EPH 5:25">ኤፈ 5:25</ref>፤ <ref loc="COL 3:19">ቆላ 3:19</ref>.</char></note><verse eid="1PE 3:7"/></para>
  <para style="s1">ሎኦ ኦድ መቶ ኤኮ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8"/>ዉርሰን፥ ኡባይ እስ ቆፋን ደእተ። እሶይ እሱዋስ ቃትሸ፥ እሻዳ ሲቀትተ፤ ቃስ እሶይ እሱዋስ ኬሀታነ አሽከታ ግድተ። <verse eid="1PE 3:8"/><verse number="9" style="v" sid="1PE 3:9"/>ኢታ ግሾ ኢታ ዎይኮ ጫሻ ግሾ ጫይድ ዛሮፕተ፤ ሄሳ አግድ፥ ፆሳይ ህንተዉ አንጁዋ እማናዉ ህንተና ፄግዳ ግሾ አንጅተ። <verse eid="1PE 3:9"/><verse number="10" style="v" sid="1PE 3:10"/>አይስ ጊኮ፥ ጌሻ ማፃፋይ፥</para>
  <para style="q1" vid="1PE 3:10">“ደኦ ዶሰይነ ሎኦ ዎደ</para>
  <para style="q2" vid="1PE 3:10">በአናዉ ኮየይ ኦና ግድኮካ</para>
  <para style="q2" vid="1PE 3:10">ባ እንፃርሳን ኢታባነ ዎርዶ ኦደተይሳ አጎ።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="PSA 34:12-16">ማዝ 34:12-16</ref>.</char></note><verse eid="1PE 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11"/>ኢታባ ኦይሳ አግድ ሎኦባ ኦ፤</para>
  <para style="q2" vid="1PE 3:11">ሳሮተካ ኬህ ኮዮነ ካሎ።<verse eid="1PE 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12"/>ጎዳ አይፈይ ፅሎታኮ ፄሌስ፤</para>
  <para style="q2" vid="1PE 3:12">ቃስ እ ኡባ ዎደ ኤንታ ዎሳ ሀይዜስ።</para>
  <para style="q1" vid="1PE 3:12">ሽን ጎዳይ ኢታባ ኦይሳታ ባ ሀንቆ ሶምኡዋን ፄሌስ”</para>
  <para style="m" vid="1PE 3:12">ያጌስ።<verse eid="1PE 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13"/>ህንተ ሎኦባ ኦናዉ አሞትኮ ህንተና ቆሀናይ ኦኔ? <verse eid="1PE 3:13"/><verse number="14" style="v" sid="1PE 3:14"/>ሀር አቶሽን፥ ፅሎተ ግሾ ህንተ ዋየትኮ አንጀትዳይሳታ። አሳስ ያዮፍተነ ህርጎፍተ።<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 5:10">ማቶ 5:10</ref>፤ <ref loc="ISA 8:12-13">እሳ 8:12-13</ref>.</char></note> <verse eid="1PE 3:14"/><verse number="15" style="v" sid="1PE 3:15"/>ክርስቶሳ ህንተ ዎዛናን ቦንችተነ ጎዳይተ። ፆሳይ ህንተዉ እምዳ ኡፋይሳስ ጋሶ ኦይችያ ኦደስካ ዛሮ እማናዉ ኡባ ዎደ ጊግድ ኡትተ፥ ሽን ሄሳ አሽከተንነ ያሻን ኦተ። <verse eid="1PE 3:15"/><verse number="16" style="v" sid="1PE 3:16"/>ቃስ ክርስቶሳን ህንተ ደእያ ሎኦ ደኡዋ ኢታባ ኦዳባዳ፥ ህንተና ጫይያ አሳይ ዝግርያባን ዬላታና መላ ህንተ ካሀይ ጌሽ ግዶ። <verse eid="1PE 3:16"/><verse number="17" style="v" sid="1PE 3:17"/>ፆሳይ ግዳባ ግድኮ ኢታባ ኦዳ ግሾ ዋየ ኤከይሳፈ ሎኦባ ኦዳ ግሾ ዋየ ኤከይስ ሎኦ። <verse eid="1PE 3:17"/><verse number="18" style="v" sid="1PE 3:18"/>ክርስቶስ ኑና ፆሳኮ ሺሻናዉ ባዉ ፅሎ ግድድ ደእሸ፥ ናጋራንቾታ ግሾ እስ ቶሆ ናጋራ ኡባስ ሀይቅስ፤ እ ባ አሳተን ሀይቅስ፥ ሽን አያናን ፓፅስ። <verse eid="1PE 3:18"/><verse number="19" style="v" sid="1PE 3:19"/>ቃስ ሄ አያናን እ ብድ ቃሾን ደእያ ሸምፖታስ ቃላ ኦድስ። <verse eid="1PE 3:19"/><verse number="20" style="v" sid="1PE 3:20"/>ኖሄይ ማርካብያ ኬፅያ ዎደ ሄ ሸምፖት ፆሳስ ኪተቶና እፅዶሶና፥ ሽን ፆሳይ ኤንታና ዳንዳእ ጋምእስ። ሆስፑን አሳ ፃላል ማርካብያን ገልድ፥ ዮ ሃፈ አትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="GEN 6:1-7:24">መ 6:1—7:24</ref>.</char></note> <verse eid="1PE 3:20"/><verse number="21" style="v" sid="1PE 3:21"/>ሄ ዮ ሃይ ሀእ ህንተና አሽያ ፅንቃተ ሌምሶ ግድስ። ሀ ፅንቃተይ ቦላ ቅታ ሜጮ ግዶናሽን፥ ሎኦ ካሀ ፆሳፈ ኤካናዉ እያ ዎስያ ኦገ ግድድ፥ ክርስቶሳ ደንዱዋ ባጋራ ህንተና አሼስ። <verse eid="1PE 3:21"/><verse number="22" style="v" sid="1PE 3:22"/>እ ሳሎ ብድ ፆሳ ኡሻቻን ኡትድ፥ ኪታንቾታ፥ ማታ አዋታነ ዎልቃማታ ሃሬስ።<verse eid="1PE 3:22"/></para>
  <chapter eid="1PE 3"/>
  <chapter number="4" style="c" sid="1PE 4"/>
  <para style="s1">ፆሳስ አማነታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1"/>ሄሳ ግሾ፥ ክርስቶስ ባ አሹዋን ኑስ ዋየትዳ ግሾ ህንተካ ሄ ቆፋን ህንተና ዳንጭስድ ምንድ ኤቅተ። ክርስቶሳ ግሾ ግድ ባ አሹዋን ዋየ ኤክዳ ኡራይ ናጋራ ኦከ ግድ ቃንፅዳ አስ። <verse eid="1PE 4:1"/><verse number="2" style="v" sid="1PE 4:2"/>ሄ ኡራይ ባ አትዳ ላይን ፆሳ ሸነ ኦናዉ ኮዬስፐ አትሽን፥ ኢታ አሾ አሞን ዴና። <verse eid="1PE 4:2"/><verse number="3" style="v" sid="1PE 4:3"/>ካሰ ህንተ አማኖና አሳይ ደእዳይሳዳ ደእደታ። ህንተ ኢታ አሞን፥ ላይማተን፥ ማን፥ ቱናተ ደንያ የን፥ ፖክያ ኤቃ ጎይኖን ካሰ ደእዳ ዱሳይ ግዳና። <verse eid="1PE 4:3"/><verse number="4" style="v" sid="1PE 4:4"/>አማኖና አሳራ ህንተ ሾር ባይና ኦሱዋ ኦና ግሾ ማላለትድ ህንተና ጫዮሶና። <verse eid="1PE 4:4"/><verse number="5" style="v" sid="1PE 4:5"/>ሽን ኤንቲ ፓፃታ ቦላነ ሀይቅዳ አሳ ቦላ ፕርዳናዉ ደእያ ፆሳስ ዛሮ እማና። <verse eid="1PE 4:5"/><verse number="6" style="v" sid="1PE 4:6"/>ሀይቅዳ አሳስ ዎንገላይ ሳባከትዳይ ሀይሳ ግሾሳ። ኤንቲ አሳ ባንታ አሹዋን ፕርደታና ቃስ ባንታ አያናን ፆሳ ደኦን ዳና።<verse eid="1PE 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7"/>ህዛ፥ ኡባባስ ዉርሰይ ማታትስ። ሄሳ ግሾ፥ ዎሳናዉ ዳንዳኤታና መላ ዎፑ ግዳ ዎዛን ደኦ፤ ማራራ ደእተ። <verse eid="1PE 4:7"/><verse number="8" style="v" sid="1PE 4:8"/>ሲቆይ ዳሮ ናጋራ ካምያ ግሾ፥ ኡባፈ አድ እሶይ እሱዋራ ዎዛናፐ ሲቀትተ።<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ሌም 10:12</ref>.</char></note> <verse eid="1PE 4:8"/><verse number="9" style="v" sid="1PE 4:9"/>ዙዙሞና እሶይ እሱዋ እማተን ሞክተ። <verse eid="1PE 4:9"/><verse number="10" style="v" sid="1PE 4:10"/>ህንተ ፆሳፈ ዱማ ዱማ አ ኬሀተ እሞታ ኤክዳይሳዳ ህንተ እሶይ እሶይ ሄ እሙዋ በሲያዳ ኦይክድ እሶይ እሱዋ ሀጋዝተ። <verse eid="1PE 4:10"/><verse number="11" style="v" sid="1PE 4:11"/>የሱስ ክርስቶሳ ባጋራ ኡባባን ፆሳይ ጋላተታና መላ ኦንካ ኦድያባ ግድኮ ፆሳፈ ቃላ ኤክዳዳ ኦዶ። ቃስ ኦንካ ማድያባ ግድኮ ፆሳይ እያዉ እምያ ዎልቃዳ ማዶ። ቦንቾይነ ዎልቅ መርናፐ መርና ጋካናዉ እያዉ ግዶ። አምንእ።<verse eid="1PE 4:11"/></para>
  <para style="s1">አማኖ ጋሶን ጋክያ ዋየ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12"/>ታ እሻቶ፥ ህንተ ታማዳ ፁግያ ዋየ ፓጭያ ግዶራ አያ ዎደ ኦራባይ ሀንዳዳ ማላለቶፍተ። <verse eid="1PE 4:12"/><verse number="13" style="v" sid="1PE 4:13"/>ሽን እያ ቦንቾይ ቆንጭያ ዎደ ህንተ ኡፋይሳይ ግታ ግዳና መላ ክርስቶሳ ዋይያ ህንተ ኤከይሳን ኡፋይትተ። <verse eid="1PE 4:13"/><verse number="14" style="v" sid="1PE 4:14"/>ክርስቶሳ ሱን ግሾ አስ ህንተና ጫይያ ዎደ፥ ፆሳ ቦንቾ አያናይ ህንተ ቦላ ሸምፕያ ግሾ ህንተ አንጀትዳይሳታ። <verse eid="1PE 4:14"/><verse number="15" style="v" sid="1PE 4:15"/>ህንተፈ ዋየ ኤክያ ኦንካ ሸምፖ ዎዳዳ ዎይኮ ካይሶትዳዳ ዎይኮ ኢታ ኦዳዳ ዎይኮ ገልሶናባን ገልዳዳ ሀንድ ዋየቶፎ። <verse eid="1PE 4:15"/><verse number="16" style="v" sid="1PE 4:16"/>ግዶሽን፥ ክርስታነ ግድያ ግሾ ዋየትኮ ክርስቶሳ ሱን ግሾ ፆሳ ጋላቶፐ አትሽን፥ ዬላቶፖ።<verse eid="1PE 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17"/>ፕርድ ፆሳ አሳ ቦላ ዶምያ ዎደይ ጋክስ። ህዛ፥ ሄ ፕርዳይ ኮይሮ ኑ ቦላ ዶምያባ ግድኮ፥ ፆሳ ዎንገላስ ኪተቶና አሳ ዉርሰይ አይ ግዳኔ? <verse eid="1PE 4:17"/><verse number="18" style="v" sid="1PE 4:18"/>ፅሎይ ኡንአን አትያባ ግድኮ፥ ማካላንቾይነ ናጋራንቾይ ያትን ዋናኔ?<note caller="-" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="PRO 11:31">ሌም 11:31</ref>.</char></note> <verse eid="1PE 4:18"/><verse number="19" style="v" sid="1PE 4:19"/>ሄሳ ግሾ፥ ፆሳ ሸነዳ ዋየ ኤከይሳት ባንታ ሸምፑዋ ባንታና መዳ፥ አማንያ ፆሳስ ሀዳራ እምሸ ሎኦባ ኦ።<verse eid="1PE 4:19"/></para>
  <chapter eid="1PE 4"/>
  <chapter number="5" style="c" sid="1PE 5"/>
  <para style="s1">ጭማታስነ ናአተታስ እመትዳ ዞረ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1"/>ህዛ፥ ዎሳ ኬ ጭማታራ ጭማ ግድዳይስ፥ ክርስቶሳ ዋይያ ማርካተይስነ ቆንጫናዉ ደእያ ቦንቹዋ ሻከታናዉ ደእያ ታኒ፥ ህንተ ግዶን ደእያ ጭማታ ዞራይስ። <verse eid="1PE 5:1"/><verse number="2" style="v" sid="1PE 5:2"/>ህንተ አዋተፈ ጋርሳን ደእያ ፆሳ ዉድያ ሄምተ። ፆሳይ ኮየይሳዳ ዶሳናፐ አትሽን፥ ኡንኤትድ ሄሞፍተ። ቃስ ሚሸ ኮሻን ግዶናሽን፥ ሀጋዛናዉ ደእያ ሎኦ ቆፋን ሄምተ።<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">ዮሀ 21:15-17</ref>.</char></note> <verse eid="1PE 5:2"/><verse number="3" style="v" sid="1PE 5:3"/>ህንተ አዋተፈ ጋርሳን ደእያ ዉድያስ ሌምሶ ግድተፐ አትሽን፥ ጎዳቶፕተ። <verse eid="1PE 5:3"/><verse number="4" style="v" sid="1PE 5:4"/>ሄመይሳታ ሀላቃይ ቆንጭያ ዎደ ቆለቶና ቦንቾ ካላቻ ህንተ ኤካና።<verse eid="1PE 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5"/>ሄሳዳካ፥ ያላጋቶ፥ ጭማታስ ሃረትተ። ህንተ እሶይ እሱዋስ አሽከ ግድተ። ጌሻ ማፃፋን፥ “ፆሳይ ኦቶራንቾታ እፄስ፥ ሽን አሽከታስ አ ኬሀተ እሜስ” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ሌም 3:34</ref>.</char></note> <verse eid="1PE 5:5"/><verse number="6" style="v" sid="1PE 5:6"/>ፆሳይ ባ ዎደ ህንተና ቦንቻና መላ ዎልቃማ ፆሳ ኩሽያፐ ጋርሳን ህንተና ካዉሽተ።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ 23:12</ref>፤ <ref loc="LUK 14:11">ሉቃ 14:11</ref>፤ <ref loc="LUK 18:14">18:14</ref>.</char></note> <verse eid="1PE 5:6"/><verse number="7" style="v" sid="1PE 5:7"/>እ ህንተዉ ቆፕያ ግሾ ህንተና ህርግስያ ኡባ እያ ቦላ የግተ።<verse eid="1PE 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8"/>ህንተ ሞርከይ ፃላሄይ፥ ምትያባ ኮይድ፥ ጋሞዳ ጉድሸ ህንተ ማታራ ዩይያ ግሾ ህንተና ሃርተነ ባርክተ። <verse eid="1PE 5:8"/><verse number="9" style="v" sid="1PE 5:9"/>አላመን ደእያ ህንተ እሻት ሄሳዳ ዋየ ኤከይሳ ኤርድ፥ አማኖን ምንድ፥ ፃላህያራ ኤቀትተ። <verse eid="1PE 5:9"/><verse number="10" style="v" sid="1PE 5:10"/>ባ መርና ቦንቹዋስ ክርስቶስ የሱሳ ባጋራ ህንተና ፄግዳ አ ኬሀተ ኡባ ፆሳይ፥ ጉ ዎደስ ህንተ ዋየትዳፐ ጉየ፥ እ ባ ሁጰን ህንተና ሺሻና፥ ካትሳና፥ ምንድ ኤሳና፥ ፃልሳና። <verse eid="1PE 5:10"/><verse number="11" style="v" sid="1PE 5:11"/>መርናፐ መርና ጋካናዉ ፆሳይ ካዎቶ። አምንእ።<verse eid="1PE 5:11"/></para>
  <para style="s1">ሳሮ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12"/>አማነትዳ እሻ ጋዳ ታ ኤክያ ስላሰ ባጋራ ሀ ዳብዳብያ ህንተዉ ቃንን ፃፋስ። ታ ሄሳ ህንተዉ ፃፍዳይ፥ ህንተና ዞራናዉነ ፆሳ አ ኬሀተይ ቱማ ግደይሳ ማርካታናሳ። ሄ አ ኬሀተን ምንድ ኤቅተ።<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="ACT 15:22">ሀዋ 15:22</ref>፥ <ref loc="ACT 15:40">40</ref>.</char></note><verse eid="1PE 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13"/>ህንተራ እስፈ ዶረትዳ ባብሎነን<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="fq" closed="false">ባብሎነን፦ </char><char style="ft" closed="false">ሀ በሳን ባብሎነ ጌተትዳይ ሮመ ካታማ ግዶና አገና።</char></note> ደእያ ዎሳ ኬ አሳይነ ታ ናኣ ማርቆስ ህንተና፥ “ሳሮ ሳሮ” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="ACT 12:12">ሀዋ 12:12</ref>፥ <ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13:13</ref>፤ <ref loc="ACT 15:37-39">15:37-39</ref>፤ <ref loc="COL 4:10">ቆላ 4:10</ref>፤ <ref loc="PHM 1:24">ፍልሞ 24</ref>.</char></note> <verse eid="1PE 5:13"/><verse number="14" style="v" sid="1PE 5:14"/>ሲቆ ዬረተ ዬረትሸ፥ እሶይ እሱዋ ሳሮተ።</para>
  <para style="p" vid="1PE 5:14">ክርስቶሳን ደእያ ህንተ ኡባስ ሳሮይ ግዶ። አምንእ።<verse eid="1PE 5:14"/></para>
  <chapter eid="1PE 5"/>
</usx>
