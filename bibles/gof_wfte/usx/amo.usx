<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">አሞፀ</para>
  <para style="toc1">አሞፀ ማፃፋ</para>
  <para style="toc2">አሞፀ</para>
  <para style="toc3">አሞ</para>
  <para style="mt">አሞፀ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">አሞፀይ ክ.የ.ስ. 760 ሄራን፥ ሆሰፐ ጉራ ስን ደንድድ፥ ፑደሀ ባጋ ካዎተ፥ እስራኤለ ቦላ ትንብተ ኦድዳ ናበ። እ ፄገታናፐ ስን መሄ ሄምያ አስ። እ ዱገሀ ካዎተን የለትኮካ፥ ጎዳይ እ ቤተለ ካታማ ብድ እስራኤለን ትንብተ ኦዳና መላ እያ ኪትስ። አሞፀይ፥ አራመይ፥ ፍልስፄመይ፥ ፅሮስ፥ ኤዶመይ፥ አሞነይ፥ ሞአበይነ ይሁድ ፕርደታናይሳ ኦድስ። ግዶሽን፥ አሞፀይ እስራኤለን ደእያ ዱረ አሳይ ማዶይ ባይና ማንቆታ ቆህያ ግሾ፥ እስራኤለይ ሴረታናዉ ደኤይሳ ባ አዱሳ ኪታን ቆንጭስስ።</para>
  <para style="ip">እስራኤለን፥ ቤተለ ጌሻ በሳን ኦያ ካህነት አሞፀይ ባንታ ቢታን ትንብተ ኦዶና መላ እያ ሞትዶሶና፤ ድጋናዉ ኮይዶሶና (7:10-17)። አሞፀ ኪታታ ግዶን ቆንጭድ በንትያ ኪታይ፥ “ሱረ ፕርድ ፑልቶ ሃዳ፥ ፅሎተ መሎና ሻፋ ሃዳ ጎጎ” ግድ እስራኤለ አሳ ናግስያ ኪታ።</para>
  <para style="ip">ጎዳይ እስራኤለ አሳ አላጋ ካዎተታ ግዶን ላላናይሳ ጉጅድ ኦድስ። ሽን ፆሳይ ባ ደርያ ዛሪድ ኤሀናዉነ ጋሽትሳናዉ ኡፋይሳ ቃላ እምዳይሳ ጉጅድ ኦዴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ካዎተታ ቦላ ኦደትዳ ፕርዳ (<char style="ior"><ref loc="AMO 1:1-3:2">1:1—3:2</ref></char>)</para>
  <para style="io1">እስራኤለይነ ሳማረይ ፕርደታና (<char style="ior"><ref loc="AMO 3:3-6:14">3:3—6:14</ref></char>)</para>
  <para style="io1">እስራኤለ ፕርዳ ማልያ እቻሹ ቆንጨታ (<char style="ior"><ref loc="AMO 7:1-9:10">7:1—9:10</ref></char>)</para>
  <para style="io1">እስራኤለስ ስንን ደእያ ኡፋይሳ (<char style="ior"><ref loc="AMO 9:11-15">9:11-15</ref></char>)</para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>ኦዝያን ይሁዳ ቢታን፥ እዮኣሳ ናአይ እዮርባም እስራኤለ ቢታን ካዎትዳ ላይን ታቆሀ ቢታን መሄ ሄመይሳታፐ እሶይ፥ አሞፀይ፥ ቢት ቃፃናፐ ናምኡ ላይፈ ስን እስራኤለባ ኦድዳ ትንብተይ ሀይሳ፦<verse eid="AMO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>እ፥</para>
  <para style="q1" vid="AMO 1:2">“ጎዳይ ፅዮነ ዙማ ቦላ ጉዴስ፤</para>
  <para style="q2" vid="AMO 1:2">የሩሳላመ ካታማን ደቼስ።</para>
  <para style="q1" vid="AMO 1:2">መሄ ሄምያ በሳት መሎሶና፤</para>
  <para style="q2" vid="AMO 1:2">ቃርመሎሳ ዙማ ቦላ ደእያ እርፃይ ሹሌስ” ያግስ።<verse eid="AMO 1:2"/></para>
  <para style="s1">እስራኤለ ሾሮ ካዎተት ፕርደታና</para>
  <para style="s2">ሶረ</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>ጎዳይ፥ “ዳማስቆ አሳይ ዛር ዛር ኦዳ ናጋራ ግሾ፥ ታኒ ኤንታ ሴሮና አግከ። ኤንቲ ጋላዳ ቢታ አሳ ብራታ አች ደእያ ጋረን ጎንዶርስድ የዶሶና። <verse eid="AMO 1:3"/><verse number="4" style="v" sid="AMO 1:4"/>ሄሳ ግሾ፥ ታኒ ካዋ ሀዛኤላ ኬን ታማ የዳና፤ ሄ ታማይ ካዋ በን-ሀዳዳ ሚፃታ ማና። <verse eid="AMO 1:4"/><verse number="5" style="v" sid="AMO 1:5"/>ታኒ ዳማስቆ ካታማ ፐንግያ መንና፤ አዌና ዛንጋራን ደእያ አሳ የደናነ ካዎታ ፃምኣ ኦይክዳይሳታ ቤት-ኤደናፐ ይሳና፤ ሶረ አሳይ ደኤትድ፥ ቂራ ባና” ያጌስ።<verse eid="AMO 1:5"/></para>
  <para style="s2">ፍልስፄመ</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6"/>ጎዳይ፥ “ጋዛ ካታማ አሳይ ዛር ዛር ኦዳ ናጋራ ግሾ፥ ታ ኤንታ ሴሮና አግከ። ኤንቲ ቢታን ደእያ አሳ ኡባ ድእድ፥ ኤዶመ ቢታ አሳስ ባይዝዶሶና። <verse eid="AMO 1:6"/><verse number="7" style="v" sid="AMO 1:7"/>ሄሳ ግሾ፥ ታኒ ጋዛ ካታማ ድርሳን ታማ የዳና፤ ሄ ታማይ ካታማ ሚፃታ ማና። <verse eid="AMO 1:7"/><verse number="8" style="v" sid="AMO 1:8"/>አሽዶዳን ደእያ አሳ ታኒ የደናነ ካዎታ ፃምኣ ኦይክዳይሳታ አስቃሎናፐ ይሳና። ኤቅሮና ካታማን ደእያ አሳ ሴራና፤ ፍልስፄመ አሳፐ አትዳይሳት ሀይቃና። ታኒ ኡባ ሃርያ ጎዳይ ሄሳ ኦዳይስ” ያጌስ።<verse eid="AMO 1:8"/></para>
  <para style="s2">ፅሮሳ</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>ጎዳይ፥ “ፅሮሳ ካታማ አሳይ ዛር ዛር ኦዳ ናጋራ ግሾ፥ ታኒ ኤንታ ሴሮና አግከ። ኤንቲ ጫቅዳ እሻተ ጫቁዋ መንድ፥ ደኤትዳ አሳ ኡባ ኤዶመ አሳስ ባይዝዶሶና። <verse eid="AMO 1:9"/><verse number="10" style="v" sid="AMO 1:10"/>ሄሳ ግሾ፥ ታኒ ፅሮሳ ካታማ ድርሳን ታማ የዳና፤ ሄ ታማይ ካታማ ሚፃታ ማና” ያጌስ።<verse eid="AMO 1:10"/></para>
  <para style="s2">ኤዶመ</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11"/>ጎዳይ፥ “ኤዶመ አሳይ ዛር ዛር ኦዳ ናጋራ ግሾ፥ ታኒ ኤንታ ሴሮና አግከ። ኤንቲ ባንታ እሻ እስራኤለ ማሻን የደዶሶና፤ ኤንቲ ኤንታዉ ቃትቦኮና፤ ኤንታ ይሎይ መርናዉ እርፀና። <verse eid="AMO 1:11"/><verse number="12" style="v" sid="AMO 1:12"/>ሄሳ ግሾ፥ ታኒ ተማና ካታማ ቦላ ታማ የድን፥ ሄ ታማይ ቦሶራ ካታማ ሚፃታ ማና” ያጌስ።<verse eid="AMO 1:12"/></para>
  <para style="s2">አሞነ</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13"/>ጎዳይ፥ “አሞነ አሳይ ዛር ዛር ኦዳ ናጋራ ግሾ፥ ታኒ ኤንታ ሴሮና አግከ። ኤንቲ ባንታ ዛዋ አሳናዉ ጋላዳ ቢታን ደእያ ቃንትዳ ማጫሳታ ኡሉዋ ዳክዶሶና። <verse eid="AMO 1:13"/><verse number="14" style="v" sid="AMO 1:14"/>ሄሳ ግሾ፥ ታኒ ራባ ካታማ ድርሳን ታማ የዳና፤ ሄ ታማይ ካታማ ሚፃታ ማና። ሄሳፈ ጉየ፥ ኦላ ጋላስ ዋሶይ ዳራና፤ ኦላንቾት ጎተዳ ዎልቃማና። <verse eid="AMO 1:14"/><verse number="15" style="v" sid="AMO 1:15"/>ኤንታ ካዎይነ እያራ ኦያ ሀላቃት ኡባይ ደኤትድ ባና” ያጌስ።<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="s2">ሞአበ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>ጎዳይ፥ “ሞአበ አሳይ ዛር ዛር ኦዳ ናጋራ ግሾ፥ ታኒ ኤንታ ሴሮና አግከ። ኤንቲ ኤዶመ ካዋ መቀይ ብዶ ግዳና ጋካናዉ ፁግዶሶና። <verse eid="AMO 2:1"/><verse number="2" style="v" sid="AMO 2:2"/>ሄሳ ግሾ፥ ታኒ ሞአበ ቢታን ታማ የዳና፤ ሄ ታማይ ቅርዮታ ካታማ ሚፃታ ማና። ኦላንቾታ ዋሱዋን፥ ሞይዘ ፑኑዋንነ ኦላ ግርሳን ሞአበ አሳይ ዉራና። <verse eid="AMO 2:2"/><verse number="3" style="v" sid="AMO 2:3"/>ታኒ ሞአበ ሃረይሳነ እያ ሞርናታ ኡባ ይሳና” ያጌስ።<verse eid="AMO 2:3"/></para>
  <para style="s2">ይሁዳ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4"/>ጎዳይ፥ “ይሁዳ አሳይ ዛር ዛር ኦዳ ናጋራ ግሾ፥ ታኒ ኤንታ ሴሮና አግከ። ኤንቲ ጎዳ ህግያ እፅዶሶና፤ እያ ኪታ ናግቦኮና። ኤንታ አዋት ካልዳ ዎርዶ ፆሳት ኤንታና ባለዶሶና። <verse eid="AMO 2:4"/><verse number="5" style="v" sid="AMO 2:5"/>ሄሳ ግሾ፥ ታኒ ይሁዳ ቦላ ታማ የዳና፤ ሄ ታማይ የሩሳላመ ሚፃታ ማና” ያጌስ።<verse eid="AMO 2:5"/></para>
  <para style="s2">እስራኤለ</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>ጎዳይ፥ “እስራኤለ አሳይ ዛር ዛር ኦዳ ናጋራ ግሾ፥ ታኒ ኤንታ ሴሮና አግከ። ኤንቲ ፅሉዋ ሚሸስ፥ ማንቁዋ ጫማስ ባይዞሶና። <verse eid="AMO 2:6"/><verse number="7" style="v" sid="AMO 2:7"/>ማንቆታ ቢታ ባናን የግድ፥ ኤንታ ሁጵያ የኦሶና፤ ኡንኤትዳይሳታ ፕርዳ ድጎሶና። አዋራነ ናኣራ እስ ማጫስ ላገድ ታ ጌሻ ሱን ቱንሶሶና። <verse eid="AMO 2:7"/><verse number="8" style="v" sid="AMO 2:8"/>ኤንቲ አሳፐ አጮስ ኦይክዳ ማኡዋ ያርሽያ በሳታን ኡባ ማታን ሂፅድ፥ ዝንኦሶና፤ ቃስ አሳፐ አጮስ ኤክዳ ዎይነ ኡሻ ባንታ ፆሳታ ኬን ኡዮሶና።<verse eid="AMO 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 2:9"/>“ግዶሽን፥ ህንተ ግሾ ጋዳ ዝጋዳ አዱቅዳ፥ ዎላዳ ምንዳ አሞረ አሳታ ህንተ ስንፈ ይስዳይ ታና። ታኒ ኤንታዉ ቦላ አይፍያ፥ ጋርሳ ፃጱዋ ኡባ ይሳስ። <verse eid="AMO 2:9"/><verse number="10" style="v" sid="AMO 2:10"/>ታኒ ህንተና ግብፀ ቢታፈ ከሳዳ፥ ባዞን ኦይታሙ ላይ ካለስ፤ አሞረታ ቢታ ህንተዉ ላታ ኦዳ እማስ። <verse eid="AMO 2:10"/><verse number="11" style="v" sid="AMO 2:11"/>ህንተ አደ ናይታ ግዶፈ ናበታ፥ ህንተ ናአተታ ግዶፈ ናዝራወታ ደንስ። እስራኤለ አሳዉ፥ ሄስ ቱማ ግደኔ? ታኒ ጎዳይ ሄሳ ኦዳስ። <verse eid="AMO 2:11"/><verse number="12" style="v" sid="AMO 2:12"/>ሽን ህንተ ናዝራወታ ጫቆ መንስድ፥ ዎይነ ኡሻ ኡሽደታ፤ ናበታ ትንብተ ኦዶና መላ ድግደታ።<verse eid="AMO 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 2:13"/>“ሄሳ ግሾ፥ ካ ዳርስድ ጫንዳ ጋረይ መኤይሳዳ ታኒ ህንተና መንና። <verse eid="AMO 2:13"/><verse number="14" style="v" sid="AMO 2:14"/>ጎባ ዎፀይስ ከስ ኤከና፤ ምኑዋስ ዎልቅ እፃና፤ ኦላንቾይ ባ ሸምፑዋ አሸና። <verse eid="AMO 2:14"/><verse number="15" style="v" sid="AMO 2:15"/>ዶንገን ዱከይስ ኤቃናዉ ዳንዳኤና፤ ጎባ ዎፅያ ኦላንቾይ ከስ ኤከና፤ ፓራዋይ ባ ሸምፑዋ አሸና። <verse eid="AMO 2:15"/><verse number="16" style="v" sid="AMO 2:16"/>ሄ ጋላስ ሀር አቶሽን ኦላንቾታ ግዶን ዳሮ ፃላ ጌተተይሳት ፅረ ካሎ ባቃታና” ያጌስ ጎዳይ።<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s1">እስራኤለ ቦላ ፄገትዳ ማርካታ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>ግብፀ ቢታፈ ህንተና ከስዳ፥ እስራኤለ አሳዉ፥ ጎዳይ ህንተዉ ኦደይሳ ስእተ። <verse eid="AMO 3:1"/><verse number="2" style="v" sid="AMO 3:2"/>ጎዳይ፥ “ሳአን ደእያ አሳ ኡባፈ ታኒ ህንተ ፃላላ ዶራስ። ሄሳ ግሾ፥ ህንተ ኦዳ ናጋራ ኡባስ ታኒ ህንተና ሴራና” ያጌስ።<verse eid="AMO 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3"/>ናምኡ አሳት ዎላ ባና ግድ ቆፋ ቃቾና ደእሸ እስፈ ሄመቶና?<verse eid="AMO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 3:4"/>ጋሞይ ዎ ደሞና ዎራን ጮ ጉድዬ? ዎይኮ ዎዳላ ጋሞይ አይኮ የደድ ኦይኮና ኡት ደንድድ ሳርቡቅዬ?<verse eid="AMO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 3:5"/>ካፎይ ፅሄይ ባይና ጮ ደንባን ኦይከትዬ? ዎይኮ ፅሄይ አይኮይ ቦቾና ጮ ፕርዬ?<verse eid="AMO 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 3:6"/>ካታማ ግዶን ኦላ ሞይዘይ ፑነትያ ዎደ አሳይ ያሻን ኮኮረነዬ? ዎይኮ ጎዳይ ኪቶና ደእሽን ዮይ እስ ካታማ ቦላ ዪዬ?<verse eid="AMO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 3:7"/>ቱማ ኡባ ሃርያ ጎዳይ ባ ፁራ ናበታስ፥ ባ ኦሳንቾታስ ካሰትድ ቆንጭሶና ደእሸ አይኮካ ኦና።<verse eid="AMO 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 3:8"/>ጋሞይ ጉድን ያዮናይ ኦኔ? ኡባ ሃርያ ጎዳይ ኦድን፥ ትንብተ ኦዶናይ ኦኔ?<verse eid="AMO 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9"/>አሽዶዳንነ ግብፀን ደእያ ሚፃ ኡባስ ሀይሳዳ ያግድ አዋጅተ፦ “ሳማርያ ደረታ ቦላ ሺቅድ፥ ያን ደእያ ኢታተነ ሱገ በእተ” ያግተ።<verse eid="AMO 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 3:10"/>“ሀ አሳይ ሎኦባ ኦ ኤሮኮና፤ ኢታተንነ ቦንቅድ ኤህዳ ሚሸን ባንታ ኬ ኩንሶና” ያጌስ ጎዳይ። <verse eid="AMO 3:10"/><verse number="11" style="v" sid="AMO 3:11"/>ሄሳ ግሾ፥ “ሞርከይ ህንተ ቢታ ተቃና፤ ህንተ ባሱዋ ላላና፤ ህንተ ኬ ቦንቃና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="AMO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12"/>“ሄንንቾይ ጋሞ ዶናፐ ናምኡ ሹቁለ ዎይኮ ዱፃ ሀይ የግስ ኤከይሳዳ፥ ሳማረ ቢታን እንጀ ዱሱ ደእያ እስራኤለ አሳፐ ጉት አታና” ያጌስ ጎዳይ።<verse eid="AMO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13"/>“ሀይሳ ስእድ ያይቆባ ኮቻታ ቦላ ሀይሳዳ ያግድ ማርካትተ። <verse eid="AMO 3:13"/><verse number="14" style="v" sid="AMO 3:14"/>ታኒ እስራኤለ አሳ ኤንታ ናጋራ ግሾ ሴርያ ዎደ፥ ቤተለ ካታማን ደእያ ያርሾ በሳታ ላላና፤ ያርሾ በሳን ደእያ ካጨት መእድ፥ ሳአን ዎና። <verse eid="AMO 3:14"/><verse number="15" style="v" sid="AMO 3:15"/>ኤንቲ ባልጎነ ቦነ ደእያ ኬታ ኡባ ታኒ ይሳና። ኤንቲ ዳንጋርሳ ዛለን አሌቅስድ፥ ኬፅዳ ኬ ላላና፤ ቃስ ግታ ግታ ኬት ኡባይ ያና” ያጌስ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ።<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="s1">እስራኤለይ ፆሳኮ ስምቤና</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1"/>ህንተኖ፥ ባሳነ ሚዛታዳ ሞዳ ሳማረ ማጫሳቶ፥ ሀይሳ ስእተ! ህንተ ማንቆታ ኡንኤታ፤ መቶታንቾታ ዋየታ። ህንተ አዝናታኮ፥ “ኑስ ኡሽ እምተ” ያጌታ። <verse eid="AMO 4:1"/><verse number="2" style="v" sid="AMO 4:2"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያግድ፥ ባ ጌሻተን ጫቅስ፥ “ህንተ ማንፃቆን ኦይከትድ ጎሸታና ጋላስነ ህንተፈ አትዳ ጉት ማንፃቆን ኦይከትድ ብያ ሞሎዳ ሀናና ጋላስ ያና። <verse eid="AMO 4:2"/><verse number="3" style="v" sid="AMO 4:3"/>ህንተ ኡባይ ድርሳ ፆኤራ ጎሸትድ፥ ከይድ፥ አርሞነ ሆለታና” ያግስ ።<verse eid="AMO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4"/>“ህንተኖ፥ እስራኤለ አሳዉ፥</para>
  <para style="q2" vid="AMO 4:4">ቤተለ ብድ ናጋራ ኦተ፤</para>
  <para style="q2" vid="AMO 4:4">ጋልጋላ ብድ ናጋራ ጉጅድ ኦተ።</para>
  <para style="q1" vid="AMO 4:4">ዎንታ ዎንታ ህንተ ያርሹዋ ያርሽተ፤</para>
  <para style="q2" vid="AMO 4:4">ሄን ጋላስ ጋላስ ህንተ አስራታ ኤህተ። <verse eid="AMO 4:4"/><verse number="5" style="v" sid="AMO 4:5"/>ህንተ ኦናዉ ዶሰይ ሄሳ ግድያ ግሾ፥</para>
  <para style="q1" vid="AMO 4:5">እርሾ የግድ ኡክዳ ኦይ ፁግድ፥ ጋላታ ያርሹዋ ያርሽተ።</para>
  <para style="q2" vid="AMO 4:5">ህንተ ህንተ ዶሳን እምያ እሙዋ ግሾ፥ ኦቶርትድ አዋጅተ” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="AMO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6"/>“ህንተ ካታማ ኡባን ታኒ ኮሻ የዳዳ፥ ሀር አቶሽን ህንተ አቻን ጋያባ ይሳስ፤ ሽን ህንተ ሄሳን ታኮ ስምበከታ። <verse eid="AMO 4:6"/><verse number="7" style="v" sid="AMO 4:7"/>ካ ጫክያ ዎደይ ጋካናዉ ቡሮ ሄ አጌን ደእሽን፥ ታኒ ህንተዉ እራ ተቃስ። ታኒ እስ ካታማን እራ ቡክሳዳ ሀራ ካታማን ቡኮናዳ ድጋስ፤ እስ ጎሻን ቡክስ፤ ሀራ ጎሻይ ቃስ እራ ይድ መልስ። <verse eid="AMO 4:7"/><verse number="8" style="v" sid="AMO 4:8"/>ሄሳ ግሾ፥ ናምኡ ዎይኮ ሄ ካታማ አሳይ ሃ ኡያናዉ እስ ካታማ ብዶሶና፤ ሽን አልቦኮና። ሄሳንካ ህንተ ታኮ ስምበከታ” ያጌስ ጎዳይ።<verse eid="AMO 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9"/>“ታኒ ህንተ ካ ቦላ ሀርገ የዳስ፤ ህንተ አታክልትያ፥ ህንተ ዎይንያ ህንተ ባላስያነ ህንተ ሻማሆ ኡባ ቦለይ ምስ፤ ሽን ህንተ ሄሳንካ ታኮ ስምበከታ” ያጌስ ጎዳይ።<verse eid="AMO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10"/>“ታኒ ግብፀ አሳ ቦላ ጋዶ የድዳይሳዳ፥ ህንተ ቦላ ጋዶ የዳስ። ህንተ ፓን ናይታ ማሻን ዎስ፤ ህንተ ፓራት ድኤታና መላ ኦስ። ህንተ ሞ አሀ ፅንቆን ኡላስ፤ ሽን ህንተ ሄሳንካ ታኮ ስምበከታ” ያጌስ ጎዳይ።<verse eid="AMO 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11"/>“ሶዶመነ ጋሞራ ካታማታ ይስዳይሳዳ ህንተፈ ዳሮታ ይሳስ፤ ህንተ ታማፐ አትዳ ዱንቻ መላ፤ ሽን ሄሳንካ ህንተ ታኮ ስምበከታ” ያጌስ ጎዳይ።<verse eid="AMO 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 4:12"/>ሄሳ ግሾ፥ “እስራኤለ አሳዉ፥ ታኒ ህንተና ሀይሳዳ ኦዳ ሴራና። ታኒ ህንተና ሀይሳዳ ኦዳ ሴራና ሀንያ ግሾ፥ እስራኤለ አሳዉ፥ ህንተ ፆሳራ ጋሄታናዉ ጊግተ” ያጌስ ጎዳይ።<verse eid="AMO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13"/>ደረታ ጊግስዳይ፥ ጫርኮ መዳይ፥</para>
  <para style="q2" vid="AMO 4:13">ባ ዎዛና ቆፋ አሳስ ቆንጭሰይ፥</para>
  <para style="q2" vid="AMO 4:13">ጋላሳ ፖኡዋ ማን ላመይ፥</para>
  <para style="q2" vid="AMO 4:13">ቢታ ቃ በሳታ ቦላ ሄመተይ፥</para>
  <para style="q2" vid="AMO 4:13">እያ ሱንይ ጎዳ፥ ኡባፈ ዎልቃማ ፆሳ።<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s1">እስራኤለይ ስማና መላ ኦይሸትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1"/>እስራኤለ አሳዉ፥ ታኒ ህንተዉ ዘሌልያ ዘለልሳ ስእተ!<verse eid="AMO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2"/>“ጌላእያ፥ እስራኤለይ ኩንዳሱ፤</para>
  <para style="q2" vid="AMO 5:2">ዛራዳ ደንዱኩ።</para>
  <para style="q1" vid="AMO 5:2">እያ ሳአን የገታሱ፤</para>
  <para style="q2" vid="AMO 5:2">እዮ ደንያ ኦንካ ባዋ” ያጋስ።<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>“እስራኤለ ካታማፐ ሙኩሉ ኦላንቾታ ኦላስ የድኮ፥ ፄቱ ኦላንቾታ ፃላል አታና፤ ካታማፐ ፄቱ ኦላንቾታ ኦላስ የድኮ፥ ታሙ ኦላንቾታ ፃላል አታና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>“ታና ኮይተ፤ ህንተ ደኦን ዳና። <verse eid="AMO 5:4"/><verse number="5" style="v" sid="AMO 5:5"/>ሽን ጋልጋል ድኤታና፤ ቤተለይ ያና ግሾ፥ ቤተለ ኮዮፕተ፤ ጋልጋላ ገሎፕተ። በርሳበ ፕኖፍተ” ያጌስ ጎዳይ።<verse eid="AMO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6"/>ጎዳ ኮይተ፤ ህንተ ደኦን ዳና። ሄሳ እፅኮ፥ እ ዮሰፋ ኮቻ ታማዳ ፁጋና፤ ቤተለን ደእያ አሳ ታም ማና። ሄ ታማ ቶይሳና አስ ባዋ።<verse eid="AMO 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 5:7"/>ህንተኖ፥ ሱረ ፕርዳ ምርቀይሳቶ፥ ፅሎተ ሳአን የገይሳቶ፥ ስእተ።<verse eid="AMO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8"/>ፕልያድሳ ጌተትያ ላፑን ፆልንቶታ ኦዳይ፥</para>
  <para style="q2" vid="AMO 5:8">ኦርዮና ጌተትያ ፆልንቶ ኮጫታ መዳይ፥</para>
  <para style="q2" vid="AMO 5:8">ማ ፖኦን፥ ጋላሳ ቃማን ላመይ፥</para>
  <para style="q2" vid="AMO 5:8">አባን ደእያ ሃታ ሳሎ ፑደ ፄግድ፥</para>
  <para style="q2" vid="AMO 5:8">ሳአ ምጨ ቦላ ዱገ ትገይ፥ እያ ሱንይ ጎዳ። <verse eid="AMO 5:8"/><verse number="9" style="v" sid="AMO 5:9"/>እ ሚፃታ ላላናዉ ዎልቃማታ ቦላ ጋዶ ኤሄስ።<verse eid="AMO 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10"/>ህንተና ፕርዳ ዳባባን ሴረይሳ እፄታ፤ ቱማ ኦደይሳ ካታ። <verse eid="AMO 5:10"/><verse number="11" style="v" sid="AMO 5:11"/>ህንተ ማንቆታ የድ፥ ኤንታ ካ ቦንቄታ። ያትድ ሹቻ ኬታ ግምብደታ፤ ሽን ህንተ እያን ደኤከታ። ሎኦ ዎይነ ቶክደታ፤ ሽን ህንተ ሄ ዎይነ ኡሻ ኡየከታ። <verse eid="AMO 5:11"/><verse number="12" style="v" sid="AMO 5:12"/>ህንተ ናቆይ አይ መላ ዳሮኮ፥ ህንተ ናጋራይ አይ መላ ግቴኮ ታኒ ኤራይስ። ህንተ ፅሎታ ናቀታ፤ ዎፈ ኤኬታ፤ ቃስ ዳባባን ማንቆታ ፕርዳ ናቀታ። <verse eid="AMO 5:12"/><verse number="13" style="v" sid="AMO 5:13"/>ሄሳ ግሾ፥ ዎደይ ኢታ ግድያ ግሾ፥ ሄሳ መላ ዎደን ጭንጫ አስ ስእ ጌስ።<verse eid="AMO 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14"/>ሎኦ ዶስተ፤ ኢታ እፅተ፤ ህንተ ደኦን ዳና። ሄሳ ኦኮ፥ ህንተ ገይሳዳ፥ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ ህንተራ ግዳና። <verse eid="AMO 5:14"/><verse number="15" style="v" sid="AMO 5:15"/>ኢታባ እፅተ፤ ሎኦባ ዶስተ። ፕርዳ በሳን ሱረ ፕርዳ ፕርድተ። ኦን ኤር ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ ዮሰፋ ኮቻፈ አትዳ ጉታስ ቃቶና አገና።<verse eid="AMO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16"/>ሄሳ ግሾ፥ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ “ዳባባ ኡባን ዋሶይ ስኤታና፤ ኦገ ኡባን ዘለልስ ዳራና። ጎሻንቾት ዬሆ፥ ዘሌልድ ዬክያ አሳይ ዘለልሳስ ፄገታና። <verse eid="AMO 5:16"/><verse number="17" style="v" sid="AMO 5:17"/>ታኒ ህንተና ሴራናዉ ህንተ ግዶራ አያ ግሾ፥ ዎይነ ጋደ ኡባን ዬሆይ ዳና” ያጌስ።<verse eid="AMO 5:17"/></para>
  <para style="s1">ጎዳ ጋላሳ</para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18"/>ህንተኖ፥ ጎዳ ጋላሳይ ያና መላ አሞተይሳቶ፥ ህንተና አየ! ጎዳ ጋላሳ አይስ አሞቴቲ? ሄ ጋላሳይ ፖኦ ግዶናሽን ማ ግዳና። <verse eid="AMO 5:18"/><verse number="19" style="v" sid="AMO 5:19"/>ሄ ጋላሳይ አስ ጋሞፈ ባቃትድ አትያ ዎደ ማሄይ ጋከይሳ መላ ቃስ ባ ሶ ገልድ፥ ባ ኩሽያ ጎዳ ቦላ ዘምፕስያ ዎደ ሾሽ ዱክያ አሳ መላ ግዳና። <verse eid="AMO 5:19"/><verse number="20" style="v" sid="AMO 5:20"/>ጎዳ ጋላሳይ ማ ግዳናፐ አትሽን፥ ፖኦ ግደና፤ ሄ ጋላሳይ ሳካና ማ ግዳናፐ አትሽን፥ ፖኦይ ባይና ጋላስ ግዳና።<verse eid="AMO 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21"/>“ታኒ ህንተ ቦንችያ ባለታ እፃይስነ ሻተታይስ፤ ህንተ ጌሻ ሺቆት ታና ኡፋይሶኮና። <verse eid="AMO 5:21"/><verse number="22" style="v" sid="AMO 5:22"/>ህንተ ታዉ ፁሳ ያርሾነ ካ ያርሾ ሺሽያ ዎደ ታኒ ኤክከ። ቃስ ህንተ ታዉ እስፈተ ያርሾስ ኤህያ ዶረትዳ ሞ መሄታ በእከ። <verse eid="AMO 5:22"/><verse number="23" style="v" sid="AMO 5:23"/>ህንተ ማዝሙረ ጫንጨ ታ ማታፐ ሃስተ፤ ህንተ ዲፅያ ዲ ስእከ። <verse eid="AMO 5:23"/><verse number="24" style="v" sid="AMO 5:24"/>ሽን ሱረ ፕርድ ፑልቶ ሃዳ፥ ፅሎተ መሎና ሻፋ ሃዳ ጎጎ።<verse eid="AMO 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25"/>“ህንተኖ፥ እስራኤለ አሳዉ፥ ታኒ ህንተና መላ ቢታን ኦይታሙ ላይ ካለያ ዎደ፥ ታዉ ያርሾ ሺሽደቲ? ዎይኮ እሞታ እምደቲ? <verse eid="AMO 5:25"/><verse number="26" style="v" sid="AMO 5:26"/>ሄ ዎደ ህንተ፥ ህንተ ኩሸን መዳ፥ ‘ካዋ ሳኩታ’ ጌተትያ ኤቃነ ‘ከዋና’ ጌተትያ ፆልንቶ ኤቃ ፆሳታ ቶክደታ። <verse eid="AMO 5:26"/><verse number="27" style="v" sid="AMO 5:27"/>ሄሳ ግሾ፥ ታኒ ህንተና ድእሳዳ ዳማስቆ ካታማፐ አዳ ሃሆ በሲ የዳና” ያጌስ እያ ሱንይ፥ ኡባፈ ዎልቃማ ፆሳ ጌተትያ ጎዳይ።<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s1">እስራኤለ አየ!</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1"/>ህንተኖ፥ አሳይ ማዶ ኦይችያ ቦንቸትዳ እስራኤለ ሀላቃቶ፥ ህንተኖ፥ ፅዮነን እንጀን ደኤይሳቶ፥ ሳማረ ካታማን ህርግ ባይና ኡትዳይሳቶ፥ ህንተና አየ! <verse eid="AMO 6:1"/><verse number="2" style="v" sid="AMO 6:2"/>አነ ካልነ ካታማ ብድ በእተ። ያፐ ግታ ሀማታ ካታማነ ፍልስፄመ ካታማ ጌተ ዎተ። ኤንቲ ህንተ ናምኡ ካዎተታፐ አና? ኤንታ ቢታይ ህንተ ቢታፈ ዳልጊ? <verse eid="AMO 6:2"/><verse number="3" style="v" sid="AMO 6:3"/>ህንተ፥ “ኢታ ጋላስ ኤለ ዬና” ግድ፥ ኢታ ኦሶ ኦይሳቶ፥ <verse eid="AMO 6:3"/><verse number="4" style="v" sid="AMO 6:4"/>ዛለፐ ኦሰትዳ አርሳን ዝንኤይሳቶ፥ እንጀን ኡትዳይሳቶ፥ ዶርሳ ዉድያፐ አንቃራታነ ሚዛ ዎድያፐ ጋታርመንዋ መይሳቶ፥ <verse eid="AMO 6:4"/><verse number="5" style="v" sid="AMO 6:5"/>ዳዊቲዳ የ ሚሸ ህንተዉ ጊግስድ፥ ዱማ ዱማ የ የፀይሳቶ፥ <verse eid="AMO 6:5"/><verse number="6" style="v" sid="AMO 6:6"/>ዎይነይ ኡሻ ከረራ ጋነይሳቶ፥ አልኦ ሽቶን ትየተይሳቶ፥ ዮሰፋ ኮቻታ ዩዋን አዛኖናይሳቶ፥ ህንተና አየ! <verse eid="AMO 6:6"/><verse number="7" style="v" sid="AMO 6:7"/>ሄሳ ግሾ፥ ኮይሮ ድኤታናይ ህንተና፤ ሄ ዎደ ህንተ እንጀ ዱሳይ አታና።<verse eid="AMO 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8"/>ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ ሀይሳዳ ያግድ፥ ባናን ጫቅስ፦ “ታኒ ያይቆባ ኦቶሩዋ እፃስ፤ ኤንታ ሚፃካ ሻተታስ፤ ታኒ ካታማነ ካታማን ደእያ ኡባ ኤንታ ሞርከታስ አዳ እማና” ያጌስ።<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>እስ ኬን ታሙ አስ አትኮ፥ ኤንትካ ሀይቃና። <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>ሀይቅዳይሳታ ዳቦታፐ እሶይ አሀ ሞጋናዉ ሶፐ ከስ ኤፍሸ፥ ሄ ኬን ቆሰትዳ ኡራኮ፥ “ኔራ አትዳ ሀራ አስ ደኢ?” ያግድ ኦይቻና። እ ዛሪድ፥ “ባዋ” ያጋና። ኦይቸይስ ዛሪድ፥ “ሀይዛ፥ ሀይዛ! ጎዳ ሱን ኑኒ ፄጋናዉ ኮሸና” ያጋና።<verse eid="AMO 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11"/>ጎዳ ኪታን፥ ግታ ኬት ላለታና፤ ላፋ ኬት መቀረታና። <verse eid="AMO 6:11"/><verse number="12" style="v" sid="AMO 6:12"/>ፓራት ዛላ ቦላ ጋላባናዉ ዳንዳኦና? ዎይኮ ጎሻንቾይ ቦር ዋፅድ፥ አባ ጎያናዉ ዳንዳኢ? ሽን ህንተ ሱረ ፕርዳ ጪየ፥ ፅሎተ ጫሞ ኦደታ። <verse eid="AMO 6:12"/><verse number="13" style="v" sid="AMO 6:13"/>ህንተ ሎዶባራ ካታማ ፆንዳ ግሾ ኡፋይተታ፤ ህንተ፥ “ኑኒ ቃርናይማ ካታማ ኑ ምኖተን ኦይክዳ” ግድ ጬቀተታ።<verse eid="AMO 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 6:14"/>“ህንተኖ፥ እስራኤለ አሳዉ፥ ታኒ ህንተ ቦላ ሀራ ካዎተ ደንና፤ ኤንቲ ህንተና ሀማታ ፕኑዋፐ ዶምድ፥ አራባ ዛንጋራ ጋካናዉ ኡንኤና” ያጌስ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ።<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s1">ቦለ፥ ታማነ የገ ዎዶሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>ኡባ ሃርያ ጎዳይ ታና ቆንጨ በስስ። ሄ ቆንጨን ታኒ ካዋ ጋክያ ካይ ጫከትዳፐ ጉየ፥ ናምአን ጫርዳ ዶላ ቦላ ፆሳይ ቦለ ዉደ መሽን በአስ። <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>ኤንቲ እርፃባ ኡባ ምድ ዉርስዳ ዎደ ታኒ፥ “አቤት፥ ኡባ ሃርያ ጎዳዉ፥ ሀያና ነ ደርያ ማራርክ! ያይቆባ ዛረት ዋንድ አታናዉ ዳንዳኦና? ኤንቲ ኡባ ጉ!” ያጋስ።<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>ሄሳ ግሾ፥ ጎዳይ ኤንታዉ ቃትድ፥ “ሀ ኔኒ በእዳባይ ፖለተና” ያግስ።<verse eid="AMO 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>ኡባ ሃርያ ጎዳይ ታና ሀራ ቆንጨ በስስ። ኡባ ሃርያ ጎዳይ ባ አሳ ፕርዳናዉ ታማ ፄግስ፤ ሄ ታማይ ግታ ጪሞ አባ ም ድግድ፥ ቢታ ማናዉ ዶምስ። <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>ታኒ፥ “አቤት፥ ኡባ ሃርያ ጎዳዉ፥ ሀያና ሀ ታማ ቶይሳርክ! ያይቆባ ዛረት ዋንድ አታናዉ ዳንዳኦና? ኤንቲ ኡባ ጉ!” ያጋስ።<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>ሄሳ ግሾ፥ ጎዳይ ቃትድ፥ “ሀይስ ፖለተና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="AMO 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>ቃስ ፆሳይ ታና ሀራ ቆንጨ በስስ። ታኒ ሄ ቆንጨን በእያ ዎደ፥ ጎዳይ ቱምበ ኦይክድ፥ ቱምበን ልከትድ ግምበትዳ ግምብያ ማታን ኤቅስ። <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>ጎዳይ ታኮ፥ “አሞፀ፥ ኔኒ አይ ፄላይ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="AMO 7:8">ታኒ፥ “ቱምበ ፄላይስ” ያጋስ።</para>
  <para style="p" vid="AMO 7:8">ጎዳይ ታኮ፥ “ሄኮ፥ ታኒ ታ አሰ ግድዳ እስራኤለ ግዶን ቱምበ የጋይስ፤ ታኒ ኤንታ ሴሮና አግከ። <verse eid="AMO 7:8"/><verse number="9" style="v" sid="AMO 7:9"/>ይሳቃ ኮቻት ጎይንያ ቃ በሳት ላለታና፤ እስራኤለ ጌሻ በሳት ያና፤ እዮርባማ ካዎተ ቦላ ታኒ ማሻራ ደንዳና” ያግስ።<verse eid="AMO 7:9"/></para>
  <para style="s1">አሞፀነ አማስያሳ</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>ቤተለ ካታማን ካህነ ግድድ ደእያ አማስያስ እስራኤለ ካዋ እዮርባማኮ ሀይሳዳ ያግድ ኪትስ፦ “አሞፀይ እስራኤለ አሳ ግዶን ደእሸ፥ ነ ቦላ ማቀቴስ፤ እ ባ ኦዳን ቢታ ይሴስ። <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>እ፥ ‘እዮርባም ማሻን ሀይቃና፤ እስራኤለ አሳይ ባንታ ቢታፈ ድኤትድ ባና’ ያጌስ” ያግስ።<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>አማስያስ አሞፀኮ፥ “ነኖ ትንብተ ኦደይሶ፥ ባ፤ ይሁዳ ቢታ ባዳ፥ ያን ኦዳ አቃ፤ ያን ትንብተ ኦዳ። <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>ሽን ቤተለይ ካዎይ ጎይንያ በስነ ካዎተ ኬ ግድያ ግሾ፥ ናምአን ሀ በሳን ትንብተ ኦዶፓ” ያግስ።<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>አሞፀይ ዛሪድ፥ “ታኒ መህያ ሄምያነ ቦባ አይፈ ማፅያ አሰፐ አትሽን፥ ናበ ዎይኮ ናበ ናአ ግድከ። <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>ሽን ጎዳይ ታና ዶርሳ ዉደ ሄምያ በሳፈ ኤክድ፥ ‘ባዳ ታ አሳ እስራኤለስ ትንብተ ኦዳ’ ያግስ። <verse eid="AMO 7:15"/><verse number="16" style="v" sid="AMO 7:16"/>ሀእ ህዛ ጎዳይ ግያባ ስአ! ኔኒ፥ ‘እስራኤለ ቦላ ትንብተ ኦዶፓ፤ ይሳቃ ኮቻታ ሳባኮፓ’ ያጋዳሳ። <verse eid="AMO 7:16"/><verse number="17" style="v" sid="AMO 7:17"/>ሄሳ ግሾ፥ ጎዳይ፥ ‘ነ ማችያ ካታማ ግዶን ላይማ ግዳና፤ ነ አደ ናይትነ ነ ማጫ ናይት ማሻን ሀይቃና። ነ ቢታይ ዎዶሮን ሻከታና፤ ቃስ ኔኒ ነ ሁጰን አላጋ ቢታን ሀይቃና። ስይ ባይና እስራኤለ አሳይ ባንታ ቢታፈ ድኤትድ ባና’ ያጌስ” ያግስ።<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s1">ቴራ አይፈይ ኩምዳ ዳቾ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>ኡባ ሃርያ ጎዳይ ታና ሀራ ቆንጨ በስስ፤ ሄስካ፥ ቴራ አይፈይ ኩምዳ ዳቾ በስስ። <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>እ ታኮ፥ “አሞፀ፥ ኔኒ አይ በአይ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="AMO 8:2">ታኒ፥ “ቴራ አይፈይ ኩምዳ ዳቾ በአይስ” ያጋስ።</para>
  <para style="p" vid="AMO 8:2">ጎዳይ ታኮ፥ “ታ አሳ እስራኤለ ዉርሰይ ጋክስ፤ ህዛፐ ጉየ ታኒ ኤንታ ሴሮና አግከ” ያግስ።<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>ኡባ ሃርያ ጎዳይ፥ “ሄ ጋላስ ካዎ ኬን የፅያ የይ ዬሆን ላመታና፤ አሳ አህ ዱማ ዱማ በሳን ዎና፤ ዬሆይ ዋሶይ ባይና ስእ ግድ የገታና” ያጌስ።<verse eid="AMO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4"/>ህንተኖ፥ መቶታንቾታ ኡንኤይሳቶ፥ ቢታን ደእያ ማንቆታ ይሳናዉ ኮየይሳቶ፥ ሀይሳ ስእተ! <verse eid="AMO 8:4"/><verse number="5" style="v" sid="AMO 8:5"/>ህንተ፥ “ኑኒ ካ ባይዛናዉ አጌና ፄሮ ባለይ አዉደ አነ! ቃስ ኑኒ ኑ ዛልእያ ዶማናዉ ሳምባት አዉደ አነ! ኑኒ ካ ጉባን ማክድ፥ ዳሮ ሚሸን ባይዛና። ቃስ ዎርዶ ምዛነን አሳ ጭማና። <verse eid="AMO 8:5"/><verse number="6" style="v" sid="AMO 8:6"/>ማንቁዋ ብራን፥ መቶታንቹዋ ዋ ጫማን ሻማና፤ ቃስ ሀርቆ ግስተ ሙሩቶ ግስተ ጋተን ባይዛና” ያጌታ።<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>ያይቆብ እያ ሱንን ጬቀትያ ጎዳይ፥ ፆሳይ፥ ሀይሳዳ ያግድ ባ ሁጰን ጫቅስ፦ “ታኒ ኤንቲ ኦዳ ኢታ ኦሶ ኡባ ዶግከ። <verse eid="AMO 8:7"/><verse number="8" style="v" sid="AMO 8:8"/>ሄሳ ጋሶን ቢታይ ያርኬስ፤ አሳ ኡባይ ዬኬስ። ናይለ ሻፋይ ክፅድ ከየይሳዳነ ዎይሳዳ ቢታ ኡባይ ቃፃናነ ስም ዎና” ያግስ።<verse eid="AMO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9"/>ኡባ ሃርያ ጎዳይ፥ “ሄ ጋላስ ታኒ አዋ ሴታ ጋላስ ዉልሳና፤ ጋላሳ ቃምሳና። <verse eid="AMO 8:9"/><verse number="10" style="v" sid="AMO 8:10"/>ታኒ ህንተ ኡፋይሳ ባልያ አዛኖን፥ ህንተ የ ዬሆን ላማና። ፐፅ እስ ናእ ሀይቅን ዬክያ አሳዳ፥ ህንተ ህንተ ሁጵያ ሜደትድ ካዮ ማኦ ማአናዳ፥ ህንተና ኦና። ሄ ጋላሳ ዉርሰይ ዳሮ ጫሞ ግዳና” ያጌስ።<verse eid="AMO 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 8:11"/>ኡባ ሃርያ ጎዳይ፥ “ሄኮ፥ ታኒ ቢታ ኡባ ቦላ ኮሻ የድያ ዎደይ ያና። ሄ ኮሻይ ካ ዎይኮ ሃ ኮሻ ግዶናሽን፥ ስአናዉ ጎዳ ቃላ ዮ ኮሻ ግዳና። <verse eid="AMO 8:11"/><verse number="12" style="v" sid="AMO 8:12"/>አሳይ ዶሎሀፐ ዉሎሀ ጋካናዉ፥ ፑደሀፐ ዱገሀ ጋካናዉ ዎፀረታና። ኤንቲ ጎዳ ቃላ ኮያናዉ ያነ ሃነ ዎፃና፥ ሽን ደሞኮና። <verse eid="AMO 8:12"/><verse number="13" style="v" sid="AMO 8:13"/>ሄ ጋላስ የገልሳ ጌላኦትነ ዎልቃማ ፓንት ሳሞን ፕቅ ጋና። <verse eid="AMO 8:13"/><verse number="14" style="v" sid="AMO 8:14"/>ሳማረ ኤቃታራ ጫቅዳይሳት፥ ‘ዳና ፆሳይ ኤሮ!’ ያገይሳት፥ ‘በርሳበ ፆሳይ ኤሮ’ ያገይሳት ኩንዳና። ኤንቲ ዛር ደንዶኮና” ያጌስ።<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s1">እስራኤለይ ፕርደታና</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>ታኒ ጎዳይ ያርሾ በሳ ማታን ኤቅዳሽን በአስ። እ ታኮ፥ “ባሶይ ቃፃና ጋካናዉ ፆሳ ኬ ጉምቡዋ ሾጫዳ አሳ ኡባ ሁጰን መንረ። ሄሳፈ አትዳ አሳ ታኒ ማሻን ዎና። ባቃትያ አስ ከስ ኤከና፤ ከስ ኤክዳ አስካ ፓፃ አተና። <verse eid="AMO 9:1"/><verse number="2" style="v" sid="AMO 9:2"/>ኤንቲ ቢታ ቦክድ፥ ስኦለን ዎኮካ፥ ታኒ ኤንታና ያፐ ከሳና። ሳሉዋ ከይኮካ፥ ታኒ ኤንታ ያፐ ዎሳና። <verse eid="AMO 9:2"/><verse number="3" style="v" sid="AMO 9:3"/>ኤንቲ ቃርመሎሳ ዙማ ሁጰን ቆሰትኮካ፥ ታኒ ኤንታ ኮያዳ ያፐ ከሳና። አባ ጪሞን ገልድ፥ ታ ስንፈ ጌምኮካ፥ ታኒ ዳወ ኪትን፥ እ ኤንታ ዱካና። <verse eid="AMO 9:3"/><verse number="4" style="v" sid="AMO 9:4"/>ኤንቲ ባንታ ሞርከታን ድኤትድ፥ ቢኮካ፥ ያን ኤንቲ ማሻን ሀይቃናዳ ኪታና፤ ታኒ ኤንታ ኢታ አይፈን ፄላና፤ ኤንታ ሎኦ አይፈን ፄልከ” ያግስ።<verse eid="AMO 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 9:5"/>ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ ሳኣ ቦችን ሳእ ትልኤስ፤ ቃስ ሳአን ደእያ ኡባይ ዬኬስ። ናይለ ሻፋይ ክፅድ ከየይሳዳነ ዎይሳዳ ቢታ ኡባይ ቃፃናነ ስም ዎና። <verse eid="AMO 9:5"/><verse number="6" style="v" sid="AMO 9:6"/>ባ ኬ ሳሎን ኬፅዳይ፥ እያ ባሱዋ ሳአን ኤስዳይ፥ አባ ሃ ፄግድ፥ ቢታ ቦላ ዱገ ቡክሰይ፤ እያ ሱንይ ጎዳ።<verse eid="AMO 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7"/>ጎዳይ፥ “እስራኤለ አሳዉ፥ ህንተ ታዉ ቶጰ አሳ መላ ግደከትዬ? ታኒ ህንተና ግብፀ ቢታፈ ከስዳይሳዳ፥ ፍልስፄመ አሳ ካፍቶራፐ፥ ቃስ ሶረ አሳ ቂራፐ ከሳብክና?” ያጌስ።<verse eid="AMO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 9:8"/>ጎዳይ፥ “ሄኮ፥ ኡባ ሃርያ ጎዳ አይፈይ ናጋራንቾ ካዎተ ቦላ ደኤስ። ታኒ እያ ቢታ ቦላፈ ይሳና፤ ሽን ታኒ ያይቆባ ኮቻ ኡባ ይስከ። <verse eid="AMO 9:8"/><verse number="9" style="v" sid="AMO 9:9"/>ታኒ ካ ዛርዛረን ሀርቀተይሳዳ እስራኤለ አሳይ ካዎተታ ኡባ ግዶን ላለታና መላ ኪታና። ሽን ኤንታ ግዶን አማነትዳይሳታፐ እሶይካ ሳአን ዎድ የና። <verse eid="AMO 9:9"/><verse number="10" style="v" sid="AMO 9:10"/>‘ኑና አይባ ኢትካ ጋከና ዎይኮ ደመና’ ግያ ታ አሳ ግዶን ደእያ ናጋራንቾት ኡባይ ማሻን ዉራና” ያጌስ።<verse eid="AMO 9:10"/></para>
  <para style="s1">እስራኤለይ ዛሪድ ደንዳና</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11"/>“ሄ ጋላስ ታኒ ኩንድዳ ዳዊታ ካዎተ ደንና። ድርሳ ግምበታ ዛራ ኤሳና፤ ላለትዳ በሳታ ኦራና፤ ታኒ እያ ካሰይሳዳ ኦዳ ኬፃና። <verse eid="AMO 9:11"/><verse number="12" style="v" sid="AMO 9:12"/>ሄስካ ኤዶመፐ አትዳይሳታነ ታ ሱንን ፄገትዳ ካዎተታ ኡባ ላታና” ያጌስ ሄሳ ኦያ ጎዳይ።<verse eid="AMO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13"/>“ካ ጫከይሳት ጫክ ዉርሶና ደእሽን፥ ጎየይሳት ጋክያ ዎደይ፥ ዎይነ ጉምኤይሳት ጉምእድ ዉርሶና ደእሽን፥ ዎይነ ቶከይሳት ጋክያ ዎደይ ያና። ሄ ዎደ ደረት ማልኦ ዎይነ ኡሽ ፑልታና፤ ዙማት ዎይነ ኡሻን ምተታና። <verse eid="AMO 9:13"/><verse number="14" style="v" sid="AMO 9:14"/>ድኤትድ ብዳ ታ አሳ እስራኤለ ዛራና፤ ኤንቲ ላለትዳ ካታማታ ዛር ኬፅድ ዳና። ዎይነ ቶክድ እያፐ ዎይነ ኡሻ ኡያና፤ አታክልተ ቶክድ ኤንታ አይፍያ ማና። <verse eid="AMO 9:14"/><verse number="15" style="v" sid="AMO 9:15"/>ታኒ ታ አሳ፥ እስራኤለ ኤንታ ቢታን ቶካና፤ ኤንቲ ታኒ ኤንታዉ እምዳ ቢታፈ ዛሪድ ሾደቶኮና” ያጌስ ሄሳ ኦያ ጎዳይ።<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
