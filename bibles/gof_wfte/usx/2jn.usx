<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">2 ዮሃንሳ ኪታ</para>
  <para style="toc1">2 ዮሃንሳ ኪታ</para>
  <para style="toc3">2 ዮሀ</para>
  <para style="toc2">2 ዮሃንሳ</para>
  <para style="mt1">ዮሃንስ ፃፍዳ</para>
  <para style="mt2">ናምአን ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ዮሃንስ ፃፍዳ ናምአን ኪታ፥ የሱሳ ሀዋረ ግድዳ ጭማይ፥ ዮሃንስ ፃፍስ። ሀ ኪታይ ፃፈትዳይ ዶረትዳ ጎዳተሳነ እ ናይታሳ። ሀ ቃን ኪታይ ፃፈትዳይ፥</para>
  <para style="ipi">1. ኤንቲ እሶይ እሱዋራ ሲቀታና መላ አኬክሳናሳ፤</para>
  <para style="ipi">2. ዎርዶ አስታማረታፐነ ኤንታ ትምርትያፈ ናገታና መላ ቆፍሳናሳ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሳሮነ ዎሳ (1-3)</para>
  <para style="io1">ሲቆነ ቱማተ (4-6)</para>
  <para style="io1">ዎርዶ ትምርተፈ ናገተ (7-11)</para>
  <para style="io1">ሳሮ (12-13)</para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>ታ ጭማይ ዶረትዳ ጎዳተስነ እ ናይታስ ኪትዳ ኪታ። ታ ፃላላ ግዶናሽን፥ ቱማ ኤርያ ኡባይ ህንተና ዶሶሶና። <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>ሀ ቱማይ ኑናን ደእያ ግሾነ መርናዉ ኑራ ዳና ግሾ ታኒ ህንተና ቱማ ዶሳይስ።<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>ፆሳ ኑ አዋነ እያ ናኣ የሱስ ክርስቶሳ አ ኬሀተይ፥ ማሮተይነ ሳሮተይ ቱማንነ ሲቆን እስፈ ኑራ ግዶ።<verse eid="2JN 1:3"/></para>
  <para style="s1">ቱማነ ሲቆ</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>አዋይ ኑና ኪትዳይሳዳ፥ ነ ናይታፐ ባጋት፥ ቱማስ ኪተተይሳ በአዳ ታኒ ዳሮ ኡፋይታስ። <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>ጎዳተ፥ ሀእካ ኑኒ ኡባይ እሶይ እሱዋ ሲቃና መላ ታኒ ነና ዎሳይስ። ሀ ኪታይ ኮይሮፐ ኑራ ደእያ ኪታፐ አትሽን፥ ታኒ ነዉ ኦራ ኪታ ፃፍከ።<note caller="-" style="x"><char style="xo" closed="false">5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሀ 13:34</ref>፤ <ref loc="JHN 15:12">15:12</ref>፥ <ref loc="JHN 15:17">17</ref>.</char></note> <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>ቱማ ሲቆይ ኑኒ ፆሳ ኪታ ናግድ ዳናይሳ። ቃስ ኮይሮፐ ህንተ ስእዳይሳዳ እያ ኪታይ፥ ህንተ ኡባይ ሲቆን ዳና መላሳ።<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>የሱስ ክርስቶሲ አሰ ግድድ ይዳይሳ አማኖና፥ ዳሮ ባለያ አሳት፥ አላመን ደንድዶሶና። ሄሳ መላ አስ ኦንካ ባለይሳነ ክርስቶሳ ሞርከ። <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>ህንተ ኦዳ ኩመ ዎይቱዋ ኤካናዉ ምንተ። ህንተ ኦዳይስ ዮና መላ ናገትተ።<verse eid="2JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9"/>ክርስቶሳ ትምርትያን ዶናይሳስነ እያፐ ሃክያ ኡራስ ፆሳይ ባዋ። ክርስቶሳ ትምርትያን ደእያ ኡራስ አዋይነ ናአይ ደኦሶና። <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>ኦንካ ህንተኮ ይሸ ሀ ትምርትያ ኤሆና እፅኮ፥ ህንተ ሶ ገልሶፍተ፤ ሳሮካ ጎፕተ። <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>እያ ሳሮ ግያ ኦንካ እያ ኢታ ኦሱዋን እያራ ሻከቴስ።<verse eid="2JN 1:11"/></para>
  <para style="s1">ሳሮ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>ታኒ ህንተዉ ፃፋናዉ ኮይዳ ዳሮባይ ደኤስ፥ ሽን ዎርቃተንነ ቃላመን ፃፋናዉ ኮይከ። ኑ ኡፋይሳይ ፖለታና መላ ህንተራ ሶምኦን ጋሄታዳ ኦደታናዉ ህንተኮ ባና ጋዳ ቆፓይስ።<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>ፆሳይ ዶርዳ ነ ምቸ ናይት ነና ሳሮ ያጎሶና።<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
