<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ሌወታ ማፃፋ</para>
  <para style="toc1">ሌወታ ማፃፋ</para>
  <para style="toc3">ሌወ</para>
  <para style="toc2">ሌወታ</para>
  <para style="mt">ሌወታ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሌወታ ማፃፋይ፥ ሌወ ኮቻፈ ግድዳ ሌወት ዋትዲ ባንታ ኦሱዋ ኦነኮ ቆንጭሴስ። ሄ ኦሶታፐ ኮይሮይ፥ አሳይ ኩመ ፃላተን ፆሳኮ ሺቃና መላ ያርሾ ሺሾ፤ ናምአንይ፥ ቱናነ ቱና ግዶናባታ ሻክድ አሳ ፆሳ ስንን ቱናተፈ ጌሾ።</para>
  <para style="ip">ማፃፋስ ጉልአ ቆፋይ ፆሳ ጌሻተ። “ታኒ፥ ጎዳይ፥ ህንተ ፆሳይ፥ ጌሽ ግድያ ግሾ፥ ህንተካ ጌሽ ግድተ” ያግስ። ቃስ ፆሳ አሳይ ሀ ጌሽ ግድዳ እስራኤለ ፆሳራ ሽጵ ግድ ዳና መላነ ዋንድ እያ ጎይናናዉ በሲያኮ ፓድድ በሴስ።</para>
  <para style="ip">ሌወታ ማፃፋን ዳሮ ኤረትዳ ኪታይ፥ የሱሲ ግታ ኪታ ግድ ናምአን ደን ዎዳ፥ “አሰ ኡባ ነ ሁጰዳ ዶሳ” ጌተትድ ፃፈትዳ ቃላ (<char style="xt"><ref loc="LEV 19:18">ሌወ 19:18</ref></char>)።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ያርሾ ዎጋታ (<char style="ior"><ref loc="LEV 1:1-7:38">1:1—7:38</ref></char>)</para>
  <para style="io1">ካህነታ ሹሞ ዎጋ (<char style="ior"><ref loc="LEV 8:1-36">8:1-36</ref></char>)</para>
  <para style="io1">አሮና ያርሹዋ (<char style="ior"><ref loc="LEV 9:1-24">9:1-24</ref></char>)</para>
  <para style="io1">ናምኡ ካህነታ ሀይቁዋ (<char style="ior"><ref loc="LEV 10:1-20">10:1-20</ref></char>)</para>
  <para style="io1">ቱናነ ቱና ግዶናባታ (<char style="ior"><ref loc="LEV 11:1-15:33">11:1—15:33</ref></char>)</para>
  <para style="io1">አቶተ ጋላስነ እያ ዎጋታ (<char style="ior"><ref loc="LEV 16:1-34">16:1-34</ref></char>)</para>
  <para style="io1">ዱማ ዱማ ህገታ (<char style="ior"><ref loc="LEV 17:1-20:27">17:1—20:27</ref></char>)</para>
  <para style="io1">ዱማ ዱማ ባለታ ቦንቾ ዎጋ (<char style="ior"><ref loc="LEV 21:1-25:55">21:1—25:55</ref></char>)</para>
  <para style="io1">አንጆነ ሴራ (<char style="ior"><ref loc="LEV 26:1-46">26:1-46</ref></char>)</para>
  <para style="io1">ቃላ ጫቆነ ያርሾ ዎጋታ (<char style="ior"><ref loc="LEV 27:1-34">27:1-34</ref></char>)</para>
  <chapter number="1" style="c" sid="LEV 1"/>
  <para style="s1">ፁሳ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1"/>ጎዳ ፆሳይ፥ ጌሻ ዱንካንያ ግዶን ግድድ ሙሰ ፄግድ ያግስ፤ <verse eid="LEV 1:1"/><verse number="2" style="v" sid="LEV 1:2"/>እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ ህንተፈ ኦንካ ጎዳስ ያርሾ ያርሽያ ዎደ ባ መህያፐ፥ ባ ዶርሳፈነ ባ ዴሻፐ ኤሆ። <verse eid="LEV 1:2"/><verse number="3" style="v" sid="LEV 1:3"/>ሄ ያርሾይ መሄፐ ፁሳ ያርሾስ ግድኮ ቦረይ ባይና ዎፋኖ ግዶ። ጎዳይ ሄ ያርሹዋ ኤካና መላ ጌሻ ዱንካንያ ገልያ ፐንገን ያርሾ። <verse eid="LEV 1:3"/><verse number="4" style="v" sid="LEV 1:4"/>ያርሹዋ ያርሽያ ኡራይ ፁሳ ያርሾስ ኤህዳ መህያ ሁጰን ባ ኩሽያ ዎ። ሄስ እያ ናጋራ አቶተስ ጎዳይ ኤክዳ ያርሾ ግዳና። <verse eid="LEV 1:4"/><verse number="5" style="v" sid="LEV 1:5"/>እ ሄ ዎፋኑዋ ጎዳ ስንን ሹኮ፤ ካህነት፥ አሮና ናይት ሄ ሱ ኤክድ፥ ጌሻ ዱንካነ ገልያ ፐንገን ደእያ ያርሾ በሳ ኦይዱ ማዛነታ ቦላ ዉርፆ። <verse eid="LEV 1:5"/><verse number="6" style="v" sid="LEV 1:6"/>ሄ መህያ ጋልባ ቃርድ፥ አሹዋ ቆሞን ቆሞን ከሶ። <verse eid="LEV 1:6"/><verse number="7" style="v" sid="LEV 1:7"/>ካህንያ አሮና ናይት ያርሾ በሳን ም ዎድ ታማ ኤ። <verse eid="LEV 1:7"/><verse number="8" style="v" sid="LEV 1:8"/>ካህነት፥ አሮና ናይት ሄ ከስዳ አሹዋ ቦላ ሁጵያነ ሞዋ ጉጅድ፥ ያርሾ በሳን ታማን ደእያ ም ቦላ ማራይድ ዎ። <verse eid="LEV 1:8"/><verse number="9" style="v" sid="LEV 1:9"/>ሽን ሄ ኡራይ ኡሎ አሹዋነ ገዳታ ሃን ሜጮ። ካህነይ ሄ ኡባ ያርሾ በሳን ፁጎ፤ ሄስ ጎዳስ ታማን ፁገትያ ሳዎ ቶንኩ ግያ ያርሾ ግዳና።<verse eid="LEV 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10"/>ፁገትያ ያርሾስ እ እምያ እሞይ ዶርሳፈ ዎይኮ ዴሻፐ ግድኮ፥ ቦረይ ባይና ማራዘ ዎይኮ ኮለ ግዶ። <verse eid="LEV 1:10"/><verse number="11" style="v" sid="LEV 1:11"/>ሄ መህያ ያርሾ በሳፈ ፑደሀ ባጋራ ጎዳ ስንን ሹኮ። ካህነት፥ አሮና ናይት ሄ ሱ ኤክድ ያርሾ በሳ ኦይዱ ማዛነታ ኡባ ቦላ ዉርፆ። <verse eid="LEV 1:11"/><verse number="12" style="v" sid="LEV 1:12"/>ሄ ኡራይ አሹዋ ቆሞን ቆሞን ከሶ፤ ካህነይ ሄ ከስዳ አሹዋ ቦላ ሁጵያነ ሞዋ ጉጅድ፥ ያርሾ በሳን ታማን ደእያ ም ቦላ ማራይድ ዎ። <verse eid="LEV 1:12"/><verse number="13" style="v" sid="LEV 1:13"/>ሽን ሄ ኡራይ ኡሎ አሹዋነ ገዳታ ሃን ሜጮ፤ ካህነይ ሄ ኡባ ያርሾ በሳን ፁጎ፤ ሄስ ጎዳስ ታማን ፁገትያ ሳዎ ቶንኩ ግያ ያርሾ ግዳና።<verse eid="LEV 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14"/>ጎዳስ ያርሸትያ ፁሳ ያርሾይ ካፎ ግድኮ ሆለ ዎይኮ ኩራቾ ግዶ። <verse eid="LEV 1:14"/><verse number="15" style="v" sid="LEV 1:15"/>ካህነይ ሄሳ ኤክድ ቆያ ኩሸራ ዱ፤ ሁጵያ ያርሾ በሳ ቦላ ደእያ ታማን ፁጎ። እያ ሱይ ያርሾ በሳ ምየራ ጉኮ። <verse eid="LEV 1:15"/><verse number="16" style="v" sid="LEV 1:16"/>ኡሎ አሹዋነ ቀፍያ ከስድ፥ ያርሾ በሳፈ ዶሎሀ ባጋራ ብዶ ቆልያ በሳን የጎ። <verse eid="LEV 1:16"/><verse number="17" style="v" sid="LEV 1:17"/>እ ሄ ካፉዋ ቀፈታ ኦይክድ ሻኮ፥ ሽን ኩመ ሻኮፎ። ካህነይ ያርሾ በሳ ቦላ ደእያ ታማን ዎድ ፁጎ፤ ሄስ ጎዳስ ታማን ፁገትያ ሳዎ ቶንኩ ግያ ያርሾ ግዳና።<verse eid="LEV 1:17"/></para>
  <chapter eid="LEV 1"/>
  <chapter number="2" style="c" sid="LEV 2"/>
  <para style="s1">ካ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1"/>ኦንካ ካ ያርሾ ጎዳስ ያርሽያ ዎደ ሄ ያርሾይ ሎኦ ለ ግዶ፤ እያ ቦላ ዛይተነ እፃነ ጉጆ። <verse eid="LEV 2:1"/><verse number="2" style="v" sid="LEV 2:2"/>ሄሳ ካህነ ግድዳ አሮና ናይታኮ ኤሆ፤ ካህነት ሄ ሎኦ ልያፈ እስ ኩጫ ኤክድ፥ ዛይተነ እፃነ ኡባ ጉጅድ ያርሾ በሳ ቦላ ታማን ፁጎ። ሄስ ጎዳስ ታማን ፁገትያ ሳዎ ቶንኩ ግያ ቆፍሶ ያርሾ ግዳና። <verse eid="LEV 2:2"/><verse number="3" style="v" sid="LEV 2:3"/>ካ ያርሹዋፈ አትዳይስ አሮናስነ እያ ናይታስ ግዳና። ሄስ ጎዳስ ታማን ፁገትዳ ኡባፈ ጌሻ ያርሾ ግዳና።<verse eid="LEV 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4"/>ያርሸትያ ኡይይ ጮጨን ኮምፐትዳ ግድኮ፥ ዛይተራ ሙኑቀትዳ ሎኦ ለ ግዶ። ሄ ኡይይ እርሾይ ባይና ዛይተን ሙኑቀትዳይሳ ዎይኮ ሌኦን ኡከትድ ዛይተን ትየትዳይሳ ግዶ። <verse eid="LEV 2:4"/><verse number="5" style="v" sid="LEV 2:5"/>ያርሸትያ ኡይይ በሸን ኡከትዳባ ግድኮ፥ እርሾይ ባይና ዛይተን ሙኑቀትዳ ሎኦ ለ ግዶ። <verse eid="LEV 2:5"/><verse number="6" style="v" sid="LEV 2:6"/>እያ መንዳ እያ ቦላ ዛይተ ትጋዳ ካ ያርሾ ኦዳ ያርሻ። <verse eid="LEV 2:6"/><verse number="7" style="v" sid="LEV 2:7"/>ነ ያርሽያ ካይ ኦቶን ካፅዳባ ግድኮ ዛይተን ሙኑቀትዳ ሎኦ ለ ግዶ። <verse eid="LEV 2:7"/><verse number="8" style="v" sid="LEV 2:8"/>ሄሳዳ ሀንድ ጊግዳ ካ ያርሹዋ ጎዳስ ኤሀዳ ካህንያስ እማ፤ ካህነይ ሄሳ ኤክድ ያርሾ በሳን ያርሾ። <verse eid="LEV 2:8"/><verse number="9" style="v" sid="LEV 2:9"/>ካህነይ ሄ ካ ያርሹዋ ኤክድ፥ ያርሾ በሳን ፁሳ ያርሾ ኦድ ታማን ፁጎ። ሄስ ጎዳስ ታማን ፁገትያ ሳዎ ቶንኩ ግያ ቆፍሶ ያርሾ ግዳና። <verse eid="LEV 2:9"/><verse number="10" style="v" sid="LEV 2:10"/>ካ ያርሹዋፈ አትዳይስ አሮናስነ እያ ናይታስ ግዳና። ሄስ ጎዳስ ታማን ፁገትዳ ኡባፈ ጌሻ ያርሾ ግዳና።<verse eid="LEV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11"/>ኔኒ እርሾ ዎይኮ ኤስ ጎዳስ ታማን ፁጋዳ ያርሻናዉ በሶና ግሾ ጎዳስ ህንተ ኤህያ ካ ያርሾይ እርሾይ ደእያባ ግዶፖ። <verse eid="LEV 2:11"/><verse number="12" style="v" sid="LEV 2:12"/>ሀይሳታ ባይራ ያርሾ ኦድ ጎዳስ ያርሻናዉ ዳንዳኤታ፥ ሽን ሳዎ ቶንኩ ግያ ያርሾ ኦድ ጎዳስ ያርሾ በሳን ፁጎፍተ። <verse eid="LEV 2:12"/><verse number="13" style="v" sid="LEV 2:13"/>ማፅነይ፥ ኔኒ ነ ፆሳራ ጫቅዳ ጫቁዋስ ማላ ግድያ ግሾ ነ ካ ያርሾ ኡባን ማፅነ የጋ። ነ ካ ያርሾ ኡባ ማፅነን ማልኤ። <verse eid="LEV 2:13"/><verse number="14" style="v" sid="LEV 2:14"/>ኔኒ ካፈ ባይራ ጎዳስ ኤህያ ዎደ ጫጨትድ ሽርከትዳ ትያ ግዳናዉ በሴስ። <verse eid="LEV 2:14"/><verse number="15" style="v" sid="LEV 2:15"/>ሄስ ካ ያርሾ ግድያ ግሾ እያ ቦላ ዛይተ ትጋ፤ እፃነ ዎ። <verse eid="LEV 2:15"/><verse number="16" style="v" sid="LEV 2:16"/>ካህነይ ሄ ጫጨትድ ሽርከትዳነ ዛይተይ ትገትዳ ካ ያርሹዋፈ ባጋ ኤክድ እፃነ ኡባራ ቆፍሶ ያርሾ ኦድ ጎዳስ ታማን ፁጎ።<verse eid="LEV 2:16"/></para>
  <chapter eid="LEV 2"/>
  <chapter number="3" style="c" sid="LEV 3"/>
  <para style="s1">እስፈተ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1"/>እስ አስ እስፈተ ያርሾስ ባ መህያፐ ቦረይ ባይና ኡስ ዎይኮ ዎፋኖ ጎዳ ስን ሺሾ። <verse eid="LEV 3:1"/><verse number="2" style="v" sid="LEV 3:2"/>ያርሻናዉ ኤህዳ መህያ ሁጰን ባ ኩሽያ ዎድ ጌሻ ዱንካንያ ፐንገን ሹኮ። ካህነት፥ አሮና ናይት ሱ ኤክድ ያርሾ በሳ ኦይዱ ማዛንያ ቦላ ዉርፆ። <verse eid="LEV 3:2"/><verse number="3" style="v" sid="LEV 3:3"/>እስፈተ ያርሹዋፈ ፁሳ ያርሾ ኦድ ጎዳስ ሺሾ፤ ሄስካ ኡሎ አሹዋ ካምዳ ሞያ፥ <verse eid="LEV 3:3"/><verse number="4" style="v" sid="LEV 3:4"/>ናምኡ ክላሆታ፥ ኤንታ ቦላ ደእያ ሞያነ ትርያ ፄራ ባጋ ኤኮ። <verse eid="LEV 3:4"/><verse number="5" style="v" sid="LEV 3:5"/>አሮና ናይት ሄሳ ፁሳ ያርሹዋራ እስፈ ያርሾ በሳ ቦላ ደእያ ም ቦላ ዎድ ፁጎ። ሄስ ጎዳስ ፁገትያ ሳዎ ቶንኩ ግያ ያርሾ ግዳና።<verse eid="LEV 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6"/>እስፈተ ያርሾስ ሺቀይ ማጫ ዎይኮ አደ ዶርሰ ግድኮ ቦረይ ባይናባ ግዶ። <verse eid="LEV 3:6"/><verse number="7" style="v" sid="LEV 3:7"/>እስ አስ ዶርሳ ኡርገ ያርሽያባ ግድኮ ሄሳ ጎዳ ስንን ሺሾ። <verse eid="LEV 3:7"/><verse number="8" style="v" sid="LEV 3:8"/>ሄ ዶርሳ ኡርግያ ሁጰን ባ ኩሽያ ዎድ ጌሻ ዱንካንያ ፐንገን ሹኮ። አሮና ናይት ሱ ኤክድ ያርሾ በሳ ኦይዱ ማዛንያ ቦላ ዉርፆ። <verse eid="LEV 3:8"/><verse number="9" style="v" sid="LEV 3:9"/>እስፈተ ያርሹዋፈ ጎዳስ ፁሳ ያርሾ ኦድ ያርሾ፤ ሄስካ ሞዋ፥ ጎይናፐ ብድ ዞኮ መቀ ጋካናዉ ደእያ ሞዋ፥ ኡሎ አሹዋ ካምዳ ሞያ፥ <verse eid="LEV 3:9"/><verse number="10" style="v" sid="LEV 3:10"/>ናምኡ ክላሆታ፥ ኤንታ ካምዳ ሞያ ትርያ ፄራ ባጋ ኤኮ። <verse eid="LEV 3:10"/><verse number="11" style="v" sid="LEV 3:11"/>ካህነይ ሄሳ ጎዳስ ፁሳ ያርሾ ኦድ ያርሾ በሳን ፁጎ።<verse eid="LEV 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12"/>እ ያርሸይ ዴሸ ግድኮ እ ሄሳ ጎዳ ስን ሺሾ። <verse eid="LEV 3:12"/><verse number="13" style="v" sid="LEV 3:13"/>እያ ሁጰን ባ ኩሽያ ዎድ ጌሻ ዱንካንያ ስንን ሹኮ። አሮና ናይት ሱ ኤክድ ያርሾ በሳ ዩሹዋ ዉርፆ። <verse eid="LEV 3:13"/><verse number="14" style="v" sid="LEV 3:14"/>እ ሄ ያርሹዋፈ ኤክድ ጎዳስ ፁሳ ያርሾ ኦድ ያርሾ፤ ሄስካ ኡሎ አሹዋ ካምዳ ሞያ ኡባ፥ <verse eid="LEV 3:14"/><verse number="15" style="v" sid="LEV 3:15"/>ናምኡ ክላሆታ፥ ኤንታ ካምዳ ሞያ ትርያ ፄራ ባጋ ኤኮ። <verse eid="LEV 3:15"/><verse number="16" style="v" sid="LEV 3:16"/>ካህነይ ሄሳ ጎዳስ ሳዎ ቶንኩ ግያ ያርሾ ኦድ ያርሾ በሳን ፁጎ። ሞ ኡባይ ጎዳባ።<verse eid="LEV 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 3:17"/>ህንተ ሞነ ሱ ሞፕተ። ሄስ ህንተስነ ያና የለተይ ደእያ በሳ አዉንካ ናግያ ዎጋ ግዶ።<verse eid="LEV 3:17"/></para>
  <chapter eid="LEV 3"/>
  <chapter number="4" style="c" sid="LEV 4"/>
  <para style="s1">ናጋራ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 4:1"/><verse number="2" style="v" sid="LEV 4:2"/>ኔኒ እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ ኦንካ ቆፖና ናጋራ ኦኮ ዎይኮ ጎዳ ኪታታፐ እሱዋ መንኮ፥ <verse eid="LEV 4:2"/><verse number="3" style="v" sid="LEV 4:3"/>ዶረትዳ ካህነይ ናጋራ ኦድ አሳ ጎመን ጋኮ፥ እ ባ ኦዳ ናጋራ ግሾ ቦረይ ባይና ዎፋኖ ጎዳስ ናጋራ ያርሾ ኦድ ኤሆ። <verse eid="LEV 4:3"/><verse number="4" style="v" sid="LEV 4:4"/>ሄ ዎፋኑዋ ጌሻ ዱንካንያ ፐንገ ኤህድ፥ ሁጰን ባ ኩሽያ ዎድ ጎዳ ስንን ሹኮ። <verse eid="LEV 4:4"/><verse number="5" style="v" sid="LEV 4:5"/>ዶረትዳ ካህነይ ዎፋኑዋ ሱፈ ጉራ ኤክድ ጌሻ ዱንካንያ ገልስድ፥ <verse eid="LEV 4:5"/><verse number="6" style="v" sid="LEV 4:6"/>ባ ብራያ ሱን የድ ኤክድ ጌሻ ዱንካንያ ማጋራጁዋ ስንን ጎዳ ስንን ላፑን ቶሆ ዉርፆ። <verse eid="LEV 4:6"/><verse number="7" style="v" sid="LEV 4:7"/>ካህነይ ጉ ሱ ኤክድ ጌሻ ዱንካንያን ጎዳ ስንን ሳውያ እፃነ ጩይስያ በሳን ደእያ ካጨታ ትዮ። አትዳ ሱ ጌሻ ዱንካንያ ገልያ ፐንገ ባጋራ ደእያ ፁሳ ያርሾ በሳ ጋርሳን ጉሶ። <verse eid="LEV 4:7"/><verse number="8" style="v" sid="LEV 4:8"/>ናጋራ ያርሾስ ሹከትዳ ዎፋኑዋ ሞዋ ኡባ፥ ኡሎ አሹዋ ማእዳ ሞዋ፥ <verse eid="LEV 4:8"/><verse number="9" style="v" sid="LEV 4:9"/>ናምኡ ክላሆታ፥ ኤንታ ካምዳ ሞያነ ትርያ ፄራ ባጋ ኤኮ። <verse eid="LEV 4:9"/><verse number="10" style="v" sid="LEV 4:10"/>እስፈተ ያርሾስ ሹከትዳ ዎፋኑዋ ሞዋ ከስዳይሳዳ እያፐ ሞዋ ከሶ። ካህነይ ፁሳ ያርሾ ኦድ ያርሾ በሳን ፁጎ። <verse eid="LEV 4:10"/><verse number="11" style="v" sid="LEV 4:11"/>ሽን ዎፋኑዋ ጋልባ፥ እያ አሹዋ ኡባ፥ እያ ሁጵያ፥ እያ ቶሆታ፥ ኡሎ አሹዋ፥ ቶጭያ፥ <verse eid="LEV 4:11"/><verse number="12" style="v" sid="LEV 4:12"/>አሹዋፐ አትዳይሳ ኡባ ጉታፐ ካረ ከስድ ብዶ የግያ ዎጋ መላ ጌሻ በሲ ኤፍድ ያን ታማን ፁጎ።<verse eid="LEV 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13"/>እስራኤለ ማባራ ኡባይ ቆፖና ናጋራ ኦኮነ ጎዳ ኪታታፐ እሱዋ መንኮ ሄስ ኤንታፈ ቆሰትኮካ ኤንታዉ ባላ ግድድ ታይበታና። <verse eid="LEV 4:13"/><verse number="14" style="v" sid="LEV 4:14"/>ኤንቲ ኦዳ ናጋራ አኬክያ ዎደ ናጋራ ያርሾስ ሀንያ ዎፋኖ ጌሻ ዱንካንያ ስን ኤሆ። <verse eid="LEV 4:14"/><verse number="15" style="v" sid="LEV 4:15"/>ማባራ ጭማት ባንታ ኩሽያ ዎፋኑዋ ሁጰን ዎድ ጎዳ ስንን ሹኮ። <verse eid="LEV 4:15"/><verse number="16" style="v" sid="LEV 4:16"/>ዶረትዳ ካህነይ ዎፋኑዋ ሱፈ ጉራ ኤክድ ጌሻ ዱንካንያ ግዶ ገሎ። <verse eid="LEV 4:16"/><verse number="17" style="v" sid="LEV 4:17"/>እ ባ ብራያ ሱን የድ ኤክድ ማጋራጁዋ ስን ባጋራ ጎዳ ስንን ላፑን ቶሆ ዉርፆ። <verse eid="LEV 4:17"/><verse number="18" style="v" sid="LEV 4:18"/>ቃስ ጉ ሱ ኤክድ፥ ጌሻ ዱንካንያ ግዶን ጎዳ ስንን እፃነ ጩይስያ በሳን ደእያ ካጨታ ቦላ ትዮ። አትዳ ሱ ጌሻ ዱንካንያ ገልያ ፐንግያ ባጋራ ደእያ ፁሳ ያርሾ በሳ ጋርሳን ጉሶ። <verse eid="LEV 4:18"/><verse number="19" style="v" sid="LEV 4:19"/>ሞ ኡባ ኤክድ ያርሾ በሳን ፁጎ። <verse eid="LEV 4:19"/><verse number="20" style="v" sid="LEV 4:20"/>ሀ ዎፋኑዋካ ናጋራ ያርሾስ ሹከትዳ ዎፋኑዋ መላ ኦዳ ሺሻ። ሄሳዳ ኦድ፥ ካህነይ ናጋራ አቶተ ዎጋ ፖላና፤ አሳ ናጋራይ አቶ ጌተታና። <verse eid="LEV 4:20"/><verse number="21" style="v" sid="LEV 4:21"/>ካህነይ ዎፋኑዋ ጉታፐ ካረ ከስድ፥ ኮይሮ ዎፋኖይ ፁገትዳይሳዳ እያካ ፁጎ፤ ሄስ ማባራስ ያርሸትያ ናጋራ ያርሾ።<verse eid="LEV 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22"/>አሳ ካለያ ሹማታፐ እሶይ ቆፖና ናጋራ ኦኮነ ጎዳ ፆሳ ኪታፐ እሱዋ መንኮ ሄ ኡራይ ባላ። <verse eid="LEV 4:22"/><verse number="23" style="v" sid="LEV 4:23"/>እ ባ ኦዳ ናጋራ አኬክዳፐ ጉየ፥ ቦረይ ባይና እስ ኮለ ኤሆ። <verse eid="LEV 4:23"/><verse number="24" style="v" sid="LEV 4:24"/>ሄ ኮልያ ሁጰን ባ ኩሽያ ዎድ ፁሳ ያርሾይ ያርሸትያ በሳን ጎዳ ስንን ሹኮ፤ ሄስ ናጋራ ያርሾ። <verse eid="LEV 4:24"/><verse number="25" style="v" sid="LEV 4:25"/>ካህነይ ባ ብራያ ሱን የድ ኤክድ፥ ፁሳ ያርሾ በሳን ደእያ ካጨታ ቦላ ትዮ፤ አትዳ ሱ ቃስ ፁሳ ያርሾ በሳ ጋርሳን ጉሶ። <verse eid="LEV 4:25"/><verse number="26" style="v" sid="LEV 4:26"/>እስፈተ ያርሾስ ሺቅዳ ሞዋ ኡባ ፁግዳይሳዳ ሀ ኮልያ ሞዋ ፁጎ። ሄሳዳ ኦድ፥ ካህነይ ሄ ኡራ ናጋራ ቁሽሴስ፤ ሄ ኡራ ናጋራይ አቶ ጌተታና።<verse eid="LEV 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27"/>ማባራፐ እስ አስ ቆፖና ናጋራ ኦኮነ ጎዳ ኪታፐ እሱዋ መንኮ ሄ ኡራይ ባላ ግዴስ። <verse eid="LEV 4:27"/><verse number="28" style="v" sid="LEV 4:28"/>እ ባ ኦዳ ናጋራ አኬክዳፐ ጉየ ቦረይ ባይና ማጫ ዴሽ ባ ናጋራ ግሾ ኤሆ። <verse eid="LEV 4:28"/><verse number="29" style="v" sid="LEV 4:29"/>ባ ኩሽያ ሄ ዴሸ ሁጰን ዎ፤ ያትድ ፁሳ ያርሾ በሳን ናጋራ ያርሾ ኦድ ሹኮ። <verse eid="LEV 4:29"/><verse number="30" style="v" sid="LEV 4:30"/>ሄሳፈ ጉየ፥ ካህነይ ሄ ዴሸ ሱን ባ ብራያ የድ ኤክድ ፁሳ ያርሾ በሳን ደእያ ካጨታ ቦላ ትዮ። አትዳ ሱ ኡባ ያርሾ በሳፈ ጋርሳን ጉሶ። <verse eid="LEV 4:30"/><verse number="31" style="v" sid="LEV 4:31"/>እስፈተ ያርሾስ ሹከትዳ መህያፐ ሞዋ ከስዳይሳ መላ ሄ ዴሸ ሞዋ ቃር ከስድ፥ ያርሾ በሳን ጎዳስ ሳዎ ቶንኩ ግያ ያርሾ ኦድ ፁጎ። ሄሳዳ ኦድ፥ ካህነይ ሄ ኡራ ናጋራ ቁሽሴስ፤ እያ ናጋራይ አቶ ጌተታና።<verse eid="LEV 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32"/>ሄ ኡራይ ባ ናጋራ ግሾ ያርሸይ ዶርሰ ግድኮ፥ ቦረይ ባይና ማጫ ዶርሰ ግዶ። <verse eid="LEV 4:32"/><verse number="33" style="v" sid="LEV 4:33"/>እ ባ ኩሽያ ሄ ዶርሰ ሁጰን ዎ፤ ያትድ፥ ፁሳ ያርሾ መሄ ሹክያ በሳን ሹኮ። <verse eid="LEV 4:33"/><verse number="34" style="v" sid="LEV 4:34"/>ሄሳፈ ጉየ፥ ካህነይ ዶርሰ ሱን ባ ብራያ የድ ኤክድ ፁሳ ያርሾይ ያርሸትያ በሳን ደእያ ካጨታ ቦላ ትዮ። አትዳ ሱ ያርሾ በሳፈ ጋርሳን ጉሶ። <verse eid="LEV 4:34"/><verse number="35" style="v" sid="LEV 4:35"/>እስፈተ ያርሾስ ሹከትዳ መህያፐ ሞዋ ከስዳይሳዳ ሄ ዶርሰ ሞዋ ቆር ከስድ፥ ያርሾ በሳን ጎዳስ ፁሳ ያርሾ ኦድ ፁጎ። ሄሳዳ ኦድ፥ ካህነይ ሄ ኡራ ናጋራ ቁሽሴስ፤ እያ ናጋራይ አቶ ጌተታና።<verse eid="LEV 4:35"/></para>
  <chapter eid="LEV 4"/>
  <chapter number="5" style="c" sid="LEV 5"/>
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1"/>እስ አስ ባ በእዳባ ዎይኮ ባ ኤርያባ ማርካታና መላ ኦይሸትድ ማርካቶና እፅኮ ሄ ኡራይ ናጋራ ኦዳ ግሾ ሴረቶ።<verse eid="LEV 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 5:2"/>እስ አስ ኤሮና ደእሸ ቱናባ፥ ሄስካ፥ ሀይቅዳ ዶአ ዎይኮ መሄ ዎይኮ ሳአራ ጎሸትያ ዶአታ ቦችኮ፥ ሄስ ቱና ግደይሳ እ ኤሮና እፅኮካ ቱና ግድያ ግሾ ባላ ግዴስ።<verse eid="LEV 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 5:3"/>እስ አስ ኤሮና ደእሸ አሳ አሳተፈ ጎግድ ቱንስያባ ቦችኮ፥ ሄስ ቱና ግደይሳ እ ኤሮና እፅኮ፥ ቱና ግድያ ግሾ ባላ ግዴስ።<verse eid="LEV 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 5:4"/>እስ አስ ኢታባ ግድን ሎኦባ ኦናዉ ኤሶን ጫቅኮነ ባ ጫቅዳይሳ ዶግድ፥ ጉየፐ እ አኬክዳ ዎደፐ ዶምድ ባላ ግዴስ።<verse eid="LEV 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 5:5"/>እስ አስ ሀ ኦደትዳ ባላታፐ እሱዋ ኦዳባ ግድኮ ባ ኦዳ ናጋራ ፓፆ። <verse eid="LEV 5:5"/><verse number="6" style="v" sid="LEV 5:6"/>እ ባ ኦዳ ናጋራ ግሾ ጎዳስ ባ መህያ ግዶፈ ማጫ ዶርሰ ዎይኮ ማጫ ዴሸ ናጋራ ያርሾ ኦድ ሺሾ። ካህነይ ኤክድ ሄ ኡራ ናጋራ ቁሸስ ያርሻና።<verse eid="LEV 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7"/>እስ አስ ባ ኦዳ ናጋራ ግሾ ያርሻናዉ ዶርሰ ዎይኮ ዴሸ ሻማናዉ እያዉ ጋተይ ጋኮና እፅኮ ናምኡ ኩራቾታ ዎይኮ ናምኡ ሆለታ፥ እሱዋ ናጋራ ያርሾስ ቃስ እሱዋ ፁሳ ያርሾስ ኦድ ጎዳስ ኤሆ። <verse eid="LEV 5:7"/><verse number="8" style="v" sid="LEV 5:8"/>እ ኤንታ ካህንያስ እሞ፤ ካህነይ ናምኡ ሆለታፐ እሱዋ ቆያ ምርቅድ ዱናሽን፥ ናጋራ ያርሾ ኦድ ሺሾ። <verse eid="LEV 5:8"/><verse number="9" style="v" sid="LEV 5:9"/>ያትድ ሱፈ ጉራ ኤክድ፥ ያርሾ በሳ ማታን ዉርፆ፤ አትዳ ሱ ያርሾ በሳ ጋርሳን ጉሶ፤ ሄስ ናጋራ ያርሾ። <verse eid="LEV 5:9"/><verse number="10" style="v" sid="LEV 5:10"/>ሀንኮ ሆልያ ቃስ ህገይ ኪተይሳዳ ፁሳ ያርሾ ኦድ ፁጎ። ካህነይ ሀይሳዳ ኦድ፥ ኡራይ ኦዳ ናጋራ ቁሽሳናዉ ያርሾ ያርሼስ፤ ሄ ኡራ ናጋራይ አቶ ጌተታና።<verse eid="LEV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 5:11"/>ሽን እስ አስ ናምኡ ሆለ ዎይኮ ናምኡ ኩራቾ ኤሀናዉ ጋተይ ጋኮና እፅኮ፥ እስ ክሎ ግራመ ሎኦ ለ ባ ናጋራ ግሾ ያርሾ ኦድ ኤሆ። ሄ ለይ ናጋራ ያርሾ ግድያ ግሾ ዛይተይ ዎይኮ እፃነይ እያ ቦላ ጉዠቶፎ። <verse eid="LEV 5:11"/><verse number="12" style="v" sid="LEV 5:12"/>እ ሄሳ ኤህድ ካህንያስ እሞ፤ ካህነይ ሄ ልያፈ እስ ኩጫ ኤክድ፥ ጎዳስ ሺቅያ ካ ያርሹዋራ ጋድ፥ ቆፍሶ ኦድ ያርሾ በሳን ፁጎ፤ ሄስ ናጋራ ያርሾ። <verse eid="LEV 5:12"/><verse number="13" style="v" sid="LEV 5:13"/>እስ አስ ሀ ናጋራታፐ እሱዋ ኦኮ ሀይሳዳ ኦድ እያ ናጋራ ቁሽሴስ፤ ሄ ኡራ ናጋራይ አቶ ጌተታና። ሄ ያርሹዋፈ አትዳይስ ካ ያርሹዋዳ ካህንያስ ግዶ።<verse eid="LEV 5:13"/></para>
  <para style="s1">ናቆ ያርሾ</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 5:14"/><verse number="15" style="v" sid="LEV 5:15"/>ኦንካ ጎዳ ናቅኮነ ጌሻ ሚሸታ ቱንስድ ቆፖና ናጋራ ኦኮ ባ ናቁዋስ ባ መህያ ግዶፈ ቦረይ ባይና እስ ማራዘ ጎዳስ ኤሆ። እያ ጋተይ ጌሻ ዱንካነን ኤረትዳ ምዛነ ግናን ጭገቶ፤ ሄስ ናቆ ያርሾ። <verse eid="LEV 5:15"/><verse number="16" style="v" sid="LEV 5:16"/>እ ጌሻ ሚሸታ ቦላ ናጋራ ኦዳ ግሾ ኮይሮ ጭጋናዉ በሲያ ጋትያ ቦላ ፄታፐ ላታሙ ኩሸ ጉጅድ ካህንያስ እሞ። ካህነይ ሄሳ ማራዝያራ ጋ ያርሽድ ኡራ ናቁዋ ቁሽሴስ፤ እያ ናጋራይ አቶ ጌተቴስ።<verse eid="LEV 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 5:17"/>እስ አስ ቆፖናሽን፥ ጎዳ ኪታታፐ እሱዋ መንድ ናጋራ ኦኮ እ ሄሳ ኤሮና እፅኮካ ባላ ግድያ ግሾ ባ ናጋራን ሴረቶ። <verse eid="LEV 5:17"/><verse number="18" style="v" sid="LEV 5:18"/>እ ባ መህያፐ ቦረይ ባይናነ ጋተ ኩንያ እስ ማራዘ ናቆ ያርሾስ ካህንያኮ ኤሆ። ካህነይ ሄ ማራዝያ ያርሽድ ኡራ ናቁዋ ቁሽሴስ፤ እያ ናቆይ አቶ ጌተቴስ። <verse eid="LEV 5:18"/><verse number="19" style="v" sid="LEV 5:19"/>እ ቱማፐ ጎዳ ናቅዳ ግሾ ሄስ ናቆ ያርሾ።<verse eid="LEV 5:19"/></para>
  <chapter eid="LEV 5"/>
  <chapter number="6" style="c" sid="LEV 6"/>
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 6:1"/><verse number="2" style="v" sid="LEV 6:2"/>እስ አስ ሀራ አስ ሀዳራ ዎዳባ ዎይኮ ታልእዳባ ላህኮ ዎይኮ ቦንቅኮ ዎይኮ ጭምኮ፥ <verse eid="LEV 6:2"/><verse number="3" style="v" sid="LEV 6:3"/>ዎይኮ ይዳባ ደምድ ታ በአብከ ግድ ዎርዶን ጫቅኮነ አስ ኦያ ሀይሳ መላባፐ እሱዋ ኦኮ፥ <verse eid="LEV 6:3"/><verse number="4" style="v" sid="LEV 6:4"/>ሄሳን ናጋራንቾ ግድድ በንትኮ፥ ካይስዳባ ዎይኮ ቦንቅዳባ ዎይኮ ሀዳራ ኤክዳባ ዎይኮ ይን ደምዳባ፥ <verse eid="LEV 6:4"/><verse number="5" style="v" sid="LEV 6:5"/>ዎይኮ ዎርዶን ጫቅድ ኤክዳ ኩመ ሻሉዋ ጎዳስ ዛሮ። ቃስ ባ ናቆ ያርሹዋ ያርሽያ ጋላስ ባ ኤክዳባ ቦላ ፄታፐ ላታሙ ኩሸ ጉጅድ ሻሉዋ ጎዳስ እሞ። <verse eid="LEV 6:5"/><verse number="6" style="v" sid="LEV 6:6"/>ቃስ ባ ናቁዋ ግሾ ጎዳስ ያርሾ ያርሽያ ዎደ ባ መህያ ግዶፈ ቦረይ ባይና እስ ማራዘ ካህንያኮ ኤሆ። ሄ ዶርሳይ ናቆ ያርሾስ ጋተ ኩንይሳ ግዶ። <verse eid="LEV 6:6"/><verse number="7" style="v" sid="LEV 6:7"/>ካህነይ ሄ ዶርሳ ያርሽድ ሄ ኡራ ናቁዋ ቁሽሴስ፤ ሄ ኡራ ናቆይ አቶ ጌተታና።<verse eid="LEV 6:7"/></para>
  <para style="s1">ፁሳ ያርሾ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 6:8"/><verse number="9" style="v" sid="LEV 6:9"/>አሮናነ እያ አደ ናይታ ሀይሳዳ ያጋዳ ኪታ፤ ፁሳ ያርሹዋስ ደእያ ዎጋይ ሀይሳ፤ ፁሳ ያርሾይ ሳእ ዎንታና ጋካናዉ ያርሾ በሳን ደኦ። ታማይ ያርሾ በሳን ቃማ ኩመ ኤፅሸ አቆ። <verse eid="LEV 6:9"/><verse number="10" style="v" sid="LEV 6:10"/>ካህነይ ሊኖፐ ዳደትዳ ቃምሰ ማእድ፥ ሱረ ዳንጭድ፥ ፁሳ ያርሹዋ ታማይ ምዳ ብዱዋ ካሽድ ያርሾ በሳ ምየን ላሎ። <verse eid="LEV 6:10"/><verse number="11" style="v" sid="LEV 6:11"/>ያትድ ማኡዋ ቃር ዎድ ሀራ ማኦ ማእድ ሄ ብዱዋ ጉታፐ ጋፃ ኤፍድ ዎጋዳ ጌሻ በሳን ቆሎ። <verse eid="LEV 6:11"/><verse number="12" style="v" sid="LEV 6:12"/>ያርሾ በሳ ቦላ ደእያ ታማይ ቶኦና ኡባ ዎደ ኤፅሸ ደኦ። ካህነይ ዎንታ ዎንታ ም እያ ቦላ ጉጆ። ፆሳ ያርሹዋ ም ቦላ ማራን ዎድ፥ እስፈተ ያርሹዋ ሞዋ እያ ቦላ ፁጎ። <verse eid="LEV 6:12"/><verse number="13" style="v" sid="LEV 6:13"/>ታማይ ያርሾ በሳ ቦላ ኡባ ዎደ ኤፅሸ ደኦ፤ ቶአናዉ ኮሸና።<verse eid="LEV 6:13"/></para>
  <para style="s1">ካ ያርሾ</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14"/>ካ ያርሾስ እመትዳ ዎጋይ ሀይሳ፤ ካህነ ግድዳ አሮና ናይት ያርሾ በሳፈ ስን ባጋራ ጎዳ ስንን ያርሾ። <verse eid="LEV 6:14"/><verse number="15" style="v" sid="LEV 6:15"/>ካህነይ እስ ኩጫ ሎኦ ለነ ዛይተ ኤክድ ካ ያርሹዋ ቦላ ደእያ እፃንያራ ያርሾ በሳን ጎዳስ ሳዎ ቶንኩ ግያ ቆፍሶ ያርሾ ኦድ ፁጎ። <verse eid="LEV 6:15"/><verse number="16" style="v" sid="LEV 6:16"/>እያፐ አትዳይሳ አሮንነ እያ አደ ናይት ኡይ ኡክድ ዱንካንያ ዳባባን ደእያ ጌሻ በሳን ሞ። <verse eid="LEV 6:16"/><verse number="17" style="v" sid="LEV 6:17"/>ሄ ኡይይ እርሾይ ባይና ኡከቶ። ታማን ፁሳ ያርሹዋፈ ሄሳ ታኒ ኤንታዉ ግሾ ኦዳ እማስ። ናጋራ ያርሹዋ መላነ ናቆ ያርሹዋ መላ እ ኡባፈ ጌሽ። <verse eid="LEV 6:17"/><verse number="18" style="v" sid="LEV 6:18"/>ጎዳስ ታማን ፁሳ ያርሹዋፈ ኤንታ ጋክያ ግሾ ግድያ ግሾ ያ የለተን አሮና ኮቸ ግድዳ አደት ኡባይ ሄሳ ሞ። ሄ ያርሹዋ፥ ጌሽ ግዶና ኦንካ ቦቾፎ።<verse eid="LEV 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 6:19"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 6:19"/><verse number="20" style="v" sid="LEV 6:20"/>አሮንነ እያ አደ ናይት ካህነተን ትየትያ ዎደ እስ ክሎ ግራመ ግድያ ሎኦ ለ ካ ያርሾ ኦድ ጎዳስ ኤሆ። እያፐ ባጋ ዎንታ፥ ባጋ ኦማርስ ያርሾ። <verse eid="LEV 6:20"/><verse number="21" style="v" sid="LEV 6:21"/>ሄ ለይ ዛይተራ ዋላከትድ ሎይ ሙኑቀትድ ባሸን ኡከቶ፤ እያ መንዳ ያርሾ በሳን ሳዎ ቶንኩ ግያ ካ ያርሾ ኦዳ ጎዳስ ያርሻ። <verse eid="LEV 6:21"/><verse number="22" style="v" sid="LEV 6:22"/>ቃስ አሮና አደ ናይታፐ እያ ካህነተ ላታናዉ ትየትያ ኦንካ ሄ ዎጋ ጊግሴስ። ሄስ ጎዳስ ኡባ ዎደ ያርሸትያ ያርሾ ግድያ ግሾ ኩመ ፁገቶ። <verse eid="LEV 6:22"/><verse number="23" style="v" sid="LEV 6:23"/>ካህነይ ካ ያርሹዋ ጉየ አሾና ፁጋናዉ ኮሼስ፤ እ ሜተታናዉ በሰና።<verse eid="LEV 6:23"/></para>
  <para style="s1">ናጋራ ያርሾ</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 6:24"/><verse number="25" style="v" sid="LEV 6:25"/>አሮናስነ እያ አደ ናይታስ ሀይሳዳ ያጋ፤ “ናጋራ ያርሾ ዎጋይ ሀይሳ፤ ናጋራስ ሹከትያ ያርሾይ ፁሳ ያርሾይ ሹከትያ በሳን ጎዳ ስንን ሹከቶ። ሄ ያርሾይ ኡባፈ ጌሻ ያርሾ። <verse eid="LEV 6:25"/><verse number="26" style="v" sid="LEV 6:26"/>ሄ ያርሹዋ ያርሽያ ካህነይ ዱንካንያ ዳባባን ደእያ ጌሻ በሳን ሞ። <verse eid="LEV 6:26"/><verse number="27" style="v" sid="LEV 6:27"/>ሄ አሹዋ ቦችያ ኦንካ ጌሽ ግዶ፤ ቃስ ሹክሽን ሱ ማኡዋ ቦችኮ ሄ ማኦይ ጌሻ በሳን ሜጨቶ። <verse eid="LEV 6:27"/><verse number="28" style="v" sid="LEV 6:28"/>አሾይ ካፅዳ ኦቶይ መቆ፤ ብራታ ድስተን ካፅዳባ ግድኮ ሄ ሚሽያ ቃጭድ ሃን ሜጫናዉ ኮሼስ። <verse eid="LEV 6:28"/><verse number="29" style="v" sid="LEV 6:29"/>ካህነ ኮቻፈ አደ ግድዳ ኦንካ ሄ አሹዋ ሞ፤ ሄ ያርሾይ ኡባፈ ጌሽ። <verse eid="LEV 6:29"/><verse number="30" style="v" sid="LEV 6:30"/>ሽን ጌሻ በሳን ናጋራ አቶተስ ሱ ኤክድ ዱንካንያ ግዶ ገልዳባ ግድኮ ሄ መህያ አሾይ ሜተታናዉ ኮሸና፤ እ ታማን ፁገታናዉ በሴስ።”<verse eid="LEV 6:30"/></para>
  <chapter eid="LEV 6"/>
  <chapter number="7" style="c" sid="LEV 7"/>
  <para style="s1">ናቆ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1"/>ኡባፈ ጌሽ ግድያ ግሾ ናቆ ያርሾ ዎጋይ ሀይሳ፤ <verse eid="LEV 7:1"/><verse number="2" style="v" sid="LEV 7:2"/>ፁሳ ያርሾ መሄይ ሹከትያ በሳን ናቆ ያርሾ መሄይ ሹከቶ፤ እያ ሱይ ያርሾ በሳ ኦይዱ ባጋን ዉርፀቶ። <verse eid="LEV 7:2"/><verse number="3" style="v" sid="LEV 7:3"/>እያ ሞዋ ኡባ፥ ሄስካ ጎይናፐ ብድ ዞኮ መቀ ጋካናዉ ደእያ ሞዋ፥ ኡሎ አሹዋ ካምዳ ሞያ፥ <verse eid="LEV 7:3"/><verse number="4" style="v" sid="LEV 7:4"/>ናምኡ ክላሆታ፥ ኤንታ ካምዳ ሞያነ ትርያ ፄራ ባጋ ኤክድ ያርሾ። <verse eid="LEV 7:4"/><verse number="5" style="v" sid="LEV 7:5"/>ካህነይ ሀይሳታ ታማን ፁሳ ያርሾ ኦድ ጎዳስ ያርሾ፤ ሄስ ናቆ ያርሾ። <verse eid="LEV 7:5"/><verse number="6" style="v" sid="LEV 7:6"/>ካህነ ያራ ግድዳ አደ ኡባይ ሄ ያርሾ አሹዋ ሞ። ሄ ያርሾይ ኡባፈ ጌሽ ግድያ ግሾ ጌሻ በሳን ሜተቶ።<verse eid="LEV 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 7:7"/>ናቆ ያርሹዋነ ናጋራ ያርሹዋ ዎጋይ እስኖ። ሄ መህያ አሾይ ናጋራ አቶተስ ያርሽዳ ካህንያስ እመቴስ። <verse eid="LEV 7:7"/><verse number="8" style="v" sid="LEV 7:8"/>ኦንካ ፁሳ ያርሾ መሄ ኤህን ኤክድ ያርሽያ ካህነይ ሄ መህያ ጋልባ ባዉ ኤኮ። <verse eid="LEV 7:8"/><verse number="9" style="v" sid="LEV 7:9"/>ጮጨን ኮምፐትዳ ዎይኮ ኦቶን ካፅዳ ዎይኮ ባሸን ኡከትዳ ኡባይ ሄ ያርሹዋ ያርሽዳ ካህንያስ እመቴስ። <verse eid="LEV 7:9"/><verse number="10" style="v" sid="LEV 7:10"/>ቃስ ዛይተራ ሙኑቀትዳ ዎይኮ ሙኑቀቶና ካ ያርሾ ኡባይ አሮና አደ ናይታ ኡባስ እስ ግና ሻከትድ እመቴስ።<verse eid="LEV 7:10"/></para>
  <para style="s1">እስፈተ ያርሾ</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11"/>እስ አስ እስፈተ ያርሾ ጎዳስ ያርሽያ ዎደ እያዉ ደእያ ዎጋይ ሀይሳ፤ <verse eid="LEV 7:11"/><verse number="12" style="v" sid="LEV 7:12"/>እ ያርሸይ ጋላታ ያርሾ ግድኮ ሄ ያርሹዋራ እስፈ ዛይተራ ሙኑቅዳ ኡይ፥ እርሾይ ገሎና ኡከትድ ዛይተን ትየትዳ ሌኦ ኡይነ ሎኦ ለፈ ዛይተራ ሙኑቀትዳ ኡይ ሺሾ። <verse eid="LEV 7:12"/><verse number="13" style="v" sid="LEV 7:13"/>ሄ እስፈተ ያርሹዋራ እስፈ እርሾራ ኡከትዳ ኡይ እሞታ ኦድ ያርሾ። <verse eid="LEV 7:13"/><verse number="14" style="v" sid="LEV 7:14"/>ሄ እስ እስ ኡይፈ እሱዋ ደንድ ጎዳስ ያርሾ ኦድ ኤሆ። ሄስ እስፈተ ያርሹዋ ሱ ዉርፅዳ ካህንያስ እመቶ። <verse eid="LEV 7:14"/><verse number="15" style="v" sid="LEV 7:15"/>ሄ መህያ አሾይ ሄ ጋላስ ሜተቶ፤ ዎንታስ አይብካ አቶፎ።<verse eid="LEV 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 7:16"/>ሽን እያ ያርሾይ ጋሶ ያርሾ ዎይኮ ዶሳ ያርሾ ግድኮ ሄ አሾይ ሄ ያርሸትዳ ጋላስ ሜተቶ፤ እያፐ አተይ ደእኮ ዎንተ ጋላስ ሜተቶ። <verse eid="LEV 7:16"/><verse number="17" style="v" sid="LEV 7:17"/>ሄ አሹዋፐ ፓላህድ ሄን ጋላስ ጋካናዉ ጋምእኮ ሄስ ታማን ፁገቶ። <verse eid="LEV 7:17"/><verse number="18" style="v" sid="LEV 7:18"/>እስ አስ ሺሽዳ እስፈተ ያርሾ አሾይ ሄን ጋላሳን ሜተትኮ እያ ያርሾይ ኤከተና፤ ያርሾይ ያርሸትዳዳ ታይበተና። ሄ ያርሾይ ቱና፤ እያፐ ምዳ ኦንካ ባ ናጋራን ኦይሸቴስ።<verse eid="LEV 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 7:19"/>ቱናባ ቦችዳ አሾይ ሜተቶፎ፤ እ ታማን ፁገታናዉ ኮሼስ። ሀራ አሹዋ ዎጋን ቱና ግዶና አስ ኦንካ ማና ጊኮ ሞ። <verse eid="LEV 7:19"/><verse number="20" style="v" sid="LEV 7:20"/>ሽን እስ አስ ቱና ግድ ኡትድ፥ ጎዳስ ሺቅዳ እስፈተ ያርሾ አሹዋፐ ምያባ ግድኮ፥ ሄ ኡራይ አሳ ግዶፈ ኩረቶ። <verse eid="LEV 7:20"/><verse number="21" style="v" sid="LEV 7:21"/>እስ አስ ቱናባ ቦችኮ፥ አሳ ቱናተ ግድን ዎይኮ ቱና መሄ ግድን ዎይኮ ሀራ እፀትያ ቱናባ ቦችድ፥ ጎዳስ ያርሸትዳ እስፈተ ያርሾ አሹዋፐ ሚኮ፥ ሄ ኡራይ ባ አሳ ግዶፈ ኩረቶ።<verse eid="LEV 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 7:22"/><verse number="23" style="v" sid="LEV 7:23"/>እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ ኮርማ ዎይኮ ማራዘ ዎይኮ ኮለ ሞ አሹዋ ሞፕተ። <verse eid="LEV 7:23"/><verse number="24" style="v" sid="LEV 7:24"/>ሀይቅዳ መሄ ዎይኮ ዶእ ዎዳ መህያ ሞዋ ሀራባስ ጎኤትተፐ አትን፥ እያፐ አይባካ ሞፕተ። <verse eid="LEV 7:24"/><verse number="25" style="v" sid="LEV 7:25"/>ጎዳስ ታማን ፁሳ ያርሾስ ሺቅያ መህያ ሞ አሹዋ ምያ ኦንካ ባ አሳ ግዶፈ ኩረቶ። <verse eid="LEV 7:25"/><verse number="26" style="v" sid="LEV 7:26"/>ህንተ ደእያ በሳን አዉን ግድኮካ፥ ካፎ ሱ ዎይኮ መሄ ሱ ሞፕተ። <verse eid="LEV 7:26"/><verse number="27" style="v" sid="LEV 7:27"/>ሱ ምያ ኦንካ ባ አሳ ግዶፈ ኩረቶ።<verse eid="LEV 7:27"/></para>
  <para style="s1">ካህነታ ግሹዋ</para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 7:28"/><verse number="29" style="v" sid="LEV 7:29"/>እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ ጎዳስ እስፈተ ያርሾ ሺሽያ ኦንካ ሄ እስፈተ ያርሹዋፈ ሻክድ ባ እሞታ ኦድ ጎዳስ ዱማይድ ያርሾ። <verse eid="LEV 7:29"/><verse number="30" style="v" sid="LEV 7:30"/>ሄሳ እ ጎዳስ ታማን ፁሳ ያርሾ ኦድ፥ ባ ኩሸን ኤክድ ኤሆ። ቃስ ሞዋ አንጋሱዋራ ጋ ኤህድ ዩሾ ያርሾ ኦድ ጎዳ ስንን ያርሾ። <verse eid="LEV 7:30"/><verse number="31" style="v" sid="LEV 7:31"/>ካህነይ ያርሾ በሳን ሞዋ ፁጎ፤ ሽን አንጋሶይ አሮናስነ እያ አደ ናይታስ እመቶ። <verse eid="LEV 7:31"/><verse number="32" style="v" sid="LEV 7:32"/>ህንተ እስፈተ ያርሹዋፈ ኡሻቻ ገዳ እሞታ ኦድ ካህንያስ እምተ። <verse eid="LEV 7:32"/><verse number="33" style="v" sid="LEV 7:33"/>ሄ ኡሻቻ ገዳይ እስፈተ ያርሹዋ ሱነ ሞዋ ያርሽያ ካህንያ ጋክያ ግሾ ግዶ። <verse eid="LEV 7:33"/><verse number="34" style="v" sid="LEV 7:34"/>ታኒ እስራኤለ አሳ እስፈተ ያርሹዋፈ ዩሾ አንጋሱዋን ሺቅዳ ገዳ እስራኤለ አሳፐ ኤካዳ፥ ካህንያ አሮናስነ እያ አደ ናይታስ ግሾ ኦዳ እማስ። ሄስ ኤንታ ጋክያ ኤንታ ግሾ ግድያ ግሾ እስራኤለ አሳይ መርናዉ ሄሳ ኤንታዉ እምሸ ዳና።<verse eid="LEV 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 7:35"/>አሮንነ እያ አደ ናይት ካህነ ግድድ ሹመትዳ ጋላስ ጎዳስ ሺቅዳ ፁሳ ያርሹዋፈ፥ ሄስካ ኤንታዉ ግሾ ግድድ እመትስ። <verse eid="LEV 7:35"/><verse number="36" style="v" sid="LEV 7:36"/>ጎዳይ ኤንታ ካህነተስ ትይዳ ጋላስ፥ ሄሳ ኤንታዉ እማና መላ እስራኤለ አሳ ኪትስ፤ ሄስ ያና የለተን ኤቅድ ደእያ ዎጋ ግዳና።<verse eid="LEV 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37"/>ህዛ ፁሳ ያርሹዋ፥ ካ ያርሹዋ፥ ናጋራ ያርሹዋ፥ ናቆ ያርሹዋ፥ ካህነት ትየትያ ዎደ ያርሸትያ ያርሹዋነ እስፈተ ያርሹዋ ዎጋይ ሀይሳ። <verse eid="LEV 7:37"/><verse number="38" style="v" sid="LEV 7:38"/>እስራኤለ አሳይ ሲና መላ ቢታን ባንታ ያርሹዋ ጎዳስ ያርሻና መላ ጎዳይ ኪትዳ ጋላስ፥ ሲና ዙማ ቦላ ጎዳይ ሙሰ ኪትዳ ዎጋይ ሀይሳ።<verse eid="LEV 7:38"/></para>
  <chapter eid="LEV 7"/>
  <chapter number="8" style="c" sid="LEV 8"/>
  <para style="s1">ካህነታ ሹሞ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1"/>ጎዳይ ሙሰስ ሀይሳዳ ያግድ ኦድስ፤ <verse eid="LEV 8:1"/><verse number="2" style="v" sid="LEV 8:2"/>አሮናነ እያ አደ ናይታ፥ ኤንታራ እስፈ ካህነተ ማኡዋ፥ ትዮ ዛይትያ፥ ናጋራ ያርሹዋ ሹከትያ ኮርማ፥ ናምኡ ማራዘታነ፥ እርሾይ ገልቦና ኡከትዳ ኡይ ዎያ ጋይታ ኤካዳ ያ። <verse eid="LEV 8:2"/><verse number="3" style="v" sid="LEV 8:3"/>ቃስ እስራኤለ አሳ ኡባ ፄጋዳ ዱንካንያ ፐንገ ሺሻ።<verse eid="LEV 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 8:4"/>ሙሰይ ጎዳይ ኪትዳይሳዳ ኦስ፤ አሳ ኡባይ ዱንካንያ ፐንገ ሺቅስ። <verse eid="LEV 8:4"/><verse number="5" style="v" sid="LEV 8:5"/>ሙሰይ አሳኮ፥ ታ ኦና መላ ጎዳይ ኪትዳይስ ሀይሳ።<verse eid="LEV 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 8:6"/>ሙሰይ አሮናነ እያ አደ ናይታ ኤህድ ሃን ሜጭስ። <verse eid="LEV 8:6"/><verse number="7" style="v" sid="LEV 8:7"/>አሮና ማኡዋ ማይዝድ፥ ዳንጮ ዳንጭስስ፤ አዱሳ ማኡዋ ማይዝድ እያ ቦላ ኤፉደ ማኡዋ ማይዝስ። ኤፉድያ አሌቅስድ ዳድዳ ሳቅያን አሮና ፄሳራ ጋድ ቃችስ። <verse eid="LEV 8:7"/><verse number="8" style="v" sid="LEV 8:8"/>ኤፉድያ ቦላ ትራ ኪሰ ስክድ እያን ኡሪመነ ቱሚመ ዎስ። <verse eid="LEV 8:8"/><verse number="9" style="v" sid="LEV 8:9"/>አሮና ሁጰን ፃ ቃጨ ዎስ። ጎዳይ ሙሰ ኪትዳይሳዳ ፃ ቃጭያ ስን ባጋራ ጌሻ ዎርቃ ጉቸ ምስልያ ዎስ።<verse eid="LEV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 8:10"/>ሄሳፈ ጉየ ሙሰይ ትዮ ዛይትያ ኤክድ፥ ዱንካንያነ ዱንካንያ ግዶን ደእያ ሚሸ ኡባ ትይድ ዱማይስ። <verse eid="LEV 8:10"/><verse number="11" style="v" sid="LEV 8:11"/>ሄ ዛይትያፐ ኤክድ ያርሾ በሳ ቦላ ላፑን ቶሆ ዉርፅስ፤ እያ ሚሸታ፥ ሜቻ ከርያነ እያ ኡቱዋ ዱማያናዉ ሄ ዛይትያራ ትይስ። <verse eid="LEV 8:11"/><verse number="12" style="v" sid="LEV 8:12"/>ሄ ትዮ ዛይትያፐ ጉራ ኤክድ አሮና ሁጰን ትግድ እያ ዱማይስ። <verse eid="LEV 8:12"/><verse number="13" style="v" sid="LEV 8:13"/>ጎዳይ ሙሰ ኪትዳይሳዳ ሙሰይ አሮና አደ ናይታ ስን አድ ማኦ ማይዝድ ዳንጮ ዳንጭስስ። ኤንታ ሁጰን ፃ ቃጨ ዎስ።<verse eid="LEV 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14"/>ሙሰይ ናጋራ ያርሾስ ያርሸትያ ኮርማ ኤህስ፤ አሮንነ እያ አደ ናይት ሄ ኮርማ ሁጰን ባንታ ኩሽያ ዎዶሶና። <verse eid="LEV 8:14"/><verse number="15" style="v" sid="LEV 8:15"/>ሙሰይ ሄ ኮርማ ሹክድ እያ ሱን ባ ብራያ የድ ኤክድ፥ ያርሾ በሳን ደእያ ካጨታ ትይድ ያርሾ በሳ ጌሽስ። አትዳ ሱ ያርሾ በሳፈ ጋርሳን ጉስስ፤ ሄሳዳ ኦድ ያርሾ በሳ ፆሳስ ዱማይድ ጌሽስ። <verse eid="LEV 8:15"/><verse number="16" style="v" sid="LEV 8:16"/>ሙሰይ ኡሎ አሹዋ ካምዳ ሞዋ ኡባ፥ ትርያ ፄራ ባጋ፥ ክላሆታነ ኤንታ ካምዳ ሞዋ ኤክድ፥ ያርሾ በሳን ፁግስ። <verse eid="LEV 8:16"/><verse number="17" style="v" sid="LEV 8:17"/>ሽን ጎዳይ ሙሰ ኪትዳይሳዳ ኮርማ ጋልባ፥ አትዳ አሹዋነ ቶጭያ ጉታፐ ጋፃ ከስድ ፁግስ።<verse eid="LEV 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18"/>ሄሳፈ ጉየ ሙሰይ ፁሳ ያርሾስ ማራዘ ኤህስ፤ አሮንነ እያ አደ ናይት ሄ ማራዝያ ሁጰን ባንታ ኩሽያ ዎዶሶና። <verse eid="LEV 8:18"/><verse number="19" style="v" sid="LEV 8:19"/>ሙሰይ ሄ ማራዝያ ሹክስ፤ እያ ሱ ያርሾ በሳ ኦይዱ ማዛነታ ቦላ ዉርፅስ። <verse eid="LEV 8:19"/><verse number="20" style="v" sid="LEV 8:20"/>ሙሰይ ማራዝያ አሹዋ ቆሞን ቆሞን ቃንፀረስ፤ ሁጵያ፥ አትዳ አሹዋነ ሞዋ ፁግስ። <verse eid="LEV 8:20"/><verse number="21" style="v" sid="LEV 8:21"/>ጎዳይ ሙሰ ኪትዳይሳዳ ኡሎ አሹዋነ ገዳታ ሜጭድ፥ ኩመ ዶርሳ ጎዳስ ሳዎ ቶንኩ ግያ ፁሳ ያርሾ ኦድ ያርሾ በሳን ፁግስ።<verse eid="LEV 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22"/>ካህነት ሹመትያ ዎደ ሺቅያ ናምአን ዶርሳ ሙሰይ ኤህስ፤ አሮንነ እያ አደ ናይት ሄ ዶርሳ ሁጰን ባንታ ኩሽያ ዎዶሶና። <verse eid="LEV 8:22"/><verse number="23" style="v" sid="LEV 8:23"/>ሙሰይ ሄ ማራዝያ ሹክስ፤ እያ ሱፈ ኤክድ፥ አሮናስ ኡሻቻ ሀይ፥ ኡሻቻ ኩሽያ ዎጋ ብራያነ፥ ኡሻቻ ቶሁዋ ዎጋ ብራያ ትይስ። <verse eid="LEV 8:23"/><verse number="24" style="v" sid="LEV 8:24"/>ቃስ ሙሰይ አሮና አደ ናይታ ስን አድ፥ ሄ ሱፈ ኤክድ፥ ኤንታ ኡሻቻ ሀይ፥ ኡሻቻ ኩሽያ ዎጋ ብራያነ ኡሻቻ ቶሁዋ ዎጋ ብራያ ትይስ። ያትድ፥ ሙሰይ አትዳ ሱ ያርሾ በሳ ኦይዱ ማዛነታ ቦላ ዉርፅስ።<verse eid="LEV 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 8:25"/>ሞዋ፥ ጎይናፐ ብድ ዞኮ መቀ ጋካናዉ ደእያ ሞዋ፥ ትርያ ፄራ ባጋ፥ ክላሆታነ ኤንታ ካምዳ ሞዋነ ኡሻቻ ገዳ ኤክስ። <verse eid="LEV 8:25"/><verse number="26" style="v" sid="LEV 8:26"/>ጎዳ ስንን ደእያ ጋይታፐ እርሾይ ባይና ኡከትዳ እስ ኡይ፥ ኡከትድ ዛይተን ትየትዳ እስ ኡይነ ሌኦን ኡከትዳ ኡይ ኤክድ ሞዋ ቦላነ ኡሻቻ ገዳ ቦላ ዎስ። <verse eid="LEV 8:26"/><verse number="27" style="v" sid="LEV 8:27"/>እ ሄ ካ ኡባ አሮና ኩሸንነ እያ አደ ናይታ ኩሸን ዎን፥ ጎዳ ስንን ዩሾ ያርሾ ኦድ ያርሽዶሶና። <verse eid="LEV 8:27"/><verse number="28" style="v" sid="LEV 8:28"/>ሙሰይ ሄ ካ ኤንታ ኩሸፐ ኤክድ፥ ፁሳ ያርሹዋራ ጋድ፥ ካህነታ ሹምያ ዎደ ጎዳስ ሳዎ ቶንኩ ግያ ያርሾ ኦድ ያርሾ በሳን ፁግስ። <verse eid="LEV 8:28"/><verse number="29" style="v" sid="LEV 8:29"/>ቃስ ሙሰይ አንጋሱዋ ኤክድ፥ ዩሾ ያርሾ ኦድ ጎዳ ስንን ያርሽስ። ጎዳይ ሙሰ ኪትዳይሳዳ፥ ካህነታ ሹምያ ዎደ ያርሸትያ ማራዝያ አሹዋፐ ሄስ ሙሰ ጋክያ ግሾ።<verse eid="LEV 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30"/>ሙሰይ ትዮ ዛይትያፐነ ያርሾ በሳን ደእያ ሱፈ ኤክድ፥ አሮና ቦላነ እያ ማኡዋ ቦላ፥ እያ አደ ናይታ ቦላነ፥ ኤንታ ማኡዋ ቦላ ዉርፅስ፤ አሮናነ እያ ማኡዋ፥ እያ ናይታነ ኤንታ ማኡዋ ዱማይስ።<verse eid="LEV 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31"/>ሙሰይ አሮናነ እያ አደ ናይታኮ ሀይሳዳ ያግስ፤ አሹዋ ዱንካንያ ፐንገን ካተ፤ አሮንነ እያ አደ ናይት ታ ኪትዳይሳዳ ጋይታን ደእያ ጌሻ ኡይራ ሚተ። <verse eid="LEV 8:31"/><verse number="32" style="v" sid="LEV 8:32"/>ሄ አሹዋፐነ ኡይፈ ፓላህዳይ ደእኮ ታማን ፁግተ። <verse eid="LEV 8:32"/><verse number="33" style="v" sid="LEV 8:33"/>ካህነታ ሹምያ ዎጋይ ላፑን ጋላስ ኤክያ ግሾ ሄ ዎጋይ ፖለትያ ላፑን ጋላሳይ ዉራና ጋካናዉ ዱንካንያ ፐንገፈ ካረ ከዮፕተ። <verse eid="LEV 8:33"/><verse number="34" style="v" sid="LEV 8:34"/>ጎዳይ ኪትን ሀች ፖለትዳ ዎጋይ ህንተ ናጋራ ቁቻናሳ። <verse eid="LEV 8:34"/><verse number="35" style="v" sid="LEV 8:35"/>ዱንካንያ ፐንገን ላፑን ጋላስ ኩመ ጋላስነ ቃማ ጋምእተ፤ ጎዳ ዎጋ ናግተ፤ እፅኮ ህንተ ሀይቃና። ታና ጎዳይ ኪትዳይ ሀይሳ። <verse eid="LEV 8:35"/><verse number="36" style="v" sid="LEV 8:36"/>አሮንነ እያ አደ ናይት ጎዳይ ሙሰ ባጋራ ኪትዳባ ኡባ ኦዶሶና።<verse eid="LEV 8:36"/></para>
  <chapter eid="LEV 8"/>
  <chapter number="9" style="c" sid="LEV 9"/>
  <para style="s1">አሮና ኮይሮ ያርሹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1"/>ሆስፑን ጋላስ ሙሰይ አሮና፥ እያ አደ ናይታነ እስራኤለ ጭማታ ፄግስ። <verse eid="LEV 9:1"/><verse number="2" style="v" sid="LEV 9:2"/>አሮናኮ ሀይሳዳ ያግስ፤ ቦረይ ባይና እስ ኮርማ ናጋራ ያርሾስ፥ ቃስ እስ ማራዘ ፁሳ ያርሾስ ጎዳ ስን ሺሻ። <verse eid="LEV 9:2"/><verse number="3" style="v" sid="LEV 9:3"/>ቦረይ ባይና እስ ኮለ ናጋራ ያርሾስ፥ እስ ላይ ኩምዳ ማርነ ዶርሳ ኡርገ ፁሳ ያርሾስ ባንታዉ ኤሀና መላ እስራኤለ አሳስ ኦዳ። <verse eid="LEV 9:3"/><verse number="4" style="v" sid="LEV 9:4"/>ቃስ እስፈተ ያርሾስ እስ ኮርማ፥ እስ ማራዘነ ካ ያርሾስ ዛይተራ ሙኑቀትዳ ለ ኤሀና መላ ኤንታዉ ኦዳ። ሀች ጎዳይ ህንተዉ ቆንጫና ግሾ ሄሳ ኦተ።<verse eid="LEV 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 9:5"/>ኤንቲ ሙሰይ ኪትዳባ ኡባ ጌሻ ዱንካንያ ስን ኤህዶሶና፤ ማባራ ኡባይ ሺቅድ ጎዳ ስንን ኤቅዶሶና። <verse eid="LEV 9:5"/><verse number="6" style="v" sid="LEV 9:6"/>ሙሰይ ኤንታኮ፥ ጎዳ ቦንቾይ ህንተዉ ቆንጫና መላ ህንተ ኦና መላ ጎዳይ ኪትዳይ ሀይሳ።<verse eid="LEV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 9:7"/>ሙሰይ አሮናኮ ሀይሳዳ ያግስ፤ “ያርሾ በሳኮ ሺቃዳ ነ ናጋራ ግሾ ናጋራ ያርሾነ ፁሳ ያርሾ ያርሻ። ጎዳይ ኪትዳይሳዳ አሳ ናጋራ አቶተስ ያርሾ ያርሻ።”<verse eid="LEV 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8"/>አሮን ያርሾ በሳኮ ይድ፥ ባ ናጋራ ግሾ ያርሸትያ ማራ ሹክስ። <verse eid="LEV 9:8"/><verse number="9" style="v" sid="LEV 9:9"/>አሮና ናይት ሱ ኤክድ እያዉ ኤህዶሶና፤ እ፥ ባ ብራያ ሄ ሱን የድ ኤክድ፥ ያርሾ በሳን ደእያ ካጨታ ትይስ፤ አትዳ ሱ ያርሾ በሳፈ ጋርሳን ጉስስ። <verse eid="LEV 9:9"/><verse number="10" style="v" sid="LEV 9:10"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ አሹዋፐ ሞዋ፥ ክላሆታነ ትርያ ፄራ ባጋ ኤክድ ያርሾ በሳን ፁግስ። <verse eid="LEV 9:10"/><verse number="11" style="v" sid="LEV 9:11"/>ሽን አትዳ አሹዋነ ጋልባ ጉታፐ ካረ ከስድ ፁግስ።<verse eid="LEV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12"/>አሮን ፁሳ ያርሾስ ሺቅዳ መህያ ሹክስ፤ እያ ናይት ሱ ኤክድ እያዉ ኤህዶሶና። እ ያርሾ በሳ ኦይዱ ማዛነታ ቦላ ዉርፅስ። <verse eid="LEV 9:12"/><verse number="13" style="v" sid="LEV 9:13"/>ኤንቲ አሹዋ ቆሞን ቆሞን ከስድ፥ ሁጵያራ ዎላ እያዉ ኤህዶሶና፤ እ ኤክድ ያርሾ በሳን ፁግስ። <verse eid="LEV 9:13"/><verse number="14" style="v" sid="LEV 9:14"/>ኡሎ አሹዋነ ገዳታ ሃን ሜጭድ፥ ያርሾ በሳን ደእያ ፁሳ ያርሹዋ ቦላ ዎድ ፁግስ።<verse eid="LEV 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 9:15"/>ሄሳፈ ጉየ፥ አሮን አሳ ግሾ ያርሾ ያርሽስ። እ አሳ ናጋራ ግሾ ያርሸትያ ኮልያ ኤክድ ሹክስ፤ እ ካሰ ባ ናጋራ ያርሽዳይሳዳ ኤንታ ናጋራ ግሾ ያርሽስ። <verse eid="LEV 9:15"/><verse number="16" style="v" sid="LEV 9:16"/>ዎጋይ ኪተይሳዳ ፁሳ ያርሾስ ሺቅያ መህያ ኤህድ ያርሽስ። <verse eid="LEV 9:16"/><verse number="17" style="v" sid="LEV 9:17"/>ካ ያርሹዋ ኤህድ፥ እያፐ እስ ኩጫ ኤክድ፥ ዎንታ ዎንታ ፁሳ ያርሹዋ ቦላ ጉጅድ ያርሾ በሳን ፁግስ።<verse eid="LEV 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 9:18"/>አሮን ኮርማነ ማራዝያ አሳስ እስፈተ ያርሾ ኦድ ሹክስ፤ እያ አደ ናይት ሱ እያዉ ኤህዶሶና፤ እ ሄ ሱ ኤክድ ያርሾ በሳ ኦይዱ ማዛነታ ቦላ ዉርፅስ። <verse eid="LEV 9:18"/><verse number="19" style="v" sid="LEV 9:19"/>ኮርማነ ማራዝያ አሹዋፐ ሞዋ፥ ጎይናፐ ብድ ዞኮ መቀ ጋካናዉ ደእያ ሞዋ፥ ኡሎ አሹዋ ካምዳ ሞዋ፥ ክላሆታነ ትርያ ፄራ ባጋ ኤክድ፥ <verse eid="LEV 9:19"/><verse number="20" style="v" sid="LEV 9:20"/>ኤንቲ አንጋይሱዋ ቦላ ዎን፥ አሮን ያርሾ በሳን ፁግስ። <verse eid="LEV 9:20"/><verse number="21" style="v" sid="LEV 9:21"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ አሮን አንጋይሱዋነ ኡሻቻ ገዳ ዩሾ ያርሾ ኦድ ጎዳ ስንን ዩሽስ።<verse eid="LEV 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22"/>ሄሳፈ ጉየ፥ አሮን ባ ኩሽያ አሳኮ ደንድ ኤንታ አንጅስ። እ ናጋራ ያርሹዋ፥ ፁሳ ያርሹዋነ እስፈተ ያርሹዋ ያርሽዳፐ ጉየ ያርሾ በሳፈ ዎስ። <verse eid="LEV 9:22"/><verse number="23" style="v" sid="LEV 9:23"/>ሙሰይነ አሮን ጌሻ ዱንካንያ ግዶ ገልዶሶና፤ ኤንቲ ያፐ ከይድ አሳ አንጅዶሶና። ሄ ዎደ ጎዳ ቦንቾይ አሳ ኡባስ ቆንጭስ። <verse eid="LEV 9:23"/><verse number="24" style="v" sid="LEV 9:24"/>ጎዳ ማታፐ ታም ዎድ፥ ያርሾ በሳን ደእያ ፁሳ ያርሹዋነ ሞዋ ምስ። አሳ ኡባይ ሄሳ በእዳ ዎደ እልልዶሶና፤ ጉፋንድ ቦንችዶሶና።<verse eid="LEV 9:24"/></para>
  <chapter eid="LEV 9"/>
  <chapter number="10" style="c" sid="LEV 10"/>
  <para style="s1">ናዳባነ አብዮዳ ሀይቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1"/>አሮና አደ ናይት፥ ናዳብነ አብዮድ፥ ባንታ እፃነ ጩይስያ ሚሸ ኤክድ እያ ቦላ ታማ ዎዶሶና፤ እያ ቦላ እፃነ ጉጅዶሶና። ጎዳይ ኤንታ ኪትቦና ጮ ታማ ጎዳ ስንን ሺሽዶሶና። <verse eid="LEV 10:1"/><verse number="2" style="v" sid="LEV 10:2"/>ሄሳ ጋሶን ጎዳ ማታፐ ታም ይድ ኤንታ ምን፥ ኤንቲ ጎዳ ስንን ሀይቅዶሶና። <verse eid="LEV 10:2"/><verse number="3" style="v" sid="LEV 10:3"/>ሙሰይ አሮናኮ፥ ጎዳይ፥</para>
  <para style="q1" vid="LEV 10:3">“ታኒ አሳ ግዶፈ ታኮ ሺቀይሳታ፥</para>
  <para style="q2" vid="LEV 10:3">ታ ጌሻተ በሳና።</para>
  <para style="q1" vid="LEV 10:3">ቃስ አሳ ኡባ ስንን</para>
  <para style="q2" vid="LEV 10:3">ታ ቦንቸታና”</para>
  <para style="m" vid="LEV 10:3">ግድ ኦድዳይሳ ሀይሳ በአ።</para>
  <para style="p" vid="LEV 10:3">አሮን ዛሮ እሞና ስእ ግስ።<verse eid="LEV 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4"/>ሙሰይ አሮና አዋ እሻ ኡዝኤላ አደ ናይታ ምሳኤላነ ኤልዛፋና ፄግድ፥ “ሃ ይድ ህንተ አዋ እሻ ናይታ አሀ ጌሻ ዱንካንያ ስንፈ ደንድ፥ ጉታፐ ጋፃ ከስተ” ያግስ። <verse eid="LEV 10:4"/><verse number="5" style="v" sid="LEV 10:5"/>ኤንቲ ይድ፥ ሙሰይ ኪትዳይሳዳ ኤንታ ካህነተ ማኡዋራ ኤንታ አሀ ቶክድ፥ ጉታፐ ጋፃ ከስዶሶና።<verse eid="LEV 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 10:6"/>ሙሰይ አሮናነ እያ አደ ናይታ፥ አላዛራነ እታማራ ሀይሳዳ ያግስ፤ “ህንተ ሀይቆና መላነ ጎዳይ ባ አሳ ቦላ ሀንቀቶና መላ ህንተ ሁጵያ ሜዶፕተ፤ ህንተ ማኡዋካ ዳኮፍተ። ሽን ህንተ እሻት፥ እስራኤለ አሳይ፥ ጎዳይ ባ ታማን ዎዳይሳታስ ዬኮ። <verse eid="LEV 10:6"/><verse number="7" style="v" sid="LEV 10:7"/>ጎዳ ትዮ ዛይተይ ህንተ ቦላ ድእያ ግሾ ዱንካንያ ፐንገፈ ካረ ከዮፕተ፤ ከይኮ ህንተ ሀይቃና” ያግስ። ኤንቲ ሙሰይ ግዳይሳዳ ኦዶሶና።<verse eid="LEV 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8"/>ጎዳይ አሮናኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 10:8"/><verse number="9" style="v" sid="LEV 10:9"/>ህንተ ሀይቆና መላ ዱንካንያ ግዶ ገልያ ዎደ ነነ ነ ናይት ዎይነ ኡሽ ዎይኮ ሀራ ማይያ ኡሽ ኡዮፕተ፤ ሄስ ስንፈ ያና የለተስ መርናዉ ኤቅድ ደእያ ዎጋ ግዳና። <verse eid="LEV 10:9"/><verse number="10" style="v" sid="LEV 10:10"/>ህንተ ጌሻባነ ጌሽ ግዶናባ ቃስ ቱናባነ ቱና ግዶናባ ሻክድ ኤርተ። <verse eid="LEV 10:10"/><verse number="11" style="v" sid="LEV 10:11"/>ጎዳይ ሙሰ ባጋራ ኦድዳ ዎጋ ኡባ እስራኤለ አሳ ታማርስተ።<verse eid="LEV 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12"/>ሙሰይ አሮናነ አትዳ እያ አደ ናይታ አላዛራነ እታማራ ሀይሳዳ ያግስ፤ ጎዳስ ፁሳ ያርሹዋፈ አትዳ ካ ያርሹዋ ኤክድ እርሾ የጎና ኡክተ። እ ኡባፈ ጌሽ ግድያ ግሾ ያርሾ በሳ ማታን ሚተ። <verse eid="LEV 10:12"/><verse number="13" style="v" sid="LEV 10:13"/>ጎዳስ ፁሳ ያርሹዋፈ ሄስ ነናነ ነ አደ ናይታ ጋክያ ግሾ ግድያ ግሾ፥ ሄሳ ህንተ ጌሻ በሳን ሚተ፤ ሀይሳ ህንተ ኦና መላ ጎዳይ ታና ኪትስ። <verse eid="LEV 10:13"/><verse number="14" style="v" sid="LEV 10:14"/>ሽን ዩሾ ያርሾስ ሺቅዳ አንጋሱዋነ ገዳ ኔኒ፥ ነ አደ ናይትነ ነ ማጫ ናይት ጌሻ በሳን ሚተ። ሄስ እስራኤለ አሳይ ሺሽያ እስፈተ ያርሹዋፈ ነናነ ነ አደ ናይታ ጋክያ ህንተ ግሾ። <verse eid="LEV 10:14"/><verse number="15" style="v" sid="LEV 10:15"/>ጎዳስ ያርሽዳ ገዳነ ዩሾ ያርሾስ ሺቅዳ አንጋሱዋ ሞዋራ እስፈ ጋድ ጎዳ ስንን ዩሾ ያርሾ ኦድ ያርሻናዉ ሺቆ። ጎዳይ ኪትዳይሳዳ፥ ሄስ ነዉነ ነ አደ ናይታስ መርናዉ ህንተና ጋክያ ግሾ ግዳና።<verse eid="LEV 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16"/>ሙሰይ ናጋራ ያርሾስ ሺቅዳ ዴሻ ኤንቲ ዋትዳኮ ኤራናዉ ኮይድ ኦይችስ፤ እ ፁገትዳይሳ ኤርዳ ዎደ አትዳ አሮና አደ ናይታ፥ አላዛራነ እታማራ ቦላ ሀንቀትስ። <verse eid="LEV 10:16"/><verse number="17" style="v" sid="LEV 10:17"/>“ናጋራ ያርሾስ ሺቅዳ አሹዋ አይስ ጌሻ በሳን ምቤከቲ? እ ኡባፈ ጌሽ። ጎዳ ስንን አሳ ናጋራ ድግድ አሳስ አቶተ እማና መላ ሄስ ህንተዉ እመትስ። <verse eid="LEV 10:17"/><verse number="18" style="v" sid="LEV 10:18"/>ሄ መህያ ሱይ ጌሻ ዱንካንያ ግዶ ገልቦና ግሾ፥ ታኒ ህንተና ኪትዳይሳዳ፥ ህንተ እያ ጌሻ በሳን ማናዉ በሴስ፥ ሽን አግደታ” ያግስ።<verse eid="LEV 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 10:19"/>አሮን ሙሰኮ፥ “ሄኮ፥ ሀ አሳት ሀች ባንታ ናጋራ ያርሹዋነ ፁሳ ያርሹዋ ጎዳ ስን ኤህዶሶና። ግዶሽን፥ ሄሳ መላባይ ታ ቦላ ጋክስ። ታኒ ናጋራ ያርሹዋ ሀች ምዳባ ግድያኮ፥ ጎዳይ ኡፋይታናሽን አትዴ?” ያግስ። <verse eid="LEV 10:19"/><verse number="20" style="v" sid="LEV 10:20"/>ሙሰይ ሄሳ ስእዳ ዎደ እያ ዛሩዋን ኡፋይትስ።<verse eid="LEV 10:20"/></para>
  <chapter eid="LEV 10"/>
  <chapter number="11" style="c" sid="LEV 11"/>
  <para style="s1">ቱናነ ቱና ግዶና ዶአታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1"/>ጎዳይ ሙሰኮነ አሮናኮ፥ <verse eid="LEV 11:1"/><verse number="2" style="v" sid="LEV 11:2"/>እስራኤለ አሳስ ሀይሳዳ ያግድ ኦድተ፤ “ቢታ ቦላ ደእያ መሄታፐነ ዶአታፐ ህንተ ማናይሳት ሀይሳታ፤ <verse eid="LEV 11:2"/><verse number="3" style="v" sid="LEV 11:3"/>ሹቁለይ ጳልቀትዳይሳታነ ዋሞትያ መሄታ ሚተ። <verse eid="LEV 11:3"/><verse number="4" style="v" sid="LEV 11:4"/>ሽን ዋሞትሸ ሹቁለይ ጳልቀቶናይሳታነ ሹቁለይ ጳልቀ ግድድ ዋሞቶናይሳታ ሞፕተ። ግማለይ ዋሞቴስ፥ ሽን ሹቁለይ ጳልቀቶና ግሾ፥ ህንተዉ ቱና ግዶ። <verse eid="LEV 11:4"/><verse number="5" style="v" sid="LEV 11:5"/>ጉፓለይ ዋሞቴስ፥ ሽን ሹቁለይ ጳልቀቶና ግሾ፥ ህንተዉ ቱና ግዶ። <verse eid="LEV 11:5"/><verse number="6" style="v" sid="LEV 11:6"/>ኤሸይ ዋሞቴስ፥ ሽን ሹቁለይ ጳልቀ ግዶና ግሾ፥ ህንተዉ ቱና ግዶ። <verse eid="LEV 11:6"/><verse number="7" style="v" sid="LEV 11:7"/>ጉዱን ሞፕተ፤ እያዉ ሹቁለይ ጳልቀ፥ ሽን ዋሞቶና ግሾ፥ እ ህንተዉ ቱና። <verse eid="LEV 11:7"/><verse number="8" style="v" sid="LEV 11:8"/>ህንተ ሄሳታ ሞፕተ፤ ኤንታ ባዉታ ቦቾፍተ፤ ኤንቲ ህንተዉ ቱና።<verse eid="LEV 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9"/>“ሃ ግዶን ደእያ መተ ኡባፈ ህንተ ማናይሳት ሀይሳታ፤ አባ ግዶን ዎይኮ ሻፋ ሃ ግዶን ደእያ ኡባፈ ቀፈይነ ፖቆይ ደእያ ኡባ ሚተ። <verse eid="LEV 11:9"/><verse number="10" style="v" sid="LEV 11:10"/>ሽን አባ ግዶን ዎይኮ ጎግያ ሃን ደእያ ቀፈይነ ፖቆይ ባይና መተት ህንተዉ ቱና ግድያ ግሾ ሞፕተ። <verse eid="LEV 11:10"/><verse number="11" style="v" sid="LEV 11:11"/>ሀይሳቲ ህንተዉ ቱና፤ ኤንታ ሞፕተ፤ ኤንታ ባዉታ ቦቾፍተ። <verse eid="LEV 11:11"/><verse number="12" style="v" sid="LEV 11:12"/>ቀፈይነ ፖቆይ ባይና ሃ ግዶን ደእያ መተት ኡባይ ህንተዉ ቱና።<verse eid="LEV 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 11:13"/>“ካፎታፐ ህንተዉ ቱና ግድዳይሳትነ ህንተ ማናዉ በሶናይሳት ሀይሳታ፤ አርጋን፥ አንኮ፥ ሞሎ ካፎ፥ <verse eid="LEV 11:13"/><verse number="14" style="v" sid="LEV 11:14"/>ፅሎ፥ ጵርጮ ቆሞ ኡባ፥ <verse eid="LEV 11:14"/><verse number="15" style="v" sid="LEV 11:15"/>ቁሮ ኡባ <verse eid="LEV 11:15"/><verse number="16" style="v" sid="LEV 11:16"/>ያንቾ፥ ሶሎ፥ ቆለ፥ ጉቶ ኡባ፥ <verse eid="LEV 11:16"/><verse number="17" style="v" sid="LEV 11:17"/>ጉ ጉቶ፥ ሀዛዞ፥ ዲድን፥ <verse eid="LEV 11:17"/><verse number="18" style="v" sid="LEV 11:18"/>ሃ ኩቶ፥ ሽአ አንኮ፥ ዳረ አንኮ፥ <verse eid="LEV 11:18"/><verse number="19" style="v" sid="LEV 11:19"/>ስላጎ፥ ሳብሳነ እያ ቆሞ ኡባ፥ አያና ካፎነ ሽርሽቆ።<verse eid="LEV 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20"/>“ቀፈራ ደእያ ኦይዱ ቶሆን ሄመትያ ላፋ መተት ኡባይ ህንተዉ ቱና። <verse eid="LEV 11:20"/><verse number="21" style="v" sid="LEV 11:21"/>ግዶሽን፥ ቀፈይ ደእያ ኦይዱ ቶሆን ሄመተይሳታፐ ኤንታ ቶሁዋፐ ቦላራ ጉፓናዉ ማድያ ቶሆይ ደኤይሳታ ሚተ። <verse eid="LEV 11:21"/><verse number="22" style="v" sid="LEV 11:22"/>ሄሳትካ፥ ቦለ ቆሞ ኡባ፥ ፃቆ ኡባነ ሰረ ኡባ። <verse eid="LEV 11:22"/><verse number="23" style="v" sid="LEV 11:23"/>ሽን ሀራ ቀፈራ ደእያ ኦይዱ ቶሆይ ደእያ መተት ኡባይ ህንተዉ ቱና።<verse eid="LEV 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24"/>“ሀይሳቲ ህንተና ቱንሳና፤ ኤንታ ባዉታ ቦችያ ኦንካ ኦማርስ ጋካናዉ ቱና ግዳና። <verse eid="LEV 11:24"/><verse number="25" style="v" sid="LEV 11:25"/>ኤንታ ባዉታ ደንያ ኦንካ ባ ማኡዋ ሜጮ፤ ሽን ኦማርስ ጋካናዉ እ ቱና ግዶ። <verse eid="LEV 11:25"/><verse number="26" style="v" sid="LEV 11:26"/>ሹቁለይ ደእሸ ጳልቀ ግዶናይሳት ዎይኮ ዋሞቶናይሳት ኡባይ ህንተዉ ቱና፤ ኤንታ ቦችያ ኦንካ ቱኔስ። <verse eid="LEV 11:26"/><verse number="27" style="v" sid="LEV 11:27"/>ኦይዱ ቶሆታን ሄመትያ ዶአ ኡባፈ ግንደራ ሄመተይሳት ህንተዉ ቱና፤ ኤንታ ባዉታ ቦችያ ኦንካ ኦማርስ ጋካናዉ ቱኔስ። <verse eid="LEV 11:27"/><verse number="28" style="v" sid="LEV 11:28"/>ኤንታ ባዉታ ደንያ ኦንካ ባ ማኡዋ ሜጮ፤ ሽን ኦማርስ ጋካናዉ እ ቱና። ኤንትካ ህንተዉ ቱና።<verse eid="LEV 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 11:29"/>“ሳአራ ሄመተይሳታፐ ሀይሳቲ ህንተዉ ቱና። ኤንትካ ግሮ፥ ኤጨረ፥ ዱማ ዱማ ኮቸ፥ <verse eid="LEV 11:29"/><verse number="30" style="v" sid="LEV 11:30"/>ጌገ፥ ሀይላሾ፥ ኮርቸ፥ ዋካላነ ሻቃንቾ። <verse eid="LEV 11:30"/><verse number="31" style="v" sid="LEV 11:31"/>ሳአራ ሄመትያ ኡባፈ ሀይሳቲ ህንተዉ ቱና፤ ኤንታ ባዉታ ቦችያ ኦንካ ኦማርስ ጋካናዉ ቱና ግዴስ። <verse eid="LEV 11:31"/><verse number="32" style="v" sid="LEV 11:32"/>ኤንታ ባዉታ ቦችያ አይ ሚሸይካ ቱና ግዴስ፤ ም ሚሸይ ዎይኮ ማኦይ ዎይኮ ጋልብ ዎይኮ ኦጎሮይ ቱና ግዴስ። ኤንታ ባዉታይ ቦችዳ ሚሸ ኡባይ ሃን ሙከትድ ኦማርስ ጋካናዉ ጋምኦ፤ ሄሳፈ ጉየ ጌሽ ግዳና። <verse eid="LEV 11:32"/><verse number="33" style="v" sid="LEV 11:33"/>ኤንታፈ እሱዋ ባዉታይ ኦቶ ግዶን ዎድ በንትኮ፥ እያ ግዶን ደእያባ ኡባይ ቱና፤ ሄ ኦቱዋ መንተ። <verse eid="LEV 11:33"/><verse number="34" style="v" sid="LEV 11:34"/>አይ ካ ግድን ሄ ኦቱዋ ግዶን ደእያ ሃፈ ፆክኮ፥ ሄ ካይ ቱና ግዴስ፤ ኡየትያባ ግድን፥ ሄ ኦቱዋ ግዶን ደእኮ ቱና ግዴስ። <verse eid="LEV 11:34"/><verse number="35" style="v" sid="LEV 11:35"/>ሄ ባዉታፐ እሶይ ዎዳ ሚሸ ኡባይ ቱና፤ ጮጨ ዎይኮ ኦቶ ግድኮካ መንተ፤ ኤንቲ ህንተዉ ቱና። <verse eid="LEV 11:35"/><verse number="36" style="v" sid="LEV 11:36"/>ሄ ባዉታይ ቦችዳ ኡባይ ቱና ግድኮካ ፑልቶይነ ሃ ኦል ቱነና። <verse eid="LEV 11:36"/><verse number="37" style="v" sid="LEV 11:37"/>ኤንታ ባዉታፐ እሶይ ዘረ ካ ቦላ ዎኮ፥ ሄስ ቱነና። <verse eid="LEV 11:37"/><verse number="38" style="v" sid="LEV 11:38"/>ሽን ሄ ዘረ ቦላ ሃ ጉክድ ስምን፥ ኤንታ ባዉታፐ እሶይ እያ ቦላ ዎኮ፥ ሄ ዘረይ ህንተዉ ቱና።<verse eid="LEV 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 11:39"/>“ሜተትያ መሄታፐ እሶይ ባዉትኮ፥ እያ ባዉታ ቦችያ ኦንካ ኦማርስ ጋካናዉ ቱና። <verse eid="LEV 11:39"/><verse number="40" style="v" sid="LEV 11:40"/>ኦንካ ሄ መህያ ባዉታፐ ሚኮ፥ ባ ማኡዋ ሜጮ፤ ኦማርስ ጋካናዉ እ ቱና። ኦንካ እያ ባዉታ ቶክድ ደንኮ፥ ባ ማኡዋ ሜጮ፤ ኦማርስ ጋካናዉ እ ቱና።<verse eid="LEV 11:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41"/>“ሳአራ ጎሸትያ መተ ኡባይ ህንተዉ ቱና፤ እያ ሞፕተ። <verse eid="LEV 11:41"/><verse number="42" style="v" sid="LEV 11:42"/>ኡሎራ ጎሸትያባ ግድን፥ ኦይዱ ቶሆራ ሄመትያባ ግድን፥ ዳሮ ቶሆይ ደእያባ ግድን፥ ሳአራ ጎሸትያ መተ ኡባይ ህንተዉ ቱና ግድያ ግሾ ሞፕተ። <verse eid="LEV 11:42"/><verse number="43" style="v" sid="LEV 11:43"/>ሀ ሳአራ ጎሸትያ መተታን ህንተና ቱንሶፕተ፤ ኤንታ ጋሶን ህንተ አሳተ ቱንሶፕተ። <verse eid="LEV 11:43"/><verse number="44" style="v" sid="LEV 11:44"/>ታኒ ጎዳ፥ ህንተ ፆሳ። ታኒ ጌሽ ግድያ ግሾ፥ ህንተና ዱማይድ ጌሽ ግድተ። ሳአራ ጎሸትያባታን ህንተ አሳተ ቱንሶፕተ። <verse eid="LEV 11:44"/><verse number="45" style="v" sid="LEV 11:45"/>ታኒ ህንተዉ ፆሰ ግዳናዉ ህንተና ግብፀ ቢታፈ ከስዳ ህንተ ጎዳ። ሄሳ ግሾ፥ ታኒ ጌሽ ግድያ ግሾ፥ ህንተካ ጌሽ ግድተ።<verse eid="LEV 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46"/>“መሄ፥ ካፎ፥ ሃ ግዶን ቃፅያ መተ ኡባነ ሳአራ ሄመትያ መተ ኡባ ዎጋይ ሀይሳ። <verse eid="LEV 11:46"/><verse number="47" style="v" sid="LEV 11:47"/>ሄሳን ህንተ ቱናነ ቱና ግዶናይሳታ ግዶን፥ ቃስ ሜተትያነ ሜተቶና መተታ ግዶን ደእያ ዱማተ ሻክድ ኤራና።”<verse eid="LEV 11:47"/></para>
  <chapter eid="LEV 11"/>
  <chapter number="12" style="c" sid="LEV 12"/>
  <para style="s1">ማጫስ የል ስሚድ ጌይያ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 12:1"/><verse number="2" style="v" sid="LEV 12:2"/>እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ “እስ ማጫስ ቃንታዳ አደ ናአ የልኮ፥ ባ ኩሸ መቱዋ በእያ ዎደ ቱና ግደይሳዳ ላፑን ጋላስ ጋካናዉ ቱና ግዳና። <verse eid="LEV 12:2"/><verse number="3" style="v" sid="LEV 12:3"/>ሆስፑን ጋላስ ናአይ ቃፃረታናዉ ኮሼስ። <verse eid="LEV 12:3"/><verse number="4" style="v" sid="LEV 12:4"/>ሄሳፈ ጉየ፥ ማጫስያ ባ የሎ ሱይ ፅዝአና ጋካናዉ ሀስታማነ ሄ ጋላስ ጋምኦ፤ ቃስ ባ ጌይያ ጋላሳይ ዉራና ጋካናዉ ጌሻባ ቦቾፎ፤ ጌሻ ዱንካንያካ ገሎፖ።<verse eid="LEV 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 12:5"/>“ሽን እስ ማጫስ ማጫ ናአ የልኮ፥ ባ ኩሸ መቶ በእዳ ዎደ እያ ቱና ግድዳይሳዳ ናምኡ ሳምንታ ጋካናዉ እያ ቱና ግዳና። ሄሳፈ ጉየ፥ ባ የሎ ሱይ ፅዝአና ጋካናዉ ኡሱፑን ታማነ ኡሱፑን ጋላስ ጋምኦ።<verse eid="LEV 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6"/>“ማጫስያ አደ ናአ ዎይኮ ማጫ ናአ የላዳ ባ ጌይያ ዎድያ ኦንግዳፐ ጉየ፥ ፁሳ ያርሾስ እስ ላይ ዶርሰነ ናጋራ ያርሾስ ቃስ እስ ሆለ ዎይኮ እስ ኩራቾ ጌሻ ዱንካንያ ፐንገን ደእያ ካህንያኮ ኤሆ። <verse eid="LEV 12:6"/><verse number="7" style="v" sid="LEV 12:7"/>ካህነይ ሄሳ ኤክድ ጎዳ ስንን እ ናጋራ አቶተስ ያርሼስ። ሄሳፈ ጉየ፥ እያ ጌያና። አደ ናአ ዎይኮ ማጫ ናአ የልያ ማጫሳስ ደእያ ዎጋይ ሀይሳ።<verse eid="LEV 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 12:8"/>“ሽን እያ እስ ላይ ዶርሰ ኤሀናዉ ዳንዳኦና እፅኮ፥ ናምኡ ሆለታ ዎይኮ ናምኡ ኩራቾታ ኤሆ። ኤንታፈ እሶይ ፁሳ ያርሾስ፥ ቃስ እሶይ ናጋራ ያርሾስ ግዶ። ሄሳዳ ኦድ ካህነይ እ ናጋራ አቶተስ ያርሼስ፤ እያካ ጌሽ ግዳና።”<verse eid="LEV 12:8"/></para>
  <chapter eid="LEV 12"/>
  <chapter number="13" style="c" sid="LEV 13"/>
  <para style="s1">ጎጋ ሀርገ ህገታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1"/>ጎዳይ ሙሰኮነ አሮናኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 13:1"/><verse number="2" style="v" sid="LEV 13:2"/>“እስ አሳ አሳተ ቦላ ክፅ ዎኮ ዎይኮ ሻቶይ ዎይኮ እራለይ ከይኮ እያ ጎጋይ ሀርገን ላመትኮ፥ ሄ ኡራ ካህንያ አሮናኮ ዎይኮ ካህነ ግድዳ እያ አደ ናይታፐ እሱዋኮ ኤሆ። <verse eid="LEV 13:2"/><verse number="3" style="v" sid="LEV 13:3"/>ካህነይ እያ ጎጋ ቦላ ደእያ ማዱን በኦ። ሄ ማዱንፅዳ በሳን ደእያ እክሰይ ቦፅኮነ ማዱንይ ኦላትኮ፥ ሄስ ጎጋ ሀርገ። ካህነይ ሄሳ በእድ ኡራይ ቱና ግደይሳ ኤርሶ። <verse eid="LEV 13:3"/><verse number="4" style="v" sid="LEV 13:4"/>ሽን እያ ጎጋ ቦላ ደእያ ማዱንይ ቦ ግድድ፥ ጎጋፐ ካንድ ኦላትቦናባ ግድኮ ሄ ማዱን ቦላ ደእያ እክሰይ ቦፆናባ ግድኮ፥ ካህነይ ሄ ኡራ ዱማ ኬን ላፑን ጋላስ ጎርድድ ዎ። <verse eid="LEV 13:4"/><verse number="5" style="v" sid="LEV 13:5"/>ላፑን ጋላስ ካህነይ እያ ዛሪድ በኦ፤ እ በእያ ዎደ ማዱንይ ኡራ ጎጋ ቦላ ዳልጎና ካሰይስዳ ደእኮ፥ ካህነይ ሄ ኡራ ናምአን ዱማ ኬን ላፑን ጋላስ ጎርድድ ዎ። <verse eid="LEV 13:5"/><verse number="6" style="v" sid="LEV 13:6"/>ቃስካ ላፑን ጋላስ ካህነይ እያ በኦ፤ እ በእያ ዎደ ማዱንይ ዳልጎና እፅድ ይ ይ ቢኮ፥ ካህነይ እ ቱና ግደይሳ ኤርሶ። ሄስ ጎኦ ግደይሳ ኤርሶ፤ ሄ ኡራይ ባ ማኡዋ ሜጭድ ቱና ግዶናይሳ ኤርሴስ። <verse eid="LEV 13:6"/><verse number="7" style="v" sid="LEV 13:7"/>ሽን እ ጌያናዉ ባና ካህንያ በስዳፐ ጉየ፥ ሄ ጎኦይ እያ ጎጋ ቦላ ዳልግ ዳልግ ቢኮ እ ዛሪድ ባና በሳናዉ ካህንያኮ ቦ። <verse eid="LEV 13:7"/><verse number="8" style="v" sid="LEV 13:8"/>ካህነይ እያ በኦ፤ ሄ ጎኦይ ኡራ ጎጋ ቦላ ዳልግ ዳልግ ቢኮ፥ ሄስ ጎጋ ሀርገ ግድያ ግሾ ካህነይ እ ቱና ግደይሳ ኤርሶ።<verse eid="LEV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9"/>“ኦንካ ጎጋ ሀርገን ኦይከትኮ እያ ካህንያኮ ኤሆ። <verse eid="LEV 13:9"/><verse number="10" style="v" sid="LEV 13:10"/>ካህነይ እያ በእያ ዎደ እያ ጎጋ ቦላ ቦ ክፅ ደእኮ፥ እክሰይ ቦ ላምኮነ ሄ ክፃ ግዶን አሾይ በንትኮ፥ <verse eid="LEV 13:10"/><verse number="11" style="v" sid="LEV 13:11"/>ሄስ ጎጋ ቦላ ጋምእዳ ሀርገ ግድያ ግሾ፥ ካህነይ እ ቱና ግደይሳ ኤርሶ። እ ቱና ግደይስ ኤረትዳ ግሾ፥ እያ ዱማ ኬን ጎርድድ ዎናዉ ኮሸና። <verse eid="LEV 13:11"/><verse number="12" style="v" sid="LEV 13:12"/>ካህነይ ጎጋ ሀርገይ አድያ አሳተ ቦላ ዳልግኮ፥ ሁጰፐ ቶሆ ጋካናዉ ኡባ ማእዳባ ግድኮ በኦ። <verse eid="LEV 13:12"/><verse number="13" style="v" sid="LEV 13:13"/>ሄ ጎጋ ሀርገይ እያ አሳተ ኡባ ማእኮ፥ እያ አሳተይ ኩመ ላመትድ ቦ ግድዳ ግሾ፥ እ ቱና ግዶናይሳ ካህነይ ኤርሶ። <verse eid="LEV 13:13"/><verse number="14" style="v" sid="LEV 13:14"/>ሽን ሄ ማዱን ግዶራ አሾይ በንትኮ እ ቱና። <verse eid="LEV 13:14"/><verse number="15" style="v" sid="LEV 13:15"/>ካህነይ ሄ አሹዋ በእድ ሄ ኡራይ ቱና ግደይሳ ኤርሶ። ሄ አሾይ ጎጋ ሀርገ ግድያ ግሾ እ ቱና። <verse eid="LEV 13:15"/><verse number="16" style="v" sid="LEV 13:16"/>ሽን ሄ አሾይ ቃስካ ላመትድ ቦፅኮ፥ ሄ ኡራይ ካህንያኮ ቦ። <verse eid="LEV 13:16"/><verse number="17" style="v" sid="LEV 13:17"/>ካህነይ እያ በኦ፤ እያ ማዱንይ ቦፅዳባ ግድኮ፥ ሄ ኡራይ ቱና ግዶናይሳ ካህነይ ኤርሶ፤ እ ቱና ግዳና።<verse eid="LEV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18"/>“እስ አሳ ቦላ መርኮይ ዎድ ፓፅዳባ ግድኮ፥ <verse eid="LEV 13:18"/><verse number="19" style="v" sid="LEV 13:19"/>እያ በሳን ቦ ክፃይ ዎኮ ዎይኮ ዞእዳ እራለይ ከይኮ ሄ ኡራይ ካህንያኮ ቦ። <verse eid="LEV 13:19"/><verse number="20" style="v" sid="LEV 13:20"/>ካህነይ እያ በኦ፤ ሄ ማዱንይ ኦላትኮ፥ ማዱን ቦላ ደእያ እክሰይ ላመትድ ቦፅኮ፥ ሄ ኡራይ ቱና ግደይሳ ካህነይ ኤርሶ። ሄስ መርኮዳ ዶምዳ ጎጋ ሀርገ። <verse eid="LEV 13:20"/><verse number="21" style="v" sid="LEV 13:21"/>ሽን ካህነይ በእያ ዎደ እክሰይ ቦፆናባ ግድኮ፥ ማዱንይ ጎጋ ካንድ ኦላትቦናባ ግድኮ፥ ቃስ ይ ይ ቢኮ፥ ካህነይ እያ ዱማ ኬን ላፑን ጋላስ ጎርድድ ዎ። <verse eid="LEV 13:21"/><verse number="22" style="v" sid="LEV 13:22"/>ሄስ እያ ጎጋ ቦላ ዳልግ ዳልግ ቢኮ፥ ሄስ ጎጋ ሀርገ ግድያ ግሾ ሄ ኡራይ ቱና ግደይሳ ካህነይ ኤርሶ። <verse eid="LEV 13:22"/><verse number="23" style="v" sid="LEV 13:23"/>ሽን ሄ እራለይ ዳልግ ዳልግ ቦና እስ በሳን ደእኮ፥ ሄስ መርኮይ ፓፅዳ ቤታ ግድያ ግሾ፥ ሄ ኡራይ ቱና ግዶናይሳ ኤርሶ።<verse eid="LEV 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 13:24"/>“ታም እስ አስ ሚኮ ሄ ምዳ በሳን ቦ ዎይኮ ዞኦ እራለይ ከይኮ፥ <verse eid="LEV 13:24"/><verse number="25" style="v" sid="LEV 13:25"/>ካህነይ ሄ በሳ በኦ። ሄ በሳን ደእያ እክሰይ ቦፅኮነ ሄ ማዱንይ ኦላትኮ፥ ሄስ ጎጋ ሀርገ። እ ታማይ ምዳ በሳራ ከይዳ ግሾ ካህነይ እ ቱና ግደይሳ ኤርሶ። <verse eid="LEV 13:25"/><verse number="26" style="v" sid="LEV 13:26"/>ሽን ካህነይ በእያ ዎደ ሄ ማዱን ቦላ ደእያ እክሰይ ቦፆናባ ግድኮ፥ ማዱንይ ጎጋ ካንድ ኦላትቦናባ ግድኮነ ቃስ ይ ይ ብዳባ ግድኮ፥ ካህነይ እያ ዱማ ኬን ላፑን ጋላስ ጎርድድ ዎ። <verse eid="LEV 13:26"/><verse number="27" style="v" sid="LEV 13:27"/>ላፑን ጋላስ ካህነይ እያ በእያ ዎደ ሄ በሳይ ዳልግ ዳልግ ቢኮ፥ ሄስ ጎጋ ሀርገ ግድያ ግሾ እ ቱና ግደይሳ ካህነይ ኤርሶ። <verse eid="LEV 13:27"/><verse number="28" style="v" sid="LEV 13:28"/>ሽን ሄ ማዱንይ ጎጋ ቦላ ዳልጎና አግድ እስ በሳን ኡትኮነ ይ ይ ቢኮ፥ ሄስ ታማይ ምዳ በሳን አትዳ ቤታ ግድያ ግሾ፥ እ ቱና ግዶናይሳ ካህነይ ኤርሶ።<verse eid="LEV 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29"/>“እስ አደይ ዎይኮ ማጫሳ ሁጰን ዎይኮ ጋጮ ቦላ ማዱን ከይኮ፥ <verse eid="LEV 13:29"/><verse number="30" style="v" sid="LEV 13:30"/>ካህነይ ሄ ማዱን በእያ ዎደ ማዱንይ ጎጋ ካንድ ኦላትኮ እያ ቦላ ደእያ እክሰይ ሌእድ ጋላልኦ ዳንኮ፥ ሄስ ሁጰን ዎይኮ ጋጮ ቦላ ከይያ ቃችያ ጎጋ ሀርገ ግድያ ግሾ፥ ሄ ኡራይ ቱና ግደይሳ ካህነይ ኤርሶ። <verse eid="LEV 13:30"/><verse number="31" style="v" sid="LEV 13:31"/>ቃስ ካህነይ ሄ ሀርግያ በእያ ዎደ ጎጋ ካንድ ኦላትቦናባ ግድኮ፥ ካሬ እክሰይ እያ ቦላ ይኮ፥ ሄ ቃችያ ሀርገይ ደእያ ኡራ ካህነይ ዱማ ኬን ላፑን ጋላስ ጎርድድ ዎ። <verse eid="LEV 13:31"/><verse number="32" style="v" sid="LEV 13:32"/>ላፑን ጋላስ ካህነይ ሄ ሀርግያ በእያ ዎደ ቃችያ ሀርገይ ዳልጎናባ ግድኮ፥ እያ ቦላ ጋላልኦ ዳንያ እክሰይ ባይናባ ግድኮነ ጎጋ ካንድ ኦላትቦናባ ግድኮ፥ <verse eid="LEV 13:32"/><verse number="33" style="v" sid="LEV 13:33"/>ሄ ኡራ ቃችያ በሳን ደእያ እክስያ ግዶናሽን፥ ማዱን ዩሾን ደእያ እክስያ ሜዶ። ካህነይ ሄ ኡራ ዱማ ኬን ሀራ ላፑን ጋላስ ጎርድድ ዎ። <verse eid="LEV 13:33"/><verse number="34" style="v" sid="LEV 13:34"/>ላፑን ጋላስ ካህነይ ሄ ቃችያ በሳ በእያ ዎደ ኡራ ጋልባ ቦላ ዳልጎና እፅኮነ ጎጋ ካንድ ኦላቶና እፅኮ፥ ሄ ኡራይ ቱና ግዶናይሳ ካህነይ ኤርሶ። ኡራይ ባ ማኡዋ ሜጭድ ጌሽ ግዳና። <verse eid="LEV 13:34"/><verse number="35" style="v" sid="LEV 13:35"/>ሽን እ ጌይዳፐ ጉየ፥ ቃችያ ሀርገይ ሄ ኡራ ጋልባ ቦላ ዳልግ ዳልግ ቢኮ፥ <verse eid="LEV 13:35"/><verse number="36" style="v" sid="LEV 13:36"/>ካህነይ እያ በእያ ዎደ ሄ ቃችያ ሀርገይ ዳልግዳባ ግድኮ፥ ሄ ኡራይ ቱንዳ ግሾ ካህነይ ጋላልኦ ዳንያ እክስያ ኮዮፖ። <verse eid="LEV 13:36"/><verse number="37" style="v" sid="LEV 13:37"/>ሽን ካህነይ በእያ ዎደ ሄ ቃችያ በሳይ ዳልጎናባ ግድኮነ ካሬ እክሰይ እያ ቦላ ዶልዳባ ግድኮ፥ ሄ ቃችያ በሳይ ፓፅስ። ሄ ኡራይ ቱና ግዶና ግሾ፥ እ ጌሽ ግደይሳ ካህነይ ኤርሶ።<verse eid="LEV 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38"/>“እስ አደ ዎይኮ ማጫሳ ጎጋ ቦላ ቦ እራለይ ከይኮ፥ <verse eid="LEV 13:38"/><verse number="39" style="v" sid="LEV 13:39"/>ካህነይ በእያ ዎደ ኤንታ ጎጋ ቦላ ደእያ እራለይ ቡላ ግድኮ፥ ሄስ ጎጋ ቦላ ጮ ከይዳባ ግድያ ግሾ ሄ ኡራይ ቱና ግደና።<verse eid="LEV 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 13:40"/>“እስ አሳስ ሁጰ ብናናይ ቆቆፈትኮ፥ ቦአ ግዴስፐ አትሽን፥ እ ቱና ግደና። <verse eid="LEV 13:40"/><verse number="41" style="v" sid="LEV 13:41"/>እስ አስ ስንራ ቦአትኮ፥ እያ ቲሽ ምስፐ አትሽን፥ እ ቱና ግደና። <verse eid="LEV 13:41"/><verse number="42" style="v" sid="LEV 13:42"/>ሽን እያ ቦእ ዎይኮ ቲሽ ምዳይሳ ቦላ ዞኦ ዎይኮ ቦ ማዱን ከይኮ፥ ሄስ እያ ቦአን ዎይኮ እያ ቲሻ ቦላ ከይዳ ጎጋ ሀርገ። <verse eid="LEV 13:42"/><verse number="43" style="v" sid="LEV 13:43"/>እያ ካህነይ በእያ ዎደ እያ ቦእ ዎይኮ ቲሽ ምዳይሳ ቦላ ደእያ ማዱንይ ጋልባ ቦላ ከይያ ጎጋ ሀርገ መላ ዞኦ ግድኮ፥ <verse eid="LEV 13:43"/><verse number="44" style="v" sid="LEV 13:44"/>ሄ ኡራይ ቱማ ጎጋ ሀርገን ኦይከትዳ ሀርጋንቾ። እ ቱና ግድያ ግሾነ እያ ሀርገይ እያ ሁጰን ደእያ ግሾ እ ቱና ግደይሳ ካህነይ ኤርሶ።<verse eid="LEV 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 13:45"/>“ጎጋ ሀርገይ ኦይክዳ አስ ፔትዳ ማኦ ማኦ፤ ባ ሁጵያ ፕፆፖ፤ ባ ዶና ካሞ፤ ባ ቃላ ቁ ኦድ፥ ‘ታኒ ቱና፥ ታኒ ቱና!’ ያጎ። <verse eid="LEV 13:45"/><verse number="46" style="v" sid="LEV 13:46"/>ሄ ሀርገይ እያ ቦላ ደእዳ ዎደ ኡባን እ ቱና። እ ቱና ግድያ ግሾ፥ አሳፐ ሻከትድ፥ ጉታፐ ካረን ባርካ ደኦ።<verse eid="LEV 13:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 13:47"/>“አይ ማኦ ቦላ ቡቅዳ በሲ በንትኮ፥ ሄ ማኦይ ሱፈ ግድን ዎይኮ ሊኖ ግድን፥ <verse eid="LEV 13:47"/><verse number="48" style="v" sid="LEV 13:48"/>ቃጭናፐ ዎይኮ ሻሎፐ ዳደትዳ ሊኖ ዎይኮ ሱፈ ግድን፥ ጋልባ ዎይኮ ጋልባፈ ኦሰትዳ ማኦ ግድን፥ <verse eid="LEV 13:48"/><verse number="49" style="v" sid="LEV 13:49"/>ሄ ማኡዋ ቦላ በንትዳ ቡቃይ ጭሊሎ ዎይኮ ዞኦ ማላ በስኮ፥ እ ቃጭናፐ ዎይኮ ሻሎፐ ዳደትዳባ ግድን፥ ጋልባ ዎይኮ ጋልባፈ ኦሰትዳባ ግድን፥ ሄስ አሳፐ አሰ ኦይክያ ሀርገ ግድያ ግሾ፥ ሄሳ ካህነይ በሳናዉ ኮሼስ። <verse eid="LEV 13:49"/><verse number="50" style="v" sid="LEV 13:50"/>ካህነይ ሄ ቡቃ በእድ፥ ሄ ቡቅዳ ማኡዋ ዱማ ኬን ላፑን ጋላስ ጎርድድ ዎ። <verse eid="LEV 13:50"/><verse number="51" style="v" sid="LEV 13:51"/>ላፑን ጋላስ ካህነይ ሄ ማኡዋ በእያ ዎደ ሄ ማኡዋ ቦላ ደእያ ቡቃይ ዳልግ ዳልግ ቢኮ፥ እ ቃጭና ዎይኮ ሻሎ ግድን፥ ጋልባ ዎይኮ ጋልባፈ ኦሰትዳ ማኦ ግድን፥ ሄስ እሱዋፈ እሱዋ ኦይክያ ቡቃ ሀርገ ግድያ ግሾ ሄ ማኦይ ቱና። <verse eid="LEV 13:51"/><verse number="52" style="v" sid="LEV 13:52"/>ሄ ማኦይ ቃጭና ዎይኮ ሻሎ ግድን፥ ሊኖ ዎይኮ ሱፈ ግድን፥ ጋልባፈ ኦሰትዳባ አይባ ግድን፥ ካህነይ እያ ፁጎ። ሄስ እሱዋፈ እሱዋ ኦይክያ ቡቃ ሀርገ ግድያ ግሾ፥ እ ፁገታናዉ በሴስ።<verse eid="LEV 13:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LEV 13:53"/>“ሽን ካህነይ በእያ ዎደ ሄ ቡቃ ማኡዋ ቦላ ዳልግቦናባ ግድኮ፥ እ ቃጭና ዎይኮ ሻሎ ዎይኮ ጋልባፈ ኦሰትዳባ አይባ ግድን፥ <verse eid="LEV 13:53"/><verse number="54" style="v" sid="LEV 13:54"/>ሄ ቡቃይ ደእያ ማኡዋ ሜጫና መላ ካህነይ ኪቶ። ሄሳፈ ጉየ፥ ሄ ማኡዋ ዱማ ኬን ሀራ ላፑን ጋላስ ጎርድድ ዎ። <verse eid="LEV 13:54"/><verse number="55" style="v" sid="LEV 13:55"/>ሄ ማኦይ ሜጨትዳፐ ጉየ ቃስካ ካህነይ በእያ ዎደ ሄ ቡቃይ ባ ማላ ላሞናባ ግድኮነ ዳልግ ዳልግ ቦና እፅኮካ እ ቱና። ሄ ቡቃ በሳይ ማኡዋስ ጉየ ባጋራ ዎይኮ ስን ባጋራ ደእኮካ ሄ ማኦይ ታማን ፁገታናዉ ኮሼስ። <verse eid="LEV 13:55"/><verse number="56" style="v" sid="LEV 13:56"/>ሽን ሄ ማኡዋ ሜጭ ስምን ካህነይ በእያ ዎደ ቡቃይ ይ ይ ቢኮ፥ እ ጋልባ ግድን፥ ቃጭና ዎይኮ ሻሎ ግድን፥ ሄ ቡቃይ ደእያ በሳ ካህነይ ዳክድ ከሶ። <verse eid="LEV 13:56"/><verse number="57" style="v" sid="LEV 13:57"/>ሄሳፈ ጉየ፥ ማኡዋ ቦላ ስሚድ ከይኮ፥ ሄ ማኦይ ቃጭና ዎይኮ ሻሎ ግድን፥ ጋልባፈ ኦሰትዳባ ግድን፥ ሄስ ዳልግ ዳልግ ቢኮ ሄ ቡቃይ ደእያ ማኦይ ታማን ፁገታናዉ በሴስ። <verse eid="LEV 13:57"/><verse number="58" style="v" sid="LEV 13:58"/>ሽን ሜጨትዳ ማኦይ ቃጭና ዎይኮ ሻሎ ግድን፥ ዎይኮ ጋልባፈ ኦሰትዳባ ማኦ ግድን፥ ቡቃ ማላይ ይኮ፥ ሄ ማኦይ ናምአን ሜጨቶ፤ ሄሳፈ ጉየ፥ እ ጌዬስ” ያግስ።<verse eid="LEV 13:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59"/>እስ ማኦይ ሱፈ ዎይኮ ሊኖ ግድን፥ ቃጭና ዎይኮ ሻሎ ግድን፥ ዎይኮ ጋልባፈ ኦሰትዳባ ግድን፥ ሄ ማኡዋ ጌሽ ዎይኮ ቱና ያግሳናዉ ዳንዳእያ ዎጋይ ሀይሳ።<verse eid="LEV 13:59"/></para>
  <chapter eid="LEV 13"/>
  <chapter number="14" style="c" sid="LEV 14"/>
  <para style="s1">ጎጋ ሀርገፈ ጌሾ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 14:1"/><verse number="2" style="v" sid="LEV 14:2"/>ጎጋ ሀርገይ ኦይክዳ ኡራይ ጌይያ ጋላስ ኦናዉ ኮሽያ ዎጋይ ሀይሳ። ሄ ኡራ ካህንያኮ ኤሀናዉ ኮሼስ። <verse eid="LEV 14:2"/><verse number="3" style="v" sid="LEV 14:3"/>ካህነይ ጉታፐ ጋፃ ከይድ እያ ሀርግያ በኦ። እ በእያ ዎደ ጎጋ ሀርገይ ኡራ አሳተፈ ይዳባ ግድኮ፥ <verse eid="LEV 14:3"/><verse number="4" style="v" sid="LEV 14:4"/>ካህነይ ናምኡ ቱና ግዶና ካፎታ፥ ዝጋ ም ቃንፆ፥ ዞኦ ቃጭናነ ህሶጰ ቦንጮ ሄ ሀርግያፈ ጌይያ ኡራ ግሾ ኤሀና መላ ኪቶ። <verse eid="LEV 14:4"/><verse number="5" style="v" sid="LEV 14:5"/>ሄሳፈ ጉየ፥ ካህነይ ናምኡ ካፎታፐ እሱዋ ፑልቶፈ ዱቅድ ከረን ቆልዳ ሃ ቦላ ሹካና መላ ኪቶ። <verse eid="LEV 14:5"/><verse number="6" style="v" sid="LEV 14:6"/>ሀንኮ ካፉዋ ዞኦ ቃጭናራነ ህሶጰ ቦንጮራ ኤክድ፥ ከረን ደእያ ፑልቶ ሃ ቦላ ሹክዳ ካፉዋ ሱን ናቆ። <verse eid="LEV 14:6"/><verse number="7" style="v" sid="LEV 14:7"/>ሄ ሱ፥ ሄ ጎጋ ሀርግያፈ ጌይያ ኡራ ቦላ ላፑን ቶሆ ዉርፆ፤ ሄ ኡራይ ቱና ግዶናይሳ ኤርሶ፤ ፓፃ ደእያ ካፉዋ ደምባ የዶ።<verse eid="LEV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 14:8"/>ሄ ሀርግያፈ ጌይያ ኡራይ ባ ማኡዋ ሜጮ፤ ባ አሳተ ቦላ ደእያ እክሰ ኡባ ሜደቶ፤ ባ አሳተ ሜጨቶ። ሄሳፈ ጉየ፥ እ ጌይድ ጉታ ገሎ፥ ሽን ባ ዱንካንያ ግዶ ገሎና ላፑን ጋላስ ካረን ጋምኦ። <verse eid="LEV 14:8"/><verse number="9" style="v" sid="LEV 14:9"/>ላፑን ጋላስ ባ ሁጵያ፥ ቡቻ፥ ዴሙዋነ ባ አሳተ ቦላ ደእያ ሀራ እክሰ ኡባ ሜደቶ፤ ቃስ ባ ማኡዋ ሜጮ፤ ባ አሳተካ ሜጨቶ፤ ሄሳፈ ጉየ፥ እ ጌሽ ግዳና።<verse eid="LEV 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10"/>ሆስፑን ጋላሳን ቦረይ ባይና ናምኡ ኡርገ ዶርሳታነ እስ ላይ ግድዳ እስ ማጫ ዶርሰ ኤሆ። ቃስ ካ ያርሾስ ዛይተራ ሙኑቀትዳ ሄ ክሎ ግራመ ሎኦ ለነ እስ ልትሮ ዛይተፐ ስኮ ኤሆ። <verse eid="LEV 14:10"/><verse number="11" style="v" sid="LEV 14:11"/>እያ ጌሽያ ካህነይ ኡራነ እ ኤህዳ ያርሾታራ እስፈ ጌሻ ዱንካንያ ፐንገን ጎዳ ስንን ሺሾ።<verse eid="LEV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 14:12"/>ካህነይ ናምኡ ዶርሳ ኡርገታፐ እሱዋ ኤክድ፥ እስ ልትሮስ ስኮ ዛይተራ እስፈ ናቆ ያርሾ ኦድ ሺሾ፤ ሄ ሺቅዳ ያርሹዋ ዩሾ ያርሾ ኦድ ጎዳ ስንን ሺሾ። <verse eid="LEV 14:12"/><verse number="13" style="v" sid="LEV 14:13"/>ያትድ፥ እ ሄ ዶርሳ ኡርግያ ናጋራ ያርሾነ ፁሳ ያርሾ ሹክያ ጌሻ በሳን ሹኮ። ናጋራ ያርሹዋ መላ ናቆ ያርሾይካ ካህንያስ እመቴስ፤ እካ ኡባፈ አዳ ጌሽ። <verse eid="LEV 14:13"/><verse number="14" style="v" sid="LEV 14:14"/>ካህነይ ናቆ ያርሹዋ ሱፈ ጉ ኤክድ፥ ሄ ጌይያ ኡራስ ኡሻቻ ባጋ ሀይ፥ ኡሻቻ ኩሽያ ዎጋ ብራያነ ኡሻቻ ቶሁዋ ዎጋ ብራያ ትዮ። <verse eid="LEV 14:14"/><verse number="15" style="v" sid="LEV 14:15"/>ሄሳፈ ጉየ፥ ካህነይ ዛይትያፐ ጉራ ኤክድ፥ ባ ሀድርሳ ኩሽያ ቃቃን ትጎ።<verse eid="LEV 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 14:16"/>ሄ ሀድርሳ ኩሽያ ቃቃን ደእያ ዛይትያ ባ ኡሻቻ ኩሸ ብራያ የድ የድ ኤክድ፥ ጎዳ ስንን ላፑን ቶሆ ዉርፆ። <verse eid="LEV 14:16"/><verse number="17" style="v" sid="LEV 14:17"/>ያትድ፥ ባ ኩሽያ ቃቃን ደእያ ዛይትያፐ ኤክድ፥ ጌይያ ኡራስ ኡሻቻ ሀይ፥ ኡሻቻ ኩሽያ ዎጋ ብራያነ ኡሻቻ ቶሁዋ ዎጋ ብራያ ካሰ ናቆ ያርሹዋ ሱ ትይዳ በሳን ትዮ። <verse eid="LEV 14:17"/><verse number="18" style="v" sid="LEV 14:18"/>ቃስ ባ ኩሽያ ቃቃን አትዳ ዛይትያ ካህነይ ጌይያ ኡራ ሁጰን ጉሶ፤ ያትድ ጎዳ ስንን ሄ ኡራ ናጋራ አቶ ያግሶ።<verse eid="LEV 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 14:19"/>ሄሳፈ ጉየ ካህነይ ጌይያ ኡራ ናጋራ አቶተስ ሺቅዳ ያርሹዋ ያርሼስ፤ ካልድ ቃስ ፁሳ ያርሾስ ሺቅዳ መህያ ሹኬስ። <verse eid="LEV 14:19"/><verse number="20" style="v" sid="LEV 14:20"/>ካህነይ ፁሳ ያርሹዋ ካ ያርሹዋራ እስፈ ያርሾ በሳን ዎድ ፁጌስ፤ ያትድ ኡራ ናጋራ አቶ ያግሴስ፤ ሄ ኡራይ ጌዬስ።<verse eid="LEV 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21"/>ሽን ኡራይ ሄሳ ኡባ ኤሀናዉ ዳንዳኦና ማንቆ ግድኮ፥ ጎዳ ስንን እያ ናጋራ አቶተስ ዩሻናዉ ናቆ ያርሾስ እስ ዶርሳ ኡርገ ኤሆ። ካ ያርሾስ ዛይተራ ሙኑቀትዳ እስ ክሎ ግራመ ሎኦ ለነ እስ ልትሮ ዛይተፐ ስኩዋ ኤሆ። <verse eid="LEV 14:21"/><verse number="22" style="v" sid="LEV 14:22"/>ባዉ ዳንዳኤትዳ መላ ናምኡ ሆለ ዎይኮ ናምኡ ኩራቾ እሱዋ ናጋራ ያርሾስ፥ እሱዋ ፁሳ ያርሾስ ኤሆ።<verse eid="LEV 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 14:23"/>ሆስፑን ጋላስ ባ ቱናተፈ ጌይያ ኡራይ ጌሻ ዱንካንያ ፐንገን ጎዳ ስን ኤህድ ካህንያስ እሞ። <verse eid="LEV 14:23"/><verse number="24" style="v" sid="LEV 14:24"/>ካህነይ ናቆ ያርሾስ ይዳ ዶርሳ ኡርግያነ ዛይትያ ኤክድ፥ ዩሾ ያርሾ ኦድ ጎዳ ስንን ዩሾ። <verse eid="LEV 14:24"/><verse number="25" style="v" sid="LEV 14:25"/>ናቆ ያርሾስ ይዳ ዶርሳ ኡርግያ ሹኮ፤ ሄ ኡርግያ ሱፈ ጉራ ኤክድ፥ ሀ ጌይያ ኡራ ኡሻቻ ሀይ፥ ኡሻቻ ኩሽያ ዎጋ ብራያነ ኡሻቻ ቶሁዋ ዎጋ ብራያ ትዮ። <verse eid="LEV 14:25"/><verse number="26" style="v" sid="LEV 14:26"/>ካህነይ ዛይትያፐ ጉራ ባ ሀድርሳ ኩሽያ ቃቃን ትጎ። <verse eid="LEV 14:26"/><verse number="27" style="v" sid="LEV 14:27"/>ሀድርሳ ኩሽያ ቃቃን ደእያ ዛይትያፐ ኡሻቻ ኩሽያ ብራያ የድ ኤክድ፥ ጎዳ ስንን ላፑን ቶሆ ዉርፆ። <verse eid="LEV 14:27"/><verse number="28" style="v" sid="LEV 14:28"/>ካህነይ ባ ኩሽያ ቃቃን ደእያ ዛይትያፐ ጉራ ኤክድ፥ ጌይያ ኡራስ ኡሻቻ ሀይ፥ ኡሻቻ ኩሽያ ዎጋ ብራያነ ኡሻቻ ቶሁዋ ዎጋ ብራያ ካሰ ናቆ ያርሾ ሱ ትይዳ በሳን ትዮ። <verse eid="LEV 14:28"/><verse number="29" style="v" sid="LEV 14:29"/>ጎዳ ስንን ኡራ ናጋራ አቶተስ ካህነይ ባ ኩሸን አትዳ ዛይትያ ጌይያ ኡራ ሁጰን ትጎ። <verse eid="LEV 14:29"/><verse number="30" style="v" sid="LEV 14:30"/>ሄሳፈ ጉየ፥ ጌይያ ኡራይ ባዉ ዳንዳኤትዳይሳ መላ ሆለ ዎይኮ ኩራቾ ኤሆ። <verse eid="LEV 14:30"/><verse number="31" style="v" sid="LEV 14:31"/>እሱዋ ናጋራ ያርሾስ ናምአንዋ ፁሳ ያርሾስ ካ ያርሹዋራ እስፈ ሺሾ። ካህነይ ጌይያ ኡራ ናጋራ ጎዳ ስንን እያ ናጋራ አቶ ያግሶ። <verse eid="LEV 14:31"/><verse number="32" style="v" sid="LEV 14:32"/>ባ አሳተ ቦላ ደእያ ጎጋ ሀርግያፈ ጌያናዉ ማንቆተ ድግዳ ኡራስ ደእያ ዎጋይ ሀይሳ።<verse eid="LEV 14:32"/></para>
  <para style="s1">ኬ ቦላ ከይያ ቡቃ</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33"/>ጎዳይ ሙሰኮነ አሮናኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 14:33"/><verse number="34" style="v" sid="LEV 14:34"/>“ታኒ ህንተዉ እምያ ካናነ ቢታ ህንተ ገልያ ዎደ ሄ ቢታን ደእያ ህንተ ኬፈ እሱዋን ታኒ ቡቃ የድያ ዎደ፥ <verse eid="LEV 14:34"/><verse number="35" style="v" sid="LEV 14:35"/>ሄ ኡራይ ካህንያኮ ብድ፥ ‘ታ ኬ ቦላ ቡቃ ዳንያባይ ደኤስ’ ያግድ ኦዶ። <verse eid="LEV 14:35"/><verse number="36" style="v" sid="LEV 14:36"/>ካህነይ ሶ ገልድ ቡቃ ቆሙዋ በአናፐ ካሰትድ፥ ሶን ደእያባይ ኡባይ ቱና ጌተቶና መላ ሶን ደእያባ ኡባ ካረ ከሳና መላ ኪቶ፤ ሄሳፈ ጉየ፥ ካህነይ በአናዉ ሶ ገሎ። <verse eid="LEV 14:36"/><verse number="37" style="v" sid="LEV 14:37"/>እ ገልድ በእያ ዎደ ቡቃይ ጎዳ ቦላ ጭሊሎ ዎይኮ ዞኦ ማላ በስኮነ ቃስ ጎዳ ምድ ኦላይድ ግዶ ገልኮ፥ <verse eid="LEV 14:37"/><verse number="38" style="v" sid="LEV 14:38"/>ካህነይ ካረ ከይድ፥ ኬ ላፑን ጋላስ ጋካናዉ ጎርዶ። <verse eid="LEV 14:38"/><verse number="39" style="v" sid="LEV 14:39"/>ላፑን ጋላሳን ካህነይ ሄ ኬ ዛሪድ ፄልያ ዎደ ሄ ቡቃይ ኬ ጎዳ ቦላ ዳልግኮ፥ <verse eid="LEV 14:39"/><verse number="40" style="v" sid="LEV 14:40"/>ቡቃይ ደእያ ሹቻ ኡባ ጎዳፐ ሾድድ፥ ካታማፐ ጋፃ ከስድ ቱና በሳን የጋና መላ ኪቶ። <verse eid="LEV 14:40"/><verse number="41" style="v" sid="LEV 14:41"/>ካልድ ጎዳ ሜሽዳ ኡርቃ ሶ ባጋራ ቦክድ፥ ዩሽ አድ ቆቆፋና መላ ኦ፤ ያትድ ሄ ኡርቃ ካታማፐ ጋፃን ደእያ ቱና በሳን የጎ። <verse eid="LEV 14:41"/><verse number="42" style="v" sid="LEV 14:42"/>ሄሳፈ ጉየ፥ ሄ ሾደትዳ ሹቻታ በሳን ሀራ ሹቻታ ዎ፤ ሀራ ኡርቃን ኬ ሜሾ።<verse eid="LEV 14:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43"/>“ሹቻይ ሾደትን፥ ኡርቃይ ቆቆፈትን፥ ሀራ ኡርቃ ሜሽ ስምን፥ ቡቃይ ኬ ግዶን ዛር በንትኮ፥ <verse eid="LEV 14:43"/><verse number="44" style="v" sid="LEV 14:44"/>ካህነይ ሄሳ በኦ። እ በእያ ዎደ ቡቃይ ሄ ኬ ግዶን ዳልግኮ፥ ሄስ አሳፐ አሰ ኦይክያ ቡቃ ሀርገ ግድያ ግሾ ሄ ካይ ቱና። <verse eid="LEV 14:44"/><verse number="45" style="v" sid="LEV 14:45"/>ሄሳ ግሾ ሄ ኬ፥ እያ ሹቻ፥ እያ ምነ እ ሜሸትዳ ኡርቃ ኡባ ላልድ ካታማፐ ጋፃ ኤፍድ፥ ቱና በሳን የጎ። <verse eid="LEV 14:45"/><verse number="46" style="v" sid="LEV 14:46"/>ሄ ኬይ ጎርዳን ጋምእያ ዎደ እያ ግዶ ገልያ ኦንካ ኦማርስ ጋካናዉ ቱና። <verse eid="LEV 14:46"/><verse number="47" style="v" sid="LEV 14:47"/>ሄ ኬን አቅያ ዎይኮ ካ ምያ ኡራይ ባ ማኡዋ ሜጮ።<verse eid="LEV 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48"/>“ሽን ካህነይ ይድ ፄልያ ዎደ ኬይ ሜሸትድ ስምን፥ ዛሪድ ዳልጎና እፅኮ፥ ቡቃይ ይዳ ግሾ፥ ሄ ኬይ ቱና ግዶናይሳ ካህነይ ኤርሶ። <verse eid="LEV 14:48"/><verse number="49" style="v" sid="LEV 14:49"/>ኬ ጌሻናዉ ናምኡ ካፎታ፥ ዝጋ ም ቃንፆ፥ ዞኦ ቃጭናነ ህሶጰ ቦንጮ ኤሆ። <verse eid="LEV 14:49"/><verse number="50" style="v" sid="LEV 14:50"/>ካፎታፐ እሱዋ ፑልቶፈ ዱቅድ ከረን ቆልዳ ሃን ሹኮ። <verse eid="LEV 14:50"/><verse number="51" style="v" sid="LEV 14:51"/>ሄሳፈ ጉየ፥ ዝጋ፥ ህሶጰ ቦንጩዋ፥ ዞኦ ቃጭናነ ፓፃ ደእያ ካፉዋ ኤክድ፥ ከረን ደእያ ሹከትዳ ካፉዋ ሱንነ ፑልቶ ሃን የድ ኤክድ ላፑን ቶሆ ሄ ኬ ዉርፆ። <verse eid="LEV 14:51"/><verse number="52" style="v" sid="LEV 14:52"/>ያትድ፥ ካህነይ ሄ ኬ ካፉዋ ሱን፥ ፑልቶ ሃን፥ ፓፃ ደእያ ካፉዋን፥ ዝጋ ምን፥ ህሶጰ ቦንጩዋንነ ዞኦ ቃጭናን ጌሾ። <verse eid="LEV 14:52"/><verse number="53" style="v" sid="LEV 14:53"/>ፓፃ ደእያ ካፉዋ ካታማፐ ጋፃ የዶ። ሄሳዳ ኦድ፥ ኬ ጌሽያ ዎጋ ፖሌስ፤ ኬይ ጌሽ ግዴስ።<verse eid="LEV 14:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 14:54"/>“ዱማ ዱማ ጎጋ ሀርጌስነ ጎኦ ሀርጌስ እመትዳ ዎጋይ ሀይሳ። <verse eid="LEV 14:54"/><verse number="55" style="v" sid="LEV 14:55"/>ማኦ ቦላ ዎይኮ ኬ ቦላ ከይያ ቡቃ ሀርገ ግድን፥ <verse eid="LEV 14:55"/><verse number="56" style="v" sid="LEV 14:56"/>ክፃ ግድን፥ መርኮ ግድን፥ እራለ ግድን፥ <verse eid="LEV 14:56"/><verse number="57" style="v" sid="LEV 14:57"/>እስባይ ቱና ግደይሳነ ቱና ግዶናይሳ ኤርስያ ዎጋይ ሀይሳ።”<verse eid="LEV 14:57"/></para>
  <chapter eid="LEV 14"/>
  <chapter number="15" style="c" sid="LEV 15"/>
  <para style="s1">አሳተፈ ጎግድ ቱንስያባታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1"/>ጎዳይ ሙሰኮነ አሮናኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 15:1"/><verse number="2" style="v" sid="LEV 15:2"/>እስራኤለ አሳስ ሀይሳዳ ያግድ ኦድተ፤ “እስ አሳ አሳተፈ ጎግያባይ ደእኮ ሄስ ቱና። <verse eid="LEV 15:2"/><verse number="3" style="v" sid="LEV 15:3"/>ጎግያባይ ደእያ ኡራ ቱና ኦያ ዎጋይ ሀይሳ፤ ሄ ጎግያባይ አግን፥ አጎና እፅን፥ ሄ ኡራ ቱና ኦስ።<verse eid="LEV 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 15:4"/>“እያ አሳተፈ ጎግያባይ ደእያ ኡራይ ዝንእያ ሂፃይነ ኡትያ ኦይደ ኡባይ ቱና። <verse eid="LEV 15:4"/><verse number="5" style="v" sid="LEV 15:5"/>እያ ሂፃ ቦችያ ኦንካ ባ ማኡዋ ሜጮ፤ ባ አሳተካ ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ ቱና ግዴስ። <verse eid="LEV 15:5"/><verse number="6" style="v" sid="LEV 15:6"/>ጎግያባይ ደእያ ኡራይ ኡትዳባ ቦላ ኡትያ ኦንካ ባ ማኡዋ ሜጮ፤ ባ አሳተካ ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ ቱና ግዴስ።<verse eid="LEV 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 15:7"/>“ጎግያባይ ደእያ ኡራ አሳተ ቦችያ ኦንካ ባ ማኡዋ ሜጮ፤ ባ አሳተ ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ እ ቱና ግዴስ።<verse eid="LEV 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 15:8"/>“ጎግያባይ ደእያ አስ ቱና ግዶና አሳ ቦላ ጩትኮ፥ ሄ ኡራይ ባ ማኡዋ ሜጮ፤ ባ አሳተካ ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ እ ቱና ግዴስ።<verse eid="LEV 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 15:9"/>“ጎግያባይ ደእያ ኡራይ ኡትያ ቶጋ ኮር ቱና። <verse eid="LEV 15:9"/><verse number="10" style="v" sid="LEV 15:10"/>እያፐ ጋርሳራ ደእያባ ቦችያ ኦንካ ኦማርስ ጋካናዉ ቱና ግዴስ፤ ቃስ ሄሳ ቶክያ ኦንካ ባ ማኡዋ ሜጮ፤ ባ አሳተ ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ እ ቱና ግዴስ።<verse eid="LEV 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 15:11"/>“ጎግያባይ ደእያ አስ ባ ኩሽያ ሜጨቶና ቦችያ አስ ኦንካ ባ ማኡዋ ሜጮ፤ ባ አሳተ ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ ቱና ግዴስ።<verse eid="LEV 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 15:12"/>“ጎግያባይ ደእያ ኡራይ ቦችያ ኦቶ ኡባ መንተ፤ ምፈ ኦሰትዳ ሚሸ ኡባይ ሃን ሜጨቶ።<verse eid="LEV 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13"/>“ጎግያባይ ደእያ አስ ሄ ጎግያባፐ ጌይዳ ዎደፐ ላፑን ጋላስ ጋምኦ። ባ ማኡዋ ሜጮ፤ ባ አሳተ ፑልቶ ሃን ሜጨቶ፤ ያትድ እ ጌሽ ግዴስ። <verse eid="LEV 15:13"/><verse number="14" style="v" sid="LEV 15:14"/>ሆስፑን ጋላሳን ናምኡ ሆለታ ዎይኮ ናምኡ ኩራቾታ ኤክድ፥ ጌሻ ዱንካንያ ፐንገ፥ ጎዳ ስን ኤህድ ካህንያስ እሞ። <verse eid="LEV 15:14"/><verse number="15" style="v" sid="LEV 15:15"/>ካህነይ ሆለታፐ እሱዋ ናጋራ ያርሾስ፥ እሱዋ ቃስ ፁሳ ያርሾስ ያርሼስ፤ ያትድ ካህነይ ኡራ አሳተፈ ጎግያባ ግሾ ጎዳ ስንን እያ ናጋራ አቶ ያግሴስ።<verse eid="LEV 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16"/>“እስ አደፈ እያ አቱንይ ጉክኮ፥ ባ ኩመ አሳተካ ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ እ ቱና ግዴስ። <verse eid="LEV 15:16"/><verse number="17" style="v" sid="LEV 15:17"/>አቱንይ ቦችዳ ማኦ ኡባይ ዎይኮ ጋልባ ኡባይ ሃን ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ ቱና ግዴስ። <verse eid="LEV 15:17"/><verse number="18" style="v" sid="LEV 15:18"/>እስ አደይ ማጫራ አቅን፥ እያ አቱንይ ጉክኮ፥ ናምአይካ ሃን ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ ኤንቲ ቱና ግዶሶና።<verse eid="LEV 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19"/>“እስ ማጫስ ባ ኩሸ መቶ በእኮ፥ ላፑን ጋላስ ጋካናዉ እያ ቱና፤ እዮ ቦችያ ኦንካ ኦማርስ ጋካናዉ ቱና።<verse eid="LEV 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 15:20"/>“ባ ኩሸ መቶ ዎደ እያ ዝንእያ ሂፃይነ እያ ኡትያ ኦይደይ ኡባይ ቱና። <verse eid="LEV 15:20"/><verse number="21" style="v" sid="LEV 15:21"/>እያ ዝንእያ ሂፃ ቦችያ ኡባይ ባ ማኡዋ ሜጮ፤ ባ አሳተካ ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ ቱና ግዶ። <verse eid="LEV 15:21"/><verse number="22" style="v" sid="LEV 15:22"/>እያ ኡትያባ ቦችያ ኡባይ ባ ማኡዋ ሜጮ፤ ባ አሳተ ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ ቱና ግዶ። <verse eid="LEV 15:22"/><verse number="23" style="v" sid="LEV 15:23"/>እያ ዝንእያ ሂፃ ግድን ዎይኮ እያ ኡትያባ ቦችያ ኦንካ ኦማርስ ጋካናዉ ቱና።<verse eid="LEV 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 15:24"/>“እስ ማጫስ ኩሸ መቶራ ደእያ ዎደ አደይ ኢራ አቅኮ፥ ሄ ኩሸ መቱዋ እ ቦችኮ፥ ላፑን ጋላስ ጋካናዉ እ ቱና ግዴስ፤ እ ዝንእያ ሂፃ ኡባይ ቱና ግዴስ።<verse eid="LEV 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 15:25"/>“እስ ማጫስ፥ ባ ኩሸ መቶ ዎደይ አን፥ ሱ አጎና ጎግኮ ዎይኮ ኩሸ መቶ ዎደይ ባ ቃማፈ አድ ጎግኮ፥ ኩሸ መቶ ዎደ እያ ቱና ግድዳይሳዳ ሱይ ኤቃና ጋካናዉ እያ ቱና ግዳዉሱ። <verse eid="LEV 15:25"/><verse number="26" style="v" sid="LEV 15:26"/>ሱ ኢፐ ጎግያ ዎደ እያ ዝንእያ ሂፃ ኡባይ፥ ባ ኩሸ መቶ በእያ ዎደ እያ ዝንእዳ ሂፃ መላነ እያ ኡትያ ኦይድያ መላ ቱና ግዴስ። <verse eid="LEV 15:26"/><verse number="27" style="v" sid="LEV 15:27"/>ሄ ቱንዳባታ ቦችያ ኦንካ ቱና ግድያ ግሾ እ ባ ማኡዋ ሜጮ፤ ባ አሳተ ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ ቱና ግዴስ።<verse eid="LEV 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 15:28"/>“ኢፐ ጎግያ ሱይ ኤቅኮ፥ እያ ሄ ዎደፐ ዶማዳ ላፑን ጋላስ ጋምኦ፤ ሄሳፈ ጉየ፥ እያ ጌሽ ግዳና። <verse eid="LEV 15:28"/><verse number="29" style="v" sid="LEV 15:29"/>ሆስፑን ጋላስ እያ ናምኡ ሆለታ ዎይኮ ናምኡ ኩራቾታ ኤሀዳ ጌሻ ዱንካንያ ፐንገን ካህንያስ እሞ። <verse eid="LEV 15:29"/><verse number="30" style="v" sid="LEV 15:30"/>ካህነይ ሆለታፐ እሱዋ ናጋራ ያርሾስ፥ እሱዋ ፁሳ ያርሾስ ያርሾ። ያትድ፥ ካህነይ ኢፐ ጎግያ ቱናተ ግሾ ጎዳ ስንን እ ናጋራ አቶ ያግሴስ።<verse eid="LEV 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31"/>“እስራኤለ አሳይ ባንታ ግዶን ደእያ ጌሻ ዱንካንያ ቱንስድ፥ ሀይቆና መላ ኔኒ ሀይሳዳ ኦዳ ኤንቲ ባንታና ቱንስያባፐ ዱማይድ ዳና መላ ናጋ።”<verse eid="LEV 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32"/>እያ አሳተፈ ጎግያባይ ደእያ አሳስ፥ እያ አቱይ ጉክን ቱንያ አደስ፥ <verse eid="LEV 15:32"/><verse number="33" style="v" sid="LEV 15:33"/>ባ ኩሸ መቶ ጋሶን ቱንያ ማጫሳስ፥ አደ ግድን ማጫ ግድን ጎግያባይ ደእያ አሳስነ ቱንዳ ማጫራ አቅያ አደስ እመትዳ ዎጋይ ሀይሳ።<verse eid="LEV 15:33"/></para>
  <chapter eid="LEV 15"/>
  <chapter number="16" style="c" sid="LEV 16"/>
  <para style="s1">ናጋራ አቶተ ጋላሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1"/>አሮና አደ ናይት ናምአይ ጎዳ ስን ሺቅድ ሀይቅዳፐ ጉየ፥ ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፦ <verse eid="LEV 16:1"/><verse number="2" style="v" sid="LEV 16:2"/>ታኒ ታቦትያ ናጋራ አቶተ ካማ ቦላ ሻራን ግዳዳ ቆንጭያ ግሾ ማጋራጁዋፈ ጉየን ደእያ ኡባፈ ጌሻ በሳ ባ ኮይዳ ዎደ ገልድ ሀይቆና መላ ነ እሻ አሮናስ ኦዳ። <verse eid="LEV 16:2"/><verse number="3" style="v" sid="LEV 16:3"/>አሮን ናጋራ ያርሾስ እስ ዎፋኖ፥ ፁሳ ያርሾስ እስ ማራዘ ኤክድ ኡባፈ ጌሻ በሳ ገሎ። <verse eid="LEV 16:3"/><verse number="4" style="v" sid="LEV 16:4"/>አሮን ሊኖፐ ኦሰትዳ ጌሻ አዱሳ ቃምሰነ ጋርሳራ ማኤትያ ማኦ ማኦ። ሊኖፐ ኦሰትዳ ዳንጮ ዳንጮ፤ ሄሳዳ ባ ሁጰን ሊኖፐ ኦሰትዳ ፃ ቃጨ ዎ። ሄ ማኦት ጌሽ ግድያ ግሾ፥ ማአናፐ ስን ባ አሳተ ሜጨቶ።<verse eid="LEV 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 16:5"/>እስራኤለ ማባራይ ናጋራ ያርሾስ ናምኡ ኮለታ፥ ፁሳ ያርሾስ እስ ማራዘ አሮናስ ኤሆ። <verse eid="LEV 16:5"/><verse number="6" style="v" sid="LEV 16:6"/>አሮን ባ ናጋራስነ ባ ሶ አሳ ናጋራ አቶተስ እስ ዎፋኖ ያርሾ። <verse eid="LEV 16:6"/><verse number="7" style="v" sid="LEV 16:7"/>ሄሳፈ ጉየ፥ ናምኡ ኮለታ ጌሻ ዱንካንያ ፐንገን ጎዳ ስን ኤሆ። <verse eid="LEV 16:7"/><verse number="8" style="v" sid="LEV 16:8"/>ሄ ናምኡ ዴሻታ ኤክድ እሱዋ ጎዳሳ፥ እሱዋ ቃስ አዛዘላሳ<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="fq" closed="false">አዛዘላሳ፦ </char><char style="ft" closed="false">እብራወ ዶናን መላ ቢታ የደተይሳ ጉሱ።</char></note> ግድ ኤንታ ቦላ ሳማ የጎ። <verse eid="LEV 16:8"/><verse number="9" style="v" sid="LEV 16:9"/>አሮን ሳማን ጎዳስ ግድዳ ዴሻ ኤክድ ናጋራ ያርሾ ኦድ ያርሾ። <verse eid="LEV 16:9"/><verse number="10" style="v" sid="LEV 16:10"/>ሽን ሳማን አዛዘላስ ግድዳ ዴሻ አሳ ናጋራ አቶተስ መላ ቢታ የዳናዉ ፓፃ ደእሽን ጎዳስ ሺሾ።<verse eid="LEV 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11"/>አሮን ባ ናጋራስነ ባ ሶ አሳ ናጋራ አቶተስ እስ ዎፋኖ ናጋራ ያርሾ ኦድ ሺሾ። ያትድ ባ ናጋራ ግሾ ሄ ዎፋኑዋ ሹኮ። <verse eid="LEV 16:11"/><verse number="12" style="v" sid="LEV 16:12"/>ጎዳ ስንን ደእያ ያርሾ በሳፈ እፃነ ጩይስያ ሚሸን ቦንቆ ኩንድ፥ ሊቅድ ጋጨትዳ ሳውያ እፃነ ናምኡ ኩጫ ኤክድ ማጋራጁዋ ግዶ ገሎ። <verse eid="LEV 16:12"/><verse number="13" style="v" sid="LEV 16:13"/>ጎዳ ስንን ደእያ ታማን እፃነ ዎ። እ ሀይቆና መላ እፃንያ ጩያይ ታቦትያ ቦላ ደእያ ናጋራ አቶተ ካማ ካሞ። <verse eid="LEV 16:13"/><verse number="14" style="v" sid="LEV 16:14"/>ዎፋኑዋ ሱፈ ጉራ ኤክድ፥ ባ ብራያ የድ ኤክድ አቶተ ካማ ስን ባጋ ዉርፆ። ናጋራ አቶተ ካማ ስን ባጋራ ደእያ በሳ ላፑን ቶሆ ዉርፆ።<verse eid="LEV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 16:15"/>ሄሳፈ ጉየ፥ አሳ ናጋራ ግሾ ግድያ ዴሻ ሹክድ፥ እያ ሱ ማጋራጁዋ ግዶ ኤህድ፥ ዎፋኑዋ ሱ ዉርፅዳይሳዳ ናጋራ አቶተ ካማነ ታቦትያ ስን ዉርፆ። <verse eid="LEV 16:15"/><verse number="16" style="v" sid="LEV 16:16"/>ኡባፈ ጌሻ በሳ እስራኤለ አሳ ቱናተፈነ ናጋራፐ ጌሼስ። ኤንቲ ቱናባ ኦሽን፥ ኤንታ ግዶን ደእያ ጌሻ ዱንካንያ ሀይሳዳ ኦድ ጌሾ። <verse eid="LEV 16:16"/><verse number="17" style="v" sid="LEV 16:17"/>አሮን ኡባፈ ጌሻ በሳ ገልድ፥ ባ ናጋራ፥ ባ ሶ አሳ ናጋራነ ኩመ እስራኤለ አሳ ናጋራ አቶተስ ያርሽድ ከያና ጋካናዉ፥ ኦንካ ጌሻ ዱንካንያ ግዶን ደኦፖ።<verse eid="LEV 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 16:18"/>ሄሳፈ ጉየ፥ ጎዳ ስንን ደእያ ያርሾ በሳ ከይድ እያ ጌሾ። ዎፋኑዋ ሱፈነ ዴሻ ሱፈ ጉራ ኤክድ፥ ያርሾ በሳ ዩሹዋን ደእያ ካጨታ ትዮ። <verse eid="LEV 16:18"/><verse number="19" style="v" sid="LEV 16:19"/>ሄ ሱን ባ ብራያ የድ ኤክድ ላፑን ቶሆ ዉርፆ፤ ሄሳዳ ኦድ እስራኤለ አሳ ቱናተፈ ሄ ያርሾ በሳ ጌሾ።<verse eid="LEV 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20"/>አሮን ኡባፈ ጌሻ በሳ፥ ጌሻ ዱንካንያነ ያርሾ በሳ ጌሽያ ዎጋ ፖልዳፐ ጉየ፥ ፓፃ ደእያ ዴሻ ሺሾ። <verse eid="LEV 16:20"/><verse number="21" style="v" sid="LEV 16:21"/>አሮን ባ ናምኡ ኩሽያ ፓፃ ደእያ ዴሻ ሁጰን ዎድ፥ እስራኤለ አሳ ናቆ ኡባ፥ ኤንታ ማካላ ኡባ፥ ኤንታ ናጋራ ኡባ ፓፆ። ያትድ ሄ ዴሻ ሁጰን ሄሳ ቶሶ፤ ሄ ዴሻ ኤፋና መላ ጊግስዳ ኡራ ቦላ መላ ቢታ የዶ። <verse eid="LEV 16:21"/><verse number="22" style="v" sid="LEV 16:22"/>ዴሻይ ኤንታ ናጋራ ኡባ ቶክድ፥ አስ ባይና በሲ መላ ቢታ ቦ።<verse eid="LEV 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23"/>ሄሳፈ ጉየ፥ አሮን ጌሻ ዱንካንያ ብድ ኡባፈ ጌሻ በሳ ገሎ። ሊኖፐ ኦሰትዳ ካሰ እ ማእድ ገልዳ ማኡዋ ቃርድ ያን ዎ። <verse eid="LEV 16:23"/><verse number="24" style="v" sid="LEV 16:24"/>ጌሻ በሳን ባ አሳተ ሜጨትድ፥ ባ ካሰ ማኡዋ ማእ ከይድ ባ ናጋራነ አሳ ናጋራ አቶተስ ፁሳ ያርሾ ያርሽሶ። <verse eid="LEV 16:24"/><verse number="25" style="v" sid="LEV 16:25"/>ናጋራ ያርሹዋ ሞዋ ያርሾ በሳን ፁጎ።<verse eid="LEV 16:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 16:26"/>ባዞ የደትያ ዴሻ ኤፍዳ ኡራይ ባ ማኡዋ ሜጮ፤ ባ አሳተ ሜጨቶ፤ ያት ስሚድ ጉታ ገሎ።<verse eid="LEV 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 16:27"/>ናጋራ አቶተስ አሮን ኤንታ ሱ ኡባፈ ጌሻ በሳ ኤህዳ ዎፋኑዋነ ዴሻ ጋልባ፥ አትዳ አሹዋነ ቶጭያ ጉታፐ ጋፃ ከስድ ፁጎ። <verse eid="LEV 16:27"/><verse number="28" style="v" sid="LEV 16:28"/>ሄሳ ፁግዳ ኡራይ ባ ማኡዋ ሜጮ፤ ባ አሳተ ሜጨቶ፤ ሄሳፈ ጉየ፥ ጉታ ገሎ።<verse eid="LEV 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29"/>ሀይስ ህንተዉ መርና ዎጋ ግዶ፤ ላፑን አጌናይ ገልዳ ታማን ጋላስ ህንተና ካዉሽተ፤ ቢታ አዉ ናአ ግድን ዎይኮ ሀራ ቢታ አስ ግድን፥ አይ ኦሶካ ኦፍተ። <verse eid="LEV 16:29"/><verse number="30" style="v" sid="LEV 16:30"/>አይስ ጊኮ ሄ ጋላሳይ ህንተ ናጋራ አቶተ ደምያ ጋላስ፤ ህንተ ጎዳ ስንን ህንተ ናጋራ ኡባፈ ጌያና። <verse eid="LEV 16:30"/><verse number="31" style="v" sid="LEV 16:31"/>ሄስ ህንተዉ ግታ ሳምባታ ሸምፖ ጋላስ ግዳና። ሄ ጋላስ ህንተና ካዉሽተ፤ ሄስ ህንተዉ መርና ዎጋ ግዶ። <verse eid="LEV 16:31"/><verse number="32" style="v" sid="LEV 16:32"/>ቃስ ባ አዋ በሳን ካህነ ግዳና መላ ትየትያነ ዱማትያ ካህነይ ጌሽ ግድዳ ሊኖፐ ኦሰትዳ ማኡዋ ማእድ፥ ናጋራ አቶተ ዎጋ ፖሎ። <verse eid="LEV 16:32"/><verse number="33" style="v" sid="LEV 16:33"/>እ ኡባፈ ጌሻ በሳ፥ ገሻ ዱንካንያ፥ ያርሾ በሳ፥ ካህነታነ እስራኤለ አሳ ኡባ ጌሾ። <verse eid="LEV 16:33"/><verse number="34" style="v" sid="LEV 16:34"/>እስራኤለ አሳ ኡባ ናጋራ አቶተስ ላይን ላይን እስ ቶሆ ኦናዉ ሀይስ ህንተዉ መርና ዎጋ ግዶ። ጎዳይ ኪትዳይሳዳ ሙሰይ ኦስ።<verse eid="LEV 16:34"/></para>
  <chapter eid="LEV 16"/>
  <chapter number="17" style="c" sid="LEV 17"/>
  <para style="s1">ሱ ሞና መላ ድገትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 17:1"/><verse number="2" style="v" sid="LEV 17:2"/>“አሮናስ እያ አደ ናይታስነ እስራኤለ አሳ ኡባስ ሀይሳዳ ያጋዳ ኦዳ፤ ጎዳይ ኪትዳይስ ሀይሳ፤ <verse eid="LEV 17:2"/><verse number="3" style="v" sid="LEV 17:3"/>እስራኤለ አሳፐ ኦንካ ቦር ዎይኮ ማራዘ ዎይኮ ኮለ ጉታን ዎይኮ ጉታፐ ጋፃን ሹክድ፥ <verse eid="LEV 17:3"/><verse number="4" style="v" sid="LEV 17:4"/>ጎዳስ እሞታ ኦድ እማናዉ ጌሻ ዱንካንያ ፐንገ ጎዳ ስን ኤሆና እፅኮ፥ እ ሄ ሱን ኦይሸቴስ። ሄ ኡራይ ሱ ጉስዳ ግሾ ባ አሳ ግዶፈ ኩረቶ። <verse eid="LEV 17:4"/><verse number="5" style="v" sid="LEV 17:5"/>ሄሳ ግሾ፥ እስራኤለ አሳይ ያርሾ መሄ ጮ ደንባን ሹከይሳ አግድ፥ ጎዳ ስንን ጌሻ ዱንካንያ ፐንገን ደእያ ካህንያኮ ኤሆ። ካህነይ ሄሳ ኤክድ፥ ጎዳስ እስፈተ ያርሾ ኦድ ሹኮ። <verse eid="LEV 17:5"/><verse number="6" style="v" sid="LEV 17:6"/>ካህነይ ጌሻ ዱንካንያ ፐንገን ደእያ ያርሾ በሳ ቦላ ሄ ሱ ዉርፆ። ሞዋ ጎዳስ ሳዎ ቶንኩ ግያ ያርሾ ኦድ ፁጎ። <verse eid="LEV 17:6"/><verse number="7" style="v" sid="LEV 17:7"/>እስራኤለ አሳይ ጎዳ አግድ ካልዳ ቱና አያናታስ ዛሪድ ባንታ ያርሹዋ ያርሾፎ። ሄስ ኤንታዉነ ያና የለተ ኡባስ መርና ዎጋ ግዶ።<verse eid="LEV 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 17:8"/>“ኤንታኮ ሀይሳዳ ያጋ፤ እስራኤለ አሳፐ ግድን ዎይኮ ኤንታ ግዶን ደእያ አላጋ ቢታ አሳፐ ግድን፥ ኦንካ ፁሳ ያርሾ ዎይኮ ሀራ ያርሾ ሺሽያ ዎደ፥ <verse eid="LEV 17:8"/><verse number="9" style="v" sid="LEV 17:9"/>ጎዳስ ያርሻናዉ ጌሻ ዱንካንያ ፐንገ ኤሆና እፅኮ፥ ሄ ኡራይ ባ አሳ ግዶፈ ኩረቶ።<verse eid="LEV 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10"/>“እስራኤለ አሳፐ ዎይኮ ኤንታ ግዶን ደእያ አላጋ ቢታ አሳፐ ኦንካ ሱ ሚኮ፥ ሄ ሱ ምያ ኡራ ቦላ ታ ዞኮ ዛራና፤ ታኒ ሄ ኡራ አሳ ግዶፈ ኩራና። <verse eid="LEV 17:10"/><verse number="11" style="v" sid="LEV 17:11"/>አይስ ጊኮ አሾ ማእዳ ኡባ ደኦይ እያ ሱ ግዶን ደኤስ፤ ሱ ደኦይ እያ ግዶን ደእያ ግሾ ናጋራ አቶ ጊሴስ። ህንተ ናጋራ አቶተስ ሱ ያርሻና መላ ህንተዉ እማስ። <verse eid="LEV 17:11"/><verse number="12" style="v" sid="LEV 17:12"/>ታኒ እስራኤለ አሳኮ፥ ህንተፈ ዎይኮ ህንተ ግዶን ደእያ አላጋ ቢታ አሳፐ ኦንካ ሱ ሞፖ ያግዳይ ሄሳ ግሾሳ።<verse eid="LEV 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13"/>“እስራኤለ አሳፐ ዎይኮ ኤንታ ግዶን ደእያ አላጋ ቢታ አሳፐ ኦንካ ሜተትያ ዶአ ዎይኮ ካፎ ሻንካትድ ዎኮ፥ እያ ሱ ሳአን ጉስድ ቢታ ካሞ። <verse eid="LEV 17:13"/><verse number="14" style="v" sid="LEV 17:14"/>አይስ ጊኮ አሾ ማእዳ ኡባ ደኦይ እያ ሱ ግዶና። አሾ ማእዳ መተታ ኡባ ደኦይ እያ ሱ ግዶን ደእያ ግሾ፥ ሱ ሞፕተ፤ ቃስ ምያ ኦንካ ባ አሳ ግዶፈ ኩረቶ ያጋዳ እስራኤለ አሳስ ኦዳስ።<verse eid="LEV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 17:15"/>“እስራኤለ አሳ ግድን ዎይኮ ኤንታ ግዶን ደእያ አላጋ ቢታ አሳ ግድን፥ ኦንካ ባዉታ ዎይኮ ዶእ ዎዳባ ሚኮ፥ ባ ማኡዋ ሜጮ፤ ባ አሳተ ሜጨቶ፤ ያትድ ኦማርስ ጋካናዉ ቱና ግዴስ። ሄሳፈ ጉየ፥ እ ጌሽ ግዳና። <verse eid="LEV 17:15"/><verse number="16" style="v" sid="LEV 17:16"/>ባ ማኡዋ ሜጮና እፅኮ፥ ባ አሳተ ሜጨቶና አግኮ፥ እ ባ ናጋራ ባዉ ቶኬስ።”<verse eid="LEV 17:16"/></para>
  <chapter eid="LEV 17"/>
  <chapter number="18" style="c" sid="LEV 18"/>
  <para style="s1">ድገትዳ ማጫ አደ ጋሄተ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 18:1"/><verse number="2" style="v" sid="LEV 18:2"/>“እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ ታኒ ጎዳ፥ ህንተ ፆሳ። <verse eid="LEV 18:2"/><verse number="3" style="v" sid="LEV 18:3"/>ህንተ ካሰ ደእዳ ግብፀ አሳይ ኦይሳዳ ኦፕተ፤ ዎይኮ ሀእ ታኒ ህንተና ገልስያ ካናነ ቢታ አሳይ ኦይሳዳ ኦፕተ፤ ኤንታ ዎጋ ካሎፍተ። <verse eid="LEV 18:3"/><verse number="4" style="v" sid="LEV 18:4"/>ህንተ ታ ኪታ ኦተ፤ ታ ዎጋ ናግተ፤ ታኒ ጎዳ፥ ህንተ ፆሳ። <verse eid="LEV 18:4"/><verse number="5" style="v" sid="LEV 18:5"/>ታ ኪታነ ታ ዎጋ ናግተ፥ ህንተ ሄሳ ኦኮ ደኦን ዳና። ታኒ ጎዳ።<verse eid="LEV 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6"/>“ህንተፈ ኦንካ ባ ማታ ዳቦራ ፃሎፎ። ታኒ ጎዳ።<verse eid="LEV 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 18:7"/>“ነ አይዉ ፃላዳ ነ አዋ ካዉሾፋ። እያ ነ አይዉ ግድያ ግሾ እዮ ፃሎፋ።<verse eid="LEV 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 18:8"/>“ነ አዋ ማችዉ ፃላዳ ነ አዋ ካዉሾፋ።<verse eid="LEV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 18:9"/>“ነ ምችዉ ፃሎፋ፤ ሶን የለትዳ ዎይኮ ካረን የለትዳ ነ አዋ ናእዉ ዎይኮ ነ አየ ናእዉ ፃሎፋ።<verse eid="LEV 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 18:10"/>“ነ ናኣ ናእዉ ዎይኮ ነ ናኤ ናእዉ ፃላዳ ነ ነና ካዉሾፋ።<verse eid="LEV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 18:11"/>“ነ ምቾ ግድያ ግሾ ነ አዋ ማቸ ናእዉ ፃሎፋ።<verse eid="LEV 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 18:12"/>“ነ አዋ ምችዉ ፃሎፋ፤ እያ ነ አዋስ ማታ ዳቦ።<verse eid="LEV 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 18:13"/>“ነ አየ ምችዉ ፃሎፋ፤ እያ ነ አየስ ማታ ዳቦ።<verse eid="LEV 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 18:14"/>“ነ አዋ እሻ ማችዉ ፃሎፋ፤ እያ ነ አዋ እሻ ማችዉ። <verse eid="LEV 18:14"/><verse number="15" style="v" sid="LEV 18:15"/>ነ ናኣ ማችዉ ፃሎፋ፤ እያ ነ ናኣ ማችዉ።<verse eid="LEV 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 18:16"/>“ነ እሻ ማችዉ ፃላዳ ነ እሻ ካዉሾፋ።<verse eid="LEV 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 18:17"/>“አይዉነ እ ናእዉ ፃሎፋ፤ እ ናኤ ናእዉ ዎይኮ እ ናኣ ናእዉ ፃሎፋ። ኤንቲ እዉ ማታ ዳቦ ግድያ ግሾ፥ ሄስ ኢታ ቱና።<verse eid="LEV 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 18:18"/>“ነ ማችያ ፓፃ ደእሽን፥ ነ ማቸ ምችዉ ዳዉፋ።<verse eid="LEV 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19"/>“ኩሸ መቶራ ደእያ ማጫስ ፃሎፋ።<verse eid="LEV 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 18:20"/>“ኔኒ ቱኖና መላ ነ ሾሩዋ ማችዉ ፃሎፋ።<verse eid="LEV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 18:21"/>“ነ ፆሳ ሱንይ ጫየቶና መላ ነ ናይታፐ እሱዋ ታማን ፁጋዳ፥ ሞሎካ ግያ ኤቃስ ያርሾ ኦዳ እሞፋ። ታኒ ጎዳ።<verse eid="LEV 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 18:22"/>“ፆሳ ስንን እፀትዳባ ግድያ ግሾ ማጫሳራ ጋሄተይሳዳ አደራ ጋሄቶፋ።<verse eid="LEV 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 18:23"/>“ኔኒ ቱኖና መላ መሄራ ጋሄቶፋ፤ ማጫስ መሄራ ጋሄታናዉ መሄ ስን አፎ። ሄስ ዎጋን ባይናባ።<verse eid="LEV 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24"/>“ታኒ ህንተ ስንፈ የደያ ካዎተት ሄ ኦሶታን ቱንዳ ግሾ፥ ህንተ ሄ ኦሶታን ኤንታ መላ ቱኖፕተ። <verse eid="LEV 18:24"/><verse number="25" style="v" sid="LEV 18:25"/>ሀር አቶሽን፥ ቢታይካ ቱንዳ ግሾ፥ እያ ናጋራ ግሾ ታ እያ ሴራስ። ቢትያ ባናን ደኤይ አሳ ጩታሱ። <verse eid="LEV 18:25"/><verse number="26" style="v" sid="LEV 18:26"/>ሽን ህንተ ታ ህግያነ ታ ኪታ ናግተ። ህንተና ግድን ዎይኮ ህንተ ግዶን ደእያ አላጋ ቢታ አሳ ግድን ኦንካ ሄሳ መላ ቱና ኦሶ ኦፕተ።<verse eid="LEV 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 18:27"/>“ህንተፈ ካሰ ሀ ቢታን ደእዳ አሳይ ሄሳ መላ ቱናባ ኦዳ ግሾ፥ ቢትያ ቱናሱ። <verse eid="LEV 18:27"/><verse number="28" style="v" sid="LEV 18:28"/>ህንተ ሀ ቢታ ቱንስኮ፥ ህንተፈ ካሰ ደእዳ ካዎተታ ሀ ቢትያ ጩትዳይሳዳ ህንተናካ ጩቶና መላ ናገትተ። <verse eid="LEV 18:28"/><verse number="29" style="v" sid="LEV 18:29"/>ሄሳታ ዳንያ ቱና ኦሶታፐ እሱዋካ ኦያ አስ ደእኮ፥ ሄ ኡራይ ባ አሳ ግዶፈ ኩረቶ። <verse eid="LEV 18:29"/><verse number="30" style="v" sid="LEV 18:30"/>ሄሳ ግሾ፥ ህንተፈ ካሰ ደእዳ አሳት ኦዳ ቱና ኦሶታ ኡባ ኦድ ህንተ ቱኖና መላ ታ ኪታ ናግተ፤ ታኒ ጎዳ፥ ህንተ ፆሳ” ያግስ።<verse eid="LEV 18:30"/></para>
  <chapter eid="LEV 18"/>
  <chapter number="19" style="c" sid="LEV 19"/>
  <para style="s1">ዱማ ዱማ ህገታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ። <verse eid="LEV 19:1"/><verse number="2" style="v" sid="LEV 19:2"/>እስራኤለ አሳ ኡባስ ሀይሳዳ ያጋዳ ኦዳ፤ “ታኒ፥ ጎዳይ፥ ህንተ ፆሳይ፥ ጌሽ ግድያ ግሾ፥ ህንተካ ጌሽ ግድተ።<verse eid="LEV 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 19:3"/>“ህንተፈ እሶይ እሶይ ባ አዋነ ባ አይዉ ቦንቾ፤ ታ ሳምባታ ቦንችተ። ታኒ ጎዳ፥ ህንተ ፆሳ።<verse eid="LEV 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 19:4"/>“ታና አግድ ኤቃታ ጎይኖፍተ፤ ዎይኮ ብራታፐ ኦሰትዳ ፆሳታ ህንተዉ ኦፕተ። ታኒ ጎዳ፥ ህንተ ፆሳ።<verse eid="LEV 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5"/>“ህንተ እስፈተ ያርሾ ጎዳስ ያርሽያ ዎደ ሄ ያርሾይ ህንተ ግሾ ኤከታና መላ በሰይሳዳ ያርሽተ። <verse eid="LEV 19:5"/><verse number="6" style="v" sid="LEV 19:6"/>ሄ ያርሾይ ህንተ ያርሽዳ ጋላስ ዎይኮ ዎንተ ጋላስ ሜተቶ፤ ሄን ጋላስ ጋካናዉ አትዳይ ደእኮ ታማን ፁገቶ። <verse eid="LEV 19:6"/><verse number="7" style="v" sid="LEV 19:7"/>ሄን ጋላስ ሜተትኮ፥ ሄስ ቱንስያባ፤ ታኒ ሄሳ ኤክከ። <verse eid="LEV 19:7"/><verse number="8" style="v" sid="LEV 19:8"/>ሄሳ ምያ ኦንካ ጎዳስ ጌሽ ግድዳባ ቱንስዳ ግሾ ባ ናጋራን ኦይሸታና። ሄ ኡራይ ባ አሳ ግዶፈ ኩረቶ።<verse eid="LEV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9"/>“ህንተ ጋደን ካፅዳ ካ ህንተ ጫክያ ዎደ ጋድያ ጋፃ ጋካናዉ ደኤይሳ ጫኮፍተ፤ ጫክ ስምን ደእያ ፖሽልያ ቆሮፕተ። <verse eid="LEV 19:9"/><verse number="10" style="v" sid="LEV 19:10"/>ነ ዎይነ አይፍያ ማፅያ ዎደ ም ቦላ ቆሰትድ አትዳይሳ ዎይኮ ሳአን ዎዳ ዎይነ አይፍያ ማፆፓ። ሄሳ ማንቆታስነ በተ አሳስ አጋጋ። ታኒ ጎዳ፥ ህንተ ፆሳ።<verse eid="LEV 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11"/>“ካይሶቶፕተ።</para>
  <para style="p" vid="LEV 19:11">“ዎርዶቶፕተ።</para>
  <para style="p" vid="LEV 19:11">“እሶይ እሱዋ ጭሞፍተ።<verse eid="LEV 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 19:12"/>“ታ ሱንን ዎርዶ ጫቆፍተ፤ ህንተ ፆሳ ሱን ቱንሶፕተ። ታኒ ህንተ ጎዳ።<verse eid="LEV 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13"/>“ነ ሾሩዋ ቦላ ገነ ኦፋ፤ ዎይኮ እያ ቦንቆፋ።</para>
  <para style="p" vid="LEV 19:13">“ኡነ ኦያ ኡራ ዳሞዝያ ድጋዳ፥ እስ ቃማካ ነ ማታን አይሶፓ።<verse eid="LEV 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 19:14"/>“ቱልያ ጫዮፓ፤ ዎይኮ ቆቅያ ስንን በ ዎፋ፥ ሽን ኔኒ ፆሳስ ያያ። ታኒ ነ ጎዳ።<verse eid="LEV 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15"/>“ፕርዳ ጌላዮፕተ፤ ማንቁዋ እያ ማንቆተ ግሾ ማዳዳ ፕርዶፋ፤ ዱርያ እያ ዱረተ ግሾ ያያዳ አጎፋ። ሽን ነ ሾሩዋስ ሱረ ፕርዳ።<verse eid="LEV 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 19:16"/>“ነ አሳ ግዶን ኢታ ዝግርስ ኤካዳ ዩዮፓ።</para>
  <para style="p" vid="LEV 19:16">“ነ ሾሩዋ ሀይቆስ ጋያባ አይኮካ ኦፋ። ታኒ ነ ጎዳ።<verse eid="LEV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17"/>“ነ እሻ ነ ዎዛናን እፆፋ። ነ ሾሩዋ ጋሶን ነ ናጋራ ኦና መላ እያ ሀንቃ።<verse eid="LEV 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 19:18"/>“ሀሎ ከዮፓ፤ ነ አሳፐ እሱዋ ቦላካ ሽፎፓ። ሽን ነ ሾሩዋ ነ ሁጰዳ ዶሳ። ታኒ ነ ጎዳ።<verse eid="LEV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19"/>“ታ ኪታታ ናጋ።</para>
  <para style="p" vid="LEV 19:19">“እስ ቆሞ መሄ ሀራ ቆሞ መሄራ ብራይስሶፓ።</para>
  <para style="p" vid="LEV 19:19">“እስ ሾቃን ናምኡ ቆሞ ዘረ ዘሮፓ።</para>
  <para style="p" vid="LEV 19:19">“ናምኡ ቆሞፈ ኦሰትዳ ማኦ ማኦፋ።<verse eid="LEV 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20"/>“እስ አስ አዝናስ ኦይሸታዳ ደእሽን፥ ዎዞ ሚሸይ እመትድ ዉሮናሽን ዎይኮ ላአ ከዮናሽን፥ ሄ አይለራ አቅኮ ኤንቲ ሴረታናዉ በሴስ፥ ሽን ኤንቲ ሀይቃናዉ በሰና። <verse eid="LEV 19:20"/><verse number="21" style="v" sid="LEV 19:21"/>ግዶሽን፥ ሄ ኡራይ ባ ናቆ ያርሾስ ግድያ ማራዘ ጌሻ ዱንካንያ ፐንገን ጎዳ ስን ኤሆ። <verse eid="LEV 19:21"/><verse number="22" style="v" sid="LEV 19:22"/>ካህነይ ሄ ናቆ ያርሾ ማራዝያ ኤክድ፥ ኡራ ናጋራ አቶተስ ጎዳ ስንን ያርሼስ፤ እያ ናጋራይ አቶ ጌተታና።<verse eid="LEV 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23"/>“ህንተ ካናነ ቢታ ገልያ ዎደ አይፈ እምያ አይ ቆሞ ም ቶክኮካ፥ ሄ ም አይፈይ ሜተቶና መላ ድገትዳይሳ አኬክተ። ሄ ላይ ዉራና ጋካናዉ ሄ ም አይፈይ ሜተቶፎ። <verse eid="LEV 19:23"/><verse number="24" style="v" sid="LEV 19:24"/>ኦይዳን ላይን ሄ ም አይፈይ ጎዳስ ጋላታስ ሺቅያ ጌሻ ያርሾ ግዳና። <verse eid="LEV 19:24"/><verse number="25" style="v" sid="LEV 19:25"/>እቻሻን ላይን ሄ ም አይፍያ ሚተ። ህንተ ሄሳዳ ኦኮ፥ ህንተ ም አይፈይ ዳራና። ታኒ ጎዳ፥ ህንተ ፆሳ።<verse eid="LEV 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26"/>“ሱ እያ ግዶን ደእያ አሾ ሞፕተ። ማሮቶፕተ ዎይኮ ብቶፕተ።<verse eid="LEV 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 19:27"/>“ህንተ ሁጰ ብናና ጋርሳራ ዩሽ አድ ጪሮፕተ፤ ህንተ ቡቻ ዩሽ አድ ሜዶፕተ።<verse eid="LEV 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 19:28"/>“ሀይቅዳ አሳ ግሾ ህንተ አሳተ ጋሮፕተ፤ ዎይኮ ጫቻ ቤታ ህንተ አሳተ ቦላ መፍተ። ታኒ ነ ጎዳ።<verse eid="LEV 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29"/>“ቢትያ ላይማተንነ ቱናተን ኩሞና መላ ነ ማጫ ናእዉ ላይማተስ አ እማዳ ቱንሶፓ።<verse eid="LEV 19:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 19:30"/>“ታ ሳምባታ ቦንችተ፤ ታ ጎይነትያ በሳ ቦንችተ። ታኒ ጎዳ።<verse eid="LEV 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31"/>“ሞይትለ ኦድስያ አሳኮ ዎይኮ ማሮታኮ ቦፕተ፤ ህንተ ቱኖና መላ ኤንታ ኮዮፕተ። ታኒ ጎዳ፥ ህንተ ፆሳ።<verse eid="LEV 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32"/>“ዶን አስነ ጭማ አስ በእያ ዎደ ኡትዳ በሳፈ ደንዳ ኤቃዳ ኤንታ ቦንቻ፤ ነ ፆሳስ ያያ። ታኒ ጎዳ።<verse eid="LEV 19:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33"/>“ህንተ ቢታን ደእያ በተ አሰ ሱጎፕተ። <verse eid="LEV 19:33"/><verse number="34" style="v" sid="LEV 19:34"/>ህንተ ቢታን ደእያ በተ አስ ህንተ ጋደ አሳዳ ፄልተ፤ እያ ህንተ ሁጰዳ ዶስተ። ህንተ ካሰ ግብፀ ቢታን በተ አስ ግድድ ደእደታ። ታኒ ጎዳ፥ ህንተ ፆሳ።<verse eid="LEV 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35"/>“ህንተ ዋያባን፥ ማክያባንነ ምዛነን ዎርዶቶፕተ። <verse eid="LEV 19:35"/><verse number="36" style="v" sid="LEV 19:36"/>ህንተ ምዛነይ፥ ህንተ ማክያባይነ ዋያባይ እስኖ ግዶ። ታኒ ህንተና ግብፀ ቢታፈ ከሳዳ ኤህዳ ጎዳ ህንተ ፆሳ።<verse eid="LEV 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 19:37"/>“ህንተ ታ ህግያነ ታ ኪታ ኡባ ናግተነ ኦተ። ታኒ ጎዳ።”<verse eid="LEV 19:37"/></para>
  <chapter eid="LEV 19"/>
  <chapter number="20" style="c" sid="LEV 20"/>
  <para style="s1">ኪተተ እፆይ ኤህያ ሴራ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ። <verse eid="LEV 20:1"/><verse number="2" style="v" sid="LEV 20:2"/>እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ “እስራኤለ አሳፐ ግድን፥ ዎይኮ ህንተ ግዶን ደእያ አላጋ አሳፐ ግድን፥ ኦንካ ባ ናአ ሞሎካ ጌተትያ ኤቃስ አድ እምኮ፥ እ ሀይቆ፤ እስራኤለ አሳይ እያ ሹቻን ጫድድ ዎ። <verse eid="LEV 20:2"/><verse number="3" style="v" sid="LEV 20:3"/>ባ ናኣ ሞሎካ ጌተትያ ኤቃስ እምድ ታ ዱንካንያ ቱንሰይነ ታ ጌሻ ሱን ካዉሸይ ታ ስንን እፀትዳባ ግዳና። ታ አሳ ግዶፈ ሻካዳ ታኒ እያ ይሳና። <verse eid="LEV 20:3"/><verse number="4" style="v" sid="LEV 20:4"/>ሽን ሄ ኡራ እስራኤለ አሳይ በእሸ ቀል ግድ አኮነ ዎና እፅኮ፥ <verse eid="LEV 20:4"/><verse number="5" style="v" sid="LEV 20:5"/>ታኒ ሄ አድያነ እያ ሶ አሳ ሞርካና፤ እያነ ሞሎካ ካልዳይሳታ ኤንታ ደርያ ግዶፈ ሻካዳ ይሳና።<verse eid="LEV 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6"/>“ኦንካ ታና አማነቶና እፅድ ሞይትለ ፄግኮነ ማሮ ሶ ቢኮ፥ ታኒ እያዉ ሞርከ ግዳና፤ አሳ ግዶፈ እያ ይሳና።<verse eid="LEV 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 20:7"/>“ታኒ፥ ጎዳይ፥ ህንተ ፆሳ ግድያ ግሾ፥ ህንተ ህንተና ዱማይተ፤ ጌሽ ግድተ። <verse eid="LEV 20:7"/><verse number="8" style="v" sid="LEV 20:8"/>ታ ዎጋ ናግተ፤ እያ ፖልተ። ታኒ ህንተና ጌሽያ፥ ህንተ ጎዳ።<verse eid="LEV 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 20:9"/>“ኦንካ ባ አዋ ዎይኮ ባ አይዉ ጫይኮ ሀይቆ። እ ባ አዋ ዎይኮ ባ አይዉ ጫይዳ ግሾ፥ እያ ሱ አጮይ እያ ቦላ ግዶ።<verse eid="LEV 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10"/>“እስ አስ ባ ሾሩዋ ማችዉ ፃልኮ፥ ኤንቲ ናምአይ ሀይቆ። <verse eid="LEV 20:10"/><verse number="11" style="v" sid="LEV 20:11"/>እስ አስ ባ አዋ ማችዉ ፃልኮ፥ እ ባ አዋ ካዉሽስ፤ ኤንቲ ናምአይ ሀይቆ። ኤንታ ሱ አጮይ ኤንታ ቦላ ግዶ። <verse eid="LEV 20:11"/><verse number="12" style="v" sid="LEV 20:12"/>እስ አስ ባ ናኣ ማችዉ ፃልኮ፥ ኤንቲ ናምአይ ሀይቆ። ኤንቲ ቱናባ ኦዶሶና፤ ኤንታ ሱ አጮይ ኤንታ ቦላ ግዶ።<verse eid="LEV 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 20:13"/>“እስ አደይ ማጫሳራ ጋሄተይሳዳ አደራ ጋሄትኮ፥ ኤንቲ ናምአይ እፀትዳባ ኦዳ ግሾ ሀይቆ። ኤንታ ሱ አጮይ ኤንታ ቦላ ግዶ። <verse eid="LEV 20:13"/><verse number="14" style="v" sid="LEV 20:14"/>እስ አስ ናእዉነ አይዉ ማቾ ኤክኮ፥ ሄስ ቱናባ። ህንተ ግዶን ቱናተ ዶና መላ እነ ኤንቲ ታማን ፁገቶ።<verse eid="LEV 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 20:15"/>“እስ አስ መሄራ ጋሄትኮ፥ እ ሀይቆ፤ ሄ ሚዝዉ ዎተ። <verse eid="LEV 20:15"/><verse number="16" style="v" sid="LEV 20:16"/>እስ ማጫስ መሄራ ጋሄትኮ ሄ ማጫስያነ ሄ መሄይ ናምአይ ሀይቆ፤ ኤንታ ሱ አጮይ ኤንታ ቦላ ግዶ።<verse eid="LEV 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17"/>“እስ አስ ባ አዋ ናእዉ ዎይኮ ባ አየ ናእዉ ማቾ ኤክኮ፥ ሄስ ቱናባ። ኤንቲ ባንታ አሳ ግዶፈ ሻከትድ ሀይቆ። እ ባ ምችዉ ካዉሽዳ ግሾ፥ ባ ናጋራን ባዉ ኦይሸቶ። <verse eid="LEV 20:17"/><verse number="18" style="v" sid="LEV 20:18"/>እስ አስ ኩሸ መቶራ ደእያ ማጫሳራ አቅኮ፥ እ ቀ ቃርዳ ግሾ፥ ኤንቲ ናምአይ ባንታ አሳ ግዶፈ ኩረቶ።<verse eid="LEV 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 20:19"/>“ነ አየ ምችዉ ዎይኮ ነ አዋ ምችዉ ፃሎፋ፤ ሄሳ ኦይ ባ ማታ ዳቦተ ካዉሼስ። ኤንቲ ናምአይ ባንታ ናጋራን ኦይሸቶ። <verse eid="LEV 20:19"/><verse number="20" style="v" sid="LEV 20:20"/>እስ አስ ባ አዋ እሻ ማችዉ ፃልኮ፥ እ ባ አዋ እሻ ካዉሽስ። ኤንቲ ባንታ ናጋራን ባንታዉ ኦይሸቶ፤ ኤንቲ ናምአይ ናአ የሎና ሀይቃና። <verse eid="LEV 20:20"/><verse number="21" style="v" sid="LEV 20:21"/>እስ አስ ባ እሻ ማችዉ ኤክኮ፥ ሄስ ቱና። እ ባ እሻ ካዉሽስ፤ ኤንቲ ናምአይ የሎ ያና።<verse eid="LEV 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22"/>“ህንተ ዳና መላ ታ ህንተና ገልስያ ቢታይ ህንተና ጩቶና መላ ህንተ ታ ህግያነ ታ ኪታ ናግተ። <verse eid="LEV 20:22"/><verse number="23" style="v" sid="LEV 20:23"/>ታኒ ህንተ ስንፈ ይስያ አሳ ደኡዋ ዎጋ ካሎፍተ። ኤንቲ ሄሳ ኡባ ኦዳ ግሾ፥ ታ ኤንታ እፃስ። <verse eid="LEV 20:23"/><verse number="24" style="v" sid="LEV 20:24"/>ህንተ ኤንታ ቢታ ላታና፤ ማነ ኤስ ጎገይ ቢታ ህንተዉ እማና። ታኒ ህንተና ሀራ አሳፐ ዱማያዳ ከስዳ፥ ጎዳ ህንተ ፆሳ።<verse eid="LEV 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 20:25"/>“ሄሳ ግሾ፥ ህንተ ቱናነ ቱና ግዶና መሄታነ ካፎታ ሻክድ ኤርተ። ታኒ ሄሳት ህንተዉ ቱና ጋዳ ዎዳ መሄታ፥ ካፎታነ ቢታን ቃፅያባታ ኡባን ህንተና ቱንሶፕተ። <verse eid="LEV 20:25"/><verse number="26" style="v" sid="LEV 20:26"/>ታኒ ጎዳይ ጌሽ ግድያ ግሾነ ህንተ ታባ ግዳና መላ ህንተና ሀራ አሳፐ ዱማይዳ ግሾ፥ ህንተካ ታዉ ጌሽ ግድተ።<verse eid="LEV 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27"/>“አደይ ዎይኮ ማጭ ሞይትለራ ሃሳይኮ ዎይኮ ማሮትኮ፥ ኤንቲ ሀይቃናዉ በሴስ። ኤንቲ ሹቻን ጫደትድ ሀይቆ፤ ኤንታ ሱ አጮይ ኤንታ ቦላ ግዶ።”<verse eid="LEV 20:27"/></para>
  <chapter eid="LEV 20"/>
  <chapter number="21" style="c" sid="LEV 21"/>
  <para style="s1">ካህነታስ እመትዳ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1"/>ጎዳይ ሙሰኮ፥ “ካህነ ግድዳ አሮና አደ ናይታስ ሀይሳዳ ያጋዳ ኦዳ። ህንተፈ ኦንካ <verse eid="LEV 21:1"/><verse number="2" style="v" sid="LEV 21:2"/>ባ ማታ ዳቦ፥ ባ አየ፥ ባ አዋ፥ ባ አደ ናኣ፥ ባ ማጫ ናኤ፥ ባ እሻ፥ <verse eid="LEV 21:2"/><verse number="3" style="v" sid="LEV 21:3"/>ዎይኮ አዝና ገሎና፥ እያ ሶን ደእያ ባ ምቸ አሀ ግዶና እፅኮ፥ ሀይቅዳ አሳ አሀ ቦችድ ባና ቱንሶፖ። <verse eid="LEV 21:3"/><verse number="4" style="v" sid="LEV 21:4"/>ኤኮንነ ገሎን ዳቦትዳ አሳ አሀ ቦችድ ባና ቱንሶፖ።<verse eid="LEV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 21:5"/>“ካህነት ካዮስ ባንታ ሁጵያነ ባንታ ቡቻ ሜዶፖ፤ ዎይኮ ባንታ አሳተ ጋሮፖ። <verse eid="LEV 21:5"/><verse number="6" style="v" sid="LEV 21:6"/>ኤንቲ ጎዳስ ፁሳ ያርሾነ ካ ያርሾ ሺሽያ ካህነታ ግድያ ግሾ ባንታ ፆሳስ ጌሽ ግዶ፤ ባንታ ፆሳ ሱን ቱንሶፖ። ሄሳ ግሾ፥ ኤንቲ ጌሽ ግዳናዉ በሴስ።<verse eid="LEV 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 21:7"/>“ካህነት ባንታ ፆሳስ ጌሽ ግድያ ግሾ፥ ካህነት ላይማ ማጫስ፥ ጌላኦ ግዶና ማጫስ ዎይኮ አዝን የድዳ ማጫስ ኤኮፎ። <verse eid="LEV 21:7"/><verse number="8" style="v" sid="LEV 21:8"/>ካህነት ህንተ ፆሳስ ካ ያርሾ ያርሸይሳታ ግድያ ግሾ፥ ህንተ ኤንታ ጌሽ ኦድ ኤክተ። ህንተና ጌሽያ ጎዳይ፥ ታኒ፥ ጌሽ ግድያ ግሾ፥ ኤንቲ ጌሽ ግዶ። <verse eid="LEV 21:8"/><verse number="9" style="v" sid="LEV 21:9"/>ካህንያ ናእያ ላይማታዳ ባና ቱንስኮ፥ እያ ባ አዋ ካዉሻሱ፤ እያ ታማን ፁገታዳ ሀይቆ።<verse eid="LEV 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10"/>“ካህነ ሀላቃይ፥ እያ ሁጰን ትዮ ዛይተይ ጉክዳይስነ ካህነተ ማኡዋ ማአናዉ ዱማትዳይስ፥ ባ ሁጵያፐ ፃ ቃጭያ ደንፎ፤ ባ ማኡዋ ዳኮፎ። <verse eid="LEV 21:10"/><verse number="11" style="v" sid="LEV 21:11"/>አህ ደእያ ሶ ገሎፖ፤ ሀር አቶሽን ባ አዋ ዎይኮ ባ አየ አሀ ግድኮካ፥ ሄሳ ቦችድ ባና ቱንሶፖ። <verse eid="LEV 21:11"/><verse number="12" style="v" sid="LEV 21:12"/>እያ ዱማያናዉ ትይዳ ፆሳ ዛይተይ እያ ቦላ ደእያ ግሾ፥ ካህነይ ጌሻ ዱንካንያፐ ከዮፖ፤ ጌሻ ዱንካንያ ቱንሶፖ። ታኒ ጎዳ።<verse eid="LEV 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 21:13"/>“እ ኤክያ ማችያ ጌላኦ ግዶ። <verse eid="LEV 21:13"/><verse number="14" style="v" sid="LEV 21:14"/>አዝን ሀይቅዳ ማጫስ ዎይኮ አዝን የድዳ ማጫስ ዎይኮ ላይማ ማጫስ ማቾ ኤኮፎ። ሽን ባ አሳ ግዶፈ ጌላኦ ማጫ ናአ ዶርድ ማቾ ኤኮ። <verse eid="LEV 21:14"/><verse number="15" style="v" sid="LEV 21:15"/>ሄስ ሀኖና እፅኮ፥ ባ አሳ ግዶን ባ ናይታ ቱና ኦስ። ታኒ እያ ጌሸይሳ፥ እያ ጎዳ።”<verse eid="LEV 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ። <verse eid="LEV 21:16"/><verse number="17" style="v" sid="LEV 21:17"/>“ኔኒ አሮናስ ሀይሳዳ ያጋዳ ኦዳ፤ ነ ኮቻፈ አሳተን ቦረይ ደእያ ኦንካ ካ ያርሾ ታዉ ያርሻናዉ በሰና። <verse eid="LEV 21:17"/><verse number="18" style="v" sid="LEV 21:18"/>አሳተን ቦረይ ደእያ አስ፥ ሄስካ ቆቀ ዎይኮ ዎበ ዎይኮ ሶምኦይ ኢትዳ አስ ዎይኮ ላቆይ ደእያ አስ፥ <verse eid="LEV 21:18"/><verse number="19" style="v" sid="LEV 21:19"/>ዎይኮ ቶሆይ ዎይኮ ኩሸይ ስልዳ አስ፥ <verse eid="LEV 21:19"/><verse number="20" style="v" sid="LEV 21:20"/>ዎይኮ ኩና አስ ዎይኮ ዳሮ ቃን አስ ዎይኮ አይፈ ሙልጫ አስ ዎይኮ ፑሶይ ኦይክዳ አስ ዎይኮ እራለይ ደእያ አስ ዎይኮ ሹፋ አስ ታዉ ካ ያርሾ ያርሻናዉ በሰና። <verse eid="LEV 21:20"/><verse number="21" style="v" sid="LEV 21:21"/>ካህንያ አሮና ኮቻፈ አሳተን ቦረይ ደእያ አስ ኦንካ ጎዳስ ፁሳ ያርሾነ ካ ያርሾ ሺሻናዉ ያርሾ በሳ ያናዉ በሰና። <verse eid="LEV 21:21"/><verse number="22" style="v" sid="LEV 21:22"/>እ ጌሻ ካነ ኡባፈ ጌሽ ግድዳ ባ ፆሳ ካ ማናዉ ዳንዳኤስ። <verse eid="LEV 21:22"/><verse number="23" style="v" sid="LEV 21:23"/>ሽን እያ አሳተን ቦረይ ደእያ አስ ግድያ ግሾ፥ እ ታ ዱንካንያ ቱንሶና መላ ማጋራጁዋኮ ዎይኮ ያርሾ በሳኮ ሺቆፖ። ኤንታና ጌሽያ ጎዳይ ታና።”<verse eid="LEV 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 21:24"/>ሙሰይ ሄሳ ኡባ አሮናስ፥ እያ አደ ናይታስነ እስራኤለ አሳ ኡባስ ኦድስ።<verse eid="LEV 21:24"/></para>
  <chapter eid="LEV 21"/>
  <chapter number="22" style="c" sid="LEV 22"/>
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 22:1"/><verse number="2" style="v" sid="LEV 22:2"/>ታ ጌሻ ሱን ኤንቲ ቱንሶና መላ፥ እስራኤለ አሳይ ታዉ ዱማይዳ እሞታታ አሮንነ እያ አደ ናይት ቦንቾን ኤክድ፥ ጌሻተን ናጋና መላ ኤንታዉ ኦዳ። ታኒ ጎዳ።<verse eid="LEV 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 22:3"/>ኤንታኮ ሀይሳዳ ያጋ፤ “ያና የለተ ኡባን ህንተ ኮቻፈ ኦንካ ቱንድ ደእሸ፥ እስራኤለ አሳይ ጎዳስ ዱማይዳ ጌሻ ያርሹዋኮ ሺቅኮ፥ ሄ ኡራይ ታ ስንን በንቶፎ። ታኒ ጎዳ።<verse eid="LEV 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 22:4"/>“አሮና ኮቻፈ ጎጋ ሀርገይ ደእያ፥ ዎይኮ አሳተፈ ጎግያባይ ደእያ ኦንካ ጌያና ጋካናዉ ጌሻ ያርሹዋ ሞፖ። አሀ ቦችድ ቱንዳባ ዎይኮ እያ አቱንይ ጉክዳ ኡራ ቦችያ ኦንካ ቱና። <verse eid="LEV 22:4"/><verse number="5" style="v" sid="LEV 22:5"/>ቃስ ሳአራ ጎሸትያ ቱንስያባታ፥ ዎይኮ አይብባንካ ቱና ግድዳባ ቦችያ ኦንካ፥ <verse eid="LEV 22:5"/><verse number="6" style="v" sid="LEV 22:6"/>ዎይኮ ሄሳ መላባ ቦችያ ኦንካ፥ ኦማርስ ጋካናዉ ቱና ግዴስ። እ ባ አሳተ ሃን ሜጨቶና ደእሸ፥ ጌሻ ያርሹዋፈ ማናዉ ኮሸና። <verse eid="LEV 22:6"/><verse number="7" style="v" sid="LEV 22:7"/>አው ዉልያ ዎደ እ ጌሽ ግዴስ። ሄሳፈ ጉየ፥ ሄ ጌሻ ያርሹዋፈ ባና ጋክያ ግሹዋ ሞ። <verse eid="LEV 22:7"/><verse number="8" style="v" sid="LEV 22:8"/>ሀይቅዳባ ዎይኮ ዶእ ዎዳ መሄ አሾ ሞፖ፤ ሄስ ቱንስያባ። ታኒ ጎዳ።<verse eid="LEV 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 22:9"/>“ካህነት ታ ዎጋ ናጎ፤ ኤንቲ እያ ናጎና እፅድ ባንታ ባላን ሀይቃና። ኤንታ ጌሽያ ጎዳይ ታና።<verse eid="LEV 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10"/>“ሄ ጌሻ ያርሹዋ ካህንያ ሶ አሳፐ አትሽን፥ ሀራ አስ ሞፖ። ካህንያ ሶ ይዳ እማ ግድን፥ ቃፃረትድ ኦያ አሰ ግድን ሞፖ። <verse eid="LEV 22:10"/><verse number="11" style="v" sid="LEV 22:11"/>ሽን ካህነይ ባ ብራን ሻምዳ አይለይ ዎይኮ እያ ሶን የለትዳ አይለይ ሄ ካ ሞ። <verse eid="LEV 22:11"/><verse number="12" style="v" sid="LEV 22:12"/>ካህነ ግዶና አስ ገልዳ ካህንያ ናእያ ሄ ጌሻ ያርሹዋፈ ሞፖ። <verse eid="LEV 22:12"/><verse number="13" style="v" sid="LEV 22:13"/>ሽን እ አዝናይ ሀይቅኮ ዎይኮ እዮ የድኮ ቃስ እዉ ናእ ባይና እፅኮ፥ እያ ካሰ ባ ጌላኦተን ደእዳይሳዳ ስማዳ ባ አዋ ሶን ደእኮ፥ እያ ባ አዋ ጋከይሳፈ ሞ። ሽን ሀራ አስ ኦንካ ሄሳፈ ሞፖ።<verse eid="LEV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 22:14"/>“እስ አስ ኤሮና ደእሸ ጌሻ ያርሹዋፈ ሚኮ፥ ሄ እ ምዳ ካ ጋትያ ቦላ ፄታፐ ላታሙ ኩሸ ጉጅድ ካህንያስ እሞ። <verse eid="LEV 22:14"/><verse number="15" style="v" sid="LEV 22:15"/>እስራኤለ አሳይ ጎዳስ ያርሽያ ጌሻ ያርሹዋ ካህነት ቱንሶፖ። <verse eid="LEV 22:15"/><verse number="16" style="v" sid="LEV 22:16"/>ኤንቲ ባንታ ኤህዳ ጌሻ ያርሹዋ ባንታዉ ምድ ናጋራን ኦይሸታና መላ ኦፎ። ኤንታ ጌሽያ ጎዳይ ታና።”<verse eid="LEV 22:16"/></para>
  <para style="s1">ኤከቶና ያርሾታ</para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 22:17"/><verse number="18" style="v" sid="LEV 22:18"/>“አሮናስ፥ እያ አደ ናይታስነ እስራኤለ አሳ ኡባስ ሀይሳዳ ያጋዳ ኦዳ፤ እስራኤለ አስ ግድን ዎይኮ ኤንታ ግዶን ደእያ በተ አስ ግድን፥ ኦንካ ጎዳስ ፁሳ ያርሾ ባ ዶሳን እመይ ዎይኮ ባ ቃንገ ጋይ፥ <verse eid="LEV 22:18"/><verse number="19" style="v" sid="LEV 22:19"/>ሄ ያርሾይ ኤከታና መላ ቦረይ ባይና ዎፋኖ፥ ዎይኮ ማራዘ ዎይኮ ኮለ ኤሆ። <verse eid="LEV 22:19"/><verse number="20" style="v" sid="LEV 22:20"/>ቦረይ ደእያ አይ መሄይካ ኤከቶና ግሾ ሄሳ ሺሾፕተ።<verse eid="LEV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 22:21"/>“እስ አስ ባ ቃንገ ጋናዉ እስፈተ ያርሾ ጎዳስ ያርሽያ ዎደ ዎይኮ ባ መህያፐ ዶሳን እሞታ ጎዳስ ሺሽያ ዎደ ሄስ ኤከታና መላ ሄ መሄይ ቦረይ ባይናባ ግዶ። <verse eid="LEV 22:21"/><verse number="22" style="v" sid="LEV 22:22"/>ህንተ መህያፐ ቆቀ ዎይኮ መቆ ዎይኮ ዎበ ዎይኮ ግይያ ማዱን ዎይኮ ፑሶይ ዎይኮ ሻቶይ ደእያባ ጎዳስ ያርሾፍተ። ታማን ፁሳ ያርሾ ኦድ ያርሾ በሳን ጎዳስ ሺሾፕተ። <verse eid="LEV 22:22"/><verse number="23" style="v" sid="LEV 22:23"/>እያ ቦላ ላቆይ መት ዎይኮ ቦላ ፓጭ ደእያ ኮርማ ዎይኮ ዶርሰ እስ አስ ባ ዶሳን እምያ ያርሾ ሺሻናዉ ዳንዳኤስ፤ ሽን ቃንገ ጋሶስ ግድኮ ሄስ ኤከተና። <verse eid="LEV 22:23"/><verse number="24" style="v" sid="LEV 22:24"/>ሳንጋ ዎይኮ ማዱንፅዳባ ጎዳስ ያርሾፍተ። ህንተ ቢታን ሄሳ መላባ ኦፕተ። <verse eid="LEV 22:24"/><verse number="25" style="v" sid="LEV 22:25"/>ህንተ ግዶን ደእያ አላጋ አሳታፐ ኤክዳ ሄሳ መላ መህያ ህንተ ፆሳስ ካ ያርሾ ኦድ ሺሾፕተ። ኤንታ ቦላ ቦረይ ደእያ ግሾ ህንተ ግሾ ኤከቶኮና።”<verse eid="LEV 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 22:26"/><verse number="27" style="v" sid="LEV 22:27"/>“ቦራ ናእ ዎይኮ ማራዘይ ዎይኮ ኮለይ የለትያ ዎደ ላፑን ጋላስ ባ አየራ ጋምኦ። ሆስፑን ጋላሳፐ ዶምድ፥ ጎዳስ ፁሳ ያርሾ ኦድ ሺሻናዉ ዳንዳኤቴስ። <verse eid="LEV 22:27"/><verse number="28" style="v" sid="LEV 22:28"/>ሚዝ ዎይኮ ዶርሰ እ ማራራ እስ ጋላስ ሹኮፍተ።<verse eid="LEV 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 22:29"/>“ህንተ ጋላታ ያርሾ ጎዳስ ሺሽያ ዎደ ህንተ ያርሾይ ኤከታና መላ ያርሽተ። <verse eid="LEV 22:29"/><verse number="30" style="v" sid="LEV 22:30"/>ያርሾይ ያርሸትዳ ጋላስ ሜተትድ ዉራናዉ ኮሼስ፤ እያፐ ዎንቶስ አሾፍተ። ታኒ ጎዳ።<verse eid="LEV 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31"/>“ታ ኪታ ናግተነ ፖልተ። ታኒ ጎዳ። <verse eid="LEV 22:31"/><verse number="32" style="v" sid="LEV 22:32"/>ታ ጌሻ ሱን ቱንሶፕተ። ታ ጌሽ ግደይስ እስራኤለ አሳ ግዶን ኤረታናዉ በሴስ። ህንተና ጌሽያ ጎዳይ ታና። <verse eid="LEV 22:32"/><verse number="33" style="v" sid="LEV 22:33"/>ህንተ ፆሰ ግዳናዉ ህንተና ግብፀ ቢታፈ ከስዳይ ታና። ታኒ ጎዳ።”<verse eid="LEV 22:33"/></para>
  <chapter eid="LEV 22"/>
  <chapter number="23" style="c" sid="LEV 23"/>
  <para style="s1">ኤረትዳ ባኣለ ጋላሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 23:1"/><verse number="2" style="v" sid="LEV 23:2"/>እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ ጌሻ ሺቆ ያግድ አዋጅሸ፥ ህንተ ቦንቻናዉ በሲያ ኤረትዳ ጎዳ ባለት ሀይሳታ።<verse eid="LEV 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 23:3"/>ህንተ ኡሱፑን ጋላስ ኦሶ ኦታ፥ ሽን ላፑን ጋላሳይ ህንተ ሸምፕያ ሳምባታ ጋላስ። ሄ ጋላስ ጌሻ ሺቆ ሺቅተ፤ አይ ኦሶካ ኦፕተ፤ ህንተ ደእያ በሳ ኡባን ሄስ ጎዳስ ሳምባታ።<verse eid="LEV 23:3"/></para>
  <para style="s1">ፓስካ ባዓለነ ኡይ ባኣለ</para>
  <para style="r">(<ref loc="NUM 28:16-25">ታይቦ 28:16-25</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4"/>ኤንታ ዎደን ዎደን ጌሻ ሺቆ ኦድ ህንተ ቦንቻናዉ በሲያ ኤረትዳ ጎዳ ባለት ሀይሳታ፤ <verse eid="LEV 23:4"/><verse number="5" style="v" sid="LEV 23:5"/>ኮይሮ አጌናን ታማነ ኦይዳን ጋላስ ሳእ ኦማርስያ ዎደ ጎዳ ፓስካይ ዶሜስ።<verse eid="LEV 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 23:6"/>ሄ አጌናን ታማነ እቻሻን ጋላሳን ጎዳስ ኡይ ባኣለ ጋላሳይ ዶሜስ። ሄሳ ግሾ ላፑን ጋላሳታን እርሾይ ገልቦና ኡይ ሚተ። <verse eid="LEV 23:6"/><verse number="7" style="v" sid="LEV 23:7"/>ሄ ጋላሳታፐ ኮይሮ ጋላስ ጌሻ ሺቆ ሺቅተ፤ ኦሶ ኦፕተ። <verse eid="LEV 23:7"/><verse number="8" style="v" sid="LEV 23:8"/>ላፑን ጋላስ ኡባ ጎዳስ ፁሳ ያርሾ ያርሽተ፤ ላፑን ጋላሳን ጌሻ ሺቆ ሺቅተ፤ ኦሶ ኦፕተ።<verse eid="LEV 23:8"/></para>
  <para style="s1">ባይራ ካ</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 23:9"/><verse number="10" style="v" sid="LEV 23:10"/>እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ ታኒ ህንተዉ እምያ ቢታ ገልድ ህንተ ካ ጫክያ ዎደ፥ ሄ ካ ኮይሮ ምርቅያ ካህንያስ ኤህተ። <verse eid="LEV 23:10"/><verse number="11" style="v" sid="LEV 23:11"/>ጎዳይ ህንተባ ኤካና መላ ሳምባታ ካልያ ዎንተ ጋላስ ካህነይ ሄ ምርቅያ ጎዳ ስንን ቁ ኦድ ዩሾ። <verse eid="LEV 23:11"/><verse number="12" style="v" sid="LEV 23:12"/>ህንተ ምርቅያ ዩሽዳ ሄ ጋላስ ቦረይ ባይና እስ ላይ ማራዘ ፁሳ ያርሾ ኦድ ጎዳስ ሺሽተ። <verse eid="LEV 23:12"/><verse number="13" style="v" sid="LEV 23:13"/>ሄ ያርሹዋራ እስፈ ሻማሆ ዛይተራ ሙኑቀትዳ ናምኡ ክሎ ግራመ ሎኦ ለ ካ ያርሾ ኦድ ሺሽተ። ሄስ ጎዳስ ሳዎ ቶንኩ ግያ ፁሳ ያርሾ ግዳና፤ እያራ እስፈ እስ ልትሮ ግድያ ዎይነ ኡሽ ሺሽተ። <verse eid="LEV 23:13"/><verse number="14" style="v" sid="LEV 23:14"/>ሀ ያርሹዋ ህንተ፥ ህንተ ፆሳስ ሺሽያ ጋላሳይ ጋካናዉ፥ ዋቻ ካፈ ቃየ ዎይኮ ጫጫ ዎይኮ ኡክድ ሞፕተ። ሄስ ህንተ ደእያ በሳ ኡባን ያና የለተስ መርና ዎጋ ግዶ።<verse eid="LEV 23:14"/></para>
  <para style="s1">ካ ሺሾ ባኣለ</para>
  <para style="r">(<ref loc="NUM 28:26-31">ታይቦ 28:26-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15"/>ህንተ ዩሾ ያርሾ ምርቅያ ኤህዳ ሳምባታ ዎንተ ጋላሳፐ ዶምድ፥ ላፑን ሳምንታ ታይብተ። <verse eid="LEV 23:15"/><verse number="16" style="v" sid="LEV 23:16"/>ላፑን ሳምባታ ካልያ ዎንተ ጋላሳይ ጋካናዉ እሻታሙ ጋላስ ታይብተ፤ ዋቻ ካፈ ያርሾ ጎዳስ ሺሽተ። <verse eid="LEV 23:16"/><verse number="17" style="v" sid="LEV 23:17"/>ህንተ ደእያ በሳፈ ናምኡ ክሎ ግራመ ግድያ ሎኦ ልያን እርሾ የግድ ኡክዳ ናምኡ ኡይ ዩሾ ያርሾስ ኤክድ ዪተ። ሄስ ዋቻ ካፈ ጎዳስ ሺቅያ ያርሾ ግዴስ። <verse eid="LEV 23:17"/><verse number="18" style="v" sid="LEV 23:18"/>ሄ ኡይራ እስፈ ቦረይ ባይና እስ ላይ ግድዳ ላፑን ዶርሳ ኡርገታ፥ እስ ዎፋኖነ ናምኡ ማራዘታ ሺሽተ። ኤንታ ካ ያርሾራነ ኡሻ ያርሾራ እስፈ ጎዳስ ፁገትያ ሳዎ ቶንኩ ግያ ያርሾ ኦድ ያርሽተ። <verse eid="LEV 23:18"/><verse number="19" style="v" sid="LEV 23:19"/>ቃስ እስ ኮለ ናጋራ ያርሾስ፥ እስ ላይ ግድዳ ናምኡ ዶርሳ ኡርገታ እስፈተ ያርሾስ ሺሽተ።<verse eid="LEV 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 23:20"/>ካህነይ ባይራ ካ፥ ኡይነ ናምኡ ዶርሳ ኡርገታ ዩሾ ያርሾ ኦድ፥ ጎዳ ስንን ቁ ኦድ ዩሾ። ሄሳት ጎዳስ ጌሽ፤ ካህነታስ ቃስ ግሾ። <verse eid="LEV 23:20"/><verse number="21" style="v" sid="LEV 23:21"/>ሄ ጋላስ ህንተዉ ጌሻ ሺቆ ግዳና መላ አዋጅተ፤ ኦሶ ኦፕተ። ሀይስ ህንተ ደእያ በሳ ኡባን ያና የለተስ መርና ዎጋ ግዶ።<verse eid="LEV 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 23:22"/>ህንተ ቢታን ካፅዳ ካ ጫክያ ዎደ ጋድያ ጋፃ ጋካናዉ ጫኮፍተ፤ ጫክሽን አትዳ ፖሽልያ ቆሮፕተ፤ ሄሳ ማንቆታስነ በተ አሳስ አጋግተ። ታኒ ጎዳ ህንተ ፆሳ።<verse eid="LEV 23:22"/></para>
  <para style="s1">ሞይዘ ፑኖ ባኣለ</para>
  <para style="r">(<ref loc="NUM 29:1-6">ታይቦ 29:1-6</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 23:23"/><verse number="24" style="v" sid="LEV 23:24"/>እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ ላፑን አጌናን ኮይሮ ጋላሳ ሸምፖ ጋላስ ኦድ ቦንችተ፤ ሀሳይሶ ሞይዘ ፑንሸ ጌሻ ሺቆ ሺቅተ። <verse eid="LEV 23:24"/><verse number="25" style="v" sid="LEV 23:25"/>ሄ ጋላስ ጎዳስ ፁሳ ያርሾ ሺሽተፐ አትሽን፥ ኦሶ ኦፕተ።<verse eid="LEV 23:25"/></para>
  <para style="s1">ናጋራ አቶተ ጋላሳ</para>
  <para style="r">(<ref loc="NUM 29:7-11">ታይቦ 29:7-11</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 23:26"/><verse number="27" style="v" sid="LEV 23:27"/>ላፑን አጌናን ታማን ጋላሳይ ናጋራ አቶተ ጋላስ፤ ሄ ጋላስ ጌሻ ሺቆ ሺቅተ። ሄ ጋላስ ህንተና ካዉሽተ፤ ጎዳስ ፁሳ ያርሾ ሺሽተ። <verse eid="LEV 23:27"/><verse number="28" style="v" sid="LEV 23:28"/>ሄ ጋላሳይ ጎዳ ህንተ ፆሳ ስንን ህንተ ናጋራይ ቁሸታና መላ ህንተ ናጋራ አቶተ ጋላስ ግድያ ግሾ ሄ ጋላሳን ኦሶ ኦፕተ። <verse eid="LEV 23:28"/><verse number="29" style="v" sid="LEV 23:29"/>ሄ ጋላስ ባናተ ካዉሾና አስ ኦንካ ባ አሳ ግዶፈ ኩረቶ። <verse eid="LEV 23:29"/><verse number="30" style="v" sid="LEV 23:30"/>ሄ ጋላስ ኦሶ ኦያ ኡራ ኦናካ ታኒ እያ አሳ ግዶፈ ኩራና። <verse eid="LEV 23:30"/><verse number="31" style="v" sid="LEV 23:31"/>ሄ ጋላስ ኦሶ ኦፕተ። ሀይስ ህንተ ደእያ በሳ ኡባን ያና የለተስ መርና ዎጋ ግዶ። <verse eid="LEV 23:31"/><verse number="32" style="v" sid="LEV 23:32"/>ሄስ ህንተዉ ዱማትዳ ሸምፖ ጋላስ፤ ሄ ጋላስ ህንተናተ ካዉሽተ። ሄ አጌናን ኡዱፉን ጋላስ ኦማርሳፈ ዶምድ፥ ታማን ጋላስ ኦማርስ ጋካናዉ ህንተ ሳምባታ ቦንችተ።<verse eid="LEV 23:32"/></para>
  <para style="s1">ሻቃራ ባኣለ</para>
  <para style="r">(<ref loc="NUM 29:12-40">ታይቦ 29:12-40</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 23:33"/><verse number="34" style="v" sid="LEV 23:34"/>እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ ላፑን አጌናን ታማነ እቻሻን ጋላሳፐ ዶምድ፥ ላፑን ጋላስ ጋካናዉ ጎዳስ ሻቃራ ባኣለ። <verse eid="LEV 23:34"/><verse number="35" style="v" sid="LEV 23:35"/>ሄ ጋላሳታፐ ኮይሮ ጋላሳን ጌሻ ሺቆ ሺቅተ፤ ኦሶ ኦፕተ። <verse eid="LEV 23:35"/><verse number="36" style="v" sid="LEV 23:36"/>ላፑን ጋላስ ኡባን ጎዳስ ፁሳ ያርሾ ሺሽተ፤ ሆስፑን ጋላሳን ጌሻ ሺቆ ሺቅተ። ጎዳስ ፁሳ ካ ያርሾ ሺሽተ። ሄ ጋላሳይ ባልያ ዉርሰ ጋላስ ግድያ ግሾ፥ ኦሶ ኦፕተ።<verse eid="LEV 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37"/>ፁሳ ያርሾ፥ ካ ያርሾ፥ ሀራ ያርሾታነ ኡሻ ያርሾ ኮሽያ ዎደን ጎዳስ ሺሻናዉ ጌሻ ሺቆ ኦድ አዋጃና ጎዳ ባለት ሀይሳታ። <verse eid="LEV 23:37"/><verse number="38" style="v" sid="LEV 23:38"/>ሀ ያርሾት ጎዳ ሳምባታታፐ፥ ጎዳስ እምያ እሞታታፐ፥ ቃንገ እሞታታፐነ ዶሳን እምያ እሞታታፐ ዱማ።<verse eid="LEV 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39"/>ህንተ ጋደን ካፅዳ ካ ሺሽዳፐ ጉየ፥ ታማነ እቻሻን ጋላሳፐ ዶምድ ላፑን ጋላስ ጋካናዉ ጎዳ ባኣለ ቦንችተ። ኮይሮ ጋላሳይነ ሆስፑን ጋላሳይ ህንተዉ ዱማ ሸምፖ ጋላስ ግዳና። <verse eid="LEV 23:39"/><verse number="40" style="v" sid="LEV 23:40"/>ኮይሮ ጋላስ ሎኦ ም አይፈ፥ ዛምባ ታሸ፥ ጭልኦ ም ሀይነ ሻፋ ጋፃን ድጭያ ም ሀይ ኤክድ፥ ጎዳ ህንተ ፆሳ ስንን ኡፋይትሸ ላፑን ጋላስ ባኣለ ቦንችተ። <verse eid="LEV 23:40"/><verse number="41" style="v" sid="LEV 23:41"/>ሄ ባልያ ላይን ላይን ላፑን አጌናን ላፑን ጋላስ ጎዳ ቦንችተ። ሄስ ያና የለተስ መርና ዎጋ ግዶ። <verse eid="LEV 23:41"/><verse number="42" style="v" sid="LEV 23:42"/>ሄ ላፑን ጋላሳ ሻቃራን ደእተ፤ እስራኤለ አስ ግድዳ ኡባይ ሄ ሻቃራን ደኦ። <verse eid="LEV 23:42"/><verse number="43" style="v" sid="LEV 23:43"/>ታኒ ህንተና ግብፀ ቢታፈ ከስዳ ዎደ ሻቃራን ዳና መላ ኦዳይሳ ያና የለተይ ኤራና። ታኒ ጎዳ ህንተ ፆሳ።<verse eid="LEV 23:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44"/>ሄሳዳ ኦድ፥ ሙሰይ ጎዳ ባለታ ቦንችያ ዎጋ እስራኤለ አሳስ ኦድስ።<verse eid="LEV 23:44"/></para>
  <chapter eid="LEV 23"/>
  <chapter number="24" style="c" sid="LEV 24"/>
  <para style="s1">ፆምፐታ ናጎ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="LEV 24:1"/><verse number="2" style="v" sid="LEV 24:2"/>ፆምፐይ ቶኦና ኤፅሸ ዳና መላ እያዉ ኮሽያ ጉምእድ ፅልስዳ ሻማሆ ዛይተ ነዉ ኤሀና መላ እስራኤለ አሳ ኪታ። <verse eid="LEV 24:2"/><verse number="3" style="v" sid="LEV 24:3"/>ጌሻ ዱንካንያ ግዶን ደእያ ማርካተ ማጋራጁዋፈ ካረ ባጋራ ኦማርሳፈ ዎንታ ጋካናዉ አሮን ጎዳ ስንን ሄ ፆምፕያ ኡባ ዎደ ኤ። ያና የለተ ኡባስ ሄስ መርና ዎጋ ግዶ። <verse eid="LEV 24:3"/><verse number="4" style="v" sid="LEV 24:4"/>ፆምፐ ዎያ ዋላህ ባይና ዎርቃ ኮጫ ቦላ ደእያ ፆምፐት ጎዳ ስንን ኡባ ዎደ ኤፃና መላ አሮን ናጎ።<verse eid="LEV 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5"/>ታማነ ናምኡ ክሎ ግራመ ግድያ ሎኦ ለ ኤካዳ ታማነ ናምኡ ኡይ ኡካ። <verse eid="LEV 24:5"/><verse number="6" style="v" sid="LEV 24:6"/>ሄ ኡይታ ኡሱፑና ኡሱፑና ናምኡ ማራን ጎዳ ስንን ደእያ ዋላህ ባይና ዎርቃ ፃርጴዛ ቦላ ዎ። <verse eid="LEV 24:6"/><verse number="7" style="v" sid="LEV 24:7"/>ጎዳስ ፁገታናዉ ሺቅዳ ካ ያርሾ ግደይሳ ኤርሳናዉ፥ ናምኡ ማራታ ምየን ጌሻ እፃነ ዎ። <verse eid="LEV 24:7"/><verse number="8" style="v" sid="LEV 24:8"/>ሀ ኡይ ሳምባታን ሳምባታን ኡባ ዎደ አሮን እስራኤለ አሳ ግሾ መርና ጫቆ ኦድ ጎዳ ስንን ዎ። <verse eid="LEV 24:8"/><verse number="9" style="v" sid="LEV 24:9"/>ሄስ አሮናነ እያ አደ ናይታ ጋክያ ግሾ፤ ኤንቲ እያ ጌሻ በሳን ሞ። ሄስ ጎዳስ ፁሳ ያርሹዋፈ ዎጋዳ አሮናነ እያ ናይታ ጋክያ ግሾ ግድያ ግሾ ኡባፈ ጌሽ።<verse eid="LEV 24:9"/></para>
  <para style="s1">ሱረ ፕርዳ</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10"/>ባ አየን እስራኤለ፥ ባ አዋን ግብፀ አስ ግድዳ እስ ኡራይ ደኤስ። እስ ጋላስ እ ሀራ እስራኤለ አሳራ ሄራን ዋትስ። <verse eid="LEV 24:10"/><verse number="11" style="v" sid="LEV 24:11"/>ባ አየን እስራኤለ ግድዳ ኡራይ ጎዳ ሱን ጫይስ፤ ያትን እያ አሳይ ሙሰኮ ኤህዶሶና። ሄ ኡራ አይያ ዳነ ኮቸ ግድዳ ደብራ ናአ። እ ሱንይ ሳሎምቶ። <verse eid="LEV 24:11"/><verse number="12" style="v" sid="LEV 24:12"/>ሄ ኡራ ዋታነኮ ጎዳ ሸነይ ቆንጫና ጋካናዉ እያ ናግስዶሶና።<verse eid="LEV 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13"/>ጎዳይ ሙሰ ሀይሳዳ ያግስ፤ <verse eid="LEV 24:13"/><verse number="14" style="v" sid="LEV 24:14"/>ሄ ጫይዳ ኡራ ጉታፐ ጋፃ ከሳ። እ ጫይሽን ስእዳ አሳ ኡባይ ባንታ ኩሽያ እያ ሁጵያ ቦላ ዎ፤ እስራኤለ ማባራ ኡባይ እያ ሹቻ ጫድድ ዎ። <verse eid="LEV 24:14"/><verse number="15" style="v" sid="LEV 24:15"/>እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ እስ አስ ባ ፆሳ ጫይኮ፥ እ ባ ናጋራን ኦይሸታና። <verse eid="LEV 24:15"/><verse number="16" style="v" sid="LEV 24:16"/>ጎዳ ሱን ጫይያ አስ ሀይቆ፤ እስራኤለ ማባራ ኡባይ እያ ሹቻን ጫዶ። በተ አስ ዎይኮ ጋደ አስ ጎዳ ሱን ጫይኮ ሀይቆ።<verse eid="LEV 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17"/>አሰ ዎዳ አስ ሀይቆ። <verse eid="LEV 24:17"/><verse number="18" style="v" sid="LEV 24:18"/>አሳ መሄ ዎዳ አስ ኦንካ ባ ዎዳ መህያ ግሾ ፓፃ መህያ ቃንፆ። <verse eid="LEV 24:18"/><verse number="19" style="v" sid="LEV 24:19"/>እስ አስ ባ ሾሩዋ ቆህኮ፥ እ ኦዳይሳዳ እያ ቦላ ኦሰቶ። <verse eid="LEV 24:19"/><verse number="20" style="v" sid="LEV 24:20"/>መንኮ መኦ፤ አይፈ ግሾ አይፈ፤ አቻ ግሾ አቸ። አሳ ቦላ ቆሆ ጋዳ ኦንካ እ ጋዳ ቆሁዋዳ እያ ቦላ ጋኮ። <verse eid="LEV 24:20"/><verse number="21" style="v" sid="LEV 24:21"/>መሄ ዎዳ አስ ሄ መህያ ጋትያ ቃንፆ፤ ሽን አሰ ዎዳ አስ ሀይቆ። <verse eid="LEV 24:21"/><verse number="22" style="v" sid="LEV 24:22"/>በተ አሳስነ እስራኤለ አሳስ ህገይ እስኖ ግዶ። ታኒ ጎዳ ህንተ ፆሳ።<verse eid="LEV 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 24:23"/>ሙሰይ ሄሳ እስራኤለ አሳስ ኦድስ፤ ኤንቲ ሄ ጫይዳ ኡራ ጉታፐ ጋፃ ከስድ፥ ሹቻን ጫድድ ዎዶሶና። ያትድ እስራኤለ አሳይ ጎዳይ ሙሰ ኪትዳይሳዳ ኦዶሶና።<verse eid="LEV 24:23"/></para>
  <chapter eid="LEV 24"/>
  <chapter number="25" style="c" sid="LEV 25"/>
  <para style="s1">ሳምባታ ላይ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1"/>ሲና ዙማ ቦላ ጎዳይ ሙሰኮ ሀይሳዳ ያግስ። <verse eid="LEV 25:1"/><verse number="2" style="v" sid="LEV 25:2"/>ኔኒ እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ ታኒ ህንተዉ እምያ ቢታ ህንተ ገልያ ዎደ ቢትያ ባ ሁጰን ጎዳ ሳምባታ ቦንቾ። <verse eid="LEV 25:2"/><verse number="3" style="v" sid="LEV 25:3"/>ኡሱፑን ላይ ኩመ ህንተ ጋደን ዘርተ፤ ኡሱፑን ላይ ኩመ ህንተ ዎይነ ፄራ ፁንቅተ፤ እያ አይፍያ ማፅተ። <verse eid="LEV 25:3"/><verse number="4" style="v" sid="LEV 25:4"/>ሽን ላፑን ላይይ ቢታስ ሸምፖ ሳምባታ፤ ሄስ ጎዳ ሳምባታ። ሄ ላፑን ላይን ጋደን ዘሮፕተ፤ ህንተ ዎይነ ፄራ ፁንቆፍተ። <verse eid="LEV 25:4"/><verse number="5" style="v" sid="LEV 25:5"/>ህንተ ቢታን አሰቦ ካፅዳባ ሺሾፕተ፤ ዎይነ ፄራ ፁንቆፍተ፤ አይፍያ ማፆፕተ። ሄ ላይይ ቢታስ ኩመ ሸምፖ ላይ ግዶ። <verse eid="LEV 25:5"/><verse number="6" style="v" sid="LEV 25:6"/>ሄ ሳምባታ ላይን ቢታይ ኦሰቶና ደእሽን ካፅያ ካ ኔኒ፥ ነ አደ አይለይ፥ ነ ማጫ አይለይ፥ ነ ሶን ኡነ ኦይ፥ ጉ ዎደስ ደእያ በተ አስ ማናዉ ዳንዳኤስ። <verse eid="LEV 25:6"/><verse number="7" style="v" sid="LEV 25:7"/>ሄሳዳካ፥ ነ መህያስነ ነ ቢታን ደእያ ዶአታስ ግድያ ካ ደማና፤ ቢታን ካፅያባ ኡባይ ሜተቶ።<verse eid="LEV 25:7"/></para>
  <para style="s1">እሻታማን ላይ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8"/>ላይታስ ግዶን ደእያ ላፑን ሳምባታታ ታይባ፤ ላፑን ሳምባታታስ ላይ ታይቦይ ላፑን ቶሆ ላፑና፤ ሄስካ ኦይታማነ ኡዱፉን ላይ። <verse eid="LEV 25:8"/><verse number="9" style="v" sid="LEV 25:9"/>ላፑን አጌናን፥ ታማን ጋላስ ቦንቸትያ ናጋራ አቶተ ጋላሳን ሞይዘ ፑንያ አስ ቢታ ኡባ ኪታ። <verse eid="LEV 25:9"/><verse number="10" style="v" sid="LEV 25:10"/>እሻታማን ላይ ዱማይድ፥ ሄ ቢታን ደእያ ኡባስ ላአተ አዋጅተ። ሄስ ህንተዉ እሻታማን ላይ ባኣለ። ሄ ዎደ ህንተ ኡባይ ህንተ ጋድያኮነ ህንተ ሶ አሳኮ ስምተ። <verse eid="LEV 25:10"/><verse number="11" style="v" sid="LEV 25:11"/>ሄ ላይይ ህንተዉ እሻታማን ላይ ባኣለ። ሄ ላይን ዘሮፕተ፤ አሰቦ ካፅዳባ ጫኮፍተ፤ ፄራ ፁንቆና አይፍዳ ዎይነ አይፍያ ማፆፕተ። <verse eid="LEV 25:11"/><verse number="12" style="v" sid="LEV 25:12"/>ሄስ እሻታማን ላይ ባኣለ ግድያ ግሾ እ ህንተዉ ጌሽ፤ ጎዮና ጮ ደንባን ካፅዳባ ሚተ።<verse eid="LEV 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13"/>ሄ እሻታማን ላይ ባኣለ ዎደ አስ ኡባይ ባ ጋደ ስሞ።<verse eid="LEV 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 25:14"/>ህንተ፥ ህንተ ሾሩዋፐ ጋደ ሻምኮ ዎይኮ እያዉ ባይዝኮ እሶይ እሱዋ ጭሞፍተ። <verse eid="LEV 25:14"/><verse number="15" style="v" sid="LEV 25:15"/>ህንተ እሻታማን ላይ ባልያፐ ጉየ ደእያ ላይታ ታይቡዋን ህንተ ሾሩዋፐ ሻምተ። ህንተ ሾሮይ ጋደይ ካ እማናዉ ደእያ ላይታ ታይቡዋዳ ባይዞ። <verse eid="LEV 25:15"/><verse number="16" style="v" sid="LEV 25:16"/>ላይ ታይቦይ ዳሮ ግድኮ ጋተይ ዳሬስ፤ ላይታ ታይቦይ ጉፅኮ ጋተይ ጉፄስ። ጋድያ ሎኦተዳ ህንተ ሾሮይ ህንተዉ ባይዜስ። <verse eid="LEV 25:16"/><verse number="17" style="v" sid="LEV 25:17"/>ህንተ እሶይ እሱዋ ጭሞፍተ፤ ሽን ህንተ፥ ህንተ ፆሳ ያይተ። ታኒ ጎዳ፥ ህንተ ፆሳ።<verse eid="LEV 25:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18"/>ህንተ ሀ ቢታን ሳሮ ዳና መላ ታ ኪታ ፖልተ፤ ታ ህግያ ናግተ። <verse eid="LEV 25:18"/><verse number="19" style="v" sid="LEV 25:19"/>ቢታይ ባ አይፍያ ህንተዉ እምን ህንተ ካላና ጋካናዉ ማና፤ ሄ ቢታን ህንተ ሳሮ ዳና። <verse eid="LEV 25:19"/><verse number="20" style="v" sid="LEV 25:20"/>ሄኮ፥ ኑኒ ዘሮና አግድ፥ ቃስ ካ ሺሾና አግድ፥ ላፑን ላይን አይ ማኔ? ጊኮ፥ <verse eid="LEV 25:20"/><verse number="21" style="v" sid="LEV 25:21"/>ታኒ ኡሱፑን ላይን ታ አንጁዋ ህንተዉ ኪታና፤ ቢታይ ሄ ላይስ ግድያ ካ እማና። <verse eid="LEV 25:21"/><verse number="22" style="v" sid="LEV 25:22"/>ሆስፑን ላይን ህንተ፥ ህንተ ቢታን ዘርያ ዎደ ሻቻ ካ ማና። ህንተ ዘርያ ካ ኡዱፉን ላይን ሺሻና ጋካናዉ ሻቻ ካ ማና።<verse eid="LEV 25:22"/></para>
  <para style="s1">ሻሎ ዛሮ ዎጋ</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23"/>ቢታይ ታባ ግድያ ግሾነ ህንተ ሄ ቢታን እማነ በተ ግድድ ደእያ ግሾ ቢታ ስሞናዳ ኦድ ባይዞፕተ። <verse eid="LEV 25:23"/><verse number="24" style="v" sid="LEV 25:24"/>ህንተ ኦይክዳ ጋድያ ጎዳት፥ ዎዛና ማታይ እስራኤለ ኡባን ናገታናዉ በሴስ።<verse eid="LEV 25:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 25:25"/>እስ እስራኤለ አስ ማንቅድ ባ ጋድያፐ ባይዝኮ፥ እያ ማታ ዳቦይ ሄ ጋድያ እያዉ ዎዞ። <verse eid="LEV 25:25"/><verse number="26" style="v" sid="LEV 25:26"/>እያው ሄ ጋድያ ዎዝያ ዳቦይ ይኮ፥ እ ዎንቶ ዱረትድ ዎዝያ ሚሸ ደምኮ ዛሪድ ዎዛናዉ ዳንዳኤስ። <verse eid="LEV 25:26"/><verse number="27" style="v" sid="LEV 25:27"/>ባ ባይዝዳ ዎደፐ ዶምድ ደእያ ላይ ታይብድ፥ አትዳ ላይ ሚሽያ ሻምዳይሳስ ዛሮ፤ ያትድ እ ባ ጋድያ ስሞ። <verse eid="LEV 25:27"/><verse number="28" style="v" sid="LEV 25:28"/>ሽን እያዉ ሄ ጋድያ ዎዛናዉ ግድያ ሚሸይ ይኮ፥ እሻታማን ላይ ባለይ ጋካናዉ ጋደይ ሻምዳ ኡራ ኩሸን ጋምኦ። እሻታማን ላይ ባኣለ ዎደ እያ ጋደይ እያዉ ስሞ።<verse eid="LEV 25:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29"/>እስ አስ ግምበትዳ ካታማ ግዶን ደእያ ኬ ባይዝኮ፥ እ ባይዝዳ ዎድያፐ ብድ እስ ላይ ኩማና ጋካናዉ ዛሪድ ዎዛናዉ ዳንዳኤስ። <verse eid="LEV 25:29"/><verse number="30" style="v" sid="LEV 25:30"/>ሽን እስ ላይ ግዶን ዎዛናዉ ዳንዳኤቶና እፅኮ፥ ሄ ግምበትዳ ካታማ ግዶን ደእያ ኬይ ሻምዳ ኡራስነ እያ ኮቻስ ግዴስ። እሻታማን ላይ ባኣለ ዎደ ስመና። <verse eid="LEV 25:30"/><verse number="31" style="v" sid="LEV 25:31"/>ሽን ግምበትቦና ሄራን ደእያ ኬት ጋደ መላ ዎዘቶሶና። እሻታማን ላይ ባኣለ ዎደ ባይዝዳይሳስ ስሞሶና።<verse eid="LEV 25:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 25:32"/>ግዶሽን፥ ሌወት ካታማታን ደእያ ባንታ ኬ ባንታ ኮይዳ ዎደ ዎዛናዉ ዳንዳኦሶና። <verse eid="LEV 25:32"/><verse number="33" style="v" sid="LEV 25:33"/>ሌወታፐ እስ አስ ኤንታ ካታማ ግዶን ደእያ ኬ ባይዝድ ዎዛናዉ ፆነትኮ፥ ሄ ኤንታ ካታማ ግዶን ደእያ ኬይ እሻታማን ላይ ባልያ ዎደ ስሜስ። ሌወታ ካታማ ግዶን ደእያ ኬይ እስራኤለ አሳ ግዶን ሌወታሳ። <verse eid="LEV 25:33"/><verse number="34" style="v" sid="LEV 25:34"/>ሽን ኤንታ ካታማ ዩሹዋን ደእያ ሄን ቢታይ ኤንታዉ መርና አቆ ግድያ ግሾ ባይዘተና።<verse eid="LEV 25:34"/></para>
  <para style="s1">ታልኤ ዎጋ</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35"/>እስ እስራኤለ አስ ማንቅድ ባና አይሳናዉ ፆነትኮ፥ እማዳ ዎይኮ በተ አሳዳ እ ኔራ ዳና መላ ማዳ። <verse eid="LEV 25:35"/><verse number="36" style="v" sid="LEV 25:36"/>እያ ኔራ ዎናዉ እያፐ የሎ ኤኮፋ ዎይኮ ዎ ሞፓ። ሽን ነ ፆሳ ያያ። <verse eid="LEV 25:36"/><verse number="37" style="v" sid="LEV 25:37"/>ነ ብራ እያዉ የሎራ ታልኦፋ፤ ነ ካ እያዉ ዎራ ባይዞፓ። <verse eid="LEV 25:37"/><verse number="38" style="v" sid="LEV 25:38"/>ህንተዉ ካናነ ቢታ እማናዉነ ህንተ ፆሳ ግዳናዉ፥ ህንተና ግብፀ ቢታፈ ከስዳ፥ ታኒ፥ ጎዳ ህንተ ፆሳ።<verse eid="LEV 25:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39"/>እስ እስራኤለ አስ ማንቅድ፥ ባና ነዉ አይለ ኦድ ባይዝኮ እያ አይለዳ ኦስሶፓ። <verse eid="LEV 25:39"/><verse number="40" style="v" sid="LEV 25:40"/>እ በተ አሳዳ ኡነ ኦድ እሻታማን ላይ ባለይ ጋካናዉ ኔራ ደኦ። <verse eid="LEV 25:40"/><verse number="41" style="v" sid="LEV 25:41"/>ሄ ዎደ እ ባ ናይታራ እስፈ ነ ሶፐ ከይድ ባ ሶ አሳኮ ቦ፤ ባ አዋ ጋደ ስሞ። <verse eid="LEV 25:41"/><verse number="42" style="v" sid="LEV 25:42"/>እስራኤለ አሳይ ታኒ ግብፀ ቢታፈ ከስዳ ታ አይለ ግድያ ግሾ ኤንቲ አይለተስ ባይዘቶፎ። <verse eid="LEV 25:42"/><verse number="43" style="v" sid="LEV 25:43"/>ኔኒ ኤንታ ኡንኤዳ ሃሮፓ፤ ሽን ኔኒ፥ ነ ፆሳ ያያ።<verse eid="LEV 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 25:44"/>ነዉ አደነ ማጫ አይለይ ዳና መላ ኮይኮ፥ ነ ዩሹዋን ደእያ ካዎተታፐ ሻማ። <verse eid="LEV 25:44"/><verse number="45" style="v" sid="LEV 25:45"/>ህንተ ቢታን ደእያ በተ አሳ ናይታ ሻማናዉ ዳንዳኤታ። ህንተ ቢታን ደእሸ የለትዳ ኤንታ ሶ አሳፐ ህንተዉ ሻሎ ኦናዉ ዳንዳኤታ። <verse eid="LEV 25:45"/><verse number="46" style="v" sid="LEV 25:46"/>ህንተፈ ጉየ፥ ህንተ ናይት ኤንታ መርናዉ ላታና መላ ህንተ ናይታስ እምተ። ህንተ ኤንታ ኡባ ዎደ ህንተ አይለ ኦናዉ ዳንዳኤታ፤ ሽን እስራኤለ አስ ኡንኤድ ሃሮፕተ።<verse eid="LEV 25:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47"/>ነ ማታን ደእያ እማ ዎይኮ በተ አስ ዱረትኮ፥ እያ ማታን ደእያ እስራኤለ ኡራይ ማንቅድ፥ ነ ማታን ደእያ እማስ ዎይኮ በተ ኡራስ ዎይኮ እማ አድያ ኮቻፈ እሱዋስ ባና ባይዝኮ፥ <verse eid="LEV 25:47"/><verse number="48" style="v" sid="LEV 25:48"/>እ ባይዘትድ ስምን፥ እያ ዎዛናዉ ዳንዳኤቴስ፤ እያ ዳቦታፐ እሶይ እያ ዎዞ። <verse eid="LEV 25:48"/><verse number="49" style="v" sid="LEV 25:49"/>እያ አዋ እሻይ፥ ዎይኮ እያ አዋ እሻ ናአይ ዎይኮ እያ ያራፐ ማታ ዳቦይ እያ ዎዞ፤ ዎይኮ እ ባ ሁጰን ዱረትድ ባና ዎዞ። <verse eid="LEV 25:49"/><verse number="50" style="v" sid="LEV 25:50"/>እ ባና ሻምዳ ኡራራ ግድድ፥ እ ባና ባይዝዳ ላይፈ ዶምድ እሻታማን ላይ ባለይ ጋካናዉ ደእያ ላይታ ታይቦ። እያ ላአተ ጋተይ፥ ሄ ላይ ታይቡዋ ኬና ግዶ። እ ባና ሻምዳይሳራ ጋምእዳ ዎድያ ጋተይ እስ አስ ኡነ ኦድ ደምያ ሚሽያራ ግና ግዶ። <verse eid="LEV 25:50"/><verse number="51" style="v" sid="LEV 25:51"/>እሻታማን ላይ ባለይ ጋካናዉ ዳሮ ላይ አትዳባ ግድኮ፥ ባ ባይዘትዳ ጋትያፐ ሄ ላይ ታይቦን ባና ዎዝያ ጋትያ ቃንፆ። <verse eid="LEV 25:51"/><verse number="52" style="v" sid="LEV 25:52"/>እሻታማን ላይ ባለይ ጋካናዉ አትዳ ላይይ ጉ ግድኮ፥ ባና ሻምዳይሳራ እስፈ ታይብድ፥ ሄ ላይ ታይቦን ባና ዎዝያ ጋትያ ቃንፆ። <verse eid="LEV 25:52"/><verse number="53" style="v" sid="LEV 25:53"/>እ ላይን ላይን ኡነ ኦያ አሳዳ ባና ሻምዳይሳራ ደኦ፤ እያ ጎዳይ እያ ኡንኤድ ሃራናዉ በሰና።<verse eid="LEV 25:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 25:54"/>ሽን እ ሄሳ መላ ሀኖን ዎዘቶና እፅኮ፥ እሻታማን ላይ ባለይ ጋክያ ዎደ እነ እያ ናይት አይለተፈ ከዮ። <verse eid="LEV 25:54"/><verse number="55" style="v" sid="LEV 25:55"/>እስራኤለ አሳይ፥ ታ ግብፀ ቢታፈ ከስዳ ታ አይለ። ታኒ፥ ጎዳ ህንተ ፆሳ።<verse eid="LEV 25:55"/></para>
  <chapter eid="LEV 25"/>
  <chapter number="26" style="c" sid="LEV 26"/>
  <para style="s1">ኪተተ ኤህያ ዎይቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1"/>ጎይናናዉ ኤቃታ ኦፍተ፤ ቃስ ሀዉልተ ዎይኮ ኤቃ ቱሱ ዎይኮ ሹቻ ኤቃ ኤሶፍተ። ታኒ ጎዳ፥ ህንተ ፆሳ። <verse eid="LEV 26:1"/><verse number="2" style="v" sid="LEV 26:2"/>ታ ሳምባታታ ናግተ፤ ታ ጎይኖ በሳ ቦንችተ። ታኒ ጎዳ።<verse eid="LEV 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3"/>ህንተ ታ ህግያ ካልኮነ ታ ኪታ ናግኮ፥ <verse eid="LEV 26:3"/><verse number="4" style="v" sid="LEV 26:4"/>ታኒ ህንተዉ እራ ዎደን ዎደን እማና፤ ቢታይ ካ ዳርስድ ዶልሳና፤ ጋደን ደእያ ምይ አይፋና። <verse eid="LEV 26:4"/><verse number="5" style="v" sid="LEV 26:5"/>ህንተ ካ ሺሽድ ኦንጎና ደእሽን ዎይነ ማፅያ ዎደይ ጋካና፤ ዎይንያ ማፅድ ዉርሶና ካ ዘርያ ዎደይ ጋካና። ህንተ ካላና ጋካናዉ ካ ማና፤ ህንተ፥ ህንተ ቢታን ሳሮ ዳና።<verse eid="LEV 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 26:6"/>ታኒ ቢታስ ሳሮተ እማና፤ ኦንካ ህንተና ያሽሶና ህንተ ዝንአና። ኢታ ዶአታ ታኒ ቢታፈ ይሳና፤ ህንተ ቢታን ናምአን ኦል ደንደና። <verse eid="LEV 26:6"/><verse number="7" style="v" sid="LEV 26:7"/>ህንተ ሞርከታ ህንተ የደና፤ ኤንቲ ህንተ ስንን ማሻን ሀይቃና። <verse eid="LEV 26:7"/><verse number="8" style="v" sid="LEV 26:8"/>ህንተፈ እቻሻይ ፄታ የደና፤ ቃስ ፄታይ ታሙ ሙኩላ የደና። ህንተ ሞርከት ህንተ ስንን ማሻን ሀይቃና።<verse eid="LEV 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 26:9"/>ታኒ ህንተና ማሮታ አይፈን በአና፤ ህንተና አይፍሳና፤ ህንተና ዳርሳና፤ ታኒ ታ ጫቁዋ ህንተራ ምንና። <verse eid="LEV 26:9"/><verse number="10" style="v" sid="LEV 26:10"/>ህንተ ሻቻ ካ ምድ ዉርሶና ደእሸ፥ ዋቻ ካ ዎናዉ፥ ሻቻ ካ ድግድ በሰ ጊግሳና። <verse eid="LEV 26:10"/><verse number="11" style="v" sid="LEV 26:11"/>ታኒ ታ ደእያ በሳ ህንተ ግዶን ኦና፤ ታኒ ህንተና እፅከ። <verse eid="LEV 26:11"/><verse number="12" style="v" sid="LEV 26:12"/>ታኒ ህንተ ግዶን ሄመታና፤ ህንተ ፆሳ ግዳና፤ ህንተ ታ አሰ ግዳና። <verse eid="LEV 26:12"/><verse number="13" style="v" sid="LEV 26:13"/>ህንተ ግብፀታስ አይለ ግዶና መላ ሄ ቢታፈ ህንተና ከስዳ ጎዳይ፥ ታኒ ህንተ ፆሳ። ታኒ ህንተ አይለተ ቃምባራ መንስ፤ ህንተ ቁ ግድ ሄመታና መላ ኦስ።<verse eid="LEV 26:13"/></para>
  <para style="s1">ኪተተ እፆይ ኤህያ ሴራ</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14"/>ሽን ህንተ ታና ስኦና እፅኮነ፥ ታ ኪታ ፖሎና እፅኮ፥ <verse eid="LEV 26:14"/><verse number="15" style="v" sid="LEV 26:15"/>ታ ዎጋ ካኮ፥ ታ ኪታ ኡባ ፖሎና እፅድ ታ ጫቁዋ መንናዉ ታ ህግያ ቦርኮ፥ <verse eid="LEV 26:15"/><verse number="16" style="v" sid="LEV 26:16"/>ሄ ዎደ ታኒ ህንተ ቦላ ሀይሳ ኦና፤ ህንተ አኬኮና ደእሽን ያሽ፥ ግልቃተ፥ ህንተ አይፍያ ተልጁምስያነ ህንተ አሳተ መልስያ ምሻ ሀርገ ህንተ ቦላ የዳና። ህንተ ሞርከት ማና ግሾ ህንተ ዘርያ ዘረይ መላ ግዳና። <verse eid="LEV 26:16"/><verse number="17" style="v" sid="LEV 26:17"/>ታ ህንተና ኢታ አይፈን ፄላና፤ ህንተ ሞርከታ ስንን ህንተ ኩንዳና፤ ህንተና እፀይሳት ሃራና፤ ኦንካ የደና ህንተ ባቃታና።<verse eid="LEV 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 26:18"/>ሄሳ ኡባ ኦንካ ህንተ ታና ስኦና እፅኮ፥ ታኒ ህንተ ናጋራ ግሾ ህንተ ሴራ ላፑን ዳኮ ኦና። <verse eid="LEV 26:18"/><verse number="19" style="v" sid="LEV 26:19"/>ታ ህንተ ኦቶሩዋ መንና፤ ሳሉዋ ብራታ፤ ሳአ ናሰ ብራታ ኦና። <verse eid="LEV 26:19"/><verse number="20" style="v" sid="LEV 26:20"/>ህንተ ቢታይ ካ፥ ህንተ ምይ አይፈ እሞና ግሾ ህንተ ዎልቃይ ጮ በሳን ዉራና።<verse eid="LEV 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21"/>ህንተ ታዉ እፃስ ጊኮነ ታና ስኦና እፅኮ፥ ህንተ ናጋራ መላ ላፑን ዳኮ ጋዶ ታኒ ህንተ ቦላ ኤሀና። <verse eid="LEV 26:21"/><verse number="22" style="v" sid="LEV 26:22"/>ታኒ ህንተ ቦላ ባዞ ዶአታ የዳና፤ ኤንቲ ህንተ ናይታ ቦንቃና። ህንተ መሄታ ይሳና፤ ህንተ ታይቡዋ ጉና፤ ሄሳ ጋሶን ህንተ ሄመትያ ኦገይ ሁሳታና።<verse eid="LEV 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23"/>ሄ ሴራ ኡባን ህንተ ታኮ ስሞና እፅኮ፥ <verse eid="LEV 26:23"/><verse number="24" style="v" sid="LEV 26:24"/>ሄ ዎደ ታካ ህንተዉ እፃስ ጋና። ህንተ ናጋራ ግሾ ታኒ ታ ሁጰን ህንተና ላፑን ዳኮ ሴራና። <verse eid="LEV 26:24"/><verse number="25" style="v" sid="LEV 26:25"/>ታ ጫቁዋ ህንተ መንዳ ግሾ፥ ኩሸ ዛራናዉ ማሻ ህንተ ቦላ ኤሀና። ህንተ፥ ህንተ ካታማታን ሺቅኮካ፥ ታኒ ህንተ ቦላ ጋዶ የዳና። ህንተ፥ ህንተ ሞርከታ ኩሸን አድ እመታና። <verse eid="LEV 26:25"/><verse number="26" style="v" sid="LEV 26:26"/>ህንተ ካ ታኒ ይስያ ዎደ ታሙ ማጫሳት እስ በሸን ኡይ ኡካና፤ ሄ ኡይ ምዛነን ሻክድ ኤካና፤ ህንተ ሄሳ ማና ሽን ካለከታ።<verse eid="LEV 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27"/>ሀ ኡባን ህንተ ታና ስኦና እፅኮነ ህንተ ኢታተን ጉጅድ ቢኮ፥ <verse eid="LEV 26:27"/><verse number="28" style="v" sid="LEV 26:28"/>ታ ህንተ ቦላ ሀንቆን ደንዳና። ህንተ ናጋራ ግሾ ታኒ ህንተና ላፑን ዳኮ ሴራና። <verse eid="LEV 26:28"/><verse number="29" style="v" sid="LEV 26:29"/>ህንተ፥ ህንተ አደ ናይታነ ህንተ ማጫ ናይታ አሹዋ ማና። <verse eid="LEV 26:29"/><verse number="30" style="v" sid="LEV 26:30"/>ታኒ፥ ህንተ ቃ ጎይኖ በሳታ ይሳና፤ ህንተ እፃነ ያርሽያ በሳ ላላና። ታኒ ህንተ አሀ ህንተ ኤቃታ አሀ ቦላ ሆላና፤ ታኒ ህንተና ፖሎ እፃና። <verse eid="LEV 26:30"/><verse number="31" style="v" sid="LEV 26:31"/>ታኒ ህንተ ካታማታ ባይሳ ኦና፤ ህንተ ጎይኖ በሳታ ይሳና፤ ህንተ ሳውያ ያርሹዋ ስንግከ። <verse eid="LEV 26:31"/><verse number="32" style="v" sid="LEV 26:32"/>ታኒ ህንተ ቢታ ይሳና፤ ሄ ቢታን ደእያ ሞርከት ሄሳን ማላለታና። <verse eid="LEV 26:32"/><verse number="33" style="v" sid="LEV 26:33"/>ታኒ ህንተና ካዎተታ ግዶን ላላና፤ ህንተ ቦላ ታ ማሻ ሾዳና። ህንተ ቢታይ ባይሳታና፤ ህንተ ካታማት ላለታና። <verse eid="LEV 26:33"/><verse number="34" style="v" sid="LEV 26:34"/>ህንተ ሞርከታ ቢታን ደእያ ዎደ፥ ባይሳ ጊግድ ደእያ ህንተ ቢታይ ባ ሳምባታ ቦንቻና። ሄ ዎደ ህንተ ቢታይ ሸምፓናነ ባ ሳምባታ ቦንችሸ ኡፋይታና። <verse eid="LEV 26:34"/><verse number="35" style="v" sid="LEV 26:35"/>ህንተ ሄ ቢታን ደእያ ዎደ ሳምባታታን ደምቦና ሸምፑዋ ሀእ ባይሳ ግድዳ ዎደ ደማና።<verse eid="LEV 26:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LEV 26:36"/>ህንተ ድኤትድ ብያ ዎደ ጉየ አትዳ አሳታ ዎዛናን ያሽ የዳና፤ ጫርኮይ ቃያ ቦንጮ ግርሳይ ኤንታ ዳጋንና፤ ኤንቲ ማሻፈ ባቃትያ መላ ባቃታና፤ ኤንታ ኦንካ የደና ኩንዳና። <verse eid="LEV 26:36"/><verse number="37" style="v" sid="LEV 26:37"/>ኦንካ የደና ኦላፐ ባቃትያዳ ባቃትሸ፥ እሶይ እሱዋራ በትድ ኩንዳና። ህንተ፥ ህንተ ሞርከታ ስንን ኤቃናዉ ህንተዉ ዎልቅ ያና። <verse eid="LEV 26:37"/><verse number="38" style="v" sid="LEV 26:38"/>ካዎተታ ግዶን ህንተ ያና፤ ህንተ ሞርከታ ቢታን ህንተ ምተትድ ያና። <verse eid="LEV 26:38"/><verse number="39" style="v" sid="LEV 26:39"/>ሞርከታ ቢታን አትዳይሳት ባንታ ናጋራ ግሾነ ባንታ አዋታ ናጋራ ግሾ ግልቅድ ያና።<verse eid="LEV 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40"/>ሽን ኤንቲ ባንታ ናጋራነ ታ ቦላ ማካልድ ስኦና እፅዳ ባንታ አዋታ ናጋራ ፓፅኮ፥ <verse eid="LEV 26:40"/><verse number="41" style="v" sid="LEV 26:41"/>ታ ኤንታ እፃናዳነ ኤንታ ሞርከታ ቢታ የደናዳ ኦዳ ባንታ ናጋራ አግኮነ ኤንታ ኪተቶና ዎዛናይ ስምኮ፥ <verse eid="LEV 26:41"/><verse number="42" style="v" sid="LEV 26:42"/>ታኒ ያይቆባራ፥ ይሳቃራነ አብራሃመራ ጫቅዳ ጫቁዋ ሀሳያና፤ ኤንታ ቢታ ዛራ ቆፓና። <verse eid="LEV 26:42"/><verse number="43" style="v" sid="LEV 26:43"/>ኤንታ ቢታይ ባይሳ አታና፤ ሄ ኤንቲ ይን ባይሳ ግድድ ደእዳ ዎደን ቢታይ ሳምባታ ቦንችሸ ኡፋይታና። ኤንቲ ታ ኪታ ካዳ ግሾነ ታ ዎጋ ለቅዳ ግሾ ባንታ ናጋራ ሴራ ኤካና።<verse eid="LEV 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 26:44"/>ግዶሽን፥ ኤንቲ ባንታ ሞርከታ ቢታን ደእዳ ዎደ ኩመ ያና ጋካናዉ ኤንታራ ደእያ ታ ጫቁዋ መንከ፤ ኤንታ የግከ። ታኒ፥ ጎዳ ኤንታ ፆሳ። <verse eid="LEV 26:44"/><verse number="45" style="v" sid="LEV 26:45"/>ታኒ ኤንታ ፆሳ ግዳናዉ፥ ካዎተት ፄልሽን፥ ግብፀ ቢታፈ ከስዳ ኤንታ ማይዛታራ ታኒ ጫቅዳ ጫቁዋ ኤንታ ግሾ ሀሳያና። ታኒ ጎዳ።<verse eid="LEV 26:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46"/>ጎዳይ ሲና ዙማ ቦላ ሙሰ ባጋራ ባፐነ እስራኤለ አሳፐ ግዶን ዎዳ ዎጋት ኪታትነ ህገት ሀይሳታ።<verse eid="LEV 26:46"/></para>
  <chapter eid="LEV 26"/>
  <chapter number="27" style="c" sid="LEV 27"/>
  <para style="s1">ዎዞ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ። <verse eid="LEV 27:1"/><verse number="2" style="v" sid="LEV 27:2"/>እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ እስ አስ ጎዳስ አሰ እማናዉ ቃንግኮ፥ ዎዞ ጋትያ ነ ጋማትዳይሳ መላ ሄ ኡራ ግሾ ሚሸ ቃንፆ። <verse eid="LEV 27:2"/><verse number="3" style="v" sid="LEV 27:3"/>ላታሙ ላይፈ ብድ ኡሱፑን ታሙ ላይ ጋካናዉ ደእያ አደ ግድኮ ጌሻ ዱንካነን ኤረትዳ ምዛነን ኡሱፑን ፄቱ ብራ ሳንትመ ቃንፆ። <verse eid="LEV 27:3"/><verse number="4" style="v" sid="LEV 27:4"/>ማጫ ግድኮ ሀስታሙ ብራ ሳንትመ ቃንፆ። <verse eid="LEV 27:4"/><verse number="5" style="v" sid="LEV 27:5"/>እቻሹ ላይፈ ብድ ላታሙ ላይ ጋካናዉ ደእያ አደ ግድኮ ላታሙ ብራ ሳንትመ ቃንፆ፤ ቃስ ማጫስ ግድኮ ታሙ ብራ ሳንትመ ቃንፆ። <verse eid="LEV 27:5"/><verse number="6" style="v" sid="LEV 27:6"/>እስ አጌናፐ ብድ እቻሹ ላይ ጋካናዉ ደእያ አደ ግድኮ እቻሹ ብራ ሳንትመ ቃንፆ፤ ቃስ ማጫስ ግድኮ ሄ ብራ ሳንትመ ቃንፆ። <verse eid="LEV 27:6"/><verse number="7" style="v" sid="LEV 27:7"/>ላይ ኡሱፑን ታማነ እያፐ ቦላ ግድዳ አደ ግድኮ፥ ታማነ እቻሹ ብራ ሳንትመ፤ ቃስ ማጫስ ግድኮ ታሙ ብራ ሳንትመ ቃንፆ። <verse eid="LEV 27:7"/><verse number="8" style="v" sid="LEV 27:8"/>ቃንግዳ ኡራይ ኔኒ ጋማትዳይሳ ቃንፃናዉ ዳንዳኦና ማንቆ ግድኮ፥ እ ባ ቃንገ ጋናዉ እምዳ ኡራ ኤህድ ካህንያ ስንን ኤሶ፤ ቃንገትዳ ኡራይ ቃንፃናዉ ዳንዳኤይሳ ኬና ቆፕድ ካህነይ ጋማቶ።<verse eid="LEV 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9"/>እስ አስ ጎዳስ ያርሾ ኦድ እማናዉ ቃንግዳይ መሄ ግድኮ ጎዳስ እመትያ መሄ ኡባይ ጌሽ ግዴስ። <verse eid="LEV 27:9"/><verse number="10" style="v" sid="LEV 27:10"/>ሄ መህያ ግሾ ሀራ መሄ እሞፎ፤ ዎይኮ እያ ሀራ መሄራ ላሞፎ። ሎኡዋ ኢታራ ዎይኮ ኢታ ሎኡዋራ ላሞፎ፤ ሽን እ ላምኮ፥ ኮይሮ መሄይነ ላመ እምዳ መሄይ ናምአይካ ጌሽ ግዶ። <verse eid="LEV 27:10"/><verse number="11" style="v" sid="LEV 27:11"/>እስ አስ ጎዳስ ያርሾ ኦድ እማናዉ ገፕዳ መሄይ ጌሽ ግዶና እፅኮ፥ ሄ ኡራይ ሄ መህያ ካህንያ ስን ኤሆ። <verse eid="LEV 27:11"/><verse number="12" style="v" sid="LEV 27:12"/>ሎኦ ግድን፥ ኢታ ግድን ካህነይ ሄ መህያ ጋማቶ፤ ካህነይ ጋማትዳይስ እያዉ ጋተ ግዶ። <verse eid="LEV 27:12"/><verse number="13" style="v" sid="LEV 27:13"/>ሽን ሄ መህያ ጎዳይ ዛሪድ ዎዛናዉ ኮይኮ፥ ሄ መህያ ጋትያ ቦላ ፄታፐ ላታሙ ኩሸ ጉጆ።<verse eid="LEV 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14"/>እስ አስ ባ ኬ ጌሽ ኦድ ጎዳስ ዱማይኮ፥ ሎኦ ግድን፥ ኢታ ግድን ካህነይ ሄ ኬ ጋማቶ፤ ካህነይ ጋማትዳይስ እያዉ ጋተ ግዶ። <verse eid="LEV 27:14"/><verse number="15" style="v" sid="LEV 27:15"/>ባ ኬ ጌሽ ኦድ ጎዳስ ዱማይዳ ኡራይ ዛሪድ ዎዛናዉ ኮይኮ፥ ሄ ኬ ጋትያ ቦላ ፄታፐ ላታሙ ኩሸ ጉጆ፤ ስሚድ ኬይ እያባ ግዴስ።<verse eid="LEV 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16"/>እስ አስ ባ ላታ ጋድያፐ ሻክድ ጌሽ ኦድ ጎዳስ ዱማይኮ፥ ሄ ጋድያ ጋተይ እያን ዘረትያ ዘረን ጋማተቶ። ሄስካ ናምኡ ፄታነ ላታሙ ክሎ ግራመ ባንጋ ዘርያ ጋደ ግድኮ፥ እሻታሙ ሳቅለ ቃንፆ። <verse eid="LEV 27:16"/><verse number="17" style="v" sid="LEV 27:17"/>እ ባ ጋድያ እሻታማን ላይ ባለፐ ዶምድ ጌሽ ኦድ ጎዳስ ዱማይኮ፥ ሄ ጋድያ ኩመ ጋትያ ቃንፆ። <verse eid="LEV 27:17"/><verse number="18" style="v" sid="LEV 27:18"/>ሽን እ ባ ጋድያ እሻታማን ላይ ባለይ አን፥ ጌሽ ኦድ ጎዳስ ዱማይኮ፥ ካልድ ደእያ እሻታማን ላይ ባለይ ጋካናዉ ደእያ ላይታ ካህነይ ታይብድ፥ እያ ኩመ ጋትያፐ ዎ። <verse eid="LEV 27:18"/><verse number="19" style="v" sid="LEV 27:19"/>ሄ ጋድያ ጌሽ ኦድ ጎዳስ ዱማይዳ ኡራይ ዛሪድ ዎዛናዉ ኮይኮ፥ ጋማተትዳ ጋትያ ቦላ ፄታፐ ላታሙ ኩሸ ጉጆ፤ ስሚድ ጋደይ እያባ ግዴስ። <verse eid="LEV 27:19"/><verse number="20" style="v" sid="LEV 27:20"/>ሽን እ ጋድያ ዛሪድ ዎዛናፐ ስን ሀራ አሳስ ባይዝኮ፥ ሄ ጋድያ ዎዛናዉ ዳንዳኤና። <verse eid="LEV 27:20"/><verse number="21" style="v" sid="LEV 27:21"/>እሻታማን ላይ ባለይ ጋክን ጋደይ የደትያ ዎደ ሄ ጋደይ ናምአን ጉየ ስሞና ጎዳስ ጌሽ ግዶ፤ ሄ ጋደይ ካህነታባ ግዴስ።<verse eid="LEV 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 27:22"/>እስ አስ ሀራ አሳፐ ሻምዳ ጋድያ ጌሽ ኦድ ጎዳስ ዱማያናዉ ኮይኮ፥ <verse eid="LEV 27:22"/><verse number="23" style="v" sid="LEV 27:23"/>ካልያ እሻታማን ላይ ባለይ ጋካናዉ ደእያ ጋትያ ካህነይ ጋማትኮ፥ ኡራይ ሄ ጋላስ ጋማትዳ ጋትያ ቃንፆ፤ ሄ ሚሸይ ጎዳስ ዱማትዳ ሚሸ ግዳና። <verse eid="LEV 27:23"/><verse number="24" style="v" sid="LEV 27:24"/>እሻታማን ላይ ባለይ ጋክያ ዎደ ሄ ጋደይ ኮይሮ ላታን ኤክድ ባይዝዳ ኡራስ ስሜስ።<verse eid="LEV 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 27:25"/>ኤንታ ጋተይ ጌሻ ዱንካንያን ኤረትዳ ምዛነን ጋማተቴስ። (እስ ሳቅለይ ላታሙ ጌራ ግዴስ)።<verse eid="LEV 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26"/>ሽን ኦንካ ባይራ የለትዳ መሄ ጎዳስ ዱማይድ ሺሻናዉ ዳንዳኤና፤ እ ካሰካ ጎዳባ። ሚዝ ዎይኮ ዶርሰ ግድን ጎዳባ። <verse eid="LEV 27:26"/><verse number="27" style="v" sid="LEV 27:27"/>ሄ መሄይ ጌሽ ግዶና እፅኮ፥ እ ጋማተትዳ ጋትያ ቦላ እቻሻፐ እስ ኩሸ ጉጅድ እያ ጎዳይ ዛሪድ ዎዞ። እ ዎዞና እፅኮ፥ ጋማተትዳ ጋትያን ሀራ አሳስ ባይዘቶ።<verse eid="LEV 27:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28"/>እስ አስ ጎዳስ ዱማይድ እምዳባይ አይባ ግድኮካ፥ አሰ ዎይኮ መሄ ዎይኮ እያ ላታ ጋደ ግድን፥ ባይዘተናነ ዎዘተና። እ ዱማይዳባ ኡባይ ጎዳስ ኡባፈ ጌሽ። <verse eid="LEV 27:28"/><verse number="29" style="v" sid="LEV 27:29"/>አሳ ግዶፈ ሀይቃና መላ ፕርደትዳ አስ ኦንካ ዎዘቶፎ፤ ሄ ኡራይ ሀይቆ።<verse eid="LEV 27:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30"/>ጋደን ካፅዳ ካ ዎይኮ ም አይፈ ግድን ታማፈ እሶይ ጎዳባ። ሄስ ጎዳስ ጌሽ። <verse eid="LEV 27:30"/><verse number="31" style="v" sid="LEV 27:31"/>እስ አስ ባ አስራታ ዎዛናዉ ኮይኮ፥ እያ ጋትያ ቦላ ፄታፐ ላታሙ ኩሸ ጉጅድ ዎዞ። <verse eid="LEV 27:31"/><verse number="32" style="v" sid="LEV 27:32"/>ሚዛ አስራታ ዎይኮ ዶርሳ አስራታ ዎይኮ ዴሻ አስራታ ግድን፥ ሄንንቹዋ ፃምአፈ ጋርሳራ አያ ታማፈ እሶይ ጎዳስ ጌሽ። <verse eid="LEV 27:32"/><verse number="33" style="v" sid="LEV 27:33"/>ታማን መሄይ ኢታ ግድን፥ ሎኦ ግድን ዶሮፖ፤ ዎይኮ እያ ሀራራ ላሞፎ። ላምኮ፥ ኮይሮይነ ላመ እምዳ ናምአይ ጎዳስ ጌሽ ግዶሶና፤ ዛሪድ ዎዛናዉ ዳንዳኤተና።<verse eid="LEV 27:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 27:34"/>ሲና ዙማ ቦላ ጎዳይ ሙሰ ባጋራ እስራኤለ አሳ ኪትዳ ኪታይ ሀይሳ።<verse eid="LEV 27:34"/></para>
  <chapter eid="LEV 27"/>
</usx>
