<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ያይቆባ ኪታ</para>
  <para style="toc1">ያይቆባ ኪታ</para>
  <para style="toc3">ያይ</para>
  <para style="toc2">ያይቆባ</para>
  <para style="mt">ያይቆብ ፃፍዳ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ያይቆባ ኪታይ፥ አማንያ አስ ጋላስ ጋላስ ባ ደኡዋ ካለያ ቆፋታ ኦይክስ። ሀ ኪታይ ፃፈትዳይ፥ ቢታ ኡባን ላለትዳ ታማነ ናምኡ አይሁደ ኮቻታሳ። ሀ ማፃፋ ፃፈይ፥ ጭንጫተ ኑኒ ኦሶን ፔሽያ ኦገ በሴስ፤ አማንያ አስ ሞኮባነ ሎኦ ካንዶስ ኦገ በሲያ ኦዳታ ምስለዳ ቆንጭሴስ።</para>
  <para style="ip">ያይቆባ ኪታይ፥ ማንቆተባ፥ ዱረተባ፥ ፓጨባ፥ ሎኦ ካንዶባ፥ ቃናተባ፥ አማኖባ፥ ሎኦ ኦሶባ፥ እንፃርስ ሃሮባ፥ ጭንጫተባ፥ ኦሻባ፥ ኦቶሮባ፥ አሽከተባ፥ ሀራ አሳ ቦላ ፕርዶባ፥ ጬቀተባ፥ ገንጫባ፥ ዎሳባነ አማንያ አስ ኦናዉ በሲያባ ኡባ ቆርድ በሴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሳሮ (<char style="ior"><ref loc="JAS 1:1">1:1</ref></char>)</para>
  <para style="io1">አማኖነ ጭንጫተ (<char style="ior"><ref loc="JAS 1:2-18">1:2-18</ref></char>)</para>
  <para style="io1">ስስነ ኪተተ (<char style="ior"><ref loc="JAS 1:19-27">1:19-27</ref></char>)</para>
  <para style="io1">ማንቆተነ ዱረተ (<char style="ior"><ref loc="JAS 2:1-13">2:1-13</ref></char>)</para>
  <para style="io1">አማኖነ ኦሶ (<char style="ior"><ref loc="JAS 2:14-26">2:14-26</ref></char>)</para>
  <para style="io1">ጭንጫተነ እንፃርስ ሃሮባ (<char style="ior"><ref loc="JAS 3:1-18">3:1-18</ref></char>)</para>
  <para style="io1">ሀ አላምያራ ዳቦተ መፋ (<char style="ior"><ref loc="JAS 4:1-5:6">4:1—5:6</ref></char>)</para>
  <para style="io1">ዳንዳአ፥ ኬሀተነ ዎሳ (<char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref></char>)</para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ፆሳነ ጎዳ የሱስ ክርስቶሳ አይለይ፥ ያይቆብ፥ ቢታ ኡባን ላለትዳ ታማነ ናምኡ ሼሻታስ ኪትዳ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ 13:55</ref>፤ <ref loc="MRK 6:3">ማር 6:3</ref>፤ <ref loc="ACT 15:13">ሀዋ 15:13</ref>፤ <ref loc="GAL 1:19">ጋላ 1:19</ref>.</char></note></para>
  <para style="p" vid="JAS 1:1">ሳሮ፥ አይ መላ ደኤቲ?<verse eid="JAS 1:1"/></para>
  <para style="s1">አማኖነ ጭንጫተ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>ታ እሻቶ፥ ህንተና ዱማ ዱማ ፓጨይ ጋክያ ዎደ ህንተ ሎኦባ ደምዳዳ ኩመ ኡፋይሳን ኤክተ። <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>ህንተ አማኑዋ ፓጨተይ ዳንዳአ ህንተዉ እመይሳ ኤሬታ። <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>ህንተ ዉርሰ ጋካናዉ ዳንዳእኮ አይብ ፓጨይ ባይና ፖሎነ ኩመ ግደታ። <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>ህንተፈ ኦደስካ ጭንጫተ ይኮ ፆሳ ዎሶ። እያዉ እመታና። ፆሳይ ኦናካ ቦሮና ኡባስ ኬሀተን እምያ ፆሰ። <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>ሽን እ ዎስያ ዎደ ስና አማኖን ፆሳ ዎሶ። ስያ ኦንካ ጫርኮይ ሱግን ቃፅያ አባ ዙለ መላ። <verse eid="JAS 1:6"/><verse number="7-8" style="v" sid="JAS 1:7-8"/>ናምኡ ቆፍ ደኤይነ ባ ኦግያን ኤቆና ኦንካ ጎዳፐ አይኮካ ደማና ግድ ቆፖፎ።<verse eid="JAS 1:7-8"/></para>
  <para style="s1">ማንቆ አስነ ዱረ አስ</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>አማንያ ማንቆ አሳት፥ ፆሳይ ኤንታና ቁ ኦያ ዎደ ኡፋይቶ። <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>ቃስ አማንያ ዱረ አሳት ፆሳይ ኤንታና ዝቅ ኦያ ዎደ ኡፋይቶ። ዱረ አሳት ጪሻዳ ያና።<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">እሳ 40:6-7</ref>.</char></note> <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>አዋይ ባ ምሻራ ከይድ ማታ መልስን፥ ጪሻይ ቆለቴስ፤ እያ ሎኦተይካ ዬስ። ሄሳዳካ፥ ዱረ አሳት ባንታ ኦሱዋን ዳቡርሸ ያና።<verse eid="JAS 1:11"/></para>
  <para style="s1">አሰ ጋክያ ፓጨ</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>መቱዋ ፆንድ አዳፐ ጉየ፥ ፆሳይ ባና ሲቀይሳታስ እማና ግድ ቃላ ገልዳ ደኦ ካላቻ ኤካና ግሾ፥ መቶን ገንጭያ አስ አንጀትዳይሳ። <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>ኦንካ ፓጨትያ ዎደ፥ “ታና ፆሳይ ፓጬስ” ጎፖ። ፆሳይ ኢታን ፓጨተና፤ ቃስ እ ኦናካ ፓጨና። <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>ሽን እስ እስ አስ ባ ኢታ አሙዋን ጎሸትያ ዎደነ ጭመትያ ዎደ ፓጨቴስ። <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ሄሳፈ ጉየ፥ አሞተ ቃንትድ ናጋራ የሌስ፤ ቃስ ናጋር ድጭድ ሀይቆ የሌስ።<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ታ ሲቆ እሻቶ፥ ጭመቶፍተ። <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ሎኦ እሞይነ ኩመ አንጆ ኡባይ ሳሎፐነ ሳሉዋ ፖኡዋ መዳ ፆሳ አዋፐ ዬስ። ፆሳይ ኩያዳ ኡባ ዎደ ላመተና። <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ኑኒ፥ እያ መተስ ኮይሮ ግዳና መላ ኑና ቱማ ቃላን ባ ሸነን የልስ።<verse eid="JAS 1:18"/></para>
  <para style="s1">ስስነ ኦሶ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ታ ሲቆ እሻቶ፥ ሀይሳ አኬክተ። አስ ኡባይ ስአናዉ ኤለሶ፥ ሽን ኦደታናዉነ ሀንቀታናዉ ኤለሶፖ። <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>አሳ ሀንቆይ ፆሳይ ኮይያ ፅሎተ ኤሄና። <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>ሄሳ ግሾ፥ ቱና ሀኖታነ ኢታተ ኡባ ድግድ፥ ፆሳይ ህንተ ዎዛናን ቶክዳ ህንተ ሸምፑዋ አሻናዉ ዳንዳእያ ቃላ አዳተን ኤክተ።<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>ሽን ፆሳ ቃላ ኦሶን ፔሽተፐ አትሽን፥ ስሳ ፃላላን ህንተና ጭሞፍተ። <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ቃላ ስእድ ኦና አስ፥ እ ባ ሶምኡዋ ማስቶተን በእያ አሳ መላ። <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>እ ባ ሶምኡዋ በእድ ቤስ፥ ሽን እ አይ ዳንያኮ ኤለስ ዶጌስ። <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>ሽን ኦንካ አይለተፈ ከስያ ፖሎ ህግያ አኬካን በእድ፥ ካልድ ናገይ፥ ስእዳይሳ ዶጎና ኦሶን ፔሽያ ኡራይ፥ ባ ኦሶ ኡባን አንጀታና።<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>ባ እንፃርሳ ናጎና አማናይስ ግያ ኡራይ ባና ጭሜስ፤ እያ አማኖይ ሀዳ። <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>ፆሳ አዋ ስንን ቦረይ ባይና ጌሻ አማኖይ ሀይሳ፦ አይያ አዉ ባይና ናይታነ አምኤታ ማዶነ አላምያ ቱናፐ ባና ናጎ።<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">አሰ ሻኮፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>ታ እሻቶ፥ ህንተ ኑ ቦንቾ ጎዳ የሱስ ክርስቶሳ አማንያባ ግድኮ፥ አሳ ሶምኦ ፄልድ አሰ ቦንቾፍተ። <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>ሌምሶስ፥ ዎርቃ ምግዶ አድ፥ ሎኦ ማኦ ማእዳ ዱረ አስ ህንተ ሺቁዋ ይስ። ቃስ ጩርቃ ማኦ ማእዳ ማንቆ አስካ ይስ። <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>ሎኦ ማኦ ማእዳ አድያ ህንተ አድ ቦንችድ፥ “ነ ሀይሳን ሎእያ ኦይድያን ኡታ” ግድ፥ ቃስ ማንቆ አድያ፥ “ነ ያን ኤቃ ዎይኮ ሀይሳን ታ ቶሁዋ ማታን ሳአን ኡታ” ጌታ። <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>ያትን፥ ህንተ፥ ህንተ ግዶን ሻከተ መይሳታነ ኢታ ቆፋራ ደእያ ዳይናታ መላ ግደከትዬ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ታ ሲቆ እሻቶ፥ ስእተ። አማኖን ዱረ ግዳና መላነ ባና ሲቀይሳታስ እማና ግዳ ሳሎ ካዎተ ላታና መላ ሀ ሳአን ደእያ ማንቆታ ፆሳይ ዶርበነዬ? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>ሽን ህንተ ማንቆታ ቶቸታ። ህንተና ኡንኤይሳት ዱረታ ግዶኮናዬ? ህንተና ዳይና ስን ጎቸይሳት ኤንታ ግዶኮናዬ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>ህንተ ፄገትዳ ሎኦ ጎዳ ሱን ጫየይሳት ኤንታ ግዶኮናዬ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>ሽን ጌሻ ማፃፋን፥ “አሰ ኡባ ነና ነ ዶሰይሳዳ ዶሳ” ጌተትድ ፃፈትዳ ፆሳ ካዎተ ህግያ ህንተ ፖልኮ ሎኦ ኦታ።<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌወ 19:18</ref>.</char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>ሽን ህንተ አሳ ሶምኦ ፄልድ ቦንችኮ፥ ናጋራ ኦታ ቃስ ህገይ ህንተና ህገ መንዳ አሳዳ ፕርዳና። <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>ኦንካ ህገ ኡባፈ እሱዋ መንድ፥ አትዳ ኡባ ናግኮ ኡባ መንዳዳ ታይበቴስ። <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>“ላሞፋ” ግዳ ጎዳይ፥ ቃስ “ዎፓ” ግስ። ሽን ኔኒ ላሞና አጋዳ ዎዳባ ግድኮ፥ ህግያ መንዳሳ።<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">ከሳ 20:13-14</ref>፤ <ref loc="DEU 5:17-18">ዛረ 5:17-18</ref>.</char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>አይለተፈ ከስያ ህግያ ስንን ፕርዳ ኤካናዉ ደእያ አሳዳ ኦደትተነ ኦተ። <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>አሰ ማሮና ኦናካ ፆሳይ ማሮና ፕርዳና። ሽን ማሮተይ ፕርዳ ፆኔስ።<verse eid="JAS 2:13"/></para>
  <para style="s1">አማኖነ ኦሶ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>ታ እሻቶ፥ ህንተፈ እስ አስ ታዉ አማኖይ ደኤስ ግድ፥ ባ አማኑዋ ኦሶን በሶና እፅኮ እያ አይ ማዳኔ? እያ አማኖይ እያ አሻናዉ ዳንዳኢ? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>ሌምሶስ እስ እሻይ ዎይኮ እስ ምችያ ካሎትኮነ ኤንታዉ ምያባይ ይኮ፥ <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>ህንተፈ እስ አስ ኤንታኮ፥ “ሳሮ ቢተ! ታማ ካይተ! ካልድ ሚተ!” ግድ፥ ኮሽያባ ኤንታዉ እሞና እፅኮ ኤንታ አይ ማዲ? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>ሄሳ ግሾ፥ ኦሶይ ባይና አማኖይ ባርካ ሀይቅዳይሳ።<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>ሽን እስ አስ፥ “ነዉ አማኖይ ደኤስ፤ ቃስ ታዉ ኦሶይ ደኤስ። ኔኒ ነ አማኑዋ ነ ኦሱዋፐ ሻካዳ ታና በሳ፤ ታካ ታ አማኑዋ ታ ኦሱዋን ነና በሳና” ጋና። <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>ኔኒ፥ እስ ፆሳይ ደኤይሳ አማናሳ፤ ሄስ ሎኦ። ቱና አያናትካ አማኖሶና፤ ያሻን ኮኮሮሶና። <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>ነኖ ኤያዉ! አማኖይ ኦሶፐ ሻከትድ ማዶናይሳ ኤራናዉ ኮያይ? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>ኑ አዋ አብራሃመይ፥ ባ ናኣ ይሳቃ ያርሾ በሳ ቦላ ዎዳ ዎደ ባ ኦሱዋን ፅልቤኔ?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">መ 22:1-14</ref>.</char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>እያ አማኖይነ እያ ኦሶይ እስፈ ኦዳይሳ በእኪ? እያ አማኖይ እያ ኦሱዋን ፖለትስ። <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>ጌሻ ማፃፋይ፥ “አብራሃመይ ፆሳ አማንስ። ፆሳይ ሄሳ እያዉ ፅሎተ ኦድ ታይብስ” ግዳይስ ፖለትስ። ቃስ እ ፆሳ ዳቦ ጌተትድ ፄገትስ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">መ 15:6</ref>፤ <ref loc="2CH 20:7">2 ታር 20:7</ref>፤ <ref loc="ISA 41:8">እሳ 41:8</ref>.</char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>አስ አማኖ ፃላላን ግዶናሽን፥ ኦሶን ፅለይሳ በኣሳ።<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>ሄሳዳካ፥ ላይምያ ራኣባ እስራኤለፐ ኪተትዳይሳታ ሞካዳ ሀራ ኦገራ ኤንታ ሞይዝዳ ዎደ ባ ኦሱዋን ፅላቤኬ?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">እያ 2:1-21</ref>.</char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>ሸምፖይ ሻከትዳ አሳተይ ሀይቆ ግደይሳዳ፥ ኦሶይ ሻከትዳ አማኖይካ ሀይቅዳይሳ።<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">ነ እንፃርሳ ናጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>ታ እሻቶ፥ ህንተፈ ዳሮት አስታማረ ግዶፖ። ኑ፥ አስታማረት ሀራታፐ አያ ፕርዳ ኤካናይሳ ህንተ ኤሬታ። <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ኑ ኡባይ ዳሮባን ባለቶስ። ባ ኦዳን ባለቶና ኦንካ ባናተ ናጋናዉ ዳንዳእያ ፖሎ አስ። <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>ፓራት ኑስ ኪተታና መላ ብፃላ ባርስድ ኑኒ ኮይያ በሲ ኡባ ኤፎስ። <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ማርካበይ ሄሳ መላ ግታ ግድሸ ዎልቃማ ጫርኩዋን ሱገትኮካ፥ ኤንታ ላገይስ ባ ኮይያ በሲ ዛሪድ ላግያ ጉ ምን ላገትድ ቤስ። <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>ሄሳዳ እንፃርስ አሳተ ግዶን ጉ ግድኮካ ዳሮ ግታባን ጬቀቴስ።</para>
  <para style="p" vid="JAS 3:5">ጉ ታም ዳሮ ግታ ዎራ ፁጌስ። <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>እንፃርስ ታማ መላ። እንፃርስ ኑ አሳተ ግዶን ኢታን ኩምዳ አላመ፤ አሳተ ኡባ ቱንሴስ። ጋናመፐ ከይያ ታማዳ ኑ ደኡዋ ዎ ኡባ ፁጌስ። <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>ዶአታነ ካፎታ፥ ኡሎራ ጎሸተይሳታነ አባን ደእያ መተታ ኡባ አስ ሃሬስ፤ ኤንትካ ሃረትዶሶና። <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>ሽን ኦንካ እንፃርስ ሃራናዉ ዳንዳእቤና። እንፃርስ ዎያ ማርዘይ ኩምዳ ሃረቶና ኢታ መተ። <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>ኑ እንፃርሳን፥ ኑ፥ ጎዳነ ፆሳ ጋላቶስ። ቃስ እያራ ፆሳ ሌምሶን መትዳ አሳ ባዶስ። <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>እስ ዶናፐ ጋላትነ ባደ ከዬስ። ታ እሻቶ፥ ሄሳዳ ሀናናዉ በሰና።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">መ 1:26</ref>.</char></note> <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>ፑልቶይ እስ ኦላፈ ማልእያ ሃነ ጫምያ ሃ ፑልታናዉ ዳንዳኢ? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>ታ እሻቶ፥ ባላሰ ም ሻማሆ አይፋናዉ ዳንዳኢ? ዎይኮ ዎይነ ም ባላሰ ም አይፈ አይፋናዉ ዳንዳኢ? ጫሞ ሃፈ ማልኦ ሃ ከያናዉ ዳንዳኤና።<verse eid="JAS 3:12"/></para>
  <para style="s1">ሳሎ ጭንጫተነ ሳአ ጭንጫተ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>ህንተ ግዶን ጭንጭነ አኬካንቾይ ኦኔ? ባ ሎኦ ደኡዋ፥ አሽከተንነ ጭንጫተን ኦሰትዳ ኦሶን በሶ። <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>ሽን ህንተ ዎዛናን ጫምያ ቅናተይነ ባና ዶሶይ ደእኮ ጬቀቶፍተ፤ ቱማ ቦላ ዎርዶቶፕተ። <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>ሄሳ መላ ጭንጫተይ ሳሎፐ ይዳባ ግዶናሽን፥ ሄስ አሳባ፥ አላመባ፥ ፃላሄባ። <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>ቅናተይነ ባና ዶሶይ ደእያ ሶን ኦሽነ ኢታ ኦሶ ኡባይ ደኦሶና። <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>ሽን ቦላፈ ያ ጭንጫተይ ኡባፈ ስን ጌሽ። ቃስ ሳሮተ፥ አዳተ፥ ስእድ ኤከይሳ፥ ቃተይሳ፥ ሎኦ አይፈይ ኩምዳይሳ፥ አሰ ሻኮናይሳነ ጩቦተ ባይናይሳ። <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>ሳሮተ ዶሰይሳት ሳሮተ ዘርድ ፅሎተ ቡጮሶና።<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">አላምያራ ዳቦቶፕተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>ኦሽነ ኦል ህንተ ግዶ አዉፐ ዪ? ኤንቲ የይ ህንተ አሳተ ሃራናዉ ኦለትያ ህንተ አሾ አሙዋፐ ግደነዬ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>ህንተ አሞቴታ፥ ሽን ደመከታ፤ ሄሳ ግሾ፥ ዎታ። ምን ኮዬታ፥ ሽን ደማናዉ ዳንዳኤከታ፤ ሄሳ ግሾ፥ ኦየቴታነ ኦለቴታ። ህንተ ፆሳ ዎሶና ግሾ ኮያባ ደመከታ። <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>ህንተ ዎሰታ፥ ሽን ደመከታ። ህንተ አሾ አሙዋ ፖላናዉ ዎበ ኦገን ዎስያ ግሾ ደመከታ። <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>ህንተኖ፥ ላይማተይሳቶ! ሀ አላምያ ዶሰይ ፆሳራ ሞርከ ግደይሳ ኤረከቲ? ሀ አላምያራ ዳቦታናዉ ኮየይ ኦንካ ፆሳራ ሞርከ። <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ጌሻ ማፃፋይ፥ “ፆሳይ ኑናን ዳና መላ ኦዳ አያናይ፥ ኑኒ እያዉ ቡዞ ግዳና መላ አሞቴስ” ግዳይሳ ጮ ግዳባ ዳኒ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>ሽን ጌሻ ማፃፋይ፥ “ፆሳይ ኦቶራንቾታ እፄስ፥ ሽን አሽከታስ ማሮተ እሜስ” ግያ ግሾ፥ ፆሳይ ማሮተ ዳርስድ እሜስ።<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ሌም 3:34</ref>.</char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>ሄሳ ግሾ፥ ፆሳስ ሃረትተ፤ ፃላህያራ ኤቀትተ፤ እ ህንተፈ ሃካና። <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>ፆሳኮ ሺቅተ፤ እ ህንተኮ ሺቃና። ህንተኖ፥ ናጋራንቾቶ፥ ህንተ ኩሽያ ሜጨትተ፤ ናምኡ ቆፍ ደኤይሳቶ፥ ህንተ ዎዛና ጌሽተ። <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>ካዮትተ፥ ዬክተነ አፉፅተ። ህንተ ሚቻይ ዬሆን፥ ህንተ ኡፋይሳይ አዛኖን ላመቶ። <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ጎዳ ስንን ህንተናተ ካዉሽተ፤ ህንተና ቁ ቁ ኦና።<verse eid="JAS 4:10"/></para>
  <para style="s1">አሳ ቦላ ፕርዶፍተ</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>ታ እሻቶ፥ እሶይ እሱዋ ዝግሮፕተ። ባ እሻ ዝግረይነ እያ ቦላ ፕርደይ ህገ ዝግረስነ ህገ ቦላ ፕርዴስ። ኔኒ ህገ ቦላ ፕርድኮ ህገ ቦላ ፕርደይሳ ግዳሳፐ አትሽን፥ ህገ ፖለይሳ ግዳካ። <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ህገ እመይነ ፕርደይ ፆሳ ፃላላ። አሻናዉነ ይሳናዉ ዳንዳኤይ እያ። ያትን፥ ነ አሳ ቦላ ፕርደይ ኔኒ ኦኔ?<verse eid="JAS 4:12"/></para>
  <para style="s1">ጬቀቶፍተ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>ህንተ፥ “ኑኒ ሀች ዎይኮ ዎንቶ ያ ካታማ ዎይኮ ሀ ካታማ ባና፤ ያን ላይ ኡታና፤ ዛልእድ ዎሳና” ያገይሳቶ፥ ስእተ።<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="PRO 27:1">ሌም 27:1</ref>.</char></note> <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>ዎንቶ አይብ ሀናኔኮ ህንተ ኤረከታ። ህንተ ደኦይ ዋናነኮ ኤረይ ኦኔ? ህንተ ጉ ዎደ በንትድ ይያ አካ መላ። <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ሄሳ አግድ፥ “ጎዳይ ጊኮ ኑኒ ዳና፤ ሀይሳ ዎይኮ ሄሳ ኦና” ያጋናዉ በሴስ። <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>ሽን ህንተ ሀእ ኦቶርተታነ ጬቀተታ። ሄሳ መላ ጬቆ ኡባይ ኢታ።<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>ሄሳ ግሾ፥ ሎኦባ ኦናዉ ኤርሸ ኦና ኡራስ ሄስ ናጋራ።<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">ዱረታስ እመትዳ ዞረ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ህንተኖ፥ ዱረቶ፥ ህንተ ቦላ ኢታ መቶይ ያ ግሾ ዬክተነ ዘሌልተ። <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>ህንተ ሻሎይ ቡቅስ፤ ህንተ አፍላይካ ብላን ሜተትስ።<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 6:19">ማቶ 6:19</ref>.</char></note> <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>ህንተ ዎርቃይነ ህንተ ብራይ ሽእስ። ሄ ሽአይ ህንተ ቦላ ማርካ ግዳና። እ ህንተ አሳተ ታማዳ ማና። ህንተ ሀ ዉርዳ ቃማታን ህንተዉ ሻሎ ዳጋዬታ። <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>ህንተ ጋደን ኦ ፔእዳ አሳ ኡነ ሚሽያ ቃንፅበከታ። ሄስ ህንተ ቦላ ዋሴስ። ሄ አሳታ ዋሶይ ዎልቃማ ጎዳ ሀይን ስኤትስ።<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">ዛረ 24:14-15</ref>.</char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>ሀ ሳአን ህንተ ኡሎ ፃላላስ ቆፕድ፥ እንጀን ደእደታ። ሹካስ ጊገትዳ መሄዳ ህንተና ክደታ። <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>ህንተራ ኤቀታናዉ ዳንዳኦና ፅሎ አሳ ቦላ ፕርድደታ እያ ዎደታ።<verse eid="JAS 5:6"/></para>
  <para style="s1">ገንጫነ ዎሳ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>ታ እሻቶ፥ ጎዳይ ያና ጋካናዉ ገንጭተ። ጎሻንቾይ ቶርቸ እራይነ ስላ እራይ ያና ጋካናዉ ገንጭድ አልኦ ካ ናግድ ዋት ጋ ኤክያኮ ቆፕተ። <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>ሄ ጎሻንቹዋዳ ህንተካ ገንጭተ። ጎዳ ዩሳይ ማታትዳ ግሾ ኡፋይሳን ናግተ።<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>ታ እሻቶ፥ ፆሳይ ህንተ ቦላ ፕርዶና መላ እሶይ እሱዋ ቦላ ዙዙሞፍተ። ፕርደይስ ፐንገን ኤቅስ። <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>ታ እሻቶ፥ ዋያን ገንጭዳ፥ ጎዳ ሱንን ኦድዳ ናበታ ሌምሶ ኦድ ኤክተ። <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>ዳንዳአን ገንጭዳይሳታ ኑኒ አንጀትዳይሳታ ጎስ። እዮብ ዋንድ ገንጭዳኮ ህንተ ስእደታ። ጎዳይ ዉርሰን እያ ዋት ማድዳኮ በእደታ። እ ማሮትነ ቃይ ኩምዳ ጎዳ ግድያ ግሾ ሄሳ ኦስ።<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">እዮ 1:21-22</ref>፤ <ref loc="JOB 2:10">2:10</ref>፤ <ref loc="PSA 103:8">ማዝ 103:8</ref>.</char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>ሽን ኡባፈ ስን፥ ታ እሻቶ፥ ሳሉዋን ግድን ዎይኮ ሳአን ግድን ዎይኮ ሀራ አይብንካ ጫቆፍተ። ፆሳ ፕርዳን ህንተ ገሎናዳ ህንተ ኦዳይ ኤ ግድኮ፥ “ኤ” ጊተ፤ አካይ ግድኮ፥ “አካይ” ጊተ።<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">ማቶ 5:34-37</ref>.</char></note><verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>ህንተ ግዶን መቶ ኤክያ ኦንካ ደእኮ ፆሳ ዎሶ። ኡፋይትያ ኦንካ ደእኮ ጋላታን የፆ። <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>ህንተፈ ሀርገትያ ኦንካ ደእኮ ዎሳ ኬ ጭማታ ፄጎ። ኤንቲ ጎዳ ሱንን ሻማሆ ዛይተ ትይድ እያዉ ፆሳ ዎሶ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">ማቶ 5:34-37</ref>.</char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>አማኖን ዎስዳ ዎሳይ ሀርጋንቹዋ ፓና። ጎዳይ እያ፥ ሀርግያፈ ደንና፤ እ ናጋራ ኦዳባ ግድኮካ ጎዳይ እያ ማራና። <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ሄሳ ግሾ፥ ህንተ ፓፃና መላ ህንተ ናጋራ እሶይ እሱዋስ ፓፅተነ እሶይ እሱዋስ ዎስተ። ፅሎ አሳ ዎሳይ ዎልቃማ ኦሶ ኦስ። <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>ኤልያስ ኑ መላ አሰ። እር ሳአን ቡኮና መላ ምንድ ፆሳ ዎስን ሄ ላይነ ኡሱፑን አጌና ሳአን እር ቡክቤና።<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ካዎ 17:1</ref>፤ <ref loc="1KI 18:1">18:1</ref>.</char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>ዛሪድ እ ፆሳ ዎስን ሳሎፐ እር ቡክስ፤ ሳእካ ካ ዶልሰስ።<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 ካዎ 18:42-45</ref>.</char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>ታ እሻቶ፥ ህንተፈ ኦንካ ቱማ ኦግያፐ ቡትኮ፥ ሀራይ እያ ቱማኮ ዛርኮ፥ <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>ናጋራንቹዋ እያ ባላ ኦግያፐ ዛርያ ኦንካ፥ እያ ሸምፑዋ ሀይቆፐ አሸይሳነ እያ ዳሮ ናጋራስ ማሮታ እመይሳ ኤሮ።<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ሌም 10:12</ref>፤ <ref loc="1PE 4:8">1 ጰፅ 4:8</ref>.</char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
