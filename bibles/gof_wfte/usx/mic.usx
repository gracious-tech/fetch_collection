<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MIC" style="id">id MIC - GOOFA FULL BIBLE</book>
  <para style="h">ምክያሳ ማፃፋ</para>
  <para style="toc1">ምክያሳ ማፃፋ</para>
  <para style="toc3">ምክ</para>
  <para style="toc2">ምክያሳ</para>
  <para style="mt">ምክያሳ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ናበይ ምክያስ፥ ይሁዳ ቢታን ደእያ ሞረሴት-ጋተ ጌተትያ ጉታ አሰ (<char style="xt"><ref loc="MIC 1:1">1:1</ref></char>)። እ እሳያስነ (<char style="xt"><ref loc="ISA 1:1">እሳ 1:1</ref></char>)፥ ሆሰይ (<char style="xt"><ref loc="HOS 1:1">ሆሰ 1:1</ref></char>) ደእዳ ዎደን ደእስ። እያ ኪታይ እሳያሳ ሸምፖ 1-39 ጋካናዉ ደእያ ክፍልያራ ቆፋን ማቴስ። እሳያሳዳ፥ ምክያስካ ሌምሶ ኦዳታ ዳሮ ጎኤትስ (<char style="xt"><ref loc="MIC 1:1-5">1:1-5</ref>፤ <ref loc="MIC 2:4">2:4</ref>፥ <ref loc="MIC 2:6">6</ref>፥ <ref loc="MIC 2:11">11</ref>፤ <ref loc="MIC 3:2-3">3:2-3</ref>፤ <ref loc="MIC 4:3-4">4:3-4</ref>፥ <ref loc="MIC 4:12-13">12-13</ref></char>)።</para>
  <para style="ip">ምክያስ ክ.የ.ስ. 740-710 ላይ ጋካናዉ ደእያ ዎደታን፥ ሄስካ ይሁዳ ካዎታ እዮአታማ፥ አካዛነ ህዝቅያሳ ዎደን ትንብተ ኦድስ (ሸም 1:1)። እ፥ ሳማረይ ኩንዳናፐ ስን እስራኤለስነ ይሁዳስ፥ ናምኣስ ትንብተ ኦድስ (<char style="xt"><ref loc="MIC 1:5-7">1:5-7</ref></char>)። ህዝቅያሳ ካዎተ ዎደ፥ አሶረይ፥ እስራኤለ ይስያ ዎደነ ጎዳይ የሩሳላመ ማላልስያ ኦገን አሽያ ዎደ ምክያስ ደኤስ (<char style="xt"><ref loc="2KI 15-20">2 ካዎ 15—20</ref>፤ <ref loc="ISA 36-39">እሳ 36—39</ref>፤ <ref loc="2CH 27-32">2 ታር 27—32</ref></char>)።</para>
  <para style="ip">ምክያስ፥ ፆሳ ኪታ አሳስ ኦዴስ (<char style="xt"><ref loc="MIC 3:8">3:8</ref></char>)፤ ሳማረነ የሩሳላመ ኤንታ ናጋራ ግሾ ሞቴስ (<char style="xt"><ref loc="MIC 1:2-7">1:2-7</ref></char>)። ሄ ናጋራት፥ ላይማተ (<char style="xt"><ref loc="MIC 1:7">1:7</ref>፤ <ref loc="MIC 5:12-14">5:12-14</ref></char>)፤ አሳ ቢታ ቦንቀ (<char style="xt"><ref loc="MIC 2:2">2:2</ref>፥ <ref loc="MIC 2:9">9</ref></char>)፤ ቢታ አይሰይሳት፥ ሀይማኖተ ካለይሳት፥ ናበትነ ዛልአንቾት፥ ፅሎተ ይስዶሶና፤ ዎፈ ኤኮሶና፤ አሳ ቆሆሶናነ፤ ዱማ ገነ ኦሶና (<char style="xt"><ref loc="MIC 3:1-3">3:1-3</ref>፤ <ref loc="MIC 7:3">7:3</ref>፥ <ref loc="MIC 7:5-7">5-7</ref>፥ <ref loc="MIC 7:11">11</ref>፤ <ref loc="MIC 6:6-7">6:6-7</ref>፥ <ref loc="MIC 6:10-12">10-12</ref></char>)።</para>
  <para style="ip">ሄሳ ግሾ፥ ፆሲ እስራኤለ አሳ ፕርዳናዉ አሶረነ ባብሎነ (<char style="xt"><ref loc="MIC 4:10">4:10</ref>፤ <ref loc="MIC 5:5-6">5:5-6</ref></char>) ደንናዉ ደኤይሳ ምክያስ ኦድስ። ዉርሰን ምክያስ ባ ቆፋ ኩይሸ፥ “አሳ ናኦ፥ ጎዳይ ነዉ ሎኦባ ኦድስ። ጎዳይ ኔፐ ኮየይ አይቤ? ኔኒ ሱረ ፕርዳና መላ፥ ማሮታ ዶሳና መላነ ነ ፆሳራ አሽከተን ዳና መላ ግደኔ?” (<char style="xt"><ref loc="MIC 6:8">6:8</ref></char>) ያግድ አሳ ፆሳኮ ፄጌስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">እስራኤለነ ይሁዳ ቦላ ያና ፕርዳ (<char style="ior"><ref loc="MIC 1:1-3:12">1:1—3:12</ref></char>)</para>
  <para style="io1">ኦራ እስራኤለን ኦራ ፆሳ ኬ (<char style="ior"><ref loc="MIC 4:1-5:15">4:1—5:15</ref></char>)</para>
  <para style="io1">ፆሳይ እስራኤለራ ሞተቴስ (<char style="ior"><ref loc="MIC 6:1-7:7">6:1—7:7</ref></char>)</para>
  <para style="io1">ካዎተት ፆሳኮ ስሙዋ (<char style="ior"><ref loc="MIC 7:8-20">7:8-20</ref></char>)</para>
  <chapter number="1" style="c" sid="MIC 1"/>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1"/>እዮአታም አካዝነ ህዝቅያስ ካል ካልድ ይሁዳን ካዎትዳ ዎደ ሞረሴታ ካታማ አስ ግድዳ ምክያሳኮ ይዳ ጎዳ ቃላይ ሀይሳ፦ እ ሳማረባነ የሩሳላመባ ቆንጨ በእስ።<verse eid="MIC 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2"/>ህንተ፥ አሳ ኡባይ ስእተ፤</para>
  <para style="q2" vid="MIC 1:2">ሳእነ እያ ደእያ ኡባይ ሀይሳ ሀይዝድ ስእተ።</para>
  <para style="q1" vid="MIC 1:2">ኡባ ሃርያ ጎዳይ፥</para>
  <para style="q2" vid="MIC 1:2">ባ ጌሻ ኬፈ ህንተ ቦላ ማርካቴስ።<verse eid="MIC 1:2"/></para>
  <para style="s1">የሩሳላመነ ሳማረ ዮ</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3"/>ሄኮ፥ ጎዳይ ባ ደእያ በሳፈ ዬስ፤</para>
  <para style="q2" vid="MIC 1:3">ቢታ ቃ በሳታ ቦላ ሄመቴስ።<verse eid="MIC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4"/>ሙቃድ ታማን ትልኤይሳዳ፥</para>
  <para style="q2" vid="MIC 1:4">ሃ ደረፐ ዱገ ጎገይሳዳ፥</para>
  <para style="q2" vid="MIC 1:4">ደረት እያ ቶሁዋፐ ጋርሳን ትልአና፤</para>
  <para style="q2" vid="MIC 1:4">ዛንጋራት ጳልቀታና።<verse eid="MIC 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 1:5"/>ሄስ ኡባይ ሀንዳይ ያይቆባ ቆሁዋ ግሾነ እስራኤለ ናጋራ ግሾሳ። ያይቆብ ባለታና መላ ጋሶ ግድዳይ ኦኔ? ኤንታ ካታማ ሳማረ ግደነዬ? ይሁዳ አሳይ ኤቃ ጎይናና መላ ጋሶ ግድዳይ ኦኔ? የሩሳላመ ግደነዬ? <verse eid="MIC 1:5"/><verse number="6" style="v" sid="MIC 1:6"/>ሄሳ ግሾ፥ ጎዳይ፥ “ታኒ ሳማረ፥ ደንባን ኬለትዳ ሹችነ ዎይነይ ቶክያ በሳ መላ ኦና። ታኒ እያ ሹቻ ዛንጋራን ሆላና፤ እያ ባሱዋ ካሎያና። <verse eid="MIC 1:6"/><verse number="7" style="v" sid="MIC 1:7"/>እያ ኤቃ ምስለት ኡባይ ትንቸታና፤ እያ ኤቃ ኬን ኦያ ላይማታስ እመትዳ ጋተይ ኡባይ ፁገታና፤ ታኒ እያ ኤቃታ ኡባ ይሳና። ሄ ጋተ ኡባይ ላይማን ደምዳባ ግድያ ግሾ፥ እካ ስሚድ፥ ሀራ ላይማስ እመታና” ያጌስ።<verse eid="MIC 1:7"/></para>
  <para style="s1">ዋሶነ ዬሆ</para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 1:8"/>ሄሳ ግሾ፥ ታኒ ዬካናነ ዋሳና፤ ፅረ ካሎነ መላ ቶሆን ሄመታና። ዎርካናዳ ዋሳና፤ ቃስ ያንቾዳ ዪ ጋና። <verse eid="MIC 1:8"/><verse number="9" style="v" sid="MIC 1:9"/>ሳማረ ማዱንይ ፓፃናዉ ዳንዳኤና። ሄ ዋየይ ይሁዳ ቢታ ጋክስ፤ ታ አሳይ ደእያ የሩሳላመ ካታማ ፐንግያኮ ጋክስ።<verse eid="MIC 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 1:10"/>ጋተ ካታማን ደእያ ኑ ሞርከታስ ሄሳ ኦዶፕተ፤ ኤንታ ስንን ዬኮፍተ። ቤት-ኦፊራ ካታማን ባናን ጎንዶረትድ ዬክተ። <verse eid="MIC 1:10"/><verse number="11" style="v" sid="MIC 1:11"/>ህንተኖ፥ ሻፍራ ካታማን ደኤይሳቶ፥ ካሎ ዬላትሸ፥ ድኤትድ ቢተ። ፃናና ካታማን ደኤይሳት ያፐ ከያናዉ ፃሎኮና። ቤት-ኤፀላ ካታማይ ዬሆይ ደእያ በሲ ግድያ ግሾ፥ እ ህንተዉ አትያ በሲ ግዳናዉ ዳንዳኤና። <verse eid="MIC 1:11"/><verse number="12" style="v" sid="MIC 1:12"/>መቶይ ጎዳፐ የሩሳላመ ፐንገ ጋካናዉ ይዳ ግሾ፥ ማሮታን ደእያ አሳይ፥ “ሎኦባይ ያንዴሻ!” ግድ ናግሸ ዳቡርስ።<verse eid="MIC 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MIC 1:13"/>ፅዮነ አሳ ናጋራይ ኮይሮ ህንተ ቦላ በንትዳ ግሾነ የሩሳላመ አሳ ናጋራይ ህንተናን በንትዳ ግሾ፥ ህንተኖ፥ ላክሶ ካታማን ደኤይሳቶ፥ ጋረ ፓራታ ኮርተ። <verse eid="MIC 1:13"/><verse number="14" style="v" sid="MIC 1:14"/>ሄሳ ግሾ፥ ህንተኖ ይሁዳ አሳቶ፥ ህንተ ብድ፥ ሞረሴት-ጋተ ካታማ አሳስ እሞታ እማና። አክዚባ ካታማ አሳይ እስራኤለ ካዎታ ጭማና።<verse eid="MIC 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MIC 1:15"/>ህንተኖ፥ ማረሻ ካታማን ደኤይሳቶ፥ ጎዳይ ህንተና ኦልድ ኦይክያ ኦላንቾታ ህንተ ቦላ ኤሀና፤ ቦንቸትዳ እስራኤለ ሀላቃት አዱላማ ጎንጎሉዋን ቆሰታና። <verse eid="MIC 1:15"/><verse number="16" style="v" sid="MIC 1:16"/>ህንተኖ፥ ይሁዳ አሳቶ፥ ህንተ ዶስያ ናይት ህንተፈ ድኤትድ ባናዉ ደእያ ግሾ፥ ህንተ ሁጵያ ሜደትተ፤ ህንተ ሁጵያ ቆራሰ ሁጰዳ ቦሮቆ ኦተ።<verse eid="MIC 1:16"/></para>
  <chapter eid="MIC 1"/>
  <chapter number="2" style="c" sid="MIC 2"/>
  <para style="s1">አሳ ቆፋነ ፆሳ ሀልቹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 2:1"/>ኢታባ ሀልቸይሳታ፥ ቃስ ባንታ ሂፃን ደእሸ፥ ገነ ዋት ኦነኮ ቆፐይሳታ አየ! ዎልቃይ ኤንታ ኩሸን ደእያ ግሾ፥ ሳእ ዎንትያ ዎደ ባንታ ቆፋ ፖሎሶና። <verse eid="MIC 2:1"/><verse number="2" style="v" sid="MIC 2:2"/>ኤንቲ ጎሻ ጋደ ኮይኮ፥ ዎልቃን ኤኮሶና፤ ኬ ኮይኮ ዎልቃን ኦይኮሶና። አሳ ማታ የድ፥ እያ ላታ ጮ ቦንቆሶና።<verse eid="MIC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3"/>ሄሳ ግሾ፥ “ሄኮ፥ ታኒ ህንተ ቦላ ኢታባ ኤሀናዉ ቆፓስ፤ ህንተ ከስ ኤካናዉ ዳንዳኤከታ። እ ኢታ ዎደ ግድያ ግሾ፥ ህንተ ኦቶሮን ስመረታናዉ ዳንዳኤከታ።<verse eid="MIC 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4"/>“ሄ ዎደ ኤንቲ ህንተ ቦላ ሌምሶን ቀልቅሳና፤</para>
  <para style="q2" vid="MIC 2:4">ቃስ ሀይሳዳ ያግድ ዘሌልሸ ህንተና ኦዳ ጫዳና።</para>
  <para style="q1" vid="MIC 2:4">‘ኑኒ ኡባይ ቱማ ይዳ፤</para>
  <para style="q2" vid="MIC 2:4">ጎዳይ ኑ ቢታ ኤክድ፥</para>
  <para style="q2" vid="MIC 2:4">ኑና ድእዳይሳታስ ሻክድ እሚስ’ ” ያጌስ ጎዳይ።<verse eid="MIC 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 2:5"/>ሄሳ ግሾ፥ ጋደይ ሳማን ሻከትያ ዎደ ጎዳ አሳ ግዶን ነ ሳማ ከስያ አስ ያና።<verse eid="MIC 2:5"/></para>
  <para style="s1">ዎርዶ ናበታ</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 2:6"/>አሳይ ታኮ፥ “ኑ ቦላ ትንብተ ኦዶፓ፤ ህንተ ቦላ ሀይሳ መላባይ ጋካና ጋዳ ኑ ቦላ ትንብተ ኦዶፓ። ሄሳ መላ ካዉሻባይ ኑና ጋከና” ያጎሶና።<verse eid="MIC 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MIC 2:7"/>ታኒ ኤንታኮ፥ “ያይቆባ ኮቻቶ፥ ጎዳ ዳንዳአይ ዉርደዬ? እ ሄሳ ማላባ ኦዬ? ሱረ ኦገን በይሳታስ ታ ቃላይ ሎኦባ ኦኔ? ያግድ ህንተ ኦይቻናዉ በሲ? ያጋስ። <verse eid="MIC 2:7"/><verse number="8" style="v" sid="MIC 2:8"/>ሽን ማታ ዎደፐ ዶምድ፥ ታ አሳይ ታ ቦላ ሞርከዳ ደንድስ። ህርግ ባይና ህንተ ግዶራ አያ ሳሮ አሳ ኦላፐ ቃረትድ ስምያ አሳዳ ኦደታ። <verse eid="MIC 2:8"/><verse number="9" style="v" sid="MIC 2:9"/>ታ አሳ ግዶን ደእያ ማጫሳታ ኤንታ ሎኦ ኬፈ ላግድ ከሴታ፤ ታ አንጁዋ ኤንታ ናይታፐ መርናዉ ኤክደታ። <verse eid="MIC 2:9"/><verse number="10" style="v" sid="MIC 2:10"/>ሀ በሳይ ቱናተ ጋሶን ኢትዳ ግሾ፥ ደንድድ ቢተ። ሀይስ ህንተዉ ሸምፖ በሲ ግደና። <verse eid="MIC 2:10"/><verse number="11" style="v" sid="MIC 2:11"/>እስ ጭምያ ዎርዳንቾይ ይድ፥ ‘ህንተ ስንፈ ዎይነ ኡሻንነ ማይያ ኡሻን ኡፋይታና’ ያግድ ዎርዶ ትንብተ ኦድኮ፥ እ ህንተዉ ናበ ግዳና።<verse eid="MIC 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MIC 2:12"/>“ያይቆባ ኮቻቶ፥ ታኒ ህንተና ኡባ ሺሻና፤ ታኒ እስራኤለ አሳፐ አትዳይሳታ ቱማ እስፈ ሺሻና። ዶርስ ግርበን ሺቀይሳዳነ ዉደይ ሄን በሳን ሺቀይሳዳ፥ ታኒ ኤንታ እስፈ ሺሻና። ሄ በሳይ ዳሮ አሳን ኩማና። <verse eid="MIC 2:12"/><verse number="13" style="v" sid="MIC 2:13"/>ኤንታዉ ኦገ ዶይድ ካለይስ ኤንታፈ ስንትድ ከያና፤ ኤንትካ ፐንግያ መንድ፥ ከያና። ጎዳይ፥ ኤንታ ካዎይ ባ ሁጰን ኤንታዉ ኤንታ ስን አድ ኤንታ ካለና” ያጌስ።<verse eid="MIC 2:13"/></para>
  <chapter eid="MIC 2"/>
  <chapter number="3" style="c" sid="MIC 3"/>
  <para style="s1">ካለይሳትነ ናበት ቦረትዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1"/>ታኒ፥ “ያይቆባ ኮቻታ ሀላቃቶነ እስራኤለ አሳ ካለይሳቶ፥ ስእተ! ህንተ ሱረ ፕርዳ ኤራናዉ በሰነዬ? <verse eid="MIC 3:1"/><verse number="2" style="v" sid="MIC 3:2"/>ህንተ ሎኦ እፅድ፥ ኢታ ዶሴታ። ታ አሳ ጋልባ ቃረታ፤ ኤንታ አሹዋ ኤንታ መቀፈ ሻከታ። <verse eid="MIC 3:2"/><verse number="3" style="v" sid="MIC 3:3"/>ህንተ ታ አሳ አሹዋ ሜታ፤ ኤንታ ጋልባ ቃርድ፤ ኤንታ መቀ ቃንፀረታ፤ አሾ ድስተን የጋናዉ ሙፀይሳዳ ኤንታ አሹዋ ሙፀረታ። <verse eid="MIC 3:3"/><verse number="4" style="v" sid="MIC 3:4"/>ኤንቲ ኢታ ኦሶ ኦዳ ግሾ፥ ሄ ዎደ ኤንቲ ጎዳኮ ዋሳና፥ ሽን እ ኤንታዉ ዛረና፤ እ ባ ሶምኡዋ ሄ ዎደ ኤንታፈ ቆታና” ያጋስ።<verse eid="MIC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5"/>ጎዳይ ዎርዶ ናበታኮ፥ “ህንተ ምያባ እምያ ዎደ፥ ‘ነዉ ሳእ ሳሮ’ ያጌታ፤ ሽን ህንተና ሙዞና እፅኮ እያ ቦላ ኦላ አዋጀታ። <verse eid="MIC 3:5"/><verse number="6" style="v" sid="MIC 3:6"/>ሄሳ ግሾ፥ ህንተዉ ጋላስ ቃማ ግዳና፤ ቆንጨ በኤከታ። ሳእ ህንተዉ ማና፤ ዛሪድ ሙሩነከታ፤ ናበታስ አዊ ዉላና፤ ጋላስ ማና። <verse eid="MIC 3:6"/><verse number="7" style="v" sid="MIC 3:7"/>ቆንጨ በኤይሳት ዬላታና፤ ሙሩነይሳት ካዉያና። ጎዳ ማታፐ ኤንታዉ ዛሮይ ባይና ግሾ፥ ኤንቲ ዬላትድ፥ ኡባይ ባንታ ዶና ኦይካና” ያጌስ።<verse eid="MIC 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 3:8"/>ሽን ታኒ ያይቆባ ዘረስ ኤንታ ናጋራ፥ እስራኤለ አሳስ ኤንታ ናጋራ ኦዳና መላ ዎልቃን፥ ጎዳ አያናን፥ ሱረ ፕርዳንነ ምኖተን ኩማስ። <verse eid="MIC 3:8"/><verse number="9" style="v" sid="MIC 3:9"/>ህንተ ሱረ ፕርዳ እፀይሳትነ ሎኦባ ጌላይያ ያይቆባ ኮቻታ ሀላቃትነ እስራኤለ አሳ ካለይሳት ሀይሳ ስእተ። <verse eid="MIC 3:9"/><verse number="10" style="v" sid="MIC 3:10"/>ህንተ ፅዮነ ካታማ ሱ ጉስድ ኬፀታ፤ የሩሳላመ ካታማ ጌላተን ግምበታ። <verse eid="MIC 3:10"/><verse number="11" style="v" sid="MIC 3:11"/>እያ ሀላቃት ዎፈን ፕርዶሶና፤ ካህነት ሚሸን ታማርሶሶና፤ ናበት ሚሸይ ባይና ሙሩኖኮና። ሽን ሄ ኡባ ኦድ፥ “ጎዳይ ኑ ግዶን ደእያ ግሾ፥ ኑ ቦላ ኢታባይ ዬና” ያግድ እያ አማነቶሶና። <verse eid="MIC 3:11"/><verse number="12" style="v" sid="MIC 3:12"/>ሄሳ ግሾ፥ ህንተ ጋሶን ፅዮነ ካታማይ ጋደዳ ጎየታና፤ የሩሳላመ ካታማይ ላለ ዶረ ግዳና። ፆሳ ኬይ ኬፀትዳ ደረይ ዎራ ግዳና።<verse eid="MIC 3:12"/></para>
  <chapter eid="MIC 3"/>
  <chapter number="4" style="c" sid="MIC 4"/>
  <para style="s1">ፆሳ ዙማ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1"/>ዉርሰ ጋላሳን ጎዳ ፆሳ ኬይ ኬፀትዳ ዙማይ፥ ዙማታ ኡባፈ ቁ ግድ በንታና። ደረ ኡባፈ ቁ ቁ ጋና። ካዎተት ኡባይ እያኮ ዎዳና። <verse eid="MIC 4:1"/><verse number="2" style="v" sid="MIC 4:2"/>ህገይ ፅዮነፐ፥ ጎዳ ቃላይ የሩሳላመፐ ከይያ ግሾ፥ ዳሮ ካዎተት ይድ፥ “አነ ሃይተ፤ ጎዳ ዙማኮ፥ ያይቆባ ፆሳ ኬኮ ከዮስ። ኑ እያ ሸንያ ኦና መላ እ ኑና ባ ኦግያ ታማርሳና” ያጋና። <verse eid="MIC 4:2"/><verse number="3" style="v" sid="MIC 4:3"/>እ ዳሮ አሳታ ግዶን ፕርዳና፤ ሃሆን ደእያ ምኖ ካዎተታ ፓላማ ድጋና። ኤንቲ ባንታ ማሻ ማራሻ፥ ባንታ ቶራ ባጫ ከሳናዉ ቆፃና። ካዎተይ ካዎተ ቦላ ኦላ ደንና፤ ህዛፐ ጉየ፥ ኤንቲ ኦላ ትምርተ ታማሮኮና። <verse eid="MIC 4:3"/><verse number="4" style="v" sid="MIC 4:4"/>ሽን አስ ኡባይ ባ ዎይነ ኩያንነ ባላሰ ኩያ ጋርሳን ዎፑ ግድ ኡታና፤ ህርግስያባይ አይብካ ባዋ። ኡባፈ ዎልቃማ ጎዳይ ሄሳ ኦድስ።<verse eid="MIC 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 4:5"/>አሳ ኡባይ ባ ፆሳ ፆሳ ጎይናና። ሽን ኑኒ ጎዳ፥ ኑ ፆሳ ሱንን መርናዉ ሄመታና።<verse eid="MIC 4:5"/></para>
  <para style="s1">ፆሳ ሀልቹዋ</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 4:6"/>ጎዳይ፥ “ሄ ጋላስ ታኒ ዎበታነ ታኒ ዋዬስ አ እምን፥ ድኤትድ ሃሆ በሲ ብዳይሳታ ሺሻና። <verse eid="MIC 4:6"/><verse number="7" style="v" sid="MIC 4:7"/>ዎበት አትድ ዳና መላ ኦና፤ ድኤትድ ሃሆ በሲ ብዳይሳታ ምኖ ካዎተ ከሳና። ሄ ዎደፐ ዶማዳ መርናዉ ታኒ ጎዳይ፥ ፅዮነ ደርያን ኤንታ ቦላ ካዎታና” ያጌስ።<verse eid="MIC 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 4:8"/>ነኖ፥ ጎዳ አሳ ዎችያ የሩሳላመ ቃ ግምብያዉ፥ ካሰ ነ ሃርያ ማታይነ የሩሳላመ ካዎተ ዛዋይ ኡባይ ነዉ ስማና።<verse eid="MIC 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MIC 4:9"/>ሀእ ኔኒ ነ ቃላ ቁ ኦዳ ዋሰይነ እቀ ኦይክዳ ማጫሳዳ ኡንኤተይ አይብሴ? ነዉ ካዎይ ባይና ግሾዬ? ዎይኮ ነና ዞርያ ይዳ ግሾሴ? <verse eid="MIC 4:9"/><verse number="10" style="v" sid="MIC 4:10"/>ፅዮነ አሳዉ፥ እቀ ኦይክዳ ማጫሳዳ ኦልሸ ዞከትተ። ህንተ ካታማፐ ከይድ ቃኤን ዳና፤ ያፐ ባብሎነ ባና። ግዶሽን፥ ያን ህንተ አታና፤ ጎዳይ ህንተና ህንተ ሞርከታ ኩሸፐ ዎዛና። <verse eid="MIC 4:10"/><verse number="11" style="v" sid="MIC 4:11"/>ሽን ሀእ ዳሮ ካዎተት ነ ቦላ ሺቅድ፥ “የሩሳላመይ ቱኖ፤ ኑ አይፈይ ፅዮነ በኦ” ያጎሶና። <verse eid="MIC 4:11"/><verse number="12" style="v" sid="MIC 4:12"/>ሽን ኤንቲ ጎዳ ቆፋ ኤሮኮና፤ እያ ሀልቹዋ አኬክቦኮና። ካ የታናዉ ዉዱማን ሺቀይሳዳ፥ ጎዳይ ኤንታ ሴራናዉ ሺሽስ።<verse eid="MIC 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MIC 4:13"/>ጎዳይ፥ “የሩሳላመ አሳዉ፥ ደንድድ፥ ህንተ ሞርከታ የተ። ታኒ ህንተዉ ብራታ ካጨ እማና፤ ታኒ ህንተዉ ናሰ ብራታ ቶሆ እማና። ህንተ ዳሮ ካዎተታ ትንቸረና፤ ኤንቲ ገነን ሺሽዳ ኡባ ህንተ ጎዳስ ዱማያና፤ ኤንታ ሻሉዋ ህንተ ሳአ ኡባ ጎዳስ እማና” ያጌስ።<verse eid="MIC 4:13"/></para>
  <chapter eid="MIC 4"/>
  <chapter number="5" style="c" sid="MIC 5"/>
  <para style="s1">ካለይስ ቤተለመፐ ያና</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 5:1"/>ህንተኖ፥ የሩሳላመ አሳዉ፥ ህንተ ኦላንቾታ ሺሽተ! ኑ ሞርከት ኑና ተቅዶሶና፤ ኤንቲ እስራኤለ ካለይሳ ጋጩዋ ፃምአን ሾጫና ሀኖሶና። <verse eid="MIC 5:1"/><verse number="2" style="v" sid="MIC 5:2"/>ጎዳይ፥ “ኤፍራታን ደእያ ቤተለመ ካታማዉ፥ ኔኒ ይሁዳ ካታማታ ግዶን ጉ፤ ሽን እያዉ ደንዶይ በንፐ ዶምድ፥ መርናዉ ግድዳይስ፥ እስራኤለ ሃራናይስ ታዉ ኔፐ ከያና” ያጌስ።<verse eid="MIC 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 5:3"/>ሄሳ ግሾ፥ እቀ ኦይክዳ ማጫስያ ናኣ የላና ጋካናዉ፥ ጎዳይ እስራኤለ ሞርከታስ አድ እማና። ሄሳፈ ጉየ፥ ድኤትድ ደእያ እያ እሻት ስሚድ፥ ባንታ አሳራ ዋላከታና። <verse eid="MIC 5:3"/><verse number="4" style="v" sid="MIC 5:4"/>እ ጎዳ ምኖተን ይድ፥ ጎዳ ባ ፆሳ ሱን ዎልቃን ባ አሳ ሄማና። እ ሳኣ ጋፃ ጋካናዉ ግታ ግድያ ግሾ፥ ኤንቲ ሳሮተን ዳና። <verse eid="MIC 5:4"/><verse number="5" style="v" sid="MIC 5:5"/>እ ኤንታዉ ሳሮተ ግዳና።</para>
  <para style="p" vid="MIC 5:5">አሶረ ቢታ አሳት ኑ ቢታ ኦይክያ ዎደነ ኑ ሚፃታ የድ ገልያ ዎደ ኑኒ ላፑን ናገይሳታነ ሆስፑን ካለይሳታ ኤንታ ቦላ ደንና። <verse eid="MIC 5:5"/><verse number="6" style="v" sid="MIC 5:6"/>ኤንቲ ናምሩደይ ደእያ አሶረ ቢታ ኦላን ፆንድ ሃራና። አሶረ ቢታ አሳት ኑ ቢታ ኦልድ ኦይክያ ዎደነ ኑ ዛዋ የያ ዎደ እ ኑና ኤንታ ኩሸፐ አሻና። <verse eid="MIC 5:6"/><verse number="7" style="v" sid="MIC 5:7"/>አትዳ ያይቆባ ዛረት ዳሮ ደርያ ግዶን ጎዳይ ኪትዳ ፃሳ መላነ ማታ ቦላ ዎያ አካ መላ ግዳና። ኤንቲ አማነትድ ናገይ ጎዳፐ አትሽን፥ አሰ ግደና። <verse eid="MIC 5:7"/><verse number="8" style="v" sid="MIC 5:8"/>አትዳ ያይቆባ ዛረት ካዎተታ ግዶንነ ዳሮ አሳ ግዶን፥ ባዞን ዶአታ ግዶን ጋሞ መላነ ዶርሳ ዉደ ግዶን ጉፕ ዎያ ዎዳላ ጋሞ መላ ግዳና። እ ያራ አያ ዎደ የረስነ መንረስ፤ ኦንካ አሻናዉ ዳንዳኤና። <verse eid="MIC 5:8"/><verse number="9" style="v" sid="MIC 5:9"/>ህንተ ኩሸይ ህንተራ ኤቀተይሳታ ቦላ ደንዳና፤ ህንተ ሞርከት ኡባይ ያና።<verse eid="MIC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10"/>ጎዳይ፥ “ሄ ጋላስ ታኒ ህንተ ፓራታ ህንተ ግዶፈ ይሳና፤ ህንተ ፓራ ጋረታ መንረና። <verse eid="MIC 5:10"/><verse number="11" style="v" sid="MIC 5:11"/>ታኒ ህንተ ቢታን ደእያ ካታማታ ይሳና፤ ህንተ ሚፃ ኡባ ላላና። <verse eid="MIC 5:11"/><verse number="12" style="v" sid="MIC 5:12"/>ህንተ ማሮታ ታኒ ይሳና፤ ህዛፐ ጉየ ሙሩነይሳት ህንተ ግዶን ዶኮና። <verse eid="MIC 5:12"/><verse number="13" style="v" sid="MIC 5:13"/>ታኒ ህንተ ኤቃ ምስለታነ ህንተ ጎይናናዉ ኤስዳ ሹቻታ ህንተ ግዶፈ ይሳና፤ ህዛፐ ጉየ ህንተ ህንተ ኩሸን መዳባ ጎይነከታ። <verse eid="MIC 5:13"/><verse number="14" style="v" sid="MIC 5:14"/>ታኒ አሼራ ኤቃ ፆሳታ ህንተ ግዶፈ ሾዳና፤ ህንተ ካታማታ ይሳና። <verse eid="MIC 5:14"/><verse number="15" style="v" sid="MIC 5:15"/>ታዉ ኪተትቦና ካዎተታ ቦላ ይሎንነ ሀንቆን ሀሎ ከያና” ያጌስ።<verse eid="MIC 5:15"/></para>
  <chapter eid="MIC 5"/>
  <chapter number="6" style="c" sid="MIC 6"/>
  <para style="s1">ጎዳይ እስራኤለራ ሞተቴስ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1"/>ጎዳይ እስራኤለ አሳስ ኦደይሳ ስእተ።</para>
  <para style="p" vid="MIC 6:1">አቤት ጎዳዉ፥ ደንዳዳ ቃ ደረታ ስንን ፕርደታ፤ ኔኒ ኦድያባ ዙማት ስኦ። <verse eid="MIC 6:1"/><verse number="2" style="v" sid="MIC 6:2"/>ህንተ ደረት፥ ህንተ ምኖ ሳኣ ባሶት፥ ጎዳይ ሞትያ ሞቱዋ ስእተ። ጎዳይ ባ አሳራ ሞተቴስ፤ እስራኤለ አሳራ ፓላሜስ።<verse eid="MIC 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 6:3"/>ጎዳይ፥ “ታ አሳዉ፥ ታኒ ህንተና አይ ቆሀድና? ታኒ ህንተዉ ዋናዳ ቶሆ ግዳድና? አነ ታዉ ኦድተ! <verse eid="MIC 6:3"/><verse number="4" style="v" sid="MIC 6:4"/>ታኒ ህንተና ግብፀ ቢታፈ ከሳስ፤ ታ ህንተና አይለተ ቢታፈ ዎዛስ። ህንተና ካለና መላ ሙሰ፥ አሮናነ ማይራሞ ህንተዉ እማስ። <verse eid="MIC 6:4"/><verse number="5" style="v" sid="MIC 6:5"/>ታ አሳዉ፥ ሞአበ ካዋ ባላቅ ነዉ ቆፕዳባነ ብኦራ ናአይ ባላም እያዉ ዎይግድ ዛርዳኮ አኬክተ። ኔኒ ሴፅማፐ ጋልጋላ ብያ ዎደ፥ ኦገን ሀንዳባ አነ ቆፕተ። ሄሳ ህንተ ቆፕኮ ታኒ ጎዳይ ህንተና አሻናዉ ኦዳባ ኡባ ህንተ አኬካና” ያጌስ።<verse eid="MIC 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 6:6"/>ጎዳ፥ ቃ በሳን ደእያ ፆሳ ስንን ጎይናናዉ ያሸ ታኒ አይ ኤካዳ ሺቆ? እያዉ ፁሳ ያርሾ ግዳና መላ እስ ላይ ዎፋኖ ኤካዳ ዮ? <verse eid="MIC 6:6"/><verse number="7" style="v" sid="MIC 6:7"/>ጎዳይ ሙኩሉ ዶርሳ ማራዘታን ዎይኮ ታሙ ሙኩሉ ሻፋን ደእያ ሃ መላ ሻማሆ ዛይተን ኡፋይታንዴ? ታ ናቁዋ ግሾ፥ ታ ባይራ ናኣ፥ ታ ሸምፑዋ ናጋራ ግሾ ታ የሉዋ እሞ?<verse eid="MIC 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 6:8"/>አሳ ናኦ፥ ጎዳይ ነዉ ሎኦባ ኦድ ዎስ። ጎዳይ ኔፐ ኮየይ አይቤ? ኔኒ ሱረ ፕርዳና መላ፥ ማሮታ ዶሳና መላነ አሽከተን ነ ፆሳራ ዳና መላ ግደኔ?<verse eid="MIC 6:8"/></para>
  <para style="s1">እስራኤለ ናቆነ ፕርደተ</para>
  <para style="p">
    <verse number="9" style="v" sid="MIC 6:9"/>ጎዳይ፥ “የሩሳላመ ካታማ ፄግድ፥ ‘እያ ሱንስ ያሸተ ጭንጫተ’ ሴራ ፃምአነ እያ ጊግስዳይ ኦነኮ አኬክተ። <verse eid="MIC 6:9"/><verse number="10" style="v" sid="MIC 6:10"/>ናጋራንቾይ ገነን ባ ሶን ሺሽዳ ሻሉዋነ እፀትዳ ዎርዶ ማካ ሚሸታ ታኒ ዶጋነዬ? <verse eid="MIC 6:10"/><verse number="11" style="v" sid="MIC 6:11"/>ያትን፥ ታኒ ዎርዶ ምዛነን ዎርዶ ማካ ሚሸታ ዋታዳ አቶ ጎ? <verse eid="MIC 6:11"/><verse number="12" style="v" sid="MIC 6:12"/>ሄ ካታማ ዱረት ጌላተን ኩምዳይሳታ። እያን ደእያ አሳ ኡባይ ዎርዳንቾ፤ ኤንታ እንፃርሳይ ኢታ። <verse eid="MIC 6:12"/><verse number="13" style="v" sid="MIC 6:13"/>ሄሳ ግሾ፥ ታኒ ህንተ ናጋራ ግሾ ህንተና ይሳናዉ ደንዳስ። <verse eid="MIC 6:13"/><verse number="14" style="v" sid="MIC 6:14"/>ህንተ ማና፥ ሽን ካለከታ፤ ኮሽ ህንተፈ ዱፀና። ህንተ ቡርድ ሺሻና፥ ሽን ህንተዉ አደና፤ ህንተ ዳጋያባ ታኒ ማሻን ይሳና። <verse eid="MIC 6:14"/><verse number="15" style="v" sid="MIC 6:15"/>ህንተ ካ ዘራና፥ ሽን ጫከከታ፤ ሻማሆ ቴራ ጉምአና፥ ሽን ጎኤተከታ፤ ዎይነ ቴራ ጉምአና፥ ሽን እያ ኡየከታ። <verse eid="MIC 6:15"/><verse number="16" style="v" sid="MIC 6:16"/>ህንተ ካዋ ኦምራ ዎጋ፥ እያ ናኣ ካዋ አካባ ሶ ኢታ ኦሱዋነ ኤንታ ዞርያ ካልዳ ግሾ፥ ታኒ ህንተና ይሳና፤ ህንተና አስ ኡባይ ቦራና መላ ኦና። አሳይ ህንተና ጫይያ ጫሻ ህንተ ቶካና” ያጌስ።<verse eid="MIC 6:16"/></para>
  <chapter eid="MIC 6"/>
  <chapter number="7" style="c" sid="MIC 7"/>
  <para style="s1">እስራኤለ አሳ ዋየ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 7:1"/>ታና አየ! ታኒ ቴራ አይፈይ ማፀትድ ዉርን፥ ዎይንያፐነ ባላሰ ምፈ ባ አሞትዳይሳ ደማናዉ ዳንዳእቦና ኮሻትዳ ኡራ መላ ግዳስ። <verse eid="MIC 7:1"/><verse number="2" style="v" sid="MIC 7:2"/>ፆሳ አስ ቢታን ባዋ፤ አሳ ጋርሳን ሱረ አስ ይስ። አስ ኡባይ አሳ ሱ ጉሳናዉ ሆክድ ናጌስ፤ ኡባይ ባ እሻ ግተን ኦይካናዉ ካሌስ። <verse eid="MIC 7:2"/><verse number="3" style="v" sid="MIC 7:3"/>ኤንታ ናምኡ ኩሸት ኢታባ ኦናዉ ሎህዶሶና። ሀላቅነ ዳይን ዎፈ ኦይቾሶና፤ ዎልቃራ ደእያ አሳት ባንታ ኮይዳባ ዎልቃን ፖልሶሶና። ኤንቲ ኡባይ እስፈ ፕርዳ ምርቅድ ይሶሶና።<verse eid="MIC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4"/>ኤንታ ጋርሳን ኬሀ ጌተተይስ አጉን መላ፤</para>
  <para style="q2" vid="MIC 7:4">ሱረ ጌተተይስ ክንቾተ መላ።</para>
  <para style="q1" vid="MIC 7:4">ጎዳይ ናበታ ባጋራ ኦድዳይሳዳ</para>
  <para style="q2" vid="MIC 7:4">እ ባ አሳ ሴራና ጋላሳይ ጋክስ፤</para>
  <para style="q2" vid="MIC 7:4">ኤንቲ ያርካና ዎደይ ሀእ ማትስ።<verse eid="MIC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5"/>ነ ሾሩዋ አማኖፓ፤</para>
  <para style="q2" vid="MIC 7:5">ነ ላግያን አማነቶፋ።</para>
  <para style="q1" vid="MIC 7:5">ኔራ ደእያ ነ ማቸፈ ነ ዶና ናጋ።<verse eid="MIC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6"/>ሄ ዎደ ናአይ ባ አዋ ካስ፤</para>
  <para style="q2" vid="MIC 7:6">ናእያ ባ አየ ቦላ፥</para>
  <para style="q2" vid="MIC 7:6">ናኣ ማችያ ባ አዝና አየ ቦላ</para>
  <para style="q2" vid="MIC 7:6">ሞርከተን ደንዳና።</para>
  <para style="q1" vid="MIC 7:6">አሳስ እያ ሶ አሳይ ሞርከ ግዳና።<verse eid="MIC 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7"/>ሽን ታኒ ኡፋይሳን ጎዳ ፄላና፤</para>
  <para style="q2" vid="MIC 7:7">ታና አሽያ ፆሳ ናጋና፤</para>
  <para style="q2" vid="MIC 7:7">ታ ፆሳይ ታና ስአና።<verse eid="MIC 7:7"/></para>
  <para style="s1">እስራኤለይ ደንዳና</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8"/>ታ ሞርክያዉ፥ ታ መቱዋን ኡፋይቶፋ፤</para>
  <para style="q2" vid="MIC 7:8">ታኒ ኩንድኮካ ደንዳና፤</para>
  <para style="q2" vid="MIC 7:8">ታ ማን ኡትኮካ ጎዳይ ታዉ ፖአና።<verse eid="MIC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9"/>ታኒ ጎዳ ናቃስ፤</para>
  <para style="q2" vid="MIC 7:9">እ ታዉ ሞተትድ፥ ታባ ፕርዳና ጋካናዉ፥</para>
  <para style="q2" vid="MIC 7:9">ታኒ እያ ሀንቁዋ ዳንዳአና።</para>
  <para style="q1" vid="MIC 7:9">እ ታና ፖኦን ከሳና፤</para>
  <para style="q2" vid="MIC 7:9">ታኒ እያ ፅሎ ፕርዳ በአና።<verse eid="MIC 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10"/>ሄ ዎደ ታ ሞርከይ ሄሳ በአና፤</para>
  <para style="q2" vid="MIC 7:10">ታኮ፥ “ጎዳይ ነ ፆሳይ አዉን ደኢ?”</para>
  <para style="q2" vid="MIC 7:10">ያግድ ቀልቅስዳይ ዬላ ማአና።</para>
  <para style="q1" vid="MIC 7:10">እ ኦገን ደእያ ኡርቃዳ የትን፥</para>
  <para style="q2" vid="MIC 7:10">ታኒ ታ አይፈን በአና።<verse eid="MIC 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MIC 7:11"/>ህንተኖ፥ እስራኤለ አሳዉ፥ ህንተ ካታማ ግምበ ድርሳት ድረትያ ጋላሳይ ያና፤ ሄ ጋላስ ህንተ ዛዋይ አካና። <verse eid="MIC 7:11"/><verse number="12" style="v" sid="MIC 7:12"/>ሄ ጋላስ ህንተ አሳይ ህንተኮ ስማና። ኤንቲ አሶረፐ፥ ግብፀፈ፥ ኤፍራፂሳ ሻፋ ሄራን ደእያ ቢታታፐ፥ ሃሆ በሳን ደእያ አባ ጋፃፐነ ቃ ዙማታፐ ህንተኮ ስማና። <verse eid="MIC 7:12"/><verse number="13" style="v" sid="MIC 7:13"/>ሽን ቢታይ እያ ቦላ ደእያ አሳ ኢታተ ጋሶን አስ ባይና ባይሳ ግዳና።<verse eid="MIC 7:13"/></para>
  <para style="s1">ዎሳነ ጋላታ</para>
  <para style="p">
    <verse number="14" style="v" sid="MIC 7:14"/>ኔኒ ባዞን ባርካ ደእያ፥ ነ ላታ ደርያ ነ አራዳ ቢታን ነ አሳ ሄማ። ኤንቲ ካሰ ዎድያዳ ባሳነንነ ጋላዳን ሄመታና መላ ኦ።<verse eid="MIC 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MIC 7:15"/>ጎዳይ፥ “ህንተ ግብፀፐ ከይዳ ዎድያዳ ታኒ ህንተና ማላልስያባ በሳና” ያጌስ። <verse eid="MIC 7:15"/><verse number="16" style="v" sid="MIC 7:16"/>ኤንታ ዎልቃይ ግታ ግድኮካ፥ ካዎተት ኡባይ ሄሳ በእድ ዬላታና። ኤንቲ ዬላትድ፥ ባንታ ዶና ኦይካና፤ ኤንታ ሀይይ ቱላና። <verse eid="MIC 7:16"/><verse number="17" style="v" sid="MIC 7:17"/>ኤንቲ ሾሻዳነ ሳአራ ጎሸትያ መተታዳ ቢታ ላጫና። ኤንቲ ባንታ ሚፃፐ ኮኮርሸ ከይድ ግታ ዳጋማን ጎዳኮ፥ ኑ ፆሳኮ፥ ስማና፤ ኤንቲ ጎዳ ያይድ ዳና።<verse eid="MIC 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MIC 7:18"/>ናጋራ ኡባ አቶ ያገይ፥ አትዳ ባ አሳ ናቁዋ ታይቦናይ ነ መላ ፆሲ ኦኔ? ማሮተ ነና ኡፋይስያ ግሾ ነ ሀንቁዋን መርናዉ ጋምአ ኤራካ። <verse eid="MIC 7:18"/><verse number="19" style="v" sid="MIC 7:19"/>ኔኒ ዛራዳ ነ አሳስ ቃታሳ፤ ኑ ናቁዋ ነ ቶሁዋን የሳ፤ ኑ ናጋራ አባ ጪሞን ሆላሳ። <verse eid="MIC 7:19"/><verse number="20" style="v" sid="MIC 7:20"/>ኔኒ በን ኑ ማይዛታስ ጫቅዳ ጫቁዋዳ አብራሃመነ ያይቆባ ዛረ ግድዳ ነ አሳስ ነ አማነተነ ነ መርና ሲቁዋ በሳና።<verse eid="MIC 7:20"/></para>
  <chapter eid="MIC 7"/>
</usx>
