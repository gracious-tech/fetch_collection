<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">2 ቆሮንቶሳ ኪታ</para>
  <para style="toc1">2 ቆሮንቶሳ ኪታ</para>
  <para style="toc3">2 ቆሮ</para>
  <para style="toc2">2 ቆሮንቶሳ</para>
  <para style="mt1">ጳዉሎስ ቆሮንቶሳ አሳስ</para>
  <para style="mt2">ፃፍዳ ናምአን ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ጳዉሎስ ቆሮንቶሳ አሳስ ፃፍዳ ናምአን ኪታይ ፃፈትዳይ፥ እያዉ ቆሮንቶሳ ዎሳ ኬራ ደእያ ጋሄተይ መቶ ግዶ ገልድ ደእያ ዎደና። እስ እስ ዎሳ ኬ አሳት ጳዉሎሳ ዳሮ ቦርኮካ፥ እ ስጋ መናዉ ኮየይሳ ኤንታ በስስ። ኤንታ ቦላ ጎዳትሸነ ዎልቃ በስሸ ኤንታኮ ባናዉ ኮይቤና (<char style="xt"><ref loc="2CO 1:23">1:23</ref></char>)። ኤንቲ ጳዉሎሳ ኪታ ስእድ እሶይ እሱዋስ አቶ ጋና መላነ ዎል ምንና መላ ኤንታ ዞሬስ (<char style="xt"><ref loc="2CO 2:5-11">2:5-11</ref></char>)።</para>
  <para style="ip">ጳዉሎስ ባ ኪታን፥ ቆሮንቶሳ ዎሳ ኬራ እያዉ ደእያ ጋሄተ ቆንጭስድ፥ ዎሳ ኬን መትዳ ኢታባስነ እፁዋስ አይስ ምኖ ዛሮ እምዳኮ ኦዴስ። እያራ ጋድ እያ ሴራይ ኤንታ ናጋራፐ ዛሪድ ስጋኮ ኤህዳ ግሾ፥ እ ኡፋይትዳ ኡፋይሳ ኤንታዉ ቆንጭሴስ። ካልድካ፥ ይሁዳን ደእያ አማንያ አሳ ማዳናዉ ባንታዉ ደእያባፐ ጮ እማና መላ ሀሳይሴስ።</para>
  <para style="ip">ዉርሰ ሸምፖታን ቃስ፥ ቆሮንቶሳ ዎሳ ኬን ደእያ እስ እስ አሳት ባንታና፥ “ቱማ ሀዋረ” ኦድ ኤክድ፥ ጳዉሎሳ “ዎርዶ ሀዋረ” ኦድ እያ ሞትያ ግሾ፥ ባ ሀዋረተ ማታ ቦላ ደንድዳ ሞቱዋስ ዛሮ እሜስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ገሎ ቆፋ (<char style="ior"><ref loc="2CO 1:1-11">1:1-11</ref></char>)</para>
  <para style="io1">ጳዉሎሳነ ቆሮንቶሳ ዎሳ ኬ (<char style="ior"><ref loc="2CO 1:12-2:17">1:12—2:17</ref></char>)</para>
  <para style="io1">ክርስቶሳ ሲቆይ ህንተና ካለ (<char style="ior"><ref loc="2CO 3:1-7:16">3:1—7:16</ref></char>)</para>
  <para style="io1">ይሁዳን መቶተትዳ አሳስ እመትያ እሞታ (<char style="ior"><ref loc="2CO 8:1-9:15">8:1—9:15</ref></char>)</para>
  <para style="io1">ጳዉሎስ ቱማ ሀዋረ (<char style="ior"><ref loc="2CO 10:1-13:10">10:1—13:10</ref></char>)</para>
  <para style="io1">ኩሻ ቆፋ (<char style="ior"><ref loc="2CO 13:11-14">13:11-14</ref></char>)</para>
  <chapter number="1" style="c" sid="2CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1"/>ፆሳ ሸነን የሱስ ክርስቶሳ ሀዋረ ግድዳ ጳዉሎስነ፥ ኑ እሻ ፅሞትዮስ፥</para>
  <para style="p" vid="2CO 1:1">ቆሮንቶሳን ደእያ ፆሳ ዎሳ ኬስነ አካያ ቢታን ደእያ ፆሳ አሳ ኡባስ ፃፍዳ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 18:1">ሀዋ 18:1</ref>.</char></note><verse eid="2CO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2"/>ፆሳ ኑ አዋፐነ ጎዳ የሱስ ክርስቶሳፐ፥ አ ኬሀተይነ ሳሮተይ ህንተዉ ግዶ።<verse eid="2CO 1:2"/></para>
  <para style="s1">ጳዉሎስ ፆሰ ጋላቴስ</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3"/>ማሮተ አዋስ፥ ኡባ ዎደ ኑና ምንያ ፆሳስ፥ ኑ ጎዳ የሱስ ክርስቶሳ አዋስ ጋላት ግዶ። <verse eid="2CO 1:3"/><verse number="4" style="v" sid="2CO 1:4"/>ፆሳይ ኑስ እምዳ ምንዋን፥ መቶን ደኤይሳታ ኑ ምንና መላ ፆሳይ ኑና ኑ መቶ ኡባን ምንስ። <verse eid="2CO 1:4"/><verse number="5" style="v" sid="2CO 1:5"/>ኑኒ ክርስቶሳ ዳሮ ዋይያ ሻከትዳይሳዳ ቃስ ኑኒ እያ ዳሮ ምንዋን ምናና። <verse eid="2CO 1:5"/><verse number="6" style="v" sid="2CO 1:6"/>ኑኒ ዋየትኮ ሄስ ህንተና ምንናሳነ ህንተና አሻናሳ። ቃስ ኑኒ ምነትኮ ኑኒ ገንጭዳ ዋይያ መላ ህንተካ ገንጭድ፥ ፆሳይ ህንተዉ እምያ ምንዋን ምናና። <verse eid="2CO 1:6"/><verse number="7" style="v" sid="2CO 1:7"/>ህንተ ኑ ኤክዳ መቱዋ መላ ኤክድ፥ ኑ ምንዋን ሻከታናይሳ ኑ ኤርያ ግሾ ኑ ኡፋይሳይ ህንተናን ምኖ።<verse eid="2CO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8"/>ኑ እሻቶ፥ ኢሰ ቢታን ኑና ጋክዳ መቱዋ ህንተ ኤራና መላ ኮዮስ። ሄ ኑና ጋክዳ መቶይ ኑ ዎልቃፈ ዳርን፥ ሀይቆና አቶኮ ግድ ኡፋይስ ቃንፅዳሽን። <verse eid="2CO 1:8"/><verse number="9" style="v" sid="2CO 1:9"/>ኑኒ ኑ ቦላ ሀይቆ ፕርድ ፕርደትዳ መላ ቆፕዳ። ሽን ኑኒ ኑ ሁጰን ግዶናሽን፥ ሀይቅዳይሳታ ደንያ ፆሳን አማነታና መላ ሄስ ሀንስ። <verse eid="2CO 1:9"/><verse number="10" style="v" sid="2CO 1:10"/>ፆሳይ ሄሳ መላ ኢታ ሀይቆፐ ኑና አሽስ፤ ሀእካ አሻና፤ ስንፈካ እ ኑና አሻና ግድ እያን ኡፋይስ ዎስ። <verse eid="2CO 1:10"/><verse number="11" style="v" sid="2CO 1:11"/>ዎሳን ኑና ማድተ። ዳሮ ዎሳ ጋሶን ፆሳ ማዱዋ ኑ ደምያ ዎደ ዳሮ አሳይ ኑ ግሾ ፆሳ ጋላቶሶና።<verse eid="2CO 1:11"/></para>
  <para style="s1">ጳዉሎስ ባ ሀልቹዋ ላምስ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12"/>ኑኒ ኑ ጌሻ ካሀን ጬቀቶስ። ኑኒ ሀ አላምያን ደእዳ ደኡዋን ኡባራካ ህንተራ ኑ ደእዳ ደኡዋን ቱማተንነ ሱረተን ህንተራ ደእዳ። ሄስካ፥ ሀ አላምያ ጭንጫተን ግዶናሽን፥ ፆሳ አ ኬሀተና። <verse eid="2CO 1:12"/><verse number="13" style="v" sid="2CO 1:13"/>ኑ ህንተዉ ፃፍዳ ዳብዳበይ ህንተ ናባባናዉነ አኬካናዉ ዳንዳእያባፐ አትሽን፥ ሀራ ግደና። ህንተ እያ አኬካናዉ ዳንዳኤይሳ ታ አማናይስ። <verse eid="2CO 1:13"/><verse number="14" style="v" sid="2CO 1:14"/>ሀእ ህንተ ኑና ሀንዳ ኬና ኤሬታ፥ ሽን ስንፈ ኩመ ኤራናይሳ ታ አማነታይስ። ኑ ጎዳ የሱሲ ስምያ ዎደ ኑኒ ህንተናን ጬቀትዳይሳዳ ህንተካ ኑናን ጬቀታና።<verse eid="2CO 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15"/>ሄሳ ታኒ ሎይ ኤርዳ ግሾ፥ ህንተ ናምአን ጎኤታና መላ ካሰታዳ ህንተኮ ባናዉ ቆፋ ቃቻስ። <verse eid="2CO 1:15"/><verse number="16" style="v" sid="2CO 1:16"/>ታኒ ማቀዶነ ባሸነ ያፐ ስማሸ ህንተና በአና። ታኒ ያፐ ይሁዳ ብያ ዎደ ህንተ ታና ታ ኦግያን ማዳና ጋዳ ቆፓስ።<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="ACT 19:21">ሀዋ 19:21</ref>.</char></note> <verse eid="2CO 1:16"/><verse number="17" style="v" sid="2CO 1:17"/>ታኒ ሄሳ ጋሸ አይ ኦናዉ በሲያኮ ኤሮና አስ ዳንያና? ዎይኮ ታኒ ታ ቆፋ ቃችያ ዎደ አሳ ቆፋዳ፥ እስ ቶሆ “ኤ” ቃስ እስ ቶሆ “አካይ” ግያ አሳ መለዬ?<verse eid="2CO 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 1:18"/>ሽን ፆሳይ አማነተይሳ ግድያ ግሾ፥ ኑ ህንተዉ ኦድያ ቃላይ “ኤ” ዎይኮ “አካይ” ገይሳ ግደና። <verse eid="2CO 1:18"/><verse number="19" style="v" sid="2CO 1:19"/>ታኒ፥ ስላሰይነ ፅሞትዮስ ህንተዉ ማርካትዳ ፆሳ ናአይ፥ የሱስ ክርስቶሲ ኡባ ዎደ “ኤፐ” አትሽን፥ “ኤ” ነ “አካይ” ግደና።<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ACT 18:5">ሀዋ 18:5</ref>.</char></note> <verse eid="2CO 1:19"/><verse number="20" style="v" sid="2CO 1:20"/>ፆሳይ እማና ግዳ ኡባይ ክርስቶሳ ባጋራ “ኤ” ግዴስ። ኑኒ ክርስቶሳ ባጋራ ፆሳ ቦንቾስ፥ “አምንእ” ገይ ሄሳ ግሾሳ። <verse eid="2CO 1:20"/><verse number="21" style="v" sid="2CO 1:21"/>ኑነ ህንተ ክርስቶሳን ምንድ ኤቃና መላ ኦዳይነ ባ ኦሱዋስ ዶርዳይ ፆሳ። <verse eid="2CO 1:21"/><verse number="22" style="v" sid="2CO 1:22"/>ኑኒ እያባ ግደይሳ ኤርሳናዉ ባ ማታምያ ኑ ቦላ ዎስ፤ ቃስ ባ ጌሻ አያና ኦይ ኦድ ኑ ዎዛናን ዎስ።<verse eid="2CO 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23"/>ታኒ ቆሮንቶሳ ቦና አግዳይ ህንተ አዛኖና አታና መላሳ፤ ሄስ ዎርዶ ግድኮ ፆሳይ ታ ሸምፑዋ ታፐ ኤኮ። <verse eid="2CO 1:23"/><verse number="24" style="v" sid="2CO 1:24"/>ህንተ፥ ህንተ አማኑዋን ምንድ ደእያ ግሾ፥ ኑ ህንተና ኡፋይሳናዉ ህንተራ እስፈ ኦይሳታፐ አትሽን፥ ህንተና ዎልቃን አማንይሳታ ግዶኮ።<verse eid="2CO 1:24"/></para>
  <para style="b"/>
  <chapter eid="2CO 1"/>
  <chapter number="2" style="c" sid="2CO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1"/>ታኒ ናምአን ህንተኮ ቢከ ጋዳ ቆፋ ቃችዳይ ህንተና አዛንና አጋናሳ። <verse eid="2CO 2:1"/><verse number="2" style="v" sid="2CO 2:2"/>ታኒ ህንተና አዛንኮካ ታ አዛንዳ ህንተፈ ሀር ታና ኡፋይሳናዉ ደኤይ ኦኔ? <verse eid="2CO 2:2"/><verse number="3" style="v" sid="2CO 2:3"/>ታኒ ህንተዉ ሄ ዳብዳብያ ፃፍዳይ፥ ታ ህንተና በአናዉ ብያ ዎደ ታና ኡፋይሳናዉ በሲያ አሳን ታ አዛናናዉ ኮዮና ግሾሳ። ታ ኡፋይትያ ዎደ ህንተ ኡባይካ ኡፋይታናይሳ ታ አማናይስ። <verse eid="2CO 2:3"/><verse number="4" style="v" sid="2CO 2:4"/>ታኒ ዳሮ ዋየንነ ኡንአን ቃስ ዳሮ አፉን ፃፍዳይ፥ ህንተና አዛንናሳ ግዶናሽን፥ ታኒ ህንተና ኡባ አይ መላ ዶስያኮ ህንተና ኤርሳና መላሳ።<verse eid="2CO 2:4"/></para>
  <para style="s1">ቆህዳ አስ አቶ ጉሱ</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5"/>አሰ አዛንዳ ኦንካ ደእኮ ታ እያ ናቁዋ ዳርሳናዉ ኮይከፈ አትሽን፥ ታና ግዶናሽን፥ ህንተፈ ዳሮታ አዛንስ። <verse eid="2CO 2:5"/><verse number="6" style="v" sid="2CO 2:6"/>ህንተፈ ዳርያ አሳይ ሄ ኡራ ሴርዳ ሴራይ እያዉ ግዳና። <verse eid="2CO 2:6"/><verse number="7" style="v" sid="2CO 2:7"/>ሄሳ ግሾ፥ ሄ ኡራይ ዳሮ አዛንድ፥ ኡፋይስ ቃንፆና መላ ህንተ እያ ማራናዉነ ምንናዉ በሴስ። <verse eid="2CO 2:7"/><verse number="8" style="v" sid="2CO 2:8"/>ህንተ እያ ሲቀይሳ ዛር እያዉ ቆንጭሳና መላ ታ ህንተና ዎሳይስ። <verse eid="2CO 2:8"/><verse number="9" style="v" sid="2CO 2:9"/>ታ ሄ ዳብዳብያ ህንተዉ ፃፍዳይ፥ ህንተ ፓጨትድ፥ ኡባባን ታዉ ኪተተይሳ ኤራናዉ ኮይዳ ግሾሳ። <verse eid="2CO 2:9"/><verse number="10" style="v" sid="2CO 2:10"/>ህንተ ማርያ ኡራ ታካ ማራና። ታኒ ማራናባይ አይብ ደእኮካ፥ ክርስቶሳ ስንን ህንተ ግሾ ጋዳ ማራስ። <verse eid="2CO 2:10"/><verse number="11" style="v" sid="2CO 2:11"/>ታኒ ሄሳ ኦዳይ ፃላህያ ጭሞ ኦሱዋ ኑ ኤርያ ግሾ፥ ፃላሄን ጭመቶና አታና መላሳ።<verse eid="2CO 2:11"/></para>
  <para style="s1">ክርስቶሳን ደእያ ፆኖ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12"/>ታኒ ክርስቶሳ ዎንገላ ሳባካናዉ ፅሮኣዳ ብዳ ዎደ፥ ጎዳይ ያን ታዉ ኦሶ ኦገ ጊግስድ ዎስ።<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ACT 20:1">ሀዋ 20:1</ref>.</char></note> <verse eid="2CO 2:12"/><verse number="13" style="v" sid="2CO 2:13"/>ሽን ታኒ ታ እሻ ትቶ ያን ደማቦና ግሾ ታ ዎዛናይ ሸምፕቤና። ሄሳ ግሾ፥ ያን ደእያ አሳ ሳሮዳ እያ ኮያናዉ ማቀዶነ ባስ።<verse eid="2CO 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14"/>ሽን ክርስቶሳ ባጋራ ኡባ ዎደ ኑና ፆኖን ካለያነ ሽቶ መላ ሳውያ ክርስቶሳባ ኑ ኤርያ ትምርትያ ኡባ በሲ ጋና መላ ኦያ ፆሳ ጋላት ጋኮ። <verse eid="2CO 2:14"/><verse number="15" style="v" sid="2CO 2:15"/>ኑኒ አትያ አሳ ግዶንነ ይያ አሳ ግዶን ክርስቶሳ ባጋራ ፆሳስ እመትዳ ሳውያ ሽቶ መላ። <verse eid="2CO 2:15"/><verse number="16" style="v" sid="2CO 2:16"/>ያ አሳስ ሀይቆኮ ኤፍያ ሀይቆ ፔኖ፤ ቃስ አትያ አሳስ ደኦኮ ኤፍያ ደኦ ሳዎ፤ ያትን፥ ሄሳ መላ ኦሶስ ግዳናይ ኦኔ? <verse eid="2CO 2:16"/><verse number="17" style="v" sid="2CO 2:17"/>ኑኒ ፆሳ ቃላ ዎ ደማናዉ ኮይድ ዋላክድ ዛልእያ ዳሮ አሳ መላ ግዶኮ። ሽን ፆሳይ ኪትዳ ሱረ አሳታ መላ ክርስቶሳን ደእድ ፆሳ ስንን ቃላ ኦዶስ።<verse eid="2CO 2:17"/></para>
  <chapter eid="2CO 2"/>
  <chapter number="3" style="c" sid="2CO 3"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1"/>ኑኒ ዛሪድ ኑና ሳቢኖዬ? ዎይኮ ሀራ አሳዳ፥ ሳባ ዳብዳብያ ህንተዉ የዳናዉ ዎይኮ ህንተፈ ኤካናዉ ኑና ኮሽዬ? <verse eid="2CO 3:1"/><verse number="2" style="v" sid="2CO 3:2"/>አስ ኡባይ ህንተና ኤራና መላነ ናባባና መላ ህንተ ኑ ዎዛናን ፃፈትድ ደእያ ኑ ዳብዳበ። <verse eid="2CO 3:2"/><verse number="3" style="v" sid="2CO 3:3"/>ህንተ ቃላመን ግዶናሽን፥ ደኦ ፆሳ አያናን፥ ሹቻ ቦላ ግዶናሽን፥ አሳ ዎዛናን ፃፈትዳይሳታነ ኑናን ሀጋዘትዳ ክርስቶሳ ዳብዳበ ግደይሳ በስደታ።<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="EXO 24:12">ከሳ 24:12</ref>፤ <ref loc="JER 31:33">ኤርም 31:33</ref>፤ <ref loc="EZK 11:19">ህዝ 11:19</ref>፤ <ref loc="EZK 36:26">36:26</ref>.</char></note><verse eid="2CO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4"/>ኑ ሄሳ ግዳይ፥ ክርስቶሳ ባጋራ ፆሳን አማኖይ ኑስ ደእያ ግሾሳ። <verse eid="2CO 3:4"/><verse number="5" style="v" sid="2CO 3:5"/>ኑ ሄሳ ኦናዉ ዳንዳእዳይ ፆሳ ዎልቃናፐ አትሽን፥ ኑኒ ኑ ዎልቃን አይኮካ ኦናዉ ዳንዳኦኮ። <verse eid="2CO 3:5"/><verse number="6" style="v" sid="2CO 3:6"/>ኑ ኦራ ጫቁዋ ኦሳንቾታ ግዳና መላ ፆሳይ ኑና ዳንዳእስስ። ሄ ኦራ ጫቆይ ጌሻ አያናን በንትዳይሳፈ አትሽን፥ ፃፈትዳ ህገን ግደና። ህገይ ዎስ፥ ሽን ጌሻ አያናይ ደኦ እሜስ።<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="JER 31:31">ኤርም 31:31</ref>.</char></note><verse eid="2CO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7"/>ሹቻ ቦላ ፃፈትዳ ህገይ እመትያ ዎደ ፆሳ ቦንቾይ ቆንጭስ። ሙሰ ሶምኡዋን ደእያ ቦንቾይ ይሸ ብያባ ግድኮካ፥ እስራኤለ አሳይ እያ ሶምኡዋ ትሽ ኦድ ፄላናዉ ዳንዳእቦኮና። ህዛ፥ ሀይቆ ኤህያ ህገይ ሄሳ መላ ቦንቾን ቆንጭኮ፥<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="EXO 34:29">ከሳ 34:29</ref>.</char></note> <verse eid="2CO 3:7"/><verse number="8" style="v" sid="2CO 3:8"/>ያትን፥ ጌሻ አያናን ኦሰትያ ኦሱዋ ቦንቾይ ዋንድ አኔ? <verse eid="2CO 3:8"/><verse number="9" style="v" sid="2CO 3:9"/>አሳ ቦላ ፕርዳ ኤህያ ህገይ ቦንቾ ግድኮ ያትን፥ አሰ ፅልስያ ኦራ ኦገይ ዋንድ አድ ቦንቸተኔ? <verse eid="2CO 3:9"/><verse number="10" style="v" sid="2CO 3:10"/>ካሰ ቦንቾ ግድዳይሳ ሀእ አያ ቦንቾይ ደኤይሳራ ጋ በእያ ዎደ ቦንቾይ ባይናባ ግድስ። <verse eid="2CO 3:10"/><verse number="11" style="v" sid="2CO 3:11"/>ጉ ዎደስ ቆንጭድ ጉየፐ ይዳይስ ሀይሳዳ ቦንቸትኮ፥ መርናዉ ደኤይስ ዋንድ አድ ቦንቸተኔ?<verse eid="2CO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12"/>ኑስ ሀይሳ መላ ኡፋይሳይ ደእያ ግሾ፥ ዬላቶና ኦደቶስ። <verse eid="2CO 3:12"/><verse number="13" style="v" sid="2CO 3:13"/>ኑኒ፥ እስራኤለ አሳይ ይሸ ብያ ቦንቹዋ ዉርሰ በኦና መላ ባ ሶምኡዋ ካምዳ ሙሰ መላ ግዶኮ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 34:33">ከሳ 34:33</ref>.</char></note> <verse eid="2CO 3:13"/><verse number="14" style="v" sid="2CO 3:14"/>ሽን ኤንታ ዎዛናይ ዶጭስ። ሀች ጋካናዉ ኤንቲ ጋልአ ጫቁዋ ናባብያ ዎደ ኤንታ ዎዛናይ ሄ ካማን ካመትድ ደኤስ። ሄ ካማይ ክርስቶሳ ፃላላን ቃረቴስ። <verse eid="2CO 3:14"/><verse number="15" style="v" sid="2CO 3:15"/>ሽን ሀች ጋካናዉካ ኤንቲ ሙሰ ማፃፋ ናባብያ ዎደ ኡባን ሄ ካማይ ኤንታ ዎዛና ካሜስ። <verse eid="2CO 3:15"/><verse number="16" style="v" sid="2CO 3:16"/>ሽን ኦንካ ጎዳኮ ስምያ ዎደ አዉደካ ሄ ካማይ ቃረቴስ።<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="EXO 34:34">ከሳ 34:34</ref>.</char></note> <verse eid="2CO 3:16"/><verse number="17" style="v" sid="2CO 3:17"/>ጎዳይ አያና፤ ጎዳ አያናይ ደእያ በሳን ላአተ ደኤስ። <verse eid="2CO 3:17"/><verse number="18" style="v" sid="2CO 3:18"/>ኑኒ ኡባይ ካመትቦና ሶምኦን ጎዳ ቦንቹዋ በአና።<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="fq" closed="false">በአና፦ </char><char style="ft" closed="false">ማስቶተዳ ዛሪድ ጶልሳና ጌተትድ ብርሸታናዉ ዳንዳኤስ።</char></note> ኑኒ አያና ግድዳ ጎዳ ማላ ዳናናዉ ቦንቾፈ ቦንቾን ላመታና።<verse eid="2CO 3:18"/></para>
  <chapter eid="2CO 3"/>
  <chapter number="4" style="c" sid="2CO 4"/>
  <para style="s1">መቃ ሚሸን ደእያ ቡቁራ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1"/>ህዛ፥ ፆሳይ ባ ማሮተን ሀ ኦሱዋ ኑስ እምዳ ግሾ፥ ኑኒ ኡፋይስ ቃንፆኮ። <verse eid="2CO 4:1"/><verse number="2" style="v" sid="2CO 4:2"/>ኑኒ ዬላያ ጌማ ኦሶ ኡባ አግዳ፤ ገነ ኦሶ ኦኮ፤ ፆሳ ቃላ ዎርዶራ ዋላኮኮ። ቱማ ቆንጨን ሃሳይሸ፥ አሳ ኡባ ካሀይ ኑና ኤካና መላ ፆሳ ስንን ኑና ሺሾስ።<verse eid="2CO 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 4:3"/>ኑ ኦድያ ዎንገላይ ጌምዳባ ግድኮካ፥ ጌምዳይ ዮ ኦገን ደእያ አሳሳ። <verse eid="2CO 4:3"/><verse number="4" style="v" sid="2CO 4:4"/>ሀ አላምያ ሃርያ ፆሳይ አማኖና አሳ ዎዛና ጎዝስ። ኤንቲ ፆሳ መላ ግድዳ ክርስቶሳ ቦንቾ ዎንገላ ፖኡዋ በኦና መላ ድግስ። <verse eid="2CO 4:4"/><verse number="5" style="v" sid="2CO 4:5"/>ኑኒ፥ የሱስ ክርስቶሲ ጎዳ ግደይሳነ ኑ እያ ግሾ ህንተ ኦሳንቾ ግደይሳ ኦዶስፐ አትሽን፥ ኑባ ኦዶኮ። <verse eid="2CO 4:5"/><verse number="6" style="v" sid="2CO 4:6"/>“ማን ፖኦይ ፖኦ” ግዳ ፆሳይ፥ ክርስቶሳ ሶምኡዋን ፖእያ ፆሳ ቦንቹዋ ኤራ ፖኡዋ እማናዉ ባ ፖኡዋ ኑ ዎዛናን ፖእስስ።<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="GEN 1:3">መ 1:3</ref>.</char></note><verse eid="2CO 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7"/>ሽን ኡባፈ አያ ዎልቃይ ኑባ ግዶናሽን፥ ፆሳባ ግደይሳ በሳናዉ ሀ ቦንቾ ሻሎይ መቃ ሚሸ<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="fqa" closed="false">መቃ ምሸ፦ </char><char style="ft" closed="false">ሀ በሳን መቃ ሚሸ ጌተትዳይ ቢታፈ ኦሰትዳ ሚሸታ በሳናሳ፥ ሄሳትካ፥ ኦቶ፥ ሻተ፥ በሸ፥ ፁጋ፥ ፃሮነ ኤንታና ዳነይሳታ</char></note> ግድዳ ኑ አሳተን ደኤስ።<verse eid="2CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 4:8"/>ኑ ኡባ ባጋራካ ዋየትዳ፥ ሽን መቀረትቦኮ። ኑስ ሀድርስ ግድስ፥ ሽን ኡፋይስ ቃንፅቦኮ። <verse eid="2CO 4:8"/><verse number="9" style="v" sid="2CO 4:9"/>ኑ፥ ሞርከታን ጎደትዳ፥ ሽን ላገ ይቦኮ። ኑ ሞርከታን ሾጨትድ ኩንድዳ፥ ሽን ይቦኮ። <verse eid="2CO 4:9"/><verse number="10" style="v" sid="2CO 4:10"/>የሱሳ ደኦይ ኑ አሳተን ቆንጫና መላ እያ ሀይቁዋ ኡባ ዎደ ኑ አሳተን ቶክድ ዩዮስ። <verse eid="2CO 4:10"/><verse number="11" style="v" sid="2CO 4:11"/>የሱሳ ደኦይ ሀይቅያ ኑ አሳተን ቆንጫና መላ ፓፃ ደእያ ኑኒ እያ ግሾ፥ ኡባ ዎደ ሀይቆስ አድ እመቶስ። <verse eid="2CO 4:11"/><verse number="12" style="v" sid="2CO 4:12"/>ህዛ፥ ሀይቆይ ኑናን ኦያ ዎደ ደኦይ ህንተናን ኦስ።<verse eid="2CO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13"/>ጌሻ ማፃፋን፥ “ታ አማናስ፤ ሄሳ ግሾ ኦዳስ”<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="PSA 116:10">ማዝ 116:10</ref>.</char></note> ያገትስ። ሄሳ መላ አማኖይ ኑስ ደእያ ግሾ ሃሳዮስ። <verse eid="2CO 4:13"/><verse number="14" style="v" sid="2CO 4:14"/>ጎዳ የሱሳ ሀይቆፐ ደንዳ ፆሳይ፥ ኑናካ የሱሳራ ሀይቆፐ ደንናይሳነ ህንተራ እስፈ ባ ስን ሺሻናይሳ ኤሮስ። <verse eid="2CO 4:14"/><verse number="15" style="v" sid="2CO 4:15"/>ሄስ ኡባይ ሀንዳይ ህንተ ግሾሳ። ፆሳ አ ኬሀተይ ዳሮ አሳ ጋክያ ዎደ አሳይ ፆሳ ቦንቹዋስ ዳሮ ጋላታ እማና።<verse eid="2CO 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16"/>ሄሳ ግሾ፥ ኑኒ ኡፋይስ ቃንፆኮ። ኑ በንትያ አሳተይ ዳቡርሸ ብያባ ግድኮካ፥ ኑ አያና አሳተይ ጋላስ ጋላስ ኦራፄስ። <verse eid="2CO 4:16"/><verse number="17" style="v" sid="2CO 4:17"/>ሀእስ ኑኒ ዋየትያ ሀ ካዉሻ ዋየይ፥ ኡባፈ ኬህ ግታትያ መርና ቦንቹዋ ኑስ እምሳና። <verse eid="2CO 4:17"/><verse number="18" style="v" sid="2CO 4:18"/>ኑኒ በንትያባ ግዶናሽን፥ በንቶናባ ፄሎስ። በንትያባይ ሀእሳ፥ ሽን በንቶናባይ መርናሳ።<verse eid="2CO 4:18"/></para>
  <para style="b"/>
  <chapter eid="2CO 4"/>
  <chapter number="5" style="c" sid="2CO 5"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1"/>ሀእ ኑ ደእያ ዱንካነ ዳንያ ሀ ሳአ አሳተይ ላለትኮካ፥ አስ ኬፅቦና፥ ፆሳይ ኬፅዳ መርና ኬይ ኑስ ሳሎን ደኤይሳ ኤሮስ። <verse eid="2CO 5:1"/><verse number="2" style="v" sid="2CO 5:2"/>ሳሎ አሳተ ማአናዉ አሞትሸ ሀእ ሀ ሳአን ደእሸ ኦሎስ። <verse eid="2CO 5:2"/><verse number="3" style="v" sid="2CO 5:3"/>ኑኒ ሄሳ ማእያ ዎደ ካሎቶኮ። <verse eid="2CO 5:3"/><verse number="4" style="v" sid="2CO 5:4"/>ዱንካነ ዳንያ ሀ ሳአ አሳተን ኑ ደእሸ ዴፀትድ ኦሎስ። ሀይቅያ ኑ አሳተይ ደኦን ላመታና መላ ሳሎ አሳተ ማአናዉ ኮዮስፐ አትሽን፥ አሹዋፐ ሻከታናዉ ኮይድ ግደና። <verse eid="2CO 5:4"/><verse number="5" style="v" sid="2CO 5:5"/>ኑና ሀይሳስ ጊግስዳይ ፆሳ። ቃስ ስንፈ ያናባስ ኦይ ኦድ ባ አያና ኑስ እሚስ።<verse eid="2CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6"/>ሄሳ ግሾ፥ ኑኒ ሀ ሳአ አሳተን ደእያ ዎደ ኡባን ጎዳፐ ሃክድ ደኤይሳ ኤርኮካ ኡባ ዎደ አማነትድ ደኦስ። <verse eid="2CO 5:6"/><verse number="7" style="v" sid="2CO 5:7"/>ኑኒ ደኤይ አማኖናፐ አትሽን፥ በእያባን ግደና። <verse eid="2CO 5:7"/><verse number="8" style="v" sid="2CO 5:8"/>ኑ ሀ ሳአ አሳተፈ ሻከትድ፥ ኑ ሶ ብድ ጎዳራ እስፈ ዳናዉ አሞትያ ግሾ፥ አማነትድ ደኦስ። <verse eid="2CO 5:8"/><verse number="9" style="v" sid="2CO 5:9"/>ሄሳ ግሾ፥ ኑ ሀ አሳተን ደእን ዎይኮ ሀ አሳተፈ ሻከትን፥ ኑ አሞይ እያ ኡፋይሳናይሳ። <verse eid="2CO 5:9"/><verse number="10" style="v" sid="2CO 5:10"/>ኑኒ እሶይ እሶይ ሀ ሳአን ደእሸ ሎኦ ግድን ዎይኮ ኢታ ግድን፥ ኦዳ ኦሱዋስ በሲያ ፕርዳ ኤካናዉ ክርስቶሳ ፕርዳ አራታ ስንን ሺቃና።<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="ROM 14:10">ሮመ 14:10</ref>.</char></note><verse eid="2CO 5:10"/></para>
  <para style="s1">አሰ ፆሳራ ስገ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11"/>ህዛ፥ ጎዳስ ያሺ አይ ጉሰኮ ኑኒ ኤርያ ግሾ፥ አሳይ ኑ ኦደይሳ ኤካና መላ ዞሮስ። ፆሳይ፥ ኑኒ ኦነኮ ኑና ኤሬስ፤ ቃስ ህንተካ ህንተ ካሀን ኑ ኦነኮ ኤሬታ ያጋዳ ቆፓይስ። <verse eid="2CO 5:11"/><verse number="12" style="v" sid="2CO 5:12"/>ዎዛናን ግዶናሽን፥ ማላን ጬቀትያ አሳ ዶና ኦይናዉ ህንተ ኑናን ጬቀታና መላ ህንተዉ ጋሶ ግዳናዉ ኮዮስፐ አትሽን፥ ኑ ኑና ዛሪድ ናሻናዉ ኮዮኮ። <verse eid="2CO 5:12"/><verse number="13" style="v" sid="2CO 5:13"/>ኑ ጎሽ ግድኮ ፆሳ ቦንቾሳ፤ ዎዛናማ ግድኮ ህንተሳ። <verse eid="2CO 5:13"/><verse number="14" style="v" sid="2CO 5:14"/>እሶይ ኡባስ ሀይቅዳይሳነ ኡባይ ቃስ እያራ ሀይቅዳይሳ ኑ ኤርያ ግሾ፥ ክርስቶሳ ሲቆይ ኑና ሃሬስ። <verse eid="2CO 5:14"/><verse number="15" style="v" sid="2CO 5:15"/>ደኦን ደኤይሳት ህዛፐ ጉየ ባንታዉ ግዶናሽን፥ ኤንታዉ ሀይቅዳይሳስነ ሀይቆፐ ደንድዳይሳስ ዳና መላ ክርስቶስ አሳ ኡባ ግሾ ሀይቅስ።<verse eid="2CO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16"/>ህዛፐ ጉየ፥ ኑኒ ኦናካ አሳ ቆፋን ፕርዶኮ። ሀይሳፈ ካሰ ኑኒ ክርስቶሳካ አሳ ቆፋን በእዳባ ግድኮካ፥ ህዛፐ ሄሳዳ ቤኦኮ። <verse eid="2CO 5:16"/><verse number="17" style="v" sid="2CO 5:17"/>ሄሳ ግሾ፥ ኦንካ ክርስቶሳን ደእኮ ኦራ መተ፤ ጋልአ መተይ አስ፤ ኡባይካ ኦራ ግድስ። <verse eid="2CO 5:17"/><verse number="18" style="v" sid="2CO 5:18"/>ሄሳ ኡባ ፆሳይ ኦስ። እ ክርስቶሳ ባጋራ ኑና ባራ ስገስ። ቃስ ሀራታ ባራ ስገና መላ ኑስ ስገ ኦሶ እሚስ። <verse eid="2CO 5:18"/><verse number="19" style="v" sid="2CO 5:19"/>ፆሳይ ክርስቶሳ ባጋራ አሳ ኡባ ባራ ስገስ። ኤንታ ናጋራ ታይብቤና፤ ቃስ አሳ ባራ ስገያ ቃላ ኑስ እሚስ።<verse eid="2CO 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20"/>ፆሳይ አሳ ኑ ባጋራ ፄግያ ግሾ፥ ኑ ክርስቶሳን ኪተትድ አሳ ፆሳራ ስገትተ ግድ ክርስቶሳ ግሾ፥ ዎሶስ። <verse eid="2CO 5:20"/><verse number="21" style="v" sid="2CO 5:21"/>ኑኒ ፆሳ ፅሎተ ክርስቶሳ ባጋራ ኤካና መላ፥ ናጋራ ኤሮና ክርስቶሳ ኑ ግሾ፥ ናጋራንቾ አሳዳ ኦስ።<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="fq" closed="false">ናጋራንቾ አሳዳ፦ </char><char style="ft" closed="false">ናጋራ ያርሾ ኦስ።</char></note><verse eid="2CO 5:21"/></para>
  <para style="b"/>
  <chapter eid="2CO 5"/>
  <chapter number="6" style="c" sid="2CO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1"/>ኑኒ ፆሳራ እስፈ ኦያ አስ ግደይሳዳ፥ ህንተ ኤክዳ አ ኬሀተ ሀዳ ኦና መላ ኑ ህንተና ዎሶስ። <verse eid="2CO 6:1"/><verse number="2" style="v" sid="2CO 6:2"/>ፆሳይ፥</para>
  <para style="q1" vid="2CO 6:2">“ታ ነና ስአና ዎደን ስአስ፤</para>
  <para style="q2" vid="2CO 6:2">አቶተ ጋላሳን ነና ማዳስ” ያጌስ። ሄኮ፥ ታ ስእያ ዎደይ ሀእ፤ አቶተ ጋላሳይ ሀች።<note caller="-" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="ISA 49:8">እሳ 49:8</ref>.</char></note><verse eid="2CO 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3"/>ኦንካ ኑ ኦሱዋ ቦራና መላነ ኑናን በታና መላ ኮዮኮ። <verse eid="2CO 6:3"/><verse number="4" style="v" sid="2CO 6:4"/>ግዶሽን፥ ኑ ቱማ ፆሳ ኦሳንቾታ ግደይሳ ኑ ኦያ ኡባባን በስዳ። ዳሮ ገንጫን፥ ዋየን፥ መቶን፥ ኡንአን፥ <verse eid="2CO 6:4"/><verse number="5" style="v" sid="2CO 6:5"/>ጋራፈተን፥ ቃሾን፥ እፆን ኩምዳ ዎጫማን፥ ዳቡራን፥ ስኮ ዮን፥ ፆማን፥<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="ACT 16:23">ሀዋ 16:23</ref>.</char></note> <verse eid="2CO 6:5"/><verse number="6" style="v" sid="2CO 6:6"/>ጌሻተን፥ ኤራተን፥ ዳንዳአን፥ ኬሀተን፥ ጌሻ አያናን፥ ቱማ ሲቆን፥ <verse eid="2CO 6:6"/><verse number="7" style="v" sid="2CO 6:7"/>ቱማ ኦዳንነ ፆሳ ዎልቃን ኑኒ እያ ኦሳንቾታ ግደይሳ በስዳ። ቃስ ፅሎተይ ኑስ ቶራነ ጎንዳለ። <verse eid="2CO 6:7"/><verse number="8" style="v" sid="2CO 6:8"/>ኑኒ ቦንቸትዳነ ቶሸትዳ፤ ጫየትዳነ ጋላተትዳ። ቱማ ሃሳዮስ፥ ሽን አሳይ ኑና ዎርዳንቾ ግዶሶና። <verse eid="2CO 6:8"/><verse number="9" style="v" sid="2CO 6:9"/>ኑ አሳን ኤረትዳ አስ፥ ሽን ኤረቶና አሳ መላ ግድዳ። ሀይቅዶሶና ያገትዳ፥ ሽን ፓፃ ደኦስ፤ ሾጨትዳ፥ ሽን ሀይቅቦኮ። <verse eid="2CO 6:9"/><verse number="10" style="v" sid="2CO 6:10"/>ኑኒ አዛንኮካ ኡባ ዎደ ኡፋይቶስ። ኑ ማንቆ ዳኖስ፥ ሽን ዳሮ አሳ ዱረዮስ። ቃስ አይኮይካ ባይና አስ ዳኖስ፥ ሽን ኡባይ ኑባ።<verse eid="2CO 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11"/>ቆሮንቶሳ አሳቶ፥ ኑ ህንተዉ ቆንጨን ኦድዳ፤ ኑ ኡሉዋ ህንተና በስዳ። <verse eid="2CO 6:11"/><verse number="12" style="v" sid="2CO 6:12"/>ህንተ ኑና ህንተ ሲቁዋ በሶና ድግደታፐ አትሽን፥ ኑኒ ኑ ሲቁዋ ህንተና ድግቦኮ። <verse eid="2CO 6:12"/><verse number="13" style="v" sid="2CO 6:13"/>አዉ ባ ናይታስ ኦደይሳዳ ታ ህንተዉ ኦዳይስ፤ ኑ ህንተና ኑ ኡሉዋ በስዳይሳዳ፥ ህንተካ ህንተ ኡሉዋ ኑና በስተ።<verse eid="2CO 6:13"/></para>
  <para style="s1">አማኖና አሳራ ደእያ ጋሄተ</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14"/>አማኖና አሳራ በሶና ኦገን ዋፀቶፍተ። ፅሎተስነ ናጋራስ አይብ ጋሄተ ደኢ? ፖኦስነ ማስ አይብ እስፈተ ደኢ? <verse eid="2CO 6:14"/><verse number="15" style="v" sid="2CO 6:15"/>ክርስቶሳነ ፃላሄ እስፈ ጋያባይ አይቤ? ቃስ አማነይስነ አማኖናይስ እስፈ ኮፅያባይ አይቤ? <verse eid="2CO 6:15"/><verse number="16" style="v" sid="2CO 6:16"/>ፆሳ ኬስ ኤቃታራ አይብ እስፈተ ደኢ? ፆሳይ፥</para>
  <para style="q1" vid="2CO 6:16">“ታኒ ኤንታ ግዶን ደአና፥</para>
  <para style="q2" vid="2CO 6:16">ኤንታ ግዶን ሄመታና።</para>
  <para style="q1" vid="2CO 6:16">ታኒ ኤንታ ፆሳ ግዳና፤</para>
  <para style="q2" vid="2CO 6:16">ኤንትካ ታ አሰ ግዳና”</para>
  <para style="m" vid="2CO 6:16">ግዳይሳዳ፥ ኑኒ ደኦ ፆሳ ኬ።<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="LEV 26:12">ሌወ 26:12</ref>፤ <ref loc="EZK 37:27">ህዝ 37:27</ref>፤ <ref loc="2CO 3:16">2 ቆሮ 3:16</ref>.</char></note> <verse eid="2CO 6:16"/><verse number="17" style="v" sid="2CO 6:17"/>ሄሳዳካ፥ ጎዳይ፥</para>
  <para style="q1" vid="2CO 6:17">“ኤንታ ግዶፈ ሻከትድ ከይተ፤</para>
  <para style="q2" vid="2CO 6:17">ቱና ግድዳባ ቦቾፍተ፤</para>
  <para style="q2" vid="2CO 6:17">ታ ህንተና ኤካና።<note caller="-" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="ISA 52:11">እሳ 52:11</ref>.</char></note><verse eid="2CO 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18"/>ታ ህንተዉ አዋ ግዳና፤</para>
  <para style="q2" vid="2CO 6:18">ህንተ ታዉ አደ ናይታነ ማጫ ናይታ ግዳና፤</para>
  <para style="q2" vid="2CO 6:18">ያጌስ ኡባፈ ዎልቃማ ጎዳይ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 ሳሜ 7:14</ref>፤ <ref loc="1CH 17:13">1 ታር 17:13</ref>፤ <ref loc="ISA 43:6">እሳ 43:6</ref>፤ <ref loc="JER 31:9">ኤርም 31:9</ref>.</char></note><verse eid="2CO 6:18"/></para>
  <para style="b"/>
  <chapter eid="2CO 6"/>
  <chapter number="7" style="c" sid="2CO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1"/>ህዛ፥ ታ ሲቆቶ፥ ሀ ኡፋይሳይ ኑስ ደእያ ግሾ፥ ኑ አሹዋነ ኑ ሸምፑዋ ቱንስያባ ኡባፈ ኑና ጌሾስ። ፆሳስ ያይድ ኑ ጌሻተ ፖሎ ኦስ።<verse eid="2CO 7:1"/></para>
  <para style="s1">ጳዉሎሳ ኡፋይሳ</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2"/>ህንተ ኡሉዋ ኑና በስተ። ኑኒ ኦናካ ናቅቦኮ፤ ኦናካ ቆህቦኮ፤ ኦናካ ጭምቦኮ። <verse eid="2CO 7:2"/><verse number="3" style="v" sid="2CO 7:3"/>ታኒ ሄሳ ህንተ ቦላ ፕርዳናዉ ጊከ። ሀይሳፈ ካሰ ታ ህንተዉ ኦድዳይሳዳ፥ ህንተ ኑ ዎዛናን ደኤታ፤ ኑ ፓፃ ደእንካ ሀይቅንካ ህንተፈ ሻከቶኮ። <verse eid="2CO 7:3"/><verse number="4" style="v" sid="2CO 7:4"/>ታ ኦድያባ ህንተፈ ቆትከ፤ ታ ህንተናን ጬቀታይስ፤ ኑ ዋየ ኡባን ምነታይስ፤ ቃስ ግታ ኡፋይስ ኡፋይታይስ።<verse eid="2CO 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5"/>ኑኒ ማቀዶነ ብዳ ዎደ፥ ኡባ ባጋራ ዋየትዳፐ አትሽን ሸምፕቦኮ። ካረራ ሞርከታን፥ ኑ ጋን ያሻን ኡንኤትዳ።<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="2CH 2:13">2 ታር 2:13</ref>.</char></note> <verse eid="2CO 7:5"/><verse number="6" style="v" sid="2CO 7:6"/>ሽን አዛንዳይሳታ ምንያ ፆሳይ፥ ትቶ ዩሳን ኑና ምንስ። <verse eid="2CO 7:6"/><verse number="7" style="v" sid="2CO 7:7"/>ኑና ምንዳይ ትቶ ዩሳ ፃላላ ግዶናሽን፥ ህንተካ እያ ምንዳይሳ። ህንተ ታና ላሞተይሳ፥ ታዉ አዛነይሳነ ታዉ ቆፐይሳ ታ ስእዳ ዎደ ታና ዳሮ ኡፋይስስ።<verse eid="2CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8"/>ታ ዳብዳበይ ህንተና አዛንኮካ አይስ ፃፋድናሻ ጋዳ ቂሮትከ። ታ ቂሮትዳይ ታ ፃፍዳ ዳብዳበይ ህንተና ጉ ዎደስ አዛንዳ ግሾሳ። <verse eid="2CO 7:8"/><verse number="9" style="v" sid="2CO 7:9"/>ሀእ ታኒ ኡፋይትዳይ፥ ታ ህንተና አዛንዳ ግሾ ግዶናሽን፥ ህንተ አዛኖይ ህንተና ህንተ ናጋራፐ ዛርዳ ግሾሳ። ፆሳይ ባ ሸንያዳ ህንተና አዛንስፐ አትሽን ኑ ህንተና አይብንካ ቆህቦኮ። <verse eid="2CO 7:9"/><verse number="10" style="v" sid="2CO 7:10"/>ፆሳይ ኮያ አዛኖይ፥ አቶተኮ ጋያ ናጋራፐ ስሞ ኤሄስ፤ እያን ቂሮያባይ ባዋ። ሽን ሀ ሳአ አዛኖይ ሀይቆ ኤሄስ። <verse eid="2CO 7:10"/><verse number="11" style="v" sid="2CO 7:11"/>ህንተ አዛኖይ ህንተናን አይፍስዳ አይፍያ በእተ። ሄ አዛኖይ ህንተና አይ መላ ደንዳኮ፥ አይ መላ ዛሮ እማናዳ ጊግስዳኮ፥ ሄ ኡራ ቦላ አይ መላ ሀንቀዳኮ፥ አይ መላ ታዉ ያያና መላ ኦዳኮ፥ አይ መላ አሞይዳኮ፥ ሄ ኡራ ሴራናዉ አይ መላ ጊግዳኮ በእተ። ሀ ኡባባን ህንተ ጌሽ ግደይሳ ማርካይደታ።<verse eid="2CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12"/>ሄሳ ግሾ፥ ታኒ ሀ ዳብዳብያ ህንተዉ ፃፍዳይ፥ ናቅዳ ኡራ ዎይኮ ናቀትዳ ኡራ ግሾ ግደና። ሽን ህንተ ኑስ አይ መላ ቆፕያኮ ፆሳ ስንን ህንተ፥ ህንተና በአና መላ ፃፋስ። <verse eid="2CO 7:12"/><verse number="13" style="v" sid="2CO 7:13"/>ኑኒ ኡፋይትዳይ ሄሳ ግሾሳ። ኑ ኡፋይሳፈ አድ ኑና ዳሮ ኡፋይስዳይ፥ ህንተ ትቶ ኡፋይስዳይሳነ እያ ዎዛና ሸምፕስዳይሳ። <verse eid="2CO 7:13"/><verse number="14" style="v" sid="2CO 7:14"/>ታኒ ህንተና ናሻዳ እያዉ ኦድን፥ ህንተ ታና ዬላይበከታ። ሽን ኑኒ ኡባ ዎደ ህንተዉ ቱማ ኦድዳ፤ ሄሳዳካ ኑኒ ትቶ ስንን ህንተና ናሽዳይስ ቱማ ግድስ። <verse eid="2CO 7:14"/><verse number="15" style="v" sid="2CO 7:15"/>ህንተ እያዉ ያሻን ኮኮርድ፥ እያ ሞክዳይሳ ቃስ እያዉ አይ መላ ኪተትዳኮ፥ እ ቆፕያ ዎደ ህንተዉ ደእያ ሲቆይ ምንሸ ብስ። <verse eid="2CO 7:15"/><verse number="16" style="v" sid="2CO 7:16"/>ታኒ ኡባባን ህንተናን አማነትያ ግሾ ኡፋይታይስ።<verse eid="2CO 7:16"/></para>
  <chapter eid="2CO 7"/>
  <chapter number="8" style="c" sid="2CO 8"/>
  <para style="s1">ኡፋይሳን እሞባ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1"/>ኑ እሻቶ፥ ፆሳይ ማቀዶንያን ደእያ ዎሳ ኬታስ እምዳ አ ኬሀተባ ህንተ ኤራና መላ ኑ ኮዮስ።<note caller="-" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="ROM 15:26">ሮመ 15:26</ref>.</char></note> <verse eid="2CO 8:1"/><verse number="2" style="v" sid="2CO 8:2"/>ኤንቲ ግታ መቶን ፓጨትዶሶና፥ ሽን ኤንታ ኡፋይሳይ ዎልቃማ። ኤንታ ማንቆተስ ዛው ባዋ፥ ሽን ባንታ እሙዋን ዳሮ ኬህዶሶና። <verse eid="2CO 8:2"/><verse number="3" style="v" sid="2CO 8:3"/>ኤንቲ ባንታ ዎልቃ መላነ ባንታ ዎልቃፈ አይሳ ዶስድ እምዳይሳስ ታ ማርካ። <verse eid="2CO 8:3"/><verse number="4" style="v" sid="2CO 8:4"/>ኤንቲ ፆሳ አሰ ማድያ ሎኦ ኦሶ ኑራ ኦናዉ ኮይድ ኑና ዳሮ ዎስዶሶና። <verse eid="2CO 8:4"/><verse number="5" style="v" sid="2CO 8:5"/>ኤንቲ ኑኒ ቆፕዳይሳፈ አድ ኦዶሶና። ፆሳ ሸንያዳ፥ ኮይሮትድ ባንታና ጎዳስ እምዶሶና፤ ካልድ፥ ባንታና ኑስ አድ እምዶሶና።<verse eid="2CO 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 8:6"/>ሀ ሎኦ ኦሱዋ ዶምዳ ትቶይ፥ ጉጅድ ኦናዳነ ህንተና ማድድ፥ ሄ ኦሱዋ ፖልሳናዳ እያ ዎስዳ። <verse eid="2CO 8:6"/><verse number="7" style="v" sid="2CO 8:7"/>ሽን ህንተ ኡባባን፥ አማኖን፥ ኦዳን፥ ኤራተን፥ ግታ አሞን፥ ኑና ዶሶንነ ኡባባን ዱረትዳይሳዳ ሀ ሎኦ ኦሱዋንካ ህንተ ኬሀ ግዳና መላ ኑ ኮዮስ።<verse eid="2CO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8"/>ታኒ ሄሳ ኪታናዉ ጊከ። ሽን ሀራታ ግታ አሙዋ ህንተ ሲቁዋራ ጋ በአዳ፥ ህንተ አይ ኬና ቱሜኮ ኤራናዉ ጋይስ። <verse eid="2CO 8:8"/><verse number="9" style="v" sid="2CO 8:9"/>ህንተ፥ ኑ ጎዳ የሱስ ክርስቶሳ አ ኬሀተ ኤሬታ። ክርስቶስ ዱረ ግድ ኡትድ፥ ህንተ እያ ማንቆተን ዱረታናዳ ህንተ ግሾ ማንቅስ።<verse eid="2CO 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10"/>ታኒ ሀ ኦዳን ህንተና ማድያ ዞረ ዞራናዉ ኮያይስ። ህንተ ዝላይ እማናዉ ፃላላ ግዶናሽን፥ ሄሳ ኦናዉ አሞትሸካ ህንተ ኮይሮ። <verse eid="2CO 8:10"/><verse number="11" style="v" sid="2CO 8:11"/>ህንተ ኦናዉ ዶምዳ ኦሱዋ ሀእ ፖልተ። ህንተ ህንተዉ ደኤይሳ ኬና እምኮ፥ ሄስ ህንተ እማናዉ ዳሮ አሞተይሳ ቆንጭሴስ። <verse eid="2CO 8:11"/><verse number="12" style="v" sid="2CO 8:12"/>እስ አስ እማናዉ አሞትኮ፥ እያ እሞይ ፆሳ ስንን ኤከተይ፥ እ ባዉ ደእዳይሳ ኬና እምናፐ አትሽን፥ ባይናባፐ እማናዉ ኡንኤትን ግደና።<verse eid="2CO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13"/>ታኒ ሄሳ ገይ፥ ህንተ ኡባይ እስ ግና ግዳና መላሳፈ አትሽን፥ ሀራት ዋያፐ ሸምፕን፥ ህንተ ዋየታና መላሳ ግደና። <verse eid="2CO 8:13"/><verse number="14" style="v" sid="2CO 8:14"/>ዎደ ኤንታ ፓላሀይ ህንተ ፓጫ ኩንና መላ፥ ሀእ ህንተ ፓላሀይ ኤንታ ፓጫ ኩን። ሄሳን ህንተ ግና ግዳና። <verse eid="2CO 8:14"/><verse number="15" style="v" sid="2CO 8:15"/>ጌሻ ማፃፋን፥ “ዳሮ ሺሽዳይሳስ ፓላህቤና፤ ጉ ሺሽዳይሳስ ፓጭቤና” ጌተትድ ፃፈትዳይሳ መላ።<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="EXO 16:18">ከሳ 16:18</ref>.</char></note><verse eid="2CO 8:15"/></para>
  <para style="s1">ትቶነ እያ ላገታ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16"/>ኑኒ ህንተዉ ቆፐይሳዳ ትቶይካ ህንተዉ ቆፓና መላ ኦዳ ፆሳይ ጋላተቶ። <verse eid="2CO 8:16"/><verse number="17" style="v" sid="2CO 8:17"/>ትቶይ ህንተኮ ብዳይ፥ ኑኒ እያ ደንዳ ግሾ ፃላላ ግዶናሽን፥ እ ባ ሸነን ባናዉ አሞትዳ ግሾሳ። <verse eid="2CO 8:17"/><verse number="18" style="v" sid="2CO 8:18"/>ዎንገላ ማርካተን ዎሳ ኬ ኡባን ዳሮ ኤረትዳ እሻ፥ ኑኒ ትቶራ እስፈ ኪቶስ። <verse eid="2CO 8:18"/><verse number="19" style="v" sid="2CO 8:19"/>ሄሳ ቦላ ኑኒ ሀ ኬሀ እሞታ ኤፍያ ዎደ ኑራ ባና መላ፥ ሀ ሎኦ ኦሱዋን ጎዳ ቦንቻናዉነ ሀራታ ማዳናዉ ደእያ አሙዋ በሳናዉ እ ዎሳ ኬታን ዶረትስ።<verse eid="2CO 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 8:20"/>ሀ እመትዳ ኬሀ እሙዋ፥ ኑኒ ኦሶ ቦላ ፔሽያ ዎደ ቦረቶና መላ ናገቶስ። <verse eid="2CO 8:20"/><verse number="21" style="v" sid="2CO 8:21"/>ኑኒ ጎዳ ስንን ፃላላ ግዶናሽን፥ አሳ ስንንካ ሎኦ ግድዳባ ኦስ።<note caller="-" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="PRO 3:4">ሌም 3:4</ref>.</char></note><verse eid="2CO 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22"/>ቃስ ዳሮ ዎደ ፓጨን ምንድ አዳ ኑ እሻ፥ ኤንታራ ህንተኮ ኪትዳ። እ ህንተናን ዳሮ አማነትያ ግሾ፥ ሀእ ህንተና ማዳናዉ ዳሮ አሞቴስ። <verse eid="2CO 8:22"/><verse number="23" style="v" sid="2CO 8:23"/>ትቶባ ኤራናዉ ኮይኮ፥ ህንተና ማዳናዉ ታራ ኦያ ታ ኦሶ ላገ። ሀንኮ እሻታባ ግድኮ ዎሳ ኬት ኪትዳይሳታ፤ ቃስ አሳይ ኤንታ ዱሳ በእድ ክርስቶሳ ቦንቾሶና። <verse eid="2CO 8:23"/><verse number="24" style="v" sid="2CO 8:24"/>ሄሳ ግሾ፥ ዎሳ ኬት ህንተ ሲቁዋነ ኑ ህንተና ናሽያ ናሾይ ቱማ ግደይሳ ቆንጭሳናዉ ህንተ ሲቁዋ ሀ አሳታ በስተ።<verse eid="2CO 8:24"/></para>
  <chapter eid="2CO 8"/>
  <chapter number="9" style="c" sid="2CO 9"/>
  <para style="s1">አማንያ አሳስ ሺቅዳ ሚሸ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1"/>አማንያ አሳስ ከስያ ሚሽያባ ታ ህንተዉ ፃፋናዉ ኮሸና። <verse eid="2CO 9:1"/><verse number="2" style="v" sid="2CO 9:2"/>ህንተ ማዳናዉ ኬህ አሞተይሳ ታ ኤራይስ። ህንተ አካያ አሳይ፥ ዝላይፈ ዶምድ ማዳናዉ ጊገትዳይሳ ታኒ ማቀዶነ አሳስ ዶና ኩንዳ ኦዳስ። ህንተ ግታ አሞይካ ኤንታፈ ዳሮታ ደንስ። <verse eid="2CO 9:2"/><verse number="3" style="v" sid="2CO 9:3"/>ሀ ኦሱዋን ህንተናን ኑ ጬቀትያ ጬቆይ ሀዳ ግዶና መላ ኮይሮ ህንተባ ታ ኦድዳይሳዳ ህንተ ጊገትድ ናጋና መላ ሀ እሻታ ህንተኮ ኪታስ። <verse eid="2CO 9:3"/><verse number="4" style="v" sid="2CO 9:4"/>ማቀዶነ አሳይ ታራ ብድ፥ ህንተ ጊገቶና ደእሽን፥ ደምኮ፥ ኑ ህንተናን ዬላታና፤ ቃስ ህንተ ኑፐ አ ዬላታና። <verse eid="2CO 9:4"/><verse number="5" style="v" sid="2CO 9:5"/>ሄሳ ግሾ፥ ሀ እሻት ታፐ ስንትድ ህንተኮ ብድ፥ ህንተ እማና ግዳ እሙዋ ካሰትድ ጊግሳና መላ ታ ኤንታና ኪታስ። ታኒ ጋክያ ዎደ ሄ እሞይ ጊግድ ኡቴስ። ሄ ዎደ ሄ ኬሀተ እሞይ ዎልቃን ግዶናሽን፥ ዶሳን ግደይሳ ኤርሴስ።<verse eid="2CO 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6"/>ሀይሳ አኬክተ፤ ጉ ዘርዳይ ጉ ጫካና፤ ዳሮ ዘርዳይ ዳሮ ጫካና። <verse eid="2CO 9:6"/><verse number="7" style="v" sid="2CO 9:7"/>ፆሳይ ኡፋይሳን እምያ ኡራ ዶስያ ግሾ፥ ዎልቃን ዎይኮ ዶስ ባይና ግዶናሽን፥ እስ እስ አስ ባ ዎዛናን ቆፕዳይሳዳ ዶሳን እማናዉ በሴስ። <verse eid="2CO 9:7"/><verse number="8" style="v" sid="2CO 9:8"/>ኡባ ዎደ ኡባባን ኮሽያባ ኡባ ደምድ ሎኦ ኦሶ ኡባ ኦናዉ ዳንዳአና መላ ፆሳይ ህንተዉ ባ አንጁዋ ዳርሳና። <verse eid="2CO 9:8"/><verse number="9" style="v" sid="2CO 9:9"/>ጌሻ ማፃፋን፥</para>
  <para style="q1" vid="2CO 9:9">“እ ባ ሻሉዋ ማንቆታስ ላልስ፤</para>
  <para style="q2" vid="2CO 9:9">እያ ፅሎተይ መርናዉ ደአና”</para>
  <para style="m" vid="2CO 9:9">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="PSA 112:9">ማዝ 112:9</ref>.</char></note><verse eid="2CO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10"/>ዘረይሳስ ዘረ፥ ማናዉ ካ እምያ ጎዳይ፥ ህንተ ዘርያ ዘረ ዳርስድ እማና። ህንተ ፅሎተ አይፍያካ ዳርሳና።<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="ISA 55:10">እሳ 55:10</ref>.</char></note><verse eid="2CO 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 9:11"/>ዳሮ አሳይ ህንተ እምያ እሙዋ ኑፐ ኤክድ፥ ፆሳ ጋላታናዳ፥ ህንተ ኡባ ዎደ ዳርስድ እመይሳታ ግዳና መላ ፆሳይ ህንተና ኡባ ባጋራ ዱረያና። <verse eid="2CO 9:11"/><verse number="12" style="v" sid="2CO 9:12"/>ሀ ህንተ እምያ እሞይ አማንያ አሳ ፓጫ ኩን ፃላላ ግዶናሽን፥ አሳይ ፆሳ ጋላታናዉ ጋሶ ግዴስ። <verse eid="2CO 9:12"/><verse number="13" style="v" sid="2CO 9:13"/>ሀ ህንተ ኦሶይ ህንተ አማኑዋ ኤርስድ ክርስቶሳ ዎንገላ ህንተ አማንድነ እያዉ ኪተትድ ህንተዉ ደእያባ ኤንታራነ ሀራታራ ሻከትዳ ግሾ ኡባይ ፆሳ ቦንቻና። <verse eid="2CO 9:13"/><verse number="14" style="v" sid="2CO 9:14"/>ፆሳይ ህንተዉ እምዳ አ ኬሀተ ግሾ ኤንቲ ህንተዉ ፆሳ ዎስሸ ህንተና በአናዉ ላሞቶሶና። <verse eid="2CO 9:14"/><verse number="15" style="v" sid="2CO 9:15"/>ዛው ባይና ፆሳ እሙዋስ ፆሳይ ጋላተቶ።<verse eid="2CO 9:15"/></para>
  <chapter eid="2CO 9"/>
  <chapter number="10" style="c" sid="2CO 10"/>
  <para style="s1">ጳዉሎስ ሞትያ አሳስ ዛርዳ ዛሩዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1"/>ታኒ ህንተራ ደእያ ዎደ፥ “ሹጎ”፥ ቃስ ህንተፈ ሃክያ ዎደ “ኑ ቦላ ምኔስ” ያገትዳ፥ ጳዉሎስ፥ ኬሀነ አሽከ ግድዳ ክርስቶሳ ሱንን ህንተና ዎሳይስ። <verse eid="2CO 10:1"/><verse number="2" style="v" sid="2CO 10:2"/>ታኒ ህንተኮ ብያ ዎደ ኑ አሾ ቆፋራ ስመረትያ አስ ኦድ ቆፕያ አሳ ቦላ ምኖ ቃላን ኦደታናዉ ቆፋ ቃቻስ። ህንተ ቦላ ሄሳዳ ኦደታና መላ ህንተ ታና ኦናዳ ህንተና ዎሳይስ። <verse eid="2CO 10:2"/><verse number="3" style="v" sid="2CO 10:3"/>ኑኒ ሀ ሳአን ደእኮካ ሀ ሳኣ አሳዳ ኦለቶኮ። <verse eid="2CO 10:3"/><verse number="4" style="v" sid="2CO 10:4"/>ኑ ኦላ ሚሸይ ሀ ሳአባ ግደና። ሽን ሚፃ ላላናዉ ዎልቃራ ደእያ ፆሳ ቶራ። ቱማራ ኤቀትያ ፓላማነ፥ <verse eid="2CO 10:4"/><verse number="5" style="v" sid="2CO 10:5"/>ፆሳ ኤራተ ቦላ ኦቶሮን ደንድያ ፓላማነ ሀዳ ቆፋ ኡባ ላሎስ። አሳ ቆፋ ኡባ ድእድ ክርስቶሳስ ኪተታና መላ ኦስ። <verse eid="2CO 10:5"/><verse number="6" style="v" sid="2CO 10:6"/>ህንተ ኪተተይ ፖሎ ግድያ ዎደ ኑኒ ኪተተ እፆ ኡባ ሴራናዉ ጊገታና።<verse eid="2CO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7"/>ህንተ አይፈይ በእዳ መላ ፕርደታ። ኦንካ ባና ክርስቶሳባ ግድ ቆፕያባ ግድኮ፥ ኑካ ክርስቶሳባ ግደይሳ ኤሮ። <verse eid="2CO 10:7"/><verse number="8" style="v" sid="2CO 10:8"/>ጎዳይ ታዉ እምዳ ማታን ጬቀትኮካ ሄሳን ዬላትከ። ሄ ማታይ ታዉ እመትዳይ ህንተና ድቻናሳፈ አትሽን፥ ቆሀናሳ ግደና። <verse eid="2CO 10:8"/><verse number="9" style="v" sid="2CO 10:9"/>ታኒ ታ ዳብዳብያን ህንተና ያሽሳናዉ ኮያዳ ፃፍዳባ ዳኖፖ። <verse eid="2CO 10:9"/><verse number="10" style="v" sid="2CO 10:10"/>እስ እስ አሳይ፥ “ጳዉሎሳ ዳብዳበይ ዴፆነ ዎልቃማ፥ ሽን እያ ሶምኦን በእያ ዎደ እ ዳቡራንቾ፤ እያ ኦዳይካ ፓና” ያጎሶና። <verse eid="2CO 10:10"/><verse number="11" style="v" sid="2CO 10:11"/>ሄ አሳት ኑ ሃሆን ደእሸ ፃፍያ ዳብዳብያንነ ማታን ህንተራ ደእሸ ኦያ ኦሱዋ ግዶን ዱማተ ባይናይሳ አኬኮ።<verse eid="2CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12"/>ኑኒ ባንታና ናሽያ አሳታራ ኑና ግናያናዉ ዎይኮ ጋደያናዉ ኮዮኮ። ሽን ኤንቲ ባንታና ባንታራ ግናይድ ዎይኮ ጋደይድ በእሸ ኤያ።<verse eid="2CO 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 10:13"/>ሽን ኑኒ ፆሳይ ኑስ እምዳ ሳን ጬቀቶስፐ አትሽን፥ ዛዋ ፕንድ ጬቀቶኮ፤ ሄ ዛዋይ ህንተኮካ ጋኬስ። <verse eid="2CO 10:13"/><verse number="14" style="v" sid="2CO 10:14"/>ኑኒ በሰይሳፈ አድ ጬቀቶኮ፥ ሽን ክርስቶሳ ዎንገላ ህንተኮ ጋዳይሳን ጬቀቶስ። <verse eid="2CO 10:14"/><verse number="15" style="v" sid="2CO 10:15"/>ኑኒ ፆሳይ ኤስዳ ዛዋፐ ፕንድ፥ ሀራት ኦዳ ኦሶን ጬቀቶኮ። ግዶሽን፥ ህንተ አማኖይ ድጫና መላ ፆሳይ እምዳ ዛዋን ህንተ ግዶን ኑ ኦያ ኦሶይ ዳልጋና ግድ ቆፖስ። <verse eid="2CO 10:15"/><verse number="16" style="v" sid="2CO 10:16"/>ኑኒ ሀራ አስ ባ ዛዋን ኦዳ ኦሶን ገልድ ጬቀቶኮ፥ ሽን ህንተፈ ፕንድ ሀራታስ ዎንገላ ማርካታናዉ ዳንዳኦስ። <verse eid="2CO 10:16"/><verse number="17" style="v" sid="2CO 10:17"/>ሽን፥ ጌሻ ማፃፋን፥ “ጬቅያ ኡባይ ጎዳ ሎኦተን ጬቆ” ያግድ ፃፈትስ።<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="JER 9:24">ኤርም 9:24</ref>.</char></note> <verse eid="2CO 10:17"/><verse number="18" style="v" sid="2CO 10:18"/>ጎዳይ ናሽያ ኡራፐ አትሽን፥ ባና ባዉ ናሽያ ኡራይ ናሸተና።<verse eid="2CO 10:18"/></para>
  <chapter eid="2CO 10"/>
  <chapter number="11" style="c" sid="2CO 11"/>
  <para style="s1">ጳዉሎሳነ ዎርዶ ሀዋረታ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1"/>ታ ጉ ኤያተ ህንተ ሀእካ ዳንዳአና ጋዳ ቆፓይስ፤ ሀያና ዳንዳእተ። <verse eid="2CO 11:1"/><verse number="2" style="v" sid="2CO 11:2"/>ፆሳይ ህንተዉ ቆፕዳይሳዳ፥ ታካ ህንተዉ ቆፓይስ። ታኒ ህንተና ጌሻ ጌላእዳ እስ አድያ፥ ክርስቶሳስ እማናዉ ኦይቻ ዎስ።<verse eid="2CO 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 11:3"/>ሽን ሾሻይ ባ ገንያን ሄዋኖ ባለዳይሳዳ ኦን ኤር ህንተ ዎዛናይ ኢትድ ክርስቶሳስ ደእያ ህንተ ሱረተነ ጌሻተ አጋንደት ጋዳ ህርጋይስ።<note caller="-" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="GEN 3:1-5">መ 3:1-5</ref>.</char></note> <verse eid="2CO 11:3"/><verse number="4" style="v" sid="2CO 11:4"/>እስ አስ ይድ፥ ኑኒ ህንተዉ ማርካትዳ የሱሳፐ ሀራ የሱሳ ህንተዉ ማርካትኮ፥ ዎይኮ ህንተ ኤክዳ አያናፐነ ዎንገላፐ ሀራ አያናነ ዎንገላ ህንተዉ ኦድኮ፥ ስእ ግድ ኤኬታ።<verse eid="2CO 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5"/>ሽን ታኒ የሱሲ ኪትዳ “ግታ ሀዋረታ” ገተትድ ፀገተይሳታፐ ጉፃይስ ጋዳ ቆፕከ። <verse eid="2CO 11:5"/><verse number="6" style="v" sid="2CO 11:6"/>ታኒ ኦዳ ኤሮና አስ ግድኮካ፥ ኤራተ ታዉ ደኤስ። ሄሳ ታ ህንተዉ ዳሮ ኦገን ቆንጭሳስ።<verse eid="2CO 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7"/>ታኒ ሚሸ ኦይቾና ፆሳ ዎንገላ ህንተዉ ጮ ኦድዳይስነ ህንተና ቁ ኦዳ ታና ቶችዳይስ ታዉ ናጋራ ግዲ? <verse eid="2CO 11:7"/><verse number="8" style="v" sid="2CO 11:8"/>ታኒ ህንተዉ ኦናዉ ሀራ ዎሳ ኬታፐ ሚሸ ቦንቃ ኤካስ። <verse eid="2CO 11:8"/><verse number="9" style="v" sid="2CO 11:9"/>ታ ህንተራ ደእያ ዎደ ታና መትንካ ህንተፈ እስ አስካ ዋይሳብከ። ማቀዶነፐ ይዳ አማነይሳት ታና ኮሽያባ ኡባን ማድዶሶና። ሀች ጋካናዉ ታ ህንተዉ ቶሆ ግዳብከ ስንስካ ቶሆ ግድከ።<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PHP 4:15-18">ፍልጵ 4:15-18</ref>.</char></note> <verse eid="2CO 11:9"/><verse number="10" style="v" sid="2CO 11:10"/>ክርስቶሳ ቱማተይ ታናን ደእሽን፥ ታ ጬቁዋ አካያ ቢታን ታና ኦንካ ድገና። <verse eid="2CO 11:10"/><verse number="11" style="v" sid="2CO 11:11"/>ታ ሀይሳ አይስ ጋይና? ህንተና ዶሶና ግሾዬ? ታኒ ህንተና ዶሰይሳ ፆሳይ ኤሬስ።<verse eid="2CO 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12"/>“ኑካ ህንተ መላ ኦስ” ያግድ ጬቅያ ሀንኮ ሀዋረታ ጬቁዋ ጋሱዋ ይሳናዉ ሀእ ታ ኦይሳ ስንስካ ኦና። <verse eid="2CO 11:12"/><verse number="13" style="v" sid="2CO 11:13"/>ሀይሳ መላ አሳት ክርስቶሳ ሀዋረ ዳናናዉ ባንታና ላምያ ዎርዳንቾ ሀዋረታነ ጭምያ ኦሳንቾታ። <verse eid="2CO 11:13"/><verse number="14" style="v" sid="2CO 11:14"/>ሄስ ማላልስያባ ግደና፤ አይስ ጊኮ፥ ፃላሄይ ፖኦ ኪታንቾ ዳናናዉ ባና ላሜስ። <verse eid="2CO 11:14"/><verse number="15" style="v" sid="2CO 11:15"/>ሄሳ ግሾ፥ ፃላሄ ኦሳንቾት ፅሎተ ኦሳንቾታ ዳናናዉ ባንታና ላምኮ ሄስ ግታባ ግደና። ኤንቲ ዉርሰን ባንታ ኦሱዋዳ ኤካና።<verse eid="2CO 11:15"/></para>
  <para style="s1">ጳዉሎሳ ጋክዳ መቶ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16"/>ኦንካ ታና ኤያ ግድ ቆፖና መላ ዛራዳካ ኦዳይስ። ታ ህንተዉ ኤያ ዳንኮካ ታ ጉራ ጬቀታና መላ ታና ኤያ ኦድ ኤክተ። <verse eid="2CO 11:16"/><verse number="17" style="v" sid="2CO 11:17"/>ታኒ ሀይሳዳ ጬቀታዳ ኦደተይ፥ ጎዳይ ኮየይሳዳ ግዶናሽን፥ ኤያተን ኦዳይስ። <verse eid="2CO 11:17"/><verse number="18" style="v" sid="2CO 11:18"/>ዳሮ አሳይ ሀ ሳአባን ጬቀትያ ግሾ፥ ታካ ጬቀታና። <verse eid="2CO 11:18"/><verse number="19" style="v" sid="2CO 11:19"/>ህንተ ዎዛናማ ግድያ ግሾ፥ ኤያ አሳባ ኡፋይሳን ዳንዳኤታ። <verse eid="2CO 11:19"/><verse number="20" style="v" sid="2CO 11:20"/>ኦንካ ህንተና አይለይኮ ዎይኮ ህንተና ቦንቅኮ ዎይኮ ባዉ ማደታናዉ ህንተኮ ሺቅኮ ዎይኮ ህንተ ቦላ ኦቶርትኮ ዎይኮ ህንተና ባቅኮ ህንተ ዳንዳኤታ። <verse eid="2CO 11:20"/><verse number="21" style="v" sid="2CO 11:21"/>ኑኒ ሄሳ ኦናዉ ዳሮ ዳቡራንቾ ግደይሳ ዬላታሸ ታ ኦዳይስ።</para>
  <para style="p" vid="2CO 11:21">ሽን ኦንካ ምንድ ጬቀትኮ፥ ታካ ጬቀታናዉ ምናይስ። ታኒ ሄሳ ኤያ አሳዳ ኦደታይስ። <verse eid="2CO 11:21"/><verse number="22" style="v" sid="2CO 11:22"/>ኤንቲ እብራዌ? ታካ እብራወ። ኤንቲ እስራኤሌ? ታካ እስራኤለ። ኤንቲ አብራሃመ ሼሼ? ታካ አብራሃመ ሼሽ። <verse eid="2CO 11:22"/><verse number="23" style="v" sid="2CO 11:23"/>ኤንቲ ክርስቶሳ ኦሳንቾ? ታኒ ጎሻ አሳዳ ኦዳይስ፥ ኤንታፈ አያ ክርስቶሳ ኦሳንቾ። ታኒ ኦሶን ዳሮ ዳቡራስ፤ ዳሮ ዎደ ቃሸታስ፤ ጋራፈታስ፤ ዳሮ ዎደ ሀይቆፐ አታስ።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ACT 16:23">ሀዋ 16:23</ref>.</char></note> <verse eid="2CO 11:23"/><verse number="24" style="v" sid="2CO 11:24"/>አይሁደት ታና ሀስታማነ ኡዱፉና እቻሹ ቶሆ ጋራፍዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="DEU 25:3">ዛረ 25:3</ref>.</char></note> <verse eid="2CO 11:24"/><verse number="25" style="v" sid="2CO 11:25"/>ሄ ቶሆ ፃምአን ሾጨታስ፤ እስ ቶሆ ሹቻን ጫደታስ፤ ማርካበይ ሄ ቶሆ መእስ፤ አባ ግዶን እስ ቃማ ኩመ አቃዳ ፔአስ።<note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="ACT 16:22">ሀዋ 16:22</ref>፤ <ref loc="ACT 14:19">14:19</ref>.</char></note> <verse eid="2CO 11:25"/><verse number="26" style="v" sid="2CO 11:26"/>ታኒ ዳሮ ኦግያ ዳቡራን ሄመታስ። ክፃ ሃፈነ ፓንጋፈ አታስ። አይሁደትነ አይሁደ ግዶና አሳይ ታ ቦላ መቶ ጋዶሶና። ካታማይ፥ ባዞይ፥ አባይ፥ ታና ያሽስ፤ አማንያ ዳንያ አሳት ታና ዋይስዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="ACT 9:23">ሀዋ 9:23</ref>፤ <ref loc="ACT 14:15">14:15</ref>.</char></note> <verse eid="2CO 11:26"/><verse number="27" style="v" sid="2CO 11:27"/>ታኒ ኦሶን ዳቡራስነ ጫዋታስ፥ ዳሮ ቶሆ ስኮ ያስ፥ ኮሻታስ፥ ሳሞታስ፥ ዳሮ ቶሆ ፆማስ፥ ሜገታስ፥ ካሎታስ።<verse eid="2CO 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2CO 11:28"/>ሀራባ ኡባ ታይቦና ኡባ ዎደ ታና ቆፍሰይ ዎሳ ኬታባ። <verse eid="2CO 11:28"/><verse number="29" style="v" sid="2CO 11:29"/>እስ አስ ዳቡርያ ዎደ እያራ ታ ዳቡራብክና? እስ አስ ናጋራን በትያ ዎደ ታ አዉደ ቂሮቶና አጋድና?<verse eid="2CO 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30"/>ታ ጬቀታናዉ ኮሽያባ ግድኮ ታኒ ዳቡራንቾ ግደይሳ ኤርስያባን ጬቀታና። <verse eid="2CO 11:30"/><verse number="31" style="v" sid="2CO 11:31"/>መርናዉ ቦንቸትዳ ፆሳይ፥ ኑ ጎዳ የሱስ ክርስቶሳ አዋይ፥ ታ ዎርዶቶናይሳ ኤሬስ። <verse eid="2CO 11:31"/><verse number="32" style="v" sid="2CO 11:32"/>ዳማስቆ ካታማን ካዋ አርስፆሳፐ ጋርሳራ ሃረይስ ታና ኦይናዉ ኮይድ ዳማስቆ ካታማ ፐንግያ ናግስስ።<note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="ACT 9:23-25">ሀዋ 9:23-25</ref>.</char></note> <verse eid="2CO 11:32"/><verse number="33" style="v" sid="2CO 11:33"/>ሽን አሳይ ታና ዳቾን የግድ፥ ካታማ ድርሳ ማስኮትያራ ዎስን ታኒ እያ ኩሽያፐ አታስ።<verse eid="2CO 11:33"/></para>
  <chapter eid="2CO 11"/>
  <chapter number="12" style="c" sid="2CO 12"/>
  <para style="s1">ጳዉሎስ በእዳ ቆንጨ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1"/>ጬቀተስ ጎእ ባይናይሳ ኤራይስ። ሽን ጬቀታናዉ ኮሽኮ፥ ጎዳፐ ኤክዳ ቆንጨን ጬቃና። <verse eid="2CO 12:1"/><verse number="2" style="v" sid="2CO 12:2"/>ታማነ ኦይዱ ላይፈ ካሰ፥ ክርስቶሳ አማንያ እስ ኡራይ ሄን ሳሉዋ ብዳይሳ ታ ኤራይስ። ሄ ኡራይ አሾን ዎይኮ አሾፐ ካረራ ብዳኮ ታ ኤርከ፤ ፆሳይ ኤሬስ። <verse eid="2CO 12:2"/><verse number="3" style="v" sid="2CO 12:3"/>ሄ ኡራይ ሄን ሳሉዋ ኤከትዳይሳ ኤራይስ። ሽን እ አሾን ዎይኮ አሾፐ ካረራ ኤከትዳኮ ታ ኤርከ፤ ፆሳይ ኤሬስ። <verse eid="2CO 12:3"/><verse number="4" style="v" sid="2CO 12:4"/>ሄ ኡራይ ጋናተ ኤከትድ አስ ቆንጭሳናዉነ አስ ኦዳናዉ ዳንዳኦናባ ስእስ። <verse eid="2CO 12:4"/><verse number="5" style="v" sid="2CO 12:5"/>ታኒ ሄ አድያባን ጬቀታና፥ ሽን ታኒ ታ ዳቡራፐ አትሽን፥ ታናን ጬቀትያባይ ባዋ። <verse eid="2CO 12:5"/><verse number="6" style="v" sid="2CO 12:6"/>ታኒ ቱማ ኦደትያ ግሾ፥ ጬቀታናዉ ኮይኮካ ኤያ ግድከ። ሽን አስ ታ ኦይሳ በኤይሳፈነ ስኤይሳፈ አድ ቆፖና መላ ጋዳ ጬቀተ አጋይስ።<verse eid="2CO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7"/>ታዉ ቆንጭዳ ግታ ቆንጨን ታ ኦቶርቶና መላ ታና ዋይሳናዉ ታ አሹዋን ጫድያ ፃላህያ ኪታንቾይ ታዉ እመትስ። <verse eid="2CO 12:7"/><verse number="8" style="v" sid="2CO 12:8"/>ሀ ዋይስያባ ታፐ ድጋና መላ ታኒ ጎዳ ሄ ቶሆ ዎሳስ። <verse eid="2CO 12:8"/><verse number="9" style="v" sid="2CO 12:9"/>ሽን ጎዳይ፥ “ታ ዎልቃይ ነ ዳቡራን ቆንጭያ ግሾ ታ አ ኬሀተይ ነዉ ግዳና” ያግስ። ክርስቶሳ ዎልቃይ ታናን ቆንጫና መላ ታ ዳቡራን ኡፋይታሸ ጬቀታይስ። <verse eid="2CO 12:9"/><verse number="10" style="v" sid="2CO 12:10"/>ታኒ ክርስቶሳ ግሾ፥ ዳቡርያ ዎደ ጫየትያ ዎደ ዋየትያ ዎደ ጎደትያ ዎደ መቶትያ ዎደ ታ ዳቡራን ኡፋይታይስ። አይስ ጊኮ፥ ታ ዳቡርያ ዎደ፥ ሄ ዎደ ምናይስ።<verse eid="2CO 12:10"/></para>
  <para style="s1">ጳዉሎስ ቆሮንቶሳ አሳስ ቆፔስ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11"/>ታኒ ኤያ አሳዳ ጬቀታስ። ሄሳዳ ታ ጬቀታና መላ ኦዳይ ህንተና። ታ፥ ታ ሁጰን ኤረቶና አስ ግድኮካ፥ “ግታ ሀዋረታ” ጌተተይሳታፐ ጉፅከ። ሄሳ ታዉ ማርካታናዉ በሰይ ህንተናሽን። <verse eid="2CO 12:11"/><verse number="12" style="v" sid="2CO 12:12"/>ታ ህንተ ግዶን ደአሸ ዳንዳአን ኦዳ ማላታትነ ማላት ታ ቱማ ሀዋረ ግደይሳ በሶሶና። <verse eid="2CO 12:12"/><verse number="13" style="v" sid="2CO 12:13"/>ታ ህንተዉ ቶሆ ግዶናይሳፈ አትሽን፥ ሀራ ዎሳ ኬታፐ ህንተ አይብን ጉፅደቲ? ሄስ ባላ ግድኮ ታና ማርተ።<verse eid="2CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14"/>ታኒ ህንተኮ ባናዉ ጊገትሽን ሀይስ ታዉ ሄን። ታ ህንተናፐ አትሽን፥ ህንተዉ ደእያባ ኮዮና ግሾ ህንተና ዋይሳናዉ ኮይከ። የልዳይሳት ባንታ ናይታስ ሻሎ ምንጆሶናፐ አትሽን፥ ናይት ባንታና የልዳይሳታስ ሻሎ ምንጆኮና። <verse eid="2CO 12:14"/><verse number="15" style="v" sid="2CO 12:15"/>ታ ህንተ ግሾ፥ ታዉ ደእያባነ ታና አ እምንካ ታና ኡፋይሴስ። ያትን፥ ታኒ ህንተና ሄሳዳ ኬሀ ሲቅያ ዎደ ህንተ ታና ጉራ ሲቀቲ?<verse eid="2CO 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 12:16"/>ግድኮካ፥ ታ ህንተዉ ቶሆ ግድከ፤ ዋይሳብከ፤ ሽን ህንተና ጭሞንነ ገነን ኦይክዳባ ህንተዉ ዳኖና አገና። <verse eid="2CO 12:16"/><verse number="17" style="v" sid="2CO 12:17"/>ሀር አቶሽን፥ ታ ህንተኮ ኪትዳ አሳታፐ ህንተና ጭምዳ አስ ደኢ? <verse eid="2CO 12:17"/><verse number="18" style="v" sid="2CO 12:18"/>ትቶይ ህንተኮ ባና መላ ታኒ ዎሳስ፤ ቃስ አማንያ እሻካ እያራ የዳስ። ያትን፥ ትቶይ ህንተና ጭምዴ? ኑኒ ኑ ኦሱዋ እስ አያናን ኦቦኮ? ቃስ ኑ ሀኖይካ እስኖ ግደኔ?<verse eid="2CO 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19"/>ኑ ኡባ ዎደ ህንተ ስንን ኑና ፅልሳናዉ ሞተትያባ ህንተዉ ዳኒ? ኑ ክርስቶሳን ደእድ ፆሳ ስንን ሀእ ጋካናዉ ኦዶስ። ኑ ሲቆ እሻቶ፥ ኑ ሀ ኡባ ኦይ ህንተና ድቻናሳ። <verse eid="2CO 12:19"/><verse number="20" style="v" sid="2CO 12:20"/>ታ ህንተኮ ብያ ዎደ ኦን ኤር ህንተ ታ ኮየይሳዳ ሀኖና፥ ቃስ ታካ ህንተ ኮየይሳዳ ሀኖና ጋሄቶና አጎኮ ጋዳ ያያይስ። ቃስ ኦን ኤር ህንተ ግዶን ፓላም፥ ቃናተይ፥ ሀንቆይ፥ ዪቀይ፥ ዝግርስ፥ አሳ ሱን ኢሶይ፥ ኦቶሮይነ ካች ዶና አገና ጋዳ ያያይስ። <verse eid="2CO 12:20"/><verse number="21" style="v" sid="2CO 12:21"/>ታኒ ናምአን ህንተኮ ብያ ዎደ ፆሳይ ህንተ ስንን ታና ካዉሻና ጋዳ ያያይስ። ካሰ ናጋራ ኦድ ሄ ባንታ ኦዳ ቱናተፈ፥ ላይማተፈነ ዬላይያ ኦሱዋፐ ስምቦና አሳታ በአዳ አዛኖና አግከ ጋዳ ያያይስ።<verse eid="2CO 12:21"/></para>
  <chapter eid="2CO 12"/>
  <chapter number="13" style="c" sid="2CO 13"/>
  <para style="s1">ዞረነ ሳሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1"/>ታ ህንተኮ ብሽን ሀይስ ሄን። አይ ሞቶይካ ናምኡ ዎይኮ ሄ ማርካን ምኔስ።<note caller="-" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ዛረ 17:6</ref>፤ <ref loc="DEU 19:15">19:15</ref>.</char></note> <verse eid="2CO 13:1"/><verse number="2" style="v" sid="2CO 13:2"/>ታኒ ናምአን ህንተራ ጋሄትዳ ዎደ ህንተ ግዶን ካሰ ናጋራ ኦዳ ኡራነ ሀራታ ኡባ ሴሮና አግከ ጋዳ ኦዳ ዎስ። ሀእ ታ ሃካዳ ደእኮካ ስማዳ ህንተኮ ብያ ዎደ ኦደስካ ቃትከ።<verse eid="2CO 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 13:3"/>ታናን ደእድ ኦደይ ክርስቶሳ ግደይሳ ህንተ ኤራናዉ ኮዬታ። እ ህንተራ ሃሳያ ዎደ ዎልቃማፐ አትሽን፥ ህንተ ግዶን ዳቡራንቾ ግደና። <verse eid="2CO 13:3"/><verse number="4" style="v" sid="2CO 13:4"/>ክርስቶስ ማስቃለ ቦላ ዳቡራን ካቀትስ፥ ሽን ፆሳ ዎልቃን ደኦን ደኤስ። እ ዳቡራንቾ ግድዳይሳዳ፥ ኑካ ዳቡራንቾ። ሽን ህንተና ሀጋዛናዉ ፆሳ ዎልቃን እያራ ደኦን ዳና።<verse eid="2CO 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5"/>አማኖን ምንድ ደእያኮ ህንተና ህንተዉ ፓጭድ በእተ። ፓጨን ህንተ ኩንዶና አትኮ፥ ክርስቶስ ህንተናን ደኤይሳ ህንተ ኤሬታ። ሽን ክርስቶስ ህንተናን ዶና እፅኮ ህንተ ኩንዴታ። <verse eid="2CO 13:5"/><verse number="6" style="v" sid="2CO 13:6"/>ኑኒ ፓጨን ኩንዶናይሳ ህንተ ኤሬታ ጋዳ አማናይስ።<verse eid="2CO 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 13:7"/>ህንተ ኢታባ ኦና መላ ኑኒ ፆሳ ዎሶስ። ኑኒ ምኖ ግደይሳ አሳይ በአና መላ ግዶናሽን፥ ኑኒ ምኖ ግዶና እፅኮካ፥ ህንተ ሎኦ ኦና መላ ኑኒ ዎሶስ። <verse eid="2CO 13:7"/><verse number="8" style="v" sid="2CO 13:8"/>ኑኒ ቱማስ ኦስፐ አትሽን፥ ቱማራ ኤቀትያባ አይባካ ኦኮ። <verse eid="2CO 13:8"/><verse number="9" style="v" sid="2CO 13:9"/>ኑ ዳቡርያ ዎደ ህንተ ቃስ ምንያ ዎደ ኑና ኡፋይሴስ። ህንተ ቦረይ ባይናይሳታ ግዳና መላ ኑ ህንተዉ ፆሳ ዎሶስ።<verse eid="2CO 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 13:10"/>ታኒ ህንተፈ ሃካዳ ደአሸ ፃፍዳይ ሄሳ ግሾሳ። ታኒ ህንተኮ ብያ ዎደ ጎዳይ ታዉ እምዳ ማታን ዘምፓዳ ህንተ ቦላ ጎዳታናዉ ኮይከ። ጎዳይ ታዉ ማታ እምዳይ፥ ህንተና ማዳናሳፈ አትሽን፥ ቆሀናሳ ግደና።<verse eid="2CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11"/>ዉርሰን ታ እሻቶ፥ ሳሮ ደእተ። ቦረይ ባይና ደእተ፤ ታ ዞርያ ስእተ። እስ ዎዛናን ግድድ ደእተ፤ ሳሮተን ደእተ። ሲቆነ ሳሮ እምያ ፆሳይ ህንተራ ግዶ።<verse eid="2CO 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12"/>ጌሻ ዬረተ ዬረትሸ፥ እሶይ እሱዋ ሳሮተ። <verse eid="2CO 13:12"/><verse number="13" style="v" sid="2CO 13:13"/>ፆሳ አሳ ኡባይ ህንተና ሳሮ ሳሮ ያጎሶና።<verse eid="2CO 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 13:14"/>ጎዳ የሱስ ክርስቶሳ አ ኬሀተይ፥ ፆሳ ሲቆይ፥ ጌሻ አያና እስፈተይ ህንተ ኡባራ ግዶ።<verse eid="2CO 13:14"/></para>
  <chapter eid="2CO 13"/>
</usx>
