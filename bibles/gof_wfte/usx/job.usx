<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOB" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">እዮባ ማፃፋ</para>
  <para style="toc1">እዮባ ማፃፋ</para>
  <para style="toc3">እዮ</para>
  <para style="toc2">እዮባ</para>
  <para style="mt">እዮባ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">እዮባ ማፃፋን በእያ ታርከይ፥ ዳሮ ዋየነ መቶይ ጋክዳ እስ ፅሎ አሳ ታርከ። እዮብነ እያ ላገት ሄ ዋይያ ጋሶን ባንታዉ ስኤትዳባ ግንፆን ቆንጭስዳ ሄ ኦዳታ በኦስ።</para>
  <para style="ip">እዮባ ላገት እዮባ ጋክዳ መቱዋባ፥ በንፐ ኤርያ ባንታ አማኑዋ ዎጋን ዘምፕድ ቆፋ እሞሶና። ሄሳ ግሾ ኤንቲ፥ “ፆሳይ ፅሎ አሳስ ሎኦባ እሜስ፤ ሽን ኢታ አስ ሴሬስ። እዮባ ሀ ዋየ ኡባይ ጋክዳይ፥ እ ናጋራ ኦዳ ግሾሳ” ያጎሶና። እዮብ ጌሽነ ፅሎ አስ ግድዳ ግሾ፥ ሄሳ መላ ሴር በሲያ አሰ ግደና። ግዶሽን፥ ሄሳ መላ ዋየይ እያ አይስ ጋክዳኮ እዮብ ኤራናዉ ዳንዳእቤና። እዮባ አማኖይ ቃፆና እፅኮካ፥ ሱረ ፕርዳ እምድ፥ ባና ላአ ከሳና መላነ በን እያ ደኡዋኮ ዛራና መላ፥ ምንድ ፆሰ ዎስስ።</para>
  <para style="ip">ፆሳይ ኦይችዳ ኦይሻስ እዮብ ዛሮ እማናዉ ዳንዳኦና እፅኮካ፥ እያ አማኖ ምኖተ ናሽድ፥ ባ ዎልቃነ ጭንጫተ ማላልስያ ኦገን ቆንጭስስ። ሄሳፈ ጉየ፥ እዮብ ፆሳይ ግታ ግደይሳነ ጭንጫ ግደይሳ ኤርድ፥ ምኖተነ ሀንቆይ ኩምዳ ቃላታ ኦደትዳ ግሾ ቂሮትድ ማሮታ ኦይችስ።</para>
  <para style="ip">ዉርሰን እዮብ በን ደኡዋኮ ስምዳይሳነ እያ አቁዋ ካሰይሳፈ ዳኮ ዳርስዳይሳ ኦዴስ። እዮባ ላገት እያ ጋክዳ መቶይ አዉራ ይዳኮ ኤንታዉ ገልቦና ግሾ፥ ፆሳይ ኤንታ ቦላ ሀንቀትስ። ሜዘ አማኖ ቆፋፐ አድ ፆሳይ ግታ ግደይሳ ኤርዳይ እዮባ ፃላላ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">እዮባ ጋክዳ መቱዋነ ዋይያ (<char style="ior"><ref loc="JOB 1:10-2:13">1:10—2:13</ref></char>)</para>
  <para style="io1">እዮባነ እዮባ ላገታ ኦዳ (<char style="ior"><ref loc="JOB 3:1-31:40">3:1—31:40</ref></char>)</para>
  <para style="io2">ኮይሮ ሃሳያ (<char style="ior"><ref loc="JOB 4:1-14:22">4:1—14:22</ref></char>)</para>
  <para style="io2">ናምአን ሃሳያ (<char style="ior"><ref loc="JOB 15:1-21:34">15:1—21:34</ref></char>)</para>
  <para style="io2">ሄን ሃሳያ (<char style="ior"><ref loc="JOB 22:1-31:40">22:1—31:40</ref></char>)</para>
  <para style="io1">ኤልሁ ሃሳያ (<char style="ior"><ref loc="JOB 32:1-37:24">32:1—37:24</ref></char>)</para>
  <para style="io1">ፆሳይ እዮባስ ዛሮ እሚስ (<char style="ior"><ref loc="JOB 38:1-42:6">38:1—42:6</ref></char>)</para>
  <para style="io1">ፆሳይ እዮባ ዛሪድ ኡባባን አንጅስ (<char style="ior"><ref loc="JOB 42:7-17">42:7-17</ref></char>)</para>
  <chapter number="1" style="c" sid="JOB 1"/>
  <para style="s1">እዮባ ፓጨተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 1:1"/>ኡፀ ቢታን እዮባ ጌተትያ እስ አስ ደኤስ፤ እ ቦረይ ባይና አስ፥ ሱረ አስ፥ ፆሰ ያይያነ ኢታባፐ ሃክዳ አስ። <verse eid="JOB 1:1"/><verse number="2" style="v" sid="JOB 1:2"/>እያዉ ላፑን አደ ናይትነ ሄ ማጫ ናይት ደኦሶና። <verse eid="JOB 1:2"/><verse number="3" style="v" sid="JOB 1:3"/>እያዉ ላፑን ሙኩሉ ዶርሳት፥ ሄ ሙኩሉ ግማለት፥ እቻሹ ፄቱ ዋ ቦራት፥ እቻሹ ፄቱ ማጫ ሀረትነ ዳሮ አይለት ደኦሶና። ዶሎሀ ባጋ ቢታን ደእያ አሳ ኡባፈ እ አዳ ዱረ አስ።<verse eid="JOB 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 1:4"/>እያ አደ ናይት ባንታ ሶን ሶን ግብራ ጊግስድ፥ ባንታ ሄ ምቸታ ፄግድ እስፈ ሞሶናነ ኡዮሶና። <verse eid="JOB 1:4"/><verse number="5" style="v" sid="JOB 1:5"/>ግብራ ጋላሳት ፖለትያ ዎደ እዮብ ባ ናይታ ፄግስድ፥ “ኦን ኤር ታ ናይት ባንታ ዎዛናን ፆሰ ባድድ ናጋራ ኦና አጎኮና” ግድ ዎንታ ጉራ ደንድድ፥ ኤንታና ጌሻናዉ ባ ናይታ እሱዋ እሱዋ ሱን ፄግድ ፁሳ ያርሾ ያርሼስ። እዮብ ሄሳ ኡባ ዎደ ኦስ።<verse eid="JOB 1:5"/></para>
  <para style="s1">እዮባ ኮይሮ ፓጨተ</para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 1:6"/>እስ ጋላስ ኪታንቾት ጎዳ ስንን በንታናዉ ይዶሶና፤ ፃላሄይካ ቃስ ኤንታራ ይስ። <verse eid="JOB 1:6"/><verse number="7" style="v" sid="JOB 1:7"/>ጎዳይ ፃላህያኮ፥ “ኔኒ አዉፐ ያዲ?” ያግስ።</para>
  <para style="p" vid="JOB 1:7">ፃላሄይ፥ “ታኒ ሳአ ኡባን ያነ ሃነ ዩያሸ ጋምአስ” ያግድ ዛርስ።<verse eid="JOB 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JOB 1:8"/>ጎዳይ ፃላህያኮ፥ “ያትን፥ ኔኒ ታ አይልያ እዮባ ሎይ በአዲ? ሳአ ቦላ እያ መላ ቦረይ ባይና አስ፥ ሱረ አስ፥ ፆሰ ያይያነ ኢታባፐ ሃክዳ አስ ባዋ” ያግስ።<verse eid="JOB 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 1:9"/>ፃላሄይ ዛሪድ፥ “ቱማ እዮብ ፆሳስ ጮ ያዪ? <verse eid="JOB 1:9"/><verse number="10" style="v" sid="JOB 1:10"/>እያነ እያ ሶ አሳ፥ እያዉ ደእያባ ኡባ ኔኒ ድራዳ ናጋብኪ? እ ኦያ ኦሶ ኡባ ኔኒ አንጅዳ ግሾ እያ መሄ ዉደይ ቢታ ኡባ ቦላ ዳርስ። <verse eid="JOB 1:10"/><verse number="11" style="v" sid="JOB 1:11"/>ሽን ኔኒ ነ ኩሽያ የዳዳ፥ እያዉ ደእያ አቁዋ ኡባ ሾጭያኮ፥ ቱማ እ ነና ሶምኦን ባዳና” ያግስ።<verse eid="JOB 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 1:12"/>ጎዳይ ፃላህያኮ፥ “ኤሮ ሎኦ፥ እያዉ ደእያባ ኡባይ ነ ኩሸና፥ ሽን እያ ቦቾፋ” ያግስ። ሄሳፈ ጉየ፥ ፃላሄይ ጎዳ ስንፈ ከይድ ብስ።<verse eid="JOB 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JOB 1:13"/>እስ ጋላስ እዮባ አደ ናይትነ ማጫ ናይት ባንታ ባይራ እሻ ሶን ሞሶናነ ዎይነ ኡሽ ኡዮሶና። <verse eid="JOB 1:13"/><verse number="14" style="v" sid="JOB 1:14"/>እስ ኪተትዳ አስ እዮባኮ ይድ፥ “ኑኒ ቦራታ ዋፅድ ጎይሽን፥ ሀረትካ ኑ ማታን ምሽን፥ <verse eid="JOB 1:14"/><verse number="15" style="v" sid="JOB 1:15"/>ሳባ ቢታ አሳት አኬኮና ይድ ኦላ ከስድ፥ ኡባ ቦንቅድ ኤክዶሶና፤ ቃስ አይለታካ ማሻን ዎዶሶና። ያትን፥ ታኒ ታ ፃላላ አታዳ ሀ ሀንዳባ ነዉ ኦዳናዉ ያስ” ያግስ።<verse eid="JOB 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 1:16"/>እ ቡሮ ኦድሽን ሀራ አስ ይድ፥ “ሳሎፐ ታም ዎድ ዶርሳታነ ሄመይሳታ ምስ። ያትን፥ ታኒ ታ ፃላላ አታዳ ሀ ሀንዳባ ነዉ ኦዳናዉ ያስ” ያግስ።<verse eid="JOB 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JOB 1:17"/>እ ቡሮ ኦድሽን ሀራ አስ ይድ፥ “ካልዳወት ሄ ጩጋን ሻከትድ ይድ፥ ኑና ኦልድ ግማለታ ኡባ ኤክ ብዶሶና፤ አይለታካ ማሻን ዎዶሶና። ያትን፥ ታኒ ታ ፃላላ አታዳ ሀ ሀንዳባ ነዉ ኦዳናዉ ያስ” ያግስ።<verse eid="JOB 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JOB 1:18"/>እ ቡሮ ኦድሽን፥ ሀራ አስ ይድ፥ “ነ አደ ናይትነ ማጫ ናይት ባንታ ባይራ እሻ ሶን ምሼነ ዎይነ ኡሽ ኡይሼ ደእሽን፥ <verse eid="JOB 1:18"/><verse number="19" style="v" sid="JOB 1:19"/>ዎልቃማ ጎተይ አኬኮና መላ ቢታፈ ደንድድ፥ ኬ ሾጭን፥ ኬይ ኤንታ ቦላ ኩንድድ ናይታ ዎስ። ያትን፥ ታኒ ታ ፃላላ አታዳ ሀ ሀንዳባ ነዉ ኦዳናዉ ያስ” ያግስ።<verse eid="JOB 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JOB 1:20"/>ሄሳፈ ጉየ፥ እዮብ ደንድድ፥ ካዮስ ባ ማኡዋ ፔስ፤ ባ ሁጵያ ቡሉስስ፤ ቢታን ጉፋንድ ጎይንሸ፥<verse eid="JOB 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 1:21"/>“ታኒ ታ አየ ኡሎፐ ካሎ የለታስ፤</para>
  <para style="q2" vid="JOB 1:21">ሀይቃሸካ ታኒ ካሎ ባና፤</para>
  <para style="q1" vid="JOB 1:21">ጎዳይ እሚስ፤ ጎዳይ ዛሪድ ኤክስ፤</para>
  <para style="q2" vid="JOB 1:21">ጎዳ ሱንይ ጋላተቶ” ያግስ።<verse eid="JOB 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JOB 1:22"/>ሀ ኡባንካ እዮብ ናጋራ ኦቤና፤ ፆሳ ቦላ ኢታባ ኦደትቤና።<verse eid="JOB 1:22"/></para>
  <chapter eid="JOB 1"/>
  <chapter number="2" style="c" sid="JOB 2"/>
  <para style="s1">እዮባ ናምአን ፓጨተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 2:1"/>ሀራ ጋላስ ኪታንቾት ጎዳ ስንን በንታናዉ ይዶሶና፤ ፃላሄይካ ቃስ ኤንታራ እስፈ እያ ስንን በንታናዉ ይስ። <verse eid="JOB 2:1"/><verse number="2" style="v" sid="JOB 2:2"/>ጎዳይ ፃላህያኮ፥ “ኔኒ አዉፐ ያዲ?” ያግስ።</para>
  <para style="p" vid="JOB 2:2">ፃላሄይ ጎዳኮ፥ “ታኒ ሳአ ኡባን ያነ ሃነ ዩያሸ ጋምአስ” ያግስ።<verse eid="JOB 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOB 2:3"/>ጎዳይ ፃላህያኮ፥ “ኔኒ ታ አይልያ እዮባ ሎይዳ በአዲ? ሳአ ቦላ እያ መላ ቦረይ ባይና አስ፥ ሱረ አስ፥ ፆሰ ያይያነ ኢታባፐ ሃክዳ አስ ባዋ። ጋሶይ ባይና ታኒ እያ ይሳና መላ ነ ታና ደንንካ ሀእ ጋካናዉ እ ባ ሱረተን ምንድ ኤቅስ” ያግስ።<verse eid="JOB 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 2:4"/>ፃላሄይ ዛሪድ፥ “ነ ሸምፖይ አቶ” አስ ገይሳዳ አስ ባ ሸምፑዋ ግሾ ባዉ ደእያባ ኡባ እሜስ። <verse eid="JOB 2:4"/><verse number="5" style="v" sid="JOB 2:5"/>ሽን፥ “ኔኒ ነ ኩሽያ የዳዳ እያ አሳተ ቦችያኮ፥ እ ነና ቱማ ሶምኦን ባዳና” ያግስ።<verse eid="JOB 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 2:6"/>ጎዳይ ፃላህያኮ፥ “ኤሮ ሎኦ፥ እያ ዎፓፈ አትሽን፥ እያ ቦላ ነ ኮይዳባ ኦናዉ ዳንዳኣሳ” ያግስ።<verse eid="JOB 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 2:7"/>ሄሳፈ ጉየ፥ ፃላሄይ ጎዳ ስንፈ ከይድ፥ እዮባ ቶሆፐ ሁጰ ጋካናዉ ኢታ ማዱንን ካኤታና መላ ኦስ። <verse eid="JOB 2:7"/><verse number="8" style="v" sid="JOB 2:8"/>እዮብ ብዶ ቦላ ኡትድ ኮንአን ባና ጎድስ።<verse eid="JOB 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 2:9"/>እያ ማችያ፥ “ሀእ ጋካናዉካ ኔኒ ነ ሱረተ ምን ኦይካዲ? ፆሳ ባዳዳ ሀይቃጋ” ያጋሱ።<verse eid="JOB 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 2:10"/>እዮብ ዛሪድ፥ “ኔኒ ኤያ ማጫሳዳ ዋናዳ ኦደታይ? ኑኒ ፆሳፈ ሎኦባ ኤክ ጋምእድ፥ ኢታባይ ጋክያ ዎደ ኤኮኮዬ?” ያግስ።</para>
  <para style="p" vid="JOB 2:10">ሀ ዋየ ኡባን እዮብ ፆሳ ቦላ ኢታባ ኦደትቤና።<verse eid="JOB 2:10"/></para>
  <para style="s1">ሄ እዮባ ላገታ</para>
  <para style="p">
    <verse number="11" style="v" sid="JOB 2:11"/>ሄ እዮባ ላገት፥ ተማና ቢታፈ ኤልፋዝ፥ ሹሀ ቢታፈ በልዳዶስነ ናእማ ቢታ አስ ግድዳ ሶፋር እዮባ ቦላ ጋክዳ መቱዋ ስእዳ ዎደ እያዉ ቃታናዉነ ምንናዉ እስፈ እያኮ ይዶሶና። <verse eid="JOB 2:11"/><verse number="12" style="v" sid="JOB 2:12"/>ኤንቲ እያ ሃሆን ኤቅድ ፄልያ ዎደ እ እዮባ ግደይሳ ኤርቦኮና። ጉየፐ እያ ግደይሳ ኤርዳ ዎደ ባንታ ቃላ ቁ ኦድ ዬክዶሶና፤ ባንታ ማኡዋ ፔድ፥ ባንታ ሁጰን ባና ቆልዶሶና። <verse eid="JOB 2:12"/><verse number="13" style="v" sid="JOB 2:13"/>ኤንቲ እያራ ላፑን ጋላስነ ላፑን ቃማ ቢታን ኡትዶሶና። ኤንቲ እያ ዋየይ ኬህ ዳሮ ግደይሳ በእዳ ግሾ ኦንካ እያ ኦድስቤና።<verse eid="JOB 2:13"/></para>
  <chapter eid="JOB 2"/>
  <chapter number="3" style="c" sid="JOB 3"/>
  <para style="s1">እዮባ ሃሳያ</para>
  <para style="p">
    <verse number="1-2" style="v" sid="JOB 3:1-2"/>ሄሳፈ ጉየ፥ እዮብ ባ ዶና ዶይድ፥ ባ የለትዳ ጋላሳ ሀይሳዳ ያግድ ባድስ።<verse eid="JOB 3:1-2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 3:3"/>“ታኒ ቃንትዳ ቃማይነ</para>
  <para style="q2" vid="JOB 3:3">የለትዳ ጋላሳይ ባደትዳባ ግዶ!<verse eid="JOB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 3:4"/>ሄ ጋላሳይ ማን ላመቶ!</para>
  <para style="q2" vid="JOB 3:4">ሳሎ ፆሳይ ሄ ጋላሳ ቆፖፎ፤</para>
  <para style="q2" vid="JOB 3:4">እያ ቦላ ፖኦይካ ፖኦፖ።<verse eid="JOB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 3:5"/>ሳካና ምነ ጫጋን እያ ጎዞ፤</para>
  <para style="q2" vid="JOB 3:5">እያ ሻሪ ካሞ፤</para>
  <para style="q2" vid="JOB 3:5">እያ ፖኡዋ ም ቆሶ።<verse eid="JOB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 3:6"/>ሄ ጋላሳ ቃማ ሳካና ም ኦይኮ።</para>
  <para style="q2" vid="JOB 3:6">ላይ ግዶን ደእያ ጋላሳታን ታይበቶፎ፤</para>
  <para style="q2" vid="JOB 3:6">አጌናታ ታይቦንካ ገሎፖ።<verse eid="JOB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 3:7"/>ሄ ቃማይ ማይኖ፤</para>
  <para style="q2" vid="JOB 3:7">ኡፋይሳ እልልስ እያን ስኤቶፎ።<verse eid="JOB 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 3:8"/>ሌዋታነ<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="fk" closed="false">ሌዋታነ፦ </char><char style="ft" closed="false">ሃን ደእያ ዎልቃማ ዶአ።</char></note> ደንናዉ ዳንዳኤይሳትነ</para>
  <para style="q2" vid="JOB 3:8">ጋላሳታ ባደይሳት ሄ ጋላሳ ባዶ።<verse eid="JOB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 3:9"/>ሄ ቃማን ባካል ፖኦፖ፤</para>
  <para style="q2" vid="JOB 3:9">ፖኦ ናግድ ደሞፎ፤</para>
  <para style="q2" vid="JOB 3:9">ዎንታ ፃልቀይ እያዉ ዶሎፖ።<verse eid="JOB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 3:10"/>ሄ ጋላሳይ ታኒ ታ አየ ኡሎን ቃንቶና መላነ</para>
  <para style="q2" vid="JOB 3:10">ሀ ዋይያ በኦና መላ አሽቦና ግሾ ባደትዳይሳ ግዶ።<verse eid="JOB 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 3:11"/>“ታኒ ታ አየ ኡሎን ሃ ግድዳ ግዳርክና!</para>
  <para style="q2" vid="JOB 3:11">ታ አየ ኡሎፐ የለታ ዎዳ መላ ሀይቅዳ ግዳርክና!<verse eid="JOB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 3:12"/>ታ አይያ ታና አይስ ባ ክኦን ኤካደሻ?</para>
  <para style="q2" vid="JOB 3:12">ባ ንካ ታና አይስ ንደሻ?<verse eid="JOB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 3:13"/>ሄ ዎደ ታኒ ሀይቅዳባ ግድያኮ፥</para>
  <para style="q2" vid="JOB 3:13">ሀእ ታኒ ሸምፓዳ ስካና ሽን!<verse eid="JOB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 3:14"/>ሀእ ላለትዳ በሳታ ባንታዉ ኬፅዳ፥</para>
  <para style="q2" vid="JOB 3:14">ሀ ሳኣ ካዎታራነ ዞረይሳታራ፥<verse eid="JOB 3:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="JOB 3:15"/>ኤንታ ኬን ዎርቃይነ ብራይ ኩምዳ ሀላቃታራ</para>
  <para style="q2" vid="JOB 3:15">እስፈ ዱፎን ዝንአናሽን!<verse eid="JOB 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 3:16"/>ዎይኮ ቦሻ ግድድ የለትዳ ናአዳ፥</para>
  <para style="q2" vid="JOB 3:16">ጋላሳ ፖኦ በእቦና ዮጋ ናአዳ ቢታ ግዶን አይስ ቆሰታብክና?<verse eid="JOB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 3:17"/>ዱፎን ኢታት ባንታ ኢታ ኦሶ አጎሶና፤</para>
  <para style="q2" vid="JOB 3:17">ያን ዳቡራንቾት ሸምፖሶና።<verse eid="JOB 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 3:18"/>ሄ በሳን ቃሾ አሳት ሸምፕድ ኡፋይቶሶና፤</para>
  <para style="q2" vid="JOB 3:18">ኤንታ ኡንኤይሳታ ዋሱዋ ያን ስኦኮና።<verse eid="JOB 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 3:19"/>ግትነ ጉ ያን ደኤስ፤</para>
  <para style="q2" vid="JOB 3:19">አይለትካ አይለተፈ ያን ላአ ከዮሶና።<verse eid="JOB 3:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 3:20"/>“መቶን ደኤይሳታስ፥</para>
  <para style="q2" vid="JOB 3:20">ሸምፖይ ጫመትዳይሳታስ፥</para>
  <para style="q2" vid="JOB 3:20">ፖኦይ አይስ እመትዴ?<verse eid="JOB 3:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOB 3:21"/>ሀይቆ አሞትድ ደሞናይሳታስ፥</para>
  <para style="q2" vid="JOB 3:21">ቆትድ ዎዳ ሻሎፐ አድ ኮየይሳታስ፥</para>
  <para style="q2" vid="JOB 3:21">ደኦይ አይስ እመትዴ?<verse eid="JOB 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 3:22"/>ዱፎ ጋክያ ዎደ ኡፋይተይሳታስ፥</para>
  <para style="q2" vid="JOB 3:22">ደኦይ አይስ እመትዴ?<verse eid="JOB 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 3:23"/>ኦገይ ይዳ ኡራስ፥</para>
  <para style="q2" vid="JOB 3:23">ፆሳይ እያ ዩሹዋ ድርዳ ኡራስ፥</para>
  <para style="q2" vid="JOB 3:23">ፖኦይ አይስ እመትዴ?<verse eid="JOB 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 3:24"/>ኦለይ ታዉ ካ ግድስ፤</para>
  <para style="q2" vid="JOB 3:24">ታ ዋሶይ ጎግያ ሃ ግድስ።<verse eid="JOB 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 3:25"/>ታኒ ያይዳባይ ታ ቦላ ጋክስ፤</para>
  <para style="q2" vid="JOB 3:25">ታኒ ዳጋምዳባይ ታዉ ሀንስ።<verse eid="JOB 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 3:26"/>ታዉ መቶፐ አትሽን፥</para>
  <para style="q2" vid="JOB 3:26">ሳሮይ፥ ዎፕነ ሸምፖይ ባዋ” ያግስ።<verse eid="JOB 3:26"/></para>
  <chapter eid="JOB 3"/>
  <chapter number="4" style="c" sid="JOB 4"/>
  <para style="s1">ኤልፋዛ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 4:1"/>ተማናፐ ይዳ ኤልፋዝ ዛሪድ፥<verse eid="JOB 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 4:2"/>“እስ አስ ፃልታምድ ኔራ ኦደትኮ ኔኒ ላንጫኔ?</para>
  <para style="q2" vid="JOB 4:2">ሽን ሃሳዮና አጋናይ ኦኔ?<verse eid="JOB 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 4:3"/>ሄኮ፥ ኔኒ ዳሮታ ታማርሳዳሳ፤</para>
  <para style="q2" vid="JOB 4:3">አርጋጭዳ ኩሸታ ምንዳሳ።<verse eid="JOB 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 4:4"/>ነ ቃላይ በትዳይሳታ ኮልድ ኤስስ፤</para>
  <para style="q2" vid="JOB 4:4">ዳቡርዳ ጉልባታታ ምንስ።<verse eid="JOB 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 4:5"/>ሽን ሀእ መቶይ ነና ጋክን ኡፋይስ ቃንፃዳሳ፤</para>
  <para style="q2" vid="JOB 4:5">ኡንእ ነና ተቅን ዳጋማዳሳ።<verse eid="JOB 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 4:6"/>ነ ፆሳስ ያየይስ ነና አማንድ ዎቤኔ?</para>
  <para style="q2" vid="JOB 4:6">ነ ሱረ ሄመይ ነዉ ኡፋይስ ግድቤኔ?<verse eid="JOB 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 4:7"/>“አነ ቆፓ፤ ጌሻ አስ ግድድ ይዳይ ኦኔ?</para>
  <para style="q2" vid="JOB 4:7">ሱረ አስ ግድድ ሾደትድ ይዳይ ኦኔ?<verse eid="JOB 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 4:8"/>ታ በእዳይሳዳ፥ ኢታተ ጎይድ መቶ ዘረይሳት፥</para>
  <para style="q2" vid="JOB 4:8">እያ ዛሪድ ቡጫና።<verse eid="JOB 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 4:9"/>ኤንቲ ፆሳፈ ከያ ሸምፖን ፑነትድ ያና፤</para>
  <para style="q2" vid="JOB 4:9">እያ ሀንቁዋ ላጩዋን ሜተታና።<verse eid="JOB 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 4:10"/>ኢታት ጉድያ ጋሞ መላ ፃጎሶና፤</para>
  <para style="q2" vid="JOB 4:10">ሽን ኤንታ አቻይ መቀረትስ።<verse eid="JOB 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 4:11"/>ሻንካትድ ምያባ ይዳ ጋሞይ ሀይቀይሳዳ፥</para>
  <para style="q2" vid="JOB 4:11">ኤንታ ናይትካ ላለተይሳዳ ኢታታ ናይት ላለታና።<verse eid="JOB 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 4:12"/>“እስ ጋላስ እስ ፁራይ ታኮ ይስ፤</para>
  <para style="q2" vid="JOB 4:12">ሄ ፁራ ካልካሻን ታ ስአስ።<verse eid="JOB 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 4:13"/>ዎልቃማ ስኮይ አሰ ኦይክዳ ዎደ</para>
  <para style="q2" vid="JOB 4:13">ኡንኤያ ቃማ አሙሆ ግዶን፥<verse eid="JOB 4:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="JOB 4:14"/>ያሽነ ኮኮርስ ታና ኦይክስ፤</para>
  <para style="q2" vid="JOB 4:14">ታ መቀት ኮኮርዶሶና።<verse eid="JOB 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 4:15"/>ጫርኮይ ታ ሶምኡዋ ባቅድ አስ፤</para>
  <para style="q2" vid="JOB 4:15">ታ ዳጋምን ታ አሳተ እክሰይ ኤቅስ።<verse eid="JOB 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 4:16"/>እ ታ ስንን ኤቅስ፤</para>
  <para style="q2" vid="JOB 4:16">ሽን እ አይበኮ ሻካዳ ኤራብከ።</para>
  <para style="q1" vid="JOB 4:16">ሄሳፈ ጉየ፥ ስእ ግዳ በሳፈ</para>
  <para style="q2" vid="JOB 4:16">ሀይሳዳ ግያ ግርሳ ስአስ።<verse eid="JOB 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 4:17"/>‘ሀይቅያ አስ ፆሳ ስንን ፅሎ ግዳናዉ ዳንዳኢ?</para>
  <para style="q2" vid="JOB 4:17">ዎይኮ አስ ባና መዳይሳ ስንን ጌሽ ግዳናዉ ዳንዳኢ?<verse eid="JOB 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 4:18"/>ፆሳይ ባ አይለታን አማነቶናባ ግድኮ፥</para>
  <para style="q2" vid="JOB 4:18">ባ ኪታንቾታንካ ባላ ደምያባ ግድኮ፥<verse eid="JOB 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 4:19"/>ያትን፥ ኡርቃ ኬን ደኤይሳት፥</para>
  <para style="q2" vid="JOB 4:19">ኤንታ ደኡዋ ባሶይ ቢታ ግድዳይሳት፥</para>
  <para style="q2" vid="JOB 4:19">ጉፁነፐ ኤሶን ሀይቀይሳት ዋናኔ?<verse eid="JOB 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 4:20"/>ዎንታ በንትድ ኦማርስ ሀይቆሶና፤</para>
  <para style="q2" vid="JOB 4:20">ኦንካ ሀሳዮና መርናዉ ዮሶና።<verse eid="JOB 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 4:21"/>ሸይ ሾደትዳ ዱንካነ መላ</para>
  <para style="q2" vid="JOB 4:21">ጭንጫተ ባይና ሀይቆሶና።’ ”<verse eid="JOB 4:21"/></para>
  <chapter eid="JOB 4"/>
  <chapter number="5" style="c" sid="JOB 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 5:1"/>“እዮባ፥ ነዉ ኮያና አስ ደእኮ አነ ፄጋ!</para>
  <para style="q2" vid="JOB 5:1">ኪታንቾታፐ ኦደኮ ነ ፄላኔ?”<verse eid="JOB 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 5:2"/>ኤያ ኡራ ላንጨይ ዎስ፤</para>
  <para style="q2" vid="JOB 5:2">አኬክ ባይና ኡራ ቃናተይ ይሴስ።<verse eid="JOB 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 5:3"/>ኤያ ኡራይ ምንድ ደእሽን በአስ፤</para>
  <para style="q2" vid="JOB 5:3">ሽን ቆፖና እያ ኬይ ባደትስ።<verse eid="JOB 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 5:4"/>እያ ናይት ሳሮይ ባይና ዳና፤</para>
  <para style="q2" vid="JOB 5:4">ፕርዳ ዳባባን ኤንታዉ ኤቅያ አስ ባይና ግሾ ኤንቲ ቆሄታና።<verse eid="JOB 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 5:5"/>እ ሺሽዳ ካ ኮሻትዳ አሳይ ማና፤</para>
  <para style="q2" vid="JOB 5:5">ሀር አቶሽን አጉን ግዶን ዶልዳይሳካ አጎኮና።</para>
  <para style="q2" vid="JOB 5:5">ሳሞትዳይሳት እያ ሻሉዋ ኤካናዉ አሞቶሶና።<verse eid="JOB 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 5:6"/>መቶይ ሳአፐ ከየና፤</para>
  <para style="q2" vid="JOB 5:6">ዋየይ ቢታፈ ዶለና።<verse eid="JOB 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 5:7"/>ታም ፕንፅድ ዎይሳዳ፥</para>
  <para style="q2" vid="JOB 5:7">አስ መቶስ የለትስ።<verse eid="JOB 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 5:8"/>“ታ ነና ግድያኮ ታ ፆሳኮ ሺቃና፤</para>
  <para style="q2" vid="JOB 5:8">ታ ሞቱዋካ እያ ስንን ዎና።<verse eid="JOB 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 5:9"/>እ ታይበቶና ማላታታ፥</para>
  <para style="q2" vid="JOB 5:9">ፕልገቶና ዎልቃማባታ ኦስ።<verse eid="JOB 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 5:10"/>እራ ቢታን ቡክሴስ፤</para>
  <para style="q2" vid="JOB 5:10">ጎሻ ጋድያስ ሃ የዴስ።<verse eid="JOB 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 5:11"/>ካዉሻታ ቁ ቁ ኦስ፤</para>
  <para style="q2" vid="JOB 5:11">ካዮተይሳታ ምንድ ኡፋይሴስ።<verse eid="JOB 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 5:12"/>ኤንታ ቆፋይ ፖለቶና መላ፥</para>
  <para style="q2" vid="JOB 5:12">ገናንቾታ ሀልቹዋ ሀዳ ኦስ።<verse eid="JOB 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 5:13"/>ጭንጫታ ኤንታ ገነ ኦሱዋን ኦይኬስ፤</para>
  <para style="q2" vid="JOB 5:13">ገናንቾታ ማቁዋ አድ የጌስ።<verse eid="JOB 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 5:14"/>ጋላሳይ ኤንታዉ ማ ግዳና፤</para>
  <para style="q2" vid="JOB 5:14">ሴታ ጋላስ ማን ሄመትያ አሳዳ ታታፋና።<verse eid="JOB 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 5:15"/>ማንቆታ ኤንታ ሞርከታ ማሻፈ አሼስ፤</para>
  <para style="q2" vid="JOB 5:15">ኤንታ ዎልቃማታ ኩሽያፐ ዎ ኤኬስ።<verse eid="JOB 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 5:16"/>ሄሳ ግሾ፥ ማንቆታስ ኡፋይስ ደኤስ፤</para>
  <para style="q2" vid="JOB 5:16">ጌላተ ስእ ኦስ።”<verse eid="JOB 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 5:17"/>“ፆሳይ ሴርያ አስ አንጀትዳይሳ፤</para>
  <para style="q2" vid="JOB 5:17">ሄሳ ግሾ፥ ኡባ ዳንዳእያ ፆሳ ሴራ ካፓ።<verse eid="JOB 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 5:18"/>እ መንስ፥ ሽን ዛሪድ ኮሌስ፤</para>
  <para style="q2" vid="JOB 5:18">እ ማዱንፅሴስ፥ ሽን እያ ኩሸይ ሌስ።<verse eid="JOB 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 5:19"/>ኡሱፑን ቆሞ ቆሆታፐ እ ነና አሻና፤</para>
  <para style="q2" vid="JOB 5:19">ላፑንይ ነና ቦቸና።<verse eid="JOB 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 5:20"/>ኮሻ ላይ ሀይቆፐ፥</para>
  <para style="q2" vid="JOB 5:20">ኦላ ዎደ ማሻፈ ነና አሼስ።<verse eid="JOB 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 5:21"/>እ ነና ኢታ እንፃርሳፈ ናጋና፤</para>
  <para style="q2" vid="JOB 5:21">ቦሽ ጋክያ ዎደ ያያካ።<verse eid="JOB 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 5:22"/>ቦሻ ቦላነ ኮሻ ቦላ ነ ሚጫና፤</para>
  <para style="q2" vid="JOB 5:22">ባዞ ዶአታስ ያያካ።<verse eid="JOB 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 5:23"/>ነ ጎሻ ቢታን ሹች ዴና፤</para>
  <para style="q2" vid="JOB 5:23">ባዞ ዶአታራ ነ ሳሮን ዳና።<verse eid="JOB 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 5:24"/>ነ ዱንካነይ ሳሮ ግደይሳ ነ ኤራና፤</para>
  <para style="q2" vid="JOB 5:24">ነ ዳራ ነ ፆሞስያ ዎደ አይብካ ፓጨና።<verse eid="JOB 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 5:25"/>ነ የለታይ ዳራናይሳነ</para>
  <para style="q2" vid="JOB 5:25">ነ ኮቻይ ማታ መላ ግዳናይሳ ነ ኤራና።<verse eid="JOB 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 5:26"/>ካ ዎደ ናግድ ጫከተይሳዳ፥</para>
  <para style="q2" vid="JOB 5:26">ኔኒ ጭማተ ካላዳ ዱፎ ባና።<verse eid="JOB 5:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 5:27"/>“እዮባ፥ ኑኒ ሄሳ ኡባ ፕልግድ ፄልዳ።</para>
  <para style="q2" vid="JOB 5:27">ሄስ ቱማ ግድያ ግሾ አኬካዳ ኤካ” ያግስ።<verse eid="JOB 5:27"/></para>
  <chapter eid="JOB 5"/>
  <chapter number="6" style="c" sid="JOB 6"/>
  <para style="s1">እዮባ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 6:1"/>ሄሳፈ ጉየ እዮብ ዛሪድ፥<verse eid="JOB 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 6:2"/>ታ ዋየይነ ታ አዛኖይ ኡባይ</para>
  <para style="q2" vid="JOB 6:2">ምዛነን ልከትድ በኤትያኮ፥<verse eid="JOB 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 6:3"/>አባ ጋፃን ደእያ ሻፍያፐ አድ ዴፃና፤</para>
  <para style="q2" vid="JOB 6:3">ሄሳ ግሾ፥ ታ ቃላይ ነና ማላልሰናሽን።<verse eid="JOB 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 6:4"/>ኡባ ዳንዳእያ ፆሳ ዶንገት ታና ጫድዶሶና፤</para>
  <para style="q2" vid="JOB 6:4">ታ አሳተይ ኤንታ ዪሻ ኡዬስ፤</para>
  <para style="q2" vid="JOB 6:4">ፆሳ ዳጋንይ ታ ቦላ ሳልፕስ።<verse eid="JOB 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 6:5"/>ሀረይ ዎይኮ ቦር ማት ደእሽን ዋስዬ?<verse eid="JOB 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 6:6"/>ማልኦና ካ ማፅነይ ገሎና ሜተትዬ?</para>
  <para style="q2" vid="JOB 6:6">ዎይኮ ጱጱለ ሃ ማልእዬ?<verse eid="JOB 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 6:7"/>ሄሳ መላ ካ ታና ሱከየና፤</para>
  <para style="q2" vid="JOB 6:7">ሄሳ መላ ካ ታ ሚኮ ታና ሳኬስ።<verse eid="JOB 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 6:8"/>ታ ዎሳ ፆሲ ስእያኮ አይቤ?</para>
  <para style="q2" vid="JOB 6:8">ታ አሙዋካ ታዉ ኩንያኮ አይቤ?<verse eid="JOB 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 6:9"/>ፆሳ ሸነ ግድን እ ታና መንረያኮ፥</para>
  <para style="q2" vid="JOB 6:9">እ ባ ኩሽያ የድድ ታና ይስያኮ፥<verse eid="JOB 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 6:10"/>ታ ጌሻ ፆሳ ቃላ ካዳቦና ግሾ፥</para>
  <para style="q2" vid="JOB 6:10">ዋየይ ዳርኮካ ኡፋይሳን ታ ጉፓና።<verse eid="JOB 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 6:11"/>ታ ፓፃ ዳናዉ ታዉ አይባ ዎልቅ ደኢ?</para>
  <para style="q2" vid="JOB 6:11">ታዉ አይባ ኡፋይስ ደእሽን ዳንዳእያና?<verse eid="JOB 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 6:12"/>ታ ዎልቃይ ሹቻ መለዬ?</para>
  <para style="q2" vid="JOB 6:12">ዎይኮ ታ አሾይ ናሰ ብራታ መለዬ?<verse eid="JOB 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 6:13"/>ታኒ ታና ማዳናዉ አይባ ዎልቅ ታዉ ደኢ?</para>
  <para style="q2" vid="JOB 6:13">ማዶ ደማናዉ ፄልያ በስካ ባዋ።<verse eid="JOB 6:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 6:14"/>መቶን ደእያ አስ ኡባ ዳንዳእያ ፆሳስ ያየይሳ አግኮካ፥</para>
  <para style="q2" vid="JOB 6:14">እያ ላገት እያዉ ኬሀተ በሳናዉ ኮሼስ።<verse eid="JOB 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 6:15"/>ሽን ታ እሻት ህንተ እር ቡኮና ዎደ መልያ ሻፋ መላ ታና ጭሜታ።<verse eid="JOB 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 6:16"/>ባልጎ አጌናን ሀ ሻፋይ ሻቻን ኩሜስ።<verse eid="JOB 6:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 6:17"/>ሽን ቦነይ ጋክያ ዎደ ሻቻይ ትልኤስ፤</para>
  <para style="q2" vid="JOB 6:17">ሻፋይካ መሌስ።<verse eid="JOB 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 6:18"/>ጫና መሄ ላግሸ ብያ ዛልአንቾት፥</para>
  <para style="q2" vid="JOB 6:18">ሃ ኮያናዉ ባንታ ኦግያፐ ጋፃ ከይድ፥</para>
  <para style="q2" vid="JOB 6:18">መላ ቢታን ቶይላትሸ ዮሶና።<verse eid="JOB 6:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 6:19"/>ቴማ ቢታ ዛልአንቾት ሃ ኮዮሶና፤</para>
  <para style="q2" vid="JOB 6:19">ሳባ ቢታ ኦገ አሳት ኡፋይስ ቃንፆኮና።<verse eid="JOB 6:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 6:20"/>ኤንቲ አማነትድ ኮይድ ይዳ ግሾ ይሎትዶሶና፥</para>
  <para style="q2" vid="JOB 6:20">ሄ በሳ ጋክድ ዬላትዶሶና።<verse eid="JOB 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 6:21"/>ህንተካ ታዉ ሄ ሻፋታ መላ ግድደታ፤</para>
  <para style="q2" vid="JOB 6:21">ታና ጋክዳ መቱዋ በእድ ያይደታ።<verse eid="JOB 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 6:22"/>ሀኖሽን ታ ህንተና፥ “ታዉ እስባ እምተ”</para>
  <para style="q2" vid="JOB 6:22">ዎይኮ፥ “ህንተ ሻሉዋራ ታና ዎዝተ” ጋድና?<verse eid="JOB 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 6:23"/>“ታና ታ ሞርከታ ኩሸፐ አሽተ”</para>
  <para style="q2" vid="JOB 6:23">ዎይኮ፥ “ቃይ ባይና አሳ ኩሸፐ ታና ዎዝተ” ጋድና?<verse eid="JOB 6:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 6:24"/>“ታ ስእ ጋና፤ ህንተ ታና ታማርስተ፤</para>
  <para style="q2" vid="JOB 6:24">ታ አይ ባልዳኮ አነ ታና በስተ።<verse eid="JOB 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 6:25"/>ቱማ ኦድ ጫምኮካ ኤከቴስ!</para>
  <para style="q2" vid="JOB 6:25">ሽን ህንተ ኦዳይ አይብስካ ማደና።<verse eid="JOB 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 6:26"/>ህንተ ታ ሃሳያ ጫርኮ መላ ሀዳ ኦታ፤</para>
  <para style="q2" vid="JOB 6:26">ያትን፥ ኡፋይስ ቃንፅዳይሳስ ታዉ አይ ዛሮ እማናዉ ኮዬቲ?<verse eid="JOB 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 6:27"/>አው ባይና ናአ ቦላ ሳማ የጌታ፤</para>
  <para style="q2" vid="JOB 6:27">ህንተ ላግያ ባይዛናዉ ዋሽሴታ።<verse eid="JOB 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 6:28"/>አነ ሻማ አይፈን ታና ፄልተ፤</para>
  <para style="q2" vid="JOB 6:28">ታ ህንተ ስንን ዎርዶትያና?<verse eid="JOB 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 6:29"/>ሀያና፥ አነ ዛረድ ቆፕተ፤</para>
  <para style="q2" vid="JOB 6:29">ታኒ ፅሎ ታ ቦላ ጮ ፕርዶፍተ።<verse eid="JOB 6:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 6:30"/>ታ እንፃርሳን ዎርዶይ ደኢ?</para>
  <para style="q2" vid="JOB 6:30">ታ ዶናይ ዎርዶነ ቱማ ሻካናዉ ዳንዳኤኔ?”<verse eid="JOB 6:30"/></para>
  <chapter eid="JOB 6"/>
  <chapter number="7" style="c" sid="JOB 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 7:1"/>አሳ ደኦይ ሳአ ቦላ ዎልቃማ ባፀ ግደነዬ?</para>
  <para style="q2" vid="JOB 7:1">እያ ላይይ ኡነ ኦያ አሳ ደኦ መላ ግደነዬ?<verse eid="JOB 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 7:2"/>ዉልያ አዋ አሞትያ ጋቻ መላ፥</para>
  <para style="q2" vid="JOB 7:2">ዎይኮ ባ ዳሞዝያ ኤካናዉ ናግያ ኦሳንቾዳ፥<verse eid="JOB 7:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="JOB 7:3"/>ሄሳዳ ታዉ መላ አጌናት</para>
  <para style="q2" vid="JOB 7:3">መቶ ቃማት እመትዶሶና።<verse eid="JOB 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 7:4"/>ታኒ ዝንእያ ዎደ አዉደ ባርካንድናሻ ጋይስ፤</para>
  <para style="q2" vid="JOB 7:4">ሽን ቃማይ ታዉ አዱቄስ፤</para>
  <para style="q2" vid="JOB 7:4">ሳእ ዎንታና ጋካናዉ ሂፃን ሽረታ ሽረታ ዎይስ።<verse eid="JOB 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 7:5"/>ታ አሳተይ ጉፁንትስ፤</para>
  <para style="q2" vid="JOB 7:5">ታ ማዱንይ ጊሽ ጎጌስ።<verse eid="JOB 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 7:6"/>ታ ላይይ ዶርዘ ሞቀፐ አድ ኤለሴስ፤</para>
  <para style="q2" vid="JOB 7:6">ኡፋይስ ባይናሽን ታ ላይይ ዉሬስ።<verse eid="JOB 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 7:7"/>አቤት ፆሳዉ፥ ታ ላይይ እስ ሸምፖ መላ ግደይሳ ቆፓ!</para>
  <para style="q2" vid="JOB 7:7">ታ አይፈይ ዛሪድ ኬሀባ በኤና።<verse eid="JOB 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 7:8"/>ሀእ በኤይ ዛሪድ በኤና፤</para>
  <para style="q2" vid="JOB 7:8">ታና ኮያና ሽን ዛር ደመና።<verse eid="JOB 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 7:9"/>ሻር ላለትድ የይሳዳ፥</para>
  <para style="q2" vid="JOB 7:9">ዱፎ ዎያ አስ ስሚድ ከየና።<verse eid="JOB 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 7:10"/>ባ ሶ ስሚድ ዬና፤</para>
  <para style="q2" vid="JOB 7:10">እያ ኤርያ አሳይካ ዶጌስ።<verse eid="JOB 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 7:11"/>“ሄሳ ግሾ፥ ታ ስእ ጊከ፤</para>
  <para style="q2" vid="JOB 7:11">ታ አያና ኡንኤተ ኦዳና፤</para>
  <para style="q2" vid="JOB 7:11">ታ ሸምፑዋ ጫመተ ግሾ ዙዙማና።<verse eid="JOB 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 7:12"/>ሄሳ መላ ኔኒ ታና አይስ ናጋይ?</para>
  <para style="q2" vid="JOB 7:12">ታ ነዉ አባ ዎይኮ አባን ደእያ ኢታ ዶአ ጋድዬ?<verse eid="JOB 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 7:13"/>‘ታ ሂፃይ ታና ምንና፤</para>
  <para style="q2" vid="JOB 7:13">ታ አርሳይ ታና ዙዙንፈ ሸምፕሳና!’ ጋዳ ቆፓስ፤<verse eid="JOB 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 7:14"/>ሽን ኔኒ ታና አሙሆን ያሽሳሳ፤</para>
  <para style="q2" vid="JOB 7:14">ቆንጨን ታና ዳጋንሳ።<verse eid="JOB 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 7:15"/>ታኒ ሀ ዋየይ ኩምዳ አሳተ ቶካዳ ዳናፐ፥</para>
  <para style="q2" vid="JOB 7:15">ሱለታዳ ሀይቅያኮ ዶሳይስ።<verse eid="JOB 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 7:16"/>ታኒ ታ ደኡዋ ሻተታስ፤ ዳናዉ ኮይከ፤</para>
  <para style="q2" vid="JOB 7:16">ታ ላይይ እስ ሸምፖ መላ ግድያ ግሾ ታና አጋርክ።<verse eid="JOB 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 7:17"/>ነ እያ ግታያዳ ፄላናዉ አስ አይቤ?</para>
  <para style="q2" vid="JOB 7:17">ነ እያዉ ቆፓናዉ አስ አይቤ?<verse eid="JOB 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 7:18"/>ዎንታ ዎንታ ነ እያ ፆሞሳሳ፤</para>
  <para style="q2" vid="JOB 7:18">ዎደን ዎደን ነ እያ ፓጫሳ።<verse eid="JOB 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 7:19"/>ነ ታ ቦላ አይፈ ዎይሳ አግኪ?</para>
  <para style="q2" vid="JOB 7:19">ጩቹ ምትያ ዎደ ታዉ እምኪ?<verse eid="JOB 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 7:20"/>አቤት አሰ ካለይሶ፥</para>
  <para style="q2" vid="JOB 7:20">ታ ናጋራ ኦን ነና አይ ቆህዴ?</para>
  <para style="q1" vid="JOB 7:20">ነ አይስ ታና ጫዳ ኦይካይ?</para>
  <para style="q2" vid="JOB 7:20">ነዉ ታ ቶሆ ግዳድናዬ?<verse eid="JOB 7:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 7:21"/>ታ ናቁዋ አይስ አግኪ?</para>
  <para style="q2" vid="JOB 7:21">ታ ናጋራ አይስ አቶ ጊኪ?</para>
  <para style="q1" vid="JOB 7:21">ታ ዱፎ ገልያ ዎደይ ጋክስ፤</para>
  <para style="q2" vid="JOB 7:21">ነ ታና ኮያና፥ ሽን ህዛፐ ደማካ” ያግስ።<verse eid="JOB 7:21"/></para>
  <chapter eid="JOB 7"/>
  <chapter number="8" style="c" sid="JOB 8"/>
  <para style="s1">ባልዳዶሳ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 8:1"/>ሹሀ ቢታፈ ይዳ በልዳዶስ ዛሪድ፥<verse eid="JOB 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 8:2"/>“ኔኒ ሄሳ አዉደ ጋካናዉ ኦደታይ?</para>
  <para style="q2" vid="JOB 8:2">ነ ዶናፐ ከያ ቃላይ ዎልቃማ ጎተ መላ።<verse eid="JOB 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 8:3"/>ኡባ ዳንዳእያ ፆሳይ ፅሎ ፕርደኔ?<verse eid="JOB 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 8:4"/>ነ ናይት ፆሳ ቦላ ናጋራ ኦዳ ግሾ፥</para>
  <para style="q2" vid="JOB 8:4">እ ኤንታ ኤንታ ናጋራ ግሾ ሴርስ።<verse eid="JOB 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 8:5"/>ሽን ኔኒ ፆሳኮ ስምኮ፥</para>
  <para style="q2" vid="JOB 8:5">ኡባ ዳንዳእያ ፆሳ ዎስኮ፥<verse eid="JOB 8:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="JOB 8:6"/>ኔኒ ጌሽነ ሱረ ግድኮ፥</para>
  <para style="q2" vid="JOB 8:6">እ ነ ግሾ ደንድድ ነና ማዳና፤</para>
  <para style="q2" vid="JOB 8:6">እ ካሰ ነ ደኡዋ ዛሪድ ዎይታና።<verse eid="JOB 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 8:7"/>ነ ዶመይ ጉ ዳንኮካ፥</para>
  <para style="q2" vid="JOB 8:7">ነ ዉርሰይ ዳሮ አድ ዳራና።<verse eid="JOB 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 8:8"/>ካሰ የለታ አነ ኦይቻ፤</para>
  <para style="q2" vid="JOB 8:8">ኑ ማይዛት አይ ታማርዳኮ ፕልጋዳ ደማ።<verse eid="JOB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 8:9"/>ኑኒ ዝነ ናይታ አይባካ ኤሮኮ፤</para>
  <para style="q2" vid="JOB 8:9">ኑ ሀ ሳአን ደእያ ላይይ ኩያ መላ።<verse eid="JOB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 8:10"/>ኤንቲ ነና ታማርሰይነ ነዉ ኦደይ፥</para>
  <para style="q2" vid="JOB 8:10">ባንታ ዎዛናን ዎዳባፐ ግደነዬ?<verse eid="JOB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 8:11"/>ጫረይ ባይና በሳን ፓልክ ዶላናዉ ዳንዳኢ?</para>
  <para style="q2" vid="JOB 8:11">ሃ ባይና በሳን ማይረይ ጭልአናዉ ዳንዳኢ?<verse eid="JOB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 8:12"/>ቡሮ ድጭድ ቃንፀቶና ደእሸ፥</para>
  <para style="q2" vid="JOB 8:12">ጭልኦ ማታፐካ ኤሶን መሌስ።<verse eid="JOB 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 8:13"/>ፆሳ ዶግያ አሳ ኡባ ዉርሰይ ሄሳ መላ፤</para>
  <para style="q2" vid="JOB 8:13">ፆሰ ኤሮና አሳ ኡፋይሳይ ያና።<verse eid="JOB 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 8:14"/>እ አማነትያባይ መቅያባ፤</para>
  <para style="q2" vid="JOB 8:14">እ ጬቀትያባይካ ሻንጎ ሃዳ መላ።<verse eid="JOB 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 8:15"/>እ ባ ሻንጎ ሃዳ ቦላ ዘምፓና፥ ሽን ኤቀና፤</para>
  <para style="q2" vid="JOB 8:15">እ እያ ኦይካና፥ ሽን ዱፅ ዎና።<verse eid="JOB 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 8:16"/>እ አዋ ዎደ ሃ ኡይድ ጭልእያ አታክልተ መላ፤</para>
  <para style="q2" vid="JOB 8:16">ባ ፃጱዋ ቢታ ኡባን የድዳ ም መላ።<verse eid="JOB 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 8:17"/>ባ ፃጱዋ ኬላን የዴስ፤</para>
  <para style="q2" vid="JOB 8:17">ግታ ሹቻ ቦላ ባ ፃጱዋ ፃፄስ።<verse eid="JOB 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 8:18"/>ሽን እ ባ በሳፈ ሾደትኮ፥</para>
  <para style="q2" vid="JOB 8:18">ሄ በሳይ፥ ‘ታ ነና በአብከ’ ያጋና።<verse eid="JOB 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 8:19"/>ኢታ አሳታ ኡፋይሳይ ሄሳ መላ፤</para>
  <para style="q2" vid="JOB 8:19">ሀራት ይድ ኤንታ በሳ ኦይካና።<verse eid="JOB 8:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 8:20"/>“ፆሳይ ቦረይ ባይና አሳ የግ አገና፤</para>
  <para style="q2" vid="JOB 8:20">ኢታ ኦይሳታ ማደና።<verse eid="JOB 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 8:21"/>እ ዛሪድ ነና ሚቻናነ እልልሳና።<verse eid="JOB 8:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 8:22"/>ነና እፀይሳት ዬላ ማአና፤</para>
  <para style="q2" vid="JOB 8:22">ኢታታ ኬይ ያና” ያግስ።<verse eid="JOB 8:22"/></para>
  <chapter eid="JOB 8"/>
  <chapter number="9" style="c" sid="JOB 9"/>
  <para style="s1">እዮባ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 9:1"/>እዮብ ዛሪድ፥<verse eid="JOB 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 9:2"/>“ኤ፥ ህንተ ገይስ ቱማ ግደይሳ ታ ኤራይስ፤</para>
  <para style="q2" vid="JOB 9:2">ሽን አስ ፆሳ ስንን ዋንድ ፅሎ ግዳናዉ ዳንዳኢ?<verse eid="JOB 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 9:3"/>እያራ ኦን ፓላማናዉ ዳንዳኢ?</para>
  <para style="q2" vid="JOB 9:3">እ ኦይችያ ሙኩሉ ኦይሻታፐ እሱዋካ ዛራናዉ ዳንዳኤና።<verse eid="JOB 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 9:4"/>ፆሳይ ጭንጫነ ዎልቃማ፤</para>
  <para style="q2" vid="JOB 9:4">እያራ ኤቀታናዉ ዳንዳኤይ ኦንካ ባዋ።<verse eid="JOB 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 9:5"/>ቆፖና ደእሽን ደረታ ኤንታ በሳፈ ድጌስ፤</para>
  <para style="q2" vid="JOB 9:5">ባ ሀንቁዋን አድ የጌስ።<verse eid="JOB 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 9:6"/>እ ቢታ እያ በሳፈ ቃስ፤</para>
  <para style="q2" vid="JOB 9:6">ቢታ ቱቀታካ ይጌስ።<verse eid="JOB 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 9:7"/>አዋይ ከዮና መላ ኦስ፤</para>
  <para style="q2" vid="JOB 9:7">ፆልንቶት ፖኦና መላ ድጌስ።<verse eid="JOB 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 9:8"/>እ ባርካ ሳሎታ ምጭስ፤</para>
  <para style="q2" vid="JOB 9:8">አባ ሆቢያ ቦላ ሄመቴስ።<verse eid="JOB 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 9:9"/>ፆሳይ ቢረ፥ ኦርዮና፥ ፕላድሳ ጌተትያ ፆልንቶታነ፥</para>
  <para style="q2" vid="JOB 9:9">ዱገሀ ባጋራ ደእያ ፆልንቶ ኮጬታ መስ።<verse eid="JOB 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 9:10"/>እ አስ ፕልግድ ኤራናዉ ዳንዳኦና ግታባታ፥</para>
  <para style="q2" vid="JOB 9:10">ታይበቶና ማላልስያባታ ኦስ።<verse eid="JOB 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 9:11"/>እ ታ ማታራ አያ ዎደ ታ በአናዉ ዳንዳእከ፤</para>
  <para style="q2" vid="JOB 9:11">እ ታኮ ሺቅያ ዎደ ኤራናዉ ዳንዳእከ።<verse eid="JOB 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 9:12"/>እ ቦንቅኮ ድጋናዉ ዳንዳኤይ ኦኔ?</para>
  <para style="q2" vid="JOB 9:12">‘ዋታይ?’ ያግድ እያ ኦይቻናይ ኦኔ?<verse eid="JOB 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 9:13"/>ፆሳይ ባ ሀንቁዋ ተቀና፤</para>
  <para style="q2" vid="JOB 9:13">ራኣባ ጌተትያ ዶአ ማደይሳት</para>
  <para style="q2" vid="JOB 9:13">እያ ቶሁዋ ጋርሳን ኩንዶሶና።<verse eid="JOB 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 9:14"/>ያትን፥ እያ ኦይሻ ዛራናዉ፥</para>
  <para style="q2" vid="JOB 9:14">እያራ ሞተታናዉ ታኒ ኦኔ?<verse eid="JOB 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 9:15"/>ታኒ ፅሎ ግድኮካ፥</para>
  <para style="q2" vid="JOB 9:15">ፕርድያ ፆሳይ ታና ማራናዳ ዎሳናፐ አትሽን፥</para>
  <para style="q2" vid="JOB 9:15">ታኒ እያዉ ዛሮ እምከ።<verse eid="JOB 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 9:16"/>ታ እያ ፄግን፥ እ ታዉ ኮያኮካ፥</para>
  <para style="q2" vid="JOB 9:16">ታና ስኤስ ጋዳ አማንከ።<verse eid="JOB 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 9:17"/>ታና ጎተን መንረስ፤</para>
  <para style="q2" vid="JOB 9:17">ጋሶይ ባይና ታ ማዱን ዳርሴስ።<verse eid="JOB 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 9:18"/>ታና ሸምፖ ድጌስ፤</para>
  <para style="q2" vid="JOB 9:18">ታ ደኡዋ ጫመስ።<verse eid="JOB 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 9:19"/>ዎልቃባ ግድኮ፥ እ ዎልቃማ።</para>
  <para style="q2" vid="JOB 9:19">ፅሎ ፕርዳባ ግድኮ፥ እያ ፕርዳ ኬ ሺሻናይ ኦኔ?<verse eid="JOB 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 9:20"/>ታኒ ታና ፅሎ ጊኮካ ታ ዶናይ ታና ባላ ከሴስ፤</para>
  <para style="q2" vid="JOB 9:20">ታናን ቦረይ ባዋ ታ ጊኮካ ታ እንፃርሳይ ታና ጌላ ከሴስ።<verse eid="JOB 9:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 9:21"/>ታኒ ቦረይ ባይና አስ ግድኮካ ታባ ቆፕከ፤</para>
  <para style="q2" vid="JOB 9:21">ታኒ ታ ደኡዋ ካይስ።<verse eid="JOB 9:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 9:22"/>ፆሳይ ቦረይ ባይናይሳነ ኢታ እስፈ ይሴስ፤</para>
  <para style="q2" vid="JOB 9:22">ታ ዱማተ ባዋ ገይ ሄሳ ግሾሳ።<verse eid="JOB 9:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 9:23"/>ጋዶይ ገልድ አሳ ቆፖና ዎያ ዎደ፥</para>
  <para style="q2" vid="JOB 9:23">እ ፅሎ አሳ ዋያን ሚጬስ።<verse eid="JOB 9:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 9:24"/>ሀ ሳአይ ኢታ አሳ ኩሸን ዎያ ዎደ፥</para>
  <para style="q2" vid="JOB 9:24">እ ፕርደይሳታ አይፍያ ጎዜስ።</para>
  <para style="q1" vid="JOB 9:24">ሄሳ ኡባ ኦይ እያ ግዶና እፅኮ፥ ሀር ኦኔ?<verse eid="JOB 9:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 9:25"/>ታ ደኦ ላይት ዎፅያ ኡራፐ አድ ኤለሶሶና፤</para>
  <para style="q2" vid="JOB 9:25">ኤንቲ ሎኦባ በኦና ፕራድ ዮሶና።<verse eid="JOB 9:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 9:26"/>ታ ደኦ ላይይ ፓልካ ዎጎሎዳ ዎፄስ፤</para>
  <para style="q2" vid="JOB 9:26">አርጋን ምያባ ኦይካናዉ ሳሎፐ ዱገ ፓለይሳዳ ፓለስ።<verse eid="JOB 9:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 9:27"/>‘ታ ዙዙን ዶጋና፤</para>
  <para style="q2" vid="JOB 9:27">ሶምኦ ቱከይሳ አጋዳ ፖእሳና ግያኮ፥’<verse eid="JOB 9:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 9:28"/>ኔኒ ታና ጌሽ ጎናይሳ ታኒ ኤርያ ግሾ፥</para>
  <para style="q2" vid="JOB 9:28">ታና ጋካና ዋየ ኡባ ታኒ ያያይስ።<verse eid="JOB 9:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 9:29"/>ያትን፥ ታኒ ባላ ግደይስ አቶና እፅኮ፥</para>
  <para style="q2" vid="JOB 9:29">ጮ መላ አይስ ዳቡራይና?<verse eid="JOB 9:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 9:30"/>ታኒ ታ አሳተ ሀር አቶሽን ሳሙናን ሜጨትያኮካ፥</para>
  <para style="q2" vid="JOB 9:30">ታ ኩሽያ ዱማባራ ሜጨትያኮካ፥<verse eid="JOB 9:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="JOB 9:31"/>ታ ማኦይካ ታና ሻተታና ጋካናዉ፥</para>
  <para style="q2" vid="JOB 9:31">ኔኒ ታና ኡርቃ ኦላን ሆላና።<verse eid="JOB 9:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 9:32"/>ታ እያዉ ዛሮ እማናዉ ፆሳይ ታ መላ አሰ ግደና፤</para>
  <para style="q2" vid="JOB 9:32">ግድያኮ ኑ ናምአይ ዳይና ስንን ኤቃና።<verse eid="JOB 9:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 9:33"/>ሽን ኑ ናምኣ ቦላ ባ ኩሸ ዎድ፥</para>
  <para style="q2" vid="JOB 9:33">ኑና ስገያ አስ ኑ ግዶን ደኤረነ!<verse eid="JOB 9:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 9:34"/>እያ ቴሞይ ታና ዳጋንና መላ፥</para>
  <para style="q2" vid="JOB 9:34">እስ አስ ፆሳ ፃምኣ ታፐ ድገረነሽን!<verse eid="JOB 9:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 9:35"/>ያንኮ፥ ታኒ እያዉ ያዮና ኦደታና፤</para>
  <para style="q2" vid="JOB 9:35">ሽን ሀእ ታኒ ዳንዳእከ።<verse eid="JOB 9:35"/></para>
  <chapter eid="JOB 9"/>
  <chapter number="10" style="c" sid="JOB 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 10:1"/>ታና ዱስ ሻትስ!</para>
  <para style="q2" vid="JOB 10:1">ሄሳ ግሾ፥ ታ ዙዙማናፐ አትሽን፥ ስእ ጊከ፤</para>
  <para style="q2" vid="JOB 10:1">ታ ሸምፑዋ ሴላ ከሳና።<verse eid="JOB 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 10:2"/>ታኒ ፆሳኮ ሀይሳዳ ጋና፤</para>
  <para style="q2" vid="JOB 10:2">ታ ባላ ታዉ ኦዳፐ አትሽን፥ ታ ቦላ ፕርዶፋ።<verse eid="JOB 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 10:3"/>ኔኒ ኢታታ ቆፋ ኡፋይሳን ኤካሸ፥</para>
  <para style="q2" vid="JOB 10:3">ታና ኡንኤናዉ በሲ?</para>
  <para style="q2" vid="JOB 10:3">ነ ኩሸን መዳ ኡራ ካይስ ዎጌ?<verse eid="JOB 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 10:4"/>ነ አይፈይ አሳ አይፈ መለዬ?</para>
  <para style="q2" vid="JOB 10:4">ኔኒ አስ ፄለይሳዳ ፄላዬ?<verse eid="JOB 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 10:5"/>ነ ደኦ ላይይ አሳ ደኦ ላይ መለዬ?<verse eid="JOB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 10:6"/>ያትን፥ ታ ባላ አይስ ኮያይ?</para>
  <para style="q2" vid="JOB 10:6">ታ ናጋራ አይስ ካላይ?<verse eid="JOB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 10:7"/>ታኒ ባላ ግዶናይሳነ</para>
  <para style="q2" vid="JOB 10:7">ነ ኩሸፐ ታና ኦንካ አሻናዉ ዳንዳኦናይሳ ነ ኤራሳ።<verse eid="JOB 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 10:8"/>ታና ነ ኩሸይ ጊግስድ መስ፤</para>
  <para style="q2" vid="JOB 10:8">ሽን ሀእ ሄ ኩሸይ ስሚድ ታና መንስ።<verse eid="JOB 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 10:9"/>ኔኒ ታና ቢታፈ መዳይሳ ሀሳያ</para>
  <para style="q2" vid="JOB 10:9">ያትን፥ ሀእ ታና ዛራዳ ባና ኦናዉ ኮያይ?<verse eid="JOB 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 10:10"/>ታና ማዳ ታ አየ ኡሎን ትግዳይነ</para>
  <para style="q2" vid="JOB 10:10">መቃ ማዳ እርክስዳይ ነና ግድኪ?<verse eid="JOB 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 10:11"/>ኔኒ ታና አሾነ ጎጋ ማይዛዳሳ፤</para>
  <para style="q2" vid="JOB 10:11">ሻያንነ መቀን ዋፃዳሳ።<verse eid="JOB 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 10:12"/>ኔኒ ታዉ ደኦነ መርና ሲቆ እማዳሳ፤</para>
  <para style="q2" vid="JOB 10:12">ነ ናጎይ ታና ፓፃ ዎስ።<verse eid="JOB 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 10:13"/>ሽን ኔኒ ሄ ዎደፐ ዶማዳ ነ ዎዛናን</para>
  <para style="q2" vid="JOB 10:13">ታና ቆሀናዉ ቆፓዳ ደኤይሳ ታ ኤራይስ።<verse eid="JOB 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 10:14"/>ታ ናቁዋ ነ በኣሳ፤</para>
  <para style="q2" vid="JOB 10:14">ታ ናጋራ ኦኮ ሴሮና አካ።<verse eid="JOB 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 10:15"/>ታኒ ባልኮካ ታና አየ!</para>
  <para style="q2" vid="JOB 10:15">ታ ፅሎ ግድኮካ ጬቀታናዉ ዳንዳእከ።</para>
  <para style="q1" vid="JOB 10:15">ነ ታና ዬላ ማይዛዳሳ፤</para>
  <para style="q2" vid="JOB 10:15">ዋየን ዎዳሳ።<verse eid="JOB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 10:16"/>ታ ኦቶርኮ ታና ጋሞዳ ሻንካታዳ ኦይካሳ፤</para>
  <para style="q2" vid="JOB 10:16">ታና ቆሀናዉ ነ ማላልስያ ዎልቃ ዛራ ዛራ በሳሳ።<verse eid="JOB 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 10:17"/>ኔኒ ታ ቦላ ኦራ ማርካታ ኤሃሳ፤</para>
  <para style="q2" vid="JOB 10:17">ነ ሀንቁዋ ታ ቦላ ዳርሳሳ፤</para>
  <para style="q2" vid="JOB 10:17">ታና ኦላናዉ ኦራ ኦላንቾታ ጊግሳሳ።<verse eid="JOB 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 10:18"/>ያትን፥ ታና ታ አየ ኡሎፐ አይስ ከሳዲ?</para>
  <para style="q2" vid="JOB 10:18">ኦንካ ታና በኦና ሀይቅዳኮ ታው ሎኦሽን!<verse eid="JOB 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 10:19"/>ታኒ መቶና አትዳኮ፥</para>
  <para style="q2" vid="JOB 10:19">ዎይኮ ታ አየ ኡሎፐ ከያሸ ዱፎ ገልዳኮ ሎኦሽን!<verse eid="JOB 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 10:20"/>ታ ጉ ደኦ ላይይ ዉሬስ ግደነዬ?</para>
  <para style="q2" vid="JOB 10:20">ሀ ጉ ላይን ኡፋይታና መላ ታና አጋርክ!<verse eid="JOB 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 10:21"/>ታ ስሞና በሳ ቦና ደእሽን፥</para>
  <para style="q2" vid="JOB 10:21">ሌልዳ ማ ቢታ ጋኮና ደእሽን፥<verse eid="JOB 10:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOB 10:22"/>እያ ፖኦይ ማ ግድዳ በሳነ ሀይቆይ ካዎትዳ በሳ፥</para>
  <para style="q2" vid="JOB 10:22">ማር ባይና በሳነ ሌልዳ ማ ቢታ ቦና ደእሽን፥</para>
  <para style="q2" vid="JOB 10:22">ታና አጋርክ!”<verse eid="JOB 10:22"/></para>
  <chapter eid="JOB 10"/>
  <chapter number="11" style="c" sid="JOB 11"/>
  <para style="s1">ሶፋራ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 11:1"/>ናእማ ቢታፈ ይዳ ሶፋር ዛሪድ፥<verse eid="JOB 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 11:2"/>“ሀ ሀዳ ሃሳያ ኡባስ ዛሮ እምያ አስ ባዌ?</para>
  <para style="q2" vid="JOB 11:2">ዎይኮ ሄሳ ኦድዳ ኡራይ ቱማ ግዳናዉ ዳንዳኢ?<verse eid="JOB 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 11:3"/>ነ ሀዳ ኦዳይ አሰ ስእ ኦያ ዳኒ?</para>
  <para style="q2" vid="JOB 11:3">ነ ቀልቅስያ ዎደ ነና ሴርያ አስ ባዌ?<verse eid="JOB 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 11:4"/>ኔኒ፥ ‘ታ ትምርተይ ቱማ፤</para>
  <para style="q2" vid="JOB 11:4">ታኒ ፆሳ ስንን ጌሽ’ ” ጋሳ።<verse eid="JOB 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 11:5"/>ፆሳይ ነዉ ኦድያኮ፥</para>
  <para style="q2" vid="JOB 11:5">ባ ዶና ዶይድ ኦደትያኮ አይበ!<verse eid="JOB 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 11:6"/>ጭንጫተስ ዳሮ ኦገይ ደእያ ግሾ፥</para>
  <para style="q2" vid="JOB 11:6">ፆሳይ ነዉ ጭንጫተ ፁራ ቆንጭስያኮ አይበ!</para>
  <para style="q1" vid="JOB 11:6">ሄ ዎደ ነ ሴረትዳ ሴራይ፥</para>
  <para style="q2" vid="JOB 11:6">በሰይሳፈ ጉ ግደይሳ ኤራናሽን።<verse eid="JOB 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 11:7"/>“ጪሞ ግድዳ ፆሳ ፁራ ኤራናዉ ዳንዳአይ?</para>
  <para style="q2" vid="JOB 11:7">ዎይኮ ኡባ ዳንዳእያ ፆሳባ ፕልጋዳ ጋካናዉ ዳንዳአይ?<verse eid="JOB 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 11:8"/>ኤንቲ ሳሎታፐ ቃ፤ ነ አይ ኦናዉ ዳንዳአይ?</para>
  <para style="q2" vid="JOB 11:8">ኤንቲ ስኦለፐካ አዳ ጪሞ፤ ነ ኤራናዉ ዳንዳአካ።<verse eid="JOB 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 11:9"/>ፆሳ ጭንጫተይ ቢታፈ ዳልጌስ፤</para>
  <para style="q2" vid="JOB 11:9">አባፈካ አድ ጪሞቴስ።<verse eid="JOB 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 11:10"/>እ ይድ ነና ቃሾ ኬን የግያኮ፥</para>
  <para style="q2" vid="JOB 11:10">ፕርዳ ኬ ሺሽኮ፥ እያ ድጋናይ ኦኔ?<verse eid="JOB 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 11:11"/>ፆሳይ ፓና አሳ ኤሬስ፤</para>
  <para style="q2" vid="JOB 11:11">ኢታባ በእያ ዎደ ስእ ግድ አገና።<verse eid="JOB 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 11:12"/>ኤያ አስ ጭንጫ ግደይሳፈ፥</para>
  <para style="q2" vid="JOB 11:12">ዎራ ሀረይ አሰ ግድድ የለታናይስ ማታ።<verse eid="JOB 11:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 11:13"/>ኔኒ ነ ዎዛና ሱረ ኦኮ፥</para>
  <para style="q2" vid="JOB 11:13">ነ ኩሽያ እያኮ ምጭኮ፥<verse eid="JOB 11:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="JOB 11:14"/>ናጋራ ነ ኩሸፐ ሃስኮ፥</para>
  <para style="q2" vid="JOB 11:14">ነ ኬን ኢታባይ ዶና መላ ኦኮ፥<verse eid="JOB 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 11:15"/>ሄ ዎደ ኔኒ ቁ ጋዳ ዬል ባይና ኡባባ በአን፤</para>
  <para style="q2" vid="JOB 11:15">ያሽ ባይና ምናዳ ኤቃና።<verse eid="JOB 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 11:16"/>ኔኒ ነ መቱዋ ኡባ ዶጋና፤</para>
  <para style="q2" vid="JOB 11:16">ጎግድ አዳ ድኦዳ ዛራ ሀሳያካ።<verse eid="JOB 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 11:17"/>ነ ደኦይ ሴታ ጋላሳ አዋፐ አድ ፖአና፤</para>
  <para style="q2" vid="JOB 11:17">ነ ደኡዋ ማይ ዎንታ ፃልቀዳ ፖአና።<verse eid="JOB 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 11:18"/>ነዉ ኡፋይስ ደእያ ግሾ ኔኒ ህርጎና ዳና፤</para>
  <para style="q2" vid="JOB 11:18">ፆሳይ ነና ናግያ ግሾ ዎፑ ጋዳ ዳና።<verse eid="JOB 11:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 11:19"/>ኔኒ ያሽ ባይና ስካና፤</para>
  <para style="q2" vid="JOB 11:19">ዳሮ አሳይ ነናን ናሸታናዉ ኮያና።<verse eid="JOB 11:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 11:20"/>ሽን ኢታት መቶ በእሸ አኬኮኮና፤</para>
  <para style="q2" vid="JOB 11:20">እያፐ ባቃትድ አታናዉ ዳንዳኦኮና፤</para>
  <para style="q2" vid="JOB 11:20">ኤንታ ኡፋይሳይ ሀይቆ” ያግስ።<verse eid="JOB 11:20"/></para>
  <chapter eid="JOB 11"/>
  <chapter number="12" style="c" sid="JOB 12"/>
  <para style="s1">እዮባ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 12:1"/>እዮብ ሀይሳዳ ያግድ ዛርስ።<verse eid="JOB 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 12:2"/>ኤ፥ ህንተ ቱማካ አሰ፤</para>
  <para style="q2" vid="JOB 12:2">ጭንጫተ ህንተራ ሀይቃና!<verse eid="JOB 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 12:3"/>ሽን ታካ ህንተዳ አኬክ ደእያ አስ፤</para>
  <para style="q2" vid="JOB 12:3">ታኒ ህንተፈ ጉፅከ፤</para>
  <para style="q2" vid="JOB 12:3">ሀ ህንተ ኦደትዳባ ኤሮናይ ኦኔ?<verse eid="JOB 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 12:4"/>ታኒ ፆሳ ዎስን እ ታና ስእዳ አስ ግድኮካ፥</para>
  <para style="q2" vid="JOB 12:4">ሀእ ታ ላገታስ ሚቻስ አታስ፤</para>
  <para style="q2" vid="JOB 12:4">ታኒ ፅሎነ ቦረይ ባይና አስ ግድኮካ ቀልቅሰስ አታስ።<verse eid="JOB 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 12:5"/>መቶትድ በእቦና አስ ሀራ አሳ መቶን ሚጬስ፤</para>
  <para style="q2" vid="JOB 12:5">ህንተ ኩንዳናዉ ጋንድጋርያ አስ ሱጌታ።<verse eid="JOB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 12:6"/>ቦንቀይሳታ ኬይ ሳሮ ደኤስ፤</para>
  <para style="q2" vid="JOB 12:6">ፆሳ ይሎየይሳት ህርግ ባይና ደኦሶና፤</para>
  <para style="q2" vid="JOB 12:6">ባንታ ዎልቃ ባንታዉ ፆሰ ኦሶና።<verse eid="JOB 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 12:7"/>አነ መሄታ ኦይቻ፤ ኤንቲ ነና ታማርሳና፤</para>
  <para style="q2" vid="JOB 12:7">ዎይኮ ሳሎ ካፎታ ኦይቻ፤ ኤንቲ ነዉ ኦዳና።<verse eid="JOB 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 12:8"/>ዎይኮ ሳአ መተታስ ኦዳ፤ ኤንቲ ነና ታማርሳና፤</para>
  <para style="q2" vid="JOB 12:8">አባ ሞሎትካ ነዉ ኦዳና።<verse eid="JOB 12:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 12:9"/>ጎዳ ኩሸይ ሄሳ ኦዳይሳ ኤሮናይ ኦኔ?<verse eid="JOB 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 12:10"/>ደኦይ ደእያ መተ ኡባይነ</para>
  <para style="q2" vid="JOB 12:10">አሳ ሸምፖይ እያ ኩሸና።<verse eid="JOB 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 12:11"/>እንፃርስ ካ ሻክድ ኤረይሳዳ፥</para>
  <para style="q2" vid="JOB 12:11">ሀይ ኦዳ ሻክድ ኤረነዬ?<verse eid="JOB 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 12:12"/>ጭንጫተ ዶንዳ አሳ ማታን ደነዬ?</para>
  <para style="q2" vid="JOB 12:12">ዳሮ ላይ ደእዳ አሳ ማታን አኬክ በንተነዬ?<verse eid="JOB 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 12:13"/>ጭንጫተነ ዎልቅ ፆሳሳ፤</para>
  <para style="q2" vid="JOB 12:13">ዞረይነ አኬክ እያ ማታን በንቴስ።<verse eid="JOB 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 12:14"/>ፆሳይ ላልዳባ ዛር ኬፃናይ ኦኔ?</para>
  <para style="q2" vid="JOB 12:14">እ ቃችዳ ኡራ ብርሻናይ ኦኔ?<verse eid="JOB 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 12:15"/>ፆሳይ እራ ተቅኮ ቢታይ መሌስ፤</para>
  <para style="q2" vid="JOB 12:15">እራ ቡክስኮ ድኦይ ቢታ ይሴስ።<verse eid="JOB 12:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 12:16"/>ምኖተነ ፆኖይ ፆሳሳ፤</para>
  <para style="q2" vid="JOB 12:16">ጭመተይስነ ጭመይስ ናምአይካ እያፐ ጋርሳን ደኤስ።<verse eid="JOB 12:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 12:17"/>ዞረይሳታፐ ጭንጫተ ቃር ኤኬስ፤</para>
  <para style="q2" vid="JOB 12:17">ሀላቃታካ ኤያ ከሴስ።<verse eid="JOB 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 12:18"/>እ ካዎታ አራታፐ ዎድ አይለ ከሴስ።<verse eid="JOB 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 12:19"/>ካህነታፐ ቦንቹዋ ቃር ኤኬስ፤</para>
  <para style="q2" vid="JOB 12:19">አዱሳ ዎደ ፃጶ የድዳ ዎልቃማታ ሽር የጌስ።<verse eid="JOB 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 12:20"/>አማነትዳ ዞረይሳታ ስእ ኦስ፤</para>
  <para style="q2" vid="JOB 12:20">ጭማታፐካ አኬካ የግሴስ።<verse eid="JOB 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 12:21"/>ቦንቸትዳይሳታ ካዉሼስ፤</para>
  <para style="q2" vid="JOB 12:21">ምኖታ ዳንጮ ብልሴስ።<verse eid="JOB 12:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 12:22"/>ማን ደእያ ፁራ ቆንጨ ከሴስ፤</para>
  <para style="q2" vid="JOB 12:22">ሌልዳ ማ ፖኦ ከሴስ።<verse eid="JOB 12:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 12:23"/>ፆሳይ ካዎተታ ግታዬስ፤ ዛሪድ ይሴስ፤</para>
  <para style="q2" vid="JOB 12:23">ካዎተታ ዳልግሴስ፤ ዛሪድ ላሌስ።<verse eid="JOB 12:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 12:24"/>አላምያ ካዎታ አኬካ ድጌስ፤</para>
  <para style="q2" vid="JOB 12:24">ኦገይ ባይና መላ ቢታን ቶይላታና መላ ኦስ።<verse eid="JOB 12:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 12:25"/>ፖኦይ ባይና ማን ታታፎሶና፤</para>
  <para style="q2" vid="JOB 12:25">ማትዳ አሳዳ ጋንድጋሮሶና።<verse eid="JOB 12:25"/></para>
  <chapter eid="JOB 12"/>
  <chapter number="13" style="c" sid="JOB 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 13:1"/>ሀ ኡባ ታ አይፈይ በእስ፤</para>
  <para style="q2" vid="JOB 13:1">ታ ሀይይ ስእድ አኬክስ።<verse eid="JOB 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 13:2"/>ህንተ ኤረይሳ ታካ ኤራይስ፤</para>
  <para style="q2" vid="JOB 13:2">ታኒ ህንተፈ ጉፅከ።<verse eid="JOB 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 13:3"/>ሽን ታኒ ኡባ ዳንዳእያ ፆሳራ ኦደታናዉ ኮያይስ፤</para>
  <para style="q2" vid="JOB 13:3">ታኒ ታ መቱዋባ እያራ ሞተታናዉ አሞታይስ።<verse eid="JOB 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 13:4"/>ሽን ህንተ ዎርዶን ካመይሳታ፤</para>
  <para style="q2" vid="JOB 13:4">ህንተ ኡባይካ ፓና አክመታ።<verse eid="JOB 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 13:5"/>ህንተ ስእ ግዳባ ግድያኮ፥</para>
  <para style="q2" vid="JOB 13:5">ጭንጫ ግድ በንታናሽን!<verse eid="JOB 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 13:6"/>ሀእ ታ ሞቱዋ ስእተ፤</para>
  <para style="q2" vid="JOB 13:6">ታ ዶናፐ ከያ ፓላማ ሀይዝተ።<verse eid="JOB 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 13:7"/>ህንተ ፆሳ ግሾ ዎርዶ ኦደቴቲ?</para>
  <para style="q2" vid="JOB 13:7">እያ ግሾ ግድ ጭሞን ኦደቴቲ?<verse eid="JOB 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 13:8"/>ህንተ እያ ማድያባይ ደኢ?</para>
  <para style="q2" vid="JOB 13:8">ዎይኮ እያዉ ፃባቃ ኤቅድ ሞተተቲ?<verse eid="JOB 13:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 13:9"/>እ ህንተና ፕልግ ፄልያኮ ህንተፈ ሎኦባ ደማኔ?</para>
  <para style="q2" vid="JOB 13:9">ህንተ አሰ ጭመይሳዳ እያ ጭማናዉ ዳንዳኤቲ?<verse eid="JOB 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 13:10"/>ህንተ ጌማን አሳ ሶምኦ በእድ ማድኮ፥</para>
  <para style="q2" vid="JOB 13:10">እ ቱማ ህንተና ሴራና።<verse eid="JOB 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 13:11"/>እያ ቦንቾይ ህንተና ዳጋንኔ?</para>
  <para style="q2" vid="JOB 13:11">እያ ቴማይ ህንተና ያሸኔ?<verse eid="JOB 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 13:12"/>ህንተ ኦድዳ ሌምሶይ ብድን መላ ፓናባ፤</para>
  <para style="q2" vid="JOB 13:12">ህንተ ሞቶይ ቢታፈ መትዳ ጎንዳለ መላ።<verse eid="JOB 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 13:13"/>አነ ስእ ጊተ፤ ታ ኦደታና፤</para>
  <para style="q2" vid="JOB 13:13">ህዛፐ ሀንዳባይ ሀኖ።<verse eid="JOB 13:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 13:14"/>ታኒ ታናተ አይስ መቶን የግያና?</para>
  <para style="q2" vid="JOB 13:14">ታ ደኡዋ አይስ ታ ኩሸን ኦይክያና?<verse eid="JOB 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 13:15"/>ፆሳይ ታና ዎኮካ ታኒ እያ ዳንዳአን ናጋና፤</para>
  <para style="q2" vid="JOB 13:15">ታኒ ታ መቱዋ እያ ስን ሺሻና።<verse eid="JOB 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 13:16"/>ናጋራንቾ አስ እያ ስን ሺቃናዉ ዳንዳኦና ግሾ፤</para>
  <para style="q2" vid="JOB 13:16">ኦን ኤር ታ ፃላተይ አቶተስ ጋሶ ግዳናዉ ዳንዳኤስ።<verse eid="JOB 13:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 13:17"/>ታ ሃሳያ አኬክድ ስእተ፤</para>
  <para style="q2" vid="JOB 13:17">ታ ኦዳይ ህንተ ሀይን ገሎ።<verse eid="JOB 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 13:18"/>ሀእ ታኒ ታ መቱዋ ኤካ ሺቃስ፤</para>
  <para style="q2" vid="JOB 13:18">እ ታዉ ፕርዳናይሳ ኤራይስ።<verse eid="JOB 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 13:19"/>ታና ሞታና አስ ደኢ?</para>
  <para style="q2" vid="JOB 13:19">ደእኮ ታኒ ስእ ጋዳ ሀይቃና።<verse eid="JOB 13:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 13:20"/>ፆሳዉ ነ ታዉ ሀ ናምኡባታ ኦ፤</para>
  <para style="q2" vid="JOB 13:20">ያትኮ ታ ነ ስንፈ ጌምከ።<verse eid="JOB 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 13:21"/>ነ ሴራ ኩሽያ ታፐ ደን፤</para>
  <para style="q2" vid="JOB 13:21">ታና ዳጋንይሳ አጋ።<verse eid="JOB 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 13:22"/>ሄሳፈ ጉየ፥ ታና ፄጋ፤ ታ ኮያና፤</para>
  <para style="q2" vid="JOB 13:22">ዎይኮ ታ ኦዳና፥ ነ ታዉ ዛራ።<verse eid="JOB 13:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 13:23"/>ታ ባላይነ ናጋራይ አፑኔ?</para>
  <para style="q2" vid="JOB 13:23">አነ ታ ናቁዋነ ታ ናጋራ ታና በሳ።<verse eid="JOB 13:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 13:24"/>ኔኒ አይስ ነ ሶምኡዋ ታፐ ገንይ?</para>
  <para style="q2" vid="JOB 13:24">ነ ሞርከዳ አይስ ታና ታይባይ?<verse eid="JOB 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 13:25"/>ጫርኮይ ኤፍያ ካልያ አይስ ኡንኤይ?</para>
  <para style="q2" vid="JOB 13:25">መልዳ ፑኑዋ አይስ የደይ?<verse eid="JOB 13:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 13:26"/>ኔኒ ታ ቦላ ፃፍዳ ሞቶይ ጫሞ፤</para>
  <para style="q2" vid="JOB 13:26">ታ ናአተ ባላካ አጋባካ።<verse eid="JOB 13:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 13:27"/>ኔኒ ታ ቶሁዋ ዱፃዳሳ፤</para>
  <para style="q2" vid="JOB 13:27">ታ ታንጉዋ ኡባ ዎቻሳ፤</para>
  <para style="q2" vid="JOB 13:27">ታ ቶሆይ የያሱዋ ካላሳ።<verse eid="JOB 13:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 13:28"/>ሄሳ ግሾ፥ ታኒ ዎቅዳ ምዳ፤</para>
  <para style="q2" vid="JOB 13:28">ብል ምዳ አፍላዳ ዉራይስ።<verse eid="JOB 13:28"/></para>
  <chapter eid="JOB 13"/>
  <chapter number="14" style="c" sid="JOB 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 14:1"/>“ማጫሳፐ የለትዳ አሳስ ላይ ቃን፤</para>
  <para style="q2" vid="JOB 14:1">እካ ቃስ መቶን ኩምስ።<verse eid="JOB 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 14:2"/>ጪሻዳ በንትድ ኤለስድ ቆቆፈቴስ፤</para>
  <para style="q2" vid="JOB 14:2">ኩያዳ ጋምኦና ኤሶን አስ።<verse eid="JOB 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 14:3"/>ያትን፥ ኔኒ ሄሳ መላ አስ ካላዬ?</para>
  <para style="q2" vid="JOB 14:3">ፕርዳስ ነ ስን ሺሻዬ?<verse eid="JOB 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 14:4"/>ቱናባፐ ጌሻባ ከሳናዉ ዳንዳኤይ ኦኔ?</para>
  <para style="q2" vid="JOB 14:4">ኦንካ ባዋ።<verse eid="JOB 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 14:5"/>አስ ዳና ላይስ ዛው ደኤስ፤</para>
  <para style="q2" vid="JOB 14:5">እ ዳና አጌና ኔኒ ታይባ ዎዳሳ፤</para>
  <para style="q2" vid="JOB 14:5">ኔኒ ዎዳ ዛዋፐ አይ ኦንካ ባዋ።<verse eid="JOB 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 14:6"/>ኡነ ኦያ አስ ባ ኦሱዋ ፖልድ ሸምፐይሳዳ፥</para>
  <para style="q2" vid="JOB 14:6">እ ሸምፓና መላ ነ አይፍያ እያፐ ደንዳ እያ አጋጋ።<verse eid="JOB 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 14:7"/>ቃንፀትዳ ምስ ኡፋይስ ደኤስ፤</para>
  <para style="q2" vid="JOB 14:7">ዛሪድ አጬስ፤</para>
  <para style="q2" vid="JOB 14:7">ኦራ ታሸ ከስድ ድጬስ።<verse eid="JOB 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 14:8"/>ም ፃጶይ ቢታ ጋርሳን ጭምኮካ፥</para>
  <para style="q2" vid="JOB 14:8">ዱሩማይ ቢታን ዎቅኮካ፥<verse eid="JOB 14:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="JOB 14:9"/>ሃ ደምድ አጬስ፤</para>
  <para style="q2" vid="JOB 14:9">ኦራ ዶላዳ ታሸ ከሴስ።<verse eid="JOB 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 14:10"/>ሽን አስ ሀይቄስ፤ ሄስ እያዉ ዉርሰ፤</para>
  <para style="q2" vid="JOB 14:10">እያ ሸምፖይ ከያፐ ጉየ እ አዉን ደኢ?<verse eid="JOB 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 14:11"/>አባ ሃ መለይሳዳ፥</para>
  <para style="q2" vid="JOB 14:11">ሻፋ ሃ ዉረይሳዳ፥<verse eid="JOB 14:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="JOB 14:12"/>ሄሳዳ አስካ ሀይቄስ፤ ስሚድ ደንደና፤</para>
  <para style="q2" vid="JOB 14:12">ሳሎት አና ጋካናዉ አስ ባርከና፤</para>
  <para style="q2" vid="JOB 14:12">ባ ስኩዋፈካ ደንደና።<verse eid="JOB 14:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 14:13"/>ኔኒ ታና ዱፎን ገንዳኮ አይበ!</para>
  <para style="q2" vid="JOB 14:13">ነ ሀንቆይ አና ጋካናዉ ቆትዳኮ አይበ!</para>
  <para style="q2" vid="JOB 14:13">ነ ታዉ ቃሚዳ ሄ ጋላስ ታና ሀሳይዳኮ አይበ!<verse eid="JOB 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 14:14"/>አስ ሀይቅኮ ስሚድ ደኦን ዳኔ?</para>
  <para style="q2" vid="JOB 14:14">ታ ሸምፕያ ዎደይ ያና ጋካናዉ፥</para>
  <para style="q2" vid="JOB 14:14">ሀ መቶ ዎደ ኡባ ዳንዳአን ናጋና።<verse eid="JOB 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 14:15"/>ሄ ዎደ ነ ታና ፄጋና ታካ ኮያና፤</para>
  <para style="q2" vid="JOB 14:15">ነ መዳ ታና በአናዉ ላሞትያ ዎደይ ያና።<verse eid="JOB 14:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 14:16"/>ሄ ዎደ ኔኒ ቱማ ታ ታንጉዋ ዎቻና፤</para>
  <para style="q2" vid="JOB 14:16">ሽን ታ ናጋራ ካላካ።<verse eid="JOB 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 14:17"/>ታ ባላይ ኦጎሮን ዪጨታና፤</para>
  <para style="q2" vid="JOB 14:17">ታ ናጋራ ኔኒ ካማና።<verse eid="JOB 14:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 14:18"/>ዙም ዎደይሳዳ፥</para>
  <para style="q2" vid="JOB 14:18">ዛል ቃለተይሳዳ፥<verse eid="JOB 14:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="JOB 14:19"/>ሃ ሹቻ ፃጶ ቦከይሳዳ፥</para>
  <para style="q2" vid="JOB 14:19">ድኦይ ቢታ ሜጭድ ኤፈይሳዳ፥</para>
  <para style="q2" vid="JOB 14:19">ኔኒ አሳ ኡፋይስ ይሳሳ።<verse eid="JOB 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 14:20"/>ኔኒ እያ መርናዉ ፆናሳ፤ እ ስመና፤</para>
  <para style="q2" vid="JOB 14:20">እያ ማላ ላማዳ ነ ስንፈ ድጋሳ።<verse eid="JOB 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 14:21"/>እያ ናይት ቦንቸትኮ እ ኤረና፤</para>
  <para style="q2" vid="JOB 14:21">ኤንቲ ካዉይኮ እ በኤና።<verse eid="JOB 14:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 14:22"/>ሽን እያ አሳተ ሴላይ እያ ፃላላስ ስኤቴስ፤</para>
  <para style="q2" vid="JOB 14:22">እ ባ ፃላላስ ዬኬስ” ያግስ።<verse eid="JOB 14:22"/></para>
  <chapter eid="JOB 14"/>
  <chapter number="15" style="c" sid="JOB 15"/>
  <para style="s1">ኤልፋዛ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 15:1"/>ተማና ቢታፈ ይዳ ኤልፋዝ ሀይሳዳ ያግስ፤<verse eid="JOB 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 15:2"/>“ጭንጫ አስ ጫርኮዳ ኦይከቶናባ ኦዴቲ?</para>
  <para style="q2" vid="JOB 15:2">ዎይኮ ዶሎሀ ባጋ ጫርኩዋን ባ ኡሉዋ ጮ ኩን?<verse eid="JOB 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 15:3"/>ፓና ቃላን ዙዙሚ?</para>
  <para style="q2" vid="JOB 15:3">ዎይኮ ጋተይ ባይና ኦዳን ሞተቲ?<verse eid="JOB 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 15:4"/>ኔኒ ፆሳስ ያየይሳ አጋዳሳ፤</para>
  <para style="q2" vid="JOB 15:4">ሀራት ፆሳ ጎይኖና መላ ባዳሳ።<verse eid="JOB 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 15:5"/>ነ ኢታተይ ነ ኦዳን ኤረቴስ፤</para>
  <para style="q2" vid="JOB 15:5">ሽን ነ ጭንጫ ኦዳይ ነና ገንስ።<verse eid="JOB 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 15:6"/>ነ ዶናይ ነ ቦላ ፕርዴስ ታና ግድከ፤</para>
  <para style="q2" vid="JOB 15:6">ነ እንፃርሳይ ነ ቦላ ማርካቴስ።<verse eid="JOB 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 15:7"/>“አሳፐ ኮይሮ የለትዳይ ነኔ?</para>
  <para style="q2" vid="JOB 15:7">ኔኒ ደረት መታናፐ ካሰ የለታዲ?<verse eid="JOB 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 15:8"/>ኔኒ ፆሳ ፁራ ዱላታን ደአይ?</para>
  <para style="q2" vid="JOB 15:8">አሳ ጭንጫተ ነ ፃላላስ ደእዬ?<verse eid="JOB 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 15:9"/>ኑኒ ኤሮናባይ ኔኒ ኤርያባይ አይቤ?</para>
  <para style="q2" vid="JOB 15:9">ኑስ ጌምዳ ነዉ ቆንጭዳ አይባ ጭንጫተ ደኢ?<verse eid="JOB 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 15:10"/>ነ አዋፐ ባይራትያ አሳት፥</para>
  <para style="q2" vid="JOB 15:10">ጭምድ ፑሉምዳ አሳት ኑራ ደኦሶና።<verse eid="JOB 15:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 15:11"/>“ፆሳይ ነዉ እምዳ ምንይ ግደነዬ?</para>
  <para style="q2" vid="JOB 15:11">ኑኒ ካሃማተባ ኦድዳ ቃላይ ጉዬ?<verse eid="JOB 15:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 15:12"/>ነ ዎዛናይ ነና አይስ ዎራ ኤፊ?</para>
  <para style="q2" vid="JOB 15:12">ነ አይፈይ አይስ ደሬቅድ ፄሊ?<verse eid="JOB 15:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 15:13"/>ያታዳ ኔኒ ፆሳ ቦላ ሀንቀታዳሳ፤</para>
  <para style="q2" vid="JOB 15:13">ኢታ ቃላ ነ ዶናፐ ከሳዳሳ።<verse eid="JOB 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 15:14"/>አስ ፆሳ ስንን ጌሽ ግዳናዉ ዳንዳኢ?</para>
  <para style="q2" vid="JOB 15:14">ዎይኮ ማጫፈ የለትዳ አስ ፅሎ ግዳናዉ ዳንዳኢ?<verse eid="JOB 15:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 15:15"/>ፆሳይ ባ ኪታንቾታን አማነተና፤</para>
  <para style="q2" vid="JOB 15:15">ሀር አቶሽን ሳሎት እያ ስንን ጌሽ ግዶኮና።<verse eid="JOB 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 15:16"/>ኢታነ ቱና ግድዳ አስ፥</para>
  <para style="q2" vid="JOB 15:16">ናጋራ ሃዳ ኡያ አስ ዋንድ አማነታኔ?<verse eid="JOB 15:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 15:17"/>“አነ ስአ፥ ቆንጭሳዳ ታ ነዉ ኦዳና፥</para>
  <para style="q2" vid="JOB 15:17">ታኒ በእዳባ ኡባ ነዉ ኦዳና።<verse eid="JOB 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 15:18"/>ጭንጫት ባንታ አዋታፐ ኤክዳይሳ፥</para>
  <para style="q2" vid="JOB 15:18">ታ ነዉ ገንና ኦዳና።<verse eid="JOB 15:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 15:19"/>ቢታይ ኤንታ ፃላላስ እመትስ፤</para>
  <para style="q2" vid="JOB 15:19">ሀራ ቢታ አስ ኤንታራ ዋላከትቤና።<verse eid="JOB 15:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 15:20"/>አሰ ኡንኤሸ ደእያ ኢታ አስ፥</para>
  <para style="q2" vid="JOB 15:20">ባ ደኦ ላይ ኡባን ዋየትሸ ደኤስ።<verse eid="JOB 15:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 15:21"/>ዳጋንያባይ እያ ሀይን ስኤቴስ፤</para>
  <para style="q2" vid="JOB 15:21">እ ሳሮ ደአይስ ግሽን ይሰይሳት እያ ቦላ ከያና።<verse eid="JOB 15:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 15:22"/>ማፐ ከስ ኤኮይ እያዉ ሀነና፤</para>
  <para style="q2" vid="JOB 15:22">እያ ቃዳይ ማሻን ዮ።<verse eid="JOB 15:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 15:23"/>እያ አሀይ አንኮ ቁማ ግዳና፤</para>
  <para style="q2" vid="JOB 15:23">ባዉ ማ ጋላስ ማታትዳይሳ እ ኤሬስ።<verse eid="JOB 15:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 15:24"/>መቶይነ ኡንእ እያ ቦላ ያና፤</para>
  <para style="q2" vid="JOB 15:24">ኦላናዉ ከይዳ ካዎ መላ እያ ቦላ ጎባና።<verse eid="JOB 15:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 15:25"/>ሄስካ እ ባ ኩሽያ ፆሳ ቦላ ደንዳ ግሾሳ፤</para>
  <para style="q2" vid="JOB 15:25">ኡባ ዳንዳእያ ፆሳ ቦላ ፃልዳ ግሾሳ።<verse eid="JOB 15:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 15:26"/>እ ኤቀታናዉ ምኖነ ዳልጋ ጎንዳለ ኦይክስ፤</para>
  <para style="q2" vid="JOB 15:26">ኦቶሮን ፆሳኮ ሆርዶፌስ።<verse eid="JOB 15:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 15:27"/>“እያ ክላሆይ ሙምዳ ግሾ፥</para>
  <para style="q2" vid="JOB 15:27">እያ ፄሳይ ኩምዳ ግሾ፥<verse eid="JOB 15:27"/></para>
  <para style="q2">
    <verse number="28" style="v" sid="JOB 15:28"/>እ ላለትዳ ካታማታን፥</para>
  <para style="q2" vid="JOB 15:28">ካይሳ ኬንነ፥</para>
  <para style="q2" vid="JOB 15:28">ኩንዳናዉ ጋክዳ ኬን ደኤስ።<verse eid="JOB 15:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 15:29"/>እ ባ ዱረተን ዳሮ ጋምኤና፤</para>
  <para style="q2" vid="JOB 15:29">እያ ዛዋይ አከና።<verse eid="JOB 15:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 15:30"/>ማፐ ከስ ኤከናዉ ዳንዳኤና፤</para>
  <para style="q2" vid="JOB 15:30">ታሽያ ታም ላብዳ ምዳነ</para>
  <para style="q2" vid="JOB 15:30">ጫርኮይ ጪሻ ቆቆፍዳ ምዳ ግዳና።<verse eid="JOB 15:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 15:31"/>ፓናባን አማነትድ ባና ጭሞፎ፤</para>
  <para style="q2" vid="JOB 15:31">እያፐ አይኮካ ደሞና አታና።<verse eid="JOB 15:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 15:32"/>ዎደይ ጋኮና እያ ኡባይ መልድ</para>
  <para style="q2" vid="JOB 15:32">ታሸይካ አጮና ም መላ ግዳና።<verse eid="JOB 15:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 15:33"/>እ ቴሮና ቃዉኤ ደእሸ ቆቆፈትያ ዎይነ መላ፤</para>
  <para style="q2" vid="JOB 15:33">ጪሻን ደእሸ ቆቆፈትያ ሻማሆ መላ።<verse eid="JOB 15:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 15:34"/>ፆሳስ ያዮና አሳ ኮቻይ ያና፤</para>
  <para style="q2" vid="JOB 15:34">ዎፈን ኬፀትዳ ኬይ ታማን ሜተታና።<verse eid="JOB 15:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 15:35"/>ኤንቲ ኢታተ ቃንትድ መቶ የሎሶና፤</para>
  <para style="q2" vid="JOB 15:35">ኤንታ ኡሉዋን ገነይ ኩምስ” ያግስ።<verse eid="JOB 15:35"/></para>
  <chapter eid="JOB 15"/>
  <chapter number="16" style="c" sid="JOB 16"/>
  <para style="s1">እዮባ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 16:1"/>እዮብ ሀይሳዳ ያግድ ዛርስ፤<verse eid="JOB 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 16:2"/>“ታኒ ሄሳ መላ ሃሳያ ዳሮ ስአስ፤</para>
  <para style="q2" vid="JOB 16:2">ህንተ ምንይ ታና ሳለስ።<verse eid="JOB 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 16:3"/>ጎእ ባይና ህንተ ኦዳስ ዉርሰ ባዌ?</para>
  <para style="q2" vid="JOB 16:3">ታራ ህንተና ሄሳዳ ፓላንያ ጋሶይ አይቤ?<verse eid="JOB 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 16:4"/>ህንተ ታ በሳን፥ ታኒ ህንተ በሳን ግድዳባ ግድያኮ፥</para>
  <para style="q2" vid="JOB 16:4">ታኒ ታ ሁጵያ ቃሸ፥</para>
  <para style="q2" vid="JOB 16:4">ሀእ ህንተ ግያባ ኡባ ህንተ ቦላ ሎይዳ ጋናሽን!<verse eid="JOB 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 16:5"/>ታ ዞርያን ታ ህንተና ምንናሽን!</para>
  <para style="q2" vid="JOB 16:5">ታ ዶናፐ ከይያ ኦዳይ ህንተና ምንናሽን!<verse eid="JOB 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 16:6"/>“ሽን ታ ሃሳይኮካ ታ ሳሆይ ደጨና፤</para>
  <para style="q2" vid="JOB 16:6">ታ ስእ ጋዳ ዳንዳእኮካ ታፐ ክቸና።<verse eid="JOB 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 16:7"/>አቤት ፆሳዉ፥ ነ ታና ታ አሳተፈ ከሳዳሳ፤</para>
  <para style="q2" vid="JOB 16:7">ታ ኬ አሳ ኡባ ይሳዳሳ።<verse eid="JOB 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 16:8"/>ሹቅዳ ታ ጎጋይ ታዉ ማርካ ግድስ፤</para>
  <para style="q2" vid="JOB 16:8">ታ ግልቃተይ ታና ናጋራንቾ ከስስ።<verse eid="JOB 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 16:9"/>ፆሳይ ሀንቀትድ ታ አሳተ ቃንፀረስ፤</para>
  <para style="q2" vid="JOB 16:9">ታና እፅድ ባ አቻ ታ ቦላ ጋርጭስ፤</para>
  <para style="q2" vid="JOB 16:9">ታ ሞርከይ ባ አይፍያ ታ ቦላ ከስስ።<verse eid="JOB 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 16:10"/>አሳይ ታ ዩሾን ሺቅድ ታና ቀልቅስዶሶና፤</para>
  <para style="q2" vid="JOB 16:10">ታና ለቅድ ባቅዶሶና። <verse eid="JOB 16:10"/><verse number="11" style="v" sid="JOB 16:11"/>ፆሳይ ታና ናጋራቾታስ አድ እሚስ፤</para>
  <para style="q2" vid="JOB 16:11">ኢታታ ኩሸን ታና የግስ።<verse eid="JOB 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 16:12"/>ታኒ ካሰ ሳሮ ደአስ፤</para>
  <para style="q2" vid="JOB 16:12">ሽን ፆሳይ ታና ትንቸረስ፤</para>
  <para style="q2" vid="JOB 16:12">ታ ምርጋጭያ ኦይክድ ታና መንረስ፤</para>
  <para style="q2" vid="JOB 16:12">ጫቸ ሎህስያ ማላ ኦስ።<verse eid="JOB 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 16:13"/>እያ ቶራንቾት ባንታ ዶንገን ታና ተቅዶሶና፤</para>
  <para style="q2" vid="JOB 16:13">ቃይ ባይና ታ ክላሁዋ ሙፀረዶሶና፤</para>
  <para style="q2" vid="JOB 16:13">ታ ጭያ ሳአን ጉስዶሶና።<verse eid="JOB 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 16:14"/>እ ታና ዛር ዛር ማዱንፅስስ፤</para>
  <para style="q2" vid="JOB 16:14">ኦላንቾዳ ቶልድ ጫድስ።<verse eid="JOB 16:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 16:15"/>ታኒ ካዮ ማኦ ማአስ፤</para>
  <para style="q2" vid="JOB 16:15">ታ ዎልቃይ ዉርን ባናን ኡታስ።<verse eid="JOB 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 16:16"/>ዬሆን ታ ሶምኦይ ጋቢስ፤</para>
  <para style="q2" vid="JOB 16:16">ታ አይፈይ ዞእስ።<verse eid="JOB 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 16:17"/>ሽን ሄ ኡባን ታ ባልዳባይ ባዋ፤</para>
  <para style="q2" vid="JOB 16:17">ታ ጌሻ ዎዛናን ዎሳይስ።<verse eid="JOB 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 16:18"/>ቢታዉ፥ ታና ጋክዳ ቆሁዋ ካሞፋ፤</para>
  <para style="q2" vid="JOB 16:18">ታ ዋሶይ ሸምፕያ ሶ ደሞፎ።<verse eid="JOB 16:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 16:19"/>ሄኮ ታ ማርካይ ሳሎና፤</para>
  <para style="q2" vid="JOB 16:19">ታ ፃባቃይ ቦላና።<verse eid="JOB 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 16:20"/>ታ ላገት ታና ካድ ፄሎሶና፤</para>
  <para style="q2" vid="JOB 16:20">ታ አይፈይ ፆሳ ስንን አፉ ትጌስ።<verse eid="JOB 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 16:21"/>አሰ አሳራ ስገያ አስ ደኤይሳዳ፥</para>
  <para style="q2" vid="JOB 16:21">ታና ፆሳራ ስገያ አስ ደእዳባ ግድረነሽን።<verse eid="JOB 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 16:22"/>ታ ላይይ ዉራና ሀኔስ፤</para>
  <para style="q2" vid="JOB 16:22">ጉ ዎደፐ ጉየ ታ ስሞና ሶ ባና።<verse eid="JOB 16:22"/></para>
  <chapter eid="JOB 16"/>
  <chapter number="17" style="c" sid="JOB 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 17:1"/>ታ ሸምፖይ ከዬስ፤</para>
  <para style="q2" vid="JOB 17:1">ታ ላይይ ቃምስ፤</para>
  <para style="q2" vid="JOB 17:1">ታዉ ዱፎይ ጊግስ።<verse eid="JOB 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 17:2"/>ታ ቦላ ቀልቅሰይሳት ታ ዩሹዋን ደኦሶና፤</para>
  <para style="q2" vid="JOB 17:2">ኤንቲ ታና ይሎይዳ መላ አይስዶሶና።<verse eid="JOB 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 17:3"/>አቤት ፆሳዉ፥ ኔፐ ሀር ታና ማደይ ባይና ግሾ፥</para>
  <para style="q2" vid="JOB 17:3">ነ ታዉ ዋሰ ግዳ።<verse eid="JOB 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 17:4"/>ኤንቲ አኬኮና መላ ኤንታ ቆፋ ጎርዳዳሳ፤</para>
  <para style="q2" vid="JOB 17:4">ሄሳ ግሾ፥ ነ ኤንታዉ ፆኖ እሞፋ።<verse eid="JOB 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 17:5"/>ሚሸ ደማና ግድ፥</para>
  <para style="q2" vid="JOB 17:5">ባ ላገታ አድ እምያ ኡራ ናይታ አይፈይ ቆቃና።<verse eid="JOB 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 17:6"/>ፆሳይ ታና አሳስ ሚቻስ አግስ፤</para>
  <para style="q2" vid="JOB 17:6">አስ ጩትሸ አያ አስ ግዳስ።<verse eid="JOB 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 17:7"/>ታ ዳሮ ካዮትዳ ግሾ ታ አይፈይ ኤይስ፤</para>
  <para style="q2" vid="JOB 17:7">ታ አሳተይ ላፍድ ኤሾ ግድስ።<verse eid="JOB 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 17:8"/>ኬሀ አሳት ታና በእድ ዳጋምዶሶና፤</para>
  <para style="q2" vid="JOB 17:8">ሱረት ፆሳ አማኖናይሳታ ቦላ ይሎትዶሶና።<verse eid="JOB 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 17:9"/>ግዶሽን ፅሎት ባንታ ኦግያፐ ደሾኮና፤</para>
  <para style="q2" vid="JOB 17:9">ሱረት ዎልቃ ጉጅ ጉጅ ቦሶና።<verse eid="JOB 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 17:10"/>ሽን ዛሪድ ኡባይ ታኮ ሃ ዪተ!</para>
  <para style="q2" vid="JOB 17:10">ታ ህንተ ግዶፈ እስ ጭንጫ አስ ደምከ።<verse eid="JOB 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 17:11"/>ታ ደኦ ላይይ ዉርስ፤</para>
  <para style="q2" vid="JOB 17:11">ታ ሀልቾይ ሀዳ ግድስ፤</para>
  <para style="q2" vid="JOB 17:11">ታ ዎዛና አሞይ ጮ አትስ።<verse eid="JOB 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 17:12"/>ታ ላገት ቃማ ጋላስ ጎሶና፤</para>
  <para style="q2" vid="JOB 17:12">ማ በእሸ ‘ፖአና ሀኔስ’ ያጎሶና።<verse eid="JOB 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 17:13"/>ታ ኡፋይሳን ናግያ ኬይ ዱፎ፤</para>
  <para style="q2" vid="JOB 17:13">ታ ሂፃ ማን ሂፃይስ።<verse eid="JOB 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 17:14"/>ዱፎኮ፥ ‘ነ ታ አዋ’ ያጋና፤</para>
  <para style="q2" vid="JOB 17:14">ጉፁነኮ፥ ‘ነ ታ አዮ ዎይኮ ታ ምቾ’ ያጋና።<verse eid="JOB 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 17:15"/>ያትን፥ ታዉ አይ ኡፋይስ ደኢ?</para>
  <para style="q2" vid="JOB 17:15">ታዉ ኡፋይስ ግድያባ ኦን ደማናይ?<verse eid="JOB 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 17:16"/>ታ ኡፋይሳይ ታራ ዱፎ ባንዴ?</para>
  <para style="q2" vid="JOB 17:16">ኑ እስፈ ቢታን ዱገ ገላኔ?” ያግስ።<verse eid="JOB 17:16"/></para>
  <chapter eid="JOB 17"/>
  <chapter number="18" style="c" sid="JOB 18"/>
  <para style="s1">በልዳዶሳ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 18:1"/>ሄሳፈ ጉየ፥ ሹሀ ቢታፈ ይዳ በልዳዶስ ዛሪድ፥<verse eid="JOB 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 18:2"/>“እዮባ፥ ነ ኦዳስ ዉርሰ ባዌ?</para>
  <para style="q2" vid="JOB 18:2">አነ አኬካ፤ ኑ ኦድያባ ስአ።<verse eid="JOB 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 18:3"/>ነ ኑና አይስ ሚዝ ኦይ?</para>
  <para style="q2" vid="JOB 18:3">አይስ ኑና ቱለ ከሳይ?<verse eid="JOB 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 18:4"/>ነ ሀንቀታዳ ነና ቆሃሳ፤</para>
  <para style="q2" vid="JOB 18:4">ነ ሀንቁዋን ቢታይ ካሎ አታኔ?</para>
  <para style="q2" vid="JOB 18:4">ዎይኮ ዛላይ ባ በሳፈ ቃፀኔ?<verse eid="JOB 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 18:5"/>ናጋራንቾታ ፆምፐይ ቶአና፤</para>
  <para style="q2" vid="JOB 18:5">እያ ታማ ላጮይ ያና።<verse eid="JOB 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 18:6"/>ኤንታ ኬን ደእያ ፆምፐይ ያና፤</para>
  <para style="q2" vid="JOB 18:6">ኤንታ ፖኦይካ ማና።<verse eid="JOB 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 18:7"/>እ ታንግያ ታንጎይ ቃሜስ፤</para>
  <para style="q2" vid="JOB 18:7">እያ ኢታ ቆፋይ እያ ዛሪድ ሜስ።<verse eid="JOB 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 18:8"/>እያ ሄመይ እያ ፅሄን ገልሴስ፤</para>
  <para style="q2" vid="JOB 18:8">እያ ቶሆት ግተታና።<verse eid="JOB 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 18:9"/>ፅሄይ እያ ግንደ ኦይካና፤</para>
  <para style="q2" vid="JOB 18:9">ዲዝ እያ ቃፆ ድጋና።<verse eid="JOB 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 18:10"/>ዩርደ ዎዶሮይ ሳአን እያዉ ጌም ኡቴስ፤</para>
  <para style="q2" vid="JOB 18:10">እ ሄመትያ ኦግያን ግተይ ደኤስ።<verse eid="JOB 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 18:11"/>ዳጋም እያ ተቅድ ኦይኬስ፤</para>
  <para style="q2" vid="JOB 18:11">እያ ጉየራ ካልድ እያ የደስ።<verse eid="JOB 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 18:12"/>እያ ዎልቃ ኮሽ ዉርስስ፤</para>
  <para style="q2" vid="JOB 18:12">ዮይ እያ ምየን ናጌስ።<verse eid="JOB 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 18:13"/>ሀርገይ እያ ላፈስ፤</para>
  <para style="q2" vid="JOB 18:13">ሀይቆይ እያ ሞክድ ኤኬስ።<verse eid="JOB 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 18:14"/>ህርግ ባይና ደእያ ባ ኬፈ ጎደቴስ፤</para>
  <para style="q2" vid="JOB 18:14">ኤንቲ እያ ሀይቆ ጌተትያ ካዋኮ ኤፎሶና።<verse eid="JOB 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 18:15"/>እያ ኬይ ታማን ኦይከታና፤</para>
  <para style="q2" vid="JOB 18:15">እ ደእያሱዋን ዲነይ ላለታና።<verse eid="JOB 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 18:16"/>ጋርሳራ ፃጶይ መላና፤</para>
  <para style="q2" vid="JOB 18:16">ቦላራ ሀይ ቆቆፈታና።<verse eid="JOB 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 18:17"/>እያ ቆፕያ አስ ቢታፈ ያና፤</para>
  <para style="q2" vid="JOB 18:17">እያ ሱንይ ሳአን ሀሳየቶና አታና።<verse eid="JOB 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 18:18"/>እ ፖኦፐ ማን ጎደታና፤</para>
  <para style="q2" vid="JOB 18:18">አላምያፐ ያና።<verse eid="JOB 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 18:19"/>እያዉ ናእ ዎይኮ ኮች ያና፤</para>
  <para style="q2" vid="JOB 18:19">እ ደእዳ በሳን እስ አስ ፓፃ አተና።<verse eid="JOB 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 18:20"/>ዉሎሀ ባጋ አሳይ እያ ጋክዳ መቱዋን ዳጋምዶሶና፤</para>
  <para style="q2" vid="JOB 18:20">ዶሎሀ ባጋ አሳይ ያሻን ኮኮርዶሶና።<verse eid="JOB 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 18:21"/>ኢታ አሳ ዉርሰይ አዉደካ ሄሳ መላ፤</para>
  <para style="q2" vid="JOB 18:21">ፆሳ ኤሮና አሳ ቃዳይ ሄሳ መላ” ያግስ።<verse eid="JOB 18:21"/></para>
  <chapter eid="JOB 18"/>
  <chapter number="19" style="c" sid="JOB 19"/>
  <para style="s1">እዮባ ሃሳያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 19:1"/>እዮብ ዛሪድ ሀይሳዳ ያግስ፤<verse eid="JOB 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 19:2"/>ህንተ ታና አዉደ ጋካናዉ ማዱንፅሴቲ?</para>
  <para style="q2" vid="JOB 19:2">አዉደ ጋካናዉ ህንተ ቃላን ታና ጫደቲ?<verse eid="JOB 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 19:3"/>ህንተ ታና ታሙ ቶሆ ጫይደታ፤</para>
  <para style="q2" vid="JOB 19:3">ታና ካዉሽሸ ዬላተከታ።<verse eid="JOB 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 19:4"/>ቱማ ታ ባልዳባ ግድኮ፥</para>
  <para style="q2" vid="JOB 19:4">ታ ባላይ ታና ኦይቻና።<verse eid="JOB 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 19:5"/>ህንተ ህንተና ቁ ቁ ኦድ፥</para>
  <para style="q2" vid="JOB 19:5">ታ ካዉሻ ታና ሞታናዉ ጎኤትኮ፥<verse eid="JOB 19:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="JOB 19:6"/>ሀ መቱዋ ታ ቦላ ኤህዳይ ፆሰ ግደይሳነ</para>
  <para style="q2" vid="JOB 19:6">ባ ግትያን ታና ገልስዳይ እያ ግደይሳ ኤርተ።<verse eid="JOB 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 19:7"/>ታ ቆሄታስ ጋዳ ዋስን፥ ታና አለይ ባዋ፤</para>
  <para style="q2" vid="JOB 19:7">ታ ቃላ ቁ ኦዳ ዋስንካ ታና ስኤይ ባዋ።<verse eid="JOB 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 19:8"/>ታ ካንዳ ቦናዳ ፆሳይ ታ ኦግያ ድርስ፤</para>
  <para style="q2" vid="JOB 19:8">ታ ሄመትያ ኦግያ ማን ጎርድስ።<verse eid="JOB 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 19:9"/>ታ ቦንቹዋ ታፐ ቃርስ፤</para>
  <para style="q2" vid="JOB 19:9">ታ ካላቻ ታ ሁጰፐ ኤክስ።<verse eid="JOB 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 19:10"/>እ ታና መንረ የግስ፤</para>
  <para style="q2" vid="JOB 19:10">ታ ኡፋይሳ ፃጶራ ሾደትዳ ም መላ ኦስ።<verse eid="JOB 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 19:11"/>እያ ሀንቆይ ታ ቦላ ኤፅ ከይስ፤</para>
  <para style="q2" vid="JOB 19:11">እ ታና ሞርከዳ ታይቤስ።<verse eid="JOB 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 19:12"/>ታና ኦላናዉ ባ ቶራንቾታ ኪቴስ፤</para>
  <para style="q2" vid="JOB 19:12">ኤንቲ ታና ኦላናዉ ሚፃ ኬፅድ፥</para>
  <para style="q2" vid="JOB 19:12">ታ ዱንካንያ ዩሹዋን ኡትዶሶና።<verse eid="JOB 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 19:13"/>ፆሳይ ታ እሻታ ታፐ ሃስስ፤</para>
  <para style="q2" vid="JOB 19:13">ታና ኤረይሳት ታዉ አላጋ ግድዶሶና።<verse eid="JOB 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 19:14"/>ታ ዳቦት ታፐ ሃክዶሶና፤</para>
  <para style="q2" vid="JOB 19:14">ታ ላገት ታና ዶግዶሶና።<verse eid="JOB 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 19:15"/>ታ ሶን ሞከትያ እማት ታና ዶግዶሶና፤</para>
  <para style="q2" vid="JOB 19:15">ታ ማጫ አይለት ታና ኦገ አሳዳ ፄልዶሶና።<verse eid="JOB 19:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 19:16"/>ታ አይልያ ታ ፄግን ታዉ ኮየና፤</para>
  <para style="q2" vid="JOB 19:16">ታ ዎስን ታዉ ኤሮ ጌና።<verse eid="JOB 19:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 19:17"/>ታ ማችያ ታ ዶና ፔኑዋ ሻተታሱ፤</para>
  <para style="q2" vid="JOB 19:17">ታ እሻት ታና ኡፍዶሶና።<verse eid="JOB 19:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 19:18"/>ሀር አቶሽን ጉ ናይት ታና ካኦሶና፤</para>
  <para style="q2" vid="JOB 19:18">ታና በእድ ለቆሶና።<verse eid="JOB 19:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 19:19"/>ታ ማታ ላገት ኡባይ ታና ኡፎሶና፤</para>
  <para style="q2" vid="JOB 19:19">ታ ዶሰይሳት ታዉ ዞኮ ዛርዶሶና።<verse eid="JOB 19:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 19:20"/>ታ መቀይ ታ ጎጋራ ኦይከትስ፤</para>
  <para style="q2" vid="JOB 19:20">ታኒ ሀይቃ ክቻዳ አታስ።<verse eid="JOB 19:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 19:21"/>ታ ላገቶ፥ ፆሳ ኩሸይ ታና ደችዳ ግሾ፥</para>
  <para style="q2" vid="JOB 19:21">ታዉ ቃተርከት።<verse eid="JOB 19:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 19:22"/>ፆሳይ ታና የደይሳዳ፥ ህንተ ታና አይስ የደቲ?</para>
  <para style="q2" vid="JOB 19:22">ሀእ ጋካናዉ ህንተ ታና ዋይስዳይስ ግደኔ?<verse eid="JOB 19:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 19:23"/>“ሀእ ጋካናዉ ታ ኦደትዳ ቃላይ ማዝጋበትዳኮ፥</para>
  <para style="q2" vid="JOB 19:23">ማፃፋን ፃፈትዳኮ ታ ዶሳይስ ሽን።<verse eid="JOB 19:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 19:24"/>መርናዉ ዳና መላ ማርሳንነ</para>
  <para style="q2" vid="JOB 19:24">እርሳሰን ዛላ ቦላ ዎጨትድ ፃፈትዳ ግዴረነ!<verse eid="JOB 19:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 19:25"/>ታና ዎዝዳይስ ደኦን ደኤይሳነ</para>
  <para style="q2" vid="JOB 19:25">ዉርሰን ቢታ ቦላ እ ኤቃናይሳ ታ ኤራይስ።<verse eid="JOB 19:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 19:26"/>ታ ጎጋይ ሜተትድ ዉርኮካ፥</para>
  <para style="q2" vid="JOB 19:26">ታኒ ታ አሹዋፐ ሻከታዳ ፆሳ በአናይሳ ኤራይስ። <verse eid="JOB 19:26"/><verse number="27" style="v" sid="JOB 19:27"/>ሀራ አስ ግዶና ታኒ ታ ሁጰን፥</para>
  <para style="q2" vid="JOB 19:27">ታ አይፈን እያ በአና፤</para>
  <para style="q2" vid="JOB 19:27">ታ ዎዛናይ ሄ ቃማ ላሞቴስ።<verse eid="JOB 19:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 19:28"/>“ሀ መቱዋስ ጋሶይ እያ፥</para>
  <para style="q2" vid="JOB 19:28">ኑ እያ ዋት የደኖ ግድ ህንተ ቆፕያባ ግድኮ፥<verse eid="JOB 19:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 19:29"/>ማሻስ ያይተ!</para>
  <para style="q2" vid="JOB 19:29">ፆሳ ሀንቆይ ማሻራ ያና፤</para>
  <para style="q2" vid="JOB 19:29">ፕርድ ደኤይሳ ኤርተ” ያግስ።<verse eid="JOB 19:29"/></para>
  <chapter eid="JOB 19"/>
  <chapter number="20" style="c" sid="JOB 20"/>
  <para style="s1">ሶፋራ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 20:1"/>ናእማ ቢታ አስ ግድዳ ሶፋር ሀይሳዳ ያግድ ዛርስ፤<verse eid="JOB 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 20:2"/>“ነ ኦዳይ ታና ላንጭስዳ ግሾ፥</para>
  <para style="q2" vid="JOB 20:2">ታ ኤለሳዳ ነ ኦዳስ ዛሮ እማና።<verse eid="JOB 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 20:3"/>ነ ኦዳይ ታ ቦንቹዋ ቃርያ ግሾ፥</para>
  <para style="q2" vid="JOB 20:3">ታ አኬካይ ነዉ ዛሮ እማና መላ ታና ደንስ።<verse eid="JOB 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 20:4"/>አስ ቢታ ቦላ ደእዳ ዎደፐ ዶምድ፥</para>
  <para style="q2" vid="JOB 20:4">በንፐ ሀንዳባ ኤራሳ።<verse eid="JOB 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 20:5"/>ኢታ አሳ ጬቆይ ቃን ዎደሳ፤</para>
  <para style="q2" vid="JOB 20:5">ፆሳ ኤሮና አሳ ኡፋይሳይ ጉ ዎደሳ።<verse eid="JOB 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 20:6"/>ኢታ አሳ ኦቶሮይ ሳሎ ጋካናዉ ቁ ጊኮካ፥</para>
  <para style="q2" vid="JOB 20:6">እያ ሁጰይ ሻራ ጋክድ ቦችኮካ፥<verse eid="JOB 20:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="JOB 20:7"/>እ ባና መላ ፕተትድ ያና፤</para>
  <para style="q2" vid="JOB 20:7">እያ ካሰ ኤርያ አሳይ ‘እ አዉን ደኢ?’ ያጋና።<verse eid="JOB 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 20:8"/>ኤልሞዳ ፓልድ ያና፤ ስሚድ በንተና፤</para>
  <para style="q2" vid="JOB 20:8">ቃማ አሙሆዳ ጮ ያና።<verse eid="JOB 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 20:9"/>እያ ካሰ በእዳ አይፈት ዛሪድ እያ በኦኮና፤</para>
  <para style="q2" vid="JOB 20:9">እ ባ ደእያ በሳፈ ትምእ ግድ ያና።<verse eid="JOB 20:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 20:10"/>አዋይ ቦንቅ ኤክዳ ሚሸ፥</para>
  <para style="q2" vid="JOB 20:10">እያ ናይት ባንታ ኩሸን ጉየ ዛራና።<verse eid="JOB 20:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 20:11"/>እያ መቀ ኩምዳ ናአተ ዎልቃይ</para>
  <para style="q2" vid="JOB 20:11">እያራ እስፈ ቢታን ዝንአና።<verse eid="JOB 20:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 20:12"/>“ኢታተ እያ ዶናን ማልእኮ፥</para>
  <para style="q2" vid="JOB 20:12">እ ባ እንፃርሳፈ ጋርሳን ቆስኮ፥<verse eid="JOB 20:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="JOB 20:13"/>ዉሮናዳ ባ ዶናን ኦይክድ፥</para>
  <para style="q2" vid="JOB 20:13">ዎ አግኮ፥<verse eid="JOB 20:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="JOB 20:14"/>እያ ኡሉዋን ጫሞ ግዳና፤</para>
  <para style="q2" vid="JOB 20:14">ዎያ ሾሻ ማርዘ ግዳና።<verse eid="JOB 20:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 20:15"/>ኢታ አስ ምትዳ ሻሉዋ ዛር ጩታና፤</para>
  <para style="q2" vid="JOB 20:15">እያ ኡሉዋን ደእያ ኡባ ፆሳይ ጮሻና።<verse eid="JOB 20:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 20:16"/>ኢታ አስ ምያባይ እያዉ ማርዘ ግድድ፥</para>
  <para style="q2" vid="JOB 20:16">እያ ዎና።<verse eid="JOB 20:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 20:17"/>ኤስነ ማ ሃዳ ጎግሽን፥</para>
  <para style="q2" vid="JOB 20:17">እ በኦና አታና።<verse eid="JOB 20:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 20:18"/>ባ ዳቡራ አይፍያ ሞና ሀራስ እማና፤</para>
  <para style="q2" vid="JOB 20:18">ዛልእድ ዎስዳ ዎያን ኡፋይተና።<verse eid="JOB 20:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 20:19"/>ሄስ ሀንዳይ እ ማንቆታ ኡንኤዳ ግሾነ</para>
  <para style="q2" vid="JOB 20:19">ሀራ አስ ኬፅዳ ኬ ቦንቅዳ ግሾሳ።<verse eid="JOB 20:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 20:20"/>“እያ ኢታ አሞይ ሸምፖ ድግስ፤</para>
  <para style="q2" vid="JOB 20:20">ሺሽዳ ሻሎይ እያ አሻናዉ ዳንዳኤና።<verse eid="JOB 20:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 20:21"/>እያ ሻሎይ ዉርያ ግሾ፥</para>
  <para style="q2" vid="JOB 20:21">እያ ዱረተይ ጋምኤና።<verse eid="JOB 20:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 20:22"/>እያዉ አቆይ ኩምድ ደእሽን፥</para>
  <para style="q2" vid="JOB 20:22">መቶይ አኬኮና እያ ቦላ ጋክ ዎና።<verse eid="JOB 20:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 20:23"/>እያ ኡሎይ ካልያ ዎደ፥</para>
  <para style="q2" vid="JOB 20:23">ፆሳይ ዎልቃማ ሀንቁዋ እያ ቦላ ጉሳና።<verse eid="JOB 20:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 20:24"/>ብራታ ማሻፈ እ ባቃታና፤</para>
  <para style="q2" vid="JOB 20:24">ሽን ናሰ ብራታ ዶንገይ እያ ጫዳና።<verse eid="JOB 20:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 20:25"/>ሄ ዶንገይ እያ ዞኮራ ካን ከያና፤</para>
  <para style="q2" vid="JOB 20:25">ጶልያ ፄራይ እያ ትርያ ካን አና፤</para>
  <para style="q2" vid="JOB 20:25">ዳጋም እያ ዎዛና ዋባቅሳና።<verse eid="JOB 20:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 20:26"/>እ ሺሽዳ አቆይ ሳካና ማን ያና፤</para>
  <para style="q2" vid="JOB 20:26">አስ ኦይቦና ታም እያ ማና፤</para>
  <para style="q2" vid="JOB 20:26">እያ ኬን አትዳ ሻሎ ኡባ ፁጋና።<verse eid="JOB 20:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 20:27"/>ሳሎት እያ ናጋራ ቆንጭሳና፤</para>
  <para style="q2" vid="JOB 20:27">ሳእካ እያዉ ሞርከ ግዳና።<verse eid="JOB 20:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 20:28"/>ፆሳ ሀንቆ ጋላሳን፥</para>
  <para style="q2" vid="JOB 20:28">እያ ኬነ እያዉ ደእያባ ድኦይ ኤፋና።<verse eid="JOB 20:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 20:29"/>ፆሳይ ጌላታስ ዎዳ ቃዳይ፥</para>
  <para style="q2" vid="JOB 20:29">ኢታ አሳስ ጊግስዳ ጋተይ ሀይሳ” ያግስ።<verse eid="JOB 20:29"/></para>
  <chapter eid="JOB 20"/>
  <chapter number="21" style="c" sid="JOB 21"/>
  <para style="s1">እዮባ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 21:1"/>ያትን እዮብ ሀይሳዳ ያግድ ዛርስ፤<verse eid="JOB 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 21:2"/>አነ ታ ኦዳ አኬክድ ስእተ፤</para>
  <para style="q2" vid="JOB 21:2">ሄስ ህንተ ታና ምንዳ መላ ግዶ።<verse eid="JOB 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 21:3"/>ታኒ እስ ቶሆ ኦደታና መላ ታዉ ዎደ እምተ፤</para>
  <para style="q2" vid="JOB 21:3">ታኒ ሃሳያ ስምኮ ታና ቀልቅስተ።<verse eid="JOB 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 21:4"/>ታኒ ሞተተይ አሳራ ግደና።</para>
  <para style="q2" vid="JOB 21:4">ያትን፥ ዳንዳአይ ዉርኮ ሄስ ማላልስዬ?<verse eid="JOB 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 21:5"/>አነ ታና ፄልድ ማላለትተ፤</para>
  <para style="q2" vid="JOB 21:5">ህንተ ኩሽያ ህንተ ዶና ቦላ ዎተ።<verse eid="JOB 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 21:6"/>ታ ሄሳ ቆፕያ ዎደ ታና ዳጋንስ፤</para>
  <para style="q2" vid="JOB 21:6">ታ አሳተይ ኮኮሬስ።<verse eid="JOB 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 21:7"/>ኢታ አሳት አይስ ፓፃ ደኦና?</para>
  <para style="q2" vid="JOB 21:7">ኤንታ ላይይ አይስ አዱቂ?</para>
  <para style="q2" vid="JOB 21:7">ኤንታ ዎልቃይ አይስ ዳር ዳር ብዴ?<verse eid="JOB 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 21:8"/>ኤንታ ናይትነ ናይታ ናይት፥</para>
  <para style="q2" vid="JOB 21:8">ድጭሽንነ እንጀን ደእሽን ኤንቲ አይስ በኦና?<verse eid="JOB 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 21:9"/>ኤንታ ሶይ ህርግ ባይና ሳሮ ደኤስ፤</para>
  <para style="q2" vid="JOB 21:9">ፆሳ ፃምአይ ኤንታ ጋከና።<verse eid="JOB 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 21:10"/>ኤንታ ሚዛት ብራይስ ኤክድ ኮፆኮና፤</para>
  <para style="q2" vid="JOB 21:10">የልሸ አዉጫዮኮና።<verse eid="JOB 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 21:11"/>ባንታ ናይታ ዶርሳ ዉደዳ ከሶሶና፤</para>
  <para style="q2" vid="JOB 21:11">ኤንታ ናይት ዱሮሶና።<verse eid="JOB 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 21:12"/>ካራቦ ባቅሸ ዲ ዲፅሸ፥</para>
  <para style="q2" vid="JOB 21:12">ሱሱልኤ ፑንሸ ኡፋይሳን የፆሶና።<verse eid="JOB 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 21:13"/>ኤንቲ ባንታ ደኦ ላይ እንጀን ደእድ፥</para>
  <para style="q2" vid="JOB 21:13">ዱፎ ሳሮራ ቦሶና።<verse eid="JOB 21:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 21:14"/>ግዶሽን፥ ኤንቲ ፆሳኮ “ኑፐ ሃካ!</para>
  <para style="q2" vid="JOB 21:14">ኑኒ ነ ኦግያ ኤራናዉ ኮዮኮ” ያጎሶና።<verse eid="JOB 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 21:15"/>“ኑ እያ ጎይናናዉ ኡባ ዳንዳእያ ፆሳይ ኦኔ?</para>
  <para style="q2" vid="JOB 21:15">ኑ እያ ዎስድ አይ ጎኤታኔ?” ያጎሶና።<verse eid="JOB 21:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 21:16"/>ኤንቲ ዱረተ ባንታ ምኖተን ደምዳ ጎሶና፤</para>
  <para style="q2" vid="JOB 21:16">ሽን ታኒ ኤንታ ቆፋ ኤክከ።<verse eid="JOB 21:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 21:17"/>“ሀኖሽን፥ ኢታ አሳ ፆምፐይ ቶኢ?</para>
  <para style="q2" vid="JOB 21:17">ኤንታና ቦሽ ጋክ ኤሪ?</para>
  <para style="q2" vid="JOB 21:17">ፆሳይ ባ ሀንቁዋን ኤንታ ሴር ኤሪ?<verse eid="JOB 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 21:18"/>ጫርኮይ ኤንታ ካለዳ ኤፍዳ ዎደይ፥</para>
  <para style="q2" vid="JOB 21:18">ጎተይ ኤንታ ባናዳ ደንዳ ዎደይ ደኢ?<verse eid="JOB 21:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 21:19"/>ህንተ፥ ‘ፆሲ አዋታ ባላ ግሾ ኤንታ ናይታ ሴሬስ’ ያጌታ።</para>
  <para style="q2" vid="JOB 21:19">አነ ፆሳይ ናጋራንቾታ ኤንታ ሁጰን ሴሮ፤</para>
  <para style="q2" vid="JOB 21:19">ያትኮ ኤንቲ ባንታ ናቁዋ ኤራና።<verse eid="JOB 21:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 21:20"/>ናጋራንቾት ባንታ ሴራ ባንታዉ ኤኮ፤</para>
  <para style="q2" vid="JOB 21:20">ኡባ ዳንዳእያ ፆሳ ሀንቆይ ኤንታ ቦላ ዎ።<verse eid="JOB 21:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 21:21"/>አስ ሀይቅዳፐ ጉየ፥</para>
  <para style="q2" vid="JOB 21:21">ባ ናይታባ አይ ኤሪ?<verse eid="JOB 21:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 21:22"/>“ቃ በሳን ደኤይሳታ ፕርድያ ፆሳ፥</para>
  <para style="q2" vid="JOB 21:22">ኤራተ ታማርሳናዉ ዳንዳእያ አስ ደኢ?<verse eid="JOB 21:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 21:23"/>እስ እስ አስ ኩመ ዎልቃይነ ሳሮይ ደእሽን፥</para>
  <para style="q2" vid="JOB 21:23">እንጀ ዱሱ ደእሸ ሀይቆሶና።<verse eid="JOB 21:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 21:24"/>ኤንታ አሳተይ ኦርደ ሽን፥</para>
  <para style="q2" vid="JOB 21:24">ኤንታ መቀ ኮልዘይ ሽጫ ደእሽን ሀይቆሶና።<verse eid="JOB 21:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 21:25"/>ሽን ሀራት ሎኦባ በኦና፥</para>
  <para style="q2" vid="JOB 21:25">መቶን ኡንኤትድ ካዮትዳ መላ ሀይቆሶና።<verse eid="JOB 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 21:26"/>ናምአይካ ሀይቅድ ቢታን ሞገቶሶና፤</para>
  <para style="q2" vid="JOB 21:26">ኤንቲ ጉፁንቶሶና።<verse eid="JOB 21:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 21:27"/>“ህንተ ታና ቆሀናዉ ቆፕድ፥</para>
  <para style="q2" vid="JOB 21:27">ህንተ ዎዛናን ቆፕዳ ቆፋ ታ ሎይዳ ኤራይስ።<verse eid="JOB 21:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 21:28"/>ህንተ፥ ‘ሄ ግታ ኡራ ኬይ አዉኔ?</para>
  <para style="q2" vid="JOB 21:28">ኢታ ኦያ ኡራይ ደእያ ሶይ አዉኔ?’ ያጌታ።<verse eid="JOB 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 21:29"/>ኦገ አሳታ ኦይችቤከቲ?</para>
  <para style="q2" vid="JOB 21:29">ኤንታ ማርካተ አማንበከቲ?<verse eid="JOB 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 21:30"/>ኤንቲ፥ ‘ኢታ አሳይ ዮ ጋላስ ቆሄቶኮና፤</para>
  <para style="q2" vid="JOB 21:30">ፆሳ ሀንቆይ ቆንጭያ ጋላስ ኤንቲ አታና’ ያጎሶና።<verse eid="JOB 21:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 21:31"/>ኢታ አስ እያ ኢታተ ግሾ ካጫናይ ኦኔ?</para>
  <para style="q2" vid="JOB 21:31">እያ ኦሱዋ ግሾ እያ ሴራናይ ኦኔ?<verse eid="JOB 21:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 21:32"/>እ ሀይቅን፥ እያ አሀ ዱፎ ኤፎሶና፤</para>
  <para style="q2" vid="JOB 21:32">እያ ዱፎይ ቦንቾን ናገቴስ።<verse eid="JOB 21:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 21:33"/>ዛንጋራ ቢታይ እያዉ እንጀቴስ፤</para>
  <para style="q2" vid="JOB 21:33">ዳሮ አሳይ እያ ስንን ቦሶና፤</para>
  <para style="q2" vid="JOB 21:33">ታይቦይ ባይና አሳይ እያ ካሎሶና።<verse eid="JOB 21:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 21:34"/>ያትን፥ ህንተ ታና ፓና ቃላን ዋት ምንኔ?</para>
  <para style="q2" vid="JOB 21:34">ህንተ ታ ኦይሻስ ዛርያ ዛሮ ኡባይ ዎርዶ” ያግስ።<verse eid="JOB 21:34"/></para>
  <chapter eid="JOB 21"/>
  <chapter number="22" style="c" sid="JOB 22"/>
  <para style="s1">ኤልፋዛ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 22:1"/>ሄሳፈ ጉየ፥ ተማና ቢታፈ ይዳ ኤልፋዝ ሀይሳዳ ያግድ ዛርስ፤<verse eid="JOB 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 22:2"/>“አስ ፆሰ ጎአናዉ ዳንዳኢ?</para>
  <para style="q2" vid="JOB 22:2">ሀር አቶሽን ጭንጫ ግድኮካ፥</para>
  <para style="q2" vid="JOB 22:2">ባና ጎአናፐ አትሽን፥ ፆሰ ጎኤና።<verse eid="JOB 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 22:3"/>ኔኒ ፅሎ ግድኮ ሄስ ኡባ ዳንዳእያ ፆሳ ኡፋይስዬ?</para>
  <para style="q2" vid="JOB 22:3">ነ ኦገይ ቦረይ ባይናባ ግድኮ ሄሳን እ አይ ዎ ደሚ?<verse eid="JOB 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 22:4"/>“እ ነና ሴረይነ ፕርደይ፥</para>
  <para style="q2" vid="JOB 22:4">ኔኒ እያዉ ያይያ ግሾዬ?<verse eid="JOB 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 22:5"/>ነ ኢታተይ ዳሮ ግደነዬ?</para>
  <para style="q2" vid="JOB 22:5">ነ ናጋራስ ዛው ባዋ ግደኔ?<verse eid="JOB 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 22:6"/>ጋሶይ ባይና ነ እሻታ ዋሰ ፄግሳዳሳ፤</para>
  <para style="q2" vid="JOB 22:6">አሳ ማኡዋ ቃራ ኤካዳ ኤንታ ካሎ የዳዳሳ።<verse eid="JOB 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 22:7"/>ሳሞትዳይሳታ ሃ ኡሻባካ፤</para>
  <para style="q2" vid="JOB 22:7">ኮሻትዳይሳታ ካ ሙዛባካ።<verse eid="JOB 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 22:8"/>ኔኒ ዎልቃማ፥ ዱረነ</para>
  <para style="q2" vid="JOB 22:8">ቦንቸትዳ አስ ግዳዳ ደአሸ፥<verse eid="JOB 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 22:9"/>አምኤታ መላ ኩሸ የዳዳሳ፤</para>
  <para style="q2" vid="JOB 22:9">ይኦታስ ዎልቃ ይሳዳሳ።<verse eid="JOB 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 22:10"/>ነ ዩሾይ ግተትዳይ፥</para>
  <para style="q2" vid="JOB 22:10">አኬኮና ያሽ ነና ኮኮርሰይ ሄሳሳ።<verse eid="JOB 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 22:11"/>ነ በኦና መላ ምዳይ፥</para>
  <para style="q2" vid="JOB 22:11">ቃስ ክፃ ሃን ነ ሙከትዳይ ሄሳሳ።<verse eid="JOB 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 22:12"/>“ፆሳይ ቃ ሳሉዋን ኡትድ፥</para>
  <para style="q2" vid="JOB 22:12">ቃን ደእያ ፆልንቶታ ዱገ ፄሌስ።<verse eid="JOB 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 22:13"/>ሽን ኔኒ፥ ‘ፆሲ አይ ኤሪ?</para>
  <para style="q2" vid="JOB 22:13">ሳካና ማ ግዶራ ካንድ፥</para>
  <para style="q2" vid="JOB 22:13">ፕርዳናዉ ዳንዳኢ?<verse eid="JOB 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 22:14"/>ሳሎ ጉፋን ቦላ እ ስመረትያ ዎደ፥</para>
  <para style="q2" vid="JOB 22:14">እ በኦና መላ ስከትዳ ሻራይ እያ ጎዜስ’ ያጋሳ።<verse eid="JOB 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 22:15"/>ናጋራንቾት ሄመትዳ በን ኦግያራ</para>
  <para style="q2" vid="JOB 22:15">ባናዉ ቆፋ ቃቻዲ?<verse eid="JOB 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 22:16"/>ኤንታዉ ዎደይ ጋኮና ደእሽን ሀይቅዶሶና፤</para>
  <para style="q2" vid="JOB 22:16">ኤንታ ደኦ ባሶይ ድኦን ሜጨትድ ይስ።<verse eid="JOB 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 22:17"/>ኤንቲ ፆሳኮ፥ ‘ኑፐ ሃካ!</para>
  <para style="q2" vid="JOB 22:17">ኡባ ዳንዳእያ ፆሳይ ኑስ አይ ኦናዉ ዳንዳኢ?’ ያግዶሶና።<verse eid="JOB 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 22:18"/>ግድኮካ፥ ኤንታ ኬ ሎኦባን ኩንዳይ ፆሳ፤</para>
  <para style="q2" vid="JOB 22:18">ሄሳ ግሾ፥ ኢታ አሳ ቆፋ ታ ኤክከ።<verse eid="JOB 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 22:19"/>“ኢታ አሳት ሴረትያ ዎደ፥</para>
  <para style="q2" vid="JOB 22:19">ፅሎት ኡፋይቶሶና፤</para>
  <para style="q2" vid="JOB 22:19">ሱረ አሳት ሀይሳዳ ያግድ፥ ኤንታ ቦላ ቀልቅሶሶና።<verse eid="JOB 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 22:20"/>‘ኑ ሞርከት ይዶሶና፤</para>
  <para style="q2" vid="JOB 22:20">ኤንታ ዱረተይ ታማስ አትስ’ ያጎሶና።<verse eid="JOB 22:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 22:21"/>“እዮባ፥ ሀእካ ፆሳራ ጊጋ፤</para>
  <para style="q2" vid="JOB 22:21">እያራ ሳሮ ደአ፤</para>
  <para style="q2" vid="JOB 22:21">ያትኮ ኔኒ አንጀታና።<verse eid="JOB 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 22:22"/>እያ ትምርትያ ስአ፤</para>
  <para style="q2" vid="JOB 22:22">እያ ቃላ ነ ዎዛናን ዎ።<verse eid="JOB 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 22:23"/>ኔኒ ኡባ ዳንዳእያ ፆሳኮ ስምኮ፤</para>
  <para style="q2" vid="JOB 22:23">ነዉ ሳእ ስማና፤</para>
  <para style="q2" vid="JOB 22:23">ኢታ ኦሶ ኡባ ነ ሶፐ ድጋ፤<verse eid="JOB 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 22:24"/>ነ ዎርቃ ሳአን ሆላ፤</para>
  <para style="q2" vid="JOB 22:24">ነ ኦፍራ ዎርቃ ሻፋን የጋ።<verse eid="JOB 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 22:25"/>ያትኮ ኡባ ዳንዳእያ ፆሳይ፥</para>
  <para style="q2" vid="JOB 22:25">ነዉ ዎርቃነ ዶረትዳ ብራ ግዳና።<verse eid="JOB 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 22:26"/>ሄ ዎደ ነ ኡባ ዳንዳእያ ፆሳን ኡፋይታና፤</para>
  <para style="q2" vid="JOB 22:26">ዬላቶና ፆሳኮ ፑደ ፄላና።<verse eid="JOB 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 22:27"/>ኔኒ እያ ዎሳና፥ እ ነና ስአና፤</para>
  <para style="q2" vid="JOB 22:27">ነ ቃንገ እያዉ ጋና።<verse eid="JOB 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 22:28"/>ነ ቆፕዳባይ ፖለታና፤</para>
  <para style="q2" vid="JOB 22:28">ነ ሄመትያ ኦገይ ፖኦ ግዳና።<verse eid="JOB 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 22:29"/>ፆሳይ ኦቶረይሳታ ካዉሼስ፤</para>
  <para style="q2" vid="JOB 22:29">ሽን አሽከታ አሼስ።<verse eid="JOB 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 22:30"/>ነ ኩሸይ ጌሽ ግድኮ፥</para>
  <para style="q2" vid="JOB 22:30">ባላ አሳይ ነ ጋሶን ማሮታ ኤካናነ አታና” ያግስ።<verse eid="JOB 22:30"/></para>
  <chapter eid="JOB 22"/>
  <chapter number="23" style="c" sid="JOB 23"/>
  <para style="s1">እዮባ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 23:1"/>እዮብ ሀይሳዳ ያግድ ዛርስ፤<verse eid="JOB 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 23:2"/>ሀችካ ታ ጫመታዳ ዙዙማይስ፤</para>
  <para style="q2" vid="JOB 23:2">ታ ኦለይ ምኖ ግድኮካ</para>
  <para style="q2" vid="JOB 23:2">እያ ኩሸይ ታ ቦላ ዴፀይሳ አግቤና።<verse eid="JOB 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 23:3"/>እያ ደማና በሳ ታ ኤርዳ ግዳርክና፤</para>
  <para style="q2" vid="JOB 23:3">እ ደእያ በሳ ታ ጋካርክና!<verse eid="JOB 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 23:4"/>ታኒ ታ መቱዋ እያ ስንን ዎናሽን!</para>
  <para style="q2" vid="JOB 23:4">ታ ዶና ሞቶን ኩንናሽን!<verse eid="JOB 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 23:5"/>እ ታዉ ዛራናይ አይበኮ ኤራናሽን፥</para>
  <para style="q2" vid="JOB 23:5">እ አይ ግያኮ በአናሽን!<verse eid="JOB 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 23:6"/>እ ባ ግታ ዎልቃን ታራ ኤቀታነሻ?</para>
  <para style="q2" vid="JOB 23:6">አካይ፥ እ ታና ስአና።<verse eid="JOB 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 23:7"/>ያን ሱረ አስ እያራ ሞተታናዉ ዳንዳኤስ፤</para>
  <para style="q2" vid="JOB 23:7">ታ ዳይናይ ታና መርናዉ ሻትንና።<verse eid="JOB 23:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 23:8"/>ሽን ታኒ ዶሎሀ ቢኮ እ ያን ዴና፤</para>
  <para style="q2" vid="JOB 23:8">ታኒ ዉሎሀ ቢኮ እያ ያን ደምከ።<verse eid="JOB 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 23:9"/>እ ፑደሀን ኦያ ዎደ ታኒ እያ በእከ፤</para>
  <para style="q2" vid="JOB 23:9">ዱገሀ ባጋ ስምያ ዎደ ታኒ እያ ደምከ።<verse eid="JOB 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 23:10"/>ሽን እ ታ ታንጉዋ ኡባ ኤሬስ፤</para>
  <para style="q2" vid="JOB 23:10">እ ታና ፓጭያ ዎደ ታኒ ዎርቃዳ ጌያዳ ከያና።<verse eid="JOB 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 23:11"/>ታ ቶሆይ እያ ታንጉዋ ካልድ ቤስ፤</para>
  <para style="q2" vid="JOB 23:11">እያ ኦግያፐ ሀድርስ ኡሻች ስማብከ።<verse eid="JOB 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 23:12"/>እያ ዶናፐ ከይያ ኪታፐ ታኒ ሻከታብከ፤</para>
  <para style="q2" vid="JOB 23:12">እያ ቃላ ታ ዎዛናን ዎስ።<verse eid="JOB 23:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 23:13"/>ፆሳይ ላመተና፤</para>
  <para style="q2" vid="JOB 23:13">እያራ ኤቀታናይ ባዋ፥</para>
  <para style="q2" vid="JOB 23:13">እ ኮይዳባ ኦስ።<verse eid="JOB 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 23:14"/>እ ታ ቦላ ቆፕዳይሳ ፖልስ፤</para>
  <para style="q2" vid="JOB 23:14">ሄሳ መላ ሀራ ዳሮ ሀልቾት እያዉ ደኦሶና።<verse eid="JOB 23:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 23:15"/>ሄሳ ግሾ፥ እያ ስንን ኤቃናዉ ዳሮ ያሼስ፤</para>
  <para style="q2" vid="JOB 23:15">ሄሳ ኡባ ቆፕያ ዎደ ኮኮራይስ።<verse eid="JOB 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 23:16"/>ፆሳይ ታ ዎዛናይ ዶጫና መላ ኦስ፤</para>
  <para style="q2" vid="JOB 23:16">ኡባ ዳንዳእያ ፆሳይ ታና ዳጋንስ።<verse eid="JOB 23:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 23:17"/>ሳካና ማይ ታ ሶምኡዋ ጎዝኮካ፥</para>
  <para style="q2" vid="JOB 23:17">ታና ሄ ማይ ሃሳያ ድግቤና።<verse eid="JOB 23:17"/></para>
  <chapter eid="JOB 23"/>
  <chapter number="24" style="c" sid="JOB 24"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 24:1"/>ኡባ ዳንዳእያ ፆሳይ ፕርዳ ዎደ አይስ ቃንፀኔ?</para>
  <para style="q2" vid="JOB 24:1">እያ ኤረይሳት ሄ ዎድያ አይስ ጮ ናጎና?<verse eid="JOB 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 24:2"/>ኢታ አሳት ዛዋን ደእያ ሹቻ ደንሶና፤</para>
  <para style="q2" vid="JOB 24:2">ካይስ ኤህዳ ዶርሳታ ያን ሄሞሶና።<verse eid="JOB 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 24:3"/>ይኦ ናይታ ሀረታ ቦንቆሶና፤</para>
  <para style="q2" vid="JOB 24:3">አምኤ ቦራ አጮስ ኦይክድ ኤኮሶና።<verse eid="JOB 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 24:4"/>ማንቆታ ሻተትድ ኦገፐ ጎዶሶና፤</para>
  <para style="q2" vid="JOB 24:4">ባንታ ስንፈ ቆሰታና መላ ኦሶና።<verse eid="JOB 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 24:5"/>ባዞን ደእያ ዎራ ሀረ መላ፥</para>
  <para style="q2" vid="JOB 24:5">ማንቆት ባንታ ናይታስ ምያባ ኮይሸ ዳቡሮሶና።<verse eid="JOB 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 24:6"/>ኤንቲ ሀራ አሳ ጋደን ካ ጫኮሶና፤</para>
  <para style="q2" vid="JOB 24:6">ኢታ አሳ ዎይነ ጋደን ቡ ማፆሶና።<verse eid="JOB 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 24:7"/>ኤንቲ ቃማ ካሎ አቆሶና፤</para>
  <para style="q2" vid="JOB 24:7">ሜጎስ ቦላን የግያባይ ኤንታዉ ባዋ።<verse eid="JOB 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 24:8"/>ዙማ ቦላ ቡክያ እራን ኤንቲ ሱሩፆሶና፤</para>
  <para style="q2" vid="JOB 24:8">ገልያ በሲ ይድ ሹቻ ሆምኦን አቆሶና።<verse eid="JOB 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 24:9"/>አው ባይና ናአ አየ ክኦፐ ዳፍ ኤኮሶና፤</para>
  <para style="q2" vid="JOB 24:9">ማንቁዋ ናአ አጮስ ኦይኮሶና።<verse eid="JOB 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 24:10"/>ማንቆት ማኦ ይድ ካሎ ሄመቶሶና፤</para>
  <para style="q2" vid="JOB 24:10">ኤንቲ ባንታዉ ኮሻትሸ ሀራ አሳ ምርቀ ቶኮሶና።<verse eid="JOB 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 24:11"/>ኤንቲ ባንታዉ ሳሞትሸ፥</para>
  <para style="q2" vid="JOB 24:11">ዛይተ ከሳናዉ ሀራ አሳ ጋደን ሻማሆ አይፈ ማፆሶና፤</para>
  <para style="q2" vid="JOB 24:11">ዎይነ ኡሻ ጉሙአናዉ ዎይነ አይፈ ቆሮሶና።<verse eid="JOB 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 24:12"/>ካታማን ካታማን ሀይቃና ሀንያ አሳይ ኦሎሶና፤</para>
  <para style="q2" vid="JOB 24:12">ደሸትድ ማዱንፅዳ አሳይ ማዶ ኮይድ ዋሶሶና፤</para>
  <para style="q2" vid="JOB 24:12">ሽን ፆሳይ ኤንታ መቱዋ ፄለና።<verse eid="JOB 24:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 24:13"/>ፖኦ እፅያ አሳት፥</para>
  <para style="q2" vid="JOB 24:13">እያ ኦግያ ኤሮና አሳትነ፤</para>
  <para style="q2" vid="JOB 24:13">እያን ኤቆና አሳት ደኦሶና።<verse eid="JOB 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 24:14"/>ሳእ ቃምያ ዎደ ሸምፖ ዎይስ ደንድድ፥</para>
  <para style="q2" vid="JOB 24:14">ማንቆታነ መቶታንቾታ ዎስ፤</para>
  <para style="q2" vid="JOB 24:14">ቃም ቃስ ካይሶስ ቦሶና።<verse eid="JOB 24:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 24:15"/>ላይማትያ አስ ሳእ ለምአናይሳ ናጌስ፤</para>
  <para style="q2" vid="JOB 24:15">ኦንካ በኦና መላ ባ ሶምኡዋ ካሜስ።<verse eid="JOB 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 24:16"/>ካይሶት ቃማ ኬ ቦክድ ካይሶታናዉ ገሎሶና፤</para>
  <para style="q2" vid="JOB 24:16">ሽን ጋላስ ቆሰትድ ፔኦሶና።<verse eid="JOB 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 24:17"/>ዳጋንያ ማራ ኤንቲ ዳቦትያ ግሾ፥</para>
  <para style="q2" vid="JOB 24:17">ሳካና ማይ ኤንታዉ ሴታ ጋላሳ መላ።<verse eid="JOB 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 24:18"/>“ሽን ኢታ አሳት ሃ ጎፖንቶ መላ፤</para>
  <para style="q2" vid="JOB 24:18">ኤንታ ላታ ቢታይ ባደትዳይሳ፤</para>
  <para style="q2" vid="JOB 24:18">ኦንካ ኤንታ ዎይነ ጋደ ቤና።<verse eid="JOB 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 24:19"/>ሻች ማይን፥ ሃ መልድ የይሳዳ፥</para>
  <para style="q2" vid="JOB 24:19">ናጋራንቾት ሀይቅድ ቢታፈ ዮሶና።<verse eid="JOB 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 24:20"/>የልዳ አየት ኤንታ ዶጋና፤</para>
  <para style="q2" vid="JOB 24:20">ጉፁነይ ኤንታ አሹዋ ማና፤</para>
  <para style="q2" vid="JOB 24:20">ኢታ አሳይ ሀሳየቶኮና፤</para>
  <para style="q2" vid="JOB 24:20">ምዳ መቃና።<verse eid="JOB 24:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 24:21"/>ኤንቲ ናእ ባይና ማይን ማጫሳ ናቅዶሶና፤</para>
  <para style="q2" vid="JOB 24:21">አምኤታ ቃቶና እፅዶሶና።<verse eid="JOB 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 24:22"/>ፆሳይ ባ ዎልቃን ምኖታ ይስስ፤</para>
  <para style="q2" vid="JOB 24:22">ኤንታዉ ሳእ እንጀትዳ ዳንኮካ፥</para>
  <para style="q2" vid="JOB 24:22">ኩንዶና አቶኮና።<verse eid="JOB 24:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 24:23"/>ፆሳይ ኤንቲ ሳሮ ዳናዳ ኦኮካ፥</para>
  <para style="q2" vid="JOB 24:23">ኤንታ ኦግያ ዎቼስ።<verse eid="JOB 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 24:24"/>ኢታ አሳት ጉ ዎደስ ቁ ቁ ጎሶና፤</para>
  <para style="q2" vid="JOB 24:24">ሽን ኤለስድ ሻራፋዳ ሹልድ ዮሶና፤</para>
  <para style="q2" vid="JOB 24:24">ካዳ ጫከቶሶና።<verse eid="JOB 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 24:25"/>ሄስ ሀነና ግድ ካድያ አስ ደኢ?</para>
  <para style="q2" vid="JOB 24:25">ታኒ ኦድዳ ቃላ ዎርዶ ጋና አስ ደኢ?” ያግስ።<verse eid="JOB 24:25"/></para>
  <chapter eid="JOB 24"/>
  <chapter number="25" style="c" sid="JOB 25"/>
  <para style="s1">በልዳዶሳ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 25:1"/>ሄሳፈ ጉየ፥ ሹሀ ቢታፈ ይዳ በልዳዶስ ሀይሳዳ ያግድ ዛርስ፤<verse eid="JOB 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 25:2"/>“ፆሳይ ሃረይሳነ ያሸይሳ፤</para>
  <para style="q2" vid="JOB 25:2">እ ቃ ሳሉዋ ሳሮተን ሃሬስ።<verse eid="JOB 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 25:3"/>እያ ኦላንቾታ ታይባናዉ ዳንዳእያ አስ ደኢ?</para>
  <para style="q2" vid="JOB 25:3">ፆሳ ፖኦይ ጋኮና በሲ ደኢ?<verse eid="JOB 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 25:4"/>ያትን፥ አስ ፆሳ ስንን ፅሎ ግዳናዉ ዳንዳኢ?</para>
  <para style="q2" vid="JOB 25:4">ማጫሳፐ የለትዳ አስ ጌሽ ግዳናዉ ዳንዳኢ?<verse eid="JOB 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 25:5"/>ፆሳ ስንን አጌንካ ኩመ ፖኦ ግደና፤</para>
  <para style="q2" vid="JOB 25:5">እያ ስንን ፆልንቶትካ ጌሽ ግዶኮና።<verse eid="JOB 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 25:6"/>ያትን፥ ፆሳ ስንን ዎቃነ ጉፁነ ግድዳ</para>
  <para style="q2" vid="JOB 25:6">አስ አይ መላ ላፌ?” ያግስ።<verse eid="JOB 25:6"/></para>
  <chapter eid="JOB 25"/>
  <chapter number="26" style="c" sid="JOB 26"/>
  <para style="s1">እዮባ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 26:1"/>እዮብ ሀይሳዳ ያግድ ዛርስ፤<verse eid="JOB 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 26:2"/>“ኔኒ ዎልቅ ባይናይሳ አይባ ማዳዲ?</para>
  <para style="q2" vid="JOB 26:2">ዳቡራንቹዋ ዋታ አሻዲ?<verse eid="JOB 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 26:3"/>ጭንጫተ ፓጭዳይሳስ አይ ዞረ እማዲ?</para>
  <para style="q2" vid="JOB 26:3">አይ መላ ኤራተ ቆንጭሳዲ?<verse eid="JOB 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 26:4"/>ኔኒ ሀ ቃላ ኦደታና መላ ነና ማድዳይ ኦኔ?</para>
  <para style="q2" vid="JOB 26:4">ነ ኦዳን መላ ነና ደንዳይ ኦደ አያኔ?” ያግስ።<verse eid="JOB 26:4"/></para>
  <para style="s1">በልዳዶሳ ሃሳያ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 26:5"/>በልዳዶስ ዛሪድ፥ “ሀይቅዳ አሳ አያናት፥</para>
  <para style="q2" vid="JOB 26:5">ጋርሳን ሃ ግዶን ደኤይሳት ኮኮሮሶና።<verse eid="JOB 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 26:6"/>ፆሳ ስንን ስኦለይ ቆንጨ፤</para>
  <para style="q2" vid="JOB 26:6">አይብካ እያ ገንናዉ ዳንዳኤና።<verse eid="JOB 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 26:7"/>ፆሳይ ፑደሀ ሳሎታ ጮ ምጭስ፤</para>
  <para style="q2" vid="JOB 26:7">ሳኣ ካቆይ ባይና በሳን ካቅስ።<verse eid="JOB 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 26:8"/>እ ሻራታን ሃ ኩንስ፤</para>
  <para style="q2" vid="JOB 26:8">ሃ ዴፁዋን ሻራት ዳከቶኮና።<verse eid="JOB 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 26:9"/>እ ባ ሻራ ምጭድ፥</para>
  <para style="q2" vid="JOB 26:9">ኩም አጌና ካሜስ።<verse eid="JOB 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 26:10"/>ፖኦ ማፐ ሻካናዉ፥</para>
  <para style="q2" vid="JOB 26:10">አባ ጋፃን ፆሳይ ዛዋ ዎስ።<verse eid="JOB 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 26:11"/>እ ሀንቀትያ ዎደ፥</para>
  <para style="q2" vid="JOB 26:11">ሳሎ ቱቀት ዳጋማን ኮኮሮሶና።<verse eid="JOB 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 26:12"/>ባ ዎልቃን አባ ስእ ኦስ፤</para>
  <para style="q2" vid="JOB 26:12">ባ ጭንጫተን ራኣባ ጌተትያ ዶኣ ይሴስ።<verse eid="JOB 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 26:13"/>እ ባ ሸምፑዋን ሳሎታ ጌሼስ፤</para>
  <para style="q2" vid="JOB 26:13">እያ ኩሸይ ፆንገትያ ሾሻ ጫዴስ።<verse eid="JOB 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 26:14"/>ሀይሳቲ ፆሳይ ኦያ ኦሶታፐ ጉታ፤</para>
  <para style="q2" vid="JOB 26:14">ኑ እያ ካልካሻ ፃላላ ስኦስ፤</para>
  <para style="q2" vid="JOB 26:14">እያ ዎልቃ ደሹዋ አኬካናዉ ዳንዳኤይ ኦኔ?” ያግስ።<verse eid="JOB 26:14"/></para>
  <chapter eid="JOB 26"/>
  <chapter number="27" style="c" sid="JOB 27"/>
  <para style="s1">እዮባ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 27:1"/>እዮብ ካልድ ሀይሳዳ ያግስ፤<verse eid="JOB 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 27:2"/>“ሱረ ፕርዳ ታና ድግድ፥</para>
  <para style="q2" vid="JOB 27:2">ታ ደኡዋ ጫሞ ኦዳ፥</para>
  <para style="q2" vid="JOB 27:2">ኡባ ዳንዳእያ ፆሳን ታኒ ጫቃይስ።<verse eid="JOB 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 27:3"/>ታ ሸምፖይ ደእሽን፥</para>
  <para style="q2" vid="JOB 27:3">ታ ሲይ ሸምፕሽን<verse eid="JOB 27:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="JOB 27:4"/>ታ ዶናይ ዎርዶ ኦደተና፤</para>
  <para style="q2" vid="JOB 27:4">ታ እንፃርሳይ ጭሞ ኦደተና።<verse eid="JOB 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 27:5"/>ህንተ ኦዳይ ልከ ጋዳ ታ ኤክከ፤</para>
  <para style="q2" vid="JOB 27:5">ሀይቃና ጋካናዉ ታ ታና ሱረ ገይሳ አግከ።<verse eid="JOB 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 27:6"/>ታ ፅሎተ ምን ኦይካናፐ አትሽን፥ አግከ፤</para>
  <para style="q2" vid="JOB 27:6">ታ ደእዳ ላይ ኡባን ታ ካሀይ ታና ሞተና።<verse eid="JOB 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 27:7"/>“ታ ሞርከት ናጋራንቾዳ፥</para>
  <para style="q2" vid="JOB 27:7">ታራ ኤቀተይሳት ባላ ግዶ።<verse eid="JOB 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 27:8"/>ፆሳይ ኤንታ ሸምፑዋ ኤንታፈ ኤክያ ዎደ፥</para>
  <para style="q2" vid="JOB 27:8">ኤንታ ላይ ቃምስያ ዎደ፥</para>
  <para style="q2" vid="JOB 27:8">ኢታታስ ደእያ ኡፋይሳይ አይቤ?<verse eid="JOB 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 27:9"/>ኤንታ ቦላ መቶይ ጋክያ ዎደ፥</para>
  <para style="q2" vid="JOB 27:9">ፆሳይ ኤንታ ዋሱዋ ስኢ?<verse eid="JOB 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 27:10"/>ኡባ ዳንዳእያ ፆሳን ኤንቲ ኡፋይታኔ?</para>
  <para style="q2" vid="JOB 27:10">ኤንቲ ኡባ ዎደ ፆሳ ፄጋኔ?<verse eid="JOB 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 27:11"/>“ታኒ ህንተና ፆሳ ዎልቃባ ታማርሳና፤</para>
  <para style="q2" vid="JOB 27:11">ኡባ ዳንዳእያ ፆሳ ቆፋ ታ ህንተፈ ቆትከ።<verse eid="JOB 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 27:12"/>ህንተ ኡባይ ሄሳ በእደታ፤</para>
  <para style="q2" vid="JOB 27:12">ያትን፥ ሀይሳ መላ ጮ ሃሳያ አይስ ኦደቴቲ?<verse eid="JOB 27:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 27:13"/>ፆሳይ ኢታ አሳታስ ጊግስዳ ቃዳይ፥</para>
  <para style="q2" vid="JOB 27:13">ኡባ ዳንዳእያ ፆሳፈ ኤክያ ዎይቶይ ሀይሳ።<verse eid="JOB 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 27:14"/>ኤንታ ናይት አይ ዳርኮካ ኦላን ዉራና፤</para>
  <para style="q2" vid="JOB 27:14">ኤንታ ኮቻይ ምያባ ይድ ኮሻታና።<verse eid="JOB 27:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 27:15"/>ሄሳፈ አትዳይሳት ጋዶን ዉራና፤</para>
  <para style="q2" vid="JOB 27:15">ኤንታ አምኤት ኤንታዉ ዬኮኮና።<verse eid="JOB 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 27:16"/>ኢታ አሳት ብራ ቢታዳ ሺሽኮካ፥</para>
  <para style="q2" vid="JOB 27:16">ማኦ ኡርቃዳ ሺሽድ ዶርኮካ፥<verse eid="JOB 27:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="JOB 27:17"/>ኤንታ ብራ ፅሎ አሳት ሻክ ኤካና፤</para>
  <para style="q2" vid="JOB 27:17">ኤንታ ማኡዋ ጌሻት ማአና።<verse eid="JOB 27:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 27:18"/>ኤንቲ ኬፅያ ኬት ሻንጎ ሃዳ መላነ</para>
  <para style="q2" vid="JOB 27:18">ጋባ መላ ላለታና።<verse eid="JOB 27:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 27:19"/>ኢታ አሳት ዱረ ግድድ ሂፃን ዝንኦሶና፤</para>
  <para style="q2" vid="JOB 27:19">ሽን ኤንቲ ስኮፈ ባርክያ ዎደ አይኮይካ ባዋ።<verse eid="JOB 27:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 27:20"/>ዳጋም ድኦ ሃዳ ቆፖና ኤንታ ቦላ ያና፤</para>
  <para style="q2" vid="JOB 27:20">ቃማ ጎተይ ኤንታ ደንድ ኤፋና።<verse eid="JOB 27:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 27:21"/>ዶሎሀ ጫርኮይ ኤንቲ ደእያሱዋፐ ፕትድ ኤፋና።<verse eid="JOB 27:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 27:22"/>ኤንቲ ከስ ኤካናዉ ባቃትሽን፥</para>
  <para style="q2" vid="JOB 27:22">ቃይ ባይና ኤንታ ቦላ ዎና።<verse eid="JOB 27:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 27:23"/>ባ ኩሽያ ባቅድ ኤንታ ቦላ ቀልቅሳና</para>
  <para style="q2" vid="JOB 27:23">ባ ሱይቀን ኤንታ ሱግ የዳና።<verse eid="JOB 27:23"/></para>
  <chapter eid="JOB 27"/>
  <chapter number="28" style="c" sid="JOB 28"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 28:1"/>“ብራ ቦክድ ከስያ በስነ</para>
  <para style="q2" vid="JOB 28:1">ዎርቃ ሴርስያ በሲ ደኤስ።<verse eid="JOB 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 28:2"/>ብራት ቢታፈ ከዬስ፤</para>
  <para style="q2" vid="JOB 28:2">ናሰ ብራት ሹቹ ሴርስን ከዬስ።<verse eid="JOB 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 28:3"/>አሳይ ፆምፐ ኤክድ ማ ፖእሴስ፤</para>
  <para style="q2" vid="JOB 28:3">ቢታ ጋ ጋካናዉ ገሌስ፤</para>
  <para style="q2" vid="JOB 28:3">ሳካና ማን ሄ ሹቻ ኮዬስ።<verse eid="JOB 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 28:4"/>አሳይ ደእያ በሳፈ ሃክድ፥</para>
  <para style="q2" vid="JOB 28:4">አሳ ቶሆይ የ ኤሮና ሶ ጋክድ፥</para>
  <para style="q2" vid="JOB 28:4">ያን ግታ ኦላ ቦኬስ።</para>
  <para style="q1" vid="JOB 28:4">ዎዶሮን ያነ ሃነ ኩሎትሸ፥</para>
  <para style="q2" vid="JOB 28:4">አሳፐ ኮፀትድ ደኤስ።<verse eid="JOB 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 28:5"/>ካ ቢታፈ ሞኬስ፤</para>
  <para style="q2" vid="JOB 28:5">ሽን እያ ግዶይ ታማን ሴርድ፥</para>
  <para style="q2" vid="JOB 28:5">ሽረት ሽረት ዎስ።<verse eid="JOB 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 28:6"/>ሄ ዛላፈ ሳንፓረ ጌተትያ አልኦ ሹቻይ ከዬስ፤</para>
  <para style="q2" vid="JOB 28:6">እያ ቢታፈ ዎርቃይ በንቴስ።<verse eid="JOB 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 28:7"/>ሄ ሹቻ ቦክያ በሳ ፅሎይ ኤረና፤</para>
  <para style="q2" vid="JOB 28:7">ጵርጮይካ በእቤና።<verse eid="JOB 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 28:8"/>ኢታ ዶአት ሄ በሳ የ ኤሮኮና፤</para>
  <para style="q2" vid="JOB 28:8">ጋሞይ ያራ አቤና።<verse eid="JOB 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 28:9"/>አስ ምኖ ዛላ መንረስ፤</para>
  <para style="q2" vid="JOB 28:9">ደርያ ቦክድ ፃጱዋፐ አድ የጌስ።<verse eid="JOB 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 28:10"/>ዛላ ሉክድ ካንያ ኦገ ከሴስ፤</para>
  <para style="q2" vid="JOB 28:10">ሄ አልኦ ሹቻ ደሜስ።<verse eid="JOB 28:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 28:11"/>ሃ ሄ በሳራ ጎጎና መላ ዜረስ፤</para>
  <para style="q2" vid="JOB 28:11">ጌምዳባታ ፖኦ ከሴስ።<verse eid="JOB 28:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 28:12"/>“ሽን ጭንጫተ አዉፐ በንታናዉ ዳንዳኢ?</para>
  <para style="q2" vid="JOB 28:12">አኬክ ደእያ አዌ?<verse eid="JOB 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 28:13"/>አስ እያ ጋትያ ኤረና፤</para>
  <para style="q2" vid="JOB 28:13">እ ደኦን ደእያ መተት ደእያ ቢታን በንተና።<verse eid="JOB 28:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 28:14"/>አባ ጪሞይ፥ ‘ጭንጫተ ታ ግዶን ባዋ’ ያጌስ።<verse eid="JOB 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 28:15"/>ጭንጫተ ዎርቃን ሻመተና</para>
  <para style="q2" vid="JOB 28:15">ዎይኮ ብራን በንተና።<verse eid="JOB 28:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 28:16"/>ጭንጫተ ኦፍራ ዎርቃን፥</para>
  <para style="q2" vid="JOB 28:16">ማርግደነ ሳንፓረ ጌተትያ አልኦ ሹቻን ሻመተና።<verse eid="JOB 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 28:17"/>ዎርቅነ ማስቶተይ እያራ ልከተና፤</para>
  <para style="q2" vid="JOB 28:17">ዎርቃፈ ኦሰትዳ አልኦ ሚሸን ላመተና።<verse eid="JOB 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 28:18"/>ጭንጫተ ጋተይ ዛጎለፐ፥</para>
  <para style="q2" vid="JOB 28:18">አልማዘፐነ አልኦ ሹቻ ኡባፈ አስ።<verse eid="JOB 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 28:19"/>ቶጳዘ ጌተትያ ቶጰ እንቆይ እያራ ልከተና፤</para>
  <para style="q2" vid="JOB 28:19">ዋላህ ባይና ዎርቃን እ ሻመተና።<verse eid="JOB 28:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 28:20"/>“ያትን፥ ጭንጫተ አዉፐ ዪ?</para>
  <para style="q2" vid="JOB 28:20">አኬክ አዉፐ በንቲ?<verse eid="JOB 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 28:21"/>ደኦን ደእያ መተ ኡባፈ ጌምድ ደኤስ፤</para>
  <para style="q2" vid="JOB 28:21">ሳሎ ካፎት እያ ደሞኮና።<verse eid="JOB 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 28:22"/>ጋዶይነ ሀይቆይ፥</para>
  <para style="q2" vid="JOB 28:22">‘ኑኒ ጭንጫተባ ሀይን ስእዳ’ ያጎሶና።<verse eid="JOB 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JOB 28:23"/>“ጭንጫተኮ ኤፍያ ኦግያነ እ ደእያ በሳ</para>
  <para style="q2" vid="JOB 28:23">ኤረይ ፆሳ ፃላላ።<verse eid="JOB 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 28:24"/>ፆሳይ ሳኣ ጋፃ ኡባ ፄሌስ፤</para>
  <para style="q2" vid="JOB 28:24">ሳሎፐ ጋርሳን ደእያባ ኡባ በኤስ።<verse eid="JOB 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 28:25"/>ፆሳይ ጫርኮስ ዎልቃ እምዳ ዎደ፥</para>
  <para style="q2" vid="JOB 28:25">ሃ ማክዳ ዎደ፥<verse eid="JOB 28:25"/></para>
  <para style="q2">
    <verse number="26" style="v" sid="JOB 28:26"/>እር ቡካና ዎጋ እምዳ ዎደ፥</para>
  <para style="q2" vid="JOB 28:26">ዳዳስ ኦገ ዎዳ ዎደ፥<verse eid="JOB 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 28:27"/>ፆሳይ ጭንጫተ በእስ፤</para>
  <para style="q2" vid="JOB 28:27">በእድ ቦንችስ፤ ፓጭድ ኤስስ።<verse eid="JOB 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 28:28"/>ሄ ዎደ ፆሳይ አሳኮ፥</para>
  <para style="q2" vid="JOB 28:28">‘ጭንጫተ ፆሳስ ያየይሳ፤</para>
  <para style="q2" vid="JOB 28:28">አኬክ ኢታፐ ሃከይሳ’ ያጌስ” ያግስ።<verse eid="JOB 28:28"/></para>
  <chapter eid="JOB 28"/>
  <chapter number="29" style="c" sid="JOB 29"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 29:1"/>እዮብ ካልድ ሀይሳዳ ያግስ፤<verse eid="JOB 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 29:2"/>ሀእ ታ ደእያ ዱሳይ፥</para>
  <para style="q2" vid="JOB 29:2">ፆሳይ በን ታና ናግዳ ዎድያ ግዴረነ!<verse eid="JOB 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 29:3"/>ሄ ዎደ እያ ፆምፐይ ታ ቦላ ፖኤስ፤</para>
  <para style="q2" vid="JOB 29:3">እያ ፖኡዋን ማ ካንዳ ባይስ።<verse eid="JOB 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 29:4"/>ሄ ዎደይ ፆሳይ ታ ኬ አንጅን፥</para>
  <para style="q2" vid="JOB 29:4">ታኒ ታ ናአተ ዎልቃራ ደእዳ ዎደ።<verse eid="JOB 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 29:5"/>ሄ ዎደ ኡባ ዳንዳእያ ፆሳይ ታፐ ሻከትቤና፤</para>
  <para style="q2" vid="JOB 29:5">ታ ናይት ታ ዩሾን ደኦሶና።<verse eid="JOB 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 29:6"/>ሄ ዎደ ታኒ ታ ኩሽያ ማን ሜጫይስ፤</para>
  <para style="q2" vid="JOB 29:6">ሹቻ ቢታን ቶከትዳ ሻማሆይ፥</para>
  <para style="q2" vid="JOB 29:6">ሻፋ ሃዳ ጎግያ ዛይተ እሜስ።<verse eid="JOB 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 29:7"/>ታኒ ካታማ ፕርዳ ኬ ብዳ ዎደ፥</para>
  <para style="q2" vid="JOB 29:7">ሻንጎታራ እስፈ ኡታይስ።<verse eid="JOB 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 29:8"/>ሄ ዎደ ናአተት ታና በእድ ኦገ የዶሶና፤</para>
  <para style="q2" vid="JOB 29:8">ጭማት ታና ቦንቻናዉ ደንድ ኤቅዶሶና።<verse eid="JOB 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 29:9"/>ሀላቃት ኦዳ አጋግዶሶና፤</para>
  <para style="q2" vid="JOB 29:9">ባንታ ኩሽያ ባንታ ዶና ቦላ ዎዶሶና።<verse eid="JOB 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 29:10"/>ሄ ካታማን ደእያ ግታ አሳት ስእ ግዶሶና፤</para>
  <para style="q2" vid="JOB 29:10">ኤንታ እንፃርሳይ ኤንታ ኮቶኑዋ ባቅድ ኦይክስ።<verse eid="JOB 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 29:11"/>ታባ ስእዳ ኡባይ ናሼስ፤</para>
  <para style="q2" vid="JOB 29:11">ታና በእዳ ኡባይ ቦንቼስ።<verse eid="JOB 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 29:12"/>ሄስ ሀንዳይ፥</para>
  <para style="q2" vid="JOB 29:12">ታኒ ማንቆታ ዋሱዋ ስአዳ አሽዳ ግሾነ፥</para>
  <para style="q2" vid="JOB 29:12">ይኦ ናይታ ማድዳ ግሾሳ።<verse eid="JOB 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 29:13"/>ሀይቃና ሀንያ አሳት ታና አንጅዶሶና፤</para>
  <para style="q2" vid="JOB 29:13">አምኤት ታ ማዱዋን ኡፋይትዶሶና።<verse eid="JOB 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 29:14"/>ፅሎተ ማኦዳ ማአስ፤</para>
  <para style="q2" vid="JOB 29:14">ሱረ ፕርዳ አፍላዳ ማአስ፤</para>
  <para style="q2" vid="JOB 29:14">ባርኔፃዳ ዎስ።<verse eid="JOB 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 29:15"/>ታኒ ቆቀታስ አይፈ፥</para>
  <para style="q2" vid="JOB 29:15">ዎበታስ ቶሆ ግዳስ።<verse eid="JOB 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 29:16"/>ማንቆታስ አዋ ግዳስ፤</para>
  <para style="q2" vid="JOB 29:16">ኦገ አሳስ ፃባቃ ግዳስ።<verse eid="JOB 29:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 29:17"/>ታኒ ኢታታ ጋጩዋ መንስ፤</para>
  <para style="q2" vid="JOB 29:17">ኤንቲ ቦንቅዳይሳ ኤንታ ዶናፐ የግሳስ።<verse eid="JOB 29:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 29:18"/>ታኒ ታ ዎዛናን፥ “ታ ላይይ ሻፈዳ ዳርን፥</para>
  <para style="q2" vid="JOB 29:18">ታ ሶን ቦንቾን ሀይቃና” ጋዳ ቆፓስ።<verse eid="JOB 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 29:19"/>ታኒ ፃጱዋ ሃን የድዳ፥</para>
  <para style="q2" vid="JOB 29:19">ታሽያ ቦላ አክ ኩምዳ ም መላሽን!<verse eid="JOB 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 29:20"/>ታ ቦንቸትዳ መላ ደአስ፤</para>
  <para style="q2" vid="JOB 29:20">ታ ዎልቃይ ኡባ ዎደ ኦራሽን!<verse eid="JOB 29:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 29:21"/>ታ ሃሳያ ዎደ ስእ ግድ ስኤስ፤</para>
  <para style="q2" vid="JOB 29:21">ታ ዞርያ ኡፋይሳን ኤኮሶና።<verse eid="JOB 29:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 29:22"/>ታ ኤንታና አልያ ግሾ፥</para>
  <para style="q2" vid="JOB 29:22">ታ ኦዳ ስምን ታፐ ጉየራ ኦድያ አስ ባዋ።<verse eid="JOB 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 29:23"/>ጎሻንቾይ እራ ናገይሳዳ፥</para>
  <para style="q2" vid="JOB 29:23">ኤንቲ ታ ሃሳያ ስአናዉ ሀካንክድ ናጎሶና።<verse eid="JOB 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 29:24"/>ኤንቲ ህርጋን ደእሽን ታ ሶምኡዋ ፓሽክሳይስ፤</para>
  <para style="q2" vid="JOB 29:24">ታ ሚቻይ ኤንታ ምንስ።<verse eid="JOB 29:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 29:25"/>ታኒ ኤንቲ ዳና ኦግያ ዶራዳ ኤንታዉ ሀላቃ ግዳስ።</para>
  <para style="q2" vid="JOB 29:25">ባ ኦላንቾታ ግዶን ደእያ ካዎዳ ታ ኤንታ ግዶን ደአስ፤</para>
  <para style="q2" vid="JOB 29:25">ኤንቲ አዛንያ ዎደ ምንስ።<verse eid="JOB 29:25"/></para>
  <chapter eid="JOB 29"/>
  <chapter number="30" style="c" sid="JOB 30"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 30:1"/>ሽን ሀእ ታፐ ናአትያ አሳት ታና ቀልቅሶሶና።</para>
  <para style="q2" vid="JOB 30:1">ኤንቲ ታ ዶርሳ ዉድያ ሄምያ ካናታራ ፔኦና መላ</para>
  <para style="q2" vid="JOB 30:1">ታኒ ድግዳ አዋታ ናይታ።<verse eid="JOB 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 30:2"/>ኤንታ አዋት ዎልቅ እፅዳይሳታነ</para>
  <para style="q2" vid="JOB 30:2">ግልቃታ ግድያ ግሾ ታና አይኮካ ማድቦኮና።<verse eid="JOB 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 30:3"/>መቶይነ ኮሽ ኡንኤን፥</para>
  <para style="q2" vid="JOB 30:3">ቢታ ባዞ ብድ ፃጶ ጮሞሶና።<verse eid="JOB 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 30:4"/>ጩማነ ቦንጮ ማፅዶሶና፤</para>
  <para style="q2" vid="JOB 30:4">ማልኦና ሳንካራ ፃጶ ምዶሶና።<verse eid="JOB 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 30:5"/>አስ ዋስሸ ካይሶ ጎደይሳዳ፥</para>
  <para style="q2" vid="JOB 30:5">ኤንታና አሳ ግዶፈ ጎድዶሶና።<verse eid="JOB 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 30:6"/>ኤንቲ ዛንጋራን፥ ጎንጎሎንነ</para>
  <para style="q2" vid="JOB 30:6">ዛላ ቆጶን ደእዶሶና።<verse eid="JOB 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 30:7"/>ኤንቲ ዎራን ዶአዳ ዋስሸ ዩይዶሶና፤</para>
  <para style="q2" vid="JOB 30:7">አጉን ግዶን ሺቅድ እስፈ ደእዶሶና።<verse eid="JOB 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 30:8"/>ኤንቲ ቢታፈ ጎደትዶሶና፤</para>
  <para style="q2" vid="JOB 30:8">ሱን ባይና ኤያታ ግድድ ደእዶሶና።<verse eid="JOB 30:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 30:9"/>ሀእ ኤንታ ናይት ታና የን ጫዶሶና፤</para>
  <para style="q2" vid="JOB 30:9">ታኒ ኤንታ ግዶን ሀይሰስ አታስ።<verse eid="JOB 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 30:10"/>ኤንቲ ታና ሻተትድ ታፐ ሃኮሶና፤</para>
  <para style="q2" vid="JOB 30:10">ዬላቶና ታ ሶምኦን ጩቶሶና።<verse eid="JOB 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 30:11"/>ፆሳይ ታ ዎልቃ ላፈድ ታና ካዉሽዳ ግሾ፥</para>
  <para style="q2" vid="JOB 30:11">ኤንቲ ታና ቆሀናዉ የዳ ፓራ ግድዶሶና።<verse eid="JOB 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 30:12"/>ሴር ባይና ድጭዳ ናይት ታ ቦላ ደንድዶሶና፤</para>
  <para style="q2" vid="JOB 30:12">ታ ቶሁዋስ ፅሄ ዎዶሶና፤</para>
  <para style="q2" vid="JOB 30:12">ኤንቲ ታና ይሳናዉ ተቅዶሶና።<verse eid="JOB 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 30:13"/>ኤንቲ ታ ኦግያ ጎርድድ ታና ይሳናዉ ኮዮሶና፤</para>
  <para style="q2" vid="JOB 30:13">ኤንቲ ሄሳ ኦና መላ ተቅያ ኦንካ ባዋ።<verse eid="JOB 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 30:14"/>ኦላንቾት ካታማ ድርሳ መንድ ገለይሳዳ፥</para>
  <para style="q2" vid="JOB 30:14">ኤንቲ ታ ቦላ ይዶሶና።<verse eid="JOB 30:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 30:15"/>ታኒ ግታ ዳጋማ ዳጋማስ፤</para>
  <para style="q2" vid="JOB 30:15">ታ ቦንቾይ ጫርኮይ ኤፍያዳ ብስ፤</para>
  <para style="q2" vid="JOB 30:15">ታ ሳሮ ዱሳይ ሻራዳ ይስ።<verse eid="JOB 30:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 30:16"/>ታ ሸምፕያ ዳሮ ኡንኤታሱ፤</para>
  <para style="q2" vid="JOB 30:16">መቶይ ታና ጩጩምድ ኦይክስ።<verse eid="JOB 30:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="JOB 30:17"/>ቃማ ቃማ ሳሆይ ታ መቀ ጮሜስ፤</para>
  <para style="q2" vid="JOB 30:17">ሴላይ ታዉ ሸምፖ እመና።<verse eid="JOB 30:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 30:18"/>ፆሳይ ባ ግታ ዎልቃን ታ ማኡዋ ሺሽድ ኦይክስ፤</para>
  <para style="q2" vid="JOB 30:18">ቆ ኦይክያ ማኦዳ ታና ጩልስ።<verse eid="JOB 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 30:19"/>ፆሳይ ታና ኡርቃን ሆልስ፤</para>
  <para style="q2" vid="JOB 30:19">ታኒ ባናነ ብድን ግዳስ።<verse eid="JOB 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 30:20"/>አቤት ፆሳዉ፥ ታኒ ኔኮ ዋሳይስ፤</para>
  <para style="q2" vid="JOB 30:20">ሽን ኔኒ ታና አላባካ።</para>
  <para style="q1" vid="JOB 30:20">ኤቃዳ ነና ዎሳስ፤</para>
  <para style="q2" vid="JOB 30:20">ሽን ኔኒ ታ ዎሳ ስአባካ።<verse eid="JOB 30:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 30:21"/>ኔኒ ታዉ ዎዛና ምኖ ግዳዳሳ፤</para>
  <para style="q2" vid="JOB 30:21">ነ ግታ ዎልቃን ታና የደሳ።<verse eid="JOB 30:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 30:22"/>ኔኒ ታና ጫርኮራ ደንዳ ጎዳዳሳ፤</para>
  <para style="q2" vid="JOB 30:22">ጎተን ታና ሀርቃዳሳ።<verse eid="JOB 30:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 30:23"/>አሳ ኡባስ ዉርሰ ግድዳ፥</para>
  <para style="q2" vid="JOB 30:23">ሀይቆስ ነ ታና አ እማናይሳ ኤራይስ።<verse eid="JOB 30:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 30:24"/>መቅዳ አስ፥ “ታና ማዳርክ” ግድ ዋስን፥</para>
  <para style="q2" vid="JOB 30:24">እያዉ ቃቶና አስ ደኢ?<verse eid="JOB 30:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="JOB 30:25"/>ዋየን ደኤይሳታስ ታ ዬካብክና?</para>
  <para style="q2" vid="JOB 30:25">ማንቆታስ ታ ቃታብክና?<verse eid="JOB 30:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 30:26"/>ሎኦባ ደማና ጋዳ አሞታስ ሽን ኢታባይ ጋክስ፤</para>
  <para style="q2" vid="JOB 30:26">ታዉ ሳእ ኬሀና ጋዳ ናግስ ሽን ጋላስ ታዉ ምስ።<verse eid="JOB 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 30:27"/>ታ ዎዛናይ ህርጋ አግቤና፤</para>
  <para style="q2" vid="JOB 30:27">ታኒ ዎፓ ደማብከ፤</para>
  <para style="q2" vid="JOB 30:27">ኡንአ ቃም ታ ቦላ ጋክስ።<verse eid="JOB 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 30:28"/>ታ አሳተይ አዋ ሱሎን ግዶናሽን አዛኖን ካሬፅስ፤</para>
  <para style="q2" vid="JOB 30:28">ታኒ ደርያ ሺቁዋን ኤቃዳ ማደ ኮያይስ።<verse eid="JOB 30:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 30:29"/>ታኒ ዎራካናታስ እሻ፥</para>
  <para style="q2" vid="JOB 30:29">ዲድንስ ላገ ግዳስ።<verse eid="JOB 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 30:30"/>ታ ጎጋይ ካሬፅድ ፖቀት ፖቀት ዎስ፤</para>
  <para style="q2" vid="JOB 30:30">ታ አሳተይ ምሻን ፁገቴስ።<verse eid="JOB 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 30:31"/>ታ ኡፋይስ ቆንጭስያ ዲነ ሱሱልኤይ፥</para>
  <para style="q2" vid="JOB 30:31">ሀእ ታ ዘለልሳስ ግድስ።<verse eid="JOB 30:31"/></para>
  <chapter eid="JOB 30"/>
  <chapter number="31" style="c" sid="JOB 31"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 31:1"/>“ጌላኦ ፄላዳ አሞቶና መላ፥</para>
  <para style="q2" vid="JOB 31:1">ታኒ ታ አይፍያራ ጫቀታስ።<verse eid="JOB 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 31:2"/>ቦላን ደእያ ፆሳ ማታፐ አሳስ እመትዳ ቃዳይ አይቤ?</para>
  <para style="q2" vid="JOB 31:2">ሳሎን ደእያ ኡባ ዳንዳእያ ፆሳይ አሳስ እምያ ግሾይ አይቤ?<verse eid="JOB 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 31:3"/>ኢታታ ቦላ ቦሽ፥ ባላ ኦይሳታ ቦላ ጋዶይ</para>
  <para style="q2" vid="JOB 31:3">ጋካናይስ ኤረትዳባ ግደነዬ?<verse eid="JOB 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 31:4"/>ፆሳይ ታ ኦግያ ኡባ በኤነዬ?</para>
  <para style="q2" vid="JOB 31:4">ታ ታንጉዋ ኡባ ታይበነዬ?<verse eid="JOB 31:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 31:5"/>“ታኒ ዎርዶን ደእዳባ ግድኮ፥</para>
  <para style="q2" vid="JOB 31:5">አሰ ጭምዳባ ግድኮ፥<verse eid="JOB 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 31:6"/>ፆሳይ ታና ልከ ምዛነን ማዛኖ፤</para>
  <para style="q2" vid="JOB 31:6">ያትድ ታ ፅሎ ግደይሳ በኦ።<verse eid="JOB 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 31:7"/>ታ ሄመይ ኦገፐ ከይዳባ ግድኮ፥</para>
  <para style="q2" vid="JOB 31:7">ታ ዎዛናይ ታ አይፈይ ፄልዳባ አሞትዳባ ግድኮ፥</para>
  <para style="q2" vid="JOB 31:7">ታ ኩሸይ ናጋራን ቱንዳባ ግድኮ፥<verse eid="JOB 31:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="JOB 31:8"/>ታ ዶላይ ሾደትድ ዮ፤</para>
  <para style="q2" vid="JOB 31:8">ታ ዘርዳይሳ ሀር ሞ።<verse eid="JOB 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 31:9"/>“ታ ዎዛናይ ሀራ ማጫስ አሞትዳባ ግድኮ፥</para>
  <para style="q2" vid="JOB 31:9">ዎይኮ ታኒ ታ ሾሩዋ ማችዉ ጌድዳባ ግድኮ፥<verse eid="JOB 31:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="JOB 31:10"/>ታ ማችያ ሀራ አሳስ ጋጮ፤</para>
  <para style="q2" vid="JOB 31:10">ኢራ ሀራ አደይ አቆ።<verse eid="JOB 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 31:11"/>ሄስ ዬላይያ ናጋራስ ኮሽያ</para>
  <para style="q2" vid="JOB 31:11">ግታ ፕርዳ።<verse eid="JOB 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 31:12"/>ሀ ናጋራይ ታማዳ ፁግያባ ግድያ ግሾ፥</para>
  <para style="q2" vid="JOB 31:12">ታ አቁዋ ኡባ ይሳናሽን።<verse eid="JOB 31:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 31:13"/>“ታ አደ ዎይኮ ታ ማጫ አይለት አቤት ግን፥</para>
  <para style="q2" vid="JOB 31:13">ኤንታዉ ፕርዶና እፅዳባ ግድኮ፥<verse eid="JOB 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 31:14"/>ፆሳ ስንን ታ ፕርዳስ ሺቅያ ዎደ ዋናኔ?</para>
  <para style="q2" vid="JOB 31:14">እ ታና ኦይችያ ዎደ ታኒ ዎይጋ ዛራኔ?<verse eid="JOB 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 31:15"/>ታና መዳ ፆሳይ ኤንታ እ መበነዬ?</para>
  <para style="q2" vid="JOB 31:15">ኑና ኡባ ኑ አየ ኡሎን መዳይ እስ እያ ግደነዬ?<verse eid="JOB 31:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 31:16"/>“ታኒ ማንቆት ዎስዳባ ድግዳባ ግድኮ፥</para>
  <para style="q2" vid="JOB 31:16">ዎይኮ አምኤታ ምንና አግዳባ ግድኮ፥<verse eid="JOB 31:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="JOB 31:17"/>ይኦ ናይት መላ አቅያ ዎደ በአሸ፥ ታኒ ታርካ ምዳባ ግድኮ፥<verse eid="JOB 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 31:18"/>ታኒ ኤንታ ታ ናአተፈ ዶማዳ ኤንታ አዋዳ ድቻስ፤</para>
  <para style="q2" vid="JOB 31:18">ታ የለቶሶፐ ዶማዳ አምኤታ ማዳስ።<verse eid="JOB 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 31:19"/>ማኦይ ይን ሜጎይ ዎያ ኡራ፥</para>
  <para style="q2" vid="JOB 31:19">ዎይኮ ካሎ ደእያ መቶታንቹዋ በአዳ፥<verse eid="JOB 31:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="JOB 31:20"/>ታ ዶርሳታ እክሰፐ ኦሰትዳ ማኦ ማይዝን፥</para>
  <para style="q2" vid="JOB 31:20">ታና አንጆና ብዳይ ደእኮ፥<verse eid="JOB 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 31:21"/>ታኒ ሞቶን ኤንታ ሻትማናይሳ ኤራዳ፥</para>
  <para style="q2" vid="JOB 31:21">ይኦ ናይታ ናቅዳባ ግድኮ፥<verse eid="JOB 31:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOB 31:22"/>ታ ቀሰይ ኩርያፐ መኦ፤</para>
  <para style="q2" vid="JOB 31:22">ታ ኩሸይ ሀሽያፐ ካረት ዎ።<verse eid="JOB 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 31:23"/>ፆሳ ሀንቁዋ ያይዳ ግሾ</para>
  <para style="q2" vid="JOB 31:23">ሄሳ ኦናዉ ዳንዳእከ።<verse eid="JOB 31:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 31:24"/>“ታኒ ዎርቃን አማነትዳባ ግድኮ፥</para>
  <para style="q2" vid="JOB 31:24">ዎይኮ ዋላህ ባይና ዎርቃ ‘ታ ጬቆይ ነና’ ግዳባ ግድኮ፥<verse eid="JOB 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 31:25"/>ታ ዱረተ ዳሮተን፥</para>
  <para style="q2" vid="JOB 31:25">ታ ኩሸይ ደምዳ ዎን ኡፋይትዳባ ግድኮ፥<verse eid="JOB 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 31:26"/>አዋ ጶለ በአዳ፥</para>
  <para style="q2" vid="JOB 31:26">ዎይኮ አጌና ሎኦተ ፄላዳ፥<verse eid="JOB 31:26"/></para>
  <para style="q2">
    <verse number="27" style="v" sid="JOB 31:27"/>ታ ዎዛናይ ጌማን ኤንታ ናሽቤና፥</para>
  <para style="q2" vid="JOB 31:27">ዎይኮ ታ ኤንታ ዬራዳ ጎይናብከ።<verse eid="JOB 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 31:28"/>ሄስ ፕርዳ ኤህያ ናጋራ ግድያ ግሾ</para>
  <para style="q2" vid="JOB 31:28">ፆሳ ካዳስ ጉሱ።<verse eid="JOB 31:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 31:29"/>“ታ ሞርከታ ኩንደን ኡፋይታብከ፤</para>
  <para style="q2" vid="JOB 31:29">ኤንታ ጋክዳ መቱዋን ሀሹ ጋብከ።<verse eid="JOB 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 31:30"/>‘ታ ሞርከይ ዮ’ ያጋ ባዳዳ፥</para>
  <para style="q2" vid="JOB 31:30">ናጋራ ኦብከ።<verse eid="JOB 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 31:31"/>ታ ሶ አሳይ፥ ‘እያ ሶን</para>
  <para style="q2" vid="JOB 31:31">ካ ምድ ካሎናይ ኦኔ?’ ያግድ ማርካቶሶና።<verse eid="JOB 31:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 31:32"/>ታ ሶይ ኡባ ዎደ ዶያ ግድያ ግሾ፥</para>
  <para style="q2" vid="JOB 31:32">ኦገ አስ ካረን አቅ ኤረና።<verse eid="JOB 31:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 31:33"/>ሀራት ኦይሳዳ፥</para>
  <para style="q2" vid="JOB 31:33">ታ ናጋራ ታ ዎዛናን ገንብከ።<verse eid="JOB 31:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 31:34"/>አሳ ፖኮስ ያያዳ፥</para>
  <para style="q2" vid="JOB 31:34">ኤንታ ቦርያስ ዳጋማዳ፥</para>
  <para style="q2" vid="JOB 31:34">ሶ ገላዳ ቆሰትዳ ዎደይ ዴና።<verse eid="JOB 31:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 31:35"/>“ታና ስእያ አስ ደኤረነሽን፥</para>
  <para style="q2" vid="JOB 31:35">ታ ኦዳይ ቱማ ግደይሳ ፓራማይስ፤</para>
  <para style="q1" vid="JOB 31:35">ኡባ ዳንዳእያ ፆሳይ ታዉ ዛሮ እሞ</para>
  <para style="q2" vid="JOB 31:35">ታ ሞርከይ ባ ሞቱዋ ፃፍድ ሺሽን</para>
  <para style="q2" vid="JOB 31:35">ታ በአርክናሽን።<verse eid="JOB 31:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 31:36"/>በእያኮ ዎይቶዳ ቆን አዳ ማአናሽን፥</para>
  <para style="q2" vid="JOB 31:36">ካላቻዳ ታ ሁጰን ዎናሽን!<verse eid="JOB 31:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 31:37"/>ታኒ ማት ደእያ አሳዳ ፆሳኮ ሺቃዳ፥</para>
  <para style="q2" vid="JOB 31:37">ታ ኦዳባ ኡባ እያዉ ቆንጭሳናሽን!<verse eid="JOB 31:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="JOB 31:38"/>“ታ ጎሻ ቢታይ ታ ቦላ ዋስዳባ ግድኮ፥</para>
  <para style="q2" vid="JOB 31:38">ዳሳትካ አፉን ላክዳባ ግድኮ፥<verse eid="JOB 31:38"/></para>
  <para style="q2">
    <verse number="39" style="v" sid="JOB 31:39"/>ሄ ቢታን ካፅዳባ ሚሸ ቃንፆና ኤክዳባ ግድኮ፥</para>
  <para style="q2" vid="JOB 31:39">ዎይኮ ሄ ቢታ ኦይሳታ ኮሻን ዎዳባ ግድኮ፥<verse eid="JOB 31:39"/></para>
  <para style="q2">
    <verse number="40" style="v" sid="JOB 31:40"/>ታዉ ሄ ቢታን ግስተ ግሾ አጉን፥</para>
  <para style="q2" vid="JOB 31:40">ባንጋ ግሾ ሻራፍ ዶሎ” ያግስ።</para>
  <para style="p" vid="JOB 31:40">እዮባ ኦዳይ ሄሳን ፖለትስ።<verse eid="JOB 31:40"/></para>
  <chapter eid="JOB 31"/>
  <chapter number="32" style="c" sid="JOB 32"/>
  <para style="s1">ኤልሁ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 32:1"/>እዮብ፥ “ታኒ ፅሎ አስ” ግዳ ግሾ፥ ሀ ሄ አሳት እያዉ ዛሮ እሞ አጋግዶሶና። <verse eid="JOB 32:1"/><verse number="2" style="v" sid="JOB 32:2"/>እዮብ ፆሳፈ አድ ባና ፅሎ ኦዳ ግሾ፥ ራማ ያራፐ ግድዳ ቡዛ ቢታፈ ይዳ ባርከላ ናአይ ኤልሁይ እዮባ ቦላ ሀንቀትስ። <verse eid="JOB 32:2"/><verse number="3" style="v" sid="JOB 32:3"/>ኤንቲ እያ ጮ ባላ ግድ ፕርድድ፥ እያዉ በሲያ ዛሮ እማናዉ ዳንዳእቦና ግሾ ኤልሁይ ሀ ሄ ላገታ ቦላካ ሀንቀትስ። <verse eid="JOB 32:3"/><verse number="4" style="v" sid="JOB 32:4"/>ኤልሁይ ኤንታፈ ካሎትያ ግሾ ኤንቲ ኡባይ ሃሳያ ዉርሳና ጋካናዉ ናግስ። <verse eid="JOB 32:4"/><verse number="5" style="v" sid="JOB 32:5"/>ሀ ሄ አሳት እዮባስ በሲያ ዛሮ እማናዉ ዳንዳእቦናይሳ በእድ እ ዳሮ ይሎትስ።<verse eid="JOB 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 32:6"/>ቡዛ ቢታፈ ይዳ ባርከላ ናአይ ኤልሁይ ሀይሳዳ ያግድ ሃሳያ ዶምስ።</para>
  <para style="q1" vid="JOB 32:6">“ታኒ ህንተፈ ናአታይስ፤</para>
  <para style="q2" vid="JOB 32:6">ህንተ ታፐ ባይራተታ፤</para>
  <para style="q2" vid="JOB 32:6">ሄሳ ግሾ፥ ታኒ ታ ቆፋ ህንተዉ ኦዳናዉ ያያስ።<verse eid="JOB 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 32:7"/>ታኒ፥ ‘ጭማት ኦደቶ፤</para>
  <para style="q2" vid="JOB 32:7">ባንታ ዳሮ ላይን ደምዳ ጭንጫተ ታማርሶና’ ” ጋዳ ቆፓስ።<verse eid="JOB 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 32:8"/>ሽን አሳ ግዶን አቅድ ጭንጫተ እመይ፥</para>
  <para style="q2" vid="JOB 32:8">ኡባ ዳንዳእያ ፆሳ አያና።<verse eid="JOB 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 32:9"/>አሰ ጭንጫ ኦይ ጭማተ ግደና፥</para>
  <para style="q2" vid="JOB 32:9">ዎይኮ አሳስ አኬካ እመይ ላይ ዳሮተ ግደና።<verse eid="JOB 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 32:10"/>ሄሳ ግሾ፥ ስእተ፤</para>
  <para style="q2" vid="JOB 32:10">ታካ ታ ቆፋ ህንተዉ ኦዳና።<verse eid="JOB 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 32:11"/>ህንተ ሃሳያ ዎደ፥</para>
  <para style="q2" vid="JOB 32:11">ታኒ ስእ ጋዳ ሀይዛስ፤</para>
  <para style="q2" vid="JOB 32:11">ህንተ ኦዳና ቃላ ኮይሽን ናጋስ።<verse eid="JOB 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 32:12"/>ህንተ ገይሳ ኡባ ዉርሳዳ ስአስ፤</para>
  <para style="q2" vid="JOB 32:12">ሽን ህንተፈ ኦንካ እዮባ ባላ ግድ አማንበና፤</para>
  <para style="q2" vid="JOB 32:12">ህንተፈ ኦንካ እያ ፓላማስ በሲያ ዛሮ እምቤና።<verse eid="JOB 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 32:13"/>እዮባ ኦዳስ ካልስያ ዛሮ እማናዉ ዳንዳኤይ፥</para>
  <para style="q2" vid="JOB 32:13">ፆሰፈ አትሽን፥ አሰ ግዶና ግሾ፥</para>
  <para style="q2" vid="JOB 32:13">ህንተ፥ “ኑስ ጭንጫተ ደኤስ” ጎፕተ።<verse eid="JOB 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 32:14"/>እዮብ ፓላምዳይ ታራ ግዶናሽን ህንተራ፤</para>
  <para style="q2" vid="JOB 32:14">ታኒ ህንተ ኦዳዳ እያዉ ዛሮ እምከ።<verse eid="JOB 32:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 32:15"/>ኤንቲ ዳጋምድ፥</para>
  <para style="q2" vid="JOB 32:15">ጋናባ ይዳ ግሾ፥</para>
  <para style="q2" vid="JOB 32:15">ዛሮ እማናዉ ዳንዳእቦኮና።<verse eid="JOB 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 32:16"/>ያትን ኤንቲ ኦደትያባ ይድ ስእ ግድ ኤቅኮ፥</para>
  <para style="q2" vid="JOB 32:16">ታኒ ናጋናዉ ኮሺ?<verse eid="JOB 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 32:17"/>ግደና፥ ታኒ ኦድያባይ ደኤስ፤</para>
  <para style="q2" vid="JOB 32:17">ታካ ታ ቆፋ ቆንጭሳና።<verse eid="JOB 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 32:18"/>ታ ኦዳናባይ ዳሮይ ደእያ ግሾ፥</para>
  <para style="q2" vid="JOB 32:18">ታ ግዶን ደእያ አያናይ ታና ኦዳ ግድ ሱጌስ።<verse eid="JOB 32:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 32:19"/>ታ ጋይ ጎዘትዳ ማናጨዳ፥</para>
  <para style="q2" vid="JOB 32:19">ዎይኮ ማልአንቶ ዎይነ ኡሽ ኩምዳ ኦጎሮዳ</para>
  <para style="q2" vid="JOB 32:19">ቃና ሀኔስ።<verse eid="JOB 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 32:20"/>ታ ኦዳዳ ከሳናዉ በሴስ፤</para>
  <para style="q2" vid="JOB 32:20">ታ ዶና ዶያዳ ዛሮ እማናዉ ኮሼስ።<verse eid="JOB 32:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 32:21"/>ሀ ኦዳን ታኒ ኦናካ ማድከ፥</para>
  <para style="q2" vid="JOB 32:21">ዎይኮ ኦናካ ጮ ሳቢከ።<verse eid="JOB 32:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 32:22"/>አሰ ጮ ሳቢያባይ ታዉ ኤረተና፤</para>
  <para style="q2" vid="JOB 32:22">ታ ሄሳ ኦያኮ ታና መዳይስ ፕርዳናሽን።<verse eid="JOB 32:22"/></para>
  <chapter eid="JOB 32"/>
  <chapter number="33" style="c" sid="JOB 33"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 33:1"/>እዮባ፥ ሀእ ታ ኦዳ ስአ፤</para>
  <para style="q2" vid="JOB 33:1">ታ ግያባ ኡባ ሀይዛ።<verse eid="JOB 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 33:2"/>ታኒ ታ ዶና ዶያስ፤</para>
  <para style="q2" vid="JOB 33:2">ታ ቃላት ታ እንፃርሳ ፄራን ደኦሶና።<verse eid="JOB 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 33:3"/>ታ ቃላት ታ ዎዛና ሱረተ ቆንጭሶሶና፤</para>
  <para style="q2" vid="JOB 33:3">ታ ኤረይሳ ታ እንፃርሳይ ቱማተን ኦዴስ።<verse eid="JOB 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 33:4"/>ታና መዳይ ፆሳ አያና፤</para>
  <para style="q2" vid="JOB 33:4">ኡባ ዳንዳእያ ፆሳ ሸምፖይ ታዉ ደኦ እሚስ።<verse eid="JOB 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 33:5"/>ነ ዳንዳእኮ ታዉ ዛሮ እማ፤</para>
  <para style="q2" vid="JOB 33:5">ነና ጊግሳዳ ታራ ፓላማ።<verse eid="JOB 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 33:6"/>ታኒ ፆሳ ስንን ነ መላ፤</para>
  <para style="q2" vid="JOB 33:6">ታንካ ኡርቃፈ መታስ።<verse eid="JOB 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 33:7"/>ኔኒ ታዉ ያይያ ጋሶይ ባዋ፤</para>
  <para style="q2" vid="JOB 33:7">ታኒ ነና ናቅከ።<verse eid="JOB 33:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 33:8"/>“ነ ሃሳያ ኡባ ታኒ ስአሸ ጋምአስ፤</para>
  <para style="q2" vid="JOB 33:8">ኔ ዶናፐ ከይዳ ቃላታ ሀይዛስ።<verse eid="JOB 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 33:9"/>ታኒ ጌሽነ ቦረይ ባይና አስ፤</para>
  <para style="q2" vid="JOB 33:9">ታኒ ፅሎነ ናጋራ ኦቦና አስ።<verse eid="JOB 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 33:10"/>ሽን ፆሳይ ታና ሴራናዉ ጋሶ ኮዬስ፤</para>
  <para style="q2" vid="JOB 33:10">እ ታና ባ ሞርከዳ ታይቤስ።<verse eid="JOB 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 33:11"/>ታ ቶሁዋ ዱፅስ፤</para>
  <para style="q2" vid="JOB 33:11">ታ ታንጎ ኡባ እ ዎቼስ” ያጋዳሳ።<verse eid="JOB 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 33:12"/>“እዮባ፥ ነ ኦዳይ ልከ ግደና፤</para>
  <para style="q2" vid="JOB 33:12">ታ ነዉ ኦዳይስ፥ ፆሳይ አሳፐ አስ።<verse eid="JOB 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 33:13"/>‘ፆሳይ አሳ ኦዳስ ዛሮ እመና’ ጋዳ፥</para>
  <para style="q2" vid="JOB 33:13">አይስ እያራ ፓላማይ?<verse eid="JOB 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 33:14"/>አስ አኬከናፈ አትሽን፥</para>
  <para style="q2" vid="JOB 33:14">ፆሳይ ዱማ ዱማ ኦገራ ኦዴስ።<verse eid="JOB 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 33:15"/>አስ ቃማ ሂፃን ዝንእድ፥</para>
  <para style="q2" vid="JOB 33:15">ስኮ ኤይድ ደእያ ዎደ፥</para>
  <para style="q2" vid="JOB 33:15">ፆሲ አሙሆንነ ቆንጨን ኦዴስ።<verse eid="JOB 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 33:16"/>ሄ ዎደ አሳይ ስአናዳ ሀይ ዶዬስ፤</para>
  <para style="q2" vid="JOB 33:16">ባ ሴራን ኤንታ ዳጋንስ።<verse eid="JOB 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 33:17"/>ያትድ አስ ናጋራ ኦና መላ ተቄስ፤</para>
  <para style="q2" vid="JOB 33:17">ኦቶሮ አሳፐ ድጌስ።<verse eid="JOB 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 33:18"/>ፆሲ አሰ ዮፐ አሼስ፤</para>
  <para style="q2" vid="JOB 33:18">ሀይቆፐካ ናጌስ።<verse eid="JOB 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 33:19"/>አስ ሀርገትድ ሂፃን ደእሽን፥</para>
  <para style="q2" vid="JOB 33:19">እያ መቀ ጋርሳን ቃንፆና ሳሆ የድድ ሴሬስ።<verse eid="JOB 33:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 33:20"/>ሄሳዳ ሀንድ ሀርግዳ ኡራይ ካ እፄስ፤</para>
  <para style="q2" vid="JOB 33:20">ዳሮ ማልኦ ካ እያ ሻቴስ።<verse eid="JOB 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 33:21"/>እያ አሾይ ግልቅድ ዉሬስ፤</para>
  <para style="q2" vid="JOB 33:21">እያ አሳተይ መልን መቀ ታይበቴስ።<verse eid="JOB 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 33:22"/>እያ ሸምፖይ ዱፎኮ፥</para>
  <para style="q2" vid="JOB 33:22">እያ ደኦይ ሀይቆ ኪታንቾታኮ ማቴስ።<verse eid="JOB 33:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 33:23"/>“አሳስ ሱረ ኦግያ በሲያ</para>
  <para style="q2" vid="JOB 33:23">ሙኩሉን ታይበትያ ኪታንቾታፐ</para>
  <para style="q2" vid="JOB 33:23">እሶይ እያ ማዳናዉ ዳንዳኤስ።<verse eid="JOB 33:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 33:24"/>እያዉ ቃትድ፥ ‘እ ዱፎ ገሎና መላ እያ አሻ፤</para>
  <para style="q2" vid="JOB 33:24">ታኒ እያ ዎዝያባ ደማስ፤</para>
  <para style="q2" vid="JOB 33:24">እያ አጋጋ’ ያግድ ሀይቆስ ኦዴስ።<verse eid="JOB 33:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 33:25"/>ሄሳ ግሾ፥ እያ አሳተይ ናአ አሳተ ግዳና፤</para>
  <para style="q2" vid="JOB 33:25">እያ ያላጋተ ዎልቃይ እያዉ ስማና።<verse eid="JOB 33:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 33:26"/>ሄ ዎደ እ ፆሳ ዎሳና፤</para>
  <para style="q2" vid="JOB 33:26">ፆሳይ እያ ዎሳ ስአና፤</para>
  <para style="q2" vid="JOB 33:26">ፆሳይ እያዉ እያ ፅሎተ ዛርያ ግሾ፥ እ ኡፋይሳን ፆሳ ጎይናና።<verse eid="JOB 33:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 33:27"/>ሄ ዎደ አሳ ስንን እ ሀይሳዳ ያግድ የፃና፤</para>
  <para style="q2" vid="JOB 33:27">‘ታኒ ናጋራ ኦስ፤ ሱረባ ጌላያስ፤</para>
  <para style="q2" vid="JOB 33:27">ሽን ፆሳይ ታ ሀኑዋ ታዉ ቃንፅቤና።<verse eid="JOB 33:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 33:28"/>ታ ዱፎን ገሎና መላ ታና አሽስ፤</para>
  <para style="q2" vid="JOB 33:28">ሀእ ፓፃ ደአዳ ፖኦ በአይስ’ ያጋና።<verse eid="JOB 33:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 33:29"/>“ሄኮ፥ ፆሲ አሳስ ሄሳ ኡባ</para>
  <para style="q2" vid="JOB 33:29">ዛር ዛር ኦስ።<verse eid="JOB 33:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 33:30"/>እ ደኦ ፖኦ በአና መላ፥</para>
  <para style="q2" vid="JOB 33:30">እያ ሸምፑዋ ዱፎፐ አሼስ።<verse eid="JOB 33:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 33:31"/>“እዮባ፥ ታኒ ኦደይሳ ሀይዛዳ ስአ፤</para>
  <para style="q2" vid="JOB 33:31">አነ ነ ስእ ጋ፤ ታኒ ኦደታና።<verse eid="JOB 33:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 33:32"/>ነ ኦዳናዉ ኮያባይ ደእኮ ኦዳ፤</para>
  <para style="q2" vid="JOB 33:32">ታኒ ነ ፅሎ ግደይሳ በአናዉ ኮያይስ።<verse eid="JOB 33:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 33:33"/>አቶ ጊኮ ስእ ጋዳ፥ ታ ሃሳያ ስአ፤</para>
  <para style="q2" vid="JOB 33:33">ታ ነና ጭንጫተ ታማርሳና” ያግስ።<verse eid="JOB 33:33"/></para>
  <chapter eid="JOB 33"/>
  <chapter number="34" style="c" sid="JOB 34"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 34:1"/>ቃስካ ኤልሁይ ሀይሳዳ ያግስ፤<verse eid="JOB 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 34:2"/>“ህንተኖ፥ ጭንጫቶ ታ ሃሳያ ስእተ፤</para>
  <para style="q2" vid="JOB 34:2">ህንተኖ፥ ኤራንቾቶ ታና ሀይዝተ።<verse eid="JOB 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 34:3"/>እንፃርስ ማልኦ ካ ሻክ ኤረይሳዳ፥</para>
  <para style="q2" vid="JOB 34:3">ሀይ ኦዳ ሻክድ ኤሬስ።<verse eid="JOB 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 34:4"/>አነ ኑኒ ሱረባ ሻክድ፥</para>
  <para style="q2" vid="JOB 34:4">ሎኦባ ታማርድ ኤሮስ።<verse eid="JOB 34:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 34:5"/>“እዮብ፥ ‘ታኒ ፅሎ፤</para>
  <para style="q2" vid="JOB 34:5">ሽን ፆሲ ታና ሱረ ፕርዳ ድግስ።<verse eid="JOB 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 34:6"/>ታኒ ቱማ ሽን ዎርዳንቾ ግዳስ፤</para>
  <para style="q2" vid="JOB 34:6">ታናን ባል ባዋ ሽን፥</para>
  <para style="q2" vid="JOB 34:6">ፓፆና ማዱን ማዱንፅስስ’ ያግስ።<verse eid="JOB 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 34:7"/>እዮባዳ ፆሳ ቦላ፥</para>
  <para style="q2" vid="JOB 34:7">ቀልቅስያ አስ ደኢ?<verse eid="JOB 34:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 34:8"/>እ ኢታ ኦይሳታራ ላገቴስ፤</para>
  <para style="q2" vid="JOB 34:8">ናጋራንቾታራ ሄመቴስ።<verse eid="JOB 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 34:9"/>እ፥ ‘አስ ፆሰ ኡፋይሳና ግድ ኦያባይ</para>
  <para style="q2" vid="JOB 34:9">አይኮካ ማደና’ ያጌስ።<verse eid="JOB 34:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 34:10"/>“ሄሳ ግሾ፥ ህንተኖ፥ አኬካንቾ አሳቶ ስእተ፥</para>
  <para style="q2" vid="JOB 34:10">ኢታ ኦሶይ ፆሳፈ፥</para>
  <para style="q2" vid="JOB 34:10">ኡባ ዳንዳእያ ፆሳፈ ባላ ኦሶይ ሃኮ።<verse eid="JOB 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 34:11"/>ፆሳይ አሳስ እያ ኦሱዋዳ እሜስ፤</para>
  <para style="q2" vid="JOB 34:11">እያ ኦግያዳ እያዉ ቃንፄስ።<verse eid="JOB 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 34:12"/>ፆሳይ ቱማ ኢታ ኦና፤</para>
  <para style="q2" vid="JOB 34:12">ኡባ ዳንዳእያ ፆሳይ ሱረ ፕርዳ ጌላየና።<verse eid="JOB 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 34:13"/>ሳአ ቦላ እያዉ ማታ እምዳይ ኦኔ?</para>
  <para style="q2" vid="JOB 34:13">ቢታ ኡባ ቦላ እያ ሹምዳይ ኦኔ?<verse eid="JOB 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 34:14"/>ፆሳይ ባ አያናነ ባ ደኦ ሸምፑዋ</para>
  <para style="q2" vid="JOB 34:14">ዛሪድ ባኮ ኤክያኮ፥<verse eid="JOB 34:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="JOB 34:15"/>አሾ ማእዳ ኡባይ እስፈ ያና፤</para>
  <para style="q2" vid="JOB 34:15">አስ ቢታ ስማናሽን።<verse eid="JOB 34:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 34:16"/>“ነዉ አኬክ ደእኮ ሀይሳ ስአ፤</para>
  <para style="q2" vid="JOB 34:16">ታ ሃሳያ ሀይዛ።<verse eid="JOB 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 34:17"/>ሱረ ፕርዳ እፀይ ሃራናዉ ዳንዳኢ?</para>
  <para style="q2" vid="JOB 34:17">ኔኒ ፅሎነ ዎልቃማ ፆሳ ፕርዳይ?<verse eid="JOB 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 34:18"/>ፆሳይ ካዎታኮ፥ ‘ህንተ ፓናይሳታ’፤</para>
  <para style="q2" vid="JOB 34:18">ቃስ ቢታ ሃረይሳታኮ፥ ‘ህንተ ኢታ’ ያጌስ።<verse eid="JOB 34:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 34:19"/>ኤንቲ ኡባይ እያ ኩሸ ኦሶታ ግድያ ግሾ፥</para>
  <para style="q2" vid="JOB 34:19">ሀላቃታ ሶምኦ ፄልድ ማደና፤</para>
  <para style="q2" vid="JOB 34:19">ዱረታ ማንቆታፐ አድ ፄለና።<verse eid="JOB 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 34:20"/>ኤንቲ ግድ ብላሄ አኬኮና ሀይቃና፤</para>
  <para style="q2" vid="JOB 34:20">ኡባይ ኮኮርሸ ያና፤</para>
  <para style="q2" vid="JOB 34:20">ዎልቃማት አሳ ኩሸይ ቦቾና ክቻና።<verse eid="JOB 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 34:21"/>“ፆሳይ አሳ ሄመ ፄሌስ፤</para>
  <para style="q2" vid="JOB 34:21">እያ ታንጎ ኡባ ዎቼስ።<verse eid="JOB 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 34:22"/>ኢታ ኦይሳታ፥</para>
  <para style="q2" vid="JOB 34:22">ገንናዉ ዳንዳእያ ሳካና ም ባዋ።<verse eid="JOB 34:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 34:23"/>አሳይ እያ ስን ፕርዳስ ሺቃና መላ፥</para>
  <para style="q2" vid="JOB 34:23">ፆሳይ ቃፃሮ እመና።<verse eid="JOB 34:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 34:24"/>ኦይሽ ባይና ዎልቃማታ መንረስ፤</para>
  <para style="q2" vid="JOB 34:24">ኤንታ በሳን ሀራታ ሹሜስ።<verse eid="JOB 34:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 34:25"/>እ ኤንታ ኦሱዋ ኤርያ ግሾ፥</para>
  <para style="q2" vid="JOB 34:25">ኤንታ እስ ቃማን ማታፐ ዎድ ይሴስ።<verse eid="JOB 34:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 34:26"/>ኤንታ ኢታተ ግሾ፥</para>
  <para style="q2" vid="JOB 34:26">ናጋራንቾታ አሳ ስንን ሴሬስ።<verse eid="JOB 34:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 34:27"/>ሄሳ እ ኦይ፥</para>
  <para style="q2" vid="JOB 34:27">ኤንቲ እያ ካሎና እፅዳ ግሾነ</para>
  <para style="q2" vid="JOB 34:27">እያ ኪታ አግዳ ግሾሳ።<verse eid="JOB 34:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 34:28"/>ኤንቲ ማንቆታ ኡንኤድ ፆሳኮ ዋሳና መላ ኦዶሶና፤</para>
  <para style="q2" vid="JOB 34:28">ፆሳይ ማንቆታ ዋሱዋ ስእስ።<verse eid="JOB 34:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 34:29"/>ፆሳይ ስእ ጊኮ እያ ኦነ ሞታናይ?</para>
  <para style="q2" vid="JOB 34:29">እ ባ ሶምኡዋ ቆስኮ እያ በአናይ ኦኔ?</para>
  <para style="q2" vid="JOB 34:29">እ አሳፐነ ካዎተፈ ቦላ።<verse eid="JOB 34:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 34:30"/>ሄስ ሀንዳይ ጌላይ ደርያ ሃሮና መላነ</para>
  <para style="q2" vid="JOB 34:30">ኤንታ ስንን ፅሄ ዎና መላሳ።<verse eid="JOB 34:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 34:31"/>“አስ ፆሳኮ ያግያኮ ሎኦ፤</para>
  <para style="q2" vid="JOB 34:31">ካሰ ታ ናጋራ ኦዳባ ግድኮ ዛራዳ ኦከ።<verse eid="JOB 34:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 34:32"/>ታ በኦናይሳ ታና ታማርሳ፤</para>
  <para style="q2" vid="JOB 34:32">ናጋራ ኦዳባ ግድኮ ዛራዳ ኦከ።<verse eid="JOB 34:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 34:33"/>ያትን ኔኒ ፓፅከ ጋሸ፥</para>
  <para style="q2" vid="JOB 34:33">ነ ዶሰይሳ መላ ፆሳይ ነዉ ዎይታነዬ?</para>
  <para style="q1" vid="JOB 34:33">ህዛ ቆፋ ቃቻናይ ነናፐ አትሽን፥ ታና ግድከ፤</para>
  <para style="q2" vid="JOB 34:33">ሄሳ ግሾ፥ ነ ኤረይሳ ታዉ ኦዳ።<verse eid="JOB 34:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 34:34"/>አኬካ አሳይ ሀይሳዳ ያጎሶና፤</para>
  <para style="q2" vid="JOB 34:34">ጭንጫት ያጎሶና፤<verse eid="JOB 34:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 34:35"/>‘እዮብ ኤር ባይና ኦደቴስ፤</para>
  <para style="q2" vid="JOB 34:35">ኢያ ኦዳን አይፈይ ባዋ።’<verse eid="JOB 34:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 34:36"/>እዮብ ኢታ አሳዳ ዛሮ እምዳ ግሾ፥</para>
  <para style="q2" vid="JOB 34:36">ዉርሰ ጋካናዉ ፓጨትዳ ግዴረነ!<verse eid="JOB 34:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 34:37"/>እ ባ ናጋራ ቦላ ጌላተ ጉጅስ፤</para>
  <para style="q2" vid="JOB 34:37">ኑ ስንን ፆሳ ቦላ ቀልቅስስ፤</para>
  <para style="q2" vid="JOB 34:37">ፆሳ ቦላ ዳሮ ኦደትስ” ያግስ።<verse eid="JOB 34:37"/></para>
  <chapter eid="JOB 34"/>
  <chapter number="35" style="c" sid="JOB 35"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 35:1"/>ኤልሁይ ቃስ ሀይሳዳ ያግስ፤<verse eid="JOB 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 35:2"/>“እዮባ፥ ኔኒ፥ ‘ታኒ ፆሳ ስንን ፅሎ’</para>
  <para style="q2" vid="JOB 35:2">ገይስ ልኬ?<verse eid="JOB 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 35:3"/>‘ታኒ ናጋራ ኦና አጋዳ አይ ጎኤትያና?</para>
  <para style="q2" vid="JOB 35:3">አይ ዎ ደማኔ?’</para>
  <para style="q2" vid="JOB 35:3">ያጋዳ ነ ፆሳ ኦይቻናዉ ዳንዳኣሳ።<verse eid="JOB 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 35:4"/>ታኒ ነዉነ</para>
  <para style="q2" vid="JOB 35:4">ነ ላገታስ ዛሮ እማና።<verse eid="JOB 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 35:5"/>ቁ ጋዳ ሳሎታ ፄላ፤</para>
  <para style="q2" vid="JOB 35:5">ኔፐ ቦላራ ደእያ ሻራ አኬካዳ በአ።<verse eid="JOB 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 35:6"/>ነ ናጋራ ኦኮ ፆሳ አይብን ቆሀኔ?</para>
  <para style="q2" vid="JOB 35:6">ነ ባላይ ዳርኮ ሄስ እያዉ አይ ኦ?<verse eid="JOB 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 35:7"/>ነ ፅሎ ግድኮ እያዉ አይ እማኔ?</para>
  <para style="q2" vid="JOB 35:7">ዎይኮ ነ ኩሸፐ እ አይ ኤካኔ?<verse eid="JOB 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 35:8"/>ነ ናጋራ ኦኮ ነ መላ አሰ ቆሃሳ፤</para>
  <para style="q2" vid="JOB 35:8">ቃስ ፅልኮካ አሰ ጎኣሳ።<verse eid="JOB 35:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 35:9"/>“ኡንእ ዳርያ ዎደ አሳይ ዋሴስ፤</para>
  <para style="q2" vid="JOB 35:9">ዎልቃማታ ኩሸፐ ከስ ኤክያ አስ ኮይድ ዎባቶሶና።<verse eid="JOB 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 35:10"/>ሽን ኦንካ፥ ‘ቃማ ማዝሙረ እምያ፥</para>
  <para style="q2" vid="JOB 35:10">ታና መዳ ፆሳይ አዉን ደኢ? <verse eid="JOB 35:10"/><verse number="11" style="v" sid="JOB 35:11"/>ዶአታፐ አድ ታማርሰይስ፥</para>
  <para style="q2" vid="JOB 35:11">ካፎታፐ አድ ጭንጫ ኦይስ አዉን ደእ’ ያገና።<verse eid="JOB 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 35:12"/>ኤንቲ ዋሶሶና፤</para>
  <para style="q2" vid="JOB 35:12">ሽን ፆሳይ ኤንታ ኦቶሩዋ ጋሶን፥</para>
  <para style="q2" vid="JOB 35:12">ኤንታዉ ዛሮ እመና። <verse eid="JOB 35:12"/><verse number="13" style="v" sid="JOB 35:13"/>ጮ ዋሱዋ ፆሲ ቱማ ስኤና፤</para>
  <para style="q2" vid="JOB 35:13">ኡባ ዳንዳእያ ፆሳይ ሄሳ ሀይዘና።<verse eid="JOB 35:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 35:14"/>ኔኒ ታ ፆሳ በአናዉ ዳንዳእከ ያግኮካ፥</para>
  <para style="q2" vid="JOB 35:14">ነ ሞቶይ እያ ስንን ደእያ ግሾ፥</para>
  <para style="q2" vid="JOB 35:14">ነ እያ ዳንዳአን ናጋናዉ በሴስ።<verse eid="JOB 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 35:15"/>ፆሳይ አሰ ፕርዶናባነ</para>
  <para style="q2" vid="JOB 35:15">ናጋራ አግድ አና ጋዳ ቆፓይ?<verse eid="JOB 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 35:16"/>ሄሳ ግሾ፥ ኔኒ ነ ዶና ጮ ዶያሳ፤</para>
  <para style="q2" vid="JOB 35:16">ኤር ባይና ሃሳያ ዳርሳሳ” ያግስ።<verse eid="JOB 35:16"/></para>
  <chapter eid="JOB 35"/>
  <chapter number="36" style="c" sid="JOB 36"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 36:1"/>ኤልሁይ ጉጅድ ሀይሳዳ ያግስ፤<verse eid="JOB 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 36:2"/>“ፆሳ ዶና ግዳዳ ታ ነዉ ኦድያባይ ደእያ ግሾ፥</para>
  <para style="q2" vid="JOB 36:2">ጉ ዳንዳአዳ ስአ።<verse eid="JOB 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 36:3"/>ታኒ ታ ኤራ ሃሆ ሶፐ ኤሀና፤</para>
  <para style="q2" vid="JOB 36:3">ታና መዳይስ ፅሎ ግደይሳ ቆንጭሳና።<verse eid="JOB 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 36:4"/>ታኒ ዎርዶ ሃሳይከ፤</para>
  <para style="q2" vid="JOB 36:4">ኩመ ኤር ደእያ አስ ኔራ ደኤይሳ አማና።<verse eid="JOB 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 36:5"/>“ፆሳይ ቱማ ዎልቃማ፤</para>
  <para style="q2" vid="JOB 36:5">ሽን እ ኦናካ ካና።</para>
  <para style="q2" vid="JOB 36:5">እ ባ አኬካን ምኖ።<verse eid="JOB 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 36:6"/>እ ኢታት ደኦን ዳና መላ ኦና፤</para>
  <para style="q2" vid="JOB 36:6">ሽን ኡንኤትዳይሳታስ ሱረ ፕርዴስ።<verse eid="JOB 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 36:7"/>ፆሳይ ባ አይፍያ ፅሎታ ቦላፈ ደንና፤</para>
  <para style="q2" vid="JOB 36:7">ኤንታ ካዎታራ ኡትስድ፥</para>
  <para style="q2" vid="JOB 36:7">መርናዉ ቁ ቁ ኦስ።<verse eid="JOB 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 36:8"/>ሽን አሳይ ሳንላታን ቃሸትኮ፥</para>
  <para style="q2" vid="JOB 36:8">ዎይኮ መቶ ዎዶሮን ኦይከትኮ፥<verse eid="JOB 36:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="JOB 36:9"/>እ ኤንታ ኦሱዋነ</para>
  <para style="q2" vid="JOB 36:9">ኦቶሮን ኦዳ ናጋራ ኤንታ ቦላ ቆንጭሴስ።<verse eid="JOB 36:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 36:10"/>ሴራ ስአናዳ ኤንታ ሀይ ዶዬስ፤</para>
  <para style="q2" vid="JOB 36:10">ናጋራፐ ስማና መላ ኤንታ ኪቴስ።<verse eid="JOB 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 36:11"/>ኤንቲ ስእድ እያዉ ኪተትኮ፥</para>
  <para style="q2" vid="JOB 36:11">ባንታ ላይ ሳሮንነ ኡፋይሳን ዉርሳና።<verse eid="JOB 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 36:12"/>ሽን ኤንቲ ስኦና እፅኮ ማሻን ዉራና፤</para>
  <para style="q2" vid="JOB 36:12">ኤንቲ ኤራ ይዳ ግሾ ሀይቃና።<verse eid="JOB 36:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 36:13"/>“ፆሳ አማኖና አሳት</para>
  <para style="q2" vid="JOB 36:13">ባንታ ዎዛናን ይሎትዳ መላ ደኦሶና፤</para>
  <para style="q2" vid="JOB 36:13">እ ኤንታ ፕርድያ ዎደ ማደ ኮይድ ዎሶኮና።<verse eid="JOB 36:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 36:14"/>ኤንቲ ኦያ ቱና ኦሱዋን ያና፤</para>
  <para style="q2" vid="JOB 36:14">ባንታ ናአተን ሀይቃና።<verse eid="JOB 36:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 36:15"/>ሽን ዋየተይሳታ ኤንታ ዋያፐ አሼስ፤</para>
  <para style="q2" vid="JOB 36:15">ኤንታ መቱዋ ባጋራ ኤንታዉ ኦዴስ።<verse eid="JOB 36:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 36:16"/>“ፆሳይ ነና መቶ ዎዶሮፐ፥</para>
  <para style="q2" vid="JOB 36:16">ኡንእ ባይና ዳልጋ በሲ፥</para>
  <para style="q2" vid="JOB 36:16">ዶረትዳ ካ ኩምዳ ጋይታኮ ከሳና።<verse eid="JOB 36:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 36:17"/>ሽን ሀእ ኢታታ ቦላ ጋክያ ፕርዳይ ነ ቦላ ጋክን፤</para>
  <para style="q2" vid="JOB 36:17">ፅሎ ፕርዳን ኦይከታዳሳ።<verse eid="JOB 36:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 36:18"/>ኦንካ ነና ዱረተ በስድ ጭሞና መላ፥</para>
  <para style="q2" vid="JOB 36:18">ዎፈ ዳሮይ ባለና መላ ናገታ።<verse eid="JOB 36:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 36:19"/>ነ ዱረተይ</para>
  <para style="q2" vid="JOB 36:19">ዎይኮ ነ ዳፈተይ ነና መቶፐ አሻኔ?<verse eid="JOB 36:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 36:20"/>አሳይ ባንታ በሳፈ ይያ ቃማይ፥</para>
  <para style="q2" vid="JOB 36:20">ያና መላ አሞቶፋ።<verse eid="JOB 36:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 36:21"/>ሀ መቶ ኡባይ ነና ጋክዳይ ሄሳ ጋሶና፤</para>
  <para style="q2" vid="JOB 36:21">ሄሳ ግሾ፥ ኢታ ኦና መላ ናገታ።<verse eid="JOB 36:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 36:22"/>“ፆሳይ ባ ዎልቃን ቁ ቁ ግስ፤</para>
  <para style="q2" vid="JOB 36:22">እያ መላ አስታማረይ ኦኔ?<verse eid="JOB 36:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 36:23"/>ፆሳ፥ ‘ሀይሳ ኦ’ ግድ ኪተይ፥</para>
  <para style="q2" vid="JOB 36:23">ዎይኮ፥ ‘ኔኒ ኢታ ኦሶ ኦዳሳ’ ያጋናዉ ዳንዳኤይ ኦኔ?<verse eid="JOB 36:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 36:24"/>አሳይ ማዝሙረን ሳቢዳ እያ ኦሱዋ፥</para>
  <para style="q2" vid="JOB 36:24">ነካ ማዝሙረን ሳባ።<verse eid="JOB 36:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 36:25"/>አሳ ኮቸ ኡባይ ፆሳ ኦሱዋ በእስ፤</para>
  <para style="q2" vid="JOB 36:25">አሳይ ሃሆን ኤቅድ ፄልዶሶና።<verse eid="JOB 36:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 36:26"/>ፆሳይ ግታ! እያ ግታተ ኑ አኬካናዉ ዳንዳኦኮ፤</para>
  <para style="q2" vid="JOB 36:26">እያ ላይ ዳሮተስ ዛው ባዋ።<verse eid="JOB 36:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 36:27"/>“ፆሳይ ሃ አባፈ ፑደ ሳሎ ኤፌስ፤</para>
  <para style="q2" vid="JOB 36:27">ዱገ ዛሪድ እራ ኦድ ቡክሴስ።<verse eid="JOB 36:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 36:28"/>ሄ እራይ ሻራፐ ከይድ፥</para>
  <para style="q2" vid="JOB 36:28">አሳ ቦላ ቡካና መላ ኦስ።<verse eid="JOB 36:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 36:29"/>ፆሲ ሻራ ዋትድ ምጭያኮ፥</para>
  <para style="q2" vid="JOB 36:29">ፆሳይ ደእያ ሳሉዋን ዋንድ ጉምያኮ፥</para>
  <para style="q2" vid="JOB 36:29">ኦንካ ኤረና።<verse eid="JOB 36:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 36:30"/>እ ባ ዩሾን ዎልአን ፖኡዋ ላሌስ፤</para>
  <para style="q2" vid="JOB 36:30">አባ ጪሙዋ ዋትድ ካምያኮ በአ።<verse eid="JOB 36:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 36:31"/>ያትድ ፆሳይ ደርያ አይሴስ፤</para>
  <para style="q2" vid="JOB 36:31">ካ ዳርስድ እሜስ።<verse eid="JOB 36:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 36:32"/>እ ዎልአን ባ ኩሸን ኦይኬስ፤</para>
  <para style="q2" vid="JOB 36:32">ባ ማልዳ በሳ ጫዳና መላ ኪቴስ።<verse eid="JOB 36:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 36:33"/>ዳድ ቅድ ኡሾይ ያናይሳ በሴስ፤</para>
  <para style="q2" vid="JOB 36:33">መሄይካ ኡሾይ ያናይሳ ኤሬስ።<verse eid="JOB 36:33"/></para>
  <chapter eid="JOB 36"/>
  <chapter number="37" style="c" sid="JOB 37"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 37:1"/>“እያ ኡሹዋን ታ ዎዛናይ ድርጌስ፤</para>
  <para style="q2" vid="JOB 37:1">ባ በሳን ቃፄስ።<verse eid="JOB 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 37:2"/>እያ ዶናፐ ከይያ ቃላ ስእተ፤</para>
  <para style="q2" vid="JOB 37:2">ዳዳዳ ጉምያ እያ ግርሳ ሀይዝተ።<verse eid="JOB 37:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 37:3"/>እ ሳሎ ጋርሳን ባ ዎልአን ላሌስ፤</para>
  <para style="q2" vid="JOB 37:3">ቢታ ጋፃፐ ጋፃ ጋካናዉ ኪቴስ።<verse eid="JOB 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 37:4"/>ሄሳፈ ጉየ፥ እያ ጉንይ ስኤቴስ፤</para>
  <para style="q2" vid="JOB 37:4">ባ ያሽያ ግርሳ ስሴስ።</para>
  <para style="q1" vid="JOB 37:4">እያ ግርሳይ ስኤትያ ዎደ፥</para>
  <para style="q2" vid="JOB 37:4">ባ ዎልአን ተቀና።<verse eid="JOB 37:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 37:5"/>ፆሳ ማላልስያ ኦገን ባ ጉን ስሴስ፤</para>
  <para style="q2" vid="JOB 37:5">ኑኒ አኬካናዉ ዳንዳኦና ግታባ እ ኦስ።<verse eid="JOB 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 37:6"/>እ ሻቻኮ፥ ‘ሳአን ዎ’ ያጌስ፤</para>
  <para style="q2" vid="JOB 37:6">ዎልቃማ እራኮ፥ ‘ቡካ’ ያግድ ኪቴስ።<verse eid="JOB 37:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 37:7"/>እ መዳ አሳ ኡባይ እያ ኦሱዋ ኤራና መላ፥</para>
  <para style="q2" vid="JOB 37:7">አሳይ ባንታ ኦሱዋ አጋና መላ ኦስ።<verse eid="JOB 37:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 37:8"/>ሄ ዎደ ዶአት ባንታ በሳ ገሎሶና፤</para>
  <para style="q2" vid="JOB 37:8">ባንታ ጎንጎሉዋን ቆሰቶሶና።<verse eid="JOB 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 37:9"/>ዎልቃማ ጎተይ ዱገሀፐ ደንዴስ፤</para>
  <para style="q2" vid="JOB 37:9">እርፃ ጫርኮይ ፑደሀፐ ዬስ።<verse eid="JOB 37:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 37:10"/>ፆሳ ደኦ ሸምፖይ ሻች መስ፤</para>
  <para style="q2" vid="JOB 37:10">ዳልጋ ሃታ ሹቻዳ ምንስ።<verse eid="JOB 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 37:11"/>ሻር ሃ ቶካና መላ ኦስ፤</para>
  <para style="q2" vid="JOB 37:11">ባ ዎልአን ሻራ ግዶን ላሌስ።<verse eid="JOB 37:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 37:12"/>ሻራት እያ ኪታን ቢታ ጋፃ ዩዮሶና፤</para>
  <para style="q2" vid="JOB 37:12">እ ኪትያ ኪታ ኡባ ፖሎሶና።<verse eid="JOB 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 37:13"/>ፆሳይ እራ ቡክሰይ ቢታ እርፅሳናሳ፥</para>
  <para style="q2" vid="JOB 37:13">ዎይኮ አሳ ሴራናሳ፥ ዎይኮ ባ ሲቁዋ በሳናሳ።<verse eid="JOB 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 37:14"/>“እዮባ፥ ሄሳ ስአ፤</para>
  <para style="q2" vid="JOB 37:14">ፆሳይ ኦያ ማላልስያ ኦሱዋ ታክ ጋዳ አኬካ።<verse eid="JOB 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 37:15"/>ፆሳይ ሻራታ ዋትድ ኪትያኮ፥</para>
  <para style="q2" vid="JOB 37:15">ባ ዎልአን ዋትድ ዎልአምስያኮ ኤራይ?<verse eid="JOB 37:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 37:16"/>ሻራት ሳሎን ዋንድ ኡትያኮ፥</para>
  <para style="q2" vid="JOB 37:16">ኤራን ፖሎ ግድዳ ፆሳይ</para>
  <para style="q2" vid="JOB 37:16">ኦያ ማላልስያ ኦሱዋ ኔኒ ኤራይ?<verse eid="JOB 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 37:17"/>ዱገሀ ጫርኮይ ጫርክድ ቢታ ምሽስያ ዎደ፥</para>
  <para style="q2" vid="JOB 37:17">ኔኒ ዎልቃማ ባዞ ሴላን ትልአና።<verse eid="JOB 37:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 37:18"/>ፆሳይ ሳሉዋ ትልእዳ ማስቶተዳ ምጭያ ዎደ፥</para>
  <para style="q2" vid="JOB 37:18">ኔኒ እያ ማዳናዉ ዳንዳአይ?<verse eid="JOB 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 37:19"/>ኑኒ ኤራ ፓጫ ግድያ ግሾ፥</para>
  <para style="q2" vid="JOB 37:19">ፆሳስ ዎይግድ ኦደታነኮ ነ ኑና ታማርሳ።<verse eid="JOB 37:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 37:20"/>ፆሳራ ኦደታና ጋዳ ታኒ ኦይቻናዉ ኮሺ?</para>
  <para style="q2" vid="JOB 37:20">ታና ይሳና መላ ታ አይስ እያ ደንኔ?<verse eid="JOB 37:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 37:21"/>ጫርኮይ ሳሎፐ ሻራ ጌሽያ ዎደ፥</para>
  <para style="q2" vid="JOB 37:21">ሳሎን ጶልያ አዋ ኦንካ በአናዉ ዳንዳኤና።<verse eid="JOB 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 37:22"/>ፑደሀ ባጋራ ዎርቃ ዳንያ ፖኦይ በንቴስ፤</para>
  <para style="q2" vid="JOB 37:22">ፆሳይ ያሽያ ቴማን ቆንጬስ።<verse eid="JOB 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 37:23"/>ኡባ ዳንዳእያ ፆሳኮ ሺቃናዉ ዳንዳኦኮ፤</para>
  <para style="q2" vid="JOB 37:23">እያ ዎልቃይ ግታ።</para>
  <para style="q1" vid="JOB 37:23">እ ባ ቱማ ፕርዳንነ ባ ግታ ፅሎተን</para>
  <para style="q2" vid="JOB 37:23">አሰ ቆሄና።<verse eid="JOB 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 37:24"/>ሄሳ ግሾ፥ አሳይ እያዉ ያዬስ፤</para>
  <para style="q2" vid="JOB 37:24">ባንታና ጭንጫ ገይሳታ እ ካስ” ያግስ።<verse eid="JOB 37:24"/></para>
  <chapter eid="JOB 37"/>
  <chapter number="38" style="c" sid="JOB 38"/>
  <para style="s1">ፆሳ ዛሩዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 38:1"/>ሄሳፈ ጉየ፥ ጎዳይ ጎተ ግዶን ግድድ እዮባስ ሀይሳዳ ያግድ ዛርስ።<verse eid="JOB 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 38:2"/>ኤር ባይና ኦዳን</para>
  <para style="q2" vid="JOB 38:2">ታ ዞርያ ምሰይ እ ሄስ ኦኔ?<verse eid="JOB 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 38:3"/>አነ አደዳ ዳንጨታ፤</para>
  <para style="q2" vid="JOB 38:3">ታ ነና ኦይቻና፥ ታዉ ዛራ።<verse eid="JOB 38:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 38:4"/>ታኒ አላምያ መያ ዎደ ኔኒ አዉን ደአይ?</para>
  <para style="q2" vid="JOB 38:4">አነ ነ አኬክያኮ ታዉ ኦዳ።<verse eid="JOB 38:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 38:5"/>ነ ኤርኮ፥ ሀ ሳኣ ዳልጋተስ ዛዋ ዎዳይ ኦኔ?</para>
  <para style="q2" vid="JOB 38:5">ዋ ዎዶሩዋ ሳአ ቦላ የግዳይ ኦኔ?<verse eid="JOB 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 38:6"/>ሀ ሳኣ ቱሳታ ኩንዶና መላ ምንድ ኦይክዳይ አይቤ?</para>
  <para style="q2" vid="JOB 38:6">ሀ ሳኣ ባሱዋስ ኮይሮ ሹቻ ዎዳይ ኦኔ?<verse eid="JOB 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 38:7"/>ዎንታ ባካላት እስፈ የፅያ ዎደ፥</para>
  <para style="q2" vid="JOB 38:7">ኪታንቾት ኡባይ ኡፋይሳን እልል ግያ ዎደ ነ ኤራይ?<verse eid="JOB 38:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 38:8"/>አባ ሃ ቢታፈ ቅድ ከይያ ዎደ፥</para>
  <para style="q2" vid="JOB 38:8">እያ ፐንገታ ጎርድዳይ ኦኔ?<verse eid="JOB 38:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 38:9"/>አባ ሻራ ማይዛስ፤</para>
  <para style="q2" vid="JOB 38:9">ሳካና ማን ጎዝዳይ ታና።<verse eid="JOB 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 38:10"/>አባይ ካንና መላ ዛዋ መዳይ፥</para>
  <para style="q2" vid="JOB 38:10">እያዉ ፐንገነ ተቀ ዎዳይ ታና።<verse eid="JOB 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 38:11"/>“ሀይሳ ጋካናዉ ያ፤</para>
  <para style="q2" vid="JOB 38:11">ሽን ሀይሳፈ አፋ፤</para>
  <para style="q2" vid="JOB 38:11">ነ ዎልቃማ ሆበይ ሄሳን ኤቆ” ያግዳይ ታና።<verse eid="JOB 38:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 38:12"/>እዮባ፥ ነ የለቶሶፐ ዎንት ዎንታና መላ ኪታ ኤራይ፥</para>
  <para style="q2" vid="JOB 38:12">አዋይ ዶላና በሳ ማላ ኤራይ?<verse eid="JOB 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 38:13"/>ዎንታ ፖኦይ ቢታ ኡባን ፖአና መላ፥</para>
  <para style="q2" vid="JOB 38:13">ኢታ አሳታ ቆሰትዳ በሳፈ ቆንጨ ከሳና መላ፥</para>
  <para style="q2" vid="JOB 38:13">ኔኒ ዎንታ ኪታ ኤራይ?<verse eid="JOB 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 38:14"/>ዎንታ ፖኦይ ዙማታነ ዛንጋራታ፥</para>
  <para style="q2" vid="JOB 38:14">ዳኮይድ ዎዳ ማኦይ ኤቅድ በንተይሳዳ በሴስ፤</para>
  <para style="q2" vid="JOB 38:14">ኦቶ ቦላ ዎዳ ማታመዳ ቆንጬስ።<verse eid="JOB 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 38:15"/>ኢታታ ፖኦይ ኤከታና፤</para>
  <para style="q2" vid="JOB 38:15">ኤንታ ማካላ ቀሰይ መቃና።<verse eid="JOB 38:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 38:16"/>ጪሞ አባ ግዶ ገላዳ ፑልቱዋ በአዲ?</para>
  <para style="q2" vid="JOB 38:16">ዎይኮ እያ ባሱዋ ጋካዳ እያ ኦላ ስመረታዲ?<verse eid="JOB 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 38:17"/>ነዉ ሀይቆ ፐንገት በንትዶና?</para>
  <para style="q2" vid="JOB 38:17">ዎይኮ ሳካና ማ ፐንገታ በአዲ?<verse eid="JOB 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 38:18"/>ሳአይ አይ መላ ግቴኮ ነ ኤራይ?</para>
  <para style="q2" vid="JOB 38:18">ሄሳ ኡባ ነ ኤርያ ግድኮ ታው ኦዳ።<verse eid="JOB 38:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 38:19"/>ፖኦኮ ኤፍያ ኦገይ አዉኔ?</para>
  <para style="q2" vid="JOB 38:19">ም አዉን ደእያኮ ኤራይ?<verse eid="JOB 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 38:20"/>ፖኦነ ማ ኤንታ በሳ በሳ ኤፋናዉ ዳንዳአይ?</para>
  <para style="q2" vid="JOB 38:20">ኤንቲ ደእያ በሳ ኤፍያ ኦግያ ኤራይ?<verse eid="JOB 38:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 38:21"/>ኔኒ ሳእ መትያ ዎደ የለትዳ ግሾነ</para>
  <para style="q2" vid="JOB 38:21">ዳሮ ላይ ደእዳ ግሾ ሄሳ ኤሮና አጋካ!<verse eid="JOB 38:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 38:22"/>ሻች ምንጀትያ ኬ ገላዲ?</para>
  <para style="q2" vid="JOB 38:22">ዎይኮ ሻች ዶረትዳ በሳ በአዲ?<verse eid="JOB 38:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 38:23"/>ታኒ ኤንታ መቶ ዎደስ፥ ኦላ ዎደስነ</para>
  <para style="q2" vid="JOB 38:23">ቶራ ጋላሳስ ምንጃ ዎስ።<verse eid="JOB 38:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 38:24"/>ዎልአን ከያ በሳ ኤፍያ ኦገይ አዉን ደኢ?</para>
  <para style="q2" vid="JOB 38:24">ዎይኮ ዶሎሀ ጫርኮይ አዉፐ ከይድ ጫርኪ?<verse eid="JOB 38:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 38:25"/>እር ዎያ በሳ ጊግስዳይ፥</para>
  <para style="q2" vid="JOB 38:25">ዳዳስ ኦገ ከስዳይ ኦኔ?<verse eid="JOB 38:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 38:26"/>አስ ዶና መላ ቢታን</para>
  <para style="q2" vid="JOB 38:26">እራ ቡክሰይ ኦኔ?<verse eid="JOB 38:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 38:27"/>መልዳ መላ ቢታይ እራን ላክድ፥</para>
  <para style="q2" vid="JOB 38:27">ፑርጮ ማታይ ዶላና መላ ኦዳይ ኦኔ?<verse eid="JOB 38:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 38:28"/>እራስ አው ደኢ?</para>
  <para style="q2" vid="JOB 38:28">ዎይኮ አካ የልዳይ ኦኔ?<verse eid="JOB 38:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 38:29"/>ሻቻስ አይያ ደአይ?<verse eid="JOB 38:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 38:30"/>ሃይ ሹቻዳ ምንስ፤</para>
  <para style="q2" vid="JOB 38:30">አባ ባሶይ ሻቻዳ ኡከቴስ።<verse eid="JOB 38:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 38:31"/>ፕላድሳ ጌተትያ ፆልንቶታ እስፈ ጋዳ ቃቻናዉ ዳንዳአይ?</para>
  <para style="q2" vid="JOB 38:31">ኦርዮና ጌተትያ ፆልንቶት ቃሸትዳ ዎዶሩዋ ብላናዉ ዳንዳአይ?<verse eid="JOB 38:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 38:32"/>ጩጋን ጩጋን ደእያ ፆልንቶታ ኤንታ ዎደን ዎደን ከሳናዉ ዳንዳአይ?</para>
  <para style="q2" vid="JOB 38:32">ቢረ ጌተትያ ፆልንቶታ ኤንታ ናይታራ ካለናዉ ዳንዳአይ?<verse eid="JOB 38:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 38:33"/>ሳሎት አይ ህገን አቅያኮ ነ ኤራይ?</para>
  <para style="q2" vid="JOB 38:33">ሄ ህገይ ሳኣ ሃራና መላ ኦናዉ ዳንዳአይ?<verse eid="JOB 38:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 38:34"/>ድኦይ ነና ሙካና መላ እራ ቡክሳናዉ፥</para>
  <para style="q2" vid="JOB 38:34">ነ ቃላ ቁ ኦዳ ሻራታ ስሳናዉ ዳንዳአይ?<verse eid="JOB 38:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 38:35"/>ዎልአን ኪታናዉ ዳንዳአይ?</para>
  <para style="q2" vid="JOB 38:35">ኤንቲ ኔኮ ይድ፥ “ሄኮ፥ አይ ኦኖ?” ጎና?<verse eid="JOB 38:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 38:36"/>ዎዛናስ ጭንጫተ፥</para>
  <para style="q2" vid="JOB 38:36">ካሀስ አኬካ እምዳይ ኦኔ?<verse eid="JOB 38:36"/></para>
  <para style="q1">
    <verse number="37-38" style="v" sid="JOB 38:37-38"/>ባ ጭንጫተን ሻራታ ታይባናዉ ዳንዳኤይ ኦኔ?</para>
  <para style="q2" vid="JOB 38:37-38">ባና ሙኑቅድ፥ ኡርቃ ከስድ ምንናዉ፥</para>
  <para style="q2" vid="JOB 38:37-38">ሳሎ ኦቶታ ገድ ኦድ ሃ ትጋናዉ ዳንዳኤይ ኦኔ?<verse eid="JOB 38:37-38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="JOB 38:39"/>ሻንካታዳ ማጫ ጋሞስ ምያባ ኤሀ ኤራይ?</para>
  <para style="q2" vid="JOB 38:39">ኮሻትዳ ጋሞ ማራታ ሙዛ ኤራይ?<verse eid="JOB 38:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JOB 38:40"/>ኤንቲ ጎንጎሎን ቆሰት ናጎሶና፤</para>
  <para style="q2" vid="JOB 38:40">ባዞን ዝንእድ ፔኦሶና።<verse eid="JOB 38:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="JOB 38:41"/>ቁሮት ኮሻትድ ዳቡርያ ዎደ፥</para>
  <para style="q2" vid="JOB 38:41">ኤንታ ናይት ምያባ ደማናዉ ታኮ ዋስያ ዎደ፥</para>
  <para style="q2" vid="JOB 38:41">ኤንታዉ ምያባ እመይ ኦኔ?<verse eid="JOB 38:41"/></para>
  <chapter eid="JOB 38"/>
  <chapter number="39" style="c" sid="JOB 39"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 39:1"/>“ዎሽኤይ አዉደ የልያኮ ኔኒ ኤራይ?</para>
  <para style="q2" vid="JOB 39:1">ባቾት ባናክድ ባንታ ማራታ የልያ ዎደ በአዲ?<verse eid="JOB 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 39:2"/>ኤንቲ አይ መላ አጌና ጋምእያኮ፥</para>
  <para style="q2" vid="JOB 39:2">አዉደ የልያኮ ነ ኤራይ?<verse eid="JOB 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 39:3"/>ኤንቲ ጉልባት ኤቀትድ፥</para>
  <para style="q2" vid="JOB 39:3">ባንታ ማራታ የለይ አዉደኮ ኤራይ?<verse eid="JOB 39:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 39:4"/>ኤንታ ማራት ባዞን ድጭድ ምኖሶና፤</para>
  <para style="q2" vid="JOB 39:4">ባንታ አየታ አግድ ቦሶና፤ ናምአን ጉየ ስሞኮና።<verse eid="JOB 39:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 39:5"/>“ዎራ ሀረት የዳ ዳናዳ ኦዳይ ኦኔ?</para>
  <para style="q2" vid="JOB 39:5">ቃሾፐ ኤንታ ብርሽድ የድዳይ ኦኔ?<verse eid="JOB 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 39:6"/>ኤንታዉ ባዙዋ ደእያ በሲ ኦዳ እማስ፤</para>
  <para style="q2" vid="JOB 39:6">ማፅነ ቢታን ኤንቲ ዳናዳ ኦስ።<verse eid="JOB 39:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 39:7"/>ካታማ ዋሱዋፐ ሃክድ ደኦሶና፤</para>
  <para style="q2" vid="JOB 39:7">ላገይስታ ቆደ ስኦኮና።<verse eid="JOB 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 39:8"/>ኤንቲ ደረታ ቦላ ባንታና ሄሞሶና፤</para>
  <para style="q2" vid="JOB 39:8">ያን ምያ ፑርጮ ማታ ቆሮሶና።<verse eid="JOB 39:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 39:9"/>“መን ነዉ ኦናዉ ኤሮ ጋንዴ?</para>
  <para style="q2" vid="JOB 39:9">ዎይኮ ነ ዛዳሎን ቃማ አቃንዴ?<verse eid="JOB 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 39:10"/>ጎያና መላ ነ እያ ዋፃኔ?</para>
  <para style="q2" vid="JOB 39:10">ዎይኮ ዋፃዳ ጎያናዉ ዳንዳአይ?<verse eid="JOB 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 39:11"/>ኔኒ እያ ዎልቃ ምኖተን አማነታኔ?</para>
  <para style="q2" vid="JOB 39:11">ዴፆ ኦሶ እ ኦና መላ እያዉ የጋ አጋኔ?<verse eid="JOB 39:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 39:12"/>ኔኒ ካ ሻለን ቆላና መላ፥</para>
  <para style="q2" vid="JOB 39:12">ዎይኮ ዉዱማን ሺሻና መላ እያ አማናይ?<verse eid="JOB 39:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 39:13"/>“ያንቾይ ባ ቀፍያ ኤለሳዳ ቃዉሱ፤</para>
  <para style="q2" vid="JOB 39:13">ሽን ሃ ካፎዳ ፕራናዉ ዳንዳኡኩ።<verse eid="JOB 39:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 39:14"/>ያንቾይ ባ ጱጱልያ ቢታን ጱጱላዉሱ፤</para>
  <para style="q2" vid="JOB 39:14">ሻፈን ሆአና መላ አጋጋዉሱ።<verse eid="JOB 39:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 39:15"/>‘ቶሆይ መንና፥</para>
  <para style="q2" vid="JOB 39:15">ባዞ ዶአት የና’ ጋዳ ቆፑኩ።<verse eid="JOB 39:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 39:16"/>ናይት ባባ ግዶናዳ ኦዳ ኤንታዉ ዳሮ ኢታዉሱ።</para>
  <para style="q2" vid="JOB 39:16">እ ዳቡራ ኡባይ መላ አተይስ እዉ አይኮካ ዳነና።<verse eid="JOB 39:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 39:17"/>ሄሳዳ ኦዳ እዮ ጭንጫተ ድግዳይነ</para>
  <para style="q2" vid="JOB 39:17">አኬካ ይስዳይ ታና።<verse eid="JOB 39:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 39:18"/>ሽን ደንዳዳ እያ ዎፅያ ዎደ፥</para>
  <para style="q2" vid="JOB 39:18">ባራ ጋደትያ ፓራ ቦላነ ፓራዋ ቦላ ሚጫዉሱ።<verse eid="JOB 39:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 39:19"/>“እዮባ፥ ፓራታስ ዎልቃ እምዳይ፥</para>
  <para style="q2" vid="JOB 39:19">ዎይኮ ፓራታ ሞርገን ጭምባ ማይዝዳይ ነኔ?<verse eid="JOB 39:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 39:20"/>ፓራት ቦለዳ ጉፓናዳነ</para>
  <para style="q2" vid="JOB 39:20">ጋርማምድ ዳጋንናዳ ኦዳይ ነኔ?<verse eid="JOB 39:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 39:21"/>ፓራት ባንታ ዎልቃን አማነትድ ስኮሶና፤</para>
  <para style="q2" vid="JOB 39:21">ኦለታናዉ ኦላ ደምባ ጋላቦሶና።<verse eid="JOB 39:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 39:22"/>ያሽ ኤሮኮና፤ ኤንታ አይብካ ዳጋንና፤</para>
  <para style="q2" vid="JOB 39:22">ኤንታ ቦላ ማሻ ሾድኮካ ጉየ ስሞኮና።<verse eid="JOB 39:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 39:23"/>ኤንታ ቶግያ ኦላንቾት ኦይክዳ ኦላ ሚሸት፥</para>
  <para style="q2" vid="JOB 39:23">ጶልሸ እሶይ እሱዋራ ጋሄትድ ጊሮሶና።<verse eid="JOB 39:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 39:24"/>ሽን ፓራት ቢታ ካሽሸነ ያሽስሸ ጋላቦሶና፤</para>
  <para style="q2" vid="JOB 39:24">ሞይዘ ግርስ ስእያ ዎደ ስእ ግድ ኤቃናዉ ዳንዳኦኮና።<verse eid="JOB 39:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 39:25"/>ሞይዘይ ፑነትያ ዎደ ኡፋይሳን ጋርማሞሶና፤</para>
  <para style="q2" vid="JOB 39:25">ኦላ ፔኖ ሃሆን ኤኮሶና፤</para>
  <para style="q2" vid="JOB 39:25">ቶራ ሞጮና ኪታነ ኦላንቾታ ጬቁዋ ስኦሶና።<verse eid="JOB 39:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 39:26"/>“ፅሎይ ባ ቀፍያ ዱገሀ ባጋ ምጭድ፥</para>
  <para style="q2" vid="JOB 39:26">ፓላናዉ ዳንዳኤይ ነ ጭንጫተኔ?<verse eid="JOB 39:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 39:27"/>አርጋን ፑደ ከይድ፥</para>
  <para style="q2" vid="JOB 39:27">ባ ኬ ቃ ደረታ ቦላ ኬፀይ ነ ኪታኔ?<verse eid="JOB 39:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 39:28"/>አርጋን አፎ ዶናን ባ ኬ ኬፅድ ደኤስ፤</para>
  <para style="q2" vid="JOB 39:28">ዛላ ቆጶት እያዉ ቆልአ ግድዶሶና።<verse eid="JOB 39:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 39:29"/>ያን ኡትድ ባዉ ምያባ ዎቼስ፤</para>
  <para style="q2" vid="JOB 39:29">እያ አይፈይ ሃሆን ጌሽድ ደሜስ።<verse eid="JOB 39:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 39:30"/>አርጋን ናይት ሱ ኡዮሶና፤</para>
  <para style="q2" vid="JOB 39:30">ጋዉፅ ደእያ በሳን ሺቆሶና” ያግስ።<verse eid="JOB 39:30"/></para>
  <chapter eid="JOB 39"/>
  <chapter number="40" style="c" sid="JOB 40"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 40:1"/>ጎዳይ እዮባኮ ዛሪድ ያግስ፤<verse eid="JOB 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 40:2"/>“እዮባ፥ አስ ኡባ ዳንዳእያ ጎዳራ ሞተትድ፥ ላናዉ ዳንዳኢ?</para>
  <para style="q2" vid="JOB 40:2">አነ ፆሳራ ሞተትያ ኡራይ እያዉ ዛሮ” ያግስ።<verse eid="JOB 40:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOB 40:3"/>ሄሳፈ ጉየ፥ እዮብ ዛሪድ፥ ሀይሳዳ ያግስ፤<verse eid="JOB 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 40:4"/>“ጎዳዉ፥ ታኒ ፓና ላፋ አስ፤</para>
  <para style="q2" vid="JOB 40:4">ታ ዶና ቦላ ኩሸ ዎዳ ስእ ጋናፐ አትሽን፥</para>
  <para style="q2" vid="JOB 40:4">ነዉ አይ ዛሮ እማናዉ ዳንዳእያና?<verse eid="JOB 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 40:5"/>ታኒ እስ ቶሆ ኦዳስ፤ ሽን ታዉ ዛርያባይ ባዋ፤</para>
  <para style="q2" vid="JOB 40:5">ናምአን ኦዳስ ሀራ ጉጅከ” ያግስ።<verse eid="JOB 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 40:6"/>ሄሳፈ ጉየ፥ ጎዳይ ጎተ ግዶን ግድድ እዮባኮ ሀይሳዳ ያግስ።<verse eid="JOB 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 40:7"/>አደዳ ነ ፄሳ ዳንጫዳ ደንዳዳ፥</para>
  <para style="q2" vid="JOB 40:7">ታ ኦይሻስ ዛሮ እማ።<verse eid="JOB 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 40:8"/>ነ ታና ባላ አስ ከሳና ሀናዬ?</para>
  <para style="q2" vid="JOB 40:8">ነዉ ፅሎ ግዳናዉ ታና ዎርዳንቾ ከሳዬ?<verse eid="JOB 40:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 40:9"/>ፆሳ ዎልቃ መላ ዎልቅ ነዉ ደኢ?</para>
  <para style="q2" vid="JOB 40:9">ፆሳይ ጉመይሳዳ ነ ጉማናዉ ዳንዳአይ?<verse eid="JOB 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 40:10"/>ሄሳ ግድኮ፥ ነ ቦንቹዋነ ግታተ ማአ፤</para>
  <para style="q2" vid="JOB 40:10">ነ ዎልቃነ ቴሙዋ ግፃ።<verse eid="JOB 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 40:11"/>ነ ሀንቁዋ ጉሳ፤</para>
  <para style="q2" vid="JOB 40:11">አነ ኦቶራንቾታ ፄላዳ ካዉሻ።<verse eid="JOB 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 40:12"/>አነ ሎይ ፄላዳ ኦቶርትያ ኡባ ዬላያ፤</para>
  <para style="q2" vid="JOB 40:12">ኢታታ ኡባ ኤንቲ ደእያ በሳፈ ይሳ።<verse eid="JOB 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 40:13"/>ኤንታ ኡባ ቢታን ሞጋ፤</para>
  <para style="q2" vid="JOB 40:13">ዱፎን የጋዳ ኤንታ ቦላ ጎርዳ።<verse eid="JOB 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 40:14"/>ሄ ዎደ ነ ዎልቃይ ነና አሻናዉ ዳንዳኤይሳ</para>
  <para style="q2" vid="JOB 40:14">ታ ማርካታና።<verse eid="JOB 40:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 40:15"/>ታኒ ነና መዳዳ መዳ ብሄሞታ ጌተትያ ዶአ በአ፤</para>
  <para style="q2" vid="JOB 40:15">እ ቦራዳ ማታ ሜስ።<verse eid="JOB 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 40:16"/>እያ ፄሳን ደእያ ዎልቃይነ</para>
  <para style="q2" vid="JOB 40:16">እያ ኡሉዋ ካምዳ ሻያ ምኖተይ ዳሮ።<verse eid="JOB 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 40:17"/>እያ ጎይናይ ዝጋዳ ቦላን ቃፄስ፤</para>
  <para style="q2" vid="JOB 40:17">እያ ገዳ ፃጶት ምኖን ዶቀትዶሶና።<verse eid="JOB 40:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 40:18"/>እያ መቀይ ናሰ ብራታ መላ፤</para>
  <para style="q2" vid="JOB 40:18">እያ ገዳይ ብራታ ኩረ መላ።<verse eid="JOB 40:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 40:19"/>ፆሳይ መዳ መታ ኡባ ጋርሳን እ አስ፤</para>
  <para style="q2" vid="JOB 40:19">ታፐ አትሽን፥ ሀር እያ ፆናናዉ ዳንዳኤይ ባዋ።<verse eid="JOB 40:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 40:20"/>ዶእ ጉፕያ ደረይ፥</para>
  <para style="q2" vid="JOB 40:20">እያዉ ምያባ ዶልሴስ።<verse eid="JOB 40:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 40:21"/>ም ኩያ ጋርሳን ዝንኤስ፤</para>
  <para style="q2" vid="JOB 40:21">ጫረን ማቃ ግዶን ቆሰቴስ።<verse eid="JOB 40:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 40:22"/>ምት ባንታ ኩያን እያ ገንሶና፤</para>
  <para style="q2" vid="JOB 40:22">ሻፋ ጋፃን ድጭያ ምት እያ ካሞሶና።<verse eid="JOB 40:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 40:23"/>ሻፋይ ክፅድ ጎገይ ዎደ ዳጋመና፤</para>
  <para style="q2" vid="JOB 40:23">ዮርዳኖሰ ሻፋይ ቆ ጋካናዉ ኩምኮካ እ ህርገና።<verse eid="JOB 40:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 40:24"/>እያ አይፍያ ቶይስድ፥ እያ ኦይካናዉ ዳንዳእያ አስ ደኢ?</para>
  <para style="q2" vid="JOB 40:24">እያ ሲያ ሉክድ ኦይካናዉ ዳንዳኤይ ኦኔ?<verse eid="JOB 40:24"/></para>
  <chapter eid="JOB 40"/>
  <chapter number="41" style="c" sid="JOB 41"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 41:1"/>“ኔኒ ሌዋታነ ጌተትያ አባ ዶኣ ማንፃቆን ኦይካናዉ፥</para>
  <para style="q2" vid="JOB 41:1">ዎይኮ እያ እንፃርሳ ዎዶሮን አንጫፋናዉ ዳንዳአይ?<verse eid="JOB 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 41:2"/>እያ ሲያ ሉካዳ ዳፎ አናዉ ዳንዳአይ?</para>
  <para style="q2" vid="JOB 41:2">ዎይኮ እያ ጋጩዋ ዎስፐን ሉካናዉ ዳንዳአይ?<verse eid="JOB 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 41:3"/>እ ነና፥ ‘ሀያና ታና አጋርክ’ ያግድ ዎሲ?</para>
  <para style="q2" vid="JOB 41:3">ዎይኮ ነዉ ማልኦ ቃላ ኦዲ?<verse eid="JOB 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 41:4"/>ነ እያ መርናዉ አይለ ኦዳ ሃራና መላ፥</para>
  <para style="q2" vid="JOB 41:4">እ ነዉ ኤሮ ግድ ጫቃኔ?<verse eid="JOB 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 41:5"/>አስ ካፎ ሎህሰይሳዳ ነ እያ ሎህሳናዉ ዳንዳአይ?</para>
  <para style="q2" vid="JOB 41:5">ዎይኮ እያ ቃቻዳ ነ ማጫ ናይታራ ካአና መላ ኦኔ?<verse eid="JOB 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 41:6"/>ሞሎ ዛልአንቾት እያ ጋትያ ቦላ ፓላሞና?</para>
  <para style="q2" vid="JOB 41:6">ዎይኮ እያ ቃንፀረድ ባይዞና?<verse eid="JOB 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 41:7"/>ኔኒ እያ ጋልባ ቶራን፥</para>
  <para style="q2" vid="JOB 41:7">ዎይኮ እያ ሁጵያ ማሻን ጫዳናዉ ዳንዳአይ?<verse eid="JOB 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 41:8"/>አነ እያ ነ ኩሸን ቦቻ፤</para>
  <para style="q2" vid="JOB 41:8">ነ እያራ ቡተትዳ ቡትያ ዶጋካ፤</para>
  <para style="q2" vid="JOB 41:8">ናምአን እያራ ቡተታናዉ ቆፓካ።<verse eid="JOB 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 41:9"/>ሄ ዶኣ ኦይካናዉ ፓጨይ መላ ዋየ፤</para>
  <para style="q2" vid="JOB 41:9">ሀር አቶሽን እያ በእዳ ኡባይ ያሻን ኮኮሬስ።<verse eid="JOB 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 41:10"/>እ ዝንእዳ በሳፈ እያ ደንናዉ ኦንካ ፃለና፤</para>
  <para style="q2" vid="JOB 41:10">ያትን፥ ታ ስንን ኤቃናዉ ዳንዳኤይ ኦኔ?<verse eid="JOB 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 41:11"/>ታ እያዉ ዛራና መላ ኮይሮ ታዉ ታልእዳይ ኦኔ?</para>
  <para style="q2" vid="JOB 41:11">ሳሎፐ ጋርሳን ደእያባ ኡባይ ታባ።<verse eid="JOB 41:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 41:12"/>“ታኒ ሌዋታነ ቶሆታባ፥ እያ ግታ ዎልቃባነ</para>
  <para style="q2" vid="JOB 41:12">ሎእያ እያ አሳተባ ቆንጭሶና አግከ።<verse eid="JOB 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 41:13"/>እያ ጋልባ ቃራናዉ ዳንዳኤይ ኦኔ?</para>
  <para style="q2" vid="JOB 41:13">እያ ጋጩዋ ፖቅድ ብፃላ ባርሳናይ ኦኔ?<verse eid="JOB 41:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 41:14"/>ያሽያ አቻይ ደእያ</para>
  <para style="q2" vid="JOB 41:14">እያ ጋጩዋ ፖቃናዉ ዳንዳኤይ ኦኔ?<verse eid="JOB 41:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 41:15"/>እያ ዞኮ ጋልባይ እሶይ እሱዋ ቦላ ዶረትድ፤</para>
  <para style="q2" vid="JOB 41:15">ሹቻዳ ምንዳ ጎንዳለ ዳኔስ።<verse eid="JOB 41:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 41:16"/>ኤንቲ እሶይ እሱዋስ ዳሮ ማታትዳ ግሾ፥</para>
  <para style="q2" vid="JOB 41:16">ኤንታ ግዶራ ሀር አቶሽን ጫርኮይ ካንናዉ ዳንዳኤና።<verse eid="JOB 41:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 41:17"/>እሶይ እሱዋራ ጋሄትድ ደእያ ግሾ፥</para>
  <para style="q2" vid="JOB 41:17">ኤንታ አይብካ ሻከና።<verse eid="JOB 41:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 41:18"/>እ ሀሽያ ዎደ ፖኦይ ፖልኡ ጌስ፤</para>
  <para style="q2" vid="JOB 41:18">እያ አይፈት ዎንታ ፃልቀዳ ጫዴስ።<verse eid="JOB 41:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 41:19"/>እያ ዶናፐ ታማ ላጮይ ከዬስ፤</para>
  <para style="q2" vid="JOB 41:19">ፕንፅያ ታም በንቴስ።<verse eid="JOB 41:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 41:20"/>እያ ሲያፐ ጩያይ፥</para>
  <para style="q2" vid="JOB 41:20">ታማ ቦላ ደእያ ኦቶፐ ከያ ፐንቶ መላ።<verse eid="JOB 41:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 41:21"/>እያ ሲራ ከያ ሸምፖይ ከንችከሎ ቦንቅሴስ፤</para>
  <para style="q2" vid="JOB 41:21">ታማ ላጮይ እያ ዶናፐ ከዬስ።<verse eid="JOB 41:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 41:22"/>እያ ሞርግያን ዎልቃይ ደእያ ግሾ፥</para>
  <para style="q2" vid="JOB 41:22">እ ዳሮ ያሼስ።<verse eid="JOB 41:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 41:23"/>እያ አሾይ እስፈ ኦይከትድ ደእያ ግሾ፥</para>
  <para style="q2" vid="JOB 41:23">እያ አሳተይ ብራታዳ ምኔስ።<verse eid="JOB 41:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 41:24"/>እያ ዎዛናይ ሹቻዳ ምኖ፤</para>
  <para style="q2" vid="JOB 41:24">ጋቻ ዎፃ መላ ምኖ።<verse eid="JOB 41:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 41:25"/>እ ደንድያ ዎደ ምኖት ያዮሶና፤</para>
  <para style="q2" vid="JOB 41:25">ዳጋምድ ባቃቶሶና።<verse eid="JOB 41:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 41:26"/>እያ ጋክያ ማሻይ አይኮካ ኦና፤</para>
  <para style="q2" vid="JOB 41:26">ቶር ዎይኮ ዶንገይ ዎይኮ ማሽ እያ ቆሄና።<verse eid="JOB 41:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 41:27"/>እ ብራታ ፅንቃ ማታዳ፥</para>
  <para style="q2" vid="JOB 41:27">ናሰ ብራታ ዎቅዳ ምዳ መንረስ።<verse eid="JOB 41:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 41:28"/>ዶንገይ እያ በትሰና፤</para>
  <para style="q2" vid="JOB 41:28">ያምባርሻ ሹች እያዉ ሱላ መላ።<verse eid="JOB 41:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 41:29"/>ጉምባ ፃምእ እያዉ ፅንቆ መላ፤</para>
  <para style="q2" vid="JOB 41:29">ቶራ ፆንግያ ዎደ ቀልቅስድ ሚጬስ።<verse eid="JOB 41:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 41:30"/>እያ ኡሉዋ ቦላ ደእያ ጋልባይ መቅዳ ኩንአ መላ ቃራ፤</para>
  <para style="q2" vid="JOB 41:30">ኡርቃራ እ ብያ ዎደ ማራሻ መላ ቢታ ጳልቄስ።<verse eid="JOB 41:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 41:31"/>አባ ፐንትዳ ሃ መላ ቱምቡል ቱምቡል ኦስ፤</para>
  <para style="q2" vid="JOB 41:31">ፃሮን ፐንትያ ዛይተ መላ ሽር ሽር የጌስ።<verse eid="JOB 41:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 41:32"/>እያ ብያ ኦገይ ፖኤስ፤</para>
  <para style="q2" vid="JOB 41:32">አባ ሃ ጎፖንቶ ላሜስ።<verse eid="JOB 41:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 41:33"/>እ ያሽ ኤሮና ግሾ፥</para>
  <para style="q2" vid="JOB 41:33">ቢታ ቦላ እያ መላ መተ ሀር ባዋ።<verse eid="JOB 41:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 41:34"/>እ ዳሮ ግታ መተታ ኡባ ካስ፤</para>
  <para style="q2" vid="JOB 41:34">ዶአ ኡባስ እ ካዎ” ያግስ።<verse eid="JOB 41:34"/></para>
  <chapter eid="JOB 41"/>
  <chapter number="42" style="c" sid="JOB 42"/>
  <para style="s1">እዮባ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 42:1"/>ሄሳፈ ጉየ፥ እዮብ ጎዳኮ ሀይሳዳ ያግድ ዛርስ፤<verse eid="JOB 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 42:2"/>“ነ ኡባባ ኦናዉ ዳንዳኤይሳነ</para>
  <para style="q2" vid="JOB 42:2">ነ ቆፋ ተቃናዉ ዳንዳኤይ ባይናይሳ ታኒ ኤራስ።<verse eid="JOB 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 42:3"/>ነ፥ ‘ኤር ባይና ታ ዞርያ ቆሰይ ኦኔ?’ ያጋዳ ታና ኦይቻዳሳ፤</para>
  <para style="q2" vid="JOB 42:3">ቱማ ታኒ ታዉ ገልቦናባ፥</para>
  <para style="q2" vid="JOB 42:3">ታ ኤራፐ ቦላ ግድዳ ማላልስያባ ኦደታስ።<verse eid="JOB 42:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 42:4"/>“ኔኒ ታኮ፥ ‘ታኒ ኦድያ ዎደ ሀይዛ፤</para>
  <para style="q2" vid="JOB 42:4">ታኒ ኦይችያ ዎደ ዛራ’ ያጋዳሳ።<verse eid="JOB 42:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 42:5"/>ታኒ ካሰ ነባ ሀይን ስአስ፤</para>
  <para style="q2" vid="JOB 42:5">ሽን ሀእ ታ ነና አይፈን በአስ።<verse eid="JOB 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 42:6"/>ሄሳ ግሾ፥ ታ ኦዳን የላታዳ፥</para>
  <para style="q2" vid="JOB 42:6">ብዶ ቦላነ ባና ቦላ ኡታዳ ፓፃይስ” ያግስ።<verse eid="JOB 42:6"/></para>
  <para style="s1">ኩሻ ሃሳያ</para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 42:7"/>ጎዳይ ሄሳ እዮባስ ኦድዳፐ ጉየ፥ ተማናፐ ይዳ ኤልፋዛኮ ሀይሳዳ ያግስ። “ታ አይልያ እዮባዳ ህንተ ታባ ልከ ኦደትቦና ግሾ፥ ነ ቦላነ ነ ናምኡ ላገታ ቦላ ታ ሀንቆይ ኤፅስ። <verse eid="JOB 42:7"/><verse number="8" style="v" sid="JOB 42:8"/>ሄሳ ግሾ፥ ሀእ ላፑን ኮርማታነ ላፑን ማራዘታ ኤክድ ታ አይልያ እዮባኮ ብድ፥ ፁሳ ያርሾ ህንተ ባላስ ያርሽተ። ታ አይልያ እዮብ ህንተዉ ዎሳና፤ ታኒ እያ ዎሳ ስአዳ ህንተ ሀኑዋ መላ ህንተና ሴርከ። ህንተ ታ አይልያ እዮባዳ ታባ ልከ ኦድበከታ” ያግስ።<verse eid="JOB 42:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 42:9"/>ሄሳፈ ጉየ፥ ተማናፐ ይዳ ኤልፋዝ፥ ሹሀፐ ይዳ በልዳዶስነ ናእማፐ ይዳ ሶፋር ብድ፥ ጎዳይ ኤንታ ኪትዳይሳዳ ኦዶሶና። ጎዳይ እዮባ ዎሳ ስእስ።<verse eid="JOB 42:9"/></para>
  <para style="s1">እዮብ ዳኮ ዎይተትስ</para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 42:10"/>እዮብ ባ ላገታስ ዎስዳፐ ጉየ፥ ጎዳይ እያ ዛሪድ ዱረይስ፤ እያዉ ካሰይሳ ግሾ ናምኡ ኩሸ እሚስ። <verse eid="JOB 42:10"/><verse number="11" style="v" sid="JOB 42:11"/>ሄሳፈ ጉየ፥ እያ እሻት፥ እያ ምቸትነ ካሰ እያ ኤረይሳት ኡባይ እያኮ ይድ፥ እያ ሶን እያራ ግብራ ምዶሶና። እያዉ አዛንዶሶና፤ ጎዳይ እያ ቦላ ኤህዳ መቶ ኡባን እያ ምንዶሶና፤ ቃስ እያዉ ብራነ ዎርቃ ሳጋዮ እምዶሶና።<verse eid="JOB 42:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 42:12"/>ጎዳይ እዮባ ዉርሰ ላይ ኮይሮ ላይፈ አድ አንጅስ። እዮባስ ታማነ ኦይዱ ሙኩሉ ዶርሳት፥ ኡሱፑን ሙኩሉ ግማለት፥ እስ ሙኩሉ ዋፃ ቦራትነ እስ ሙኩሉ ማጫ ሀረት ደኦሶና። <verse eid="JOB 42:12"/><verse number="13" style="v" sid="JOB 42:13"/>ቃስ እያዉ ላፑን አደ ናይታነ ሄ ማጫ ናይት የለትዶሶና። <verse eid="JOB 42:13"/><verse number="14" style="v" sid="JOB 42:14"/>ባይራ ማጫ ናእዉ ይምሞ፥ ናምአንዉ ቃፅኦ፥ ሄንዉ ቀረንሀፉኮ ያግድ ሱንስ። <verse eid="JOB 42:14"/><verse number="15" style="v" sid="JOB 42:15"/>እዮባ ማጫ ናይታዳ ማላ ሎኦ ማጫ ናእ አዉ ቢታን በንትቤና። ኤንታ አዋ ኤንታዉ ኤንታ እሻታራ ላታ ቢታ እሚስ።<verse eid="JOB 42:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 42:16"/>ሄሳፈ ስምን፥ እዮብ ፄታነ ኦይታሙ ላይ ደእስ። ባ ናይታነ ባ ናይታ ናይታ ኦይዳን የለተ ጋካናዉ በእስ። <verse eid="JOB 42:16"/><verse number="17" style="v" sid="JOB 42:17"/>እዮብ ዳሮ ዎደ ደእድ፥ ሎኦ ጭማ ጭምድ ሀይቅስ።<verse eid="JOB 42:17"/></para>
  <chapter eid="JOB 42"/>
</usx>
