<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JON" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ዮናሳ ማፃፋ</para>
  <para style="toc1">ዮናሳ ማፃፋ</para>
  <para style="toc3">ዮና</para>
  <para style="toc2">ዮናሳ</para>
  <para style="mt">ዮናሳ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ዮናሳ ማፃፋይ፥ ሀራ ናበ ማፃፋታፐ ዱማ ማፃፋ። ሀ ማፃፋይ፥ ዮናስ ፆሳ ኪታ እፃስ ግዳይሳነ ጉየፐ ኪተትዳ ታርከ ኦዴስፐ አትሽን፥ ስንራ ያናባ ኦደና።</para>
  <para style="ip">ዮናስ እስራኤለስ ማታ ሞርከ ግድዳ አሶረ ዋና ካታማ ናናወ ኪታ ኤክድ ባና መላ ፆሲ ኪትስ። ሽን ዮናስ ሄ ደርያስ ማርካትድ ስምን፥ ፆሳይ ሄ ካታማ ማራናይሳ ኤርያ ግሾ፥ ባናዉ ኮይቤና። ሀኖሽን፥ ዱማ ዱማ ሀኖታታፐ ጉየ፥ ዎልቃን ያ ብስ። ዮናስ ኪተትድ ስምን ናናወ አሳይ ባንታ ናጋራ ፓፅድ ጎዳኮ ስምዶሶና። ጎዳይ ኤንታ ማርስ።</para>
  <para style="ip">ሀ ማፃፋን፥ ዉርሰ ሸምፑዋን ፆሳይ ዮናሳ ታማርሳናዉ ናገቶናባ ኦድ ታማርስዳይሳ በሴስ። ዉርሰን፥ ጎዳስ ባ መተ ቦላ ግታ ማት ደኤይሳ፥ እ ማርያ ፆሲ ግደይሳነ ሀር አቶሽን፥ ባ አሳ ሞርከታካ ማርያ ፆሲ ግደይሳ ቆንጭሴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ዮናስ ፆሳፈ ባቃታናዉ ደንድስ (<char style="ior"><ref loc="JON 1:1-7">1:1-7</ref></char>)</para>
  <para style="io1">ዮናሳ ዎሳ (<char style="ior"><ref loc="JON 2:1-10">2:1-10</ref></char>)</para>
  <para style="io1">ናናወ አሳይ ፆሳኮ ስሙዋ (<char style="ior"><ref loc="JON 3:1-10">3:1-10</ref></char>)</para>
  <para style="io1">ፆሳ ማሮታነ ዮናሳ ይሉዋ (<char style="ior"><ref loc="JON 4:1-11">4:1-11</ref></char>)</para>
  <chapter number="1" style="c" sid="JON 1"/>
  <para style="s1">ዮናስ ፆሳፈ ባቃቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1"/>ጎዳ ቃላይ አማተ ናኣ፥ ዮናሳስ ሀይሳዳ ያግድ ቆንጭስ። <verse eid="JON 1:1"/><verse number="2" style="v" sid="JON 1:2"/>“ሄ ካታማ አሳ ኢታተይ ታ ስን ጋክዳ ግሾ፥ ደንዳዳ ህን ዎልቃማ ካታማ ናናወ ባዳ ሳባካ” ያግስ። <verse eid="JON 1:2"/><verse number="3" style="v" sid="JON 1:3"/>ሽን ዮናስ ጎዳ ስንፈ በትድ ታርሰሳ ቢታ ባናዉ ከይስ። እ፥ ዮጰ ካታማ ዎድ ታርሰሳ ብያ ማርካበ ደምስ። ጎዳ ስንፈ በታናዉ ኮይድ ታርሰሳ ባናዉ ኮሽያ ሚሸ ጭግድ ማርካብያን ገልስ። <verse eid="JON 1:3"/><verse number="4" style="v" sid="JON 1:4"/>ሽን ጎዳይ አባ ቦላ ዎልቃማ ጫርኩዋ ደንስ። አባን ዎልቃማ ሆበይ ዎልቃምዳ ግሾ ማርካብያ መቃናዉ ጋካሱ። <verse eid="JON 1:4"/><verse number="5" style="v" sid="JON 1:5"/>ያትን ማርካብያ ኦሳንቾት ያይዶሶና። እሶይ እሶይ ባ ፆሳኮ ባ ፆሳኮ ዋስስ። ቃስ ማርካበይ ካዉያና መላ ግዶን ደእያ ጫና ደንድ አባን የግዶሶና። ሽን ዮናስ ማርካብያስ ግዶ ገልድ ዎልቃማ ስኮ ስክስ። <verse eid="JON 1:5"/><verse number="6" style="v" sid="JON 1:6"/>ማርካብያ ላገይስ እያኮ ሺቅድ፥ “ሀይሳ መላ ሳተን ዋና ስካይ? ደንዳ ነ ፆሳ ዎሳ! ኦን ኤር እ ኑስ ቃትድ ኑና አሻነኮነ” ያግስ።<verse eid="JON 1:6"/></para>
  <para style="s1">ዮናስ አባን የገትስ</para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7"/>ማርካብያ ኦሳንቾት እሶይ እሱዋኮ፥ “ሃ ዪተ፥ ሀ ኢታባይ ኑና ኦደ ጋሶን ጋክዳኮ ኤራናዉ ሳማ የጋና” ያግዶሶና። ሳማ የግን፥ ሳማይ ዮናሳ ቦላ ዎስ። <verse eid="JON 1:7"/><verse number="8" style="v" sid="JON 1:8"/>ኤንቲ ዮናሳኮ፥ “ሀ ኢታባይ ኦደ ጋሶን ኑ ቦላ ጋክዳኮ አነ ኑስ ኦዳ። ነ ኦሶይ አይቤ? አዉፐ ያዲ? ነ ቢታይ አዌ? ኔኒ ኦደ ባጌ?” ያግድ ኦይችዶሶና። <verse eid="JON 1:8"/><verse number="9" style="v" sid="JON 1:9"/>ዮናስ ዛሪድ፥ “ታኒ እብራወ አስ፤ አባነ ቢታ መዳ ጎዳ፥ ሳሎ ፆሳ ጎይንያ አስ” ያግስ። <verse eid="JON 1:9"/><verse number="10" style="v" sid="JON 1:10"/>እ ኤንታዉ ኮይሮትድ ኦድዳይሳዳ እ ጎዳ ስንፈ በተይሳ ኤርዶሶና። ሄሳ ግሾ፥ ኤንቲ ያይድ፥ “ላ አይባ ፓላባ ኦድ” ያግዶሶና። <verse eid="JON 1:10"/><verse number="11" style="v" sid="JON 1:11"/>አባ ሆበይ ካሰይሳፈ ሃ ዳርዳ ግሾ አሳት ዮናሳ፥ “ኑስ አባይ ስእ ጋና መላ ነና ኑኒ ዋትኖ?” ያግድ ኦይችዶሶና። <verse eid="JON 1:11"/><verse number="12" style="v" sid="JON 1:12"/>እካ፥ “ሀ ዎልቃማ ሆበይ ህንተ ቦላ ደንድዳይ ታ ጋሶን ግደይሳ ታኒ ኤራይስ። ሄሳ ግሾ፥ ታና ኤክድ አባን የግተ። ያትኮ አባይ ህንተዉ ስእ ጋና” ያግስ። <verse eid="JON 1:12"/><verse number="13" style="v" sid="JON 1:13"/>ሽን ማርካብያ ኦሳንቾት ማርካብያ ጋፃ ከሳናዉ ግታ ፕዶሶና። ሽን አባ ሆበይ ሃ ዳርዳ ግሾ ጋፃ ከሳናዉ ዳንዳእቦኮና። <verse eid="JON 1:13"/><verse number="14" style="v" sid="JON 1:14"/>ሄሳ ግሾ፥ ኤንቲ ጎዳኮ፥ “አቤት ጎዳዉ፥ ሃ ኡራ ሸምፑዋ ግሾ፥ ኔኒ ኑና ይሶናዳነ ሀ ጌሻ ሱ አጩዋ ኔኒ ኑፐ አቾናዳ ኑኒ ነና ምንድ ዎሶስ” ያግድ ጎዳ ዎስዶሶና። <verse eid="JON 1:14"/><verse number="15" style="v" sid="JON 1:15"/>ሄሳፈ ጉየ፥ ዮናሳ ደንድ፥ አባን የግዶሶና። አባ ሆባይካ ስእ ግስ። <verse eid="JON 1:15"/><verse number="16" style="v" sid="JON 1:16"/>ያትን አሳት ጎዳስ ዳሮ ያይድ ያርሾ ያርሽዶሶና፤ እያዉ ቃንግዶሶና። <verse eid="JON 1:16"/><verse number="17" style="v" sid="JON 1:17"/>ዮናሳ ምታና መላ እስ ግታ ሞሎ ጎዳይ ጊግስስ። ዮናስ ሄ ሞሉዋ ኡሎን ሄ ጋላስነ ሄ ቃማ ጋምእስ።<verse eid="JON 1:17"/></para>
  <chapter eid="JON 1"/>
  <chapter number="2" style="c" sid="JON 2"/>
  <para style="s1">ዮናሳ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1"/>ዮናስ ሞሉዋ ኡሎን ደእሸ፥ ባ ጎዳ ፆሳ ሀይሳዳ ያግድ ዎስስ።<verse eid="JON 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JON 2:2"/>“ታኒ ታ ዋያን ደአሸ ነና ፄጋስ፤</para>
  <para style="q2" vid="JON 2:2">ነካ ታዉ ስአዳሳ።</para>
  <para style="q1" vid="JON 2:2">ታኒ ስኦለ ጪሙዋ ግዶን ደአሸ፥</para>
  <para style="q2" vid="JON 2:2">ማዶ ኮያዳ ኔኮ ዋሳስ</para>
  <para style="q2" vid="JON 2:2">ነካ ታ ዋሱዋ ስአዳሳ።<verse eid="JON 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3"/>ኔኒ ታና አባ ጪሙዋን ዱገ የጋዳሳ።</para>
  <para style="q2" vid="JON 2:3">ሃ ታ ዩሹዋ ተቅስ፤</para>
  <para style="q2" vid="JON 2:3">ዎልቃማ ዙለይ ታ ቦላራ አስ።<verse eid="JON 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4"/>‘ታኒ ነ ስንፈ ዎራ ሆለታስ፥</para>
  <para style="q2" vid="JON 2:4">ሽን ነ ጌሻ ኬ ዛራዳ በአና’ ጋዳ ቆፓስ።<verse eid="JON 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5"/>ሃ ታዉ ቆ ጋክስ፥</para>
  <para style="q2" vid="JON 2:5">አባ ጪሞይ ታና ምትስ።</para>
  <para style="q2" vid="JON 2:5">አባን ደእያ ማታይ ታ ሁጰን ፃፀትስ።<verse eid="JON 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6"/>ታኒ ሃ ጋርሳን ደእያ ደረታ ባሱዋ ጋካዳ ምተታስ፥</para>
  <para style="q2" vid="JON 2:6">ቢታ ዉላይ መርናዉ ታ ቦላ ጎርደትስ፥</para>
  <para style="q2" vid="JON 2:6">ሽን ታ ጎዳዉ ፆሳዉ፥ ኔኒ ታ ሸምፕዉ ኢታ ኦላፈ ከሳዳሳ።<verse eid="JON 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7"/>ታ ሸምፕያ ዶጭዳ ዎደ፥</para>
  <para style="q2" vid="JON 2:7">ጎዳዉ ታ ነና ቆፓስ፤</para>
  <para style="q2" vid="JON 2:7">ታ ዎሳይ ኔኮ ነ ጌሻ ኬ ጋክስ።<verse eid="JON 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8"/>ሀዳ ግድዳ ኤቃ ፆሳታ ቦላ ዘምፐይሳት፥</para>
  <para style="q2" vid="JON 2:8">ነዉ ደእያ ባንታ አማነተ አጎሶና።<verse eid="JON 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9"/>ሽን ታኒ ጋላታ ማዝሙረ ነዉ ያርሻና።</para>
  <para style="q2" vid="JON 2:9">ታ ቃንግዳባካ ነዉ ጋና።</para>
  <para style="q2" vid="JON 2:9">አይስ ጊኮ፥ አቶተይ ፆሳፈ” ያግስ።<verse eid="JON 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10"/>ሄሳፈ ጉየ፥ ጎዳይ ሞሉዋ ኪትስ። ሞሎይ ዮናሳ መላ ቢታ ቦላ ጮይስ።<verse eid="JON 2:10"/></para>
  <chapter eid="JON 2"/>
  <chapter number="3" style="c" sid="JON 3"/>
  <para style="s1">ዮናስ ናናወ ቡሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1"/>ጎዳ ቃላይ ናምአን ዮናሳኮ ሀይሳዳ ያግድ ይስ። <verse eid="JON 3:1"/><verse number="2" style="v" sid="JON 3:2"/>“ደንዳዳ ግታ ካታማ ናናወ ባ፤ ታ ነዉ ኦድያ ቃላ ኤንታዉ አዋጃ” ያግስ።<verse eid="JON 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3"/>ዮናስ ጎዳስ ኪተትድ ናናወ ብስ። ናናወይ ዳሮ ግታ ካታማ። ሀ ጋፃፐ ህን ጋፃ ጋካናዉ ሄ ቃማ ሄመስ። <verse eid="JON 3:3"/><verse number="4" style="v" sid="JON 3:4"/>ዮናስ ካታማ ገልድ እስ ጋላሳ ኦገ ሄመትድ፥ “ናናወይ ኦይታሙ<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">እብራወ ዶናን ፃፈትዳይሳን ኦይታሙ ግያ ዎደ ሀራ ካሰ ብርሸት ሄ ጎሶና።</char></note> ጋላሳፐ ጉየ ያና” ያግድ አዋጅስ።<verse eid="JON 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5"/>ናናወ አሳይ ፆሳ አማንዶሶና። ፆማ አዋጅዶሶና፤ ጉፈ ግታ ጋካናዉ አስ ኡባይ ካዮ ማኦ ማእዶሶና።<verse eid="JON 3:5"/></para>
  <para style="s1">ናናወ አሳይ ጎዳኮ ስሙዋ</para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6"/>ናናወ ካዎይ ሄ ኦዳ ስእዳ ዎደ ባ ካዎተ አራታፐ ዎድ፥ ካዎተ ማኡዋ ቃርድ ካዮ ማኦ ማእድ ብዶ ቦላ ኡትስ። <verse eid="JON 3:6"/><verse number="7" style="v" sid="JON 3:7"/>ናናወ ደርያስ ሀይሳዳ ያግድ አዋጅስስ፦ “ካዋፐነ እያ ሞርናታፐ ከይዳ ኪታዳ ሀችፈ ዶምድ ህንተራነ ህንተ መሄታራ፥ አይብባካ ሞና መላ ኡዮና መላ። <verse eid="JON 3:7"/><verse number="8" style="v" sid="JON 3:8"/>አስነ መሄ ኡባይ ካዮ ማኦ ማኦ። እስ እስ አስ ምንድ ፆሳኮ ዋሶ። ባ ኢታ ኦግያፐ ስሞ፥ ባ ኢታ ኦሱዋካ አጎ። <verse eid="JON 3:8"/><verse number="9" style="v" sid="JON 3:9"/>ፆሳይ ኑስ ቃትድ፥ ኑኒ ዮና መላ ባ ዎልቃማ ሀንቁዋፈ ስማነኮ ኦን ኤር!” ያግስ።<verse eid="JON 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10"/>ኤንቲ ባንታ ኢታ ኦግያፐ ስምዳይሳ ፆሳይ በእዳ ዎደ ኤንታዉ ቃትድ ኤንታ ቦላ ኤሀና ግዳ ኢታባ አጋግስ።<verse eid="JON 3:10"/></para>
  <chapter eid="JON 3"/>
  <chapter number="4" style="c" sid="JON 4"/>
  <para style="s1">ዮናሳ ይሎነ ጎዳ ማሮታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1"/>ሽን ሄስ ዮናሳ ዳሮ ኡፋይስቤና። ሄሳ ግሾ፥ እ ይሎትስ። <verse eid="JON 4:1"/><verse number="2" style="v" sid="JON 4:2"/>ጎዳኮ፥ “አቤት ጎዳዉ ታኒ ኮይሮ ታ ቢታን ደአሸ ግዳይስ ሀይሳ ግደኔ? ታኒ ነ ስንፈ በታዳ ታርሰሳ ባናዉ ኤለስዳይ ሀይሳሳ። ኔኒ ቃይነ ማሮት ኩምዳ ፆሲ ግደይሳ፥ ሀንቆስ ኤለሶናይሳነ ዉሮና ሲቆን ኩምዳይሳ፥ ቃስ ኤሀና ግዳ ኢታባካ ቃታዳ አግያ ፆሲ ግደይሳ ታኒ ካሰካ ኤራይስ። <verse eid="JON 4:2"/><verse number="3" style="v" sid="JON 4:3"/>ሀእ አቤት ጎዳዉ፥ ሀያና ታና ዎ፤ ደኦፐ ታዉ ሀይቆይ ሎኦ” ያግድ ዎስስ።<verse eid="JON 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4"/>ጎዳይ እያኮ፥ “ኔኒ ሀይሳ ሸነታናዉ በሲ?” ያግስ።<verse eid="JON 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5"/>ሄሳፈ ጉየ፥ ዮናስ ካታማፐ ጋፃ ከይድ ዶሎሀ ባጋን ኡትስ። ሄሳን ባዉ ሻቃራ ሻቃርድ እ ኩያን ኡትድ ካታማ ቦላ ጋካናዉ ደእያባ ባአናዉ ናጌስ። <verse eid="JON 4:5"/><verse number="6" style="v" sid="JON 4:6"/>አዋ ሱላፐ ዮናሳ አሻና መላ ጎዳይ እስ ጎሰ ዶልስስ። ሄ ጎሰ ሀይይ ዮናሳ ሁጰ ቦላ ባጋራ ኩያ ግዳና መላ ኦስ። ዮናስ ሄ ጎሰ ጋሶን ዳሮ ኡፋይትስ። <verse eid="JON 4:6"/><verse number="7" style="v" sid="JON 4:7"/>ሽን ዎንተ ጋላስ ዎንታ ጉራ ፆሳይ ጉፁነ ጊግስስ። ሄ ጉፁንያ ጎሰይ መላና ጋካናዉ ማሱ። <verse eid="JON 4:7"/><verse number="8" style="v" sid="JON 4:8"/>አዋይ ከይያ ዎደ ፆሳይ ዶሎሀ ባጋፈ ምሻ ጫርኮ የድስ። ዮናስ ላባናና ጋካናዉ አዋይ ዮናሳ ሁጵያ ፁግስ። ያትን እ፥ “ደኦፐ ታዉ ሀይቆይ ሎኦ” ያግድ ሀይቆስ ዎስስ።<verse eid="JON 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9"/>ፆሳይ ዮናሳኮ፥ “ኔኒ ሀ ጎሰ ግሾ ይሎታናዉ በሲ?” ያግስ።</para>
  <para style="p" vid="JON 4:9">ዮናስ፥ “ኤ በሴስ፤ ኡባራካ ሀይቃና ጋካናዉ ይሎታናዉ ታዉ በሴስ” ያግስ።<verse eid="JON 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10"/>ያትን ፆሳይ ዮናሳኮ፥ “ዝነ ዶላዳ ሀች መልዳ ጎሴስ፥ ነ ዳቡሮናርስ፥ ነ ድቾናርስ ሀይሳ መላ ቃታዳሳ። <verse eid="JON 4:10"/><verse number="11" style="v" sid="JON 4:11"/>ሽን ኡሻችነ ሀድርስ ሻክድ ኤሮና ፄታነ ላታሙ ሙኩሉ አስነ ዳሮ መሄይ ደእያ ሀ ግታ ካታማ ናናወስ ታኒ ቃታናዉ በሰኔ?” ያግስ።<verse eid="JON 4:11"/></para>
  <chapter eid="JON 4"/>
</usx>
