<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- GOOFA FULL BOBLE</book>
  <para style="h">ትቶ ኪታ</para>
  <para style="toc1">ትቶ ኪታ</para>
  <para style="toc3">ትቶ</para>
  <para style="toc2">ትቶ</para>
  <para style="mt1">ጳዉሎስ ትቶስ</para>
  <para style="mt2">ፃፍዳ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ትቶይ አይሁደ ግዶና አስ፥ ሽን ጉየፐ አማንድ፥ ጳዉሎስ ዎንገላ ኦሶ ኦያ ዎደ ማታን እያ ማድዳ አስ። ሄ ዎደ ትቶይ፥ ዎሳ ኬ ፄላናዉነ ናጋናዉ ቃርፄሳ ዎሳ ኬን አትስ። ሀ ኪታይ ሄ አይፈ ቆፋታ ኦይኬስ።</para>
  <para style="ipi">1. ዎሳ ኬ አይስያ አሳይ፥ ኢታ ዱሱ ደእያ ቃርፄሳ አሳ ማታን አይ መላ ሎኦ ዱሱ ዳናዉ ኮሽያኮ ትቶ አኬክሴስ።</para>
  <para style="ipi">2. ዎሳ ኬ ግዶን ደእያ ዱማ ዱማ ጩጋታ፥ ሄስካ፥ ጭማ አሳታ፥ ዶን አደታነ አይለታ ዋት ታማርሳናዉ በሲያኮ ትቶ ዞሬስ።</para>
  <para style="ipi">3. አማንያ አስ አማኖን ዋንድ ዳነኮ፥ ሄስካ፥ ሳሮተንነ ሲቆን ዳናባ፥ ዎሳ ኬ ግዶፈ ኦሽ፥ ፓላማነ ሻሄተ ድጋናባ ትቶስ ዞረ እሜስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ገሎ ቆፋ (<char style="ior"><ref loc="TIT 1:1-4">1:1-4</ref></char>)</para>
  <para style="io1">ዎሳ ኬ ካለያ አሳስ እመትዳ ኪታ (<char style="ior"><ref loc="TIT 1:5-16">1:5-16</ref></char>)</para>
  <para style="io1">ዱማ ዱማ ጩጋታ እመትዳ ዞረ (<char style="ior"><ref loc="TIT 2:1-3:11">2:1—3:11</ref></char>)</para>
  <para style="io1">ዞረነ ሳሮ (<char style="ior"><ref loc="TIT 3:12-15">3:12-15</ref></char>)</para>
  <chapter number="1" style="c" sid="TIT 1"/>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1"/>የሱስ ክርስቶሳ ሀዋረይነ ፆሳ አይለይ፥ ጳዉሎስ፥ ፃፍዳ ዳብዳብያ። ፆሳይ ዶርዳ አሳ አማኑዋ ድቻናዳነ ቱማ አያና ደኡዋ ዋንድ ዳነኮ በሲያ ቱማ ኤራኮ ኤንታ ካለናዉ ታኒ ኪተታስ። <verse eid="TIT 1:1"/><verse number="2" style="v" sid="TIT 1:2"/>ሄ አማኖይነ ኤራተይ መርና ደኡዋ ኡፋይሳ ቦላ ዘምፕስ። ሄሳ ዳሮ ዎደፐ ስን ዎርዶቶና ፆሳይ ኑስ እማና ግድ ቃላ ገልስ። <verse eid="TIT 1:2"/><verse number="3" style="v" sid="TIT 1:3"/>ኑና አሽያ ፆሳይ ባ ዎደን ሀ ኪታ ኦዳና መላ ታዉ ሀዳራ እሚስ።<verse eid="TIT 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4"/>ኑ ኮ አማኑዋን ታ ቱማ ናኣ ግድዳ ትቶ፥</para>
  <para style="p" vid="TIT 1:4">ፆሳ አዋፐነ ኑና አሽያ የሱስ ክርስቶሳፐ አ ኬሀተይ፥ ማሮተይነ ሳሮተይ ነዉ ግዶ።<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2CO 8:23">2 ቆሮ 8:23</ref>፤ <ref loc="GAL 2:3">ጋላ 2:3</ref>፤ <ref loc="2TI 4:10">2 ፅሞ 4:10</ref>.</char></note><verse eid="TIT 1:4"/></para>
  <para style="s1">ትቶይ ቃርፄሳን</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5"/>ታኒ ነና ቃርፄሳን አጋዳ ይዳይ፥ ኔኒ አትዳባ ጊግሳናዳነ ታኒ ኪትዳይሳዳ ካታማ ኡባን ዎሳ ኬ ጭማታ ዶራና መላሳ። <verse eid="TIT 1:5"/><verse number="6" style="v" sid="TIT 1:6"/>ጭም ቦረቶናይሳ፥ እስ ማቸ አዝና፥ ማራ ዮን ዎይኮ ኪተተ እፆን አስ ቦሮና አማንያ ናይት ደእያ አስ ግዳናዉ በሴስ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="1TI 3:2-7">1 ፅሞ 3:2-7</ref>.</char></note> <verse eid="TIT 1:6"/><verse number="7" style="v" sid="TIT 1:7"/>ዎሳ ኬ ጭም ፆሳ ኦሱዋ ሀዳራ ኤክዳ ግሾ፥ ቦረቶናይሳ፥ ኦቶርቶናይሳ፥ ኤለ ይሎቶናይሳ፥ ማቶናይሳ፥ ኦዳ መናይሳነ በሶና ጎአስ ዳፈቶናይሳ ግዳናዉ በሴስ። <verse eid="TIT 1:7"/><verse number="8" style="v" sid="TIT 1:8"/>ሽን እማ ሞከይሳ፥ ሎኦባ ኡባ ዶሰይሳ፥ አኬካንቾ፥ ፅሎ፥ ጌሽነ ባና ሃረይሳ ግዳናዉ በሴስ። <verse eid="TIT 1:8"/><verse number="9" style="v" sid="TIT 1:9"/>ሀራታ ሱረ ትምርትያን ምንናዉነ ሄ ትምርትያ እፀይሳታ ዛራናዉ ባ ታማርዳ ቱማ ቃላን ምንድ ኤቃናዉ በሴስ።<verse eid="TIT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10"/>ኪተቶናይሳት፥ ፓና ኦዳ ኦደተይሳት፥ ጭመይሳት ኡባካ ቃፃረተ ዎጋ ናግያ ዳሮ አሳት ደኦሶና። <verse eid="TIT 1:10"/><verse number="11" style="v" sid="TIT 1:11"/>ኤንቲ በሶና ኦገን ሚሸ ደማናዉ ኮይድ፥ ታማርሳናዉ በሶናባ ታማርስሸ ኬ አሳ ኡባ ኢስያ ግሾ ኤንታ ትምርትያ ተቃናዉ በሴስ። <verse eid="TIT 1:11"/><verse number="12" style="v" sid="TIT 1:12"/>ኤንታ ናበታፐ እሶይ፥ “ቃርፄሳ አሳይ ኡባ ዎደ ዎርዶ ኦደቶሶና፤ ኢታ ዶአታነ አዛላ ያራምባታ”<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fk" closed="false">ቃርፄሳ አሳይ ኡባ ዎደ ዎርዶ ኦደቶሶና፤ ኢታ ዶአታነ አዛላ ያራምባታ፦ </char><char style="ft" closed="false">ሄሳ ያግድ ኦድዳ ናበይ ኤጵመንዴሳ ጌተቴስ።</char></note> ያግስ። <verse eid="TIT 1:12"/><verse number="13" style="v" sid="TIT 1:13"/>ሀ ማርካተይ ቱማ ማርካተ። ሄሳ ግሾ፥ ኤንታዉ ቱማ አማኖይ ዳና መላ ኤንታ ሀንቀታ። <verse eid="TIT 1:13"/><verse number="14" style="v" sid="TIT 1:14"/>ቱማ እፅያ አሳ ትምርትያነ አይሁደታ ፓና ቶስያ ስኦና መላ ኤንታ ሴራ። <verse eid="TIT 1:14"/><verse number="15" style="v" sid="TIT 1:15"/>ባንታዉ ጌሽ ግድዳይሳታስ ኡባይ ጌሽ፥ ሽን ቱናታስነ አማኖናይሳታስ ኤንታ ቆፋይነ ካሀይ ቱንዳ ግሾ፥ ኤንታዉ አይብካ ጌሽ ግደና። <verse eid="TIT 1:15"/><verse number="16" style="v" sid="TIT 1:16"/>ኤንቲ ኑ ፆሳ ኤሮስ ጎሶና፥ ሽን ባንታ ኦሱዋን እያ ካዶሶና። ኤንቲ ፆሳን እፀትዳይሳታ፥ ኪተቶናይሳታነ ሎኦ ኦሶ ኡባስ ግዶናይሳታ።<verse eid="TIT 1:16"/></para>
  <para style="b"/>
  <chapter eid="TIT 1"/>
  <chapter number="2" style="c" sid="TIT 2"/>
  <para style="s1">ዱማ ዱማ ኪታ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1"/>ሽን ኔኒ ሱረ ትምርትያ ጳልቆና ትምርተ ታማርሳናዉ በሴስ። <verse eid="TIT 2:1"/><verse number="2" style="v" sid="TIT 2:2"/>ጭማ አደት ባንታና ሃረይሳታ፥ ዎፑ ግዳይሳታ፥ ቦንቸትዳይሳታ፥ አማኖን፥ ሲቆንነ ዳንዳአን፥ ምኖ ግዳና መላ ዞራ። <verse eid="TIT 2:2"/><verse number="3" style="v" sid="TIT 2:3"/>ሄሳዳካ፥ ጭማ ማጫሳይ ባንታ ዱሳን ጌሻታ፥ ዝግሮናይሳታ፥ ዎይነ ኡሻን ሃረቶናይሳታነ ሎኦባ ታማርሰይሳታ ግዳና መላ ታማርሳ። <verse eid="TIT 2:3"/><verse number="4" style="v" sid="TIT 2:4"/>ኤንቲ ሄሳዳ ሀንኮ ያላጋ ማጫሳይ ባንታ አዝናታነ ባንታ ናይታ ሲቃና መላ ታማርሳናዉ ዳንዳኦሶና። <verse eid="TIT 2:4"/><verse number="5" style="v" sid="TIT 2:5"/>ፆሳ ቃላይ ቦረቶና መላ ባንታና ሃረይሳታ፥ ጌሻታ፥ ባንታ ሶን ኦይሳታ፥ ኬሀታነ ባንታ አዝናታስ ኪተተይሳታ ግዳና መላ ያላጋ ማጫሳ ታማርሶና።<verse eid="TIT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6"/>ሄሳዳካ፥ ዶን አደት ባንታና ሃራና መላ ዞራ። <verse eid="TIT 2:6"/><verse number="7" style="v" sid="TIT 2:7"/>ኔኒ ነ ሁጰን ሎኦ ኦሶ ኡባን ኤንታዉ ሌምሶ ግዳ። ኔኒ ነ ትምርትያን ኤቅዳይሳነ አማነትዳይሳ ግዳ። <verse eid="TIT 2:7"/><verse number="8" style="v" sid="TIT 2:8"/>ኑ ሞርከት ኑና ዝግራናዉ ጋሶያባይ ኤንታዉ ይን ኤንቲ ዬላታና መላ ኔኒ ቦረቶና ሎኦ ኦዳ ኦዴታ።<verse eid="TIT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9"/>አይለት ኡባባን ባንታ ጎዳታስ ኪተታና መላ ኤንታ ኡፋይሳና መላነ ኤንታራ ፓላሞና መላ ዞራ። <verse eid="TIT 2:9"/><verse number="10" style="v" sid="TIT 2:10"/>ኤንቲ ባንታ ጎዳታፐ ካይሶቶፖ። ሄስካ፥ ኑና አሽያ ፆሳ ትምርተይ፥ ኡባ ኦገን ዶሰትዳይሳ ግዳና መላ ባንታ ኦያ ኦሱዋን አማነተይሳታ ግደይሳ በሳና መላ ኤንታ ዞራ።<verse eid="TIT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11"/>አሰ አሽያ ፆሳ አ ኬሀተይ አሳ ኡባስ ቆንጭስ። <verse eid="TIT 2:11"/><verse number="12" style="v" sid="TIT 2:12"/>ሄ አ ኬሀተይ፥ ኑ ናጋራነ ሀ አላምያ አሙዋ አግድ፥ ሀ ዎድያን ኑና ሃርድ፥ ቱማ አያና ደኡዋንነ ፅሎተን ዳና መላ ኑና ታማርሴስ። <verse eid="TIT 2:12"/><verse number="13" style="v" sid="TIT 2:13"/>ኑኒ አንጀትዳ ኡፋይሳ ግድዳ ግታ ፆሳነ ኑና አሽያ የሱስ ክርስቶሳ ቦንቾ ቆንጨ ናጎስ። <verse eid="TIT 2:13"/><verse number="14" style="v" sid="TIT 2:14"/>ኢታ ኦሶ ኡባፈ ኑና ዎዛናዉነ ሎኦባ ኦናዉ አሞትያ ባ ጌሻ አስ ከሳናዉ ኑ ግሾ ባና አድ እሚስ።<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="PSA 130:8">ማዝ 130:8</ref>፤ <ref loc="EXO 19:5">ከሳ 19:5</ref>፤ <ref loc="DEU 4:20">ዛረ 4:20</ref>፤ <ref loc="DEU 7:6">7:6</ref>፤ <ref loc="DEU 14:2">14:2</ref>፤ <ref loc="1PE 2:9">1 ጰፅ 2:9</ref>.</char></note><verse eid="TIT 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15"/>ኔኒ ሀይሳ ታማርሳ፤ ኩመ ማታን ዞራ፥ ሴራ፤ ኦንካ ነና ካፖ።<verse eid="TIT 2:15"/></para>
  <chapter eid="TIT 2"/>
  <chapter number="3" style="c" sid="TIT 3"/>
  <para style="s1">ጎእያ ኦሶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1"/>አሳይ ደርያ ሃረይሳታስ፥ አዋተይ ደኤይሳታስ ሃረታናዉ፥ ኪተታናዉነ ሎኦ ኦሶ ኡባ ኦናዉ ጊገትዳይሳታ ግዳና መላ አኬክሳ። <verse eid="TIT 3:1"/><verse number="2" style="v" sid="TIT 3:2"/>ቃስ ኤንቲ ኦደ ቦላካ ኢታ ኦደቶና መላ፥ ሳሮ አስ ግዳና መላ፥ አሽከታነ አሳ ኡባስ ቃተይሳታ ግዳና መላ ዞራ። <verse eid="TIT 3:2"/><verse number="3" style="v" sid="TIT 3:3"/>ኑኒ ካሰ ኤያታ፥ ኪተቶናይሳታ፥ ባለትዳይሳታ፥ ዱማ ዱማ አሾ ኡፋይሳስነ አሞስ አይለትዳይሳታ። ኑኒ ኢታተንነ ቃናተን ኩምዳይሳታ፤ ኑ አሰ እፀይሳታ፥ አስካ ኑና እፀይሳታ። <verse eid="TIT 3:3"/><verse number="4" style="v" sid="TIT 3:4"/>ሽን አሽያ ፆሳ ኬሀተይነ ሲቆይ ቆንጭዳ ዎደ፥ <verse eid="TIT 3:4"/><verse number="5" style="v" sid="TIT 3:5"/>ኑ ኦዳ ፅሎ ኦሱዋ ግሾ ግዶናሽን፥ ባ ማሮተ ግሾ ኑና አሽስ። ኑና እ አሽዳይ፥ ናምአን የለተ ሜቻንነ ጌሻ አያና ባጋራ እምዳ ኦራ ደኡዋና። <verse eid="TIT 3:5"/><verse number="6" style="v" sid="TIT 3:6"/>ሄ አያና፥ ፆሳይ ኑና አሽያ የሱስ ክርስቶሳ ባጋራ ኑ ቦላ ዳርስድ ጉስስ። <verse eid="TIT 3:6"/><verse number="7" style="v" sid="TIT 3:7"/>ባ አ ኬሀተ ባጋራ ኑና ፅልስድ መርና ደኡዋ ላታ ኡፋይሳ ኦይካና መላ ሄሳ ኦስ። <verse eid="TIT 3:7"/><verse number="8" style="v" sid="TIT 3:8"/>ሀ ቃላይ አማነትዳ ቃላ። ፆሳ አማነይሳት ሎኦ ኦሶ ኦናዉ ጊግዳይሳታ ግዳና መላ ነ ሀ ቃላ ምንዳ ኦዳና መላ ታ ኮያይስ። ሀይሳቲ አሰ ኡባስ ሎኦነ ጎኤይሳታ። <verse eid="TIT 3:8"/><verse number="9" style="v" sid="TIT 3:9"/>ሽን ኤያተ ፓላማፐ፥ ኮቻ ታይቦፐ፥ ካቻፈነ ህገ ጋሶን ደንድያ ኦሻፈ ናገታ። ሄስ ጎእነ ዎይ ባይናባ። <verse eid="TIT 3:9"/><verse number="10" style="v" sid="TIT 3:10"/>ሻሄተ መያ ኡራ ኮይሮ ዞራ፤ ናምአን ሀንቀታ፥ ሄሳፈ ጉየ፥ እያፐ ሃካ። <verse eid="TIT 3:10"/><verse number="11" style="v" sid="TIT 3:11"/>ሄሳ መላ አስ ጌላነ ናጋራንቾ፤ እ ባ ቦላ ፕርደይሳ ኤራ።<verse eid="TIT 3:11"/></para>
  <para style="s1">ዉርሰ ዞረ</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12"/>ታኒ ባልጎ ያን ሻጫናዉ ቆፕዳ ግሾ፥ አርፀማሳ ዎይኮ ትክቆሳ ኔኮ ኪትያ ዎደ ነ ታኮ ንቆጵልዮና ያናዉ ምና።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሀዋ 20:4</ref>፤ <ref loc="EPH 6:21-22">ኤፈ 6:21-22</ref>፤ <ref loc="COL 4:7-8">ቆላ 4:7-8</ref>፤ <ref loc="2TI 4:12">2 ፅሞ 4:12</ref>.</char></note> <verse eid="TIT 3:12"/><verse number="13" style="v" sid="TIT 3:13"/>ህገ ኤርያ ዜማስነ አጵሎስ ኦገ ብያ ዎደ ኤንታዉ ኮሽያባይ ፓጮና መላ ኤንታ ማዳ። <verse eid="TIT 3:13"/><verse number="14" style="v" sid="TIT 3:14"/>ኑ አሳይካ ፓና አስ ግድድ አቶና መላ ባንታዉ ኮሽያባ ደማና መላ ሎኦ ኦሶ ኦናዉ ምንድ ታማሮ።<verse eid="TIT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15"/>ታራ ደእያ ኡባይ ነና ሳሮ ጎሶና፤ አማኖን ኑና ሲቅያ አሳ ሳሮ ጋ።</para>
  <para style="p" vid="TIT 3:15">ፆሳ አ ኬሀተይ ህንተ ኡባራ ግዶ። አምንእ።<verse eid="TIT 3:15"/></para>
  <chapter eid="TIT 3"/>
</usx>
