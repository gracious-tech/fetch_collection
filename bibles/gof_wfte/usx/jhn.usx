<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ዮሃንሳ ዎንገላ</para>
  <para style="toc1">ዮሃንሳ ዎንገላ</para>
  <para style="toc3">ዮሀ</para>
  <para style="toc2">ዮሃንሳ</para>
  <para style="mt1">ዮሃንስ ፃፍዳ</para>
  <para style="mt2">የሱስ ክርስቶሳ ዎንገላ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ዮሃንስ የሱሳ፥ “አሰ ግድድ አሳ ግዶን በንትዳ ፆሳ ቃላ” ያግድ ቆንጭሴስ። ሀ ዎንገላይ ፃፈትዳይ፥ ማፃፋ ናባብያ ኦንካ የሱሲ አሰ አሻናዉ ያና ጌተትዳ ፆሳ ናአ ግደይሳ አማናና መላነ እያ አማነይሳታስ መርና ደኦይ ደኤይሳ ኤንቲ ኤራና መላሳ (<char style="xt"><ref loc="JHN 20:31">20:31</ref></char>)።</para>
  <para style="ip">ዎንገላስ ኮይሮ ክፍለይ መርናዉ ደእያ ፆሳ ቃላይነ የሱሲ እስኖ ግደይሳ ኦዴስ። ዮሃንሳ ዎንገላይ፥ የሱሲ አሸይሳ ግድድ ያና ግዳ ፆሳ ናአ ግደይሳ በሲያ ዱማ ዱማ ማላታታ ቆንጭሴስ። ሀ ዎንገላ ፃፈይ፥ የሱስ ክርስቶሲ ባ ሁጰን ቱማ ፆሳ ናአነ ፆሳ አዋራ እስኖ ግደይሳ (<char style="xt"><ref loc="JHN 1:1">1:1</ref></char>) ቆንጭስስ። የሱሲ ባ ሁጰን፥ “ታኒ አብራሃመፐ ካሰ ደአይስ” (<char style="xt"><ref loc="JHN 8:58">8:58</ref></char>) ያግስ። ዉርሰን ቶማስ፥ “ታ ጎዳዉ፥ ታ ፆሳዉ” ያግድ ፄግስ (<char style="xt"><ref loc="JHN 20:28">20:28</ref></char>)። ሄሳፈ ካልድ፥ ሀ ማላታታፐ በንትዳ አይፍያ ኦድያ ታርከት ካሎሶና። ሀ ክፍለይ እስ እስ አስ የሱሳ አማንድ እያ ካልያ አስ ግድዳይሳ ኦዴስ፤ ቃስ ሀራት እያራ ዋንድ ኤቀትዳኮነ ዋንድ አማኖና እፅዳኮ ኦዶሶና። ሸምፖ 13-17 ጋካናዉ የሱሲ ኦይከትዳ ኦማርስ፥ ባ ታማረታራ እያዉ አይ መላ ምኖ ጋሄተ ደእያኮ፥ ቃስ ዎንተ ጋላስ ካቀታናፐ ስን ጊገተነ ምን ቃላ ኤንታዉ ኦድዳይሳ ቆንጭሴስ። ዉርሰ ሸምፖት የሱሲ ኦይከትዳባነ ፕርዳስ ሺቅዳባ፥ እያ ካቀተ፥ እያ ደንዱዋነ ባ ታማረታስ ቆንጭዳ ቆንጨ ኦዶሶና።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ገሎ ቆፋ (<char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref></char>)</para>
  <para style="io1">ፃማቅያ ዮሃንሳነ ኮይሮ የሱሳ ታማረታ (<char style="ior"><ref loc="JHN 1:19-51">1:19-51</ref></char>)</para>
  <para style="io1">የሱሲ ቆንጨን ኦሶ ኦይክስ (<char style="ior"><ref loc="JHN 2:1-12:50">2:1—12:50</ref></char>)</para>
  <para style="io1">የሩሳላመ ሄራን አዳ ዉርሰ ሳምንታ (<char style="ior"><ref loc="JHN 13:1-19:42">13:1—19:42</ref></char>)</para>
  <para style="io1">ሀይቆፐ ደንዶነ አሳስ በንቱዋ (<char style="ior"><ref loc="JHN 20:1-31">20:1-31</ref></char>)</para>
  <para style="io1">ጋልላን ዛሪድ ባ ታማረታስ በንቱዋ (<char style="ior"><ref loc="JHN 21:1-25">21:1-25</ref></char>)</para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s1">ደኦ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>ቃላይ ኮይሮ ደኤስ። ቃላይካ ፆሳራ ደኤስ፤ ሄ ቃላይ ፆሳ። <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>ኮይሮፐ ቃላይ ፆሳራ ደኤስ። <verse eid="JHN 1:2"/><verse number="3" style="v" sid="JHN 1:3"/>ፆሳይ ኡባባ ቃላ ባጋራ መስ። መትዳባፐ እሶይካ እያ ባጋራ መቶናባይ ባዋ። <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>እያን ደኦይ ደኤስ፤ ሄ ደኦይ አሳስ ፖኦ። <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>ፖኦይ ማን ፖኤስ፤ ማይ ፖኡዋ ፆንቤና።<verse eid="JHN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>ፆሳይ ኪትዳ፥ እስ ዮሃንሳ ጌተትያ አስ ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="MAT 3:1">ማቶ 3:1</ref>፤ <ref loc="MRK 1:4">ማር 1:4</ref>፤ <ref loc="LUK 3:1-2">ሉቃ 3:1-2</ref>.</char></note> <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>አሳ ኡባይ ፖኡዋን አማናና መላ እ ፖኦስ ማርካ ግድድ ይስ። <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>እ ፖኡዋባ ማርካታናዉ ይስፐ አትሽን፥ ባ ሁጰን ፖኦ ግደና። <verse eid="JHN 1:8"/><verse number="9" style="v" sid="JHN 1:9"/>አሳ ኡባስ ፖእስያ ቱማ ፖኦይ አላምያ ዬስ።<verse eid="JHN 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10"/>ቃላይ አላመን ደእስ። ፆሳይ ቃላን አላምያ መስ፥ ሽን አላመይ እያ ኤርቤና። <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>እ ባ አሳኮ ይስ፥ ሽን እያ አሳይ እያ ኤክቦኮና። <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>ሽን እ ባና ኤክዳይሳታስነ እያ ሱንን አማንዳይሳታስ ፆሳ ናይታ ግዳና መላ ማታ እሚስ። <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>ኤንቲ ፆሳፈ የለትዶሶናፐ አትሽን፥ አስ የለትያ ዎጋን ዎይኮ አደ ሸነን ዎይኮ አሳ አሞን የለትቦኮና። ፆሳይ እ ኤንታ አዋ።<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>ቃላይ አሰ ግድስ፤ አ ኬሀተነ ቱማ ኩምድ ኑ ግዶን ደእስ። እ አዋስ እስ ናኣ ግድድ ኤክዳ እያ ቦንቹዋ ኑኒ በእዳ።<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>ዮሃንስ እያባ ማርካትስ። ባ ቃላ ቁ ኦድ፥ “ታኒ፥ ‘ታፐ ጉየራ የይስ ታፐ ካሰ ደእያ ግሾ ታፐ አስ’ ጋዳ ማርካትዳይስ ሀይሳ” ያግስ።<verse eid="JHN 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16"/>ኑኒ ኡባይ እያ አ ኬሀተ ኩመፈ አንጆ ቦላ አንጆ ኤክዳ። <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>ፆሳይ ህግያ ሙሰ ባጋራ እሚስ፥ ሽን አ ኬሀተይነ ቱማተይ የሱስ ክርስቶሳ ባጋራ ይስ። <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>ፆሳ በእዳ አስ ኦንካ ባዋ፤ ባ አዋ ማታን ደእያ እስ ናኣ ፃላል ባዉ ፆሰ ግድዳይስ እያ ቆንጭስስ።<verse eid="JHN 1:18"/></para>
  <para style="s1">ፃማቅያ ዮሃንሳ ማርካተ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ 3:1-12</ref>፤ <ref loc="MRK 1:1-8">ማር 1:1-8</ref>፤ <ref loc="LUK 3:1-8">ሉቃ 3:1-8</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>የሩሳላመን ደእያ አይሁደ ሀላቃት፥ ካህነታነ ሌወታ፥ “ኔኒ ኦኔ?” ግድ፥ ዮሃንሳ ኦይቻና መላ እያኮ ኪትን፥ ዮሃንስ ኤንታዉ ማርካትዳ ማርካተይ ሀይሳ።<verse eid="JHN 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20"/>ዮሃንስ፥ “ታኒ ክርስቶሳ ግድከ” ያግድ፥ ጌሽድ ማርካትስፐ አትሽን፥ ካድቤና።<verse eid="JHN 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21"/>ኤንቲ፥ “ያትን፥ ኔኒ ኦኔ? ኔኒ ኤልያሰዬ?” ያግድ ኦይችዶሶና።<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ምልክ 4:5</ref>፤ <ref loc="DEU 18:15-18">ዛረ 18:15-18</ref>.</char></note></para>
  <para style="p" vid="JHN 1:21">ዮሃንስ፥ “አካይ፥ ግድከ” ያግስ።</para>
  <para style="p" vid="JHN 1:21">ቃስ ኤንቲ፥ “ኔኒ ያና ጌተትዳ ናብያዬ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="JHN 1:21">ዮሃንስ፥ “አካይ” ግድ ዛርስ።<verse eid="JHN 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22"/>ያትን፥ “ኔኒ ኦኔ? ኑኒ ኑና ኪትዳይሳታስ ኦዳና መላ ኔኒ ነና ኦና ጋይ?” ያግዶሶና።<verse eid="JHN 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23"/>ዮሃንስ ዛሪድ፥ “ናብያ እሳያስ ግዳይሳዳ፥</para>
  <para style="q1" vid="JHN 1:23">“ ‘ጎዳ ኦግያ ሱርስተ!’</para>
  <para style="q2" vid="JHN 1:23">ግድ መላ ቢታን ዋስያ ኡራ ቃላይ ታና”</para>
  <para style="m" vid="JHN 1:23">ያግስ።<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 40:3">እሳ 40:3</ref>.</char></note><verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>ቃስ ፋርሳወት ኪትዳ አሳት <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>ዮሃንሳኮ፥ “ኔኒ ክርስቶሳ ዎይኮ ኤልያሳ ዎይኮ ናበ ግዶና እፅኮ፥ ያትን አይስ ፃማቃይ?” ግድ ኦይችዶሶና።<verse eid="JHN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26"/>ዮሃንስ ዛሪድ፥ “ታኒ ሃን ፃማቃይስ፥ ሽን ህንተ ኤሮና አስ ህንተ ግዶን ኤቅስ። <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>እ ታፐ ጉየራ ዬስ። ታኒ ሀር አቶሽን እያ ጫማ ዎዶሩዋ ብላናዉ በስከ” ያግስ።<verse eid="JHN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28"/>ሄስ ኡባይ ዮርዳኖሰ ሻፋፐ ሄፍንን፥ ብታነ ካታማን፥ ዮሃንስ ፃማቅያ በሳን ሀንስ።<verse eid="JHN 1:28"/></para>
  <para style="s1">የሱሲ ፆሳ ዶርሰ</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>ዮሃንስ ዎንተ ጋላስ የሱሲ ባኮ ይሽን በእድ፥ “አላምያ ናጋራ ቁችያ ፆሳ ዶርሳይ ሀይሳ! <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>ታኒ፥ ‘ታፐ ጉየራ እስ አስ ያና። እ ታፐ ካሰ ደእያ ግሾ ታፐ አስ’ ጋዳ ኦድዳይስ ሀይሳ። <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>እ ኦነኮ ታኒ ኤርከ። ሽን እስራኤለ አሳስ እያ ቆንጭሳናዉ ሃን ፃማቃሸ ያስ” ያግስ።<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>ዮሃንስ ሀይሳዳ ያግድ ማርካትስ፦ “ጌሻ አያናይ ሳሎፐ ሆለዳ ዎሽንነ እያራ ደእሽን በአስ። <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>ሄስ ሀናናፐ ካሰ ታኒ እያ ኤርከ። ሽን ሃን ፃማቃናዉ ታና ኪትዳ ፆሳይ፥ ‘ጌሻ አያናይ ዎድ እያራ ደእሽን ኔኒ በአናይስነ ጌሻ አያናን ፃማቃናይስ እያ’ ያግድ ታዉ ኦድስ። <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>ታኒ ሄስ ሀንሽን በአዳ፥ እ ፆሳ ናኣ ግድዳይሳ ማርካታይስ” ያግስ።<verse eid="JHN 1:34"/></para>
  <para style="s1">ኮይሮ የሱሳ ታማረታ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>ቃስ ዎንተ ጋላስ ዮሃንስ ባ ታማረታፐ ናምአታራ እስፈ ኤቅስ። <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>የሱሲ አሽን፥ ዮሃንስ በእድ፥ “ፆሳ ዶርሳይ ሀይስሽ!” ያግስ።<verse eid="JHN 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37"/>ዮሃንሳ ናምኡ ታማረት ዮሃንስ ገይሳ ስእድ የሱሳ ካልዶሶና። <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/>የሱሲ ባና ካለይሳታ ጉየ ስም በእድ፥ “አይ ኮዬቲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="JHN 1:38">ኤንቲ ዛሪድ፥ “አስታማርያዉ፥ ኔኒ አዉን ደአይ?” ያግዶሶና።<verse eid="JHN 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39"/>የሱሲ ኤንታኮ፥ “ሃ ይድ በእተ” ያግስ። ኤንቲ ብድ እ ደእያሱዋ በእዶሶና። ሄ ጋላስ ሳእ ታሙ ሳተ ሄራ ግድያ ግሾ እያ ማታን ፔእዶሶና።<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>ዮሃንስ ግዳይሳ ስእድ፥ የሱሳ ካልዳ ናምኡ ታማረታፐ እሶይ፥ ስሞን ጰፅሮሳ እሻ እንድርያሳ። <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>እንድርያስ ኮይሮ ባ እሻ ስሞናራ ጋሄትድ፥ “ኑኒ ክርስቶሳ ደምዳ” ያግስ። <verse eid="JHN 1:41"/><verse number="42" style="v" sid="JHN 1:42"/>እንድርያስ ስሞና የሱሳኮ ኤህስ።</para>
  <para style="p" vid="JHN 1:42">የሱሲ ስሞና በእድ፥ “ኔኒ ዮና ናኣ ስሞና፤ ነ ሱንይ ኬፋ<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="fk" closed="false">ኬፋ፦ </char><char style="ft" closed="false">ግያ ቃላይ አራምከ ዶና ግድሽን፥ ግርከ ዶናን ብርሸይ ጰፅሮሳ ዎይኮ ዛላ ጉሱ።</char></note> ግድ ፄገታና” ያግስ።<verse eid="JHN 1:42"/></para>
  <para style="s1">ፍልጶሳነ ናትናኤላ ፄገተ</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>ዎንተ ጋላስ የሱሲ ጋልላ ቢታ ባናዉ ቆፋ ቃችስ። እ ፍልጶሳራ ጋሄትድ፥ “ታና ካላ!” ያግስ። <verse eid="JHN 1:43"/><verse number="44" style="v" sid="JHN 1:44"/>ፍልጶስ፥ እንድርያስነ ጰፅሮስ ደእዳ ቤተሳይዳ ካታማፐ ይዳ አሰ።<verse eid="JHN 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 1:45"/>ፍልጶስ ናትናኤላራ ጋሄትድ፥ “ሙሰይ ህገ ማፃፋን፥ ቃስ ናበትካ እያባ ፃፍዳ ዮሰፋ ናኣ ናዝረተ የሱሳ ኑኒ ደምዳ” ያግስ።<verse eid="JHN 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46"/>ናትናኤል ዛሪድ፥ “ናዝረተ ካታማፐ ሎኦባይ ከያናዉ ዳንዳኢ?” ያግስ።</para>
  <para style="p" vid="JHN 1:46">ፍልጶስ፥ “ያዳ በአ” ያግስ።<verse eid="JHN 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47"/>ናትናኤል ባኮ የይሳ የሱሲ በእድ፥ “ገነይ ባይና ቱማ እስራኤለ አስ ሀይሳ!” ያግስ።<verse eid="JHN 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48"/>ናትናኤል የሱሳኮ፥ “ኔኒ ታና አዉን ኤራይ?” ያግስ።</para>
  <para style="p" vid="JHN 1:48">የሱሲ ዛሪድ፥ “ፍልጶስ ነና ፄጋናፐ ስን፥ ኔኒ ባላሰ ም ጋርሳን ደእሽን ታኒ ነና በአስ” ያግስ።<verse eid="JHN 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49"/>ናትናኤል ዛሪድ፥ “አስታማርያዉ፥ ኔኒ ፆሳ ናኣ! ኔኒ እስራኤለ ካዎ!” ያግስ።<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>የሱሲ እያኮ፥ “ታኒ ነና ባላሰ ም ጋርሳን በአስ ግዳ ግሾ አማናይ? ኔኒ ሀይሳፈ አያባ በአና!” ያግስ። <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>ቃስ የሱሲ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ሳሎይ ዶየትን፥ ፆሳ ኪታንቾት አሳ ናኣ ቦላ ከይሽንነ ዎሽን ህንተ በአና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">1:51 </char><char style="xt" closed="false"><ref loc="GEN 28:12">መ 28:12</ref>.</char></note><verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s1">የሱሲ ያጋኖ በሳን</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>ሄን ጋላስ ጋልላ ቢታን ቃና ካታማን ያጋኖይ ያጋነትስ። የሱሳ አይያ ሄ ያጋኑዋን ደአዉሱ። <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>የሱሲካ ባ ታማረታራ እስፈ ሄ ያጋኑዋ ፄገትስ። <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>ዎይነ ኡሻይ ዉርን፥ የሱሳ አይያ የሱሳኮ፥ “ኤንታዉ ዎይነ ኡሻይ ዉርስ” ያጋሱ።<verse eid="JHN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4"/>የሱሲ ዛሪድ፥ “ታ አየ፥ ነ ሀይሳን ገሎፓ? ታ ዎደይ ቡሮ ጋክቤና” ያግስ።<verse eid="JHN 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5"/>የሱሳ አይያ ኦሳንቾታኮ፥ “እ ህንተዉ ኦድያባ አይብባ ግድኮካ ኦተ” ያጋሱ።<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>አይሁደት ባንታ ጌሾ ዎጋስ ጎኤትያ ኡሱፑን ሹቻ ባት ሄ በሳን ደኦሶና። እስ እስ ባይ ናምኡ ዎይኮ ሄ ፁጋ ኦይኬስ። <verse eid="JHN 2:6"/><verse number="7" style="v" sid="JHN 2:7"/>የሱሲ ኦሳንቾታኮ፥ “ባታን ሃ ኩንተ” ያግስ። ኤንቲ ባታስ ዶና ጋካናዉ ሃ ኩንዶሶና። <verse eid="JHN 2:7"/><verse number="8" style="v" sid="JHN 2:8"/>የሱሲ ኤንታኮ፥ “ሀእ ዱቅድ ያጋኑዋ አዋተን ፖልሰይሳስ እምተ” ያግስ። ኤንቲ እያዉ ኤፍድ እምዶሶና።<verse eid="JHN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 2:9"/>ያጋኑዋ አዋተን ፖልሰይስ ዎይነ ኡሽ ላመትዳ ሃ ጋንፅ ኤክድ አዉፐ ይዳኮ ኤርቤና፥ ሽን ሃ ኩንዳ ኦሳንቾት ኤሮሶና። ያጋኑዋ አዋተን ፖልሰይስ ማችዉ ኤከይሳ ፄግድ፥ <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>“ኦንካ ሎኦ ዎይነ ኡሻ አሳ ኮይሮትድ ኡሼስ። ያትድ አሳይ ኡይ ካልዳፐ ጉየ፥ ቅራርያ እሜስ። ሽን ኔኒ ሎኦ ዎይነ ኡሻ ሀኖ ጋካናዉ ዎ አጋዳሳ” ያግስ።<verse eid="JHN 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11"/>የሱሲ ሀ ኮይሮ ማላታ ጋልላ ቢታን ቃና ካታማን ኦስ፤ ሄሳን ባ ግታተ በስስ። እያ ታማረት እያ አማንዶሶና።<verse eid="JHN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>ሄሳፈ ጉየ፥ የሱሲ ባ አየራ፥ ባ እሻታራነ ባ ታማረታራ እስፈ ቅፍርናሆማ ካታማ ብድ ጉ ጋላስ ጋምእስ።<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 4:13">ማቶ 4:13</ref>.</char></note><verse eid="JHN 2:12"/></para>
  <para style="s1">ፆሳ ኬፈ ዛልኤይሳታ ከስስ</para>
  <para style="r">(<ref loc="MAT 21:12-13">ማቶ 21:12-13</ref>፤ <ref loc="MRK 11:15-17">ማር 11:15-17</ref>፤ <ref loc="LUK 19:45-46">ሉቃ 19:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>አይሁደት ቦንችያ ፓስካ ባኣለ ጋላሳይ ማታትን የሱሲ የሩሳላመ ብስ።<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ከሳ 12:1-27</ref>.</char></note> <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>ብድ ፆሳ ኬን ቦራታ፥ ሚዛታ፥ ዶርሳታነ ሆለታ ባይዘይሳታነ ባንታ ኦይድያን ኡትድ ሚሸ ላመይሳታ ደምስ። <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>እ ፁርቃፈ ዶቅድ አሳ ኡባ ኤንታ መሄታራ ፆሳ ኬፈ ጎድድ ካረ ከስስ። ሚሸ ላመይሳታ ፃርጴዛታካ አ የግድ ኤንታ ሚሽያ ላልስ። <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>ሆለ ባይዘይሳታ፥ “ሀ ሆለታ ሀይሳፈ ከስተ፤ ታ አዋ ኬ ግያ ኦፍተ” ያግስ።<verse eid="JHN 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17"/>እያ ታማረት ጌሻ ማፃፋን፥ “ታኒ ነ ኬስ ምሸትያ ምሻይ ታና ታማዳ ፁጌስ” ጌተትድ ፃፈትዳይሳ አኬክዶሶና።<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="PSA 69:9">ማዝ 69:9</ref>.</char></note><verse eid="JHN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18"/>ሄሳፈ ጉየ፥ አይሁደት ዛሪድ፥ “ነ ሀይሳ ኦናዉ ነዉ ማት ደኤይሳስ ኑና አይ ማላታ ኦዳ በሳኔ?” ያግዶሶና።<verse eid="JHN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19"/>የሱሲ፥ “ሀ ፆሳ ኬ ላልተ፤ ታኒ ሄ ጋላሳን ዛራዳ ኬፃና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="MAT 26:61">ማቶ 26:61</ref>፤ <ref loc="MAT 27:40">27:40</ref>፤ <ref loc="MRK 14:58">ማር 14:58</ref>፤ <ref loc="MRK 15:29">15:29</ref>.</char></note><verse eid="JHN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20"/>ቃስካ አይሁደት፥ “ሀ ፆሳ ኬ ኬፃናዉ ኦይታማነ ኡሱፑን ላይ ኤክስ፥ ሽን ኔኒ ሄ ጋላሳን ኬፃኔ?” ያግዶሶና።<verse eid="JHN 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21"/>ሽን የሱሲ ኦድያ ፆሳ ኬይ ባ አሳተባ። <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>ሄሳ ግሾ፥ የሱሲ ሀይቆፐ ደንድዳፐ ጉየ እያ ታማረት እ ሄሳ ግዳይሳ አኬክዶሶና። ቃስ ኤንቲ ጌሻ ማፃፋን ፃፈትዳይሳነ የሱሲ ኦድዳይሳ አማንዶሶና።<verse eid="JHN 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>የሱሲ ፓስካ ቦንችያ በሳን የሩሳላመን ደእሽን፥ እ ኦዳ ማላታታ በእድ ዳሮ አሳይ እያ አማንዶሶና። <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>ሽን የሱሲ አሳ ኡባ ኤርያ ግሾ ኤንታ አማንበና። <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>አሳ ዎዛናን ደእያባ እ ባ ሁጰን ኤርያ ግሾ አሳባ ኦንካ እያዉ ኦዳና መላ ኮሽቤና።<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s1">የሱሳነ ንቆድሞሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>ፋርሳወታ ያራፐ ግድዳ፥ አይሁደታ ሀላቃይ፥ ንቆድሞሳ ጌተትያ እስ አደይ ደኤስ። <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>ንቆድሞስ ቃማ የሱሳኮ ይድ፥ “አስታማርያዉ፥ ኔኒ ፆሳይ ኪትዳ አስታማረ ግደይሳ ኑኒ ኤሮስ። አይስ ጊኮ፥ ፆሳይ እያራ ዶና እፅኮ ሀ ኔኒ ኦያ ማላታ ኦናዉ ዳንዳእያ አስ ባዋ” ያግስ።<verse eid="JHN 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3"/>የሱሲ ዛሪድ፥ “ታኒ ነዉ ቱማ ኦዳይስ፤ ኦንካ ዛር የለቶና እፅኮ ፆሳ ካዎተ በአናዉ ዳንዳኤና” ያግስ።<verse eid="JHN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4"/>ንቆድሞስ፥ “ጬጋ አስ ዋንድ ዛር የለታናዉ ዳንዳኢ? ባ አየ ኡሎ ስም ገልድ ዛር የለታናዉ ዳንዳኢ?” ያግስ።<verse eid="JHN 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5"/>የሱሲ ዛሪድ፥ “ታኒ ነዉ ቱማ ኦዳይስ፤ ኦንካ ሃፈነ ጌሻ አያናፐ የለቶና እፅኮ፥ ፆሳ ካዎተ ገላናዉ ዳንዳኤና። <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/>አሾ ናአተ አዉፐነ አይፐ ዬስ፤ ፆሳ ናአተ ጌሻ አያናፐ እመቴስ። <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/>ታኒ፥ ‘ህንተ ዛር የለታናዉ በሴስ’ ጋዳ ህንተዉ ኦድዳ ግሾ ኔኒ ማላለቶፋ። <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/>ጫርኮይ ባ ኮይዳ በሲ ጫርኬስ። ኔኒ እያ ኮሽንቻ ስአሳፐ አትሽን፥ እ አዉፐ ያኮ ዎይኮ አዉ ብያኮ ኤራካ። አያናፐ የለትዳ ኡባይ ሄሳ መላ” ያግስ።<verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>ያትን ንቆድሞስ፥ “ሄስ ዋንድ ሀናናዉ ዳንዳኢ?” ያግድ ኦይችስ።<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>የሱሲ ዛሪድ፥ “ኔኒ እስራኤለታ አስታማረ ግዳሸ ሀይሳ ኤርኪ? <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/>ታኒ ነዉ ቱማ ኦዳይስ፤ ኑ ኤርያባ ኦዶስነ በእዳባ ማርካቶስ፥ ሽን ኑ ማርካተ ህንተ ኤከከታ። <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/>ታኒ ህንተዉ ሳአባ ኦድን ህንተ አማኖናባ ግድኮ ሳሎባ ኦድን ዋትድ አማናኔ? <verse eid="JHN 3:12"/><verse number="13" style="v" sid="JHN 3:13"/>ሳሎፐ ዎዳ አሳ ናኣፐ አትሽን፥ ሳሎ ከይዳይ ኦንካ ባዋ፤ [ሳሎን ደእያ አሳ ናአይ ታና”]<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="fq" closed="false">ሳሎን ደእያ አሳ ናአይ ታና፦ </char><char style="ft" closed="false">እስ እስ በን ማፃፋት ጉጆሶና።</char></note> ያግስ።<verse eid="JHN 3:13"/></para>
  <para style="p">
    <verse number="14-15" style="v" sid="JHN 3:14-15"/>ሙሰይ መላ ቢታን ናሰ ብራታ ሾሽ ካቅዳይሳዳ ታና አማንዳ ኡባይ መርና ደኡዋ ኤካና መላ አሳ ናአይ ቁ ጋናዉ በሴስ።<note caller="-" style="x"><char style="xo" closed="false">3:14-15 </char><char style="xt" closed="false"><ref loc="NUM 21:9">ታይቦ 21:9</ref>.</char></note><verse eid="JHN 3:14-15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16"/>ፆሳ ናኣ አማንያ ኡባይ መርና ደኡዋ ላታናፐ አትሽን፥ ዮና መላ ፆሳይ ሀ አላምያ ዳሮ ዶስዳ ግሾ ባ እስ ናኣ እሚስ። <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>ፆሳይ ባ ናኣ ሀ አላምያ ኪትዳይ አላምያ ፕርዳናዉ ግዶናሽን አላምያ እያ ባጋራ አሻናሳ።<verse eid="JHN 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18"/>ናኣ አማንያ ኦንካ ፕርደተና፥ ሽን ናኣ አማኖና ኦንካ እስ ፆሳ ናኣ አማንቦና ግሾ ሀእ ፕርደትስ። <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/>ፕርዳይካ ሀይሳ፦ ፖኦይ አላምያ ይስ፥ ሽን አሳ ኦሶይ ኢታ ግድያ ግሾ አሳይ ፖኡዋፐ አድ ማ ዶሴስ። <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>ኢታባ ኦያ ኦንካ ፖኦ እፄስ። አይስ ጊኮ፥ ባ ኦሶይ ቆንጮና መላ ፖኡዋኮ ዬና። <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>ሽን ቱማ ኦያ ኦንካ ፆሳይ ኪትዳይሳዳ እ ኦዳይሳ ፖኦይ ቆንጭሳና መላ ፖኡዋኮ ዬስ።<verse eid="JHN 3:21"/></para>
  <para style="s1">ፃማቅያ ዮሃንስ የሱሳባ ማርካትስ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>ሄሳፈ ጉየ፥ የሱሲነ እያ ታማረት ይሁዳ ቢታ ብዶሶና። የሱሲ ያን ፃማቅሸ ኤንታራ ጉ ዎደ ኡትስ።<verse eid="JHN 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 3:23"/>ቃስ ዮሃንስ ሳሌማ ማታን ደእያ ሄኖና ግያ በሳን ግድያ ሃ ደእያ ግሾ አሳ ያን ፃማቄስ። አሳይካ ያ ብድ ፃማቀቶሶና። <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>ሄ ዎደ ዮሃንስ ቡሮ ቃሸትቤና።<note caller="-" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="MAT 14:3">ማቶ 14:3</ref>፤ <ref loc="MRK 6:17">ማር 6:17</ref>፤ <ref loc="LUK 3:19-20">ሉቃ 3:19-20</ref>.</char></note><verse eid="JHN 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25"/>ሄሳፈ ጉየ፥ ዮሃንሳ ታማረትነ እስ አይሁደ አደይ<note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="fq" closed="false">እስ አይሁደ አደይ፦ </char><char style="ft" closed="false">እስ እስ ማፃፋት “ጉ አይሁደ አሳት” ያጎሶና።</char></note> ጌሾ ዎጋባ ፓላምዶሶና። <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>ኤንቲ ዮሃንሳኮ ብድ፥ “አስታማርያዉ፥ ዮርዳኖሰ ሻፋፐ ሄፍንን ኔራ ደኤይስ፥ ኔኒ እያባ ማርካትዳይስ፥ ሄኮ ፃማቄስ። አሳ ኡባይካ እያኮ ቦሶና” ያግዶሶና።<verse eid="JHN 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27"/>ዮሃንስ ዛሪድ፥ “ፆሳይ እሞና አስ አይብባካ ኤካናዉ ዳንዳኤና። <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>‘ታኒ ክርስቶሳ ግድከ፥ ሽን እያፐ ስን ኪተታስ’ ግዳይሳስ ታዉ ህንተ፥ ህንተ ሁጰን ማርካ።<note caller="-" style="x"><char style="xo" closed="false">3:28 </char><char style="xt" closed="false"><ref loc="JHN 1:20">ዮሀ 1:20</ref>.</char></note> <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>ገሎስ ጊግዳራ ኤከናዉ ጊግዳይሳሳ። ኤከይሳ ላገይ እያ ማታን ኤቅድ እ ገይሳ ስእያ ዎደ ዳሮ ኡፋይቴስ። ሄሳ ግሾ፥ ሀይስ ታ ኡፋይሳይ ፖለትስ። <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>እ ግታታናዉ ታኒ ጉፃናዉ በሴስ” ያግስ።<verse eid="JHN 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>ቦላፈ የይስ ኡባፈ ቦላ። ሳአፐ በንትዳይስ ሳአባ። እ ሳአባ ኦዴስ። ሳሎፐ የይስ ኡባፈ ቦላ። <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>እ ባ በእዳባነ ስእዳባ ማርካቴስ፥ ሽን እያ ማርካተ ኤከይ ባዋ። <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>እያ ማርካተ ኤክያ ኦንካ ፆሳይ ቱማ ግደይሳ ቆንጭሴስ። <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>ፆሳይ ባ ጌሻ አያና እያዉ ኩመ እምያ ግሾ ፆሳይ ኪትዳይስ ፆሳ ቃላ ኦዴስ። <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/>አዋይ ባ ናኣ ዶስድ ኡባባ እያ ኩሸን ዎስ።<note caller="-" style="x"><char style="xo" closed="false">3:35 </char><char style="xt" closed="false"><ref loc="MAT 11:27">ማቶ 11:27</ref>፤ <ref loc="LUK 10:22">ሉቃ 10:22</ref>.</char></note> <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>ናኣ አማንያ ኡራስ መርና ደኦይ ደኤስ። ሽን ናኣ አማኖናይሳ ቦላ ፆሳ ሀንቆይ ደኤስፐ አትሽን፥ እ ደኦ ደመና።<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s1">የሱሳነ ሳማረ ማጫስዉ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>የሱሲ ዮሃንሳፐ ዳሮ ካልያ አሳ ባኮ ሺሸይሳነ ፃማቀይሳ ፋርሳወት ስእዶሶና። <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>ግድኮካ የሱሳ ታማረት ፃማቅዶሶናፐ አትሽን፥ የሱሲ ኦናካ ፃማቅቤና። <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>የሱሲ አሳይ እያባ ገይሳ ስእዳ ዎደ ይሁዳፐ ደንድድ ጋልላ ብስ። <verse eid="JHN 4:3"/><verse number="4" style="v" sid="JHN 4:4"/>እ፥ ጋልላ ብሸ ሳማረራ አናይስ አቶናባ ግድስ።<verse eid="JHN 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5"/>ሄሳ ግሾ፥ ያይቆብ ባ ናኣ ዮሰፋስ እምዳ ጋድያ ማታን ደእያ ስካረ ጌተትያ ሳማረ ካታማ ብስ።<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="GEN 33:19">መ 33:19</ref>፤ <ref loc="JOS 24:32">እያ 24:32</ref>.</char></note> <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>ሄ በሳን ያይቆባ ሃ ኦላይ ደኤስ። የሱሲ ሄመን ዳቡርድ ሄ ሃ ኦላ ማታን ኡትስ። ሄ ዎደ ሳእ ኡሱፑን ሳተ ሄራ።<verse eid="JHN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7"/>እስ ሳማረ ካታማ ማጫስ ሄ ኦላፈ ሃ ትካናዉ ያሱ። የሱሲ ሄ ማጫሴኮ፥ “ታና ሃ ኡሻርክ” ያግስ። <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>ሄ ዎደ የሱሳ ታማረት ካ ሻማናዉ ካታማ ብዶሶናሽን።<verse eid="JHN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9"/>ሄ ማጫስያ ዛራዳ፥ “ኔኒ አይሁደ አሰ ግዳሸ፥ ሳማረ ማጫስ ግድያ ታና ዋናዳ ሃ ኡሻ ጋይ?” ያጋሱ። ሄሳ እያ ግዳይ አይሁደት ሳማረታራ ጋሄቶና ግሾሳ።<note caller="-" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="EZR 4:1-5">እዝ 4:1-5</ref>፤ <ref loc="NEH 4:1-2">ናህ 4:1-2</ref>.</char></note><verse eid="JHN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10"/>የሱሲ ዛሪድ፥ “ኔኒ ፆሳ እሞታነ ሃ ታና ኡሻ ገይስ ኦነኮ ኤርዳባ ግድያኮ እያ ነ ዎሳና፤ እካ ነዉ ደኦ እምያ ሃ እማናሽን” ያግስ።<verse eid="JHN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11"/>ማጫስያ ዛራዳ፥ “ጎዳዉ፥ ነዉ ዱቅያባይ ባዋ፤ ኦላይካ ዝቃ። ያትን፥ ደኦ እምያ ሃ ነ አዉፐ ኤካኔ? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>ኑስ ሀ ሃ ኦላ እምዳ ኑ አዋ ያይቆባፐ ኔኒ አይ? እ፥ እያ ናይትነ እያ መሄይ ሀ ኦላፈ ኡይዶሶና” ያጋሱ።<verse eid="JHN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13"/>የሱሲ፥ “ሀ ሃፈ ኡይዳ ኦንካ ዛር ሳሞታና። <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/>ሽን ታኒ እማና ሃ ኡያ ኦንካ ኡባካ ሳሞተና። ታኒ እሚያ ሃይ እያ ግዶን መርና ደኦ እምያ ጎግያ ፑልቶ ግዳና” ያግስ።<verse eid="JHN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15"/>ማጫስያ ዛራዳ፥ “ጎዳዉ፥ ታኒ ሳሞቶና መላነ ሃ ትካናዉ ሀ በሳ ዮና መላ ታዉ ሄ ሃ እማ” ያጋሱ።<verse eid="JHN 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16"/>የሱሲ ኢኮ፥ “ባዳ ነ አዝና ፄጋዳ ያ” ያግስ።<verse eid="JHN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17"/>ማጫስያ ዛራዳ፥ “ታዉ አዝን ባዋ” ያጋሱ።</para>
  <para style="p" vid="JHN 4:17">የሱሲ ኢኮ፥ “ታዉ አዝን ባዋ ጋሸ ባላባካ። <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/>ነዉ ካሰ እቻሹ አዝናት ደኦሶና። ሀእ ኔራ ደእያ አደይ ነ አዝና ግደና። ኔኒ ሀእ ቱማ ኦዳዳሳ” ያግስ።<verse eid="JHN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19"/>ማጫስያ ዛራዳ፥ “ጎዳዉ፥ ኔኒ ናበ ግደይሳ ታኒ ኤራስ። <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>ኑ አዋት ሀ ዙማ ቦላ ፆሳ ጎይንዶሶና። ሽን ህንተ አይሁደት አስ ፆሳስ ጎይናናዉ በሲያ በሳይ የሩሳላመና ጌታ” ያጋሱ።<verse eid="JHN 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21"/>የሱሲ፥ “ሀ ማጫሰተ ታና አማና፤ ሀ ዙማ ቦላ ዎይኮ የሩሳላመን አዋስ ህንተ ጎይኖና ዎደይ ያና። <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/>ህንተ ሳማረት ኤሮናይሳ ጎይነታ። ሽን ኑኒ አቶተይ አይሁደፐ ያ ግሾ ኑ ኤረይሳ ጎይኖስ። <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/>ሽን አዋስ ቱማን ጎይነይሳት አያናንነ ቱማተን ጎይናና ዎደይ ማታትስ፤ ሀእካ ጋክስ። ህዛ፥ አዋይ ኮየይ ሀይሳ መላ ኦግያን ጎይነይሳታ። <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/>ፆሳይ አያና፤ እያዉ ጎይነይሳት አያናንነ ቱማተን ጎይናናዉ በሴስ” ያግስ።<verse eid="JHN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25"/>ማጫስያ ዛራዳ፥ “ክርስቶስ ያናይሳ ታኒ ኤራይስ። እ ያ ዎደ ኑስ ኡባባ ኦዳና” ያጋሱ።<verse eid="JHN 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26"/>የሱሲ፥ “ሀ ኔራ ኦደተይ ታኒ እያ” ያግስ።<verse eid="JHN 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>ኤንቲ ኦደትሽን፥ የሱሳ ታማረት ብዳ በሳፈ ስምዶሶና። የሱሲ ማጫሳራ ኦደትሽን ኤንቲ በእድ ዳሮ ማላለትዶሶና። ሽን ማጫሴኮ፥ “አይ ኮያይ?” ዎይኮ የሱሳኮ፥ “ኢራ አይስ ኦደታይ?” ግዳይ ኦንካ ባዋ።<verse eid="JHN 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28"/>ሄሳፈ ጉየ፥ ማጫስያ ባ ሃ ኦቱዋ አጋዳ ጉየ ካታማ ባዳ አሳኮ፥ <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>“ታኒ ኦዳባ ኡባ ታዉ ኦድዳ አድያ በአናዉ የተ። እ ክርስቶሳ ግዳንደሻ?” ያጋሱ። <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>አሳይ ካታማፐ ከይድ የሱሳኮ ብዶሶና።<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>ሄስ ሀንሽን፥ እያ ታማረት የሱሳኮ፥ “ጉባ ማርክ” ያግድ ዎስዶሶና።<verse eid="JHN 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32"/>ሽን እ፥ “ታዉ ህንተ ኤሮና ካ ታ መይስ ደኤስ” ያግስ።<verse eid="JHN 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33"/>ሄሳ ግሾ፥ እያ ታማረት ባንታ ግዶን፥ “እያዉ ምያባ አስ ኤሆና አገና” ያግዶሶና።<verse eid="JHN 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34"/>የሱሲ ኤንታኮ፥ “ታ ካይ ታና ኪትዳይሳ ሸንያ ኦናይሳነ እያ ኦሱዋ ፖላናይሳ። <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/>ህንተ፥ ‘ኦይዱ አጌናፐ ጉየ ካይ ጫከታና’ ጌከትዬ? ሽን ታኒ ህንተዉ ኦዳይስ፤ ካይ ካፅድ ሺሾስ ጋክዳይሳ ሎይ ፄልተ። <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/>ዘረይስነ ጫከይስ እስፈ ኡፋይታና መላ ጫከይስ ዳሞዝያ ኤኬስ ቃስ ካ መርና ደኦስ ሺሼስ። <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/>ህዛ፥ ‘እሶይ ዘሬስ፤ ሀንኮይ ቃስ ጫኬስ’ ግያ ኦዳይ ቱማ። <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/>ህንተ ዳቡርቦናይሳ ሺሻና መላ ታኒ ህንተና ኪታስ። ሀራት ኦ ዳቡርዳሱዋን ገልድ ህንተ ኤንታ ዳቡራ አይፍያ ኤክደታ” ያግስ።<verse eid="JHN 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>ማጫስያ፥ “እ፥ ታኒ ኦዳ ኡባባ ኦድስ” ጋዳ ማርካትዳ ግሾ ሄ ካታማን ደእያ ሳማረ አሳፐ ዳሮት የሱሳ አማንዶሶና። <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>ሳማረ አሳይ የሱሳኮ ይድ፥ ባንታ ማታን ጋምአና መላ የሱሳ ዎስን እ ያን ናምኡ ጋላስ ኡትስ።<verse eid="JHN 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41"/>እ ኦድያ ቃላ ግሾ ካሰይሳፈ ዳሮ አሳይ አማንዶሶና። <verse eid="JHN 4:41"/><verse number="42" style="v" sid="JHN 4:42"/>ቃስ ኤንቲ ማጫሴኮ፥ “ሀእ ኑ አማነይ ኑ ሁጰን እ ገይሳ ስእዳ ግሾሳፈ አትሽን፥ ኔኒ ማርካትዳ ግሾሳ ግደና። ቃስ እ ቱማ ሀ አላምያ አሸይሳ ግደይሳ ኑኒ ኤርዳ” ያግዶሶና።<verse eid="JHN 4:42"/></para>
  <para style="s1">እስ ሹማ ናአ ፓፁዋ</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>ናምኡ ጋላሳፐ ጉየ፥ የሱሲ ያፐ ከይድ ጋልላ ቢታ ብስ። <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/>የሱሲ ባ ሁጰን፥ “ናበይ ባ ቢታን ቦንቸተና” ያግድ ካሰትድ ኦድስ።<note caller="-" style="x"><char style="xo" closed="false">4:44 </char><char style="xt" closed="false"><ref loc="MAT 13:57">ማቶ 13:57</ref>፤ <ref loc="MRK 6:4">ማር 6:4</ref>፤ <ref loc="LUK 4:24">ሉቃ 4:24</ref>.</char></note> <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/>የሱሲ ጋልላ ጋክዳ ዎደ ጋልላ አሳይ እያ ሞክዶሶና። አይስ ጊኮ፥ ፓስካ ባኣለ ቦንችያ ጋላስ ኤንቲ የሩሳላመን ደእያ ግሾ እ ኦዳባ ኡባ በእዶሶና።<note caller="-" style="x"><char style="xo" closed="false">4:45 </char><char style="xt" closed="false"><ref loc="JHN 2:23">ዮሀ 2:23</ref>.</char></note><verse eid="JHN 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46"/>የሱሲ ሃ ዎይነ ኡሽ ላምዳ በሳ፥ ጋልላን ደእያ ቃና ካታማ ብስ። ቅፍርናሆማን ካዎ ኬን ኦያ እስ ሹማስ ናአይ ሀርገትስ።<note caller="-" style="x"><char style="xo" closed="false">4:46 </char><char style="xt" closed="false"><ref loc="JHN 2:1-11">ዮሀ 2:1-11</ref>.</char></note> <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>የሱሲ ይሁዳፐ ጋልላ ይዳይሳ ሄ ሹማይ ስእድ እያኮ ይስ። ሀይቃናዉ ማትዳ ባ ናኣ ብድ ፓና መላ የሱሳ ዎስስ።<verse eid="JHN 4:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48"/>የሱሲ ሹማኮ፥ “ፆሳይ ኦያ ማላታታነ ኦራባታ በኦና ደእሸ ህንተ ኡባራካ አማነከታ” ያግስ።<verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>ሹማይ ዛሪድ፥ “ጎዳዉ፥ ታ ናአይ ሀይቆና ደእሽን ታራ የርክ” ያግስ።<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>የሱሲ፥ “ነ ሶ ባ፤ ነ ናአይ ፓፃና” ያግስ።</para>
  <para style="p" vid="JHN 4:50">ሄ ሹማይ የሱሲ ግዳይሳ አማንድ ባ ሶ ብስ። <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>እ ባ ሶ ብሽን እያ አይለት እያኮ ይሸ እያራ ኦገን ጋሄትድ፥ “ነ ናአይ ፓፅስ” ግዶሶና።<verse eid="JHN 4:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52"/>እ ባ አይለታ ባ ናኣስ አይ ሳተን ሎእዳኮ ኦይችስ። ኤንቲ ዛሪድ፥ “ዝነ ላፑን ሳተን ምሻይ አግስ” ያግዶሶና። <verse eid="JHN 4:52"/><verse number="53" style="v" sid="JHN 4:53"/>ናኣ አዋይ የሱሲ ባኮ፥ “ነ ናአይ ፓፃና” ግዳይ ሄ ሳትያን ግደይሳ አኬክስ። ሄሳ ግሾ፥ እነ እያ ሶ አሳ ኡባይ አማንዶሶና።<verse eid="JHN 4:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54"/>ሄስ የሱሲ ይሁዳፐ ጋልላ ይድ ኦዳ ናምአን ማላታ።<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s1">ጉንዳ ኡራ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>ሄሳፈ ጉየ፥ የሱሲ አይሁደት ቦንችያ ባልያ ቦንቻናዉ የሩሳላመ ብስ። <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/>የሩሳላመን ዶርሳ ፐንግያ ማታን እብራወ ዶናን ቤተሳይዳ ግያ ተቀትዳ ሃ ደኤስ። ሄ ተቀት ኡትዳ ሃ ማታን እቻሹ ሸምፕያ በሳት ደኦሶና። <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/>[ሄሳን ሃይ ቃፃናይሳ ናግያ] ዳሮ ሀርጋንቾት፥ ቆቀት፥ ዎበትነ ጉንዳት ዝንእዶሶና። <verse eid="JHN 5:3"/><verse number="4" style="v" sid="JHN 5:4"/>[አይስ ጊኮ፥ እስ እስ ቶሆ ጎዳ ኪታንቾይ ተቀትዳ ሃን ዎድ ሃ ቃስ። ሃይ ቃፅያ ዎደ ኮይሮ ገልዳ ኡራይ ባና ኦይክዳ አይ ሀርገፈካ ፓፄስ።]<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">እስ እስ በን ማፃፋት ፓይዶ ሄስ ኮይሮ ባጋነ ፓይዶ ኦይዳ ጉጆኮና።</char></note> <verse eid="JHN 5:4"/><verse number="5" style="v" sid="JHN 5:5"/>ሄ በሳን ሀስታማነ ሆስፑን ላይ ሀርገትዳ እስ አደይ ደኤስ። <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>የሱሲ ያን ዝንእዳ አድያ በእድ፥ ቃስ ዳሮ ዎደ ሀርገትዳይሳ ኤርድ አድያኮ፥ “ፓፃናዉ ኮያይ?” ያግስ።<verse eid="JHN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7"/>ሀርጋንቾይ ዛሪድ፥ “ጎዳዉ፥ ሃይ ቃፅያ ዎደ ታና ሃን የግያ አስ ባዋ። ታኒ ገላና ሀንያ ዎደ ሀራይ ታፐ ስንትድ ገል ክቼስ” ያግስ።<verse eid="JHN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8"/>የሱሲ እያኮ፥ “ደንዳ ኤቃ፤ ነ አልጋ ቶካዳ ባ” ያግስ። <verse eid="JHN 5:8"/><verse number="9" style="v" sid="JHN 5:9"/>አደይ ኢራካ ፓፅስ፤ ባ አልጋ ቶክድ ብስ።</para>
  <para style="p" vid="JHN 5:9">ሄስ ሳምባታ ጋላሳን ሀንስ። <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>ሄሳ ግሾ፥ አይሁደት ፓፅዳ አድያኮ፥ “ሀች ሳእ ሳምባታ፤ ኔኒ ነ አልጋ ቶከይስ ዎጋ ግደና” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="NEH 13:19">ናህ 13:19</ref>፤ <ref loc="JER 17:21">ኤርም 17:21</ref>.</char></note><verse eid="JHN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11"/>ሽን አደይ፥ “ታና ፓዳይስ፥ ነ አልጋ ቶካዳ ባ ግስ” ያግድ ዛርስ።<verse eid="JHN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12"/>ኤንቲ እያኮ፥ “ነና፥ ነ አልጋ ቶካዳ ባ ግዳይ እ ኦኔ?” ያግድ ኦይችዶሶና።<verse eid="JHN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13"/>ሽን የሱሲ ሄ በሳን ዳሮ አሳ ግዶራ ኤርሶና ካንድ ብዳ ግሾ አደይ ባና ፓዳይ ኦነኮ ኤረና። <verse eid="JHN 5:13"/><verse number="14" style="v" sid="JHN 5:14"/>የሱሲ ጉየፐ ሄ አድያ ፆሳ ኬን ደምድ፥ “ሄኮ፥ ኔኒ ፓፃዳሳ፤ ሀይሳፈ ኢታባይ ነና ጋኮና መላ ዛራዳ ናጋራ ኦፋ” ያግስ። <verse eid="JHN 5:14"/><verse number="15" style="v" sid="JHN 5:15"/>ሄሳፈ ጉየ፥ አደይ ብድ ባና ፓዳይስ የሱሳ ግድዳይሳ አይሁደታስ ኦድስ።<verse eid="JHN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16"/>የሱሲ ሄሳ ሳምባታ ጋላስ ኦዳ ግሾ፥ አይሁደት የሱሳ ጎዳ ኦይክዶሶና። <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>የሱሲ ዛሪድ፥ “ታ አዋይ ኡባ ዎደ ኦስ፤ ታካ ኦናዉ በሴስ” ያግስ።<verse eid="JHN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18"/>የሱሲ ሳምባታ ቦንቾና ግሾ ፃላላስ ግዶናሽን ፆሳይ ባ አዋ ግድ ባና ፆሳራ ጊግስዳ ግሾ፥ አይሁደት እያ ዎናዉ ካሰፐ ምንድ ኮይዶሶና።<verse eid="JHN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>የሱሲ ዛሪድ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ናአይ ባርካ አይኮካ ኦናዉ ዳንዳኤና። እ ባ አዋይ ኦሽን በኦይሳ ፃላላ ኦስ። አዋይ ኦይሳ ናአይካ ኦስ። <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/>አዋይ ባ ናኣ ዶስያ ግሾ እ ኦያ ኦሶ ኡባ ባ ናኣ በሴስ። ህንተ ማላለታና መላ እ ሀይሳፈ አያ ኦሶ ባ ናኣ በሳና። <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/>አዋይ ሀይቅዳይሳታ ሀይቆፐ ደንድ ኤንታዉ ደኦ እመይሳዳ ናአይካ ባ ኮየይሳታስ ደኦ እሜስ። <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/>አዋይ ናኣስ ፕርዳ ማታ ኡባ እሚስፐ አትሽን፥ እ ኦናካ ፕርደና። <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/>አሳ ኡባይ አዋ ቦንቸይሳዳ ናኣካ ቦንቻና። ናኣ ቦንቾና ኦንካ ናኣ ኪትዳ አዋካ ቦንቸና።<verse eid="JHN 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24"/>“ታኒ ህንተዉ ቱማ ኦዳይስ፤ ታ ቃላ ስኤይሳስነ ታና ኪትዳይሳ አማነይሳስ መርና ደኦይ ደኤስ። እ ሀይቆፐ ደኦን ፕንዳ ግሾ ፕርደተና። <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ሀይቅዳ አሳይ ፆሳ ናኣ ቃላ ስእያ ዎደይ ያና፤ ሄስካ ሀእ። ሄ ቃላ ስኤይ ደኦን ዳና። <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/>አዋይ ደኦስ ፑልቶ ግድዳይሳዳ ናኣካ ደኦስ ፑልቶ ኦስ። <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/>ናአይ አሳ ናአ ግድያ ግሾ አዋይ ናኣስ ፕርዳ ማታ እሚስ።<verse eid="JHN 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28"/>“ዱፎን ደኤይሳት እያ ቃላ ስእድ ደንድያ ዎደይ ያና ግሾ ሀይሳን ማላለቶፍተ። <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/>ሎኦ ኦዳይሳት ደኦን ዳናዉ ቃስ ኢታ ኦዳይሳት ፕርዳ ኤካናዉ ዱፎፐ ደንዳና።<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳነ 12:2</ref>.</char></note><verse eid="JHN 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30"/>“ታኒ ታ ማታን አይብባካ ኦናዉ ዳንዳእከ። ፆሳይ ታዉ ኦድዳይሳዳ ፕርዳይስ። ታኒ ታና ኪትዳይስ ኮያባ ኦይስፐ አትሽን፥ ታ ኮያባ ኦና ግሾ ታ ፕርዳይ ቱማ።<verse eid="JHN 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31"/>“ታኒ ታባ ማርካትኮ ታ ማርካተይ ቱማ ግደና። <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/>ታባ ማርካትያ ሀር ደኤስ፤ እ ታባ ማርካተይስ ቱማ ግደይሳ ታኒ ኤራይስ።<verse eid="JHN 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33"/>“ህንተ ዮሃንሳኮ አሰ ኪትን እ ቱማስ ማርካትስ።<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">ዮሀ 1:19-27</ref>፤ <ref loc="JHN 3:27-30">3:27-30</ref>.</char></note> <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/>ታኒ ሄሳ ህንተዉ ኦደይ፥ ህንተ አታና መላ ጋዳፐ አትሽን፥ አሳ ማርካተ ታዉ ኮሽን ግደና። <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/>ዮሃንስ ሙቃዳዳ ኤፅሸ ፖእስ። ህንተ ጉ ዎደ እያ ፖኡዋን ኡፋይትደታ።<verse eid="JHN 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36"/>“ሽን ታዉ ዮሃንሳፐ አያ ማርክ ደኤስ። ታኒ ኦና መላ ታ አዋይ ታዉ እምዳ ኦሶት ታባ ማርካቶሶና፤ አዋይ ታና ኪትዳይሳ ቆንጭሶሶና።<verse eid="JHN 5:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 5:37"/>“ቃስ ታና ኪትዳ አዋይካ ባ ሁጰን ታባ ማርካቴስ። ህንተ እያ ቃላ ኡባራካ ስእቤከታ ዎይኮ እያ ማላ በእቤከታ።<note caller="-" style="x"><char style="xo" closed="false">5:37 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቶ 3:17</ref>፤ <ref loc="MRK 1:11">ማር 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃ 3:22</ref>.</char></note> <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/>እ ኪትዳይሳ ህንተ አማኖና ግሾ እያ ቃላይ ህንተ ዎዛናን ባዋ።<verse eid="JHN 5:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 5:39"/>“ጌሻ ማፃፋታፐ መርና ደኦ ደማናባ ህንተዉ ዳንን ኤንታ ፕልጌታ፤ ኤንቲ ታባ ማርካቶሶና። <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/>ሽን ህንተ ደኦ ደማናዉ ታኮ ያናዉ ኮየከታ።<verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>“አሳፐ ታኒ ቦንቾ ኮይከ። <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/>ሽን ታኒ ህንተ ዎዛናን ፆሳ ሲቆይ ባይናይሳ ኤራይስ። <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/>ታኒ ታ አዋ ማታን ያስ፥ ሽን ታና ሞክበከታ። ሀራይ ባ ማታን ያ ዎደ እያ ሞኬታ። <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/>ህንተ እሶይ እሱዋፈ ቦንቾ ኮየይሳት፥ እስ ፆሳፈ ያ ጋላታ ኤካናዉ ኮዮናይሳት፥ ዋንድ ታና አማናናዉ ዳንዳኤቲ?<verse eid="JHN 5:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45"/>“ታኒ ታ አዋ ስንን ህንተና ሞትያባ ህንተዉ ዳኖፖ። ህንተና ሞታናይ ህንተ ኡፋይሳን ናግያ ሙሰ። <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/>ህንተ ሙሰ አማንዳባ ግድያኮ እ ታባ ፃፍዳ ግሾ ታናካ አማናናሽን። <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/>ሽን ህንተ እ ፃፍዳይሳ አማኖና እፅኮ ታ ቃላ ዋትድ አማናኔ?” ያግስ።<verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s1">እቻሹ ሙኩሉ አሳ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ 14:13-21</ref>፤ <ref loc="MRK 6:30-44">ማር 6:30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>ሄሳፈ ጉየ፥ የሱሲ ፅብራዶሳ ጌተትያ ጋልላ አባፈ ሄፍን ፕንስ። <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>እ ሀርጋንቾታ ፓሶን ኦዳ ማላታ በእዳ ግሾ፥ ዳሮ አሳይ እያ ካልዶሶና። <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>የሱሲ ዙማ ቦላ ከይድ፥ ያን ባ ታማረታራ እስፈ ኡትስ። <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>አይሁደት ቦንችያ ፓስካ ባኣለ ጋላሳይ ጋክስ። <verse eid="JHN 6:4"/><verse number="5" style="v" sid="JHN 6:5"/>የሱሲ ዳሮ አሳይ ባኮ የይሳ በእድ ፍልጶሳኮ፥ “ሀ አሳ ኡባ ሙዛናዉ ግድያ ካ አዉፐ ሻማኔ?” ያግስ። <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>እ ሄሳ ፍልጶሳ ፓጫናዉ ግስፐ አትሽን፥ እ ባ ሁጰን አይ ኦነኮ ኤሬስ።<verse eid="JHN 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7"/>ፍልጶስ ዛሪድ የሱሳኮ፥ “ሀር አቶሽን፥ ሁጰን ሁጰን፥ እስ እስ ባርስ ጋናዉ፥ ናምኡ ፄቱ ድናረን<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="fq" closed="false">ድናረ፦ </char><char style="ft" closed="false">እስ ድናረይ እስ አስ እስ ጋላስ ኦ ፔእድ ኤክያ ሚሸ። ናምኡ ፄቱ ድናረይ እስ አስ ላይ ባጋ ኦድ ኤክያ ሚሸ ኬና። (ማቶ 20:2) ፄልተ።</char></note> ኡይ ሻምንካ ግደና” ያግስ።<verse eid="JHN 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8"/>ቃስ የሱሳ ታማረታፐ እሶይ፥ ስሞን ጰፅሮሳ እሻይ እንድርያስ፥ <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>“እቻሹ ባንጋ ኡይነ ናምኡ ሞሎ ኦይክዳ እስ ናአይ ሀይሳን ደኤስ፥ ሽን ሀ አሳ ኡባስ ሄስ አይ ማዳኔ?” ያግስ።<verse eid="JHN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10"/>የሱሲ ባ ታማረታኮ፥ “አሳ ኡትስተ” ያግስ። ሄ በሳን ዳሮ ማት ደኤስ፤ አሳ ኡባይ ኡትስ። አደ አሳ ታይቦይ እቻሹ ሙኩሉ ግዳና። <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>የሱሲ ኡይ ኤክድ ፆሳ ጋላት ስሚድ ያን ኡትዳ አሳስ ግሽስ። ሞሉዋካ ኤክድ ሄሳዳ ኦድ እምን፥ አሳይ ባ ኮይዳይሳ መላ ምስ። <verse eid="JHN 6:11"/><verse number="12" style="v" sid="JHN 6:12"/>ኤንቲ ኡባይ ካልዳፐ ጉየ፥ የሱሲ ባ ታማረታኮ፥ “እስባይካ ኢቶና መላ አትዳ ቲፍያ ሺሽተ” ያግስ። <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>ሄሳ ግሾ፥ ኤንቲ ኡባ ሺሽዶሶና። አሳይ ምን አትዳ ባንጋ ኡይ ቲፍያ ሺሽድ ታማነ ናምኡ ጋይታ ኩንዶሶና።<verse eid="JHN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14"/>አሳይ የሱሲ ኦዳ ማላታታ በእዳ ዎደ፥ “ሀይስ ቱማ ሀ አላምያ ያና ጌተትዳ ናብያ” ያግዶሶና። <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>የሱሲ ኤንቲ እያ ኦይክድ ዎልቃን ካዎ ኦናዉ ሀነይሳ ኤርድ፥ ባርካ ዙማ ቦላ ዛሪድ ከይስ።<verse eid="JHN 6:15"/></para>
  <para style="s1">የሱሲ አባ ቦላራ ሄመትስ</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቶ 14:22-33</ref>፤ <ref loc="MRK 6:45-52">ማር 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>ሳአይ ኦማርስዳ ዎደ የሱሳ ታማረት አባኮ ዎዶሶና። <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>ሳአይ ቃምዳ ግሾነ የሱሲ ቡሮ ኤንታኮ ይቦና ግሾ እያ ታማረት ዎጎሎን ገልድ አባ ፕንድ ቅፍርናሆማ ባናዉ ደንድዶሶና። <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>ዎልቃማ ጫርኮይ ጫርክዳ ግሾ አባይ ቃፄስ። <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>እቻሹ ዎይኮ ኡሱፑን ክሎ ምትረ ግደይሳ መላ ኤንቲ አባ ፕድ ብዳፐ ጉየ፥ የሱሲ አባ ቦላራ ሄመትሸ የይሳ በእድ ያይዶሶና። <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>ሽን እ፥ “ባቦፍተ፥ ታና” ያግስ። <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>ኤንቲ ኡፋይትድ እያ ዎጎሉዋን ገልስዶሶና፤ ኢራካ ዎጎሎይ ኤንቲ ብያ አባ ጋፃ ጋክስ።<verse eid="JHN 6:21"/></para>
  <para style="s1">የሱሲ ደኦ ኡይ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>ዎንተ ጋላስ አባፈ ሄፍንን አትዳ ዳሮ አሳይ እስ ዎጎሎ ፃላል ደኤይሳ በእዶሶና። የሱሲ ባ ታማረታራ ዎጎሉዋን ገልድ፥ ኤንታራ ቦናይሳነ ኤንቲ ባንታርካ ብዳይሳ አኬክዶሶና። <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>ሽን ፅብራዶሳፐ ሀራ ዎጎሎት የሱሲ ፆሳ ጋላትን፥ አሳይ ኡይ ምዳ በሳ ይዶሶና። <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>አሳይ የሱሲ ዎይኮ እያ ታማረት ያን ባይናይሳ በእድ፥ የሱሳ ኮያናዉ ዎጎሎታን ገልድ ቅፍርናሆማ ብዶሶና።<verse eid="JHN 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>አሳይ የሱሳ አባፈ ሄፍንን ደምዳ ዎደ፥ “አስታማርያዉ፥ ሃ አዉደ ያዲ?” ያግስ።<verse eid="JHN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26"/>የሱሲ ዛሪድ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተ ታና ኮየይ ኡይ ምድ ካልዳ ግሾሳፈ አትሽን፥ ማላታ በእዳ ግሾሳ ግደና። <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/>ሳምያ ካስ ኦፍተ፥ ሽን መርና ደኦ እምያ ካስ ኦተ። ፆሳ አዋይ እ ኦና መላ እያዉ ማታ እምዳ ግሾ ሄ ካ አሳ ናአይ ህንተዉ እማና” ያግስ።<verse eid="JHN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28"/>ያትን ኤንቲ፥ “ኑኒ ፆሳ ኦሱዋ ኦናዉ አይ ኦኔ?” ያግድ የሱሳ ኦይችዶሶና።<verse eid="JHN 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29"/>የሱሲ ዛሪድ፥ “ህንተ ኦና መላ ፆሳይ ኮይያ ኦሶይ ሀይሳ፦ እ ኪትዳይሳ አማንተ” ያግስ።<verse eid="JHN 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30"/>ኤንቲ ዛሪድ፥ “ኑኒ በእድ፥ ነና አማናና መላ አይ ማላታ ነ በሳኔ? ነ አይ ኦኔ? <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>ጌሻ ማፃፋን፥ ‘ኤንቲ ማና መላ ኡይ ሳሎፐ እሚስ’ ጌተትድ ፃፈትዳይሳዳ ኑ አዋት መላ ቢታን ማና ምዶሶና” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="EXO 6:4">ከሳ 6:4</ref>፥ <ref loc="EXO 6:15">15</ref>፤ <ref loc="PSA 78:24">ማዝ 78:24</ref>.</char></note><verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>የሱሲ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተዉ ሳሎፐ ቱማ ኡይ እምዳይ ታ አዋፐ አትሽን፥ ሙሰ ግደና። <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/>ህዛ፥ ፆሳይ እምያ ኡይይ ሳሎፐ ዎዳይስ አላምያስ ደኦ እመይሳ” ያግስ።<verse eid="JHN 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34"/>ኤንቲ ዛሪድ፥ “ጎዳዉ፥ ኑስ ሄ ኡይ ኡባ ዎደ እማ” ያግዶሶና።<verse eid="JHN 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35"/>የሱሲ፥ “ታኒ ደኦ እምያ ኡይ፤ ታኮ ያ ኦንካ ኡባራካ ኮሻተና። ቃስ ታና አማንያ ኡራይ ኡባራካ ሳሞተና። <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/>ሽን ታኒ ህንተዉ ኦዳስ፤ ህንተ ታና በእደታ፥ ሽን አማነከታ። <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/>ታ አዋይ ታዉ እምያ ኡባይ ታኮ ያና፤ ቃስ ታኮ ያ ኦናካ ካረ የድከ። <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/>ታኒ ታ ኮያባ ኦናዉ ግዶናሽን ታና ኪትዳይስ ኮያባ ኦናዉ ሳሎፐ ያስ። <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/>ታና ኪትዳይስ ኮየይ ሀይሳ፦ ታኒ እ ታዉ እምዳ ኡባታካ ዉርሰ ጋላስ ሀይቆፐ ደንና መላፐ አትሽን፥ እሱዋካ ይሳና መላ ኮየና። <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/>ህዛ፥ ታ አዋይ ኮየይ ሄሳ፦ ናኣ በእድ አማንያ ኡባይ መርና ደኡዋ ኤካና፤ ታኒ ሄ ኡባ ዉርሰ ጋላስ መርና ደኦስ ሀይቆፐ ደንና” ያግስ።<verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>የሱሲ፥ “ታኒ ሳሎፐ ዎዳ ኡይ” ግዳ ግሾ፥ አይሁደት እያ ቦላ ዙዙምዶሶና። <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>ኤንቲ፥ “ሀይስ ኑኒ እያ አዋነ እያ አይዉ ኤርያ ዮሰፋ ናኣ የሱሳ ግደኔ? ያትን፥ እ ዋንድ፥ ‘ታኒ ሳሎፐ ዎስ’ ጋናዉ ዳንዳኢ?” ያግዶሶና።<verse eid="JHN 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43"/>የሱሲ ዛሪድ፥ “እሶይ እሱዋራ ዙዙን አግተ። <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/>ታና ኪትዳ ታ አዋይ ታኮ ኤህያ አሳፐ አትሽን፥ ታኮ ያናዉ ዳንዳእያ ኦንካ ባዋ። ታኒ ዉርሰ ጋላስ እያ መርና ደኦስ ሀይቆፐ ደንና። <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/>ናበት፥ ‘ፆሳይ አሳ ኡባ ታማርሳና’ ያግድ ፃፍዶሶና። አዋ ስኤይስነ እያፐ ታማርያ ኦንካ ታኮ ዬስ።<note caller="-" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="ISA 54:13">እሳ 54:13</ref>.</char></note> <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/>ፆሳ ማታፐ ይዳይሳፈ አትሽን፥ አዋ በእዳይ ኦንካ ባዋ፤ እያ ፃላል አዋ በእስ።<verse eid="JHN 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 6:47"/>“ታኒ ህንተዉ ቱማ ኦዳይስ፤ ታና አማንያ ኦደስካ መርና ደኦይ ደኤስ። <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/>ታኒ ደኦ እምያ ኡይ። <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/>ህንተ አዋት መላ ቢታን ማና ምዶሶና፥ ሽን ሀይቅዶሶና። <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/>ሳሎፐ ያ ኡይይ ሀይሳ፤ ሄ ኡይ ምያ ኦንካ ሀይቀና። <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/>ሳሎፐ ይዳ ደኦ ኡይይ ታና። ኦንካ ሀ ኡይ ሚኮ መርናዉ ዳና። ቃስ ሀ አላመይ ደኦን ዳና መላ ታኒ ህንተዉ እማና ኡይይ ታ አሹዋ” ያግስ።<verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>አይሁደት፥ “ሀ አደይ ባ አሹዋ ኑ ማና መላ ኑስ ዋትድ እማናዉ ዳንዳኢ?” ያግድ ባንታ ግዶን ፓላምዶሶና።<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>ሄሳ ግሾ፥ የሱሲ ኤንታኮ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ አሳ ናኣ አሹዋ፥ ህንተ ሞና እፅኮ፥ ቃስ እያ ሱ ህንተ ኡዮና እፅኮ፥ ህንተዉ ደኦይ ባዋ። <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/>ታ አሹዋ ምያ ኡራስነ ታ ሱ ኡያ ኡራስ መርና ደኦይ ደኤስ። ታኒ ዉርሰ ጋላስ እያ ሀይቆፐ ደንና። <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/>ታ አሾይ ቱማ ካ፤ ታ ሱይካ ቱማ ኡሹ። <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/>ታ አሹዋ ምያ ኡራይነ ታ ሱ ኡያ ኡራይ ታናን ደኤስ፤ ታካ እያን ደአይስ። <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/>ደኦ አዋይ ታና ኪትን፥ ታኒ እያ ባጋራ ደኦን ደኤይሳዳ፥ ታና ምያ ኡራይካ ታ ጋሶን ደኦን ዳና። <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/>ሳሎፐ ዎዳ ኡይይ ሀይሳ፦ ህንተ አዋት ምድ ሀይቅዳ ማና መላ ግደና፤ ሀ ኡይ ምያ ኡራይ መርናዉ ዳና” ያግስ።<verse eid="JHN 6:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59"/>የሱሲ ቅፍርናሆማ ካታማን አይሁደ ዎሳ ኬን ሀይሳ ታማርስስ።<verse eid="JHN 6:59"/></para>
  <para style="s1">መርና ደኦ ቃላ</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>የሱሳ ታማረታፐ ዳርያ ባጋይ ሄሳ ስእዳ ዎደ፥ “ሀይስ ገሎና ትምርተ፤ ሀይስ ኦደስ ገሊ?” ያግዶሶና።<verse eid="JHN 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61"/>የሱሲ ባ ታማረት ሄሳስ ዙዙምዳይሳ ኤርድ፥ “ሀይስ ህንተና ቢ? <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/>ያትን፥ አሳ ናአይ ካሰ ደእያሱዋ ፑደ ከይሽን ህንተ በእድ ዎይጋንደቲ? <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/>ጌሻ አያናይ ደኦ እሜስ፤ አሳ ዎልቅ አይኮካ ማደና። ታ ህንተዉ ኦድያ ቃላይ ደኦ እምያ ጌሻ አያናፐ ዬስ። <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/>ሽን ህንተ ግዶን አማኖናይሳት ደኦሶና” ያግስ። አማኖናይሳት ኦናንተኮ የሱሲ ኮይሮፐ ዶምድ ኤሬስ። ቃስ ባና አድ እማናይ ኦነኮ ኤሬስ። <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/>ቃስካ የሱሲ፥ “አዋይ ባ ጎና ኦንካ ታኮ ያናዉ ዳንዳኤና ጋዳ ታኒ ኦድዳይ ሄሳ ግሾሳ” ያግስ።<verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>ሄሳ ጋሶን፥ የሱሳ ካለይሳታፐ ዳሮት እያ አግድ ጉየ ስምዶሶና፤ ዛር እያ ካልቦኮና። <verse eid="JHN 6:66"/><verse number="67" style="v" sid="JHN 6:67"/>የሱሲ ባ ታማነ ናምኡ ታማረታኮ፥ “ህንተካ አግድ ባናዉ ኮዬቲ?” ያግድ ኦይችስ።<verse eid="JHN 6:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68"/>ስሞን ጰፅሮስ ዛሪድ፥ “ጎዳዉ፥ ኑኒ ኦደኮ ባኔ? ነዉ መርና ደኦ እምያ ቃላይ ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">6:68 </char><char style="xt" closed="false"><ref loc="MAT 16:16">ማቶ 16:16</ref>፤ <ref loc="MRK 8:29">ማር 8:29</ref>፤ <ref loc="LUK 9:20">ሉቃ 9:20</ref>.</char></note> <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>ኔኒ ፆሳ ጌሻ ግደይሳ ኑኒ አማኖስነ ኤሮስ” ያግስ።<verse eid="JHN 6:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70"/>የሱሲ ኤንታኮ፥ “ታኒ ህንተና ታማነ ናምአታ ዶራብክና? ሽን ህንተፈ እሶይ ፃላሄ” ያግስ። <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>የሱሲ ሄሳ ግዳይ ስሞና ናኣ አስቆሮታ ይሁዳሳ። ይሁድ የሱሳ አድ እማናዉ ደእያ ታማነ ናምኡ ታማረታፐ እሱዋ።<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s1">የሱሳነ እያ እሻታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>ሄሳፈ ጉየ፥ አይሁደት የሱሳ ዎናዉ ኮይያ ግሾ እ ይሁዳ አግድ ጋልላን ስመረቴስ። <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>አይሁደት ቦንችያ ሻቃራ ባለይ ቦንቸታናዉ ማትስ።<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="LEV 23:34">ሌወ 23:34</ref>፤ <ref loc="DEU 16:13">ዛረ 16:13</ref>.</char></note> <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>ሄሳ ግሾ፥ የሱሳ እሻት፥ “ነ ታማረት ኔኒ ኦያ ማላታታ በአና መላ ሀይሳፈ ደንዳዳ ይሁዳ ቢታ ባ። <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>ባዉ ኤረታናዉ ኮያ አስ ኦንካ ባ ኦሱዋ ገንና። ኔኒ ሀይሳታ ኦዳ ነባ አላምያ ኤርሳ” ያግዶሶና። <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>እያ እሻት ሄሳ ግዳይ እያን አማንቦና ግሾሳ።<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>የሱሲ ኤንታኮ፥ “ታዉ እንጀ ዎደይ ጋክቤና፥ ሽን ህንተዉ ኡባ ዎደይ እንጀቴስ። <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/>አላመይ ህንተና እፃናዉ ዳንዳኤና፥ ሽን ታኒ አላምያ ኦሶይ ኢታ ግደይሳ ማርካትያ ግሾ ታና እፄስ። <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/>ህንተ ባልያ ቢተ፤ ታ ዎደይ ጋክቦና ግሾ ታኒ ባልያ ቢከ” ያግስ። <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>እ ሄሳ ግድ ጋልላን አትስ። <verse eid="JHN 7:9"/><verse number="10" style="v" sid="JHN 7:10"/>እያ እሻት ባኣለ ቦንቻናዉ ብዳፐ ጉየ የሱሲ ኦናካ ኤርሶና ቆሳን ሄ በሳ ብስ። <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>አይሁደት ባኣለ ቦንችያ በሳን፥ “እ አዉን ደኢ?” ያግድ እያ ኮይዶሶና።<verse eid="JHN 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12"/>አሳይ ካልካሽድ እያባ ኦደቶሶና። ባጋይ፥ “እ ሎኦ አስ” ግያ ዎደ ሀራት ቃስ፥ “አካይ፥ እ አሳ ባለስ” ያጎሶና። <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>ሽን አይሁደ ሀላቃታስ ያይዳ ግሾ ኦንካ እያባ ቆንጨን ኦደተና።<verse eid="JHN 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>ባልያ ቦንችድ ግዶ ጋያ ዎደ የሱሲ ፆሳ ኬ ብድ ታማርሶ ኦይክስ። <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>አይሁደት፥ “ሀ አደይ ትምርተ ታማሮና ሀይሳ ኡባ ዋት ኤርዴ?” ያግድ ማላለትዶሶና።<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>የሱሲ ዛሪድ፥ “ታ ታማርስያ ትምርተይ ታና ኪትዳ ፆሳ ማታፐ ያ ትምርተፈ አትሽን፥ ታባ ግደና። <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/>ፆሳ ሸንያ ኦናዉ ኮይያ ኦንካ ሀ ትምርተይ ፆሳ ማታፐ ያኮነ ዎይኮ ታኒ ታፐ ኦድያኮ ኤራና። <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/>ባባ ኦድያ ኦንካ ባ ሁጰ ቦንቾ ኮዬስ። ሽን ባና ኪትዳይሳ ቦንቹዋ ኮይያ ኦንካ እ ቱማንቾ፤ እያን ዎርዶይ ባዋ። <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/>ሙሰይ ህንተዉ ህግያ እሚስ፥ ሽን ህንተፈ ኦንካ ህግያ ናግቤና። ያትን አይስ ታና ዎናዉ ኮዬቲ?” ያግስ።<verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>አሳይ ዛሪድ፥ “ነና ፃላሄይ ኦይክስ፤ ነና ዎናዉ ኦኔ ኮየይ?” ያግዶሶና።<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>የሱሲ፥ “ታኒ እስ ማላታ ኦን ህንተ ኡባይ ማላለትደታ። <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/>ህንተ፥ ህንተ ናይታ ቃፃራና መላ ሙሰይ ኪትስ። ሽን ቃፃሮ ህንተ ማይዛት ዶምዶሶናፐ አትሽን፥ ሙሰ ግደና። ሄሳ ግሾ፥ ህንተ ሳምባታ ጋላስ አደ ናይታ ቃፃሬታ።<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ሌወ 12:3</ref>፤ <ref loc="GEN 17:10">መ 17:10</ref>.</char></note> <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/>ሙሰ ህገይ ኪትዳ ግሾ፥ ህንተ ሳምባታ ጋላስ ቃፃርያባ ግድኮ፥ ታኒ እስ አሳ ኩመ አሳተ ፓዳ ግሾ፥ ታራ አይስ ካጬቲ?<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="JHN 5:9">ዮሀ 5:9</ref>.</char></note> <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/>ቱማ ፕርዳ ፕርድተፐ አትሽን፥ አሳ ሶምኦ በእድ ፕርዶፍተ” ያግስ።<verse eid="JHN 7:24"/></para>
  <para style="s1">የሱሲ፥ እ ክርስቶሴ?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>የሩሳላመ አሳፐ እሶት እሶት፥ “ኤንቲ ዎናዉ ኮይያ ኡራይ ሀይሳ ግደኔ? <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>ሄኮ፥ እ ቆንጨን ኦዴስ፤ ኤንቲ እያ አይኮካ ጎኮና። እ ክርስቶሳ ግደይሳ አይሁደ ሀላቃት ቱማ ኤርዶናሻ? <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>ክርስቶስ ያ ዎደ እ አዉፐ ያኮ ኦንካ ኤረና፥ ሽን እ አዉፐ ይዳኮ ኑ ኤሮስ” ያግዶሶና።<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>የሱሲ ፆሳ ኬን ታማርስሸ ባ ቃላ ቁ ኦድ፥ “ቱማ ህንተ ታኒ ኦነኮነ ታ አዉፐ ይዳኮ ኤሬቲ? ታኒ ታ ማታን ያቢከ፥ ሽን ታና ኪትዳይስ ቱማንቾ፤ ህንተ እያ ኤረከታ። <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/>ሽን ታኒ እ ኪትን እያ ማታፐ ይዳ ግሾ እያ ኤራይስ” ያግስ።<verse eid="JHN 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30"/>ሄሳ ግሾ፥ ኤንቲ እያ ኦይካናዉ ኮይዶሶና። ሽን እያ ዎደይ ቡሮ ጋክቦና ግሾ ኦንካ እያ ቦላ ኩሸ ዎቤና። <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>ሽን ዳሮ አሳይ የሱሳ አማንድ፥ “ክርስቶስ ያ ዎደ ሀ ኡራይ ኦዳ ማላታታፐ ዳርያ ማላታ ኦነዬ?” ያግዶሶና።<verse eid="JHN 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>ፋርሳወት ዳሮ አሳይ የሱሳባ ካልካሸይሳ ስእዶሶና። ካህነ ሀላቃትነ ፋርሳወት እያ ኦይድ ቃሽሳናዉ ፆሳ ኬ ናገይሳታ ኪትዶሶና።<verse eid="JHN 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33"/>የሱሲ፥ “ታኒ ህንተራ ጉ ዎደ ጋምአና፤ ሄሳፈ ጉየ ታና ኪትዳይሳኮ ባና። <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/>ህንተ ታና ኮያና፥ ሽን ደመከታ። ታኒ ደእያሱዋ ህንተ ያናዉ ዳንዳኤከታ” ያግስ።<verse eid="JHN 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35"/>አይሁደት እሶይ እሱዋራ፥ “ሀይስ ኑኒ ደሞናሶ አዉ ባና ሀኒ? ግርከ ካታማን ደእያ አይሁደታኮ ብድ ግርከታ ታማርሳናዉ ሀንዬ? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>‘ህንተ ታና ኮያና፥ ሽን ደመከታ’ ቃስ፥ ‘ታኒ ደእያሱዋ ህንተ ያናዉ ዳንዳኤከታ’ ጉሳይ አይ ጉሴ?” ያግዶሶና።<verse eid="JHN 7:36"/></para>
  <para style="s1">ደኦ ሃ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>ባልያ ቦንችያ ጋላሳታፐ ዎልቃማነ ዉርሰ ጋላሳን የሱሲ ደንድድ፥ ባ ቃላ ቁ ኦድ፥ “ሳሞትዳ ኦንካ ታኮ ይድ ኡዮ።<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="LEV 23:36">ሌወ 23:36</ref>.</char></note> <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/>ታና አማንያ ኦንካ ጌሻ ማፃፋይ ግዳይሳዳ ደኦ እምያ ፑልቶ ሃይ እያፐ ጎጋና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ህዝ 47:1</ref>፤ <ref loc="ZEC 14:8">ዛካ 14:8</ref>.</char></note> <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>እ ሄሳ ግዳይ እያ አማንዳይሳት ኤካናዉ ደእያ ጌሻ አያናባ። የሱሲ ቡሮ ቦንቸትቦና ግሾ፥ ሄ ዎደ ጌሻ አያናይ እመትቤና።<verse eid="JHN 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>ሄ አሳፐ ዳሮት እ ገይሳ ስእድ፥ “ቱማ ሀይስ ናብያ”<note caller="+" style="f"><char style="fr" closed="false">7:40 </char><char style="fq" closed="false">ናብያ፦ </char><char style="ft" closed="false">ሀ በሳን ናብያ ጌተትዳይ ያና ግድ ኤንቲ ናግያ ናብያ ቆንጭሴስ። (ዮሀ 1:21 ፄልተ።)</char></note> ያግዶሶና።<verse eid="JHN 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41"/>ሀራት ቃስ፥ “ሀይስ ክርስቶሳ” ያግዶሶና።</para>
  <para style="p" vid="JHN 7:41">ሽን ሀራት ቃስ፥ “ክርስቶስ ጋልላፐ ዋንድ ከዪ? <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>ጌሻ ማፃፋይ፥ ‘ክርስቶስ ዳዊታ ሼሻፐ ዳዊቲ ደእዳ ቤተለመ ካታማፐ ያና’ ያገነዬ?” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 ሳሜ 7:12</ref>፤ <ref loc="MIC 5:2">ምክ 5:2</ref>.</char></note> <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>ሄሳ ግሾ፥ የሱሳ ጋሶን አሳይ ባንታ ግዶን ሻከትዶሶና። <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>ሄ አሳፐ እሶት እሶት እያ ኦይካናዉ ኮይዶሶና፥ ሽን ኦንካ እያ ቦላ ኩሸ ዎቤና።<verse eid="JHN 7:44"/></para>
  <para style="s1">አይሁደ ሀላቃት አማንቦኮና</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>ፆሳ ኬ ናገይሳት ካህነ ሀላቃታኮነ ፋርሳወታኮ ጉየ ስም ይን ኤንቲ፥ “አይስ እያ ኤህበከቲ?” ያግድ ኦይችዶሶና።<verse eid="JHN 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46"/>ፆሳ ኬ ናገይሳት ኤንታኮ፥ “ሀ አደይ ኦደተይሳ ኦንካ ኦደተና” ያግድ ዛርዶሶና።<verse eid="JHN 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47"/>ፋርሳወት ዛሪድ፥ “እ ህንተናካ ባለዴ? <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>አይሁደ ሀላቃታፐ ዎይኮ ፋርሳወተፐ እያ አማንዳ አስ ደኢ? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>ሙሰ ህግያ ኤሮና ሀ አሳይ ባደትዳሳታ” ያግዶሶና።<verse eid="JHN 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50"/>ፋርሳወታፐ እሶይ ቃማ የሱሳኮ ብዳ ንቆድሞስ ኤንታኮ፥<note caller="-" style="x"><char style="xo" closed="false">7:50 </char><char style="xt" closed="false"><ref loc="JHN 3:1">ዮሀ 3:1</ref>፥ <ref loc="JHN 3:2">2</ref>.</char></note> <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>“እስ አስ ግያባ ስኦና ዎይኮ እ አይ ኦዳኮ ኤሮና ደእሸ ኮይሮትድ እያ ቦላ ፕርደይስ ኑ ህግያን ደኢ?” ያግስ።<verse eid="JHN 7:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52"/>ኤንቲ ዛሪድ፥ “ኔንካ ቃስ ጋልላ ቢታ አሴ? ጋልላ ቢታፈ ናበይ ከዮናይሳ ጌሻ ማፃፋፐ ፕልጋዳ ደማ” ያግዶሶና። <verse eid="JHN 7:52"/><verse number="53" style="v" sid="JHN 7:53"/>እሶይ እሶይ አግድ ባ ሶ ባ ሶ ብስ።<verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="s1">ላይማተን ኦይከትዳ ማጫስዉ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1"/>ሽን የሱሲ ሻማሆ ዙማ ቦላ ከይስ። <verse eid="JHN 8:1"/><verse number="2" style="v" sid="JHN 8:2"/>ቃስ ዎንተ ጋላስ ጉራ ፆሳ ኬ ስምስ። ዳሮ አሳይ እያኮ ይን ኡትድ ኤንታ ታማርስስ። <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/>ህገ አስታማረትነ ፋርሳወት ላይማትሽን ኦይክዳ እስ ማጫስዉ እያኮ ኤህዶሶና። ኤንቲ አሳ ኡባ ስንን እዮ ኤስድ፥ <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/>“አስታማርያዉ፥ ሀ ማጫስያ ላይማትሽን ኑ ኦይክዳ። <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/>ሙሰ ህገይ ሀን መላ ማጫስ ሹቻን ጫደታ ሀይቃና መላ ኪቴስ። ያትን፥ ኔኒ ዎይጋይ?” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="LEV 20:10">ሌወ 20:10</ref>፤ <ref loc="DEU 22:22-24">ዛረ 22:22-24</ref>.</char></note><verse eid="JHN 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 8:6"/>ኤንቲ ሄሳ ግዳይ የሱሳ ፓጭድ እያ ሞትያባ ደማናሳ። ሽን የሱሲ ሆክድ ባ ብራን ቢታ ቦላ ፃፍስ። <verse eid="JHN 8:6"/><verse number="7" style="v" sid="JHN 8:7"/>ኤንቲ እያ ዛር ዛር ኦይችድ አጎና እፅን፥ ፑደ ቁ ግድ፥ “ህንተ ግዶን ናጋራ ኦቦና አስ ኮይሮትድ እዮ ሹቻን ጫዶ” ያግስ። <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/>ቃስካ ሆክድ ቢታ ቦላ ፃፍስ።<verse eid="JHN 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9"/>ኤንቲ ሄሳ ስእዳ ዎደ ጭማታፐ ዶምድ እሶይ እሶይ ከይሸ ዉርዶሶና። የሱሳ ፃላል ሄ በሳን ኤቅዳ ማጫሴራ አትስ። <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/>እ ፑደ ቁ ግድ ማጫሴኮ፥ “ማጫሰተ፥ አሳት አዉ ብዶና? ነ ቦላ ፕርድዳይ ኦንካ ባዌ?” ያግስ።<verse eid="JHN 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11"/>ማጫስያ፥ “ጎዳዉ፥ ኦንካ ባዋ” ያጋሱ።</para>
  <para style="p" vid="JHN 8:11">የሱሲ ዛሪድ፥ “ታንካ ነ ቦላ ፕርድከ። ባ፤ ዛራዳ ናጋራ ኦፋ” ያግስ።<verse eid="JHN 8:11"/></para>
  <para style="s1">የሱሲ አላመስ ፖኦ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>ቃስካ የሱሲ አሳኮ፥ “ታኒ አላምያስ ፖኦ። ታና ካልያ ኦንካ ደኦ እምያ ፖኡዋ ኤካናፐ አትሽን፥ ማን ስመረተና” ያግድ ኦድስ።<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 5:14">ማቶ 5:14</ref>፤ <ref loc="JHN 9:5">ዮሀ 9:5</ref>.</char></note><verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>ፋርሳወት፥ “ኔኒ ነባ ማርካታሳ፥ ሽን ነ ማርካተይ ቱማ ግደና” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="JHN 5:31">ዮሀ 5:31</ref>.</char></note><verse eid="JHN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14"/>የሱሲ ዛሪድ፥ “ታኒ ታባ ማርካትኮካ ታ ማርካተይ ቱማ። አይስ ጊኮ፥ ታኒ አዉፐ ይዳኮ ቃስ አዉ ብያኮ ኤራይስ፥ ሽን ህንተ ኤረከታ። <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/>ህንተ አሳ ቆፋን ፕርደታ፤ ታኒ እስ አሳ ቦላካ ፕርድከ። <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/>ታኒ ፕርድያባ ግድኮካ ታ ፕርዳይ ቱማ። አይስ ጊኮ፥ ታና ኪትዳ ታ አዋይ ታራ ደኤስፐ አትሽን፥ ታኒ ታርካ ደእከ። <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/>ናምኡ አሳ ማርካተ ቱማ ግደይስ ህንተ ህግያን ፃፈትስ።<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="DEU 19:15">ዛረ 19:15</ref>.</char></note> <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/>ታኒ ታባ ታ ሁጰን ማርካታይስ፤ ቃስ ታና ኪትዳ ታ አዋይካ ታባ ማርካቴስ” ያግስ።<verse eid="JHN 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19"/>ኤንቲ፥ “ነ አዋይ አዉን ደኢ?” ያግድ እያ ኦይችዶሶና።</para>
  <para style="p" vid="JHN 8:19">የሱሲ ዛሪድ፥ “ህንተ ታና ዎይኮ ታ አዋ ኤረከታ። ታና ኤርዳባ ግድያኮ፥ ህንተ ታ አዋካ ኤራናሽን” ያግስ።<verse eid="JHN 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20"/>የሱሲ ፆሳ ኬን ሙፃታ ሚሽያ የግያ ሳፅነይ ደእያ በሳን ሄሳ ታማርስስ። እያ ቃማይ ቡሮ ጋክቦና ግሾ ኦንካ እያ ኦይክቤና።<verse eid="JHN 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>ቃስካ የሱሲ ኤንታኮ፥ “ታኒ ባና፤ ህንተ ታና ኮያና፥ ሽን ህንተ አቶተ ደሞና ህንተ ናጋራን ሀይቃና። ታኒ ብያ በሳ ህንተ ባናዉ ዳንዳኤከታ” ያግስ።<verse eid="JHN 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22"/>አይሁደ ሀላቃት፥ “እ፥ ‘ታኒ ብያ በሳ ህንተ ባናዉ ዳንዳኤከታ’ ያጌስ። እ ባና ባርካ ዎነዬ?” ያግዶሶና።<verse eid="JHN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23"/>የሱሲ ዛሪድ፥ “ህንተ ጋርሳፈ፤ ታኒ ቦላፈ። ህንተ ሀ አላምያፐ፥ ታኒ ሀ አላምያፐ ግድከ። <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/>ህንተ አቶተ ደሞና ህንተ ናጋራን ሀይቃና ጋዳ ታኒ ህንተዉ ኦድዳይ ሄሳሳ። ‘ታኒ ታና ግደይሳ’ ህንተ አማኖና እፅኮ ህንተ አቶተ ደሞና ህንተ ናጋራን ሀይቃና” ያግስ።<verse eid="JHN 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25"/>ኤንቲ፥ “ኔኒ ኦኔ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="JHN 8:25">የሱሲ ዛሪድ፥ “ታኒ፥ ኮይሮፐ ህንተዉ ኦድዳ ታና። <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/>ታኒ ህንተባ ኦዳዳ ፕርድያባይ ዳሮባይ ደኤስ። ሽን ታና ኪትዳይስ ቱማንቾ፤ ቃስ ታኒ እያፐ ስእዳይሳ ፃላላ አላምያስ ኦዳይስ” ያግስ።<verse eid="JHN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27"/>የሱሲ ባ አዋባ ኦደይሳ ኤንቲ አኬክቦኮና። <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>ሄሳ ግሾ፥ የሱሲ ኤንታኮ፥ “ህንተ አሳ ናኣ ፑደ ቁ ኦያ ዎደ ታኒ ታና ግደይሳ ህንተ ኤራና። ቃስካ ታኒ ታ ማታን አይኮካ ኦናይሳነ ታ አዋይ ታና ታማርስዳይሳ ኦደይሳ ህንተ ኤራና። <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/>ታና ኪትዳይስ ታራ ደኤስ። ታኒ ኡባ ዎደ እያ ኡፋይስያባ ኦያ ግሾ እ ታና ታ ፃላላ አግቤና” ያግስ።<verse eid="JHN 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30"/>የሱሲ ሄሳ ኦድሽን ስእዳ ዳሮ አሳይ እያ አማንዶሶና።<verse eid="JHN 8:30"/></para>
  <para style="s1">ቱም ላአ ከሴስ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>የሱሲ ባና አማንዳ አሳታኮ፥ “ህንተ ታ ትምርትያስ ኪተትኮ ቱማ ታና ካለይሳታ። <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/>ህንተ ቱማ ኤራና፤ ቱማይካ ህንተና አይለተፈ ከሳና” ያግስ።<verse eid="JHN 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33"/>ኤንቲ ዛሪድ፥ “ኑኒ አብራሃመ ሼሽ፤ ኑኒ ኦደስካ አይለትቦኮ። ኔኒ ዎይጋዳ፥ ‘ህንተ አይለተፈ ከያና’ ጋይ?” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">8:33 </char><char style="xt" closed="false"><ref loc="MAT 3:9">ማቶ 3:9</ref>፤ <ref loc="LUK 3:8">ሉቃ 3:8</ref>.</char></note><verse eid="JHN 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34"/>የሱሲ ዛሪድ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ናጋራ ኦያ ኦንካ ናጋራ አይለ። <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/>አይለይ መርናዉ ሶ አሳራ ዴና፥ ሽን ናአይ መርናዉ ሶ አሳራ ደኤስ። <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/>ናአይ ህንተና አይለተፈ ከስኮ ህንተ አይለተፈ ቱማ ከያና። <verse eid="JHN 8:36"/><verse number="37" style="v" sid="JHN 8:37"/>ህንተ አብራሃመ ሼሽ ግደይሳ ታኒ ኤራይስ። ሽን ታ ቃላይ ህንተ ዎዛናን ባይና ግሾ፥ ታና ዎናዉ ኮዬታ። <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/>ታኒ ታ አዋይ ታና በስዳይሳ ኦዳይስ፥ ሽን ህንተካ ህንተ አዋፐ ስእዳይሳ ኦታ” ያግስ።<verse eid="JHN 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39"/>ኤንቲ ዛሪድ፥ “ኑ አዋይ አብራሃመ” ያግዶሶና።</para>
  <para style="p" vid="JHN 8:39">የሱሲ ኤንታኮ፥ “ህንተ አብራሃመ ናይታ ግድያኮ እ ኦዳይሳ ኦና። <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/>ሽን ፆሳፈ ስእዳ ቱማ ኦድዳ ታና ህንተ ዎናዉ ኮዬታ። አብራሃመይ ሄሳዳ ኦቤና። <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/>ህንተ፥ ህንተ አዋይ ኦዳይሳ ኦታ” ያግስ።</para>
  <para style="p" vid="JHN 8:41">ኤንቲ ዛሪድ፥ “ኑኒ ቱማ ፆሳ ናይታ፤ ኑስ እስ አዋይ ፆሳ ፃላል ደኤስ” ያግዶሶና።<verse eid="JHN 8:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42"/>የሱሲ ኤንታኮ፥ “ፆሳይ ቱማ ህንተ አዋ ግድያኮ ህንተ ታና ዶሳና፤ አይስ ጊኮ፥ ታኒ ፆሳ ማታፐ ያዳ ሀይሳን ደአይስ። ታና እ ኪትስፐ አትሽን፥ ታኒ ታ ማታን ያቢከ። <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/>ታኒ ገይሳ ህንተ ስአናዉ ኮዮና ግሾ ታ ግያባይ ህንተዉ ገለና። <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/>ህንተ፥ ህንተ አዋ ፃላሄ ናይታ። ቃስ ህንተ፥ ህንተ አዋይ አሞትያባ ኦናዉ ኮዬታ። እ ኮይሮፐ ዶምድ ሸምፖ ዎይሳ። ቱም እያን ባይና ግሾ እ ቱማ እፄስ። ዎርዶይ እያዉ መ ግድዳ ግሾነ እ ዎርዶ አዋ ግድያ ግሾ ዎርዶ ኦደትሸ ባፐ ኦደቴስ። <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/>ታኒ ቱማ ኦዳይስ፥ ሽን ህንተ ታና አማነከታ። <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/>ህንተፈ፥ ‘ኔኒ ናጋራ ኦሽን ታ በአስ’ ጋናዉ ዳንዳኤይ ኦኔ? ታኒ ቱማ ኦደትያባ ግድኮ ታና አይስ አማነከቲ? <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/>ፆሳ አስ ፆሳይ ግያባ ስኤስ። ህንተ ፆሳ አስ ግዶና ግሾ ፆሳይ ግያባ ስኤከታ” ያግስ።<verse eid="JHN 8:47"/></para>
  <para style="s1">የሱሲ አብራሃመፐ ስን ደኤስ</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>አይሁደት ዛሪድ፥ “ ‘ኔኒ ሳማረ አስ፤ ነናን ቱና አያናይ ደኤስ’ ግሸ ልከ ግዶኮ?” ያግዶሶና።<verse eid="JHN 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49"/>የሱሲ ኤንታኮ “ታ ቦላ ቱና አያን ባዋ። ታኒ ታ አዋ ቦንቻይስ፥ ሽን ህንተ ታና ካዉሸታ። <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/>ታኒ ታ ሁጰ ቦንቾ ኮይከ፤ ታኒ ቦንቸታና መላ ኮየይስነ ታዉ ፕርደይስ ደኤስ። <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ታ ቃላ ናግያ ኦንካ ሀይቀና” ያግስ።<verse eid="JHN 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52"/>አይሁደት ዛሪድ፥ “ነ ቦላ ቱና አያናይ ደኤይሳ ኑኒ ሀእ ኤርዳ። አብራሃመይ ሀይቅስ፤ ናበትካ ሀይቅዶሶና። ሽን ኔኒ፥ ‘ታ ቃላ ናግያ ኦንካ ሀይቀና’ ያጋሳ። <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>ኔኒ ሀይቅዳ ኑ አዋ አብራሃመፐ አዬ? ናበትካ ቃስ ሀይቅዶሶና። ኔኒ ነና ኦና ጋዳ ቆፓይ?” ያግዶሶና።<verse eid="JHN 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54"/>የሱሲ፥ “ታኒ ታና ቦንችኮ ታ ቦንቾይ ሀዳ። ህንተ፥ ‘ኑ ፆሳ’ ግያ ታ አዋይ እ ታና ቦንቼስ። <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/>ህንተ እያ ኤሮና እፅኮ ታኒ እያ ኤራይስ። ታኒ እያ ኤርከ ጊኮ ህንተ መላ ዎርዶታይስ። ሽን ታኒ እያ ኤራይስ፤ ቃስ እያ ቃላካ ናጋይስ። <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/>ህንተ አዋይ አብራሃመይ ታ ዩሳ ጋላሳ በእድ ኡፋይታናዉ አሞትስ፤ በእድካ ኡፋይትስ” ያግስ።<verse eid="JHN 8:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57"/>አይሁደት ዛሪድ፥ “ሀር አቶሽን፥ ነዉ እሻታሙ ላይ ኩምቤናሽን ዋናዳ አብራሃመ በአስ ጋይ?” ያግዶሶና።<verse eid="JHN 8:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58"/>የሱሲ ኤንታኮ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ አብራሃመይ የለታናፐ ካሰ፥ ‘ታኒ ታና’ ” ያግስ።<verse eid="JHN 8:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59"/>ሄሳ ግሾ፥ ኤንቲ የሱሳ ጫዳናዉ ሹች ኤክዶሶና። ሽን የሱሲ ኤንታፈ ጌምድ ፆሳ ኬፈ ከይድ ብስ።<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s1">ቆቀ ግድድ የለትዳ ኡራ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>የሱሲ ብሸ የለቶሳፐ ቆቀ ግድድ ደእያ እስ አድያ በእስ። <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>እያ ታማረት፥ “አስታማርያዉ፥ ሀ አደይ ቆቀ ግድድ የለታና መላ ናጋራ ኦዳይ ኦኔ? እ ኦደየ ዎይኮ እያ የልዳይሳት ኦዶና?” ያግድ ኦይችዶሶና።<verse eid="JHN 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3"/>የሱሲ፥ “ፆሳ ኦሶይ እያ ቦላ ቆንጫና መላፐ አትሽን፥ እ ዎይኮ እያ የልዳይሳት ናጋራ ኦዳ ግሾ ግደና። <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/>ሳእ ጋላስ ደእሽን ታና ኪትዳይሳ ኦሱዋ ኑ ኦናዉ በሴስ። ኦንካ ኦናዉ ዳንዳኦና ቃማይ ዬስ። <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/>ታኒ አላምያን ደአሸ አላምያስ ፖኦ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="MAT 5:14">ማቶ 5:14</ref>፤ <ref loc="JHN 8:12">ዮሀ 8:12</ref>.</char></note><verse eid="JHN 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6"/>የሱሲ ሄሳ ግድ ሳአን ጩትስ። ባ ጩቻን ጉ ቢታ ላኮድ ሄ ኡርቃን ቆቀ አድያ አይፍያ ትይስ። <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>ያትድ፥ “ባዳ ሳልሆመ (ሳልሆመ ጉሳይ ኪተትዳይሳ ጉሱ) ጌተትያ ተቀትዳ ሃን ነ አይፍያ ሜጨታ” ያግስ። ሄሳ ግሾ፥ አደይ ብድ ባ አይፍያ ሜጨትድ ፄልሸ ስምስ።<verse eid="JHN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8"/>አድያ ሾሮትነ አደይ ካሰ ዎስሽን በእዳ አሳይ፥ “ሀይስ ኡትድ ዎስያ አድያ ግደነዬ?” ያግዶሶና።<verse eid="JHN 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9"/>እስ እስ አሳይ፥ “ሀይስ እያ” ያግዶሶና።</para>
  <para style="p" vid="JHN 9:9">ሀራት ቃስ፥ “አካይ፥ ሀይስ እያ ዳኔስፐ አትሽን፥ እያ ግደና” ያግዶሶና።</para>
  <para style="p" vid="JHN 9:9">ሽን አደይ፥ “ኤ፥ ታና” ያግስ።<verse eid="JHN 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10"/>ኤንቲ እያኮ፥ “ያትን ነ አይፈይ ዋንድ ፄልዴ?” ያግድ ኦይችዶሶና።<verse eid="JHN 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11"/>እ ዛሪድ፥ “የሱሳ ጌተትያ አደይ ጉ ኡርቃ ላኮድ ታ አይፍያ ትይድ፥ ‘ሳልሆመ ባዳ ነ አይፍያ ሜጨታ’ ያግን፥ ታኒ ባዳ ሜጨታዳ ፄላ አጋስ” ያግስ።<verse eid="JHN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12"/>ኤንቲ እያኮ፥ “እ አዉን ደኢ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="JHN 9:12">አደይ፥ “ታኒ ኤርከ” ያግስ። <verse eid="JHN 9:12"/><verse number="13" style="v" sid="JHN 9:13"/>ኤንቲ ካሰ ቆቀ፥ ሽን ሀእ ፄልዳ አድያ ፋርሳወታኮ ኤፍዶሶና። <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>የሱሲ ኡርቃ ላኮድ አድያ አይፍያ ፓዳ ጋላሳይ ሳምባታ ጋላስ። <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>ሄሳ ግሾ፥ አደይ ዋንድ ፄልዳኮ ፋርሳወት እያ ዛር ኦይችዶሶና። አደይ ኤንታኮ፥ “እ ታ አይፍያን ጉ ኡርቃ ትይስ። ታ አይፍያ ሜጨታዳ ሀእ ፄላይስ” ያግስ።<verse eid="JHN 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16"/>ፋርሳወተፐ እሶት እሶት፥ “ሀይሳ ኦዳ አደይ ሳምባታ ህግያ ናጎና ግሾ ፆሳ ማታፐ ይቤና” ያግዶሶና።</para>
  <para style="p" vid="JHN 9:16">ሽን ሀራት፥ “ናጋራንቾ አስ ሀይሳ መላ ማላታ ዋት ኦናዉ ዳንዳኢ?” ያግድ ባንታ ግዶን ሻከትዶሶና።<verse eid="JHN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17"/>ሄሳ ግሾ፥ ፋርሳወት አድያኮ፥ “እ ነ አይፍያ ፄልስዳ ግሾ ነ እያባ ዎይጋይ?” ያግዶሶና።</para>
  <para style="p" vid="JHN 9:17">አደይ፥ “እ ናበ” ያግስ።<verse eid="JHN 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18"/>አይሁደ ሀላቃት፥ እያ አይዉነ አዋ ፄግድ ኦይቻና ጋካናዉ፥ አደይ ካሰ ቆቀ ግድዳይሳነ ሀእ እ ፄለይሳ አማንቦኮና። <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>ኤንቲ እያ አይዉነ እያ አዋኮ፥ “ህንተ ‘ቆቀ ግድድ የለትስ’ ግያ ህንተ ናአይ ሀይሴ? ያትን፥ ሀእ ዋንድ ፄልዴ?” ያግድ ኦይችዶሶና።<verse eid="JHN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20"/>እያ የልዳይሳት፥ “ሀይስ ኑ ናኣ ግድዳይሳነ ቆቀ ግድድ እ የለትዳይሳ ኑ ኤሮስ። <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>ሽን ሀእ እ ዋንድ ፄልዳኮ ቃስ እያ አይፍያ ኦን ፓዳኮ ኑኒ ኤሮኮ። እያ ኦይችተ። እ ባና ኤርዳ አስ ግድያ ግሾ ባባ ኦዳናዉ ዳንዳኤስ” ያግዶሶና። <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>እያ የልዳይሳት ሄሳ ግዳይ አይሁደታስ ያይዳ ግሾሳ። አይስ ጊኮ፥ አይሁደት፥ የሱሲ እ ክርስቶሳ ያግድ ማርካትያ አስ ደእኮ ሄ ኡራ አይሁደ ዎሳ ኬፈ ህላናዉ ኮይሮትድ ዞረ ቃችዶሶና። <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>እያ የልዳይሳት፥ “እ ባና ኤርዳ አስ፤ እያ ኦይችተ” ያግዳይ ሄሳሳ።<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>ሄሳ ግሾ፥ ቆቀ ግድድ የለትዳ አድያ ኤንቲ ዛር ፄግድ፥ “ቱማ ኦዳናዉ ፆሳን ጫቃ፤ ሀ አደይ ናጋራንቾ ግደይሳ ኑ ኤሮስ” ያግዶሶና።<verse eid="JHN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25"/>አደይ ዛሪድ፥ “እ ናጋራንቾ ግደይሳ፥ ታ ኤርከ። ታኒ ቆቀ ግደይሳነ ሀእ ፄለይሳ ሄ እስባ ኤራይስ” ያግስ።<verse eid="JHN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26"/>ኤንቲ ዛሪድ፥ “እ ነዉ አይ ኦዴ? እ ነ አይፍያ ዋት ፓዴ?” ያግዶሶና።<verse eid="JHN 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27"/>እ ኤንታኮ፥ “ታኒ ህንተዉ ኦዳስ፥ ሽን ስእቤከታ። አይስ ዛር ስአናዉ ኮዬቲ? ህንተካ እያ ታማረ ግዳናዉ ኮዬትዬ?” ያግስ።<verse eid="JHN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28"/>ኤንቲ እያ ጫይድ፥ “ነ ሄ ኡራ ታማረ ግዳ፤ ኑኒ ሙሰ ታማረ። <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>ፆሳይ ሙሰስ ኦድዳይሳ ኑኒ ኤሮስ፥ ሽን ሀር አቶሽን ሀ ኡራይ እ አዉፐ ይዳኮካ ኑ ኤሮኮ” ያግዶሶና።<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>አደይ ኤንታኮ፥ “እ አዉፐ ይዳኮ ህንተ ኤሮናይስ ማላልስያባ፥ ሽን እ ታ አይፍያ ፓስ። <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>ፆሳ ቦንቸይሳነ እ ኮያባ ኦያ ኡራ ፆሳይ ስኤስፐ አትሽን፥ ናጋራንቾታ ስኤና። <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>ሳሎይ ሳእ መቶሳፐ ቆቀ ግድድ የለትዳ አሳ አይፈ ፓዳይ ኦንካ ባዋ። <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>ሀ አደይ ፆሳፈ ኪተትቦናባ ግድያኮ እስባካ ኦናዉ ዳንዳኤና” ያግስ።<verse eid="JHN 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34"/>ኤንቲ ዛሪድ፥ “ኔኒ ናጋራን የለታዳ ድጭዳይስ ኑና ታማርሳናዉ ኮያይ?” ያግዶሶና። እያ አይሁደ ዎሳ ኬፈ ህልዶሶና።<verse eid="JHN 9:34"/></para>
  <para style="s1">ዎዛና ቆቀተ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>የሱሲ ኤንቲ አድያ ከስዳይሳ ስእዳ ዎደ እያ ደምድ፥ “አሳ ናኣ አማናይ?” ያግድ ኦይችስ።<verse eid="JHN 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36"/>አደይ የሱሳኮ፥ “ጎዳዉ፥ ታኒ እያ አማናና መላ እ ኦኔ? ታዉ ኦዳርኪ?” ያግስ።<verse eid="JHN 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37"/>የሱሲ አድያኮ፥ “ኔኒ እያ በአዳሳ፤ ሀ ኔራ ኦደተይስ እያ” ያግስ።<verse eid="JHN 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38"/>አደይ ዛሪድ፥ “ጎዳዉ፥ አማናይስ” ያግድ የሱሳስ ጎይንስ።<verse eid="JHN 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39"/>የሱሲ፥ “ቆቀት ፄላና መላነ ፄለይሳት ቆቃና መላ ታኒ ፕርዳናዉ ሀ አላምያ ያስ” ያግስ።<verse eid="JHN 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40"/>እያራ ደእያ ጉ ፋርሳወት ሄሳ ስእድ፥ “ኑ ቆቀዬ?” ያግድ ኦይችዶሶና።<verse eid="JHN 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41"/>የሱሲ፥ “ህንተ ቆቀ ግድያኮ ህንተዉ ናጋራ ግደና። ሽን ሀእ ህንተ ፄሎስ ግያ ግሾ ህንተ፥ ህንተ ናጋራን ደኤታ” ያግስ።<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s1">የሱሲ ሎኦ ሄንንቾ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>የሱሲ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ዶርሳ ግርበ ግዶ ፐንገራ ግዶና ሀራሶራ ገልያ ኦንካ ካይሶነ ፓንጋ። <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/>ሽን ፐንገራ ገለይስ ዶርሳታ ሄመይሳ። <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/>ፐንግያ ናገይስ እያዉ ፐንግያ ዶዬስ፤ ዶርሳትካ እያ ቃላ ስኦሶና። እ ባ ዶርሳታ ኤንታ ሱንን ሱንን ፄጌስ፤ ኤንታ ካለድ ካረ ከሴስ። <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/>እ ባ ዶርሳታ ካረ ከስዳፐ ጉየ ኤንታ ስንን ሄመቴስ። ኤንቲ እያ ቃላ ኤርያ ግሾ እያ ካሎሶና። <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/>ሀራ ኡራ ቃላ ኤንቲ ኤሮና ግሾ እያፐ ባቃቶሶናፐ አትሽን፥ እያ ጌዶ ካሎኮና” ያግስ።<verse eid="JHN 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6"/>የሱሲ ኤንታዉ ሀ ሌምሱዋ ኦድስ፥ ሽን እ አይ ግዳኮ ኤንቲ አኬክቦኮና።<verse eid="JHN 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>ዛሪድ የሱሲ ኤንታኮ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ታኒ ዶርሳታስ ፐንገ። <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/>ታፐ ስን ይዳ ኡባይ ካይሶነ ፓንጋ፥ ሽን ዶርሳት ኤንታ ስእቦኮና። <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/>ፐንገይ ታና፤ ታ ባጋራ ገልያ ኦንካ አታና። እ ታ ባጋራ ገላናነ ከያና፤ ሎኦ ሄመትያ በሲ ደማና። <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/>ካይሶይ ካይሶታናዉ፥ ሹካናዉነ ይሳናዉ ዬስፐ አትሽን፥ ሀራባስ ዬና። ታኒ ኤንታዉ ደኦይ ዳና መላነ ኩምድ ፓላሀና መላ ያስ።<verse eid="JHN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11"/>“ታኒ ሎኦ ሄንንቾ፤ ሎኦ ሄንንቾይ ባ ዶርሳታ ግሾ ባ ሸምፑዋ አድ እሜስ። <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/>ኡነ ሄምያ አስ ዶርሳታ ጎዳነ ሄንንቾ ግዶና ግሾ ሱመይ ያ ዎደ በእድ ዶርሳታ አግድ ቤስ። ሄሳ ግሾ፥ ሱመይ ዶርሳታ ኦይክድ ላሌስ። <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/>ኡነ ሄመይስ ሚሸስ ሄምያ ግሾነ ዶርሳታባይ እያ ቆፍሶና ግሾ ዶርሳታ አግድ ባቃቴስ።<verse eid="JHN 10:13"/></para>
  <para style="p">
    <verse number="14-15" style="v" sid="JHN 10:14-15"/>“ታኒ ሎኦ ሄንንቾ። ታ አዋይ ታና ኤረይሳዳ ታንካ ታ አዋ ኤራይስ። ሄሳዳካ፥ ታኒ ታ ዶርሳታ ኤራይስ፤ ታ ዶርሳትካ ታና ኤሮሶና። ታኒ ታ ዶርሳታ ግሾ ታ ሸምፑዋ አ እማይስ።<note caller="-" style="x"><char style="xo" closed="false">10:14-15 </char><char style="xt" closed="false"><ref loc="MAT 11:27">ማቶ 11:27</ref>፤ <ref loc="LUK 10:22">ሉቃ 10:22</ref>.</char></note> <verse eid="JHN 10:14-15"/><verse number="16" style="v" sid="JHN 10:16"/>ሀ ዉድያን ባይና ሀራ ዶርሳት ታዉ ደኦሶና። ታኒ ኤንታካ ኤሀናዉ በሴስ። ኤንቲ ታ ቃላ ስአና፤ ኤንቲ እስ ዉደ ግዳና፤ ሄንንቾይካ እሱዋ።<verse eid="JHN 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17"/>“ታኒ ታ ሸምፑዋ አ እማዳ ዛራ ኤክያ ግሾ ታ አዋይ ታና ዶሴስ። <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/>ታ ዶሳዳ ታ ሸምፑዋ አ እማይስፐ አትሽን፥ ታፐ ኦንካ ኤከና። ታኒ ታ ሸምፑዋ አ እማናዉነ ዛራ ኤካናዉ ማት ታዉ ደኤስ። ታኒ ኦና መላ ታ አዋይ ታና ኪትዳይስ ሀይሳ” ያግስ።<verse eid="JHN 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19"/>ሄሳ እ ግዳ ግሾ፥ አይሁደታ ግዶን ቃስካ ሻከተ መትስ። <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>ኤንታፈ ዳርያ ባጋይ፥ “እያን ቱና አያናይ ደኤስ! እ ጎዬስ! እ ግያባ አይስ ስኤቲ?” ያግዶሶና።<verse eid="JHN 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21"/>ሀራት ቃስ፥ “ፃላሄይ ኦይክዳ አስ ሀይሳዳ ኦደተና። ቱና አያን ቆቀ አይፈ ፄልሳናዉ ዳንዳእዬ?” ያግዶሶና።<verse eid="JHN 10:21"/></para>
  <para style="s1">የሱሲ አሳ ናአ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>የሩሳላመን ፆሳ ኬ አንጅስዳ ጋላሳታ ቦንችያ ባለይ ጋክስ፤ ሄ ዎደ ሳእ ባልጎ። <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>የሱሲ ፆሳ ኬን ሶሎሞነ ባራንዳን ስመረቴስ። <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>አይሁደት የሱሳ ዩሾን ሺቅ ኤቅድ፥ “ኔኒ ኑና አዉደ ጋካናዉ ስራ ዎኔ? ኔኒ ክርስቶሳ ግድኮ አነ ኑስ ጌሻዳ ኦዳ” ያግዶሶና።<verse eid="JHN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25"/>የሱሲ ዛሪድ ኤንታኮ፥ “ታኒ ህንተዉ ኦዳስ፤ ሽን ታና አማነከታ። ታኒ ታ አዋይ ታዉ እምዳ ማታን ኦያ ኦሶይ ታባ ማርካቴስ። <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/>ሽን ታኒ ህንተዉ ኦድዳይሳዳ ህንተ ታ ዶርሰ ግዶና ግሾ አማነከታ። <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/>ታ ዶርሳት ታ ቃላ ስኦሶና። ታኒ ኤንታ ኤራይስ፤ ኤንትካ ታና ካሎሶና። <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/>ታኒ ኤንታዉ መርና ደኡዋ እማይስ፤ ኤንቲ ኡባራካ ዮኮና። ኦንካ ታ ኩሸፐ ኤንታ ቦንቅ ኤካናዉ ዳንዳኤና። <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/>ኤንታ ታዉ እምዳ ታ አዋይ ኡባፈ አስ<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="fq" closed="false">ታ አዋይ ኡባፈ አስ፦ </char><char style="ft" closed="false">እስ እስ በን ማፃፋት፥ “ታ አዋይ ታዉ እምዳ ኤንቲ ኡባፈ አሶና” ያጎሶና።</char></note> ኦንካ ታ አዋ ኩሸፐ ኤንታ ቦንቅ ኤካናዉ ዳንዳኤና። <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/>ታነ ታ አዋይ እስኖ” ያግስ።<verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>አይሁደት የሱሳ ጫዳናዉ ቃስካ ሹች ደንዶሶና። <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>የሱሲ ኤንታኮ፥ “ታኒ ኦና መላ ታ አዋይ ታዉ እምዳ ዳሮ ሎኦ ኦሶታ ህንተና ኦ በሳስ። ሄሳታፐ አዉሳ ግሾ ታና ሹቻን ጫዳናዉ ኮዬቲ?” ያግስ።<verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>አይሁደት ዛሪድ፥ “ኑኒ ነና ነ ሎኦ ኦሶ ግሾ ሹቻን ጫዳናዉ ኮዮኮ። ሽን ኔኒ ፆሳ ጫይያ ግሾነ አሰ ግዳሸ ኔኒ፥ ነና ፆሰ ግያ ግሾሳ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="LEV 24:16">ሌወ 24:16</ref>.</char></note><verse eid="JHN 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34"/>የሱሲ ዛሪድ፥ “ጌሻ ማፃፋን ፆሳይ፥ ‘ህንተ ፆሳታ’ ግዳይስ ፃፈትቤኔ?<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="PSA 82:6">ማዝ 82:6</ref>.</char></note> <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/>ጌሻ ማፃፋይ መርናዉ ላመተና። ፆሳይ ባ ቃላ እምዳ አሳታ፥ ‘ፆሳታ’ ግድ ፄግኮ፥ <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/>አዋይ ዶርድ ሀ አላምያ ኪትዳ ታና ፆሳ ናአ ዋትድ ‘ፆሳ ጫያሳ’ ያገቲ? <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/>ታኒ ታ አዋይ ኦይሳ ኦና እፅኮ ታና አማኖፕተ። <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/>ሽን ታኒ ኦያባ ግድኮ ህንተ ታና አማኖና እፅኮካ፥ ታ አዋይ ታናን ደኤይሳነ ታካ ታ አዋን ደኤይሳ ህንተ ኤራና መላ ታ ኦሱዋ አማንተ” ያግስ።<verse eid="JHN 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39"/>ቃስካ ኤንቲ እያ ኦይካናዉ ኮይዶሶና፥ ሽን እ ኤንታፈ ከስ ኤክስ።<verse eid="JHN 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40"/>ዮሃንስ ካሰ ፃማቅያ በሳ፥ ዮርዳኖሰ ሻፋፐ ሄፍን የሱሲ ፕንድ ያን ደእስ።<note caller="-" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="JHN 1:28">ዮሀ 1:28</ref>.</char></note> <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>ዳሮ አሳይ የሱሳኮ ይድ፥ “ዮሃንስ ማላታ ኦቤና፥ ሽን እ ሀ አድያባ ኦድዳባይ ኡባይ ቱማ” ያግዶሶና። <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>ያን ዳሮ አሳይ የሱሳ አማንዶሶና።<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s1">አላዛራ ሀይቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>ብታነ ጉታን አላዛራ ጌተትያ እስ አደይ ሀርገትስ። ብታነይ ማይራማነ እ ምችያ ማርታ ደእያ ጉታ።<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="LUK 10:38-39">ሉቃ 10:38-39</ref>.</char></note> <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>ሄ ማይራማ ጎዳ ቶሁዋ ሽቶ ትያዳ ባ ብናናን እያ ቶሁዋ ቁችዳሮ። ሀርገትዳይ እ እሻ አላዛራ።<note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="JHN 12:3">ዮሀ 12:3</ref>.</char></note> <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>ሄሳ ግሾ፥ ምቸት፥ “ጎዳዉ፥ ነ ዶሰይስ ሀርገትስ” ግድ የሱሳኮ ኪትዶሶና።<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>የሱሲ ሄሳ ስእዳ ዎደ፥ “ሀ ሀርገይ፥ ፆሳይነ እያ ናአይ ቦንቸታና መላፐ አትሽን፥ ሀይቆስ ጋያ ሀርገ ግደና” ያግስ።<verse eid="JHN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5"/>የሱሲ ማርታ፥ እ ምችዉነ አላዛራ ዶሴስ። <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>ሽን አላዛር ሀርግዳይሳ የሱሲ ስእድ ባ ደእያ በሳን ናምኡ ጋላስ ጋምእስ። <verse eid="JHN 11:6"/><verse number="7" style="v" sid="JHN 11:7"/>ሄሳፈ ጉየ፥ የሱሲ ባ ታማረታኮ፥ “ዛሪድ ይሁዳ ቢታ ቦስ” ያግስ።<verse eid="JHN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8"/>እያ ታማረት ዛሪድ፥ “አስታማርያዉ፥ ጉ ዎደፐ ካሰ አይሁደት ነና ሹቻን ጫድድ ዎናዉ ኮይዶሶና፤ ሀእካ ያ ባኔ?” ያግዶሶና።<verse eid="JHN 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9"/>የሱሲ፥ “እስ ጋላሳን ታማነ ናምኡ ሳተይ ደኤስ ግደነዬ? ጋላስ ሄመትያ አስ ሀ አላምያ ፖኡዋ በእያ ግሾ በተና። <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/>ሽን ቃማ ሄመትያ ኦንካ ፖኦይ ባይና ግሾ፥ በቴስ” ያግስ። <verse eid="JHN 11:10"/><verse number="11" style="v" sid="JHN 11:11"/>የሱሲ ሄሳ ግዳፐ ጉየ ኤንታኮ፥ “ኑ ዶስያ አላዛር ስክስ፥ ሽን እያ ደንናዉ ታኒ ባና” ያግስ።<verse eid="JHN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12"/>እያ ታማረት ዛሪድ፥ “ጎዳዉ፥ እ ስክዳባ ግድኮ እያዉ ሎአና” ያግዶሶና።<verse eid="JHN 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13"/>የሱሲ አላዛር ሀይቅዳይሳ ኦድስ፥ ሽን ኤንታዉ ጮ ስኮ ዳንስ። <verse eid="JHN 11:13"/><verse number="14" style="v" sid="JHN 11:14"/>ሄሳ ግሾ፥ የሱሲ ጌሽድ ኤንታኮ፥ “አላዛር ሀይቅስ። <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/>ህንተ አማናና መላ ታኒ ሄ በሳን ደኦናይሳስ ህንተ ግሾ ኡፋይታይስ። አነ የተ፤ እያኮ ቦስ” ያግስ።<verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>ሄሳፈ ጉየ፥ ድድሞሳ<note caller="+" style="f"><char style="fr" closed="false">11:16 </char><char style="fk" closed="false">ድድሞሳ፦ </char><char style="ft" closed="false">ጉሳይ መንተ ጉሱ።</char></note> ጌተትያ ቶማስ ባ ላገ ታማረታኮ፥ “አስታማርያራ ሀይቃናዉ ኑካ ቦስ” ያግስ።<verse eid="JHN 11:16"/></para>
  <para style="s1">የሱሲ ደንዶነ ደኦ</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>የሱሲ ጋክያ ዎደ አላዛር ሞገትን ኦይዱ ጋላስ ግድስ። <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>ብታነይ የሩሳላመፐ ሄ ክሎ ምትረ መላ ሃኬስ። <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>ዳሮ አይሁደት ማርታነ ማይራሞ ኤንታ እሻይ ሀይቅዳይሳስ ምንናዉ ይዶሶና።<verse eid="JHN 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20"/>ማርታ የሱሲ ይዳይሳ ስአዳ እያ ሞካናዉ ከያሱ፥ ሽን ማይራማ ሶን አታሱ። <verse eid="JHN 11:20"/><verse number="21" style="v" sid="JHN 11:21"/>ማርታ የሱሳኮ፥ “ጎዳዉ፥ ኔኒ ሀይሳን ደእዳባ ግድያኮ ታ እሻይ ሀይቀናሽን። <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>ሽን ሀእ ግድኮካ ኔኒ ዎስያባ ፆሳይ ነዉ እማናይሳ ታኒ ኤራይስ” ያጋሱ።<verse eid="JHN 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23"/>የሱሲ፥ “ነ እሻይ ሀይቆፐ ደንዳና” ያግስ።<verse eid="JHN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24"/>ማርታ እያኮ፥ “ዉርሰ ጋላስ እ ሀይቆፐ ደንዳናይሳ ኤራይስ” ያጋሱ።<verse eid="JHN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25"/>የሱሲ ኢኮ፥ “ታኒ ደንዶነ ደኦ፤ ታና አማንያ ኦንካ ሀይቅኮካ ደኦን ዳና። <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/>ቃስ ደኦን ደኤይነ ታና አማንያ ኦንካ ሀይቀና። ሄሳ ኔኒ አማናይ?” ያግስ።<verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>ማርታ ዛራዳ፥ “ጎዳዉ፥ ኤ ታኒ አማናይስ! ኔኒ ፆሳ ናኣ፥ አላምያ ያናዉ ደእያ ክርስቶሳ ግደይሳ ታኒ አማናይስ” ያጋሱ።<verse eid="JHN 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28"/>ማርታ ሄሳ ግዳፐ ጉየ፥ ባዳ ባ ምችዉ ጌማን ፄጋዳ፥ “አስታማረይ ይድ ነና ኮዬስ” ያጋሱ። <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/>ማይራማ ሄሳ ስእዳ ዎደ ኤለሳ ደንዳ ኤቃዳ የሱሳኮ ባሱ። <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>ሄ ሳተን የሱሲ ማርታራ ጋሄትዳ በሳን ደኤስ፤ ቡሮ ጉታ ጋክቤና። <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>ማይራሞ ምንሸ ኢራ ሶን ደእያ አይሁደት፥ እያ ደንዳ ኤቃዳ ኤለሳዳ ካረ ከይዳይሳ በእድ፥ ዱፎ ባዳ ዬካናዉ ሀንያ ዳንን እዮ ካልድ ከይዶሶና።<verse eid="JHN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32"/>ማይራማ የሱሲ ደእያሱዋ ባዳ እያ በእዳ ዎደ እያ ቶሁዋ ቦላ ኩንዳዳ፥ “ጎዳዉ፥ ኔኒ ሀይሳን ደእዳባ ግድያኮ ታ እሻይ ሀይቀናሽን” ያጋሱ።<verse eid="JHN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33"/>የሱሲ ማይራማነ ኢራ ደእያ፥ አይሁደት ዬከይሳ በእድ፥ ባ ዎዛናን ዳሮ ሴለትድ፥ <verse eid="JHN 11:33"/><verse number="34" style="v" sid="JHN 11:34"/>“አዉን ሞግደቲ?” ያግድ ኦይችን፥ “ጎዳዉ፥ ያዳ በአ” ያግድ ዛርዶሶና።<verse eid="JHN 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35"/>የሱሲ አፉፅስ። <verse eid="JHN 11:35"/><verse number="36" style="v" sid="JHN 11:36"/>ሄሳ ግሾ፥ አይሁደት፥ “እ አላዛራ አይ መላ ዶስያኮ በእተ” ያግዶሶና።<verse eid="JHN 11:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37"/>ሽን ኤንታፈ እሶት እሶት፥ “ሀይስ ቆቅያ ፄልስዳይስ ሀ አደይ ሀይቆና መላ ኦናዉ ዳንዳኤነሽን?” ያግዶሶና።<verse eid="JHN 11:37"/></para>
  <para style="s1">አላዛር ሀይቆፐ ደንዱዋ</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>ቃስካ የሱሲ ሴለትድ፥ አላዛር ሞገትዳ ዱፉዋ ብስ። ሄ ዱፎይ ሹቻን ጎርደትዳ ጎንጎሎ። <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>የሱሲ፥ “ሹቻ ደንተ” ያግድ ኪትስ።</para>
  <para style="p" vid="JHN 11:39">ማርታ፥ “ጎዳዉ፥ እ ሀይቆሳፐ ኦይዱ ጋላስ ግድዳ ግሾ፥ ሀእ ፅንቃና” ያጋሱ።<verse eid="JHN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40"/>የሱሲ ማርታኮ፥ “ነ አማንያባ ግድኮ ፆሳ ቦንቹዋ በአናይሳ ታኒ ነዉ ኦዳብክና?” ያግስ። <verse eid="JHN 11:40"/><verse number="41" style="v" sid="JHN 11:41"/>ኤንቲ ሹቻ ደንን የሱሲ ሳሎ ፑደ ፄልድ፥ “አዋዉ፥ ታና ነ ስእዳ ግሾ ነና ጋላታይስ። <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/>ነ ኡባ ዎደ ታና ስኤይሳ ታኒ ኤራይስ። ሽን ሀይሳን ኤቅዳ አሳይ ኔኒ ታና ኪትዳይሳ አማናና መላ ታኒ ኤንታ ግሾ ሀይሳ ጋይስ” ያግስ። <verse eid="JHN 11:42"/><verse number="43" style="v" sid="JHN 11:43"/>የሱሲ ሄሳ ግዳፐ ጉየ፥ ባ ቃላ ቁ ኦድ፥ “አላዛራ፥ ሃ ከያ!” ያግስ። <verse eid="JHN 11:43"/><verse number="44" style="v" sid="JHN 11:44"/>ሀይቅዳ አደይ ዚትዳ መላ ኩሸይነ ቶሆይ ሻሎን ቃሸትድ ደእሽን እያ አይፈይ ካረይ ጎዘትዳ መላ ዱፉዋፐ ከይስ። የሱሲ ኤንታ፥ “ብርሽተ፥ ቦ ጊተ!” ያግስ።<verse eid="JHN 11:44"/></para>
  <para style="s1">ክርስቶሳ ቦላ ማቀትዶሶና</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ 26:1-5</ref>፤ <ref loc="MRK 14:1-2">ማር 14:1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ 22:1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>ሄሳ ግሾ፥ ማይራምኮ ይዳ አይሁደታፐ ዳሮት የሱሲ ኦዳይሳ በእድ እያ አማንዶሶና። <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>ሽን ኤንታፈ እሶት እሶት ፋርሳወታኮ ብድ የሱሲ ኦዳይሳ ኤንታዉ ኦድዶሶና። <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>ሄሳፈ ጉየ፥ ካህነ ሀላቃትነ ፋርሳወት ሻንጉዋ ሺሽድ፥ “ሀ አደይ ዳሮ ማላታታ ኦያ ግሾ ኑ አይ ኦኖ? <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>ኑኒ እያ ስእ ግድ አግኮ አሳ ኡባይ እያ አማናና። ቃስ ሮመ ቢታ አሳት ይድ ኑ ፆሳ ኬነ ኑ ደርያ ይሳና” ያግዶሶና።<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>ኤንታፈ እሶይ ቃያፋ ገይስ፥ ሄ ላይ ካህነ ሀላቃ ግድዳይስ፥ “ህንተ አይኮካ ኤረከታ! <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>አሳ ኡባይ የይሳፈ አሳ ኡባ ግሾ እስ አስ ሀይቀይስ ሎኦ ግደይሳ ኤረከቲ?” ያግስ። <verse eid="JHN 11:50"/><verse number="51" style="v" sid="JHN 11:51"/>እ ሄሳ ባፐ ግቤና። ሽን ሄ ላይ ካህነ ሀላቃ ግድያ ግሾ፥ የሱሲ አይሁደ አሳ ግሾ ሀይቃናዉ በሰይሳ ትንብተ ኦድስ። <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>ቃስ የሱሲ አይሁደ አሳ ፃላላስ ግዶናሽን ላለትድ ደእያ ፆሳ አሳ ኡባ እስፈ ሺሻናዉነ እስ አስ ኦናዉ ሀይቃና።<verse eid="JHN 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53"/>ሄ ጋላሳፐ ዶምድ ኤንቲ እያ ዎናዉ ማቀትዶሶና። <verse eid="JHN 11:53"/><verse number="54" style="v" sid="JHN 11:54"/>ሄሳ ግሾ፥ የሱሲ አይሁደታ ግዶን ቆንጨን ስመረትቤና። ሽን መላ ቢታ ማታን ደእያ ኤፍሬማ ጉታ ብስ። ባ ታማረታራ ሄ በሳን ጋምእስ።<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>አይሁደት ቦንችያ ፓስካ ጋላሳይ ማትስ። ቃስ ዳሮ አሳይ ባንታና ጌሻናዉ ፓስካ ቦንችያ ጋላሳይ ጋካናፐ ስን ሄ ቢታፈ የሩሳላመ ብዶሶና። <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>ኤንቲ ፆሳ ኬን ኤቅድ የሱሳ ዩሳ ናግያ ግሾ፥ “አይ ቆፔቲ? የሱሲ ባልያ ቦንቻናዉ ዬኔ?” ያግድ እሶይ እሱዋ ኦይችዶሶና። <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>ካህነ ሀላቃትነ ፋርሳወት የሱሳ ኦይካናዉ፥ እ ደእያሱዋ ኤርያ ኦንካ ባንታዉ ኦዳና መላ ኪትዶሶና።<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s1">የሱሳ ሽቶ ትይዳ ማጫስዉ</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማቶ 26:6-13</ref>፤ <ref loc="MRK 14:3-9">ማር 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>ፓስካ ቦንችያ ጋላሳፐ ኡሱፑን ጋላስ ስንትድ፥ የሱሲ ሀይቆፐ ደንዳ አላዛር ደእያ ጉታ፥ ብታነ ብስ። <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>ሄ በሳን ኤንቲ እያዉ ካሆ ጊግስዶሶና። አላዛር የሱሳራ እስፈ ጋይታ ቦላ ኡትዳሽን ማርት ኤንታና እማታዉሱ። <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/>ማይራማ ናርዶሰ ጌተትያ ዳሮ አልኦ ጌሻ ሽቶ ኤሀዳ የሱሳ ቶሁዋ ትያሱ። ባ ብናናን እያ ቶሁዋ ቁቻሱ፤ ኬ ኡባይ ሽቶ ሳዎን ቶንኩ ግስ።<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">ሉቃ 7:37-38</ref>.</char></note><verse eid="JHN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4"/>ሽን የሱሳ ታማረታፐ እሶይ፥ የሱሳ አድ እማናይስ፥ አስቆሮታ ይሁዳ፥ <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>“አይስ ሀ ሽቶይ ሄ ፄቱ ድናረን ባይዘትድ፥ ሚሸይ ማንቆታስ እመተኔ?” ያግስ። <verse eid="JHN 12:5"/><verse number="6" style="v" sid="JHN 12:6"/>እ ካይሶ ግድዳ ግሾ ሄሳ ግስፐ አትሽን፥ ማንቆታስ ቃትድ ግቤና። እ ሚሸ ካርፂታ ኦይከይሳ ግድያ ግሾ ኡባ ዎደ እያፐ ባዉ ኤኬስ።<verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>የሱሲ፥ “እያ ባዉ ደእያባ ታ ሞጎ ጋላሳስ ምንጅዳ ግሾ እዮ አጋግተ። <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/>ማንቆት ኡባ ዎደ ህንተራ ዳና፥ ሽን ታኒ ኡባ ዎደ ህንተራ ደእከ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ዛረ 15:11</ref>.</char></note><verse eid="JHN 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>ሄ ዎደ ዳሮ አሳይ የሱሲ ብታነን ደኤይሳ ስእድ ያ ብዶሶና። ኤንቲ የሱሳ ፃላላ ግዶናሽን፥ እ ሀይቆፐ ደንዳ አላዛራካ በአናዉ ብዶሶና። <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>ሄሳ ግሾ፥ ካህነ ሀላቃት አላዛራካ ቃስ ዎናዉ ማቀትዶሶና። <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>አይስ ጊኮ፥ አላዛራ ጋሶን ዳሮ አይሁደት ኤንታና እፅድ የሱሳ አማኖሶና።<verse eid="JHN 12:11"/></para>
  <para style="s1">ግታ ቦንቾን የሩሳላመ ገሉዋ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ 21:1-11</ref>፤ <ref loc="MRK 11:1-11">ማር 11:1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>ዎንተ ጋላስ ፓስካ ቦንችያ በሳ ይዳ ዳሮ አሳይ የሱሲ የሩሳላመ በይሳ ስእድ፥ <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>ዛምባ ሀይ ኤክድ እያ ሞካናዉ ከይዶሶና። ባንታ ቃላ ቁ ኦድ፥</para>
  <para style="q1" vid="JHN 12:13">“ሆሳና! ፆሳይ ጋላተቶ!</para>
  <para style="q2" vid="JHN 12:13">ጎዳ ሱንን የይስ አንጀቶ!</para>
  <para style="q2" vid="JHN 12:13">ፆሳይ እስራኤለ ካዋ አንጆ!”</para>
  <para style="m" vid="JHN 12:13">ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">ማዝ 118:25-26</ref>.</char></note><verse eid="JHN 12:13"/></para>
  <para style="p">
    <verse number="14-15" style="v" sid="JHN 12:14-15"/>ጌሻ ማፃፋን፥</para>
  <para style="q1" vid="JHN 12:14-15">“ፅዮነ ካታማዉ፥ ባቦፋ!</para>
  <para style="q2" vid="JHN 12:14-15">ሄኮ፥ ነ ካዎይ ሀረ ማራ ቦላ ኡትድ ዬስ”</para>
  <para style="m" vid="JHN 12:14-15">ጌተትዳያዳ የሱሲ ሀረ ማር ደምድ እያ ቶግስ።<note caller="-" style="x"><char style="xo" closed="false">12:14-15 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዛካ 9:9</ref>.</char></note><verse eid="JHN 12:14-15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>የሱሳ ታማረት ሄሳ ካሰ አኬክቦኮና። ሽን የሱሲ ቦንቸትዳፐ ጉየ ኤንቲ ሄሳ ኡባ አኬክዶሶና። ሄስ ኡባይ ጌሻ ማፃፋይ ግዳይሳዳ ሀንስ።<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>የሱሲ አላዛራ ዱፎፐ ፄግድ፥ ሀይቆፐ ደንዳ ዎደ እያራ ደእያ ዳሮ አሳይ የሱሳባ ማርካትዶሶና። <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>ዳሮ አሳይ እያ ሞካናዉ ከይዳይ፥ እ ሄ ማላታታ ኦዳይሳ ስእዳ ግሾሳ። <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>ሄሳ ግሾ፥ ፋርሳወት እሶይ እሱዋኮ፥ “ኑ አይኮካ ኦናዉ ዳንዳኦናይሳ በእተ፤ ደረ ኡባይ እያ ካሌስ” ያግዶሶና።<verse eid="JHN 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>ፓስካ ቦንችያ ጋላስ ጎይናናዉ የሩሳላመ ብዳይሳታ ግዶን እስ እስ ግርከ አሳት ደኦሶና። <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>ኤንቲ ጋልላ ቢታን ቤተሳይዳ ካታማፐ ይዳ ፍልጶሳኮ ብድ፥ “ጎዳዉ፥ ኑኒ የሱሳ በአናዉ ኮዮስ” ያግድ ዎስዶሶና። <verse eid="JHN 12:21"/><verse number="22" style="v" sid="JHN 12:22"/>ፍልጶስ ብድ እንድርያሳስ ኦድን ናምአይ ብድ፥ የሱሳስ ኦድዶሶና።<verse eid="JHN 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23"/>የሱሲ ኤንታኮ፥ “አሳ ናአይ፥ ቦንቸትያ ዎደይ ጋክስ። <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ እስ ግስተ አይፈይ ቢታን ዎድ ዎቆና እፅኮ ባርካ አቴስ። ሽን ሄ ግስተ አይፈይ ዎቅኮ ዳሮ አይፈ አይፌስ። <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/>ባ ሸምፑዋ ዶስያ ኦንካ ይሴስ፤ ባ ሸምፑዋ ሀ አላምያን እፅያ ኦንካ መርና ደኦስ አሼስ።<note caller="-" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ 10:39</ref>፤ <ref loc="MAT 16:25">16:25</ref>፤ <ref loc="MRK 8:35">ማር 8:35</ref>፤ <ref loc="LUK 9:24">ሉቃ 9:24</ref>፤ <ref loc="LUK 17:33">17:33</ref>.</char></note> <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/>ታኒ ደእያሱዋን ታራ ዳና መላ ታዉ ኦናዉ ኮይያ ኦንካ ታና ካላናዉ በሴስ። ታዉ ኦያ ኦናካ ታ አዋይ ቦንቻና።<verse eid="JHN 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27"/>“ሀእ ታ ሸምፖይ ዳሮ ኡንኤትስ፤ ያትን ዎይጎ? ‘ታ አዋዉ፥ ታና ሀ ሳተፐ አሻርክ’ ያጎ? አካይ፥ ታኒ ይዳይ ዋየ ኤካናሳ። <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/>ታ አዋዉ፥ ነ ሱን ቦንቻ” ያግስ።</para>
  <para style="p" vid="JHN 12:28">ሄ ዎደ ሳሎፐ፥ “ታኒ ታ ሱን ቦንቻስ፤ ዛራዳካ ቦንቻና” ግያ ቃላይ ይስ።<verse eid="JHN 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29"/>ሄ በሳን ኤቅዳ ዳሮ አሳይ ሄ ቃላ ስእድ፥ “ሄስ ዳዳ” ያግዶሶና።</para>
  <para style="p" vid="JHN 12:29">ሀራት ቃስ፥ “ኪታንቾይ እያዉ ኦድስ” ያግዶሶና።<verse eid="JHN 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30"/>የሱሲ ዛሪድ ኤንታኮ፥ “ሀ ቃላይ ህንተ ግሾ ይስፐ አትሽን፥ ታ ግሾ ግደና። <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/>ሀ አላመይ ፕርደትያ ዎደይ ሀእ፤ ሀ አላምያ ሃረይስ ሀእ ካረ ሆለታና። <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/>ቃስ ታኒ ሳአፐ ቁ ኦሰትዳ ዎደ አሳ ኡባ ታኮ ኤሀና” ያግስ። <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>እ ሄሳ ግዳይ አይ መላ ሀይቆ ሀይቃነኮ ኤንታዉ ቆንጭሳናሳ።<verse eid="JHN 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34"/>ዳሮ አሳይ ዛሪድ፥ “ኑ ህገይ ክርስቶስ መርናዉ ደኤይሳ ኦዴስ። ያትን፥ ኔኒ ዎይጋዳ፥ ‘አሳ ናአይ ቁ ጋናዉ በሴስ’ ጋይ? ‘እ፥ አሳ ናአይ ኦኔ?’ ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ 110:4</ref>፤ <ref loc="ISA 9:7">እሳ 9:7</ref>፤ <ref loc="DAN 7:14">ዳነ 7:14</ref>.</char></note><verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>የሱሲ፥ “ፖኦይ ህንተራ ጉ ዎደ ጋምአና። ህንተዉ ሞና መላ ፖኦይ ደእሽን፥ ፖኡዋን ሄመትተ። ማን ሄመትያ አስ አዉ ብያኮ ኤረና። <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/>ፖኦ ናይታ ግዳና መላ ፖኦይ ደእሽን ፖኡዋ አማንተ” ያግስ።</para>
  <para style="p" vid="JHN 12:36">የሱሲ ሄሳ ኦደትዳፐ ጉየ ብድ ኤንታፈ ጌምስ። <verse eid="JHN 12:36"/><verse number="37" style="v" sid="JHN 12:37"/>እ ሄሳ መላ ማላታታ ኤንታ ስንን ኦንካ አማንቦኮና። <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>ናብያ እሳያስ፥</para>
  <para style="q1" vid="JHN 12:38">“ጎዳዉ፥ ኑ ማርካተ ኦን አማንዴ?<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="ISA 53:1">እሳ 53:1</ref>.</char></note></para>
  <para style="q2" vid="JHN 12:38">ጎዳይ ባ ዎልቃ ኦደስ ቆንጭስዴ?”</para>
  <para style="m" vid="JHN 12:38">ግዳይስ ቱማ ግዳና መላ ኤንቲ እያ አማንቦኮና።<verse eid="JHN 12:38"/></para>
  <para style="p">
    <verse number="39-40" style="v" sid="JHN 12:39-40"/>ቃስካ እሳያስ፥</para>
  <para style="q1" vid="JHN 12:39-40">“ኤንታ አይፈይ ፄሎና መላ፥</para>
  <para style="q2" vid="JHN 12:39-40">ኤንታ ዎዛናይ አኬኮና መላ፥</para>
  <para style="q2" vid="JHN 12:39-40">ኤንቲ ፆሳኮ ስምን፥ እ ኤንታ ፓና መላ፥</para>
  <para style="q2" vid="JHN 12:39-40">ፆሳይ ኤንታ አይፍያ ቆቅስስ።</para>
  <para style="q1" vid="JHN 12:39-40">ኤንታ ዎዛና ምንስ”</para>
  <para style="m" vid="JHN 12:39-40">ግዳ ግሾ ኤንቲ አማናናዉ ዳንዳእቦኮና።<note caller="-" style="x"><char style="xo" closed="false">12:39-40 </char><char style="xt" closed="false"><ref loc="ISA 6:10">እሳ 6:10</ref>.</char></note><verse eid="JHN 12:39-40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41"/>እሳያስ ሄሳ ግዳይ፥ የሱሳ ቦንቹዋ በእዳ ግሾነ እያባ ኦድዳ ግሾሳ።<verse eid="JHN 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42"/>ግድኮካ፥ አይሁደታ ሀላቃታፐካ ዳሮት የሱሳ አማንዶሶና። ሽን ፋርሳወት ባንታና አይሁደታ ዎሳ ኬፈ ከሶሶና ግድ ያይዳ ግሾ አማንዳ ግድ ቆንጨን ማርካትቦኮና። <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>ሄሳ ኤንቲ ኦዳይ፥ ፆሳን ኤረታናይሳፈ አድ አሳን ኤረታናይሳ ዶስዳ ግሾሳ።<verse eid="JHN 12:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>የሱሲ ባ ቃላ ቁ ኦድ፥ “ታና አማንያ ኦንካ ታና ኪትዳይሳካ አማኔስፐ አትሽን፥ ታ ፃላላ አማነና። <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/>ታና በእያ ኦንካ ታና ኪትዳይሳካ በኤስ። <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/>ታና አማንያ ኡባይ ማን ዶና መላ ታኒ ፖኦ ግዳዳ አላምያ ያስ። <verse eid="JHN 12:46"/><verse number="47" style="v" sid="JHN 12:47"/>ታ ቃላ ስእድ ኪተቶና ኦናካ ታኒ ፕርድከ። አይስ ጊኮ፥ ታኒ አላምያ አሻናዉ ያስፐ አትሽን፥ ፕርዳናዉ ያቢከ። <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/>ታና እፀይሳነ ታ ቃላ ኤኮና ኦናካ ፕርደይስ ደኤስ። ታኒ ኦድዳ ቃላይ ዉርሰ ጋላስ ሄ ኡራ ፕርዳና። <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/>አይስ ጊኮ፥ ታኒ ሄሳ ታፐ ኦድከ፥ ሽን ታና ኪትዳ ታ አዋይ ታኒ ጋናይሳነ ኦዳናይሳ ኪትስ። <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/>ቃስ እያ ኪታይ መርና ደኦ ግደይሳ ታኒ ኤራይስ። ሄሳ ግሾ፥ ታኒ ኦደይስ ታ አዋይ ታና ኦዳ ግዳይሳ” ያግስ።<verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s1">የሱሲ ባ ታማረታ ቶሆ ሜጭስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>ፓስካ ቦንችያ ጋላሳይ ጋካናፐ ስንትድ ሀ አላምያ አግድ አዋኮ ብያ ዎደይ ጋክዳይሳ የሱሲ ኤርስ። ሀ አላምያን ደእያ ባ አሳ ኡባ ዎደ ዶስስ፤ ዉርሰ ጋካናዉካ ኤንታ ዶስስ።<verse eid="JHN 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2"/>የሱሳራነ እያ ታማረታራ እስፈ ካሆ ሞሶና። ሄሳፈ ካሰ ፃላሄይ ስሞና ናኣ አስቆሮታ ይሁድ የሱሳ አድ እማናዳ እያ ዎዛናን ኢታ ቆፋ ዎስ። <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>የሱሲ አዋይ ኡባባ እያ ኩሸን ዎዳይሳ፥ እ ፆሳ ማታፐ ይዳይሳነ ስሚድ እያኮ ባናይሳ ኤርስ። <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>የሱሲ ጋይታ ቦላፈ ደንድድ ቦላ ባጋ ማኡዋ ቃር ዎድ፥ ፖፃ ኤክድ ባ ፄሳን ማርፃፍስ። <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>ሄሳፈ ጉየ፥ ሃ ሜቻ ሚሸን ትግድ፥ ባ ታማረታ ቶሁዋ ሜጭስ፤ ቃስ ባ ፄሳን ዳንጭዳ ፖፃን ቁችስ።<verse eid="JHN 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6"/>የሱሲ ስሞና ጰፅሮሳኮ ያ ዎደ ጰፅሮስ፥ “ጎዳዉ፥ ነ ታ ቶሁዋ ሜጫኔ?” ያግስ።<verse eid="JHN 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7"/>የሱሲ ዛሪድ እያኮ፥ “ታኒ ኦይሳ ነ ሀእ ኤራካ፥ ሽን ጉየፐ አኬካና” ያግስ።<verse eid="JHN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8"/>ያትን፥ ጰፅሮስ፥ “ነ ታ ቶሁዋ ኡባራካ ሜጫካ” ያግስ።</para>
  <para style="p" vid="JHN 13:8">የሱሲ እያኮ፥ “ታኒ ነ ቶሁዋ ሜጮና እፅኮ ነዉነ ታዉነ እስፈተ ባዋ” ያግስ።<verse eid="JHN 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9"/>ጰፅሮስ የሱሳኮ፥ “ጎዳዉ፥ ያትኮ፥ ታ ቶሁዋ ፃላላ ግዶናሽን ታ ኩሽያነ ታ ሁጵያ ሜጫ” ያግስ።<verse eid="JHN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10"/>የሱሲ ዛሪድ፥ “ቦላ ሜጨትዳ ኦንካ ቶሆፐ ሀራባ ሜጨታናዉ ኮሸና፤ እያዉ ኡባሶይ ጌሽ። ህንተ ጌሽ፥ ሽን ኡባይ ጌሽ ግደከታ” ያግስ። <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>የሱሲ ባና አድ እማና ኡራይ ኦነኮ ኤርያ ግሾ፥ “ህንተ ኡባይ ጌሽ ግደከታ” ያግስ።<verse eid="JHN 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12"/>ኤንታ ቶሁዋ ሜጭዳፐ ጉየ፥ የሱሲ ባ ማኡዋ ዛር ማእስ። ስም ጋይታ ቦላ ኡትድ ኤንታኮ፥ “ታኒ ህንተዉ ኦዳይሳ አኬከቲ?<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="LUK 22:27">ሉቃ 22:27</ref>.</char></note> <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/>ህንተ ታና አስታማረነ ጎዳ ጌታ፤ ታኒ ህንተ ገይሳ ግድያ ግሾ ሎኦ ግደታ። <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/>ታኒ ህንተዉ ጎዳነ አስታማረ ግዳሸ ህንተ ቶሁዋ ሜጭኮ ህንተካ እሶይ እሱዋስ ሄሳዳ ኦናዉ በሴስ። <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/>ህዛ፥ ታኒ ህንተዉ ኦዳይሳዳ ህንተካ ኦና መላ ህንተዉ ሌምሶ ግዳስ። <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ አይለይ ባ ጎዳፐ፥ ኪተትዳይስ ኪትዳይሳፈ አና።<note caller="-" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="MAT 10:24">ማቶ 10:24</ref>፤ <ref loc="LUK 6:40">ሉቃ 6:40</ref>፤ <ref loc="JHN 15:20">ዮሀ 15:20</ref>.</char></note> <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/>ህንተ ሄሳ ኤርድ ኦያባ ግድኮ አንጀትዳይሳታ።<verse eid="JHN 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18"/>“ታኒ ህንተና ኡባ ጊከ፤ ታኒ ዶርዳይሳታ ኤራይስ። ሽን ጌሻ ማፃፋን፥ ‘ታ ባርስዳይስ ታ ኩሽያ ሳፅስ’ ጌተትዳይስ ቱማ ግዳናዉ በሴስ።<note caller="-" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ 41:9</ref>.</char></note> <verse eid="JHN 13:18"/><verse number="19" style="v" sid="JHN 13:19"/>‘ታኒ ታና ግደይሳ’ ህንተ አማናና መላ ሄስ ሀናናፐ ስንታዳ ህንተዉ ኦዳይስ። <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ታኒ ኪትዳ ኦናካ ሞክያ ኡራይ ታና ሞኬስ። ታና ሞክያ ኦንካ ታና ኪትዳይሳ ሞኬስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ 10:40</ref>፤ <ref loc="MRK 9:37">ማር 9:37</ref>፤ <ref loc="LUK 9:48">ሉቃ 9:48</ref>፤ <ref loc="LUK 10:16">10:16</ref>.</char></note><verse eid="JHN 13:20"/></para>
  <para style="s1">የሱሳ አድ እማና ኡራ</para>
  <para style="r">(<ref loc="MAT 26:20-25">ማቶ 26:20-25</ref>፤ <ref loc="MRK 14:17-21">ማር 14:17-21</ref>፤ <ref loc="LUK 22:21-23">ሉቃ 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>የሱሲ ሄሳ ኦድዳፐ ጉየ፥ ባ ዎዛናን ዳሮ ኡንኤትድ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ታና ህንተፈ እሶይ አድ እማና” ግድ ቆንጭስድ ኦድስ።<verse eid="JHN 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22"/>እ ኦደባ ኦድያኮ እያ ታማረታስ ኤረቶና እፅን እሶይ እሱዋ ፄልዶሶና። <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>እያ ታማረታፐ እሶይ፥ የሱሲ ዶሰይስ፥ የሱሳ ማታን ኡትስ። <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>ሄሳ ግሾ፥ ስሞን ጰፅሮስ እያ ቃምኦትድ፥ “እ ኦና ግያኮ አነ ኦይቻ” ያግስ።<verse eid="JHN 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25"/>ሄሳ ግሾ፥ ሄ ታማረይ የሱሳኮ ሺቅድ ሀይን፥ “ጎዳዉ፥ እ ኦኔ?” ያግስ።<verse eid="JHN 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26"/>የሱሲ ዛሪድ፥ “ታኒ ኡይ ዎፀን ቱሻዳ ባርሰይሳ” ያግስ። ቃስ ኡይ መን ኤክድ፥ ዎፀን ቱሽድ፥ ስሞና ናኣ አስቆሮታ ይሁዳ ባርስስ። <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>ይሁድ ኡይ ባርዳፐ ጉየ፥ ፃላሄይ ኤለስድ ይሁዳን ገልስ። የሱሲ እያኮ፥ “ኔኒ ኦናዉ ቆፕዳባ ኤለሳዳ ኦ” ያግስ። <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>ሽን ጋይታ ቦላ ኡትዳይሳታፐ ኦንካ የሱሲ ሄሳ አይስ እያኮ ግዳኮ ኤርቤና። <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>ይሁድ ሚሸ ኦይክያ ግሾ፥ እያ ታማረታፐ እሶት እሶት የሱሲ እያ፥ “ፓስካ ቦንችያ ጋላሳስ ባንታዉ ኮሽያባ ሻማ ዎይኮ ማንቆታስ ሙፃታ እማ ግስ” ያግድ ቆፕዶሶና።<verse eid="JHN 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30"/>ይሁድ ኡይ ባርዳ መላ ኤለስድ ካረ ከይስ። ሄ ዎደ ሳእ ቃማ።<verse eid="JHN 13:30"/></para>
  <para style="s1">ጰፅሮስ የሱሳ ካዳናይስ ኦደትስ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31"/>ይሁድ ካረ ከይዳፐ ጉየ፥ የሱሲ፥ “ሀእ አሳ ናአይ ቦንቸትስ፤ ፆሳይካ እያ ባጋራ ቦንቸትስ። <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/>ፆሳይ እያ ባጋራ ቦንቸትኮ እ ባ ሁጰን አሳ ናኣ ቦንቻና፤ ቃስ እ ሄሳ ኤለስድ ኦና። <verse eid="JHN 13:32"/><verse number="33" style="v" sid="JHN 13:33"/>ታ ናይቶ፥ ታኒ ህንተራ ዳሮ ዎደ ጋምእከ። ህንተ ታና ኮያና፥ ሽን ታኒ አይሁደታስ ኦድዳይሳ መላ፥ ‘ህንተ ታኒ ብያ በሳ ባናዉ ዳንዳኤከታ።’<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="JHN 7:34">ዮሀ 7:34</ref>.</char></note> <verse eid="JHN 13:33"/><verse number="34" style="v" sid="JHN 13:34"/>ታኒ ህንተዉ እምያ ኦራ ኪታይ ሀይሳ፤ እሶይ እሱዋ ዶስተ። ታኒ ህንተና ዶስዳይሳዳ ህንተ እሶይ እሱዋ ዶሳናዉ በሴስ።<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="JHN 15:12">ዮሀ 15:12</ref>፥ <ref loc="JHN 15:17">17</ref>፤ <ref loc="1JN 3:23">1 ዮሀ 3:23</ref>፤ <ref loc="2JN 1:5">2 ዮሀ 5</ref>.</char></note> <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/>ህንተ እሶይ እሱዋራ ዶሰትኮ ህንተ ታ ታማረ ግደይሳ አሳ ኡባይ ኤራና” ያግስ።<verse eid="JHN 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>ስሞን ጰፅሮስ የሱሳኮ፥ “ጎዳዉ፥ ኔኒ አዉ ባይ?” ያግስ።</para>
  <para style="p" vid="JHN 13:36">የሱሲ ዛሪድ፥ “ታኒ ብያ በሳ ኔኒ ሀእ ካላናዉ ዳንዳአካ፥ ሽን ጉየፐ ታና ካላና” ያግስ።<verse eid="JHN 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37"/>ጰፅሮስ፥ “ጎዳዉ፥ ታኒ ነና ሀእ ካላናዉ አይስ ዳንዳእክና? ታኒ ነ ግሾ፥ ሀይቃናዉካ ጊጋ ኡታስ” ያግስ።<verse eid="JHN 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38"/>የሱሲ ዛሪድ፥ “ታ ግሾ ሀይቃናዉ ቱማ ጊጋ ኡታዲ? ታኒ ነዉ ቱማ ኦዳይስ፤ ኩቶይ ዋሳናፐ ስን ኔኒ ታና ሄ ቶሆ ካዳና” ያግስ።<verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s1">የሱሲ አዋኮ ኤፍያ ኦገ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>የሱሲ ባ ታማረታኮ፥ “ህንተ ዎዛናይ ኡንኤቶፎ፥ ፆሳ አማንተ፥ ታናካ አማንተ። <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/>ታ አዋ ኬን ዳሮ በሲ ደኤስ። ታኒ ህንተዉ በሰ ጊግሳናዉ ባይስ። ሄሳ ግዶናኮ ታኒ ህንተዉ ኦድከሽን። <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/>ታኒ ባዳ በሰ ጊግስዳፐ ጉየ፥ ታኒ ደእያሱዋን ህንተ ዳና መላ ስማ ያዳ ህንተና ታኮ ኤፋና። <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/>ህንተ ታኒ ብያ በሳ ኤፍያ ኦግያ ኤሬታ” ያግስ።<verse eid="JHN 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>ያትን፥ ቶማስ፥ “ጎዳዉ፥ ኔኒ ብያ በሳ ኑኒ ኤሮኮ፤ ኦግያ ዋትድ ኤራናዉ ዳንዳአኔ?” ያግስ።<verse eid="JHN 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6"/>የሱሲ ዛሪድ፥ “ኦገይ፥ ቱማይነ ደኦይ ታና። ታ ባጋራ ግዶና እፅኮ ኦንካ ታ አዋኮ ባናዉ ዳንዳኤና። <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/>ህንተ ታና ኤርያባ ግድያኮ፥ ታ አዋካ ኤራና። ሽን ህዛፐ ዶምድ ህንተ እያ ኤሬታነ እያ በእደታ” ያግስ።<verse eid="JHN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8"/>ፍልጶስ የሱሳኮ፥ “ጎዳዉ፥ አዋ ኑና በሳ፤ ሄስ ኑስ ግዳና” ያግስ።<verse eid="JHN 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9"/>የሱሲ ዛሪድ፥ “ታኒ ሀይሳ መላ ዎደ ህንተራ ደእንካ ታና ኤርኪ? ታና በእዳ ኡራይ አዋካ በእስ። ያትን፥ ኔኒ ዎይጋዳ፥ ‘አዋ ኑና በሳ’ ጋይ? <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/>ታኒ አዋራ እስኖ ግደይሳነ አዋይካ ታራ እስኖ ግደይሳ ኔኒ አማንክዬ? ታኒ ህንተዉ ኦድያ ቃላ ታኒ ታፐ ኦድከ፥ ሽን ታናን ደእያ አዋይ ባ ኦሱዋ ኦስ። <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/>ታኒ አዋን ደኤይሳነ አዋይካ ታናን ደኤይሳ አማንተ። ሄሳ አማኖና እፅኮ ታ ኦያባታን ታና አማንተ።<verse eid="JHN 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 14:12"/>“ታኒ ህንተዉ ቱማ ኦዳይስ፤ ታና አማንያ ኡራይ ታኒ ኦያ ኦሱዋፐ አያ ኦሶ ኦና። ታኒ አዋኮ ብያ ግሾ ታና አማንያ ኦንካ ሀይሳፈ አያ ኦሶ ኦና። <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/>አዋይ ናኣ ባጋራ ቦንቸታና መላ ታ ሱንን ህንተ ዎስያ ኡባ ታ ህንተዉ ኦና። <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/>ታ ሱንን አይብባካ ህንተ ኦይችኮ ታ ህንተዉ ኦና።<verse eid="JHN 14:14"/></para>
  <para style="s1">የሱሲ ቃላ ገልዳ ጌሻ አያና</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>“ህንተ ታና ዶስኮ ታ ኪታ ናጋና። <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/>ታኒ አዋ ዎሳና፤ ህንተራ መርናዉ ዳና መላ ምንይሳ ህንተዉ እማና። <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/>ሄ አያናይ ፆሳ ቱማ ቆንጭሴስ። ሀ አላምያ አሳይ እያ በኦና ግሾነ ኤሮና ግሾ እያ ኤካናዉ ዳንዳኦኮና። ሽን እ ህንተራ ደእያ ግሾነ ህንተ ግዶን ዳና ግሾ ህንተ እያ ኤሬታ።<verse eid="JHN 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18"/>“ታኒ ህንተና አይያ አዉ ባይና ናአዳ ህንተ ፃላላ አግከ፤ ስማዳ ህንተኮ ያና። <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/>ጉ ዎደፐ ጉየ አላመይ ታና ዛር በኤና፥ ሽን ህንተ በአና። ታኒ ደኦን ደእያ ግሾ ህንተካ ደኦን ደአና። <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/>ታኒ ታ አዋን፥ ህንተ ታናን፥ ቃስ ታኒ ህንተናን ደኤይሳ ህንተ ሄ ጋላስ ኤራና።<verse eid="JHN 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21"/>“ታ ኪታ ኤክድ ናገይ ታና ዶሴስ። ታና ዶሰይሳ ታ አዋይካ ዶሴስ፤ ታንካ እያ ዶሳይስ፤ ታኒ እያዉ ቆንጫና” ያግስ።<verse eid="JHN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22"/>አስቆሮታ ይሁዳ ግዶና ይሁድ የሱሳኮ፥ “ጎዳዉ፥ ኔኒ ዋታዳ አላምያስ ግዶናሽን ኑስ ነና ቆንጭሳኔ?” ያግስ።<verse eid="JHN 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23"/>የሱሲ ዛሪድ፥ “ታና ዶስያ ኦንካ ታ ቃላስ ኪተታና። ታ አዋይ እያ ዶሳና። ቃስ ታ አዋይነ ታኒ እያኮ ይድ እያራ ዳና። <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/>ታና ዶሶና ኦንካ ታ ቃላስ ኪተተና። ህንተ ስእያ ቃላይ ታና ኪትዳ አዋባፐ አትሽን፥ ታባ ግደና።<verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>“ታኒ ህንተራ ሀእ ደአሸ ሄሳ ህንተዉ ኦዳስ። <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/>ሽን አዋይ ታ ሱንን ኪታና ምንያ ጌሻ አያናይ፥ ህንተና ኡባባ ታማርሳና። ታኒ ህንተዉ ኦድዳ ኡባ እ ህንተና ሀሳይሳና።<verse eid="JHN 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27"/>“ሳሮተ ህንተዉ እማና። ታኒ ታ ሳሮተ ህንተዉ እማና። ታ እምያ ሳሮተይ አላመይ እምያ ሳሮተ መላ ግደና። ሄሳ ግሾ፥ ኡንኤቶፍተ፥ ያዮፍተ። <verse eid="JHN 14:27"/><verse number="28" style="v" sid="JHN 14:28"/>‘ታኒ ባና፥ ሽን ስማዳ ህንተኮ ያና’ ግዳይሳ ስእደታ። ህንተ ታና ቱማ ዶስያባ ግድያኮ ታ አዋይ ታፐ አያ ግሾ ታኒ እያኮ በይሳን ህንተ ኡፋይታና። <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/>ሄስ ሀንያ ዎደ ህንተ አማናና መላ ሄስ ሀኖና ደእሽን ስንታዳ ታኒ ህንተዉ ኦዳስ።<verse eid="JHN 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 14:30"/>“ሀ አላምያ ሃረይስ ያ ግሾ ህዛፐ ጉየ ህንተራ ዳሮ ኦደትከ። ታና እ አይኮካ ኦናዉ ዳንዳኤና። <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/>ሽን ታኒ አዋ ዶሰይሳ አላመይ ኤራና መላ ታ አዋይ ታና ኪትዳይሳ ኡባ ኦይስ። ደንድተ፤ ሀይሳፈ ቦስ።<verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s1">ዎይነ ኡባነ ታሸታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>“ታኒ ቱማ ዎይነ ኡባ። ጎሻንቾይ ታ አዋ። <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/>እ፥ ታ ቦላ ደእያ አይፈ አይፎና ታሽያ ኡባ ካሬስ። አይፍያ ታሽያ ካሰፐ አድ አይፋና መላ ሄ ታሽያ እ ጊግሳና። <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/>ታኒ ህንተዉ ኦድዳ ቃላ ግሾ ህንተ ጌሽ። <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/>ታናን ደእተ፤ ታንካ ህንተናን ደአና። ዎይነ ታሸይ ኡባራ ዶና እፅኮ ሄ ታሸይ ባርካ አይፈ አይፋናዉ ዳንዳኤና። ሄሳዳካ፥ ህንተካ ታናን ደኦና እፅኮ አይፈ አይፋናዉ ዳንዳኤከታ።<verse eid="JHN 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5"/>“ታኒ ዎይነ ኡባ፤ ህንተ ታሸታ። ታናን ደኤይስነ ታኒ እያን ደኤይስ፥ እ ዳሮ አይፈ አይፋና። ታ ባይና ህንተ ፃላላ አይኮካ ኦናዉ ዳንዳኤከታ። <figure style="fig" alt="Grape vine on trellis" file="HK00112B.tif" size="span" ref="15:5">ዎይነ ምነ እያ አይፍያ</figure> <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/>ታናን ዶና ኡራይ ታሽያዳ ካረን የግትድ መላና። ሄሳ መላ ታሸት ሺቅድ ታማን የገታና፥ ፁገታና። <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/>ህንተ ታናን ደእኮ፥ ታ ቃላይካ ህንተናን ደእኮ፥ ህንተ ኮይያባይ አይባ ግድኮካ ዎስተ፤ ህንተ ኤካና። <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/>ህንተ ዳሮ አይፈ አይፍያ ታ ታማረ ግድኮ፥ ሄሳን ታ አዋይ ቦንቸታና። <verse eid="JHN 15:8"/><verse number="9" style="v" sid="JHN 15:9"/>አዋይ ታና ዶሰይሳዳ ታንካ ህንተና ዶሳይስ፤ ታ ሲቁዋን ደእተ። <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/>ታኒ ታ አዋ ኪታ ናጋዳ እያ ሲቁዋን ደእዳይሳዳ ህንተካ ታ ኪታ ናግኮ ታ ሲቁዋን ዳና።<verse eid="JHN 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11"/>“ታ ኡፋይሳይ ህንተናን ግዳና መላነ ህንተ ኡፋይሳይ ፖሎ ግዳና መላ ታኒ ህንተዉ ሄሳ ኦዳስ። <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/>ታ ኪታይ ሀይሳ፤ ታኒ ህንተና ዶስዳይሳዳ ህንተካ እሶይ እሱዋ ዶስተ።<note caller="-" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሀ 13:34</ref>፤ <ref loc="JHN 15:17">15:17</ref>፤ <ref loc="1JN 3:23">1 ዮሀ 3:23</ref>፤ <ref loc="JUD 1:5">ይሁ 5</ref>.</char></note> <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/>ባ ሸምፑዋ ባ ላግያስ አድ እመይሳፈ አያ ግታ ሲቆይ ባዋ። <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/>ታኒ ህንተና ኪትዳባ ኡባ ኦኮ ህንተ ዶሰትዳይሳታ።<verse eid="JHN 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 15:15"/>“አይለይ ባ ጎዳይ ኦያባ ኤሮና ግሾ ታኒ ህንተና ህዛፐ ጉየ አይለታ ጊከ። ሽን ታ አዋፐ ስእዳ ኡባ ታኒ ህንተዉ ኦድዳ ግሾ ህንተና ዶሰትዳይሳታ ጋስ። <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/>ታኒ ህንተና ዶራስፐ አትሽን፥ ህንተ ታና ዶርበከታ። ህንተ ብድ ዮና አይፈ አይፋና መላ ታኒ ህንተና ሹማስ። ያንኮ፥ ታ አዋይ ህንተ ታ ሱንን ዎስዳባ ኡባ እማና። <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/>ታ ኪታይ ሀይሳ፦ እሶይ እሱዋ ዶስተ።<verse eid="JHN 15:17"/></para>
  <para style="s1">አላመይ የሱሳ ታማረታ እፃና</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>“አላመይ ህንተና እፅኮ ኮይሮትድ ታና እፅዳይሳ አኬክተ። <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/>ህንተ አላምያባ ግድያኮ አላመይ ህንተና ዶሳና። ሽን ታኒ ህንተና አላመፐ ዶርዳ ግሾነ ህንተ አላምያባ ግዶና ግሾ አላመይ ህንተና እፄስ። <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/>‘አይለይ ባ ጎዳፐ አና’ ጋዳ ታኒ ህንተዉ ኦድዳይሳ አኬክተ። ኤንቲ ታና ጎድዳባ ግድኮ ህንተናካ ጎዳና። ኤንቲ ታ ቃላ ናግዳባ ግድኮ ህንተ ቃላካ ናጋና።<note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="MAT 10:24">ማቶ 10:24</ref>፤ <ref loc="LUK 6:40">ሉቃ 6:40</ref>፤ <ref loc="JHN 13:16">ዮሀ 13:16</ref>.</char></note> <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/>ሽን ኤንቲ ታና ኪትዳይሳ ኤሮና ግሾ ሀ ኡባ ታ ጋሶን ህንተ ቦላ ኦና። <verse eid="JHN 15:21"/><verse number="22" style="v" sid="JHN 15:22"/>ታኒ ያዳ ኤንታዉ ኦዶናባ ግድያኮ ናጋራ ግደና። ሽን ሀእ ኤንቲ ኦዳ ናጋራስ ጋሶያባይ ባዋ። <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/>ታና እፀይስ ታ አዋካ እፄስ። <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/>ኦንካ ኦቦና ኦሶ ታ ኤንታ ግዶን ኦቦናባ ግድያኮ ኤንታዉ ናጋራ ግዶና አታና። ሽን ሀእ ኤንቲ ታኒ ኦዳ ኦሱዋ በእድ ታናካ ታ አዋካ እፅዶሶና። <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/>ሽን ኤንታ ህግያን፥ ‘ታና ጮ እፅዶሶና’ ጌተትድ ፃፈትዳይስ ፖለታና መላ ሄስ ሀንስ።<note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 35:19">ማዝ 35:19</ref>፤ <ref loc="PSA 69:4">69:4</ref>.</char></note><verse eid="JHN 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>“አዋፐ ያ ቱማ ቆንጭስያ አያና ታ ህንተዉ ኪታና። እ ህንተና ምንና፥ ታባ ማርካታና። <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/>ህንተካ ኮይሮፐ ዶምድ ታራ ደእያ ግሾ ታባ ማርካታና።<verse eid="JHN 15:27"/></para>
  <para style="b"/>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>“ታኒ ሄሳ ህንተ አማኖይ ዮና መላ ህንተዉ ኦዳስ። <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/>ኤንቲ ህንተና አይሁደ ዎሳ ኬታፐ ከስ የዳና። ሄሳዳካ፥ ህንተና ዎያ ኦንካ ፆሲ ኮያባ ኦያ ዳንያ ዎደይ ያና። <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/>ኤንቲ ሄሳ ህንተ ቦላ ኦይ ታና ዎይኮ አዋ ኤሮና ግሾሳ። <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/>ሽን ኤንቲ ሄሳ ህንተ ቦላ ኦያ ዎደይ ጋክያ ዎደ ታኒ ህንተዉ ኦድዳይሳ ህንተ አኬካና መላ ታኒ ህንተዉ ሀይሳ ኦዳስ።</para>
  <para style="p" vid="JHN 16:4">“ስንታዳ ታኒ ሀይሳ ህንተዉ ኦዶና ጋምእዳይ ታ ህንተራ ደእያ ግሾሳ። <verse eid="JHN 16:4"/><verse number="5" style="v" sid="JHN 16:5"/>ሽን ሀእ ታኒ ታና ኪትዳይሳኮ ባይስ፤ ህንተፈ ኦንካ፥ ‘አዉ ባይ?’ ግድ ታና ኦይቸይ ባዋ። <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/>ሽን ታኒ ሄሳ ኦድዳ ግሾ፥ ህንተ ዎዛናን ዳሮ አዛኖይ ደኤስ። <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/>ሽን ታኒ ህንተዉ ቱማ ኦዳይስ፤ ታኒ ቢኮ ህንተዉ ሎኦ። አይስ ጊኮ፥ ታኒ ቦና እፅኮ ምንይስ ህንተኮ ዬና። ሽን ታኒ ቢኮ እያ ህንተኮ የዳና። <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/>ምንይስ ይድ፥ ናጋራባ፥ ፅሎተባነ ፕርዳባ ሀ አላምያ አሳ ኤርሳና። <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/>ናጋራባይ፥ አሳይ ታና አማኖና ግሾሳ። <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/>ፅሎተባይ፥ ታኒ አዋኮ ብያ ግሾነ ህንተ ታና ዛር በኦና ግሾሳ። <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/>ፕርዳባይ፥ ቃስ አላምያ ሃረይስ ፕርደትዳ ግሾሳ።<verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>“ታኒ ህንተዉ ኦድያባይ ዳሮባይ ደኤስ፥ ሽን ሀእ ህንተዉ ገለና። <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/>ቱማ አያናይ ያ ዎደ ህንተና ቱማተ ኡባኮ ካለና። እ ስእዳባ ኦዴስፐ አትሽን፥ ባፐ አይብባካ ኦደና። ቃስ ስንፈ ያናባ ህንተዉ እ ኦዳና። <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/>እ ታዉ ደኤይሳፈ ኤክድ ህንተዉ ኦድያ ግሾ እ ታና ቦንቻና። <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/>አዋስ ደእያባ ኡባይ ታባ፤ ‘ምንይስ ታዉ ደኤይሳፈ ኤክድ ህንተዉ ኦዳና’ ታኒ ግዳይ ሄሳሳ።<verse eid="JHN 16:15"/></para>
  <para style="s1">ህንተ አዛኖይ ኡፋይሳን ላመታና</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>“ጉ ዎደፐ ጉየ ታና በኤከታ፤ ቃስ ጉ ዎደፐ ጉየ ህንተ ታና በአና” ያግስ።<verse eid="JHN 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17"/>እያ ታማረታፐ እሶት እሶት ባንታ ግዶን፥ “ጉ ዎደፐ ጉየ ህንተ ታና በኤከታ፤ ቃስ ጉ ዎደፐ ጉየ ህንተ ታና በአና፤ ቃስካ ታኒ አዋኮ ባይስ ጉሳይ ዎይ ጉሴ?” ያግዶሶና። <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>“ጉ ዎደፐ ጉየ ገይስ ዎይ ጉሴ? እ አይ ኦደትያኮ ኑስ ኤረተና” ያግዶሶና።<verse eid="JHN 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19"/>ኤንቲ ባና ኦይቻናዉ ኮየይሳ የሱሲ ኤርድ፥ “ታኒ፥ ‘ጉ ዎደፐ ጉየ ታና በኤከታ፤ ቃስ ጉ ዎደፐ ጉየ ህንተ ታና በአና’ ግዳይሳስ ህንተ እሶይ እሱዋ ኦይቼቲ? <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተ ዬካናነ አፉፃና፥ ሽን ሀ አላመይ ኡፋይታና። ሀእ ህንተ አዛናና፥ ሽን ህንተ አዛኖይ ኡፋይሳን ላመታና። <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/>እስ ማጫስያ ናአ የላና ሀንያ ዎደ ባ የሎ ዎደይ ጋክዳ ግሾ ህርጋዉሱ። ሽን ናአ የልዳፐ ጉየ ናእ ሀ አላምያን የለትዳ ኡፋይሳ ግሾ ባ ኡንኣ ዶጋዉሱ። <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/>ሄሳዳካ፥ ህንተካ ህንተ ዎዛናን አዛኔታ፥ ሽን ታኒ ህንተና ዛራዳ በአና። ህንተ ዎዛናይ ዳሮ ኡፋይታና፤ ሄ ኡፋይሳ ኦንካ ህንተፈ ኤከና።<verse eid="JHN 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23"/>“ሄ ጋላስ ህንተ ታና አይብባካ ዎሰከታ። ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተ ታ ሱንን ዎስያባ ኡባ አዋይ ህንተዉ እማና። <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/>ሀእ ጋካናዉ ታ ሱንን አይብባካ ዎስበከታ። ህንተ ኡፋይሳይ ፖሎ ግዳና መላ ፆሳ ዎስተ፤ ህንተ ኤካና።<verse eid="JHN 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>“ታኒ ሀእ ጋካናዉ ህንተዉ ሌምሶን ኦዳስ፥ ህዛፐ ታኒ ሌምሶን ኦዶና ዎደይ ያና። ሽን አዋባ ታኒ ህንተዉ ቆንጨን ኦዳና። <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/>ሄ ጋላስ ህንተ ታ ሱንን አዋ ዎሳና፤ ህንተ ግሾ ታኒ አዋ ዎስከ። <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/>አይስ ጊኮ፥ አዋይ ባ ሁጰን ህንተና ዶሴስ። ህንተ ታና ዶስያ ግሾነ ታኒ አዋ ማታፐ ይዳይሳ አማንዳ ግሾ፥ እ ህንተና ዶሴስ። <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/>ታኒ አዋ ማታፐ ሀ አላምያ ያስ፤ ቃስ አላምያ አጋዳ አዋኮ ባና” ያግስ።<verse eid="JHN 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29"/>እያ ታማረት ዛሪድ፥ “ሄኮ፥ ሀእ ኔኒ ቆንጨን ኦዳሳ፤ ሌምሶን አይኮካ ኦዳካ። <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>ኔኒ ኡባባ ኤረይሳ ኑኒ ሀእ ኤሮስ፤ ቃስ ነና ኦንካ ኦይቻና መላ ኔኒ ኮያካ። ሄስ ኑና ኔኒ ፆሳፈ ኪተትዳይሳ አማንስ” ያግዶሶና።<verse eid="JHN 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31"/>ያትን፥ የሱሲ ዛሪድ ኤንታኮ፥ “ሀእ አማነቲ? <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/>ሄኮ፥ ህንተ፥ ህንተ ሶ ህንተ ሶ ላለትያ ዎደይነ ታ ፃላላ የግ አግድ ባቃትያ ዎደይ ያና፤ ሀእካ ይክችስ። ሽን አዋይ ታራ ደእያ ግሾ ታኒ ታ ፃላላ ግድከ። <verse eid="JHN 16:32"/><verse number="33" style="v" sid="JHN 16:33"/>ህንተ ታራ ደእሸ ሳሮይ ህንተዉ ዳና መላ ታኒ ሄሳ ኦዳስ። አላመን ደእሸ ህንተ ዋየታና። ሽን ምንተ፤ ታኒ አላምያ ፆናስ” ያግስ።<verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s1">የሱሳ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>የሱሲ ሄሳ ኦድዳፐ ጉየ ፑደ ሳሎ ፄልድ፥ ሀይሳዳ ያግስ፦ “አዋዉ፥ ሳተይ ጋክስ፤ ነ ናአይ ነና ቦንቻና መላ ኔኒ ነ ናኣ ቦንቻ። <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/>ኔኒ እያዉ እምዳ ኡባስ እ መርና ደኡዋ እማና መላ አሳ ኡባ ቦላ እያዉ ማታ እማዳሳ። <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/>መርና ደኦይ፥ ነና፥ እስ ቱማ ፆሳነ ነ ኪትዳ የሱስ ክርስቶሳ ኤሮ። <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/>ኔኒ ታ ኦና መላ እምዳ ኦሱዋ ፖላዳ ነና ሳአን ቦንቻስ። <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/>ሀእካ፥ አዋዉ፥ አላመይ መታናፐ ስን ነ ማታን ታዉ ደእያ ቦንቹዋን ታና ቦንቻ።<verse eid="JHN 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6"/>“አላምያ አሳፐ ኔኒ ታዉ እምዳይሳታ ነና ኤርሳስ። ኤንቲ ነይሳታ፤ ኔኒ ኤንታ ታዉ እማዳሳ። ኤንቲ ነ ቃላስካ ኪተትዶሶና። <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/>ኔኒ ታዉ እምዳ ኡባባይ ኔፐ ይዳይሳ ኤንቲ ሀእ ኤሮሶና። <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/>ኔኒ ታዉ እምዳ ቃላ ታኒ ኤንታዉ እማስ፤ ኤንትካ ሄ ቃላ ኤክዶሶና። ታኒ ነ ማታፐ ይዳይስ ቱማ ግደይሳ ኤርድ ኔኒ ታና ኪትዳይሳካ አማንዶሶና።<verse eid="JHN 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9"/>“ታኒ ኤንታዉ ዎሳይስ። ኤንቲ ነይሳታ ግድያ ግሾ ኔኒ ታዉ እምዳ አሳስ ዎሳይስፐ አትሽን፥ አላምያስ ዎስከ። <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/>ታዉ ደእያ ኡባባይ ነባ፤ ነዉ ደእያ ኡባይካ ታባ። ታኒ ኤንታ ባጋራ ቦንቸታስ። <verse eid="JHN 17:10"/><verse number="11" style="v" sid="JHN 17:11"/>ታኒ ህዛፐ ጉየ አላምያን ደእከ፤ ኤንቲ አላመን ደኦሶና። ታኒ ሀእ ኔኮ ባይስ። ጌሻ አዋዉ፥ ሀ ኔኒ ታዉ እምዳይሳት ኔራነ ታራ እስኖ ግድዳይሳዳ ኤንቲ እስኖ ግዳና መላ ኤንታ ነ ታዉ እምዳ ነ ሱንን ናጋ። <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/>ታኒ ኤንታራ ሳአን ደአሸ፥ ነ ታዉ እምዳ ነ ሱን ዎልቃን ኤንታ ናጋስ። ጌሻ ማፃፋይ ግዳይስ ፖለታና መላ ዮይ በሲያ ኡራፐ አትሽን፥ ኤንታፈ ሀር ኦንካ ይቤና።<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ 41:9</ref>፤ <ref loc="JHN 13:18">ዮሀ 13:18</ref>.</char></note><verse eid="JHN 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13"/>“ሀእ ታኒ ኔኮ ባይስ። ታ ኡፋይሳይ ኤንታ ዎዛናን ፖሎ ግዳና መላ ሀይሳ ታኒ አላመን ደአሸ ኦዳይስ። <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/>ታኒ ኤንታዉ ነ ቃላ እማስ። ታኒ አላምያፐ ግዶናይሳዳ፥ ኤንትካ አላሚያፐ ግዶና ግሾ፥ አላመይ ኤንታ እፅስ። <verse eid="JHN 17:14"/><verse number="15" style="v" sid="JHN 17:15"/>ኔኒ ፃላሄፐ ኤንታ ናጋና መላፐ አትሽን፥ አላመፐ ከሳና መላ ዎስከ። <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/>ታኒ አላመፐ ግዶናይሳዳ ኤንትካ አላመፐ ግዶኮና። <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/>ኔኒ ነ ቱማተን ኤንታ ነባ ኦ፤ ነ ቃላይካ ቱማ። <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/>ኔኒ ታና አላምያ ኪትዳይሳዳ ታንካ ኤንታ አላምያ ኪታስ። <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/>ቃስ ኤንቲ ቱማ ነባ ግዳና መላ ኤንታ ግሾ ታኒ ታ ሁጵያ ነዉ እማይስ።<verse eid="JHN 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20"/>“ታኒ ኤንታ ፃላላስ ግዶናሽን ኤንቲ ቃላ ኦድን፥ ታና አማናናይሳታስካ ዎሳይስ። <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/>ኤንቲ ኡባይ እስኖ ግዳና መላ ታኒ ዎሳይስ። አዋዉ፥ ነ ታናን ደኤይሳዳ፥ ቃስ ታ ነናን ደኤይሳዳ ኤንቲ ኑናን ዳና መላ ዎሳይስ። ሄ ዎደ ኔኒ ታና ኪትዳይሳ አላመይ አማናና። <verse eid="JHN 17:21"/><verse number="22" style="v" sid="JHN 17:22"/>ኔንነ ታኒ እስኖ ግደይሳዳ፥ ኤንቲ እስኖ ግዳና መላ፥ ኔኒ ታና ቦንችዳይሳዳ፥ ታንካ ኤንታ ቦንቻስ። <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/>ታኒ ኤንታን፥ ኔኒ ታናን ደኤይሳዳ ኤንቲ ፖሎ እስኖ ግዳና መላ ነና ዎሳይስ። ሄስካ፥ ነ ታና ኪትዳይሳነ ነ ታና ዶስዳ ዶሱዋን ኤንታ ሲቅዳይሳ አላመይ ኤራን መላሳ።<verse eid="JHN 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24"/>“አዋዉ፥ ኔኒ ታዉ እምዳይሳት ታኒ ደእያሱዋን ታራ ዳና መላ ኮያይስ። አላመይ መታናፐ ስን ኔኒ ታና ዶስዳ ግሾ፥ ታዉ እምዳ ታ ቦንቹዋ ኤንቲ በአና።<verse eid="JHN 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 17:25"/>“ጌሻ አዋዉ፥ አላመይ ነና ኤረና፥ ሽን ታኒ ኤራይስ። ቃስ ኔኒ ታና ኪትዳይሳ ሀይሳቲ ኤሮሶና። <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/>ኔኒ ታና ሲቅዳ ሲቆይ ኤንታናን ዳና መላ፥ ቃስ ታኒ ኤንታናን ግዳና መላ፥ ታኒ ነ ሱን ኤንታ ኤርሳስ፤ ስንስካ ኤርሳና” ያግስ።<verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s1">የሱሲ ኦይከትስ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ 26:47-56</ref>፤ <ref loc="MRK 14:43-50">ማር 14:43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>የሱሲ ዎሳ ኦንግዳፐ ጉየ፥ ባ ታማረታራ ቀድሮና ዛንጋራ ፕንድ፥ ሄ በሳን ደእያ አታክልትያ ግዶ ገልዶሶና። <verse eid="JHN 18:1"/><verse number="2" style="v" sid="JHN 18:2"/>የሱሲ ኡባ ዎደ ባ ታማረታራ ያን ሺቅያ ግሾ የሱሳ አድ እምዳ ይሁድ ሄ በሳ ኤሬስ። <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>ሄሳ ግሾ፥ ይሁድ ፓኖሰ፥ ፆምፐ፥ ቶራነ ጎንዳለ ኦይክዳ ዳሮ ዎታዳረታ፥ ካህነ ሀላቃትነ ፋርሳወት ኪትዳ ፆሳ ኬ ናግያ ዎታዳረታ ካለ ኤክድ፥ ሄ በሳ ብስ።<verse eid="JHN 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4"/>የሱሲ ባና ጋካና ሀንያባ ኡባ ኤርድ፥ ጋፃ ከይድ፥ “ኦና ኮዬቲ?” ያግስ።<verse eid="JHN 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5"/>ኤንቲ ዛሪድ፥ “ናዝረተ የሱሳ ኮዮስ” ያግዶሶና።</para>
  <para style="p" vid="JHN 18:5">እ ዛሪድ፥ “ታኒ የሱሳ” ያግስ።</para>
  <para style="p" vid="JHN 18:5">የሱሳ አድ እምዳ ይሁድ ያን ኤንታራ ኤቅስ። <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>እ፥ “ታኒ የሱሳ” ግዳ ዎደ ኤንቲ ጉየ ሺቅድ፥ ሳአን ኩንድዶሶና። <verse eid="JHN 18:6"/><verse number="7" style="v" sid="JHN 18:7"/>የሱሲ ቃስካ፥ “ኦና ኮዬቲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="JHN 18:7">ኤንቲ፥ “ናዝረተ የሱሳ ኮዮስ” ያግዶሶና።<verse eid="JHN 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8"/>እ ዛሪድ፥ “ታኒ የሱሳ ግደይሳ ህንተዉ ኦዳስ። ህዛ፥ ህንተ ታና ኮያባ ግድኮ ሀይሳታ የድተ” ያግስ። <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>እ ሄሳ ግዳይ፥ “አዋዉ፥ ኔኒ ታዉ እምዳይሳታፐ ሀር አቶሽን እሱዋካ ይሳብከ” ግዳይስ ፖለታና መላሳ።<verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>ስሞን ጰፅሮሳስ ማሻይ ደኤስ። እ ሄ ማሻ ሾድድ ካህነ ሀላቃ አይልያስ ኡሻቻ ሀይ ሾጭድ፥ ቃንፅ የግስ። ሄ አይልያ ሱንይ ማልኮሳ። <verse eid="JHN 18:10"/><verse number="11" style="v" sid="JHN 18:11"/>የሱሲ ጰፅሮሳኮ፥ “ነ ማሻ ሾሁዋን ዛራ። ታ አዋይ ታዉ እምዳ ፁአፐ ታኒ ኡዮናባ ነዉ ዳኒ?” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="MAT 26:39">ማቶ 26:39</ref>፤ <ref loc="MRK 14:36">ማር 14:36</ref>፤ <ref loc="LUK 22:42">ሉቃ 22:42</ref>.</char></note><verse eid="JHN 18:11"/></para>
  <para style="s1">የሱሲ ሃና ስንን</para>
  <para style="r">(<ref loc="MAT 26:57-58">ማቶ 26:57-58</ref>፤ <ref loc="MRK 14:53-54">ማር 14:53-54</ref>፤ <ref loc="LUK 22:54">ሉቃ 22:54</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>ሮመ ዎታዳረትነ ኤንታ ሀላቃይ ፆሳ ኬ ናግያ ዎታዳረታራ እስፈ የሱሳ ኦይክድ ቃችዶሶና። <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>ኮይሮ የሱሳ ሃናኮ ኤፍዶሶና። ሃን ሄ ላይ ካህነ ሀላቃ ግድያ ቃያፋ ቦሎ። <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>ቃያፍ፥ “አሳ ኡባ ግሾ፥ እስ አስ ሀይቅኮ ሎኦ” ግድ ካሰ አይሁደታ ዞርዳይሳ።<note caller="-" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="JHN 11:49-50">ዮሀ 11:49-50</ref>.</char></note><verse eid="JHN 18:14"/></para>
  <para style="s1">ጰፅሮስ የሱሳ ኮይሮ ካዱዋ</para>
  <para style="r">(<ref loc="MAT 26:69-70">ማቶ 26:69-70</ref>፤ <ref loc="MRK 14:66-68">ማር 14:66-68</ref>፤ <ref loc="LUK 22:55-57">ሉቃ 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>ስሞን ጰፅሮስነ ሀራ እስ ታማረይ የሱሳ ካልድ ብዶሶና። ካህነ ሀላቃይ ሄ ሀራ ታማርያ ሎይ ኤሬስ። ሄሳ ግሾ፥ እ የሱሳራ ካህነ ሀላቃ ዛባ ገልስ። <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>ሽን ጰፅሮስ ካረራ ድርሳ ፐንገን ኤቅስ። ካህነ ሀላቃይ ኤርያ ሀራ ታማረይ ካረ ከይድ፥ ፐንግያ ናግያ ናኤስ ኦድድ፥ ጰፅሮሳ ጋ ገልስስ። <verse eid="JHN 18:16"/><verse number="17" style="v" sid="JHN 18:17"/>ፐንግያ ናግያ ናእያ ጰፅሮሳኮ፥ “ኔኒ፥ ሄ አድያ ታማረታፐ እሱዋ ግድኪ?” ያጋሱ።</para>
  <para style="p" vid="JHN 18:17">ጰፅሮስ ዛሪድ፥ “አካይ፥ ታኒ ግድከ” ያግስ።<verse eid="JHN 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18"/>ሳአይ ሜግያ ግሾ፥ አይለትነ ናገይሳት ፂፋ ታማ ኤድ፥ ካዮሶና። ጰፅሮስካ ኤንታራ ኤቅድ ታማ ካዬስ።<verse eid="JHN 18:18"/></para>
  <para style="s1">ካህነ ሀላቃይ የሱሳ ኦይችስ</para>
  <para style="r">(<ref loc="MAT 26:59-66">ማቶ 26:59-66</ref>፤ <ref loc="MRK 14:55-64">ማር 14:55-64</ref>፤ <ref loc="LUK 22:66-71">ሉቃ 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>ካህነ ሀላቃይ የሱሳ፥ እያ ታማረታባነ እያ ትምርትያባ ኦይችስ። <verse eid="JHN 18:19"/><verse number="20" style="v" sid="JHN 18:20"/>የሱሲ ዛሪድ፥ “ታኒ አሳ ኡባስ ቆንጨን ኦዳስ። ታኒ አይሁደ ኡባይ ሺቅያ አይሁደ ዎሳ ኬንነ ፆሳ ኬን ኡባ ዎደ ታማርሳስ። ጌማን አይኮካ ኦዳብከ። <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/>ያትን፥ ኔኒ ታና አይስ ኦይቻይ? ታ ኦድሽን ስእዳ አሳ ኦይቻ። ሄ አሳይ ታኒ ኦድዳይሳ ኤሮሶና” ያግስ።<verse eid="JHN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22"/>የሱሲ ሄሳ ግዳ ዎደ፥ ሄ በሳን ኤቅዳ ዎታዳረታፐ እሶይ የሱሳ ባቅድ፥ “ካህነ ሀላቃስ ሀይሳዳ ዛራይ?” ያግስ።<verse eid="JHN 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23"/>የሱሲ ዛሪድ፥ “ታኒ ኢታባ ኦድዳባ ግድኮ ሀይሳን ደእያ አሳ ኡባ ስንን ኦዳ። ሽን ታኒ ቱማ ኦድዳባ ግድኮ ታና አይስ ባቃይ?” ያግስ።<verse eid="JHN 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24"/>ሄሳ ግሾ፥ ሃን፥ የሱሲ ቃሸትዳ መላ ካህነ ሀላቃ ቃያፋኮ የድስ።<verse eid="JHN 18:24"/></para>
  <para style="s1">ጰፅሮስ የሱሳ ናምአን ካድስ</para>
  <para style="r">(<ref loc="MAT 26:71-75">ማቶ 26:71-75</ref>፤ <ref loc="MRK 14:69-72">ማር 14:69-72</ref>፤ <ref loc="LUK 22:58-62">ሉቃ 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>ጰፅሮስ ያን ኤቅድ፥ ታማ ካይሽን፥ ሀራት እያኮ፥ “ኔኒ ሀ አድያ ታማረታፐ እሱዋ ግድኪ?” ያግስ።</para>
  <para style="p" vid="JHN 18:25">ጰፅሮስ ዛሪድ፥ “አካይ፥ ታኒ ግድከ” ያግድ ካድስ።<verse eid="JHN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26"/>ካህነ ሀላቃ አይለታፐ እሶይ፥ ጰፅሮስ ሀይ ቃንፅዳ አድያ ዳቦይ፥ ጰፅሮሳኮ፥ “ታኒ ነና እያራ አታክልትያ ግዶን በአብክና?” ያግድ ኦይችስ።<verse eid="JHN 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27"/>ጰፅሮስ ቃስካ ካድስ፤ ኤለስድ ኩቶይ ዋስ አግስ።<verse eid="JHN 18:27"/></para>
  <para style="s1">የሱሲ ጵላፆሳ ስንን</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ 27:1-2</ref>፥ <ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="MRK 15:1-5">ማር 15:1-5</ref>፤ <ref loc="LUK 23:1-5">ሉቃ 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>ዎንታ ጉራ፥ ኤንቲ የሱሳ ቃያፋ ሶፐ ደርያ ሃረይሳ ኦሶ ኬ ኤክ ኤፍዶሶና። አይሁደት ፓስካ ባኣለ ካ ማናዉ ባንታና ቱንሶና መላ ደርያ ሃረይሳ ኦሶ ኬ ገልቦኮና። <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>ሄሳ ግሾ፥ ጵላፆስ ኤንታኮ ካረ ከይድ፥ “ሀ አድያ አይስ ሞተቲ?” ያግስ።<verse eid="JHN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30"/>ኤንቲ፥ “እ ኢታ ኦናባ ግድያኮ ኑኒ እያ ኔኮ ኤሆኮ” ያግዶሶና።<verse eid="JHN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31"/>ጵላፆስ ዛሪድ፥ “ህንተ እያ ኤክ ኤፍድ፥ ህንተ ህገይ ገይሳዳ እያ ቦላ ፕርድተ” ያግስ።</para>
  <para style="p" vid="JHN 18:31">አይሁደት፥ “ኦናካ ዎያ ማት ኑስ ባዋ” ያግዶሶና፤ <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/>ሄስ ሀንዳይ የሱሲ አይ መላ ሀይቆ ሀይቃነኮ ኤርሳናዉ ኦድዳይስ ፖለታናሳ።<note caller="-" style="x"><char style="xo" closed="false">18:32 </char><char style="xt" closed="false"><ref loc="JHN 3:14">ዮሀ 3:14</ref>፤ <ref loc="JHN 12:32">12:32</ref>.</char></note><verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>ጵላፆስ ባ ኦሶ ኬ ዛር ገልድ፥ የሱሳ ፄግድ፥ “ኔኒ አይሁደ ካዎ?” ያግድ ኦይችስ።<verse eid="JHN 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34"/>የሱሲ ጵላፆሳ፥ “ሀ ኦይሻ ኔኒ ኔፐ ኦይቻየ ዎይኮ ሀራ አስ ነዉ ታባ ኦድዴ?” ያግስ።<verse eid="JHN 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35"/>ጵላፆስ ዛሪድ፥ “ታ አይሁደ አሴ? ነ አሳይነ ካህነ ሀላቃት ነና ታዉ አድ እምዶሶና። ነ አይ ኦዲ?” ያግስ።<verse eid="JHN 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36"/>የሱሲ፥ “ታ ካዎተይ ሀ አላምያና ግደና። እ ሀይሳን ግድያኮ ታ አይሁደታ ሀላቃታስ አዳ እመቶና መላ ታ አይለት ታዉ ኦለታና። ሽን ታ ካዎተይ ሀ አላምያና ግደና” ያግስ።<verse eid="JHN 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37"/>ሄሳ ግሾ፥ ጵላፆስ የሱሳኮ፥ “ያትን፥ ኔኒ ካዎዬ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="JHN 18:37">የሱሲ ዛሪድ፥ “ቱማ ታ ካዎ ግደይሳ ነ ጋዳሳ። ታኒ የለትዳይነ ሀ አላምያ ይዳይ ቱማተስ ማርካታናሳ። ቱማ ባጋ ግድዳ ኦንካ ታኒ ገይሳ ስኤስ” ያግስ።<verse eid="JHN 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38"/>ጵላፆስ፥ “ቱም አይቤ?” ያግስ።</para>
  <para style="p" vid="JHN 18:38">ጵላፆስ ሄሳ ግዳፐ ጉየ አይሁደታኮ ካረ ከይድ፥ “ታኒ እያፐ አይ ኢታካ ደማብከ። <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>ሽን ፓስካ ባኣለ ጋላስ፥ እስ አሰ ህንተዉ ቃሾፐ ብልያ ሜዘይ ደኤስ። ታኒ ህንተዉ አይሁደታ ካዋ ብላና መላ ኮዬቲ?” ያግስ።<verse eid="JHN 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40"/>ኤንቲ ዛሪድ፥ ባንታ ቃላ ቁ ኦድ፥ “ባርባና ብላፈ አትሽን፥ እያ ግደና” ያግዶሶና። ሽን ባርባን ፓንጋ።<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="s1">የሱሲ ቶሸትስ</para>
  <para style="r">(<ref loc="MAT 27:27-32">ማቶ 27:27-32</ref>፤ <ref loc="MRK 15:15-21">ማር 15:15-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>ሄሳፈ ጉየ፥ ጵላፆስ የሱሳ ጋራፍስስ። <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>ዎታዳረት አጉን ካላቻ መድ እያ ሁጰን ዎዶሶና። ቃስ ዞኦ ማኦ እያ ማይዝዶሶና። <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>እያኮ ሺቅድ፥ “አይሁደ ካዋዉ፥ መርናዉ ካዎታ” ያግድ እያ ባቅዶሶና።<verse eid="JHN 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4"/>ጵላፆስ ቃስካ ካረ ከይድ፥ አይሁደታኮ፥ “ሄኮ፥ ታኒ እያፐ አይ ኢታካ ደማቦናይሳ ህንተ ኤራና መላ እያ ህንተኮ ካረ ከሳና” ያግስ። <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>ሄሳፈ ጉየ፥ የሱሲ አጉን ካላቻ ባ ሁጰን ዎድ፥ ዞኦ ማኦ ማእድ፥ ካረ ከይስ። ጵላፆስ አይሁደታኮ፥ “ኡራ ሀይሳ በእተ” ያግስ።<verse eid="JHN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6"/>ካህነ ሀላቃትነ ፆሳ ኬ ናገይሳት እያ በእዳ ዎደ፥ ባንታ ቃላ ቁ ኦድ፥ “ማስቃልያ ቦላ ካቃ! ካቃ!” ያግዶሶና።</para>
  <para style="p" vid="JHN 19:6">ጵላፆስ ኤንታኮ፥ “ህንተ እያ ኤፍድ፥ ማስቃልያ ቦላ ካቅተ። ታኒ እያፐ አይ ኢታካ ደማብከ” ያግስ።<verse eid="JHN 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7"/>አይሁደት ዛሪድ፥ “ኑስ ህገይ ደኤስ። እ ባና ፆሳ ናአ ኦዳ ግሾ ኑ ህግያ እ ሀይቃናዉ በሴስ” ያግዶሶና።<verse eid="JHN 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8"/>ጵላፆስ ሄሳ ስእዳ ዎደ ካሰይሳፈ ዳሮ ያይስ። <verse eid="JHN 19:8"/><verse number="9" style="v" sid="JHN 19:9"/>ቃስካ ጵላፆስ ባ ኦሶ ኬ ስም ገልድ የሱሳኮ፥ “ኔኒ አዉፐ ያዲ?” ያግድ ኦይችስ። ሽን የሱሲ እያዉ አይኮካ ዛርቤና። <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>ሄሳ ግሾ፥ ጵላፆስ፥ “ታዉ ኦድኪ? ነና ብላናዉ ዎይኮ ማስቃልያ ቦላ ካቃናዉ ታዉ ማት ደኤይሳ ኤርኪ?” ያግስ።<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>የሱሲ፥ “ፆሳይ ነዉ ማታ እምቦናባ ግድያኮ ታ ቦላ ማት ነዉ ዴናሽን። ሄሳ ግሾ፥ ታና ነዉ አድ እምዳይስ አያ ናጋራ ኦስ” ያግስ።<verse eid="JHN 19:11"/></para>
  <para style="s1">የሱሲ ሀይቆ ፕርደትስ</para>
  <para style="r">(<ref loc="MAT 27:15-31">ማቶ 27:15-31</ref>፤ <ref loc="MRK 15:6-20">ማር 15:6-20</ref>፤ <ref loc="LUK 23:13-25">ሉቃ 23:13-25</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>ጵላፆስ ሄሳ ስእዳ ዎደ የሱሳ ብላናዉ ኦገ ኮይስ። ሽን አይሁደት ባንታ ቃላ ቁ ኦድ፥ “ኔኒ እያ ብልያባ ግድኮ ካዋ ቄሳረ ባጋ ግዳካ። ባና ካዎ ግያ ኦንካ ቄሳረ ሞርከ” ያግዶሶና።<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>ጵላፆስ ሄሳ ስእድ የሱሳ ካረ ከስስ። ያትድ፥ “ሎቸ ሹች” ጌተትያ በሳን ፕርዳ ኦይድያን ኡትስ። እብራወ ዶናን ሄ በሳይ “ጋባተ” ጉሱ። <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>ሄ ጋላሳይ ፓስካ ባኣለ ቦንቻናዉ ጊገተ ጋላስ። ሳአይ ኡሱፑን ሳተ ሄራ። ጵላፆስ አይሁደታኮ፥ “ህንተ ካዋ ሀይሳ በእተ” ያግስ።<verse eid="JHN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15"/>አይሁደት ባንታ ቃላ ቁ ኦድ፥ “ድጋ! ድጋ! ማስቃልያ ቦላ ካቃ” ያግዶሶና።</para>
  <para style="p" vid="JHN 19:15">ጵላፆስ ዛሪድ፥ “ህንተ ካዋ ታኒ ማስቃልያ ቦላ ካቃናይሳ ኮዬቲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="JHN 19:15">ካህነ ሀላቃት፥ “ቄሳረፐ ሀራ ካዎይ ኑስ ባዋ” ያግዶሶና።<verse eid="JHN 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16"/>ሄሳፈ ጉየ፥ ኤንቲ የሱሳ ማስቃልያ ቦላ ካቃና መላ ጵላፆስ ኤንታዉ አድ እሚስ።</para>
  <para style="s1" vid="JHN 19:16">የሱሲ ካቀትስ</para>
  <para style="r" vid="JHN 19:16">(<ref loc="MAT 27:32-44">ማቶ 27:32-44</ref>፤ <ref loc="MRK 15:21-32">ማር 15:21-32</ref>፤ <ref loc="LUK 23:26-43">ሉቃ 23:26-43</ref>)</para>
  <para style="p" vid="JHN 19:16">ኤንቲ የሱሳ ኦይክድ ኤፍዶሶና። <verse eid="JHN 19:16"/><verse number="17" style="v" sid="JHN 19:17"/>የሱሲ ባ ማስቃልያ ቶክድ፥ “ሁጰ ጉገ” ጌተትያ በሳ ብስ። “ሁጰ ጉገ” ጉሳይ እብራወ ዶናን “ጎልጎታ” ጉሱ። <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>ኤንቲ ሄ በሳን ማስቃልያ ቦላ የሱሳ ካቅዶሶና። ቃስ እያራ ሀራ ናምኡ አሳታ፥ እሱዋ ያ ባጋራ ሀንኩዋ ሀ ባጋራ ማስቃልያ ቦላ ካቅዶሶና። <verse eid="JHN 19:18"/><verse number="19" style="v" sid="JHN 19:19"/>ጵላፆስ፥ “አይሁደታ ካዋ፥ ናዝረተ የሱሳ” ግያ ፁፈ ፃፍድ ማስቃልያ ቦላ ዎስ። <verse eid="JHN 19:19"/><verse number="20" style="v" sid="JHN 19:20"/>የሱሲ ማስቃልያ ቦላ ካቀትዳ በሳይ ካታማስ ማታን ደእያ ግሾ፥ ዳሮ አይሁደት ሄ ፁፍያ ናባብዶሶና። ፁፈይ ፃፈትዳይ እብራወ ዶናን፥ ላትነ ዶናንነ ግርከ ዶናና። <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>ሄሳ ግሾ፥ ካህነ ሀላቃት ጵላፆሳኮ፥ “ ‘ሀ አደይ ባና አይሁደ ካዎ ያግስ’ ጋዳ ፃፋፐ አትሽን፥ ‘አይሁደ ካዎ’ ጋዳ ፃፎፓ” ያግዶሶና።<verse eid="JHN 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22"/>ያትን፥ ጵላፆስ፥ “ታ ፃፍዳይሳ ፃፋስ” ያግድ ዛርስ።<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>ዎታዳረት ማስቃልያ ቦላ እያ ካቅዳፐ ጉየ፥ እያ ማኡዋ ኤክድ፥ ኦይዱ በሳን ሻክድ፥ እሶ እሶ ኤክዶሶና። የዳ ማኤትያ እያ አዱሳ ማኡዋ ኤክዶሶና። <verse eid="JHN 19:23"/><verse number="24" style="v" sid="JHN 19:24"/>ዎታዳረት፥ “ኦና ጋካኔኮ፥ ሳማ የጋናፐ አትሽን፥ ማኡዋ ፔኮ” ያግዶሶና። ሄስ ሀንዳይ ጌሻ ማፃፋን፥</para>
  <para style="q1" vid="JHN 19:24">“ታ ማኡዋ ሻክ ኤክዶሶና፤</para>
  <para style="q2" vid="JHN 19:24">ታ አዱሳ ማኡዋ ቦላካ ሳማ የግዶሶና”</para>
  <para style="m" vid="JHN 19:24">ጌተትዳይስ ፖለታና መላሳ።<note caller="-" style="x"><char style="xo" closed="false">19:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ 22:18</ref>.</char></note> ሄሳ ግሾ፥ ዎታዳረት ሄሳ ኦዶሶና።<verse eid="JHN 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25"/>ሽን የሱሳ ማስቃልያ ማታን እያ አይያ፥ እያ አየ ምችያ፥ ቀልዮጰ ማችያ ማይራማነ ማግደላ ማይራማ ኤቅዶሶና። <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>የሱሲ ባ አይዉነ እ ዶስያ ታማረይ ያን ኤቅዳይሳታ በእድ፥ ባ አየኮ፥ “ታ አየ፥ ነ ናኣ ሀይሳ በአ” ያግስ።<verse eid="JHN 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27"/>ሄሳፈ ጉየ፥ ሄ ታማርያኮ፥ “ነ አይዉ ሀኖ በአ” ያግስ። ሄ ታማረይ እዮ ሄ ዎደፐ ዶምድ ባራ ዳና መላ ሶ ኤፍስ።<verse eid="JHN 19:27"/></para>
  <para style="s1">የሱሳ ሀይቁዋ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ 27:45-56</ref>፤ <ref loc="MRK 15:33-41">ማር 15:33-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>ሄሳፈ ጉየ፥ የሱሲ ኡባይ ሀእ ፖለትዳይሳ ኤርድ፥ ጌሻ ማፃፋን ፃፈትዳይስ ፖለታና መላ “ታና ሳሜስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ 69:21</ref>፤ <ref loc="PSA 22:15">22:15</ref>.</char></note><verse eid="JHN 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29"/>ሄ በሳን እስ ፁጋ ኩመ ጫላ ዎይነይ ደኤስ። ኤንቲ እስፖንጀ ሄ ዎይንያን የግድ፥ ህሶጰ ም ፄራን ዎድ፥ የሱሳ ዶናኮ ሺሽዶሶና። <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>የሱሲ ዎይንያ ጋንፅ በእድ፥ “ፖለትስ” ያግስ።</para>
  <para style="p" vid="JHN 19:30">ሄሳፈ ጉየ፥ ባ ሁጵያ ዝቅ ኦድ ባ ሸምፑዋ እሚስ።<verse eid="JHN 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>ሄ ጋላሳይ ጊገተ ጋላስ ግድያ ግሾነ ዎንተ ጋላሳይ ቦንቾ ሳምባታ ግድያ ግሾ፥ አሳታ አሀይ ማስቃልያ ቦላ ሳምባታ ጋላስ ፔኦና መላ ኤንታ ቶሁዋ መንድ፥ ማስቃልያፐ ዎሳና መላ አይሁደት ጵላፆሳ ዎስዶሶና። <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>ሄሳ ግሾ፥ ዎታዳረት ብድ፥ የሱሳራ ካቀትዳ ናምኡ አሳታ ቶሁዋ መንዶሶና። <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>ሽን የሱሳኮ ይዳ ዎደ እ ሀይቅዳይሳ በእድ፥ እያ ቶሁዋ መንቦኮና። <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>ሽን ዎታዳረታፐ እሶይ እያ ምያ ቶራን ጫድን ኢራካ ሱነ ሃ ጎግስ። <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>ህንተ አማናና መላ ሄሳ በእዳይስ ማርካትስ። እያ ማርካተይካ ቱማ። ቃስ እ ኦደይስ ቱማ ግደይሳ ኤሬስ። <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>ሄስ ሀንዳይ ጌሻ ማፃፋይ፥ “እያ መቀታፐ እሶይካ መቀና” ግዳይስ ፖለታና መላሳ።<note caller="-" style="x"><char style="xo" closed="false">19:36 </char><char style="xt" closed="false"><ref loc="EXO 12:46">ከሳ 12:46</ref>፤ <ref loc="NUM 9:12">ታይቦ 9:12</ref>፤ <ref loc="PSA 34:20">ማዝ 34:20</ref>.</char></note> <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>ቃስካ ጌሻ ማፃፋይ ሀራ በሳን፥ “ኤንቲ ባንታ ጫድዳይሳ በአና” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">19:37 </char><char style="xt" closed="false"><ref loc="ZEC 12:10">ዛካ 12:10</ref>፤ <ref loc="REV 1:7">ቆን 1:7</ref>.</char></note><verse eid="JHN 19:37"/></para>
  <para style="s1">የሱሲ ሞገትስ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ 27:57-61</ref>፤ <ref loc="MRK 15:42-47">ማር 15:42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>ሄሳፈ ጉየ፥ አርማተ ካታማፐ ይዳ ዮሰፍ የሱሳ አሀ ኤካናዉ ጵላፆሳ ዎስስ። ዮሰፍ አይሁደታስ ያይዳ ግሾ ቆሳን የሱሳ ካለይሳ።</para>
  <para style="p" vid="JHN 19:38">ጵላፆስ፥ “ኤካ” ያግስ። ሄሳ ግሾ፥ ዮሰፍ ብድ የሱሳ አሀ ኤክስ። <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>ቃስ ንቆድሞስ ሄሳፈ ካሰ የሱሳኮ ቃማ ይዳይስ፥ ካርበነ ጎዳረ ኡራ ዋላከትዳ ሀስታማነ እስ ክሎ ግራመ ግድያ ሽቶ ኤክድ ዮሰፋራ ይስ።<note caller="-" style="x"><char style="xo" closed="false">19:39 </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">ዮሀ 3:1-2</ref>.</char></note> <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>ሄ ናምኡ አሳት የሱሳ አሀ ኤክድ፥ አይሁደት አሀ ፃፅያ ማራን፥ ሽቶራ፥ ሞጎ አፍላን ፃፅዶሶና። <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/>የሱሲ ማስቃልያ ቦላ ካቀትዳ በሳን ዳሮ አታክልተይ ደኤስ። ሄ አታክልትያ ግዶን ሹቻፈ ዎጨትድ ኦሰትዳ ቡሮ ኦንካ ሞገትቦና ኦራ ዱፎይ ደኤስ። <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>ሄ ጎንጎሎይ ማታን ደእያ ግሾነ አይሁደት ሳምባታስ ጊገትያ ጋላስ ግድያ ግሾ፥ የሱሳ አሀ ያን ሞግዶሶና።<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s1">የሱሳ ሀይቆፐ ደንዱዋ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቶ 28:1-8</ref>፤ <ref loc="MRK 16:1-8">ማር 16:1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃ 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>ዎጋ ዎደ ዎንታ ቡሮ ጌዮና ደእሽን፥ ማግደላ ማይራማ፥ የሱሲ ሞገትዳ ዱፉዋ ባዳ ሹቻይ ሄ ዱፉዋ ዶናፐ ደንድዳይሳ በአሱ። <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>ስሞን ጰፅሮሳኮነ የሱሲ ዶስያ ሀንኮ ታማርያኮ ዎፃ ባዳ፥ “ዱፉዋፐ ጎዳ ኤፍዶሶና፤ እያ አዉን ዎዳኮ ኑ ኤሮኮ” ያጋሱ።<verse eid="JHN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3"/>ሄሳ ግሾ፥ ጰፅሮስነ ሀንኮ ታማረይ ከይድ ዱፉዋ ብዶሶና። <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>ናምአይካ እስፈ ዎፅዶሶና፥ ሽን ሀንኮ ታማረይ ጰፅሮሳፐ አድ ስንትድ ዱፉዋ ጋክስ። <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>ሄ ታማረይ ሆክድ፥ ሞጎ አፍላ በእስ፥ ሽን ዱፉዋን ዎቤና። <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>ስሞን ጰፅሮስ እያ ካል ይድ፥ ዱፉዋን ዎድ ሞጎ አፍላይ ያን ደኤይሳ በእስ። <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>ቃስ የሱሳ ሁጰን ፃፀትዳ አፍላይ ፃፀትዳ መላ ዱማ እስ በሳን ደኤይሳ በእስ። ሄ አፍላይ ዱማ ደኤስፐ አትሽን፥ ሞጎ አፍላራ እስፈ ዴና። <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>ሄ ዎደ፥ ስንትድ ዱፉዋ ጋክዳ ሀንኮ ታማረይ ገል በእድ አማንስ። <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>የሱሲ ሀይቆፐ ደንዳናዉ በሰይሳ ኦድያ ጌሻ ማፃፋ ቃላ ኤንቲ ቡሮ አኬክቦኮና። <verse eid="JHN 20:9"/><verse number="10" style="v" sid="JHN 20:10"/>ሄሳፈ ጉየ፥ እያ ታማረት ባንታ ሶ ስም ብዶሶና።<verse eid="JHN 20:10"/></para>
  <para style="s1">የሱሲ ማግደላ ማይራምስ ቆንጭስ</para>
  <para style="r">(<ref loc="MAT 28:9-10">ማቶ 28:9-10</ref>፤ <ref loc="MRK 16:9-11">ማር 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>ሽን ማይራማ ሄ ዱፉዋ ዶናን ኤቃዳ ዬካሸ ሆካዳ ዱፉዋ ግዶ ፄላሱ። <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>ቦ ማኦ ማእዳ ናምኡ ኪታንቾት የሱሳ አሀይ ዝንእዳ በሳን እሶይ ሁጰሶራ ሀንኮይ ቶሆሶራ ኡትዳሽን በአሱ። <verse eid="JHN 20:12"/><verse number="13" style="v" sid="JHN 20:13"/>ኤንቲ ኢኮ፥ “ማጫሰተ፥ አይስ ዬካይ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="JHN 20:13">እያ፥ “ኤንቲ ታ ጎዳ ኤፍዶሶና፤ ኤንቲ አዉን ዎዳኮ ታኒ ኤርከ” ያጋሱ።<verse eid="JHN 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14"/>ሄሳ ግዳፐ ጉየ፥ እያ ጉየ ስማ ፄልያ ዎደ፥ የሱሲ ያን ኤቅዳይሳ በአሱ። ሽን እ የሱሳ ግድዳይሳ ኤራቡኩ። <verse eid="JHN 20:14"/><verse number="15" style="v" sid="JHN 20:15"/>የሱሲ ኢኮ፥ “ማጫሰተ፥ አይስ ዬካይ? ኦና ኮያይ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="JHN 20:15">ማይራማ አታክልተ ኦሳንቹዋ ዳንን፥ “ጎዳዉ፥ ነ ኤክዳባ ግድኮ፥ እያ አዉን ዎዳኮ ታዉ ኦዳርኪ። ታኒ እያ ኤካና” ያጋሱ።<verse eid="JHN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16"/>የሱሲ ኢኮ፥ “ማይራመ” ያግስ።</para>
  <para style="p" vid="JHN 20:16">እያ እያኮ ስማዳ፥ እብራወ ዶናን “ረቡን” ያጋሱ። ሄሳስ ብርሸይ “አስታማርያዉ” ጉሱ።<verse eid="JHN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17"/>የሱሲ ኢኮ፥ “ታኒ ቡሮ ታ አዋኮ ቦና ግሾ፥ ታና ኦይኮፋ። ሽን ታ እሻታኮ ባዳ፥ ‘ታኒ ታ አዋኮነ ህንተ አዋኮ፥ ታ ፆሳኮነ ህንተ ፆሳኮ፥ ስማና ግስ’ ጋዳ ኤንታዉ ኦዳ” ያግስ።<verse eid="JHN 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18"/>ማግደላ ማይራማ ጎዳ በእዳይሳነ እዉ ሄሳ እ ኦድዳይሳ ባዳ እያ ታማረታስ ኦዳሱ።<verse eid="JHN 20:18"/></para>
  <para style="s1">የሱሲ ባ ታማረታስ ቆንጭስ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ 28:16-20</ref>፤ <ref loc="MRK 16:14-18">ማር 16:14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>ዎጋ ዎደ ኦማርስ፥ እያ ታማረት አይሁደታስ ያይድ ካርያ ጎርድድ ሺቅ ኡትዳሽን፥ የሱሲ ይድ፥ ኤንታ ግዶን ኤቅድ፥ “ሳሮይ ህንተዉ ግዶ” ያግስ። <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>ሄሳ ግድ ስሚድ ባ ኩሽያነ ባ ምያ ኤንታ በስስ። እያ ታማረት ጎዳ በእዳ ዎደ ዳሮ ኡፋይትዶሶና። <verse eid="JHN 20:20"/><verse number="21" style="v" sid="JHN 20:21"/>የሱሲ ዛሪድ ኤንታኮ፥ “ሳሮይ ህንተዉ ግዶ፤ ታ አዋይ ታና ኪትዳይሳዳ ታንካ ህንተና ኪታይስ” ያግስ። <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>ሄሳ ግዳፐ ጉየ፥ ኤንታ ቦላ ኡፉ ግድ ፑንስ። ቃስ፥ “ጌሻ አያና ኤክተ። <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/>ህንተ አቶ ግዳ አሳ ናጋራይ አቶ ጌተታና። ህንተ አቶ ጎናይሳታ ናጋራይ አቶ ጌተተና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">20:23 </char><char style="xt" closed="false"><ref loc="MAT 16:19">ማቶ 16:19</ref>፤ <ref loc="MAT 18:18">18:18</ref>.</char></note><verse eid="JHN 20:23"/></para>
  <para style="s1">የሱሳነ ቶማሳ</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>ሽን ታማነ ናምኡ ታማረታፐ እሶይ፥ ድድሞሳ ጌተትያ ቶማስ፥ የሱሲ ይዳ ዎደ ኤንታራ ዴና። <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>ሄሳ ግሾ፥ ሀንኮ እያ ታማረት ቶማሳኮ፥ “ኑኒ ጎዳ በእዳ” ያግዶሶና።</para>
  <para style="p" vid="JHN 20:25">ሽን ቶማስ ኤንታኮ፥ “ምስማረን እ ጫደትዳ እያ ኩሽያን ደእያ ቤታ በኦናነ ሄ ቤታ ታ ብራን ቦቾና፥ ቃስ ታ ኩሽያ እያ ምየን የዳ በኦና አማንከ” ያግስ።<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>ሳምንታፈ ጉየ፥ የሱሳ ታማረት ቃስካ ሶን ሺቅድ ኡትዶሶና፤ ቶማስካ ኤንታራ ደኤስ። ካረይ ጎርደትድ ደእሽን የሱሲ ይድ፥ ኤንታ ግዶን ኤቅድ፥ “ሳሮይ ህንተዉ ግዶ” ያግስ። <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>ሄሳፈ ጉየ፥ የሱሲ ቶማሳኮ፥ “ታ ኩሽያ ነ ብራን ቦቻዳ በአ። ቃስ ነ ኩሽያ ታ ምይያን የዳ በአ። ኔኒ ስፓ፥ አማና” ያግስ።<verse eid="JHN 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28"/>ቶማስ ዛሪድ፥ “ታ ጎዳዉ፥ ታ ፆሳዉ” ያግስ።<verse eid="JHN 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29"/>ያትን የሱሲ፥ “ኔኒ ታና በእዳ ግሾ አማናዳሳ፥ ሽን ታና በኦና አማንዳይሳት አንጀትዳይሳታ” ያግስ።<verse eid="JHN 20:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>የሱሲ ሀ ማፃፋን ፃፈትቦና ሀራ ዳሮ ማላታታ ባ ታማረታ ስንን ኦስ። <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>ሽን የሱሲ እ ክርስቶሳ፥ ፆሳ ናኣ ግደይሳ ህንተ አማናና መላነ አማንድ እያ ሱንን ደኦ ደማና መላ ሃይስ ፃፈትስ።<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s1">የሱሲ ላፑን ታማረታስ ቆንጭስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>ሄሳፈ ጉየ፥ የሱሲ ፅብራዶሳ አባ ማታን ባ ታማረታስ ዛር ቆንጭስ። እ ኤንታዉ ሀይሳፈ ካልድ ደእያ ሀኖታን ቆንጭስ። <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>ስሞን ጰፅሮስ፥ መንተ ጌተትያ ቶማስ፥ ቃና ጋልላፐ ይዳ ናትናኤል፥ ዛብድዮሳ ናይትነ የሱሳ ታማረታፐ ሀራ ናምአት እስፈ ደኦሶና።<verse eid="JHN 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 21:3"/>ስሞን ጰፅሮስ ኤንታኮ፥ “ታኒ ሞሎ ኦይካናዉ ባይስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="LUK 5:5">ሉቃ 5:5</ref>.</char></note></para>
  <para style="p" vid="JHN 21:3">ኤንቲ፥ “ኑካ ኔራ ባና” ያግድ፥ ዎጎሉዋ ግዶ ገልዶሶና። ሽን ኤንቲ ሄ ቃማን አይብ ሞሎካ ኦይክቦኮና።<verse eid="JHN 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4"/>ዎንታ ጉራ ፃልቀይ ዶላናፐ ስን፥ የሱሲ አባ ጋፃን ኤቅስ፥ ሽን እያ ታማረት የሱሳ ግድዳይሳ ኤርቦኮና። <verse eid="JHN 21:4"/><verse number="5" style="v" sid="JHN 21:5"/>የሱሲ ኤንታኮ፥ “ታ ላገቶ፥ ሞሎ ኦይክቤከቲ?” ያግስ።</para>
  <para style="p" vid="JHN 21:5">ኤንቲ ዛሪድ፥ “አይኮካ ኦይክቦኮ” ያግዶሶና።<verse eid="JHN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6"/>እ ዛሪድ፥ “ህንተ ግትያ ዎጎሉዋፐ ኡሻቻ ባጋራ የግተ፤ ጉ ሞሎ ህንተ ኦይካና” ያግስ። ሄሳ ግሾ፥ ግትያ ኡሻቻ ባጋራ የግዶሶና። ሞሎይ ዳርዳ ግሾ ጎች ከሳናዉ ፆነትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">21:6 </char><char style="xt" closed="false"><ref loc="LUK 5:6">ሉቃ 5:6</ref>.</char></note><verse eid="JHN 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7"/>የሱሲ ዶስያ ታማረይ ጰፅሮሳኮ፥ “ሀይስ ጎዳ!” ያግስ። ስሞን ጰፅሮስ እ ጎዳ ግዳይሳ ስእዳ ዎደ፥ ካሎ ደእያ ግሾ፥ ባ ማኡዋ ማእድ አባ ግዶ ጉፕ ገልስ። <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>ሽን ዎጎሉዋን አትዳ ሀንኮ ታማረት ሞሎይ ኩምዳ ግትያ ጎችድ፥ አባፈ ጋፃ ከይዶሶና። ኤንቲ አባፈ ናምኡ ፄቱ ዋ መላ ሃኮሶና። <verse eid="JHN 21:8"/><verse number="9" style="v" sid="JHN 21:9"/>ኤንቲ አባፈ ጋፃ ከይዳ ዎደ፥ ፂፋ ቦንቆን ሞሎይ ደኤይሳነ ኡይ በእዶሶና።<verse eid="JHN 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10"/>የሱሲ ኤንታኮ፥ “ሀእ ህንተ ኦይክዳ ሞሉዋፐ ጉራ ሀምተ” ያግስ።<verse eid="JHN 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11"/>ስሞን ጰፅሮስ ዎጎሉዋን ገልድ፥ ፄታነ እሻታማነ ሄ ዎጋ ሞሎት ኩምዳ ግትያ ጎችድ አባፈ ጋፃ ከስስ። ሞሎይ ሄሳ መላ ዳሮ ግድን ግተይ ዳከትቤና።<verse eid="JHN 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 21:12"/>የሱሲ ኤንታኮ፥ “ሃ ይድ ሚተ” ያግስ። እ ጎዳ ግደይሳ ኤንቲ ኤርዳ ግሾ፥ እያ ታማረታፐ እሶይካ፥ “ኔኒ ኦኔ?” ግድ እያ ኦይቻናዉ ምንዳይ ባዋ። <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>የሱሲ ይድ፥ ኡይ ኤክድ ኤንታዉ እሚስ፤ ሞሉዋካ ሄሳዳ እሚስ።<verse eid="JHN 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14"/>የሱሲ ሀይቆፐ ደንድድ ባ ታማረታስ ቆንጭሽን ሀይስ ሄን።<verse eid="JHN 21:14"/></para>
  <para style="s1">የሱሳነ ጰፅሮሳ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>ኤንቲ ምዳፐ ጉየ፥ የሱሲ ስሞን ጰፅሮሳኮ፥ “ዮና<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="fk" closed="false">ዮና፦ </char><char style="ft" closed="false">ግርከ ዶናን ዮና ጌተትያ ሱንይ ዮሃንሳ ጌተትያ ሱንስ ሳጶ ሱን።</char></note> ናአዉ ስሞና፥ ታና ሀይሳታፐ አዳ ዶሳይ?” ያግስ።</para>
  <para style="p" vid="JHN 21:15">ስሞን ጰፅሮስ፥ “ኤ ጎዳዉ፥ ታኒ ነና ዶሰይሳ ነ ኤራሳ” ያግስ።</para>
  <para style="p" vid="JHN 21:15">የሱሲ እያኮ፥ “ታ ዶርሳ ማራታ ሄማ” ያግስ።<verse eid="JHN 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16"/>የሱሲ ቃስካ፥ “ዮና ናአዉ ስሞና፥ ታና ዶሳይ?” ያግስ።</para>
  <para style="p" vid="JHN 21:16">ስሞን ጰፅሮስ፥ “ኤ ጎዳዉ፥ ታኒ ነና ዶሰይሳ ነ ኤራሳ” ያግስ።</para>
  <para style="p" vid="JHN 21:16">የሱሲ፥ “ታ ዶርሳታ ሄማ” ያግስ።<verse eid="JHN 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17"/>የሱሲ ሄን፥ “ዮና ናአዉ ስሞና፥ ታና ዶሳይ?” ያግስ።</para>
  <para style="p" vid="JHN 21:17">የሱሲ ሄን ስሞን ጰፅሮሳኮ፥ “ታና ዶሳይ?” ያግድ ኦይችዳ ግሾ፥ ጰፅሮስ አዛንድ፥ “ጎዳዉ፥ ኔኒ ኡባባ ኤራሳ፤ ታኒ ነና ዶሰይሳ ነ ኤራሳ” ያግስ።</para>
  <para style="p" vid="JHN 21:17">የሱሲ፥ “ታ ዶርሳታ ሄማ። <verse eid="JHN 21:17"/><verse number="18" style="v" sid="JHN 21:18"/>ታኒ ነዉ ቱማ ኦዳይስ፤ ኔኒ ናአተን ደእያ ዎደ፥ ነርካ ዳንጨታዳ፥ ነ ኮይዳ ሶ ባሳ። ሽን ነ ጭምዳ ዎደ ነ ኩሽያ ምጫ በሳና። ሀር ዳንጭሳና፤ ነ ዶሶና ሶ ኤፋና” ያግስ። <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>የሱሲ ሄሳ ጰፅሮስ አይ መላ ሀይቆ ሀይቅድ፥ ፆሳ ቦንችሳኔኮ ኤርሳናዉ ግስ። ሄሳ ግዳፐ ጉየ፥ የሱሲ ጰፅሮሳኮ፥ “ታና ካላ” ያግስ።<verse eid="JHN 21:19"/></para>
  <para style="s1">የሱሳነ ዶሰትዳ ታማርያ</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>ጰፅሮስ ጉየ ስሚድ፥ የሱሲ ዶስያ ታማረይ ባፐ ጉየራ የይሳ በእስ። ሄ ታማረይ፥ ካሆ ምያ በሳን የሱሳኮ ሺቅድ፥ “ጎዳዉ፥ ነና አድ እማናይ ኦኔ?” ግዳይሳ።<note caller="-" style="x"><char style="xo" closed="false">21:20 </char><char style="xt" closed="false"><ref loc="JHN 13:25">ዮሀ 13:25</ref>.</char></note> <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>ጰፅሮስ ሄ ታማርያ በእድ፥ “ጎዳዉ፥ ሀ አደይ ቃስ ዋናኔ?” ያግድ የሱሳ ኦይችስ።<verse eid="JHN 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22"/>የሱሲ እያኮ፥ “ታኒ ያና ጋካናዉ እ ዳና መላ ታኒ ኮይኮ፥ ሄስ ነና አይ መትዴ? ኔኒ ታና ካላ” ያግስ።<verse eid="JHN 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23"/>ሄሳ ግሾ፥ ሄ ታማረይ ሀይቀና ግያ ኦዳይ እሻታ ኡባ ጋክስ። ሽን የሱሲ፥ “ታኒ ያና ጋካናዉ፥ እ ዳና መላ ታኒ ኮይኮ ነና አይ መትዴ?” ያግስፐ አትሽን፥ “ሀይቀና” ግቤና።<verse eid="JHN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>ሀ ኦዳባ ማርካትዳይነ ሀይሳ ፃፍዳይ ሄ ታማርያ። እያ ማርካተይ ቱማ ግደይሳ ኑኒ ኤሮስ።<verse eid="JHN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25"/>የሱሲ ኦዳ ሀራ ዳሮባይ ደኤስ። ታ ቆፕን፥ ኡባባይ ሁጰን ሁጰን ፃፈትዳኮ፥ ፃፈትያ ማፃፋታስ ኩመ አላመይ ዎናዉ ግዳናባ ዳነና።<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
