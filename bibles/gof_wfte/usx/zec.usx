<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEC" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ዛካርያሳ ማፃፋ</para>
  <para style="toc1">ዛካርያሳ ማፃፋ</para>
  <para style="toc3">ዛካ</para>
  <para style="toc2">ዛካርያሳ</para>
  <para style="mt">ዛካርያሳ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ዛካርያሳ ማፃፋ ኮይሮ ፅቅሰይ፥ ናበይ ዛካርያስ፥ ባራካ ናአ፥ አዶ ናአ ናአ ግድዳይሳ ኦዴስ። ዛካርያስ ሌወ ኮቸ፤ እስራኤለ አሳይ ድኦፐ ስምን፥ ካህነነ ናበ ግድድ የሩሳላመን ፆሳስ ሀጋዝዳ አሰ።</para>
  <para style="ip">ዛካርያስ ባ ማፃፋ ፃፋና መላ ጋሶ ግድዳ ናምኡ ቆፋት ደኦሶና። ኮይሮ ቆፋይ፥ ድኦፐ ስሚድ ይሁዳን ደእያ፥ አሳይ ፆሳ ኬ ኬፆ ዶማና መላነ ዉርሰ ጋካናዉ ምንድ ኤቃና መላ ምንናሳ። ናምአን ቆፋይ፥ ሀ ነበይ ስንፈ ያና ክርስቶሳ ፕርዳባነ እ ያ ዋንድ ቆንጫናዉ ደእያኮ ኤንታ አኬክሳናሳ።</para>
  <para style="ip">ዛካርያሳ ማፃፋይ ናምኡ ግታ ክፍለታን ሻከቴስ።</para>
  <para style="ipi">1. ሸምፖ 1—8 ጋካናዉ ደእያ ክፍለይ፥ ክ.የ.ስ. 500 ፄታነ ላታሙ ላይፈ ብድ እቻሹ ፄታነ ታማነ እቻሹ ላይ ጋካናዉ ደእያ ላይታ ግዶን፥ ዱማ ዱማ ዎደታን ናበይ ዛካርያስ ኦድዳ ትንብተ ቃላ ኦይክስ። ሀ ናበይ ኦድዳ ቃላት ቆንጨ ማራን ሺቅዶሶና. ሄስካ የሩሳላመይ ኦራፃናባ፥ ፆሳ ኬ ስሚድ ኬፀታናባ፥ ፆሳ አሳይ ጌያናባነ ያና ክርስቶሳ ላይባ ኦዴስ።</para>
  <para style="ipi">2. ሸምፖ 9—14 ጋካናዉ ደእያ ክፍለይ ባ ሁጰን ናምአን ሻከቴስ። ሀ ክፍለት “ኪታ ዎይኮ ቃላ” ግያ ኦዳን ቆንጭዶሶና (<char style="xt"><ref loc="ZEC 9:1">9:1</ref>፤ <ref loc="ZEC 12:1">12:1</ref></char>)። ኮይሮ ቃላይ፥ ያና ጌተትዳ ክርስቶሳ ባጋራ እስራኤለስ አቶተ ኡፋይስ ደኤይሳ ኦዴስ። ሀ ናበይ ኦድዳ ቃላት ስንፈ ያና ክርስቶሳ ዉርሰ ፕርዳባ ኦዴስ (<char style="xt"><ref loc="ZEC 9:1-11:17">9:1—11:17</ref></char>)። ናምአን ቃላይ፥ እስራኤለ ጎዳኮ ዛሪድ ስሞነ ኦራ ደረ ግድድ ጎዳ ስንን ዱሳባ ኦዴስ (<char style="xt"><ref loc="ZEC 12:1-14:21">12:1—14:21</ref></char>)። ሄ ዎደ፥ ዳዊታ ሶ አሳስ፥ “ናጋራፐነ ቱናተፈ ጌሽያ ፑልቶይ ቃና” (<char style="xt"><ref loc="ZEC 13:1">13:1</ref></char>)። እስራኤለይ፥ “ፆሳይ፥ ኑ ጎዳ” ያጋና (<char style="xt"><ref loc="ZEC 13:9">13:9</ref></char>)። ክርስቶስ ካዎ ግድድ የሩሳላመ ሃራና (ሸም 14)።</para>
  <para style="ip">ዉርሰን፥ ሀገይ፥ ድኦፐ ስምዳ አሳይ ፆሳ ኬ ኬፃና መላ ደንያ ዎደ፥ ዛካርያስ ፆሳፈ ኤክዳ ቆንጨንነ ቃላን የሩሳላመይነ ፆሳ ኬይ ዛሪድ ኦራፃናይሳ ኦዴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ቆንጨታነ ቃላታ (<char style="ior"><ref loc="ZEC 1:1-8:23">1:1—8:23</ref></char>)</para>
  <para style="io2">ታኮ ስምተ ታ ህንተኮ ስማና (<char style="ior"><ref loc="ZEC 1:1-6">1:1-6</ref></char>)</para>
  <para style="io2">ሆስፑን ቃማ ቆንጨታነ ማላታ (<char style="ior"><ref loc="ZEC 1:7-6:15">1:7—6:15</ref></char>)</para>
  <para style="io2">ፆማ፥ ኪተተነ አንጀተ (<char style="ior"><ref loc="ZEC 7:1-8:23">7:1—8:23</ref></char>)</para>
  <para style="io1">ካዎይ ስማና (<char style="ior"><ref loc="ZEC 9:1-14:21">9:1—14:21</ref></char>)</para>
  <para style="io2">ኮይሮ ቃላ፦ አይሰይሳታነ ኤንቲ አይስያ አሳ (<char style="ior"><ref loc="ZEC 9:1-11:17">9:1—11:17</ref></char>)</para>
  <para style="io2">ናምአን፦ አሳነ ኤንታ አይሰይሳታ (<char style="ior"><ref loc="ZEC 12:1-14:21">12:1—14:21</ref></char>)</para>
  <chapter number="1" style="c" sid="ZEC 1"/>
  <para style="s1">ጎዳይ ባ አሳ ፄጌስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 1:1"/>ዳርዮስ ካዎትዳ ናምአን ላይን፥ ሆስፑን አጌናን፥ ጎዳ ቃላይ እዶ ናኣ፥ ባራካ ናኣ፥ ናብያ ዛካርያሳኮ ይስ።<verse eid="ZEC 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEC 1:2"/>“ጎዳይ ህንተ ማይዛታ ቦላ ዳሮ ሀንቀትስ። <verse eid="ZEC 1:2"/><verse number="3" style="v" sid="ZEC 1:3"/>ሽን ሀእ አሳስ ሀይሳዳ ያጋዳ ኦዳ፦ ‘ታኮ ስምተ፤ ታኒ ህንተኮ ስማና’ ያጌስ ኡባፈ ዎልቃማ ጎዳይ። <verse eid="ZEC 1:3"/><verse number="4" style="v" sid="ZEC 1:4"/>ካሰ ናበት፥ ህንተ አዋታኮ፥ ‘ህንተ ኢታ ኦግያፐነ ኢታ ኦሱዋፐ ስምተ’ ያግድ ኦድን፥ ስኦና እፅድ፥ ባንታ ኢታ ኦግያፐነ ኦሱዋፐ ስሞና እፅዳ፥ ህንተ ማይዛታዳ ሀኖፕተ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ። <verse eid="ZEC 1:4"/><verse number="5" style="v" sid="ZEC 1:5"/>ህንተ ማይዛት ሀእ አዉን ደኦና? ሄ ናበት መርናዉ ፓፃ ደኦና? <verse eid="ZEC 1:5"/><verse number="6" style="v" sid="ZEC 1:6"/>ግዶሽን፥ ናበታ፥ ታ አይለታ ባጋራ ታኒ ኦድዳ ኪታትነ ህገት ኡባይ ህንተ ማይዛታ ቦላ ጋክቤኔ? ያትን፥ ኤንቲ ባንታ ናጋራ ፓፅድ፥ “ኡባፈ ዎልቃማ ጎዳይ ኑ ኦግያዳነ ኑ ኦሱዋዳ ኑስ እማና ግዳይሳዳ ባ ኦሱዋ ኦስ” ያግዶሶና።<verse eid="ZEC 1:6"/></para>
  <para style="s1">ፓራታ ቆንጨ</para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 1:7"/>ዳርዮስ ካዎትዳ ናምአን ላይን፥ ሻባፃ ጌተትያ ታማነ እስን አጌናን፥ ላታማነ ኦይዳን ጋላሳን፥ ጎዳ ቃላይ እዶ ናኣ፥ ባራካ ናኣ፥ ናብያ ዛካርያሳኮ ይስ። <verse eid="ZEC 1:7"/><verse number="8" style="v" sid="ZEC 1:8"/>ታኒ ቃማ ቆንጨን፥ ዞኦ ፓራ ቶግዳ እስ አስ በአስ። እ ዛንጋራን ደእያ ባርሰኔተ ጌተትያ ምታ ጋርሳን ኤቅስ፤ እያፐ ጉየ ባጋራ ዞኦ፥ ዳማነ ቦ ፓራት ደኦሶና። <verse eid="ZEC 1:8"/><verse number="9" style="v" sid="ZEC 1:9"/>ያትን ታኒ፥ “ታ ጎዳዉ፥ ሀይሳቲ አይቤ?” ያጋዳ ኦይቻስ።</para>
  <para style="p" vid="ZEC 1:9">ታራ ሃሳያ ኪታንቾይ፥ “ሀይሳቲ አይበኮ ታኒ ነና በሳና” ያግስ።<verse eid="ZEC 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 1:10"/>ባርሰኔተ ም ጋርሳን ኤቅዳ ኡራይ፥ “ሀይሳቲ ሳኣ ኡባ ዩይድ ዎቻና መላ ጎዳይ ኪትዳይሳታ” ያግስ።<verse eid="ZEC 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 1:11"/>ኤንቲ ባርሰኔተ ም ጋርሳን ኤቅዳ ጎዳ ኪታንቹዋኮ፥ “ኑኒ ሳአ ኡባ ዩይድ ዎችዳ፤ ሳእ ዎፑ ግድ ሳሮ ደኤስ” ያግዶሶና።<verse eid="ZEC 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 1:12"/>ሄሳፈ ጉየ፥ ጎዳ ኪታንቾይ፥ “አቤት ኡባፈ ዎልቃማ ጎዳዉ፥ ኔኒ ሀንቀትን ሀእ ላፑን ታሙ ላይ ኩምስ፤ ያትን፥ ኔኒ የሩሳላመነ ይሁዳ ካታማታ ማሮና አዉደ ጋካናዉ ጋምአኔ?” ያግስ። <verse eid="ZEC 1:12"/><verse number="13" style="v" sid="ZEC 1:13"/>ጎዳይ ታራ ሃሳያ ኪታንቻዋስ ሎኦነ ምንያ ቃላን ዛሮ እሚስ።<verse eid="ZEC 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 1:14"/>ታራ ሃሳያ ኪታንቾይ ታኮ፥ “ሀ ቃላ አዋጃ! ኡባፈ ዎልቃማ ጎዳይ፥ ‘ታኒ የሩሳላመስነ ፅዮነስ ዳሮ ምሸታይስ። <verse eid="ZEC 1:14"/><verse number="15" style="v" sid="ZEC 1:15"/>ኑኒ ሳሮ ደኦስ ግድ ቆፕያ ሀራ ካዎተታ ቦላ ታኒ ዳሮ ሀንቀታስ። ታኒ ታ አሳ ቦላ ጉራ ሀንቀታስ፥ ሽን ኤንቲ አድ ታ ደርያ ቆህዶሶና።’ <verse eid="ZEC 1:15"/><verse number="16" style="v" sid="ZEC 1:16"/>ሄሳ ግሾ፥ ታኒ የሩሳላመኮ ማሮታን ስማና፤ ታ ኬይ ዛሪድ ያን ኬፀታና፤ የሩሳላመ ካታማ ቦላ ዋ ዎዶሮ የጋና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ZEC 1:17"/>ጉጃዳ ሀይሳዳ ያጋዳ አዋጃ፦ “ታ ካታማታ ዱረተይ ኩምድ ፓላሀና፤ ታኒ ጎዳይ ፅዮነ ዛራ ምንና፤ የሩሳላመ ዛራ ዶራና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 1:17"/></para>
  <para style="s1">ኦይዱ ካጨታ ቆንጨ</para>
  <para style="p">
    <verse number="18" style="v" sid="ZEC 1:18"/>ታኒ ቆንጨን ኦይዱ ካጨታ በአስ። <verse eid="ZEC 1:18"/><verse number="19" style="v" sid="ZEC 1:19"/>ታራ ሃሳያ ኪታንቹዋ፥ “ሀይሳቲ አይቤ?” ያጋዳ ኦይቻስ።</para>
  <para style="p" vid="ZEC 1:19">እ ዛሪድ፥ “ሀ ካጨት ይሁዳ፥ እስራኤለነ የሩሳላመ ላልዳ ካዎተታ” ያግስ።<verse eid="ZEC 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 1:20"/>ሄሳፈ ጉየ፥ ጎዳይ ታና ብራታ ቆፅያ ኦይዱ ሂላንቾታ በስስ። <verse eid="ZEC 1:20"/><verse number="21" style="v" sid="ZEC 1:21"/>ታኒ፥ “ሀይሳቲ አይ ኦናዉ ይዶና?” ያጋዳ ኦይቻስ።</para>
  <para style="p" vid="ZEC 1:21">እ ዛሪድ፥ “ሀይሳቲ ኦንካ ዛር ደንና መላ ይሁዳ ቢታ ላልዳ ካጨታ ካዉሻናዉነ ይሳናዉ ይዶሶና። ኤንቲ ይሁዳ ቢታ ላላናዉ ባንታ ካጭያ ደንዳ ሀራ ካዎተታ ካጭያ ሾጭድ ሳአን የጋናዉ ይዶሶና” ያግስ።<verse eid="ZEC 1:21"/></para>
  <chapter eid="ZEC 1"/>
  <chapter number="2" style="c" sid="ZEC 2"/>
  <para style="s1">የገ ዎዶሮ ኦይክዳ ኡራ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 2:1"/>ሀራ ቆንጨን ባ ኩሸን ዋ ዎዶሮ ኦይክዳ እስ አስ በአስ። <verse eid="ZEC 2:1"/><verse number="2" style="v" sid="ZEC 2:2"/>ታኒ፥ “ኔኒ አዉ ባይ?” ያጋዳ ኦይቻስ።</para>
  <para style="p" vid="ZEC 2:2">እ ዛሪድ፥ “ታኒ የሩሳላመ ዳልጋተይነ አዱሳተይ አይ መለኮ ዋናዉ ባይስ” ያግስ።<verse eid="ZEC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 2:3"/>ሄሳፈ ጉየ፥ ታራ ሃሳያ ኪታንቾይ ከይድ ብስ፤ እያራ ጋሄታናዉ ሀራ ኪታንቾይ ይስ። <verse eid="ZEC 2:3"/><verse number="4" style="v" sid="ZEC 2:4"/>ይዳ ኪታንቾይ፥ “ዎፃ ባዳ፥ ናአተ አድያኮ፥ ‘የሩሳላመን ዳሮ አስነ ዳሮ መሄይ ዳና ግሾ፥ ካታማ ዩሾን ግምበ ድርስ ኮሸና። <verse eid="ZEC 2:4"/><verse number="5" style="v" sid="ZEC 2:5"/>ታኒ እያ ዩሹዋን ታማ ድርስ ግዳና፤ ታኒ እያዉ ቦንቾ ግዳና’ ያጌስ ጎዳይ።<verse eid="ZEC 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 2:6"/>“ታኒ ህንተና ቢታ ኦይዱ ባጋ ላልዳ ግሾ፥ ያፐ ከይተ፤ ኤለ ከይተ፤ ፑደሀ ባጋ ቢታፈ ባቃትተ” ያጌስ ጎዳይ።<verse eid="ZEC 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 2:7"/>“ነኖ፥ ፅዮነ ከያ፤ ባብሎነ ማጫ ናይታ ግዶን ደእያረ፥ ኤንታ ግዶፈ ባቃታ” ያጌስ ጎዳይ።<verse eid="ZEC 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 2:8"/>ኡባፈ ዎልቃማ ጎዳይ እያ ቦንቹዋ ቆንጭሳና መላ፥ ባ አሳ ቦንቅዳ ካዎተታኮ ታና ኪትድ፥ “ህንተና ቦችያ ኡራይ እያ አይፍያ ቡሉዋ ቦቼስ። <verse eid="ZEC 2:8"/><verse number="9" style="v" sid="ZEC 2:9"/>ታኒ ታ ኩሽያ ኤንታ ቦላ ደንና፤ ኤንታ አይለት ኤንታ ዛሪድ ቦንቃና። ሄ ዎደ ህንተ ኡባፈ ዎልቃማ ጎዳይ ታና ኪትዳይሳ ኤራና።”<verse eid="ZEC 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 2:10"/>“ታኒ ያዳ ህንተ ግዶን ዳና ግሾ፥ ፅዮነ አሳዉ፥ ዛማርተ፤ ኡፋይትተ!” ያጌስ ጎዳይ።<verse eid="ZEC 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 2:11"/>ሄ ዎደ ዳሮ ካዎተት ጎዳራ ጋሄትድ እያ አሰ ግዳና። እ ህንተ ግዶን ዳና፤ ኡባፈ ዎልቃማ ጎዳይ ታና ህንተኮ ኪትዳይሳ ሄ ዎደ ህንተ ኤራና። <verse eid="ZEC 2:11"/><verse number="12" style="v" sid="ZEC 2:12"/>ጌሻ ቢታን ይሁዳ፥ ባና ጋክዳ ግሾ ኦድ ላታና፤ የሩሳላመ ዛሪድ ዶራና። <verse eid="ZEC 2:12"/><verse number="13" style="v" sid="ZEC 2:13"/>ጎዳይ ባ ደእያ ጌሻ በሳን ደንድዳ ግሾ፥ አሾ ማእዳ ኡባይ እያ ስንን ስእ ጎ!<verse eid="ZEC 2:13"/></para>
  <chapter eid="ZEC 2"/>
  <chapter number="3" style="c" sid="ZEC 3"/>
  <para style="s1">ካህነ ሀላቃ ማኡዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 3:1"/>ሄሳፈ ጉየ፥ ካህነ ሀላቃይ እያሱይ ጎዳ ኪታንቹዋ ስንን ኤቅዳይሳነ ፃላሄይ እያሱ ሞታናዉ እያፐ ኡሻቻ ባጋራ ኤቅዳይሳ ታና ቆንጨን በስስ። <verse eid="ZEC 3:1"/><verse number="2" style="v" sid="ZEC 3:2"/>ጎዳይ፥ “ፃላህያዉ፥ ጎዳይ ነና ሴሮ፤ የሩሳላመ ዶርዳ ጎዳይ ነና ሴሮ! ሀ አደይ ታማፐ አትዳ ዱንቻ መላ ግደኔ?” ያግስ።<verse eid="ZEC 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 3:3"/>እያሱይ ቅታትዳ ማኦ ማእድ ኪታንቹዋ ስንን ኤቅስ። <verse eid="ZEC 3:3"/><verse number="4" style="v" sid="ZEC 3:4"/>ኪታንቾይ ባ ስንን ኤቅዳይሳታ፥ “እያ ቦላፈ ሀ ቅታ ማኡዋ ቃርተ” ያግስ። ቃስ እያሱኮ፥ “ሄኮ፥ ታኒ ነ ናጋራ ኔፐ ድጋስ፤ ቦንቾ ማኡዋ ነና ማይዛና።” <verse eid="ZEC 3:4"/><verse number="5" style="v" sid="ZEC 3:5"/>ታኒ፥ “ጌሻ ፃ ቃጭያ እያ ሁጰን ፃፅተ” ያግስ። ኤንቲ ኪትዳይሳዳ ኦዶሶና፤ ማኦ ማይዝዶሶና። ጎዳ ኪታንቾይ ሄ ዎደ እያ ምየን ኤቅስ።<verse eid="ZEC 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 3:6"/>ሄሳፈ ጉየ፥ ጎዳ ኪታንቾይ እያሱኮ፥ <verse eid="ZEC 3:6"/><verse number="7" style="v" sid="ZEC 3:7"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፤ “ኔኒ ታ ኦግያን ሄመትኮነ ታ ኪታ ናግኮ፥ ኔኒ ታ ኬ አይሳና፤ ታ ዳባባን አዋታና። ቃስ ሀይሳን ኤቅዳይሳታራ እስፈ ገልያነ ከይያ ማታ ነዉ እማና። <verse eid="ZEC 3:7"/><verse number="8" style="v" sid="ZEC 3:8"/>ካህነ ሀላቃ እያሱ፥ ሀይሳ ስአ! ስንራ ያና ሎኦባስ ማላታ ግድዳይሳትነ ኔራ ኦይሳት ሀይሳ ስኦ! ታኒ፥ ‘ታሸ’ ጌተትያ ታ አይልያ ኤሀና። <verse eid="ZEC 3:8"/><verse number="9" style="v" sid="ZEC 3:9"/>ሄኮ፥ ታኒ እያሱ ስንን ሹቹ ዎና፤ ሄ ሹቻ ቦላ ላፑን አይፈት ደኦሶና። ታኒ ሄ ሹቻ ዎጫዳ እያ ቦላ ፁፈ ፃፋና፤ ሀ ቢታ ናጋራ እስ ጋላስ ድጋና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 3:10"/>“ሄ ጋላስ ህንተ ኡባይ ህንተ ዎይነነ ህንተ ባላሰ ጋርሳን ኡትድ ህንተ ሾሩዋ ፄጋና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 3:10"/></para>
  <chapter eid="ZEC 3"/>
  <chapter number="4" style="c" sid="ZEC 4"/>
  <para style="s1">ፆምፐ ዎያ ኮጫ ቆንጨ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 4:1"/>ሄሳፈ ጉየ፥ ታራ ሃሳያ ኪታንቾይ ስሚድ ይድ፥ ስክዳ አስ ባርክያ መላ ታና ባርክስስ። <verse eid="ZEC 4:1"/><verse number="2" style="v" sid="ZEC 4:2"/>እ ታኮ፥ “ኔኒ አይ በአይ?” ያግስ።</para>
  <para style="p" vid="ZEC 4:2">ታኒ ዛራዳ፥ “ታኒ ዎርቃ ፃላላፐ ኦሰትዳ ፆምፐ ዎያ ኮጫ በአይስ፤ እያ ፄራን ዛይተ ፃሮይ ደኤስ። ቃስ እያ ቦላ ላፑን ፆምፐት ደኦሶና፤ ሄ ላፑን ፆምፐታስ ላፑን ላፑን ፒቀት ደኦሶና። <verse eid="ZEC 4:2"/><verse number="3" style="v" sid="ZEC 4:3"/>ሄ ፆምፕያ ዎያ ኮጫ ማታን ናምኡ ሻማሆ ምት ደኦሶና። ኤንቲ ዛይተ ፃሩዋፐ ኡሻቻ ባጋራነ ሀድርሳ ባጋራ ደኦሶና” ያጋስ።<verse eid="ZEC 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 4:4"/>ታራ ሃሳያ ኪታንቹዋ፥ “ታ ጎዳዉ፥ ሀይስ አይቤ?” ያጋዳ ኦይቻስ።<verse eid="ZEC 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 4:5"/>ኪታንቾይ ዛሪድ፥ “ሀይሳቲ አይበኮ ኤርኪ?” ያግስ።</para>
  <para style="p" vid="ZEC 4:5">ታኒ ዛራዳ፥ “ታ ጎዳዉ፥ ታኒ ኤርከ” ያጋስ።<verse eid="ZEC 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 4:6"/>እ ታኮ፥ “ዛሩባበላስ ጎዳይ ኦድዳ ቃላይ ሀይሳ፤ ‘ታ አያናናፐ አትሽን፥ ዎልቃን ዎይኮ ምኖተን ግደና’ ያጌስ ኡባፈ ዎልቃማ ጎዳይ። <verse eid="ZEC 4:6"/><verse number="7" style="v" sid="ZEC 4:7"/>ግታ ዙማዉ፥ ኔኒ አይቤ? ኔኒ ዛሩባበላ ስንን ልች ግዳ ደምባ ግዳና። ዛሩባበል ፆሳ ኬ ኬፅ ፖልድ፥ ዉርሰ ሹቻ ከስያ ዎደ አሳይ፥ ‘ሀሹ! ሀሹ ፖለትስ’ ” ያጋና።<verse eid="ZEC 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 4:8"/>ቃስካ ጎዳ ቃላይ ታኮ ሀይሳዳ ያግድ ይስ። <verse eid="ZEC 4:8"/><verse number="9" style="v" sid="ZEC 4:9"/>“ፆሳ ኬ ባሱዋ ዛሩባበላ ኩሸት ባስዶሶና፤ እያ ኩሸት ኬፅድ ፖላና። ሄሳፈ ጉየ፥ ኡባፈ ዎልቃማ ጎዳይ ታና ህንተኮ ኪትዳይሳ ህንተ ኤራና። <verse eid="ZEC 4:9"/><verse number="10" style="v" sid="ZEC 4:10"/>ሀ ጉ ዶመ ካያ ኦንካ ጉየፐ ኡፋይታና፤ ኤንቲ ዛሩባበላ ኩሸን ቱምብያ በአና። ሀይሳቲ ላፑን ፆምፐት ቢታ ኡባ ዩይድ ፄልያ ጎዳ አይፈታ” ያግስ።<verse eid="ZEC 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 4:11"/>ታኒ ኪታንቹዋ ዛራዳ፥ “ሀ ፆምፐ ዎያ ኮጫፐ ኡሻቻ ባጋራነ ሀድርሳ ባጋራ ደእያ ሀ ናምኡ ሻማሆት አይቤ?” ያጋዳ ኦይቻስ። <verse eid="ZEC 4:11"/><verse number="12" style="v" sid="ZEC 4:12"/>ጉጃዳካ፥ “ዛይተይ ኤንታፈ ጎግያ ናምኡ ዎርቃ ፒቀታ ማታን ደእያ ናምኡ ሻማሆ ም ታሸት አይቤ?” ያጋዳ ኦይቻስ።<verse eid="ZEC 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 4:13"/>እ ዛሪድ፥ “ሀይሳቲ አይበኮ ኔኒ ኤርኪ?” ያግስ።</para>
  <para style="p" vid="ZEC 4:13">ታኒ ዛራዳ፥ “ታ ጎዳዉ፥ ታኒ ኤርከ” ያጋስ።<verse eid="ZEC 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 4:14"/>እ ዛሪድ፥ “ሀይሳቲ ሳአ ኡባ ጎዳስ ኦያ ናምኡ ትየትዳ አሳታ” ያግስ።<verse eid="ZEC 4:14"/></para>
  <chapter eid="ZEC 4"/>
  <chapter number="5" style="c" sid="ZEC 5"/>
  <para style="s1">ፃ ማፃፋ ቆንጨ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 5:1"/>ቃስ ታኒ ቁ ጋዳ ፄልያ ዎደ ቦላራ ፕራያ እስ ፃ ማፃፋ በአስ።<verse eid="ZEC 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEC 5:2"/>ኪታንቾይ ታና፥ “ኔኒ አይ በአይ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="ZEC 5:2">ታኒ ዛራዳ፥ “ታኒ ቦላራ ፕራያ እስ ፃ ማፃፋ በአይስ፤ ሄ ማፃፋ አዱሳተይ ላታሙ ዋ ቃስ ጎምፓይ ታሙ ዋ” ያጋስ።<verse eid="ZEC 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 5:3"/>እ ታኮ፥ “ሀ ፃ ማፃፋ ግዶን ቢታ ኡባ ቦላ ያና ባደይ ፃፈትስ። ሄ ማፃፋን እስ ባጋራ፥ ‘ካይሶ ኡባይ ቢታፈ ያና’፤ ቃስ ሀንኮ ባጋራ፥ ‘ዎርዶን ጫቅያ ኡባይ ያና’ ግያ ፁፈይ ፃፈትስ። <verse eid="ZEC 5:3"/><verse number="4" style="v" sid="ZEC 5:4"/>‘ታኒ ሀ ባደ ኪታና፤ ሄ ባደይ ብድ፥ ካይሱዋ ሶነ ታ ሱንን ዎርዶ ጫቀይሳ ሶ ገላና። ሄ ኬ ገልድ ምነ ሹቻ ይሳና’ ” ያገስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 5:4"/></para>
  <para style="s1">ዳቾን ኡትዳ ማጫሰ ቆንጨ</para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 5:5"/>ሄሳፈ ጉየ፥ ታራ ሃሳያ ኪታንቾይ ታኮ ይድ፥ “አነ ቁ ጋዳ፥ ያባይ አይበኮ በአ” ያግስ።<verse eid="ZEC 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 5:6"/>ታኒ፥ “እ አይቤ?” ያጋዳ ኦይቻስ።</para>
  <para style="p" vid="ZEC 5:6">እ ዛሪድ፥ “ሀይስ ማክያ ዳቾ” ያግስ። ቃስ ጉጅድ፥ “ሀይስ አሳይ ሀ ቢታ ኡባን ኦዳ ናቁዋ ማላታ” ያግስ።<verse eid="ZEC 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 5:7"/>እርሳሰ ጌተትያ ብራታፐ ኦሰትዳ ዳቹዋ ካማ ደንያ ዎደ እስ ማጫስ ዳቹዋን ኡታሱ። <verse eid="ZEC 5:7"/><verse number="8" style="v" sid="ZEC 5:8"/>ኪታንቾይ፥ “ሀና ኢታተ ሌምሶ” ያግስ። እዮ ጉየ ዳቹዋን የግድ እርሳሰ ካማ ዛሪድ ካምስ።<verse eid="ZEC 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 5:9"/>ሄሳፈ ጉየ፥ ታኒ ቁ ጋዳ ፄልያ ዎደ ኤንታ ቀፍያን ጫርኮይ ደእያ፥ ፕራያ ናምኡ ማጫሳታ በአስ። ኤንታ ቀፈይ ጎሎ ቀፈ መላ ምኖ፤ ኤንቲ ዳቹዋ ሳአፐ ድንድ ኤክድ ፕራዶሶና።<verse eid="ZEC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 5:10"/>ታኒ ኪታንቹዋኮ፥ “ሀይሳቲ ዳቹዋ አዉ ኤፎና?” ያጋዳ ኦይቻስ።<verse eid="ZEC 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 5:11"/>እ ዛሪድ፥ “ኤንቲ እያዉ ኬ ኬፃናዉ ሳናኦራ ቢታ ኤፎሶና። ኬይ ኬፀት ስምኮ ኤንቲ ሄ ዳቹዋ እያዉ ጊግዳ በሳን ዎና” ያግስ።<verse eid="ZEC 5:11"/></para>
  <chapter eid="ZEC 5"/>
  <chapter number="6" style="c" sid="ZEC 6"/>
  <para style="s1">ኦይዱ ፓራ ጋረታ ቆንጨ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 6:1"/>ቃስ ታኒ ቁ ጋዳ ፄልያ ዎደ ኦይዱ ፓራ ጋረት ናምኡ ናሰ ብራታ ደረታፐ ግዶራ የይሳታ በአስ። <verse eid="ZEC 6:1"/><verse number="2" style="v" sid="ZEC 6:2"/>ኮይሮ ጋርያ ዞኦ ፓራት ጎቾሶና፤ ናምአን ጋርያ ካሬ ፓራት ጎቾሶና። <verse eid="ZEC 6:2"/><verse number="3" style="v" sid="ZEC 6:3"/>ሄን ጋርያ ቦ ፓራት ጎቾሶና፤ ኦይዳን ጋርያ ዋንጮ ፓራት ጎቾሶና። <verse eid="ZEC 6:3"/><verse number="4" style="v" sid="ZEC 6:4"/>ታኒ ኪታንቹዋኮ፥ “ታ ጎዳዉ፥ ሀይሳቲ አይቤ?” ያጋዳ ኦይቻስ።<verse eid="ZEC 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 6:5"/>ኪታንቾይ ዛሪድ፥ “ሀይሳቲ ቢታ ኡባ ጎዳ ስንን ኤቅድ ኦያ ኦይዱ ሳሎ ጫርኮታ። <verse eid="ZEC 6:5"/><verse number="6" style="v" sid="ZEC 6:6"/>ካሬ ፓራት ጎችያ ጋረይ ፑደሀ ባጋ ቢታ ቤስ፤ ቦ ፓራት ጎችያ ጋረይ ዉሎሀ ባጋ ቤስ፤ ዋንጮ ፓራት ጎችያ ጋረይ ዱገሀ ባጋ ቤስ” ያግስ።<verse eid="ZEC 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 6:7"/>ሄ ፓራት ቢታ ዎቻናዉ ከይዳ ዎደ ገደ ሃ ፓችፓሮሶና። ኪታንቾይ ኤንታኮ፥ “ብድ ቢታ ኡባ ዩይድ ዎችተ” ያግስ። ኤንቲ ብድ ቢታ ኡባ ዩይድ ዎችዶሶና። <verse eid="ZEC 6:7"/><verse number="8" style="v" sid="ZEC 6:8"/>ሄሳፈ ጉየ፥ ኪታንቾይ ባ ቃላ ቁ ኦድ፥ “ሄኮ፥ ፑደሀ ባጋ ቢታ ብዳ ፓራት ታ አያና ሄ ቢታን ሸምፕስዶሶና” ያግስ።<verse eid="ZEC 6:8"/></para>
  <para style="s1">እያሱስ ጊግዳ ካላቻ</para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 6:9"/>ጎዳ ቃላይ ታኮ ሀይሳዳ ያግሸ ይስ፦ <verse eid="ZEC 6:9"/><verse number="10" style="v" sid="ZEC 6:10"/>“ባብሎነ ድኤተፈ ስምዳ ሄልዳይ፥ ፆበይነ ያዳይ እምያ ብራነ ዎርቃ እሞታ ኤካዳ ሄ ጋላስ ሶፎንያሳ ናኣ እዮስያሳ ሶ ባ። <verse eid="ZEC 6:10"/><verse number="11" style="v" sid="ZEC 6:11"/>ኤንታፈ ኤክዳ ብራፐነ ዎርቃፈ ካላቻ መዳ እዮሳደቃ ናኣ፥ ካህነ ሀላቃ እያሱ ሁጰን ዎ። <verse eid="ZEC 6:11"/><verse number="12" style="v" sid="ZEC 6:12"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ ጋዳ እያዉ ኦዳ፦ ሄኮ፥ ታሸይ ባ በሳን ዳያ ግሾነ እ ፆሳ ኬ ኬፅያ ግሾ፥ እያ ሱንይ ‘ታሸ ጌተትዳ አደይ ሀይሳ። <verse eid="ZEC 6:12"/><verse number="13" style="v" sid="ZEC 6:13"/>ጎዳ ኬ ኬፃናይ እያ፤ እ ካዎተ ማኡዋ ማእድ፥ አራታን ኡትድ ሃራና። ቃስ እያ አራታ ማታን እስ ካህነይ ኤቃና፤ ኤንታ ናምኣ ግዶን እስፈተ ዳና።’ <verse eid="ZEC 6:13"/><verse number="14" style="v" sid="ZEC 6:14"/>ሄ ካላቻይ ሄልዳያ፥ ፆቢያ፥ ያዳያነ ሶፎንያሳ ናኣ እዮስያሳ ቆፍሶ ግድድ፥ ጎዳ ፆሳ ኬን ዳና” ያግስ።<verse eid="ZEC 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ZEC 6:15"/>ሄ ዎደ ሃሆ በሳን ደእያ አሳት ጎዳ ኬ ኬፅድ ማዳናዉ ያና። ኡባፈ ዎልቃማ ጎዳይ ታና ህንተኮ ኪትዳይሳ ህንተ ሄሳን ኤራና። ጎዳስ፥ ህንተ ፆሳስ ህንተ ፖሎ ኪተትኮ ሄስ ሀናና።<verse eid="ZEC 6:15"/></para>
  <chapter eid="ZEC 6"/>
  <chapter number="7" style="c" sid="ZEC 7"/>
  <para style="s1">ሱረ ፕርዳነ ማሮተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 7:1"/>ዳርዮስ ካዎትዳ ኦይዳን ላይን፥ ክሲላ ጌተትያ ኡዱፉን አጌናን፥ ኦይዳን ጋላሳን፥ ዛካርያሳኮ ይዳ ጎዳ ቃላይ ሀይሳ። <verse eid="ZEC 7:1"/><verse number="2" style="v" sid="ZEC 7:2"/>ቤተለ ካታማ አሳይ ሳረዜራ፥ ረገም-መለካነ ኤንታራ እስፈ ደእያ አሳታ ጎዳ አንጆይ ያና መላ ዎሳናዉ ኪትዶሶና። <verse eid="ZEC 7:2"/><verse number="3" style="v" sid="ZEC 7:3"/>ቃስ ኡባፈ ዎልቃማ ጎዳ ኬን ኦያ ካህነታነ ናበታ፥ “ዳሮ ላይ ኦሸ ጋምእዳይሳዳ ኑኒ ሀእካ እቻሻን አጌናን ዬካናዉነ ፆማናዉ በሲ?” ያግድ ኦይቻና መላ ኪትዶሶና።<verse eid="ZEC 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 7:4"/>ሄሳፈ ጉየ፥ ኡባፈ ዎልቃማ ጎዳ ቃላይ ሀይሳዳ ያግድ ታኮ ይስ፦ <verse eid="ZEC 7:4"/><verse number="5" style="v" sid="ZEC 7:5"/>“ቢታን ደእያ አሳ ኡባስነ ካህነታስ ሀይሳዳ ያጋዳ ኦዳ፦ ‘ህንተ ሀ አዳ ላፑን ታሙ ላይን እቻሻን አጌናንነ ላፑን አጌናን ፆምዳይነ ዬክዳይ ታና ቦንቻናሴ? <verse eid="ZEC 7:5"/><verse number="6" style="v" sid="ZEC 7:6"/>ህንተ ምያ ዎደነ ኡያ ዎደ ህንተዉ ሜታነ ኡዬታ። <verse eid="ZEC 7:6"/><verse number="7" style="v" sid="ZEC 7:7"/>የሩሳላመ ካታማይነ እያ ዩሹዋን ደእያ ካታማታን ደእያ አሳይ ሸምፖንነ እንጀን ደእዳ ዎደነ ነገባንነ ጋን አሳይ ዎፑ ግድ ደእዳ ዎደ ጎዳይ ባ ናበታ ባጋራ ኦድዳ ቃላይ ሀይሳ ግደኔ?’ ያጋ” ያግስ።<verse eid="ZEC 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 7:8"/>ጎዳ ቃላይ ዛካርያሳኮ ሀይሳዳ ያግድ ይስ፦ <verse eid="ZEC 7:8"/><verse number="9" style="v" sid="ZEC 7:9"/>“ኡባፈ ዎልቃማ ጎዳይ ካሰ እምዳ ኪታይ፥ ‘ሱረ ፕርዳ ፕርድተ፤ ህንተ እሶይ እሱዋስ ኬሀተነ ማሮተ ኦተ። <verse eid="ZEC 7:9"/><verse number="10" style="v" sid="ZEC 7:10"/>አምኤታ፥ ይኦታ፥ በተ አሳነ ማንቆታ ናቆፍተ። ቃስ ህንተፈ ኦንካ ባ እሻ ቦላ ኢታባ ኦናዉ ባ ዎዛናን ቆፖፎ።’<verse eid="ZEC 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 7:11"/>“ሽን ኤንቲ ስኦና እፅዶሶና፤ ዞኮ ዛሪድ ባንታ ሀይ ቱጭዶሶና። <verse eid="ZEC 7:11"/><verse number="12" style="v" sid="ZEC 7:12"/>ኡባፈ ዎልቃማ ጎዳይ ባ አያናን ካሰ ባ ናበታ ባጋራ ኪትዳ ህግያነ ቃላ ስኦና እፅድ ባንታ ዎዛና ዛላዳ ምንዶሶና። ሄሳ ግሾ፥ ኡባፈ ዎልቃማ ጎዳ ማታፐ ግታ ሀንቆይ ኤንታ ቦላ ይስ። <verse eid="ZEC 7:12"/><verse number="13" style="v" sid="ZEC 7:13"/>ታኒ ፄግያ ዎደ ኤንቲ ስኦና እፅዳይሳዳ ኤንቲ ፄግያ ዎደ ታኒ ስእከ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 7:14"/>“ታኒ ጎተ ኤሀዳ ኤንቲ ኤሮና ካዎተታ ግዶን ላላስ። ቢታይ አስ ያነ ሃነ ስመረቶና ካይሳ ቢታ ግድስ፤ ሀ ሎኦ ቢታይ ባይሳ ግድስ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 7:14"/></para>
  <chapter eid="ZEC 7"/>
  <chapter number="8" style="c" sid="ZEC 8"/>
  <para style="s1">የሩሳላመይ ኦራፃና</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 8:1"/>ኡባፈ ዎልቃማ ጎዳ ቃላይ ቃስካ ታኮ ሀይሳዳ ያግድ ይስ፦ <verse eid="ZEC 8:1"/><verse number="2" style="v" sid="ZEC 8:2"/>ኡባፈ ዎልቃማ ጎዳይ፥ “ታኒ ፅዮነስ ዳሮ ቃታይስ፤ እ ምሻይ ታና ፁጌስ። <verse eid="ZEC 8:2"/><verse number="3" style="v" sid="ZEC 8:3"/>ታኒ ፅዮነ ስማዳ የሩሳላመን ዳና። ቃስ የሩሳላመይ አማንያ ካታማ ጌተታዳ ኤረታና። ኡባፈ ዎልቃማ ጎዳ ዙማይ ጌሻ ዙማ ጌተትድ ፄገታና” ያጌስ።<verse eid="ZEC 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 8:4"/>ኡባፈ ዎልቃማ ጎዳይ፥ “ጭምድ ጉፈራ ብያ አደይነ ማጫሳይ ካሰይሳዳ የሩሳላመ ዳባባን ኡታና። <verse eid="ZEC 8:4"/><verse number="5" style="v" sid="ZEC 8:5"/>የሩሳላመ ካታማ ኦገት ካእያ አደነ ማጫ ናይታን ኩማና” ያጌስ።<verse eid="ZEC 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 8:6"/>“አትዳ አሳስ ሄስ ማላልስያባ ግድኮካ፥ ታና ሄስ ማላልስያባዬ? ያጌስ ኡባፈ ዎልቃማ ጎዳይ። <verse eid="ZEC 8:6"/><verse number="7" style="v" sid="ZEC 8:7"/>ሄኮ ታኒ ታ አሳ ዶሎሀፐነ ዉሎሀፐ ሺሻና። <verse eid="ZEC 8:7"/><verse number="8" style="v" sid="ZEC 8:8"/>ኤንቲ የሩሳላመን ዳና መላ ኦና። ኤንቲ ታ አሰ ግዳና፤ ታኒ ፅሎነ አማንያ ኤንታ ፆሳ ግዳና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 8:9"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፦ “ህንተኖ፥ ኡባፈ ዎልቃማ ጎዳ ኬ ባሶይ የገትዳ ጋላሳፐ ዶምድ ናበት ኦድዳ ቃላ ስእዳይሳቶ፥ ህንተ ኩሽያ ምንተ፤ ኦሱዋ ምንድ ፖልተ። <verse eid="ZEC 8:9"/><verse number="10" style="v" sid="ZEC 8:10"/>ሄ ዎድያፐ ካሰ አሳስ ዳሞዘይ፥ መህያስ ቃንፀትያ ከር ባዋ። ታኒ አሳ ኡባ እሱዋ እሱዋ ቦላ ሞርከተን ደንዳ ግሾ፥ ገለይሳስነ ከየይሳስ ሳሮይ ባዋ። <verse eid="ZEC 8:10"/><verse number="11" style="v" sid="ZEC 8:11"/>ሽን ሀእ ታኒ ሀ አትዳ አሳ ቦላ ካሰ ኦዳይሳዳ ኦከ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 8:12"/>“ኤንቲ ዘርዳ ኡባይ ዶላና፤ ዎይነይ ባ አይፍያ እማና፤ ጎሻይ ካን ኩማና፤ ሳሎት ባንታ እራ እማና። ሀይሳ ኡባ አትዳ አሳስ ላታ ኦዳ እማና። <verse eid="ZEC 8:12"/><verse number="13" style="v" sid="ZEC 8:13"/>ህንተኖ፥ ይሁዳ አሳዉ፥ እስራኤለ አሳዉ፥ ካዎተታ ግዶን ህንተ ባደትዳይሳታ ግድደታ፥ ሽን ሀእ ታኒ ህንተና አሻና፤ ህንተ አንጀትዳይሳታ ግዳና። ያዮፍተ! ህንተ ኩሽያ ምንተ!” ያጌስ።<verse eid="ZEC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 8:14"/>“ህንተ ማይዛት ታና ይሎይዳ ዎደ ኤንታ ቃይ ባይና ሴራናዉ ቆፋ ቃቻስ። <verse eid="ZEC 8:14"/><verse number="15" style="v" sid="ZEC 8:15"/>ሀእ ታኒ የሩሳላመስነ ይሁዳስ ሎኦባ ኦናዉ ቆፋ ቃቻስ። ህዛ ያዮፍተ! <verse eid="ZEC 8:15"/><verse number="16" style="v" sid="ZEC 8:16"/>ህንተ ኦናዉ ኮሽያባይ ሀይሳ፦ እሶይ እሱዋራ ቱማ ኦደትተ፤ ፕርዳ ዳባባን ቱማነ ሳሩዋ ኤህያ ፕርዳ ፕርድተ። <verse eid="ZEC 8:16"/><verse number="17" style="v" sid="ZEC 8:17"/>እሶይ እሱዋ ቆሀናዉ ኢታባ ህንተ ዎዛናን ማቀቶፍተ፤ ዎርዶን ጫቆፍተ። ሀይሳታ ኡባ ታኒ እፃይስ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ZEC 8:18"/>ኡባፈ ዎልቃማ ጎዳ ቃላይ ቃስካ ታኮ ሀይሳዳ ያግድ ይስ፦ <verse eid="ZEC 8:18"/><verse number="19" style="v" sid="ZEC 8:19"/>“ኦይዳን፥ እቻሻን፥ ላፑንነ ታማን አጌናን ህንተ ፆምዳ ፆማይ ይሁዳ አሳስ ኡፋይስነ እንጀ ዎደ ግዳና። ሄሳ ግሾ፥ ህንተ ቱማተነ ሳሮተ ዶስተ” ያጌስ።<verse eid="ZEC 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 8:20"/>“ዳሮ አሳይነ ዳሮ ካታማታን ደእያ አሳይ የሩሳላመ ያና። <verse eid="ZEC 8:20"/><verse number="21" style="v" sid="ZEC 8:21"/>እስ ካታማን ደእያ አሳይ ሀራ ካታማን ደእያ አሳኮ ብድ፥ ‘ጎዳ አንጆይ ያና መላ ዎሳናዉነ ኡባፈ ዎልቃማ ጎዳ ኮያናዉ አነ ቦስ፤ ታንካ ባይስ’ ያጋና። <verse eid="ZEC 8:21"/><verse number="22" style="v" sid="ZEC 8:22"/>ቃስ ዳሮ አሳይነ ዎልቃማ ካዎተት ኡባፈ ዎልቃማ ጎዳ ኮያናዉነ ዎሳናዉ የሩሳላመ ያና። <verse eid="ZEC 8:22"/><verse number="23" style="v" sid="ZEC 8:23"/>ሄ ጋላሳታን ዱማ ዱማ ቃላን ሃሳያ ካዎተታ ኡባፈ ታሙ አሳት ይድ፥ እስ አይሁደ አድያ ማኡዋ ማጫራ ኦይክድ፥ ‘ፆሳይ ህንተራ ደኤይሳ ኑኒ ስእዳ ግሾ፥ ኑኒ ህንተራ ባና’ ያጋና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 8:23"/></para>
  <chapter eid="ZEC 8"/>
  <chapter number="9" style="c" sid="ZEC 9"/>
  <para style="s1">እስራኤለ ሞርከት ፕርደታና ፕርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 9:1"/>አሳ አይፈይነ እስራኤለ አሳ ኡባ አይፈይ ጎዳ ፄልያ ግሾ፥ ሳድራካ ቢታይነ ዳማስቆ ካታማይ ያናይሳ፥ ጎዳይ ኦድዳ ፕርዳ ቃላይ ሀይሳ። <verse eid="ZEC 9:1"/><verse number="2" style="v" sid="ZEC 9:2"/>ቃስ ሀ ፕርዳይ ሀድራካ ዛዋ ግድዳ ሀማታ ካታማነ ቃራ ግድዳ ፅሮሳነ ስዶና ካታማታ ቦላ ሀ ፕርዳይ ጋካና። <verse eid="ZEC 9:2"/><verse number="3" style="v" sid="ZEC 9:3"/>ፅሮሳ ካታማይ ባዉ ምኖ ሚፃ ግምብስ። ቃስ ብራነ ዎርቃ ቢታዳ ዶርስ። <verse eid="ZEC 9:3"/><verse number="4" style="v" sid="ZEC 9:4"/>ሽን እ ሺሽዳባ ኡባ ጎዳይ ኤካና፤ እያ ሻሉዋ አባን ሆላና፤ ካታማይ ታማን ሜተታና።<verse eid="ZEC 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 9:5"/>አስቃሎና ካታማይ ሄሳ በእድ ያያና፤ ጋዛ ካታማይ ኡንኤታና፤ ኤቅሮና ካታማይ ኡፋይስ ያና። ጋዛ ካዎይ ያና፤ አስቃሎና ካታማይ ካይሳ ግዳና። <verse eid="ZEC 9:5"/><verse number="6" style="v" sid="ZEC 9:6"/>አሽዶዳ ካታማን ዋላሀ አሳይ ዳና።</para>
  <para style="p" vid="ZEC 9:6">ጎዳይ ሀይሳዳ ያጌስ፦ “ፍልስፄመታ ኦቶሩዋ ታኒ ዉርሳና። <verse eid="ZEC 9:6"/><verse number="7" style="v" sid="ZEC 9:7"/>ታኒ ኤንታ ዶናፐ ሱ፥ ኤንታ አቻፈ ቱናባ ድጋና። ኤንታፈ አትዳይሳት ኑ ፆሳ አስ ግዳና፤ ቃስ ይሁዳ ያራፐ እሱዋ ግዳና። ኤቅሮና አሳይ ያቡሰ አሳዳ ታ አሰ ግዳና። <verse eid="ZEC 9:7"/><verse number="8" style="v" sid="ZEC 9:8"/>ሄሳፈ ጉየ፥ ኦላንቾት ኦይኮናዳ፥ ታኒ ታ ኬ ናጋና። ታኒ ታ ሁጰን ናግያ ግሾ፥ ዛሪድ ኦንካ ታ አሳ ኡንኤና” ያጌስ።<verse eid="ZEC 9:8"/></para>
  <para style="s1">ፅዮነ ካዋ ዩሳ</para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 9:9"/>ነኖ፥ ፅዮነ ካታመ፥ ኡፋይታ! ነኖ፥ የሩሳላመ ካታመ፥ እልላ! ሄኮ፥ ፆንዳ ነ ፅሎ ካዎይ ኔኮ ዬስ። ነ ካዎይ አሽከ ግድድ፥ ሀረ ቦላ፥ አድ ሀረ ማራ ቦላ ኡትድ ኔኮ ዬስ።<verse eid="ZEC 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 9:10"/>ታኒ ፓራ ጋረታ እስራኤለፐ፥ ኦላ ፓራታ የሩሳላመፐ ይሳና፤ ኦላ ዶንግያ መንረና። ነ ካዎይ ካዎተታስ ሳሮ አዋጃና፤ እ አባስ ጋፃፐ ህን ጋፃ ጋካናዉ ኤፍራፂሳ ሻፋፐ ዶምድ ሳኣ ጋፃ ጋካናዉ ሃራና።<verse eid="ZEC 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 9:11"/>ታኒ ኔራ ሱ ጫቁዋ ግሾ፥ ቃሸትዳ ነ አሳታ ሃ ባይና ኦላፈ ከሳና። <verse eid="ZEC 9:11"/><verse number="12" style="v" sid="ZEC 9:12"/>ህንተኖ፥ ስንን ኡፋይስ ደእያ ቃሾ አሳቶ፥ ህንተ ሚፃ ስምተ። ካሰይሳ ግሾ ዳኮ ሻሎ ህንተዉ እማናይሳ ሀች ታኒ ህንተዉ አዋጃይስ። <verse eid="ZEC 9:12"/><verse number="13" style="v" sid="ZEC 9:13"/>ታኒ ይሁዳ ዶንገዳ፥ እስራኤለ ዶንገ ቶራዳ ጎኤታና። ፅዮነ፥ ታኒ ነ ናይታ ግርከ ናይታ ቦላ ደንና፤ ነና ዎልቃማ ኦላንቹዋ ማሻ መላ ኦና።<verse eid="ZEC 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 9:14"/>ሄ ዎደ ጎዳይ ኤንታ ቦላ ቆንጫና፤ እያ ዶንገ ቶራይ ዎልአንዳ ዎልአማና። ኡባ ሃርያ ጎዳይ ሞይዘ ፑናና፤ ዱገሀ ባጋ ጎተዳ ደንዳና። <verse eid="ZEC 9:14"/><verse number="15" style="v" sid="ZEC 9:15"/>ኡባፈ ዎልቃማ ጎዳይ ኤንታ ግሾ ኦለታና። ኤንቲ ባንታ ሞርከታ ዉርሳና፤ ያምባርሻን ኦለይሳታ የና። ኤንቲ ባንታ ሞርከታ ሱ ዎይነ ኡሻዳ ኡያና፤ ሱ ከረን ኩምያዳ ኩማና፤ ኤንቲ ያርሾ በሳን ጉክያ ሱዳ ጉካና።<verse eid="ZEC 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ZEC 9:16"/>ሄ ጋላስ ሄንንቾይ ባ ዶርሳታ አሸይሳዳ ጎዳይ ኤንታ ፆሳይ ኤንታ አሻና። ካላቻ ቦላ ደእያ አሌቆዳ ኤንቲ ጎዳ ቢታን ጶላና። <verse eid="ZEC 9:16"/><verse number="17" style="v" sid="ZEC 9:17"/>ኤንቲ ዋንድ ሎኦነ ፑላንቾ ግዳንደሻ! ናአተ ናይታ ካይ፥ ጌላኦ ናይታ ዎይነ ኡሻይ አጭሳና።<verse eid="ZEC 9:17"/></para>
  <chapter eid="ZEC 9"/>
  <chapter number="10" style="c" sid="ZEC 10"/>
  <para style="s1">ፆሳይ ይሁዳ አንጃና</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 10:1"/>ባልጎይ ጋክያ ዎደ ጎዳይ እራ እማና መላ ዎስተ። ጎዳይ እራ ቶክዳ ሻራ ኪቴስ፤ አሳስ እራ እሜስ፤ ጎሻን አታክልተ ዶልስስ። <verse eid="ZEC 10:1"/><verse number="2" style="v" sid="ZEC 10:2"/>ኤቃት ሀዳባ ኦዶሶና፤ ማሮት ዎርዶ ቆንጨ በኦሶና፤ አሙሄይሳት ዎርዶ አሙሆ ኦዶሶና፤ ሀዳ ምን ምንሶና። ሄሳ ግሾ፥ አሳይ ይዳ ዶርሳዳ ቶይላቶሶና፤ ኤንታ ሄምያ አስ ባይና ግሾ፥ ኤንቲ ቆሄትዶሶና።<verse eid="ZEC 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 10:3"/>ጎዳይ ሀይሳዳ ያጌስ፦ “ታ ሀንቆይ ሄንንቾታ ቦላ ኤፅ ከይስ፤ ሄ ካለይሳታ ታኒ ሴራና። ኡባፈ ዎልቃማ ጎዳይ ባ ዉድያ ይሁዳ ሄሜስ። እ ኤንታ ኦላስ ጊግዳ ዎልቃማ ፓራ መላ ኦና። <verse eid="ZEC 10:3"/><verse number="4" style="v" sid="ZEC 10:4"/>ይሁዳ አሳ ግዶፈ ቁስተ ሹቻ መላ፥ ዱንካነ ሸ መላነ ኦላ ቶራ መላ ሀንዳ ካለይሳት ከያና። <verse eid="ZEC 10:4"/><verse number="5" style="v" sid="ZEC 10:5"/>ባንታ ሞርከታ ኦግያ ኡርቃዳ የያ ምኖ ኦላንቾታ መላ ግዳና። ጎዳይ ኤንታራ ደእያ ግሾ፥ ኤንቲ ኦለትድ ፆናና።<verse eid="ZEC 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 10:6"/>“ታኒ ይሁዳ አሳ ምንና፤ ዮሰፋ አሳ አሻና። ታኒ ኤንታዉ ቃትያ ግሾ፥ ኤንታ ዛራዳ ኤሀና። ኤንቲ ታኒ ካሰካ ኤንታ የጋቦና አሳ መላ ግዳና። ታኒ ጎዳ ኤንታ ፆሳ ግድያ ግሾ፥ ኤንታ ዎሳ ስአና። <verse eid="ZEC 10:6"/><verse number="7" style="v" sid="ZEC 10:7"/>እስራኤለ አሳይ ምኖ ኦላንቾ መላ ግዳና፤ ዎይነ ኡይዳ አሳዳ ኤንታ ዎዛናይ ኡፋይታና። ኤንታ ናይት ሄሳ በእድ፥ ሀሹ ጋና፤ ኤንታ ዎዛናይ ጎዳን ኡፋይታና።<verse eid="ZEC 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 10:8"/>“ታኒ ታ አሳ ሱይቃዳ ፄጋና፤ ኤንታ እስፈ ሺሻና። ታኒ ኤንታ ዎዛና፤ ኤንቲ ካሰይሳዳ ዳራና። <verse eid="ZEC 10:8"/><verse number="9" style="v" sid="ZEC 10:9"/>ታኒ ኤንታ ካዎተታ ግዶን ላልኮካ ኤንቲ ባንታ ደእያ ሃሆ ቢታን ግድድ ታና ሀሳያና። ቃስ ኤንትነ ኤንታ ናይቲ ደኦን ዳናነ ባንታ ቢታ ስማና።<verse eid="ZEC 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEC 10:10"/>“ታኒ ኤንታ ግብፀ ቢታፈ ዛራና፤</para>
  <para style="q2" vid="ZEC 10:10">አሶረ ቢታፈ ኤንታ ሺሻና።</para>
  <para style="q1" vid="ZEC 10:10">ኤንታዉ ኡትያ በሲ ያና ጋካናዉ</para>
  <para style="q2" vid="ZEC 10:10">ታኒ ኤንታ ጋላዳ ቢታንነ</para>
  <para style="q2" vid="ZEC 10:10">ልባኖሰ ቢታን ኩንና።<verse eid="ZEC 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEC 10:11"/>ኤንቲ መቶ አባ ግዶራ አያ ዎደ</para>
  <para style="q2" vid="ZEC 10:11">ታኒ ጎዳይ አባ ሴራና።</para>
  <para style="q1" vid="ZEC 10:11">ጪሞ ግድዳ ናይለ ሻፋይ መላና።</para>
  <para style="q2" vid="ZEC 10:11">አሶረ ቢታ ኦቶሮይ ካዉያና፤</para>
  <para style="q2" vid="ZEC 10:11">ግብፀ ካዎተ ፃምአይ መቃና።<verse eid="ZEC 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEC 10:12"/>ታኒ፥ ኤንታ ጎዳይ ኤንታ ምንና፤</para>
  <para style="q2" vid="ZEC 10:12">ኤንቲ እያ ሱንን ሄመታና።</para>
  <para style="q2" vid="ZEC 10:12">ታኒ ጎዳይ ሀይሳ ኦዳይስ” ያጌስ።<verse eid="ZEC 10:12"/></para>
  <chapter eid="ZEC 10"/>
  <chapter number="11" style="c" sid="ZEC 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="ZEC 11:1"/>ነኖ፥ ልባኖሰ፥</para>
  <para style="q2" vid="ZEC 11:1">ታም ነ ዝጋታ ማና መላ፥</para>
  <para style="q2" vid="ZEC 11:1">ነ ፐንገታ ዶያ!<verse eid="ZEC 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEC 11:2"/>ነኖ ፂዳዉ፥ ዝጋይ ኩንድዳ ግሾ፥</para>
  <para style="q2" vid="ZEC 11:2">ቦንቾ ምት ይዳ ግሾ፥ ዪ ጋዳ ዬካ!</para>
  <para style="q1" vid="ZEC 11:2">ህንተኖ ባሳና ዎላቶ፥</para>
  <para style="q2" vid="ZEC 11:2">ሄ ስከትዳ ዎራይ ማንኤትዳ ግሾ፥ ዪ ግድ ዬክተ።<verse eid="ZEC 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEC 11:3"/>ኤንታ ሎኦ ሄን በሳይ ይዳ ግሾ፥</para>
  <para style="q2" vid="ZEC 11:3">ሄንንቾታ ዘለልሳ ስእተ፤</para>
  <para style="q1" vid="ZEC 11:3">ዮርዳኖሰ ዎራይ ይዳ ግሾ፥</para>
  <para style="q2" vid="ZEC 11:3">ጋሞት ጉደይሳ ስእተ።<verse eid="ZEC 11:3"/></para>
  <para style="s1">ናምኡ ሄንንቾታ</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 11:4"/>ጎዳይ ታ ፆሳይ ታኮ ሀይሳዳ ያግስ፦ “ሹከታናዉ ደእያ ዶርሳ ዉድያ ሄማ። <verse eid="ZEC 11:4"/><verse number="5" style="v" sid="ZEC 11:5"/>ኤንታ ሻመይሳት ሹኮሶና፤ ሽን ሴረቶኮና። ባይዘይሳት፥ ‘ኑኒ ዱረትዳ፤ ጎዳይ ጋላተቶ’ ያጎሶና፤ ሀር አቶሽን፥ ኤንታ ሄንንቾት ኤንታዉ ቃቶኮና” ያግስ።<verse eid="ZEC 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 11:6"/>ጎዳይ ሀይሳዳ ያጌስ፦ “ታኒ ህዛፐ ጉየ ሀ ቢታን ደእያ አሳስ ቃትከ። ታኒ እስ እስ አሰ እያ ሾሩዋስነ እያ ካዋስ አዳ እማና። ኤንቲ ቢታ ይሳና፤ ታኒ እስ አስካ ኤንታ ኩሽያፐ አሽከ” ያጌስ።<verse eid="ZEC 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 11:7"/>ሄሳ ግሾ፥ ታኒ ሹከታናዉ ደእያ ዶርሳታ፥ አዳ ቃስ ዉድያ ግዶን ኡንኤትዳይሳታ ሄመይሳ ግዳስ። ያታዳ ዶርሳታ ሄማናዉ ናምኡ ፃምአታ ኤካዳ፥ እሱዋ “ዶሰትዳይሳ” ጋዳ ፄጋስ፤ ናምአንዋ “እስፈተ” ጋዳ ፄጋስ። <verse eid="ZEC 11:7"/><verse number="8" style="v" sid="ZEC 11:8"/>ታኒ እስ አጌናን ሄ ሄንንቾታ ይሳስ። ኤንታ ሀኖተይ ታዉ ዳንዳኤተና፤ ኤንትካ ታና እፅዶሶና። <verse eid="ZEC 11:8"/><verse number="9" style="v" sid="ZEC 11:9"/>ያታ ስማዳ ታ ዶርሳታኮ፥ “ታኒ ህንተና ናምአን ሄምከ፤ ሀይቀይስ ሀይቆ፤ የይስ ዮ፤ አትዳይሳት እሶይ እሱዋ ሞ” ያጋስ።<verse eid="ZEC 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 11:10"/>ሄሳፈ ጉየ ታኒ “ዶሰትዳይሳ” ጌተትያ ፃምአ ኤካዳ መንስ። ሄሳ ታ ኦዳይ ካዎተታራ ገልዳ ጫቆይ ዱፅዳይሳ በሳናሳ። <verse eid="ZEC 11:10"/><verse number="11" style="v" sid="ZEC 11:11"/>ሄ ጋላስ ጫቆይ መእስ፤ ሄ ዎደ ዶርሰ ሻመይሳትነ ባይዛይሳት ታና በእድ፥ ሄስ ጎዳ ቃላ ግደይሳ ኤርዶሶና። <verse eid="ZEC 11:11"/><verse number="12" style="v" sid="ZEC 11:12"/>ታኒ፥ “ህንተ ዶስኮ ታ ዳሞዝያ እምተ፤ እፃስ ጊኮ አጋግተ” ያጋስ። ያትን ኤንቲ ታዉ ሀስታሙ ብራ ሳንትመ እምዶሶና።<verse eid="ZEC 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 11:13"/>ጎዳይ ታኮ፥ “ኤንቲ እምዳ ቦንቾ ሚሽያ ኤፋዳ ፆሳ ኬን ደእያ ኦቱዋን የጋ” ያግስ። ታኒ ሄ ሚሽያ ኤፋዳ ፆሳ ኬን ደእያ ኦቱዋን የጋስ። <verse eid="ZEC 11:13"/><verse number="14" style="v" sid="ZEC 11:14"/>ሄሳፈ ጉየ፥ ታኒ ይሁዳስነ እስራኤለስ ግዶን ደእያ እሻተይ ይዳይሳ በሳናዉ “እስፈተ” ጌተትያ ታ ናምአን ፃምኣ መንስ።<verse eid="ZEC 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ZEC 11:15"/>ቃስካ ጎዳይ ታና፥ “ናምአን ባዳ ፓና ሄንንቾታ ሚሽያ ኤካ። <verse eid="ZEC 11:15"/><verse number="16" style="v" sid="ZEC 11:16"/>ታኒ ሀ ቢታን እስ ሄንንቾ ደንና። እ ቆሄትዳ ዶርሳታ ማደና፤ ላለትዳ ዶርሳታ ሺሸና፤ መቅዳ ዶርሳታ ኮለና፤ ፓፃ ደኤይሳታ ሄመና። ሽን እ ሄሳ አግድ፥ ሞታ ሹክድ ሜስ፤ ኤንታ ኮልዝያ ጌስ። <verse eid="ZEC 11:16"/><verse number="17" style="v" sid="ZEC 11:17"/>ዶርሳ ዉድያ የግ ይዳ ሄ ፓና ሄንንቾታ አየ! እያ ቀስያነ እያ ኡሻቻ አይፍያ ቦላ ማሽ ዎ። እያ ኡሻቻ ኩሸይ ስሎ፤ እያ ኡሻቻ አይፈይ ቆቆ” ያግስ።<verse eid="ZEC 11:17"/></para>
  <chapter eid="ZEC 11"/>
  <chapter number="12" style="c" sid="ZEC 12"/>
  <para style="s1">የሩሳላመ ሞርከት ያና</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 12:1"/>ሳሎታ ምጭዳይ፥ ሳኣ መዳይ፥ አሳስ ደኦ አያና እምዳ ጎዳይ እስራኤለባ ኦድዳ ጎዳ ቃላይ ሀይሳ፦ <verse eid="ZEC 12:1"/><verse number="2" style="v" sid="ZEC 12:2"/>“ሄኮ፥ ታኒ የሩሳላመ ካታማ፥ እያ ዩሹዋን ደእያ አሳ ኡባይ ኡይን ጋንድጋርስያ ዎይነ ኡሽ ትግያ ዋንጫ ኦና። የሩሳላመይ ኦይከትያ ዎደ ይሁዳ ካታማት ኦይከታና። <verse eid="ZEC 12:2"/><verse number="3" style="v" sid="ZEC 12:3"/>ሄ ዎደ ታኒ የሩሳላመ ካታማ አሳ ኡባስ ዴፆ ሹቹ ኦና፤ እያ ደንያ ኡባይ ባዉ ደሸታና። ሳኣ ካዎተት ኡባይ እያ ኦላናዉ እስፈ ሺቃና። <verse eid="ZEC 12:3"/><verse number="4" style="v" sid="ZEC 12:4"/>ሄ ዎደ ታኒ ፓራ ኡባ ዳጋንና፤ ፓራ አሳታ ጎሻና።” ታኒ ጎዳይ ሀይሳ ኦዳይስ። ይሁዳ አሳ ታኒ ታ ኬሀ አይፈን ፄላና፤ ሽን ሞርከታ ፓራታ ኡባ ቆቅሳና። <verse eid="ZEC 12:4"/><verse number="5" style="v" sid="ZEC 12:5"/>ሄ ዎደ ይሁዳ ሀላቃት ባንታ ዎዛናን፥ “የሩሳላመ አሳይ ኡባፈ ዎልቃማ ጎዳን፥ ባንታ ፆሳን፥ ምኖተ ደምዶሶና” ያጋና።<verse eid="ZEC 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 12:6"/>“ሄ ዎደ ታኒ ይሁዳ ኮቻታ ም ዶርያ ግዶን ደእያ ፂፋነ ምርቄታ ግዶን ላፅያ ፆምፐ ኦና። ኤንቲ ባንታ ኡሻቻን፥ ባንታ ሀድርሳንነ ባንታ ዩሹዋን ደእያ አሳ ኡባ ማና፤ ሽን የሩሳላመ ካታማይ፥ አሳይ ሳሮ ደእያ በሲ ግዳና።<verse eid="ZEC 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 12:7"/>“ዳዊታ ኮቻታ ቦንቾይነ የሩሳላመን ደኤይሳታ ቦንቾይ ይሁዳ አሳ ቦንቹዋፈ አና መላ ታኒ ጎዳይ ካሰታዳ ይሁዳ አሳስ ፆኖ እማና። <verse eid="ZEC 12:7"/><verse number="8" style="v" sid="ZEC 12:8"/>ሄ ዎደ ኤንታ ግዶን ዳሮ ላፋ ጌተትያ አስ ዳዊታ መላ ምኖ ግዳና። ታኒ ጎዳይ የሩሳላመን ደኤይሳታስ ጎንዳለ ግዳና። ዳዊታ ኮቻት ፆሳ መላ፥ ጎዳ ኪታንቾ መላ ግድድ ኤንታ ካለና። <verse eid="ZEC 12:8"/><verse number="9" style="v" sid="ZEC 12:9"/>ሄ ዎደ ታኒ የሩሳላመ ኦላናዉ ደንድያ ካዎተታ ኡባ ይሳናዉ ደንዳና።<verse eid="ZEC 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 12:10"/>“ሄ ዎደ ታኒ ዳዊታ ኮቻታ ቦላነ የሩሳላመን ደእያ አሳ ቦላ ቃነ ዎሳ አያና ጉሳና። ሄሳ ግሾ፥ ኤንቲ ባንታ ጫድዳይሳ በእያ ዎደ አስ ባ እስ ናአስ ዬከይሳዳ ዬካና። ቃስ ባ ባይራ ናአስ ካዮተይሳዳ ካዮታና። <verse eid="ZEC 12:10"/><verse number="11" style="v" sid="ZEC 12:11"/>ሄ ዎደ የሩሳላመን ዬከትያ ዬሆይ ማግዶ ደንባን ሀዳድ-ርሞናስ ዬከትዳ ዬሁዋ መላ ዎልቃማ ግዳና። <verse eid="ZEC 12:11"/><verse number="12" style="v" sid="ZEC 12:12"/>ቢታን ደእያ እስ እስ ኮቻይ ባዉ ባዉ ዬካና፤ ዳዊታ ኮቻት ባንታ ማቸታራ፥ ናታና ኮቻት ባንታ ማቸታራ ባንታዉ፥ <verse eid="ZEC 12:12"/><verse number="13" style="v" sid="ZEC 12:13"/>ሌወ ኮቻት ባንታ ማቸታራ ባንታዉ፥ ሳመአ ኮቻት ባንታ ማቸታራ ባንታዉ፥ ዬካና። <verse eid="ZEC 12:13"/><verse number="14" style="v" sid="ZEC 12:14"/>አትዳ ኮቻ ኡባይ ባዉ ባዉ ዬካና፤ ኤንታ ማቸት ባንታዉ ባንታዉ ዬካና” ያጌስ።<verse eid="ZEC 12:14"/></para>
  <chapter eid="ZEC 12"/>
  <chapter number="13" style="c" sid="ZEC 13"/>
  <para style="s1">ናጋራፐ ጌየ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 13:1"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፦ “ሄ ዎደ ዳዊታ ኮቻታነ የሩሳላመን ደኤይሳታ ናጋራፐነ ቱናተፈ ጌሽያ ፑልቶይ ቃና። <verse eid="ZEC 13:1"/><verse number="2" style="v" sid="ZEC 13:2"/>ሄ ዎደ ታኒ ኤንቲ ናምአን ቆፈቶና መላ ኤቃታ ሱን ቢታፈ ይሳና። ቃስ ናበታነ ቱና አያናታ ቢታፈ ይሳና። ታኒ ኡባፈ ዎልቃማ ጎዳይ ሀይሳ ኦዳይስ። <verse eid="ZEC 13:2"/><verse number="3" style="v" sid="ZEC 13:3"/>ቃስ ኦንካ፥ ታኒ ናበ ጊኮ፥ እያ አዋነ አይያ እያ፥ ‘ኔኒ ጎዳ ሱንን ዎርዶ ኦድያ ግሾ፥ ሀይቃናዉ በሴስ’ ያጋና። እ ትንብተ ኦድያ ዎደ እያ አዋይነ አይያ እያ ጫድድ ዎና። <verse eid="ZEC 13:3"/><verse number="4" style="v" sid="ZEC 13:4"/>ሄ ዎደ ታኒ ናበ ግያ ኦንካ ባ በእዳ ቆንጨን ዬላታና። ቃስ አሰ ጭማናዉ እክሰይ ደእያ ማኦ ማኤና። <verse eid="ZEC 13:4"/><verse number="5" style="v" sid="ZEC 13:5"/>ሽን እ፥ ‘ታኒ ናበ ግድከ፤ ናአተፈ ዶማዳ ቢታ ኦያ አስ’ ያጋና። <verse eid="ZEC 13:5"/><verse number="6" style="v" sid="ZEC 13:6"/>እስ አስ፥ ‘ያትን፥ ሀ ነ ቦላ ደእያ ማዱንይ አይቤ?’ ያግድ ኦይችኮ፥ እ፥ ‘ሀይስ ታኒ ታ ላገታ ሶን ማዱንፅዳይሳ’ ያጋና” ያጌስ።<verse eid="ZEC 13:6"/></para>
  <para style="s1">ሄንንቾይ ሾጨትን ዶርሳት ላለትዶሶና</para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 13:7"/>“ማሻዉ ደንዳ፥ ታዉ ማታ ግድዳ ታ ዶርሳታ ሄንንቹዋ ቦላ ባርካ! ዶርሳት ላለታና መላ ሄንንቹዋ ዎ። ታኒ ጉ ዶርሳታ ቦላ ታ ኩሽያ ደንና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ZEC 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 13:8"/>“ቢታ ኡባን ደእያ ሄ ኩሸ አሳፐ ናምኡ ኩሸይ ሾጨትድ ሀይቅን፥ እስ ኩሸ ፃላል አታና። ታኒ ጎዳይ ሀይሳ ኦዳይስ። <verse eid="ZEC 13:8"/><verse number="9" style="v" sid="ZEC 13:9"/>ሀ አትዳ ስኮ አሳ ታኒ ታማን የጋና፤ ብር ታማን ጌያዳ ኤንታ ጌሻና፤ ዎርቀይ ፓጨትያዳ ፓጫና። ሄሳፈ ጉየ፥ ኤንቲ ታ ሱንን ዎሳና፤ ታኒ ኤንታ ስአና። ታኒ ኤንታ፥ ‘ታ አሰ’ ጋና፤ ኤንቲ፥ ጎዳይ፥ ‘ኑ ፆሰ’ ያጋና” ያጌስ።<verse eid="ZEC 13:9"/></para>
  <chapter eid="ZEC 13"/>
  <chapter number="14" style="c" sid="ZEC 14"/>
  <para style="s1">ፆሳይ ያና፥ ካዎታና</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 14:1"/>ሄኮ፥ ጎዳ ፕርዳ ጋላሳይ ዬስ፤ ሄ ዎደ ህንተ ፄልሽን፥ ህንተፈ ቦንቅዳባ ህንተ ስንን ሻከታና። <verse eid="ZEC 14:1"/><verse number="2" style="v" sid="ZEC 14:2"/>ካዎተታ ኡባ ጎዳይ የሩሳላመ ቦላ ኦላስ ሺሻና። ካታማይ ኦይከታና፤ ኬይ ቦንቀታና፤ ማጫ አሳ ዎልቃን ኢሳና። ካታማ አሳፐ ባጋይ ድኤትድ ባና፤ ሽን አትዳ አሳይ ካታማፐ ከየና። <verse eid="ZEC 14:2"/><verse number="3" style="v" sid="ZEC 14:3"/>ሄሳፈ ጉየ ጎዳይ ከይድ፥ ካሰ ኦላ ጋላስ ኦለተይሳዳ ካዎተታ ኦላና። <verse eid="ZEC 14:3"/><verse number="4" style="v" sid="ZEC 14:4"/>ሄ ጋላስ እያ ቶሆት የሩሳላመፐ ዶሎሀ ባጋራ ደእያ ሻማሆ ዙማ ቦላ ኤቃና። ሻማሆ ደረይ ዶሎሀፐ ዉሎሀ ጋካናዉ ናምኡ ከይድ ጳልቀትን፥ ዳሮ ግታ ዛንጋራይ መታና። ዙማፐ ባጋይ ፑደሀ ባጋ፥ ቃስ ባጋይ ዱገሀ ባጋ ሸርእ ጋና። <verse eid="ZEC 14:4"/><verse number="5" style="v" sid="ZEC 14:5"/>ሄ ዛንጋራይ ብድ አፄላ ጋካና፤ ህንተ ሄ ዛንጋራራ ባቃት አድ አታና። በን ይሁዳ ካዋ ኦዝያነ ላይ ቢታይ ቃፅን፥ ህንተ ማይዛት ባቃትድ አትዳይሳዳ ህንተ ባቃታና። ሄሳፈ ጉየ፥ ጎዳይ ታ ፆሳይ ባ ጌሻታ ኡባራ እስፈ ያና።<verse eid="ZEC 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 14:6"/>ሄ ዎደ ሜጎይ፥ ሻችነ ም ዴና። <verse eid="ZEC 14:6"/><verse number="7" style="v" sid="ZEC 14:7"/>ሄ ዎደ ቃምነ ጋላስ ባዋ፥ ጎዳይ ፃላል ኤርያ ዱማ ጋላስ ግዳና፤ ሄ ጋላስ ቃማይ ፖኦ ግዳና።<verse eid="ZEC 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 14:8"/>ሄ ዎደ ደኦ ሃይ የሩሳላመፐ ጎጋና፤ እያፐ ባጋይ ማፅነ አባን ገላና፤ ቃስ ባጋይ መደትራነ አባን ገላና። ሄ ሃይ ባልጎነ ቦነ ጎግሸ ዳና። <verse eid="ZEC 14:8"/><verse number="9" style="v" sid="ZEC 14:9"/>ጎዳይ ቢታ ኡባ ቦላ ካዎታና፤ ሄ ዎደ እስ ጎዳ ፃላል ዳና፤ እያ ሱን ፃላላ ፄጋና።<verse eid="ZEC 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 14:10"/>ግብአፐ ዶምድ የሩሳላመ ዱገሀ ባጋራ አድ እርሞና ካታማ ጋካናዉ ደእያ ቢታ ኡባይ ደምባታና። ሽን የሩሳላመይ ብንያመ ፐንግያፈ ብድ፥ በን ፐንግያ ግናራ ዞዘ ፐንግያ ጋካናዉ፥ ቃስ ሀናንኤላ አዱሳ ግምብያፈ ብድ፥ ካዎ ዎይነ ጉምእያ በሳ ጋካናዉ ባ በሳን ቁ ግድ ዳና። <verse eid="ZEC 14:10"/><verse number="11" style="v" sid="ZEC 14:11"/>የሩሳላመይ አስ ደእያ በሲ ግዳና፤ ህዛፐ ጉየ የና፤ እያን ደእያ አሳይ ህርግ ባይና ሳሮ ዳና።<verse eid="ZEC 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 14:12"/>ጎዳይ የሩሳላመ ኦላናዉ ደንድዳ አሳ ኡባ ቦላ ጋዶ ኤሀና። ኤንቲ ኤቆን ደእሽን፥ ኤንታ አሾይ ዎቃና፤ ኤንታ አይፈይ ባ ኦላን፥ ኤንታ እንፃርሳይ ባ ኮቶኑዋን ዎቃና። <verse eid="ZEC 14:12"/><verse number="13" style="v" sid="ZEC 14:13"/>ሄ ዎደ ጎዳይ ኤንታ ዎልቃማ ዳጋማ ዳጋንና። አሳ ኡባይ እሶይ እሱዋ ኩሽያ ኦይክድ ኦለታና። <verse eid="ZEC 14:13"/><verse number="14" style="v" sid="ZEC 14:14"/>ይሁዳ አሳይ የሩሳላመ ባጋ ግድድ ኦለታና። ዩሹዋን ደእያ ካዎተታ፥ ታይቦይ ባይና ሻሉዋ፥ ዎርቃ፥ ብራነ ማኡዋ ድእድ ሺሻና። <verse eid="ZEC 14:14"/><verse number="15" style="v" sid="ZEC 14:15"/>ሀ ጋዱዋ ዳንያ ጋዶይ ፓራታ ቦላ፥ ባቁሎታ ቦላ፥ ግማለታ ቦላ፥ ሀረታ ቦላነ ሞርከት ዱንካንዳ በሳን ደእያ መሄ ኡባ ቦላ ያና።<verse eid="ZEC 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ZEC 14:16"/>ሄሳፈ ጉየ፥ የሩሳላመ ኦልዳ ካዎተታፐ አትዳ ኡባይ ካዋ፥ ኡባፈ ዎልቃማ ጎዳ ጎይናናዉነ ሻቃራ ባኣለ ቦንቻናዉ ላይን ላይን የሩሳላመ ባና። <verse eid="ZEC 14:16"/><verse number="17" style="v" sid="ZEC 14:17"/>ሳአን ደእያ አሳፐ ኦንካ ካዋ፥ ኡባፈ ዎልቃማ ጎዳ ጎይናናዉ የሩሳላመ ቦና እፅኮ፥ ኤንታዉ እር ቡከና። <verse eid="ZEC 14:17"/><verse number="18" style="v" sid="ZEC 14:18"/>ግብፀ አሳይ ብድ ጎይኖና እፅኮ፥ ሻቃራ ባኣለ ቦንቻናዉ ቦና እፅዳ አሳ ቦላ ጋክዳ ጋዶይ ኤንታ ቦላ ያና። <verse eid="ZEC 14:18"/><verse number="19" style="v" sid="ZEC 14:19"/>ሻቃራ ባኣለ ቦንቻናዉ ቦና እፅዳ ግብፀይነ ሀራ ካዎተት ኡባይ ሴረታና ሴራይ ሀይሳ።<verse eid="ZEC 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 14:20"/>ሄ ዎደ ፓራታ ቆን ደእያ ሻሾትያ ቦላ፥ “ጎዳስ ጌይዳይሳ” ጌተትያ ማላ ፁፈይ ፃፈታና። ፆሳ ኬን ደእያ ካያ ኦቶይ ያርሾ በሳ ማታን ደእያ ሳንያ መላ ጌሽ ግዳና። <verse eid="ZEC 14:20"/><verse number="21" style="v" sid="ZEC 14:21"/>የሩሳላመንነ ይሁዳን ደእያ ኦቶ ኡባይ ኡባፈ ዎልቃማ ጎዳስ ጌሽ ግዳና። ያርሾ ያርሽያ አሳ ኡባይ ሄ ኦቶታ ኤክድ፥ ያርሾ አሹዋ ኤንታን ካና። ሄ ዎደ ኡባፈ ዎልቃማ ጎዳ ኬን አይ ዛልአንቾይ ዴና።<verse eid="ZEC 14:21"/></para>
  <chapter eid="ZEC 14"/>
</usx>
