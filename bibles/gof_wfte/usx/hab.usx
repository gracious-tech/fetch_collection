<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">እንባቆመ ማፃፋ</para>
  <para style="toc1">እንባቆመ ማፃፋ</para>
  <para style="toc3">እንባ</para>
  <para style="toc2">እንባቆመ</para>
  <para style="mt">እንባቆመ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሀ ማፃፋን፥ ኮይሮ ናምኡ ሸምፖታን፥ እንባቆመይ ጎዳራ ፓላምያ ፓላማ በኦስ። እንባቆመይ፥ ይሁዳን ደእያ ናጋራነ ኤቃ ጎይኑዋ በእድ፥ “ፆሳይ ጌላ ግድዳ ባ ደርያ በእሸ አይስ ፕርዶና አግድ አ?” ያግድ ኦይችን፥ ፆሳይ፥ ማታ ዎደ ይሁዳ ፕርዳናዉ ባብሎነ ሚሸ ኦድ ጎኤታናዉ ደኤይሳ እንባቆመስ ኦድስ። ካልድ እንባቆመይ፥ “ፆሲ ይሁዳ ፕርዳናዉ ዋትድ ናጋራንቾነ ዎዛና ምኖ ግድዳ ባብሎነ ሚሸ ኦድ ጎኤቲ?” ያግድ ኦይችስ። ፆሲ ዛርሸ፥ ባብሎነትካ ማታ ዎደ ፕርደቶና አቶናይሳ እንባቆመስ ኦድስ።</para>
  <para style="ip">እንባቆመይ ማፃፋን ዉርሰ ሸምፖይ እንባቆመይ፥ ጎዳ፥ እያ ዎልቃስነ እያ ቦንቹዋስ ጋላትሸ ዎስያ ዎሳ ኦይክስ። እንባቆመይ፥ ኤርምያስነ ህዝቄል ደእዳ ዎደን ዶና አገና።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">እንባቆመ ኦይሻነ ጎዳ ዛሩዋ (<char style="ior"><ref loc="HAB 1:1-2:20">1:1—2:20</ref></char>)</para>
  <para style="io1">እንባቆመ ዎሳ (<char style="ior"><ref loc="HAB 3:1-19">3:1-19</ref></char>)</para>
  <chapter number="1" style="c" sid="HAB 1"/>
  <para style="s1">እንባቆመ ኮይሮ ሞቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1"/>ናብያ እንባቆመስ ጎዳይ ቆንጭስዳ ቃላይ ሀይሳ። <verse eid="HAB 1:1"/><verse number="2" style="v" sid="HAB 1:2"/>እንባቆመይ፥ “አቤት ጎዳዉ፥ ታና ማዳና መላ ታኒ ነና ፄግያ ዎደ አዉደ ጋካናዉ ስኦና እፃይ? ታኒ ኡንኤታዳ ኔኮ ዋስያ ዎደ አዉደ ጋካናዉ አሾና እፃይ? <verse eid="HAB 1:2"/><verse number="3" style="v" sid="HAB 1:3"/>ኔኒ ሀ ኢታተ ኡባ ታና አይስ በሳይ? ኔኒ ባላ በአሸ አይስ ስእ ጋይ? ዮይነ ጌላተ ታ ስንና፤ ፓላምነ ኦሽ ቢታ ኡባን ዳርስ። <verse eid="HAB 1:3"/><verse number="4" style="v" sid="HAB 1:4"/>ሄሳ ግሾ፥ ህገይ ዶልእስ፤ ሱረ ፕርድ ካንና። ናጋራንቾት ፅሎ አሳታ ተቅድ ኦይክዳ ግሾ፥ ፕርድ ጌላትስ” ያግስ።<verse eid="HAB 1:4"/></para>
  <para style="s1">ጎዳ ዛሩዋ</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 1:5"/>ጎዳይ ዛሪድ፥ “ህንተ ዩሹዋን ደእያ ካዎተታ ፄልድ ማላለትተ። ህንተዉ አስ ኦድን ህንተ አማኖና ኦሱዋ ታኒ ህንተ ዎድያን ኦና። <verse eid="HAB 1:5"/><verse number="6" style="v" sid="HAB 1:6"/>ታኒ ቃይ ባይናይሳታነ ድርግያ ባብሎነ አሳ ደንና። ኤንቲ ባንታባ ግዶና ቢታ ኦልድ ኦይካናዉ ቢታ ኡባን ዩዮሶና። <verse eid="HAB 1:6"/><verse number="7" style="v" sid="HAB 1:7"/>ኤንቲ ያሽሶሶናነ ዳጋንሶና፤ ባንታና ቦንችስያ ህገ ከሶሶና። <verse eid="HAB 1:7"/><verse number="8" style="v" sid="HAB 1:8"/>ኤንታ ፓራት ማሄፐ አድ ኤለሶሶና፤ ኮሻትዳ ኦማርሳ ሱመፐ አድ ዎዛና ምኖ። ኤንታ ፓራ አሳት ሃሆፐ ዮሶና፤ ኤንቲ አርጋን እስባ ኦይካናዉ ዎያዳ ፓሎሶና። <verse eid="HAB 1:8"/><verse number="9" style="v" sid="HAB 1:9"/>ኤንታ ኦላንቾት ኡባይ ኢታ ኦሶ ኦናዉ ባዞ ጫርኮዳ ጫርክሸ ዮሶና። አሳ ድእድ ሻፈዳ ሺሾሶና። <verse eid="HAB 1:9"/><verse number="10" style="v" sid="HAB 1:10"/>ኤንቲ ካዎታ ቦላ ቀልቅሶሶና፤ ሃረይሳታ ኤንቲ ቶቾሶና። ኤንቲ ሹቻ ድርሳን ድረትዳ ካታማታ ኡባ ቦላ ሚጮሶና። ሄ ድርሳታ ድአናዉ ኤንታ ዩሹዋን ቢታ ሺሾሶና። <verse eid="HAB 1:10"/><verse number="11" style="v" sid="HAB 1:11"/>ሄሳፈ ጉየ፥ ኤንቲ ኡባ ጫርኮ መላ ፕትድ ኤፋና። ሄ ጌላታስ ኤንታ ዎልቃይ ኤንታ ፆሳ” ያግስ።<verse eid="HAB 1:11"/></para>
  <para style="s1">እንባቆመ ናምአን ሞቱዋ</para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 1:12"/>አቤት ጎዳዉ፥ ታ ፆሳዉ፥ ታ ጌሻዉ፥ ኔኒ መርና ፆሳ ግድኪ? ኔኒ ኑ ዛላ ግድያ ግሾ ኑኒ ሀይቆኮ። አቤት ጎዳዉ፥ ባብሎነ አሳይ ኑና ፕርዳና መላ ኤንታ ደንዳ ዎልቃ ኤንታዉ እማዳሳ። <verse eid="HAB 1:12"/><verse number="13" style="v" sid="HAB 1:13"/>ነ አይፈት ዳሮ ጌሽ ግድያ ግሾ፥ ኢታባ ፄላናዉ ዶሶኮና፤ ኔኒ ኢታባይ ኦሰትያ ዎደ በአሸ ስእ ጋካ። ያትን፥ ሀ ኢታታ አይስ ስእ ጋዳ ፄላይ? ናጋራንቾት ባንታፈ አድ ፅልያ አሳታ ምትያ ዎደ አይስ ስእ ጋይ? <verse eid="HAB 1:13"/><verse number="14" style="v" sid="HAB 1:14"/>ኔኒ አሰ አባ ሞሎዳነ ካለይ ባይና ኡሎራ ጎሸትያ መተታ መዳሳ። <verse eid="HAB 1:14"/><verse number="15" style="v" sid="HAB 1:15"/>ባብሎነ አሳይ አሳ ኡባ ቃጰን ቆርድ ከሳና፤ ኤንታ ባንታ ግትያን ኦይካና፤ ኤንታ ባንታ ዳቹዋን ቡርድ ሺሻና፤ ሄሳ ኦድ ኤንቲ ኡፋይታናነ ሀሹ ጋና። <verse eid="HAB 1:15"/><verse number="16" style="v" sid="HAB 1:16"/>ሄሳ ግሾ፥ ኤንቲ ባንታ ግትያስ ያርሻና፤ ባንታ ዳቹዋስ እፃነ ጩይሳና። ኤንቲ ሻሎ ደመይነ እንጀትን ደኤይ ሄ ግተታና። <verse eid="HAB 1:16"/><verse number="17" style="v" sid="HAB 1:17"/>ያትን፥ ኤንቲ ባንታ ግትያ ቃይ ባይና የግሸነ ምሽ ካዎተታ ይስሸ ዋንድ ዳኔ?<verse eid="HAB 1:17"/></para>
  <chapter eid="HAB 1"/>
  <chapter number="2" style="c" sid="HAB 2"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 2:1"/>ታኒ ዎችያ ግምብያ ቦላ ኤቃዳ ናጋና። ሄ በሳን ኤቃዳ ጎዳይ ታዉ ኦድያባነ ታ ሞቱዋስ እምያ ዛሩዋ ስአናዉ ናጋሻና።<verse eid="HAB 2:1"/></para>
  <para style="s1">ጎዳ ዛሩዋ</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2"/>ጎዳይ ዛሪድ፥ “ዎፅያ አደይ ናባባና መላ ሎቸ ሹቻ ቦላ ታኒ ነዉ ቆንጭስያ ቃላ ኦርድሳዳ ፃፋ። <verse eid="HAB 2:2"/><verse number="3" style="v" sid="HAB 2:3"/>ቆንጨይ ባ ዎድያ ናጌስ፤ ቆንጨይ ፖለትያ ዎደይ ኤለ ጋካና፤ ዎርዶ ግደና። ጋምእኮካ ናጋ፤ እ ቱማ ሀናና፤ ጋምኤና።” <verse eid="HAB 2:3"/><verse number="4" style="v" sid="HAB 2:4"/>ሄኮ፥ እያ ዎዛናይ ኦቶርትስ፤ እያ ቆፋይ ሱረ ግደና፤ ሽን ፅሎይ ባ አማኑዋን ደኦን ዳና። <verse eid="HAB 2:4"/><verse number="5" style="v" sid="HAB 2:5"/>ዱረተ አሰ ጭሜስ፤ ጬቀትያ ኡራስ ሸምፖይ ባዋ። እ ዱፎዳ ያራምባ ግድያ ግሾነ ሀይቆዳ ካል ኤሮና ግሾ፥ ካዎተታ ኡባ ባዉ ሺሼስ፤ አሳ ኡባ ባዉ ድኤስ።<verse eid="HAB 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6"/>ድኤትዳ አሳይ ስሚድ ኤንታ ቦርሸነ ቀልቅስሸ ሀይሳዳ ያጋና፦ “ባባ ግዶና ሚሸ ሺሽድ ዶረይሳነ ቦንቅድ ዱረትዳይሳታ አየ! ሀይስ ሀይሳዳ ሀንድ፥ አዉደ ጋካናዉ ዳኔ?” ያጋና። <verse eid="HAB 2:6"/><verse number="7" style="v" sid="HAB 2:7"/>ኔኒ ኤንታፈ ቦንቅዳ አሳት ነ አኬኮና ነ ቦላ ደንድድ ነና ኮኮርሳና። ሄሳፈ ጉየ፥ ኤንቲ ነ ሻሉዋ ኡባ ቦንቃና። <verse eid="HAB 2:7"/><verse number="8" style="v" sid="HAB 2:8"/>ኔኒ ዳሮ አሳ ሻሉዋ ቦንቅዳ ግሾ፥ ኤንታፈ አትዳይሳት ነ ሻሉዋ ቦንቃና። ነ ዳሮ አሳ ሱ ጉሳዳሳ፤ ሳኣ ቦላ፥ ካታማታ ቦላነ ያን ደእያ አሳ ኡባ ቦላ ኢታ ኦሶ ኦዳሳ። <verse eid="HAB 2:8"/><verse number="9" style="v" sid="HAB 2:9"/>መቶይ ነና ጋኮና መላ ነ ኬ ቃ በሳን ኬፃናዉ ጌላተን ሚሸ ሺሽዳይሶ ነና አየ! <verse eid="HAB 2:9"/><verse number="10" style="v" sid="HAB 2:10"/>ዳሮ አሳ ገናዳ ይስዳ ግሾ፥ ነ ሶ አሳ ካዉሻዳሳ፤ ኔኒ ነ ቦላ ዮ ኤሀዳሳ። <verse eid="HAB 2:10"/><verse number="11" style="v" sid="HAB 2:11"/>ሀር አቶሽን ነ ኬ ግምበ ሹቻይ ነ ቦላ ዋሳና፤ ኬ ቱቀት ዋሱዋ ኮሹማና። <verse eid="HAB 2:11"/><verse number="12" style="v" sid="HAB 2:12"/>ካታማ ኢታተን ባስድ አሳ ሱን ኬፀይሳቶ ህንተና አየ! <verse eid="HAB 2:12"/><verse number="13" style="v" sid="HAB 2:13"/>አሳይ ኦያባ ኡባይ ታማ ካሆ ግዳና መላ፥ ካዎተት ዳቡርዳ ኡባይ ሀዳ ግዳና መላ ኦዳይ ኡባፈ ዎልቃማ ጎዳ ግደኔ? <verse eid="HAB 2:13"/><verse number="14" style="v" sid="HAB 2:14"/>አብ ሃን ኩመይሳዳ ሳእ ጎዳ ቦንቹዋ ኤራተን ኩማና።<verse eid="HAB 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HAB 2:15"/>“ባ ሾሮይ ካሎትን በአና ግድ፥ ማይያ ኡሽ ኡሽያ ኡራ አየ! <verse eid="HAB 2:15"/><verse number="16" style="v" sid="HAB 2:16"/>ኔኒ ቦንቾ አጋዳ ካዉሸ ማአና። ሀእ ማይ ነ ታራ፤ ነ ኡያዳ ካሎታ። ጎዳ ኡሻቻ ኩሽያን ደእያ ፁአይ ነዉ እመታና፤ ነ ቦንቾይ ዬላን ላመታና። <verse eid="HAB 2:16"/><verse number="17" style="v" sid="HAB 2:17"/>ነ ልባኖሰ ይስዳይሳዳ ነካ ያና። ነ ዶአታ ዉርሳዳሳ፥ ሀእ ኤንቲ ነና ያሽሳና። ነ ዳሮ አሳ ሱ ጉሳዳሳ፤ ሳአ ቦላ፥ ካታማታ ቦላነ እያን ደእያ አሳ ቦላ ኢታ ኦሶ ኦዳሳ።<verse eid="HAB 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HAB 2:18"/>“እ ባዉ ኤቅ አይ ማዲ? እያ አሳ ኩሸን ጊግስ ግደኔ? ዎርዶፈ አትሽን፥ እያን ሀራባይ በንተና። ያትን፥ እያ መዳ ኡራይ ሀ አይኮካ ኦደቶና ኤቃን አማነተይስ እያ አይ ማዳኔ? <verse eid="HAB 2:18"/><verse number="19" style="v" sid="HAB 2:19"/>ምፈ ጊግዳይሳ ‘ባርካ’ ገይሶ፥ ቃስ ሸምፖይ ባይና ሹቻ ‘ደንዳ’ ገይሶ ነና አየ! እ ዎና ነዉ አይ ቆንጭሳናዉ ዳንዳኢ? ሄኮ፥ ዎርቃንነ ብራን ሜሸትስ፤ እያዉ ሸምፖይ ባዋ።<verse eid="HAB 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HAB 2:20"/>“ሽን ጎዳይ ባ ጌሻ ኬና። ሄሳ ግሾ፥ ሳአን ደእያ አሳ ኡባይ እያ ስንን ስእ ጎ” ያግስ።<verse eid="HAB 2:20"/></para>
  <chapter eid="HAB 2"/>
  <chapter number="3" style="c" sid="HAB 3"/>
  <para style="s1">እንባቆመ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1"/>ማዝሙረን ሽቅዳ ናብያ እንባቆመ ዎሳይ ሀይሳ፦<verse eid="HAB 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2"/>አቤት ጎዳዉ፥ ኔኒ ካሰ ኦዳባ ታኒ ስአዳ ያያስ።</para>
  <para style="q2" vid="HAB 3:2">ጎዳዉ፥ ኑ ዎድያንካ ሄ ኦሶታ ዛራዳ ኦ፤</para>
  <para style="q2" vid="HAB 3:2">ኤንቲ ኑ ዎድያንካ ኤረቶ።</para>
  <para style="q2" vid="HAB 3:2">ነ ሀንቀትያ ዎደ ነ ማሮታ ቆፓ።<verse eid="HAB 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3"/>ፆሳይ ተማና ቢታፈ ዬስ፤</para>
  <para style="q2" vid="HAB 3:3">ጌሻይ ፓራና ደርያፐ ዎስ።</para>
  <para style="q1" vid="HAB 3:3">እያ ቦንቾይ ሳሉዋ ካምስ፤</para>
  <para style="q2" vid="HAB 3:3">እያ ጋላታይ ሳኣ ኩምስ።<verse eid="HAB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4"/>እያ ፖኦይ ጶልያ አዋ መላ፤</para>
  <para style="q2" vid="HAB 3:4">እያ ዎልቃይ ቆሰትድ ኡትዳ እያ ኩሽያፐ</para>
  <para style="q2" vid="HAB 3:4">ፆልቅያ ፖኦይ ከዬስ።<verse eid="HAB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5"/>ጋዶይ እያ ስንን ቤስ፤</para>
  <para style="q2" vid="HAB 3:5">ታማ ላጮይ እያ ቶሁዋፐ ከዬስ።<verse eid="HAB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6"/>እ ኤቅን ቢታይ ቃፅስ፤</para>
  <para style="q2" vid="HAB 3:6">እ ፄልን ካዎተት ኮኮርዶሶና።</para>
  <para style="q1" vid="HAB 3:6">መርና ደረት ዎድዶሶና፤</para>
  <para style="q2" vid="HAB 3:6">እ ኤንታ ቦላ ሄመትያ በንፐ ደእያ ዙማት ላለትዶሶና።<verse eid="HAB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7"/>ታኒ ቶጰ አሳ ዱንካነይ መቶትሽን በአስ፤</para>
  <para style="q2" vid="HAB 3:7">ምድያመ ቢታ አሳይ ኮኮርሽን በአስ።<verse eid="HAB 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8"/>አቤት ጎዳዉ፥ ኔኒ አይስ ሀንቀታዲ?</para>
  <para style="q2" vid="HAB 3:8">ሻፋት ነና ሀንቀዶና?</para>
  <para style="q2" vid="HAB 3:8">ዎይኮ ነ ሀንቆይ አባ ቦሌ?</para>
  <para style="q1" vid="HAB 3:8">አካይ፥ ኔኒ ነ ፓራታነ ነ ፓራ ጋረታ ቶግዳይ</para>
  <para style="q2" vid="HAB 3:8">ነ አሳስ ፆኖ እማናሳ ግደኔ?<verse eid="HAB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9"/>ኔኒ ነ ዶንግያ ዋፃዳሳ፤</para>
  <para style="q2" vid="HAB 3:9">ዱካናዉ ጊግሳዳሳ፤</para>
  <para style="q2" vid="HAB 3:9">ቢታ ጳልቃዳ ሃ ከሳዳሳ። <char style="qs">ሳላሀ </char><verse eid="HAB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 3:10"/>ደረት ነና በእድ ያሻን ኮኮርዶሶና፤</para>
  <para style="q2" vid="HAB 3:10">ክፃ ሃይ አስ።</para>
  <para style="q1" vid="HAB 3:10">ጪሞ ሃት ዋስዶሶና፤</para>
  <para style="q2" vid="HAB 3:10">ባንታ ዙልያ ቁ ቁ ኦሶና።<verse eid="HAB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11"/>ነ ዶንግያ ዱካን፥ ነ ቶራ ጶለን፥</para>
  <para style="q2" vid="HAB 3:11">አውነ አጌን ባንታ ደእያ በሳን ኤቅዶሶና።<verse eid="HAB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12"/>ኔኒ ሀንቁዋን ቢታ ኡባ ዩያዳሳ፤</para>
  <para style="q2" vid="HAB 3:12">ካዎተታ ነ ሀንቁዋን የዳሳ።<verse eid="HAB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13"/>ነ አሳነ ነ ትይዳይሳ አሻናዉ ከያዳሳ፤</para>
  <para style="q2" vid="HAB 3:13">ኢታታ ሀላቃ ሾጫዳሳ፤</para>
  <para style="q2" vid="HAB 3:13">እያ ማኡዋ ቃራዳ ካሎ አሻዳሳ። <char style="qs">ሳላሀ </char><verse eid="HAB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14"/>ኑና ላላናዉ ጎተዳ ይዳ ኑ ሞርክያ፥</para>
  <para style="q2" vid="HAB 3:14">መቶታንቾታ ምታናዉ ጌማን ቆሰትዳይሳ፥</para>
  <para style="q2" vid="HAB 3:14">እያ ቶራን እያ ጫዳዳሳ።<verse eid="HAB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15"/>ኔኒ ነ ፓራታራ አባ ቦላ ሄመታዳሳ፤</para>
  <para style="q2" vid="HAB 3:15">ዳሮ ሃ የዳሳ።<verse eid="HAB 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16"/>ታኒ ሄሳ ኡባ ስእን ታ ዎዛናይ ዳጋምስ፤</para>
  <para style="q2" vid="HAB 3:16">ታ መተርሻይ ኮኮርስ።</para>
  <para style="q1" vid="HAB 3:16">ታ መቀይ ዳጋምስ፤</para>
  <para style="q2" vid="HAB 3:16">ታ ቶሆይ ጉንድስ።</para>
  <para style="q1" vid="HAB 3:16">ኑ ሞርከታ ጎዳይ ሴራና ጋካናዉ፥</para>
  <para style="q2" vid="HAB 3:16">ታኒ መቱዋ ጋላሳ ዳንዳአን ናጋና።<verse eid="HAB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17"/>ባላሰ ምይ አይፎና እፅኮካ፥</para>
  <para style="q2" vid="HAB 3:17">ዎይንያ ቦላ አይፈይ በንቶና እፅኮካ፥</para>
  <para style="q2" vid="HAB 3:17">ሻማሆይ አይፎና እፅኮካ፥</para>
  <para style="q2" vid="HAB 3:17">ጎሻን ካ ካፅናኮካ፥</para>
  <para style="q2" vid="HAB 3:17">ግርበን ዶርስ ይኮካ፥</para>
  <para style="q2" vid="HAB 3:17">ዛዳሎን መሄይ ይኮካ፥<verse eid="HAB 3:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="HAB 3:18"/>ታኒ ጎዳን ኡፋይታና፤</para>
  <para style="q2" vid="HAB 3:18">ታና አሽያ ፆሳን ኡፋይሳን ኩማና።<verse eid="HAB 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19"/>ታ ዎልቃይ ኡባ ሃርያ ጎዳ፤</para>
  <para style="q2" vid="HAB 3:19">እ ታ ቶሁዋ ጋራ ቶሆዳ ምንስ፤</para>
  <para style="q2" vid="HAB 3:19">እ ታና ቃ በሳን ሄመስ።<verse eid="HAB 3:19"/></para>
  <chapter eid="HAB 3"/>
</usx>
