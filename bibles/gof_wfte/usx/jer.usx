<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JER" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ኤርምያሳ ማፃፋ</para>
  <para style="toc1">ኤርምያሳ ማፃፋ</para>
  <para style="toc3">ኤርም</para>
  <para style="toc2">ኤርምያሳ</para>
  <para style="mt">ኤርምያሳ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ኤርምያስ ክ.የ.ስ. 600 ላይ ሄራን ደእዳ ናበ። ኤርምያሳ ማፃፋን ቆንጭድ ኦደትዳይ፦ የሩሳላመ ዮ፥ ፆሳ ኬ ዮነ አይስያ ዳሮ አሳይ ድኤትድ ባብሎነ ባናይሳ (ሸም 39፥ 52)። ባብሎነ ካዎይ የሩሳላመ ካታማነ ፆሳ ኬ ዉርሰ ይሳናፐ ስን፥ ኤርምያስ የሩሳላመን ደእስ።</para>
  <para style="ip">ኤርምያስ፥ ዳሮ ዎደ ኤቃ ጎይኖነ ኤንታ ናጋራ ጋሶን ፆሳ አሳ ቦላ ዮይ ያናይሳ ኦዴስ። እ ኦድዳ ትንብተታፐ ባጋት ፖለትን፥ ኤርምያስ ባ አይፈን በእስ። ሌምሶስ፥ ባብሎነ ካዎይ ናቡካዳናፆር የሩሳላመ ኦይክድ፥ ካታማነ ፆሳ ኬ ላሌስ፤ ይሁዳ ካዎይ ዳሮ አሳራ ድኤትድ ባብሎነ ብዳይሳ በእስ። ጉጅድካ፥ አሳይ ድኦፐ ስማናይሳነ እስራኤለ ካዎተይ ስሚድ ኤቃናይሳ ኤርምያስ ስንትድ ኦድስ።</para>
  <para style="ip">ኤርምያስ ድኤትድ ባብሎነ ብቤና (ሸም 40)፥ ሽን ጎዶልያ ሀይቅዳፐ ጉየ (ሸም 40—41)፥ እስ እስ ይሁዳ አሳይ እያ ዎልቃን ግብፀ ኤፍን (ሸም 42—43)፥ ያን ጉ ዎደ ደእስ።</para>
  <para style="ip">ኤርምያስካ ህዝቄላዳ ፆሳፈ ኤክዳ ባ ኪታ ማላንነ ሌምሶን ኦዴስ። ዳንጮ ሻሞ፥ ሄ ዳንጩዋ ሞጎ፥ ቃስ ቦክድ ከሶ (<char style="xt"><ref loc="JER 13:1-11">13:1-11</ref></char>)፤ ማቾ ኤኮና መላ ድገተ፥ አሳራ ዬሆ ዬኮና መላ ድገተ (<char style="xt"><ref loc="JER 16:1-9">16:1-9</ref></char>)፥ ፁጋ ሻሞነ እስራኤለ ጭማታ ስንን መን (19:1-13)፤ ቃምባራ ጋናን አድ ቶሆ (ሸም 27—28)፤ ኦላ ዎደ ጋደ ሻሞ (<char style="xt"><ref loc="JER 32:6-15">32:6-15</ref></char>)፤ ራካባ ያራት ዎይነ ኡሹ ኡዮና አጎ (<char style="xt"><ref loc="JER 35:1-19">35:1-19</ref></char>)።</para>
  <para style="ip">ኤርምያሳ ማፃፋ ኦይዱ ክፍለን ሻክድ በአናዉ ዳንዳኤቴስ።</para>
  <para style="ipi">1. እዮስያሳ፥ እዮኣቀመ፥ ዮአክናነ ሰደቅያሳ ካዎተ ላይን ይሁዳ አሳስነ ኤንታ ካለያ አሳስ ፆሳፈ እመትዳ ቃላ (ሸም 2—25)።</para>
  <para style="ipi">2. ዱማ ዱማ ትንብተ ቃላታ፥ ኤርምያሳ ደኡዋን ፖለትዳ ግታ ግታ ቆፋታ፥ ኤርምያሳ ፃፈይ ባሮክ ፃፍድ ኦይክዳ ጉ ፁፈታ (ሸም 26—45)።</para>
  <para style="ipi">3. ዱማ ዱማ አላጋ ቢታ አሳስ ፆሳፈ ኪተትዳ ትንብተታ (ሸም 46—51)።</para>
  <para style="ipi">4. የሩሳላመ ኦይከተነ አሳይ ድኤትድ ባብሎነ ባናይሳ ኦድያ ታርከታ (ሸም 52)።</para>
  <para style="ip">ኤርምያስ አሳ ቦላነ ቢታ ቦላ ዮይ ያናይሳ ኦድዳ ዎደ ካዎይነ ካህነት እያ ቦርዶሶናነ ዎግ ባይና ጎድዶሶና (<char style="xt"><ref loc="JER 11:18-23">11:18-23</ref>፤ <ref loc="JER 18:18">18:18</ref>፤ <ref loc="JER 20:1-3">20:1-3</ref>፤ <ref loc="JER 26:1-19">26:1-19</ref>፤ <ref loc="JER 37:13-38:6">37:13—38:6</ref></char>)። ኤርምያስ፥ አሳይ ፆሳራ ገልዳ ጫቁዋ ምንድ ናጋና መላ ኦዴስ (ሸም 30-33)። ህዝቄላ መላ ኤርምያስካ ካህነነ ናበ።</para>
  <para style="ip">ኤርምያስ ባ አሳ ዳሮ ዶስያነ ኤንታ ቦላ ኢታ ፕርድ ያና መላ ኮዮና አስ። ፆሳይ፥ እ ናበ ግድድ ሀጋዛና መላ ፄግዳ ዎደ እ ኡንኤትዳይሳ በሲያ ፁፈት ማፃፋ ግዶን ዳሮ በሳን ቆንጭስ። ፆሳ ቃላይ እያ ዎዛና ግዶን ታማዳ ኤፅያ ግሾ፥ እ ካምድ አሻናዉ ዳንዳእቤና።</para>
  <para style="ip">ሀ ማፃፋን ፃፈትዳ ግታ ግታ ትንብተታፐ እሶት እሶት መቶይ ኩምዳ ኤርምያሳ ዎድያፐ አድ፥ ፆሳይ እምያ ኦራ ጫቆይ ፖለትያ ዎድያ ስን ፄሎሶና። ሄ ዎደ ኦራ ጫቆይ አሳ ዎዛናን ፃፈትያ ግሾ፥ አኬክስያነ ናግስያ አስታማረ ኮሸና። (<char style="xt"><ref loc="JER 31:31-34">31:31-34</ref></char>)።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ኤርምያሳ ፄገተነ ዶረተ (<char style="ior"><ref loc="JER 1:1-19">1:1-19</ref></char>)</para>
  <para style="io1">ይሁዳነ እስራኤለ ቦላ ኦደትዳ ፕርዳ (<char style="ior"><ref loc="JER 2:1-25:38">2:1—25:38</ref></char>)</para>
  <para style="io1">ዎርዶ ናበታነ ኤርምያሳ (<char style="ior"><ref loc="JER 26:1-29:32">26:1—29:32</ref></char>)</para>
  <para style="io1">ኦራ ጫቁዋን አሳይ ባንታ ቢታ ስማና (<char style="ior"><ref loc="JER 30:1-33:26">30:1—33:26</ref></char>)</para>
  <para style="io1">ኤርምያሳ ዱማ ዱማ ሀጋዞታ (<char style="ior"><ref loc="JER 34:1-38:28">34:1—38:28</ref></char>)</para>
  <para style="io1">የሩሳላመነ ሃርያ ጎዶልያ ኩንደ (<char style="ior"><ref loc="JER 39:1-42:22">39:1—42:22</ref></char>)</para>
  <para style="io1">ኤርምያስ ግብፀ ቢታን (<char style="ior"><ref loc="JER 43:1-44:30">43:1—44:30</ref></char>)</para>
  <para style="io1">ኤርምያስ ባሮካስ ኡፋይሳ ቃላ እሚስ (<char style="ior"><ref loc="JER 45:1-5">45:1-5</ref></char>)</para>
  <para style="io1">ይሁዳ ዩሾን ደእያ ካዎተታ (<char style="ior"><ref loc="JER 46:1-51:64">46:1—51:64</ref></char>)</para>
  <para style="io1">የሩሳላመ ኩንደባ ኦደትዳ ሀራ ኪታ (<char style="ior"><ref loc="JER 52:1-34">52:1-34</ref></char>)</para>
  <chapter number="1" style="c" sid="JER 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 1:1"/>ብንያመ ቢታን፥ አናቶታ ካታማን ደእያ ካህነታፐ እሱዋ ግድዳ ካልቀ ናኣ ኤርምያሳ ቃላይ ሀይሳ። <verse eid="JER 1:1"/><verse number="2" style="v" sid="JER 1:2"/>አሞነ ናአይ፥ ይሁዳ ካዎይ እዮስያስ ካዎትዳ ታማነ ሄን ላይን ጎዳ ቃላይ ኤርምያሳኮ ይስ። <verse eid="JER 1:2"/><verse number="3" style="v" sid="JER 1:3"/>እዮስያሳ ናአይ፥ ይሁዳ ካዎይ እዮአቄም ካዎትዳ ላይታን ጎዳ ቃላይ ኤርምያሳኮ ይስ። ቃስ እዮስያሳ ናአይ፥ ሰደቅያስ ካዎትን፥ ታማነ እስ ላይ ጋካናዉነ፥ እቻሻን አጌናን የሩሳላመ አሳይ ድኤትድ ብዳ ዎድያ ጋካናዉ ጎዳ ቃላይ እያኮ ይስ።<verse eid="JER 1:3"/></para>
  <para style="s1">ኤርምያሳ ፄገተ</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 1:4"/>ጎዳ ቃላይ ታኮ ሀይሳዳ ያግሸ ይስ፦ <verse eid="JER 1:4"/><verse number="5" style="v" sid="JER 1:5"/>“ኔኒ ነ አየ ኡሎን መታናፐ ስን ታ ነና ኤራይስ። ነ የለታናፐ ስን ታ ነና ዱማያዳ ዎስ፤ ካዎተታስ ነና ናበ ኦዳ ሹማስ” ያግስ።<verse eid="JER 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 1:6"/>ታኒ፥ “ኡባ ሃርያ ጎዳዉ፥ ታኒ ናአ ግድያ ግሾ ዋታዳ ኦደታነኮ ኤርከ” ያጋስ።<verse eid="JER 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 1:7"/>ሽን ጎዳይ፥ “ ‘ታኒ ናአ ጎፓ’፤ ታኒ ነና ኪትያ በሳ ባዳ ታ ኪታ ኡባ አሳስ ኦዳ። <verse eid="JER 1:7"/><verse number="8" style="v" sid="JER 1:8"/>ታኒ ነና አሻናዉ ኔራ ደእያ ግሾ ኤንታዉ ያዮፋ። ሀይሳ ኦደይ ጎዳ” ያግስ።<verse eid="JER 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 1:9"/>ጎዳይ ባ ኩሽያ የድድ፥ ታ ዶና ቦችድ፥ “ሄኮ፤ ታኒ ታ ቃላ ነ ዶናን ዎስ። <verse eid="JER 1:9"/><verse number="10" style="v" sid="JER 1:10"/>ሾዳናዉነ ላላናዉ፥ ይሳናዉነ ሽራ የጋናዉ፥ ኬፃናዉነ ቶካናዉ፥ አሳ ቦላነ ካዎተታ ቦላ ታ ነና ሀች ሹማስ” ያግስ።<verse eid="JER 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 1:11"/>ጎዳ ቃላይ ታኮ፥ “ኤርምያሳ፥ ኔኒ አይ በአይ?” ያግስ።</para>
  <para style="p" vid="JER 1:11">ታኒ ዛራዳ፥ “ላዉዘ ም ፃምአ በአይስ” ያጋስ። <verse eid="JER 1:11"/><verse number="12" style="v" sid="JER 1:12"/>ጎዳይ፥ “ኔኒ ልከ በአዳሳ። ታካ ታ ቃላ ፖላናዉ ሀይሳዳ በአይስ” ያግስ። <verse eid="JER 1:12"/><verse number="13" style="v" sid="JER 1:13"/>ዛሪድ ጎዳይ፥ “ሀራ አይ በአይ” ያግስ።</para>
  <para style="p" vid="JER 1:13">ታኒ ዛራዳ፥ “እስ ፐንትያ ፃሮይ ፑደሀ ባጋፈ እስ ባጋ ገድ ግድ ኡትዳይሳ በአይስ” ያጋስ።<verse eid="JER 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 1:14"/>ጎዳይ፥ “ፑደሀ ባጋፈ ዮይ ፖድ፥ ቢታን ደእያ አሳ ኡባ ቦላ ጉካና። <verse eid="JER 1:14"/><verse number="15" style="v" sid="JER 1:15"/>ታኒ ፑደሀ ባጋ ካዎተታን ደእያ አሳ ኡባ ፄጋና ሀናይስ። ኤንታ ካዎት ይድ፥ የሩሳላመ ገልያ ፐንገታን፥ ድርሳ ዩሹዋንነ ይሁዳ ካታማታ ኡባን ባንታ አራታ ዎና። <verse eid="JER 1:15"/><verse number="16" style="v" sid="JER 1:16"/>ይሁዳ አሳይ ታና አግድ፥ ኢታ ኦዳ ግሾ፥ ሀራ ፆሳታስ እፃነ ጩይስዳ ግሾነ ባንታ ኩሸን ኦዳ ፆሳታ ጎይንዳ ግሾ ታ ፕርዳ ኤንታ ቦላ ኤሀስ።<verse eid="JER 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 1:17"/>“ሽን ኔኒ ጊገታ! ደንዳዳ ታኒ ነና ኪትያባ ኡባ ኤንታዉ ኦዳ። ኤንታዉ ያዮፋ፤ ነ ኤንታዉ ያይኮ፥ ታ ነና ኤንታ ስንን ጉጃዳ ያሽሳና። <verse eid="JER 1:17"/><verse number="18" style="v" sid="JER 1:18"/>ሀች ታ ነና ሀ ቢታ ቦላ፥ ይሁዳ ካዎታ ቦላ፥ ሀላቃታ ቦላ፥ ካህነታ ቦላነ ሀ አሳ ቦላ ግምበትዳ ካታማዳ፥ ብራታ ቱሳዳነ ናሰ ብራታን ድርዳ ድርሳዳ ኦዳ ምንስ። <verse eid="JER 1:18"/><verse number="19" style="v" sid="JER 1:19"/>ኤንቲ ኔራ ኦለታና፤ ሽን ታ አሻናዉ ኔራ ደእያ ግሾ ነና ፆኖኮና። ሀይሳ ኦደይ ጎዳ” ያግስ።<verse eid="JER 1:19"/></para>
  <chapter eid="JER 1"/>
  <chapter number="2" style="c" sid="JER 2"/>
  <para style="s1">እስራኤለይ ፆሳ አግስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 2:1"/>ጎዳ ቃላይ ታኮ ሀይሳዳ ያግሸ ይስ፦ <verse eid="JER 2:1"/><verse number="2" style="v" sid="JER 2:2"/>“ባዳ የሩሳላመ አሳ ሀይን ሀይሳዳ ያጋዳ አዋጃ። ነ ናአተን ታዉ አይ መላ አማነትዳኮ፥ ነ ቡሮ መዳን ደእያ ዎደ ታና አይ መላ ሲቅዳኮ፥ ታ አኬካይስ። ኔኒ መላ ቢታን ዘረ ዘረት ኤሮና ቢታን ታና ካላዳሳ። <verse eid="JER 2:2"/><verse number="3" style="v" sid="JER 2:3"/>ሄ ዎደ እስራኤለይ ጎዳስ ጌሽ፤ እያዉ ባይራ ካ መላ። እያፐ ምዳ ኡባይ ባላ ግዶሶና፤ ኤንታ ቦላ ዮይ ይስ። ሄሳ ኦደይ ጎዳ” ያጌስ።<verse eid="JER 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 2:4"/>ህንተኖ፥ ያይቆባ ናይቶ፥ እስራኤለ ዛረ፥ ኡባይ ጎዳ ቃላ ስእተ! <verse eid="JER 2:4"/><verse number="5" style="v" sid="JER 2:5"/>ጎዳይ ያጌስ፤ ካሰ ህንተ አዋት ታፐ አይ ባላ ደምድ ታፐ ሃክድ ብዶና? ኤንቲ ፓና ኤቃታ ጎይንድ ፓናባ ግድዶሶና። <verse eid="JER 2:5"/><verse number="6" style="v" sid="JER 2:6"/>ኤንቲ፥ “ኑና ግብፀፈ ከስዳ፥ መላ ቢታን ካለዳ፥ አፎራነ መላ ቢታራ አዳ፥ ኮሽነ ሳካና ም ደእያ ቢታራ ፕንዳ፥ ኦንካ አናነ ደኦና በሳራ ካለዳ ጎዳይ አዉን ደኢ?” ያግድ ኦይችቦኮና። <verse eid="JER 2:6"/><verse number="7" style="v" sid="JER 2:7"/>ህንተ ሄ ቢታ አይፍያፐ ሎኡዋ ማና መላ ታ ህንተና አራዳ ቢታ ኤሀስ። ሽን ህንተ ይድ፥ ታ ቢታ ቱንስደታ፤ ታ ላታ ኢስደታ። <verse eid="JER 2:7"/><verse number="8" style="v" sid="JER 2:8"/>ካህነት፥ “ጎዳይ አዉኔ?” ያግድ ኦይችቦኮና። ታ ህገይ ኤንታ ኩሸን ደእያ አሳት ታና ኤርቦኮና። ደርያ አይሰይሳት ታ ቦላ ማካልዶሶና። ናበት ባኣለ ኤቃ ሱንን ትንብተ ኦድድ ፓና ኤቃታ ጎይንዶሶና።<verse eid="JER 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 2:9"/>“ሄሳ ግሾ፥ ታ ህንተራ ቡሮ ሞተታና፤ ህንተ ናይታ ናይታራ ሞተታና። <verse eid="JER 2:9"/><verse number="10" style="v" sid="JER 2:10"/>አነ ዉሎሀ ባጋ ብድ፥ ዩሾይ አባን ተቀትዳ ቢታ ቆጵሮሳ ፄልተ፤ ዶሎሀ ባጋ ብድ ቀዳረ ቢታ አሰ ኪትድ ፆሞስተ። ሀይሳ መላባይ ሀይሳፈ ካሰ ሀንዳኮ በእተ። <verse eid="JER 2:10"/><verse number="11" style="v" sid="JER 2:11"/>ኤንቲ ቱማ ፆሳታ ግዶና እፅኮካ ባ ፆሳታ ላምዳ ደረይ ኦኔ? ሽን ታ አሳይ ኤንታዉ ቦንቾ ግድዳ ታና ፓና ኤቃታራ ላምስ።”<verse eid="JER 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 2:12"/>“ሳሎቶ፥ ሀይሳን ማላለትተ፤</para>
  <para style="q2" vid="JER 2:12">ዳጋምድ ኮኮርተ” ያጌስ ጎዳይ<verse eid="JER 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 2:13"/>ታ አሳይ ናምኡ ናጋራ ኦዶሶና፤</para>
  <para style="q2" vid="JER 2:13">ሄስካ፥ ደኦ ፑልቶ ግድዳ ታና አግስ።</para>
  <para style="q1" vid="JER 2:13">ሃ ኦይካናዉ ዳንዳኦና፥</para>
  <para style="q2" vid="JER 2:13">ፆኤ ኦላታ ባንታዉ ቦክዶሶና።<verse eid="JER 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 2:14"/>“እስራኤለይ ሻመትዳ አይለዬ? ዎይኮ ሶን የለትዳ አይለዬ? ያትን፥ ሞርከት አይስ ዶኦዳ ሻንካቶና? <verse eid="JER 2:14"/><verse number="15" style="v" sid="JER 2:15"/>እያ ሞርከት ጋሞዳ እያ ቦላ ጉዶሶና። ኤንቲ ባንታ ቃላ ቁ ኦድ ዳሮሶና። ኤንቲ እያ ቢታ ካይስ ከስዶሶና፤ እያ ካታማት ላለትድ አስ ባይና ሶ ግድዶሶና። <verse eid="JER 2:15"/><verse number="16" style="v" sid="JER 2:16"/>ሄሳ ቦላካ መምፕሳነ ፃፍናሳ አሳት እያ ሁጵያ ሜድዶሶና። <verse eid="JER 2:16"/><verse number="17" style="v" sid="JER 2:17"/>ነኖ እስራኤለ፥ ኦገ ኡባን ነና ካለያ፥ ጎዳ ነ ፆሳ አጋዳ ሀይሳ ነ ቦላ ኤህዳይ ነና ግድኪ? <verse eid="JER 2:17"/><verse number="18" style="v" sid="JER 2:18"/>ናይለ ሻፋፐ ሃ ኡያናዉ ግብፀ ቡስ ነና አይ ማዳኔ? ኤፍራፂሳ ሻፋፐ ሃ ኡያናዉ አሶረ ቡስ ነና አይ ማዳኔ? <verse eid="JER 2:18"/><verse number="19" style="v" sid="JER 2:19"/>ህዛ ነ ኢታተይ ነና ሴራና፤ ነ ታና ካድዳይስ ነ ቦላ ፕርዳና። ነ ታና ጎዳ ነ ፆሳ አግዳይስ አይ መላ ኢታነ ጫሞ ግድያኮ አኬካ በአ። ነ ታዉ ያይያ ያሻይ ባዋ” ያጌስ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ።<verse eid="JER 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 2:20"/>“ታ ነ ቃምባራ ዳሮ ዎደፐ ካሰ መንስ፤ ነ ቃሹዋ ዱስ። ኔኒ፥ ‘ታ ነና ጎይንከ’ ያጋዳሳ። ደረ ቦላነ ዳሻ ም ጋርሳን ላይማታናዉ ዝንአዳሳ። <verse eid="JER 2:20"/><verse number="21" style="v" sid="JER 2:21"/>ታ ነና ዶረትዳ ዘረፈ ኤካዳ፥ ሎኦ ዎይነ ጋደን ቶካስ። ያትን፥ ዋናዳ፥ ጉየ ስማዳ፥ ዎራን ዶልዳ፥ ኢታ ዎይነ ግዳዲ?” ያጌስ ጎዳይ።<verse eid="JER 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 2:22"/>“ነ ሳንጌኖራ ሜጨትያኮካ፥ ሳሙናን ጎርፐትያኮካ ነ ቅታይ ታ ስንና። <verse eid="JER 2:22"/><verse number="23" style="v" sid="JER 2:23"/>ኔኒ ዋናዳ፥ ‘ታ ቱናብከ፤ ባኣለ ኤቃ ጎይናብከ’ ጋይ? ኔኒ ዛንጋራን ሀንዳባ ፄላ፤ ነ ኦዳባ አኬካ። ኔኒ ያነ ሃነ ዎፅያ ዚታ ከይዳ ግማለ መላ። <verse eid="JER 2:23"/><verse number="24" style="v" sid="JER 2:24"/>ኔኒ ባዞ ሜዘትዳ፥ ዚታ ዎደ ጫርኮ ስንገያ ሀረ መላ። እ አሞይ ደንድን፥ ኦን እዮ ተቃናዉ ዳንዳኢ? እያ ባዉ ኮያዳ ጋክያ ግሾ አይ አደ ሀረይካ እዮ ደማናዉ ዳቡረና። <verse eid="JER 2:24"/><verse number="25" style="v" sid="JER 2:25"/>ነኖ፥ እስራኤለ፥ ነ ጫማይ ዉራና ጋካናዉ ነ ኮቶኖይ መላና ጋካናዉ ሀራ ፆሳታ ጌዶ ዎፆፋ። ሽን ኔኒ፥ ‘አቶ፥ ሄስ ታና ማደና። ታኒ እማ ፆሳታ ዶሳስ፤ ታኒ ኤንታ ጎይናና’ ያጋዳሳ።<verse eid="JER 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 2:26"/>“ካይሶይ ኦይከትዳ ዎደ ዬላተይሳዳ እስራኤለ አሳይ ዬላትዶሶና፤ ኤንቲ፥ ኤንታ ካዎት፥ ኤንታ ሀላቃት፥ ኤንታ ካህነትነ ኤንታ ናበት ኡባይ ዬላታና። <verse eid="JER 2:26"/><verse number="27" style="v" sid="JER 2:27"/>ኤንቲ ምኮ፥ ‘ነ ታ አዋ’ ያጎሶና፤ ሹቻ፥ ‘ታና ነ የላዳሳ ያጎሶና። ኤንቲ ባንታ ሶምኡዋ አግድ፥ ባንታ ዞኩዋ ዛርዶሶና። ሽን ኤንቲ መቶ ዎደ ኑና አሻ!’ ያጎሶና። <verse eid="JER 2:27"/><verse number="28" style="v" sid="JER 2:28"/>ሽን ህንተ፥ ህንተዉ መዳ ፆሳት አዉን ደኦና? ህንተ መቶን ገልያ ዎደ ህንተና አሻናዉ ዳንዳእኮ ደንድድ ህንተና አሾ። ህንተኖ፥ ይሁዳ አሳዉ፥ ህንተ ፆሳት ህንተ ካታማታ መላ ዳሮ” ያጌስ ጎዳይ።<verse eid="JER 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 2:29"/>“ህንተ ታራ አይስ ሞተተቲ? ህንተ ኡባይ ታዉ ማካልደታ። <verse eid="JER 2:29"/><verse number="30" style="v" sid="JER 2:30"/>ታ ህንተና ጮ ሴራስ፤ ህንተ ህንተ ኦሱዋፐ ስምያባ ግደከታ። ኮሻትዳ ጋሞዳ ህንተ ማሻይ ህንተ ናበታ ምስ” ያጌስ ጎዳይ።<verse eid="JER 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 2:31"/>ህንተኖ፥ ሀ ዎድያ የለታዉ፥ ጎዳ ቃላ ስእተ። ታ እስራኤለታስ ባዞ ዎይኮ ሳካና ማን ደእያ ቢታ ግዳድናዬ? ያትን፥ አይስ ታ አሳይ፥ “ኑኒ ኑ ሸነዳ ባና፤ ኔኮ ስሞኮ” ያግዶና? <verse eid="JER 2:31"/><verse number="32" style="v" sid="JER 2:32"/>ጌላእያ ባ አሌቁዋ፥ ሙሹርያ ባ ማኡዋ ዶጋይ? ሽን ታ አሳይ ታና ታይቦይ ባይና ጋላስ ዶግዶሶና። <verse eid="JER 2:32"/><verse number="33" style="v" sid="JER 2:33"/>ኔኒ ነ ላገታ ጌዶ ዎ ዋናዳ ሜዘታዲ? ዳሮ ኢታ ማጫሳት ነ ኦግያ ታማሮሶና። <verse eid="JER 2:33"/><verse number="34" style="v" sid="JER 2:34"/>መንድ ገልሽን ኦይክዳ አሳ ሱን ግዶናሽን ፅሎ ማንቆታ ሱን ነ ማኦይ ኢትስ። ኔኒ ሄሳ ኡባ ኦዳካ፥ <verse eid="JER 2:34"/><verse number="35" style="v" sid="JER 2:35"/>ኔኒ፥ “ ‘ታኒ ፅሎ፤ ቱማ ጎዳይ ታ ቦላ ሀንቀተና፤ ታኒ ናጋራ ኦብከ’ ግያ ግሾ ታ ነ ቦላ ፕርዳና። <verse eid="JER 2:35"/><verse number="36" style="v" sid="JER 2:36"/>ኔኒ ነ ኦግያ ላማሸ አይስ ዎፃይ? ነና አሶረይ ዬላይዳይሳዳ ግብፀይ ዬላያና። <verse eid="JER 2:36"/><verse number="37" style="v" sid="JER 2:37"/>ጎዳይ ነ አማነተይሳታ ካዉሽዳ ግሾነ ነ ኤንታፈ ማደ ደሞና ግሾ ነ ሁጵያ ኦይካዳ ያፐ ከያና” ያጌስ ጎዳይ።<verse eid="JER 2:37"/></para>
  <chapter eid="JER 2"/>
  <chapter number="3" style="c" sid="JER 3"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 3:1"/>“እስ አስ ባ ማችዉ የድን፥ እያ ባዳ ሀራ አዝና ገልኮ፥ ሄ አደይ እዮ ዛሪ? ዛርኮ ሄ ቢታይ ቱና ግደኔ? ሽን ነ ላይማታናዉ ኮያዳ ዳሮ ላገታራ ደአዳሳ፤ ሀእ ኔኒ ታኮ ስማኔ? ያጌስ ጎዳይ <verse eid="JER 3:1"/><verse number="2" style="v" sid="JER 3:2"/>ቁ ጋዳ አይኮይ ባይና ደረታ ፄላ። ላይማታናዉ ነ ዝንአቦና በሲ ደኢ? አራበ አስ መላ ቢታን ኡተይሳዳ፥ ኔኒ ላገታ ናጋዳ ኦገ ዶናን ኡታዳሳ። ነ ላይማተንነ ነ ኢታተን ቢታ ቱንሳዳሳ። <verse eid="JER 3:2"/><verse number="3" style="v" sid="JER 3:3"/>ሄሳ ግሾ፥ ቶርቸ እራይ ተቀትስ፤ ስላ እራይካ ቡኮና እፅስ። ሄስ ሀንንካ፥ ነዉ ላይማተ መይ ደኤስ፤ ነ ዬላቶና እፃዳሳ። <verse eid="JER 3:3"/><verse number="4" style="v" sid="JER 3:4"/>ሀእ ኔኒ፥ ‘ታ አዋዉ፥ ታ ናአተ ላግያዉ ነ ታና ሲቃሳ። <verse eid="JER 3:4"/><verse number="5" style="v" sid="JER 3:5"/>ነ ኡባ ዎደ ይሎታይ? ነ ሀንቆይ መርናዉ አገኔ?’ ያጋሳ። ሽን ነ ኦናዉ ዳንዳእያ ኢታ ኡባ ኦሳ” ያጌስ ጎዳይ።<verse eid="JER 3:5"/></para>
  <para style="s1">አማነቶና እስራኤለ</para>
  <para style="p">
    <verse number="6" style="v" sid="JER 3:6"/>ካዋ እዮስያሳ ዎደ ጎዳይ ታኮ ሀይሳዳ ያግስ፦ “አማኖይ ባይና እስራኤለይ ኦዳባ ነ በአዲ? እያ ደረ ቦላነ ዳሻ ም ኡባ ጋርስ ባዳ ያን ላይማታሱ። <verse eid="JER 3:6"/><verse number="7" style="v" sid="JER 3:7"/>እያ ሀይሳ ኡባ ኦንካ ታኮ ስማንደ ጋዳ ቆፓስ፥ ሽን ስማቡኩ። እ ምችያ፥ አማነቶና ይሁድካ ሄሳ በአሱ። <verse eid="JER 3:7"/><verse number="8" style="v" sid="JER 3:8"/>አማኖይ ባይና እስራኤለይ ዳሮ ዎደ ላይማትዳ ግሾ ፕርማ እማዳ እዮ የዳስ። ሄስ ሀንንካ እስራኤለ ምችያ፥ አማነቶና ይሁድ፥ ያዮናይሳ ታ በአስ፤ እያካ ከያዳ ላይማታሱ። <verse eid="JER 3:8"/><verse number="9" style="v" sid="JER 3:9"/>ላይማተይ እዉ ላፋባ ግድያ ግሾ፥ ምራነ ሹቻራ ላይማታዳ ቢታ ቱንሳሱ። <verse eid="JER 3:9"/><verse number="10" style="v" sid="JER 3:10"/>ሄ ኡባን እ ምችያ፥ አማነቶና ይሁድ ስምዳባ ዳናዉሱፐ አትሽን፥ ኩመ ዎዛናፐ ታኮ ስማቡኩ” ያጌስ ጎዳይ።<verse eid="JER 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 3:11"/>“አማነቶና ይሁዳፐ አማኖይ ባይና እስራኤለይ ፅሎ። <verse eid="JER 3:11"/><verse number="12" style="v" sid="JER 3:12"/>ባዳ ፑደሀ ባጋን ደእያ አሳስ ሀይሳዳ ያጋዳ አዋጃ፦ ‘አማኖይ ባይና እስራኤለ፥ ስማ! ታኒ ማሮት ኩምዳ ጎዳ ግድያ ግሾ ነና ኢታ አይፈን ፄልከ። መርናዉ ሀንቀትከ’። <verse eid="JER 3:12"/><verse number="13" style="v" sid="JER 3:13"/>ግዶሽን፥ ‘ታኒ ጎዳ፥ ታ ፆሳ ቦላ ማካላስ። አላጋ ፆሳታራ ዳሻ ም ጋርሳን ላይማታስ። ነ ቃላ ኪተታብከ’ ጋዳ ነ ቆሁዋ አማና” ያጌስ ጎዳይ።<verse eid="JER 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 3:14"/>“ህንተኖ፥ አማነቶና አሳዉ፥ ታ ህንተዉ አዝና ግድያ ግሾ ስምተ። ታኒ እስ ካታማፐ እስኖ፥ እስ ያራፐ ናምአ ዶራ ኤካዳ ፅዮነ ኤሀና። <verse eid="JER 3:14"/><verse number="15" style="v" sid="JER 3:15"/>ታ ዎዛናዳ ህንተና ሄምያ ሄንንቾታ ህንተዉ እማና። ኤንቲ ህንተና ኤራተንነ አኬካን ሄማና” ያጌስ ጎዳይ።<verse eid="JER 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 3:16"/>“ሄ ጋላሳታን ህንተ ሄ ቢታን ዳርያ ዎደ አሳይ፥ ‘ጎዳ ጫቆ ታቦትያ’ ግድ ኦደቶኮና። እ ኤንታዉ ቆፈተና፤ ሀሳየተና፤ ባይናይስ ኤንታዉ ኤረተና፤ ሀርካ ኦሰተና። <verse eid="JER 3:16"/><verse number="17" style="v" sid="JER 3:17"/>ሄ ዎደ ኤንቲ የሩሳላመ፥ ‘ጎዳ አራታ’ ግድ ፄጋና። ካዎተ ኡባፈ አሳይ ጎዳ ሱን ቦንቻናዉ የሩሳላመ ሺቃና። ሄሳፈ ጉየ፥ ኤንቲ ባንታ ዎዛና ኢታተ ካሎኮና። <verse eid="JER 3:17"/><verse number="18" style="v" sid="JER 3:18"/>ሄ ዎደ ይሁዳ አሳይነ እስራኤለ አሳይ ጋሄትድ ፑደሀ ባጋ ቢታፈ ታ ህንተ አዋታ ላትስዳ ቢታ እስፈ ያና” ያጌስ ጎዳይ።<verse eid="JER 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 3:19"/>“ታ ህንተና ናአ ኤካዳ፥ ቢታ ኡባፈ ሎእያነ አራዳ ቢታ ህንተዉ እማናዉ ኮያስ። ‘ታ አዋዉ’ ግድ ፄጋናነ ታና ካላና ጋዳ ቆፓስ። <verse eid="JER 3:19"/><verse number="20" style="v" sid="JER 3:20"/>ሽን እስራኤለ አሳዉ፥ ህንተ ባ አዝናስ አማነቶና ማችዳ ታዉ አማነትበከታ” ያጌስ ጎዳይ።<verse eid="JER 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 3:21"/>ኤንቲ ባንታ ኦግያ ጌላይዳ ግሾነ ባንታ ፆሳ አግዳ ግሾ ማንቆ ዙማታፐ እስራኤለ አሳ ዋሶይነ ዬሆይ ስኤቴስ። <verse eid="JER 3:21"/><verse number="22" style="v" sid="JER 3:22"/>“ህንተኖ፥ አማኖይ ባይና አሳዉ፥ ታኮ ስምተ። ህንተ አማነታና መላ ታ ህንተና ፓና” ያጌስ ጎዳይ።</para>
  <para style="p" vid="JER 3:22">ህንተ፥ “ኔኒ፥ ኑ ጎዳ ፆሳ ግድያ ግሾ ኔኮ ስማና። <verse eid="JER 3:22"/><verse number="23" style="v" sid="JER 3:23"/>ደረታ ቦላነ ዙማታ ቦላ ኤቃ ጎይኖይ ቱማ ጭሞ። ቱማ እስራኤለ አቶተይ ጎዳ፥ ኑ ፆሳ። <verse eid="JER 3:23"/><verse number="24" style="v" sid="JER 3:24"/>ኑ ናአተፈ ዶምን፥ ኑ አዋት ዳቡርድ ደምዳ፥ ኤንታ ዶርሳነ መህያ፥ ኤንታ ማጫነ አደ ናይታ ዬላይያ ኤቃት ምድ ይስዶሶና። <verse eid="JER 3:24"/><verse number="25" style="v" sid="JER 3:25"/>ናአተፈ ሀች ጋካናዉ፥ ኑነ ኑ አዋት ጎዳ ኑ ፆሳ ቦላ ናጋራ ኦዳ። ጎዳ ኑ ፆሳ ቃላ ኪተትቦኮ። ሄሳ ግሾ፥ ኑኒ ዬላን ጉፋናናዉ ቃስ ካዉሻተ አፍላዳ ኑና ካሞ” ያጎሶና።<verse eid="JER 3:25"/></para>
  <chapter eid="JER 3"/>
  <chapter number="4" style="c" sid="JER 4"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 4:1"/>ጎዳይ ያጌስ፥ “እስራኤለ አሳዉ፥ ስምኮ፥ ታኮ ስምተ። ህንተ ታና ሻትያ ህንተ ኤቃታ ታ ስንፈ ድግኮ፥ ታ ኦግያፐ ካረ ከዮና እፅኮ፥ <verse eid="JER 4:1"/><verse number="2" style="v" sid="JER 4:2"/>ቱማን፥ ሱረተንነ ፅሎተን፥ ‘ደኦ ፆሳይ ኤርያ መላ’ ግድ ጫቅኮ፥ ሄ ዎደ ካዎተት እያን አንጀታናነ እያን ጬቃና።”<verse eid="JER 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 4:3"/>ጎዳይ ይሁዳነ የሩሳላመ አሳኮ ሀይሳዳ ያጌስ፦ “ህንተ ኦ ቢታ ጎይተ፤ አጉን ቦላ ዘሮፕተ። <verse eid="JER 4:3"/><verse number="4" style="v" sid="JER 4:4"/>ህንተኖ፥ ይሁዳነ የሩሳላመ አሳዉ፥ ህንተ ፆሳስ ቃፃረትተ፤ ህንተ ዎዛና ሾሁዋ ድግተ። ሄስ ሀኖና እፅኮ ህንተ ኢታተ ግሾ፥ ታ ሀንቆይ ታማዳ ኤፃና፤ እያ ኦንካ ቶይሳናዉ ዳንዳኤና” ያጌስ ጎዳይ።<verse eid="JER 4:4"/></para>
  <para style="s1">ፑደሀ ባጋፈ ዮ ያና</para>
  <para style="p">
    <verse number="5" style="v" sid="JER 4:5"/>ይሁዳን አዋጅተ፤ የሩሳላመን ሞይዘ ፑንተ! ህንተ ቃላ ቁ ኦድ ሀይሳዳ ግድ ዋስተ! እስፈ ሺቅድ ግምበትዳ ካታማታኮ የተ። <verse eid="JER 4:5"/><verse number="6" style="v" sid="JER 4:6"/>አሳይ ፅዮነ ባና መላ ማልተ! ህንተ ሸምፑዋ አሻናዉ ጋምኦና ባቃትተ! ጋምኦፍተ! ታ ፑደሀ ባጋፈ ጋዶነ ዮ ቢታ ቦላ ኤሀና ሀናይስ። <verse eid="JER 4:6"/><verse number="7" style="v" sid="JER 4:7"/>ጋሞይ ዎራፐ ከየይሳዳ ካዎተታ ይሰይስ ባ በሳፈ ደንድድ ህንተ ቢታ ይሳናዉ ይስ። ህንተ ካታማት ላለትድ ባይሳ ግዳና። <verse eid="JER 4:7"/><verse number="8" style="v" sid="JER 4:8"/>ሄሳ ግሾ፥ ካዮ ማኦ ማእድ፥ “ዎ! ዎ!” ግድ ዘሌልተነ ዬክተ። ጎዳ ሱልያ ሀንቆይ ኑ ቦላፈ ክችቤና።<verse eid="JER 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 4:9"/>“ሄ ዎደ ካዋነ ሀላቃታ ዎዛናይ ትልአና፤ ካህነት ዳጋማና፤ ናበት ህርጋና” ያጌስ ጎዳይ።<verse eid="JER 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 4:10"/>ታኒ፥ “ኡባ ሃርያ ጎዳዉ፥ ማሽ ኤንታ ቆን ዎያ ዎደ ‘ህንተዉ ሳእ ሳሮ ግዳና’ ያጋዳ ሀ አሳነ የሩሳላመ አይስ ጭማይ” ያጋስ።<verse eid="JER 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 4:11"/>ሄ ዎደ ሀ አሳስነ የሩሳላመስ ሀይሳዳ ያግድ ኦደታና፦ “መላ ቢታን ደእያ አይኮይ ባይና ቃ ደረታፐ ምችያ ጫርኮይ ታ አሳ ቦላ ጫርካና፤ ሄስ ካ ጌሻናሳ ግደና። <verse eid="JER 4:11"/><verse number="12" style="v" sid="JER 4:12"/>ታ ኪታን ዎልቃማ ጫርኮይ ጫርካና፤ ታ ኤንታ ፕርዳና” ጌስ።<verse eid="JER 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 4:13"/>ሄኮ፥ ሞርከይ ሻራዳ ከዬስ። እያ ፓራ ጋረት ጎተ መላ፤ እያ ፓራት አርጋንፈ አድ ኤሶቶሶና። ኑና አየ! ኑ ይዳ!<verse eid="JER 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 4:14"/>“ነኖ የሩሳላመ፥ አታና መላ ነ ዎዛና ሜጫዳ ኢታተፈ ጌያ። ኢታ ቆፋይ ነ ዎዛናን አዉደ ጋካናዉ ጋምአኔ? <verse eid="JER 4:14"/><verse number="15" style="v" sid="JER 4:15"/>ዳነ ካታማፐነ ኤፍሬማ ዙማፐ ይዳይሳት ኢታባ አዋጆሶና። <verse eid="JER 4:15"/><verse number="16" style="v" sid="JER 4:16"/>ይሁዳ ካታማታ ቦላ ኦላ አዋጅያ ኦላንቾት ሃሆ ቢታፈ ዩሳ ቦላ ደኦሶና ግድ ካዎተታስ ኦድተ፤ የሩሳላመስካ አዋጅተ። <verse eid="JER 4:16"/><verse number="17" style="v" sid="JER 4:17"/>እ ታ ቦላ ማካልዳ ግሾ፥ ጋደን ደእያ ካ ናገይሳዳ ኦላንቾት ይሁዳ ዩሹዋ ተቃና” ያጌስ ጎዳይ።<verse eid="JER 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 4:18"/>ይሁዳ አሳዉ፥ ህንተ ሀኖይነ ህንተ ኦሶይ ሀይሳ ኡባ ህንተ ቦላ ኤህስ። ሀይስ ህንተዉ ሴራ። እ አይ መላ ጫም! ህንተ ዎዛና አይ መላ ጫድ!<verse eid="JER 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 4:19"/>ታና አየ! ታ ሀይሳ ዋታ ዳንዳአነ! አየ ታ ዎዛና! ታ ዎዛናይ ኮኮሬስ፤ ታ ስእ ጋናዉ ዳንዳእከ። ታኒ ሞይዘ ፑኖነ ኦላ ግርስ ስእዳ ግሾ ስእ ጋናዉ ዳንዳእከ። <verse eid="JER 4:19"/><verse number="20" style="v" sid="JER 4:20"/>ዮይ ዮ ቦላ ዬስ፤ ቢታይ ኩመ ይስ። ታ ዱንካነይ ኩንድስ፤ ታ ሻቃራይካ ላለትስ። <verse eid="JER 4:20"/><verse number="21" style="v" sid="JER 4:21"/>ታኒ አዉደ ጋካናዉ ኦላ ማላ በአኔ? አዉደ ጋካናዉ ሞይዘ ፑኖ ስአኔ?<verse eid="JER 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 4:22"/>“ታ አሳይ ኤያ፤ ኤንቲ ታና ኤሮኮና። ኤንቲ ቆፍ ባይና ናይታ መላ፤ ኤንታዉ አኬክ ባዋ። ኤንቲ ኢታባ ኦናዉ ጭንጫ፤ ሽን ሎኦባ ኦድ ኤሮኮና” ያጌስ ጎዳይ።<verse eid="JER 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 4:23"/>“ታኒ ሳኣ በእያ ዎደ፥ ሳእ አይኮይካ ባይና ባይሳ ግድዳይሳ በአስ። ቃስ ሳሎታ ፄልያ ዎደ፥ ፖኦይ ባይናይሳ ፄላስ። <verse eid="JER 4:23"/><verse number="24" style="v" sid="JER 4:24"/>ታ ደረታ ፄልያ ዎደ ኤንቲ ቃፆሶና፤ ታኒ ዙማታ በእያ ዎደ ያ ሃ ዎፆሶና። <verse eid="JER 4:24"/><verse number="25" style="v" sid="JER 4:25"/>ታ ፄልያ ዎደ አስ ባዋ፤ ሳሎ ካፎት ኡባይ ፓልድ ባቃትዶሶና። <verse eid="JER 4:25"/><verse number="26" style="v" sid="JER 4:26"/>ታ ፄልያ ዎደ አራዳ ቢታይ ቃኤ ግድዳይሳ በአስ። ጎዳ ስንንነ እያ ሱልያ ሀንቁዋ ስንን ሄ ቢታ ካታማት ላለትዶሶና።<verse eid="JER 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 4:27"/>“ቢታይ ያና፤ ሽን ታ እያ ኩመ ይስከ። <verse eid="JER 4:27"/><verse number="28" style="v" sid="JER 4:28"/>ሳአይ ዬካና፤ ሳሎይ ማና። ታ ኦዳስ፤ ማርስከ። ታ ቆፋ ቃቻስ፤ አግከ” ያጌስ ጎዳይ።<verse eid="JER 4:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 4:29"/>ፓራ አሳታነ ዶንገ አሳታ ዋሱዋን፥ አሳይ ካታማ ኡባፈ ባቃታና። ባጋት ዎፅድ ዎራ ገላና፥ ባጋት ዛላ ቦላ ከያና። ካታማ ኡባይ ባይስ ግድን ደእያ አስ ያና።<verse eid="JER 4:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 4:30"/>ነኖ፥ ዮስ አትዳረ ነ ዋናይ? ነ ዞኦ ማኡዋ አይስ ማአዲ? ዎርቃ አሌቆ አይስ ዎዲ? ነ አይፍያ ስጵን አይስ ትያይ? ኔኒ ጮ ነና ሎይሳ፤ ነ ላገት ነና ካዶሶና፤ ኤንቲ ነና ዎናዉ ኮዮሶና። <verse eid="JER 4:30"/><verse number="31" style="v" sid="JER 4:31"/>ታኒ እቀ ኦይክዳ ማጫስ ዋስያ ዋሱዋ መላ ስአስ። እ ዋሶይ ኮይሮ ናአ የልያ ማጫሳ ዋሶ መላ። ሄ ዋሶይ፥ የሩሳላመይ ሸምፖ ያዳ፥ ባ ኩሽያ ምጫዳ፥ “ታና አየ! ታ ያስ! ታና ዎናዉ ሀኖሶና!” ያጋዳ ዋስያ ዋሱዋ።<verse eid="JER 4:31"/></para>
  <chapter eid="JER 4"/>
  <chapter number="5" style="c" sid="JER 5"/>
  <para style="s1">ሱረ አስ ባዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 5:1"/>“አነ የሩሳላመ ኦግያ ቦላ ከይተ፤ ፑደነ ዱገ ሄመትተ፤ እያ ዩሹዋ ፄልተነ አኬክተ፤ እያ ጉታራንካ ኮይተ። ፅሎ ፕርድያነ ቱማ ኮያ እስ አስ ህንተ ደምኮ፥ ታ የሩሳላመ ማራና። <verse eid="JER 5:1"/><verse number="2" style="v" sid="JER 5:2"/>ኤንቲ፥ ‘ደኦ ጎዳይ ኤርያ መላ’ ግድ ጫቅኮካ፥ ዎርዶ ጫቆሶና” ያጌስ ጎዳይ።<verse eid="JER 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 5:3"/>አቤት ጎዳዉ፥ ነ አይፈት ቱማ ፄሎኮናዬ? ነ ኤንታ ሾጫዳሳ ሽን ኤንታ ሳክቤና። ነ ኤንታ መንረዳሳ ሽን ኤንቲ ስሞና እፅዶሶና። ኤንቲ ባንታ ሶምኡዋ ዛላፈ አድ ምንድ ባንታ ናጋራፐ ስሞና እፅዶሶና።<verse eid="JER 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 5:4"/>ሄሳፈ ጉየ፥ ታኒ፥ “ሀይሳቲ ጎዳ ኦግያነ ባንታ ፆሳ ህግያ ኤሮና ግሾ፥ ማንቆነ ኤያ” ያጋዳ ቆፓስ። <verse eid="JER 5:4"/><verse number="5" style="v" sid="JER 5:5"/>ህዛ፥ ታ ግታ አሳታኮ ባዳ ኤንታዉ ኦዳና። ጎዳ ኦግያነ ባንታ ፆሳ ህግያ ኤሮሶና። ሽን ኤንቲ ኡባይ እያ ቃምባራ መንዶሶና፤ እያ ቃሹዋካ ዱዶሶና። <verse eid="JER 5:5"/><verse number="6" style="v" sid="JER 5:6"/>ኤንታ ማካላይነ ኤንታ ኩንደይ ዳሮ ግድያ ግሾ፥ ጋሞይ ዎራፐ ከይድ፥ ኤንታ ዎና። ሱመይ ባዞፈ ከይድ፥ ኤንታ ማና። ማሄይ ኤንታ ካታማታ ሆክድ ናጋና። ሄ ካታማታፐ ከይያ ኡባይ ፑዘታና።<verse eid="JER 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 5:7"/>“ታኒ ህንተ ናጋራ አይስ አቶ ጎ? ህንተ ናይት ታና አግድ፥ ዎርዶ ፆሳታን ጫቅዶሶና። ታኒ ኤንታ ሙዛዳ ካልሳስ፥ ሽን ኤንቲ ላይማትዶሶና፤ ኤንታ ኬን አቅዶሶና። <verse eid="JER 5:7"/><verse number="8" style="v" sid="JER 5:8"/>ኤንቲ ከትዳ ኮርማ ፓራዳ፥ ሀራ አሳ ማቾ ላገናዉ ስንገሶና። <verse eid="JER 5:8"/><verse number="9" style="v" sid="JER 5:9"/>ቱማ ታ ሀ ኦሶታ ግሾ፥ ኤንታ ሴራናዉ በስክና? ሀይሳ መላ ካዎተ ቦላ ታ ሃሉዋ ከይክና?” ያጌስ ጎዳይ።<verse eid="JER 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 5:10"/>“እ ዎይነ ጋድያ ግዶ ገልድ ኢስተ፥ ሽን ኩመ ይሶፍተ። ኤንቲ ጎዳባ ግዶና ግሾ እ ታሸታ ካርድ የግተ። <verse eid="JER 5:10"/><verse number="11" style="v" sid="JER 5:11"/>እስራኤለ አሳይነ ይሁዳ አሳይ ኩመ ካድዶሶና” ያጌስ ጎዳይ።<verse eid="JER 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 5:12"/>ኤንቲ ሀይሳዳ ግድ ጎዳ ቦላ ዎርዶ ኦደትዶሶና፦ “እ አይኮካ ኦና፤ ቆህያባይ አይብካ ኑ ቦላ ዬና። ሞርከ ማሻይ ዎይኮ ኮሽ ኑና ፖሎ ደመና። <verse eid="JER 5:12"/><verse number="13" style="v" sid="JER 5:13"/>ናበት ጫርኮ መላ፤ ኤንታን ፆሳ ቃላይ ባዋ። ሄሳ ግሾ፥ ኤንቲ ግያባ ኡባይ ኤንታ ጋኮ” ያጎሶና።<verse eid="JER 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 5:14"/>ሄሳ ግሾ፥ እስራኤለ አሳኮ፥ “ኤንቲ ሀ ቃላ ኦድዳ ግሾ ታኒ ታ ቃላ ነ ዶናን ታማ ኦና፤ ሀ አሳይ ም ግዳና፤ ታማይካ ኤንታ ማና” ያጌስ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ።<verse eid="JER 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 5:15"/>ጎዳይ እስራኤለ አሳኮ፥ “ህንተኖ፥ እስራኤለ አሳዉ፥ ታ ህንተ ቦላ ሃሆ ቢታፈ እስ ካዎተ ኤሀና። ኤንታ ቃላ ህንተ ኤሮና፥ ኤንታ ኦዳይ ህንተዉ ገሎና ዎልቃማነ በን ካዎተ። <verse eid="JER 5:15"/><verse number="16" style="v" sid="JER 5:16"/>ኤንታ ዶንገ ፓልኤ ሾሆይ ዶያ ዱፎ መላ፤ ኤንታ ኦላንቾት ዎልቃማ። <verse eid="JER 5:16"/><verse number="17" style="v" sid="JER 5:17"/>ኤንቲ ህንተ ካነ ህንተ ጎሻ አይፍያ ማና፤ ህንተ አደ ናይታነ ማጫ ናይታ ዎና፤ ህንተ ዶርሳነ መህያ ቦንቃና፤ ህንተ ዎይንያነ ባላሰ ም ይሳና። ህንተ አማነትያ፥ ግምበትዳ ካታማታ ባንታ ማሻን ኦልድ ይሳና” ያጌስ።<verse eid="JER 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 5:18"/>“ግዶሽን፥ ሄ ጋላሳታን ግድኮካ፥ ታኒ ታ አሳ ኩመ ይስከ” ያጌስ ጎዳይ <verse eid="JER 5:18"/><verse number="19" style="v" sid="JER 5:19"/>አሳይ ነና፥ “ ‘ጎዳይ ኑ ፆሳይ ኑ ቦላ ሀይሳ ኡባ አይስ ኦዴ?’ ግድ ኦይችኮ፥ ነ ኤንታኮ፥ ‘ህንተ ታና አግድ፥ ህንተ ቢታን እማ ፆሳታ ጎይንዳይሳዳ፥ ህንተካ አሳ ቢታን ሀራታስ ሀጋዛና’ ያጋ” ያግስ።<verse eid="JER 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 5:20"/>“ሀይሳ ያይቆባ አሳስ ኦዳ፤ ይሁዳ ቢታን አዋጃ። <verse eid="JER 5:20"/><verse number="21" style="v" sid="JER 5:21"/>ህንተኖ፥ አይፈይ ደእሽን በኦናይሳቶ፥ ሀይ ደእሽን ስኦናይሳቶ፥ ኤያነ አኬኮና አሳዉ ሀይሳ ስእተ! <verse eid="JER 5:21"/><verse number="22" style="v" sid="JER 5:22"/>ህንተ ታዉ ያያናዉ በሰኔ? ህንተ ታ ስንን ኮኮራናዉ ኮሸኔ? ያጌስ ጎዳይ። አባይ አድ ቦና መላ ሻፈ እያዉ ዛዋ ኦዳይ ታና? ዙለይ ሱግኮካ እያፐ አናዉ ዳንዳኤና፤ ሆበይ ደንድኮካ ካንድ አና። <verse eid="JER 5:22"/><verse number="23" style="v" sid="JER 5:23"/>ሽን ሀ አሳስ ሙመነ ማካላ ዎዛን ደኤስ። ኤንቲ ሀራ ሶ ስሚድ ዎራ ብዶሶና። <verse eid="JER 5:23"/><verse number="24" style="v" sid="JER 5:24"/>ኤንቲ ባንታ ዎዛናን፥ ‘ኑስ ስላ እራነ ቶርቸ እራ ዎደን ዎደን እምያ፥ ካ ሺሽያ ዎደ ኑስ እምያ ጎዳ አነ ያዮስ’ ያግቦኮና። <verse eid="JER 5:24"/><verse number="25" style="v" sid="JER 5:25"/>ህንተ ባላይ ሄሳ ተቅስ፤ ህንተ ናጋራይ ህንተና ሎኦባፐ አሽስ” ያጌስ።<verse eid="JER 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 5:26"/>“ታ አሳ ግዶን ኢታ አሳት ደኦሶና። ካፎ ኦይካናዉ ናግያ አሳዳ ሆክድ ናጎሶና። ኤንቲ ግተ የግድ አሳ ኦይኮሶና። <verse eid="JER 5:26"/><verse number="27" style="v" sid="JER 5:27"/>ካፎ ኬን ካፎይ ኩምዳዳ፥ ኤንታ ኬይ ጭሞን ኩምስ፤ ኤንቲ ዎልቃማነ ዱረ። <verse eid="JER 5:27"/><verse number="28" style="v" sid="JER 5:28"/>ኤንቲ ኦርደነ ሞ ግድዶሶና፤ ኤንታ ኢታ ኦሱዋስ ዛው ባዋ። ኤንቲ ይኦ ናይታ ግሾ ሞተቶኮና፤ ማንቆታስ ሱረ ፕርድቦኮና። <verse eid="JER 5:28"/><verse number="29" style="v" sid="JER 5:29"/>ያትን፥ ታኒ ሄሳ ግሾ ኤንታ ሴራናዉ በሰኔ? ሀይሳ መላ ካዎተ ቦላ ታ ሃሉዋ ከያናዉ በሰኔ?” ያጌስ ጎዳይ።<verse eid="JER 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 5:30"/>“ዳሮ ኢታባይነ ዳጋንያባይ ቢታ ቦላ ሀንስ። <verse eid="JER 5:30"/><verse number="31" style="v" sid="JER 5:31"/>ናበት ዎርዶ ኦዶሶና፤ ካህነት ኤንታ ዞርያን አይሶሶና። ታ አሳይካ ሄሳ መላባ ዶሴስ። ሽን ዉርሰን ህንተ ዋናኔ?” ያጌስ ጎዳይ።<verse eid="JER 5:31"/></para>
  <chapter eid="JER 5"/>
  <chapter number="6" style="c" sid="JER 6"/>
  <para style="s1">የሩሳላመይ ሞርከን ተቀትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 6:1"/>ህንተኖ፥ ብንያመ አሳዉ፥ ህንተ ሸምፑዋ አሻናዉ ባቃትተ! የሩሳላመፐ ከይተ! ታቁሄ ካታማን ሞይዘ ፑንተ! ቤት-ሀካሬማን ማላ በስተ! ፑደሀ ባጋፈ ኢታባይነ ግታ ዮይ ያና ሀኔስ። <verse eid="JER 6:1"/><verse number="2" style="v" sid="JER 6:2"/>ታኒ ሎእያነ ኡፋይስያ ፅዮነ ካታማታ ይሳና። <verse eid="JER 6:2"/><verse number="3" style="v" sid="JER 6:3"/>ሄንንቾት ባንታ ዉድያ ኤክድ ያ ያና። እያ ዩሹዋን ባንታ ዱንካንያ ቶካና፤ እሶይ እሶይ ባ ዉድያ ሄማና። <verse eid="JER 6:3"/><verse number="4" style="v" sid="JER 6:4"/>“የሩሳላመ ኦላናዉ ጊገትተ! ደንድተ! እያ ሴታ ጋላስ ኦሎስ። ሽን አየ! ሳእ ቃሜስ፤ ኦማርሳ ኩያይ አዱቅ አዱቅ ቤስ። <verse eid="JER 6:4"/><verse number="5" style="v" sid="JER 6:5"/>ሄሳ ግሾ፥ ደንድተ! ቃማ ኦልድ እያ ሚፃ ላሎስ” ያግድ ማቀቶሶና።<verse eid="JER 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 6:6"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፦ “ምታ ቃንፅተ። የሩሳላመ ግምብያ ምየን ቢታ ዶርተ። ሄ ካታማን ናቆይ ኩምዳ ግሾ እ ሴረታናዉ በሴስ። <verse eid="JER 6:6"/><verse number="7" style="v" sid="JER 6:7"/>ሃ ኦል ሃ ፑልተይሳዳ እካ ባ ኢታተ ፑልቴስ። ማካልነ ዮይ እያ ግዶን ስኤቴስ፤ እያ ሀርገይነ ማዱንይ ታ ስንና። <verse eid="JER 6:7"/><verse number="8" style="v" sid="JER 6:8"/>ነኖ የሩሳላመ፥ ታ ሴራ ኤካ። አካይ፥ ጊኮ፥ ታ ኔፐ ሻከታናነ ነ ቢታ አስ ባይና ባይሳ ከሳና” ያጌስ።<verse eid="JER 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 6:9"/>“ዎይነ ፖሽልያዳ፥ እስራኤለ አሳ ግዶፈ አትዳይሳታ ሎይድ ፖሽልተ። ዎይነ ቆርያ አሳዳ፥ ህንተ ኩሽያ ዳሻታ ግዶ ዛሪድ የድተ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 6:10"/>“ታ ኦደስ ኦዶ? ኦና ሴሮ? ኦን ስአኔ? ኤንቲ ስኦና መላ ኤንታ ሀይይ ቱልስ። ጎዳ ቃላይ ኤንታዉ ሚቻስ አትስ፤ ኤንቲ እያን ኡፋይቶኮና። <verse eid="JER 6:10"/><verse number="11" style="v" sid="JER 6:11"/>ጎዳ ሀንቆይ ታናን ኩምስ። ታ ሀ ሸንያ ተቃናዉ ዳንዳእከ። ኦገ ቦላ ደእያ ዮጋ ናይታ ቦላነ ሺቅዳ ናአተታ ቦላ ታ ሀንቁዋ ትጋ። ማችያ፥ አዝናይነ ጭምዳ አሳ ኡባይ አቶኮና። <verse eid="JER 6:11"/><verse number="12" style="v" sid="JER 6:12"/>ታኒ ሄ ቢታን ደኤይሳታ ቦላ ታ ኩሽያ የድያ ዎደ ኤንታ ኬይ፥ ኤንታ ጎሻይነ ኤንታ ማቸት ኡባይ ሀራታስ እመታና” ያጌስ።<verse eid="JER 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 6:13"/>“ጉፈ ግታ ጋካናዉ ኡባይ ባና ጎእያባ ኮዬስ። ናበትነ ካህነት ኡባይ ጭሞሶና። <verse eid="JER 6:13"/><verse number="14" style="v" sid="JER 6:14"/>ታ አሳ ማዱን ፓናባ ኦድ ጉ ለ ዎሶና። ሳሮይ ባይናሽን፥ ‘ሳሮ፤ ሳሮ!’ ያጎሶና። <verse eid="JER 6:14"/><verse number="15" style="v" sid="JER 6:15"/>ኤንቲ ሀ ሻትያ ኦሱዋ ኦድ ዬላትዶና? አካይ፥ ኤንቲ ኩመ ዬላትቦኮና፤ ኤንቲ ዬል አይበኮ ኤሮኮና። ሄሳ ግሾ፥ ኤንትካ ኩንድዳይሳታ ግዶን ኩንዳና። ታኒ ኤንታ ሴርያ ዎደ ኤንታ ካዉሻና” ያጌስ ጎዳይ።<verse eid="JER 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 6:16"/>ጎዳይ ሀይሳዳ ያጌስ፦ “ኦግያን ኤቅድ ፄልተ፤ በን ኦገይ ደእያ በሳ ኦይችተ። ሎኦ ኦገይ አዉን ደእያኮ ኦይችድ እያን ሄመትተ፤ ህንተ ሸምፖ ደማና። ሽን ህንተ፥ ኑኒ ሄ ኦግያን ሄመቶኮ!” ያግደታ። <verse eid="JER 6:16"/><verse number="17" style="v" sid="JER 6:17"/>ታኒ ናገይሳታ ህንተ ቦላ ሹማዳ፥ “ሞይዘ ግርሳ ስእተ” ያጋስ። ሽን ህንተ፥ “ኑ ስኦኮ” ያግደታ።<verse eid="JER 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 6:18"/>“ሄሳ ግሾ፥ ካዎተቶ፥ ስእተ! ታኒ ታ አሳ ቦላ ኦናባ አኬክተ። <verse eid="JER 6:18"/><verse number="19" style="v" sid="JER 6:19"/>ሳአን ደእያ አሳዉ፥ ሀይሳ ስእተ! ኤንቲ ታ ቃላ ስኦና እፅዳ ግሾነ ታ ህግያ ካዳ ግሾ ታ ኤንታ ቦላ ዮ ኤሀና። <verse eid="JER 6:19"/><verse number="20" style="v" sid="JER 6:20"/>ሳባ ቢታፈ እፃነ ዎይኮ ሃሆ ቢታፈ ይዳ ሳዎይነ ቅማመይ ታዉ አይሴ? ህንተ ፁሳ ያርሾይካ ኤከተና። ህንተ ያርሾይ ታና ኡፋይሰና” ያጌስ።<verse eid="JER 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 6:21"/>ሄሳ ግሾ፥ ጎዳይ፥ “ታኒ ሀ አሳ ስንን በ ዎና፤ አዋትነ ናይት ኤንታን በታና፤ ሾሮትነ ላገት ያና” ያጌስ።<verse eid="JER 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 6:22"/>ጎዳይ፥ “ፑደሀ ባጋ ቢታፈ ኦላንቾት ዮሶና፤ እስ ግታ ካዎተይ ሳኣ ጋፃፐ ደንድስ። <verse eid="JER 6:22"/><verse number="23" style="v" sid="JER 6:23"/>ኤንቲ ዶንገነ ቶራ ዳንጭዶሶና፤ ኤንቲ ቃይ ባይና ዎዛና ምኖታነ ማሮተ ኤሮናይሳታ። ኤንቲ ፓራን ጋላብያ ዎደ አባዳ ጉሞሶና። ህንተኖ፥ ፅዮነ ካታማ አሳዉ፥ ኤንቲ ህንተና ኦላናዉ ሳልፕዶሶና” ያጌስ።<verse eid="JER 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 6:24"/>ኑኒ ሄ ኦዳ ስእን፥ ኑ ኩሸይ አርጋጭስ፤ ማጫስ እቀ ኦይከይሳዳ ኑና መቶይነ ኡንእ ኦይክስ። <verse eid="JER 6:24"/><verse number="25" style="v" sid="JER 6:25"/>ሞርከይ ማሻ ኦይክዳ ግሾነ ያን ሀን ዳጋም ደእያ ግሾ ሶፐ ከዮፕተ፤ ኦገ ቦላካ በንቶፍተ። <verse eid="JER 6:25"/><verse number="26" style="v" sid="JER 6:26"/>ይሰይስ ቆፖና ኑ ቦላ ያና ግሾ፥ ካዮ ማኦ ማእድ፥ ብዶ ቦላ ጎንዶረትድ፥ አስ ባ እስ ናአስ ዬክያ መላ ታ አሳስ ዬክተ።<verse eid="JER 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 6:27"/>ጎዳይ ኤርምያሳኮ፥ “ኔኒ ኤንታ ኦግያ ፆሞሳና መላነ ፓጫና መላ ብራታ ፓጭያ አሳዳ ታ ነና ኦስ። <verse eid="JER 6:27"/><verse number="28" style="v" sid="JER 6:28"/>ኤንቲ ኡባይ ዝግራናዉ ዩዮሶና፤ ኦድን ስኦና ማካላንቾታ። ኤንቲ ናሰ ብራታዳነ ብራታዳ ምኖ፤ ኤንቲ ኡባይ ናጋራ ኦሶና። <verse eid="JER 6:28"/><verse number="29" style="v" sid="JER 6:29"/>ብራታ ቦላ ደእያ ሽአ ፁግድ ጌሻናዉ ግልፐይ ፑኔስ። ሽን ጌሻናዉ ዋይዳ ዋየይ ጮ ግድስ፤ ታ አሳ ግዶን ደእያ ኢታት ክችቦኮና። <verse eid="JER 6:29"/><verse number="30" style="v" sid="JER 6:30"/>ጎዳይ ኤንታ የግድ አግዳ ግሾ፥ ኤንቲ የገትዳ ብራ ጌተታና” ያጌስ።<verse eid="JER 6:30"/></para>
  <chapter eid="JER 6"/>
  <chapter number="7" style="c" sid="JER 7"/>
  <para style="s1">ቢታን ደእያ ኢታተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 7:1"/>ጎዳፐ ኤርምያሳኮ ይዳ ቃላይ ሀይሳ፦ <verse eid="JER 7:1"/><verse number="2" style="v" sid="JER 7:2"/>“ፆሳ ኬ ፐንግያን ኤቃዳ፥ ሀይሳዳ ያጋዳ አዋጃ። ህንተኖ፥ ጎዳ ጎይናናዉ ሀ ፐንገታራ ገልያ ይሁዳ አሳዉ፥ ኡባይ ጎዳ ቃላ ስእተ! <verse eid="JER 7:2"/><verse number="3" style="v" sid="JER 7:3"/>ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ ህንተ ኦግያነ ህንተ ኦሱዋ ላምተ፤ ታ ህንተና ሀ በሳን ዎና። <verse eid="JER 7:3"/><verse number="4" style="v" sid="JER 7:4"/>‘ሀይስ ፆሳ ኬ! ሀይስ ፆሳ ኬ! ሀይስ ፆሳ ኬ’ ያግድ ጭሞ ቃላን አማነቶፍተ። <verse eid="JER 7:4"/><verse number="5" style="v" sid="JER 7:5"/>ህንተ፥ ህንተ ኦግያነ ኦሱዋ ቱማ ላምኮ፥ እሶይ እሱዋስ ፅሎ ፕርድኮ፥ <verse eid="JER 7:5"/><verse number="6" style="v" sid="JER 7:6"/>በተ አሳ፥ ይኦ ናይታነ አምኤታ ናቆና አግኮ፥ ሀ በሳን ፅሎ አሳ ሱ ጉሶና አግኮነ፥ ህንተ ቆሄቶናዳ ሀራ ፆሳታ ጎይኖና አግኮ፥ <verse eid="JER 7:6"/><verse number="7" style="v" sid="JER 7:7"/>ታ ህንተ ማይዛታስ መርናዉ እምዳ ቢታን ህንተና ዎና። <verse eid="JER 7:7"/><verse number="8" style="v" sid="JER 7:8"/>ሽን ህንተ ማዶና ጭሞ ቃላን አማነተታ” ያጌስ።<verse eid="JER 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 7:9"/>“ህንተ ካይሶቴታ፥ ዎታ፥ ላይማተታ፥ ዎርዶ ጫቅድ ማርካቴታ፥ ባኣለ ኤቃስ ያርሾ ያርሼታ፥ ሀይሳፈ ካሰ ህንተ ኤሮና ሀራ ፆሳታ ጎይነታ። <verse eid="JER 7:9"/><verse number="10" style="v" sid="JER 7:10"/>ያትድ፥ ታ ሱንን ፄገትዳ ፆሳ ኬ ይድ፥ ታ ስንን ኤቅድ፥ ‘ኑኒ ሳሮ’ ያጌታ። ሽን ሀ ሻትያ ኦሱዋ ኡባ ኦታ <verse eid="JER 7:10"/><verse number="11" style="v" sid="JER 7:11"/>ታ ሱንን ፄገትዳ ሀ ፆሳ ኬይ ህንተዉ ፓንጋት ቆሰትያ ጎንጎሎ ግደትዬ? ህንተ ኦያባ ኡባ ታኒ ታ አይፈን በአስ” ያጌስ።<verse eid="JER 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 7:12"/>“ታኒ ታ ሱንይ ደእያ በሲ ኦዳ ኮይሮ ዶርዳ፥ ሴሎ ቢተ። ታ አሳ እስራኤለ ኢታተ ግሾ፥ ታኒ ሄ በሳ ዋትዳኮ በእተ። <verse eid="JER 7:12"/><verse number="13" style="v" sid="JER 7:13"/>ህንተ ሀ ኡባ ኦያ ዎደ ታ ህንተዉ ዛራ ዛራ ኦዳስ፤ ሽን ስኦና እፅደታ። ታ ህንተና ፄጋስ፤ ሽን ታዉ ኮይበከታ። <verse eid="JER 7:13"/><verse number="14" style="v" sid="JER 7:14"/>ሄሳ ግሾ፥ ታ ሴሎ ቦላ ኦዳይሳዳ ሀይሳን ህንተ አማነትያ፥ ታ ሱንን ፄገትዳ ሀ ፆሳ ኬ ቦላ፥ ህንተዉነ ህንተ ማይዛታስ እምዳ ሀ በሳ ቦላ ሄሳዳ ኦና። <verse eid="JER 7:14"/><verse number="15" style="v" sid="JER 7:15"/>ህንተ ዳቦታ፥ ኤፍሬማ ኮቻ ታ ድግዳይሳዳ ታ ስንፈ ህንተናካ ድጋና” ያጌስ።<verse eid="JER 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 7:16"/>“ኤርምያሳ፥ ታ ስኦና ግሾ፥ ሀ አሳስ ዎሶፋ፤ ኤንታ ግሾ ታና ኦይቾፋ ዎይኮ ዋሶፋ፤ ኤንታዉ ጋናቶፓ። <verse eid="JER 7:16"/><verse number="17" style="v" sid="JER 7:17"/>ኤንቲ ይሁዳ ካታማታንነ የሩሳላመ ኦገታን ኦያባይ አይበኮ በእክዬ? <verse eid="JER 7:17"/><verse number="18" style="v" sid="JER 7:18"/>ናይት ም ምፆሶና፤ አዋት ታማ ኤሶና፤ ማጫሳት፥ ‘ሳሎ ካዊዉ’ ጌተትያ ኤቄስ ኡይ ኡካናዉ ለ ሙኑቆሶና። ኤንቲ ታና ይሎያናዉ ኡሻ ያርሾ ሀራ ፆሳታስ ጉሶሶና። <verse eid="JER 7:18"/><verse number="19" style="v" sid="JER 7:19"/>ኤንቲ ሀይሳ ኦይ ቱማ ታና ቆሀናሰዬ? ሀይሳን ቆሄትድ ዬላታናይ ኤንታ ግዶኮናዬ?” ያጌስ ጎዳይ።<verse eid="JER 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 7:20"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታ ሀንቆይ ሀ በሳ ቦላ፥ አሳ ቦላነ መህያ ቦላ፥ ጋደን ደእያ ም ቦላነ ቢታን ደእያ ካ ቦላ ጉካና፤ እ ኤፃና፥ ቶአናዉ ዳንዳኤና።”<verse eid="JER 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 7:21"/>ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ “ህንተ ፁሳ ያርሹዋ ሀራ ያርሾታ ቦላ ጉጅድ፥ አሹዋ ህንተዉ ሚተ። <verse eid="JER 7:21"/><verse number="22" style="v" sid="JER 7:22"/>ታ ህንተ ማይዛታ ግብፀ ቢታፈ ከስያ ዎደ፥ ፁሳ ያርሾባነ ሀራ ያርሾታባ ኦዳብከ ዎይኮ ኪታብከ። <verse eid="JER 7:22"/><verse number="23" style="v" sid="JER 7:23"/>ሽን ታ ኤንታኮ፥ ታዉ ኪተትተ፤ ታ ህንተ ፆሳ ግዳና፤ ህንተካ ታ አሰ ግዳና። ህንተዉ እንጀታና መላ ታ ህንተና ኪትያ ኦገ ኡባን ሄመትተ። <verse eid="JER 7:23"/><verse number="24" style="v" sid="JER 7:24"/>ሽን ኤንቲ ታና ስኦና ዎይኮ ታዉ በሰ እሞና እፅዶሶና። ኤንቲ ባንታ ኢታ ዎዛና ቆፋ ካልድ ብዶሶና፤ ስን ባናይሳ አግድ ጉየ ብዶሶና። <verse eid="JER 7:24"/><verse number="25" style="v" sid="JER 7:25"/>ህንተ ማይዛት ግብፀፈ ከይዳ ዎደፐ ዶምድ ሀች ጋካናዉ ታ አይለታ፥ ናበታ ዎንታ ዎንታ ህንተዉ ኪታስ። <verse eid="JER 7:25"/><verse number="26" style="v" sid="JER 7:26"/>ሽን ህንተ ታና ስኦና ዎይኮ ታዉ በሰ እሞና እፅደታ። ህንተ ሞርግያ ምንደታ፤ ህንተ አዋታፐ አድ ኢታባ ኦደታ።<verse eid="JER 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 7:27"/>“ሀ ኡባ ነ ኤንታዉ ኦዳ፤ ሽን ኤንቲ ነ ግያባ ስኦኮና። ነ ኤንታ ፄጋና፤ ሽን ኤንቲ ኮዮኮና። <verse eid="JER 7:27"/><verse number="28" style="v" sid="JER 7:28"/>ሄሳ ግሾ፥ ኤርምያሳ፥ ነ ኤንታኮ ሀይሳዳ ያጋ፦ ሀ ካዎተይ ባ ጎዳ ፆሳ ኪተቶና ዎይኮ እያ ዞርያ ስኦና ካዎተ። ቱም ይስ፤ ቱም ኤንታ እንፃርሳን ዴና። <verse eid="JER 7:28"/><verse number="29" style="v" sid="JER 7:29"/>ህንተ ሁጵያ ሜድድ ዎራ ሆልተ። ጎዳይ ባና ይሎይዳ የለታ እፅዳ ግሾነ የግድ አግዳ ግሾ አይብካ ባይና ቃ ዙማ ቦላ ከይድ ዘሌልተ” ያግስ።<verse eid="JER 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 7:30"/>“ይሁዳ አሳይ ታ ስንን ኢታባ ኦዶሶና። ኤንቲ ታ ሱንን ፄገትዳ ፆሳ ኬ ቱንሳናዉ ታኒ እፅያ ኤቃታ ኤህድ እያ ግዶን ዎዶሶና። <verse eid="JER 7:30"/><verse number="31" style="v" sid="JER 7:31"/>ኤንቲ ባንታ አደ ናይታነ ማጫ ናይታ ታማን ፁግድ ያርሻናዉ፥ ህኖማ ዛንጋራን ቶፈታ ጌተትያ ያርሾ በሳ ግምብዶሶና። ሽን ሄስ ታ ኤንታ ኪታቦናባነ ታ ቆፋን ባይናባ። <verse eid="JER 7:31"/><verse number="32" style="v" sid="JER 7:32"/>ሄሳ ግሾ፥ ሄ በሳይ ህኖማ ዛንጋራ ዎይኮ ቶፈታ ጌተትድ ፄገተይስ አትድ፥ ሹካ ዛንጋራ ያገትድ ፄገታና ዎደይ ያና። ሞግያ በሲ ባይና ግሾ፥ ቶፈት ኤንቲ ባንታ አሀ ሞግያ በሲ ግዳና። <verse eid="JER 7:32"/><verse number="33" style="v" sid="JER 7:33"/>ሄ ዎደ ሄ አሳ አሀይ ሳሎ ካፎታስነ ሳአ ዶአታስ ካ ግዳና፤ ኤንታ ጎዳና አስካ ባዋ። <verse eid="JER 7:33"/><verse number="34" style="v" sid="JER 7:34"/>ታኒ የ፥ ኡፋይስነ ያጋኖ ግርስ ይሁዳ ካታማታንነ የሩሳላመ ኦገታን ስኤቶናዳ ኦና፤ ቢታይ ባይሳ ግዳና” ያጌስ ጎዳይ።<verse eid="JER 7:34"/></para>
  <chapter eid="JER 7"/>
  <chapter number="8" style="c" sid="JER 8"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 8:1"/>“ሄ ዎደ ይሁዳ ካዎታ መቀይ፥ ሀላቃታ መቀይ፥ ካህነታ መቀይ፥ ናበታ መቀይነ የሩሳላመን ደእያ አሳ መቀ ኡባይ ዱፎፐ ማፀትድ ከያና። <verse eid="JER 8:1"/><verse number="2" style="v" sid="JER 8:2"/>ኤንቲ ሲቅዳ፥ ኪተትዳ፥ ካልዳ፥ ዞረ ኦይችዳነ ጎይንዳ አዋ፥ አጌናነ ሳሎ ፆልንቶታ ኡባ ስንን ምጨታና። ኤንታ መቀይ ሺቀና ዎይኮ ሞገተና፤ ሽን ቢታ ቦላ ፕቶ መላ የገታና። <verse eid="JER 8:2"/><verse number="3" style="v" sid="JER 8:3"/>ታ ላልዳ በሳታን ደእያ፥ ሀ ኢታ ካዎተፈ አትዳ አሳ ኡባይ ደኦፐ ሀይቆ አሞታና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 8:3"/></para>
  <para style="s1">ናጋራነ ፕርዳ</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 8:4"/>ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ፦ “እስ አስ ኩንድኮ፥ ስሚድ ደንደነዬ? ዎይኮ እስ አስ ኦገ ባለትኮ ጉየ ስመነዬ? <verse eid="JER 8:4"/><verse number="5" style="v" sid="JER 8:5"/>ያትን፥ ሀ አሳይ አይስ ጉየ ስምዴ? የሩሳላመይ አይስ ኡባ ዎደ ኦገ ባሌቲ? ኤንቲ ጭሞ ባቅድ ኦይክዶሶና፤ ስሞና እፅዶሶና። <verse eid="JER 8:5"/><verse number="6" style="v" sid="JER 8:6"/>ታ ምንዳ ሀይዛስ፤ ሽን ኤንቲ ቱማ ሃሳዮኮና። ‘ታ አይ ኦድና?’ ግድ ባ ኢታ ናጋራ ፓፀይ እሶይካ ባዋ። ኡባይ ኦላስ ጋላብያ ፓራዳ ባዉ ባዉ ዎፄስ። <verse eid="JER 8:6"/><verse number="7" style="v" sid="JER 8:7"/>ሀር አቶሽን፥ ሃ ካፎት ባንታ ዎድያ ኤሮሶና፤ ሆለት፥ ካሮትነ ማስቃላ ካፎት ባንታ ስምያ ዎድያ ናጎሶና፤ ሽን ታ አሳይ ጎዳ ዎጋ ኤሮኮና።<verse eid="JER 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 8:8"/>“ያትን ዋንድ፥ ‘ጎዳ ህገይ ኑራ ደእያ ግሾ ኑ ጭንጫ’ ጋናዉ ዳንዳኤቲ? ዎርዳንቾ ፃፈት ታ ህግያ ዎርዶ ከስዳይሳ በኤከቲ? <verse eid="JER 8:8"/><verse number="9" style="v" sid="JER 8:9"/>ጭንጫት ዬላታና፤ ኤንቲ ካዉያናነ ኦይከታና። ኤንቲ ጎዳ ቃላ እፅን፥ ኤንታዉ አይ ጭንጫተ ደኢ? <verse eid="JER 8:9"/><verse number="10" style="v" sid="JER 8:10"/>ሄሳ ግሾ፥ ታ ኤንታ ማቸታ ሀራታስ፥ ኤንታ ጎሻ አላጋ አሳስ እማና። ጉፈ ግታ ጋካናዉ በሶና ጎአስ ዪቀቶሶና። ናበትነ ካህነት ኡባይ አሳ ጭሞሶና። <verse eid="JER 8:10"/><verse number="11" style="v" sid="JER 8:11"/>ኤንቲ ታ አሳ ማዱን ላፋ ግድ፥ ጉ ለ ዎሶና። ሳሮይ ባይናሽን ‘ሳሮ፥ ሳሮ!’ ያጎሶና። <verse eid="JER 8:11"/><verse number="12" style="v" sid="JER 8:12"/>ሀ ሻትያ ኦሱዋ ኦሸ፥ ኤንቲ ዬላትዶና? አካይ፥ ኤንቲ አይኮካ ዬላትቦኮና። ኤንቲ ዬል አይበኮ ኤሮኮና። ሄሳ ግሾ፥ ኤንቲ ኩንድዳይሳታ ግዶን ኩንዳና፤ ኤንቲ ሴረትያ ዎደ ካዉያና። <verse eid="JER 8:12"/><verse number="13" style="v" sid="JER 8:13"/>ኤንታ ጎሻ አይፍያ ታ ኤንታፈ ኤካና። ኤንታ ዎይነ አይፈይ ያና፤ ባላሰ ም አይፈይ በንተና። እያ ቦንጮይ ሹላና፤ ታ ኤንታዉ እምዳባ ኤንታፈ ኤካና” ያጌስ ጎዳይ።<verse eid="JER 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 8:14"/>አሳይ ዛሪድ ሀይሳዳ ያጎሶና፦ “ኑ ስእ ግድ አይስ ኡታኔ? አነ ሺቅተ፤ ግምበትዳ ካታማታ ገልድ ያን ሀይቃና። ጎዳይ ኑ ፆሳይ ኑና ሀይቆስ አድ እሚስ። ኑ እያ ቦላ ናጋራ ኦዳ ግሾ፥ ኑ ዎያ ሃ ኡያና መላ ኦስ። <verse eid="JER 8:14"/><verse number="15" style="v" sid="JER 8:15"/>ሳሮተ ኡፋይሳን ናግዳ፤ ሽን ሎኦባይ ይቤና። ኑ ፓፆ አሞትዳ፤ ሽን ዳጋማ ግድስ። <verse eid="JER 8:15"/><verse number="16" style="v" sid="JER 8:16"/>ሞርከ ፓራ ጋርማሞይ ዳነ ካታማን ስኤቴስ፤ ኤንታ ኮርማ ፓራታ ጫገን ቢት ቃፄስ። ኤንቲ ቢታነ ቢታን ደእያባ ኡባ፥ ካታማነ ካታማን ደእያ አሰ ኡባ ምድ ይሳናዉ ይዶሶና። <verse eid="JER 8:16"/><verse number="17" style="v" sid="JER 8:17"/>ታኒ ሾሻታ ህንተ ግዶ የዳና። ብት ተቃናዉ ዳንዳኦና ሀሶ ሾሻታ ህንተ ግዶ የዳና፤ ኤንቲ ህንተና ዱካና” ያጌስ ጎዳይ።<verse eid="JER 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 8:18"/>ታ አዛኑዋስ ምንይ ባዋ፤ ታ ዎዛናይ ትልእስ። <verse eid="JER 8:18"/><verse number="19" style="v" sid="JER 8:19"/>ታ አሳይ ሃሆ ቢታን ዋስያ ዋሱዋ ስእተ። ኤንቲ፥ “ጎዳይ ፅዮነን ባዌ? ሀ ፅዮነ ካዎይ ዛሪድ ያን ዴኔ?” ያግድ ዋሶሶና።</para>
  <para style="p" vid="JER 8:19">ጎዳይ ኤንታ ካዎይ፥ “ኤንቲ ባንታ መዳ ምስለታን፥ ባንታ ፓና አላጋ ኤቃታን ታና አይስ ይሎይዶና?” ያግስ።<verse eid="JER 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 8:20"/>አሳይ ዛሪድ፥ “ሄኮ ጫካ ዎደይ አስ፤ ቦነይ ዉርስ፤ ኑኒ አትቦኮ” ያግድ ዋሶሶና።<verse eid="JER 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 8:21"/>ታ አሳይ ማዱንፅዳ ግሾ፥ ታ ዎዛናይካ ማዱንፅስ። ታ ካዮታስ፤ ያሽ ታና ኦይክስ። <verse eid="JER 8:21"/><verse number="22" style="v" sid="JER 8:22"/>ጋላዳን ትየትያ ለይ ባዌ? ያን አክመይ ዴኔ? ያትን፥ ታ አሳ መቆይ አይስ ፓፀኔ?<verse eid="JER 8:22"/></para>
  <chapter eid="JER 8"/>
  <chapter number="9" style="c" sid="JER 9"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 9:1"/>ሀይቅዳ ታ አሳስ ቃማነ ጋላስ ዬካና መላ ታ ሁጰይ ሃ ኦላ፥ ታ አይፈይ ፑልቶ ሃ ግዴረነ። <verse eid="JER 9:1"/><verse number="2" style="v" sid="JER 9:2"/>ኤንቲ ኡባይ ማካላነ ላይማትያ አስ ግድያ ግሾ፥ ታኒ ታ አሳፐ ሻከታዳ ባና መላ፥ ኦገ አስ አቅያ በሲ፥ ታዉ መላ ቢታን ደኤረነሽን።<verse eid="JER 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 9:3"/>“ኤንቲ ባንታ እንፃርሳን ዎርዶ ኦደታናዉ ኡባ ዎደ ጊግድ ደኦሶና። ኤንታ ቢታን ቱማ ግዶናሽን ዎርዶይ ካዎትስ። ኤንቲ እስ ናጋራፐ ሀራ ናጋራን ፕንዶሶና፤ ታና ኤሮኮና” ያጌስ ጎዳይ።<verse eid="JER 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 9:4"/>“እሽ ጭመይሳ፥ ሾሮይ ዝግረይሳ ግድያ ግሾ ሾሩዋፐ ናገቶ፤ እሻይ እሻ አማነቶፎ። <verse eid="JER 9:4"/><verse number="5" style="v" sid="JER 9:5"/>ሾሮይ ሾሩዋ ጭሜስ፤ ቱማ ኦደተይ ዴና። ዎርዶ ኦደታና መላ ባንታ እንፃርሳ ታማርስዶሶና፤ ናጋራ ኦሶን ባንታና ዳቡርስዶሶና። <verse eid="JER 9:5"/><verse number="6" style="v" sid="JER 9:6"/>ነ ጭሞ ግዶን ደኣሳ፤ ኤንቲ ባንታ ጭሙዋን ታና ኤሮና እፅዶሶና” ያጌስ ጎዳይ።<verse eid="JER 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 9:7"/>“ሄሳ ግሾ፥ ታ ኤንታ ብራታዳ ሴርሳና፤ ኤንታ ፓጫና። ታ አሳ ግሾ፥ ታ ሀራባ አይ ኦናዉ ዳንዳእያና? <verse eid="JER 9:7"/><verse number="8" style="v" sid="JER 9:8"/>ኤንታ እንፃርሳይ ዎያ ዶንገ ቶራ መላ፤ ኤንቲ ጭሞን ሃሳዮሶና። ባንታ ዶናን እሶይ እሱዋራ ሳሮ ቃላ ሃሳዮሶና፤ ሽን ባንታ ዎዛናን ፅሄ ዎሶና። <verse eid="JER 9:8"/><verse number="9" style="v" sid="JER 9:9"/>ያትን፥ ታ ሀ ሀኖታስ ኤንታ ሴራናዉ በሰኔ? ታኒ ሀይሳ መላ ካዎተ ቦላ ሀሎ ከያናዉ በሰኔ?” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 9:10"/>ታኒ ቃ ደረታስ ዬካና፤ ኤንታ ግሾ ዋሳና፤ ባዞን ደእያ ሄን ጋደታስ ዘሌላና። ኤንቲ ይዶሶና፤ ያራ እስ አስካ አና። መሄ ዋሶይ ስኤተና፤ ሳሎ ካፎትነ ዶአት ባቃትዶሶና።<verse eid="JER 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 9:11"/>“የሩሳላመ ካታማ ላለትዳ ኬላነ ዎርካናት ጉፕያ በሲ ኦና። ይሁዳ ካታማታ ኦንካ ዶና ባይሳ ከሳና” ያጌስ ጎዳይ።<verse eid="JER 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 9:12"/>ሀይሳ አኬካናዉ ዳንዳእያ ጭንጫ አስ ኦኔ? ሀራ አሳስ ኦዳና መላ ጎዳይ ኦደስ ቆንጭስዴ? እስ አስካ እያ ግዶራ አና መላ ቢታይ ኢትድ ባዞዳ ኦንዳይ አይብሴ?<verse eid="JER 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 9:13"/>“ሀይስ ሀንዳይ፥ ኤንታዉ ታ እምዳ ህግያ ኤንቲ አግዳ ግሾሳ። ኤንቲ ታዉ ኪተቶናነ ሀ ህግያ ካሎና እፅዳ ግሾሳ። <verse eid="JER 9:13"/><verse number="14" style="v" sid="JER 9:14"/>ሄሳ አግድ፥ ኤንቲ ባንታ ዎዛና ሙመተ ካልዶሶና፤ ኤንታ አዋት ታማርስዳ ባኣለ ጌተትያ ኤቃ ጎይንዶሶና” ያጌስ ጎዳይ።<verse eid="JER 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 9:15"/>ሄሳ ግሾ፥ ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ “ታኒ ሀ አሳ ጫምያ ካ ሙዛና፤ ዎያ ሃ ኡሻና። <verse eid="JER 9:15"/><verse number="16" style="v" sid="JER 9:16"/>ኤንቲ ዎይኮ ኤንታ አዋት ኤሮና ካዎተታ ግዶን ታ ኤንታ ላላና። ኤንታ ይሳና ጋካናዉ ማሻን የደና” ያጌስ።<verse eid="JER 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 9:17"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፦ “አነ ቆፕተ። ዬሆ ዬክያ ማጫሳታ ፄግተ፤ ዘለልስ ኤርያ አሳታ ኤህተ። <verse eid="JER 9:17"/><verse number="18" style="v" sid="JER 9:18"/>ኤንቲ ኤለስድ ይድ፥ ኑ አይፈይ አፉ ሆል ኦና ጋካናዉነ ኑ አይፍያ ጭሮይ ሃ ፑልታና ጋካናዉ ዘለልስ ከሶ። <verse eid="JER 9:18"/><verse number="19" style="v" sid="JER 9:19"/>ፅዮነን ዘለልሳ ግርስ ስኤቴስ፤ ‘ኑ ይዳ! ኑ ካዉይዳ! ኑ ኬይ ላለትዳ ግሾ፥ ኑ ቢታ አግድ ባናዉ ኮሼስ’ ” ያጎሶና።<verse eid="JER 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 9:20"/>ህንተኖ፥ ማጫሳቶ፥ ጎዳ ቃላ ስእተ! ህንተ ሀይይ እያ ዶናፐ ከይያ ቃላ ሀይዞ። ህንተ ማጫ ናይታ ዘለልስ ታማርስተ፤ እሶይ እሱዋ ዬሆ ታማርሶ። <verse eid="JER 9:20"/><verse number="21" style="v" sid="JER 9:21"/>ሀይቆይ ዮጋ ናይታ ኦገን፥ ናአተታ ዳባባን ቄፅሸ ይድ፥ ኑ ማስኮተታ ጋክስ፤ ኑ ሚፃ ገልስ።<verse eid="JER 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 9:22"/>“አሳ አህ ቡረዳ ደንባን የገታና፤ ጫከይሳት ጫክድ ጉየ የግዳ ካ መላ ኤንታ ኦንካ ሺሸና” ያጌስ ጎዳይ።<verse eid="JER 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 9:23"/>“ጭንጭ ባ ጭንጫተን ጬቆፎ፤ ዎልቃም ባ ዎልቃን ጬቆፎ፤ ዱረይ ባ ዱረተን ጬቆፎ። <verse eid="JER 9:23"/><verse number="24" style="v" sid="JER 9:24"/>ሽን ጬቅያ ኦንካ ታና ኤሮንነ አኬኮን ጬቆ። ማሮተ፥ ሱረ ፕርዳነ ፅሎተ ሳአ ቦላ ኦያ ጎዳ፥ ታና ኤርድ ጬቆ፤ ሄስ ታና ኡፋይሴስ” ያጌስ ጎዳይ።<verse eid="JER 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 9:25"/>“ባንታ አሾ ፃላላ ቃፃረትዳ አሳ ታ ሴራና ዎደይ ያና። <verse eid="JER 9:25"/><verse number="26" style="v" sid="JER 9:26"/>ሄሳትካ ግብፀ፥ ይሁዳ፥ ኤዶመ፥ አሞነነ ሞአበ አሳነ ባንታ ሁጵያ ዩሹዋ ሜድድ፥ መላ ቢታን ደእያ አሳ ኡባ። ሀ ካዎተት ኡባይ ቱማ ቃፃረትቦኮና፤ እስራኤለ አሳ ኡባይካ ባንታ ዎዛናን ቃፃረትቦኮና” ያጌስ ጎዳይ።<verse eid="JER 9:26"/></para>
  <chapter eid="JER 9"/>
  <chapter number="10" style="c" sid="JER 10"/>
  <para style="s1">ቱማ ፆስነ ኤቃታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 10:1"/>ህንተኖ፥ እስራኤለ አሳዉ፥ ጎዳይ ኦድያ ቃላ ስእተ! <verse eid="JER 10:1"/><verse number="2" style="v" sid="JER 10:2"/>ጎዳይ ሀይሳዳ ያጌስ፦ “ሀራ ካዎተታ ኦግያ ታማሮፕተ። ኤንቲ ሳሎ ቦላ ማላታ በእድ ዳጋምኮካ፥ ህንተ ዳጋሞፕተ። <verse eid="JER 10:2"/><verse number="3" style="v" sid="JER 10:3"/>ኤንታ ዎጋይ ሀዳ፤ ኤንቲ ዎራፐ ም ቃንፆሶና፤ ማሰይስ ካልታን ማሴስ። <verse eid="JER 10:3"/><verse number="4" style="v" sid="JER 10:4"/>ኤንቲ ብራንነ ዎርቃን አሌቅሶሶና፤ ቃፆናዳ ምስማረን ሽድ ኦይሶና። <verse eid="JER 10:4"/><verse number="5" style="v" sid="JER 10:5"/>ኤንታ ኤቃት ሌሄ ግዶን ካፎ ዳጋንናዉ ኤስያ ማላ መላ። ኤንቲ ኦደቶኮና፤ ኤንቲ ሄመታናዉ ዳንዳኦና ግሾ አሳይ ኤንታ ቶኮሶና። ኤንታስ ኩም ያዮፍተ። ኤንቲ ቆሀናዉካ ማዳናዉካ ዳንዳኦና ግሾ ኤንታዉ ያዮፍተ” ያጌስ ጎዳይ።<verse eid="JER 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 10:6"/>አቤት ጎዳዉ፥ ነ ማል ኦንካ ባዋ። ኔኒ ግታ፤ ነ ሱንይካ ግታነ ዎልቃማ። <verse eid="JER 10:6"/><verse number="7" style="v" sid="JER 10:7"/>አቤት ካዎተታ ካዋዉ፥ ነና ቦንቾናይ ኦኔ? ጭንጫ አሳ ግዶንነ ኤንታ ካዎተ ግዶን ነ መል ባይና ግሾ ነዉ ቦንቾ በሴስ። <verse eid="JER 10:7"/><verse number="8" style="v" sid="JER 10:8"/>ኤንቲ ኤያነ ኤር ይዳይሳታ፤ ኤንቲ ምፈ ማስዳ፥ ፓና ኤቃታፐ አይ ታማሮና? <verse eid="JER 10:8"/><verse number="9" style="v" sid="JER 10:9"/>ሄ ኤቃት ታርሰሳ ብራንነ አፌዛ ዎርቃን አሌቀትዶሶና። ኤንቲ ኡባይ ኩሸ ሂላንቾታን ኦሰትዳ ዎይነነ ካሎሰ ዳንያ ማኡዋን ካመትዶሶና። <verse eid="JER 10:9"/><verse number="10" style="v" sid="JER 10:10"/>ሽን ጎዳይ ቱማ ፆሳ፤ እ ደኦ ፆሳነ መርና ካዋ። እያ ሀንቁዋን ቢታይ ቃፄስ፤ ካዎተት እያ ይሉዋ ዳንዳኦኮና።<verse eid="JER 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 10:11"/>“ሀይሳቲ ሳሎነ ሳአ መቦና ፆሳት ሳአፐነ ሳሎፐ ያና” ያጋዳ ኔኒ ኤንታዉ ኦዳ።<verse eid="JER 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 10:12"/>ባ ዎልቃን ሳኣ መዳይ፥</para>
  <para style="q2" vid="JER 10:12">ባ ጭንጫተን ሳኣ ኤስዳይ፥</para>
  <para style="q2" vid="JER 10:12">ባ አኬካን ሳሎታ ምጭዳይ፥ ፆሳ።<verse eid="JER 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 10:13"/>እ፥ ባ ኮሽንቻ ስስያ ዎደ፥</para>
  <para style="q2" vid="JER 10:13">ሳሎን ደእያ ሃት ጉሞሶና።</para>
  <para style="q1" vid="JER 10:13">እ ሻራ ሳአ ጋፃፐ ፑደ ደንስ፤</para>
  <para style="q2" vid="JER 10:13">ዎልአን እራራ የዴስ፤</para>
  <para style="q2" vid="JER 10:13">ጫርኩዋ ባ ምንጃ ኬፈ ከሴስ።<verse eid="JER 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 10:14"/>አስ ኡባይ ኤራ ይድ ኤይስ፤</para>
  <para style="q2" vid="JER 10:14">ዎርቃ ሼሽያ ኡባይ ባ ኤቃን ዬላትስ።</para>
  <para style="q1" vid="JER 10:14">ኤንቲ መዳ ኤቃት ዎርዶ፤</para>
  <para style="q2" vid="JER 10:14">ኤንታዉ ሸምፖይ ባዋ።<verse eid="JER 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 10:15"/>ኤንቲ ፓናባነ ሀዳ፤</para>
  <para style="q2" vid="JER 10:15">ኤንቲ ሴረትያ ዎደ ያና።<verse eid="JER 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 10:16"/>ሽን እ ኡባ መዳ ግሾ፥</para>
  <para style="q2" vid="JER 10:16">ያይቆባ ሳማ ግድዳ ፆሳይ</para>
  <para style="q2" vid="JER 10:16">ሄሳ መላ ግደና፤</para>
  <para style="q2" vid="JER 10:16">እስራኤለይ፥ እ ባዉ ዶርዳ ካዎተ፤</para>
  <para style="q2" vid="JER 10:16">እያ ሱንይ ኡባፈ ዎልቃማ ጎዳ።<verse eid="JER 10:16"/></para>
  <para style="s1">ያና ዮ</para>
  <para style="p">
    <verse number="17" style="v" sid="JER 10:17"/>ህንተኖ፥ ሞርከይ ተቅዳይሳቶ፥ ቢታፈ ከያናዉ ህንተዉ ደእያባ ሺሽተ። <verse eid="JER 10:17"/><verse number="18" style="v" sid="JER 10:18"/>“ታኒ፥ ሀ ዎድያን፥ ሀ ቢታን ደእያ አሳ ከሳዳ ያምባራና። ኤንታ ቆሆይ ኤረታና ጋካናዉ ኤንታ ቦላ ኢታባ ኤሀና” ያጌስ ጎዳይ።<verse eid="JER 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 10:19"/>ታ ማዱንፃስ! ታ ማዱንይ ፓፀና። ሽን ታኒ፥ “ሀይስ ታ ሀርገ፤ ታ ዳንዳአናዉ በሴስ” ያጋስ።<verse eid="JER 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 10:20"/>ታ ዱንካነይ ላለትስ፤ እያ ዎዶሮ ኡባይ ዱፀረትስ። ታ ናይት ኡባይ ታፐ ሻከትድ ብዶሶና፤ ኤንቲ ባዋ። ታ ዱንካንያ ዛሪድ ቶካናዉ ዎይኮ ታ ማጋራጁዋ ካቃናዉ እስ አስካ አትቤና።<verse eid="JER 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 10:21"/>ሄንንቾት ኤይዶሶና፤ ኤንቲ ጎዳ ኦይችቦኮና። ሄሳ ግሾ፥ ኤንታዉ እንጀቶና እፅስ፤ ኤንታ ዉደ ኡባይ ላለትስ። <verse eid="JER 10:21"/><verse number="22" style="v" sid="JER 10:22"/>ኦራ ኦድ ይስ፤ ስእተ። ፑደሀ ባጋን ደእያ ካዎተን ግታ ድርጎይ መትስ። እያ ኦላንቾት ይድ፥ ይሁዳ ካታማታ ባይሳነ ዎርካናት ጉፕያ በሲ ከሳና።<verse eid="JER 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 10:23"/>አቤት ጎዳዉ፥ አሳ ደኦይ እያዉ ቡዞ ግዶናይሳነ ባ ኦግያ ሱርሳናዉ እያ ሸነ ግዶናይሳ ታ ኤራይስ። <verse eid="JER 10:23"/><verse number="24" style="v" sid="JER 10:24"/>አቤት ጎዳዉ፥ ታና ሴራ፤ ሽን ልከራ ግዶ። ታ ዮና መላ ነ ሀንቁዋን ታ ቦላ ዮፓ። <verse eid="JER 10:24"/><verse number="25" style="v" sid="JER 10:25"/>ነ ሸንያ፥ ነና ኤሮና ካዎተታ ቦላነ ነ ሱን ፄጎና አሳ ቦላ ጉሳ። ኤንቲ ያይቆባ አሳ ምዶሶና፤ ኤንታ ምትዶሶና፤ ኤንታ ቢታ ይስዶሶና።<verse eid="JER 10:25"/></para>
  <chapter eid="JER 10"/>
  <chapter number="11" style="c" sid="JER 11"/>
  <para style="s1">ናገትቦና ጫቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 11:1"/>ጎዳፐ ኤርምያሳኮ ይዳ ቃላይ ሀይሳ፦ <verse eid="JER 11:1"/><verse number="2" style="v" sid="JER 11:2"/>“ሀ ጫቆ ቃላ ስአዳ ይሁዳ አሳስነ የሩሳላመ ካታማን ደእያ አሳስ ኦዳ። <verse eid="JER 11:2"/><verse number="3" style="v" sid="JER 11:3"/>ጎዳይ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ ጋዳ ኦዳ። ‘ሀ ጫቁዋ ናጎና አስ ኦንካ ባደትዳይሳ ግዶ’። <verse eid="JER 11:3"/><verse number="4" style="v" sid="JER 11:4"/>ታኒ ካሰ ህንተ አዋታ ግብፀ ቢታፈ፥ ብራታ ሴርስያ ጮጭያፐ ከስያ ዎደ፥ ‘ታዉ ኪተትተ፤ ታ ህንተና ኪትያባ ኡባ ኦተ። ህንተ ታ አሰ ግዳና፤ ታካ ህንተ ፆሰ ግዳና’ ያጋዳ ኦዳስ። <verse eid="JER 11:4"/><verse number="5" style="v" sid="JER 11:5"/>ሄሳዳካ፥ ማነ ኤስ ጎግያ ቢታ ካሰ ህንተ አዋታስ እማናዉ፥ ታኒ ጫቅዳ ጫቁዋ ፖላና።”</para>
  <para style="p" vid="JER 11:5">ታኒ፥ “ኤሮ፥ ጎዳዉ፥ አምንእ” ያጋስ።<verse eid="JER 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 11:6"/>ጎዳይ ታኮ፥ “ሀ ቃላታ ኡባ ይሁዳ ካታማታንነ የሩሳላመ ኦገታን ሀይሳዳ ያጋዳ አዋጃ፦ ‘ሀ ጫቆ ቃላ ስእተ፤ እያ ካልተ። <verse eid="JER 11:6"/><verse number="7" style="v" sid="JER 11:7"/>ካሰ ህንተ አዋታ ታ ግብፀ ቢታፈ ከስዳ ዎድያፐ ሀች ጋካናዉ፥ ዛራ ዛራዳ፥ “ታዉ ኪተትተ” ጋዳ ሴራስ። <verse eid="JER 11:7"/><verse number="8" style="v" sid="JER 11:8"/>ሽን ኤንቲ ታ ቃላ ስእቦኮና ዎይኮ ታዉ ኪተትቦኮና። ኤንቲ ባንታ ኢታ ዎዛና ካልዶሶና። ታ ጫቆ ቃላ ኤንቲ ናጋና መላ ኪታስ፤ ሽን ኤንቲ እፅዶሶና። ሄሳ ግሾ፥ ሄ ጫቁዋ ባደ ኡባ ኤንታ ቦላ ኤሀስ’ ” ያግስ።<verse eid="JER 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 11:9"/>ዛርድካ ጎዳይ ታኮ ሀይሳዳ ያግስ፦ “ይሁዳ አሳይነ የሩሳላመን ደእያ አሳይ ታ ቦላ ማቀትዶሶና። <verse eid="JER 11:9"/><verse number="10" style="v" sid="JER 11:10"/>ኤንቲ ካሰ ታ ቃላ ስኦና እፅዳ ባንታ ማይዛታ ናጋራኮ ጉየ ስምዶሶና። ኤንቲ ሀራ ፆሳታ ጎይንዶሶና፤ ኤንታዉ ኦዶሶና። እስራኤለ አሳይነ ይሁዳ አሳይ ታ ካሰ ኤንታ ማይዛታራ ጫቅዳ ጫቁዋ መንዶሶና። <verse eid="JER 11:10"/><verse number="11" style="v" sid="JER 11:11"/>ሄሳ ግሾ፥ ‘ኤንቲ ባቃትድ አታናዉ ዳንዳኦና መቱዋ ኤንታ ቦላ ኤሀና። ኤንቲ ታኮ ዋስንካ ታ ኤንታ ስእከ። <verse eid="JER 11:11"/><verse number="12" style="v" sid="JER 11:12"/>ሄ ዎደ ይሁዳ አሳይነ የሩሳላመ አሳይ፥ እፃነ ጩይስያ ባንታ ፆሳታኮ ዋሳና። ሽን መቶ ዎደ ሄ ፆሳት ኤንታ ማዶኮና። <verse eid="JER 11:12"/><verse number="13" style="v" sid="JER 11:13"/>ህንተኖ፥ ይሁዳ አሳዉ፥ ህንተ ፆሳት ህንተ ካታማታ መላ ዳሮ። ቃስ ባኣለ ጌተትያ ዬላያ ፆሳስ እፃነ ጩይሳናዉ ህንተ ጊግስያ ያርሾ በሳት የሩሳላመ ኦገታ መላ ዳሮ’ ያጌስ ጎዳይ።<verse eid="JER 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 11:14"/>“ኤርምያሳ፥ ሀ አሳስ ታና አይኮካ ዎሶፋ፤ ኤንታ ግሾ ጋናቶፓ ዎይኮ ኦይቾፋ። ኤንቲ ባንታ መቱዋ ጋላስ ታና ፄግያ ዎደ ታ ኤንታ ስእከ።<verse eid="JER 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 11:15"/>“ዳሮ አሳራ ባ ኢታ ማቁዋ ማቀታሸ፥ ታ ዶስያ ታ አሳይ፥ ታ ኬን በንታናዉ በሲ? ህንተ ህንተ ኢታ ኦሱዋ ኦሽን፥ ያርሸትዳ መህያ አሾይ ህንተና ሴራፐ አሻኔ? ሄሳ ግድያኮ ህንተ ኡፋይታናሽን” ያግስ።<verse eid="JER 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 11:16"/>ጎዳይ ነና፥ ድጭያ፥ ሎኦ አይፈ አይፍያ ሻማሆ ያግድ ሱንስ። ሽን፥ እ ሄ ሻማሁዋ ዎልቃማ ዳዳ ጉንን፥ ታማን ፁጋና፤ እያ ታሸይካ መቃና።<verse eid="JER 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 11:17"/>ታኒ፥ ህንተና ቶክዳ ኡባፈ ዎልቃማ ጎዳይ፥ ህንተ ቦላ ኢታባ ኤሀናዉ አዋጃስ። እስራኤለ አሳይነ ይሁዳ አሳይ ባኣለስ እፃነ ጩይስድ ታና ይሎይዶሶና።<verse eid="JER 11:17"/></para>
  <para style="s1">ኤርምያሳ ቦላ ማቀትዳ ማቁዋ</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 11:18"/>ጎዳይ ኤንታ ማቁዋ ታዉ ቆንጭስዳ ግሾ ታ ኤራስ። ሄ ዎደ ኤንቲ ኦያ ኢታ ኦሱዋ ታና በስስ። <verse eid="JER 11:18"/><verse number="19" style="v" sid="JER 11:19"/>ታኒ ሹካስ ጊግዳ ዶርሳዳ ሀናስ። ኤንቲ፥ “አነ ምነ እያ አይፍያ ይሶስ። እያ ሱንይ ሀሳየቶና መላ እያ ፓፃ ደኤይሳታ ግዶፈ ሾድድ ድጎስ” ያግድ ማቀትዳይሳ ታ ኤራብከ። <verse eid="JER 11:19"/><verse number="20" style="v" sid="JER 11:20"/>ሽን አቤት ኡባፈ ዎልቃማ ጎዳዉ፥ ፅሎ ፕርደይሶ፥ አሳ ዎዛናነ ቆፋ ሻካዳ ኤረይሶ፥ ነ ኤንታ ቦላ ነ ሃሉዋ ከያዳ ታና በሳ። ታኒ ታ ቆሁዋ ነና በሳስ።<verse eid="JER 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 11:21"/>ሄሳ ግሾ፥ “ጎዳ ሱንን ትንብተ ኦዶፓ ኢኮ ነ ኑ ኮሸን ሃይቃና” ያግድ፥ ነና ዎናው ኮይያ አናቶታ አሳባ ጎዳይ ሀይሳዳ ያጌስ። <verse eid="JER 11:21"/><verse number="22" style="v" sid="JER 11:22"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፦ “ታ ኤንታ ሴራና፤ ኤንታ ፓንት ማሻን ሀይቃና፤ ኤንታ ማጫ ናይትነ አደ ናይት ኮሻን ሀይቃና፤ <verse eid="JER 11:22"/><verse number="23" style="v" sid="JER 11:23"/>ኤንታፈ እሶይነ አተና። አይስ ጊኮ፥ ታኒ ሴርያ ላይ አናቶታ አሳ ቦላ ኢታባ ኤሀና” ያጌስ።<verse eid="JER 11:23"/></para>
  <chapter eid="JER 11"/>
  <chapter number="12" style="c" sid="JER 12"/>
  <para style="s1">ኤርምያሳ ኦይሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 12:1"/>አቤት ጎዳዉ፥ ታ ኔራ ሞተትያ ዎደ ኡባንካ ነ ፅሎ። ግዶሽን፥ ነ ፅሎ ፕርዳባ ኔራ ኦደታናዉ ኮያይስ። ኢታ አሳት ኦያባይ ኤንታዉ አይስ እንጀቲ? ገነ አሳት አይስ ዱረትድ ደኦና? <verse eid="JER 12:1"/><verse number="2" style="v" sid="JER 12:2"/>ኔኒ ኤንታ ቶካዳሳ፤ ኤንቲ ፃጶ የድዶሶና፤ ድጭድ አይፈ አይፍዶሶና። ኤንቲ ነና ዶናፐ የጎኮና፤ ሽን ኤንታ ዎዛናፐ ነ ሃሆን ደኣሳ። <verse eid="JER 12:2"/><verse number="3" style="v" sid="JER 12:3"/>ሽን አቤት ጎዳዉ፥ ነ ታና ኤራሳ፤ ታና በኣሳ፤ ታ ነባ አይ ቆፕያኮ ፓጫሳ። ሹካ ዶርሳዳ፥ ሄ ኢታ አሳታ ጎቻዳ ከሳ፤ ሹካ ጋላሳስ ኤንታ ዱማያዳ ዎ። <verse eid="JER 12:3"/><verse number="4" style="v" sid="JER 12:4"/>ቢታይ እራ ይድ ቆሄታናይ፥ ደንባን ደእያ ማታይ መላናይ አዉደ ጋካናሴ? አሳ ኢታተ ጋሶን፥ ዶእነ ካፎይ ዉርስ። አሳይ ቃስ፥ “ጎዳይ ኑ ኦያባ ደመና” ያጎሶና።<verse eid="JER 12:4"/></para>
  <para style="s1">ጎዳ ዛሩዋ</para>
  <para style="p">
    <verse number="5" style="v" sid="JER 12:5"/>ጎዳይ ኤርምያሳኮ፥ “ኔኒ ቶሆን ዎፅያ አሳታራ ጋደታዳ ዳቡርኮ፥ ፓራራ ዋናዳ ጋደታኔ? ነ ሳሮ ቢታን በትኮ፥ ዮርዳኖሰ ዎራ ግዶራ ዋናዳ ሄመታኔ? <verse eid="JER 12:5"/><verse number="6" style="v" sid="JER 12:6"/>ነ እሻት፥ ህንተ ሶ አሳት ነና አድ እምዶሶና፤ ነ ቦላ ደንድዶሶና። ሄሳ ግሾ፥ ሎኦባ ኦድኮካ ኤንታ አማኖፓ።<verse eid="JER 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 12:7"/>“ታ እስራኤለ አጋስ፤ ታ ዶረትዳ ካዎተ የጋስ፤ ታ ሲቅያ አሳ እያ ሞርከታ ኩሸን አዳ እማስ። <verse eid="JER 12:7"/><verse number="8" style="v" sid="JER 12:8"/>ታ ዶርዳ አሳይ ታዉ ዎራን ደእያ ጋሞ መላ ግድስ። እ ታ ቦላ ጉድስ፤ ሄሳ ግሾ ታ እያ እፃስ። <verse eid="JER 12:8"/><verse number="9" style="v" sid="JER 12:9"/>ታ ዶርዳ አሳይ ኡባ ባጋራ ጵርጮይ ተቅዳ ካፎ መላ ግድዶሶና። ብድ ዶአታ ኡባ ሺሽድ እያ ማና መላ ኤህተ።<verse eid="JER 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 12:10"/>“ዳሮ አላጋ ካዎት ታ ዎይነ ጋድያ ኢስዶሶና፤ ታ ጋድያ የዶሶና፤ ታ ሎኦ ጎሻ ባይሳ ከስዶሶና። <verse eid="JER 12:10"/><verse number="11" style="v" sid="JER 12:11"/>ሄ ቢታይ ኢትድ ኦፅስ፤ ታ ስንን መላነ ባይሳ ግድስ። ቃተይ ባይና ግሾ ቢታይ ኩመ ኢትስ። <verse eid="JER 12:11"/><verse number="12" style="v" sid="JER 12:12"/>መላ ቢታን ደእያ አይኮካ ባይና ደረ ካንድ፥ ቦንቀይሳት ይዶሶና። ጎዳ ማሻይ ቢታ ሀ ጋፃፐ ያ ጋፃ ጋካናዉ ምስ። ሄሳ ግሾ፥ ኦንካ ሳሮ አታናዉ ዳንዳኤና። <verse eid="JER 12:12"/><verse number="13" style="v" sid="JER 12:13"/>ኤንቲ ግስተ ዘርድ፥ አጉን ጫክዶሶና፤ ኤንቲ ዳሮ ዳቡርዶሶና፤ ሽን አይኮካ ደምቦኮና። ጎዳ ዎልቃማ ሸንያ ጋሶን ኤንታ ካይ ይስ” ያግስ።<verse eid="JER 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 12:14"/>“ታኒ ታ አሳ፥ እስራኤለስ፥ እምዳ ቢታ ኦይክዳ፥ ኢታ ሾሮ ካዎተታ ኤንታ ቢታፈ ሾዳና። ቃስ ይሁዳ አሳ ኤንታ ግዶፈ ከሳና። <verse eid="JER 12:14"/><verse number="15" style="v" sid="JER 12:15"/>ሽን ኤንታ ቢታፈ ሾድዳፐ ጉየ፥ ዛራዳ ኤንታዉ ቃታና። ኤንታ እሱዋ ኤንታ ላታ ቢታነ ኤንታ ካዎተ ዛራዳ ኤሀና። <verse eid="JER 12:15"/><verse number="16" style="v" sid="JER 12:16"/>ካሰ ታ አሳ ባኣለ ሱንን ጫቃና መላ ታማርስዳይሳዳ ኤንቲ ታ አሳ ኦግያ ታማርኮነ ታ ሱንን ጫቅኮ ኤንቲ ታ አሳ ግዶን ምንድ ዳና። <verse eid="JER 12:16"/><verse number="17" style="v" sid="JER 12:17"/>ሽን ኪተቶና እፅዳ ካዎተታ ታኒ ፖሎ ሾዳዳ ይ-ሳና” ያጌስ ጎዳይ።<verse eid="JER 12:17"/></para>
  <chapter eid="JER 12"/>
  <chapter number="13" style="c" sid="JER 13"/>
  <para style="s1">ሊኖ ዳንጮ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 13:1"/>ጎዳይ ታኮ፥ “ባዳ ሊኖ ቃጭናፐ ዳደትዳ ዳንጮ ሻማዳ፥ ነ ፄሳን ዳንጫ፤ ሽን ሃን ቦሽሶፓ” ያግስ። <verse eid="JER 13:1"/><verse number="2" style="v" sid="JER 13:2"/>ሄሳ ግሾ፥ ታኒ ጎዳይ ኪትዳይሳዳ ዳንጩዋ ሻማዳ ታ ፄሳን ዳንጫስ።<verse eid="JER 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 13:3"/>ጎዳይ ናምአን ታኮ ሀይሳዳ ያግስ፦ <verse eid="JER 13:3"/><verse number="4" style="v" sid="JER 13:4"/>“ነ ሻማዳ ዳንጭዳ ዳንጩዋ ኤካዳ፥ ኤፍራፂሳ ሻፋ ባዳ ሹቻ ቆጶን ቆሳ” ያግስ። <verse eid="JER 13:4"/><verse number="5" style="v" sid="JER 13:5"/>ጎዳይ ታዉ ኦድዳይሳዳ ኤፋዳ፥ ኤፍራፂሳ ሻፋ ላንቀን ቆሳስ።<verse eid="JER 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 13:6"/>ዳሮ ጋላሳፐ ጉየ ጎዳይ፥ “ኤፍራፂሳ ሻፋ ባዳ፥ ታ ነና፥ ‘ያን ቆሳ’ ግዳ ዳንጩዋ ኤካ” ያግስ። <verse eid="JER 13:6"/><verse number="7" style="v" sid="JER 13:7"/>ታኒ ኤፍራፂሳ ሻፋ ባዳ፥ ዳንጩዋ ሞግዳ በሳፈ ኤካስ። ሽን ሄ ዳንጮይ ኢትድ አይኮካ ማዶናባ ግድስ።<verse eid="JER 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 13:8"/>ሄሳፈ ጉየ፥ ጎዳ ቃላይ ታኮ፥ <verse eid="JER 13:8"/><verse number="9" style="v" sid="JER 13:9"/>“ታኒ ይሁዳ ጬቀተነ የሩሳላመ ኦቶሩዋ ሀይሳዳ ኦዳ ይሳና። <verse eid="JER 13:9"/><verse number="10" style="v" sid="JER 13:10"/>ታ ቃላ ስኦና እፅድ፥ ባንታ ዎዛና ሙምስድ፥ ሀራ ፆሳታ ጎይናናዉነ ኤንታዉ ኦናዉ ብያ ሀ ኢታ አሳት፥ ሀ ዳንጩዋዳ ማዶናባ ግዳና። <verse eid="JER 13:10"/><verse number="11" style="v" sid="JER 13:11"/>ዳንጮይ አሳ ፄስ ባቅድ ኦይከይሳዳ ይሁድነ እስራኤለይ ታራ ኦይከትድ፥ ታ ሱንስ ጋላታነ ቦንቾ ግዳና መላነ ታ አሰ ግዳና መላ ኦስ፤ ሽን ኤንቲ ስኦና እፅዶሶና” ያጌስ ጎዳይ።<verse eid="JER 13:11"/></para>
  <para style="s1">ዎይነ ፁጋ</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 13:12"/>ጎዳይ ታኮ፥ “ጎዳይ እስራኤለ ፆሳይ፥ ሀይሳዳ ያጌስ ጋዳ ኦዳ ያግስ፦ ‘እስ እስ ፁጋይ ዎይነ ኡሻን ኩማና’ ያጋ። ኤንቲ ኔኮ፥ ‘ኑኒ እስ እስ ፁጋይ ዎይነን ኩማናይሳ ኤሮኮዬ?’ ያግኮ፥ <verse eid="JER 13:12"/><verse number="13" style="v" sid="JER 13:13"/>ነ ኤንታኮ፥ ‘ታኒ ሀ ቢታን ደእያ አሳ ኡባ፥ ሀር አቶሽን፥ ዳዊታ አራታን ኡትያ ካዎታ፥ ካህነታ፥ ናበታነ የሩሳላመን ደእያ አሳ ኡባ፥ ኤንቲ ማታና ጋካናዉ ዎይነ ኡሻን ኩንና። <verse eid="JER 13:13"/><verse number="14" style="v" sid="JER 13:14"/>ታኒ ኤንታ፥ እሱዋ እሱዋራ፥ አዋ ናኣራ ዶምኤና። ታ ኤንታ ይሳና፤ ታ ኤንታዉ ኬህከ፥ ቃትከ፤ ኤንታ ማርከ’ ” ያጌስ ጎዳይ።<verse eid="JER 13:14"/></para>
  <para style="s1">ኦቶሮይ ኤህያ መቶ</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 13:15"/>ሀይሳ ኦደይ ጎዳ ግድያ ግሾ ህንተ ኦቶሩዋ አግድ ስእተ፤ አኬክተ።<verse eid="JER 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 13:16"/>እ ማ ኤሀናፐ ስን፥ ህንተ ቶሆይ ምያ ደርያን በታናፐ ስን፥ ጎዳ ህንተ ፆሳ ቦንችተ። ህንተ፥ “ፖኦይ ያና” ግድ ናገታ፤ ሽን እ ሳካና ማን ላማና።<verse eid="JER 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 13:17"/>ሽን ህንተ ስኦና እፅኮ፥ ህንተ ኦቶሩዋ ግሾ ታ ጌማን ዬካይስ። ጎዳ ዉደይ ድኤትድ ብዳ ግሾ፥ ታ ዬካይስ፤ ታ አይፈይ አፉ ጉሴስ።<verse eid="JER 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 13:18"/>ጎዳይ ታኮ፥ “ካዋስነ ካዋ አየስ፥ ሀይሳዳ ያጋዳ ኦዳ፦ ህንተ ቦንቾ ካላቻይ ህንተ ሁጵያፐ ኩንድዳ ግሾ፥ ህንተ ካዎተ አራታፐ ዱገ ዎተ። <verse eid="JER 13:18"/><verse number="19" style="v" sid="JER 13:19"/>ነገበ ቢታን ደእያ ካታማት ኡባይ ጎርደትዶሶና። ኤንታ ዶያናዉ እስ አስካ ያን ባዋ። ይሁዳ አሳይ ኩመ ድኤትድ ብዶሶና” ያግስ።<verse eid="JER 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 13:20"/>ጎዳይ፥ “አነ ቁ ጋዳ፥ ፑደሀ ባጋፈ የይሳታ ፄላ። ነዉ እመትዳ ዉደይ፥ ነ ጬቀትዳ ዶርሳት አዉን ደኦና? <verse eid="JER 13:20"/><verse number="21" style="v" sid="JER 13:21"/>ኔኒ፥ ነዉ ላገ ግዳና መላ ኮይዳይሳት ነና ፆንድ ሃርያ ዎደ ዎይጋይ? የሎስ ከይዳ ማጫሳዳ እቀ ነና ኦይከኔ? <verse eid="JER 13:21"/><verse number="22" style="v" sid="JER 13:22"/>የሩሳላመ፥ ኔኒ ነ ዎዛናን፥ ‘ሀ ኡባይ ታና አይስ ጋክዴ?’ ጊኮ፥ ነ ማኦይ ቃረትዳይነ ነ ቦንቀትዳይ ነ ናጋራይ ዳርዳ ግሾሳ። <verse eid="JER 13:22"/><verse number="23" style="v" sid="JER 13:23"/>ቶጰይ ባ ማላ ዎይኮ ማሄይ ባ ጋዛተ ላማናዉ ዳንዳኢ? ሄሳዳካ፥ ኢታ ኦሶን ሜዘትዳ ህንተ፥ ሎኦ ኦሶ ኦናዉ ዳንዳኤከታ” ያግስ።<verse eid="JER 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 13:24"/>“ታ ህንተና ባዞ ጫርኮይ ኤፍያ ሱላዳ ላላና። <verse eid="JER 13:24"/><verse number="25" style="v" sid="JER 13:25"/>ህንተ ታና ዶግዳ ግሾነ ዎርዶ ፆሳታን አማነትዳ ግሾ ህንተ ሳማይነ ታ ህንተዉ እምያ ግሾይ ሀይሳ። <verse eid="JER 13:25"/><verse number="26" style="v" sid="JER 13:26"/>ህንተ ካሎይ በንታና መላ ታ ህንተ ማኡዋ ቃራ የጋና። <verse eid="JER 13:26"/><verse number="27" style="v" sid="JER 13:27"/>ነ ቦርሶ ኦሱዋ፥ ኮርማ ፓራዳ ዚታስ ጫገይሳ፥ ዬል ባይና ላይማተ፥ ዙማ ቦላነ ደንባን ነ ኦያ እፀትዳ ኦሱዋ ታ በአስ። የሩሳላመ፥ ነና አየ! ነ አዉደ ጋካናዉ ጌዮና ዳኔ?” ያጌስ ጎዳይ።<verse eid="JER 13:27"/></para>
  <chapter eid="JER 13"/>
  <chapter number="14" style="c" sid="JER 14"/>
  <para style="s1">ኮሻ፥ ማሸነ ቦሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 14:1"/>ኮሻባ ጎዳይ ኤርምያሳስ ኦድዳ ቃላይ ሀይሳ፦ <verse eid="JER 14:1"/><verse number="2" style="v" sid="JER 14:2"/>“ይሁዳ ቢታይ ካዮቴስ፤ እያ ካታማት ላባንዶሶና። ያን ደእያ አሳት ቢታን ኡትድ ዬኮሶና፤ የሩሳላመፐ ግታ ዋሶይ ስኤትስ። <verse eid="JER 14:2"/><verse number="3" style="v" sid="JER 14:3"/>ዱረ አሳት ሃ ትካናዉ ባንታ አይለታ ኪቶሶና። ኤንቲ ሃ ኦላኮ ቦሶና፤ ሽን ሃ ደሞኮና፤ ባንታ ኦቱዋ መላ ቶክ ኤክድ ስሞሶና። ሀንያባ ይድ ዬላትሸ፥ ባንታ ሁጵያ ጉሉንቶሶና። <verse eid="JER 14:3"/><verse number="4" style="v" sid="JER 14:4"/>እር ቡኮና ግሾ ቢታይ መልድ ዛእስ። ጎሻንቾት ዬላትድ፥ ባንታ ሁጵያ ጉሉንትዶሶና። <verse eid="JER 14:4"/><verse number="5" style="v" sid="JER 14:5"/>ማት ባይና ግሾ ዎሽኤይ ባ የልዳ ጋሎ ማርዉ ደንባን የጋዳ ባዉሱ። <verse eid="JER 14:5"/><verse number="6" style="v" sid="JER 14:6"/>ባዞ ሀረት አይብካ ባይና ቃ ዙማታ ቦላ ኤቅድ፥ ዎርካናዳ ላፈቶሶና። ኤንታዉ ምያባይ ይን፥ ኤንታ አይፈይ ፄላናዉ ዳቡርስ” ያግስ።<verse eid="JER 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 14:7"/>አሳይ ሀይሳዳ ያግድ ዎስስ፦ “አቤት ጎዳዉ፥ ኑ ናጋራይ ኑ ቦላ ማርካትኮካ፥ ነ ሱን ግሾ፥ ኑስ እስባ ኦ። ኑ ነና አግድ ዳሮ ዎደ ጉየ ስምዳ፤ ነ ቦላ ናጋራ ኦዳ። <verse eid="JER 14:7"/><verse number="8" style="v" sid="JER 14:8"/>አቤት እስራኤለ ኡፋይሳዉ፥ መቶ ዎደ አሸይሶ፥ ነ እማዳ፥ እስ ቃማ አቃናዉ ገልዳ ኦገ አሳዳ አይስ ሀናይ? <verse eid="JER 14:8"/><verse number="9" style="v" sid="JER 14:9"/>ነ ዳጋምዳ አሳዳ፥ አሻናዉ ዳንዳኦና አሳዳ አይስ ሀናይ? አቤት ጎዳዉ፥ ነ ኑ ግዶን ደኣሳ! ኑኒ ነ ሱንን ፄገትዳ፤ ኑና አጎፋ!” ያግስ።<verse eid="JER 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 14:10"/>ሀ አሳታባ ጎዳይ ሀይሳዳ ያጌስ፦ “ኤንቲ ቶይላተ ዳሮ ዶሶሶና፤ ባንታ ቶሁዋ ተቆኮና። ሄሳ ግሾ፥ ጎዳይ ኤንታን ኡፋይተና። እ ኤንታ ኢታ ኦሱዋ ሀሳይድ፥ ኤንታ ናጋራ ግሾ ኤንታ ሴራና” ያጌስ።<verse eid="JER 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 14:11"/>ሄሳፈ ጉየ፥ ጎዳይ ታኮ፥ “ሀ አሳ ሳሮተስ ዎሶፋ። <verse eid="JER 14:11"/><verse number="12" style="v" sid="JER 14:12"/>ኤንቲ ፆምኮካ፥ ታ ኤንታ ዋሱዋ ስእከ። ፁሳ ያርሾነ ካ ያርሹዋ ኤንቲ ያርሽኮካ፥ ታ ኤክከ። ታኒ ኤንታ ኦላን፥ ኮሻንነ ጋዶን ይሳና” ያግስ።<verse eid="JER 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 14:13"/>ታኒ ዛራዳ፥ “አቤት ኡባ ሃርያ ጎዳዉ፥ ናበት ‘ህንተ ኦላ በኤከታ ዎይኮ ኮሽ ጋከና። ጎዳይ ሀ ቢታን ፖሎ ሳሮተ እማና’ ያጎሶና” ያጋስ።<verse eid="JER 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 14:14"/>ጎዳይ ዛሪድ፥ “ናበት ታ ሱንን ዎርዶ ኦዶሶና፤ ታ ኤንታ ኪታብከ ዎይኮ ኤንታዉ ኦዳብከ። ኤንቲ ህንተዉ ኦደይ ዎርዶ ቆንጨ፥ ፓና ካዮነ ባንታዉ መ ከስዳ ዎርዶ ሃሳዮሶና። <verse eid="JER 14:14"/><verse number="15" style="v" sid="JER 14:15"/>ሄሳ ግሾ፥ ጎዳ ሱንን ኦድያ ናበታ ታ ኪታብከ። ሽን ኤንቲ፥ ‘ኦል ዎይኮ ኮሽ ሀ ቢታ ቦቸና’ ያጎሶና። ሄ ናበት ባንታዉ ኦላንነ ኮሻን ያና! <verse eid="JER 14:15"/><verse number="16" style="v" sid="JER 14:16"/>ቃስ ትንብተይ ኦደትዳ አሳይ ኮሻነ ኦላ ጋሶን ሀይቃና፤ ኤንታ አሀይ የሩሳላመ ኦግያ ቦላ ሆለታና። ኤንታ ዎይኮ ኤንታ ማቸታ፥ ኤንታ አደ ናይታነ ዎይኮ ኤንታ ማጫ ናይታ ሞግያ አስ ያና። ኤንታዉ በሲያ ዋይያ ኤንታ ቦላ ትጋና” ያግስ።<verse eid="JER 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 14:17"/>ታ አዛኑዋባ ታ አሳስ ኦዳና መላ ጎዳይ ታና ኪትስ። “ታ አሳይ ደሸትድ፥ ዳሮ ማዱንፅዳ ግሾ፥ ታ አይፈይ ቃማነ ጋላስ ቃንፆና አፉፃና። <verse eid="JER 14:17"/><verse number="18" style="v" sid="JER 14:18"/>ታ ደምባ ከይኮ፥ ማሻን ሀይቅዳይሳታ በአይስ። ካታማ ገልኮ፥ ኮሻን ቆሄትዳይሳታ በአይስ። ናበትነ ካህነት ባንታ ኦሱዋ ኦሶና፤ ሽን አይ ኦያኮ ኤሮኮና” ያጋስ።<verse eid="JER 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 14:19"/>አቤት ጎዳዉ፥ ነ ይሁዳ አጋዲ? ፅዮነ አሳ እፃዲ? ኑ ፓፆናዳ ኦዳ አይስ ደቻዲ? ኑ “ሳሮ ግዳና” ግድ ናግዳ፤ ሽን አይብካ ሎኦባይ በንትቤና። ኑ “ፓፃና ዎደይ ያና” ግድ ናግዳ፤ ሽን ዳጋማ ፃላል ጋክስ።<verse eid="JER 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 14:20"/>አቤት ጎዳዉ፥ ኑ ኢታተ ኤርዳ፤ ኑ አዋታ ባላ አኬክዳ፤ ኑኒ ናጋራ ኦዳ። <verse eid="JER 14:20"/><verse number="21" style="v" sid="JER 14:21"/>ነ ሱን ግሾ ጋዳ ኑና ካፓ፤ ነ ቦንቾ አራታ ካዉሾፋ። ነ ኑራ ጫቅዳ ጫቁዋ ሀሳያ፤ ነ ጫቁዋ መንፋ። <verse eid="JER 14:21"/><verse number="22" style="v" sid="JER 14:22"/>ካዎተታ ኤቃታፐ እሶይ እራ ቡክሳናዉ ዳንዳኢ? ሳሎይ ባ ሸነን ፑሳናዉ ዳንዳኢ? ዳንዳኤና! አቤት ጎዳዉ፥ ኑ ፆሳዉ፥ ሄሳ ዳንዳኤይ ነና! ሀይሳ ኡባ ኦይ ነና ግድያ ግሾ ነናን ኡፋይስ ኦስ።<verse eid="JER 14:22"/></para>
  <chapter eid="JER 14"/>
  <chapter number="15" style="c" sid="JER 15"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 15:1"/>ሄሳፈ ጉየ፥ ጎዳይ ታኮ ሀይሳዳ ያግስ፦ “ሀር አቶሽን ሙሰይነ ሳሜል ታ ስንን ኤቅድ ዎስያኮካ ታ ዎዛናይ ሀ አሳኮ ስመና። ኤንታ ታ ስንፈ ድጋ፤ ኤንቲ ቦ። <verse eid="JER 15:1"/><verse number="2" style="v" sid="JER 15:2"/>ኤንቲ ነና፥ ‘ኑ አዉ ባኔ?’ ግድ ኦይችኮ፥ ጎዳይ ሀይሳዳ ያጌስ ጋዳ ኤንታዉ ኦዳ፦ ‘ሀይቆስ ፕርደትዳይሳት ሀይቆስ፤ ማሻስ ፕርደትዳይሳት ማሻስ፤ ኮሻስ ፕርደትዳይሳት ኮሻስ፤ ድኤታናዉ ፕርደትዳይሳት ድኤታናዉ ቦ’ ያግስ።<verse eid="JER 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 15:3"/>“ታኒ ኦይዱ ቆሞ ጋዶታ ኤንታ ቦላ ኤሀና ያጌስ ጎዳይ። ሄስካ፥ ኤንታ ዎናዉ ማሻ፥ ኤንታ አሀ ጎቻናዉ ካናታ፥ ኤንታ አሾ ምድ ይሳናዉ ሳሎ ካፎታነ ሳአ ዶአታ ኤሀና። <verse eid="JER 15:3"/><verse number="4" style="v" sid="JER 15:4"/>ህዝቅያሳ ናአይ፥ ይሁዳ ካዎይ ምናሰይ የሩሳላመን ኦዳ ኢታ ኦሱዋ ግሾ፥ ታ ኤንታ ሳኣ ካዎተ ኡባስ ዳጋማ ኦና።<verse eid="JER 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 15:5"/>“የሩሳላመ አሳዉ፥ ህንተዉ ኦነ ቃታናይ? ህንተዉ አዛናናይ ኦኔ? ህንተ ዋንደቲ? ግድ ህንተና ኦይቻናይ ኦኔ?” ያጌስ ጎዳይ።<verse eid="JER 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 15:6"/>“ህንተ ታና አግደታ፤ ህንተ ጉየ ስምደታ። ሄሳ ግሾ፥ ታኒ ህንተ ቦላ ታ ኩሽያ ደንዳ ህንተና ይሳስ፤ ህዛፐ ታ ህንተዉ ቃትከ። <verse eid="JER 15:6"/><verse number="7" style="v" sid="JER 15:7"/>ኤንቲ ባንታ ኢታ ኦግያፐ ስሞና እፅዳ ግሾ ኤንታ ካታማታ ፐንግያን ፕ ኤካዳ ሀርቃስ። ታ ኤንታ ናይታ ዎ ዉርሳስ፤ ታ አሳ ይሳስ። <verse eid="JER 15:7"/><verse number="8" style="v" sid="JER 15:8"/>ኤንታ አምኤታ ታይቦይ አባ ጋፃን ደእያ ሻፍያፐ ዳርስ። ታኒ ሴታ ጋላስ ናአተታ አየታ ቦላ ዮ ኤሀና። ቆፖና ደእሽን፥ ኤንታ ቦላ ዳጋማነ ኮኮርስ ኤሀና። <verse eid="JER 15:8"/><verse number="9" style="v" sid="JER 15:9"/>ላፑን ናይት ሀይቅዳ አይያ ሸምፓናዉ ፆነታዳ ዳቡራሱ። እዉ ጋላስ ቃምስ፤ እያ ካዉያሱነ ዬላታሱ። ፓፃ አትዳይሳታ ኤንታ ሞርከታ ስንን ማሻን ዉርሳና” ያጌስ ጎዳይ።<verse eid="JER 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 15:10"/>ታ አየ፥ ታና አይስ የላዲ? ታና አየ! ታ ቢታ ኡባን ደእያ አሳራ ካጭያነ ባፀትያ አስ ግዳስ። ታ ኦደስካ ታልአብከ፤ ኦደፈካ ታልአዳ ኤካብከ፤ ሽን አሳ ኡባይ ታና ባዴስ።<verse eid="JER 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 15:11"/>ጎዳይ ታኮ፥ “ቱማ ታ ነና ሎኦ ኦሶስ አሻዳ ኤካና። ቱማ ነ ሞርከት መቱዋ ዎደነ ዋየ ዎደ ነና ዎሳና መላ ኦና። <verse eid="JER 15:11"/><verse number="12" style="v" sid="JER 15:12"/>አስ ብራታ፥ ፑደሀ ባጋፈ ያ ብራታ ዎይኮ ናሰ ብራታ መንናዉ ዳንዳኢ? <verse eid="JER 15:12"/><verse number="13" style="v" sid="JER 15:13"/>ቢታ ኡባን ህንተ ኦዳ ናጋራ ግሾ፥ ህንተ ሻሉዋነ ዱረተ ህንተ ሞርከታስ አዳ እማና። <verse eid="JER 15:13"/><verse number="14" style="v" sid="JER 15:14"/>ህንተና ኤሮና ቢታን ህንተ ሞርከት ህንተና አይለ ኦና። ታ ሀንቆይ ምያ ታማ ግድድ መርናዉ ኤፃና” ያግስ።<verse eid="JER 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 15:15"/>አቤት ጎዳዉ፥ ነ ኤራሳ። ታና ሀሳያ፤ ታና ማዳ፤ ታና የደይሳታ ቦላ ታ ሃሉዋ ከያ። ነ ዳንዳአን ታና ዎራ የጎፋ። ታ ነ ግሾ ጫየተይሳ ቆፓ። <verse eid="JER 15:15"/><verse number="16" style="v" sid="JER 15:16"/>አቤት ጎዳዉ፥ ኡባፈ ዎልቃማ ፆሳዉ፥ ታ ነ ሱንን ፄገትዳ ግሾ፥ ነ ቃላይ ታኮ ይን ማስ። ማ ስምን ታና ፓሽክስስ፤ ታ ዎዛና ኡፋይስስ። <verse eid="JER 15:16"/><verse number="17" style="v" sid="JER 15:17"/>ቀልቅሰይሳታ ጩጋን ኡታብከ፤ ኤንታራ ኡፋይታብከ። ኔኒ ነ ኩሽያ ታ ቦላ ዎዳ ግሾነ ታ ቦላ ይሎትዳ ግሾ ታ ታርካ ዱማ ኡታስ። <verse eid="JER 15:17"/><verse number="18" style="v" sid="JER 15:18"/>ታ ሀርገይ ፓፆናይ፥ ታ ማዱንይ መሎናይ አይብሴ? ነ ታዉ ኤቅያ ሻፋዳ፥ መልያ ፑልቶዳ ሀናዬ?<verse eid="JER 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 15:19"/>ሄሳ ግሾ፥ ጎዳይ ሀይሳዳ ያጌስ፦ “ነ ታኮ ስምኮ፥ ታ ዛራዳ ነና ኤካና፤ ነ ታዉ ኦና። ሀዳ ኦዳ አጋዳ፥ ቦንቾ ቃላ ፃላላ ኦደትኮ፥ ነ ታ ዶና ግዳና። ኤንቲ ኔኮ ስማና፤ ሽን ነ ኤንታኮ ስማካ። <verse eid="JER 15:19"/><verse number="20" style="v" sid="JER 15:20"/>ታ ነና ሀ አሳስ ናሰ ብራታን ግምበትዳ ግምበ ኦና። ኤንቲ ኔራ ኦለታና፤ ሽን ነና ፆኖኮና፤ ታ ነና አሻና። <verse eid="JER 15:20"/><verse number="21" style="v" sid="JER 15:21"/>ኢታታ ኩሸፐ ታ ነና አሻና፤ ቃይ ባይና ዎዛና ምኖ አሳፐ ታ ነና ዎዛና” ያጌስ ጎዳይ።<verse eid="JER 15:21"/></para>
  <chapter eid="JER 15"/>
  <chapter number="16" style="c" sid="JER 16"/>
  <para style="s1">ዮ ጋላስ ጋክስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 16:1"/>ጎዳ ቃላይ፥ ሀይሳዳ ያግሸ ታኮ ይስ፦ <verse eid="JER 16:1"/><verse number="2" style="v" sid="JER 16:2"/>“ኔኒ ማቾ ኤኮፋ፤ ማጫ ናአነ አደ ናአ ሀ በሳን የሎፓ። <verse eid="JER 16:2"/><verse number="3" style="v" sid="JER 16:3"/>ሀ በሳን የለትያ ማጫ ናይታባነ አደ ናይታባ፥ ኤንታ የልያ አየታነ አዋታባ ጎዳይ ሀይሳዳ ያጌስ። <verse eid="JER 16:3"/><verse number="4" style="v" sid="JER 16:4"/>ኤንቲ ኢታ ሀርገን ሀይቃና፤ ኤንታዉ ዬክያ ዎይኮ ኤንታ ሞግያ አስ በንተና። ኤንታ አሀይ ቢታ ቦላ ፕቶ መላ የገታና፤ ኤንቲ ማሻንነ ኮሻን ዉራና፤ ኤንታ አሾይ ሳሎ ካፎታስነ ሳአ ዶአታስ ካ ግዳና” ያግስ።<verse eid="JER 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 16:5"/>“ዬሆ ኬ ገሎፓ፤ ዬካናዉ ዎይኮ ቃታናዉ ቦፓ። ታኒ ሀ አሳ ቦላፈ ታ ሳሮተ፥ ታ ሲቁዋነ ታ ማሮተ ድጋስ። <verse eid="JER 16:5"/><verse number="6" style="v" sid="JER 16:6"/>ግትነ ጉ ሀ ቢታን ሀይቃና፤ ኤንቲ ሞገቶኮና። ኦንካ ኤንታዉ ዬከና፤ ኦንካ ባና ጋረና ዎይኮ ሁጰ ሜደትድ ካዮተና። <verse eid="JER 16:6"/><verse number="7" style="v" sid="JER 16:7"/>ዬክያ አሳስ ሾቹ ኤፍድ፥ ኤንታራ እስፈ ምድ ኡይድ፥ ካዩዋ ባለያ አስ እሶይካ ዴና። ሀር አቶሽን፥ አይያ ዎይኮ አው ሀይቅዳ አሳካ ምንያ አስ ባዋ።”<verse eid="JER 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 16:8"/>“ኤንታራ ማናዉነ ኡያናዉ ግብር ደእያ ኬ ገሎፓ። <verse eid="JER 16:8"/><verse number="9" style="v" sid="JER 16:9"/>ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ ‘ታኒ ኡፋይስነ እልልስ፥ ያጋኖ የ ሀ በሳፈ ድጋና። ሄሳ አሳይ ባንታ ላይንነ ባንታ አይፍያን በአና።’ ”<verse eid="JER 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 16:10"/>“ነ ሀ ቃላ ኡባ አሳስ ኦድያ ዎደ፥ ኤንቲ፥ ‘ጎዳይ አይስ ሀይሳ መላ ኢታባ ኑ ቦላ አዋጅዴ? ኑ አይ ባልዶ? ጎዳ፥ ኑ ፆሳ ቦላ ኑ አይ ናጋራ ኦዶ?’ ” ያጋና። <verse eid="JER 16:10"/><verse number="11" style="v" sid="JER 16:11"/>ሄ ዎደ ነ ኤንታኮ፤ “ህንተ አዋት ታና አግዳ ግሾሳ፥ ኤንቲ ሀራ ፆሳታ ካልዳ ግሾሳ፥ ኤንታዉ ኦዳነ ጎይንዳ ግሾሳ፥ ታና አግድ ታ ህግያ ናጎና እፅዳ ግሾሳ። <verse eid="JER 16:11"/><verse number="12" style="v" sid="JER 16:12"/>ህንተ፥ ህንተ አዋታፐ አድ ኢታ ኦዳ ግሾሳ። ህንተ እሶይ እሶይ ኤሮ ጎና ህንተ ኢታ ዎዛና ካልደታ፤ ታዉ ኪተቶና እፅደታ። <verse eid="JER 16:12"/><verse number="13" style="v" sid="JER 16:13"/>ሄሳ ግሾ፥ ታ ህንተና ሀ ቢታፈ ደንዳ፥ ህንተ ዎይኮ ህንተ አዋት ኤሮና ቢታ ሆላና። ያን ህንተ ሀራ ፆሳታ ጋላስነ ቃማ ሀጋዛና፤ ታኒ ህንተዉ ቃትከ” ያጌስ ጎዳይ።<verse eid="JER 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 16:14"/>አሳይ፥ “እስራኤለ አሳ ግብፀ ቢታፈ ከስዳ ጎዳይ ኤርያ መላ” ያግድ ጫቆና ዎደይ ያና። <verse eid="JER 16:14"/><verse number="15" style="v" sid="JER 16:15"/>ሄሳ አግድ፥ “ ‘እስራኤለ አሳ ፑደሀ ባጋ ቢታፈነ ኤንታ ላልዳ ቢታ ኡባፈ ዛሪድ ኤህዳ ጎዳይ ኤርያ መላ’ ያግድ ጫቃና። ታኒ ኤንታ ካሰ ኤንታ አዋታስ እምዳ ቢታ ዛራዳ ኤሀና” ያጌስ ጎዳይ።<verse eid="JER 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 16:16"/>“ታ ሞሎ ኦይክያ ዳሮ አሳ ኪታና፤ ኤንቲ ኤንታ ኦይካና። ሄሳፈ ጉየ፥ ዳሮ ሻንካትያ አሳ ኪታና፤ ደረፐ፥ ዙማፐነ ሹቻ ቆጶፐ ኤንታ ሻንካትድ ከሳና። <verse eid="JER 16:16"/><verse number="17" style="v" sid="JER 16:17"/>ታ አይፈይ ኤንታ ኦግያ ቦላ ደኤስ፤ ኤንቲ ታፐ ቆሰትቦኮና፤ ኤንታ ናጋራይ ታ ስንፈ ጌምቤና። <verse eid="JER 16:17"/><verse number="18" style="v" sid="JER 16:18"/>ታ ኤንታ ኢታተነ ኤንታ ናጋራ ግሾ ኤንታዉ ናምኡ ኩሸ ዛራና። ኤንቲ አሀ ዳንያ ባንታ እፀትዳ ኤቃታን ታ ቢታ ቱንስዶሶና፤ ሻትያ ባንታ ምስለታን ታ ላታ ኩንዶሶና” ያጌስ ጎዳይ።<verse eid="JER 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 16:19"/>አቤት ጎዳዉ፥ ታ ዎልቃዉ፥ ታ ሚፃዉ፥ መቶ ጋላስ ታ ባቃታዳ አትያ በሳዉ፥ ካዎተት ሳኣ ጋፃፐ ኔኮ ይድ፥ “ኑ አዋት ፓናነ ማዶና ዎርዶ ፆሳታ ፃላላ ላትዶሶና። <verse eid="JER 16:19"/><verse number="20" style="v" sid="JER 16:20"/>አሳይ ባንታዉ ፆሳታ መናዉ ዳንዳኦና? ኤ፥ ኤንቲ መያኮካ ቱማ ፆሳታ ግዶኮና!” ያጋና።<verse eid="JER 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 16:21"/>“ሄሳ ግሾ፥ ታ ኤንታ ታማርሳና፤ ታ ዎልቃነ ታ ግታተ ኤንታ ኤርሳና። ሄ ዎደ ኤንቲ ታ ሱንይ ጎዳ ግደይሳ ኤራና” ያጌስ ጎዳይ።<verse eid="JER 16:21"/></para>
  <chapter eid="JER 16"/>
  <chapter number="17" style="c" sid="JER 17"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 17:1"/>“ይሁዳ ናጋራይ ብራታ ቢረን ፃፈትስ፤ ኤንታ ዎዛና ቦላነ ያርሾ በሳን ደእያ ካጭያ ቦላ አልማዘ ጌተትያ ሹቻ ፄራን ፃፈትስ። <verse eid="JER 17:1"/><verse number="2" style="v" sid="JER 17:2"/>ኤንታ ናይት እርፃ ም ጋርሳን፥ ዙማታ ቦላነ ደረታ ቦላ ጊግስዳ ያርሾ በሳን አሼራ ጌተትያ ፆሴስ ኤስዳ ምስልያ ጎይኖሶና። <verse eid="JER 17:2"/><verse number="3" style="v" sid="JER 17:3"/>ህንተ ቢታ ቦላ ኦዳ ናጋራ አጩዋ ቃንፅሳናዉ ህንተ ሻሉዋነ ህንተ ሚሽያ ህንተ ሞርከታስ እማና። <verse eid="JER 17:3"/><verse number="4" style="v" sid="JER 17:4"/>ህንተ መርናዉ ኤፅያ ታ ሸንያ ደንዳ ግሾ፥ ህንተና ላትስዳ ቢታፈ ሾዳና፤ ህንተ ኤሮና ቢታን ህንተ ሞርከታስ አይለ ኦና” ያጌስ ጎዳይ።<verse eid="JER 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 17:5"/>ጎዳይ ሀይሳዳ ያጌስ፦ “አሳን አማነተይ፥ አሾ ማእዳ አሳን ጬቀተይነ ባ ዎዛና ፆሳፈ ሃሰይ ባደትዳይሳ ግዶ። <verse eid="JER 17:5"/><verse number="6" style="v" sid="JER 17:6"/>ሄሳ መላ አስ ባዞን ደእያ ቱሸ መላ፤ ሎኦባይ ያ ዎደ እ በኤና። እ ባዞን፥ መላ በሳን፥ አስ ዶና ማፅነ ቢታን ዳና።<verse eid="JER 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 17:7"/>“ጎዳን አማነትያ አስ፥ እያ ጬቆይ ጎዳ ግድዳ አስ አንጀትዳይሳ። <verse eid="JER 17:7"/><verse number="8" style="v" sid="JER 17:8"/>እ ሃ ማታን ቶከትድ፥ ባ ፃጱዋ ጎግያ ሃን የድዳ ም መላ። እ አዋ ሱላስ ያየና። ሄ ም ሀይይ ጭልኦሽን ደኤስ። እር ቡኮና ላይን ህርገና፤ ኡባ ዎደ አይፈ አገና።<verse eid="JER 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 17:9"/>“አሳ ዎዛን ኡባፈ አድ ጭሜስነ ኢታ፤ እያ ጋ ቆፋ ኦን ኤራናዉ ዳንዳኢ? <verse eid="JER 17:9"/><verse number="10" style="v" sid="JER 17:10"/>ታኒ ጎዳይ፥ አሳ ኡባስ እያ ኦግያዳነ እያ ኦሱዋዳ እማናዉ፥ አሳ ዎዛና ፕልጋይስ፤ እያ ካሃ ፓጫይስ” ያጌስ ጎዳይ።<verse eid="JER 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 17:11"/>በሶና ኦገን ሻሎ ሺሽያ አስ ባባ ግዶና ጱጱለ ቆፅያ ኩራቾ መላ። ባ ላይ ባጋ ዛዋን አግድ ባና፤ ዉርሰን እያ ኤያተይ ቆንጫና።<verse eid="JER 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 17:12"/>ኑ ፆሳ ኬይ ኮይሮፐ ዶምድ፥ ቦንቾ ካዎተ አራታዳ ቃ ደርያ ቦላ ደኤስ። <verse eid="JER 17:12"/><verse number="13" style="v" sid="JER 17:13"/>አቤት ጎዳዉ፥ እስራኤለ ኡፋይሳዉ፥ ነና አግዳ ኡባይ ዬላታና። ደኦ ፑልቶ ሃ፥ ነና ጎዳ ኤንቲ አግዳ ግሾ ባናን ፃፈትዳ ሱንዳ ያና።<verse eid="JER 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 17:14"/>አቤት ጎዳዉ፥ ነ ታ ጋላታ ግድያ ግሾ፥ ታና ፓ፤ ታ ፓፃና፤ ታና አሻ፤ ታ አታና።<verse eid="JER 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 17:15"/>አሳይ ታኮ፥ “ ‘ጎዳይ ታዉ ኦድስ’ ያጋዳ ነ ኦድዳ ቃላይ አዉን ደኢ? እ አይስ ፖለተኔ?” ያጎሶና።<verse eid="JER 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 17:16"/>ታኒ ሄንንቾ ግዳዳ ነና ሀጋዞ አጋብከ፤ ኤንቲ መቶታና ጋላሳ ታ አሞታብከ። ታ ዶናፐ ከይዳ ቃላ ነ ኤራሳ። <verse eid="JER 17:16"/><verse number="17" style="v" sid="JER 17:17"/>ታና ዳጋንፋ፤ መቶ ጋላስ ታኒ ባቃታዳ አትያ በሳይ ነና። <verse eid="JER 17:17"/><verse number="18" style="v" sid="JER 17:18"/>ታና የደይሳት ዬላቶ፤ ሽን ታና ዬላዮፓ። ኤንታ ዳጋን፤ ሽን ታና ዳጋንፋ። ኤንታ ቦላ መቶ ኤሀ፤ ኤንታ ናምኡ ኩሸ ሴራ።<verse eid="JER 17:18"/></para>
  <para style="s1">ሳምባታ ቦንችተ</para>
  <para style="p">
    <verse number="19" style="v" sid="JER 17:19"/>ጎዳይ ታኮ፥ “ኮይሮ ባዳ ይሁዳ ካዎት ካታማ ገልያነ ከይያ፥ አሳይ ገልያ ፐንግያንነ ሀራ የሩሳላመ ፐንገታ ኡባን ኤቃ። <verse eid="JER 17:19"/><verse number="20" style="v" sid="JER 17:20"/>አሳኮ ሀይሳዳ ያጋ፦ ‘ህንተኖ ይሁዳ ካዎቶ፥ ህንተኖ ይሁዳ አሳዉ፥ ህንተኖ የሩሳላመ አሳዉ፥ ሀ ፐንገታራ ገልያ አሳዉ፥ ኡባይ ጎዳ ቃላ ስእተ። <verse eid="JER 17:20"/><verse number="21" style="v" sid="JER 17:21"/>ሳምባታ ጋላስ ቶሆ ቶክድ የሩሳላመ ፐንግያራ ገሎና መላ ናገትተ። <verse eid="JER 17:21"/><verse number="22" style="v" sid="JER 17:22"/>ሳምባታ ጋላስ ህንተ ኬፈ ቶሆ ቶክድ ከሶፍተ፥ ዎይኮ አይብ ኦሶካ ኦፕተ። ካሰ ህንተ አዋታ ታ ኪትዳይሳዳ ሳምባታ ጋላስ ቦንችተ። <verse eid="JER 17:22"/><verse number="23" style="v" sid="JER 17:23"/>ግዶሽን፥ ኤንቲ ስእቦኮና፤ ባንታ ሀይ ታኮ ዛርቦኮና። ኤንቲ ታና ስኦናነ ታፐ ታማሮና እፅዶሶና። <verse eid="JER 17:23"/><verse number="24" style="v" sid="JER 17:24"/>ሽን ህንተ ታዉ ኪተትኮ፥ ሳምባታ ጋላሳን ቶሆ ቶክድ፥ ሀ ካታማ ፐንገታራ ገሎና አግኮ፥ ሳምባታ ጋላስ አይኮካ ኦና ዱማይድ ቦንችኮ፥ <verse eid="JER 17:24"/><verse number="25" style="v" sid="JER 17:25"/>ዳዊታ አራታን ኡትያ ካዎት ባንታ ሞርናታራ ፓራታነ ፓራ ጋረታ ቶግድ፥ ሀ ፐንገታራ ገላና። ኤንቲ ይሁዳ አሳራነ የሩሳላመ ካታማን ደእያ አሳራ ገላና፤ ሀ ካታማይ መርናዉ አስ ደእያ ካታማ ግዳና። <verse eid="JER 17:25"/><verse number="26" style="v" sid="JER 17:26"/>አሳይ ፁሳ ያርሾ፥ ሀራ ያርሾ፥ ካ ያርሾ፥ እፃነነ ጋላታ ያርሾ ኤክድ፥ ይሁዳ ካታማታፐ፥ የሩሳላመ ዩሹዋን ደእያ ጉታታፐ፥ ብንያመ ቢታፈ፥ ጋፐ፥ ደረይ ዳርያ ቢታፈነ፥ ነገባፐ ጎዳ ፆሳ ኬ ያና። <verse eid="JER 17:26"/><verse number="27" style="v" sid="JER 17:27"/>ሽን ህንተ ሳምባታ ጋላሳ ዱማይድ ቦንቾና አግድ፥ ሳምባታ ጋላሳን ቶሆ ቶክድ፥ የሩሳላመ ፐንገታራ ገልድ፥ ታ ህግያ መንኮ፥ ታ ሄ ፐንገታን ታማ ኦይና። የሩሳላመ ካዎ ኬታ ማና፤ ሄ ታማይ ቶኤና’ ” ያጌስ ጎዳ-ይ።<verse eid="JER 17:27"/></para>
  <chapter eid="JER 17"/>
  <chapter number="18" style="c" sid="JER 18"/>
  <para style="s1">ኤርምያስ ኦቶ መያ ኬን</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 18:1"/>ጎዳፐ ኤርምያሳኮ ይዳ ቃላይ ሀይሳ፦ <verse eid="JER 18:1"/><verse number="2" style="v" sid="JER 18:2"/>“ደንዳዳ ኡርቃ መያ አድያ ሶ ባ። ያን ታ ነና ታ ቃላ ስሳና” ያግስ። <verse eid="JER 18:2"/><verse number="3" style="v" sid="JER 18:3"/>ታኒ ዱገ ኡርቃ መያ አድያ ሶ ባዳ፥ እ ባ ገርቱዋ ቦላ ኡርቃ መሽን በአስ። <verse eid="JER 18:3"/><verse number="4" style="v" sid="JER 18:4"/>እ መሽን፥ ሄ ሚሸይ እያ ኩሸን ኢትስ። እ ሄ ኡርቃ ዛሪድ ሙኑቅድ፥ ባና ሎእያ ሀራ ሚሸ ከስድ መስ።<verse eid="JER 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 18:5"/>ሄ ዎደ ጎዳ ቃላይ፥ ሀይሳዳ ያግሸ ታኮ ይስ፦ <verse eid="JER 18:5"/><verse number="6" style="v" sid="JER 18:6"/>“እስራኤለ አሳዉ፥ ኡርቃ መያ አደይ ኦይሳዳ ታ ህንተና ኦናዉ ዳንዳእክና? እስራኤለ አሳዉ፥ ኡርቃይ ባና መይሳ ኩሸን ደኤይሳዳ፥ ህንተካ ታ ኩሸን ደኤታ። <verse eid="JER 18:6"/><verse number="7" style="v" sid="JER 18:7"/>እስ ካዎተ ዎይኮ እስ ደረይ ሾደታና መላ፥ ላለታና መላነ ያና መላ ታ ኦድዳ ዎደ፥ <verse eid="JER 18:7"/><verse number="8" style="v" sid="JER 18:8"/>ሄ ካዎተይ ባ ኢታተፈ ስምኮ፥ ታ ኤንታ ቦላ ኤሀና ግዳ ኢታባ ኤሆና አጋጋና። <verse eid="JER 18:8"/><verse number="9" style="v" sid="JER 18:9"/>ቃስ ሀራ ዎደ እስ ደርያ ዎይኮ ካዎተ፥ ‘ታ ህንተና ኬፃናነ ቶካና’ ጋዳ ኦድዳ ዎደ፥ <verse eid="JER 18:9"/><verse number="10" style="v" sid="JER 18:10"/>ሄ ካዎተይ ታ ኦደይሳ ስኦና እፅድ፥ ታ ስንን ኢታባ ኦኮ፥ ታ ኦና ግዳ ሎኦባ ኦና አጋጋና።<verse eid="JER 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 18:11"/>“ሄሳ ግሾ፥ ይሁዳ አሳስነ የሩሳላመን ደእያ አሳስ ሀይሳዳ ያጋ። ታኒ ህንተዉ ዮ ጊግሳይስነ ኢታባ ሀልቻይስ። ህንተ ኡባይ ህንተ ኢታ ኦግያፐ ስምተ፤ ህንተ ኦግያነ ህንተ ኦሱዋ ላምተ። <verse eid="JER 18:11"/><verse number="12" style="v" sid="JER 18:12"/>ሽን ኤንቲ፥ ‘ሀይስ አይኮካ ማደና! ኑኒ ኑ ቆፋዳ ሀናና፤ ኑ እሶይ እሶይ ኑ ኢታ ዎዛና ካላና’ ያጋና” ያግስ።<verse eid="JER 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 18:13"/>ሄሳ ግሾ፥ “ጎዳይ፥ ‘ሀይሳ መላባ ስእ ኤሬቲ?’ ያግድ ካዎተታ ኦይችተ። ጌላኦ ግድዳ እስራኤለይ ዳሮ ሻትያባ ኦሱ። <verse eid="JER 18:13"/><verse number="14" style="v" sid="JER 18:14"/>ልባኖሰ ዙማ ቦላ ደእያ ሻቻይ፥ ዛላ ቦላፈ ይድ ኤሪ? ሄ ዙማፐ ጎግያ እርፃ ሃ መል ኤሪ? <verse eid="JER 18:14"/><verse number="15" style="v" sid="JER 18:15"/>ሽን ታ አሳይ ታና ዶግዶሶና፤ ፓና ፆሳታስ እፃነ ጩይስዶሶና። ባንታ ኦግያፐ፥ ባንታ በን ኦግያፐ፥ ጋፃ ከይድ በትዶሶና። <verse eid="JER 18:15"/><verse number="16" style="v" sid="JER 18:16"/>ኤንቲ ባንታ ቢታ ባይሳነ ካትዳባ ከስዶሶና። ያራ አያ ኦንካ ማላለትድ ባ ሁጵያ ቃስ። <verse eid="JER 18:16"/><verse number="17" style="v" sid="JER 18:17"/>ባን ዶሎሀ ባጋ ጫርኩዋን ላለተይሳ መላ፥ ታኒ ታ አሳ ሞርከታ ስንን ላላና። ኤንታ መቱዋ ጋላስ ታ ኤንታዉ ዞኮ ዛራናፐ አትሽን፥ ታ ሶምኡዋ ኤንታ በስከ” ያጌስ ጎዳይ።<verse eid="JER 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 18:18"/>አሳይ፥ “ካህነታ ማታን ህገይ፥ ጭንጫታ ማታን ዞረይ፥ ናበታ ማታን ቃል ዮና ግሾ አነ ኤርምያሳ ቦላ ማቀቶስ። ኑ እንፃርሳን ኦይኮስ፤ እ ኦድያ ቃላ ስኦና እፃና” ያግዶሶና።<verse eid="JER 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 18:19"/>አቤት ጎዳዉ፥ ታና ስአ፤ ታ ሞርከት ታ ቦላ ግያባ ሀይዛ። <verse eid="JER 18:19"/><verse number="20" style="v" sid="JER 18:20"/>ሎኦ ኦዳ አሳስ ዛሮይ ኢተዬ? ሽን ኤንቲ ታዉ ኦላ ቦኮሶና። ነ ሀንቆይ ኤንታፈ ስማና መላ ታ ኤንታ ግሾ ጋናተይሳ በአ። <verse eid="JER 18:20"/><verse number="21" style="v" sid="JER 18:21"/>ሄሳ ግሾ፥ ኤንታ ናይታ ኮሻስ አዳ እማ፤ ኤንታ ማሻስ አዳ እማ። ኤንታ ማቸት ናእ ባይናይሳታነ አምኦ ግዶ። ኤንታ አደት ዎያ ሀርገን ጋሄቶና፤ ኤንታ ናአተት ኦላን ዉሮ። <verse eid="JER 18:21"/><verse number="22" style="v" sid="JER 18:22"/>ኤንቲ ታና ኦይካናዉ ኦላ ቦክዳ ግሾነ ታ ቶሁዋስ ፅሄ ዎዳ ግሾ፥ ቆፖና ቦንቀይሳታ ኤንታ ቦላ የዳ፤ ኤንታ ኬን ዋሶይ ከዮ። <verse eid="JER 18:22"/><verse number="23" style="v" sid="JER 18:23"/>ሽን አቤት ጎዳዉ፥ ኤንቲ ታና ዎናዉ ማቀተይሳ ነ ኤራሳ። ነ ኤንታ ኢታተ አቶ ጎፓ ዎይኮ ኤንታ ናጋራ ነ ስንፈ ቁቾፋ። ኤንቲ ነ ስንን ፆነትድ ኩንዶ፤ ነ ሸነትያ ዎደ ኤንታ ሀይሳዳ ኦ።<verse eid="JER 18:23"/></para>
  <chapter eid="JER 18"/>
  <chapter number="19" style="c" sid="JER 19"/>
  <para style="s1">መቅዳ ፁጋ ሌምሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 19:1"/>ጎዳይ ታኮ፥ “ባዳ ኦቶ መይሳፈ ፁጋ ሻማ። ኔራ ጉ ቢታ ጭማታነ ጉ ካህነ ጭማታ ኤካዳ፥ <verse eid="JER 19:1"/><verse number="2" style="v" sid="JER 19:2"/>ኩንአ መኦ ፐንግያ ማታራ አዳ፥ ህኖማ ዛንጋራ ባ፤ ያን ታ ነዉ ኦድያ ቃላ አዋጃ። <verse eid="JER 19:2"/><verse number="3" style="v" sid="JER 19:3"/>‘ህንተኖ፥ ይሁዳ ካዎቶ፥ ህንተኖ የሩሳላመ ካታማ አሳዉ፥ ጎዳ ቃላ ስእተ!’ ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ ‘ስእያ ኡባ ሀይስ ኢትያ ፓላባ ሀ ቢታ ቦላ ታ ኤሀና።’ <verse eid="JER 19:3"/><verse number="4" style="v" sid="JER 19:4"/>ሀ አሳይ ታና አግድ፥ ኤንቲ ዎይኮ ኤንታ አዋት ዎይኮ ይሁዳ ካዎት ኤሮና ሀራ ፆሳታስ እፃነ ጩይስድ ሀ በሳ ቱንስዶሶና። ኤንቲ ፅሎ አሳ ሱ ሀ በሳን ጉስዶሶና። <verse eid="JER 19:4"/><verse number="5" style="v" sid="JER 19:5"/>ታ ኤንታ ኪቶናባ ዎይኮ ኤንታዉ ኦዶናባ ዎይኮ ታ ቆፖናባ ኦዶሶና፤ ባንታ አደ ናይታ ናጋራስ ታማን ፁሳ ያርሾ ኦድ ያርሻናዉ፥ ቃ ጎይኖ በሳታ ግምብዶሶና። <verse eid="JER 19:5"/><verse number="6" style="v" sid="JER 19:6"/>ሄሳ ግሾ፥ ሀ በሳይ ቶፈታ ዎይኮ ህኖማ ዛንጋራ ጌተተይስ አትድ፥ ሹሀ ዛንጋራ ያገትድ ፄገታና ጋላሳይ ያና። <verse eid="JER 19:6"/><verse number="7" style="v" sid="JER 19:7"/>ይሁዳነ የሩሳላመ አሳ ሀልቹዋ ታ ሀ በሳን ላላና። ኤንቲ ባንታ ሞርከታ ማሻንነ ባንታና ዎናዉ ኮይያ አሳ ኩሸን ሀይቃናዳ ኦና። ኤንታ አሀ ሳሎ ካፎታስነ ሳአ ዶአታስ ካ ኦዳ እማና። <verse eid="JER 19:7"/><verse number="8" style="v" sid="JER 19:8"/>ታኒ ሀ ካታማ ባይሳነ ሚቻስ ከሳና። ያራ አያ ኡባይ እያ ዩዋን ማላለትድ፥ ‘ፖራ’ ያጋና። <verse eid="JER 19:8"/><verse number="9" style="v" sid="JER 19:9"/>ኤንቲ ባንታ ማጫ ናይታነ አደ ናይታ አሹዋ ማናዳ ኦና። ኤንታ ዎናዉ ኮይያ ሞርከት ኤንታ ተቅድ ዋይስያ ዎደ ኡንኤትድ ኤንቲ እሶይ እሱዋ አሹዋ ማና” ያግስ።<verse eid="JER 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 19:10"/>“ሄሳፈ ጉየ፥ ኔራ ብዳ አሳ ስንን ፁጋ መን። <verse eid="JER 19:10"/><verse number="11" style="v" sid="JER 19:11"/>ኤንታኮ ሀይሳዳ ያጋ፦ ፁጋይ መቅዳይሳዳነ ዛሪድ ኮላናዉ ዳንዳኤቶናይሳዳ ታ ሀ ካዎተነ ሀ ካታማ መንረና። አስ አሀ ሞግያ በሲ ባይና ግሾ ቶፈታን ሞገታና። <verse eid="JER 19:11"/><verse number="12" style="v" sid="JER 19:12"/>ሀ በሳንነ እያን ደእያ አሳ ቦላ ሀይሳ ኦና። ሀ ካታማ ቶፈታዳ ኦና። <verse eid="JER 19:12"/><verse number="13" style="v" sid="JER 19:13"/>የሩሳላመ አሳ ኬትነ ይሁዳ ካዎታ ኬት፥ ኬ ቦላ ደምባይድ ኦዳ በሳን ሳሎ ፆልንቶታስ እፃነ ጩይስዳነ ሀራ ፆሳታስ ኡሻ ያርሾ ጉስዳ ኬት ኡባይ ቶፈታዳ ቱና ግዳና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 19:14"/>“ሄሳፈ ጉየ፥ ኤርምያስ ጎዳይ ትንብተ ኦዳና መላ ኪትዳ ቶፈታፐ ስሚድ፥ ፆሳ ኬ ግዶን ደእያ ዳባባን ኤቅድ አሳ ኡባኮ ሀይሳዳ ያግስ፦ <verse eid="JER 19:14"/><verse number="15" style="v" sid="JER 19:15"/>ኤንቲ ሞርግያ ጋቢስድ፥ ታ ኦድያባ ስኦና እፅዳ ግሾ ሀ ካታማ ቦላነ እያ ሄራን ደእያ ጉታታ ቦላ ኤሀና ግዳ ኢታባ ኡባ ኤሀና ሀናይስ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 19:15"/></para>
  <chapter eid="JER 19"/>
  <chapter number="20" style="c" sid="JER 20"/>
  <para style="s1">ኤርምያሳነ ጳስኮራ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 20:1"/>ሄ ዎደ ጎዳ ኬነ ሀላቃ ግድያ፥ እመራ ናኣ ካህንያ ጳስኮር ኤርምያስ ትንብተ ኦድሽን ስእስ። <verse eid="JER 20:1"/><verse number="2" style="v" sid="JER 20:2"/>ጳስኮር ናብያ ኤርምያሳ ደሽስድ፥ ቆሞ ብንያመ ፐንግያን ፆሳ ኬ ገልያ ፐንገን ጎንገ ሉሆን ቃሽስስ። <verse eid="JER 20:2"/><verse number="3" style="v" sid="JER 20:3"/>ዎንተ ጋላስ ጳስኮር ኤርምያሳ ቃሾፐ ብርሽን፥ ኤርምያስ እያዉ ሀይሳዳ ያግስ፦ “ሀችፈ ዶምን፥ ጎዳይ ነ ሱን ጳስኮር ያገና፤ እ ነ ሱን ‘ያን ሀን ዳጋማ’ ያጋና። <verse eid="JER 20:3"/><verse number="4" style="v" sid="JER 20:4"/>ጎዳይ ሀይሳዳ ያጌስ፦ ‘ታኒ ነና፥ ነዉነ ነ ላገታ ኡባስ ዳጋማ ኦና። ኤንቲ ኔኒ ፄልሽን፥ ባንታ ሞርከታ ማሻን ዉራና። ታኒ ይሁዳ አሳ ኡባ ባብሎነ ካዋ ኩሸን አዳ እማና። እ ኤንታ ድእድ፥ ባብሎነ ኤፍድ፥ ያን ማሻን ዎና። <verse eid="JER 20:4"/><verse number="5" style="v" sid="JER 20:5"/>ሄሳዳካ፥ ሀ ካታማ ሻሉዋነ ዱረተ ኡባ፥ ኦይክ የዳባ ኡባ፥ ሃርዳባ ኡባነ ይሁዳ ካዎታ ሚሽያ ኡባ ታኒ ኤንታ ሞርከታስ አዳ እማና፤ ኤንቲ ኤንታ ቦንቅድ ባብሎነ ኤፋና። <verse eid="JER 20:5"/><verse number="6" style="v" sid="JER 20:6"/>ቃስ ኔኒ ጳስኮር፥ ነ ሶን ደእያ አሳ ኡባይ ድኤትድ፥ ባብሎነ ባና። ኔኒ ዎርዶ ትንብተ ኦድዳ ነ ላገታ ኡባራካ ያን ሀይቃናነ ያን ሞገታና’ ያጌስ” ያግስ።<verse eid="JER 20:6"/></para>
  <para style="s1">ኤርምያሳ ሞቱዋ</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 20:7"/>አቤት ጎዳዉ፥ ኔኒ ታና ጭማዳሳ፤ ታንካ ጭመታስ። ኔኒ ታፐ ምናዳ፥ ታና ፆናዳሳ። ጋላሳ ኩመ ታኒ አሳ ሚቻስ አታስ፤ ኡባይ ታና ቀልቅስስ። <verse eid="JER 20:7"/><verse number="8" style="v" sid="JER 20:8"/>ታኒ ሃሳያ ዎደ ኡባን፥ “ማካላባይነ ዮይ ጋክስ” ጋዳ ዋሳይስ። ጎዳ ቃላይ ታዉ ጋላስ ጋላስ ቦረነ ቀልቅሰ ኤህስ። <verse eid="JER 20:8"/><verse number="9" style="v" sid="JER 20:9"/>ታኒ፥ “ታኒ ጎዳባ ደንዳ ኦድከ” ዎይኮ፥ “እያ ሱንን ናምአን ኦድከ” ጊኮ፥ ጎዳ ቃላይ ታ መቀ ግዶን ቁምኤትድ፥ ኤፅያ ታማ መላ ግድድ፥ ታ ዎዛናን ምቼስ። ታኒ ግዶን ኦይካዳ አሾና ጋዳ ዳቡራስ፤ ሽን ተቃናዉ ዳንዳአብከ። <verse eid="JER 20:9"/><verse number="10" style="v" sid="JER 20:10"/>ታኒ ዳሮ ካልካሻ ስአስ፤ “ያን ሀን ዳጋም ደኤስ! አነ እያ ሞትተ! ኑኒካ እያ ሞቶስ” ያጎሶና። ታዉ ማታ ላገት ኡባይ ታ ኩንደ ናግድ፥ “ኦን ኤር፥ ኑኒ እያ ኦይካና መላነ ኑ ሃሉዋ ከያና መላ፥ እ ጭማናዉ ዳንዳኤስ” ያጎሶና።<verse eid="JER 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 20:11"/>ሽን ጎዳይ ያሽስያ ቶራ ቃራዳን ታራ ደኤስ። ሄሳ ግሾ፥ ታና የደይሳት በታና፤ ኤንቲ ታና ፆኖኮና። ኤንታዉ ጊጎና ግሾ፥ ኤንቲ ግታ ዬላ ዬላታና። ኤንታ ካዉሻይ ኩም ዶገተና። <verse eid="JER 20:11"/><verse number="12" style="v" sid="JER 20:12"/>አቤት ኡባፈ ዎልቃማ ጎዳዉ፥ ፅሎታ ፓጨይሶ፥ ዎዛናነ ካሀ በኤይሶ፥ ኔኒ ታ ሞርከታ ቦላ ነ ሃሉዋ ከያዳ ታና በሳ። አይስ ጊኮ፥ ታኒ ታ ሞቱዋ ነዉ አስ።<verse eid="JER 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 20:13"/>ጎዳስ የፅተ! ጎዳ ጋላትተ! አይስ ጊኮ፥ እ ማንቆታ ኢታታ ኩሸፐ አሼስ።<verse eid="JER 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 20:14"/>ታኒ የለትዳ ጋላሳይ ባደትዳይሳ ግዶ! ታ አይያ ታና የልዳ ጋላሳይ አንጀቶፎ! <verse eid="JER 20:14"/><verse number="15" style="v" sid="JER 20:15"/>ታ አዋስ፥ “ነዉ ምሽራቾ፤ ነዉ አደ ናእ የለትስ!” ያግ ኦድድ፥ ዳሮ ኡፋይስዳ ኡራይካ ባደትዳባ ግዶ! <verse eid="JER 20:15"/><verse number="16" style="v" sid="JER 20:16"/>ሄ አደይ ጎዳይ ቃቶና አድ የግድ ይስዳ ካታማታዳ ሀኖ። ሄ አደይ ዎንታ ዋሱዋ፥ ጋላስ ሴታን፥ “ኦላይ ጋክስ!” ግያ ኦዳ ስኦ። <verse eid="JER 20:16"/><verse number="17" style="v" sid="JER 20:17"/>አይስ ጊኮ፥ ታ አይያ ታዉ ዱፎ ግዳና መላነ እ ኡሎይካ ታና መርናዉ ኦይክ ኡታና መላ፥ ታና ኡሎን ዎቤና። <verse eid="JER 20:17"/><verse number="18" style="v" sid="JER 20:18"/>ታኒ መቶነ አዛኖ በአናዉነ ላይ ኡባ ዬላታሸ ዉርሳናዉ፥ አይስ ታ አየ ኡሎፐ ከያድና?<verse eid="JER 20:18"/></para>
  <chapter eid="JER 20"/>
  <chapter number="21" style="c" sid="JER 21"/>
  <para style="s1">ካዋ ሰደቅያሳስ እመትዳ ዛሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 21:1"/>ካዎይ ሰደቅያስ ማልክያ ናኣ ጳስኮራነ ማእሰያ ናኣ ካህንያ ሶፎንያሳ ኪትዳ ዎደ፥ ጎዳ ቃላይ ኤርምያሳኮ ሀይሳዳ ያግድ ይስ፦ <verse eid="JER 21:1"/><verse number="2" style="v" sid="JER 21:2"/>ኤንቲ፥ “ባብሎነ ካዎይ ናቡካዳናፆር ባ ኦላንቾታራ ሀ ካታማ ተቅዳ ግሾ ኑስ ጎዳ ኦይቻ። ኦን ኤር፥ ጎዳይ በንይሳዳ ማላልስያ ኦሱዋ ኑ ግሾ ኦድ፥ እያ ጉየ ዛሮና አገና” ያግዶሶና። <verse eid="JER 21:2"/><verse number="3" style="v" sid="JER 21:3"/>ኤርምያስ ኤንታዉ ዛሪድ፥ “ብድ ሰደቅያሳኮ ያግተ፦ <verse eid="JER 21:3"/><verse number="4" style="v" sid="JER 21:4"/>‘ኔኒ ባብሎነ ካዉዋራነ ግምብያፈ ካረራ ነ ካታማ ተቅዳ እያ ኦላንቾታራ ኦለትያነ ነ ኩሸን ደእያ ኦላ ሚሽያ ታ ነ ቦላ ዛራና፤ ኤንታ ኡባ ሀ ካታማ ግዶ ገልሳና። <verse eid="JER 21:4"/><verse number="5" style="v" sid="JER 21:5"/>ታኒ፥ ታ ሁጰን ሴራስ ምጨትዳ ኩሸን፥ ዎልቃማ ቀስያን፥ ይሎን፥ ሀንቆንነ ዎልቃማ ጋዶን ነና ኦላና። <verse eid="JER 21:5"/><verse number="6" style="v" sid="JER 21:6"/>ታ ሀ ካታማን ደእያ አሳነ መህያ ሾጫና፤ ኤንቲ ኢታ ጋዶን ዉራና። <verse eid="JER 21:6"/><verse number="7" style="v" sid="JER 21:7"/>ሄሳፈ ጉየ፥ ይሁዳ ካዋ ሰደቅያሳ፥ እያ ሞርናታ፥ ጋዶፐ፥ ማሻፈነ ኮሻፐ አትዳ፥ ሀ ካታማ አሳ ኡባ፥ ባብሎነ ካዋ ናቡካዳናፆራስነ ኤንታ ዎናዉ ኮይያ ሞርከታስ አዳ እማና። እ ኤንታ ቃራ ማሻን ጎይራና። እ ኤንታዉ ቃተና፤ ሳለትድ አገና፤ ማረና’ ” ያጌስ ጎዳይ እስራኤለ ፆሳይ።<verse eid="JER 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 21:8"/>ጎዳይ ኤርምያሳኮ፥ “ጉጃዳ አሳኮ ሀይሳዳ ያጋ፦ ታ ህንተ ስንን ደኦ ኦግያነ ሀይቆ ኦግያ ዎስ። <verse eid="JER 21:8"/><verse number="9" style="v" sid="JER 21:9"/>ሀ ካታማን ጋምእያ ኦንካ ማሻን ዎይኮ ኮሻን ዎይኮ ጋዶን ሀይቃና። ሽን ካታማፐ ከይድ ካታማ ተቅድ ኦይክዳ ባብሎነታስ ባ ኩሽያ እምያ ኦንካ ፓፃ አታና፤ ሄ ኡራይ ባ ሸምፑዋ አሻና። <verse eid="JER 21:9"/><verse number="10" style="v" sid="JER 21:10"/>ታኒ ሀ ካታማ ቦላ ሎኦባ ግዶናሽን ኢታባ ኦናዉ ደንዳስ። ታ እያ ባብሎነ ካዋስ አዳ እማና፤ እ ሀ ካታማ ታማን ፁጋና” ያጌስ ጎዳይ።<verse eid="JER 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 21:11"/>ይሁዳ ካዋ ኬ አሳስ ሀይሳዳ ያጋ፦ ጎዳ ቃላ ስእተ! <verse eid="JER 21:11"/><verse number="12" style="v" sid="JER 21:12"/>ህንተኖ፥ ዳዊታ ኮቻቶ፥ ጎዳይ ህንተኮ ሀይሳዳ ያጌስ፤ “ዎንታ ዎንታ ሱረ ፕርድተ፤ ቦንቀትዳይሳታ ኡንኤያ አሳ ኩሸፐ አሽተ። ሄሳ ህንተ ኦና እፅኮ፥ ህንተ ኢታ ኦሱዋ ጋሶን ታ ሀንቆይ ታማዳ ኤፃና፤ ኦንካ እያ ቶይሰና” ያጌስ ጎዳይ።<verse eid="JER 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 21:13"/>ነኖ፥ የሩሳላመ፥ ደንባን ደእያ ዛላዳ፥ ዛንጋራፐ ቁ ጋዳ በንታሳ፤ ሽን ታ ነና ኦላና። ኔኒ፥ “ኦንካ ታ ቦላ ፃለና ዎይኮ ታ ደእያ በሳ ገለና” ያጋሳ።<verse eid="JER 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 21:14"/>ሽን፥ “ታኒ ጎዳይ ነና ነ ኦሱዋዳ ሴራና። ታኒ ነ ካዎ ኬን ታማ ኦይና፤ ነ ዩሹዋን ደእያ ኡባ ምድ ይሳና” ያጌስ ጎዳይ።<verse eid="JER 21:14"/></para>
  <chapter eid="JER 21"/>
  <chapter number="22" style="c" sid="JER 22"/>
  <para style="s1">ኢታ ካዎታ ቦላ ፆሳ ፕርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 22:1"/>ጎዳይ ሀይሳዳ ያጌስ፤ “ዱገ ይሁዳ ካዋ ጋ ባዳ፥ ያን ሀ ቃላ ኦዳ። <verse eid="JER 22:1"/><verse number="2" style="v" sid="JER 22:2"/>‘ነኖ ይሁዳ ካዋዉ፥ ዳዊታ አራታን ኡትዳይሶ፥ ኔኒ፥ ነ ሞርናትነ ሀ ፐንግያራ ገልያ ነ አሳይ ጎዳ ቃላ ስእተ! <verse eid="JER 22:2"/><verse number="3" style="v" sid="JER 22:3"/>ሱረ ፕርዳ ፕርድተ፤ ፅሎ ኦተ። ቦንቀትዳይሳ ኡንኤያ አሳ ኩሸፐ አሽተ። በተ አሳስ፥ ይኦታስነ አምኤታስ ገነ ኦፕተ ዎይኮ ሱጎፕተ። ፅሎ አሳ ሱ ሀ በሳን ጉሶፍተ። <verse eid="JER 22:3"/><verse number="4" style="v" sid="JER 22:4"/>ሀ ኪታታ ህንተ ናግኮ፥ ዳዊታ አራታን ኡትያ ካዎት ፓራነ ፓራ ጋረ ቶግድ፥ ባንታ ሞርናታራነ ባንታ አሳራ ሀ ካዎ ጋ ፐንግያራ ገላና። <verse eid="JER 22:4"/><verse number="5" style="v" sid="JER 22:5"/>ሽን ህንተ ኪተቶና እፅኮ፥ ሀ ካዎ ጋይ ባይሳ ግዳና ያጋዳ ታ ጎዳይ ታ ሁጰን ጫቃስ’ ” ያጌስ ጎዳይ።<verse eid="JER 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 22:6"/>ጎዳይ ይሁዳ ካዎ ጋዋባ ሀይሳዳ ያጌስ፦ “ኔኒ ታዉ ጋላዳ ቢታነ ልባኖሰ ዙማ መላ ግድኮካ፥ ታ ነና መላ ቢታነ አስ ዶና ካታማ ኦና። <verse eid="JER 22:6"/><verse number="7" style="v" sid="JER 22:7"/>ታኒ ነና ላልያ አሳ ኦላ ሚሸ ኦይዳ ኪታና፤ ኤንቲ ነ ዝጋ ቱቀታ ቃንፀረድ፥ ታማን የጋና።<verse eid="JER 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 22:8"/>“ዱማ ዱማ ካዎተታፐ አሳይ ሄ ካታማ ማታራ አሸ፥ ‘ጎዳይ አይስ ሀ ግታ ካታማ ሀይሳዳ ኦዴ?’ ያግድ እሶይ እሱዋ ኦይቻና። <verse eid="JER 22:8"/><verse number="9" style="v" sid="JER 22:9"/>ኤንቲ ዛሪድ፥ ‘ጎዳ ባንታ ፆሳራ ጫቅዳ ጫቁዋ መንድ፥ ሀራ ፆሳታ ጎይንዳ ግሾነ ኦዳ ግሾሳ’ ” ያጋና።<verse eid="JER 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 22:10"/>ሀይቅዳ ካዋ እዮስያሳስ ዬኮፍተ ዎይኮ ካዮቶፍተ። ሄሳ አግድ፥ ድኤትድ ብዳ ሳሎማስ<note caller="+" style="f"><char style="fr" closed="false">22:10 </char><char style="ft" closed="false">ሳሎማስ ሀራ ሱንይ እዮአካዛ። እዮአካዝ ካዎተ ሱን ግድሽን፥ ሳሎም ሶ ሱን ዎይኮ ቡዞ ሱን።</char></note>ሴለትድ ዬክተ። እ ጉየ ስመና፤ ባ የለትዳ ቢታ ዛሪድ በኤና።<verse eid="JER 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 22:11"/>ባ አዋ በሳን ይሁዳን ካዎትድ ደእሸ፥ ሀ በሳፈ ብዳ እዮስያሳ ናአ ሳሎማባ ጎዳይ ሀይሳዳ ያጌስ። “እ ጉየ ስመና። <verse eid="JER 22:11"/><verse number="12" style="v" sid="JER 22:12"/>እ ድኤትድ ብዳ ቢታን ሀይቃና፤ ስሚድ ሀ ቢታ በኤና” ያጌስ ጎዳይ።<verse eid="JER 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 22:13"/>ባ ኬ ገነን ኬፀይሳ፥ ጌላ ኦገን ፖቀ ቦላ ፖቀ ጉጀይሳ፥ ባ አሳስ አይኮካ እሞናነ ጋቴ ቃንፆና ኦስሰይሳ አየ! <verse eid="JER 22:13"/><verse number="14" style="v" sid="JER 22:14"/>ሄ ኡራይ፥ “ታኒ ታዉ ግታ ፖቀይ ደእያ ዳልጋ ኬ ኬፃና” ያግድ፥ ባ ኬስ ዳልጋ ማስኮተታ ከስድ፥ ዝጋ ምን አሌቅስድ፥ ዞኦ ቃላመ ትዬስ።<verse eid="JER 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 22:15"/>ነ ዳሮ ዝጋን ኬፅዳይስ ነና ሎኦ ካዎ ከሴስ ጋዳ ቆፓይ? ነ አዋ እዮስያሳስ ምያባይነ ኡያባይ ይዴ? እ ሱረ ፕርዳ ፕርድስ፤ ፅሎ ኦስ። ሄሳ ግሾ፥ እያዉ ኡባባይ እንጀትስ። <verse eid="JER 22:15"/><verse number="16" style="v" sid="JER 22:16"/>እ ማንቆታስነ መቶታንቾታስ ሱረ ፕርድያ ግሾ፥ ኡባባይ እያዉ እንጀትስ። ጎዳ ኤሬስ ጉሳይ ሀይሳ። <verse eid="JER 22:16"/><verse number="17" style="v" sid="JER 22:17"/>ሽን ነ አይፈይነ ነ ዎዛናይ ሸምፕዳይ፥ ጭሞን ጎአ ደሞ፥ ፅሎ ሱ ጉሶ፥ ገነነ ኡንኤ ቦላና።<verse eid="JER 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 22:18"/>ሄሳ ግሾ፥ ጎዳይ እዮስያሳ ናኣ፥ ይሁዳ ካዋ እዮአቄማባ ሀይሳዳ ያጌስ፦ “እ ሀይቅያ ዎደ ኤንቲ እያዉ፥ ‘ዎ፥ ታ እሻዉ፥ ዎ ታ እሻዉ’ ያግድ ዬኮኮና። ቃስ፥ ‘ዎ፥ ታ ጎዳዉ፥ ዎ፥ ታ ካዋዉ’ ያግድ ዘሌሎኮና። <verse eid="JER 22:18"/><verse number="19" style="v" sid="JER 22:19"/>እያ ሞጎይካ ሀረ ሞጎ መላ ግዳና። እያ አሀይ ጎሸትድ፥ የሩሳላመ ፐንገታፐ ያ ባጋን የገታና” ያጌስ ጎዳይ።<verse eid="JER 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 22:20"/>ጎዳይ የሩሳላመባ ሀይሳዳ ያጌስ፦ “ኦላስ ኔራ ዙፐተይሳት ኡባይ ፆነትዳ ግሾ፥ ፑደ ልባኖሰ ባዳ፥ ያን ዋሳ። ባሳነ ቢታን ዋሶ ሱልሳ፤ አባሪማ ዙማን ዋሳ። <verse eid="JER 22:20"/><verse number="21" style="v" sid="JER 22:21"/>ነ ሳሮ ደእያ ዎደ ታ ነዉ ኦዳስ፤ ሽን ነ ታና ስኦና እፃዳሳ። ነ ናአተፈ ዶምን ነ ሀኖይ ሀይሳ፤ ነ ታዉ ኪተቶና እፃዳሳ። <verse eid="JER 22:21"/><verse number="22" style="v" sid="JER 22:22"/>ነ ሄንንቾታ ኡባ ጫርኮይ ኤፋና፤ ኦላስ ኔራ ዙፐተይሳት ድኤትድ ባና። ሄ ዎደ ነ ኢታተ ኡባ ግሾ ዬላታናነ ካዉያና። <verse eid="JER 22:22"/><verse number="23" style="v" sid="JER 22:23"/>ህንተኖ፥ ልባኖሰ ዝጋን ኬፀትዳ ኬን ደኤይሳቶ፥ እቀ ኦይክዳ ማጫሳዳ ኡንእ ህንተ ቦላ ፑቱ ጊኮ ህንተ ዋናኔ?” ያጌስ።<verse eid="JER 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 22:24"/>ጎዳይ ሀይሳዳ ያጌስ፦ “ታ ደኦይ ኤሮ! ኔኒ እዮአቄማ ናአይ፥ ይሁዳ ካዎይ ዮአክን፥ ታ ኡሻቻ ኩሸን ደእያ ታ ማታሜ ዎያ ምግዶ ግድያኮካ ታ ነና ከሳ የጋና። <verse eid="JER 22:24"/><verse number="25" style="v" sid="JER 22:25"/>ነና ዎናዉ ኮየይሳታስ፥ ነ ያይያ ባብሎነ ካዋ ናቡካዳናፆራስነ እያ ኦላንቾታስ ታ ነና አዳ እማና። <verse eid="JER 22:25"/><verse number="26" style="v" sid="JER 22:26"/>ታ ነናነ ነ አይዉ ህንተ የለቶና ሀራ ቢታ ሆላና፤ ህንተ ናምአይካ ያን ሀይቃና። <verse eid="JER 22:26"/><verse number="27" style="v" sid="JER 22:27"/>ህንተ ስማናዉ ላሞትያ ቢታ ፖሎ ስመከታ” ያጌስ።<verse eid="JER 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 22:28"/>ሀ አደይ ዮአክን፥ ካትዳነ መቅዳ ፁጌ? እ፥ ኦንካ ኮዮና ሚሼ? እነ እያ ናይት አይስ ጎደትድ፥ ኤሮና ቢታን የገትድ አትዶና? <verse eid="JER 22:28"/><verse number="29" style="v" sid="JER 22:29"/>ቢተ፥ ቢተ፥ ቢተ፥ ጎዳ ቃላ ስአ! <verse eid="JER 22:29"/><verse number="30" style="v" sid="JER 22:30"/>“እያ ኮቻፈ እሱዋስካ እንጀቶና ግሾነ ዳዊታ አራታን ኡትያ ዎይኮ ይሁዳን ካዎትያ አስ እሶይካ ባይና ግሾ፥ ሀ አድያ፥ ናእ ባይና አስ፥ ባ ላይ ኡባን ደኦይ እንጀቶና አስ” ጋዳ ፃፋ ያጌስ ጎዳይ።<verse eid="JER 22:30"/></para>
  <chapter eid="JER 22"/>
  <chapter number="23" style="c" sid="JER 23"/>
  <para style="s1">ፅሎ አጫ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 23:1"/>“ታ ሄን በሳን ደእያ ዶርሳታ ይስያነ ላልያ ሄንንቾታ አየ!” ያጌስ ጎዳይ።<verse eid="JER 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 23:2"/>ጎዳይ፥ እስራኤለ ፆሳይ፥ ባ አሳ ሄምያ ሄንንቾታ ሀይሳዳ ያጌስ፦ “ህንተ ታ ዶርሳታ ላልዳ ግሾ፥ ጎድዳ ግሾ፥ ናግቦና ግሾነ ህንተ ኦዳ ህንተ ኢታ ኦሱዋ ግሾ ታ ህንተና ሴራና። <verse eid="JER 23:2"/><verse number="3" style="v" sid="JER 23:3"/>ታ ዉድያፐ አትዳይሳታ ታ ካሰ ላልዳ ቢታ ኡባፈ ታ ሁጰን ሺሻና። ኤንታ ጉየ ኤንታ ሄን በሳ ዛራና፤ ኤንቲ ያን የለትድ ዳራና። <verse eid="JER 23:3"/><verse number="4" style="v" sid="JER 23:4"/>ኤንታ ሎይድ ሄምያ ሄንንቾታ ኤንታዉ ሹማና። ኤንቲ ዛሪድ ያዮኮና፤ ዳጋሞኮና፤ ኤንታፈ እሶይካ የና” ያጌስ ጎዳይ።<verse eid="JER 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 23:5"/>“ዳዊታ ኮቻፈ ፅሎ አጫ ደንና ዎደይ ያና። እ ካዎተ ጭንጫተን አይሳና፤ ቢታ ቦላ ሱረነ ፅሎ ኦና። <verse eid="JER 23:5"/><verse number="6" style="v" sid="JER 23:6"/>እያ ካዎተ ዎድያን ይሁድ አታና፤ እስራኤለይ ሳሮ ዳና። እያ ሱንይ፥ ‘ፆሳይ ኑ ፅሎተ’ ጌተታና” ያጌስ ጎዳይ።<verse eid="JER 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 23:7"/>ሄሳ ግሾ፥ “አሳይ፥ ‘እስራኤላ አሳ ግብፀ ቢታፈ ከስዳ ጎዳይ ኤርያ መላ’ ያግድ ጫቃናይሳ አግድ፥ <verse eid="JER 23:7"/><verse number="8" style="v" sid="JER 23:8"/>‘እስራኤላ ኮቻ ፑደሀ ባጋ ቢታፈነ ኤንታ ላልዳ ቢታ ኡባፈ ኤህዳ ጎዳይ ኤርያ መላ’ ያግድ ጫቃና ዎደይ ያና። ሄሳፈ ጉየ፥ ኤንቲ ባንታ ቡዞ ቢታን ዳና” ያጌስ ጎዳይ።<verse eid="JER 23:8"/></para>
  <para style="s1">ዎርዶ ናበታ</para>
  <para style="p">
    <verse number="9" style="v" sid="JER 23:9"/>ናበታባ ታ ቆፕያ ዎደ ታ ዎዛናይ ዳቡሬስ፤ ታ መቀት ኮኮሮሶና። ጎዳ ግሾነ እያ ጌሻ ቃላ ግሾ ዎይነይ ፆንን ማትዳ አስ ግዳስ። <verse eid="JER 23:9"/><verse number="10" style="v" sid="JER 23:10"/>ቢታይ ላይማተን ኩምስ። ቃንገ ግሾ፥ ቢታይ ዬኬስ፤ ባዞ ሄን በሳት መልዶሶና። ናበት ኢታ ኦገን ሄመቶሶና፤ ባንታ ማታ ልከ ግዶና ኦገን ጎኤቶሶና።<verse eid="JER 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 23:11"/>“ናበትነ ካህነት ቱንዶሶና፤ ሀር አቶሽን ታ ኬን ኤንቲ ኦያ ኢታ ታ በአስ” ያጌስ ጎዳይ።<verse eid="JER 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 23:12"/>“ሄሳ ግሾ፥ ኤንታ ኦገይ ሀልፃና፤ ኤንቲ ማን የገታና፥ በትድ ኩንዳና። ኤንቲ ሴረትያ ዎደ ኤንታ ቦላ ጋዶ ኤሀና” ያጌስ ጎዳይ።<verse eid="JER 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 23:13"/>“ሳማረ ናበታ ግዶን ኢታባ በአስ። ኤንቲ ባኣለ ሱንን ትንብተ ኦዶሶና፤ ታ አሳ እስራኤለ ባለሶና። <verse eid="JER 23:13"/><verse number="14" style="v" sid="JER 23:14"/>ቃስ የሩሳላመ ናበታ ግዶንካ ሀይስ ዴፅያባ በአስ። ኤንቲ ላይማቶሶና፤ ዎርዶትድ ደኦሶና። ኦንካ ባ ኢታ ኦሱዋፐ ስሞና መላ ኤንቲ ኢታ ኦይሳታ ምንሶና። ኤንቲ ኡባይ ታዉ ሶዶማ መላ፤ የሩሳላመ አሳይ ጋሞራ መላ” ያጌስ ጎዳይ።<verse eid="JER 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 23:15"/>ሄሳ ግሾ፥ ኡባፈ ዎልቃማ ጎዳይ ናበታባ ሀይሳዳ ያጌስ፦ “የሩሳላመ ናበታ ዶናፐ ቱናባይ ከይድ፥ ቢታ ኡባን ላለትዳ ግሾ፥ ታ ኤንታ ጫምያ ካ ሙዛና፤ ኤንታ ዎያ ሃ ኡሻና” ያጌስ።<verse eid="JER 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 23:16"/>“ናበት ኦድያባ ስኦፕተ፤ ኤንቲ ሀኖና ኡፋይሳን ኩንሶና። ጎዳይ ኦዶናሽን ኤንቲ ባንታፈ መ ከስድ ቆንጨ ኦዶሶና። <verse eid="JER 23:16"/><verse number="17" style="v" sid="JER 23:17"/>ታና ካይሳታኮ፥ ‘ህንተ ሳሮ ዳና’ ያጎሶና፤ ቃስ ባንታ ዎዛና ኢታተ ካለይሳታኮ፥ ‘ህንተና ኢታባይ ጋከና’ ያጎሶና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 23:18"/>“ሽን በአናዉ ዎይኮ እያ ቃላ ስአናዉ ጎዳይ ዞርያ በሳን ኤንታፈ ኦነ ኤቅዳይ? እያ ቃላ ስእዳይ ኦኔ? <verse eid="JER 23:18"/><verse number="19" style="v" sid="JER 23:19"/>ጎዳ ጎተይ ሀንቆን ደንዳና፤ ዎልቃማ ሆበይ ኢታታ ሁጵያ ሾጫና። <verse eid="JER 23:19"/><verse number="20" style="v" sid="JER 23:20"/>ባ ዎዛና ቆፋ ፖሎና ደእሸ፥ ጎዳ ሀንቆይ ስመና። ዉርሰ ዎድያን ሀይሳ ህንተ አኬካና። <verse eid="JER 23:20"/><verse number="21" style="v" sid="JER 23:21"/>ታ ሀ ናበታ ኪታብከ፤ ሽን ኤንቲ ባንታ ኪታ ኤክድ ዎፆሶና። ታ ኤንታዉ ኦዳብከ፤ ሽን ኤንቲ ትንብተ ኦዶሶና። <verse eid="JER 23:21"/><verse number="22" style="v" sid="JER 23:22"/>ኤንቲ ታ ዞርያ በሳን ኤቅዳባ ግድያኮ፥ ታ ቃላ፥ ታ አሳስ ኦዳናሽን። ኤንቲ ኢታ ኦግያፐነ ኤንታ ኢታ ኦሱዋፐ ዛራናሽን” ያጌስ ጎዳይ።<verse eid="JER 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 23:23"/>“ታ ማታ ፃላላ ፆሴ? ሃሆ ፆሲ ግድክና? <verse eid="JER 23:23"/><verse number="24" style="v" sid="JER 23:24"/>ታ በኦናዳ፥ አስ ጌማ በሳን ባና ቆሳናዉ ዳንዳኢ? ሳሎንነ ሳአን ኩምዳይ ታና ግድክና?” ያጌስ ጎዳይ።<verse eid="JER 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 23:25"/>“ታ ሱንን ዎርዶ ትንብተ ኦደይሳት ግያባ ስአስ። ኤንቲ፥ ‘ታ አሙሆ በአስ፤ ታ አሙሆ በአስ’ ያጎሶና። <verse eid="JER 23:25"/><verse number="26" style="v" sid="JER 23:26"/>ሀ ናበት ባንታዉ መድ ከስድ ኦድያ ዎርዶ ትንብተይ ኤንታ ዎዛናን አዉደ ጋካናዉ ጋምአኔ? <verse eid="JER 23:26"/><verse number="27" style="v" sid="JER 23:27"/>ኤንታ አዋት ባኣለ ኤቃ ጎይንድ ታ ሱን ዶግዳይሳዳ፥ ኤንቲ እሶይ እሱዋስ ኦድያ አሙሁዋን፥ ታ አሳይ ታ ሱን ዶጋና መላ ኦናዉ ቆፖሶና። <verse eid="JER 23:27"/><verse number="28" style="v" sid="JER 23:28"/>አሙሆ አሙህያ ናበይ ባ አሙሁዋ ኦዶ፤ ሽን ታ ቃላ ስእያ ናበይ ታ ቃላ አማነትድ ኦዶ። ዳልነ ግስተይ አዉን ጋሄቲ? <verse eid="JER 23:28"/><verse number="29" style="v" sid="JER 23:29"/>ታ ቃላይ ታማ መላ ግደኔ? ዛላ መንረያ ናርቃ መላ ግደኔ?” ያጌስ ጎዳይ።<verse eid="JER 23:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 23:30"/>“ሄሳ ግሾ፥ ታ ቃላ እሶይ እሱዋፈ ካይሶትድ ታፐ ኤክዳ ዳንስድ ትንብተ ኦድያ ናበታ ታ እፃይስ። <verse eid="JER 23:30"/><verse number="31" style="v" sid="JER 23:31"/>ሄሳዳካ፥ ባንታ ዎዛና ቆፋ ኦድሸ፥ ‘ጎዳይ ያጌስ’ ግያ ናበታካ ታኒ እፃይስ። <verse eid="JER 23:31"/><verse number="32" style="v" sid="JER 23:32"/>ዎርዶ አሙህሸ ትንብተ ኦድያ ናበታ ቦላ ታ ደንዳና። ኤንቲ ባንታ አሙሁዋን ካትድ ትንብተ ኦድያ ናበታ ታኒ እፃይስ። ታ ኤንታ ኪቶናሽን ዎይኮ ሹሞናሽን ዎርዶ ትንብተ ኦዶሶና፤ ታ አሳ ባለሶና። ኤንቲ ሀ አሳ አይኮካ ማዶኮና” ያጌስ ጎዳይ።<verse eid="JER 23:32"/></para>
  <para style="s1">ጎዳ ኪታ</para>
  <para style="p">
    <verse number="33" style="v" sid="JER 23:33"/>“ጎዳይ ታኮ፥ ‘ሀ አሳይ ዎይኮ ናበይ ዎይኮ ካህነይ፥ ጎዳ ኪታይ አይቤ?’ ግድ ኦይችኮ፥ ነ ኤንታኮ፥ ‘ጎዳይ፥ ታ ህንተና ሆላና’ ያጌስ” ጋዳ ኦዳ።<verse eid="JER 23:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JER 23:34"/>“ናበይ ዎይኮ ካህነይ ዎይኮ አሳይ፥ ‘ሀይስ ጎዳ ኪታ’ ያግድ ኦድኮ፥ ታ ሄ አድያነ እያ ሶ አሳ ሴራና። <verse eid="JER 23:34"/><verse number="35" style="v" sid="JER 23:35"/>ሄሳ አግድ እሶይ እሶይ፥ ‘ጎዳይ ዎይግዴ? ዎይኮ ጎዳይ አይ ኦድዴ?’ ያግድ ባ ላገታነ ባ ዳቦታ ኦይቻናዉ በሴስ። <verse eid="JER 23:35"/><verse number="36" style="v" sid="JER 23:36"/>ህዛፐ ኦንካ፥ ‘ጎዳ ኪታ’ ያግድ ዛሪድ ኦደታናዉ በሰና። ሄሳ ግሾ፥ እያ ዶናፐ ከይያ ቃላይ እያዉ ኪታ ግድያ ግሾ፥ ደኦ ፆሳ፥ ኡባፈ ዎልቃማ ጎዳ፥ ኑ ፆሳ ቃላ ህንተ ምርቄታ። <verse eid="JER 23:36"/><verse number="37" style="v" sid="JER 23:37"/>ኔኒ ናበታኮ፥ ‘ጎዳይ ህንተና ዎይግዴ?’ ዎይኮ ‘አይ ኦድዴ?’ ያጋዳ ኦይቻናዉ በሴስ። <verse eid="JER 23:37"/><verse number="38" style="v" sid="JER 23:38"/>ሽን ህንተ፥ ‘ሀይስ ጎዳ ኪታ’ ጊኮ፥ ጎዳይ ሀይሳዳ ያጌስ፦ ታኒ ህንተና፥ ‘ሀይስ ጎዳ ኪታ ጎፕተ’ ያግንካ ህንተ፥ ‘ሀይስ ጎዳ ኪታ’ ግደታ። <verse eid="JER 23:38"/><verse number="39" style="v" sid="JER 23:39"/>ሄሳ ግሾ፥ ታ ህንተና ዶጋና፤ ህንተናነ ህንተ አዋታስ እምዳ ካታማ ኩመ ታ ስንፈ ድጋና። <verse eid="JER 23:39"/><verse number="40" style="v" sid="JER 23:40"/>ታ ህንተ ቦላ መርና ካዉሻነ ዶገቶና ዬላ ኤሀና” ያጌስ ጎዳይ።<verse eid="JER 23:40"/></para>
  <chapter eid="JER 23"/>
  <chapter number="24" style="c" sid="JER 24"/>
  <para style="s1">ባላሰ አይፈይ ደእያ ናምኡ ዳቾታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 24:1"/>ካዎይ ናቡካዳናፆር፥ እዮአቄማ ናኣ፥ ይሁዳ ካዋ እኮንያና፥ ይሁዳ ሀላቃታራ፥ ኩሸ ሂላታራነ ብራታ ቆፀይሳታራ የሩሳላመፐ ባብሎነ ድእድ ኤፍዳፐ ጉየ፥ ጎዳይ ታና ቆንጨ በስስ። ጎዳይ ታና፥ ፆሳ ኬስ ስን ባጋራ ባላሰይ ደእያ ናምኡ ኬሸታ በስስ። <verse eid="JER 24:1"/><verse number="2" style="v" sid="JER 24:2"/>እስ ኬሽያን ኮይሮ ቴርዳ ዳንያ ሎኦ ባላሰይ ደኤስ፤ ሀንኮ ኬሽያን ቃስ ማናዉ ጊጎና ኢታ ባላሰይ ደኤስ። <verse eid="JER 24:2"/><verse number="3" style="v" sid="JER 24:3"/>ጎዳይ ታኮ፥ “ኤርምያሳ፥ ነ በኤይ አይቤ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="JER 24:3">ታኒ፥ “ባላሰ በአይስ፤ ሎኦ ቴራይ ዳሮ ሎኦ፤ ኢታ ቴራይ ቃስ ማናዉ ጊጎና ዳሮ ኢታ” ያጋስ።<verse eid="JER 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 24:4"/>ሄሳፈ ጉየ፥ ጎዳ ቃላይ ታኮ ይስ፦ <verse eid="JER 24:4"/><verse number="5" style="v" sid="JER 24:5"/>ጎዳይ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ “ይሁዳ ቢታፈ ድኦን ባብሎነ ቢታ የድዳ አሳታ፥ ሀ ሎኦ ባላሰ ቴራዳ ሎኦ ጋና። <verse eid="JER 24:5"/><verse number="6" style="v" sid="JER 24:6"/>ታኒ ሎኦ አይፈን ኤንታ ፄላና፤ ቃስ ኤንታ ዛራዳ ሀ ቢታ ኤሀና። ታ ኤንታ ኬፃናፐ አትሽን፥ ላልከ፤ ኤንታ ቶካናፐ አትሽን፥ ሾድከ። <verse eid="JER 24:6"/><verse number="7" style="v" sid="JER 24:7"/>ታኒ ጎዳ ግድዳይሳ ኤንቲ ኤራና መላ ኤንታዉ ዎዛና እማና። ኤንቲ ባንታ ኩመ ዎዛናፐ ታኮ ስማናዉ ደእያ ግሾ፥ ኤንቲ ታ አሰ ግዳና፤ ታ ኤንታ ፆሰ ግዳና” ያጌስ።<verse eid="JER 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 24:8"/>ግዶሽን፥ “ይሁዳ ካዋ ሰደቅያሳ፥ እያ ሞርናታ፥ ሀ ቢታን ግድን የሩሳላመን አትዳ አሳነ ግብፀ ቢታን ደኤይሳታ ማናዉ ጊጎና ዳሮ ኢታ ባላሰ ቴራዳ ኢታ ጋና። <verse eid="JER 24:8"/><verse number="9" style="v" sid="JER 24:9"/>ታኒ ኤንታ ጎዳዳ የድያ ቢታ ኡባን፥ ሀ ሳአ ካዎተት ኤንታ በእድ ዳጋማና። ታኒ ኤንታ እፀትዳይሳታ፥ ጫየትዳይሳታ፥ ቦረትዳይሳታ፥ ሌምሰተይሳታ፥ ቀልቅሰተይሳታ፥ ባደትዳይሳታ ኦና። <verse eid="JER 24:9"/><verse number="10" style="v" sid="JER 24:10"/>ታ ኤንታዉነ ኤንታ ማይዛታስ እምዳ ቢታፈ ኤንቲ ፖሎ ያና ጋካናዉ ማሻ፥ ኮሻነ ቦሻ ኤንታ ቦላ የዳና” ያጌስ ጎዳይ።<verse eid="JER 24:10"/></para>
  <chapter eid="JER 24"/>
  <chapter number="25" style="c" sid="JER 25"/>
  <para style="s1">ላፑን ታሙ ላይ አይለተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 25:1"/>እዮስያሳ ናአይ፥ ይሁዳ ካዎይ እዮአቄም ካዎትዳ ኦይዳን ላይን፥ ባብሎነ ካዎይ ናቡካዳናፆር ካዎትዳ ኮይሮ ላይን፥ ይሁዳ አሳባይ ኤርምያሳኮ ይዳ ቃላይ ሀይሳ። <verse eid="JER 25:1"/><verse number="2" style="v" sid="JER 25:2"/>ናበይ ኤርምያስ ይሁዳ ኡባስነ የሩሳላመን ደእያ ኡባስ ሀይሳዳ ያግስ፦ <verse eid="JER 25:2"/><verse number="3" style="v" sid="JER 25:3"/>አሞፀ ናአይ፥ ይሁዳ ካዎይ፥ እዮስያስ ካዎትዳ ታማነ ሄን ላይፈ ዶምድ፥ ሀች ጋካናዉ፥ ላታማነ ሄ ላይ ጎዳ ቃላይ ታኮ ይስ። ታ ህንተዉ ዛራ ዛራ ኦዳስ፤ ሽን ህንተ ስኦና እፅደታ።<verse eid="JER 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 25:4"/>ጎዳይ ባ አይለታ፥ ናበታ ኡባ ዛር ዛር ህንተኮ ኪትስ፤ ሽን ህንተ ስኦና እፅደታ። <verse eid="JER 25:4"/><verse number="5" style="v" sid="JER 25:5"/>ኤንቲ፥ “ህንተ ኡባይ ህንተ ኢታ ኦግያፐነ ህንተ ኢታ ኦሱዋፐ ስምተ። ጎዳይ ህንተዉነ ህንተ ማይዛታስ መርናዉ እምዳ ቢታን ህንተ ዳና። <verse eid="JER 25:5"/><verse number="6" style="v" sid="JER 25:6"/>ሀራ ፆሳታ ጎይናናዉነ ኤንታዉ ኦናዉ ካሎፍተ። ቃስ ህንተ፥ ህንተ ኩሸን ኦዳ ኤቃታን ጎዳ ሀንቁዋ ደንፍተ። ሄስ ሀንኮ ጎዳይ ህንተና ቆሄና” ያግዶሶና።<verse eid="JER 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 25:7"/>“ህንተ ታ ኦድዳይሳ ስኦና እፅድ፥ ህንተ ኩሸይ ኦዳባን ታና ይሎይደታ። ህንተ፥ ህንተና ቆህያባ ኦደታ” ያጌስ ጎዳይ።<verse eid="JER 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 25:8"/>“ሄሳ ግሾ፥ ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፦ ህንተ ታ ቃላስ ኪተቶና እፅዳ ግሾ፥ <verse eid="JER 25:8"/><verse number="9" style="v" sid="JER 25:9"/>ፑደሀ ባጋ አሳ ኡባነ ታ አይልያ ባብሎነ ካዋ ናቡካዳናፆራ ፄጋና። ኤንታ ሀ ቢታ ቦላ፥ ሀ ቢታን ደእያ አሳ ቦላነ ሄራን ደእያ ካዎተታ ኡባ ቦላ ኤሀና። ታ ሀ ቢታ ኩመ ይሳና፤ ቃስ በእዳ ኡባይ ሻትያባነ ቀልቅስያባ ኦና” ያጌስ ጎዳይ። <verse eid="JER 25:9"/><verse number="10" style="v" sid="JER 25:10"/>ኤንታ ግዶፈ እልልስነ ኡፋይሳ ቃላ፥ ያጋኖ ግርስ፥ ዎፃ ግርስነ ፆምፐ ፖኦ ይሳና። <verse eid="JER 25:10"/><verse number="11" style="v" sid="JER 25:11"/>ሀ ቢታይ ኩመ ላለትዳነ ባይሳ ቢታ ግዳና፤ ካዎተት ባብሎነ ካዋስ ላፑን ታሙ ላይ ሃረታና።<verse eid="JER 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 25:12"/>“ላፑን ታሙ ላይይ ፖለትዳፐ ጉየ፥ ታኒ ባብሎነ ካዋነ እያ አሳ ኤንታ ናጋራ ግሾ ሴራና፤ ኤንታ ቢታ መርናዉ ባይሳ ኦና። <verse eid="JER 25:12"/><verse number="13" style="v" sid="JER 25:13"/>ታ ሀ ቢታ ቦላ ኦድዳ ኡባ፥ ኤርምያስ ካዎተታ ኡባ ቦላ ኦድዳ ትንብትያነ ሀ ማፃፋን ፃፈትዳ ኡባ ሀ ቢታ ቦላ ኤሀና። <verse eid="JER 25:13"/><verse number="14" style="v" sid="JER 25:14"/>ዳሮ ካዎተትነ ግታ ካዎት ባብሎነ አሳ ሃራና። ታ ኤንታዉ፥ ኤንታ ሀኑዋዳነ ኤንታ ኩሸ ኦሱዋዳ ዛራና” ያጌስ ጎዳይ።<verse eid="JER 25:14"/></para>
  <para style="s1">ፆሳ ሀንቆ ፁአ</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 25:15"/>“ታ ሀንቁዋን ኩምዳ ዎይነ ዋንጫ ታ ኩሸፐ ኤካ። ኤፋዳ ታ ነና ኪትያ ካዎተታ ኡባ ኡሻ። <verse eid="JER 25:15"/><verse number="16" style="v" sid="JER 25:16"/>ኤንቲ ኡይድ፥ ታኒ ኤንታ ግዶ የድያ ማሻ ጋሶን ጋንድጋራናነ ጎያና” ያጌስ ጎዳይ እስራኤለ ፆሳይ።<verse eid="JER 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 25:17"/>ታኒ ጎዳ ኩሸፐ ዋንጫ ኤካዳ፥ እ ታና ኪትዳ ካዎተታ ኡባ ኡሻስ። <verse eid="JER 25:17"/><verse number="18" style="v" sid="JER 25:18"/>ሀች ሀንዳይሳዳ ኤንታ ኡባ ዮነ ዳጋማ፥ ጫሸነ ባደ ኦና መላ የሩሳላመነ ይሁዳ ካታማታ፥ እያ ካዎታነ እያ ሞርናታ ኡባ ኡሻስ። <verse eid="JER 25:18"/><verse number="19" style="v" sid="JER 25:19"/>ግብፀ ካዋ፥ እያ አይለታ፥ እያ ሞርናታ፥ እያ ቢታ አሳ ኡባነ <verse eid="JER 25:19"/><verse number="20" style="v" sid="JER 25:20"/>ያን ደእያ አላጋ አሳ ኡባ ኡሻስ። ኦፃ ካዎታ ኡባ ኡሻስ። ፍልስፄመን ደእያ አስቃሎና፥ ጋዛ፥ ኤቅሮናነ አሽዶዳፐ አትዳ ካዎታ ኡባ ኡሻስ። <verse eid="JER 25:20"/><verse number="21" style="v" sid="JER 25:21"/>ኤዶመ፥ ሞአበነ አሞነ ኡሻስ። <verse eid="JER 25:21"/><verse number="22" style="v" sid="JER 25:22"/>ፅሮሳ ካዎታ ኡባ፥ ስዶና ካዎታ ኡባነ መደትራነ አባፈ ሄፍንን፥ ሃሆን ደእያ ካዎታ ኡሻስ። <verse eid="JER 25:22"/><verse number="23" style="v" sid="JER 25:23"/>ደዳና፥ ተማና፥ ቡዛነ ባንታ ሁጵያ ጋፃ ሜድያ አሳ ኡባ ኡሻስ። <verse eid="JER 25:23"/><verse number="24" style="v" sid="JER 25:24"/>አራበ ካዎታ ኡባነ መላ ቢታን ደእያ ዋላካ አሳ ካዎታ ኡባ ኡሻስ። <verse eid="JER 25:24"/><verse number="25" style="v" sid="JER 25:25"/>ዝምራ፥ ኤላማነ ሜዶና ካዎታ ኡባ ኡሻስ። <verse eid="JER 25:25"/><verse number="26" style="v" sid="JER 25:26"/>ፑደሀ ቢታ ካዎታ ኡባ፥ ሃሆንነ ማታን ደእያ ካዎታ ኡባ ካላዳ ካላዳ ሳኣ ቦላ ደእያ ካዎተታ ኡባ ኡሻስ። ኤንታፈ ጉየ ባብሎነ ካዎይ ኡያና።<verse eid="JER 25:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 25:27"/>ጎዳይ ታኮ፥ “ሄሳ ግሾ፥ ‘ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ህንተኮ ሀይሳዳ ያጌስ’ ያጋ። ‘ኡይተነ ማትተ፤ ጮይተነ ኩንድተ። ታኒ ህንተ ግዶ የድያ ማሻ ጋሶን ዛሪድ ደንዶፍተ’ ያግስ። <verse eid="JER 25:27"/><verse number="28" style="v" sid="JER 25:28"/>ሽን ኤንቲ ነ ኩሸፐ ዋንጫ ኤኮናነ ኡዮና እፅኮ፥ ኤንታኮ ሀይሳዳ ያጋ። ‘ኡባፈ ዎልቃማ ጎዳይ ህንተኮ ሀይሳዳ ያጌስ፦ ህንተ ኡያናዉ በሴስ። <verse eid="JER 25:28"/><verse number="29" style="v" sid="JER 25:29"/>ታ ሱንን ፄገትዳ ካታማ ቦላ ኢታባ ኦናዉ ዶማይስ። ያትን ህንተ ሴረቶና አታናዉ ዳንዳኤቲ? ታ ሳአን ደእያ ኡባ ቦላ ማሻ ፄግዳ ግሾ ህንተ ሴረቶና አተከታ’ ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 25:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 25:30"/>“ሄሳ ግሾ፥ ኤርምያሳ፥ ሀ ቃላ ኡባይ ኤንታ ቦላ ፖለታናይሳ ኤንታዉ ኦዳ። ጎዳይ ቃን ጉማና፤ ጎዳይ ባ ጌሻ በሳፈ ባ ጉን ስሳና። እ ባ ቢታ ቦላ ፃጋና፤ ዎይነ ጉምኤይሳት ዋሰይሳዳ ሳአን ደእያ ኡባ ቦላ ዋሳና። <verse eid="JER 25:30"/><verse number="31" style="v" sid="JER 25:31"/>ጎዳስ ካዎተታራ ሞቶይ ደእያ ግሾ እያ ዋሶይ ሳአ ጋፃ ጋክድ ስኤቴስ። ጎዳይ አሳ ኡባራ ፕርደታና፤ እ ኢታታ ማሻስ አድ እማና” ያጌስ ጎዳይ።<verse eid="JER 25:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 25:32"/>“ኢታባይ ካዎተፈ ካዎተ ላለትስ፤ ሳኣ ጋፃፐ ጎተይ ደንድስ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 25:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 25:33"/>ሄ ዎደ ጎዳይ ዎዳይሳታ አሀይ፥ ቢታ ቦላ ሀ ጋፃፐ ያ ጋፃ ጋካናዉ ላለታና። ኤንታዉ ዬከተና፥ ኤንታ አሀይ ሺቀና ዎይኮ ሞገተና፤ ኤንቲ ቢታን ፕቶ መላ ግዳና።<verse eid="JER 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JER 25:34"/>ህንተኖ፥ ሄንንቾቶ፥ ዬክተነ ዋስተ። ህንተኖ፥ ዉድያ ካለይሳቶ፥ ብዶን ጎንዶረትተ። ህንተ ሹከትያ ዎደይ ጋክስ፤ ህንተ ኩንዳናነ ሎኦ ኡርቃ ሚሻዳ መቀረታና። <verse eid="JER 25:34"/><verse number="35" style="v" sid="JER 25:35"/>ሄንንቾት ባቃትድ አትያ በሲ ባዋ፤ ዉድያ ካለይሳት ከስ ኤክያ በሲ ባዋ። <verse eid="JER 25:35"/><verse number="36" style="v" sid="JER 25:36"/>ጎዳይ ኤንታ ሄን ጋድያ ይስያ ግሾ፥ ሄንንቾት ዋስያ ዋሱዋነ ዉድያ ካለይሳት ዬክያ ዬሁዋ ስእተ። <verse eid="JER 25:36"/><verse number="37" style="v" sid="JER 25:37"/>ጎዳ ሱልያ ሸንያ ጋሶን ሳሮ ቢታይ ባይሳታና። <verse eid="JER 25:37"/><verse number="38" style="v" sid="JER 25:38"/>ጋሞይ ባ ደእያ ዎራፐ ከየይሳዳ ጎዳይ ባ ደእያ በሳፈ ከያና። ኤንታ ቢታይ ኡንኤይሳታ ማሻንነ ጎዳ ሱልያ ሀንቁዋን ባይሳ ግዳና።<verse eid="JER 25:38"/></para>
  <chapter eid="JER 25"/>
  <chapter number="26" style="c" sid="JER 26"/>
  <para style="s1">ኤርምያስ ሀይቆፐ አትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 26:1"/>እዮስያሳ ናአይ ይሁዳ ካዎይ እዮአቄም ካዎትዳ ዎደ ጎዳ ቃላይ ይስ። <verse eid="JER 26:1"/><verse number="2" style="v" sid="JER 26:2"/>ጎዳይ፥ “ፆሳ ኬ ዳባባን ኤቃ። ፆሳ ኬን ጎይናናዉ ይሁዳ ካታማታፐ ያ ኡባስ፥ ታ ነና ኪትዳ ቃላፐ እሱዋካ አሾና ኦዳ። <verse eid="JER 26:2"/><verse number="3" style="v" sid="JER 26:3"/>ኤንቲ ስእድ፥ ባንታ ኢታ ኦግያፐ ስማነኮ ኦን ኤር። ሄሳ ግድኮ፥ ታኒ ኤንታ ኢታተ ግሾ ይሳናዉ ቆፕዳይሳ አጋጋና።”<verse eid="JER 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 26:4"/>ኤንታኮ ሀይሳዳ ያጋ፦ “ህንተ ታና ስኦና እፅኮነ ታ ህንተዉ እምዳ ህግያ ኪተቶና እፅኮ፥ <verse eid="JER 26:4"/><verse number="5" style="v" sid="JER 26:5"/>ህንተ ስኦና እፅኮካ ታ ዛራ ዛራዳ ህንተኮ ኪትዳ፥ ታ አይለታ ናበታ ቃላ ስኦናን እፅኮ፥ <verse eid="JER 26:5"/><verse number="6" style="v" sid="JER 26:6"/>ታ ሀ ፆሳ ኬ ሴሎዳ ኦና። ሀ ካታማ ሳአን ደእያ ካዎተታ ኡባስ ባደ ኦና” ያግስ።<verse eid="JER 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 26:7"/>ኤርምያስ ፆሳ ኬን ሀ ቃላ ኦድሽን፥ ካህነት፥ ናበትነ አሳ ኡባይ ስእዶሶና። <verse eid="JER 26:7"/><verse number="8" style="v" sid="JER 26:8"/>ኤርምያስ፥ ጎዳይ፥ ኦዳ ግድ እምዳ ኪታ ኦድድ ኦንግዳ ዎደ ካህነት፥ ናበትነ አሳ ኡባይ እያ ኦይክድ፥ “ነ ሀይቃናዉ በሳሳ” ያግዶሶና። <verse eid="JER 26:8"/><verse number="9" style="v" sid="JER 26:9"/>ኔኒ፥ “ ‘ሀ ፆሳ ኬይ ሴሎዳ ሀናና፤ ቃስ ሀ ካታማይ ያና፤ ባይሳ ግዳና’ ያጋዳ፥ ጎዳ ሱንን አይስ ትንብተ ኦዳዲ?” ያግድ፥ ፆሳ ኬን ሺቅዳ አሳ ኡባይ ኤርምያሳ ተቅዶሶና።<verse eid="JER 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 26:10"/>ይሁዳ ሀላቃት ሄሳ ስእዳ ዎደ፥ ካዎ ጋፐ ከይድ፥ ፆሳ ኬ ይዶሶና። ፆሳ ኬን ኦራ ፐንገ ጌተትያ ፐንግያን ኡትዶሶና። <verse eid="JER 26:10"/><verse number="11" style="v" sid="JER 26:11"/>ካህነትነ ናበት ሀላቃታኮነ አሳ ኡባኮ ሀይሳዳ ያግዶሶና፦ “ህንተ፥ ህንተ ሀይን ስእዳይሳዳ፥ ሀ አደይ ሀ ካታማ ቦላ ትንብተ ኦድዳ ግሾ፥ እ ሀይቃናዉ በሴስ!” ያግዶሶና።<verse eid="JER 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 26:12"/>ኤርምያስ ሀላቃታኮነ አሳ ኡባኮ ሀይሳዳ ያግስ፦ “ሀ ህንተ ስእዳ ቃላ ኡባይ ሀ ፆሳ ኬ ቦላነ ሀ ካታማ ቦላ ሀናና ጋዳ ታ ኦዳና መላ ጎዳይ ታና ኪትስ። <verse eid="JER 26:12"/><verse number="13" style="v" sid="JER 26:13"/>ህዛ ህንተ ኦግያነ ህንተ ኦሱዋ ላምተ፤ ጎዳ ህንተ ፆሳ ቃላስ ኪተትተ። ሄሳ ህንተ ኦኮ፥ ጎዳይ ህንተ ቦላ ኤሀና ግዳ ኢታባ አጋጋና። <verse eid="JER 26:13"/><verse number="14" style="v" sid="JER 26:14"/>ታና ግድኮ፥ ታ ህንተ ኩሸን ደአይስ። ህንተዉ ሎኦነ ሱረ ዳንዳባ ታ ቦላ ኦተ። <verse eid="JER 26:14"/><verse number="15" style="v" sid="JER 26:15"/>ታኒ ሀ ቃላ ኡባ ህንተዉ ኦዳና መላ ጎዳይ ቱማ ታና ኪትዳ ግሾ፥ ህንተ ታና ዎኮ፥ ህንተ ህንተ ቦላ፥ ሀ ካታማ ቦላነ እያን ደእያ አሳ ቦላ ፅሎ ሱ አጮ ኤሀናይሳ ኤርተ” ያግስ።<verse eid="JER 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 26:16"/>ሀላቃትነ አሳ ኡባይ፥ ካህነትነ ናበት፥ “እ፥ ጎዳ፥ ኑ ፆሳ ሱንን ኑስ ኦድዳ ግሾ፥ ሀ አደይ ሀይቃናዉ በሰና” ያግዶሶና።<verse eid="JER 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 26:17"/>ቢታ ጭማታፐ እሶት እሶት ደንድ ኤቅድ፥ ሺቅዳ አሳኮ ሀይሳዳ ያግዶሶና፦ <verse eid="JER 26:17"/><verse number="18" style="v" sid="JER 26:18"/>“ህዝቅያስ ይሁዳን ካዎትዳ ላይን ሞረሴታ አደይ ምክያስ ካሰ ይሁዳ አሳስ ሀይሳዳ ያግድ፥ ትንብተ ኦድስ፦ ‘ፅዮነይ ሾቃዳ ጎየታና። የሩሳላመ ካታማይ ላለትድ፥ ላለ ዶረ ግዳና። ፆሳ ኬይ ኬፀትዳ ደረይ ዎራ ግዳና’ ያጌስ ኡባፈ ዎልቃማ ጎዳይ” ያግስ። <verse eid="JER 26:18"/><verse number="19" style="v" sid="JER 26:19"/>ያትን፥ “ይሁዳ ካዎይ ህዝቅያስነ ይሁዳ አሳ ኡባይ እያ ዎዶና? አካይ፥ ህዝቅያስ ጎዳስ ያይድ፥ ጎዳ ማሮተ ኦይችቤኔ? ጎዳይ ኤንታ ቦላ ኤሀና ግዳ ኢታባ አግቤኔ? ሽን ኑኒ ኑ ቦላ ኢታባ ኤሀና ሀኖስ” ያግዶሶና።<verse eid="JER 26:19"/></para>
  <para style="s1">እዮአቄም ኦርዮና ዎስስ</para>
  <para style="p">
    <verse number="20" style="v" sid="JER 26:20"/>ቅርያት-ይኣርማ ጌተትያ በሳን፥ ሻማያ ናኣ፥ ኦርዮና ጌተትያ እስ አደይ ደኤስ። እካ ኤርምያስ ኦድዳይሳዳ፥ ሀ ካታማ ቦላነ ሀ ቢታ ቦላ ጎዳ ሱንን ካሰ ትንብተ ኦድስ። <verse eid="JER 26:20"/><verse number="21" style="v" sid="JER 26:21"/>ካዎይ እዮአቄም፥ እያ ኦላንቾት፥ እያ ሞርናት፥ ኦርዮን ኦድዳይሳ ስእዳ ዎደ ካዎይ እያ ዎናዉ ኮይስ። ኦርዮን ሄሳ ስእዳ ዎደ ያይድ፥ ግብፀ ባቃትስ። <verse eid="JER 26:21"/><verse number="22" style="v" sid="JER 26:22"/>ግዶሽን፥ ካዎይ እዮአቄም አክቦራ ናኣ ኤልናታናነ ሀራ አሳታ ግብፀ ኪትስ። <verse eid="JER 26:22"/><verse number="23" style="v" sid="JER 26:23"/>ኤንቲ ኦርዮና ግብፀፈ ከስድ፥ ካዋ እዮአቄመኮ ኤፍን፥ እያ ማሻን ዎስድ ደረይ ሞገትያ ዱፎን ሞግዶሶና።<verse eid="JER 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 26:24"/>ሽን ሳፋና ናአይ፥ አክቃም ኤርምያሳ ማድዳ ግሾ አሳይ እያ ዎናዉ አድ እምቦኮና።<verse eid="JER 26:24"/></para>
  <chapter eid="JER 26"/>
  <chapter number="27" style="c" sid="JER 27"/>
  <para style="s1">ይሁድ ናቡካዳናፆራ ኩሸን ኩንድስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 27:1"/>እዮስያሳ ናአይ ሰደቅያስ፥ ይሁዳን ካዎቶ ዶምዳ ዎደ ሀ ቃላይ ጎዳፐ ኤርምያሳኮ ይስ። <verse eid="JER 27:1"/><verse number="2" style="v" sid="JER 27:2"/>“ዳፎ ጎነ ዎዶሮራ ደእያ ቃምባራ መዳ ነ ጋናን ዎ። <verse eid="JER 27:2"/><verse number="3" style="v" sid="JER 27:3"/>ይሁዳ ካዋ ሰደቅያሳኮ የሩሳላመ ኪተትዳ አሳ ባጋራ፥ ኤዶመ፥ ሞአበ፥ አሞነ፥ ፅሮሳነ ስዶና ኪታ። <verse eid="JER 27:3"/><verse number="4" style="v" sid="JER 27:4"/>ኤንቲ ባንታ ጎዳታስ ኦዳና መላ ኤንታ ኪታ። ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ <verse eid="JER 27:4"/><verse number="5" style="v" sid="JER 27:5"/>‘ታ ግታ ዎልቃንነ ታ ምጨትዳ ኩሸን ሳኣ፥ ሳአን ደእያ አሳ፥ መሄነ ዶአታ መስ፤ ታኒ እያ፥ ታ ኮይያ ኦደስካ እማይስ። <verse eid="JER 27:5"/><verse number="6" style="v" sid="JER 27:6"/>ሀእ ታ ቢታ ኡባ ታ አይልያስ፥ ባብሎነ ካዋ ናቡካዳናፆራስ እማስ። ቃስ ታ ባዞ ዶአትካ እያዉ ሃረታና መላ ኦስ። <verse eid="JER 27:6"/><verse number="7" style="v" sid="JER 27:7"/>እያ ቢታይ ሀራታስ ሃረትያ ዎደይ ጋካናዉ ካዎተት ኡባይ እያዉ፥ እያ ናኣስነ እያ ናኣ ናኣስ ሃረታና። ሄሳፈ ጉየ፥ ዳሮ ካዎተትነ ግታ ካዎት እያ ሃራና።’<verse eid="JER 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 27:8"/>“ሽን አይ ቢት ዎይኮ አይ ካዎተ ባብሎነ ካዋ ናቡካዳናፆራስ ኪተቶና እፅኮነ እያ ቃምባራን ገሎና እፅኮ፥ ሄ ካዎተይ እያ ኩሸን ያና ጋካናዉ ማሻን፥ ኮሻንነ ቦሻን ሴራና። <verse eid="JER 27:8"/><verse number="9" style="v" sid="JER 27:9"/>ሄሳ ግሾ፥ ‘ባብሎነ ካዋስ ሃረተከታ’ ግያ ህንተ ናበታ፥ ህንተዉ ካየይሳታ፥ ህንተ አሙሆ ብለይሳታ፥ ህንተ ማሮታነ ሞይትለ ፄገይሳታ ስኦፕተ። <verse eid="JER 27:9"/><verse number="10" style="v" sid="JER 27:10"/>ኤንቲ ህንተዉ ዎርዶ ኦዶሶና፤ ህንተና ህንተ ቢታፈ ሾዳና፤ ህንተና ጎዳዳ ከሳና፤ ህንተካ ያና። <verse eid="JER 27:10"/><verse number="11" style="v" sid="JER 27:11"/>ሽን አይ ካዎተካ ባብሎነ ካዋ ቃምባራን ገልድ፥ እያዉ ሃረትኮ፥ ታ ሄ ካዎተ እያ ቢታን አሻና፤ ኤንቲ ሄ ቢታ ጎያና፤ ያን ዳና” ያጌስ ጎዳይ።<verse eid="JER 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 27:12"/>ታኒ፥ ይሁዳ ካዋ ሰደቅያሳስካ ሀ ቃላ ኦዳስ፤ “ባብሎነ ካዋ ቃምባራን ገላዳ እያዉነ እያ አሳስ ሃረትኮ፥ ነ ደኦን ዳና። <verse eid="JER 27:12"/><verse number="13" style="v" sid="JER 27:13"/>ጎዳይ ባብሎነ ካዋስ ሃረቶና እፅያ ካዎተስ ኦድዳይሳዳ ማሻን፥ ኮሻንነ ቦሻን ነነ ነ አሳይ አይስ ሀይቄቲ? <verse eid="JER 27:13"/><verse number="14" style="v" sid="JER 27:14"/>ኤንቲ ኦደይ ዎርዶ ግድያ ግሾ፥ ‘ህንተ ባብሎነ ካዋስ ሃረተከታ’ ያግድ ኦድያ ናበታ ስኦፕተ። <verse eid="JER 27:14"/><verse number="15" style="v" sid="JER 27:15"/>ታ ኤንታ ኪታብከ፤ ሽን ኤንቲ ታ ሱንን ዎርዶ ትንብተ ኦዶሶና። ሄሳ ግሾ፥ ታ ህንተና ጎዳዳ ከሳና፤ ህንተነ ህንተ ናበት ያና” ያጌስ ጎዳይ።<verse eid="JER 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 27:16"/>ሄሳፈ ጉየ፥ ታ ካህነታስነ አሳ ኡባስ ሀይሳዳ ያጋዳ ኦዳስ፦ “ፆሳ ኬ ሚሸይ ባብሎነፐ ማታራ ስሚድ ያና” ያግድ ዎርዶ ኦድያ ናበታ ስኦፕተ። <verse eid="JER 27:16"/><verse number="17" style="v" sid="JER 27:17"/>ኤንቲ ግያባ ስኦና አግድ፥ ባብሎነ ካዋስ ሃረትተ፤ ህንተ ደኦን ዳና። ሀ ካታማይ አይስ ላለትዳ በሲ ግዳኔ? <verse eid="JER 27:17"/><verse number="18" style="v" sid="JER 27:18"/>ኤንቲ ቱማ ናበ ግድኮነ ጎዳ ቃላይ ኤንታን ደእኮ፥ ፆሳ ኬን፥ ይሁዳ ካዎ ጋንነ የሩሳላመን አትዳ ሚሸይ ባብሎነ ቦናዳ ኡባፈ ዎልቃማ ጎዳ ፆሳ ዎሶ።<verse eid="JER 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 27:19"/>“ኡባፈ ዎልቃማ ጎዳይ፥ ፆሳ ኬ ካረን ኤቅዳ ናምኡ ናሰ ብራታ ቱሳታባ፥ ግታ ከረታባ፥ ጫና ጋረታባነ ሀራ ሚሸታባ ሀይሳዳ ያጌስ፦ <verse eid="JER 27:19"/><verse number="20" style="v" sid="JER 27:20"/>ባብሎነ ካዎይ ናቡካዳናፆር እዮአቄማ ናኣ፥ ይሁዳ ካዋ እኮንያናነ ይሁዳንነ የሩሳላመን ደእያ ግታ አሳ ኡባ ድእድ ኤፍዳ ዎደ፥ <verse eid="JER 27:20"/><verse number="21" style="v" sid="JER 27:21"/>ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ ፆሳ ኬን፥ ይሁዳ ካዎ ጋንነ የሩሳላመን አትዳ ሚሸታባ ሀይሳዳ ያጌስ፤ <verse eid="JER 27:21"/><verse number="22" style="v" sid="JER 27:22"/>ኤንቲ ባብሎነ ቢታ ጋዘታና፤ ታ ኤንታ ግሾ ያና ዎደይ ጋካናዉ፥ ኤንቲ ያን ዳና። ሄ ዎደ ታ ኤንታ ጉየ ዛራዳ ኤንታ በሳን ዎና” ያጌስ ጎዳይ።<verse eid="JER 27:22"/></para>
  <chapter eid="JER 27"/>
  <chapter number="28" style="c" sid="JER 28"/>
  <para style="s1">ዎርዶ ናብያ ሀናና</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 28:1"/>ሄ ላይ፥ ይሁዳ ካዎይ ሰደቅያስ ካዎቶ ዶምዳ ኦይዳን ላይን፥ እቻሻን አጌናን ጋባኦና አደይ፥ አዙራ ናአይ ናበይ ሀናን፥ ፆሳ ኬን ካህነታነ አሳ ኡባ ስንን ታኮ ሀይሳዳ ያግስ፦ <verse eid="JER 28:1"/><verse number="2" style="v" sid="JER 28:2"/>“ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ ‘ባብሎነ ካዋ ቃምባራ መንና። <verse eid="JER 28:2"/><verse number="3" style="v" sid="JER 28:3"/>ባብሎነ ካዎይ፥ ናቡካዳናፆር፥ ባብሎነ ኤፍዳ ፆሳ ኬ ሚሸ ኡባ ታ ናምኡ ላይ ግዶን ዛራዳ ሀ በሳ ኤሀና። <verse eid="JER 28:3"/><verse number="4" style="v" sid="JER 28:4"/>እዮአቄማ ናኣ፥ ይሁዳ ካዋ ዮአክና፥ ይሁዳፐ ድኤትድ ባብሎነ ብዳ አሳ ኡባ ዛራዳ ሀ በሳ ኤሀና። ታኒ ባብሎነ ካዋ ቃምባራ መንና’ ” ያጌስ ጎዳይ።<verse eid="JER 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 28:5"/>ፆሳ ኬ ግዶን ኤቅዳ ካህነታነ አሳ ኡባ ስንን ናበይ ኤርምያስ፥ ናብያ ሀናናኮ ሀይሳዳ ያግስ። <verse eid="JER 28:5"/><verse number="6" style="v" sid="JER 28:6"/>“አምንእ! ጎዳይ ነ ግዳይሳዳ ኦ። ፆሳ ኬ ሚሸታነ ድኤትድ ብዳ አሳ ኡባ ባብሎነፐ ዛሪድ፥ ነ ኦድያ ቃላ ጎዳይ ፖሎ! <verse eid="JER 28:6"/><verse number="7" style="v" sid="JER 28:7"/>ግዶሽን፥ ታ ነዉነ ነ አሳስ ኦደይሳ ስአ። <verse eid="JER 28:7"/><verse number="8" style="v" sid="JER 28:8"/>ኔፐነ ታፐ ካሰ ደእዳ ናበት፥ ኦላባ፥ ዮባነ ጋዶባ ግታ ካዎተታ ቦላ ትንብተ ኦድዶሶና። <verse eid="JER 28:8"/><verse number="9" style="v" sid="JER 28:9"/>ሽን፥ ሳሮባ ኦድያ ናበይ፥ ቱማ ፆሲ ኪትዳ ናበ ግደይስ ኤረተይ፥ እ ኦድያ ትንብተይ ፖለትያ ዎደና” ያግስ።<verse eid="JER 28:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 28:10"/>ሄሳፈ ጉየ፥ ናበይ ሀናን፥ ናብያ ኤርምያሳ ጋናፈ ቃምባራ ኤክድ መንስ። <verse eid="JER 28:10"/><verse number="11" style="v" sid="JER 28:11"/>ሀናን አሳ ኡባ ስንን፥ “ታኒ ናምኡ ላይ ግዶን ባብሎነ ካዋ ናቡካዳናፆራ ቃምባራ ካዎተታ ኡባ ጋናፈ ደንዳ ሀይሳዳ መንና” ያጌስ ጎዳይ። ሄሳፈ ጉየ፥ ኤርምያስ ደንድድ፥ ባ ኦግያ ብስ።<verse eid="JER 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 28:12"/>ናበይ ሀናን፥ ናብያ ኤርምያሳ ጋናፈ መንዳ ጉ ዎደፐ ጉየ፥ ጎዳ ቃላይ ናብያ ኤርምያሳኮ ሀይሳዳ ያግሸ ይስ። <verse eid="JER 28:12"/><verse number="13" style="v" sid="JER 28:13"/>ባዳ ሀናናስ ኦዳ፤ “ኔኒ ም ቃምባራ መንዳሳ፤ ሽን ኔኒ እያ ግሾ ብራታ ቃምባራ መና። <verse eid="JER 28:13"/><verse number="14" style="v" sid="JER 28:14"/>ባብሎነ ካዋ ናቡካዳናፆራስ ሃረታና መላ ታኒ ሀ ካዎተታ ኡባ ጋናን ብራታ ቃምባራ ዎና፤ ኤንትካ እያዉ ሃረታና። ታኒ ሀር አቶሽን፥ ባዞ ዶአትካ እያዉ ሃረታና መላ ኦና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ።<verse eid="JER 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 28:15"/>ሄሳፈ ጉየ፥ ናበይ ኤርምያስ፥ ናብያ ሀናናኮ ሀይሳዳ ያግስ፦ “ሀናንያ፥ ስአ! ጎዳይ ነና ኪትቤና፤ ሽን ኔኒ ሀ አሳይ ዎርዶባን አማነታና መላ ኦዳሳ። <verse eid="JER 28:15"/><verse number="16" style="v" sid="JER 28:16"/>ሄሳ ግሾ፥ ጎዳይ፥ ‘ታ ነና ሳአ ቦላፈ ድጋና። ኔኒ ሀ አሳይ ታ ቦላ ማካላና መላ ኦዳ ግሾ ነ ሀ ላይ ሀይቃና’ ” ያግስ።<verse eid="JER 28:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 28:17"/>ሄ ላይ ላፑን አጌናን ናበይ ሀናን ሀይቅስ።<verse eid="JER 28:17"/></para>
  <chapter eid="JER 28"/>
  <chapter number="29" style="c" sid="JER 29"/>
  <para style="s1">ኤርምያሳ ዳብዳብያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 29:1"/>ናብያ ኤርምያስ ድኤትዳ አሳ ግዶን ደእያ አትዳ ጭማታስ፥ ካህነታስ፥ ናበታስነ ናቡካዳናፆር የሩሳላመፐ ድእድ፥ ባብሎነ ኤፍዳ ኡባስ የሩሳላመፐ የድዳ ዳብዳበይ ሀይሳፈ ካልድ ፃፈትዳይሳ። <verse eid="JER 29:1"/><verse number="2" style="v" sid="JER 29:2"/>ሀይስ ሀንዳይ፥ ካዎይ እኮንያን፥ እያ አይያ ካውያ፥ እያ ሞርናት፥ ይሁዳነ የሩሳላመ ሀላቃት፥ ኩሸ ሂላንቾትነ ብራታ ቆፀይሳት የሩሳላመፐ ድኤትድ ብድ ስምና። <verse eid="JER 29:2"/><verse number="3" style="v" sid="JER 29:3"/>ኤርምያስ ይሁዳ ካዎይ ሰደቅያስ ባብሎነ ካዋ ናቡካዳናፆራኮ ኪተትዳ ሳፋና ናኣ ኤልኣሳነ ካልቄ ናኣ ጋማራ ቦላ ሄ ዳብዳብያ የድስ።</para>
  <para style="p" vid="JER 29:3">ዳብዳበይ ሀይሳዳ ያጌስ፦ <verse eid="JER 29:3"/><verse number="4" style="v" sid="JER 29:4"/>“ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ የሩሳላመፐ ባብሎነ ድኤትዳ አሳ ኡባስ ሀይሳዳ ያጌስ፦ <verse eid="JER 29:4"/><verse number="5" style="v" sid="JER 29:5"/>ኬ ኬፅድ ያን ደእተ። ካ ዘርድ አይፍያ ሚተ። <verse eid="JER 29:5"/><verse number="6" style="v" sid="JER 29:6"/>ማቾ ኤክድ ማጫ ናአነ አደ ናአ የልተ። ህንተ አደ ናይታስ ማቾ ኦይችድ እምተ፤ ህንተ ማጫ ናይታ አዝናስ እምተ። ኤንቲ ማጫ አደ የሎ፤ ያን ታይቦን ዳርተ፤ ጉፆፍተ። <verse eid="JER 29:6"/><verse number="7" style="v" sid="JER 29:7"/>ህንተ ድኤትድ ብዳ ካታማስ ሳሮይ ዳና መላ ኮይተ። ሄ ካታማስ ጎዳ ዎስተ። እያዉ ሳሮይ ደእኮ፥ ህንተዉካ ሳሮይ ዳና። <verse eid="JER 29:7"/><verse number="8" style="v" sid="JER 29:8"/>ህንተ ግዶን ደእያ ህንተ ናበትነ ማሮት ኦድያባን ጭመቶፍተ፤ ኤንቲ አሙህያ አሙሁዋ ስኦፕተ። <verse eid="JER 29:8"/><verse number="9" style="v" sid="JER 29:9"/>ኤንቲ ታ ሱንን ዎርዶ ትንብተ ኦዶሶና፤ ታ ኤንታ ኪታብከ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ።<verse eid="JER 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 29:10"/>“ህንተ ባብሎነን ጋምእያ ላፑን ታሙ ላይይ ፖለትያ ዎደ ታ ህንተ ግሾ ያዳ፥ ህንተና፥ ህንተ ቢታ ዛራዳ ኤሀና ጋዳ ገልዳ ቃላ ፖላና። <verse eid="JER 29:10"/><verse number="11" style="v" sid="JER 29:11"/>ታኒ ህንተዉ ቆፕያ ቆፋ ኤራይስ። ሄ ቆፋይ፥ ዉርሰይ ሎኦነ ኡፋይስ ደእያ፥ ህንተና ጎእያ ቆፋፐ አትሽን፥ ቆህያ ቆፋ ግደና። <verse eid="JER 29:11"/><verse number="12" style="v" sid="JER 29:12"/>ሄሳፈ ጉየ፥ ህንተ ታና ፄጋና፤ ታኮ ያናነ ታና ዎሳና፤ ታካ ህንተና ስአና። <verse eid="JER 29:12"/><verse number="13" style="v" sid="JER 29:13"/>ህንተ ታና ኮያና፤ ህንተ ታና ህንተ ኩመ ዎዛናን ኮይዳ ዎደ ደማና። <verse eid="JER 29:13"/><verse number="14" style="v" sid="JER 29:14"/>ታ ህንተዉ በንታና፤ ታ ህንተና ድኤተፈ ዛራና። ታኒ ህንተና ላልዳ ካዎተታፐነ ዱማ ዱማ በሳፈ ሺሻና። ታ ህንተና ድኦን ደንዳ ህንተ ቢታ ጉየ ዛራዳ ኤሀና” ያጌስ ጎዳይ።<verse eid="JER 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 29:15"/>ህንተ፥ “ጎዳይ ናበ ኑስ ባብሎነን ደንስ” ያግደታ። <verse eid="JER 29:15"/><verse number="16" style="v" sid="JER 29:16"/>ግዶሽን፥ ዳዊታ አራታን ኡትያ ካዋባነ ህንተ መላ ድኤትድ ቦና አትዳ አሳባነ ህንተ ዳቦታባ ጎዳይ ሀይሳዳ ያጌስ። <verse eid="JER 29:16"/><verse number="17" style="v" sid="JER 29:17"/>“ታ ኤንታ ቦላ ማሸ፥ ኮሻነ ጋዶ የዳና። ታ ኤንታና ሜተታናዉ ዳንዳኤቶና ኢትዳ ባላሰ ም አይፈዳ ኦና። <verse eid="JER 29:17"/><verse number="18" style="v" sid="JER 29:18"/>ታኒ ኤንታ ማሻን፥ ኮሻንነ ጋዶን የደዳ፥ ኤንታ ሳአን ደእያ ካዎተ ኡባስ ዳጋማ ኦና። ቃስ ታ ኤንታ ከሳዳ የድዳ ቢታ ኡባን ባደስ፥ ዳጋማስ፥ ቦረስነ ጫሻስ ኦና። <verse eid="JER 29:18"/><verse number="19" style="v" sid="JER 29:19"/>ታ አይለታ ናበታ ባጋራ ዛራ ዛራዳ ኪትዳ ታ ቃላ ኤንቲ ስኦና እፅዶሶና። ህንተ ድኤትድ ብዳይሳትካ ስኦና እፅደታ። <verse eid="JER 29:19"/><verse number="20" style="v" sid="JER 29:20"/>ህንተኖ፥ የሩሳላመፐ ባብሎነ ድኤትድ ብዳ አሳዉ፥ ህንተ ኡባይ ጎዳ ቃላ ስእተ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 29:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 29:21"/>ታ ሱንን ዎርዶ ትንብተ ኦድያ፥ ቆላያ ናኣ አካባባነ ማሰያ ናኣ ሰደቅያሳባ ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ። “ታ ኤንታ ባብሎነ ካዋ ናቡካዳናፆራስ አዳ እማና። ህንተ ፄልሽን፥ እ ኤንታ ዎና። <verse eid="JER 29:21"/><verse number="22" style="v" sid="JER 29:22"/>ሄሳፈ ጉየ፥ ይሁዳፐ ድኤትድ፥ ባብሎነ ብዳ አሳይ እስ አስ ባዳናዉ ኮይኮ፥ ‘ባብሎነ ካዎይ ታማን ፁግዳ ሰደቅያሳዳነ አካባዳ ጎዳይ ነና ኦ’ ያጋና። <verse eid="JER 29:22"/><verse number="23" style="v" sid="JER 29:23"/>ኤንቲ እስራኤለን ኢታ ናጋራ ኦዶሶና። ኤንቲ ባንታ ሾሮታ ማቸታራ ላይማትዶሶና፤ ታ ኤንታ ኪቶና ዎርዶ ትንብተ ታ ሱንን ኦድዶሶና። ሄሳ ኤረይ ታና፤ ሄሳስ ታኒ ማርካ” ያጌስ ጎዳይ።<verse eid="JER 29:23"/></para>
  <para style="s1">ሻማያስ ፃፈትዳ ዳብዳበ</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 29:24"/>ናሄላመ አድያ ሻማያስ ሀይሳዳ ያጋዳ ኦዳ፦ <verse eid="JER 29:24"/><verse number="25" style="v" sid="JER 29:25"/>“ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ ‘ኔኒ ነ ሱንን የሩሳላመን ደእያ አሳስ፥ ማእሰያ ናኣ ካህንያ ሶፎንያሳስነ ሀራ ካህነታስ ዳብዳበ የዳዳሳ።’ ነ ሶፎንያሳስ ሀይሳዳ ያጋዳሳ፦ <verse eid="JER 29:25"/><verse number="26" style="v" sid="JER 29:26"/>‘ፆሳ ኬን ሀላቃ ግዳና መላ ጎዳይ ነና ዮዳሄ በሳን ካህነ ኦድ ሹምስ። ባና ናበ ግድ ትንብተ ኦድያ ጎያ ኦናካ እያ ቶሁዋ ዱን፥ እያ ቆያ ሳንላታን ኔኒ ቃቻናዉ በሴስ። <verse eid="JER 29:26"/><verse number="27" style="v" sid="JER 29:27"/>ያትን ባና ናበ ግያ አናቶታ አድያ ኤርምያሳ አይስ ሄሳዳ ኦብኪ? <verse eid="JER 29:27"/><verse number="28" style="v" sid="JER 29:28"/>ኤርምያስ፥ ድኤተ ላይይ ዳሮ ግድያ ግሾ ባብሎነን ኬ ኬፅድ ደእተ፤ ካ ዘርድ አይፍያ ሚተ’ ” ያግድ ኑና ኪትስ።<verse eid="JER 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 29:29"/>ካህነይ ሶፎንያስ ናብያ ኤርምያሳስ ዳብዳብያ ናባብስ። <verse eid="JER 29:29"/><verse number="30" style="v" sid="JER 29:30"/>ጎዳ ቃላይ ኤርምያሳኮ ሀይሳዳ ያግድ ይስ፤ <verse eid="JER 29:30"/><verse number="31" style="v" sid="JER 29:31"/>“ሀ ኪታ ድኦን ደእያ አሳ ኡባስ ኪታ፤ ናሄላማ አድያ ሳማየባ ጎዳይ ሀይሳዳ ያጌስ፤ ታኒ ኪቶና ሻማየይ ዎርዶ ትንብተ ኦድድ ህንተ ዎርዶን አማንታና መላ ኦስ። <verse eid="JER 29:31"/><verse number="32" style="v" sid="JER 29:32"/>ታ ናሄላማ አድያ ሻማያነ እያ ሶ አሳ ሴራና። እ ታ ቦላ ማካላባ ኦድዳ ግሾ ሀ አሳ ግዶን እያዉ እስ አስካ ደኦን አተና። ታኒ ታ አሳስ ኦና ኬሀተ እ በኤና” ያጌስ ጎዳይ።<verse eid="JER 29:32"/></para>
  <chapter eid="JER 29"/>
  <chapter number="30" style="c" sid="JER 30"/>
  <para style="s1">እስራኤለ አሳ ስሙዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 30:1"/>ጎዳፐ ኤርምያሳኮ ይዳ ቃላይ ሀይሳ። <verse eid="JER 30:1"/><verse number="2" style="v" sid="JER 30:2"/>“ኤርምያሳ፥ ታ ነዉ ኦድዳ ቃላ ኡባ ፃ ማፃፋን ፃፋ። <verse eid="JER 30:2"/><verse number="3" style="v" sid="JER 30:3"/>ታኒ ታ አሳ እስራኤለነ ይሁዳ ድኦፐ ጉየ ዛርያ ዎደይ ማታትስ። ኤንታ ማይዛታስ እምዳ ቢታ ኤንታ ዛራና፤ ኤንቲ እያ ላታና” ያጌስ ጎዳይ እስራኤለ ፆሳይ።<verse eid="JER 30:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 30:4"/>ጎዳይ እስራኤለባነ ይሁዳባ ኦድዳ ቃላይ ሀይሳ። <verse eid="JER 30:4"/><verse number="5" style="v" sid="JER 30:5"/>“ታ ያሻነ ዳጋማ ዋሶ ስአስ፤ ዳጋማ ዋሶፐ አትሽን፥ ሳሮ ዋሶ ግደና። <verse eid="JER 30:5"/><verse number="6" style="v" sid="JER 30:6"/>አነ ኦይችተ፤ በእተ፤ አደይ ናአ የላናዉ ዳንዳኢ? ያትን፥ አደ ኡባይ እቀ ኦይክዳ ማጫሳዳ፥ ባ ኩሸን ባ ኡሉዋ ኦይክዳሽን ታ በኤይስ አይቤ? አሳ ኡባ ሶምኦይ አይስ ካሬፅዴ? <verse eid="JER 30:6"/><verse number="7" style="v" sid="JER 30:7"/>ሄ ጋላሳይ አይ መላ ኡንኤያ ጋላሴ? ሄሳ መላ ጋላስ ባዋ። ሄ ጋላሳይ ያይቆባ ዘረስ ኡንአ ዎደ ግዳና። ግዶሽን ኤንቲ ሄ ኡባፈ አታና” ያጌስ ጎዳይ።<verse eid="JER 30:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 30:8"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፦ “ሄ ጋላሳን ታ ኤንታ ጋናፈ ቃምባራ መንና፤ ኤንቲ ቃሸትዳ ሳንላታ ዱና። ሄሳፈ ጉየ፥ አላጋ ቢታ አሳይ ኤንታ አይለየና። <verse eid="JER 30:8"/><verse number="9" style="v" sid="JER 30:9"/>ሽን ኤንቲ ጎዳስ፥ ባንታ ፆሳስ፥ ኦና፤ ታ ኤንታዉ ደንያ ካዋ ዳዊታስ ሃረታና።<verse eid="JER 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 30:10"/>“ሄሳ ግሾ፥ ታ አይለቶ፥ ያይቆባ ኮቻቶ፥ ያዮፍተ። ህንተኖ፥ እስራኤለቶ፥ ዳጋሞፕተ። ህንተ ሃሆ በሳን ደእሽን፥ ታ ህንተና አሻና፤ ህንተ ኮቻታ ኤንቲ ድኤትዳ ቢታፈ ዛራና። ያይቆባ ዛረት ስሚድ፥ ሳሮ ዳና፤ ኤንታ ኦንካ ያሽሰና። <verse eid="JER 30:10"/><verse number="11" style="v" sid="JER 30:11"/>ታ ህንተና አሻናዉ ህንተራ ደአይስ። ህንተና ላልዳ ካዎተታ ኡባ ይሳና፤ ሽን ህንተና ይስከ። ታ ህንተና ፅሎ ፕርዳን ሴራና፤ ሽን ሴሮና ህንተና ጮ የድከ” ያጌስ ጎዳይ።<verse eid="JER 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 30:12"/>“ህንተ መቆይ ኮለተና፤ ህንተ ማዱንይ ፓፀና። <verse eid="JER 30:12"/><verse number="13" style="v" sid="JER 30:13"/>ህንተዉ ሞተተይ ባዋ፤ ህንተ ማዱንስ ለይ ዴና፤ ህንተዉ ፓፆይ ባዋ። <verse eid="JER 30:13"/><verse number="14" style="v" sid="JER 30:14"/>ህንተ ዶሰይሳት ህንተና ዶግዶሶና፤ ኤንቲ ህንተባ ዉዳ ጎኮና። ህንተ ባላይነ ህንተ ናጋራይ ዳሮ ግድያ ግሾ፥ ታ ህንተና ሞርከዳ ሾጫስ፤ ቃይ ባይና ሴራስ። <verse eid="JER 30:14"/><verse number="15" style="v" sid="JER 30:15"/>ፓፆይ በንቶና ህንተ ሀርግያስነ ህንተ ማዱንስ አይስ ዋሰቲ? ህንተ ባላይነ ህንተ ናጋራይ ዳርዳ ግሾ ታ ሀይሳ ህንተ ቦላ ኦስ።<verse eid="JER 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 30:16"/>“ሽን ህንተና ጋሽድ ምዳ ኡባይ ሜተታና፤ ህንተ ሞርከት ኡባይ ድኤታና። ህንተና ቦንቅዳይሳት ቦንቀታና፤ ህንተባ ኤክዳይሳት ኤከታና። <verse eid="JER 30:16"/><verse number="17" style="v" sid="JER 30:17"/>ኤንቲ፥ ‘ኦንካ ኮዮናነ ቦረትዳ ፅዮነ’ ግዶሶና፤ ሽን ታ ህንተዉ ኬሀና፤ ህንተ ማዱን ፓና” ያጌስ ጎዳይ።<verse eid="JER 30:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 30:18"/>“ያይቆባ ኮቻታ ድኤትዳ በሳፈ ጉየ ዛራዳ፥ ኬፃና፤ ኤንቲ ደእያ በሳስካ ቃታና። የሩሳላመ ካታማይ ካሰ ባ ላለትዳ በሳን፥ ካዎ ጋይ ካሰ ባ በሳን ስሚድ ኬፀታና። <verse eid="JER 30:18"/><verse number="19" style="v" sid="JER 30:19"/>ያን ደእያ አሳ ኡባይ ጋላታ ማዝሙረነ ኡፋይሳ የ የፃና። ታ ኤንታ ታይቡዋ ዳርሳናፐ አትሽን፥ ጉፀና። ታኒ ኤንታ ቦንቸትዳ ደረ ኦና፤ ኤንቲ ካዉዮኮና። <verse eid="JER 30:19"/><verse number="20" style="v" sid="JER 30:20"/>ኤንታ ናይት በን ዱሳዳ ዳና፤ ኤንታ ማባራይ ታ ስንን ምንድ ዳና። ኤንታ ኡንኤያ ኡባ ታ ሴራና። <verse eid="JER 30:20"/><verse number="21" style="v" sid="JER 30:21"/>ኤንታ ካለናይ ኤንታ ግዶፈ ከያና፤ ኤንታ ሃራናይ ኤንታ ግዶፈ ደንዳና። ታኒ እያ ታዉ ማታ ኤሀና፤ እ ታኮ ሺቃና። ታኒ እያ ሺሾና ደእሽን፥ ምንድ ታኮ ሺቃናዉ ዳንዳኤይ ኦኔ?” ያጌስ ጎዳይ። <verse eid="JER 30:21"/><verse number="22" style="v" sid="JER 30:22"/>ሄሳ ግሾ፥ ህንተ ታ አሰ ግዳና፤ ታካ ህንተ ፆሰ ግዳና።<verse eid="JER 30:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 30:23"/>ሄኮ፥ ጎዳ ሀንቆይ ጎተዳ ደንዴስ፤ ሽረት ሽረት ዎሸ ኢታታ ሁጰን ዎና። <verse eid="JER 30:23"/><verse number="24" style="v" sid="JER 30:24"/>ጎዳይ ባ ዎዛና ቆፋ ዉርስድ ፖላና ጋካናዉ ኤፅያ እያ ሀንቆይ ጉየ ስመና። ሄሳ ስንፈ ያና ዎደታን ህንተ አኬካና።<verse eid="JER 30:24"/></para>
  <chapter eid="JER 30"/>
  <chapter number="31" style="c" sid="JER 31"/>
  <para style="s1">እስራኤለ አሳ ስሙዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 31:1"/>“ሄ ዎደ ታኒ እስራኤለ ዘረ ኡባስ ፆሰ ግዳና፤ ኤንትካ ታ አሰ ግዳና” ያጌስ ጎዳይ።<verse eid="JER 31:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 31:2"/>“ማሻፈ አትዳ አሳይ መላ ቢታን ታ ስንን ሳባ ደማና። ታኒ እስራኤለ አሳስ ሸምፖ እማናዉ ያና። <verse eid="JER 31:2"/><verse number="3" style="v" sid="JER 31:3"/>ታኒ ኤንታዉ ሃሆ በሳፈ ቆንጫስ፤ ታኒ ህንተና መርና ሲቁዋን ዶሳስ፤ ታ ቃያን ህንተና ታኮ ሺሻስ። <verse eid="JER 31:3"/><verse number="4" style="v" sid="JER 31:4"/>ጌላኦ እስራኤለ፥ ታ ህንተና ዛራዳ ኬፃና፤ ህንተካ ኬፀታና። ኔኒ ካራቡዋ ዛራ ኦይካዳ፥ ኡፋይተይሳታራ ኔኒ የፃናነ ዱራና። <verse eid="JER 31:4"/><verse number="5" style="v" sid="JER 31:5"/>ሳማረ ዙማ ቦላ ዎይነ ቶካና፤ ቶክዳይሳት እያ አይፍያን ኡፋይታና። <verse eid="JER 31:5"/><verse number="6" style="v" sid="JER 31:6"/>ኤፍሬማ ገዘ ቢታን ናገይሳት፥ ‘ሃ ዪተ፤ ጎዳኮ፥ ኑ ፆሳኮ፥ ፑደ ፅዮነ ቦስ’ ያግድ ፄግያ ዎደይ ያና” ያጌስ ጎዳይ።<verse eid="JER 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 31:7"/>“ያይቆባ አሳስ ኡፋይሳን የፅተ፤ ካዎተታ ኡባፈ አያ እስራኤለስ እልልተ። ‘እስራኤለ አሳፐ አትዳይሳታ አሻ’ ያግድ ጋላታ ማዝሙረ የፅተ። <verse eid="JER 31:7"/><verse number="8" style="v" sid="JER 31:8"/>ታኒ ኤንታ ፑደሀ ባጋ ቢታፈ ኤሀና፤ ሳኣ ጋፃፐ ታ ኤንታ ሺሻና። ቆቀት፥ ዎበት፥ ዎደ ማጫሳትነ እቀ ኦይክዳ ማጫሳት ኤንታራ እስፈ ያና፤ ዳሮ አሳይ ባንታ ቢታ ስማና። <verse eid="JER 31:8"/><verse number="9" style="v" sid="JER 31:9"/>ታ ኤንታ ዛራዳ ኤህያ ዎደ ኤንቲ ኡፋይሳፈ ደንዶይሳን ዬክሸነ ዎስሸ ያና። ታኒ ኤንታ ሻፋ ላንቅያራ፥ ኤንቲ በቶና ጊግዳ ኦግያራ ካለና። ታኒ እስራኤለስ አዋ፤ ኤፍሬም ታዉ ባይራ ናአ።<verse eid="JER 31:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 31:10"/>“ህንተኖ፥ ካዎተቶ፥ ጎዳ ቃላ ስእድ፥ ሃሆ በሳን፥ ዩሾይ አባን ተቀትዳ ቢታታን፥ ‘እስራኤለ ላልዳይስ እ ኤንታ ሺሻና፤ ሄንንቾይ ባ ዉድያ ሄመይሳዳ እ ኤንታ ሄማና’ ያግድ አዋጅተ። <verse eid="JER 31:10"/><verse number="11" style="v" sid="JER 31:11"/>ጎዳይ ያይቆባ ኮቻታ ዎዛና፤ እ ኤንታ፥ ኤንታፈ ምነይሳታ ኩሸፐ አሽስ። <verse eid="JER 31:11"/><verse number="12" style="v" sid="JER 31:12"/>ኤንቲ ይድ ፅዮነ ዙማ ቦላ ኡፋይሳን የፃና፤ ኤንቲ፥ ጎዳይ እምያ ኬሀተን፥ ካን፥ ዎይነን፥ ዛይተን፥ ዶርሳንነ መሄን ኡፋይታና። ኤንቲ ሃ ሎይድ ኡሽዳ አታክልተ በሳ መላ ግዳና፤ ኤንቲ ዛሪድ አዛኖኮና። <verse eid="JER 31:12"/><verse number="13" style="v" sid="JER 31:13"/>ሄ ዎደ ጌላኦት ኡፋይሳን ዱራና፤ ፓንትነ ጭማት ኡፋይታና። ታ ኤንታ ዬሁዋ ኡፋይሳን ላማና፤ ታ ኤንታ ምንና፤ ኤንታ አዛኑዋ ግሾ ኤንታ ኡፋይሳና። <verse eid="JER 31:13"/><verse number="14" style="v" sid="JER 31:14"/>ታኒ ካህነታስ ዳሮ ካ እማና፤ ታ አሳይ ታ ኬሀተ ካላና” ያጌስ ጎዳይ።<verse eid="JER 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 31:15"/>“ዬሆይነ ዘለልስ ራማ ካታማን ስኤትስ፤ ራሄላ ባ ናይታስ ዬካሱ፤ ኤንቲ ባይና ግሾ ዬሆ ምን እፃሱ” ያጌስ ጎዳይ።<verse eid="JER 31:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 31:16"/>“ዬሁዋ አግድ፥ ህንተ አፉ ቁችተ። ህንተ ኦዳ ኦሱዋስ ዎይቶ ህንተ ኤካና፤ ሞርከ ቢታፈ ህንተ ናይት ስማና። <verse eid="JER 31:16"/><verse number="17" style="v" sid="JER 31:17"/>ህንተ ናይት ባንታ ቢታ ስማናዉ ደእያ ግሾ፥ ህንተዉ ኡፋይስ ደኤስ” ያጌስ ጎዳይ።<verse eid="JER 31:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 31:18"/>“ኤፍሬማ ኮቻታ ዙዙን ታ ስአስ። ኤንቲ፥ ‘ኔኒ ኑና ዋትቦና ዎፋኖዳ ዋዳሳ፤ ኑካ ኬድዳ። ኔኒ ጎዳ፥ ኑ ፆሳ ግድያ ግሾ ኑና ዛራ፤ ኑኒ ኔኮ ስማና። <verse eid="JER 31:18"/><verse number="19" style="v" sid="JER 31:19"/>ኑ ካሰ ኔፐ ሃክድ ብዳ፤ ሽን ሀእ ኑ ናጋራ ፓፅዳ። ነ ኑና ሴርን፥ ዬላትድ ኑ ትራ ባቅዳ። ኑኒ ኑ ናአተ ላይ ናጋራ ግሾ፥ ካዉይዳነ ዬላትዳ’ ያግዶሶና።<verse eid="JER 31:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 31:20"/>“ኤፍሬም ታዉ ቱማ አልኦነ ታ ዶስያ ናአ ግደኔ? ታኒ እያ ሱን ደንያ ዎደ ኡባን እያ ሀሳያይስ። ሄሳ ግሾ፥ ታ ዎዛናይ እያ ላሞቴስ፤ ታ እያዉ ዳሮ ቃታይስ” ያጌስ ጎዳይ።<verse eid="JER 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 31:21"/>“ህንተ ኦግያን ማላታ ዎተ፤ ማላታ ም ኤስተ፤ ህንተ ብዳ ኦግያ አኬክተ። ጌላኦ እስራኤለ፥ ስማ፤ ነ ካታማታ ገላ። <verse eid="JER 31:21"/><verse number="22" style="v" sid="JER 31:22"/>ህንተኖ፥ አማኖይ ባይና እስራኤለቶ፥ አዉደ ጋካናዉ ቶይላተቲ? ጎዳይ ሳአ ቦላ ኦራባ ኦና፤ ሄስካ ማጫስ አደ ዩሾን ኤቃና” ያጌስ ጎዳይ።<verse eid="JER 31:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 31:23"/>ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ ሀይሳዳ ያጌስ፦ “ታኒ እስራኤለ አሳ ድኤተፈ ዛራዳ ኤህያ ዎደ ይሁዳ ቢታንነ እያ ካታማታን ኤንቲ፥ ‘ነኖ ፅሎተ አቅያ በሳዉ፥ ጌሻ ደርያዉ፥ ጎዳይ ነና አንጆ’ ያግድ ዛሪድ ኦደታና። <verse eid="JER 31:23"/><verse number="24" style="v" sid="JER 31:24"/>ይሁዳንነ ይሁዳን ደእያ ካታማታን አሳይ ዳና፤ ጎሻንቾትነ ሄንንቾት ባንታ ዉድያራ ያን ዳና። <verse eid="JER 31:24"/><verse number="25" style="v" sid="JER 31:25"/>ታኒ ዳቡራንቾታ ጋሽትሳና፤ ቃስ ኮሻትድ ግልቅዳይሳታ ካልሳና” ያጌስ ጎዳይ።<verse eid="JER 31:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 31:26"/>ሄ ዎደ ባርካዳ ታ ዩሹዋ ፄላስ፤ ታ ስኮይ ታዉ ማልኦ ስኮ ግድስ።<verse eid="JER 31:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 31:27"/>“ታኒ እስራኤለንነ ይሁዳን አሰነ መሄ ኩንያ ዎደይ ያና። <verse eid="JER 31:27"/><verse number="28" style="v" sid="JER 31:28"/>ኤንታ ሾዳናዉ፥ ላላናዉ፥ ሽራ የጋናዉ፥ ይሳናዉነ ጋዶ ኤሀናዉ ደንድዳይሳዳ ኤንታ ዛራዳ ግምባናዉነ ቶካናዉ ደንዳና” ያጌስ ጎዳይ።<verse eid="JER 31:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 31:29"/>“ሄ ዎደ አሳይ፥ ‘አዋት ቃዉኤ ዎይነ አይፈ ምን፥ ናይታ አቻይ ዶጭስ’ ያግድ ሃሳያ ሌምሶይ አታና። <verse eid="JER 31:29"/><verse number="30" style="v" sid="JER 31:30"/>ሽን እሶይ እሶይ ባ ናጋራን ሀይቃና፤ ቃዉኤ ዎይነ አይፈ ምያ ኦደስካ እያ አቻይ ዶጫና” ያጌስ ጎዳይ።<verse eid="JER 31:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 31:31"/>“ታኒ እስራኤለራነ ይሁዳራ ኦራ ጫቆ ጫቃና ዎደይ ያና። <verse eid="JER 31:31"/><verse number="32" style="v" sid="JER 31:32"/>ሄ ጫቆይ ታ ኤንታ ግብፀፈ ከሳናዉ ኤንታ ኩሽያ ኦይክዳ ዎደ ኤንታ ማይዛታራ ጫቅዳ ጫቁዋ መላ ግደና። ታ ኤንታዉ አዝና መላ ግዳ ኡትንካ ኤንቲ ታ ጫቁዋ መንዶሶና” ያጌስ ጎዳይ።<verse eid="JER 31:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 31:33"/>“ሽን ታኒ ሄ ዎድያፐ ጉየ እስራኤለራ ጫቃና ጫቆይ ሀይሳ፦ ታኒ ታ ህግያ ኤንታ ጉግያን ዎና፤ ኤንታ ዎዛናን ፃፋና። ታኒ ኤንታ ፆሰ ግዳና፤ ኤንትካ ታ አሰ ግዳና። <verse eid="JER 31:33"/><verse number="34" style="v" sid="JER 31:34"/>ህዛፐ ጉየ፥ አስ ባ ላግያ ዎይኮ ባ እሻ፥ ‘ጎዳ ኤራ’ ያግድ ታማርሰና። ጉፈ ግታ ጋካናዉ ኡባይ ታና ኤራና። ታኒ ኤንታ ናቁዋ አቶ ጋና፤ ኤንታ ናጋራ ዛራዳ ቆፕከ” ያጌስ ጎዳይ።<verse eid="JER 31:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JER 31:35"/>ጋላስ ፖአና መላ አዋ ዎዳይ፥ ቃማ ፖአና መላ አጌናነ ፆልንቶ ኪትዳይ፥ አባ ቃድ፥ ቤታይ ጉማናዳ ኦይ፥ እያ ሱንይ ኡባፈ ዎልቃማ ጎዳ ጌተተይስ ሀይሳዳ ያጌስ። <verse eid="JER 31:35"/><verse number="36" style="v" sid="JER 31:36"/>“ሀ ኤቅድ ደእያ መተ ህገይ ታ ስንፈ ሻረትኮ፥ ሄ ዎደ እስራኤለ ኮቻይ ታ ደረ ግደይስ መርናዉ አታና” ያጌስ ጎዳይ።<verse eid="JER 31:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JER 31:37"/>“ቦላ ሳሎታ ዋናዉ ዎይኮ ጋርሳ ሳኣ ባሶይ ኤረታናዉ ዳንዳእኮ፥ ሄ ዎደ ታ እስራኤለ ዘረ ኡባ፥ ኤንቲ ኦዳ ናጋራ ግሾ ታ ስንፈ ድጋና” ያጌስ ጎዳይ።<verse eid="JER 31:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JER 31:38"/>“ሀናንኤላ ሻኮ ግምብያፈ ዶምድ፥ ማዛነ ፐንግያ ጋካናዉ የሩሳላመ ካታማይ ታ ካታማ ግድድ፥ ኬፀትያ ዎደይ ያና። <verse eid="JER 31:38"/><verse number="39" style="v" sid="JER 31:39"/>ሄ ካታማ ዛዋይ ዉሎሀ ባጋፈ ብድ ጋረባ ዙማነ ጎአ ዩሹዋ ጋካናዉ ዳልጋና። <verse eid="JER 31:39"/><verse number="40" style="v" sid="JER 31:40"/>አሀ ሞግያነ ብዶ የግያ ዛንጋራይነ ቀድሮና ዛንጋራፐ ቆሞራ ዶሎሀ ባጋራ ብድ፥ ፓራ ፐንገ ማዛንያ ጋካናዉ ደእያ ቢታ ኡባይ ጎዳስ ዱማትድ፥ ጌሽ ግዳና። ህዛፐ ጉየ፥ ካታማይ መርናዉ ሾደተና፤ ላለተና” ያጌስ ጎዳይ።<verse eid="JER 31:40"/></para>
  <chapter eid="JER 31"/>
  <chapter number="32" style="c" sid="JER 32"/>
  <para style="s1">ኤርምያስ ጋደ ሻምስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 32:1"/>ይሁዳ ካዎይ ሰደቅያስ ካዎትዳ ታማን ላይን፥ ባብሎነ ካዎይ ናቡካዳናፆር ካዎትዳ ታማነ ሆስፑን ላይን ጎዳፐ ሀ ቃላይ ኤርምያሳኮ ይስ። <verse eid="JER 32:1"/><verse number="2" style="v" sid="JER 32:2"/>ሄ ዎደ ባብሎነ ካዋ ኦላንቾት የሩሳላመ ተቅዶሶና፤ ናበይ ኤርምያስ ይሁዳ ካዎ ጋን ደእያ፥ ናገይሳታ ዳባባን እያ ቦላ ጎርደትን ደኤስ።<verse eid="JER 32:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 32:3"/>ይሁዳ ካዎይ ሰደቅያስ እያ ሀይሳዳ ያግድ ቃችድ ዎስ፦ “ነ አይስ ሀይሳዳ ያጋዳ ትንብተ ኦዳይ? ‘ጎዳይ ሀ ካታማ ባብሎነ ካዋ ኩሸን አድ እማና፤ እ እያ ኦይካና’ ያጋዳ አይስ ኦዳይ። <verse eid="JER 32:3"/><verse number="4" style="v" sid="JER 32:4"/>ይሁዳ ካዎይ ሰደቅያስ ባብሎነ አድ እመታና፤ እ ባብሎነ ካዋ ኩሸን ገላና። እያ ስንን ኤቅድ፥ እያራ ኦደታና፤ እ ባ አይፈን እያ በአና። <verse eid="JER 32:4"/><verse number="5" style="v" sid="JER 32:5"/>ናቡካዳናፆር ሰደቅያሳ ባብሎነ ኤፋና፤ ታ እያባ በአና ጋካናዉ እ ያን ዳና። ኔኒ ባብሎነታራ ኦለታናዉ ቆፕኮ፥ ሄስ ነዉ ሀነና” ያጌስ ጎዳይ።<verse eid="JER 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 32:6"/>ኤርምያስ፥ “ጎዳ ቃላይ ሄ ዎደ ታኮ ሀይሳዳ ያግድ ይስ” ያግስ።<verse eid="JER 32:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 32:7"/>“ነ አዋ እሻ ሳሉማ ናአይ፥ ሀናምኤል ኔኮ ይድ፥ ‘ዎዛናዉ ማት ደእያ ማታ ዳቦይ ነና ግድያ ግሾ አናቶታ ካታማን ደእያ ታ ጋድያ ሻማ’ ያጋና። <verse eid="JER 32:7"/><verse number="8" style="v" sid="JER 32:8"/>ጎዳይ ግዳይሳዳ፥ ታ አዋ እሻ ናአይ ሀናምኤል ታኮ ናገይሳታ ዳባባ ይድ፥ ‘ዎዛናዉ ማት ደእያ ማታ ዳቦይ ነና ግድያ ግሾ፥ ብንያመ ቢታን አናቶታን ደእያ ታ ጋድያ ሻማ’ ያግን፥ ታኒ ሄሳ ኦድዳይ ጎዳ ግደይሳ ኤራስ።<verse eid="JER 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 32:9"/>“አናቶታ ካታማን ደእያ ጋድያ ታ አዋ እሻ ናኣ ሀናምኤላፐ ሻማስ። እያ ጋትያ ምዛነን ልክን፥ ታማነ ላፑን ብራ ሳንትመ ግድስ። <verse eid="JER 32:9"/><verse number="10" style="v" sid="JER 32:10"/>ሻማ ፕርማ ማርካት ደእያ በሳን ፓራማስ፤ ጎርዳስ፤ ማታመ እያ ቦላ ዎስ፤ ሚሽያ ምዛነን ልካዳ እያዉ እማስ። <verse eid="JER 32:10"/><verse number="11" style="v" sid="JER 32:11"/>ሄሳፈ ጉየ፥ ታኒ ዛልእያ ሀኖታ ቆንጭስያ አሻገትድ አታመትዳ ሻማ ፕርማነ አታመትቦና ሻማ ፕርማ ኤካስ። <verse eid="JER 32:11"/><verse number="12" style="v" sid="JER 32:12"/>ታ አዋ እሻ ናአይ ሀናምኤል፥ ሻማ ፕርማ ፓራምዳ ማርካትነ ናገይሳታ ዳባባን ኡትዳ አይሁደት ኡባይ በእሽን፥ ሄ ሻማ ፕርማ ማህሰያ ናኣ፥ ኔራ ናኣ ባሮካስ እማስ። <verse eid="JER 32:12"/><verse number="13" style="v" sid="JER 32:13"/>ኤንታ ስንን ታ ባሮካ ሀይሳዳ ያጋዳ ኪታስ፦ <verse eid="JER 32:13"/><verse number="14" style="v" sid="JER 32:14"/>‘ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ ሀይሳዳ ያጌስ፦ ዳሮ ዎደ ጋምአና መላ ሀ አሻገትድ አታመትዳ ፕርማነ አታመትቦና ፕርማ ኤፋዳ ኦቶን ዎ።’ <verse eid="JER 32:14"/><verse number="15" style="v" sid="JER 32:15"/>ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ ሀይሳዳ ያጌስ፦ ሀ ቢታን አሳይ ዛሪድ ኬ፥ ጋደነ ዎይነ ቶክያ በሲ ሻማና” ያጌስ ጎዳይ።<verse eid="JER 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 32:16"/>ታኒ ኔራ ናኣ ባሮካስ ሻማ ፕርማ ዋርቃትያ እምዳፐ ጉየ፥ ሀይሳዳ ያጋዳ ዎሳስ። <verse eid="JER 32:16"/><verse number="17" style="v" sid="JER 32:17"/>“አቤት ኡባ ሃርያ ጎዳዉ፥ ነ ሳሎታነ ሳኣ ነ ግታ ዎልቃንነ ነ ምጨትዳ ኩሸን መዳሳ። ነዉ ዳንዳኤቶናባይ ባዋ። <verse eid="JER 32:17"/><verse number="18" style="v" sid="JER 32:18"/>ኔኒ ነ ሲቁዋ ሙኩሉ አሳስ በሳሳ፤ ሽን አዋታ ናጋራ ኤንታ ናይታ ቦላ ዛራሳ። አቤት ግታነ ዎልቃማ ፆሳዉ፥ ነ ሱንይ ኡባፈ ዎልቃማ ጎዳ ጌተቴስ። <verse eid="JER 32:18"/><verse number="19" style="v" sid="JER 32:19"/>ነ ሀልቾይ ግታ፤ ነ ኦያ ኦሶይ ዎልቃማ። አሳ ኦገ ኡባ ነ በኣሳ፤ አሳ ኡባስ እያ ኦግያዳነ እያ ኦሱዋዳ ዛራሳ።<verse eid="JER 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 32:20"/>“ነ ግብፀን ማላታነ ማላታ ኦዳሳ፤ ሀች ጋካናዉ ሀ ማላታ እስራኤለ አሳ ግዶንነ ሀራ ካዎተታ ኡባ ግዶን ኦሶ አጋባካ። ሄሳፈ ደንዶይሳን ነ ሱንይ ኡባ በሳን ኤረትስ። <verse eid="JER 32:20"/><verse number="21" style="v" sid="JER 32:21"/>ኔኒ ነ አሳ እስራኤለ ግብፀፈ ማላታንነ ማላታን፥ ነ ምኖ ቀስያን፥ ነ ምጨትዳ ኩሽያንነ ግታ ዳጋማን ከሳዳሳ። <verse eid="JER 32:21"/><verse number="22" style="v" sid="JER 32:22"/>ኤንታ ማይዛታስ ነ እማናዉ ጫቅዳ ቢታ፥ ማነ ኤስ ጎግያ ቢታ ኤንታዉ እማዳሳ። <verse eid="JER 32:22"/><verse number="23" style="v" sid="JER 32:23"/>ኤንቲ ሄ ቢታ ገልድ ላትዶሶና። ሽን ኤንቲ ነዉ ኪተትቦኮና፤ ነ ህግያ ናግቦኮና፤ ኤንቲ ኦና መላ ነ ኪትዳ ኡባ ኦቦኮና። ሄሳ ግሾ፥ ነ ኤንታ ቦላ ሀ ጋዱዋ ኡባ ኤሀዳሳ።<verse eid="JER 32:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 32:24"/>“ባብሎነ አሳይ ካታማ ኦይካናዉ ግምብያ ዩሹዋን ቢታ ዶርድ ተቅዶሶና። ኦላፐ፥ ኮሻፐነ ቦሻፐ ደንዶይሳን ካታማይ ኤንታ ኦልያ ባብሎነ ኩሸን አድ እመትስ። ነ ሀእ በኤይሳዳ ነ ግዳባ ኡባይ ፖለትስ። <verse eid="JER 32:24"/><verse number="25" style="v" sid="JER 32:25"/>አቤት ኡባ ሃርያ ጎዳዉ፥ ካታማይ ባብሎነ አሳስ እመታናዉ ሀንያ ዎደካ ነ ታና፥ ‘ማርካ ፄጋዳ፥ ሚሸን ጋድያ ሻማ’ ጋዳሳ” ያጋዳ ዎሳስ።<verse eid="JER 32:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 32:26"/>ሄሳፈ ጉየ፥ ጎዳ ቃላይ ኤርምያሳኮ ሀይሳዳ ያግድ ይስ፦ <verse eid="JER 32:26"/><verse number="27" style="v" sid="JER 32:27"/>“ታኒ ጎዳ፥ አሳ ኡባ ፆሳ። ታዉ ዳንዳኤቶናባይ ደኢ?” ያግስ። <verse eid="JER 32:27"/><verse number="28" style="v" sid="JER 32:28"/>ታኒ ሀ ካታማ ባብሎነ አሳስነ ባብሎነ ካዋ ናቡካዳናፆራስ አዳ እማና፤ ኤንቲ እያ ኦይካና። <verse eid="JER 32:28"/><verse number="29" style="v" sid="JER 32:29"/>ሀ ካታማ ተቅዳ ባብሎነ አሳይ ይድ፥ ካታማ ታማን ፁጋና፤ ፖቅያ ቦላ ባኣለ ኤቃስ እፃነ ጩይስሸነ ሀራ ፆሳታስ ኡሻ ያርሾ ጉስሸ ታና ሀንቀዳ አሳይ ደእያ ኬትካ ፁገታና። <verse eid="JER 32:29"/><verse number="30" style="v" sid="JER 32:30"/>“እስራኤለይነ ይሁድ ባንታ ናአተፈ ዶምድ፥ ታ ስንን ኢታባፐ አትሽን፥ ሎኦባ፥ ኦቦኮና፤ ኤንቲ ባንታ ኩሸን ኦዳ ኦሱዋን ታና ሀንቀዶሶና። <verse eid="JER 32:30"/><verse number="31" style="v" sid="JER 32:31"/>ሀ ካታማይ ኬፀትዳ ዎደፐ ሀች ጋካናዉ፥ ሀ ካታማ አሳይ ታና ዳሮ ሀንቀዳ ግሾ ሀ ካታማ ታ ስንፈ ይሳና። <verse eid="JER 32:31"/><verse number="32" style="v" sid="JER 32:32"/>እስራኤለይነ ይሁድ፥ ኤንታ ካዎትነ ሀላቃት፥ ኤንታ ካህነትነ ናበት ኦዳ ኢታ ኦሶ ኡባን ታና ይሎይዶሶና። <verse eid="JER 32:32"/><verse number="33" style="v" sid="JER 32:33"/>ኤንቲ ባንታ ሶምኡዋ ግዶናሽን፥ ባንታ ዞኩዋ ታዉ ዛርዶሶና። ታ ኤንታ ዛራ ዛራዳ ታማርስንካ፥ ኤንቲ ስእቦኮና ዎይኮ ሴራ ኤክቦኮና። <verse eid="JER 32:33"/><verse number="34" style="v" sid="JER 32:34"/>ኤንቲ እፀትዳ ባንታ ኤቃታ ታ ሱንይ ፄገትዳ ኬን ኤስድ ቱንስዶሶና። <verse eid="JER 32:34"/><verse number="35" style="v" sid="JER 32:35"/>ኤንቲ ባንታ አደ ናይታነ ማጫ ናይታ ሞሎካ ኤቃስ ያርሻናዉ ህኖማ ዛንጋራን ባኣለ ኤቃስ ያርሾ ቃ በሳታ ጊግስዶሶና። ኤንቲ ሄሳ ኦና መላ ታ ኪታብከ፤ ይሁዳ አሳይ ናጋራ ኦና መላ ሄሳ ኤንቲ ኦና ጋዳ ታ ናጋብከ” ያግስ።<verse eid="JER 32:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 32:36"/>“ኔኒ፥ ‘ሀ ካታማይ ኦላን፥ ኮሻንነ ቦሻን ባብሎነ ካዋ ኩሸን አድ እመታና’ ያግዳ ሀ ካታማባ ጎዳይ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ። <verse eid="JER 32:36"/><verse number="37" style="v" sid="JER 32:37"/>ታ ሱልያ ሀንቁዋንነ ግታ ሸንያን ኤንታ ላልዳ ቢታ ኡባፈ ሺሻዳ ሀ በሳ ዛራ ኤሀዳ፥ ኤንቲ ሳሮተን ዳና መላ ኦና። <verse eid="JER 32:37"/><verse number="38" style="v" sid="JER 32:38"/>ኤንቲ ታ አሰ ግዳና፤ ታ ኤንታ ፆሰ ግዳና። <verse eid="JER 32:38"/><verse number="39" style="v" sid="JER 32:39"/>ኤንቲ ታዉ መርናዉ ያያና መላ፥ ታ ኤንታዉ እስ ዎዛናነ እስ ኦገ እማና፤ ሄስ ኤንታዉነ ኤንታፈ ጉየ ኤንታ ናይታስ ሎኦ ግዳና። <verse eid="JER 32:39"/><verse number="40" style="v" sid="JER 32:40"/>ታኒ ኤንታራ መርናዉ ጫቃና፤ ሄ ጫቁዋን ታ ኤንታዉ ሎኦባ ኦሶ አግከ። ኤንቲ ታና አግድ ጉየ ስሞና መላ ኤንቲ ታዉ ያያና መላ ኦና። <verse eid="JER 32:40"/><verse number="41" style="v" sid="JER 32:41"/>ታ ኤንታዉ ሎኦባ ኦይስ ታና ኡፋይሴስ፤ ታ ኩመ ዎዛናፐነ ታ ኩመ ሸምፑዋፈ ቱማ ሀ ቢታን ኤንታ ቶካና” ያጌስ ጎዳይ።<verse eid="JER 32:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JER 32:42"/>“ታ ሀ አሳ ቦላ ኢታ ቦሻ ኡባ ኤህዳይሳዳ ታ ኤንታዉ እማና ግዳ ሎኦባ ኡባ እማና። <verse eid="JER 32:42"/><verse number="43" style="v" sid="JER 32:43"/>ህንተ፥ ‘ሀ ቢታይ አሳይነ መሄይ ባይና ባይሳ ቢታ ግዳና፤ እ ባብሎነታስ እመትስ’ ያግዳ ቢታን አሳይ ዛሪድ ጋደ ሻማና። <verse eid="JER 32:43"/><verse number="44" style="v" sid="JER 32:44"/>ታ ኤንታ ዛራዳ ኤህያ ግሾ፥ አሳይ ጋደ ሻማና፤ ማርካ ስንን ዛልእያ ሀኖታ ቆንጭስያ ፕርማ ፓራምድ፥ ማታመ ዎና። ሀይስ ኡባይ ብንያመ ቢታን፥ የሩሳላመ ዩሹዋን ደእያ ሄራታን፥ ይሁዳ ካታማታን፥ ደረይ ዳርያ ካታማታን፥ ጋ ካታማታንነ ነገበ መላ ቢታን ደእያ ካታማታ ኡባን ሀናና” ያጌስ ጎዳይ።<verse eid="JER 32:44"/></para>
  <chapter eid="JER 32"/>
  <chapter number="33" style="c" sid="JER 33"/>
  <para style="s1">ስሞ ኡፋይሳ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 33:1"/>ኤርምያስ ቡሮ ናገይሳታ ዳባባን ቃሸትድ ደእሽን፥ ጎዳ ቃላይ ዛሪድ እያኮ ይስ። <verse eid="JER 33:1"/><verse number="2" style="v" sid="JER 33:2"/>ሳኣ መዳ ጎዳይ፥ ጊግስድ እያ በሳን ዎዳ ጎዳይ፥ እያ ሱንይ ጎዳ ጌተተይስ ሀይሳዳ ያጌስ፦ <verse eid="JER 33:2"/><verse number="3" style="v" sid="JER 33:3"/>“ታና ፄጋ፤ ታ ነዉ ኮያና፤ ነ ኤሮና ግታባነ ዎልቃማባ ታ ነዉ ቆንጭሳና።” <verse eid="JER 33:3"/><verse number="4" style="v" sid="JER 33:4"/>ጎዳይ፥ እስራኤለ ፆሳይ፥ ባብሎነ ኦላ፥ ቢታ ዶረነ፥ ድኤተ ተቃና መላ ድርሳ ግምብያ ምንናዉ ላልዳ ሀ ካታማ ኬታባነ ይሁዳ ካዎታ ጋታባ ሀይሳዳ ያጌስ። <verse eid="JER 33:4"/><verse number="5" style="v" sid="JER 33:5"/>ኤንታ ኢታተ ጋሶን፥ ታ ሀ ካታማ ቦላፈ ታ ሶምኡዋ ደንዳ ግሾ፥ ህንተራ ኦለታናዉ ታኒ ታ ሀንቁዋን ሾጫና አሳ አሀን ሀ በሳን ኩንናዉ ባብሎነት ገላና።<verse eid="JER 33:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 33:6"/>ግዶሽን፥ “ታ ሀ ካታማነ እያን ደእያ አሳ ዛራዳ ፓና፤ ኤንታ ፓያተ ዛራና፤ ሳሮነ ዎፓ ዱሱ ኤንታዉ እማና። <verse eid="JER 33:6"/><verse number="7" style="v" sid="JER 33:7"/>ታኒ ይሁዳ አሳነ እስራኤለ አሳ ድኦፐ ዛራና፤ ኤንቲ ካሰ ደእዳይሳዳ ኦዳ ኤንታ ግምባና። <verse eid="JER 33:7"/><verse number="8" style="v" sid="JER 33:8"/>ኤንቲ ታና ኦዳ ናጋራ ኡባፈ ታ ኤንታ ጌሻና፤ ኤንቲ ናቁዋነ ኤንታ ማካላ ኡባ አቶ ጋና። <verse eid="JER 33:8"/><verse number="9" style="v" sid="JER 33:9"/>የሩሳላመ ካታማይ ታዉ ኡፋይስ፥ ቦንቾነ ጋላታ ሳአን ደእያ ካዎተታ ኡባ ስንን ኤሀና። ታኒ የሩሳላመ አሳስ ኦያ ሎኦባነ ካታማስ ኤህያ ዱረተነ ሳሮተ ስእድ፥ ካዎተት ኡባይ ያሻን ኮኮራና” ያጌስ ጎዳይ።<verse eid="JER 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 33:10"/>“ህንተ፥ ‘አስነ መሄይ ባይና ባይሳ’ ግዳ ሀ በሳን፥ አስነ መሄይ ባይና ይሁዳ ካታማታንነ የሩሳላመ ኦገታን ኡፋይስነ እልልሳ ግርስ ስኤታና። <verse eid="JER 33:10"/><verse number="11" style="v" sid="JER 33:11"/>የነ ያጋኖ ግርስ፥ ኡፋይሳ ግርስ፥ ሄሳዳካ፥ ፆሳ ኬ ጋላታ ያርሾ ኤህድ፥</para>
  <para style="q1" vid="JER 33:11">“እ ኬሀ ግድያ ግሾ፥</para>
  <para style="q2" vid="JER 33:11">እያ ማሮተይ መርናሳ ግድያ ግሾ፥</para>
  <para style="q2" vid="JER 33:11">ኡባፈ ዎልቃማ ጎዳ ጋላትተ።</para>
  <para style="q2" vid="JER 33:11">ያግድ የፅሸ ፆሳ ኬ</para>
  <para style="q2" vid="JER 33:11">ጋላታ ያርሾ ኤክድ ያ አሳ ግርሳይ ስኤታና።</para>
  <para style="m" vid="JER 33:11">ታኒ ኤንታ ድኦፐ ዛራና፤ ኤንቲ ካሰ ደእዳይሳዳ ኦዳ ዎና” ያጌስ ጎዳይ።<verse eid="JER 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 33:12"/>“ሀ አሳይነ መሄይ ባይና ባይሳ ቢታንነ እያን ደእያ ካታማታን ሄንንቾት ባንታ ዶርሳ ዉድያ ሄምያ ጋደይ ዳና። <verse eid="JER 33:12"/><verse number="13" style="v" sid="JER 33:13"/>ገዘ ካታማታን፥ ጋ ካታማታን፥ ነገበ መላ ቢታን ደእያ ካታማታን፥ ብንያመ ቢታን፥ የሩሳላመ ዩሹዋን ደእያ በሳታንነ ይሁዳ ካታማታን ሄንንቾት ባንታ ዶርሳታ ዛሪድ ታይባና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 33:14"/>“ታኒ እስራኤለ አሳስነ ይሁዳ አሳስ ገልዳ ቃላ ፖልያ ዎደይ ያና። <verse eid="JER 33:14"/><verse number="15" style="v" sid="JER 33:15"/>ሄ ዎደ ታኒ ዳዊታ ኮቻፈ እስ ፅሎ አጫ ደንና፤ እ ሱረ ፕርዳ ፕርዳና፤ ፅሎ ኦና። <verse eid="JER 33:15"/><verse number="16" style="v" sid="JER 33:16"/>ሄ ዎደ ይሁዳ አሳይ አታና፤ የሩሳላመ አሳይ ዎፑ ግድ ደአና። ሀ ካታማይ፥ ‘ጎዳይ ኑ ፅሎተ’ ጌተትድ ፄገታና። <verse eid="JER 33:16"/><verse number="17" style="v" sid="JER 33:17"/>ዳዊታ ኮቻፈ እስራኤለ አራታን ኡትያ አስ የና። <verse eid="JER 33:17"/><verse number="18" style="v" sid="JER 33:18"/>ሄሳዳካ፥ ፁሳ ያርሾ፥ ካ ያርሾነ ሀራ ያርሾ ያርሻናዉ ሌወ ኮቻፈ ካህነ ግድያ አስ መርናዉ ታ ስንፈ የና” ያጌስ ጎዳይ።<verse eid="JER 33:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 33:19"/>“ጎዳ ቃላይ ኤርምያሳኮ ሀይሳዳ ያግድ ይስ። <verse eid="JER 33:19"/><verse number="20" style="v" sid="JER 33:20"/>ጋላሳስነ ቃማስ ታ ዎዳ ዎጋ መንድ፥ ጋላስነ ቃም ባንታ ዎድያን ስመረቶና መላ ኦድ ታ ጫቁዋ ላማናዉ ህንተ ዳንዳእኮ፥ <verse eid="JER 33:20"/><verse number="21" style="v" sid="JER 33:21"/>እያ ኮቻፈ አራታን ኡትያ አስ ዮናዳ፥ ታ አይልያ ዳዊታራ ጫቅዳ ጫቁዋ ላማና፤ ታዉ ኦያ፥ ሌወ ኮቸ ግድዳ ካህነታራ ጫቅዳ ጫቁዋ ላማና። <verse eid="JER 33:21"/><verse number="22" style="v" sid="JER 33:22"/>ታኒ ታ አይልያ ዳዊታ ኮቻነ ታ ስንን ኦያ ሌወ ኮቻ ታይባናዉ ዳንዳኤቶና ሳሎ ፆልንቶታዳነ ማካናዉ ዳንዳኤቶና አባ ሻፍያዳ ዳርሳና” ያጌስ ጎዳይ።<verse eid="JER 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 33:23"/>ጎዳ ቃላይ ቃስካ ኤርምያሳኮ ሀይሳዳ ያግድ ይስ። <verse eid="JER 33:23"/><verse number="24" style="v" sid="JER 33:24"/>“ሀ አሳይ፥ ‘ጎዳይ ባ ዶርዳ ናምኡ ካዎተታ፥ እስራኤለነ ይሁዳ አጋግስ’ ያግድ ኦደተይሳ ነ አኬካብኪ? ኤንቲ ታ አሳ ካድ፥ ባና ዳንዳእዳ ካዎተ ግዶኮና ግድ ቆፖሶና። <verse eid="JER 33:24"/><verse number="25" style="v" sid="JER 33:25"/>ታኒ ጋላሳራነ ቃማራ ጫቅዳ ጫቁዋነ ሳሎነ ሳአ ህግያ ምንቦናባ ግድኮ፥ <verse eid="JER 33:25"/><verse number="26" style="v" sid="JER 33:26"/>ያይቆባ ዘረነ ታ አይልያ ዳዊታ ኮቻ አጋጋና። እያ ናይታፐ አብራሃመ፥ ይሳቃነ ያይቆባ ኮቻታ ቦላ ካዎናዉ ዳዊታ ኮቻ ዶርከ። ታኒ ታ አሳ ማራና፤ ኤንታ ሻሉዋ ዛራና” ያጌስ ጎዳይ።<verse eid="JER 33:26"/></para>
  <chapter eid="JER 33"/>
  <chapter number="34" style="c" sid="JER 34"/>
  <para style="s1">ሰደቅያሳስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 34:1"/>ባብሎነ ካዎይ ናቡካዳናፆር፥ እያ ኦላንቾት ኡባይነ እ ሃርያ ካዎተታን ደእያ አሳ ኡባይ፥ የሩሳላመነ የሩሳላመ ዩሹዋን ደእያ ካታማታ ኡባ ኦልያ ዎደ፥ ሀ ቃላይ ጎዳፐ ኤርምያሳኮ ይስ፦ <verse eid="JER 34:1"/><verse number="2" style="v" sid="JER 34:2"/>ጎዳይ እስራኤለ ፆሳይ ሀይሳዳ ያግስ፤ “ባዳ ይሁዳ ካዋ ሰደቅያሳኮ ሀይሳዳ ያጋ፦ ‘ታኒ ሀ ካታማ ባብሎነ ካዋ ኩሸን አዳ እማና፤ እ ካታማ ታማን ፁጋና። <verse eid="JER 34:2"/><verse number="3" style="v" sid="JER 34:3"/>ኔኒ እያ ኩሸፐ ከሳ ኤካካ፤ ኔኒ ኦይከታና፤ እያዉ አዳ እመታና። ኔኒ ነ አይፈን ባብሎነ ካዋ በአና፤ እካ ኔራ ኦደታና። ኔኒ ባብሎነ ቢታ ባና’ ያጌስ ጎዳይ።<verse eid="JER 34:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 34:4"/>“ግዶሽን፥ ይሁዳ ካዋዉ ሰደቅያሳ፥ ጎዳይ ግያባ ስአ። ኔኒ ኦላን ሀይቃካ። <verse eid="JER 34:4"/><verse number="5" style="v" sid="JER 34:5"/>ነ ሳሮ ሀይቃና። ኔፐ ካሰ ደእዳ ካዎታ ቦንቹዋስ፥ ነ ማይዛታስ እፃነ ጩይስዳይሳዳ፥ አሳይ ነ ቦንቹዋስ እፃነ ጩይሳና። ዎ ኑ ካዋዉ፥ ያግድ ነዉ ዬካና። ታኒ ጎዳይ ሀይሳ ኦዳይስ” ያጌስ።<verse eid="JER 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 34:6"/>ሄሳፈ ጉየ፥ ናበይ ኤርምያስ ሀ ትንብትያ ይሁዳ ካዋ ሰደቅያሳስ የሩሳላመን ኦድስ። <verse eid="JER 34:6"/><verse number="7" style="v" sid="JER 34:7"/>ሄ ዎደ ባብሎነ ኦላንቾት የሩሳላመ ካታማነ ይሁዳን አትዳ ላክሶነ አዜቃ ካታማታ ኦልዶሶና። ይሁዳን አትዳ ግምበትዳ ካታማት ኤንታ ፃላላ።<verse eid="JER 34:7"/></para>
  <para style="s1">አይለተፈ ላአ ከስ</para>
  <para style="p">
    <verse number="8" style="v" sid="JER 34:8"/>ካዎይ ሰደቅያስ አይለታ ላአ ከስያ አዋጁዋ አዋጃናዉ የሩሳላመን ደእያ አሳ ኡባራ ጫቅዳፐ ጉየ፥ ጎዳ ቃላይ ኤርምያሳኮ ሀይሳዳ ያግድ ይስ፦ <verse eid="JER 34:8"/><verse number="9" style="v" sid="JER 34:9"/>ሄ አዋጆይ፥ እስ እስ እብራወ አስ አደነ ማጫ አይለ አይለተፈ ላአ ከሶ። ኦንካ አይሁደ አስ ግድዳ ባ እሻ አይለ ኦፎ። <verse eid="JER 34:9"/><verse number="10" style="v" sid="JER 34:10"/>ሄሳ ግሾ፥ አሳይነ ሀላቃት ኡባይ ጫቅዳ ጫቁዋን ባንታ አደነ ማጫ አይለታ አይለተፈ ላአ ከሳናዉነ ዛሪድ አይለተን ሃሮና አጋናዉ ጊግድ ኤንታ አይለተፈ ላአ ከስዶሶና። <verse eid="JER 34:10"/><verse number="11" style="v" sid="JER 34:11"/>ሽን ኤንቲ ባንታ ቆፋ ላምድ፥ አይለተፈ ላአ ከስዳ ባንታ አደነ ማጫ አይለታ ዛሪድ ሃርዶሶና።<verse eid="JER 34:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 34:12"/>ሄሳፈ ጉየ፥ ጎዳ ቃላይ ኤርምያሳኮ ያግስ። <verse eid="JER 34:12"/><verse number="13" style="v" sid="JER 34:13"/>ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ “ታኒ ህንተ ማይዛታ ግብፀፈ፥ አይለተ ቢታፈ ከስዳ ዎደ ኤንታራ ሀይሳዳ ያጋዳ ጫቃስ። <verse eid="JER 34:13"/><verse number="14" style="v" sid="JER 34:14"/>ሄ ጫቁዋ ማራን፥ ‘እብራወ አይለይ ደእያ አሰ ኡባይ፥ አይለታ ኡሱፑን ላይ ኦስስድ፥ ላፑን ላይን አይለተፈ ከስድ የድተ’ ያጋዳ ኪታስ። ሽን ህንተ ማይዛት ታ ኦድያባ ስኦና እፅዶሶና፤ ታዉ ኪተትቦኮና። <verse eid="JER 34:14"/><verse number="15" style="v" sid="JER 34:15"/>ህንተካ ማታ ዎደፐ ካሰ ህንተ ናጋራፐ ስሚድ፥ አይለታ ላአ ከሳናዉ አዋጅደታ፤ ታ ስንን ሱረባ ኦደታ። ቃስ ሄሳ ኦናዉ ታ ስንን፥ ታ ሱንይ ፄገትያ ታ ኬን ጫቅደታ። <verse eid="JER 34:15"/><verse number="16" style="v" sid="JER 34:16"/>ሽን ህንተ፥ ህንተ ቆፋ ላምድ፥ ታ ሱን ቱንስደታ። ኤንቲ ኮይዳ በሳ ባና መላ ላአ ከስዳ አደነ ማጫ አይለታ ዛሪድ ሃርደታ።”<verse eid="JER 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 34:17"/>ሄሳ ግሾ፥ ጎዳይ፥ “ህንተ ታዉ ኪተቶና እፅድ፥ ህንተ እሻ ዎይኮ ህንተ ሾሩዋ አይለተፈ ላአ ከስያ አዋጁዋ አዋጅበከታ። ህንተ ቦላ ኦል፥ ቦሽነ ኮሽ ከያና መላ ታ አዋጃይስ። ታ ህንተና ሳአ ቦላ ደእያ ካዎተታስ ዳጋማ ኦና። <verse eid="JER 34:17"/><verse number="18" style="v" sid="JER 34:18"/>ታ ጫቁዋ መንዳ አሳ፥ ታ ስንን ጫቁዋ ናጎና እፅዳ አሳ፥ ሹክድ፥ ናምኡ በሳን ሻክድ፥ እያ ግዶራ አዳ ማራ መላ ታ ኤንታ ኦና። <verse eid="JER 34:18"/><verse number="19" style="v" sid="JER 34:19"/>ሄ አሳይ ይሁዳ ሀላቃታ፥ የሩሳላመ ሀላቃታ፥ ቢታ አይሰይሳታ፥ ካህነታነ ናምኡ በሳን ሻክዳ ማራ አሹዋ ግዶራ አዳ አሳ ኡባ። <verse eid="JER 34:19"/><verse number="20" style="v" sid="JER 34:20"/>ታ ኤንታ፥ ኤንታ ሞርከታ ኩሸንነ ኤንታ ዎናዉ ኮይያ አሳ ኩሸን አዳ እማና፤ ኤንታ አሀይ ሳሎ ካፎታስነ ሳአ ዶአታስ ካ ግዳና።<verse eid="JER 34:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 34:21"/>“ታኒ ይሁዳ ካዋ ሰደቅያሳነ እያ ሀላቃታ፥ ኤንታ ሞርከታ ኩሸን፥ ኤንታ ዎናዉ ኮየይሳታ ኩሸንነ ህንተና ኦለይሳ አግዳ ባብሎነ ኦላንቾታ ኩሸን አዳ እማና። <verse eid="JER 34:21"/><verse number="22" style="v" sid="JER 34:22"/>ታኒ ባብሎነ ኦላንቾታ ኪትን፤ ኤንቲ ሀ ካታማ ስማና። ኤንቲ ሀ ካታማ ኦላና፥ ድአናነ ታማን ፁጋና። ይሁዳን ደእያ ካታማታ አስ ዶና ባይሳ በሲ ኦና” ያጌስ ጎዳይ።<verse eid="JER 34:22"/></para>
  <chapter eid="JER 34"/>
  <chapter number="35" style="c" sid="JER 35"/>
  <para style="s1">ራካባ ያራታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 35:1"/>እዮስያሳ ናኣ ይሁዳ ካዋ እዮአቄማ ላይን፥ ጎዳ ቃላይ ኤርምያሳኮ ሀይሳዳ ያግድ ይስ። <verse eid="JER 35:1"/><verse number="2" style="v" sid="JER 35:2"/>“ራካባ ያራ ግድዳ አሳኮ ባዳ፥ ኤንታራ ኦደታዳ፥ ፆሳ ኬ ክፍለታፐ እሱዋ ግዶ ገልሳዳ ዎይነ ኡሻ ኤንታዉ እማ” ያግስ። <verse eid="JER 35:2"/><verse number="3" style="v" sid="JER 35:3"/>ታኒ ባዳ፥ ካባሳ ናኣ ናኣ፥ ኤርምያሳ ናኣ ያእዛና፥ እያ እሻታነ እያ አደ ናይታ ኡባ፥ ራካባ ያራ ኡባ ኤካዳ፥ <verse eid="JER 35:3"/><verse number="4" style="v" sid="JER 35:4"/>ፆሳ ኬ ኤሀስ። ኤንታ፥ ይግዳላ ናኣ፥ ፆሳ አስ ግድዳ ሀናና ናይታ ክፍለ ገልሳስ። ሄ ክፍለይ፥ ፐንግያ ናግያ ሳሉማ ናኣ ማእሰያ ክፍልያፐ ቦላ ባጋራ፥ ሀላቃታ ክፍልያ ማታን ደኤስ። <verse eid="JER 35:4"/><verse number="5" style="v" sid="JER 35:5"/>ሄሳፈ ጉየ፥ ታኒ ራካባ ያራታ ስንን ዎይነ ኡሻይ ኩምዳ ፁጋታነ ፁአታ ዎዳ፥ “ዎይነ ኡሻ ኡይተ” ያጋስ።<verse eid="JER 35:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 35:6"/>ሽን ኤንቲ ዛሪድ፥ “ኑ ዎይነ ኡሹ ኡዮኮ፤ ኑ ማይዛይ ራካባ ናአይ ዮናዳብ ኑኮ፥ ‘ህንተነ ህንተ ናይት ዎይነ ኡሹ መርናዉ ኡዮፕተ። <verse eid="JER 35:6"/><verse number="7" style="v" sid="JER 35:7"/>ኬ ኬፆፍተ፤ ጎሸ ጎዮፕተ፤ ዎይነ ቶኮፍተ። ዱንካነ ግዶን ደእተ፤ ህንተ አዱሳ ላይ ሀ ቢታን ዳና’ ያግስ። <verse eid="JER 35:7"/><verse number="8" style="v" sid="JER 35:8"/>ኑ ማይዛይ ራካባ ናአይ ዮናዳብ ኑና ኪትዳ ኡባ ኪተትዳ። ኑኒ ዎይኮ ኑ ማቸት ዎይኮ ኑ አደ ናይት ዎይኮ ኑ ማጫ ናይት ኑ ደኦ ላይ ኡባን ዎይነ ኡሹ ኡይቦኮ። <verse eid="JER 35:8"/><verse number="9" style="v" sid="JER 35:9"/>ዱሳ ኬ ኬፅቦኮ፤ ዎይነ ጋደ ዎይኮ ጎሽ ኑስ ባዋ። <verse eid="JER 35:9"/><verse number="10" style="v" sid="JER 35:10"/>ኑ ዱንካነን ደእዳ፤ ኑ ማይዛይ ዮናዳብ ኪትዳ ኡባ ኪተትዳ። <verse eid="JER 35:10"/><verse number="11" style="v" sid="JER 35:11"/>ሽን ባብሎነ ካዎይ ናቡካዳናፆር ኑ ቢታ ቦላ ደንድዳ ዎደ፥ ‘ባብሎነነ ሶረ ኦላንቾታፐ አታናዉ፥ የሩሳላመ ቦስ’ ያግዳ። ሀእ ኑ የሩሳላመን ደኤይ ሄሳሳ” ያግዶሶና።<verse eid="JER 35:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 35:12"/>ሄሳፈ ጉየ፥ ጎዳይ ኤርምያሳኮ ያግስ። <verse eid="JER 35:12"/><verse number="13" style="v" sid="JER 35:13"/>ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ። “ይሁዳ አሳኮነ የሩሳላመ አሳኮ ባዳ ሀይሳዳ ያጋ፤ ‘ታ ቃላ ናጋናዉ ሀይሳፈ ታማረከት።’ <verse eid="JER 35:13"/><verse number="14" style="v" sid="JER 35:14"/>ራካባ ናአይ ዮናዳብ ባ አደ ናይታ ዎይነ ኡሹ ኡዮናዳ ኪትዳ ኪታ ናግዶሶና። ኤንቲ ባንታ ማይዛ ኪታ ናግድ ሀች ጋካናዉ ዎይነ ኡሹ ኡዮኮና። ታኒ ህንተዉ ኡባ ዎደ ኦዳይስ፤ ሽን ህንተ ታና ስእቤከታ። <verse eid="JER 35:14"/><verse number="15" style="v" sid="JER 35:15"/>ታኒ ዛራዳ ዛራዳ ናበታ፥ ታ አይለታ ህንተኮ የዳስ፤ ኤንቲ፥ ‘ህንተ ኡባይ ህንተ ኢታ ኦግያፐ ስምተ፤ ህንተ ኦሱዋ ሎይተ፤ ሀራ ፆሳታ ጎይኖፍተ፤ ኤንታዉ ኦፕተ። ሄ ዎደ፥ ታ ህንተዉነ ህንተ ማይዛታስ እምዳ ቢታን ህንተ ዳና’ ያግዶሶና። ሽን ህንተ ታና ስአናዉ ህንተ ሀይ ታኮ ዛርቤከታ። <verse eid="JER 35:15"/><verse number="16" style="v" sid="JER 35:16"/>ራካባ ናኣ ዮናዳበ ኮቻት ኤንታ ማይዛይ ኤንታ ኪትዳ ኪታ ኦዶሶና፤ ሽን ሀ አሳይ ታዉ ኪተትቤና ያጋ” ያጌስ ጎዳይ።<verse eid="JER 35:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 35:17"/>“ሄሳ ግሾ፥ ጎዳይ፥ ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ። ‘ስእተ፥ ታ ይሁዳ አሳ ቦላነ የሩሳላመን ደኤይሳታ ቦላ ኤሀና ግዳ ኢታባ ኤሀና። ታ ኤንታዉ ኦድን፥ ስኦና እፅዶሶና፤ ታ ኤንታ ፄግን ኮዮና እፅዶሶና’ ” ያጌስ።<verse eid="JER 35:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 35:18"/>ሄሳፈ ጉየ፥ ኤርምያስ ራካባ ያራታኮ፥ “ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ህንተና ሀይሳዳ ያጌስ፦ ‘ህንተ፥ ህንተ ማይዛ ዮናዳባስ ኪተትዳ ግሾ፥ እያ ዎጋ ካልዳ ግሾነ እ ኪትዳ ኡባ ኦዳ ግሾ፥ <verse eid="JER 35:18"/><verse number="19" style="v" sid="JER 35:19"/>ራካባ ናአይ ዮናዳብ፥ ታዉ ኦያ አደ አስ አዉደካ የና’ ” ያጌስ።<verse eid="JER 35:19"/></para>
  <chapter eid="JER 35"/>
  <chapter number="36" style="c" sid="JER 36"/>
  <para style="s1">እዮአቄም ፃ ማፃፋ ፁግስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 36:1"/>እዮስያሳ ናአይ ይሁዳ ካዎይ እዮአቄም ካዎትዳ ኦይዳን ላይን፥ ጎዳይ ኤርምያሳኮ ሀይሳዳ ያግስ፦ <verse eid="JER 36:1"/><verse number="2" style="v" sid="JER 36:2"/>“እስ ፃ ማፃፋ ኤካዳ፥ እዮስያሳ ዎደ ታኒ ነዉ ኦዶ ዶምዳ ኮይሮ ጋላሳፐ ዶማዳ፥ ሀች ጋካናዉ እስራኤለ ቦላ፥ ይሁዳ ቦላነ ሀራ ካዎተታ ቦላ ታኒ ኦድዳ ቃላ ኡባ ፃፋ። <verse eid="JER 36:2"/><verse number="3" style="v" sid="JER 36:3"/>ታ ይሁዳ አሳ ቦላ ኤሀና ጋዳ ሀልችዳ ቦሻ ኡባ ስእድ፥ ኦን ኤር፥ ኤንቲ ባንታ ኢታ ኦሱዋፐ ስማና፤ ታ ኤንታ ናቁዋነ ኤንታ ናጋራ አቶ ጋና” ያግስ።<verse eid="JER 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 36:4"/>ሄሳ ግሾ፥ ኤርምያስ ኔራ ናኣ ባሮካ ፄግድ፥ ጎዳይ እያዉ ኦድዳባ ኡባ ባሮካስ ኦድን፥ እ ፃ ማፃፋን ፃፍስ። <verse eid="JER 36:4"/><verse number="5" style="v" sid="JER 36:5"/>ሄሳፈ ጉየ፥ ኤርምያስ ባሮካኮ፥ “ታኒ ቃሾ ኬን ደእያ ግሾ፥ ፆሳ ኬ ገላናዉ ዳንዳእከ። <verse eid="JER 36:5"/><verse number="6" style="v" sid="JER 36:6"/>ሄሳ ግሾ፥ ነ ፆማ ጋላስ ፆሳ ኬ ባዳ፥ ታ ኦድን፥ ነ ፃ ማፃፋን ፃፍዳ ጎዳ ቃላ ኤንታዉ ናባባ፤ ባንታ ካታማታፐ ይዳ ይሁዳ አሳ ኡባስ ናባባ። <verse eid="JER 36:6"/><verse number="7" style="v" sid="JER 36:7"/>ሀ አሳ ቦላ ጎዳይ አዋጅዳ ሀንቆይ ግታ ግድያ ግሾ፥ ኦን ኤር፥ ኤንቲ ባንታ ኢታ ኦሱዋፐ ስሚድ፥ ጎዳ ዎሳና” ያግስ። <verse eid="JER 36:7"/><verse number="8" style="v" sid="JER 36:8"/>ኔራ ናአይ ባሮክ ናበይ ኤርምያስ ኪትዳይሳዳ ፆሳ ኬን ጎዳ ቃላ ኡባ ናባብስ።<verse eid="JER 36:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 36:9"/>እዮስያሳ ናአይ ይሁዳ ካዎይ እዮአቄም ካዎትዳ እቻሻን ላይን፥ ኡዱፉን አጌናን፥ የሩሳላመን ደእያ አሳስነ ይሁዳ ካታማታፐ ይዳ አሳ ኡባይ ጎዳ ስንን ፆማና መላ አዋጅዶሶና። <verse eid="JER 36:9"/><verse number="10" style="v" sid="JER 36:10"/>ባሮክ ፆሳ ኬን፥ ቆሞ ባጋ ዳባባን፥ ኦራ ፐንገ ጌተትያ በሳን፥ ፃፍያ ሳፋና ናኣ፥ ጋማራ ክፍልያን ኤቅድ፥ ኤርምያሳ ቃላይ ፃፈትዳ ፃ ማፃፋ አሳ ኡባስ ናባብስ።<verse eid="JER 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 36:11"/>ሳፋና ናኣ ናአይ፥ ጋማራ ናአይ ምካይ ማፃፋፐ ጎዳ ቃላ ባሮክ ናባብሽን ስእዳ ዎደ፥ <verse eid="JER 36:11"/><verse number="12" style="v" sid="JER 36:12"/>ካዎ ጋን ፃፈይ ኡትያ ክፍልያ ብስ። እ ብያ ዎደ፥ ፃፈይ ኤልሻም፥ ሻማያ ናአይ ዳል፥ አክቦራ ናአይ ኤልናታን፥ ሳፋና ናአይ ጋማራ፥ ሀናንያ ናአይ ፅድቀነ ሀራ ሀላቃት ያን ኡትዶሶና። <verse eid="JER 36:12"/><verse number="13" style="v" sid="JER 36:13"/>ባሮክ አሳስ ማፃፋፐ ናባብሽን ስእዳ ቃላ ኡባ ምካይ ኤንታኮ ኦድስ። <verse eid="JER 36:13"/><verse number="14" style="v" sid="JER 36:14"/>ሀላቃት ናታና ናኣ ይሁዳ ባሮካኮ ኪትድ፥ “አሳስ ኔኒ ናባብዳ ማፃፋ ኤካዳ ሃ ያ” ያግዶሶና። (ናታን ሳላማ ናአ፤ ሳላም ኩሳ ናአ።) ባሮክ ማፃፋ ኤክድ፥ ኤንታኮ ይስ። <verse eid="JER 36:14"/><verse number="15" style="v" sid="JER 36:15"/>ኤንትካ እያ፥ “አነ ኡታዳ፥ ኑስ ማፃፋ ናባባ” ያግዶሶና።</para>
  <para style="p" vid="JER 36:15">ያግን ባሮክ ማፃፋ ናባብስ። <verse eid="JER 36:15"/><verse number="16" style="v" sid="JER 36:16"/>እ ናባብዳ ቃላ ኡባ ስእድ ያይዶሶና፥ እሶይ እሱዋ ፄልድ፥ ባሮካ፥ “ሀ ቃላ ኡባ ኑኒ ካዋስ ኦዳናዉ ኮሼስ” ያግዶሶና። <verse eid="JER 36:16"/><verse number="17" style="v" sid="JER 36:17"/>ቃስካ ዛሪድ፥ “ኔኒ ሀ ቃላ ኡባ ዋታዳ ፃፍዳኮ ኑስ ኦዳ። ሀይሳ ነዉ ኤርምያስ ኦድን ፃፋዲ?” ያግዶሶና።<verse eid="JER 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 36:18"/>ባሮክ፥ “ኤ፥ ሀ ቃላ ኡባ ኤርምያስ ባ ዶናፐ ታዉ ኦድስ፤ ታኒ ቃላመን ሀ ፃ ማፃፋን ፃፋስ” ያግስ።<verse eid="JER 36:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 36:19"/>ኤንቲ ባሮካ፥ “ኔንነ ኤርምያስ ብድ ቆሰትተ፤ ህንተ ደእያ በሳ ኦንካ ኤሮፖ” ያግዶሶና።<verse eid="JER 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 36:20"/>ሀላቃት ማፃፋ ፃፍያ ኤልሻማ ክፍለን ዎዳፐ ጉየ፥ ካዎይ ደእያ ዳባባ ብድ፥ ሀንዳባ ኡባ ካዋስ ኦድዶሶና። <verse eid="JER 36:20"/><verse number="21" style="v" sid="JER 36:21"/>ሄ ማፃፋ ኤሀና መላ፥ ካዎይ ይሁዳ ኪትስ፤ ፃ ማፃፋ ኤልሻማ ክፍለፐ ኤህድ፥ ካዋስነ እያ ዩሹዋን ኤቅዳ ሀላቃታስ ናባብስ። <verse eid="JER 36:21"/><verse number="22" style="v" sid="JER 36:22"/>ኡዱፉን አጌናን ሳእ ባልጎ ግድያ ግሾ፥ ካዎይ ባልጉዋ አያ ኬን ኡትስ። ሄ ዎደ ካዋ ስንን ደእያ ጮጭያን ታም ኤፄስ። <verse eid="JER 36:22"/><verse number="23" style="v" sid="JER 36:23"/>ይሁድ ሄ ዎይኮ ኦይዱ በሳታ ናባብዳፐ ጉየ፥ ካዎይ ሄ በሳታ ፃ ማፃፋፐ ማሻን ቃንፅ ቃንፅድ፥ ታማን የግስ፤ ሄሳዳ ኦድ፥ ማፃፋ ኩመ ፁግስ። <verse eid="JER 36:23"/><verse number="24" style="v" sid="JER 36:24"/>ሀ ቃላ ስእድ ካዎይነ እያራ ኦያ ሞርናት ኡባይ አይነ ባብቦኮና፤ ዎይኮ ካዮትድ፥ ባንታ ማኡዋ ፔቦኮና። <verse eid="JER 36:24"/><verse number="25" style="v" sid="JER 36:25"/>ሀር አቶሽን ኤልናታን፥ ዳላይነ ጋማር ካዎይ ሄ ማፃፋ ፁጎና መላ ዎስንካ፥ ኤንታ ዎሳ ስኦና እፅስ። <verse eid="JER 36:25"/><verse number="26" style="v" sid="JER 36:26"/>ካዋ ናአ ይራህማኤላ፥ አዝርኤላ ናኣ ሳራያነ አብድኤላ ናኣ ሰለማ፥ ፃፍያ ባሮካነ ናብያ ኤርምያሳ ኦይካና መላ ካዎይ ኪትስ። ሽን ጎዳይ ኤንታ ቆትስ።<verse eid="JER 36:26"/></para>
  <para style="s1">ኤርምያስ ዛሪድ ፃፍዳ ፃ ማፃፋ</para>
  <para style="p">
    <verse number="27" style="v" sid="JER 36:27"/>ኤርምያስ ኦድን፥ ባሮክ ፃፍዳ ማፃፋ ካዎይ ፁግድ ስምን፥ ጎዳ ቃላይ ኤርምያሳኮ ሀይሳዳ ያግሸ ይስ፦ <verse eid="JER 36:27"/><verse number="28" style="v" sid="JER 36:28"/>“ሀራ ፃ ማፃፋ ኤካዳ፥ ይሁዳ ካዎይ እዮአቄም ፁግዳ ፃ ማፃፋን ደእያ ቃላ ኡባ ዛራዳ ፃፋ። <verse eid="JER 36:28"/><verse number="29" style="v" sid="JER 36:29"/>ቃስ ይሁዳ ካዋ እዮአቄማ ሀይሳዳ ያጋ፦ ጎዳይ ሀይሳዳ ያጌስ፤ ኔኒ፥ ‘ባብሎነ ካዎይ ይድ፥ ሀ ቢታ ይሳና፤ ቃስ ያን ደእያ አሳነ መህያ ዉርሳና’ ጋዳ አይስ ፃፋዲ?” ያጋዳ ማፃፋ ፁጋዳሳ።<verse eid="JER 36:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 36:30"/>“ሄሳ ግሾ፥ ጎዳይ ይሁዳ ካዋ እዮአቄማ ሀይሳዳ ያጌስ፦ ዳዊታ አራታን ኡትያ ኮቻይ ነዉ ኩም ዴና። ነ አሀይ ጮ ሆለትድ፥ ጋላስ አዋ ሱሎስ፥ ቃማ ሜጎን ሾጨታና። <verse eid="JER 36:30"/><verse number="31" style="v" sid="JER 36:31"/>ህንተ ናጋራ ግሾ ነና፥ ነ፥ ኮቻነ ኔራ ኦያ ሞርናታ ኡባ ሴራና። ኤንቲ ታኒ ኦድዳባ ስኦና እፅዳ ግሾ፥ ታ ግዳ ኢታባ ኡባይ ህንተ ቦላ፥ ይሁዳንነ የሩሳላመን ደእያ አሳ ኡባ ቦላ ኤሀና” ያጌስ።<verse eid="JER 36:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 36:32"/>ሄሳፈ ጉየ፥ ኤርምያስ ሀራ ፃ ማፃፋ ኤክድ፥ ኔራ ናኣ ፃፍያ ባሮካስ እሚስ። ባሮክ ይሁዳ ካዎይ እዮአቄም ታማን ፁግዳ ፃ ማፃፋ ቃላ ኡባ ኤርምያስ እያዉ ዶናን ኦድን ፃፍስ። ቃስ ኤርምያስ ሄሳ ዳንያ ሀራ ቃላካ ጉጅን፥ ኡባካ ባሮክ ፃፍስ።<verse eid="JER 36:32"/></para>
  <chapter eid="JER 36"/>
  <chapter number="37" style="c" sid="JER 37"/>
  <para style="s1">ኤርምያስ ቃሾ ኬን</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 37:1"/>ባብሎነ ካዎይ ናቡካዳናፆር እዮአቄማ ናኣ እኮንያና በሳን እዮስያሳ ናኣ ሰደቅያሳ ይሁዳ ቢታን ካዎስ። <verse eid="JER 37:1"/><verse number="2" style="v" sid="JER 37:2"/>ሰደቅያስ፥ እያራ ኦያ ሀላቃትነ ቢታን ደእያ አሳ ኡባይ፥ ጎዳይ ናብያ ኤርምያሳ ባጋራ ኦድዳ ቃላስ ኪተትቦኮና። <verse eid="JER 37:2"/><verse number="3" style="v" sid="JER 37:3"/>ሽን ካዎይ ሰደቅያስ ሰለማ ናኣ ዮካላነ ማእሰያ ናኣ ካህንያ ሶፎንያሳ፥ “ሀያና፥ ኑ ግሾ ጎዳ ኑ ፆሳ ዎሳ” ያግድ ኤርምያሳኮ ኪትስ።<verse eid="JER 37:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 37:4"/>ሄ ዎደ ኤርምያስ ቃሾ ኬ ገልቦና ግሾ፥ አሳ ግዶን ስመረቴስ። <verse eid="JER 37:4"/><verse number="5" style="v" sid="JER 37:5"/>ግብፀ ካዋ ኦላንቾት፥ ግብፀፈ ከይዳይሳ የሩሳላመ ተቅዳ ባብሎነ ኦላንቾት ስእዳ ዎደ የሩሳላመ የድድ ከይዶሶና።<verse eid="JER 37:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 37:6"/>ሄሳፈ ጉየ፥ ጎዳ ቃላይ ናብያ ኤርምያሳኮ ይስ። <verse eid="JER 37:6"/><verse number="7" style="v" sid="JER 37:7"/>“ጎዳይ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ ታና ኦይቻና መላ ህንተና ታኮ ኪትዳ ይሁዳ ካዋስ ሀይሳዳ ያግተ፤ ‘ህንተና ማዳናዉ ይዳ ግብፀ ካዋ ኦላንቾት ባንታ ቢታ ስሚድ ባና። <verse eid="JER 37:7"/><verse number="8" style="v" sid="JER 37:8"/>ቃስ ባብሎነ ኦላንቾት ስሚድ ያና፤ ሀ ካታማ ኦልድ ኦይካና፤ ታማን እያ ፁጋና’ ያግተ።<verse eid="JER 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 37:9"/>“ባብሎነ ኦላንቾት ስሚድ ዩሳይ አቶና ግሾ ‘ባብሎነ ኦላንቾት ዮኮና’ ግድ ህንተና ህንተዉ ጭሞፍተ። <verse eid="JER 37:9"/><verse number="10" style="v" sid="JER 37:10"/>ህንተ ባብሎነ ኦላንቾታ ኩመ ፆንያኮካ፥ ማዱንፅድ፥ ዱንካነን ዝንእዳይሳት ደንድድ፥ ሀ ካታማ ታማን ፁጋና” ያጌስ ጎዳይ።<verse eid="JER 37:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 37:11"/>ግብፀ ካዋ ኦላንቾት ማትዳ ግሾ፥ ባብሎነ ኦላንቾት የሩሳላመ አግድ ባንታ ደእያ በሳ ጉየ ስምዶሶና። <verse eid="JER 37:11"/><verse number="12" style="v" sid="JER 37:12"/>ሄ ዎደ ኤርምያስ ባ ግሾ ቢታ ኤካናዉ ብንያመ ቢታ ባናዉ የሩሳላመፐ ደንድስ። <verse eid="JER 37:12"/><verse number="13" style="v" sid="JER 37:13"/>ግዶሽን፥ እ ብድ፥ ብንያመ ፐንገ ጋክያ ዎደ ፐንግያ ናገይሳታፐ እሶይ፥ ሀናንያ ናአይ፥ ሳሌማ ናአ ዬራ፥ “ነ ኑና ካዳዳ ባብሎነ ባሳ ግድኪ?” ያግድ ኦይክስ።<verse eid="JER 37:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 37:14"/>ኤርምያስ ዛሪድ፥ “ነ ገይሳ መላ ታ ባብሎነ ብያ አስ ግድከ” ያግስ። ሽን ዬረይ እ ገይሳ ስኦና እፅድ ኤርምያሳ ኦይክድ ሀላቃታኮ ኤፍስ። <verse eid="JER 37:14"/><verse number="15" style="v" sid="JER 37:15"/>ሀላቃት ዳሮ ሀንቀትድ፥ ኤርምያሳ ዋ፥ ኤንቲ ቃሾ ኬ ኦዳ፥ ፃፍያ ዮናታና ኬን እያ ቃችዶሶና። <verse eid="JER 37:15"/><verse number="16" style="v" sid="JER 37:16"/>ኤርምያስ ያን ቢታ ጋርሳን ደእያ ክፍልያን ዳሮ ዎደ ጋምእስ።<verse eid="JER 37:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 37:17"/>ሄሳፈ ጉየ፥ ካዎይ ሰደቅያስ አሰ ኪትድ፥ ኤርምያሳ ባ ካዎ ጋ ፄግስድ፥ ዱማ ቆሳን እያ፥ “ጎዳይ ነዉ ኦድዳባይ ደኢ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="JER 37:17">ኤርምያስ ዛሪድ፥ “ኤ ደኤስ፤ ኔኒ ባብሎነ ካዋ ኩሸን አዳ እመታና” ያግስ <verse eid="JER 37:17"/><verse number="18" style="v" sid="JER 37:18"/>ቃስካ ኤርምያስ ካዋ ሰደቅያሳ ሀይሳዳ ያግድ ኦይችስ፦ “ታና ህንተ ቃሾ ኬን የጋናዉ ታ ነ ቦላ፥ ነዉ ኦያ ሀላቃታ ቦላ ዎይኮ ሀ አሳ ቦላ አይ ባላ ኦድና? <verse eid="JER 37:18"/><verse number="19" style="v" sid="JER 37:19"/>ያትን፥ ‘ባብሎነ ካዎይ ይድ ህንተናነ ህንተ ቢታ ኦለና’ ያግድ ነዉ ትንብተ ኦድዳ ነ ናበት ሀእ አዉን ደኦና? <verse eid="JER 37:19"/><verse number="20" style="v" sid="JER 37:20"/>ታ ጎዳዉ፥ ካዋዉ፥ ስአ፤ ታ ኦይችያ እስባ ነ ፖላና መላ ነና ዎሳይስ። ታ ሄ በሳን ሀይቆና መላ እያ ኬይ ቃሾ ኬ ግድዳ ፃፍያ ዮናታና ሶ ታና ጉየ ዛሮፓ” ያግስ።<verse eid="JER 37:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 37:21"/>ካዎይ ሰደቅያስ ናገይሳታ ዳባባን ኤርምያሳ ዳና መላ ኪትስ። ያን እ ደእሽን ካታማፐ ዳቦይ ያና ጋካናዉ ጋላስ ጋላስ እስ እስ ዳቦ ኡክያ በሳፈ ኤህድ እያዉ እሞሶና። ሄሳ ግሾ፥ ኤርምያሳ ካዋ ዛባን ጋምእስ።<verse eid="JER 37:21"/></para>
  <chapter eid="JER 37"/>
  <chapter number="38" style="c" sid="JER 38"/>
  <para style="s1">ኤርምያስ ሃ ኦላን የገትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 38:1"/>ማታና ናአይ ሳፋፅ፥ ጳስኮራ ናአይ ጎዶልያ፥ ሰለማ ናአይ ዮካልነ ማልካያ ናአይ ጳስኮር ኤርምያስ አሳ ኡባስ ኦድዳ ቃላ ስእዶሶና። <verse eid="JER 38:1"/><verse number="2" style="v" sid="JER 38:2"/>ኤርምያስ፥ “ሀ ካታማን አትያ ኦንካ ኦላን፥ ኮሻንነ ቦሻን ሀይቃና። ሽን ባብሎነታስ ባ ኩሸ እምያ ኦንካ ሀይቀና፤ አታና፤ ደኦን ዳና። <verse eid="JER 38:2"/><verse number="3" style="v" sid="JER 38:3"/>የሩሳላመ ካታማይ ባብሎነ ካዋ ኦላንቾታ ኩሸን አድ እመታና፤ ኤንትካ እያ ፖሎ ድአና” ያጌስ ጎዳይ።<verse eid="JER 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 38:4"/>ሄሳፈ ጉየ፥ ሀላቃት ካዋኮ ብድ፥ “ሀ አደይ ሀይቃናዉ ኮሼስ፤ ሀይሳ መላ ኦዳ ኦድድ፥ ሀ ካታማን ደእያ ኦላንቾትነ አሳ ኡባይ ሹጋና መላ ኦስ። እ አሰ ቆህያባ አሞቴስፐ አትሽን፥ ሳሮባ አሞተና” ያግዶሶና።<verse eid="JER 38:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 38:5"/>ካዎይ ሰደቅያስ ዛሪድ፥ “ህንተ እያ ቦላ ኦና ግዳባ ታ ህንተና ድጋናዉ ዳንዳእከ” ያግስ። <verse eid="JER 38:5"/><verse number="6" style="v" sid="JER 38:6"/>ኤንቲ ኤርምያሳ ካዎ ጋ ዳባባን ደእያ፥ ካዋ ናኣ ማልካያ ሃ ኦላን፥ ዎዶሮን ዱገ የግዶሶና። ሄ ዎደ ሄ ኦላን ስልሞፐ አትሽን፥ ሃ ባዋ፤ ኤርምያስ ሄ ስልሙዋ ግዶ ገልስ።<verse eid="JER 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 38:7"/>ሽን ቶጰ አሰ ግድዳ፥ ካዎ ሞርናይ፥ አበመለከ ጌተትያ አደይ ኤርምያስ ኦላን የገትዳይሳ ስእስ። ሄ ዎደ ካዎይ ብንያመ ፐንገ ፕርዳ ኦይደን ኡትስ። <verse eid="JER 38:7"/><verse number="8" style="v" sid="JER 38:8"/>ኤበድ-መለክ ካዋኮ ብድ፥ ሀይሳዳ ያግስ፤ <verse eid="JER 38:8"/><verse number="9" style="v" sid="JER 38:9"/>“ታ ጎዳዉ ካዋዉ፥ ሀ አሳት ግታ ኢታባ ኦዶሶና፤ ኤንቲ ናብያ ኤርምያሳ ሃ ኦላን የግዶሶና። ቃስ ካታማን ቁም ባይና ግሾ እ ያን ኮሻን ሀይቃና” ያግስ።<verse eid="JER 38:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 38:10"/>ካዎይ ዛሪድ፥ ቶጰ አደይ ኤበድ-መለካኮ፥ “ሀስታሙ አስ ኔራ ኤካ ባዳ፥ ኤርምያስ ሀይቆና ደእሽን ሃ ኦላፈ ከስተ” ያግስ።<verse eid="JER 38:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 38:11"/>ኤበድ-መለክ አሰ ኤክድ፥ ብድ ካዎ ጋን ሻሎ ምንጅያ ኬፈ ጋርሳ ባጋራ ደእያ ክፍልያ ገልድ፥ ጋልአ ማኦነ ጩርቃ ኤክስ። ሄ ጩርቃ ዎዶሩዋ ፄራን ቃችድ፥ ኤርምያሳስ ዱገ ኦላ ግዶ የድስ። <verse eid="JER 38:11"/><verse number="12" style="v" sid="JER 38:12"/>ቶጰ አደይ ኤበድ-መለክ ኤርምያሳ ፄግድ፥ “ሀ ጩርቃ ማኡዋ ዎዶሩዋፐ ጋርሳራ ነ ሾጵያን ዎ” ያግስ። ኤርምያስ እ ግዳይሳዳ ኦስ። <verse eid="JER 38:12"/><verse number="13" style="v" sid="JER 38:13"/>ኤንቲ ዎዶሩዋራ ጎችድ፥ ኤርምያሳ ኦላፈ ከስድ፥ ናገይሳታ ኬ ገልስድ ጎርድዶሶና።<verse eid="JER 38:13"/></para>
  <para style="s1">ሰደቅያስ ኤርምያሳ ዛሪድ ኦይችስ</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 38:14"/>ሄሳፈ ጉየ፥ ካዎይ ሰደቅያስ ኤርምያሳ ኪትድ ኤህስድ፥ ፆሳ ኬ ገልያ ሄን ፐንግያ ማታን፥ “ታ ነና እስባ ኦይቻና፤ ነ ታፐ ቆሶፓ” ያግስ።<verse eid="JER 38:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 38:15"/>ኤርምያስ ዛሪድ፥ “ታ ኦድኮ፥ ነ ታና ዎኪ? ታ ዞርን ነ ስአካ” ያግስ።<verse eid="JER 38:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 38:16"/>ካዎይ ሰደቅያስ፥ “ደኦ ፆሳይ ኤርያ መላ፥ ታ ነና ዎከ፤ ነና ዎናዉ ኮየይሳታስ አዳ እምከ” ያግድ ቆሳን ኤርምያሳስ ጫቅስ።<verse eid="JER 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 38:17"/>ኤርምያስ ዛሪድ፥ “ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ ‘ባብሎነ ካዋ ሀላቃታስ ነ ኩሸ እምኮ፥ ነ ፓፃ አታና፤ ሀ ካታማይ ታማን ፁገተና፤ ነነ ነ ኬ አሳይ ደኦን ዳና። <verse eid="JER 38:17"/><verse number="18" style="v" sid="JER 38:18"/>ሽን ነ ኤንታዉ ኩሸ እሞና እፅኮ፥ ሀ ካታማይ ባብሎነታስ አድ እመታና፤ ኤንቲ እያ ፁጋና፤ ነ ኤንታፈ ከሳ ኤካካ’ ” ያግስ።<verse eid="JER 38:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 38:19"/>ካዎይ ሰደቅያስ፥ “ታ ያየይ ሀ ቢታ ካድድ፥ ባብሎነ ብዳ አይሁደታሳ። ባብሎነት ታና ኤንታ ኩሸን አድ እምን፥ አይሁደት ታና ካአና” ያግድ ዛርስ።<verse eid="JER 38:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 38:20"/>ኤርምያስ፥ “አይኮይ ባዋ! ኤንቲ ነና ኤንታዉ አድ እሞኮና። ታ ኦድያ ጎዳ ቃላስ ሀያና ኪተታ። ሄስ ነዉ ሎኦ ግዳና፤ ነ ፓፃ አታና። <verse eid="JER 38:20"/><verse number="21" style="v" sid="JER 38:21"/>ሽን ነ ኩሸ እሞና እፅኮ፥ ጎዳይ ታና በስዳ ቆንጨ ደኤስ። <verse eid="JER 38:21"/><verse number="22" style="v" sid="JER 38:22"/>ሄስካ፥ ይሁዳ ካዎ ጋን አትዳ ማጫሳት ኡባይ ድኤትድ፥ ባብሎነ ሀላቃታኮ ባና። ኤንቲ ኔኮ፥ ‘ነ ማታ ላገት ነና ባለዶሶና፤ ኤንቲ ነና ፆንዶሶና። ሽን ሀእ ነ ቶሆይ ስልሞ ግዶ ገልን፥ ሄ ላገት ነና የግድ ብዶሶና’ ያጋና። <verse eid="JER 38:22"/><verse number="23" style="v" sid="JER 38:23"/>ነ ማቸትነ ነ ናይት ኡባይ ባብሎነ ድኤትድ ባና። ነ ኤንታ ኩሸፐ ከሳ ኤካካ። ባብሎነ ካዎይ ነና ኦይካና። ሀ ካታማይ ታማን ፁገታና” ያግስ።<verse eid="JER 38:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 38:24"/>ሰደቅያስ ዛሪድ፥ “ሀይሳ ነ ታዉ ኦድዳይሳ አሳስ ኦዶና እፅኮ ነ ሀይቃካ። <verse eid="JER 38:24"/><verse number="25" style="v" sid="JER 38:25"/>ሀላቃት ታ ኔራ ኦደትዳይሳ ስእድ፥ ‘ኔራ ካዋራ አይ ኦደትዳኮ ኑስ ኦዳ። ነ ኑስ ቆቶና እፅኮ፥ ኑ ነና ዎኮ’ ያግድ ኦይቻና። <verse eid="JER 38:25"/><verse number="26" style="v" sid="JER 38:26"/>ኔኒ፥ ‘ታ ያን ሀይቆና መላ ታና ዛራዳ ቃሾ ኬ ግድዳ ዮናታና ሶ የዶና መላ ካዋ ዎሳስ’ ” ጋዳ ዛራ ያጋ።<verse eid="JER 38:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 38:27"/>ሄሳፈ ጉየ፥ ሀላቃት ኡባይ ኤርምያሳኮ ይድ፥ ሄ ኦይሻ ኦይችዶሶና። ካዎይ እያ ኪትዳይሳዳ ኤንታዉ ኦድስ፤ ኤርምያሳራ ካዋራ ሃሳይሽን ስእዳ አስ ባይና ግሾ ኤንቲ ስእ ግዶሶና። <verse eid="JER 38:27"/><verse number="28" style="v" sid="JER 38:28"/>የሩሳላመይ ኦይከታና ዎደይ ጋካናዉ፥ ኤርምያስ ናገይሳታ ዳባባን ጎርደትድ ጋምእስ።<verse eid="JER 38:28"/></para>
  <chapter eid="JER 38"/>
  <chapter number="39" style="c" sid="JER 39"/>
  <para style="s1">የሩሳላመ ኩንደ</para>
  <para style="r">(<ref loc="2KI 25:1-12">2 ካዎ 25:1-12</ref>፤ <ref loc="JER 52:4-16">ኤርም 52:4-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 39:1"/>ሰደቅያስ ይሁዳን ካዎትዳ ኡዱፉን ላይን፥ ታማን አጌናን፥ ባብሎነ ካዎይ ናቡካዳናፆርነ እያ ኦላንቾት ኡባይ ይድ፥ የሩሳላመ ተቅዶሶና። <verse eid="JER 39:1"/><verse number="2" style="v" sid="JER 39:2"/>ሰደቅያስ ካዎትዳ ታማነ እስን ላይን፥ ኦይዳን አጌናን፥ ኡዱፉን ጋላሳን ባብሎነ ኦላንቾት ካታማ ግምብያ መንዶሶና። <verse eid="JER 39:2"/><verse number="3" style="v" sid="JER 39:3"/>ሄ ዎደ ባብሎነ ካዋ ሀላቃት፥ ኤርጋል-ሳራስራ፥ ሳምጋር-ናቦ፥ ሳርሳክማነ ኤርጋል-ሳራስራ ጌተተይሳት ሀራ ዳሮ ሀላቃታራ እስፈ ይድ ግዶ ፐንገ ጌተትያ በሳን ኡትዶሶና።<verse eid="JER 39:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 39:4"/>ይሁዳ ካዎይ ሰደቅያስነ እያ ኦላንቾት ኡባይ ባብሎነ ኦላንቾታ በእዳ ዎደ ባቃትዶሶና። ቃማ ካታማፐ ከይድ፥ ካዋ አታክልተ በሳ ኤፍያ ኦግያራ፥ ናምኡ ድርሳ ግምበታ እስፈ ጋያ ፐንግያራ ከይድ ዮርዳኖሰ ዛንጋራኮ ስሚድ ብዶሶና። <verse eid="JER 39:4"/><verse number="5" style="v" sid="JER 39:5"/>ግዶሽን፥ ባብሎነ ኦላንቾት ኤንታ የደድ፥ እያርኮ ደምባ ጋሸ፥ ሰደቅያሳ ኦይክዶሶና። ሀማታ ቢታን፥ እርብላ ካታማን ደእያ ካዋ ናቡካዳናፆራኮ ኤፍዶሶና። ካዎይ ናቡካዳናፆር ያን ሰደቅያሳ ቦላ ፕርድስ። <verse eid="JER 39:5"/><verse number="6" style="v" sid="JER 39:6"/>ባብሎነ ካዎይ፥ ሰደቅያሳ አደ ናይታ እያ ስንን፥ እርብላ ካታማን ዎስ፤ ቃስ ይሁዳ ሀላቃታ ኡባ ዎስ። <verse eid="JER 39:6"/><verse number="7" style="v" sid="JER 39:7"/>ሰደቅያሳ አይፈታ ዎጭ ከስድ፥ እያ ባብሎነ ቢታ ኤፋናዉ ሳንላታን ቃችስ።<verse eid="JER 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 39:8"/>ባብሎነ ኦላንቾት ካዎ ጋነ አሳይ ደእያ ኬ ኡባ ታማን ፁግዶሶና፤ የሩሳላመ ግምብያካ ላልዶሶና። <verse eid="JER 39:8"/><verse number="9" style="v" sid="JER 39:9"/>ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን ካታማን አትዳ አሳነ ካድድ እያኮ ይዳ አሳ ኡባ ድእድ ባብሎነ ቢታ ኤፍስ። <verse eid="JER 39:9"/><verse number="10" style="v" sid="JER 39:10"/>ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን አይኮካ ባይና ጉ ማንቆታ ይሁዳን አግድ፥ ኤንታዉ ዎይነ ጋደነ ጎሻ ጋደ እሚስ።<verse eid="JER 39:10"/></para>
  <para style="s1">ኤርምያስ ብለትስ</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 39:11"/>ናቡካዳናፆር፥ ካዋ ናገይሳታ ሀላቃ ናቡዛርዳና ሀይሳዳ ያግድ ኪትስ፦ <verse eid="JER 39:11"/><verse number="12" style="v" sid="JER 39:12"/>“ባዳ ኤርምያሳ ኮያ ደማዳ፥ እያዉ ኮሽያባ ኡባ ኦ፤ እያ ቦላ ሀራ ኢታባ አይኮካ ኦፋ” ያግስ። <verse eid="JER 39:12"/><verse number="13" style="v" sid="JER 39:13"/>ሄሳ ግሾ፥ ናቡዛርዳን፥ ናቡሻዝባና፥ ኤርጋል-ሳራስራነ ባብሎነ ካዋ ሀላቃታ ኡባ ኪትድ፥ <verse eid="JER 39:13"/><verse number="14" style="v" sid="JER 39:14"/>ኤርምያሳ ቃሸትድ ደእያ፥ ናገይሳታ ዳባባፐ ከስዶሶና። ባ ሶ ኤፍድ ዎና መላ ሳፋና ናኣ፥ አክቃማ ናኣ ጎዶልያስ ሀዳራ እምዶሶና። ሄሳ ጋሶን፥ ኤርምያስ ባ ቢታ አሳራ እስፈ ደእስ።<verse eid="JER 39:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 39:15"/>ኤርምያስ ናገይሳታ ዳባባን ቃሸትድ ደእሽን፥ ጎዳ ቃላይ እያኮ ሀይሳዳ ያግድ ይስ። <verse eid="JER 39:15"/><verse number="16" style="v" sid="JER 39:16"/>“ባዳ፥ ቶጰ አድያ ኤበመለካኮ ሀይሳዳ ያጋ፦ ‘ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ ሀይሳዳ ያጌስ፦ ህዛፐ ጉየ ታ ኦድዳይሳዳ ሀ ካታማ ቦላ ሎኦባ ግዶናሽን፥ ዮ ኤሀና። ሄስ ኡባይ ሀንያ ዎደ ነ ሀ ካታማን ኡታዳ፥ ነ አይፈን በአና። <verse eid="JER 39:16"/><verse number="17" style="v" sid="JER 39:17"/>ግዶሽን፥ ሄ ጋላስ ታ ነና አሻና፤ ነ ያይያ፥ ነ ሞርከታ ኩሸን አዳ እምከ። <verse eid="JER 39:17"/><verse number="18" style="v" sid="JER 39:18"/>ታ ነና ፖሎ አሻና፤ ነ ኦላን ሀይቃካ፤ ነ ታናን አማነትዳ ግሾ፥ ሀይቆፐ አታና’ ” ያጌስ ጎዳይ።<verse eid="JER 39:18"/></para>
  <chapter eid="JER 39"/>
  <chapter number="40" style="c" sid="JER 40"/>
  <para style="s1">ኤርምያስ ላአተን ደእስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 40:1"/>ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን ኤርምያሳ ራማን ብርሽድ ስምን፥ ጎዳ ቃላይ ኤርምያሳኮ ይስ። ናቡዛርዳን የሩሳላመፐነ ይሁዳፐ ድእድ፥ ባብሎነ ኤፋናዉ ቃችዳ አሳ ግዶን ኤርምያስ ሳንላታን ቃሸትድ ደኤስ።<verse eid="JER 40:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 40:2"/>ካዋ ናገይሳታ ሀላቃይ ኤርምያሳ ዱማ ከስድ፥ ሀይሳዳ ያግስ፦ “ጎዳይ ነ ፆሳይ፥ ዮ ሀ ቢታ ቦላ ኤሀናይሳ ኦድስ። <verse eid="JER 40:2"/><verse number="3" style="v" sid="JER 40:3"/>እ ኤሀና ግዳይሳዳ ሀእ ኦስ፤ ጎዳ ቦላ ህንተ ናጋራ ኦዳ ግሾነ እያዉ ኪተቶና እፅዳ ግሾ ሀይስ ኡባይ ሀንስ። <verse eid="JER 40:3"/><verse number="4" style="v" sid="JER 40:4"/>ሄኮ፥ ሀእ ታ ነ ኩሸን ደእያ ሳንላታ ብርሻዳ ነና የዳስ። ታራ ባብሎነ ባና ጊኮ የ፤ ታ ነዉ ኮሽያባ ኡባ ኩንና። ባብሎነ ባናዉ ኮዮና እፅኮ አታናዉ ዳንዳኣሳ። ቢታ ኡባይ ነ ስንን ደኤስ፤ ነና ሎእዳ በሲ አዉካ ባ” ያግስ።<verse eid="JER 40:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 40:5"/>ኤርምያስ እያ ማታፐ ቦና ደእሽን፥ ናቡዛርዳን ጉጅድ ያግስ፤ “ሳፋና ናኣ፥ አክቃማ ናኣ ጎዶልያኮ ባ። ባብሎነ ካዎይ ናቡካዳናፆር እያ ይሁዳ ካታማታ ሃርያ አስ ኦድ ሹምስ። ሄሳ ግሾ፥ እያራ እስፈ ያን አሳራ ደአ፤ ዎይኮ ነና ሎእዳ በሲ አዉካ ባ” ያግስ። ካዋ ናገይሳታ ሀላቃይ እያዉ ሽንቀነ ሀራ እሞታ እምድ የድስ። <verse eid="JER 40:5"/><verse number="6" style="v" sid="JER 40:6"/>ኤርምያስ ምፅጳን ደእያ አክቃማ ናኣ ጎዶልያኮ ብስ። እ ያን አትዳ አሳራ እስፈ ደእስ።<verse eid="JER 40:6"/></para>
  <para style="s1">ጎዶልያ ሀይቁዋ</para>
  <para style="r">(<ref loc="2KI 25:22-24">2 ካዎ 25:22-24</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 40:7"/>ይሁዳ ቶራ ሞጮናታፐነ ኦላንቾታፐ ጉት ባብሎነ ካዋስ ኩሸ እምቦኮና። ኤንቲ ባብሎነ ካዎይ፥ አክቃማ ናአ ጎዶልያ ቢታ ሃረይሳ ኦድ ሹምዳይሳነ ባብሎነ ድኤትድ ቦና ይሁዳን አትዳ ማንቆታስ ሀላቃ ኦዳይሳ ስእዶሶና። <verse eid="JER 40:7"/><verse number="8" style="v" sid="JER 40:8"/>ናታና ናአይ እስማኤል፥ ቃረያ ናይት ዮሃንነ ዮናታን፥ ታንሁመታ ናአይ ሳራይ፥ ናፆፋ አድያ ዮፋ ናይትነ ማእካ አድያ ናአይ ያዛን ባንታ ኦላንቾታ ኡባራ ጎዶልያኮ ምፅጳ ይዶሶና። <verse eid="JER 40:8"/><verse number="9" style="v" sid="JER 40:9"/>ሳፋና ናአይ፥ አክቃማ ናአይ ጎዶልያ ኤንታዉ ሀይሳዳ ያግድ ጫቅስ፦ “ባብሎነታስ ኩሸ እማናዉ ያዮፍተ፤ ሄ ቢታን ደእተ። ባብሎነ ካዋስ ሃረትተ፤ ኡባባይ ህንተዉ እንጀ ግዳና። <verse eid="JER 40:9"/><verse number="10" style="v" sid="JER 40:10"/>ታ ምፅጳን ኡታዳ፥ ባብሎነ ቢታፈ ህንተራ ጋሄታናዉ ያ ኡባራ ህንተ ዶና ግዳዳ ኦደታና። ሽን ህንተ ደእያ በሳን ዎይነ፥ ሻማሆ ዛይተነ ሀራ ካ አይፈ ኡባ ሺሽድ ዳጋይተ” ያግስ።<verse eid="JER 40:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 40:11"/>ሞአበን፥ አሞነን፥ ኤዶመንነ ሀራ ቢታታን ደእያ አይሁደ ኡባይ ባብሎነ ካዎይ፥ ጉ ይሁዳ አሳት ይሁዳን አታና መላ ኦዳይሳነ ሳፋና ናአ አክቃማ ናአ ጎዶልያ ኤንታ ቦላ ሹምዳይሳ ስእዶሶና። <verse eid="JER 40:11"/><verse number="12" style="v" sid="JER 40:12"/>ኤንቲ ላለትድ ደእያ ባንታ ቢታፈ ይሁዳ ስሚድ፥ ጎዶልያ ደእያ በሳ ምፅጳ ይዶሶና። ያን ኤንቲ ዳሮ ዎይነነ ሀራ ካ አይፈ ሺሽድ ዳጋይዶሶና።<verse eid="JER 40:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 40:13"/>ሄሳፈ ጉየ፥ ቃራያ ናአይ ዮሃንነ ኩሸ እምቦና ቶራ ሞጮናት ኡባይ ጎዶልያኮ ምፅጳ ይድ፥ <verse eid="JER 40:13"/><verse number="14" style="v" sid="JER 40:14"/>“አሞነ ካዎይ ባአልስ ነና ዎና መላ ናታና ናኣ እስማኤላ የድዳይሳ ኤራይ?” ያግዶሶና። ሽን አክቃማ ናአይ ጎዶልያ ኤንታ ኦዳ አማኖና እፅስ።<verse eid="JER 40:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 40:15"/>ቃራያ ናአይ ዮሃን ምፅጳን ደእያ ጎዶልያኮ ይድ፥ “ኦንካ ኤሮና ደእሽን ባዳ፥ ናታንያ ናኣ እስማኤላ ታ ዎና። እ ነና ዎኮ፥ ነ ማታን ሺቅዳ አይሁደ ኡባይ ላለታና፤ ቃስ ይሁዳን አትዳ አሳ ኡባይ ዉራና” ያግስ።<verse eid="JER 40:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 40:16"/>ሽን አክቃማ ናአይ ጎዶልያ ዛሪድ፥ “እስማኤላባ ነ ኦድያ ኡባይ ዎርዶ ግድያ ግሾ ሄሳ መላባ ኦፋ” ያግስ።<verse eid="JER 40:16"/></para>
  <chapter eid="JER 40"/>
  <chapter number="41" style="c" sid="JER 41"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 41:1"/>ላፑን አጌናን ካዎ ኮቸ ግድድ፥ ካዋ ሞርናታፐ እሶይ፥ ኤልሳማ ናአይ፥ ናታና ናአይ እስማኤል ታሙ አሳራ እስፈ አክቃማ ናኣ ጎዶልያራ ጋሄታናዉ ምፅጳ ብስ። ኡባይ ኡትድ ካ ምሽን፥ <verse eid="JER 41:1"/><verse number="2" style="v" sid="JER 41:2"/>ናታና ናአይ እስማኤልነ እያራ ደእያ ታሙ አሳት ባንታ ማሻ ማሻ ከስድ፥ ባብሎነ ካዎይ ይሁዳ ቦላ ሹምዳ አክቃማ ናኣ ጎዶልያ ዎዶሶና። <verse eid="JER 41:2"/><verse number="3" style="v" sid="JER 41:3"/>እስማኤል ቃስ ምፅጳን ጎዶልያራ ደእያ አይሁደታነ ባብሎነ ኦላንቾታ ኡባ ዎስ።<verse eid="JER 41:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 41:4"/>ጎዶልያ ሀይቅዳ ዎንተ ጋላስ፥ ኦንካ እያ ሀይቁዋ ኤሮና ደእሽን፥ <verse eid="JER 41:4"/><verse number="5" style="v" sid="JER 41:5"/>ሴከማፐ፥ ሴሎፐነ ሳማረፐ ሆስፑን ታሙ አሳት አዛንድ፥ ባንታ ቡቻ ሜድድ፥ ባንታ ማኡዋ ዳክድ፥ ባንታ ሶምኡዋ ጋርሸ ይዶሶና። ኤንቲ ፆሳ ኬስ እምያ ካነ እፃነ ኤህዶሶና። <verse eid="JER 41:5"/><verse number="6" style="v" sid="JER 41:6"/>እስማኤል ዬክሸ ምፅጳፈ ከይድ፥ ኤንታራ ጋሄታናዉ ብስ። ኤንታ ጋሄትዳ ዎደ፥ “አክቃማ ናኣ ጎዶልያኮ ሃ ይድ እያ በእተ” ያግስ። <verse eid="JER 41:6"/><verse number="7" style="v" sid="JER 41:7"/>ኤንቲ ካታማ ገልዳ ዎደ እስማኤልነ እያራ ደእያ አሳት ኤንታ ዎድ ሃ ኦላን የግዶሶና።<verse eid="JER 41:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 41:8"/>ሽን ሄ ሆስፑን ታሙ አሳታፐ ታማት እስማኤላ ሀይሳዳ ያግድ ዎስዶሶና፦ “ኑና ዎፓ! ኑ ጎሻን ኑ ቆስዳ ዳሮ ግስተይ፥ ባንግ፥ ሻማሆ ዛይተይነ ኤስ ደኤስ” ያግዶሶና። እ ኤንታ ዎና የድ አግስ። <verse eid="JER 41:8"/><verse number="9" style="v" sid="JER 41:9"/>እስማኤል አሳ ዎድ የግዳ ኦላይ፥ እስራኤለ ኦላናዉ ባኦስ ይዳ ዎደ ካዎይ አስ ቦክስዳ ግታ ግምበትዳ ሃ ኦላ። ናታንያ ናአይ እስማኤል ሄ ኦላ አሀን ኩንስ። <verse eid="JER 41:9"/><verse number="10" style="v" sid="JER 41:10"/>እስማኤል ካዋ ማጫ ናይታነ ምፅጳን አትዳ አሳ ኡባ ድእስ። ሄሳት ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን አክቃማ ናኣ ጎዶልያ አዋተ ጋርሳን ምፅጳን ዎዳይሳታ። እ ኤንታ ድእድ፥ ባራ ኤክድ፥ አሞነ ቢታ ባናዉ ደንድስ።<verse eid="JER 41:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 41:11"/>ቃራያ ናአይ ዮሃንነ እያራ ደእያ ቶራ ሞጮናት እስማኤል ኦዳ ኢታባ ኡባ ስእዶሶና። <verse eid="JER 41:11"/><verse number="12" style="v" sid="JER 41:12"/>ባንታ አሳ ኤክድ፥ እያራ ኦለታናዉ ብዶሶና፤ እስማኤላ ጋባኦናን ደእያ ግታ ኤለ ሃ ማታን ኦይክዶሶና። <verse eid="JER 41:12"/><verse number="13" style="v" sid="JER 41:13"/>እስማኤል ድእድ ኤፍያ አሳ ኡባይ ቃራያ ናኣ ዮሃናናነ እያራ ደእያ ቶራ ሞጮናታ በእዳ ዎደ ዳሮ ኡፋይትዶሶና። <verse eid="JER 41:13"/><verse number="14" style="v" sid="JER 41:14"/>ሄ ድኤትዳይሳት ኡባይ ጉየ ስሚድ፥ ቃራያ ናኣ ዮሃናናን ጋሄትዶሶና። <verse eid="JER 41:14"/><verse number="15" style="v" sid="JER 41:15"/>ሽን እስማኤልነ ሀራ ሆስፑን አሳት ዮሃናናፐ ከስ ኤክድ፥ አሞነ ቢታ ባቃትዶሶና።<verse eid="JER 41:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 41:16"/>እስማኤል አክቃማ ናኣ ጎዶልያ ዎድ፥ ምፅጳፈ ድእድ ኤህዳ ኦላንቾት፥ ማጫሳት፥ ናይትነ ሹፋት ኡባይ ቃራያ ናኣ ዮሃናራነ ሀራ ቶራ ሞጮናታራ ደንድድ ብዶሶና። <verse eid="JER 41:16"/><verse number="17" style="v" sid="JER 41:17"/>ኤንቲ ያፐ ደንድድ፥ ግብፀ ባናዉ፥ ቤተለመ ማታን ደእያ ገሮት-ካማሀማ ጌተትያ በሳን ሸምፕዶሶና። <verse eid="JER 41:17"/><verse number="18" style="v" sid="JER 41:18"/>ኤንቲ ግብፀ ብዳይ ባብሎነ ካዎይ ሹምዳ አክቃማ ናኣ ጎዶልያ እስማኤል ዎዳ ግሾ፥ ባብሎነታስ ያይድ፥ ባብሎነፐ ባቃትድ፥ ግብፀ ባናዉ ደንድዶሶና።<verse eid="JER 41:18"/></para>
  <chapter eid="JER 41"/>
  <chapter number="42" style="c" sid="JER 42"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 42:1"/>ቶራ ሞጮናት ኡባይ፥ ቃራያ ናአይ ዮሃን፥ ሆሻያ ናአይ አዛርያስ አሳ ኡባይ፥ ጉፈ ግታ ጋካናዉ፥ <verse eid="JER 42:1"/><verse number="2" style="v" sid="JER 42:2"/>ናብያ ኤርምያሳኮ ይድ፥ “ኑ ነና ኦይችያባ ኑስ ኦርክ። አትዳ ኑ ግሾ ጎዳ ነ ፆሳ ዎሳርክ። ኑ ካሰ ዳሮ፤ ሽን ሀእ ነ በኤይሳዳ ጉ አሳ ፃላል አትዳ። <verse eid="JER 42:2"/><verse number="3" style="v" sid="JER 42:3"/>ኑ ብያ ኦግያነ ኑ ኦናባ እ ኑና በሳና መላ ጎዳ ነ ፆሳ ኑ ግሾ ዎሳ” ያግዶሶና።<verse eid="JER 42:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 42:4"/>ናበይ ኤርምያስ ዛሪድ፥ “ሎኦ፤ ህንተ ኦይሻዳ፥ ጎዳ ህንተ ፆሳ ታ ዎሳና፤ ህንተፈ አይኮካ ቆሶና እ ኦድያባ ኡባ ህንተዉ ኦዳና” ያግስ።<verse eid="JER 42:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 42:5"/>ኤንቲ ዛሪድ፥ ኤርምያሳኮ፥ “ጎዳይ ነ ፆሳይ ነ ባጋራ ኑና ኪትያባ ኡባ ኑ ፖሎና እፅኮ፥ ጎዳይ ባ ሁጰን ኑ ቦላ ቱማነ አማነትዳ ማርካ ግዶ። <verse eid="JER 42:5"/><verse number="6" style="v" sid="JER 42:6"/>ኑ ዶስያባ ግድን፥ እፅያባ ግድን፥ ኑ ነና እያኮ ኪትያ ጎዳይ፥ ኑ ፆሳይ ኪትያባ ኑ ኦና። ኑ እያዉ ኪተትኮ፥ ኑስ ኡባባይ እንጀ ግዳና” ያግዶሶና።<verse eid="JER 42:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 42:7"/>ታሙ ጋላሳፐ ጉየ፥ ጎዳ ቃላይ ኤርምያሳኮ ይስ። <verse eid="JER 42:7"/><verse number="8" style="v" sid="JER 42:8"/>ቃራያ ናኣ ዮሃና፥ እያራ ደእያ ቶራ ሞጮናታነ አሳ ኡባ፥ ጉፈ ግታ ጋካናዉ ፄግድ፥ <verse eid="JER 42:8"/><verse number="9" style="v" sid="JER 42:9"/>ህንተ ዎሳ ታ እያኮ ሺሻና መላ ህንተ ታና ኪትዳ ጎዳይ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ። <verse eid="JER 42:9"/><verse number="10" style="v" sid="JER 42:10"/>“ ‘ታ ካሰ ህንተ ቦላ ኤህዳ ኢታባይ ታና አዛንዳ ግሾ፥ ህንተ ሀ ቢታን ኡትኮ፥ ታ ህንተና ኬፃናፐ አትሽን፥ ላልከ፤ ቶካናፐ አትሽን፥ ሾድከ። <verse eid="JER 42:10"/><verse number="11" style="v" sid="JER 42:11"/>ህንተ ሀእ ያይያ ባብሎነ ካዋስ አይኮካ ያዮፍተ። ህንተና እያ ኩሸፐ አሻናዉ ታ ህንተራ ደእያ ግሾ ያዮፍተ። <verse eid="JER 42:11"/><verse number="12" style="v" sid="JER 42:12"/>ታ ህንተዉ ቃታና፤ ያታዳ እ ህንተዉ ቃትድ፥ ህንተና ህንተ ቢታ ዛራና መላ ኦና’ ያጌስ ጎዳይ።<verse eid="JER 42:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 42:13"/>“ግዶሽን፥ ህንተ ጎዳስ፥ ህንተ ፆሳስ ኪተቶና እፅድ፥ ሀ ቢታን ኡቶኮ ጊኮ፥ <verse eid="JER 42:13"/><verse number="14" style="v" sid="JER 42:14"/>ቃስ ህንተ፥ ‘ኦላ ዎረነ ኦላስ ፑንያ ሞይዘ ስኦናነ ኮሽ ባይና ግብፀ ብድ፥ ያን ዳና’ ጊኮ፥ <verse eid="JER 42:14"/><verse number="15" style="v" sid="JER 42:15"/>ህንተኖ፥ ይሁዳን አትዳ አሳዉ፥ ጎዳይ ግያባ ስእተ። ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ ‘ህንተ ግብፀ ብድ፥ ያን ዳናዉ ቆፋ ቃችኮ፥ <verse eid="JER 42:15"/><verse number="16" style="v" sid="JER 42:16"/>ህንተ ያይዳ ኦላይ ግብፀን ህንተና ኦይካና፤ ህንተ ህርግዳ ኮሻይ ህንተና ካልድ ባና፤ ህንተ ያን ግብፀን ሀይቃና። <verse eid="JER 42:16"/><verse number="17" style="v" sid="JER 42:17"/>ግብፀ ብድ ዳናዉ ቆፋ ቃችዳ አሳ ኡባይ ኦላን ዎይኮ ኮሻን ዎይኮ ቦሻን ሀይቃና። ታ ኤንታ ቦላ ኤህያ ኢታፐ እሶይካ ከስ ኤከና ዎይኮ አተና’ ያጌስ።<verse eid="JER 42:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 42:18"/>“ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ ‘የሩሳላመን ደኤይሳታ ቦላ ታ ሀንቆይነ ታ ይሎይ ጉክዳይሳዳ፥ ህንተ ግብፀ ገልያ ዎደ ህንተ ቦላ ታ ሀንቆይ ሄሳዳ ጉካና። ህንተ ዳጋማስ፥ ጫሻስ፥ ባደስነ ሚቻስ አታና፤ ሀ በሳ ዛሪድ በኤከታ’ ያጌስ።<verse eid="JER 42:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 42:19"/>“ይሁዳን አትዳይሳቶ፥ ጎዳይ ህንተኮ፥ ‘ግብፀ ቦፕተ!’ ያግስ። ታ ሀች ህንተኮ፥ ‘ናገትተ’ ገይሳ ስእተ። <verse eid="JER 42:19"/><verse number="20" style="v" sid="JER 42:20"/>ህንተ ታኮ፥ ‘ኑ ግሾ ጎዳ ኑ ፆሳ ዎሳ፤ እ ነዉ ኦድያባ ኡባ ኑስ ኦዳ፤ ኑ ኦና’ ያግድ፥ ታና ጎዳኮ፥ ህንተ ፆሳኮ፥ ኪትደታ፤ ሄሳን ግታ ባላ ባልደታ። <verse eid="JER 42:20"/><verse number="21" style="v" sid="JER 42:21"/>ታ እ ግዳባ ኡባ ሀች ህንተዉ ኦዳስ። ሽን ጎዳይ ህንተ ፆሳይ ታ ባጋራ ህንተዉ ኪትዳ ቃላስ ኪተቶና እፅደታ። <verse eid="JER 42:21"/><verse number="22" style="v" sid="JER 42:22"/>ህዛ፥ ሀይሳ ስእተ፤ ህንተ ብድ ዳናዉ ኮይያ ቢታን ህንተ ኦላን፥ ኮሻንነ ቦሻን ሀይቅድ ዉራና” ያግስ።<verse eid="JER 42:22"/></para>
  <chapter eid="JER 42"/>
  <chapter number="43" style="c" sid="JER 43"/>
  <para style="s1">ኤርምያስ ግብፀ ብስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 43:1"/>ጎዳይ ኤንታ ፆሳይ ኪትዳ ቃላ ኡባ ኤርምያስ ኤንታዉ ኦድድ ዉርስዳፐ ጉየ፥ <verse eid="JER 43:1"/><verse number="2" style="v" sid="JER 43:2"/>ሆሻያ ናአይ አዛርያስ፥ ቃራያ ናአይ ዮሃንነ ኦቶራንቾ አሳ ኡባይ ኤርምያሳኮ፥ “ነ ዎርዶ ኦዳሳ! ጎዳይ ኑ ፆሳይ ኑ ግብፀ ብድ ኡቶና መላ ድጋናዉ ነና ኑኮ ኪትቤና። <verse eid="JER 43:2"/><verse number="3" style="v" sid="JER 43:3"/>ሽን ባብሎነ አሳይ ኑና ዎናዳ ዎይኮ ድእድ ባንታ ቢታ ኤፋናዳ ነ ኑና ኤንታ ኩሸን አዳ እማና መላ ነና ኑ ቦላ ደንዳይ ኔራ ናኣ ባሮካ” ያግዶሶና።<verse eid="JER 43:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 43:4"/>ቃራያ ናአይ ዮሃን፥ ቶራ ሞጮናት ኡባይነ አሳ ኡባይ ይሁዳ ቢታን ዳና መላ ጎዳይ ኤንታ ኪትዳ ኪታ ፖሎና እፅዶሶና። <verse eid="JER 43:4"/><verse number="5" style="v" sid="JER 43:5"/>ቃራያ ናአይ ዮሃንነ ቶራ ሞጮናት ኡባይ ባንታ ላለትዳ ካዎተታ ኡባፈ ይሁዳን ዳናዉ ስምዳ ይሁዳ አሳ ባንታራ ኤክድ ግብፀ ብዶሶና። <verse eid="JER 43:5"/><verse number="6" style="v" sid="JER 43:6"/>ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን ሳፋና ናኣ፥ አክቃማ ናኣ ጎዶልያራ ዳና መላ አሽዳ አደታ፥ ማጫሳ፥ ናይታነ ካዋ ማጫ ናይታ ኡባ ኤፍዶሶና። ቃስ ናብያ ኤርምያሳነ ኔራ ናኣ ባሮካ ኤፍዶሶና። <verse eid="JER 43:6"/><verse number="7" style="v" sid="JER 43:7"/>ኤንቲ ጎዳ ኪታ እፅድ፥ ግብፀ ቢታ ገልድ፥ ፃፍናሳ ካታማ ጋካናዉ ብዶሶና።<verse eid="JER 43:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 43:8"/>ፃፍናሳን ጎዳ ቃላይ ኤርምያሳኮ ሀይሳዳ ያግድ ይስ። <verse eid="JER 43:8"/><verse number="9" style="v" sid="JER 43:9"/>“ግታ ሹቻታ ኤካዳ፥ ይሁዳ አሳይ በእሽን፥ ፃፍናሳን ደእያ ግብፀ ካዋ ጋ ገልያ በሳን ስን ባጋራ ደእያ ባሱዋን ሞጋ። <verse eid="JER 43:9"/><verse number="10" style="v" sid="JER 43:10"/>ኤንታኮ፥ ‘ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፤ ታ ኪታዳ፥ ታ አይልያ ባብሎነ ካዋ ናቡካዳናፆራ ኤህሳና። ሀ ሞገትዳ ሹቻታ ቦላ እያ ካዎተ አራታ ዎና። እ ባ ካዎተ ዱንካንያ እያ ቦላ ኤሳና። <verse eid="JER 43:10"/><verse number="11" style="v" sid="JER 43:11"/>እ ይድ ግብፀ ቢታ ኦላና። ሀይቆስ በሰይሳት ሀይቃና፤ ድኤታናዉ በሰይሳት ድኤታና፤ ማሻን ሀይቃናዉ በሰይሳት ማሻን ሀይቃና። <verse eid="JER 43:11"/><verse number="12" style="v" sid="JER 43:12"/>ግብፀን ደእያ ኤቃ ፆሳታ ኬ ታማ ኦይና፤ ኤቃታ ፁጋና ዎይኮ ድአና። ሄንንቾይ ባ እትያ ማኤይሳዳ፥ ግብፀ ቢታ ማአና። ያትድ፥ ያፐ ሳሮ ባና። <verse eid="JER 43:12"/><verse number="13" style="v" sid="JER 43:13"/>እ፥ ግብፀ ቢታን ሄልዮታ ካታማን ደእያ ሀዉልትያ መንረና፤ ግብፀ ፆሳታ ኬ ታማን ፁጋና’ ” ያግስ።<verse eid="JER 43:13"/></para>
  <chapter eid="JER 43"/>
  <chapter number="44" style="c" sid="JER 44"/>
  <para style="s1">ኤቃ ጎይኖይ ካለዳ መቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 44:1"/>ግብፀን ምግዶላ፥ ፃፍናሳ፥ መምፕሳነ ጳትሮሳ ቢታን ደእያ አይሁደታስ ጎዳ ቃላይ ኤርምያሳኮ ሀይሳዳ ያግድ ይስ። <verse eid="JER 44:1"/><verse number="2" style="v" sid="JER 44:2"/>“ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ የሩሳላመ ቦላነ ይሁዳ ካታማ ኡባ ቦላ ታ ኤህዳ ዮ ኡባ ህንተ፥ ህንተ አይፈን በእደታ። ኤንቲ ሀች ጋካናዉ ላለትድ አትዶሶና፤ ኦንካ ያን ዴና። <verse eid="JER 44:2"/><verse number="3" style="v" sid="JER 44:3"/>ሄስ ሀንዳይ፥ ኤንቲ ኢታ ኦሶ ኦድ፥ ታና ሀንቀዳ ግሾሳ። ኤንቲ ዎይኮ ህንተ ዎይኮ ህንተ ማይዛት ኤሮና ሀራ ፆሳታስ እፃነ ጩይስድ ኤንታዉ ጎይንዶሶና። <verse eid="JER 44:3"/><verse number="4" style="v" sid="JER 44:4"/>‘ታ እፅያ ሀይሳ መላ ኢታባ ኦፕተ’ ያግድ ኦዳና መላ ዛራ ዛራ ታ አይለታ፥ ናበታ ኪታስ። <verse eid="JER 44:4"/><verse number="5" style="v" sid="JER 44:5"/>ግዶሽን፥ ኤንቲ ስኦና ዎይኮ አኬኮና እፅዶሶና። ሀራ ፆሳታስ እፃነ ጩይስያ ኢታ ኦሱዋ አጎና እፅዶሶና። <verse eid="JER 44:5"/><verse number="6" style="v" sid="JER 44:6"/>ሄሳ ጋሶን ታ ሱልያ ሀንቆይነ ይሎይ ይሁዳ ካታማታ ቦላነ የሩሳላመ ኦገታን ኤፅስ። ኤንቲ ሀች ህንተ በኤይሳዳ ላለትዶሶና፤ ባይሳ ግድዶሶና።<verse eid="JER 44:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 44:7"/>“ሀእካ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ እስራኤለ ፆሳይ፥ ሀይሳዳ ያጌስ፤ ህንተ ኮቻይ አቶና መላ፥ ማጫሳ፥ አደታ፥ ናይታነ ዮጋ ናይታ ይሁዳ ቢታፈ ይሳናዳ ኢታባ ህንተ፥ ህንተ ቦላ አይስ ኦቲ? <verse eid="JER 44:7"/><verse number="8" style="v" sid="JER 44:8"/>ህንተ ዳናዉ ይዳ ግብፀ ቢታን ሀራ ፆሳታስ እፃነ ጩይስድ ታና አይስ ሀንቀቲ? ሳአን ደእያ ካዎተታ ኡባ ግዶን ባደስነ ቦረስ አትድ፥ ህንተና ይሳናዉ አይስ ኮዬቲ? <verse eid="JER 44:8"/><verse number="9" style="v" sid="JER 44:9"/>ካሰ ህንተ አዋት፥ ይሁዳ ካዎትነ ኤንታ ማቸት፥ ህንተነ ህንተ ማቸት ይሁዳ ካታማታንነ የሩሳላመ ኦገታን ኦዳ ኢታ ኡባ ዶግደትዬ? <verse eid="JER 44:9"/><verse number="10" style="v" sid="JER 44:10"/>ህንተ ሀች ጋካናዉ ህንተናተ ካዉሽበከታ፤ ታና ቦንችቤከታ። ታ ህንተዉነ ህንተ ማይዛታስ እምዳ ህግያነ ዎጋ ካልበከታ።<verse eid="JER 44:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 44:11"/>“ሄሳ ግሾ፥ ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ ሀይሳዳ ያጌስ፤ ታ ህንተና፥ ይሁዳ ዘርታ ኡባ ይሳናዉ ቆፋ ቃቻስ። <verse eid="JER 44:11"/><verse number="12" style="v" sid="JER 44:12"/>ይሁዳን አትዳ አሳ ግዶፈ፥ ግብፀ ብድ፥ ያን ዳናዉ ቆፋ ቃችዳይሳታ ታ ይሳና። ኤንቲ ኡባይ ግብፀን ዉራና፤ ኦላንነ ኮሻን ሀይቃና። ግታፐ ጉ ጋካናዉ ደእያ ኡባይ ኦላንነ ኮሻን ያና። ኤንቲ ዳጋማስ፥ ጫሻስ፥ ባደስነ ሚቻስ አታና። <verse eid="JER 44:12"/><verse number="13" style="v" sid="JER 44:13"/>ታ የሩሳላመ፥ ኦላን፥ ኮሻንነ ቦሻን ሴርዳይሳዳ ግብፀ ቢታን ደኤይሳታ ሴራና። <verse eid="JER 44:13"/><verse number="14" style="v" sid="JER 44:14"/>አትዳ ይሁዳ አሳፐ ግብፀ ብድ ደኤይሳት ግብፀታ ኩሽያፐ ፖሎ ከስ ኤኮኮና። ኤንቲ ስሚድ ዳና ግድ አሞትያ ይሁዳ ቢታ አይ አስካ ስመና። ጉ አሳፐ አትሽን፥ ኦንካ ስሚድ ዬና” ያግስ።<verse eid="JER 44:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 44:15"/>ኤንታ ማቸት ሀራ ፆሳታስ እፃነ ጩይሰ ኤርያ አደይ ኡባይ፥ ያን ደእያ ማጫሳ ኡባይነ ግታ ማባራ ግድድ፥ ግብፀንነ ጳትሮሳን ደእያ አሳ ኡባይ ኤርምያሳኮ ሀይሳዳ ያግዶሶና። <verse eid="JER 44:15"/><verse number="16" style="v" sid="JER 44:16"/>“ኔኒ ጎዳ ሱንን ኑስ ኦድያባ ኡባ ኑ ስኦኮ። <verse eid="JER 44:16"/><verse number="17" style="v" sid="JER 44:17"/>ኑ ኦና ግድ ቆፕዳባ ኡባ ኦና። ኑኒ፥ ኑ ማይዛት፥ ኑ ካዎትነ ኑ ሀላቃት ይሁዳ ካታማታንነ የሩሳላመ ኦገታን ካሰ ኦዳይሳዳ ሳሎ ካውዉ ጌተትያርስ ኑ ፆሴስ እፃነ ጩይሳና፤ ኡሻ ያርሹዋ እዉ ጉሳና። ኑ ካሰ ሄሳ ኦያ ዎደ፥ ኑስ ዳሮ ካ ደኤስ፤ ሄ ዎደ ኑስ ሳእ ኬሀ፤ ኑና አይብካ መትቤና። <verse eid="JER 44:17"/><verse number="18" style="v" sid="JER 44:18"/>ሽን ሳሎ ካዌስ እፃነ ጩይሰይሳነ ኡሻ ያርሾ ጉሰይሳ አግዳፐ ጉየ፥ ኑስ ኡባባይ ፓጭስ፤ ኑ ኦላንነ ኮሻን ዉርዳ” ያግዶሶና።<verse eid="JER 44:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 44:19"/>ማጫሳት ጉጅድ፥ “ኑ ሳሎ ካዌስ ማላን ኡይ ኡክያ ዎደ፥ እፃነ ጩይስያ ዎደነ ኡሻ ያርሾ እዉ ጉስያ ዎደ ኑ አዝናት ኤሮና ደእሽን፥ ኑ ኦዳባይ አይብካ ባዋ” ያግዶሶና።<verse eid="JER 44:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 44:20"/>ሀይሳዳ ያግድ ዛርዳ አሳ ኡባስ፥ ማጫሳስነ አደታስ፥ ኤርምያስ ሀይሳዳ ያግስ፤ <verse eid="JER 44:20"/><verse number="21" style="v" sid="JER 44:21"/>“ህንተነ ህንተ ማይዛት፥ ህንተ ካዎትነ ህንተ ሀላቃት፥ ቢታን ደእያ አሳ ኡባይ፥ ይሁዳ ካታማታንነ የሩሳላመ ኦገታን እፃነ ጩይስዳይሳ ጎዳይ ኤረና ዎይኮ ዶግስ ግድ ቆፔቲ? <verse eid="JER 44:21"/><verse number="22" style="v" sid="JER 44:22"/>ህንተ ኦያ ኢታነ ሻትያ ኦሱዋ ጎዳይ ስእ ጋናዉ ዳንዳእቦና ግሾ፥ ህንተ ቢታ ሀች ህንተ በኤይሳዳ ላለትዳ፥ ባይሳነ ባደትዳ ቢታ ኦስ። <verse eid="JER 44:22"/><verse number="23" style="v" sid="JER 44:23"/>ሀ ዮ ኡባይ ህንተና ጋክዳይ፥ ህንተ ሀራ ፆሳታስ እፃነ ጩይስዳ ግሾሳ፥ ጎዳ ቦላ ናጋራ ኦዳ ግሾሳ፥ ጎዳ ቃላ ስኦና እፅዳ ግሾሳነ እያ ህግያ፥ እያ ዎጋነ አዋጁዋስ ኪተቶና እፅዳ ግሾሳ” ያግስ።<verse eid="JER 44:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 44:24"/>ሄሳፈ ጉየ፥ ኤርምያስ አሳ ኡባስነ ማጫሳስ ሀይሳዳ ያግስ፤ “ህንተኖ፥ ይሁዳፐ ይድ፥ ግብፀ ቢታን ደእያ አሳዉ፥ ጎዳይ ግያባ ስእተ። <verse eid="JER 44:24"/><verse number="25" style="v" sid="JER 44:25"/>ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ ሀይሳዳ ያጌስ፤ ህንተነ ህንተ ማቸት፥ ‘ኑኒ ሳሎ ካዌስ እፃነ ጩይሳና፤ ኡሻ ያርሹዋ እዉ ጉሳና’ ግድ ጫቅዳ ጫቁዋ ፖልድ፥ ኦሶን በስደታ። ህዛ፥ ጉየ ጎፕተ፤ ህንተ ጫቁዋ ፖልተ።<verse eid="JER 44:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 44:26"/>“ግዶሽን፥ ህንተኖ፥ ግብፀ ቢታን ደእያ ይሁዳ አሳዉ፥ ጎዳይ ግያባ ስእተ! ጎዳይ ሀይሳዳ ያጌስ፤ ‘ህዛፐ ጉየ ግብፀ ቢታን ደእያ ይሁዳ አሳፐ እሶይካ ታ ሱንን፥ “ኡባ ሃርያ ጎዳይ ኤሮ” ’ ግድ ጫቆና መላ ታ ግታ ሱንን ጫቃስ። <verse eid="JER 44:26"/><verse number="27" style="v" sid="JER 44:27"/>ታ ኤንታ ቦላ ሎኦባ ግዶናሽን፥ ኢታባ ኤሀናዉ ምናይስ። ግብፀን ደእያ ይሁዳ አሳይ ዉራና ጋካናዉ ኦላንነ ኮሻን ሀይቃና። <verse eid="JER 44:27"/><verse number="28" style="v" sid="JER 44:28"/>ኦላፐ አትዳ ጉ አሳት ግብፀፈ ይሁዳ ስማና። ሄ ዎደ ግብፀን ደእያ ይሁዳ አሳይ፥ ታ ቃላፐነ ኤንታ ቃላፐ አዉስ ቱሜኮ ኤራና። <verse eid="JER 44:28"/><verse number="29" style="v" sid="JER 44:29"/>ታ ህንተና ሀ በሳን ሴርያ ዎደ፥ ‘ታ ህንተ ቦላ ኢታባ ኤሀና’ ግዳይስ ቱማ ግደይሳስ ታ ህንተዉ ማላታ እማና። <verse eid="JER 44:29"/><verse number="30" style="v" sid="JER 44:30"/>ታ ይሁዳ ካዋ ሰደቅያሳ እያዉ ሞርከ ግድድ፥ እያ ዎናዉ ኮይያ ባብሎነ ካዋ ናቡካዳናፆራስ አዳ እምዳይሳዳ ግብፀ ካዋ ሆፍራ እያ ዎናዉ ኮይያ እያ ሞርከታስ አዳ እማና” ያጌስ ጎዳይ።<verse eid="JER 44:30"/></para>
  <chapter eid="JER 44"/>
  <chapter number="45" style="c" sid="JER 45"/>
  <para style="s1">ባሮካስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 45:1"/>እዮስያሳ ናአይ እዮአቄም ይሁዳን ካዎትዳ ኦይዳን ላይን፥ ኔራ ናአይ ባሮክ ሀ ቃላታ ኤርምያስ ኦድን፥ ስእድ፥ ማፃፋን ፃፍስ። ሄ ዎደ ኤርምያስ እያዉ ኦድዳ ቃላይ ሀይሳ፦ <verse eid="JER 45:1"/><verse number="2" style="v" sid="JER 45:2"/>“ባሮካ፥ ጎዳይ፥ እስራኤለ ፆሳይ ኔኮ ሀይሳዳ ያጌስ፦ <verse eid="JER 45:2"/><verse number="3" style="v" sid="JER 45:3"/>ኔኒ፥ ‘ጎዳይ ታ ሳኩዋ ቦላ አዛኖ ጉጅዳ ግሾ ታኖሾ! ታኒ ኡንአን ዳቡራዳ ሸምፖ ያስ’ ” ያጋዳሳ።<verse eid="JER 45:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 45:4"/>ባሮካ፥ ጎዳይ ኔኮ ሀይሳዳ ያጌስ፦ “ታ ኬፅዳይሳ ታ ላላና፤ ታ ቶክዳይሳ ታ ሾዳና። ታ ሀይሳ ቢታ ኡባን ኦና። <verse eid="JER 45:4"/><verse number="5" style="v" sid="JER 45:5"/>ያትን፥ ነ ነዉ ግታባ ኮያዬ? ሄሳ ኮዮፓ። አሳ ኡባ ቦላ ታ ዮ ኤሀና። ሽን ነ ብዳ በሳ ኡባን ታ ነ ሸምፑዋ አሻና” ያጌስ ጎዳይ።<verse eid="JER 45:5"/></para>
  <chapter eid="JER 45"/>
  <chapter number="46" style="c" sid="JER 46"/>
  <para style="s1">ግብፀስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 46:1"/>ካዎተታባ ጎዳይ ኤርምያሳስ ኦድዳ ቃላይ ሀይሳ። <verse eid="JER 46:1"/><verse number="2" style="v" sid="JER 46:2"/>እዮኣሳ ናአይ እዮአቄም ይሁዳን ካዎትዳ ኦይዳን ላይን፥ ኤፍራፂሳ ሻፋ ማታን፥ ካርካምሻ ጌተትያ በሳን፥ ባብሎነ ካዎይ ናቡካዳናፆር ፆንዳ ግብፀ ካዋ ናኮ ኦላንቾታባ ጎዳይ ሀይሳዳ ያጌስ።<verse eid="JER 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 46:3"/>ህንተ ቶራነ ጎንዳለ ጊግስተ፤</para>
  <para style="q2" vid="JER 46:3">ኦላስ ከይተ።<verse eid="JER 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 46:4"/>ህንተ ፓራታ ብፃልድ ቶግተ፤</para>
  <para style="q2" vid="JER 46:4">ህንተ ሁጵያን ብራታ ባርኔፃ ዎተ።</para>
  <para style="q1" vid="JER 46:4">ህንተ በሳ በሳ ኦይክተ፤</para>
  <para style="q2" vid="JER 46:4">ህንተ ቶራ ሌፍተ፤</para>
  <para style="q2" vid="JER 46:4">ህንተ ኦላ ማኡዋ ማእተ።<verse eid="JER 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 46:5"/>“ሽን ሀይስ ታ በኤይ አይቤ?</para>
  <para style="q2" vid="JER 46:5">ኤንቲ ያይድ ጉየ ስምዶሶና።</para>
  <para style="q1" vid="JER 46:5">ዎልቃማት ፆነትዶሶና፤</para>
  <para style="q2" vid="JER 46:5">ጉየ ፄሎና ባቃትዶሶና፤</para>
  <para style="q2" vid="JER 46:5">ኤንታ ዩሾ ኡባን ዳጋም ደኤስ”</para>
  <para style="m" vid="JER 46:5">ያጌስ ጎዳይ።<verse eid="JER 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 46:6"/>ኤሶተይስ ከስ ኤከና፤</para>
  <para style="q2" vid="JER 46:6">ምኖይካ አታናዉ ዳንዳኤና።</para>
  <para style="q1" vid="JER 46:6">ፑደሀ ባጋን ኤፍራፂሳ ሻፋ ማታን፥</para>
  <para style="q2" vid="JER 46:6">ኡባይ በትድ ኩንድዶሶና።<verse eid="JER 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 46:7"/>ሀይስ ናይለ ሻፋ ክፃዳ ደንደይ፥</para>
  <para style="q2" vid="JER 46:7">ድኦ ሃዳ ጎገይ ኦኔ?<verse eid="JER 46:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 46:8"/>ግብፀይ ናይለ ሻፋዳ ደንዴስ፤</para>
  <para style="q2" vid="JER 46:8">ድኦ ሃዳ ጉፔስ።</para>
  <para style="q1" vid="JER 46:8">ግብፀይ፥ “ታኒ ክፃዳ፥ ቢታን ኤላና፤</para>
  <para style="q2" vid="JER 46:8">ካታማታነ እያን ደእያ አሳ ኡባ ይሳና” ያጌስ።<verse eid="JER 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 46:9"/>ፓራቶ፥ ጉፕድ ከይተ፤</para>
  <para style="q2" vid="JER 46:9">ፓራ ጋረቶ ዎፅተ።</para>
  <para style="q1" vid="JER 46:9">ጎንዳለ ኦይክዳ ቶጰነ ፑፃ አሳዉ፥</para>
  <para style="q2" vid="JER 46:9">ዶንገን ዱክያ ሉዳ አሳዉ፥</para>
  <para style="q2" vid="JER 46:9">ምኖ ኦላንቾቶ፥ ደንድድ ኦለትተ።<verse eid="JER 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 46:10"/>ሄ ጋላሳይ ጎዳ ኡባፈ ዎልቃማ ጎዳ ጋላስ፥</para>
  <para style="q2" vid="JER 46:10">ጎዳይ ባ ሞርከታ ቦላ ሀሎ ከይያ ጋላስ።</para>
  <para style="q1" vid="JER 46:10">እያ ማሻይ ካላና ጋካናዉ ኤንታ ማና፤</para>
  <para style="q2" vid="JER 46:10">አላና ጋካናዉ ኤንታ ሱ ኡያና።</para>
  <para style="q1" vid="JER 46:10">ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥</para>
  <para style="q2" vid="JER 46:10">ፑደሀ ባጋን ኤፍራፂሳ ሻፋ ማታን፥</para>
  <para style="q2" vid="JER 46:10">ኤንታ ያርሾ ኦድ ኤካና።<verse eid="JER 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 46:11"/>ጌላኤ፥ ግብፀ ማጫ ናተ፥</para>
  <para style="q2" vid="JER 46:11">ጋላዳ ቢታ ባዳ ትየትያ ለ ኤሀ።</para>
  <para style="q1" vid="JER 46:11">ግዶሽን፥ ነ ጮ ለ ዳርሳሳፐ አትሽን፥</para>
  <para style="q2" vid="JER 46:11">ነዉ ፓፆይ ባዋ።<verse eid="JER 46:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 46:12"/>ካዎተት ነ ዬላ ስእዶሶና፤</para>
  <para style="q2" vid="JER 46:12">ነ ዬሆይ ቢታ ኡባ ኩማና።</para>
  <para style="q1" vid="JER 46:12">ነ ኦላንቾት እሶይ እሱዋን በትድ፥</para>
  <para style="q2" vid="JER 46:12">ኡባይ እስፈ ኩንድዶሶና።<verse eid="JER 46:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 46:13"/>ባብሎነ ካዎይ ናቡካዳናፆር ግብፀ ኦላናዉ ያናይሳ፥ ጎዳይ ናብያ ኤርምያሳስ ኦድዳ ቃላይ ሀይሳ፦<verse eid="JER 46:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 46:14"/>ሀይሳ ግብፀን ኦዳ፤</para>
  <para style="q2" vid="JER 46:14">ምግዶላን፥ መምፕሳንነ ፃፍናሳን አዋጃ።</para>
  <para style="q1" vid="JER 46:14">ህንተ በሳን በሳን ኤቅተ፤ ጊገትተ፤</para>
  <para style="q2" vid="JER 46:14">ህንተ ዩሹዋን ደእያ ኡባ ማሽ ማና።<verse eid="JER 46:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 46:15"/>ህንተ ምኖ ኦላንቾት አይስ ኩንድዴ?</para>
  <para style="q2" vid="JER 46:15">ጎዳይ ኤንታ ሱግዳ ግሾ ግደኔ?<verse eid="JER 46:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 46:16"/>ኦላንቾት በትድ ኩንድዶሶና፤</para>
  <para style="q2" vid="JER 46:16">እሶይ እሱዋ፥ “ደንድድ የተ፤</para>
  <para style="q2" vid="JER 46:16">ሞርከ ማሻፈ አታናዉ፥</para>
  <para style="q2" vid="JER 46:16">ኑ አሳኮ፥ ኑ ቢታ ስሞስ” ያጎሶና።<verse eid="JER 46:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 46:17"/>ኤንቲ ያን ግብፀ ካዋኮ፥</para>
  <para style="q2" vid="JER 46:17">“ባ ቃዳ ጎኤቶና ጮ ዉርስያ ኦዳንቾ” ግድ ሱንና።<verse eid="JER 46:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 46:18"/>“ኡባፈ ዎልቃማ ጎዳ” ጌተትያ</para>
  <para style="q2" vid="JER 46:18">ካዎይ ሀይሳዳ ያጌስ፦</para>
  <para style="q1" vid="JER 46:18">“ታኒ፥ ታ ሸምፑዋን ጫቃይስ፤</para>
  <para style="q2" vid="JER 46:18">ደረታ ግዶን ታቦረ ደረይ፥</para>
  <para style="q2" vid="JER 46:18">አባ ማታን ደእያ ቃርመሎሳ ደረይ፥</para>
  <para style="q2" vid="JER 46:18">አዱቀይሳዳ አዱቅያ ሞርከይ ህንተ ቦላ ያና።<verse eid="JER 46:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 46:19"/>ህንተኖ፥ ግብፀን ደኤይሳቶ፥</para>
  <para style="q2" vid="JER 46:19">ድኤትድ ባናዉ ጊግተ።</para>
  <para style="q1" vid="JER 46:19">መምፕሳ ካታማይ ላለትድ፥</para>
  <para style="q2" vid="JER 46:19">ኦንካ ደኦና መላ ቢታ ግዳና።<verse eid="JER 46:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 46:20"/>ግብፀይ ሎኦ ኡሳ መላ፤</para>
  <para style="q2" vid="JER 46:20">ሽን ፑደሀ ባጋ ቢታፈ ያ</para>
  <para style="q2" vid="JER 46:20">ቦፅያን እያ ሳፀታና።<verse eid="JER 46:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 46:21"/>ሚሸይ ጭገትን ኦያ ኦላንቾት</para>
  <para style="q2" vid="JER 46:21">ሞዳ ዎፋኖ መላ።</para>
  <para style="q1" vid="JER 46:21">ኤንታ ዮ ጋላሳይ ማትዳ ግሾ፥</para>
  <para style="q2" vid="JER 46:21">ኤንቲ ሴረትያ ዎደይ ጋክዳ ግሾ፥</para>
  <para style="q2" vid="JER 46:21">ኤንቲ እስፈ ጉየ ስሚድ ባቃትዶሶና፤</para>
  <para style="q2" vid="JER 46:21">ኤንቲ ባንታ በሳን ኤቅቦኮና።<verse eid="JER 46:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 46:22"/>ሞርከይ ዎልቃን ሱግድ ያ ዎደ፥</para>
  <para style="q2" vid="JER 46:22">ግብፀ አሳይ ባቃትያ ሾሻዳ ኮልፃና።</para>
  <para style="q1" vid="JER 46:22">ሞርከት ም ቃንፅያ አሳዳ፥</para>
  <para style="q2" vid="JER 46:22">ካልታ ኤክድ እያ ቦላ ያና።<verse eid="JER 46:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 46:23"/>አሳይ ስፅዳ ዎራ ቄፅድ ይሰይሳዳ፥</para>
  <para style="q2" vid="JER 46:23">ግብፀ አሳ ቃንፅድ ዉርሳና</para>
  <para style="q1" vid="JER 46:23">ሞርከታ ታይቦይ ቦለፐ ዳሮ፤</para>
  <para style="q2" vid="JER 46:23">ኤንታ ታይባናዉ ዳንዳኤተና።<verse eid="JER 46:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 46:24"/>ግብፀ ማጫ ናእያ ካዉያና፤</para>
  <para style="q2" vid="JER 46:24">ፑደሀ ባጋ አሳስ አዳ እመታና።”<verse eid="JER 46:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 46:25"/>ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ። “ታኒ ተብሳ ፆሳ አሞነ፥ ካዋ ፓሮና፥ ግብፀ ቢታነ ግብፀ ፆሳታ፥ ግብፀ ካዎታነ ካዋ ፓሮና ቦላ ዘምፕያ ኡባ ሴራና። <verse eid="JER 46:25"/><verse number="26" style="v" sid="JER 46:26"/>ኤንታ ሸምፑዋ ኮይያ ባብሎነ ካዋ ናቡካዳናፆራ ኩሸንነ እያ ኦላንቾታ ኩሸን አዳ እማና። ሄሳፈ ጉየ፥ ግብፀ ቢታይ ካሰይሳዳ አስ ደእያ ቢታ ግዳና” ያጌስ ጎዳይ።<verse eid="JER 46:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 46:27"/>“ታ አይልያዉ፥ ያይቆባ ያዮፋ፤</para>
  <para style="q2" vid="JER 46:27">እስራኤለ፥ ዳጋሞፋ።</para>
  <para style="q1" vid="JER 46:27">ነና ሃሆ በሳፈ፥</para>
  <para style="q2" vid="JER 46:27">ነ ኮቻይ ድኤትድ ብዳ ቢታፈ አሻና።</para>
  <para style="q1" vid="JER 46:27">ያይቆብ ስሚድ፥ ሳሮን ዎፑ ግድ ዳና፤</para>
  <para style="q2" vid="JER 46:27">ኤንታ ያሽስያባይ ዴና።<verse eid="JER 46:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 46:28"/>ታ አይልያዉ፥ ያይቆባ፥</para>
  <para style="q2" vid="JER 46:28">ታ ኔራ ደእያ ግሾ፥ ያዮፋ።</para>
  <para style="q1" vid="JER 46:28">ታ ነና ላልዳ ካዎተታ ኡባ ይሳና፤</para>
  <para style="q2" vid="JER 46:28">ሽን ነና ይስከ።</para>
  <para style="q1" vid="JER 46:28">ታ ነና ፅሎ ፕርዳን ሴራና፤</para>
  <para style="q2" vid="JER 46:28">ሽን ሴር ባይና ነና ጮ አግከ” ያጌስ ጎዳይ።<verse eid="JER 46:28"/></para>
  <chapter eid="JER 46"/>
  <chapter number="47" style="c" sid="JER 47"/>
  <para style="s1">ፍልስፄመስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 47:1"/>ግብፀ ካዎይ ጋዛ ኦልድ ኦይካናፐ ካሰ፥ ፍልስፄመባ ጎዳፐ ናብያ ኤርምያሳኮ ይዳ ቃላይ ሀይሳ፦ <verse eid="JER 47:1"/><verse number="2" style="v" sid="JER 47:2"/>ጎዳይ ሀይሳዳ ያጌስ፤</para>
  <para style="q1" vid="JER 47:2">“ሄኮ፥ ፑደሀ ባጋፈ ሃ ቃና፤</para>
  <para style="q2" vid="JER 47:2">ድኦይ ገልዳ ክፃ ሃዳ ጎጋና።</para>
  <para style="q1" vid="JER 47:2">ቢታነ ቢታን ደእያባ ኡባ፥</para>
  <para style="q2" vid="JER 47:2">ካታማታነ ኤንታ ግዶን ደእያ አሳ ኡባ ሙካና።</para>
  <para style="q1" vid="JER 47:2">አሳይ ዋሳና፤</para>
  <para style="q2" vid="JER 47:2">ቢታን ደእያ ኡባይ ዬካና።<verse eid="JER 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 47:3"/>ፓራታ ግርሳ፥</para>
  <para style="q2" vid="JER 47:3">ፓራ ጋረታ ኮሽንቻ፥</para>
  <para style="q2" vid="JER 47:3">ጋረታ ጎንዶርሳ ግርሳ ስአና።</para>
  <para style="q1" vid="JER 47:3">አዋታ ኩሸይ አርጋጭዳ ግሾ፥</para>
  <para style="q2" vid="JER 47:3">ባንታ ናይታ ማዳናዉ ጉየ ስሞኮና።<verse eid="JER 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 47:4"/>ፍልስፄመ አሳ ይሳናዉ፥</para>
  <para style="q2" vid="JER 47:4">ፅሮሳነ ስዶና ማዳናዉ አትያ</para>
  <para style="q2" vid="JER 47:4">አሳ ይሳናዉ ዎደይ ጋክስ።</para>
  <para style="q1" vid="JER 47:4">ጎዳይ ፍልስፄመፐ አትዳይሳታ፥</para>
  <para style="q2" vid="JER 47:4">ሃን ተቀትዳ ደእያ ካፍቶራፐ ይዳ ኮቻታ ይሳና።<verse eid="JER 47:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 47:5"/>ጋዝ ካዮታዳ ባ ሁጵያ ሜዳሱ፤</para>
  <para style="q2" vid="JER 47:5">አስቃሎን ባ ኩሽያ ዶና ቦላ ዎሱ።</para>
  <para style="q1" vid="JER 47:5">ህንተኖ፥ አባ ጋፃን አትዳይሳቶ፥</para>
  <para style="q2" vid="JER 47:5">አዉደ ጋካናዉ ህንተ አሳተ ጋረቲ?<verse eid="JER 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 47:6"/>ህንተ፥ ‘ጎዳ ማሻዉ፥ ኔኒ ስእ ጎና እፀይ አዉደሴ?</para>
  <para style="q2" vid="JER 47:6">ነ በሳ ስማዳ ገላ፤</para>
  <para style="q2" vid="JER 47:6">ስእ ጋዳ ኡታ’ ያጌታ።<verse eid="JER 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 47:7"/>ሽን ጎዳይ እያ ኪትን፥ እ ዋንድ ስእ ጋኔ?</para>
  <para style="q2" vid="JER 47:7">አስቃሎናነ አባ ጋፃን ደእያ ቢታ</para>
  <para style="q2" vid="JER 47:7">ኦላና መላ ኪታስ” ያግስ።<verse eid="JER 47:7"/></para>
  <chapter eid="JER 47"/>
  <chapter number="48" style="c" sid="JER 48"/>
  <para style="s1">ሞአበስ ኦደትዳ ትንብተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 48:1"/>ሞአበ ኡባፈ ዎልቃማ ጎዳይ፥</para>
  <para style="q2" vid="JER 48:1">እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፤</para>
  <para style="q1" vid="JER 48:1">“እ ያና ግሾ፥ ናቦ ካታማ አየ!</para>
  <para style="q2" vid="JER 48:1">ቅራታይማ ካታማይ ዬላታናነ፤ ኦይከታና፤</para>
  <para style="q2" vid="JER 48:1">ኤንታ ሚፃይ ካዉያና፤ መቀረታና።<verse eid="JER 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 48:2"/>ህዛፐ ሞአበ ጬቆይ ያና፤</para>
  <para style="q2" vid="JER 48:2">ሀሰቦና ካታማ አሳይ ሞአበ ቦላ፥</para>
  <para style="q2" vid="JER 48:2">‘ሃይተ፥ ሀ ቢታ ይሳና’</para>
  <para style="m" vid="JER 48:2">ያግድ ኢታባ ማቀትስ።</para>
  <para style="q1" vid="JER 48:2">ነኖ፥ ማድማና ካታመ፥</para>
  <para style="q2" vid="JER 48:2">ማሽ ነና የደና ግሾ ስእ ጋ።<verse eid="JER 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 48:3"/>ሆሮናይማ አሳይ፥ ‘ዮይነ ኩንደ፥</para>
  <para style="q2" vid="JER 48:3">ጋክስ’ ግድ ዋስያ ዋሱዋ ስእተ!<verse eid="JER 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 48:4"/>ሞአበይ መቀረታና፤</para>
  <para style="q2" vid="JER 48:4">እያ ናይት ዬክያ ዬሁዋ ስእተ!<verse eid="JER 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 48:5"/>ኤንቲ ዬክሸ፥ ሉህታ ፑደ ከያና፤</para>
  <para style="q2" vid="JER 48:5">ሆሮናይማፐ ዱገ ዎሸ፥</para>
  <para style="q2" vid="JER 48:5">ዮ ዋሱዋ ስአና።<verse eid="JER 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 48:6"/>እሶይ እሶይ፥ ‘ባቃትተ፤ ህንተ ሸምፕዉ አሽተ፤</para>
  <para style="q2" vid="JER 48:6">መላ ቢታን ደእያ አሮኤራዳ ዱማትተ፥</para>
  <para style="q2" vid="JER 48:6">ህንተ ሸምፑዋ አሽተ’ ያጋና።<verse eid="JER 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 48:7"/>ኔኒ ነ ዎልቃንነ ነ ዱረተን ጬቀትዳ ግሾ፥</para>
  <para style="q2" vid="JER 48:7">ነካ ድኤታና።</para>
  <para style="q1" vid="JER 48:7">ካሞሽካ ባ ካህነታራነ ሀላቃታራ፥</para>
  <para style="q2" vid="JER 48:7">ድኤትድ ባና።<verse eid="JER 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 48:8"/>ጎዳይ ኦድዳይሳዳ፥</para>
  <para style="q2" vid="JER 48:8">ካታማ ኡባ ይሰይስ ያና።</para>
  <para style="q1" vid="JER 48:8">እስ ካታምካ አተና፤</para>
  <para style="q2" vid="JER 48:8">ዛንጋራይነ ደምባ ኡባይ ያና።<verse eid="JER 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 48:9"/>ሞአበይ ፓልድ አታና መላ</para>
  <para style="q2" vid="JER 48:9">ቀፈ እምተ።</para>
  <para style="q1" vid="JER 48:9">እ ካታማይ ያና</para>
  <para style="q2" vid="JER 48:9">ላትያ አስካ ደመና።<verse eid="JER 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 48:10"/>ጎዳ ኦሱዋ ቀል ግድ ኦያ</para>
  <para style="q2" vid="JER 48:10">ኡራይ ባደትዳይሳ ግዶ።</para>
  <para style="q1" vid="JER 48:10">ሱ ጉሶና መላ ባ ማሻ ተቅያ</para>
  <para style="q2" vid="JER 48:10">ኡራይ ባደትዳይሳ ግዶ!<verse eid="JER 48:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 48:11"/>“ሞአበይ ያላጋተፈ ዶምድ፥ እንጀን ደእዳ አሳ መላ፤ እ ሀራ ቢታ ድኤትቤና። ሞአበይ ኦቶፐ ኦቶን ትገቶናነ ቃፆና፥ ማልኦይ ላመቶናነ ሳዎይ አጎና፥ ኡትድ ደእዳ ዎይነ ኡሻ መላ። <verse eid="JER 48:11"/><verse number="12" style="v" sid="JER 48:12"/>ታኒ ኦቱዋ ጉፓንይሳታ ኪትያ ዎደይ ያና። ኤንቲ እያ ጉሳና፤ ኦቱዋፐ ፂዞ ይሳና፤ ኦቱዋ መንረና። <verse eid="JER 48:12"/><verse number="13" style="v" sid="JER 48:13"/>እስራኤለ አሳይ ባ አማነትዳ፥ ቤተለን ደእያ ኤቃን ካዉይዳይሳዳ ሞአበይ ባ ፆሳ ካሞሻን ካዉያና።<verse eid="JER 48:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 48:14"/>“ህንተ፥ ‘ኑ ዎልቃማ አስነ ምኖ ኦላንቾ’ ግድ አይስ ጬቀተቲ? <verse eid="JER 48:14"/><verse number="15" style="v" sid="JER 48:15"/>ሄኮ፥ ሞአበይነ ያን ደእያ ካታማት ይዶሶና። እያ ያላጋ አደ ናይት ሹከታናዉ ዱገ ብዶሶና” ያጌስ፥ ካዎይ፥ ኡባፈ ዎልቃማ ጎዳይ። <verse eid="JER 48:15"/><verse number="16" style="v" sid="JER 48:16"/>ሞአበ ዮይ ማታትስ፤ እያ ላለተ ዎደይ ኤለስድ ጋክስ።<verse eid="JER 48:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 48:17"/>እያ ዩሹዋን ደእያ አሳይ፥ እያ ግታተ ኤርያ ኡባይ፥ “ምኖ ግድዳ ካዎተ ፃምአይ ዋንድ መቅዴ?” ቦንቸትዳ ፃምአይ ዋንድ ትንቸትዴ? ያግድ ዘሌልተ።<verse eid="JER 48:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 48:18"/>“ህንተኖ፥ ድቦና ካታማን ደኤይሳቶ፥ ህንተ ቦንቾ በሳፈ ዎድ፥ መላ ቢታን ኡትተ። ሞአበ ይሰይስ ህንተ ቦላ ያና፤ ህንተ ሚፃ ኡባ ላላና። <verse eid="JER 48:18"/><verse number="19" style="v" sid="JER 48:19"/>አሮኤራ ካታማን ደኤይሳቶ፥ ኦገ ዶናን ኤቅድ ፄልተ፤ ከስ ኤክድ ባቃትያ አደታነ ማጫሳ፥ ‘አይበ ከይዳይ?’ ያግድ ኦይችተ። <verse eid="JER 48:19"/><verse number="20" style="v" sid="JER 48:20"/>ኤንቲ፥ ‘ሞአበይ ኩንድዳ ግሾ ካዉይስ፤ እያዉ ዬክተነ ዘሌልተ። ሞአበ ይዳይሳ ግሾ አርኖና ሻፋ ማታን አዋጅተ’ ” ያግድ ዛራና።<verse eid="JER 48:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 48:21"/>“ገዘን ደእያ ሆሎና፥ ያሳ፥ መፋታ፥ <verse eid="JER 48:21"/><verse number="22" style="v" sid="JER 48:22"/>ድቦና፥ ናቦ፥ ቤት-ድብላታይማ፥ <verse eid="JER 48:22"/><verse number="23" style="v" sid="JER 48:23"/>ቅራታይማ፥ ቤት-ጋሙላ፥ ቤት-ማኦና፥ <verse eid="JER 48:23"/><verse number="24" style="v" sid="JER 48:24"/>ቅርዮታነ፥ ባሶራ ካታማታ ቦላነ ማታንነ ሃሆን ደእያ ሞአበ ካታማታ ቦላ ፕርድ ይስ። <verse eid="JER 48:24"/><verse number="25" style="v" sid="JER 48:25"/>ሞአበ ካጨይ ቃንፀትስ፤ እያ ቀሰይ መቅስ።”<verse eid="JER 48:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 48:26"/>ጎዳ ቦላ ኦቶርትዳ ግሾ፥ ሞአበ ኡሽድ ማይተ። ባ ጮሻ ቦላ ጎንዶረቶ፤ አሳ ኡባይ እያ ቦላ ቀልቅሶ። <verse eid="JER 48:26"/><verse number="27" style="v" sid="JER 48:27"/>ካሰ ነ እስራኤለ ቦላ ቀልቅሳብኪ? እያባ ሃሳያ ዎደ ካዳ ሁጰ ቃዳይ እስራኤለይ ካይሶታራ ኦይከትዳ ግሾዬ? <verse eid="JER 48:27"/><verse number="28" style="v" sid="JER 48:28"/>ህንተኖ፥ ሞአበን ደኤይሳቶ፥ ካታማፐ ከይድ፥ ሹቻ ሆምኦን ደእተ። አፎ ዶናን ባዉ ኬ ኬፅያ ሆለ መላ ግድተ። <verse eid="JER 48:28"/><verse number="29" style="v" sid="JER 48:29"/>ሞአበይ ዳሮ ኦቶርትስ፤ ሞአበይ አይ መላ ባ ጋና ጋቢስዳኮ፥ ጬቀትያኮ፥ ኦቶርትያኮ፥ አይ መላ ባና ቁ ኦያኮ፥ ታ ስአስ። <verse eid="JER 48:29"/><verse number="30" style="v" sid="JER 48:30"/>ታ ኤንታ ጬቁዋ ኤራይስ፤ ሽን አይኮካ ማደና፤ ኤንታ ኦቶሮይ አይኮካ ኦና። <verse eid="JER 48:30"/><verse number="31" style="v" sid="JER 48:31"/>ሄሳ ግሾ፥ ታ ሞአበስ ዋሳስ፤ ቅር-ሄሬሳ አሳስ ካዮታዳ ዬካይስ።<verse eid="JER 48:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 48:32"/>ህንተኖ፥ ሰባማ አሳዉ፥ ያእዜራ አሳስ ዬከይሳፈ አዳ ህንተዉ ዬካይስ። ህንተ ታሸይ ዳይድ፥ ማፅነ አባ ፕንድ፥ ያእዜራ ጋክዳ ዎይነ መላ፤ ሽን ህንተ ዎይነ አይፍያነ ዉርጩዋ ቦንቀይሳት ይድ ይስዶሶና። <verse eid="JER 48:32"/><verse number="33" style="v" sid="JER 48:33"/>ኡፋይስነ ሎኦባይ አይፍያ ሞአበ ቢታፈ ኤከትስ። ዎይነ ጉምእያ በሳፈ ዎይነይ ጎጎናዳ ተቃስ። ኦንካ እልልሸ ዎይነ ጉምኤና። ስኤትያ ግርስ ደእኮካ ኡፋይሳ ግርስ ግደና።<verse eid="JER 48:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JER 48:34"/>ኤንቲ ሀሰቦናንነ ኤልያላን ዋስያ ዋሶይ ያሃፃ ጋካናዉ ስኤቴስ። ዞኣራፐ ብድ ሆሮናይማነ ኤግላት-ሻልሻ ጋካናዉ ስኤቴስ። ሀር አቶሽን፥ ንምርማ ሃይ መልስ።<verse eid="JER 48:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JER 48:35"/>ታኒ ሞአበፐ ቃ በሳታን ጎይነሳታነ ባንታ ፆሳታስ እፃነ ጩይሰይሳታ ይሳና።<verse eid="JER 48:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 48:36"/>“ኤንቲ ካሰ ደምዳ ዱረተይ ሀእ ይዳ ግሾ፥ ታ ዎዛናይ ሞአበስነ ቅር-ሄሬሳ አሳስ ሱሱልኤዳ ዬካስ። <verse eid="JER 48:36"/><verse number="37" style="v" sid="JER 48:37"/>ኤንቲ ባንታ ሁጵያነ ባንታ ቡቻ ሜድዶሶና፤ ባንታ ኩሽያ ቃንፅድ ማዱንፅስዶሶና፤ ባንታ ፄሳን ካዮ ማኦ ዳንጭዶሶና። <verse eid="JER 48:37"/><verse number="38" style="v" sid="JER 48:38"/>ታኒ ሞአበ ኦንካ ኮዮና ኦቶዳ መንዳ ግሾ፥ ሞአበታ ኬ ቦላንነ ዳባባን ዬሆፐ አትሽን፥ ሀራባይ ባዋ” ያጌስ ጎዳይ።<verse eid="JER 48:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JER 48:39"/>ሞአበይ አይብ መቆ መቅደ! እያ አሳይ አይብ ዋሶ ዋስ! ሞአበ ዋን ዬላትድ፥ ባ ዞኩዋ ዛርዴ? ሄሳ ግሾ፥ ሞአበይ ባ ዩሹዋን ደእያ ኡባስ ሚቻስነ ዳጋማስ አትስ።<verse eid="JER 48:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JER 48:40"/>አርጋን ባ ቀፍያ ምጭድ የይሳዳ ሞርከይ ሞአበ ቦላ ያና። <verse eid="JER 48:40"/><verse number="41" style="v" sid="JER 48:41"/>እያ ካታማት ኦይከታና፤ እያ ሚፃት ኤከታና። ሄ ጋላስ ሞአበ ምኖ ኦላንቾታ ዎዛናይ እቀ ኦይክዳ ማጫሳ ዎዛና መላ ኡንኤታና። <verse eid="JER 48:41"/><verse number="42" style="v" sid="JER 48:42"/>ሞአበ ታ ቦላ ማካልዳ ግሾ ያና፤ ህዛፐ ጉየ ካዎተ ግድድ ዴና። <verse eid="JER 48:42"/><verse number="43" style="v" sid="JER 48:43"/>ሞአበ አሳዉ፥ ያሽ፥ ኦልነ ፅሄይ ህንተና ናጌስ። <verse eid="JER 48:43"/><verse number="44" style="v" sid="JER 48:44"/>ዳጋንያባፐ ባቃትያ ኦንካ ኦላን ኩንዳና፤ ኦላፈ ከይያ ኦንካ ፅሄን ኦይከታና። ታኒ ሞአበ ሴርያ ዎደ ሄሳ ኦና።<verse eid="JER 48:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JER 48:45"/>“ባቃትድ ብዳይሳት ዎልቃ ይድ፥ ሀሰቦና ካታማ ኩያን ኤቅዶሶና። ሀሰቦና ካታማፐ ታም፥ ካዎይ ስሆነይ ደእዳ ኬፈ ላጮይ ከይድ፥ ሞአበ ቢታነ ያን ደእያ ማካላንቾ አሳ ምስ። <verse eid="JER 48:45"/><verse number="46" style="v" sid="JER 48:46"/>ሞአበ አሳዉ፥ ህንተና አየ! ካሞሻ ጌተትያ ኤቃ ፆሳ ጎይነይሳት ይዶሶና፤ ኤንታ አደ ናይትነ ማጫ ናይት ድኤትድ ብዶሶና። <verse eid="JER 48:46"/><verse number="47" style="v" sid="JER 48:47"/>ግዶሽን፥ ዉርሰን ታኒ ሞአበ ዛራዳ ኦራና” ያጌስ ጎዳይ።</para>
  <para style="p" vid="JER 48:47">ሞአበ ቦላ ኦደትዳ ፕርዳይ ሀይሳን ዉርስ።<verse eid="JER 48:47"/></para>
  <chapter eid="JER 48"/>
  <chapter number="49" style="c" sid="JER 49"/>
  <para style="s1">አሞነስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 49:1"/>አሞነባ ጎዳይ ሀይሳዳ ያጌስ፤ “እስራኤለስ አደ ናእ ባዌ? እያ ላተይ ባዌ? ያትን፥ ሞሎካ ጌተትያ ኤቃ ፆሳ ጎይንያ አሳት ጋደ ቢታ አይስ ኦይክዶና? ኤንታ ካታማን አይስ ኡትዶና? <verse eid="JER 49:1"/><verse number="2" style="v" sid="JER 49:2"/>አሞነ ቢታን ራባ ካታማ ቦላ ኦላ ዋሶይ ስኤታና መላ ታ ኦና ዎደይ ያና። ሄ ካታማይ ላለትድ ባይሳ ግዳና። እያ ዩሹዋን ደእያ ጉታት ታማን ፁገታና። እስራኤለይ ባና ባ ቢታፈ ጎድዳይሳታ ጎዳና” ያጌስ ጎዳይ።<verse eid="JER 49:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 49:3"/>“ሀሰቦና አሳዉ፥ ጋየ ካታማይ ላለትዳ ግሾ ዘሌልተ። ራባ አሳዉ፥ ዬክተ፤ ካዮ ማኦ ማእድ ካዮትተ፤ ካታማ ግምብያ ግዶን ዎፀረትተ። ህንተ ፆሳይ ሞሎክ ባ ካህነታራነ ባ ሀላቃታራ ድኤትስ። <verse eid="JER 49:3"/><verse number="4" style="v" sid="JER 49:4"/>አማኖይ ባይና አሳዉ፥ ‘ኑና ኦላናይ ኦኔ?’ ያግድ ህንተ ዱረተንነ ህንተ አራዳ ዛንጋራታን አይስ ጬቀተቲ? <verse eid="JER 49:4"/><verse number="5" style="v" sid="JER 49:5"/>ታ ነ ዩሹዋን ደኤይሳት ነና ዳጋንና መላ ኦና” ያጌስ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ። ህንተ ኡባይ ከይድ ባቃታና ግሾ ባቃትድ ብዳይሳታ ሺሽያ አስ ያና።<verse eid="JER 49:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 49:6"/>“ግዶሽን፥ ዉርሰን ታ አሞነ አሳ ዛራዳ ኦራና” ያጌስ ጎዳይ።<verse eid="JER 49:6"/></para>
  <para style="s1">ኤዶመስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 49:7"/>ኤዶመባ ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፤ “ተማና አሳስ ደእያ ጭንጫተይ አዉ ብዴ? ዞረይሳታፐ ዞረይ ይዴ? ኤንታ ጭንጫተይ ኤንታፈ ኤከትዴ? <verse eid="JER 49:7"/><verse number="8" style="v" sid="JER 49:8"/>ታኒ ኤሳዌ ኮቻ ሴርያ ዎደ እያ ቦላ ዮ ኤሀና ግሾ፥ ዳዳነን ደኤይሳቶ፥ ባቃትድ አፎን ቆሰትተ። <verse eid="JER 49:8"/><verse number="9" style="v" sid="JER 49:9"/>ዎይነ ማፀይሳት ፖሽለ አሾኮና? ካይሶት ቃማ ገልኮ፥ ባንታዉ ኮያባ ፃላላ ኤኮኮና? <verse eid="JER 49:9"/><verse number="10" style="v" sid="JER 49:10"/>ሽን ታ ኤሳዋ ኮቻ ቃራዳ ካሎ አሻና፤ ኤንቲ ቆሰታናዉ ዳንዳኦና መላ፥ ኤንቲ ቆሰትያ በሳ ቃራዳ ቆንጨ በሲ ኦና። ኤሳዌ ሼሻይ፥ እያ ዳቦትነ እያ ሾሮት ኡባይ ያና፤ ኤንታፈ እሶይካ አተና። <verse eid="JER 49:10"/><verse number="11" style="v" sid="JER 49:11"/>ህንተ ግዶን ደእያ ይኦ ናይታ አጋግተ፤ ኤንታ ታ ድቻና። ህንተ አምኤትካ ታናን አማነቶ” ያጌስ።<verse eid="JER 49:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 49:12"/>ጎዳይ ሀይሳዳ ያጌስ፤ “ህዛ ሴራ ኤካናዉ በሶና አሳስ ሴረተ አቶናባ ግድኮ፥ ህንተ ዋንድ ሴረቶና አታኔ? ቱማ ህንተካ ሴራ ፁአፐ ኡዬታፐ አትሽን፥ ጮ አተከታ። <verse eid="JER 49:12"/><verse number="13" style="v" sid="JER 49:13"/>ባሶራ ካታማይ ባይሳ ግድድ አታና፤ እያ በእዳ አሳ ኡባስ ዳጋማስ፥ ቀልቅሰስነ ባደስ አታና። እያ ዩሹዋን ደእያ ጉታ ኡባይ መርናዉ ላለትድ አታና። ሀይሳ ታኒ ታ ሱንን ጫቃይስ” ያጌስ ጎዳይ።<verse eid="JER 49:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 49:14"/>ታኒ ጎዳፐ ይዳ እስ ኪታ ስአስ። ካዎተታ ግዶ ኪተትዳይስ፥ “ኤዶመ ተቃናዉ ሺቅተ፤ እያራ ኦለታናዉ ደንድተ” ያግስ።<verse eid="JER 49:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 49:15"/>“ህዛ፥ ታ ነና ካዎተታ ግዶን ጉና፤ አሳ ግዶን ካትዳ አስ ኦና። <verse eid="JER 49:15"/><verse number="16" style="v" sid="JER 49:16"/>ሹቻ ቆጶንነ ደረ ቦላ ደኤይሶ፥ ነ ዳጋንይነ ነ ኦቶሮይ ነና ጭምስ። ነ ኬ አርጋንዳ ቃን ኬፅኮካ፥ ታ ነና ያፐ ዱገ ዎሳና” ያጌስ ጎዳይ።<verse eid="JER 49:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 49:17"/>“ኤዶመይ አሰ ዳጋንያ ቢታ ግዳና። ያራ አያ አሳ ኡባይ እያ ዩዋ በእድ፥ ዳጋማና፤ ማላለታና። <verse eid="JER 49:17"/><verse number="18" style="v" sid="JER 49:18"/>ሶዶመይነ ጋሞር ባንታ ዩሹዋን ደእያ ካታማታራ ይያ ዎደ ሀንዳይሳዳ ኦንካ ያን ዴና፤ አስ ያን ኡተና” ያጌስ ጎዳይ።<verse eid="JER 49:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 49:19"/>“ዮርዳኖሰ ሻፋ ላንቀን ደእያ ዎራፐ ዶርሳት ሄመትያ ሎኦ ቆሮይ ደእያ በሳ፥ ቆፖና ከይያ ጋሞዳ፥ ታ ኤዶመ አሳታ ቆፖና ኤንታ ቢታፈ የደና። ታ ዶርዳ አስ እያ ቦላ ሹማና። ታ መል ኦኔ? ታ ኦና ግዳባ ተቃናዉ ዳንዳኤይ ኦኔ? ታራ ኤቀታናዉ ዳንዳእያ ሄንንቾይ ኦኔ?<verse eid="JER 49:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 49:20"/>“ታ ኤዶመ ቦላነ ተማና ካታማ ቦላ ኦናዉ ሀልችዳባነ ቆፕዳባ ስእተ። ኤንታ ናይታ ዎልቃን ጎችድ ኤፋና፤ ሄሳ ጋሶን ኤንታ ሶ አሳይ ዳጋማና። <verse eid="JER 49:20"/><verse number="21" style="v" sid="JER 49:21"/>ኤዶመ ኩንደ ግርሳይ ቢታ ቃና፤ ኤዶመታ ዋሶይ ዞኦ አባ ጋካናዉ ስኤታና። <verse eid="JER 49:21"/><verse number="22" style="v" sid="JER 49:22"/>አርጋን ባ ቀፍያ ምጭድ ዱገ ፓልድ የይሳዳ፥ ሞርከይ ባሶራ ቦላ ያና። ሄ ዎደ ኤዶመ ኦላንቾት እቀ ኦይክዳ ማጫሳዳ ህርጋና” ያጌስ።<verse eid="JER 49:22"/></para>
  <para style="s1">ዳማስቆስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="23" style="v" sid="JER 49:23"/>ዳማስቆባ ጎዳይ ሀይሳዳ ያጌስ፤ “ኢታ ኦዳ ስእዳ ግሾ፥ ሀማታነ አርፋዳ ካታማታን ደእያ አሳይ ዬላትስ፤ ያይስ። ዙለይ ሾጭዳ አባዳ ኤንታ ዎዛናይ ሸምፖ ደማናዉ ዳንዳእቤና። <verse eid="JER 49:23"/><verse number="24" style="v" sid="JER 49:24"/>ዳማስቆይ ዳቡርስ፤ ኤንቲ ዳጋማን ኮኮርድ ባቃትዶሶና፤ ማጫስ እቀ ኦይከይሳዳ መቶይነ ኡንእ ኤንታ ኦይክስ። <verse eid="JER 49:24"/><verse number="25" style="v" sid="JER 49:25"/>ኡፋይስ ኩምዳ ኤረትዳ ካታማይ ዋንድ ባይሳ ግድዴ? <verse eid="JER 49:25"/><verse number="26" style="v" sid="JER 49:26"/>ሄ ዎደ ሄ ካታማን ደእያ ያላጋ አደት ካታማ ግዶ ኦገታን ሀይቃና፤ ኦላንቾት ኡባይ ዉራና። <verse eid="JER 49:26"/><verse number="27" style="v" sid="JER 49:27"/>ታኒ ዳማስቆ ካታማ ድርሳ ግምብያን ታማ የዳና፤ ሄ ታማይ ዎልደ-አዳራ ሚፃ ማና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 49:27"/></para>
  <para style="s1">ቀዳረስነ ሀፆራስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="28" style="v" sid="JER 49:28"/>ባብሎነ ካዎይ ናቡካዳናፆር ኦልድ ፆንዳ ቀዳረነ ሀፆራ ካዎተታባ ጎዳይ ሀይሳዳ ያጌስ፤ “ደንድድ፥ ቀዳረ አሳ ኦልተ፤ ዶሎሀ ባጋራ ደእያ አሳ ዉርስተ። <verse eid="JER 49:28"/><verse number="29" style="v" sid="JER 49:29"/>ኤንታ ዱንካነታነ ኤንታ ዉደታ ኤክተ። ኤንታ ገሸታ፥ ኤንታ ሻሉዋነ ኤንታ ግማለታ ኤክተ። ያትድ ኤንታዉ፥ ‘ህንተ ዩሹዋን ዳጋም ደኤስ’ ያግድ ኦድተ። <verse eid="JER 49:29"/><verse number="30" style="v" sid="JER 49:30"/>ሀፆራን ደኤይሳቶ፥ ባብሎነ ካዎይ ናቡካዳናፆር ህንተ ቦላ ኢታባ ኦናዉ ማቀትድ ኡትዳ ግሾ፥ ባቃትተ፤ አፎን ቆሰትተ” ያጌስ ጎዳይ።<verse eid="JER 49:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 49:31"/>“ደንዳዳ፤ ህርግ ባይና ሳሮ ደእያ ካዎተታ ኦላ። ኤንታ ካታማ ግምብያስ እብ ዎይኮ ኮበይ ባዋ፤ ኤንቲ ባንታርካ ደኦሶና።<verse eid="JER 49:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 49:32"/>“ኤንታ ግማለት ቦንቀታና፤ ኤንታ ዉደይ ድኤታና። ባንታ ሁጵያ ጋፃ ሜደይሳታ ጫርኮን ላላና፤ ታ ኡባ በሳራ ኤንታ ቦላ ዮ ኤሀና። <verse eid="JER 49:32"/><verse number="33" style="v" sid="JER 49:33"/>ሀፆር መርናዉ ዎርካናት ደእያ መላ ቢታ ግዳና። ኦንካ ያን ዴና፤ አስ ያን ኡተና” ያጌስ ጎዳይ።<verse eid="JER 49:33"/></para>
  <para style="s1">ኤላማስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="34" style="v" sid="JER 49:34"/>ይሁዳ ካዎይ ሰደቅያስ ኮይሮ ካዎትዳ ዎደ፥ ኤላማባ ጎዳፐ ኤርምያሳኮ ይዳ ቃላይ ሀይሳ፤ <verse eid="JER 49:34"/><verse number="35" style="v" sid="JER 49:35"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፤ “ኤላማስ ዎልቃ ግድዳ ዶንገ ዱክያ አሳታ ታ ዎና። <verse eid="JER 49:35"/><verse number="36" style="v" sid="JER 49:36"/>ኡባ በሳራ ታ ኤላማ ቦላ ጫርኮ ኤሀና፤ ኤንታ ሄ ጫርኩዋን ላላና። ሄሳ ግሾ፥ ኤላማ አሳይ ላለትድ ጋኮና ቢት ዴና። <verse eid="JER 49:36"/><verse number="37" style="v" sid="JER 49:37"/>ኤንታ ሞርከታ ስንንነ ኤንታ ዎናዉ ኮየይሳታ ስንን ታ ኤላማ ዳጋንና። ታ ግታ ሀንቁዋን ኤንታ ቦላ ዮ ኤሀና። ታ ኤንታ ይሳና ጋካናዉ ማሻን የደና። <verse eid="JER 49:37"/><verse number="38" style="v" sid="JER 49:38"/>ታኒ ኤላማ ካዋነ ኤንታ ሀላቃታ ይሳዳ ታ አራታ ያን ዎና። <verse eid="JER 49:38"/><verse number="39" style="v" sid="JER 49:39"/>ግዶሽን፥ ዉርሰ ዎደ ታኒ ኤላማ ዛራዳ ኦራና” ያጌስ ጎዳይ።<verse eid="JER 49:39"/></para>
  <chapter eid="JER 49"/>
  <chapter number="50" style="c" sid="JER 50"/>
  <para style="s1">ባብሎነስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 50:1"/>ባብሎነነ ባብሎነ አሳባ ናብያ ኤርምያሳ ባጋራ ጎዳይ ኦድዳ ቃላይ ሀይሳ፦ <verse eid="JER 50:1"/><verse number="2" style="v" sid="JER 50:2"/>“ካዎተታ ግዶን ኦድተነ አዋጅተ። ባንድራ ቁ ኦ ኦይክድ፥ አይኮካ ቆሶና፥ ሀይሳዳ ያግድ ኦድተ። ‘ባብሎነይ ኩንድስ! ቤል ጌተትያ ኤቃይ ዬላትስ፤ ማርዱካ ጌተትያ ኤቃይ ካዉይስ። እያ ምስለት ዬላትዶሶና፤ እያ ኤቃት ካዉይዶሶና። <verse eid="JER 50:2"/><verse number="3" style="v" sid="JER 50:3"/>ፑደሀ ባጋፈ እስ ካዎተ ይድ፥ ባብሎነ ቢታ ይሳና። አሳይነ መሄይ ባቃታና፤ ኦንካ ያን ዴና’ ” ያግስ።<verse eid="JER 50:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 50:4"/>“ሄ ዎደነ ሄ ጋላስ እስራኤለይነ ይሁድ እስፈ ዬክሸ ይድ ጎዳ ባንታ ፆሳ ኮያና። <verse eid="JER 50:4"/><verse number="5" style="v" sid="JER 50:5"/>ኤንቲ ፅዮነ ኤፍያ ኦግያ ኦይቻና፤ ባንታ ሶምኡዋ ያ ዛራና። ኤንቲ፥ ፖሎ ዶገቶና መርና ጫቁዋን ጎዳራ” ኦይከታና።<verse eid="JER 50:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 50:6"/>“ታ አሳይ ይዳ ዶርሳ መላ፤ ኤንታ ሄንንቾት ኤንታ ባለድ፥ ዙማ ቦላ ጉየ የድዶሶና። እስ ዙማፐ ሀራ ዙማ ቦላ ቶይላትድ ባንታ ግርብያ ዶግዶሶና። <verse eid="JER 50:6"/><verse number="7" style="v" sid="JER 50:7"/>ደምዳ ኡባይ ኤንታ ሻንካትስ። ኤንታ ሞርከት፥ ‘ኑ አይኮካ ባልቦኮ፤ ሀ መቶይ ኤንታ ጋክዳይ፥ ኤንቲ ጎዳ፥ ባንታ ሸምፖ በሳ፥ ባንታ ማይዛታ ኡፋይሳ ቦላ ናጋራ ኦዳ ግሾሳ።’<verse eid="JER 50:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 50:8"/>“እስራኤለ አሳዉ፥ ባብሎነፐ ባቃትተ፤ ባብሎነ ቢታፈ ከይተ፤ ዉደ ካለያ ኮለ ዴሻ መላ ግድተ። <verse eid="JER 50:8"/><verse number="9" style="v" sid="JER 50:9"/>ታኒ ፑደሀ ባጋፈ ግታ ካዎተታ ጩጋ ደንዳ፥ ባብሎነ ቦላ ኤሀና ሀናይስ። ኤንቲ እያ ኦልድ ኦይካና፤ ኤንታ ዶንገይ ዱክድ፥ ባሎና ኦላንቾ መላ። <verse eid="JER 50:9"/><verse number="10" style="v" sid="JER 50:10"/>ባብሎነይ ቦንቀታና፤ እያ ቦንቅያ ኡባይ ካላና” ያጌስ ጎዳይ።<verse eid="JER 50:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 50:11"/>ባብሎነ አሳዉ፥ ታ አሳ ቦንቀይሳቶ፥ ህንተ ኡፋይትድ ሀሹ ግደታ። ቆሮን ካልዳ ኡሳዳ ፔኑቅደታ፤ ኮርማ ፓራዳ ጫግደታ። <verse eid="JER 50:11"/><verse number="12" style="v" sid="JER 50:12"/>ሽን ሀእ ህንተ ግታ ካታማይ ዬላታናነ ካዉያና። ካዎተታ ግዶን ባብሎነይ ኡባፈ ላፋ ግዳና፤ ሃ ባይና መላ ቢታ ግዳና። <verse eid="JER 50:12"/><verse number="13" style="v" sid="JER 50:13"/>ጎዳ ሀንቁዋ ጋሶን፥ ባብሎነይ ያና፤ ላለታና። እያ ማታራ አያ ኡባይ እያ ቦላ ጋክዳ ቦሻ በእድ፥ ዳጋማናነ ማላለታና።<verse eid="JER 50:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 50:14"/>“ዶንገ ዱከይሳቶ፥ ባብሎነ ኦላናዉ እያ ዩሹዋን ሳልፕተ፤ እ ጎዳ ቦላ ናጋራ ኦዳ ግሾ ህንተ ዶንግያን እያ ዱክተ። <verse eid="JER 50:14"/><verse number="15" style="v" sid="JER 50:15"/>ኡባ ባጋራ ባብሎነ ቦላ ኦላ ዋሶ ዋስተ፤ ባብሎነይ ኩሸ እሚስ፤ እያ ግምበት ኩንድዶሶና፤ እያ ግምበ ድርሳይ ላለትስ። ጎዳይ እያ ቦላ ሀሎ ከይሸ ደእያ ግሾ፥ ህንተ እያ ቦላ ሀሎ ከይተ። እ ሀራታ ቦላ ኦዳባ ህንተካ እያ ቦላ ኦተ። <verse eid="JER 50:15"/><verse number="16" style="v" sid="JER 50:16"/>ዘረ ዘረይሳነ ጫካ ዎደ ባጫራ ከየይሳ ባብሎነፐ ይስተ። ይሰይሳታ ማሻ ያይዳ ግሾ፥ ሄ ቢታን ደእያ አሳ ኡባይ ባ ያራኮ ያራኮ ስሚድ ባ ቢታ ቢታ ባቃታና።<verse eid="JER 50:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 50:17"/>“እስራኤለይ ጋሞይ የደድ ላልዳ ዶርሳ መላ። ኮይሮ አሶረ ካዎይ እያ አሹዋ ምስ፤ ዉርሰን ባብሎነ ካዎይ ናቡካዳናፆር እያ መቀ ግስ።”<verse eid="JER 50:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 50:18"/>ሄሳ ግሾ፥ ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ “አሶረ ካዋ ታ ሴርዳይሳዳ ባብሎነ ካዋነ እያ ቢታ ሴራና። <verse eid="JER 50:18"/><verse number="19" style="v" sid="JER 50:19"/>ሽን እስራኤለ፥ እያ ሄን በሳ ዛራና፤ ቃርመሎሳነ ባሳነ ደረታን እ ሄመታና። እ ኤፍሬማነ ጋላዳ ገዘ ቢታን ካልድ ማና። <verse eid="JER 50:19"/><verse number="20" style="v" sid="JER 50:20"/>ሄ ዎደ፥ ሀይቆፐ ታ አሽዳ እስራኤለ አሳ ናጋራ ታ አቶ ጋና ግሾ፥ አሳይ እስራኤለን ናጋራ ኮያና፥ ሽን ደሞኮና። ይሁዳን ናጋራ ኮያና፥ ሽን በንተና” ያጌስ ጎዳይ።<verse eid="JER 50:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 50:21"/>“ምራታይማ ቢታንነ ፕቆዳን ደእያ አሳ ቦላ ደንድድ ኤንታ ኦልተ፤ ዎተ፤ ኤንታ ፖሎ ይስተ። ታ ህንተና ኪትያ ኡባ ኦተ” ያጌስ ጎዳይ። <verse eid="JER 50:21"/><verse number="22" style="v" sid="JER 50:22"/>ቢታ ቦላ ኦላ ዋሶይ ስኤቴስ፤ ግታ ዮይ ጋክስ። <verse eid="JER 50:22"/><verse number="23" style="v" sid="JER 50:23"/>ቢታ ኡባ ሊቅስያ ናርቃይ ዋንድ መቅደ! ዋንድ ሊቅደ! ካዎተታ ኡባ ግዶን ባብሎነይ ዋንድ ዳጋንያባ ግድደ! <verse eid="JER 50:23"/><verse number="24" style="v" sid="JER 50:24"/>ነኖ፥ ባብሎነ፥ ታ ነና ኦይካናዉ ፅሄ ዎስ፤ ኔኒ ኤሮናሽን ገላዳ ኦይከታዳሳ። ኔኒ ጎዳራ ኤቀትዳ ግሾ ኦይከታዳሳ። <verse eid="JER 50:24"/><verse number="25" style="v" sid="JER 50:25"/>ታኒ ታ ኦላ ሚሽያ ዎያ ኬ ዶያዳ፥ ታ ይሉዋን ኦላ ሚሽያ ያፐ ከሳስ። ሄሳ ኦዳይ፥ ጎዳይ፥ ኡባፈ ዎልቃማ ጎዳይ ባብሎነ ቢታን ኦያ ኦሶይ ደእያ ግሾሳ። <verse eid="JER 50:25"/><verse number="26" style="v" sid="JER 50:26"/>ያራ ሃራ እያ ቦላ ደንድተ፤ ካይ ደእያ እያ ሻልያ ዶይተ፤ ድኡዋ ካዳ ዶርተ፤ አይብባካ አሾና ዉርስድ ይስተ። <verse eid="JER 50:26"/><verse number="27" style="v" sid="JER 50:27"/>ቦሩ ሹከይሳዳ ኤንታ ኦላንቾታ ዎተ። ባብሎነ አሳይ ሴረትያ ዎደይ ጋክዳ ግሾ ኤንታ አየ!<verse eid="JER 50:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 50:28"/>“ድኤትዳ አሳይ ባብሎነፐ ከስ ኤክድ፥ የሩሳላመ ባቃታና። ባብሎነ አሳይ ፆሳ ኬ ቦላ ኦዳባስ ጎዳይ፥ ኤንታ ፆሳይ ሀሎ ከያናይሳ ኤንቲ ፅዮነን ኦዳና። <verse eid="JER 50:28"/><verse number="29" style="v" sid="JER 50:29"/>ባብሎነ ኦላናዉ ዶንገ ዱክያ ኡባ ፄግተ፤ እሶይካ ከስ ኤኮናዳ እያ ዩሹዋ ተቆ። ጎዳ ቦላ፥ እስራኤለ ጌሻ ቦላ፥ እ ኦቶርትዳ ግሾ፥ እያ ኦሱዋዳ እያዉ ዛርተ። እ ሀራታ ቦላ ኦዳይሳዳ እያ ቦላ ኦተ። <verse eid="JER 50:29"/><verse number="30" style="v" sid="JER 50:30"/>ሄሳ ግሾ፥ እያ ያላጋ አደት ካታማ ግዶ ኦግያን ሀይቃና፤ ሄ ጋላስ እያ ኦላንቾት ኡባይ ያና” ያጌስ ጎዳይ።<verse eid="JER 50:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 50:31"/>ጎዳይ፥ ኡባፈ ዎልቃማ ጎዳይ፥ “ኔኒ ሴረትያ ዎደይ ጋክዳ ግሾ፥ ነኖ፥ ኦቶራንቹዋዉ፥ ታ ነ ቦላ ደንዳስ። <verse eid="JER 50:31"/><verse number="32" style="v" sid="JER 50:32"/>ኦቶራንቾይ በትድ ኩንዳና፤ እያ ደንያ አስ ዴና። ታ እያ ካታማታ ታማን ኦይና፤ ሄ ታማይ ዩሹዋን ደእያ ኡባ ይሳና” ያጌስ።<verse eid="JER 50:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 50:33"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፦ “እስራኤለ አሳይነ ይሁዳ አሳይ ኡንኤትዶሶና። ኤንታ ድእድ ኤፍዳይሳት ኤንታ ምንድ ኦይክዶሶና፤ ኤንታ የደናዉ ኮይቦኮና። <verse eid="JER 50:33"/><verse number="34" style="v" sid="JER 50:34"/>ሽን ኤንታ ዎዘይስ ምኖ፤ እያ ሱንይ ኡባፈ ዎልቃማ ጎዳ። እ፥ ኤንታ ቢታስ ሸምፖ እማናዉ ኤንታ ግሾ ሞተቴስ። ሽን ባብሎነ ቢታን ደኤይሳታ ቦላ ዳጋማ የዳና። <verse eid="JER 50:34"/><verse number="35" style="v" sid="JER 50:35"/>ባብሎነይ፥ ባብሎነን ደኤይሳት፥ እያ ሀላቃትነ እያ ጭንጫት ማሻን ሀይቃና” ያጌስ ጎዳይ።<verse eid="JER 50:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 50:36"/>“እያ ኤያ ዎርዶ ናበት ማሻን ሀይቆና። ዳጋምያ እያ ዎልቃማ ኦላንቾት ማሻን ሀይቃና። <verse eid="JER 50:36"/><verse number="37" style="v" sid="JER 50:37"/>እያ ፓራታ ቦላ፥ እያ ፓራ ጋረታ ቦላነ ማጫሳ መላ ግድዳ እያ አላጋ ኦላንቾታ ቦላ ማሽ ዮ። እያ ሻሉዋ ምንጅያ ኬ ቦላ ማሽ ዮ፤ እያ ቡቁራ ኡባይ ቦንቀታና። <verse eid="JER 50:37"/><verse number="38" style="v" sid="JER 50:38"/>ባብሎነን ኤቅ ኩምዳ ግሾነ ዳጋማን ኮኮርያ ኤቃት ደእያ ግሾ፥ እያ ሃይ መሎ፤ እያ ቦላ ኮሽ ዮ።<verse eid="JER 50:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JER 50:39"/>“ሄሳ ግሾ፥ ባብሎነይ ባዞ ዶአትነ ዎርካናት ደእያ በሲ ግዳና፤ ቃስ ያንቾት ያን ዳና። ያን መርናዉ አስ ዴና፤ የለታፐ የለታ ጋካናዉ አስ ደእያ በሲ ግደና። <verse eid="JER 50:39"/><verse number="40" style="v" sid="JER 50:40"/>ፆሳይ በን ሶዶመነ ጋሞራ ኤንታ ዩሹዋን ደእያ ካታማታራ ይስዳይሳዳ ባብሎነን ኦንካ ዴና፤ አስ ያን ኡተና” ያጌስ ጎዳይ።<verse eid="JER 50:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JER 50:41"/>“ሄኮ፥ አሳይ ፑደሀ ባጋፈ ያና፤ ምኖ ካዎተትነ ዳሮ ካዎት ሳኣ ጋፃፐ ያናዉ ደንድዶሶና። <verse eid="JER 50:41"/><verse number="42" style="v" sid="JER 50:42"/>ኤንቲ ባንታ ዶንግያነ ቶራ ኦይክዶሶና፤ ኤንቲ ዎዛና ምኖነ የድ ማሮና አስ። ኤንቲ ባንታ ፓራ ቶግድ ብያ ዎደ፥ ቤታይ ሾጭያ አባ ጉንዳ ሀኔስ። ነኖ፥ ባብሎነ፥ ኤንቲ ኡባይ ኦላስ ጊግዳ አስ ግድድ ነ ቦላ ሳልፕዶሶና።<verse eid="JER 50:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JER 50:43"/>“ባብሎነ ካዎይ ሄሳ ስእያ ዎደ እያ ኩሸይ ዳቡርድ ስልስ፤ እቀ ኦይክዳ ማጫሳዳ ኡንኤትስ።<verse eid="JER 50:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JER 50:44"/>“ዮርዳኖሰ ሻፋ ላንቀን ደእያ ዎራፐ፥ ሎኦ ቆሮይ ደእያ በሳፈ ቆፖና ከይያ ጋሞዳ፥ ታ ያዳ፥ ባብሎነ አሳ ኤንታ ቢታፈ የደና። ሄሳፈ ጉየ፥ ታ ዶርዳ አስ እያ ቦላ ሹማና፤ ያትን ታ መል ኦኔ? ታ ኦና ግዳባ ተቃናይ ኦኔ? አይ ሄንንቾይ ታራ ኤቀታናዉ ዳንዳኢ? <verse eid="JER 50:44"/><verse number="45" style="v" sid="JER 50:45"/>ሄሳ ግሾ፥ ጎዳይ ባብሎነ ቦላነ ባብሎነ ቢታ ቦላ ሀልችዳባነ ቆፕዳባ ስእተ። ኤንታ ናይታ ዎልቃን ጎችድ ኤፋና፤ ሄሳ ጋሶን ኤንታ ሶ አሳ ኡባይ ዳጋማና። <verse eid="JER 50:45"/><verse number="46" style="v" sid="JER 50:46"/>ባብሎነ ኩንደ ግርሳይ ቢታ ቃና፤ ባብሎነ ዋሶይ ካዎተታ ኡባን ስኤታና” ያጌስ።<verse eid="JER 50:46"/></para>
  <chapter eid="JER 50"/>
  <chapter number="51" style="c" sid="JER 51"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 51:1"/>ባብሎነ አሳነ ባብሎነ ቢታ ይስያ ጫርኮ ኪታና። <verse eid="JER 51:1"/><verse number="2" style="v" sid="JER 51:2"/>ታኒ ባብሎነ ቦላ ጫርኮዳ ፑንያ አላጋታ ኪታና። እያ ዩዋ ጋላስ ኤንቲ ኡባ በሳራ እያ ኡንኤና። <verse eid="JER 51:2"/><verse number="3" style="v" sid="JER 51:3"/>እያ ኦላንቾት ዶንግያ ዱካና ጋካናዉ ዎይኮ ባንታ ኦላ ሚሽያ ዳንጫና ጋካናዉ ናጎፕተ። እያ ያላጋ አደታስ ምሸቶፕተ፤ እያ ኦላንቾታ ፖሎ ይስተ። <verse eid="JER 51:3"/><verse number="4" style="v" sid="JER 51:4"/>ኤንቲ ባብሎነ ቢታን ሹከታና፤ እ ዳባባን ጫደትድ ኩንዳና። <verse eid="JER 51:4"/><verse number="5" style="v" sid="JER 51:5"/>ኤንቲ ቢታ ናጋራን ኩንኮካ፥ ፆሳይ፥ ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ጌሻይ፥ እስራኤለነ ይሁዳ አምእዳ የግድ አግቤና። <verse eid="JER 51:5"/><verse number="6" style="v" sid="JER 51:6"/>ባብሎነፐ ባቃትተ፤ እሶይ እሶይ ባ ሸምፑዋ አሾ። እ ኦዳ ናጋራ ጋሶን ህንተ ዉሮፕተ። ሀ ዎደይ ታኒ ጎዳይ ሀሎ ከይያ ዎደ። <verse eid="JER 51:6"/><verse number="7" style="v" sid="JER 51:7"/>ባብሎነይ ሳአን ደእያ አሳ ኡባይ ኡይድ ማትያ፥ ዎይነ ኡሽ ትገትያ፥ ታ ኩሸን ደእያ ዎርቃ ዋንጫ መላ። ካዎተት ኡባይ ሄ ዎይነ ኡሻ ኡይድ ጎይዶሶና። <verse eid="JER 51:7"/><verse number="8" style="v" sid="JER 51:8"/>ባብሎነይ ቆፖና ኩንድድ መቅስ። ሄሳ ግሾ፥ እያዉ ዬክተ፤ እ ፓፃነኮ ኦን ኤር እያ ማዱንስ ለ እምተ። <verse eid="JER 51:8"/><verse number="9" style="v" sid="JER 51:9"/>ባብሎነን ደእያ አላጋ አሳይ፥ “ኑ ባብሎነ ፓናዉ ኮይዳ፤ ሽን ፓፃናዉ ዳንዳእቤና። እያ ፕርዳይ ሃክድ ሳሎ ጋክዳ ግሾነ ሻራ ጋካናዉ ቁ ግዳ ግሾ እያ አግድ ኑ ቢታ ስሞስ” ያግዶሶና።<verse eid="JER 51:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 51:10"/>እስራኤለ አሳይ፥ “ጎዳይ ኑስ ፕርድዳ ግሾ፥ ፅዮነ ብድ፥ ጎዳይ ኑ ፆሳይ ኦዳባ ኦዳና” ያጋና።<verse eid="JER 51:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 51:11"/>“ጎዳይ ባብሎነ ይሳናዉ ቆፋ ቃችዳ ግሾ፥ ሜዶና ካዎታ ደንስ። እ ባ ኬ ግሾ ሀሎ ከያናዉ ቆፕስ። ሜዶና ሀላቃት፥ ‘ዶንገ ቶራ ሌፍተ፤ ጎንዳለ ኦይክተ። <verse eid="JER 51:11"/><verse number="12" style="v" sid="JER 51:12"/>ባብሎነ ቦላ ኦላ ባንድራ ደንተ፤ ምንድ ናግተ። ዎቸይሳታ ኤንታ በሳን በሳን ዎተ፤ ዙግድ ጫድያ ኦላንቾታ ጊግስተ’ ” ያግዶሶና። ጎዳይ ባብሎነ አሳ ቦላ ቆፕዳባነ ባ ግዳባ ኦና።<verse eid="JER 51:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 51:13"/>ባብሎነ፥ ኔኒ ዳሮ ሻፋትነ ዱረተ ኩምዳ ቢታ፥ ሽን ነ ዉርሰይ ጋክስ፤ ኔኒ በሶና ኦገን ሺሽያ ጎአይ አትስ። <verse eid="JER 51:13"/><verse number="14" style="v" sid="JER 51:14"/>ኡባፈ ዎልቃማ ጎዳይ፥ “ቦለይ ቢታ ኩመይሳዳ ታኒ አሳ ነ ቢታን ኩንና፤ ኤንቲ ነና ፆንዳ ኡፋይሳን ባንታ ቃላ ቁ ኦድ ነ ቦላ ጋይራና” ያግድ ባ ሱንን ጫቅስ።<verse eid="JER 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 51:15"/>ጎዳይ ባ ዎልቃን ሳኣ መስ፤</para>
  <para style="q2" vid="JER 51:15">ባ ጭንጫተን ቢታ ባስስ፤</para>
  <para style="q2" vid="JER 51:15">ሳሎታ ባ አኬካን ምጭስ።<verse eid="JER 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 51:16"/>እ ኪትያ ዎደ፥</para>
  <para style="q2" vid="JER 51:16">ሳሎን ደእያ ሃት ጉሞሶና።</para>
  <para style="q1" vid="JER 51:16">ሻራታ ሳኣ ጋፃፐ ኤሄስ፤</para>
  <para style="q2" vid="JER 51:16">እር ቡክያ ዎደ ዎልአን ዎልአሜስ፤</para>
  <para style="q2" vid="JER 51:16">ባ ምንጃ በሳፈ ጫርኩዋ ከሴስ።<verse eid="JER 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 51:17"/>አስ ኡባይ ኤያነ አኬክ ባይናይሳ፤</para>
  <para style="q2" vid="JER 51:17">ኤንታ ምስለት ዎርዶነ</para>
  <para style="q2" vid="JER 51:17">ሸምፖይ ባይናይሳታ ግድያ ግሾ፥</para>
  <para style="q2" vid="JER 51:17">ዎርቃ ሼሽድ ኤቃ መይሳት ዬላትዶሶና።<verse eid="JER 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 51:18"/>ሄ ምስለት ፓናይሳታነ ከትዳይሳታ፤</para>
  <para style="q2" vid="JER 51:18">ኤንታ ቦላ ፆሳይ ፕርድያ ዎደ ኤንቲ ያና።<verse eid="JER 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 51:19"/>ሽን ያይቆባ ፆሳይ ኤንታ መላ ግደና፤</para>
  <para style="q2" vid="JER 51:19">ኡባባ መዳይ እያ።</para>
  <para style="q1" vid="JER 51:19">እ ባዉ ዶርዳ ኮቻይ እስራኤለ አሳ፤</para>
  <para style="q2" vid="JER 51:19">እያ ሱንይ ኡባፈ ዎልቃማ ጎዳ።<verse eid="JER 51:19"/></para>
  <para style="s1">ጎዳ ናርቃ</para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 51:20"/>“ባብሎነ፥ ነ ታ ናርቃነ ታ ኦላ ሚሸ፤</para>
  <para style="q2" vid="JER 51:20">ነና ጎኤታዳ ታኒ ቢታታ መንረስ፤</para>
  <para style="q2" vid="JER 51:20">ካዎተታ ይሳስ።<verse eid="JER 51:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 51:21"/>ነና ጎኤታዳ ፓራታነ ፓራ ቶገይሳታ፤</para>
  <para style="q2" vid="JER 51:21">ፓራ ጋረታነ ኤንታ ላገይሳታ መንረስ።<verse eid="JER 51:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 51:22"/>ነና ጎኤታዳ ማጫነ አደ፥</para>
  <para style="q2" vid="JER 51:22">ጭማነ ናይታ ፓንነ ጌላኦ መንረስ።<verse eid="JER 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 51:23"/>ሄንንቹዋነ እያ ዉድያ፥</para>
  <para style="q2" vid="JER 51:23">ጎየይሳነ እያ ዋ ቦራታ፥</para>
  <para style="q2" vid="JER 51:23">ደርያ ሃረይሳታነ ሀላቃታ</para>
  <para style="q2" vid="JER 51:23">ነና ጎኤታዳ መንረስ” ያጌስ ጎዳይ።<verse eid="JER 51:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 51:24"/>“ባብሎነይነ ባብሎነ አሳይ ፅዮነ ቦላ ኦዳ ኢታ ኦሱዋ ግሾ ህንተ ፄልሽን ታ ሀሎ ከያና” ያጌስ ጎዳይ።<verse eid="JER 51:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 51:25"/>“ነኖ፥ ባብሎነ፥ ነ ቢታ ይስያ ዙማ መላ፤ ሽን ታ ጎዳይ ነና እፃስ። ታኒ ታ ኩሽያ የዳዳ፥ ነና ዙማ ቦላፈ ዱገ ጎንዶርሳና፤ ኔኒ ፁገትዳ ዙማ ግዳዳ አታና። <verse eid="JER 51:25"/><verse number="26" style="v" sid="JER 51:26"/>ኔፐ ባሶን የግያ ዎይኮ ግምቤስ ኤከትያ ሹች ዴና፤ ነ መርናዉ ባይሳ ግዳና” ያጌስ ጎዳይ።<verse eid="JER 51:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 51:27"/>“ባብሎነ ቦላ ኦላ ባንድራ ደንተ፤ አሳ ግዶን ሞይዘ ፑንተ። እያ ኦላናዉ አሳ ኡባ ጊግስተ፤ አራራተ፥ ምናነ አስካናዛ ካዎተታ ፄግተ። ኦላ ሀላቃታ ሹምተ፤ ቦለ መላ ዳሮ ፓራታ ኤህተ። <verse eid="JER 51:27"/><verse number="28" style="v" sid="JER 51:28"/>ባብሎነ ኦላናዉ ካዎተታ ኡባ ጊግስተ፤ ሜዶና ካዎታ፥ ኤንታ ሀላቃታ፥ ደርያ ሃረይሳታነ ኤንቲ ሃርያ ቢታ አሳ ኡባ ደንተ።<verse eid="JER 51:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 51:29"/>“ባብሎነይ ኦንካ ዶና ባይሳ ኦናዉ ጎዳይ ሀልችዳ ሀልቹዋ ፖልያ ግሾ፥ ቢታ ኡባይ ኮኮረስነ ፖርቃቴስ። <verse eid="JER 51:29"/><verse number="30" style="v" sid="JER 51:30"/>ባብሎነ ኦላንቾት ኦላ አግድ፥ ባንታ ሚፃን ኡትዶሶና። ኤንታ ዎልቃይ ላፍን፥ ማጫሳ መላ ግድዶሶና። ኤንታ ኬት ፁገትዶሶና፤ ካታማ ፐንግያ ኮበ ምት መቅዶሶና። <verse eid="JER 51:30"/><verse number="31" style="v" sid="JER 51:31"/>ሀ ጋፃፐ ህን ጋፃ ጋካናዉ፥ ካታማይ ሞርከን ኦይከትዳይሳ ባብሎነ ካዋስ ኦዳናዉ፥ ዎፀይስ ዎፀይሳ ካልድ፥ ኪተትዳይስ ኪተትዳይሳ ካልድ ቦሶና። <verse eid="JER 51:31"/><verse number="32" style="v" sid="JER 51:32"/>ሻፋራ ፕንያ በሳት ኦይከትዳይሳ፥ ሃ ጋፃን ደእያ ዎራይ ፁገትዳይሳነ ኦላንቾት ዳጋምዳይሳ ኤንቲ ካዋስ ኦዳናዉ ዎፆሶና” ያጌስ ጎዳይ።<verse eid="JER 51:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 51:33"/>“ባብሎነ ቢታይ ካ ቡክያ ዉዱማ ግዳና፤ ጉ ዎደፐ ጉየ እ ጫከትያ ዎደይ ያና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ።<verse eid="JER 51:33"/></para>
  <para style="s1">ጎዳይ እስራኤለ ማዳና</para>
  <para style="p">
    <verse number="34" style="v" sid="JER 51:34"/>ባብሎነ ካዎይ ናቡካዳናፆር ኑና ዉርስድ ምስ፤ ኑ ካታማ ካይሳ ኦቶ ከስስ። ዳወይ ምተይሳዳ እያ ምትስ፤ ማልኦባ ምድ ኩንይሳዳ እ ኑ ሻሉዋን ባ ጋንጅያ ኩንስ፤ አትዳይሳ ሙጭድ ጩትስ። <verse eid="JER 51:34"/><verse number="35" style="v" sid="JER 51:35"/>ፅዮነይ፥ “ባብሎነይ ኑ ቦላ ኦዳ ኢታባ ኡባይ እያ ቦላ ስሞ” ያጎሶና። የሩሳላመይ፥ “ኑ ሱ አጮይ ባብሎነ አሳ ኦይኮ” ያጎሶና።<verse eid="JER 51:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 51:36"/>ሄሳ ግሾ፥ ጎዳይ የሩሳላመ አሳ ሀይሳዳ ያጌስ፦ “ታ ነ ግሾ ሞተታና፤ ነ ሃሉዋ ታ ከያና። ታኒ ባብሎነ ሃነ ፑልቶታ መልሳና። <verse eid="JER 51:36"/><verse number="37" style="v" sid="JER 51:37"/>ባብሎነይ ላለ ዶረነ ዎርካናት ጉፕያ በሲ ግዳና። እያ በእያ ኡባይ ዳጋማናነ ቀልቅሳና፤ ያን እስ አስካ ዴና። <verse eid="JER 51:37"/><verse number="38" style="v" sid="JER 51:38"/>ባብሎነ አሳ ኡባይ ጋሞዳ ጉዶሶና፤ ጋሞ ማራዳ ዳሮሶና። <verse eid="JER 51:38"/><verse number="39" style="v" sid="JER 51:39"/>ኤንታ አሳተይ ሆእያ ዎደ፥ ታ ኤንታዉ ኡሻ ግብራ ጊግሳና። ኤንቲ ማታና ጋካናዉ ታ ኤንታ ኡሻና፤ ኤንቲ ዛሪድ ደንዶና መላ መርናዉ ስካና” ያጌስ ጎዳይ። <verse eid="JER 51:39"/><verse number="40" style="v" sid="JER 51:40"/>ሹካናዉ ኤፍያ ኡርገዳ፥ ማራዘዳነ ኮለዳ ታኒ ኤንታ ሹካ በሲ ኤፋና።<verse eid="JER 51:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JER 51:41"/>“አሳ ኡባይ ሳቢያ ባብሎነይ ዋንድ ኦይከትደ! ባብሎነይ ካዎተታ ግዶን ዋንድ ዳጋንያባ ግድደ! <verse eid="JER 51:41"/><verse number="42" style="v" sid="JER 51:42"/>ባብሎነ ሞርከት አባ ቤታይ ደንደይሳዳ ደንድድ ካታማን ኤልዶሶና። <verse eid="JER 51:42"/><verse number="43" style="v" sid="JER 51:43"/>እያ ካታማት ላለትድ፥ ዳጋንያባ ግድዶሶና፤ ሃ ባይና መላ ቢታ ዳንዶሶና፤ አስ ዶና በስነ ኦንካ ካንድ አና በሲ ግድዶሶና። <verse eid="JER 51:43"/><verse number="44" style="v" sid="JER 51:44"/>ቤላ ጌተትያ ባብሎነ ኤቃ ታ ሴራና፤ እ ምትዳባ እያ ኡሉዋፐ ከሳና። ህዛፐ ጉየ፥ ካዎተት እያኮ ጎገይሳ አጋና፤ ባብሎነ ግምበይ ኩንዳና።<verse eid="JER 51:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JER 51:45"/>“ታ አሳዉ፥ እያ ግዶፈ ከይተ! ህንተ፥ ጎዳ ሀንቆ ሱሉዋፐ ህንተና አሽተ! <verse eid="JER 51:45"/><verse number="46" style="v" sid="JER 51:46"/>ቢታን ኦደትያ ኦዳ ስእያ ዎደ ኡፋይስ ቃንፆፍተነ ያዮፍተ። ላይን ላይን ኦድ ካልድ ካልድ ያና። ሄ ዎደ ካዎይ ካዋ ቦላ ደንድያ ማካላ ኦድ ቢታን ስኤታና።”<verse eid="JER 51:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JER 51:47"/>“ሄሳ ግሾ፥ ታኒ ባብሎነ ኤቃ ምስለታ ሴርያ ጋላስ ያና። ቢታ ኡባይ ዬላታና፤ ሀይቅዳይሳት ኡባይ ካታማ ግዶን ኩንዳና። <verse eid="JER 51:47"/><verse number="48" style="v" sid="JER 51:48"/>ፑደሀ ባጋፈ ያና ይሰይሳታ ኩሸን ባብሎነይ ገልያ ዎደ ሳሎንነ ሳአን ደእያ ኡባባይ እልላና። <verse eid="JER 51:48"/><verse number="49" style="v" sid="JER 51:49"/>ባብሎነይ፥ እስራኤለ አሳነ ሳአን ደእያ አሳ ኡባ ዎዳይሳዳ ባብሎነ አሳይ ሀይቃናዉ ኮሼስ። <verse eid="JER 51:49"/><verse number="50" style="v" sid="JER 51:50"/>ታ አሳዉ፥ ኦላፐ ከስ ኤክዳይሳቶ፥ ቢተ፤ ሀይሳን ኤቆፍተ። ህንተ ደእያ ሃሆ ቢታን ታና ጎዳ ሀሳይተ፤ የሩሳላመ ቆፕተ።”<verse eid="JER 51:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="JER 51:51"/>ህንተ፥ “ኑኒ ጫየትዳ ግሾ ካዉይዳ፤ አላጋት ፆሳ ኬን ደእያ ጌሻ በሳታ ገልዳ ግሾ፥ ኑ ዬላ ማእዳ” ያግደታ።<verse eid="JER 51:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JER 51:52"/>ሽን “ታኒ ጎዳይ ባብሎነ ኤቃታ ሴርያ ዎደይ ያና። ማዱንፅዳይሳት ቢታ ኡባን ኦላና። <verse eid="JER 51:52"/><verse number="53" style="v" sid="JER 51:53"/>ባብሎነይ ሳሎ ፑደ ከይድ፥ ያን ሚፃ መናዉ ዳንዳእያኮካ፥ ያ ጋካናዉ ከይድ፥ እያ ያን ይስያ አስ ታኒ ኪታና” ያጌስ ጎዳይ።<verse eid="JER 51:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="JER 51:54"/>“ባብሎነን ዋሶይ፥</para>
  <para style="q2" vid="JER 51:54">ባብሎነ ቢታን ግታ ዮ ግርስ ስኤታና።<verse eid="JER 51:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="JER 51:55"/>ጎዳይ ባብሎነ ይሳና፤</para>
  <para style="q2" vid="JER 51:55">እያ ዎልቃማ ግርሳ ስእ ኦና።</para>
  <para style="q1" vid="JER 51:55">አባ ቤታዳ ጉምያ ሞርከት</para>
  <para style="q2" vid="JER 51:55">ኦልሸ ጬቀታና።<verse eid="JER 51:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="JER 51:56"/>ይሰይሳት ባብሎነ ቦላ ያና፤</para>
  <para style="q2" vid="JER 51:56">እያ ኦላንቾት ኦይከታና፤</para>
  <para style="q2" vid="JER 51:56">ኤንታ ዶንገይ መቃና።</para>
  <para style="q1" vid="JER 51:56">ታኒ ጎዳይ ሀሎ ከይያ ፆሰ ግድያ ግሾ፥</para>
  <para style="q2" vid="JER 51:56">ኤንታ ኦሱዋዳ ኤንታዉ ዛራና።<verse eid="JER 51:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="JER 51:57"/>እያ ሀላቃታ፥ እያ ጭንጫ አሳታ፥ እያ ደርያ ሃረይሳታ፥</para>
  <para style="q2" vid="JER 51:57">እያ ቶራ ሞጮናታነ እያ ኦላንቾታ ማያና።</para>
  <para style="q2" vid="JER 51:57">ኤንቲ ዛሪድ ደንዶና መላ መርናዉ ስካና”</para>
  <para style="q1" vid="JER 51:57">ታኒ ካዎይ፥</para>
  <para style="q2" vid="JER 51:57">ኡባፈ ዎልቃማ ጎዳ ጌተተይስ</para>
  <para style="q2" vid="JER 51:57">ሀይሳ ኦዳይስ።<verse eid="JER 51:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="JER 51:58"/>“ግታ ባብሎነ ግምበይ ኩንዳና፤</para>
  <para style="q2" vid="JER 51:58">እያ አዱሳ ፐንገት ታማን ፁገታና።</para>
  <para style="q1" vid="JER 51:58">አሳይ ኦዳባ ኡባይ ሀዳ፤</para>
  <para style="q2" vid="JER 51:58">ካዎተት ዳቡርያባይ ታማሳ” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="JER 51:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JER 51:59"/>ማሰያ ናኣ፥ ኔራ ናአይ ሳራይ ካዋ ሰደቅያሳ ሹማ። ሰደቅያስ ይሁዳን ካዎትዳ ኦይዳን ላይን፥ ሳራይ እያራ ባብሎነ ብያ ዎደ ኤርምያስ ሳራያ ቦላ ኪታ የድስ። <verse eid="JER 51:59"/><verse number="60" style="v" sid="JER 51:60"/>ባብሎነ ቦላ ጋካናዉ ደእያ ኢታባ ኡባነ ባብሎነ ፄልያ ሀራባ ኡባ ኤርምያስ ማፃፋን ፃፍስ። <verse eid="JER 51:60"/><verse number="61" style="v" sid="JER 51:61"/>ሳራያኮ፥ “ኔኒ ባብሎነ ጋክዳ ዎደ ነ ቃላ ቁ ኦዳ አሳስ ሀ ማፃፋ ናባባ። <verse eid="JER 51:61"/><verse number="62" style="v" sid="JER 51:62"/>ቃስ ሀይሳዳ ያጋዳ ዎሳ፦ ‘አቤት ጎዳዉ፥ ኔኒ ሀ በሳ ይሳና፤ ሀ በሳን ሸምፖራ ደእያ መተ፥ አስነ መሄይ ዴና፤ ሀ በሳይ መርናዉ መላ ቢታ ግዳና’ ያጋ። <verse eid="JER 51:62"/><verse number="63" style="v" sid="JER 51:63"/>ሀ ማፃፋ ናባባ ዉርስዳፐ ጉየ፥ ማፃፋ ሹቻራ ጋ ቃቻዳ፥ ኤፍራፂሳ ሻፋን ሆላ። <verse eid="JER 51:63"/><verse number="64" style="v" sid="JER 51:64"/>ታኒ ጎዳይ እያ ቦላ ኤህያ ዩዋ ጋሶን፥ ባብሎነይ ዛሪድ ደንዶና መላ ሀይሳዳ ሙከታና” ያጋ።</para>
  <para style="p" vid="JER 51:64">ኤርምያስ ኦድዳ ቃላይ ሀይሳን ዉርስ።<verse eid="JER 51:64"/></para>
  <chapter eid="JER 51"/>
  <chapter number="52" style="c" sid="JER 52"/>
  <para style="s1">የሩሳላመ ኩንደ</para>
  <para style="r">(<ref loc="2KI 24:18-25:7">2 ካዎ 24:18—25:7</ref>፤ <ref loc="JER 39:1-10">ኤርም 39:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 52:1"/>ሰደቅያስ ካዎትያ ዎደ፥ እያዉ ላይ ላታማነ እስኖ፤ እ የሩሳላመን ታማነ እስ ላይ ካዎትስ። እያ አየ ሱንይ አምፃሎ፤ እያ ልብና ካታማን ደእያ ኤርምያሳ ናአ። <verse eid="JER 52:1"/><verse number="2" style="v" sid="JER 52:2"/>እዮአቄም ኦዳይሳዳ ሰደቅያስ ጎዳ ስንን ኢታባ ኦስ። <verse eid="JER 52:2"/><verse number="3" style="v" sid="JER 52:3"/>ጎዳይ የሩሳላመ ቦላነ ይሁዳ ቦላ ሀንቀትዳ ግሾ ኤንታ ባ ስንፈ ድግስ።</para>
  <para style="p" vid="JER 52:3">ሰደቅያስ ባብሎነ ካዋ ቦላ ማካልስ። <verse eid="JER 52:3"/><verse number="4" style="v" sid="JER 52:4"/>ሰደቅያስ ካዎትዳ ኡዱፉን ላይን፥ ታማን አጌናን፥ ታማን ጋላሳን ባብሎነ ካዎይ ናቡካዳናፆር ባ ኦላንቾታ ኡባ ኤክድ፥ የሩሳላመ ተቅስ። ኤንቲ እያ ዩሹዋን ቢታ ዶርዶሶና። <verse eid="JER 52:4"/><verse number="5" style="v" sid="JER 52:5"/>ሰደቅያስ ካዎትዳ ታማነ እስን ላይ ጋካናዉ፥ የሩሳላመይ ተቀትድ ጋምእስ።<verse eid="JER 52:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 52:6"/>ሄ ላይ ኦይዳን አጌናን፥ ኡዱፉን ጋላሳን፥ ኮሽ ሱልን፥ አሳይ ምያባ ይስ። <verse eid="JER 52:6"/><verse number="7" style="v" sid="JER 52:7"/>ካታማ ግምበይ እስ ባጋራ መቅስ። ባብሎነ አሳይ ካታማ ዩሹዋ ናግኮካ፥ ይሁዳ ካዋ ኦላንቾት ኡባይ ቃማ ካዎ አታክልተ በሳ ኤፍያ ኦግያ ኦይክድ፥ ናምኡ ድርሳ ግምበታ እስፈ ጋያ ፐንግያራ ከይድ ባቃትዶሶና። ኤንቲ ዮርዳኖሰ ዛንጋራኮ ስሚድ ብዶሶና። <verse eid="JER 52:7"/><verse number="8" style="v" sid="JER 52:8"/>ሽን ባብሎነ ኦላንቾት ካዋ ሰደቅያሳ የደድ፥ እያርኮ ደምባ ጋሸ ኦይክዶሶና። እያ ኦላንቾት ኡባይ እያ ካድድ ላለትዶሶና። <verse eid="JER 52:8"/><verse number="9" style="v" sid="JER 52:9"/>ሄሳፈ ጉየ፥ እያ ሀማታ ቢታን፥ እርብላ ካታማን ደእያ ባብሎነ ካዋኮ ኤፍዶሶና። ያን ናቡካዳናፆር ሰደቅያሳ ቦላ ፕርድስ። <verse eid="JER 52:9"/><verse number="10" style="v" sid="JER 52:10"/>ሰደቅያሳ አደ ናይታ ሰደቅያስ ፄልሽን፥ ባብሎነ ካዎይ ዎስ። ይሁዳ ሀላቃታ ኡባ ያን እርብላ ካታማን ዎዶሶና። <verse eid="JER 52:10"/><verse number="11" style="v" sid="JER 52:11"/>ሰደቅያሳ አይፈታ ዎጭድ፥ ሳንላታን ቃችድ፥ ባብሎነ ኤፍዶሶና። እ ሀይቃና ጋካናዉ፥ ያን ቃሾ ኬን እያ ዎዶሶና።<verse eid="JER 52:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 52:12"/>ናቡካዳናፆር ባብሎነን ካዎትዳ ታማነ ኡዱፉን ላይን፥ እቻሻን አጌናን፥ ታማን ጋላሳን፥ ካዋ ሞርናይ፥ ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን የሩሳላመ ገልስ። <verse eid="JER 52:12"/><verse number="13" style="v" sid="JER 52:13"/>ፆሳ ኬ፥ ካዎ ጋነ የሩሳላመን ደእያ ኬታ ኡባ ታማን ፁግስ፤ ቃስ ግታ ኬታ ኡባ ፁግስ። <verse eid="JER 52:13"/><verse number="14" style="v" sid="JER 52:14"/>ባብሎነ ኦላንቾት ኡባይ ካዋ ናገይሳታ ሀላቃ ኪታን፥ የሩሳላመ ካታማ ዩሹዋን ደእያ ድርሳ ግምብያ ኡባ ላልዶሶና። <verse eid="JER 52:14"/><verse number="15" style="v" sid="JER 52:15"/>ናቡዛርዳን ጉ ማንቆታ፥ ካታማን አትዳ አሳታ፥ ካድድ ባብሎነ ኦላንቾታን ገልዳ አሳታነ ኩሸ ሂላንቾታ ድእድ ባብሎነ ኤፍስ። <verse eid="JER 52:15"/><verse number="16" style="v" sid="JER 52:16"/>ሽን ናቡዛርዳን ማንቆታፐ ጉ አሳ ዎይነ ቶካናዳነ ጋደ ጎያናዳ ይሁዳን አግስ።<verse eid="JER 52:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 52:17"/>ባብሎነት ፆሳ ኬ ካረን ኤቅዳ ናሰ ብራታ ቱቀታ፥ ጫና ጋረታነ ግታ ከረታ መንረድ፥ ናሰ ብራታ ኡባ ባብሎነ ኤፍዶሶና። <verse eid="JER 52:17"/><verse number="18" style="v" sid="JER 52:18"/>ከረታ፥ አካፋታ፥ ፆምፐ ሻሉዋ ፄራ ፕትያባታ፥ ፃሮታ፥ እፃነ ሳነታነ ያርሾ ዎደ ጎኤትያ ናሰ ብራታ ሚሸታ ኡባ ኤፍዶሶና። <verse eid="JER 52:18"/><verse number="19" style="v" sid="JER 52:19"/>ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን ዎርቃፈነ ብራፐ ኦሰትዳ ድስተታ፥ ታማ ኤክያ ሚሸታ፥ ፃሮታ፥ ላፋ ከረታ፥ ፆምፐ ዎያ ኮጫታ፥ እፃነ ሳነታነ ኡሻ ያርሾስ ጎኤትያ ኦቶታ ኤፍስ። <verse eid="JER 52:19"/><verse number="20" style="v" sid="JER 52:20"/>ካዎይ ሶሎሞነይ ፆሳ ኬን ኦሰትያባስ መዳ ናምኡ ቱሳት፥ ግታ ከረታ፥ ታማነ ናምኡ ኮርማታ ምስለትነ ጫና ጋረት መትዳ ናሰ ብራታት ምዛነን ልካናዉ ዳንዳኤተና። <verse eid="JER 52:20"/><verse number="21" style="v" sid="JER 52:21"/>ናምኡ ቱሳት እስ መላ ግድድ፥ እሶይ እሶይ ታማነ ሆስፑን ዋ አዱሰ። ኤንታ ኡባይ ታማነ ናምኡ ዋ። ኤንታዉ ግዶይ ካይስ ግድድ፥ ብራታይ ኦይዱ ብራ ኬና ኦርደ። <verse eid="JER 52:21"/><verse number="22" style="v" sid="JER 52:22"/>ናምኡ ቱሳታ ሁጵያን ናሰፐ ኦሰትዳ ጉምቦት ደኦሶና። እስ ጉምቡዋ ጌሳይ እቻሹ ዋ ግድድ፥ ዩሾይ ግተ ምስለንነ ኦሮማነ ምስለን አሌቀትድ ኡትስ። ናምአን ጉምቦይካ እያ መላ። <verse eid="JER 52:22"/><verse number="23" style="v" sid="JER 52:23"/>ጉምቦታስ ምየን ምየን ደእያ ኦሮማነታ ምስለት ኡዱፉን ታማነ ኡሱፑና፤ ዩሹዋን ደእያ ግተ ምስለታፐ ቦላ ባጋራ ደእያ ኦሮማነ ምስለት እስ ፄታ።<verse eid="JER 52:23"/></para>
  <para style="s1">ይሁዳ አሳይ ባብሎነ ድኤትስ</para>
  <para style="r">(<ref loc="2KI 25:18-21">2 ካዎ 25:18-21</ref>፥ <ref loc="2KI 25:27-30">27-30</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 52:24"/>ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን ካህነ ሀላቃ ሳራያ፥ እያ ካልያ ካህንያ ሶፎንያሳነ ፐንገ ናግያ ሄ አሳታ ኦይክስ። <verse eid="JER 52:24"/><verse number="25" style="v" sid="JER 52:25"/>ካታማን ደእያ አሳፐ ቶራ ሞጮና፥ ካዋ ዞረይሳታፐ ላፑን አሳታ ኤፍስ። ቶራ ሞጮና፥ ፃፍያ፥ አሳ ኦላንቾታ ዶርያ ሀላቃነ ሀራ ኡሱፑን ታሙ አሳታ ኤፍስ። <verse eid="JER 52:25"/><verse number="26" style="v" sid="JER 52:26"/>ናቡዛርዳን ኤንታ ኡባ ኤክድ፥ ባብሎነ ካዋኮ፥ እርብላ ካታማ ኤፍስ። <verse eid="JER 52:26"/><verse number="27" style="v" sid="JER 52:27"/>ሀማታ ቢታን፥ እርብላ ካታማን፥ ባብሎነ ካዎይ ኤንታ ኡባ ዎስስ። ሄሳዳ ሀንድ፥ ይሁዳ አሳይ ባንታ ቢታፈ ድኤትድ ብዶሶና።<verse eid="JER 52:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 52:28"/>ናቡካዳናፆር ካዎትዳ ላፑን ላይን፥ ሄ ሙኩሉነ ላታማነ ሄ አሳይ ይሁዳፐ ድኤትስ። <verse eid="JER 52:28"/><verse number="29" style="v" sid="JER 52:29"/>ታማነ ሆስፑን ላይን ሆስፑን ፄታነ ሀስታማነ ናምኡ አሳይ የሩሳላመፐ ድኤትስ። <verse eid="JER 52:29"/><verse number="30" style="v" sid="JER 52:30"/>ናቡካዳናፆር ካዎትዳ ላታማነ ሄን ላይን ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን ላፑን ፄታነ ኦይታማነ እቻሹ አሳ ድእስ። ድኤትዳ አሳ ታይቦይ ኦይዱ ሙኩሉነ ኡሱፑን ፄታ።<verse eid="JER 52:30"/></para>
  <para style="s1">ዮአክና ብለተ</para>
  <para style="p">
    <verse number="31" style="v" sid="JER 52:31"/>ዮአክን ድኤትዳ ሀስታማነ ላፑን ላይን፥ ታማነ ናምአን አጌናን፥ ላታማነ እቻሻን ጋላሳን፥ ዮር-ማሮዳክ ካዎትዳ ላይ ይሁዳ ካዋ ዮአክና ቦንችድ፥ ቃሾፐ ብርሽስ። <verse eid="JER 52:31"/><verse number="32" style="v" sid="JER 52:32"/>ዮር-ማሮዳክ ዮአክናራ ማልኦ ቃላ ኦደትድ፥ ባብሎነን ድኦን ደእያ ሀራ ካዎታ ኡባፈ አድ እያ ቦንችስ። <verse eid="JER 52:32"/><verse number="33" style="v" sid="JER 52:33"/>ሄሳ ግሾ፥ ዮአክን ቃሾ ኬን ማእያ ማኡዋ ላምድ፥ ባ ደኦ ላይ ኡባን ካዎ ጋይታፐ ምሸ ደእስ። <verse eid="JER 52:33"/><verse number="34" style="v" sid="JER 52:34"/>ዮአክን ሀይቃና ጋካናዉ፥ ጋላስ ጋላስ እያዉ ኮሽያባ ኡባ ባብሎነ ካዎይ እሚስ።<verse eid="JER 52:34"/></para>
  <chapter eid="JER 52"/>
</usx>
