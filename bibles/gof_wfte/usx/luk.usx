<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ሉቃሳ ዎንገላ</para>
  <para style="toc1">ሉቃሳ ዎንገላ</para>
  <para style="toc3">ሉቃ</para>
  <para style="toc2">ሉቃሳ</para>
  <para style="mt1">ሉቃስ ፃፍዳ</para>
  <para style="mt2">የሱስ ክርስቶሳ ዎንገላ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሉቃስ የሱሲ ዶርዳ ታማነ ናምኡ ሀዋረታ ግዶን ዴና። ሉቃሳ ዎንገላይ፥ የሱሲ ኮይሮ ናበታ ዶናን ያና ጌተትድ ኦደትዳይሳ፥ እስራኤለት ናግሸ ደእያ “ክርስቶሳ” ግደይሳነ አሳ ኮቸ ኡባ አሻናዉ ደኤይ እያ ግደይሳ ቆንጭሴስ። ሉቃስ ባ ማፃፋን፥ የሱሲ፥ “ማንቆታስ ዎንገላ ሳባካናዉ” ባ አዋፐ ኪተትዳይሳነ ሄ ዎንገላይ አሳይ ደእያ ዱማ ዱማ መቱዋፐ ከሰይሳ ግደይሳ ኦዴስ። ሉቃሳ ዎንገላ ግዶን፥ የሱሳ ዩሳባ ኦድያ ኮይሮ ሸምፖታንነ የሱሲ ሳሎ ብዳይሳ ኦድያ ዉርሰ ሸምፖታን ቆንጭድ ኦደትዳይ ኡፋይሳባ። የሱሲ ሳሎ ብዳፐ ጉየ አማኖይ ዋንድ ድጭዳኮነ ዳልግዳኮ ኦድያ ታርክያ ሀ ዎንገላ ፃፈይ ሀዋረታ ኦሶ ማፃፋን ፃፍስ።</para>
  <para style="ip">ኪታንቾታ ማዝሙርያ፥ የሱሲ የለትዳ ዎደ ሄንቾት ብድ እያ በእዳይሳ ኦድያ ታርከይ ደኤይ ሉቃሳ ዎንገላና። ቃስ የሱሲ ናአተን ፆሳ ኬ ብዳይሳ፥ ቃትያ ሳማረ አድያባነ ይድ በንትዳ ናአባ ኦድያ ታርከይ፥ ሉቃሳ ዎንገላ ፃላላን በንትያ ታርከ። ዎሳባይ፥ ጌሻ አያናባይ፥ ማጫሳስ እመትዳ በሳይነ ፆሲ ናጋራ አቶ ገይስ፥ ሉቃሳ ዎንገላን ጋፃፐ ጋፃ ጋካናዉ ደእያ ዋና ቆፋታ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ገሎ ቆፋ (<char style="ior"><ref loc="LUK 1:1-4">1:1-4</ref></char>)</para>
  <para style="io1">ፃማቅያ ዮሃንሳነ የሱሳ የለተ (<char style="ior"><ref loc="LUK 1:5-2:52">1:5—2:52</ref></char>)</para>
  <para style="io1">ፃማቅያ ዮሃንሳ ኦሱዋ (<char style="ior"><ref loc="LUK 3:1-20">3:1-20</ref></char>)</para>
  <para style="io1">የሱሳ ፅንቃተነ ፓጨተ (<char style="ior"><ref loc="LUK 3:21-4:13">3:21—4:13</ref></char>)</para>
  <para style="io1">የሱሲ ጋልላን ኦዳ ኦሱዋ (<char style="ior"><ref loc="LUK 4:14-9:50">4:14—9:50</ref></char>)</para>
  <para style="io1">ጋልላፐ የሩሳላመ ጋካናዉ (<char style="ior"><ref loc="LUK 9:51-19:27">9:51—19:27</ref></char>)</para>
  <para style="io1">የሩሳላመ ሄራን አዳ ዉርሰ ሳምንታ (<char style="ior"><ref loc="LUK 19:28-23:56">19:28—23:56</ref></char>)</para>
  <para style="io1">ሀይቆፐ ደንዶ፥ አሳስ በንቶነ ሳሎ ቡሱ (<char style="ior"><ref loc="LUK 24:1-53">24:1-53</ref></char>)</para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>ቦንቾ ተዎፍሎሳ፥ ኑ ግዶን ፖለትዳባስ ዳሮት፥ ባንታዉ ዳንዳኤትዳ መላ ፃፍዶሶና። <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>ሄ ታርክያ ኤንቲ ፃፍዳይ ኮይሮፐ ዶምድ አይፈ ማርካትነ ቃላ ሀጋዘይሳት ኑስ ኦድዳይሳ። <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>ታካ ታ ባጋራ ኮይሮፐ አኬካ ፄልዳፐ ጉየ፥ ሄ ታርክያ ሀኖታ ማራያዳ ነዉ ፃፎይ ሎኦ ግድድ በንትስ። <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>ሄስካ፥ ነ ታማርዳባይ ቱማ ግደይሳ ኤርሳናሳ።<verse eid="LUK 1:4"/></para>
  <para style="s1">ፃማቅያ ዮሃንሳ የለተ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>ይሁዳ ካዋ ሄሮዲሳ ዎደ አብያ ያራፐ ግድዳ ዛካርያሳ ጌተትያ አይሁደ ካህነይ ደኤስ። እያ ማችያካ አሮና ሼሻፐ። እ ሱንይካ ኤልሳቤፆ።<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="1CH 24:10">1 ታር 24:10</ref>.</char></note> <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>ናምአይካ ጎዳ ዎጋነ ኪታ ኡባ ናግድ ቦረይ ባይና ፆሳ ስንን ፅሎተን ደእዶሶና። <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>ሀኖፐ አትሽን፥ ኤልሳቤፃ ማይን ግድዳ ግሾ ኤንታዉ ናእ ባዋ፤ ናምአይካ ቃስ ጭምዶሶና።<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>እስ ጋላስ ዛካርያስ ባ ግሹዋ ማራን ፆሳ ስንን ካህነተን ሀጋዜስ። <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>ካህነተ ዎጋን ፆሳ ኬ ገልድ እፃነ ጩይሳናዉ እያ ሳም ጋክስ። <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>እፃነይ ጩያ ዎደ አሳይ ካረን ዎሴስ።<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>ጎዳ ኪታንቾይ ያርሾ ያርሽያ በሳፈ ኡሻቻ ባጋራ ኤቅድ በንትስ። <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>ዛካርያስ እያ በእዳ ዎደ ዳጋምድ ዳሮ ያይስ። <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>ሽን ኪታንቾይ እያኮ፥ “ዛካርያሳ ያዮፋ፤ ነ ዎሳይ ስኤትስ። ነ ማችያ ኤልሳቤፃ አደ ናአ የላና፥ እያ ዮሃንሳ ጋዳ ነ ሱንና። <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>እ ነዉ እንጀነ ኡፋይስ ግዳና፤ ዳሮት እያ የለተን ኡፋይታና። <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>ጎዳ ስንን እ ግታ ግዳና፤ ዎይነ ኡሽ ግድን ሀራ ማይያ ኡሻ ኡየና። ባ አየ ኡሎን ደእሸ ጌሻ አያናን ኩማና።<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="NUM 6:3">ታይቦ 6:3</ref>.</char></note> <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>እስራኤለ አሳታፐ ዳሮታ ባንታ ጎዳ፥ ፆሳኮ ዛራና። <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>አዋታ ዎዛና ናይታኮ ዛራና፥ ኪተቶናይሳታ ፅሎታ ጭንጫተኮ ዛራና መላ፥ ጎዳስ በሲያ ደረ ጊግሳናዉ ኤልያሳ አያናንነ ዎልቃን ጎዳ ስንን ባና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAL 4:5-6">ምልክ 4:5-6</ref>.</char></note><verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>ዛካርያስ ኪታንቹዋኮ፥ “ታ ሄሳ አይብን ኤራኔ? ታራነ ታ ማቸራ ጭምዳ” ያግስ።<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>ኪታንቾይ ዛሪድ፥ “ታኒ ፆሳ ስንን ኤቅያ ጋብሬለ። ሀ ምሽራቹዋ ነዉ ኦዳናዉ ፆሳፈ ኪተታስ።<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="DAN 8:16">ዳነ 8:16</ref>፤ <ref loc="DAN 9:21">9:21</ref>.</char></note> <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>ሄኮ፥ ዎድያ ናግድ ፖለትያ ታ ቃላ ነ አማኖና እፅዳ ግሾ፥ ሀይስ ፖለታና ጋካናዉ ኔኒ ሙመ ግዳና፥ ኦደታናዉካ ዳንዳአካ” ያግስ።<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>ሄ ዎደ ዛካርያስ ፆሳ ኬ ገልድ ጋምእዳ ግሾ፥ አይብ ሀንደ ግድ አሳይ ካረን ናግሸ ጋምእስ። <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>እ ካረ ከይድ ኤንታና ኦድሳናዉ ዳንዳእቤና። ማል በሶፐ አትሽን፥ ኦደታናዉ ዳንዳኦናይሳ በእዳ ዎደ ቆንጨ በእዳይሳ ኤርዶሶና።<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>ዛካርያስ ባ ሀጋዙዋ ፖልድ ሶ ስምስ። <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>ሄሳፈ ጉየ፥ እያ ማችያ ኤልሳቤፃ ቃንታሱ። እቻሹ አጌና ኩመ ባና ገንዳ ጋምአሱ። <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>እያ፥ “ጎዳይ ባ ማሮታን ታ ቦርያ አሳ ግዶፈ ድጋናዉ በእድ ሀ ዎድያን ሀይሳ ኦስ” ያጋሱ።<verse eid="LUK 1:25"/></para>
  <para style="s1">የሱሳ የለተይ ኮይሮትድ ኦደትስ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>ኤልሳቤፃ ቃንትን ኡሱፑን አጌናን፥ ፆሳይ ኪታንቹዋ ጋብሬለ ጋልላ ቢታን ደእያ ናዝረተ ካታማ ኪትስ። <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>ካዋ ዳዊታ ሼሻፐ ግድዳ ዮሰፋ ጌተትያ ኡራስ ኦይሸትዳ ጌላኤኮ ኪትስ። ሄ ጌላእያ ማይራሞ ጌተታዉሱ።<note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">ማቶ 1:18</ref>.</char></note> <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>ኪታንቾይ ኢኮ ብድ፥ “ዳሮ ዶሰትዳረ፥ ሳሮይ ነዉ ግዶ፥ ፆሳይ ኔራ ደኤስ፤ ኔኒ አንጀትዳሮ” ያግስ።<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>ማይራማ እያ ኦዳን ዳሮ ዳጋማዳ፥ “ሀይስ አይብ ሳሮ” ጋዳ ሄታሱ። <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>ኪታንቾይ ዛሪድ፥ “ማይራመ፥ ባቦፋ፤ ኔኒ ፆሳ ስንን ሳባ ደማዳሳ። <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>ሄኮ ኔኒ ቃንታና አደ ናአ የላና፥ እያ ሱን የሱሳ ጋዳ ሱንና።<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">ማቶ 1:21</ref>.</char></note> <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>እ ግታ ግዳና፥ ኡባፈ ቦላ ፆሳ ናኣ ጌተትድ ፄገታና። ጎዳ ፆሳይ እያ አዋ ዳዊታ አራታ እያዉ እማና።<note caller="-" style="x"><char style="xo" closed="false">1:32 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">2 ሳሜ 7:12-13</ref>፥ <ref loc="2SA 7:16">16</ref>፤ <ref loc="ISA 9:7">እሳ 9:7</ref>.</char></note> <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>እ ያይቆባ ሼሻ ቦላ መርናዉ ካዎታና፤ እያ ካዎተስ ዛው ባዋ” ያግስ።<verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>ማይራማ ኪታንቹዋኮ፥ “ሄስ ዋንድ ሀናኔ? ታ አደ ኤርከ” ያጋሱ።<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>ኪታንቾይ ዛሪድ፥ “ጌሻ አያናይ ነ ቦላ ዎና፥ ኡባፈ ቦላ ፆሳ ዎልቃይ ነ ቦላ ኩያታና። ሄሳ ግሾ፥ የለትያ ጌሻ ናአይ ፆሳ ናኣ ጌተታና። <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>ሄኮ፥ ነ ዳብያ ኤልሳቤፃ ባ ጭማተ ላይን አደ ናአ ቃንታሱ። እያ ማይን ጌተትዳሮ፥ ሽን ሀእ ኡሱፑን አጌና ኦይካሱ። <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>ፆሳ ፆንያባይ ባዋ”<note caller="-" style="x"><char style="xo" closed="false">1:37 </char><char style="xt" closed="false"><ref loc="GEN 18:14">መ 18:14</ref>.</char></note> ያግስ።<verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>ማይራማ፥ “ሄኮ፥ ታኒ ጎዳ አይልዉ፥ ነ ቃላዳ ታዉ ሀኖ” ያጋሱ። ሄሳፈ ጉየ፥ ኪታንቾይ ኢፐ ሻከትስ።<verse eid="LUK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>ማይራማ ሄ ሳምንታን ደንዳዳ ይሁዳ ቢታን ደእያ እስ ደረይ ዳርያ ካታማ ባሱ። <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>ዛካርያሳ ሶ ገላዳ ኤልሳቤፆ ሳሮሱ። <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>ኤልሳቤፃ ማይራም ሳሮዋ ስእዳ ዎደ እ ኡሉዋን ደእያ ናአይ ኡፋይሳን ጉፕስ። ኤልሳቤፃ ጌሻ አያናን ኩማዳ፥ <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>ባ ቃላ ቁ ኦዳ፥ “ኔኒ ማጫሳ ግዶፈ አንጀትዳሮ፥ ነ ቃንትዳ ናአይካ አንጀትዳይሳ። <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>ሀኖሽን፥ ታ ጎዳ አየ፥ ኔኒ ታኮ ያና መላ ታኒ ኦኔ? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>ሄኮ ነ ሳሮዋ ታ ስእዳ ዎደ ታ ኡሉዋን ደእያ ናአይ ኡፋይሳን ጉፕስ። <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>ጎዳይ ፖላና ግድ እምዳ ቃላ አማንዳራ፥ እያ አንጀትዳሮ” ያጋሱ።<verse eid="LUK 1:45"/></para>
  <para style="s1">ማይራም ማዝሙርያ</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46"/>ማይራማ ሀይሳዳ ያጋሱ፦</para>
  <para style="q1" vid="LUK 1:46">“ታ ሸምፕያ ጎዳ ቦንቻዉሱ፥<note caller="-" style="x"><char style="xo" closed="false">1:46 </char><char style="xt" closed="false"><ref loc="1SA 2:1-10">1 ሳሜ 2:1-10</ref>.</char></note><verse eid="LUK 1:46"/></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47"/>ታ አያናይ ልያ ፆሳን ኡፋይቴስ።<verse eid="LUK 1:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48"/>እ ባ አይለ ካዉሻተ በእስ።</para>
  <para style="q1" vid="LUK 1:48">ሀችፈ ዶምድ የለተ ኡባይ ታና አንጀትዳሮ ጋና።<note caller="-" style="x"><char style="xo" closed="false">1:48 </char><char style="xt" closed="false"><ref loc="1SA 1:11">1 ሳሜ 1:11</ref>.</char></note><verse eid="LUK 1:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49"/>አይስ ጊኮ፥ ዎልቃማ ግድዳ እ፥ ታዉ ግታባ ኦስ።</para>
  <para style="q2" vid="LUK 1:49">እያ ሱንይ ጌሻ።<verse eid="LUK 1:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>እያ ቦንቸይሳታ ቦላ፥</para>
  <para style="q2" vid="LUK 1:50">እያ ማሮተይ መርናፐ መርና ጋካናሳ።<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>ባ ቀስያን ምኖባ ኦስ፥</para>
  <para style="q2" vid="LUK 1:51">ባንታ ዎዛናን ኦቶርተይሳታ ላልስ።<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>ዎልቃማ ካዎታ አራታፐ ካዉሽስ፤</para>
  <para style="q2" vid="LUK 1:52">ባንታና ካዉሽዳይሳታ ካቦይስ።<note caller="-" style="x"><char style="xo" closed="false">1:52 </char><char style="xt" closed="false"><ref loc="JOB 5:11">እዮ 5:11</ref>፤ <ref loc="JOB 12:19">12:19</ref>.</char></note><verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>ኮሻትዳይሳታ ሎኦባን ካልስስ፥</para>
  <para style="q2" vid="LUK 1:53">ሽን ዱረታ መላ ኩሸ የድስ።<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54"/>ባ ማሮታ ቆፕድ፥</para>
  <para style="q2" vid="LUK 1:54">ባ አይልያ እስራኤለ ማድስ።<verse eid="LUK 1:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55"/>ሄስካ ኑ አዋታስ ኦድዳ ቃላ፥</para>
  <para style="q2" vid="LUK 1:55">አብራሃመስነ እያ ሼሻስ ግዳይሳ መርናዉ ፖላናሳ”<note caller="-" style="x"><char style="xo" closed="false">1:55 </char><char style="xt" closed="false"><ref loc="GEN 17:7">መ 17:7</ref>.</char></note></para>
  <para style="m" vid="LUK 1:55">ያጋሱ።<verse eid="LUK 1:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>ማይራማ ኤልሳቤፅ ማታን ሄ አጌና መላ ጋምአዳ ባ ሶ ስማሱ።<verse eid="LUK 1:56"/></para>
  <para style="s1">ፃማቅያ ዮሃንሳ የለተ</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>ኤልሳቤፅስ የሎ ቃማይ ጋክን አደ ናአ የላሱ። <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>እ ሾሮትነ እ ዳቦት ጎዳይ ግታ ማሮታ ኦዳይሳ ስእድ፥ ኢራ እስፈ ኡፋይትዶሶና። <verse eid="LUK 1:58"/><verse number="59" style="v" sid="LUK 1:59"/>ሆስፑን ጋላሳን ዮጋ ናኣ ቃፃራናዉ ይዶሶና። እያ አዋ ሱንን ዛካርያሳ ግድ ሱንናዉ ኮይዶሶና።<note caller="-" style="x"><char style="xo" closed="false">1:59 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ሌወ 12:3</ref>.</char></note> <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>ሽን አይያ፥ “አካይ፥ ዮሃንሳ ጌተታናዉ በሴስ” ያጋሱ። <verse eid="LUK 1:60"/><verse number="61" style="v" sid="LUK 1:61"/>ኤንትካ፥ “ነ ዳቦታፐ ሀ ሱንን ፄገትዳይ ኦንካ ባዋ” ያግዶሶና። <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>እያ አዋይ ኦና ግድ ሱንነኮ ኤራናዉ ኮይድ እያ ማላ ኦይችዶሶና። <verse eid="LUK 1:62"/><verse number="63" style="v" sid="LUK 1:63"/>እ ፃፍያባ ኦይች ኤክድ፥ “እያ ሱንይ ዮሃንሳ” ግድ ፃፍስ። ኡባይ እ ፃፍዳይሳ በእድ ማላለትዶሶና። <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>ኢራ ዛካርያሳ እንፃርሳይ ብለትስ፥ ፆሳ ጋላትሸ ኦደተ ኦይክስ። <verse eid="LUK 1:64"/><verse number="65" style="v" sid="LUK 1:65"/>ሾሮት ኡባይ ያሻን ኩምዶሶና። ሀ ሀንዳባይ ደረይ ዳርያ ይሁዳ ቢታን ኦደትስ። <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>ሄሳ ስእዳ ኡባይ፥ “ሀ ናአይ አይ ሀናንደሻ” ግድ ባንታ ግዶን ኦደትዶሶና። ጎዳ ኩሸይ እያራ ደኤስ።<verse eid="LUK 1:66"/></para>
  <para style="s1">ዛካርያሳ ማዝሙርያ</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>ዮሃንሳ አዋይ ዛካርያስ ጌሻ አያናን ኩምድ ሀይሳዳ ያግድ ትንብተ ኦድስ።<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>“እስራኤለ ጎዳይ ጋላተቶ፥</para>
  <para style="q2" vid="LUK 1:68">ይድ ባ አሳ ዎዝስ።<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69"/>ባ አይልያ ዳዊታ ኬን</para>
  <para style="q2" vid="LUK 1:69">አቶተ ካጭያ ደንስ።<verse eid="LUK 1:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70"/>ሄስካ በን ዎደ ጌሻ ናበታ ዶናን ኦደትዳይሳ መላ፥<verse eid="LUK 1:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>እያ አሾይ ኑ ሞርከታፐነ</para>
  <para style="q2" vid="LUK 1:71">ኑራ ኤቀትያ ኡባ ኩሽያፐ።<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>ሄሳ እ ኦዳይ ኑ አዋታስ ባ ማሮታ በሳናስነ፥</para>
  <para style="q2" vid="LUK 1:72">ባ ጌሻ ጫቁዋ ናጋናሳ።<verse eid="LUK 1:72"/></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73"/>ኑ አዋ አብራሃመስ ጫቅዳ</para>
  <para style="q2" vid="LUK 1:73">ጫቁዋ ቆፓናስነ<verse eid="LUK 1:73"/></para>
  <para style="q2">
    <verse number="74" style="v" sid="LUK 1:74"/>ኑ ሞርከታ ኩሸፐ ከስድ</para>
  <para style="q2" vid="LUK 1:74">ያሽ ባይና እያ ሀጋዛና መላሳ።<verse eid="LUK 1:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75"/>ኑ ላይ ኡባን ጌሻተንነ ፅሎተን</para>
  <para style="q2" vid="LUK 1:75">ባ ስንን ኑና ኤሳናሳ።<verse eid="LUK 1:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>ቃስ ላ ናአዉ፥ ኔኒ ኡባፈ ቦላ ፆሳ ናበ ጌተታና።<note caller="-" style="x"><char style="xo" closed="false">1:76 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ምልክ 3:1</ref>.</char></note></para>
  <para style="q1" vid="LUK 1:76">ጎዳ ኦግያ ሎይናዉ ነ እያ ስንን ባና።<verse eid="LUK 1:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77"/>ኤንታ ናጋራይ ቁሸትን፥</para>
  <para style="q2" vid="LUK 1:77">ኤንቲ አቶተ ደማናይሳ ነ ጎዳ ደርያስ ኦዳና።<verse eid="LUK 1:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78"/>ኑ ፆሳ ሎኦ ማሮተፈ ደንዶይሳን</para>
  <para style="q2" vid="LUK 1:78">ዎንታ ፃልቀይ ኑስ ሳሉዋፐ ከይስ።<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>ሄስካ ማንነ፥</para>
  <para style="q2" vid="LUK 1:79">ሀይቆ ኩያ ጋርሳን ደኤይሳታስ ፖእሳናሳ፥</para>
  <para style="q2" vid="LUK 1:79">ኑ ቶሁዋካ ሳሮ ኦግያኮ ዛራናሳ”</para>
  <para style="m" vid="LUK 1:79">ያግስ።<note caller="-" style="x"><char style="xo" closed="false">1:79 </char><char style="xt" closed="false"><ref loc="ISA 9:2">እሳ 9:2</ref>.</char></note><verse eid="LUK 1:79"/></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>ናአይ ድጭስ፥ አያናን ምንስ፥ እስራኤለ አሳስ ቆንጫና ጋካናዉ መላ ቢታን ደእስ።<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s1">የሱሳ የለተ</para>
  <para style="r">(<ref loc="MAT 1:18-25">ማቶ 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>ሄ ዎደ ሮመ ቢታን ደእያ አሳ ኡባይ ታይበታና መላነ ሱንይ ፃፈታና መላ ካዎይ አዉግስፆስ ኪትስ። <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>ሄስካ ቀረኖስ ሶረ ቢታ አይስያ ዎደ ኦሰትዳ ኮይሮ ታይቡዋ። <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>ሄሳ ግሾ፥ እስ እስ አስ ባ ሱን ፃፈታናዉ ባ የለትዳ ቢታ ብስ።<verse eid="LUK 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4"/>ዮሰፍካ ዳዊታ ኬፈነ ያራፐ ግድዳ ግሾ፥ ጋልላ ናዝረተ ካታማፐ ደንድድ ዳዊታ ካታማ ግድዳ ይሁዳ ቤተለመ ብስ። <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>ብሸ፥ የላናዉ ዎደይ ዉርዳ እ ኦይች ዎዳ፥ ማይራምራ ዎላ ፃፈታናዉ ብስ። <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>ኤንቲ ያን ደእሽን እዉ የሎ ዎደይ ጋክስ። <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>ባ ባይራ ናኣ የላሱ። ጩርቃራ ፃፃዳ እማ አቅያ ኬን በሲ ይዳ ግሾ ዳራን መሄ ሙዝያ ጎንገን ዝንእሳሱ።<verse eid="LUK 2:7"/></para>
  <para style="s1">ሄንንቾታነ ኪታንቾታ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>ሄ ጋድያን ቃማ ዶርሳ ዉድያ ናግሸ ካረን አቅያ ሄንንቾት ደኦሶና። <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>ጎዳ ኪታንቾይ ሀሳዮና ይድ ኤንታ ማታን ኤቅስ። ጎዳ ቦንቾይ ኤንታ ዩሹዋን ፖእስ፤ ኤንትካ ዎልቃማ ያሽ ያይዶሶና። <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>ሽን ኪታንቾይ፥ “ያዮፍተ! ሄኮ፥ አሳ ኡባስ ግድያ ግታ ኡፋይሳ ምሽራቹዋ ኤካዳ ያስ። <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>ሄስካ፥ ዳዊታ ካታማን አሸይስ ህንተዉ ሀች የለትስ። እ ጎዳ ክርስቶሳ። <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>ዞቃለ ናእ ጩርቃራ ፃፀትድ ጎንገን ዝንእዳይሳ ህንተ ደማና፤ ሄስካ ህንተዉ ማላ ግዶ” ያግስ።<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>ቆፖና ዳሮ ሳሎ ኪታንቾት ኪታንቹዋራ እስፈ ቆንጭድ፥<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>“ቦንቾይ ፆሳስ ቃ ሳሉዋን፥</para>
  <para style="q2" vid="LUK 2:14">ሳሮይ ቢታ ቦላ ፆሳይ ዶስያ አሳስ ግዶ”</para>
  <para style="m" vid="LUK 2:14">ያግድ ጋላትዶሶና።<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>ኪታንቾት ኤንታፈ ሻከትድ ሳሉዋ ከይዳፐ ጉየ ሄንንቾት፥ “አነ ጎዳይ ኑስ ቆንጭስዳባነ ሀንዳባ በአናዉ ቤተለመ ቦስ” ያግዶሶና።<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>ኤንትካ ኤለስድ ብዶሶና። ማይራሞ፥ ዮሰፋነ ዞቃለ ናኣ ጎንገን ዝንእዳይሳ በእዶሶና። <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>በእ ስሚድ ናአባ ኤንታዉ ኦደቶይሳ፥ ቆንጭስድ ሄ በሳን ደእያ አሳስ ማርካትዶሶና። <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>ሄሳ ስእዳ ኡባይ ሄንንቾት ኦድዳይሳን ማላለትዶሶና። <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>ማይራማ ሀንዳባ ኡባ ባ ዎዛናን ቆፓሸ ደአሱ። <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>ሄንንቾት ኤንታዉ ኦደትዳይሳዳ ሀንን በእዶሶና። ሄሳ ግሾ፥ ባንታ ስእዳባስነ በእዳባ ኡባስ ፆሳ ቦንችሸነ ጋላትሸ ስምዶሶና።<verse eid="LUK 2:20"/></para>
  <para style="s1">የሱሳ ፆሳ ኬ ኤፍዶሶና</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>ሆስፑን ቃማን፥ ቃፃሮ ዎደይ ጋክን፥ እ ቃንታናፐ ስን ኪታንቾይ ዎዳ ሱንን የሱሳ ጌተትስ።<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ሌወ 12:3</ref>፤ <ref loc="LUK 1:3">ሉቃ 1:3</ref>.</char></note> <verse eid="LUK 2:21"/><verse number="22" style="v" sid="LUK 2:22"/>ሙሰ ዎጋ መላ ኤንታ ጌሻተ ዎደይ ፖለትዳፐ ጉየ ዮሰፋራነ ማይራምራ ዮጋ ናኣ ባንታ ጎዳስ እማናዉ የሩሳላመ ብዶሶና። <verse eid="LUK 2:22"/><verse number="23" style="v" sid="LUK 2:23"/>ሄስካ፥ ጎዳ ዎጋን፥ “አደ ግድዳ ባይራ ናእ ኡባይ ጎዳስ ዱማትዳይሳ ግዶ” ጌተትድ ፃፈትዳይሳ ፖላናሳ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ከሳ 13:2</ref>፥ <ref loc="EXO 13:12">12</ref>.</char></note> <verse eid="LUK 2:23"/><verse number="24" style="v" sid="LUK 2:24"/>ቃስ ጎዳ ዎጋን፥ ናምኡ ኩራቾ ዎይኮ ሆለ ያርሻናዉ ኤፍዶሶና። <verse eid="LUK 2:24"/><verse number="25" style="v" sid="LUK 2:25"/>ሄ ዎደ ጌሽነ አማኖራ ምኖ ግድዳ ስሞና ጌተትያ አስ የሩሳላመን ደኤስ። እ እስራኤለታ አቶተ ናግሸ ደኤስ። ጌሻ አያናይካ እያ ቦላ ደኤስ። <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>ቃስ ክርስቶሳ በኦና ሀይቆናይሳ ጌሻ አያናይ እያዉ ቆንጭስን ኤርድ ደኤስ። <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>እ ሄ ጋላስ አያናይ ካለን ፆሳ ኬ ብስ። ናኣ አየራነ አዋራ ዎጋ ፖላናዉ ዮጋ ናኣ የሱሳ ኤክድ ገልዳ ዎደ፥ <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>ስሞን ሞክ ኤክድ ናኣ እድምድ፥<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29"/>“ጎዳዉ ነ ታዉ ገልዳ ቃላ መላ፥</para>
  <para style="q2" vid="LUK 2:29">ሀእ ነ አይልያ ሳሮን ሞይዛ።<verse eid="LUK 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30"/>ታ አይፈይ አሳ ኡባ ስንን ነ ጊግስዳ፥<verse eid="LUK 2:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31"/>ነ አሹዋ በእስ።<verse eid="LUK 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>ሄስካ ካዎተታ ኡባስ፥</para>
  <para style="q2" vid="LUK 2:32">ፆሳ ኦግያ ቆንጭስያ ፖኦ፥</para>
  <para style="q2" vid="LUK 2:32">ነ አሳ እስራኤለስካ ቦንቾ”</para>
  <para style="m" vid="LUK 2:32">ያግድ ፆሳ ጋላትስ።<note caller="-" style="x"><char style="xo" closed="false">2:32 </char><char style="xt" closed="false"><ref loc="ISA 42:6">እሳ 42:6</ref>፤ <ref loc="ISA 49:6">49:6</ref>፤ <ref loc="ISA 52:10">52:10</ref>.</char></note><verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>ዮሰፋራነ ማይራምራ እያዉ ኦደትዳባን ማላለትዶሶና። <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/>ስሞን ኤንታ አንጅስ። አየ ማይራምኮ፥ “ሄኮ ዳሮ አሳ ዎዛና ቆፋይ ቆንጫና መላ፥ እስራኤለን ደእያ ዳሮታስ ኤንታ ኩንደስነ ደንዱዋስ ፆሳን ዶረትስ። <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>ቃስ ኤቀተይሳታስ ማላ ግዳና። ነ ሸምፑዋራካ ቃስ ማሽ አና” ያግስ። <verse eid="LUK 2:35"/><verse number="36" style="v" sid="LUK 2:36"/>ቃስ አሴራ ያራፐ ግድዳ ፋኑኤላ ናእያ ሃና ጌተትያ ናበይ ደአዉሱ። እያ ዳሮ ጭማሱ፤ እያ ባ ኮይሮ አዝናራ ላፑን ላይ ደአሱ። <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>እ አዝናይ ሀይቅን ሆስፑን ታማነ ኦይዱ ላይ ግዳና ጋካናዉ ቃማነ ጋላስ ፓጨይ ባይና ዎሳንነ ፆማን ፆሳ ኬን ሀጋዛሱ። <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>እያ ሄ ሳትያን ባዳ ፆሳ ጋላታሱ፤ የሩሳላመ ዎዘተ ናግያ ኡባስ ዮጋ ናአባ ማርካታሱ። <verse eid="LUK 2:38"/><verse number="39" style="v" sid="LUK 2:39"/>ዮሰፋራነ ማይራምራ ጎዳ ህግያን ኪተትዳ ዎጋ ኡባ ፖልዳፐ ጉየ ጋልላ ቢታን ደእያ ባንታ ካታማ ናዝረተ ስምዶሶና።<note caller="-" style="x"><char style="xo" closed="false">2:39 </char><char style="xt" closed="false"><ref loc="MAT 2:23">ማቶ 2:23</ref>.</char></note> <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>ናአይ ድጭሸነ ምንሸ ብስ። ጭንጫተን ኩምስ፤ ፆሳ አ ኬሀተይ እያ ቦላ ደኤስ።<verse eid="LUK 2:40"/></para>
  <para style="s1">የሱሲ ፆሳ ኬን</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>ዮሰፋራነ ማይራምራ ፓስካ ባኣለ ቦንቻናዉ ላይን ላይን የሩሳላመ ቦሶና።<note caller="-" style="x"><char style="xo" closed="false">2:41 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ከሳ 12:1-27</ref>፤ <ref loc="DEU 16:1-8">ዛረ 16:1-8</ref>.</char></note> <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>የሱሳስ ታማነ ናምኡ ላይ ግድያ ዎደ ካሰ ሜዘትዳይሳዳ ባኣለ ቦንቻናዉ ብዶሶና። <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>ባልያ ቦንችዳፐ ጉየ ሶ ስምያ ዎደ ናአይ የሱሲ የሩሳላመን አትስ። ሽን ዮሰፋራነ ማይራምራ እ የሩሳላመን አቶይሳ ኤርቦኮና። <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>እ ሶ ስምያ አሳራ ዎላ ደእያ ዳንን ኤንቲ እስ ጋላሳ ኦገ ብዶሶና። እ ባይናይሳ ኤርዳፐ ጉየ ባንታ ዳቦታነ ላገታ ማታን ኮይዶሶና። <verse eid="LUK 2:44"/><verse number="45" style="v" sid="LUK 2:45"/>እ ያን ይን ኮይሸ ጉየ የሩሳላመ ጋካናዉ ብዶሶና።<verse eid="LUK 2:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 2:46"/>ሄ ጋላሳፐ ጉየ ፆሳ ኬን አስታማረታ ግዶን ኡትድ ኤንታባ ስእሸነ ኤንታ ኦይችሸ ደእሽን ደምዶሶና። <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>እያ ስእያ ኡባይ እያ አኬካንነ ዛሩዋን ማላለትዶሶና።<verse eid="LUK 2:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 2:48"/>ሶ አሳይ እያ ደምዳ ዎደ ማላለትዶሶና። እያ አያካ፥ “ታ ናአዉ፥ አይስ ኑና ሀይሳዳ ኦዲ? ነ አዋራነ ታራ ነና ኮይሸ ኡንኤትዳ” ያጋሱ።<verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>የሱሲ ኤንታኮ፥ “ታና አይስ ኮዬቲ? ታ፥ ታ አዋ ኬን ዳናዉ በሰይሳ ኤረከት” ያግስ። <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>ሽን እ ኤንታኮ ግዳባ ኤንቲ አኬክቦኮና።<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>ሄሳፈ ጉየ፥ ኤንታራ እስፈ ናዝረተ ካታማ ብስ። ኤንታዉ ኪተትሸ ደእስ። እያ አይያ ሄ ኡባ ባ ዎዛናን ዎዳ ናጋሱ። <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>የሱሲ፥ ጭንጫተን፥ ጌሳንነ ቴማን ፆሳ ስንንነ አሳ ስንን ድጭስ።<note caller="-" style="x"><char style="xo" closed="false">2:52 </char><char style="xt" closed="false"><ref loc="1SA 2:26">1 ሳሜ 2:26</ref>፤ <ref loc="PRO 3:4">ሌም 3:4</ref>.</char></note><verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s1">ፃማቅያ ዮሃንስ ኦገ ፕቴስ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ 3:1-12</ref>፤ <ref loc="MRK 1:1-8">ማር 1:1-8</ref>፤ <ref loc="JHN 1:19-28">ዮሀ 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>ካዎይ ፅባርዮስ ሮመ ቢታን ካዎትን፥ ታማነ እቻሻን ላይን፥ ጰንፀ ጵላፆስ ይሁዳ ሃርያ ዎደ፥ ሄሮዲስ ጋልላ ሃርያ ዎደ፥ እያ እሻ ፍልጶስ እፁርያሳነ ፅራኮንዶሳ ሃርያ ዎደ፥ ልሳንዮስ አብላንሳ ሃርያ ዎደ፥ <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/>ሃናራነ ቃያፋራ ካህነ ሀላቃ ግድ ደእሽን፥ ፆሳ ቃላይ ዛካርያሳ ናኣ ዮሃንሳኮ መላ ቢታ ይስ። <figure style="fig" alt="High priest" file="HK00267B.tif" size="col" ref="3:2">ካህነ ሀላቃ</figure> <verse eid="LUK 3:2"/><verse number="3" style="v" sid="LUK 3:3"/>ዮሃንስ፥ “ህንተ ናጋራፐ ስምተነ ፃማቀትተ። ፆሳይ ህንተ ናጋራ አቶ ጋና” ያግድ ታማርስሸ ዮርዳኖሰ ሻፋ ሄራን ደእያ ቢታ ኡባ ብስ። <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/>ሄስካ ናበይ እሳያስ ባ ማፃፋን፥<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="ISA 40:3-5">እሳ 40:3-5</ref>.</char></note></para>
  <para style="q1" vid="LUK 3:4">“መላ ቢታን ባ ቃላ ቁ ኦድ፥</para>
  <para style="q2" vid="LUK 3:4">ዋስያ ኡራ ቃላይ፥</para>
  <para style="q1" vid="LUK 3:4">‘ጎዳ ኦግያ ጊግስተ፥</para>
  <para style="q2" vid="LUK 3:4">ሆሮጋካ ፕድ ኦተ።<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>አፎ ኡባይ ኩማና፥</para>
  <para style="q2" vid="LUK 3:5">ዙማይነ ደረይ ዝቅ ጋና።</para>
  <para style="q1" vid="LUK 3:5">ዎበ ኦገይ ሉላና፥</para>
  <para style="q2" vid="LUK 3:5">ጊጎና ሆሮጋይ ቅንፅ ጋና።<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>አሾ ማእዳ ኡባይ፥</para>
  <para style="q2" vid="LUK 3:6">ፆሳ አሹዋ በአና’ ”</para>
  <para style="m" vid="LUK 3:6">ግድ ፃፍዳይሳዳ ሀንስ።<verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>ዮሃንስ፥ ባ ኩሸን ፃማቀታናዉ ይዳ አሳኮ፥ “ህንተኖ፥ ሾሻ ናይቶ ያናዉ ደእያ ሀንቁዋፈ አታና መላ ህንተና ዞርዳይ ኦኔ?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ 12:34</ref>፤ <ref loc="MAT 23:33">23:33</ref>.</char></note> <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>ህዛ፥ ህንተ ስሙዋ ቆንጭስያ ሎኦ ኦሶ ኦተ፥ ህንተ ዎዛናን፥ ‘ኑስ፥ ኑ አዋይ አብራሃመይ ደኤስ ግድ ጬቀቶፍተ።’ ሃ ስእተ፥ ሀ ሹቻታፐ ፆሳይ አብራሃመስ ናአ ከሳናዉ ዳንዳኤስ።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JHN 8:33">ዮሀ 8:33</ref>.</char></note> <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>ሄኮ፥ ቤፀይ ም ፃጶን ደኤስ። ህዛ፥ ሎኦ አይፈ አይፎና ም ኡባይ ቃንፀትድ ታማን የገታና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶ 7:19</ref>.</char></note><verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>አሳይ፥ “ያትን ኑኒ አይ ኦኖ?” ያግድ ኦይችዶሶና።<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>ዮሃንስ ዛሪድ፥ “ናምኡ አፍል ደእያ አስ ባይናይሳስ እሞ። ካ ደኤይስ ባይናይሳስ እሞ” ያግስ።<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>ቃራፃ ቃንፅሰይሳት ፃማቀታናዉ ይድ፥ “አስታማርያዉ፥ ኑኒ አይ ኦኖ?” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LUK 7:29">ሉቃ 7:29</ref>.</char></note><verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>እ ዛሪድ፥ “ህንተ ቃንፅሳናዉ ኪተቶይሳፈ አድ ኤኮፍተ” ያግስ። <verse eid="LUK 3:13"/><verse number="14" style="v" sid="LUK 3:14"/>ቃስ ዎታዳረት ይድ፥ “ኑኒ አይ ኦኖ” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="LUK 3:14">ዮሃንስ፥ “ኦደባካ ዎልቃን ዳፍድ ኤኮፍተ፥ ኦናካ ዎርዶን ሞቶፕተ፥ ህንተ ዳሞዘይ ህንተዉ ግዶ፤ ኡፋይትድ ደእተ” ያግስ።<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>አሳይ ክርስቶሳ ናግሸ ደእያ ግሾ፥ ዮሃንሳ፥ “እ ክርስቶሳ ግዳንደሻ?” ግድ ቆፕዶሶና። <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>ዮሃንስ ኡባስ ዛሪድ፥ “ታኒ ህንተና ሃን ፃማቃይስ፥ ሽን ታፐ አድ ዎልቃመይስ ያና። ታኒ እያ ጫማ ዎዶሩዋ ብላናዉ በሶና አስ። እ ህንተና ጌሻ አያናንነ ታማን ፃማቃና። <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>ዉዱማን ደእያ ካ ፖሎ ጌሻናዉ ፕይ እያ ኩሸን ደኤስ። ጌሻ ካ ባ ሻልያን ቆላና፤ ካልያ ዮና ታማን ፁጋና” ያግስ።<verse eid="LUK 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18"/>ቃስ ዮሃንስ አሳ ዳሮ ዞረ ዞርድ ዎንገላ<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="fq" closed="false">ዎንገላ፦ </char><char style="ft" closed="false">ግርከ ዶናን ዎንገላ ጌተትያ ቃላይ ዳሮ ኡፋይስያ ኦዳ ዎይኮ ምሽራቾ ጉሱ። ሄ ምሽራቾይካ ክርስቶስ አሳ ኮቸ ኡባ መርና ፕርዳፈ አሻናዉ ኪተትድ ይዳ ግታ ኡፋይሳ (ሉቃ 1:19፤ 2:10)።</char></note> ኦድስ።<verse eid="LUK 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19"/>ሽን ዮሃንስ ሄሮዲስ ባ እሻ ማችዉ፥ ሄሮድያዳ፥ ኤክዳ ግሾነ ሀራ ኢታ ኦሶታ ግሾ ሃንቄትዳ ዎደ፥<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="MAT 14:3-4">ማቶ 14:3-4</ref>፤ <ref loc="MRK 6:17-18">ማር 6:17-18</ref>.</char></note> <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>ሄሮዲስ ካሰይሳ ቦላ ሀራባ ኡባ ጉጅድ ዮሃንሳ ዎይነ ገልስስ።<verse eid="LUK 3:20"/></para>
  <para style="s1">የሱሳ ፃማቀተ</para>
  <para style="r">(<ref loc="MAT 1:1-17">ማቶ 1:1-17</ref>፤ <ref loc="MAT 3:13-17">3:13-17</ref>፤ <ref loc="MRK 1:9-11">ማር 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>ዮሃንስ ቃሸታናፐ ስን አሳ ኡባ ፃማቅድ ስምን፥ ቃስ የሱሲካ ፃማቀትስ። እ ዎስሽን ሳሎይ ዶየትስ። <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>ጌሻ አያናይ ሆለዳ በንትሸ እያ ቦላ ኡትስ። ሳሎፐ “ታኒ ዶስያ ናአይ ነና፤ ነ ታና ኡፋይሳሳ” ግያ ቃላይ ይስ።<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GEN 22:2">መ 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ 2:7</ref>፤ <ref loc="ISA 42:1">እሳ 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ 3:17</ref>፤ <ref loc="MRK 1:11">ማር 1:11</ref>፤ <ref loc="LUK 9:35">ሉቃ 9:35</ref>.</char></note><verse eid="LUK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>የሱሲ ታማርሶ ኦይክያ ዎደ እያዉ ሀስታሙ ላይ ግድሽን፥ አሳይ እያ ዮሰፋ ናአ ግድ ቆፕስ።</para>
  <para style="q1" vid="LUK 3:23">ዮሰፍ ኤለ ናአ፥ <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>ኤለይ ማታ ናአ፥</para>
  <para style="q1" vid="LUK 3:24">ማት ሌወ ናአ፥ ሌወይ ማልካ ናአ፥</para>
  <para style="q1" vid="LUK 3:24">ማልክ ዮና ናአ፥ ዮን ዮሰፋ ናአ፥<verse eid="LUK 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 3:25"/>ዮሰፍ ማታታ ናአ፥ ማታት አሞፀ ናአ፥</para>
  <para style="q1" vid="LUK 3:25">አሞፀይ ናሆመ ናአ፥ ናሆመይ አስሊመ ናአ፥</para>
  <para style="q1" vid="LUK 3:25">አስሊመይ ናገ ናአ፥ <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>ናገይ ማኣተ ናአ፥</para>
  <para style="q1" vid="LUK 3:26">ማኣተይ ማታታ ናአ፥ ማታት ሳማየ ናአ፥<verse eid="LUK 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LUK 3:27"/>ሳማየይ ይሁዳ ናአ፥ ይሁድ ዮናና ናአ፥ ዮናነይ ራሰ ናአ፥</para>
  <para style="q1" vid="LUK 3:27">ራሰይ ዛሩባበላ ናአ፥ ዛሩባበል ሳላትያላ ናአ፥</para>
  <para style="q1" vid="LUK 3:27">ሳላትያል ኔራ ናአ፥ <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>ኔር ማልካ ናአ፥</para>
  <para style="q1" vid="LUK 3:28">ማልክ ሀደ ናአ፥ ሀድ ቆሳማ ናአ፥</para>
  <para style="q1" vid="LUK 3:28">ቆሳም ኤልሞዳና ናአ፥ ኤልሞዳን ኤራ ናአ፥<verse eid="LUK 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 3:29"/>ኤር ዮሰአ ናአ፥ ዮሰእ አላዛራ ናአ፥</para>
  <para style="q1" vid="LUK 3:29">አላዛር ዮራመ ናአ፥ ዮራመይ ማታ ናአ፥</para>
  <para style="q1" vid="LUK 3:29">ማታ ሌወ ናአ፥ <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>ሌወይ ስሞና ናአ፥</para>
  <para style="q1" vid="LUK 3:30">ስሞን ይሁዳ ናአ፥ ይሁድ ዮሰፋ ናአ፥</para>
  <para style="q1" vid="LUK 3:30">ዮሰፍ ዮናና ናአ፥ ዮናነይ ኤልያቄመ ናአ፥<verse eid="LUK 3:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 3:31"/>ኤልያቄም ማልያ ናአ፥ ማልይ ማይናነ ናአ፥</para>
  <para style="q1" vid="LUK 3:31">ማይናነይ ማታ ናአ፥ ማት ናታና ናአ፥</para>
  <para style="q1" vid="LUK 3:31">ናታን ዳዊታ ናአ፥ <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/>ዳዊቲ እሰየ ናአ፥</para>
  <para style="q1" vid="LUK 3:32">እሰየይ እዮቤዳ ናአ፥ እዮቤድ ቦኤዛ ናአ፥</para>
  <para style="q1" vid="LUK 3:32">ቦኤዝ ሳልሞና ናአ፥ ሳልሞና ናአሶና ናአ፥<verse eid="LUK 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LUK 3:33"/>ናአሶን አምናዳበ ናአ፥ አምናዳበይ ራመ ናአ፥ ራመይ አርነ ናአ፥</para>
  <para style="q1" vid="LUK 3:33">አርነይ አስሮመ ናአ፥ <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>አስሮመይ ፋረሳ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">ፋረስ ይሁዳ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">ይሁድ ያይቆባ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">ያይቆብ ይሳቃ ናአ፥ ይሳቅ አብራሃመ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">አብራሃመይ ታራ ናአ፥ <verse eid="LUK 3:34"/><verse number="35" style="v" sid="LUK 3:35"/>ታር ናኮራ ናአ፥</para>
  <para style="q1" vid="LUK 3:35">ናኮረይ ሳሩጋ ናአ፥ ሳሩግ ረሁ ናአ፥</para>
  <para style="q1" vid="LUK 3:35">ረሁይ ፋለቃ ናአ፥ ፋለቅ ኤቤራ ናአ፥</para>
  <para style="q1" vid="LUK 3:35">ኤቤሮይ ሴላ ናአ፥ <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>ሴል ቃይናማ ናአ፥</para>
  <para style="q1" vid="LUK 3:36">ቃይናም አርፋክሳደ ናአ፥ አርፋክሳድ ሴማ ናአ፥</para>
  <para style="q1" vid="LUK 3:36">ሴም ኖሄ ናአ፥ ኖሄይ ላመሀ ናአ፥<verse eid="LUK 3:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="LUK 3:37"/>ላመህ ማቱሳላ ናአ፥ ማቱሳል ሄኖከ ናአ፥</para>
  <para style="q1" vid="LUK 3:37">ሄኖከይ ያረዳ ናአ፥ ያረድ ማላልኤላ ናአ፥</para>
  <para style="q1" vid="LUK 3:37">ማላልኤል ቃይናና ናአ፥ <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>ቃይናን ሄኖሳ ናአ፥</para>
  <para style="q1" vid="LUK 3:38">ሄኖስ ሴታ ናአ፥ ሴት አዳመ ናአ፥</para>
  <para style="q1" vid="LUK 3:38">አዳመይ ፆሳ ናአ።<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s1">የሱሲ ፓጨተ</para>
  <para style="r">(<ref loc="MAT 4:1-11">ማቶ 4:1-11</ref>፤ <ref loc="MRK 1:12-13">ማር 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>የሱሲ ጌሻ አያናን ኩምድ ዮርዳኖሰ ሻፋፐ ስምዳ መላ አያናይ እያ መላ ብታ ኤፍስ። <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>ያን ኦይታሙ ጋላስነ ቃማ ፃላሄን ፓጨትስ። ሄ ጋላሳታን አይኮካ ሞና ጋምእዳ ግሾ ዉርሰን ኮሻትስ።<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>ፃላሄይ እያኮ፥ “ኔኒ ፆሳ ናአ ግድኮ አነ ሀይስ ሹቻይ ኡይ ግዶ ጋዳ ኪታ” ያግስ።<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>የሱሲ ዛሪድ፥ “አስ ኡይ ፃላላን ዴና ጌተትድ ፃፈትስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ዛረ 8:3</ref>.</char></note><verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>ሄሳፈ ጉየ፥ ፃላሄይ የሱሳ አዱሳ ደረ ቦላ ከስድ ሀ አላምያ ካዎተታ አይፈ ቅጵ ዛራናዉ በስስ። <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>ፃላሄይ፥ “ሀ ኡባስ ማታይነ ቦንቾይ ታዉ እመትስ። ታኒ ዶስዳ ኦደስካ እምያ ግሾ ነዉ እማና። <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>ሄሳ ግሾ፥ ኔኒ ታዉ ጎይንኮ ኡባይ ነዉ ግዳና” ያግስ።<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>የሱሲ ዛሪድ፥ “ነ ጎዳ፥ ነ ፆሳ፥ እያ ፃላላ ጎይና ጌተትድ ፃፈትስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ዛረ 6:13</ref>.</char></note><verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9"/>ዉርሰን ፃላሄይ የሱሳ የሩሳላመ ኤፍድ ፆሳ ኬስ ሁጵያ ቦላ ኤስድ፥ “ኔኒ ፆሳ ናአ ግድኮ አነ ዱገ ሳአን ነና የጋ። <verse eid="LUK 4:9"/><verse number="10" style="v" sid="LUK 4:10"/>አይስ ጊኮ፥</para>
  <para style="q1" vid="LUK 4:10">“ ‘ነና ናግያ ኪታንቾታ</para>
  <para style="q2" vid="LUK 4:10">ፆሳይ ነ ግሾ ኪታና።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">ማዝ 91:11-12</ref>.</char></note><verse eid="LUK 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11"/>ኤንቲ ነ ቶሆይ ሹቻን በቶና መላ፥</para>
  <para style="q2" vid="LUK 4:11">ባንታ ኩሽያን ቁ ኦድ ነና ደንና’ ጌተትድ ፃፈትስ”</para>
  <para style="m" vid="LUK 4:11">ያግስ።<verse eid="LUK 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>የሱሲ ዛሪድ፥ “ነ ጎዳ ፆሳ ፓጮፋ ጌተትድ ፃፈትስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="DEU 6:16">ዛረ 6:16</ref>.</char></note><verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>ፃላሄይ የሱሳ ፓጭያ ዉርስዳፐ ጉየ ሀራ እንጀ ዎደ ደማና ጋካናዉ እያፐ ሻከትስ።<verse eid="LUK 4:13"/></para>
  <para style="s1">የሱሲ ጋልላን ታማርሶ ዶመ</para>
  <para style="r">(<ref loc="MAT 4:12-17">ማቶ 4:12-17</ref>፤ <ref loc="MRK 1:14-15">ማር 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>የሱሲ አያና ዎልቃን ኩምድ ጋልላ ስምስ። እያ ሱንይ ሄራን ደእያ ቢታ ኡባን ከይስ። <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>እ አይሁደ ዎሳ ኬ ገልድ ታማርስስ፤ አሳ ኡባይ እያ ጋላትዶሶና።<verse eid="LUK 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>ያፐ እ ድጭዳ ካታማ ናዝረተ ይስ። ካሰ ሜዘትዳይሳዳ ሳምባታ ጋላስ አይሁደ ዎሳ ኬ ገልስ። ናባባናዉካ ደንድ ኤቅስ። <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>ናብያ እሳያሳ ማፃፋይ እያዉ እመትን፥ ዶይድ፥ ሀይሳዳ ያግድ ፃፈትዳይሳ ደምስ፦<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18"/>“ጎዳ አያናይ ታ ቦላ ደኤስ፥</para>
  <para style="q2" vid="LUK 4:18">ማንቆታስ ዎንገላ ኦዳና መላ</para>
  <para style="q2" vid="LUK 4:18">ፆሳይ ታና ዶርስ።</para>
  <para style="q1" vid="LUK 4:18">ቃሸትዳይሳታስ ብለተ፥</para>
  <para style="q2" vid="LUK 4:18">ቆቅዳይሳታ ፄልሳናስነ</para>
  <para style="q2" vid="LUK 4:18">ኡንኤትዳይሳታ ብርሻና መላ፥<note caller="-" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="ISA 61:1-2">እሳ 61:1-2</ref>.</char></note><verse eid="LUK 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LUK 4:19"/>ፆሳይ ኬሀናዉ ቆፕዳ ላይ ኦዳና መላ ታና ኪትስ”</para>
  <para style="m" vid="LUK 4:19">ያግስ።<verse eid="LUK 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>ሄሳፈ ጉየ፥ ማፃፋ ፃፅድ ሀጋዘይሳስ እምድ ታማርሳናዉ ኡትስ። አይሁደ ዎሳ ኬን ደእያ አሳት ኡባይ ጫድ ፄሎሶና። <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>እ፥ “ሀይስ ህንተ ሀይን ህንተ ስእያ ሀ ማፃፋ ቃላይ ሀች ፖለትስ” ያግስ።<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>ኡባይ እያባ ዳርስድ ኦደቶሶና። ቃስ እያ ዶናፐ ከይያ አ ኬሀተን ኩምዳ ቃላን ማላለትሸ፥ “ሀይስ ዮሰፋ ናኣ ግደነዬ?” ያግዶሶና።<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>እ፥ “ ‘ነኖ ለ አዋዉ ነና አሻ፥ ቅፍርናሆማን ነ ኦዳባ ኑ ስኦይሳ ቃስ ሀይሳን ነ ካታማን ኦ’ ግያ ሌምሱዋን ህንተ ታና ጋናይሳስ ስይ ባዋ” ያግስ። <verse eid="LUK 4:23"/><verse number="24" style="v" sid="LUK 4:24"/>ቃስ፥ “ቱማ ኦዳይስ፤ ናበይ ባ የለትዳ ቢታን ቦንቸተና።<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ዮሀ 4:44</ref>.</char></note><verse eid="LUK 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 4:25"/>“ታ ህንተዉ ቱማ ኦዳይስ፤ ሳሎይ ሄ ላይነ ባጋ ጎርደትን ምኖ ኮሽ ቢታ ኡባን ደእያ ኤልያሳ ዎደ ዳሮ አምኤት እስራኤለን ደኦሶና።<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ካዎ 17:1</ref>.</char></note> <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/>ኤልያስ ኤንታፈ እስነኮካ ኪተትቤና። ሽን ሳራፕታን ደእያ አምኤኮ ኪተትስ።<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="1KI 17:8-16">1 ካዎ 17:8-16</ref>.</char></note> <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/>ናብያ ኤልሳ ዎደ እስራኤለን ዳሮ ባሮ ሀርጋንቾት ደኦሶና። ሽን ሶረ ኡራ ንእማነፐ አትሽን፥ ኦንካ ፓፅቤና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">2 ካዎ 5:1-14</ref>.</char></note><verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>አይሁደ ዎሳ ኬን ደእያ አሳ ኡባይ ሄሳ ስእዳ ዎደ ዳሮ ይሎትዶሶና። <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>ባንታ ኡትዳ በሳፈ ደንድድ ደረ ቦላ ኬፀትዳ ካታማፐ ጋፃ ከስድ ሱግ የዳናዉ አፎ ዶና ኤፍዶሶና። <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>ሽን እ ኤንታ ግዶራ ካንድ አስ።<verse eid="LUK 4:30"/></para>
  <para style="s1">የሱሲ ቱና አያና ከስስ</para>
  <para style="r">(<ref loc="MRK 1:21-28">ማር 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>ያፐ ጋልላ ቢታን ደእያ ቅፍርናሆማ ካታማ ብስ። ያን ሳምባታ ጋላስ አሳ ታማርስስ። <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>እ ታማርሰይ ማታራ ግድያ ግሾ ኡባይ እያ ትምርትያን ማላለትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">ማቶ 7:28-29</ref>፤ <ref loc="PSA 91:11-12">ማዝ 91:11-12</ref>.</char></note><verse eid="LUK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33"/>አይሁደ ዎሳ ኬን ቱና አያናይ ኦይክዳ ኡራይ ደኤስ። <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>እ፥ “ናዝረተ የሱሳ ኑና አይስ ዋይሳይ ኑፐ ሃካ፤ ኔኒ ይዳይ ኑና ይሳናሰዬ? ኔኒ ኦነኮ ታኒ ኤራይስ። ኔኒ ፆሳፈ ይዳ ጌሻ” ያግድ ዋስስ።<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>የሱሲ ቱና አያናኮ፥ “ስእ ጋዳ ሀ ኡራፐ ከያ” ያግድ ሀንቅስ። ቱና አያናይ ኡራ አሳ ኡባ ስንን ሆል የግድ አይኮካ ቆሆና የድድ ከይስ።<verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>አሳ ኡባይ ማላለትዶሶና። ዎልኮ፥ “ሀኖስ፥ ሀይስ አይብ ትምርቴ? ቱና አያናታ ማታንነ ዎልቃን ኪቴስ፤ ኤንትካ ከዮሶና” ያግዶሶና። <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>እያ ሱንይ ሄራ ኡባን ከይስ።<verse eid="LUK 4:37"/></para>
  <para style="s1">የሱሲ ዳሮ ሀርጋንቾታ ፓስ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ 8:14-17</ref>፤ <ref loc="MRK 1:29-34">ማር 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>ሄሳፈ ጉየ፥ የሱሲ አይሁደ ዎሳ ኬፈ ከይድ ስሞና ሶ ገልስ። ስሞና ማቸ አይያ ምኖ ቆፆ ምሻ ሀርገን ሳከታሱ። እዮ ፓና መላ የሱሳ ዎስዶሶና። <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>እ ሂፃኮ ሺቅ ሆክድ እ ሀርግያ ሀንቅስ። ምሻይ አግን ኤለሳ ደንዳዳ ኤንታ ሞካሱ።<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>አዋይ ዉላና ሀንሽን ዱማ ዱማ ሀርግያን ኦይከትዳ አሳ እያኮ ኤህዶሶና። እ እሱዋ እሱዋ ቦላ ባ ኩሽያ ዎድ ፓስ። <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>ቱና አያናት ቃስ፥ “ኔኒ፥ ፆሳ ናኣ” ግድ ዋስሸ ዳሮ አሳፐ ከይዶሶና። ሽን እ ኤንታና ሀንቅስ። እ ክርስቶሳ ግደይሳ ኤንቲ ኤርያ ግሾ፥ እስባካ ኦደቶና መላ ድግስ።<verse eid="LUK 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>ቡሮ ዎንትያ ዎደ የሱሲ እስ ጌማ በሲ ብስ። አሳይ ኮይሸ እ ደእያ በሳ ይዶሶና። ኤንታፈ እ ሻከትድ ቦና መላ ድጋናዉ ኮይዶሶና። <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>ሽን እ፥ “ታኒ ሀራ ካታማታ ባዳ ፆሳ ካዎተ ዎንገላ ማርካታናዉ በሴስ። ታ ኪተትዳይ ሄሳሳ” ያግስ። <verse eid="LUK 4:43"/><verse number="44" style="v" sid="LUK 4:44"/>ይሁዳ ቢታን ደእያ አይሁደ ዎሳ ኬን ሳባክስ።<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s1">ኮይሮ ታማረታ ፄገ</para>
  <para style="r">(<ref loc="MAT 4:18-22">ማቶ 4:18-22</ref>፤ <ref loc="MRK 1:16-20">ማር 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>እስ ጋላስ የሱሲ ገንሳሬፀ አባ ማታን ኤቅዳሽን ዳሮ አሳይ እያ ዩሹዋ ኡንኤድ፥ እ ታማርስያ ፆሳ ቃላ ስኦሶና።<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="MAT 13:1-2">ማቶ 13:1-2</ref>፤ <ref loc="MRK 3:9-10">ማር 3:9-10</ref>፤ <ref loc="MRK 4:1">4:1</ref>.</char></note> <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/>ያን ሃ ጋፃን ደእያ ናምኡ ዎጎሎታ በእስ። ሞሎ ኦይክያ አሳት ዎጎሎታፐ ዎድ ባንታ ግትያ ሜጮሶና። <figure style="fig" alt="Fisher men in their fishing boat" file="HK00208B.tif" size="span" ref="5:2">ሞሎ ኦይክያ አሰ</figure> <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>ሄ ዎጎሎታፐ ስሞናይሳን ገልድ ቢታፈ ጉ ግዶ ሺሻና መላ ኦይችስ። ያትድ፥ ሄ ዎጎሉዋ ቦላ ኡትድ አሳ ታማርስስ።<verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>ባ ትምርትያ ኦንግዳፐ ጉየ ስሞናኮ፥ “ገደ ጪሙዋኮ ሺሻዳ ሞሉዋ ኦይካናዉ ህንተ ግትያ የግተ” ያግስ።<verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>ስሞን ዛሪድ፥ “አስታማርያዉ፥ ቃማ ኩመ ዳቡርሸ አቅድ አይኮካ ኦይክቦኮ፥ ሽን ነ ጊኮ ግትያ የጋና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="JHN 21:3">ዮሀ 21:3</ref>.</char></note><verse eid="LUK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6"/>ኤንቲ ግትያ የግዳ ዎደ ግተይ ዳከታና ጋካናዉ ዳሮ ሞሎ ኦይክዶሶና።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="JHN 21:6">ዮሀ 21:6</ref>.</char></note> <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>ሀራ ዎጎሎን ደእያ ባንታ ላገት ይድ፥ ባንታና ማዳና መላ ዉትድ ፄግዶሶና። ኤንቲ ይድ ናምኡ ዎጎሎት፥ ሃን ምተታና ጋካናዉ ሞሎን ኩንዶሶና።<verse eid="LUK 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8"/>ስሞን ጰፅሮስ ሄሳ በእዳ ዎደ፥ የሱሳ ስንን ኩንድድ፥ “ጎዳዉ፥ ታኒ ናጋራንቾ አስ ግድያ ግሾ፥ ታፐ ሻከታ” ያግስ። <verse eid="LUK 5:8"/><verse number="9" style="v" sid="LUK 5:9"/>እ ሄሳ ግዳይ፥ እነ እያራ ደኤይሳት ኦይክዳ ሞሉዋ ዳሮተን ማላለትዳ ግሾሳ። <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>ቃስ ስሞና ላገ ግድዳ ዛብድዮሳ ናይት ያይቆባራነ ዮሃንሳራ ማላለትዶሶና። የሱሲ ስሞናኮ፥ “ባቦፋ! ህዛፐ ኔኒ አሰ ኦይክያ አስ ግዳና” ያግስ። <verse eid="LUK 5:10"/><verse number="11" style="v" sid="LUK 5:11"/>ኤንቲ ዎጎሎታ ጋፃ ሺሽዳፐ ጉየ ኡባ አግድ የሱሳ ካልዶሶና።<verse eid="LUK 5:11"/></para>
  <para style="s1">ባሮ ሀርጋንቾይ ፓፅስ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶ 8:1-4</ref>፤ <ref loc="MRK 1:40-45">ማር 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>የሱሲ ካታማታፐ እሱዋን ደእሽን እስ ባሮ ሀርገን<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="fq" closed="false">ባሮ ሀርገ፦ </char><char style="ft" closed="false">ባሮ ሀርገይ አሳ ጋልባ ቦላ ከይያ ሀርገ። እስራኤለ ቢታን ባሮ ሀርጋንቾት ሀራ አሳፐ ዱማትድ ደኦሶናፐ አትሽን፥ አሳራ ጋሄቶኮና።</char></note> ኦይከትዳ አስ ሄ ካታማን ደኤስ። ሄ ኡራይ የሱሳ በእድ እያ ስንን ጉፋንድ፥ “ጎዳዉ፥ ነ ሸነ ግድኮ ታና ጌሻናዉ ዳንዳኣሳ” ግድ ዎስስ።<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>የሱሲ ባ ኩሽያ የድ ቦችድ፥ “ኤ፥ ታ ሸነ፤ ጌይያ” ያግስ። ኢራ ባሮ ሀርገይ ኡራፐ ክችስ።<verse eid="LUK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14"/>የሱሲ፥ “ሀይሳ ኦደስካ ኦዶፓ፥ ሽን ባዳ ነናተ አይሁደ ካህነ በሳ። ነ ጌይዳይሳስ ማርካ ግዳና መላ ሙሰይ ኪትዳ ያርሾ ያርሻ” ግድ ኪትስ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ሌወ 14:1-32</ref>.</char></note><verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>ግዶሽን፥ እያ ሱንይ ካሰፐ አድ ኤረትሸ ብስ። ዳሮ አሳይ እ ኦድያባ ስአናዉነ ባንታ ሀርግያፈ ፓፃናዉ ዮሶና። <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>ሽን የሱሲ ዳሮ ዎደ ጌማ በሲ ብድ ዎሴስ።<verse eid="LUK 5:16"/></para>
  <para style="s1">ጉንዳ ኡራ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቶ 9:1-8</ref>፤ <ref loc="MRK 2:1-12">ማር 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>እስ ጋላስ የሱሲ ታማርስሽን ጋልላፐነ ይሁዳ ሄራ ኡባፈ ቃስ የሩሳላመፐ ይዳ ፋርሳወትነ ህገ አስታማረት ያን ኡትዶሶና። አሳ ፓያ ጎዳ ዎልቃይካ እያራ ደኤስ። <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>ሄ ዎደ አሳይ እስ ጉንዳ አስ ሀላራ ቶክድ ኤህዶሶና። ሶ ገልስድ እያ ስንን ዎናዉ ቆፕዶሶና። <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>ሽን አሳ ዳሮተፈ ደንዶይሳን ሶ ገልሳናዉ ፆነትድ ኬ ቦላ ከይድ፥ ካራ ቃዉፅድ፥ ሀርጋንቹዋ ሀላራ አሳ ሻክድ የሱሳ ስንን የግዶሶና።<verse eid="LUK 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20"/>የሱሲ ኤንታ አማኑዋ በእድ፥ “ላ አድያዉ፥ ነ ናጋራይ አቶ ጌተትስ” ያግስ።<verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>ህገ አስታማረትነ ፋርሳወት፥ “ሀይስ ፆሳ ቦላ ያግድ ኦደተይ ኦኔ? እስ ፆሳፈ አትሽን፥ ሀር ናጋራ አቶ ጋናዉ ዳንዳኤይ ኦኔ?” ያግድ ቆፕዶሶና።<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>የሱሲ ኤንታ ቆፋ ኤርዳ ግሾ ኤንታኮ፥ “ህንተ ዎዛናን ሄሳ አይስ ቆፔቲ? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>‘ነ ናጋራይ ቁሸትስ ገይሳፈነ ደንዳዳ ባ ገይሳፈ አዉስ ካዉዪ?’ <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>ሽን ታ ሄሳ ግዳይ አሳ ናእ ሳአ ቦላ ናጋራ አቶ ጋናዉ ማት ደኤይሳ ህንተ ኤራና መላሳ።” ሄሳፈ ካልድ፥ ጉንዳ ኡራኮ፥ “ደንዳ፤ ነ አልጋ ቶካዳ ነ ሶ ባ” ያግስ። <verse eid="LUK 5:24"/><verse number="25" style="v" sid="LUK 5:25"/>እ ኤለስ ደንድድ ኤንታ ስንን ኤቅስ፤ እ ቶከትድ ይዳ አልጋ ቶክድ ፆሳ ጋላትሸ ባ ሶ ብስ። <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>ሄ ዎደ ኡባይካ ማላለትዶሶና። ፆሳ ጋላትሸ፥ “ሀች ግታ ማላታ በእዳ” ያግድ ያሸትዶሶና።<verse eid="LUK 5:26"/></para>
  <para style="s1">ሌወ ፄገተ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶ 9:9-13</ref>፤ <ref loc="MRK 2:13-17">ማር 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>ሄሳፈ ጉየ፥ የሱሲ ያፐ ከይድ ብስ። ሌወ ጌተትያ እስ ቃራፃ ቃንፅሰይስ ቃራፃ ቃንፅስያ በሳን ኡትዳይሳ በእድ፥ “ታና ካላ” ያግስ። <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>እ ኡባባ አግድ፥ ደንድድ እያ ካልስ።<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>ሄ ሌወይ ባ ሶን ግታ ግብራ ጊግስስ። ዳሮ ቃራፃ ቃንፅሰይሳትነ ሀራ አሳት ካ ቦላ ኡትዶሶና። <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>ፋርሳወትነ ህገ አስታማረት፥ “ቃራፃ ቃንፀይሳታራነ ናጋራንቾታራ አይስ ሜትነ ኡዬቲ?” ያግድ የሱሳ ታማረታ ቦላ ዙዙምዶሶና።<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">ሉቃ 15:1-2</ref>.</char></note><verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>የሱሲ ኤንታኮ፥ “ሀርጋንቾታሳፈ አትሽን፥ ፓፃታስ አክመ ኮሸና። <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>ታኒ ናጋራንቾታ ማሮታኮ ዛራናሳፈ አትሽን፥ ጌሻታ ፄጋናዉ ያቢከ” ያግድ ዛርስ።<verse eid="LUK 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>ኤንቲ የሱሳኮ፥ “ዮሃንሳ ታማረት ዳሮ ዎደ ፆሞሶና፥ ዎሶሶና፤ ቃስ ፋርሳወታ ታማረትካ ሄሳ ኦሶና። ሽን ነይሳት ኡባ ዎደ ሞሶናነ ኡዮሶና” ያግዶሶና።<verse eid="LUK 5:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34"/>የሱሲ ኤንታኮ፥ “ማችዉ ኤከይስ ኤንታራ ደእሽን ፄገትዳ አሳይ ፆማና መላ ኦናዉ ዳንዳኤቲ? <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>ሽን ሙሹራይ ኤንታፈ ሻከታና ጋላሳይ ያና፥ ሄ ዎደ ኤንቲ ፆማና።”<verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>ቃስ ያግድ ሌምሶ ኦድስ፤ “ኦራ ማኦፐ ፔድ ጋልአ ማኦ ቦላ ስከይ ኦንካ ባዋ። ሄሳ ኦኮ ኦራ ማኡዋ ፔስ፥ ኦራይ ጋልኣስ ጊገና። <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>ማልአንቶ ዎይነ ጋልአ ኦጎሮን ቆልያ ኦንካ ባዋ። ሄሳ ኦኮ፥ ኦራ ዎይነይ ጋልአ ኦጎሩዋ ሴስ፤ ዎይነይ ጉኬስ ኦጎሮይካ ማዶናባ ግዴስ። <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>ሄሳ ግሾ፥ ኦራ ዎይነይ ኦራ ኦጎሮን ቆለታናዉ በሴስ። <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>ህዛ፥ ጫላይ ሎኦ ግያ ግሾ፥ ጫላ ዎይነ ኡይ ስሚድ ማልአንቶ ኮየይ ኦንካ ባዋ” ያግስ።<verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s1">ሳምባታ ቦንቻናዉ በሲ?</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶ 12:1-8</ref>፤ <ref loc="MRK 2:23-28">ማር 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>እስ ሳምባታ ጋላስ የሱሲ ግስተ ጋደ ግዶራ አስ። የሱሳ ታማረት ትያ ባንጋ ዱድ ባንታ ኩሸን ሽርክድ ሞሶና።<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ዛረ 23:25</ref>.</char></note> <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>ሽን ፋርሳወታ ግዶፈ እሶት እሶት፥ “ሳምባታ ጋላስ ኦናዉ በሶናባ አይስ ኦቲ?” ያግዶሶና።<verse eid="LUK 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3"/>የሱሲ ኤንታኮ ዛሪድ፥ “ዳዊቲ ኮሻትዳ ዎደ ባራ ደኤይሳታራ እስፈ ኦይሳ ናባብበከቲ?<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳሜ 21:1-6</ref>.</char></note> <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>ፆሳ ኬ ገልድ አይሁደ ካህነታ ፃላላስ በሲያ ዳቡዋ ምስ፤ ባራ ደኤይሳታስካ እሚስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌወ 24:9</ref>.</char></note> <verse eid="LUK 6:4"/><verse number="5" style="v" sid="LUK 6:5"/>ቃስ የሱሲ፥ “አሳ ናአይ ሳምባታ ጎዳ” ያግስ።<verse eid="LUK 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>ሀራ ሳምባታ ጋላስ የሱሲ አይሁደ ዎሳ ኬ ገልድ ታማርሴስ። ሄ በሳን ኡሻቻ ኩሸይ ስልዳ እስ አስ ደኤስ። <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>ህገ አስታማረትነ ፋርሳወት እያ ሞታናዉ ጋሶ ኮይድ ሳምባታ ጋላስ ፓኮ በአና ግድ ናጎሶና። <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>ሽን የሱሲ ኤንታ ቆፋ ኤርድ ኩሸይ ስልዳ ኡራኮ፥ “ደንዳዳ አሳ ግዶን ኤቃ” ያግስ። ኡራይካ ደንድ ኤቅስ።<verse eid="LUK 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9"/>የሱሲ፥ “አነ ታ ህንተና እስባ ኦይቻይስ፤ ሳምባታ ጋላስ ኦናዉ በሰይ ሎኦባየየ ኢታባዬ? ሸምፖ አሾየ ዎይኮ ይሶ?” ያግስ።<verse eid="LUK 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10"/>ቃስ የሱሲ እያ ዩሹዋን ደእያ አሳ ዩሽ ፄልድ ኡራኮ፥ “ነ ኩሽያ ፕድ ኦ” ያግስ። ኡራይካ እ ግዳይሳዳ ኦን ኩሸይ ፓፅስ። <verse eid="LUK 6:10"/><verse number="11" style="v" sid="LUK 6:11"/>ሽን ህገ አስታማረትነ ፋርሳወት ዳሮ ይሎትዶሶና። የሱሳ ቦላ አይ ኦኖ ግድ ባንታ ግዶን ማቀትዶሶና።<verse eid="LUK 6:11"/></para>
  <para style="s1">ታማነ ናምኡ ሀዋረታ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶ 10:1-4</ref>፤ <ref loc="MRK 3:13-19">ማር 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>ሄ ዎደ ጋላሳታፐ እሱዋን የሱሲ ዎሳናዉ ዙማ ቦላ ከይስ። ቃማ ኩመ ዎስሸ አቅስ። <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>ዎንተ ባ ታማረታ ፄግድ ኤንታ ግዶፈ ታማነ ናምአታ ዶርድ፥ ኤንታና፥ “ሀዋረታ” ግድ ሱንስ። <verse eid="LUK 6:13"/><verse number="14" style="v" sid="LUK 6:14"/>ኤንትካ፥ ጰፅሮሳ ግድ ሱንዳ ስሞና፥ እያ እሻ እንድርያሳ፥ ያይቆባ፥ ዮሃንሳ፥ ፍልጶሳ፥ ባርተለሞሳ፥ <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/>ማቶሳ፥ ቶማሳ፥ እልፍዮሳ ናኣ ያይቆባ፥ ባ ቢታስ ምሸትያ ስሞና፥ <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/>ያይቆባ ናኣ ይሁዳነ የሱሳ አድ እምዳ አስቆሮታ ይሁዳ።<verse eid="LUK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>የሱሲ ኤንታራ እስፈ ዙማፐ ዎድ ደምባ በሳን ኤቅስ። እያ ታማረታፐ ዳሮት ሄ በሳን ደኦሶና። ይሁዳ ቢታ ኡባፈ የሩሳላመፐ፥ ፅሮሳፐነ ስዶና አባ ጋፃፐ ይዳ ዳሮ አሳይ ደኤስ። <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>ኤንቲ ይዳይ፥ እ ታማርስያባ ስአናዉነ ባንታ ሀርግያፈ ፓፃናሳ። ቱና አያናን ዋየትያ አሳትካ ፓፅዶሶና። <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>ዎልቅ እያፐ ከይድ አሳ ኡባ ፓያ ግሾ አሳይ እያ ቦቻናዉ ኮዮሶና።<verse eid="LUK 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>ባ ታማረታ ፄልድ ሀይሳዳ ያግስ፦</para>
  <para style="q1" vid="LUK 6:20">“ህንተኖ፥ ማንቆቶ፥ ህንተ አንጀትዳይሳታ፤</para>
  <para style="q2" vid="LUK 6:20">ፆሳ ካዎተይ ህንተሳ።<verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>ህንተ ሀእ ኮሻተይሳት አንጀትዳይሳታ፥</para>
  <para style="q2" vid="LUK 6:21">ህንተ ካላና።</para>
  <para style="q1" vid="LUK 6:21">ህንተ ሀእ ዬከይሳት አንጀትዳይሳታ</para>
  <para style="q2" vid="LUK 6:21">ህንተ ሚጫና።<verse eid="LUK 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22"/>አሳይ ህንተና አሳ ናኣ ግሾ፥</para>
  <para style="q2" vid="LUK 6:22">እፅያ ዎደ፥</para>
  <para style="q2" vid="LUK 6:22">ህንተና ህልያ ዎደ፥</para>
  <para style="q2" vid="LUK 6:22">ህንተና ኤንቲ ቶችያ ዎደነ፥</para>
  <para style="q2" vid="LUK 6:22">ኢታ ሱን ኤንቲ ህንተዉ እምያ ዎደ</para>
  <para style="q2" vid="LUK 6:22">ህንተ አንጀትዳይሳታ።<note caller="-" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="PRO 4:14">ሌም 4:14</ref>.</char></note><verse eid="LUK 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23"/>“ሄኮ፥ ህንተ ዎይቶይ ሳሎን ግታ ግድያ ግሾ ሄ ዎደ ኡፋይሳን ጉፕተ። አይስ ጊኮ፥ በን ኤንታ አዋት ናበታ ቦላ ሄሳዳ ኦዶሶና።”<note caller="-" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 ታር 36:16</ref>፤ <ref loc="ACT 7:52">ሀዋ 7:52</ref>.</char></note><verse eid="LUK 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>“ሽን ዱረቶ ህንተና አየ!</para>
  <para style="q2" vid="LUK 6:24">ህንተ ሀእ ሎኦ ዱሳ ኤክደታ።<verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>ሀእ ካልዳይሳቶ ህንተና አየ!</para>
  <para style="q2" vid="LUK 6:25">ህንተ ኮሻታና።</para>
  <para style="q1" vid="LUK 6:25">ሀእ ሚጨይሳቶ ህንተኖሾ</para>
  <para style="q2" vid="LUK 6:25">ህንተ ካዮታናነ ዬካና።<verse eid="LUK 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26"/>አስ ኡባይ ህንተ ሎኦተ ፃላላ ኦድያ ዎደ ህንተና አየ!</para>
  <para style="q2" vid="LUK 6:26">ኤንታ አዋት በን ዎርዳንቾ ናበታ ቦላ ሄሳዳ ኦዶሶና።<verse eid="LUK 6:26"/></para>
  <para style="s1">ህንተ ሞርከታ ዶስተ</para>
  <para style="r">(<ref loc="MAT 5:38-48">ማቶ 5:38-48</ref>፤ <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>“ሽን ታና ስእያ ህንተዉ ታ ኦዳይስ፤ ህንተ ሞርከታ ዶስተ፤ ህንተና እፀይሳታስ ሎኦባ ኦተ። <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>ህንተና ባደይሳታ አንጅተ፥ ህንተና ናቀይሳታስ ዎስተ። <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>እስ ባጋ ሻካላ ባቀይሳስ ሀንኮ ባጋ በሳ። ነ ላፃና ኤካና ገይሳስ ነ ሻምዝያ ጉጃዳ እማ። <verse eid="LUK 6:29"/><verse number="30" style="v" sid="LUK 6:30"/>ነና ዎስያ ኡባስ እማ፤ ኔፐ ኤክዳ ኦናካ ዛሮ ጋዳ ኦይቾፋ። <verse eid="LUK 6:30"/><verse number="31" style="v" sid="LUK 6:31"/>አሳይ ህንተዉ ኦና መላ ህንተ ኮያባ ኡባ ህንተካ አሳስ ኦተ።<note caller="-" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="MAT 7:17">ማቶ 7:17</ref>.</char></note><verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>“ህንተ፥ ህንተና ዶስያ አሳታ ፃላላ ዶስኮ፥ አይ ጋላት ህንተዉ ደኢ? ሀር አቶሽን፥ ናጋራንቾትካ ባንታና ዶሰይሳታ ዶሶሶና። <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>ህንተዉ ሎኦባ ኦይሳታ ፃላላስ ሎኦባ ኦኮ ህንተዉ አይ ጋላት ደኢ? ናጋራንቾትካ ሄሳዳ ኦሶና። <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>ታልኤ ዛራና አሳ ፃላላስ ህንተ ታልእኮ አይ ዱማ ጋላተተቲ? ናጋራንቾትካ ጉየ ዛራና አስ በእድ ታልኦሶና።”<verse eid="LUK 6:34"/></para>
  <para style="s1">ሀራ አሳ ቦላ ፕርዶፋ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 6:35"/>“ሽን ህንተ ሞርከታ ዶስተ፤ ኤንታዉ ሎኦባ ኦተ። ጉየ ኤካናዉ ቆፖና ታልእተ። ሄሳን ህንተ ኤካና ዎይቶይ ግታ ግዳና። ህንተ ኡባፈ ቦላ ፆሳ ናይታ ግዳና። እ ባና ጋላቶናይሳታስነ ኢታታስ ኬሀ። <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>ህንተ አዋይ ኬሀ ግዶይሳዳ ህንተካ ኬሀ ግድተ።<verse eid="LUK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>“አሳ ቦላ ፕርዶፍተ፤ ህንተ ቦላ ፕርደተና። ህንተ ቦረቶና መላ ኦናካ ቦሮፕተ። አቶ ጊተ፤ ፆሳይ ህንተዉ አቶ ጋና። <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>እምተ፤ ህንተዉ እመታና። ህንተ ማክዳባን ህንተዉ ዛር ማከታና፥ ኡባራካ ሎኦ ማክያባን ባቅድ፥ ሱድ ኩንድ፥ ላለታና ጋካናዉ ህንተዉ ማከት እመታና” ያግስ።<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>ቃስካ የሱሲ ያግድ ኤንታዉ ሌምሶ ኦድስ፤ “ቆቀይ ቆቀ ካለናዉ ዳንዳኢ? ካለኮ ናምአይካ ዎል ኤክድ አፎን ዉሎኮናዬ?<note caller="-" style="x"><char style="xo" closed="false">6:39 </char><char style="xt" closed="false"><ref loc="MAT 15:14">ማቶ 15:14</ref>.</char></note> <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/>ታማረይ አስታማረፐ አና። ሽን ሎይ ታማርዳ ኡራይ ባ አስታማርያ ሀኔስ።<note caller="-" style="x"><char style="xo" closed="false">6:40 </char><char style="xt" closed="false"><ref loc="MAT 10:24-25">ማቶ 10:24-25</ref>፤ <ref loc="JHN 13:16">ዮሀ 13:16</ref>፤ <ref loc="JHN 15:20">15:20</ref>.</char></note><verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>“ነ እሻ አይፈን ደእያ ቡርያ አይስ በአይ? ነ አይፈን ደእያ ቱሱ ዳነይሳ አይስ በእኪ? <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>ነ አይፈን ደእያ ቱሱ ዳነይሳ በኦና ነ እሻኮ፥ ‘ታ እሻዉ፥ ነ አይፈን ደእያ ቡርያ ከሶ’ ጋናዉ ዋና ዳንዳኤይ? ነኖ ጩቡዋዉ፥ ኮይሮታዳ ነ አይፈን ደእያ ቱሱ ዳነይሳ ከሳ። ሄሳፈ ጉየ፥ ነ እሻ አይፈን ደእያ ቡርያ ከሳናዉ ጌሻዳ ፄላና።<verse eid="LUK 6:42"/></para>
  <para style="s1">ምነ እያ አይፈ</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>“ሎኦ ም ኢታ አይፈ አይፈና፤ ሄሳዳካ ኢታ ም ሎኦ አይፈ አይፈና። <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/>አይፈ አይፍያ ም ኡባይ ባ አይፈን ኤረቴስ። አጉንፈ ባላሰ አይፈይ ማፀተና ቃስ ላደፐ ዎይነ አይፈይ ማፀተና።<note caller="-" style="x"><char style="xo" closed="false">6:44 </char><char style="xt" closed="false"><ref loc="MAT 12:33">ማቶ 12:33</ref>.</char></note> <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/>ሎኦ አስ ባ ዎዛናን ኩምዳ ሎኦባፐ ሎኦባ ከሴስ። ኢታ አስ ባ ዎዛናን ኩምዳ ኢታባፐ ኢታባ ከሴስ። አስ ባ ዎዛናን ኩምድ ፓላህዳባፐ ባ ዶናን ኦደቴስ።<note caller="-" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="LUK 12:34">12:34</ref>.</char></note><verse eid="LUK 6:45"/></para>
  <para style="s1">ኬ ኬፅያ ናምኡ አሳታ</para>
  <para style="r">(<ref loc="MAT 7:24-27">ማቶ 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>“ታ ገይሳ ኦከታ፥ ሽን ያትን አይስ ታና፥ ‘ጎዳዉ፥ ጎዳዉ፥ ጌቲ?’ <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/>ታኮ የይነ ታ ቃላ ስእድ ፖልያ ኡባይ ኦና ዳንያኮ ታ ህንተና በሳና። <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/>እ ኬ ኬፃናዉ ዝቅ ኦ፥ ኦላ ቦክድ፥ ጋርሳን ደእያ ዛላ ቦላ ኬ ኤስዳ ጭንጫ ኡራ ዳኔስ። ድኦይ ድእድ ሄ ኬ ሱግስ፥ ሽን ምንድ ኬፅዳ ግሾ፥ ቃፃናዉ ዳንዳእቤና። <verse eid="LUK 6:48"/><verse number="49" style="v" sid="LUK 6:49"/>ሽን ታ ቃላ ስእድ ኦናይ ባ ኬ ሻፈ ቦላ ኬፅዳ ኡራ ዳኔስ። ድኦይ ድእድ ሄ ኬ ሱግዳ ዎደ ኤለስድ ኩንድስ። ሄ ኬይ ዎልቃማ ኩንደ ኩንድስ” ያግስ።<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s1">ማቶ ሀላቃ አማኖ</para>
  <para style="r">(<ref loc="MAT 8:5-13">ማቶ 8:5-13</ref>፤ <ref loc="JHN 4:43-54">ዮሀ 4:43-54</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>የሱሲ ሄሳ ኡባ አሳ ስንን ታማርስድ ኦንግዳፐ ጉየ፥ ቅፍርናሆማ ካታማ ብስ። <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>ሄ በሳን እስ ማቶ ሀላቃይ ደኤስ። እ ዳሮ ዶስያ አይለይ ሀርገትድ ሀይቆስ ጋክስ። <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>እ የሱሳባ ስእዳ ዎደ ባ አይልያ ፓና መላ እያ ዎሶ ግድ እስ እስ አይሁደ ጭማታ የሱሳኮ ኪትስ። <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>ኪተትዳይሳት፥ የሱሳኮ ብድ፥ “ነ እያዉ ሀይሳ ኦናዉ በሴስ። <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>አይስ ጊኮ፥ ሀ ኡራይ ኑ አሳ ዶሴስ፥ አይሁደ ዎሳ ኬካ ኬፅስ” ግድ ምን ዎስዶሶና <verse eid="LUK 7:5"/><verse number="6" style="v" sid="LUK 7:6"/>የሱሲካ ኤንታራ ብስ።</para>
  <para style="p" vid="LUK 7:6">ማቶ ሀላቃ ሶኮ ማትያ ዎደ ባ ላገታ እያኮ ኪትድ፥ “ጎዳዉ፥ ታ ካራፐ ጋርሳን ነ ገላናዉ ታ በሶና ግሾ፥ ዳቡሮፓ። <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>ታካ ታና ነ ስን ሺቃናዉ በሲያ አስ ጋዳ ቆፕከ። ሽን ነ እስ ቃላ ኦዳ፤ ታ አይለይ ፓፃና። <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>ታዉ ታፐ ቦላራ ሀላቃይ ደኤስ፥ ታፐ ጋርሳን ታ ኪትያ ዎታዳረት ደኦሶና። እሱዋ፥ ‘ባ’ ጊኮ ቤስ፥ ሀንኩዋ፥ ‘ሃያ’ ጊኮ ዬስ። ታ አይልያኮ፥ ‘ሀኖ ኦ’ ጊኮ ኦስ” ያግስ።<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>የሱሲ ሄሳ ስእዳ ዎደ ማላለትስ። ጉየ ስሚድ ባራ ያ አሳኮ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ሀር አቶሽን እስራኤለንካ ሀይሳ መላ ግታ አማኖ ደማብከ” ያግስ። <verse eid="LUK 7:9"/><verse number="10" style="v" sid="LUK 7:10"/>ኪተትዳ አሳት ሶ ስምያ ዎደ አይለይ ፓፅን ደምዶሶና።<verse eid="LUK 7:10"/></para>
  <para style="s1">አምኤ ናአ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>ጉ ዎደፐ ጉየ የሱሲ ናይነ ካታማ ብስ። እያ ታማረታራነ ሀራ ዳሮ አሳት እያራ ብዶሶና። <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>እ ካታማ ገላና ሀንያ ዎደ አሀ ቶክዳ ዳሮ አሳት ካታማፐ ከዮሶና። ሀይቅዳ ናአይ ባ አየስ እሱዋ፥ እያካ አምኦ ግዳዳ ደአዉሱ። ካታማ አሳፐ ዳሮት ኢራ ደኦሶና። <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>ጎዳይ እዮ በእዳ ዎደ ቃትድ፥ “ዬኮፋ” ያግስ።<verse eid="LUK 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14"/>ሺቅድ ሀላ ቦችን ቶክዳ አሳት ኤቅዶሶና። የሱሲ፥ “ላ፥ ያላጋዉ ደንዳ” ያግስ። <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>ሀይቅዳይስ ደንድ ኡትድ ኦዳ ኦይክስ። የሱሲ ናኣ ኤክድ አየስ እሚስ።<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>አሳ ኡባይ ያሸትድ፥ “ግታ ናበይ ኑ ግዶን ደንድስ፤ ፆሳይ ባ አሳ በእስ” ያግድ ፆሳ ጋላትዶሶና። <verse eid="LUK 7:16"/><verse number="17" style="v" sid="LUK 7:17"/>እያ ሱንይ ይሁዳንነ ሄ ሄራን ደእያ ቢታ ኡባን ስኤትስ።<verse eid="LUK 7:17"/></para>
  <para style="s1">የሱሳነ ፃማቅያ ዮሃንሳ</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>ፃማቅያ ዮሃንሳ ታማረት ሄሳ ኡባ ዮሃንሳስ ኦድዶሶና። እ ኤንታ ግዶፈ ናምአታ ፄግድ፥ <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>“ያና ጌተትዳይ ነነዬ? ዎይኮ ሀራ ናግኖ?” ያግድ ኦይችተ ግድ ጎዳኮ ኪትስ።<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>አሳት “የሱሳኮ ብድ፥ ፃማቅያ ዮሃንስ፥ ‘ያና ጌተትዳይ ነነዬ? ዎይኮ ሀራ ናግኖ?’ ጊተ ግድ ኑና ኔኮ ኪትስ” ያግዶሶና።<verse eid="LUK 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21"/>ሄ ሳተንካ የሱሲ ዳሮ አሳ ሀርግያፈ ፓስ። ቱና አያናታ ከስስ፥ ቆቅዳ አይፍያካ ፄልስስ። <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>ዮሃንሳ ማታፐ ኪተትድ ይዳይሳታኮ፥ “ብድ ህንተ በእዳይሳነ ስእዳይሳ ዮሃንሳስ ኦድተ። አይፈ ቆቀት ፄሎሶና፥ ጉንዳት ብርሸትድ ሄመቶሶና፥ ባሮ ሀርጋንቾት ጌዮሶና፥ ቱለት ስኦሶና፥ ሀይቅዳይሳት ሀይቆፐ ደንዶሶና፥ ማንቆታስ ዎንገላይ ሳባከቴስ።<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">እሳ 35:5-6</ref>፤ <ref loc="ISA 61:1">61:1</ref>.</char></note> <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>ታናን በቶና ኦንካ አንጀትዳይሳ።”<verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>ዮሃንስ ኪትዳይሳት ብዳፐ ጉየ የሱሲ አሳስ ዮሃንሳባ ያግድ ኦድስ፦ “ህንተ አይ በአናዉ መላ ቢታ ከይደቲ? ጫርኮይ ቃያ ማታ በአናሰዬ? <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>ያትን፥ አይ በአናዉ ከይደቲ? ኮይሰ ማኦ ማእዳ አሳ በአናሰዬ? ኮይሰ ማኦ ማእዳይሳትነ ሳእ እንጀትዳ አሳይ ካዎ ጋን ደኦሶና። <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>ያትን፥ አይ በአናዉ ከይደቲ? ናብያ በአናሰዬ? ኤ፥ ታ ያጋይስ፦ ህንተ በአናዉ ከይዳይ ናበፐ አይሳ።<verse eid="LUK 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LUK 7:27"/>“ ‘ነ ኦግያ ነ ስንን ጊግስያ</para>
  <para style="q2" vid="LUK 7:27">ታ ኪታንቹዋ ኔፐ ስን ታ ኪታና’<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ምልክ 3:1</ref>.</char></note></para>
  <para style="m" vid="LUK 7:27">ጌተትድ ፃፈትዳይ እያሳ። <verse eid="LUK 7:27"/><verse number="28" style="v" sid="LUK 7:28"/>ታ ህንተዉ ኦዳይስ፤ ማጫሳፐ የለትዳይሳታ ግዶፈ ዮሃንሳፐ አይ ባዋ። ፆሳ ካዎተን ኡባፈ ጉፀይስ፥ እ ኡባፈ ግታ ግዳና” ያግስ።<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>ሀር አቶሽን፥ የሱሳ ቃላ ስእዳ ቃራፃ ቃንፅሰይሳት ኡባይ ዮሃንሳ ኩሸን ፃማቀትድ ፆሳይ ፅሎ ግደይሳ ቆንጭስዶሶና።<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="MAT 21:32">ማቶ 21:32</ref>፤ <ref loc="LUK 3:12">ሉቃ 3:12</ref>.</char></note> <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>ሽን ፋርሳወትነ ህገ አስታማረት ዮሃንሳ ኩሸን ፃማቀቶና እፅድ ፆሳ ዞርያ ለቅስዶሶና።<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>የሱሲ ካልድ ሀይሳዳ ያግስ፦ “ህዛ፥ ሀ ዎድያ የለተ አይብራ ዳንሶ? ኤንትካ ኦና ዳኖና? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>ግያ ግዶን ኡትድ ዎል ፄግድ፥ ‘ኑ ህንተዉ ሱሱልኤ ፑንን፥ ህንተ የፀከታ። ኑ ሳቢድ ዘሌልን፥ ህንተ ዬከከታ’ ግያ ናይታ ዳኖሶና። <verse eid="LUK 7:32"/><verse number="33" style="v" sid="LUK 7:33"/>ፃማቅያ ዮሃንስ ሞናነ ኡዮና ይን፥ ‘ኢታ አያናራ ደኤስ ግደታ።’ <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>አሳ ናአይ ምሸነ ኡይሸ ይን፥ ‘ያራምባነ ኡሻንቾ፥ ቃራፃ ቃንፅሰይሳታነ ናጋራንቾታ ዳቦ’ ግደታ። <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>ህዛ፥ ጭንጫተ ቱማተይ እያ ናይታ ኡባ ማታን ኤረትስ” ያግስ።<verse eid="LUK 7:35"/></para>
  <para style="s1">የሱሳ ሽቶ ትይዳ እስ ማጫስዉ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>እስ ፋርሳወይ የሱሳ ካ ሙዛናዉ ባ ሶ ፄግስ። እ ፋርሳውያ ሶ ብድ ጋይታ ቦላ ኡትስ። <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>ሄ ካታማን እስ ናጋራንቾ ማጫስ፥ የሱሲ ፋርሳውያ ሶን ግብራ ቦላ ደኤይሳ ስእዳ ዎደ ዳሮ አልኦ ጵልቃፀ ሽቶ ኤካዳ ያሱ።<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="MAT 26:7">ማቶ 26:7</ref>፤ <ref loc="MRK 14:3">ማር 14:3</ref>፤ <ref loc="JHN 12:3">ዮሀ 12:3</ref>.</char></note> <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>የሱሳፐ ጉየ ባጋራ፥ እያ ቶሁዋ ማታን ኤቃዳ ዬካሸ እያ ቶሁዋ ባ አፉራ ላኮዉሱ። ባ ብናናራ እያ ቶሁዋ ቁቻሸነ ዬራሸ ሽቶ ትያሱ።<verse eid="LUK 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39"/>ግብራ ጊግስዳ ፋርሳወይ ሄሳ በእዳ ዎደ ባ ዎዛናን፥ “ሀይስ ናበ ግድያኮ ሀ ማጫስያ፥ እያ ቦችያራ ኦነኮ ቃስ እያ ናጋራንቾ ግደይሳካ እ ኤራናሽን” ያግስ።<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>የሱሲ፥ “ስሞና፥ ታ ነዉ ኦድያባይ ደኤስ” ያግስ።</para>
  <para style="p" vid="LUK 7:40">እ፥ “አስታማርያዉ፥ ታዉ ኦዳ” ያግስ።<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>የሱሲ እያኮ፥ “ናምኡ አሳት እስ ኡራፐ ሚሸ ታልእዶሶና። እሶይ እቻሹ ፄቱ ብራ ሀንኮይ ቃስ እሻታሙ ብራ ታልእዶሶና። <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>ናምአይካ ታልእያ ጭጋናዉ ፆነትን፥ ናምአታስካ ታልእያ ማርስ። ህዛ፥ ሀ ናምአታፐ ሄ ኡራ ዳሮ ዶሳናይ ነዉ ኦና ዳን” ያግስ።<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>ስሞን፥ “ዳሮ አጮይ ማረትዳ ኡራይ ዳሮ ዶሳና ዳኔስ” ያግስ። የሱሲ፥ “ነ ቱማ ፕርዳዳሳ” ያግስ። <verse eid="LUK 7:43"/><verse number="44" style="v" sid="LUK 7:44"/>ሄሳፈ ጉየ፥ የሱሲ ማጫሴኮ ስም ፄልድ፥ ስሞናኮ፥ “ሀኖ ማጫስዉ በአይ? ታኒ ነ ሶ ገልን ሀር አትሽን፥ ነ ታዉ ቶሆ ሃ እማባካ፥ ሽን እያ ታ ቶሁዋ ባ አፉን ላኮዳ ባ ብናናን ቁቻሱ። <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>ኔኒ ታና ዬራ ኤካባካ፥ ሽን እያ ታ ነ ሶ ገሎሳፐ ዶማዳ ታ ቶሁዋ ዬሮ አጋቡኩ። <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>ኔኒ ታ ሁጵያን ዛይተ ትያባካ፥ ሽን እያ ታ ቶሁዋ ሽቶ ትያዉሱ። <verse eid="LUK 7:46"/><verse number="47" style="v" sid="LUK 7:47"/>እያ ታና ዳሮ ዶስዳ ግሾ፥ እ ዳሮ ናጋራይ አቶ ጌተትስ። ጉ ናጋር አቶ ጌተትዳ ኡራይ ጉራ ዶሴስ።”<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>የሱሲ ማጫሴኮ፥ “ነ ናጋራይ አቶ ጌተትስ” ያግስ።<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>እያራ እስፈ ጋይታን ኡትድ ምያ እማት፥ “ናጋራ አቶ ያገይ፥ እ ሀይስ ኦኔ?” ያግድ ባንታ ዎዛናን ቆፕዶሶና።<verse eid="LUK 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50"/>የሱሲ ማጫሴኮ፥ “ነ አማኖይ ነና አሽስ፤ ሳሮ ባ” ያግስ።<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>ሄሳፈ ጉየ፥ የሱሲ ፆሳ ካዎተ ዎንገላ ሳባክሸ ካታማራነ ጉታራ አስ። ሄ ዎደ ታማነ ናምኡ ሀዋረት እያራ ደኦሶና። <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>ቃስ ቱና አያናፐነ ዱማ ዱማ ሀርግያፈ ፓፅዳ እስ እስ ማጫሳት እያራ ደኦሶና። ኤንትካ፥ ላፑን ቱና አያናት ከይዳ ማግደላ ማይራሞ፥<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 27:55-56">ማቶ 27:55-56</ref>፤ <ref loc="MRK 15:40-41">ማር 15:40-41</ref>፤ <ref loc="LUK 23:49">ሉቃ 23:49</ref>.</char></note> <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>ሄሮዲሳ ሹማ ኩዛ ማችዉ ዮሃና፥ ሶስናራነ ቃስ ሀራ ዳሮት ኤንታና ሚሸን ማደይሳት ደኦሶና።<verse eid="LUK 8:3"/></para>
  <para style="s1">ዘረ ዘርያ ኡራ ሌምሶ</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>ዳሮ አሳይ ዱማ ዱማ ካታማፐ እያኮ ሺቅን ሌምሶን ኤንታዉ ኦድስ። <verse eid="LUK 8:4"/><verse number="5" style="v" sid="LUK 8:5"/>“እስ ጎሻንቾይ ዘረ ዘራናዉ ከይስ። እ ዘርሽን እስ እስ ዘረይ ኦገ ጋፃን ዎድ የትስ፥ ሳሎ ካፎት ማፅዶሶና። <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>ሀራት ሻሎይ ጋርሳን ደእያ ቢታ ቦላ ዎዶሶና። ቡሮ ዶልዳ መላ ቢታን ላሆይ ባይና ግሾ ምጭዶሶና። <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>ሀራ ዘረይ ቃስ አጉን ግዶን ዎስ። አጉንራ ዎላ ድጭዳ ግሾ አጉንይ ጩልድ በሳን አሽስ። <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>ሀራት ሎኦ ቢታ ቦላ ዎዶሶና። ዶልዳ ዎደ ፄቱ ኩሸ አይፍዶሶና።” ሄሳ ኦድ ኦንግድ፥ ባ ቃላ ቁ ኦድ፥ “ስእያ ሀይ ደእያ ኡባይ ስኦ” ያግስ።<verse eid="LUK 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>እያ ታማረት፥ “ሀ ሌምሱዋ ብርሸይ አይቤ?” ያግድ ኦይችዶሶና <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>እ፥ “ፆሳ ካዎተ ፁራ ኤራና መላ ህንተዉ እመትስ። ሽን ሀራት በእሸ ደሞና መላ፥ ስእሸ አኬኮና መላ ሌምሶን ኦዳይስ።<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="ISA 6:9">እሳ 6:9</ref>.</char></note><verse eid="LUK 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>“ህዛ፥ ሀ ሌምሱዋ ብርሸይ ሀይሳ፦ ዘረ ያገትዳይ ፆሳ ቃላ። <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>ኦገ ጋፃን ዎዳ ዘረይ ቃላ ስኤይሳታ። ግዶሽን፥ ኤንቲ አማንድ አቶና መላ ፃላሄይ ቃላ ኤንታ ዎዛናፐ ማፅ ድጌስ። <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>ሻሎይ ጋርሳን ደእያ ቢታ ቦላ ዎዳ ዘረይ ቃላ ስእድ ኡፋይሳን ኤከይሳታ። ኤንቲ ሀእስ አማኖሶናፐ አትሽን፥ ፃጶይ ባይና ግሾ ፓጨይ ጋክያ ዎደ ኤለስድ ካዶሶና። <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>አጉን ግዶን ዘረትዳ ዘረይ ቃላ ስኤይሳታ። ኤንትካ አላምያ ቆፋን፥ ዱረተንነ ሳአ ዱሳ ሚኮተን ጩለትድ በሰይሳዳ አይፍቦኮና። <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>ሎኦ ቢታን ዎዳ ዘረይ ሎኦ ዎዛናን ቃላ ስእድ ናገይሳታነ ዳንዳአን ምንድ አይፈ አይፈይሳታ።<verse eid="LUK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>“ፆምፐ ኦይድ፥ ዳቾ ካመይ ዎይኮ አርሳፈ ጋርሳን ዎይ ዴና። ገልያ አስ በአና መላ ቃ በሳን ዎስ።<note caller="-" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ 5:15</ref>፤ <ref loc="LUK 11:33">ሉቃ 11:33</ref>.</char></note><verse eid="LUK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17"/>“ሄሳ ግሾ፥ ቆንጨ ከዮና ቆሰትድ አትያባይ፥ ኤረቶና ጌምድ አትያባይ ዴና።<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቶ 10:26</ref>፤ <ref loc="LUK 12:2">ሉቃ 12:2</ref>.</char></note><verse eid="LUK 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18"/>“ህዛ፥ ህንተ ቃላ ዋት ስእያኮ አኬክተ። ደእያ ኡባስ ጉዠትድ እመታና፥ ባይናይሳስ ሀር አቶሽን እያዉ ደእያ ጉያካ እያፐ ኤከታና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶ 25:29</ref>፤ <ref loc="LUK 19:26">ሉቃ 19:26</ref>.</char></note><verse eid="LUK 8:18"/></para>
  <para style="s1">የሱሳ አየራነ እሻታራ</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶ 12:46-50</ref>፤ <ref loc="MRK 3:31-35">ማር 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>የሱሳ አየራነ እሻታራ እያኮ ይዶሶና። ሽን አሳ ዳሮተፈ ደንዶይሳን እያ ደማናዉ ዳንዳእቦኮና። <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>እስ አስ የሱሳኮ፥ “ነ አየራነ ነ እሻታራ ነና ኮይድ ካረን ናጎሶና” ያግስ።<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>የሱሲ ዛሪድ፥ “ፆሳ ቃላ ስእድ ኦሶን ፔሸይሳት ኡባይ፥ ታዉ አዮነ ታዉ እሻ” ያግስ።<verse eid="LUK 8:21"/></para>
  <para style="s1">የሱሲ ሆቢያ ሴርስ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶ 8:23-27</ref>፤ <ref loc="MRK 4:35-41">ማር 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>እስ ጋላስ የሱሳራነ እያ ታማረታራ እስፈ ዎጎሎን ገልድ፥ “አባ ፕኖስ” ያግስ። ኤንትካ ባናዉ ደንድዶሶና። <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>አባ ቦላራ ኤንቲ ፕናናዉ ብሽን የሱሲ ስክስ። ቆፖና ምኖ ጫርኮይ አባ ቦላ ደንድስ። ሃ ዎጎሉዋን ገልን ዎጎሎይ ምተተ ኦይክያ ዎደ ኡባይ ባብዶሶና።<verse eid="LUK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24"/>እያ ታማረት እያኮ ሺቅድ፥ “ጎዳዉ! ጎዳዉ! ኑ ዮስ” ያግድ የሱሳ ደንዶሶና።</para>
  <para style="p" vid="LUK 8:24">የሱሲ ደንድድ ጫርኩዋነ ጎትያ ሀንቅስ። ኤለስድ ጫርኮይነ ጎተይ ዎፑ ግስ፤ ሳሮተ ስምስ። <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/>የሱሲ ባ ታማረታኮ፥ “ህንተ አማኖይ አዉኔ?” ያግስ። ኤንትካ፥ ያይሸነ ማላለትሸ እሶይ እሱዋኮ፥ “ጫርኮይነ ሃይ ኪተተይስ፥ እ ሀይስ ኦኔ” ያግዶሶና።<verse eid="LUK 8:25"/></para>
  <para style="s1">ቱና አያን እያፐ ከይዳ ኡራ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶ 8:28-34</ref>፤ <ref loc="MRK 5:1-20">ማር 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>አባ ፕንድ ጋልላ ባጋራ ደእያ ገርገሶነ ቢታ ጋክዶሶና። <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>የሱሲ ዎጎሎፐ ከይድ ሳአን ዎሽን ቱና አያናን ኦይከትዳ ኡራይ ካታማፐ ከይድ እያራ ጋሄትስ። ዳሮ ላይ ማኦ ማኦና ካሎ ዱፎን ደኤስፐ አትሽን፥ ሶ ገለና። <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>የሱሳ በእዳ ዎደ እያ ስንን ጉፋንድ፥ ባ ቃላ ቁ ኦድ፥ “ኡባፈ ቦላ ፆሳ ናአዉ የሱሳ ኔራ ታዉ አይብ እስፈተ ደኢ? ሀያና ታና ሀእ ኡንኤፋርክ” ያግስ። <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>ሄሳ እ ግዳይ፥ ቱና አያናይ ኡራፐ ከያና መላ የሱሲ ሀንቅዳ ግሾሳ። ዳሮ ዎደ ቱና አያናይ እያ ሃርዳ ግሾ ሳንላታንነ ቶሆ ቃችያ ብራታን ቃሸትድ ናገቴስ። ሽን ቃሹዋ ዱድ ቱና አያናን ላገትድ መላ ቢታ ገልስ።<verse eid="LUK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30"/>የሱሲ፥ “ነ ሱንይ ኦነ” ያግድ ኦይችስ።</para>
  <para style="p" vid="LUK 8:30">እ፥ ዳሮ ቱና አያናት እያ ኦይክዳ ግሾ ባና፥ “ሌግዮና” ግስ። <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>ቱና አያናት ባንታና ስኦለ ኪቶና መላ ዎስዶሶና።<verse eid="LUK 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32"/>ሄ በሳን ዞዘ ቦላ ምያ ጉዱን ዉደይ ሄመቴስ። ህን ጉዱንታን ገልኖ ግድ ዎስዶሶና፥ እካ “ገልተ” ግስ። <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>ቱና አያናት ኡራፐ ከይድ ጉዱንታን ገልዶሶና። ዉደይ ደርያፐ ዱገ ጉርጉፅድ አባን ገልስ።<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>ሄንንቾት ሀንዳይሳ በእዳ ዎደ ዎፅ ብድ፥ ካታማንነ ጉታ ኡባን ኦድዶሶና። <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>አሳይ ሀንዳባ በአናዉ ከይድ የሱሳኮ ይዶሶና። ቱና አያናይ ከይዳ ኡራይ ማኦ ማእድ፥ እያ ዎዛናይ ስምን፥ የሱሳ ቶሆ ማታን ኡትዳይሳ ደምድ ያይዶሶና። <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>እያ በእዳ አሳይ ቱና አያናን ኦይከትዳ ኡራይ ዋንድ ፓፅዳኮ ኦድዶሶና። <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/>ገርገሶነ ዩሾን ደእያ አሳይ ግታ ያሽ ያይድ፥ የሱሲ ባንታ ማታፐ ባና መላ ዎስዶሶና። እ ዎጎሉዋን ገልድ ጉየ ስምስ።<verse eid="LUK 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38"/>ቱና አያናይ ከይዳ ኡራይ የሱሳራ ዳናዉ ዎስስ። <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/>ሽን የሱሲ እያኮ፥ “ነ ሶ ስማ፥ ፆሳይ አይ መላ ግታባ ነዉ ኦዳኮ ኦዳ” ያግድ ሞይዝስ። ኡራይካ የሱሲ አይ መላ ግታባ እያዉ ኦዳኮ ካታማ ኡባን ማርካትሸ ብስ።<verse eid="LUK 8:39"/></para>
  <para style="s1">ሀይቅዳ ናእዉነ ሀርገትያ ማጫስዉ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶ 9:18-26</ref>፤ <ref loc="MRK 5:21-43">ማር 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>አሳይ ናግድ ጋምእዳ ግሾ የሱሲ ስምያ ዎደ ሞክ ኤክዶሶና። <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>አይሁደ ዎሳ ኬ ሀላቃ ግድዳ እያሮሳ ጌተትያ ኡራይ ባ ሶ ያና መላ የሱሳ ቶሁዋ ቦላ ዎድ ዎስስ። <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>እያዉ ታማነ ናምኡ ላይ ግድዳ ማጫ ናእ ሳከታዳ ሀይቆስ ጋካዳ ደአዉሱ። የሱሲ ብያ ዎደ አሳይ እያ ኡንኤስ። <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>ታማነ ናምኡ ላይ ሱ ጎግሸ ጋምእዳ ማጫስ ደአዉሱ። እያ ባዉ ደእያ ሚሽያ አክመታስ እማዳ ኦንጋሱ። ሽን ፓፃናዉ ዳንዳአቡኩ። <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>እያ የሱሳስ ጉየ ባጋራ ሺቃዳ፥ እያ አፍላ ማጫራ ቦቻሱ፥ ኢራካ ጎግያ ሱይ ኤቅ አግስ።<verse eid="LUK 8:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45"/>የሱሲ፥ “ታና ቦችዳይ ኦኔ?” ያግስ። ኡባይ፥ “ኑ ቦችቦኮ” ያግን፥ ጰፅሮስ፥ “አስታማርያዉ፥ ዳሮ አሳይ ካልሽንነ ኡንኤሽን በአሸ ዋናዳ፥ ‘ታና ቦችዳይ ኦኔ?’ ጋይ” ያግስ።<verse eid="LUK 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46"/>ሽን የሱሲ፥ “እስ አስ ታና ቦችስ፤ አይስ ጊኮ፥ ዎልቅ ታፐ ከዮይስ ታዉ ኤረትስ” ያግስ።<verse eid="LUK 8:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47"/>ማጫስያ፥ እባይ ቆንጭዳይሳ ኤርዳ ዎደ ኮኮራሸ ያዳ የሱሳ ቶሁዋ ቦላ ኩንዳሱ። አይስ ቦችዳኮነ ዋናዳ ኤለሳዳ ፓፅዳኮ አሳ ኡባ ስንን ማርካታሱ። <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/>እ፥ “ታ ናተ፥ ነ አማኖይ ነና ፓስ፤ ሳሮ ባ” ያግስ።<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>የሱሲ ኦዳ ኦንጎና ደእሽን፥ አይሁደ ዎሳ ኬ ሀላቃ፥ እያሮሳ ሶፐ እስ አስ ይድ፥ “እያሮሳ፥ ነ ናእያ ሀይቃሱ፤ አስታማርያ መላ ዳቡርሶፋ” ያግስ።<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>ሽን የሱሲ ሄሳ ስእድ እያሮሳኮ፥ “ባቦፋ! አማና፥ ነ ናእያ ፓፃና” ያግስ።<verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>የሱሲ እያሮሳ ሶ ጋክዳ ዎደ ጰፅሮሳፐ፥ ዮሃንሳፐ፥ ያይቆባፐ፥ ናኤ አዋፐነ አየፐ አትሽን፥ ሀር ገላና መላ ኮይቤና። <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>ሄ በሳን ደእያ አሳ ኡባይ ናኤስ ምሸትድ ዬክሽን፥ የሱሲ፥ “ዬኮፍተ ናእያ ስካሱፐ አትሽን፥ ሀይቃቡኩ” ያግስ።<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>አሳይ ናእያ ሀይቅዳይሳ ኤርያ ግሾ፥ እያ ኦዳ ለቅድ ሚጭዶሶና። <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>ሽን የሱሲ ናኤ ኩሽያ ኦይክድ፥ “ናተ ደንዳ” ያግስ። <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>ናኤስ ሸምፖይ ስምን ደንዳ ኤቃሱ። የሱሲ ኤንታኮ፥ “እዉ ምያባ እምተ” ያግስ። <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>ናኤ አዋራነ አየራ ማላለትዶሶና። ሽን የሱሲ ሀይሳ፥ “ኦደስካ ኦዶፕተ” ያግስ።<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s1">ታማነ ናምኡ ሀዋረት ኪተትዶሶና</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቶ 10:5-15</ref>፤ <ref loc="MRK 6:7-13">ማር 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>የሱሲ ታማነ ናምኡ ሀዋረታ ባኮ ፄግድ፥ ቱና አያናታ ከሳና መላነ ሀርገ ኡባ ፓና መላ ዎልቃነ ማታ እሚስ። <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>ፆሳ ካዎተባ ማርካታናዳነ ሀርጋንቾታ ፓናዳ ኪትስ። <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>እ ኤንታኮ፥ “ፃምአ ግድን ኦጎሮ ግድን ካ ግድን ሚሸ ግድን ላምድ ማእያ አፍላ ግድን ኦገስ ግድ አይኮካ ኦይኮፍተ።<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃ 10:4-11</ref>.</char></note> <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>ሄ ካታማፐ ህንተ ከያና ጋካናዉ እማተን ህንተ ገልዳ ኬን ጋምእተ። <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/>ኦንካ ህንተና ሞኮና እፅኮ ሄ ካታማፐ ከይሸ ኤንታዉ ማርካ ግዳና መላ ህንተ ቶሁዋን ደእያ ባና ፕትድ ከይተ።” <verse eid="LUK 9:5"/><verse number="6" style="v" sid="LUK 9:6"/>ኤንትካ ኪተትዳይሳዳ ከይድ ዎንገላ ኦድሸነ ዱማ ዱማ ጉታታን ሀርጋንቾታ ፓሸ አዶሶና።<verse eid="LUK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>ጋልላ ቢታ ሃርያ ሄሮዲስ የሱሲ ኦዳባ ኡባ ስእዳ ዎደ ዳጋምስ። አይስ ጊኮ፥ እስ እስ አሳት ዮሃንስ ሀይቆፐ ደንዶና አገና ያጎሶና።<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="MAT 16:14">ማቶ 16:14</ref>፤ <ref loc="MRK 8:28">ማር 8:28</ref>፤ <ref loc="LUK 9:19">ሉቃ 9:19</ref>.</char></note> <verse eid="LUK 9:7"/><verse number="8" style="v" sid="LUK 9:8"/>ባጋት፥ “ኤልያስ ቆንጭስ” ጎሶና፤ ሀራት ቃስ፥ “በን ናበታፐ እሶይ ሀይቆፐ ደንድስ” ያግድ ኦደቶሶና። <verse eid="LUK 9:8"/><verse number="9" style="v" sid="LUK 9:9"/>ሽን ሄሮዲስ፥ “ታኒ ዮሃንሳ ቆያ ቃንፅሳዳ ዎስ። ያትን፥ ሀይሳ ያገትድ እያባ ኦደተይ፥ እ ኦኔ?” ያግድ ባ አይፈን በአናዉ ኮዬስ።<verse eid="LUK 9:9"/></para>
  <para style="s1">እቻሹ ሙኩሉ አሳ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ 14:13-21</ref>፤ <ref loc="MRK 6:30-44">ማር 6:30-44</ref>፤ <ref loc="JHN 6:1-14">ዮሀ 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>ታማነ ናምኡ ሀዋረት ጉየ ስም ይድ፥ ኤንቲ ኦዳባ ኡባ የሱሳስ ኦድዶሶና። እ ኤንታና ኤክድ ቤተሳይዳ ካታማፐ ጋፃ ኤፍስ። <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>ሽን ዳሮ አሳይ የሱሳ ግደይሳ ኤርድ እያ ካልዶሶና። እ ኤንታ ሞክ ኤክድ ፆሳ ካዎተባ ታማርስስ፤ ፓፃናዉ ኮየይሳታካ ፓስ።<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>ሳእ ኦማርስያ ዎደ ታማነ ናምኡ ሀዋረት እያኮ ሺቅድ፥ “ኑ ደኤይ መላ ቢታ ግድያ ግሾ አሳይ ዱማ ዱማ ጉታታነ ካታማታ ብድ፥ ካነ አቅያ በሲ ኮያና መላ አሳ ሞይዛ” ያግዶሶና።<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>ሽን እ፥ “ኤንታዉ ምያባ ህንተ እምተ” ያግስ።</para>
  <para style="p" vid="LUK 9:13">ኤንቲ፥ “ኑስ ደኤይ እቻሹ ኡይነ ናምኡ ሞሎ ግድያ ግሾ፥ ሀ አሳስ ግድያ ካ ኑኒ ብድ ሻሞና እፅኮ ግደና” ያግዶሶና። <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>ሄ በሳን እቻሹ ሙኩሉ ግድያ አደት ደኦሶና።</para>
  <para style="p" vid="LUK 9:14">የሱሲ ባ ታማረታኮ፥ “እሻታማን እሻታማን ሻክ ሻክ አሳ ኡትስተ” ያግስ።<verse eid="LUK 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15"/>እያ ታማረት፥ እ ኪትዳይሳዳ አሳ ኡትስዶሶና። <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>እ እቻሹ ኡይነ ናምኡ ሞሎታ ኤክድ፥ ሳሎ ፄልድ፥ ፆሳ ጋላትድ፥ መንድ አሳ ኡባ ጋና መላ ባ ታማረታስ እሚስ። <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>ኡባይ ምድ ካልዶሶና። ኤንታፈ አትዳ ቲፈይ ታማነ ናምኡ ጋይታ ኩመ ግድስ።<verse eid="LUK 9:17"/></para>
  <para style="s1">ጰፅሮሳ ማርካተ</para>
  <para style="r">(<ref loc="MAT 16:13-19">ማቶ 16:13-19</ref>፤ <ref loc="MRK 8:27-29">ማር 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>የሱሲ ባ ፃላላ ዎስሽን፥ እያ ታማረት እያኮ ይዶሶና። እ፥ “አሳይ ታና ኦና ጎና?” ግድ ኦይችስ።<verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>ኤንቲ ዛሪድ “እሶት እሶት፥ ‘ፃማቅያ ዮሃንሳ፥ ባጋት ኤልያሳ፥ ሀራት ቃስ፥ በን ናበታፐ እሶይ ሀይቆፐ ደንድስ’ ያጎሶና” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="MAT 14:1">ማቶ 14:1</ref>፥ <ref loc="MAT 14:2">2</ref>፤ <ref loc="MRK 6:14-15">ማር 6:14-15</ref>፤ <ref loc="LUK 9:7-8">ሉቃ 9:7-8</ref>.</char></note><verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>እ ዛሪድ፥ “ያትን ህንተ ታና ኦና ጌቲ?” ያግስ። ጰፅሮስ፥ “ኔኒ ፆሳፈ ኪተትዳ ክርስቶሳ” ያግድ ዛርስ።<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="JHN 16:20-28">ዮሀ 16:20-28</ref>፤ <ref loc="MRK 8:30-9:1">ማር 8:30—9:1</ref>.</char></note><verse eid="LUK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>የሱሲ ሀይሳ ኦደስካ ኦዶፕተ ግድ ምንድ ኦድስ። <verse eid="LUK 9:21"/><verse number="22" style="v" sid="LUK 9:22"/>ቃስካ የሱሲ፥ “አሳ ናእ ዳሮ መቱዋ ኤካና። ቢታ ጭማታ፥ ካህነ ሀላቃታነ ህገ አስታማረታ ኩሸን አድ እመታና። ኤንቲ እያ ዎና፥ ሽን እ ሄን ጋላስ ሀይቆፐ ደንዳና” ያግስ።<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>የሱሲ አሳ ኡባኮ፥ “ታና ካላናዉ ኮየይ ኦንካ ደእኮ ባና ካዶ፥ ባ ማስቃልያ ጋላስ ጋላስ ቶክድ ታና ካሎ።<note caller="-" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ 10:38</ref>፤ <ref loc="LUK 14:27">ሉቃ 14:27</ref>.</char></note> <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/>ባ ሸምፕዉ አሻናዉ ኮያ ኡባይ እዮ ይሴስ፥ ባ ሸምፕዉ ታ ግሾ ግድ ይስያ ኦንካ እዮ አሼስ።<note caller="-" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ 10:39</ref>፤ <ref loc="LUK 17:33">ሉቃ 17:33</ref>፤ <ref loc="JHN 12:25">ዮሀ 12:25</ref>.</char></note> <verse eid="LUK 9:24"/><verse number="25" style="v" sid="LUK 9:25"/>አስ አላመ ኡባ ሃርድ፥ ግዶሽን፥ ባ ሸምፕዉ ይስያባ ዎይኮ ቆህያባ ግድኮ እያ አይ ማዲ? <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>ኦንካ ታናንነ ታ ቃላን ዬላትኮ፥ አሳ ናእ ባ ቦንቹዋራ ሄሳዳካ አዋ ቦንቹዋራነ ጌሻ ኪታንቾታ ቦንቹዋራ ያ ዎደ እያን ዬላታና። <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>ታ ህንተዉ ቱማ ኦዳይስ፤ ሀይሳን ኤቅዳይሳታ ግዶፈ ፆሳ ካዎተ በኦናሽን ሀይቆና አሳት ደኦሶና” ያግስ።<verse eid="LUK 9:27"/></para>
  <para style="s1">የሱሳ ማላይ ላመትስ</para>
  <para style="r">(<ref loc="MAT 17:1-8">ማቶ 17:1-8</ref>፤ <ref loc="MRK 9:2-8">ማር 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>የሱሲ ሄ ኦዳ ኦድን፥ ሆስፑን ጋላሳፐ ጉየ፥ ጰፅሮሳ፥ ያይቆባነ ዮሃንሳ ባራ ኤክድ ዎሳናዉ ዙማ ቦላ ከይስ።<note caller="-" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጰፅ 1:17-18</ref>.</char></note> <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>እ ዎሳ ቦላ ደእሽን እያ አይፈ ካረይ ላመትስ፤ አፍላይካ ቦፅድ፥ አዋ መላ ጶልስ። <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>ናምኡ አሳት፥ ኤንትካ ሙሰራነ ኤልያሳራ ቦንቾን ቆንጭድ፥ <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>የሩሳላመን ፖለታናዉ ደእያባ፥ ሄስካ፥ እ ሀ አላምያፐ ሻከታናባ እያራ ኦደቶሶና። <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>ጰፅሮሳነ እያራ ደኤይሳታ ስኮይ ኤፍን፥ ኤንቲ ስኮፈ ባርክያ ዎደ እያ ቦንቹዋነ እያራ ኤቅዳ ናምኡ አሳታ በእዶሶና። <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>አሳት የሱሳፐ ሻከትድ ባና ሀንሽን፥ ጰፅሮስ የሱሳኮ፥ “ጎዳዉ፥ ኑ ሀይሳን ግድኮ ኑስ አይ መላ ሎኦ! እስኖ ነዉ፥ እስኖ ሙሰስ፥ እስኖ ኤልያሳስ ኦድ፥ ሄ ሻቃራ ሻቃሮስ” ያግስ። ሽን እ አይ ግዳኮ ኤረና።<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>እ ያግድ ኦደትሽን ሻራይ ይድ ኤንታና ካምስ። ኤንቲ ሄ ሻራ ግዶ ገልሸ ባብዶሶና። <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>ሻራ ግዶፈ፥ “ታ ዶርዳ ናአይ ሀይሳ እያ ስእተ” ግያ ቃል ስኤትስ።<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="ISA 42:1">እሳ 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ 3:17</ref>፤ <ref loc="MAT 12:18">12:18</ref>፤ <ref loc="MRK 1:11">ማር 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃ 3:22</ref>.</char></note> <verse eid="LUK 9:35"/><verse number="36" style="v" sid="LUK 9:36"/>ቃል ስኤትዳፐ ጉየ፥ የሱሲ ባርካ ደእሸ በንትስ። ሄ ዎደ ኤንቲ በእዳባ ኦደስካ ኦዶና፥ ባንታ ዎዛናን ኦይክድ ስእ ግዶሶና።<verse eid="LUK 9:36"/></para>
  <para style="s1">ቱና አያን ኦይክዳ ናአ</para>
  <para style="r">(<ref loc="MAT 17:14-18">ማቶ 17:14-18</ref>፤ <ref loc="MRK 9:14-27">ማር 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>ዎንተ ኤንቲ ዙማ ቦላፈ ዎያ ዎደ ዳሮ አሳይ ይድ እያራ ጋሄትዶሶና። <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>ሄ ዎደ አሳ ግዶፈ እስ አስ፥ “አስታማርያዉ፥ ታ እስ ናኣ ያዳ በአርክ። <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>ቱና አያናይ ቆፖና ኦይክድ ዋስሴስ፤ ጎፖንቶ የግስድ ቃከረስ፥ አሳተ ቆህድ ኡንኤድ የዴስ። <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>ነ ታማረት ከሳና መላ ዎሳስ፥ ሽን ኤንቲ ዳንዳእቦኮና” ያግድ ዎስስ።<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>የሱሲ፥ “አማኖይ ባይና ጌላ የለታቶ፥ አዉደ ጋካናዉ ታ ህንተራ ዳነ፥ ህንተና ዳንዳአኔ? ነ ናኣ ባዳ ሃ ኤካያ” ያግስ።<verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>ናኣ ኤክድ ያ ዎደ ቱና አያናይ ሳአን ሆል የግድ ኮኮርስስ። ሽን የሱሲ ቱና አያና ሀንቅድ ናኣፐ ከስስ። ናኣካ ናኣ አዋስ እሚስ። <verse eid="LUK 9:42"/><verse number="43" style="v" sid="LUK 9:43"/>አሳ ኡባይ ፆሳ ግታ ዎልቃን ማላለትዶሶና። ኤንቲ እ ኦዳባን ማላለትሽን፥ የሱሲ ባ ታማረታኮ፥ <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/>“ሀይሳ ታ ህንተዉ ኦደይሳ ሎይ ስእተ፤ አሳ ናእ ሞርከታ ኩሸን አድ እመታና” ያግስ። <verse eid="LUK 9:44"/><verse number="45" style="v" sid="LUK 9:45"/>ሽን እ ግዳባይ ኤንታፈ ጌምዳ ግሾ፥ አኬክቦኮና። ሄሳ ግሾ፥ ዛሪድ ኦይቻናዉ ባብዶሶና።<verse eid="LUK 9:45"/></para>
  <para style="s1">ኡባፈ አይ ኦኔ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶ 18:1-5</ref>፤ <ref loc="MRK 9:33-37">ማር 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>የሱሳ ታማረት፥ “ኑ ግዶን ግታ ግዳናይ ኦኔ?” ግድ ፓላማ ኦይክዶሶና።<note caller="-" style="x"><char style="xo" closed="false">9:46 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ 22:24</ref>.</char></note> <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>የሱሲ ኤንታ ዎዛና ቆፋ ኤርድ ዮጋ ናኣ ባ ማታን ኤስድ፥ <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>“ሀ ዮጋ ናኣ ታ ሱንን ሞክያ ኦንካ ታና ሞኬስ፥ ታና ሞከይ ታና ኪትዳይሳ ሞኬስ፥ ህንተ ኡባፈ ጉፀይስ፥ እ ግታ ግዳና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ 10:40</ref>፤ <ref loc="LUK 10:16">ሉቃ 10:16</ref>፤ <ref loc="JHN 13:20">ዮሀ 13:20</ref>.</char></note><verse eid="LUK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>ዮሃንስ፥ “ጎዳዉ፥ እስ አስ ነ ሱንን ቱና አያናታ ከስሽን በእድ፥ እ ኑራ ግዶና ግሾ ድግዳ” ያግስ።<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>የሱሲ ዛሪድ፥ “ህንተራ ኤቀቶናይስ፥ እ ህንተ ባጋ። ሄሳ ግሾ፥ እያ ድጎፍተ” ያግስ።<verse eid="LUK 9:50"/></para>
  <para style="s1">የሱሲ ሳማረን እፀትስ</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>የሱሲ ሳሎ ብያ ዎደይ ማታትዳ ግሾ፥ የሩሳላመ ባናዉ ቃንፅድ ደንድስ። <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>ሳማረ ቢታን ደእያ እስ ጉታ ብድ፥ ኡባባ እያዉ ጊግሳና መላ አሰ ያ ኪትስ። <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>ሽን እ በይ የሩሳላመ ግድያ ግሾ፥ ኤንቲ እያ ሞክ ኤክቦኮና። <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>የሱሳ ታማረት ያይቆባራነ ዮሃንሳራ ሄሳ በእድ፥ “ጎዳዉ፥ ሳሎፐ ታም ዎድ ኤንታ ሞ ጋና መላ ነ ኮያይ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">9:54 </char><char style="xt" closed="false"><ref loc="2KI 1:9-16">2 ካዎ 1:9-16</ref>.</char></note> <verse eid="LUK 9:54"/><verse number="55" style="v" sid="LUK 9:55"/>ሽን የሱሲ ጉየ ስም ኤንታ ሀንቀትድ፥ “ህንተ ጋርሳን አይብ አያን ደእያኮ ህንተ ኤረከታ። አሳ ናእ አሰ አሻናዉ ይስፐ አትሽን፥ ይሳናሳ ግደና” ያግስ። <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>ያፐ ደንድድ ሀራ ጉታ ብዶሶና።<verse eid="LUK 9:56"/></para>
  <para style="s1">የሱሳ ካሎይ ጭግስያ ጋተ</para>
  <para style="r">(<ref loc="MAT 8:19-22">ማቶ 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>ኤንቲ ኦገራ ብሽን፥ እስ አስ፥ “ነ ብያ ሶ ኡባ ታ ካላና” ያግስ።<verse eid="LUK 9:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58"/>የሱሲ ዛሪድ፥ “ዎርካናታስ ኦል፥ ሳሎ ካፎታስ ኬ ደኤስ፥ ሽን አሳ ናእ ባ ሁጰ ሸምፕስያ በሲ ባዋ” ያግስ።<verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>ሀንኩዋኮ፥ “ኔኒ ታና ካላ” ያግስ። ሽን ኡራይ፥ “ጎዳዉ፥ ኮይሮታዳ ታ አዋ ሞጋዳ ያና” ያግስ።<verse eid="LUK 9:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60"/>ሽን የሱሲ፥ “ሀይቅዳይሳት ሀይቅዳይሳታ ሞጋና መላ ኤንታዉ አጋጋ፤ ኔኒ ባዳ ፆሳ ካዎተ ሳባካ” ያግስ።<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>ቃስ ሀራ አስ፥ “ጎዳዉ፥ ታ ነና ካላና፥ ሽን ኮይሮታዳ ታ ሶ አሳ ሳሮዳ ያና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">9:61 </char><char style="xt" closed="false"><ref loc="1KI 19:20">1 ካዎ 19:20</ref>.</char></note><verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>የሱሲ ዛሪድ፥ “ኮፀ ኦይክድ ጉየ ፄልያ ኦንካ ፆሳ ካዎተስ በሰና” ያግስ።<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s1">ላፑን ታማነ ናምኡ ታማረት ኪተትዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>ሄሳፈ ጉየ፥ ጎዳይ ሀራ ላፑን ታማነ ናምኡ<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="fq" closed="false">ላፑን ታማነ ናምኡ፦ </char><char style="ft" closed="false">እስ እስ ማፃፋት ላፑን ታማ ጎሶና፤ ቃስ ፓይዶ 17 ፄላ።</char></note> አሳታ ዶርስ። እ ባናዉ ቆፕዳ ካታማነ ጉታ ኡባ ስንትድ ባና መላ ናምአ ናምአ ኦድ ኪትስ። <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>የሱሲ ኤንታኮ፥ “ሄኮ፥ ሺቃና ካይ ዳሮ ሽን ኦሳንቾት ጉ። ያንያ ግሾ፥ ካ ጎዳይ ኦሳንቾታ ኪታና መላ ዎስተ።<note caller="-" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MAT 9:37-38">ማቶ 9:37-38</ref>.</char></note> <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/>ህዛ፥ ቢተ፥ ታኒ ህንተና ዶርሳታዳ ሱመታ ግዶ የዳና።<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">ማቶ 10:16</ref>.</char></note> <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>ህንተ ብያ ኦግያስ አይኮካ ኦይኮፍተ፥ ሚሸ ግድን ካ ግድን ጫማ ኦይኮፍተ። ኦገ ቦላ ኦናካ ሳሮፍተ።<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">ማቶ 10:7-14</ref>፤ <ref loc="MRK 6:8-11">ማር 6:8-11</ref>፤ <ref loc="LUK 9:3-5">ሉቃ 9:3-5</ref>.</char></note> <verse eid="LUK 10:4"/><verse number="5" style="v" sid="LUK 10:5"/>ህንተ ገልያ ኬ ኡባ ኮይሮትድ፥ ‘ሳሮይ ሀ ኬስ ግዶ’ ያግተ። <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>ሳሮ ዶስያ አስ ሄ በሳን ደእኮ፥ ህንተ ሳሮይ ያን ሸምፓና፤ እፃስ ጊኮ ህንተ ሳሮይ ህንተዉ ስማና። <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/>ኦሳንቾስ ዳሞዘ በሲያ ግሾ፥ ህንተ ገልዳ ኬን ህንተዉ ሺሽዳባ ኡባ ምሸነ ኡይሸ ያን ጋምእተ። እሱዋ ሶፐ እሱዋ ሶ ዩዮፕተ።<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="2CO 9:14">2 ቆሮ 9:14</ref>፤ <ref loc="1TI 5:8">1 ፅሞ 5:8</ref>.</char></note> <verse eid="LUK 10:7"/><verse number="8" style="v" sid="LUK 10:8"/>አይ ካታማካ ህንተ ገልያ ዎደ አሳይ ህንተና ሞክድ፥ ህንተዉ ሺሽዳባ ኡባ ሚተ። <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>ሄ ካታማን ደእያ ሀርጋንቾታ ፓሸ፥ ‘ፆሳ ካዎተይ ህንተኮ ማትስ’ ያግድ ኦድተ። <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/>ሽን እስ ካታማ ገልያ ዎደ አሳይ ህንተና ሞኮና እፅኮ ዳባባ ከይድ ሀይሳዳ ጊተ:<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሀዋ 13:51</ref>.</char></note> <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/>‘ኑ ቶሁዋ ቦላ ደእያ ህንተ ካታማ ባና ፕቶስ፥ ሽን ፆሳ ካዎተ ህንተኮ ማታትዳይሳ ኤርተ።’<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">ማቶ 10:7-14</ref>፤ <ref loc="MRK 6:8-11">ማር 6:8-11</ref>፤ <ref loc="LUK 9:3-5">ሉቃ 9:3-5</ref>.</char></note> <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/>ፕርዳ ጋላሳን፥ ሀ ካታማፐ ሶዶመ ካታማስ ፕርድ ካዉሸ ግዳናይሳ ታ ህንተዉ ኦዳይስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">መ 19:24-28</ref>፤ <ref loc="MAT 10:15">ማቶ 10:15</ref>፤ <ref loc="MAT 11:24">11:24</ref>.</char></note><verse eid="LUK 10:12"/></para>
  <para style="s1">አማኖና እፅዳ ካታማታ</para>
  <para style="r">(<ref loc="MAT 11:20-24">ማቶ 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>ካልድካ፥ የሱሲ፥ “ነኖ ኮራዝነ፥ ነኖ ቤተሳይዳ፥ አየ! ህንተናን ኦሰትዳ ማላታት ፅሮሳንነ ስዶናን ኦሰትዳኮ ያን ደእያ አሳይ ካዮ ማኦ ማእድ፥ ብድን ቦላ ኡትድ፥ በን ማሮታን ገል አጋናሽን።<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">እሳ 23:1-18</ref>፤ <ref loc="EZK 26:1-21">ህዝ 26:1-21</ref>፤ <ref loc="JOL 3:4-8">እዩ 3:4-8</ref>፤ <ref loc="AMO 1:9-10">አሞ 1:9-10</ref>፤ <ref loc="ZEC 9:2-4">ዛካ 9:2-4</ref>.</char></note> <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>ሄሳ ግሾ፥ ህንተፈ አድ ፅሮሳስነ ስዶናስ ፆሳ ፕርድ ካዉያና። <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/>ነካ ቅፍርናሆማ፥ ሳሎ ጋካናዉ ነና ቁ ኦናዉ ኮያይ? ነ ዱገ ስኦለ ሆለታና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">እሳ 14:13-15</ref>.</char></note><verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>ቃስካ የሱሲ ባ ታማረታኮ፥ “ህንተና ስኤይ ታና ስኤስ፥ ህንተና ኤኮናይ ታና ኤከና፥ ታና ኤኮናይ ታና ኪትዳይሳ ኤከና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ 10:40</ref>፤ <ref loc="MRK 9:37">ማር 9:37</ref>፤ <ref loc="LUK 9:48">ሉቃ 9:48</ref>፤ <ref loc="JHN 13:20">ዮሀ 13:20</ref>.</char></note><verse eid="LUK 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>ላፑን ታማነ ናምኡ ታማረት ኪተትዳ በሳፈ ዳሮ ኡፋይትሸ ስምዶሶና። የሱሳኮ ሺቅድ፥ “ጎዳዉ፥ ነ ሱንን ቱና አያናትካ ኑስ ኪተትዶሶና” ያግዶሶና።<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>የሱሲ ኤንታኮ፥ “ፃላሄይ ሳሎፐ ዎልአንዳ ዎሽን ታ በአስ። <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/>ሄኮ፥ ሾሽነ ኮርነ የና መላነ ሞርክያ ዎልቃ ዛራና መላ ማታ ህንተዉ እማስ። ህንተና ቆሀናባይ አይኮይካ ዴና።<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="PSA 19:13">ማዝ 19:13</ref>.</char></note> <figure style="fig" alt="Scorpion" file="BK00058B.tif" size="col" ref="10:19">ኮርነ</figure> <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>ግዶሽን፥ ህንተ ሱንይ ሳሎ ማዝጋበን ፃፈትዳ ግሾ፥ ኡፋይትተፐ አትሽን፥ ቱና አያናት ኪተትዳ ግሾ ኡፋይቶፍተ” ያግስ።<verse eid="LUK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>ሄ ዎደ፥ የሱሲ ጌሻ አያናን ኡፋይትድ፥ “ሳሉዋ ሳኣ ጎዳዉ፥ ሀይሳ ጭንጫታፐነ ኤራንቾታፐ ገንዳ ያላጋታስ ቆንጭስዳ ግሾ ጋላተታ። ኤ፥ ታ አዋዉ፥ ሄሳ ነ ኦናዉ ሎኦ ሸነ ግድስ።<verse eid="LUK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>“ኡባባይ ታ አዋፐ ታዉ እመትስ። ናአይ ኦነኮ አዋፐ አትሽን፥ ሀር ዎይኮ ናአይ ቆንጭሳናዉ ኮየይሳፈ ሀር ኦንካ አዋ ኤረይ ባዋ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="JHN 3:35">ዮሀ 3:35</ref>፤ <ref loc="JHN 10:15">10:15</ref>.</char></note><verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>ካልድካ፥ የሱሲ ባ ታማረታስ ዱማ፥ “ህንተ በኤይሳ በኤይሳት አንጀትዳይሳታ። <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>ቱማ ዳሮ ናበትነ ካዎት ህንተ በኤይሳነ ስኤይሳ በአናዉነ ስአናዉ አሞትዶሶና፥ ሽን በእቦኮና፥ ስእቦኮና” ያግስ።<verse eid="LUK 10:24"/></para>
  <para style="s1">ቱማ ሲቆ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>ሄኮ፥ እስ ጋላስ ሙሰ ዎጋ ኤርያ እስ ኡራይ ደንድድ የሱሳ ያግድ ፓጨ ኦይሾ ኦይችስ። “አስታማርያዉ፥ መርና ደኦ ላታናዉ ታኒ አይ ኦ?” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 22:35-40">ማቶ 22:35-40</ref>፤ <ref loc="MRK 12:28-34">ማር 12:28-34</ref>.</char></note><verse eid="LUK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26"/>የሱሲ፥ “ሙሰ ማፃፋን ፃፈትዳይስ ዎይጊ? ነ ዋታ ናባባይ?” ያግስ።<verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>አደይ ዛሪድ፥ “ ‘ነ ጎዳ ነ ፆሳ፥ ነ ኩመ ዎዛናፐ፥ ነ ኩመ ሸምፖፈ፥ ነ ኩመ ዎልቃፈነ ነ ኩመ ቆፋፐ ዶሳ። ቃስ ነ ሾሩዋ ነ ሁጰዳ ዶሳ’ ያጌስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌወ 19:18</ref>፤ <ref loc="DEU 6:5">ዛረ 6:5</ref>.</char></note><verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>የሱሲ እያኮ፥ “ኔኒ ልከ ዛራዳሳ፥ ነካ ሄሳዳ ኦ። ኔኒ መርናዉ ደኦን ዳና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ሌወ 18:5</ref>.</char></note><verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>ሽን ኡራይ ባና ፅሎ ኦናዉ ኮይድ፥ “እ ታ ሾሮይ ኦኔ?” ያግስ።<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>እያ ኦይሻስ የሱሲ ያግድ ዛሮ እሚስ፤ “እስ አሰ ደኤይስ የሩሳላመ ካታማፐ ዱገ እያርኮ ካታማ ብሽን፥ ኦገ ቦላ ፓንጋት ከይድ ሾጭዶሶና። እያ ማኡዋ ቃር ኤክድ ሀይቆፐነ ፓፃፐ ግዶን የግድ ብዶሶና። <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>ጉየፐ፥ አይሁደ ካህነ እሶይ ሄ ኦግያራ ባ ቡሱ ብሸ ኡራ በእድ ደሽ ግድ አስ። <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>ቃስ እስ ሌወ ደኤይስ ሄ በሳ ጋክሸ ኡራ በእድ፥ ሀራ ሶራ አድ ብስ። <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>ሽን፥ እስ ሳማረ ቢታ አሰ ደኤይስ ሄ ኦግያራ ይሸ ኡራ በእድ እያዉ ቃትስ<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2CH 28:15">2 ታር 28:15</ref>.</char></note> <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>እያኮ ሺቅድ፥ እያ ማዱን ቦላ ዛይተነ ዎይነ ትግድ ቃችስ። ባ ሀርያ ቦላ ኡትስድ እማ አቅያ ኬ ኤፍስ። ሄ በሳን እያዉ ኮሽያባ ኡባ ኦስ። <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>ዎንተ ናምኡ ድናረ ከስድ እማ ኬ አዋስ እምድ፥ ‘ሀያና ሀ ኡራ ሎይ ፄላ። ታኒ ነዉ እምዳይሳፈ ቦላራ ነ ከስያባ ኡባ ታ ነዉ ጭጋና’ ያግስ።<verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>“ህዛ፥ ሀ ሄ አሳታፐ ፓንጋት ሾጭዳ ኡራስ ሾሮተይ ነዉ ኦና ዳኒ?”<verse eid="LUK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37"/>ኡራይ ዛሪድ፥ “እያዉ ቃትዳይሳካ” ያግስ።</para>
  <para style="p" vid="LUK 10:37">የሱሲ፥ “ነካ ባዳ ሄሳዳ ኦ” ያግስ።<verse eid="LUK 10:37"/></para>
  <para style="s1">የሱሲ ማርታነ ማይራም ሶን</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>የሱሲ ባ ታማረታራ ኦገ ብሸ እስ ጉታ ጋክስ። ያን ማርታ ጌተትያ እስ ማጫስያ፥ እያ ባ ሶን ሞካሱ።<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="JHN 11:1">ዮሀ 11:1</ref>.</char></note> <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>እዉካ ማይራሞ ጌተትያ ምችያ ደአዉሱ፥ ማይራማ ቃላ ስአሸ ጎዳ ቶሁዋ ማታን ኡታሱ። <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>ሽን ማርታ ዳሮ ኦሶን ኡንኤታዳ የሱሳኮ ሺቃዳ፥ “ጎዳዉ፥ ታ ምችያ ኦሱዋ ታ ፃላላስ የጋዳ ኡታ አግን ታ ዳቡርያ ዎደ ኔኒ በአሸ ስእ ጋይ? እያ ታና ማዳና መላ ኦድኪ” ያጋሱ።<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>ሽን ጎዳይ ዛሪድ፥ “ማርታ፥ ማርታ፥ ኔኒ ዳሮባን ኡንኤታሳነ መቶታሳ። <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>ግዶሽን፥ ኮየተይ እስባ ፃላላ። ማይራማ ሎኦባ ዶራሱ፥ ሄስካ ኢፐ ኤከተና” ያግስ።<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s1">የሱሲ ዎሳባ ታማርስስ</para>
  <para style="r">(<ref loc="MAT 6:9-13">ማቶ 6:9-13</ref>፤ <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>እስ ጋላስ የሱሲ እስ በሳን ዎሴስ። ዎሳ ዉርስዳ ዎደ እያ ታማረታፐ እሶይ፥ “ጎዳዉ፥ ዮሃንስ ባ ታማረታ ዎሳ ታማርስዳ መላ ነካ ኑና ዎሳ ታማርሳ” ያግስ።<verse eid="LUK 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2"/>የሱሲ፥ “ሀይሳዳ ያግድ ዎስተ፦</para>
  <para style="q1" vid="LUK 11:2">“ ‘ሳሎን ደእያ ኑ አዋዉ</para>
  <para style="q2" vid="LUK 11:2">ነ ጌሻ ሱንይ አንጀቶ፤</para>
  <para style="q2" vid="LUK 11:2">ነ ካዎተይ ዮ።<verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>ኑ ጋላሳ ካ ሀች ሀች ኑስ እማ።<verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>ኑና ቆሄይሳታ ኑኒ አቶ ገይሳዳ፥</para>
  <para style="q2" vid="LUK 11:4">ኑ ናጋራ አቶ ጋ፤</para>
  <para style="q2" vid="LUK 11:4">ፓጨን ኑና ገልሶፋ’ ያግተ” ያግስ።<verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5"/>ካልድካ፥ የሱሲ ባ ታማረታኮ ያግስ፦ “ሌምሶስ ህንተፈ እሱዋስ ላገይ ደኤስ። እ ግድ ብላሄ ባ ላግያ ሶ ብድ፥ ‘ታ ላግያዉ፥ ምያባይ ደእኮ ታዉ እማርክ። <verse eid="LUK 11:5"/><verse number="6" style="v" sid="LUK 11:6"/>ታዉ ላገ ግድዳ እስ አስ ኦገፐ ይን፥ እያዉ አያባ ያስ’ ያግኮ፥<verse eid="LUK 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 11:7"/>“እያ ላገይ ኬ ግዶን ግድድ፥ ‘ሀያና ታና ዋይሶፓ፥ ፐንገይ ጎርደትስ። ታ ናይትካ ታራ አርሳ ቦላ ዝንእዶሶና። ያንያ ግሾ፥ ደንዳዳ ነ ኮያባ እማናዉ ዳንዳእከ’ ያግዬ? <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>ታ ህንተዉ ኦዳይስ፤ ላገተ ግሾ ደንድድ እማናዉ ኮዮና እፅኮካ ዎሳን ሳለዳ ግሾ፥ ደንድድ ኮሽያባ ኡባ እሜስ።<verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>“ሄሳ ግሾ፥ ታኒ ህንተዉ ኦዳይስ፤ ዎስተ ህንተዉ እመታና፤ ኮይተ ህንተ ደማና፤ ካረ ይድ ፄግተ ህንተዉ ዶየታና። <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>ጋሶይካ፥ ዎስያ ኡባይ ኤኬስ፤ ኮየይ ደሜስ፤ ካረ ይድ ፄገይሳስ ዶየቴስ።<verse eid="LUK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11"/>“ህንተኖ፥ አዋቶ ህንተ ግዶፈ ናእ ኡይ ዎስን፥ ሹቹ እመይ ኦኔ? ሞሎ ዎስን ሾሽ እመይ ኦኔ? <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>ዎይኮ ጱጱለ ዎስኮ ኮርነ እሚ? <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>ህንተ ኢታታ ግድሸ ህንተ ናይታስ ሎኦባ እሞ ኤርኮ፥ ሳሎን ደእያ ህንተ አዋይ ዎሰይሳታስ ጌሻ አያና ዋትድ አድ እመኔ?” ያግስ።<verse eid="LUK 11:13"/></para>
  <para style="s1">የሱሳነ ብኤል-ዘቡላ</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>እስ ጋላስ የሱሲ፥ ዶና ሙምስዳ ቱና አያና እስ ኡራፐ ከስስ። ቱና አያናይ ከይዳ መላ ሙመ ኡራይ ኦደትስ። አሳይካ ማላለትስ። <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>ሽን እሶት እሶት፥ “ቱና አያና ሀላቃ፥ ብኤል-ዘቡላ ዎልቃን ቱና አያናታ ከሴስ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ 9:34</ref>፤ <ref loc="MAT 10:25">10:25</ref>.</char></note> <verse eid="LUK 11:15"/><verse number="16" style="v" sid="LUK 11:16"/>ሀራት ቃስ ፓጬስ ሳሎፐ ማላ በሳና መላ ኮይዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ 12:38</ref>፤ <ref loc="MAT 16:1">16:1</ref>፤ <ref loc="MRK 8:11">ማር 8:11</ref>.</char></note><verse eid="LUK 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17"/>ሽን የሱሲ ኤንታ ቆፋ ኤርድ ኤንታኮ፥ “ዎል ግዶን ሻከትያ ካዎተ ኡባይ ዬስ፤ ዎል ግዶን ሻከትያ ኬ ኩንዴስ። <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>ፃላሄይ ዎል ግዶን ሻከትኮ እያ ካዎተይ ዋንድ ምንድ ኤቃኔ? ህንተ ታና፥ ‘እ ቱና አያናታ ብኤል-ዘቡላ ዎልቃን ከሴስ’ ያጌታ። <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>ህዛ፥ ታኒ ቱና አያና ብኤል-ዘቡላ ዎልቃን ከስያባ ግድኮ ህንተ ናይት ኦደ ዎልቃን ከሶናሻ? ሄሳ ግሾ፥ ኤንቲ ህንተ ቦላ ፕርደይሳታ ግዳና። <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>ሽን ታኒ ቱና አያናታ ፆሳ ብራን ከስያባ ግድኮ፥ ህዛ፥ ፆሳ ካዎተይ ህንተኮ ማትዳይሳ ኤርተ።<verse eid="LUK 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21"/>“ምኖ አስ ቶራነ ጎንዳለ ኦይክድ፥ ባ ኬ ናግያባ ግድኮ፥ እያ ሻሎይ ቦሸተና። <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>ሀኖሽን፥ እያፐ አድ ምኖ ግድዳ አስ ይድ፥ እያ ቆህድ ፆንኮ፥ አማነትዳ ቶራነ ጎንዳለ ዎስስ ኤክድ፥ እያ ሻሉዋ ቦንቅድ ሀራስ ሻኬስ።<verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>“ታራ ግዶናይስ ታና እፄስ፤ ታራ ሺሾናይስ ላሌስ።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር 9:40</ref>.</char></note><verse eid="LUK 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>“ቱና አያናይ አሳፐ ከይዳ ዎደ ሸምፕያ በሲ ኮይድ ሃ ባይና ሶራ ዩዬስ። ሸምፕያ በሲ ይዳ ዎደ፥ ‘ታ ከይዳሱዋ ስማና’ ያጌስ። <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>እ ስምያ ዎደ ኬይ ፕተትድ ሎእድ ደእሽን ደምስ። <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>ሄሳፈ ጉየ፥ ብድ እያፐ አድ ኢትዳ ሀራ ላፑን ቱና አያናታ ኤክድ ዬስ። እያን ገልድ ዱሱ ኦይኬስ። ሄ ኡራስ ኮይሮይሳፈ አድ ጉየይስ ኢታ ግዴስ” ያግስ።<verse eid="LUK 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>የሱሲ ሄሳ ኦዳ ቦላ ደእሽን፥ እስ ማጫስ አሳ ጋፈ ደንዳዳ፥ ባ ቃላ ቁ ኦዳ፥ “ነና ቶክዳ ኡሎይነ ኔኒ ምዳ ንት አንጀትዶሶና” ያጋሱ።<verse eid="LUK 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28"/>ሽን እ፥ “አንጀትዳይሳት ፆሳ ቃላ ስእድ ኪተተይሳታ” ያግስ።<verse eid="LUK 11:28"/></para>
  <para style="s1">ዮናሳ ማላታ</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>ዳሮ አሳይ ሺቅዳ ዎደ የሱሲ፥ “ሀ የለተይ ኢታ የለተ፤ ኦራ ማላ ኮዬስ። ሽን ዮናሳ ማላታፐ አትሽን፥ ሀር ኤንታዉ እመተና።<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="MAT 16:4">ማቶ 16:4</ref>፤ <ref loc="MRK 8:12">ማር 8:12</ref>.</char></note> <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/>ዮናስ ናናወ አሳስ ማላ ግድዳ መላ አሳ ናእካ ሀ የለተስ ማላ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JHN 3:4">ዮሀ 3:4</ref>.</char></note> <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>ዱገሀ ካውያ ፕርዳ ጋላስ ሀ የለተራ ደንዳዳ ፕርዳና። ጋሶይካ፥ እያ ሶሎሞነ ጭንጫተ ስአናዉ ቢታ ጋፃፐ ደንዳዳ ያሱ። ሄኮ ሶሎሞነፐ አይ ሀይሳን ደኤስ<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 ካዎ 10:1-10</ref>፤ <ref loc="2CH 9:1-12">2 ታር 9:1-12</ref>.</char></note> <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>ናናወ አሳት ፕርዳ ጋላስ ሀ የለተራ ደንድድ ኤንታ ቦላ ፕርዳና። ጋሶይካ፥ ዮናሳ ስብካትያን ማሮታ ገልዶሶና። ሄኮ፥ ዮናሳፐ አይ ሀይሳን ደኤስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JHN 3:5">ዮሀ 3:5</ref>.</char></note><verse eid="LUK 11:32"/></para>
  <para style="s1">አሳተ ፖኦ</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>“ፆምፐ ኦይድ ቆሳ በሳን ዎይኮ ኦቶ ግዶን ዎያ አስ ዴና። አስ ፖኡዋ በአና መላ ቃ በሳን ዎስ።<note caller="-" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ 5:15</ref>፤ <ref loc="MRK 4:21">ማር 4:21</ref>፤ <ref loc="LUK 8:16">ሉቃ 8:16</ref>.</char></note> <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>ነ አሳተስ ፖኦይ ነ አይፍያ። ነ አይፈይ ሎኦ ግድኮ፥ ነ ኩመ አሳተይ ፖኤስ። ነና አይፈይ ሳክኮ ነ አሳተይ ኡባይ ሜስ። <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>ሄሳ ግሾ፥ ነ ጋርሳን ደእያ ፖኦይ ሞና መላ ናገታ። <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>ህዛ፥ ነ ኩመ አሳተይ ፖኦ ግድኮ፥ ነ አሳተንካ ሀር ማ በሲ ይኮ፥ ነ አሳተ ኩመይ ዎልለ ፖኦ መላ ግዴስ” ያግስ።<verse eid="LUK 11:36"/></para>
  <para style="s1">ኡሱፑን አየታ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ 23:1-36</ref>፤ <ref loc="MRK 12:38-40">ማር 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>የሱሲ ባ ኦዳ ኦንግዳ መላ እስ ፋርሳወይ ባራ ካ ማና መላ ፄግስ። የሱሲ፥ እያራ እስፈ ገልድ ግብራ ቦላ ኡትስ። <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>ፋርሳወይ የሱሲ ካ ማናፐ ስን ኩሸ ሜጮናይሳ በእድ ማላለትስ።<verse eid="LUK 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39"/>ጎዳይ እያኮ፥ “ህንተ ፋርሳወት ቁለስነ ሻተስ ቦላ ባጋ ሜጨታ። ሽን ህንተ ጋይ ኡዘተንነ ኢታተን ኩምስ። <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>ህንተኖ፥ ኤያቶ፥ ካረ ባጋ መዳይ፥ ጋ ባጋ መዳይ እያ ግደኔ? <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>ሽን ቁልያንነ ሻትያን ደኤይሳ ማንቆታስ እምተ። ሄ ዎደ ህንተዉ ኡባባይ ጌሽ ግዳና።<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>“ፋርሳወቶ ህንተና አየ! ሳዎፐ፥ ፃሎተፐነ ሄሳ መላባፐ አስራታ ከሴታ። ሽን ፅሎተነ ፆሰ ዶሶይ ህንተናን ባዋ። ሀራታ አጎና ሀይሳታካ ኦናዉ በሴስ፥ ሽን አግደታ።<note caller="-" style="x"><char style="xo" closed="false">11:42 </char><char style="xt" closed="false"><ref loc="LEV 27:30">ሌወ 27:30</ref>.</char></note><verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>“ፋርሳወቶ ህንተና አየ! አይሁደ ዎሳ ኬን ቦንቾ ኦይደ፥ ግያ ግዶን ቦንቾ ሳሮ ዶሴታ።<verse eid="LUK 11:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44"/>“ማል ይን፥ አሳይ ኤሮና ቦላራ ብያ ዱፎ ዳነይሳቶ ህንተና አየ!” ያግስ።<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>ህገ አስታማረይ ዛሪድ፥ “አስታማርያዉ፥ ነ ሄሳ ጋሸ ኑና ጫያሳ” ያግስ።<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>የሱሲ፥ “ህንተኖ፥ ህገ አስታማረቶ፥ ህንተናካ አየ! አሳይ ቶካናዉ ዳንዳኦና ዴፆ ቶሆ ቶሰታ፥ ሽን ህንተ ህንተ ሁጰስ ሀር አቶሽን ብራ ፄራንካ ቦቸከታ።<verse eid="LUK 11:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47"/>“ህንተ አዋት ዎዳ ናበታ ዱፉዋ ህንተ ጊግስያ ግሾ፥ ህንተና አየ! <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>ህዛ፥ ህንተ አዋታ ኦሱዋ ምንናዉ ኤንቲ ዎዳ ናበታ ዱፉዋ ህንተ ሎይያ ግሾ፥ ኤንታ ኢታ ኦሱዋስ ህንተ ማርካ። <verse eid="LUK 11:48"/><verse number="49" style="v" sid="LUK 11:49"/>ሄሳ ግሾ፥ ፆሳይ ባ ጭንጫተን፥ ‘ናበታነ ሀዋረታ ታ ህንተዉ ኪታና፥ ሽን ህንተ ባጋታ ዎና፤ ሀራታ ጎዳና’ ያግስ። <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/>ሀ የለተይ አላመይ መቶሳፐ ሀኖ ጋካናዉ ጉክዳ ናበታ ኡባ ሱስ ኦይሸታና። <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>አበላፐ ዶምድ ያርሾ በሳስነ ፆሳ ኬፈ ግዱዋን ጉክዳ ዛካርያሳ ሱ ግሾ ሀ የለተይ ኦይሸታና።<note caller="-" style="x"><char style="xo" closed="false">11:51 </char><char style="xt" closed="false"><ref loc="GEN 4:8">መ 4:8</ref>፤ <ref loc="2CH 24:20-21">2 ታር 24:20-21</ref>.</char></note><verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>“ህገ አስታማረቶ፥ ህንተና አየ! ኤራተ ቁልፕያ ህንተ ኩሸን ኦይክደታ፥ ሽን ህንተዉ ገለከታ ሀራታካ ገልሰከታ” ያግስ።<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>የሱሲ ያፐ ባናዉ ከይያ ዎደ፥ ህገ አስታማረትነ ፋርሳወት እያራ ኤቀትድ ኦይሾን ዋይሶሶና። <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>እያ ዶናፐ ከይያ ቃላን እያ ኦይካናዉ ኮይድ ሄሳ ኦዶሶና።<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s1">አያና ምን</para>
  <para style="r">(<ref loc="MAT 10:26-27">ማቶ 10:26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>ሄ ዎደ ዳሮ ሙኩሉን ታይበትያ አሳይ ዎል ቦላ የታና ጋካናዉ አስ አሳ ቦላ ሺቅድ ደእሽን፥ የሱሲ ባ ታማረታኮ፥ “ፋርሳወታ እርሾፈ ናገትተ። ሄስካ ኤንታ ጩቦተ።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 16:6">ማቶ 16:6</ref>፤ <ref loc="MRK 8:15">ማር 8:15</ref>.</char></note> <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/>ቆንጮና ቆሰትድ፥ ኤረቶና ጌምድ አትያባይ አይኮይካ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር 4:22</ref>፤ <ref loc="LUK 8:17">ሉቃ 8:17</ref>.</char></note> <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>ህዛ፥ ህንተ ማን ኦደትዳባይ ኡባይ ፖኦን ስኤታና፥ ቆልአ ጋን ካልካሽዳባይ ዳባባን ኦደታና።<verse eid="LUK 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>“ታ ባጋቶ፥ ታ ኦደይሳ ስእተ፤ አሹዋ ዎኦሶናፐ አትሽን፥ ሀራ አይኮካ ኦናዉ ዳንዳኦናይሳታስ ባቦፍተ። <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>ሀኖሽን፥ ህንተ ባባናዉ በሰይሳ ታ ህንተዉ ቆንጭሳና። ሄስካ ዎዳፐ ጉየ ጋናመን የጋናዉ ዎልቃይ ደኤይሳስ እያዉ ባብተ። ኤ፥ ቱማ ኦዳይስ፤ እያዉ ባብተ። <verse eid="LUK 12:5"/><verse number="6" style="v" sid="LUK 12:6"/>እቻሹ ቡበት እስ ሳንትመስ ባይዘቶኮናዬ? ሀኖሽን፥ ኤንታፈ እስናካ ፆሳ ስንን ዶገቱኩ። <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>ሀር አቶሽን፥ ህንተ ሁጰ ብናናይካ ፓይደትድ ደኤስ። ህዛ፥ ባቦፍተ፤ ዳሮ ቡበታፐ ህንተ አታ።<verse eid="LUK 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>“ታ ኦደይሳ ስእተ፤ አሳ ስንን ታዉ ማርካትያ ኡባስ አሳ ናእ ፆሳ ኪታንቾታ ስንን ማርካታና። <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>አሳ ስንን ታና ካደይሳስ ፆሳ ኪታንቾታ ስንን ታ እያ ካዳና። <verse eid="LUK 12:9"/><verse number="10" style="v" sid="LUK 12:10"/>አሳ ናአ ቦላ ካ ቃላ ሃሳያ ኡባይ ማሮታ ደማና፥ ሽን ጌሻ አያና ቦላ ካ ቃላ ኦደተይስ ማረተና።<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="MAT 12:32">ማቶ 12:32</ref>፤ <ref loc="MRK 3:29">ማር 3:29</ref>.</char></note><verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>“አስ ህንተና ኦይክድ አይሁደ ዎሳ ኬን፥ ዳይናታ ስንንነ ካዎታ ስንን ጎሸችያ ዎደ አይ ኦዳነኮነ ዎይግ ዛራነኮ ህርጎፍተ።<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="MAT 10:19-20">ማቶ 10:19-20</ref>፤ <ref loc="MRK 13:11">ማር 13:11</ref>፤ <ref loc="LUK 21:14-15">ሉቃ 21:14-15</ref>.</char></note> <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>ሄ ዎደ ህንተ ኦዳናባ ጌሻ አያን ህንተና ታማርሳና” ያግስ።<verse eid="LUK 12:12"/></para>
  <para style="s1">ዱረ ኡራ ኤያተ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>አሳ ግዶፈ እስ አስ የሱሳኮ ይድ፥ “ታ እሻይ ታዉ ኑ አዋ ላታፐ ሻካና መላ እያዉ ኦዳ” ያግስ።<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>የሱሲ ዛሪድ፥ “ላ አድያዉ፥ ህንተ ቦላ ታና ዳይናነ ላታ ሻክያ ጭማ ኦዳይ ኦኔ?” ያግስ። <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>ጉጅድካ፥ የሱሲ፥ “አሳ ደኦይ ሻሎ ዳሮተን ግዶና ግሾ ያረ አግድ ምንድ ህንተና ናግተ” ያግስ።<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>ካልድካ ሌምሶን፥ “ጋደይ ዳሮ ካ እምያ እስ ዱረ ኡራይ ደኤስ። <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>ሄ ኡራይ፥ ‘ታ ካ ታኒ ሺሻናዉ በሲ ጉፅዳ ግሾ አይ ኦ?’ ያግድ ባ ዎዛናን ቆፕስ። <verse eid="LUK 12:17"/><verse number="18" style="v" sid="LUK 12:18"/>ህዛፐ ያታና፤ ካሰ ደእያ ሻለታ ላላዳ ሀራ ዳልጋ ሻለታ ኬፃና። ካነ ታዉ ደእያባ ኡባ እያን የጋና። <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>ባ ሸምፐኮ፥ ‘ታ ሸምፐተ፥ ዳሮ ላይስ ነዉ ግድያ ሻሎ ሺሻስ። ህዛ፥ ሸምፓዳ ማ፥ ኡያ፥ ኡፋይታ’ ያጋና።<verse eid="LUK 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20"/>“ሽን ፆሳይ፥ ‘ላ፥ ኤያ ኡራዉ፥ ሀች ቃማ ነ ሸምፕያ ኔፐ ኤከታዉሱ። ህዛ፥ ነ ሺሽዳባይ ኦደስ ግዳኔ?’ ያግስ።<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>“ሄሳ ግሾ፥ ባዉ ዱረተ ሳአን ሺሽያ አሳስ፥ ፆሳ ማታን ዱረ ግዶና አሳስ ዉርሰይ ሀ ኡራ መላ” ያግስ።<verse eid="LUK 12:21"/></para>
  <para style="s1">ኡንኤቶፍተ</para>
  <para style="r">(<ref loc="MAT 6:25-34">ማቶ 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>ሄሳፈ ጉየ፥ የሱሲ ባ ታማረታኮ፥ “ህዛ፥ ታ ኦድያባ ስእተ፥ ህንተ ሸምፑዋስ አይ ሚኖ? ህንተ አሳተስ አይ ማእኖ? ያግድ ኡንኤቶፍተ። <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/>ሸምፖይ ካፈ፥ አሳተ አፍላፐ አስ። <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>ካፎታ በእተ ዘሮኮና፥ ኪሾኮና፥ ኤለይነ ሻለይ ኤንታዉ ባዋ። ሽን ፆሳይ ኤንታና ሙዜስ። ህንተ ካፎታፐ ዳሮ አታ። <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>ሀኖሽን፥ ህንተፈ ኡንኤትድ ባ ላይ ቦላ እስ ቃማ ጉጃናዉ ዳንዳኤይ ኦኔ? <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/>ህዛ፥ ሀ ጉባ ኦናዉ ዳንዳኦና ህንተ፥ ሀራባስ አይስ ኡንኤተቲ? <verse eid="LUK 12:26"/><verse number="27" style="v" sid="LUK 12:27"/>አነ ጪሻት ዋንድ ድጭያኮ በእተ። ዋዮኮናነ ሱቆኮና። ሀር አቶሽን፥ ሶሎሞነይ ባ ደእያ ቦንቾ ኡባን ኤንታፈ እሱዋ መላካ ማእቤና።<note caller="-" style="x"><char style="xo" closed="false">12:27 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 ካዎ 10:4-7</ref>፤ <ref loc="2CH 9:3-6">2 ታር 9:3-6</ref>.</char></note> <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>ህንተኖ፥ አማኖይ ፓጭዳይሳቶ፥ ህዛ፥ ፆሳይ ሀች በንትድ ዎንቶ ታማን የገታና ጪሻታ ሀይሳዳ ማይዝኮ፥ ህንተና ዋት አድ ማይዘኔ? <verse eid="LUK 12:28"/><verse number="29" style="v" sid="LUK 12:29"/>ሄሳ ግሾ፥ አይ ምኖ ዎይኮ አይ ኡይኖ ግድ ኡንኤቶፍተ። <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>ሄ ኡባስ ፆሳ አማኖና አሳት ኡንኤቶሶና። ሽን ህንተ አዋይ ፆሳይ ሄስ ኡባይ ህንተዉ ኮሸይሳ ኤሬስ። <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>ኡባፈ አድ ፆሳ ካዎተ ኮይተ፤ ሄስ ኡባይ ህንተዉ ጉጅ እመታና።<verse eid="LUK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>“ህንተኖ፥ ጉ ደረቶ፥ ያዮፍተ፤ ህንተ አዋ ፆሳይ ካዎተ ህንተዉ እማናዉ ኡፋይቴስ። <verse eid="LUK 12:32"/><verse number="33" style="v" sid="LUK 12:33"/>ህንተዉ ደእያባ ባይዝድ ማንቆታስ እምተ። ካይሶይ ኤኮናሶን፥ ብል ሞናሶን፥ ጭሞና ካርፂታን፥ ዉሮና ሻሎ ሳሎን ሺሽተ። <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>ህንተ ዎዛናይ ህንተ ሻሎይ ደእያ በሳን ግዳና።<verse eid="LUK 12:34"/></para>
  <para style="s1">ባርክድ ናጎ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>“ቃንን ዳንጭድ ጊገትተ፤ ህንተ ፆምፐይ ፖኦ።<note caller="-" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="MAT 25:1-13">ማቶ 25:1-13</ref>.</char></note> <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/>ባንታ ጎዳይ ያጋኖፐ ስማና ጋካናዉ ባርክድ ናገይሳታዳ፥ ጎዳይ ይድ ፄግያ ዎደ ኤለስድ ዶያናዉ ጊግዳ አሳታ ዳንተ።<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">ማር 13:34-36</ref>.</char></note> <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>ባንታ ጎዳይ ስምያ ዎደ ስኮና ደእሸ ናገይሳት አንጀትዳይሳታ። ቱማ ጋይስ፤ ጎዳይ ቃንን ዳንጭድ ጋይታ ዩሾን ኡትስድ ሞኬስ። <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>ጎዳይ ላደ ግድን፥ ግድ ብላሄ ግድን፥ ዎይኮ ዎንት ማ ግድን ይድ፥ ሄሳ መላ ስኮና ናግሽን ደምያ ሄ አይለት አንጀትዳይሳታ። <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/>ሽን ሀይሳ ኤርተ፤ ካይሶይ አዉደ ያነኮ ኬ አዋይ ኤርያኮ ኬይ ቦከትያ ዎደ ስእ ግድ በኤና።<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 24:23-44">ማቶ 24:23-44</ref>.</char></note> <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>ህንተካ ጊግድ ናግተ፤ አሳ ናእ ህንተ ቆፖና ዎደ ያና” ያግስ።<verse eid="LUK 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>ጰፅሮስካ፥ “ጎዳዉ ሀ ሌምሱዋ ኑ ፃላላስ ኦዳየ ዎይኮ አሳ ኡባሴ?” ያግስ።<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>ጎዳይ ዛሪድ፥ “ህዛ፥ ካ ሙዛናዉ በሲያ ዎድያን እማና መላ ጎዳይ ባ አይለታ ቦላ ሹምዳ አማንይስነ ዎዛናማ ሀላቃይ ኦኔ? <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>ጎዳይ ስምያ ዎደ ሄሳ መላ ኦሸ በንትያ አይለይ፥ እ አንጀትዳይሳ <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>ታ ህንተዉ ቱማ ኦዳይስ፤ ባ ጎዳስ ደእያ ሻሎ ኡባ ቦላ እ፥ ሹመታና። <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>ሽን ሄ አይለይ፥ ‘ታ ጎዳይ ኤለ ዬና’ ያግድ ባ ዎዛናን ቆፕድ፥ ማጫ አይለታነ አደ አይለታ ዋኮ፥ ቃስ ባዉ ኮይዳ መላ ምሸነ ኡይሸ ማትኮ፥ <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>ሄ አይልያ ጎዳይ፥ እ ቆፖና ጋላሳንነ ህርጎና ዎደ ያና። ይድ እያ ቃንፀረድ፥ እያ ቃዳ አማኖና አሳራ ኦና።<verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>“ጎዳ ሸንያዳ ጊጎናይስነ እያ ጎዳይ አይ ዶስያኮ ኤርሸ ኦና አይለይ ዳሮ ጋራፈታና። <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>ሽን ባ ጎዳ ሸንያ ኤሮና አትድ ጋራፈታናዉ በሰይሳ ኦዳይ ጉራ ጋራፈታና። ጋሶይካ ዳሮ እመትዳይሳፈ ዳሮ ኮየቴስ፥ ዳሮ ሀዳራ ኤክዳይሳፈካ ዳሮ እማና ግድ ናገቴስ።<verse eid="LUK 12:48"/></para>
  <para style="s1">ሳሮተ ግዶናሽን ሻከተ</para>
  <para style="r">(<ref loc="MAT 10:34-36">ማቶ 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>“ታኒ ይዳይ ቢታ ቦላ ታማ ኦይናሳ። ሀእ ታማይ ኦይክያኮ ታና ዋንድ ኡፋይሳንደሻ! <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/>ሀኖሽን፥ ታ ሀእ ፃማቀተይ ፅንቃተይ ደኤስ። እ ፖለታና ጋካናዉ ታ ዳሮ ኡንኤታይስ።<note caller="-" style="x"><char style="xo" closed="false">12:50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">ማር 10:38</ref>.</char></note> <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>ሳአ ቦላ ሳሮተ ኤሀናዉ ይዳ ህንተዉ ዳኒ? ግደና፥ ታ ይዳይ ሻካናሳ። <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>ሀእፈ ዶምድ ዎል ግዶን ሻከትዳ እቻሹ ኬ አሳት እስፈ ደኦሶና። ናምአት ሄታ ቦላ፥ ሄትካ ናምአታ ቦላ፥ ደንድድ ሻከቶሶና። <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>አዋይ ናኣ ቦላ፥ ናአይካ አዋ ቦላ፥ አይያ ናኤ ቦላ፥ ናእያ አየ ቦላ፥ አዝና አይያ ናአ ማቸ ቦላ፥ ናአ ማችያ አዝና አየ ቦላ፥ ደንድድ ሻከታና።”<note caller="-" style="x"><char style="xo" closed="false">12:53 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ምክ 7:6</ref>.</char></note><verse eid="LUK 12:53"/></para>
  <para style="s1">ዎደታባ ኤሮ</para>
  <para style="r">(<ref loc="MAT 16:2-3">ማቶ 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>ቃስካ አሳኮ፥ “ዉሎሀ ባጋራ ሳሎይ ሻራትያ ዎደ በእድ፥ ኤለስድ፥ ‘እር ያና’ ያጌታ፥ ሄሳዳካ ሀኔስ። <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>ዱገሀ ጫርኮይ ጫርክያ ዎደ ‘ሳእ አዋና’ ያጌታ፥ ሄሳዳካ ሀኔስ” ያግስ። <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>ህንተኖ፥ ጩቦቶ፥ ሳሎባነ ሳአባ ሻክድ ኤሬታሽን ሀ ዎድያ ሻክድ ኤሮይ ህንተና ዋንድ ፆንዴ?<verse eid="LUK 12:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>“ያትን፥ ህንተ ሁጰስ አይስ ቱማ ፕርደከቲ? <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/>ነ ሞርክያራ ዎላ ዳይና ስንን ኤቃናዉ ባሸ ኦገ ቦላ ጊጋናዉ ኮያ። ነ ጊጎና እፅኮ ጎሸችድ ዳይና ስን ነና ኤፋና። ዳይናይ ነና ቃችያ አሳስ አድ እማና። እ ነና ዎይነን የጋና። <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>ስእተ፥ እስ ባካን አቶና ጭጋ ኦንጋና ጋካናዉ ነ ያፐ ከዮናይሳ ኤራ” ያግስ።<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s1">ናጋራፐ ስሞ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>ሄ ዎደ የሱሳኮ አሳይ ይድ ጵላፆስ ዎድ ኤንታ ሱራ ኤንታ ያርሹዋ ዋላክዳ ጋልላ አሳባ ኦድዳ አሳት ሄ በሳን ደኦሶና። <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>እ ሀይሳዳ ያግድ ዛርስ፤ “ያትን ሄ ጋልላ አሳት ሄ ኢታ ሀይቆ ሀይቅዳ ግሾ፥ ጋልላን ደእያ አሳ ኡባፈ አዳ ናጋራንቾ ዳኖና? <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>ግደና! ግዶሽን፥ ህንተካ ማሮታን ስሞና እፅኮ፥ ኡባይ ሄሳዳ ያና። <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>ዎይኮ ቃስ ሳልሆመ ጌተትያ በሳን ግምበይ ዎድድ ዎዳ ታማነ ሆስፑን አሳይ የሩሳላመን ደእያ አሳ ኡባፈ አዳ ናጋራንቾ ዳኖና? <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>ግደና! ሽን ህንተካ ማሮታን ስሞና እፅኮ ኡባይ ሄሳዳ ያና።”<verse eid="LUK 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>ቃስካ የሱሲ ሀይሳዳ ግድ ሌምሶ ኦድስ፦ “እስ ኡራስ ዎይነ ጋደን ቶከትዳ ባላሰ ም ደአዉሱ። እ ኢፐ አይፈ ደማናዉ ኮይድ አይኮካ ደምቤና። <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>ዎይነ ጋድያ ጎዳይ ዎይነ ኦሳንቹዋኮ፥ ‘አይፈ ደማናዉ ኮያዳ ሄ ላይ ስመረታዳ አይኮካ ደማብከ። ሄሳ ግሾ፥ ቃንፃ ድጋ፤ አይስ ቢታ መልሳይ?’ ያግስ።<verse eid="LUK 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8"/>“ሽን ኦሳንቾይ፥ ‘ጎዳዉ፥ እ ዩሹዋ ኦዳ ኦሻ የጋና ጋካናዉ ሀ ላይስ አጋርክ። <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>ሀ ላይ አይፍኮ ሎኦ፥ እፅኮ ቃንፃ አጋ’ ” ያግድ ዛርስ።<verse eid="LUK 13:9"/></para>
  <para style="s1">ዞኮ ኩና ማጫስዉ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>የሱሲ ሳምባታ ጋላስ አይሁደ ዎሳ ኬን ታማርሴስ። <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>ሄ በሳን ታማነ ሆስፑን ላይ ቱና አያን ዞኮ ኩንስዳ እስ ማጫስያ ደአዉሱ። እያ ኩናፐ ደንዶይሳን ሱረ ኤቃናዉ ዳንዳኡኩ። <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>የሱሲ እዮ በእዳ ዎደ ፄግድ፥ “ሀ ማጫሰተ፥ ነ ሀርግያፈ ፓፃዳሳ” ያግስ። <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>ባ ኩሽያ እ ቦላ ዎን፥ እያ ኤለሳዳ፥ ሱራዳ ኤቃሱ። ፆሰ ጋላታሱ።<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>ሽን አይሁደ ዎሳ ኬ ሀላቃይ ይሎትድ አሳኮ፥ “ኦሶ ኦያ ኡሱፑን ጋላሳት ደኦሶና። ሄሳ ግሾ፥ ሄ ጋላሳታን ይድ ፓፅተፐ አትሽን፥ ሳምባታ ጋላስ ግደና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="EXO 20:9-10">ከሳ 20:9-10</ref>፤ <ref loc="DEU 5:13-14">ዛረ 5:13-14</ref>.</char></note><verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>ጎዳይ፥ “ጩቦቶ፥ ህንተ ግዶፈ ቦር ዎይኮ ሀረ ሳምባታ ጋላስ ዛዳሎፐ ብልድ ሃ ኡሻናዉ ኤፎናይ ኦኔ? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>ያትን፥ ሀ ማጫስያ አብራሃመ ናአ ግዳሸ ፃላሄን ቃሸታዳ ታማነ ሆስፑን ላይ ኩመ ደእዳርስ ሳምባታ ጋላስ ብርሸተ ኮሸኔ?” ያግድ ኦይችስ።<verse eid="LUK 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17"/>እ ሄሳ ኦድዳ ዎደ ኤቀተይሳት ኡባይ ዬላትዶሶና። ሽን አሳ ኡባይ እ ኦዳ ማላልስያ ኦሶ ኡባን ኡፋይትዶሶና።<verse eid="LUK 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>ሄሳፈ ጉየ፥ የሱሲ ሀይሳዳ ያግስ፥ “ፆሳ ካዎተ አይ ዳኒ? እያ አይብራ ዳንሶ? <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>ፆሳ ካዎተ እስ አስ ባ ጎሻን ቶክዳ ዎላ አይፈ መላ። እ ድጭድ ም ግድስ። ሳሎ ካፎት እያ ታሽያ ቦላ ሸምፕዶሶና።”<verse eid="LUK 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>ቃስ፥ “ፆሳ ካዎተ አይብራ ዳንሶ? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>እስ ማጫስያ ዳሮ ለራ ዋላካዳ ሙኑቅዳ ጉ እርሾ ዳኔስ” ያግስ።<verse eid="LUK 13:21"/></para>
  <para style="s1">ፁን ዉላ</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>ሄሳፈ ጉየ፥ የሱሲ የሩሳላመ ብሸ እ ካንያ ኦግያን ደእያ ካታማታንነ ጉታታን ታማርስሸ አስ። <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>እስ አስ የሱሳኮ፥ “ጎዳዉ፥ አታናይ ጉ አሳ ፃላሌ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="LUK 13:23">የሱሲ ኤንታኮ፥ <verse eid="LUK 13:23"/><verse number="24" style="v" sid="LUK 13:24"/>“ስእተ፥ ፁን ዉላራ ገላናዉ ባፀትተ። ዳሮት ገላናዉ ኮዮሶና ሽን ኤንታዉ ሀነና። <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/>ኬ አዋይ ደንድድ ዉላ ጎርድዳፐ ጉየ፥ ‘ኑስ ዶያርክ’ ያግሸ ካረን ኤቅድ ፄስ ኦይከታ። ሽን እ፥ ‘ህንተ ኦነኮነ አዉፐ ይዳኮ ታ ኤርከ’ ግድ ዛራና። <verse eid="LUK 13:25"/><verse number="26" style="v" sid="LUK 13:26"/>ሄ ዎደ ህንተ፥ ‘ኔራ ዎላ ምዳ፥ ኡይዳ፥ ኑ ዳባባንካ ታማርሳዳሳ’ ያጋና።<verse eid="LUK 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27"/>“እ ዛሪድ፥ ‘ህንተ ኦነኮነ አዉፐ ይዳኮ ኤርከ። ህንተኖ፥ ጌላቶ ታፐ ሃክተ’ ያጋና።<note caller="-" style="x"><char style="xo" closed="false">13:27 </char><char style="xt" closed="false"><ref loc="PSA 6:8">ማዝ 6:8</ref>.</char></note> <verse eid="LUK 13:27"/><verse number="28" style="v" sid="LUK 13:28"/>አብራሃመ፥ ይሳቃ፥ ያይቆባነ ናበታ ኡባ ፆሳ ካዎተን በአና፥ ሽን ህንተ ካረን ዎድ አትያ ዎደ ህንተዉ ዬሆነ አቸ ጋርጨ ግዳና። <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/>አሳይ ዶሎሀፐ፥ ዉሎሀፐ፥ ፑደሀፐነ ዱገሀፐ ይድ ፆሳ ካዎተን ግብራ ቦላ ኡታና።<note caller="-" style="x"><char style="xo" closed="false">13:29 </char><char style="xt" closed="false"><ref loc="MAT 8:11-12">ማቶ 8:11-12</ref>፤ <ref loc="MAT 22:13">22:13</ref>፤ <ref loc="MAT 25:30">25:30</ref>.</char></note> <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/>ሄሳ ግሾ፥ ሀእ ደን ጉየ ግድዳይሳታፐ ስን ግዳናይሳት፥ ስን ግድዳይሳታፐ ጉየ ግዳናይሳት ደኦሶና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">13:30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶ 19:30</ref>፤ <ref loc="MAT 20:16">20:16</ref>፤ <ref loc="MRK 10:31">ማር 10:31</ref>.</char></note><verse eid="LUK 13:30"/></para>
  <para style="s1">የሱሲ የሩሳላመስ ዬክስ</para>
  <para style="r">(<ref loc="MAT 23:37-39">ማቶ 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>ሄ ዎደ ፋርሳወታፐ እሶት እሶት ይድ፥ “ሄሮዲስ ነና ዎናዉ ኮይያ ግሾ ሀ በሳፈ ደንዳዳ ባ” ግዶሶና።<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>እ ዛሪድ፥ “ብድ፥ ሄ ዎርካናስ፥ ‘ሄኮ፥ ሀችነ ዎንቶ ቱና አያናታ ከሳና፥ ሀርጋንቾታ ፓና፥ ሄን ጋላሳን ኩሻ ቦላ ጋካና’ ያግስ ጊተ። <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>ሀኖፐ አትሽን፥ ናበይ የሩሳላመፐ ካረን ሀይቃናዉ በሰና። ሄሳ ግሾ፥ ሀች፥ ዎንቶነ ዎንት ፔእን ሄ በሳ ባናዉ ደንዳስ።<verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>“የሩሳላመ፥ የሩሳላመ፥ ናበታ ዎያረ፥ ኔኮ ኪተትዳይሳታ ሹቻን ጫድያረ፥ ኩቶይ ባ ናይታ ባ ቀፍያፐ ጋርሳን ሺሽያዳ ነ ናይታ ታ ቀስያፐ ጋርሳን አፑን ቶሆ ሺሻናዉ ኮያድና፥ ሽን ህንተ እፃስ ግደታ። <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>ታ ህንተዉ ኦዳይስ፤ ህንተ ኬይ ካይሳታና። ጎዳ ሱንን የይስ አንጀትዳይሳ ህንተ ጋና ጋካናዉ ታና ደመከታ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዝ 118:26</ref>፤ <ref loc="JER 22:5">ኤርም 22:5</ref>.</char></note><verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s1">የሱሲ ፋርሳውያ ሶን</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>እስ ሳምባታ ጋላስ የሱሲ እስ ፋርሳወታ ሀላቃ ሶ ካ ማናዉ ገልያ ዎደ አሳይ ጫድ ፄሎሶና። <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>ሄ በሳን ሻዉሄ ሀርገን ዋየትያ እስ አስ እያዉ ስን ባጋራ ዝንእስ። <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>የሱሲ ፋርሳወታነ ህገ አስታማረታ፥ “ሳምባታ ጋላስ ሀርጋንቾ ፓሶይ ዎገየ ዎጋ ግደኔ?” ያግድ ኦይችስ። <verse eid="LUK 14:3"/><verse number="4" style="v" sid="LUK 14:4"/>ኤንቲ ስእ ግዶሶና። የሱሲ ሀርገትያ ኡራ ቦች ፓድ ሞይዝስ።<verse eid="LUK 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5"/>“ቃስካ ህንተፈ እሱዋስ ናእ ዎይኮ ቦር ሳምባታ ጋላስ አፎን ዉልኮ፥ ኤለስድ ከሶናይ ኦኔ?”<note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="MAT 12:11">ማቶ 12:11</ref>.</char></note> ያግድ ኦይችስ። <verse eid="LUK 14:5"/><verse number="6" style="v" sid="LUK 14:6"/>ኤንቲ እስባካ ዛራናዉ ዳንዳእቦኮና።<verse eid="LUK 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>የሱሲ እማቱዋስ ፄገትዳይሳት ቦንቾ በሲ ዶርሽን በእድ፥ ሀ ሌምሱዋ ኦድስ፦ <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>“እስ አስ ነና ያጋኖ ፄግኮ ቦንቾ በሳን ኡቶፋ። ኔፐ አድ ቦንቸትያ አስ ፄገታናዉ ዳንዳኤስ።<note caller="-" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="PRO 25:6-7">ሌም 25:6-7</ref>.</char></note> <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>ህንተና ናምአታካ ፄግዳይስ ይድ፥ ‘ነ በሳ ሀ እማስ የዳ’ ግያ ዎደ ኔኒ ዬላታሸ ዝቃ በሲ ዎሳ። <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>ግዶሽን፥ ነ ፄገትዳ ዎደ ኮይሮታዳ ዝቃ በሲ በአዳ ኡታ። ፄጎይስ ይድ፥ ‘ታ ላግያዉ፥ ሀ ቦንቾ በሳን ኡታ’ ያጋና። ሄ ዎደ ኔራ እስፈ ፄገትዳ አሳ ኡባ ስንን ነ ቦንቸታና። <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/>ባና ቁ ቁ ኦያ ኡባይ ካዉያና፤ ባና ዝቅ ዝቅ ኦያ ኡባይ ቁ ቁ ጋና።”<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ 23:12</ref>፤ <ref loc="LUK 18:14">ሉቃ 18:14</ref>.</char></note><verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>ቃስ የሱሲ እያ ሞክዳ ኬ አዋኮ፥ “ቁማ ዎይኮ ካሆ እማቶ ፄግያ ዎደ፥ ኔኒ ኩሸ ዛሮ ፄጎና መላ ነ ላገታ ዎይኮ ነ እሻታ ዎይኮ ነ ዳቦታ ዎይኮ ነ ዱረ ሾሮታ እማቶ ፄጎፓ። <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>ግዶሽን፥ ነ እማቶ ጊግስዳ ዎደ ማንቆታ፥ ዎበታ፥ ጉንዳታነ ቆቀታ ፄጋ፤ ኔኒ አንጀታና። <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>ሀይሳቲ ኩሸ ዛራናዉ ዳንዳኦና ግሾ ኩሸ ዛሮይ ጌሻታ ደንዶ ጋላሳን ነዉ ስማና” ያግስ።<verse eid="LUK 14:14"/></para>
  <para style="s1">ግታ እማቶ ሌምሶ</para>
  <para style="r">(<ref loc="MAT 22:1-10">ማቶ 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>የሱሳራ ዎላ እማቶ ቦላ ኡቶይሳታ ግዶፈ እሶይ፥ ሄሳ ስእድ፥ “ፆሳ ካዎተን እማቶ ቦላ ኡተይስ አንጀትዳይሳ” ያግስ።<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>የሱሲ፥ “እስ አስ ግታ እማቶ ጊግስድ ዳሮ አሳታ ፄግስ። <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/>እማቶይ ሞከትያ ሳተይ ጋክያ ዎደ፥ ፄገትዳ እማታ፥ ‘ሄኮ ኡባባይ ጊግስ፥ ሃ ዪተ’ ያግድ ፄጋናዳ ባ አይልያ ኪትስ።<verse eid="LUK 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18"/>“ሽን ኡባይካ ባንታ ጋሶ ጋሶ መዶሶና። እሶይ፥ ‘ሀእ ቡሮ ጋደ ሻምዳ ግሾ፥ ባዳ በአናዉ ኮሼስ፤ ሀያና ታና አጋርክ ያጋ’ ያግስ። <verse eid="LUK 14:18"/><verse number="19" style="v" sid="LUK 14:19"/>ሀንኮይ፥ ‘እቻሹ ዋ ቦር ሻማስ፤ ኤንታና ዋፃ በአና ግሾ ሀያና ታና ላንጮፋ’ ያግስ። <verse eid="LUK 14:19"/><verse number="20" style="v" sid="LUK 14:20"/>ቃስ ሀራይ፥ ‘ታኒ ቡሮ መዳን ደእያ ግሾ፥ ያናዉ ዳንዳእከ’ ያግስ።<verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>“አይለይ ስም ይድ ሄ ኡባ ባ ጎዳስ ኦድስ። ሄ ዎደ ያጋኖ አዋይ ሀንቀትድ አይልያኮ፥ ‘ኤለሳዳ ካታማን ደእያ ዎጋ ኦገታነ ዳጋላታ ባዳ፥ ማንቆታ፥ ዎበታ፥ ቆቀታነ ጉንዳታ ሃ ኤሀ’ ያግስ።<verse eid="LUK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22"/>“አይለይ፥ ‘ታ ጎዳዉ፥ ነ ኪትዳይስ ኡባይ ፖለትስ፥ ሽን ሀእካ በሲ ደኤስ’ ያግስ።<verse eid="LUK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23"/>“ጎዳይ አይልያኮ፥ ‘ሆሮጋታ ቦላነ፥ ጋደ ግዶ ኦገታ ከያ፥ ታ ኬይ ኩማና ጋካናዉ ደምዳ ኡባ ያና መላ ኦ። <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>ታ ህንተዉ ኦዳይስ፤ እማቶ ፄገትዳይሳታፐ ኦንካ ታ ግብራፐ ሞናይሳ ኤርተ’ ግስ” ያግስ።<verse eid="LUK 14:24"/></para>
  <para style="s1">ጎዳ ካሎይ ጭግስያ ጋተ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>ዳሮ አሳይ እያራ ዎላ ብሽን፥ የሱሲ ኤንታኮ ጉየ ስሚድ፥ <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/>“ታኮ ያ ኡባይ ባ አዋነ ባ አይዉ፥ ባ ማችዉነ ባ ናይታ፥ ባ እሻታነ ባ ምቸታ፥ ሀር አቶሽን ባ ደኡዋ እፆናይ ታ ታማረ ግዳናዉ ዳንዳኤና።<note caller="-" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">ማቶ 10:37</ref>.</char></note> <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/>ባ ማስቃልያ ቶክድ ታና ካሎናይ ታ ታማረ ግዳናዉ ዳንዳኤና።<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="MAT 10:13">ማቶ 10:13</ref>፤ <ref loc="MAT 16:24">16:24</ref>፤ <ref loc="MRK 8:34">ማር 8:34</ref>፤ <ref loc="LUK 9:23">ሉቃ 9:23</ref>.</char></note><verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>“ህንተፈ እስ አስ ሹቻ ኬ ኬፃናዉ ኮይኮ፥ ኬ ኬፅድ ኦንጋናዉ አይ መላ ሚሸ ኮሽያኮ ኮይሮትድ ኤራናዉ ቆፕ በኦናይ ኦኔ? <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>ሄሳ ግዶና እፅኮ፥ ሀ ኡራይ ባሶ ሹቹ ሂፅን ቁስተ ፆንኮ፥ <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>በእያ ኡባይ፥ ‘ሀ ኡራይ ግምበ ኦይክን ቁስታናዉ እያ ፆንስ’ ያግድ ቦሮሶና።<verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>“ዎይኮ እስ ካዎይ ሀራ ካዎራ ኦለታናዉ ደንድሸ ላታሙ ሙኩሉ ኦላንቾታ ኤክ ያ ካዉዋራ ታሙ ሙኩሉ ኦላንቾታራ ኤቀታናዉ ዳንዳአናይሳነ ዳንዳኦናይሳ ኡትድ ዞረቶናይ ኦኔ? <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>ኤቀታናዉ ዳንዳኤቶናባ ግድኮ፥ ሄ ካዋራ ሃሆን ደእሽን ጊጋናዉ ኮይሮትድ ጭማ የድድ ኦይቼስ። <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>ሄሳዳካ፥ ህንተፈ ኦንካ ባዉ ደእያባ ኡባ አጎና እፅኮ፥ ታ ታማረ ግዳናዉ ዳንዳኤና።<verse eid="LUK 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>“ማፅነይ ሎኦ፥ ሽን ማፅነይ ባ ማልኡዋ አግኮ፥ ዋንድ ማፅነ ጌተታናዉ ዳንዳኢ? <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>ቢታተስነ አራዳተስ ማዶና ግሾ ዎራ የገቴስ። ህዛ፥ ስእያ ሀይ ደእያ አስ ስኦ” ያግስ።<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s1">ይዳ ዶርሳ ሌምሶ</para>
  <para style="r">(<ref loc="MAT 18:12-14">ማቶ 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>እስ ጋላስ ቃራፃ ቃንፀይሳትነ ናጋራንቾት የሱሳ ትምርትያ ስአናዉ እያ ዩሾን ሺቅዶሶና።<note caller="-" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LUK 5:29-30">ሉቃ 5:29-30</ref>.</char></note> <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>ሽን ፋርሳወትነ ህገ አስታማረት፥ “ሀይስ ኡራይ ናጋራንቾታ ሺሽድ ኤኬስ፥ ኤንታራ እስፈ ሜስ” ያግድ ዙዙምዶሶና።<verse eid="LUK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3"/>የሱሲ ሀ ሌምሱዋ ኤንታዉ ያግድ ኦድስ፦ <verse eid="LUK 15:3"/><verse number="4" style="v" sid="LUK 15:4"/>“ህንተ ግዶፈ እሱዋስ ፄቱ ዶርሳት ደእያባ ግድኮ ኤንታፈ እሶይ ይኮ ኡዱፉን ታማነ ኡዱፉናታ ባዞን አግድ ዮይሳ ደማና ጋካናዉ ኮዮናይ ኦኔ? <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>ደምዳ ዎደ ኡፋይትድ ባ ጋናን ቶክድ፥ <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>ባ ሶ ስሜስ። ባ ላገታነ ሾሮታ ፄግድ፥ ‘ይዳ ታ ዶርሳ ደማስ፥ ታራ እስፈ ኡፋይትተ’ ያጌስ። <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>ሄሳዳካ፥ ማሮት ኮሾና ኡዱፉን ታማነ ኡዱፉን ፅሎታፐ አድ፥ ማሮታን ገልያ እስ ናጋራንቹዋ ጋሶን ሳሎን ግታ ኡፋይስ ግዴስ።<verse eid="LUK 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>“ዎይኮ ታሙ ብር ደእያ እስ ማጫስያ ታማፈ ኢስያ ይኮ ደማና ጋካናዉ ፆምፐ ኦይዳ ኬ ፕታዳ ምን ኮዮናይ ኦኔ? <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>ደምዳ ዎደ ባ ላገታነ ባ ሾሮታ ፄጋዳ ‘ይዳ ታ እስ ብራ ደምዳ ግሾ ታራ ኡፋይትተ’ ያጋዉሱ። <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>ስእተ፥ ሄሳ መላ እስ ማሮተን ገልያ ናጋራንቹዋን ፆሳ ኪታንቾታ ስንን ኡፋይስ ግዴስ” ያግስ።<verse eid="LUK 15:10"/></para>
  <para style="s1">ይዳ ናአ ሌምሶ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>ዛሪድ የሱሲ፥ “እስ ኡራስ ናምኡ ናይት ደኦሶና። <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>ኤንታፈ ካሎ ናአይ ባ አዋኮ፥ ‘ታ አዋዉ፥ ነ ሻሉዋፐ ታ ግሹዋ ታዉ እማ’ ያግስ። አዋይ ባ ሻሉዋ ባ ናይታስ ሻክስ። <verse eid="LUK 15:12"/><verse number="13" style="v" sid="LUK 15:13"/>ጉ ጋላሳፐ ጉየ፥ ካሎ ናአይ ባ ግሹዋ ኡባ፥ ቃች ኤክድ ሃሆ ቢታ ብስ። ያን አልታጫን ሻሉዋ ቶችድ ኦንግስ። <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>እ ባዉ ደእያባ ኡባ ዉርስዳፐ ጉየ ሄ ቢታ ኡባን ምኖ ኮሽ ከይን መቶትስ። <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>ሄሳ ግሾ፥ ሄ ቢታ አሳፐ እሱዋ ሶ ጋታ ገልስ። ኡራይ እያ ጉዱን ሄማና መላ ባ ሞ የድስ። <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>ጉዱንት ምያ ሀርቁዋፈ ማናዉ አሞትስ፥ ሽን እዮካ እያዉ እምያ አስ በንትቤና። <verse eid="LUK 15:16"/><verse number="17" style="v" sid="LUK 15:17"/>እ ባ ዎዛናኮ ስሚድ፥ ‘አፑን ታ አዋ አይለታስ ካ ዎራ ዎን ታ ሀይሳን ኮሻራ ሀይቃናዉ ጋካድና?’ <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>ደንዳዳ ታ አዋኮ ባዳ፥ ‘ታ አዋዉ፥ ሳሎን ፆሳ፥ ሳአን ነና ቆሀስ። <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>ህዛፐ ነ ናአ ጌተታዳ ፄገታናዉ ታዉ በሶና ግሾ፥ ነ ሶን ደእያ አይለታፐ እሱዋዳ ታና ፓይዳ’ ያጋና” ያግስ። <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/>ሄሳ ግሾ፥ ደንድድ ባ አዋኮ ብስ።</para>
  <para style="p" vid="LUK 15:20">“ሀኖሽን፥ እ ቡሮ ሃሆን ደእሽን አዋይ ቃትድ፥ እያኮ ዎፅ ብድ፥ እድምድ ዬርስ። <verse eid="LUK 15:20"/><verse number="21" style="v" sid="LUK 15:21"/>ናአይካ፥ ‘ታ አዋዉ ሳሎን ፆሳ፥ ሳአን ነና ታ ቆሀስ። ህዛፐ ነ ናአ ጌተታዳ ፄገታናዉ በስከ’ ያግስ።<verse eid="LUK 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22"/>“እያ አዋይ አይለታ ፄግድ፥ ‘ኤለስድ ኡባፈ ሎኦ ግድዳ ማኦ ኤህድ እያ ማይዝተ፤ እያ ብራን ሳጋዮ፥ እያ ቶሆን ጫማ አተ። <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>ሞ ጋታርመን ኤህድ ሹክተ፥ ሞስ፥ ኡፋይቶስ። <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>ታ ናአይ ሀይስ ሀይቅስ፥ ሽን ሀእ ፓፅስ፤ ይስ፥ ሽን በንትስ’ ያግስ። ሄሳፈ ጉየ፥ ኡፋይስ ዶምዶሶና።<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>“ሄ ዎደ ባይራ ናአይ ጎሻ ጋደን ደኤስ። ያፐ ይሸ ሶ ማትሽን የነ ጉፋ ግርስ ስእስ። <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>እ፥ አይለታፐ እሱዋ ፄግድ ሀንያባይ አይበኮ ኤራናዉ ኦይችስ። <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/>አይለይ፥ ‘ነ እሻይ ሳሮ ይዳ ግሾ ነ አዋይ ሞ ጋታርመን እያዉ ሹክስ’ ያግስ።<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>“ባይራ እሻይ ይሎትድ ሶ ገላናዉካ ኮይቤና። አዋይ ካረ ከይድ ሶ ገላና መላ እያ ዎስስ። <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>ሽን እ ባ አዋኮ፥ ‘ሄኮ፥ ሀይሳ መላ ላይ ታ ነዉ አይለታዳ ነ ኪታፐ እሱዋካ ፓጭሶና ነዉ ኪተትን፥ ታኒ ታ ላገታራ ኡፋይታና መላ ሀር አቶሽን እስ ላቃ ዴሸ እማባካ። <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>ሀኖሽን፥ ሀይስ ነ ናአይ ነ ሻሉዋ ላይማታራ ይስድ ይን፥ ሞ ጋታርመን ሹካዳሳ’ ” ያግስ።<verse eid="LUK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31"/>“አዋይካ፥ ‘ታ ናአዉ፥ ኔኒ ኡባ ዎደ ታራ ደኣሳ፥ ታባ ኡባይ ኔሳ። <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>ሀይስ ነ እሻይ ሀይቅስ፥ ሽን ፓፅስ፤ ይስ፥ ሽን በንትስ። ሄሳ ግሾ፥ ዳሮ ኡፋይታናዉ በሴስ’ ያጋና” ያግስ።<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s1">አማነቶና ሹማ ሌምሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>የሱሲ ባ ታማረታኮ፥ “እስ ዱረ ኡራስ እያፐ ጋርሳራ እስ ሹም ደኤስ። ሄ ሹማይ ባ ጎዳ ሻሉዋ ቶቼስ ግያ ዎረይ ኬ አዋ ጋክስ። <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>ኬ አዋይ ሹማ ፄግስድ፥ ‘ታኒ ዎይግያባ ስአድና? ህዛፐ ኔኒ ታ ኬስ ሹማ ግዳዳ ኦናዉ ዳንዳኦና ግሾ፥ ታ ሻሉዋ ታዉ ሼ’ ያግስ።<verse eid="LUK 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3"/>“ሄ ሹማይ ባ ዎዛናን ሀይሳዳ ያግድ ቆፕስ፦ ‘ታ ጎዳይ ታና ሹማተፈ ዎና ሀኔስ፥ ጎያ አቃናዉ ዎልቅ ባዋ፥ ዎሳ ማናዉ ዬላዬስ፤ ያትን ታ ዋኖ? <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>ሹማተፈ ታ ዎያ ዎደ አሳይ ታና ሞካና መላ ኦናባ ታ ኤራይስ’ ያግስ።<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>“ሄሳ ግሾ፥ እያ ጎዳ አጮይ ደእያ አሳ እሱዋ እሱዋ ፄግ ኤህድ ኮይሮ ኡራኮ፥ ‘ነ ቦላ ታ ጎዳ አጮይ አይ መል ደኢ?’ ያግድ ኦይችስ።<verse eid="LUK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6"/>“እ፥ ‘ላታሙ ባርሜለ ዛይተ አጮይ ደኤስ’ ያግስ።</para>
  <para style="p" vid="LUK 16:6">“ሹማይ፥ ‘ዉለ ዋርቃትያ ሄኤ፥ ኤለሳዳ፥ ታሙ ባርሜለ ዛይተ አጮይ ደኤስ ጋዳ ፃፋ’ ያግስ።<verse eid="LUK 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7"/>“ሄሳፈ ካልድ ናምአንዋኮ፥ ‘ነዉ አፑን ደኢ?’ ያግስ።</para>
  <para style="p" vid="LUK 16:7">“እ፥ ‘ሄ ፄታነ ላፑን ታሙ ኩንታለ ግስተ አጮይ ደኤስ’ ያግስ።</para>
  <para style="p" vid="LUK 16:7">“ሹማይ፥ ‘ነ ዉለ ዋርቃትያ ሄኤ፥ ኤለሳዳ፥ 296 ኩንታለ ያጋዳ ፃፋ’ ያግስ። <verse eid="LUK 16:7"/><verse number="8" style="v" sid="LUK 16:8"/>ኬ አዋይ አማነትቦና ሹማ እያ ጭንጫተስ ናሽስ። ሀ አላምያ ናይት አሰ ኦይን ፖኦ ናይታፐ አዳ ዎዛናማታ።<verse eid="LUK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>“ሄሳ ግሾ፥ ታ ህንተዉ ኦዳይስ፤ ሀ አላምያ ሚሸይ ዉርያ ዎደ መርና ኬን ሞከታና መላ ሀ ሚሽያራ ህንተዉ ላገታ ሻምተ። <verse eid="LUK 16:9"/><verse number="10" style="v" sid="LUK 16:10"/>ኡባፈ ጉባን አማነትዳይ ዳሮባን አማነትዳይሳ ግዴስ። ቃስ ኡባፈ ጉባን አማነቶናይስ ዳሮባን አማነተና። <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>ህዛ፥ ሀ አላመ ሚሸን ህንተ አማነቶና እፅኮ፥ ቱማ ሚሸ ህንተዉ ኦን ሀዳራ እማኔ? <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>ህንተ ሀራ አሳ ሚሸን አማነቶና እፅኮ፥ ህንተ ቡዞ ሚሸ ህንተዉ ኦን እማኔ?<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>“እስ አይለይ ናምኡ ጎዳታስ ሃረታናዉ ዳንዳኤና። እሱዋ እፅኮ ሀንኩዋ ዶሴስ ዎይኮ እሱዋኮ ሺቅኮ ሀንኩዋ ካስ። ሄሳዳካ፥ ህንተ ፆሳስነ ሚሸስ ሃረታናዉ ዳንዳኤከታ።”<note caller="-" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MAT 6:24">ማቶ 6:24</ref>.</char></note><verse eid="LUK 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>ሚሸ ዶስያ ፋርሳወት ሄሳ ስእዳ ዎደ የሱሳ ቀልቅስዶሶና። <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>እ፥ “ህንተ፥ ህንተና አሳ ስንን ፅልሴታ፥ ሽን ፆሳይ ህንተ ዎዛና ኤሬስ። አሳ ስንን ቦንቸትዳይስ ፆሳ ስንን ቦረትዳይሳ።<verse eid="LUK 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>“ሙሰ ህገይነ ናበታ ኪታይ ዮሃንሳ ጋካናዉ ህንተዉ ኦደትሸ ጋምእስ። ሄሳፈ ጉየ፥ ፆሳ ካዎተ ዎንገላይ ሳባከትሸ ጋምእስ። አስ ኡባይ ያ ገላናዉ ዳፈቴስ።<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="MAT 11:12-13">ማቶ 11:12-13</ref>.</char></note> <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/>ግዶሽን፥ ህግያፈ እስ ላፋ ፕዳለይ አታናፐ ሳሎይነ ሳእ አይስ ካዉዬስ።<note caller="-" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">ማቶ 5:18</ref>.</char></note><verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>“ባ ማችዉ የድድ ሀራ ኤክያ ኡባይ ላሜስ። ባ አዝናፐ አንጀትዳሮ ኤከይስካ ላሜስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ 5:32</ref>፤ <ref loc="2CO 7:10-11">2 ቆሮ 7:10-11</ref>.</char></note><verse eid="LUK 16:18"/></para>
  <para style="s1">ዱረ ኡራነ አላዛራ</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>“አልኦነ አሌቆ አፍላ ማእያ፥ ሳእ እንጀትን ጋላስ ጋላስ ኡፋይሳን ደእያ እስ ዱረ አስ ደኤስ። <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>ሀር ቃስ አሳተይ ኩመ ማዱንፅዳ እስ አላዛራ ጌተትያ ማንቆይ ሄ ዱረ ኡራ ካረን የገትድ አትዳይስ ደኤስ። <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>ኮሻፐ ደንዶይሳን ዱረ ኡራ ጋይታፐ ዎያ ቲፍያ ማናዉ አሞትሸ ደኤስ። ሀር አቶሽን፥ ካናት ይድ እያ ማዱን ላጮሶና።<verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>“ሄ ማንቆይ ሀይቅስ፤ ኪታንቾት እያ አብራሃመ ክኦ ኤፍዶሶና። ቃስ ዱረ ኡራይካ ሀይቅድ ሞገትስ። <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/>ስኦለን ኡንኤትድ ደእሸ ቁ ግድ ሃሆን አብራሃመነ እያ ክኦን ደእያ አላዛራ በእስ። <verse eid="LUK 16:23"/><verse number="24" style="v" sid="LUK 16:24"/>እ፥ ‘አዋዉ አብራሃመ፥ ታዉ ቃታርክ፤ ሀ ታማ ላጮን ኡንኤታዳ ደእያ ግሾ አላዛር ባ ብራያ ሃን የድድ ታ እንፃርሳ ላኮና መላ ሀያና እያ የዳርክ’ ያግድ ዋስስ።<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>“ሽን አብራሃመይ እያኮ፥ ‘ታ ናአዉ፥ ነ ሳአን ደእያ ዎደ ሎኦባታ ኤክዳይሳ፥ ቃስ አላዛር ኢታባታ ኤክዳይሳ አኬካ። ሽን ሀእ እ ሀይሳን ኡፋይቴስ፥ ቃስ ኔኒ ዋየታሸ ደኣሳ’ ያግስ። <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/>ሀ ኡባፈ አድ፥ ‘ሃፐ ህንተኮ፥ ህንፐ ሃ ኑኮ አናዉ ኮየይሳት ፕኖና መላ ኑስነ ህንተዉ ግዶን ግታ አፎይ ደኤስ’ ያግስ።<verse eid="LUK 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27"/>“ዱረ ኡራይ፥ ‘አዋዉ፥ ያኮ አላዛራ ታ አዋ ሶ ኪታና መላ ታ ነና ዎሳይስ። <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/>ታዉ እቻሹ እሻት ደእዶሶና፥ ኤንትካ ሀ ዋየ በሳ ዮና መላ ኤንታዉ ብድ ማርካቶ’ ያግስ።<verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>“ሽን አብራሃመይ፥ ‘ኤንታዉ ሙሰራነ ናበታራ ደኦሶና፤ ኤንቲ ኦድያባ ስኦና’ ያግስ።<verse eid="LUK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30"/>“ዱረ ኡራይ፥ ‘አዋዉ አብራሃመ፥ ሄሳ ግደና፤ እስ አስ ሀይቆፐ ደንድድ ቢኮ ኤንቲ ማሮታን ገላና’ ያግስ።<verse eid="LUK 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31"/>“አብራሃመይ፥ ‘ሙሰነ ናበታ ስኦና እፅኮ፥ ሀር አቶሽን ሀይቆፐ እስ አስ ደንድ ኦድኮካ አማኖኮና’ ያግስ።”<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s1">ኦይሽሲያ አዋተ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>የሱሲ ባ ታማረታኮ፥ “አሰ በድ ናጋራን ገልስያባይ ዮና አገና። ግዶሽን፥ ናጋራን ገላና መላ ኦያ ኡራ አየ!” ያግስ። <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>ሄ ኡራይ ካሎታፐ እሱዋ ባለናፐ ዎፃ ባ ቆን ቃችድ አባን ዉልኮ እያዉ ሎኦ። <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/>ሄሳ ግሾ ናገትተ።<note caller="-" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="MAT 18:15">ማቶ 18:15</ref>.</char></note></para>
  <para style="p" vid="LUK 17:3">“ነ እሻይ ናጋራ ኦኮ ሀንቀታ፤ ቂሮትድ ማሮተን ስምኮ፥ እያዉ አቶ ያጋ። <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>እስ ጋላሳን ላፑን ቶሆ ቆህድ፥ ላፑን ቶሆ፥ ‘ታኒ ታ ናጋራ ኤራስ ታና ማራ’ ያግድ ኔኮ ዪኮ እያዉ አቶ ጋ።”<verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>ሀዋረት ጎዳኮ፥ “አማኖ ኑስ ጉጃርክ” ያግዶሶና።<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>ጎዳይ፥ “ጋሸ አይፈ መላ አማኖይ ህንተዉ ደእኮ ‘ሀይሳ ዎላ ሾደታዳ አባ ግዶን ቶከታ’ ያግኮ ህንተዉ ኪተታና” ያግስ።<verse eid="LUK 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>ጉጅድካ የሱሲ፥ “ህንተ ግዶፈ እሱዋስ ጎሻንቾይ ዎይኮ ዶርሰ ሄምያ አይለይ ደእኮ ኦሶ ጋደፐ ዎይኮ ዉደፐ ሶ ስምያ ዎደ፥ ‘ኤለ ሃያዳ ካ ማናዉ ኡታ’ ያገይ ደኢ? <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/>ዴና፥ ‘ታዉ ካሆ ጊግሳ፤ ታኒ ማዳ፥ ኡያዳ አጋና ጋካናዉ ኤቃዳ ሙዛ። ሄሳፈ ጉየ፥ ኔኒ ቃስ ማሳነ ኡያሳ’ ያገነዬ? <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/>ህዛ፥ ጎዳይ፥ አይለይ ኪታ ፖልዳ ግሾ አንጅዬ? <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>ሄሳ ግሾ፥ ህንተካ ኪተቶይሳ ኡባ ፖልዳ ዎደ፥ ‘ኑ ፓና አይለታ፤ ኦናዉ በሲያ ኦሱዋ ፖልዳ’ ያግተ” ያግስ።<verse eid="LUK 17:10"/></para>
  <para style="s1">ባሮ ሀርገፈ ጌይዳ ታሙ አሳታ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>የሱሲ የሩሳላመ ብሸ ሳማርስነ ጋልላስ ግዶራ ካንድ አስ። <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>እስ ጉታ ገልያ ዎደ ባሮ ሀርገን ኦይከትዳ ታሙ አሳት እያ ደምዶሶና። ኤንትካ ሃሆን ኤቅድ፥ <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>“ጎዳ የሱሳ፥ ኑስ ቃታርክ” ያግድ ዋስዶሶና።<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>እ ኤንታ በእዳ ዎደ፥ “ብድ ህንተናተ አይሁደ ካህነ በስተ” ያግስ። ኤንቲ ኦግያ ቦላ ብሸ ፓፅዶሶና።<note caller="-" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ሌወ 14:1-32</ref>.</char></note><verse eid="LUK 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15"/>ኤንታፈ እሶይ ባ ፓፁዋ በእዳ ዎደ ቁ ግዳ ቃላን ፆሳ ቦንችሸ የሱሳኮ ስምስ። <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>እ፥ ሳማረ ቢታ አስ፥ ሽን የሱሳ ቶሆ ቦላ ጉፋንድ እያ ጋላትስ።<verse eid="LUK 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17"/>የሱሲ፥ “ፓፅዳይ ታሙ አሳታ ግዶኮናዬ? ያትን፥ ኡዱፉናት አዉ ብዶና? <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>ሀ አላጋ ኡራፐ<note caller="+" style="f"><char style="fr" closed="false">17:18 </char><char style="fq" closed="false">ሀ አላጋ ኡራፐ፦ </char><char style="ft" closed="false">ባሮ ሀርግያፈ ፓፅዳ ኡራይ አላጋ ጌተትዳይ እ አይሁደ ግዶና ግሾሳ።</char></note> አትሽን፥ ሀር ስሚድ ፆሳ ጋላተይ ዴና ጉሰዬ?” ያግድ ኦይችስ። <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>ኡራኮ፥ “ነ አማኖይ ነና ፓስ፤ ደንዳዳ ባ” ያግስ።<verse eid="LUK 17:19"/></para>
  <para style="s1">ፆሳ ካዎተ ዩሳ</para>
  <para style="r">(<ref loc="MAT 24:23-28">ማቶ 24:23-28</ref>፥ <ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>ፋርሳወት፥ “ፆሳ ካዎተይ አዉደ ያኔ?” ግድ የሱሳ ኦይችዶሶና። እ፥ “ፆሳ ካዎተይ በንትያ ማላን ዬና። <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>ቃስካ እያ፥ ‘ሀንና ዎይኮ ህንና ያጋናዉ ዳንዳኤና። አይስ ጊኮ፥ ፆሳ ካዎተይ ህንተ ግዶን ደኤስ’ ” ያግድ ዛርስ።<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>የሱሲ ባ ታማረታኮ፥ “አሳ ናአ ጋላሳታፐ እሱዋ በአናዉ ህንተ አሞትያ ዎደይ ያና፥ ሽን ህንተ በኤከታ። <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>አሳይ፥ ‘እ ያን ደኤስ’ ዎይኮ፥ ‘ሀይሳን ደኤስ’ ያጋና፥ ሽን ኤንታና ካልድ ቦፕተ። <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>ዎልአን ዎልአምድ ሳሎ ጋፃፐ ጋፃ ፖእስያ መላ አሳ ናኣ ዩሳ ጋላሳይ ሄሳዳ ሀናና። <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>ሽን ሄስ ሀናናፐ ስን አሳ ናአይ ዳሮ ዋያናዉነ ሀ የለተን እፀታናዉ በሴስ። <verse eid="LUK 17:25"/><verse number="26" style="v" sid="LUK 17:26"/>ኖሄ ዎደ ሀንዳይሳ መላ አሳ ናአ ዎደን ሄሳዳ ሀናና።<note caller="-" style="x"><char style="xo" closed="false">17:26 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">መ 6:5-8</ref>.</char></note> <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>ኖሄይ ማርካብያን ገልዳ ቃማ ጋካናዉ አሳይ ምሸነ ኡይሸ፥ ኤክሸነ ገልሸ ደእሽን ዮ ሃይ ይድ ኡባ ይስስ።<note caller="-" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">መ 7:6-24</ref>.</char></note> <verse eid="LUK 17:27"/><verse number="28" style="v" sid="LUK 17:28"/>ሎፀ ላይንካ ሄሳ ሀንስ። አሳይ ምሸነ ኡይሸ፥ ሻምሸነ ባይዝሸ፥ ቶክሸነ ኬፅሸ፥ ጋምእዶሶና።<note caller="-" style="x"><char style="xo" closed="false">17:28 </char><char style="xt" closed="false"><ref loc="GEN 18:20-19:25">መ 18:20—19:25</ref>.</char></note> <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/>ሎፀይ ሶዶመፐ ከይዳ ጋላስ ዲነ ጌተትያ ፁግያባይ ሳሎፐ ቡክድ ኡባ ይስስ። <verse eid="LUK 17:29"/><verse number="30" style="v" sid="LUK 17:30"/>አሳ ናአይ ቆንጭያ ዎደካ ሄሳዳ ሀናና።<verse eid="LUK 17:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31"/>“ሄ ጋላሳን ካረን ደእያ ኦንካ ኬ ግዶን ደእያባ ኤካናዉ ሶ ገሎፖ። ሄሳዳካ፥ ጋደን ደእያ አስ አይኮስካ ሶ ስሞፎ።<note caller="-" style="x"><char style="xo" closed="false">17:31 </char><char style="xt" closed="false"><ref loc="MAT 24:17-18">ማቶ 24:17-18</ref>፤ <ref loc="MRK 13:15-16">ማር 13:15-16</ref>.</char></note> <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>ሎፀ ማችዉ አኬክተ፤<note caller="-" style="x"><char style="xo" closed="false">17:32 </char><char style="xt" closed="false"><ref loc="GEN 19:26">መ 19:26</ref>.</char></note> <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>ባ ሸምፕዉ አሻናዉ ኮይያ አስ ኦንካ ይሳና፤ ባ ሸምፕዉ አድ እምያ ኦንካ እ አሻና።<note caller="-" style="x"><char style="xo" closed="false">17:33 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ 10:39</ref>፤ <ref loc="MAT 16:25">16:25</ref>፤ <ref loc="MRK 8:35">ማር 8:35</ref>፤ <ref loc="LUK 9:24">ሉቃ 9:24</ref>፤ <ref loc="JHN 12:25">ዮሀ 12:25</ref>.</char></note> <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>ታ ህንተዉ ኦዳይስ፤ ሄ ጋላሳን ናምኡ አሳት እስ አርሳን ዝንአና፤ እሶይ ኤከታና፥ ሀንኮይ አታና። <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>ናምኡ ማጫሳት ዎላ ጋጭሽን ኢስያ ኤከታና፥ ሀንክያ አታና። <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/>ናምኡ አሳት ዎላ ጋደን ጎየይሳታፐ እሶይ ኤከታና፥ ሀንኮይ አታና”<note caller="+" style="f"><char style="fr" closed="false">17:36 </char><char style="ft" closed="false">እስ እስ ማፃፋታን ፓይዶ 36 ዴና።</char></note> ያግስ።<verse eid="LUK 17:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>ኤንቲ፥ “ጎዳዉ አዉ ኤከታኔ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="LUK 17:37">እ፥ “ባዉት ደእያ በሳን አንኮት ሺቆሶና” ያግስ።<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s1">አምኤ ዎሳ ሌምሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>የሱሲ ባ ታማረታ አዛሎና ኡባ ዎደ ዎሳና መላ ታማርሳናዉ ኮይድ ያግድ ሌምሶ ኦድስ፦ <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>“እስ ካታማን ፆሳስ ያሸቶና፥ አሳስ ዬላቶና እስ ዳይን ደኤስ <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>ሄ ካታማን እስ አምእያ ደአዉሱ። እያካ፥ ‘ታ ግዶንነ ታ ሞርክያ ግዶን ደእያ ሞቱዋ ፕርዳ’ ያጋዳ ኡባ ዎደ ሄ ዳይናኮ ስመረታዉሱ። <verse eid="LUK 18:3"/><verse number="4" style="v" sid="LUK 18:4"/>ዳይናይ ጉ ዎደስ እ ኦዳ ስኦና እፅስ፥ ሽን ጉየፐ ባ ዎዛናን፥ ‘ታኒ ፆሳስ ያዮና፥ አሳስ ዬላቶና እፅኮካ፥ <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>ሀ አምእያ ታና ዋይስያ ግሾ እዉ ፕርዳና፤ ያቶና እፅኮ ኡባ ዎደ ያዳ ታና ሳለና’ ” ያግድ ቆፕስ።<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>ጎዳይካ፥ “ጌላ ዳይናይ ግዳይሳ ስእደታ፤ <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>ፆሳይ ቃማነ ጋላስ እያኮ ዋስያ ባ ዶርዳይሳታስ ፕርደነዬ? ኤንታና ማዳናዉ ጋምእዬ? <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>ታ ህንተዉ ኦደይሳ ስእተ፥ ኤለስድ ፕርዳና። ግዶሽን፥ አሳ ናእ ያ ዎደ ሳአ ቦላ አማኖ ደማንደሻ?” ያግስ።<verse eid="LUK 18:8"/></para>
  <para style="s1">ፋርሳውያነ ቃራፃ ቃንፅስያ ኡራ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>ቃስ ዛሪድ፥ የሱሲ፥ ባንታና ፅሎ አሳዳ ኦድ ጬቀተይሳታስነ ሀራታ ካይሳታስ ሀይሳዳ ያግድ ሌምሶ ኦድስ፦ <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>“ናምኡ አሳት ዎሳናዉ ፆሳ ኬ ብዶሶና። እሶይ ፋርሳወ ሀንኮይ ቃስ ቃራፃ ቃንፅስያ አስ። <verse eid="LUK 18:10"/><verse number="11" style="v" sid="LUK 18:11"/>ፋርሳወይ ኤቅድ ባዉ ዎስሸ፥ ‘ፆሳዉ ታኒ ሀራታ መላ ቦንቃንቾ፥ ጌላነ ላይማትያ አስ፥ አዳ ቃስ ሀ ቃራፃ ቃንፅስያ ኡራ መላ ግዶና ግሾ ነና ጋላታይስ። <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>ሳምንታፈ ናምኡ ቶሆ ፆማይስ፥ ታ ደምያባ ኡባፈ አስራታ ከሳይስ’ ያግስ።<verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>“ሽን ቃራፃ ቃንፅሰይስ ሃሆን ኤቅድ ሀር አቶሽን ሳሎ ቁ ግድ ፄላናዉካ ያይድ ባ ትራ እጭሸ ‘ፆሳዉ፥ ታና ናጋራንቹዋ ማራርክ’ ግድ ዎስስ።<note caller="-" style="x"><char style="xo" closed="false">18:13 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ 23:12</ref>፤ <ref loc="LUK 14:11">ሉቃ 14:11</ref>.</char></note> <verse eid="LUK 18:13"/><verse number="14" style="v" sid="LUK 18:14"/>ታ ህንተዉ ኦደይሳ ስእተ፤ ፋርሳውያፐ ሀይስ ቃራፃ ቃንፅሰይስ ፆሳ ስንን ፅሎ ግድድ ባ ሶ ስምስ። አይስ ጊኮ፥ ባና ቁ ቁ ኦያ አስ ካዉያና፥ ባና ካዉሽያ አስ ቁ ቁ ጋና” ያግስ።<verse eid="LUK 18:14"/></para>
  <para style="s1">የሱሳነ ዮጋ ናይታ</para>
  <para style="r">(<ref loc="MAT 19:13-30">ማቶ 19:13-30</ref>፤ <ref loc="MRK 10:13-31">ማር 10:13-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>የሱሲ ዮጋ ናይታ ቦላ ባ ኩሽያ ዎድ አንጃና መላ አሳይ እያኮ ኤሆሶና። የሱሳ ታማረት ሄሳ በእድ “አይስ የሱሳኮ ኤሄቲ?” ያግድ ካጭዶሶና። <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>ሽን የሱሲ ናይታ ባኮ ፄግድ፥ “ዮጋ ናይት ታኮ ያናይሳ ድጎፍተ፤ ዮ ጊተ። አይስ ጊኮ፥ ፆሳ ካዎተይ ኤንታዳ ሀንዳይሳታሳ። <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ፆሳ ካዎተ ዮጋ ናይታ ኤኮናይ ኦንካ ያ ገለና” ያግስ።<verse eid="LUK 18:17"/></para>
  <para style="s1">ዱረ ኡራ ኦይሻ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቶ 19:16-30</ref>፤ <ref loc="MRK 10:17-31">ማር 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>አይሁደ ሀላቃታፐ እሶይ፥ “ኬሀ አስታማርያዉ፥ መርና ደኦ ደማናዉ አይ ኦ?” ያግድ ኦይችስ።<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>የሱሲ እያኮ፥ “አይስ ታና ኬሀዉ ያጋዳ ፄጋይ? እስ ፆሳፈ አትሽን፥ ሀር ኬህ ባዋ። <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>ላሞፋ፥ ዎፓ፥ ካይሶቶፓ፥ ዎርዶ ማርካቶፋ፥ ነ አዋነ ነ አይዉ ቦንቻ” ግያ ኪታ ኤራይ ግድ ኦይችስ።<note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ከሳ 20:12-16</ref>፤ <ref loc="DEU 5:16-20">ዛረ 5:16-20</ref>.</char></note><verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>ኡራይካ፥ “ሄሳታ ኡባ ታኒ ናአተፈ ዶማዳ ናጋሸ ጋምአስ” ያግስ።<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>የሱሲ ሄሳ ስእዳ ዎደ፥ “ህዛ፥ ነዉ እስባይ ፓጬስ፤ ነዉ ደእያባ ኡባ ባይዛዳ ማንቆታስ እማ፤ ሳሎን ነና ሻሎይ ናጌስ። ያታ ስማዳ፥ ታና ካላ” ያግስ። <verse eid="LUK 18:22"/><verse number="23" style="v" sid="LUK 18:23"/>ሽን ኡራይ ሄሳ ስእዳ ዎደ እያዉ ዳሮ ሻሎይ ደእያ ግሾ ዳሮ ቂሮትስ።<verse eid="LUK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24"/>የሱሲ ኡራ በእድ፥ “ዱረ አሳስ ፆሳ ካዎተ ገሎይ ዋንድ ኡንአንደሻ? <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>ዱረይ ፆሳ ካዎተ ገላናይሳፈ ግማለይ ናርፐ ሉሆራ ካንይስ ካዉዬስ” ያግስ።<verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>ሄሳ ስእዳ አሳይ፥ “ሄሳ ግድኮ ኦን አታኔ?” ያግዶሶና።<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>የሱሲ፥ “አሳስ ዳንዳኤቶናባይ ፆሳስ ዳንዳኤቴስ” ያግስ።<verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>ጰፅሮስ፥ “ሄኮ ኑኒ ኑባ ኡባ አግድ ነና ካልዳ” ያግስ።<verse eid="LUK 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29"/>“የሱሲ ቱማ ታ ህንተዉ ኦዳይስ፤ ፆሳ ካዎተስ ግድ ባ ኬ ዎይኮ ባ ማችዉ ዎይኮ ባ እሻታ ዎይኮ ባ አዋነ ባ አይዉ ዎይኮ ባ ናይታ አግዳይ፤ <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/>ሀ ዎድያን ዳኮ ዳሮ፥ ያና አላመን መርና ደኦ ኤኮናይ ኦንካ ባዋ” ያግስ።<verse eid="LUK 18:30"/></para>
  <para style="s1">የሱሲ ባ ሀይቁዋባ ሄን ኦድስ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶ 20:17-19</ref>፤ <ref loc="MRK 10:32-34">ማር 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>የሱሲ ታማነ ናምአታ ባኮ ፄግድ፥ “አነ የሩሳላመ ቦስ፥ ናበት አሳ ናአባ ፃፍዳባ ኡባይ ያን ፖለታና። <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>እ አይሁደ ግዶና አሳስ አድ እመታና። ኤንቲ እያ ቶቻና፥ ጫያናነ እያ ቦላ ጩታና። <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>እያ ጋራፍዳፐ ጉየ፥ ዎና፥ ሽን ሄን ጋላሳን እ ሀይቆፐ ደንዳና” ያግስ።<verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>ሽን እያ ታማረት ሄ ኡባፈ እስባካ አኬክቦኮና። እያ ፁራይ ኤንታዉ ቆሰትዳ ግሾ እ ዎይግዳኮ ኤርቦኮና።<verse eid="LUK 18:34"/></para>
  <para style="s1">ቆቀይ ፄልስ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቶ 20:29-34</ref>፤ <ref loc="MRK 10:46-52">ማር 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>የሱሲ እያርኮ ማትያ ዎደ እስ ቆቀ ኡራይ ኦገ ጋፃን ኡትድ ዎሴስ። <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>ቆቀ ኡራይ አሳይ ሄ በሳራ አሽን ስእድ፥ “እ አይቤ?” ግድ ኦይችስ። <verse eid="LUK 18:36"/><verse number="37" style="v" sid="LUK 18:37"/>ኤንቲ፥ “ናዝረተ የሱሲ ሀይሳራ አስ” ያግዶሶና።<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>እ፥ “ዳዊታ ናአዉ፥ የሱሳ፥ ታና ማራርክ” ያግድ ዋስስ።<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>ስን ስን ብያ አሳት፥ “ስእ ጋ” ግድ ሀንቀትዶሶና። ሽን እ፥ “ዳዊታ ናአዉ፥ ታና ማራ” ያግድ ዳርስድ ዋስስ።<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>የሱሲ ኤቅድ ኡራ ባኮ ኤሀና መላ ኪትስ። ኡራይካ፥ እያኮ ሺቅን፥ <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>“ታ ነዉ አይ ኦና መላ ኮያይ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="LUK 18:41">ቆቀይ፥ “ጎዳዉ ታ ፄላናዉ ኮያይስ” ያግስ።<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>የሱሲ፥ “ፄላ፥ ነ አማኖይ ነና ፓስ” ያግስ። <verse eid="LUK 18:42"/><verse number="43" style="v" sid="LUK 18:43"/>ኡራይ ኤለስድ ፄል አግስ። ፆሳ ቦንችሸ የሱሳ ካልስ። አሳ ኡባይ ሄሳ በእድ ፆሰ ጋላትዶሶና።<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s1">ቃራፃ ቃንፅስያ ዛክዮሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>የሱሲ እያርኮ ገልድ አስ። <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>ያን ዛክዮሳ ጌተትያ ቃራፃ ቃንፅሰይሳታ ሀላቃይ ደኤስ። እ ዳሮ ዱረ። <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>እ የሱሲ ኦነኮ በአናዉ ኮይስ። እ ቃን ግድያ ግሾ አሳ ዳሮተፈ ደንዶይሳን የሱሳ በአናዉ ዳንዳእቤና። <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>የሱሳ በአናዉ ኮይድ እ ብያ ኦግያስ ስን ዎፅ ብድ እስ ቦባ ም ቦላ ከይስ።<verse eid="LUK 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5"/>የሱሲ ሄ በሳ ጋክሸ ቁ ግድ በእድ፥ “ዛክዮሳ፥ ሀች ታ ነ ሶን ፔአናዉ በሲያ ግሾ ኤለ ዎ” ያግስ። <verse eid="LUK 19:5"/><verse number="6" style="v" sid="LUK 19:6"/>እ ኤለስ ዎድ ኡፋይሳን የሱሳ ሞክስ።<verse eid="LUK 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7"/>ሄ በሳን ደእያ አሳ ኡባይ ሄሳ በእድ፥ “ናጋራንቹዋ ሶ ገልድ ሞከታንዉ ሀኔስ” ያግድ ዙዙምዶሶና። <verse eid="LUK 19:7"/><verse number="8" style="v" sid="LUK 19:8"/>ግዶሽን፥ ዛክዮስ ኤቅድ ጎዳኮ፥ “ጎዳዉ፥ ሄኮ ታዉ ደእያ ሻሎ ኡባፈ ባጋ ማንቆታስ እማና። አሳፐ አይባካ ዎርዶን ባለዳ ኤክዳባ ግድኮ ኦይዱ ኩሸ ዛራና” ያግስ።<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>የሱሲ ቃስ፥ “ሀ ኡራይ አብራሃመ ናአ ግድዳ ግሾ ሀች አቶተይ ሀ ሶ ይስ። <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/>አሳ ናአይ ይዳይ ይዳይሳ ኮያናሳነ አሻናሳ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="MAT 18:10">ማቶ 18:10</ref>.</char></note><verse eid="LUK 19:10"/></para>
  <para style="s1">ታሙ ምናነ ሌምሶ</para>
  <para style="r">(<ref loc="MAT 25:14-30">ማቶ 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>አሳይ ሄሳ ስእያ ዎደ፥ የሱሲ የሩሳላመ ማታትዳ ግሾነ ፆሳ ካዎተይ ሀእ ማታራ ቆንጫና ዳንዳ ግሾ ኤንታዉ ሌምሶ ኦድስ።<note caller="-" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">ማቶ 25:14-30</ref>.</char></note> <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>ሄሳ ግሾ፥ የሱሲ፥ “እስ ግታ አስ ደኤይስ ባዉ ካዎተ ኤክድ ያናዉ ሀራ ቢታ ብስ። <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>እያዉ ኦያ አይለታፐ ታማታ ፄግድ እሱዋስ እሱዋስ ታሙ ምናነ<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="fk" closed="false">ምናነ፦ </char><char style="ft" closed="false">ምናነይ ግርከ ዶና። እስ ምናነይ እስ ጋላሳ ኦሳንቾስ ሄ አጌና ዳሞዘ ግዴስ።</char></note> እምድ ‘ታ ስማዳ ያና ጋካናዉ ሀ ሚሽያራ ዛልእተ’ ያግስ።<verse eid="LUK 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14"/>“ሄ ቢታ አሳይ እያ እፅያ ግሾ፥ ሀ ኡራይ ኑ ቦላ ካዎታና መላ ኑ ኮዮኮ ያግድ አሰ እያ ጉየራ ኪትዶሶና።<verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>“ግዶሽን፥ ሄ ኡራይ ካዎ ግድድ ባ ቢታ ስምስ። ሄ ታሙ አይለት እ እምዳ ሚሽያን አይ መላ ዛልእድ ዎስዳኮ ኤራናዉ ኮይድ ኤንታና ፄግስስ።<verse eid="LUK 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16"/>“ኮይሮይስ ይድ፥ ‘ጎዳዉ፥ ነ ታዉ እምዳ ሚሸይ ሀራ ታማ ዎስ’ ያግስ።<verse eid="LUK 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17"/>“እያ ጎዳይ፥ ‘ነኖ አማነትዳ አይልያዉ ሎኦ ኦዳሳ። ኔኒ ጉባን አማነትዳ ግሾ ነዉ ታሙ ካታማታ ቦላ ማታ እማስ’ ያግስ።<verse eid="LUK 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18"/>“ናምአንይ ይድ፥ ‘ጎዳዉ፥ ነ ታዉ እምዳ ሚሸይ ሀራ እቻሻ ዎስ’ ያግስ።<verse eid="LUK 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19"/>“ጎዳይ እያኮ፥ ‘ነዉካ ቃስ እቻሹ ካታማታ ቦላ ማታ እማስ’ ያግስ።<verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20"/>“ሄኮ ሄንይ ይድ፥ ‘ጎዳዉ፥ ታ ጩርቃን ፃፃዳ ናግዳ ነ ሚሽያ ሀናሹ። <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/>አይስ ጊኮ፥ ኔኒ ነባ ግዶናባ ኤከይሳነ ነ ዘሮናባ ጫክያ ኢታ አስ ግድያ ግሾ ነዉ ያያስ’ ያግስ።<verse eid="LUK 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22"/>“እያ ጎዳይ ዛሪድ፥ ‘ነኖ ኢታ አይልያዉ ነ ዶና ታ ነና ፕርዳና። ታ ዎናባ ኤከይሳነ ዘሮናባ ጫክያ አስ ግደይሳ ነ ኤርኮ፥ <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/>ታ ያዳ ታ ሚሽያ ዎራ ኤካና መላ ዛልእያ አሳስ አይስ እማብኪ?’<verse eid="LUK 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>“እያ ጎዳይ ሄ በሳን ኤቅዳይሳታኮ፥ ‘እያራ ደእያ ሚሽያ ኤክድ ታማ ዎስዳይሳስ እምተ’ ያግስ።<verse eid="LUK 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25"/>“ኤንቲ፥ ‘ጎዳዉ፥ እያዉ ካሰካ ታሙ ምናነይ ደኤስ’ ያግዶሶና።<verse eid="LUK 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26"/>“ጎዳይ፥ ታ ህንተዉ ኦዳይስ፤ ‘ደእያ ኡባስ ሀር ጉዠታና፥ ሽን ባይናይሳፈ ሀራይ አቶ እያዉ ደእያራካ ኤከታና።<note caller="-" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ 13:12</ref>፤ <ref loc="MRK 4:25">ማር 4:25</ref>፤ <ref loc="LUK 8:18">ሉቃ 8:18</ref>.</char></note> <verse eid="LUK 19:26"/><verse number="27" style="v" sid="LUK 19:27"/>ግዶሽን፥ ታ ኤንታ ቦላ ካዎቶና መላ ኮይዳይሳታ ሄ ታ ሞርከታ ሀ ታ ስን ኤህድ ጎራዕተ’ ግስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">19:27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">ማቶ 25:14-30</ref>.</char></note><verse eid="LUK 19:27"/></para>
  <para style="s1">ግታ ቦንቾን የሩሳላመ ገሉዋ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ 21:1-11</ref>፤ <ref loc="MRK 11:1-11">ማር 11:1-11</ref>፤ <ref loc="JHN 12:12-19">ዮሀ 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>የሱሲ ሄሳ ኦድዳፐ ጉየ፥ ኤንታፈ ስን ሄመትድ የሩሳላመ ብስ። <verse eid="LUK 19:28"/><verse number="29" style="v" sid="LUK 19:29"/>ሻማሆ ዙማ<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="fq" closed="false">ሻማሆ ዙማ፦ </char><char style="ft" closed="false">ሻማሆይ ዳሮ ዶልያ ዙማ ጉሱ።</char></note> ቦላ ደእያ ቤተፋገነ ብታነ ማትዳ ዎደ ባ ታማረታፐ ናምአታ ኪትድ፥ <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>“ህንተ ስንን ደእያ ጉታ ቢተ፥ ህንተ ያ ጋክያ ዎደ ኦንካ ቶጎና ቃሸትድ ደእያ ሀረ ማር ደማና። እያ ብልድ ሃ ኤክ ዪተ። <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/>ኦንካ፥ ‘አይስ ብሌቲ?’ ግድ ኦይችኮ፥ ‘ጎዳይ እያ ኮዬስ’ ያግተ” ያግስ።<verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>ኪተትዳይሳት ብድ እ ግዳይሳዳ ሀንን በእዶሶና። <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>ኤንቲ ሀረ ማራ ብልሽን ጎዳት በእድ፥ “ሀረ ማራ አይስ ብሌቲ?” ያግዶሶና።<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>ኤንቲ ዛሪድ፥ “ጎዳይ እያ ኮዬስ” ያግዶሶና።<verse eid="LUK 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35"/>ያፐ ሀረ ማራ የሱሳኮ ኤህዶሶና። ባንታ ማኡዋ ሀረ ማራ ዞኮን የግድ የሱሳ ሀረ ማራ ቦላ ኡትስዶሶና። <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>አሳይካ እ ብያ ኦግያ ቦላ ባንታ ማኡዋ ሂፅዶሶና።<verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37"/>ሻማሆ ዙማ ዱገ ዎስያ ኦግያኮ ማትያ ዎደ፥ ታይቦን ኬህ ዳሮ አሳይ ኤንቲ በእዳ ማላልስያባን ኡፋይትድ ባንታ ቃላ ቁ ኦድ፥<verse eid="LUK 19:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38"/>“ጎዳ ሱንን ያ ካዎይ አንጀትዳይሳ</para>
  <para style="q2" vid="LUK 19:38">ሳሉዋን ሳሮይ</para>
  <para style="q2" vid="LUK 19:38">ኡባፈ ቃ ሳሉዋን ቦንቾይ</para>
  <para style="q2" vid="LUK 19:38">ፆሳስ ግዶ”</para>
  <para style="m" vid="LUK 19:38">ያግድ ፆሳ ጋላትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">19:38 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዝ 118:26</ref>.</char></note><verse eid="LUK 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>አሳ ግዶፈ እስ እስ ፋርሳወት የሱሳኮ፥ “አስታማርያዉ፥ ነ ታማረታ ሀይዝተ ጋዳ ሀንቀታ” ያግዶሶና።<verse eid="LUK 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40"/>እ ኤንታኮ፥ “ኤንቲ ስእ ጊኮ ሹቻት ዋሳና” ያግስ።<verse eid="LUK 19:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41"/>የሱሲ የሩሳላመ ማትሸ ካታማ በእድ እያዉ ዬክስ። <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>“ነዉ ሳሮ ግዳናይሳ ሀች ነ ኤርዳባ ግድያኮሽን፥ ሀእ ነ አይፍያፐ ጌምስ። <verse eid="LUK 19:42"/><verse number="43" style="v" sid="LUK 19:43"/>ነ ሞርከት ነ ዩሹዋ ድርድ ዱማ ዱማ ኦግያራ ነና ተቅድ ኡንኤያ ዎደይ ያና። <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/>ነናነ ነ ድርሳ ጋርሳን ደእያ ነ ናይታ ይሳና። እስ እስ ሹቹ ደንድ ላላና፥ አይስ ጊኮ ፆሳይ ነና አሻናዉ ያ ዎድያ ኤራባካ” ያግድ እዉ ዬክስ።<verse eid="LUK 19:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>ሄሳፈ ጉየ፥ የሱሲ ፆሳ ኬ ገልድ ዛልኤይሳታ ያፐ ጎድስ። <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>ቃስ፥ “ ‘ታ ኬይ ፆሳ ዎስያ ኬ ግዳና’ ግድ ፃፈትስ፥ ሽን ህንተ ታ ኬ ፓንጋታ ጎንጎሎ ኦደታ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">19:46 </char><char style="xt" closed="false"><ref loc="ISA 56:7">እሳ 56:7</ref>፤ <ref loc="JER 7:11">ኤርም 7:11</ref>.</char></note><verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>ጋላስ ጋላስ ፆሳ ኬን ታማርሴስ። ካህነታ ሀላቃት፥ ህገ አስታማረትነ ደርያ ጭማት እያ ዎናዉ ኦገ ኮዮሶና።<note caller="-" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="LUK 21:37">ሉቃ 21:37</ref>.</char></note> <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>ግዶሽን፥ አሳ ኡባይ እያ ትምርትያ ባንታ ዎዛና የግድ ስእያ ግሾ፥ ኤንታዉ ኦናባይ ይስ።<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s1">የሱሳ ማታይ ኦይሸተ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶ 21:23-27</ref>፤ <ref loc="MRK 11:27-33">ማር 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>እስ ጋላስ የሱሲ ፆሳ ኬን አሳ ታማርስሽንነ ዎንገላ ማርካትሽን፥ ካህነ ሀላቃት፥ ህገ አስታማረትነ ደርያ ጭማት እስፈ እያኮ ይድ፥ <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>“ኔኒ ሀይሳታ አይብ ማታን ኦያኮ ኑስ ኦዳ። ሀ ማታ ነዉ እምዳይ ኦኔ?” ያግድ ኦይችዶሶና።<verse eid="LUK 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3"/>እ ኤንታኮ፥ “ታካ ህንተና እስባ ኦይቻና፥ አነ ታዉ ዛርተ። <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/>ፃማቅያ ዮሃንሳ ፅንቃተይ ፆሳፈየ አሳፔ?” ያግስ።<verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>ኤንቲ ዎል ግዶን ያግድ ዞረትዶሶና፦ “ፆሳፈ ጊኮ ያትን፥ አይስ አማንበከቲ?” ያጋና።<verse eid="LUK 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 20:6"/>“አሳፐ ጊኮ፥ አሳ ኡባይ ዮሃንስ ናበ ግደይሳ አማንያ ግሾ ኑና ሹቻን ጫዳና።”<verse eid="LUK 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7"/>ያንያ ግሾ፥ “አዉፐኮ ኑ ኤሮኮ” ያግድ ዛርዶሶና።<verse eid="LUK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8"/>የሱሲ ዛሪድ፥ “ህዛ፥ ታካ አይ ማታን ሀይሳታ ኦያኮ ህንተዉ ኦድከ” ያግስ።<verse eid="LUK 20:8"/></para>
  <para style="s1">ጎሻንቾታ ሌምሶ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶ 21:33-46</ref>፤ <ref loc="MRK 12:1-12">ማር 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>ሄሳፈ ጉየ፥ የሱሲ ያግድ ሀ ሌምሱዋ አሳስ ኦድስ፦ “እስ አስ ዎይነ ቶክስ። ጎሻንቾታስ ከራ እምድ ዳሮ ዎደ ጋምእድ ያናዉ ሀራ ቢታ ብስ።<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="ISA 5:1">እሳ 5:1</ref>.</char></note> <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>ዎይነ አይፍያ ማፅያ ዎደይ ጋክን ዎይነ አይፍያፐ እያዉ የዳና መላ ጎሻንቾታኮ ባ አይልያ ኪትስ። ሽን ጎሻንቾት ሄ አይልያ ኦይክድ ዋድ መላ ኩሸ የድዶሶና። <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>ካልድካ ሀራ አይልያ ኪትስ። ቃስ ጎሻንቾት እያ ዋድ፥ ካዉሽድ መላ ኩሸ የድዶሶና። <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>ሀእካ ዛሪድ ሄን አይልያ ኪትስ። ጎሻንቾት እያካ ማዱንፅስድ ዎይነ ጋድያ ግዶፈ ጋፃ ከስድ የግዶሶና።<verse eid="LUK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13"/>“ዎይነ ጋድያ ጎዳይ፥ ‘ያትን ታ አይ ኦ? አነ ቃስ ታ ዶስያ ታ ናአ የዳና፤ ኦን ኤር ኤንቲ እያ ቦንቾና አጎኮና’ ያግስ።<verse eid="LUK 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14"/>“ሽን ጎሻንቾት ኡራ ናአ በእዳ ዎደ፥ ‘ሀይስ እያ ላታናይሳ፥ ሃ ዪተ እያ ዎና፥ ያትኮ ላታይ ኑስ ግዳና’ ያግድ ዞረትዶሶና። <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>ዎይነ ጋድያ ግዶፈ ጋፃ ከስድ ዎዶሶና። ያትን፥ ዎይነ ጋድያ ጎዳይ ሄ አሳታ ዋታኔ? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>ይድ ሄ ጎሻንቾታ ይሳና፥ ዎይነ ጋድያ ሀራ አሳታስ እማና። አሳይ ሄሳ ስእዳ ዎደ ‘ሽንቻለ ሄሳ መላባ ጋፎ’ ያግዶሶና።<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>“የሱሲ ኤንታ ጫድ ፄልድ፥</para>
  <para style="q1" vid="LUK 20:17">“ ‘ያትን፥ ግምበ ኬፅያ አሳት ቦርዳ ሹቻይ፥</para>
  <para style="q2" vid="LUK 20:17">ኬስ ማላነ ምኖተ እምያ ኡባፈ አያ ሹች ግድስ’</para>
  <para style="m" vid="LUK 20:17">ጌተትድ ፃፈትዳይሳ ብርሸይ አይቤ?<note caller="-" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዝ 118:22</ref>.</char></note> <verse eid="LUK 20:17"/><verse number="18" style="v" sid="LUK 20:18"/>ሄ ሹቻ ቦላ ኩንድያ ኡባይ ቆፀታና፥ ሹቻይ እያ ቦላ ዎያ ኡባይ ሊቃና” ያግስ።<verse eid="LUK 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>ህገ አስታማረትነ ካህነ ሀላቃት ሀ ሌምሶይ ኦደትዳይ ኤንታ ቦላ ግደይሳ ኤርድ ሄ ዎደ እያ ኦይካናዉ ኮይዶሶና፥ ሽን አሳስ ባብዶሶና።<verse eid="LUK 20:19"/></para>
  <para style="s1">ጊራባ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶ 22:15-22</ref>፤ <ref loc="MRK 12:13-17">ማር 12:13-17</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20"/>ሄሳ ግሾ፥ የሱሳ ደርያ ሃርያ ሮመ ካዋ ማታስ አድ እማናዉ ኮይድ እያ ዶናፐ ባላ ቃላ ናጎሶና። ሄሳ ፖልሳናዉ ፅሎ ዳንድ ጭምያ አሳታ እያኮ ኪትዶሶና። <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>ኪተትድ ብዳ አሳት፥ “አስታማርያዉ፥ ኔኒ ኦደይስነ ታማርሰይስ ልከ ግደይሳ፥ ቃስ ፆሳ ኦግያ ቱማተን ታማርሰይሳነ ኦናካ ሻኮናይሳ ኑ ኤሮስ። <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>ሀኖሽን፥ ሮመ ካዋስ ጊራ ጊራናዉ በሲ በሰኔ?” ያግድ እያ ኦይችዶሶና።<verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>ሽን እ ኤንታ ዎዛና ኢታተ ኤርዳ ግሾ፥ <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>“አነ ታና እስ ሳንትመ በስተ፥ እያ ቦላ ደእያ ምስለይነ ሱንይ ኦደባዬ?” ያግስ።</para>
  <para style="p" vid="LUK 20:24">ኤንቲ ዛሪድ፥ “ሮመ ካዋ ቄሳረይሳ” ያግዶሶና።<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>እ ዛሪድ፥ “ያትኮ፥ ቄሳረባ ቄሳረስ፥ ፆሳባ ፆሳስ እምተ” ያግስ።<verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>ሄሳ ግሾ፥ እ ዛርዳ ዛሩዋን አሳ ስንን ባላ ደማናዉ ዳንዳእቦኮና። እያ ዛሩዋን ማላለትድ ስእ ግዶሶና።<verse eid="LUK 20:26"/></para>
  <para style="s1">ሀይቆፐ ደንዶባ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶ 22:23-33</ref>፤ <ref loc="MRK 12:18-27">ማር 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>ሀይቆፐ ደንዶይ ባዋ ግያ ሳዱቃወታፐ እሶት እሶት የሱሳኮ ይድ፥<note caller="-" style="x"><char style="xo" closed="false">20:27 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሀዋ 23:8</ref>.</char></note> <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>“አስታማርያዉ፥ እስ አስ ማቾ ኤክድ ናአ የሎና ሀይቅኮ፥ እያ እሻይ ሄ ማጫስዉ ኤክድ ናይታ የልድ ባ እሻስ ኮቸ አሻና መላ ሙሰይ ፃፍስ።<note caller="-" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዛረ 25:5</ref>.</char></note> <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>ሄኮ ላፑን እሻት ደኦሶና። ኮይሮይስ ማቾ ኤክድ ናአ የሎና ሀይቅስ። <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>ናምአንይ እዮ ኤክድ ናአ የሎና ሀይቅስ። <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>ሄንይካ ሄሳ ሀንስ። ላፑናት ኡባይ ሄሳዳ ሀንድ እዮ ኤክዶሶና፥ ሽን ናአ የሎና ሀይቅዶሶና። <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>ዉርሰን ማጫስያ ሀይቃሱ። <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>ህዛ፥ ላፑን አደይ እዮ ኤክዳ ግሾ ሀይቆፐ ደንድያ ዎደ እያ ኦደ ማቾ ግዳኔ?” ያግድ ኦይችዶሶና።<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>የሱሲ ዛሪድ፥ “አሳይ ሀ ዎድያን ኤኮሶናነ ገሎሶና። <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>ሽን ሀይቆፐ ደንድድ ያና አላምያን ዳናዉ በሰይሳት ኤኮኮናነ ገሎኮና። <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>ኤንቲ ኪታንቾ መላ ግድያ ግሾ ስንፈ ሀይቆኮና። ሀይቆፐ ደንድዳ ግሾ ኤንቲ ፆሳ ናይታ። <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/>ሙሰይ ጎዳ፥ ‘አብራሃመ ጎዳ፥ ይሳቃ ጎዳ፥ ያይቆባ ጎዳ’ ግድ ቱሽያ ግዶን ፁገትያ ታማ ታርክያ ፃፍዳይሳን ሀይቅዳ አሳይ ደንደይሳ በሴስ።<note caller="-" style="x"><char style="xo" closed="false">20:37 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከሳ 3:6</ref>.</char></note> <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>ኡባይ እያዉ ደኦን ደኤይሳታ ግድያ ግሾ እ ደኦን ደኤይሳታ ጎዳፐ አትሽን፥ ሀይቅዳይሳታ ጎዳ ግደና” ያግድ ዛርስ።<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>ህገ አስታማረታፐ እሶት እሶት፥ “አስታማርያዉ፥ ሎኦባ ኦዳዳሳ” ያግዶሶና። <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>ሄሳፈ ጉየ፥ ሀራ ኦይሾ ኦይቻናዉ ያይዶሶና።<verse eid="LUK 20:40"/></para>
  <para style="s1">ክርስቶስ ኦደ ናኤ?</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶ 22:41-46</ref>፤ <ref loc="MRK 12:35-37">ማር 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>እያፐ ካልድ የሱሲ ኤንታኮ፥ “አሳይ ክርስቶሳ ዋትድ ዳዊታ ናአ ያጎና? <verse eid="LUK 20:41"/><verse number="42-43" style="v" sid="LUK 20:42-43"/>አይስ ጊኮ፥ ዳዊቲ ባ ሁጰን ባ ማፃፋን፥</para>
  <para style="q1" vid="LUK 20:42-43">“ ‘ፆሳይ ታ ጎዳኮ “ታ ነ ሞርከታ</para>
  <para style="q2" vid="LUK 20:42-43">ነ ቶሆይ የያሶ ኦና ጋካናዉ</para>
  <para style="q2" vid="LUK 20:42-43">ታፐ ኡሻቻ ባጋን ኡታ” ግስ’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">20:42-43 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ 110:1</ref>.</char></note><verse eid="LUK 20:42-43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 20:44"/>“ህዛ፥ ዳዊቲ ክርስቶሳ፥ ‘ጎዳ ግድ ፄግሸ እያዉ ናአ ዋንድ ግዲ?’ ” ያግስ።<verse eid="LUK 20:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>ደረይ ኡባይ ስእሽን ባ ታማረታኮ፥ <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>“አዱሳ ማኦ ማእድ ዩሸ ዶሰይሳታፐ፥ ግያን ቦንቾ ሳሮ፥ አይሁደ ዎሳ ኬን ቦንቾ ኦይደ፥ ሞከትያ ሶንካ ቦንቾ በሲ ኮይያ ህገ አስታማረታፐ ናገትተ። <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>ኤንቲ አምኤታ ኬ ካሎዮሶና፥ ፅሎ አስ ዳንድ ዎሳ አዱሶሶና። ሄሳት ኡባፈ አያ ኢታ ፕርዳ ኤካና” ያግስ።<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s1">አምኤ ሙፃታ</para>
  <para style="r">(<ref loc="MRK 12:41-44">ማር 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>ዱረ አሳይ ፆሳ ኬን ሙፃታ ሳፅንያን የግሽን የሱሲ ቁ ግድ አሳ በእስ። <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>ቃስ እስ ማንቆ አምእያ ናምኡ ስክና የግሽን በእድ፥ <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>“ታ ህንተዉ ቱማ ኦዳይስ፤ ሀ ማንቆ አምእያ ኡባፈ አዳ እማሱ። <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>አይስ ጊኮ፥ ሀ አሳ ኡባይ ባንታዉ ደእያባፐ እምዶሶና፥ ሽን እያ ባ ፓጫፐ፥ ባዉ ደእያ አቁዋ ኡባ እማሱ” ያግስ።<verse eid="LUK 21:4"/></para>
  <para style="s1">ዎደ ዉርሰ ማላታታ</para>
  <para style="r">(<ref loc="MAT 24:3-14">ማቶ 24:3-14</ref>፤ <ref loc="MRK 13:3-23">ማር 13:3-23</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>የሱሳ ታማረታፐ እሶት እሶት ፆሳ ኬይ ዳሮ ሎእያ ሹቻንነ አሳይ ፆሳስ እምዳ እሞታን ሎእዳይሳ ኦደቶሶና። <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/>ሽን የሱሲ፥ “ሀ ህንተ በእያባይ ኡባይ ላለቶና፥ ሹች ሹቻ ቦላ ግምበትዳ መላ አቶና ዎደይ ያና” ያግስ።<verse eid="LUK 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>ኤንትካ፥ “አስታማርያዉ፥ ሀ ኡባይ ሀናናይ አዉዴ? ቃስ ሀይስ ሀናናይሳስ ማላታይ አይቤ?” ያግድ ኦይችዶሶና።<verse eid="LUK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>የሱሲ ያግድ ኤንታዉ ዛሮ እሚስ፦ “ባለቶና መላ ናገትተ። ዳሮት፥ ‘ታኒ ክርስቶሳ፥ ዎደይ ማታትስ’ ያግሸ ታ ሱንን ያና፥ ሽን ህንተ ኤንታ ካሎፍተ። <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>ህንተ ኦላባነ አሳ ጌላተ ስእያ ዎደ ዳጋሞፍተ። ሄስ ስንትድ ሀናናይስ አቶናባ ግድያ ግሾ ዎድያ ዉርሰይ ኤለስድ ዬና” ያግስ።<verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>ካልድካ፥ “ደረይ ደርያ ቦላ፥ ካዎተይ ካዎተ ቦላ ደንዳና። <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>ግታ ቢታ ቃፆይ ሀናና፥ ኮሻይነ ጋዶይ ዱማ ዱማ በሳን ዳራና፥ ያሽያባይነ ግታ ማላታት ሳሎፐ ቆንጫና። <verse eid="LUK 21:11"/><verse number="12" style="v" sid="LUK 21:12"/>ሽን ሀ ኡባይ ሀናናፐ ስን ታ ሱን ግሾ ግድ አሳይ ህንተና ጎዳናነ ኦይካና። አይሁደ ዎሳ ኬንነ ቃሾ ኬን ህንተና የጋና። ካዎታ ስንነ ደርያ ሃረይሳታ ስን ህንተና ኤፋና። <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>ሄስካ ታባ ህንተ ኤንታዉ ማርካታናዉ ሎኦ ኦገ ግዳና። <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>ሄሳ ግሾ፥ ህንተ ኦይሸትያ ዎደ ዎይግድ ዛሮ እማነ ግድ ህንተ ዎዛናን ኡንኤቶና መላ አኬክተ።<note caller="-" style="x"><char style="xo" closed="false">21:14 </char><char style="xt" closed="false"><ref loc="LUK 12:11-12">ሉቃ 12:11-12</ref>.</char></note> <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>አይስ ጊኮ፥ ህንተ ሞርከት ህንተራ ኤቀታናዉነ ፓላማናዉ ዳንዳኦና ዶናነ ጭንጫተ ታ ህንተዉ እማና። <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>ሀር አቶሽን፥ ህንተና የልዳይሳት፥ ህንተ እሻት፥ ህንተ ዳቦትነ ላገት ህንተና አድ እማና። ህንተ ግዶፈ እሶታ እሶታ ዎና። <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>ታ ሱን ግሾ አሳ ኡባ ስንን ህንተ እፀትዳይሳታ ግዳና። <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>ሽን ሀር አቶሽን፥ ህንተ ብናናፐ እሶይካ የና። <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>ፖሎ ዳንዳአን ህንተ፥ ህንተ ሸምፑዋ አሻና።”<verse eid="LUK 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>“የሩሳላመ ካታማይ ዎታዳረን ድረትድ ኡትዳሽን ህንተ በእኮ እያዉ ዮይ ማታትዳይሳ ኤርተ። <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>ሄ ዎደ ይሁዳን ደእያ ኡባይ ደርያኮ ባቃቶ፥ ካታማን ደኤይሳት ያፐ ከዮ፥ ጋፃርያን ደኤይሳት ካታማ ገሎፖ። <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>አይስ ጊኮ፥ ሀ ፃፈትዳባይ ፖለታና መላ ሄስ ፆሳይ ኩሸ ዛርያ ዎደ።<note caller="-" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="HOS 9:7">ሆሰ 9:7</ref>.</char></note> <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>ሳአ ቦላ ግታ መቶይ ያና፥ ሄሳንካ አሳ ቦላ ፆሳ ሀንቆይ ያና። ሄሳ ግሾ፥ ቃንትዳይሳታነ ንይሳታ አየ! <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>ኤንቲ ማሻን ሀይቃና፥ አሳ ኡባይ አላጋ ቢታ ድኤታና። አይሁደ ግዶና አሳ ዎደይ ፖለታና ጋካናዉ የሩሳላመይ ኤንታናን የትዳይሳ ግዳና።<verse eid="LUK 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>“አዋን፥ አጌናንነ፥ ፆልንቶታ ቦላ ማላታት ሀንድ በንታና። አባፈነ ዙልያ ደሹዋፐ ደንዶይሳን ቢታን ደእያ አሳይ ኡንኤታናነ ያርካና።<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ISA 13:10">እሳ 13:10</ref>፤ <ref loc="EZK 32:7">ህዝ 32:7</ref>፤ <ref loc="JER 2:31">ኤርም 2:31</ref>፤ <ref loc="REV 6:12">ቆን 6:12</ref>.</char></note> <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>ሳሉዋ ዎልቃት ቡቀታና ግሾ አሳይ ያሻንነ ቢታ ቦላ አይብ ሀናንደሻ ግድ ናጎን ባንታና ባለታና። <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/>ሄ ዎደ አሳ ናአይ ዎልቃንነ ግታ ቦንቾን ሻራራ ይሽን ኤንቲ በአና።<note caller="-" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳነ 7:13</ref>፤ <ref loc="REV 1:7">ቆን 1:7</ref>.</char></note> <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>ህንተ አቶተይ ማታትዳ ግሾ ሀ ሀኖት ፖለተ ኦይክያ ዎደ ጊገት ኤቅተ፥ ህንተ ሁጵያ ቁ ኦድ ፄልተ” ያግስ።<verse eid="LUK 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>ካልድካ፥ ሀይሳዳ ግድ ሌምሶ ኦድስ፤ “ባላሰ ምነ ሀራ ምታ ኡባ በእተ። <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/>ኤንቲ አጭያ ዎደ ቶርቸይ ማታትዳይሳ ህንተ ኤሬታ። <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/>ሄሳዳ ሀ ሀኖት ፖለትሽን ህንተ በእኮ ፆሳ ካዎተይ ማታትዳይሳ ኤርተ።<verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>“ታ ህንተዉ ቱማ ኦዳይስ፤ ሀ ኡባይ ፖለታና ጋካናዉ ሀ የለተይ አና። <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>ሳሎይነ ሳእ አና፥ ሽን ታ ቃላይ አና።<verse eid="LUK 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>“ህዛ፥ ስ ባይና ደኦን፥ ኡሻ ዳሮንነ ዱሳባስ ኡንኤተን ህንተ ዎዛናይ ኦይከቶና መላነ ሄ ቃማይ አኬኮና ፅሄዳ ህንተ ቦላ ጋኮና መላ ናገትተ። <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>ሄ ቃማይ ቢታ ኩመን ደእያ ኡባ ቦላ ጋካና። <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>ሄሳ ግሾ፥ ያ ኢታፐ አታናዉነ አሳ ናአ ስንን ኤቃናዉ ዳንዳአና መላ ኡባ ዎደ ምንድ ዎስተ” ያግስ።<verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>ጋላስ ጋላስ የሱሲ ፆሳ ኬን ታማርስሸ፥ ቃማ ቃማ ሻማሆ ዙማ ቦላ ከይድ አቄስ።<note caller="-" style="x"><char style="xo" closed="false">21:37 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ 19:47</ref>.</char></note> <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>አሳ ኡባይ እያ ስአናዉ ዎንታ ጉራ እያኮ ፆሳ ኬ ዮሶና።<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s1">ይሁድ የሱሳ አድ እማናዉ ማቀትስ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ 26:1-5</ref>፥ <ref loc="MAT 26:14-16">14-16</ref>፤ <ref loc="MRK 14:1-2">ማር 14:1-2</ref>፥ <ref loc="MRK 14:10-11">10-11</ref>፤ <ref loc="JHN 11:45-53">ዮሀ 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>ሄ ዎደ “ፓስካ” ግያ ኡይ ባለይ ማትስ።<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1">ከሳ 12:1</ref>.</char></note> <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>ካህነ ሀላቃትነ ህገ አስታማረት አሰ ያይያ ግሾ፥ ዋትድ የሱሳ ባንታ ግዶፈ ይሳነኮ ኦገ ኮዮሶና። <verse eid="LUK 22:2"/><verse number="3" style="v" sid="LUK 22:3"/>ፃላሄይ ታማነ ናምአታፐ እሱዋ ግድዳ አስቆሮታ ይሁዳ ጌተተይሳ ግዶ ገልስ። <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>ይሁድ ካህነ ሀላቃታኮነ ፆሳ ኬ ናገይሳታ ሀላቃታኮ ብድ የሱሳ ዋት አድ እማነኮ ኤንታራ ማቀትስ። <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>ኤንትካ ሄሳን ኡፋይትድ ሚሸ እማናዉ እያራ ዞረትዶሶና። <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/>እካ ዞረተን ጊግስ። አ ኤንታዉ እማናዉ አስ ባይና እንጀ ዎደ ናግሸ ደኤስ።<verse eid="LUK 22:6"/></para>
  <para style="s1">ዉርሰ ካሆ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶ 26:17-25</ref>፤ <ref loc="MRK 14:12-21">ማር 14:12-21</ref>፤ <ref loc="JHN 13:21-30">ዮሀ 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>ሄሳፈ ጉየ፥ ፓስካ ዶርሳይ ሹከትያ ኡይ ባለይ ጋክስ። <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/>የሱሲ፥ “ፓስካ ካሁዋ ማና መላ ብድ ኑስ ጊግስተ” ያግድ ጰፅሮሳነ ዮሃንሳ ኪትስ። <verse eid="LUK 22:8"/><verse number="9" style="v" sid="LUK 22:9"/>ኤንቲ፥ “ኑ አዉን ጊግሳና መላ ነ ኮያይ” ያግድ ኦይችዶሶና። <verse eid="LUK 22:9"/><verse number="10" style="v" sid="LUK 22:10"/>እ ኤንታኮ፥ “ሄኮ ህንተ ካታማ ገልሽን ሃ ኦቶ ቶክዳ አደይ ህንተራ ጋሄታና። እ ብድ ገልያ ኬ እያ ካልድ ገልተ። <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>አስታማረይ ጎዳኮ፥ ‘ታ ታ ታማረታራ ዎላ ፓስካ ካሁዋ ማናዉ እማ ኬ አዉኔ? ያግስ’ ጊተ። <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>እ ፖቅያ ቦላ ሂፀትድ ጊግድ ደእያ ዳልጋ ክፍለ ህንተና በሳና፥ ያን ጊግስተ” ያግስ። <verse eid="LUK 22:12"/><verse number="13" style="v" sid="LUK 22:13"/>ኤንቲ ብድ የሱሲ ግዳይሳዳ ሀንን ደምዶሶና። ፓስካ ባኣለ ካሁዋ ያን ጊግስዶሶና።<verse eid="LUK 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14"/>ሳተይካ ጋክዳ ዎደ የሱሲ ሀዋረታራ ዎላ ካሁዋ ቦላ ኡትስ። <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/>እ ኤንታኮ፥ “ታ ዋየ ኤካናፐ ስን ሀ ካሁዋ ህንተራ ማናዉ ዳሮ አሞታስ። <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/>ህዛ፥ ስእተ! ፆሳ ካዎተን ሀይሳስ ብርሸይ ፖለታና ጋካናዉ ሀ ካሁዋ ዛራዳ ሚከ” ያግስ። <verse eid="LUK 22:16"/><verse number="17" style="v" sid="LUK 22:17"/>ኡሻ ኤክድ ጋላት ስሚድ፥ “ሄእተ ሀይሳ ህንተ ግዶን ሻከትተ። <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>ስእተ! ፆሳ ካዎተይ ያና ጋካናዉ ሀችፈ ዶማዳ ሀ ዎይነ ኡሻፈ ዛራዳ ኡይከ” ያግስ።<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>ኡይ ኤክድ፥ ጋላት ስሚድ፥ “ሀይስ ህንተዉ እመትያ ታ አሹዋ። ሀይሳ ኦሸ ታና ቆፕተ” ያግድ መንድ ኤንታዉ እሚስ።<verse eid="LUK 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20"/>ሄሳዳካ፥ ካሁዋፐ ጉየ፥ ኡሻ ኤክድ፥ “ሀ ኡሻይ ህንተዉ ጉክዳ ታ ሱን ግድያ ኦራ ጫቁዋ።<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="JER 31:31">ኤርም 31:31</ref>.</char></note> <verse eid="LUK 22:20"/><verse number="21" style="v" sid="LUK 22:21"/>ግዶሽን፥ ታና አድ እማና ኡራ ኩሸይ ታራ እስፈ ጋይታና።<note caller="-" style="x"><char style="xo" closed="false">22:21 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ 41:9</ref>.</char></note> <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>አሳ ናአይ እያዉ ጌተቶይሳ መላ ሀይቃናዉ ደኤስ፥ ሽን እያ አድ እምያ ኡራ አየ!” ያግስ። <verse eid="LUK 22:22"/><verse number="23" style="v" sid="LUK 22:23"/>ኤንቲ ባንታ ግዶን፥ “ሀይሳ ኦን ኦኔ” ግድ ዎል ኦይችዶሶና።<verse eid="LUK 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>ቃስ ኤንታ ግዶን ግታ ግዳናይ ኦነ ግያ ፓላም መትስ።<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="MAT 18:1">ማቶ 18:1</ref>፤ <ref loc="MRK 9:34">ማር 9:34</ref>፤ <ref loc="LUK 9:46">ሉቃ 9:46</ref>.</char></note> <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>የሱሲ ኤንታኮ፥ “ደርያ ካዎት ባንታ አሳ ዎልቃን ሃሮሶና፤ ባንታ ደርያ ቦላ ጎዳተይሳታስካ ባንታና፥ ‘ሎኦ ኦይሳታ’ ያግድ ፄጎሶና።<note caller="-" style="x"><char style="xo" closed="false">22:25 </char><char style="xt" closed="false"><ref loc="MAT 20:25-27">ማቶ 20:25-27</ref>፤ <ref loc="MRK 10:42-44">ማር 10:42-44</ref>.</char></note> <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>ሽን ህንተ ግዶን ሄሳ መላ ግዶፖ። ህንተ ግዶን ባይራተይ ካሎዳ ሀኖ፤<note caller="-" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ 23:11</ref>፤ <ref loc="MRK 9:35">ማር 9:35</ref>.</char></note> ካለይስ ካለይሳዳ ሀኖ። <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/>ሀኖሽን፥ ሞከይሳፈነ ሞከተይሳፈ አዉስ አ? ሞከተይሳ ግደነዬ? ሽን ታኒ ህንተ ግዶን ሞከይሳ መላ።<note caller="-" style="x"><char style="xo" closed="false">22:27 </char><char style="xt" closed="false"><ref loc="REV 13:12">ቆን 13:12</ref>.</char></note><verse eid="LUK 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28"/>“ህንተካ ታ መቱዋን ታፐ ሻከቶና ታራ ምንድ ኤቅዳይሳታ። <verse eid="LUK 22:28"/><verse number="29-30" style="v" sid="LUK 22:29-30"/>ህንተ ታ ጋይታፐ ማና መላ፥ ኡያና መላነ አራታታ ቦላ ኡትድ ታማነ ናምኡ እስራኤለ ሼሻታ ቦላ ፕርዳና መላ ታ አዋይ ታና ሹምዳይሳዳ ታካ ህንተና ታ ካዎተን ሹማና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">22:29-30 </char><char style="xt" closed="false"><ref loc="MAT 19:28">ማቶ 19:28</ref>.</char></note><verse eid="LUK 22:29-30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>ካልድካ የሱሲ፥ “ስሞና፥ ስሞና፥ ፃላሄይ ህንተና ግስተዳ ሀርቃናዉ ዎስስ። <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>ሽን ታኒ ነ አማኖይ ዮና መላ ነዉ ጋናታስ። ነካ ስምዳ ዎደ ነ እሻታ ምን” ያግስ።<verse eid="LUK 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33"/>ስሞን፥ “ጎዳዉ፥ ታኒ ኔራ ቃሸታናዉነ ሀይቃናዉ ጊገታስ” ያግስ።<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>የሱሲ ጰፅሮሳኮ፥ “ታ ነዉ ኦዳይስ፤ ሀች ኩቶይ ዋሳናፐ ስን ነ ታና ሄ ቶሆ ካዳና” ያግስ። <verse eid="LUK 22:34"/><verse number="35" style="v" sid="LUK 22:35"/>ካልድካ፥ የሱሲ ኤንታኮ፥ “ታኒ ህንተና ኮሮጆይ፥ ካርፂትነ ጫም ባይና ኪትዳ ዎደ ህንተዉ ፓጭዳባይ ደኢ?” ያግድ ኦይችስ።<note caller="-" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="MAT 10:9-10">ማቶ 10:9-10</ref>፤ <ref loc="MRK 6:8-9">ማር 6:8-9</ref>፤ <ref loc="LUK 9:3">ሉቃ 9:3</ref>.</char></note></para>
  <para style="p" vid="LUK 22:35">ኤንቲ ዛሪድ፥ “አይኮይካ ፓጭቤና” ያግዶሶና።<verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>እ ኤንታኮ፥ “ሀእ ኮሮጆይነ ካርፂት ደኤይ ኦይኮ፤ ማሽ ባይናይ ባ አፍላ ባይዝድ ማሻ ሻሞ። <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>ሃ ስእተ! ‘ጌላታራ ታይበትስ’ ጌተትድ ፃፈትዳይስ ታናን ፖለታናዉ በሴስ። ኤ፥ ታ ግሾ ፃፈትዳባይ ፖለተይስ ቱማትስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="ISA 53:12">እሳ 53:12</ref>.</char></note><verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>እያ ታማረት፥ “ጎዳዉ ሀይሳን ናምኡ ማሻት ደኦሶና” ያግዶሶና።</para>
  <para style="p" vid="LUK 22:38">እ፥ “ግዳና” ያግስ።<verse eid="LUK 22:38"/></para>
  <para style="s1">የሱሲ ሻማሆ ደርያ ቦላ ዎስስ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቶ 26:36-46</ref>፤ <ref loc="MRK 14:32-42">ማር 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>የሱሲ ካሰ ሜዘትዳይሳዳ ደንድድ ሻማሆ ዙማ ቦላ ከይስ። እያ ታማረት እያ ካልዶሶና። <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>ሄ በሳ ጋክዳ ዎደ፥ “ፓጨን ገሎና መላ ዎስተ” ያግስ። <verse eid="LUK 22:40"/><verse number="41" style="v" sid="LUK 22:41"/>ኤንታፈ ሹች ሆልን ጋክያ ሶ መላ ሃክድ ጉልባትድ ዎስስ። <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>“ታ አዋዉ፥ ነ ሸነ ግድኮ ሀ መቱዋ ታፐ አ። ሽን ታ ሸነ ግዶፖ ነ ሸነይ ሀኖ” ያግድ ዎስስ። <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>ኪታንቾይ ሳሎፐ ቆንጭድ ምንስ። <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>ዳሮ ኡንኤትድ ምንድ ዎሴስ። እያ ጫዋይካ ሱ ፆክያዳ ሳአን ፆኬስ።<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>የሱሲ ዎሳ ዉርስድ ባ ታማረታኮ ይስ። ኤንቲ፥ አዛኖፐ ደንዶይሳን ዳቡርድ ስክዳሽን ደምድ፥ <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>“አይስ ስከቲ? ፓጨን ገሎና መላ ደንድድ ዎስተ” ያግስ።<verse eid="LUK 22:46"/></para>
  <para style="s1">የሱሲ ኦይከትስ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ 26:47-56</ref>፤ <ref loc="MRK 14:43-50">ማር 14:43-50</ref>፤ <ref loc="JHN 18:3-11">ዮሀ 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>እ ቡሮ ኦዳ ቦላ ደእሽን ዳሮ አሳት ይዶሶና። ታማነ ናምአታፐ እሶይ ይሁዳ ጌተተይስ ኤንታና ካለስ። እ የሱሳ ዬራናዉ ማት ሺቅስ። <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>ሽን የሱሲ፥ “ይሁዳ፥ አሳ ናኣ ዬራዳ አ እማኔ?” ያግስ።<verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>የሱሳ ታማረት ሄ ሀኑዋ በእድ፥ “ጎዳዉ ማሻን ሾጭኖ?” ያግዶሶና። <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>ኤንታ ግዶፈ እሶይ ካህነ ሀላቃ ኦሳንቹዋ ሾጭድ ኡሻቻ ሀይ ቃንፅድ የግስ።<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>ሽን የሱሲ፥ “አጋ! ድጎፍተ”<note caller="+" style="f"><char style="fr" closed="false">22:51 </char><char style="fq" closed="false">አጋ! ድጎፍተ፦ </char><char style="ft" closed="false">የሱሲ ሀ በሳን አጋ ያግዳይ እያ አሻናዉ ግድ አሳት ኡራ ሀይ ቃንፆይሳ አጋ ቃንፆፋ ግዳይሳነ፥ ሀራት እያ ኦይካናዉ ይዳይሳታ ድጎፍተ ሀእ ኤንታ ዎደ ያግዳይሳ ናምኡ ቆፋታ ዎል ጋድ ኦይክስ።</char></note> ያግስ። ኡራ ሀይ ቦችድ ፓስ።<verse eid="LUK 22:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52"/>ሄሳፈ ጉየ፥ የሱሲ ባና ኦይካናዉ ይዳ ካህነ ሀላቃታኮ፥ ፆሳ ኬ ናገይሳታ ሹማታኮነ ጭማታኮ፥ “ፓኖ ኦይክያ አሳዳ ማሸነ ፃምአ ኦይክድ ይደቲ? <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/>ኡባ ጋላስ ፆሳ ኬን ታ ህንተራ ደእያ ዎደ ታ ቦላ ኩሸ ዎቤከታ። ሽን ሀይስ ማ ካዎተይ ሃርዳ ዎደነ ህንተ ዎደ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">22:53 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ 19:47</ref>፤ <ref loc="LUK 21:37">21:37</ref>.</char></note><verse eid="LUK 22:53"/></para>
  <para style="s1">ጰፅሮስ የሱሳ ካድስ</para>
  <para style="r">(<ref loc="MAT 26:57-58">ማቶ 26:57-58</ref>፥ <ref loc="MAT 26:67-75">67-75</ref>፤ <ref loc="MRK 14:53-54">ማር 14:53-54</ref>፥ <ref loc="MRK 14:66-72">66-72</ref>፤ <ref loc="JHN 18:12-18">ዮሀ 18:12-18</ref>፥ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>ሄሳፈ ጉየ፥ የሱሳ ኦይክድ ካህነ ሀላቃ ዛባ ኤፍዶሶና። ጰፅሮስ ሃሆን የሱሳ ካሌስ። <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>አሳት ካህነ ሀላቃ ዛባን ታማ ኤድ ዎላ ኡትዳሽን ጰፅሮስ ኤንታራ እስፈ ኡትስ። <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>እስ ጋንዲያ ጰፅሮስ ታማ ማታን ኡትዳይሳ ጫዳ ፄላዳ፥ “ሀ ኡራይ እያራ ደኤስ” ያጋሱ።<verse eid="LUK 22:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57"/>ሽን ጰፅሮስ፥ “ሀ ማጫሰተ ታ ሄ ኡራ ኤርከ” ያግድ ካድስ።<verse eid="LUK 22:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58"/>ጉ ዎደፐ ጉየ እስ ሀራ አደይ እያ በእድ፥ “ነካ ኤንታፈ እሱዋ” ያግስ።</para>
  <para style="p" vid="LUK 22:58">ሽን ጰፅሮስ፥ “ሀ አድያዉ ታና ግድከ” ያግስ።<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>እስ ሳተ መላ ጋምእዳፐ ጉየ እስ ሀራ አደይ ትልስድ፥ “ሀ ኡራይ ጋልላፐ ግድያ ግሾ ስይ ባይና እያራ ደኤስ” ያግስ።<verse eid="LUK 22:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60"/>ሽን ጰፅሮስ፥ “ሀ አድያዉ፥ ነ ገይሳ ታ ኤርከ” ያግስ። እ ሄ ኦዳ ኦንጎና ደእሽን ኩቶይ ዋስስ።<verse eid="LUK 22:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 22:61"/>ጎዳይ ጉየ ስሚድ ጰፅሮሳ ፄልስ። ጰፅሮስ፥ “ሀች ኩቶይ ዋሳናፐ ስን ነ ታና ሄ ቶሆ ካዳና” ያግድ፥ ጎዳይ ኦድዳ ቃላ አኬክስ። <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>ጰፅሮስ ካረ ከይድ ዳሮ ኮኮርድ ዬክስ።<verse eid="LUK 22:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>የሱሳ ናግያ አሳት እያ ለቅሶነ ደሸ ኦይክዶሶና። <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>እያ አይፍያ ጎዝድ “አነ ትንብተ ኦዳ፤ ነና ደችዳይ ኦኔ?” ያግድ ኦይቾሶና። <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>ሀራ ዳሮ ጫሸ ጫይድ ካዉሾሶና።<verse eid="LUK 22:65"/></para>
  <para style="s1">የሱሲ ፕርዳ ሻንጎ ስንን</para>
  <para style="r">(<ref loc="MAT 26:59-66">ማቶ 26:59-66</ref>፤ <ref loc="MRK 14:55-64">ማር 14:55-64</ref>፤ <ref loc="JHN 18:19-24">ዮሀ 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>ሳእ ዎንትያ ዎደ አይሁደ ቢታ ጭማት፥ ካህነ ሀላቃትነ ህገ አስታማረት ሺቅድ፥ የሱሳ ባንታ ስን ሺሽዶሶና። <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>ኤንቲ፥ “ኔኒ ክርስቶሴ? አነ ኑስ ኦዳ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="LUK 22:67">የሱሲ፥ “ታ ኦድያኮ አማነከታ። <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>ታ ኦይችያኮ ዛረከታ። <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>ሽን አሳ ናአይ ሀይሳፈ ገደ ባጋን ዎልቃማ ፆሳ ኡሻቻ ባጋን ኡታና” ያግስ።<verse eid="LUK 22:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70"/>ሄ ዎደ ኡባይ፥ “ያትን፥ ኔኒ ፆሳ ናኤ?” ያግዶሶና።</para>
  <para style="p" vid="LUK 22:70">እ፥ “ታ ፆሳ ናአ ግደይሳ ህንተ ግደታ” ያግስ።<verse eid="LUK 22:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71"/>ኤንቲ፥ “ህዛ፥ ሀራ ማርካ አይ ኮሺ? እ ባ እንፃርሳን ኦድሽን ኑ ስእዳ” ያግዶሶና።<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s1">የሱሲ ጵላፆሳ ስንን</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ 27:1-2</ref>፥ <ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="MRK 15:1-5">ማር 15:1-5</ref>፤ <ref loc="JHN 18:28-38">ዮሀ 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>ሄ በሳን ሺቅዳ ሻንጎት ኡባይ ደንድድ የሱሳ ጵላፆሳኮ ኤፍዶሶና። <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>“ሀ ኡራይ ኑ አሳ ባለሽን፥ ካዋስ ጊራ ጊሮና መላ ድግሽንነ፥ ቃስ ‘ታኒ ክርስቶሳ ህንተ ካዋ’ ያግሽን ደምዳ” ያግድ ሞትዶሶና።<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>ጵላፆስ የሱሳ፥ “ኔኒ አይሁደታ ካዎ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="LUK 23:3">የሱሲ፥ “ኤ፥ ነ ግዳይሳ መላ” ያግስ።<verse eid="LUK 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4"/>ጵላፆስ ካህነ ሀላቃታኮነ አሳኮ፥ “ሀ ኡራ ቦላ ታኒ እስ ባላካ ደማብከ” ያግስ። <verse eid="LUK 23:4"/><verse number="5" style="v" sid="LUK 23:5"/>ሽን ኤንቲ፥ “ሀ ኡራይ ጋልላፐ ዶምድ ሀይሳ ጋካናዉ ይሁዳ ኩመ ኢታባስ ደንስ” ያግድ ምን ኦድዶሶና።<verse eid="LUK 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>ጵላፆስ ሄሳ ስእዳ ዎደ የሱሲ ጋልላ አሴኮ ኤራናዉ ኮይድ እያ ኦይችስ። <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>የሱሲ ሄሮዲሳ ቢታፈ ይዳ አስ ግደይሳ ጵላፆስ ኤርዳ ዎደ ሄሮዲስ ሄ ዎደ የሩሳላመን ደእያ ግሾ እያኮ የድስ።<verse eid="LUK 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>ሄሮዲስ የሱሳ በአናዉ ዳሮ ዎደፐ ኮይሸ ደእያ ግሾ፥ እያ በእዳ ዎደ ዳሮ ኡፋይትስ። አይስ ጊኮ፥ እያባ ስእዳ ግሾ ማላልስያባ ኦን በአናዉ አሞትሸ ደኤስ። <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>ሄሮዲስ የሱሳ ዳሮ ኦይሾታ ኦይችስ፥ ሽን እ አይኮካ ዛርቤና። <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>ካህነታ ሀላቃትነ ህገ አስታማረት ያን ኤቅድ ምንድ እያ ሞቶሶና። <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>ሄሮዲሳራነ እያ ዎታዳረታራ የሱሳ ካዶሶናነ ለቅስዶሶና። ቦንቾ አፍላ ማይዝድ ጵላፆሳኮ ዛሪድ የድዶሶና። <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>ሄሮዲሳራነ ጵላፆሳራ ካሰ ሞርከሽን ሄ ጋላስ ዎላ ጊግዶሶና።<verse eid="LUK 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>ጵላፆስ ካህነ ሀላቃታ፥ አሳ ሃረይሳታነ አሳ ፄግድ፥ <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>“ ‘ሀ ኡራይ አሳ ጌላተስ ደንስ’ ግድ ታኮ ኤህደታ። ታካ ህንተ ስንን ፕልጋዳ ህንተ ሺሽዳ ሞቱዋስ አይብ ባላካ ደማብከ። <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>ሄሮዲስ፥ ሄሳ አይብ ባላካ እያ ቦላ ደምቦና ግሾ ኑኮ የድስ። ቱማካ ሀ ኡራይ ሀይቆስ ጋያ አይብ ባላካ ኦቤና። <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>ሄሳ ግሾ፥ እያ ጋራፋዳ ብላ የዳና” ያግስ። <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/>ሄሳ እ ግዳይ ፓስካ ባኣለ ዎደ እስ አስ ኤንታዉ ብላናይስ እያዉ አቶናባ ግድያ ግሾሳ።<verse eid="LUK 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18"/>ደረይ ኡባይ እስ ቦላ፥ “ሀ ኡራ ገደ ድጋ፥ ኑስ ባርባና ብላ” ያግድ ዋስዶሶና። <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>ባርባን ካታማ ግዶን አሳ ኢታባስ ደንድ አሰ ዎድ ቃሸትዳ አስ።<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>ጵላፆስ የሱሳ ብላናዉ ኮይድ አሳስ ዛር ኦድስ። <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>ግዶሽን፥ አሳይ፥ “ካቃ! ካቃ!” ያግድ ዋስዶሶና። <verse eid="LUK 23:21"/><verse number="22" style="v" sid="LUK 23:22"/>ጵላፆስ ሄን፥ “ሀ ኡራይ ቆህዳባይ አይቤ? ዎስ ጋያ ባላ ታ ደማብከ። ሄሳ ግሾ፥ ጋራፋዳ የዳ አጋና” ያግስ።<verse eid="LUK 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23"/>ኤንቲ ባንታ ቃላ ቁ ኦድ፥ “ካቀታናዉ በሴስ” ግድ ምን ዋስዶሶና። ኤንታ ዋሶይካ ፆንስ። <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>ኤንታ ኦይሻ ግሾ፥ ግድ ጵላፆስ እያ ቦላ ፕርድስ። <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>አሰ ኢታባስ ደንዳይሳነ አሰ ዎድ ቃሸትዳይሳ ብላና መላ ዎስዳ ግሾ ሄ ኡራ ኤንታዉ ብልስ። ሽን የሱሳ ኤንቲ ኮይዳባ ኦና መላ ኤንታዉ አድ እሚስ።<verse eid="LUK 23:25"/></para>
  <para style="s1">የሱሳ ካቀተ</para>
  <para style="r">(<ref loc="MAT 27:31-44">ማቶ 27:31-44</ref>፤ <ref loc="MRK 15:21-32">ማር 15:21-32</ref>፤ <ref loc="JHN 19:17-27">ዮሀ 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>የሱሳ ኦይክድ ኤፍሽን ስሞና ጌተትያ ቀሬና ቢታ አደይ ጋፃረፐ ይሽን፥ ደምድ ማስቃልያ ቶስድ የሱሳ ካልድ ባና መላ ኡንኤዶሶና። <verse eid="LUK 23:26"/><verse number="27" style="v" sid="LUK 23:27"/>ዳሮ አሳይነ ባንታ ትራ እጭሸ ዬክያ ማጫሳት እያ ጉየራ ካሎሶና።<verse eid="LUK 23:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 23:28"/>ሽን የሱሲ ኤንታኮ ጉየ ስሚድ፥ “ህንተኖ፥ የሩሳላመ ማጫሳቶ፥ ህንተ ሁጰስነ ህንተ ናይታስ ዬክተፐ አትሽን፥ ታዉ ዬኮፍተ። <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>‘ሄኮ ማይንት፥ የሎና ኡሎትነ ንና ንት አንጀትዶሶና’ ህንተ ያጋና ጋላሳይ ያና። <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/>ሄ ዎደ ደረታ፥ ‘ኑ ቦላ ኩንድተ’፥ ዙማታካ፥ ‘ኑና ካምተ’ ያጋና።<note caller="-" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">ሆሰ 10:8</ref>፤ <ref loc="REV 6:16">ቆን 6:16</ref>.</char></note> <verse eid="LUK 23:30"/><verse number="31" style="v" sid="LUK 23:31"/>ህዛ፥ ቃየ ም ሄሳ ኦኮ መላ ም ዋታንደሻ?” ያግስ።<verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>እያራ ዎናዉ ሀራ ናምኡ ዎራንታ ኤፍዶሶና። <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>ቀራንዮ<note caller="+" style="f"><char style="fr" closed="false">23:33 </char><char style="fq" closed="false">ቀራንዮ፦ </char><char style="ft" closed="false">ቀራንዮ ገይስ ግርከ ዶና። አራምከ ዶናን “ጎልጎታ” ዎይኮ “ሁጰ ጉገ” ጉሱ። ቀራንዮ ጌተትያ ሱንይ እመትዳይ የሱሲ ካቀትዳይ አሳ ሁጰ ጉገ ዳንያ በሳን ግድያ ግሾሳ። ሄ በሳይ ሮመ ካዎተይ ዎራንታ ካቅያ በሲ። (ማቶ 27:33፤ ማር 15:22፤ ዮሀ 19:17)</char></note> ጌተትያ በሳ ጋድ ካቅዶሶና። ዎራንታፐ እሱዋ ኡሻቻ ባጋራ ሀንኩዋ ሀድርሳ ባጋራ ካቅዶሶና። <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/>የሱሲ፥ “ታ አዋዉ፥ ኤንቲ አይ ኦያኮ ኤሮና ግሾ፥ ኔኒ ኤንታዉ አቶ ያጋ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">23:34 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ 22:18</ref>.</char></note></para>
  <para style="p" vid="LUK 23:34">ኤንቲ እያ አፍላ ቦላ ሳማ የግድ ሻከትድ ኤክዶሶና።<verse eid="LUK 23:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35"/>አሳይ ኤቅድ ፄሎሶና፥ ሽን ደርያ ሃረይሳት፥ “ሀራታ አሽስ፤ ፆሳይ ዶርዳ ክርስቶስ እያ ግድኮ አነ ባና አሾ” ያግድ ለቅስዶሶና።<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ 22:18</ref>፤ <ref loc="PSA 22:7">ማዝ 22:7</ref>.</char></note> <verse eid="LUK 23:35"/><verse number="36" style="v" sid="LUK 23:36"/>ዎታዳረት እያኮ ሺቅድ፥ ጫላ ዎይነ ኡሻ እምዶሶና።<note caller="-" style="x"><char style="xo" closed="false">23:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ 69:21</ref>.</char></note> <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>ያትድ፥ “ኔኒ አይሁደታ ካዎ ግድኮ ነ ሁጵያ አሻ” ያግድ ለቅስዶሶና።<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>እያዉ ሁጰ ባጋራ፥ “ሀይስ አይሁደታ ካዎ” ግያ ፁፈይ ደኤስ። <verse eid="LUK 23:38"/><verse number="39" style="v" sid="LUK 23:39"/>ካቀትዳ ዎራንታፐ እሶይ ጫሸ ሳአራ ጎችሸ፥ “አነ ኔኒ ክርስቶሳ ግድኮ፥ ነናካ ኑናካ አሻ” ያግስ።<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>ሽን ሀንኮ ዎራንይ፥ “ኔኒ ሀይሳ መላ ፕርዳን ደአሸ ሀር አቶሽን፥ ፆሳስ ያይኪ? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>ኑኒ ኑ ኦዳ ናጋራ ግሾ በሲያ ፕርዳ ኤኮስ፥ ሽን ሀ ኡራይ እስ ኢታባ ኦቤና” ያግድ ሀንቀትስ።<verse eid="LUK 23:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42"/>ቃስካ፥ “የሱሳ፥ ነ ነ ካዎተራ ያ ዎደ ታና ቆፓ” ያግስ።<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>የሱሲ፥ “ታ ነዉ ቱማ ኦዳይስ፤ ሀች ኔኒ ታራ ጋናተን ግዳና” ያግስ።<verse eid="LUK 23:43"/></para>
  <para style="p">
    <verse number="44-45" style="v" sid="LUK 23:44-45"/>ሄ ጋላስ ኡሱፑን ሳተፐ ብድ ኡዱፉን ሳተ ጋካናዉ አዋይ ፖኡዋ ድግዳ ግሾ፥ ቢታ ኡባ ቦላ ማ ግድስ። ፆሳ ኬ ማጋራጆይ ዳከትድ ናምአን ሻከትስ።<note caller="-" style="x"><char style="xo" closed="false">23:44-45 </char><char style="xt" closed="false"><ref loc="EXO 26:31">ከሳ 26:31</ref>.</char></note> <verse eid="LUK 23:44-45"/><verse number="46" style="v" sid="LUK 23:46"/>የሱሲ፥ ቃላ ቁ ኦድ፥ “ታ አዋዉ፥ ታ ታ ሸምፕዉ ነ ኩሸን ሼይስ” ያግድ ሀይቅስ።<note caller="-" style="x"><char style="xo" closed="false">23:46 </char><char style="xt" closed="false"><ref loc="PSA 31:5">ማዝ 31:5</ref>.</char></note><verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>ማቶ ሀላቃይ፥ ሀንዳይሳ በእድ፥ “ሀይስ ኡራይ ቱማካ ፅሎ” ያግድ ፆሳ ጋላትስ። <verse eid="LUK 23:47"/><verse number="48" style="v" sid="LUK 23:48"/>ሀ ሀንያባ በአናዉ ሄ በሳ ሺቅዳ አሳ ኡባይ ሀንዳባ በእዳ ዎደ ባንታ ትራ እጭሸ ባንታ ሶ ስምዶሶና። <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>ግዶሽን፥ የሱሳ ማታን ኤርያ አሳ ኡባይ፥ ሄሳዳካ ጋልላፐ ካልድ ይዳ ማጫሳት ሄሳ በእሸ ሃሆን ኤቅዶሶና።<note caller="-" style="x"><char style="xo" closed="false">23:49 </char><char style="xt" closed="false"><ref loc="LUK 8:2">ሉቃ 8:2</ref>.</char></note><verse eid="LUK 23:49"/></para>
  <para style="p">
    <verse number="50-51" style="v" sid="LUK 23:50-51"/>አይሁደ ሻንጎታፐ እሶይ፥ ዮሰፋ ጌተትያ ኡራይ ደኤስ። እ አርማተ ጌተትያ ይሁዳ ካታማፐ ይስ። እ ሎኦነ ፅሎ አስ ግድያ ግሾ ፆሳ ካዎተ ዩሳ ናጌስ። ሻንጎታፐ እሱዋ ግድሸ ኤንታ ዞረተንነ ኦሱዋን ዴና። <verse eid="LUK 23:50-51"/><verse number="52" style="v" sid="LUK 23:52"/>ሄ ኡራይ ጵላፆሳኮ ብድ፥ የሱሳ አሀ ሞጋናዉ ታዉ እማ ግድ ዎስስ። <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>ጵላፆስ ኤካ ያግን፥ የሱሳ አሀ ዎስድ አፍላራ ፃፅስ። ዛላፈ ዎጭድ ከስዳ ሀራ አስ ሞገቶና ኦራ ዱፎን ዎስ። <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>ሳምባት ገላና ሀንያ ግሾ፥ ሄ ጋላሳይ ጊገተ ቃማ።<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>ጋልላፐ ደንድድ የሱሳ ካልድ ይዳ ማጫሳት ዮሰፋራ ብድ እያ አሀ ዋት ሞግያኮ ዱፉዋ አኬክድ በእዶሶና። <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>ያፐ ስሚድ ሽቶነ ቅባተ ጊግስዶሶና። ህገይ ኪተይሳ መላ ሳምባታ ጋላስ ሸምፕ ፔእዶሶና።<note caller="-" style="x"><char style="xo" closed="false">23:56 </char><char style="xt" closed="false"><ref loc="EXO 20:10">ከሳ 20:10</ref>፤ <ref loc="DEU 5:14">ዛረ 5:14</ref>.</char></note><verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s1">የሱሳ ሀይቆፐ ደንዱዋ</para>
  <para style="r">(<ref loc="MAT 28:1-10">ማቶ 28:1-10</ref>፤ <ref loc="MRK 16:1-8">ማር 16:1-8</ref>፤ <ref loc="JHN 20:1-10">ዮሀ 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>ሳምንታፈ ኮይሮ ጋላስ፥ ዎጋ ዎደ ዎንታ ዳሮ ጉራ፥ ማጫሳት ባንታ ጊግስዳ ሽቱዋ ኤክድ ዱፉዋ ብዶሶና። <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>ኤንቲ ያ ጋክያ ዎደ ዱፉዋ ዶናን ደእያ ሹቻይ ጎንደረትድ ክቾይሳ ደምዶሶና። <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>ኤንቲ ዱፉዋ ጋ ገልዶሶና፥ ሽን ጎዳ የሱሳ አሀ ደምቦኮና። <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>ኤንቲ ያን ኤቅድ አይብ ሀንደ ግድ ቆፕሽን አኬኮና ዳሮ ጶልያ አፍላ ማእዳ ናምኡ አሳት ኤንታ ማታን ኤቅዶሶና። <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>ማጫሳት ያሸትድ ባንታ ሁጵያ ሳአን ዝቅ ኦድ ደእሽን፥ አሳት ኤንታኮ፥ “ደኦን ደኤይሳ ሀይቆታ ግዶን አይስ ኮዬቲ? <verse eid="LUK 24:5"/><verse number="6-7" style="v" sid="LUK 24:6-7"/>እ ሀይሳን ዴና፤ ሀይቆፐ ደንድስ፥ ‘አሳ ናአይ ናጋራንቾታ ኩሸን አድ እመታና፤ ኤንትካ እያ ካቃና።<note caller="-" style="x"><char style="xo" closed="false">24:6-7 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቶ 16:21</ref>፤ <ref loc="MAT 17:22-23">17:22-23</ref>፤ <ref loc="MAT 20:18-19">20:18-19</ref>፤ <ref loc="MRK 8:31">ማር 8:31</ref>፤ <ref loc="MRK 9:31">9:31</ref>፤ <ref loc="MRK 10:33-34">10:33-34</ref>፤ <ref loc="LUK 9:22">ሉቃ 9:22</ref>፤ <ref loc="LUK 18:31-33">18:31-33</ref>.</char></note> እ ሄን ቃማን ሀይቆፐ ደንዳና’ ያግድ፥ እ ህንተራ ጋልላን ደእሸ ህንተዉ ኦድዳ ቃላ ቆፕተ” ያግስ።<verse eid="LUK 24:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8"/>ማጫሳት ሄ ዎደ እያ ቃላ ቆፕዶሶና።<verse eid="LUK 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9"/>ማጫሳት ዱፉዋፐ ስሚድ ሀንዳባ ኡባ ታማነ እሶታስነ ሀራታስካ ኦድዶሶና። <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>ሄሳ ሀዋረታስ ኦድዳይ ማግደላ ማይራሞ፥ ዮሃና፥ ያይቆባ አይዉ ማይራሞነ ኤንታራ ደእያ ሀራ ማጫሳታ። <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>ሽን ኤንታዉ ማጫሳት ኦድዳይስ ኤልሞ ዳንን አማንቦኮና። <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>ሽን ጰፅሮስ ደንድ ዎፅድ ዱፎ ብስ። ሄ በሳ ጋክድ፥ ሆክድ ጋ ፄልያ ዎደ ሞጎ አፍላ ፃላላ በእስ። ሀንዳባን ማላለትሸ ባ ሶ ስምስ።<verse eid="LUK 24:12"/></para>
  <para style="s1">ኤማሆሰ ኦገ ቦላ</para>
  <para style="r">(<ref loc="MRK 16:12-13">ማር 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>ሄ ጋላስ ካልያ ታማረታፐ ናምአት የሩሳላመፐ ታማነ እስ ክሎ ምትረ ሃክያ ኤማሆሰ ጉታ ቦሶና። <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>ኤንቲ ዎላ ሀንዳባ ኡባ ኦደቶሶና። <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>ኤንቲ ሄ ሀኖታባ ቆፕሸነ ኦደትሸ ብያ ዎደ የሱሲ ባ ሁጰን ሺቅድ ኤንታራ ቤስ። <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>ሀኖሽን፥ ኤንቲ እያ ኤሮና መላ ኤንታ አይፈይ ኦይከትስ።<verse eid="LUK 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17"/>እ፥ “ህንተ ዎላ ኦገ ቦላ ደእሸ ኦደተይስ አይቤ?” ያግስ።</para>
  <para style="p" vid="LUK 24:17">ኤንቲ አዛንድ ስእ ግድ ኤቅዶሶና። <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>ኤንታፈ እሶይ ቀልዮጰ ጌተተይስ፥ “ሀ ቃማታ ግዶን የሩሳላመን ሀንዳባ ኤሮናይስ፥ ነ ቢታስ እማዬ?” ያግስ።<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>እ ዛሪድ፥ “እ ሀንዳይስ አይቤ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="LUK 24:19">ኤንቲ፥ “ፆሳ ስንንነ አሳ ስንን ኦሶንነ ኦዳን ምኖ ናበ ግድዳ ናዝረተ የሱሳባ። <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>እያ ካህነ ሀላቃትነ ሃረይሳት ሀይቆ ፕርዳስ አ እምድ፥ ካቅዶሶና። <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>ኑኒ እስራኤለ አሳ ዎዛንደ ግድ ኡፋይትድ ናግዳሽን ሀይስ ሀንን ሀች ሄን ቃማ። <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>ቃስ ኑ ግዶፈ እስ እስ ማጫሳት ኑና ማላልስዶሶና። ኤንቲ ሀች ዎንታ ጉራ ዱፉዋ ብዶሶና። <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>እያ አሀ ይዳ ዎደ ስም ይድ፥ ‘እ ፓፃ ደኤስ’ ግያ ኪታንቾት ቆንጭን በእዳ ያግድ ኦድዶሶና። <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>ኑ ግዶፈካ እሶት እሶት ዱፉዋ ብድ ማጫሳት ኦድዳይሳ ሀንን በእዶሶና፥ ሽን እያ በእቦኮና” ያግስ።<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>እ ኤንታኮ፥ “ህንተኖ፥ አኬኮና አሳቶ፥ ህንተ ዎዛናይ ናበት ኦድዳባ ኡባ አማናናዉ ጋምኤይሳቶ፥ <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>ክርስቶስ ሀ መቱዋ ኤካናዉነ ባ ቦንቹዋን ገላናዉ በሰኔ?” ያግስ። <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>ሙሰፐነ ናበታ ኡባፈ ደንድድ ጌሻ ማፃፋን እያባይ ፃፈትዳይሳ ኡባ ኤንታዉ ቆንጭስስ።<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>ኤንቲ ብያ ጉታኮ ማታትዳ ዎደ የሱሲ አድ ሃሆ ሶ ብያ ዳንን፥ <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>ኤንቲ፥ “ሳአይ ቃምዳ ግሾ ኑራ አቃ” ያግድ ምንድ ዎስዶሶና። ሄሳ ግሾ፥ ኤንታራ አቃናዉ ገልስ።<verse eid="LUK 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30"/>ኤንታራ እስፈ ጋይታ ቦላ ኡትድ፥ ኡይ ደንድ፥ መንድ፥ አንጅድ ኤንታዉ እሚስ። <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>ሄ ዎደ ኤንቲ ኤራና መላ ኤንታ አይፈይ ዶየትስ። ኤንትካ ኤርዶሶና። ሽን እ ኤንታፈ ጌምስ። <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>ኤንቲ፥ “ኑ ኦግያ ቦላ ደእሽን እ ኑስ ጌሻ ማፃፋ ብርሽሽንነ ኑና ኦድስሽን፥ ኑ ዎዛናይ ፁገትቤኔ?” ያግዶሶና። <verse eid="LUK 24:32"/><verse number="33" style="v" sid="LUK 24:33"/>ሄ ዎደ ደንድድ ጉየ የሩሳላመ ይዶሶና። ታማነ እሶትነ ሀራት እስ ቦላ ሺቅድ ደእሽን ደምዶሶና። <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>ኤንቲ፥ “ጎዳይ ቱማ ደንድስ፤ ስሞናስ ቆንጭስ” ያግዶሶና።<verse eid="LUK 24:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35"/>ሄ ናምኡ ታማረት ኤማሁሰ ኦግያ ቦላ ደእሽን ሀንዳይሳነ ኡይ መንዳ ዎደ ዋት እያ ኤርዳኮ ኤንታዉ ኦድዶሶና።<verse eid="LUK 24:35"/></para>
  <para style="s1">የሱሲ ባ ታማረታስ ቆንጭስ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ 28:16-20</ref>፤ <ref loc="MRK 16:14-18">ማር 16:14-18</ref>፤ <ref loc="JHN 20:19-23">ዮሀ 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ሀዋ 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>ናምኡ ታማረት ሄሳ ኦዳ ቦላ ደእሽን፥ የሱሲ ኤንታ ግዶን ኤቅድ፥ “ሳሮይ ህንተዉ ግዶ” ያግስ።<verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>ግዶሽን፥ ኤንቲ ዳጋምድ፥ ሞይትለ በእዳ ዳንን ያይዶሶና።<verse eid="LUK 24:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 24:38"/>እ ኤንታኮ፥ “አይስ ባብደቲ? አይስ ስይ ህንተ ዎዛናን ገልዴ? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>ታ ኩሽያነ ታ ቶሁዋ በእተ፤ ታኒ ታና። ቃስ ኦይክድ በእተ፤ ታናን ህንተ በኤይሳዳ፥ ሞይትለስ አሾይነ መቀ ባዋ” ያግስ። <verse eid="LUK 24:39"/><verse number="40" style="v" sid="LUK 24:40"/>ያግድ፥ ባ ቶሁዋነ ባ ኩሽያ ኤንታ በስስ። <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>ኤንቲ ኡፋይሳፈ ደንዶይሳን አማኖና ማላለተን ደእሽን፥ የሱሲ ኤንታኮ፥ “ሀይሳን ህንተዉ ምያባይ ደኢ?” ያግስ። <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>ኤንቲ እስ ጫጨትዳ ሞሎ እያዉ እምዶሶና። <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>እ ኤክድ ኤንታ ስንን ምስ።<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>እ፥ “ታ ህንተራ ጋምእዳ ዎደ ኡባን ሙሰ ማፃፋታን፥ ናበታ ማፃፋታንነ ማዝሙረ ማፃፋታን፥ ታ ግሾ ፃፈትዳባይ ኡባይ ፖለታናዉ በሴስ ያጋዳ ታ ህንተዉ ኦድዳ ቃላይ ሀይሳ” ያግስ።<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>ሄ ዎደ ጌሻ ማፃፋታ አኬካና መላ ኤንታ ዎዛና ዶይስ። <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>ሄሳዳካ፥ “ክርስቶስ ዋየ ኤካና፥ ሄን ቃማን ሀይቆፐ ደንዳና ያግድ ፃፈትስ። <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>የሩሳላመፐ ደንድድ አሳ ኡባስ ናጋራፐ ማሮተይነ አቶተይ እያ ሱንን ማርካታና። <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/>ህንተ ሄሳስ ማርካታ። <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/>ሄኮ፥ ታካ ታ አዋይ እምዳ ኡፋይሳ ህንተዉ የዳና። ህንተ ሳሎፐ ዎልቃ ማአና ጋካናዉ የሩሳላመ ካታማን ጋምእተ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">24:49 </char><char style="xt" closed="false"><ref loc="ACT 1:4">ሀዋ 1:4</ref>.</char></note><verse eid="LUK 24:49"/></para>
  <para style="s1">የሱሲ ፑደ ሳሎ ብስ</para>
  <para style="r">(<ref loc="MRK 16:19-20">ማር 16:19-20</ref>፤ <ref loc="ACT 1:9-11">ሀዋ 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>ሄሳፈ ጉየ፥ ብታነ ካታማ ኤንታና ኤክድ ብስ። ባ ኩሽያ ደንድ አንጅስ።<note caller="-" style="x"><char style="xo" closed="false">24:50 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">ሀዋ 1:9-11</ref>.</char></note> <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>ኤንታና አንጅሸ ኤንታፈ ሻከትድ ፑደ ሳሎ ኤከትስ። <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>ኤንቲ ዝግ ጎይንድ ዳሮ ኡፋይሳን የሩሳላመ ስምዶሶና። <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>ፆሳ ኡባ ዎደ ጋላትሸ ፆሳ ኬን ጋምእዶሶና።<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
