<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">1 ታርከ ማፃፋ</para>
  <para style="toc1">1 ታርከ ማፃፋ</para>
  <para style="toc3">1 ታር</para>
  <para style="toc2">1 ታርከ</para>
  <para style="mt">1 ታርከ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ታርከ ማፃፋት፥ ሳሜላ ማፃፋነ ካዎታ ማፃፋን ደእያ ታርከታራ ጉራ ጋሄትኮካ፥ እስራኤለ ድኤተፈ ስን ደእያ ሀኖታታ ዱማ ኦገራ ቆንጭሶሶና። ታርከ ማፃፋታን እስራኤለ ካዎታ አይሶ ታርከይ ናምኡ አይፈ ቆፋታ ብርሽድ ኦዴስ።</para>
  <para style="ipi">1. ሸምፖ 1-9 ጋካናዉ ደእያ ክፍልያን፥ አዳመፐ አብራሃመ ጋካናዉ፥ አብራሃመፐ ዳዊታ ጋካናዉ፥ ዳዊታፐ ባብሎነ ድኡዋ ጋካናዉ ደእያ እስራኤለ ዎዘተ ታርከ ኦዴስ። አሳ ናአ ታርከይ ዶመትዳ ዎደፐ ዶምድ ድኦፐ ጉየ ደእያ ዎደ ጋካናዉ ፆሳይ ባ አሳ ዋትድ ዶርዳኮነ ናግዳኮ ሀ ክፍለይ ኦዴስ። እስራኤለነ ይሁዳ ካዎተት ናጋራ ኦኮካ፥ ፆሳይ ባ አሳስ ገልዳ ኡፋይሳ ቃላ ይሁዳ ኮቻ ባጋራ ፖልዳይሳ ሀ ክፍለይ በሴስ።</para>
  <para style="ip">2. ሸምፖ 10-29 ጋካናዉ ደእያ ክፍለይ፥ ዳዊታ ካዎተ ታርክያ ኦይክስ። ሀ ክፍልያን ዳዊተራ ደእያ ምኖ አሳትነ (ሸም 11-12)፥ ዳዊቲ ፆንዳ ዎልቃማ ፆኖት (14:18-20) ስን በሲ ደምዶሶና። ዳዊታ ዎደ ደእያ ሌወት፥ ካህነትነ ዛማረት ግታ ሱን ኤክዶሶና (ሸም 23-26)። ፆሳ ኬ ኬፅዳይ ሶሎሞነ ግድኮካ፥ ፆሳ ኬን ጎይኖ ዎጋ ኮይሮ ኤስዳይ ዳዊታ ግደይሳ ሀ ክፍለይ ኤርሴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">አዳመ ኮቻይ ካዋ ሳኦላ ጋካናዉ (<char style="ior"><ref loc="1CH 1:1-10:14">1:1—10:14</ref></char>)</para>
  <para style="io1">ዳዊታ ካዎቱዋነ የሩሳላመ ኦይከተ (<char style="ior"><ref loc="1CH 11:1-12:40">11:1—12:40</ref></char>)</para>
  <para style="io1">ጫቆ ታቦተይ የሩሳላመ ዩሳ (<char style="ior"><ref loc="1CH 13:1-17:27">13:1—17:27</ref></char>)</para>
  <para style="io1">ዳዊታ ፆኖታነ አሳ ታይቡዋ (<char style="ior"><ref loc="1CH 18:1-21:30">18:1—21:30</ref></char>)</para>
  <para style="io1">ዳዊቲ ፆሳ ኬ ኬፃናዉ ጊገተ (<char style="ior"><ref loc="1CH 22:1-29:20">22:1—29:20</ref></char>)</para>
  <para style="io1">ሶሎሞነ ካዎቱዋነ ዳዊታ ሀይቁዋ (<char style="ior"><ref loc="1CH 29:21-30">29:21-30</ref></char>)</para>
  <chapter number="1" style="c" sid="1CH 1"/>
  <para style="s1">አዳመፐ አብራሃመ ጋካናዉ</para>
  <para style="r">(<ref loc="GEN 5:1-32">መ 5:1-32</ref>፤ <ref loc="GEN 10:1-32">10:1-32</ref>፤ <ref loc="GEN 11:10-26">11:10-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1"/>አዳመይ ሴታ የልስ፤ ሴት ሄኖሳ የልስ፤ ሄኖስ ቃይናና የልስ፤ <verse eid="1CH 1:1"/><verse number="2" style="v" sid="1CH 1:2"/>ቃይናን ማላልኤላ የልስ፤ ማላልኤል ያረዳ የልስ፤ <verse eid="1CH 1:2"/><verse number="3" style="v" sid="1CH 1:3"/>ያረድ ሄኖከ የልስ፤ ሄኖከይ ማቱሳላ የልስ፤ ማቱሳል ላመሀ የልስ፤ <verse eid="1CH 1:3"/><verse number="4" style="v" sid="1CH 1:4"/>ላመህ ኖሄ የልስ፤ ኖሄይ ሴማ፥ ካማነ ያፈታ የልስ።<verse eid="1CH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 1:5"/>ያፈታ አደ ናይት ጋመራ፥ ማጎገ፥ ማዳያ፥ ያዋና፥ ቶቤላ፥ ሞሳሀነ ትራሳ። <verse eid="1CH 1:5"/><verse number="6" style="v" sid="1CH 1:6"/>ጋመራ አደ ናይት አስካናዛ፥ እርፋታነ ተጋርማ። <verse eid="1CH 1:6"/><verse number="7" style="v" sid="1CH 1:7"/>ያዋና አደ ናይት ኤልሳ፥ ታርሰሳ፥ ክፅማነ ሮዳ።<verse eid="1CH 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 1:8"/>ካማ አደ ናይት ኩሻ፥ ምፅራይማ፥ ፉፃነ ካናነ። <verse eid="1CH 1:8"/><verse number="9" style="v" sid="1CH 1:9"/>ኩሻ አደ ናይት ሳባ፥ ኤዉላፀ፥ ሳብታ፥ ራእማነ ሳብቃታ። ራእማ አደ ናይት ሳባነ ድዳና። <verse eid="1CH 1:9"/><verse number="10" style="v" sid="1CH 1:10"/>ኩሽ ናምሩደ የልስ። ናምሩደይ ቢታ ቦላ ዎልቃማ ኦላንቾ ግድስ። <verse eid="1CH 1:10"/><verse number="11" style="v" sid="1CH 1:11"/>ምፅራይም ሉደታ፥ አናምመታ፥ ላሀበታ፥ ናፍቱሄታ፥ <verse eid="1CH 1:11"/><verse number="12" style="v" sid="1CH 1:12"/>ፓትሮሳታ፥ ፍልስፄመታ፥ ማይዛ ግድዳ ካስሉሄማታነ ቃፍቶረታ ኮቻታ ማይዛ። <verse eid="1CH 1:12"/><verse number="13" style="v" sid="1CH 1:13"/>ካናነይ ባይራ ናኣ ስዶናነ እያ ካሉዋ ሄታ የልስ። <verse eid="1CH 1:13"/><verse number="14" style="v" sid="1CH 1:14"/>ካናነይ ያቡሰታ፥ አሞረታ፥ ገርገሰታ፥ <verse eid="1CH 1:14"/><verse number="15" style="v" sid="1CH 1:15"/>ህወታ፥ አርከታ፥ ሲናታ፥ <verse eid="1CH 1:15"/><verse number="16" style="v" sid="1CH 1:16"/>አርዳወታ፥ ሳማረታነ ሀማተታ የልስ።<verse eid="1CH 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17"/>ሴማ አደ ናይት ኤላማ፥ አሶረ፥ አርፋክሳደ፥ ሉደ፥ አራማ፥ ኡፅ፥ ሁላ፥ ገተራነ ሞሳሀ። <verse eid="1CH 1:17"/><verse number="18" style="v" sid="1CH 1:18"/>አርፋክሳድ ሳላ የልስ፤ ሳል ኤቦራ የልስ። <verse eid="1CH 1:18"/><verse number="19" style="v" sid="1CH 1:19"/>ኤቦሪ ናምኡ ናይታ የልስ፤ እሶይ የለትዳ ዎደ ሳእ ሻከትዳ ግሾ እያ ሱንይ ፋለቃ ጌተትስ፤ እያ እሻ ሱንይ ዮቅፃና። <verse eid="1CH 1:19"/><verse number="20" style="v" sid="1CH 1:20"/>ዮቅፃን አልሞዳዳ፥ ሳለፋ፥ ሀዛርሞታ፥ ያራሀ፥ <verse eid="1CH 1:20"/><verse number="21" style="v" sid="1CH 1:21"/>ሀዶራማ፥ ኡዛላ፥ ድቅላ፥ <verse eid="1CH 1:21"/><verse number="22" style="v" sid="1CH 1:22"/>ኦባላ፥ አብማላ፥ ሳባ፥ <verse eid="1CH 1:22"/><verse number="23" style="v" sid="1CH 1:23"/>ኦፍራ፥ አዉላፃነ ዮባባ የልስ። ሀይሳቲ ዮቅፃና ኮቻታ።<verse eid="1CH 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 1:24"/>ሴማፐ አብራሃመ ጋካናዉ ደእያ የለታይ ሀይሳፈ ካልድ ፃፈትዳይሳታ፤ ሴማ፥ አርፋክሳደ፥ ሳላ፥ <verse eid="1CH 1:24"/><verse number="25" style="v" sid="1CH 1:25"/>ኤቦራ፥ ፋለቃ፥ ራጋ፥ <verse eid="1CH 1:25"/><verse number="26" style="v" sid="1CH 1:26"/>ሳሩጋ፥ ናኮራ፥ ታራነ <verse eid="1CH 1:26"/><verse number="27" style="v" sid="1CH 1:27"/>አብራሃመ ጌተትያ አብራመ።<verse eid="1CH 1:27"/></para>
  <para style="s1">እስማኤላ ሼሽ</para>
  <para style="r">(<ref loc="GEN 25:12-16">መ 25:12-16</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 1:28"/>አብራሃመ አደ ናይት ይሳቃነ እስማኤላ። <verse eid="1CH 1:28"/><verse number="29" style="v" sid="1CH 1:29"/>ኤንታ የለታይ ሀይሳፈ ካልድ ፃፈትስ።</para>
  <para style="p" vid="1CH 1:29">እስማኤላ ባይራ ናአይ ናባዮታ፤ ሄሳፈ ካልድ፥ ቀዳረ፥ አድቤላ፥ ምብሳማ፥ <verse eid="1CH 1:29"/><verse number="30" style="v" sid="1CH 1:30"/>ምስማ፥ ዱማ፥ ማሳ፥ ኩዳነ፥ ቴማ፥ <verse eid="1CH 1:30"/><verse number="31" style="v" sid="1CH 1:31"/>እፁራ፥ ናፍሳነ ቀድማ የልስ። ሀይሳቲ እስማኤላ ናይታ።<verse eid="1CH 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32"/>አብራሃመይ ኬፁራፐ የልዳ አደ ናይት ዝምራና፥ ዮቅሳና፥ ማዳነ፥ ምድያመ፥ ያስቦቃነ ስዋ። ዮቅሳና አደ ናይት ሳባነ ድዳና። <verse eid="1CH 1:32"/><verse number="33" style="v" sid="1CH 1:33"/>ምድያመ አደ ናይት ገፈራ፥ ኤፈራ፥ ሄኖሀ፥ አብዳነ ኤልዳ። ሀይሳቲ ኬፁራ ኮቻታ።<verse eid="1CH 1:33"/></para>
  <para style="s1">ኤሳዌ ሼሽ</para>
  <para style="r">(<ref loc="GEN 36:1-19">መ 36:1-19</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34"/>አብራሃመይ ይሳቃ የልስ። ይሳቃ አደ ናይት ኤሳዌነ እስራኤለ። <verse eid="1CH 1:34"/><verse number="35" style="v" sid="1CH 1:35"/>ኤሳዌ አደ ናይት ኤልፋዛ፥ ራጉኤላ፥ የኡሳ፥ ያእላማነ ቆረ። <verse eid="1CH 1:35"/><verse number="36" style="v" sid="1CH 1:36"/>ኤልፋዛ አደ ናይት ተማና፥ ኦማራ፥ ስፎ፥ ጎቶማ፥ ቀነዛ፥ ትምናነ አማለቃ። <verse eid="1CH 1:36"/><verse number="37" style="v" sid="1CH 1:37"/>ራጉኤላ አደ ናይት ናሆታ፥ ዛራ፥ ሳማነ ምዛ።<verse eid="1CH 1:37"/></para>
  <para style="s1">ኤዶመን ደእዳ ሳይረ አሳታ</para>
  <para style="r">(<ref loc="GEN 36:20-30">መ 36:20-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38"/>ኤዶመን ኮይሮ ደእዳ ሳይረ አደ ናይት ሎፃነ፥ ሶባላ፥ ዝባኦና፥ አና፥ ድሶና፥ ኤፀራነ ድሳና። <verse eid="1CH 1:38"/><verse number="39" style="v" sid="1CH 1:39"/>ሎፃነ አደ ናይት ሆራነ ሄማማ፤ ሎፃነ ምችያ ትምናኦ። <verse eid="1CH 1:39"/><verse number="40" style="v" sid="1CH 1:40"/>ሶባላ አደ ናይት አልዋ፥ ማናሆታ፥ ኤባላ፥ ስፋነ ኦናማ። ፅባኦና አደ ናይት አያነ አና። <verse eid="1CH 1:40"/><verse number="41" style="v" sid="1CH 1:41"/>አና ናአይ ድሶና። ድሶና አደ ናይት ሄምዳና፥ ኤስባና፥ ይትራናነ ካራና። <verse eid="1CH 1:41"/><verse number="42" style="v" sid="1CH 1:42"/>ኤፀራ አደ ናይት ብልሃና፥ ዛዋናነ አቃና። ድሳና አደ ናይት ኡፃነ አራና።<verse eid="1CH 1:42"/></para>
  <para style="s1">ኤዶመ ካዎታ</para>
  <para style="r">(<ref loc="GEN 36:31-43">መ 36:31-43</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43"/>እስራኤለን ካዎይ ካዎታናፐ ካሰ ኤዶመ ቢታን ካዎትዳ ካዎት ሀይሳፈ ካልድ ፃፈትዳይሳታ።</para>
  <para style="p" vid="1CH 1:43">ብኦራ ናአይ ባላቅ ካዎትስ፤ እያ ካታማ ሱንይ ድናባ።<verse eid="1CH 1:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 1:44"/>ባላቅ ሀይቅን፥ ባሶራ አደይ ዛራ ናአይ ዮባብ እያ በሳን ካዎትስ።<verse eid="1CH 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1CH 1:45"/>ዮባብ ሀይቅን፥ ተማና አደይ ሁሳም እያ በሳን ካዎትስ።<verse eid="1CH 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="1CH 1:46"/>ሁሳም ሀይቅን፥ ሞአበ ቢታን ምድያመታ ፆንዳ ባዳዳ ናአይ ሀዳድ እያ በሳን ካዎትስ፤ እያ ካታማ ሱንይ አዊታ።<verse eid="1CH 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="1CH 1:47"/>ሀዳድ ሀይቅን፥ ማስሬቃ አደይ ሳምል እያ በሳን ካዎትስ።<verse eid="1CH 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 1:48"/>ሳምል ሀይቅን፥ ሻፋ ማታን ደእያ ረሆቦታ አደይ ሳኡሊ እያ በሳን ካዎትስ።<verse eid="1CH 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 1:49"/>ሳኡሊ ሀይቅን፥ አክቦራ ናአይ ባአል-ሀናን እያ በሳን ካዎትስ።<verse eid="1CH 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 1:50"/>ባአል-ሀናን ሀይቅን፥ ሀዳድ እያ በሳን ካዎትስ፤ እያ ካታማ ሱንይ ፓኡ። እያ ማችያ መዛሃባ ናኤ ማፅሬድ ናእዉ ማሄፃቤሎ። ሄሳፈ ጉየ፥ ሀዳድ ሀይቅስ።<verse eid="1CH 1:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="1CH 1:51"/>ኤዶመ ኮቻታ ሀላቃት ሀይሳታ፤ ትምናአ፥ አልዋ፥ የተታ፥ <verse eid="1CH 1:51"/><verse number="52" style="v" sid="1CH 1:52"/>ኦሆልባማ፥ ኤላ፥ ፕኖና፥ <verse eid="1CH 1:52"/><verse number="53" style="v" sid="1CH 1:53"/>ቃናዛ፥ ተማና፥ ምብሳራ፥ <verse eid="1CH 1:53"/><verse number="54" style="v" sid="1CH 1:54"/>ማግደላነ እራማ። ሀይሳቲ ኤዶመ ሀላቃታ።<verse eid="1CH 1:54"/></para>
  <chapter eid="1CH 1"/>
  <chapter number="2" style="c" sid="1CH 2"/>
  <para style="s1">ይሁዳ ሼሽ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1"/>እስራኤለ አደ ናይት ሀይሳታ፤ ሮቤላ፥ ስሞና፥ ሌወ፥ ይሁዳ፥ ይሳኮራ፥ ዛብሎና፥ <verse eid="1CH 2:1"/><verse number="2" style="v" sid="1CH 2:2"/>ዳነ፥ ዮሰፋ፥ ብንያመ፥ ንፍታለመ፥ ጋደነ አሴራ።<verse eid="1CH 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3"/>ካናነ ማጫሰ ሰዋፐ ይሁድ የልዳ ሄ አደ ናይት ኤራ፥ ኦናናነ ሴላ። ይሁዳ ባይራ ናአይ ኤር ጎዳ ስንን ኢታባ ኦዳ ግሾ ጎዳይ እያ ዎስ። <verse eid="1CH 2:3"/><verse number="4" style="v" sid="1CH 2:4"/>ይሁድ ባ ናኣ ማቸ ትማርፐ ፋረሳነ ዛራ የልስ። ይሁዳስ እቻሹ አደ ናይት ደኦሶና።<verse eid="1CH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 2:5"/>ፋረሳ አደ ናይት ሄስሮማነ ሀሙላ።<verse eid="1CH 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 2:6"/>ዛራ አደ ናይት ዝምራ፥ ኤታና፥ ሄማና፥ ካልኮላነ ዳራ፤ ኤንቲ ኩመ እቻሻ። <verse eid="1CH 2:6"/><verse number="7" style="v" sid="1CH 2:7"/>ዛራ ኮቸ ግድዳ ካርማ ናአይ አካን ፆሳስ ዱማትዳ ድኡዋፐ ካይሶትድ እስራኤለ አሳ ኡንኤዳይሳ። <verse eid="1CH 2:7"/><verse number="8" style="v" sid="1CH 2:8"/>ኤታና ናአይ አዛራ።<verse eid="1CH 2:8"/></para>
  <para style="s1">ኤስሮመፐ ዳዊታ ጋካናዉ</para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 2:9"/>ሄስሮን የልዳ ናይት ይራምኤላ፥ አራመነ ካለባ። <verse eid="1CH 2:9"/><verse number="10" style="v" sid="1CH 2:10"/>አራም አምናዳበ የልስ። አምናዳበይ ይሁዳ ኮቻታ ሀላቃ ናአሶና የልስ። <verse eid="1CH 2:10"/><verse number="11" style="v" sid="1CH 2:11"/>ናአሶን ሳልሞና የልስ፤ ሳልሞን ቦኤዛ የልስ፤ <verse eid="1CH 2:11"/><verse number="12" style="v" sid="1CH 2:12"/>ቦኤዝ እዮበዳ የልስ፤ እዮበድ እሰየ የልስ። <verse eid="1CH 2:12"/><verse number="13" style="v" sid="1CH 2:13"/>እሰየይ ባ ባይራ ናኣ ኤልያባ፥ ካሎ ናኣ አምናዳበ፥ ሄን ናኣ ሳማ፥ <verse eid="1CH 2:13"/><verse number="14" style="v" sid="1CH 2:14"/>ኦይዳን ናኣ ናትናኤላ፥ እቻሻን ናኣ ራዳያ፥ <verse eid="1CH 2:14"/><verse number="15" style="v" sid="1CH 2:15"/>ኡሱፑን ናኣ አሳማ፥ ላፑን ናኣ ዳዊታ የልስ። <verse eid="1CH 2:15"/><verse number="16" style="v" sid="1CH 2:16"/>እሰየ ማጫ ናይት ፃሩዮነ አብግያ። ፃሩይ ናይት ሄት አብሳያ፥ እዮኣባነ አሳሄላ። <verse eid="1CH 2:16"/><verse number="17" style="v" sid="1CH 2:17"/>አብግያ አማሳ የላሱ፤ አማሳ አዋይ እስማኤላ አድያ የተራ።<verse eid="1CH 2:17"/></para>
  <para style="s1">ኤስሮመ ሼሽ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18"/>ሄስሮና ናኣ ካለባስ አዙቦነ ይርኦቶ ጌተትያ ናምኡ ማቸት ደኦሶና። እ አዙብፐ የሳራ፥ ሶባባነ አርዶና የልስ። <verse eid="1CH 2:18"/><verse number="19" style="v" sid="1CH 2:19"/>አዙብ ሀይቅን፥ ካለብ ኤፍራቶ ኤክስ፤ ኤፍራታ ሁራ የላሱ። <verse eid="1CH 2:19"/><verse number="20" style="v" sid="1CH 2:20"/>ሁር ኡረ የልስ፤ ኡረይ ባስልኤላ የልስ።<verse eid="1CH 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 2:21"/>ሄስሮናስ ላይ ኡሱፑን ታሙ ግድን፥ ጋላዳ አዋ ማክራ ናእዉ ኤክድ ሳጉባ የልስ። <verse eid="1CH 2:21"/><verse number="22" style="v" sid="1CH 2:22"/>ሳጉብ ያእራ የልስ። ያእር ጋላዳ ቢታን ደእያ ላታማነ ሄ ካታማታ ሃርስ። <verse eid="1CH 2:22"/><verse number="23" style="v" sid="1CH 2:23"/>ሽን ገሹራነ ሶረ ካዎት ያእራ ካታማታ ቃናታነ እያ ዩሹዋን ደእያ ኡሱፑን ታሙ ካታማታ ኦልድ ኦይክዶሶና፤ ያን ደእያ አሳ ኡባይ ጋላዳ አዋ ማክራ ኮቸ። <verse eid="1CH 2:23"/><verse number="24" style="v" sid="1CH 2:24"/>ሄስሮን ካለባ ኤፍራታ ጌተትያ በሳን ሀይቅዳፐ ጉየ፥ ሄስሮና ማችያ አብያ ተቁሄ አዋ አሽሁራ የላሱ።<verse eid="1CH 2:24"/></para>
  <para style="s1">ይርማኤላ ሼሽ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25"/>ሄስሮና ባይራ ናኣ ይራማኤላ ባይራ ናአይ ራማ፤ ካሎት ቡና፥ ኦረና፥ ኦፄማነ አክያ። <verse eid="1CH 2:25"/><verse number="26" style="v" sid="1CH 2:26"/>ይራህምኤላስ አታሮ ጌተትያ ሀራ ማቻ ደአዉሱ፤ አታራ ኦናማ አይዉ።<verse eid="1CH 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 2:27"/>ይራማኤላ ባይራ ናኣ ራማ ናይት ማአሳ፥ ያምናነ ኤቀራ።<verse eid="1CH 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 2:28"/>ኦናማ ናይት ሻማያነ ያዳ።</para>
  <para style="p" vid="1CH 2:28">ሳማየ ናይት ናዳበነ አብሱራ። <verse eid="1CH 2:28"/><verse number="29" style="v" sid="1CH 2:29"/>አብሱራ ማችያ አብካላ አህባናነ ሞልዳ የላሱ። <verse eid="1CH 2:29"/><verse number="30" style="v" sid="1CH 2:30"/>ናዳባ አደ ናይት ሰልዳነ አፋይማ፤ ሰልድ ናአ የሎና ሀይቅስ። <verse eid="1CH 2:30"/><verse number="31" style="v" sid="1CH 2:31"/>አፋይማ ናአይ ይሽአ፤ ይሽአ ናአይ ሶሳና፤ ሶሳና ናአይ አህላያ።<verse eid="1CH 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 2:32"/>ሻማያ እሻ ያዳ ናይት የተራነ ዮናታና፤ የተር ናአ የሎና ሀይቅስ። <verse eid="1CH 2:32"/><verse number="33" style="v" sid="1CH 2:33"/>ዮናታና ናይት ፈልታነ ዛዛ።</para>
  <para style="p" vid="1CH 2:33">ሀይሳቲ ይራማኤላ ኮቻታ።<verse eid="1CH 2:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 2:34"/>ሶሳናስ ማጫ ናአፐ አትሽን፥ አደ ናእ ባዋ። ሶሳናስ እዮሄላ ጌተትያ ግብፀፈ አይለይ ደኤስ። <verse eid="1CH 2:34"/><verse number="35" style="v" sid="1CH 2:35"/>ሶሳን ባ ናእዉ ባ አይልያ እዮሄላስ እምን፥ አታያ ናአ የላሱ። <verse eid="1CH 2:35"/><verse number="36" style="v" sid="1CH 2:36"/>አታይ ናታና የልስ፤ ናታን ዛባዳ የልስ፤ <verse eid="1CH 2:36"/><verse number="37" style="v" sid="1CH 2:37"/>ዛባድ ኤፍላላ የልስ፤ ኤፍላል ኦቤዳ የልስ፤ <verse eid="1CH 2:37"/><verse number="38" style="v" sid="1CH 2:38"/>ኦቤድ እዩ የልስ፤ እዩይ አዛራ የልስ፤ <verse eid="1CH 2:38"/><verse number="39" style="v" sid="1CH 2:39"/>አዛርያስ ከለሳ የልስ፤ ከለስ ኤልኣሳ የልስ፤ <verse eid="1CH 2:39"/><verse number="40" style="v" sid="1CH 2:40"/>ኤልኣስ ስስማያ የልስ፤ <verse eid="1CH 2:40"/><verse number="41" style="v" sid="1CH 2:41"/>ስስማይ ሳሎማ የልስ፤ ሳሎም ይቃማ የልስ፤ ይቃም ኤልሳማ የልስ።<verse eid="1CH 2:41"/></para>
  <para style="s1">ካለባ ሼሽ</para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42"/>ይራማኤላ እሻ ካለባ ባይራ ናአይ ሞሳ። ሞሳ ናአይ ዚፋ፤ ዚፋ ናአይ መሬሳ፤ መሬሳ ናአይ ከብሮና። <verse eid="1CH 2:42"/><verse number="43" style="v" sid="1CH 2:43"/>ከብሮና ናይት ቆራሀ፥ ተፉዋ፥ ረቄማነ ሻማያ። <verse eid="1CH 2:43"/><verse number="44" style="v" sid="1CH 2:44"/>ሻማየይ ዮርቃኣማ አዋ ራሃማ የልስ። ረቄም ሻማያ የልስ። <verse eid="1CH 2:44"/><verse number="45" style="v" sid="1CH 2:45"/>ሻማያ ናአይ ማኦና። ማኦን ቤት-ፁራ የልስ።<verse eid="1CH 2:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="1CH 2:46"/>ካለባ ላገያ ኤፋ፥ ሀራና፥ ሞዳነ ጋዜዛ የላሱ፤ ሀራን ጋዜዛ ጌተትያ ሀራ አደ ናአ የልስ።<verse eid="1CH 2:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="1CH 2:47"/>ያህዳያ ናይት ረገማ፥ እዮአታማ፥ ገሻና፥ ፋለፃ፥ ኤፋነ ሻፋ።<verse eid="1CH 2:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 2:48"/>ካለባ ላገያ ማእካ ሸበራነ ትርሃና የላሱ። <verse eid="1CH 2:48"/><verse number="49" style="v" sid="1CH 2:49"/>ቃስካ መድማና አዋ ሻፋነ ማክቤናነ ግብአ አዋ ሱሳና የላሱ።</para>
  <para style="p" vid="1CH 2:49">ካለባ ማጫ ናኤ ሱንይ አክሶ።<verse eid="1CH 2:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 2:50"/>ካለባ ናይት ሀራት ሀይሳፈ ካልድ ፃፈትዶሶና። ካለብ ባ ባይራ ናኣ ሁራ ባ ማቸ ኤፍራታፐ የልስ። ሁራ ናይት ቅርያት-ይኣርማ አዋ ሶባላ፥ <verse eid="1CH 2:50"/><verse number="51" style="v" sid="1CH 2:51"/>ቤተለመ አዋ ሳልሞናነ ቤት-ጋደራ አዋ ሀሬፋ። <verse eid="1CH 2:51"/><verse number="52" style="v" sid="1CH 2:52"/>ቅርያት-ይኣርማ አዋ ሶባላ ያራት ሀሮኤታታነ ማኑሆታ ያራታፐ ባጋታ። <verse eid="1CH 2:52"/><verse number="53" style="v" sid="1CH 2:53"/>ቅርያት-ይኣርማ ያራት ያትረታ፥ ፑተታ፥ ሹማተታነ ምሽረታ። ፆርአትነ ኤሽታኦለት ሀይሳታፐ የለትዶሶና። <verse eid="1CH 2:53"/><verse number="54" style="v" sid="1CH 2:54"/>ቤተለመ አዋ ሳልሞና ያራት ናፆፋታ፥ አፅሮት-ቤተዮአበታ፥ ማኑሆታ ያራታፐ ባጋታነ ፆርአታ። <verse eid="1CH 2:54"/><verse number="55" style="v" sid="1CH 2:55"/>ያበፃ ካታማን ደእያ ፃፈታ ያራት ትርኤታ፥ ሽምአታነ ሱካታ። ሀይሳቲ ረካባታ አዋ ሀማታፐ የለትዳ ቄናታ።<verse eid="1CH 2:55"/></para>
  <chapter eid="1CH 2"/>
  <chapter number="3" style="c" sid="1CH 3"/>
  <para style="s1">ዳዊታ ሼሽ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1"/>ከብሮና ካታማን ዳዊቲ የልዳ ናይት ሀይሳፈ ካልድ ፃፈትዳይሳታ፤ እዝራኤለ ማጫሰ አክናሆምፐ የልዳ ባይራ ናአይ አምኖና። ቃርመሎሳ ማጫሰ አብግያፐ የልዳ ናምአን ናአይ ዳነላ። <verse eid="1CH 3:1"/><verse number="2" style="v" sid="1CH 3:2"/>ገሹራ ካዋ ታልማያ ናእያ ማእካ የልዳ ሄን ናአይ አበሰሎመ። አግታ የልዳ ኦይዳን ናአይ አዶንያሳ። <verse eid="1CH 3:2"/><verse number="3" style="v" sid="1CH 3:3"/>አብፃላ የልዳ እቻሻን ናአይ ሳፋፃ። ኤግላ የልዳ ኡሱፑን ናአይ ይትርሃማ። <verse eid="1CH 3:3"/><verse number="4" style="v" sid="1CH 3:4"/>ዳዊቲ ሀ ኡሱፑን ናይታ ከብሮናን የልስ። ዳዊቲ ከብሮናን ላፑን ላይነ ኡሱፑን አጌና ካዎትስ።</para>
  <para style="p" vid="1CH 3:4">የሩሳላመን ሀስታማነ ሄ ላይ ካዎትስ። <verse eid="1CH 3:4"/><verse number="5" style="v" sid="1CH 3:5"/>ዳዊቲ የሩሳላመን አምኤላ ናኤ በርሳበፐ የልዳ ኦይዱ ናይት ሳሙሳ፥ ሶባባ፥ ናታነነ ሶሎሞነ። <verse eid="1CH 3:5"/><verse number="6" style="v" sid="1CH 3:6"/>ቃስ ሀራ ኡዱፉን አደ ናይት እያብሃራ፥ ኤልሹአ፥ ኤልፋላፃ፥ <verse eid="1CH 3:6"/><verse number="7" style="v" sid="1CH 3:7"/>ኖጋ፥ ነፈቃ፥ ያፋያ፥ <verse eid="1CH 3:7"/><verse number="8" style="v" sid="1CH 3:8"/>ኤልሳማ፥ ኤልዳሄነ ኤልፋላፃ። <verse eid="1CH 3:8"/><verse number="9" style="v" sid="1CH 3:9"/>ሀ አደ ናይታ ኡባ ቦላ ዳዊታስ ላገታፐ የለትዳ ሀራ አደ ናይት ደኦሶና፤ ትማሮ ጌተትያ ምቻ ኤንታዉ ደአዉሱ።<verse eid="1CH 3:9"/></para>
  <para style="s1">ይሁዳ ካዎታ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 3:10"/>ካዋ ሶሎሞነ የለታይ ሀይሳፈ ካልድ ፃፈትዳይሳ። ሶሎሞነ ናአይ ሮብኣማ፤ ሮብኣማ ናአይ አብያ፤ አብያ ናአይ አሳ፤ አሳ ናአይ እዮሳፈፃ፤ <verse eid="1CH 3:10"/><verse number="11" style="v" sid="1CH 3:11"/>እዮሳፈፃ ናአይ እዮራማ፤ እዮራማ ናአይ አካዝያሳ፤ አካዝያሳ ናአይ እዮኣሳ፤ <verse eid="1CH 3:11"/><verse number="12" style="v" sid="1CH 3:12"/>እዮኣሳ ናአይ አማስያሳ፤ አማስያሳ ናአይ አዛርያሳ፤ አዛርያሳ ናአይ እዮአታማ፤ <verse eid="1CH 3:12"/><verse number="13" style="v" sid="1CH 3:13"/>እዮአታማ ናአይ አካዛ፤ አካዛ ናአይ ህዝቅያሳ፤ ህዝቅያሳ ናአይ ምናሰ፤ <verse eid="1CH 3:13"/><verse number="14" style="v" sid="1CH 3:14"/>ምናሰ ናአይ አሞፀ፤ አሞፀ ናአይ እዮስያሳ። <verse eid="1CH 3:14"/><verse number="15" style="v" sid="1CH 3:15"/>እዮስያሳ ናአይ ባይራይ ዮሃናና፤ ናምአንይ እዮኣቀመ፤ ሄንይ ሰደቅያሳ፤ ኦይዳንይ ሳሎማ። <verse eid="1CH 3:15"/><verse number="16" style="v" sid="1CH 3:16"/>እዮኣቀመ ናይት እኮንያናነ ሰደቅያሳ።<verse eid="1CH 3:16"/></para>
  <para style="s1">ካዎታ የለታ ሱሳ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 3:17"/>ድኤትድ ባብሎነ ብዳ እኮንያና አደ ናይት ሳላትያላ፥ <verse eid="1CH 3:17"/><verse number="18" style="v" sid="1CH 3:18"/>ማልክራማ፥ ፓዳያ፥ ሸናፃራ፥ ይቃማ፥ ሆሻማነ ናዳባ። <verse eid="1CH 3:18"/><verse number="19" style="v" sid="1CH 3:19"/>ፓዳያ አደ ናይት ዛሩባበላነ ሳመአ። ዛሩባበላ አደ ናይት ማሱላማነ ሀናና፤ ኤንታ ምችያ ሳሎምቶ። <verse eid="1CH 3:19"/><verse number="20" style="v" sid="1CH 3:20"/>ሀይሳታ ቦላ ሀራ እቻሹ አደ ናይት ዛሩባበላስ ደኦሶና፤ ኤንትካ ሀሹባ፥ ኦሄላ፥ ባራካ፥ ሀሳድያነ ዮሻብ-ሄሰዳ።<verse eid="1CH 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 3:21"/>ሀናና አደ ናይት ፓላፃነ የሻያ። የሻያ ናአይ ራፋያ፤ ራፋያ ናአይ አርናና፤ አርናና ናአይ አብድዩ፤ አብድዩ ናአይ ሳካና፤ <verse eid="1CH 3:21"/><verse number="22" style="v" sid="1CH 3:22"/>ሳካና ናአይ ሻማያ። ሻማያ ናይት እቻሻት ሀፁሳ፥ ይግኣላ፥ ባርሀ፥ ናአራነ ሻፋፃ። <verse eid="1CH 3:22"/><verse number="23" style="v" sid="1CH 3:23"/>ናአራ ናይት ሄት ኤልዮአና፥ ህዝቅያሳነ አዝርቃማ። <verse eid="1CH 3:23"/><verse number="24" style="v" sid="1CH 3:24"/>ኤልዮአና ናይት ላፑናት ሆዳዋ፥ ኤልያሴባ፥ ፓላያ፥ አቁባ፥ ዮሃናና፥ ዳላያነ አኔና።<verse eid="1CH 3:24"/></para>
  <chapter eid="1CH 3"/>
  <chapter number="4" style="c" sid="1CH 4"/>
  <para style="s1">ሀራ ይሁዳ ሼሽ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1"/>ይሁዳ ኮቻት ፓረሳ፥ ሄስሮና፥ ካርማ፥ ሆራነ ሶባላ።<verse eid="1CH 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 4:2"/>ሶባላ ናአይ ራይ ያሃታ የልስ፤ ያሃት አሁማያነ ላሀዳ የልስ። ሀይሳቲ ፆርአታ ያራታ። <verse eid="1CH 4:2"/><verse number="3" style="v" sid="1CH 4:3"/>ኤፃማ አደ ናይት እዝራኤለ፥ ይሽማነ ይድባሻ፤ ኤንታ ምችያ ሀፅለልፖኖ። <verse eid="1CH 4:3"/><verse number="4" style="v" sid="1CH 4:4"/>ፓኑኤል ጋዶራ የልስ። ኤፀር ሁሻ የልስ። ሁር ባ አየ ኤፍራታስ ባይራ ናአ፤ ሁር ቤተለመ አዋ። ሀይሳቲ ሁራ ያራታ።<verse eid="1CH 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 4:5"/>ተቁሄ አዋ አሽሁራስ ሄሎነ ናእራ ጌተትያ ናምኡ ማቸት ደኦሶና። <verse eid="1CH 4:5"/><verse number="6" style="v" sid="1CH 4:6"/>ናእራ አሁዛማ፥ ሄፌራ፥ ተምናነ አሽታራ አሽሁራስ የላሱ፤ ሀይሳቲ ናእር ናይታ። <verse eid="1CH 4:6"/><verse number="7" style="v" sid="1CH 4:7"/>ሄላ አደ ናይት ደረታ፥ ይፅሃራነ ኤትናና። <verse eid="1CH 4:7"/><verse number="8" style="v" sid="1CH 4:8"/>ቆፀ አደ ናይት አኑባ፥ ፆበባነ አሀርሄላ።<verse eid="1CH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9"/>ያበፅ ባ እሻታፐ አድ ቦንቸትዳ አስ። እያ አይያ፥ “ታኒ እያ ኢታ እቀን የልዳ ግሾ፥ እያ ሱንይ ያበፃ” ጋዳ ፄጋሱ። <verse eid="1CH 4:9"/><verse number="10" style="v" sid="1CH 4:10"/>ያበፅ እስራኤለ ፆሳ ፄግድ፥ “አቤት ፆሳዉ፥ ታና አንጃ፤ ታ ዛዋ ዳልግሳ። ነ ኩሸይ ታራ ግዶ፤ ታና አዛንና መላ ቆህያባፐ ናጋ” ያግድ ዎስን ፆሳይ እያ ዎሳ ስእስ።<verse eid="1CH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 4:11"/>ሹሀ እሻይ ካሉባ ማህራ የልስ፤ ማህር ኤሽቶና የልስ። <verse eid="1CH 4:11"/><verse number="12" style="v" sid="1CH 4:12"/>ኤሽቶን ቤት-ራፋ፥ ፓሰሀነ እርናሀሻ አዋ ታህና የልስ። ታህን ናሃሳ ካታማ አሳ የልስ። ሀይሳቲ ረካ ቢታን ደእዶሶና።<verse eid="1CH 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 4:13"/>ቀነዛ አደ ናይት ጎቶንያላነ ሳራያ፤ ጎቶንያላ አደ ናይት ሀታታነ ማኦኖታያ። <verse eid="1CH 4:13"/><verse number="14" style="v" sid="1CH 4:14"/>ማኦኖታይ ኦፍራ የልስ። ሳራይ እዮኣባ የልስ። እዮኣብ ኩሸ ሂላታ ዛንጋራ ጌተትያ በሳን ደእያ አሳ የልስ።<verse eid="1CH 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 4:15"/>ዮፎነ ናኣ ካለባ ናይት እራ፥ ኤላነ ናኣማ። ኤላ ናአይ ቀነዛ።<verse eid="1CH 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 4:16"/>ይሀልኤላ ናይት ዚፋ፥ ዝፋሀ፥ ትራያነ አሳርኤላ።<verse eid="1CH 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 4:17"/>ኤዝራ አደ ናይት የተራ፥ መሬዳ፥ ኤፈራነ ያሎና። መሬድ ግብፀ ካዋ ናእዉ ብትያ ኤክን እያ ማይራሞ፥ ሻማያነ ይሽባ የላሱ። ይሽብ ኤሽታሞአ የልስ። <verse eid="1CH 4:17"/><verse number="18" style="v" sid="1CH 4:18"/>ይሁዳ ቢታፈ ኤክዳ ማችያ ጋዶራ አዋ የረዳ፥ ሶኮ አዋ ሄቤራነ ዛኖሀ አዋ ያቅትኤላ የላሱ። <verse eid="1CH 4:18"/><verse number="19" style="v" sid="1CH 4:19"/>ናሀማ ምቸ፥ ሆድያ ማቸ ናይት ጋርማን ደእያ ቃእላ አዋነ ማእካን ደእያ ኤሽታሞአ አዋ።<verse eid="1CH 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 4:20"/>ሽሞና ናይት አምኖና፥ እርና፥ በንሀናነ ትሎና።</para>
  <para style="p" vid="1CH 4:20">ይሽአ ናይት ዞሄታነ በንዞሄታ።<verse eid="1CH 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 4:21"/>ይሁዳ ናኣ ሴላ ኮቻት ሌካ አዋ ኤራ፥ ማሬሳ አዋ ለአዳነ ቤት-አሽበአ ካታማን ደእያ ሊኖ ማኦ ዳደይሳታ ያራታ። <verse eid="1CH 4:21"/><verse number="22" style="v" sid="1CH 4:22"/>ሀራት ቃስ ዮቅማ፥ እዮኣሳ፥ ያሹብለሄማ፥ ሞአበ ሃርዳ ሳራፋነ ኮዘባ ካታማን ደእያ አሳታ። ሀ የለታ ማዝጋበይ በንፐ ዶምድ ደኤስ። <verse eid="1CH 4:22"/><verse number="23" style="v" sid="1CH 4:23"/>ሀይሳቲ ናፃእማንነ ጋዴራን ደእያ መቃ ሚሸ መያ አሳታ። ኤንቲ ካዋ ኦሶ ኦናዉ እያራ እስፈ ደእዶሶና።<verse eid="1CH 4:23"/></para>
  <para style="s1">ስሞና ሼሽ</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24"/>ስሞና ናይት ነሙኤላ፥ ያምና፥ ያርባ፥ ዛራነ ሳኡላ። <verse eid="1CH 4:24"/><verse number="25" style="v" sid="1CH 4:25"/>ሳኡላ ናአይ ሳሉማ፤ ሳሉማ ናአይ ምብሳማ፤ ምብሳማ ናአይ ማስማአ፤ <verse eid="1CH 4:25"/><verse number="26" style="v" sid="1CH 4:26"/>ማስማአ ናአይ ሀሙኤላ፤ ሀሙኤላ ናአይ ዛኩራ፤ ዛኩራ ናአይ ሳመአ። <verse eid="1CH 4:26"/><verse number="27" style="v" sid="1CH 4:27"/>ሳመእ ታማነ ኡሱፑን አደ ናይታነ ኡሱፑን ማጫ ናይታ የልስ። ሽን እያ እሻቲ ዳሮ ናአ የልቦኮና። ይሁዳ ኮቻዳ ስሞና ኮቻይ ዳርቦኮና።<verse eid="1CH 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 4:28"/>ስሞና ኮቻት በርሳበ ካታማንነ ሞላዳ፥ ሀፃር-ሹኣላ፥ <verse eid="1CH 4:28"/><verse number="29" style="v" sid="1CH 4:29"/>ባላ፥ ኤፀማ፥ ቶላዳ፥ <verse eid="1CH 4:29"/><verse number="30" style="v" sid="1CH 4:30"/>ባቱኤላ፥ ሆርማ፥ ፅቅላጋ፥ <verse eid="1CH 4:30"/><verse number="31" style="v" sid="1CH 4:31"/>ቤት-ማርካቦታ፥ ሆፃር-ሱስማ፥ ቤት-ብራነ ሻኣርማ ካታማታን ደእዶሶና። ዳዊቲ ካዎታና ጋካናዉ ሀይሳቲ ካታማታ ግድድ ደእዶሶና። <verse eid="1CH 4:31"/><verse number="32" style="v" sid="1CH 4:32"/>ቃስ ኤንታ ጉታት ኤፃማ፥ አይና፥ እርሞና፥ ቶከናነ አሻና። ኤንቲ ኩመ እቻሹ ካታማታ። <verse eid="1CH 4:32"/><verse number="33" style="v" sid="1CH 4:33"/>ባኣለ ጋካናዉ ሀ ካታማታ ዩሹዋን ደእያ ጉታት ኡባይ ኤንታን ጉጀቶሶና። ሀይሳቲ ኤንቲ ደእያ በሳታነ ባንታ የለታ ማራ ማዝጋበን ፃፍድ ኦይክዶሶና።<verse eid="1CH 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 4:34"/>ስሞና ያራታ ሀላቃት ሀይሳፈ ካልድ ፃፈትዳይሳታ። ኤንቲ ማሾባባ፥ ያምለካ፥ አማስያሳ ናኣ እዮስያ፥ <verse eid="1CH 4:34"/><verse number="35" style="v" sid="1CH 4:35"/>እዩኤላነ ዮሽባ ናኣ እዩ። እዩ አዋ አዋይ አሳኤላ ናአ ሳራያ። <verse eid="1CH 4:35"/><verse number="36" style="v" sid="1CH 4:36"/>ሀራ ሀላቃት ቃስ ኤልዮአና፥ ያይቆባ፥ ያሾሀያ፥ አሳያ፥ አድኤላ፥ ያስምኤላ፥ ባናያነ <verse eid="1CH 4:36"/><verse number="37" style="v" sid="1CH 4:37"/>ዚዛ። ዚዝ ሽፋ ናአ፤ ሽፍ አሎና ናአ፤ አሎን ያዳያ ናአ፤ ያዳይ ሽምራ ናአ፤ ሽምር ሻማያ ናአ። <verse eid="1CH 4:37"/><verse number="38" style="v" sid="1CH 4:38"/>ስሞና ያራታ ሀላቃት ሀይሳታ።</para>
  <para style="p" vid="1CH 4:38">ኤንታ አዋታ ኮቻይ ዳርሸ ብስ። <verse eid="1CH 4:38"/><verse number="39" style="v" sid="1CH 4:39"/>ኤንቲ ባንታ መህያስ ሄምያ በሲ ኮይሸ ጋዶራ ገልያ በሳ ማታን ደእያ ዛንጋራፐ ዶሎሀ ባጋራ ደእያ በሳ ጋካናዉ ብዶሶና። <verse eid="1CH 4:39"/><verse number="40" style="v" sid="1CH 4:40"/>ያን አራዳነ ሎኦ ሄምያ በሲ ደምዶሶና፤ ሄ ቢታይ ዎፓተነ ሳሮይ ኩምዳ ዳልጋ ቢታ። በን ዎደ ሄ ቢታን ደእዳይሳት ካማ ኮቻ። <verse eid="1CH 4:40"/><verse number="41" style="v" sid="1CH 4:41"/>ሀይሳፈ ቆሞን ሱንይ ፃፈትዳ ስሞና ኮቻት ይሁዳ ካዋ ህዝቅያሳ ዎደ ጋዶራ ቢታ ብድ ያን ደእያ ካማ ኮቻነ ማኡና አሳታ ኦልድ ይስዶሶና። ሄ ቢታን ኤንታ መህያስ ሄምያ በሲ ደእያ ግሾ፥ ስሞና ኮቻት ሀች ጋካናዉ ያን ኡትዶሶና።<verse eid="1CH 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 4:42"/>ስሞና ኮቻፈ እቻሹ ፄቱ አሳይ ሳይረ ዙማ ብዶሶና። ኤንታ ሀላቃት ይሽአ ናይታ ፓላፃ፥ ናራ፥ ራፋያነ ኡዝኤላ። <verse eid="1CH 4:42"/><verse number="43" style="v" sid="1CH 4:43"/>ባቃትድ አትዳ አማለቃ አሳ ይስድ ኤንቲ ሀች ጋካናዉ ሄ ቢታን ደኦሶና።<verse eid="1CH 4:43"/></para>
  <chapter eid="1CH 4"/>
  <chapter number="5" style="c" sid="1CH 5"/>
  <para style="s1">ሮቤላ ሼሽ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1"/>እስራኤለ ባይራ ናኣ ሮቤላ የለታይ ሀይሳፈ ካልድ ፃፈትዳይሳ። ሮቤል ባይራ ናአ፤ ሽን ባ አዋ ሂፃ ቱንስዳ ግሾ፥ ባይራተ ማታይ እስራኤለ ናኣ ዮሰፋ ናይታስ እመትስ። ሄሳ ግሾ፥ እያ የለታይ ባይራተ ማራ ናግድ ፃፈትቤና። <verse eid="1CH 5:1"/><verse number="2" style="v" sid="1CH 5:2"/>ይሁድ ባ እሻታፐ አድ ምኖ፤ ባይራተይ ዮሰፋስ እመትዳባ ግድኮካ፥ እስራኤለ አሳ ሃረይስ ይሁዳፐ ከይስ። <verse eid="1CH 5:2"/><verse number="3" style="v" sid="1CH 5:3"/>እስራኤለ ባይራ ናኣ ሮቤላ አደ ናይት ሄኖሀ፥ ፓላ፥ ሄስሮናነ ካርማ።<verse eid="1CH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 5:4"/>እዩኤላ ናአይ ሻማያ፤ ሻማያ ናአይ ጎጋ፤ ጎጋ ናአይ ሳመአ፤ <verse eid="1CH 5:4"/><verse number="5" style="v" sid="1CH 5:5"/>ሳማአ ናአይ ምካ፤ ምካ ናአይ ራያ፤ ራያ ናአይ ብኤላ። <verse eid="1CH 5:5"/><verse number="6" style="v" sid="1CH 5:6"/>ብኤላ ናአይ አሶረ ካዎይ ተልገልተልፈልሶሪ ድእድ ኤፍዳ ብኤራ፤ ብኤር ሮቤላ ኮቻታ ሀላቃ። <verse eid="1CH 5:6"/><verse number="7" style="v" sid="1CH 5:7"/>ብኤራ ዳቦት፥ ባንታ የለታ ማዝጋበን ፃፍዳ ሮቤላ ያራታ ሀላቃት እዩኤላነ፥ ዛካርያሳ። <verse eid="1CH 5:7"/><verse number="8" style="v" sid="1CH 5:8"/>ብኤል አዛዛ ናአ፤ አዛዝ ሻማአ ናአ፤ ሻማእ እዩኤላ ኮቸ። እዩኤላ ኮቻት አሮኤራ ካታማን፥ ነቦ ቢታንነ ባኣል-ማኦና ቢታን ደእዶሶና።<verse eid="1CH 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 5:9"/>ሮቤላ ኮቻታስ መሄይ ጋላዳን ዳርዳ ግሾ፥ ኤንቲ ያፐ ዶሎሀ ባጋ ብድ፥ ኤፍራፂሳ ሻፋ ጋካናዉ ደእያ መላ ቢታን ኡትዶሶና። <verse eid="1CH 5:9"/><verse number="10" style="v" sid="1CH 5:10"/>ሳኦላ ላይን አጋራ ያራታራ ሮቤላ ያራት ኦለትድ ፆንዶሶና። ጋላዳፐ ዶሎሀ ባጋራ ደእያ አጋራ ያራታ ቢታን ኡትዶሶና።<verse eid="1CH 5:10"/></para>
  <para style="s1">ጋደ ሼሻ</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11"/>ጋደ ኮቻት ሮቤላ ኮቻታፐ ፑደሀ ባጋን፥ ሳልካ ጋካናዉ ደእያ ባሳነ ቢታን ኡትዶሶና። <verse eid="1CH 5:11"/><verse number="12" style="v" sid="1CH 5:12"/>እዩኤል ኮይሮ ያራታስ ሀላቃ፤ ሳፋም ናምአን ያራታስ ሀላቃ። ያናይነ ሳፋም ባሳነን ኡትዳ ያራታስ ሀላቃ። <verse eid="1CH 5:12"/><verse number="13" style="v" sid="1CH 5:13"/>ኤንታ ዳቦት፥ ባንታ ሶ አሳን አሳን፥ ምካኤላ፥ ማሱላማ፥ ሳባ፥ ዮራያ፥ ያቅካና፥ ዙኤነ ኤቤራ። ኤንቲ ኩመ ላፑና። <verse eid="1CH 5:13"/><verse number="14" style="v" sid="1CH 5:14"/>ሀይሳቲ አብካላ ናይት ቡዛ ኮቻታ። ቡዝ የዳያ የልስ፤ የዳየይ እየሳያ የልስ፤ እየሳይ ምካኤላ የልስ፤ ምካኤል ጋላዳ የልስ፤ ጋላድ እዳያ የልስ፤ እዳይ ሁራ የልስ፤ ሁር አብሃላ የልስ። <verse eid="1CH 5:14"/><verse number="15" style="v" sid="1CH 5:15"/>ኤንታ ሶ አሳ ሀላቃይ ጉና ናኣ ናኣ አብድኤላ ናኣ አካ። <verse eid="1CH 5:15"/><verse number="16" style="v" sid="1CH 5:16"/>ኤንቲ ጋላዳንነ ባሳነን፥ ያን ደእያ ካታማታንነ ሳሮና ቢታን መሄይ ሄመትያ በሳታን ኡትዶሶና። <verse eid="1CH 5:16"/><verse number="17" style="v" sid="1CH 5:17"/>ሀይሳታ የለታይ ይሁዳ ካዋ እዮአታማ ዎደ እስራኤለ ካዋ እዮርባማ ዎደ ማዝጋበን ፃፈትስ።<verse eid="1CH 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18"/>ሮቤላ ኮቻፈ፥ ጋደ ኮቻፈነ ምናሰ ኮቻ ባጋፈ ጎንዳለ ኦይከይሳት፥ ማሸ ዳንጨይሳትነ ዶንገ ዱከይሳት ምኖነ ኦላን ሎህዳይሳት 44፥ 760. <verse eid="1CH 5:18"/><verse number="19" style="v" sid="1CH 5:19"/>ኤንቲ አጋራ ያራራ፥ እፁራ ያራራ፥ ናፈሳራነ ኖዳባራ ኦለትዶሶና። <verse eid="1CH 5:19"/><verse number="20" style="v" sid="1CH 5:20"/>ኤንቲ ሄ አሳራ ኦለትሸ ፆሳኮ ዋስዳ ግሾ፥ ማዶ ደምዶሶና። ኤንቲ ፆሳን አማነትዳ ግሾ፥ እ ኤንታዉ ዎሰትስ። ሄሳ ግሾ፥ አጋራ ያራትነ ኤንታራ ደእያ ሀራት ኤንታ ኩሸን ገልዶሶና። <verse eid="1CH 5:20"/><verse number="21" style="v" sid="1CH 5:21"/>ባንታ ሞርከታፐ እሻታሙ ሙኩሉ ግማለታ፥ ናምኡ ፄታነ እሻታሙ ሙኩሉ ዶርሳታ፥ ናምኡ ሙኩሉ ሀረታነ ፄቱ ሙኩሉ አሳ ድእድ ኤፍዶሶና። <verse eid="1CH 5:21"/><verse number="22" style="v" sid="1CH 5:22"/>ኦላይ ፆሳባ ግድዳ ግሾ ዳሮት ሀይቅዶሶና። ድኤተ ዎደይ ጋካናዉ ሄ ቢታን ደእዶሶና።<verse eid="1CH 5:22"/></para>
  <para style="s1">ምናሰ ኮቻፈ ባጋ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23"/>ምናሰ ኮቻፈ ባጋ ያራይ ባሳነፐ ዶምድ፥ ባኣል-አርሞና፥ ሳንራነ አርሞና ዙማ ጋካናዉ ደእያ ቢታን ኡትዶሶና፤ ኤንቲ ሄ ቢታን ዳርዶሶና። <verse eid="1CH 5:23"/><verse number="24" style="v" sid="1CH 5:24"/>ኤንታ ሶ ሀላቃት ኤፈራ፥ ይሽአ፥ ኤልኤላ፥ አዝርኤላ፥ ኤርምያሳ፥ ሆዳዋነ እዮድኤላ። ሀይሳቲ ኤንታ ሶ አሳን ኤረትዳይሳታ፥ ፃላነ ዎልቃማ።<verse eid="1CH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 5:25"/>ሽን ባንታ ማይዛታ ፆሳስ አማነትቦኮና፤ ፆሳይ ኤንታ ስንፈ ይስዳ ሄ ቢታ ፆሳታ ጎይንዶሶና። <verse eid="1CH 5:25"/><verse number="26" style="v" sid="1CH 5:26"/>ሄሳ ግሾ፥ እስራኤለ ፆሳይ አሶረ ካዋ ፖሀ (ሄስካ ተልገልተልፈልሶራ) አያና ደንድ ሮቤላ ኮቻ፥ ጋደ ኮቻነ ምናሰ ኮቻፈ ባጋ ድእድ፥ ሀላሀ፥ ሀቦራነ ሃራ ቢታነ ጎዛና ሻፋ ኤፍስ። ኤንቲ ሀች ጋካናዉ ያን ደኦሶና።<verse eid="1CH 5:26"/></para>
  <chapter eid="1CH 5"/>
  <chapter number="6" style="c" sid="1CH 6"/>
  <para style="s1">ሌወ ሼሽ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1"/>ሌወ አደ ናይት ገድሶና፥ ቃሃታነ ማራራ።<verse eid="1CH 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 6:2"/>ቃሃታ አደ ናይት አምራማ፥ ይስሃራ፥ ከብሮናነ ኡዝኤላ።<verse eid="1CH 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 6:3"/>አምራማ አደ ናይት አሮና፥ ሙሰነ ማይራሞ።</para>
  <para style="p" vid="1CH 6:3">አሮና አደ ናይት ናዳባ፥ አብዮዳ፥ አላዛራነ እታማራ።<verse eid="1CH 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 6:4"/>አላዛር ፕንሃሳ የልስ፤ ፕንሃስ አብሱ የልስ፤ አብሱይ ቡቃ የልስ፤ <verse eid="1CH 6:4"/><verse number="5" style="v" sid="1CH 6:5"/>ቡቅ ኦዛ የልስ፤ <verse eid="1CH 6:5"/><verse number="6" style="v" sid="1CH 6:6"/>ኦዝ ዛራ የልስ፤ ዛራህ ማራዮታ የልስ፤ <verse eid="1CH 6:6"/><verse number="7" style="v" sid="1CH 6:7"/>ማራዮት አማረ የልስ፤ አማረይ አክፆባ የልስ፤ <verse eid="1CH 6:7"/><verse number="8" style="v" sid="1CH 6:8"/>አክፆብ ሳዶቃ የልስ፤ ሳዶቅ አክማሳ የልስ፤ <verse eid="1CH 6:8"/><verse number="9" style="v" sid="1CH 6:9"/>አክማስ አዛርያሳ የልስ፤ አዛርያስ ዮሃና የልስ፤ <verse eid="1CH 6:9"/><verse number="10" style="v" sid="1CH 6:10"/>ዮሃን አዛርያሳ የልስ። ሶሎሞነይ የሩሳላመን ኬፅስዳ ፆሳ ኬን ኦዳ ካህነይ አዛርያሳ። <verse eid="1CH 6:10"/><verse number="11" style="v" sid="1CH 6:11"/>አዛርያስ አማረ የልስ፤ አማረይ አክፆባ የልስ፤ <verse eid="1CH 6:11"/><verse number="12" style="v" sid="1CH 6:12"/>አክፆብ ሳዶቃ የልስ፤ ሳዶቅ ሳሉማ የልስ፤ <verse eid="1CH 6:12"/><verse number="13" style="v" sid="1CH 6:13"/>ሳሉም ካልቀ የልስ፤ ካልቀይ አዛርያሳ የልስ፤ <verse eid="1CH 6:13"/><verse number="14" style="v" sid="1CH 6:14"/>አዛርያስ ሳራያ የልስ፤ ሳራይ እዮሳደቃ የልስ። <verse eid="1CH 6:14"/><verse number="15" style="v" sid="1CH 6:15"/>ጎዳይ ይሁዳነ የሩሳላመ ናቡካዳናፆራን ድኤታና መላ ኦዳ ዎደ እዮሳደቅ ድኤትድ ብስ።<verse eid="1CH 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 6:16"/>ሌወ አደ ናይት ገድሶና፥ ቃሃታነ ማራራ። <verse eid="1CH 6:16"/><verse number="17" style="v" sid="1CH 6:17"/>ገድሶና አደ ናይታ ሱንይ ልብናነ ሳመአ። <verse eid="1CH 6:17"/><verse number="18" style="v" sid="1CH 6:18"/>ቃሃታ አደ ናይት አምራማ፥ ይስሃራ፥ ከብሮናነ ኡዝኤላ። <verse eid="1CH 6:18"/><verse number="19" style="v" sid="1CH 6:19"/>ማራራ አደ ናይት ማህላነ ሙሰ። ባንታ ሶ አሳን አሳን ፃፈትዳ ሌወ ያራይ ሀይሳ።<verse eid="1CH 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 6:20"/>ገድሶና ናአይ ልብና፤ ልብና ናአይ ያሃታ፤ ያሃታ ናአይ ዛማታ። <verse eid="1CH 6:20"/><verse number="21" style="v" sid="1CH 6:21"/>ዛማታ ናአይ ዮኣካ፤ ዮኣካ ናአይ አዶ፤ አዶ ናአይ ዛራ፤ ዛራ ናአይ ያትራ።<verse eid="1CH 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 6:22"/>ቃሃታ ናአይ አምናዳበ፤ አምናዳበ ናአይ ቆረ፤ ቆረ ናአይ አሴራ፤ <verse eid="1CH 6:22"/><verse number="23" style="v" sid="1CH 6:23"/>አሴራ ናአይ ሄልቃና፤ ሄልቃና ናአይ አብሳፋ፤ አብሳፋ ናአይ አሴራ፤ <verse eid="1CH 6:23"/><verse number="24" style="v" sid="1CH 6:24"/>አሴራ ናአይ ታሀታ፤ ታሀታ ናአይ ኡርኤላ፤ ኡርኤላ ናአይ ኦዝያና፤ ኦዝያና ናአይ ሳዉላ።<verse eid="1CH 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 6:25"/>ሄልቃና አደ ናይት አማሳነ አክሞታ። <verse eid="1CH 6:25"/><verse number="26" style="v" sid="1CH 6:26"/>አክሞታ ናአይ ሄልቃና፤ ሄልቃና ናአይ ፆፋያ፤ ፆፋያ ናአይ ናሃታ፤ <verse eid="1CH 6:26"/><verse number="27" style="v" sid="1CH 6:27"/>ናሃታ ናአይ ኤልያባ፤ ኤልያባ ናአይ ይሮሃማ፤ ይሮሃማ ናአይ ህልቃና።<verse eid="1CH 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 6:28"/>ሳሜላ ባይራ ናአይ እዩኤላ፤ ካሎይ አብያ።<verse eid="1CH 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 6:29"/>ማራራ አደ ናይት ማህላ፤ ማህላ ናአይ ልብና፤ ልብና ናአይ ሳመአ፤ ሳመአ ናአይ ኦዛ፤ <verse eid="1CH 6:29"/><verse number="30" style="v" sid="1CH 6:30"/>ኦዛ ናአይ ሳምአ፤ ሳምአ ናአይ ሀግያ፤ ሀግያ ናአይ አሳያ።<verse eid="1CH 6:30"/></para>
  <para style="s1">ፆሳ ኬ ዛማረታ</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31"/>ዳዊቲ ታቦትያ የሩሳላመ ኤህዳፐ ጉየ፥ ጎዳ ኬን ሹምዳ ዛማረታ ሀላቃት ሀይሳፈ ካልድ ፃፈትዳይሳታ። <verse eid="1CH 6:31"/><verse number="32" style="v" sid="1CH 6:32"/>ሶሎሞነይ የሩሳላመን ጎዳ ፆሳ ኬ ኬፃና ጋካናዉ፥ ጎዳ ታቦተይ ደእያ ዱንካንያ ስንን እሶይ እሶይ ባ ማራን ማራን ማዝሙረ የፅሸ ጎዳስ ኦዶሶና። <verse eid="1CH 6:32"/><verse number="33" style="v" sid="1CH 6:33"/>ባንታ አደ ናይታራ የፅዳይሳት ሀይሳፈ ካልድ ፃፈትዳይሳታ።</para>
  <para style="p" vid="1CH 6:33">ቃሃታ ያራፐ ዛማርያ ሄማና፤ ሄማን እዩኤላ ናአ፤ እዩኤላ ሳሜላ ናአ፤ <verse eid="1CH 6:33"/><verse number="34" style="v" sid="1CH 6:34"/>ሳሜል ሄልቃና ናኣ፤ ህልቃን ይሮሃማ ናአ፤ ይሮሃም ኤልኤላ ናአ፤ ኤልኤል ቶሀ ናአ፤ <verse eid="1CH 6:34"/><verse number="35" style="v" sid="1CH 6:35"/>ቶህ ፆፋያ ናአ፤ ፆፋያ ሄልቃና ናአ፤ ህልቃን ማሃታ ናአ፤ ማሃት አማሳያ ናአ፤ <verse eid="1CH 6:35"/><verse number="36" style="v" sid="1CH 6:36"/>አማሳይ ሄልቃና ናአ፤ ሄልቃን እዩኤላ ናአ፤ እዩኤላ አዛርያሳ ናአ፤ አዛርያስ ሶፎንያሳ ናአ፤ <verse eid="1CH 6:36"/><verse number="37" style="v" sid="1CH 6:37"/>ሶፎንያስ ታሀታ ናአ፤ ታሀት አሴራ ናአ፤ አሴር አብሳፋ ናአ፤ አብሳፍ ቆረ ናአ፤ <verse eid="1CH 6:37"/><verse number="38" style="v" sid="1CH 6:38"/>ቆረይ ይሳራ ናአ፤ ይሳር ቃሃታ ናአ፤ ቃሃት ሌወ ናአ፤ ሌወይ እስራኤለ ናአ።<verse eid="1CH 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 6:39"/>ሄማና ዳቦይ አሳፍ እያ ኡሻቻ ባጋራ ኤቅድ ኦስ። አሳፍ ባራካ ናአ፤ ባራካ ስምአ ናአ፤ <verse eid="1CH 6:39"/><verse number="40" style="v" sid="1CH 6:40"/>ሽምእ ምካኤላ ናአ፤ ምካኤል ባአሳያ ናአ፤ ባኣስ ማልክያ ናአ፤ <verse eid="1CH 6:40"/><verse number="41" style="v" sid="1CH 6:41"/>ማልከይ ኤታና ናአ፤ ኤታን ዛራ ናአ፤ ዛር አዳያ ናአ፤ <verse eid="1CH 6:41"/><verse number="42" style="v" sid="1CH 6:42"/>አዳይ ኤታና ናአ፤ ኤታን ዛማታ ናአ፤ ዛማት ሳመአ ናአ፤ <verse eid="1CH 6:42"/><verse number="43" style="v" sid="1CH 6:43"/>ሳመእ ያሃታ ናአ፤ ያሃት ገድሶና ናአ፤ ገድሶን ሌወ ናአ።<verse eid="1CH 6:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 6:44"/>ኤንታፈ ሀድርሳ ባጋራ ኤንታ ዳቦት፥ ማራራ ያራት ኤቆሶና። ኤታን ቂሳ ናአ፤ ቂስ አብድ ናአ፤ አብድ ማሉካ ናአ፤ <verse eid="1CH 6:44"/><verse number="45" style="v" sid="1CH 6:45"/>ማሉክ ሀሻባያ ናአ፤ ሀሻባያ አማስያሳ ናአ፤ አማስያስ ካልቀ ናአ፤ <verse eid="1CH 6:45"/><verse number="46" style="v" sid="1CH 6:46"/>ክልቀይ አሜሳ ናአ፤ አሜስ ባና ናአ፤ ባን ሳማራ ናአ፤ <verse eid="1CH 6:46"/><verse number="47" style="v" sid="1CH 6:47"/>ሳማር ማህላ ናአ፤ ማህል ሙሰ ናአ፤ ሙስ ማራራ ናአ፤ ማራር ሌወ ናአ። <verse eid="1CH 6:47"/><verse number="48" style="v" sid="1CH 6:48"/>ኤንታ ዳቦ ግድዳ ሌወት ፆሳ ዱንካንያን ኦናዉ ሱንትዶሶና።<verse eid="1CH 6:48"/></para>
  <para style="s1">አሮና ሼሽ</para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 6:49"/>ሽን አሮንነ እያ ኮቻት እፃነ ጩይሶሶና፤ ያርሾ በሳን ፁሳ ያርሾ ያርሾሶና። ፆሳ አይለይ ሙሰይ ኪትዳይሳዳ ኡባፈ ጌሻ በሳን ጎይንያ ጎይኖ ኡባስነ ፆሳይ እስራኤለ ናጋራ አቶ ያግስያ ያርሹዋ ያርሻናዉ አዋተ ኤንታዉ ደኤስ።<verse eid="1CH 6:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 6:50"/>አሮና የለታይ ሀይሳፈ ካልድ ፃፈትዳይሳታ። አሮና ናአይ አላዛራ፤ አላዛራ ናአይ ፕንሃሳ፤ ፕንሃሳ ናአይ አብሱ፤ <verse eid="1CH 6:50"/><verse number="51" style="v" sid="1CH 6:51"/>አብሱ ናአይ ቡቃ፤ ቡቃ ናአይ ኦዛ፤ ኦዛ ናአይ ዛራሀ። <verse eid="1CH 6:51"/><verse number="52" style="v" sid="1CH 6:52"/>ዛራሀ ናአይ ማራዮታ፤ ማራዮታ ናአይ አማረ፤ አማረ ናአይ አክፁባ፤ <verse eid="1CH 6:52"/><verse number="53" style="v" sid="1CH 6:53"/>አክፁባ ናአይ ሳዶቃ፤ ሳዶቃ ናአይ አክማሳ።<verse eid="1CH 6:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54"/>አሮና ኮቻት ዳና መላ ኤንታዉ እመትዳ በሳት ሀይሳፈ ካልድ ፃፈትዳይሳ።</para>
  <para style="p" vid="1CH 6:54">ኮይሮ ሳማይ ቃሃታ ያራስ ከይዳ ግሾ <verse eid="1CH 6:54"/><verse number="55" style="v" sid="1CH 6:55"/>ይሁዳን ደእያ ከብሮና ካታማነ እያ ዩሹዋን ደእያ ሄን በሳታ ኤንታዉ እምዶሶና። <verse eid="1CH 6:55"/><verse number="56" style="v" sid="1CH 6:56"/>ሽን ከብሮና ጎሻ ጋደታነ እያ ዩሹዋን ደእያ ጉታታ ዮፎነ ናኣ ካለባስ እምዶሶና። <verse eid="1CH 6:56"/><verse number="57" style="v" sid="1CH 6:57"/>አሮና ናይታስ ባቃትድ አትያ ካታማታ፥ ከብሮና፥ ያትራ፥ ልብና፥ ኤሽታሞአነ ኤንታ ሄራን ደእያ ሄን በሳታ። <verse eid="1CH 6:57"/><verse number="58" style="v" sid="1CH 6:58"/>ሆሎና፥ ዳብራነ ኤንታ ሄራን ደእያ ሄን በሳታ፥ <verse eid="1CH 6:58"/><verse number="59" style="v" sid="1CH 6:59"/>አሳና፥ ቤት-ሳሜሳነ ኤንታ ሄራን ደእያ ሄን በሳታ እምዶሶና። <verse eid="1CH 6:59"/><verse number="60" style="v" sid="1CH 6:60"/>ቃስ ብንያመ ቢታ ዛዋፐ ግብአ፥ ጋለማታ፥ አናቶተነ ኤንታ ሄራን ደእያ ሄን በሳታ ኤንታዉ እምዶሶና። አሮና ናይታስ እመትዳ ካታማት ኩመ ታማነ ሄ። <verse eid="1CH 6:60"/><verse number="61" style="v" sid="1CH 6:61"/>ምናሰ ያራ ባጋ ቢታፈ ታሙ ካታማታ አትዳ ቃሃታ ያራስ እምዶሶና።<verse eid="1CH 6:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62"/>ይሳኮራ፥ አሴራ፥ ንፍታለመነ ባሳነን ደእያ ምናሰ ያራ ቢታ ዛዋፐ ታማነ ሄ ካታማታ ገድሶና ያራስ እምዶሶና።<verse eid="1CH 6:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="1CH 6:63"/>ሮቤላ፥ ጋደነ ዛብሎና ቢታ ዛዋፐ ታማነ ናምኡ ካታማታ ማራራ ያራስ እምዶሶና።<verse eid="1CH 6:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="1CH 6:64"/>ሄሳዳ ኦድ፥ እስራኤለ አሳይ ሌወታስ ሀ ካታማታነ ኤንታ ሄራን ደእያ ሄን ቢታ እምዶሶና። <verse eid="1CH 6:64"/><verse number="65" style="v" sid="1CH 6:65"/>ይሁዳፐ፥ ስሞናፐነ ብንያመ ቢታ ዛዋፐ ሀይሳፈ ቆሞን ፃፈትዳ ካታማታ ኤንታዉ እምዶሶና።<verse eid="1CH 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66"/>ቃሃታ ያራፐ ጉት ኤፍሬማ ቢታ ዛዋፐ ካታማታነ ኤንታ ሄራን ደእያ ሄን በሳታ ኤክዶሶና። <verse eid="1CH 6:66"/><verse number="67" style="v" sid="1CH 6:67"/>ኤንታዉ አሳይ ባቃትድ አትያ ካታማታ፥ ደረይ ዳርያ ኤፍሬማ ቢታን ደእያ ሴከማ፥ ገዘራ፥ <verse eid="1CH 6:67"/><verse number="68" style="v" sid="1CH 6:68"/>ዮቅምኣማ፥ ቤት-ሆሮና፥ <verse eid="1CH 6:68"/><verse number="69" style="v" sid="1CH 6:69"/>ኤሎና፥ ጋት-ርሞናነ ኤንታ ሄራን ደእያ ሄን በሳታ እምዶሶና። <verse eid="1CH 6:69"/><verse number="70" style="v" sid="1CH 6:70"/>ምናሰ ኮቻ ባጋፈ አኔራ፥ ብልኣማነ ኤንታ ሄራን ደእያ ሄን በሳታ፥ አትዳ ቃሃታ ያራስ እምዶሶና።<verse eid="1CH 6:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="1CH 6:71"/>ምናሰ ኮቻ ባጋፈ ባሳነን ደእያ ጎላና፥ አስታሮታነ ኤንታ ሄራን ደእያ ሄን በሳታ ገድሶና ያራስ እምዶሶና። <verse eid="1CH 6:71"/><verse number="72" style="v" sid="1CH 6:72"/>ይሳኮራ ኮቻፈ ቃደሳ፥ ዳብራተነ ኤንታ ሄራን ደእያ ሄን በሳታ፥ <verse eid="1CH 6:72"/><verse number="73" style="v" sid="1CH 6:73"/>ራሞታ፥ አነማናነ ኤንታ ሄራን ደእያ ሄን በሳታ እምዶሶና። <verse eid="1CH 6:73"/><verse number="74" style="v" sid="1CH 6:74"/>አሴራ ኮቻፈ ማሻላ፥ አብዶና፥ <verse eid="1CH 6:74"/><verse number="75" style="v" sid="1CH 6:75"/>ሁቆቃ፥ ረሆባነ ኤንታ ሄራን ደእያ ሄን በሳታ እምዶሶና። <verse eid="1CH 6:75"/><verse number="76" style="v" sid="1CH 6:76"/>ንፍታለመ ኮቻፈ ጋልላን ደእያ ቃደሳ፥ ሀሞና፥ ቅራታይማነ ኤንታ ሄራን ደእያ ሄን በሳታ እምዶሶና።<verse eid="1CH 6:76"/></para>
  <para style="p">
    <verse number="77" style="v" sid="1CH 6:77"/>አትዳ ማራራ ያራስ ዛብሎና ኮቻፈ እርሞና፥ ታቦረነ ኤንታ ሄራን ደእያ ሄን በሳታ እምዶሶና። <verse eid="1CH 6:77"/><verse number="78" style="v" sid="1CH 6:78"/>ሮቤላ ኮቻፈ እያርኮፈ ሄፍንን ዮርዳኖሰፐ ዶሎሀ ባጋራ፥ ቃ ደንባን ደእያ ቦሶራ፥ ያሳነ፥ <verse eid="1CH 6:78"/><verse number="79" style="v" sid="1CH 6:79"/>ቅድሞታ፥ መፋታነ ኤንታ ሄራን ደእያ ሄን በሳታ እምዶሶና። <verse eid="1CH 6:79"/><verse number="80" style="v" sid="1CH 6:80"/>ጋደ ኮቻፈ ጋላዳን ደእያ ራሞታ፥ ማሀናይማ፥ <verse eid="1CH 6:80"/><verse number="81" style="v" sid="1CH 6:81"/>ሀሰቦና፥ እያዜራነ ኤንታ ሄራን ደእያ ሄን በሳታ እምዶሶና።<verse eid="1CH 6:81"/></para>
  <chapter eid="1CH 6"/>
  <chapter number="7" style="c" sid="1CH 7"/>
  <para style="s1">ይሳኮራ ሼሽ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1"/>ይሳኮራ ኦይዱ አደ ናይት ቶላ፥ ፑዋ፥ ያሱባነ ሽምሮና።<verse eid="1CH 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 7:2"/>ቶላ አደ ናይት ኦዛ፥ ራፋያ፥ ይርኤላ፥ ህማያ፥ ይብሳማነ ሽሙኤላ፤ ሀይሳቲ ቶላ ሶ አሳ ሀላቃታ። ኤንቲ ዎልቃማነ ምኖ አስ። ዳዊታ ዎደ ኤንታ ታይቦይ 22,600.<verse eid="1CH 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 7:3"/>ኦዛ ናአይ ይዝራሀ፣ ይዝራሀ ናይት ምካኤላ፥ አብድዩ፥ እዩኤላነ ይሽያ፤ ሀ እቻሻት ሶ አሳ ሀላቃታ። <verse eid="1CH 7:3"/><verse number="4" style="v" sid="1CH 7:4"/>ባንታ ሶ አሳ የለታዳ ኦዛ ያራፐ ኦላንቾት 36,000፤ ኤንታዉ ዳሮ ማቸትነ ናይት ደኦሶና።<verse eid="1CH 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 7:5"/>ይሳኮራ ኮቻፈ ኦላንቾት ባንታ የለታ ማዝጋበን ታይበትድ፥ ኩመ 87,000 ግድዶሶና።<verse eid="1CH 7:5"/></para>
  <para style="s1">ብንያመ ሼሽ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6"/>ብንያመ ሄ አደ ናይት ቤላ፥ በከራነ ይድኤላ።<verse eid="1CH 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 7:7"/>ቤላ አደ ናይት ኤሰቦና፥ ኦዛ፥ ኡዝኤላ፥ እያርሞታነ እራ፤ ሀ እቻሻት ሶ አሳ ሀላቃታ። ኤንቲ ዎልቃማነ ምኖ አስ። ባንታ የለታን ታይበትዳ ኦላንቾት 22,034 ግድዶሶና።<verse eid="1CH 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 7:8"/>በከራ አደ ናይት ዛምራ፥ እዮኣሳ፥ አላዛራ፥ ኤልዮአና፥ ኦምራ፥ እያርሞታ፥ አብያ፥ አናቶታነ አለሜታ። <verse eid="1CH 7:8"/><verse number="9" style="v" sid="1CH 7:9"/>ባንታ የለታ ማዝጋበን ታይበትዳ ዎልቃማነ ምኖ አሳት 20,200 ግድዶሶና።<verse eid="1CH 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 7:10"/>ይድኤላ ናአይ ብልሃና። ብልሃና አደ ናይት ይኡሳ፥ ብንያመ፥ ኤሁዳ፥ ክንአና፥ ዘታና፥ ታርሰሳነ አክሳራ፤ <verse eid="1CH 7:10"/><verse number="11" style="v" sid="1CH 7:11"/>ሀይሳቲ ባንታ ሶ አሳ ሀላቃ፤ ዎልቃማነ ምኖ አስ። ባንታ የለታዳ ታይበትዳ ኦላንቾት 17,200. <verse eid="1CH 7:11"/><verse number="12" style="v" sid="1CH 7:12"/>ሱፍምነ ሁፍም እራ ናይታ። ሁሽም አሄረ ናአ።<verse eid="1CH 7:12"/></para>
  <para style="s1">ንፍታለመ ሼሻ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13"/>ንፍታለመ ናይት ያህፅኤላ፥ ጉና፥ የፀራነ ሽለማ፤ ሀይሳቲ ባላ ኮቻታ።<verse eid="1CH 7:13"/></para>
  <para style="s1">ምናሰ ሼሽ</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14"/>ምናሰ ኮቻት ሀይሳፈ ካልድ ፃፈትዳይሳታ። ምናሰ ሶረ ላገፈ የልዳ አደ ናይት አስርኤላነ ጋላዳ አዋ ማክራ። <verse eid="1CH 7:14"/><verse number="15" style="v" sid="1CH 7:15"/>ማክር ሁፍማፐነ ሳፍማፐ እስ እስ ማቾ ኤክስ። ማክራ ምቸ ሱንይ ማእኮ። ማክራ ናአይ ካሎይ ሰሎጳዳ፤ ሰሎጳድ ማጫ ናአ ፃላላ የልስ።<verse eid="1CH 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 7:16"/>ማክራ ማችያ ማእካ ፓሬሳነ ሱሮሳ ጌተትያ ናምኡ አደ ናይታ የላሱ። ፓረሳ ናይት ኡላማነ ራቄማ። <verse eid="1CH 7:16"/><verse number="17" style="v" sid="1CH 7:17"/>ኡላማ ናአይ ባዳና። ሀይሳቲ ምናሰ ናኣ ናአ ማክራ ናኣ ጋላዳ ኮቻታ።<verse eid="1CH 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 7:18"/>ጋላዳ ምችያ ሀሞለከታ፥ እሱደ፥ አብኤዘራነ ማህላ የላሱ።<verse eid="1CH 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 7:19"/>ሻምዳ አደ ናይት አህያ፥ ሴከማ፥ ልቃነ አንኣማ።<verse eid="1CH 7:19"/></para>
  <para style="s1">ኤፍሬማ ሼሽ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20"/>ኤፍሬማ ናአይ ሹቱላ፤ ሹቱላ ናአይ ባረዳ፤ ባረዳ ናአይ ታሀታ፤ ታሀታ ናአይ ኤላዳ፤ ኤላዳ ናአይ ታሀታ፤ <verse eid="1CH 7:20"/><verse number="21" style="v" sid="1CH 7:21"/>ታሀታ ናአይ ዛባዳ፤ ዛባዳ ናአይ ሹቱላ።</para>
  <para style="p" vid="1CH 7:21">ኤፍሬማስ ኤደራነ ኤላዳ ጌተትያ ሀራ ናምኡ ናይት ደኦሶና። ኤንቲ ጌተ አሳ መሄ ካይስን አሳይ ኤንታ ዎስ። <verse eid="1CH 7:21"/><verse number="22" style="v" sid="1CH 7:22"/>ሄሳ ግሾ፥ ኤንታ አዋይ ኤፍሬም ዳሮ ዎደ አዛንን እያ እሻት እያ ምንናዉ ይዶሶና።<verse eid="1CH 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 7:23"/>ሄሳፈ ጉየ፥ እ ባ ማቸራ አቅስ፤ እያ ቃንታዳ አደ ናአ የላሱ። ኤፍሬማ ሶ ጋክዳ ኢታ መቱዋ ግሾ እ ባ ናኣ ባርአ ግድ ሱንስ።<verse eid="1CH 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 7:24"/>ሸእራ ጌተትያ ኤፍሬማ ናእያ ደአዉሱ፤ ጋርሳን ቤት-ሆሮና፥ ቆሞን ኡዘን-ሼራ ጌተትያ ካታማታ ኬፃሱ።<verse eid="1CH 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 7:25"/>ኤፍሬማ አደ ናአይ ራፋ፤ ራፋ ናአይ ረሼፋ፤ ረሼፋ ናአይ ቴላ፤ ቴላ ናአይ ታሀና፤ <verse eid="1CH 7:25"/><verse number="26" style="v" sid="1CH 7:26"/>ታሀና ናአይ ላዳና፤ ላዳና ናአይ አምሁዳ፤ አምሁዳ ናአይ ኤልሳማ፤ <verse eid="1CH 7:26"/><verse number="27" style="v" sid="1CH 7:27"/>ኤልሳማ ናአይ ናወ፤ ናወ ናአይ እያሱ።<verse eid="1CH 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28"/>ኤፍሬማ ኮቻት ኤክድ ባንታዉ ዳና በሲ ኦዳ ቢታይ፥ ቤተለነ እያ ዩሹዋን ደእያ ጉታታ፤ ዶሎሀ ባጋን ናአራ፥ ዉሎሀ ባጋን ገዘራነ ኤንታ ዩሹዋን ደእያ ጉታታ፥ ሴከማ፥ አያነ ኤንታ ዩሹዋን ደኢያ ጉታታ ኡባ ኦይኬስ። <verse eid="1CH 7:28"/><verse number="29" style="v" sid="1CH 7:29"/>ምናሰ ቢታ ዛዋን ደእያ ቤት-ሳናነ እያ ዩሹዋን ደእያ ጉታታ፥ ታናካነ እያ ዩሹዋን ደእያ ጉታታ፥ ማግዶነ እያ ዩሹዋን ደእያ ጉታታ፥ ዶራነ እያ ዩሹዋን ደእያ ጉታታ። እስራኤለ ናኣ ዮሰፋ ኮቻት ሀ ካታማታን ደእዶሶና።<verse eid="1CH 7:29"/></para>
  <para style="s1">አሴራ ሼሽ</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30"/>አሴራ አደ ናይት ይምና፥ የሱዋ፥ ይስዋነ በርአ፤ ኤንታ ምችያ ሳራሆ።<verse eid="1CH 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 7:31"/>በርአ አደ ናይት ሄቤራነ በርዛወታ አዋ ማልካኤላ።<verse eid="1CH 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 7:32"/>ሄቤር ያፍለፃ፥ ሳሜራ፥ ሆታማ የልስ፤ ኤንታ ምቸ ሱንይ ሶሳኖ።<verse eid="1CH 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 7:33"/>ያፍለፃ አደ ናይት ፓሳካ፥ ብምሃላነ አስታ።<verse eid="1CH 7:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 7:34"/>ሳሜራ አደ ናይት አካ፥ ሮጋ፥ ያሁባነ አራመ።<verse eid="1CH 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 7:35"/>ሆታማ አደ ናይት ፆፋ፥ ይምና፥ ሰለሳነ አማላ።<verse eid="1CH 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CH 7:36"/>ፆፋ አደ ናይት ሱሀ፥ ሀርነፈራ፥ ሶጋላ፥ ቤራ፥ ይምራ፥ <verse eid="1CH 7:36"/><verse number="37" style="v" sid="1CH 7:37"/>በፀራ፥ ሆዳ፥ ሳማ፥ ሰልሳ፥ ይትራናነ ብኤራ።<verse eid="1CH 7:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 7:38"/>የተራ አደ ናይት ዮሮና፥ ፕስፓነ አራ። <verse eid="1CH 7:38"/><verse number="39" style="v" sid="1CH 7:39"/>ኡላ አደ ናይት ኤራ፥ ሀንኤላነ እርፃ።<verse eid="1CH 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 7:40"/>ሀይሳቲ ኡባት አሴራ ኮቻታ። ኤንቲ ባንታ ሶ አሳ ሀላቃታነ ዶረትዳ ዎልቃማነ ምኖ አስ። ባንታ የለታዳ ታይበትዳ ኦላንቾት 26,000 ግድዶሶና።<verse eid="1CH 7:40"/></para>
  <chapter eid="1CH 7"/>
  <chapter number="8" style="c" sid="1CH 8"/>
  <para style="s1">ብንያመ ሼሽ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1"/>ብንያመ ባይራ ናአይ ቤላ፤ ካሎይ አስቤላ፤ ሄንይ አህራ፤ <verse eid="1CH 8:1"/><verse number="2" style="v" sid="1CH 8:2"/>ኦይዳንይ ኖሄ፤ እቻሻንይ ራፋ።<verse eid="1CH 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 8:3"/>ቤላ አደ ናይት አዳረ፥ ጌራ፥ አብሁዳ፥ <verse eid="1CH 8:3"/><verse number="4" style="v" sid="1CH 8:4"/>አብሱ ናእማነ፥ አሆሀ፥ <verse eid="1CH 8:4"/><verse number="5" style="v" sid="1CH 8:5"/>ጌራ፥ ሳፉፋማነ ክራማ።<verse eid="1CH 8:5"/></para>
  <para style="p">
    <verse number="6-7" style="v" sid="1CH 8:6-7"/>ኤሁዳ አደ ናይት ናእማነ፥ አክያነ ጌራ። ኤንቲ ግብአን ደእዳነ ጉየፐ ማናሃታ ቢታ ድኤትድ ብዳ ባንታ ሶ አሳ ሀላቃታ። ኤንታ ያ ካለድ ኤፍዳይ ኦዛነ አሁዳ አዋ ጌራ።<verse eid="1CH 8:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 8:8"/>ሻሀራም ባ ማቸታ ሁሽሞነ ባኢራ የድዳፐ ጉየ ሞአበ ቢታን አደ ናይታ የልስ። <verse eid="1CH 8:8"/><verse number="9" style="v" sid="1CH 8:9"/>ሻሀራም ባ ማቸ ሆድሽፐ ዮባባ፥ ድባያ፥ ሜሳ፥ ማልካማ፥ <verse eid="1CH 8:9"/><verse number="10" style="v" sid="1CH 8:10"/>የኡፃ፥ ሳክያነ ምርማ የልስ። እያ ናይት ኡባይ ባንታ ሶ አሳ ሀላቃታ ግድዶሶና። <verse eid="1CH 8:10"/><verse number="11" style="v" sid="1CH 8:11"/>እ ባ ማቸ ሁሽምፐ፥ አብፁባነ ኤልፋኣላ የልስ።<verse eid="1CH 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 8:12"/>ኤልፋኣላ አደ ናይት ኤቤራ፥ ማሸማነ ሻመዳ። ሻመድ ኦኖነ ሎዳ ካታማታነ ኤንታ ሄራን ደእያ ጉታታ ኬፅስ።<verse eid="1CH 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 8:13"/>ሻሀራም በርአነ ሸምአ የልስ። ኤንቲ ኤሎና ካታማን ደእያ ባንታ ሶ አሳ ሀላቃታ። ኤንቲ ጌተ ካታማን ደእያ አሳ ጎድዶሶና። <verse eid="1CH 8:13"/><verse number="14" style="v" sid="1CH 8:14"/>በርአ አደ ናይት ሻሀራማ፥ አህያ፥ ሻሻቃ፥ ይረሞታ።<verse eid="1CH 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 8:15"/>ዛባዳ፥ አራዳ፥ ኤደራ፥ <verse eid="1CH 8:15"/><verse number="16" style="v" sid="1CH 8:16"/>ምካኤላ፥ ይሽጳነ ዮሀ።<verse eid="1CH 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 8:17"/>ኤልፋላአ አደ ናይት ዛባዳ፥ ማሱላማ፥ ህዝቃ፥ ሄቤራ፥ <verse eid="1CH 8:17"/><verse number="18" style="v" sid="1CH 8:18"/>ይሽማራያ፥ ዩዝላነ ዮባባ።<verse eid="1CH 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 8:19"/>ሳመአ አደ ናይት ያቅማ፥ ዝክራ፥ ዝባዳ <verse eid="1CH 8:19"/><verse number="20" style="v" sid="1CH 8:20"/>ኤላናያ፥ ፅልታያ፥ ኤለላ፥ <verse eid="1CH 8:20"/><verse number="21" style="v" sid="1CH 8:21"/>አዳያ፥ ብራያነ ሽምራታ።<verse eid="1CH 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 8:22"/>ሻሻቃ አደ ናይት ይሽጳና፥ ኤቤራ፥ ኤልኤላ፥ <verse eid="1CH 8:22"/><verse number="23" style="v" sid="1CH 8:23"/>አብዶና፥ ዝክራ፥ ሀናና፥ <verse eid="1CH 8:23"/><verse number="24" style="v" sid="1CH 8:24"/>ሀናንያ፥ ኤላማ፥ አንቶታ፥ <verse eid="1CH 8:24"/><verse number="25" style="v" sid="1CH 8:25"/>ይፍዳያነ ፓኑኤላ።<verse eid="1CH 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 8:26"/>ይሮሃማ አደ ናይት ሸምሽራያ፥ ሸሃራ፥ አታላ፥ <verse eid="1CH 8:26"/><verse number="27" style="v" sid="1CH 8:27"/>ያረሻ፥ ኤልይአሳነ ዝክራ።<verse eid="1CH 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 8:28"/>ሀይሳቲ ባንታ የለታን የሩሳላመን ኡትዳ ባንታ ሶ አሳ ሀላቃታ።<verse eid="1CH 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 8:29"/>ጋባኦና አዋይ ይኤል ጋባኦና ካታማን ደእስ፤ እያ ማቸ ሱንይ ማእኮ። <verse eid="1CH 8:29"/><verse number="30" style="v" sid="1CH 8:30"/>እያ ናኣ ባይራይ አብዶና፤ ሀራ እያ አደ ናይት ፁራያ፥ ቂሳ፥ ባኣላ፥ ኔራነ ናዳባ፥ <verse eid="1CH 8:30"/><verse number="31" style="v" sid="1CH 8:31"/>ገዶራ፥ አህያ፥ ዘከራነ <verse eid="1CH 8:31"/><verse number="32" style="v" sid="1CH 8:32"/>ማቅሎታ። ማቅሎት ሽምአ የልስ። ሀይሳቲ የሩሳላመን ደእያ ባንታ ዳቦታ ማታን ደእዶሶና።<verse eid="1CH 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 8:33"/>ኔር ቂሳ የልስ፤ ቂስ ሳኦላ የልስ። ሳኦል ዮናታና፥ ማልክሳ፥ አብናዳበነ አስባኤላ የልስ። <verse eid="1CH 8:33"/><verse number="34" style="v" sid="1CH 8:34"/>ዮናታና ናአይ ማርባኣላ የልስ፤ ማርባኣል ምክያሳ የልስ።<verse eid="1CH 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 8:35"/>ምክያሳ አደ ናይት ፕቶና፥ መለካ፥ ታረአነ አካዛ። <verse eid="1CH 8:35"/><verse number="36" style="v" sid="1CH 8:36"/>አካዝ ያሆአዳ የልስ። ያሆኣድ አለሜታ፥ አዝማወታነ ዝምራ የልስ። ዝምር ሞፃ የልስ፤ <verse eid="1CH 8:36"/><verse number="37" style="v" sid="1CH 8:37"/>ሞፅ ብንአ የልስ፤ ብንእ ራፋ የልስ፤ ራፍ ኤልኣሳ የልስ፤ ኤልኣስ አፄላ የልስ።<verse eid="1CH 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 8:38"/>አፄላስ ኡሱፑን አደ ናይት ደኦሶና። ኤንታ ሱንይ አዝርቃማ፥ ቦኬራ፥ እስማኤላ፥ ሻኣራ፥ አብድዩነ ሀናና።<verse eid="1CH 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 8:39"/>አፄላ እሻ ኤሸቃስ ሄ ናይት ደኦሶና። እያ ናአይ ባይራይ ኡላማ፤ ካሎይ ይኡሳ፤ ሄንይ ኤልፋላፃ።<verse eid="1CH 8:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 8:40"/>ኡላማ ናይት ዎልቃማነ ምኖ አስ፤ ኤንቲ ዶንገን ዱከይሳታ። ኡላማስ ፄታነ እሻታሙ ግድያ ናይትነ ናይታ ናይት ደኦሶና።</para>
  <para style="p" vid="1CH 8:40">ሀይሳቲ ኡባይ ብንያመ ኮቻታ።<verse eid="1CH 8:40"/></para>
  <chapter eid="1CH 8"/>
  <chapter number="9" style="c" sid="1CH 9"/>
  <para style="s1">የሩሳላመን ደእያ አሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1"/>እስራኤለ አሳ ኡባይ ባ የለታን የለታን፥ እስራኤለ ካዎታ ማፃፋን ፃፈትድ ደኤስ።</para>
  <para style="p" vid="1CH 9:1">ይሁዳ አሳይ ጎዳስ አማነትቦና ግሾ ባብሎነ ቢታ ድኤትድ ብዶሶና። <verse eid="1CH 9:1"/><verse number="2" style="v" sid="1CH 9:2"/>ኮይሮ ስሚድ ባንታ ቢታንነ ባንታ ካታማታን ኡትዳይ ጉ እስራኤለ አሳታ፥ ካህነታ፥ ሌወታነ ፆሳ ኬ ኦሳንቾታ። <verse eid="1CH 9:2"/><verse number="3" style="v" sid="1CH 9:3"/>ይሁዳፐ፥ ብንያመፐ፥ ኤፍሬማፐነ ምናሰፐ ጉ አሳት ይድ የሩሳላመን ደእዶሶና።<verse eid="1CH 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 9:4"/>ይሁዳ ናኣ ፓረሳ ያራፐ ኡታይ የሩሳላመን ደኤይሳታስ ሀላቃ። ኡታይ አምሁዳ ናአ፤ አምሁድ ኦምራ ናአ፤ ኦምር እምራ ናአ፤ እምር ባና ናአ።<verse eid="1CH 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 9:5"/>ይሁዳ ናኣ ሴላ ያራፐ አሳይነ እያ ናይት የሩሳላመን ደኤይሳታስ ሀላቃ።<verse eid="1CH 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 9:6"/>ይሁዳ ናኣ ዛራ ያራፐ ይኡኤል የሩሳላመን ደኤይሳታስ ሀላቃ።</para>
  <para style="p" vid="1CH 9:6">ይሁዳ ኮቻ ታይቦይ ኡሱፑን ፄታነ ኡዱፉን ታማ።<verse eid="1CH 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 9:7"/>ብንያመ ያራ ሀላቃት ሀይሳፈ ካልድ ፃፈትዳይሳታ።</para>
  <para style="p" vid="1CH 9:7">ማሱላማ ናኣ ሳሉ፥ ሆዳዋ ናኣ ማሱላማ፥ ሀሰናኡ ናኣ ሆዳዋ፥ <verse eid="1CH 9:7"/><verse number="8" style="v" sid="1CH 9:8"/>ይሮሃማ ናኣ ይብናያ፥ ኦዛ ናኣ ኤላ፥ ምክራ ናኣ ኦዛ፥ ሳፋፃ ማሱላማ፥ ራኡላ ናኣ ሳፋፃ፥ ይብና ናኣ ራጉኤላ። <verse eid="1CH 9:8"/><verse number="9" style="v" sid="1CH 9:9"/>ብንያመ ኮቻ ታይቦይ ኡዱፉን ፄታነ እሻታማነ ኡሱፑና። ሀይሳቲ ኡባይ ባንታ ሶ አሳ ሀላቃታ።<verse eid="1CH 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 9:10"/>የሩሳላመን ደእዳ ካህነት ሀይሳፈ ካልድ ፃፈትዳይሳታ።</para>
  <para style="p" vid="1CH 9:10">ኤንቲ ዮዳሀ፥ ዮራባ፥ ያክናነ <verse eid="1CH 9:10"/><verse number="11" style="v" sid="1CH 9:11"/>ፆሳ ኬን አዋትያ አዛርያሳ። አዛርያስ ካልቀ ናአ፤ ካልቀይ ማሱላማ ናአ፤ ማሱላም ሳዶቃ ናአ፤ ሳዶቅ ማርዮታ ናአ፤ ማርዮት አክፆባ ናአ።<verse eid="1CH 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 9:12"/>ሀራት ቃስ ይሮሃማ ናኣ አዳያነ አድኤላ ናኣ ማእሰያ። ይሮሃም ፓስኮራ ናአ፤ ፓስኮር ማልክያ ናአ። አድኤል ያህዜራ ናአ፤ ያህዜር ማሱላማ ናአ፤ ማሱላም ማሽልሞታ ናአ፤ ማሽልሞት እመራ ናአ።<verse eid="1CH 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 9:13"/>ባንታ ሶ አሳስ ሀላቃ ግድዳ ካህነታ ታይቦይ 1,760. ሀይሳቲ ፆሳ ኬን ኦናዉ ዳንዳእያ አሳታ።<verse eid="1CH 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 9:14"/>የሩሳላመን ደእያ ሌወት ሀይሳፈ ካልድ ፃፈትዳይሳታ።</para>
  <para style="p" vid="1CH 9:14">ሀሹባ ናአይ ሻማየይ ማራራ ያራ። ሀሹብ አዝርቃማ ናአ፤ አዝርቃም ሀሳባያ ናአ።<verse eid="1CH 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 9:15"/>ሀራት ቃስ ባቅባቃራ፥ ሄሬሳ፥ ጋላላነ ማታና። ማታን ምካ ናአ፤ ምክ ዝክራ ናአ፤ ዝክር አሳፋ ናአ።<verse eid="1CH 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 9:16"/>ሀራት ቃስ ናፆፋታ ጉታን ኡትዳይ አብድዩነ ባራካ። አብድዩይ ሻማእያ ናአ፤ ሻማኤይ ጋላላ ናአ፤ ጋላል የዱቱና ናአ፤ ባራክ አሳ ናአ፤ አስ ኤልቃና ናአ።<verse eid="1CH 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17"/>ካዎ ፐንግያ ናገይሳት፥ ሳሉማ፥ አቁባ፥ ታልሞና፥ አህማናነ ኤንታ እሻታ፤ ሳሉም ኤንታ ሀላቃ። <verse eid="1CH 9:17"/><verse number="18" style="v" sid="1CH 9:18"/>ኤንቲ ዉሎሀ ባጋራ ደእያ፥ ካዎ ፐንግያ ናግዶሶና። ሀይሳፈ ካሰ ኤንቲ ሌወት ዱንካንዳ ጉታ ናጎሶና።<verse eid="1CH 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 9:19"/>አብሳፋ ናኣ ናአይ ቆረ ናአይ ሳሉም ቆረ ያራ። ቆረ ያራይ ካሰ ጎዳ ዱንካንያ ናግዳይሳዳ ሳሉምነ ቆረ ኮቸ ግድዳ እያ ዳቦት ፆሳ ኬ ፐንግያ ናጎሶና።<verse eid="1CH 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 9:20"/>አላዛራ ናአይ ፕንሃስ ካሰ ቆረ ያራ ሀላቃ፤ ጎዳይ እያራ ደኤስ።<verse eid="1CH 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 9:21"/>ማሱላማ ናአይ ዛካርያስ ዱንካንያ ግዶ ገልያ ፐንግያ ናጌስ።<verse eid="1CH 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22"/>ፐንግያ ናጋናዉ ዶረትዳይሳት ኩመ ናምኡ ፄታነ ታማነ ናምአ፤ ሄሳት ባንታ ጉታን ጉታን ታይበትድ ፃፈትዶሶና። ኤንታ ያራስ ሀ አዋተ እምዳይ ካዋ ዳዊታነ ናብያ ሳሜላ። <verse eid="1CH 9:22"/><verse number="23" style="v" sid="1CH 9:23"/>ሄሳ ግሾ፥ ኤንትነ ኤንታ ናይት ፆሳ ኬ ፐንግያ ናጎሶና። <verse eid="1CH 9:23"/><verse number="24" style="v" sid="1CH 9:24"/>ኦይዱ ባጋራ ዶሎሀን፥ ዉሎሀን፥ ፑደሀን ዱገሀን እስ እስ ፐንገይ ደኤስ፤ ሄ ፐንገታ ናገይሳት ደኦሶና። <verse eid="1CH 9:24"/><verse number="25" style="v" sid="1CH 9:25"/>ሄ ጉታን ደእያ ኤንታ ዳቦት ላፑን ጋላሳን ጋላሳን ላመትድ፥ ናግድ ኤንታ ማዶሶና።<verse eid="1CH 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 9:26"/>ፐንግያ ናግያ ኦይዱ ሌወት ሀላቃ፤ ኤንቲ ፆሳ ኬ ክፍለታነ ክፍለታ ግዶን ደእያ ሚሸታ አዋተን አይሶሶና። <verse eid="1CH 9:26"/><verse number="27" style="v" sid="1CH 9:27"/>ፆሳ ኬ ናገይነ ዎንታ ጉራ ካርያ ዶየይ ኤንታ ግድያ ግሾ ያን አቆሶና።<verse eid="1CH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28"/>ሌወታፐ ጉት ጎይኖ ዎደ ጎኤትያ ሚሸታ ናጎሶና፤ ሄ ሚሸታ ካረ ከሰይነ ሶ ገልሰይ ኤንታ። <verse eid="1CH 9:28"/><verse number="29" style="v" sid="1CH 9:29"/>ኤንታፈ እሶት እሶት ፆሳ ኬን ጎኤትያ ሀራ ሚሸታ፥ ለ፥ ዎይነ ኡሹ፥ ዛይተ፥ እፃነነ ሳዎታ አዋተን አይሶሶና። <verse eid="1CH 9:29"/><verse number="30" style="v" sid="1CH 9:30"/>ሽን ካህነታ ናይታፐ ባጋት ሳዉዋ ዋላኮሶና።<verse eid="1CH 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 9:31"/>ቆረ ኮቻፈ ሳሉማ ባይራ ናአይ ማታታስ ያርሾ ኡይ ኡክስያ አዋተ ደኤስ። <verse eid="1CH 9:31"/><verse number="32" style="v" sid="1CH 9:32"/>ቃሃታ ያራ ግድያ ኤንታ ዳቦታፐ ባጋት ሳምባታን ሳምባታን ፃርጴዛ ቦላ ዎያ ኡይ ጊግስያ አዋተ ኤክዶሶና።<verse eid="1CH 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33"/>ሌወ ኮቻፈ ጉ ሀላቃት ፆሳ ኬን የፀይሳታ። ቃማነ ጋላስ ኤንቲ ኦያ ግሾ ሀራ ኦሶ ኦና ፆሳ ኬ ድርሳ ግዶን ደእያ ኬታን ደኦሶና።<verse eid="1CH 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34"/>ሀይሳቲ ኡባይ ሌወ ሶ አሳ ሀላቃታ፤ ኤንቲ የሩሳላመን ደእዶሶና።<verse eid="1CH 9:34"/></para>
  <para style="s1">ካዋ ሳኦላ ሼሽ</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35"/>ጋባኦና አዋይ ይኤል ጋባኦና ካታማን ደእስ፤ እያ ማቸ ሱንይ ማእኮ። <verse eid="1CH 9:35"/><verse number="36" style="v" sid="1CH 9:36"/>እያ ናአይ ባይራይ አብዶና፤ እያ ናይት ሀራት ፁራያ፥ ቂሳ፥ ባኣላ፥ ኔራ፥ ናዳባ፥ <verse eid="1CH 9:36"/><verse number="37" style="v" sid="1CH 9:37"/>ጋዶራ፥ አህያ፥ ዛካርያሳነ ምክሎታ። <verse eid="1CH 9:37"/><verse number="38" style="v" sid="1CH 9:38"/>ምክሎት ስምአ የልስ። ሀይሳቲ የሩሳላመን ደእያ ባንታ ዳቦታ ማታን ደእዶሶና።<verse eid="1CH 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 9:39"/>ኔር ቂሳ የልስ፤ ቂስ ሳኦላ የልስ። ሳኦል ዮናታና፥ ማልክሳ፥ አብናዳበነ ኤሽባኣላ የልስ። <verse eid="1CH 9:39"/><verse number="40" style="v" sid="1CH 9:40"/>ዮናታና ናአይ ማርባኣላ የልስ፤ ማርባኣል ምክያሳ የልስ።<verse eid="1CH 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 9:41"/>ምክያሳ ናይት ፕቶና፥ መለካ፥ ታረአነ አካዛ። <verse eid="1CH 9:41"/><verse number="42" style="v" sid="1CH 9:42"/>አካዝ ያእራ የልስ። ያእር አለሜታ፥ አዝማወታነ ዝምራ የልስ። ዝምር ሞፃ የልስ፤ <verse eid="1CH 9:42"/><verse number="43" style="v" sid="1CH 9:43"/>ሞፅ ብንአ የልስ፤ ብንእ ራፋያ የልስ፤ ራፋይ ኤልኣሳ የልስ፤ ኤልኣስ አፄላ የልስ።<verse eid="1CH 9:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 9:44"/>አፄላስ ኡሱፑን አደ ናይት ደኦሶና። ኤንታ ሱንይ አዝርቃማ፥ ቦኬራ፥ እስማኤላ፥ ሻኣራ፥ አብድዩነ ሀናና።<verse eid="1CH 9:44"/></para>
  <chapter eid="1CH 9"/>
  <chapter number="10" style="c" sid="1CH 10"/>
  <para style="s1">ካዋ ሳኦላ ሀይቁዋ</para>
  <para style="r">(<ref loc="1SA 31:1-13">1 ሳሜ 31:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1"/>ፍልስፄመት እስራኤለ አሳራ ኦለትዶሶና። እስራኤለት ፍልስፄመታ ስንፈ ባቃትዶሶና። ሄ ዎደ ዳሮ እስራኤለ አሳይ ግልቦአ ደርያ ቦላ ሀይቅዶሶና። <verse eid="1CH 10:1"/><verse number="2" style="v" sid="1CH 10:2"/>ፍልስፄመት ሳኦላነ እያ አደ ናይታ ጎድ ኤፍድ ሳኦላ ናይታ ዮናታና፥ አብናዳባነ ማልክሳ ዎዶሶና። <verse eid="1CH 10:2"/><verse number="3" style="v" sid="1CH 10:3"/>ኦላይ ሳኦላ ተቅድ ኡንኤስ፤ ዶንገን ዱከይሳት ሳኦላ ደምድ ማዱንፅስዶሶና።<verse eid="1CH 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4"/>ሳኦል ባ ኦላ ሚሽያ ቶከይሳኮ፥ “ሀ ቃፃረትቦና ፍልስፄመት ታና ካኦና መላ ነ ማሻን ታና ዎ” ያግስ።</para>
  <para style="p" vid="1CH 10:4">ሽን እያ ኦላ ሚሽያ ቶከይስ ዳሮ ያይዳ ግሾ እፅስ፤ ሄሳ ግሾ፥ ሳኦል ባ ማሻ ሳአን ኤስድ እያ ቦላ ኩንድድ ሀይቅስ። <verse eid="1CH 10:4"/><verse number="5" style="v" sid="1CH 10:5"/>እያ ኦላ ሚሽያ ቶከይስ ሳኦል ሀይቅዳይሳ በእድ፥ እካ ባ ማሻ ሳአን ኤስድ እያ ቦላ ኩንድድ ሀይቅስ። <verse eid="1CH 10:5"/><verse number="6" style="v" sid="1CH 10:6"/>ሄሳዳ ሀንድ ሳኦል፥ እያ ሄ ናይትነ እያ ሶ አሳ ኡባይ ሄ ጋላስ ሀይቅዶሶና። <verse eid="1CH 10:6"/><verse number="7" style="v" sid="1CH 10:7"/>ዛንጋራን ደእያ እስራኤለት ኡባይ ባንታ ኦላንቾት ባቃትዳይሳ፥ ሳኦልነ እያ ናይት ሀይቅዳይሳ በእዳ ዎደ ባንታ ካታማታ አግድ ባቃትዶሶና። ፍልስፄመት ይድ ሄ ካታማታን ደእዶሶና።<verse eid="1CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8"/>ዎንተ ጋላስ ፍልስፄመት አሀታ ቦላፈ ኦላ ሚሸታ ቃር ኤካናዉ ይድ፥ ሳኦልነ እያ ናይት ግልቦአ ደርያን ሀይቅድ፥ ዝንእዳይሳታ ደምዶሶና። <verse eid="1CH 10:8"/><verse number="9" style="v" sid="1CH 10:9"/>ኤንቲ ሳኦላ ቆያ ቃንፅድ እያ ኦላ ሚሽያ ቃር ኤክዶሶና። ያትድ ባንታ ኤቃታ ኬንነ ባንታ አሳ ግዶን ፆኑዋ አዋጃና መላ ፍልስፄመ ቢታ ኡባስ አሰ ኪትዶሶና። <verse eid="1CH 10:9"/><verse number="10" style="v" sid="1CH 10:10"/>ኤንቲ ሳኦላ ኦላ ሚሽያ ባንታ ፆሳታ ኬታፐ እሱዋን ዎዶሶና፤ እያ ሁጵያ ባንታ ፆሳ ዳጎና ኤቃ ኬን ካቅዶሶና።<verse eid="1CH 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11"/>ፍልስፄመት ሳኦላ ቦላ ኦዳባ ኡባ ጋላዳን ደእያ ያበሳ ካታማ አሳይ ስእዳ ዎደ፥ <verse eid="1CH 10:11"/><verse number="12" style="v" sid="1CH 10:12"/>ምኖ አሳት ኡባይ ብድ፥ ሳኦላ አሃነ እያ ናይታ አሀ ኤክድ ያበሳ ካታማ ኤህዶሶና። ያበሳን ደእያ ዎላ ጋርሳን ኤንታ ሞግዶሶና፤ ያትድ ላፑን ጋላስ ፆምዶሶና።<verse eid="1CH 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13"/>ሳኦል ጎዳስ አማነትቦና ግሾ ሀይቅስ። ጎዳ ቃላ እ ናግቤና፤ ጎዳ ዞረ ኦይቸይሳ አግድ፥ <verse eid="1CH 10:13"/><verse number="14" style="v" sid="1CH 10:14"/>ሞይትለ ፄግያ አስ ዞረ ኦይችስ። ሄሳ ግሾ፥ ጎዳይ እያ ዎድ እያ ካዎተ እሰየ ናኣ ዳዊታስ አድ እሚስ።<verse eid="1CH 10:14"/></para>
  <chapter eid="1CH 10"/>
  <chapter number="11" style="c" sid="1CH 11"/>
  <para style="s1">ዳዊቲ እስራኤለ ቦላ ካዎትስ</para>
  <para style="r">(<ref loc="1SA 5:1-10">1 ሳሜ 5:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1"/>ሄሳፈ ጉየ፥ እስራኤለ አሳ ኡባይ እስፈ ከብሮናን ደእያ ዳዊታኮ ብድ፥ “ኑኒ ነ ሱነ ነ አሾ። <verse eid="1CH 11:1"/><verse number="2" style="v" sid="1CH 11:2"/>ካሰ ሳኦል ካዎ ግድድ ደእያ ዎደካ፥ እስራኤለ አሳ ኦላስ ካለዳይ ነና። ጎዳይ ነ ፆሳይ፥ ‘ታ አሳ እስራኤለ ኔኒ ሄማና፤ ኤንታ ቦላ ኔኒ ካዎታና’ ” ያግስ። <verse eid="1CH 11:2"/><verse number="3" style="v" sid="1CH 11:3"/>እስራኤለ ጭማት ኡባይ ካዋ ዳዊታኮ ይዳ ዎደ እ ኤንታራ ከብሮናን ጎዳ ስንን ጫቅስ። ጎዳይ ሳሜላ ባጋራ ኦድዳ ቃላዳ ዳዊቲ እስራኤለ ቦላ ካዎታናዳ ኤንቲ እያ ትይዶሶና።<verse eid="1CH 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4"/>ዳዊቲነ እስራኤለ አሳ ኡባይ የሩሳላመ ካታማ ብዶሶና። ሄ ዎደ ያቡሰ አሳይ ሄ በሳን ደእያ ግሾ ሄ ካታማይ ያቡሰ ጌተቴስ። <verse eid="1CH 11:4"/><verse number="5" style="v" sid="1CH 11:5"/>ያቡሰት ዳዊታኮ፥ “ኔኒ ሀ ካታማ ገላናዉ ዳንዳአካ” ያግዶሶና። ግዶሽን፥ ዳዊቲ ፅዮነን ደእያ ኤንታ ሚፃ ኦይክን፥ ፅዮነይ ዳዊቲ ካታማ ጌተትስ። <verse eid="1CH 11:5"/><verse number="6" style="v" sid="1CH 11:6"/>ዳዊቲ ባ ኦላንቾታ፥ “ያቡሰታ ኮይሮትድ ኦልያ ኦንካ ቶራ ሞጮና ግዳና” ያግስ። ፃሩያ ናአይ እዮኣብ ኮይሮትድ ኦልድ ሀላቃ ግድስ። <verse eid="1CH 11:6"/><verse number="7" style="v" sid="1CH 11:7"/>ዳዊቲ ሄ ሚፃን ደእዳ ግሾ ሄ ካታማይ ዳዊታ ካታማ ጌተትስ።<verse eid="1CH 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 11:8"/>ዳዊቲ ሚሎፐ ዶምድ ሄ ካታማ ዛሪድ ኬፅስ፤ አትዳ ባጋ እዮኣብ ዛሪድ ኬፅስ። <verse eid="1CH 11:8"/><verse number="9" style="v" sid="1CH 11:9"/>ኡባፈ ዎልቃማ ጎዳይ እያራ ደእያ ግሾ ዳዊቲ ምን ምን ብስ።<verse eid="1CH 11:9"/></para>
  <para style="s1">ምኖ ግድዳ ዳዊታ አሳታ</para>
  <para style="r">(<ref loc="2SA 23:8-39">2 ሳሜ 23:8-39</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10"/>ምኖ ግድዳ ዳዊታ አሳት ሀይሳፈ ካልድ ፃፈትዶሶና። ጎዳይ እስራኤለስ ግዳ ቃላዳ ዳዊቲ ካዎታና መላ ሀ አሳት እስራኤለ አሳራ ዳሮ ማድዶሶና። ቃስ እያ ካዎተ ምንዶሶና።<verse eid="1CH 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 11:11"/>ምኖ ግድዳ ዳዊተ አሳት ሀይሳፈ ካልድ ደኤይሳታ። ኤንታፈ ሄት ዳሮ ኤረትዳይሳታ። ሄታፐ ኮይሮይ ሀክሞና አድያ ያሾብኣማ፤ እ እስ ቶሆ ኦላን ሄ ፄቱ አሳ ባ ቶራን ዎስ። <verse eid="1CH 11:11"/><verse number="12" style="v" sid="1CH 11:12"/>እያ ካለይ፥ ሄ ምኖ አሳታፐ እሶይ አሆሀ አድያ ዶዳ ናአ አላዛራ። <verse eid="1CH 11:12"/><verse number="13" style="v" sid="1CH 11:13"/>ፍልስፄመ አሳይ ኦለታናዉ ፓስዳምማ ጌተትያ በሳ ሺቅዳ ዎደ አላዛር ዳዊታራ ደኤስ። እስራኤለ ኦላንቾት ፍልስፄመ አሳታ ስንፈ ባቃትያ ዎደ አላዛር ባንጋ ጋደን ደኤስ። <verse eid="1CH 11:13"/><verse number="14" style="v" sid="1CH 11:14"/>እነ እያ አሳት ጋድያ ግዶን ፍልስፄመ አሳራ ኦለትን፥ ጎዳይ ግታ ፆኖ እምድ ኤንታ አሽስ።<verse eid="1CH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15"/>ፍልስፄመ ኦላንቾት ራፋይመ ዛንጋራን ዱንካንዳ ዎደ ሀስታሙ ሀላቃታፐ ሄት ዳዊቲ ደእያ አዱላማ ጎንጎሉዋን ደእያ ዛላኮ ብዶሶና። <verse eid="1CH 11:15"/><verse number="16" style="v" sid="1CH 11:16"/>ሄ ዎደ ዳዊቲ ሚፃን ደኤስ፤ ፍልስፄመ ኦላንቾታፐ እስ ጩጋይ ቤተለመ ኦልድ ኦይክስ። <verse eid="1CH 11:16"/><verse number="17" style="v" sid="1CH 11:17"/>ዳዊቲ ሃ ኡያናዉ አሞትድ፥ “ቤተለመ ፐንግያ ማታን ደእያ ፑልቶ ሃፈ ታና ኡሻናይ ኦነ!” ያግስ። <verse eid="1CH 11:17"/><verse number="18" style="v" sid="1CH 11:18"/>ሄ ምኖ አሳት ፍልስፄመት ዱንካንዳ በሳ ካን ብድ ቤተለመ ፐንግያ ማታን ደእያ ፑልቶ ሃፈ ዱቅድ ዳዊታስ ኤህዶሶና። ሽን ዳዊቲ ኡዮና እፅድ ሃ ጎዳ ስንን ትግስ። <verse eid="1CH 11:18"/><verse number="19" style="v" sid="1CH 11:19"/>“ሀ ሃ ኡሽ ታፐ ሃኮ! ባንታ ሸምፑዋ ባይዝድ ኤህዳ ሀ አሳታ ሱ ታኒ ኡዮ? ኤንቲ ባንታ ሸምፑዋ አድ እምድ ኤህዶሶና” ያግስ። ሄሳ ግሾ፥ ዳዊቲ ሃ ኡይቤና። ሄ ምኖ አሳት ሄሳ ኦዶሶና።<verse eid="1CH 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20"/>እዮኣባ እሻይ አብስ ሀስታሙ ኦላንቾታስ ሀላቃ። እ ባ ቶራን ሄ ፄቱ አሳ ዎድ፥ እካ ሀ ሄታዳ ኤረትዳ አስ ግድስ። <verse eid="1CH 11:20"/><verse number="21" style="v" sid="1CH 11:21"/>አብስ ሄታራ ታይበቶና እፅኮካ፥ እ ሄታፐ አድ ቦንቸትዳ አስ፤ እ ኤንታዉ ሀላቃ ግድስ።<verse eid="1CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22"/>ቃብፄላ አደይ ዮዳሄ ናአይ ባናይ ምኖ አስ፤ እ ምኖ ኦሶ ኦስ። እ ናምኡ ኤረትዳ ሞአበ አሳታ ዎስ። ቃስ ሻች ዎዳ እስ ጋላስ ኦላ ግዶ ገልድ ጋሞ ዎስ። <verse eid="1CH 11:22"/><verse number="23" style="v" sid="1CH 11:23"/>ባናይ እቻሹ ዋ ግድያ ግብፀ አድያ ዎስ። ግብፀ አድያ ኩሸን ዋንዳራሸ መላ ቶር ደኤስ፤ ሽን ባናይ ፃምአ ኦይክድ አድያኮ ብድ እያ ኩሽያን ደእያ ቶራ ዳፍ ኤክድ እያ ቶራን እያ ዎስ። <verse eid="1CH 11:23"/><verse number="24" style="v" sid="1CH 11:24"/>ዮዳሄ ናአይ ባናይ ሀይሳ ኦስ። እያ ሱንይ ሄ ሄታይሳዳ ኤረትስ። <verse eid="1CH 11:24"/><verse number="25" style="v" sid="1CH 11:25"/>እ ሀስታማታ ግዶን ዳሮ ቦንቸትስ፤ ሽን እ ሄታ ታይቡዋን ዴና። ዳዊቲ እያ ባና ናገይሳታ ሀላቃ ኦስ።<verse eid="1CH 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26"/>ምኖ አሳት እዮኣባ እሻ አሳሄላ፥ ቤተለመ አድያ ዶዳ ናኣ ኤልያና፥ <verse eid="1CH 11:26"/><verse number="27" style="v" sid="1CH 11:27"/>ሀሮዳ አድያ ሳሞታ፥ ፕሎና አድያ ሰለሳ፥ <verse eid="1CH 11:27"/><verse number="28" style="v" sid="1CH 11:28"/>ተቁሄ አድያ ኤስካ ናኣ እራ፥ አናቶታ አድያ አብኤዘራ፥ <verse eid="1CH 11:28"/><verse number="29" style="v" sid="1CH 11:29"/>ኩሳታ አድያ ሳባካ፥ አሆሀ አድያ ኤላያ፥ <verse eid="1CH 11:29"/><verse number="30" style="v" sid="1CH 11:30"/>ናፆፋ አድያ ኖኤራነ ባናሀ ናኣ ሄለዳ፥ <verse eid="1CH 11:30"/><verse number="31" style="v" sid="1CH 11:31"/>ብንያመን ደእያ ግብአ አድያ ራባያ ናአ ኤታያ፥ ፕርአቶና አድያ ባናያሳ፥ <verse eid="1CH 11:31"/><verse number="32" style="v" sid="1CH 11:32"/>ጋኣሳ ዛንጋራ ማታፐ ይዳ ኡራያ፥ አራባ አድያ አብኤላ፥ <verse eid="1CH 11:32"/><verse number="33" style="v" sid="1CH 11:33"/>ባርሁማ አድያ አዝሞታ፥ ሳአልቦና አድያ አብኤላ፥ <verse eid="1CH 11:33"/><verse number="34" style="v" sid="1CH 11:34"/>ግዞና አድያ ሀሰማ፥ ሀራራ አድያ ሻገ ናአ ዮናታና፥ <verse eid="1CH 11:34"/><verse number="35" style="v" sid="1CH 11:35"/>ሀራራ አድያ ሳካራ ናአ አህኣማ፥ ኡረ ናኣ ኤልፋላ፥ <verse eid="1CH 11:35"/><verse number="36" style="v" sid="1CH 11:36"/>ማኬራ አድያ ሄፌራ፥ ፕሎና አድያ አክያ፥ <verse eid="1CH 11:36"/><verse number="37" style="v" sid="1CH 11:37"/>ቃርመሎሳ አድያ ሄፅራ፥ ኤዝባያ ናኣ ናእራያ፥ <verse eid="1CH 11:37"/><verse number="38" style="v" sid="1CH 11:38"/>ናታና እሻ እዩኤላ፥ ሀግራ ናኣ ምብሃራ፥ <verse eid="1CH 11:38"/><verse number="39" style="v" sid="1CH 11:39"/>አሞነ አድያ ፀለቃ፥ ፃሩያ ናኣ እዮኣባ ኦላ ሚሽያ ቶክያ ባኤሮታ አድያ ናህራያ፥ <verse eid="1CH 11:39"/><verse number="40" style="v" sid="1CH 11:40"/>ያትራ አድያ እራነ ጋሬባ፥ <verse eid="1CH 11:40"/><verse number="41" style="v" sid="1CH 11:41"/>ህተ አድያ ኦርዮና፥ አህላያ ናኣ ዛባዳ፥ <verse eid="1CH 11:41"/><verse number="42" style="v" sid="1CH 11:42"/>ሮቤላ ኮቸ ግድዳ ሺዛ ናኣ አድና። እ ሮቤላ ኮቻታ ሀላቃ፤ ሀስታማት እያራ እስፈ ደኦሶና። <verse eid="1CH 11:42"/><verse number="43" style="v" sid="1CH 11:43"/>ሀራ ምኖ አሳት ማእካ ናኣ ሀናና፥ ምታነ አድያ እዮሳፈፃ፥ <verse eid="1CH 11:43"/><verse number="44" style="v" sid="1CH 11:44"/>አስታሮታ አድያ ኦዝያና፥ አሮኤራ አድያ ሆታማ ናይታ ሻማአነ ይኤላ፥ <verse eid="1CH 11:44"/><verse number="45" style="v" sid="1CH 11:45"/>ሽምራ ናኣ ይድኤላነ እያ እሻ ቲፃ አድያ ዮሀ፥ <verse eid="1CH 11:45"/><verse number="46" style="v" sid="1CH 11:46"/>ማሃዋ አድያ ኤልኤላ፥ ኤልናማ ናይታ ይርባያነ ዮሻዋ፥ ሞአበ አድያ ይትማ፥ <verse eid="1CH 11:46"/><verse number="47" style="v" sid="1CH 11:47"/>ፆባ አድያ ኤልኤላ፥ ኦቤዳነ ያእስኤላ።<verse eid="1CH 11:47"/></para>
  <chapter eid="1CH 11"/>
  <chapter number="12" style="c" sid="1CH 12"/>
  <para style="s1">ዳዊታ ካልዳ ኦላንቾታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1"/>ዳዊቲ ቂሳ ናኣ ሳኦላፐ ባቃትድ ፅቅላጋን ኡትዳ ዎደ እያኮ ይዳ አሳት ሀይሳፈ ካልድ ፃፈትዳይሳታ። ኤንታ ካሰ ዳዊታ ኦላን ማድዳ ምኖ አሳታ ግዶን ደኦሶና። <verse eid="1CH 12:1"/><verse number="2" style="v" sid="1CH 12:2"/>ኤንቲ ዶንገን ዱከይሳታ፤ ቃስ ኡሻቻ ኩሸንነ ሀድርሳ ኩሸን ያምባራናዉነ ዶንገ ዱካናዉ ዳንዳኦሶና። ኤንቲ ብንያመ ኮቸ ግድዳ ሳኦላ ኮቻታ። <verse eid="1CH 12:2"/><verse number="3" style="v" sid="1CH 12:3"/>ኤንታ ሀላቃይ አህኤዘራ፤ እያፐ ካልድ እዮኣሳ፤ ኤንቲ ግብአ አድያ ሻማአ ናአ።</para>
  <para style="p" vid="1CH 12:3">ሀራት ቃስ አዝማወ ናይታ ግድዳ ይዝኤላነ ፓላፃ፥ ባራካ፥ አናቶተ አድያ እዩ፥ <verse eid="1CH 12:3"/><verse number="4" style="v" sid="1CH 12:4"/>ሀስታማታ ግዶን ዎልቃማ ግድድ፥ ኤንታ ካለያ ጋባኦና አድያ ይሽማእያ፥ ኤርምያሳ፥ ያሀዝኤላ፥ ዮሃና፥ ገዳራ አድያ ዮዛባታ፥ <verse eid="1CH 12:4"/><verse number="5" style="v" sid="1CH 12:5"/>ኤሉዛያ፥ ያርሞታ፥ ባላያ፥ ሳማራ፥ ሀርፋ አድያ ሳፋፃ፥ <verse eid="1CH 12:5"/><verse number="6" style="v" sid="1CH 12:6"/>ቆረ ኮቸ ግድዳ ኤልቃና፥ ይሽያ፥ አዛርኤላ፥ ዮኤዘራነ ያሾብኣማ፥ <verse eid="1CH 12:6"/><verse number="7" style="v" sid="1CH 12:7"/>ጋዶራ አድያ ይሮሃማ ናይታ ዮኤላነ ዛባዳ።<verse eid="1CH 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8"/>ዳዊቲ ባዞን ደእያ ሚፃን ደእሽን፥ ጋደ ኮቻፈ ጉ አሳት እያኮ ይዶሶና። ኤንቲ ምኖነ ኦላስ ጊግዳይሳታ፤ ጎንዳለነ ቶራ ኦይካናዉ ዳንዳኤይሳታ። ኤንታ ሶምኦይ ጋሞ ሶምኦ መላ፤ ኤንቲ ደረ ሁጰራ ጉፕያ ገንኤ መላ ኤሶቶሶና። <verse eid="1CH 12:8"/><verse number="9" style="v" sid="1CH 12:9"/>ኤንታ ሀላቃይ ኤፀራ፤ ናምአንይ አብድዩ፤ ሄንይ ኤልኣባ፤ <verse eid="1CH 12:9"/><verse number="10" style="v" sid="1CH 12:10"/>ኦይዳንይ ምስማና፤ እቻሻንይ ኤርምያሳ፤ <verse eid="1CH 12:10"/><verse number="11" style="v" sid="1CH 12:11"/>ኡሱፑንይ አታያ፤ ላፑንይ ኤልኤላ፤ <verse eid="1CH 12:11"/><verse number="12" style="v" sid="1CH 12:12"/>ሆስፑንይ ዮሃና፤ ኡዱፉንይ ኤልዛባዳ፤ <verse eid="1CH 12:12"/><verse number="13" style="v" sid="1CH 12:13"/>ታማንይ ኤርምያሳ፤ ታማነ እሳንይ ማክባናያ። <verse eid="1CH 12:13"/><verse number="14" style="v" sid="1CH 12:14"/>ሀይሳቲ ጋደ ኮቻ ኦላንቾታስ ሀላቃታ። ኤንታፈ ዝቃይ ማቶ ሀላቃ፤ ቃይ ቃስ ሻላቃ ግድስ። <verse eid="1CH 12:14"/><verse number="15" style="v" sid="1CH 12:15"/>ዮርዳኖሰ ሻፋይ፥ ጋፃፐ ጋፃ ጋክድ ክፅዳ ኮይሮ አጌናን ፕንዳይሳት ሀይሳታ። ኤንቲ ዛንጋራን ዶሎሀነ ዉሎሀ ባጋን ደእያ አሳ ኡባ የደዶሶና።<verse eid="1CH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16"/>ብንያመ ኮቻፈነ ይሁዳ ኮቻፈ ጉ አሳት ዳዊቲ ደእያ ሚፃ ብዶሶና። <verse eid="1CH 12:16"/><verse number="17" style="v" sid="1CH 12:17"/>ዳዊቲ ኤንታራ ጋሄታናዉ ከይድ፥ “ህንተ ታና ማዳናዉ ሳሮ ታኮ ይዳባ ግድኮ ታ ዎዛናይ ህንተራ ግዳና። ሽን ህንተ ታና ታ ሞርከታስ አድ እማናዉ ይዳባ ግድኮ፥ ህንተና ኤርተ! ታኒ ኦዳ ኢታባይ ባይና ግሾ ኑ አዋታ ፆሳይ ሄሳ በኦ፤ እ ህንተና ፕርዶ!” ያግስ።<verse eid="1CH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18"/>ሄሳፈ ጉየ፥ ሀስታማታ ሀላቃ አማሳያ ቦላ ፆሳ አያናይ ዎን፥</para>
  <para style="q1" vid="1CH 12:18">“ዳዊታ፥ ኑኒ ነይሳታ!</para>
  <para style="q2" vid="1CH 12:18">እሰየ ናአዉ፥ ኑኒ ኔራ ደኦስ!</para>
  <para style="q1" vid="1CH 12:18">ሳሮይ ነዉ ግዶ!</para>
  <para style="q2" vid="1CH 12:18">ነና ማደይሳታስ ሳሮይ ግዶ!</para>
  <para style="q1" vid="1CH 12:18">ነ ፆሳይ ነና ማዳና” ያግስ።</para>
  <para style="m" vid="1CH 12:18">ዳዊቲ ኤንታ ኤክድ ባ ኦላንቾታስ ሀላቃ ኦስ።<verse eid="1CH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19"/>ዳዊቲ ፍልስፄመታራ ግድድ ሳኦላ ኦላናዉ ብዳ ዎደ፥ ምናሰ ኮቻፈ ጉ አሳት ዳዊታራ ጋሄትዶሶና። ሽን ፍልስፄመታ ሀላቃት ዳዊቲነ ዳዊታ አሳይ ባንታራ ቦናዳ ድግዶሶና። ዳዊቲነ ዳዊታ አሳይ፥ ኤንታ ካዋ ሳኦላስ አድ እማነኮ ግድ ያይዳ ግሾ ፍልስፄመት ዞረትዳፐ ጉየ ኤንታ ጉየ ዛርዶሶና። <verse eid="1CH 12:19"/><verse number="20" style="v" sid="1CH 12:20"/>ዳዊቲ ፅቅላጋ ስምዳ ዎደ ምናሰ ኮቻፈ ዳዊታ ማዳናዉ ከይዳ አሳት አድና፥ ዮዛባታ፥ ይድኤላ፥ ምካኤላ፥ ዮዛባታ፥ ኤልሀነ ፅልታያ። ሀይሳቲ ካሰ ምናሰ ቢታን ሻላቃ። <verse eid="1CH 12:20"/><verse number="21" style="v" sid="1CH 12:21"/>ኤንቲ ኡባይ ምኖነ ዎልቃማ አስ ግድያ ግሾ ዳዊቲ ዙግድ ኦልያ አሳ ኦልድ እያ ማድዶሶና። <verse eid="1CH 12:21"/><verse number="22" style="v" sid="1CH 12:22"/>ዳዊቲ ኦላንቾት፥ ፆሳ ኦላንቾዳ ዳራና ጋካናዉ እያ ማድያ አሳይ ጋላስ ጋላስ ጉዠቴስ።<verse eid="1CH 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23"/>ጎዳይ እያዉ ግዳይሳዳ ሳኦላ ካዎተ ዳዊታኮ ዛራናዉ ዳንጨትድ ዳዊታኮ ከብሮና ብዳ ኦላንቾታ ታይቦይ ሀይሳፈ ካልድ ፃፈትዳይሳታ። <verse eid="1CH 12:23"/><verse number="24" style="v" sid="1CH 12:24"/>ጎንዳለነ ቶራ ኦይክድ ኦላስ ጊግዳ ይሁዳ ኮቻይ 6,800. <verse eid="1CH 12:24"/><verse number="25" style="v" sid="1CH 12:25"/>ስሞና ኮቻፈ ኦላስ ጊግዳ ምኖነ ዎልቃማ ኦላንቾት 7,100. <verse eid="1CH 12:25"/><verse number="26" style="v" sid="1CH 12:26"/>ሌወ ኮቻፈ 4,600. <verse eid="1CH 12:26"/><verse number="27" style="v" sid="1CH 12:27"/>አሮና ኮቻ ሀላቃይ ዮዳሄ፤ ዮዳሄራ እስፈ 3,700 አሳት ደኦሶና። <verse eid="1CH 12:27"/><verse number="28" style="v" sid="1CH 12:28"/>ሳዶቅ ናአተ፥ ምኖነ ዎልቃማ አስ፤ ሳዶቃ ሶ አሳፐ ላታማነ ናምኡ ሀላቃት እያራ ደኦሶና። <verse eid="1CH 12:28"/><verse number="29" style="v" sid="1CH 12:29"/>ብንያመ ኮቸ ግድዳ ሳኦላ ዳቦት 3,000. ሽን ብንያመ ኮቻፈ ዳርያ ባጋይ ሳኦላ ሶ አሳስ ሄ ዎደ ጋካናዉ አማነትዶሶና። <verse eid="1CH 12:29"/><verse number="30" style="v" sid="1CH 12:30"/>ኤፍሬማ ኮቻፈ ባንታ ሶ አሳን ኤረትዳ ምኖነ ዎልቃማ አሳት 20,800. <verse eid="1CH 12:30"/><verse number="31" style="v" sid="1CH 12:31"/>ዳዊታ ካዎያናዉ ባናዉ ዶረትዳ ምናሰ ኮቻፈ ባጋት 18,000. <verse eid="1CH 12:31"/><verse number="32" style="v" sid="1CH 12:32"/>እስራኤለ አሳይ አይ ኦናዉ በሲያኮ ዎድያባ ሻክድ ኤርያ አኬካንቾ አሳት፥ ይሳኮራ ኮቻ ሀላቃት፥ ናምኡ ፄታ፤ ኤንታ ዳቦት ኡባይ ኤንታዉ ኪተቶሶና። <verse eid="1CH 12:32"/><verse number="33" style="v" sid="1CH 12:33"/>ኦላ ሚሸ ኡባ ኦይክድ ባንታ ኩመ ዎዛናን ዳዊታ ማዳናዉ ጊግዳ ኦላንቾታን ዛብሎና ኮቻይ 50,000. <verse eid="1CH 12:33"/><verse number="34" style="v" sid="1CH 12:34"/>ንፍታለመ ኮቻፈ 1,000 ሀላቃትነ ጎንዳለነ ቶራ ኦይክያ 37,000 አሳት ኤንታራ ደኦሶና። <verse eid="1CH 12:34"/><verse number="35" style="v" sid="1CH 12:35"/>ዳነ ኮቻፈ ኦላስ ጊግዳ አሳት 28,600. <verse eid="1CH 12:35"/><verse number="36" style="v" sid="1CH 12:36"/>ኦላስ ከያናዉ አሴራ ኮቻፈ ጊግዳ አሳት 40,000. <verse eid="1CH 12:36"/><verse number="37" style="v" sid="1CH 12:37"/>ዮርዳኖሰ ሻፋፐ ሄፍን ዶሎሀ ባጋን ደእያ ሮቤላ ኮቻፈ ጋደ ኮቻፈነ ምናሰ ኮቸ ባጋፈ ኦላ ሚሸ ኡባ ኦይክድ ይዳ አሳት 120,000.<verse eid="1CH 12:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38"/>ሀ ኡባ ኦላንቾት ዳዊታ እስራኤለ ቦላ ካዎናዉ ባንታ ቆፋ ቃችድ፥ ከብሮና ካታማ ይዶሶና። ቃስ እስራኤለፐ አትዳይሳት ዳዊታ ካዎናዉ እስ ዎዛናን ግድዶሶና። <verse eid="1CH 12:38"/><verse number="39" style="v" sid="1CH 12:39"/>ኤንታ ዳቦት ኤንታዉ ኮሽያባ ጊግስዳ ግሾ ምሸነ ኡይሸ ዳዊታራ ሄ ጋላስ ኡትዶሶና። <verse eid="1CH 12:39"/><verse number="40" style="v" sid="1CH 12:40"/>እስራኤለ አሳስ ኡፋይስ ግድያ ግሾ፥ ፑደሀ ባጋን ደእያ ይሳኮራፐ፥ ዛብሎናፐነ ንፍታለመፐ ዳሮ አሳይ ለ፥ ባላሰ ኑካ፥ ዎይነ ቴራ፥ ዎይነ ኡሹነ ዛይተ ሀረን፥ ባቁሎን፥ ግማለንነ ቦራን ጫንድ ኤህዶሶና፤ ቃስ ኤንቲ መሄነ ዶርሰ ሹክድ ማናዉ ኤህዶሶና።<verse eid="1CH 12:40"/></para>
  <chapter eid="1CH 12"/>
  <chapter number="13" style="c" sid="1CH 13"/>
  <para style="s1">ታቦተይ እስራኤለ ስምስ</para>
  <para style="r">(<ref loc="2SA 6:1-11">2 ሳሜ 6:1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1"/>ዳዊቲ ሻላቃታራነ ማቶ ሀላቃታራ ዞረትስ። <verse eid="1CH 13:1"/><verse number="2" style="v" sid="1CH 13:2"/>እስራኤለ አሳ ኡባ፥ “ህንተዉ ሎኦ ዳንያባ ግድኮነ ጎዳ ኑ ፆሳ ሸነ ግድኮ፥ እስራኤለ ቢታ ጋፃን ደእያ ኑ ዳቦት፥ ሄሳዳካ ባንታ ካታማታንነ ሄን በሳታን ደእያ ካህነትነ ሌወት ኑኮ ሺቃና መላ አሰ ኪቶስ። <verse eid="1CH 13:2"/><verse number="3" style="v" sid="1CH 13:3"/>ሳኦላ ካዎተ ዎደ ቀል ጌተትዳ ኑ ፆሳ ታቦትያ አነ ዛሪድ ኤሆስ” ያግስ። <verse eid="1CH 13:3"/><verse number="4" style="v" sid="1CH 13:4"/>ዳዊታ ኦዳይ ሎኦ ግድዳ ግሾ አሳ ኡባይ ማእስ።<verse eid="1CH 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5"/>ሄሳ ግሾ፥ ዳዊቲ ፆሳ ታቦትያ ቅርያት-ይኣርመፐ ኤሀና መላ ግብፀ ዛዋፐ ዶምድ ሀማታ ፕኖ ጋካናዉ ደእያ እስራኤለ አሳ ኡባ ሺሽስ። <verse eid="1CH 13:5"/><verse number="6" style="v" sid="1CH 13:6"/>ዳዊቲነ እስራኤለ አሳ ኡባይ ክሩበታፐ ግዶን ባ አራታ ቦላ ኡትዳ ጎዳ ሱንይ ፄገትዳ ፆሳ ታቦትያ ኤሀናዉ ይሁዳ ቢታን ደእያ ባላ ጌተትያ ቅርያት-ይኣርማ ብዶሶና። <verse eid="1CH 13:6"/><verse number="7" style="v" sid="1CH 13:7"/>ፆሳ ታቦትያ ኦራ ፓራ ጋረን ዎድ፥ አምናዳበ ሶፐ ኤህዶሶና፤ ኦዝነ አህዮይ ጋርያ ላጎሶና። <verse eid="1CH 13:7"/><verse number="8" style="v" sid="1CH 13:8"/>ዳዊቲነ እስራኤለ አሳ ኡባይ ዲነ ማስንቆ ካእሸ፥ ካራቦ ባቅሸ፥ ዳላ ጊርስሸ፥ ዛየ ፑንሸ ባንታ ኩመ ዎልቃን ፆሳ ስንን ኡፋይትድ፥ የፅሸ ፆሳ ቦንችዶሶና።<verse eid="1CH 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9"/>ኤንቲ ክዶና ዉዱማ ጋክያ ዎደ ቦራት በትዳ ግሾ ኦዝ ታቦትያ ኦይካናዉ ባ ኩሽያ የድስ። <verse eid="1CH 13:9"/><verse number="10" style="v" sid="1CH 13:10"/>ኦዛ ኩሸይ ታቦትያ ቦችዳ ግሾ፥ ጎዳ ሀንቆይ ኦዛ ቦላ ኤፅስ። ሄሳ ግሾ፥ ጎዳይ እያ ፃድክን፥ እ ሄ በሳን ፆሳ ስንን ሀይቅስ።<verse eid="1CH 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11"/>ጎዳይ ሀንቀትድ ኦዛ ዎዳ ግሾ፥ ዳዊቲ ይሎትስ። ሀች ጋካናዉ ሄ በሳይ ኦዝ ከትዳ በሳ ጌተቴስ። <verse eid="1CH 13:11"/><verse number="12" style="v" sid="1CH 13:12"/>ሄ ጋላስ ዳዊቲ ፆሳ ያይዳ ግሾ፥ “ፆሳ ታቦትያ ታኮ ዋታ ኤሀናዉ ዳንዳእያና?” ያግስ። <verse eid="1CH 13:12"/><verse number="13" style="v" sid="1CH 13:13"/>ዳዊቲ ታቦትያ የሩሳላመ ኤፋናፐ ግድ ጋተ አድያ አብዳራ ሶ ኤፍስ። <verse eid="1CH 13:13"/><verse number="14" style="v" sid="1CH 13:14"/>ፆሳ ታቦተይ አብዳራ ሶን እያ ሶ አሳራ ሄ አጌና ጋምእስ። ጎዳይ እያ ሶ አሳነ እያዉ ደእያ ኡባ አንጅስ።<verse eid="1CH 13:14"/></para>
  <chapter eid="1CH 13"/>
  <chapter number="14" style="c" sid="1CH 14"/>
  <para style="s1">ዳዊታ ሶ አሳ</para>
  <para style="r">(<ref loc="2SA 5:11-16">2 ሳሜ 5:11-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1"/>ፅሮሳ ካዎይ ክራም ዳዊታስ ጋ ኬፃና መላ ኪተትያ አሳታ፥ ሹቹ ማሰይሳታነ አናፀታ ዝጋ ምራ የድስ። <verse eid="1CH 14:1"/><verse number="2" style="v" sid="1CH 14:2"/>ጎዳይ እስራኤለ ቦላ እያ ካዎ ኦድ ምንዳይሳነ ባ አሳ እስራኤለ ግሾ እያ ካዎተ ቦንችዳይሳ ዳዊቲ ኤርስ።<verse eid="1CH 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3"/>ሄሳፈ ጉየ፥ ዳዊቲ የሩሳላመን ሀራ ማቾ ኤክድ አደ ናይታነ ማጫ ናይታ የልስ። <verse eid="1CH 14:3"/><verse number="4" style="v" sid="1CH 14:4"/>ዳዊቲ የሩሳላመን የልዳ አደ ናይት ሳሙሳ፥ ሶባባ፥ ናታና፥ ሶሎሞነ፥ <verse eid="1CH 14:4"/><verse number="5" style="v" sid="1CH 14:5"/>ይብሃራ፥ ኤልሱአ፥ ኤልፋላፃ፥ <verse eid="1CH 14:5"/><verse number="6" style="v" sid="1CH 14:6"/>ኖጋ፥ ናፈጋ፥ ያፋያ፥ <verse eid="1CH 14:6"/><verse number="7" style="v" sid="1CH 14:7"/>ኤልሳማ፥ ኤልዳና፥ ኤልፋላፃ።<verse eid="1CH 14:7"/></para>
  <para style="s1">ዳዊቲ ፍልስፄመታ ፆንስ</para>
  <para style="r">(<ref loc="2SA 5:17-25">2 ሳሜ 5:17-25</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8"/>ዳዊቲ እስራኤለ ኡባ ቦላ ካዎ ግድድ ትየትዳይሳ ፍልስፄመት ስእዳ ዎደ ኡባይ ዳዊታ ኦልድ ኦይካናዉ ከይዶሶና። ዳዊቲ ሄሳ ስእድ ኤንታራ ኦለታናዉ ከይስ። <verse eid="1CH 14:8"/><verse number="9" style="v" sid="1CH 14:9"/>ፍልስፄመት ራፋይመ ዛንጋራ ይድ ኦይክዶሶና። <verse eid="1CH 14:9"/><verse number="10" style="v" sid="1CH 14:10"/>ዳዊቲ፥ “ታኒ ፍልስፄመታ ኦሎ? ኔኒ ኤንታ ታዉ አ እማኔ?” ያግድ ፆሳ ኦይችስ።</para>
  <para style="p" vid="1CH 14:10">ጎዳይ፥ “ባዳ ኦላ፤ ታኒ ኤንታ ነዉ አ እማና” ያግስ።<verse eid="1CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11"/>ዳዊቲነ እያ አሳይ ባአል-ፓራስመ ጌተትያ በሳ ብድ ያን ኤንታ ፆንዶሶና። ዳዊቲ፥ “ሃ ስድ ከየይሳዳ ፆሳይ ታ ሞርከታ ግዶራ ታና ካንስስ” ያግስ። ሄ በሳ ሱንይ ባአል-ፓራስመ ጌተትስ። <verse eid="1CH 14:11"/><verse number="12" style="v" sid="1CH 14:12"/>ፍልስፄመት ባንታ ኤቃታ ሄ በሳን የግድ ብን፥ ዳዊቲ ኪትድ ኤንታ ኤቃታ ፁግስስ።<verse eid="1CH 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13"/>ፍልስፄመት ዛር ሄ ዛንጋራ ይድ ኦልዶሶና። <verse eid="1CH 14:13"/><verse number="14" style="v" sid="1CH 14:14"/>ዳዊቲ ፆሳ ዛሪድ ኦይችስ። ፆሳይ፥ “ኤንታ ጉየራ ዩያ አዳ ዎላ ማታን ኤቃዳ ኦላፐ አትሽን፥ ስን ባጋራ ከዮፓ። <verse eid="1CH 14:14"/><verse number="15" style="v" sid="1CH 14:15"/>ዎላ ሁጰን ሳልፐ ግርስ ኔኒ ስእያ ዎደ ኦላናዉ ከያ። ሄስ ፍልስፄመ ኦላንቾታ ሾጫናዉ ፆሳይ ኔፐ ስን አዳይሳስ ማላ” ያግስ። <verse eid="1CH 14:15"/><verse number="16" style="v" sid="1CH 14:16"/>ፆሳይ ኪትዳይሳዳ ዳዊቲ ኦስ። ጋባኦናፐ ገዘራ ጋካናዉ እስራኤለ አሳይ ፍልስፄመ ኦላንቾታ ዎዶሶና። <verse eid="1CH 14:16"/><verse number="17" style="v" sid="1CH 14:17"/>ዳዊታ ሱንይ ቢታ ኡባ ጋክስ። ካዎተ ኡባይ ዳዊታስ ያያና መላ ጎዳይ ኦስ።<verse eid="1CH 14:17"/></para>
  <chapter eid="1CH 14"/>
  <chapter number="15" style="c" sid="1CH 15"/>
  <para style="s1">ታቦተይ የሩሳላመ ስምስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1"/>ዳዊቲ ባ ካታማን ባዉ ኬ ኬፅስ፤ ፆሳ ታቦትያስ በሰ ጊግስድ፥ ዱንካነ ኤስስ። <verse eid="1CH 15:1"/><verse number="2" style="v" sid="1CH 15:2"/>ዳዊቲ፥ “ፆሳ ታቦትያ ቶካናዳነ መርናዉ ፆሳስ ኦናዳ ጎዳይ ዶርዳይ ሌወታ ግድያ ግሾ ሀር ኦንካ ፆሳ ታቦትያ ቶካናዉ በሰና” ያግስ። <verse eid="1CH 15:2"/><verse number="3" style="v" sid="1CH 15:3"/>ዳዊቲ ጎዳ ታቦትያስ ጊግስዳ በሳ ታቦትያ ኤሀና መላ እስራኤለ አሳ ኡባ የሩሳላመ ሺሽስ። <verse eid="1CH 15:3"/><verse number="4" style="v" sid="1CH 15:4"/>ካልድ ዳዊቲ አሮና ኮቻታነ ሌወታ ፄግድ ሺሽስ። <verse eid="1CH 15:4"/><verse number="5" style="v" sid="1CH 15:5"/>ቃሃታ ያራፐ ሀላቃይ ኡርኤልነ እስ ፄታነ ላታሙ እያ ዳቦት ይዶሶና። <verse eid="1CH 15:5"/><verse number="6" style="v" sid="1CH 15:6"/>ማራራ ያራፐ ሀላቃይ አሳይነ ናምኡ ፄታነ ላታሙ እያ ዳቦት ይዶሶና። <verse eid="1CH 15:6"/><verse number="7" style="v" sid="1CH 15:7"/>ገድሶና ያራፐ ሀላቃይ እዩኤልነ ፄታነ ሀስታሙ እያ ዳቦት ይዶሶና። <verse eid="1CH 15:7"/><verse number="8" style="v" sid="1CH 15:8"/>ኤልዛፋና ያራፐ ሀላቃይ ሻማእነ ናምኡ ፄቱ እያ ዳቦት ይዶሶና። <verse eid="1CH 15:8"/><verse number="9" style="v" sid="1CH 15:9"/>ከብሮና ያራፐ ሀላቃይ ኤልኤልነ ሆስፑን ታሙ እያ ዳቦት ይዶሶና። <verse eid="1CH 15:9"/><verse number="10" style="v" sid="1CH 15:10"/>ኡዝኤላ ያራፐ ሀላቃይ አምናዳበይነ ፄታነ ታማነ ናምኡ እያ ዳቦት ይዶሶና።<verse eid="1CH 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11"/>ዳዊቲ ካህነታ ሳዶቃነ አብያታራ፥ ሌወታ ኡርኤላ፥ አሳያ፥ እዩኤላ፥ ሻማአ፥ ኤልኤላነ አምናዳበ ፄግስ። <verse eid="1CH 15:11"/><verse number="12" style="v" sid="1CH 15:12"/>ኤንታኮ፥ “ህንተ ሌወ ኮቻስ ሀላቃታ። ጎዳ እስራኤለ ፆሳ ታቦትያ ታኒ ጊግስዳ በሳ ኤሀናዉ ህንተነ ህንተ ዳቦት ጌይተ። <verse eid="1CH 15:12"/><verse number="13" style="v" sid="1CH 15:13"/>ህንተ ሌወት ኮይሮ ፆሳ ታቦትያ ቶክቦና ግሾነ ኑኒ እያ ዎጋ መላ ዋት ኤፋነኮ ፆሳ ኦይችቦና ግሾ፥ ጎዳይ ኑ ፆሳይ ኑና ሴርስ” ያግስ።<verse eid="1CH 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 15:14"/>ጎዳ እስራኤለ ፆሳ ታቦትያ ኤሀናዉ ካህነትነ ሌወት ባንታና ጌሽዶሶና። <verse eid="1CH 15:14"/><verse number="15" style="v" sid="1CH 15:15"/>ጎዳይ ሙሰ ባጋራ ካሰ ኪትዳይሳዳ ሌወት ፆሳ ታቦትያ ባንታ ሀሽያን ካሶራ ቶክዶሶና።<verse eid="1CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16"/>ዲ፥ ማስንቆነ ዳላ ካእሸ ኡፋይሳ የ የፃና መላ ባንታ ዳቦ ግድዳ ሌወታፐ ዛማረታ ሹማና መላ ዳዊቲ ኪትስ። <verse eid="1CH 15:16"/><verse number="17" style="v" sid="1CH 15:17"/>ሌወት እዩኤላ ናኣ ሄማና፥ እያ ዳቦታፐ ባራካ ናኣ አሳፋነ ኤንታ ዳቦታፐ ማራራ ያራ ቁሳያ ናኣ ኤታና ሹምዶሶና። <verse eid="1CH 15:17"/><verse number="18" style="v" sid="1CH 15:18"/>ቃስ ናምአን ደን ዛካርያሳ፥ ያዝኤላ፥ ሻምራሞታ፥ ይኤላ፥ ኡና፥ ኤልኣባ፥ ባናያ፥ ማእሰያ፥ ማትታ፥ ኤልፋላ፥ ምቅነያነ ፐንገ ናግያ አብድዩነ ይኤላ ሹምዶሶና።<verse eid="1CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19"/>ናሰ ዳላ ቃና መላ ሄማን አሳፍነ ኤታን ሹመትዶሶና። <verse eid="1CH 15:19"/><verse number="20" style="v" sid="1CH 15:20"/>ቃስ ዛካርያስ፥ ያእዝኤል፥ ሻምራሞት፥ ይኤል፥ ኡን፥ ኤልኣብ፥ ማእሰይነ ባናይ ማስንቆ ካኦሶና። <verse eid="1CH 15:20"/><verse number="21" style="v" sid="1CH 15:21"/>ማትታ፥ ኤልፋል፥ ምቅነይ፥ አብድዩይ ይኤልነ አዛዘይ ዲ ዲፆሶና።<verse eid="1CH 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 15:22"/>ሌወታ ሀላቃይ ካናነይ ማዝሙረ ኤርያ ግሾ ኤንታ ካለናዉ ሹመትስ። <verse eid="1CH 15:22"/><verse number="23" style="v" sid="1CH 15:23"/>ባራክነ ኤልቃን ታቦትያ ዱንካንያ ፐንግያ ናጋናዉ ዶረትዶሶና። <verse eid="1CH 15:23"/><verse number="24" style="v" sid="1CH 15:24"/>ካህነት ሳባን፥ እዮሳፈፅ፥ ናትናኤል፥ አማሳይ፥ ዛካርያስ፥ ባናይነ አላዛር ፆሳ ታቦትያ ስንን ሞይዘ ፑናናዉ ዶረትዶሶና። ኦቤድ-ኤዶመይነ ይሄይ ታቦትያ ናጋናዉ ዶረትዶሶና።<verse eid="1CH 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25"/>ዳዊቲ፥ እስራኤለ ጭማትነ ሻላቃት ጎዳ ጫቆ ታቦትያ አብዳራ ሶፐ ኤሀናዉ ኡፋይትሸ ብዶሶና። <verse eid="1CH 15:25"/><verse number="26" style="v" sid="1CH 15:26"/>ጎዳ ጫቆ ታቦትያ ቶክዳ ሌወታ ፆሳይ ማድዳ ግሾ ኤንቲ ላፑን ኮርማነ ላፑን ማራዘ ያርሽዶሶና። <verse eid="1CH 15:26"/><verse number="27" style="v" sid="1CH 15:27"/>ዳዊቲ፥ ታቦትያ ቶክዳ ሌወት፥ ማዝሙረ የፀይሳትነ ኤንታ ሀላቃይ ካናነይ ሊኖፐ ኦሰትዳ ማኦ ማእዶሶና። ዳዊቲካ ሊኖፐ ኦሰትዳ ኤፉደ ማእስ። <verse eid="1CH 15:27"/><verse number="28" style="v" sid="1CH 15:28"/>ሄሳዳ ኦድ፥ እስራኤለ ኡባይ ኡፋይትድ ሞይዘነ ዛየ ፑንሸ፥ ዳላ ቃሸ፥ ዲነ ማስንቆ ካእሸ ጎዳ ጫቆ ታቦትያ ኤህዶሶና።<verse eid="1CH 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29"/>ጎዳ ጫቆ ታቦተይ ዳዊታ ካታማ ገልዳ ዎደ ሳኦላ ናእያ መልኮላ ካዎይ ዳዊቲ ኡፋይትድ ዱርሽንነ ካእሽን ማስኮተራ በአዳ ባ ዎዛናን ካሱ።<verse eid="1CH 15:29"/></para>
  <chapter eid="1CH 15"/>
  <chapter number="16" style="c" sid="1CH 16"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1"/>ኤንቲ ፆሳ ታቦትያ ኤህድ ዳዊቲ ታቦትያ ዎናዉ ኤስዳ ዱንካንያ ግዶን ዎድ፥ ፁሳ ያርሾነ እስፈተ ያርሾ ፆሳስ ያርሽዶሶና። <verse eid="1CH 16:1"/><verse number="2" style="v" sid="1CH 16:2"/>ዳዊቲ ፁሳ ያርሾነ እስፈተ ያርሾ ያርሽድ ፖልዳፐ ጉየ ጎዳ ሱንን አሳ አንጅስ። <verse eid="1CH 16:2"/><verse number="3" style="v" sid="1CH 16:3"/>እስራኤለ አሳ ኡባስ ማጫስነ አደስ፥ ሁጰን ሁጰን እስ ሙመ ኡይ፥ እስ ቃንፆ አሾነ እስ ዎይነ ኑካ ግሽስ።<verse eid="1CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4"/>ጎዳ ታቦትያ ስንን ኦና መላነ ጎዳ እስራኤለ ፆሳ ሳባና መላ፥ ጋላታና መላነ ቦንቻና መላ ጉ ሌወታ ዳዊቲ ሹምስ። <verse eid="1CH 16:4"/><verse number="5" style="v" sid="1CH 16:5"/>ሌወታ ሀላቃይ አሳፋ፤ አሳፋ ካልድ ዛካርያሳ። ዛካርያሳ ካልድ ደኤይ ይኤላ፥ ሻምራሞታ፥ ይኤላ፥ ማትታ፥ ኤልኣባ፥ ባናያነ ኦቤድ-ኤዶመ። ኤንቲ ማስንቆነ ዲ ዲፃናዉ ሹመትዶሶና፤ ሽን አሳፍ ዳላ ግርሳናዉ ሹመትስ። <verse eid="1CH 16:5"/><verse number="6" style="v" sid="1CH 16:6"/>ካህነይ ባናይነ ያሀዝኤል ፆሳ ጫቆ ታቦትያ ስንን ኡባ ዎደ ሞይዘ ፑናናዉ ሹመትዶሶና። <verse eid="1CH 16:6"/><verse number="7" style="v" sid="1CH 16:7"/>ሄ ጋላስ ዳዊቲ አሳፍነ እያ ዳቦት ጎዳ ሳባና መላ ሀ ማዝሙርያ ኮይሮ ኪትስ።<verse eid="1CH 16:7"/></para>
  <para style="s1">ጋላታ ማዝሙረ</para>
  <para style="r">(<ref loc="PSA 105:1-15">ማዝ 105:1-15</ref>፤ <ref loc="PSA 96:1-13">96:1-13</ref>፤ <ref loc="PSA 106:1">106:1</ref>፥ <ref loc="PSA 106:47-48">47-48</ref>)</para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8"/>ጎዳ ጋላትተ፤ እያ ሱን ፄግተ፤</para>
  <para style="q2" vid="1CH 16:8">እያ ኦሱዋ ካዎተታ ግዶን ኦድተ።<verse eid="1CH 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9"/>እያ ሳቢተ፤ ጋላታ ማዝሙርያ እያዉ የፅተ፤</para>
  <para style="q2" vid="1CH 16:9">ማላልስያ እያ ኦሶ ኡባ ኦድተ።<verse eid="1CH 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10"/>እያ ጌሻ ሱንን ጬቀትተ፤</para>
  <para style="q2" vid="1CH 16:10">ጎዳ ኮየይሳታ ዎዛናይ ኡፋይቶ።<verse eid="1CH 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11"/>ጎዳነ እያ ዎልቃ በእተ፤</para>
  <para style="q2" vid="1CH 16:11">ኡባ ዎደ እያ ስን ኮይተ።<verse eid="1CH 16:11"/></para>
  <para style="q1">
    <verse number="12-13" style="v" sid="1CH 16:12-13"/>ህንተኖ፥ እስራኤለ ኮቻቶ፥</para>
  <para style="q2" vid="1CH 16:12-13">ዶረትዳ ያይቆባ ናይቶ፥</para>
  <para style="q2" vid="1CH 16:12-13">እያ ማላታ፥ እ እምዳ ፕርዳነ ማላልስያባታ ሀሳይተ።<verse eid="1CH 16:12-13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14"/>እ ጎዳ ኑ ፆሳ፤</para>
  <para style="q2" vid="1CH 16:14">እያ ፕርዳይ ቢታ ኡባ ቦላና።<verse eid="1CH 16:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15"/>እያ ጫቁዋ መርናዉ</para>
  <para style="q2" vid="1CH 16:15">ሙኩሉ የለተ ጋካናዉ፥</para>
  <para style="q2" vid="1CH 16:15">እያ ቃላ ናግተ።<verse eid="1CH 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16"/>አብራሃመራ ጫቅዳ ጫቁዋ ናጌስ፤</para>
  <para style="q2" vid="1CH 16:16">ይሳቃስ ገልዳ ቃላ ምንስ።<verse eid="1CH 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17"/>ያይቆባስ ዎጋ፥</para>
  <para style="q2" vid="1CH 16:17">እስራኤለስ መርና ጫቁዋ፥</para>
  <para style="q2" vid="1CH 16:17">ኦድ ምንስ።<verse eid="1CH 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18"/>“ታኒ ነዉ ካናነ ቢታ እማና፤</para>
  <para style="q2" vid="1CH 16:18">እ ነ ኮቻስ ላታ ግዳና” ያግስ።<verse eid="1CH 16:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19"/>ሄስ ህንተ ታይቦን ጉነ</para>
  <para style="q2" vid="1CH 16:19">ካናነን በተ ግድድ ደእያ ዎደ ሀንስ።<verse eid="1CH 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20"/>እስ ደርያፐ ሀራ ደረ ፕንዶሶና፤</para>
  <para style="q2" vid="1CH 16:20">እስ ካዎተፈ ሀራ ካዎተ ዩይዶሶና።<verse eid="1CH 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21"/>ፆሳይ ኤንታ ኦንካ ናቃና መላ እምቤና፤</para>
  <para style="q2" vid="1CH 16:21">ኤንታ ግሾ ካዎታ ሴርስ።<verse eid="1CH 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22"/>“ታኒ ትይዳይሳታ ቦቾፍተ፤</para>
  <para style="q2" vid="1CH 16:22">ታ ናበታ ቆሆፕተ” ያግስ።<verse eid="1CH 16:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23"/>ሳአን ደእያ አሳ ኡባይ ጎዳስ የፅተ፤</para>
  <para style="q2" vid="1CH 16:23">እያ አሹዋ ጋላስ ጋላስ ኦድተ።<note caller="-" style="x"><char style="xo" closed="false">16:23 </char><char style="xt" closed="false"><ref loc="PSA 96:1-13">ማዝ 96:1-13</ref>.</char></note><verse eid="1CH 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24"/>ካዎተታ ግዶን እያ ቦንቹዋ፥</para>
  <para style="q2" vid="1CH 16:24">ማላልስያ እያ ኦሱዋ አሳ ኡባ ግዶን አዋጅተ።<verse eid="1CH 16:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25"/>ጎዳይ ግታ፤ አ ጋላታይ እያዉ በሴስ፤</para>
  <para style="q2" vid="1CH 16:25">ፆሳታ ኡባፈ አድ ቦንቸታናዉ በሴስ።<verse eid="1CH 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26"/>ሀራ ካዎተታ ፆሳት ኡባይ ኤቃታ፤</para>
  <para style="q2" vid="1CH 16:26">ሽን ጎዳይ ሳሎታ መዳ ፆሳ።<verse eid="1CH 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27"/>እያ ስንን ቦንቾይነ ቴም ደኤስ፤</para>
  <para style="q2" vid="1CH 16:27">ምኖተነ ኡፋይስ እ ደእያ በሳን ደኤስ።<verse eid="1CH 16:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28"/>ህንተኖ፥ ቢታ ካዎተቶ፥</para>
  <para style="q1" vid="1CH 16:28">ጎዳ ቦንቾነ ዎልቃ እምተ።<verse eid="1CH 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29"/>እያ ሱንስ በሲያ ቦንቾ እምተ፤</para>
  <para style="q2" vid="1CH 16:29">ያርሾ ኤክድ እያ ስን ዪተ፤</para>
  <para style="q2" vid="1CH 16:29">እያ ጌሻተ ቴማን ጎዳ ጎይንተ።<verse eid="1CH 16:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30"/>ቢታን ደእያ አሳ ኡባይ እያ ስንን ኮኮርተ፤</para>
  <para style="q2" vid="1CH 16:30">ሳአይ ምን ኤቅዳ ግሾ ቃፀና።<verse eid="1CH 16:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31"/>ሳሎት ኡፋይቶ፤ ሳእ ሀሹ ጎ!</para>
  <para style="q1" vid="1CH 16:31">ካዎተታ ግዶን ኤንቲ “ጎዳይ ካዎትስ!” ያጎ።<verse eid="1CH 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32"/>አባይነ እያ ግዶን ደእያ ኡባይ ጉሞ፤</para>
  <para style="q2" vid="1CH 16:32">ጋደይነ እያን ደእያ ካ ኡባይ ኡፋይቶ።<verse eid="1CH 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33"/>ሄ ዎደ ዎራን ደእያ ም ኡባይ</para>
  <para style="q2" vid="1CH 16:33">ኡፋይሳን ጎዳ ስንን የፃና።</para>
  <para style="q2" vid="1CH 16:33">እ ሳኣ ቦላ ፕርዳናዉ ዬስ።<verse eid="1CH 16:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34"/>ጎዳይ ኬሀ ግድያ ግሾነ</para>
  <para style="q2" vid="1CH 16:34">እያ ሲቆይ መርናሳ ግድያ ግሾ፥</para>
  <para style="q2" vid="1CH 16:34">ጎዳ ጋላትተ።<verse eid="1CH 16:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35"/>“አቤት ኑና አሽያ ፆሳዉ ኑና አሻ፤<note caller="-" style="x"><char style="xo" closed="false">16:35 </char><char style="xt" closed="false"><ref loc="PSA 106:47-48">ማዝ 106:47-48</ref>.</char></note></para>
  <para style="q2" vid="1CH 16:35">ኑኒ ነ ጌሻ ሱን ጋላታና መላነ</para>
  <para style="q2" vid="1CH 16:35">ነ ቦንቹዋን ኑ ቦንቸታና መላ፥</para>
  <para style="q2" vid="1CH 16:35">ካዎተታ ግዶፈ ሺሻዳ ኑና አሻ” ያግተ።<verse eid="1CH 16:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36"/>ጎዳይ እስራኤለ ፆሳይ፥</para>
  <para style="q2" vid="1CH 16:36">መርናፐ መርና ጋካናዉ ጋላተቶ!</para>
  <para style="p" vid="1CH 16:36">አሳ ኡባይ፥ “አምንእ” ግድ፥ ጎዳ ጋላትዶሶና።<verse eid="1CH 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37"/>ጎዳ ጫቆ ታቦትያ ስንን ጋላስ ጋላስ ጎይኖስ ኮሽያባ ኡባ ዎደ ኤንቲ ኦና መላ ዳዊቲ አሳፋነ እያ ዳቦታ ዎስ። <verse eid="1CH 16:37"/><verse number="38" style="v" sid="1CH 16:38"/>ቃስ ኦቤድ-ኤዶመነ ኡሱፑን ታማነ ሆስፑን እያ ዳቦታ ኤንታራ ኦና መላ ዎስ፤ የዱቱና ናኣ ኦቤድ-ኤዶመነ ሆሳ ፐንግያ ናጋና መላ ዎስ።<verse eid="1CH 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39"/>ካህነይ ሳዶቅነ እያራ ኦያ ካህነት ጋባኦናን ደእያ ቃ በሳን፥ ዱንካንያ ስንን ኦና መላ ኤንታ ያን አግስ። <verse eid="1CH 16:39"/><verse number="40" style="v" sid="1CH 16:40"/>ጎዳይ እስራኤለስ እምዳ ህግያን ፃፈትዳይሳዳ ኤንቲ ዎንታነ ኦማርስ ኡባ ዎደ ፁሳ ያርሾ ያርሻና መላ ኦስ። <verse eid="1CH 16:40"/><verse number="41" style="v" sid="1CH 16:41"/>እያ ሲቆይ መርናሳ ግድያ ግሾ ጎዳ ማዝሙረን ጋላታና መላ ሄማና፥ የዱቱናነ ዶረትዳ ሀራታ ዳዊቲ ኤንታራ እስፈ ዎስ። <verse eid="1CH 16:41"/><verse number="42" style="v" sid="1CH 16:42"/>ሄማንነ የዱቱን ሞይዘ ፑኖሶና፥ ዳላ ጊርሶሶና ጋላታ ማዝሙረ የፅሸ ካእያ ሀራ ሚሸታ ካኦሶና። የዱቱና አደ ናይት ፐንግያ ናጋናዉ ሹመትዶሶና።<verse eid="1CH 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43"/>ሄሳፈ ጉየ አሳ ኡባይ ባ ሶ ሶ ብስ። ዳዊቲካ ባ ሶ አሳ አንጃናዉ ስምስ።<verse eid="1CH 16:43"/></para>
  <chapter eid="1CH 16"/>
  <chapter number="17" style="c" sid="1CH 17"/>
  <para style="s1">ናታን ዳዊታስ ኦድዳ ትንብተ</para>
  <para style="r">(<ref loc="2SA 7:1-17">2 ሳሜ 7:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1"/>ዳዊቲ ባ ጋን ኡትዳፐ ጉየ ናብያ ናታናኮ፥ “ታኒ ዝጋፐ ኬፀትዳ ኬን ደአይስ፤ ሽን ጎዳ ጫቆ ታቦተይ ዱንካነ ግዶን ደኤስ” ያግስ።<verse eid="1CH 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2"/>ናታን ዳዊታኮ፥ “ጎዳይ ኔራ ደእያ ግሾ ነ ዎዛናይ ቆፕዳባ ኡባ ኦ” ያግስ።<verse eid="1CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3"/>ሽን ሄ ቃማ ጎዳ ቃላይ ናታናኮ ሀይሳዳ ያግሸ ይስ፤ <verse eid="1CH 17:3"/><verse number="4" style="v" sid="1CH 17:4"/>“ባዳ ታ አይልያ ዳዊታኮ ሀይሳዳ ያጋ፤ ‘ታኒ ዳና ኬ ኬፃናይ ነና ግዳካ። <verse eid="1CH 17:4"/><verse number="5" style="v" sid="1CH 17:5"/>ታኒ እስራኤለ ግብፀፈ ከስዳ ዎደፐ ዶማዳ ሀች ጋካናዉ ኬን ደአብከ፤ ታኒ ዱንካነፐ ዱንካነ፥ በሳፈ በሲ ዩያሸ ደአስ። <verse eid="1CH 17:5"/><verse number="6" style="v" sid="1CH 17:6"/>ታኒ እስራኤለ አሳ ኡባራ ዩይዳ በሳ ኡባን፥ ታ አሳ ሄማና መላ ታኒ ሹምዳ አሳፐ ኦና ታዉ ዝጋ ኬ አይስ ኬፃብኪ?’ ጋዳ ኦይቻብከ” ያጌስ።<verse eid="1CH 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 17:7"/>“ሄሳ ግሾ፥ ታ አይልያ ዳዊታኮ ባዳ ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፤ ‘ታኒ ነና ዶርሰ ሄምያ በሳፔ ደንዳ ታ አሳ እስራኤለ ካለና መላ ኤሀስ። <verse eid="1CH 17:7"/><verse number="8" style="v" sid="1CH 17:8"/>ኔኒ ብዳ በሰ ኡባን ታኒ ኔራ ግዳስ፤ ነ ሞርከታ ኡባ ነ ስንፈ ድጋስ። ህዛ ታኒ ሀ ሳአን ኤረትዳ ግታ አሳዳ ነ ሱን ግታያና። <verse eid="1CH 17:8"/><verse number="9" style="v" sid="1CH 17:9"/>ታኒ ታ አሳ እስራኤለስ በሰ እማዳ፥ ኤንታ ሄ በሳን ቶካና። ሄሳ ግሾ፥ ኤንቲ ባንታ በሳን ደአና፤ ኤንቲ ዛሪድ ዋባቆኮና። ካሰ ታኒ ታ አሳ እስራኤለ ቦላ ዳይናታ ሹማዳ ዎደ ሞርከት ናቅዳይሳዳ፥ <verse eid="1CH 17:9"/><verse number="10" style="v" sid="1CH 17:10"/>ዛሪድ ኢታ አሳት ኤንታ ናቆኮና። ታኒ ነ ሞርከታ ኡባ ነዉ ሃርሳና።</para>
  <para style="p" vid="1CH 17:10">“ ‘ሄሳ ቦላ ጎዳይ ባ ሁጰን ነዉ ኬ ኬፃናይሳ ኦዴስ። <verse eid="1CH 17:10"/><verse number="11" style="v" sid="1CH 17:11"/>ነ ሀይቃዳ ነ ማይዛታን ጋሄትያ ዎደ ታኒ ኔፐ ጉየ ነ ናይታፐ እሱዋ ደንዳ እያ ካዎተ ምንና። <verse eid="1CH 17:11"/><verse number="12" style="v" sid="1CH 17:12"/>ታዉ ኬ ኬፃናይ<note caller="+" style="f"><char style="fr" closed="false">17:12 </char><char style="ft" closed="false">ኬ ኬፃናይ፦ ሀ በሳን ኬ ኬፃናይ ጌተትያ ሶ አሳ ዎይኮ ሼሻ ዎይኮ የለተ ድቻናይ እያ ጉሱ። ፓይዶ 17፥ 23፥ 24፥ 25፥ 27 ፄላ</char></note> እያ፤ ታኒ እያ አራታ መርናዉ ምን ኤሳና። <verse eid="1CH 17:12"/><verse number="13" style="v" sid="1CH 17:13"/>ታኒ እያዉ አዋ ግዳና፤ እካ ታዉ ናአ ግዳና። ኔፐ ስን ካዎትዳ ሳኦላፐ ታ ማሮተ<note caller="+" style="f"><char style="fr" closed="false">17:13 </char><char style="ft" closed="false">ማሮተ፦ ሀ በሳን ኦደትዳ ማሮተይ ዱፆና ሲቆ ዎይኮ መርናዉ አጎና ሲቆ ዎይኮ ላመቶና ሲቆ ጉሱ።</char></note> ኤክዳይሳዳ ታኒ እያፐ ኤክከ። <verse eid="1CH 17:13"/><verse number="14" style="v" sid="1CH 17:14"/>ታኒ እያ ታ አሳ ቦላነ ታ ካዎተ ቦላ መርናዉ ሹማና፤ እያ አራታይ መርናዉ ምን ኤቃና’ ” ያግስ።<verse eid="1CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15"/>ናታን ፆሳይ እያዉ ቆንጭስዳ ቃላ ኡባ ዳዊታስ ኦድስ።<verse eid="1CH 17:15"/></para>
  <para style="s1">ዳዊታ ዎሳ</para>
  <para style="r">(<ref loc="2SA 7:18-29">2 ሳሜ 7:18-29</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16"/>ሄሳፈ ጉየ፥ ካዎይ ዳዊቲ ዱንካንያ ግዶ ገልድ፥ ጎዳ ስንን ኡትድ፥ ሀይሳዳ ያግድ ዎስስ፤ “አቤት ጎዳዉ፥ ፆሳዉ ኔኒ ሀይሳ ኡባ ታዉ ኦናዉ ታኒ ኦኔ? ታ ሶ አሳይካ አይቤ? <verse eid="1CH 17:16"/><verse number="17" style="v" sid="1CH 17:17"/>አቤት ጎዳዉ፥ ሄስ ነ አይፍያ ስንን ጉ ዳንን፥ ነ አይልያ ሶ አሳስ ስንፈ ሀናናባ ኦዳዳሳ። ኔኒ ታና ግታ አስ ኦዳ ፄላዳሳ። <verse eid="1CH 17:17"/><verse number="18" style="v" sid="1CH 17:18"/>ኔኒ ታና ነ አይልያ ቦንችዳ ግሾ፥ ዳዊቲ አይ ጋናዉ ዳንዳኢ? ኔኒ ታና ነ አይልያ ኤራሳ። <verse eid="1CH 17:18"/><verse number="19" style="v" sid="1CH 17:19"/>አቤት ጎዳዉ፥ ነ አይልያ ግሾነ ነ ዎዛና ቆፋዳ ሀ ግታባ ኡባ ኦዳ፥ ሀ ግታ ኡፋይሳ ቃላ ኡባ ታና ኤርሳዳሳ። <verse eid="1CH 17:19"/><verse number="20" style="v" sid="1CH 17:20"/>አቤት ጎዳዉ፥ ነ መል ኦንካ ባዋ። ኑኒ ኑ ሀይን ስእዳይሳዳ ኔፐ አትሽን፥ ሀራ ፆሲ ባዋ። <verse eid="1CH 17:20"/><verse number="21" style="v" sid="1CH 17:21"/>ኔኒ ነ አሰ ኦናዉ ዎዝዳ ነ አሳ እስራኤለ ዳንያ ሀራ ካዎተ ሳአ ቦላ ባዋ። ኔኒ ኦዳ ግታነ ማላልስያ ኦሶታ ጋሶን ነ ሱንይ ቢታን ኤረትስ። ኔኒ ግብፀፈ ዎዝዳ ነ አሳ ስንፈ ካዎተታ ጎዳ ከሳዳሳ።<note caller="-" style="x"><char style="xo" closed="false">17:21 </char><char style="xt" closed="false"><ref loc="DEU 4:7">ዛረ 4:7</ref>.</char></note> <verse eid="1CH 17:21"/><verse number="22" style="v" sid="1CH 17:22"/>ኔኒ ነ አሳ እስራኤለ መርናዉ ነባ ኦዳሳ። አቤት ጎዳዉ፥ ኔኒ ኤንታ ፆሰ ግዳዳሳ።<verse eid="1CH 17:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 17:23"/>“አቤት ጎዳዉ፥ ኔኒ ነ አይልያስነ እያ ሶ አሳስ ኦድዳባይ መርናዉ ምንድ ደኦ፤ ኔኒ ኦና ግዳይሳዳ ኦ። <verse eid="1CH 17:23"/><verse number="24" style="v" sid="1CH 17:24"/>‘ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ቱማ እስራኤለ ፆሰ’ አሳይ ጋናዳ ነ ሱንይ መርናዉ ምንድ ዳናነ ግታ ግዳና። ነ አይልያ ዳዊታ ሶ አሳይ ነ ስንን ምንድ ዳና።<verse eid="1CH 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 17:25"/>“አቤት ታ ፆሳዉ፥ ኔኒ ነ አይልያስ ኬ ኬፃና ጋዳ ቆንጭሳዳሳ። ሄሳ ግሾ፥ ታኒ ነ አይለይ ሀ ዎሳ ዎሳናዉ ምናስ። <verse eid="1CH 17:25"/><verse number="26" style="v" sid="1CH 17:26"/>አቤት ጎዳዉ፥ ኔኒ ፆሰ! ኔኒ ሀ ሎኦ ኡፋይሳ ቃላ ታዉ ነ አይልያስ ኦና ጋዳሳ። <verse eid="1CH 17:26"/><verse number="27" style="v" sid="1CH 17:27"/>ነ ስንን መርናዉ ዳና መላ ነ አይልያ ሶ አሳ አንጃናዉ ኮያዳሳ። አቤት ጎዳዉ፥ ነ አንጅዳይስ መርናዉ አንጀትዳይሳ ግዳና” ያግድ ዎስስ።<verse eid="1CH 17:27"/></para>
  <chapter eid="1CH 17"/>
  <chapter number="18" style="c" sid="1CH 18"/>
  <para style="s1">ዳዊታ ፆኖታ</para>
  <para style="r">(<ref loc="2SA 8:1-18">2 ሳሜ 8:1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1"/>ሄሳፈ ጉየ፥ ዳዊቲ ፍልስፄመታ ፆንድ ሃርስ፤ ጌተ ካታማነ እያ ጉታታ ፍልስፄመታ ኩሸፐ ኤክስ። <verse eid="1CH 18:1"/><verse number="2" style="v" sid="1CH 18:2"/>ዳዊቲ ሞአበ አሳ ፆንን፥ ኤንቲ እያዉ ሃረትድ ጊርዶሶና።<verse eid="1CH 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3"/>ሀማታ ካታማ ማታን ደእያ ሱባ ካዎይ አድራዛር፥ ባ ካዎተ ኤፍራፂሳ ሻፋ ጋካናዉ አሳናዉ ብሽን ዳዊቲ እያ ኦልስ። <verse eid="1CH 18:3"/><verse number="4" style="v" sid="1CH 18:4"/>ዳዊቲ አድራዛራፐ እስ ሙኩሉ ፓራ ጋረታ፥ ላፑን ሙኩሉ ፓራ አሳታነ ላታሙ ሙኩሉ ቶሆ አሳታ ድእስ። ዳዊቲ ፄቱ ጋረታስ ግድያ ፓራታ አሽድ ሀራ ፓራታ ኡባስ ገዳ ፃጱዋ ቃንፅስ።<verse eid="1CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5"/>ዳማስቆ ካታማን ደእያ ሶረት ሱባ ካዋ አድራዛራ ማዳናዉ ይዳ ዎደ ዳዊቲ ኤንታፈ 22,000 አሳ ዎስ። <verse eid="1CH 18:5"/><verse number="6" style="v" sid="1CH 18:6"/>ሄሳፈ ጉየ፥ ሶረ ቢታን ዳማስቆ ካታማን ኦላ ሚፃ መስ። ሶረ አሳት ዳዊታስ ሃረትድ ጊርዶሶና። ዳዊቲ ብዳ በሳ ኡባን ጎዳይ እያዉ ፆኖ እሚስ።<verse eid="1CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7"/>ዳዊቲ አድራዛራ ኦሳንቾት ቶክዳ ዎርቃ ጎንዳለታ ኤክድ የሩሳላመ ኤፍስ። <verse eid="1CH 18:7"/><verse number="8" style="v" sid="1CH 18:8"/>ቃስ ዳዊቲ አድራዛር ሃርያ ፀባሀነ ኩና ካታማታፐ ዳሮ ናሰ ብራታ ኤክስ። ሄሳፈ ጉየ፥ ሶሎሞነይ ሄ ናሰ ብራታፐ ኦሰትዳ ከረታ፥ ቱሳታነ ዱማ ዱማ ሚሸታ ኦስ።<verse eid="1CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9"/>ዳዊቲ ሱባ ካዋ አድራዛራ ኦላንቾታ ኡባ ፆንዳይሳ ሀማታ ካዎይ ቶይ ስእስ። <verse eid="1CH 18:9"/><verse number="10" style="v" sid="1CH 18:10"/>ቶይ አድራዛራራ ኦለትሸ ጋምእዳ ግሾ ዳዊቲ አድራዛራ ኦልድ ፆንዳ ግሾ እያ ሀሹ ጋናዉነ ሳሮናዉ ባ ናኣ ሀዶራማ ካዋ ዳዊታኮ ኪትስ። ሀዶራም ዎርቃፈ፥ ብራፐነ ናሰ ብራታፐ ኦሰትዳ ሚሸታ እሞታ ኤክድ ብስ። <verse eid="1CH 18:10"/><verse number="11" style="v" sid="1CH 18:11"/>ካዎይ ዳዊቲ ኤዶመፐ፥ ሞአበፐ፥ አሞነፐ፥ ፍልስፄመታፐነ አማለቃታፐ ድእድ ኤክዳ ብራነ ዎርቃ ሀ ሚሸታራ ጋድ ጎዳስ ዱማይድ ዎስ።<verse eid="1CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12"/>ፃሩያ ናአይ አብስ ኤዶመ አሳፐ 18,000 አሳ፥ ማፅነ ዛንጋራን ዎስ። <verse eid="1CH 18:12"/><verse number="13" style="v" sid="1CH 18:13"/>ዳዊቲ ኤዶመን ኦላ ሚፃ መስ፤ ያትን፥ ሄ ቢታ አሳ ኡባይ ዳዊታስ ሃረትስ። ዳዊቲ ብዳ በሳ ኡባን ጎዳይ እያዉ ፆኖ እሚስ።<verse eid="1CH 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14"/>ሄሳዳ ኦድ፥ ዳዊቲ እስራኤለ ኡባ ቦላ ካዎትድ ባ አሳ ኡባ ፅሎተንነ ሱረ ፕርዳን አይስስ። <verse eid="1CH 18:14"/><verse number="15" style="v" sid="1CH 18:15"/>ፃሩያ ናአይ እዮኣብ ቶራ ሞጮና፤ አህሉዳ ናአይ እዮሳፈፅ ታርከ ፃፈ። <verse eid="1CH 18:15"/><verse number="16" style="v" sid="1CH 18:16"/>አህፁባ ናአይ ሳዶቅነ አብያታራ ናአይ አብመለከይ ካህነ፤ ሳራይ ዋና ፃፈ። <verse eid="1CH 18:16"/><verse number="17" style="v" sid="1CH 18:17"/>ዮዳሄ ናአይ ባናይ ዳዊቲ ናግያ አሳ ሀላቃ፤ ዳዊታ አደ ናይት እያ ካዎተን ቃ በሳ ኦይክዳ ሀላቃታ።<verse eid="1CH 18:17"/></para>
  <chapter eid="1CH 18"/>
  <chapter number="19" style="c" sid="1CH 19"/>
  <para style="s1">ዳዊቲ አሞነታ ፆኑዋ</para>
  <para style="r">(<ref loc="2SA 10:1-19">2 ሳሜ 10:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1"/>ሄሳፈ ጉየ፥ አሞነ ካዎይ ናኦስ ሀይቅን እያ ናአይ እያ በሳን ካዎትስ። <verse eid="1CH 19:1"/><verse number="2" style="v" sid="1CH 19:2"/>ዳዊቲ፥ “እያ አዋይ ናኦስ ታዉ ኬህዳ ግሾ ታኒ እያ ናኣ ሀኑናስ ኬሀና” ያግስ። ሀኑና አዋይ ሀይቅዳ ግሾ ዳዊቲ እያ ምንናዉ አሰ ኪትስ።</para>
  <para style="p" vid="1CH 19:2">ዳዊቲ ኪትዳ አሳት ሀኑና ምንናዉ አሞነ ጋክዳ ዎደ፥ <verse eid="1CH 19:2"/><verse number="3" style="v" sid="1CH 19:3"/>አሞነ ሞርናት ሀኑናኮ፥ “ዳዊቲ ነ አዋ ቦንችድ ነና ምንናዉ ሀ አሳታ ኪትስ ጋዳ ኔ ቆፓይ? እ ሀ አሳ ኪትዳይ ሀ ካታማ ዎችድ፥ ኦላናሳ” ያግዶሶና።<verse eid="1CH 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 19:4"/>ሀኑኒ ዳዊቲ ኪትዳ አሳታ ኦይክድ፥ ኤንታ ቡቻ ሜድስ፤ ኤንታ ማኡዋ ጋርሳፈ ዱለ ጋካናዉ ቃንፅድ ኤንታ የድስ። <verse eid="1CH 19:4"/><verse number="5" style="v" sid="1CH 19:5"/>ሄሳ ግሾ፥ አሳት ዳሮ ዬላትዶሶና። ዳዊቲ ሄሳ ስእድ፥ ኤንታኮራ አስ ኪትድ፥ “ህንተ ቡቻይ ድጫና ጋካናዉ እያርኮ ካታማን ደእተ፤ ሄሳፈ ጉየ ሃ ዪተ” ያግስ።<verse eid="1CH 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6"/>አሞነት ባንታ ኩሸን ዳዊቲ ኤንታ ሞርካና መላ ኦዳይሳ ኤርዳ ዎደ ማሰጰፆመንነ ሶረን ደእያ ማእካነ ሱባ ካታማታፐ ፓራ ጋረታነ ፓራታ ጋርፃናዉ 34,000 ክሎ ግራመ ብራ ሳንትመ የድዶሶና። <verse eid="1CH 19:6"/><verse number="7" style="v" sid="1CH 19:7"/>32,000 ፓራ ጋረታ፥ ፓራታ፥ ማእካ ካዋነ እያ ኦላንቾታ ሚሸን ጋርፅን ይድ መዳባን ዱንካንዶሶና። ቃስ አሞነት ባንታ ካታማፐ ከይድ ኦላስ ጊገትዶሶና።<verse eid="1CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8"/>ዳዊቲ ሄሳ ስእዳ ዎደ እዮኣባነ ኦላንቾታ የድስ። <verse eid="1CH 19:8"/><verse number="9" style="v" sid="1CH 19:9"/>አሞነት ከይድ ካታማ ፐንገን ኦላስ ሳልፕዶሶና። ኤንታ ማዳናዉ ይዳ ካዎት ባንታ በሳ ኦይክድ ደንባን ሺቅዶሶና።<verse eid="1CH 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10"/>እዮኣብ ኦል ስንራነ ጉየራ ተቅዳይሳ በእዳ ዎደ እስራኤለታ ግዶፈ ምኖ ኦላንቾታ ዶርድ፥ ሶረ ኦላንቾታ ስንን ሳልፕስስ። <verse eid="1CH 19:10"/><verse number="11" style="v" sid="1CH 19:11"/>አትዳ አሳ ባ እሻ አብሳ አዋተ ጋርሳን ዎስ፤ ኤንቲ አሞነታ ስንን ሳልፕዶሶና። <verse eid="1CH 19:11"/><verse number="12" style="v" sid="1CH 19:12"/>እዮኣብ ባ እሻ አብሳኮ፥ “ሶረ አሳት ታ ቦላ ዎልቃምኮ፥ ኔኒ ያዳ ታና ማዳ። አሞነ አሳት ነ ቦላ ዎልቃምኮ፥ ታኒ ያዳ ነና ማዳና። <verse eid="1CH 19:12"/><verse number="13" style="v" sid="1CH 19:13"/>ህዛ ምና! ኑ አሳ ግሾነ ኑ ፆሳ ካታማታ ግሾ አነ ምንድ ኦለቶስ። ጎዳይ ባና ሎእያባ ኦ” ያግስ።<verse eid="1CH 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14"/>ሄሳፈ ጉየ፥ እዮኣብነ እያራ ደእያ አሳይ ሶረ ኦላንቾታራ ኦለታናዉ ከይዶሶና። ያትን፥ ሶረ አሳይ እያ ስንፈ ባቃትዶሶና። <verse eid="1CH 19:14"/><verse number="15" style="v" sid="1CH 19:15"/>ሶረ አሳይ ባቃትዳይሳ አሞነ አሳይ በእዳ ዎደ ኤንትካ እያ እሻ አብሳያ ስንፈ ባቃትድ ካታማ ገልዶሶና። ሄሳፈ ጉየ፥ እዮኣብ የሩሳላመ ስምስ።<verse eid="1CH 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16"/>ሶረ አሳይ እስራኤለ አሳይ ኤንታ ፆንዳይሳ ኤርዳ ዎደ አሰ ኪትድ ኤፍራፂሳ ሻፋፐ ሄፍንራ ደእያ ሶረ አሳ ኤህዶሶና። ቶራ ሞጮናይ አድራዛር፥ ሾፋክ ኤንታ ካለስ።<verse eid="1CH 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17"/>ዳዊቲ ሄሳ ስእዳ ዎደ እስራኤለ ኦላንቾታ ሺሽድ፥ ዮርዳኖሰ ሻፋ ፕንድ ሶረ አሳራ ኦለታናዉ ኤንታ ስንን ሳልፕዶሶና። ዳዊቲ ኤንታራ ኦለታናዉ ሳልፕን ኤንትካ እያራ ኦለትዶሶና። <verse eid="1CH 19:17"/><verse number="18" style="v" sid="1CH 19:18"/>ሶረ አሳይ እስራኤለታ ስንፈ ባቃትዶሶና፤ ዳዊቲ ሶረ አሳፐ ፓራ ጋረ ላግያ 7,000 አሳነ 40,000 ቶሆ አሳነ ኤንታ ቶራ ሞጮና ሾፋካ ዎስ። <verse eid="1CH 19:18"/><verse number="19" style="v" sid="1CH 19:19"/>አድራዛራ ኦላንቾት እስራኤለታን ፆነትዳይሳ ኤርዳ ዎደ ዳዊታራ ስገትድ፥ እያዉ ሃረትዶሶና። ሄሳፈ ጉየ፥ ሶረ አሳይ አሞነ አሳ ማዳናዉ ዶስቦኮና።<verse eid="1CH 19:19"/></para>
  <chapter eid="1CH 19"/>
  <chapter number="20" style="c" sid="1CH 20"/>
  <para style="s1">ዳዊቲ ራባ ኦልድ ኦይክስ</para>
  <para style="r">(<ref loc="2SA 12:26-31">2 ሳሜ 12:26-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1"/>ላይ ላመን ካዎት ኦላስ ከይያ ዎደ እዮኣብ ኦላንቾታ ካለድ አሞነ ቢታ ኦልድ ራባ ካታማ ኦይክስ። ሽን ዳዊቲ የሩሳላመን አትስ፤ እዮኣብ ራባ ካታማ ኦልድ ይስስ። <verse eid="1CH 20:1"/><verse number="2" style="v" sid="1CH 20:2"/>ሄሳፈ ጉየ ዳዊቲ ይድ ኤንታ ካዋ ዎርቃ ካላቻ እያ ሁጰፐ ኤክስ። ካላቻ ዴፆይ ሀስታማነ ኦይዱ ክሎ ግራመ ግድስ፤ እያ ግዶን አልኦ ሹች ደኤስ። ሄ ካላቻ ኤክድ ዳዊቲ ባ ሁጰን ዎስ። ቃስ ዳዊቲ ሄ ካታማፐ ዳሮ ድኦ ድእስ። <verse eid="1CH 20:2"/><verse number="3" style="v" sid="1CH 20:3"/>ካታማን ደእያ አሳ ከስድ ማጋዘን፥ ኮንተንነ ካልታን ኦስስስ። አሞነን ደእያ አሳ ኡባ ሄሳዳ ኦስስስ። ሄሳፈ ጉየ፥ ዳዊቲነ እያ አሳ ኡባይ የሩሳላመ ስምስ።<verse eid="1CH 20:3"/></para>
  <para style="s1">ፍልስፄመታራ ኦለትዳ ኦላ</para>
  <para style="r">(<ref loc="2SA 21:15-22">2 ሳሜ 21:15-22</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4"/>ሄሳፈ ጉየ፥ ፍልስፄመራ ገዘራን ኦል ደንድን፥ ኩሳታ አደይ ሳባክ፥ ራፋይመ ያራ ግድዳ ስፋያ ዎስ። ያትን፥ ፍልስፄመት ፆነትዶሶና።<verse eid="1CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5"/>ፍልስፄመታራ ደንድዳ ሀራ ኦላን ቃስ ያእራ ናአይ ኤልያን፥ ቶራ ቶማይ ዋንዳራሸ መላ ግድዳ፥ ጌተ አድያ ጎልያዳ እሻ፥ ላህማ ዎስ።<verse eid="1CH 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6"/>ቃስ ሀራ ኦል ጌተን ደንድስ። ሄ በሳን እስ ዎጋ አዱሳ አደይ ደኤስ። ሄ አድያስ እስ እስ ኩሽያንነ እስ እስ ቶሁዋን ኡሱፑን፥ ዎል ቦላ ላታማነ ኦይዱ ብራት ደኦሶና። እካ ራፋ ያራ። <verse eid="1CH 20:6"/><verse number="7" style="v" sid="1CH 20:7"/>ሄ ኡራይ እስራኤለታራ ቄለትዳ ዎደ ዳዊታ እሻ ሳምአ ናአይ ዮናታን እያ ዎስ። <verse eid="1CH 20:7"/><verse number="8" style="v" sid="1CH 20:8"/>ሀይሳቲ ጌተን ደእያ ራፋ ያራታ፤ ኤንቲ ዳዊቲ ኩሸንነ እያ አሳ ኩሸን ሀይቅዶሶና።<verse eid="1CH 20:8"/></para>
  <chapter eid="1CH 20"/>
  <chapter number="21" style="c" sid="1CH 21"/>
  <para style="s1">ዳዊቲ አሳ ታይብስ</para>
  <para style="r">(<ref loc="2SA 24:1-25">2 ሳሜ 24:1-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1"/>ፃለሄይ እስራኤለ ቦላ መቶ ኤሀናዉ ኮይድ፥ ዳዊቲ እስራኤለ አሳ ታይባና መላ ደንስ። <verse eid="1CH 21:1"/><verse number="2" style="v" sid="1CH 21:2"/>ዳዊቲ እዮኣባኮነ ቶራ ሞጮናታኮ፥ “ዳነፐ በርሳበ ጋካናዉ ብድ፥ እስራኤለ አሳ ታይብተ። ያትድ፥ አሳ ታይቦይ አፑነኮ ታና ኤርስተ” ያግስ።<verse eid="1CH 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3"/>ሽን እዮኣብ፥ “ጎዳይ፥ ሀ ደእያ ባ አሳ ቦላ ፄቱ ኩሸ ጉጆ! ታ ጎዳዉ፥ ካዋዉ፥ ኤንቲ ኡባይ ታ ጎዳ አይለታ ግዶኮናዬ? ታ ጎዳይ ሄሳ መላባ ኦናዉ አይስ ኮዪ? እስራኤለ ቦላ አይስ ባላ ኦይ?” ያግስ። <verse eid="1CH 21:3"/><verse number="4" style="v" sid="1CH 21:4"/>ሽን ካዋ ቃላይ እዮኣባ ፆንን፥ እዮኣብ ከይድ እስራኤለ ቢታ ኡባ ዩይድ የሩሳላመ ስምስ። <verse eid="1CH 21:4"/><verse number="5" style="v" sid="1CH 21:5"/>እዮኣብ ታይብዳ አሳ ታይቡዋ ዳዊታስ እሚስ። እስራኤለ ቢታ ኡባን ማሻን ኦለታናዉ ዳንዳእያ እስ 1,100,000 አሳት ደኦሶና። ቃስ ይሁዳ ቢታን ማሻን ኦለታናዉ ዳንዳእያ 470,000 አሳት ደኦሶና። <verse eid="1CH 21:5"/><verse number="6" style="v" sid="1CH 21:6"/>እዮኣብ ካዋ ኪታ ዶስቦና ግሾ ሌወታነ ብንያመ ኮቻታ ታይቤና።<verse eid="1CH 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7"/>ፆሳይ ሄሳን ኡፋይትቦና ግሾ እስራኤለ ሴርስ። <verse eid="1CH 21:7"/><verse number="8" style="v" sid="1CH 21:8"/>ዳዊቲ ፆሳኮ፥ “ታኒ ሀይሳን ግታ ናጋራ ኦስ። ሽን ሀእ ነና ዎሳይስ፤ ነ አይልያ ናጋራ አቶ ጋ፤ ታኒ ዳሮ ኤያባ ሀናስ” ያግስ።<verse eid="1CH 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9"/>ጎዳይ ዳዊታ ቆንጨ በእያ ጋደኮ ሀይሳዳ ያግስ፤ <verse eid="1CH 21:9"/><verse number="10" style="v" sid="1CH 21:10"/>“ባዳ ዳዊታኮ፥ ጎዳይ፥ ‘ታኒ ነና ሄ ዶሮ በሳይስ፤ ታኒ ነ ቦላ ኦና መላ ኤንታፈ ታዉ እሱዋ ዶራ’ ያጌስ” ያጋ።<verse eid="1CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11"/>ጋድ ዳዊታኮ ብድ፥ “ጎዳይ ሀይሳታፐ እሱዋ ዶራ ያጌስ፤ <verse eid="1CH 21:11"/><verse number="12" style="v" sid="1CH 21:12"/>ሄ ላይ ኮሻ ዎይኮ ሄ አጌና ነ ሞርከታ ኩሸን አዳ እመታናይሳ ዎይኮ ሄ ጋላስ ጎዳ ማሻይ ነ ቢታ ሾጫናይሳነ ጋዶ እስራኤለ ቦላ ኤህያ ሀይቆ ኪታንቾ ኪተይሳፈ አዉሳ ዶራይ? ታና ኪትዳይሳስ ኦዳናባ ታዉ ኦዳ” ያግስ።<verse eid="1CH 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13"/>ዳዊቲ ጋደኮ፥ “ታኒ ዳሮ ኡንኤታስ። ጎዳ ማሮታይ ግታ ግድያ ግሾ ታኒ እያ ኩሸን ኩንዳና፤ አሳ ኩሸን ኩንድከ” ያግስ።<verse eid="1CH 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14"/>ሄሳ ግሾ፥ ጎዳይ እስራኤለ ቦላ ጋዶ የድን፥ 70,000 እስራኤለ አሳት ሀይቅዶሶና። <verse eid="1CH 21:14"/><verse number="15" style="v" sid="1CH 21:15"/>ፆሳይ የሩሳላመ ይሳናዉ ኪታንቾ ኪትስ። ሽን ኪታንቾይ የሩሳላመ ይሳናዉ ዶምዳ ዎደ ጎዳይ አዛንስ። ይስያ ኪታንቹዋኮ፥ “አጋ! ህዛ ግዳና!” ያግስ። ሄ ዎደ ጎዳ ኪታንቾይ ያቡሰ አድያ ኦርና ዉዱማ ማታን ኤቅስ።<verse eid="1CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16"/>ኪታንቾይ ባ ማሻ ባ ኩሸን ኦይክድ የሩሳላመ ይሳናዉ ሳአፐነ ሳሎፐ ግዶን ኤቅዳይሳ ዳዊቲ በእስ። ሄ ዎደ ዳዊቲነ ጭማት ካዮ ማኦ ማእድ፥ ሳአን ጉፋንዶሶና። <verse eid="1CH 21:16"/><verse number="17" style="v" sid="1CH 21:17"/>ዳዊቲ፥ “አሳይ ታይበታና መላ ኦዳይ ታና ግድክና? ናቅዳይነ ኢታባ ኦዳይ ታና። ሽን ሀ ዶርሳት አይ ኦዶና? አቤት ጎዳዉ፥ ታ ፆሳዉ፥ ሀያና ነ ኩሸይ ታናነ ታ ሶ አሳ ሴሮ። ነ ኩሸይ ነ አሳ ሴሮፖ!” ያግስ።<verse eid="1CH 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18"/>ጎዳ ኪታንቾይ ጋደኮ ሀይሳዳ ያግስ፤ “ዳዊቲ ያቡሰ አድያ ኦርና ዉዱማ ብድ ጎዳስ ያርሾ በሲ ግምባና መላ ኦዳ” ያግስ። <verse eid="1CH 21:18"/><verse number="19" style="v" sid="1CH 21:19"/>ጎዳ ሱንን ጋድ ኦድዳይሳ ስእድ ዳዊቲ ብስ።<verse eid="1CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20"/>ሄ ዎደ ኦርንነ እያ ኦይዱ አደ ናይት ዉዱማን ግስተ ቆፆሶና። እ ጉየ ስሚድ ኪታንቾ በእስ፤ እያራ ደእያ ኦይዱ ናይት በእድ ቆሰትዶሶና። <verse eid="1CH 21:20"/><verse number="21" style="v" sid="1CH 21:21"/>ዳዊቲ ኦርናኮ ይዳ ዎደ ኦርን እያ በእድ፥ ዉዱማፈ ጋፃ ከይድ ዝግድ ሳሮስ።<verse eid="1CH 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22"/>ዳዊቲ፥ “ጋዶይ አሳ ቦላፈ ክቻና መላ ታኒ ጎዳስ ያርሾ በሲ ኬፃና መላ ነ ዉዱማ ታዉ ባይዛ። ታኒ ነዉ ኩመ ጋትያ ቃንፃና” ያግስ።<verse eid="1CH 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23"/>ኦርን፥ “ኤካ፤ ታ ጎዳይ ካዎይ ባና ኡፋይስያባ ኦ። ሄኮ፥ ቦራት ፁሳ ያርሾስ፥ ካ ቡክያ ሚሽያ ኤናዉ፥ ግስተ ካ ያርሾስ እማና። ታኒ ሀ ኡባ ነዉ እማና” ያግስ።<verse eid="1CH 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24"/>ሽን ካዎይ ዳዊቲ፥ “አካይ፥ ታኒ ኩመ ጋተ ቃንፃዳ ሻማና። ታኒ ነባነ ታ ሚሸን ሻሞናባ ኤካዳ ፁሳ ያርሾ ኦዳ ጎዳስ ያርሽከ” ያግስ።<verse eid="1CH 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25"/>ዳዊቲ ዉዱማ ኡሱፑን ፄቱ ዎርቃ ሳንትመን ሻምስ። <verse eid="1CH 21:25"/><verse number="26" style="v" sid="1CH 21:26"/>ዳዊቲ ያን ጎዳስ ያርሾ በሲ ኬፅስ። ያትድ ፁሳ ያርሾነ እስፈተ ያርሾ ያርሽስ። ጎዳ ዎስን፥ ጎዳይ ፁሳ ያርሹዋ ቦላ ሳሎፐ ታማ የድድ እያዉ ዛርስ።<verse eid="1CH 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27"/>ጎዳይ ኪታንቹዋ ኪትን፥ ኪታንቾይ ባ ማሻ ሾሁዋን ዛርስ። <verse eid="1CH 21:27"/><verse number="28" style="v" sid="1CH 21:28"/>ዳዊቲ፥ ጎዳይ እያ ዎሳ ዛርዳይሳ በእድ፥ ያቡሰ አድያ ኦርና ዉዱማን ዛሪድ ያርሽስ። <verse eid="1CH 21:28"/><verse number="29" style="v" sid="1CH 21:29"/>ሙሰይ መላ ቢታን ጊግስዳ፥ ጎዳ ዱንካነይነ ፁሳ ያርሾ በሳይ ሄ ዎደ ጋባኦናን ጎይንያ ቃ በሳን ደኤስ። <verse eid="1CH 21:29"/><verse number="30" style="v" sid="1CH 21:30"/>ሽን ዳዊቲ ጎዳ ኪታንቹዋ ማሻ ያይዳ ግሾ ፆሳ ኦይቻናዉ ሄ በሳ ባናዉ ዳንዳእቤና።<verse eid="1CH 21:30"/></para>
  <chapter eid="1CH 21"/>
  <chapter number="22" style="c" sid="1CH 22"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1"/>ሄሳፈ ጉየ፥ ዳዊቲ፥ “ጎዳ ፆሳ ኬይነ እስራኤለ አሳይ ፁሳ ያርሾ በሳይ ሀይሳን ግዳና” ያግስ።<verse eid="1CH 22:1"/></para>
  <para style="s1">ፆሳ ኬ ኬፃናዉ ጊገተ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2"/>ዳዊቲ እስራኤለ ቢታን ደእያ በተ አሳታ ሺሻና መላ ኪትስ። ፆሳ ኬ ኬፃናዉ ሹቹ ማሰይሳት ማስድ ሎይና መላ ኤንታ ግዶፈ ዶርስ። <verse eid="1CH 22:2"/><verse number="3" style="v" sid="1CH 22:3"/>ዳዊቲ፥ ድርሳ ፐንግያ ጊግሳናዉ ምስማረነ ማፃፈ ቆፃናዉ ዳሮ ብራታነ ዛው ባይና ናሰ ብራታ ጊግስስ። <verse eid="1CH 22:3"/><verse number="4" style="v" sid="1CH 22:4"/>ስዶናነ ፅሮሳ አሳት ዳዊታስ ዝጋ ኤህያ ግሾ ዳዊቲ፥ ታይቦይ ባይና ዝጋ ጊግስስ። <verse eid="1CH 22:4"/><verse number="5" style="v" sid="1CH 22:5"/>ዳዊቲ፥ “ታ ናአይ ሶሎሞነይ ዮጋነ ኤራተን ሎህቤና። ጎዳስ ኬፀትያ ኬይ ቢታ ኡባን ኤረትዳነ ቦንቸትዳ ሎኦ ኬ ግዳናዉ በሴስ። ሄሳ ግሾ፥ እያዉ ኮሽያባ ታኒ ጊግሳና” ያግስ። ዳዊቲ ሀይቃናፐ ስን ዳሮባ ጊግስድ ዎስ።<verse eid="1CH 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6"/>ሄሳፈ ጉየ፥ ዳዊቲ ባ ናኣ ሶሎሞነ ፄግድ፥ ጎዳስ እስራኤለ ፆሳስ ኬ ኬፃና መላ ኪትስ። <verse eid="1CH 22:6"/><verse number="7" style="v" sid="1CH 22:7"/>ዳዊቲ ሶሎሞነኮ፥ “ታ ናአዉ፥ ታኒ ጎዳ ታ ፆሳ ሱንስ ኬ ኬፃናዉ ታ ዎዛናን ቆፓስ። <verse eid="1CH 22:7"/><verse number="8" style="v" sid="1CH 22:8"/>ግዶሽን፥ ጎዳ ቃላይ፥ ‘ኔኒ ዳሮ ሱ ጉሳዳሳ፤ ዳሮ ኦላ ኦለታዳሳ። ኔኒ ሀ ሳኣ ቦላ ታ ስንን ዳሮ ሱ ጉስዳ ግሾ ታ ሱንስ ኬ ኬፃካ። <verse eid="1CH 22:8"/><verse number="9" style="v" sid="1CH 22:9"/>ግዶሽን፥ ሳሮነ ሸምፖ ግድዳ ናእ የለታና፤ እያ ዩሹዋን ደእያ ሞርከታፐ ታኒ እያ ሸምፕሳና። እያ ሱንይ ሶሎሞነ፤ ታኒ እያ ካዎተ ላይን እስራኤለ አሳስ ሳሮተነ ዎፓ እማና። <verse eid="1CH 22:9"/><verse number="10" style="v" sid="1CH 22:10"/>እ ታ ሱንስ ኬ ኬፃና። እ ታ ናአ ግዳና፤ ታኒ እያዉ አዋ ግዳና። እያ አራታ እስራኤለን መርናዉ ምንዳ ኤሳና’ ” ያግስ።<verse eid="1CH 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11"/>“ህዛ ታ ናአዉ፥ ጎዳይ ኔራ ግዶ። ጎዳ ነ ፆሳ ኬ ኬፃና መላ ጎዳይ ካሰ ኦድዳይሳዳ ነና ፖልሶ። <verse eid="1CH 22:11"/><verse number="12" style="v" sid="1CH 22:12"/>ጎዳይ ነና እስራኤለ አሳ ቦላ ካዎ ኦያ ዎደ፥ ጎዳ ነ ፆሳ ህግያ ናጋና መላ ጎዳይ ነዉ ጭንጫተነ አኬካ እሞ። <verse eid="1CH 22:12"/><verse number="13" style="v" sid="1CH 22:13"/>ጎዳይ ሙሰ ባጋራ እስራኤለስ እምዳ ዎጋነ ኪታ ኔኒ ናግኮ ኡባይ ነዉ ሀናና። ምና፤ ያዮፋ፤ ዳጋሞፋ፥ ኡፋይስ ቃንፆፋ! <verse eid="1CH 22:13"/><verse number="14" style="v" sid="1CH 22:14"/>ታኒ ታዉ ዳንዳኤትዳ መላ ጎዳ ኬ ኬፃናዉ 3,400 ክሎ ግራመ ዎርቃ፥ 34,000 ክሎ ግራመ ብራ፥ ዛው ባይና ናሰነ ብራታ ሺሻስ፤ ሄሳዳካ ምነ ሹቹ ጊግሳስ። ነካ ነ ባጋራ ሄሳ ቦላ ሀራ ጉጃናዉ ኮሼስ። <verse eid="1CH 22:14"/><verse number="15" style="v" sid="1CH 22:15"/>ነ ማታን ዳሮ ኦሳንቾት ሹቹ ቆኤይሳትነ ማሰይሳት፥ አናፀትነ ኡባ ኦሶ ኦናዉ ዳንዳእያ ሂላንቾት ደኦሶና። <verse eid="1CH 22:15"/><verse number="16" style="v" sid="1CH 22:16"/>ዎርቃ፥ ብራ፥ ናሰነ ብራታ ኦያ አሳስ ዛው ባዋ። ህዛ ኔኒ ኦሱዋ ዶማ፤ ጎዳይ ኔራ ግዶ” ያግስ።<verse eid="1CH 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17"/>እስራኤለ ካለይሳት ኡባይ ባ ናኣ ሶሎሞነ ማዳና መላ ዳዊቲ ሀይሳዳ ያግድ ኪትስ፤ <verse eid="1CH 22:17"/><verse number="18" style="v" sid="1CH 22:18"/>“ጎዳይ፥ ህንተ ፆሳይ ሀእ ጋካናዉ ህንተራ ደኤነዬ? እ ህንተና ኡባ ባጋራ ሸምፕስበነዬ? ሀ ቢታን ደእያ አሳ እ ታ ኩሸን አድ እምዳ ግሾ ሀ ቢታይ ጎዳስነ እያ አሳስ ሃረትስ። <verse eid="1CH 22:18"/><verse number="19" style="v" sid="1CH 22:19"/>ህዛ ጎዳ ህንተ ፆሳ ኮያናዉ ህንተ ዎዛናነ ህንተ ሸምፑዋ እምተ። ጎዳ ሱንስ ኬፀትዳ ኬ ግዶን ጎዳ ጫቆ ታቦትያነ ፆሳ ጌሻ ሚሸታ ኤህድ ዎና መላ ደንድድ ጎዳ ፆሳ ኬ ኬፅተ” ያግስ።<verse eid="1CH 22:19"/></para>
  <chapter eid="1CH 22"/>
  <chapter number="23" style="c" sid="1CH 23"/>
  <para style="s1">ሌወታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1"/>ዳዊቲ ጭምዳ ዎደ ባ ናኣ ሶሎሞነ እስራኤለ ቦላ ካዎስ።<verse eid="1CH 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2"/>ዳዊቲ እስራኤለ ካለይሳታ ኡባ፥ ካህነታነ ሌወታ እስፈ ሺሽስ። <verse eid="1CH 23:2"/><verse number="3" style="v" sid="1CH 23:3"/>ላይ ሀስታማነ እያፐ ቦላ ግድዳ ሌወት ታይበትድ ኩመ 38,000 ግድዶሶና። <verse eid="1CH 23:3"/><verse number="4" style="v" sid="1CH 23:4"/>ኤንታፈ ጎዳ ኬ አዋተን አይስያ 24,000 ሌወታ ካዎይ ዎስ፤ 6,000 ሌወታ ሀላቃታነ ፕርዳ ዳይናታ ኦድ ዎስ። <verse eid="1CH 23:4"/><verse number="5" style="v" sid="1CH 23:5"/>4,000 ሌወታ ፐንገ ናገይሳታ ኦድ ዎስ። ቃስ ጎዳ ጋላታናዉ ዳዊቲ ጊግስዳ የ ሚሸን ጎዳ ጋላትያ 4,000 ሌወታ ዎስ።<verse eid="1CH 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6"/>ዳዊቲ ሌወ አደ ናይታ ገድሶና፥ ቃሃታነ ማራራ ኤንታ ያራን ያራን ሄ ጩጋን ሻክስ።<verse eid="1CH 23:6"/></para>
  <para style="s2">ገድሶናታ</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7"/>ገድሶና አደ ናይት ላእዳነነ ሳምአ። <verse eid="1CH 23:7"/><verse number="8" style="v" sid="1CH 23:8"/>ላእዳነ ሄ አደ ናይት ይኤላ፥ ዘታማነ እዩኤላ። <verse eid="1CH 23:8"/><verse number="9" style="v" sid="1CH 23:9"/>ሳመአ ሄ አደ ናይት ሳሎሞታ፥ ሀዝኤላነ ሀራና፤ ሀይሳቲ ላእዳነ ያራ ሀላቃታ። <verse eid="1CH 23:9"/><verse number="10" style="v" sid="1CH 23:10"/>ሳማአ ኦይዱ አደ ናይት ያሃታ፥ ዚዛ፥ ኡሳነ ባርአ። <verse eid="1CH 23:10"/><verse number="11" style="v" sid="1CH 23:11"/>ኡስ ባይራ፥ ዚዝ ካሎ። ሽን ኡሳስነ ባርአስ ናይት ዳሮና ግሾ ኤንቲ እስ ያራዳ ታይበትዶሶና።<verse eid="1CH 23:11"/></para>
  <para style="s2">ቃሃተታ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 23:12"/>ቃሃታ ኦይዱ አደ ናይት አንባራማ፥ ይስሃራ፥ ከብሮናነ ኡዝኤላ። <verse eid="1CH 23:12"/><verse number="13" style="v" sid="1CH 23:13"/>አንባራማ አደ ናይት አሮናነ ሙሰ። አሮንነ እያ ኮቻይ ኡባፈ ጌሽ ግዳና መላ ዱማትዶሶና። ኤንቲ ጎዳ ስንን እፃነ ጩይሳናዉ፥ ጎዳስ ኦናዉነ ጎዳ ሱንን አሳ አንጃናዉ መርናዉ ዱማትዶሶና። <verse eid="1CH 23:13"/><verse number="14" style="v" sid="1CH 23:14"/>ፆሳ አሰ ግድዳ ሙሰ ናይታ ሌወ ኮቻታራ ጋድ ታይብዶሶና። <verse eid="1CH 23:14"/><verse number="15" style="v" sid="1CH 23:15"/>ሙሰ ናይት ገድሶና አላዛራ። <verse eid="1CH 23:15"/><verse number="16" style="v" sid="1CH 23:16"/>ገድሶና ናይታ ግዶፈ ሀላቃይ ሳቡኤላ። <verse eid="1CH 23:16"/><verse number="17" style="v" sid="1CH 23:17"/>አላዛራ ናአይ ራሃባ። አላዛራስ ሀራ ናእ ባዋ፤ ሽን ራሃባስ ናይት ዳሮ።<verse eid="1CH 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 23:18"/>ይስሃራ ናይታ ሀላቃይ ሳሎምታ። <verse eid="1CH 23:18"/><verse number="19" style="v" sid="1CH 23:19"/>ከብሮና ናአይ ባይራይ ይርያ፤ ካሎይ አማረ፤ ሄንይ ያሀዝኤላ፤ ኦይዳንይ ያቅምኣማ። <verse eid="1CH 23:19"/><verse number="20" style="v" sid="1CH 23:20"/>ኡዝኤላ ባይራ ናአይ ምክያሳ፤ ካሎይ ይሽያ።<verse eid="1CH 23:20"/></para>
  <para style="s2">ማራራታ</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21"/>ማራራ ናይት ማህላነ ሙሳ። ማህላ ናይት አላዛራነ ቂሳ። <verse eid="1CH 23:21"/><verse number="22" style="v" sid="1CH 23:22"/>አላዛር ማጫ ናአፐ አትሽን፥ አደ ናአ የሎና ሀይቅስ። ሄሳ ግሾ፥ ኤንታ አዋ እሻ ቂሳ ናይት ኤንታ ማችዶሶና። <verse eid="1CH 23:22"/><verse number="23" style="v" sid="1CH 23:23"/>ሙሳ ሄ ናይት ማህላ፥ ኤደራነ ይረሞታ።<verse eid="1CH 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24"/>ሌወ የለታን ባንታ ኮቻንነ ሶ አሳን ባንታ ሱንን ማዝጋበትዳ ሌወ ኮቻት ሀይሳታ። ላይ ላታማነ እያፐ ቦላ ግድዳ ሌወ ኮቻት ኡባይ ጎዳ ፆሳ ኬን ኦዶሶና። <verse eid="1CH 23:24"/><verse number="25" style="v" sid="1CH 23:25"/>ዳዊቲ፥ “ጎዳይ፥ እስራኤለ ፆሳይ ባ አሳ ሸምፕስስ። ጎዳይ የሩሳላመን መርናዉ ዳና። <verse eid="1CH 23:25"/><verse number="26" style="v" sid="1CH 23:26"/>ሌወት ዱንካንያነ እያ ግዶን ጎኤትያ ሚሸታ ህዛፐ ጉየ ቶካናዉ በሰና” ያግስ። <verse eid="1CH 23:26"/><verse number="27" style="v" sid="1CH 23:27"/>ዳዊቲ ዉርሰ ኪታን፥ ላይ ላታማነ እያፐ ቦላ ግድዳ ሌወት ታይበትዶሶና። <verse eid="1CH 23:27"/><verse number="28" style="v" sid="1CH 23:28"/>ኤንቲ ጎዳ ፆሳ ኬን ኦያ አሮና ኮቻታ ማዶሶና። ጎዳ ፆሳ ኬን ካረራነ ሶራ ኦሶና፤ ጌሻ ሚሸ ኡባ ቱኖና መላ ናጎሶና። <verse eid="1CH 23:28"/><verse number="29" style="v" sid="1CH 23:29"/>ኤንቲ ፆሳ ስንን ዎያ ኡይ፥ ካ ያርሾስ ሺሽያ ልያ፥ እርሾይ ባይና ኡይነ ዛይተራ ሙኑቀትያ ልያ አዋተን አይሶሶና፤ ፆሳ ኬን ማከትያባነ ልከያባ ኡባ አዋተን ፄሎሶና። <verse eid="1CH 23:29"/><verse number="30" style="v" sid="1CH 23:30"/>ቃስ ኤንቲ ኡባ ጋላስ ዎንታነ ኦማርስ ጎዳ ጋላታናዉነ ሳባናዉ ኤቆሶና። <verse eid="1CH 23:30"/><verse number="31" style="v" sid="1CH 23:31"/>ሳምባታ ጋላስ፥ አጌና ፄሮን፥ ዎጋይ ኪትያ ሀራ ባኣለ ጋላሳይ ጋክያ ዎደ ጎዳስ ፁሳ ያርሾ ያርሾሶና። ኤንታዉ እመትዳ ታይቡዋዳነ ኪታዳ ኡባ ዎደ ጎዳ ስንን ኦሶና። <verse eid="1CH 23:31"/><verse number="32" style="v" sid="1CH 23:32"/>ዱንካንያነ ጎዳ ፆሳ ኬ ናጋና መላነ ባንታ እሻ ግድዳ፥ አሮና አደ ናይታ፥ ማዳና መላ አዋተ ሌወታስ እመትስ።<verse eid="1CH 23:32"/></para>
  <chapter eid="1CH 23"/>
  <chapter number="24" style="c" sid="1CH 24"/>
  <para style="s1">ካህነታ ኦሶ ሻሁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1"/>አሮና ኮቻት ባንታ ኦሶ ማራን ሀይሳፈ ካልድ ፃፈትዳይሳታ። አሮና አደ ናይት ናዳባ፥ አብዮዳ፥ አላዛራነ እታማራ። <verse eid="1CH 24:1"/><verse number="2" style="v" sid="1CH 24:2"/>ሽን ናዳበይነ አብዮዳ ናአ የሎና ባንታ አዋፐ ስን ሀይቅዶሶና። ሄሳ ግሾ፥ አላዛርነ እታማር ካህነ ግድዶሶና። <verse eid="1CH 24:2"/><verse number="3" style="v" sid="1CH 24:3"/>ዳዊቲ አላዛራ ያራፐ ሳዶቃ፥ እታማራ ያራፐ አብመለከ ኤክድ አሮና ኮቻታ ኤንታ ኦሱዋ ማራን ጩጋን ጩጋን ሻክስ። <verse eid="1CH 24:3"/><verse number="4" style="v" sid="1CH 24:4"/>አላዛራ ያራታ ሀላቃት እታማራ ያራታ ሀላቃታፐ ዳር በንትዳ ግሾ አላዛራ ያራት ታማነ ኡሱፑን ጩጋን ሻከትን እታማራ ያራት ሆስፑን ጩጋን ሻከትዶሶና። <verse eid="1CH 24:4"/><verse number="5" style="v" sid="1CH 24:5"/>አላዛራ ያራታ ግዶንነ እታማራ ያራታ ግዶን ፆሳ ኬ ሀላቃትነ ፆሳ ኦሱዋስ በሲያ ሀላቃት ደእያ ግሾ ኦሶይ ኤንታዉ ሳማን ሻከቴስ። <verse eid="1CH 24:5"/><verse number="6" style="v" sid="1CH 24:6"/>አላዛራ ያራትነ እታማራ ያራት ባንታ ማራን ማራን ሳማ ከስዶሶና። ሌወ ኮቸ ግድዳ ናትናኤላ ናአይ ፃፈይ ሻማየይ ኤንታ ማዝጋቤስ። ካዎይነ እያ ሞርናት፥ ካህነይ ሳዶቅነ አብያታራ ናአይ አብመለከይ፥ ካህነታነ ሌወታ ያራታ ሀላቃት ኡባይ ሄሳስ ማርካ።<verse eid="1CH 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 24:7"/>ኮይሮ ሳማይ ዮኣርባስ ከይስ፤ ናምአንይ ያዳያስ ከይስ። <verse eid="1CH 24:7"/><verse number="8" style="v" sid="1CH 24:8"/>ሄንይ ሀርማስ ከይስ። ኦይዳንይ ሳኦርማስ ከይስ። <verse eid="1CH 24:8"/><verse number="9" style="v" sid="1CH 24:9"/>እቻሻንይ ማልክያስ ከይስ። ኡሱፑንይ ምያምናስ ከይስ። <verse eid="1CH 24:9"/><verse number="10" style="v" sid="1CH 24:10"/>ላፑንይ አቆሳስ ከይስ፤ ሆስፑንይ አብያስ ከይስ። <verse eid="1CH 24:10"/><verse number="11" style="v" sid="1CH 24:11"/>ኡዱፉንይ እያሱስ ከይስ። ታማንይ ሳካናስ ከይስ። <verse eid="1CH 24:11"/><verse number="12" style="v" sid="1CH 24:12"/>ታማነ እስንይ ኤልያሴባስ ከይስ። ታማነ ናምአንይ ያቅናስ ከይስ። <verse eid="1CH 24:12"/><verse number="13" style="v" sid="1CH 24:13"/>ታማነ ሄንይ ሁፓስ ከይስ። ታማነ ኦይዳንይ የሸባስ ከይስ። <verse eid="1CH 24:13"/><verse number="14" style="v" sid="1CH 24:14"/>ታማነ እቻሻንይ ብልጋስ ከይስ። ታማነ ኡሱፑንይ እመራስ ከይስ። <verse eid="1CH 24:14"/><verse number="15" style="v" sid="1CH 24:15"/>ታማነ ላፑንይ ሄዝራስ ከይስ። ታማነ ሆስፑንይ ሀፍፄፃስ ከይስ። <verse eid="1CH 24:15"/><verse number="16" style="v" sid="1CH 24:16"/>ታማነ ኡዱፉንይ ፓታሀስ ከይስ። ላታማንይ የዘከላስ ከይስ። <verse eid="1CH 24:16"/><verse number="17" style="v" sid="1CH 24:17"/>ላታማነ እስንይ ያክናስ ከይስ። ላታማነ ናምአንይ ጋሙላስ ከይስ። <verse eid="1CH 24:17"/><verse number="18" style="v" sid="1CH 24:18"/>ላታማነ ሄንይ ዳላያስ ከይስ። ላታማነ ኦይዳንይ ማዛስ ከይስ።<verse eid="1CH 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19"/>ጎዳይ እስራኤለ ፆሳይ ኤንታ ማይዛ አሮና ኪትን፥ እ ኤንታዉ ዎዳ ዎጋ፥ ባንታ ፆሳ ኬ ገልያ ዎደ፥ ኤንቲ ኦና ማራይ ሀይሳ።<verse eid="1CH 24:19"/></para>
  <para style="s1">ሀራ ሌወታ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20"/>ሀራ ሌወ ኮቻታ ሀላቃት፥ ሀይሳፈ ካልድ ፃፈትዳይሳታ።</para>
  <para style="p" vid="1CH 24:20">የህዳይ ሳቡኤላ ባጋራ አምራማ ኮቸ።<verse eid="1CH 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 24:21"/>ይሸይ ራሃባ ኮቸ።<verse eid="1CH 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 24:22"/>ያሃት ሳሎምታ ባጋራ ይስሃራ ኮቸ።<verse eid="1CH 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 24:23"/>ይርየይ፥ አማረይ፥ ያሀዝኤልነ ይቃምኣም ከብሮና ኮቸ።<verse eid="1CH 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 24:24"/>ሻምር ምክያሳ ባጋራ ኡዝኤላ ኮቸ።<verse eid="1CH 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 24:25"/>ዛካርያስ ምክያሳ እሻ ይሽያ ባጋራ ኡዝኤላ ኮቸ።<verse eid="1CH 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 24:26"/>ማህል፥ ሙስነ ያእዝ ማራራ ኮቻታ። <verse eid="1CH 24:26"/><verse number="27" style="v" sid="1CH 24:27"/>ያእዛ ሄ አደ ናይት ሾሃማ፥ ዛኩራነ እባራ። <verse eid="1CH 24:27"/><verse number="28" style="v" sid="1CH 24:28"/>ማህላ ናምኡ አደ ናይት አላዛራነ ቂሳ። አላዛራስ አደ ናእ ባዋ። <verse eid="1CH 24:28"/><verse number="29" style="v" sid="1CH 24:29"/>ቂሳ ይራህማኤላ ጌተትያ አደ ናእ ደኤስ። <verse eid="1CH 24:29"/><verse number="30" style="v" sid="1CH 24:30"/>ሙሳ ሄ አደ ናይት ማህላ፥ ኤደራነ ይረሞታ።</para>
  <para style="p" vid="1CH 24:30">ሀይሳቲ ሌወ ኮቻታ ሀላቃታ።<verse eid="1CH 24:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31"/>ካሰ ኤንታ ዳቦት አሮና ኮቸ ግድዳ ካህነት ኦዳይሳዳ ሀይሳቲካ ካዎይ ዳዊቲ፥ ሳዶቅ፥ አብመለከይ፥ ካህነታነ ሌወታ ሀላቃት ደእያ በሳን ሳማ የግዶሶና። ባይራ እሻ ሶ አሳስነ ካሎ እሻ ሶ አሳስ እስ ግና ሳም ዎስ።<verse eid="1CH 24:31"/></para>
  <chapter eid="1CH 24"/>
  <chapter number="25" style="c" sid="1CH 25"/>
  <para style="s1">ፆሳ ኬ ዛማረታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1"/>ዳዊቲነ ሌወታ ሀላቃት፥ አሳፋ፥ ሄማናነ የዱቱና ናይታፐ ሱሱልኤን፥ ዲንነ ዳላን ትንብተ ኦዳና መላ ዱማይዶሶና። ሀ ኦሱዋስ ዱማትዳ አሳ ሱንይ ሀይሳፈ ካልድ ፃፈትዳይሳ።<verse eid="1CH 25:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 25:2"/>አሳፋ ናይት ዛኩራ፥ ዮሰፋ፥ ናታናነ አሳርኤላ። አሳፋ ናይት አሳፋፐ ጋርሳራ ኦሶና፤ አሳፍ ካዋ ኪታን ትንብተ ኦዴስ።<verse eid="1CH 25:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 25:3"/>የዱቱና ናይት ጋዳልያ፥ ፃራ፥ ያሻያ፥ ሳምአ፥ ሀሳባያነ ማትታ። ሀ ኡሱፑናት ማስንቆን ጎዳ ጋላትሸነ ቦንችሸ ባንታ አዋ፥ ናብያ የዱቱናፐ ጋርሳራ ኪተቶሶና።<verse eid="1CH 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 25:4"/>ሄማና ናይት ቡቃያ፥ ማታና፥ ኡዝኤላ፥ ሳቡኤላ፥ ያርሞታ፥ ሀናንያ፥ ሀናና፥ ኤልኣታ፥ ግዳልታ፥ ኦሮማንትኤዘራ፥ ዮሽባቃሻ፥ ማሎታ፥ ሆትራነ ማዝኣታ። <verse eid="1CH 25:4"/><verse number="5" style="v" sid="1CH 25:5"/>ሀይሳቲ ኡባይ ካዋስ ቆንጨ በእያ ሄማና ናይታ። ፆሳይ እማና ግዳይሳዳ ሄማና ቁ ቁ ኦና መላ ሀ ታማነ ኦይዱ አደ ናይታነ ሄ ማጫ ናይታ እያዉ እሚስ። <verse eid="1CH 25:5"/><verse number="6" style="v" sid="1CH 25:6"/>ሀይሳቲ ኡባይ ፆሳ ኬን ዳላ ቃናዉ፥ ዲነ ማስንቆ ካእድ ጎይናናዉ ባንታ አዋፐ ጋርሳራ ደኦሶና።</para>
  <para style="p" vid="1CH 25:6">አሳፍ፥ የዱቱንነ ሄማን ካዉዋፐ ጋርሳራ ደኦሶና። <verse eid="1CH 25:6"/><verse number="7" style="v" sid="1CH 25:7"/>ሄሳት ባንታ ዳቦታራ ግድድ ፆሳስ ሺቅያ ማዝሙረን ሎህዳይሳታ፤ ኤንቲ ኩመ 288. <verse eid="1CH 25:7"/><verse number="8" style="v" sid="1CH 25:8"/>ኤንቲ ባንታ ኦሱዋ ሻክድ ኤራናዉ ናእ ጭም፥ አስታማረይ ታማረይ ሻሆይ ባይና ሳማ የግዶሶና።<verse eid="1CH 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 25:9"/>ኮይሮ ሳማይ አሳፋ ናኣ ዮሰፋስ ከይስ። ናምአን ሳማይ ጋዳላስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:9"/><verse number="10" style="v" sid="1CH 25:10"/>ሄን ሳማይ ዛኩራስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:10"/><verse number="11" style="v" sid="1CH 25:11"/>ኦይዳን ሳማይ ፃራስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:11"/><verse number="12" style="v" sid="1CH 25:12"/>እቻሻን ሳማይ ናታናስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:12"/><verse number="13" style="v" sid="1CH 25:13"/>ኡሱፑን ሳማይ ቡቃያስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:13"/><verse number="14" style="v" sid="1CH 25:14"/>ላፑን ሳማይ ይሽራኤላስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:14"/><verse number="15" style="v" sid="1CH 25:15"/>ሆስፑን ሳማይ ያሻያስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:15"/><verse number="16" style="v" sid="1CH 25:16"/>ኡዱፉን ሳማይ ማታናስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:16"/><verse number="17" style="v" sid="1CH 25:17"/>ታማን ሳማይ ሳምአስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:17"/><verse number="18" style="v" sid="1CH 25:18"/>ታማነ እስን ሳማይ ኡዝኤላስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:18"/><verse number="19" style="v" sid="1CH 25:19"/>ታማነ ናምአን ሳማይ ሀሳባያስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:19"/><verse number="20" style="v" sid="1CH 25:20"/>ታማነ ሄን ሳማይ ሳቡኤላስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:20"/><verse number="21" style="v" sid="1CH 25:21"/>ታማነ ኦይዳን ሳማይ ማትታስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:21"/><verse number="22" style="v" sid="1CH 25:22"/>ታማነ እቻሻን ሳማይ ያርሞታስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:22"/><verse number="23" style="v" sid="1CH 25:23"/>ታማነ ኡሱፑን ሳማይ ሀናና ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:23"/><verse number="24" style="v" sid="1CH 25:24"/>ታማነ ላፑን ሳማይ ዮሽባቃሻስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:24"/><verse number="25" style="v" sid="1CH 25:25"/>ታማነ ሆስፑን ሳማይ ሀናንያስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:25"/><verse number="26" style="v" sid="1CH 25:26"/>ታማነ ኡዱፉን ሳማይ ማሎታስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:26"/><verse number="27" style="v" sid="1CH 25:27"/>ላታማን ሳማይ ኤልኣታስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:27"/><verse number="28" style="v" sid="1CH 25:28"/>ላታማነ እስን ሳማይ ሆትራስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:28"/><verse number="29" style="v" sid="1CH 25:29"/>ላታማነ ናምአን ሳማይ ግዳልታስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:29"/><verse number="30" style="v" sid="1CH 25:30"/>ላታማነ ሄን ሳማይ ማህዝኣታ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ። <verse eid="1CH 25:30"/><verse number="31" style="v" sid="1CH 25:31"/>ላታማነ ኦይዳን ሳማይ ኦሮማንትኤዘራስ ከይስ፤ እ፥ እያ ናይትነ እያ ዳቦት ኩመ ታማነ ናምአ።<verse eid="1CH 25:31"/></para>
  <chapter eid="1CH 25"/>
  <chapter number="26" style="c" sid="1CH 26"/>
  <para style="s1">ፆሳ ኬ ፐንገ ናገይሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1"/>ፆሳ ኬ ፐንግያ ናገይሳት ሀይሳፈ ካልድ ፃፈትዳይሳታ።</para>
  <para style="p" vid="1CH 26:1">ኮይሮይ ቆረ ኮቻፈ አሳፋ አደ ናይታፐ ቆረ ናአ ማሱላማ። <verse eid="1CH 26:1"/><verse number="2" style="v" sid="1CH 26:2"/>ማሱላም ላፑን አደ ናይታ የልስ፤ ኤንቲ ባንታ የለታ ማራን ዛካርያሳ፥ ይድኤላ፥ ዮዞባታ፥ ያትንኤላ፥ <verse eid="1CH 26:2"/><verse number="3" style="v" sid="1CH 26:3"/>ኤላማ፥ ይሆናነ ኤልሆና።<verse eid="1CH 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 26:4"/>ፆሳይ ኦቤድ-ኤዶማ አንጅዳ ግሾ፥ እ ሆስፑን አደ ናይታ የልስ። ኤንቲ ባንታ የለታ ማራን ሻማያ፥ ዮዛባታ፥ እዮኣሳ፥ ሳካራ፥ ናትናኤላ፥ <verse eid="1CH 26:4"/><verse number="5" style="v" sid="1CH 26:5"/>አምኤላ፥ ይሳኮራነ ፑላታ። <verse eid="1CH 26:5"/><verse number="6" style="v" sid="1CH 26:6"/>ኦቤድ-ኤዶማ ናአይ ሻማየይ ኡሱፑን አደ ናይታ የልስ፤ ኤንቲ ምኖ አስ ግድዳ ግሾ፥ ባንታ አዋ ሶ አሳስ ሀላቃ ግድዶሶና። <verse eid="1CH 26:6"/><verse number="7" style="v" sid="1CH 26:7"/>ሻማያ ናይት ኦትና፥ ራፋኤላ፥ ዮቤዳነ ኤልዛባዳ፤ ኤንታ እሻት ኤልሁይነ ሳማክ ቃራ አሳታ። <verse eid="1CH 26:7"/><verse number="8" style="v" sid="1CH 26:8"/>ሀይሳቲ ኡባይ ኦቤድ-ኤዶማ ኮቻታ፤ ኤንቲ፥ ኤንታ ናይታነ ኤንታ ዳቦት ኦሶስ ምኖ። ኦቤድ-ኤዶማ ኮቻት ኩመ ኡሱፑን ታማነ ናምአ።<verse eid="1CH 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 26:9"/>ማሱላማስ ምኖ ናይትነ ምኖ ዳቦት ደኦሶና፤ ኤንቲ ኩመ ታማነ ሆስፑና።<verse eid="1CH 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 26:10"/>ማራራ ያራፐ ሆሳ ጌተትያ አድያስ ኦይዱ አደ ናይት ደኦሶና። ሽምር ባይራ ናአ ግደና፥ ሽን እያ አዋይ እያ ሀላቃ ኦስ። <verse eid="1CH 26:10"/><verse number="11" style="v" sid="1CH 26:11"/>እያ እሻት ካልቀ፥ ዛባላነ ዛካርያሳ። ሆሳ ናይትነ እያ ዳቦት ኩመ ታማነ ሄ።<verse eid="1CH 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12"/>ፆሳ ኬ ፐንግያ ናገይሳት ባንታ ሶ አሳ ሀላቃታ ጩጋን ጩጋን ሻከትዶሶና። ሀራ ሌወታዳ ኤንታካ ፆሳ ኬ ኦሶይ ሻሆን ጋክስ። <verse eid="1CH 26:12"/><verse number="13" style="v" sid="1CH 26:13"/>እስ እስ ፐንግያ ናጋናዉ ባንታ ሶ አሳን አሳን ናአ ጭማ ጎና ሳማ የግዶሶና። <verse eid="1CH 26:13"/><verse number="14" style="v" sid="1CH 26:14"/>ዶሎሀ ፐንግያ ናጋናዉ ሳማይ ሳላማስ ከይስ። ሎኦ ዞረ ዞርያ እያ ናኣ ዛካርያሳ ፑደሀ ፐንግያ ናጋናዉ ሳም ከይስ። <verse eid="1CH 26:14"/><verse number="15" style="v" sid="1CH 26:15"/>ኦቤድ-ኤዶማስ ዱገሀ ፐንግያ ናጋናዉ ሳም ከይስ። እያ ናይታስ ቡቁራ ምንጅያ ኬ ናጋናዉ ሳም ከይስ። <verse eid="1CH 26:15"/><verse number="16" style="v" sid="1CH 26:16"/>ዉሎሀ ፐንግያነ ቆሞ ባጋራ ደእያ ሻለኮታ ፐንግያ ናጋናዉ ሳም ሱፍማስነ ሆሳስ ከይስ። ናጎይ ማራን ማራን ጋኬስ።<verse eid="1CH 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 26:17"/>ጋላስ ጋላስ ዶሎሀ ባጋራ ኡሱፑን፥ ፑደሀ ባጋራ ኦይዳ፥ ዱገሀ ባጋራ ኦይዱ ሌወት ናጎሶና። ቃስ ቡቁራ ምንጅያ ኬ ናምኡ ናምኡ ሌወት ናጎሶና። <verse eid="1CH 26:17"/><verse number="18" style="v" sid="1CH 26:18"/>ዉሎሀ ባጋራ ዳባባኮ ኤፍያ ኦግያ ኦይዱ፥ ቃስ ዳባባ ናምኡ ሌወት ናጎሶና። <verse eid="1CH 26:18"/><verse number="19" style="v" sid="1CH 26:19"/>ህዛ ቆረስነ ማራራ ኮቻስ እመትዳ ፐንገ ናጎ ኦሶይ ሀይሳ።<verse eid="1CH 26:19"/></para>
  <para style="s1">ምንጃ ኬ ሹማታ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20"/>አክያ ጌተትያ ሌወይ ፆሳ ኬን ደእያ ቡቁራነ ፆሳስ ዱማይ ዎዳ እሞታታ ናጋናዉ ሹመትስ። <verse eid="1CH 26:20"/><verse number="21" style="v" sid="1CH 26:21"/>ገድሶና ናኣ ላዳና ያራፐ ይኤል ዱማ ዱማ ሶ አሳስ አዋተስ። <verse eid="1CH 26:21"/><verse number="22" style="v" sid="1CH 26:22"/>ይኤላ ናይት ዘታማነ እያ እሻ እዩኤላ፤ ኤንቲ ፆሳ ኬን ደእያ ቡቁራ ናጋናዉ ሹመትዶሶና።<verse eid="1CH 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 26:23"/>አምራማ፥ ይስሃራ፥ ከብሮናነ ኡዝኤላ ያራታስ ኦሶይ ሻከትድ እመትስ። <verse eid="1CH 26:23"/><verse number="24" style="v" sid="1CH 26:24"/>ሙሰ ናኣ ገድሶና ያራ ግድዳ ሳቡኤል ፆሳ ኬን ደእያ ቡቁራ ናገይሳታ ሀላቃታ ቦላ ሹመትስ። <verse eid="1CH 26:24"/><verse number="25" style="v" sid="1CH 26:25"/>እ ገድሶና እሻ አላዛራ ባጋራ ሳሎሞታስ ዳቦ። አልአዛር ራሃብያ የልስ፤ ራሃብ የሻያ የልስ፤ የሻይ ዮራማ የልስ፤ ዮራም ዝክራ የልስ፤ ዝክር ሳሎምታ የልስ። <verse eid="1CH 26:25"/><verse number="26" style="v" sid="1CH 26:26"/>ሳሎሞትነ እያ ዳቦት ካዎይ ዳዊቲ፥ እያ ሶ አሳ ሀላቃት፥ ሻላቃት፥ ማቶ ሀላቃትነ ቶራ ሞጮናታ ፆሳስ ዱማይዳ ሚሸ ኡባ ቦላ ሹመትዶሶና። <verse eid="1CH 26:26"/><verse number="27" style="v" sid="1CH 26:27"/>ሀ አሳት ኦላን ድኤትድ ይዳ ሚሸታፐ ባጋ ፆሳ ኬን ዱማይድ ዎዶሶና። <verse eid="1CH 26:27"/><verse number="28" style="v" sid="1CH 26:28"/>ቆንጨ በእያ ሳሜል፥ ቂሳ ናአይ ሳኦል፥ ኔራ ናአይ አበኔርነ ፃሩያ ናአይ እዮኣብ ካሰ ዱማይድ ዎዳ እሞታ ኡባ ሳሎሞትነ እያ ዳቦት ናጎሶና።<verse eid="1CH 26:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29"/>ይስሃራ ያራታፐ ካናነይነ እያ ናይት ፆሳ ኬፈ ካረራ ደእያ ኦሶን እስራኤለ አሳ አይሳናዉነ ዳይናታናዉ ሹመትዶሶና።<verse eid="1CH 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 26:30"/>ከብሮና ያራታፐ ሀሻብነ እያ ዳቦት 1,700 ምኖ አሳት፥ ጎዳ ኦሱዋስነ ካዋ ኦሱዋስ ዮርዳኖሰፐ ዉሎሀ ባጋራ ደእያ እስራኤለ አሳ ቦላ ሹመትዶሶና። <verse eid="1CH 26:30"/><verse number="31" style="v" sid="1CH 26:31"/>ከብሮና ያራታ ማዝጋብያ ማራን ይርይ ኤንታ ሀላቃ። ዳዊቲ ካዎትዳ ኦይታማን ላይን ማዝጋበን ኮይን ኤንታ አሳ ግዶፈ ምኖ አሳት ጋላዳ ቢታን ያእዜራ ጌተትያ በሳን በንትዶሶና። <verse eid="1CH 26:31"/><verse number="32" style="v" sid="1CH 26:32"/>ኤንታ ሶ አሳስ ሀላቃ ግድዳ ይርያ ዳቦት ምኖት 2,700. ካዎይ ዳዊቲ ፆሳ ኦሱዋስነ ካዋ ኦሱዋስ ሮቤላ፥ ጋደነ ምናሰ ኮቻታፐ ባጋታ ቦላ ኤንታ ሹምስ።<verse eid="1CH 26:32"/></para>
  <chapter eid="1CH 26"/>
  <chapter number="27" style="c" sid="1CH 27"/>
  <para style="s1">እስራኤለ ቶራ ሞጮናታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1"/>ባንታ ጩጋን ጩጋን ካዎተ አይስያ እስራኤለ ሶ አሳ ሀላቃት፥ ሻላቃትነ ማቶ ሀላቃት ሀይሳፈ ካልድ ፃፈትዳይሳታ። እስ እስ ጩጋን 24,000 አሳት ደኦሶና። እስ እስ ጩጋይ ላይን እስ አጌና ማራን ማራን ካዎተ ኦሶ ኦናዉ ከዬስ።<verse eid="1CH 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 27:2"/>ኮይሮ አጌናን ከያ ጩጋ ካለይ ዛብድኤላ ናኣ ያሾብኣማ፤ እያ ጩጋን 24,000 አስ ደኤስ። <verse eid="1CH 27:2"/><verse number="3" style="v" sid="1CH 27:3"/>ያሾብኣም ፓረሳ ኮቸ፤ እ ኮይሮ አጌናስ ቶራ ሞጮናታ።<verse eid="1CH 27:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 27:4"/>ናምአን አጌናን ከይያ ጩጋ ካለይ አሆሀ አድያ ዶዳያ፤ እያ ጩጋን 24,000 አስ ደኤስ። ሄ ጩጋ ካለያ ናምአን ሀላቃይ ምክሎታ።<verse eid="1CH 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 27:5"/>ሄን አጌናን ከይያ ጩጋ ካለይ ካህንያ ዮዳሄ ናኣ ባናያ፤ እያ ጩጋን 24,000 አስ ደኤስ። <verse eid="1CH 27:5"/><verse number="6" style="v" sid="1CH 27:6"/>ባናይ ሀስታሙ ኤረትዳ አሳታ ግዶን ምኖ አስ፤ ቃስ ሀስታማታ ሀላቃ። እያ በሳን እያ ናአይ አምዛባድ ሀላቃ ግድስ።<verse eid="1CH 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 27:7"/>ኦይዳን አጌናን ከይያ ጩጋ ካለይ እዮኣባ እሻ አሳሄላ፤ እያ ጩጋን 24,000 አስ ደኤስ። እያ በሳን እያ ናአይ ዛባድ ሀላቃ ግድስ።<verse eid="1CH 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 27:8"/>እቻሻን አጌናን ከይያ ጩጋ ካለይ ይስሃራ ያራፐ ሻምሁታ፤ እያ ጩጋን 24,000 አስ ደኤስ።<verse eid="1CH 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 27:9"/>ኡሱፑን አጌናን ከይያ ጩጋ ካለይ ተቁሄ አድያ እስካ ናኣ እራ፤ እያ ጩጋን 24,000 አስ ደኤስ።<verse eid="1CH 27:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 27:10"/>ላፑን አጌናን ከይያ ጩጋ ካለይ ኤፍሬማ ኮቸ ግድዳ ፕሎና አድያ ሰለሳ፤ እያ ጩጋን 24,000 አስ ደኤስ።<verse eid="1CH 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 27:11"/>ሆስፑን አጌናን ከይያ ጩጋ ካለይ ሁሻ አድያ ስባካያ፤ እያ ጩጋን 24,000 አስ ደኤስ። ስባካይ ይሁዳ ኮቸነ ዛራ ያራ።<verse eid="1CH 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 27:12"/>ኡዱፉን አጌናን ከይያ ጩጋ ካለይ ብንያመ ኮቸ ግድዳ አናቶተ አድያ አብኤዘራ፤ እያ ጩጋን 24,000 አስ ደኤስ።<verse eid="1CH 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 27:13"/>ታማን አጌናን ከይያ ጩጋ ካለይ ናፆፋ አድያ ዛራ ያራ ግድዳ ማህራ፤ እያ ጩጋን 24,000 አስ ደኤስ።<verse eid="1CH 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 27:14"/>ታማነ እስን አጌናን ከይያ ጩጋ ካለይ ኤፍሬማ ኮቸ ግድዳ ፕርአቶና አድያ ባናያ፤ እያ ጩጋን 24,000 አስ ደኤስ።<verse eid="1CH 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 27:15"/>ታማነ ናምአን አጌናን ከይያ ጩጋ ካለይ ጎቶንያላ ያራፐ ግድዳ ናፆፋ ሄልዳያ፤ እያ ጩጋን 24,000 አስ ደኤስ።<verse eid="1CH 27:15"/></para>
  <para style="s1">እስራኤለ ሞርናታ</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16"/>እስራኤለ ኮቻታ አይሳናዉ ሹመትዳይሳት ሀይሳፈ ካልድ ፃፈትዳይሳታ።</para>
  <para style="p" vid="1CH 27:16">ሮቤላ ኮቻ አይሰይ ዝክራ ናኣ አላዛራ።</para>
  <para style="p" vid="1CH 27:16">ስሞና ኮቻ አይሰይ ማእካ ናኣ ሳፋፃ።<verse eid="1CH 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 27:17"/>ሌወ ኮቻ አይሰይ ቃሙኤላ ናኣ ሀሳባያ።</para>
  <para style="p" vid="1CH 27:17">አሮና ኮቻ አይሰይ ሳዶቃ።<verse eid="1CH 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 27:18"/>ይሁዳ ኮቻ አይሰይ ዳዊታ እሻ ኤልሁ።</para>
  <para style="p" vid="1CH 27:18">ይሳኮራ ኮቻ አይሰይ ምካኤላ ናኣ ኦምራ።<verse eid="1CH 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 27:19"/>ዛብሎና ኮቻ አይሰይ አብድዩ ናኣ ያሽማያ።</para>
  <para style="p" vid="1CH 27:19">ንፍታለመ ኮቻ አይሰይ አዝርኤላ ናኣ ያርሞታ።<verse eid="1CH 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 27:20"/>ኤፍሬማ ኮቻ አይሰይ አዛዛ ናኣ ሆሰአ።</para>
  <para style="p" vid="1CH 27:20">ምናሰ ኮቻፈ ባጋ አይሰይ ፓዳያ ናኣ እዩኤላ።<verse eid="1CH 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 27:21"/>ጋላዳን ደእያ ምናሰ ኮቻፈ ባጋ አይሰይ ዛካርያሳ ናኣ እዶ።</para>
  <para style="p" vid="1CH 27:21">ብንያመ ኮቻ አይሰይ አበኔራ ናኣ የእስኤላ።<verse eid="1CH 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 27:22"/>ዳነ ኮቻ አይሰይ ይሮሃማ ናኣ አዛርኤላ።</para>
  <para style="p" vid="1CH 27:22">ሀይሳቲ እስራኤለ ኮቻ አይሰይሳታ።<verse eid="1CH 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23"/>ጎዳይ እስራኤለ አሳ ሳሎ ፆልንቶዳ ዳርሳና ግዳ ግሾ ዳዊቲ ላታሙ ላይነ እያፐ ጋርሳራ ደኤይሳታ ታይቦን ገልስቤና። <verse eid="1CH 27:23"/><verse number="24" style="v" sid="1CH 27:24"/>ፃሩያ ናአይ እዮኣብ አሳ ታይቦ ዶምድ ዉርሶና አግስ። አሳ ታይብዳ ግሾ ጎዳይ እስራኤለ አሳ ቦላ ሀንቀትዳ ግሾ ኤንታ ታይቦይ ካዋ ዳዊታ ታርከ ማዝጋበን ፃፈትቤና።<verse eid="1CH 27:24"/></para>
  <para style="s1">ካዋ ቡቁራ አይስያ አሳታ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25"/>ካዎ ቡቁራ ምንጅያ በሳ አዋተን አይስያ አሳ ሱንይ ሀይሳፈ ካልድ ፃፈትዳይሳታ። አድኤላ ናኣ አዝሞት ካዎ ኬ ቡቁራ አዋተን አይሴስ።</para>
  <para style="p" vid="1CH 27:25">ኦዝያና ናአይ ዮናታን ጋፃረን፥ ካታማንነ ጉታን ደእያ ካዎ ኬ ሚሸታ አዋተን አይሴስ። <verse eid="1CH 27:25"/><verse number="26" style="v" sid="1CH 27:26"/>ካሉባ ናአይ እዝር ጎሻንቾታ አዋተን አይሴስ። <verse eid="1CH 27:26"/><verse number="27" style="v" sid="1CH 27:27"/>ራማ አደይ ሳመእ ዎይነ ጋደታ አዋተን አይሴስ። ሳፋማ አደይ ዛብድ ዎይነ ኡሻ ምንጅያ ኬ አዋተን አይሴስ።<verse eid="1CH 27:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 27:28"/>ጋዳራ አደይ ባአል-ሀናን ዙማ ቦላ ደእያ ዛይተ ሻማሁዋነ ቦባ አዋተን አይሴስ። ዛይተ ዎያ ኬ አዋተን አይሰይ እዮኣሳ። <verse eid="1CH 27:28"/><verse number="29" style="v" sid="1CH 27:29"/>ሳሮና ደንባን ሄመትያ መህያ አዋተን አይሰይ ሳሮና አድያ ሳፅራ። ዛንጋራን ሄመትያ መህያ አዋተን አይሰይ አድላያ ናኣ ሻፋፃ። <verse eid="1CH 27:29"/><verse number="30" style="v" sid="1CH 27:30"/>ግማለታ አዋተን አይሰይ እስማኤላ አድያ ኡብሳ። ሀረታ አዋተን አይሰይ መሮኖታ አድያ የህዳያ። <verse eid="1CH 27:30"/><verse number="31" style="v" sid="1CH 27:31"/>ዶርሳታነ ዴሻታ አዋተን አይሰይ አጋራ አደይ ያዝዛ። ሀይሳቲ ኡባይ ዳዊታ ሻሉዋ ቦላ አዋተይሳታ።<verse eid="1CH 27:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32"/>ዳዊታ አዋ እሻይ፥ ፃፈይ ዮናታን አኬካነ ካዋ ዞርያ አስ። ሀክሞና ናአይ ይኤል ካዋ ናይታ ታማርሴስ። <verse eid="1CH 27:32"/><verse number="33" style="v" sid="1CH 27:33"/>አክፆፈል ካዋ ዞረይሳ። አርካ አደይ ኩስ ካዋ ላገ። <verse eid="1CH 27:33"/><verse number="34" style="v" sid="1CH 27:34"/>አክፆፈል ሀይቅን፥ እያ በሳን ባናያ ናአይ ዮዳሄይነ አብያታር ካዋ ዞርያ አስ ግድዶሶና፤ እዮኣብ ካዋ ቶራ ሞጮና።<verse eid="1CH 27:34"/></para>
  <chapter eid="1CH 27"/>
  <chapter number="28" style="c" sid="1CH 28"/>
  <para style="s1">ፆሳ ኬ ሀልቹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1"/>እስራኤለ ሀላቃት ኡባይ የሩሳላመን ሺቃና መላ ካዎይ ዳዊቲ ኪትስ። ሄሳ ግሾ፥ እስ እስ ኮቻ ሀላቃት፥ ካዎ ሞርናት፥ ሻላቃት፥ ማቶ ሀላቃት፥ ካዋስነ ካዋ ናይታስ ደእያ ሻሉዋነ መህያ አይሰይሳት፥ ካዎ ጋን ኦይሳት፥ ኤረትዳነ ምኖ አሳት ኡባይ የሩሳላመን ሺቅዶሶና።<verse eid="1CH 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2"/>ካዎይ ዳዊቲ ደንድ ኤቅድ ሀይሳዳ ያግስ፤ “ታ እሻቶ፥ ታ አሳዉ፥ ስእተ! ጎዳ ጫቆ ታቦትያ ዎያነ ኑ ፆሳ ቶሆይ ሸምፕያ ኬ ኬፃናዉ ታ ዎዛናን ቆፓስ፤ ኮሽያባ ኡባ ጊግሳስ። <verse eid="1CH 28:2"/><verse number="3" style="v" sid="1CH 28:3"/>ሽን ፆሳይ፥ ‘ኔኒ ኦላንቾነ ሱ ጉስዳ አስ ግድያ ግሾ ታ ሱንስ ኬ ኬፃካ’ ያግስ። <verse eid="1CH 28:3"/><verse number="4" style="v" sid="1CH 28:4"/>ታኒ እስራኤለ ቦላ መርናዉ ካዎታናዳ፥ ጎዳይ እስራኤለ ፆሳይ ታ አዋ ሶፐ ታና ዶርስ። ካለናዳ ኮይሮ ይሁዳ ኮቻ ዶርስ፤ ይሁዳ ኮቻፈ ታ አዋ ሶ አሳ ዶርስ፤ ታ አዋ ናይታ ግዶፈ ታና ዶርድ እስራኤለ ኡባ ቦላ ካዎያናዉ ዶስስ። <verse eid="1CH 28:4"/><verse number="5" style="v" sid="1CH 28:5"/>ጎዳይ ታዉ ዳሮ ናይታ እሚስ፤ ታ ናይታ ኡባፈ ጎዳ ካዎተ አራታን ኡትድ እስራኤለ ቦላ ካዎታናዳ ታ ናኣ ሶሎሞነ ዶርስ።<verse eid="1CH 28:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 28:6"/>“ጎዳይ፥ ‘ታ ኬነ ታ ዳባባ ኬፃናይ ነ ናኣ ሶሎሞነ። እ ታዉ ናአ ግዳና መላ ታኒ እያ ዶራስ፤ ታኒ እያዉ አዋ ግዳና። <verse eid="1CH 28:6"/><verse number="7" style="v" sid="1CH 28:7"/>እ ሀእ ኦይሳዳ ታ ኪታነ ታ ህግያ ምንድ ናግኮ ታኒ እያ ካዎተ መርናዉ ምንና’ ያግስ። <verse eid="1CH 28:7"/><verse number="8" style="v" sid="1CH 28:8"/>ህዛ ጎዳ ሺቆ ግድዳ እስራኤለ አሳ ኡባይ በእሽን፥ ኑ ፆሳይ ስእሽን፥ ጎዳ ህንተ ፆሳ ኪታ ኡባ ህንተ ምንድ ናጋና መላ ታኒ ህንተዉ ኦዳይስ። ያትኮ፥ ህንተ ሀ ሎኦ ቢታ ላታና፤ ህንተ ናይታካ መርናዉ ላትሳና።<verse eid="1CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9"/>“ሶሎሞነ፥ ታ ናአዉ፥ ፆሳይ አሳ ዎዛናነ ቆፋ ኡባ ኤርያ ግሾ ነ አዋ ፆሳ ኤራ፤ ኩመ ዎዛናንነ ሸነን እያዉ ኦ። ኔኒ እያ ኮይኮ እ ነዉ በንታና፤ ሽን ኔኒ እያ አግኮ እ ነና መርናዉ አጋና። <verse eid="1CH 28:9"/><verse number="10" style="v" sid="1CH 28:10"/>ፆሳ ኬ ኬፃና መላ ጎዳይ ነና ዶርዳይሳ ዶጎፓ፤ ኦሶ ኡባ ምናዳ ኦ” ያግስ።<verse eid="1CH 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11"/>ሄሳፈ ጉየ፥ ዳዊቲ ባ ናኣ ሶሎሞነስ ፆሳ ኬ፥ ባራንዳ፥ ቡቁራ ምንጅያ ኬ፥ ፖቅያነ ግዶ ክፍለታ፥ ሄሳዳካ ናጋራ አቶተ ካማ ዎያ ክፍልያ ሀልቹዋነ ቆፋ እሚስ። <verse eid="1CH 28:11"/><verse number="12" style="v" sid="1CH 28:12"/>ዳዊቲ ጎዳ ኬ ዳባባ ኬፃናዉ ባ ዎዛናን ደእያ ቆፋ፥ እያ ዩሹዋን ደእያ ኡባ ክፍለታ ሀልቹዋነ ፆሳ ኬ ቡቁራ ዎያ ክፍልያነ ጎዳስ ዱማትዳ እሞታታ ዎያ ክፍለታ ኦሱዋ ቆፋ እሚስ።<verse eid="1CH 28:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 28:13"/>ሄሳዳካ ዳዊቲ ካህነታነ ሌወታ ኦሶ ማራ፥ ፆሳ ኬ ኦሶ ማራነ ፆሳ ኬ ሚሸታ ናግያ ማራ ኦድያ ቆፋ እያዉ እሚስ።<verse eid="1CH 28:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 28:14"/>ዱማ ዱማ ኦሶስ ጎኤትያ ሚሸታ ኦናዉ ማድያ ዎርቃነ ብራ ምዛነን ልክስድ ሶሎሞነስ እሚስ። <verse eid="1CH 28:14"/><verse number="15" style="v" sid="1CH 28:15"/>ሄስካ ፆምፐ ዎያ ዎርቃ ኮጫታነ እያ ፆምፐታ፥ ፆምፐ ዎያ ብራ ኮጫታነ እያ ፆምፐታ፥ <verse eid="1CH 28:15"/><verse number="16" style="v" sid="1CH 28:16"/>ጎዳ ስንን ኡይ ዎያ ዎርቃ ፃርጴዛታ፥ ብራ ፃርጴዛታ፥ <verse eid="1CH 28:16"/><verse number="17" style="v" sid="1CH 28:17"/>ዎርቃ ቃጰታ፥ ዎርቃ ከረታ፥ ዎርቃ ዋንጫታ፥ ዎርቃ ፃሮታ፥ ብራ ፃሮታ <verse eid="1CH 28:17"/><verse number="18" style="v" sid="1CH 28:18"/>እፃነ ጩይስያ ጌሻ ዎርቃ ሳፅነ፥ ጎዳ ጫቆ ታቦትያ ቦላ ባንታ ቀፍያ ምጭድ ካምያ ክሩበታ ዎያ ዎርቃ ጋርያ ጊግስያ ሀልቹዋ እያዉ እሚስ። <verse eid="1CH 28:18"/><verse number="19" style="v" sid="1CH 28:19"/>ዳዊቲ፥ “ጎዳይ ባ ኩሽያ ታ ቦላ ዎድ ሀ ፃፈትዳ ቆፋ ኡባ ታና ኤርስስ” ያግስ።<verse eid="1CH 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20"/>ዳዊቲ ባ ናኣ ሶሎሞነኮ፥ “ህዛ ምና! ኦሱዋ ኦ! ጎዳይ ታ ፆሳይ ኔራ ደእያ ግሾ ያዮፋ፤ ዳጋሞፋ! ፆሳ ኬ ኦሶይ ፖለታና ጋካናዉ ፆሳይ ነና የገናነ አገና። <verse eid="1CH 28:20"/><verse number="21" style="v" sid="1CH 28:21"/>ፆሳ ኬን ደእያ ኦሶ ኡባስ ካህነትነ ሌወት ሹመትዶሶና። ኩሸ ሂል ደእያ አሳ ኡባይ ነና ኦሶ ኡባን ማዳና። ሀላቃትነ አሳ ኡባይ ነዉ ኪተታና” ያግስ።<verse eid="1CH 28:21"/></para>
  <chapter eid="1CH 28"/>
  <chapter number="29" style="c" sid="1CH 29"/>
  <para style="s1">ፆሳ ኬስ እመትዳ እሞታታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1"/>ሄሳፈ ጉየ፥ ካዎይ ዳዊቲ ሺቅዳ አሳ ኡባ ሀይሳዳ ያግስ፤ “ፆሳይ ዶርዳ ታ ናኣ ሶሎሞነይ ዮጋነ ኤራተን ሎህቤና። ሀ ኬፀታና ኬይ አሳ ኬ ግዶናሽን ጎዳ ፆሳ ኬ ግድያ ግሾ ኦሶይ ግታ። <verse eid="1CH 29:1"/><verse number="2" style="v" sid="1CH 29:2"/>ታኒ ታዉ ደእያ ዎልቃ መላ ታ ፆሳ ኬስ ዎርቃን ኦሰትያባስ ዎርቃ፥ ብራን ኦሰትያባስ ብራ፥ ናሰ ብራታን ኦሰትያባስ፥ ናሰ ብራታ፥ ብራታን ኦሰትያባ ብራታነ ምን ኦሰትያባስ ም ጊግሳ ዎስ። ቃስ ማርግደ፥ እብነባራደ፥ ዱማ ዱማ ማል ደእያ አሌቆ ሹቻታ፥ አልኦ ሹቻታነ ሀራ ሹቻታ ጊግሳዳ ዎስ። <verse eid="1CH 29:2"/><verse number="3" style="v" sid="1CH 29:3"/>ፆሳ ኬ ታኒ ዳሮ ዶስያ ግሾ፥ ታኒ ታ ፆሳ ኬስ ጊግስዳይሳፈ ሀራ ታ ቡዞ ሻሉዋፐ ዎርቃነ ብራ እማስ። <verse eid="1CH 29:3"/><verse number="4" style="v" sid="1CH 29:4"/>ኬ ጎዳ ላንፃናዉ 100,000 ክሎ ግራመ ኦፍራ ዎርቃነ 240,000 ክሎ ግራመ ዋላህ ባይና ብራ እማስ። <verse eid="1CH 29:4"/><verse number="5" style="v" sid="1CH 29:5"/>ኩሸ ሂላንቾት ኦና ኦሶ ኡባስ ዎርቃን ኦሰትያባስ ዎርቃ፥ ብራን ኦሰትያባስ ብራ እማስ። ያትን፥ ሀች ህንተፈ ባ ሸነን ባና ጎዳስ ዱማየይ ኦኔ?” ያግስ።<verse eid="1CH 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6"/>እስራኤለ ኮቻታ ሶ አሳ ሀላቃት፥ ኮቻታ ሀላቃት፥ ሻላቃት፥ ማቶ ሀላቃትነ ካዎ ሞርናት ባንታ ሸነን ባንታዉ ደእያባ ዶሳን እምዶሶና። <verse eid="1CH 29:6"/><verse number="7" style="v" sid="1CH 29:7"/>ኤንቲ ፆሳ ኬ ኦሱዋስ 170,000 ክሎ ግራመ ዎርቃ፥ 340,000 ክሎ ግራመ ብራ፥ 620,000 ክሎ ግራመ ናሰ ብራታነ 3,000,000 ክሎ ግራመ ብራታ እምዶሶና። <verse eid="1CH 29:7"/><verse number="8" style="v" sid="1CH 29:8"/>አልኦ ሹች ደእያ አሳ ኡባይ ቡቁራ አይስያ ገድሶና ያራ ግድዳ ይኤላ ባጋራ ጎዳ ፆሳ ኬ ቡቁራ ምንጅያ ኬስ እሚስ። <verse eid="1CH 29:8"/><verse number="9" style="v" sid="1CH 29:9"/>አሳይ ባ ሸነን ባ ኩመ ዎዛናን ጎዳስ እምዳ ግሾ ኡፋይትስ፤ ካዎይ ዳዊቲካ ዳሮ ኡፋይትስ።<verse eid="1CH 29:9"/></para>
  <para style="s1">ዳዊታ ዎሳ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10"/>ሄሳ ግሾ፥ ዳዊቲ ደርያ ኡባ ስንን ሀይሳዳ ያግድ ጎዳ ጋላትስ፤ “አቤት ጎዳዉ፥ ኑ አዋ እስራኤለ ፆሳዉ ኔኒ መርናፐ መርናዉ ጋላተታ። <verse eid="1CH 29:10"/><verse number="11" style="v" sid="1CH 29:11"/>አቤት ጎዳዉ፥ ሳሎንነ ሳአን ደእያ ኡባይ ነባ! ግታተ፥ ዎልቅ፥ ቦንቾይ፥ ፆኖይነ አንግ ነባ! አቤት ጎዳዉ፥ ማት ነባ፤ ኔኒ ኡባፈ ቦላነ ሁጰ። <verse eid="1CH 29:11"/><verse number="12" style="v" sid="1CH 29:12"/>ዱረተነ ቦንቾይ ኔፐ ዬስ፤ ኔኒ ኡባባ ሃራሳ። ዎልቅነ ምኖተ ነ ኩሸና፤ ኔኒ አሳ ኡባ ግታነ ምኖ ኦናዉ ዳንዳኣሳ። <verse eid="1CH 29:12"/><verse number="13" style="v" sid="1CH 29:13"/>ሀእካ ኑ ፆሳዉ፥ ኑኒ ነና ጋላቶስ፤ ነ ቦንቾ ሱን ሳቦስ።<verse eid="1CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14"/>“ኑኒ ሀይሳ መላ እማናዉ ታነ ታ አሳይ ኦኔ? ኡባይ ኔፐ ዬስ፤ ኑኒ ነ ኩሸፐ ኤክዳባ ነዉ ዛሪድ እምዳ። <verse eid="1CH 29:14"/><verse number="15" style="v" sid="1CH 29:15"/>ካሰ ኑ አዋታዳ ኑካ ነ ስንን በተ አስነ እማ። ሀ ሳአን ኑ ደኦ ላይይ ኡፋይስ ባይና ኩያ መላ። <verse eid="1CH 29:15"/><verse number="16" style="v" sid="1CH 29:16"/>አቤት ጎዳዉ፥ ኑ ፆሳዉ፥ ነ ጌሻ ሱንስ ኑኒ ኬ ኬፃናዉ ሺሽዳ ኡባይ ነ ኩሸፐ ይዳባ፤ ኡባይ ነባ።<verse eid="1CH 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 29:17"/>“ታ ፆሳዉ ኔኒ ዎዛና ፓጨይሳነ ሱረተ ዶሰይሳ ታኒ ኤራይስ። ታኒ ታ ዎዛና ሱረተን ታ ሸነን ሄሳ ኡባ እማስ። ሀ በሳን ደእያ ነ አሳይ ነዉ ባ ሸነን ኡፋይሳን እምዳይሳ ታኒ በአስ። <verse eid="1CH 29:17"/><verse number="18" style="v" sid="1CH 29:18"/>አቤት ጎዳዉ፥ ኑ ማይዛታ አብራሃመ፥ ይሳቃነ እስራኤለ ፆሳዉ፥ ነ አሳ ዎዛናን ሀ ግታ ሲቁዋ መርናዉ ናጋ፤ ኤንታ ዎዛና ኔኮ ዛራ። <verse eid="1CH 29:18"/><verse number="19" style="v" sid="1CH 29:19"/>ነ ዎጋ፥ ነ ኪታነ ነ ህግያ ናጋና መላነ ታኒ ቆፓዳ ጊግሳዳባን ፆሳ ኬ ኬፃና መላ ታ ናኣ ሶሎሞነስ ኩመ ዎዛና እማ” ያግድ ዎስስ።<verse eid="1CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20"/>ሄሳፈ ጉየ፥ ዳዊቲ ደርያኮ፥ “ጎዳ ህንተ ፆሳ ጋላትተ” ያግስ። ደረ ኡባይ ጎዳ ባንታ አዋታ ፆሳ ጋላትዶሶና። ሳአን ጉፋንድ ጎዳ ጎይንዶሶና፤ ካዋስካ ቦንቾ እምዶሶና።<verse eid="1CH 29:20"/></para>
  <para style="s1">ሶሎሞነይ ካዎ ግደይስ ኤረትስ</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21"/>ዎንተ ጋላስ አሳይ ያርሾነ ፁሳ ያርሾ ጎዳስ ያርሽዶሶና። ሄስካ እስ ሙኩሉ ኮርማ፥ እስ ሙኩሉ ማራዘ፥ እስ ሙኩሉ ዶርሳ ኡርገ፥ ኡሻ ያርሾነ ሀራ ዳሮ ያርሾ ያርሽዶሶና። <verse eid="1CH 29:21"/><verse number="22" style="v" sid="1CH 29:22"/>አሳይ ሄ ጋላስ ጎዳ ስንን ዳሮ ኡፋይትድ ምስነ ኡይስ። ያትድ አሳይ ካዋ ዳዊታ ናኣ ሶሎሞነ ናምአን ዛይተ ትይድ እያ ካዎተን ምንስ። ሳዶቃ ካህነ ግዳና መላ ጎዳ ስንን ትይዶሶና።<verse eid="1CH 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 29:23"/>ሄሳፈ ጉየ፥ ሶሎሞነይ ባ አዋ ዳዊታ በሳን ጎዳ ካዎተ አራታን ኡትስ። እያዉ ኡባባይ እንጀትስ፤ እስራኤለ ኡባይ እያዉ ኪተትዶሶና። <verse eid="1CH 29:23"/><verse number="24" style="v" sid="1CH 29:24"/>ሀላቃት፥ ምኖ አሳትነ ካዋ ዳዊታ ናይት ካዋ ሶሎሞነስ ኪተታናዉ ቃላ ገልዶሶና። <verse eid="1CH 29:24"/><verse number="25" style="v" sid="1CH 29:25"/>ጎዳይ ሶሎሞነ እስራኤለ አሳ ኡባ ስንን ቁ ቁ ኦስ፤ ካሰ እስራኤለ ካዎታስ እመትቦና ቦንቾ ሶሎሞነስ እሚስ።<verse eid="1CH 29:25"/></para>
  <para style="s1">ዳዊታ ሀይቁዋ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26"/>እሰየ ናአይ ዳዊቲ እስራኤለ ኡባ ቦላ ካዎትስ። <verse eid="1CH 29:26"/><verse number="27" style="v" sid="1CH 29:27"/>ዳዊቲ እስራኤለ ቦላ ኦይታሙ ላይ ካዎትስ፤ ከብሮናን ላፑን ላይ፥ የሩሳላመን ሀስታማነ ሄ ላይ ካዎትስ። <verse eid="1CH 29:27"/><verse number="28" style="v" sid="1CH 29:28"/>ዳዊቲ ዳሮ ላይ ደእድ፥ ዱረትድ፥ ቦንቸትድ፥ ሎኦ ጭምድ ሀይቅስ። እያ በሳን እያ ናአይ ሶሎሞነይ ካዎትስ። <verse eid="1CH 29:28"/><verse number="29" style="v" sid="1CH 29:29"/>ዳዊቲ ኮይሮፐ ዶምድ ዉርሰ ጋካናዉ ኦዳባይ፥ ቆንጨ በእያ ሳሜላ፥ ናብያ ናታናነ ቆንጨ በእያ ጋደ ታርከ ማፃፋን ፃፈትስ። <verse eid="1CH 29:29"/><verse number="30" style="v" sid="1CH 29:30"/>እ ዋት ሃርዳኮ፥ ዋንዳ ዎልቃማ አሴኮ፥ እ ኦዳባይ፥ እስራኤለ አሳይነ ሄራን ደእያ ካዎተት ኡባይ ሀንዳባይ ሄ ማፃፋታን ፃፈትስ።<verse eid="1CH 29:30"/></para>
  <chapter eid="1CH 29"/>
</usx>
