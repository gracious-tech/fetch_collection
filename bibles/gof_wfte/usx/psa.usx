<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ማዝሙረ ማፃፋ</para>
  <para style="toc1">ማዝሙረ ማፃፋ</para>
  <para style="toc3">ማዝ</para>
  <para style="toc2">ማዝሙረ</para>
  <para style="mt">ማዝሙረ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ማዝሙረ ማፃፋይ፥ እስራኤለ አሳ ዎሳነ ጋላታ ማዝሙረታ ሺሽድ ኦይክስ። ዱማ ዱማ አሳት አዱሳ ዎደ ግዶን ሀ ማዝሙረታ ፃፍዶሶና። እስራኤለ አሳይ ሀ ማዝሙረታ ባንታ ጎይኖ ዎደታን ጎኤቶሶና። ጉየፐ እስራኤለ አሳይ ባንታ ጌሻ ማፃፋ ግዶን ገልስዶሶና።</para>
  <para style="ip">ሀ ማዝሙረት ዳሮ ቆሞ። ጋላታነ ዎሳ ማዝሙረታ፥ ጎይኖ ማዝሙረታ፥ ፆሳይ ማዳና መላ፥ ናጋና ማላነ ሳሮ ዎና መላ ቡዞ ደኦስነ ቢታ ኡባስ ዎስያ ዎሳታ፥ ናጋራ ማሮታስ ዎስያ ዎሳታነ ሀራታ ጋድ ኦይክዳ ማዝሙረ። ሀ ማዝሙረታፐ እሶት እሶት እስ ኡራ ዎዛናን ስኤትዳ ምሻታ ቆንጭሶሶና፤ ሀራት ቃስ ፆሳ አሳ ኡባይ ኮያባነ አሳ ኡባስ ስኤትያ ሀኖታታ በሲያ ማዝሙረ።</para>
  <para style="ip">የሱሲ ታማርስሸ ማዝሙረ ማፃፋፐ ኤክስ፤ ኦራ ጫቆ ማፃፋ ፃፈትካ ማዝሙረ ማፃፋፐ ጎኤትዶሶና። ዎሳ ኬ ኤቅዳ ዎደፐ ዶምን፥ ማዝሙረ ማፃፋይ ጎይኖ ዎደ አማንያ አሳይ ጎኤትያ ኤረትዳ ማፃፋ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ኮይሮ ማፃፋ (1—41)</para>
  <para style="io1">ናምአን ማፃፋ (42—72)</para>
  <para style="io1">ሄን ማፃፋ (73—89)</para>
  <para style="io1">ኦይዳን ማፃፋ (90—106)</para>
  <para style="io1">እቻሻን ማፃፋ (107—150)</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">ኮይሮ ማፃፋ</para>
  <para style="mr">(<ref loc="PSA 1-41">ማዝ 1—41</ref>)</para>
  <para style="s1">ናምኡ ኦገታ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 1:1"/>ኢታታ ዞርያን ቦናይ፥</para>
  <para style="q2" vid="PSA 1:1">ናጋራንቾታ ኦገን ኤቆናይ፥</para>
  <para style="q2" vid="PSA 1:1">ቀልቅሰይሳታ ሺቆን ኡቶናይ፥</para>
  <para style="q1" vid="PSA 1:1">እ አንጀትዳይሳ።<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>ሽን እ ጎዳ ህግያን ኡፋይቴስ፤</para>
  <para style="q2" vid="PSA 1:2">እያ ህግያ ጋላስነ ቃማ ቆፔስ።<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>እ ጎግያ ሃ ፃጶን ቶከትድ፥</para>
  <para style="q2" vid="PSA 1:3">ዎደን ዎደን አይፈ እምያ፥</para>
  <para style="q2" vid="PSA 1:3">እያ ሀይይ ቆለቶና ም መላ።</para>
  <para style="q1" vid="PSA 1:3">እ ኦያ ኡባይ እያዉ ፖለቴስ።<verse eid="PSA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>ሽን ኢታት ሄሳ መላ ግዶኮና፤</para>
  <para style="q2" vid="PSA 1:4">ጫርኮይ ፕትድ ኤፍያ ሱላ መላ።<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>ኢታት ፅሎ ፕርዳ በሳን ኤቆኮና፤</para>
  <para style="q2" vid="PSA 1:5">ናጋራንቾት ፅሎታ ዱላታን በንቶኮና።<verse eid="PSA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>ጎዳይ ፅሎታ ኦግያ ኤሬስ፤</para>
  <para style="q2" vid="PSA 1:6">ሽን ኢታታ ኦገይ ያና።<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="s1">ጎዳን ትየትዳይሳ አይሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 2:1"/>ካዎተት አይስ ደንዶና?</para>
  <para style="q2" vid="PSA 2:1">አሳይ አይስ ጮ ማቀቶና?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>ካዎት ጎዳ ቦላነ እ ትይዳይሳ ቦላ ደንድዶሶና፤</para>
  <para style="q2" vid="PSA 2:2">ደርያ ሃረይሳት ኤንታ ቦላ ሺቅዶሶና።<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>“ኤንታ ሳንላታ ዱስ፤</para>
  <para style="q2" vid="PSA 2:3">ኤንታ ቃሾ ዎዶሩዋ ሆሎስ” ያግዶሶና።<verse eid="PSA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>ሳሎን ኡትዳይስ ኤንታ ቦላ ሚጬስ፤</para>
  <para style="q2" vid="PSA 2:4">ጎዳይ ኤንታ ቀልቅሴስ።<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>እ ባ ሀንቁዋን ኤንታ ዳጋንስ፤</para>
  <para style="q2" vid="PSA 2:5">ባ ይሉዋን ኤንታ ያሽሴስ።<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>“ታ ጌሻ ዙማ ፅዮነ ቦላ</para>
  <para style="q2" vid="PSA 2:6">ታ ካዋ ካዎስ” ያጌስ ጎዳይ።<verse eid="PSA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7"/>ታኒ ጎዳ ህግያ አዋጃና፤</para>
  <para style="q2" vid="PSA 2:7">ጎዳይ ታና፥ “ኔኒ ታ ናኣ፤</para>
  <para style="q2" vid="PSA 2:7">ታኒ ሀች ነዉ አዋ ግዳስ።<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>ነ ታና ኦይቻ፤</para>
  <para style="q2" vid="PSA 2:8">ታ ነዉ ካዎተታ እማና፤</para>
  <para style="q2" vid="PSA 2:8">ሳአ ኡባይ ነባ ግዳና።<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>ኔኒ ብራታ ፃምአን ኤንታ መንና፤</para>
  <para style="q2" vid="PSA 2:9">መቃ ሚሸዳ ኤንታ ትንቸረና” ያግስ።<verse eid="PSA 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>ህዛ፥ ካዎቶ ኤዮፕተ፤</para>
  <para style="q2" vid="PSA 2:10">ሀ ሳኣ ሃረይሳቶ አኬክተ።<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>ጎዳ ያሻን ጎይንተ፤</para>
  <para style="q2" vid="PSA 2:11">ኮኮርድ ኪተትተ።<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>ጎዳይ ሀንቀትን ኦገን ህንተ ዮናዳ</para>
  <para style="q2" vid="PSA 2:12">እያ ቱማተን ጎይንተ።</para>
  <para style="q1" vid="PSA 2:12">እያ ሀንቆይ ኤሶን ኤፅ ከያና፤</para>
  <para style="q2" vid="PSA 2:12">እያን ቆሰትድ አትዳ ኡባይ አንጀትዳይሳታ።<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="s1">መቶ በእያ ኡራ ዎሳ</para>
  <para style="d">ዳዊቲ ባ ናአ አበሰሎመፐ ባቃትዳ ዎደ ፃፍዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 3:1"/>አቤት ጎዳዉ፥ ታ ሞርከት አይ መላ ዳርዶና!</para>
  <para style="q2" vid="PSA 3:1">ታ ቦላ ደንደይሳት አፑነ!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>ዳሮት፥ “ፆሳይ እያ አሸና” ያግድ፥</para>
  <para style="q2" vid="PSA 3:2">ታባ ሃሳዮሶና። <char style="qs">ሳላህ </char><note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">ማዝሙረይ የፀትያ ዎደ አዝማቸስነ ፓይዶስ ግዶን ጎዳ ቦንቾስ ካኤትያ ሙዙቃ ካሰ። ሽን ቃላ ብርሸይ ኤረተና።</char></note><verse eid="PSA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>ሽን አቤት ጎዳዉ፥ ነ ታዉ ጎንዳለ፤</para>
  <para style="q2" vid="PSA 3:3">ታ ቦንቾይነ ታና ቁ ኦይ ነና።<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>ታ ቃላ ቁ ኦዳ ጎዳኮ ዋሳይስ።</para>
  <para style="q2" vid="PSA 3:4">እ ባ ጌሻ ዙማፐ ታዉ ዛሬስ። <char style="qs">ሳላህ </char><verse eid="PSA 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>ጎዳይ ታና ናግያ ግሾ፥</para>
  <para style="q2" vid="PSA 3:5">ታ ዝንአስነ ስካስ</para>
  <para style="q2" vid="PSA 3:5">ህርግ ባይና ባርካስ።<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>ኡባ በሳራ ታ ቦላ ደንድዳ፥</para>
  <para style="q2" vid="PSA 3:6">ዳሮ ሙኩሉ አሳስ ያይከ።<verse eid="PSA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>አቤት ጎዳዉ፥ ደንዳ!</para>
  <para style="q2" vid="PSA 3:7">አቤት ታ ፆሳዉ ታና አሻ!</para>
  <para style="q1" vid="PSA 3:7">ታ ሞርከታ ጋጩዋ ሾጫ፤</para>
  <para style="q2" vid="PSA 3:7">ኢታታ አቻ መን።<verse eid="PSA 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>ፆኖይ ጎዳሳ፤</para>
  <para style="q2" vid="PSA 3:8">ጎዳዉ፥ ኔኒ ነ አሳ አንጃ። <char style="qs">ሳላህ </char><verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="s1">ኡባ ዎደ ዎሳ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="d">ዲን የፀትያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 4:1"/>አቤት ታና ፅልስያ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 4:1">ታኒ ነና ፄግያ ዎደ ታዉ ኮያ።</para>
  <para style="q1" vid="PSA 4:1">ታኒ ኡንኤትዳ ዎደ ነ ታና ላአ ከሳዳሳ፤</para>
  <para style="q2" vid="PSA 4:1">ታዉ ቃታ፤ ታ ዎሳ ስአ።<verse eid="PSA 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>ህንተኖ አሳዉ፥ ህንተ አዉደ ጋካናዉ</para>
  <para style="q2" vid="PSA 4:2">ታ ቦንቹዋ ካዉሼቲ?</para>
  <para style="q1" vid="PSA 4:2">አዉደ ጋካናዉ ፓናባ ዶሴቲ?</para>
  <para style="q2" vid="PSA 4:2">አዉደ ጋካናዉ ዎርዶ ካሌቲ? <char style="qs">ሳላህ </char><verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>ጎዳይ አማነትያ አሳታ ባዉ ዱማይድ ዎዳይሳ ኤርተ፤</para>
  <para style="q2" vid="PSA 4:3">ታኒ ጎዳ ፄግያ ዎደ እ ታና ስኤስ።<verse eid="PSA 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>ሀንቀትተ፥ ሽን ናጋራ ኦፕተ፤</para>
  <para style="q2" vid="PSA 4:4">ህንተ ዝንእያ ዎደ</para>
  <para style="q2" vid="PSA 4:4">ህንተ ዎዛና ቆርተ፤ ስእ ጊተ። <char style="qs">ሳላህ </char><verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>ጎዳስ ልከ ያርሾ ያርሽተ፤</para>
  <para style="q2" vid="PSA 4:5">እያን አማነትተ።<verse eid="PSA 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>“ኑና ሎኦባ በሳናይ ኦኔ?”</para>
  <para style="q2" vid="PSA 4:6">ያግድ ዳሮት ኦይቾሶና፤</para>
  <para style="q2" vid="PSA 4:6">አቤት ጎዳዉ፥ ነ ኑና ኬሀ አይፈን ፄላ።<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>ዳሮ ግስተፈነ ዎይነ ኡሻፈ</para>
  <para style="q2" vid="PSA 4:7">ነ ታ ዎዛናን ዎዳ ግታ ኡፋይሳይ አስ።<verse eid="PSA 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>አቤት ጎዳዉ፥ ነ ፃላል ታና ሳሮ ዎያ ግሾ፥</para>
  <para style="q2" vid="PSA 4:8">ታኒ ዝንአዳ ዎፑ ጋዳ ስካይስ።<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="s1">ዎንታ ዎሳ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="d">ሱሱልኤን የፀትያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 5:1"/>አቤት ጎዳዉ፥ ታ ቃላ ስአ፤</para>
  <para style="q2" vid="PSA 5:1">ታ ኦልያ ቆፓ።<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>ታ ካዋዉ፥ ታ ፆሳዉ ታ ዋሱዋ ስአ፤</para>
  <para style="q2" vid="PSA 5:2">ታ ማደ ኮያዳ ዎስያ ዎሳ ሀይዛ።<verse eid="PSA 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>አቤት ጎዳዉ፥ ዎንታ ዎንታ</para>
  <para style="q2" vid="PSA 5:3">ታ ቃላ ስኣሳ።</para>
  <para style="q1" vid="PSA 5:3">ዎንታ ዎንታ ታ ዎሳ ነ ስን ሺሻይስ፤</para>
  <para style="q2" vid="PSA 5:3">ታ ነ ዛሩዋ ናጋይስ።<verse eid="PSA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>ኔኒ ኢታተን ኡፋይቶና ፆሰ፤</para>
  <para style="q2" vid="PSA 5:4">ኢታባይ ኔራ ዴና።<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>ኦቶራንቾት ነ ስንን ኤቆኮና፤</para>
  <para style="q2" vid="PSA 5:5">ኢታባ ኦያ ኡባ ነ እፃሳ።<verse eid="PSA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6"/>ዎርዶ ኦደተይሳታ ነ ይሳሳ፤</para>
  <para style="q2" vid="PSA 5:6">ጎዳይ ሱ ጉሰይሳታነ</para>
  <para style="q2" vid="PSA 5:6">ጭመይሳታ እፄስ።<verse eid="PSA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>ሽን ታ ነ ግታ ማሮተን ነ ኬ ገላና፤</para>
  <para style="q2" vid="PSA 5:7">ነ ጌሻ በሳኮ ስማዳ ነና ቦንቾን ጎይናና።<verse eid="PSA 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>አቤት ጎዳዉ፥ ታ ሞርከታ ግሾ ጋዳ፥</para>
  <para style="q2" vid="PSA 5:8">ታና ነ ፅሎተን ካለ፤</para>
  <para style="q2" vid="PSA 5:8">ነ ኦግያ ታ ስንን ሱርሳ።<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>ኤንታ መተርሻን ቱም ባዋ፤</para>
  <para style="q2" vid="PSA 5:9">ኤንታ ዎዛናን ይሶይ ኩምስ።</para>
  <para style="q1" vid="PSA 5:9">ኤንታ ዶናይ ዶየትዳ ዱፎ መላ፤</para>
  <para style="q2" vid="PSA 5:9">ኤንቲ ባንታ እንፃርሳን ጭሞሶና።<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>ኤንቲ ነ ቦላ ማካልዳ ግሾ፥</para>
  <para style="q2" vid="PSA 5:10">አቤት ፆሳዉ፥ ኤንታ ፕርዳ፤</para>
  <para style="q1" vid="PSA 5:10">ኤንታ ቶባይ ኤንታ ኤክድ ቦ፤</para>
  <para style="q2" vid="PSA 5:10">ኤንታ ዳሮ ናጋራ ግሾ ኤንታ የደ።<verse eid="PSA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>ሽን ኔኮ ባቃትድ አትዳ ኡባይ ኡፋይቶ፤</para>
  <para style="q2" vid="PSA 5:11">ኤንቲ መርናዉ ኡፋይሳን የፆ።</para>
  <para style="q1" vid="PSA 5:11">ነ ሱን ዶስያ ኡባይ ነናን ኡፋይታና መላ፤</para>
  <para style="q2" vid="PSA 5:11">ኔኒ ኤንታ መርናዉ ናጋ።<verse eid="PSA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>አቤት ጎዳዉ፥ ኔኒ ፅሎታ አንጃሳ፤</para>
  <para style="q2" vid="PSA 5:12">ጎንዳለን አሸይሳዳ ነ ኬሀተን እያ አሻ።<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="s1">ኡንአ ዎደ ዎሳ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="d">ሆስፑን ሻያን የፀትያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 6:1"/>አቤት ጎዳዉ፥ ነ ይሉዋን ታና ሴሮፓ፤</para>
  <para style="q2" vid="PSA 6:1">ነ ሸንያን ታና ሀንቆፋ።<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>አቤት ጎዳዉ፥ ታኒ ዳቡራንቾ ግድዳ ግሾ ታና ማራ፤</para>
  <para style="q2" vid="PSA 6:2">አቤት ጎዳዉ፥ ታ ዎዛናይ አርጋጭዳ ግሾ ታና ምን።<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>ታ ሸምፕያ ዳሮ ኡንኤታሱ፤</para>
  <para style="q2" vid="PSA 6:3">ታና ማዳናዉ አዉደ ጋካናዉ ጋምአይ?<verse eid="PSA 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>አቤት ጎዳዉ፥ ኔኒ ስማዳ ታና አሻ፤</para>
  <para style="q2" vid="PSA 6:4">ነ ኬሀተ ዳሩዋን ታና ከሳ ኤካ።<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>ሀይቅዳ አሳ ግዶፈ ነና ሀሳየይ ባዋ፤</para>
  <para style="q2" vid="PSA 6:5">ዱፎን ግድድ ነና ጋላተይ ኦኔ?<verse eid="PSA 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>ታኒ ኦለን ዳቡራስ፤</para>
  <para style="q2" vid="PSA 6:6">ቃማ ኩመ ዬካሸ ታ ሂፃ እርፅሳስ፤</para>
  <para style="q2" vid="PSA 6:6">ታ አርሳ አፉን ዎቅሳስ።<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>ታ ሞርከታ ጋሶን ታ አይፈይ ሙልጫትስ፤</para>
  <para style="q2" vid="PSA 6:7">ታኒ አፉፅዳ ግሾ ደሞና እፅስ።<verse eid="PSA 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>ጎዳይ ታ ዬሁዋ ስእዳ ግሾ፥</para>
  <para style="q2" vid="PSA 6:8">ህንተኖ፥ ኢታ ኦይሳቶ ታፐ ሃክተ።<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>ጎዳይ ታ ዋሱዋ ስእስ፤</para>
  <para style="q2" vid="PSA 6:9">ታ ዎሳ ኤክስ።<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>ታ ሞርከት ኡባይ ዬላትዶሶና፤ ዳጋምዶሶና፤</para>
  <para style="q2" vid="PSA 6:10">ቆፖና ጉየ ስሚድ ካዉይዶሶና።<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="s1">መቶ ዎደ ፅሎ አሳ ዎሳ</para>
  <para style="d">ብንያመ ኮቻ ኩዛባ ዳዊታ ጎዳስ የፅዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 7:1"/>አቤት ጎዳዉ ታ ፆሳዉ፥ ታ ነናን ቆሰታይስ፤</para>
  <para style="q2" vid="PSA 7:1">ታና የደያ ኡባፈ ታና አሻ።<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>ኔኒ ታና አሾናባ ግድያኮ፥</para>
  <para style="q2" vid="PSA 7:2">ኤንቲ ታና ጋሞዳ ዛዛና፤</para>
  <para style="q2" vid="PSA 7:2">አሽያ አስ ባይና መንረናሽን።<verse eid="PSA 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>አቤት ጎዳዉ ታ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 7:3">ታ ሀይሳ መላባ ኦዳባ ግድኮ፥</para>
  <para style="q2" vid="PSA 7:3">ታኒ አሰ ናቅዳባ ግድኮ፥<verse eid="PSA 7:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 7:4"/>ታ ላገታስ ሎኦ ግሾ ኢታ ዛርዳባ ግድኮ፥</para>
  <para style="q2" vid="PSA 7:4">ጋሶይ ባይና ታ ሞርክያ ቦንቅዳባ ግድኮ፥<verse eid="PSA 7:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 7:5"/>ታ ሞርከይ ታና የደድ ኦይኮ፤</para>
  <para style="q2" vid="PSA 7:5">ታና ሳአን የግድ የ፤</para>
  <para style="q2" vid="PSA 7:5">ታና ባናን ጎንዶርስድ ካዉሾ። <char style="qs">ሳላህ </char><verse eid="PSA 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>አቤት ጎዳዉ፥ ነ ሀንቁዋን ደንዳዳ፥</para>
  <para style="q2" vid="PSA 7:6">ኤፅያ ታ ሞርከታ ሀንቁዋ ቦላ ኤቃ፤</para>
  <para style="q2" vid="PSA 7:6">ታ ፆሳዉ፥ ታ ግሾ ባርካ፤</para>
  <para style="q2" vid="PSA 7:6">ኔኒ ፅሎ ፕርዳ ኮያሳ።<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>አሳይ ነ ዩሾን ሺቆ፤</para>
  <para style="q2" vid="PSA 7:7">ኔኒ ኤንታፈ ቦላራ ሃራ።<verse eid="PSA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8"/>ጎዳይ ካዎተታ ቦላ ፕርዴስ፤</para>
  <para style="q2" vid="PSA 7:8">አቤት ጎዳዉ፥ ታ ፅሎተዳነ</para>
  <para style="q2" vid="PSA 7:8">ታ ሱረተዳ ፕርዳ።<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>ቆፋነ ዎዛና ሻካዳ ኤርያ ፅሎ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 7:9">ኢታታ ጌላ ሀኖታ ኔኒ ተቃ፤</para>
  <para style="q2" vid="PSA 7:9">ሽን ፅሉዋ ሳሮን ናጋ።<verse eid="PSA 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>ዎዛና ሱረታ አሽያ፥</para>
  <para style="q2" vid="PSA 7:10">ፆሳይ ታዉ ጎንዳለ።<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>ፆሳይ ፅሎ ፕርደይሳ፤</para>
  <para style="q2" vid="PSA 7:11">እ ኡባ ዎደ ኢታታ ቦላ ሀንቀትያ ፆሳ።<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>ኢታት ባንታ ኢታተፈ ስሞና እፅኮ፥</para>
  <para style="q2" vid="PSA 7:12">ፆሳይ ባ ማሻ ሌፈስ፤</para>
  <para style="q2" vid="PSA 7:12">ባ ዶንግያ ጊግሴስ።<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>እ ባ ዎያ ኦላ ሚሸታ ጊግሴስ፤</para>
  <para style="q2" vid="PSA 7:13">ላፅያ ባ ዶንገ ቶራ ፕቴስ።<verse eid="PSA 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>ኢታት ቆሆ ቃንትድ፥</para>
  <para style="q2" vid="PSA 7:14">ገነ ዎደፅድ፥</para>
  <para style="q2" vid="PSA 7:14">ዎርዶ የሎሶና።<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>ሀራ አሳስ ኦላ ቦክዳ አስ</para>
  <para style="q2" vid="PSA 7:15">ባ ቦክዳ ኦላን ባዉ ኩንዴስ።<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>እያ ገነይ እያ ሁጰን ስሜስ።</para>
  <para style="q2" vid="PSA 7:16">እያ ጌላተይ እያ ሜስ።<verse eid="PSA 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>እያ ፅሎተ ግሾ ታኒ ጎዳ ሳባና፤</para>
  <para style="q2" vid="PSA 7:17">ኡባፈ ቃ ጎዳ ሱንስ</para>
  <para style="q2" vid="PSA 7:17">ታኒ ጋላታ ማዝሙረ የፃና።<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="s1">ያሽያ ፆሳ ቦንቹዋ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="d">ሱሱልኤን የፀትያ ማዝሙረ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>አቤት ጎዳዉ ኑ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 8:1">ነ ሱንይ ቢታ ኡባን ዋንድ ቦንቸትደ!</para>
  <para style="q1" vid="PSA 8:1">ኔኒ ነ ቦንቹዋ ሳሎፐ ቦላራ</para>
  <para style="q2" vid="PSA 8:1">ቁ ቁ ኦዳሳ።<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>ኔኒ ነ ሞርከታ ግሾ</para>
  <para style="q2" vid="PSA 8:2">ነ ሞርክያነ ነና ማንደይሳ ስእ ኦናዉ፥</para>
  <para style="q2" vid="PSA 8:2">ጉ ናይታ ዶናን</para>
  <para style="q2" vid="PSA 8:2">ምያ ናይታ ዶናን ጋላታ<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="fq" closed="false">ጋላታ፦ </char><char style="ft" closed="false">እብራወ ዶናን ጉ ናይታ ጋላታን ምኖተ ሺሻሳ ጉሱ።</char></note> ኩንዳሳ።<verse eid="PSA 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>ኔኒ ነ ብራን መዳ ነ ሳሎታ፥</para>
  <para style="q2" vid="PSA 8:3">እያ በሳን በሳን ኔኒ ዎዳ አጌናነ</para>
  <para style="q2" vid="PSA 8:3">ፆልንቶታ ታኒ በእያ ዎደ፥<verse eid="PSA 8:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 8:4"/>ኔኒ አሳባ ቆፓናዉ አስ አይቤ?</para>
  <para style="q2" vid="PSA 8:4">ዎይኮ ኔኒ እያ ፆሞሳናዉ እ አይቤ?<verse eid="PSA 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>እያ ነ ኔፐ ጉራ ጉዳሳ፤</para>
  <para style="q2" vid="PSA 8:5">ቦንቾነ ግታተ ካላቻ</para>
  <para style="q2" vid="PSA 8:5">እያ ሁጰን ዎዳሳ።<verse eid="PSA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>ነ መዳ መተ ኡባ፥</para>
  <para style="q2" vid="PSA 8:6">ሃራና መላ ነ እያ ሹማዳሳ፤</para>
  <para style="q2" vid="PSA 8:6">ኡባ እያ ቶሁዋፐ ጋርሳራ ዎዳሳ።<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>ዶርሳታነ መሄታ፥</para>
  <para style="q2" vid="PSA 8:7">ዎራ ዶአታ ኡባ፥<verse eid="PSA 8:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 8:8"/>ሳሎ ካፎታ፥ አባ ሞሎታነ</para>
  <para style="q2" vid="PSA 8:8">ሃ ጋርሳን ቃፅያ ኡባ</para>
  <para style="q2" vid="PSA 8:8">እያዉ ሃርሳዳሳ።<verse eid="PSA 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>አቤት ጎዳዉ ኑ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 8:9">ነ ሱንይ ቢታ ኡባን ዋንድ ቦንቸትደ!<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="s1">ኢታታ ቦላ ያና ፕርዳ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="d">“ናአ ሀይቆን” ጌተትያ ጩን የፀትያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 9:1"/>አቤት ጎዳዉ፥ ታ ነና ታ ኩመ ዎዛናፐ ጋላታና፤</para>
  <para style="q2" vid="PSA 9:1">ኔኒ ኦዳ ማላልስያ ኦሶ ኡባ ኦዳና።<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>ታኒ ነናን ኡፋይታና ሀሹ ጋና።</para>
  <para style="q2" vid="PSA 9:2">ኡባፈ ቃ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 9:2">ታኒ ነ ሱንስ ጋላታ ማዝሙረ የፃና።<verse eid="PSA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>ታ ሞርከት ጉየ ስምያ ዎደ፥</para>
  <para style="q2" vid="PSA 9:3">ነ ስንፈ በትድ ያና።<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>ነ አራታን ኡታዳ ታዉ ፅሎ ፕርዳሳ፤</para>
  <para style="q2" vid="PSA 9:4">ታ ሞቱዋ ነ ፅሎተን ኦይካዳሳ።<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>ኔኒ ካዎተታ ሴራዳሳ፤</para>
  <para style="q2" vid="PSA 9:5">ኢታታ ይሳዳሳ።</para>
  <para style="q1" vid="PSA 9:5">ኔኒ ኤንታ ሱን መርናዉ ቁቻዳሳ።<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>ሞርከት መርናዉ ይዶሶና፤</para>
  <para style="q2" vid="PSA 9:6">ኤንታ ካታማታ ኩመ ላላዳሳ፤</para>
  <para style="q2" vid="PSA 9:6">ኤንቲ ኩመ ዶገትዶሶና።<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>ሽን ጎዳይ መርናዉ ካዎትድ ደኤስ፤</para>
  <para style="q2" vid="PSA 9:7">እ ባ አራታ ፕርዳስ ጊግስስ።<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>ሀ ሳኣ ፅሎተን ፕርዳና፤</para>
  <para style="q2" vid="PSA 9:8">ደረታ ሱረተን አይሳና።<verse eid="PSA 9:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>ጎዳይ ኡንኤትዳይሳታስ አትያ በሲ፤</para>
  <para style="q2" vid="PSA 9:9">መቶ ዎደ ገልድ አትያ ቆታ።<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>ነና ኤረይሳት ነናን አማነቶሶና፤</para>
  <para style="q2" vid="PSA 9:10">ጎዳዉ፥ ነና ኮየይሳታ የጋ አጋካ።<verse eid="PSA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>ፅዮነን ካዎትዳ ጎዳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 9:11">እ ኦዳ ኦሱዋ አሳ ኡባስ ኦድተ።<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>ሀሎ ከይያ ፆሳይ ጉክዳ ፅሎ ሱ ዶገና፤</para>
  <para style="q2" vid="PSA 9:12">ቦረትዳይሳታ ዋሱዋ ቀል ጌና።<verse eid="PSA 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>አቤት ጎዳዉ፥ ታዉ ቃታ፤</para>
  <para style="q2" vid="PSA 9:13">ታ ሞርከት ታ ቦላ ኤህያ መቱዋ በአ፤</para>
  <para style="q2" vid="PSA 9:13">ሀይቆፐ ታና አሻ።<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>ፅዮነ አሳ ግዶን ታኒ ኤቃዳ፥</para>
  <para style="q2" vid="PSA 9:14">ነ ጋላታ ኦዳና፤</para>
  <para style="q2" vid="PSA 9:14">ነ አቶተን ኡፋይታና።<verse eid="PSA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>ካዎተት ባንታ ቦክዳ ኦላን</para>
  <para style="q2" vid="PSA 9:15">ባንታዉ ኩንድዶሶና፤</para>
  <para style="q2" vid="PSA 9:15">ኤንቲ ዎዳ ፅሄይ ኤንታ ቶሁዋ ኦይክስ።<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>ጎዳይ ባ ፅሎ ፕርዳን ኤረትስ፤</para>
  <para style="q2" vid="PSA 9:16">ኢታ አሳይ ባንታ ኢታ ኦሱዋን ኦይከትዶሶና። <char style="qs">ሳላህ </char><verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>ኢታት ዱፎ ባና፤</para>
  <para style="q2" vid="PSA 9:17">ፆሳ ዶግያ ካዎተት ኡባይ ኤንታዳ ሀናና።<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>ማንቆይ ኡባ ዎደ ዶገትድ አተና፤</para>
  <para style="q2" vid="PSA 9:18">መቶታንቹዋ ኡፋይሳይ መርናዉ የና።<verse eid="PSA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>አቤት ጎዳዉ ደንዳ፤ አስ ፆኖፖ!</para>
  <para style="q2" vid="PSA 9:19">ካዎተት ነ ስንን ፕርደቶ።<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>አቤት ጎዳዉ ኤንታ ኔኒ ያሽሳ፤</para>
  <para style="q2" vid="PSA 9:20">ካዎተት አሰ ግደይሳ ኤሮ። <char style="qs">ሳላሀ።</char><verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="s1">ሱረ ፕርዳ ኮሻ ዎሳ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>አቤት ጎዳዉ፥ አይስ ሃካዳ ኤቃይ?</para>
  <para style="q2" vid="PSA 10:1">መቶ ዎደ አይስ ኔኒ ጌማይ?<verse eid="PSA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>ባ ኦቶሩዋን ኢታ አስ ማንቁዋ የደስ፤</para>
  <para style="q2" vid="PSA 10:2">ኤንቲ ባንታ ማቁዋን ባንታዉ ኦይከትዶሶና።<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>ኢታ አስ ባ ኢታ አሙዋን ጬቀቴስ፤</para>
  <para style="q2" vid="PSA 10:3">ባ ኡዝያን ጎዳ ጫዬስነ ካስ።<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>ኢታት ባንታ ኦቶሩዋን ፆሳ ኮዮኮና፤</para>
  <para style="q2" vid="PSA 10:4">ባንታ ቆፋን ፆሳስ በሰ እሞኮና።<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>እያዉ ኡባ ዎደ እንጀቴስ፤</para>
  <para style="q2" vid="PSA 10:5">ነ ህገይ እያዉ ገለና፤</para>
  <para style="q2" vid="PSA 10:5">ባ ሞርከታ እ ቀልቅሴስ።<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>ባ ዎዛናን፥ “ታና አይብካ ቃና</para>
  <para style="q2" vid="PSA 10:6">ታና መቶይ ጋከና” ያግድ ቆፔስ።<verse eid="PSA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>እያ ዶናን ባደ፥</para>
  <para style="q2" vid="PSA 10:7">ዎርዶይነ ማንደ ኩምስ።</para>
  <para style="q2" vid="PSA 10:7">ገነይነ ኢታተ እያን እንፃርሳን ደኤስ።<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>ጉታታን ዙግድ ኡቴስ፤</para>
  <para style="q2" vid="PSA 10:8">ሱረ አሳታ ዎናዉ ቆሰትድ ናጌስ፤</para>
  <para style="q2" vid="PSA 10:8">ዎልቅ ባይና ዳቡራንቾታ ዎቼስ።<verse eid="PSA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9"/>ባ ቆሰትዳ በሳን ጌምድ፥</para>
  <para style="q2" vid="PSA 10:9">ማንቁዋ ኦይካናዉ ጋሞዳ ዙጌስ፤</para>
  <para style="q2" vid="PSA 10:9">እያ ኦይክድ ባ ፅህያን ጎችድ ኤፌስ።<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>ዎልቅ ባይና ማንቁዋ ሾጭድ የጌስ፤</para>
  <para style="q2" vid="PSA 10:10">እያ ቶሁዋ ጋርሳን እ ኩንዴስ።<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>እ ባ ዎዛናን፥ “ፆሳይ ዶግስ።</para>
  <para style="q2" vid="PSA 10:11">ባ ሶምኡዋ ገንድ በኤና” ያጌስ።<verse eid="PSA 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>አቤት ጎዳዉ፥ ደንዳ!</para>
  <para style="q2" vid="PSA 10:12">ፆሳዉ፥ ነ ዎልቃማ ኩሽያ ደን፤</para>
  <para style="q2" vid="PSA 10:12">ማንቆታ ዶጎፓ።<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>ኢታ አሳት ፆሰ አይስ ካኦና?</para>
  <para style="q2" vid="PSA 10:13">ባንታ ዎዛናን፥ “ፆሳይ ኑና ሴረና” አይስ ያጎና?<verse eid="PSA 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>ሽን ፆሳዉ፥ ነ መቱዋነ ኡንኣ በኣሳ፤</para>
  <para style="q2" vid="PSA 10:14">ኔኒ ማዳናዉ ጊጋ ኡታዳሳ።</para>
  <para style="q1" vid="PSA 10:14">ኔኒ ይኦታስ ማደ፥</para>
  <para style="q2" vid="PSA 10:14">ቆሄትዳይ ነ ማዳና መላ</para>
  <para style="q2" vid="PSA 10:14">ባና ነዉ አድ እሜስ።<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>ገነ አሳታ ዎልቃ መን፤</para>
  <para style="q2" vid="PSA 10:15">ኢታ አሳታ ሴራ፤</para>
  <para style="q2" vid="PSA 10:15">ዛሪድ ኤንታ ግዶን ኢታተ በንቶፎ።<verse eid="PSA 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>ጎዳይ መርናዉ ካዎትድ ደኤስ፤</para>
  <para style="q2" vid="PSA 10:16">ሀራ ካዎተት እያ ቢታፈ ያና።<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>አቤት ጎዳዉ፥ ኔኒ አሽከታ አሙዋ ኩንሳ፤</para>
  <para style="q2" vid="PSA 10:17">ኤንታ ምን፤ ኤንታ ዎሳ ስአ።<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>ይኦታነ ኡንኤትዳይሳታ ቆሆና መላ፥</para>
  <para style="q2" vid="PSA 10:18">ሳአን ደእያ ኦንካ ኤንታ ያሽሶና መላ፥</para>
  <para style="q2" vid="PSA 10:18">ኔኒ ኤንታዉ ፕርዳ።<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="s1">ፅሎ አሳ ጬቆ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 11:1"/>ጎዳይ ታኒ ቆሰታዳ አትያ በሲ፤</para>
  <para style="q2" vid="PSA 11:1">ያትን አይስ “ካፎዳ ዙማኮ ባቃታ” ያገቲ?<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>ናጋራንቾት ፅሎታ ማን ጫዳናዉ፥</para>
  <para style="q2" vid="PSA 11:2">ባንታ ዶንግያ ዋፅድ ኡትዶሶና።<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>ባሶይ ዎድዳ ዎደ፥</para>
  <para style="q2" vid="PSA 11:3">ፅሎ አስ አይ ኦናዉ ዳንዳኢ?<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>ጎዳይ ባ ጌሻ በሳን ደኤስ፤</para>
  <para style="q2" vid="PSA 11:4">ሳሎን ባ አራታን ኡትድ አሳ ፄሌስ፤</para>
  <para style="q2" vid="PSA 11:4">ጎዳ አይፈይ አሳ ፕልጌስ፤ ዎቼስ።<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>ጎዳይ ፅሉዋነ ዎርዱዋ ፕልጌስ፤</para>
  <para style="q2" vid="PSA 11:5">ኢታተ ዶሰይሳታ እፄስ።<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>ጎዳይ ኢታታ ቦላ ኤፅያ ታማ ቦንቆነ</para>
  <para style="q2" vid="PSA 11:6">ዲነ ቡክሳና፤</para>
  <para style="q2" vid="PSA 11:6">ይስያ ጎተን ኤንታ ሴራና።<verse eid="PSA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>ጎዳይ ፅሎ ግድዳ ግሾ፥ ፅሎተ ዶሴስ፤</para>
  <para style="q2" vid="PSA 11:7">ሱረ አሳት እያ ሶምኡዋ በአና።<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="s1">አላመ ኢታተፈ አተ ዎሳ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 12:1"/>ፆሳ አስ ቢታፈ ዉርዳ ግሾ፥</para>
  <para style="q2" vid="PSA 12:1">አሳ ግዶን አማነተ ባይና ግሾ፥</para>
  <para style="q2" vid="PSA 12:1">ጎዳዉ ኑና ማዳርኪ?<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>ኡባይ ዎርዶ ሃሳዮሶና፤</para>
  <para style="q2" vid="PSA 12:2">እሶይ እሱዋ ጭምያ እንፃርሳን</para>
  <para style="q2" vid="PSA 12:2">ናምኡ ዎዛናን ኦደቶሶና።<verse eid="PSA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>አቤት ጎዳዉ፥ ጭምያ ዶና ጎርዳ፤</para>
  <para style="q2" vid="PSA 12:3">ኦቶሮን ጬቀትያ እንፃርሳ ተቃ።<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>ኤንቲ፥ “ኑ እንፃርሳን ኑ ፆናና፤</para>
  <para style="q2" vid="PSA 12:4">ኑ ዶናይ ኑሳ፤</para>
  <para style="q2" vid="PSA 12:4">ኑስ ጎድ ኦኔ?” ያጎሶና።<verse eid="PSA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>“ማንቆታ ኡንኣ ግሾነ፥</para>
  <para style="q2" vid="PSA 12:5">መቶታንቾታ ኦልያ ግሾ፥</para>
  <para style="q2" vid="PSA 12:5">ሀእ ታኒ ደንዳና፤</para>
  <para style="q2" vid="PSA 12:5">ኤንቲ አሞትያ ሳሮተ ኤንታዉ እማና” ያጌስ ጎዳይ።<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>ጎዳ ቃላይ ጌሽ፤</para>
  <para style="q2" vid="PSA 12:6">ታማን ላፑን ቶሆ ሴርዳ ብራዳ ጌሽ።<verse eid="PSA 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>አቤት ጎዳዉ ኔኒ ኤንታ ናጋ፤</para>
  <para style="q2" vid="PSA 12:7">ሀይሳ መላ አሳፐ መርናዉ ኤንታ አሻ።<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>ኢት አሳ ግዶን ቦንቸትያ ዎደ፥</para>
  <para style="q2" vid="PSA 12:8">ጌላ አሳት ጬቀትሸ ስመረቶሶና።<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="s1">ፆሳን ዘምፕያ ኡራ ዎሳ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 13:1"/>አቤት ጎዳዉ አዉደ ጋካናዉ ታና ዶጋይ?</para>
  <para style="q2" vid="PSA 13:1">አዉደ ጋካናዉ ኔኒ ታፐ ጌማይ?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>ታ ሸምፕያ አዉደ ጋካናዉ ኡንኤታኔ?</para>
  <para style="q2" vid="PSA 13:2">ታ ዎዛናይ አዛኖን አዉደ ጋካናዉ ዳኔ?</para>
  <para style="q2" vid="PSA 13:2">ታ ሞርከይ ታ ቦላ አዉደ ጋካናዉ ጎባኔ?<verse eid="PSA 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>ጎዳዉ ታ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 13:3">ሀእ ታና ፄላዳ ታዉ ዛራ።</para>
  <para style="q1" vid="PSA 13:3">ታ አይፍያ ፖእሳዳ፥</para>
  <para style="q2" vid="PSA 13:3">ታና ሀይቆፐ አሻ።<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>ታ ሞርከት፥ “ኑኒ እያ ፆንዳ”፥</para>
  <para style="q2" vid="PSA 13:4">ያግድ ጬቀቶናዳ ተቃ፤</para>
  <para style="q2" vid="PSA 13:4">ታ ኩንደን ኤንቲ ኡፋይቶናዳ ድጋ።<verse eid="PSA 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>ሽን ታኒ ነ ማሮተን አማነታይስ፤</para>
  <para style="q2" vid="PSA 13:5">ኔኒ ታና አሽያ ግሾ ኡፋይታይስ።<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>ነ ታዉ ኬህዳ ግሾ፥</para>
  <para style="q2" vid="PSA 13:6">ጎዳዉ፥ ታ ነዉ የፃና።<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="s1">ፆሰ ኤሮና አሳታ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 14:1"/>ኤያት ባንታ ዎዛናን፥ “ፆሲ ባዋ” ያጎሶና፤</para>
  <para style="q2" vid="PSA 14:1">ኤንታ ደኦይ ኢትስ።</para>
  <para style="q1" vid="PSA 14:1">ኤንቲ እፀትዳባ ኦሶና፤</para>
  <para style="q2" vid="PSA 14:1">ሎኦባ ኦያ አስ ባዋ።<verse eid="PSA 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>አኬከይነ ፆሰ ኮየይ ደእያኮ በአናዉ፥</para>
  <para style="q2" vid="PSA 14:2">ጎዳይ ሳሎፐ ዱገ አሰ ፄሌስ።<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>ሽን ኡባይ ዞኮ ዛርዶሶና፤</para>
  <para style="q2" vid="PSA 14:3">ኡባይ ጎኦናባ ግድዶሶና።</para>
  <para style="q1" vid="PSA 14:3">ሎኦባ ኦያ ኦንካ ባዋ፤</para>
  <para style="q2" vid="PSA 14:3">ሀር አቶሽን እስ አስካ ባዋ።<verse eid="PSA 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>አስ ካ መይሳዳ፥</para>
  <para style="q2" vid="PSA 14:4">ኤንቲ ታ አሳ ቦንቅድ ሞሶና፤</para>
  <para style="q2" vid="PSA 14:4">ሀ ኢታ አሳት አይባካ ኤሮኮና፤</para>
  <para style="q2" vid="PSA 14:4">ኤንቲ ፆሳ ዎሶኮና።<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>ሽን ፆሳይ ፅሎ አሳራ ደእያ ግሾ፥</para>
  <para style="q2" vid="PSA 14:5">ኢታ አሳት ያሻን ኮኮሮሶና።<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>ህንተ ማንቆታ ቆፋ ላሌታ፤</para>
  <para style="q2" vid="PSA 14:6">ሽን ጎዳይ ማንቆት ቆሰትድ አትያ በሰ።<verse eid="PSA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>እስራኤለስ አቶተ ፅዮነፐ ዬረነ!</para>
  <para style="q2" vid="PSA 14:7">ጎዳይ ኤንታ ዱሳ ዛርያ ዎደ፥</para>
  <para style="q1" vid="PSA 14:7">ያይቆባ ኮቻይ ኡፋይታና፤</para>
  <para style="q2" vid="PSA 14:7">እስራኤለ አሳይ ሀሹ ጋና።<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="s1">ፆሲ ዶስያ አሳ ካንዶ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 15:1"/>አቤት ጎዳዉ፥ ነ ዱንካንያን ጋምአናይ ኦኔ?</para>
  <para style="q2" vid="PSA 15:1">ነ ጌሻ ዙማ ቦላ ዳናይ ኦኔ?<verse eid="PSA 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>ሱረ ደኦ ደኤይ፥</para>
  <para style="q2" vid="PSA 15:2">ፅሎባ ኦይ፥</para>
  <para style="q2" vid="PSA 15:2">ባ ዎዛናፐ ቱማ ኦደተይ፥<verse eid="PSA 15:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 15:3"/>ሀራ አሳ ሱን ኢሶናይ፥</para>
  <para style="q2" vid="PSA 15:3">ባ ላግያ ቦላ ኢታባ ኦናይ፥</para>
  <para style="q2" vid="PSA 15:3">ባ ላግያ ዝግሮናይ፥<verse eid="PSA 15:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 15:4"/>ኢታ አሳታ ካይ፥</para>
  <para style="q2" vid="PSA 15:4">ጎዳ ያይያ አሳታ ቦንቸይ፥</para>
  <para style="q2" vid="PSA 15:4">ቆሄትድካ ባ ጫቁዋ ፖለይ፥<verse eid="PSA 15:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 15:5"/>ባ ሚሽያ የሎን ታልኦናይ፥</para>
  <para style="q2" vid="PSA 15:5">ፅሎ አስ ቆሀናዉ ዎፈ ኤኮናይ፥</para>
  <para style="q2" vid="PSA 15:5">ሀይሳታ ኦያ ኡራይ መርናዉ ቃፀና።<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="s1">ፆሳይ ታ ላታ</para>
  <para style="d">ዳዊታ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 16:1"/>አቤት ፆሳዉ፥</para>
  <para style="q2" vid="PSA 16:1">ታ ኔኮ ባቃትያ ግሾ ታና ናጋ።<verse eid="PSA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>ታኒ ፆሳ፥ “ኔኒ ታ ጎዳ፤</para>
  <para style="q2" vid="PSA 16:2">ኔፐ አትሽን፥ ሀር ሎኦባይ ታዉ ባዋ” ያጋስ።<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>ሳአን ደእያ ጌሻት</para>
  <para style="q2" vid="PSA 16:3">አይ መላ ቦንቸትዶና!</para>
  <para style="q2" vid="PSA 16:3">ታ ኤንታራ እስፈ ኡፋይታይስ።<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>ሀራ ፆሳታ ካለይሳት</para>
  <para style="q2" vid="PSA 16:4">ባንታ ቦላ መቶ ዳርሶሶና።</para>
  <para style="q1" vid="PSA 16:4">ሽን ታኒ ሀራ ፆሳታስ ሱ ያርሽከ፤</para>
  <para style="q2" vid="PSA 16:4">ታኒ ኤንታ ሱን ፄግከ።<verse eid="PSA 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>ታ ጎዳዉ ታ ላታይ ነና፤</para>
  <para style="q2" vid="PSA 16:5">ታዉ ኮሽያ ኡባ ታዉ እማሳ፤</para>
  <para style="q2" vid="PSA 16:5">ታ ደኡዋ ሳማይ ነና።<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>ታና ጋክዳ ሳማይ አይ መላ ሎኦ!</para>
  <para style="q2" vid="PSA 16:6">ኤ ታ ላታይ ቱማ ሎኦ!<verse eid="PSA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>ታና ዞርዳ ጎዳ ጋላታይስ፤</para>
  <para style="q2" vid="PSA 16:7">ቃማ ታ ዎዛናይ ታና ታማርሴስ።<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>ታኒ ኡባ ዎደ ጎዳ ታ ስንን በአይስ፤</para>
  <para style="q2" vid="PSA 16:8">እ ታ ኡሻቻን ደእያ ግሾ ዳጋምከ።<verse eid="PSA 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>ሄሳ ግሾ፥ ታ ዎዛናይ ኡፋይቴስ፤</para>
  <para style="q2" vid="PSA 16:9">ታ እንፃርሳይ ጋላቴስ፤</para>
  <para style="q2" vid="PSA 16:9">ታ አሳተይ ህርግ ባይና ደኤስ።<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>ታ ሸምፕዉ ስኦለን አጋካ፤</para>
  <para style="q2" vid="PSA 16:10">ነ ጌሻ ዎቃና መላ ኦካ።<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>ታና ደኦ ኦግያ በሳሳ፤</para>
  <para style="q2" vid="PSA 16:11">ነ ስንን ኩመ ኡፋይስ ደኤስ፤</para>
  <para style="q2" vid="PSA 16:11">ነ ኡሻቻን መርና እንጀይ ደኤስ።<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="s1">ፅሎ አሳ ዎሳ</para>
  <para style="d">ዳዊታ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 17:1"/>አቤት ጎዳዉ፥ ታ ፅሎ ማጋኑዋ ስአ፤</para>
  <para style="q2" vid="PSA 17:1">ታኒ ኔኮ ዋስያ ዋሱዋ ሀይዛ።</para>
  <para style="q1" vid="PSA 17:1">ጭሞን ግዶናሽን ቱማን፥</para>
  <para style="q2" vid="PSA 17:1">ዎስያ ዎሳ ዛራ።<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>ነ ፅሎ ፕርዳይ ታዉ ቆንጮ፤</para>
  <para style="q2" vid="PSA 17:2">ነ አይፈይ ቱማ ፄሎ።<verse eid="PSA 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>ኔኒ ቃማ ታና ፆሞሳዳሳ፤</para>
  <para style="q2" vid="PSA 17:3">ታ ዎዛና ፓጫዳሳ።</para>
  <para style="q1" vid="PSA 17:3">ሽን ፓጫዳካ ታ ቦላ አይኮካ ደማባካ፤</para>
  <para style="q2" vid="PSA 17:3">ታ እንፃርሳይካ ባለትቤና።<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>ታኒ ሀራ አሳታዳ ኢታባ ሃሳይከ፤</para>
  <para style="q2" vid="PSA 17:4">ታኒ ነ ቃላ ናግያ ግሾ፥ ገነ ኦግያ ካላብከ።<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>ታ ቶሆይ በቶና መላ፥</para>
  <para style="q2" vid="PSA 17:5">ታ ታንጎይ ነ ኦግያፐ ጋፃ ከይቤና።<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>አቤት ፆሳዉ ታ ዎሳ ነ ስእያ ግሾ፥</para>
  <para style="q2" vid="PSA 17:6">ታኒ ነና ዎሳይስ።</para>
  <para style="q1" vid="PSA 17:6">ነ ሀይ ታኮ ዛራዳ፥</para>
  <para style="q2" vid="PSA 17:6">ታ ቃላ ስአ።<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>ባንታ ሞርከታፐ ባቃተይሳታ፥</para>
  <para style="q2" vid="PSA 17:7">ነ ኡሻቻ ኩሸን ቆታዳ አሸይሶ፥</para>
  <para style="q2" vid="PSA 17:7">ነ ኬሀተ ማላልስያ ኦገን በሳ።<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>ነ አይፈ ናኤ መላ ታና ናጋ፤</para>
  <para style="q2" vid="PSA 17:8">ነ ቀፍያ ጋርሳን ታና ቆሳ።<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>ታና ኡንኤያ ኢታታፐ፤</para>
  <para style="q2" vid="PSA 17:9">ተቅድ ኦይክዳ ሞርከታፐ አሻ።<verse eid="PSA 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>ኤንታዉ ቃይ ባዋ፤</para>
  <para style="q2" vid="PSA 17:10">ኦቶሮን ሃሳዮሶና።<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>ታና ጎድድ ኦይክዶሶና፤ ተቅዶሶና፤</para>
  <para style="q2" vid="PSA 17:11">ታና ቢታን ሆልድ የጋናዉ ፄሎሶና።<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>ኤንቲ ምያባ ኮይያ ጋሞ መላ፤</para>
  <para style="q2" vid="PSA 17:12">ቆሰትድ ናግያ ዎዳላ ጋሞ መላ።<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>ጎዳዉ፥ ደንዳ፤</para>
  <para style="q2" vid="PSA 17:13">ታ ሞርከታራ ኤቀታዳ ኤንታ ሳአን የጋ፤</para>
  <para style="q2" vid="PSA 17:13">ነ ማሻን ኢታታ ኩሸፐ ታና አሻ።<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>ጎዳዉ፥ ሀይሳ መላ አሳፐ ታና ቆሳ፤</para>
  <para style="q2" vid="PSA 17:14">ኤንታ ቃዳይ ሳአባ ግድዳ አሳፐ</para>
  <para style="q2" vid="PSA 17:14">ነ ኩሸን ታና አሻ።</para>
  <para style="q1" vid="PSA 17:14">ነ ምንጅዳ ሴራን ኤንታ ካልሳ፤</para>
  <para style="q2" vid="PSA 17:14">ሄ ሴራይ ኤንታ ናይታስ ግድድ፥</para>
  <para style="q2" vid="PSA 17:14">ኤንታ ናይታ ናይታስ ፓላሆ።<verse eid="PSA 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>ሽን ታኒ ፅሎተን ነ ሶምኡዋ በአና፤</para>
  <para style="q2" vid="PSA 17:15">ታ ባርክያ ዎደ ነ ማላ በአዳ ኡፋይታና።<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="s1">ፆኖ ማዝሙረ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="d">ጎዳይ እያ ሞርከታፐነ ሳኦላ ኩሸፐ አሽዳ ዎደ ዳዊታ ጎዳስ የፅዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 18:1"/>አቤት ጎዳዉ፥ ታ ዎልቃዉ፥</para>
  <para style="q2" vid="PSA 18:1">ታኒ ነና ዶሳይስ።<verse eid="PSA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>ጎዳይ ታ ዛላ፤ ታ ሚፃ፤ ታና አሸይሳ፤</para>
  <para style="q2" vid="PSA 18:2">ታ ፆሳይ ታ እያኮ ባቃትያ ታ ዛላ።</para>
  <para style="q1" vid="PSA 18:2">እ ታዉ ጎንዳለ፤ ታና አሽያ ዎልቃ፤</para>
  <para style="q2" vid="PSA 18:2">ታኒ ቆሰታዳ አትያ በሰ።<verse eid="PSA 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>ጋላታ በሲያ ጎዳ ታ ፄጋይስ፤</para>
  <para style="q2" vid="PSA 18:3">ታ ሞርከታፐ ታኒ አታና።<verse eid="PSA 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>ሀይቆ ዎዶሮይ ታና ጩልስ፤</para>
  <para style="q2" vid="PSA 18:4">ዮ ድኦይ ታና ዳጋንስ።<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>ዱፎ ዎዶሮይ ታ ቦላ ፃፀትስ፤</para>
  <para style="q2" vid="PSA 18:5">ሀይቆ ፅሄይ ታና ኦይክስ።<verse eid="PSA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>ታ ኡንአን ጎዳ ፄጋስ፤</para>
  <para style="q2" vid="PSA 18:6">ታና ማዳና መላ ታ ፆሳኮ ዋሳስ።</para>
  <para style="q1" vid="PSA 18:6">ባ ኬን ግድድ ታ ግርሳ ስእስ፤</para>
  <para style="q2" vid="PSA 18:6">ታ ዋሶይ እያ ሀይን ዎስ።<verse eid="PSA 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>ፆሳይ ሀንቀትዳ ግሾ፥</para>
  <para style="q2" vid="PSA 18:7">ቢታይ ቃፅስ፤</para>
  <para style="q2" vid="PSA 18:7">ደረታ ፃጶይ ኮኮርስ።<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>እያ ሲያፐ ሀንቆ ጩያይ ከይስ፤</para>
  <para style="q2" vid="PSA 18:8">እያ ዶናፐ ምያ ታማ ላጮይ ከይስ፤</para>
  <para style="q2" vid="PSA 18:8">እ ፁግያ ቦንቆ ጩትስ።<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>ሳሉዋ ጳልቅድ ዎስ፤</para>
  <para style="q2" vid="PSA 18:9">እያ ቶሁዋፐ ጋርሳን ማ ሻር ደኤስ።<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>ክሩበታ ቦላ ኡትድ ፓልስ፤</para>
  <para style="q2" vid="PSA 18:10">ጫርኮ ቀፈን ፑደ ደንድስ።<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>ባና ማን ካምስ፤</para>
  <para style="q2" vid="PSA 18:11">እያ ዱንካነይ እራን ኩምዳ ሻራ።<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>እያ ስንን ደእያ ግታ ፖኡዋፐ</para>
  <para style="q2" vid="PSA 18:12">ሻችነ ታማ ላጮይ ከይድ</para>
  <para style="q2" vid="PSA 18:12">ማ ሻራ ካንድ ብስ።<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>ጎዳይ ዳዳዳ ሳሎፐ ጉምስ፤</para>
  <para style="q2" vid="PSA 18:13">ኡባፈ ቃ ፆሳይ ባ ግርሳ ስስስ፤</para>
  <para style="q2" vid="PSA 18:13">ዎልአንንነ ታማ ላጮን ቆንጭስ።<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>ባ ዶንግያ ዱክድ ባ ሞርከታ ላልስ፤</para>
  <para style="q2" vid="PSA 18:14">ዎልአን ፖኦ ኪትድ ኤንታ የደስ።<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>አቤት ጎዳዉ፥ ኔኒ ሴርዳ ዎደ፥</para>
  <para style="q2" vid="PSA 18:15">ሸነታዳ ፔኑቅዳ ዎደ፥</para>
  <para style="q1" vid="PSA 18:15">አባይ ዝንእዳ ቢታይ በንትስ፤</para>
  <para style="q2" vid="PSA 18:15">ሳአ ባሶይ ቆንጭስ።<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>ጎዳይ ቦላፈ ኩሽያ የድድ ታና ኦይክስ፤</para>
  <para style="q2" vid="PSA 18:16">ጪሞ ሃፈ ታና ዳፍድ ከስስ።<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>ታ ቦላ ዳሮ ዎልቃምዳ</para>
  <para style="q2" vid="PSA 18:17">ታ ሞርከታፐነ</para>
  <para style="q2" vid="PSA 18:17">ታና እፀይሳታፐ አሽስ።<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>ታ መቶትዳ ዎደ ኤንቲ ታ ቦላ ደንድዶሶና፤</para>
  <para style="q2" vid="PSA 18:18">ሽን ጎዳይ ታና ካትስስ።<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>እ ታና ዳልጋ በሲ ከስስ፤</para>
  <para style="q2" vid="PSA 18:19">ታናን ኡፋይትዳ ግሾ ታና አሽስ።<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>ታ ፅሎተዳ ጎዳይ ታዉ ቃንፅስ፤</para>
  <para style="q2" vid="PSA 18:20">ታ ኩሸ ጌሻተዳ እ ታዉ ዛርስ።<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>ታኒ ጎዳ ኦግያ ካላስ፤</para>
  <para style="q2" vid="PSA 18:21">ታ ፆሳ አጋዳ ካረ ከያብከ።<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>ታኒ እያ ህግያ ኡባ ናጋስ፤</para>
  <para style="q2" vid="PSA 18:22">እያ ኪታ ፖሎ አጋብከ።<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>ታኒ እያ ስንን ሱረ ደአስ፤</para>
  <para style="q2" vid="PSA 18:23">ታና ናጋራፐ ናጋስ።<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>ጎዳይ ታ ፅሎተዳነ</para>
  <para style="q2" vid="PSA 18:24">ታ ኩሸ ጌሻተዳ ታዉ ዛርስ።<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>አማነተይሳታስ ነ አማነታሳ፤</para>
  <para style="q2" vid="PSA 18:25">ሱረታስ ነ ሱረ።<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>ጌሻታስ ነ ጌሽ፤</para>
  <para style="q2" vid="PSA 18:26">ሽን ጌላታስ ነ ጌላ።<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>አሽከታ አሻሳ፤</para>
  <para style="q2" vid="PSA 18:27">ሽን ኦቶራንቾታ ካዉሻሳ።<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>አቤት ጎዳዉ፥ ነ ታዉ ፆምፓሳ፤</para>
  <para style="q2" vid="PSA 18:28">ታ ፆሳይ ታ ማ ፖእሳሳ።<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>ነ ማዱዋን ታ ሞርከ ቶራ ቦላ ደንዳይስ፤</para>
  <para style="q2" vid="PSA 18:29">ታ ፆሳን ሚፃ ፄራራ ጉፓዳ አይስ።<verse eid="PSA 18:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>ፆሳ ኦገይ ፖሎ፤</para>
  <para style="q2" vid="PSA 18:30">ጎዳ ቃላይ ጌሽ፤</para>
  <para style="q2" vid="PSA 18:30">እያኮ ባቃትያ ኡባስ እ ጎንዳለ።<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>ጎዳፐ አትሽን፥ ሀራ ፆሲ ኦኔ?</para>
  <para style="q2" vid="PSA 18:31">ኑ ፆሳፈ አትሽን፥ ሀራ ዛል ኦኔ?<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>ታዉ ዎልቃ እመይነ</para>
  <para style="q2" vid="PSA 18:32">ታ ኦግያ ሳሮ ኦይ ፆሳ።<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>እ ታ ቶሁዋ ገንኤ ቶሆዳ ምንስ፤</para>
  <para style="q2" vid="PSA 18:33">ቃ በሳን ህርግ ባይና ኤሴስ።<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>ታ ኩሽያ ኦላ ታማርሴስ፤</para>
  <para style="q2" vid="PSA 18:34">ናሰ ብራታ ዶንግያ ዱካና መላ</para>
  <para style="q2" vid="PSA 18:34">ታ ቀስያ ምንስ።<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>ታና አሽያ ነ ጎንዳልያ ታዉ እማዳሳ፤</para>
  <para style="q2" vid="PSA 18:35">ነ ኡሻቻ ኩሸይ ታና ዘምፕሴስ፤</para>
  <para style="q2" vid="PSA 18:35">ነ ሎኦ ኦይከይ ታና ግታዬስ።<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>ታ ሄመትያ በሳ ዳልግሳዳሳ፤</para>
  <para style="q2" vid="PSA 18:36">ታ ቶሁዋ ሀርቹች ኤክቤና።<verse eid="PSA 18:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>ታ ሞርከታ የደዳ ኦይካስ፤</para>
  <para style="q2" vid="PSA 18:37">ኤንታ ይሶና ጉየ ስምከ።<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>ኤንቲ ዛር ደንዶናዳ ሾጫስ፤</para>
  <para style="q2" vid="PSA 18:38">ኤንቲ ታ ቶሁዋ ጋርሳን ኩንድዶሶና።<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>ኦላስ ታና ዳንጭሳዳሳ፤</para>
  <para style="q2" vid="PSA 18:39">ታራ ጋደተይሳታ ታዉ ጉልባትሳዳሳ።<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>ታ ሞርከታ ታ ስንፈ ጉየ ዛራዳሳ፤</para>
  <para style="q2" vid="PSA 18:40">ታና እፀይሳታ ይሳስ።<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>ማደ ኮይድ ዋስዶሶና፥</para>
  <para style="q2" vid="PSA 18:41">ሽን ኦንካ ኤንታ አሽቤና።</para>
  <para style="q1" vid="PSA 18:41">ጎዳ ኤንቲ ፄግዶሶና፥</para>
  <para style="q2" vid="PSA 18:41">ሽን እ ኤንታዉ ኮይቤና።<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>ጫርኮይ ፕትድ ኤፍያ ባናዳ ኤንታ ሊቅሳስ፤</para>
  <para style="q2" vid="PSA 18:42">ኦገ ኡርቃዳ ኤንታ የስ።<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>ገነ አሳፐ ታና አሻዳሳ፤</para>
  <para style="q2" vid="PSA 18:43">ታና ካዎተታ ቦላ ሹማዳሳ፤</para>
  <para style="q2" vid="PSA 18:43">ታ ኤሮና አሳይ ታዉ ሃረትዶሶና።<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>ኤንቲ ታባ ስእድ ታዉ ኪተቶሶና፤</para>
  <para style="q2" vid="PSA 18:44">አላጋ ደረይ ታ ስንን ዝጌስ።<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>ኤንቲ ካሀ ይዶሶና፤</para>
  <para style="q2" vid="PSA 18:45">ባንታ ሚፃፐ ኮኮርሸ ዮሶና።<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>ጎዳይ ደኤስ!</para>
  <para style="q2" vid="PSA 18:46">ፆሳይ፥ ታ ዛላይ ጋላተቶ!</para>
  <para style="q2" vid="PSA 18:46">ታና አሽያ ፆሳይ ቁ ቁ ጎ!<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>እ ታዉ ሀሎ ከስያ ፆሳ፤</para>
  <para style="q2" vid="PSA 18:47">ካዎተታ ታ ጋርሳን ሃርሰይሳ።<verse eid="PSA 18:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48"/>ታ ሞርከታፐ ታና አሸይሳ፤</para>
  <para style="q2" vid="PSA 18:48">ታና እፀይሳታ ቦላ ቁ ቁ ኦሳ፤</para>
  <para style="q2" vid="PSA 18:48">ኢታታፐ ታና አሻሳ።<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>ሄሳ ግሾ፥ ጎዳዉ</para>
  <para style="q2" vid="PSA 18:49">ካዎተታ ግዶን ታኒ ነና ጋላታና፤</para>
  <para style="q2" vid="PSA 18:49">ነ ሱን ሳባና።<verse eid="PSA 18:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>እ ባ ካዋስ ፆኖ እሜስ፤</para>
  <para style="q2" vid="PSA 18:50">ባ ትይዳይሳስ፥ ዳዊታስነ እያ ኮቻስ፥</para>
  <para style="q2" vid="PSA 18:50">ባ ኬሀተ በሴስ።<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="s1">ፆሳ ህገን ቦረይ ባዋ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 19:1"/>ሳሎት ፆሳ ቦንቹዋ ሃሳዮሶና፤</para>
  <para style="q2" vid="PSA 19:1">ሳሎ ጉፋንይ እያ ኩሸ ኦሱዋ አዋጄስ።<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>እስ ጋላስ ሀራ ጋላሳስ ሄሳ ኦዴስ፤</para>
  <para style="q2" vid="PSA 19:2">እስ ቃም ሀራ ቃማስ ኤራተ ቆንጭሴስ።<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>ኦድ ዎይኮ ቃል ባዋ፤</para>
  <para style="q2" vid="PSA 19:3">ኤንታ ግርሳይ ስኤተና።<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>ግዶሽን ኤንታ ኦዳይ ሳአ ኡባን ላለትስ፤</para>
  <para style="q2" vid="PSA 19:4">ኤንታ ቃላይ ቢታ ጋፃ ጋክስ።</para>
  <para style="q1" vid="PSA 19:4">አው ደእያ በሲ ፆሳይ ሳሎን ጊግስስ።<verse eid="PSA 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5"/>ባ ሶፐ ከይያ ምሽራዳ፥</para>
  <para style="q2" vid="PSA 19:5">ጋደ ዎፃናዉ ኡፋይትድ ጊግዳ አሳዳ፥</para>
  <para style="q2" vid="PSA 19:5">አዋይ ዎንታ ዎንታ ከዬስ።<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>እስ ባጋ ሳሎ ጋፃፐ ከይድ፥</para>
  <para style="q2" vid="PSA 19:6">ሀራ ባጋ ሳሎ ጋፃ ጋካናዉ ቤስ፤</para>
  <para style="q2" vid="PSA 19:6">እያ ሱላፐ ጌምያባይ ባዋ።<verse eid="PSA 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>ጎዳ ህገይ ሱረ፤</para>
  <para style="q2" vid="PSA 19:7">ሸምፖ ዛሬስ።</para>
  <para style="q1" vid="PSA 19:7">ጎዳ ኪታይ አማነትዳይሳ፤</para>
  <para style="q2" vid="PSA 19:7">አኬክ ፓጭዳይሳታ ጭንጫ ኦስ።<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>ጎዳ ዎጋይ ልከ፤</para>
  <para style="q2" vid="PSA 19:8">ዎዛና ኡፋይሴስ።</para>
  <para style="q2" vid="PSA 19:8">ጎዳ ኪታይ ጌሽ፤</para>
  <para style="q2" vid="PSA 19:8">አይፈ ፖእሴስ።<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>ጎዳስ ያሽ ጌሽ፤</para>
  <para style="q2" vid="PSA 19:9">መርናዉ ኤቅድ ደኤስ።</para>
  <para style="q2" vid="PSA 19:9">ጎዳ ፕርዳይ ኩመ ቱማነ ፅሎ።<verse eid="PSA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>ዎርቃፈ አድ ኮየቴስ፤</para>
  <para style="q2" vid="PSA 19:10">ዋላህ ባይና ዎርቃፈ አድ ሎኦ።</para>
  <para style="q1" vid="PSA 19:10">ኤሳፈ አድ ሎኦ</para>
  <para style="q2" vid="PSA 19:10">እልሎ ኤሳፈ አድ ማልኦ።<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>ነ አይለይ ናገታና መላ ዞሬስ፤</para>
  <para style="q2" vid="PSA 19:11">ነ ህግያ ናጎይ ዳሮ ጎኤስ።<verse eid="PSA 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>ባ ቆሁዋ ደመይ ኦኔ?</para>
  <para style="q2" vid="PSA 19:12">አቤት ጎዳዉ፥ ጌምዳ ናጋራፐ ታና ጌሻ።<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>ታና ነ አይልያ፥</para>
  <para style="q2" vid="PSA 19:13">ኤርሸ ኦያ ናጋራፐ ናጋ።</para>
  <para style="q1" vid="PSA 19:13">ናጋር ታና ሃሮና መላ ማዳ፤</para>
  <para style="q2" vid="PSA 19:13">ሄ ዎደ ታኒ ሱረ ግዳና፥</para>
  <para style="q2" vid="PSA 19:13">ግታ ባላፐ ጌያና።<verse eid="PSA 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>አቤት ጎዳዉ፥ ታ ዛላዉ፥ ታና ዎዘይሶ፤</para>
  <para style="q2" vid="PSA 19:14">ታ ዶናፐ ከይያ ቃላይነ</para>
  <para style="q2" vid="PSA 19:14">ታ ዎዛና ቆፋይ ነና ኡፋይስያባ ግዶ።<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="s1">ፆሳን አማነታ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 20:1"/>መቶ ዎደ ጎዳይ ነና ስኦ፤</para>
  <para style="q2" vid="PSA 20:1">ያይቆባ ፆሳ ሱንይ ነና ናጎ።<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>ባ ኬፈ ነዉ ማዶ ኪቶ፤</para>
  <para style="q2" vid="PSA 20:2">ፅዮነፐ ነና ካትሶ።<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>እ ነ ያርሾ ኡባ ሀሳዮ፤</para>
  <para style="q2" vid="PSA 20:3">ነ ፁሳ ያርሹዋን ኡፋይቶ። <char style="qs">ሳላሀ </char><verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>ነ ዎዛና አሙዋ ነዉ እሞ፤</para>
  <para style="q2" vid="PSA 20:4">ነ ቆፋ ኡባ ፖሎ።<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>ነ ፆኑዋን ኑና ኡፋይሶ፤</para>
  <para style="q2" vid="PSA 20:5">ኑ ፆሳ ሱንን ኑ ባንድራ ቁ ኦና፤</para>
  <para style="q2" vid="PSA 20:5">ነ ዎሳ ኡባ ጎዳይ ነዉ ዛሮ።<verse eid="PSA 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>ጎዳይ ባ ዶርዳ ካዋስ፥</para>
  <para style="q2" vid="PSA 20:6">ፆኖ እምዳይሳ ታኒ ቡሮ ኤራይስ።</para>
  <para style="q1" vid="PSA 20:6">እ ባ ጌሻ ሳሉዋን ስአና፤</para>
  <para style="q2" vid="PSA 20:6">ባ ኡሻቻ ኩሸን ግታ ፆኖ እያዉ እማና።<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>እሶት እሶት ባንታ ኦላ ፓራ ጋርያን፥</para>
  <para style="q2" vid="PSA 20:7">ሀራት ባንታ ፓራን ጬቀቶሶና፤</para>
  <para style="q2" vid="PSA 20:7">ሽን ኑኒ ጎዳ ኑ ፆሳ ዎልቃን ጬቀቶስ።<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>ኤንቲ በትድ ኩንዳና፤</para>
  <para style="q2" vid="PSA 20:8">ሽን ኑኒ ደንድድ ምን ኤቃና።<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>አቤት ጎዳዉ፥ ካዋስ ፆኖ እማ፤</para>
  <para style="q2" vid="PSA 20:9">ኑኒ ነና ፄግያ ዎደ ስአ።<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="s1">ካዎይ ፆሳን ኡፋይቴስ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 21:1"/>ጎዳዉ፥ ካዎይ ነ ዎልቃን ኡፋይቴስ፤</para>
  <para style="q2" vid="PSA 21:1">ነ እምዳ ፆኑዋን ሀሹ ጌስ።<verse eid="PSA 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>እያ ዎዛና አሙዋ እያዉ እማዳሳ፤</para>
  <para style="q2" vid="PSA 21:2">እያ መተርሻ ዎሳ እያ ድጋባካ። <char style="qs">ሳላሀ </char><verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>ሎኦ አንጆራ እያ ሞካሳ፤</para>
  <para style="q2" vid="PSA 21:3">ዋላህ ባይና ዎርቃ ካላቻ እያ ሁጰን ዎሳ።<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>እ ነና ደኦ ኦይችስ፤</para>
  <para style="q2" vid="PSA 21:4">ዳሮ ላይነ አዱሳ ደኦ እማዳሳ።<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>ኔኒ እያዉ ፆኖ እምዳ ግሾ፥</para>
  <para style="q2" vid="PSA 21:5">እያ ቦንቾይ ዳርስ፤</para>
  <para style="q2" vid="PSA 21:5">ግታተነ ቴማ እያዉ እማዳሳ።<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>መርና አንጁዋ እያዉ እማዳሳ፤</para>
  <para style="q2" vid="PSA 21:6">ነ በንቱዋን እያ ኡፋይሳሳ።<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>ካዎይ ጎዳን አማነቴስ፤</para>
  <para style="q2" vid="PSA 21:7">ኡባፈ ቃ ፆሳ ማሮታይ፥</para>
  <para style="q2" vid="PSA 21:7">እያራ ደእያ ግሾ እ ዳጋመና።<verse eid="PSA 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>ነ ኩሸይ ነ ሞርከታ፥</para>
  <para style="q2" vid="PSA 21:8">ነ ኡሻቻ ኩሸይ ነና እፀይሳታ ደማና።<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>ነ ቆንጭያ ዎደ ጮጨ ታማዳ ኤንታ ፁጋና፤</para>
  <para style="q2" vid="PSA 21:9">ጎዳይ ባ ሀንቆ ሱሎን ኤንታ ምታና፤</para>
  <para style="q2" vid="PSA 21:9">እያ ታማይ ኤንታ ማና።<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>ኔኒ ኤንታ ናይታ ቢታፈ፥</para>
  <para style="q2" vid="PSA 21:10">ኤንታ ኮቻ አሳ ግዶፈ ይሳና።<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>ነ ሞርከት ነ ቦላ ቶቦሶና፤</para>
  <para style="q2" vid="PSA 21:11">ኢታባ ማቀቶሶና፥ ሽን ፖሎኮና።<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>ኔኒ ኤንታ ነ ዶንግያን ዱካና፤</para>
  <para style="q2" vid="PSA 21:12">ኤንታ ጉየ ዛራዳ ጎዳና።<verse eid="PSA 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>ጎዳዉ፥ ነ ምኖተን ቁ ቁ ጋ፤</para>
  <para style="q2" vid="PSA 21:13">ነ ዎልቃ ግሾ ጋላታ ማዝሙረ የፆስ።<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="s1">ፅሎ አሳ መቶነ ኡፋይስ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="d">“ጉራ ገንኤ” ጌተትያ ዲ ጩን የፀትዳ ማዝሙረ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>ታ ፆሳዉ፥ ታ ፆሳዉ፥ ታና አይስ አጋዲ?</para>
  <para style="q2" vid="PSA 22:1">ታና ማዳ ጋዳ ታ ነና ዎስያ ዎደ፥</para>
  <para style="q2" vid="PSA 22:1">አይስ ታፐ ሃካይ?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>ታ ፆሳዉ፥ ጋላስ ኩመ ታ ኔኮ ዋሳስ፤</para>
  <para style="q2" vid="PSA 22:2">ሽን ነ ታና አላካ።</para>
  <para style="q2" vid="PSA 22:2">ቃማ ኡባን ኔኮ ዋሳይስ፥</para>
  <para style="q2" vid="PSA 22:2">ሽን ዎፓተ ደምከ።<verse eid="PSA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>ግዶሽን ኔኒ ጌሽ፤</para>
  <para style="q2" vid="PSA 22:3">እስራኤለ ጋላታይ ነ አራታ ዩሾን ደኤስ።<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>ኑ አዋት ነናን አማነትዶሶና፤</para>
  <para style="q2" vid="PSA 22:4">ነናን አማነትን፥ ነ ኤንታ አሻዳሳ።<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>ኔኮ ዋስድ አትዶሶና፤</para>
  <para style="q2" vid="PSA 22:5">ነናን አማነትድ ዬላትቦኮና።<verse eid="PSA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>ሽን ታ አሰ ግድከ፤ ጉፁነ፤</para>
  <para style="q2" vid="PSA 22:6">ታ አሳን ካትዳይሳነ ቦረትዳይሳ።<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>ታና በእያ ኡባይ ቀልቅሶሶና፤</para>
  <para style="q2" vid="PSA 22:7">ባንታ ሁጵያ ቃሸ ደሬቆሶና።<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>“እ ጎዳን አማነትስ፤ አነ እያ አሾ፤</para>
  <para style="q2" vid="PSA 22:8">ጎዳይ እያ ዶስኮ፥ አነ እያ አሾ” ያጎሶና።<verse eid="PSA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>ግዶሽን ታኒ ታ አየ ኡሎፐ</para>
  <para style="q2" vid="PSA 22:9">ሱረ የለታናዳ ኦዳይ ነና።</para>
  <para style="q1" vid="PSA 22:9">ታ አየ ን ምያ ዎደካ</para>
  <para style="q2" vid="PSA 22:9">ታና ናግዳይ ነና።<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>ታ የለቶሶፐ ዶማዳ ነናን ድጫስ፤</para>
  <para style="q2" vid="PSA 22:10">ታ አየ ኡሎፐ ዶምን ነ ታ ፆሳ።<verse eid="PSA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>መቶይ ታኮ ማትያ ግሾነ</para>
  <para style="q2" vid="PSA 22:11">ታና ማድያ አስ ባይና ግሾ፥</para>
  <para style="q2" vid="PSA 22:11">ሀእ ኔኒ ታፐ ሃኮፋ።<verse eid="PSA 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>ዳሮ ሞርከት ቃይጭያ ቦራዳ ታና ተቅዶሶና፤</para>
  <para style="q2" vid="PSA 22:12">ቃይጭያ ባሳነ ኮርማታዳ ታና ኦይክዶሶና።<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>መንረድ ጉድያ ጋሞዳ</para>
  <para style="q2" vid="PSA 22:13">ባንታ ዶና ታ ቦላ ዶዮሶና።<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>ታኒ ሃዳ ጎጋስ፤</para>
  <para style="q2" vid="PSA 22:14">ታ መቀይ ባ ከሱዋፐ ከይስ፤</para>
  <para style="q2" vid="PSA 22:14">ታ ዎዛናይ ኦይሳዳ ታ ጋን ትልእስ።<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>ታ ቆይ ኩንአዳ መልስ፤</para>
  <para style="q2" vid="PSA 22:15">ታ እንፃርሳይ ኮቶኑዋራ ኦይከትስ፤</para>
  <para style="q2" vid="PSA 22:15">ነ ታና ሀይቅዳ አሳዳ ባናን የጋዳሳ።<verse eid="PSA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>ካናት ታና ተቅዶሶና፤</para>
  <para style="q2" vid="PSA 22:16">ኢታ አሳት ታ ዩሹዋ ኦይክዶሶና፤</para>
  <para style="q2" vid="PSA 22:16">ታ ኩሸታነ ታ ቶሆታ ጫዶሶና።<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>ታ መቀት ታይበቶሶና፤</para>
  <para style="q2" vid="PSA 22:17">ታ ሞርከት ታና ደሬቆሶና።<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>ታ ማኡዋ ሻክድ ኤኮሶና፤</para>
  <para style="q2" vid="PSA 22:18">ታ አዱሳ ማኡዋ ቦላ ሳማ የጎሶና።<verse eid="PSA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>ታ ጎዳዉ፥ ነ ታ ማታይ ታፐ ሃኮፋ፤</para>
  <para style="q2" vid="PSA 22:19">ታ ዎልቃዉ፥ ታና ማዳናዉ ኤለሳዳ ሃያ።<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>ታና ማሻፈ ከሳ ኤካ፤</para>
  <para style="q2" vid="PSA 22:20">ታ አልኦ ደኡዋ ካናታፐ አሻ።<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>ጋሞታ ዶናፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 22:21">ቃይጭያ ባዞ ቦራታ ካጨፐ ታና ናጋ።<verse eid="PSA 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>ታኒ ነ ሱን ታ እሻታስ ኦዳና፤</para>
  <para style="q2" vid="PSA 22:22">ኤንታ ሺቁዋን ነና ጋላታና።<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>ህንተኖ፥ ጎዳ ያየሳቶ፥ እያ ጋላትተ፤</para>
  <para style="q2" vid="PSA 22:23">ህንተኖ፥ ያይቆባ ዛረቶ፥ እያ ቦንችተ።</para>
  <para style="q1" vid="PSA 22:23">ህንተኖ፥ እስራኤለ ኮቻቶ፥</para>
  <para style="q2" vid="PSA 22:23">ያሻን እያ ቁ ቁ ኦተ።<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>እ ኡንኤትዳይሳ ካና፤</para>
  <para style="q2" vid="PSA 22:24">ኤንታ ቆሁዋ በእሸ ቀል ጌና።</para>
  <para style="q1" vid="PSA 22:24">ባ ሶምኡዋ ኤንታፈ ገንና፤</para>
  <para style="q2" vid="PSA 22:24">ኤንቲ እያኮ ዋስያ ዎደ፥</para>
  <para style="q2" vid="PSA 22:24">ኤንታዉ ዞኮ ዛርቤና።<verse eid="PSA 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>ታ ነ ሎኦ ኦሱዋ ግሾ ግታ ሺቆን ጋላታና፤</para>
  <para style="q2" vid="PSA 22:25">ታ ቃንገ ነዉ ያይያ አሳ ስንን ጋና።<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>ማንቆት ምድ ካላና፤</para>
  <para style="q2" vid="PSA 22:26">ጎዳ ኮየይሳት እያ ጋላታና፤</para>
  <para style="q2" vid="PSA 22:26">ኤንቲ መርናዉ ኡፋይሳን ዳና።<verse eid="PSA 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>ሳአ ጋፃ ጋካናዉ ደእያ አሳ ኡባይ፥</para>
  <para style="q2" vid="PSA 22:27">አኬካን ጎዳኮ ስማና፤</para>
  <para style="q2" vid="PSA 22:27">አሳ ዛረ ኡባይ እያ ጎይናና።<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>ማት ኡባይ ጎዳሳ፤</para>
  <para style="q2" vid="PSA 22:28">እ ካዎተታ ሃሬስ።<verse eid="PSA 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>ሳአን ደእያ ዱረ ኡባይ እያ ጎይናና፤</para>
  <para style="q2" vid="PSA 22:29">ባንታና ሀይቆፐ አሻናዉ ዳንዳኦናይሳትነ</para>
  <para style="q2" vid="PSA 22:29">ቢታን ስምያ ኡባይ እያዉ ጉልባታና።<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>ያና የለታይ እያዉ ኪተታና፤</para>
  <para style="q2" vid="PSA 22:30">ስን የለታስ ጎዳባ ኦዳና።<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>ቡሮ የለትቦና አሳስካ፥</para>
  <para style="q2" vid="PSA 22:31">እያ ጌሻተ ኦዳና።<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="s1">ፆሳይ ታና ሄሜስ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 23:1"/>ጎዳይ ታ ሄንንቹዋ፤</para>
  <para style="q2" vid="PSA 23:1">ታዉ አይብካ ፓጨና።<verse eid="PSA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2"/>ታና አጫ ቆሮን ሸምፕሴስ፤</para>
  <para style="q2" vid="PSA 23:2">ዎፑ ግዳ ሃኮ ላጌስ።<verse eid="PSA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3"/>ታ ደኡዋ ኦራፅሴስ፤</para>
  <para style="q2" vid="PSA 23:3">ባ ሱን ግሾ ግድ፥</para>
  <para style="q2" vid="PSA 23:3">ታና ፅሎተ ኦግያ ካለስ።<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>ነ ታ ጎዳይ ታራ ደእያ ግሾ፥</para>
  <para style="q2" vid="PSA 23:4">ታ ሳካና ማ ግዶራ ቢኮካ፥</para>
  <para style="q2" vid="PSA 23:4">ኢታባ ያይከ።</para>
  <para style="q2" vid="PSA 23:4">ነ ፃምአይነ ነ ጉፈይ ታና ምንሶና።<verse eid="PSA 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>ታ ሞርከታ ስንን ታዉ ግብራ ጊግሳሳ፤</para>
  <para style="q2" vid="PSA 23:5">ታና ሞካሸ፥ ታ ሁጰን ዛይተ ትያሳ፤</para>
  <para style="q2" vid="PSA 23:5">ታ ዋንጫይ ኩምድ ጎጋና ጋካናዉ ኩንሳ።<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>ነ ኬሀተይነ ነ ማሮተይ</para>
  <para style="q2" vid="PSA 23:6">ታ ደኦ ላይ ኡባን ታና ካላና፤</para>
  <para style="q2" vid="PSA 23:6">ታኒ ጎዳ ኬን መርናዉ ዳና።<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="s1">ቦንቾ ካዋ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 24:1"/>ሳአይነ ሳአን ደእያ ኡባይ ጎዳባ፤</para>
  <para style="q2" vid="PSA 24:1">አላመይነ እያን ደእያ አሳ ኡባይ እያሳ።<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>እ ሳኣ ግታ አባ ቦላ ሂፅስ፤</para>
  <para style="q2" vid="PSA 24:2">ጪሞ ሃ ቦላ ምንድ ኤስስ።<verse eid="PSA 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>ጎዳ ዙማ ቦላ ከያናዉ ዳንዳኤይ ኦኔ?</para>
  <para style="q2" vid="PSA 24:3">እያ ጌሻ በሳን ኤቃናይ ኦኔ?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>እያ ኩሸይነ እያ ዎዛናይ ጌሽ ግድዳይሳ፤</para>
  <para style="q2" vid="PSA 24:4">ኤቃ ጎይኖናይሳ፥</para>
  <para style="q2" vid="PSA 24:4">ዎርዶ ጫቆናይሳ።<verse eid="PSA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>እ ጎዳፐ አንጆ ኤካና፤</para>
  <para style="q2" vid="PSA 24:5">አሽያ ፆሳፈ ፅሎ ፕርዳ ደማና።<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>ፆሳኮ ፄልያ አስነ</para>
  <para style="q2" vid="PSA 24:6">ያይቆባ ፆሳ ሶምኡዋ</para>
  <para style="q2" vid="PSA 24:6">ኮይያ አስ ሄሳ መላ አሰ። <char style="qs">ሳላሀ </char><verse eid="PSA 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>ቦንቾ ካዎይ ገላና መላ፥</para>
  <para style="q2" vid="PSA 24:7">ህንተኖ ፐንገቶ ዶየትተ፤</para>
  <para style="q2" vid="PSA 24:7">በን ፐንገት እያ ኡፋይሳን ሞክተ።<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>ሄ ቦንቾ ካዎይ ኦኔ?</para>
  <para style="q2" vid="PSA 24:8">ምኖነ ዎልቃማ ግድዳ ጎዳ፤</para>
  <para style="q2" vid="PSA 24:8">ኦላን ዎልቃማ ግድዳ ጎዳ።<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>ቦንቾ ካዎይ ገላና መላ፥</para>
  <para style="q2" vid="PSA 24:9">ህንተኖ ፐንገቶ ዶየትተ፤</para>
  <para style="q2" vid="PSA 24:9">በን ፐንገት እያ ኡፋይሳን ሞክተ።<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>ሀ ቦንቾ ካዎይ ኦኔ?</para>
  <para style="q2" vid="PSA 24:10">ሀ ቦንቾ ካዎይ ሳሎ መተታ ጎዳ! <char style="qs">ሳላሀ። </char><verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="s1">ኡንአ ዎደ ዎሳ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 25:1"/>አቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 25:1">ሸምፖፈ ታ ነና ዎሳይስ።<verse eid="PSA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>አቤት ታ ፆሳዉ፥ ታ ነናን አማነታይስ፤</para>
  <para style="q2" vid="PSA 25:2">ታና ዬላዮፓ፤</para>
  <para style="q2" vid="PSA 25:2">ታ ሞርከታስ ታና አዳ እሞፋ።<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>ነናን ኡፋይስ ኦይሳት ዬላቶኮና፤</para>
  <para style="q2" vid="PSA 25:3">ሽን ጋሶይ ባይና ገነይሳት ዬላታና።<verse eid="PSA 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>አቤት ጎዳዉ፥ ታና ነ ኦግያ በሳ፤</para>
  <para style="q2" vid="PSA 25:4">ነ ጌዶ ታና ካለ።<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>ታና አሽያ ፆሳይ ነና ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 25:5">ነ ቱማተ ታና ካለነ ታማርሳ፤</para>
  <para style="q2" vid="PSA 25:5">ጋላስ ኩመ ታ ነናን ኡፋይስ ኦይስ።<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>አቤት ጎዳዉ፥ በንፐ ደእያ</para>
  <para style="q2" vid="PSA 25:6">ነ ቃያነ ነ ኬሀተ ሀሳያ።<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>ታ ናአተ ናጋራነ ኢታባ ሀሳዮፓ፤</para>
  <para style="q2" vid="PSA 25:7">አቤት ጎዳዉ፥ ነ ኬሀተነ ሎኦተ ሀሳያ።<verse eid="PSA 25:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>ጎዳይ ኬሀነ ሱረ ግድያ ግሾ፤</para>
  <para style="q2" vid="PSA 25:8">ናጋራንቾታ ባ ኦግያ ታማርሴስ።<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>አሽከታ ሱረተን ካለስ፤</para>
  <para style="q2" vid="PSA 25:9">ኤንታና ባ ኦግያ ታማርሴስ።<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>ጎዳ ጫቁዋነ</para>
  <para style="q2" vid="PSA 25:10">እያ ኪታ ናገይሳታስ</para>
  <para style="q2" vid="PSA 25:10">እያ ኦገ ኡባይ ቱማነ ኬሀ።<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>አቤት ጎዳዉ፥ ታ ናጋራይ ዳሮ፤</para>
  <para style="q2" vid="PSA 25:11">ግዶሽን ነ ሱን ግሾ ታው አቶ ጋ።<verse eid="PSA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>ጎዳ ያይያ አስ ኦኔ?</para>
  <para style="q2" vid="PSA 25:12">እ ካላናዉ በሲያ ኦግያ</para>
  <para style="q2" vid="PSA 25:12">ጎዳይ እያ ታማርሳና።<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>እ ኡባ ዎደ ዱረተን ዳና፤</para>
  <para style="q2" vid="PSA 25:13">እያ ናይት ቢታ ላታና።<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>ጎዳይ ያየይሳታስ ባ ፁራ ገንና፤</para>
  <para style="q2" vid="PSA 25:14">እ ኤንታዉ ባ ጫቁዋ ኤርሴስ።<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>ጎዳይ ታ ቶሁዋ ፅሄፐ ናግያ ግሾ፥</para>
  <para style="q2" vid="PSA 25:15">ታ አይፈይ ማዶ ኤካናዉ ኡባ ዎደ እያኮ ፄሌስ።<verse eid="PSA 25:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>ጎዳዉ፥ ታኒ ብዛነ</para>
  <para style="q2" vid="PSA 25:16">መቶትዳ አስ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 25:16">ታኮ ስማ፤ ነ ማሮተ ታና በሳ።<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>ታዉ ህርግ ዳርስ፤</para>
  <para style="q2" vid="PSA 25:17">ታ መቱዋፐ ታና ነ አሻ።<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>ታ መቱዋነ ታ ዋይያ በአ፤</para>
  <para style="q2" vid="PSA 25:18">ታ ናጋራ ኡባ አቶ ጋ።<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>ታ ሞርከት አይ መላ ዳርዳኮ በአ፤</para>
  <para style="q2" vid="PSA 25:19">ኤንቲ ታና አይ መላ እፅያኮ ፄላ።<verse eid="PSA 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>ነ ታና ናጋ፤ ነ ታና አሻ፤</para>
  <para style="q2" vid="PSA 25:20">ታ ኔኮ ባቃትያ ግሾ ታና ዬላዮፓ።<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>ታ ነናን ኡፋይስ ኦዳ ግሾ፥</para>
  <para style="q2" vid="PSA 25:21">ሱረተነ ቱማተ ታና ናጎ።<verse eid="PSA 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>አቤት ፆሳዉ፥ እስራኤለ አሳ</para>
  <para style="q2" vid="PSA 25:22">ኤንታ መቶ ኡባፈ ነ ዎዛ።<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="s1">ፅሎ አሳ ዎሳ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 26:1"/>አቤት ጎዳዉ፥ ታ ሱረተን ሄመትዳ ግሾነ</para>
  <para style="q2" vid="PSA 26:1">ስይ ባይና ነናን አማነትዳ ግሾ፥</para>
  <para style="q2" vid="PSA 26:1">ታዉ ፕርዳ።<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>አቤት ጎዳዉ፥ ታና ፓጫ፤</para>
  <para style="q2" vid="PSA 26:2">ታና ፕልጋዳ በአ፤</para>
  <para style="q2" vid="PSA 26:2">ታ ዎዛና ፆሞሳ።<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>ነ ሲቆይ ታ ስንን ደእያ ግሾ፥</para>
  <para style="q2" vid="PSA 26:3">ታ ኡባ ዎደ ነ ቱማ ኦግያን ሄመታይስ።<verse eid="PSA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>ጭምያ አሳራ ታ ኡትከ፤</para>
  <para style="q2" vid="PSA 26:4">ጩቦታ ማባራን ገልከ።<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>ኢታታ ዱላታ ታ እፃይስ፤</para>
  <para style="q2" vid="PSA 26:5">ማካላቾታራ እስፈ ኡትከ።<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>አቤት ጎዳዉ፥ ታ ፅሎተ በሳናዉ</para>
  <para style="q2" vid="PSA 26:6">ታ ኩሽያ ሜጫይስ፤</para>
  <para style="q2" vid="PSA 26:6">ነ ያርሾ በሳ ዩያይስ።<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>ጋላታ ማዝሙረ የፃሸ</para>
  <para style="q2" vid="PSA 26:7">ነ ማላልስያ ኦሶ ኡባ ኦዳና።<verse eid="PSA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>አቤት ጎዳዉ፥ ነ ኬነ፥</para>
  <para style="q2" vid="PSA 26:8">ነ ቦንቾይ አቅያ በሳ ታ ዶሳይስ።<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>ታና ናጋራንቾታራ እስፈ ፕቶፋ፤</para>
  <para style="q2" vid="PSA 26:9">አሳ ሱ ጉሰይሳታራ ታ ሸምፑዋ ይሶፋ።<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>ኤንታ ኩሸን ኢታ ሀልቾይ ደኤስ፤</para>
  <para style="q2" vid="PSA 26:10">ኤንታ ኡሻቻ ኩሸን ዎፈይ ኩምስ።<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>ሽን ታ ሱረተን ሄመታና፤</para>
  <para style="q2" vid="PSA 26:11">ታና ዎዛ፤ ታዉ ቃታ።<verse eid="PSA 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>ታ ቶሆይ ደምባ በሳን ኤቅስ፤</para>
  <para style="q2" vid="PSA 26:12">ግታ ሺቁዋን ጎዳ ጋላታና።<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="s1">ፆሳራ ደእያ አሳ ፃላተ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 27:1"/>ጎዳይ ታዉ ፖኦነ ታና አሸይሳ፤</para>
  <para style="q2" vid="PSA 27:1">ያትን፥ ታ ኦና ያያኔ?</para>
  <para style="q1" vid="PSA 27:1">ጎዳይ፥ ታ ደኦይ ናገትያ ሚፃ፤</para>
  <para style="q2" vid="PSA 27:1">ያትን፥ ታ አይስ ዳጋማኔ?<verse eid="PSA 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>ኢታ አሳት፥ ታና እፀይሳትነ ታ ሞርከት</para>
  <para style="q2" vid="PSA 27:2">ታና ዎናዉ ሆርዶፍያ ዎደ፥</para>
  <para style="q2" vid="PSA 27:2">ባንታዉ በትድ ኩንዳና።<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>ሞርከ ቶር ታና ተቅኮ</para>
  <para style="q2" vid="PSA 27:3">ታ ዎዛናይ ያየና።</para>
  <para style="q1" vid="PSA 27:3">ኦል ታ ቦላ ደንድያኮካ፥</para>
  <para style="q2" vid="PSA 27:3">ታኒ ጎዳን አማነታይስ።<verse eid="PSA 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>ታ ጎዳ እስባ ኦይቻስ፤</para>
  <para style="q2" vid="PSA 27:4">ሄስካ፥ ታ ደኦ ላይ ኡባን</para>
  <para style="q1" vid="PSA 27:4">ጎዳ ኬን ደአናሳ፤</para>
  <para style="q2" vid="PSA 27:4">ጎዳ ሎኦተ በአናሳነ</para>
  <para style="q2" vid="PSA 27:4">እያ ኬን እያ ኮያናሳ።<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>መቶ ጋላስ ታና ባ ደእያ በሳን ገንና፤</para>
  <para style="q2" vid="PSA 27:5">ባ ዱንካንያን ታና ቆሳና፤</para>
  <para style="q2" vid="PSA 27:5">ታና ቃ ዛላ ቦላ ኤሳና።<verse eid="PSA 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>ሄ ዎደ ታኒ ታና ተቅዳ</para>
  <para style="q2" vid="PSA 27:6">ታ ሞርከታፐ አዳ፥</para>
  <para style="q2" vid="PSA 27:6">ቁ ቁ ጋና።</para>
  <para style="q1" vid="PSA 27:6">ታኒ እያ ዱንካንያን</para>
  <para style="q2" vid="PSA 27:6">ኡፋይታሸ ያርሾ ያርሻና፤</para>
  <para style="q2" vid="PSA 27:6">ጎዳ ማዝሙረን ጋላታና።<verse eid="PSA 27:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>አቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 27:7">ታ ነና ፄግያ ዎደ ነ ታዉ ኮያ፤</para>
  <para style="q2" vid="PSA 27:7">ታዉ ቃታ፤ ታና ስአ።<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>ኔኒ፥ “ታ ሶምኡዋ ኮይተ” ጋዳሳ፥</para>
  <para style="q2" vid="PSA 27:8">ታ ዎዛናይ አቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 27:8">“ታ ነ ሶምኡዋ ኮያና” ያግስ።<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>ነ ሶምኡዋ ታፐ ገንፋ፤</para>
  <para style="q2" vid="PSA 27:9">ታና ማደይሶ፤ ነ ሸነታዳ</para>
  <para style="q2" vid="PSA 27:9">ታና ነ አይልያ ጉየ ዛሮፓ።</para>
  <para style="q1" vid="PSA 27:9">አቤት ታና አሽያ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 27:9">ታና የጎፋ፤ አጎፋ።<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>ታ አዋይነ ታ አይያ ታና አግኮካ</para>
  <para style="q2" vid="PSA 27:10">ጎዳይ ታና ሺሽድ ኤካና።<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>አቤት ጎዳዉ፥ ታና ነ ኦግያ ታማርሳ፤</para>
  <para style="q2" vid="PSA 27:11">ታ ሞርከታ ግሾ ታና ሱረ ኦገ ካለ።<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>ታና ማንድያ ዎርዶ ማርካት</para>
  <para style="q2" vid="PSA 27:12">ታ ቦላ ዎልቃን ደንድዳ ግሾ፥</para>
  <para style="q2" vid="PSA 27:12">ታና ታ ሞርከታ አሙዋስ አዳ እሞፋ።<verse eid="PSA 27:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>ታኒ ደኦን ደአሸ፥</para>
  <para style="q2" vid="PSA 27:13">ጎዳ ኬሀተ በአናይሳ አማናይስ።<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>ጎዳን ኡፋይስ ኦ፤</para>
  <para style="q2" vid="PSA 27:14">ምና፥ ያዮፋ፤</para>
  <para style="q2" vid="PSA 27:14">ጎዳን ኡፋይስ ኦ።<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="s1">ፆሳይ ታዉ ጎንዳለነ ዎልቃ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 28:1"/>አቤት ጎዳዉ፥ ታ ዛላዉ፥</para>
  <para style="q2" vid="PSA 28:1">ታ ነና ፄጋይስ፤</para>
  <para style="q2" vid="PSA 28:1">ነ ታዉ ስእ ጎፓ።</para>
  <para style="q1" vid="PSA 28:1">ነ ስእ ጊኮ፥</para>
  <para style="q2" vid="PSA 28:1">ታ ዱፎ ገልዳ አስ ግዳይስ።<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>ማደ ኮያዳ ታ ዋስያ ዎደ፤</para>
  <para style="q2" vid="PSA 28:2">ኡባፈ ጌሻ ዱንካንያኮ፥</para>
  <para style="q2" vid="PSA 28:2">ታ ኩሽያ ምጭያ ዎደ ታ ዎሳ ስአ።<verse eid="PSA 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>ኢታ ኦያ ኢታ አሳታራ ታና ጋዳ ኦይኮፋ፤</para>
  <para style="q2" vid="PSA 28:3">ኤንቲ ባንታ ዎዛናን ገነ ቆፕሸ፥</para>
  <para style="q2" vid="PSA 28:3">ባንታ ዶናን ሳሮተ ሃሳዮሶና።<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>ኤንታ ኦሱዋዳ ኤንታ ሴራ፤</para>
  <para style="q2" vid="PSA 28:4">ኤንታ ኢታተዳ ኤንታዉ ቃንፃ።</para>
  <para style="q1" vid="PSA 28:4">ኤንታ ኩሸ ኦሱዋዳ ኤንታ ፕርዳ፤</para>
  <para style="q2" vid="PSA 28:4">ኤንታዉ በሲያ ኢታ ኤንታዉ ዛራ።<verse eid="PSA 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>ኤንቲ ጎዳ ኦሱዋነ እያ ኩሸ መዋስ፥</para>
  <para style="q2" vid="PSA 28:5">በሰ እሞና ግሾ ጎዳይ ኤንታ ላላና፤</para>
  <para style="q2" vid="PSA 28:5">ዛሪድ ኤንታ ኬፀና።<verse eid="PSA 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>ታ ዎሳ ስእዳ ግሾ</para>
  <para style="q2" vid="PSA 28:6">ጎዳይ ጋላተቶ።<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>ጎዳይ ታዉ ዎልቃነ ጎንዳለ፤</para>
  <para style="q2" vid="PSA 28:7">ታ ዎዛናይ እያን አማነቴስ፤</para>
  <para style="q2" vid="PSA 28:7">ታ እያን ማደታስ።</para>
  <para style="q1" vid="PSA 28:7">ታ ዎዛናይ እያን ኡፋይቴስ፤</para>
  <para style="q2" vid="PSA 28:7">ታ እያ ማዝሙረን ሳባና።<verse eid="PSA 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>ጎዳይ ባ አሳስ ዎልቃ፤</para>
  <para style="q2" vid="PSA 28:8">ባ ዶርድ ካዋ አሽያ ሚፃ።<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>ጎዳዉ፥ ነ አሳ አሻ፤</para>
  <para style="q2" vid="PSA 28:9">ነባ ግድዳይሳታ አንጃ።</para>
  <para style="q1" vid="PSA 28:9">ኤንታ ሄመይ ነና ግዳ፤</para>
  <para style="q2" vid="PSA 28:9">ኤንታ መርናዉ ቶካ።<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="s1">ፆሳ ግታተ ሳቦ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 29:1"/>ህንተኖ ሳሎ መተቶ፥</para>
  <para style="q2" vid="PSA 29:1">ቦንቾይነ ዎልቃይ ጎዳሳ ጊተ።<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>ጎዳ ቦንቾ ሱን ጋላትተ፤</para>
  <para style="q2" vid="PSA 29:2">እያ ጌሻተ ቴማ ግሾ ጎዳ ጎይንተ።<verse eid="PSA 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>ጎዳ ጉንይ ሃታ ቦላ ስኤቴስ፤</para>
  <para style="q2" vid="PSA 29:3">ቦንቾ ፆሳይ ዳዳዳ ደቼስ፤</para>
  <para style="q2" vid="PSA 29:3">ጎዳይ ግታ ሃታ ቦላ ጉሜስ።<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>ጎዳ ኮሽንቻይ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 29:4">ጎዳ ግርሳይ ቴማራ ደኤስ።<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>ጎዳ ግርሳይ ዝጋ መንስ፤</para>
  <para style="q2" vid="PSA 29:5">ልባኖሰን ደእያ ዝጋ መንስ።<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>ልባኖሰ ደረታ ጋሎ ማራዳ ቡራቅሴስ፤</para>
  <para style="q2" vid="PSA 29:6">ስርዮና ደርያ<note caller="+" style="f"><char style="fr" closed="false">29:6 </char><char style="fq" closed="false">ስርዮና ደርያ፦ </char><char style="ft" closed="false">ሄርሞና ደርያስ ሀራ ሱን</char></note> መንዳ ጉፍሴስ።<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>ጎዳ ግርሳይ ዎልአሜስ።<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>ጎዳ ግርሳይ መላ ብታ ቃስ፤</para>
  <para style="q2" vid="PSA 29:8">ጎዳይ ቃደሳ መላ ብታ ኮኮርሴስ።<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>ጎዳ ግርሳይ ዎላ ቃስ፤</para>
  <para style="q2" vid="PSA 29:9">ም ሀይ ቆቆፌስ።</para>
  <para style="q1" vid="PSA 29:9">እያ ኬን ደእያ ኡባይ፥</para>
  <para style="q2" vid="PSA 29:9">“ቦንቾይ ጎዳስ ግዶ” ያጌስ።<verse eid="PSA 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>ጎዳይ ድኦ ሃ ቦላ</para>
  <para style="q2" vid="PSA 29:10">ባ አራታ ዎድ ኡትስ፤</para>
  <para style="q2" vid="PSA 29:10">ጎዳይ ባ አራታን ኡትድ መርናዉ ካዎትስ።<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>ጎዳይ ባ አሳስ ዎልቃ እሜስ።</para>
  <para style="q2" vid="PSA 29:11">ጎዳይ ባ አሳ ሳሮተን አንጄስ።<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="s1">ቆሆፐ አትዳ አሳ ጋላታ</para>
  <para style="d">ኬ አንጅሶስ ዳዊቲ የፅዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 30:1"/>አቤት ጎዳዉ፥ ነ ታና ኦላፈ ከስዳ ግሾነ</para>
  <para style="q2" vid="PSA 30:1">ታ ሞርከት ኡፋይቶና መላ ኦዳ ግሾ፥</para>
  <para style="q2" vid="PSA 30:1">ታ ነና ቁ ቁ ኦና።<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>አቤት ጎዳዉ፥ ታ ፆሳዉ ታና ማዳና መላ፥</para>
  <para style="q2" vid="PSA 30:2">ታ ነና ፄግን ነ ታና ፓዳሳ።<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>አቤት ጎዳዉ፥ ዱፎ ገሎናዳ ታና ናጋዳሳ፤</para>
  <para style="q2" vid="PSA 30:3">ኦላን ዎናዳ ታና ፓፃ አሻዳሳ።<verse eid="PSA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>ህንተኖ ፆሳ አሳዉ፥</para>
  <para style="q2" vid="PSA 30:4">ጎዳስ የፅተ፤</para>
  <para style="q2" vid="PSA 30:4">እያ ጌሻ ሱን ሳቢተ።<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>እያ ሀንቆይ ጉ ዎደሳ፥</para>
  <para style="q2" vid="PSA 30:5">ሽን እያ ኬሀተይ ደኦ ላይ ኡባሳ።</para>
  <para style="q1" vid="PSA 30:5">ቃማ ዬክሸ አቅኮ፥</para>
  <para style="q2" vid="PSA 30:5">ዎንታ ዛው ባይና ኡፋይስ ግዴስ።<verse eid="PSA 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>ታ ናገታዳ ደኤይሳ ኤርዳ ዎደ</para>
  <para style="q2" vid="PSA 30:6">“ህዛ ታ ቃፅከ” ያጋስ።<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>አቤት ጎዳዉ፥ ነ ታዉ ኬህዳ ዎደ፥</para>
  <para style="q2" vid="PSA 30:7">ዙማዳ ታና ምንዳ ኤሳዳሳ።</para>
  <para style="q1" vid="PSA 30:7">ሽን ነ ሶምኡዋ ሀራ ሶ ዛርዳ ዎደ፥</para>
  <para style="q2" vid="PSA 30:7">ታ ዳጋማስ።<verse eid="PSA 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>አቤት ጎዳዉ፥ ታ ነና ፄጋስ፤</para>
  <para style="q2" vid="PSA 30:8">ነና ማሮታ ዎሳስ፤<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“ታ ዱፎ ገልኮ ነና አይ ጎኢ?</para>
  <para style="q2" vid="PSA 30:9">ቢታ ግዶ ገልዳ አስ</para>
  <para style="q2" vid="PSA 30:9">ዋትድ ነና ጋላታናዉ ዳንዳኢ?</para>
  <para style="q2" vid="PSA 30:9">ነ አማነተ ዋትድ ማርካታኔ?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>አቤት ጎዳዉ፥ ነ ታና ስአ፤</para>
  <para style="q2" vid="PSA 30:10">ታዉ ቃታ።</para>
  <para style="q2" vid="PSA 30:10">አቤት ጎዳዉ፥ ነ ታዉ ማዶ ግዳ” ያጋስ።<verse eid="PSA 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>ታ ዬሁዋ የን ላማዳሳ፤</para>
  <para style="q2" vid="PSA 30:11">ካዮ ማኡዋ ታፐ ቃራዳ፥</para>
  <para style="q2" vid="PSA 30:11">ታና ኡፋይስ ማይዛዳሳ።<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>ሄሳ ግሾ፥ ታ ነና ሳባና፤ ስእ ጊከ።</para>
  <para style="q2" vid="PSA 30:12">አቤት ጎዳዉ፥ ታ ፆሳዉ፥ ታ ነና መርናዉ ጋላታና።<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="s1">ታ ሸምፕዉ ነ ኩሸን ዎስ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 31:1"/>አቤት ጎዳዉ፥ ታ ኔኮ ባቃታይስ፤</para>
  <para style="q2" vid="PSA 31:1">አዉደካ ታና ዬላዮፓ፤</para>
  <para style="q2" vid="PSA 31:1">ነ ፅሎተን ታና አሻ።<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>ነ ሀይ ታኮ ዛራ፤</para>
  <para style="q2" vid="PSA 31:2">ኤለሳዳ ታና አሻ።</para>
  <para style="q1" vid="PSA 31:2">ኔኒ ታዉ ጌምያ ዛላ፤</para>
  <para style="q2" vid="PSA 31:2">ታና አሽያ ምኖ ሚፃ ግዳ።<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>ኤ፥ ነ ታዉ ዛላነ ሚፃ፤</para>
  <para style="q2" vid="PSA 31:3">ነ ሱን ግሾ ታና ካለ፤</para>
  <para style="q2" vid="PSA 31:3">ኦግያ በሳ።<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>ነ ታዉ ጌምያ በሰ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 31:4">ኤንቲ ቆትድ ዎዳ ፅሄፐ ታና ናጋ።<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>አቤት ጎዳዉ፥ ቱማ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 31:5">ታ ሸምፑዋ ነ ኩሸን ዎይስ፤</para>
  <para style="q2" vid="PSA 31:5">ነ ታና ዎዛ።<verse eid="PSA 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>ፓና ኤቃታ ጎይነይሳታ ታ እፃይስ፤</para>
  <para style="q2" vid="PSA 31:6">ግዶሽን ታኒ ጎዳን አማነታይስ።<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>ታ መቱዋነ ታ ኡንአ ነ በእዳ ግሾ</para>
  <para style="q2" vid="PSA 31:7">ታኒ መርናዉ ነ ሲቁዋን ኡፋይታና።<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>ነ ታና ሞርከ ኩሸን አዳ እማባካ፤</para>
  <para style="q2" vid="PSA 31:8">ታ ቶሆታ ዳልጋ በሳን ኤሳዳሳ።<verse eid="PSA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>አቤት ጎዳዉ፥ ታኒ መቶን ገልዳ ግሾ ታዉ ቃታ፤</para>
  <para style="q2" vid="PSA 31:9">ታ ዳሮ አዛንዳ ግሾ ታ አይፈይ ሙልጫትስ፤</para>
  <para style="q2" vid="PSA 31:9">ታ አሾይነ ታ ሸምፖይ ዳቡርስ።<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>ታ ደኦይ አዛኖን፥ ታ ላይይ ኦለን ዉርስ፤</para>
  <para style="q2" vid="PSA 31:10">ዋየ ዳሮተን ታ ዎልቃይ ዉርስ፤</para>
  <para style="q2" vid="PSA 31:10">ታ መቀት አርጋጭዶሶና።<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>ታ ሞርከታ ኡባስ ቅስ አታስ፤</para>
  <para style="q2" vid="PSA 31:11">ታ ሾሮታስ ዬላ ግዳስ።</para>
  <para style="q1" vid="PSA 31:11">ታ ላገታስ ዳጋንያባ ግዳስ፤</para>
  <para style="q2" vid="PSA 31:11">ታና በኤይሳት ታፐ ሃክዶሶና።<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>ታ ሀይቅዳ አሳዳ ዶገታስ፤</para>
  <para style="q2" vid="PSA 31:12">መቃ ሚሸዳ ዎራ የገታስ።<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>ታኒ ዳሮታ ካልካሻ ስአስ፤</para>
  <para style="q2" vid="PSA 31:13">ኡባ በሳራ ዳጋም ደኤስ።</para>
  <para style="q1" vid="PSA 31:13">ኤንቲ ታ ቦላ ቶቦሶና፤</para>
  <para style="q2" vid="PSA 31:13">ታና ዎናዉ ማቀቶሶና።<verse eid="PSA 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>ሽን ጎዳዉ፥ ታ ነናን አማነታና፤</para>
  <para style="q2" vid="PSA 31:14">ኔኒ ታ ፆሳ።<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>ታ ደኦ ላይይ ነ ኩሽያና፤</para>
  <para style="q2" vid="PSA 31:15">ታና የደያ ታ ሞርከታ ኩሸፐ አሻ።<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>ነ አይልያ ቦላ ነ ሶምኡዋ ፖእሳ፤</para>
  <para style="q2" vid="PSA 31:16">ነ ማሮተን ታና አሻ።<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>አቤት ጎዳዉ፥ ታ ነና ፄግያ ግሾ፥</para>
  <para style="q2" vid="PSA 31:17">ታና ዬላዮፓ።</para>
  <para style="q1" vid="PSA 31:17">ሽን ኢታት ዬላቶ፤</para>
  <para style="q2" vid="PSA 31:17">ዱፎን ገልድ ስእ ጎ።<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>ኦቶሮንነ ቦረን ፅሎታ ቦላ</para>
  <para style="q2" vid="PSA 31:18">ምንድ ሃሳያ ግሾ፥</para>
  <para style="q2" vid="PSA 31:18">ኤንታ ዎርዶ እንፃርሳ ስእ ኦ።<verse eid="PSA 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>ነና ያየይሳታስ ነ ምንጅዳ፥</para>
  <para style="q2" vid="PSA 31:19">ኔኮ ባቃተይሳታስ ነ ጊግስዳ፥</para>
  <para style="q2" vid="PSA 31:19">ኬሀተይ አይ መላ ዳሮ!<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>ኔኒ ኤንታ ነ ስንን፥ ጌማ በሳን ገን ዎዳሳ፤</para>
  <para style="q2" vid="PSA 31:20">አሳ ኢታ ማቁዋፈ አሻሳ፤</para>
  <para style="q2" vid="PSA 31:20">ኢታ እንፃርሳፈ ነ ዱንካንያን ቆሳዳሳ።<verse eid="PSA 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>ሞርከይ ተቅዳ ካታማ ግዶን፥</para>
  <para style="q2" vid="PSA 31:21">ማላልስያ ባ ማሮተ ታና በስዳ፥</para>
  <para style="q2" vid="PSA 31:21">ጎዳይ ጋላተቶ።<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>ታ ዳጋማዳ፥ “ነ ስንፈ ሃካስ” ጋስ፤</para>
  <para style="q2" vid="PSA 31:22">ሽን ታ ማዶ ኮያዳ ኔኮ ዋስዳ ዎደ፥</para>
  <para style="q2" vid="PSA 31:22">ታ ዋሱዋ ነ ስአዳሳ።<verse eid="PSA 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>ህንተኖ፥ ፆሳ አሳዉ፥ ጎዳ ዶስተ፤</para>
  <para style="q2" vid="PSA 31:23">ጎዳይ አማነተይሳታ ናጌስ፤</para>
  <para style="q2" vid="PSA 31:23">ሽን ኦቶራንቾታስ ኤንታ ጋትያ ቃንፄስ።<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>ህንተኖ፥ ጎዳን ኡፋይስ ኦይሳቶ፥</para>
  <para style="q2" vid="PSA 31:24">ምንተ፤ ገንጭተ።<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="s1">ናጋር አቶ ጌተትዳ አስ አንጀትዳይሳ</para>
  <para style="d">ዳዊታ ትምርተ</para>
  <para style="d">አኬካን ፃፈትዳ ግንፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 32:1"/>እያ ናጋራይ አቶ ጌተትዳይነ</para>
  <para style="q2" vid="PSA 32:1">እያ ናጋራይ ካመትዳ ኡራይ አንጀትዳይሳ።<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>ጎዳይ እያ ኢታተ ታይቦና አስ፥</para>
  <para style="q2" vid="PSA 32:2">እያ ቆፋን ጭሞይ ባይና አስ አንጀትዳይሳ።<verse eid="PSA 32:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>ታኒ ታ ናጋራ ፓፆና አጋዳ፥</para>
  <para style="q2" vid="PSA 32:3">ኩመ ጋላስ ኦልዳይስ፥</para>
  <para style="q2" vid="PSA 32:3">ታ አሳተ ዳቡርስስ።<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>ጋላስነ ቃማ ነ ኩሸይ ታና ዴፅስ፤</para>
  <para style="q2" vid="PSA 32:4">ሃ ይን ቦነ አዋን መልድባዳ፥</para>
  <para style="q2" vid="PSA 32:4">ታ ዎልቃይ ዉርስ። <char style="qs">ሳላሀ </char><verse eid="PSA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>ታኒ ታ ናጋራ ነዉ ፓፃስ፤</para>
  <para style="q2" vid="PSA 32:5">ታ ናቁዋ ኔፐ ገንብከ።</para>
  <para style="q1" vid="PSA 32:5">“ታ ናጋራ ጎዳስ ፓፃና” ያጋስ፤</para>
  <para style="q2" vid="PSA 32:5">ታና ዴፅዳ ናጋራ አቶ ጋዳሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>ሄሳ ግሾ፥ ፅሎ አስ ኦንካ፥</para>
  <para style="q2" vid="PSA 32:6">ነ በንትያ ዎደ ነና ዎሶ፤</para>
  <para style="q2" vid="PSA 32:6">ኢታ ድኦይ ያ ዎደ ሄ ኡራ ጋከና።<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>ነ ታዉ ቆሰትያ በሲ፤</para>
  <para style="q2" vid="PSA 32:7">ነ ታና መቶፐ ናጋሳ።</para>
  <para style="q2" vid="PSA 32:7">አቶተ የ የፅያ አሳ</para>
  <para style="q2" vid="PSA 32:7">ታ ዩሹዋን ዎዳሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>ፆሳይ፥ “ታ ነና ታማርሳና፤</para>
  <para style="q2" vid="PSA 32:8">ነ ባና ኦግያ በሳና፤</para>
  <para style="q2" vid="PSA 32:8">ታ ነና ዞራናነ ናጋና” ያጌስ።<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>ብፃላንነ ፑሎን ኦይከቶና፤</para>
  <para style="q2" vid="PSA 32:9">ኪተቶና ዎዛን ባይና ባቁሎዳ</para>
  <para style="q2" vid="PSA 32:9">ዎይኮ ፓራዳ ሀኖፕተ።<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>ኢታታስ ዋየይ ዳራና፤</para>
  <para style="q2" vid="PSA 32:10">ሽን ጎዳን አማነተይሳታ ሲቆይ ካማና።<verse eid="PSA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>ህንተኖ፥ ፅሎቶ፥</para>
  <para style="q2" vid="PSA 32:11">ጎዳን ኡፋይትተነ ሀሹ ጊተ፤</para>
  <para style="q2" vid="PSA 32:11">ህንተኖ፥ ዎዛና ሱረቶ፥ እልልተ።<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="s1">ኬሀ ፆሳይ ሳበቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 33:1"/>ህንተኖ፥ ፅሎቶ ጎዳስ ኡፋይሳን እልልተ፤</para>
  <para style="q2" vid="PSA 33:1">ሱረ አሳት እያ ጋላታናዉ በሴስ።<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>ማስንቆን ጎዳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 33:2">ታሙ ሻያን ዋፀትዳ ዲን የፅተ።<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>ኦራ የ እያዉ የፅተ፤</para>
  <para style="q2" vid="PSA 33:3">ዲ ሎይድ ዲፅሸ እልልተ።<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>ጎዳ ቃላይ ቱማ፤</para>
  <para style="q2" vid="PSA 33:4">እያ ኦሶ ኡባይ አማነተይሳ።<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>ጎዳይ ፅሎተነ ቱማ ፕርዳ ዶሴስ፤</para>
  <para style="q2" vid="PSA 33:5">እያ ማሮታይ ሳኣ ኩምስ።<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>ጎዳ ቃላን ሳሎት መትዶሶና፤</para>
  <para style="q2" vid="PSA 33:6">እያ ዶናፐ ከይያ ሸምፑዋን</para>
  <para style="q2" vid="PSA 33:6">ሳሎን ደእያ መተት የለትዶሶና።<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>አባ ሃ እስ በሳን ኤልስስ፤</para>
  <para style="q2" vid="PSA 33:7">ጪሞ ሃ ምንጃ ኬን ዎስ።<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>ሳአ ኡባይ ጎዳ ያዮ፤</para>
  <para style="q2" vid="PSA 33:8">አሳ ኡባይ ጎዳ ቦንቾ።<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>እያ ኦዳን ኡባይ ሀንስ፤</para>
  <para style="q2" vid="PSA 33:9">እ ኪትን ምንድ ኤቅስ።<verse eid="PSA 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>ጎዳይ ካዎተታ ሀልቹዋ ሀዳ ኦስ፤</para>
  <para style="q2" vid="PSA 33:10">ኤንታ ቆፋ ላሌስ።<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>ጎዳ ሀልቾይ መርናዉ ኤቅድ ደኤስ፤</para>
  <para style="q2" vid="PSA 33:11">እያ ዎዛና ቆፋይ የለተ ኡባሳ።<verse eid="PSA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>ፆሳይ ኤንታዉ ጎዳ ግድዳ ካዎተይ፥</para>
  <para style="q2" vid="PSA 33:12">እ ባባ ኦድ ዶርዳ አሳይ አንጀትዳይሳታ።<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>ጎዳይ ሳሎን ኡትድ ፄሌስ፤</para>
  <para style="q2" vid="PSA 33:13">አሳ ኮቸ ኡባ በኤስ።<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>ጎዳይ ባ አራታን ኡትድ፥</para>
  <para style="q2" vid="PSA 33:14">ሳአን ደእያ ኡባ በኤስ።<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>ኤንታ ዎዛና መዳይ እያ፤</para>
  <para style="q2" vid="PSA 33:15">ኤንቲ ኦያባ ኡባ እ ኤሬስ።<verse eid="PSA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>ካዎይ ባ ዎታዳረ ዳሮተን አተና፤</para>
  <para style="q2" vid="PSA 33:16">ኦላንቾይ ባ ዎልቃ ምኖተን ከስ ኤከና።<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>ፓራን ፆናና ግድ ናጎይ ሀዳ፤</para>
  <para style="q2" vid="PSA 33:17">እ ባ ምኖተን አሻናዉ ዳንዳኤና።<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>ጎዳ አይፈት እያዉ ያያነ</para>
  <para style="q2" vid="PSA 33:18">እያ ማሮታን ኡፋይስ ኦያ አሳ በኦሶና።<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>ሄስካ ኤንታ ሀይቆፐ አሻናሳነ</para>
  <para style="q2" vid="PSA 33:19">ኮሻ ዎደ ኤንታ ናጋናሳ።<verse eid="PSA 33:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>ኑኒ ጎዳ ኡፋይሳን ናጎስ፤</para>
  <para style="q2" vid="PSA 33:20">ኑና ማደይነ ኑ ጎንዳለይ እያ።<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>እያ ጌሻ ሱንን ኑኒ አማነትያ ግሾ፥</para>
  <para style="q2" vid="PSA 33:21">ኑ ዎዛናይ እያን ኡፋይቴስ።<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>ጎዳዉ፥ ኑኒ ነናን ኡፋይስ ኦዳይሳዳ፥</para>
  <para style="q2" vid="PSA 33:22">ነ ማሮታይ ኑ ቦላ ግዶ።<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="s1">ፆሳይ ኬሀ ግደይሳ በእተ</para>
  <para style="d">ዳዊቲ ጎሹ ዳንድ ሺቅዳ ግሾ፥ አብመለከ ስንፈ ጎደትድ ከይዳ ዎደ የፅዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 34:1"/>ታኒ ኡባ ዎደ ጎዳ ጋላታና፤</para>
  <para style="q2" vid="PSA 34:1">እያ ጋላታይ ታ ዶናፐ ፓጨና።<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>ታኒ ጎዳን ጬቀታይስ፤</para>
  <para style="q2" vid="PSA 34:2">አዳት ሄሳ ስእድ ኡፋይቶ።<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>ታራ ጎዳ ቦንችተ፤</para>
  <para style="q2" vid="PSA 34:3">እያ ሱን እስፈ ቁ ቁ ኦስ።<verse eid="PSA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>ታኒ ጎዳ ኮይን፥ እ ታዉ ዛርስ፤</para>
  <para style="q2" vid="PSA 34:4">ታ ያይያባ ኡባፈ ታና አሽስ።<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>እያኮ ፄልያ ኡባይ ፖኦሶና፤</para>
  <para style="q2" vid="PSA 34:5">ኤንታ ሶምኦይ ዬላተና።<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>ሀ ማንቆይ ዋስስ፤</para>
  <para style="q2" vid="PSA 34:6">ጎዳይ እያ ዋሱዋ ስእስ፤</para>
  <para style="q2" vid="PSA 34:6">እያ መቶ ኡባፈ እያ አሽስ።<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>ጎዳ ኪታንቾይ እያዉ ያየይሳታ ናጌስ፤</para>
  <para style="q2" vid="PSA 34:7">ኤንታ ዩሾን ግድድ ኤንታ አሼስ።<verse eid="PSA 34:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>ጎዳይ ኬሀ ግደይሳ ላጭድ በእተ፤</para>
  <para style="q2" vid="PSA 34:8">እያኮ ባቃትያ አስ አንጀትዳይሳ።<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>ህንተኖ፥ ጌሻ አሳዉ፥ ጎዳስ ያይተ፤</para>
  <para style="q2" vid="PSA 34:9">እያዉ ያየይሳታስ አይኮይካ ፓጨና።<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>ጋሞት ምያባ ይድ ኮሻቶሶና፤</para>
  <para style="q2" vid="PSA 34:10">ሽን ጎዳ ኮየይሳታስ ሎኦባይ ፓጨና።<verse eid="PSA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>ናይቶ፥ ሃ ዪተ፤ ስእተ፤</para>
  <para style="q2" vid="PSA 34:11">ታ ህንተና ጎዳ ያሽ ታማርሳና።<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>ሎኦ ደኦ ዳናዉነ</para>
  <para style="q2" vid="PSA 34:12">ኬሀባ በአናዉ አዱሳ ላይ ዳናዉ፥</para>
  <para style="q2" vid="PSA 34:12">አሞተይ ኦኔ?<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>ነ እንፃርሳይ ኢታባ ኦደቶናዳ፥</para>
  <para style="q2" vid="PSA 34:13">ነ ዶናይ ጭሞናዳ ተቃ።<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>ኢታፐ ሃካ፤ ሎኦባ ኦ፤</para>
  <para style="q2" vid="PSA 34:14">ሳሮተ ኮያ፤ ካላ።<verse eid="PSA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>ጎዳ አይፈይ ፅሎታ ፄሌስ፤</para>
  <para style="q2" vid="PSA 34:15">እያ ሀይይ ኤንታ ዋሱዋ ስኤስ።<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>ኤንታ ቆፍስያባ ቢታፈ ይሳናዉ፥</para>
  <para style="q2" vid="PSA 34:16">ጎዳይ ኢታ ኦይሳታ ባ ሀንቆ አይፈን ፄሌስ።<verse eid="PSA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>ፅሎት ዋሶሶና፤</para>
  <para style="q2" vid="PSA 34:17">ጎዳይ ኤንታ ዋሱዋ ስኤስ፤</para>
  <para style="q2" vid="PSA 34:17">እ ኤንታ መቶ ኡባፈ አሼስ።<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>ዎዛን መቅዳይሳታስ ጎዳይ ማታና፤</para>
  <para style="q2" vid="PSA 34:18">እ ኡፋይስ ቃንፅዳይሳታ አሼስ።<verse eid="PSA 34:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>ፅሎ አሳስ መቶይ ዳሮ፤</para>
  <para style="q2" vid="PSA 34:19">ሽን ጎዳይ እያ ሄ ኡባፈ አሼስ።<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>ጎዳይ እያ መቀታ ናግያ ግሾ፥</para>
  <para style="q2" vid="PSA 34:20">ኤንታፈ እሶይካ መቀና።<verse eid="PSA 34:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>ኢታታ ኤንታ ኢታተይ ዎና፤</para>
  <para style="q2" vid="PSA 34:21">ፅሎታ እፀይሳት ፕርደታና።<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>ጎዳይ ባ አይለታ ዎዜስ፤</para>
  <para style="q2" vid="PSA 34:22">እያኮ ባቃትያ ኦንካ ፕርደተና።<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="s1">ብፃትዳ አሳ ዎሳ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 35:1"/>ጎዳዉ፥ ታራ ባፀተይሳታራ ነ ባፀታ፤</para>
  <para style="q2" vid="PSA 35:1">ታና ኦለይሳታ ነ ኦላ።<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>ጎንዳለነ ቶራ ኦይካዳ፥</para>
  <para style="q2" vid="PSA 35:2">ታና ማዳናዉ ደንዳ።<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>ታና ጎደይሳታ ቦላ</para>
  <para style="q2" vid="PSA 35:3">ነ ቶራነ ማሻ ደን፤</para>
  <para style="q2" vid="PSA 35:3">ታኮ “ታ ነና አሸይሳ” ያጋ።<verse eid="PSA 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>ታ ሸምፑዋ ዎናዉ ኮየይሳት፥</para>
  <para style="q2" vid="PSA 35:4">ዬላቶ፤ ካዉዮ።</para>
  <para style="q1" vid="PSA 35:4">ታ ቦላ ኢታባ ማቀተይሳት፥</para>
  <para style="q2" vid="PSA 35:4">ካዉይድ ጉየ ስሞ።<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>ጎዳ ኪታንቾይ ኤንታ የደያ ዎደ፥</para>
  <para style="q2" vid="PSA 35:5">ኤንቲ ጫርኮን ላለትያ ሱላዳ ሀኖ።<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>ጎዳ ኪታንቾይ ኤንታ ጎድያ ዎደ፥</para>
  <para style="q2" vid="PSA 35:6">ኤንታ ኦገይ ማነ ሀል ግዶ።<verse eid="PSA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>ጋሶይ ባይና ታና ኦይካናዉ ፅሄ ዎሶና፤</para>
  <para style="q2" vid="PSA 35:7">ታና ኩንድሳናዉ ኦላ ቦኮሶና።<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>ኤሮና ደእሽን ኤንታ ቦላ ዮይ ዮ፤</para>
  <para style="q2" vid="PSA 35:8">ኤንቲ ዎዳ ፅሄይ ኤንታ ኦይኮ፤</para>
  <para style="q2" vid="PSA 35:8">ኤንቲ ቦክዳ ኦላን ኩንድድ ዮ።<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>ሄ ዎደ ታኒ ጎዳን ኡፋይታና፤</para>
  <para style="q2" vid="PSA 35:9">እ አሽዳ ግሾ ሀሹ ጋና።<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>ታ ኩመ አሳተይ ነና፥</para>
  <para style="q2" vid="PSA 35:10">“ጎዳዉ፥ ነ መል ኦኔ?</para>
  <para style="q1" vid="PSA 35:10">ማንቁዋ ዎልቃማ ኩሽያፐ ከሳ ኤካሳ፤</para>
  <para style="q2" vid="PSA 35:10">መቶታንቹዋነ ኡንኤትዳይሳ፥</para>
  <para style="q2" vid="PSA 35:10">ቦንቀይሳታ ኩሸፐ አሻሳ” ያጋና።<verse eid="PSA 35:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>ዎርዶ ማርካተይሳት ታ ቦላ ደንዶሶና፤</para>
  <para style="q2" vid="PSA 35:11">ታ ኤሮናባን ታና ሞቶሶና።<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>ታ ሎኦ ኦዳ ግሾ ኢታ ዛርዶሶና፤</para>
  <para style="q2" vid="PSA 35:12">ታና ብዛ ኦዶሶና።<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>ሽን ኤንቲ ሀርግዳ ዎደ ታኒ ካዮ ማኦ ማአስ፤</para>
  <para style="q2" vid="PSA 35:13">ታ አሳተ ፆማን ዳቡርሳስ፤</para>
  <para style="q2" vid="PSA 35:13">ታ ዎሳይ ዛሮ ደሞና አትስ።<verse eid="PSA 35:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14"/>ታና ካዉሻዳ</para>
  <para style="q2" vid="PSA 35:14">ዳቦስ ዎይኮ እሻስ ዬከይሳዳ ዬካስ።</para>
  <para style="q1" vid="PSA 35:14">እስ አስ ባ አየስ ካዮተይሳዳ</para>
  <para style="q2" vid="PSA 35:14">ታ ሁጵያ ኦይካዳ ዬካስ።<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>ሽን ታኒ በትዳ ዎደ ኡፋይትድ ሺቅዶሶና፤</para>
  <para style="q2" vid="PSA 35:15">ጋሶይ ባይና ታና ዋድ፥</para>
  <para style="q2" vid="PSA 35:15">አጎና እፅዶሶና።<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>ኢታ አሳት ኦይሳዳ ኤንቲ ታና ቀልቅስዶሶና፤</para>
  <para style="q2" vid="PSA 35:16">ይሎትድ ባንታ አቻ ጋርጭዶሶና።<verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>ጎዳዉ፥ ኔኒ አዉደ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 35:17">ስእ ጋዳ ፄላይ?</para>
  <para style="q1" vid="PSA 35:17">ኤንታ ኢታ ኦሱዋፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 35:17">ታ አልኦ ሸምፑዋ ሀ ጋሞታፐ ዎስሳ ኤካ።<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>ሄ ዎደ ግታ ሺቆን ታ ነና ጋላታና፤</para>
  <para style="q2" vid="PSA 35:18">ዳሮ አሳይ ደእያ በሳን ነና ቦንቻና።<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>ጋሶይ ባይና ታና ሞርከይሳት ኡፋይቶፎ፤</para>
  <para style="q2" vid="PSA 35:19">ታና ጮ እፀይሳት ታ ቦላ ቃምኦቶፖ።<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>ኤንቲ ሳሮባ ሃሳዮኮና፤</para>
  <para style="q2" vid="PSA 35:20">ስእ ግድ ደእያ አሳ ቦላ ኦዳ ፃፆሶና።<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>ኤንቲ ባንታ ዶና ታ ቦላ ዶይድ፥</para>
  <para style="q2" vid="PSA 35:21">“ሀይሳ በአ፥ ነ ኦዳይሳ</para>
  <para style="q2" vid="PSA 35:21">ኑኒ ኑ አይፈን በእዳ” ያጎሶና።<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>ጎዳዉ፥ ኔኒ ሄሳ በአዳሳ፤</para>
  <para style="q2" vid="PSA 35:22">ስእ ጎፓ።</para>
  <para style="q2" vid="PSA 35:22">ጎዳዉ፥ ታፐ ሃኮፋ።<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>ታ ፆሳዉ፥ ታ ጎዳዉ ታ ግሾ፥</para>
  <para style="q2" vid="PSA 35:23">ደንዳ፤ ባርካ፤</para>
  <para style="q2" vid="PSA 35:23">ታ ዶና ግዳዳ ሞተታ።<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>ታ ጎዳዉ፥ ታ ፆሳዉ፥ ፅሎተን ታዉ ፕርዳ፤</para>
  <para style="q2" vid="PSA 35:24">ታ ሞርከታ ኡፋይሶፋ።<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>ኤንቲ ባንታ ዎዛናን፥ “ሀሹ፥ ኑ አሞይ ፖለትስ፤</para>
  <para style="q2" vid="PSA 35:25">ኑኒ እያ ምትዳ” ጋና መላ ኦፋ።<verse eid="PSA 35:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>ታ ዋያን ኡፋይተይሳት፥ ዬላቶ፥ ካዉዮ፤</para>
  <para style="q2" vid="PSA 35:26">ታ ቦላ ጬቀተይሳት ዬላነ ካዉሸ ማኦ።<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>ታ ፆኑዋ ዶሰይሳት ኡፋይቶ፤</para>
  <para style="q2" vid="PSA 35:27">እልሎ፤ ሀሹ ያጎ።</para>
  <para style="q1" vid="PSA 35:27">“ኡባ ዎደ ባ አይልያ ሳሮተን፥</para>
  <para style="q2" vid="PSA 35:27">ኡፋይትያ ጎዳይ ቁ ቁ ጎ” ያጎ።<verse eid="PSA 35:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>ታ እንፃርሳይ ነ ፅሎተነ ነ ጋላታ፥</para>
  <para style="q2" vid="PSA 35:28">ጋላሳ ኩመን ኦዴስ።<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="s1">አልኦ ግድዳ ፆሳ ሲቆ</para>
  <para style="d">ጎዳ አይለይ፥ ዳዊቲ ዛማረታ ሀላቃስ ፃፍዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 36:1"/>ኢታ አስ ባ ዎዛናን ኢታባ ቆፔስ፤</para>
  <para style="q2" vid="PSA 36:1">እ ባ ዎዛናን ፆሳስ ያየና።<verse eid="PSA 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>እ ባና ዳሮ ናሽያ ግሾ፤</para>
  <para style="q2" vid="PSA 36:2">ባ ናጋራ በአናዉ ዎይኮ እፃናዉ ዳንዳኤና።<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>እያ ዶናን ገነይነ ዎርዶይ ኩምስ፤</para>
  <para style="q2" vid="PSA 36:3">ጭንጫተነ ሎኦባ ኦሶ አግስ።<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>ባ ሂፃን ዝንእድ ገነ ቆፔስ፤</para>
  <para style="q2" vid="PSA 36:4">ባና ሎኦ ግዶና ኦገን ካለስ፤</para>
  <para style="q2" vid="PSA 36:4">ኢታባ እፀና።<verse eid="PSA 36:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>ጎዳዉ፥ ነ ሲቆይ ሳሎታ ጋኬስ፤</para>
  <para style="q2" vid="PSA 36:5">ነ ቱማተይ ሻራፐ አስ።<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>ነ ፅሎተይ ቃ ደረታፐ አስ፤</para>
  <para style="q2" vid="PSA 36:6">ነ ፕርዳይ አባ ጪሙዋፈ ዝቃ፤</para>
  <para style="q2" vid="PSA 36:6">ጎዳዉ፥ ኔኒ አሰነ ዶአ ናጋሳ።<verse eid="PSA 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>ፆሳዉ፥ ነ ሲቆይ አይ መላ አልኦ!</para>
  <para style="q2" vid="PSA 36:7">አሳይ ነ ቀፍያ ጋርሳን ቆሰትድ አቴስ።<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>ኤንቲ ነ ግብራፐ ምድ ካሎሶና፤</para>
  <para style="q2" vid="PSA 36:8">ነ ኬሀተ ሻፋፐ ኡይድ አሎሶና።<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>ደኦ ፑልቶይ ኔፐ ከዬስ፤</para>
  <para style="q2" vid="PSA 36:9">ነ ፖኡዋን ኑኒ ፖኦ በኦስ።<verse eid="PSA 36:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>ነና ኤረይሳታስ ነ ሲቆይ፥</para>
  <para style="q2" vid="PSA 36:10">ዎዛና ሱረታስ ነ ፅሎተይ ቃንፀተና።<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>ኦቶራንቾታ ቶሆይ ታና የፎ፤</para>
  <para style="q2" vid="PSA 36:11">ናጋራንቾታ ኩሸይ ታና የደፎ።<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>ኢታ አሳታ ኩንደ በእተ፤</para>
  <para style="q2" vid="PSA 36:12">ኤንቲ ኩንድዶሶና፤ ደንዳናዉ ዳንዳኦኮና።<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="s1">ፆሳይ ባ አሳ አገና</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 37:1"/>ኢታ ኦይሳታ ጋሶን ይሎቶፓ፤</para>
  <para style="q2" vid="PSA 37:1">ናጋራ ኦይሳታ ቃናቶፓ።<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>ኤንቲ ማታዳ ኤሶን መላና፤</para>
  <para style="q2" vid="PSA 37:2">ቦንጮዳ ሹልድ ቆቆፈታና።<verse eid="PSA 37:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>ጎዳን አማነታ፤ ሎኦባ ኦ፤</para>
  <para style="q2" vid="PSA 37:3">ቢታ ቦላ ኡታ፤ ፓላህን ደአ።<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>ጎዳን ኡፋይታ፤</para>
  <para style="q2" vid="PSA 37:4">እ ነ ዎዛና አሙዋ እማና።<verse eid="PSA 37:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>ነ ኦግያ ሀዳራ ጎዳስ እማ፤</para>
  <para style="q2" vid="PSA 37:5">እያን አማነታ፤ እ ነዉ ኦና።<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>እ ነ ፅሎተ ዎንታ ፃልቀዳ፥</para>
  <para style="q2" vid="PSA 37:6">ነ ፕርዳ ሴታ ጋላሳ አዋዳ ፖእሳና።<verse eid="PSA 37:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>ጎዳ ስንን ስእ ጋዳ ደአ፤</para>
  <para style="q2" vid="PSA 37:7">ዳንዳአን ናጋ፤</para>
  <para style="q2" vid="PSA 37:7">ኢታ አሳታ ሀልቾይ ፖለትን በአዳ ይሎቶፓ።<verse eid="PSA 37:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>ሀንቆ አጋ፤ ይሎ ተቃ፤</para>
  <para style="q2" vid="PSA 37:8">ሄስ መቶን የጌስ።<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>ኢታ ኦይሳት ቆለትድ ያና፤</para>
  <para style="q2" vid="PSA 37:9">ሽን ጎዳን ኡፋይስ ዎይሳት ቢታ ላታና።<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>ኢታ ኦይሳት ጉ ዎደፐ ጉየ ደኦኮና፤</para>
  <para style="q2" vid="PSA 37:10">ነ ኤንታ ኮያዳ ደማካ።<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>ሽን አዳት ቢታ ላታና፤</para>
  <para style="q2" vid="PSA 37:11">ሳሮተን ኡፋይትድ ዳና።<verse eid="PSA 37:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>ኢታ አስ ሎኦ አስ ይሳናዉ ማቀቴስ፤</para>
  <para style="q2" vid="PSA 37:12">ባ አቻ ኤንታ ቦላ ጋርጬስ።<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>ሽን ጎዳይ ኢታታ ቦላ ሚጬስ፤</para>
  <para style="q2" vid="PSA 37:13">ኤንታዉ ዮ ጋላስ የይሳ ኤሬስ።<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>ኢታ አሳት ማንቆታነ መቶታንቾታ ዎናዉ፥</para>
  <para style="q2" vid="PSA 37:14">ሱረ ሄመተይሳታ ሹካናዉ፥</para>
  <para style="q2" vid="PSA 37:14">ባንታ ማሻ ሾዶሶና፤</para>
  <para style="q2" vid="PSA 37:14">ባንታ ዶንግያ ዋፆሶና።<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>ሽን ኤንታ ማሻይ ኤንታ ዎዛናን ገላና፤</para>
  <para style="q2" vid="PSA 37:15">ኤንታ ዶንገይ መቃና።<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>ፅሎ አሳስ ደእያ ጉባይ፥</para>
  <para style="q2" vid="PSA 37:16">ኢታ አሳስ ደእያ ዳሮባፐ ሎኦ።<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>አይስ ጊኮ፥ ኢታታ ዎልቃይ መቃና፤</para>
  <para style="q2" vid="PSA 37:17">ሽን ጎዳይ ፅሎታ ዘምፕሴስ።<verse eid="PSA 37:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>ሱረ አሳታ ኦግያ ጎዳይ ኤሬስ፤</para>
  <para style="q2" vid="PSA 37:18">ኤንታ ላታይ መርናዉ ኤንታባ ግዳና።<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>ኢታ ዎደ ሱረ አሳት ዬላቶኮና፤</para>
  <para style="q2" vid="PSA 37:19">ኮሻ ዎደ ኤንቲ ካልድ ማና።<verse eid="PSA 37:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>ሽን ኢታ አሳት ሀይቃና፤</para>
  <para style="q2" vid="PSA 37:20">ጎዳ ሞርከት ጪሻዳ ቆቆፈታና፤</para>
  <para style="q2" vid="PSA 37:20">ጩያዳ አይፈፐ ጌማና።<verse eid="PSA 37:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>ኢታ አስ ታልእድ ዛረና፤</para>
  <para style="q2" vid="PSA 37:21">ሽን ፅሎ አስ ኬሀተን እሜስ።<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>ጎዳን አንጀትዳይሳት ቢታ ላታና፤</para>
  <para style="q2" vid="PSA 37:22">ሽን እ ባድዳይሳት ያና።<verse eid="PSA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>አሳ ኦገይ ጎዳ ኡፋይስኮ፥</para>
  <para style="q2" vid="PSA 37:23">ጎዳይ እያ ታንጉዋ ካለስ፤ ምንስ።<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>እ በትኮካ ኩንደና፤</para>
  <para style="q2" vid="PSA 37:24">ጎዳይ እያ ኩሽያ ኦይክድ ካትሴስ።<verse eid="PSA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>ታኒ ፓማስ፤ ሀእ ጭማስ፤</para>
  <para style="q2" vid="PSA 37:25">ሽን ፅሎ አስ የገትን፥</para>
  <para style="q2" vid="PSA 37:25">እያ ናይት ካ ዎስሽን በአብከ።<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>እ ኡባ ዎደ ኬሀተን እሜስ፤</para>
  <para style="q2" vid="PSA 37:26">ጮ ታልኤስ፤</para>
  <para style="q2" vid="PSA 37:26">እያ ናይት ሀራታስ አንጆ ግዳና።<verse eid="PSA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>ኢታፐ ሃካ፤ ሎኦ ኦ፤</para>
  <para style="q2" vid="PSA 37:27">ነ አዱሳ ላይ ዳና።<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>ጎዳይ ፅሎ ፕርዳ ዶሴስ፤</para>
  <para style="q2" vid="PSA 37:28">አማነተይሳታ እ የገና።</para>
  <para style="q1" vid="PSA 37:28">ኤንቲ መርናዉ ናገቶሶና፤</para>
  <para style="q2" vid="PSA 37:28">ሽን ኢታታ ኮቻይ ያና።<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>ፅሎት ቢታ ላታና፤</para>
  <para style="q2" vid="PSA 37:29">ያን መርናዉ ዳና።<verse eid="PSA 37:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>ፅሎ አሳ ዶናፐ ጭንጫተ ከዬስ፤</para>
  <para style="q2" vid="PSA 37:30">እያ እንፃርሳይ ፅሎ ኦደቴስ።<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>ፆሳ ህገይ እያ ዎዛናን ደኤስ፤</para>
  <para style="q2" vid="PSA 37:31">እያ ቶሆይ በተና።<verse eid="PSA 37:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>ኢታ አስ ፅሎ አስ ጌዴስ፤</para>
  <para style="q2" vid="PSA 37:32">እያ ዎናዉ ኮዬስ።<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>ሽን ጎዳይ እያ ኩሸን አድ እመና፤</para>
  <para style="q2" vid="PSA 37:33">ፕርደታናዉ ኤቅያ ዎደ እያ ቦላ ፕርድሰና።<verse eid="PSA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>ጎዳን ኡፋይስ ኦ፥ እያ ኪታ ናጋ፤</para>
  <para style="q2" vid="PSA 37:34">ነና ቢታ ላትስድ ግታያና፤</para>
  <para style="q2" vid="PSA 37:34">ኢታ አሳት ይሽን ነ በአና።<verse eid="PSA 37:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>ናጋራንቾይ ልባኖሰ ዝጋዳ፥</para>
  <para style="q2" vid="PSA 37:35">ድጭድ ቁ ቁ ግን ታ በአስ።<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>ሽን ታ ስማዳ ያን ደማብከ፤</para>
  <para style="q2" vid="PSA 37:36">ኮይንካ በንትቤና።<verse eid="PSA 37:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>ቦረይ ባይና አስ በአ፤</para>
  <para style="q2" vid="PSA 37:37">ሱረ አስ አኬካ፤</para>
  <para style="q2" vid="PSA 37:37">ሳሮ አሳስ ዉርሰይ ሎኦ ግዳና።<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>ሽን ናጋራንቾት ያና፤</para>
  <para style="q2" vid="PSA 37:38">ኤንታ ዉርሰይ ኦማና።<verse eid="PSA 37:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>ፅሎታ አቶተይ ጎዳፐ ዬስ፤</para>
  <para style="q2" vid="PSA 37:39">እ መቶ ዎደ ኤንቲ ናገትድ አትያ በሰ።<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>ጎዳይ ፅሎታ ማዴስ፤ አሼስ፤</para>
  <para style="q2" vid="PSA 37:40">ኤንቲ እያኮ ባቃትዳ ግሾ፥</para>
  <para style="q2" vid="PSA 37:40">እ ኤንታ ኢታታፐ አሼስ፤ ናጌስ።<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="s1">ፆሳዉ ታና አጎፋ</para>
  <para style="d">ዳዊቲ ፃፍዳ ቆፍሶ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 38:1"/>አቤት ጎዳዉ፥ ነ ሸንያን ታና ሴሮፓ፤</para>
  <para style="q2" vid="PSA 38:1">ነ ይሉዋን ታና ሀንቆፋ።<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>ነ ዶንገ ቶራይ ታና ጫድስ፤</para>
  <para style="q2" vid="PSA 38:2">ነ ኩሸይ ታና ዴፅስ።<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>ነ ሀንቅዳ ግሾ ታ አሳተይ ቆሄትስ፤</para>
  <para style="q2" vid="PSA 38:3">ታ ናጋራ ጋሶን ታ መቀይ ሊቅስ።<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>ታ ባላይ ታና ሙክስ፤</para>
  <para style="q2" vid="PSA 38:4">ደንዶና ግታ ቶሆዳ ታና ዴፄስ።<verse eid="PSA 38:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>ታ ኤያተን ኦዳ ናጋራ ግሾ፥</para>
  <para style="q2" vid="PSA 38:5">ታ ማዱንይ ፅንቅስ።<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>ታ ሳአ ፄላስ፤ ሆካስ፤</para>
  <para style="q2" vid="PSA 38:6">ጋላስ ኩመ አዛናሸ ፔአስ።<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>ታ አሾይ ፁጌስ፤</para>
  <para style="q2" vid="PSA 38:7">ታ አሳተይ ፓፃ ግደና።<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>ታ ዳቡራስ፤ ሊቃስ፤</para>
  <para style="q2" vid="PSA 38:8">ታ ዎዛናይ ድርግያ ግሾ ኦላስ።<verse eid="PSA 38:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>አቤት ጎዳዉ፥ ታ ዎዛና አሞ ኡባ ኤራሳ፤</para>
  <para style="q2" vid="PSA 38:9">ታ ኦለይ ኔፐ ጌምቤና።<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>ታ ዎዛናይ ድርጌስ፤</para>
  <para style="q2" vid="PSA 38:10">ታ ዎልቃይ ህት ግስ፤</para>
  <para style="q2" vid="PSA 38:10">ታ አይፍያ ፖኦይ ይስ።<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>ታ ማዱን ጋሶን</para>
  <para style="q2" vid="PSA 38:11">ታ ሾሮትነ ታ ላገት ሃክድ ኤቅዶሶና፤</para>
  <para style="q2" vid="PSA 38:11">ታ ዳቦት ታፐ ሃክዶሶና።<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>ታና ዎናዉ ኮየይሳት</para>
  <para style="q2" vid="PSA 38:12">ባንታ ፅህያ ታዉ የጎሶና።</para>
  <para style="q1" vid="PSA 38:12">ታና ቆሀናዉ ኮየይሳት፥</para>
  <para style="q2" vid="PSA 38:12">“ኑ ነና ደማና” ያግድ ማንዶሶና</para>
  <para style="q2" vid="PSA 38:12">ጋላስ ኩመ ታ ቦላ ቶቦሶና።<verse eid="PSA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>ታ ቱለ አሳ መላ ስእከ፤</para>
  <para style="q2" vid="PSA 38:13">ሙመ አሳ መላ ዶና ፖግከ።<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>ቱማ ሀይ ስኦና አስ፥</para>
  <para style="q2" vid="PSA 38:14">እንፃርስ ኦድድ ዛሮና አስ ግዳስ።<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>ጎዳዉ፥ ታ ነና ኡፋይሳን ናጋይስ፤</para>
  <para style="q2" vid="PSA 38:15">ታ ጎዳዉ፥ ፆሳዉ ነ ታዉ ዛሮ እማ።<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>ታኒ፥ “ታ ቶሆይ በትን፥</para>
  <para style="q2" vid="PSA 38:16">ኤንቲ ሀሹ ጋናዳነ</para>
  <para style="q2" vid="PSA 38:16">ታ ቦላ ጬቀታናዳ ኦፋ” ያጋስ።<verse eid="PSA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>ታ ኩንዳና ሀናይስ፥</para>
  <para style="q2" vid="PSA 38:17">ታ ሳኮይ ታና አጎና እፅስ።<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>ታ ናጋራ ፓፃይስ፤</para>
  <para style="q2" vid="PSA 38:18">ታ ናቁዋ ጋሶን አዛናይስ።<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>ታ ሞርከት ግታነ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 38:19">ታና ጮ እፀይሳት ዳሮ።<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>ታኒ ሎኦባ ኦን ኢታ ዛረይሳት፥</para>
  <para style="q2" vid="PSA 38:20">ታ ሎኦባ ካልያ ግሾ ታራ ኤቀቶሶና።<verse eid="PSA 38:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>ጎዳዉ፥ ታና የጎፋ፤</para>
  <para style="q2" vid="PSA 38:21">ታ ፆሳዉ፥ ታፐ ሃኮፋ።<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>ታና አሽያ ታ ጎዳዉ፥</para>
  <para style="q2" vid="PSA 38:22">ታና ማዳናዉ ኤለሳ።<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="s1">ግታ ፆሲ-ላፋ አስ</para>
  <para style="d">ዳዊቲ ዛማረታ ሀላቃ፥ ኤዶታመስ ፃፍዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 39:1"/>ታኒ፥ “ታ እንፃርሳን ናጋራ ኦና መላ፥</para>
  <para style="q2" vid="PSA 39:1">ታ ኦግያ ናጋና።</para>
  <para style="q1" vid="PSA 39:1">ኢታ አሳት ታ ደእያ ዎደ፥</para>
  <para style="q2" vid="PSA 39:1">ታ ዶና ባራና” ያጋስ።<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>ሽን ዶና ሙመዳ ስእ ጋስ፤</para>
  <para style="q2" vid="PSA 39:2">ሀር አቶሽን ሎኦባ ኦደተይሳ አጋስ፤</para>
  <para style="q2" vid="PSA 39:2">ሽን ታ ዋየይ ሃ ዳርስ።<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>ታ ዎዛናይ ታ ጋን ቴልስ፤</para>
  <para style="q2" vid="PSA 39:3">ታ ቆፋይ ታማዳ ኤፅስ፤</para>
  <para style="q2" vid="PSA 39:3">ያትን ታ እንፃርሳን ሃሳያ ዶማስ።<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>ጎዳዉ፥ ታ ደኡዋ ዉርሰነ</para>
  <para style="q2" vid="PSA 39:4">ታ ዳናዉ አትዳ ጋላሳ ታና በሳ፤</para>
  <para style="q2" vid="PSA 39:4">ታ ደኦይ አይ መላ ቃንኮ ታና ኤርሳ።<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>ኔኒ ታ ላይ ታካዳ ዎዳሳ፤</para>
  <para style="q2" vid="PSA 39:5">ታ ላይይ ነ ስንን ባይናባ መላ፤</para>
  <para style="q2" vid="PSA 39:5">ቱማ አስ ኡባይ እስ ሸምፖ መላ። <char style="qs">ሳላሀ </char><verse eid="PSA 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>ቱማ አስ አያ ኤሾ መላ፤</para>
  <para style="q2" vid="PSA 39:6">እ ጮ ዳቡሬስ፤ ሻሎ ሺሼስ፤</para>
  <para style="q2" vid="PSA 39:6">ሽን ኦን ጎኤታነኮ ኤረና።<verse eid="PSA 39:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>ጎዳዉ፥ ሀእ ታ ናገይ ኦኔ?</para>
  <para style="q2" vid="PSA 39:7">ታኒ ነናን ኡፋይስ ኦይስ።<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>ታ ባላ ኡባፈ ታና አሻ፤</para>
  <para style="q2" vid="PSA 39:8">ኤያታን ታና ቶሽሶፓ።<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>ሄሳ ኡባ ኦዳይ ነና ግድያ ግሾ</para>
  <para style="q2" vid="PSA 39:9">ታኒ ሙማስ፤ ዶናካ ፖጋብከ።<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>ነ ፃምአ ታ ቦላፈ ደን፤</para>
  <para style="q2" vid="PSA 39:10">ምኖ ነ ኩሽያ ጋሶን ታ ዳቡራስ።<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>አሰ እያ ናጋራ ግሾ ሴራሳ፤</para>
  <para style="q2" vid="PSA 39:11">እያ አልኦ ደኡዋ ብላዳ ዉርሳሳ፤</para>
  <para style="q2" vid="PSA 39:11">ቱማ አስ ኡባይ እስ ሸምፖ መላ። <char style="qs">ሳላሀ </char><verse eid="PSA 39:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>ጎዳዉ፥ ታ ዎሳ ስአ፤</para>
  <para style="q2" vid="PSA 39:12">ታና ማዳናዉ ታ ዋሱዋ ሀይዛ።</para>
  <para style="q1" vid="PSA 39:12">ታ አፉ በአዳ ስእ ጎፓ፤</para>
  <para style="q2" vid="PSA 39:12">ታኒ ታ አዋታዳ በተ አስነ እማ</para>
  <para style="q2" vid="PSA 39:12">ግዳዳ ኔራ ደአይስ።<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>ታ ሻከታናፐነ ባናፐ ስን</para>
  <para style="q2" vid="PSA 39:13">ታኒ ኡፋይታና መላ ታና አጋ።<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="s1">ማደ ደማናዉ ዎስያ ዎሳ</para>
  <para style="d">ዛማረታ ሀላቃስ ዳዊቲ ፃፍዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 40:1"/>ታኒ ጎዳ ዳንዳአን ናጋስ፤</para>
  <para style="q2" vid="PSA 40:1">እ ታኮ ስሚድ ታ ዋሱዋ ስእስ።<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>ዮ ኦላፈ፥ ስልሞ ኡርቃፈ ታና ከስስ፤</para>
  <para style="q2" vid="PSA 40:2">ታ ቶሁዋ ዛላ ቦላ ኤስስ፤</para>
  <para style="q2" vid="PSA 40:2">ታ ሄመ ምንስ።<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>ታ ዶናን ኦራ የ ዎስ፤</para>
  <para style="q2" vid="PSA 40:3">ሄስካ ኑ ፆሳይ ጋላተቶ ያገይሳ፤</para>
  <para style="q2" vid="PSA 40:3">ዳሮት በእድ ያያና፤ ጎዳን አማነታና።<verse eid="PSA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>ጎዳን አማነትያ፥</para>
  <para style="q2" vid="PSA 40:4">ኦቶራንቾታ ፄሎናይ፥</para>
  <para style="q2" vid="PSA 40:4">ዎርዶታራ ሄመቶናይ፥</para>
  <para style="q2" vid="PSA 40:4">አንጀትዳ አስ።<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>ጎዳዉ፥ ታ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 40:5">ኔኒ ዳሮ ማላልስያባ ኦዳሳ፤</para>
  <para style="q2" vid="PSA 40:5">ኔራ ልከተይ ኦንካ ባዋ!</para>
  <para style="q1" vid="PSA 40:5">ኔኒ ኑስ ቆፕዳ ሎኦ ቆፋ፥</para>
  <para style="q2" vid="PSA 40:5">ኦንካ ታይባናዉ ዳንዳኦና፤</para>
  <para style="q2" vid="PSA 40:5">ሄስ ታኒ ኦድን ዉርያባ ግደና።<verse eid="PSA 40:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>ኔኒ ያርሾነ እሞ ኮያባካ፤</para>
  <para style="q2" vid="PSA 40:6">ሽን ነና ስአና መላ ታ ሀይ ዶያዳሳ፤</para>
  <para style="q2" vid="PSA 40:6">ፁሳ ያርሾነ ናጋራ ያርሾ ኮያባካ።<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>ሄሳ ግሾ ታኒ፥ “ፃ ማፃፋን</para>
  <para style="q2" vid="PSA 40:7">ታባይ ፃፈትዳይሳዳ ታኒ ያስ።<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>ታ ፆሳዉ፥ ታኒ ነ ሸንያ ኦናዉ ዶሳይስ፤</para>
  <para style="q2" vid="PSA 40:8">ነ ህገይ ታ ዎዛናን ደኤስ” ያጋስ።<verse eid="PSA 40:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>ግታ ሺቆን፥ ነ ፅሎተ ኦዳና፤</para>
  <para style="q2" vid="PSA 40:9">ጎዳዉ ኔኒ ኤረይሳዳ፥</para>
  <para style="q2" vid="PSA 40:9">ታኒ ማርካተይሳ አግከ።<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>ታ ነ ፅሎተ ታ ዎዛናን ቆሳብከ፤</para>
  <para style="q2" vid="PSA 40:10">ነ አማነተነ ነ አሹዋ ኦዳስ።</para>
  <para style="q1" vid="PSA 40:10">ነ ሲቁዋነ ነ ቱማተ፥</para>
  <para style="q2" vid="PSA 40:10">ግታ ሺቁዋን ገንብከ።<verse eid="PSA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>ጎዳዉ፥ ነ ማሮተ ታፐ ሃሶፋ፤</para>
  <para style="q2" vid="PSA 40:11">ነ ሲቆይነ ነ ቱማተይ፥</para>
  <para style="q2" vid="PSA 40:11">ታና ኡባ ዎደ ናጎ።<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>ታይቦይ ባይና ኢታባይ ታና ተቅስ፤</para>
  <para style="q2" vid="PSA 40:12">ታ ባላይ ታና ጎዝስ፤</para>
  <para style="q2" vid="PSA 40:12">ታ ፄላናዉ ዳንዳእከ</para>
  <para style="q1" vid="PSA 40:12">ታ ናጋራይ ታ ሁጰ ብናናፐ ዳርስ፤</para>
  <para style="q2" vid="PSA 40:12">ታ ዎዛናይ ታ ግዶን ትልእስ።<verse eid="PSA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>ጎዳዉ፥ ታና አሻናዉ ኤሮ ጋ፤</para>
  <para style="q2" vid="PSA 40:13">ታ ጎዳዉ፥ ታና ማዳናዉ ኤለሳ።<verse eid="PSA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>ታና ዎናዉ ኮየይሳት ዬላቶ፥ ካዉዮ፤</para>
  <para style="q2" vid="PSA 40:14">ታ ቆሄተ አሞተይሳት ካዉይድ ጉየ ስሞ።<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>ታኮ፥ “እያዉ ሀሹ፥ ሀሹ”</para>
  <para style="q2" vid="PSA 40:15">ገይሳት ፆነትድ ዬላቶ።<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>ሽን ነና ኮይያ ኡባይ፥</para>
  <para style="q2" vid="PSA 40:16">ነናን ኡፋይቶ፤ ሀሹ ጎ።</para>
  <para style="q1" vid="PSA 40:16">ነ አቶተ ዶስያ ኡባይ፥</para>
  <para style="q2" vid="PSA 40:16">“ጎዳይ ግታ” ያጎ።<verse eid="PSA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>ታኒ ማንቆነ መቶታንቾ፤</para>
  <para style="q2" vid="PSA 40:17">ሽን ጎዳይ ታባ ቆፖ!</para>
  <para style="q1" vid="PSA 40:17">ታና ማደይ አሸይ ነና፤</para>
  <para style="q2" vid="PSA 40:17">ታ ፆሳዉ፥ ጋምኦፋ።<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="s1">ሀርገትያነ ብዛ አሳ ዎሳ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 41:1"/>ማንቁዋስ ቆፕያ አስ አንጀትዳይሳ፤</para>
  <para style="q2" vid="PSA 41:1">መቶ ጋላስ ጎዳይ እያ አሼስ።<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>ጎዳይ እያ ናጌስ፥ ደኦን ዎስ፤</para>
  <para style="q2" vid="PSA 41:2">ቢታ ቦላ ጎዳይ እያ አንጄስ፤</para>
  <para style="q2" vid="PSA 41:2">ጎዳይ እያ፥ እያ ሞርከታ አሙዋስ አድ እመና።<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>እ ሳከትድ ሂን ደእሽን ጎዳይ ማዴስ፤</para>
  <para style="q2" vid="PSA 41:3">ሀርግያፈ እያ ፓስ።<verse eid="PSA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>ታኒ፥ “ጎዳዉ፥ ታ ነና ናቅዳ ግሾ፥</para>
  <para style="q2" vid="PSA 41:4">ታና ማራ፤</para>
  <para style="q2" vid="PSA 41:4">ታ ሀርግያፈ ታና ፓ” ያጋስ።<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>ታ ሞርከት ኢታባ ታ ቦላ ሃሳይድ፥</para>
  <para style="q2" vid="PSA 41:5">“እ አዉደ ሀይቃንዴ?</para>
  <para style="q2" vid="PSA 41:5">እያ ሱንይ አዉደ ዶገታንዴ?” ያጎሶና።<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>ታና በአናዉ ያ ኦንካ ዎርዶ ኦዴስ፤</para>
  <para style="q2" vid="PSA 41:6">ባ ዎዛናን ታና ዝግርያባ ሺሼስ፤</para>
  <para style="q2" vid="PSA 41:6">ካረ ከይድ ታ ሱን ኢሴስ።<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>ታና እፅያ ኡባይ እስፈ ታና ዝግሮሶና፤</para>
  <para style="q2" vid="PSA 41:7">ኢታባይ እያ ጋኬስ ግድ ቆፖሶና።<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>“እያ ኢታ ሀርገይ ኦይክስ፤</para>
  <para style="q2" vid="PSA 41:8">እ ህዛ ሂፃፐ ደንደና” ያጎሶና።<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>ሀር አቶሽን ታ አማነትያ ላገይ፥</para>
  <para style="q2" vid="PSA 41:9">ታራ ምዳይስ ታዉ ዞኮ ዛርስ።<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>ሽን ጎዳዉ ታና ማራ፤</para>
  <para style="q2" vid="PSA 41:10">ታ ኤንታዉ ኩሸ ዛራና መላ፥</para>
  <para style="q2" vid="PSA 41:10">ሀርገ ሂፃፐ ታና ደን።<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>ታ ሞርከይ ታና ፆኖና ግሾ፥</para>
  <para style="q2" vid="PSA 41:11">ነ ታናን ኡፋይታናይሳ ታ ኤራይስ።<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>ነ ታና ታ ሱረተ ግሾ ካትሳሳ፤</para>
  <para style="q2" vid="PSA 41:12">ነ ስንን ታና መርናዉ ዎሳ።<verse eid="PSA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>ጎዳይ፥ እስራኤለ ፆሳይ፥</para>
  <para style="q2" vid="PSA 41:13">መርናፐ መርና ጋካናዉ ጋላተቶ።</para>
  <para style="b" vid="PSA 41:13"/>
  <para style="qc" vid="PSA 41:13">አምንእ! አምንእ!<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">ናምአን ማፃፋ</para>
  <para style="mr">(<ref loc="PSA 42-72">ማዝ 42—72</ref>)</para>
  <para style="s1">ጎደትያ አሳ ዎሳ</para>
  <para style="d">ቆረ ናይታ ትምርተ</para>
  <para style="d">አኬካን ፃፍዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 42:1"/>ጋር ፑልቶ ሃ ላሞተይሳዳ፥</para>
  <para style="q2" vid="PSA 42:1">ፆሳዉ፥ ታ ሸምፕያ ነና ላሞታዉሱ።<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>“ታ ሸምፕያ ፆሳ፥</para>
  <para style="q2" vid="PSA 42:2">ደኦ ፆሳ በአናዉ ሳሞታዉሱ፤</para>
  <para style="q2" vid="PSA 42:2">አዉደ ጋካዳ እያ ሶምኡዋ በኦ” ያጋዉሱ።<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>አሳይ፥ “ነ ፆሳይ አዉን ደኢ?”</para>
  <para style="q2" vid="PSA 42:3">ግያ ዎደ፥</para>
  <para style="q2" vid="PSA 42:3">ጋላስነ ቃም ታዉ አፉ ካ ግድስ።<verse eid="PSA 42:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>ታኒ ኤንታ ባኣለ ቦንቻናዉ ሺቅዳ፥ ዳሮ አሳ ካለዳ፥</para>
  <para style="q2" vid="PSA 42:4">ጋላታ የንነ እልልሳን ፆሳ ኬ በይሳ ቆፕያ ዎደ፥</para>
  <para style="q2" vid="PSA 42:4">ታ ዎዛናይ አዛኖን መቄስ።<verse eid="PSA 42:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>ታ ሸምፐ፥ አይስ አዛናይ?</para>
  <para style="q2" vid="PSA 42:5">አይስ ኡንኤታይ?</para>
  <para style="q1" vid="PSA 42:5">ነ ፆሳን ኡፋይስ ዎ፤</para>
  <para style="q2" vid="PSA 42:5">ታና አሽያ፥ ታ ፆሳ ታኒ ቡሮ ጋላታና።<verse eid="PSA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>ታ ዎዛናይ አዛንስ፤</para>
  <para style="q2" vid="PSA 42:6">ሄሳ ግሾ ታኒ ዮርዳኖሰ ቢታን፥</para>
  <para style="q1" vid="PSA 42:6">አርሞና ቃን፥ ምዛረ ዙማን፥</para>
  <para style="q2" vid="PSA 42:6">ኤቃዳ ነና ቆፓና።<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>ነ ሶሱዋ ጉንን ጪሞይ ጪሙዋ ፄጌስ፤</para>
  <para style="q2" vid="PSA 42:7">ነ ቤታይነ ነ ዙለይ ታ ቦላራ አስ።<verse eid="PSA 42:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>ጎዳይ ባ ሲቁዋ ጋላስ ታዉ ኪቴስ፤</para>
  <para style="q2" vid="PSA 42:8">ቃማ ጋላታ የይ ታራ ደኤስ፤</para>
  <para style="q2" vid="PSA 42:8">ታ ደኦ ፆሳ ዎሳና።<verse eid="PSA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>ፆሳ፥ ታ ዛላኮ፥</para>
  <para style="q2" vid="PSA 42:9">“ታና አይስ ዶጋዲ?</para>
  <para style="q1" vid="PSA 42:9">ታ ሞርከት ታና ኡንኤን፥</para>
  <para style="q2" vid="PSA 42:9">ዬካሸ አይስ ሄመቶ” ያጋና።<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>ታ ሞርከት፥ “ነ ፆሳይ አዉን ደኢ?”</para>
  <para style="q2" vid="PSA 42:10">ያግድ ጫይያ ዎደ ታ መቀይ መቄስ።<verse eid="PSA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>ታ ሸምፐ አይስ አዛናይ?</para>
  <para style="q2" vid="PSA 42:11">አይስ ኡንኤታይ?</para>
  <para style="q1" vid="PSA 42:11">ፆሳን ኡፋይስ ዎ፤</para>
  <para style="q2" vid="PSA 42:11">ታና አሽያ፥ ታ ፆሳ ታ ቡሮ ጋላታና።<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="s1">ነ ፖኡዋነ ቱማተ ቆንጭሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 43:1"/>ፆሳዉ ታዉ ፕርዳ፤</para>
  <para style="q2" vid="PSA 43:1">ነና ኤሮና ደረታራ ታ ግሾ ሞተታ፤</para>
  <para style="q2" vid="PSA 43:1">ጭምያ ኢታ አሳታፐ ታና አሻ።<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>ፆሳዉ፥ ኔኒ ታኒ ቆሰታዳ አትያ ሚፃ፤</para>
  <para style="q2" vid="PSA 43:2">ነ ታና አይስ አጋዲ?</para>
  <para style="q1" vid="PSA 43:2">ታ ሞርከይ ታና ኡንኤን፥</para>
  <para style="q2" vid="PSA 43:2">አይስ ዬካሸ ቦ?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>ነ ፖኡዋነ ነ ቱማ ታዉ ኪታ፤</para>
  <para style="q2" vid="PSA 43:3">ኤንቲ ታና ካለድ ነ ጌሻ ደርያ፥</para>
  <para style="q2" vid="PSA 43:3">ነ ደእያ በሳ ታና ጋ።<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>ሄ ዎደ ታኒ ፆሳ ያርሾ በሳኮ፤</para>
  <para style="q2" vid="PSA 43:4">ታና ኡፋይስያ ፆሳኮ ባና።</para>
  <para style="q1" vid="PSA 43:4">ፆሳዉ ታ ጎዳዉ፥</para>
  <para style="q2" vid="PSA 43:4">ታኒ ዲን ነና ሳባና።<verse eid="PSA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>ታ ሸምፐ አይስ አዛናይ?</para>
  <para style="q2" vid="PSA 43:5">አይስ ኡንኤታይ?</para>
  <para style="q1" vid="PSA 43:5">ፆሳን ኡፋይስ ዎ፤</para>
  <para style="q2" vid="PSA 43:5">ታና አሽያ፥ ታ ፆሳ ታ ቡሮ ጋላታና።<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="s1">ኑና ማዳናዉ ኤለሳ</para>
  <para style="d">ቆረ ናይት ዛማረ ሀላቃስ ፃፍዳ ማዝሙረ</para>
  <para style="d">አኬካን ፃፍዳ ግንፆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>ፆሳዉ፥ በን ዎደ ነ ኦዳባ ኑ ስእዳ፤</para>
  <para style="q2" vid="PSA 44:1">ኑ አዋታ ዎደ ነ ኦዳባ ኑስ ኦድዶሶና።<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>ካዎተታ ነ ኩሸን ጎዳ ከሳዳሳ፤</para>
  <para style="q2" vid="PSA 44:2">ኑ አዋታ ኤንታ ቢታን ቶካዳሳ።</para>
  <para style="q1" vid="PSA 44:2">ሀራ ካዎተታ ሴራዳሳ፤</para>
  <para style="q2" vid="PSA 44:2">ሽን ኑ አዋታ አክሳዳሳ።<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>ኤንቲ ባንታ ማሻን ኦልድ ሄ ቢታ ላትቦኮና፤</para>
  <para style="q2" vid="PSA 44:3">ኤንቲ ባንታ ምኖተን ፆንቦኮና።</para>
  <para style="q1" vid="PSA 44:3">ሽን ኔኒ ኤንታ ዶስዳ ግሾ፥</para>
  <para style="q2" vid="PSA 44:3">ኤንታ ነ ኡሻቻ ኩሸይ፥ ነ ቀሰይነ</para>
  <para style="q2" vid="PSA 44:3">ነ ሶምኡዋ ፖኦይ ፆንስስ።<verse eid="PSA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>ያይቆባ ኮቻስ ፆኖ ኪትያ፥</para>
  <para style="q2" vid="PSA 44:4">ታ ካዎይነ ታ ፆሳይ ነና።<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>ነናን ግድድ ኑ ሞርከታ ፆናና፤</para>
  <para style="q2" vid="PSA 44:5">ነ ሱንን ኑና እፀይሳታ የና።<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>ታኒ ታ ቶራን አማነትከ፤</para>
  <para style="q2" vid="PSA 44:6">ታ ማሻይ ታና አሸና።<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>ሽን ነ ኑና ኑ ሞርከታፐ አሻሳ፤</para>
  <para style="q2" vid="PSA 44:7">ኑና እፀይሳታ ኔኒ ካዉሻሳ።<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>ኑኒ ኡባ ዎደ ፆሳን ጬቀታና፤</para>
  <para style="q2" vid="PSA 44:8">ነ ሱን መርናዉ ጋላታና። <char style="qs">ሳላሀ። </char><verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>ሽን ሀእ ኑና አጋዳሳ፤ ካዉሻዳሳ፤</para>
  <para style="q2" vid="PSA 44:9">ኑ ኦላንቾታራ እስፈ ኦላስ ከያካ።<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>ኑ ሞርከታ ስንፈ ኑና ባቃትሳዳሳ፤</para>
  <para style="q2" vid="PSA 44:10">ኑ እፀይሳት ኑና ቦንቅዶሶና።<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>ኑና ዶርሳዳ ሹሀስ አ እማዳሳ፤</para>
  <para style="q2" vid="PSA 44:11">ካዎተታ ግዶን ኑና ላላዳሳ።<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>ኔኒ ነ አሳ ላፋ ጋተን ባይዛዳሳ፤</para>
  <para style="q2" vid="PSA 44:12">አይ ዎካ ደማባካ።<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>ኑ ሾሮት ኑና ቦራናዳ ኦዳሳ፤</para>
  <para style="q2" vid="PSA 44:13">ኑ ሄራን ደኤይሳት ኑና ቅልቅሳናዳነ</para>
  <para style="q2" vid="PSA 44:13">ኑ ቦላ ሚጫናዳ ኦዳሳ።<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>ኑና ካዎተታ ግዶን ሀይሰስ አጋዳሳ፤</para>
  <para style="q2" vid="PSA 44:14">ኤንቲ ባንታ ሁጵያ ኑ ቦላ</para>
  <para style="q2" vid="PSA 44:14">ቃና መላ ኦዳሳ።<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>ጋላስ ኩመ ታኒ ቶሸታስ፤</para>
  <para style="q2" vid="PSA 44:15">ታ ሶምኡዋ ዬል ካምስ።<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>ሄስ ሀንዳይ ታና ጫየይሳታነ ቦረይሳታ ጋሶንነ፥</para>
  <para style="q2" vid="PSA 44:16">ታ ሞርከታነ ታና ማንደይሳታ ጋሶና።<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>ኑኒ ነና ዶጎና ደእሽን፥</para>
  <para style="q2" vid="PSA 44:17">ነ ጫቁዋ መንና ደእሽን፥</para>
  <para style="q2" vid="PSA 44:17">ሀ ኡባይ ኑና ጋክስ።<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>ኑ ዎዛናይ ነና አግቤና፤</para>
  <para style="q2" vid="PSA 44:18">ኑ ቶሆይ ነ ኦግያፐ ካረ ከይቤና።<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>ሽን ኔኒ ኑና መንረዳ</para>
  <para style="q2" vid="PSA 44:19">ዶአ ኦላን የጋዳሳ፤</para>
  <para style="q2" vid="PSA 44:19">ሳካና ማን ካማዳሳ።<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>ኑ፥ ፆሳ ሱን ዶግዳባ ግድያኮ፥</para>
  <para style="q2" vid="PSA 44:20">ሀራ ፆሳታኮ ኑ ኩሽያ ምጭዳባ ግድያኮ፥<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>ዎዛና ፁራ ፆሳይ ኤርያ ግሾ፥</para>
  <para style="q2" vid="PSA 44:21">እ ሀይሳ ፄልድ ደመኔ?<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>ግዶሽን፥ ነ ግሾ ኡባ ጋላስ ሀይቆስ፤</para>
  <para style="q2" vid="PSA 44:22">ሹካናዉ ኤፍያ ዶርሳዳ ታይበትዳ።<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>ጎዳዉ፥ ደንዳ፥ አይስ ስካይ?</para>
  <para style="q2" vid="PSA 44:23">ደንዳ፥ መርናዉ ኑና አጎፋ።<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>ነ ሶምኡዋ ኑፐ አይስ ገንይ?</para>
  <para style="q2" vid="PSA 44:24">ኑ ቆሁዋነ ኑ ኡንኣ አይስ ዶጋይ?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>ኑኒ ባናን የገትዳ፤</para>
  <para style="q2" vid="PSA 44:25">ኑ አሳተይ ቢታራ ኦይከትስ።<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>ጎዳዉ፥ ደንዳ፥ ኑና ማዳ፤</para>
  <para style="q2" vid="PSA 44:26">ነ ሲቁዋ ግሾ ጋዳ ኑና ዎዛ።<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="s1">ፆሳ አራታይ መርናሳ</para>
  <para style="d">ቆረ ናይት “ጪሸ” ጌተትያ ጩን ዛማረታ ሀላቃስ ፃፍዳ ማዝሙረ</para>
  <para style="d">አኬካን ፃፍዳ ሲቆ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 45:1"/>ታኒ ታ የ ካዋስ ስሳና፤</para>
  <para style="q2" vid="PSA 45:1">ታ ዎዛናይ ሎኦ ቆፋ ፑልቴስ፤</para>
  <para style="q2" vid="PSA 45:1">ታ እንፃርሳይ ሎኦ ፃፍያ አሳ ብእረ መላ።<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>አሳ ኡባፈ ኔኒ ማላ ሎኦ፤</para>
  <para style="q2" vid="PSA 45:2">ነ መተርሻይ አ ኬሀተ ቃላን ኩምስ፤</para>
  <para style="q2" vid="PSA 45:2">ፆሳይ ነና መርናዉ አንጅስ።<verse eid="PSA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>ዎልቃማ ካዋዉ፥ ነ ማሻ ዳንጫ፤</para>
  <para style="q2" vid="PSA 45:3">ቦንቾነ ቴማ ማአ።<verse eid="PSA 45:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>ነ ቱማተ፥ ነ አዳተነ ነ ፅሎተ ግሾ፥</para>
  <para style="q2" vid="PSA 45:4">ነ ቴማ ማአዳ ፆናናዉ ደንዳ፤</para>
  <para style="q2" vid="PSA 45:4">ነ ኡሻቻ ኩሸይ ማላልስያባ በሶ።<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>ነ ቶራት ቃራ፤</para>
  <para style="q2" vid="PSA 45:5">ኤንቲ ካዋ ሞርከታ ዎዛና ጫዶ፤</para>
  <para style="q2" vid="PSA 45:5">ካዎተት ነ ቶሁዋ ጋርሳን ኩንዶ።<verse eid="PSA 45:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>ፆሳዉ፥ ነ አራታይ መርናዉ ደኤስ፤</para>
  <para style="q2" vid="PSA 45:6">ነ ካዎተ ፃምአይ ፅሎተ ፃምኣ።<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>ኔኒ ፅሎተ ዶሳዳ ጌላተ እፃሳ፤</para>
  <para style="q2" vid="PSA 45:7">ሄሳ ግሾ፥ ፆሳይ፥ ነ ፆሳይ፥</para>
  <para style="q2" vid="PSA 45:7">ነ ላገታፐ አድ፥</para>
  <para style="q2" vid="PSA 45:7">ነና ኡፋይሳ ዛይተን ትይስ።<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>ጎዳረ ኡን፥ ካርበንነ</para>
  <para style="q2" vid="PSA 45:8">ቡርጉደን ዋላከትዳ ሽቶን፥ ነ ማኦይ ፑከትስ።</para>
  <para style="q1" vid="PSA 45:8">ዳንጋርሳ ዛለን አሌቀትዳ፥</para>
  <para style="q2" vid="PSA 45:8">ነ ካዎ ጋን ዲፀትያ ዲይ ነና ኡፋይሴስ።<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>ካዎ ኬን ደእያ ማጫሳታ ግዶን፤</para>
  <para style="q2" vid="PSA 45:9">ካዎታ ማጫ ናይት ደኦሶና።</para>
  <para style="q1" vid="PSA 45:9">ካውያ ኦፍራ ዎርቃን አሌቀታዳ፥</para>
  <para style="q2" vid="PSA 45:9">ኔፐ ኡሻቻ ባጋን ኤቃሱ።<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>ታ ናተ፥ ስአ፤ ዎዛናን ዎ፤</para>
  <para style="q2" vid="PSA 45:10">ነ ሀይ ሃ ዛራ፤</para>
  <para style="q2" vid="PSA 45:10">ነ ደርያነ ነ አዋ ኬ ዶጋ።<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>ካዎይ ነ ማላን ኡፋይትስ፤</para>
  <para style="q2" vid="PSA 45:11">ነ ጎዳ ግድያ ግሾ እያ ቦንቻ።<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>ፅሮሳ አሳይ ነዉ ዎይቶ ኤክድ ያና፤</para>
  <para style="q2" vid="PSA 45:12">ዱረት ነና አዳሻና።<verse eid="PSA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>ካዋ ናእያ፥</para>
  <para style="q2" vid="PSA 45:13">ካዎ ኬን ዋና ሎአይ!</para>
  <para style="q2" vid="PSA 45:13">እ ያጋኖ ማኦይ ዎርቃን አሌቀትስ።<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>ባ አሌቆ ማኡዋ ማአዳ፥</para>
  <para style="q2" vid="PSA 45:14">ካዋኮ ሞይዘታሱ።</para>
  <para style="q1" vid="PSA 45:14">እ ጌላኦ ላገት እዮ ካልድ፥</para>
  <para style="q2" vid="PSA 45:14">እያ ስን ኤክድ ይዶሶና።<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>ኤንቲ ኡፋይትሸ ይድ፥</para>
  <para style="q2" vid="PSA 45:15">ካዎ ጋ ገሎሶና።<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>ካዋዉ፥ ነ አዋታ በሳ ነ ናይት ላታና፤</para>
  <para style="q2" vid="PSA 45:16">ቢታ ኡባን ነ ኤንታ ሹማና።<verse eid="PSA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>ታ ነ ሱን የለታ ኡባን፥</para>
  <para style="q2" vid="PSA 45:17">ሀሳየታናዳ ኦና።</para>
  <para style="q2" vid="PSA 45:17">ሄሳ ግሾ፥ አሳይ መርናዉ ነና ጋላታና።<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="s1">ፆሳይ ኑራ ደኤስ</para>
  <para style="d">ቆረ ናይት ዛማረታ ሀላቃስ ፃፍዳ ማዝሙረ</para>
  <para style="d">“ጌላኦ ናይታ የ” ጌተትያ ጩን የፀትዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 46:1"/>ፆሳይ ኑ ቆሰትድ አትያ፥</para>
  <para style="q2" vid="PSA 46:1">በሰነ ኑ ዎልቃ።</para>
  <para style="q1" vid="PSA 46:1">ኑና መቶይ ጋክያ ዎደ፥</para>
  <para style="q2" vid="PSA 46:1">እ ኑና ማዳናዉ ኡባ ዎደ ኑ ማታን ደኤስ።<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>ሄሳ ግሾ፥ ቢታይ ቃፅያኮካ፥</para>
  <para style="q2" vid="PSA 46:2">ደረት አባን ኩንድያኮካ፥</para>
  <para style="q2" vid="PSA 46:2">ኑኒ ያዮኮ።<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>አባይ ጉምድ ጎፖንትኮካ፥</para>
  <para style="q2" vid="PSA 46:3">እያ ዎልቃማ ዙልያን ደረት ኮኮርያኮካ፥</para>
  <para style="q2" vid="PSA 46:3">ኑኒ ዳጋሞኮ። <char style="qs">ሳላሀ። </char><verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>ኡባፈ ቃ ፆሳይ ደእያ፥ ፆሳ ካታማ፥</para>
  <para style="q2" vid="PSA 46:4">ጌሻ በሳ፥ ኡፋይስያ እስ ሻፍ ደኤስ።<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>ፆሳይ እያ ግዶን ደእያ ግሾ፥</para>
  <para style="q2" vid="PSA 46:5">ሄ ካታማይ ቃፀና፤</para>
  <para style="q2" vid="PSA 46:5">ዎንታ ጉራ ፆሳይ እያ ማዳና።<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>ደረይ ዳጋምስ፤ ካዎተት ቃፆሶና፤</para>
  <para style="q2" vid="PSA 46:6">ፆሳይ ባ ቃላ ስስስ፤ ቢታይ ትልእስ።<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>ኡባፈ ዎልቃማ ጎዳይ ኑራ ደኤስ፤</para>
  <para style="q2" vid="PSA 46:7">ያይቆባ ፆሳይ ኑ ቆሰትድ አትያ በሰ። <char style="qs">ሳላሀ </char><verse eid="PSA 46:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>ሃ ዪተ፤ ጎዳ ኦሱዋ ፄልተ፤</para>
  <para style="q2" vid="PSA 46:8">ቢታ ዋትድ ይስዳኮ በእተ።<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>እ ቢታ ቦላ ደእያ ኦላ ኡባ ተቄስ፤</para>
  <para style="q2" vid="PSA 46:9">ዶንገነ ቶራ መንስ፤</para>
  <para style="q2" vid="PSA 46:9">ጎንዳልያ<note caller="+" style="f"><char style="fr" closed="false">46:9 </char><char style="fq" closed="false">ጎንዳልያ፦ </char><char style="ft" closed="false">እብራወ ዶናን ሀረ ጋረ ጌተቴስ።</char></note> ታማን ፁጌስ።<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>ዎፑ ጊተ፤ ታኒ ፆሰ ግደይሳ ኤርተ፤</para>
  <para style="q2" vid="PSA 46:10">ታኒ ካዎተታ ግዶን ቁ ቁ ጋና፤</para>
  <para style="q2" vid="PSA 46:10">ቢታ ቦላካ ቁ ቁ ጋና።<verse eid="PSA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>ኡባፈ ዎልቃማ ጎዳይ ኑራ ደኤስ፤</para>
  <para style="q2" vid="PSA 46:11">ያይቆባ ፆሳይ ኑ ቆሰትድ አትያ በሰ። <char style="qs">ሳላሀ። </char><verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="s1">ፆሳይ ሳአ ኡባ ጎዳ</para>
  <para style="d">ቆረ ናይታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 47:1"/>ደረ ኡባይ ህንተ ኩሽያ ባቅተ፤</para>
  <para style="q2" vid="PSA 47:1">ቃላ ቁ ኦድ ፆሳ ጋላትተ።<verse eid="PSA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>ኡባፈ ቃ ጎዳይ ዋን ያሺ?</para>
  <para style="q2" vid="PSA 47:2">ቢታ ኡባን እ ግታ ካዎ።<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>ደረታ ኑፐ ጋርሳራ፥</para>
  <para style="q2" vid="PSA 47:3">ካዎተታ ኑ ቶሁዋፐ ጋርሳን ሃርሴስ።<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>እ ኑስ ላታ ቢታ ዶርስ፤</para>
  <para style="q2" vid="PSA 47:4">እ ዶስያ ያይቆብ</para>
  <para style="q2" vid="PSA 47:4">ሄ ቢታን ጬቀቴስ። <char style="qs">ሳላሀ። </char><verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>ፆሳይ ኡፋይሳንነ እልልሳን ፑደ ደንድስ፥</para>
  <para style="q2" vid="PSA 47:5">ጎዳይ ሞይዘ ፑኖን ባ አራታን ከይስ።<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>ፆሳስ ዛማርት፤ ኤ፥ እያዉ ዛማርተ፤</para>
  <para style="q2" vid="PSA 47:6">እያዉ ካዋስ ዛማርተ፤ ኤ፥ እያዉ ዛማርተ።<verse eid="PSA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>ፆሳይ ቢታ ኡባ ካዎ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 47:7">ጋላታን ሳቢተ።<verse eid="PSA 47:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>ፆሳይ ባ ጌሻ አራታን ኡትስ፥</para>
  <para style="q2" vid="PSA 47:8">ፆሳይ ካዎተታ ሃሬስ።<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>ካዎተታ ሀላቃት፥</para>
  <para style="q2" vid="PSA 47:9">አብራሃመ ፆሳ አሳራ ሺቆሶና።</para>
  <para style="q1" vid="PSA 47:9">ቢታን ደእያ ዎልቃማ ኡባይ ፆሳባ</para>
  <para style="q2" vid="PSA 47:9">ግድያ ግሾ እ ኡባፈ ቁ ቁ ግስ።<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="s1">ፅዮነይ ኑ ፆሳ ዙማ</para>
  <para style="d">ቆረ ናይታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 48:1"/>ጎዳይ ግታ፤ ኑ ፆሳ ካታማን</para>
  <para style="q2" vid="PSA 48:1">እያ ጌሻ ዙማ ቦላ ግታ ጋላት እያዉ በሴስ።<verse eid="PSA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>ቢታ ኡባ ኡፋይስ ግድዳ፥</para>
  <para style="q2" vid="PSA 48:2">ፑደሀ ባጋራ ደእያ ፅዮነ ደረይ፥</para>
  <para style="q2" vid="PSA 48:2">ቃነ ሎኦ፤</para>
  <para style="q2" vid="PSA 48:2">እ ግታ ካዋ ካታማ።<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>ፆሳይ ሄ ግምብያ ግዶና፤</para>
  <para style="q2" vid="PSA 48:3">እካ እያዉ ገሸ ግደይሳ ኤርስስ።<verse eid="PSA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>ካዎት ባንታ ቶራንቾታራ ሺቅዶሶና፤</para>
  <para style="q2" vid="PSA 48:4">ፅዮነ ኦላናዉ ይዶሶና።<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>እያ በእድ ዳጋምዶሶና፤</para>
  <para style="q2" vid="PSA 48:5">ጉየ ስሚድ ባቃትዶሶና።<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>ኤንቲ ያን ደእሸ ያሻን ኮኮርዶሶና፤</para>
  <para style="q2" vid="PSA 48:6">እቀ ኦይክዳ ማጫሳዳ እንፃፅዶሶና።<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>ዶሎሀ ባጋ ዎልቃማ ጫርኮን</para>
  <para style="q2" vid="PSA 48:7">መቅያ ታርሰሳ ማርካበታ መላ ግድዶሶና።<verse eid="PSA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>ኑ ስእዳይሳዳ፥</para>
  <para style="q2" vid="PSA 48:8">ኡባፈ ዎልቃማ ጎዳ ካታማን፥</para>
  <para style="q2" vid="PSA 48:8">ኑ ፆሳ ካታማን እ ኦዳባ በእዳ፤</para>
  <para style="q2" vid="PSA 48:8">ፆሳይ ሄ ካታማ መርናዉ ምንድ ናጌስ። <char style="qs">ሳላሀ </char><verse eid="PSA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>አቤት ፆሳዉ፥ ነ ኬን</para>
  <para style="q2" vid="PSA 48:9">መርና ነ ሲቁዋ ቆፖስ።<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>አቤት ፆሳዉ፥ ነ ሱንዳ</para>
  <para style="q2" vid="PSA 48:10">ነ ጋላታይ ሳኣ ጋፃ ጋክስ፤</para>
  <para style="q2" vid="PSA 48:10">ነ ኡሻቻ ኩሸይ ፅሎተን ኩምዳይሳ።<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>ነ ፕርዳ ጋሶን ፅዮነ አሳይ ኡፋይቶ፤</para>
  <para style="q2" vid="PSA 48:11">ይሁዳ ኩመይ ኡፋይሳን እልሎ።<verse eid="PSA 48:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>ፅዮነ ዩሹዋን ሄመትተ፤</para>
  <para style="q2" vid="PSA 48:12">እ ድርሳ ዩይተ እ ሻኮታ ታይብተ።<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>ያ የለታስ ኦዳና መላ</para>
  <para style="q2" vid="PSA 48:13">እያ ግምብያ አኬክተ፤ ሚፃታ ዎችተ።<verse eid="PSA 48:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>ህንተ፥ “መርናዉ ፆሳይ ኑ ፆሳ፤</para>
  <para style="q2" vid="PSA 48:14">እ ኑና ሀይቃና ጋካናዉ ካለና” ያግድ ኦድተ።<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="s1">መቶ ዎደይ ያሸና</para>
  <para style="d">ቆረ ናይት ዛማረታ ሀላቃስ ፃፍዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 49:1"/>አሳ ኡባይ ሀይሳ ስእተ፤</para>
  <para style="q2" vid="PSA 49:1">ቢታ ቦላ ደኤይሳቶ፥</para>
  <para style="q2" vid="PSA 49:1">ኡባይ ሀይሳ ሀይዝተ።<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>ቃይ ዝቃይ፥</para>
  <para style="q2" vid="PSA 49:2">ዱረይ ማንቆይ ስእተ።<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>ታ ዎዛና ቆፋይ አኬካ እሜስ፤</para>
  <para style="q2" vid="PSA 49:3">ታ ዶናይ ጭንጫተ ቃላ ኦደቴስ።<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>ታ ሀይ ሌምሶኮ ዛራና፤</para>
  <para style="q2" vid="PSA 49:4">ዲ ዲፃሸ፥ ታ ቃንእሽያ ብርሻና።<verse eid="PSA 49:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>መቶ ጋላሳይ ያ ዎደነ ጭምያ ሞርከት፤</para>
  <para style="q2" vid="PSA 49:5">ታና ተቅያ ዎደ ታ አይስ ባባይና?<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>ባንታ ሻሉዋን አማነተይሳታነ</para>
  <para style="q2" vid="PSA 49:6">ባንታ ዱረተን ጬቀትያ</para>
  <para style="q2" vid="PSA 49:6">ታ ሞርከታ አይስ ባባይና?<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>አይ አስካ ባና ዎዛናዉ፥</para>
  <para style="q2" vid="PSA 49:7">ዎይኮ ባ ሸምፑዋ ጋትያ</para>
  <para style="q2" vid="PSA 49:7">ፆሳስ ቃንፃናዉ ዳንዳኤና።<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>አሳ ሸምፖ ጋተይ ዳሮ አልኦ፤</para>
  <para style="q2" vid="PSA 49:8">አይ ጋተ ቃንፅንካ ግደና።<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>እ ሀይቆናዳነ ዱፎ ገሎናዳ፥</para>
  <para style="q2" vid="PSA 49:9">ዎይኮ እ ሀይቆናዳ ኦናዉ ጋከና።<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>ኤያትነ ፓና አሳት ሀይቀይሳዳ፥</para>
  <para style="q2" vid="PSA 49:10">ጭንጫት ባንታ ሻሉዋ</para>
  <para style="q2" vid="PSA 49:10">ሀራታስ የግድ በይሳ አሳ ኡባይ በኤስ።<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>ኤንቲ ባንታ ቢታ ባንታባ ጊኮካ፥</para>
  <para style="q2" vid="PSA 49:11">ዱፎይ መርናዉ ኤንታዉ ኬ ግዳና።<verse eid="PSA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>አስ አይ ግታትኮካ ባ ግታተራ ካንና፤</para>
  <para style="q2" vid="PSA 49:12">እ ዶአዳ ሀይቄስ።<verse eid="PSA 49:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>ባንታርካ ባንታ ሁጰን አማነተይሳታ ቃዳይነ</para>
  <para style="q2" vid="PSA 49:13">ኤንቲ ግዳባ ቱማ ግያ ኤያታ ዉርሰይ ሀይሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>ሹካስ ጊገትዳ ዶርሳታዳ፥</para>
  <para style="q2" vid="PSA 49:14">ሀይቆይ ኤንታ ዱፎ ካለስ።</para>
  <para style="q1" vid="PSA 49:14">ሱረት ኤንታ ዱፉዋ ቦላራ ሄመታና፤</para>
  <para style="q2" vid="PSA 49:14">ኤንታ አሳተይ ዱፎን ዎቃና፤</para>
  <para style="q2" vid="PSA 49:14">ኬፈ ከይድ ሃክድ ስኦለን አታና።<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>ሽን ፆሳይ ታ ሸምፑዋ ዎዛና፤</para>
  <para style="q2" vid="PSA 49:15">እ ታና ሀይቆ ዎልቃፈ አሻና። <char style="qs">ሳላሀ </char><verse eid="PSA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>አስ ዱረትያ ዎደነ</para>
  <para style="q2" vid="PSA 49:16">እያ ቦንቾይ ዳርያ ዎደ ያዮፋ።<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>እ ሀይቅያ ዎደ አይኮካ ኤክድ ቤና፤</para>
  <para style="q2" vid="PSA 49:17">እያ ሻሎይ እያራ እስፈ ዱፎ ገለና።<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>አስ ፓፃ ደእያ ዎደ ታዉ ኩምስ ጊኮ፥</para>
  <para style="q2" vid="PSA 49:18">ኡባባይ እያዉ እንጀትዳ ግሾ ጋላተትኮካ፥<verse eid="PSA 49:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="PSA 49:19"/>ስሚድ ፖኦ በኦና፥</para>
  <para style="q2" vid="PSA 49:19">ባ ማይዛታን ጋሄቴስ።<verse eid="PSA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>ኤራተ ባይና ዱረትዳ አስ</para>
  <para style="q2" vid="PSA 49:20">ዶአዳ ጮ ያና።<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="s1">ፆሳይ ቱማ ዳይና</para>
  <para style="d">አሳፋ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 50:1"/>ዎልቃማ ጎዳይ፥ ፆሳይ ኦዴስ፤</para>
  <para style="q2" vid="PSA 50:1">ዶሎሀፐ ዉሎሀ ጋካናዉ ቢታ ኡባ ፄጌስ።<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>መን ፖሎ የገልስ ግድዳ</para>
  <para style="q2" vid="PSA 50:2">ፅዮነፐ ፆሳይ ፖኤስ።<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>ኑ ፆሳይ ያና፤ ስእ ጌና፤</para>
  <para style="q2" vid="PSA 50:3">ኤፅያ ታማይ እያ ስንና፤</para>
  <para style="q2" vid="PSA 50:3">ዎልቃማ ጎተይ እያ ዩሹዋና።<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>ፆሳይ ባ አሳ ፕርድያ ዎደ፥</para>
  <para style="q2" vid="PSA 50:4">ሳሎታነ ሳኣ ፄጌስ።<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>“ያርሾን ታራ ጫቅዳ፥</para>
  <para style="q2" vid="PSA 50:5">ታ ጌሻታ ታኮ ሺሽተ” ያግስ።<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>ፆሳይ ፕርድያ ግሾ፥</para>
  <para style="q2" vid="PSA 50:6">ሳሎት እያ ፅሎተ አዋጆሶና። <char style="qs">ሳላሀ </char><verse eid="PSA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“ታ አሳዉ፥ ስእተ፤ ታ ህንተዉ ኦዳይስ፤</para>
  <para style="q2" vid="PSA 50:7">እስራኤለ አሳዉ፥ ታ ነ ቦላ ማርካታና፤</para>
  <para style="q2" vid="PSA 50:7">ታኒ ፆሳይ፥ ነ ፆሳ።<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>ነ ያርሹዋ ግሾነ</para>
  <para style="q2" vid="PSA 50:8">ነ ፁሳ ያርሹዋ ግሾ፥</para>
  <para style="q2" vid="PSA 50:8">ነና ቦርከ።<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>ነ ዳራፐ ኮርማታ፥</para>
  <para style="q2" vid="PSA 50:9">ነ ግርብያፈ ኮለ ኤካናዉ ኮይከ።<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>ዎራን ደእያ ዶአት ኡባይ ታባ፤</para>
  <para style="q2" vid="PSA 50:10">ሙኩሉ ዙማ ቦላ ደእያ መሄትካ ታሳ።<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>ታኒ ቃ ደርያን ደእያ ካፎታ ኡባ ኤራይስ፤</para>
  <para style="q2" vid="PSA 50:11">ደንባን ደእያ መተት ታይሳታ።<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>ታና ኮሻይኮካ ነና ኦይችከ፤</para>
  <para style="q2" vid="PSA 50:12">ሳእነ ሳአን ኩምዳባ ኡባይ ታባ።<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>ታኒ ኮርማታ አሹዋ ማይናዬ?</para>
  <para style="q2" vid="PSA 50:13">ዎይኮ ዴሻታ ሱ ኡያናዬ?<verse eid="PSA 50:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>ፆሳስ ጋላታ ያርሾ እማ፤</para>
  <para style="q2" vid="PSA 50:14">ኡባፈ ቃ ፆሳስ ነ ቃንገ ጋ።<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>መቶ ጋላስ ታና ፄጋ፤</para>
  <para style="q2" vid="PSA 50:15">ታ ነና አሻና፤ ነካ ታና ቦንቻና” ያጌስ።<verse eid="PSA 50:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16"/>ሽን ፆሳይ ኢታ አሳ ሀይሳዳ ያጌስ፤</para>
  <para style="q2" vid="PSA 50:16">“ታ ህግያ ነ ናባባናዉ ነዉ አይ ማት ደኢ?</para>
  <para style="q2" vid="PSA 50:16">ዎይኮ ታ ጫቁዋ ነ ዶናን ቆንጭሳናዉ ነዉ አይ ማት ደኢ?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>ኔኒ ታ ትምርትያ እፃዳሳ፤</para>
  <para style="q2" vid="PSA 50:17">ታ ቃላ ጉየ የጋዳሳ።<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>ካይሱዋ በእዳ ዎደ ኔኒ እያራ ዳቦታዳሳ፤</para>
  <para style="q2" vid="PSA 50:18">ላይማተይሳታ ማባራን ገላዳሳ።<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>ነ ዶና ኢታባ ኦደታናዉ ብላ የዳዳሳ፤</para>
  <para style="q2" vid="PSA 50:19">ነ እንፃርሳይ ዎርዶ ሃሳያ ሜዘትስ።<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>ኡታዳ ነ እሻ ዝግራዳሳ፤</para>
  <para style="q2" vid="PSA 50:20">ነ አየ ናኣ ቦላ ኢታባ ኦደታዳሳ።<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>ነ ሀይሳ ኡባ ኦያ ዎደ፥</para>
  <para style="q2" vid="PSA 50:21">ታኒ ስእ ግዳ ግሾ</para>
  <para style="q2" vid="PSA 50:21">ታና ነ መላ ጋዳ ቆፓዳሳ።</para>
  <para style="q2" vid="PSA 50:21">ሽን ሀእ ታ ነና ሀንቃና፤</para>
  <para style="q2" vid="PSA 50:21">ነ ናጋራ ነ ስንን ታይባና።<verse eid="PSA 50:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>ህንተኖ፥ ፆሳ ዶገይሳቶ፥ ሀይሳ አኬክተ፤</para>
  <para style="q2" vid="PSA 50:22">ሄስ ሀኖና እፅኮ ታ ህንተና መንረና፤</para>
  <para style="q2" vid="PSA 50:22">ሄ ዎደ ህንተና አሻናይ ባዋ።<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>ታዉ ጋላታ ያርሸይ ታና ቦንቼስ፤</para>
  <para style="q2" vid="PSA 50:23">ባ ኦግያ ሱርስዳ አሳስ</para>
  <para style="q2" vid="PSA 50:23">ታኒ ፆሳ አቶተ በሳና” ያጌስ።<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="s1">ታዉ ጌሻ ዎዛና እማ</para>
  <para style="d">ዳዊቲ ዛማረታ ሀላቃስ ፃፍዳ ማዝሙረ</para>
  <para style="d">ዳዊቲ በርሳበራ ላይማትዳ ዎደ ናብያ ናታን እያዉ ኦድ ስምን ዳዊቲ የፅዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 51:1"/>አቤት ፆሳዉ፥ ነ መርና ሲቁዋዳ ታና ማራ፤</para>
  <para style="q2" vid="PSA 51:1">ነ ቃታ ዳሩዋ መላ ታ ናጋራ ቁቻ።<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>ታ ኢታተፈ ታና ሜጫ፤</para>
  <para style="q2" vid="PSA 51:2">ታ ናጋራፐ ታና ጌሻ።<verse eid="PSA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>ታኒ ታ ቆሁዋ ኤራይስ፤</para>
  <para style="q2" vid="PSA 51:3">ታ ናጋራይ ኡባ ዎደ ታ ስንና።<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>ታኒ ነና፥ ነ ፃላላ ቆሀስ፤</para>
  <para style="q2" vid="PSA 51:4">ነ ስንን ኢታባ ኦስ።</para>
  <para style="q1" vid="PSA 51:4">ሄሳ ግሾ፥ ነ ሀንቁዋን ነ ልከ፤</para>
  <para style="q2" vid="PSA 51:4">ነ ፕርዳንካ ነ ፅሎ።<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>ሄኮ ታ የለትያ ዎደ ናጋራንቾ፤</para>
  <para style="q2" vid="PSA 51:5">ታ አየ ኡሎን ቡሮ አትያ፥</para>
  <para style="q2" vid="PSA 51:5">ዎደፐ ዶማዳ ታኒ ናጋራንቾ።<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>ኔኒ አሳ ዎዛናፐ ቱማተ ኮያሳ፤</para>
  <para style="q2" vid="PSA 51:6">ታ ጋ አሳተ ጭንጫተ ታማርሳ።<verse eid="PSA 51:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>ህሶጰ ቦንጮን ታና ዉርፃ፤ ታ ጌያና፤</para>
  <para style="q2" vid="PSA 51:7">ታና ሜጫ፤ ታ ሻቻፈ አዳ ቦፃና።<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>ነ ታና ኡፋይስነ ሎኦባ ስሳ፤</para>
  <para style="q2" vid="PSA 51:8">ነ መንረዳ ታ መቀ ዛራዳ ኡፋይሳ።<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>ነ ሶምኡዋ ታ ናጋራፐ ሀራ ሶ ዛራ፤</para>
  <para style="q2" vid="PSA 51:9">ታ ባላ ኡባ ቁቻ።<verse eid="PSA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>አቤት ፆሳዉ፥ ጌሻ ዎዛና ታናን መ፤</para>
  <para style="q2" vid="PSA 51:10">ቃፆና አያና ታ ግዶን ኦራ።<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>ታና ነ ስንፈ የጎፋ፤</para>
  <para style="q2" vid="PSA 51:11">ነ ጌሻ አያና ታፐ ኤኮፋ።<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>ነ አቶተ ኡፋይሳ ታዉ ዛራ፤</para>
  <para style="q2" vid="PSA 51:12">ታ ነዉ ኪተታና መላ ታና ዘምፕሳ።<verse eid="PSA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>ታ ሄ ዎደ ህገ መንይሳታ ነ ኦግያ ታማርሳና፤</para>
  <para style="q2" vid="PSA 51:13">ናጋራንቾትካ ኔኮ ስማና።<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>አቤት ፆሳዉ፥ ታና አሽያ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 51:14">ሱ ጉስያ ናጋራፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 51:14">ሄ ዎደ ታ እንፃርሳይ ነ ፅሎተ የፃና።<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>አቤት ጎዳዉ፥ ታ ዶና ዶያ፤</para>
  <para style="q2" vid="PSA 51:15">ታ እንፃርሳይ ነ ጋላታ አዋጃና።<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>ነ ያርሾን ኡፋይትያኮ፥ ታ ነዉ ያርሻናሽን፥</para>
  <para style="q2" vid="PSA 51:16">ነ ፁሳ ያርሾን ኡፋይታካ።<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>ፆሳ ያርሾይ አዳ አያና፤</para>
  <para style="q2" vid="PSA 51:17">ፆሳዉ፥ ነ መቅዳነ</para>
  <para style="q2" vid="PSA 51:17">ካዉይዳ ዎዛና ካካ።<verse eid="PSA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>አቤት ፆሳዉ፥ ዶሳን ፅዮነስ ኬሀ፤</para>
  <para style="q2" vid="PSA 51:18">የሩሳላመ ግምበታ ግምባ።<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>ሄ ዎደ ነ ፅሎተ ያርሾንነ</para>
  <para style="q2" vid="PSA 51:19">ፁሳ ያርሾን ኡፋይታና።</para>
  <para style="q1" vid="PSA 51:19">ፖሎ ሽቂያ መሄ ያርሾን ኡፋይታና፤</para>
  <para style="q2" vid="PSA 51:19">ኮርማት ነ ያርሾ በሳን ያርሸታና።<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="s1">ፆሳ ሲቆይ መርናሳ</para>
  <para style="d">ዳዊቲ ዛማረታ ሀላቃስ አኬካን ፃፍዳ ግንፆ</para>
  <para style="d">ኤዶመ ቢታ አስ ግድዳ ዶይቅ ሳኦላኮ ብድ፥ “ዳዊቲ አብመለከ ሶ ብስ” ያግድ ኦድ ስምን፥ ዳዊቲ ፃፍዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 52:1"/>ነኖ፥ ዎልቃማ ኡራዉ፥ ኢታተን አይስ ኦቶርታይ?</para>
  <para style="q2" vid="PSA 52:1">ነኖ ፆሳን ካትዳይሶ ኡባ ዎደ አይስ ጬቀታይ?<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>ነኖ፥ ዎርዶ ኦደተይሶ፥</para>
  <para style="q2" vid="PSA 52:2">ነ ሀራታ ይሳናዉ ማቀታሳ፤</para>
  <para style="q2" vid="PSA 52:2">ነ እንፃርሳይ ቃራ ማቅላ መላ።<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>ነ ሎኦ አጋዳ ኢታ ዶሳሳ፤</para>
  <para style="q2" vid="PSA 52:3">ቱማ አጋዳ ዎርዶ ኦደታሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>ነኖ፥ ዎርዳንቹዋዉ፥</para>
  <para style="q2" vid="PSA 52:4">ነ ቦሻ ቃላ ኡባ ዶሳሳ።<verse eid="PSA 52:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>ፆሳይ ነና መርናዉ መንና፤</para>
  <para style="q2" vid="PSA 52:5">ፆሳይ ነና መንረናነ ነ ኬፈ ዳፍድ ከሳና፤</para>
  <para style="q2" vid="PSA 52:5">ነና ደኦን ደኤይሳታ ግዶፈ ሾድድ የጋና። <char style="qs">ሳላሀ </char><verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>ፅሎት ሄሳ በእድ ያያና፤</para>
  <para style="q2" vid="PSA 52:6">ኤንቲ ሀይሳዳ ያግድ፥ ነ ቦላ ሚጫና፤<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“ፆሳ ባዉ ገሸ ኦቦና፥</para>
  <para style="q2" vid="PSA 52:7">ባ ዱረተን አማነትዳ፥</para>
  <para style="q2" vid="PSA 52:7">ኢታ ኦሶን ምንዳ፥</para>
  <para style="q2" vid="PSA 52:7">አድያ ሀይሳ በእተ” ያጋና።<verse eid="PSA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>ሽን ታኒ ፆሳ ኬን አጭያ ሻማሆ መላ፤</para>
  <para style="q2" vid="PSA 52:8">እያ ሲቁዋን ታኒ መርናዉ አማነታይስ።<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>ነ ኦዳ ግሾ መርናዉ ታ ነና ጋላታና፤</para>
  <para style="q2" vid="PSA 52:9">ኔኒ ሎኦ ግድያ ግሾ ነ ሱንን ኡፋይስ ኦና፤</para>
  <para style="q2" vid="PSA 52:9">ጌሻታ ስንን ታ ነና ሳባና።<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="s1">ሎኦ ኦያ አስ ባዋ</para>
  <para style="d">ዳዊቲ ዛማረታ ሀላቃስ ፃፍዳ ትምርተ</para>
  <para style="d">አኬካን ፃፈትዳ ግንፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 53:1"/>ኤያት ባንታ ዎዛናን፥ “ፆሲ ባዋ” ያጎሶና፤</para>
  <para style="q2" vid="PSA 53:1">ኤንታ ደኦይ ኢትስ፤ ኤንቲ ቱናባ ኦሶና፤</para>
  <para style="q2" vid="PSA 53:1">ሎኦባ ኦያ አስ እሶይካ ባዋ።<verse eid="PSA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>ፆሳ ኮይያ ጭንጫ አስ ደእያኮ በአናዉ፥</para>
  <para style="q2" vid="PSA 53:2">ጎዳይ ሳሎፐ አሳ ፄሌስ።<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>ኤንቲ ኡባይ ፆሳፈ ሃክዶሶና፤</para>
  <para style="q2" vid="PSA 53:3">ኡባይ እስፈ ቱንዶሶና።</para>
  <para style="q1" vid="PSA 53:3">ሎኦ ኦያ አስ ዴና፤</para>
  <para style="q2" vid="PSA 53:3">ሀር አቶሽን እስ አስካ ባዋ።<verse eid="PSA 53:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>አስ ካ መይሳዳ ታ አሳ መይሳት፥</para>
  <para style="q2" vid="PSA 53:4">ሀ ኢታ ኦያ አሳት ኤሮኮና?</para>
  <para style="q2" vid="PSA 53:4">ኤንቲ ፆሳ ፄጎኮና?<verse eid="PSA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>ኤንቲ ዳጋም ኤሮና ዳጋማ ዳጋማና፤</para>
  <para style="q2" vid="PSA 53:5">ፆሳይ ባ አሳ ሞርከታ መቀ ላላና፤</para>
  <para style="q2" vid="PSA 53:5">ፆሳይ ኤንታ ካዳ ግሾ ኤንቲ ዬላታና።<verse eid="PSA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>እስራኤለ አቶተይ ፅዮነፐ ዬረነ!</para>
  <para style="q2" vid="PSA 53:6">ፆሳይ ባ አሳ ድኡዋ ዛርያ ዎደ፥</para>
  <para style="q1" vid="PSA 53:6">ያይቆባ ዛረት ኡፋይቶ፤</para>
  <para style="q2" vid="PSA 53:6">እስራኤለ አሳይ ኡፋይሳን ሀሹ ጎ።<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="s1">ፆሳይ ታ ሸምፑዋ ናጌስ</para>
  <para style="d">ዳዊቲ ዛማረታ ሀላቃስ ዲን የፅዳ አኬካ ግንፆ</para>
  <para style="d">ዚፋ አሳት ሳኦላኮ ብድ፥ “ዳዊቲ ኑ ቢታን ቆሰትስ” ያግድ ኦድን፥ ዳዊቲ ፃፍዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 54:1"/>አቤት ፆሳዉ፥ ነ ሱንን ታና አሻ፤</para>
  <para style="q2" vid="PSA 54:1">ነ ዎልቃን ታዉ ፕርዳ።<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>አቤት ፆሳዉ፥ ታ ዎሳ ስአ፤</para>
  <para style="q2" vid="PSA 54:2">ታ ዶና ቃላ ሀይዛ።<verse eid="PSA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>አላጋ አሳት ታ ቦላ ደንድዶሶና፤</para>
  <para style="q2" vid="PSA 54:3">ዳጋንያ አሳት ታና ዎናዉ ኮዮሶና፤</para>
  <para style="q2" vid="PSA 54:3">ኤንቲ ፆሳ ቆፖኮና። <char style="qs">ሳላሀ </char><verse eid="PSA 54:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>ፆሳይ ታዉ ማደ፤</para>
  <para style="q2" vid="PSA 54:4">ጎዳይ ታዉ ዘምፖ።<verse eid="PSA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>አቤት ፆሳዉ፥ ታ ሞርከታ ኢታተ ኤንታ ቦላ ዛራ፤</para>
  <para style="q2" vid="PSA 54:5">ነ ቱማተ ግሾ ኤንታ ይሳ።<verse eid="PSA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>አቤት ጎዳዉ፥ ታኒ ታ ዶሳን ነዉ ያርሻና፤</para>
  <para style="q2" vid="PSA 54:6">ነ ኬሀ ግድያ ግሾ ነ ሱን ጋላታና።<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>ነ ታና፥ ታ መቶ ኡባፈ አሻዳሳ፤</para>
  <para style="q2" vid="PSA 54:7">ታ ሞርከታ ፆነተ ታ አይፈን በአስ።<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="s1">ነ ቶሁዋ ፆሳ ቦላ የጋ</para>
  <para style="d">ዳዊቲ ዛማረታ ሀላቃስ ዲን የፅዳ አኬካ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 55:1"/>አቤት ፆሳዉ፥ ታ ዎሳ ስአ፤</para>
  <para style="q2" vid="PSA 55:1">ታ ማጋኑዋ ቀል ጎፓ።<verse eid="PSA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2"/>ታና ስአ፤ ታ ዎሳስ ዛሮ እማ፤</para>
  <para style="q2" vid="PSA 55:2">ታ ቆፋይ ታና ዋይስን፥ ታ ኡንኤታስ።<verse eid="PSA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3"/>ታ ሞርከታ ግርሳ ስአዳ ዳጋማስ፤</para>
  <para style="q2" vid="PSA 55:3">ኢታታ ማንድያ ጋሶን ኮኮራስ።</para>
  <para style="q1" vid="PSA 55:3">ኤንቲ ታ ቦላ መቶ ኤሆሶና፤</para>
  <para style="q2" vid="PSA 55:3">ይሎን ደንድድ ታና ሞርኮሶና።<verse eid="PSA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>ታ ዎዛናይ ድርጌስ፤</para>
  <para style="q2" vid="PSA 55:4">ሀይቆ ህርጋይ ታና ዎስ።<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>ታና ያሽነ ኮኮርስ ኦይክስ፤</para>
  <para style="q2" vid="PSA 55:5">ኢታ ዳጋም ታ ቦላ ዎስ።<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>ሆለዳ ታዉ ቀፈይ ደእያኮ፥</para>
  <para style="q2" vid="PSA 55:6">ፓላዳ ሸምፖይ ደእያ በሲ ጋካናሽን።<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>ታኒ ሃካዳ ባናሽን፤</para>
  <para style="q2" vid="PSA 55:7">ባዞን አቃናሽን። <char style="qs">ሳላሀ </char><verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>ታኒ ጎተፐነ ጫርኮፈ ባቃታዳ፥</para>
  <para style="q2" vid="PSA 55:8">ታ ቆሰትያ በሲ ደማናሽን።<verse eid="PSA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>አቤት ጎዳዉ፥ ካታማ ግዶን</para>
  <para style="q2" vid="PSA 55:9">ኦሽነ ገነ በእዳ ግሾ</para>
  <para style="q2" vid="PSA 55:9">ኢታታ ኦዳ ላላ።<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>ኢታት ጋላስነ ቃማ</para>
  <para style="q2" vid="PSA 55:10">ካታማ ግምበ ድርሳ ዩዮሶና፤</para>
  <para style="q2" vid="PSA 55:10">ዋየይነ መቶይ ካታማ ግዶን ደኤስ።<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>ዮይ እያ ግዶን ደኤስ፤</para>
  <para style="q2" vid="PSA 55:11">ናቆይነ ጭሞይ እያ ዳባባፐ ሻከተና።<verse eid="PSA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>ታና ጫየይ ታ ሞርክያ ግደና፤</para>
  <para style="q2" vid="PSA 55:12">እያ ግድያኮ ታ ዳንዳአናሽን።</para>
  <para style="q1" vid="PSA 55:12">ታ ቦላ ጬቀተይ ታና እፀይሳ ግደና፤</para>
  <para style="q2" vid="PSA 55:12">እያ ግድያኮ ታ እያፐ ቆሰታናሽን።<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>ሽን ሄሳ ኦይ ነና፥</para>
  <para style="q2" vid="PSA 55:13">ታ ላግያ፤ ታ ዳቡዋነ ታ ሲቁዋ።<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>ኑ እሶይ እሱዋራ ኡሎ ኦዳ ኦደትዳ፤</para>
  <para style="q2" vid="PSA 55:14">ፆሳ ኬን ዳባባን አሳራ እስፈ ስመረትዳ።<verse eid="PSA 55:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>ኤንታ ዎዛናን ኢታተ ደእያ ግሾ፥</para>
  <para style="q2" vid="PSA 55:15">ታ ሞርከት ቆፖና ሀይቆ፤</para>
  <para style="q2" vid="PSA 55:15">ኤንቲ ፓፃ ደእሸ ዱፎ ገሎ።<verse eid="PSA 55:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>ሽን ታኒ ፆሳ ፄጋና፤</para>
  <para style="q2" vid="PSA 55:16">ጎዳይ ታና አሻና።<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>ዎንታ፥ ጋላስነ ኦማርስ ዋሳና፤</para>
  <para style="q2" vid="PSA 55:17">ታ መቱዋ እያዉ ኦዳና፤ እ ታና ስአና።<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>ዳሮት ታና ሞርክኮካ፥</para>
  <para style="q2" vid="PSA 55:18">እ ታና ቶራፐ አሼስ።<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>በንፐ ባ አራታን ኡትዳ ፆሳይ፥</para>
  <para style="q2" vid="PSA 55:19">ባንታ ኦግያ ላሞና ግሾነ</para>
  <para style="q2" vid="PSA 55:19">እያዉ ያዮና ግሾ ታና ስእድ ኤንታ ካዉሻና። <char style="qs">ሳላሀ </char><verse eid="PSA 55:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>ታ ላገይ ባ ዳቦታ ቆህስ፤</para>
  <para style="q2" vid="PSA 55:20">ኤንታራ ጫቅዳ ጫቁዋ መንስ።<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>እያ ዶናይ ኦይሳፐ ሊቆ፤</para>
  <para style="q2" vid="PSA 55:21">ሽን ባ ዎዛናን ኦላ ደንስ።</para>
  <para style="q1" vid="PSA 55:21">እያ እንፃርሳይ ዛይተፐ አዳ ሹጎ፤</para>
  <para style="q2" vid="PSA 55:21">ሽን ቃንፃናዉ ጊግዳ ቃራ ማሻ መላ።<verse eid="PSA 55:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>ነ ቶሁዋ ፆሳ ቦላ የጋ፤</para>
  <para style="q2" vid="PSA 55:22">እ ነና ካትሳና።</para>
  <para style="q1" vid="PSA 55:22">ፆሳይ ፅሎት፥</para>
  <para style="q2" vid="PSA 55:22">ዳጋማና መላ ኦና።<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>ሽን አቤት ፆሳዉ፥</para>
  <para style="q2" vid="PSA 55:23">ኢታ አሳታ ዎልቃማ ኦላን ሆላና።</para>
  <para style="q1" vid="PSA 55:23">ሱ ጉሰይሳትነ ጭመይሳት፥</para>
  <para style="q2" vid="PSA 55:23">ባንታ ላይፈ ባጋካ ደኦኮና፤</para>
  <para style="q2" vid="PSA 55:23">ሽን ታኒ ነናን አማነታና።<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="s1">ፆሳ ቦላ ዘምፓ</para>
  <para style="d">ፍልስፄመ አሳይ ጌተ ካታማን ዳዊታ ኦይክዳ ዎደ ዳዊቲ ዛማረታ ሀላቃስ ፃፍዳ ዎሳ</para>
  <para style="d">“ሃሆ በሳን ዎላ ቦላ ኡትዳ ሆሌስ” ጌተትያ ዲ ጩን የፀትዳ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 56:1"/>አቤት ፆሳዉ፥ አሳይ ታና ኡንኤያ ግሾነ</para>
  <para style="q2" vid="PSA 56:1">ኡባ ዎደ ታ ሞርከት ታና የደያ ግሾ ታዉ ቃታ።<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>ታ ሞርከት ኩመ ጋላስ ታና የኦሶና፤</para>
  <para style="q2" vid="PSA 56:2">ኦቶሮን ታና ኦልያ አሳይ ዳሮ።<verse eid="PSA 56:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>ታና ያሽያ ዎደ</para>
  <para style="q2" vid="PSA 56:3">ታ ነናን አማነታይስ።<verse eid="PSA 56:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4"/>ታኒ ፆሳን አማነታይስ፤ ያይከ፤</para>
  <para style="q2" vid="PSA 56:4">እያ ቃላ ጋላትያ ፆሳን አማነታይስ፤</para>
  <para style="q2" vid="PSA 56:4">አስ ታና አይ ኦኔ?<verse eid="PSA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>ኩመ ጋላሳን ታ ሞርከት ባላ ኮዮሶና፤</para>
  <para style="q2" vid="PSA 56:5">ታና ቆሀናዉ ኡባ ዎደ ቶቦሶና።<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>ኤንቲ ታ ቦላ ማቀቶሶና፤</para>
  <para style="q2" vid="PSA 56:6">ታና ቆሀናዉ ጌዶሶና።</para>
  <para style="q1" vid="PSA 56:6">ታ ታንጎ ኡባ ካሎሶና፤</para>
  <para style="q2" vid="PSA 56:6">ታና ዎናዉ ኮዮሶና።<verse eid="PSA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>ኤንቲ አይ ኦገራካ ከስ ኤካና መላ ኦፋ፤</para>
  <para style="q2" vid="PSA 56:7">ነ ሀንቁዋን ሄ ካዎተታ ካዉሻ።<verse eid="PSA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>ታ ዋይያ ታይባ፤</para>
  <para style="q2" vid="PSA 56:8">ነ ታ አፉ ማካዳሳ፤</para>
  <para style="q2" vid="PSA 56:8">ኤንቲ ነ ማዝጋብያን ደኦኮና?<verse eid="PSA 56:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>ታ ነና ፄግያ ዎደ፥</para>
  <para style="q2" vid="PSA 56:9">ታ ሞርከት ጉየ ስማና፤</para>
  <para style="q2" vid="PSA 56:9">ፆሳይ ታ ባጋ ግደይሳ ታ ሄሳን ኤራይስ።<verse eid="PSA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>ታ እያ ቃላ ጋላትያ ፆሳን፥</para>
  <para style="q2" vid="PSA 56:10">ታ እያ ቃላ ጋላትያ ጎዳን፥<verse eid="PSA 56:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="PSA 56:11"/>ታ ሄ ፆሳን አማነታይስ፤ ያይከ።</para>
  <para style="q2" vid="PSA 56:11">አስ ታና አይ ኦኔ?<verse eid="PSA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>አቤት ፆሳዉ ታ ነዉ ቃንግዳባይ ደኤስ፤</para>
  <para style="q2" vid="PSA 56:12">ሄሳ ጋላታ ያርሾ ኦዳ ታ ነዉ እማና።<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>ደኦን ደኤይሳታ ቦላ ፖእያ ፖኡዋን</para>
  <para style="q2" vid="PSA 56:13">ፆሳ ስንን ስመረታና መላ፥</para>
  <para style="q2" vid="PSA 56:13">ታ ሸምፑዋ ሀይቆፐ፥</para>
  <para style="q2" vid="PSA 56:13">ታ ቶሁዋ በፐ አሻዳሳ።<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="s1">ነ ቦንቾይ ሳአ ኡባን ግዶ</para>
  <para style="d">ዳዊቲ ሳኦላፐ ባቃትድ ጎንጎሎን ቆሰትዳ ዎደ ዛማረታ ሀላቃስ ፃፍዳ ዎሳ</para>
  <para style="d">“ይሶፋ” ጌተትያ ዲ ጩን የፀትዳ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 57:1"/>ታና ማራ፤ አቤት ፆሳዉ፥</para>
  <para style="q2" vid="PSA 57:1">ታና ማራ፤ ታ ኔኮ ባቃታይስ።</para>
  <para style="q1" vid="PSA 57:1">ዮይ አና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 57:1">ነ ቀፍያ ጋርሳን ቆሰታይስ።<verse eid="PSA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>ታኒ ኡባፈ ቃ ፆሳኮ፥</para>
  <para style="q2" vid="PSA 57:2">ባ ቆፋ ኦያ ፆሳኮ ዋሳይስ።<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>ፆሳይ ሳሎፐ ማዶ ኪትድ ታና አሻና፤</para>
  <para style="q2" vid="PSA 57:3">ታና የይሳታ ካዉሻና፤</para>
  <para style="q1" vid="PSA 57:3">ፆሳይ ባ ሲቁዋነ</para>
  <para style="q2" vid="PSA 57:3">ባ አማነተ ታዉ ኪታና። <char style="qs">ሳላሀ </char><verse eid="PSA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>ታኒ ታ ሞርከታፐ ግዶን፥</para>
  <para style="q2" vid="PSA 57:4">አሰ ምያ ጋሞታፐ ግዶን ደአይስ።</para>
  <para style="q1" vid="PSA 57:4">ኤንታ አቻይ ቶራነ ዶንገ ቶራ መላ፤</para>
  <para style="q2" vid="PSA 57:4">ኤንታ እንፃርሳይ ቃራ ማሻ መላ።<verse eid="PSA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>አቤት ፆሳዉ፥ ነ ሳሎፐ አዳ ቁ ቁ ጋ፤</para>
  <para style="q2" vid="PSA 57:5">ነ ቦንቾይ ሳአ ኡባ ካሞ።<verse eid="PSA 57:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>ኤንቲ ታ ቶሁዋስ ፅሄ ዎዶሶና፤</para>
  <para style="q2" vid="PSA 57:6">ታኒ ኡንኤታዳ ሆካስ።</para>
  <para style="q1" vid="PSA 57:6">ኤንቲ ታ ኦግያን ኦላ ቦክዶሶና፤</para>
  <para style="q2" vid="PSA 57:6">ሽን ሄ ኦላን ባንታዉ ኩንድዶሶና። <char style="qs">ሳላሀ </char><verse eid="PSA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>ታ ዎዛናይ ምኖ፤</para>
  <para style="q2" vid="PSA 57:7">አቤት ፆሳዉ፥ ታ ዎዛናይ ምኖ፤</para>
  <para style="q2" vid="PSA 57:7">ታኒ ነና ማዝሙረን ሳባና።<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>ታ ሸምፐ፥ ባርካ፤</para>
  <para style="q2" vid="PSA 57:8">ዲነ ማስንቆይ ደንድተ፤</para>
  <para style="q2" vid="PSA 57:8">ታኒ ጉራ ባርካና።<verse eid="PSA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>አቤት ጎዳዉ፥ ታ ነና አሳ ግዶን ጋላታና፤</para>
  <para style="q2" vid="PSA 57:9">ካዎተታ ግዶን ነና ሳባና።<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>ነ ሲቆይ ሳሎታፐ ቃ፤</para>
  <para style="q2" vid="PSA 57:10">ነ አማነተይ ሻራፐ ቦላ።<verse eid="PSA 57:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>አቤት ፆሳዉ፥ ነ ሳሎፐ አዳ ቁ ቁ ጋ፤</para>
  <para style="q2" vid="PSA 57:11">ነ ቦንቾይ ሳአ ኡባ ካሞ።<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="s1">ፆሳይ ሳአ ኡባ ፕርዳና</para>
  <para style="d">ዳዊቲ ዛማረታ ሀላቃስ ፃፍዳ ዎሳ</para>
  <para style="d">“ይሶፋ” ጌተትያ ዲ ጩን የፀትዳ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 58:1"/>ደርያ ሃረይሳቶ፥ ቱማ ህንተ ልከ ኦደቴቲ?</para>
  <para style="q2" vid="PSA 58:1">አሳ ኡባስ ፅሎ ፕርዴቲ?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>ግደና፥ ህንተ ዎዛናን ኢታባ ሀልቼታ፤</para>
  <para style="q2" vid="PSA 58:2">ህንተ ኩሸይ ቢታ ቦላ ጌላባ ኦስ።<verse eid="PSA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>ኢታ አስ አየ ኡሎፐ ዶምድ ሀሌስ፤</para>
  <para style="q2" vid="PSA 58:3">የለትዳ ጋላሳፐ ዶምድ፥</para>
  <para style="q2" vid="PSA 58:3">ባሌስነ ዎርዶ ኦደቴስ።<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>ኤንቲ ሾሻዳ ዪሻራ ደኦሶና፤</para>
  <para style="q2" vid="PSA 58:4">ኤንቲ ቱለ ጎፐዳ ስኦኮና።<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>ብተይስ አይ ጭንጫ ግድኮካ፥</para>
  <para style="q2" vid="PSA 58:5">ጎፐይ እያ ፄስ ስኤና።<verse eid="PSA 58:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>አቤት ፆሳዉ፥ ጋሞ አች ዳንያ ኤንታ አቻ መን፤</para>
  <para style="q2" vid="PSA 58:6">ጎዳዉ ኤንታ ሳክልያ ካ።<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>ኤንቲ ጉክዳ ሃ ግዶ፤</para>
  <para style="q2" vid="PSA 58:7">ባንታ ዶንግያ ዱክያ ዎደ፥</para>
  <para style="q2" vid="PSA 58:7">ዶንገ ቶራ አይፈይ ዮ።<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>ኤንቲ ማይድ ይያ  ሳሶዳ ሀኖ፤</para>
  <para style="q2" vid="PSA 58:8">አየ ኡሎፐ ሀይቅድ ዎያ፥</para>
  <para style="q2" vid="PSA 58:8">አዋ ፖኦ በኦና ቦሻዳ ሀኖ።<verse eid="PSA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>ኤንቲ አጉን ግድድ ዳያናፐ ካሰ፥</para>
  <para style="q2" vid="PSA 58:9">ኤንቲ ቡሮ ፑቶ ግድድ ደእሽን፥</para>
  <para style="q2" vid="PSA 58:9">ኤንታ ባ ሀንቁዋን ይሳና።<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>ናጋራንቾታ ቦላ ሀሎ ከይያ ዎደ ፅሎት ኡፋይታና፤</para>
  <para style="q2" vid="PSA 58:10">ኢታታ ሱን ባንታ ቶሁዋ ሜጨታና።<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>ሄ ዎደ አሳይ፥</para>
  <para style="q2" vid="PSA 58:11">“ቱማ ፅሎታስ ዎይቶይ ደኤስ፤</para>
  <para style="q2" vid="PSA 58:11">ሳአ ቦላ ፕርድያ ፆሲ ደኤስ” ያጋና።<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="s1">ፆሳዉ ታና ታ ሞርከታፐ አሻ</para>
  <para style="d">ዳዊቲ ዎናዉ እያ ኬ ናጋና መላ ሳኦል አሰ ኪትን፥ ዳዊቲ ዛማረታ ሀላቃስ ፃፍዳ ዎሳ</para>
  <para style="d">“ይሶፋ” ጌተትያ ዲ ጩን የፀትዳ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 59:1"/>አቤት ታ ፆሳዉ፥ ታ ሞርከታፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 59:1">ታ ቦላ ደንደይሳታፐ ታና ናጋ።<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>ኢታ ኦይሳታፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 59:2">ሱ ጉስያ አሳታፐ ታና አሻ።<verse eid="PSA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>አቤት ጎዳዉ፥ ኤንቲ ታና ዎናዉ</para>
  <para style="q2" vid="PSA 59:3">ዙግድ ናገይሳ በአ።</para>
  <para style="q1" vid="PSA 59:3">አቤት ጎዳዉ፥ ታ ናቁዋ ግሾ</para>
  <para style="q2" vid="PSA 59:3">ዎይኮ ታ ናጋራ ግሾ</para>
  <para style="q2" vid="PSA 59:3">ግዶናሽን ጮ ታ ቦላ ቶቦሶና።<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>ታ አይ ባላካ ኦና ታና ቆሀናዉ ጊግዶሶና፤</para>
  <para style="q2" vid="PSA 59:4">ሄሳ በአ፤ ታና ማዳናዉ ደንዳ።<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>አቤት ኡባፈ ዎልቃማ ፆሳዉ፥ ጎዳዉ፥</para>
  <para style="q2" vid="PSA 59:5">እስራኤለ ፆሳዉ፥ ካዎተታ ኡባ ፕርዳናዉ ባርካ፤</para>
  <para style="q2" vid="PSA 59:5">ኢታ ኦይሳታ ማሮፓ። <char style="qs">ሳላሀ </char><verse eid="PSA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>ኤንቲ ካታማ ግዶን ዩይሸ ፔእድ፥</para>
  <para style="q2" vid="PSA 59:6">ካና ላውሸ ስሞሶና።<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>ኤንታ ዶናፐ ከየይሳ በአ፤</para>
  <para style="q2" vid="PSA 59:7">ኤንታ እንፃርሳይ ማሻ መላ፤</para>
  <para style="q2" vid="PSA 59:7">አስ ኤንታና ስኤይሳ ቆፖኮና።<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>ሽን አቤት ጎዳዉ፥ ነ ኤንታ ቦላ ሚጫሳ፤</para>
  <para style="q2" vid="PSA 59:8">ካዎተታ ኡባ ለቅሳሳ።<verse eid="PSA 59:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>ፆሳዉ፥ ነ ታ ሚፃ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 59:9">ታ ነ ዎልቃን አማነታይስ።<verse eid="PSA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10"/>ታ ፆሳይ ባ ሲቁዋን ታኮ ያና፤</para>
  <para style="q2" vid="PSA 59:10">ታ ፆሳይ ታ ሞርከታ ፆነተ ታና በሳና።<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>ታ አሳት ዶጎና መላ ነ ኤንታ ዎፓ።</para>
  <para style="q2" vid="PSA 59:11">አቤት ጎዳዉ፥ ኑ ጎንዳልያዉ፥</para>
  <para style="q2" vid="PSA 59:11">ነ ዎልቃን ኤንታ ላላነ ካዉሻ።<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>ኤንታ ዶናፐ ከይያ ናጋራ ግሾ</para>
  <para style="q2" vid="PSA 59:12">ኤንታ እንፃርሳፈ ፑልትያ ቃላ ግሾ፥</para>
  <para style="q2" vid="PSA 59:12">ባንታ ኦቶሩዋን ኦይከቶ፤</para>
  <para style="q1" vid="PSA 59:12">ኤንታ ባደነ ዎርዱዋ ግሾ፥<verse eid="PSA 59:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13"/>ነ ሀንቁዋን ኤንታ ይሳ፤</para>
  <para style="q2" vid="PSA 59:13">ኤንታ ኩመ ድጋ።</para>
  <para style="q1" vid="PSA 59:13">ሄሳን ፆሳይ ያይቆባ ዘረ ሃረይሳነ</para>
  <para style="q2" vid="PSA 59:13">ሳኣ ጋፃ ጋካናዉ ሃረይስ ኤረታና። <char style="qs">ሳላሀ </char><verse eid="PSA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>ኤንቲ ካታማ ግዶን ዩይሸ ፔእድ፥</para>
  <para style="q2" vid="PSA 59:14">ካና ላውሸ ስሞሶና።<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>ኤንቲ ምያባ ደማናዉ ቶይላቶሶና፤</para>
  <para style="q2" vid="PSA 59:15">ካሎና አትዳ ላውያ ካና ግዶሶና።<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>ሽን ታኒ ነ ዎልቃ ሳባና፤</para>
  <para style="q2" vid="PSA 59:16">ዎንታ ነ ሲቁዋ የፃና።</para>
  <para style="q1" vid="PSA 59:16">ኔኒ ታዉ ታ ዋይያ ጋላስ፥</para>
  <para style="q2" vid="PSA 59:16">ታ ባቃታ አትያ በሰነ ሚፃ።<verse eid="PSA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>አቤት ታዉ ዎልቃ ግድዳ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 59:17">ታ ነና ሳባና።</para>
  <para style="q1" vid="PSA 59:17">ታ ቆሰታዳ አትያ በሳይነ</para>
  <para style="q2" vid="PSA 59:17">ሲቁዋ ታና በሲያ ፆሳይ ነና።<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="s1">ኑ ሞርከታፐ ኑና አሻ</para>
  <para style="d">ማሰጰፆመንነ ሶባላን ደእዳ አራመ አሳራ ኦለትዳ ዎደነ እዮኣብ ጉየ ስሚድ ማፅነ ዛንጋራን ታማነ ናምኡ ሙኩሉ ኤዶመ አሳ ዎዳ ዎደ ዳዊቲ ዛማረታ ሀላቃስ ፃፍዳ ዎሳ</para>
  <para style="d">“ጪሻ ጩ” ጌተትያ ማርካተ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 60:1"/>አቤት ፆሳዉ፥ ነ ኑና አጋዳሳ፤</para>
  <para style="q2" vid="PSA 60:1">ኑና መንርዳሳ።</para>
  <para style="q1" vid="PSA 60:1">ነ ኑና ሀንቀታዳሳ፤</para>
  <para style="q2" vid="PSA 60:1">ሽን ሀእ ኑና ዛራ፥ ምን ኤሳ።<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>ነ ቢታ ቃዳሳነ ዛእሳዳሳ፤</para>
  <para style="q2" vid="PSA 60:2">ቢታይ ኮኮርያ ግሾ፥ ነ እያ ዛኡዋ ኩን።<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>ኔኒ ነ አሳ መቶ በሳዳሳ፤</para>
  <para style="q2" vid="PSA 60:3">ኑና ጋንድጋርስያ ዎይነ ኡሻዳሳ።<verse eid="PSA 60:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>ነዉ ያየይሳት ባንታ ሞርከ ዶንገፈ</para>
  <para style="q2" vid="PSA 60:4">አታና መላ ማላ እማዳሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>ነ ሲቀይሳት አታና መላ፥</para>
  <para style="q2" vid="PSA 60:5">ነ ኡሻቻ ኩሸን</para>
  <para style="q2" vid="PSA 60:5">ኑና አሻ፤ ኑና አላ።<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>ፆሳይ ባ ጌሻ በሳን ሀይሳዳ ያግስ፤</para>
  <para style="q2" vid="PSA 60:6">“ታኒ ፆናዳ ሴከማ ቢታ ሻካና፤</para>
  <para style="q2" vid="PSA 60:6">ሱኮታ ዛንጋራ ዋና።<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>ጋላድ ታባ፤ ምናሰይካ ታሳ፤</para>
  <para style="q2" vid="PSA 60:7">ኤፍሬም ታ ሁጰ አሽያ ብራታ ቆቤ፤</para>
  <para style="q2" vid="PSA 60:7">ይሁድ ታ ካዎታ ፃምኣ።<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>ሞአበይ ታ ሜጨትያ ከረ፤</para>
  <para style="q2" vid="PSA 60:8">ኤዶመይ ታባ ግደይሳ ኤርሳናዉ፥</para>
  <para style="q2" vid="PSA 60:8">ታ ጫማ እያ ቦላ ዎይስ፤</para>
  <para style="q2" vid="PSA 60:8">ታኒ ፍልስፄመ ፆናዳ ገሬራይስ” ያግስ።<verse eid="PSA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>ግምበትዳ ካታማኮ ታና ኦነ ኤፋናይ?</para>
  <para style="q2" vid="PSA 60:9">ኤዶመ ጋካናዉ ታና ኦነ ካለናይ?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>አቤት ፆሳዉ፥ ኑና አግዳይ ነና ግድኪ?</para>
  <para style="q2" vid="PSA 60:10">አቤት ፆሳዉ ኔኒ ኑ ኦላንቾታራ ኦላስ ከያካ።<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>አሳ ማዶይ ፓና ግሾ፥</para>
  <para style="q2" vid="PSA 60:11">ሞርከታራ ኦለታናዉ ነ ኑና ማዳ።<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>ፆሳ ዎልቃን ኑ ሞርከታ ፆናና፤</para>
  <para style="q2" vid="PSA 60:12">እ ኑ ሞርከታ የና።<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="s1">ፆሳዉ ታና ዛላኮ ካለ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 61:1"/>አቤት ፆሳዉ፥ ነ ታ ዎሳ ስአ፤</para>
  <para style="q2" vid="PSA 61:1">ታ ዎሳ ሀይዛ።<verse eid="PSA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>ታኒ ቢታ ጋፃን ደእሽን፥</para>
  <para style="q2" vid="PSA 61:2">ታ ዎዛናይ ኡፋይስ ቃንፅዳ ዎደ፥</para>
  <para style="q2" vid="PSA 61:2">ታ ነና ፄጋይስ።</para>
  <para style="q1" vid="PSA 61:2">ታፐ ቃ ዛላኮ፥</para>
  <para style="q2" vid="PSA 61:2">ታና ካለ።<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>ነ ታዉ ቆታነ</para>
  <para style="q2" vid="PSA 61:3">ታ ሞርከታፐ ናገትያ ምኖ ሚፃ።<verse eid="PSA 61:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>ታኒ ነ ዱንካንያን መርናዉ ዳርክናሽን!</para>
  <para style="q2" vid="PSA 61:4">ታኒ ነ ቀፍያ ሀጳ ጋርሳን ሳሮ አታርክናሽን! <char style="qs">ሳላሀ </char><verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>አቤት ፆሳዉ፥ ነ ታ ቃንገ ስአዳሳ፤</para>
  <para style="q2" vid="PSA 61:5">ነ ሱን ያየይሳታራ እስፈ ታዉ ላታ እማዳሳ።<verse eid="PSA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>ካዋ ላይ አዱሳ፤</para>
  <para style="q2" vid="PSA 61:6">እ የለተፈ የለተ ጋካናዉ ደኦ።<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>እ ፆሳ ስንን መርናዉ ካዎቶ፤</para>
  <para style="q2" vid="PSA 61:7">ነ ሲቁዋንነ ነ ቱማን እያ ናጋ።<verse eid="PSA 61:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>ሄሳ ግሾ ታ ቃንገ ጋላስ ጋላስ ጋና፤</para>
  <para style="q2" vid="PSA 61:8">ነ ሱን ኡባ ዎደ ሳባና።<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="s1">ፆሳ ፃላላን ኡፋይስ ዎ</para>
  <para style="d">ዳዊቲ ዛማረታ ሀላቃ ኤዶታመስ ፃፍዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 62:1"/>ፆሳ ፃላላን ታ ሸምፖ ደማስ፤</para>
  <para style="q2" vid="PSA 62:1">ታ አቶተይ እያፐ ዬስ።<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>እያ ፃላል ታ ዛላነ ታ አቶተ፤</para>
  <para style="q2" vid="PSA 62:2">እ ታ ቆሰትያ አትያ በሲ ግድያ ግሾ ዳጋምከ።<verse eid="PSA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>ዎዳና ሀንያ ጎዳነ ቃፅያ ድርስ ዳንያ ኡራ ዎናዉ፥</para>
  <para style="q2" vid="PSA 62:3">ህንተ አዉደ ጋካናዉ ደንደቲ?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>ኤንቲ እያ ቦንቾ በሳፈ ደንናዉ ኮዮሶና፤</para>
  <para style="q2" vid="PSA 62:4">ኤንቲ ዎርዶን ኡፋይቶሶና።</para>
  <para style="q1" vid="PSA 62:4">ባንታ ዶናን አንጆሶና፤</para>
  <para style="q2" vid="PSA 62:4">ሽን ባንታ ዎዛናን ባዶሶና። <char style="qs">ሳላሀ </char><verse eid="PSA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>ታ ሸምፐተ!</para>
  <para style="q2" vid="PSA 62:5">ፆሳ ፃላላ ስእ ጋዳ ናጋ፤</para>
  <para style="q2" vid="PSA 62:5">ታ ኡፋይሳይ እያፐ ዬስ።<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>እያ ፃላል ታ ዛላነ ታ አቶተ፤</para>
  <para style="q2" vid="PSA 62:6">ታኒ ቆሰትያ በሲ ግድያ ግሾ ዳጋምከ።<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>ታ አቶተይነ ታ ቦንቾይ ፆሳና፤</para>
  <para style="q2" vid="PSA 62:7">እ ታ ምኖ ዛላነ ታ ሚፃ።<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>አሳዉ፥ ኡባ ዎደ ፆሳን አማነትተ፤</para>
  <para style="q2" vid="PSA 62:8">እ ህንተዉ ገሸ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 62:8">ህንተ ቆፋ እያዉ ኦድተ። <char style="qs">ሳላሀ </char><verse eid="PSA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>አስ፥ እስ ቶሆ ሸምፕያ ጫርኮ መላ፤</para>
  <para style="q2" vid="PSA 62:9">ጎባ አስ ኡባይ ማዶና ሀዳ።</para>
  <para style="q1" vid="PSA 62:9">ምዛነን ዎን ኤንቲ ጫርኮ መላ፤</para>
  <para style="q2" vid="PSA 62:9">ኤንቲ እስ ቶሆ ሸምፕያ ጫርኮፈ ካዉዮሶና።<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>ቦንቀን አማነቶፍተ፤</para>
  <para style="q2" vid="PSA 62:10">ካይሶት ሺሽድ ዱረተን ኦቶርቶፍተ።</para>
  <para style="q2" vid="PSA 62:10">ህንተ ዱረተይ ዳርኮካ፥</para>
  <para style="q2" vid="PSA 62:10">ህንተ ዎዛና እያ ቦላ ዎፍተ።<verse eid="PSA 62:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>ፆሳይ እስ ቶሆ ኦድስ፤</para>
  <para style="q2" vid="PSA 62:11">ታኒ ናምኡ ኦዳ ስአስ፤</para>
  <para style="q2" vid="PSA 62:11">ዎልቅ ፆሳሳ።<verse eid="PSA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12"/>መርና ሲቆይ ፆሳባ፤</para>
  <para style="q2" vid="PSA 62:12">አቤት ጎዳዉ፥ ነ አሳ ኡባስ</para>
  <para style="q2" vid="PSA 62:12">እያ ኦሱዋዳ ኦሱዋዳ እማና።<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="s1">ታ ሸምፕያ ነና ሳሞታሱ</para>
  <para style="d">ይሁዳ መላ ቢታን ደእያ ዎደ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 63:1"/>አቤት ፆሳዉ፥ ነ ታ ፆሳ፤</para>
  <para style="q2" vid="PSA 63:1">ታ ዎዛናይ ነና ላሞቴስ፤</para>
  <para style="q2" vid="PSA 63:1">ታ አሾይካ ነና አሞቴስ።</para>
  <para style="q1" vid="PSA 63:1">ሃ ይድ ጳልቀትዳ ቢታዳ፥</para>
  <para style="q2" vid="PSA 63:1">ታ አሳተይ ነና ሳሞቴስ።<verse eid="PSA 63:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>ታ ነና ጌሻ በሳን ፄላስ፤</para>
  <para style="q2" vid="PSA 63:2">ነ ዎልቃነ ነ ቦንቹዋ ታኒ በአስ።<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>ነ ሲቆይ ደኦፐ ሎእያ ግሾ፥</para>
  <para style="q2" vid="PSA 63:3">ታ እንፃርሳይ ነና ቦንቻና።<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>ታ ደኦ ላይን ነና ጋላታና፤</para>
  <para style="q2" vid="PSA 63:4">ነ ሱንን ታ ኩሽያ ፑደ ምጫና።<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>አስ ሎኦ ካ ምድ ካለይሳዳ ታ ነናን ካላና።</para>
  <para style="q2" vid="PSA 63:5">ታኒ ታ እንፃርሳን ኡፋይሳ የን ነና ጋላታና።<verse eid="PSA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>ታኒ ታ ሂፃን ነና ሀሳያይስ፤</para>
  <para style="q2" vid="PSA 63:6">ቃማ ኩመን ነባ ቆፓይስ፤<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>ነ ታና ማድያ ግሾ፥</para>
  <para style="q2" vid="PSA 63:7">ታ ነ ቀፍያ ኩያን ኡታዳ ኡፋይሳን የፃና።<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>ታ ሸምፕያ ኔራ ኦይከታሱ፤</para>
  <para style="q2" vid="PSA 63:8">ነ ኡሻቻ ኩሸይ ታና ኦይክድ ናጌስ።<verse eid="PSA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>ሽን ታና ዎናዉ ኮየይሳት፥</para>
  <para style="q2" vid="PSA 63:9">ቢታ ጋርሳን ሞገታና።<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>ኤንቲ ማሻስ አድ እመታና፤</para>
  <para style="q2" vid="PSA 63:10">ኤንቲ ሱመስ ካሆ ግዳና።<verse eid="PSA 63:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>ሽን ካዎይ ፆሳን ኡፋይታና።</para>
  <para style="q2" vid="PSA 63:11">ፆሳ ሱንን ጫቅያ ኡባይ እያ ጋላታና፤</para>
  <para style="q2" vid="PSA 63:11">ሽን ዎርዳንቾታ ዶናይ ጎርደታና።<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="s1">ኢታታፐ ታና አሻ</para>
  <para style="d">ዛማረታ ሀላቃስ የፀትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 64:1"/>አቤት ፆሳዉ፥ ታ ኡንአ ዎሳ ስአ፤</para>
  <para style="q2" vid="PSA 64:1">ታ ሞርከታ ማንደፈ፤ ታና አሻ።<verse eid="PSA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>ናጋራንቾታ ማቆፈነ</para>
  <para style="q2" vid="PSA 64:2">ኢታታ ዱላታፐ ታና ገን።<verse eid="PSA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>ኤንቲ ባንታ እንፃርሳ ማሻ መላ ሌፍዶሶና፤</para>
  <para style="q2" vid="PSA 64:3">ኢታ ቃላታ ዶንገ ቶራዳ ማልድ የዶሶና።<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>ኤንቲ ቆሰትድ ፅሎ አስ ባንታ ዶንግያን ቆሆሶና፤</para>
  <para style="q2" vid="PSA 64:4">አኬክ ባይና ዱኮሶና፤ ያዮኮና።<verse eid="PSA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>ኤንቲ ባንታ ኢታ ማቁዋስ</para>
  <para style="q2" vid="PSA 64:5">እሶይ እሱዋ ምንሶና።</para>
  <para style="q1" vid="PSA 64:5">ባንታ ፅህያ ዎና በሳ ኮዮሶና፤</para>
  <para style="q2" vid="PSA 64:5">ኤንቲ፥ “ኑና ኦን በአኔ?” ያጎሶና።<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>ኤንቲ ኢታባ ማቀትሸ፥</para>
  <para style="q2" vid="PSA 64:6">“ኑኒ ሎኦ ማቆ ማቀትዳ” ያጎሶና፤</para>
  <para style="q2" vid="PSA 64:6">ሄስ አሳ ዎዛና ቆፍ ጪሞ ግደይሳ በሴስ።<verse eid="PSA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>ሽን ፆሳይ ኤንታ ባ ዶንግያን ዱካና፤</para>
  <para style="q2" vid="PSA 64:7">ኤንቲ አኬኮና ማዱንፃና።<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>ኤንታ ማቁዋ እ ኤንታ ቦላ ዛራና፤</para>
  <para style="q2" vid="PSA 64:8">ኤንታ በእያ ኡባይ ሁጰ ቃና።<verse eid="PSA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>ሄ ዎደ አሳ ኡባይ ፆሳስ ያያና፤</para>
  <para style="q2" vid="PSA 64:9">እያ ኦሱዋ ኦዳናነ ዛር ዛር ቆፓና።<verse eid="PSA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>ፅሎት ጎዳን ኡፋይቶ፤</para>
  <para style="q2" vid="PSA 64:10">እያኮ ባቃትድ አቶ፤</para>
  <para style="q2" vid="PSA 64:10">ዎዛና ሱረት ኡባይ እያ ጋላቶ።<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="s1">ፆሳይ ታ አቶተ</para>
  <para style="d">ዛማረታ ሀላቃስ የፀትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 65:1"/>አቤት ፆሳዉ፥ ፅዮነን ነዉ ጋላት በሴስ፤</para>
  <para style="q2" vid="PSA 65:1">ኑኒ ኑ ቃንገ ነዉ ጋና።<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>ኔኒ ዎሳ ስእያ ግሾ፥</para>
  <para style="q2" vid="PSA 65:2">አሳ ኡባይ ኔኮ ዮሶና።<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>ኑ ናጋራይ ኑና ሙክዳ ዎደ፥</para>
  <para style="q2" vid="PSA 65:3">ነ ኑስ አቶተ እማዳሳ።<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>ነ ዶርዳይሳትነ ነ ዳባባን ዳና መላ</para>
  <para style="q2" vid="PSA 65:4">ኔኮ ሺሽዳ አስ አንጀትዳይሳ።</para>
  <para style="q1" vid="PSA 65:4">ኑኒ ነ ሶን፥ ነ ጌሻ ዱንካንያን</para>
  <para style="q2" vid="PSA 65:4">ደእያ ሎኦባን ካሎስ።<verse eid="PSA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>አቤት ኑ አቶተዉ፥</para>
  <para style="q2" vid="PSA 65:5">ማላልስያ ነ ፅሎ ኦሱዋን ኑስ ዛራ።</para>
  <para style="q1" vid="PSA 65:5">ሳኣ ጋፃፐ ጋፃ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 65:5">ሃሆን ደእያ ኡባስ ነ ኡፋይስ።<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>ኔኒ ነ ዎልቃን ደረታ ምንዳሳ፤</para>
  <para style="q2" vid="PSA 65:6">ነ ዎልቃ ዳንጫዳሳ።<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>ኔኒ አባ ግርሳነ ቤታ ጉን ስእ ኦሳ፤</para>
  <para style="q2" vid="PSA 65:7">ያርክያ አሳ ዋሱዋ እርፅሳሳ።<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>ነ ኦዳ ማላታ ግሾ፥</para>
  <para style="q2" vid="PSA 65:8">ሳኣ ጋፃ ጋካናዉ ደእያ አሳ ኡባይ ነዉ ያያና፤</para>
  <para style="q2" vid="PSA 65:8">ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ አሳ ኡባ ኡፋይሳዳሳ።<verse eid="PSA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>ነ እራ እማዳ ቢታ ናጋሳ፤ ዳሮ ዱረያሳ፤</para>
  <para style="q2" vid="PSA 65:9">አሳስ ካይ ዶላና መላ</para>
  <para style="q1" vid="PSA 65:9">ፆሳ ሻፋይ ሃን ኩምዳይሳ፤</para>
  <para style="q2" vid="PSA 65:9">ሄሳዳ ኦዳ ነ ጊግሳዳሳ።<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>ጎሻስ ሃ እማሳ፤</para>
  <para style="q2" vid="PSA 65:10">ቢታ ሹግሳዳ ኦላ ኩንሳ።</para>
  <para style="q1" vid="PSA 65:10">ነ እራን ዛራዳ እርፅሳሳ፤</para>
  <para style="q2" vid="PSA 65:10">ካይ ዶላና ድጫና መላ አንጃሳ።<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>ላይ ካሎ ላይ ኦሳ፤</para>
  <para style="q2" vid="PSA 65:11">ነ አያ በሳ ኡባይ ኩምድ ፓላሀና።<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>ሄን በሳታ ማታን ኩንሳ፤</para>
  <para style="q2" vid="PSA 65:12">ዙማታ ኡፋይስ ማይዛሳ።<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>ነ ሄን በሳታ ዶርሳታ ኩንሳ፤</para>
  <para style="q2" vid="PSA 65:13">ዛንጋራ ቢታን ካ ኩንሳ፤</para>
  <para style="q2" vid="PSA 65:13">ኤንቲ ኡፋይሳን እልልሸ የፆሶና።<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="s1">ነ ኦሶት ማላልሴስ</para>
  <para style="d">ዛማረታ ሀላቃስ የፀትያ ሳባ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 66:1"/>ቢታ ኡባይ ህንተ ቃላ ቁ ኦድ፥</para>
  <para style="q2" vid="PSA 66:1">ኡፋይሳን ፆሳ ጋላትተ።<verse eid="PSA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2"/>ፆሳ ሱንስ ቦንቾን የፅተ፤</para>
  <para style="q2" vid="PSA 66:2">ቦንቾ ጋላታ እያዉ እምተ።<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>ፆሳስ ሀይሳዳ ያግተ፤</para>
  <para style="q2" vid="PSA 66:3">“ነ ኦሶት ዋንድ ማላልሲ?</para>
  <para style="q1" vid="PSA 66:3">ነ ዎልቃይ ዳርዳ ግሾ፥</para>
  <para style="q2" vid="PSA 66:3">ነ ሞርከት ያሻን ነ ስንን ኮኮሮሶና።<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>ቢታ ኡባይ ነና ጎይኔስ፤</para>
  <para style="q2" vid="PSA 66:4">ነና ሳቤስ፤</para>
  <para style="q2" vid="PSA 66:4">ነ ሱንስ ጋላታን የፆሶና” ያግተ። <char style="qs">ሳላሀ </char><verse eid="PSA 66:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>ሃይተ፤ ፆሳይ ኦዳባ በእተ፤</para>
  <para style="q2" vid="PSA 66:5">አሳ ግዶን ማላልስያ ኦሶ ኦስ።<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>እ አባ ሃ ሻክድ፥</para>
  <para style="q2" vid="PSA 66:6">ካሰ ኑ አዋት ዮርዳኖሰ ሻፋ ባንታ ቶሆን የድ መላ ቢታራ ፕንዶሶና።</para>
  <para style="q2" vid="PSA 66:6">ሄሳን እ ኦዳባን ኑኒ ኡፋይትዳ።<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>እ ባ ዎልቃን መርናዉ ሃሬስ።</para>
  <para style="q2" vid="PSA 66:7">ካዎተታ ባ አይፈን ፄሌስ፤</para>
  <para style="q2" vid="PSA 66:7">ሄሳ ግሾ፥ ማካለይሳት እያ ቦላ ደንዶፎ። <char style="qs">ሳላሀ </char><verse eid="PSA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>አሳዉ፥ ኑ ፆሳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 66:8">ህንተ እያ ጋላትያ ጋላታይ ስኤቶ።<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>እ ኑና ፓፃ ዎስ፤</para>
  <para style="q2" vid="PSA 66:9">ኑ ኩንዶና መላ ናግስ።<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>አቤት ፆሳዉ ነ ኑና ፓጫዳሳ፤</para>
  <para style="q2" vid="PSA 66:10">ብር ታማን ፓጨትድ ጌየይሳዳ</para>
  <para style="q2" vid="PSA 66:10">ነ ኑና ጌሻዳሳ።<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>ነ ኑና ፅሄን ገልሳዳሳ፤</para>
  <para style="q2" vid="PSA 66:11">ኑ ዞኮን ዴፆ ቶሆ ዎዳሳ።<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>ሞርከት ኑ ሁጰራ ቶግድ አናዳ ኦዳሳ፤</para>
  <para style="q2" vid="PSA 66:12">ኑ ሃ ግዶራነ ታማ ግዶራ አዳ፤</para>
  <para style="q2" vid="PSA 66:12">ሽን ሀእ ኑና እንጀ በሲ ኤሀዳሳ።<verse eid="PSA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>ታ ፁሳ ያርሾ ኤካዳ ነ ኬ ገላና፥</para>
  <para style="q2" vid="PSA 66:13">ታ ቃንገ ጋና።<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>ታ መቶትዳ ዎደ ታ ዶናይ ግዳ ቃላ፥</para>
  <para style="q2" vid="PSA 66:14">ታ እንፃርሳፈ ከይዳ ቃንገ ጋና።<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>ታ ነዉ ሞዋ፥ ፁሳ ያርሾ ኦዳ ሺሻና።</para>
  <para style="q1" vid="PSA 66:15">ማራዘታ ሳዎ ቶንኩ ግያ ያርሾ ኦዳ ሺሻና፤</para>
  <para style="q2" vid="PSA 66:15">ኮርማነ ኮለታ ነዉ ያርሻና። <char style="qs">ሳላሀ </char><verse eid="PSA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>ህንተኖ፥ ፆሳስ ያየይሳቶ፥</para>
  <para style="q2" vid="PSA 66:16">ኡባይ ሃ ይድ፥ ስእተ፤</para>
  <para style="q2" vid="PSA 66:16">ፆሳይ ታዉ ኦዳባ ታ ህንተዉ ኦዳና።<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>ታ ቃላ ቁ ኦዳ ዎሳስ፤</para>
  <para style="q2" vid="PSA 66:17">ታ እንፃርሳን እያ ጋላታስ።<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>ታኒ ዎዛን ኤርሽን ናጋራ ገንዳባ ግድያኮ፥</para>
  <para style="q2" vid="PSA 66:18">ጎዳይ ታና ስኤና።<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>ሽን ፆሳይ ቱማ ታና ስእስ፤</para>
  <para style="q2" vid="PSA 66:19">ታ ኦይሻ ዛርስ።<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>ፆሳይ ታ ዎሳ እፅቦና ግሾ፥</para>
  <para style="q2" vid="PSA 66:20">ባ መርና ሲቁዋ</para>
  <para style="q2" vid="PSA 66:20">ታና ድግቦና ግሾ ጋላተቶ።<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="s1">ነ ሶምኡዋ ኑስ ፖእሳ</para>
  <para style="d">ዛማረታ ሀላቃስ ዲን የፀትዳ ሳባ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 67:1"/>ፆሳይ ኑስ ቃቶ፤ ኑና አንጆ፤</para>
  <para style="q2" vid="PSA 67:1">እያ ሶምኦይ ኑ ቦላ ፖኦ። <char style="qs">ሳላሀ </char><verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>ነ ኦገይ ቢታ ቦላ፥</para>
  <para style="q2" vid="PSA 67:2">ነ አቶተ ዎልቃይ፥</para>
  <para style="q2" vid="PSA 67:2">ካዎተታ ኡባን ኤረቶ።<verse eid="PSA 67:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>አቤት ፆሳዉ፥ አሳይ ነና ጋላቶ፤</para>
  <para style="q2" vid="PSA 67:3">አሳ ኡባይ ነና ጋላቶ።<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>ካዎተይ ማላለትድ ኡፋይሳን የፆ፤</para>
  <para style="q2" vid="PSA 67:4">አይስ ጊኮ፥ ኔኒ አሳስ ፅሎተን ፕርዳሳ፤</para>
  <para style="q2" vid="PSA 67:4">ሳአን ደእያ ካዎተታ ካለሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>አቤት ፆሳዉ፥ አሳይ ነና ጋላቶ፤</para>
  <para style="q2" vid="PSA 67:5">ካዎተት ኡባይ ነና ጋላቶ።<verse eid="PSA 67:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>ቢታይ ካ እማና፤</para>
  <para style="q2" vid="PSA 67:6">ፆሳይ፥ ኑ ፆሳይ ኑና አንጅስ።<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>ፆሳይ ኑና አንጅዳ ግሾ፥</para>
  <para style="q2" vid="PSA 67:7">ቢታ ጋፃ ጋካናዉ ደእያ አሳይ እያ ያዮ።<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="s1">ፆሳይ ባ ሞርከታ ላላና</para>
  <para style="d">ዛማረታ ሀላቃስ የፀትዳ ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 68:1"/>ፆሳይ ደንዶ፤ እያ ሞርከት ላለቶ፤</para>
  <para style="q2" vid="PSA 68:1">እያ እፀይሳት እያ ስንፈ ባቃቶ።<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>ጩያይ ጫርኮራ ደንድድ ይስያ መላ፥</para>
  <para style="q2" vid="PSA 68:2">ሙቃድ ታማን ትልኤይሳዳ፥</para>
  <para style="q2" vid="PSA 68:2">ኢታት ፆሳ ስንፈ ዮ።<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>ሽን ፅሎት ሀሹ ጎ፤</para>
  <para style="q2" vid="PSA 68:3">ፆሳ ስንን ኡፋይቶ፤</para>
  <para style="q2" vid="PSA 68:3">ኡፋይሳን እልሎ።<verse eid="PSA 68:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>ፆሳስ የፅተ፤ እያ ሱን ሳቢተ፤</para>
  <para style="q2" vid="PSA 68:4">ሻራን በይሳስ ኦገ ከስተ፤</para>
  <para style="q2" vid="PSA 68:4">እያ ሱንይ ጎዳ፤ እያ ስንን ኡፋይትተ።<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>ፆሳይ ባ ደእያ ጌሻ በሳን፥</para>
  <para style="q2" vid="PSA 68:5">ይኦታስ አዋ፤ አምኤታስ ዳይና።<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>ፆሳይ ብዛታስ ሶ አስ እሜስ፤</para>
  <para style="q2" vid="PSA 68:6">ቃሾ ኬን ደኤይሳታ ብርሽድ፥ ዱረተን ዎስ፤</para>
  <para style="q2" vid="PSA 68:6">ሽን ማካላንቾት ቃቃ ቢታን ደኦሶና።<verse eid="PSA 68:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>አቤት ፆሳዉ፥ ኔኒ ነ አሳ ካለዳ ዎደ፥</para>
  <para style="q2" vid="PSA 68:7">ነ ኤንታራ መላ ቢታ ካንዳ ዎደ፥ <char style="qs">ሳላሀ </char><verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>ሲና ፆሳ ዩሳንነ፥</para>
  <para style="q2" vid="PSA 68:8">እስራኤለ ፆሳ ቆንጨን</para>
  <para style="q2" vid="PSA 68:8">ቢታይ ቃፅስ፤ ሳሎይ እራ እሚስ።<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>አቤት ፆሳዉ ኔኒ እራ ዳርሳዳ ቡክሳዳሳ፤</para>
  <para style="q2" vid="PSA 68:9">ላድዳ ቢታ ዛራዳ ኦራሳ።<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>ነ አሳይ ያን ዱሱ ኦይክስ፤</para>
  <para style="q2" vid="PSA 68:10">አቤት ፆሳዉ፥ ነ ኬሀተን ማንቆታስ</para>
  <para style="q2" vid="PSA 68:10">ኮሽያባ ጊግሳዳ እማዳሳ።<verse eid="PSA 68:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>ጎዳይ ኪትስ፤</para>
  <para style="q2" vid="PSA 68:11">ዳሮ ማጫሳት ሄ ኪታ ማርካትዶሶና።<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>ካዎትነ ኤንታ ኦላንቾት</para>
  <para style="q2" vid="PSA 68:12">ባቃትድ ጉየ ስምዶሶና፤</para>
  <para style="q2" vid="PSA 68:12">ሶን አትዳ ማጫሳት ድኦ ሻከትዶሶና።<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>ጶልያ ዎርቃ ቀፈራ ደእያ፥</para>
  <para style="q2" vid="PSA 68:13">ብራፐ መትዳ ሆለ ምስለ ድእድ ደምያ ዎደ</para>
  <para style="q2" vid="PSA 68:13">ህንተ ዶርሳ ከለን አይስ ዝንእደት?<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>ኡባ ዳንዳእያ ፆሳይ ካዎታ ላልዳ ዎደ፥</para>
  <para style="q2" vid="PSA 68:14">ፃልሞና ዙማ ቦላ ሻቻ ቡክስስ።<verse eid="PSA 68:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>ባሳነ ዙማዉ፥</para>
  <para style="q2" vid="PSA 68:15">ዳሮ ፄር ደእያ ባሳነ ዙማዉ፥<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>ዳሮ ፄራት ደእያ ዙማቶ፥</para>
  <para style="q2" vid="PSA 68:16">ፆሳይ ዶርዳ ዙማ</para>
  <para style="q2" vid="PSA 68:16">ህንተ አይስ ቃናትድ ፄሌቲ?</para>
  <para style="q2" vid="PSA 68:16">ጎዳይ እያን መርናዉ ዳና።<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>ፆሳ ኦላ ፓራ ጋረት</para>
  <para style="q2" vid="PSA 68:17">ታሙ ሙኩሉ ቶሆ ታሙ ሙኩላን ታይበቴስ፤</para>
  <para style="q2" vid="PSA 68:17">ጎዳይ ሲና ዙማፐ ባ ጌሻ በሳ ይስ።<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>ድኤትዳ ዳሮታ ኤክድ፥ ቃ ከይስ፤</para>
  <para style="q2" vid="PSA 68:18">አሳፐ፥ ሀር አቶሽን ማካላንቾታፐ እሞ ኤክስ፤</para>
  <para style="q2" vid="PSA 68:18">ጎዳይ ፆሳይ ያን ዳና።<verse eid="PSA 68:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>ጋላስ ጋላስ ኑ ቶሁዋ ቶክያ ጎዳይ ጋላተቶ፤</para>
  <para style="q2" vid="PSA 68:19">ፆሳይ ኑና አሸይሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>ኑ ፆሳይ ኑና አሽያ ፆሳ ግደኔ?</para>
  <para style="q2" vid="PSA 68:20">ሀይቆፐ አሽያ ፆሳይ እያ።<verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>ፆሳይ ቱማ ባ ሞርከታ ሁጵያ ትንቻና፤</para>
  <para style="q2" vid="PSA 68:21">ናጋራ ኦገን ሄመትያ አሳ፥</para>
  <para style="q2" vid="PSA 68:21">ብናናን ካመትዳ ኤንታ ሊጵያ መንና።<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>“ታኒ ህንተ ሞርከታ</para>
  <para style="q2" vid="PSA 68:22">ባሳነፐ ዛራዳ ኤሀና፤</para>
  <para style="q2" vid="PSA 68:22">ታ ኤንታ ጪሞ አባፈ ከሳዳ ጉየ ኤሀና።<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>ሄስካ፥ ነ ሞርከታ ሱ ነ ቶሆይ የና መላነ</para>
  <para style="q2" vid="PSA 68:23">ነ ካናትካ ሞርከ ሱፈ ባንታ ግሹዋ ላጫና መላሳ” ያጌስ ጎዳይ።<verse eid="PSA 68:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>አቤት ፆሳዉ፥ ነ ሳልፐይ፥</para>
  <para style="q2" vid="PSA 68:24">ታ ፆሳይ ታ ካዎይ ሳልፐይ፥</para>
  <para style="q2" vid="PSA 68:24">ፆሳ ኬ ገልያ ዎደ ኡባስ በንቴስ።<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>የፀይሳት ስንና፤ ዲፀይሳት ጉየና፤</para>
  <para style="q2" vid="PSA 68:25">ቃስ ካራቦ ባቅያ ጌላኦት ግዶና።<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>ህንተ “ፆሳ ግታ ሺቆን ጋላትተ፤</para>
  <para style="q2" vid="PSA 68:26">ህንተኖ፥ እስራኤለ አሳዉ፥ ጎዳ ጋላትተ” ያጎሶና።<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>ሄ ሳልፕያን ኡባፈ ካሎ ግድዳ</para>
  <para style="q2" vid="PSA 68:27">ብንያመ ኮቻይ ኮይሮ ታይበቶሶና።</para>
  <para style="q1" vid="PSA 68:27">ካልድ ይሁዳ ሀላቃት ባንታ ጩጋን ደኦሶና፤</para>
  <para style="q2" vid="PSA 68:27">ዉርሰን ዛብሎና ሀላቃትነ</para>
  <para style="q2" vid="PSA 68:27">ንፍታለመ ሀላቃት ታይበቶሶና።<verse eid="PSA 68:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>አቤት ፆሳዉ፥ ነ ዎልቃ ቆንጭሳ፤</para>
  <para style="q2" vid="PSA 68:28">ካሰ ነ ኑስ ኦዳይሳዳ፥</para>
  <para style="q2" vid="PSA 68:28">ነ ምኖተ በሳ።<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>ሄሳ ግሾ፥ የሩሳላመን ደእያ</para>
  <para style="q2" vid="PSA 68:29">ነ ኬ ካዎት ይድ፥</para>
  <para style="q2" vid="PSA 68:29">ነዉ እሞታ እማና።<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>ዶአዳ ማቃ ግዶን ደእያ ግብፀ አሳታ ኔኒ ሴራ፤</para>
  <para style="q2" vid="PSA 68:30">ቦሩነ ማራ ዉደ ዳንያ ካዎተታ ነ ሀንቀታ።</para>
  <para style="q1" vid="PSA 68:30">ኤንቲ ጉልባትድ፥ ባንታ ብራ ነዉ እማና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 68:30">ኔኒ ኤንታ ሴራ፤ ኦለታናዉ ዬሞትያ አሳታ ላላ።<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>ኪተትዳ ሀላቃት ግብፀፈ ያና፤</para>
  <para style="q2" vid="PSA 68:31">ቶጰይ ባ ኩሽያ ፆሳኮ ምጫና።<verse eid="PSA 68:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>ህንተኖ፥ ሳኣ ካዎተቶ፥</para>
  <para style="q2" vid="PSA 68:32">ፆሳስ የፅተ። <char style="qs">ሳላሀ </char><verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>በንፐ ደእያ ሳሎታፐ ቦላራ በይሳስ፤</para>
  <para style="q2" vid="PSA 68:33">ባ ዎልቃማ ግርሳን ባ ጉን ስሰይሳስ የፅተ።<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>ፆሳ ዎልቃባ አዋጅተ፤</para>
  <para style="q2" vid="PSA 68:34">እያ ግታተይ እስራኤለ ቦላና፤</para>
  <para style="q2" vid="PSA 68:34">እያ ዎልቃይካ ሳሎና።<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>ፆሳይ ባ ጌሻ አሳ ቦላ ማላልሴስ፤</para>
  <para style="q2" vid="PSA 68:35">እስራኤለ ፆሳይ ባ አሳስ</para>
  <para style="q2" vid="PSA 68:35">ምኖተነ ዎልቃ እሜስ።</para>
  <para style="p" vid="PSA 68:35">ፆሳይ ጋላተቶ።<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="s1">ፆሳዉ ታና አሻ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 69:1"/>ሃ ታዉ ቆ ጋክዳ ግሾ፥</para>
  <para style="q2" vid="PSA 69:1">አቤት ፆሳዉ፥ ታና አሻ።<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>ኤቅያ በሲ ባይና ጪሞን ምተታስ፤</para>
  <para style="q2" vid="PSA 69:2">ጪሞ ሃ ግዶ ገላስ፤</para>
  <para style="q2" vid="PSA 69:2">ሃ ዙለይ ታ ቦላራ አስ።<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>ማዶ ደማናዉ ዋሳሸ ዳቡራስ፤</para>
  <para style="q2" vid="PSA 69:3">ታ ኮቶኖይ መልስ።</para>
  <para style="q1" vid="PSA 69:3">ታ ፆሳ ፄልሽን፥</para>
  <para style="q2" vid="PSA 69:3">ታ አይፈይ ተልጁምስ።<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>ታና ጮ እፀይሳት</para>
  <para style="q2" vid="PSA 69:4">ታ ሁጰ ብናናፐ ዳሮ፤</para>
  <para style="q1" vid="PSA 69:4">ዎርዶን ታና ሞርከይሳትነ</para>
  <para style="q2" vid="PSA 69:4">ይሳናዉ ኮየይሳት ዳሮ፤</para>
  <para style="q2" vid="PSA 69:4">ታ ካይሶቶናባ ዛራ ግዶሶና።<verse eid="PSA 69:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>አቤት ፆሳዉ፥ ታ ኤያተ ነ ኤራሳ፤</para>
  <para style="q2" vid="PSA 69:5">ታ ባላይ ኔፐ ጌምቤና።<verse eid="PSA 69:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>አቤት ኡባፈ ዎልቃማ ጎዳዉ፥</para>
  <para style="q2" vid="PSA 69:6">ነና ኡፋይሳን ናገይሳት</para>
  <para style="q2" vid="PSA 69:6">ታ ጋሶን ዬላቶፖ።</para>
  <para style="q1" vid="PSA 69:6">አቤት እስራኤለ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 69:6">ነና ምንድ ኮየይሳት</para>
  <para style="q2" vid="PSA 69:6">ታ ጋሶን ካዉዮፎ።<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>ታ ነ ግሾ ጫሸ ዳንዳአስ፤</para>
  <para style="q2" vid="PSA 69:7">ታ ሶምኦይ ዬላ ማእዳይ ነ ግሾሳ።<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>ታኒ ታ እሻታስ እማ፥</para>
  <para style="q2" vid="PSA 69:8">ታ አየ ናይታስ አላጋ ግዳስ።<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>ታኒ ነ ኬስ ምሸትያ ምሻይ</para>
  <para style="q2" vid="PSA 69:9">ታና ታማዳ ፁጌስ፤</para>
  <para style="q2" vid="PSA 69:9">ነና ጫይያ ጫሻይ ታ ቦላ ዎስ።<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>ታኒ ፆማን ታና ካዉሽዳ ዎደ፥</para>
  <para style="q2" vid="PSA 69:10">ታና ጫይዶሶና።<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>ታኒ ካዮ ማኦ ማእዳ ዎደ፥</para>
  <para style="q2" vid="PSA 69:11">ኤንታዉ ካሳስ አታስ።<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>ካታማ ፐንገን ኡተይሳታስ ዝግርሳስ አታስ፤</para>
  <para style="q2" vid="PSA 69:12">ማተይሳት ታባ የ ከስዶሶና።<verse eid="PSA 69:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>ሽን ጎዳዉ፥ ታ ነና ዎሳይስ፤</para>
  <para style="q2" vid="PSA 69:13">አቤት ፆሳዉ፥ ነ ዶስያ ዎደ፥</para>
  <para style="q2" vid="PSA 69:13">ነ መርና ሲቁዋን፥</para>
  <para style="q2" vid="PSA 69:13">ነ አቶተን ታዉ ዛሮ እማ።<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>ስልሞን ምተቶናዳ ታና አሻ፤</para>
  <para style="q2" vid="PSA 69:14">ታ ሞርከታፐ ታና አሻ፥</para>
  <para style="q2" vid="PSA 69:14">ጪሞ ሃን ምተተፈ ታና አሻ።<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>ድኦ ሃይ ታና ሙኮፎ፤</para>
  <para style="q2" vid="PSA 69:15">ጪሞ ሃይ ታና ምቶፎ፤</para>
  <para style="q2" vid="PSA 69:15">ዝቃ ኦላይ ባ ዶና ታ ቦላ ጎርዶፎ።<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>አቤት ጎዳዉ፥ ነ መርና ሲቁዋ ሎኦተን፥</para>
  <para style="q2" vid="PSA 69:16">ታዉ ዛሮ እማ፤</para>
  <para style="q2" vid="PSA 69:16">ነ ግታ ማሮታን ታኮ ስማ።<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>ነ አይልያፈ ነ ሶምኡዋ ገንፋ፤</para>
  <para style="q2" vid="PSA 69:17">ታኒ ኡንአን ደእያ ግሾ</para>
  <para style="q2" vid="PSA 69:17">ታዉ ኤለ ዛሮ እማ።<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>ታኮ ሺቃ፤ ታና ዎዛ፤</para>
  <para style="q2" vid="PSA 69:18">ታ ሞርከታፐ ታና ላአ ከሳ።<verse eid="PSA 69:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>ታ ጫሻ፥ ዬላነ</para>
  <para style="q2" vid="PSA 69:19">ካዉሻተ ነ ኤራሳ፤</para>
  <para style="q2" vid="PSA 69:19">ታ ሞርከታ ኡባ ነ በኣሳ።<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>ጫሻይ ታና ሀርጋንቾ ኦስ፤</para>
  <para style="q2" vid="PSA 69:20">ታዉ ቃትያ አስ ኮያስ።</para>
  <para style="q1" vid="PSA 69:20">ሽን እስ አስካ ደማብከ፤</para>
  <para style="q2" vid="PSA 69:20">ታና ምንያ አስ ፄላስ፤ ሽን በንትቤና።<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>ታ ካን ጪየ ዋላክዶሶና፤</para>
  <para style="q2" vid="PSA 69:21">ታ ሳሙዋስ ጫላ ኡሽ እምዶሶና።<verse eid="PSA 69:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>ኤንታ ጋይታይ ኤንታዉ ፅሄ ግዶ፤</para>
  <para style="q2" vid="PSA 69:22">ኤንታ ያርሾይ ኤንታዉ ፅሄ ግዶ።<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>ፄሎናዳ ኤንታ አይፈይ ጎዘቶ፤</para>
  <para style="q2" vid="PSA 69:23">ኤንታ ዞኮይ ኩኖ።<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>ነ ሀንቁዋ ኤንታ ቦላ ትጋ፤</para>
  <para style="q2" vid="PSA 69:24">ሱልያ ነ ሸነይ ኤንታ የደ።<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>ኤንታ ካምበይ ካይስ ግዶ፤</para>
  <para style="q2" vid="PSA 69:25">ኤንታ ዱንካንያን ደእያ አስ ዮ።<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>ነ ሴርዳይሳታ ኤንቲ የደዶሶና፤</para>
  <para style="q2" vid="PSA 69:26">ነ ማዱንፅስዳይሳታ ኤንቲ ዬሶሶና።<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>ኤንቲ ናጋራ ቦላ ናጋራ ጉጃና መላ አጋጋ፤</para>
  <para style="q2" vid="PSA 69:27">ነ ማሮተፈ ኤንታ አይብካ ጋኮፎ።<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>ኤንቲ ደኦ ማፃፋፐ ቁሸቶ፤</para>
  <para style="q2" vid="PSA 69:28">ፅሎ አሳራ ማዝጋበቶፎ።<verse eid="PSA 69:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>ታ ዋየንነ ኡንአን ደአይስ፤</para>
  <para style="q2" vid="PSA 69:29">አቤት ፆሳዉ፥ ታና አሻዳ፥</para>
  <para style="q2" vid="PSA 69:29">ሳሮ በሳን ዎ።<verse eid="PSA 69:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>ታኒ ፆሳ ሱን ማዝሙረን ጋላታና፤</para>
  <para style="q2" vid="PSA 69:30">ጋላታ እሞን እያ ግታያና።<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>ሄስ ቦራ ያርሾፈ፥</para>
  <para style="q2" vid="PSA 69:31">ዎይኮ ካጫማ ኮርማ ያርሾፈ፥</para>
  <para style="q2" vid="PSA 69:31">አድ፥ ጎዳ ኡፋይሴስ።<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>ናቀትዳይሳት ሄሳ በአና፤ ኡፋይታና፤</para>
  <para style="q2" vid="PSA 69:32">ህንተኖ፥ ፆሳ ኮየይሳቶ፥</para>
  <para style="q2" vid="PSA 69:32">ህንተ ዎዛናይ ምነቶ።<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>ጎዳይ ማንቆታ ስኤስ፤</para>
  <para style="q2" vid="PSA 69:33">ቃሾ ኬን ደእያ ባ አሳ ካና።<verse eid="PSA 69:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>ሳሎይ፥ ሳእነ አባይ፥</para>
  <para style="q2" vid="PSA 69:34">እያ ግዶን ደእያ ዎፅ ቃፅያ ኡባይ ጎዳ ጋላቶ።<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>ፆሳይ ፅዮነ አሻና፤</para>
  <para style="q2" vid="PSA 69:35">ይሁዳ ካታማ ዛሪድ ኬፃና፤</para>
  <para style="q2" vid="PSA 69:35">አሳይ ያን ዳናነ ቢታይካ ኤንታባ ግዳና።<verse eid="PSA 69:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36"/>እያ አይለታ ናይት ሄ ቢታ ላታና፤</para>
  <para style="q2" vid="PSA 69:36">እያ ሱን ዶሰይሳት ያን ዳና።<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="s1">ፆሳዉ ታና ማዳናዉ ጋምኦፋ</para>
  <para style="d">ዳዊታ ቆፍሶ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 70:1"/>አቤት ፆሳዉ ታና አሻናዉ ሃ ስማ፤</para>
  <para style="q2" vid="PSA 70:1">አቤት ጎዳዉ፥ ታና ማዳናዉ ኤለሳ።<verse eid="PSA 70:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>ታና ዎናዉ ኮየይሳት፥</para>
  <para style="q2" vid="PSA 70:2">ዬላቶናነ ሀንያባ ዮ።</para>
  <para style="q1" vid="PSA 70:2">ታ ቆሄተ አሞተይሳት፥</para>
  <para style="q2" vid="PSA 70:2">ካዉይድ ጉየ ስሞ።<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>ታኮ እያዉ “ሀሹ! ሀሹ!”</para>
  <para style="q2" vid="PSA 70:3">ግዳይሳት ፆነትዳ ግሾ ዬላቶ።<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>ነና ኮይያ ኡባይ</para>
  <para style="q2" vid="PSA 70:4">ነናን ኡፋይቶነ ማላለቶ።</para>
  <para style="q1" vid="PSA 70:4">ቃስ ነ አቶተ ዶስያ ኡባይ፥</para>
  <para style="q2" vid="PSA 70:4">“ፆሳይ ግታቶ” ያጎ።<verse eid="PSA 70:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>ታኒ ማንቆነ መቶታንቾ፤</para>
  <para style="q2" vid="PSA 70:5">አቤት ፆሳዉ፥ ኤለሳዳ ታኮ ሃያ።</para>
  <para style="q1" vid="PSA 70:5">ታ ማደይነ ታና አሸይ ነና ግድያ ግሾ፤</para>
  <para style="q2" vid="PSA 70:5">አቤት ጎዳዉ፥ ጋምኦፋ።<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="s1">ታኒ ዳቡርያ ዎደ ታና አጎፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 71:1"/>ጎዳዉ፥ ታኒ ኔኮ ባቃታዳ አትያ ግሾ፥</para>
  <para style="q2" vid="PSA 71:1">አዉደካ ታና ዬላዮፓ።<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>ነ ፅሎተን ታና ናጋ፤</para>
  <para style="q2" vid="PSA 71:2">ነ ሀይ ታኮ ዛራ፤ ታና አሻ።<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>ኔኒ ታ ኡባ ዎደ ጌማዳ አትያ ዛላ</para>
  <para style="q2" vid="PSA 71:3">ታኒ ጌማዳ አታና መላ ምኖ ሚፃ ግዳ፤</para>
  <para style="q2" vid="PSA 71:3">ኤ፥ ኔኒ ታ ዛላነ ታ ሚፃ።<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>ታ ፆሳዉ፥ ኢታታ ኩሸፐነ፥</para>
  <para style="q2" vid="PSA 71:4">ቃይ ባይና አሳታፐ ታና አሻ።<verse eid="PSA 71:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>አቤት ጎዳዉ፥ ታ ናአተፈ ዶማዳ፥</para>
  <para style="q2" vid="PSA 71:5">ኔኒ ታ ኡፋይሳነ ታ አማነተ።<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>ታ የለትዳ ዎደፐ ዶማዳ ነናን ዘምፓስ፤</para>
  <para style="q2" vid="PSA 71:6">ታ አየ ኡሎፐ ታና ከስዳይ ነና፤</para>
  <para style="q2" vid="PSA 71:6">ታኒ ኡባ ዎደ ነና ጋላታና።<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>ኔኒ ታ ቆሰታዳ አትያ በሲ ግድዳ ግሾ፥</para>
  <para style="q2" vid="PSA 71:7">ታ ደኦይ ዳሮ አሳስ ሌምሶ ግድስ።<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>ጋላሳ ኡባን ታ ዶናይ</para>
  <para style="q2" vid="PSA 71:8">ነ ጋላታንነ ነ ቦንቹዋን ኩምስ።<verse eid="PSA 71:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>ታኒ ጭምዳ ዎደ ታና የጎፋ፤</para>
  <para style="q2" vid="PSA 71:9">ታ ዎልቃይ እፅዳ ዎደ ታና አጎፋ።<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>ታ ሞርከት ታ ቦላ ቶቦሶና፤</para>
  <para style="q2" vid="PSA 71:10">ታና ዎናዉ ኮየይሳት ታ ቦላ ማቀቶሶና።<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>ኤንቲ፥ “ፆሳይ እያ አግስ፤ የደድ ኦይኮስ፤</para>
  <para style="q2" vid="PSA 71:11">እያ አሻናይ ኦንካ ባዋ” ያጎሶና።<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>ፆሳዉ፥ ታፐ ሃኮፋ</para>
  <para style="q2" vid="PSA 71:12">ታ ፆሳዉ፥ ታና ማዳናዉ ኤለሳ።<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>ታና ሞተይሳት ዬላትድ ዮ፤</para>
  <para style="q2" vid="PSA 71:13">ታና ቆሀናዉ ኮየይሳት፥</para>
  <para style="q2" vid="PSA 71:13">ዬላነ ካዉሸ ማኦ።<verse eid="PSA 71:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>ሽን ታኒ ኡባ ዎደ ኡፋይሳን ነና ናጋና፤</para>
  <para style="q2" vid="PSA 71:14">ዛራ ዛራዳካ ነና ጋላታና።<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>ነ ኦዳባ ታ ታይባናዉ ፆነትኮካ፥</para>
  <para style="q2" vid="PSA 71:15">ታ ዶናይ ጋላስ ኡባን ነ ፅሎተነ</para>
  <para style="q2" vid="PSA 71:15">ነ አቶተባ ኦዳና።<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>ታኒ ኡባ ሃርያ ጎዳ ዎልቃን ያዳ፤</para>
  <para style="q2" vid="PSA 71:16">ነ ፃላላ ፅሎ ግደይሳ አዋጃና።<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>ፆሳዉ፥ ኔኒ ታ ናአተፈ ዶማዳ ታና ታማርሳዳሳ፤</para>
  <para style="q2" vid="PSA 71:17">ሀእካ ነ ማላልስያ ኦሱዋ ታ ኦዳና።<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>ፆሳዉ ነ ዎልቃነ ነ ምኖተን</para>
  <para style="q2" vid="PSA 71:18">ያ የለታ ኡባስ ኦዳና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 71:18">ታኒ ጭማዳ ፑሉምኮካ ታና አጎፋ።<verse eid="PSA 71:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>ፆሳዉ፥ ነ ፅሎተይ ሳሎ ጋክስ፤</para>
  <para style="q2" vid="PSA 71:19">ግታባ ኦዳ ፆሲ፥ ነ መል ኦኔ?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>ኔኒ ታ ቦላ ዳሮ መቶ ኤሀዳሳ፤</para>
  <para style="q2" vid="PSA 71:20">ግዶሽን ታ ደኡዋ ዛራዳ ኦራፅሳዳሳ፤</para>
  <para style="q2" vid="PSA 71:20">ኔኒ ታና ቢታ ጋርሳፈ ከሳዳሳ።<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>ኔኒ ታ ቦንቹዋ ዳርሳዳሳ፤</para>
  <para style="q2" vid="PSA 71:21">ታና ዛራዳ ምንዳሳ።<verse eid="PSA 71:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>ታ ፆሳዉ፥ ነ ቱማተ ግሾ፥</para>
  <para style="q2" vid="PSA 71:22">ታ ነና ዲን ጋላታና።</para>
  <para style="q1" vid="PSA 71:22">አቤት እስራኤለ ጌሻዉ፥</para>
  <para style="q2" vid="PSA 71:22">ታ ነና ማስንቆን ሳባና።<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>ታ መተርሻይ ኡፋይሳን ቁ ኦድ የፄስ፤</para>
  <para style="q2" vid="PSA 71:23">ኔኒ ታና አሽዳ ግሾ ታኒ ነና ሳባና።<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>ታና ቆሀናዉ ኮየይሳት ዬላትዳ ግሾነ</para>
  <para style="q2" vid="PSA 71:24">ካዉይዳ ግሾ ታ እንፃርሳይ ነ ፅሎ ማዱዋባ</para>
  <para style="q2" vid="PSA 71:24">ጋላስ ኡባን ኦዳና።<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="s1">ኡፋይሳን ናገትያ ካዋ</para>
  <para style="d">ሶሎሞነ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 72:1"/>ፆሳዉ፥ ነ ሱረ ፕርዳ ካዋስ፥</para>
  <para style="q2" vid="PSA 72:1">ነ ፅሎተ ካዋ ናኣስ እማ።<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>እ ነ አሳስ ፅሎተን ፕርዳና፤</para>
  <para style="q2" vid="PSA 72:2">ቆሄትዳይሳታስ ሱረን ዳይናታና።<verse eid="PSA 72:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>ደረት ዱረተ፥</para>
  <para style="q2" vid="PSA 72:3">ዙማት ፅሎተ አይፈ ነ አሳስ አይፎ።<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>ካዎይ ቆሄትዳይሳታ ግሾ ሞተቶ፤</para>
  <para style="q2" vid="PSA 72:4">ማንቆታ አሾ፤ ኡንኤይሳታ መን።<verse eid="PSA 72:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>ፆሳዉ፥ እ አዋዳነ አጌናዳ ደኦ፤</para>
  <para style="q2" vid="PSA 72:5">የለተፈ የለተ ጋካናዉ ደኦ።<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>ካዎይ ጎሻን ቡክያ እራ መላነ</para>
  <para style="q2" vid="PSA 72:6">ቢታ ካልስያ ፑሰ እራ መላ ግዶ።<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>እያ ላይ ኡባን ፅሎ አሳት ዳዮ፤</para>
  <para style="q2" vid="PSA 72:7">አጌን ያና ጋካናዉ ሳሮተ ዳሮ።<verse eid="PSA 72:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>አባፈ አባ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 72:8">ኤፍራፂሳ ሻፋፐ ሳኣ ጋፃ ጋካናዉ እ ሃሮ።<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>ባዞን ደእያ አሳት እያ ጎይኖ፤</para>
  <para style="q2" vid="PSA 72:9">እያ ሞርከት ባና ላጮ።<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>ታርሰሳነ ዩሾይ አባን ተቀትዳ ቢታታ፥</para>
  <para style="q2" vid="PSA 72:10">ካዎት እያዉ ጊራ ጊሮ፤</para>
  <para style="q2" vid="PSA 72:10">አራበነ ቶጰ ካዎት እያዉ እሞታ ኤሆ።<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>ካዎት ኡባይ እያዉ ጉልባቶ፤</para>
  <para style="q2" vid="PSA 72:11">ካዎተት ኡባይ እያዉ ኪተቶ።<verse eid="PSA 72:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>እያኮ ዋስያ ማንቆታ፥ ቆሄትዳይሳታነ</para>
  <para style="q2" vid="PSA 72:12">ማዶይ ባይናይሳታ እ አሻና።<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>ማንቆታስነ ዳቡራንቾታስ እ ቃቴስ፤</para>
  <para style="q2" vid="PSA 72:13">ማንቆታ ሸምፑዋ ሀይቆፐ አሼስ።<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>ኤንታ ሱይ እያ ስንን አልኦ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 72:14">እ፥ ኤንታ ቆሆፐነ ኢታፐ ዎዛና።<verse eid="PSA 72:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>ካዎይ ዳሮ ላይ ጋምኦ፤</para>
  <para style="q2" vid="PSA 72:15">አራበ ቢታ ዎርቃይ እያዉ ዮ።</para>
  <para style="q1" vid="PSA 72:15">አሳይ እያ ግሾ ኡባ ዎደ ዎሶ፤</para>
  <para style="q2" vid="PSA 72:15">ጋላስ ኡባን እ አንጀቶ።<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>ቢታን ካ ፓላሆ፤</para>
  <para style="q2" vid="PSA 72:16">ደረት ካን ካመቶ።</para>
  <para style="q1" vid="PSA 72:16">ልባኖሰ ደርያ ቦላ ካ አይፍያዳ አይፎ፤</para>
  <para style="q2" vid="PSA 72:16">ደንብ ማታን ኩምያዳ አሳይ ካታማ ኩሞ።<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>ካዋ ሱንይ መርናዉ ደኦ፤</para>
  <para style="q2" vid="PSA 72:17">አዋዳ ኡባ ዎደ ፄገትሸ ጋምኦ።</para>
  <para style="q1" vid="PSA 72:17">አሳ ኡባይ እያ ባጋራ አንጀታና፤</para>
  <para style="q2" vid="PSA 72:17">ካዎተት እያ “አንጀትዳይሳ” ያጋና።<verse eid="PSA 72:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>ማላልስያባ ባርካ ኦያ ጎዳይ፥ ፆሳይ</para>
  <para style="q2" vid="PSA 72:18">እስራኤለ ፆሳይ ጋላተቶ።<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>እያ ቦንቾ ሱንይ መርናዉ ጋላተቶ፤</para>
  <para style="q2" vid="PSA 72:19">እያ ቦንቾይ ሳአ ኡባ ኩሞ።</para>
  <para style="b" vid="PSA 72:19"/>
  <para style="qc" vid="PSA 72:19">አምንእ! አምንእ!<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>እሰየ ናኣ ዳዊታ ዎሳይ ሀይሳን ፖለትስ።<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">ሄን ማፃፋ</para>
  <para style="mr">(<ref loc="PSA 73-89">ማዝ 73—89</ref>)</para>
  <para style="s1">ፆሳይ ታዉ ምኖተነ ግሾ</para>
  <para style="d">አሳፋ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 73:1"/>ቱማ ፆሳይ እስራኤለስ ሎኦ፤</para>
  <para style="q2" vid="PSA 73:1">ዎዛና ጌሻታስ እ ኬሀ።<verse eid="PSA 73:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>ሽን ታ ቶሆይ በታናዉ ጉ አትስ፤</para>
  <para style="q2" vid="PSA 73:2">ታ ታንጎይ ሀልፃናዉ ማትስ።<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>ሄስ ሀንዳይ ኢታ አሳትነ ኦቶራንቾት፥</para>
  <para style="q2" vid="PSA 73:3">ዱረትሽን ታኒ በአዳ ቃናትዳ ግሾሳ።<verse eid="PSA 73:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>ኤንታ ዋየይ ጋኮና ግሾ፥</para>
  <para style="q2" vid="PSA 73:4">ኤንታ አሳተይ ፓያነ ምኖ።<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>ኤንቲ ሀራ አሳዳ ዋየቶኮና፤</para>
  <para style="q2" vid="PSA 73:5">ሀራ አሳዳ መቶን ሾጨቶኮና።<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>ሄሳ ግሾ፥ ኦቶሮይ ኤንታዉ ቆ አሌቆ መላ፤</para>
  <para style="q2" vid="PSA 73:6">ቡቀ አፍላዳ ማእዶሶና።<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>ኤንታ ዎዛናይ ኢታባ ፑልቴስ፤</para>
  <para style="q2" vid="PSA 73:7">ኤንታ ቆፋይ ኢታ ሀልቾን ኩምስ።<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>ኤንቲ ቀልቅሶሶና፤ ኢታባ ሃሳዮሶና፤</para>
  <para style="q2" vid="PSA 73:8">ባንታ ኦቶሩዋን ሀራታ ኡንኤሶና።<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>ባንታ ዶና ፆሳ ቦላ ዶዮሶና፤</para>
  <para style="q2" vid="PSA 73:9">ባንታ እንፃርሳ አሳ ቦላ አዱሶሶና።<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>ሀር አቶሽን፥ ፆሳ አሳይ ኤንታኮ ስማና፤</para>
  <para style="q2" vid="PSA 73:10">ኤንቲ ኦድያባ ኤሶን አማናና።<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>ኤንቲ፥ “ፆሲ አይኮ ኤሪ?</para>
  <para style="q2" vid="PSA 73:11">ኡባፈ ቃ ፆሳስ ኤራተ ደኢ?” ያጎሶና።<verse eid="PSA 73:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>ህዛ ኢታት ሀይሳ መላ፤</para>
  <para style="q2" vid="PSA 73:12">ኡባ ዎደ እንጀትን ደኦሶና፤</para>
  <para style="q2" vid="PSA 73:12">ኤንቲ ጉጅ ጉጅ ዱረቶሶና።<verse eid="PSA 73:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>ህዛ ታኒ ታ ዎዛና ጌሻተን ናግዳይ፥</para>
  <para style="q2" vid="PSA 73:13">ፅሎተ በሳናዉ ታ ኩሽያ ሜጨትዳይ መላ።<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>ጋላሳ ኩመ ታኒ መቶን ሾጨታስ፤</para>
  <para style="q2" vid="PSA 73:14">ዎንታ ዎንታ ሴረታስ።<verse eid="PSA 73:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>ታኒ ኢታ አሳታዳ ኦደትዳኮ፥</para>
  <para style="q2" vid="PSA 73:15">ነ አሳስ አማነቶና አታናሽን።<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>ታኒ ሀ ኡባ ኤራናዉ ቆፕያ ዎደ፥</para>
  <para style="q2" vid="PSA 73:16">ታዉ ዴፆ ግድስ።<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>ሄስካ ታኒ ፆሳ ኬ ገላና ጋካናዉነ</para>
  <para style="q2" vid="PSA 73:17">ኢታ አሳታ ዉርሰ ቃዳ አኬካና ጋካናሳ።<verse eid="PSA 73:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>ቱማ ኔኒ ኤንታ ሀልፅያ በሳን ኡትሳዳሳ፤</para>
  <para style="q2" vid="PSA 73:18">ኤንቲ ኩንድድ ያና መላ ኦሳ።<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>ኤንቲ ኤለስድ ይዶሶና፤</para>
  <para style="q2" vid="PSA 73:19">ዳጋማን እሶይ አቶና ዉርዶሶና።<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>አሙሆይ ባርክያ ዎደ ባለተይሳዳ፥</para>
  <para style="q2" vid="PSA 73:20">አቤት ጎዳዉ፥ ኔኒ ደንድያ ዎደ፥</para>
  <para style="q2" vid="PSA 73:20">ኤንቲ ዶገታና።<verse eid="PSA 73:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>ታኒ ይሎትዳ ዎደነ</para>
  <para style="q2" vid="PSA 73:21">ታ ዎዛናን ጫመትዳ ዎደ፥<verse eid="PSA 73:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 73:22"/>አኬኮና ኤያ አስ ግዳስ፤</para>
  <para style="q2" vid="PSA 73:22">ነ ስንን መሄ ግዳስ።<verse eid="PSA 73:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>ሽን ታኒ ኡባ ዎደ ኔራ ደአይስ፤</para>
  <para style="q2" vid="PSA 73:23">ታ ኡሻቻ ኩሽያ ኔኒ ኦይካዳሳ።<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>ነ ዞርያን ታና ካለሳ፤</para>
  <para style="q2" vid="PSA 73:24">ዉርሰን ታና ቦንቾን ኤካሳ።<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>ታዉ ሳሎን ኔፐ አትሽን፥ ሀር ኦን ደኢ?</para>
  <para style="q2" vid="PSA 73:25">ታኒ ኔፐ አትሽን፥ ሳአን ሀራ አሞትከ።<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>ታ ዎልቃይነ ታ ዎዛናይ ዳቡራናዉ ዳንዳኤስ፤</para>
  <para style="q2" vid="PSA 73:26">ሽን ፆሳይ ታ ዎዛና ምኖተነ</para>
  <para style="q2" vid="PSA 73:26">መርናዉ ታና ጋክዳ ሳማ።<verse eid="PSA 73:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>ኔፐ ሃከይሳት ያና፤</para>
  <para style="q2" vid="PSA 73:27">ነና ካደይሳታ ኡባ ነ ዉርሳና።<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>ሽን ታዉ ፆሳኮ ሺቆይ ሎኦ፤</para>
  <para style="q2" vid="PSA 73:28">እያ ኦሶ ኡባ ታኒ ኦዳና መላ፥</para>
  <para style="q2" vid="PSA 73:28">ኡባ ሃርያ ጎዳ ቆሰትድ አትያ በሰ ኦስ።<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="s1">ፆሳዉ ነ ግሾ ሞተታ</para>
  <para style="d">አሳፋ ትምርተ</para>
  <para style="d">አኬካን ፃፍዳ ግንፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 74:1"/>ፆሳዉ ኔኒ ኑና አይስ መርናዉ አጋዲ?</para>
  <para style="q2" vid="PSA 74:1">ነ ቆሩዋን ደእያ ነ ዶርሳታ ቦላ</para>
  <para style="q2" vid="PSA 74:1">ነ ሀንቆይ አይስ ኤፅዴ?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>ኔኒ በን ዶርዳ አሳ፥</para>
  <para style="q2" vid="PSA 74:2">ነዉ ቡዞ ኦዳ ዎዝዳ ኮቻታ ሀሳያ፤</para>
  <para style="q2" vid="PSA 74:2">ኔኒ ደእዳ ፅዮነ ዙማ ቆፓ።<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>ላለትዳ ነ ኬ ያዳ ፄላ፤</para>
  <para style="q2" vid="PSA 74:3">ሞርከት ያን ደእያባ ኡባ ይስዶሶና።<verse eid="PSA 74:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>ነ ሞርከት ነ ኬን፥</para>
  <para style="q2" vid="PSA 74:4">“ኑ ፆንዳ” ያግድ ገሬርዶሶና።</para>
  <para style="q2" vid="PSA 74:4">ፆኖ ማላታ ግድዳ ባንታ ባንድራ ኤስዶሶና።<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>ኤንቲ ም ቃንፃናዉ ዎራ ግዶን ኤቅድ፥</para>
  <para style="q2" vid="PSA 74:5">ባንታ ካልታ ደንዳ አሳታ ዳኖሶና።<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>ኤንቲ ኩሸ ሂላን አሌቅዳ ኦሶታ ኡባ፥</para>
  <para style="q2" vid="PSA 74:6">ባንታ ካልታንነ ናርቃን መንረዶሶና።<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>ነ ኬ ታማን ፁግድ ይስዶሶና፤</para>
  <para style="q2" vid="PSA 74:7">ነ ሱንይ ፄገትያ በሳ ቱንስዶሶና።<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>ባንታ ዎዛናን፥ “ኑ ኩመ ይሳና” ያግዶሶና፤</para>
  <para style="q2" vid="PSA 74:8">ቢታን ደእያ አስ ፆሰ ጎይንያ በሳታ</para>
  <para style="q2" vid="PSA 74:8">ታማን ፁግዶሶና።<verse eid="PSA 74:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>ሄ ዎደ ማላት ኑስ እመተና፤</para>
  <para style="q2" vid="PSA 74:9">ናበይካ ዴና።</para>
  <para style="q1" vid="PSA 74:9">ሄስ አዉደ ጋካናዉ ጋምአነኮ፥</para>
  <para style="q2" vid="PSA 74:9">ኤርያ አስ ኑ ግዶን ባዋ።<verse eid="PSA 74:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>ፆሳዉ፥ ነ ሞርከት አዉደ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 74:10">ነ ቦላ ቀልቅሳኔ?</para>
  <para style="q2" vid="PSA 74:10">ኤንቲ ነ ሱን መርናዉ ጫያኔ?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>ነ ኡሻቻ ኩሽያ አይስ ሺሻ ኤካይ?</para>
  <para style="q2" vid="PSA 74:11">ነ ኡሻቻ ኩሽያ ነ አፍላ ግዶፈ</para>
  <para style="q2" vid="PSA 74:11">ከሳዳ ኤንታ ይሳ።<verse eid="PSA 74:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>ግዶሽን፥ አቤት ፆሳዉ፥</para>
  <para style="q2" vid="PSA 74:12">ኔኒ በንፐ ታ ካዋ፤</para>
  <para style="q2" vid="PSA 74:12">ነ ዳሮ ዎደ አሻዳሳ።<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>ነ ግታ ዎልቃን አባ ሻካዳሳ፤</para>
  <para style="q2" vid="PSA 74:13">እያ ግዶን ደእያ ዶኣ ሁጰታ ዶንጫዳሳ።<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>ሌዋታነ ጌተትያ ዳውያ ሁጰታ ዶንጫዳ፥</para>
  <para style="q2" vid="PSA 74:14">እያ አሹዋ ባዞን ደእያ መተታስ</para>
  <para style="q2" vid="PSA 74:14">ካ ኦዳ እምዳይ ነና።<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>ኔኒ ፑልቶታ ዶያ የዳዳሳ፤</para>
  <para style="q2" vid="PSA 74:15">ኡባ ዎደ ጎግያ ሻፋታ መልሳዳሳ።<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>ጋላሳይ ነባ፤ ቃማይካ ነባ፤</para>
  <para style="q2" vid="PSA 74:16">አዋነ አጌና ኤንታ በሳን ዎዳይ ነና።<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>ቢታስ ዛዋ ዎዳይ፥</para>
  <para style="q2" vid="PSA 74:17">ባልጎነ ቦነ መዳይ ነና።<verse eid="PSA 74:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>አቤት ጎዳዉ፥ ነ ሞርከት ነና ዋት ቀልቅስዳኮ፥</para>
  <para style="q2" vid="PSA 74:18">ኤያ አሳት ነ ሱን ዋት ጫይዳኮ ሀሳያ።<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>ነ ሆልያ ሸምፑዋ ዶኣስ አዳ እሞፋ፤</para>
  <para style="q2" vid="PSA 74:19">መቶታንቾታ መርናዉ ዶጎፓ።<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>ኑ ቢታን ደእያ ማ በሲ ኡባይ</para>
  <para style="q2" vid="PSA 74:20">ማካላንቾታን ኩምዳ ግሾ፥</para>
  <para style="q2" vid="PSA 74:20">ነ ኑስ ጫቅዳ ጫቁዋ ቆፓ።<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>ቆሄትዳይሳታ ዬላዮፓ፤</para>
  <para style="q2" vid="PSA 74:21">ማንቆትነ መቶታንቾት ነ ሱን ጋላቶ።<verse eid="PSA 74:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>አቤት ፆሳዉ፥ ደንዳ፤ ሞተታ፤</para>
  <para style="q2" vid="PSA 74:22">ጋላስ ኩመ ኤያት ነና ቀልቅሰይሳ ሀሳያ።<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>ነ ሞርከት ነ ቦላ ዋስያ ዋሱዋነ</para>
  <para style="q2" vid="PSA 74:23">ነና እፀይሳት ጬቀትያ ጬቁዋ አኬካ።<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="s1">ፆሳይ ሱረ ፕርዳና</para>
  <para style="d">አሳፍ ዛማረታ ሀላቃስ፥ “ይሶፋ” ጌተትያ ዲ ጩን የፅዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 75:1"/>አቤት ፆሳዉ፥ ነዉ ጋላታ እሞስ፤</para>
  <para style="q2" vid="PSA 75:1">ነ ሱንይ ማታ ግድያ ግሾ ነና ጋላቶስ፤</para>
  <para style="q2" vid="PSA 75:1">አሳይ ነ ማላልስያ ኦሱዋ ኦዶሶና።<verse eid="PSA 75:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>ፆሳይ ሀይሳዳ ያጌስ፤</para>
  <para style="q2" vid="PSA 75:2">“ታኒ ፕርዳ እምያ ዎደ ዶራስ፤</para>
  <para style="q2" vid="PSA 75:2">ሱረ ፕርደይ ታና።<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>ቢታይነ እያን ደእያ ኡባይ ቃፅኮካ፥</para>
  <para style="q2" vid="PSA 75:3">እያ ቱሳ ምን ኤሰይ ታና። <char style="qs">ሳላሀ </char><verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>ታኒ ኦቶራንቾታ፥ ‘ኦቶርቶፍተ’፤</para>
  <para style="q2" vid="PSA 75:4">ኢታታ፥ ‘ህንተ ካጭያ በሶፍተ።’<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>‘ህንተ ካጭያ ሳሎ ደንፍተ፤</para>
  <para style="q2" vid="PSA 75:5">ቆ ቃድ ሃሳዮፕተ’ ” ያጋና።<verse eid="PSA 75:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>ቦንቾይ ዶሎሀፐ ዎይኮ ዉሎሀፐ</para>
  <para style="q2" vid="PSA 75:6">ዎይኮ መላ ቢታፈ ዬና።<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>ሽን ሱረ ፕርደይ ፆሳ፤</para>
  <para style="q2" vid="PSA 75:7">እ እሱዋ ቦላ ፕርዴስ፤ ሀንኩዋ ሻትንስ።<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>ፆሳ ኩሸን እስ ዋንጭ ደኤስ፤</para>
  <para style="q2" vid="PSA 75:8">ሄ ዋንጫይ ፆሳ ሀንቆ</para>
  <para style="q2" vid="PSA 75:8">ዎይነ ኡሻን ኩምድ ኡትስ።</para>
  <para style="q1" vid="PSA 75:8">እ ሄ ኡሻፈ ትግን፥</para>
  <para style="q2" vid="PSA 75:8">ሳአን ደእያ ኢታ አሳት ሄሳ ኡያና፤</para>
  <para style="q2" vid="PSA 75:8">ኤንቲ ኦርጩዋ አሾና ፂጵድ ኡያና።<verse eid="PSA 75:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>ሽን ታኒ ያይቆባ ፆሳባ ኦዳና፤</para>
  <para style="q2" vid="PSA 75:9">እያ መርናዉ ሳባና።<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>እ፥ ኢታ አሳታ ካጭያ መንና፤</para>
  <para style="q2" vid="PSA 75:10">ሽን ፅሎታ ካጨይ ቁ ቁ ጋና።<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="s1">ፆሳ ስንን ኤቃናይ ኦኔ?</para>
  <para style="d">አሳፍ ዛማረታ ሀላቃስ ዲን የፅዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 76:1"/>ፆሳይ ይሁዳን ኤረትስ፤</para>
  <para style="q2" vid="PSA 76:1">እያ ሱንይ እስራኤለን ግታ።<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>እያ ዱንካነይ ሳለማና፤</para>
  <para style="q2" vid="PSA 76:2">እ ደእያ በሳይ ፅዮነና።<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>ያን ፆንገትያ ሞርከ ዶንግያ፥</para>
  <para style="q2" vid="PSA 76:3">ጎንዳለ፥ ማሸነ ኦላ ሚሸታ መንረስ። <char style="qs">ሳላሀ </char><verse eid="PSA 76:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>አቤት ፆሳዉ፥ ነ ቦንቾይ አይ መላ ግተ!</para>
  <para style="q2" vid="PSA 76:4">ኔኒ ነ ሞርከታ ፆናዳ ዙማፐ ስምያ ዎደ፥</para>
  <para style="q2" vid="PSA 76:4">ነ ቴማይ አይ መላ ያሽ!<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>ጎባ ቶራንቾት ቦንቀትዶሶና፤</para>
  <para style="q2" vid="PSA 76:5">ኤንቲ ዎልቃማ ስኮ ስክዶሶና፤</para>
  <para style="q2" vid="PSA 76:5">ኤንታፈ እሶይካ ባ ኩሽያ ደንቤና።<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>አቤት ያይቆባ ፆሳዉ፥ ነ ሴርዳ ዎደ፥</para>
  <para style="q2" vid="PSA 76:6">ፓራ አሳትነ ፓራት ኩንድድ አትዶሶና።<verse eid="PSA 76:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>ሽን አቤት ፆሳዉ፥ ኔኒ ያሻሳ፤</para>
  <para style="q2" vid="PSA 76:7">ነ ሀንቆይ ሱልያ ዎደ፥</para>
  <para style="q2" vid="PSA 76:7">ነ ስንን ኦነ ኤቃናይ?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>ኔኒ ፕርዳ ሳሎፐ ስስዳ ዎደ፥</para>
  <para style="q2" vid="PSA 76:8">ቢታይ ዳጋማን ስእ ግስ።<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>ኔኒ ቢታን ቆሄትዳ አሳ አሻናዉነ</para>
  <para style="q2" vid="PSA 76:9">ኤንታዉ ፕርዳናዉ ደንድያ ዎደ ሄስ ሀንስ። <char style="qs">ሳላሀ </char><verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>ነ አሰ ሀንቅኮካ ነዉ ቦንቾ ግዴስ፤</para>
  <para style="q2" vid="PSA 76:10">ኦላፐ አትዳ አሳት ነ ባኣለ ቦንቻና።<verse eid="PSA 76:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>ጎዳስ ህንተ ፆሳስ ቃንገ ጋተ፤</para>
  <para style="q2" vid="PSA 76:11">ህንተኖ እያ ማታን ደእያ ካዎተቶ፥</para>
  <para style="q2" vid="PSA 76:11">ያሽያ እያዉ እሞታ ኤህተ።<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>እ ሀላቃታ አያና ካዉሼስ፤</para>
  <para style="q2" vid="PSA 76:12">ዎልቃማ ካዎታካ ዳጋንስ።<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="s1">ታኒ መቶ ዎደ ፆሰ ኮያስ</para>
  <para style="d">አሳፍ ዛማረታ ሀላቃ ኤዶታመስ ፃፍዳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 77:1"/>ታኒ ፆሳ ማጋናይስ፤</para>
  <para style="q2" vid="PSA 77:1">ታና ስአ ጋዳ እያኮ ዋሳይስ።<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>ታ መቱዋ ጋላሳን ጎዳ ኮያስ፤</para>
  <para style="q2" vid="PSA 77:2">ቃማ ኩመ ሸምፖይ ባይና ታ ኩሽያ ምጫስ፤</para>
  <para style="q2" vid="PSA 77:2">ግዶሽን፥ ታ ሸምፕያ ምናናዉ ዳንዳአቡኩ።<verse eid="PSA 77:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>ታኒ ፆሳባ ቆፕያ ዎደ ኦላይስ፤</para>
  <para style="q2" vid="PSA 77:3">ታኒ ዎ ደንዳ ዎደ ታ ሸምፖይ ዳቡሬስ። <char style="qs">ሳላሀ </char><verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>ቃማ ኩመ ታና ስኮ ድጋዳ አይሳዳሳ፤</para>
  <para style="q2" vid="PSA 77:4">ታ ኡንኤትዳ ግሾ ኦደታናዉ ዳንዳአብከ።<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>ታኒ አዳ ጋላሳታ ቆፓስ፤</para>
  <para style="q2" vid="PSA 77:5">ካሰ ላይታ ሀሳያስ።<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>ታኒ ቃማ ግታ ቆፋን አቃስ፤</para>
  <para style="q2" vid="PSA 77:6">ታ ዎዛናን ዎ ደንሸ፥</para>
  <para style="q2" vid="PSA 77:6">ሀይሳዳ ያጋዳ ታና ኦይቻስ፤<verse eid="PSA 77:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“ፆሳይ ኑና መርናዉ አግደዬ?</para>
  <para style="q2" vid="PSA 77:7">ህዛፐ ጉየ እ ኑስ ኬሄነዬ?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>እያ ሲቆይ አትደዬ?</para>
  <para style="q2" vid="PSA 77:8">እ ኦድዳ ቃላ መርናዉ ፖለነዬ?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>ፆሳይ ባ ማሮታ ዶግደዬ?</para>
  <para style="q2" vid="PSA 77:9">ባ ቃያ ሀንቆን ላምደዬ?” ያጋዳ ኦይቻስ። <char style="qs">ሳላሀ </char><verse eid="PSA 77:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>ኡባፈ ቃ ፆሳዉ፥ ታና ኡንኤዳይ፥</para>
  <para style="q2" vid="PSA 77:10">ነ ኡሻቻ ኩሽያን ኑና ማዶ አግዳይሳ።<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>ጎዳ ኦሶታ ታኒ ቆፓና፤</para>
  <para style="q2" vid="PSA 77:11">እ በን ኦዳ ማላልስያ ኦሶታ ሀሳያና።<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>ነ ኦሶታ ታኒ ዛራ ዛራዳ ቆፓና፤</para>
  <para style="q2" vid="PSA 77:12">ነ ዎልቃማ ኦሶታ ታኒ ዎ ደንና።<verse eid="PSA 77:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>አቤት ፆሳዉ፥ ነ ኦገይ ጌሽ፤</para>
  <para style="q2" vid="PSA 77:13">ነ መላ ግታ ፆሲ ኦኔ?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>ኔኒ ማላልስያባ ኦያ ፆሳ፤</para>
  <para style="q2" vid="PSA 77:14">አሳ ግዶን ነ ዎልቃ ቆንጭሳሳ።<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>ነ አሳ፥ ያይቆባነ ዮሰፋ ኮቻ</para>
  <para style="q2" vid="PSA 77:15">ነ ቀስያን ዎዛዳሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 77:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>አቤት ፆሳዉ፥ ሃት ነና በእድ ያይዶሶና፤</para>
  <para style="q2" vid="PSA 77:16">አባ ጪሞትካ ኮኮርዶሶና።<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>ሻራት ሃ ዱገ ትግዶሶና፤</para>
  <para style="q2" vid="PSA 77:17">ዳዳይ ሳሎን ጉምስ፤</para>
  <para style="q2" vid="PSA 77:17">ነ ዎልአንይ ያን ሀን ዎልአምስ።<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>ነ ዳዳ ጉንይ ኡሹዋ ግዶን ጉምስ፤</para>
  <para style="q2" vid="PSA 77:18">ነ ዎልአንይ ሳኣ ፖእስስ፤</para>
  <para style="q2" vid="PSA 77:18">ቢታይ ቃፅስ፤ ኮኮርስ።<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>ኔኒ አባ ግዶራ ሄመታሳ፤</para>
  <para style="q2" vid="PSA 77:19">ጪሞ አባ ግዶራ ካንሳ፤</para>
  <para style="q2" vid="PSA 77:19">ሽን ነ ቶሆይ የዳ በሳይ በንተና።<verse eid="PSA 77:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>ሙሰ ኩሸንነ አሮና ኩሸን</para>
  <para style="q2" vid="PSA 77:20">ነ አሳ ዶርሳ ዉደዳ ካለዳሳ።<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="s1">ካልያ የለተስ ኦዳ</para>
  <para style="d">አሳፍ አኬካን ፃፍዳ ግንፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 78:1"/>ታ አሳዉ፥ ታ ትምርትያ ስእተ፤</para>
  <para style="q2" vid="PSA 78:1">ታ ዶናፐ ከይያ ቃላ ሀይዝድ ስእተ።<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>ታኒ ታ ዶና ሌምሶን ዶያና፤</para>
  <para style="q2" vid="PSA 78:2">በንፐ ጌምዳ ፁራ ቆንጭሳና።<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>ኑኒ ስእዳይሳነ ኤርዳይሳ፥</para>
  <para style="q2" vid="PSA 78:3">ኑ አዋት ኑስ ኦድዳይሳታ ኦዳና።<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>ሄሳታ ኑኒ ኤንታ ናይታፐ ቆሶኮ፤</para>
  <para style="q2" vid="PSA 78:4">ጎዳስ በሲያ ጋላታ፥</para>
  <para style="q2" vid="PSA 78:4">እያ ዎልቃነ ማላልስያ እያ ኦሱዋ፥</para>
  <para style="q2" vid="PSA 78:4">ያና የለታስ ኦዳና።<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>እ ያይቆባ ዘረስ ኪታ፥</para>
  <para style="q2" vid="PSA 78:5">እስራኤለ አሳስ ህግያ እሚስ።</para>
  <para style="q1" vid="PSA 78:5">ካሰ ኑ አዋት ባንታ ናይታ</para>
  <para style="q2" vid="PSA 78:5">ሄ ህግያ ታማርሳና መላ ኪትስ።<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>ካልያ የለታይ ሄሳ ኤራና መላ፥</para>
  <para style="q2" vid="PSA 78:6">ኤንታ ናይትካ ባንታ ናይታስ</para>
  <para style="q2" vid="PSA 78:6">ቡሮ የለታና ናይታስ ኤርሳናሳ።<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>ሄ ዎደ ኤንቲ ፆሳን አማነተና፤</para>
  <para style="q2" vid="PSA 78:7">እ ኦዳባ ባሎኮና፤ እያ ኪታ ናጋና።<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>ኤንቲ ካሰ ባንታ አዋታዳ ዎዛና ሙመ የለታ፥</para>
  <para style="q2" vid="PSA 78:8">ጌላነ አማነቶና የለታ፥</para>
  <para style="q2" vid="PSA 78:8">ፆሳን ምንድ ኤቀና የለታ ግዶኮና።<verse eid="PSA 78:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>ኤፍሬማ አሳይ ዶንገ ዳንጭኮካ፥</para>
  <para style="q2" vid="PSA 78:9">ኦላ ጋላስ ጉየ ስምዶሶና።<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>ኤንቲ ፆሳ ጫቁዋ ናግቦኮና፤</para>
  <para style="q2" vid="PSA 78:10">እያ ህግያን ሄመቶና እፅዶሶና።<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>ኤንቲ እ ኦዳ ኦሱዋነ</para>
  <para style="q2" vid="PSA 78:11">እ በስዳ ማላታ ዶግዶሶና።<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>እ ኤንታ አዋታ ስንን ግብፀ ቢታን፥</para>
  <para style="q2" vid="PSA 78:12">ፆኣነ ደንባን ማላታ ኦስ።<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>አባ ሻክድ ግዶራ ኤንታ ፕንስ፤</para>
  <para style="q2" vid="PSA 78:13">ሃ ሻክድ ያን ሀን ጎዳዳ ኤስስ።<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>እ ኤንታ ጋላስ ሻራን፥</para>
  <para style="q2" vid="PSA 78:14">ቃማ ታማ ፖኦን ካለስ።<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>እ መላ ቢታን ዛላ ጳልቅድ፥</para>
  <para style="q2" vid="PSA 78:15">አባዳ ዳሮ ሃ ኤንታ ኡሽስ።<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>ዛላፈ ሃ ፑልትስድ፥</para>
  <para style="q2" vid="PSA 78:16">ሻፋ ሃዳ ጎግስስ።<verse eid="PSA 78:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>ሽን ኤንቲ እያ ቦላ ናጋራ ጉጅድ ኦዶሶና፤</para>
  <para style="q2" vid="PSA 78:17">ኡባፈ ቃ ፆሳ ቦላ መላ ቢታን ማካልዶሶና።<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>ባንታ አሞትዳ ካ ኦይችድ፥</para>
  <para style="q2" vid="PSA 78:18">ፆሳ ኤርሸ ፓጭዶሶና።<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>ኤንቲ ፆሳ ቦላ ሀይሳዳ ያግድ ሃሳይዶሶና፤</para>
  <para style="q2" vid="PSA 78:19">“መላ ቢታን ፆሳይ ኑስ ካ ጊግሳናዉ ዳንዳኢ?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>ዛላ ሾጭን ፑልቶይ ከይድ</para>
  <para style="q2" vid="PSA 78:20">ሻፋ ሃ ጎግስ፤</para>
  <para style="q2" vid="PSA 78:20">ሽን እ ኑስ ካ እማናዉ ዳንዳኢ?</para>
  <para style="q2" vid="PSA 78:20">ዎይኮ ባ አሳስ አሾ እማናዉ ዳንዳኢ?” ያግዶሶና።<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>ጎዳይ ሄሳ ስእዳ ዎደ ዳሮ ሀንቀትስ፤</para>
  <para style="q2" vid="PSA 78:21">ያይቆባ ኮቻታ ቦላ ታም ኤፅስ፤</para>
  <para style="q2" vid="PSA 78:21">እስራኤለ ቦላ እያ ሀንቆይ ዳርስ።<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>ሄስካ ኤንቲ ፆሳን አማንቦኮና፤</para>
  <para style="q2" vid="PSA 78:22">ዎይኮ እያ አሹዋን አማነትቦኮና።<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>ግዶሽን፥ ቃ ሳሉዋ ኪትስ፤</para>
  <para style="q2" vid="PSA 78:23">ሳሎ ፐንግያ ዶይስ።<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>ኤንታ ሙዛናዉ ማና ቡክስስ፤</para>
  <para style="q2" vid="PSA 78:24">ሳሎ ካ ኤንታዉ እሚስ።<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>ኪታንቾታ ካ አሳይ ምስ፤</para>
  <para style="q2" vid="PSA 78:25">ፆሳይ ኤንታዉ ምያባ ዳርስድ እሚስ።<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>ዶሎሀ ጫርኮይ ጫርካና መላ ኦስ፤</para>
  <para style="q2" vid="PSA 78:26">ባ ዎልቃን ዱገሀ ጫርኩዋ ደንስ።<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>እ አሳስ አሾ ቢታ ከስስ፤</para>
  <para style="q2" vid="PSA 78:27">ፓልያ ካፎታ አባ ጋፃ ሻፈዳ ቡክስስ።<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>ኤንቲ ደእያ በሳን፥</para>
  <para style="q2" vid="PSA 78:28">ዱንካንያ ዩሾን ዎስስ።<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>ኤንቲ አሞትዳይሳ ኤንታዉ እሚስ፤</para>
  <para style="q2" vid="PSA 78:29">ምድ ባንታ ጋንጅያ ጋዶሶና።<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>ሽን ኤንቲ ባንታ አሙዋ አና ደእሽን፥</para>
  <para style="q2" vid="PSA 78:30">አሾይ ኤንታ ዶናን ቡሮ ደእሽን፥<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>ፆሳ ሀንቆይ ኤንታ ቦላ ዎስ፤</para>
  <para style="q2" vid="PSA 78:31">ኤንታ ግዶፈ ዎልቃማ አሳታ ዎስ፤</para>
  <para style="q2" vid="PSA 78:31">እስራኤለፐ ናአተታ ክስ።<verse eid="PSA 78:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>ሄ ኡባይ ሀንንካ ናጋራ ኦሶ አግቦኮና፤</para>
  <para style="q2" vid="PSA 78:32">ዳሮ ማላታ ኦንካ አማንቦኮና።<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>ሄሳ ግሾ፥ እ ኤንታ ጋላሳታ ሀዳ ኦስ፤</para>
  <para style="q2" vid="PSA 78:33">ኤንታ ላይታ ዳጋማን ኦንግስ።<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>ፆሳይ ኤንታፈ ባጋ ዎያ ዎደ</para>
  <para style="q2" vid="PSA 78:34">እያ ኮይዶሶና፥</para>
  <para style="q2" vid="PSA 78:34">ባንታ ናጋራ ፓፅድ እያኮ ስምዶሶና።<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>ፆሳይ ኤንታ ዛላ ግደይሳ፥</para>
  <para style="q2" vid="PSA 78:35">ኡባፈ ቃ ፆሳይ ኤንታ ዎዘይሳ፥</para>
  <para style="q2" vid="PSA 78:35">ግደይሳ ሀሳይዶሶና።<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>ሽን ኤንቲ ባንታ እንፃርሳን ዎርዶትዶሶና፤</para>
  <para style="q2" vid="PSA 78:36">ባንታ ዶናን ጭምዶሶና።<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>ኤንታ ዎዛናይ ፆሳን ምንድ ኤቀና፤</para>
  <para style="q2" vid="PSA 78:37">እያ ጫቁዋስ አማነቶኮና።<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>ሽን እ ኤንታ ማርስ ኤንታ ናጋራ አቶ ግስ፤</para>
  <para style="q2" vid="PSA 78:38">ኤንታ ይስቤና።</para>
  <para style="q1" vid="PSA 78:38">ዳሮ ዎደ ባ ሀንቁዋ ተቅስ፤</para>
  <para style="q2" vid="PSA 78:38">ባ ጋዱዋ ኩመ ኤንታ ቦላ የድቤና።<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>ኤንቲ ሀይቅያ አሾ ግደይሳነ</para>
  <para style="q2" vid="PSA 78:39">ከይድ ስሞና ሸምፖ ግደይሳ አኬክስ።<verse eid="PSA 78:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>ኤንቲ መላ ቢታን እያ ቦላ አፑን ቶሆ ማካልዶና!</para>
  <para style="q2" vid="PSA 78:40">መላ ቢታን እያ አፑን ቶሆ ላንጭስዶና!<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>ኤንቲ ዛር ዛሪድ ፆሳ ፓጭዶሶና፤</para>
  <para style="q2" vid="PSA 78:41">እስራኤለ ጌሻ ይሎይዶሶና።<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>ኤንታና ሞርከታ ኩሸፐ አሽዳ ጋላሳ፥</para>
  <para style="q2" vid="PSA 78:42">ኡንኤያ አሳፐ ዎዝዳ ዎልቃ ዶግዶሶና።<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>እ ግብፀን ኦዳ ማላታ፥</para>
  <para style="q2" vid="PSA 78:43">ፆኣነ ደንባን ኦዳ</para>
  <para style="q2" vid="PSA 78:43">ማላልስያ ኦሱዋ ሀሳይቦኮና።<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>ኤንታ ሻፋ ሃታ ሱ ላምስ፤</para>
  <para style="q2" vid="PSA 78:44">ሄሳ ግሾ፥ ግብፀ አሳይ ሻፋታፐ</para>
  <para style="q2" vid="PSA 78:44">ኡያናዉ ዳንዳእቦኮና።<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>ኤንታ ዋይስያ ኡዱንፀታነ</para>
  <para style="q2" vid="PSA 78:45">ኤንታ ቢታ ይስያ ሾታ ኪትስ።<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>ዶልዳ ካ ዱጎስ፥</para>
  <para style="q2" vid="PSA 78:46">ኤንቲ ዳቡርዳ አይፍያ ቦለስ እሚስ።<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>ኤንታ ዎይንያ ሻቻን፥</para>
  <para style="q2" vid="PSA 78:47">ኤንታ ባላስያ ጫርኮን ይስስ።<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>ኤንታ መሄታ ሻቻን ዎስ፤</para>
  <para style="q2" vid="PSA 78:48">ኤንታ ዶርሳታ ዳዳን ዉርስስ።<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>ይስያ ኪታንቾ ጩጋራ፥</para>
  <para style="q2" vid="PSA 78:49">ባ ሱልያ ሀንቁዋ፥ ይሉዋ፥ እፁዋነ</para>
  <para style="q2" vid="PSA 78:49">ጋዱዋ ኤንታ ቦላ የድስ።<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>ባ ሀንቁዋስ ኦገ ጊግስስ፤</para>
  <para style="q2" vid="PSA 78:50">ኤንታ ዮስ አድ እሚስ፤</para>
  <para style="q2" vid="PSA 78:50">ኤንታ ሀይቆፐ አሽቤና።<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>ግብፀ ባይራ ናይታ ኡባ ሾጭስ፤</para>
  <para style="q2" vid="PSA 78:51">ካማ ዱንካነን ኮይሮ ናይታ ዎስ፤<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>ሽን ባ አሳ ዶርሳዳ ከስስ፤</para>
  <para style="q2" vid="PSA 78:52">ዉደዳ መላ ቢታን ሄምስ።<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>እ ኤንታ ሳሮ ካለዳ ግሾ ባብቦኮና፤</para>
  <para style="q2" vid="PSA 78:53">ሽን ኤንታ ሞርከታ አባይ ምትስ።<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>እ ኤንታ ባ ጌሻ ቢታ፥</para>
  <para style="q2" vid="PSA 78:54">ባ ኡሻቻ ኩሸን ፆንድ ኦይክዳ ዙማ ቦላ ኤህስ።<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>እ ኤንታ ስንፈ ካዎተታ ጎድስ፤</para>
  <para style="q2" vid="PSA 78:55">ኤንታ ቢታ እስራኤለ ኮቻታስ ላታ ኦድ ሻክስ፤</para>
  <para style="q2" vid="PSA 78:55">ባ አሳስ ኤንታ ኬ እሚስ።<verse eid="PSA 78:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>ግዶሽን፥ ኡባፈ ቃ ፆሳ ቦላ ማካልዶሶና፤</para>
  <para style="q2" vid="PSA 78:56">እያ ፓጭዶሶና፤ እያ ህግያ ኪተትቦኮና።<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>ኤንቲ ባንታ አዋታዳ ጌላታነ</para>
  <para style="q2" vid="PSA 78:57">ምንድ ኤቆና አስ ግድዶሶና፤</para>
  <para style="q2" vid="PSA 78:57">ዎበ ቶራዳ ዎራ ዎዶሶና።<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>ቃ ጎይኖ በሳታን እያ ይሎይዶሶና፤</para>
  <para style="q2" vid="PSA 78:58">ባንታ ኤቃታራ እያ ቃናትስዶሶና።<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>ፆሳይ ሄሳ ስእዳ ዎደ ሸነትስ፤</para>
  <para style="q2" vid="PSA 78:59">እስራኤለ ኡባ ካስ።<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>ሴሎን እ ደእያ ባ በሳ፥</para>
  <para style="q2" vid="PSA 78:60">አሳ ግዶን እ ደእያ ባ ዱንካንያ አግስ።<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>ፆሳ ዎልቃስነ ቦንቹዋስ</para>
  <para style="q2" vid="PSA 78:61">ማላታ ግድዳ ታቦትያ</para>
  <para style="q2" vid="PSA 78:61">ሞርከታ ኩሸን አድ እሚስ።<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>እ ባ አሳ ቦላ ሸነትስ፤</para>
  <para style="q2" vid="PSA 78:62">ኤንታ ማሻስ አድ እሚስ።<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>ናአተት ኡባይ ታማን ሜተትዶሶና፤</para>
  <para style="q2" vid="PSA 78:63">ጌላኦት አዝና ገሎና አትዶሶና።<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>ኤንታ ካህነት ማሻን ዉርዶሶና፤</para>
  <para style="q2" vid="PSA 78:64">ኤንታ ማቸት ዬኮና መላ ድገትዶሶና።<verse eid="PSA 78:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>ጎዳይ ስኮፈ ባርክያ አሳዳ ደንድስ፤</para>
  <para style="q2" vid="PSA 78:65">ዎይነ ኡሻ ማይ አዳ አሳዳ ሀንስ።<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>እ ባ ሞርከታ ጉየ ዛሪድ ሾጭስ፤</para>
  <para style="q2" vid="PSA 78:66">ኤንታ መርናዉ ዬላይስ።<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>ዮሰፋ ዱንካንያ ካስ፤</para>
  <para style="q2" vid="PSA 78:67">ኤፍሬማ ኮቻ ዶርቤና።<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>ሽን ይሁዳ ኮቻነ</para>
  <para style="q2" vid="PSA 78:68">እ ዶስያ ፅዮነ ደርያ ዶርስ።<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>ባ ኬ ሳሎዳ ቁ ኦድ ኬፅስ፤</para>
  <para style="q2" vid="PSA 78:69">ሳአዳ መርናዉ ኤስስ።<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>ባ አይልያ ዳዊታ ዶርድ፥</para>
  <para style="q2" vid="PSA 78:70">ዶርሰ ሄምያ በሳፈ ኤክስ።<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>ዶርሰ ሄምያ በሳፈ ደንድ፥</para>
  <para style="q2" vid="PSA 78:71">ባ አሳ ያይቆባ፥</para>
  <para style="q2" vid="PSA 78:71">ባ ላታ እስራኤለ ሄንናዉ ኤህስ።<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>ዳዊቲ ኤንታ ሱረ ዎዛናን ሄምስ፤</para>
  <para style="q2" vid="PSA 78:72">ባ ጭንጫተን ካለስ።<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="s1">ጎዳዉ፥ አዉደ ጋካናሴ?</para>
  <para style="d">አሳፋ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 79:1"/>ፆሳዉ፥ አይሁደ ግዶና አሳይ፥</para>
  <para style="q2" vid="PSA 79:1">ነ ቢታ ቦላ ደንድዶሶና፤</para>
  <para style="q1" vid="PSA 79:1">ነ ጌሻ ኬ ቱንስዶሶና፤</para>
  <para style="q2" vid="PSA 79:1">የሩሳላመ ላልዶሶና።<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>ነ አይለታ አሀ ሳሎ ካፎታስ፥</para>
  <para style="q2" vid="PSA 79:2">ነ ጌሻታ አሹዋ ሳአ ዶአታስ እምዶሶና።<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>ኤንታ ሱ የሩሳላመ ዩሾን</para>
  <para style="q2" vid="PSA 79:3">ሃዳ ጉስዶሶና፤</para>
  <para style="q2" vid="PSA 79:3">ኤንታ አሀ ሞግያ አስ ይስ።<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>ኑ ሾሮታስ ኑኒ ሚቻስ፥</para>
  <para style="q2" vid="PSA 79:4">ኑ ሄራን ደእያ አሳስ ቀልቅሰስ አትዳ።<verse eid="PSA 79:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>ጎዳዉ፥ ሄስ አዉደ ጋካናዉ ሀናኔ?</para>
  <para style="q2" vid="PSA 79:5">ኔኒ ኑ ቦላ መርናዉ ሀንቀታዲ?</para>
  <para style="q2" vid="PSA 79:5">ነ ሀንቆይ ታማዳ ኤፅሸ ዳነዬ?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>ነና ኤሮና ደረታ ቦላ፥</para>
  <para style="q2" vid="PSA 79:6">ነ ሱን ፄጎና ካዎተታ ቦላ</para>
  <para style="q2" vid="PSA 79:6">ነ ሀንቁዋ ዛራ።<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>ሄስካ ኤንቲ ያይቆባ ምዳ ግሾነ</para>
  <para style="q2" vid="PSA 79:7">ኤንቲ ደእያ በሳ ይስዳ ግሾሳ።<verse eid="PSA 79:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>ኑኒ ዳሮ መቶትዳ ግሾ፥</para>
  <para style="q2" vid="PSA 79:8">ኑ ማይዛታ ኢታተ ኑ ቦላ ታይቦፓ፤</para>
  <para style="q2" vid="PSA 79:8">ኤሶን ነ ማሮታ ኑስ ኪታ።<verse eid="PSA 79:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>አቤት ኑና አሽያ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 79:9">ነ ቦንቾ ሱን ግሾ ኑና ማዳ።</para>
  <para style="q1" vid="PSA 79:9">ነ ሱን ግሾ ኑና አሻ፤</para>
  <para style="q2" vid="PSA 79:9">ኑ ናጋራ አቶ ጋ።<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>ደረት፥ “ኤንታ ፆሳይ አዉን ደኢ?” አይስ ጋኔ?</para>
  <para style="q2" vid="PSA 79:10">ነ አይለታ ሱ ኤንቲ ጉስዳ ግሾ፤</para>
  <para style="q2" vid="PSA 79:10">ኔኒ ሀሎ ከየይሳ ኑ ፄልሽን፥</para>
  <para style="q2" vid="PSA 79:10">ኤንታ ግዶን ቆንጭሳ።<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>ቃሾ አሳ ኦለይ ነ ስን ጋኮ፤</para>
  <para style="q2" vid="PSA 79:11">ሀይቆ ፕርደትዳይሳታ</para>
  <para style="q2" vid="PSA 79:11">ነ ዎልቃ ግታተን አሻ።<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>ጎዳዉ፥ ኑ ሾሮት ነና ቶችዳ ግሾ፥</para>
  <para style="q2" vid="PSA 79:12">ላፑን ኩሸ ሀሎ ከያዳ ኤንታ ክኦን እድን።<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>ሄ ዎደ ኑኒ ነ አሳይ፥ ነ ዶርሳት፥</para>
  <para style="q2" vid="PSA 79:13">መርናዉ ነና ጋላታና።</para>
  <para style="q1" vid="PSA 79:13">የለተፈ የለተ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 79:13">ነ ፔሻ ኦዳና።<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="s1">ፆሳዉ፥ ኑና ኦራ</para>
  <para style="d">አሳፍ ዛማረታ ሀላቃስ ፃፍዳ ማዝሙረ</para>
  <para style="d">“ጪሻ ጩ” ጌተትያ ማርካተ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 80:1"/>ዮሰፋ ዶርሳ ዉደዳ ካለይሶ፥</para>
  <para style="q2" vid="PSA 80:1">እስራኤለ ሄንንቹዋዉ ኑና ስአ።</para>
  <para style="q1" vid="PSA 80:1">ክሩበታ ቦላ ደእያ አራታን ኡትዳይሶ፥</para>
  <para style="q2" vid="PSA 80:1">ነ ፖኡዋን ቆንጫ።<verse eid="PSA 80:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2"/>ኤፍሬማ፥ ብንያመነ ምናሰ ስንን በንታ፤</para>
  <para style="q2" vid="PSA 80:2">ነ ዎልቃ ቃዳ ኑና አሻናዉ ሃያ።<verse eid="PSA 80:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>ፆሳዉ ኑና ዛራ፤</para>
  <para style="q2" vid="PSA 80:3">ኑ አታናዳ ነ ሶምኡዋ ኑስ ፖእሳ።<verse eid="PSA 80:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>ኡባፈ ዎልቃማ ጎዳዉ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 80:4">ነ አሳ ዎሳ ቦላ አዉደ ጋካናዉ ሸነታይ?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>ኔኒ ኤንታ ዬሆ ካዳ ሙዛዳሳ፤</para>
  <para style="q2" vid="PSA 80:5">አፉ ሃዳ ኡሻዳሳ።<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>ኑ ሾሮት ኑ ቢታ ኤካናዉ</para>
  <para style="q2" vid="PSA 80:6">ባንታ ግዶን ኦያና መላ ኦዳሳ፤</para>
  <para style="q2" vid="PSA 80:6">ኑ ሞርከት ኑ ቦላ ሚጭዶሶና።<verse eid="PSA 80:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>ኡባፈ ዎልቃማ ፆሳዉ ኑና ዛራ፤</para>
  <para style="q2" vid="PSA 80:7">ኑ አታናዳ ነ ሶምኡዋ ኑስ ፖእሳ።<verse eid="PSA 80:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>ግብፀፈ ዎይነ ኤሀዳሳ፤</para>
  <para style="q2" vid="PSA 80:8">ካዎተታ የደዳ፥</para>
  <para style="q2" vid="PSA 80:8">ኤንታ ቢታን እያ ቶካዳሳ።<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>ኔኒ ቢታ ቄፃዳሳ፤</para>
  <para style="q2" vid="PSA 80:9">እ ፃጶ የድድ፥ ዳይድ ቢታ ጋክስ።<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>ደረት እያ ኩያን፥</para>
  <para style="q2" vid="PSA 80:10">ልባኖሰ ዝጋት እያ ታሽያን ካመትዶሶና።<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>ባ ታሸታ መደትራነ አባ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 80:11">ባ ፄራታ ኤፍራፂሳ ሻፋ ጋካናዉ የድስ።<verse eid="PSA 80:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>ያትን፥ ኦገራ አያ ኡባይ</para>
  <para style="q2" vid="PSA 80:12">እያ አይፍያ ዱናዳ፥</para>
  <para style="q2" vid="PSA 80:12">እያ ዩሾን ደእያ ግምብያ አይስ ላላዲ?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>ባዞ ጉዱንይ እያ ቦላ ጉፕስ፤</para>
  <para style="q2" vid="PSA 80:13">ዎራ ዶአት እያ ምዶሶና።<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>ኡባፈ ዎልቃማ ፆሳዉ ኑኮ ስማ፤</para>
  <para style="q2" vid="PSA 80:14">ሳሎራ ዱገ ፄላዳ፤ ሀ ዎይንያ ናጋ።<verse eid="PSA 80:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15"/>እ ነ ኡሻቻ ኩሸይ ቶክዳ ፃጶ፤</para>
  <para style="q2" vid="PSA 80:15">ኔኒ ነዉ ድችዳ ፑተ።<verse eid="PSA 80:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>ነ ሞርከት ነ ዎይንያ ቃንፅዶሶና፤</para>
  <para style="q2" vid="PSA 80:16">ታማን ፁግዶሶና፤</para>
  <para style="q2" vid="PSA 80:16">ኤንታ ነ ሀንቁዋን ይሳ።<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>ነ ኩሸይ ነ ኡሻቻን ደእያ አሳ፥</para>
  <para style="q2" vid="PSA 80:17">ኔኒ ነዉ ድችዳ አሳ ናጎ።<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>ህዛ ኑኒ ጉየ ስሞኮ፤</para>
  <para style="q2" vid="PSA 80:18">ኑና ፓፃ ዎ፤ ነ ሱን ጋላታና።<verse eid="PSA 80:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>ኡባፈ ዎልቃማ ጎዳዉ ፆሳዉ፥ ኑና ዛራ፤</para>
  <para style="q2" vid="PSA 80:19">ኑ አታናዳ ነ ሶምኡዋ ኑስ ፖእሳ።<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="s1">ሻቃራ ባኣለ ዎደ የፅያ ሳባ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ሱሱልኤን የፀትያ አሳፋ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 81:1"/>ኑስ ዎልቃ ግድዳ ፆሳስ ኡፋይሳን የፅተ፤</para>
  <para style="q2" vid="PSA 81:1">ያይቆባ ፆሳስ እልልተ።<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>የ ዶምተ፤ ካራቦ ባቅተ፤</para>
  <para style="q2" vid="PSA 81:2">ዲንነ ማስንቆን የፅተ።<verse eid="PSA 81:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>አጌን ፄርያ ዎደ፥</para>
  <para style="q2" vid="PSA 81:3">ቃስ ማ ኡትያ ዎደ፥</para>
  <para style="q2" vid="PSA 81:3">ባኣለ ጋላሳን ሞይዘ ፑንተ።<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>ሄስ እስራኤለ ቢታን ህገ፤</para>
  <para style="q2" vid="PSA 81:4">ያይቆባ ፆሳይ እምዳ ዎጋ።<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>እ ግብፀ ቢታ ሾጭዳ ዎደ፥</para>
  <para style="q2" vid="PSA 81:5">ዮሰፋ ኮቻስ ሀ ዎጋ አዋጅስ።</para>
  <para style="b" vid="PSA 81:5"/>
  <para style="q1" vid="PSA 81:5">ኤሮና ዶናን ሀይሳዳ ያግሽን ስአስ፤<verse eid="PSA 81:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>“ህንተ ሀሽያ ቶሆፐ፥</para>
  <para style="q2" vid="PSA 81:6">ህንተ ኩሽያ ኬሸፐ ሸምፕሳስ።<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>ህንተ መቱዋን ታና ፄግደታ፤ ታ ህንተና አሻስ፤</para>
  <para style="q2" vid="PSA 81:7">ታኒ ደችያ ሻራ ግዶፈ ህንተና አላስ፤</para>
  <para style="q2" vid="PSA 81:7">ማርባ ፑልቱዋ ማታን ታ ህንተና ፓጫስ።” <char style="qs">ሳላሀ </char><verse eid="PSA 81:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>“ታ አሳዉ፥ ታ ህንተና ሴረይሳ ስእተ፤</para>
  <para style="q2" vid="PSA 81:8">እስራኤለ አሳዉ ህንተ ታና ስእኮ አይቤ?<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>ህንተ ግዶን አላጋ ፆሲ ደኦፖ፤</para>
  <para style="q2" vid="PSA 81:9">ሀራ ፆሰ ጎይኖፍተ።<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>ግብፀ ቢታፈ ህንተና ከስዳ፥</para>
  <para style="q2" vid="PSA 81:10">ታኒ ጎዳ ህንተ ፆሳ፤</para>
  <para style="q1" vid="PSA 81:10">ነ ዶና ሎይዳ ሀካንካ፤</para>
  <para style="q2" vid="PSA 81:10">ታኒ እያን ኩንና።<verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>“ሽን ታ አሳይ ታና ስእቦኮና፤</para>
  <para style="q2" vid="PSA 81:11">እስራኤለይ ታዉ ኪተትቤና።<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>ሄሳ ግሾ፥ ኤንቲ ባንታ ቆፋ ካላና መላ፥</para>
  <para style="q2" vid="PSA 81:12">ስሞና ኤንታ ዎዛናስ አዳ እማስ።<verse eid="PSA 81:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>ታ አሳይ ታና ስእዳኮ አይበ፤</para>
  <para style="q2" vid="PSA 81:13">እስራኤለይ ታ ኦግያ ካልዳኮ አይብ ደእ፤<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>ታኒ ኤንታ ሞርከታ ኤሶን ፆናናሽን፤</para>
  <para style="q2" vid="PSA 81:14">ኤንታ እፀይሳታ ቦላ ታ ኩሽያ ደንናሽን።<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>ጎዳ እፀይሳት እያ ስንን ሆካና፤</para>
  <para style="q2" vid="PSA 81:15">ኤንታ ሴራይ መርናዉ ግዳና።<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>ታኒ ህንተና ሎኦ ግስተ ሙዛና፤</para>
  <para style="q2" vid="PSA 81:16">ዛላፈ ከይያ ኤሳን ህንተና ካልሳና።”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="s1">ዳቡራንቹዋ አሻ</para>
  <para style="d">አሳፋ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 82:1"/>ፆሳይ ሳሎ ሺቁዋ ግዶን፥</para>
  <para style="q2" vid="PSA 82:1">ፆሳት ሺቅዳ በሳን</para>
  <para style="q2" vid="PSA 82:1">ሀይሳዳ ያግድ ፕርዴስ።<verse eid="PSA 82:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>“ህንተ አዉደ ጋካናዉ ዎበ ፕርዳኔ?</para>
  <para style="q2" vid="PSA 82:2">አዉደ ጋካናዉ ኢታታ ባጋ ግዳኔ?” <char style="qs">ሳላሀ </char><verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>መቶታንቾታስነ አው ባይናይሳታስ ሞተትተ፤</para>
  <para style="q2" vid="PSA 82:3">ማንቆታነ ቆሄትዳ አሳ ማታ ናግስተ።<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>ዳቡራንቾታነ መቶታንቾታ አሽተ፤</para>
  <para style="q2" vid="PSA 82:4">ኢታታ ኩሸፐ ኤንታ የግስተ።<verse eid="PSA 82:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>ህንተዉ ኤራተነ አኬክ ባዋ፤</para>
  <para style="q2" vid="PSA 82:5">ኤንቲ ማን ስመረቶሶና፤</para>
  <para style="q2" vid="PSA 82:5">ቢታ ባሶት ቃፅዶሶና።<verse eid="PSA 82:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>ታኒ፥ “ህንተ ፆሳታ፤</para>
  <para style="q2" vid="PSA 82:6">ኡባይ ኡባፈ ቃ ፆሳ ናይታ።<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>ግዶሽን ህንተ አስ ሀይቀይሳዳ ሀይቃና፤</para>
  <para style="q2" vid="PSA 82:7">ሀራ ሀላቃት ኩንደይሳዳ ኩንዳና” ያጋስ።<verse eid="PSA 82:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>ፆሳዉ፥ ደንዳ፤ ቢታ ቦላ ፕርዳ፤</para>
  <para style="q2" vid="PSA 82:8">ካዎተት ኡባይ ነባ።<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="s1">ፆሳዉ ስእ ጎፓ</para>
  <para style="d">አሳፋ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 83:1"/>አቤት ፆሳዉ፥ ስእ ጎፓ፤</para>
  <para style="q2" vid="PSA 83:1">ፆሳዉ ስርጵ ጎፓ፤ ሙሞፓ።<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>ነ ሞርከት ነ ቦላ ደንደይሳ፥</para>
  <para style="q2" vid="PSA 83:2">ነና እፀይሳት ነ ቦላ ማካለይሳ በአ።<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>ኤንቲ ነ አሳ ቦላ ጌማን ዱላቶሶና፤</para>
  <para style="q2" vid="PSA 83:3">ኔኒ ዶስያ አሳ ቦላ ማቀቶሶና።<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>“ሃይተ፥ ኤንታ ካዎተ ይሶስ፤</para>
  <para style="q2" vid="PSA 83:4">እስራኤለ ጌተትያ ሱንይ መርናዉ ሀሳየቶና መላ ኦስ” ያጎሶና።<verse eid="PSA 83:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>ኤንቲ እስ ዎዛናን ግድድ ማቀቶሶና፤</para>
  <para style="q2" vid="PSA 83:5">ነ ቦላ ደንዳናዉ ጫቅዶሶና።<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>ኤንቲ፥ ኤዶመነ እስማኤላ አሳ፥</para>
  <para style="q2" vid="PSA 83:6">ሞአበነ አጋር ኮቻታ፤<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>ገባላነ አሞነ አሳ፥</para>
  <para style="q2" vid="PSA 83:7">አማለቃ፥ ፍልስፄመነ ፅሮሳ አሳ።<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>አሶረት ኤንታራ ጋሄትዶሶና፤</para>
  <para style="q2" vid="PSA 83:8">አሶረት ሎፀ አሳስ ዎልቃማ ማዶ ግድዶሶና። <char style="qs">ሳላሀ </char><verse eid="PSA 83:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>ኔኒ፥ ምድያመ፥ ስሳራነ ያብና ቦላ</para>
  <para style="q2" vid="PSA 83:9">ቅሶና ሻፋን ኦዳይሳዳ ኤንታ ቦላ ኦ።<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>ኤንቲ ኤንዶራን ይዶሶና፤</para>
  <para style="q2" vid="PSA 83:10">ኤንታ አሀይ ደንባን ዎቅድ አትስ።<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>ኤንታ ሀላቃታ ኦሬባነ ዘባዳ ኦ፤</para>
  <para style="q2" vid="PSA 83:11">ኤንታ ሃረይሳታ ዛብሄላነ ስልማናዳ ይሳ።<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>ኤንቲ፥ “ኑኒ ፆሳ አሳ ላታ</para>
  <para style="q2" vid="PSA 83:12">ኑስ ቡዞ ኦና” ያግዶሶና።<verse eid="PSA 83:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>ታ ፆሳዉ፥ ኤንታ ባናዳ ላላ፤</para>
  <para style="q2" vid="PSA 83:13">ጫርኮይ ኤፍያ ሱላዳ ኦ።<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>ታም ዎራ መይሳዳ፥</para>
  <para style="q2" vid="PSA 83:14">ታማ ላጮይ ደርያ ፁገይሳዳ፥<verse eid="PSA 83:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 83:15"/>ነ ኡሹዋን ኤንታ የደ፤</para>
  <para style="q2" vid="PSA 83:15">ነ ጎትያን ኤንታ ዳጋን።<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>ጎዳዉ፥ አሳይ ነ ሱን ኮያና መላ፥</para>
  <para style="q2" vid="PSA 83:16">ኤንታ ሶምኡዋ ዬላ ማይዛ።<verse eid="PSA 83:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>ኤንቲ መርናዉ ዬላቶ፤ ህርጎ፤</para>
  <para style="q2" vid="PSA 83:17">ካዉይድ ዮ።<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>ነ ሱንይ ጎዳ ግድዳ ነ ፃላል፥</para>
  <para style="q2" vid="PSA 83:18">ኡባፈ ቃ ፆሳይ፥</para>
  <para style="q2" vid="PSA 83:18">ሳአ ኡባ ሃረይሳ ኤንቲ ኤሮ።<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="s1">ፆሳ ኬ ብሸ የፅያ ማዝሙረ</para>
  <para style="d">ዛማረታ ሀላቃስ ቆረ ናይት ፃፍዳ ሱሱልኤን የፀትያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 84:1"/>ኡባፈ ዎልቃማ ጎዳዉ፥</para>
  <para style="q2" vid="PSA 84:1">ነ ደእያ በሳይ ዋን ሎእ!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>ታኒ ጎዳ ኬ ዳባባ ላሞታይስ፤</para>
  <para style="q2" vid="PSA 84:2">ታ ኩመ አሳተይ</para>
  <para style="q2" vid="PSA 84:2">ደኦ ፆሳስ ኡፋይሳን የፄስ።<verse eid="PSA 84:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>ኡባፈ ዎልቃማ ጎዳዉ፥</para>
  <para style="q2" vid="PSA 84:3">ታ ካዋዉ፥ ታ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 84:3">ነ ያርሾ በሳ ማታን</para>
  <para style="q2" vid="PSA 84:3">ቡበ ካፎይ ባዉ ደእያ በሲ ደማሱ፤</para>
  <para style="q2" vid="PSA 84:3">ሆለይካ ባ ናይታ ዎያ ኬ ኬፃሱ።<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>ነ ኬን ደኤይሳትነ</para>
  <para style="q2" vid="PSA 84:4">መርናዉ ነና ሳበይሳት አንጀትዳይሳታ። <char style="qs">ሳላሀ </char><verse eid="PSA 84:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>ነና ባንታ ምኖተ ኦይሳት፥</para>
  <para style="q2" vid="PSA 84:5">ባንታ ዎዛና ፅዮነ ኦግያ ቦላ፥</para>
  <para style="q2" vid="PSA 84:5">ዎይሳት አንጀትዳይሳታ።<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>ኤንቲ ዬሆ ዛንጋራራ አያ ዎደ፥</para>
  <para style="q2" vid="PSA 84:6">ሄ በሳይ ፑልቶይ ከይያ በሲ ግድስ፤</para>
  <para style="q2" vid="PSA 84:6">ቶርቸ እራይ ቡክድ ኦላ ኩንስ።<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>ኤንቲ ዎልቃ ቦላ ዎልቃ ጉጅ ጉጅ ባና፤</para>
  <para style="q2" vid="PSA 84:7">እሶይ እሶይ ፆሳ ስንን ፅዮነን በንታና።<verse eid="PSA 84:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>ኡባፈ ዎልቃማ ጎዳዉ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 84:8">ታ ዎሳ ኔኒ ስአ፤</para>
  <para style="q2" vid="PSA 84:8">ያይቆባ ፆሳዉ ሀይዛ። <char style="qs">ሳላሀ </char><verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>ፆሳዉ፥ ኑ ጎንዳልያ በአ፤</para>
  <para style="q2" vid="PSA 84:9">ነ ዶርዳ ካዋ ኬሀ አይፈን ፄላ።<verse eid="PSA 84:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>ታኒ ሀራ በሳን ሙኩሉ ጋላስ ዳናፐ፥</para>
  <para style="q2" vid="PSA 84:10">ነ ዳባባን እስ ጋላስ ደኤይስ ታዉ ሎኦ።</para>
  <para style="q1" vid="PSA 84:10">ኢታታ ዱንካንያን ዳናፐ፥</para>
  <para style="q2" vid="PSA 84:10">ፆሳ ኬ ፐንገ ናጎይ ታዉ ሎኦ።<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>ጎዳ ፆሳይ ኑስ ጎንዳለነ ፖኦ፤</para>
  <para style="q2" vid="PSA 84:11">ኑስ ቦንቾነ ኬሀተ እሜስ፤</para>
  <para style="q2" vid="PSA 84:11">ሱረተን ሄመተይሳታ ሎኦባ ድገና።<verse eid="PSA 84:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>ኡባፈ ዎልቃማ ጎዳዉ፥</para>
  <para style="q2" vid="PSA 84:12">ነናን አማነተይሳት አንጀትዳይሳታ።<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="s1">ኑና ዛራዳ ደን</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ቆረ ናይታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 85:1"/>ጎዳዉ፥ ኔኒ ነ ቢታስ ኬሀዳሳ፤</para>
  <para style="q2" vid="PSA 85:1">ያይቆባ ኮቻ ድኦፐ ጉየ ዛራዳሳ።<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>ነ አሳ ናቁዋ አቶ ጋዳሳ፤</para>
  <para style="q2" vid="PSA 85:2">ኤንታ ናጋራ ኡባ ካማዳሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>ነ ይሉዋ አጋዳሳ፤</para>
  <para style="q2" vid="PSA 85:3">ሱልያ ነ ሀንቁዋፈ ስማዳሳ።<verse eid="PSA 85:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>አቤት ኑና አሽያ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 85:4">ኑና ጉየ ዛራ፤</para>
  <para style="q2" vid="PSA 85:4">ኑ ቦላ ላንጭዳይሳ አጋ።<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>ኔኒ ኑ ቦላ መርናዉ ሸነታዬ?</para>
  <para style="q2" vid="PSA 85:5">ነ ሀንቁዋፈ ስምክዬ?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>ኑኒ ነናን ኡፋይታና መላ፥</para>
  <para style="q2" vid="PSA 85:6">ኑና ዛራዳ ኦራክዬ?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>አቤት ጎዳዉ፥ ነ መርና ሲቁዋ ኑና በሳ፤</para>
  <para style="q2" vid="PSA 85:7">ኑና አሻ።<verse eid="PSA 85:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>ጎዳ ፆሳይ ኦድያባ ታኒ ስአና፤</para>
  <para style="q2" vid="PSA 85:8">ኤንቲ ባንታ ኤያ ኦግያኮ ስሞና እፅኮ፥</para>
  <para style="q2" vid="PSA 85:8">እ ባ ጌሻ ደርያስ ሳሮተ ኦዴስ።<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>እያ ቦንቾይ ኑ ቢታን ዳና መላ፥</para>
  <para style="q2" vid="PSA 85:9">ፆሳ ያየይሳታ አሻናዉ እ ማታን ደኤስ።<verse eid="PSA 85:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>ሲቆይነ ቱማተ ጋሄትዶሶና፤</para>
  <para style="q2" vid="PSA 85:10">ፅሎተነ ሳሮተ እድመትዶሶና።<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>ቱማተ ሳኣፐ ፑደ ከዬስ፤</para>
  <para style="q2" vid="PSA 85:11">ፅሎተ ሳሎፐ ዱገ ፄሌስ።<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>ፆሳይ ሎኦባ ኑስ እማና፤</para>
  <para style="q2" vid="PSA 85:12">ኑ ቢታይ ዳሮ ካ አይፋና።<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>ፅሎተ ጎዳ ስንን ሄመታና፤</para>
  <para style="q2" vid="PSA 85:13">እያ ኦግያ ጊግሳና።<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="s1">ፆሳ ሲቆይ ግታ</para>
  <para style="d">ዳዊታ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 86:1"/>ጎዳዉ፥ ታኒ ማንቆነ መቶታንቾ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 86:1">ታ ዎሳ ስአዳ ታና አላ።<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>ታ ነዉ ዱማትዳ አስ ግድያ ግሾ፥ ታና ደኦን ዎ፤</para>
  <para style="q2" vid="PSA 86:2">ነናን አማነትያ ታና፥ ነ አይልያ አሻ፤</para>
  <para style="q2" vid="PSA 86:2">ኔኒ ታ ፆሳ።<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>ጎዳዉ፥ ጋላስ ኩመ ታ ኔኮ ዋስያ ግሾ፥</para>
  <para style="q2" vid="PSA 86:3">ታዉ ቃታ።<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>ጎዳዉ፥ ታ ሸምፖይ ኔኮ ዋስያ ግሾ፥</para>
  <para style="q2" vid="PSA 86:4">ታና፥ ነ አይልያ ኡፋይሳ።<verse eid="PSA 86:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>ጎዳዉ፥ ኔኒ ኬሀነ አቶ ገይሳ፤</para>
  <para style="q2" vid="PSA 86:5">ነና ፄግያ ኡባስ ነ ሲቆይ ዳሮ።<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>አቤት ጎዳዉ፥ ታ ዎሳ ስአ፤</para>
  <para style="q2" vid="PSA 86:6">ታ ዋሱዋ ሀይዛ።<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>ነ ታ ዎሳስ ዛሮ እምያ ግሾ፥</para>
  <para style="q2" vid="PSA 86:7">ታ መቱዋ ጋላሳን ታ ኔኮ ዋሳና።<verse eid="PSA 86:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>ጎዳዉ፥ ፆሳታ ግዶን ነ መል ባዋ፤</para>
  <para style="q2" vid="PSA 86:8">ነ ኦሱዋራ ግነይ ባዋ።<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>ጎዳዉ፥ ኔኒ መዳ ካዎተት ይድ፥</para>
  <para style="q2" vid="PSA 86:9">ነ ስንን ጉልባታና፤ ነ ሱን ቦንቻና።<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>ኔኒ ግታ፤ ነ ማላልስያ ኦሶ ኦያ ግሾ</para>
  <para style="q2" vid="PSA 86:10">ፆሲ ነ ፃላላ።<verse eid="PSA 86:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>ጎዳዉ፥ ታ ነ ቱማን ሄመታና መላ፥</para>
  <para style="q2" vid="PSA 86:11">ታና ነ ኦግያ ታማርሳ።</para>
  <para style="q1" vid="PSA 86:11">ታኒ ነ ሱንስ ያያና መላ፥</para>
  <para style="q2" vid="PSA 86:11">ታዉ እስ ዎዛና እማ።<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>ጎዳዉ ታ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 86:12">ታኒ ነና ታ ኩመ ዎዛናን ጋላታና፤</para>
  <para style="q2" vid="PSA 86:12">ነ ሱን መርናዉ ቦንቻና።<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>ነ ሲቆይ ታዉ ዳሮ፤</para>
  <para style="q2" vid="PSA 86:13">ታና ዱፎፐ አሻዳሳ።<verse eid="PSA 86:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>ፆሳዉ፥ ኦቶራንቾት ታ ቦላ ደንድዶሶና፤</para>
  <para style="q2" vid="PSA 86:14">ኢታ አሳታ ጩጋይ ታና ዎናዉ ኮዬስ፤</para>
  <para style="q2" vid="PSA 86:14">ኤንቲ ነና ዉዳ ጎኮና።<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>ሽን አቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 86:15">ኔኒ ቃትያነ ማርያ ፆሰ።</para>
  <para style="q1" vid="PSA 86:15">ኔኒ ሀንቀታናዉ ጋምኣሳ፤</para>
  <para style="q2" vid="PSA 86:15">ሲቆይነ አማነተ ዳርዳይሳ።<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>ታኮ ስማዳ ታዉ ቃታ፤</para>
  <para style="q2" vid="PSA 86:16">ነ አይልያስ ዎልቃ እማ፤</para>
  <para style="q2" vid="PSA 86:16">ነ ጋንደ ናኣ ታና አሻ።<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>ጎዳዉ፥ ነ ኬሀተ ማላታ ታና በሳ፤</para>
  <para style="q2" vid="PSA 86:17">ነ ታና ማደይሳነ ምንይሳ በእያ ዎደ፥</para>
  <para style="q2" vid="PSA 86:17">ታ ሞርከት ዬላታና።<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="s1">ፅዮነ ካታማ</para>
  <para style="d">ቆረ ናይታ ማዝሙረ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>ጎዳ ካታማይ፥</para>
  <para style="q2" vid="PSA 87:1">ጌሻ ደርያ ቦላ ኬፀትስ።<verse eid="PSA 87:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2"/>ጎዳይ ፅዮነ ፐንገታ፥</para>
  <para style="q2" vid="PSA 87:2">ያይቆብ ደእያ ሀራ በሳታፐ አድ ዶሴስ።<verse eid="PSA 87:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>ነኖ ፆሳ ካታማዉ፥</para>
  <para style="q2" vid="PSA 87:3">ነ ግሾ ማላልስያባታ ሀይሳዳ ያግድ ኦድስ። <char style="qs">ሳላሀ </char><verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“ታና ኤርያ ካዎተታ ግዶፈ፥</para>
  <para style="q2" vid="PSA 87:4">ታኒ ራባነ ባብሎነ ማዝጋባና።</para>
  <para style="q1" vid="PSA 87:4">ፍልስፄመይ፥ ፅሮስነ ቶጰይ፥</para>
  <para style="q2" vid="PSA 87:4">ያን የለትዶሶና።”<verse eid="PSA 87:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>ፆሳይ ፅዮነስ፥</para>
  <para style="q2" vid="PSA 87:5">“ያ ደረይ ሀ ደረይ ፅዮነን የለትስ፤</para>
  <para style="q2" vid="PSA 87:5">ኡባፈ ቃ ፆሳይ እዮ ምንና” ያጌስ።<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>ጎዳይ አሳ ማዝጋበን ፃፍያ ዎደ፥</para>
  <para style="q2" vid="PSA 87:6">“ሀይስ ፅዮነን የለትስ” ያጋና። <char style="qs">ሳላሀ </char><verse eid="PSA 87:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>ኤንቲ የፅሸነ ዱርሸ፥</para>
  <para style="q2" vid="PSA 87:7">“ኑ አንጆ ኡባይ ፅዮነፐ ፑልቴስ” ያጋና።<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="s1">ቃማነ ጋላስ ኔኮ ዋሳይስ</para>
  <para style="d">ዛማረታ ሀላቃስ ፃፈትዳ ቆረ ናይታ ማዝሙረ</para>
  <para style="d">አኬካን ፃፍዳ ግንፆ፤ አረ ማዝሙረ</para>
  <para style="d">እዝራኤላ አድያ ኤማና ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 88:1"/>ጎዳዉ፥ ታና አሽያ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 88:1">ታኒ ጋላስ ኔኮ ዋሳይስ፤</para>
  <para style="q2" vid="PSA 88:1">ቃማ ነ ስንን ዬካይስ።<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>ታ ዎሳይ ነ ስን ጋኮ፤</para>
  <para style="q2" vid="PSA 88:2">ነ ሀይይ ታ ዋሱዋ ስኦ።<verse eid="PSA 88:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>ታ ሸምፖይ መቶ ካልዳ ግሾ፥</para>
  <para style="q2" vid="PSA 88:3">ታ ደኦይ ዱፎኮ ማትስ።<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>ዱፎ ገልያ አሳራ ታይበታስ፤</para>
  <para style="q2" vid="PSA 88:4">ዎልቅ ባይና አስ ግዳስ።<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>ታኒ አሀታ ግዶን የገትዳ አሳ መላ፤</para>
  <para style="q2" vid="PSA 88:5">ሀይቅድ ዱፎን ዝንእዳ አሳ መላ።</para>
  <para style="q1" vid="PSA 88:5">ህዛፐ ኔኒ ሀሳዮና አስነ</para>
  <para style="q2" vid="PSA 88:5">ኔፐ ዱፅዳ አሳ መላ ግዳስ።<verse eid="PSA 88:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>ኔኒ ታና ጪሞን፥</para>
  <para style="q2" vid="PSA 88:6">ማ ኦላን የጋዳሳ።<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>ነ ሀንቆይ ታና ዴፄስ፤</para>
  <para style="q2" vid="PSA 88:7">ነ ሀንቁዋ ቤታይ ታና ሙክስ። <char style="qs">ሳላሀ </char><verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>ኔኒ ታ ዳቦታ ታፐ ሃሳዳሳ፤</para>
  <para style="q2" vid="PSA 88:8">ኤንቲ ታና ሻተታና መላ ኦዳሳ።</para>
  <para style="q1" vid="PSA 88:8">ታና ተቅዶሶና፤</para>
  <para style="q2" vid="PSA 88:8">ከሳ ኤካናዉ ዳንዳእከ።<verse eid="PSA 88:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9"/>ጎዳዉ፥ አዛኖን ታ አይፈይ ተልጁምስ፤</para>
  <para style="q2" vid="PSA 88:9">ኡባ ጋላስ ታኒ ኔኮ ዋሳይስ፤</para>
  <para style="q2" vid="PSA 88:9">ታ ኩሽያ ኔኮ ምጫስ።<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>ሀይቅዳይሳታስ ነ ማላልስያባ ኦዬ?</para>
  <para style="q2" vid="PSA 88:10">ኤንቲ ደንድድ ነና ጋላቶናዬ? <char style="qs">ሳላሀ </char><verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>መርና ነ ሲቆይ ዱፎን፥</para>
  <para style="q2" vid="PSA 88:11">ነ አማነተይ ዮ በሳን ኦደትዬ?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>ነ ማላልስያ ኦሶይ ማን፥</para>
  <para style="q2" vid="PSA 88:12">ነ ፅሎተይ ዶገትዳ ቢታን ኤረትዬ?<verse eid="PSA 88:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>ጎዳዉ፥ ታ ኔኮ ዋሳይስ፤</para>
  <para style="q2" vid="PSA 88:13">ዎንታ ዎንታ ታ ዎሳይ ነ ስን ጋኬስ።<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>ጎዳዉ፥ ነ ታና አይስ እፃይ?</para>
  <para style="q2" vid="PSA 88:14">ነ ሶምኡዋ ታፐ አይስ ገንይ?<verse eid="PSA 88:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>ናአተፈ ዶማዳ ታኒ ኡንኤታስ፤</para>
  <para style="q2" vid="PSA 88:15">ሀይቆስ ማታስ፤</para>
  <para style="q2" vid="PSA 88:15">ነ ታና ዳጋንን ኡፋይስ ቃንፃስ።<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>ነ ሱልያ ሀንቆይ ታ ቦላ ኡሽስ፤</para>
  <para style="q2" vid="PSA 88:16">ነ ዳጋንይ ታና ይስስ።<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>ኤንቲ ጋላስ ኩመ ድኦዳ ታና ተቅዶሶና፤</para>
  <para style="q2" vid="PSA 88:17">እስፈ ሺቅድ ታና ኦይክዶሶና።<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>ታ ላገታነ</para>
  <para style="q2" vid="PSA 88:18">ታዉ ማታ አሳታ ታፐ ሃሳዳሳ፤</para>
  <para style="q2" vid="PSA 88:18">ታዉ ዳቦይ ማ ፃላላ።<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="s1">አማንያ ፆሳስ የፅተ</para>
  <para style="d">እዝራኤላ አድያ ኤታና ማዝሙረ</para>
  <para style="d">አኬካን ፃፍዳ ግንፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 89:1"/>ጎዳዉ፥ ነ ሲቁዋባ ታኒ መርናዉ የፃና፤</para>
  <para style="q2" vid="PSA 89:1">ነ አማነተ የለታ ኡባስ አዋጃና።<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>ነ ሲቆይ መርናዉ ኤቅዳይሳነ</para>
  <para style="q2" vid="PSA 89:2">ቱማተ ኔኒ ሳሎን ምንዳ ኤስዳይሳ ኦዳና።<verse eid="PSA 89:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>ኔኒ፥ “ታ ዶርዳይሳራ ቃላ ገላስ፤</para>
  <para style="q2" vid="PSA 89:3">ታ አይልያ ዳዊታስ ሀይሳዳ ያጋዳ ጫቃስ፤<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘ታኒ ነ ኮቻ መርናዉ ካዎና፤</para>
  <para style="q2" vid="PSA 89:4">ነ አራታ የለታ ኡባን ምንና’ ” ያጋዳሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 89:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>ጎዳዉ፥ ሳሎት ነ ማላልስያ ኦሱዋ አዋጆ፤</para>
  <para style="q2" vid="PSA 89:5">ጌሻታ ሺቆይ ነ አማነተ ኦዶ።<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>ሳሎን ጎዳራ ልከታናዉ ዳንዳኤይ ኦኔ?</para>
  <para style="q2" vid="PSA 89:6">ሳሎ መተታ ግዶን ጎዳ መል ኦኔ?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>ጌሻታ ሺቁዋን ፆሳይ ያሽሴስ፤</para>
  <para style="q2" vid="PSA 89:7">እያ ዩሹዋን ደእያ ኡባፈ አድ ዳጋንስ።<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>ኡባፈ ዎልቃማ ጎዳዉ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 89:8">ነ መላ ዎልቃም ኦኔ?</para>
  <para style="q2" vid="PSA 89:8">ጎዳዉ፥ ኔኒ ኡባባን አማነታሳ።<verse eid="PSA 89:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>ኔኒ ጉምያ አባ ዎልቃ ኪታሳ፤</para>
  <para style="q2" vid="PSA 89:9">ደንድያ ዙልያ ስእ ኦሳ።<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>ራኣባ ጌተትያ ዶአ መንረዳሳ፤</para>
  <para style="q2" vid="PSA 89:10">ነ ሞርከታ ነ ዎልቃማ ቀስያን ላላዳሳ።<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>ሳሎይነ ሳእ ነባ፤</para>
  <para style="q2" vid="PSA 89:11">አላምያነ እያን ደእያ ኡባ መዳይ ነና።<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>ፑደሀነ ዱገሀ ነ መዳሳ፤</para>
  <para style="q2" vid="PSA 89:12">ታቦረነ አርሞና ዙማት፥</para>
  <para style="q2" vid="PSA 89:12">ኡፋይሳን ነ ሱን ሳቦሶና።<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>ነዉ ዎልቃማ ቀሰይ ደኤስ፤</para>
  <para style="q2" vid="PSA 89:13">ነ ኩሸይ ምኖ፤</para>
  <para style="q2" vid="PSA 89:13">ነ ኡሻቻ ኩሸይ ቁ ግስ።<verse eid="PSA 89:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>ፅሎተነ ሱረ ፕርድ ነ አራታስ ባሶ፤</para>
  <para style="q2" vid="PSA 89:14">ሲቆይነ ቱማተ ነ ስንን ቦሶና።<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>ጎዳዉ፥ ኡፋይሳን እልለይሳትነ</para>
  <para style="q2" vid="PSA 89:15">ነ ሶምኡዋ ፖኡዋን ሄመተይሳት አንጀትዳይሳታ።<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>ነ ሱንን ጋላስ ኩመ ኡፋይቶሶና፤</para>
  <para style="q2" vid="PSA 89:16">ኤንቲ ነ ፅሎተ ቁ ቁ ኦሶና።<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>ኤንቲ ጬቀትያ ዎልቃይ ነና፤</para>
  <para style="q2" vid="PSA 89:17">ነ ቴማን ኑ ካጨይ ቁ ቁ ግስ።<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>ኑ ጎንዳለይ ኑ ጎዳ ኩሸና፤</para>
  <para style="q2" vid="PSA 89:18">ኑ ካዎይካ እስራኤለ ጌሻ ኩሸና።<verse eid="PSA 89:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>በን ኔኒ፥ ነ አማነትዳ አሳስ</para>
  <para style="q2" vid="PSA 89:19">ቆንጨን ሀይሳዳ ያጋዳሳ።</para>
  <para style="q1" vid="PSA 89:19">“ታኒ እስ ኦላንቹዋ ማዳስ፤</para>
  <para style="q2" vid="PSA 89:19">አሳ ግዶፈ ዶረትዳይሳ ቁ ቁ ኦስ።<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>ታ አይልያ ዳዊታ ደማስ፤</para>
  <para style="q2" vid="PSA 89:20">ታ ጌሻ ዛይትያ ትያዳ እያ ካዎስ።<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>ታ ኩሸ እያራ ዳና፤</para>
  <para style="q2" vid="PSA 89:21">ታ ቀሰይ እያ ምንና።<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>እያ አይ ሞርከይካ ጊርሰና፤</para>
  <para style="q2" vid="PSA 89:22">አይ ኢታ አስካ እያ ሃረና።<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>እያ ሞርከታ ታ እያ ስንን ትንቸረና፤</para>
  <para style="q2" vid="PSA 89:23">እያ እፀይሳታ ሾጫ የጋና።<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>ታ ቱማተይነ ታ ሲቆይ እያራ ግዳና፤</para>
  <para style="q2" vid="PSA 89:24">ታ ሱንን እያ ካጨይ ቁ ቁ ጋና።<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>ታኒ እያ ካዎተ መደትራነ አባ፥</para>
  <para style="q2" vid="PSA 89:25">እያ ዛዋ ሻፋታ ጋካናዉ አሳና።<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>እ ታና፥ ‘ኔኒ ታ አዋ፥ ታ ፆሳ፤</para>
  <para style="q2" vid="PSA 89:26">ታና አሽያ ዛላ’ ያግድ ፄጋና።<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>ታኒ እያ ባይራ ናአ ኦና፤</para>
  <para style="q2" vid="PSA 89:27">ሳአን ደእያ ካዎታ ኡባፈ እያ ግታያና።<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>ታኒ ታ ሲቁዋ መርናዉ እያዉ ናጋና፤</para>
  <para style="q2" vid="PSA 89:28">ታኒ እያራ ጫቅዳ ጫቁዋ ምንና።<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>ታኒ እያ ኮቻ መርናዉ ምንዳ ኤሳና፤</para>
  <para style="q2" vid="PSA 89:29">እያ አራታ ሳሎዳ ጋምእሳና።”<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>“ሽን እያ ኮቻት ታ ህግያ አግኮ፥</para>
  <para style="q2" vid="PSA 89:30">ኤንቲ ታ ዎጋዳ ሄመቶና እፅኮ፥<verse eid="PSA 89:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="PSA 89:31"/>ታ አዋጁዋ ሻርኮ፥</para>
  <para style="q2" vid="PSA 89:31">ታ ኪታ ናጎና እፅኮ፥<verse eid="PSA 89:31"/></para>
  <para style="q2">
    <verse number="32" style="v" sid="PSA 89:32"/>ታኒ ኤንታ ናጋራ ግሾ ፃምአን፥</para>
  <para style="q2" vid="PSA 89:32">ኤንታ ኢታተ ግሾ ልሶን ሴራና።<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>ሽን ታኒ ታ ሲቁዋ እያፐ ኤክከ፤</para>
  <para style="q2" vid="PSA 89:33">ታኒ እያዉ መርናዉ አማነታና።<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>ታኒ ኤንታራ ጫቅዳ ጫቁዋ መንከ፤</para>
  <para style="q2" vid="PSA 89:34">ታ ዶናፐ ከይዳ ቃላ ላምከ።<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>ታኒ እስ ቶሆ ታ ጌሻተን ጫቅዳ ግሾ፥</para>
  <para style="q2" vid="PSA 89:35">ዳዊታስ ዎርዶትከ።<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>እያ ኮቻይ መርናዉ ዳና፤</para>
  <para style="q2" vid="PSA 89:36">እያ አራታይ ታ ስንን አዋዳ ጋምአና።<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>ሳሎን አማነትያ ማርካ ግድዳ አጌናዳ፥</para>
  <para style="q2" vid="PSA 89:37">እያ ካዎተይ መርናዉ ምንድ ዳና” ያጋዳሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 89:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>ሽን ሀእ ነ ትይዳ ካዋ ቦላ ሀንቀታዳሳ፤</para>
  <para style="q2" vid="PSA 89:38">እያ እፃዳሳ፤ አጋዳሳ።<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>ነ አይልያራ ጫቅዳ ጫቁዋ መንዳሳ፤</para>
  <para style="q2" vid="PSA 89:39">እያ ካላቻ ባናን ሆላዳ ቱንሳዳሳ።<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>እያ ካታማ ግምበ ድርሳ ላላዳሳ፤</para>
  <para style="q2" vid="PSA 89:40">እያ ሚፃ ይሳዳሳ።<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>ኦገራ አያ ኡባይ እያ ቦንቅዶሶና፤</para>
  <para style="q2" vid="PSA 89:41">እ ባ ሾሮታስ ሚቻስ አትስ።<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>እያ ሞርከታስ ፆኖ እማዳሳ፥</para>
  <para style="q2" vid="PSA 89:42">ኤንታ ኡባ ኡፋይሳዳሳ።<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>እያ ማሻ ፄራ ቃላምአዳሳ፤</para>
  <para style="q2" vid="PSA 89:43">እያ ኦላን ማዳባካ።<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>እያ ካዎታ ፃምኣ እያ ኩሸፐ ኤካዳሳ፤</para>
  <para style="q2" vid="PSA 89:44">እያ አራታ ቢታን ሆላዳሳ።<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>እያ ያላጋተ ዎድያ ቃምሳዳሳ፤</para>
  <para style="q2" vid="PSA 89:45">እያ ዬላ ማይዛዳሳ። <char style="qs">ሳላሀ </char><verse eid="PSA 89:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>ጎዳዉ፥ ኔኒ አዉደ ጋካናዉ ጋምአይ?</para>
  <para style="q2" vid="PSA 89:46">ኔኒ መርናዉ ጌማኔ?</para>
  <para style="q2" vid="PSA 89:46">ነ ሀንቆይ ታማዳ አዉደ ጋካናዉ ኤፃኔ?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>ታ ላይይ አይ መላ ቃንኮ ቆፓ፤</para>
  <para style="q2" vid="PSA 89:47">አሳ ኡባ ጮ መላ መድ!<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>ሀይቆፐ አታናዉ ዳንዳእያ አስ ደኢ?</para>
  <para style="q2" vid="PSA 89:48">ዱፎ ገሎና ዳናዉ ዳንዳኤይ ኦኔ? <char style="qs">ሳላሀ </char><verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>ጎዳዉ፥ ኔኒ ነ ቱማተን ዳዊታስ ጫቅዳ፥</para>
  <para style="q2" vid="PSA 89:49">ነ ሲቆይ አዉን ደኢ?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>ጎዳዉ፥ ነ አይለይ አይ መላ ቦረትዳኮ በአ፤</para>
  <para style="q2" vid="PSA 89:50">አሳ ኡባ ቦርያ ዋታ ዳንዳእዳኮ ሀሳያ።<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>ጎዳዉ፥ ነ ሞርከት ቀልቅስዳይሳ፥</para>
  <para style="q2" vid="PSA 89:51">ነ ትይዳ ካዋ ታንጎን ታንጎን ቦረይሳ በአ።<verse eid="PSA 89:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>ጎዳይ መርናዉ ጋላተቶ!</para>
  <para style="b" vid="PSA 89:52"/>
  <para style="qc" vid="PSA 89:52">አምንእ! አምንእ!<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">ኦይዳን ማፃፋ</para>
  <para style="mr">(<ref loc="PSA 90-106">ማዝ 90—106</ref>)</para>
  <para style="s1">መርናዉ ደእያ ፆሳ</para>
  <para style="d">ፆሳ አስ ግድዳ ሙሰ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 90:1"/>ጎዳዉ፥ ኔኒ የለታፐ የለታ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 90:1">ኑኒ ደእያ በሲ ግዳዳሳ።<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>ደረት መታናፐ ካሰ፥</para>
  <para style="q2" vid="PSA 90:2">ሳእ ኦሰታናፐ ካሰ፥</para>
  <para style="q2" vid="PSA 90:2">መርናፐ መርና ጋካናዉ ነ ፆሰ።<verse eid="PSA 90:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>ኔኒ፥ “አሳ ናይቶ፥ ጉየ ቢታኮ ስምተ” ያጋዳ፥</para>
  <para style="q2" vid="PSA 90:3">ኤንታ መትዳ ቢታኮ ጉየ ዛራሳ።<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>ሙኩሉ ላይ ዝነ አዳ ጋላሳ መላ፤</para>
  <para style="q2" vid="PSA 90:4">ዎይኮ እስ ቃማ ግዶን እስ ሳተ መላ።<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>ኔኒ አሳ ቆፖና ድኦዳ ኤፋሳ፤</para>
  <para style="q2" vid="PSA 90:5">ኤንቲ አሙሆ መላ፤</para>
  <para style="q2" vid="PSA 90:5">ዎንታ ዎንታ ዶልያ ማታ መላ።<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>ማት ዎንታ ድጭድ ጭዬስ፤</para>
  <para style="q2" vid="PSA 90:6">ኦማርስያ ዎደ ሹልድ መሌስ።<verse eid="PSA 90:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>ኑኒ ነ ይሉዋን ዉርዳ፤</para>
  <para style="q2" vid="PSA 90:7">ነ ሀንቁዋ ሱሎን ዳጋምዳ።<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>ኑ ኢታ ኦሱዋ ነ ስንን ዎዳሳ፤</para>
  <para style="q2" vid="PSA 90:8">ኑ ጌምዳ ናጋራ ነ ሶምኡዋ ፖኡዋን ዎዳሳ።<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>ኑ ጋላሳ ኡባይ ነ ሀንቁዋን አስ፤</para>
  <para style="q2" vid="PSA 90:9">ኑ ላይ ኦለን ዉርሶስ።<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>ኑ ደኦ ላይይ ላፑን ታማ፤</para>
  <para style="q2" vid="PSA 90:10">ዎይኮ ዳርኮ ሆስፑን ታማ።</para>
  <para style="q1" vid="PSA 90:10">ሄስካ መቶይነ ዋየይ ኩምዳይሳ፤</para>
  <para style="q2" vid="PSA 90:10">ኑ ላይይ ኤሶን ዉሬስ፤ ኑካ ኤሶን አኦስ።<verse eid="PSA 90:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>ነ ሀንቁዋ ዎልቃ ኤረይ ኦኔ?</para>
  <para style="q2" vid="PSA 90:11">ነ ሀንቁዋ ሱሎይ ዎልቃማ።<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>ኑ ላይ ማራ ኦገን ኑ ጎኤታና መላ፥</para>
  <para style="q2" vid="PSA 90:12">ኑና ጭንጫተ ታማርሳ።<verse eid="PSA 90:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>ጎዳዉ፥ ነ ሀንቆይ አዉደ ጋካናሴ?</para>
  <para style="q2" vid="PSA 90:13">ሀያና ነ አይለታስ ቃታ።<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>ኑ ላይ ኡባን</para>
  <para style="q2" vid="PSA 90:14">ኑ ኡፋይታናዳነ የፃናዳ፥</para>
  <para style="q2" vid="PSA 90:14">ዎንታ ዎንታ ነ ሲቁዋ ኑና ካልሳ።<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>ነ ኑና መቶዳ ጋላሳታ ኬና፥</para>
  <para style="q2" vid="PSA 90:15">ኑኒ ኡንኤትዳ ላይታ ኬና ኑና ኡፋይሳ።<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>ኑስ ነ አይለታስ ነ ኦሶይ ቆንጮ፤</para>
  <para style="q2" vid="PSA 90:16">ነ ቦንቾይ ኤንታ ናይታስ በንቶ።<verse eid="PSA 90:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>ጎዳ ኑ ፆሳ ኬሀተይ ኑ ቦላ ግዶ፤</para>
  <para style="q2" vid="PSA 90:17">ኑ ኩሸ ኦሶ ኡባ ኑስ አይፍሳ፤</para>
  <para style="q2" vid="PSA 90:17">ኤ፥ ኑ ኩሸ ኦሶ ኡባ አይፍሳ።<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="s1">ፆሳ ናጎ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 91:1"/>ኡባፈ ቃ ፆሳን ናገትድ ደኤይ፥</para>
  <para style="q2" vid="PSA 91:1">ኡባፈ ዎልቃማ ፆሳ ኩያን አቄስ።<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>እ ጎዳ፥ “ኔኒ ታዉ ሚፃነ ቆሰታ አትያ በሲ፥</para>
  <para style="q2" vid="PSA 91:2">ኔኒ ታና አማንያ ታ ፆሳ” ያጋና።<verse eid="PSA 91:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>እ ነና ሻንካንቾታ ፅሄፐ፥</para>
  <para style="q2" vid="PSA 91:3">ዎድ ኦንግያ ጋዶፐ አሻና።<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>እ ባ ባለታን ነና ካማና፤</para>
  <para style="q2" vid="PSA 91:4">እያ ቀፍያ ጋርሳን ኔኒ ቆሰታዳ አታና፤</para>
  <para style="q2" vid="PSA 91:4">እያ አማነተይ ነዉ ጎንዳለነ ካተ።<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>ኔኒ ቃማ ዳጋንያባስ፥</para>
  <para style="q2" vid="PSA 91:5">ዎይኮ ጋላስ ፆንገትያ ቶራስ ያያካ።<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>ኔኒ ማን ኦይክያ ሀርገ፥</para>
  <para style="q2" vid="PSA 91:6">ዎይኮ ጋላሳ ሴታን ኦንግያ ጋዶ ህርጋካ።<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>ሙኩላይ ነ ምየን፥</para>
  <para style="q2" vid="PSA 91:7">ታሙ ሙኩላይ ነ ኡሻቻን ኩንዳና፤</para>
  <para style="q2" vid="PSA 91:7">ሽን ነና አይብካ ቦቸና።<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>ኢታት ሴረትሽን፥</para>
  <para style="q2" vid="PSA 91:8">ኔኒ ነ አይፈ ፃላላን በአና።<verse eid="PSA 91:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>ኔኒ ጎዳ ነዉ ቆሰታዳ አትያ በሲ ኦዳ ግሾነ፥</para>
  <para style="q1" vid="PSA 91:9">ኡባፈ ቃ ፆሳ ነ ደእያ በሲ ኦዳ ግሾ፥<verse eid="PSA 91:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 91:10"/>ኢታባይ ነና ቦቸና፤</para>
  <para style="q2" vid="PSA 91:10">ጋዶይ ነ ኬኮ ሺቀና።<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>ነ ኦገ ኡባን ነና ናጋና መላ፥</para>
  <para style="q2" vid="PSA 91:11">ፆሳይ ባ ኪታንቾታ ኪታና።<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>ነ ቶሆይ ሹቻን በቶና መላ፥</para>
  <para style="q2" vid="PSA 91:12">ኪታንቾት ባንታ ኩሸን ነና ደንና።<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>ኔኒ ጋሞነ ሾሻ ቦላ ሄመታና፤</para>
  <para style="q2" vid="PSA 91:13">ዎዳላ ጋሞነ ኢታ ሾሻ የና።<verse eid="PSA 91:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>ፆሳይ፥</para>
  <para style="q2" vid="PSA 91:14">“እ ታና ሲቅዳ ግሾ ታኒ እያ አሻና፤</para>
  <para style="q2" vid="PSA 91:14">ታ ሱን ኤርያ ግሾ ታኒ እያ ናጋና።<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>እ ታና ፄግያ ዎደ ታኒ እያዉ ኮያና፤</para>
  <para style="q2" vid="PSA 91:15">መቶ ዎደ ታኒ እያራ ግዳና፤</para>
  <para style="q2" vid="PSA 91:15">ታኒ እያ አሻናነ ቦንቻና።<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>ታኒ እያ ላይ አዱሳና፤</para>
  <para style="q2" vid="PSA 91:16">ታ አቶተ እያ በሳና” ያጌስ።<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="s1">ፆሳ ኦሶይ ግታ</para>
  <para style="d">ሳምባታ ጋላሳ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 92:1"/>ጎዳ ጋላቶይ ሎኦ፤</para>
  <para style="q2" vid="PSA 92:1">ኡባፈ ቃ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 92:1">ነ ሱን ሳቦይ ሎኦ።<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>ዎንታ ዎንታ ነ ሲቁዋ ኦዶይ፥</para>
  <para style="q2" vid="PSA 92:2">ቃማ ነ አማነተ አዋጆይ ሎኦ።<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>ታሙ ሻያን ዋፀትዳ ዲን</para>
  <para style="q2" vid="PSA 92:3">ማስንቆ ካእሸ ነና ጋላቶይ ሎኦ።<verse eid="PSA 92:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>ታኒ ነ ኦሱዋን ኡፋይትዳ ግሾ፥</para>
  <para style="q2" vid="PSA 92:4">ነ ኩሸ ኦሱዋ ግሾ ነና ጋላታይስ።<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>ጎዳዉ፥ ነ ኦሶይ አይ መላ ግተ!</para>
  <para style="q2" vid="PSA 92:5">ነ ቆፋይ አይ መላ ጪሞ!<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>ኤያ አስ ኤራናዉ ዳንዳኤና፤</para>
  <para style="q2" vid="PSA 92:6">ዎዛን ባይና አስ አኬካናዉ ዳንዳኤና።<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>ኢታት ማታዳ ድጭኮካ፥</para>
  <para style="q2" vid="PSA 92:7">ኢታ ኦይሳት ዳይኮካ፥</para>
  <para style="q2" vid="PSA 92:7">ኤንቲ መርናዉ ያና።<verse eid="PSA 92:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>ሽን አቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 92:8">ኔኒ መርናዉ ኡባፈ ቃ።<verse eid="PSA 92:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>አቤት ጎዳዉ፥ ቱማ ነ ሞርከት ያና፤</para>
  <para style="q2" vid="PSA 92:9">ኢታ ኦያ ኡባይ ፕስክ ጋና።<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>ታ ካጭያ መን ካጨዳ ቁ ኦዳሳ፤</para>
  <para style="q2" vid="PSA 92:10">ሎኦ ዛይተ ታ ሁጰን ትያዳሳ።<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>ታ ሞርከት ፆነትሽን ታ አይፈን በአስ፤</para>
  <para style="q2" vid="PSA 92:11">ታና ኡንኤይሳት ዋስሽን ታ ሀይን ስአስ።<verse eid="PSA 92:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>ፅሎት ዛምባዳ ድጫና፤</para>
  <para style="q2" vid="PSA 92:12">ልባኖሰ ዝጋዳ ዳያና።<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>ኤንቲ ጎዳ ኬን ቶከትዳ ም መላ፤</para>
  <para style="q2" vid="PSA 92:13">ኤንቲ ኑ ፆሳ ዳባባን ዳና።<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>ኤንቲ ጬግድካ አይፋና፤</para>
  <para style="q2" vid="PSA 92:14">ኤንቲ እርፃነ ጭልኦ ግድድ ዳና።<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>ኤንቲ፥ “ጎዳይ ሱረ፤</para>
  <para style="q2" vid="PSA 92:15">እ ታ ዛላ፤ እያን ኢታተ ባዋ” ያጋና።<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="s1">ፆሳይ ሃሬስ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 93:1"/>ጎዳይ ካዎትስ!</para>
  <para style="q2" vid="PSA 93:1">ፆሳይ ቦንቾ ማእስ፤ ዎልቃ ዳንጭስ፤</para>
  <para style="q2" vid="PSA 93:1">ሳእ ምንድ ኤቅስ፤ ቃፀና።<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>ነ አራታይ በንፐ ኤቅድ ደኤስ፤</para>
  <para style="q2" vid="PSA 93:2">ኔኒ መርናዉ ደኣሳ።<verse eid="PSA 93:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>ጎዳዉ፥ ሻፋይ ጉምስ፤</para>
  <para style="q2" vid="PSA 93:3">ሃይ ባ ጉን ቁ ኦስ</para>
  <para style="q2" vid="PSA 93:3">ሃ ዙልያ ግርሳይ ስኤትስ።<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>ሳሎን ደእያ ጎዳይ፥</para>
  <para style="q2" vid="PSA 93:4">ዳሮ ሃ ጉንፈ፥</para>
  <para style="q2" vid="PSA 93:4">አባ ዙልያፐ አድ ዎልቃማ።<verse eid="PSA 93:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>አቤት ጎዳዉ፥ ነ ህገይ አማነትዳይሳ፤</para>
  <para style="q2" vid="PSA 93:5">ነ ኬይ መርናዉ ጌሻተን አሌቃና።<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="s1">ፆሳይ ባ አሳ አገና</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 94:1"/>ጎዳዉ፥ ኔኒ ሀሎ ከይያ ፆሲ፤</para>
  <para style="q2" vid="PSA 94:1">ኩሸ ዛርያ ፆሳዉ፥ ነ ቦንቹዋ በሳ።<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>አቤት ሳኣ ፕርድያ ፆሳዉ ደንዳ፤</para>
  <para style="q2" vid="PSA 94:2">ኦቶራንቾታስ በሲያ ሴራ እማ።<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>ጎዳዉ፥ አዉደ ጋካናዉ ጋምአይ?</para>
  <para style="q2" vid="PSA 94:3">ኢታት አዉደ ጋካናዉ ኡፋይታኔ?<verse eid="PSA 94:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>ኢታ ኦይሳት ኦቶሮ ቃላ ሃሳዮሶና፤</para>
  <para style="q2" vid="PSA 94:4">ኤንቲ ጮ ጬቀቶሶና።<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>ጎዳዉ፥ ኤንቲ ነ አሳ ሊቅሶሶና፤</para>
  <para style="q2" vid="PSA 94:5">ኤንቲ ነ ላታ ናቆሶና።<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>አምኤታነ በታንቾታ ዎኦሶና፤</para>
  <para style="q2" vid="PSA 94:6">አው ባይና ናይታ ሙጮሶና።<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>ኤንቲ፥ “ጎዳይ ኑና በኤና፤</para>
  <para style="q2" vid="PSA 94:7">ያይቆባ ፆሳይ አኬከና” ያጎሶና።<verse eid="PSA 94:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>ህንተኖ፥ አሳ ግዶፈ ኤያቶ፥ አኬክተ!</para>
  <para style="q2" vid="PSA 94:8">ህንተኖ፥ ኤያቶ ህንተ ጭንጫ ግዳናይ አዉዴ?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>ሀይ ኦዳ ፆሳይ ስኤኔ?</para>
  <para style="q2" vid="PSA 94:9">አይፈ መዳ ጎዳይ በኤኔ?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>ካዎተታ ሴርያ ፆሳይ ሴረኔ?</para>
  <para style="q2" vid="PSA 94:10">አሰ ኤራተ ታማርስያ እ፥ ኤረኔ?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>ጎዳይ አሳ ቆፍ ፓናባነ</para>
  <para style="q2" vid="PSA 94:11">ሀዳ ግደይሳ ኤሬስ።<verse eid="PSA 94:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>አቤት ጎዳዉ፥ ኔኒ ሴርያ አስነ</para>
  <para style="q2" vid="PSA 94:12">ነ ህግያ ታማርስያ አስ አንጀትዳይሳ።<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>ኢታት ኩንድያ ኦላይ ቦከታና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 94:13">መቶ ጋላስ ኔኒ እያ ሸምፕሳሳ።<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>ፆሳይ ባ አሳ የገና፤</para>
  <para style="q2" vid="PSA 94:14">እ ባ ላታ አገና።<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>ፕርድ ስሚድ ፅሎተ ቦላ ኤቃና፤</para>
  <para style="q2" vid="PSA 94:15">ዎዛና ሱረት ኡባይ ፅሎ ፕርዳ ካላና።<verse eid="PSA 94:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>ማካላንቾታ ቦላ ታ ግሾ ደንደይ ኦኔ?</para>
  <para style="q2" vid="PSA 94:16">ኢታ ኦይሳታራ ታ ግሾ ኤቀተይ ኦኔ?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>ጎዳይ ታና ማዶናኮ፥</para>
  <para style="q2" vid="PSA 94:17">ታኒ ኤሶን ዱፎ ገላዳ አታናሽን።<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>ታኒ፥ “ታ ቶሆይ ሀልፅስ” ግዳ ዎደ፥</para>
  <para style="q2" vid="PSA 94:18">ነ ሲቆይ ታና ካትስስ።<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>ታ ዎዛናን ኡንኤተ ኩምዳ ዎደ፥</para>
  <para style="q2" vid="PSA 94:19">ኔኒ ታና ዎፑ ኦዳ ኡፋይሳሳ።<verse eid="PSA 94:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>ህገ ሻርያ ጌላ ዳይናታራ</para>
  <para style="q2" vid="PSA 94:20">ጌላ አሳራ ኔኒ ሃሼታይ?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>ፅሎታ ዎናዉ ኤንቲ ቶቦሶና፤</para>
  <para style="q2" vid="PSA 94:21">ሱረታ ቦላ ሀይቆ ፕርዶሶና።<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>ግዶሽን ጎዳይ ታ ሚፃ፤</para>
  <para style="q2" vid="PSA 94:22">ታ ፆሳይ ታኒ ቆሰታዳ አትያ ዛላ።<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>ኤንታ ኢታተ ግሾ እ ኤንታ ሴራና፤</para>
  <para style="q2" vid="PSA 94:23">ኤንታ ናጋራ ግሾ እ ኤንታ ይሳና፤</para>
  <para style="q2" vid="PSA 94:23">ጎዳይ ኑ ፆሳይ ኤንታ ይሳና።<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="s1">ፆሳስ ጋላታ ማዝሙረ የፅተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 95:1"/>ሃይተ፤ አነ ጎዳ ሳቦስ፤</para>
  <para style="q2" vid="PSA 95:1">ኑና አሽያ ዛላስ ኡፋይሳን እልሎስ።<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>እያ ስን ጋላታራ ሺቆስ።</para>
  <para style="q2" vid="PSA 95:2">ጋላታ ማዝሙረ ኡፋይሳን የፆስ።<verse eid="PSA 95:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>ጎዳይ ዎልቃማ ፆሰ፤</para>
  <para style="q2" vid="PSA 95:3">ፆሳታ ኡባ ቦላ ግታ ካዎ።<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>ቢታ ጪሞት እያ ቃቃን ደኦሶና፤</para>
  <para style="q2" vid="PSA 95:4">ደርያ ፄራት እያባ።<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>እ መዳ ግሾ አባይ እያባ፤</para>
  <para style="q2" vid="PSA 95:5">መላ ቢታ እያ ኩሸይ ኦስ።<verse eid="PSA 95:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>ሃይተ፤ አነ ጉፋንድ እያ ጎይኖስ፤</para>
  <para style="q2" vid="PSA 95:6">ኑና መዳ ጎዳ ስንን ጉልባቶስ።<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>እ ኑ ፆሳ፤</para>
  <para style="q2" vid="PSA 95:7">ኑኒ እያ ቆሮን ደእያ ደረታ፤</para>
  <para style="q2" vid="PSA 95:7">ኑኒ እ ሄምያ እያ ዶርሳታ።</para>
  <para style="q2" vid="PSA 95:7">ጎዳይ ገይሳ ሀች ህንተ ስእኮ፥<verse eid="PSA 95:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8"/>ካሰ ህንተ ማይዛት ማርባን ሀንዳይሳዳ፥</para>
  <para style="q2" vid="PSA 95:8">ሄ ጋላስ ማሳን ባንታ ዎዛና ምንዳይሳዳ፥</para>
  <para style="q2" vid="PSA 95:8">ህንተ፥ ህንተ ዎዛና ምንፍተ።<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>ኤንቲ ታ ማላልስያ ኦሱዋ በእድካ፥</para>
  <para style="q2" vid="PSA 95:9">ታና ፓጭዶሶና፤ ታራ ኤቀትዶሶና።<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>ታኒ ሄ የለታ ቦላ ኦይታሙ ላይ ሻተታስ፤</para>
  <para style="q2" vid="PSA 95:10">“ኤንቲ ኡባ ዎደ ባንታ ዎዛናን ባልያ አሳታ፤</para>
  <para style="q2" vid="PSA 95:10">ኤንቲ ታ ኦግያ ኤሮኮና” ያጋስ።<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>ሄሳ ግሾ፥ “ኤንቲ ታ ሸምፖ በሳ ገሎኮና”</para>
  <para style="q2" vid="PSA 95:11">ያጋዳ ታ ሀንቁዋን ጫቃስ።<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="s1">ፆሳ ጌሻተን ጎይንተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 96:1"/>ጎዳስ ኦራ ማዝሙረ የፅተ፤</para>
  <para style="q2" vid="PSA 96:1">ሳአን ደእያ አሳ ኡባይ ጎዳስ የፅተ።<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>ጎዳስ የፅተ፤ እያ ሱን ሳቢተ፤</para>
  <para style="q2" vid="PSA 96:2">እያ አሹዋ ጋላስ ጋላስ ኦድተ።<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>ካዎተታ ግዶን እያ ቦንቹዋ፥</para>
  <para style="q2" vid="PSA 96:3">አሳ ኡባ ግዶን እያ ማላልስያ ኦሱዋ አዋጅተ።<verse eid="PSA 96:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>ጎዳይ ግታ ግድያ ግሾ እያዉ ግታ ጋላቲ በሴስ፤</para>
  <para style="q2" vid="PSA 96:4">ፆሳታ ኡባፈ አድ ያየታናዉ በሴስ።<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>ሀራ ካዎተታ ፆሳት ኡባይ ኤቃታ፤</para>
  <para style="q2" vid="PSA 96:5">ሽን ጎዳይ ሳሎታ መዳ ፆሳ።<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>ቦንቾይነ ሳብ እያ ዩሾን ደኤስ፤</para>
  <para style="q2" vid="PSA 96:6">ምኖተነ ፑላተ እያ ኬን ደኤስ።<verse eid="PSA 96:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>ቢታን ደእያ አሳ ዛረ ኡባይ ጎዳባ ኦድተ፤</para>
  <para style="q2" vid="PSA 96:7">ቦንቾይነ ዎልቅ ጎዳባ ጊተ።<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>እያ ሱንስ በሲያ ቦንቹዋ ጎዳስ ኤህተ፤</para>
  <para style="q2" vid="PSA 96:8">ያርሾ ኤክድ እያ ዳባባ ገልተ።<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>እያ ጌሻተ ቴሙዋን ጎዳ ጎይንተ፤</para>
  <para style="q2" vid="PSA 96:9">ቢታን ደእያ አሳዉ ኡባይ እያ ስንን ኮኮርተ።<verse eid="PSA 96:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>ካዎተታ ግዶን፥ “ጎዳይ ካዎትስ!</para>
  <para style="q2" vid="PSA 96:10">ሳአይ ምንድ ኤቅስ፤ ቃፀና፤</para>
  <para style="q2" vid="PSA 96:10">እ አሳ ቦላ ሱረ ፕርዳና” ያግተ።<verse eid="PSA 96:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>ሳሎት ኡፋይቶ፤ ሳእካ ሀሹ ጎ፤</para>
  <para style="q2" vid="PSA 96:11">አባይነ እያ ግዶን ደእያ ኡባይ ጉሞ።<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>ጎሻይነ እያን ደእያ ኡባይ ኡፋይቶ!</para>
  <para style="q2" vid="PSA 96:12">ዎራን ደእያ ም ኡባይ ኡፋይሳን የፆ።<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>ጎዳይ ያ ግሾ እያ ስንን የፆ፤</para>
  <para style="q2" vid="PSA 96:13">እ ሳአ ቦላ ፕርዳናዉ ዬስ።</para>
  <para style="q1" vid="PSA 96:13">እ ሀ ሳኣ ቦላ ፅሎተን፥</para>
  <para style="q2" vid="PSA 96:13">አሳ ቦላ ቱማተን ፕርዳና።<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="s1">ፆሳይ ኡባ ቦላ ጎዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 97:1"/>ጎዳይ ካዎትዳ ግሾ ሳአን ደእያ አሳይ ኡፋይቶ፤</para>
  <para style="q2" vid="PSA 97:1">ዩሾይ አባን ተቀትዳ ቢታት ኡፋይቶ።<verse eid="PSA 97:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>ሻርነ ሳካና ም እያ ዩሹዋን ደኤስ፤</para>
  <para style="q2" vid="PSA 97:2">ፅሎተነ ቱማተ እያ አራታ ባሶ።<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>ታም እያ ስንራ ቤስ፤</para>
  <para style="q2" vid="PSA 97:3">እያ ዩሹዋን ደእያ ሞርከታ ፁጌስ።<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>እያ ዎልአንይ ብታ ኡባ ፖእሴስ፤</para>
  <para style="q2" vid="PSA 97:4">ቢታይ ሄሳ በእድ ኮኮሬስ።<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>ደረት ጎዳ ስንን፥</para>
  <para style="q2" vid="PSA 97:5">ሳኣ ኡባ ጎዳ ስንን ሙቃዳዳ ትልእዶሶና።<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>ሳሎት እያ ፅሎተ አዋጆሶና፤</para>
  <para style="q2" vid="PSA 97:6">አሳ ኡባይ እያ ቦንቹዋ በኦሶና።<verse eid="PSA 97:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>ኤቃታ ጎይነይሳትነ</para>
  <para style="q2" vid="PSA 97:7">ኤንታን ጬቀተይሳት ኡባይ ዬላቶ፤</para>
  <para style="q2" vid="PSA 97:7">ኤቃት ኡባይ ጎዳስ ጉልባቶ።<verse eid="PSA 97:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>አቤት ጎዳዉ፥ ፅዮነይ</para>
  <para style="q2" vid="PSA 97:8">ነ ፅሎ ፕርዳ ስእድ ኡፋይቴስ፤</para>
  <para style="q2" vid="PSA 97:8">ይሁዳ ማጫ ናይትካ ሀሹ ጎሶና።<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>አቤት ጎዳዉ፥ ኔኒ ሳአ ኡባ ቦላ ቃ፤</para>
  <para style="q2" vid="PSA 97:9">ፆሳታ ኡባፈ ኔኒ ቁ ጋዳሳ።<verse eid="PSA 97:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>ጎዳ ዶሰይሳቶ፥ ኢታ እፅተ፤</para>
  <para style="q2" vid="PSA 97:10">እያን አማነተይሳታ ሸምፑዋ እ ናጌስ፤</para>
  <para style="q2" vid="PSA 97:10">ኢታታ ኩሸፐ ኤንታ አሼስ።<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>ፅሎታ ቦላ ፖኦይ ፖኤስ፤</para>
  <para style="q2" vid="PSA 97:11">ዎዛና ሱረታስ ኡፋይስ ደኤስ።<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>ህንተኖ ፅሎቶ፥ ጎዳን ኡፋይትተ፤</para>
  <para style="q2" vid="PSA 97:12">እያ ጌሻ ሱን ጋላትተ።<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="s1">ፆሳስ ኡፋይሳን እልልተ</para>
  <para style="d">ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 98:1"/>ጎዳይ ማላልስያባ ኦዳ ግሾ፥</para>
  <para style="q2" vid="PSA 98:1">እያዉ ኦራ ማዝሙረ የፅተ።</para>
  <para style="q2" vid="PSA 98:1">እያ ኡሻቻ ኩሸይ፥ እያ ጌሻ ቀሰይ</para>
  <para style="q2" vid="PSA 98:1">እያዉ ፆኖ እሚስ።<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>ጎዳይ ባ ፆኑዋ ኤርስስ፤</para>
  <para style="q2" vid="PSA 98:2">ባ ፅሎተ ካዎተታስ ቆንጭስስ።<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>እ እስራኤለ አሳ ሲቀይሳነ</para>
  <para style="q2" vid="PSA 98:3">ኤንታዉ አማነተይሳ ሀሳይስ።</para>
  <para style="q1" vid="PSA 98:3">ሳኣ ጋፃ ጋካናዉ ደእያ አሳ ኡባይ</para>
  <para style="q2" vid="PSA 98:3">ኑ ፆሳ አቶተ በእዶሶና።<verse eid="PSA 98:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>ሳአ ቦላ ደእያ አሳዉ፥</para>
  <para style="q2" vid="PSA 98:4">ጎዳስ ኡፋይሳን የፅተ፤</para>
  <para style="q2" vid="PSA 98:4">ኡፋይሳን እልልሸ ሳቢተ።<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>ጎዳስ ዲ ዲፅተ፤</para>
  <para style="q2" vid="PSA 98:5">ዲንነ ማዝሙረን ጎዳ ሳቢተ።<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>ሱሱልኤነ ሞይዘ ፑንሸ፥</para>
  <para style="q2" vid="PSA 98:6">ኡፋይሳን ጎዳ ኑ ካዋ ስንን የፅተ።<verse eid="PSA 98:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>አባይነ አባ ግዶን ኩምዳ ኡባይ ጉሞ፤</para>
  <para style="q2" vid="PSA 98:7">ሳአይነ ሳኣ ቦላ ደእያ ኡባይ የፆ።<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>ሻፋት ባንታ ኩሽያ ባቆ፤</para>
  <para style="q2" vid="PSA 98:8">ዙማት እስፈ ጎዳ ስንን ኡፋይሳን የፆ።<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>ጎዳይ ሳኣ ቦላ ፕርዳናዉ ዬስ፤</para>
  <para style="q2" vid="PSA 98:9">እ ሀ ሳኣ ቦላ ፅሎተን</para>
  <para style="q2" vid="PSA 98:9">አሳ ቦላ ሱረተን ፕርዳና።<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="s1">ኑ ፆሳይ ጌሽ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 99:1"/>ጎዳይ ካዎትዳ ግሾ ካዎተት ኮኮሮ፤</para>
  <para style="q2" vid="PSA 99:1">አራታ ቦላ ክሩበታ ግዶን ኡትዳ ግሾ፤</para>
  <para style="q2" vid="PSA 99:1">ቢታይ ቃፆ።<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>ጎዳይ ፅዮነን ግታ፤</para>
  <para style="q2" vid="PSA 99:2">ካዎተ ኡባፈ</para>
  <para style="q2" vid="PSA 99:2">እ ቁ ቁ ግስ።<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>ያሽያ እያ ግታ ሱን ኡባይ ጋላቶ፤</para>
  <para style="q2" vid="PSA 99:3">እ ጌሽ።<verse eid="PSA 99:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>ኔኒ፥ ዎልቃማ ካዎይ ሱረ ፕርዳ ዶሳሳ።</para>
  <para style="q2" vid="PSA 99:4">ኔኒ ያይቆባ ሱረተን ምንዳሳ።</para>
  <para style="q2" vid="PSA 99:4">ፅሎተ ኤሳዳሳ።<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>ጎዳ፥ ኑ ፆሳ ቁ ቁ ኦተ፤</para>
  <para style="q2" vid="PSA 99:5">እያ ቶሆይ የያ በሳን እያ ጎይንተ፤</para>
  <para style="q2" vid="PSA 99:5">እ ጌሽ።<verse eid="PSA 99:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>ሙሰይነ አሮን እያ ካህነታ ግዶፈ ኮይሮታ፤</para>
  <para style="q2" vid="PSA 99:6">ሳሜል እያ ዎስዳይሳታፐ እሱዋ።</para>
  <para style="q2" vid="PSA 99:6">ኤንቲ ጎዳኮ ዋስዶሶና፤</para>
  <para style="q2" vid="PSA 99:6">እ ኤንታ ስእስ።<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>እ ሻራ ቱሳ ግዶራ ኤንታዉ ሃሳይስ፤</para>
  <para style="q2" vid="PSA 99:7">እ እምዳ ህግያነ ዎጋ ናግዶሶና።<verse eid="PSA 99:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>አቤት ጎዳዉ፥ ኑ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 99:8">ነ ኤንታ ዎሳ ስአዳሳ።</para>
  <para style="q1" vid="PSA 99:8">ነ ኤንታና ማራዳሳ፤</para>
  <para style="q2" vid="PSA 99:8">ግዶሽን፥ ኤንታ ናጋራ ግሾ ኤንታ ሴራዳሳ።<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>ጎዳይ ኑ ፆሳይ፥ ጌሽ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 99:9">እያ ቁ ቁ ኦተ፤</para>
  <para style="q2" vid="PSA 99:9">እያ ጌሻ ዙማ ቦላ እያ ጎይንተ።<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="s1">ፆሳ ሲቆይ መርናሳ</para>
  <para style="d">ጋላታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 100:1"/>ቢታን ደእያ አሳ ኡባይ፥</para>
  <para style="q2" vid="PSA 100:1">ጎዳስ ኡፋይሳን እልልተ።<verse eid="PSA 100:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2"/>ጎዳስ ኡፋይሳን ሀጋዝተ፤</para>
  <para style="q2" vid="PSA 100:2">ኡፋይሳ የራ እያ ስን ሺቅተ።<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>ጎዳይ ፆሰ ግደይሳ ኤርተ፤</para>
  <para style="q2" vid="PSA 100:3">ኑና መዳይ እያ፤ ኑ እያባ፤</para>
  <para style="q2" vid="PSA 100:3">ኑኒ እያ አሰነ እያ ቆሮን ሄመትያ ዶርሳታ።<verse eid="PSA 100:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>እያ ፐንግያ ጋላታራ ገልተ፥</para>
  <para style="q2" vid="PSA 100:4">እያ ዳባባ ሳባራ ቢተ፤</para>
  <para style="q2" vid="PSA 100:4">እያ ጋላትተነ እያ ሱን አንጅተ።<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>ጎዳይ ኬሀ፤</para>
  <para style="q2" vid="PSA 100:5">እያ ሲቆይ መርናሳ፤</para>
  <para style="q2" vid="PSA 100:5">እያ አማነተይ የለታፐ የለታ ጋካናሳ።<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="s1">ታኒ ሱረ ኦገ ሄመታና</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 101:1"/>ታ ነ ሲቁዋባነ ነ ፅሎ ፕርዳባ የፃና፤</para>
  <para style="q2" vid="PSA 101:1">ጎዳዉ፥ ታ ነና ማዝሙረን ጋላታና።<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>ታኒ ሱረ ኦግያን ዳና፤</para>
  <para style="q2" vid="PSA 101:2">ኔኒ ታኮ አዉደ ያኔ?</para>
  <para style="q2" vid="PSA 101:2">ታኒ ታ ኬን ሱረተን ሄመታና።<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>ታኒ ታ አይፈይ ኢታባ ፄለና፤</para>
  <para style="q2" vid="PSA 101:3">ፆሳፈ ሃክዳ አሳ ኦሱዋ እፃይስ፤</para>
  <para style="q2" vid="PSA 101:3">ኤንቲ ታራ ጋሄቶኮና።<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>ዎዛና ጌላተ ታፐ ሃኮ፤</para>
  <para style="q2" vid="PSA 101:4">ኢታተስ በሰ እምከ።<verse eid="PSA 101:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>ጌማን ባ ላግያ ዝግርያ ኡራ ስእ ኦና፤</para>
  <para style="q2" vid="PSA 101:5">ኦቶርትያነ ጬቀትያ አስ ታኒ ዳንዳእከ።<verse eid="PSA 101:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>ኤንቲ ታራ ዳና መላ፥</para>
  <para style="q2" vid="PSA 101:6">ቢታ ቦላ ደእያ አማነትያ አሳታ</para>
  <para style="q1" vid="PSA 101:6">ታኒ ኬሀ አይፈን ፄላይስ፤</para>
  <para style="q2" vid="PSA 101:6">ሱረተን ሄመትያ አስ ታዉ ኪተቴስ።<verse eid="PSA 101:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>ጭምያ አስ ታ ኬን ዴና፤</para>
  <para style="q2" vid="PSA 101:7">ዎርዶ ሃሳያ አስ ታ ስንን ኤቀና።<verse eid="PSA 101:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>ቢታን ደእያ ኢታ አሳ፥</para>
  <para style="q2" vid="PSA 101:8">ታኒ ጋላስ ጋላስ ስእ ኦና።</para>
  <para style="q2" vid="PSA 101:8">ኢታ ኦይሳታ ኡባ</para>
  <para style="q2" vid="PSA 101:8">ታኒ ጎዳ ካታማፐ ሾዳና።<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="s1">ነ ሶምኡዋ ታፐ ገንፋ</para>
  <para style="d">ኡንኤትዳ ዎደ ፆሳ ስንን ዎስዳ አሳ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 102:1"/>ጎዳዉ፥ ታ ዎሳ ስአ፤</para>
  <para style="q2" vid="PSA 102:1">ታ ዋሶይ ኔኮ ጋኮ።<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>ታ ዋይያ ጋላስ ነ ሶምኡዋ ታፐ ገንፋ፤</para>
  <para style="q2" vid="PSA 102:2">ነ ሀይ ታኮ ዛራ፤</para>
  <para style="q2" vid="PSA 102:2">ታኒ ኔኮ ዋስያ ዎደ፥ ታና ኤሶን አላ።<verse eid="PSA 102:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>ታ ላይይ ጩያዳ ዬስ፤</para>
  <para style="q2" vid="PSA 102:3">ታ መቀይ ታማዳ ኤፄስ።<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>ታ ዎዛናይ ቡጭድ የግዳ ማታዳ መልስ፤</para>
  <para style="q2" vid="PSA 102:4">ካካ ታዉ ሜተተና።<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>ታኒ ታ ቃላ ቁ ኦዳ ኦልዳ ግሾ፤</para>
  <para style="q2" vid="PSA 102:5">ታ ጎጋይ መቀራ ኦይከትስ።<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>ታኒ ዎራን ደእያ ሶሎ መላ፥</para>
  <para style="q2" vid="PSA 102:6">ካይሳ ኬን ደእያ ጉቶ መላ።<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>ታኒ ዝንእን ስኮይ ዬና፤</para>
  <para style="q2" vid="PSA 102:7">ታኒ ኬ ሁጰን ባርካ ኡትዳ ካፎ ግዳስ።<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>ታ ሞርከት ጋላስ ኩመ ታና ጫዮሶና፤</para>
  <para style="q2" vid="PSA 102:8">ታና ቀልቅሰይሳት ታ ሱንን ባዶሶና።<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>ብዶይ ታዉ ካ ግድስ፤</para>
  <para style="q2" vid="PSA 102:9">ታ አፉይ ታ ኡሻራ ዋላከትስ።<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>ሄስ ሀንዳይ ነ ሀንቆይነ ነ ይሎይ፥</para>
  <para style="q2" vid="PSA 102:10">ታና ደንድ ዎራ ሆልዳ ግሾሳ።<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>ታ ላይይ ኦማርሳ ኩያ መላ ኤለስድ አስ፤</para>
  <para style="q2" vid="PSA 102:11">ታኒ ማታዳ ሹላይስ።<verse eid="PSA 102:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>ሽን ጎዳዉ፥ ኔኒ ነ አራታን መርናዉ ኡታዳሳ፤</para>
  <para style="q2" vid="PSA 102:12">ነ ሱንይ የለታፐ የለታ ጋካናዉ ሀሳየታና።<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>ኔኒ እዮ ማርያ ዎደይ ጋክዳ ግሾ፤</para>
  <para style="q2" vid="PSA 102:13">ደንዳዳ ፅዮነስ ቃታ፤</para>
  <para style="q2" vid="PSA 102:13">ኔኒ ዶርዳ ዎደይ ጋክስ።<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>እ ሹቻት ነ ኦሳንቾታስ አልኦ፤</para>
  <para style="q2" vid="PSA 102:14">እ ቢታይካ ኤንታ ቃስ።<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>ካዎተት ጎዳ ሱንስ ያያና፤</para>
  <para style="q2" vid="PSA 102:15">ሳኣ ካዎት እያ ቦንቹዋስ ዳጋማና።<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>ጎዳይ ፅዮነ ዛሪድ ኬፃና፤</para>
  <para style="q2" vid="PSA 102:16">ባ ግታተ በሳና።<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>እ ማንቆታ ዎሳ ስአና፤</para>
  <para style="q2" vid="PSA 102:17">ኤንታ ኦይሻ ካና።<verse eid="PSA 102:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>ቡሮ የለታና አሳይ ጎዳ ጋላታና መላ፥</para>
  <para style="q2" vid="PSA 102:18">ሀይስ ያ የለታስ ፃፈቶ።<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>ጎዳይ ቃን ደእያ</para>
  <para style="q2" vid="PSA 102:19">ባ ጌሻ በሳፈ ፄልስ፤</para>
  <para style="q2" vid="PSA 102:19">ሳሎን ግድድ ሳኣ ፆሞሴስ።<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>ሄስካ ቃሸትዳ አሳ ዋሱዋ ስአናዉነ</para>
  <para style="q2" vid="PSA 102:20">ሀይቆ ፕርደትዳ አሳ ብርሻናሳ።<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>ሄሳ ግሾ፥ ጎዳ ሱንይ ፅዮነን ኦደታና፤</para>
  <para style="q2" vid="PSA 102:21">እያ ጋላታይ የሩሳላመን አዋጀታና።<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>ደረይነ ካዎተይ ሺቅድ፥</para>
  <para style="q2" vid="PSA 102:22">ጎዳስ ሄ ዎደ ጎይናና።<verse eid="PSA 102:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>ታኒ ናአተን ደእሽን፥</para>
  <para style="q2" vid="PSA 102:23">ታ ዎልቃ እፅስስ፤ ታ ላይ ቃምስስ።<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>ታኒ፥ “ታ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 102:24">ታ ላይ ግዶ ዛዋን ታና ኮፋ” ያጋይስ።</para>
  <para style="q2" vid="PSA 102:24">ጎዳዉ፥ ኔኒ የለታፐ የለታ ጋካናዉ ደኣሳ።<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>ኔኒ በን ሳኣ መዳሳ፤</para>
  <para style="q2" vid="PSA 102:25">ሳሎይካ ነ ኩሸ ኦሶ።<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>ሀይሳቲ ኡባይ ያና፤ ሽን ኔኒ ዳና፤</para>
  <para style="q2" vid="PSA 102:26">ኤንቲ ኡባይ አፍላዳ ዉራና።</para>
  <para style="q1" vid="PSA 102:26">ኔኒ ኤንታ ጩርቃ አፍላዳ ላማና፤</para>
  <para style="q2" vid="PSA 102:26">ኤንትካ አና።<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>ሽን ኔኒ ነና፤</para>
  <para style="q2" vid="PSA 102:27">ነ ላይይ ዉረና።<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>ነ አይለታ ናይታ ኔኒ ሳሮ ዎሳ፤</para>
  <para style="q2" vid="PSA 102:28">ኤንታ ኮቻይ ነ ስንን ምንድ ዳና።<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="s1">ታ ሸምፐ ፆሳ ጋላታ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 103:1"/>ታ ሸምፐ ጎዳ ጋላታ!</para>
  <para style="q2" vid="PSA 103:1">ታ ኩመ አሳተዉ፥ እያ ጌሻ ሱን ጋላታ።<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>ታ ሸምፐ ጎዳ ጋላታ!</para>
  <para style="q2" vid="PSA 103:2">እ ነዉ ኦዳ ኬሀተ ኡባ ዶጎፓ።<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>እ ነ ናጋራ ኡባ አቶ ጌስ፤</para>
  <para style="q2" vid="PSA 103:3">ነ ሀርገ ኡባፈ ነና ፓስ።<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>እ ነና ሀይቆፐ አሼስ፤</para>
  <para style="q2" vid="PSA 103:4">ሲቆንነ ማሮታን ነና አንጄስ።<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>ነ ያላጋተይ አርጋንዳ ኦራፃና መላ፥</para>
  <para style="q2" vid="PSA 103:5">ነ ደኡዋ ሎኦባን ካልሴስ።<verse eid="PSA 103:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>ጎዳይ ቆሄትዳይሳታስ</para>
  <para style="q2" vid="PSA 103:6">ፅሎተንነ ሱረን ፕርዴስ።<verse eid="PSA 103:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>እ ባ ኦግያ ሙሰ፥</para>
  <para style="q2" vid="PSA 103:7">ባ ኦሱዋ እስራኤለ አሳ ኤርስስ።<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>ጎዳይ ቃተይሳነ ማረይሳ፤</para>
  <para style="q2" vid="PSA 103:8">ሀንቀታናዉ ኤሶተና፤ እያ ሲቆይ ዳሮ።<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>እ ኡባ ዎደ ሴረና፤</para>
  <para style="q2" vid="PSA 103:9">መርናዉ ሀንቀተና።<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>እ ኑስ ኑ ናጋራዳ ኦና፤</para>
  <para style="q2" vid="PSA 103:10">ኑ ኢታተ መላ ዛረና።<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>ሳሎይ ሳአፐ ቀይሳዳ፥</para>
  <para style="q2" vid="PSA 103:11">ጎዳ ያየይሳታስ እያ ሲቆይ ግታ።<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>ዶሎሀፐ ዉሎህ ሃከይሳዳ፥</para>
  <para style="q2" vid="PSA 103:12">ጎዳይ ኑ ናጋራ ኑፐ ሃሴስ።<verse eid="PSA 103:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>አው ባ ናይታስ ቃተይሳዳ፥</para>
  <para style="q2" vid="PSA 103:13">ጎዳይ ባዉ ያየይሳታስ ቃቴስ።<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>ኑኒ አይብፐ መትዳኮ እ ኤሬስ፤</para>
  <para style="q2" vid="PSA 103:14">ኑኒ ቢታ ግደይሳ እ አኬከስ።<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>አስ ባዉ ማታ መላ፤</para>
  <para style="q2" vid="PSA 103:15">እ ባዞ ጪሻዳ ጭዬስ።<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>ጫርኮይ እያ ቦላ ጫርክያ ዎደ ዬስ፤</para>
  <para style="q2" vid="PSA 103:16">እ ዶልዳ በሳይ ዛሪድ ኤረተና።<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>ሽን ጎዳስ ያየይሳታስ</para>
  <para style="q2" vid="PSA 103:17">እያ ሲቆይ መርናፐ መርና ጋካናሳ፤</para>
  <para style="q2" vid="PSA 103:17">እያ ፅሎተይ ናአ ናአ ጋካናሳ።<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>ሄስ ሀነይ እያ ጫቁዋ ናገይሳታነ</para>
  <para style="q2" vid="PSA 103:18">እያ ኪታ ፖላናዉ ምነይሳታሳ።<verse eid="PSA 103:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>ጎዳይ ሳሎታን ባ አራታ ኤስስ፤</para>
  <para style="q2" vid="PSA 103:19">እያ ካዎተይ ኡባ ሃሬስ።<verse eid="PSA 103:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>ህንተኖ፥ እያ ኪታንቻቶ፥</para>
  <para style="q2" vid="PSA 103:20">እያ ኪታ ናግያ ዎልቃማቶ፥</para>
  <para style="q2" vid="PSA 103:20">እ ኦድያባ ስኤይሳቶ፥ ጎዳ ጋላትተ!<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>ህንተኖ ሳሎን ደእያ ምኖቶ፥</para>
  <para style="q2" vid="PSA 103:21">እያ ሸንያ ፖለይሳቶ፥ ጎዳ ጋላትተ!<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>ህንተኖ፥ እ ሃርያ በሳ ኡባን፥</para>
  <para style="q2" vid="PSA 103:22">ደእያ መተቶ፥ ጎዳ ጋላትተ!</para>
  <para style="q2" vid="PSA 103:22">ታ ሸምፐ ጎዳ ጋላታ!<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="s1">ፆሳይ ባ መተ ሄሜስ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 104:1"/>ታ ሸምፐ፥ ጎዳ ጋላታ፤</para>
  <para style="q2" vid="PSA 104:1">አቤት ጎዳዉ፥ ታ ፆሳዉ ነ ግታ፤</para>
  <para style="q2" vid="PSA 104:1">ኔኒ ቦንቾነ ቴማ ማአዳሳ።<verse eid="PSA 104:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>ፖኦ አፍላዳ ጉሉንታዳሳ፤</para>
  <para style="q2" vid="PSA 104:2">ኔኒ ሳሉዋ ዱንካነዳ ቶላዳሳ።<verse eid="PSA 104:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3"/>ነ ኬ ሳሎ ቦላ ኬፃሳ፤</para>
  <para style="q2" vid="PSA 104:3">ሻራ ፓራ ጋረ ከሳሳ፤</para>
  <para style="q2" vid="PSA 104:3">ጫርኮ ቀፈ ቦላ ኡታዳ ባሳ።<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>ጫርኮይ ነዉ ኪታንቾ፥</para>
  <para style="q2" vid="PSA 104:4">ታማ ላጮ ነዉ ኦሳንቾ ኦሳ።<verse eid="PSA 104:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>ነ፥ ሳኣ እያ ባሱዋ ቦላ ኤሳዳሳ፤</para>
  <para style="q2" vid="PSA 104:5">ሄሳ ግሾ መርናዉ ቃፀና።<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>ጪሞ አባይ አፍላዳ ቢታ ካምስ፤</para>
  <para style="q2" vid="PSA 104:6">ሃይ ግታ ደረታ ካምስ።<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>ነ ሀንቀትን ሃት ባቃትዶሶና፤</para>
  <para style="q2" vid="PSA 104:7">ነ ደሹዋ ስእዳ ዎደ ቆሰትዶሶና።<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>ኤንቲ ደረታ ቦላነ ዛንጋራታ ግዶ፥</para>
  <para style="q2" vid="PSA 104:8">ነ ኤንታዉ ጊግስዳ በሳ ጎግዶሶና።<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>ሃት ስሚድ ቢታ ካሞናዳ፥</para>
  <para style="q2" vid="PSA 104:9">ኤንቲ አናዉ ዳንዳኦና ዛዋ ዎዳሳ።<verse eid="PSA 104:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>ኔኒ፥ ፑልቶት ዛንጋራን ጎጋናዳ ኦዳሳ፤</para>
  <para style="q2" vid="PSA 104:10">ሻፋ ሃት ደረታ ግዶራ ጎጎሶና።<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>ባዞ ዶአት ኡባይ እያፐ ኡዮሶና፤</para>
  <para style="q2" vid="PSA 104:11">ባዞ ሀረት እያፐ ሳሞ አሎሶና።<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>ሳሎ ካፎት ሄ ሃ ማታን ባንታ ኬ ኬፅድ፥</para>
  <para style="q2" vid="PSA 104:12">ታሽያ ግዶን የፆሶና።<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>ነ ግታ ደረታ ቦላ ሳሎፐ እራ ቡክሳሳ፤</para>
  <para style="q2" vid="PSA 104:13">እያ ኩሸ ኦሶ አይፈን ቢትያ ካላሱ።<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>ኔኒ መሄስ ማታ፥ አሳስ ካ ዶልሳሳ፤</para>
  <para style="q2" vid="PSA 104:14">ሄሳን አሳይ ቢታ ኦድ፥ ካ ሺሼስ። <verse eid="PSA 104:14"/><verse number="15" style="v" sid="PSA 104:15"/>አሳ ዎዛና ኡፋይስያ ዎይነ፥</para>
  <para style="q2" vid="PSA 104:15">ሶምኦ ጭልእስያ ዛይተነ</para>
  <para style="q2" vid="PSA 104:15">ዎልቃ እምያ ካ ዶልሳሳ።<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>ጎዳ ምት፥</para>
  <para style="q2" vid="PSA 104:16">እ ቶክዳ ልባኖሰ ዝጋት፥</para>
  <para style="q2" vid="PSA 104:16">ዳሮ እራ ደሞሶና።<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>ካፎት ባንታ ኬ ያን ኬፆሶና፤</para>
  <para style="q2" vid="PSA 104:17">ፅሎት ፂዳ ቦላ ኬፅድ ደኦሶና።<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>ቃ ደረታ ቦላ ጋራት ደኦሶና፤</para>
  <para style="q2" vid="PSA 104:18">ጉፓለት ሹቻ ቆጶን ቆሰቶሶና።<verse eid="PSA 104:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>ዎደ ታይቡዋ ኤርሳና መላ፥</para>
  <para style="q2" vid="PSA 104:19">ነ አጌና መዳሳ፤</para>
  <para style="q2" vid="PSA 104:19">አዋይ ባ ዉልያ ዎድያ ኤሬስ።<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>ኔኒ ማ መዳሳ፤ ቃማ ኦዳሳ፤</para>
  <para style="q2" vid="PSA 104:20">ሄ ማን ዎራ ዶእ ኡባይ ከዬስ።<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>ዎዳላ ጋሞት ሻንካትሸ ጉዶሶና፤</para>
  <para style="q2" vid="PSA 104:21">ኤንቲ ባንታዉ ምያባ ፆሳፈ ኮዮሶና።<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>አው ዶልያ ዎደ ጉየ ስሞሶና፤</para>
  <para style="q2" vid="PSA 104:22">ባንታ በሳ ገልድ ዝንኦሶና።<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>ሄ ዎደ አስ ባ ኦሶስ ከዬስ፤</para>
  <para style="q2" vid="PSA 104:23">ሳእ ቃማና ጋካናዉ ኦስ።<verse eid="PSA 104:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>አቤት ጎዳዉ፥ ነ ኦሶይ አይ መላ ዳሮ፤</para>
  <para style="q2" vid="PSA 104:24">ነ ጭንጫተን ነ ኤንታ ኡባ መዳሳ፤</para>
  <para style="q2" vid="PSA 104:24">ሳእ ነ መዳባን ኩምስ።<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>ሄኮ፥ አባይ ግታነ ዳልጋ፤</para>
  <para style="q2" vid="PSA 104:25">ታይቦይ ባይና ቃፅያ መተን፥</para>
  <para style="q2" vid="PSA 104:25">ግታታነ ጉ መተን ኩምድ ደኤስ።<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>እያ ቦላ ማርካበት ቦሶና፤</para>
  <para style="q2" vid="PSA 104:26">ነ መዳ ሌዋታነ ጌተትያ ዳወይ እያን ካኤስ።<verse eid="PSA 104:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>ነ ኤንታዉ ኮሽያ ዎድያን</para>
  <para style="q2" vid="PSA 104:27">ምያባ እማና መላ፥</para>
  <para style="q2" vid="PSA 104:27">ኤንቲ ኡባይ ነና ፄሎሶና።<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>ነ ኤንታዉ እምን ኤንቲ ማፆሶና፤</para>
  <para style="q2" vid="PSA 104:28">ኔኒ ነ ኩሽያ ምጭን፥</para>
  <para style="q2" vid="PSA 104:28">ኤንቲ ሎኦባ ካሎሶና።<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>ኔኒ ነ ሶምኡዋ ገንያ ዎደ ዳጋሞሶና፤</para>
  <para style="q2" vid="PSA 104:29">ኔኒ ሸምፑዋ ኤክያ ዎደ ሀይቅድ፥</para>
  <para style="q2" vid="PSA 104:29">ባንታ ቢታ ስሞሶና።<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>ሽን ኔኒ ነ ሸምፑዋ እምያ ዎደ፥</para>
  <para style="q2" vid="PSA 104:30">ኤንቲ መቶሶና፤ ቢታ ኦራፅሳሳ።<verse eid="PSA 104:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>ጎዳ ቦንቾይ መርናዉ ደኦ፤</para>
  <para style="q2" vid="PSA 104:31">ጎዳይ ባ ኦሱዋን ኡፋይቶ።<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>እ ቢታ ፄልያ ዎደ ቢታይ ቃፄስ፤</para>
  <para style="q2" vid="PSA 104:32">እ ደረታ ቦችያ ዎደ ደረት ጩዮሶና።<verse eid="PSA 104:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>ታ ደኦ ላይ ኡባን ጎዳስ የፃና፤</para>
  <para style="q2" vid="PSA 104:33">ታ ፓፃ ደእያ ዎደ ኡባን ታ ፆሳ ዛማራና።<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>ታኒ ጎዳን ኡፋይትያ ግሾ፥</para>
  <para style="q2" vid="PSA 104:34">ታ ቆፋይ እያ ኡፋይሶ።<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>ናጋራንቾት ቢታፈ ዮ፤</para>
  <para style="q2" vid="PSA 104:35">ኢታ ኦይሳት ደኦፖ።</para>
  <para style="q1" vid="PSA 104:35">ታ ሸምፐ፥ ጎዳ ጋላታ፤</para>
  <para style="q2" vid="PSA 104:35">ጎዳይ ጋላተቶ።<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="s1">ፆሳ ግታ ኦሱዋ ኦድተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 105:1"/>ጎዳ ጋላትተ፤ እያ ሱን ፄግተ፤</para>
  <para style="q2" vid="PSA 105:1">እ ኦዳባ ካዎተታስ ኦድተ።<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>እያ ሳቢተ፤ ጋላታ ማዝሙረ የፅተ፤</para>
  <para style="q2" vid="PSA 105:2">ማላልስያ እያ ኦሶ ኡባ ኦድተ።<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>እያ ጌሻ ሱንን ጬቅተ፤</para>
  <para style="q2" vid="PSA 105:3">ጎዳ ኮየይሳታ ዎዛናይ ኡፋይቶ።<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>ጎዳነ እያ ዎልቃን አማነትተ፤</para>
  <para style="q2" vid="PSA 105:4">ኡባ ዎደ እያ ኮይተ።<verse eid="PSA 105:4"/></para>
  <para style="q1">
    <verse number="5-6" style="v" sid="PSA 105:5-6"/>ህንተኖ፥ እያ አይልያ አብራሃመ ዛረቶ፥</para>
  <para style="q2" vid="PSA 105:5-6">ዶረትዳ ያይቆባ ናይቶ፥</para>
  <para style="q1" vid="PSA 105:5-6">እ ኦዳ ማላልስያባታ፥</para>
  <para style="q2" vid="PSA 105:5-6">እያ ማላታነ ሱረ ፕርዳ ሀሳይተ።<verse eid="PSA 105:5-6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>እ ጎዳ፥ ኑ ፆሳ፤</para>
  <para style="q2" vid="PSA 105:7">እያ ፕርዳይ ቢታ ኡባ ቦላና።<verse eid="PSA 105:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>እ ባ ጫቁዋ መርናዉ፥</para>
  <para style="q2" vid="PSA 105:8">ባ ገልዳ ቃላ ሙኩሉ የለታ ጋካናዉ ናጌስ።<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>እ አብራሃመራ ጫቅዳ ኡፋይሳ ቃላ፥</para>
  <para style="q2" vid="PSA 105:9">ይሳቃስ ገልዳ ኡፋይሳ ቃላ፥<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>ያይቆባስ ዎጋ፥</para>
  <para style="q2" vid="PSA 105:10">እስራኤለስ መርና ጫቁዋ</para>
  <para style="q2" vid="PSA 105:10">ኦድ ምንስ።<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>እ፥ “ካናነ ቢታ ነዉ እማና፤</para>
  <para style="q2" vid="PSA 105:11">እ ነ ኮቻ ጋክዳ ላታ ግዳና” ያግስ።<verse eid="PSA 105:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>ፆሳ አሳት ታይቦን ጉነ</para>
  <para style="q2" vid="PSA 105:12">ካናነ ቢታን በተ አስ ግድድ ደእያ ዎደ፥<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>እስ ደርያፐ ሀራ ደርያ፥</para>
  <para style="q2" vid="PSA 105:13">እስ ካዎተፈ ሀራ ካዎተ ዩይዶሶና።<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>ፆሳይ ኦንካ ኤንታ ኡንኤና መላ ኦቤና፤</para>
  <para style="q2" vid="PSA 105:14">ኤንታ ግሾ ካዎታ ሴርስ።<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“ታ ትይዳይሳታ ቦቾፍተ፤</para>
  <para style="q2" vid="PSA 105:15">ታ ናበታ ቆሆፕተ” ያግስ።<verse eid="PSA 105:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>ጎዳይ ቢታን ኮሻ የድድ፥</para>
  <para style="q2" vid="PSA 105:16">ኤንታ ካ ኡባ ይስስ።<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>ሽን እ ባ አሳ አሻናዉ፥</para>
  <para style="q2" vid="PSA 105:17">እስ አድያ ግብፀ ኪትስ፤</para>
  <para style="q2" vid="PSA 105:17">ሄ ኡራይ አይለ ግድድ ባይዘትዳ ዮሰፋ።<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>እያ ቶሆት ብራታን ዱፀትዶሶና፤</para>
  <para style="q2" vid="PSA 105:18">እ ሳንላታን ቃሸትስ።<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>እ ካሰ ኦድዳይስ ቱማታና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 105:19">ጎዳ ቃላይ እያ ፓጭስ።<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>ሄሳፈ ጉየ ግብፀ ካዎይ አሰ የድድ፥</para>
  <para style="q2" vid="PSA 105:20">እያ ቃሾ ኬፈ ከስስ።<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>እያ ባ ኬ ቦላ ጎዳ ኦስ፤</para>
  <para style="q2" vid="PSA 105:21">ባዉ ደእያ ኡባ ቦላ ሹምስ።<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>ባ ሞርናታ ዞራና መላ፥</para>
  <para style="q2" vid="PSA 105:22">ባ ጭማታ ጭንጫተ ታማርሳና መላ ሹምስ።<verse eid="PSA 105:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>እስራኤለይ ግብፀ ብስ፤</para>
  <para style="q2" vid="PSA 105:23">ያይቆብ ካማ ቢታን ኡትስ።<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>ጎዳይ ባ አሳ ዳርስስ፤</para>
  <para style="q2" vid="PSA 105:24">ኤንታ ሞርከታፐ አድ ኤንታ ምንስ።<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>ባ አሳ እፃና መላ ግብፀ አሳ ዎዛና ላምስ፤</para>
  <para style="q2" vid="PSA 105:25">ባ አይለታ ጭማና መላ ኦስ።<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>ባ አይልያ ሙሰነ</para>
  <para style="q2" vid="PSA 105:26">ባ ዶርዳ አሮና ኤንታኮ ኪትስ።<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>ኤንቲ ግብፀ አሳ ስንን ማላታ፥</para>
  <para style="q2" vid="PSA 105:27">ካማ ቢታን ማላልስያባ ኦዶሶና።<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>ጎዳይ ማ ኪትድ፥ ቢታ ምስስ፤</para>
  <para style="q2" vid="PSA 105:28">ሽን ግብፀ አሳይ እያ ኪታ ፖልቦኮና።<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>ኤንታ ሃ ሱ ላምድ፥</para>
  <para style="q2" vid="PSA 105:29">ሞሎታ ዎስ።<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>ኤንታ ቢታ ኡባ፥</para>
  <para style="q2" vid="PSA 105:30">ካዎ ጋካ ሾ ኩንስ።<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>እ ኪትን፥ ኡዱንፀነ ቢነ</para>
  <para style="q2" vid="PSA 105:31">ኤንታ ቢታ ኡባ ቦላ ቢነይ ዎስ።<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>እራ ግሾ ኤንታ ቢታ ቦላ</para>
  <para style="q2" vid="PSA 105:32">ሻች፥ ዳዳነ ዎልአን ቡክስስ።<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>እ ኤንታ ዎይንያነ ባላስያ ሾጭስ፤</para>
  <para style="q2" vid="PSA 105:33">ኤንታ ቢታን ደእያ ም መንረስ።<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>እ ኪትን፥ ቦለይነ</para>
  <para style="q2" vid="PSA 105:34">ታይቦይ ባይና ዱጎይ ከይስ።<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>ኤንታ ቢታን ዶልዳ ካ ኡባ ምስ፤</para>
  <para style="q2" vid="PSA 105:35">ጋደን ደእያ ጭልኦባ ኡባ ይስስ።<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>ጎዳይ ግብፀ አሳ ባይራ ናይታ ኡባ ዎስ፤</para>
  <para style="q2" vid="PSA 105:36">ኮይሮ የለትዳ ኡባ ይስስ።<verse eid="PSA 105:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>ሄሳፈ ጉየ፥ እስራኤለ አሳ</para>
  <para style="q2" vid="PSA 105:37">ዎርቃነ ብራ አሌቆራ ከስስ፤</para>
  <para style="q2" vid="PSA 105:37">ኤንታ ኮቻ ግዶፈ ጉየ አትዳይ ኦንካ ባዋ።<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>ግብፀ አሳይ ኤንታዉ ያይዳ ግሾ፥</para>
  <para style="q2" vid="PSA 105:38">ኤንታ ከሳን ኡፋይትዶሶና።<verse eid="PSA 105:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>ጎዳይ ኤንታ ካማናዉ ሻራ ምጭስ፤</para>
  <para style="q2" vid="PSA 105:39">ቃማ ኤንታዉ ፖእሳናዉ ታማ ጊግስስ።<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>ኤንቲ ምያባ ኦይችዳ ዎደ፥</para>
  <para style="q2" vid="PSA 105:40">ኩራቾ ዳንያ ካፎታ ኤንታዉ የድስ፤</para>
  <para style="q2" vid="PSA 105:40">ኤንታ ሳሎ ካ ካልስስ።<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>እ ሹቻ ጳልቅን፥ ሃ ፑልትስ፤</para>
  <para style="q2" vid="PSA 105:41">መላ ቢታን ሻፋዳ ጎግስ።<verse eid="PSA 105:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>እ ባ አይልያ አብራሃመስ፥</para>
  <para style="q2" vid="PSA 105:42">ገልዳ ጌሻ ቃላ ሀሳይስ።<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>እ ባ አሳ ኡፋይሳን፥</para>
  <para style="q2" vid="PSA 105:43">ባ ዶርዳይሳታ እልልሳን ከስስ።<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>እ ኤንታዉ አላጋ ካዎተታ ቢታ እሚስ፤</para>
  <para style="q2" vid="PSA 105:44">ሀራት ዳቡርዳ ጎሻ ላትዶሶና።<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>እ ሄሳ ኦዳይ ኤንቲ እያ ዎጋ</para>
  <para style="q2" vid="PSA 105:45">እያ ህግያ ናጋናነ ኦና መላሳ።</para>
  <para style="q2" vid="PSA 105:45">ጎዳ ጋላተቶ!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="s1">ፆሳይ ግታ፥ እያ ጋላትተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 106:1"/>ጎዳ ጋላትተ!</para>
  <para style="q1" vid="PSA 106:1">እ ኬሀ ግድያ ግሾነ</para>
  <para style="q2" vid="PSA 106:1">እያ ሲቆይ መርናሳ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 106:1">ጎዳ ጋላትተ።<verse eid="PSA 106:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>ጎዳይ ኦዳ ዎልቃማ ኦሶ ኦዳናዉ፥</para>
  <para style="q2" vid="PSA 106:2">ዎይኮ እያ ጋላታ ኡባ ቆንጭሳናዉ</para>
  <para style="q2" vid="PSA 106:2">ዳንዳኤይ ኦኔ?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>ፕርዳ ናገይሳትነ</para>
  <para style="q2" vid="PSA 106:3">ኡባ ቶሆ ፅሎባ ኦይሳት አንጀትዳሳታ።<verse eid="PSA 106:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>አቤት ጎዳዉ፥ ኔኒ ነ አሳስ ኬህያ ዎደ ታና ቆፓ፤</para>
  <para style="q2" vid="PSA 106:4">ኤንታ ኔኒ አሽያ ዎደ ታና አላ።<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>ሄስካ ነ ዶርዳ አሳ ድቻ ታ በአና መላ፥</para>
  <para style="q2" vid="PSA 106:5">ነ አሳ ኡፋይሳን ታኒ ኡፋይታና መላነ</para>
  <para style="q2" vid="PSA 106:5">ነ አሳራ እስፈ ታኒ ጋላታና መላሳ።<verse eid="PSA 106:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>ኑኒ ኑ አዋታዳ ናጋራ ኦዳ፤</para>
  <para style="q2" vid="PSA 106:6">ኑ ባልዳ፤ ኢታባ ኦዳ።<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>ኑ አዋት ግብፀን ደእያ ዎደ፥</para>
  <para style="q2" vid="PSA 106:7">ማላልስያ ነ ኦሱዋ ቆፕቦኮና።</para>
  <para style="q1" vid="PSA 106:7">ነ ሲቁዋ ዳሮተ ኤንቲ ሀሳይቦኮና፤</para>
  <para style="q2" vid="PSA 106:7">ዞኦ አባ ማታን እያ ቦላ ማካልዶሶና።<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>ግዶሽን፥ እ ባ ሱን ግሾ፥</para>
  <para style="q2" vid="PSA 106:8">ባ ግታ ዎልቃ ኤርሳናዉ ኤንታ አሽስ።<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>እ ዞኦ አባ ኪትን፥ አባይ መልስ፤</para>
  <para style="q2" vid="PSA 106:9">መላ ቢታራ ካንድ አያዳ፥</para>
  <para style="q2" vid="PSA 106:9">ጪሞ ግዶራ ኤንታ ካለድ ፕንስ።<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>እ ኤንታ እፀይሳታ ኩሸፐ አሽስ፤</para>
  <para style="q2" vid="PSA 106:10">ሞርከታ ኩሸፐ ኤንታ ዎዝስ።<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>ኤንታ ሞርከታ ሃይ ምትስ፤</para>
  <para style="q2" vid="PSA 106:11">ኤንታፈ እሶይካ አትቤና።<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>ሄ ዎደ ኤንቲ እያ ኡፋይሳ ቃላ አማንዶሶና፤</para>
  <para style="q2" vid="PSA 106:12">እያ ማዝሙረን ሳቦሶና።<verse eid="PSA 106:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>ግዶሽን፥ ኤንቲ እ ኦዳባ ዶግዶሶና፤</para>
  <para style="q2" vid="PSA 106:13">እ ዞርያ ኦግያ ናግድ ባናዉ ዶስቦኮና።<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>መላ ቢታን ደእሸ ዳሮ አሞትዶሶና፤</para>
  <para style="q2" vid="PSA 106:14">መላ ቢታን ፆሳ ፓጭዶሶና።<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>ኤንቲ ዎስዳይሳ እ እሚስ፤</para>
  <para style="q2" vid="PSA 106:15">ሽን ኢታ ሀርገ ኤንታ ግዶ ኪትስ።<verse eid="PSA 106:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>መላ ቢታን ዱንካነን ደእሸ ሙሰነ</para>
  <para style="q2" vid="PSA 106:16">ጎዳስ ዱማትዳ አሮና ቃናትዶሶና።<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>ቢታይ ዶየትድ ዳታነ ምትስ፤</para>
  <para style="q2" vid="PSA 106:17">አቤሮ እያ ኬ አሳራ ሞግስ።<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>ኤንታ ማባራ ግዶን ታም ኤፅስ፤</para>
  <para style="q2" vid="PSA 106:18">ላጮይ ሄ ኢታ አሳታ ፁግስ።<verse eid="PSA 106:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>ኮሬባ ዙማን ዎርቃፈ</para>
  <para style="q2" vid="PSA 106:19">ማራ ምስለ መዶሶና፤</para>
  <para style="q2" vid="PSA 106:19">ሄ ምስልያ ጎይንዶሶና።<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>ኤንቲ፥ ባንታ ቦንቾ ፆሳ</para>
  <para style="q2" vid="PSA 106:20">ማታ ምያ መሄ ምስለን ላምዶሶና።<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>ኤንቲ ግብፀን ግታ ኦሶ ኦዳነ</para>
  <para style="q2" vid="PSA 106:21">ኤንታና አሽዳ ፆሳ ዶግዶሶና።<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>ካማ ቢታን ኦሰትዳ ማላልስያባነ</para>
  <para style="q2" vid="PSA 106:22">ዞኦ አባን ሀንዳ ማላታ ኦዳሳ።<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>ሄሳ ግሾ፥ ፆሳይ ኤንታ ይሳና ግስ፤</para>
  <para style="q2" vid="PSA 106:23">ሽን ይሶና መላ እያ ሀንቆ ዛራናዉ፥</para>
  <para style="q2" vid="PSA 106:23">ፆሳይ ዶርዳ ሙሰይ ግዶን ኤቅስ።<verse eid="PSA 106:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>ሄሳፈ ጉየ፥ ኤንቲ</para>
  <para style="q2" vid="PSA 106:24">እያ ቃላ አማኖና ግሾ፥</para>
  <para style="q2" vid="PSA 106:24">ሄ ሎኦ ቢታ ካዶሶና።<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>ኤንቲ ባንታ ዱንካንያ ግዶን ዙዙምዶሶና</para>
  <para style="q2" vid="PSA 106:25">ጎዳ ቃላስ ኪተትቦኮና።<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>ሄሳ ግሾ፥ እ ኤንታ ባዞን የጋናዉ፥</para>
  <para style="q2" vid="PSA 106:26">ባ ኩሽያ ደንድ ጫቅስ።<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>ኤንታ ኮቻ ካዎተታ ግዶን</para>
  <para style="q2" vid="PSA 106:27">የጋናዉነ ቢታ ቦላ ላላናዉ ጫቅስ።<verse eid="PSA 106:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>ሄሳፈ ጉየ፥ ኤንቲ ብኤል-ፋጎራ ኤቃ ጎይነይሳታራ እስፈ ጋሄትዶሶና፤</para>
  <para style="q2" vid="PSA 106:28">ሸምፖይ ባይና ኤቃታስ ያርሸትዳ ያርሹዋ ምዶሶና።<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>ባንታ ኦሱዋን ጎዳ ሀንቀዶሶና፤</para>
  <para style="q2" vid="PSA 106:29">ሄሳ ጋሶን ኤንታ ግዶን ኢታ ሀርገይ ዎስ።<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>ሽን ፕንሃስ ደንድድ፥</para>
  <para style="q2" vid="PSA 106:30">ኤንታ ናጋራ ፕርድን፥</para>
  <para style="q2" vid="PSA 106:30">ኢታ ሀርገይ ኤንታ ቦላፈ ክችስ።<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>ሄስካ፥ እያዉ፥ የለተፈ የለተ ጋካናዉ</para>
  <para style="q2" vid="PSA 106:31">መርናዉ ፅሎተ ግድድ ታይበትስ።<verse eid="PSA 106:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>ማርባ ፑልቱዋ ማታን ጎዳ ሀንቀዶሶና፤</para>
  <para style="q2" vid="PSA 106:32">ኤንታ ጋሶን ሙሰ ቦላ መቶይ ጋክስ።<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>ኤንቲ እያ ይሎይዶሶና፤</para>
  <para style="q2" vid="PSA 106:33">ሙሰ ዶናፐ በሰና ቃላይ ከይስ።<verse eid="PSA 106:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>ጎዳይ ይስተ ግን፥</para>
  <para style="q2" vid="PSA 106:34">ኤንቲ ካናነ አሳታ ይስቦኮና።<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>ሄ ፓላባፐ፥ ኤንቲ ሄ አሳታራ</para>
  <para style="q2" vid="PSA 106:35">ዋላከትዶሶና፤</para>
  <para style="q2" vid="PSA 106:35">ኤንታ ደኦ ዎጋ ካልዶሶና።<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>ፆሳ አሳት ኤንታ ኤቃ ጎይንዶሶና፤</para>
  <para style="q2" vid="PSA 106:36">ሄስ ኤንታዉ ፅሄ ግድስ።<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>ኤንቲ ባንታ አደነ ማጫ ናይታ</para>
  <para style="q2" vid="PSA 106:37">ቱና አያናታስ ያርሽዶሶና።<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>ኤንቲ ፅሎ ሱ ካናነ ኤቃታስ ያርሽድ፥</para>
  <para style="q2" vid="PSA 106:38">ባንታ አደነ ማጫ ናይታ ሱ ጉስዶሶና፤</para>
  <para style="q2" vid="PSA 106:38">ሄ ሱን ቢታይ ቱንስ።<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>ሄሳዳ ኤንቲ ባንታ ኦሶን ቱንዶሶና፤</para>
  <para style="q2" vid="PSA 106:39">ባንታ ሀኖታን ባንታ ላይማ ከስዶሶና።<verse eid="PSA 106:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>ሄሳ ግሾ፥ ጎዳ ሀንቆይ</para>
  <para style="q2" vid="PSA 106:40">እያ አሳ ቦላ ኤፅስ፤</para>
  <para style="q2" vid="PSA 106:40">እ ባ ላታ ሻተትስ።<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>እ ኤንታ አላጋ ኩሸን አድ እሚስ፤</para>
  <para style="q2" vid="PSA 106:41">ኤንታ ሞርከት ኤንታ ሃርዶሶና።<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>ኤንታ ሞርከት ኤንታ ኡንኤዶሶና</para>
  <para style="q2" vid="PSA 106:42">ባንታ ሸነን ኤንታ አይስዶሶና።<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>እ ኤንታ ዳሮ ዎደ አሽስ፤</para>
  <para style="q2" vid="PSA 106:43">ሽን ኤንቲ ባንታ ማካላ አጎና እፅዶሶና፤</para>
  <para style="q2" vid="PSA 106:43">ባንታ ናጋራ ጋሶን ይዶሶና።<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>ግዶሽን፥ እ ኤንታ ዋሱዋ ስእስ፤</para>
  <para style="q2" vid="PSA 106:44">ኤንታ ዋይያ ቆፕስ።<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>እ ኤንታ ግሾ፥ ባ ኡፋይሳ ቃላ ሀሳይስ፤</para>
  <para style="q2" vid="PSA 106:45">ባ ሲቁዋ ዳሩዋን ኤንታ ማርስ።<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>ኤንታ ድእዳ ኡባይ፥</para>
  <para style="q2" vid="PSA 106:46">ኤንታዉ ቃታና መላ ኦስ።<verse eid="PSA 106:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>ኑኒ ነ ጌሻ ሱን ጋላታና መላ</para>
  <para style="q2" vid="PSA 106:47">አቤት ጎዳዉ፥ ኑ ፆሳዉ፥ ኑና አሻ።</para>
  <para style="q1" vid="PSA 106:47">ነ ቦንቹዋን ኑ ጬቀታና መላ፥</para>
  <para style="q2" vid="PSA 106:47">ካዎተታ ግዶፈ ኑና ሺሻ።<verse eid="PSA 106:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>እስራኤለ ጎዳይ፥ ፆሳይ፥</para>
  <para style="q2" vid="PSA 106:48">መርናፐ መርና ጋካናዉ ጋላተቶ!</para>
  <para style="q2" vid="PSA 106:48">አሳ ኡባይ፥ “አምንእ” ያጎ።</para>
  <para style="q2" vid="PSA 106:48">ጎዳ ጋላትተ!<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">እቻሻን ማፃፋ</para>
  <para style="mr">(<ref loc="PSA 107-150">ማዝ 107—150</ref>)</para>
  <para style="s1">መቶ ዎደ ኤለ ጋክያ ፆሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>እ ኬሀ ግድያ ግሾነ</para>
  <para style="q2" vid="PSA 107:1">እያ ሲቆይ መርናስ ግዲያ ግሾ፤</para>
  <para style="q2" vid="PSA 107:1">ጎዳ ጋላትተ<verse eid="PSA 107:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>ጎዳይ አሽዳይሳት፥</para>
  <para style="q2" vid="PSA 107:2">ሞርከ ኩሸፐ ከስ ኤክዳይሳት</para>
  <para style="q2" vid="PSA 107:2">ሀይሳዳ ያግድ ኦደቶ።<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>ኤንቲ ዶሎሀፐነ ዉሎሀፐ፥</para>
  <para style="q2" vid="PSA 107:3">ፑደሀፐነ ዱገሀፐ</para>
  <para style="q2" vid="PSA 107:3">ቢታ ኡባፈ ሺቅዳይሳታ።<verse eid="PSA 107:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>ኤንታፈ እሶት እሶት መላ ቢታን ዩይዶሶና።</para>
  <para style="q2" vid="PSA 107:4">ባንታ ደእያ ካታማ ብያ ኦግያ</para>
  <para style="q2" vid="PSA 107:4">ደማናዉ ዳንዳእቦኮና።<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>ኤንቲ ኮሻትዶሶና፤ ሳሞትዶሶና፤</para>
  <para style="q2" vid="PSA 107:5">ኤንቲ ኡንኤትዶሶና።<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>ኤንቲ መቶትዳ ዎደ፥</para>
  <para style="q2" vid="PSA 107:6">ጎዳኮ ዋስዶሶና፤</para>
  <para style="q2" vid="PSA 107:6">እ ኤንታ ዋይያፐ ኤንታ አሽስ።<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>ኤንቲ ዳና ካታማ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 107:7">ኤንታ ሱረ ኦገን ካለስ።<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>መርና እያ ሲቁዋ ግሾነ</para>
  <para style="q2" vid="PSA 107:8">እ ኤንታዉ ኦዳ ማላልስያ ኦሱዋ ግሾ</para>
  <para style="q2" vid="PSA 107:8">ኤንቲ ጎዳ ጋላቶ።<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>እ ሳሞትዳይሳታ አልሴስ፤</para>
  <para style="q2" vid="PSA 107:9">ኮሻትዳይሳታ ሎኦባ ካልሴስ።<verse eid="PSA 107:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>እሶት እሶት ሳካና ማን ኡትዶሶና፤</para>
  <para style="q2" vid="PSA 107:10">ብራታ ሳንላታን ዋይዶሶና።<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>ሄስ ሀንዳይ ኤንቲ ኡባፈ ቃ ፆሳ፥</para>
  <para style="q2" vid="PSA 107:11">ኪታ ቦላ ማካልዳ ግሾነ</para>
  <para style="q2" vid="PSA 107:11">እያ ዞርያ ካዳ ግሾሳ።<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>እ ኤንታ ዋየ ኦሶን ዳቡርስስ፤</para>
  <para style="q2" vid="PSA 107:12">ኤንታ ማድያ አስ ይን ኩንድዶሶና፤<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>ኤንቲ መቶትዳ ዎደ፥</para>
  <para style="q2" vid="PSA 107:13">ጎዳኮ ዋስዶሶና፤</para>
  <para style="q2" vid="PSA 107:13">እ ኤንታ ዋያፐ ኤንታ አሽስ።<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>እ ኤንታ ሳካና ማፐ ከስስ፤</para>
  <para style="q2" vid="PSA 107:14">ኤንቲ ቃሸትዳ ሳንላታ ዱስ።<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>እያ ሲቁዋ ግሾነ</para>
  <para style="q2" vid="PSA 107:15">እ ኤንታዉ ኦዳ ማላልስያ ኦሱዋ ግሾ</para>
  <para style="q2" vid="PSA 107:15">ኤንቲ ጎዳ ጋላቶ።<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>እ ናሰ ብራታ ፐንገታ መንስ፤</para>
  <para style="q2" vid="PSA 107:16">ብራታ ካሶታ ቃንፅስ።<verse eid="PSA 107:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>እሶት እሶት ኤያ ግድዶሶና፤</para>
  <para style="q2" vid="PSA 107:17">ባንታ ኦዳ ናጋራ ጋሶን</para>
  <para style="q2" vid="PSA 107:17">ባንታ ኢታተ ጋሶን መቶትዶሶና።<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>ኤንቲ ካ እፅዳ ግሾ</para>
  <para style="q2" vid="PSA 107:18">ሀይቆስ ጋክዶሶና።<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>ኤንቲ መቶትዳ ዎደ፥</para>
  <para style="q2" vid="PSA 107:19">ጎዳኮ ዋስዶሶና፤</para>
  <para style="q2" vid="PSA 107:19">እ ኤንታ ዋያፐ ኤንታ አሽስ።<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>እ ባ ቃላ ኪትድ ኤንታ ፓስ፤</para>
  <para style="q2" vid="PSA 107:20">ዱፎፐ ኤንታ አሽስ።<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>እያ ሲቁዋ ግሾነ</para>
  <para style="q2" vid="PSA 107:21">እ ኤንታዉ ኦዳ ማላልስያ ኦሱዋ ግሾ</para>
  <para style="q2" vid="PSA 107:21">ኤንቲ ጎዳ ጋላቶ።<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>ኤንቲ እያዉ ጋላታ ያርሾ ሺሾ፤</para>
  <para style="q2" vid="PSA 107:22">ኡፋይሳ የን እያ ኦሱዋ ኦዶ።<verse eid="PSA 107:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>እሶት እሶት ማርካበን አባ ቦላራ ብዶሶና፤</para>
  <para style="q2" vid="PSA 107:23">አባ ቦላ ባንታ ኦሱዋ ኦዶሶና።<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>ኤንቲ ጎዳ ኦሱዋ በእዶሶና፤</para>
  <para style="q2" vid="PSA 107:24">ጪሞ አባን ኦዳ ማላልስያባ ፄልዶሶና።<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>እ ኪትዳ ዎደ ጎተይ ደንድስ፤</para>
  <para style="q2" vid="PSA 107:25">አባ ዙለይ ቃፅስ።<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>ኤንቲ ፑደ ደንድዶሶና፤</para>
  <para style="q2" vid="PSA 107:26">ዱገ ጪሞን ዎዶሶና፤</para>
  <para style="q2" vid="PSA 107:26">ኢታ መቶይ ጋክን ኤንታ ዎዛናይ ትልእስ።<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>ኤንቲ ማትዳ አሳዳ</para>
  <para style="q2" vid="PSA 107:27">በትድ ጋንድጋርዶሶና፤</para>
  <para style="q2" vid="PSA 107:27">ኤንታ ኤራይ ማይስ።<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>ኤንቲ መቶትዳ ዎደ፥</para>
  <para style="q2" vid="PSA 107:28">ጎዳኮ ዋስዶሶና፤</para>
  <para style="q2" vid="PSA 107:28">እ ኤንታ ዋያፐ ኤንታ አሽስ።<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>እ ጎትያ ስእ ኦስ፤</para>
  <para style="q2" vid="PSA 107:29">አባ ቤታ ስርጵ ኦስ።<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>ስእ ግዳ ግሾ ኡፋይትዶሶና፤</para>
  <para style="q2" vid="PSA 107:30">ኤንቲ ኮይዳ ካታማ ጎዳይ ጋስ።<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>እያ ሲቁዋ ግሾነ</para>
  <para style="q2" vid="PSA 107:31">እ ኤንታዉ ኦዳ ማላልስያ ኦሱዋ ግሾ</para>
  <para style="q2" vid="PSA 107:31">ኤንቲ ጎዳ ጋላቶ።<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>ደርያ ሺቁዋን እያ ግታተ አዋጆ፤</para>
  <para style="q2" vid="PSA 107:32">ጭማታ ዱላታን እያ ጋላቶ።<verse eid="PSA 107:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>ጎዳይ ሻፋታ መልስስ፤</para>
  <para style="q2" vid="PSA 107:33">ፑልቶት ጎጎናዳ ተቅስ።<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>ሄ በሳን ደእያ አሳ ኢታተ ግሾ፥</para>
  <para style="q2" vid="PSA 107:34">አራዳ ቢታ ቁኤ ከስስ።<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>እ መላ ቢታን ሃ ኤልስስ፤</para>
  <para style="q2" vid="PSA 107:35">መላ ቢታን ፑልቶይ ቃናዳ ኦስ።<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>ኮሻትዳ አሳ ሄ በሳን ዎስ፤</para>
  <para style="q2" vid="PSA 107:36">ባንታዉ ዳና ካታማ ያን ኬፅዶሶና።<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>ኤንቲ ባንታ ጎሻን ዘርዶሶና፤</para>
  <para style="q2" vid="PSA 107:37">ዎይነ ቶክዶሶና፤</para>
  <para style="q2" vid="PSA 107:37">ዳሮ ሙሩቶ ሺሽዶሶና።<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>እ ኤንታ አንጅን ኤንቲ ዳርዶሶና፤</para>
  <para style="q2" vid="PSA 107:38">ኤንታ መህያ ታይቡዋ ጉቤና።<verse eid="PSA 107:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>ኤንቲ ፆነትያ ዎደነ ኡንኤትያ ዎደ፥</para>
  <para style="q2" vid="PSA 107:39">መቶንነ አዛኖን ካዉይያ ዎደ፥<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>ጎዳይ ኤንታ ሀላቃታ ካዉሽስ፤</para>
  <para style="q2" vid="PSA 107:40">መላ ቢታን ቶይላታና መላ ኦስ።<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>ሽን ማንቆታ መቶፐ ከስስ፤</para>
  <para style="q2" vid="PSA 107:41">ኤንታ ሶ አሳ ዶርሳ ዉደዳ ዳርስስ።<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>ሱረ አሳይ ሄሳ በእድ ኡፋይቶሶና፤</para>
  <para style="q2" vid="PSA 107:42">ሽን ኢታ አሳይ ዬላትድ ስእ ጎሶና።<verse eid="PSA 107:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>ጭንጫት ሀይሳ ኡባ አኬኮ፤</para>
  <para style="q2" vid="PSA 107:43">ጎዳ ሲቁዋ ቆፖ።<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="s1">ፆሳይ ኑ ባጋ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>ታ ዎዛናይ ምንድ ደኤስ፤</para>
  <para style="q2" vid="PSA 108:1">አቤት ፆሳዉ፥ ታ ዎዛናይ ምንድ ደኤስ።</para>
  <para style="q2" vid="PSA 108:1">ታ ነዉ የፃና፤ ነና ሳባና።<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>ታ ሸምፐ፥ ባርካ፤</para>
  <para style="q2" vid="PSA 108:2">ዲነ ማስንቆይ ደንዳ፤</para>
  <para style="q2" vid="PSA 108:2">ታ ዎንታ ጉራ ደንዳና።<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>አቤት ጎዳዉ፥ ታ ነና አሳ ግዶን ጋላታና፤</para>
  <para style="q2" vid="PSA 108:3">ካዎተ ግዶን ነና ሳባና።<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>ነ መርና ሲቆይ ሳሎፐ ቃ፤</para>
  <para style="q2" vid="PSA 108:4">ነ አማነተይ ሻራፐ ቃ።<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>አቤት ፆሳዉ፥ ሳሎፐ ቦላራ ነ ቁ ቁ ጋ፤</para>
  <para style="q2" vid="PSA 108:5">ነ ቦንቾይ ሳአ ኡባ ቦላ ግዶ።<verse eid="PSA 108:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>ነ ዶሰይሳት አታና መላ፥</para>
  <para style="q2" vid="PSA 108:6">ነ ኡሻቻ ኩሸን ኑና አሻ፤</para>
  <para style="q2" vid="PSA 108:6">ኔኒ ታ ዎሳ ስአ።<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>ፆሳይ ባ ጌሻ በሳን ሀይሳዳ ያግስ፤</para>
  <para style="q2" vid="PSA 108:7">“ታ ፆናዳ ሴከማ ሻካና፤</para>
  <para style="q2" vid="PSA 108:7">ሱኮታ ዛንጋራ ግሻና።<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>ጋላድነ ምናሰይ ታባ፤</para>
  <para style="q2" vid="PSA 108:8">ኤፍሬም ታ ሁጰን ዎያ ኡከ፤</para>
  <para style="q2" vid="PSA 108:8">ይሁድ ታ ካዎታ ፃምኣ።<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>ሞአበይ ታ ሜጨትያ ጋባተ፤</para>
  <para style="q2" vid="PSA 108:9">ኤዶመይ ታባ ግደይሳ ኤርሳናዉ</para>
  <para style="q2" vid="PSA 108:9">ታ ጫማ እያ ቦላ ዎና።</para>
  <para style="q2" vid="PSA 108:9">ፍልስፄመ ፆናዳ ገሬራና” ያግስ።<verse eid="PSA 108:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>ጎዳዉ፥ ግምበትዳ ካታማኮ፥ ታና ኤፋናይ ኦኔ?</para>
  <para style="q2" vid="PSA 108:10">ኤዶመ ጋካናዉ ታና ካለናይ ኦኔ?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>አቤት ፆሳዉ፥ ኑና አግዳይ ነና ግድኪ?</para>
  <para style="q2" vid="PSA 108:11">አቤት ፆሳዉ፥ ነ ኑ ቶራንቾታራ ኦላስ ከያካ።<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>አሳ ማዶይ ፓና ግሾ፥</para>
  <para style="q2" vid="PSA 108:12">ሞርክያ ኦላናዉ ነ ኑና ማዳ።<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>ፆሳ ዎልቃን ኑ ሞርከታ ፆናና፤</para>
  <para style="q2" vid="PSA 108:13">ኑ ሞርከታ ካዉሻናይ እያ።<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="s1">ታ ፆሳዉ ታና አሻ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 109:1"/>አቤት ታ ነና ጋላትያ ፆሳዉ፥</para>
  <para style="q2" vid="PSA 109:1">ነ ታዉ ስእ ጎፓ።<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>ኢታ አሳትነ ዎርዳንቾት፥</para>
  <para style="q2" vid="PSA 109:2">ባንታ ዶና ታ ቦላ ዶይዶሶና፤</para>
  <para style="q2" vid="PSA 109:2">ባንታ ዎርዶ እንፃርሳን ታ ቦላ ሃሳዮሶና።<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>እፆን ታ ዩሹዋ ተቅዶሶና፤</para>
  <para style="q2" vid="PSA 109:3">ጋሶይ ባይና ታና ኦልዶሶና።<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>ታ ኤንታ ዶሳይስነ ኤንታዉ ዎሳይስ፤</para>
  <para style="q2" vid="PSA 109:4">ግዶሽን፥ ኤንቲ ታና ሞቶሶና።<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>ታ ሎኦ ኦን፥ ታዉ ኢታ ዛሮሶና፤</para>
  <para style="q2" vid="PSA 109:5">ታ ኤንታ ዶስን፥ ኤንቲ ታና እፆሶና።<verse eid="PSA 109:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>ታ ሞርክያ ቦላ ኢታ ዳይና ሹማ፤</para>
  <para style="q2" vid="PSA 109:6">ሞታንቾይ እያ ኡሻቻን ኤቆ።<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>እያ ፕልግያ ዎደ እ ባላ ግድድ በንቶ፤</para>
  <para style="q2" vid="PSA 109:7">እያ ዎሳይ እያዉ ጎመ ግዶ።<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>እያ ላይይ ቃሞ፤</para>
  <para style="q2" vid="PSA 109:8">እያ ሹማተ ሀር ኤኮ።<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>እያ ናይት ይኦ ግዶ፤</para>
  <para style="q2" vid="PSA 109:9">እያ ማችያ አምኦ ግዶ።<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>እያ ናይት ዎሳንቾ ግድድ ቶይላቶ፤</para>
  <para style="q2" vid="PSA 109:10">ባንታ ደእያ ሁምፓ ኬፈ ጎደቶ።<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>እያ ሻሎ ኡባ አጮይ ኦይኮ፤</para>
  <para style="q2" vid="PSA 109:11">እ ዳቡርድ ከስዳባ ኡባ አላግ ቦንቆ።<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>ኦንካ እያዉ ኬሆፖ፤</para>
  <para style="q2" vid="PSA 109:12">እያ ናይታስ ቃትያ አስ በንቶፎ።<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>እያ ናይት ኡባይ ሀይቅድ ዉሮ፤</para>
  <para style="q2" vid="PSA 109:13">ካልያ የለተን እያ ሱንይ ዶገቶ።<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>እያ አዋታ ናጋራይ ጎዳ ስንን ቆፈቶ፤</para>
  <para style="q2" vid="PSA 109:14">እያ አየ ናጋራይ ቁሸቶፎ።<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>ጎዳይ ኤንታ ናጋራ ኡባ ዎደ ቆፖ፤</para>
  <para style="q2" vid="PSA 109:15">ኤንቲ ሳአ ቦላ ሀሳየቶፎ።<verse eid="PSA 109:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>እ ኬሀ ኦናዉ ፖሎ ቆፕቤና፤</para>
  <para style="q2" vid="PSA 109:16">ማንቆታ፥ መቶታንቾታ፥</para>
  <para style="q2" vid="PSA 109:16">ቆሄትዳይሳታ ጎድድ ዎስ።<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>እ ባዳናዉ ዶስዳ ግሾ፥</para>
  <para style="q2" vid="PSA 109:17">እ ባደትዳይሳ ግዶ።</para>
  <para style="q2" vid="PSA 109:17">እ አንጃናዉ ዶሶና ግሾ፥</para>
  <para style="q2" vid="PSA 109:17">እያ አንጆይ እያፐ ሃክስ።<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>ባደ እያ አፍላዳ ማእስ፤</para>
  <para style="q2" vid="PSA 109:18">እያ ባደ ሃዳ እያ ቦላ ላክስስ፤</para>
  <para style="q2" vid="PSA 109:18">ዛይተዳ እያ መቀ ግዶ ገሎ።<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>አፍላዳ እያ ካሞ፤</para>
  <para style="q2" vid="PSA 109:19">ዳንጮዳ ኡባ ዎደ እያ ፄሳን ደኦ።<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>ሀ ታና ሞተይሳነ</para>
  <para style="q2" vid="PSA 109:20">ታ ቦላ ኢታ ኦደተይሳታ</para>
  <para style="q2" vid="PSA 109:20">ጎዳይ ሄሳዳ ኦድ ሴሮ።<verse eid="PSA 109:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>ሽን አቤት ኡባ ሃርያ ጎዳዉ፥</para>
  <para style="q2" vid="PSA 109:21">ነ ሱን ግሾ ታና ማዳ።</para>
  <para style="q1" vid="PSA 109:21">ነ መርና ሲቁዋነ</para>
  <para style="q2" vid="PSA 109:21">ነ ኬሀተ ግሾ ታና አሻ።<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>ታኒ ማንቆነ መቶታንቾ አስ፤</para>
  <para style="q2" vid="PSA 109:22">ታ ዎዛናይ ማዱንፅስ።<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>ታ ኦማርሳ ኩያዳ ያና ሀናይስ፤</para>
  <para style="q2" vid="PSA 109:23">ታ ቦለዳ ቆቆፈታስ።<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>ፆማን ታ ጉልባታይ ዳቡርስ፤</para>
  <para style="q2" vid="PSA 109:24">ታ አሳተይ ላፍን መቀ አትስ።<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>ታና ሞተይሳታስ ቀልቅሰስ አታስ፤</para>
  <para style="q2" vid="PSA 109:25">ታና በእድ፥ ባንታ ሁጵያ ቃሶና።<verse eid="PSA 109:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>አቤት ጎዳዉ ታ ፆሳዉ፥ ታና ማዳ፤</para>
  <para style="q2" vid="PSA 109:26">መርና ነ ሲቁዋዳ ታና አሻ።<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>ነ ኩሸይ ሀይሳ ኦዳይሳነ፥</para>
  <para style="q2" vid="PSA 109:27">ነ ሀይሳ ኦዳይሳ ታ ሞርከት ኤሮ።<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>ኤንቲ ታና ባዶሶና፥ ሽን ነ ታና አንጃና፤</para>
  <para style="q2" vid="PSA 109:28">ታና ጎደይሳት ዬላቶ፤ ሽን ነ ታና ኡፋይሳ።<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>ታና ሞተይሳት ዬላ ማኦ፤</para>
  <para style="q2" vid="PSA 109:29">ባንታ ካዉሻ አፍላዳ ማኦ።<verse eid="PSA 109:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>ታኒ ታ እንፃርሳን ጎዳ ጋላታና፤</para>
  <para style="q2" vid="PSA 109:30">ደርያ ሺቁዋን እያ ሳባና።<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>እ ማንቆታ ግሾ ሞተቴስ፤</para>
  <para style="q2" vid="PSA 109:31">ሀይቆስ ፕርደትዳይሳታ አሼስ።<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="s1">ፆሳይ ታ ምየና</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 110:1"/>ጎዳይ ታ ጎዳ፥ “ታ ነ ሞርከታ ነ ቶሆይ</para>
  <para style="q2" vid="PSA 110:1">የያ በሲ ኦና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 110:1">ሀይሳን ታፐ ኡሻቻ ባጋን ኡታ” ያግስ።<verse eid="PSA 110:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>ጎዳዉ ነ ምኖተ ፃምአ ፅዮነፐ የዳ፤</para>
  <para style="q2" vid="PSA 110:2">“ነ ሞርከታ ሃራ” ያጋና።<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>ነ ሃርያ ጋላስ ነ ደረይ ዶስድ ነዉ ሃረታና፤</para>
  <para style="q2" vid="PSA 110:3">ነ ጌሻ ማኡዋ ማአዳ፥</para>
  <para style="q2" vid="PSA 110:3">ዎንታ ፃልቀዳ ነ ኩመ ዎልቃን ጶላና።<verse eid="PSA 110:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>ጎዳይ፥ “ማልከፃደቅ ካህነ ግድዳይሳዳ፥</para>
  <para style="q2" vid="PSA 110:4">ነ መርናዉ ካህነ ግዳና” ያግድ ጫቅስ፤</para>
  <para style="q2" vid="PSA 110:4">እያ ጫቆይ ላመተና።<verse eid="PSA 110:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>ጎዳይ ነ ኡሻቻን ደኤስ፤</para>
  <para style="q2" vid="PSA 110:5">ባ ሀንቁዋ ጋላስ ካዎታ ትንቸረና።<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>እ ካዎተታ ቦላ ፕርዳና፤</para>
  <para style="q2" vid="PSA 110:6">ኦላ ደንባታ አሀ ፃላላ ኦና፤</para>
  <para style="q2" vid="PSA 110:6">ቢታ ኡባን ደእያ ካዎታ ይሳና።<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>ካዎይ ኦገ ላንቀን ደእያ ፑልቱዋፈ ኡይድ፥</para>
  <para style="q2" vid="PSA 110:7">እ ባ ሁጵያ ቁ ኦና።<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="s1">ፆሳ ጋላትተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 111:1"/>ጎዳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 111:1">ሱረታ ሺቆን</para>
  <para style="q2" vid="PSA 111:1">ታ ኩመ ዎዛናን ጎዳ ጋላታና።<verse eid="PSA 111:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>ጎዳ ኦሶት አይ መላ ግተ!</para>
  <para style="q2" vid="PSA 111:2">ኤንታን ኡፋይትያ ኡባይ ኤንታ ቆፔስ።<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>እያ ኦሶት ቦንቾንነ ቴማን ኩምስ፤</para>
  <para style="q2" vid="PSA 111:3">እያ ፅሎተይ መርናዉ ደኤስ።<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>እያ ማላልስያ ኦሶይ ሀሳየትሸ ዳናዳ ኦስ፤</para>
  <para style="q2" vid="PSA 111:4">እ ኬሀነ ቃትያ ጎዳ።<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>ባዉ ያየይሳታስ ካ እሜስ፤</para>
  <para style="q2" vid="PSA 111:5">ባ ጫቆ ቃላ መርናዉ ባለተና።<verse eid="PSA 111:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>አላጋታ ቢታ ባ አሳስ አድ እምድ፥</para>
  <para style="q2" vid="PSA 111:6">ባ ግታ ዎልቃ ባ አሳ በስስ።<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>እያ ኩሸ ኦሶት ቱማነ ሱረ፤</para>
  <para style="q2" vid="PSA 111:7">እያ ዎጋ ኡባይ አማነትዳይሳ።<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>ኤንቲ መርናዉ ኤቅድ ደኦሶና፤</para>
  <para style="q2" vid="PSA 111:8">ቱማተንነ ሱረተን እመትዶሶና።<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>እ ባ አሳ ዎዝስ፤</para>
  <para style="q2" vid="PSA 111:9">ጫቁዋ ኤንታራ መርናዉ ኤስስ፤</para>
  <para style="q2" vid="PSA 111:9">እያ ሱንይ ጌሽነ ያሸይሳ።<verse eid="PSA 111:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>ጭንጫተስ ኮይሮይ ጎዳስ ያሽ፤</para>
  <para style="q2" vid="PSA 111:10">እያ ዎጋ ናገይሳታስ ሎኦ አኬክ ደኤስ።</para>
  <para style="q2" vid="PSA 111:10">ጎዳይ መርናዉ ጋላተቶ!<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="s1">ፅሎይ ቃፀና</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 112:1"/>ጎዳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 112:1">ጎዳስ ያየይስነ</para>
  <para style="q2" vid="PSA 112:1">እያ ኪታ ናገይስ አንጀትዳይሳ።<verse eid="PSA 112:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>እያ ናይት ቢታን ዎልቃማ ግዳና፤</para>
  <para style="q2" vid="PSA 112:2">ሱረ አሳ የለታይ አንጀታና።<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>ሻሎይነ ዱረተ እያ ኬን ደኤስ፤</para>
  <para style="q2" vid="PSA 112:3">እያ ፅሎተይ መርናዉ ዳና።<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>ኬሀ፥ ፅሎነ ቃትያ አሳስ፥</para>
  <para style="q2" vid="PSA 112:4">ማ ግዶን ፖኦይ ፖኤስ።<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>ኬሀተን ጮ ታልእያ ኡራስ፥</para>
  <para style="q2" vid="PSA 112:5">ባ ኦሱዋ ሱረተን ኦያ ኡራስ</para>
  <para style="q2" vid="PSA 112:5">ኬሀባይ ያና።<verse eid="PSA 112:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>ፅሎ አስ አዉደካ ኩንደና፤</para>
  <para style="q2" vid="PSA 112:6">እ መርናዉ ሀሳየታና።<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>እያ ዎዛናይ ህርጎና ግሾነ</para>
  <para style="q2" vid="PSA 112:7">እ ጎዳን አማነትያ ግሾ፥</para>
  <para style="q2" vid="PSA 112:7">ኢታባ ስእኮካ እ ዳጋመና፤<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>እያ ዎዛናይ ምኖ ግድያ ግሾ ያየና፤</para>
  <para style="q2" vid="PSA 112:8">ዉርሰን እያ ሞርከት ፆነትን በአና።<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>እ ማንቁዋስ ዳርስድ እሜስ፤</para>
  <para style="q2" vid="PSA 112:9">እያ ፅሎተይ መርናዉ ደኤስ፤</para>
  <para style="q2" vid="PSA 112:9">እያ ካጨይ ቦንቾን ቁ ቁ ጋና።<verse eid="PSA 112:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>ኢታ አስ ሄሳ በእድ ይሎቴስ፤</para>
  <para style="q2" vid="PSA 112:10">መተርሸ ሳፅሸ ጮ ዬስ፤</para>
  <para style="q2" vid="PSA 112:10">ኢታ አሳ አሞይ ጮ አታና።<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="s1">ኑ ፆሳ መል ኦኔ?</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>ጎዳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 113:1">ህንተኖ፥ ጎዳ አይለቶ፥</para>
  <para style="q2" vid="PSA 113:1">ጎዳ ሱን ጋላትተ።<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>ጎዳ ሱንይ፥</para>
  <para style="q2" vid="PSA 113:2">ሀችፈ መርና ጋካናዉ ጋላተቶ።<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>አዋይ ዶልያሱዋፐ ዉልያሱዋ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 113:3">ጎዳ ሱንይ ጋላተቶ።<verse eid="PSA 113:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>ጎዳይ ካዎተ ኡባ ሃሬስ፤</para>
  <para style="q2" vid="PSA 113:4">እያ ቦንቾይ ሳሉዋፐ ቃ።<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>ጎዳ ኑ ፆሳ መል ኦኔ?</para>
  <para style="q2" vid="PSA 113:5">እ ቦላ ቃን ባ አራታን ኡትስ።<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>እ ሳሎታነ ሳኣ በአናዉ</para>
  <para style="q2" vid="PSA 113:6">ዱገ ሆኬስ።<verse eid="PSA 113:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>እ ማንቁዋ ባናፐ ቁ ኦስ፤</para>
  <para style="q2" vid="PSA 113:7">መቶታንቹዋ ብዶፐ ደንስ።<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>ሞርናታራ ላገ ኦስ፤</para>
  <para style="q2" vid="PSA 113:8">ሀላቃታራ ቃ በሳን ኡትሴስ።<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>ማይን ማጫስዉ ናይታ አዮ ኦድ፥</para>
  <para style="q2" vid="PSA 113:9">ኡፋይስድ እ ኬን እዮ ቦንችሴስ።</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="p" vid="PSA 113:9">ጎዳ ጋላትተ!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="s1">እያ ስንን ያሻን ኮኮርተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>እስራኤለ አሳይ ግብፀ ቢታፈ ከይዳ ዎደ፥</para>
  <para style="q2" vid="PSA 114:1">ያይቆባ ሼሻይ አላጋ ቃላን፥</para>
  <para style="q2" vid="PSA 114:1">ሃሳያ አሳ አግድ ብዳ ዎደ፥<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>ይሁዳ አሳይ ጎዳስ ጌሻ አስ ግድስ፤</para>
  <para style="q2" vid="PSA 114:2">እስራኤለ አሳይ እያዉ ሃረትስ።<verse eid="PSA 114:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>አባይ ሄሳ በእድ ባቃትስ፤</para>
  <para style="q2" vid="PSA 114:3">ዮርዳኖሰ ሻፋይ ጉየ ስምስ።<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>ደረት ዴሻዳ ጉፕዶሶና፤</para>
  <para style="q2" vid="PSA 114:4">ዙማት ዶርሳ ማራዳ ዶዝግዶሶና።<verse eid="PSA 114:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>አባዉ፥ ነ አይስ ባቃታዲ?</para>
  <para style="q2" vid="PSA 114:5">ዮርዳኖሰ፥ ነ አይስ ጉየ ስማዲ?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>ደረቶ፥ ዴሻዳ አይስ ጉፕደቲ?</para>
  <para style="q2" vid="PSA 114:6">ዙማቶ፥ ዶርሳዳ አይስ ዶዝግደቲ?<verse eid="PSA 114:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>ነኖ ቢታዉ፥ ጎዳ ስንን፥</para>
  <para style="q2" vid="PSA 114:7">ያይቆባ ፆሳ ስንን ኮኮራ።<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>እ ዛላ ኤለ ሃ ከሴስ፤</para>
  <para style="q2" vid="PSA 114:8">ምኖ ዛላ ሃ ፑልቶ ኦስ።<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="s1">ኑ ፆሳይ ዱማ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>አቤት ጎዳዉ፥ ኑ ግሾ ግዶናሽን፥</para>
  <para style="q2" vid="PSA 115:1">ነ ሲቁዋነ ነ አማነተ ግሾ፥</para>
  <para style="q2" vid="PSA 115:1">ነ ሱን ቦንቻ።<verse eid="PSA 115:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>አይስ ካዎተት፥</para>
  <para style="q2" vid="PSA 115:2">“ኤንታ ፆሳይ አዉኔ?” ያጋኔ?<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>ኑ ፆሳይ ሳሎን ደኤስ፤</para>
  <para style="q2" vid="PSA 115:3">ባ ዶስዳባ ኡባ ኦስ።<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>ሽን ኤንታ ኤቃት አሰ ኩሸን ኦሰትዶሶና፤</para>
  <para style="q2" vid="PSA 115:4">ኤንቲ ብራፐነ ዎርቃፈ መትዶሶና።<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>ኤንታዉ ዶን ደኤስ፥ ሽን ሃሳዮኮና፤</para>
  <para style="q2" vid="PSA 115:5">አይፈይ ደኤስ፥ ሽን ፄሎኮና።<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>ኤንታዉ ሀይ ደኤስ፥ ሽን ስኦኮና፤</para>
  <para style="q2" vid="PSA 115:6">ሲይ ደኤስ፥ ሽን ስንጎኮና።<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>ኤንታዉ ኩሸይ ደኤስ፥ ሽን ቦች ኤሮኮና፤</para>
  <para style="q2" vid="PSA 115:7">ቶሆይ ደኤስ፥ ሽን ሄመቶኮና፤</para>
  <para style="q2" vid="PSA 115:7">ኤንታ ሲፅናራ ኮሽንች ከየና።<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>ኤንታ መይሳትነ</para>
  <para style="q2" vid="PSA 115:8">ኤንታ አማነተይሳት ኤንታ መላ ግዶ።<verse eid="PSA 115:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>እስራኤለ አሳዉ፥ ጎዳን አማነትተ፤</para>
  <para style="q2" vid="PSA 115:9">ህንተና ማደይነ ህንተ ጎንዳለይ እያ።<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>አሮና ኬ አሳዉ፥ ጎዳን አማነትተ፤</para>
  <para style="q2" vid="PSA 115:10">ህንተና ማደይነ ህንተ ጎንዳለይ እያ።<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>ጎዳስ ያየይሳቶ፥ ጎዳን አማነትተ፤</para>
  <para style="q2" vid="PSA 115:11">ህንተና ማደይነ ህንተ ጎንዳለይ እያ።<verse eid="PSA 115:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>ጎዳይ ኑና ቆፔስ፤ እ ኑና አንጃና፤</para>
  <para style="q2" vid="PSA 115:12">እ እስራኤለ አሳ አንጃና፤</para>
  <para style="q2" vid="PSA 115:12">እ አሮና ኬ አሳ አንጃና።<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>ጎዳስ ያየይሳታ፥</para>
  <para style="q2" vid="PSA 115:13">እ ጉ ግታ አንጃና።<verse eid="PSA 115:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>ጎዳይ ህንተና ዳርሶ፤</para>
  <para style="q2" vid="PSA 115:14">ህንተናነ ህንተ ናይታ አንጆ።<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>ሳሉዋነ ሳኣ መዳ</para>
  <para style="q2" vid="PSA 115:15">ጎዳይ ህንተና አንጆ።<verse eid="PSA 115:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>ሳሎይ ፆሳባ፤</para>
  <para style="q2" vid="PSA 115:16">ሽን ሳአ አሳስ እሚስ።<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>ሀይቅዳይሳት ጎዳ ጋላቶኮና፤</para>
  <para style="q2" vid="PSA 115:17">ዱፎን ዝንእዳይሳት እያ ሳቦኮና።<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>ሽን ኑኒ፥ ደኦን ደኤይሳት፥</para>
  <para style="q2" vid="PSA 115:18">ሀችፈ መርና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 115:18">ጎዳ ጋላቶስ።</para>
  <para style="q2" vid="PSA 115:18">ጎዳ ጋላትተ።<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="s1">ሀይቆፐ አትዳ አሳ ጋላታ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 116:1"/>ጎዳይ ታ ዋሱዋነ ታ ዎሳ ስእዳ ግሾ፥</para>
  <para style="q2" vid="PSA 116:1">ታኒ እያ ዶሳይስ።<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>እ ባ ሀይ ታኮ ዛርዳ ግሾ፥</para>
  <para style="q2" vid="PSA 116:2">ታ ደኦ ላይ ኡባን እያ ፄጋና።<verse eid="PSA 116:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>ሀይቆይ ፅሄዳ ታና ተቅስ፤</para>
  <para style="q2" vid="PSA 116:3">ዱፎ ህርጋይ ታና ኦይክስ፤</para>
  <para style="q2" vid="PSA 116:3">ኡንእነ መቶይ ታና ቃችስ።<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>ሄ ዎደ፥ “አቤት ጎዳዉ፥ ታና አሻ”</para>
  <para style="q2" vid="PSA 116:4">ያጋዳ ጎዳ ሱን ፄጋስ።<verse eid="PSA 116:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>ጎዳይ ኬሀነ ፅሎ፤</para>
  <para style="q2" vid="PSA 116:5">ኑ ፆሳይ ቃቴስ።<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>ጎዳይ አሽከታ ናጌስ፤</para>
  <para style="q2" vid="PSA 116:6">ታ መቶትዳ ዎደ ታና አሽስ።<verse eid="PSA 116:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>ጎዳይ ነዉ ኬሀ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 116:7">ህዛ ታ ሸምፐ፥ ዎፑ ጋ።<verse eid="PSA 116:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>ጎዳይ ታ ሸምፑዋ ሀይቆፐ፥</para>
  <para style="q2" vid="PSA 116:8">ታ አይፍያ አፉፈ፥</para>
  <para style="q2" vid="PSA 116:8">ታ ቶሁዋ በፐ አሽስ።<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>ታኒ ደኦን ደኤይሳታ ግዶን፥</para>
  <para style="q2" vid="PSA 116:9">ጎዳ ስንን ሄመታይስ።<verse eid="PSA 116:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>ታኒ፥ “ዳሮ ዋየታስ” ግዳ ዎደ፥</para>
  <para style="q2" vid="PSA 116:10">ታ አማኑዋ አጋብከ።<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>ታዉ ሳእ ሀድርዳ ዎደ፥</para>
  <para style="q2" vid="PSA 116:11">“አስ ኡባይ ዎርዳንቾ” ያጋስ።<verse eid="PSA 116:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>እ ታዉ ኬህዳ ኬሀተ ግሾ</para>
  <para style="q2" vid="PSA 116:12">ጎዳስ አይ ቃንፃናዉ ዳንዳእያና?<verse eid="PSA 116:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>ጎዳይ ታና አሽዳ ግሾ ጋላታና፥</para>
  <para style="q2" vid="PSA 116:13">ፁአ ዎይነ ኡሻ ያርሾ ኦዳ ሺሻና።<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>እያ አሳ ኡባ ስንን</para>
  <para style="q2" vid="PSA 116:14">ታ ቃንገ ጎዳስ ጋና።<verse eid="PSA 116:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>ጌሻታ ሀይቆይ</para>
  <para style="q2" vid="PSA 116:15">ጎዳ ስንን፥ ዳሮ አልኦ።<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>አቤት ጎዳዉ፥ ታኒ ነ አይለ፤</para>
  <para style="q2" vid="PSA 116:16">ታኒ ነ አይለ፥ ነ ጋንደ ናኣ፤</para>
  <para style="q2" vid="PSA 116:16">ታና ቃሾፐ ነ ብርሻዳሳ።<verse eid="PSA 116:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>ጎዳዉ፥ ታ ጋላታ ያርሾ ነዉ ያርሻና፤</para>
  <para style="q2" vid="PSA 116:17">ነ ሱን ፄጋና።<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>አሳ ኡባ ስንን</para>
  <para style="q2" vid="PSA 116:18">ታ ቃንገ ጎዳስ ጋና።<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>የሩሳላመን ደእያ ፆሳ ኬ ዳባባን፥</para>
  <para style="q2" vid="PSA 116:19">ታ ቃንገ ጋና።</para>
  <para style="q2" vid="PSA 116:19">ጎዳ ጋላትተ።<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="s1">ሃ ዪተ ጎዳ ጋላታና</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>ካዎተት ኡባይ ጎዳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 117:1">አሳ ኡባይ እያ ሳቢተ።<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>እያ ሲቆይ ኑስ ምኖ፤</para>
  <para style="q2" vid="PSA 117:2">እያ አማነተይ መርናሳ።</para>
  <para style="q2" vid="PSA 117:2">ጎዳ ጋላትተ።<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="s1">እያ ሲቆይ መርናሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 118:1"/>ጎዳይ ኬሀ ግድያ ግሾ ጋላትተ፤</para>
  <para style="q2" vid="PSA 118:1">እያ ሲቆይ መርናሳ።<verse eid="PSA 118:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>እስራኤለ አሳይ፥</para>
  <para style="q2" vid="PSA 118:2">“እያ ሲቆይ መርናሳ” ያጎ።<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>አሮና ኬ አሳይ፥</para>
  <para style="q2" vid="PSA 118:3">“እያ ሲቆይ መርናሳ” ያጎ።<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>ጎዳስ ያይያ ኡባይ፥</para>
  <para style="q2" vid="PSA 118:4">“እያ ሲቆይ መርናሳ” ያጎ።<verse eid="PSA 118:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>ታ ኡንኤትዳ ዎደ ጎዳኮ ዋሳስ፤</para>
  <para style="q2" vid="PSA 118:5">እ ታ ዋሱዋ ስእድ ታና ላአ ከስስ።<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>ጎዳይ ታራ ደእያ ግሾ ታ ያይከ፤</para>
  <para style="q2" vid="PSA 118:6">አስ ታና አይ ኦኔ?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>ጎዳይ ታና ማዳናዉ ታራ ደኤስ፤</para>
  <para style="q2" vid="PSA 118:7">ታ ሞርከታ ፆነተ ታ በአና።<verse eid="PSA 118:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>አሳን አማነታናፐ</para>
  <para style="q2" vid="PSA 118:8">ጎዳን ጌምድ አተይስ ሎኦ።<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>ግታ አሳን አማነታናፐ</para>
  <para style="q2" vid="PSA 118:9">ጎዳን ጌምድ አተይስ ሎኦ።<verse eid="PSA 118:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>ካዎተት ኡባይ ታና ተቅድ ኦይክዶሶና፤</para>
  <para style="q2" vid="PSA 118:10">ሽን ጎዳ ሱንን ታ ኤንታ ፆናስ።<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>ኤንቲ ታ ዩሹዋ ተቅዶሶና፤</para>
  <para style="q2" vid="PSA 118:11">ሽን ጎዳ ሱንን ታ ኤንታ ፆናስ።<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>ኤንቲ ታ ዩሹዋ ማዳ ተቅዶሶና፤</para>
  <para style="q2" vid="PSA 118:12">ሽን ቡረይ ታማን ኤፀይሳዳ ኤፅድ ይዶሶና፤</para>
  <para style="q2" vid="PSA 118:12">ጎዳ ሱንን ታ ኤንታ ይሳስ።<verse eid="PSA 118:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>ታኒ ሱገታዳ ኩንዳናዉ ጋካስ፤</para>
  <para style="q2" vid="PSA 118:13">ሽን ጎዳይ ታና ማድስ።<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>ጎዳይ ታ ምኖተነ የ፤</para>
  <para style="q2" vid="PSA 118:14">እ ታና አሸይሳ ግድስ።<verse eid="PSA 118:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>ፅሎታ ዱንካንያን ኦላ ፆንድ፥</para>
  <para style="q2" vid="PSA 118:15">ስምያ አሳ ኡፋይሳስ ግያባ ስእተ፤</para>
  <para style="q2" vid="PSA 118:15">ጎዳ ኡሻቻ ኩሸይ ግታባ ኦስ።<verse eid="PSA 118:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16"/>ጎዳ ኡሻቻ ኩሸይ ፆኖ እሚስ፤</para>
  <para style="q2" vid="PSA 118:16">ጎዳ ኡሻቻ ኩሸይ ግታባ ኦስ።<verse eid="PSA 118:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>ታኒ ሀይቅከ፤ ደኦን ዳና፤</para>
  <para style="q2" vid="PSA 118:17">ጎዳይ ኦዳባ አዋጃና።<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>ጎዳይ ታና ኢታ ሴራ ሴርስ፤</para>
  <para style="q2" vid="PSA 118:18">ሽን ሀይቆስ አድ እምቤና።<verse eid="PSA 118:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>ታኒ ግዶ ገላዳ ጎዳ ጋላታና መላ፥</para>
  <para style="q2" vid="PSA 118:19">ፅሎተ ፐንገታ ታዉ ዶይተ።<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>ሀይስ ጎዳ ፐንገ፤</para>
  <para style="q2" vid="PSA 118:20">ፅሎት እያራ ገሎሶና።<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>ጎዳዉ፥ ነ ታና ስእዳ ግሾነ</para>
  <para style="q2" vid="PSA 118:21">ታዉ ፆኖ እምዳ ግሾ ታ ነና ጋላታይስ።<verse eid="PSA 118:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>ግምበይሳት ካድ የግዳ ሹቻይ፥</para>
  <para style="q2" vid="PSA 118:22">ጎዳ ፃጱዋ ምንያ ሹቹ ግድስ።<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>ሀይስ ጎዳ ኦሶ፤</para>
  <para style="q2" vid="PSA 118:23">ኑ አይፍያስ ማላልስያባ።<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>ሀይስ ጋላሳይ ጎዳይ ኦዳ ጋላስ፤</para>
  <para style="q2" vid="PSA 118:24">አነ ኑኒ እያን ኡፋይቶስነ እልሎስ።<verse eid="PSA 118:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>ጎዳዉ፥ ሀእ ኑና አሻ፤</para>
  <para style="q2" vid="PSA 118:25">ጎዳዉ፥ ሀእ ኑስ እንጀያ።<verse eid="PSA 118:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>ጎዳ ሱንን ያ አስ አንጀትዳይሳ ግዶ፤</para>
  <para style="q2" vid="PSA 118:26">ኑኒ ፆሳ ኬፈ ህንተና አንጆስ።<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>ጎዳይ ፆሳ፤ እ ኑ ቦላ ፖእስስ፤</para>
  <para style="q2" vid="PSA 118:27">ያርሾ በሳን ደእያ ካጭያኮ ከይተ፤</para>
  <para style="q2" vid="PSA 118:27">እርፃ ታሸ ኦይክድ ባኣለ ቦንችተ።<verse eid="PSA 118:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>ኔኒ ታ ፆሳ፤ ታ ነና ጋላታና፤</para>
  <para style="q2" vid="PSA 118:28">ኔኒ ታ ፆሳ፤ ታ ነና ሳባና።<verse eid="PSA 118:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>ጎዳይ ኬሀ ግድያ ግሾ እያ ጋላትተ፤</para>
  <para style="q2" vid="PSA 118:29">እያ ሲቆይ መርናሳ።<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="s1">ነ ህገይ ታ ቶሁዋስ ፖኦ</para>
  <para style="qa">አሌፍ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 119:1"/>ባንታ ኦግያን ቦረይ ባይናይሳትነ</para>
  <para style="q2" vid="PSA 119:1">ጎዳ ዎጋዳ ሄመተይሳት አንጀትዳይሳታ።<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>እያ ኪታ ናገይሳትነ</para>
  <para style="q2" vid="PSA 119:2">ባንታ ኩመ ዎዛናን</para>
  <para style="q2" vid="PSA 119:2">እያ ኮየይሳት አንጀትዳይሳታ።<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>ኤንቲ ባላ ኦድ ኤሮኮና፤</para>
  <para style="q2" vid="PSA 119:3">ጎዳ ኦግያን ሄመቶሶና።<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>ነ ኪታ አማነትድ ናጋና መላ፥</para>
  <para style="q2" vid="PSA 119:4">ኔኒ ኑና ኪታዳሳ።<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>ነ ዎጋ ናጋዳ</para>
  <para style="q2" vid="PSA 119:5">ታ ኦገይ ምናና መላ ኮያይስ።<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>ነ ኪታ ኡባ አኬካዳ፥</para>
  <para style="q2" vid="PSA 119:6">ታ ፖሎ ዬላትከ።<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>ነ ፅሎ ፕርዳ ታ ታማርዳ ዎደ፥</para>
  <para style="q2" vid="PSA 119:7">ታ ነና ሱረ ዎዛናን ጋላታና።<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>ታ ነ ህግያ ናጋና፤</para>
  <para style="q2" vid="PSA 119:8">ታና ፖሎ የጎፋ።<verse eid="PSA 119:8"/></para>
  <para style="qa">ቤት</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>ያላጋይ ባ ኦግያ ዋትድ፥</para>
  <para style="q2" vid="PSA 119:9">ጌሻተን ናጋናዉ ዳንዳኢ?</para>
  <para style="q2" vid="PSA 119:9">ነ ቃላ ኪተትኮ ዳንዳኤስ።<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>ታ ኩመ ዎዛናን ነና ኮያስ፤</para>
  <para style="q2" vid="PSA 119:10">ነ ኪታፐ ካረ ከዮናዳ ታና ናጋ።<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>ታኒ ነ ቦላ ናጋራ ኦና መላ</para>
  <para style="q2" vid="PSA 119:11">ነ ቃላ ታ ዎዛናን ቆሳስ።<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>አቤት ጎዳዉ፥ ነ ጋላተታ፤</para>
  <para style="q2" vid="PSA 119:12">ነ አዋጁዋ ታና ታማርሳ።<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>ነ ዶናፐ ከይያ ፕርዳ ኡባ</para>
  <para style="q2" vid="PSA 119:13">ታኒ ታ እንፃርሳን ኦዳና።<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>ዱረተን ኡፋይተይሳፈ አዳ፥</para>
  <para style="q2" vid="PSA 119:14">ታ ነ ህግያን ኡፋይታይስ።<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>ነ ዎጋታ ዛራ ዛራዳ ቆፓይስ</para>
  <para style="q2" vid="PSA 119:15">ነ ኦግያ ሎይዳ አኬካይስ።<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>ታኒ ነ ህግያን ኡፋይታይስ፤</para>
  <para style="q2" vid="PSA 119:16">ነ ቃላ ዶግከ።<verse eid="PSA 119:16"/></para>
  <para style="qa">ጋመል</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>ታኒ ደኦን ዳና መላነ ነ ቃላ ኪተታና መላ</para>
  <para style="q2" vid="PSA 119:17">ታዉ ነ አይልያስ ሎኦባ ኦ።<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>ነ ህግያን ደእያ ማላልስያ ቱማተ</para>
  <para style="q2" vid="PSA 119:18">ታ በአና መላ ታ አይፍያ ዶያ።<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>ታኒ ሀ ሳአን እማ፤</para>
  <para style="q2" vid="PSA 119:19">ነ ኪታ ታፐ ገንፋ።<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>ታ ሸምፕያ ኡባ ዎደ</para>
  <para style="q2" vid="PSA 119:20">ነ ፕርዳ ላሞታሸ ሀይቃሱ።<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>ኦቶረይሳታ፥ ባደትዳይሳታነ፥</para>
  <para style="q2" vid="PSA 119:21">ነ ኪታፐ ካረ ከየይሳታ ነ ሴራሳ።<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>ታኒ ኔኒ ኦድዳይሳ ኦዳ ግሾ፥</para>
  <para style="q2" vid="PSA 119:22">ኤንታ ጫሻነ ቦርያ ታ ቦላፈ ድጋ።<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>ሀር አቶሽን ሀላቃት ሺቅድ፥</para>
  <para style="q2" vid="PSA 119:23">ታ ቦላ ማቀትኮካ፥</para>
  <para style="q2" vid="PSA 119:23">ታኒ፥ ነ ኦሳንቾይ፥</para>
  <para style="q2" vid="PSA 119:23">ነ አዋጁዋ ዛራ ዛራዳ ቆፓና።<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>ነ ማርካተይ ታና ኡፋይሴስ፤</para>
  <para style="q2" vid="PSA 119:24">እ ታና ዞሬስ።<verse eid="PSA 119:24"/></para>
  <para style="qa">ዳለት</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>ታኒ ሀይቃና ሀናይስ፤</para>
  <para style="q2" vid="PSA 119:25">ነ ግዳ ቃላዳ ታና አሻ።<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>ታኒ ታ ኦግያባ ነዉ ኦድን፥</para>
  <para style="q2" vid="PSA 119:26">ነ ታና ስአዳሳ፤</para>
  <para style="q2" vid="PSA 119:26">ህዛ ነ አዋጁዋ ታና ታማርሳ።<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>ነ ዎጋ ታና አኬክሳ፤</para>
  <para style="q2" vid="PSA 119:27">ማላልስያ ኦሱዋ</para>
  <para style="q2" vid="PSA 119:27">ታኒ ዛራ ዛራዳ ቆፓና።<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>አዛኖይ ዳርዳ ግሾ ታ ሸምፖይ ዳቡርስ፤</para>
  <para style="q2" vid="PSA 119:28">ኔኒ ግዳ ቃላዳ ታና ምን።<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>ዎርዶ ኦገ ታፐ ሃሳ፤</para>
  <para style="q2" vid="PSA 119:29">ነ ኬሀተን ነ ህግያ ታና ታማርሳ።<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>ታኒ ቱማ ኦገ ዶራስ፤</para>
  <para style="q2" vid="PSA 119:30">ነ ፕርዳ ሀይዛስ።<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>አቤት ጎዳዉ፥ ታ ነ ህግያ ምንዳ ኦይካስ፤</para>
  <para style="q2" vid="PSA 119:31">ህዛ ታና ዬላዮፓ!<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>ታ ዎዛና ላአ ከስዳ ግሾ፥</para>
  <para style="q2" vid="PSA 119:32">ታኒ ነ ህግያ ኦግያን ዎፃይስ።<verse eid="PSA 119:32"/></para>
  <para style="qa">ሄ</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>አቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 119:33">ነ አዋጁዋ ብርሸ ታና ታማርሳ፤</para>
  <para style="q2" vid="PSA 119:33">ታኒ ዉርሰ ጋካናዉ እያ ናጋና።<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>ታኒ ነ ህግያ ናጋና መላነ</para>
  <para style="q2" vid="PSA 119:34">ታ ኩመ ዎዛናፐ እያዉ ክተታና መላ፥</para>
  <para style="q2" vid="PSA 119:34">ነ ታዉ አኬካ እማ።<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>ታኒ እያን ኡፋይትያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:35">ነ ኪታ ኦግያን ታና ካለ፤<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>ታ ዎዛና አሙዋኮ ግዶናሽን፥</para>
  <para style="q2" vid="PSA 119:36">ነ ህግያኮ ታና ዛራ።<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>ፓናባ ፄሎና መላ፥</para>
  <para style="q2" vid="PSA 119:37">ታ አይፈታ ተቃ፤</para>
  <para style="q2" vid="PSA 119:37">ነ ኦግያን ታ ደኡዋ ኦራፅሳ።<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>ነዉ ያያና መላ፥</para>
  <para style="q2" vid="PSA 119:38">ነ ገልዳ ቃላ፥ ታዉ ነ አይልያስ፥ ፖላ።<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>ታና ያሽያ ጫሻ ታፐ ድጋ፤</para>
  <para style="q2" vid="PSA 119:39">ነ ፕርዳይ አይ መላ ሎኦ!<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>ታኒ ነ ዎጋ ናጋናዉ አሞታይስ፤</para>
  <para style="q2" vid="PSA 119:40">ኔኒ ፅሎ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:40">ታ ደኡዋ ኦራፅሳ።<verse eid="PSA 119:40"/></para>
  <para style="qa">ዋዉ</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>አቤት ጎዳዉ፥ ነ ሲቁዋ ታና በሳ፤</para>
  <para style="q2" vid="PSA 119:41">ኔኒ ገልዳ ቃላዳ ታና አሻ።<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>ታኒ ነ ቃላን አማነትያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:42">ታና ጫየይሳታ ዛራናዉ ዳንዳአይስ።<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>ታኒ ነ ፕርዳ ኡፋይስ ኦዳ ግሾ፥</para>
  <para style="q2" vid="PSA 119:43">ታ እንፃርሳፈ ቱማተ ቃላ ይሶፋ።<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>ታኒ መሪ መርናዉ</para>
  <para style="q2" vid="PSA 119:44">ነ ህግያ ኪተታና።<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>ታኒ ነ ዎጋ ፖልያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:45">አሆን ሄመታና።<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>ታኒ ካዎታ ስንን ኤቃዳ፥</para>
  <para style="q2" vid="PSA 119:46">ኔኒ ግዳባ ኦዳሸ ዬላትከ።<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>ታኒ ነ ኪታታ ዶሳይስ፥</para>
  <para style="q2" vid="PSA 119:47">ኤንታን ኡፋይታይስ።<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>ታኒ ዶስያ ነ ኪታ ቦንቻይስ፤</para>
  <para style="q2" vid="PSA 119:48">ነ አዋጁዋ ዛራ ዛራዳ ቆፓና።<verse eid="PSA 119:48"/></para>
  <para style="qa">ዛዉ</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>ኔኒ ታዉ፥ ነ አይልያስ፥</para>
  <para style="q2" vid="PSA 119:49">እምዳ ቃላ ቆፓ፤</para>
  <para style="q2" vid="PSA 119:49">ነ ቃላን ታኒ ኡፋይስ ኦይስ።<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>ነ ቃላይ ታና ደኦን ዎስ፤</para>
  <para style="q2" vid="PSA 119:50">እ መቶ ዎደ ታና ምንስ።<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>ኦቶራንቾት ታና ልከፈ አድ ጫዮሶና፤</para>
  <para style="q2" vid="PSA 119:51">ሽን ታኒ ነ ህግያፈ ሸርእ ጊከ።<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>አቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 119:52">በንፐ ደእያ ነ ፕርዳ ታኒ ሀሳያይስ፤</para>
  <para style="q2" vid="PSA 119:52">ሄሳን ታኒ ምነታይስ።<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>ኢታት ነ ህግያ ኪተቶናይሳ በእን፥</para>
  <para style="q2" vid="PSA 119:53">ታና ይሎይ ዎስ።<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>ታኒ ደእያ አላጋ ቢታን</para>
  <para style="q2" vid="PSA 119:54">ነ አዋጆይ ታዉ የ ግድስ።<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>አቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 119:55">ታኒ ቃማ ነ ሱን ቆፓይስ፤</para>
  <para style="q2" vid="PSA 119:55">ነ ህግያ ናጋይስ።<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>ታ ነ ዎጋ ናጋና፤</para>
  <para style="q2" vid="PSA 119:56">እ ታዉ ኦሶ ግድስ።<verse eid="PSA 119:56"/></para>
  <para style="qa">ሄት</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>አቤት ጎዳዉ፥ ታ ሳማይ ነና፤</para>
  <para style="q2" vid="PSA 119:57">ታ ነ ህግያ ናጋናዉ ቃንፃስ።<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>ታ ኩመ ዎዛናን ነና ዎሳይስ፤</para>
  <para style="q2" vid="PSA 119:58">ነ ገልዳ ቃላዳ ታዉ ቃታ።<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>ታኒ ታ ኦግያ አኬካ ፄላዳ፥</para>
  <para style="q2" vid="PSA 119:59">ነ ህግያ ካላናዉ ስማስ።<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>ታኒ ነ ኪታ ናጋናዉ፥</para>
  <para style="q2" vid="PSA 119:60">ኤሶታናፐ አትሽን፥ ጋምእከ።<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>ኢታት ታዉ ፅሄ የግኮካ፥</para>
  <para style="q2" vid="PSA 119:61">ታኒ ነ ህግያ ዶግከ።<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>ነ ፅሎ ፕርዳ ግሾ፥ ነና ጋላታናዉ፥</para>
  <para style="q2" vid="PSA 119:62">ታኒ ግድ ብላሄ ደንዳይስ።<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>ታኒ ነዉ ያየይሳታ ኡባስነ</para>
  <para style="q2" vid="PSA 119:63">ነ ዎጋ ናገይሳታ ዳቦ።<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>አቤት ጎዳዉ፥ ሳእ ነ ሲቁዋን ኩምስ፤</para>
  <para style="q2" vid="PSA 119:64">ነ አዋጁዋ ታና ታማርሳ።<verse eid="PSA 119:64"/></para>
  <para style="qa">ፄት</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>አቤት ጎዳዉ፥ ነ ገልዳ ቃላዳ</para>
  <para style="q2" vid="PSA 119:65">ታዉ ነ አይልያስ ኬሀባ ኦዳሳ።<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>ታኒ ነ ኪታታን አማነትያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:66">ሎኦ ፕርዳነ ኤራተ ታና ታማርሳ።<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>ታኒ ሴረታናፐ ካሰ ካረ ሄመታስ፤</para>
  <para style="q2" vid="PSA 119:67">ሽን ሀእ ነ ቃላስ ኪተታይስ።<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>ኔኒ ኬሀ፤ ኔኒ ኬሀባ ኦሳ፤</para>
  <para style="q2" vid="PSA 119:68">ነ አዋጁዋ ታና ታማርሳ።<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>ኦቶራንቾት ታ ሱን ዎርዶን ኢሶሶና፤</para>
  <para style="q2" vid="PSA 119:69">ሽን ታ ነ ዎጋ ታ ኩመ ዎዛናን ናጋና።<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>ኤንታ ዎዛናይ ኩም ዶጭስ፤</para>
  <para style="q2" vid="PSA 119:70">ሽን ታኒ ነ ህግያን ኡፋይታይስ።<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>ነ ህግያ ታማራና መላ</para>
  <para style="q2" vid="PSA 119:71">ነ ታና ሴርዳይስ ታዉ ሎኦ ግድስ።<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>ዳሮ ዎርቃፈነ ብራፐ፥</para>
  <para style="q2" vid="PSA 119:72">ነ ዶናፐ ከይያ ህገይ ታዉ አስ።<verse eid="PSA 119:72"/></para>
  <para style="qa">ዮድ</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>ታና ነ ኩሸይ መስ፤ ነ ኩሸይ ጊግስስ፤</para>
  <para style="q2" vid="PSA 119:73">ነ ኪታ ታማራና መላ ታዉ አኬካ እማ።<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>ታኒ ነ ቃላን ኡፋይስ ኦዳ ግሾ፥</para>
  <para style="q2" vid="PSA 119:74">ነና ቦንቸይሳት ታና በእድ ኡፋይቶ።<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>አቤት ጎዳዉ፥ ነ ፕርዳይ ፅሎ ግደይሳ ኤራስ፤</para>
  <para style="q2" vid="PSA 119:75">ነ ታና ሴርዳይ አማነተን ግደይሳ ታ አኬካስ።<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>ታዉ ነ አይልያስ ግዳ ቃላዳ፥</para>
  <para style="q2" vid="PSA 119:76">ነ ሲቆይ ታና ምን።<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>ነ ህገይ ታና ኡፋይስያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:77">ታኒ ደኦን ዳና መላ ታዉ ቃታ።<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>ኦቶራንቾት ታና ዎርዶን ሞትያ ግሾ ዬላቶ፤</para>
  <para style="q2" vid="PSA 119:78">ታኒ ነ ዎጋ ዛራ ዛራዳ ቆፓይስ።<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>ነዉ ያየይሳትነ</para>
  <para style="q2" vid="PSA 119:79">ነ ማርካተ ኤረይሳት ታኮ ዮ።<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>ታ ዬላቶና መላ፥</para>
  <para style="q2" vid="PSA 119:80">ታ ዎዛናይ ነ ህግያን ቦረይ ባይናይሳ ግዶ።<verse eid="PSA 119:80"/></para>
  <para style="qa">ካፍ</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>ኔኒ ታና አሻና መላ፥</para>
  <para style="q2" vid="PSA 119:81">ታኒ ናጋሸ ዳቡራስ፤</para>
  <para style="q2" vid="PSA 119:81">ታኒ ነ ቃላን ኡፋይስ ኦይስ።<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>ኔኒ ግዳ ቃላይ ፖለትን</para>
  <para style="q2" vid="PSA 119:82">በአናዉ ናግሽን ታ አይፈይ ተልጁምስ።</para>
  <para style="q2" vid="PSA 119:82">“ነ ታና አዉደ ምንነ” ያጋስ።<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>ጩያን ካቀትዳ ኦጎሮዳ ጉንዳስ፤</para>
  <para style="q2" vid="PSA 119:83">ግዶሽን ነ አዋጁዋ ባላቢከ።<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>ታኒ ነ አይለይ አዉደ ጋካናዉ ናጎ?</para>
  <para style="q2" vid="PSA 119:84">ታና የደይሳታ ነ አዉደ ፕርዳኔ?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>ነ ህግያ ናጎና ኦቶራንቾት</para>
  <para style="q2" vid="PSA 119:85">ታና ኦይካናዉ ኦላ ቦኮሶና።<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>ነ ኪታ ኡባይ አማንይሳታ፤</para>
  <para style="q2" vid="PSA 119:86">ጋሶይ ባይና አሳይ ታና የደያ ግሾ</para>
  <para style="q2" vid="PSA 119:86">ታና ማዳ።<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>ኤንቲ ታና ዎ ድግድ አግዶሶና፤</para>
  <para style="q2" vid="PSA 119:87">ሽን ታ ነ ዎጋ አጋብከ።<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>ነ ሲቁዋን ታ ደኡዋ ናጋ፤</para>
  <para style="q2" vid="PSA 119:88">ታ ነ ኪታ ናጋና።<verse eid="PSA 119:88"/></para>
  <para style="qa">ላመድ</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>አቤት ጎዳዉ፥ ነ ቃላይ መርናሳ፤</para>
  <para style="q2" vid="PSA 119:89">እ ሳሎን ምንድ ደኤስ።<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>የለታፐ የለታ ጋካናዉ ነ አማነታሳ፤</para>
  <para style="q2" vid="PSA 119:90">ነ ሀ ሳኣ ምንዳ ኤሳዳሳ፤ እካ ምንድ ደኤስ።<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>ኡባይ ነ አይለ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:91">ሀች ጋካናዉ ኡባይ ነ ኪታዳ ምንድ ደኤስ፤<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>ነ ህገይ ታና ኡፋይሶናባ ግድያኮ፥</para>
  <para style="q2" vid="PSA 119:92">ታ ዋያን ታ ያናሽን።<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>ታኒ ነ ዎጋ ኩመ ዶግከ፤</para>
  <para style="q2" vid="PSA 119:93">ኔኒ እያን ታና ደኦን ዎዳሳ።<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>ታኒ ነባ ግድያ ግሾ ታና አሻ፤</para>
  <para style="q2" vid="PSA 119:94">ታኒ ነ ዎጋ ናጋናዉ ኮያይስ።<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>ኢታት ታና ይሳናዉ ዙግድ ናጎሶና፤</para>
  <para style="q2" vid="PSA 119:95">ሽን ታኒ ኔና ቆፓይስ።<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>ፖሎ ጌተትዳባ ኡባስ ዛው ደኤይሳ ታ በአስ፤</para>
  <para style="q2" vid="PSA 119:96">ሽን ፖሎ ግድዳ ህግያስ ዛው ባዋ።<verse eid="PSA 119:96"/></para>
  <para style="qa">ሜም</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>ታኒ ነ ህግያ ዋናዳ ዶስያና!</para>
  <para style="q2" vid="PSA 119:97">ኩመ ጋላስ ታኒ እያ ቆፓይስ።<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>ነ ኪታይ ኡባ ዎደ ታራ ደእያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:98">ታ ሞርከታፐ አድ ታና አኬካ ከሶሶና።<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>ታኒ ኔ ህግያ ቆፕያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:99">ታ አስታማረታፐ አዳ ጭንጫተ ታዉ ደኤስ።<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>ታኒ ነ ዎጋ ኪተትያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:100">ጭማታፐ አዳ አኬካይስ።<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>ታኒ ነ ቃላ ኪተታናዉ ኮይያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:101">ታ ቶሁዋ ኢታ ኦገ ኡባፈ ናጋስ።<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>ኔኒ ታና ታማርስዳ ግሾ፥</para>
  <para style="q2" vid="PSA 119:102">ታ ነ ህግያፈ ጋፃ ከይከ።<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>ነ ቃላይ ዋንድ ማልእ!</para>
  <para style="q2" vid="PSA 119:103">እልሎ ኤሳፈ አድ ማልኤስ።<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>ነ ዎጋፐ አኬካ ደማስ፤</para>
  <para style="q2" vid="PSA 119:104">ሄሳ ግሾ፥ ጌላ ኦገ ኡባ እፃስ።<verse eid="PSA 119:104"/></para>
  <para style="qa">ኖን</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>ነ ቃላይ ታ ቶሁዋስ ፆምፐ፥</para>
  <para style="q2" vid="PSA 119:105">ታ ኦግያስ ፖኦ።<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>ነ ፅሎ ፕርዳዳ ዳናዉ፥</para>
  <para style="q2" vid="PSA 119:106">ታ ጫቅዳ ጫቁዋ ምንና።<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>አቤት ጎዳዉ፥ ታ ዋየይ ዳሮ፤</para>
  <para style="q2" vid="PSA 119:107">ነ ኡፋይሳ ቃላዳ ታና ደኦን ዎ።<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>አቤት ጎዳዉ፥</para>
  <para style="q2" vid="PSA 119:108">ታ ጋላታ ያርሹዋ ኤካ፤</para>
  <para style="q2" vid="PSA 119:108">ታና ነ ፕርዳ ታማርሳ።<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>ታ ሸምፖይ ኡባ ዎደ መቶን ደኤስ፤</para>
  <para style="q2" vid="PSA 119:109">ሽን ታኒ ነ ህግያ ዶግከ።<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>ኢታት ታዉ ግተ የግዶሶና፤</para>
  <para style="q2" vid="PSA 119:110">ሽን ታኒ ነ ዎጋፐ ካረ ከያብከ።<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>ነ ህገይ ታዉ መርና ሻሎ፤</para>
  <para style="q2" vid="PSA 119:111">እ ታ ዎዛናስ ኡፋይስ እሜስ።<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>ታ ሀይቃና ጋካናዉ</para>
  <para style="q2" vid="PSA 119:112">ነ አዋጁዋዳ ኦናዉ ቆፋ ቃቻስ።<verse eid="PSA 119:112"/></para>
  <para style="qa">ሳምከት</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>ታኒ ናምኡ ቆፍ ደእያ አሳ እፃይስ፤</para>
  <para style="q2" vid="PSA 119:113">ሽን ነ ህግያ ዶሳይስ።<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>ነ ታዉ ጎንዳለነ ቆሰታዳ አትያ በሰ</para>
  <para style="q2" vid="PSA 119:114">ታኒ ነ ቃላን ኡፋይስ ኦይስ።<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>ታኒ ታ ፆሳ ኪታ ናጋና መላ፥</para>
  <para style="q2" vid="PSA 119:115">ህንተኖ፥ ኢታ ኦያ ኡባይ ታፐ ሃክተ።<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>ታኒ ደኦን ዳና መላ</para>
  <para style="q2" vid="PSA 119:116">ነ ኡፋይሳ ቃላዳ ታና ምን፤</para>
  <para style="q2" vid="PSA 119:116">ታ ኡፋይሳ ምሶፓ።<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>ታ ሳሮ ዳና መላ ታና ዘምፕሳ፤</para>
  <para style="q2" vid="PSA 119:117">ታ ኡባ ዎደ ነ አዋጁዋ ስአና።<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>ነ አዋጁዋፈ ሃከይሳታ ነ ኮያካ፤</para>
  <para style="q2" vid="PSA 119:118">ኤንታ ጭሞይ ሀዳ።<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>ኢታታ ኡባ ነ ፕቶዳ ታይባሳ፤</para>
  <para style="q2" vid="PSA 119:119">ሄሳ ግሾ፥ ታኒ ነ ኪታ ዶሳይስ።<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>ታ አሳተይ ያሻን ነዉ ኮኮሬስ፤</para>
  <para style="q2" vid="PSA 119:120">ታ ነ ህግያ ዳሮ ያያይስ።<verse eid="PSA 119:120"/></para>
  <para style="qa">ኤ</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>ታ ሱረነ ፅሎ ኦስ፤</para>
  <para style="q2" vid="PSA 119:121">ታና ታ ሞርከታስ አዳ እሞፋ።<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>ታና ነ አይልያ ማዳናዉ ጫቃ፤</para>
  <para style="q2" vid="PSA 119:122">ታና ኦቶራንቾት ኡንኤና መላ ኦፋ።<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>ነ ታና አሻና ጋዳ ታ ፄልሽን፥</para>
  <para style="q2" vid="PSA 119:123">ነ ፅሎ ቃላ ታ ናግሽን፥</para>
  <para style="q2" vid="PSA 119:123">ታ አይፈይ ተልጁምስ።<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>ታዉ ነ አይልያስ፥ ነ ሲቁዋዳ ኦ፤</para>
  <para style="q2" vid="PSA 119:124">ነ ህግያ ታና ታማርሳ።<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>ታና ነ አይልያ ነ ሲቁዋ በሳ፤</para>
  <para style="q2" vid="PSA 119:125">ነ ዎጋ ኤራና መላ ታዉ አኬካ እማ።<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>አቤት ጎዳዉ፥ አሳይ ነ ህግያ መንዳ ግሾ፥</para>
  <para style="q2" vid="PSA 119:126">ነ ፕርዳና ዎደይ ሀእ ጋክስ።<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>ታኒ ነ ኪታ ዎርቃፈ አዳ ዶሳይስ፤</para>
  <para style="q2" vid="PSA 119:127">ኤ፥ ዋላህ ባይና ዎርቃፈ አዳ ዶሳይስ።<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>ሄሳ ግሾ፥ ታ ነ ዎጋታ ኡባ ካላይስ፤</para>
  <para style="q2" vid="PSA 119:128">ጌላ ኦገ ኡባ እፃስ።<verse eid="PSA 119:128"/></para>
  <para style="qa">ፐ</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>ነ ዎጋ ኡባይ ማላልስያባ፤</para>
  <para style="q2" vid="PSA 119:129">ሄሳ ግሾ፥ ታ እያ ኪተታይስ።<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>ነ ቃላ ብርሸይ ፖኦ እሜስ፤</para>
  <para style="q2" vid="PSA 119:130">ጭንጫተ ፓጭዳይሳታስ አኬካ እሜስ።<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>ታኒ ነ ኪታ ሳሞታዳ፥</para>
  <para style="q2" vid="PSA 119:131">ታ ዶና ዶያስ።<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>ሃ ታኮ ስማ፤</para>
  <para style="q2" vid="PSA 119:132">ነና ዶሰይሳታስ ነ ኦይሳዳ ታዉ ቃታ።<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>ነ ኡፋይሳ ቃላዳ ታ ሄመ ሱርሳ፤</para>
  <para style="q2" vid="PSA 119:133">ናጋር ታና ሃራና መላ ኦፋ።<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>ታ ነ ዎጋ ኪተታና መላ</para>
  <para style="q2" vid="PSA 119:134">ታና ኡንኤይሳታ ኩሸፐ ዎዛ።<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>ነ አይልያ ታ ቦላ ነ ሶምኡዋ ፖእሳ፤</para>
  <para style="q2" vid="PSA 119:135">ነ ህግያ ታማርሳ።<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>አሳይ ነ ህግያ መንዳ ግሾ፥</para>
  <para style="q2" vid="PSA 119:136">ታ አፉይ ሃዳ ጎጌስ።<verse eid="PSA 119:136"/></para>
  <para style="qa">ፃደ</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>አቤት ጎዳዉ፥ ነ ፅሎ፤</para>
  <para style="q2" vid="PSA 119:137">ነ ፕርዳይ ሱረ።<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>ነ ህገይ ፅሎ፤</para>
  <para style="q2" vid="PSA 119:138">አይ ዎደካ አማነቴስ።<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>ታ ሞርከት ነ ቃላ ቶችዳ ግሾ፥</para>
  <para style="q2" vid="PSA 119:139">ታ ምሻይ ታማዳ ኤፅድ ከይስ።<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>ነ ኡፋይሳ ቃላይ ዳሮ አማነቴስ፤</para>
  <para style="q2" vid="PSA 119:140">ታ ነ አይለይ ዳሮ ዶሳይስ።<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>ታኒ ፓናነ ካትዳ አስ፤</para>
  <para style="q2" vid="PSA 119:141">ግዶሽን ታ ነ ዎጋ ዶግከ።<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>ነ ፅሎተይ መርናዉ ደኤስ፤</para>
  <para style="q2" vid="PSA 119:142">ነ ህገይ ቱማ።<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>መቶይነ ኡንእ ታና ጋክስ፤</para>
  <para style="q2" vid="PSA 119:143">ሽን ነ ኪታት ታና ኡፋይሶሶና።<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>ነ ዎጋይ መርናዉ ፅሎ፤</para>
  <para style="q2" vid="PSA 119:144">ታ ደኦን ዳና መላ ታዉ አኬካ እማ።<verse eid="PSA 119:144"/></para>
  <para style="qa">ቆፍ</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>አቤት ጎዳዉ፥ ታ ኩመ ዎዛናፐ</para>
  <para style="q2" vid="PSA 119:145">ኔኮ ዋሳስ፤ ታና አላ፤</para>
  <para style="q2" vid="PSA 119:145">ታ ነ አዋጁዋ ናጋና።<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>ታ ኔኮ ዋሳስ፤ ታና አሻ፤</para>
  <para style="q2" vid="PSA 119:146">ታ ነ ህግያ ናጋና።<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>ፃልቀይ ጫሮና ዎንታ ደንዳዳ፥</para>
  <para style="q2" vid="PSA 119:147">ታና ማዳ ጋዳ ኔኮ ዋሳይስ፤</para>
  <para style="q2" vid="PSA 119:147">ነ ገልዳ ቃላን ኡፋይስ ዎይስ።<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>ነ ቃላባ ዛራ ዛራ ቆፓናዉ፥</para>
  <para style="q2" vid="PSA 119:148">ቃማ ኡታ አቃይስ።<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>አቤት ጎዳዉ፥ ነ ሲቁዋ ግሾ፥ ታና ስአ፤</para>
  <para style="q2" vid="PSA 119:149">ነ ፅሎ ፕርዳዳ ታና ደኦን ዎ።<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>ታና የደያ ኢታት ታኮ ማቶሶና፤</para>
  <para style="q2" vid="PSA 119:150">ሽን ኤንቲ ነ ህግያፈ ሃኮሶና።<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>ሽን አቤት ጎዳዉ፥ ነ ታዉ ማታን ደኣሳ፤</para>
  <para style="q2" vid="PSA 119:151">ነ ኪታ ኡባይ ቱማ።<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>ታኒ በንፐ ዶማዳ፥ ነ ህግያ ታማራስ፤</para>
  <para style="q2" vid="PSA 119:152">ነ እያ መርናዉ ምንዳ ኤሳዳሳ።<verse eid="PSA 119:152"/></para>
  <para style="qa">ሬስ</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>ታ ነ ህግያ ዶጎና ግሾ፥</para>
  <para style="q2" vid="PSA 119:153">ታ መቱዋ በአዳ ታና አሻ፤<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>ታ ግሾ ሞተታዳ ታና ዎዛ፤</para>
  <para style="q2" vid="PSA 119:154">ነ ኡፋይሳ ቃላዳ ታና ደኦን ዎ።<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>ነ ህግያ ኤንቲ ኤኮና ግሾ፥</para>
  <para style="q2" vid="PSA 119:155">ኢታት አቶተ ደሞኮና።<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>አቤት ጎዳዉ፥ ነ ቃይ ዳሮ፤</para>
  <para style="q2" vid="PSA 119:156">ነ ፅሎ ፕርዳዳ ታና ደኦን ዎ።<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>ታና እፀይሳትነ የደይሳት ዳሮ፤</para>
  <para style="q2" vid="PSA 119:157">ሽን ታ ነ ህግያፈ ጋፃ ከይከ።<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>ኤንቲ ነ ኪታ ናጎና ግሾ፥</para>
  <para style="q2" vid="PSA 119:158">ታ ነና ካደይሳታ በአዳ ሻተታስ።<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>አቤት ጎዳዉ፥ ታ ነ ዎጋ ዶሰይሳ በአ፤</para>
  <para style="q2" vid="PSA 119:159">ነ ሲቁዋዳ ታና ደኦን ዎ።<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>ነ ቃላይ ቱማ፤</para>
  <para style="q2" vid="PSA 119:160">ነ ፅሎ ፕርዳይ መርናዉ ደኤስ።<verse eid="PSA 119:160"/></para>
  <para style="qa">ሳን</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>ሀላቃት ታና ጮ የደሶና፤</para>
  <para style="q2" vid="PSA 119:161">ሽን ታ ዎዛናይ ነ ቃላ ያዬስ።<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>ዳሮባ ድእዳ አስ ኡፋይተይሳዳ፥</para>
  <para style="q2" vid="PSA 119:162">ነ ኡፋይሳ ቃላን ታ ኡፋይታይስ።<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>ታኒ ዎርዶ እፃይስ፤ ሻተታይስ፤</para>
  <para style="q2" vid="PSA 119:163">ሽን ነ ህግያ ዶሳይስ።<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>ነ ፅሎ ፕርዳ ግሾ፥</para>
  <para style="q2" vid="PSA 119:164">ታ ነና ጋላስ ላፑን ቶሆ ጋላታይስ።<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>ነ ህግያ ዶሰይሳታስ ፖሎ ሳሮተ ደኤስ፤</para>
  <para style="q2" vid="PSA 119:165">ኤንታ አይብካ በናዉ ዳንዳኤና።<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>አቤት ጎዳዉ፥ ታ ነ አቶተ ኡፋይሳን ናጋይስ፤</para>
  <para style="q2" vid="PSA 119:166">ነ ኪታ ካላይስ።<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>ታኒ ነ ህግያ ናጋይስ፤</para>
  <para style="q2" vid="PSA 119:167">ታ ኩመ ዎዛናፐ ዶሳይስ።<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>ታ ኦገ ኡባ ነ በእያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:168">ታኒ ነ ህግያነ ነ ዎጋ ናጋና፤<verse eid="PSA 119:168"/></para>
  <para style="qa">ታዉ</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>አቤት ጎዳዉ፥ ታ ዋሶይ ነ ስን ጋኮ፤</para>
  <para style="q2" vid="PSA 119:169">ነ ኡፋይሳ ቃላዳ ታዉ አኬካ እማ።<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>ታ ዎሳይ ነ ስን ጋኮ፤</para>
  <para style="q2" vid="PSA 119:170">ነ ኡፋይሳ ቃላዳ ታና አሻ።<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>ኔኒ ነ አዋጁዋ ታና ታማርስያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:171">ታ ዶናፐ ጋላት ፑልታና።<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>ነ ኪታ ኡባይ ፅሎ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 119:172">ታ እንፃርሳይ ነ ቃላባ የፃና።<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>ታኒ ነ ዎጋ ዶርዳ ግሾ፥</para>
  <para style="q2" vid="PSA 119:173">ነ ኩሸይ ታና ማዳናዉ ጊግዳይሳ ግዶ።<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>አቤት ጎዳዉ፥ ነ አሻና መላ ታ ላሞታይስ፤</para>
  <para style="q2" vid="PSA 119:174">ነ ህገይ ታና ኡፋይሴስ።<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>ታኒ ነና ጋላታና መላ፥</para>
  <para style="q2" vid="PSA 119:175">ታና ደኦን ዎ፤</para>
  <para style="q2" vid="PSA 119:175">ነ ፕርዳይ ታና ማዶ።<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>ታኒ ይዳ ዶርሳዳ ቶይላታስ፤</para>
  <para style="q2" vid="PSA 119:176">ታና ነ አይልያ ኮያ፤</para>
  <para style="q2" vid="PSA 119:176">ታ ነ ኪታ ዶግከ።<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="s1">ታ ፆሳዉ ታና አላ</para>
  <para style="d">ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 120:1"/>መቶ ዎደ ታኒ ጎዳ ፄግን</para>
  <para style="q2" vid="PSA 120:1">እ ታዉ ኮይስ።<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>ጎዳዉ፥ ዎርዶ ዶናፐነ</para>
  <para style="q2" vid="PSA 120:2">ጭምያ እንፃርሳፈ ታና አሻ።<verse eid="PSA 120:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>ህንተኖ፥ ዎርዳንቾቶ፥</para>
  <para style="q2" vid="PSA 120:3">ጎዳይ ህንተና ዋትኮ ሎኦ?</para>
  <para style="q2" vid="PSA 120:3">እ ህንተና ዋትድ ሴርኮ ሎኦ?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>እ ህንተና ሌፈትዳ ኦላ ቶራን ጫዳና፤</para>
  <para style="q2" vid="PSA 120:4">ፂፋ ቦንቆን ህንተና ፁጋና።<verse eid="PSA 120:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>ታ ሞሳሀን ደእያ ግሾነ</para>
  <para style="q2" vid="PSA 120:5">ቀዳረ ዱንካነን ኡትዳ ግሾ ታና አየ!<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>ሳሮተ እፅያ አሳራ</para>
  <para style="q2" vid="PSA 120:6">ታኒ ዳሮ ዎደ ደአስ።<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>ታኒ ሳሮ አስ፤</para>
  <para style="q2" vid="PSA 120:7">ሽን ታ ሳሮተባ ሃሳያ ዎደ፥</para>
  <para style="q2" vid="PSA 120:7">ኤንቲ ኦላባ ሃሳዮሶና።<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="s1">ታዉ ማደይ ፆሳፈ ዬስ</para>
  <para style="d">ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 121:1"/>ታዉ ማዶይ አዉፐ ያነ ጋዳ፥</para>
  <para style="q2" vid="PSA 121:1">ታኒ ደረታኮ ፄላስ።<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>ታዉ ማዶይ</para>
  <para style="q2" vid="PSA 121:2">ሳሎነ ሳኣ መዳ ጎዳፐ ዬስ።<verse eid="PSA 121:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>እ ነ ቶሁዋ ሀርችሰና፤</para>
  <para style="q2" vid="PSA 121:3">ነና ናገይስ ስከና።<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>እስራኤለ ናገይስ</para>
  <para style="q2" vid="PSA 121:4">ዝንኤናነ ስከና።<verse eid="PSA 121:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>ጎዳይ ነና ናገይሳ፤</para>
  <para style="q2" vid="PSA 121:5">ነ ኡሻቻን ግድድ፥ ነዉ ኩያ ግዳና።<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>ጋላስ አው ነና ሜና፤</para>
  <para style="q2" vid="PSA 121:6">ቃማ አጌን ነና ቆሄና።<verse eid="PSA 121:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>ጎዳይ ቆህያባ ኡባፈ ነና ናጋና፤</para>
  <para style="q2" vid="PSA 121:7">እ ነና ሳሮ ዎና።<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>ጎዳይ ነ ከሳነ ነ ገሉዋ፥</para>
  <para style="q2" vid="PSA 121:8">ሀችፈ መርናዉ ናጋና።<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="s1">አነ ፆሳ ኬ ቦስ</para>
  <para style="d">ዳዊቲ ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 122:1"/>ኤንቲ ታና፥ “አነ ፆሳ ኬ ቦስ” ያግን፥</para>
  <para style="q2" vid="PSA 122:1">ታና ኡፋይስስ።<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>የሩሳላመ፥</para>
  <para style="q2" vid="PSA 122:2">ኑኒ ነ ፐንገታራ ገልድ ኤቅዳ።<verse eid="PSA 122:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>የሩሳላመይ</para>
  <para style="q2" vid="PSA 122:3">ዳንታዳ ምና ኬፀትዳ ሎኦ ካታማ።<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>ጎዳ ኪታ ማራን እስራኤለ ዛረት፥</para>
  <para style="q2" vid="PSA 122:4">ጎዳ ጋላታናዉ ሄ ካታማ ዮሶና።<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>ዳዊታ ኮቻፈ ካዎትዳ ኡባይ፥</para>
  <para style="q2" vid="PSA 122:5">ባንታ አሳስ ፕርዳናዉ ያን ኡቶሶና።<verse eid="PSA 122:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>የሩሳላመ ሳሮተስ ሀይሳዳ ያግድ ዎስተ፤</para>
  <para style="q2" vid="PSA 122:6">“ነና ዶስያ ኡባይ አንጀቶ።<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>ነ ግምበታ ግዶን ሳሮይ ግዶ፤</para>
  <para style="q2" vid="PSA 122:7">ነ ካዎ ኬን ዎፓተ ደኦ” ያግተ።<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>ታ እሻታነ ታ ዳቦታ ግሾ፥</para>
  <para style="q2" vid="PSA 122:8">“ነ ግዶን ሳሮይ ደኦ” ያጋና።<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>ጎዳ ኑ ፆሳ ኬ ግሾ፥</para>
  <para style="q2" vid="PSA 122:9">ነዉ ሎኦባ አሞታይስ።<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="s1">ኑ አይፈይ ኑ ፆሳ ቦላና</para>
  <para style="d">ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 123:1"/>ሳሎን፥ ነ አራታ ቦላ ኡትዳይሶ፥</para>
  <para style="q2" vid="PSA 123:1">ታኒ ፑደ ኔኮ ፄላይስ።<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>አደ አይለይ ባ ጎዳ ኩሸ ፄለይሳዳ፥</para>
  <para style="q2" vid="PSA 123:2">ማጫ አይልያ ባ ጎዳተ ኩሸ በኤይሳዳ፥</para>
  <para style="q2" vid="PSA 123:2">ኔኒ ኑና ማራና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 123:2">ኑ አይፈይ ጎዳኮ፥ ኑ ፆሳኮ ፄሌስ።<verse eid="PSA 123:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>ኑስ ካይ ዳርዳ ግሾ፥ ኑና ማራ፤</para>
  <para style="q2" vid="PSA 123:3">አቤት ጎዳዉ፥ ኑና ማራ።<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>ኑኒ ኦቶራንቾታ ጫሻነ</para>
  <para style="q2" vid="PSA 123:4">ሳጶታ ካያ ካልዳ።<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="s1">ጎዳይ ኑራ ደኤስ</para>
  <para style="d">ዳዊቲ ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 124:1"/>ጎዳይ ኑራ ግዶናኮ፥ ኑ ዋናኔ?</para>
  <para style="q2" vid="PSA 124:1">እስራኤለይ ሀይሳዳ ያግድ ዛሮ፤<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>“ጎዳይ ኑራ ግዶናኮ፥</para>
  <para style="q2" vid="PSA 124:2">ኑ ቦላ አሳይ ደንድዳ ዎደ፥<verse eid="PSA 124:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 124:3"/>ኤንታ ሀንቆይ ኑ ቦላ ሱልን፥</para>
  <para style="q2" vid="PSA 124:3">ኑና ፓፃ ምታናሽን።<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>ድኦይ ኑና ኤፋናሽን፤</para>
  <para style="q2" vid="PSA 124:4">ሻፋ ሃይ ኑና ምታናሽን።<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>ክፃ ሃይ ኑና ማናሽን” ያጎ።<verse eid="PSA 124:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>ኑና ኑ ሞርከታ አቻስ</para>
  <para style="q2" vid="PSA 124:6">አድ እምቦና ጎዳይ ጋላተቶ።<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>ካፎይ ሻንካ ግተፐ ከስ ኤከይሳዳ፥</para>
  <para style="q2" vid="PSA 124:7">ኑኒ ከስ ኤክዳ፤</para>
  <para style="q2" vid="PSA 124:7">ፅሄይ መቅስ፥ ኑኒ ከስ ኤክዳ።<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>ሳሎነ ሳኣ መዳ፥</para>
  <para style="q2" vid="PSA 124:8">ጎዳ ሱንን ኑስ ማዶይ ዬስ።<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="s1">ፆሳይ ባ አሳ ዩሾና</para>
  <para style="d">ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>ጎዳን አማነተይሳት ቃፃናዉ ዳንዳኦና፥</para>
  <para style="q2" vid="PSA 125:1">መርናዉ ደእያ ፅዮነ ዙማ መላ።<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>ደረት የሩሳላመ ዩሾን ደኤይሳዳ፥</para>
  <para style="q2" vid="PSA 125:2">ሀችፈ መርና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 125:2">ጎዳይ ባ አሳ ዩሾን ደኤስ።<verse eid="PSA 125:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>ፅሎት ባንታ ኩሽያ ኢታባስ ደንና መላ</para>
  <para style="q2" vid="PSA 125:3">ኢታታ አይሶ ፃምአይ ፅሎታ ቢታን ጋምኤና።<verse eid="PSA 125:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>አቤት ጎዳዉ፥ ኬሀ አሳታስነ</para>
  <para style="q2" vid="PSA 125:4">ዎዛና ሱረ አሳታስ ሎኦባ ኦ።<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>ሽን ኔኒ ኢታ አሳታ ሴርያ ዎደ፥</para>
  <para style="q2" vid="PSA 125:5">ነ ኦግያ አግዳ አሳካ ሴራ።</para>
  <para style="p" vid="PSA 125:5">እስራኤለስ ሳሮይ ግዶ።<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="s1">ፆሳዉ ኑና ዛራዳ ጋሽትሳ</para>
  <para style="d">ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 126:1"/>ጎዳይ ድኦፐ ዛሪድ</para>
  <para style="q2" vid="PSA 126:1">ኑና ፅዮነ ኤህዳ ዎደ</para>
  <para style="q2" vid="PSA 126:1">ኑስ አሙሆ ዳንስ።<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>ኑ ዶናይ ሚቻን፥</para>
  <para style="q2" vid="PSA 126:2">ኑ እንፃርሳይ ኡፋይሳ የን ኩምስ።</para>
  <para style="q1" vid="PSA 126:2">ሄ ዎደ ካዎተት ባንታ ግዶን፥</para>
  <para style="q2" vid="PSA 126:2">“ጎዳይ ኤንታዉ ግታባ ኦስ” ያግዶሶና።<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>ቱማ ጎዳይ ኑስ ግታባ ኦስ፤</para>
  <para style="q2" vid="PSA 126:3">ኑካ ዳሮ ኡፋይትዳ።<verse eid="PSA 126:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>ጎዳዉ፥ ነገበ መላ ቢታን እራ ቡክሳዳ፥</para>
  <para style="q2" vid="PSA 126:4">ሻፋ ዛራዳ ኩንይሳዳ፥</para>
  <para style="q2" vid="PSA 126:4">ኑ ዱሳ ኦራ።<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>ዬክሸ ዘርዳይሳት፥</para>
  <para style="q2" vid="PSA 126:5">ኡፋይሳን የፅሸ ጫካና።<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>ዘረ ቶክድ ዬክሸ ብዳይሳት፥</para>
  <para style="q2" vid="PSA 126:6">ኡፋይሳ የ የፅሸ፥</para>
  <para style="q2" vid="PSA 126:6">ምርቀ ቶክድ ስማና።<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="s1">ኬ ኬፀይ ፆሰ</para>
  <para style="d">ሶሎሞነይ ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 127:1"/>ጎዳይ ኬ ኬፆና እፅኮ፥</para>
  <para style="q2" vid="PSA 127:1">ኬፀይሳት ጮ ዳቡሮሶና።</para>
  <para style="q1" vid="PSA 127:1">ጎዳይ ካታማ ናጎና እፅኮ፥</para>
  <para style="q2" vid="PSA 127:1">ናገይሳት ጮ ዳቡሮሶና።<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>ዱሳስ ኮሽያባ ደማናዉ፥</para>
  <para style="q2" vid="PSA 127:2">ዎንታ ጉራ ደንዶይ፥</para>
  <para style="q2" vid="PSA 127:2">ኦማርስ ዳሮ ቃምስድ ገሎይ ሀዳ።</para>
  <para style="q1" vid="PSA 127:2">ጎዳይ ባ ዶሰይሳታስ</para>
  <para style="q2" vid="PSA 127:2">ሸምፖ<note caller="+" style="f"><char style="fr" closed="false">127:2 </char><char style="fq" closed="false">ሸምፖ፦ </char><char style="ft" closed="false">ዎይኮ ስኮ</char></note> እሜስ።<verse eid="PSA 127:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>ናይት ጎዳ እሞታ፤</para>
  <para style="q2" vid="PSA 127:3">የሎት ቱማ ዎይቶ።<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>እስ አስ ናአተን የልዳ አደ ናይት፥</para>
  <para style="q2" vid="PSA 127:4">ኦላንቾ ኩሸን ደእያ ቶራ መላ።<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>እያ ኮሮጆት ሀ ዪሻታን ኩምዳ አስ አንጀትዳይሳ፤</para>
  <para style="q2" vid="PSA 127:5">እ ባ ሞርከታራ ካታማ ፐንገን፥</para>
  <para style="q2" vid="PSA 127:5">ሞተትያ ዎደ ሻትመና።<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="s1">ፆሰ ባብያ አስ አንጀትዳይሳ</para>
  <para style="d">ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 128:1"/>ጎዳስ ያየይሳትነ እያ ኦግያን</para>
  <para style="q2" vid="PSA 128:1">ሄመተይሳት ኡባይ አንጀትዳይሳታ።<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>ኔኒ ነ ዳቡራ አይፈ ማና፤</para>
  <para style="q2" vid="PSA 128:2">ኡፋይታናነ ዱረታና።<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>ነ ማችያ ነ ሶን አይፈ</para>
  <para style="q2" vid="PSA 128:3">ዱርኩክዳ ዎይነ መላ ግዳና።</para>
  <para style="q1" vid="PSA 128:3">ነ ናይት ነ ጋይታ ዩሾን</para>
  <para style="q2" vid="PSA 128:3">ሻማሆ አጫ መላ ግዳና።<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>ጎዳስ ያይያ አስ</para>
  <para style="q2" vid="PSA 128:4">ቱማ ሄሳዳ አንጀታና።<verse eid="PSA 128:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>ጎዳይ ነና ፅዮነፐ አንጆ!</para>
  <para style="q2" vid="PSA 128:5">ኔኒ ደእዳ ላይ ኡባን</para>
  <para style="q2" vid="PSA 128:5">የሩሳላመ ሎኦተ ነና በሶ!<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>ነ ናይታ ናይታ በአ!</para>
  <para style="q2" vid="PSA 128:6">እስራኤለስ ሳሮይ ግዶ!<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="s1">ናአተፈ ዶምድ ታና ኡንኤዶሶና</para>
  <para style="d">ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 129:1"/>እስራኤለይ ሀይሳዳ ያጎ፤</para>
  <para style="q1" vid="PSA 129:1">“ታ ናአተፈ ዶምድ፥</para>
  <para style="q2" vid="PSA 129:1">ታ ሞርከት ታና ኡንኤዶሶና።<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>ኤ፥ ኤንቲ ታ ናአተፈ ዶምድ፥</para>
  <para style="q2" vid="PSA 129:2">ታና ኡንኤዶሶና፤</para>
  <para style="q2" vid="PSA 129:2">ሽን ኤንቲ ታና ፆንቦኮና።<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>ታ ዞኩዋ ፁርቃፈን ሾጭድ፥</para>
  <para style="q2" vid="PSA 129:3">ጎሻ ጋደ ዳንስዶሶና”።<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>ሽን ጎዳይ ፅሎ ግድያ ግሾ</para>
  <para style="q2" vid="PSA 129:4">ኢታታ ዎዶሩዋ ዱሰረ የግስ።<verse eid="PSA 129:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>ፅዮነ እፅያ ኡባይ</para>
  <para style="q2" vid="PSA 129:5">ዬላትድ ጉየ ስሞ።<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>ኬ ሁጰን ዶልዳ፥</para>
  <para style="q2" vid="PSA 129:6">ድጮና መልዳ ማታ መላ ግዶ።<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>ሄ ማታ ቡጫናዉ ኩሸን ዳንከይ</para>
  <para style="q2" vid="PSA 129:7">ዎይኮ ምርቃናዉ ኦይከይ ባዋ።<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>ኦገራ አይሳት፥</para>
  <para style="q2" vid="PSA 129:8">“ጎዳይ ዎልቃ እሞ” ግን፥</para>
  <para style="q2" vid="PSA 129:8">ጫከይሳት “ጎድ አንጆ” ግያባይ ዴና።<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="s1">ታ ሸምፕያ ነና ናጋዉሱ</para>
  <para style="d">ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 130:1"/>ጎዳዉ፥ ታኒ መቶ ጪሞን ደአሸ፥</para>
  <para style="q2" vid="PSA 130:1">ኔኮ ዋሳይስ።<verse eid="PSA 130:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2"/>ጎዳዉ፥ ታ ዋሱዋ ስአ፤</para>
  <para style="q2" vid="PSA 130:2">ታ ዎሳ ነ ሀይይ ሀይዞ።<verse eid="PSA 130:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>ፆሳዉ፥ ኑ ናጋራ ነ ፃፋ ኦይክዳኮ፥</para>
  <para style="q2" vid="PSA 130:3">ጎዳዉ፥ ኦን ፕርዳፈ አታናዉ ዳንዳኢ?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>ሽን ኑኒ ነዉ ያያና መላ፥</para>
  <para style="q2" vid="PSA 130:4">ኑ ናጋራ አቶ ያጋሳ።<verse eid="PSA 130:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>ታኒ ጎዳ ላሞታን ናጋይስ፤</para>
  <para style="q2" vid="PSA 130:5">ታ ሸምፕያ ላሞታን ናጋዉሱ፤</para>
  <para style="q2" vid="PSA 130:5">ታኒ እያ ቃላን ኡፋይስ ዎይስ።<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>ሳእ አዉደ ዎንታነ ግድ፥</para>
  <para style="q2" vid="PSA 130:6">ናግያ ዎታዳረፐ አዳ፥</para>
  <para style="q2" vid="PSA 130:6">ታኒ ጎዳ ላሞታን ናጋይስ።<verse eid="PSA 130:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>እያ ሲቆይ መርናሳ ግድያ ግሾነ</para>
  <para style="q2" vid="PSA 130:7">እያን ኩመ አቶተ ደእያ ግሾ</para>
  <para style="q2" vid="PSA 130:7">እስራኤለ፥ ጎዳን ኡፋይስ ኦ፤<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>ጎዳይ እስራኤለ፥</para>
  <para style="q2" vid="PSA 130:8">እያ ናጋራ ኡባፈ አሻና።<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="s1">ፆሳን አማነታ</para>
  <para style="d">ፑደ ከይሸ ዳዊቲ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 131:1"/>ጎዳዉ፥ ታ ዎዛናይ ኦቶርተና፤</para>
  <para style="q2" vid="PSA 131:1">ታ አይፈይካ ኦቶሮን ፄለና።</para>
  <para style="q1" vid="PSA 131:1">ታ ቆፋን ግታታና ጋዳ ኮያብከ፤</para>
  <para style="q2" vid="PSA 131:1">ጋሄቶናባ ኤካና ጋዳ ዛቱራብከ።<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>ን ዱፅዳ ናእ</para>
  <para style="q2" vid="PSA 131:2">ባ አየ ክኦን ስእ ገይሳዳ ታ ስእ ጋስ።</para>
  <para style="q1" vid="PSA 131:2">ዋየ አግዳ ናአዳ፥</para>
  <para style="q2" vid="PSA 131:2">ታ ሸምፖይ ታ ጋን ዎፑ ግስ።<verse eid="PSA 131:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>እስራኤለ፥ ሀችፈ መርና ጋካናዉ</para>
  <para style="q2" vid="PSA 131:3">ጎዳን ኡፋይስ ኦ።<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="s1">ፆሳይ ፅዮነ ዶርስ</para>
  <para style="d">ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 132:1"/>ጎዳዉ፥ ዳዊታነ</para>
  <para style="q2" vid="PSA 132:1">እ ዳንዳእዳ መቱዋ ኡባ ቆፓ።<verse eid="PSA 132:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>ጎዳስ እ ጫቅዳይሳ፥</para>
  <para style="q2" vid="PSA 132:2">ዎልቃማ ግድዳ ያይቆባ ፆሳስ፥</para>
  <para style="q2" vid="PSA 132:2">እ ኦድዳይሳ ሀሳያ።<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3-5" style="v" sid="PSA 132:3-5"/>ጎዳስ በሰ ጊግሳና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 132:3-5">ዎልቃማ ግድዳ ያይቆባ ፆሳስ፥</para>
  <para style="q2" vid="PSA 132:3-5">ኬ ኬፃና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 132:3-5">ታ ሶ ገልከ፤</para>
  <para style="q2" vid="PSA 132:3-5">ታ ሂፃን ዝንእከ።</para>
  <para style="q1" vid="PSA 132:3-5">ታ አይፈይ ቅልምኤና፥</para>
  <para style="q2" vid="PSA 132:3-5">ዎይኮ ታና ስኮይ ኤከና።<verse eid="PSA 132:3-5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>ኑኒ ታቦትያባ</para>
  <para style="q2" vid="PSA 132:6">ኤፍራታን ስእዳ፤</para>
  <para style="q2" vid="PSA 132:6">ይኣርመ ቢታን እያ ደምዳ።<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>“አነ እ ደእያ በሳ ቦስ፤</para>
  <para style="q2" vid="PSA 132:7">እያ ቶሆይ የያ በሳን</para>
  <para style="q2" vid="PSA 132:7">እያ ጎይኖስ።”<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>ጎዳዉ፥ ደንዳ!</para>
  <para style="q2" vid="PSA 132:8">ነ ምኖተ ማላ ግድዳ</para>
  <para style="q2" vid="PSA 132:8">ነ ታቦትያራ ነ ኬ ገላ።<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>ነ ካህነት ፅሎተ ማኦ፤</para>
  <para style="q2" vid="PSA 132:9">ነ አሳይ ኡፋይሳን የፆ።<verse eid="PSA 132:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>ነ አይልያ ዳዊታ ግሾ፥</para>
  <para style="q2" vid="PSA 132:10">ኔኒ ትይዳ ካዋ አጎፋ።<verse eid="PSA 132:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>ጎዳይ ዳዊታስ ላመቶና ጫቆ</para>
  <para style="q2" vid="PSA 132:11">ሀይሳዳ ያግድ ጫቅስ፤</para>
  <para style="q1" vid="PSA 132:11">“ነ ጉልባታፐ ከይዳ፥</para>
  <para style="q2" vid="PSA 132:11">ነ ናይታፐ እሱዋ ነ አራታን ኡትሳና።<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>ነ ናይት ታ ጫቁዋነ</para>
  <para style="q2" vid="PSA 132:12">ታ ታማርስያ ትምርትያ ናግኮ፥</para>
  <para style="q2" vid="PSA 132:12">ኤንታ ናይት ነ አራታን መርናዉ ኡታና” ያግስ።<verse eid="PSA 132:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>ጎዳይ ፅዮነ ዶርስ፤</para>
  <para style="q2" vid="PSA 132:13">ባዉ ደእያ በሲ ኦናዉ አሞትድ፥</para>
  <para style="q2" vid="PSA 132:13">ሀይሳዳ ያግስ፤<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“ሀይስ ታ መርናዉ ደእያ በሰ፤</para>
  <para style="q2" vid="PSA 132:14">ታኒ አሞትዳ ግሾ ሀይሳን ዳና።<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>ታኒ ዳሮ ካ እማዳ ፅዮነ አንጃና፤</para>
  <para style="q2" vid="PSA 132:15">እያን ደእያ ማንቆታካ ካ ካልሳና።<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>እያን ደእያ ካህነታ አቶተ ማይዛና፤</para>
  <para style="q2" vid="PSA 132:16">እያን ደእያ ፅሎት ኡፋይሳን የፃና።<verse eid="PSA 132:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>ሄ በሳን ዳዊታ ዘርያፐ ካዎ ከሳና፤</para>
  <para style="q2" vid="PSA 132:17">ታኒ ትይዳ ካዋ ካዎተን ጋምእሳና።<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>ታኒ እያ ሞርከታ ዬላ ማይዛና፤</para>
  <para style="q2" vid="PSA 132:18">ሽን እያ ሁጰን ደእያ ካላቻይ ጶላና” ያጋስ።<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="s1">እስፈተ ጎአ</para>
  <para style="d">ዳዊቲ ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>እሻት እስፈተን ደኤይስ፥</para>
  <para style="q2" vid="PSA 133:1">ዋን ሎእ ዋን ኡፋይስ!<verse eid="PSA 133:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>ሄስ ሁጰን ትግን፥ ቡቻራ ጎግያ፥</para>
  <para style="q2" vid="PSA 133:2">አሮና ቡቻራ ጎግድ</para>
  <para style="q2" vid="PSA 133:2">እያ ሀሽያ ጋክያ አልኦ ዛይተ መላ።<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>ሄስ አርሞና ዙማፐ</para>
  <para style="q2" vid="PSA 133:3">ፅዮነ ደረታ ጋካናዉ</para>
  <para style="q2" vid="PSA 133:3">ዎያ አካ መላ።</para>
  <para style="q1" vid="PSA 133:3">ጎዳይ ያን አንጁዋነ፥</para>
  <para style="q2" vid="PSA 133:3">ደኡዋ መርናዉ እሚስ።<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="s1">ሃ ዪተ ጎዳ አንጅተ</para>
  <para style="d">ፑደ ከይሸ የፅያ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 134:1"/>ህንተኖ፥ ጎዳ አይለቶ፥</para>
  <para style="q2" vid="PSA 134:1">ጎዳ ኬን ቃማ ኦይሳቶ፥</para>
  <para style="q2" vid="PSA 134:1">ኡባይ ይድ ጎዳ ጋላትተ።<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>ፆሳ ኬን</para>
  <para style="q2" vid="PSA 134:2">ህንተ ኩሽያ ምጭድ፥</para>
  <para style="q2" vid="PSA 134:2">ጎዳ ጋላትተ።<verse eid="PSA 134:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>ሳሉዋነ ሳኣ መዳ ጎዳይ</para>
  <para style="q2" vid="PSA 134:3">ህንተና ፅዮነፐ አንጆ።<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="s1">ፆሳ ሱንይ መርናዉ ኤረቴስ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 135:1"/>ጎዳ ጋላትተ!</para>
  <para style="q1" vid="PSA 135:1">ህንተኖ፥ ጎዳ አይለቶ፥</para>
  <para style="q2" vid="PSA 135:1">ጎዳ ሱን ጋላትተ!<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>ህንተኖ፥ ጎዳ ኬን፥</para>
  <para style="q2" vid="PSA 135:2">ኑ ፆሳ ኬ ዳባባን ኤቀይሳቶ፥</para>
  <para style="q2" vid="PSA 135:2">ጎዳ ጋላትተ!<verse eid="PSA 135:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>እ ኬሀ ግድያ ግሾ ጎዳ ጋላትተ!</para>
  <para style="q2" vid="PSA 135:3">እ ሎኦ ግድያ ግሾ እያ ሱን ሳቢተ!<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>ጎዳይ ያይቆባ ባባ፥</para>
  <para style="q2" vid="PSA 135:4">እስራኤለ ባዉ ቡዞ ኦድ ዶርስ።<verse eid="PSA 135:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>ጎዳይ ግታ ግደይሳነ</para>
  <para style="q2" vid="PSA 135:5">ኑ ጎዳይ፥ ፆሳታ ኡባፈ አይሳ</para>
  <para style="q2" vid="PSA 135:5">ታኒ ኤራይስ።<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>ሳሎን ሳአን፥ አባንነ እያ ግዶን</para>
  <para style="q2" vid="PSA 135:6">ጎዳይ ባ ዶስዳባ ኡባ ኦስ።<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>ሻራ ሳኣ ጋፃፐ ደንስ፤</para>
  <para style="q2" vid="PSA 135:7">ዎልአን እራራ ኪቴስ፤</para>
  <para style="q2" vid="PSA 135:7">ጫርኮ ባ ምንጃ ኬፈ ከሴስ።<verse eid="PSA 135:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>ግብፀ ቢታን አሳፐ መሄ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 135:8">ባይራ የለትዳ ኡባ ዎስ።<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>ነኖ ግብፀ፥</para>
  <para style="q2" vid="PSA 135:9">ፓሮናነ እያ አይለታ ኡባ ሴራናዉ</para>
  <para style="q2" vid="PSA 135:9">ማላታታነ ማላልስያባታ ኪትስ።<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>እ ዳሮ ካዎተታ ይስስ፤</para>
  <para style="q2" vid="PSA 135:10">ዎልቃማ ካዎታ ዎስ።<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>አሞረ ካዋ ስሆና</para>
  <para style="q2" vid="PSA 135:11">ባሳነ ካዋ ኦገነ</para>
  <para style="q2" vid="PSA 135:11">ካናነ ካዎታ ኡባ ዎስ።<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>ኤንታ ቢታ ባ አሳ፥</para>
  <para style="q2" vid="PSA 135:12">እስራኤለ ላትስስ።<verse eid="PSA 135:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>ጎዳዉ፥ ነ ሱንይ መርናዉ ዳና፤</para>
  <para style="q2" vid="PSA 135:13">የለታፐ የለታ ጋካናዉ ነ ሀሳየታና።<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>ጎዳይ ባ አሳስ ፕርዳና፤</para>
  <para style="q2" vid="PSA 135:14">እ ባ አይለታስ ቃታና።<verse eid="PSA 135:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>ካዎተታ ኤቃት አሳ ኩሸ ኦሶታ፤</para>
  <para style="q2" vid="PSA 135:15">ብራፐነ ዎርቃፈ መትዳይሳታ።<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>ኤንታዉ ዶን ደኤስ፥ ሽን ሃሳዮኮና፤</para>
  <para style="q2" vid="PSA 135:16">አይፈይ ደኤስ፥ ሽን ፄሎኮና።<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>ሀይ ደኤስ፥ ሽን ስኦኮና፤</para>
  <para style="q2" vid="PSA 135:17">ኤንታ ሲን ሸምፖይ ባዋ።<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>ኤንታ መዳይሳትነ</para>
  <para style="q2" vid="PSA 135:18">ኤንታን አማነተይሳት</para>
  <para style="q2" vid="PSA 135:18">ኡባይ ኤንታዳ ሀኖ።<verse eid="PSA 135:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>እስራኤለ አሳዉ ጎዳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 135:19">አሮና ሶ አሳዉ ጎዳ ጋላትተ።<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>ሌወ ሶ አሳዉ ጎዳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 135:20">ጎዳ ያየይሳቶ ኡባይ ጎዳ ጋላትተ።<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>የሩሳላመን ደእያ ጎዳይ</para>
  <para style="q2" vid="PSA 135:21">ፅዮነን ጋላተቶ!</para>
  <para style="q2" vid="PSA 135:21">ጎዳ ጋላትተ!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="s1">እያ ማሮተይ መርናሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>ጎዳ ጋላትተ!</para>
  <para style="qr" vid="PSA 136:1">እ ኬሀ፤ እያ ሲቆይ መርናሳ።<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>ፆሳታ ፆሳ ጋላትተ!</para>
  <para style="qr" vid="PSA 136:2">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>ጎዳታ ጎዳ ጋላትተ!</para>
  <para style="qr" vid="PSA 136:3">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>እያ ፃላል ግታ ማላልስያባ ኦስ፤</para>
  <para style="qr" vid="PSA 136:4">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>ባ ጭንጫተን ሳሎታ መስ፤</para>
  <para style="qr" vid="PSA 136:5">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>ሃ ቦላ ቢታ ምጭስ፤</para>
  <para style="qr" vid="PSA 136:6">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>ግታ ፖኦታ መስ፤</para>
  <para style="q2" vid="PSA 136:7">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>አው ጋላስ ሃራና መላ ኦስ፤</para>
  <para style="qr" vid="PSA 136:8">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>አጌንነ ፆልንቶት</para>
  <para style="q2" vid="PSA 136:9">ቃማ ሃራና መላ ኦስ፤</para>
  <para style="qr" vid="PSA 136:9">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>ግብፀ ቢታን ባይራታ ዎስ፤</para>
  <para style="qr" vid="PSA 136:10">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>እስራኤለ አሳ ግብፀፈ ካለድ ከስስ፤</para>
  <para style="qr" vid="PSA 136:11">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>ባ ምኖ ኩሽያን፥</para>
  <para style="q2" vid="PSA 136:12">ባ ዎልቃማ ቀስያን ሀይሳ ኦስ፤</para>
  <para style="qr" vid="PSA 136:12">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>ዞኦ አባ ሻክስ፤</para>
  <para style="qr" vid="PSA 136:13">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>እስራኤለ አሳ ሄ አባ ግዶራ ፕንስ፤</para>
  <para style="qr" vid="PSA 136:14">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>ግብፀ ካዋነ እያ ኦላንቾታ</para>
  <para style="q2" vid="PSA 136:15">ዞኦ አባን ሙክስስ፤</para>
  <para style="qr" vid="PSA 136:15">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>እ ባ አሳ መላ ቢታራ ካለስ፤</para>
  <para style="qr" vid="PSA 136:16">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>ግታ ካዎታ ሾጭስ፤</para>
  <para style="qr" vid="PSA 136:17">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>ዎልቃማ ካዎታ ዎስ፤</para>
  <para style="qr" vid="PSA 136:18">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>አሞረ ካዋ ስሆና ዎስ፤</para>
  <para style="qr" vid="PSA 136:19">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>ባሳነ ካዋ ኦገ ዎስ፤</para>
  <para style="qr" vid="PSA 136:20">ሲቆይ መርናሳ።<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>ኤንታ ቢታ ባ አሳ ላትስስ፤</para>
  <para style="qr" vid="PSA 136:21">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>ባ አይልያ እስራኤለ ላትስስ፤</para>
  <para style="qr" vid="PSA 136:22">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>ኑ ካዉይዳ ዎደ ኑና ቆፕስ፤</para>
  <para style="qr" vid="PSA 136:23">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>ኑና ኑ ሞርከታፐ አሽስ፤</para>
  <para style="qr" vid="PSA 136:24">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>መተ ኡባስ ካ እሜስ፤</para>
  <para style="qr" vid="PSA 136:25">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>ሳሎ ፆሳ ጋላትተ!</para>
  <para style="qr" vid="PSA 136:26">እያ ሲቆይ መርናሳ።<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="s1">አይለተን ደእያ አሳ ዬሆ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>ባብሎነ ሻፋታ ማታን ኡትድ፥</para>
  <para style="q2" vid="PSA 137:1">ፅዮነ ቆፕዳ ዎደ ዬክዳ።<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>ሄ በሳን ኑኒ</para>
  <para style="q2" vid="PSA 137:2">ኑ ዲ ሃ ጋፃን ድጭያ፥</para>
  <para style="q2" vid="PSA 137:2">ምታ ቦላ ካቅዳ።<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>ኑና ድእዳ አሳት ኑኒ የፅድ፥</para>
  <para style="q2" vid="PSA 137:3">ኤንታ ኡፋይሳና መላ</para>
  <para style="q2" vid="PSA 137:3">“ፅዮነ የታፐ እሱዋ አነ ኑስ የፅተ” ያግዶሶና።<verse eid="PSA 137:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>ጎዳ የ ኑኒ አላጋ ቢታን</para>
  <para style="q2" vid="PSA 137:4">ዋት የፃኔ?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>የሩሳላመ ታኒ ነና ዶግኮ፥</para>
  <para style="q2" vid="PSA 137:5">ታ ኡሻቻ ኩሸይ ታና ባሎ።<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>ታኒ ነና ሀሳዮና አግኮ፥</para>
  <para style="q2" vid="PSA 137:6">ታ ግታ ኡፋይስ ግድዳ የሩሳላመ ዶሶና እፅኮ፥</para>
  <para style="q2" vid="PSA 137:6">ታ እንፃርሳይ ኮቶኑዋራ ኦይከቶ።<verse eid="PSA 137:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>ጎዳዉ፥ የሩሳላመ ድኤትያ ጋላስ</para>
  <para style="q2" vid="PSA 137:7">ኤዶመ አሳይ ኦዳይሳ ሀሳያ፤</para>
  <para style="q1" vid="PSA 137:7">ኤንቲ፥ “ላልተ! ላልተ!</para>
  <para style="q2" vid="PSA 137:7">ህርክ ፃጱዋ ጋካናዉ ላልተ!”</para>
  <para style="m" vid="PSA 137:7">ያግዳይሳ ዶጎፓ።<verse eid="PSA 137:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>ባብሎነ፥ ኔኒ ያና!</para>
  <para style="q2" vid="PSA 137:8">ኔኒ ኑ ቦላ ኦዳ ኢታ ኦሱዋስ</para>
  <para style="q2" vid="PSA 137:8">ሀሎ ከሰይስ አንጀትዳይሳ።<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>ነ ጉ ናይታ ኦይክድ፥</para>
  <para style="q2" vid="PSA 137:9">ዛላ ቦላ ሾጨይስ አንጀትዳይሳ።<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="s1">ፆሳ ጋላትተ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 138:1"/>ጎዳዉ፥ ታ ኩመ ዎዛናን ነና ጋላታና፤</para>
  <para style="q2" vid="PSA 138:1">ፆሳታ ስንን ነና ሳባና።<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>ነ ጌሻ ኬኮ ስማዳ ነና ጎይናና፤</para>
  <para style="q2" vid="PSA 138:2">ነ ሲቁዋ ግሾነ ነ ቱማተ ግሾ ጋላታና።</para>
  <para style="q1" vid="PSA 138:2">ነ ሱን ግሾነ</para>
  <para style="q2" vid="PSA 138:2">ነ ቃላ ቃተ ግሾ ጋላታና።<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>ታኒ ፄግዳ ዎደ ነ ታዉ ኮያዳሳ፤</para>
  <para style="q2" vid="PSA 138:3">ነ ምኖተን ታና ምንዳሳ።<verse eid="PSA 138:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>ጎዳዉ፥ ነ ዶናፐ ከይያ ቃላ ስእያ ዎደ፥</para>
  <para style="q2" vid="PSA 138:4">ሳአን ደእያ ካዎት ኡባይ ነና ጋላቶ።<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>ጎዳ ቦንቾይ ግታ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 138:5">ኤንቲ ጎዳ ኦግያባ የፆ።<verse eid="PSA 138:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>ጎዳይ ቦላ ቃን ደእኮካ፥</para>
  <para style="q2" vid="PSA 138:6">ማንቆታ ኬሀ አይፈን ፄሌስ፤</para>
  <para style="q2" vid="PSA 138:6">ሽን ኦቶራንቾታ ሃሆን ኤሬስ።<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>ታኒ መቶ ግዶራ ሄመትኮካ፥</para>
  <para style="q2" vid="PSA 138:7">ኔኒ ታና ናጋሳ።</para>
  <para style="q1" vid="PSA 138:7">ታ ሞርከታ ሀንቁዋ ቦላ ነ ኩሽያ ምጫሳ፤</para>
  <para style="q2" vid="PSA 138:7">ነ ኡሻቻ ኩሽያን ታና አሻሳ።<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>ጎዳይ ታዉ ገልዳ ቃላ ፖላና፤</para>
  <para style="q2" vid="PSA 138:8">ጎዳዉ፥ ነ ሲቆይ መርናሳ፤</para>
  <para style="q2" vid="PSA 138:8">ነ ኩሸ ኦሱዋ የጋ አጎፋ።<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="s1">ታ ዎዛና ፕልጋዳ በአ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 139:1"/>ጎዳዉ፥ ኔኒ ታና ፕልጋዳ ኤራዳሳ።<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>ኔኒ ታ ኡተነ ታ ኤቁዋ ኤራሳ፤</para>
  <para style="q2" vid="PSA 139:2">ታ ቆፋ ኡባ ሃሆን አኬካሳ።<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>ታኒ ብያ በሳነ ሸምፕያ በሳ ፆሞሳሳ፤</para>
  <para style="q2" vid="PSA 139:3">ታ ኦገታ ኡባ ኤራሳ።<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>ጎዳዉ፥ ታኒ ታ እንፃርሳን</para>
  <para style="q2" vid="PSA 139:4">እስ ቃላ ኦደታናፐ ስን፥</para>
  <para style="q2" vid="PSA 139:4">ታ ቆፋ ኡባ ኤራሳ።<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>ኔኒ ታ ዩሹዋን ደኣሳ፤</para>
  <para style="q2" vid="PSA 139:5">ነ ኩሽያ ታ ቦላ ዎሳ።<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>ነ ኤራተይ ታና ዳሮ ማላልሴስ፤</para>
  <para style="q2" vid="PSA 139:6">ታ አኬካፐ ቃ።<verse eid="PSA 139:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>ታ ነ አያናፐ አዉ ባቃታኔ?</para>
  <para style="q2" vid="PSA 139:7">ነ ስንፈ አዉ ባኔ?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>ፑደ ሳሎ ከይኮ ነ ያን ደኣሳ!</para>
  <para style="q2" vid="PSA 139:8">ዱገ ስኦለ ዎኮካ ነ ያን ደኣሳ።<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>ዶሎሀ ባጋ ፓላዳ ቢኮ፥</para>
  <para style="q2" vid="PSA 139:9">ዎይኮ ዉሎሀ ባጋን ሃካዳ ደእኮ፥<verse eid="PSA 139:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 139:10"/>ያን ነ ኩሸይ ታና ካለስ፤</para>
  <para style="q2" vid="PSA 139:10">ነ ኡሻቻ ኩሸይ ታና ዘምፕሴስ።<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>“ማዉ ታና ገን፤</para>
  <para style="q2" vid="PSA 139:11">ጋላሳዉ ቃማ ላመታ” ግያኮካ፥<verse eid="PSA 139:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 139:12"/>ሳካና ም ነዉ መና፤</para>
  <para style="q2" vid="PSA 139:12">ቃም ጋላሳዳ ፖኤስ፤</para>
  <para style="q2" vid="PSA 139:12">ነዉ ም ፖኦ መላ።<verse eid="PSA 139:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>ኔኒ ታ ግዶ አሳተ መዳሳ፤</para>
  <para style="q2" vid="PSA 139:13">ታ አየ ኡሎን ታና ኔኒ ትላዳሳ።<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>ኔኒ ታና ማላልስያባነ</para>
  <para style="q2" vid="PSA 139:14">የገልስ ኦዳ መዳ ግሾ፥</para>
  <para style="q2" vid="PSA 139:14">ታኒ ነና ጋላታይስ።</para>
  <para style="q1" vid="PSA 139:14">ነ ኦሶት ማላልሴስ!</para>
  <para style="q2" vid="PSA 139:14">ታኒ ሄሳ ሎይዳ ኤራይስ።<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>ታኒ ጌማ በሳን መትያ ዎደ፥</para>
  <para style="q2" vid="PSA 139:15">ታ መቀይ ኔፐ ጌምቤና።</para>
  <para style="q1" vid="PSA 139:15">ታ አሳተይ ታ አየ ኡሎን ጪሞ ግዶን</para>
  <para style="q2" vid="PSA 139:15">ሂላን አሌቀትድ ኦሰትያ ዎደ፥<verse eid="PSA 139:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 139:16"/>ነ አይፈት ጊጎና ታ አሳተ በእዶሶና።</para>
  <para style="q2" vid="PSA 139:16">ቡሮ እሶይካ ዶመቶና ደእሽን፥</para>
  <para style="q2" vid="PSA 139:16">ነ ታዉ ቡዞይዳ ጋላሳ ኡባይ</para>
  <para style="q2" vid="PSA 139:16">ነ ማዝጋበን ፃፈትዶሶና።<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>ፆሳዉ፥ ነ ታዉ ቆፕያ ቆፋይ</para>
  <para style="q2" vid="PSA 139:17">ዋንዳ ቦንቾ!</para>
  <para style="q2" vid="PSA 139:17">ኤንታ ታይቦይ ዋንድ ዳርደ!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>ታኒ ኤንታ ታይብያኮ ሻፈፐ ዳሮ፤</para>
  <para style="q2" vid="PSA 139:18">ታኒ ባርክያ ዎደ ሀእካ ኔራ ደአስ።<verse eid="PSA 139:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>ፆሳዉ፥ ኔኒ ኢታታ ዎያኮ አይበ!</para>
  <para style="q2" vid="PSA 139:19">ሱ ጉስያ አሳት ታፐ ሃኮ!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>ኤንቲ ነ ቦላ ኢታባ ሃሳዮሶና፤</para>
  <para style="q2" vid="PSA 139:20">ነ ሞርከት ነ ሱን ኢሶሶና።<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>ጎዳዉ፥ ነና እፀይሳታ ታ እፅክና?</para>
  <para style="q2" vid="PSA 139:21">ነ ቦላ ደንደይሳታ ታ ሻተትክና?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>ታኒ ኤንታ ኩመ እፃይስ፤</para>
  <para style="q2" vid="PSA 139:22">ኤንታ ታኒ ታ ሞርከዳ ታይባይስ።<verse eid="PSA 139:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>ፆሳዉ፥ ታና ፕልጋዳ ታ ዎዛና ኤራ፤</para>
  <para style="q2" vid="PSA 139:23">ታና ኡንኤዳ ታ ቆፋ በአ።<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>ታናን ኢታባይ ደእኮ ፄላ፤</para>
  <para style="q2" vid="PSA 139:24">መርና ኦግያን ታና ካለ።<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="s1">ኢታ አሳ ኩሸፐ ታና አሻ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 140:1"/>ጎዳዉ፥ ኢታታፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 140:1">ማካላንቾታፐ ታና ናጋ።<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>ኤንቲ ኢታ ኦናዉ ማቀቶሶና፤</para>
  <para style="q2" vid="PSA 140:2">ጋላስ ጋላስ ኦላ ደንሶና።<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>ባንታ እንፃርሳ ሾሻ እንፃርሳዳ ቃራዮሶና፤</para>
  <para style="q2" vid="PSA 140:3">ኤንታ ዶናን ዎያ ማርዘይ ደኤስ። <char style="qs">ሳላሀ </char><verse eid="PSA 140:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>ጎዳዉ፥ ኢታታ ኩሸፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 140:4">ታ ቶሁዋ ቃፃናዉ ቆፕያ</para>
  <para style="q2" vid="PSA 140:4">ማካላንቾታፐ ታና ናጋ።<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>ኦቶራንቾ አሳት ታዉ ፅሄ ዎሶና፤</para>
  <para style="q2" vid="PSA 140:5">ግተ ሂፆሶና፤</para>
  <para style="q2" vid="PSA 140:5">ታና ኦይካናዉ ግተ የጎሶና። <char style="qs">ሳላሀ </char><verse eid="PSA 140:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>ጎዳ፥ “ኔኒ ታ ፆሳ” ጋና፤</para>
  <para style="q2" vid="PSA 140:6">ጎዳዉ፥ ታ ዎሳ ስአ።<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>ኡባ ሃርያ ጎዳዉ፥</para>
  <para style="q2" vid="PSA 140:7">ታና አሽያ ምኑዋዉ፥</para>
  <para style="q2" vid="PSA 140:7">ኦላ ጋላስ ታዉ ጎንዳለ ግዳዳሳ።<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>ጎዳዉ፥ ኢታታስ ኤንታ አሙዋ እሞፋ፤</para>
  <para style="q2" vid="PSA 140:8">ኤንቲ ኦቶርቶና መላ ኤንታ ማቁዋ ፖልሶፓ። <char style="qs">ሳላሀ </char><verse eid="PSA 140:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>ታ ሞርከታን ታና ፆንሶፓ፤</para>
  <para style="q2" vid="PSA 140:9">ኤንታ ዶናፐ ከይያ ኢታይ</para>
  <para style="q2" vid="PSA 140:9">ኤንታ ቦላ ስሞ።<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>ኤንታ ቦላ ፁግያ ታማ ቦንቆይ ቆለቶ፤</para>
  <para style="q2" vid="PSA 140:10">ኤንቲ ታማ ኦላን የገቶ፤</para>
  <para style="q2" vid="PSA 140:10">ከያናዉ ዳንዳኦና ኦላ ሆለቶ።<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>ዮያማት ቢታ ቦላ ደኦፖ፤</para>
  <para style="q2" vid="PSA 140:11">ቡቀይሳታ ኢታባይ የደድ ኦይኮ።<verse eid="PSA 140:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>ጎዳይ ማንቆታስ ፕርደይሳነ</para>
  <para style="q2" vid="PSA 140:12">መቶታንቾታስ ሞተተይሳ ኤራይስ።<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>ፅሎት ቱማ ነ ሱን ጋላታና፤</para>
  <para style="q2" vid="PSA 140:13">ሱረ አሳት ነ ስንን ዳና።<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="s1">ነ ሀይ ታኮ ዛራ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 141:1"/>ጎዳዉ፥ ታኒ ነና ፄጋይስ፤</para>
  <para style="q2" vid="PSA 141:1">ታና ማዳናዉ ኤለሳ፤</para>
  <para style="q2" vid="PSA 141:1">ታ ኔኮ ዋስያ ዎደ ታና ስአ!<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>ታ ዎሳይ እፃነዳ ነ ስን ሺቆ፤</para>
  <para style="q2" vid="PSA 141:2">ታ ኩሸ ምጨይ ኦማርሳ ያርሾ መላ ግዶ።<verse eid="PSA 141:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>ጎዳዉ፥ ታ ዶና ናግያ አስ ዎ፤</para>
  <para style="q2" vid="PSA 141:3">ታ መተርሻ ፐንግያ ናጋ።<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>ኢታ ኦያ አሳታራ ኢታ ኦና መላ፥</para>
  <para style="q2" vid="PSA 141:4">ታ ዎዛና ኢታኮ ዛሮፓ፤</para>
  <para style="q2" vid="PSA 141:4">ኤንታ ግብራ ታና ሙዞፓ።<verse eid="PSA 141:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>ፅሎ አስ ታና ሴሮ፥ ሄስ ታዉ ኬሀተ፥</para>
  <para style="q2" vid="PSA 141:5">እ ታና ሀንቀቶ፥ ሄስ ታ ሁጰን ዛይተ ትዮ መላ።</para>
  <para style="q1" vid="PSA 141:5">ታ ዎዛናይ ሄሳ እፀና፤</para>
  <para style="q2" vid="PSA 141:5">ታ ዎሳይ ኡባ ዎደ ኤንታ ኢታ ኦሱዋ ቦላና።<verse eid="PSA 141:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>ኤንታ ዳይናት አፎ ሆለትያ ዎደ፥</para>
  <para style="q2" vid="PSA 141:6">ታ ቃላይ ቱማ ግደይሳ ኤንቲ ኤራና።<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>ኤንቲ፥ “አስ ቢታ ጎየይሳዳነ ጳሻ ላለይሳዳ፥</para>
  <para style="q2" vid="PSA 141:7">ኑ መቀይ ዱፎ ዶናን ላለታና” ያጎሶና።<verse eid="PSA 141:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>ኡባ ሃርያ ጎዳዉ፥</para>
  <para style="q2" vid="PSA 141:8">ታ አይፈይ ነና ፄሌስ።</para>
  <para style="q1" vid="PSA 141:8">ታኒ ኔኮ ባቃታይስ፤</para>
  <para style="q2" vid="PSA 141:8">ታና ሀይቆስ አዳ እሞፋ።<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>ኤንቲ ታዉ የግዳ ግትያፐነ</para>
  <para style="q2" vid="PSA 141:9">ኢታ ኦይሳታ ፅህያፐ ታና ናጋ።<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>ታኒ ሳሮ አን፥</para>
  <para style="q2" vid="PSA 141:10">ኢታት ባንታ ዎዳ ግትያን ኦይከቶ።<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="s1">ኔኒ ታዉ ቆሰትያ በሲ</para>
  <para style="d">ዳዊቲ ጎንጎሎን ደእያ ዎደ ፃፍዳ ትምርተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 142:1"/>ታ ቃላ ቁ ኦዳ ጎዳኮ ዋሳይስ፤</para>
  <para style="q2" vid="PSA 142:1">ማሮታ ደማናዉ እያ ዎሳይስ።<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>ታ ኦይሻ ኡባ እያ በሳይስ፤</para>
  <para style="q2" vid="PSA 142:2">ታ መቱዋ ኡባ እያዉ ኦዳይስ።<verse eid="PSA 142:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>ታኒ ሄትዳ ዎደ ነ ታ ኦግያ ኤራሳ፤</para>
  <para style="q2" vid="PSA 142:3">ታ ኦግያን ግተ የግድ ዎዶሶና።<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>ታኒ ታ ዩሹዋ ፄልያ ዎደ፥</para>
  <para style="q2" vid="PSA 142:4">ታና ማደይ እሶይካ ባዋ።</para>
  <para style="q2" vid="PSA 142:4">ታኒ ቆሰታዳ አትያ በሲ ባዋ፤</para>
  <para style="q2" vid="PSA 142:4">ታና ናግያ ኦንካ ባዋ።<verse eid="PSA 142:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>ጎዳዉ፥ ታኒ ኔኮ ዋሳይስ፤</para>
  <para style="q2" vid="PSA 142:5">ታኒ፥ “ነ ታዉ ባቃታዳ አትያ በሲ፤</para>
  <para style="q2" vid="PSA 142:5">ደኦን ደኤይሳታ ቢታን ታ ሳማይ ነና” ያጋስ።<verse eid="PSA 142:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>ታኒ ዳሮ መቶትያ ግሾ፥</para>
  <para style="q2" vid="PSA 142:6">ታ ዋሱዋ ስአ።</para>
  <para style="q1" vid="PSA 142:6">ታና የደይሳት ዎልቃምዳ ግሾ፥</para>
  <para style="q2" vid="PSA 142:6">ታና ኤንታፈ አሻ።<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>ታ ነ ሱን ጋላታና መላ፥</para>
  <para style="q2" vid="PSA 142:7">ታና ቃሾፐ ብርሻ።</para>
  <para style="q1" vid="PSA 142:7">ኔኒ ታዉ ኬሀ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 142:7">ፅሎት ታ ዩሾን ሺቃና።<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="s1">ታ ሸምፕያ ነና ኮያዉሱ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 143:1"/>ጎዳዉ፥ ታ ዎሳ ስአ፤</para>
  <para style="q2" vid="PSA 143:1">ማሮታ ደማናዉ ታ ዋሰይሳ ሀይዛ።</para>
  <para style="q1" vid="PSA 143:1">ኔኒ ፅሎተንነ ነ አማነተን</para>
  <para style="q2" vid="PSA 143:1">ታዉ ዛሮ እማ።<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>ነ ስንን ፅሎ አስ ባይና ግሾ</para>
  <para style="q2" vid="PSA 143:2">ታና ነ አይልያ ፕርዳስ ሺሾፓ።<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>ታና ታ ሞርከይ የደድ፥</para>
  <para style="q2" vid="PSA 143:3">ትንቸረድ ሳአን የግስ።</para>
  <para style="q1" vid="PSA 143:3">በን ሀይቅዳ አሳዳ</para>
  <para style="q2" vid="PSA 143:3">ታና ማን ዎስ።<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>ሄሳ ግሾ ታኒ ሄታስ፤</para>
  <para style="q2" vid="PSA 143:4">ታ ዎዛናይካ ትልእስ።<verse eid="PSA 143:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>ታኒ በን ዎደታ ሀሳያይስ፤</para>
  <para style="q2" vid="PSA 143:5">ነ ኦዳ ኦሶ ኡባ ቆፓይስ፤</para>
  <para style="q2" vid="PSA 143:5">ነ ኩሸ ኦሶ ኡባ አኬካይስ።<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>ታኒ ታ ኩሽያ ኔኮ ምጫስ፤</para>
  <para style="q2" vid="PSA 143:6">መላ ቢት ሃ ኮየይሳዳ፥</para>
  <para style="q2" vid="PSA 143:6">ታ ሸምፖይ ነና ሳሞቴስ። <char style="qs">ሳላሀ </char><verse eid="PSA 143:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>ጎዳዉ፥ ታ ዎዛናይ ሄትዳ ግሾ</para>
  <para style="q2" vid="PSA 143:7">ታዉ ዛሮ እማናዉ ኤለሳ።</para>
  <para style="q1" vid="PSA 143:7">ታኒ ዱፎን ገልያ አሳዳ ሀኖና መላ</para>
  <para style="q2" vid="PSA 143:7">ነ ሶምኡዋ ታፐ ገንፋ።<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>ታኒ ነናን አማነትያ ግሾ፥</para>
  <para style="q2" vid="PSA 143:8">ዎንታ ዎንታ ነ ሲቁዋባ ታና በሳ።</para>
  <para style="q1" vid="PSA 143:8">ታኒ ታ ሸምፑዋፈ ነና ዎስያ ግሾ፥</para>
  <para style="q2" vid="PSA 143:8">ታ ባና ኦግያ ታና በሳ።<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>ጎዳዉ፥ ታኒ ነዉ ማጋንዳ ግሾ፥</para>
  <para style="q2" vid="PSA 143:9">ታ ሞርከታፐ ታና አሻ።<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>ኔኒ ታ ፆሳ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 143:10">ታ ነ ሸንያ ኦና መላ ታና ታማርሳ፤</para>
  <para style="q2" vid="PSA 143:10">ነ ሎኦ አያናይ ሱረ ኦግያን ታና ካለ።<verse eid="PSA 143:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>ጎዳዉ፥ ነ ሱን ግሾ ታና አሻ፤</para>
  <para style="q2" vid="PSA 143:11">ነ ፅሎተን ታና መቶፐ ከሳ።<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>ነ ሲቁዋን ታ ሞርከታ ዎ፤</para>
  <para style="q2" vid="PSA 143:12">ታ ነ አይለ ግድያ ግሾ</para>
  <para style="q2" vid="PSA 143:12">ታና ኡንኤይሳታ ኡባ ይሳ።<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="s1">ፆሳይ ታዉ ሚፃ</para>
  <para style="d">ዳዊታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 144:1"/>ጎዳይ፥ ታ ዛላይ፥ ጋላተቶ!</para>
  <para style="q2" vid="PSA 144:1">ታ ኩሽያ ኦላ ታማርሴስ፤</para>
  <para style="q2" vid="PSA 144:1">ታ ብራታ ቶራስ ጊግሴስ።<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>እ ታ ሲቆ ፆሳነ ታ ቆሰታ አትያ በሰ፤</para>
  <para style="q2" vid="PSA 144:2">ታ ሚፃነ ታና አሸይሳ።</para>
  <para style="q1" vid="PSA 144:2">ታ ጎንዳለነ ታኒ ባቃታዳ አትያ በሰ፤</para>
  <para style="q2" vid="PSA 144:2">እ ካዎተት ታዉ ሃረታና መላ ኦስ።<verse eid="PSA 144:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>ጎዳዉ፥ ኔኒ እያዉ ቆፓናዉ አስ አይቤ?</para>
  <para style="q2" vid="PSA 144:3">ነ ዎዛናን እያዉ በሰ እማናዉ አሳ ናእ አይቤ?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>አስ እስ ቶሆ ጫርክያ ጫርኮ መላ፤</para>
  <para style="q2" vid="PSA 144:4">እያ ጋላሳት አያ ኩያ መላ።<verse eid="PSA 144:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>ጎዳዉ፥ ሳሉዋ ጳልቃዳ ዱገ ዎ!</para>
  <para style="q2" vid="PSA 144:5">ደረታ ቦቻ፤ ኤንቲ ጩዮ!<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>ዎልአን የዳዳ ነ ሞርከታ ላላ፤</para>
  <para style="q2" vid="PSA 144:6">ነ ዶንግያ ዪሻን ዱካዳ ኤንታ የደ።<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>ቦላራ ነ ኩሽያ የዳዳ፥</para>
  <para style="q2" vid="PSA 144:7">ታና ዎልቃማ ሃፈ ጎቻዳ ከሳ፤</para>
  <para style="q2" vid="PSA 144:7">አላጋ አሳታ ኩሸፐ ታና ዎስሳ።<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>ኤንቲ ቱማ ሃሳይድ ኤሮኮና፤</para>
  <para style="q2" vid="PSA 144:8">ባንታ ኡሻቻ ኩሽያ ደንድ</para>
  <para style="q2" vid="PSA 144:8">ዎርዶን ጫቆሶና።<verse eid="PSA 144:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>ፆሳዉ ታኒ ነዉ ኦራ ማዝሙረ የፃና፤</para>
  <para style="q2" vid="PSA 144:9">ታሙ ሻያን ዋፀትዳ ዲን የፃና።<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>ካዎታስ ፆኖ እማሳ፤</para>
  <para style="q2" vid="PSA 144:10">ነ አይልያ ዳዊታ አሻሳ።<verse eid="PSA 144:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>ታና ኢታ ማሻፈ አሻ፤</para>
  <para style="q2" vid="PSA 144:11">አላጋ አሳታ ኩሸፐ ታና ዎስሳ።</para>
  <para style="q1" vid="PSA 144:11">ኤንታ ዶናይ ዎርዶን፥</para>
  <para style="q2" vid="PSA 144:11">ኤንታ ኡሻቻ ኩሸይ ጭሞን ኩምስ።<verse eid="PSA 144:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>ኑ አደ ናይት ባንታ ናአተን፥</para>
  <para style="q2" vid="PSA 144:12">ሎኦ ድጭያ ም መላ ግዶ።</para>
  <para style="q1" vid="PSA 144:12">ኑ ማጫ ናይት ካዎ ጋ አሌቅሳናዉ፥</para>
  <para style="q2" vid="PSA 144:12">ኦሰትዳ ቱቀ መላ ግዶ።<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>ኑ ሻለት ዱማ ዱማ ካ ቆሞን ኩሞ፤</para>
  <para style="q2" vid="PSA 144:13">ሄመትያ በሳን ደእያ ኑ ዶርሳት</para>
  <para style="q2" vid="PSA 144:13">ሙኩላንነ ታሙ ሙኩላን የሎ።<verse eid="PSA 144:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14"/>ኑ ሚዛት ብራይሶ፤</para>
  <para style="q2" vid="PSA 144:14">አዉጫዮና የለትድ ዳሮ፤</para>
  <para style="q2" vid="PSA 144:14">ኑ ኦገታን ዋሶይ ስኤቶፎ።<verse eid="PSA 144:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>ሀ አንጆት ጋክያ አሳት ቱማ አንጀትዳይሳታ፤</para>
  <para style="q2" vid="PSA 144:15">ፆሳይ ኤንታዉ ጎዳ ግድዳ አሳት አንጀትዳይሳታ።<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="s1">ፆሳይ ግታ</para>
  <para style="d">ዳዊታ ጋላታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 145:1"/>ታ ፆሳዉ፥ ታ ካዋዉ፥ ታ ነና ግታያና፤</para>
  <para style="q2" vid="PSA 145:1">ነ ሱን መርናዉ ጋላታና።<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>ታኒ ነና ኡባ ጋላስ ሳባና፤</para>
  <para style="q2" vid="PSA 145:2">ነ ሱን መርናዉ ጋላታና።<verse eid="PSA 145:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>ጎዳይ ግታ፤ አ ጋላት እያዉ በሴስ፤</para>
  <para style="q2" vid="PSA 145:3">እያ ግታተይ አሳ ቆፋፐ አስ።<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>እስ የለታይ ሀራ የለታስ ነ ኦሱዋ ኦዳና፤</para>
  <para style="q2" vid="PSA 145:4">ነ ማላልስያ ኦሶታ አዋጃና።<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>ኤንቲ ነ ቦንቹዋ፥ ነ ቴማነ</para>
  <para style="q2" vid="PSA 145:5">ነ ግታተ ኦዳና።</para>
  <para style="q2" vid="PSA 145:5">ታኒ ነ ማላልስያ ኦሱዋ</para>
  <para style="q2" vid="PSA 145:5">ዛራ ዛራዳ ቆፓና።<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>ማላልስያ ግታ ነ ኦሱዋባ ኦዳና፤</para>
  <para style="q2" vid="PSA 145:6">ታኒ ነ ግታተ አዋጃና።<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>ኤንቲ ነ ኬሀተ ዳሮተ ኦዳና፤</para>
  <para style="q2" vid="PSA 145:7">ነ ፅሎተባ ኡፋይሳን የፃና።<verse eid="PSA 145:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>ጎዳይ ኬሀነ ቃተይሳ፤</para>
  <para style="q2" vid="PSA 145:8">ሀንቀታናዉ ኤለሰና፤ ሲቆን ኩምዳይሳ።<verse eid="PSA 145:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>ጎዳይ ኡባስ ኬሀ፤</para>
  <para style="q2" vid="PSA 145:9">እ ባ መተ ኡባስ ቃቴስ።<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>ጎዳዉ፥ መተ ኡባይ ነና ጋላታና፤</para>
  <para style="q2" vid="PSA 145:10">ነ አሳ ኡባይ ነና ሳባና።<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>ኤንቲ ነ ካዎተ ቦንቹዋባ ኦዳና፤</para>
  <para style="q2" vid="PSA 145:11">ነ ዎልቃባ ኦዳና።<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>ሄሳን ኤንቲ ነ ዎልቃማ ኦሱዋባነ</para>
  <para style="q2" vid="PSA 145:12">ነ ካዎተ ቦንቾ ቴማባ ኤርሳና።<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>ነ ካዎተይ መርና ካዎተ፤</para>
  <para style="q2" vid="PSA 145:13">ነ ማታይ የለታ ኡባ ሃሬስ።</para>
  <para style="q2" vid="PSA 145:13">ጎዳይ ባ ግዳ ቃላ ኡባን አማነቴስ፤</para>
  <para style="q2" vid="PSA 145:13">ባ ኦሶ ኡባን ኬሀ።<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>ጎዳይ ኩንዳናዉ ገድጋደይሳታ ካትሴስ፤</para>
  <para style="q2" vid="PSA 145:14">ኩንድዳይሳታ ደንስ።<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>ኡባ አይፈይ ነና ፄሌስ፤</para>
  <para style="q2" vid="PSA 145:15">ኤንታዉ ኮሽያ ዎደን ካ እማሳ።<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>ኔኒ ነ ኩሽያ ምጫዳ፥</para>
  <para style="q2" vid="PSA 145:16">መተ ኡባ አሞ አላሳ።<verse eid="PSA 145:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>ፆሳይ ባ ኦገ ኡባን ፅሎ፤</para>
  <para style="q2" vid="PSA 145:17">ባ ኦሶ ኡባን ኬሀ።<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>ጎዳይ ባና ፄግያ ኡባስ፥</para>
  <para style="q2" vid="PSA 145:18">ቱማን ባና ፄግያ ኡባስ ማታን ደኤስ።<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>እ ባዉ ያየይሳታ አሙዋ ኩንስ፤</para>
  <para style="q2" vid="PSA 145:19">ኤንታ ዋሱዋ ስእድ አሼስ።<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>ጎዳይ ባና ዶሰይሳታ ኡባ ናጌስ፤</para>
  <para style="q2" vid="PSA 145:20">ሽን ኢታታ ኡባ ይሳና።<verse eid="PSA 145:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>ታኒ ታ ዶናን ጎዳ ጋላታና፤</para>
  <para style="q2" vid="PSA 145:21">መተ ኡባይ እያ ጌሻ ሱን</para>
  <para style="q2" vid="PSA 145:21">መርናዉ ጋላቶ!<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="s1">ካዎታን አማነቶፍተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>ጎዳ ጋላትተ!</para>
  <para style="q2" vid="PSA 146:1">ታ ሸምፐ ጎዳ ጋላታ!<verse eid="PSA 146:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>ታ ደኦ ላይ ኡባን ጎዳ ጋላታና፤</para>
  <para style="q2" vid="PSA 146:2">ታ ደእዳ ዎደ ኡባን ታ ፆሳ ሳባና።<verse eid="PSA 146:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>ሀላቃታን አማነቶፍተ፤</para>
  <para style="q2" vid="PSA 146:3">አሻናዉ ዳንዳኦና አሳ ናአን ጬቀቶፍተ።<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>ኤንታ ሸምፖይ ከይያ ዎደ ቢታኮ ስሞሶና፤</para>
  <para style="q2" vid="PSA 146:4">ኤንታ ሀልቾይ ኡባይ ሄ ጋላስ አስ።<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>ያይቆባ ፆሳይ ማድያ አስነ</para>
  <para style="q2" vid="PSA 146:5">ጎዳ፥ ባ ፆሳን ኡፋይስ ኦያ አስ አንጀትዳይሳ።<verse eid="PSA 146:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>ጎዳይ ሳሎነ ሳኣ፥</para>
  <para style="q2" vid="PSA 146:6">አባነ እያ ግዶን ደእያ ኡባ መስ፤</para>
  <para style="q2" vid="PSA 146:6">ፆሳይ መርናዉ አማነቴስ።<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>ጎዳይ ኡንኤትዳይሳታስ ፕርዴስ፤</para>
  <para style="q2" vid="PSA 146:7">ኮሻትዳይሳታስ ካ እሜስ፤</para>
  <para style="q2" vid="PSA 146:7">ጎዳይ ቃሸትዳይሳታ ብርሼስ፤<verse eid="PSA 146:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8"/>ጎዳይ ቆቀታ ፄልሴስ።</para>
  <para style="q2" vid="PSA 146:8">ጎዳይ ኩንድዳይሳታ ደንስ፤</para>
  <para style="q2" vid="PSA 146:8">ጎዳይ ፅሎታ ዶሴስ።<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>ጎዳይ በተ አሳታ ናጌስ፤</para>
  <para style="q2" vid="PSA 146:9">አምኤታነ ይኦ ናይታ ማዴስ፤</para>
  <para style="q2" vid="PSA 146:9">ሽን ኢታታ ኦግያ ይሴስ።<verse eid="PSA 146:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>ጎዳይ መርናዉ ካዎታና፤</para>
  <para style="q2" vid="PSA 146:10">ፅዮነ፥ ነ ፆሳይ፥</para>
  <para style="q2" vid="PSA 146:10">የለተፈ የለተ ጋካናዉ ካዎታና።</para>
  <para style="q2" vid="PSA 146:10">ጎዳ ጋላትተ!<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="s1">ፆሳይ መቅዳ ዎዛና ኮሌስ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 147:1"/>ጎዳ ጋላትተ!</para>
  <para style="q2" vid="PSA 147:1">ኑ ፆሳ ሳቦይ ሎኦ፤</para>
  <para style="q2" vid="PSA 147:1">እያ ሳቦይ ኡፋይስያባነ በሲያባ።<verse eid="PSA 147:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>ጎዳይ የሩሳላመ ኦራና፤</para>
  <para style="q2" vid="PSA 147:2">እስራኤለፐ ድኤትዳይሳታ ሺሻና።<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>ዎዛን መቅዳይሳታ ኮሌስ፤</para>
  <para style="q2" vid="PSA 147:3">ኤንታ ማዱን ፓስ።<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>እ ፆልንቶታ ታይቡዋ ኤሬስ፤</para>
  <para style="q2" vid="PSA 147:4">ኤንታ ኡባ ኤንታ ሱንን ሱንን ፄጌስ።<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>ኑ ጎዳይ ግታ፤ እ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 147:5">እያ አኬካስ ዛው ባዋ።<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>ጎዳይ አዳታ ዘምፕሴስ፤</para>
  <para style="q2" vid="PSA 147:6">ሽን ኢታታ ሳአን የጌስ።<verse eid="PSA 147:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>ጎዳስ ጋላታ የ የፅተ፤</para>
  <para style="q2" vid="PSA 147:7">ኑ ፆሳስ ዲን የፅተ።<verse eid="PSA 147:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>እ ሳሉዋ ሻራ ማይዜስ፤</para>
  <para style="q2" vid="PSA 147:8">ቢታስ እራ እሜስ፤</para>
  <para style="q2" vid="PSA 147:8">ዙማታ ቦላ ማታ ዶልሴስ።<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>መሄታስ ካ፥</para>
  <para style="q2" vid="PSA 147:9">ኮሻትድ ዋስያ ቁሮ ናይታስ</para>
  <para style="q2" vid="PSA 147:9">ምያባ እሜስ።<verse eid="PSA 147:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>እ ፓራታ ዎልቃንነ</para>
  <para style="q2" vid="PSA 147:10">ቶራንቾታ ምኖተን ኡፋይተና።<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>ሽን ጎዳይ ባዉ ያየይሳታንነ</para>
  <para style="q2" vid="PSA 147:11">እያ ማሮታን አማነተይሳታን ኡፋይቴስ።<verse eid="PSA 147:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>የሩሳላመ፥ ጎዳ ጋላታ!</para>
  <para style="q2" vid="PSA 147:12">ፅዮነ፥ ነ ፆሳ ጋላታ!<verse eid="PSA 147:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>እ ነ ፐንግያ ኮበታ ምንና፤</para>
  <para style="q2" vid="PSA 147:13">ነ ግዶን ደእያ ነ አሳ አንጃና።<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>እ ነ ዛዋ ሳሮተን ናጋና፤</para>
  <para style="q2" vid="PSA 147:14">ነና ሎኦ ግስተን ካልሳና።<verse eid="PSA 147:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>እ ባ ኪታ ቢታስ የዴስ፤</para>
  <para style="q2" vid="PSA 147:15">እያ ቃላይ ኤሶን ጋኬስ።<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>እ ሻች ቡሉኮዳ ምጬስ፤</para>
  <para style="q2" vid="PSA 147:16">ጫጋና ብዶዳ ላሌስ።<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>እ ሻቻ ሹቻዳ ሆሌስ፤</para>
  <para style="q2" vid="PSA 147:17">እያ ሜጉዋን ኦንካ ኤቃናዉ ዳንዳኤና።<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>እ ባ ቃላ ኪትድ ሻቻ ማይሴስ።</para>
  <para style="q2" vid="PSA 147:18">እ ጫርኩዋ ኪትን ሃ ጎጌስ።<verse eid="PSA 147:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>እ ባ ቃላ ያይቆባስ፥</para>
  <para style="q2" vid="PSA 147:19">ባ ህግያነ ዎጋ</para>
  <para style="q2" vid="PSA 147:19">እስራኤለስ አዋጄስ።<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>እ ሀራ ካዎተታስ ሄሳ ኦቤና፤</para>
  <para style="q2" vid="PSA 147:20">ኤንቲ እያ ህግያ ኤሮኮና።</para>
  <para style="q2" vid="PSA 147:20">ጎዳ ጋላትተ!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="s1">ፆሳ ሱን ጋላትተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>ጎዳ ጋላትተ!</para>
  <para style="q2" vid="PSA 148:1">ሳሎፐ ጎዳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 148:1">ቦላ ቃን እያ ጋላትተ።<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>እያ ኪታንቾት ኡባይ እያ ጋላትተ፤</para>
  <para style="q2" vid="PSA 148:2">ሳሎን ደእያ እያ ኦላንቾት ኡባይ እያ ጋላትተ።<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>አዋይ፥ አጌናይ እያ ጋላትተ፤</para>
  <para style="q2" vid="PSA 148:3">ፖእያ ፆልንቶት ኡባይ እያ ጋላትተ።<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>ቃ ሳሎት እያ ጋላትተ፤</para>
  <para style="q2" vid="PSA 148:4">ሳሎፐ ቦላራ ደእያ ሃት እያ ጋላትተ።<verse eid="PSA 148:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>ኤንቲ ኡባይ ጎዳ ሱን ጋላቶ፤</para>
  <para style="q2" vid="PSA 148:5">እ ኪትን ኤንቲ መትዶሶና።<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>እ ኤንታ መርናዉ ኤንታ በሳን በሳን ዎስ፤</para>
  <para style="q2" vid="PSA 148:6">ሻረቶና ህገ ኤንታዉ እሚስ።<verse eid="PSA 148:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>ሳአፐ ጎዳ ጋላትተ!</para>
  <para style="q2" vid="PSA 148:7">አባን ደእያ ግታ መተቶ፤</para>
  <para style="q2" vid="PSA 148:7">አባ ጪሞቶ ኡባይ እያ ጋላትተ።<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>ዎልአንዉ፥ ሻቻዉ፥ ሻራዉ፥</para>
  <para style="q2" vid="PSA 148:8">ጫጋናዉ፥ እያ ኪታ ፖልያ ጫርኩዋዉ፥</para>
  <para style="q2" vid="PSA 148:8">ኡባይ እያ ጋላትተ።<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>ደረቶ፥ ዙማቶ፥</para>
  <para style="q2" vid="PSA 148:9">ሜተትያ አይፈ አይፍያ ምቶ፥ ዝጋቶ፥</para>
  <para style="q2" vid="PSA 148:9">ኡባይ እያ ጋላትተ።<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>መሄቶ፥ ዶአቶ፥</para>
  <para style="q2" vid="PSA 148:10">ሳአራ ጎሸትያ መተቶ፥</para>
  <para style="q2" vid="PSA 148:10">ፓልያ ካፎቶ ኡባይ እያ ጋላትተ።<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>ካዎቶ፥ ካዎተቶ፥</para>
  <para style="q2" vid="PSA 148:11">ሀላቃቶ፥ ደርያ ሃረይሳቶ፥</para>
  <para style="q2" vid="PSA 148:11">ኡባይ እያ ጋላትተ።<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>ፓንቶ፥ ጌላኦቶ፥ ጭማቶ፥ ናይቶ፥</para>
  <para style="q2" vid="PSA 148:12">ኡባይ እያ ጋላትተ።<verse eid="PSA 148:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>እያ ሱንይ ኡባፈ ቃ ግድያ ግሾነ</para>
  <para style="q2" vid="PSA 148:13">እያ ቦንቾይ ሳሎታፐነ ሳአፐ ቃ ግድያ ግሾ፥</para>
  <para style="q2" vid="PSA 148:13">ኤንቲ ኡባይ ጎዳ ሱን ጋላቶ።<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>እያዉ ማታ ግድዳ እስራኤለ፥</para>
  <para style="q2" vid="PSA 148:14">እ ቁ ቁ ኦስ፤</para>
  <para style="q2" vid="PSA 148:14">እያ ጋላታና መላ ኤንታ ምንስ።</para>
  <para style="q2" vid="PSA 148:14">ጎዳ ጋላትተ!<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="s1">ፆሳስ ኦራ ማዝሙረ የፅተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 149:1"/>ጎዳ ጋላትተ!</para>
  <para style="q2" vid="PSA 149:1">ጎዳስ ኦራ የ የፅተ!</para>
  <para style="q2" vid="PSA 149:1">ፅሎታ ሺቁዋን እያ ሳቢተ!<verse eid="PSA 149:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>እስራኤለይ ባንታና መዳይሳን ኡፋይቶ፤</para>
  <para style="q2" vid="PSA 149:2">ፅዮነይ ባንታ ካዋን ሀሹ ጎ።<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>ዱርሸ፥ ካራቦ ባቅሸ፥</para>
  <para style="q2" vid="PSA 149:3">ዲ ዲፅሸ እያ ሱን ሳቦ።<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>ጎዳይ ባ አሳን ኡፋይቴስ፤</para>
  <para style="q2" vid="PSA 149:4">አዳታስ ፆኖ እምድ ኤንታ ቦንቼስ።<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>ነ አሳይ ባንታ ፆኑዋን ኡፋይቶ፤</para>
  <para style="q2" vid="PSA 149:5">ቃማ ኩመ ኡፋይሳን የፆ።<verse eid="PSA 149:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>ኤንታ ዶናን ፆሳ ጋላታይ፥</para>
  <para style="q2" vid="PSA 149:6">ኤንታ ኩሽያን ናምኡ ባጋ ቃራ ማሽ ደኦ።<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>ሄሳን ኤንቲ ካዎተታ ቦላ ሀሎ ከያና፤</para>
  <para style="q2" vid="PSA 149:7">አሳ ሴራና።<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>ኤንታ ካዎታ ሳንላታን፥</para>
  <para style="q2" vid="PSA 149:8">ኤንታ ሞርናታ ብራታን ቃቻና።<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>ኤንታ ቦላ ፃፈትዳ ፕርዳ ፖላና፤</para>
  <para style="q2" vid="PSA 149:9">ሄስ ፆሳ አሳታ ኡባስ ፆኖ።</para>
  <para style="q2" vid="PSA 149:9">ጎዳ ጋላትተ!<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="s1">መተ ኡባይ ፆሳ ጋላቶ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>ጎዳ ጋላትተ!</para>
  <para style="q2" vid="PSA 150:1">እያ ጌሻ ኬን ፆሳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 150:1">ቃ ሳሎን እያ ጋላትተ።<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>እያ ዎልቃማ ኦሶታ ግሾ እያ ጋላትተ፤</para>
  <para style="q2" vid="PSA 150:2">ኡባፈ አያ እያ ግታተስ እያ ጋላትተ።<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>ሞይዘ ፑንሸ እያ ጋላትተ፤</para>
  <para style="q2" vid="PSA 150:3">ዲንነ ማስንቆን እያ ጋላትተ።<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>ካራቦ ባቅሸነ ዱርሸ እያ ጋላትተ፤</para>
  <para style="q2" vid="PSA 150:4">ዲ ዲፅሸ፥ ሱሱልኤ ፑንሸ እያ ጋላትተ።<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>ዳላ ቃሸ እያ ጋላትተ፤</para>
  <para style="q2" vid="PSA 150:5">ዎልቃማ ዳላ ግርሳን እያ ጋላትተ።<verse eid="PSA 150:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>ሸምፖራ ደእያ ኡባይ</para>
  <para style="q2" vid="PSA 150:6">ጎዳ ጋላትተ!</para>
  <para style="q2" vid="PSA 150:6">ጎዳይ ጋላተቶ!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
