<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ፍልጵስዩሳ ኪታ</para>
  <para style="toc1">ፍልጵስዩሳ ኪታ</para>
  <para style="toc3">ፍልጵ</para>
  <para style="toc2">ፍልጵስዩሳ</para>
  <para style="mt1">ጳዉሎስ ፍልጵስዩሳ አሳስ</para>
  <para style="mt2">ፃፍዳ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ጳዉሎስ ፍልጵስዩሳ አሳስ ፃፍዳ ኪታይ ፃፈትዳይ፥ ሮመ ካዎተን፥ ማቀዶነ ቢታን፥ ፍልጵስዩሳ ካታማን ደእያ ዎሳ ኬሳ። ሀ ኪታይ ፃፈትዳይ፥ ጳዉሎስ ቃሾ ኬን ደእያ ዎደ ሀራ አማንያ ኦሳንቾት እያ እፅዳ ዎደነ ፍልጵስዩሳ ዎሳ ኬን ደንድዳ ዎርዶ ትምርትያ ጋሶን እያ ዎዛናይ ዳሮ አዛንዳ ዎደ (<char style="xt"><ref loc="PHP 1:21">1:21</ref>፤ <ref loc="PHP 2:17">2:17</ref>፤ <ref loc="PHP 3:10">3:10</ref></char>)። ግዶሽን፥ ጳዉሎስ የሱስ ክርስቶሳ ምንድ አማንያ ግሾ ሀ ኪታን ቆንጭድ በንተይ፥ ኡፋይስነ ኩመ አማነተ። ፍልጵስዩሳን ደእያ ዳሮ አሳይ ሮመፐ ድኤትድ ይዳ አስ። ኤንቲ ሮመ ቢታስ ምሸቶሶናነ ቢታ ሎይድ ናጎሶና። ኤንታፈ እሶት እሶት የሱሳ አማንዳ ግሾ፥ ባንታ ቢታ አሳን ጎደትዶሶና። ሄ ጎዳይ ኤንታ ቦላ መቶነ ማንቆተ ኤህስ (<char style="xt"><ref loc="ACT 16:20-21">ሀዋ 16:20-21</ref></char>)።</para>
  <para style="ip">ጳዉሎስ ሀ ኪታ ፃፍዳ ጋሶይ እያ መቱዋ ዎደ እያ ማዳናዉ አማንያ አሳይ እሞታ እያዉ የድዳ ግሾነ እያዉ ዎስዳ ግሾ፥ ኤንታ ጋላታናሳ። እያ ቦላነ ኤንታ ቦላ ዱማ ዱማ መቶይ ጋክዳባ ግድኮካ ኤንቲ ምነታና መላነ ኩመ አማነትድ ዳና መላ ኤንታ ምንስ። ጬቆነ ኦቶሮ አግድ፥ የሱስ ክርስቶሳ አሽከተን ኩማና መላ ምንድ ኤንታ አኬክሴስ።</para>
  <para style="ip">ኤንቲ የሱስ ክርስቶሳን ግድድ ደምዳ ደኦይ ፆሳ አ ኬሀተፈ ፑልትዳባነ አማኖን ኤክዳባፐ አትሽን አይሁደታ ዎጋ ናግድ ኤክዳባ ግዶናይሳ ኤንታ አኬክሴስ። የሱስ ክርስቶሳን ደእያ ኡባስ ፆሳይ እምያ ሳሩዋነ ኡፋይሳ ኤንታዉ ፃፌስ።</para>
  <para style="ip">ሀ ኪታይ ኡፋይስ፥ አማነተ፥ እስፈተነ አማኖን ምንድ ዱሱ ቆንጭስድ በሴስ። ዉርሰን ጳዉሎስ ፆሳ አማንያ አሳይ ሲቆን ዳና መላነ ክርስቶሳ ቆፋ ዳና መላ ኤንታ ዞሬስ (<char style="xt"><ref loc="PHP 2:2">2:2</ref>፤ <ref loc="PHP 4:2-3">4:2-3</ref></char>)።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ገሎ ቆፋ (<char style="ior"><ref loc="PHP 1:1-11">1:1-11</ref></char>)</para>
  <para style="io1">ጳዉሎስ ሀንድ ደእያ ደኡዋ (<char style="ior"><ref loc="PHP 1:12-30">1:12-30</ref></char>)</para>
  <para style="io1">አሽከተ ዱሳ ሌምሶ (<char style="ior"><ref loc="PHP 2:1-18">2:1-18</ref></char>)</para>
  <para style="io1">ፅሞትዮሳስነ ኤጳፍራድቱሳ (<char style="ior"><ref loc="PHP 2:19-30">2:19-30</ref></char>)</para>
  <para style="io1">ሞርከታፐነ ኢታታፐ ናገተ (<char style="ior"><ref loc="PHP 3:1-4:9">3:1—4:9</ref></char>)</para>
  <para style="io1">ጳዉሎስ ፍልጵስዩሳ አሳ ጋላቴስ (<char style="ior"><ref loc="PHP 4:10-20">4:10-20</ref></char>)</para>
  <para style="io1">ሳሮነ አንጆ (<char style="ior"><ref loc="PHP 4:21-23">4:21-23</ref></char>)</para>
  <chapter number="1" style="c" sid="PHP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1"/>ክርስቶስ የሱሳራ እስፍዳ ግሾ፥ ፆሳባ ግድዳ፥ ፍልጵስዩሳ ካታማን ደእያ ዎሳ ኬ ጭማታስነ ዳቆነታ ኡባስ። የሱስ ክርስቶሳ አይለ ግድዳ፥ ጳዉሎሳፐነ ፅሞትዮሳፐ ኪተትዳ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 16:12">ሀዋ 16:12</ref>.</char></note><verse eid="PHP 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2"/>ኑ አዋ ፆሳፈነ ጎዳ የሱስ ክርስቶሳፐ አ ኬሀተይነ ሳሮተይ ህንተዉ ግዶ።<verse eid="PHP 1:2"/></para>
  <para style="s1">ጳዉሎሳ ጋላታ ዎሳ</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3"/>ታኒ ህንተና ቆፕያ ዎደ ኡባን፥ ታ ፆሳ ጋላታይስ። <verse eid="PHP 1:3"/><verse number="4" style="v" sid="PHP 1:4"/>ታኒ ህንተ ኡባስ ፆሳ ዎስያ ዎደ ኡፋይሳን ዎሳይስ። <verse eid="PHP 1:4"/><verse number="5" style="v" sid="PHP 1:5"/>ህንተ ኮይሮ ጋላሳፐ ሀእ ጋካናዉ፥ ዎንገላ ማርካተይሳን ታራ እስፈ ግድድ፥ ታና ማድዳ ግሾ፥ ፆሳ ጋላታይስ። <verse eid="PHP 1:5"/><verse number="6" style="v" sid="PHP 1:6"/>ህንተ ግዶን ሎኦ ኦሶ ዶምዳ ፆሳይ፥ ክርስቶስ የሱሲ ስምያ ጋላሳይ ጋካናዉ፥ ፖላናይሳ ኤራይስ።<verse eid="PHP 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 1:7"/>ህንተ ኡባ ዎደ ታ ዎዛናን ደኤታ። ታኒ ኡባ ዎደካ ሄሳዳ ቆፓናዉ በሴስ። ሀእ ታኒ ቃሾን ደአሸነ ቃሸታናፐ ስን ዎንገላ ናጎንነ ዎንገላ ምን ኤሶን ፆሳይ ታዉ ቃድዳ ቃዳ ህንተካ ታራ ሻከትደታ። <verse eid="PHP 1:7"/><verse number="8" style="v" sid="PHP 1:8"/>ታኒ ህንተና ኡባ ክርስቶስ የሱሳ ሲቁዋን አይ መላ ላሞትያኮ ፆሳይ ታዉ ማርካ።<verse eid="PHP 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9"/>ህንተ ሲቆይ ቱማ ኤራተራነ አኬካራ እስፈ ጉጅ ጉጅ ድጫና መላ ፆሳ ዎሳይስ። <verse eid="PHP 1:9"/><verse number="10" style="v" sid="PHP 1:10"/>ሄሳን ህንተ ሎኦባ ሻክድ፥ ዶረይሳታ፥ ክርስቶስ ስምያ ጋላሳን ጌሻታነ ቦረቶናይሳታ ግዳና። <verse eid="PHP 1:10"/><verse number="11" style="v" sid="PHP 1:11"/>ህንተ ደኦይ ፆሳ ቦንቹዋስነ ጋላታስ የሱስ ክርስቶሳ ባጋራ በንትያ ፅሎተ አይፍያን ኩምድ አይፋና።<verse eid="PHP 1:11"/></para>
  <para style="s1">ጳዉሎሳ ቃሾይ ዎንገላ ዳልግስስ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12"/>ታ እሻቶ፥ ታና ጋክዳ ኡባይ ዎንገላይ ዳልጋና መላ ቱማ ማድዳይሳ ህንተ ኤራና መላ ኮያይስ። <verse eid="PHP 1:12"/><verse number="13" style="v" sid="PHP 1:13"/>ታኒ ክርስቶሳ ግሾ ቃሸትዳይሳ፥ ካዎ ጋ ናገይሳትነ ሀይሳን ደእያ ሀራት ኡባይ ኤሮሶና።<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 28:30">ሀዋ 28:30</ref>.</char></note> <verse eid="PHP 1:13"/><verse number="14" style="v" sid="PHP 1:14"/>ታ ቃሹዋ ጋሶን ኑ እሻታፐ ዳሮት ጎዳን ኬህ አማነትዶሶና። ሄሳ ግሾ፥ ፆሳ ቃላ ያሽ ባይና ካሰፐ ምንድ ኦዳና መላ ምኖተ ደምዶሶና።<verse eid="PHP 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15"/>ግዶሽን፥ እሶት እሶት ቃናተንነ ፓላማን ክርስቶሳባ ኦዶሶና፥ ሽን ሀራት ሱረ ዎዛናፐ ኦዶሶና። <verse eid="PHP 1:15"/><verse number="16" style="v" sid="PHP 1:16"/>ሱረ ዎዛናፐ ኦደይሳት፥ ፆሳይ ታዉ ዎንገላ ናጋና መላ ሀዳራ እምዳይሳ ኤርያ ግሾ፥ ሲቆን ኦዶሶና። <verse eid="PHP 1:16"/><verse number="17" style="v" sid="PHP 1:17"/>ሽን ታና ቃናተይሳት ታ ቃሹዋ ቦላ ሀራ መቶ ኤሀናባ ኤንታዉ ዳንን ባንታና ዶስድ ክርስቶሳባ ኦዶሶናፐ አትሽን፥ ቱማ ዎዛናፐ ኦዶኮና።<verse eid="PHP 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18"/>ሄስ አይኮካ መተና። ቱማ ኦገን ግድን ዎይኮ ዎርዶ ኦገን ግድን ሄ ኡባን ክርስቶስ ሳባከቴስ። ታና ሄስ ኡፋይሴስ። ቃስ ሀራባይ ታና ኡፋይስያባይ፥ <verse eid="PHP 1:18"/><verse number="19" style="v" sid="PHP 1:19"/>ታኒ ህንተ ዎሳንነ የሱስ ክርስቶሳ አያና ማዱዋን አታናይሳ ኤርያ ግሾ ታና ኡፋይሴስ። <verse eid="PHP 1:19"/><verse number="20" style="v" sid="PHP 1:20"/>ታ ግታ አሞይነ ኡፋይሳን ናግያ ናጎይ ታ ዬላቶና አታናይሳ። ሽን ኡባ ዎደ ኦይሳዳ፥ ሀእካ ታኒ ፓፃ ደእን ዎይኮ ሀይቅን ያዮና ታ ኩመ አሳተን ክርስቶስ ቦንቸታና ጋዳ ምኖተን ኦዳይስ። <verse eid="PHP 1:20"/><verse number="21" style="v" sid="PHP 1:21"/>ታ ደእኮካ ክርስቶሳ ፃላላስ ደአይስ፤ ቃስ ታ ሀይቅኮካ ታዉ አዳ ዎ። <verse eid="PHP 1:21"/><verse number="22" style="v" sid="PHP 1:22"/>ሽን ታ ፓፃ ደእኮ አይፈይ ደእያ ኦሶ ኦና። ሽን ፓፃ ደኤይሳፈነ ሀይቆፐ አዉሳ ዶራነኮ ታዉ ኤረተና። <verse eid="PHP 1:22"/><verse number="23" style="v" sid="PHP 1:23"/>ታኒ ሀ ናምአታፐ አዉሳ ዶራነኮ ኡንኤታስ። ሀ ደኡዋፐ ሻከታዳ ክርስቶሳራ እስፈ ዳናዉ አሞታይስ፤ ክርስቶሳራ እስፈ ደኤይስ ኡባፈ አዳ ሎኦ። <verse eid="PHP 1:23"/><verse number="24" style="v" sid="PHP 1:24"/>ሽን ታኒ ህንተ ግሾ ፓፃ ደኤይስ ህንተዉ ዳሮ ኮሽያባ።<verse eid="PHP 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 1:25"/>ሄሳ ታኒ ጌሻዳ ኤራይስ፤ ታኒ፥ ህንተ አማኖን ድጫናዳነ ኡፋይታናዳ ህንተራ ፓፃ ዳና። <verse eid="PHP 1:25"/><verse number="26" style="v" sid="PHP 1:26"/>ሄሳ ግሾ፥ ታኒ ህንተኮ ስማዳ ያ ዎደ፥ ክርስቶስ የሱሳራ ህንተ ደእያ ደኡዋን ታናን ደእያ ጬቀተይ ህንተዉ ዳራና።<verse eid="PHP 1:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27"/>ኡባፈ አድ፥ ህንተ ክርስቶሳ ዎንገላስ ቦንቾ ኤህያ ደኦ ደእተ። ታ ህንተና በእን ዎይኮ በኦና እፅን፥ ህንተ እስ ቆፋን ምን ኤቅድ፥ ሀራት ዎንገላን አማናና መላ እስ ዎዛናን ግድድ እስፈ ባፀተይሳ ታ ስአና። <verse eid="PHP 1:27"/><verse number="28" style="v" sid="PHP 1:28"/>ህንተ ሞርከታስ ያዮፍተ። ኤንቲ ህንተራ ኤቀትያባ ግድኮ ሄስ ህንተዉ አቶተስ፥ ኤንታዉ ዮስ ፆሳፈ ግድዳ ማላ። <verse eid="PHP 1:28"/><verse number="29" style="v" sid="PHP 1:29"/>ክርስቶሳስ ኦያ ቃዳይ ህንተዉ እመትዳይ፥ ህንተ እያ አማናና መላ ፃላላ ግዶናሽን ህንተ እያ ግሾ መቶ ኤካና መላሳ። <verse eid="PHP 1:29"/><verse number="30" style="v" sid="PHP 1:30"/>ሄሳ ግሾ፥ ህንተ ታ ዋይያ ካሰ በእደታ፤ ሀእካ ታ ዋየተይሳ ስኤታ። ህንተካ ታ ዋይያ መላ ዋየተታ።<note caller="-" style="x"><char style="xo" closed="false">1:30 </char><char style="xt" closed="false"><ref loc="ACT 16:19-40">ሀዋ 16:19-40</ref>.</char></note><verse eid="PHP 1:30"/></para>
  <chapter eid="PHP 1"/>
  <chapter number="2" style="c" sid="PHP 2"/>
  <para style="s1">ቱማ አሽከተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1"/>ክርስቶሳን ህንተ ደእያ ደኦይ ህንተና ምንስ፤ ቃስ እያ ሲቆይካ ህንተና ምንስ። ጌሻ አያናራ ህንተዉ እስፈተ ደኤስ፤ ህንተ ሀራታስ ኬሄታነ ቃተታ። <verse eid="PHP 2:1"/><verse number="2" style="v" sid="PHP 2:2"/>ህዛ፥ ህንተ እስ ቆፋን፥ ሲቆን፥ እስ ዎዛናንነ አያናን እስኖ ግድድ ታና ፖሎ ኡፋይስተ። <verse eid="PHP 2:2"/><verse number="3" style="v" sid="PHP 2:3"/>ህንተና ዶሶን ዎይኮ ጬቀትያ ሀዳ አሞን እስባካ ኦፍተ። ሽን ህንተ እሶይ እሱዋፈ ግታታይስ ያግድ ቆፖና ህንተና ካዉሽተ። <verse eid="PHP 2:3"/><verse number="4" style="v" sid="PHP 2:4"/>ህንተ እሶይ እሶይ፥ ሀራ አስ ማድያባ ኮይተፐ አትሽን፥ ህንተና ማድያባ ፃላላ ኮዮፕተ።<verse eid="PHP 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5"/>ክርስቶስ የሱሳን ደእያ ቆፋይ ህንተናን ዳናዉ በሴስ።<verse eid="PHP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6"/>እያዉ ኡባ ዎደ ፆሳ ሀኖት ደኤስ።</para>
  <para style="q2" vid="PHP 2:6">ግዶሽን፥ እያ ፆሳራ እስኖ ኦያ ሀኖታ፥</para>
  <para style="q2" vid="PHP 2:6">ዎልቃን ኤካናዉ ኮይቤና።<verse eid="PHP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7"/>ግዶሽን፥ እ ባዉ ደእያ ቦንቹዋ ኡባ አግድ፥</para>
  <para style="q2" vid="PHP 2:7">አይለ መታ ኤክስ፤</para>
  <para style="q2" vid="PHP 2:7">አሰ ዳንድ ቆንጭስ።<verse eid="PHP 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8"/>እ ባና ካዉሽስ፤</para>
  <para style="q2" vid="PHP 2:8">ሀይቃና ጋካናዉ፥</para>
  <para style="q2" vid="PHP 2:8">ሀር አቶሽን ማስቃልያ ቦላ</para>
  <para style="q2" vid="PHP 2:8">ሀይቃናዉ ኪተትስ።<verse eid="PHP 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9"/>ሄሳ ግሾ፥ ፆሳይ እያ ዳሮ ቁ ቁ ኦስ፤</para>
  <para style="q2" vid="PHP 2:9">ቃስ ሱን ኡባፈካ አያ ቃ ሱን እሚስ።<verse eid="PHP 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10"/>ሳሎንነ ሳአን፥</para>
  <para style="q2" vid="PHP 2:10">ሳአፐ ጋርሳን ደእያ ኡባይ፥</para>
  <para style="q2" vid="PHP 2:10">የሱሳ ሱን ቦንቹዋስ ጉልባታና።<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="ISA 45:23">እሳ 45:23</ref>.</char></note><verse eid="PHP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11"/>አሳ ኡባይ ባንታ እንፃርሳን፥</para>
  <para style="q2" vid="PHP 2:11">የሱስ ክርስቶሳ ጎዳ ያግድ፥</para>
  <para style="q2" vid="PHP 2:11">ፆሳ አዋ ቦንቹዋስ ማርካታና።<verse eid="PHP 2:11"/></para>
  <para style="s1">አላመስ ፖኦ ግዶ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12"/>ታ እሻቶ፥ ታኒ ህንተራ ደእያ ዎደ ኡባን ህንተ ኪተትዳይሳዳ፥ ሀእ ታኒ ህንተ ማታፐ ሃክንካ፥ ካሰይሳፈ አድ፥ ኪተታናዉ በሴስ። ፆሳስ ያሻንነ ኮኮርሳን ህንተ አቶተ ፖላናዉ ኦተ። <verse eid="PHP 2:12"/><verse number="13" style="v" sid="PHP 2:13"/>ፆሳይ፥ ህንተ እያዉ ኤሮ ግድ ኪተታና መላ ኡባ ዎደ ህንተ ግዶን ኦስ።<verse eid="PHP 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14"/>አይ ኦሶ ኦሸካ ዙዙሞና ዎይኮ ፓላሞና ኦተ። <verse eid="PHP 2:14"/><verse number="15" style="v" sid="PHP 2:15"/>ጌላነ ናጋራንቾ አሳ ግዶን ቦረቶናይሳታ፥ ጌሻታነ ፖኮይ ባይና ፆሳ ናይታዳ ግድተ። ህንተ ኤንታ ግዶን ሳሎ ፆልንቶዳ ፖእሸ፥<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="DEU 32:5">ዛረ 32:5</ref>.</char></note> <verse eid="PHP 2:15"/><verse number="16" style="v" sid="PHP 2:16"/>ደኦ እምያ ኪታ ኤንታዉ ኦድተ። ሄ ዎደ ታ ዳቡርሳይነ ታ ኦሶይ መላ አትቦና ግሾ፥ ክርስቶስ ያ ጋላስ ታ ህንተናን ጬቀታና።<verse eid="PHP 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17"/>ህንተ ፆሳስ እምያ አማኖ እሞታ ቦላ ታ ሱይ ኡሻ ያርሾዳ<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="fq" closed="false">ታ ሱይ ኡሻ ያርሾዳ፦ </char><char style="ft" closed="false">እስ እስ ዎደ ያርሾ በሳን ያርሸትያ መሄ ያርሹዋ ቦላ ሃ ዎይኮ ዎይነ ኡሻይ ጉኬስ።</char></note> ጉክኮካ ታና ኡፋይሴስ። ህንተካ ታራ ኡፋይታና። <verse eid="PHP 2:17"/><verse number="18" style="v" sid="PHP 2:18"/>ሄሳዳ ህንተካ ኡፋይትድ ታናካ ኡፋይሳናዉ በሴስ።<verse eid="PHP 2:18"/></para>
  <para style="s1">ፅሞትዮሳነ ኤጳፍራድቱሳ</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19"/>ታኒ ህንተ ደኡዋባ ስአዳ ኡፋይታናዉ ፅሞትዮሳ ህንተኮ ኤለሳዳ የዳና መላ ጎዳ የሱሲ ታና ማዳናይሳ አማነታይስ። <verse eid="PHP 2:19"/><verse number="20" style="v" sid="PHP 2:20"/>ህንተ ደኡዋስ ዎዛናፐ ቆፕያ እያ መላ አስ ሀር ኦንካ ባዋ። <verse eid="PHP 2:20"/><verse number="21" style="v" sid="PHP 2:21"/>ሀራት ባንታና ጎእያባ ኮዮሶናፐ አትሽን፥ የሱስ ክርስቶሲ ኮያባ ኦኮና። <verse eid="PHP 2:21"/><verse number="22" style="v" sid="PHP 2:22"/>እ ታራ እስፈ ግድድ ናእ ባ አዋስ ኦይሳዳ ዎንገላ ኦሶ ኦዳይሳነ አማነትያ አስ ግደይሳ ህንተ ኤሬታ። <verse eid="PHP 2:22"/><verse number="23" style="v" sid="PHP 2:23"/>ሄሳ ግሾ፥ ታባይ ሀንያባ በአዳ ኤለሳዳ እያ ህንተኮ የዳና ጋዳ ቆፓይስ። <verse eid="PHP 2:23"/><verse number="24" style="v" sid="PHP 2:24"/>ታኒ፥ ታ ሁጰን ማታ ዎደን ህንተኮ ባናይሳ ጎዳን አማነታይስ።<verse eid="PHP 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25"/>ሄሳዳካ፥ ታኒ፥ ታ እሻ ኤጳፍራድቱሳ፥ ታራ እስፈ ታ ባጋ ግድድ ኦዳይሳ፥ ኦለትዳይሳነ፥ ታና ማዳናዉ ህንተዉ ኪተትዳይሳ፥ ህንተኮ ኪታናዉ ቆፓስ። <verse eid="PHP 2:25"/><verse number="26" style="v" sid="PHP 2:26"/>እ ህንተና ኡባ በአናዉ ዳሮ ላሞቴስ። ቃስ እ ሀርገትዳይሳ ህንተ ስእዳ ግሾ፥ ባ ዎዛናን ዳሮ ኡንኤትስ። <verse eid="PHP 2:26"/><verse number="27" style="v" sid="PHP 2:27"/>እ ቱማ ሀርገትድ፥ ሀይቅ ክችድ አትስ። ሽን ፆሳይ እያዉ ቃትስ። እያ ፃላላስ ግዶናሽን፥ አዛኖይ አዛኖ ቦላ ጉዠቶናዳ ታዉካ ቃትስ።<verse eid="PHP 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PHP 2:28"/>ህዛ፥ ህንተ እያ ዛር በእድ ኡፋይታናዳ ታዉካ ታ ዎዛና ሴላይ እርፃናዳ ታኒ እያ ኤለሳዳ ህንተኮ የዳናዉ አሞታይስ። <verse eid="PHP 2:28"/><verse number="29" style="v" sid="PHP 2:29"/>ጎዳስ ሀጋዝያ አሳዳ እያ ኩመ ኡፋይሳን ሞክተ። ቃስ እያ መላ አሳ ኡባ ቦንችተ። <verse eid="PHP 2:29"/><verse number="30" style="v" sid="PHP 2:30"/>ህንተ ታ ማታን ግድድ ኦናዉ ዳንዳኦና ማድያ ማድድ ክርስቶሳ ኦሱዋ ግሾ፥ ባ ሸምፑዋስ ምሸቶና እፅድ ሀይቅ ክችድ አትስ።<verse eid="PHP 2:30"/></para>
  <chapter eid="PHP 2"/>
  <chapter number="3" style="c" sid="PHP 3"/>
  <para style="s1">ቱማ ፅሎተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1"/>ዉርሰን፥ ታ እሻቶ፥ ህንተ ጎዳባ ግድያ ግሾ፥ ኡፋይትተ። ታኒ ካሰ ፃፍዳይሳ ዛራዳ ፃፋናይስ ታና ዋይሰና፥ ሽን ህንተና ባላፐ ናጋና።<verse eid="PHP 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 3:2"/>ኢታባ ኦያ ካናታፐ፥ ቃስ ቃፃረታናዉ ኮሼስ ግያ ኢታ አሳታፐ ናገትተ። <verse eid="PHP 3:2"/><verse number="3" style="v" sid="PHP 3:3"/>ኑኒ ፆሳ ጌሻ አያናን ጎይንያ ግሾነ ኑ ደኡዋን ክርስቶስ የሱሳን ጬቀትያ ግሾ፥ ቱማ ቃፃሮ ቃፃረትዳይሳታ። ኑኒ ካረ አሳተ ቦላ ኦሰትያባን ጬቀቶኮ።<verse eid="PHP 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 3:4"/>ታ ካረ አሳተን ጬቀታናዉ ኮሽኮ ታ ዳሮባን ጬቀታናዉ ዳንዳአይስ። አይ አስካ ባ ካረ አሳተን ጬቀትያባይ ባዉ ደኤስ ግድ ቆፕኮ፥ ታኒ እያፐ ዳሮ አዳ ጬቀትያባይ ደኤስ። <verse eid="PHP 3:4"/><verse number="5" style="v" sid="PHP 3:5"/>ታኒ የለትዳ ሳምንታራ ቃፃረታስ። ታኒ የለታን እስራኤለ፤ ታኒ ብንያመ ኮቸ፤ ታኒ ዋላክ ባይና አይሁደ አሰ። አይሁደ ህገ ናጎን ግድኮ ታኒ ፋርሳወ።<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">ሀዋ 23:6</ref>፤ <ref loc="ACT 26:5">26:5</ref>፤ <ref loc="ROM 11:1">ሮመ 11:1</ref>.</char></note> <verse eid="PHP 3:5"/><verse number="6" style="v" sid="PHP 3:6"/>አይሁደ አማኑዋስ ምሸተን ግድኮ ታኒ ዎሳ ኬ የደስ። እስ አስ ህገ ናግድ ፅልያባ ግድኮ፥ ታናን ቦረይ በንትቤና።<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሀዋ 8:3</ref>፤ <ref loc="ACT 22:4">22:4</ref>፤ <ref loc="ACT 26:9-11">26:9-11</ref>.</char></note><verse eid="PHP 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7"/>ሽን ካሰ ታና ማዴስ ጋዳ ቆፕዳባ ኡባ፥ ክርስቶሳ ግሾ ጋዳ ማዶናባ ኦዳ ታይባስ። <verse eid="PHP 3:7"/><verse number="8" style="v" sid="PHP 3:8"/>ሄሳ ፃላላ ግዶናሽን፥ ታኒ ታ ጎዳ ክርስቶስ የሱሳ ኤረይስ ሀራባ ኡባፈ ዳሮ አያ ግሾ፥ ሄ ኡባ ዎይ ባይናባዳ ታይባስ። ታኒ እያ ግሾ ኡባባ ያስ። ክርስቶሳ ደማናዉ ኡባባ ዎራ ሆለትዳ ቡረዳ ታይባይስ። ታኒ የሱሳራ እስኖ ግዳስ። <verse eid="PHP 3:8"/><verse number="9" style="v" sid="PHP 3:9"/>ታኒ ህገስ ኪተታዳ ደምያ ታ ሁጰ ፅሎተ ታዉ ባዋ። ክርስቶሳ አማንን በንትያ ፅሎተይ፥ ፆሳ ማታፐ ያ ፅሎተይ ሀእ ታዉ ደኤስ። <verse eid="PHP 3:9"/><verse number="10" style="v" sid="PHP 3:10"/>ታኒ ክርስቶሳነ እያ ደንዶ ዎልቃ ኤራናዉ ኮያይስ። ታኒ እያ መቱዋ እያራ ሻከታናዉነ እያ ሀይቁዋን እያ ዳናናዉ አሞታይስ። <verse eid="PHP 3:10"/><verse number="11" style="v" sid="PHP 3:11"/>ሄሳዳካ፥ ሀይቆፐ ደንዳዳ መርናዉ ደኦን ዳናይሳ ኡፋይስ ኦይስ።<verse eid="PHP 3:11"/></para>
  <para style="s1">ጋፃ ጋካናዉ ዎፅተ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12"/>ታኒ ሀእ ጋፃ ጋካስ ዎይኮ ታናን ባል ባዋ ጊከ። ሽን ክርስቶስ የሱሲ ታና ኦይክዳ ግሾ ታኒ ታ ስንን ደእያ ዎይቱዋ ኦይካናዉ ዎፃይስነ ቡተታይስ። <verse eid="PHP 3:12"/><verse number="13" style="v" sid="PHP 3:13"/>ታ እሻቶ፥ ታኒ ሄሳ ደማስ ጋዳ ቆፕከ፥ ሽን ታኒ እስባ ኦይስ። ታፐ ጉየራ ደኤይሳ ዶጋዳ ስንን ደኤይሳ ኦይካናዉ ዛቱራይስ። <verse eid="PHP 3:13"/><verse number="14" style="v" sid="PHP 3:14"/>ሄሳ ግሾ፥ ታኒ ጋፃ ጋካናዉ ዎፃይስ። ፆሳይ ክርስቶስ የሱሳ ባጋራ ሳሎ ደኡዋስ ፄግዳ ዎይቱዋ ኤካናዉ ዳቡራይስ።<verse eid="PHP 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15"/>ህዛ፥ ኑኒ አያናን ጋሽትዳ ኡባይ ሄሳ ቆፓናዉ በሴስ። ህንተፈ ባጋታስ ዱማትያ ቆፍ ደእኮ፥ ሄሳካ ፆሳይ ህንተዉ ቆንጭሳና። <verse eid="PHP 3:15"/><verse number="16" style="v" sid="PHP 3:16"/>ግድኮካ፥ ኑኒ ሀኖ ጋካናዉ ደእዳ ደኡዋን፥ አነ ስን ቦስ።<verse eid="PHP 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17"/>ታ እሻቶ፥ ታና ዳንተ፤ ሄሳዳካ፥ ኑ ሌምሱዋ ካልያ አሳታ አኬክድ በእተ።<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="2CO 4:16">2 ቆሮ 4:16</ref>፤ <ref loc="2CO 11:1">11:1</ref>.</char></note> <verse eid="PHP 3:17"/><verse number="18" style="v" sid="PHP 3:18"/>ታኒ ሄሳ ህንተዉ ካሰ ዳሮ ቶሆ ኦዳስ፥ ሽን ሀእካ ዛራዳ አፉን ኦዳይስ። ክርስቶሳ ማስቃልያስ ባንታና ሞርከ ኦዳ ዳሮ አሳት ደኦሶና። <verse eid="PHP 3:18"/><verse number="19" style="v" sid="PHP 3:19"/>ኤንታ ዉርሰይ ዮ፤ ኤንታ ኡሎይ ኤንታዉ ፆሰ። ዬላታናዉ በሲያባን ኤንቲ ጬቀቶሶና፤ ቃስ ሀ ሳአባ ፃላላ ቆፖሶና። <verse eid="PHP 3:19"/><verse number="20" style="v" sid="PHP 3:20"/>ኑ ቢታይ ሳሉዋና። ሳሎፐ ይድ ኑና አሽያ ጎዳ የሱስ ክርስቶሳ ናጎስ። <verse eid="PHP 3:20"/><verse number="21" style="v" sid="PHP 3:21"/>ክርስቶስ ኡባባ ባ ማታፐ ጋርሳን ኦናዉ ዳንዳእያ ባ ዎልቃን ኑ ዳቡራንቾ አሳተ ላምድ ባ ቦንቾ አሳተ ዳንሳና።<verse eid="PHP 3:21"/></para>
  <chapter eid="PHP 3"/>
  <chapter number="4" style="c" sid="PHP 4"/>
  <para style="s1">ዉርሰ ዞረ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1"/>ታ እሻቶ፥ ታ ዶሰይሳቶ፥ ታ ላሞተይሳቶ፥ ታና ኡፋይሰይሳቶ፥ ታና ግታየይሳቶ፥ ህዛ፥ ጎዳን ምንድ ኤቅተ።<verse eid="PHP 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2"/>ኤዎዳነ ስንፅካ፥ ህንተ ናምአይ፥ እስ ቆፋን፥ ምችዳ ጎዳን ዳናዳ ታኒ ህንተና ዞራይስ። <verse eid="PHP 4:2"/><verse number="3" style="v" sid="PHP 4:3"/>ታራ ኦያ አማንይሶ፥ ኔኒ ሀ ማጫሳታ ማዳና መላ ታ ነና ዎሳይስ። ሀ ማጫሳት ታራ፥ ቀለምንፆሳራነ ኤንታ ሱንይ ፆሳ ደኦ ማፃፋን ፃፈትዳ ሀራታራ እስፈ ዎንገላ ኡባ በሳ ጋናዉ ዳቡርዶሶና።<verse eid="PHP 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4"/>ጎዳራ ህንተ ደእያ ደኡዋን ኡባ ዎደ ኡፋይትተ። ታኒ ሄሳ ጉጃዳካ ኦዳይስ፤ ኡፋይትተ።<verse eid="PHP 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5"/>አስ ኡባይ ህንተ አሽከተ ኤሮ፤ ጎዳይ ማታን ያና። <verse eid="PHP 4:5"/><verse number="6" style="v" sid="PHP 4:6"/>ህንተ ፆሳ ዎስያ ዎደ ኡባን እያ ጋላትሸ፥ ህንተና ኮሽያባ ኡባስ ዎስተፐ አትሽን፥ አይብባስካ ህርጎፍተ። <verse eid="PHP 4:6"/><verse number="7" style="v" sid="PHP 4:7"/>አሳ ኤራተ ኡባፈ አያ ፆሳ ሳሮተይ፥ ህንተ ዎዛናነ ህንተ ቆፋ ጎዳ የሱስ ክርስቶሳ ባጋራ ናጋና።<verse eid="PHP 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8"/>ዉርሰን፥ ታ እሻቶ፥ ህንተ ዎዛናን ሎኦባነ ጋላትስያባ ቆፕተ። ቱማ ግድያባ ኡባ፥ ቦንቾባ ኡባ፥ ቆሆ ግዶናባ ኡባ፥ ጌሻባ ኡባ፥ ሲቆባ ኡባነ ኡፋይስያባ ኡባ ቆፕተ። <verse eid="PHP 4:8"/><verse number="9" style="v" sid="PHP 4:9"/>ህንተ ታፐ ታማርዳባ፥ ኤክዳባ፥ ስእዳባነ በእዳባ ኡባ ኦተ። ሳሮተ እምያ ፆሳይ ህንተራ እስፈ ግዳና።<verse eid="PHP 4:9"/></para>
  <para style="s1">ጳዉሎስ ሺቅዳ እሞታስ ጋላትስ</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10"/>ዳሮ ዎደፐ ጉየ፥ ህንተ ታባ ዛሪድ ቆፓናዉ ዶምዳ ግሾ ታኒ ጎዳን ዳሮ ኡፋይታይስ። ሄሳ ጉሳይ፥ ታዉ ቆፓናዉ ህንተዉ እንጀቶና እፅዳይሳፈ አትሽን፥ ታዉ ቆፋ አግበከታ። <verse eid="PHP 4:10"/><verse number="11" style="v" sid="PHP 4:11"/>ታኒ ሄሳ ታና መትዳ ግሾ ጊከ፤ ታዉ ደእያባይ ግዳና ጉሱ ታማራስ። <verse eid="PHP 4:11"/><verse number="12" style="v" sid="PHP 4:12"/>ታኒ መቶተትድ ደእያ ዱስ ኤራይስ፤ ቃስ ዱረትድ ደእያ ዱስካ ኤራይስ። አዉን ግድን ቃስ አይ ዎደካ ታኒ ካሎነ ኮሻ፥ ፓጨነ ፓላሀ ታማራስ። <verse eid="PHP 4:12"/><verse number="13" style="v" sid="PHP 4:13"/>ክርስቶስ ታዉ እምያ ዎልቃን ኡባባ ኦናዉ ዳንዳአይስ።<verse eid="PHP 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14"/>ግድኮካ፥ ህንተ ታ መቱዋ ታራ ኤክዳይሳን ሎኦ ኦደታ። <verse eid="PHP 4:14"/><verse number="15" style="v" sid="PHP 4:15"/>ፍልጵስዩሳ አሳቶ፥ ዎንገላ ኮይሮ ኦዳናዉ ታኒ ማቀዶነፐ ከይያ ዎደ እምያባንካ ኤክያባንካ ህንተ ዎሳ ኬፈ አትሽን፥ ሀር ታና ማድቦናይሳ ህንተ ኤሬታ።<note caller="-" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="2CO 11:9">2 ቆሮ 11:9</ref>.</char></note> <verse eid="PHP 4:15"/><verse number="16" style="v" sid="PHP 4:16"/>ተሰሎንቀን መቶይ ጋክዳ ዎደካ ታና ዛር ዛሪድ ማድደታ።<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ACT 17:1">ሀዋ 17:1</ref>.</char></note> <verse eid="PHP 4:16"/><verse number="17" style="v" sid="PHP 4:17"/>ታኒ፥ ህንተፈ እሞታ ኤካናዉ ኮያዳ ግዶናሽን፥ እሞፐ ያ አንጁዋ ህንተ ኤካና መላሳ።<verse eid="PHP 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 4:18"/>ታኒ፥ ህንተ እምዳ ኡባነ ግድድ ፓላሄይሳ ኤካስ። ህንተ የድዳ ኡባ ኤጳፍራድቱሳፐ ኤካስ፤ ኮሽያባ ኡባይ ታዉ ደኤስ። ህንተ ታዉ የድዳ እሞይ ፆሳስ ሳዎ ቶንኩ ግያ፥ እ ዶስያ፥ እ ኡፋይትያ ያርሾ መላ።<note caller="-" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="EXO 29:18">ከሳ 29:18</ref>.</char></note> <verse eid="PHP 4:18"/><verse number="19" style="v" sid="PHP 4:19"/>ታ ፆሳይ ባ ቦንቾ ዱረተፈ፥ ክርስቶስ የሱሳ ባጋራ ህንተዉ ኮሽያባ ኡባ እማና። <verse eid="PHP 4:19"/><verse number="20" style="v" sid="PHP 4:20"/>ኑ አዋ ፆሳስ መርናፐ መርና ጋካናዉ ቦንቾይ ግዶ። አምንእ።<verse eid="PHP 4:20"/></para>
  <para style="s1">ሳሮ</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21"/>ክርስቶስ የሱሳ ባጋራ ፆሳባ ግድዳ ኡባ ሳሮ ጊተ። ታራ ደእያ እሻት ህንተና ሳሮ ጎሶና። <verse eid="PHP 4:21"/><verse number="22" style="v" sid="PHP 4:22"/>ፆሳባ ግድዳ አሳ ኡባይ፥ ኡባፈ አድ ካዋ ቄሳረ ኬን ደኤይሳት ህንተና ሳሮ ጎሶና።<verse eid="PHP 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23"/>ጎዳ የሱስ ክርስቶሳ አ ኬሀተይ ህንተራ ግዶ።<verse eid="PHP 4:23"/></para>
  <chapter eid="PHP 4"/>
</usx>
