<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EST" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">አስትር ማፃፋ</para>
  <para style="toc1">አስትር ማፃፋ</para>
  <para style="toc3">አስት</para>
  <para style="toc2">አስትሮ</para>
  <para style="mt">አስትር ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">አስትር ማፃፋን ፃፈትዳ ታርከት ፖለትዳይ፥ ፋርሰ ካዎይ፥ ሱሳ ካታማን ባ ካዎ ጋን ደእሽና። ሄ ማፃፋይ ናምኡ ግታ ቆፋታ ኦይክስ፤</para>
  <para style="ipi">1. ባ ፃላተንነ ባ አሳስ ደእያ ግታ ምሻን፥ ሞርከት ኤንታ ይሳና ሀንያ ዎደ ባ አሳ አሽዳ፥ አስትሮ ጌተትያ አይሁደ ማጫሰ ታርከ ኦዴስ።</para>
  <para style="ipi">2. አይሁደት ቦንችያ፥ ፑርማ ጌተትያ ባለይ ቦንቸትያ ጋሱዋ ቆንጭሴስ።</para>
  <para style="ip">አስትር ማፃፋን ዳሮ ቆንጭድ ኤረትዳ እቻሹ አሳት ደኦሶና። ኤንትካ፥ (1) ፋርሰ ካዋ አርፀክስሳ፤ (2) እያ ሹማ ሃማ፤ (3) ጎዳትዉ አስፂኖ፤ (4) አይሁደ ማጫስዉ አስትሮ፤ (5) አስትር አዋ እሻ ማርድክዮሳ።</para>
  <para style="ip">ሀ ማፃፋን ፆሳ ሱን ፄገቶና እፅኮካ፥ እያ ኦሶይ፥ ማሮተይ፥ እያ ኬሀተይነ ሲቆይ ቆንጭዳ ማፃፋ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">አስትራ ካዎ ማቾ ግዳሱ (<char style="ior"><ref loc="EST 1:1-2:23">1:1—2:23</ref></char>)</para>
  <para style="io1">ሃም አይሁደ ይሳናዉ ቆፕስ (<char style="ior"><ref loc="EST 3:1-15">3:1-15</ref></char>)</para>
  <para style="io1">ማርድክዮስ አስትሮ ማደ ኦይችስ (<char style="ior"><ref loc="EST 4:1-17">4:1-17</ref></char>)</para>
  <para style="io1">ማርድክዮስ ደምዳ ቦንቹዋ (<char style="ior"><ref loc="EST 5:1-6:14">5:1—6:14</ref></char>)</para>
  <para style="io1">ሃማ ቦላ ሀይቆ ፕርዳ (<char style="ior"><ref loc="EST 7:1-10">7:1-10</ref></char>)</para>
  <para style="io1">አይሁደት ባንታ ሞርከታ ይሱዋ (<char style="ior"><ref loc="EST 8:1-9:19">8:1—9:19</ref></char>)</para>
  <para style="io1">ፑርማ ባኣለ ቦንቹዋ (<char style="ior"><ref loc="EST 9:20-32">9:20-32</ref></char>)</para>
  <para style="io1">አርፀክስሳነ ማርድክዮሳ ሹማተ (<char style="ior"><ref loc="EST 10:1-3">10:1-3</ref></char>)</para>
  <chapter number="1" style="c" sid="EST 1"/>
  <para style="s1">ካዋ ግብራ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 1:1"/>ካዎይ አርፀክስስ ህንደ ቢታፈ ቶጰ ቢታ ጋካናዉ ደእያ፥ ፄታነ ላታማነ ላፑን ቢታ አይስያ ዎደ ሀንዳባ። <verse eid="EST 1:1"/><verse number="2" style="v" sid="EST 1:2"/>ካዎይ ባ አራታን ኡትድ አይስያ ዋና ካታማይ ሱሳ ጌተቴስ።<verse eid="EST 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 1:3"/>እ ካዎትዳ ሄን ላይን፥ ባፐ ጋርሳራ ዳይናታስነ ቢታ አይሰይሳታስ ግታ ግብራ ጊግስስ። ሄ ግብራ በሳን ሜዶናነ ፋርሰ ቶራ ሞጮናት፥ ቢታ ሃረይሳትነ አይሰይሳት በንትዶሶና። <verse eid="EST 1:3"/><verse number="4" style="v" sid="EST 1:4"/>ካዎይ እስ ፄታነ ሆስፑን ታሙ ጋላስ ኩመ ባ ካዎተ ዱረተነ ባ ያሽያ ቦንቹዋ ኡባ ኤንታ በስስ።<verse eid="EST 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 1:5"/>ሄ ጋላሳታፐ ጉየ፥ ካዎይ ቃስ ሀራ ላፑን ጋላስ ጋምእያ ግብራ፥ ሱሳ ካታማን፥ ዱረፐ ማንቆ ጋካናዉ ደእያ አሳ ኡባስ ጊግስስ። ሄ ግብራይ ካዎ ጋይ ደእያ አታክልተ በሳን ጊግስ። <verse eid="EST 1:5"/><verse number="6" style="v" sid="EST 1:6"/>ሄ በሳን ደእያ ዳባባይ፥ ሊኖፐ ኦሰትዳ ቦነ ካሎሰ ገሸታን አሌቅስ። ገሸት ኦቻ ቴራ ዳንያ አልኦ ሊኖ ክረን አን፥ እብነባራደ ጌተትያ ሹቻፈ ኦሰትዳ ቱቅያ ቦላ ደእያ ብራ ምግዶታን ካቀትድ ኡትዶሶና። ቃስ ዎርቃፈነ ብራፐ ኦሰትዳ አርሳት፥ ዱማ ዱማ ማል ደእያ አልኦ ሹቻታፐ ኦሰትዳ ባሱዋን ማራን የገትዶሶና። <verse eid="EST 1:6"/><verse number="7" style="v" sid="EST 1:7"/>እሶይ እሱዋፈ ዱማ ግድዳ ዎርቃ ቡርጩኮን ዎይነ ኡሽ አሳ ኡባስ እመትስ። ካዎይ ዳሮ ኬሀ ግድዳ ግሾ፥ ዎይነ ኡሻስ ዛው ባዋ። <verse eid="EST 1:7"/><verse number="8" style="v" sid="EST 1:8"/>እስ እስ አስ ባ ኮይዳ መላ ኡዬስ፤ ሄሳ ካዎይ ኮይሮትድ ባ አይለታስ ኦድስ።<verse eid="EST 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 1:9"/>ሄ ዎደ ካውያ አስፂና ማጫሳ ኡባስ ግብራ ካዎ ጋን ጊግሳሱ።<verse eid="EST 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 1:10"/>ግብራይ ዶመትዳ ላፑን ጋላስ፥ ካዎይ አርፀክስስ ዎይነ ኡሻ አልድ ኡፋይትዳ ዎደ፥ ባ አይለታ መሁማና፥ ብዝታ፥ ሀርቦና፥ ብግታ፥ አባግታ፥ ዛታራነ ካርካሳ ጌተትያ ላፑን ሹፋታ ፄግድ፥ <verse eid="EST 1:10"/><verse number="11" style="v" sid="EST 1:11"/>“ካውዉ አስፂኖ ካዎተ ካላቻ ዎድ ሃ ኤክድ ዪተ” ያግድ ኪትስ። እያ ዳሮ ማላ ሎኦ ግድያ ግሾ፥ ሀላቃትነ አሳ ኡባይ እዮ በአና መላ ካዎይ ኮይስ። <verse eid="EST 1:11"/><verse number="12" style="v" sid="EST 1:12"/>ሽን ካዋ ኪታ እዉ ኦድን፥ ካውያ አስፂና ካዋ ስን ዮና እፃሱ። ሄስ ካዋ ዳሮ ሀንቀስ።<verse eid="EST 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 1:13"/>ሄ ቢታ ህግያነ ደኦ ዎጋ ኤርያ አሳ ዞረ ኦይሾይ ካዋ ማታን ሜዘትዳባ ግድያ ግሾ፥ ዎድያባ ሻክድ ኤርያ ጭንጫ አሳታራ ኦደትስ። <verse eid="EST 1:13"/><verse number="14" style="v" sid="EST 1:14"/>ካዎይ ግታ ማት ደእያ ላፑን ፋርሰነ ሜዶና ሹማታ፥ አርቀስዮሳ፥ ሸታራ፥ አድማታ፥ ታርሸሻ፥ ማሬሳ፥ ማርሳናነ መሙካና ፄግስስ። <verse eid="EST 1:14"/><verse number="15" style="v" sid="EST 1:15"/>ካዎይ ኤንታ፥ “ታኒ፥ ካዎይ አርፀክስስ፥ ታ ሹፋታ ኪትን፥ ካውያ አስፂና ታ ኪታ ፖሎና እፃሱ። ሄሳ ግሾ፥ ህገይ ኦድያ ማራን እዮ ዋታናዉ በሲ?” ያግድ ኦይችስ።<verse eid="EST 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 1:16"/>ኤንታፈ እሶይ፥ መሙካን ካዋ ስንንነ ሀላቃታ ስንን ሀይሳዳ ያግስ፤ “ካውያ አስፂና ካዋ ፃላላ ግዶናሽን፥ እያ ሀላቃታ ኡባነ እያ ካዎተ ግዶን ደእያ አሳ ኡባ ናቃሱ። <verse eid="EST 1:16"/><verse number="17" style="v" sid="EST 1:17"/>ሀ ካዎተ ግዶን ደእያ ማጫስ ኡባይ ካውያ አስፂና ኦዳይሳ ስእድ፥ ባንታ አዝናታ ካ ዶማና። ኤንቲ፥ ‘ካዎይ አርፀክስስ ባኮ ያና መላ ፄግስን፥ ካውያ አስፂና እፃበከዬ?’ ያጋና። <verse eid="EST 1:17"/><verse number="18" style="v" sid="EST 1:18"/>ሄሳ ፃላላ ግዶናሽን፥ ፋርሰነ ሜዶና ሀላቃታ ማጫሳይ ሄሳ ስእዳ ዎደ፥ ሀች አው ዉላና ጋካናዉ ባንታ አዝናታ ሄሳዳ ግድ ካና። ሄሳ ጋሶን ማቸታ ግዶንነ አዝናታ ግዶን ኦሽ ከያና። <verse eid="EST 1:18"/><verse number="19" style="v" sid="EST 1:19"/>ሄሳ ግሾ ካዋዉ፥ ኔኒ ዶስኮ፥ ካውያ አስፂና ናምአን ነ ስን አና መላ ተቅያ አዋጆ ከሳ። ሄ አዋጆይ ናምአን ላመቶና መላ ፋርሰነ ሜዶና ህግያ ግዶን ፃፈቶ። ሄሳፈ ጉየ፥ ካዎተ ቦንቹዋ ኢፐ ኤካዳ ሀራ ሎኦ ማጫሳስ እማ። <verse eid="EST 1:19"/><verse number="20" style="v" sid="EST 1:20"/>ሀ ኔኒ አዳ አዋጆይ ሀ ግታ ካዎተ ኡባን ኦደትያ ዎደ እስ እስ ማጫስ ዱረ ግድን ማንቆ ግድን፥ ሻኮና ባ አዝና ቦንቻና” ያግስ።<verse eid="EST 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 1:21"/>ካዎይነ እያ ሀላቃት ሀ ዞርያን ኡፋይትዶሶና። ሄሳ ግሾ፥ መሙካን ግዳይሳዳ ካዎይ ኦስ። <verse eid="EST 1:21"/><verse number="22" style="v" sid="EST 1:22"/>እ ባ ካዎተ ግዶን ደእያ ዱማ ዱማ ቢታታስ ኤንታ ፕዳለንነ ኤንታ ዶናን ፃፍድ፥ ዳብዳበ የድስ። ሄ አዋጆይ፥ እስ እስ አዝን ባ ኬ ኬ አይስያ ሀላቃ ግደይሳ ኦዴስ።<verse eid="EST 1:22"/></para>
  <chapter eid="EST 1"/>
  <chapter number="2" style="c" sid="EST 2"/>
  <para style="s1">አስትራ ካዎ ማቾ ግዳሱ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1"/>ሄሳፈ ጉየ፥ ካዋ አርፀክስሳ ሀንቆይ ዶችን፥ ካውያ አስፂና ኦዳባነ እ ቦላ ከይዳ አዋጁዋባ ቆፕስ። <verse eid="EST 2:1"/><verse number="2" style="v" sid="EST 2:2"/>ሄ ዎደ ካዋ ማታን ሀጋዝያ ናአተታ አደት ሀይሳዳ ያግዶሶና፤ “ማላ ሎኦ ጌላኦታ ኮይድ፥ ካዋስ ኤሀና መላ፥ <verse eid="EST 2:2"/><verse number="3" style="v" sid="EST 2:3"/>ነ ካዎተ ግዶን ደእያ ቢታ ኡባን ሀላቃታ ሹማ። ኤንቲ ማላ ሎኦ ጌላኦ ዶርድ፥ ሱሳ ካታማ ኤህድ፥ ማጫሳስ ጊግዳ ኬን ዎ። ያን ሄ ማጫሳ ኬስ ካፖ ግድዳ ካዎ ሹፋ ሄጋያ ኩሸን ኤንቲ ደእሽን፥ ኤንታ ማላ ሎይያባ ኡባይ ኤንታዉ እመቶ። <verse eid="EST 2:3"/><verse number="4" style="v" sid="EST 2:4"/>ሄሳፈ ጉየ፥ ኡባፈ አዳ ካዋ ኡፋይስያ ጌላእያ አስፂን በሳን ካዎ ማቾ ግዶ” ያግዶሶና። ሀ ዞረይ ካዋ ኡፋይስዳ ግሾ፥ ካዎይ ሄሳዳ ኦስ።<verse eid="EST 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 2:5"/>ያን ሱሳ ካታማን እስ ማርድክዮሳ ጌተትያ አይሁደ አስ ደኤስ። እ ያእራ ናአ፤ ያእር ሳመአ ናአ፤ ሳመእ ብንያመ ኮቸ ግድዳ ቂሳ ናአ። <verse eid="EST 2:5"/><verse number="6" style="v" sid="EST 2:6"/>ባብሎነ ካዎይ ናቡካዳናፆር ይሁዳ ካዋ ዮአክናነ ሀራ አይሁደ አሳ ኦላን ድእድ ኤፍዳ ዎደ ማርድክዮስ ኤንታራ ብስ። <verse eid="EST 2:6"/><verse number="7" style="v" sid="EST 2:7"/>እ ባ አዋ እሻ ናእዉ፥ እብራወ ዶናን ሀዳሶ ጌተትያ አስትሮ ባራ ዎድ ድቼስ። አስትራ መንነ ጌሳን ዳሮ ማላ ሎኦ። እ አዋይነ አይያ ሀይቅዳፐ ጉየ፥ ማርድክዮስ እዮ ኤፍድ፥ ባ ናአ ኦድ ድችስ።<verse eid="EST 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 2:8"/>ካዎይ ከስዳ አዋጁዋነ ኪታ ማራን፥ ሱሳ ካታማ ይዳ ዶረትዳ ዳሮ ጌላኦታፐ እስንያ አስትሮ። እያ ያዳ፥ ማጫሳስ ጊግዳ ኬ ካፖ ግድዳ ሄጋ አዋተ ጋርሳን ደአሱ። <verse eid="EST 2:8"/><verse number="9" style="v" sid="EST 2:9"/>ሄግ አስትሮ በእዳ ዎደ እን ዳሮ ኡፋይትስ፤ እዮ ዱማ ፄልስ። ኤለስድ ማናዉ ዱማ ካነ ቦላ ትየትያባ እዉ እሚስ። ቃስ እዮ ማታን ሀጋዛና መላ ካዎ ጋፐ ዶረትዳ ላፑን ናአተ፥ ማጫሳታ ጊግዳ ኬን፥ ክፍለ ኡባፈ አድ ሎእያ ክፍለን እዮነ ኤንታና ዎስ።<verse eid="EST 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 2:10"/>ማርድክዮስ እዉ ኮይሮትድ ኦድዳይሳዳ፥ አስትራ አይሁደ አስ ግደይሳ ኦደስካ ኦዳቡኩ። <verse eid="EST 2:10"/><verse number="11" style="v" sid="EST 2:11"/>ቃስ ማርድክዮስ አስትራ ዋና ደእያኮነ እዉ ሀንያባ በአናዉ፥ ማጫሳ ኬ ስንራ ጋላስ ጋላስ ገደነ ሃ ሄመቴስ።<verse eid="EST 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 2:12"/>ጌላኦት ካዋኮ ገላናፐ ኮይሮትድ፥ እስ ላይ ኩመ ባንታ ማላ ሎይሸ ጋምኦሶና። ሄስካ፥ ኮይሮ ኡሱፑን አጌና ካርበ ዛይተን ጎርፐትሸ ጋምእድ፥ ናምአን ኡሱፑን አጌና ቃስ፥ ሎኦ ሳውያ ሽቶን ጎርፐቶሶና። <verse eid="EST 2:12"/><verse number="13" style="v" sid="EST 2:13"/>ሄሳፈ ጉየ፥ እስ ጌላእያ ካዋኮ ገልያ ዎደይ ጋክያ ዎደ፥ ባ ኮይዳ ማኡዋ ማአ ሎአዳ፥ ማጫሳ ኬፈ ከያዳ፥ ካዎይ ደእያ በሳ ገላዉሱ። <verse eid="EST 2:13"/><verse number="14" style="v" sid="EST 2:14"/>ቃማ ገላዳ፥ ካዉዋራ አቅዳፐ ጉየ፥ ዎንታ ጉራ ከይኮ፥ ማጫሳት ደእያ ሀራ ኬ እዮ ኤፎሶና። ሄ ኬስ ካፖ ግድዳ ካዎ ሹፋይ ሻሻጋዝ እዮ ናጌስ። ካዎይ ዶስድ እ ሱን ፄግድ፥ “ኤበልቶ ኤህተ” ጎና እፅኮ፥ እያ ናምአን ካዋኮ ገላናዉ ዳንዳኡኩ።<verse eid="EST 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 2:15"/>ሄስ ሀንሽን፥ ካዋኮ ገልያ ታር አስትሮ ጋክስ። አስትራ ማርድክዮሳ አዋ እሻ አብካላ ናእዉ፤ ማርድክዮስ ባ ናአ ኦድ ድችዳሮ። እያ ማጫሳስ ጊግዳ ኬስ ካፖ ግድዳ ካዎ ሹፋ ሄጋይ ዞርዳይሳዳ ማኦ ማአሱ። እዮ በእዳ ኡባይ እ ማላ ናሽስ። <verse eid="EST 2:15"/><verse number="16" style="v" sid="EST 2:16"/>አርፀክስስ ካዎትዳ ላፑን ላይን፥ ተቤታ ጌተትያ ታማን አጌናን አስትራ ካዎይ ደእያ በሳ ገላሱ።<verse eid="EST 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 2:17"/>እያ ገልዳ ዎደ፥ ካዎይ ሀራ ማጫሳ ኡባፈ አድ፥ እዮ ዶስስ፤ ቃስ ሀራ ጌላኦታ ኡባፈ እን ኡፋይትስ። ሄሳ ግሾ፥ ካዎተ ካላቻ እ ሁጰን ዎድ፥ እዮ አስፂን በሳን ካዎ ማቾ ኦስ። <verse eid="EST 2:17"/><verse number="18" style="v" sid="EST 2:18"/>ሄሳፈ ጉየ፥ ካዎይ አስትር ቦንቹዋስ ግታ ግብራ ጊግስድ፥ ሀላቃታነ ቢታ አይሰይሳታ ፄግስ። ቃስ ባ ካዎተ ግዶን ኡፋይሳ ባለይ ቦንቸታና መላ አዋጅስ። ቢታ ኡባስ እስ ላይ ጊራ ማርስ። እሞታካ ባ ኬሀተ መላ ሁጰን ሁጰን እሚስ።<verse eid="EST 2:18"/></para>
  <para style="s1">ማርድክዮስ ማቁዋ ላልስ</para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19"/>ጌላኦት ናምአን ሺቅድ ደእሽን፥ ማርድክዮስ ካዋ ዳባባን ኡትያ አሳፐ እሱዋ ግድስ። <verse eid="EST 2:19"/><verse number="20" style="v" sid="EST 2:20"/>ማርድክዮስ፥ “ኔኒ አይሁደ ግደይሳ ኦደስካ ኦዶፓ” ግዳ ግሾ፥ አስትራ ሀእ ጋካናዉ ኦደስካ ኦዳቡኩ። ካሰ ናአተን ኪተተይሳዳ፥ ሀእካ እያዉ ኪተታዉሱ።<verse eid="EST 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 2:21"/>ማርድክዮስ ካዎ ኬን ኦሸ ደእያ ዎደ፥ ካዎይ ደእያ ክፍለታ ገልያ ፐንግያ ናግያ ካዎ ሹፋታፐ ናምአት፥ ጋባትነ ታር ካዋ አርፀክስሳ እፅድ፥ ዎናዉ ማቀትዶሶና። <verse eid="EST 2:21"/><verse number="22" style="v" sid="EST 2:22"/>ኤንታ ማቁዋ ማርድክዮስ ስእድ፥ ካወ አስትርስ ኦድን፥ እያካ ማርድክዮሳ ሱንን ካዋስ ኦዳሱ። <verse eid="EST 2:22"/><verse number="23" style="v" sid="EST 2:23"/>ካዎይ ሀንዳባ ፕልግድ ፄልያ ዎደ፥ ኦዳይ ቱማ ግድድ በንትን፥ ሄ ናምኡ አሳታ ካቅድ ዎስ። ሀ ሀኖታይ ካዋ አርፀክስሳ ታርከ ፃፍያ ማፃፋን ፃፈትስ።<verse eid="EST 2:23"/></para>
  <chapter eid="EST 2"/>
  <chapter number="3" style="c" sid="EST 3"/>
  <para style="s1">ሃም አይሁደታ ይሳናዉ ማቅስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1"/>ሄሳፈ ጉየ፥ ካዎይ አርፀክስስ ሃማ ጌተትያ ባራ ኦይሳ ሹማተ ቅስድ፥ ባ ሀላቃታ ሀላቃ ኦድ ሹምስ። ሃማ አዋይ ሀማዳት አጋጋ ኮቸ። <verse eid="EST 3:1"/><verse number="2" style="v" sid="EST 3:2"/>ካዎይ ኪትድ ዎዳ ግሾ፥ ካዎ ጋ ፐንገን ኦያ ሀላቃት ኡባይ ሃም አያ ዎደ ጉልባትድ እያ ቦንቾሶና። ግዶሽን፥ ማርድክዮስ ሃማስ ጉልባቶናነ እያ ቦንቾና እፅስ። <verse eid="EST 3:2"/><verse number="3" style="v" sid="EST 3:3"/>ሄ ዎደ ካዎ ጋ ፐንገን ኦያ ሀላቃት ማርድክዮሳ፥ “አይስ ካዋ ኪታ ፖሎና እፃይ?” ያግድ፥ <verse eid="EST 3:3"/><verse number="4" style="v" sid="EST 3:4"/>ጋላስ ጋላስ እያዉ ኦዶሶና። ሽን እ ኤንቲ ኦደይሳ ስአናዉ ኮይቤና። ኡባ ቃስ፥ “ታኒ አይሁደ አስ ግድያ ግሾ፥ ሃማስ ጉልባታናዉነ እያ ቦንቻናዉ ዳንዳእከ” ያግስ።</para>
  <para style="p" vid="EST 3:4">ሄሳፈ ጉየ፥ “ማርድክዮስ ኦድያ ጋሱዋ ስእድ፥ ሃም ዋናንዴሻ!” ያግድ እያዉ ኦድዶሶና። <verse eid="EST 3:4"/><verse number="5" style="v" sid="EST 3:5"/>ማርድክዮስ ባዉ ጉልባቶናይሳነ ባና ቦንቾናይሳ ሃም ኤርዳ ዎደ ሀንቆ ኤፅስ። <verse eid="EST 3:5"/><verse number="6" style="v" sid="EST 3:6"/>ሄሳ ቦላ ቃስ፥ ማርድክዮስ አይሁደ አስ ግደይሳ ኤርድ፥ እያ ፃላላ ዎይ ላፋባ ግድ ቆፕዳ ግሾ፥ አርፀክስሳ ካዎተን ደእያ አይሁደ ኮቻ ኡባ ይሳናዉ ቆፕስ።<verse eid="EST 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 3:7"/>አርፀክስስ ካዎትዳ ታማነ ናምአን ላይን፥ ንሳነ ጌተትያ ኮይሮ አጌናን፥ አይሁደታ ዎያ አጌናነ ጋላሳ ኤራናዉ፥ ፑርማ ጌተትያ ሳማ እያ ስንን የጋና መላ ሃም ኪትስ። ሄ ሳማይ ዎዳ ማራን፥ አዳረ ጌተትያ ታማነ ናምአን አጌናን፥ ታማነ ሄን ጋላስ አይሁደት ዉርያ ጋላስ ግደይስ ቃሸትስ።<verse eid="EST 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 3:8"/>ሄሳፈ ጉየ፥ ሃም ካዋ አርፀክስሳኮ ሀይሳዳ ያግስ፤ “ነ ካዎተ ግዶን ኡባ በሳን ላለትድ ደእያ እስ ኮቻይ ደኤስ። ኤንታ ደኦ ማራይ ሀራ አሳይሳፈ ዱማ፤ ሄሳ ፃላላ ግዶናሽን፥ ኤንቲ ካዎ ህግያስ ሃረቶኮና። ሄሳ ግሾ፥ ኔኒ ኤንታ ደኦ ጋዳ ስእ ጊኮ፥ ሄስ ሎኦ ግደና። <verse eid="EST 3:8"/><verse number="9" style="v" sid="EST 3:9"/>ሄሳ ግሾ ካዋዉ፥ ሀ ቆፋይ ነና ኡፋይስኮ፥ ሀ አሳታ ዎድ ይሳና መላ አዋጆ ከሳ። ሄሳ ነ ኦኮ፥ ታኒ ሄ ፄታነ ኦይታሙ ሙኩሉ ክሎ ግራመ ብራ ካዎ ቡቁራ ምንጅያ ኬ ገልሳናዳ፥ ነ ካዎተ አይሰይሳታስ እማና” ያግስ።<verse eid="EST 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 3:10"/>ካዎይ ባ ማታ ኤርሳናዉ አዋጁዋ ቦላ ዎያ ምግዶ ማታመ ባ ብራያፈ ከስድ፥ አይሁደታ ሞርከ ግድዳ፥ አጋጋ ኮቻስ፥ ሀማዳታ ናኣ ሃማስ እሚስ። <verse eid="EST 3:10"/><verse number="11" style="v" sid="EST 3:11"/>ካዎይ ሃማ፥ “ኔኒ እማና ግዳ ብራይ ነ ማታን ደኦ፤ ሽን ሀ አሳታ ቦላ ነ ዶስዳባ ኦ” ያግስ።<verse eid="EST 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 3:12"/>ሄሳ ግሾ፥ ኮይሮ አጌናን፥ ታማነ ሄን ጋላሳን፥ ሃም ካዋ ፃፈታ ኡባ ፄግድ፥ ሄ አዋጆይ ቢታ ኡባን ደእያ አሳስ ዱማ ዱማ ዶናንነ ዱማ ዱማ ፕዳለን ፃፈትድ፥ ካዎፐ ጋርሳራ ቢታ ሃረይሳታስ፥ አዉራጃ ሃረይሳታስነ ደረ ሀላቃታ ኡባስ ኪተታናዳ ኪትስ። አዋጆይ ካዋ አርፀክስሳ ሱንን ፃፈትድ፥ ምግዶ ማታመይ እያ ቦላ ዎሰትን፥ <verse eid="EST 3:12"/><verse number="13" style="v" sid="EST 3:13"/>ኪተትዳይሳት እያ ካዎተ ኡባ ጋናዳ ኪተትዶሶና። ሄ አዋጆይ፥ “አዳረ ጌተትያ ታማነ ናምአን አጌናን ታማነ ሄን ጋላሳን፥ አይሁደ ኡባ፥ ያላጋ፥ ጭማ፥ ማጫ፥ አድያነ፥ ናይታ አሾና እስ ጋላስ ዉርስድ ዎድ፤ ኤንታ ሻሉዋካ ቦንቅተ” ያጌስ። <verse eid="EST 3:13"/><verse number="14" style="v" sid="EST 3:14"/>ሄሳ ግሾ፥ ሄ ቃሸትዳ ጋላሳይ ጋክያ ዎደ አስ ኡባይ ጊገታናዳ፥ ሄ አዋጆይ ቢታ ኡባ ኪተትስነ አሳ ኡባስ አዋጀትስ።<verse eid="EST 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 3:15"/>ካዎይ ኪትዳይሳት ቢታ ኡባ ኪታ ጋዶሶና። ቃስ ሱሳ ካታማንካ ኦደትስ። ያትን፥ ሱሳ ካታማ አሳ ኡባይ ዳጋምስ። ሽን ካዉዋራነ ሃማራ እስፈ ኡትድ፥ ዎይነ ኡሻ ኡዮሶና።<verse eid="EST 3:15"/></para>
  <chapter eid="EST 3"/>
  <chapter number="4" style="c" sid="EST 4"/>
  <para style="s1">ማርድክዮስ አስትሮ ማደ ኦይችስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1"/>ማርድክዮስ ሀ ሀንዳባ ኡባ ስእዳ ዎደ፥ አዛንድ ባ ማኡዋ ፔድ፥ ካዮ ማኦ ማእድ፥ ባ ሁጰን ብዶ ቆልስ። ባ ቃላ ቁ ኦድ፥ ይባታ ዬሆ ዬክሸ፥ ካታማ ግዶን ዩይስ። <verse eid="EST 4:1"/><verse number="2" style="v" sid="EST 4:2"/>ካዮ ማኦ ማእድ ካዎ ኬ ገላናዉ ኦንካ ዳንዳኦና ግሾ፥ እ ካዎ ኬ ገልያ ፐንግያ ጋካናዉ ብስ። <verse eid="EST 4:2"/><verse number="3" style="v" sid="EST 4:3"/>ካዋ አዋጆይ ስኤትዳ ቢታ ኡባን አይሁደታ ግዶን ግታ ካዮይ፥ ፆም፥ ዬሆይነ ዘለልስ ዶመትስ። ኤንታፈ ዳሮት ቃስ ካዮ ማኦ ማእድ፥ ካዮታናዉ ብዶ ቦላ ኡትዶሶና።<verse eid="EST 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 4:4"/>አስትር ዳንግርፀትነ እዮ ናግያ ሹፋት ይድ፥ ማርድክዮሳባ እዉ ኦድዳ ዎደ እያ ዳሮ አዛናሱ። ማርድክዮስ ካዮ ማኡዋ ቃርድ፥ ሀራ ማኦ ማአና መላ እያዉ ማኦ የዳሱ፤ ሽን እ ኤኮና እፅስ። <verse eid="EST 4:4"/><verse number="5" style="v" sid="EST 4:5"/>ሄሳፈ ጉየ አስትራ፥ ካዎይ እዉ ኪተታና መላ ዎዳ ሀታካ ጌተትያ ሹፋ ፄጋዳ፥ ማርድክዮሳ መቶይ አይበኮ ቃስ እ አይስ ካዮትያኮ ኤራና መላ እያኮ ኪታሱ። <verse eid="EST 4:5"/><verse number="6" style="v" sid="EST 4:6"/>ሀታክ ካዎ ኬ ገልያ ፐንግያ ማታን ካታማ ዳባባን ደእያ ማርድክዮሳኮ ብስ። <verse eid="EST 4:6"/><verse number="7" style="v" sid="EST 4:7"/>ማርድክዮስ፥ ባ ቦላ ጋክዳባ ኡባ ቆንጭስድ፥ እያዉ ኦድስ። ቃስ አይሁደታ ኩመ ዉርሳናዉ ሃም ካዎ ቡቁራ ምንጅያ ኬስ እማናዉ ቆፕዳ ሚሽያ ልክያራ ኡባ አሾና ጌሽድ ኦድስ። <verse eid="EST 4:7"/><verse number="8" style="v" sid="EST 4:8"/>ሄሳ ፃላላ ግዶናሽን፥ አይሁደታ ዉርሳናዉ ሱሳ ካታማን ከይዳ አዋጆይ ፃፈትዳ ዎርቃትያ አስትርስ እማና መላነ ሀንያባ ኡባ እዉ ኦዳና መላ ኦድስ። ቃስ አስትራ ካዋኮ ገላዳ፥ ባ አሳይ ዉሮናዳ ጋናታና መላ ሀታካስ ኦድስ።<verse eid="EST 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 4:9"/>ሀታክ ይድ፥ ማርድክዮስ ግዳባ ኡባ አስትርስ ኦድስ። <verse eid="EST 4:9"/><verse number="10" style="v" sid="EST 4:10"/>አስትራ፥ ሀታካ ዛራዳ፥ ማርድክዮሳኮ ሀይሳዳ ያጋዳ ኪታሱ። <verse eid="EST 4:10"/><verse number="11" style="v" sid="EST 4:11"/>“ማጫ ግድን፥ አደ ግድን፥ ኦንካ ፄገቶና ደእሸ፥ ካዉዋራ ጋሄታናዉ ካዎ ጋስ ግዶ ዳባባ ገልኮ፥ ሀይቆ። ሽን እ ፄገቶና ካዋኮ ገልያ ዎደ ካዎይ ባ ዎርቃ ፃምኣ ፄራ እያኮ ዛሪድ በስኮ፥ ሄ ኡራ ፃላል ፓፃ አቴስ። ሀ ህግያ ካዋ ዞረይሳታፐ ብድ፥ ጮ አሳ ጋካናዉ ደእያ አስ ኡባይ ኤሬስ። ሽን ታኒ ሀስታሙ ጋላስ ግዶሳፐ ካዋኮ ገላናዉ ፄገታ ኤርከ” ያጋሱ።<verse eid="EST 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 4:12"/>ማርድክዮስ አስትራ ኪትዳ ኪታ ስእዳፐ ጉየ፥ <verse eid="EST 4:12"/><verse number="13" style="v" sid="EST 4:13"/>ሀይሳዳ ያግድ ኢኮ ኪትስ፤ “ታኒ ካዎ ጋን ደእያ ግሾ፥ ሀራ አይሁደታፐ አትሽን፥ ታና ቦችያባይ ባዋ ጋዳ ቆፖፋ! <verse eid="EST 4:13"/><verse number="14" style="v" sid="EST 4:14"/>ኔኒ ሀይሳ መላ ዎደን ስእ ጊኮ፥ አይሁደታስ ማዶይ ሀራሶፐ ያና። ኤንቲ ቱማ አታና፤ ሽን ኔንነ ነ አዋ ኬ አሳይ ሀይቃና። ኔኒ ካዎ ማቾ ግዳዳ ይዳይ ሀይሳ መላ ዎደሰኮ ኦን ኤሪ?” ያግስ።<verse eid="EST 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 4:15"/>አስትራ ማርድክዮሳኮ ሀይሳዳ ያጋዳ ዛራዳ ኪታሱ፤ <verse eid="EST 4:15"/><verse number="16" style="v" sid="EST 4:16"/>“ባዳ ሱሳ ካታማን ደእያ አይሁደታ ኡባ ሺሻ፤ ፆምድ ታዉ ዎስተ። ሄ ጋላስነ ሄ ቃም ዉራና ጋካናዉ፥ ካ ሞፕተ፤ ሃ ኡዮፕተ። ታኒ ታና ሀጋዝያ ማጫታራ ሄሳዳ ፆማና። ሄሳፈ ጉየ፥ ህግያን ድገትዳባ ግድኮካ፥ ካዎይ ደእያ በሳ ታኒ ገላና። ታኒ ሀይቅኮካ ሀይቃና” ያጋሱ።<verse eid="EST 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 4:17"/>ማርድክዮስ ብድ፥ አስትራ እያ ኪትዳይሳዳ ኡባ ኦስ።<verse eid="EST 4:17"/></para>
  <chapter eid="EST 4"/>
  <chapter number="5" style="c" sid="EST 5"/>
  <para style="s1">አስትራ ካዋ ኦይቻሱ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1"/>ፆማይ ዶመትን ሄን ጋላስ አስትራ ካዎተ ማኦ ማአዳ፥ ካዎ ጋን ግዶ ዳባባ ገላዳ ኤቃሱ። ካዎይ ካዎ ኬ ገልያ ፐንግያን ደእያ ባ አራታን ኡትስ። <verse eid="EST 5:1"/><verse number="2" style="v" sid="EST 5:2"/>አስትራ ገላዳ፥ ግዶ ዳባባን ኤቅዳሮ ካዎይ በእድ እን ኡፋይትዳ ግሾ፥ ባ ዎርቃ ፃምኣ ኢኮ ምጭስ። እያ ሺቃዳ ፃምኣ ፄራ ቦቻሱ። <verse eid="EST 5:2"/><verse number="3" style="v" sid="EST 5:3"/>ካዎይ ኢኮ፥ “ካወ አስትረ፥ ኔኒ ታኮ አይስ ያዲ? ቃስ ኔኒ ታና ኦይችያባይ አይቤ? ሀር አቶሽን ታ ካዎተፈ ባጋ ግድኮካ፥ ታ ነዉ እማና” ያግስ።<verse eid="EST 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 5:4"/>አስትራ ዛራዳ፥ “ካዋዉ፥ ነና ኡፋይስያባ ግድኮ፥ ታኒ ነዉ ጊግስዳ ግብራ ማናዉ ኔራ ሃማራ ናምአይ ሀች ኦማርስ ያኮ ዶሳይስ” ያጋሱ።<verse eid="EST 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 5:5"/>ሄሳፈ ጉየ ካዎይ፥ “ኑኒ አስትራ ጊግስዳ ግብራስ ባናዉ ሃማ ኤለስድ ኤህተ” ያግስ። ሄሳ ግሾ ናምአይ ሄ በሳ ብዶሶና። <verse eid="EST 5:5"/><verse number="6" style="v" sid="EST 5:6"/>ኤንቲ እስፈ ዎይነ ኡሻ ኡይሽን፥ ካዎይ ናምአን አስትሮ፥ “ኔኒ ታና ዎስያባይ አይቤ? ታኒ ነዉ እማና። ቃስ ኔኒ ታና ኦይችያባይ አይቤ? ሀር አቶሽን ታ ካዎተፈ ባጋ ግድኮካ፥ ታ ነ ኦይሻ ፖላና” ያግስ።<verse eid="EST 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 5:7"/>አስትራ ዛራዳ ታ ኦይቸይነ ታ ዎሰይ ሀይሳ፤ <verse eid="EST 5:7"/><verse number="8" style="v" sid="EST 5:8"/>“ካዋዉ፥ ኔኒ ታናን ኡፋይትያባ ግድኮ፥ ቃስ ታኒ ዎስያባ እማናዉነ ታ ኦይሻ ፖላናዉ ኔኒ ዶስያባ ግድኮ፥ ዎንቶ ታ ጊግስያ ሀራ ግብራስ ኔራ ሃማራ ያና መላ ኦይቻይስ። ታኒ አይ ኮያኮ ሄ ዎደ ነዉ ቆንጭሳና” ያጋሱ።<verse eid="EST 5:8"/></para>
  <para style="s1">ሃም ማርድክዮሳ ዎሳናዉ ማቅስ</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9"/>ሃም ግብራ በሳፈ ከይድ ብያ ዎደ፥ ዳሮ ኡፋይትዳ ግሾ፥ ባ ዎዛናን ኡፋይስ ኖጩ ግሸ ብስ። ሽን እ ካዎ ኬ ገልያ ፐንግያ ማታራ አድ ብያ ዎደ ያን ኡትዳ ማርድክዮሳ በእስ። እያዉ ደንድቦናይሳነ ያይድ ኮኮርቦናይሳ በእድ ሃም ይሎ ኤፅስ። <verse eid="EST 5:9"/><verse number="10" style="v" sid="EST 5:10"/>ግዶሽን፥ ባ ይሉዋ ዳንዳእድ ብድ ባ ሶ ጋክስ።</para>
  <para style="p" vid="EST 5:10">ሄሳፈ ጉየ፥ ባ ላገታነ ባ ማችዉ ዞሳራ ፄግስድ፥ <verse eid="EST 5:10"/><verse number="11" style="v" sid="EST 5:11"/>ሃም ባ ዱረተ ልክያ፥ ባ አደ ናይታ ታይቡዋ፥ ካዎይ ባና ቦንችዳ ቦንቹዋነ ሀራ ሀላቃታፐነ ካዎ ሞርናታፐ አያ ሹማተ እምድ፥ ዋትድ እያ ቦንችዳኮ ናሸትስ። <verse eid="EST 5:11"/><verse number="12" style="v" sid="EST 5:12"/>ጉጅድካ ሃም፥ “ሀር አቶሽን ካውያ አስትራካ ባ ጊግስዳ ግብራስ ካዉዋራ ባና መላ ታፐ አትሽን፥ ሀራ ኦናካ ፄጋቡኩ። ቃስ ዎንቶካ ካዉዋራ ባና መላ ታና ፄጋሱ። <verse eid="EST 5:12"/><verse number="13" style="v" sid="EST 5:13"/>ሽን አይሁደ ግድዳ ማርድክዮስ ካዎ ኬ ገልያ ፐንገን ኡትዳይሳ በእያ ዎደ ሀ ኡባይካ ታና ኡፋይሰና” ያግስ።<verse eid="EST 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 5:14"/>ሄ ዎደ እያ ማችያ ዞሳራነ እያ ላገት ኡባይ ሀይሳዳ ያግዶሶና፤ “ኔኒ እሻታሙ ዋ ም ኤስሳዳ ዎንቶ ጉራ ማርድክዮስ ካቀታና መላ ካዋ ኦይቻ። ሄሳፈ ጉየ፥ ኡፋይታሸ ግብራ ማናዉ ባ” ያግዶሶና። ሃማ ሀ ቆፋይ ኡፋይስዳ ግሾ፥ ኤንቲ ግዳይሳዳ ካቃ ም ጊግስስ።<verse eid="EST 5:14"/></para>
  <chapter eid="EST 5"/>
  <chapter number="6" style="c" sid="EST 6"/>
  <para style="s1">ማርድክዮስ ቦንቸትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1"/>ሄ ዎደ ቃማ ካዋ ስኮይ ኤኮና እፅስ። ሄሳ ግሾ፥ ካዎይ ካዎ ታርከ ፃፍያ ማፃፋ ኤህድ፥ ካሰ ሀንዳ ታርከታ እያዉ ናባባና መላ ኪትስ። <verse eid="EST 6:1"/><verse number="2" style="v" sid="EST 6:2"/>ናባበትዳ ታርከታፐ እሶይ ማርድክዮስ ኦዳባ። ሄስካ፥ ካዎይ ደእያ ክፍልያ ናግያ፥ ጋባታነ ታራ ጌተትያ ናምኡ ሹፋት ካዋ ዎናዉ ማቅዳ ማቁዋ ማርድክዮስ ቆንጭስስ። <verse eid="EST 6:2"/><verse number="3" style="v" sid="EST 6:3"/>ካዎይ፥ “ያትን፥ እ ሄሳ ኦዳ ግሾ እያዉ እመትዳ ሹማተይ ዎይኮ ዎይቶይ አይቤ?” ያግስ።</para>
  <para style="p" vid="EST 6:3">ካዋ አይለት ዛሪድ፥ “እያዉ አይኮይ ኦሰትቤና” ያግዶሶና።<verse eid="EST 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 6:4"/>ካዎይ ዛሪድ፥ “ካረ ዳባባን ደኤይ ኦኔ?” ያግስ። ሄ ዎደ ባ ጊግስዳ ምን ማርድክዮሳ ካቃናዉ፥ ካዋ ኦይቻናዉ፥ ሃም ካረ ዳባባ ገልሸ ደኤስ።<verse eid="EST 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 6:5"/>ካዋ አይለት፥ “ሃም ካረ ዳባባን ኤቅስ” ያግዶሶና።</para>
  <para style="p" vid="EST 6:5">ካዎይ ዛሪድ፥ “ሃ ገላ ጊተ” ያግስ።<verse eid="EST 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 6:6"/>ሃም ገልዳፐ ጉየ ካዎይ፥ “ካዎይ ቦንቻናዉ ዶስያ አሳስ አይ ኦናዉ ኮሺ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="EST 6:6">ሃም፥ “ካዎይ ታፐ ሀራ ኦና ቦንቻናዉ ዶሲ?” ያግድ ባ ዎዛናን ቆፕስ። <verse eid="EST 6:6"/><verse number="7" style="v" sid="EST 6:7"/>ሄሳ ግሾ፥ ሃም ካዋስ ያግድ ዛርስ፤ “ካዎይ ቦንቻናዉ ዶስያ አሳስ፥ <verse eid="EST 6:7"/><verse number="8" style="v" sid="EST 6:8"/>ካዎይ ባ ካዎተ ማኡዋ ኤህሶ፤ ባ ቶግያ ፓራ ሁጰን ጉቸ ዎ። <verse eid="EST 6:8"/><verse number="9" style="v" sid="EST 6:9"/>ሄሳፈ ጉየ፥ ካዎይ ባ ሞርናታፐ እስ ዳሮ ቦንቸትዳይሳ ፄግስድ፥ ካዎተ ማኦ እያ ማይዛናዳነ ካዋ ፓራ ቦላ እያ ኡትስድ፥ ካታማ ዳባባ ከሳናዳ ኪቶ። ያትኮ ሄ ዳሮ ቦንቸትዳ ሞርናይ እያ ስንን ሄመትሸ፥ ‘ካዎይ ቦንቻናዉ ዶስያ ኡራስ ሀይሳዳ ኦስ’ ያግድ አዋጆ” ያግስ።<verse eid="EST 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 6:10"/>ካዎይ ዛሪድ፥ ሃማ ሀይሳዳ ያግድ ኪትስ፤ “ህዛ ኤለሳ ደንዳዳ ካዎተ ማኡዋነ ታ ፓራ ኤካዳ፥ ነ ግዳይሳዳ አይሁደ ግድዳ ማርድክዮሳስ ኦ። እ ካዎ ኬ ገልያ ፐንገን ደኤስ። ነ ግዳይሳፈ እስባካ አሾፋ” ያግስ።<verse eid="EST 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 6:11"/>ሄሳ ግሾ፥ ሃም ማርድክዮሳ ካዎተ ማኦ ማይዝድ፥ ካዋ ፓራ ቦላ ኡትስስ። ቃስ ካታማ ዳባባን እያፐ ስንራ ሄመትሸ፥ “ካዎይ ቦንቻናዉ ዶስያ ኡራስ ሀይሳዳ ኦስ” ያግድ አዋጅስ።<verse eid="EST 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 6:12"/>ሄሳፈ ጉየ፥ ማርድክዮስ ካዎ ኬ ፐንገ ጉየ ስሚድ ብስ። ሽን ሃም ዳሮ አዛንዳ ግሾ፥ ጉሉንትድ፥ ኤለስሸ ባ ሶ ብስ። <verse eid="EST 6:12"/><verse number="13" style="v" sid="EST 6:13"/>ባና ጋክዳባ ኡባ ባ ማቸ ዞሳርስነ ባ ላገታስ ኦድስ። ኤንቲ እያኮ፥ “እያ ስንን ኔኒ ካዉያናዉ ዶምዳ ሀ አደይ፥ ማርድክዮስ፥ አይሁደ አስ ግድኮ፥ ነ እያራ ኤቀታዳ፥ እያ ፆናናዉ ዳንዳአካ፤ ቱማ እ ነና ይሳና” ያግዶሶና።<verse eid="EST 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 6:14"/>ኤንቲ ቡሮ ሄሳ ኦደትሽን፥ ካዋ ሹፋት ጋክድ፥ ሃማ አስትራ ጊግስዳ ግብራስ ኤለስድ ኤፍዶሶና።<verse eid="EST 6:14"/></para>
  <chapter eid="EST 6"/>
  <chapter number="7" style="c" sid="EST 7"/>
  <para style="s1">ሃም ካቀትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 7:1"/>ካዎይነ ሃም አስትር ግብራ ማናዉ ብዶሶና። <verse eid="EST 7:1"/><verse number="2" style="v" sid="EST 7:2"/>ሄ ናምአን ጋላስ ግብራስ ብድ፥ ኤንቲ ዎይነ ኡሻ ኡይሽን፥ ካዎይ፥ “ካወ አስትረ፥ ኔኒ ዎስያባይ አይቤ? ታኒ ነዉ እማና። ኔኒ ታና ኦይችያባይ አይቤ? ሀር አቶሽን ታ ካዎተፈ ባጋ ግድኮካ፥ ታኒ ነ ኦይሻ ፖላና” ያግድ ኦይችስ።<verse eid="EST 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 7:3"/>ካውያ አስትራ ዛራዳ፥ “ካዋዉ፥ ኔኒ ታናን ኡፋይትዳባ ግድኮ፥ ቃስ ታ ኦይሻካ ፖላናዉ ዶስያባ ግድኮ፥ ታ ዎሳይነ ታ ኦይሻይ ታነ ታ አሳይ ሀይቆና አታና መላሳ። <verse eid="EST 7:3"/><verse number="4" style="v" sid="EST 7:4"/>ታነ ታ አሳይ እሶይካ አቶና ኡባይ ሀይቆስ ባይዘትዳ። ኑኒ ባይዘትዳይ ማጫ አይለነ አደ አይለ ግድድ ደአናሳ ግድያኮ፥ ታኒ ስእ ጋና። ሄሳ መላ መቶይ ካዋ ዋይሳናዉ በሲያባ ግደና” ያጋሱ።<verse eid="EST 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 7:5"/>ካዎይ አርፀክስስ ዛሪድ፥ “ሄሳ ኦናዉ ፃልታምዳይ ኦኔ? እ ሄ አደይ አዉን ደኢ?” ያግድ ካውዉ አስትሮ ኦይችስ።<verse eid="EST 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 7:6"/>አስትራ፥ “ኑ ሞርከይ፥ ኑና ይሳናዉ ኮየይ፥ ሀ ኢታ አድያ ሃማ” ያጋሱ።</para>
  <para style="p" vid="EST 7:6">ሄ ዎደ ሃም ካዋ ስንንነ ካወ ስንን ዳሮ ዳጋምስ። <verse eid="EST 7:6"/><verse number="7" style="v" sid="EST 7:7"/>ካዎይ ዳሮ ሀንቀትድ፥ ባ ኡትዳ በሳፈ ደንድ፥ ካዎ ጋ አታክልተ በሳ ብስ። ሽን ሃም ካዎይ እያ ቦላ ኢታባ ኤሀናዉ ቆፕዳይሳ ኤርዳ ግሾ፥ አስትራ እያ ሀይቆፐ አሻና መላ ዎሳናዉ ጉየ አትስ።<verse eid="EST 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 7:8"/>ካዎይ አታክልተ በሳፈ ስሚድ ገልያ ዎደ፥ ሃም ካዊዉ አስትሮ ማሮታ ዎሳናዉ፥ እያ ኡትዳ አርሳ ቦላ ጉፋንዳይሳ በእስ። ካዎይ ይሎ ኤፅድ፥ ባ ቃላ ቁ ኦድ፥ “ላ ሀ አደይ ሀይሳን ካዎ ኬን፥ ታ ስንን፥ ካውዉ ካዉሻናዉ ኮይዬ?” ያግስ።</para>
  <para style="p" vid="EST 7:8">ካዎይ ቡሮ ሄሳ ሃሳይሽን፥ ካዎ ሹፋት ይድ፥ ሃማ ሶምኡዋ ጎዝዶሶና። <verse eid="EST 7:8"/><verse number="9" style="v" sid="EST 7:9"/>ኤንታፈ እሶይ፥ ሀርቦና ጌተትያ ሹፋይ፥ “ካዋዉ፥ ሃም ነና ሀይቆፐ አሽዳ ማርድክዮሳ ካቃናዉ ኤስዳ እሻታሙ ዋ ም እያ ሶን ደኤስ” ያግስ።</para>
  <para style="p" vid="EST 7:9">ካዎይ ዛሪድ፥ “ሃማ ኤፍድ፥ ሄ ምን ካቅተ” ያግድ ኪትስ።<verse eid="EST 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 7:10"/>ሄሳ ግሾ፥ ማርድክዮሳ ካቃና ግድ ጊግስዳ ምን ሃም ካቀትስ። ሄሳፈ ጉየ፥ ካዋ ሀንቆይ ዶችስ።<verse eid="EST 7:10"/></para>
  <chapter eid="EST 7"/>
  <chapter number="8" style="c" sid="EST 8"/>
  <para style="s1">አይሁደታ ግሾ ከይዳ አዋጆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1"/>አይሁደታ ሞርከይ ሃም ካቀትዳ ጋላስ ካዎይ አርፀክስስ ሃማ ሻሉዋ ኡባ ካወ አስትርስ እሚስ። ቃስ ማርድክዮስ እዉ ማታ ዳቦ ግደይሳ አስትራ ካዋስ ኦዳሱ። ሄሳ ግሾ፥ ሄ ዎደፐ ዶምድ፥ ማርድክዮስ ካዋኮ ገላናዉ ዳንዳእስ። <verse eid="EST 8:1"/><verse number="2" style="v" sid="EST 8:2"/>ካዎይ ሃማፐ ጉየ ኤክዳ ባ ምግዶ ማታምያ ከስድ፥ ማርድክዮሳስ እሚስ። አስትራ ማርድክዮሳ ሃማ ሻሉዋ ቦላ አዋያዳ ሹማሱ።<verse eid="EST 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 8:3"/>ሄሳፈ ጉየ፥ አስትራ ዬካሸ፥ ካዋ ቶሆ ቦላ ኩንዳዳ፥ አጋጋ ኮቸ ግድዳ ሃም አይሁደታ ቦላ ቱክዳ ኢታ ማቆይ ኦሶን ፔኦና መላ ካዋ ዎሳሱ። <verse eid="EST 8:3"/><verse number="4" style="v" sid="EST 8:4"/>ያትን፥ ካዎይ ባ ዎርቃ ፃምኣ እዉ ምጭን፥ እያ ደንዳ ኤቃዳ፥ <verse eid="EST 8:4"/><verse number="5" style="v" sid="EST 8:5"/>“ካዋዉ፥ ኔኒ ታናን ኡፋይትዳባ ግድኮ፥ ቃስ ታ ኦይሻካ ፖላናዉ ኔኒ ዶስዳባ ግድኮ፥ ነ ካዎተ ግዶን ደእያ አይሁደ ኡባ ኩመ ዎና መላ፥ አጋጋ ኮቸ ግድዳ ሀማዳታ ናአይ ሃም ከስዳ አዋጁዋ ሻርያ ሀራ አዋጆ ከሳናዳ ዎሳይስ። <verse eid="EST 8:5"/><verse number="6" style="v" sid="EST 8:6"/>ሀ ኡባ ዮይ ታ አሳ ቦላነ ታ ዳቦታ ቦላ ጋክያ ዎደ ታኒ ስእ ጋዳ ዋና ፄሎ?” ያጋሱ።<verse eid="EST 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 8:7"/>ሄሳፈ ጉየ፥ ካዎይ አርፀክስስ፥ ካውዉ አስትሮነ አይሁደ ግድዳ ማርድክዮሳ ሀይሳዳ ያግስ፤ “ሃም አይሁደታ ዎናዉ አዋጆ ከስዳ ግሾ፥ ታኒ ምን እያ ካቅስዳይሳነ እያ ሻሉዋ ኡባ ካወ አስትርስ እምዳይሳ ህንተ ኤሬታ። <verse eid="EST 8:7"/><verse number="8" style="v" sid="EST 8:8"/>ግዶሽን፥ ካዎ ጋ ማታመ ዎን፥ ካዋ ሱንን ከይዳ አዋጆይ ላመታናዉ ዳንዳኤና። ሄሳ ግሾ፥ ህንተ ህንተ ባጋራ አይሁደታ ማዳናዉ ኮይዳባ ፃፍተ። ሄሳ ታ ሱንን ፃፍድ፥ ካዎ ማታምያ እያ ቦላ ዎተ” ያግስ።<verse eid="EST 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 8:9"/>ንሳነ ጌተትያ ሄን አጌናን፥ ላታማነ ሄን ጋላሳን፥ ማርድክዮስ ካዋ ፃፈታ ኡባ ፄግድ፥ ህንደፈ ብድ ቶጰ ጋካናዉ ደእያ ፄታነ ላታማነ ላፑን ቢታታን ካዎፐ ጋርሳራ ሃረይሳታስ፥ አዉራጃ አይሰይሳታስነ ቢታ ሀላቃታስ የድያ አዋጆ ፃፍስስ። አዋጆይ ዱማ ዱማ ዶናንነ ዱማ ዱማ ፕዳለን ፃፈትስ፤ ቃስ አይሁደታስካ ኤንታ ዶናንነ ኤንታ ፕዳለን ፃፈትስ። <verse eid="EST 8:9"/><verse number="10" style="v" sid="EST 8:10"/>ማርድክዮስ ሄ አዋጁዋ ኡባ ካዋ አርፀክስሳ ሱንን ፃፍስድ፥ ካዎ ማታመ ዎድ፥ ካዎ ጋፃታን ከትዳ፥ ኤሶትያ ፓራታ ቶግያ አሳታ ቦላ ቢታ ኡባ የድስ።<verse eid="EST 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 8:11"/>ካዎይ ከስዳ አዋጆይ፥ ካታማታን ደእያ አይሁደት እስፈ ሺቃናዉነ ባንታ ቦላ ያባ ኦለትድ ዛራናዉ ዳንዳአና መላ ማታ እሜስ። ቃስ ኦላ ሚሽያ ኦይክድ፥ አይ ቢታፈካ፥ ኤንታ ኦላናዉ የይሳታ፥ ኤንታ ናይታራነ ኤንታ ማቸታራ ኡባ እሱዋካ አሾና ዎናዉነ ኤንታ ሻሉዋ ቦንቅድ ኤካናዉ ማታ እሜስ። <verse eid="EST 8:11"/><verse number="12" style="v" sid="EST 8:12"/>አይሁደት ካዋ አርፀክስሳ ካዎተን ሄሳ ኦናዉ ቃችዳ ጋላሳይ፥ አዳረ ጌተትያ ታማነ ናምአን አጌናን፥ ታማነ ሄን ጋላሳና። <verse eid="EST 8:12"/><verse number="13" style="v" sid="EST 8:13"/>ካዋ አዋጁዋ ቢታታ ኡባን ደእያ አሳይ ኤራናዳ፥ ህገ ግድድ አዋጀትስ። ሄስካ አይሁደት ባንታ ሞርከታ ቦላ ሀሎ ከያናዉ ባንታና ጊግሳናዉ ዳንዳእሴስ። <verse eid="EST 8:13"/><verse number="14" style="v" sid="EST 8:14"/>ኪተተይሳት ካዎ ኬ ፓራታ ቶግድ፥ ካዋ ኪታ ጋናዉ ኤለስድ ብዶሶና። ቃስ ሱሳ ካታማን ሀ አዋጆይ አሳ ኡባስ ኦደትስ።<verse eid="EST 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 8:15"/>ማርድክዮስ ካሎሰነ ቦ ካዎተ ማኦ ማእድ፥ ኦቻ ቴራ ዳንያነ ሊኖፐ ኦሰትዳ ካባ ቦላራ ማእስ፤ ቃስ ግታ ዎርቃ ካላቻ ዎድ፥ ካዋ ስንፈ ከይስ። ሱሳ ካታማይ እልልሳንነ ኡፋይሳን ኖጩ ግስ። <verse eid="EST 8:15"/><verse number="16" style="v" sid="EST 8:16"/>ሄስ አይሁደታስ ግታ ኡፋይስ፥ እልልስነ ቦንቾ ዎደ ግድስ። <verse eid="EST 8:16"/><verse number="17" style="v" sid="EST 8:17"/>ሄሳ ግሾ፥ ካዋ አዋጆይ ናባበትዳ ቢታንነ ካታማ ኡባን ደእያ አይሁደት ግታ ባኣለ ከስድ፥ ኡፋይትሸነ ግብራ ምሸ ፔእዶሶና። ሄሳ ጋሶን አይሁደታስ ያይድ፥ ያን ደእያ ሀራ ዛረ አሳፐ ዳሮት አይሁደ ግድዶሶና።<verse eid="EST 8:17"/></para>
  <chapter eid="EST 8"/>
  <chapter number="9" style="c" sid="EST 9"/>
  <para style="s1">አይሁደታ ፆኑዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1"/>አዳረ ጌተትያ ታማነ ናምአን አጌናን ታማነ ሄን ጋላሳይ ጋክስ። ሄ ጋላስ፥ ካዎይ ኮይሮ ከስዳ አዋጁዋ ማራን ሞርከት አይሁደታ ፆናና ግዳ ቆፕዳ ጋላሳ። ሽን ኦዳይ ሽረት ዎን፥ አይሁደት ባንታ ሞርከታ ፆንዶሶና። <verse eid="EST 9:1"/><verse number="2" style="v" sid="EST 9:2"/>ካዋ አርፀክስሳ ካዎተን ደእያ አይሁደት ኡባይ ባንታና ቆሀናዉ ኮይያ ኡባ ይሳናዉ ባንታ ካታማን ካታማን እስፈ ሺቅዶሶና። ሀራ ዛረ ግድዳ አሳይ ኤንታዉ ያይዳ ግሾ፥ ኤንታራ አይ አስካ ኤቀታናዉ ዳንዳእቤና። <verse eid="EST 9:2"/><verse number="3" style="v" sid="EST 9:3"/>ኤንቲ ማርድክዮሳስ ያይዳ ግሾ፥ ካዎፐ ጋርሳራ ቢታ ሃረይሳት፥ አዉራጃ አይሰይሳትነ ቢታ ሀላቃት ኡባይ አይሁደታ ማድዶሶና። <verse eid="EST 9:3"/><verse number="4" style="v" sid="EST 9:4"/>ማርድክዮስ ካዎ ጋን ግታ ማት እመትዳነ ዎልቃን ጉጅ ጉጅ ብያ አስ ግደይስ ሄ ካዎተን ደእያ ቢታ ኡባን ኤረትስ።<verse eid="EST 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 9:5"/>ሄ ጋላስ አይሁደት ባንታ ሞርከታ ኡባ ማሻን ጎይርድ ዉርስዶሶና፤ ባንታና እፅያ ኡባ ቦላ ኮይዳባ ኦዶሶና። <verse eid="EST 9:5"/><verse number="6" style="v" sid="EST 9:6"/>ዋና ካታማ ግድዳ ሱሳ ፃላላን እቻሹ ፄቱ አሳ ዎዶሶና። <verse eid="EST 9:6"/><verse number="7" style="v" sid="EST 9:7"/>ኤንቲ ፓርሻንዳታ፥ ዳልፎና፥ አስፓታ፥ <verse eid="EST 9:7"/><verse number="8" style="v" sid="EST 9:8"/>ፖራታ፥ አዳላ፥ አርዳታ፥ <verse eid="EST 9:8"/><verse number="9" style="v" sid="EST 9:9"/>ፓርማሽታ፥ አርሳያ፥ አርዳያነ ዋይዛታ ዎዶሶና። <verse eid="EST 9:9"/><verse number="10" style="v" sid="EST 9:10"/>ኤንቲ አይሁደታ ሞርከ ግድዳ ሃማ ናይታ። ሽን ኤንቲ ኤንታ ሻሉዋ ቦንቅቦኮና።<verse eid="EST 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 9:11"/>አይሁደት ሱሳ ካታማን ዎዳ አሳ ታይቦይ አፑነኮ ሄ ጋላስ ካዋስ ኦደትስ። <verse eid="EST 9:11"/><verse number="12" style="v" sid="EST 9:12"/>ያትን፥ ካዎይ ካውዉ አስትሮ፥ “አይሁደት ዋና ካታማ ግድዳ ሱሳ ፃላላን እቻሹ ፄቱ አሳነ ታሙ ሃማ ናይታ ዎዶሶና። ሄስ ሄሳ ግድኮ፥ ካዋ ቢታታን ኤንቲ ዎዳይ አፑና ግዳንደሻ! ቃስ ሀእ ኔኒ ዎስያባይ አይቤ? ታኒ ነዉ እማና። ኔኒ ታና ኦይችያባይ ሀራባይ አይቤ? ታኒ ነዉ ፖላና” ያግስ።<verse eid="EST 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 9:13"/>አስትራ ዛራዳ፥ “ካዋ ሀ ቆፋይ ኡፋይስኮ፥ ሱሳ ካታማን ደእያ አይሁደት ሀች ኦዳይሳዳ ዎንቶካ ኦ። ቃስ ታሙ ሃማ ናይታ አሃ ም ቦላ ካቃናዳ ኪታ” ያጋሱ።<verse eid="EST 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 9:14"/>ካዎይ ሄሳ ኦና መላ ኪትስ። አዋጆይ ሱሳ ካታማን ናምአን አዋጀትን፥ ታሙ ሃማ ናይታ አሀይ ኮጫ ቦላ ካቀትስ። <verse eid="EST 9:14"/><verse number="15" style="v" sid="EST 9:15"/>አዳረ ጌተትያ አጌናን ታማነ ኦይዳን ጋላሳን፥ ሱሳ ካታማን ደእያ አይሁደት እስፈ ሺቅድ፥ ሀራ ሄ ፄቱ አሳ ዎዶሶና፤ ሽን ሀእካ ኤንታ ሻሉዋ ቦንቅቦኮና።<verse eid="EST 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 9:16"/>ሄ ዎደ ሱሳ ካታማፐ ጋፃራ ደእያ ካዋ ቢታታን ደእያ አይሁደት እስፈ ሺቅድ፥ ባንታ ሞርከታ ኡባ ኦልዶሶና። ኤንቲ ላፑን ታማነ እቻሹ ሙኩሉ አሳ ዎዳፐ ጉየ ባንታ ሞርከታፐ ሸምፕዶሶና። ሽን ኤንታ ሻሉዋ ቦንቅቦኮና። <verse eid="EST 9:16"/><verse number="17" style="v" sid="EST 9:17"/>ሀይስ ኡባይ ሀንዳይ አዳረ ጌተትያ አጌናን ታማነ ሄን ጋላሳና። ታማነ ኦይዳን ጋላሳን ኤንቲ ሸምፕዶሶና፤ ግብራ ምሸ፥ ኡይሸነ ኡፋይትሸ ፔእያ ጋላስ ኦዶሶና።<verse eid="EST 9:17"/></para>
  <para style="s1">ፑርማ ባኣለ</para>
  <para style="p">
    <verse number="18" style="v" sid="EST 9:18"/>ሽን ሱሳ ካታማን ደእያ አይሁደት ታማነ ሄንነ ታማነ ኦይዳን ጋላሳን ዎሸ ፔእድ፥ ታማነ እቻሻን ጋላሳን ሸምፕዶሶና። ኤንቲ ሄ ጋላሳ ምሸ፥ ኡይሸነ ኡፋይትሸ ፔእያ ጋላስ ኦዶሶና።<verse eid="EST 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EST 9:19"/>ሄሳ ግሾ፥ ጉ ካታማታን ደእያ አይሁደት ሀች ጋካናዉ አዳረ ጌተትያ አጌናን ታማነ ኦይዳን ጋላሳ ባኣለ ጋላስ ኦድ ቦንቾሶና። ሄ ጋላሳን ሞሶናነ ኡዮሶና፤ ቃስ እሶይ እሱዋስ እሞታ እሞሶና። <verse eid="EST 9:19"/><verse number="20" style="v" sid="EST 9:20"/>ማርድክዮስ ሀ ሀንዳ ታርከ ኡባ ፃፍድ፥ ካዋ አርፀክስሳ ቢታ ኡባን፥ ሃሆንነ ማታን ደእያ አይሁደ ኡባስ የድስ። <verse eid="EST 9:20"/><verse number="21" style="v" sid="EST 9:21"/>ሄ ዳብዳብያን ማርድክዮስ አዳረ አጌናን ታማነ ኦይዳንነ ታማነ እቻሻን ጋላሳታ፥ አይሁደት ላይን ላይን ባኣለ ጋላስ ኦድ ቦንቻና መላ ኤንታዉ ኦድስ። <verse eid="EST 9:21"/><verse number="22" style="v" sid="EST 9:22"/>ሄ ጋላሳት አይሁደት ባንታ ሞርከታፐ ሸምፖ ደምዳ ጋላሳታ። ቃስ ሄ አጌናይ ኤንታ አዛኖይነ ዬሆይ ኡፋይሳንነ ግብራ ሙሳን ላመትዳ አጌና። ሄሳ ግሾ፥ ኤንቲ ሙሳንነ ኡሻን ኡፋይትሸ፥ እሶይ እሱዋስነ ማንቆታስ ካ እሞታ እምሸ ቦንቻና መላ ኤንታዉ ኦድስ።<verse eid="EST 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EST 9:23"/>አይሁደት ማርድክዮስ እምዳ ኪታ ኤክድ፥ ኤንቲ ቦንቻናዉ ዶምዳ ባልያ፥ ላይን ላይን አጎና ቦንቻናዉ ማእዶሶና። <verse eid="EST 9:23"/><verse number="24" style="v" sid="EST 9:24"/>አጋጋ ኮቻይ፥ ሀማዳታ ናአይ ሃም፥ አይሁደታ ኡባ ሞርከይ፥ ኤንታ ይሳናዉ ካሰ ማቀትድ ኤንታ ዎያ አጌናነ ጋላሳ ኤራናዉ ፑርማ ጌተትያ ሳማ የግስስ። <verse eid="EST 9:24"/><verse number="25" style="v" sid="EST 9:25"/>ሽን አስትራ ካዋኮ ገልዳፐ ጉየ፥ ሃም አይሁደታ ቦላ ማቅዳ ኢታ ማቆይ ኡባይ ጉየ ስሚድ፥ እያ ቦላ ፖለታናዳ ካዎይ ፁፈን ኪትስ። ያትን፥ ሃምነ እያ ታሙ ናይት አሀይ ምን ካቀትስ <verse eid="EST 9:25"/><verse number="26" style="v" sid="EST 9:26"/>ሄሳ ግሾ፥ ሀ ናምኡ ጋላሳት ፑርማ ባኣለ ጌተቶሶና። ሀ ዳብዳብያን ኤንታዉ ፃፈትዳባ ኡባ ጋሶን፥ ኤንቲ ባንታ አይፈን በእዳባ ጋሶንነ ኤንታ ቦላ ጋክዳባ ጋሶን <verse eid="EST 9:26"/><verse number="27" style="v" sid="EST 9:27"/>አይሁደት ባንታዉ፥ ባንታ ኮቻታስነ አይሁደ ግዳናዉ ኮይያ ኡባስ፥ ሀ ባልያ ዎጋ ኦድ ቦንችዶሶና። ሄስካ ላይን ላይን አጎና ሀ ናምኡ ጋላሳታ ቦንቻና መላሳ። <verse eid="EST 9:27"/><verse number="28" style="v" sid="EST 9:28"/>ሄ ጋላሳት የለታ ኡባን፥ ካታማታ ኡባን፥ አይሁደታ ኬ ኡባንነ ቢታ ኡባን ቦንቸታና መላ ቃሸትስ። ሄስካ፥ አይሁደት አዉደ ግድኮካ፥ ሀ ፑርማ ጋላሳታ ቦንቻናዉነ ሄ ጋላሳታን ሀንዳባይ ኤንታ ኮቻን ዶገቶና መላ ቆፓናዉ በሴስ።<verse eid="EST 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EST 9:29"/>ሄሳፈ ጉየ፥ አብካላ ናእያ፥ ካውያ አስትራነ አይሁደ አደይ ማርድክዮስ፥ ፑርማ ባልያባ ካሰ ፃፍዳ ዳብዳብያ ምንናዉ ሀይሳ ናምአን ዳብዳብያ ኩመ ማታን ፃፍዶሶና። <verse eid="EST 9:29"/><verse number="30" style="v" sid="EST 9:30"/>ሄ ዳብዳበት አርፀክስሳ ካዎተን፥ ፄታነ ላታማነ ላፑን ቢታን ደእያ አይሁደታ ኡባስ ሳሮይነ ዎፓተ ግዶ ግያ ሳሮታራ ፃፈትድ ኪተትዶሶና። <verse eid="EST 9:30"/><verse number="31" style="v" sid="EST 9:31"/>ቃስ ኤንቲ ካሰ ፆማናዉነ ካዮታናዉ ዎጋ ከስዳይሳዳ፥ ሀእ ኤንታ ግድን፥ ስንፈ ያና ኤንታ ኮቻታ ግድን፥ ሀ ፑርማ ጋላሳታ ላይን ላይን ዎጋ ኦድ ቦንቻና መላ ሄ ዳብዳበት ቆንጭሶሶና። ሄስ አይሁደ አደይ ማርድክዮስነ ካውያ አስትራ እስፈ ዞረትድ ከስዳ ኪታ። <verse eid="EST 9:31"/><verse number="32" style="v" sid="EST 9:32"/>ካወ አስትር ኪታይ ፑርማ ባኣለ ዎጋ ምንስ፤ እካ ማፃፋን ፃፈትስ።<verse eid="EST 9:32"/></para>
  <chapter eid="EST 9"/>
  <chapter number="10" style="c" sid="EST 10"/>
  <para style="s1">ማርድክዮሳ ግታተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1"/>ካዎይ አርፀክስስ ባ ካዎተን ጋፃፐ ጋፃ ጋካናዉ ደእያ አሳ ኡባይ ጊራ ቃንፃና መላ ዎልቃን ኪትስ። <verse eid="EST 10:1"/><verse number="2" style="v" sid="EST 10:2"/>እ ኦዳ ግታነ ማላልስያ ኦሶት ኡባይ፥ ማርድክዮሳካ ቁ ኦድ ዋት ቦንችዳኮ ቆንጭስያ ታርከይ ሜዶናነ ፋርሰ ካዎተ ታርከ ማፃፋን ፃፈትስ። <verse eid="EST 10:2"/><verse number="3" style="v" sid="EST 10:3"/>ማታን ግድኮ፥ ማርድክዮስ ካዋ አርፀክስሳፐ ናምአን። እ አይሁደታንካ ዳሮ ቦንቸትዳነ ዶሰትዳ አስ። እ ባ አሰ ግድዳ አይሁደት፥ ሳሮተንነ ህርግ ባይና ዳና መላ ዳሮ ዳቡርዳ አስ።<verse eid="EST 10:3"/></para>
  <chapter eid="EST 10"/>
</usx>
