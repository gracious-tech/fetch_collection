<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ማርቆሳ ዎንገላ</para>
  <para style="toc1">ማርቆሳ ዎንገላ</para>
  <para style="toc3">ማር</para>
  <para style="toc2">ማርቆሳ</para>
  <para style="mt1">ማርቆስ ፃፍዳ</para>
  <para style="mt2">የሱስ ክርስቶሳ ዎንገላ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ማርቆሳ ዎንገላይ ኮይሮ ዶምሸ፥ “ሀይስ ፆሳ ናኣ የሱስ ክርስቶሳ ዎንገላ ዶመ” ያጌስ። ሀ ዎንገላን የሱሲ ኦሶ አስነ ማታ አዋ ግድድ በንቴስ። እያ ማታይ፥ እያ ትምርትያን፥ ቱና አያና ቦላ ደእያ ዎልቃንነ አሰ ናጋራፐ ማሮን ቆንጭድ ኤረትስ። የሱሲ፥ “ታኒ፥ አሰ ናጋራ አይለተፈ ከሳናዉ ታ ሸምፑዋ አዳ እማናዉ ይዳ አሳ ናኣ” ያግድ ባ ዶናን ኦድስ።</para>
  <para style="ip">ማርቆስ የሱሳ ታርክያ ሱረነ ዎልቃራ ደእያ ኦገን ኦድስ። ማርቆስ የሱሳ ቃላነ ትምርትያ ግዶናሽን፥ እ ኦዳ ማላልስያ ኦሶታ ባይራይድ ኦዴስ። ማርቆስ ፃማቅያ ዮሃንሳ ታርክያ፥ የሱሳ ፅንቃትያ፥ እያ ፓጨተ፥ እያ ትምርትያነ እ አሰ ፓዳ ኦገታ ዳልግስድ ኦዴስ። አቅ አቅ ብሽን የሱሳ ታማረት፥ የሱሳ ጉጅድ ኤር ኤር ብዶሶና፥ ሽን የሱሳ እፀይሳት አድ እፅሸ ብዶሶና። ማፃፋ ዉርሰ ሸምፖት ዉርሰ ሳምንታን፥ የሱሳ ደኦን ፖለትዳ ኦሶታ፥ ሄሳትካ እያ ካቀተነ እያ ደንዱዋ ኦዶሶና።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ዎንገላ ዶመ (<char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref></char>)</para>
  <para style="io1">የሱሲ ባ ኦሱዋ ጋልላን ዶምስ (<char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref></char>)</para>
  <para style="io1">የሱሲ የሩሳላመን ኦዳ ኦሱዋ (<char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref></char>)</para>
  <para style="io1">የሩሳላመ ሄራን አዳ ዉርሰ ሳምንታ (<char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref></char>)</para>
  <para style="io1">የሱሲ ሀይቆፐ ደንዱዋ (<char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref></char>)</para>
  <para style="io1">ሀይቆፐ ደንድድ አሳስ በንቶነ ሳሎ ቡሱ (<char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref></char>)</para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">ፃማቅያ ዮሃንስ ኦገ ፕተ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ 3:1-12</ref>፤ <ref loc="LUK 3:1-18">ሉቃ 3:1-18</ref>፤ <ref loc="JHN 1:19-28">ዮሀ 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>ሀይስ ፆሳ ናአ የሱስ ክርስቶሳ ዎንገላ ዶመ። <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>ናብያ እሳያስ ፃፍዳ ማፃፋን ፆሳይ፥</para>
  <para style="q1" vid="MRK 1:2">“ሄኮ፥ ታኒ ታ ኪታንቹዋ</para>
  <para style="q2" vid="MRK 1:2">ታኒ ኔፐ ስን የዳና።</para>
  <para style="q1" vid="MRK 1:2">እ ነ ኦግያ ጊግሳና።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ምልክ 3:1</ref>.</char></note><verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>እሶይ መላ ቢታን ባ ቃላ ቁ ኦድ፥</para>
  <para style="q2" vid="MRK 1:3">‘ጎዳ ኦግያ ጊግስተ፤</para>
  <para style="q1" vid="MRK 1:3">እ ሄመታና ሆሮጋ</para>
  <para style="q2" vid="MRK 1:3">እያዉ ሱርስተ ግስ’ ”</para>
  <para style="m" vid="MRK 1:3">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">እሳ 40:3</ref>.</char></note><verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>ፃማቅያ ዮሃንስ አሳ ፃማቅሸ፥ “ህንተ ናጋራፐ ስሚድ ፃማቀትተ፤ ፆሳይ ህንተ ናጋራ አቶ ጋና” ያግድ ቃላ ኦድሸ መላ ቢታፈ ይስ። <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>ይሁዳ ቢታን ደእያ አሳ ኡባይነ የሩሳላመ ካታማ አሳ ኡባይ ዮሃንሳኮ ዮሶና። ባንታ ናጋራ ፓፅን፥ ዮሃንስ ኤንታ ዮርዳኖሰ ሻፋን ፃማቄስ።<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>ዮሃንስ ግማለ እክሰፐ ዳደትዳ አፍላ ማኤስ። ባ ፄሳን ዳፎ ዳንጬስ፤ ቃስ ቦለነ ደገራ ኤስ ሜስ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ካዎ 1:8</ref>.</char></note> <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>ዮሃንስ ቃላ ኦድሸ፥ “ታፐ ጉየራ ዳሮ ምነይስ ዬስ። ሀር አቶሽን፥ ታኒ እያ ጫማ ዎዶሩዋ ሆካዳ ብላናዉ በስከ። <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>ታኒ ህንተና ሃን ፃማቃይስ፥ ሽን እ ህንተና ጌሻ አያናን ፃማቃና” ያግስ።<verse eid="MRK 1:8"/></para>
  <para style="s1">የሱሳ ፃማቀተነ ፓጨተ</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማቶ 3:13-17</ref>፤ <ref loc="MAT 4:1-11">4:1-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ 3:21-22</ref>፤ <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>የሱሲ ሄ ዎደ ጋልላ ቢታን ደእያ ናዝረተ ካታማፐ ይን፥ ዮሃንስ ዮርዳኖሰ ሻፋን እያ ፃማቅስ። <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>የሱሲ ሃፈ ከይያ ዎደ ሳሎይ ዶየትን፥ ጌሻ አያናይ ባ ቦላ ሆለዳ ዎሽን በእስ። <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>ቃስ ሳሎፐ፥ “ታኒ ዶስያ ታ ናአይ ነና፤ ታ ነናን ኡፋይታይስ” ግያ ቃላይ ይስ።<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">መ 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ 2:7</ref>፤ <ref loc="ISA 42:1">እሳ 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ 3:17</ref>፤ <ref loc="MAT 12:18">12:18</ref>፤ <ref loc="MRK 9:7">ማር 9:7</ref>፤ <ref loc="LUK 3:22">ሉቃ 3:22</ref>.</char></note><verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>ኢራ ጌሻ አያናይ የሱሳ መላ ቢታ ኤፍስ። <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>የሱሲ መላ ቢታን ፃላሄን ፓጨትሸ ኦይታሙ ጋላስ ጋምእስ። ዶአታራ ደእስ፥ ሽን ኪታንቾት ይድ እያ ማድዶሶና።<verse eid="MRK 1:13"/></para>
  <para style="s1">የሱሲ ፄግዳ ኮይሮ ታማረታ</para>
  <para style="r">(<ref loc="MAT 4:12-22">ማቶ 4:12-22</ref>፤ <ref loc="LUK 4:14-15">ሉቃ 4:14-15</ref>፤ <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>ዮሃንስ ቃሸትዳፐ ጉየ፥ የሱሲ ፆሳ ካዎተ ዎንገላ ኦድሸ ጋልላ ቢታ ብስ። <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>ያን፥ “ዎደይ ጋክስ፤ ፆሳ ካዎተይ ማታትስ። ህንተ ናጋራፐ ስሚድ፥ ዎንገላን አማንተ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቶ 3:2</ref>.</char></note><verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>የሱሲ ጋልላ አባ ማታራ አሸ፥ ሞሎ ኦይክያ፥ ስሞናነ እያ እሻ እንድርያሳ፥ ባንታ ግትያ አባን የገይሳታ በእስ። <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>ኤንታኮ፥ “ታና ካልተ፤ ታኒ ህንተና አሰ ኦይ ታማርሳና” ያግስ። <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>ኤንቲ ኤለስድ ባንታ ግትያ የግ አግድ የሱሳ ካልዶሶና።<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>የሱሲ ጉ ስን ብድ፥ ናምኡ እሻታ ዛብድዮሳ ናይታ፥ ያይቆባነ ዮሃንሳ ዎጎሉዋ ግዶን ባንታ ግትያ ጊግሰይሳታ በእስ። <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>እ ኤንታ በእዳ መላ ፄግስ። ኤንቲ ባንታ አዋ ዛብድዮሳ፥ እያ ኦሳንቾታራ ዎጎሉዋ ግዶን የግ አግድ የሱሳ ካልድ ብዶሶና።<verse eid="MRK 1:20"/></para>
  <para style="s1">ቱና አያን ኦይክዳ ኡራ</para>
  <para style="r">(<ref loc="LUK 4:31-37">ሉቃ 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>ኤንቲ ቅፍርናሆማ ካታማ ገልዶሶና። ሳምባት ገልዳ መላ የሱሲ ኤለስድ አይሁደ ዎሳ ኬ ገልድ ታማርሶ ኦይክስ። <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>ማታራ ደእያ አሳዳ ታማርሰስፐ አትሽን፥ ህገ አስታማረታ ታማርሶና ግሾ፥ አሳይ እያ ትምርትያን ማላለትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">ማቶ 7:28</ref>.</char></note><verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>ሄ ዎደ ቱና አያናይ ኦይክዳ እስ ኡራይ አይሁደ ዎሳ ኬ ገልድ ባ ቃላ ቁ ኦድ፥ <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>“ናዝረተ የሱሳ፥ ኔኒ ኑፐ አይ ኮያይ? ኑና ይሳናዉ ያዲ? ኔኒ ኦነኮ ታ ኤራይስ፤ ኔኒ ፆሳ ጌሻ ግድኪ?” ያግስ።<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>የሱሲ ሄ ቱና አያና፥ “ሀይዛ፥ ሀ አድያፈ ከያ” ግድ ኪትስ።<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>ቱና አያናይ ኡራ ዳፈረድ፥ ዋስድ እያፐ ከይስ። <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>አሳ ኡባይ ማላለትድ፥ “ሀይስ አይቤ? ሀ ኡራይ ባ ማታን ሀር አቶሽን ቱና አያናታካ ኪቴስ። ኤንቲ እያዉ ኪተቶሶና፤ ሀይስ አይብ ኦራ ትምርቴ?” ግድ፥ ባንታ ግዶን እሶይ እሱዋ ኦይችዶሶና።<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>የሱሳ ሱንይ ኤለስድ ጋልላ ቢታን ደእያ ሄራ ኡባን ከይስ።<verse eid="MRK 1:28"/></para>
  <para style="s1">ዳሮ ሀርጋንቾት ፓፅዶሶና</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ 8:14-17</ref>፤ <ref loc="LUK 4:38-41">ሉቃ 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>የሱሲ አይሁደ ዎሳ ኬፈ ከይድ፥ ያይቆባራነ ዮሃንሳራ ስሞና ሶነ እንድርያሳ ሶ ብስ። <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>ስሞና ማቸ አይያ ቆፆ ምሻ ሀርጋዳ ዝንእዳሮ የሱሲ ያ ጋክያ ዎደ እያዉ ኦድዶሶና። <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>እ ኢኮ ሺቅድ፥ እ ኩሽያ ኦይክድ፥ እዮ ደንድ ኤስስ። ቆፆይነ ምሻይ አግን እያ ኤንታ ሞካሱ።<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>ሀርግዳ አሳ ኡባነ ቱና አያናት ኦይክዳ አሳ ኡባ ኦማርስ አዋይ ዉልዳፐ ጉየ፥ እያኮ ኤህዶሶና። <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>ካታማን ደእያ አሳ ኡባይ ሄ ኬ ካረ ሺቅዶሶና። <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>የሱሲ ዱማ ዱማ ሀርገን ኦይከትዳ ዳሮ አሳ ፓድ፥ ዳሮ ቱና አያናታ ከስስ። እ ኦነኮ ቱና አያናት ኤርዳ ግሾ፥ ኤንታ ኦድሶና ድግስ።<verse eid="MRK 1:34"/></para>
  <para style="s1">የሱሲ ጋልላን ታማርሶ ዶመ</para>
  <para style="r">(<ref loc="LUK 4:42-44">ሉቃ 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>የሱሲ ዎንታ ጉራ ደንድድ፥ አስ ባይና በሲ ብድ፥ ያን ፆሳ ዎስስ። <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>ስሞንነ እያራ ደኤይሳት እያ ኮይሸ ብዶሶና። <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>ኤንቲ እያ ደምድ፥ “አሳ ኡባይ ነና ኮዬስ” ያግዶሶና።<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>የሱሲ ቃስ ኤንታ፥ “ሄ ሄራን ደእያ ሀራ ካታማታ የተ። ታኒ ይዳይ ዎንገላ ኦዳናዉ ግድያ ግሾ ያንካ ቃላ ኦዳናዉ በሴስ” ያግስ። <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>አይሁደ ዎሳ ኬታን ቃላ ኦድሸነ ቱና አያናታ ከስሸ፥ ጋልላ ቢታ ኡባን ዩይስ።<note caller="-" style="x"><char style="xo" closed="false">1:39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቶ 4:23</ref>፤ <ref loc="MAT 9:35">9:35</ref>.</char></note><verse eid="MRK 1:39"/></para>
  <para style="s1">ባሮ ሀርጋንቹዋ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶ 8:1-4</ref>፤ <ref loc="LUK 5:12-17">ሉቃ 5:12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>ባሮይ ኦይክዳ እስ ኡራይ የሱሳኮ ይድ፥ እያ ስንን ጉልባትድ፥ “ኔኒ ኮይኮ ታና ጌሻናዉ ዳንዳኣሳ” ያግድ ዎስስ።<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>የሱሲ እያዉ ቃትድ፥ ባ ኩሽያ የድድ እያ ቦችድ፥ “ታኒ ኮያይስ፥ ጌይያ” ያግስ። <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>ኤለስድ ባሮይ ኡራ የድን ኡራይ ፓፅስ። <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>የሱሲ ኡራ ምን ናግስድ ከስ የድስ። <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>የሱሲ እያ፥ “ነና ኤራ፥ ሀይሳ ኦደስካ ኦዶፓ። ሽን ባዳ ነ አሳተ ካህነ በሳ። ኔኒ ሀእ ጌሽ ግድዳይሳ አሳ ኤርሳናዉ፥ ሙሰይ ኪትዳ ያርሹዋ ያርሻ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1">ሌወ 14:1</ref>.</char></note><verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>ሽን ኡራይ ብድ፥ ጉታ ኡባን አሳ ኡባስ ኦድስ። ሄሳ ግሾ፥ የሱሲ ቆንጨ ከይድ፥ ካታማ ገላናዉ ዳንዳእቤና። ሽን አስ ባይና በሳን ጋፃን ደእስ፤ ቃስ አሳይ ኡባ በሳፈ እያኮ ዮሶና።<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">ጉንዳ ኡራ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቶ 9:1-8</ref>፤ <ref loc="LUK 5:17-26">ሉቃ 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>ጉ ጋላሳፐ ጉየ፥ የሱሲ ቅፍርናሆማ ስሚድ፥ ሶን ደኤስ ግያ ኦዳይ ስኤትስ። <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>አሳ ኬይ ኤኮና እፅን፥ ሀር አቶሽን ካረይካ ፁማና ጋካናዉ ዳሮ አሳይ ሺቅን፥ የሱሲ ቃላ ታማርስስ። <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>ኦይዱ አሳት እስ ጉንዳ ኡራ ቶክድ እያኮ ኤህዶሶና። <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>አሳይ ዳርዳ ግሾ፥ ኡራ የሱሳኮ ሺሻናዉ ኤንታዉ ዳንዳኤቶና እፅን፥ የሱሲ ደእያ ግናራ ኬ ቃርድ፥ ካራ ቃዉፅድ ኡራ እ ዝንእዳ አልጋራ ዱገ የድድ የሱሳ ስንን ዎስዶሶና። <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>የሱሲ ኤንታ አማኑዋ በእድ፥ ሄ ጉንዳ ኡራ፥ “ታ ናአዉ፥ ነ ናጋራይ አቶ ጌተትስ” ያግስ።<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>ህገ አስታማረታፐ ሄ በሳን ኡትዳ እሶት እሶት ባንታ ዎዛናን፥ <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>“ላ ሀ ኡራይ ሀይሳ መላ ኢታባ ፆሳ ቦላ አይስ ኦዴቲ? ፆሳ ፃላላፐ አትሽን፥ ሀር ኦን ናጋራ አቶ ጋናዉ ዳንዳኢ?” ግድ ቆፕዶሶና።<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>ኤንቲ ባንታ ዎዛናን ሄሳዳ ቆፕዳይሳ የሱሲ ኤለስድ ባ አያናን ኤርድ፥ ኤንታኮ፥ “ህንተ ህንተ ዎዛናን አይስ ሄሳዳ ቆፔቲ? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>ጉንዳ ኡራ፥ ‘ነ ናጋራይ አቶ ጌተትስ’ ገይስ ማተዬ? ዎይኮ፥ ‘ደንዳ ኤቃዳ ነ አልጋ ቶካዳ ባ’ ገይስ ማቴ? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>ሽን ታዉ፥ አሳ ናኣስ፥ ሳአ ቦላ ናጋራ አቶ ጋናዉ ማት ደኤይሳ ህንተ ኤራና መላ” ግድ ሄ ጉንዳ ኡራኮ፥ <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>“ነና ጋይስ፥ ደንዳ ኤቃዳ ነ አልጋ ቶካዳ ነ ሶ ባ” ያግስ።<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>ኡራይ ኤለስ ደንድ ኤቅድ፥ ባ አልጋ ቶክድ አሳ ኡባይ በእሽን ብስ። አሳ ኡባይ ማላለትድ፥ “ኑኒ ሀይሳ መላ ማላልስያባ በእ ኤሮኮ” ያግድ ፆሳ ጋላትዶሶና።<verse eid="MRK 2:12"/></para>
  <para style="s1">የሱሲ ሌወ ፄሳ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶ 9:9-13</ref>፤ <ref loc="LUK 5:27-32">ሉቃ 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>የሱሲ ቃስ ጋልላ አባ ዶና ስም ብድ፥ ባኮ ይዳ አሳ ኡባ ታማርስስ። <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>ያራ አሸ፥ እልፍዮሳ ናኣ ሌወ ጌተተይስ ቃራፃ ቃንፅስያ በሳን ኡትዳይሳ በእድ፥ “ታና ካላ” ያግስ። ሌወይ ደንድ ኤቅድ እያ ካልስ።<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>የሱሲ ካ ማናዉ ሌወ ሶን ኡትስ። እያ ካልያ አሳይ ዳሮ ግድያ ግሾ፥ ቃራፃ ቃንፅስያ ዳሮ አሳይነ ናጋራንቾት እያራነ እያ ታማረታራ እስፈ ኡትዶሶና። <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>ህገ አስታማረ ግድዳ እስ እስ ፋርሳወት የሱሲ ናጋራንቾታራነ ቃራፃ ቃንፅሰይሳታራ ካ ምሽን በእድ፥ “እ አይስ ናጋራንቾታራነ ቃራፃ ቃንፅሰይሳታራ ካ ሚ?” ያግድ፥ እያ ታማረታ ኦይችዶሶና።<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>የሱሲ ኤንቲ ገይሳ ስእድ፥ “ሀርጋንቾታፐ አትሽን፥ ፓፃታስ አክመ ኮሸና። ታኒ ናጋራንቾታ ፄጋናዉ ያስፐ አትሽን፥ ፅሎታ ፄጋናዉ ያቢከ” ያግድ ኤንታዉ ዛርስ።<verse eid="MRK 2:17"/></para>
  <para style="s1">የሱሲ ፆማባ ኦይሸትስ</para>
  <para style="r">(<ref loc="MAT 9:14-17">ማቶ 9:14-17</ref>፤ <ref loc="LUK 5:33-39">ሉቃ 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>ፃማቅያ ዮሃንሳ ታማረትነ ፋርሳወት ፆሞሶና። እስ እስ አሳት የሱሳኮ ይድ፥ “ዮሃንሳ ታማረትነ ፋርሳወታ ታማረት ፆሞሶና፥ ሽን ነ ታማረት አይስ ፆሞኮና?” ያግዶሶና።<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>የሱሲ ኤንታኮ፥ “ያጋኑዋ ይዳ አሳት ማችዉ ኤከይስ ኤንታራ ደእሽን፥ ፆማናዉ ዳንዳኦና? ማችዉ ኤከይስ ኤንታራ ደእሽን፥ ፆማናዉ ዳንዳኦኮና። <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>ሽን ማችዉ ኤከይስ ኤንታ ማታፐ ኤከታና ዎደይ ያና፥ ኤንቲ ሄ ዎደ ፆማና።<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>“ጋልአ ማኦ ቦላ ኦራ ጫርቀ ዎድ ስክያ አስ ባዋ። ዎድ ስክኮ፥ ኦራይ ጬጋ ማኡዋ ዳኬስ፤ ዳከይካ ካሰይሳፈ ዳሬስ። <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>ቃስ ማልአንቶ ዎይነ ጬጋ ኦጎሮን ቆልያ አስ ባዋ። ሽን ቆልኮ፥ ሄ ዎይነይ ኦጎሩዋ ዳኬስ፥ ባዉካ ጉኬስ፥ ኦጎሮይካ ኢቴስ። ሽን ማልአንቶ ዎይነይ ኦራ ኦጎሮን ቆለቴስ” ያግስ።<verse eid="MRK 2:22"/></para>
  <para style="s1">ሳምባታባ ቦንቻናዉ በሲ?</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶ 12:1-8</ref>፤ <ref loc="LUK 6:1-5">ሉቃ 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>የሱሲ እስ ሳምባታ ጋላስ ባንጋ ጋደ ግዶራ አሽን፥ እያ ታማረት እያራ ብሸ ባንጋ ትያ ሽርክድ ሞሶና።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ዛረ 23:25</ref>.</char></note> <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>ፋርሳወት የሱሳኮ፥ “ሄኮ፥ ነ ታማረት ሳምባታ ጋላስ ዎጋ ግዶናባ አይስ ኦና?” ያግዶሶና።<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>የሱሲ ኤንታኮ፥ “ዳዊቲ ኮሻትድ፥ ምያባ ኮይዳ ዎደ፥ ባራ ደኤይሳታራ ኦዳይሳ ናባብበከቲ?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳሜ 21:1-6</ref>.</char></note> <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>አብያታር ካህነ ሀላቃ ግድድ ደእያ ዎደ ዳዊቲ ፆሳ ኬ ገልድ፥ ካህነታ ፃላል ማናፐ አትሽን፥ ኦንካ ማናዉ ዎጋ ግዶናይሳ ጎዳ ስንን ዎዳ ዳቡዋ ምስ፥ ባራ ደኤይስታስካ እሚስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌወ 24:9</ref>.</char></note><verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>ቃስካ የሱሲ ኤንታኮ፥ “ሳምባት አሳ ናአ ጎአስ መትስፐ አትሽን፥ አስ ሳምባታስ መትቤና። <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>ሄሳ ግሾ፥ አሳ ናአይ፥ ሀር አቶሽን ሳምባታስካ ጎዳ” ያግስ።<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">ኩሸይ ስልዳ ኡራ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማቶ 12:9-14</ref>፤ <ref loc="LUK 6:6-11">ሉቃ 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>የሱሲ አይሁደ ዎሳ ኬ ስም ገልስ። ያን ኩሸይ ጉንድዳ እስ ኡራይ ደኤስ። <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>እስ እስ አሳይ የሱሳ ሞታናዉ ኮይድ፥ ኩሸይ ጉንድዳ ኡራ ሳምባታ ጋላስ እ ፓኮነ አግኮ በአናዉ ኮይድ ምንድ ናጎሶና። <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>የሱሲ ኩሸይ ጉንድዳ ኡራ፥ “ደንዳ ኤቃዳ ሃ ስን ያ” ያግስ። <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>ሄሳፈ ጉየ፥ አሳኮ፥ “ሳምባታ ጋላስ ሎኦባ ኦይስ ዎገየ ኢታባ ኦይስ ዎጌ? አሳ ሸምፖ አሾየ ዎይኮ ዎ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="MRK 3:4">ሽን አሳይ ስእ ግስ። <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>የሱሲ ሀንቀትድ፥ ኤንታ ዩሽ አ ፄልድ፥ ኤንቲ ኦድን ስኦናይሳታ ግድያ ግሾ፥ ኤንታ ቦላ ዳሮ አዛንስ። ሄ አድያኮ፥ “ነ ኩሽያ ፕድ ኦ” ያግስ። ኡራይ ፕድ ኦን እያ ኩሸይ ፓፅስ። <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>ኤለስድ ፋርሳወት አይሁደ ዎሳ ኬፈ ካረ ከይድ፥ የሱሳ ዋት ዎነኮ ማቀታናዉ ሄሮዲሳ ባጋታራ እስ ሶ ሺቅዶሶና።<verse eid="MRK 3:6"/></para>
  <para style="s1">ዳሮ አስ የሱሳ ካሌስ</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>የሱሲ ባ ታማረታራ ጋልላ አባኮ ብስ። ጋልላፐነ ይሁዳፐ ይዳ ዳሮ አሳይ እያ ካልዶሶና። <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>ቃስካ የሩሳላመፐ፥ ኤዶምያሳፐ፥ ዮርዳኖሰ ሻፋ ፕንፈ፥ ፅሮሳ ካታማፐነ ስዶና ካታማፐ የሱሲ ኦዳባ ስእድ፥ ዳሮ አሳይ እያኮ ይዶሶና። <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>አሳ ዳሮተፈ ደንዶይሳን እያ ኡንኤና መላ እያ ታማረት ዎጎሎ እያዉ ጊግሳና መላ ኪትስ።<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MRK 4:1">ማር 4:1</ref>፤ <ref loc="LUK 5:1-3">ሉቃ 5:1-3</ref>.</char></note> <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>ዳሮ አሳ እ ፓዳ ግሾ፥ ሀርግያ አሳ ኡባይ እያ ቦቻናዉ ሱገቶሶና። <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>ቱና አያናይ ኦይክዳ አሳት እያ በእዳ ዎደ እያ ስንን ኩንድድ፥ ባንታ ቃላ ቁ ኦድ፥ “ኔኒ ፆሳ ናኣ ግድኪ?” ያጎሶና።<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>ሄ ቱና አያናት እያ ኦናተ ኦደስካ ቆንጭሶና መላ ኤንታዉ ምንድ ኦድስ።<verse eid="MRK 3:12"/></para>
  <para style="s1">ታማነ ናምኡ ሀዋረታ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶ 10:1-4</ref>፤ <ref loc="LUK 6:12-16">ሉቃ 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>የሱሲ ደርያ ቦላ ከይድ፥ ባ ኮይዳ አሳታ ባኮ ፄግስ፤ ኤንትካ እያኮ ብዶሶና። <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>ኤንቲ ባራ ዳና መላነ ቃላ ታማርሳና መላ ታማነ ናምአታ ዶርድ፥ ኤንታ፥ “ሀዋረታ”<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fq" closed="false">ሀዋረ፦ </char><char style="ft" closed="false">ሀዋረ ጉሳይ ኪተትዳይሳ ጉሱ።</char></note> ግድ ሱንስ። <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>ቱና አያናታካ ከሳና መላ ኤንታዉ ማታ እሚስ።<verse eid="MRK 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>እ ዶርዳ ታማነ ናምአት ሀይሳታ፦ ጰፅሮሳ ያግድ ሱንዳ ስሞና፥ <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>ቦአነርገስ (ዳዳ ናይታ) ያግድ ሱንዳይሳታ፥ ዛብድዮሳ ናይታ ያይቆባነ ያይቆባ እሻ ዮሃንሳ፥ <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>እንድርያሳ፥ ፍልጶሳ፥ ባርተለሞሳ፥ ማቶሳ፥ ቶማሳ፥ እልፍዮሳ ናአ ያይቆባ፥ ታድዮሳ፥ ባ ቢታስ ምሸትያ ስሞናነ፥ <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>የሱሳ አድ እምዳ አስቆሮታ ይሁዳ።<verse eid="MRK 3:19"/></para>
  <para style="s1">የሱሳነ ብኤል-ዘቡላ</para>
  <para style="r">(<ref loc="MAT 12:22-32">ማቶ 12:22-32</ref>፤ <ref loc="LUK 11:14-23">ሉቃ 11:14-23</ref>፤ <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>ሄሳፈ ጉየ፥ የሱሲ ሶ ብስ። ቃስ ዳሮ አሳይ ሺቅን፥ እነ እያ ታማረት ሀር አቶሽን ካ ማናዉካ ዳንዳእቦኮና። <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>አሳይ እያ፥ “ጎዬስ” ግያ ግሾ፥ እያ ዳቦት ሄሳ ስእድ እያ ኤካናዉ ብዶሶና።<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>ህገ አስታማረታፐ እሶት እሶት የሩሳላመፐ ይድ፥ “እያ ቦላ ብኤል-ዘቡል ደኤስ”፥ እ፥ “ፃላሄይ ዎልቃን ቱና አያናታ ከሴስ” ያግድ ኦደትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ 9:34</ref>፤ <ref loc="MAT 10:25">10:25</ref>.</char></note><verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>የሱሲ አሳ ባኮ ፄግድ ሌምሶ ኦድስ። “ፃላሄይ ፃላሄ ዋት ከሳናዉ ዳንዳኢ? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>እስ ካዎተይ ባ ግዶን ሻከትኮ ሄ ካዎተይ ኤቃናዉ ዳንዳኤና። <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>ሄሳዳካ፥ እስ ኬ አሳይ ባንታ ግዶን ሻከትኮ ያናፐ አትሽን፥ ዳናዉ ዳንዳኦኮና። <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>ህዛ፥ ፃላሄይ ባራ ካጨትድ ሻከትኮ ዮፐ አትሽን፥ ዳናዉ ዳንዳኤና።<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>“ሽን ኮይሮትድ ዎልቃማ ኡራ ቃቾና ደእሸ እያ ኬ ገልድ፥ እያ ሚሽያ ቦንቃናዉ ዳንዳእያ አስ ባዋ። ቃች ስሚድ እያ ኬ ቦንቃናዉ ዳንዳኤስ።<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>“ታኒ ህንተዉ ቱማ ኦዳይስ፤ ፆሳይ አሳ ናይታስ ናጋራ ኡባነ ኤንቲ ጫይያ ጫሸ ኡባ አቶ ጋና። <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>ሽን ጌሻ አያና ቦላ ኢታባ ኦደትያ ኦደስካ መርና ናጋራ ግዳናፐ አትሽን፥ ፆሳይ ኡባራካ እያ ማረና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ 12:10</ref>.</char></note> <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>የሱሲ ሄሳ ግዳይ፥ እስ እስ አሳት፥ “እያ ቦላ ቱና አያናይ ደኤስ” ያግዳ ግሾሳ።<verse eid="MRK 3:30"/></para>
  <para style="s1">የሱሳ አይዉነ እያ እሻታ</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶ 12:46-50</ref>፤ <ref loc="LUK 8:19-21">ሉቃ 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>እያ አያነ እያ እሻት ይድ ካረን ኤቅድ፥ እያኮ አሰ ኪትድ እያ ፄግዶሶና። <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>እያ ማታን ኡትዳ ዳሮ አሳት፥ “ሄኮ፥ ነ አየራነ ነ እሻታራ ካረን ኤቅድ ነና ኮዮሶና” ያግዶሶና።<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>የሱሲ ዛሪድ፥ “ታ አይያ ኦኔ? ቃስ ታ እሻት ኦናንቴ?” ያግስ። <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>ባ ማታን ኡትዳ አሳ ዩሽ አ ፄልድ፥ “ሄኮ፥ ታ አያነ ታ እሻት ሀይሳታ። <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>ፆሳይ ሸንያ ኦያ ኡባይ ታ እሻ፥ ታ ምቾነ ታ አዮ” ያግስ።<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">ዘረ ዘርያ ኡራ ሌምሶ</para>
  <para style="r">(<ref loc="MAT 13:1-9">ማቶ 13:1-9</ref>፤ <ref loc="LUK 8:4-8">ሉቃ 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>የሱሲ ዛሪድ ጋልላ አባ ማታን ታማርሴስ። ዳሮ አሳይ እያ ማታን ዩሹዋን ሺቅን፥ አባን ደእያ ዎጎሉዋ ግዶ ገልድ ኡትስ፥ አሳ ኡባይ አባ ማታን ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="LUK 5:1">ሉቃ 5:1</ref>.</char></note> <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>እ ኤንታ ዳሮባ ሌምሶን ታማርስስ። ታማርስሸ ሀይሳዳ ያግስ፦<verse eid="MRK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3"/>“ስእተ! እስ ኡራይ ዘረ ዘራናዉ ከይስ። <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>እ ዘርሽን፥ እስ እስ ዘረይ ኦገ ጋፃን ዎስ፤ ካፎት ይድ ምዶሶና። <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>እስ እስ ዘረይ ጋርሳን ሻሎይ ደእያ ቢታ ቦላ ዎስ። ዳሮ ቢት ባይና ግሾ፥ ሄ ዘረይ ኤለስድ ዶልስ። <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>ሽን አው ከይዳ ዎደ ሹልስ። ሎይድ ፃጶ የድቦና ግሾ፥ ኤለስ መልስ። <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>እስ እስ ዘረይ አጉን ግዶን ዎስ። ዶልዳይሳ አጉንይ ድጭድ ጩልዳ ግሾ አይፈ አይፎና አትስ። <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>እስ እስ ዘረይ አራዳ ቢታን ዎድ ዶልስ። ድጭድ እሶይ ሀስታማ፥ እሶይ ኡሱፑን ታማ እሶይ ፄታ አይፍስ” ያግስ። <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/>“ስእያ ሀይ ደእያ ኦንካ ስኦ” ያግስ።<verse eid="MRK 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>የሱሲ ኦድዳይሳ ስእዳ እስ እስ አሳትነ ታማነ ናምኡ ታማረት የሱሲ ባርካ ደእሽን፥ እያኮ ሺቅድ ሄ ሌምሱዋ ብርሸ ኦይችዶሶና። <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>የሱሲ ኤንታኮ ሀይሳዳ ያግስ፦ “ህንተዉ ፆሳ ካዎተ ፁራ ኤሮይ እመትስ። ሽን ሀራታስ ካዎተፈ ካረን ደኤይሳታስ ኡባባይ ሌምሶን ኦደቴስ። <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>ጋሶይካ፥</para>
  <para style="q1" vid="MRK 4:12">“ ‘ኤንቲ ፄሎሶና፥ ሽን ደሞኮና።</para>
  <para style="q1" vid="MRK 4:12">ስኦሶና፥ ሽን አኬኮኮና።</para>
  <para style="q1" vid="MRK 4:12">ኤንቲ ደምያኮነ አኬክያኮ፥</para>
  <para style="q2" vid="MRK 4:12">ፆሳኮ ስማና</para>
  <para style="q2" vid="MRK 4:12">እካ ኤንታ ማራናሽን’ ”<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9">እሳ 6:9</ref>.</char></note></para>
  <para style="m" vid="MRK 4:12">ያግስ። <verse eid="MRK 4:12"/><verse number="13" style="v" sid="MRK 4:13"/>የሱሲ ኤንታኮ፥ “ሀ ሌምሶይ ህንተዉ ገለኔ? ያትን፥ ሌምሶ ኡባ ህንተ ዋት አኬካኔ? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>ዘረይስ ፆሳ ቃላ ዘሬስ። <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>ቃላይ ዘረትያ ዎደ ኦገ ጋፃን ዎዳይሳት ቃላ ስእዳይሳታ። ሽን ፃላሄይ ኤለስድ፥ ይድ ኤንታ ዎዛናን ዘረትዳ ቃላ ማፅ ድጌስ። <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>ሄሳዳካ፥ ጋርሳን ሻሎይ ደእያ ቢታን ዘረትዳይስ ቃላ ስእድ፥ ኤለስድ ኡፋይሳን ኤከይሳ። <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>ሽን እያዉ ምኖ ፃጶይ ባይና ግሾ ሀእሳፈ አትሽን፥ ጋምኦኮና። ጉ ዎደፐ ጉየ ቃላ ጋሶን ዋየይ ዎይኮ ጎድ ጋክያ ዎደ ኤለስድ በቶሶና። <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>አጉን ግዶን ዘረትዳይስ ቃላ ስኤይሳታ። <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>ሽን ሀ ሳአ ደኡዋስ ህርጎይ፥ ዱረተ ዶሶይነ ሀራባ አሞተይስ እያ ዎዛናን ገልድ ቃላ ጩልያ ግሾ አይፈ አይፎና አትስ። <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>ሽን አራዳ ቢታን ዘረትዳይሳት ቃላ ስእድ ኤከይሳታ። ኤንቲ እሶይ ሀስታማ፥ እሶይ ኡሱፑን ታማ እሶይ ፄታ አይፍስ” ያግስ።<verse eid="MRK 4:20"/></para>
  <para style="s1">ጌማን ደእያ ፆምፐ</para>
  <para style="r">(<ref loc="LUK 8:16-18">ሉቃ 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>የሱሲ ጉጅድ፥ “ፆምፐ ኤክድ፥ ዳቾፈ ዎይኮ አልጋፈ ጋርሳን ዎያ አስ ደኢ? ቃ በሳን ዎነዬ?<note caller="-" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ 5:15</ref>፤ <ref loc="LUK 11:33">ሉቃ 11:33</ref>.</char></note> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>ህዛ፥ ቆሰትዳባይ ኡባይ ቆንጨ ከያና፤ ጌምዳባይ ኡባይ ኤረቶና አተና።<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቶ 10:26</ref>፤ <ref loc="LUK 12:2">ሉቃ 12:2</ref>.</char></note> <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>ስእያ ሀይ ደእያ ኦንካ ስኦ” ያግስ።<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>ቃስ ኤንታኮ፥ “ህንተ ስእያባ አኬክድ ስእተ! ፆሳ ቃላ ህንተ ስኤይሳ መላ እ ህንተዉ አኬካ እማና። ኡባካ ህንተዉ ዳርስድ እማና። <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>እስባይ ደእያ ኡራስ ጉጅ እመታና፥ ባይናይሳፈ ሀር አቶሽን፥ እያዉ ደእያ ሄ ጉያካ ኤከታና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ 13:12</ref>፤ <ref loc="MAT 25:29">25:29</ref>፤ <ref loc="LUK 19:26">ሉቃ 19:26</ref>.</char></note><verse eid="MRK 4:25"/></para>
  <para style="s1">ድጭያ ዘረ ሌምሶ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>የሱሲ ዛሪድ፥ “ፆሳ ካዎተይ ባ ጋደን ዘረ ዘርያ አሳ መላ። <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>ሄ ኡራይ ቃማ ስኬስ፤ ዎንታ ደንዴስ። እ ባ ሁጰን ዋንያኮ ኤሮና ደእሽን ሄ ዘረይ ዶሌስነ ድጬስ። <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>ቢታይ ካ ባርካ እሜስ። ኮይሮ ዶልድ ድጬስ፥ ካልድ አይፋናዉ ጋምቡፄስ፥ ዉርሰን ኩመ አይፈ አይፌስ። <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>ሽን ካይ ጋክያ ዎደ ኡራይ ኤለስድ ባጫራ ገል አጌስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">እዩ 3:13</ref>.</char></note><verse eid="MRK 4:29"/></para>
  <para style="s1">አይፈ ጉ ም ሌምሶ</para>
  <para style="r">(<ref loc="MAT 13:31-34">ማቶ 13:31-34</ref>፤ <ref loc="LUK 13:18-19">ሉቃ 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>የሱሲ፥ “ኑኒ ፆሳ ካዎተ አይ ዳኔስ ጋኔ? ዎይኮ አይብራ ሌምሳኔ? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>ፆሳ ካዎተይ አይፈ ጉ ም ዳኔስ። ሄ ም አይፍያ ዘርያ ዎደ ሳአን ደእያ ም አይፈ ኡባፈ ጉፄስ። <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>ዘርን ዶልድ አታክልተ ኡባፈ ግታቴስ፤ ዳሮ ዳሽ ዳዬስ። ካፎት እያ ታሽያ ቦላ ኬፅድ ኡታና ጋካናዉ ዳዬስ” ያግስ።<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>የሱሲ ሀይሳ መላ ዳሮ ሌምሶን አሳይ አኬካናዉ ዳንዳኤይሳ መላ ቃላ ኦድስ። <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>አሳስ ሌምሶይ ባይና ኦደና። ሽን የሱሲ ባ ታማረታ ፃላላራ ደእያ ዎደ፥ ኤንታዉ ኡባባ ብርሽድ ኦድስ።<verse eid="MRK 4:34"/></para>
  <para style="s1">የሱሲ ሆቢያ ሴርስ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶ 8:23-27</ref>፤ <ref loc="LUK 8:22-25">ሉቃ 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>ሄ ጋላስ ሳእ ኦማርስን፥ የሱሲ ባ ታማረታኮ፥ “አባፈ ሄፍን ፕኖስ” ያግስ። <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>እያ ታማረት ዳሮ አሳ የግ አግድ፥ የሱሲ ካሰ ገል ኡትዳ ዎጎሉዋን ገልድ የሱሳ ባንታራ ኤፍዶሶና። ሀራ ዎጎሎትካ ያን ደኦሶና። <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>ዎልቃማ ጎተይ ደንድድ፥ ሆበይ ዎጎሉዋ ሾጭን፥ ኩማና ጋካናዉ ዎጎሉዋ ግዶ ሃ ገልስ። <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>ሄ ዎደ የሱሲ ዎጎሉዋን ጉየ ባጋራ ቦርኮትድ ስክስ። እያ ታማረት እያ ደንድ፥ “አስታማርያዉ፥ ኑኒ ይያ ዎደ ነ ስእ ጋዳ ፄላይ?” ያግዶሶና።<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>ያትን፥ እ ባርክድ ጎትያ፥ “ስእ ጋ” ግድ፥ አባካ፥ “ዎፑ ጋ” ግስ። ጎተይካ ስእ ግን ኡባባይ ዎፑ ግስ። <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>የሱሲ ባ ታማረታኮ፥ “አይስ ሀይሳዳ ባበቲ? ህንተዉ አማኖይ ዋንድ ይዴ?” ያግስ።<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>ኤንቲ ዳሮ ባብድ ባንታ ግዶን፥ “ሀይስ ሀር አቶሽን፥ ጎተይነ አባይ ኪተተይስ ኦኔ?” ያግዶሶና።<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">ቱና አያን ኦይክዳ ኡራ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶ 8:28-34</ref>፤ <ref loc="LUK 8:26-39">ሉቃ 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>የሱስነ እያ ታማረት አባ ፕንድ፥ ገርገሶነ ቢታ ጋክዶሶና። <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>የሱሲ ዎጎሉዋፐ ዎያ ዎደ ቱና አያናይ ኦይክዳ እስ ኡራይ ዱፎፐ ከይድ እያራ ጋሄትስ። <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>ሄ ኡራይ አቅ ፔእድ ደኤይ ዱፎና። እያ ኦንካ ሳንላታን ቃቻናዉ ዳንዳኤና። <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>እ ዳሮ ቶሆ ዱንነ ሳንላታን ቃሸትድ ደኤስ። ሽን ሳንላታ ዱሰረስ፥ ዱ መንረስ። እያ ተቃናዉ ዳንዳእያ ኦንካ ባዋ። <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>እ ቃማነ ጋላስ ሄ ዱፉዋንነ ደረ ቦላ ዋሴስ፥ ባ አሳተ ሹቻን ጋሬስ።<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>የሱሳ ሃሆን በእዳ ዎደ ዎፅ ብድ እያ ስንን ጉልባትስ። <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>ሄ ኡራይ ባ ቃላ ቁ ኦድ፥ “ኡባፈ ቦላ ፆሳ ናአዉ የሱሳ፥ ነናነ ታና አይበ ጋይ? ታና ይሶና መላ ታኒ ነና ፆሳ ሱንን ዎሳይስ” ያግስ። <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>እ ሄሳ ግዳይ የሱሲ እያ፥ “ላ ሀ ቱና አያናዉ፥ ሀ አድያፈ ከያ” ያግዳ ግሾሳ።<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>የሱሲ እያኮ፥ “ነ ሱንይ ኦኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="MRK 5:9">እ፥ “ኑኒ ዳሮ ግድያ ግሾ፥ ታ ሱንይ ሌግዮና” ያግስ። <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>ቱና አያናት ባንታና ሄ ቢታፈ ከስ የዶና መላ የሱሳ ምንድ ዎስዶሶና።<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>ሄ ደርያ ቦላ ዳሮ ጉዱን ዉደይ ሄመቴስ። <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>ቱና አያናት የሱሳኮ፥ “ኑና ህን ጉዱን ዉድያኮ የዳርክ፥ ኤንታን ብድ ገሎስ” ያግድ ዎስዶሶና። <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>የሱሲ ኤንታኮ፥ “ቢተ” ያግስ። ያትን ቱና አያናት አድያፈ ከይድ ጉዱንታን ገልዶሶና። ናምኡ ሙኩሉ ግድያ ጉዱን ዉደይ አፎ ዶናራ ድርግድ ብድ አባን ገልድ ምተትዶሶና።<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>ጉዱን ዉድያ ሄመይሳት ባቃት ብድ ሀንዳባ ካታማንነ ጋፃርያን ኦድዶሶና። ያትን አሳይ ሀንዳባ በአናዉ ከይዶሶና። <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>አሳይ የሱሳኮ ያ ዎደ ቱና አያናን ኦይከትዳ ኡራ በእዶሶና። እ ባ ዎዛናኮ ስሚድ፥ ማኦ ማእድ፥ ያን ኡትዳይሳ በእዳ ዎደ ኡባይ ያይዶሶና። <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>ሄሳ በእዳ አሳት ቱና አያናት ኦይክዳ ኡራ ቦላነ ጉዱንታ ቦላ ሀንዳባ ኡባ አሳስ ኦድዶሶና። <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>ሄሳ ግሾ፥ አሳይ ባንታ ቢታፈ የሱሲ ባና መላ ዎስዶሶና።<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>የሱሲ ዎጎሉዋን ገልያ ዎደ ካሰ ቱና አያናይ ኦይክድ የድዳ ኡራይ፥ የሱሳ ካላናዉ እያ ዎስስ። <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>ሽን የሱሲ እፅድ እያኮ፥ “ነ ሶ ስማዳ፥ ጎዳይ ነዉ አይ መላ ግታባ ኦዳኮነ ነዉ አይ መላ ኬህዳኮ ነ ሶ አሳስ ኦዳ” ያግስ። <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>ኡራይ ብድ ታሙ ካታማ ጌተትያ በሳን ዩይድ፥ የሱሲ ባዉ አይ መላ ግታባ ኦዳኮ ኦድስ። እ ኦድዳይሳ ስእዳ አሳ ኡባይ ማላለትዶሶና።<verse eid="MRK 5:20"/></para>
  <para style="s1">ሀይቅዳ ናእዉነ ሀርገትያ ማጫስዉ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶ 9:18-26</ref>፤ <ref loc="LUK 8:40-56">ሉቃ 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>የሱሲ ስሚድ፥ ዎጎሉዋን ገልድ፥ አባ ፕንዳፐ ጉየ ዳሮ አሳይ አባ ጋፃን እያ ዩሹዋን ሺቅዶሶና። <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>እያሮሳ ጌተትያ አይሁደ ዎሳ ኬ ሀላቃታፐ እሶይ፥ የሱሳ በእዳ ዎደ እያኮ ይድ እያ ቶሁዋ ቦላ <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>ኩንድድ፥ “ታ ናእያ ሀርጋዳ ሀይቃና ሀናዉሱ። እያ ፓፃዳ ደአና መላ ያዳ ነ ኩሽያ እ ቦላ ዎርክ” ያግድ የሱሳ ምንድ ዎስስ።<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>የሱሲ እያሮሳራ ብስ። እ ብሽን ዳሮ አሳይ እያ ካልድ ኡንኤዶሶና።<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>ታማነ ናምኡ ላይ እፔ ሱ ሂያ እስ ማጫስያ ደአዉሱ። <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>ዳሮ አክመት እዮ አክምዶሶና፥ ሽን እያ ፓፃ ካኤታሱ። እያ ባ ሚሽያ ኡባ ዉርስንካ እዉ ሃ ኢትስፐ አትሽን፥ አይኮካ ማድቤና። <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>ሄ ማጫስያ የሱሳባ ስአዳ፥ አሳ ካንዳ የሱሳ ጉየራ ያዳ እያ ማኡዋ ቦቻሱ። <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>እያ፥ “ታኒ ሀር አቶሽን እያ ማኡዋ ቦችያኮ ፓፃና” ጋዳ ቆፓሱ።<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>ኢፐ ጎግያ ሱይ ኢራካ ኤቅ አግስ። እያ ባ ዋያፐ ፓፅዳይሳ ባ አሳተን ኤራሱ። <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>የሱሲ ባፐ ዎልቅ ከይዳይሳ ባ ሁጰን ኤርድ፥ ኤለስድ ዳሮ አሳ ግዶን ጉየ ስሚድ፥ “ታ ማኡዋ ቦችዳይ ኦኔ?” ያግስ።<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>እያ ታማረት፥ “አሳይ ነና ሱገይሳ በአሸ፥ ‘ዎይጋዳ ታና ኦነ ቦችዳይ ያጋይ?’ ” ያግዶሶና።<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>የሱሲ ሄሳ ኦን ኦዳኮ በአናዉ ዩሽ አ ፄልስ። <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>ሽን ማጫስያ ባዉ ሀንዳባ ኤራዳ፥ ያሻን ኮኮራሸ ያዳ የሱሳ ስንን ጉፋናሱ፤ ቃስ ሀንዳባ ኡባ ቱማ እያዉ ኦዳሱ። <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>ያንን፥ የሱሲ ኢኮ፥ “ታ ናተ፥ ነና ነ አማኖይ ፓስ፥ ሳሮን ባ፥ ነ ዋያፐካ ፓፃ” ያግስ።<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>የሱሲ ቡሮ ሄሳ ኦድሽን፥ አይሁደ ዎሳ ኬ ሀላቃ ሶፐ ኪተትዳ አሳት ይድ፥ “ነ ናእያ ሀይቃሱ፥ አስታማርያ አይስ ዳቡርሳይ?” ያግዶሶና።<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>ሽን የሱሲ ኤንቲ ገይሳ ስእድ፥ አይሁደ ዎሳ ኬ ሀላቃኮ፥ “አማኖ ፃላላ አማናፐ አትሽን፥ ባቦፋ” ያግስ። <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>የሱሲ ጰፅሮሳፐ፥ ያይቆባፐነ ያይቆባ እሻ ዮሃንሳፐ ሀር ኦንካ ባና ካሎና መላ ድግስ። <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>ኤንቲ አይሁደ ዎሳ ኬ ሀላቃ ሶ ጋክያ ዎደ የሱሲ አሳይ ካሀ ይድ ዬከይሳነ ዘሌለይሳ በእስ። <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>ገልድ አሳኮ፥ “አይስ ካሀ ይድ ዬከቲ? ናእያ ስካሱፐ አትሽን፥ ሀይቃቡኩ” ያግስ።<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>አሳይ እያ ቦላ ሚጭስ። ሽን አሳ ኡባ ካረ ከስድ፥ ናኤ አዋ፥ አይዉነ ሄ ታማረታ ባራ ኤክድ ናእያ ደእያሱዋ ገልስ። <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>የሱሲ ናኤ ኩሽያ ኦይክድ፥ “ፃልታ፥ ቁም” (ጉ ናተ፥ ነና ጋይስ ደንዳ) ያግስ።<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>ናእያ ኤለሳ ደንዳ ኤቃዳ ሄመታሱ። እያ ታማነ ናምኡ ላይ ናአ። ሄሳን አሳይ ዳሮ ማላለትዶሶና። <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>የሱሲ ሄሳ ኤንቲ ኦደስካ ኦዶና መላ ኤንታ ምን ኪትስ። ኤንቲ እዉ ምያባ እማና መላ ኦድስ።<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">የሱሲ ናዝረተን እፀትስ</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማቶ 13:53-58</ref>፤ <ref loc="LUK 4:16-30">ሉቃ 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>የሱሲ ያፐ ከይድ፥ ባ ታማረታ ካለድ፥ ባ ካታማ ናዝረተ ብስ። <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>ሳምባታ ጋላስ አይሁደ ዎሳ ኬን ታማርሶ ኦይክስ። እ ታማርሰይሳ ስእዳ ዳሮ አሳይ ማላለትድ፥ “ሀይስ ሀ ኡባ አዉፐ ደምዴ? ሀ ጭንጫተ እ አዉፐ ኤክዴ? ሀ ማላታታ ኦያ ማታ እ አዉፐ ደምዴ? <figure style="fig" alt="Man reading inside synagogue" file="LB00244B.tif" size="span" ref="6:2">እስ አስ አይሁደ ዎሳ ኬን ናባብሽን</figure> <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>ሀይስ አናፅያ ግደኔ? ማይራም ናአ፥ ያይቆባ፥ ዮሳ፥ ይሁዳነ ስሞና እሻ ግደነዬ? እያ ምቸት ኑራ ሀይሳን ደኦኮናዬ?” ያግድ፥ እ ግያባ ኤኮና እፅዶሶና።<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>የሱሲ ሄ አሳኮ፥ “ናበይ ባ ቢታን፥ ባ ዳቦታንነ ባ ሶ አሳን ቦንቸተናፈ አትሽን፥ ሀራታ ማታን ቦንቸቴስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JHN 4:43">ዮሀ 4:43</ref>.</char></note> <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>እ ሄ በሳን ባ ኩሽያ ጉ አሳ ቦላ ዎድ ፓዳይሳፈ አትሽን፥ ሀራ ማላታታ ኦናዉ ዳንዳእቤና። <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>አሳይ አማንቦና ግሾ ዳሮ ማላለትስ።</para>
  <para style="s1" vid="MRK 6:6">ታማነ ናምኡ ሀዋረታ ኪተትዶሶና</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">ማቶ 10:5-15</ref>፤ <ref loc="LUK 9:1-6">ሉቃ 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">ሄሳፈ ጉየ፥ የሱሲ ሄ ሄራን ደእያ ጉታታን አሳ ታማርሴስ። <verse eid="MRK 6:6"/><verse number="7" style="v" sid="MRK 6:7"/>የሱሲ ታማነ ናምኡ ታማረታ ባኮ ፄግድ፥ ናምኣ ናምኣ ጋድ ኪትስ። ኤንታዉ ቱና አያናታ ከስያ ዎልቃ እሚስ። <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>ኤንታ፥ “ኦገ ፃምአፈ አትሽን፥ ካ፥ ካርፂታ፥ ህንተ ኪሰን ሚሸ አይብባካ ኦይኮፍተ።<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃ 10:4-11</ref>.</char></note> <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>ህንተ ቶሁዋን ጫማ አተ፥ ሽን ናምኡ አፍላ ኦይኮፍተ” ያግስ። <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>ቃስካ፥ “ህንተና አስ ሞክዳ ሶ አዉንካ ግድን ሄ በሳ የድድ ባና ጋካናዉ ሄ ኬን ጋምእተ። <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>ህንተና አስ ሞኮናሱዋ ዎይኮ ህንተ ኦድያባ ስኦናሱዋ አዉን ግድኮካ፥ ሄ ቢታን ደእያ አሳስ ማርካ ግዳና መላ ሄ በሳፈ ከይሸ፥ ህንተ ቶሁዋፐ ባና ፕትተ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሀዋ 13:51</ref>.</char></note><verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>ታማነ ናምኡ ታማረት ብድ፥ አሳይ ባንታ ናጋራፐ ስማናዳ ቃላ ኦድዶሶና። <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>ኤንቲ አሳፐ ዳሮ ቱና አያናታ ከስዶሶና። ዳሮ ሀርጋንቾታ ዛይተ ትይድ ፓዶሶና።<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">ያይ 5:14</ref>.</char></note><verse eid="MRK 6:13"/></para>
  <para style="s1">ፃማቅያ ዮሃንሳ ሀይቁዋ</para>
  <para style="r">(<ref loc="MAT 14:1-12">ማቶ 14:1-12</ref>፤ <ref loc="LUK 9:7-9">ሉቃ 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>የሱሳ ሱንይ ኡባ በሳን ከይዳ ግሾ፥ ካዎይ ሄሮዲስ እያባ ስእስ። እስ እስ አሳይ፥ “ፃማቅያ ዮሃንስ ሀይቆፐ ደንድስ፥ ሄሳ ግሾ ሀ ማላታታ ኦይ እያ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MAT 16:14">ማቶ 16:14</ref>፤ <ref loc="MRK 8:28">ማር 8:28</ref>፤ <ref loc="LUK 9:19">ሉቃ 9:19</ref>.</char></note><verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>ባጋት፥ “ሀይስ ኤልያሳ ግደኔ?” ያግዶሶና።</para>
  <para style="p" vid="MRK 6:15">ሀራት ቃስ፥ “ሀይስ በን ዎደ ናበታፐ እሱዋ ግዶና አገና” ያግዶሶና።<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>ሽን ሄሮዲስ ሄሳ ስእዳ ዎደ፥ “ሀይስ ታኒ ቆያ ቃንፅስዳ ፃማቅያ ዮሃንሳ ግደኔ? እ ሀይቆፐ ደንድስ” ያግስ።<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>ሄሮዲስ ባ እሻ ፍልጶሳ ማችዉ ሄሮድያዳ ኤክዳ ግሾ እ ጋሶን ዮሃንሳ ኦይድ ቃሽስስ። <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>ዮሃንስ ሄሮዲሳ፥ “ኔኒ ነ እሻ ማችዉ ኤካናዉ በሰና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">ሉቃ 3:19-20</ref>.</char></note><verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>ሄሮድያዳ ዮሃንሳ ባ ኡሎን ሞርካዳ እያ ዎሳናዉ ኮያሱ፥ ሽን ዳንዳአቡኩ። <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>ዮሃንስ ፅሎነ ጌሻ አስ ግድዳይሳ ሄሮዲስ ኤርዳ ግሾ፥ እያዉ ባብድ ሎይ ናግሴስ። ሄሮዲስ ዮሃንስ ግያባ ስአናዉ ዶስኮካ እ ግያባ ስእያ ዎደ ዳሮ ዳጋሜስ።<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>ሄሮዲስ ባ የለትዳ ጋላሳ ቦንቻናዉ ደርያ ሃረይሳታስ፥ ሻላቃታስነ ጋልላን ደእያ ግታ አሳስ እማቶ ጊግስስ። ሄስ ሄሮድያዳስ እንጀ ጋላስ ግድስ። <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>ሄሮድያዳ ናእያ እማይ ሞከትያ በሳ ገላ ዱራዳ፥ ሄሮዲሳነ እያ እማታ ኡፋይሳሱ። ካዎይ ናእዉ፥ “ነ ኮያባ አይባ ግድኮካ ታና ኦይቻ፥ ታኒ ነዉ እማና” ያግስ። <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>ቃስ እዉ ጫቅድ፥ “ኔኒ ኦይችያባ አይባ ግድኮካ፥ ታኒ ነዉ እማና። ሀር አቶሽን፥ ታ ካዎተ ባጋ ግድኮካ ታኒ ነዉ እማና” ያግስ።<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>ናእያ ካረ ከያዳ ባ አየኮ፥ “አይ እማ ጎ?” ጋዳ ኦይቻሱ።</para>
  <para style="p" vid="MRK 6:24">እ አይያ፥ “ፃማቅያ ዮሃንሳ ሁጵያ እማ ጋ” ያጋሱ።<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>ናእያ ኤለሳዳ ካዋኮ ባዳ፥ “ፃማቅያ ዮሃንሳ ሁጵያ ሳነን ዎዳ ሀእ ታዉ እማና መላ ኮያይስ” ያጋሱ።<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>ያንን፥ ካዎይ ዳሮ ቂሮትስ፥ ሽን ባ እማታ ግሾ እዉ ጫቅዳ ባ ጫቁዋ መንናዉ ኮይቤና። <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>ሄሳ ግሾ፥ ኤለስድ ናገይሳ ዮሃንሳ ሁጵያ ኤሀና መላ ኪትስ። ናገይስ ቃሾ ኬ ብድ ዮሃንሳ ቆያ ቃንፅስ። <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>ሄ ቃንፀትዳ ሁጵያ ሳነን ዎ ኤህድ ናኤስ እሚስ። ናእያ ቃስ ባ አየስ እማሱ። <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>ዮሃንሳ ታማረት ሄሳ ስእዳ ዎደ ብድ እያ አሀ ኤክ ኤፍድ ሞግዶሶና።<verse eid="MRK 6:29"/></para>
  <para style="s1">እቻሹ ሙኩሉ አሳ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ 14:13-21</ref>፤ <ref loc="LUK 9:10-17">ሉቃ 9:10-17</ref>፤ <ref loc="JHN 6:1-14">ዮሀ 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>ታማነ ናምኡ ሀዋረት ስም ይድ ኤንቲ ኦዳባነ ታማርስዳባ ኡባ የሱሳስ ኦድዶሶና። <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>ኤንታኮ ያ አሳይነ ብያ አሳይ ዳርዳ ግሾ፥ የሱሳራነ እያ ታማረታራ፥ ሀር አቶሽን ካ ማናዉካ ኤንታ ጋና እፅስ። ያንን፥ የሱሲ ኤንታኮ፥ “ኑርካ ጉ ሸምፕ ኤካናዉ አስ ባይና በሲ የተ” ያግስ። <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>ሄሳ ግሾ፥ ኤንቲ ባንታርካ ዎጎሎን ገልድ አስ ባይና በሲ ብዶሶና።<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>ኤንቲ ብሽን ዳሮ አሳይ ኤንታ በእድ ኤርዶሶና። ያትን፥ ካታማ ኡባፈ አሳይ ቶሆራ ዎፅ ብድ ኤንቲ ብያ በሳ ኤንታፈ ስን ጋክዶሶና። <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>የሱሲ ዎጎሉዋፐ ዎድ ዳሮ አሳ በእስ። አሳይ ሄምያ አስ ባይና ዶርሳ መላ ግድዳይሳ በእድ ኤንታዉ ቃትድ ኤንታ ዳሮባ ታማርስስ።<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ታይቦ 27:17</ref>፤ <ref loc="1KI 22:17">1 ካዎ 22:17</ref>፤ <ref loc="EZK 34:5">ህዝ 34:5</ref>፤ <ref loc="MAT 9:36">ማቶ 9:36</ref>.</char></note><verse eid="MRK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35"/>ሳአይ ኦማርስያ ዎደ የሱሳ ታማረት እያኮ ይድ፥ “ሀይስ በሳይ አስ ባይና በሲ፤ ሀእ ሳእካ ቃምስ። <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>አሳይ ጉታታነ ካታማታ ብድ ባንታዉ ምያባ ሻማና መላ አሳ የዳ” ያግዶሶና።<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>ሽን የሱሲ ዛሪድ ኤንታኮ፥ “አሳስ ምያባ ህንተ እምተ” ያግስ።</para>
  <para style="p" vid="MRK 6:37">ኤንቲ፥ “ኑኒ ብድ ናምኡ ፄቱ ድናረን ኡይ ሻምድ አሳ ሙዛና መላ ኮያይ?” ያግድ ኦይችዶሶና።<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>የሱሲ ኤንታኮ፥ “ህንተዉ አፑን ኡይ ደኢ? አነ ብድ በእተ” ያግስ።</para>
  <para style="p" vid="MRK 6:38">ኤንቲ በእድ፥ “እቻሹ ኡይነ ናምኡ ሞሎ” ያግዶሶና።<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>የሱሲ ባ ታማረታ አሳ ኡባ ጩጋን ጩጋን ሻክድ ማታን ኡትሳና መላ ኪትስ። <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>አሳይ ፄቱ ጩጋንነ እሻታሙ ጩጋን ሻከት ሻከት ኡትዶሶና። <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>የሱሲ እቻሹ ኡይነ ናምኡ ሞሎታ ኤክድ፥ ፑደ ሳሎ ፄልድ ፆሳ ጋላትስ። ኡይ መንድ አሳስ ግሻና መላ ባ ታማረታስ እሚስ። ቃስ ናምኡ ሞሎታ ኤንታ ኡባስ ሻክስ። <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>አሳ ኡባይ ምድ ካልዶሶና። <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>አትዳ ኡይ ቲፍያነ ሞሎታ ቲፍያ፥ እያ ታማረት ታማነ ናምኡ ጋይታ ኩመ ደንዶሶና። <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>ኡይ ምዳ አደ አሳ ታይቦይ እቻሹ ሙኩሉ።<verse eid="MRK 6:44"/></para>
  <para style="s1">የሱሲ አባ ቦላራ ሄመትስ</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቶ 14:22-33</ref>፤ <ref loc="JHN 6:15-21">ዮሀ 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>ኤለስድ የሱሲ ባ ታማረት ዎጎሉዋን ገልድ፥ አባፈ ሄፍንን ደእያ ቤተሳይዳ ባፐ ስንትድ ባና መላ ኪትስ። ሽን ባዉ አሳ ሞይዛናዉ ጉየ አትስ። <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>አሳ ሞይዝዳፐ ጉየ፥ ፆሳ ዎሳናዉ ዙማ ቦላ ከይስ።<verse eid="MRK 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47"/>ሳአይ ቃምያ ዎደ ዎጎሎይ አባ ግዶን ደኤስ፥ ሽን የሱሲ አባፈ ጋፃን ባርካ ደኤስ። <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>ጫርኮይ እያ ታማረታኮ ጫርክያ ግሾ፥ አባ ፕይ ዋይሰይሳ የሱሲ በእስ። ዎንትማ ሳእ ጌያና ሀንያ ዎደ እ አባ ቦላ ሄመትሸ ኤንታኮ ይድ፥ ኤንታ የግድ አናዉ ኮይስ። <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>ሽን እ አባ ቦላ ሄመትሽን፥ ኤንቲ በእድ፥ ኤንታዉ ሞይትለ ዳንን ዋስዶሶና። <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>ኤንቲ ኡባይ እያ በእድ፥ ያሻን ኮኮርዶሶና።</para>
  <para style="p" vid="MRK 6:50">ሽን የሱሲ ኤለስድ ኤንታኮ፥ “ታና፥ አይኮይ ባዋ፤ ያዮፍተ” ያግስ። <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>የሱሲ ዎጎሉዋን ገልድ ኤንታራ እስፈ ኡትን ጫርኮይ ዎፑ ግስ። ኤንቲ ዳሮ ማላለትዶሶና። <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>ኤንታ ዎዛናይ ዘልኡምዳ ግሾ፥ ኤንቲ ኡይባ አኬክቦኮና።<verse eid="MRK 6:52"/></para>
  <para style="s1">ገንሳሬፀን ሀርጋንቾት ፓፅዶሶና</para>
  <para style="r">(<ref loc="MAT 14:34-36">ማቶ 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>ኤንቲ አባ ፕንድ፥ ገንሳሬፀ ቢታ ጋክድ፥ ዎጎሉዋ ጋፃ ሺሽድ ቃችዶሶና። <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>ኤንቲ ዎጎሉዋፐ ዎያ ዎደ አሳይ ኤለስድ የሱሳ ኤርዶሶና። <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>ኤንቲ ሄራን ደእያ ቢታ ኡባን ዎፀረትድ ሀርጋንቾታ ሀላን ቶክድ፥ “የሱሲ ደኤስ” ግን ስእዳ በሳ ኤህዶሶና። <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>አሳይ እ ብዳ ሶ ኡባን፥ ጋፃርያን ግድን፥ ካታማን፥ ደእያ ሀርጋንቾታ ዳባባ ኤፎሶና። ሀርጋንቾት እያ አፍላ ማጫራ ግድኮካ ቦቻና መላ አሳይ እያ ዎስዶሶና። ቦችዳ ኡባይ ፓፅስ።<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">ፋርሳወታ ዎጋ</para>
  <para style="r">(<ref loc="MAT 15:1-9">ማቶ 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>የሩሳላመፐ ይዳ ጉ ፋርሳወትነ ህገ አስታማረት የሱሳ ማታን ሺቅዶሶና። <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>የሱሳ ታማረታፐ እሶት እሶት ጌዮና ኩሽያን፥ ሄስካ ኩሸ ሜጨቶና ካ መይሳታ በእዶሶና።<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>ፋርሳወትነ አይሁደ አሳ ኡባይ ባንታ አዋታ ዎጋ ባንታ ኩሽያ ሜጨቶና ሞኮና። <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>ሄሳዳካ፥ ኤንቲ ግያፐ ሻመትዳባ ሜጮና ደእሸ ሞኮና። ቃስ ኤንቲ ባንታ አዋታፐ ኤክዳ ሀራ ዳሮ ዎግ ደኤስ፦ ሄስካ ስነታ፥ ከረታ፥ ብራታ ሚሸታነ አርሳ ሜጭያ ዎጋ ናገይሳ።<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>ፋርሳወትነ ህገ አስታማረት የሱሳ፥ “ነ ታማረት አይስ አዋታ ዎጋ መንድ ባንታ ኩሽያ ሜጨቶና ካ ሞና?” ያግድ ኦይችዶሶና።<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>የሱሲ ኤንታኮ፥ “እሳያስ ህንተና ጩቦታ፥</para>
  <para style="q1" vid="MRK 7:6">“ ‘ሀይስ አሳይ ታና ባ እንፃርሳ ፃላላን ቦንቼስ፥</para>
  <para style="q2" vid="MRK 7:6">ሽን ኤንታ ዎዛናይ ታፐ ሃሆን ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="ISA 29:13">እሳ 29:13</ref>.</char></note><verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>አስ መዳ ዎጋ ፆሳ ህገ ዳንስድ ታማርስያ ግሾ፥</para>
  <para style="q2" vid="MRK 7:7">ኤንቲ ታዉ መላ ጎይኖሶና’ ”</para>
  <para style="m" vid="MRK 7:7">ግድ ፃፍዳይስ ቱማ።<verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>“ህንተ ፆሳ ኪታ አግድ አሳ ዎጋ ምንድ ናገታ” ያግስ።<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>ቃስካ የሱሲ፥ “ህንተ ህንተ ዎጋ ናግድ ፆሳ ኪታ የግ አጋናዉ ሎኦ ኦገ ደምደታ። <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>ሙሰይ፥ ‘ነ አዋነ ነ አይዉ ቦንቻ’፥ ቃስ ‘ባ አዋነ ባ አይዉ ጫየይስ ሀይቃናዉ በሴስ’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከሳ 20:12</ref>፤ <ref loc="DEU 5:16">ዛረ 5:16</ref>፤ <ref loc="EXO 21:17">ከሳ 21:17</ref>፤ <ref loc="LEV 20:9">ሌወ 20:9</ref>.</char></note> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>ሽን እስ አስ ባ አዋ ዎይኮ ባ አይዉ ማዳናይሳ አግድ፥ ‘ሀይስ ታኒ ፆሳስ እምዳ ያርሾ’ ጊኮ፥ <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>እ ባ አዋ ዎይኮ ባ አይዉ ማዶና መላ ኦታ። <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>ሄሳዳካ፥ ህንተ ሀራታ ታማርስዳ ህንተ ዎጋን ፆሳ ቃላ ካደታ። ሄሳ መላ ሀራ ዳሮባ ኦታ” ያግስ።<verse eid="MRK 7:13"/></para>
  <para style="s1">አሰ ቱንስያባታ</para>
  <para style="r">(<ref loc="MAT 15:10-20">ማቶ 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>የሱሲ ዳሮ አሳ ቃስካ ባኮ ፄግድ፥ “ኡባይ ታኒ ኦደይሳ ስእተነ አኬክተ። <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>አሳ ዎዛናፐ ከያባይ አሰ ቱንሴስፐ አትሽን፥ ካረፐ አሳ ኡሎ ገልድ አሰ ቱንስያባይ አይብካ ባዋ። <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>ስእያ ሀይ ደእያ ኦንካ ስኦ” ያግስ።<verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>የሱሲ ዳሮ አሳ የግ አግድ ሶ ገልን እያ ታማረት ሄ ሌምሱዋባ እያ ኦይችዶሶና። <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>እ ኤንታኮ፥ “ህንተዉካ ቃስ ገልቤኔ? ካረፐ አሳን ገልያባይ አይብካ አሰ ቱንሳናዉ ዳንዳኦናይሳ አኬከቲ? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>አይስ ጊኮ፥ ካ አሳ ኡሎ ግዶ ገልድ ካንድ አስፐ አትሽን፥ አሳ ዎዛና ግዶ ገለና” ያግስ። ሄሳን የሱሲ ካ ኡባይ ጌሽ ግደይሳ ኤርስስ።<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>ካልድካ፥ የሱሲ፥ “አሳ ቱንስያባይ አሳ ዎዛና ግዶፈ ከያባ። <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>አሳ ዎዛና ግዶፈ ከያባይ ኢታ ቆፋ፥ ላይማተ፥ ካይሶ፥ አሰ ዎ፥ ላመ፥ <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>ኢታ አሞ፥ ኢታተ፥ ገነ፥ ቃይፀ፥ ጭሞ፥ ቃናተ፥ ጫሸ፥ ኦቶሮነ ቦዛተ። <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>ሀ ኢታባይ ኡባይካ አሳ ዎዛና ግዶፈ ከይድ አሰ ቱንሴስ” ያግስ።<verse eid="MRK 7:23"/></para>
  <para style="s1">እስ ማጫሰ አማኖ</para>
  <para style="r">(<ref loc="MAT 15:21-28">ማቶ 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>የሱሲ ያፐ ከይድ፥ ፅሮሳ ካታማ ማታን ደእያ ቢታ ብስ። እ እስ ኬ ገልድ ያን ደኤይሳ ኦንካ ኤራና መላ ኮይቤና። ሽን ቆሰትድ ጋምአናዉ ዳንዳእቤና። <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>ሽን እ ጉ ናእዉ ቱና አያናይ ኦይክዳ እስ ማጫስያ የሱሳባ ስአዳ ኤለሳ እያኮ ያዳ እያ ቶሁዋ ቦላ ኩንዳሱ። <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>እያ አይሁደ ማጫስ ግዱኩ፤ እያ የለትዳይ ስሮፍንቀ ቢታና። እያ፥ ባ ናኤፐ ቱና አያና ከሳና መላ የሱሳ ዎሳሱ።<verse eid="MRK 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27"/>ሽን የሱሲ ዛሪድ፥ “ናይት ኮይሮትድ ካ ካሎ፤ ናይታ ካ ኤክድ ካናታስ የገይስ ሎኦ ግደና” ያግስ።<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>ማጫስያ ዛራዳ፥ “ታ ጎዳዉ ሄስ ቱማ፥ ሽን ጋይታ ማታን ደእያ ካናት ናይታፐ ዎያ ቲፍያ ሞሶና” ያጋሱ።<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>የሱሲ ቃስ ኢኮ፥ “ሀ ነ ቃላ ግሾ፥ ነ ሶ ባ፤ ቱና አያናይ ነ ናኤፐ ከይስ” ያግስ።<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>ማጫስያ ባ ሶ ብያ ዎደ ቱና አያናይ ኢፐ ከይን ሂፃን ዝንእዳሮ ደማሱ።<verse eid="MRK 7:30"/></para>
  <para style="s1">ቱለነ ሙመ ኡራ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>የሱሲ ፅሮሳ ካታማፐ ከይድ፥ ስዶናራነ ታሙ ካታማታ ጌተትያ ቢታራ ካንድ ጋልላ አባኮ ብስ። <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>አሳይ ቱለነ ዋይድ ኦደትያ አስ የሱሳኮ ኤህድ፥ ባ ኩሽያ እያ ቦላ ዎና መላ እያ ዎስዶሶና። <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>የሱሲ ባርካ ሄ ኡራ ዳሮ አሳፐ ጋፃ ከስድ፥ ባ ብራያ እያ ሀይን የድስ። ቃስ ጩቹ ጩትድ እያ እንፃርሳ ቦችስ። <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>ሳሎ ፑደ ፄልድ፥ ቶክ ሸምፕድ፥ “ኤፍታህ” ግስ። ብርሸይካ “ዶየታ” ጉሱ። <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>ኡራ ሀይይ ኤለስድ ዶየትስ፥ ቃሸትዳ እንፃርሳይካ ብርሸትስ፥ ኡራይ ጌሽድ ኦደትስ።<verse eid="MRK 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36"/>የሱሲ አሳኮ፥ “ሀይሳ ኦደስካ ኦዶፕተ” ያግስ። ሽን እ ዳሮ ምንድ ኦዶፕተ ግን፥ አሳይ ኦዳ ያ ዳርስስ። <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>ሄሳ ስእዳ አሳ ኡባይ ዳሮ ማላለትድ፥ “ኡባባ እ ሎይ ኦስ። ሀር አቶሽን፥ ቱልያ ስሴስ፥ ሙምያ ኦድሴስ” ያግዶሶና።<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">ኦይዱ ሙኩሉ አሳ</para>
  <para style="r">(<ref loc="MAT 15:32-39">ማቶ 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>ጉ ዎደፐ ጉየ፥ ዳሮ አሳይ የሱሳኮ ሺቅዶሶና። አሳስ ምያባይ ይን የሱሲ ባ ታማረታ ባኮ ፄግድ፥ <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>“ሀ አሳይ ታራ ሄ ጋላስ ጋካናዉ ጋምእድ፥ አይኮካ ምያባ ደምቦና ግሾ፥ ታና አሳይ ቃስ። <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>ታኒ አሳ ኮሻራ ሶ የድኮ አሳይ ብሸ ኦገን ዳቡርድ ኩንዳና፥ ባጋ አሳይ ሃሆሶፐ ይዶሶና” ያግስ።<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>የሱሳ ታማረት ዛሪድ፥ “ሀ መላ ቢታን ሀ አሳ ኡባ ሙዛናዉ ግድያ ካ ደማናዉ ዳንዳኤይ ኦኔ?” ያግዶሶና።<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>የሱሲ ኤንታኮ፥ “ህንተዉ አፑን ኡይ ደኢ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="MRK 8:5">ኤንቲ ዛሪድ፥ “ላፑን ኡይ ደኤስ” ያግዶሶና።<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>የሱሲ አሳይ ሳአን ኡታና መላ ኪትስ። ያትድ፥ ላፑን ኡይ ኤክድ ፆሳ ጋላት ስሚድ ሄ ኡይ መንድ፥ አሳስ ግሻና መላ ባ ታማረታስ እሚስ። እያ ታማረት አሳስ ግሽዶሶና። <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>ኤንታዉ ቃስ ጉ ላፋ ሞሎት ደኦሶና። የሱሲ ሄ ሞሎታ ግሾ ፆሳ ጋላትድ፥ አሳስ ግሻና መላ ባ ታማረታ ኪትስ። <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>አሳ ኡባይ ምድ ካልዶሶና። እያ ታማረት አትዳ ቲፍያ ላፑን ጋይታ ኩመ ደንዶሶና። <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>ካ ምዳ አሳ ታይቦይ ኦይዱ ሙኩሉ ግዳና። ሄሳፈ ጉየ፥ የሱሲ አሳ የድስ። <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>እ ቃስ ባ ታማረታራ ኤለስ ዎጎሎን ገልድ ዳልማኑታ ቢታ ብስ።<verse eid="MRK 8:10"/></para>
  <para style="s1">ማላታ በአናዉ ኦይችዳ ኦይሻ</para>
  <para style="r">(<ref loc="MAT 16:1-4">ማቶ 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>ፋርሳወት ይድ የሱሳ ፓጫናዉ ኮይድ፥ ሳሎፐ ባንታና ማላታ በሳና መላ የሱሳራ ፓላማ ኦይክዶሶና።<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ 12:38</ref>፤ <ref loc="LUK 11:16">ሉቃ 11:16</ref>.</char></note><verse eid="MRK 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 8:12"/>የሱሲ ቶክ ሸምፕድ፥ “ሀ ዎድያ አሳይ አይስ ማላታ ኮዪ? ታኒ ህንተዉ ቱማ ኦዳይስ፤ ሀ ዎድያ አሳስ አይ ማላትካ እመተና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">ማቶ 12:39</ref>፤ <ref loc="LUK 11:29">ሉቃ 11:29</ref>.</char></note> <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>እ ኤንታ ያን የግ አግድ ዛር ዎጎሎን ገልድ አባፈ ሄፍን ፕንስ።<verse eid="MRK 8:13"/></para>
  <para style="s1">ፋርሳወታነ ሄሮዲሳ እርሾ</para>
  <para style="r">(<ref loc="MAT 16:5-12">ማቶ 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>እያ ታማረት ካ ኤፋናይሳ ዶግዶሶና፤ ኤንታዉ ዎጎሉዋ ግዶን እስ ኡይፈ ሀር ባዋ። <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>የሱሲ ኤንታኮ፥ “ህንተና ኤርተ። ፋርሳወታ እርሹዋፈነ ሄሮዲሳ እርሹዋፈ ናገትተ” ያግድ ኪትስ።<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ 12:1</ref>.</char></note><verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>ኤንቲ ባንታ ግዶን፥ “እ ሀይሳ ገይ ኑስ ኡይ ባይና ግሾሳ” ያግዶሶና።<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>የሱሲ ኤንቲ ገይሳ ኤርድ ኤንታኮ፥ “ህንተዉ ኡይ ባይና ግሾ አይስ ኦደቴቲ? ሀእካ ኤረከቲ? ዎይኮ አኬከከቲ? ህንተ ዎዛናይ ዶጭዴ? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>ህንተዉ አይፈይ ደእሽን በኤከቲ? ሀይ ደእሽን ስኤከቲ? ህንተ አኬከቲ?<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">ኤርም 5:21</ref>፤ <ref loc="EZK 12:2">ህዝ 12:2</ref>፤ <ref loc="MRK 4:12">ማር 4:12</ref>.</char></note> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>ታኒ እቻሹ ኡይ እቻሹ ሙኩሉ አሳስ ባዳ ዎደ አፑን ጋይታ ኩመ ቲፈ ደንደቲ?” ያግስ።</para>
  <para style="p" vid="MRK 8:19">ኤንትካ፥ “ታማነ ናምኡ ጋይታ ኩመ” ያግዶሶና።<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>“ሄሳዳካ፥ ታኒ ላፑን ኡይ ኦይዱ ሙኩሉ አሳስ ባዳ ዎደ አፑን ጋይታ ኩመ ቲፈ ደንደቲ?” ያግስ።</para>
  <para style="p" vid="MRK 8:20">ኤንቲ፥ “ላፑን ጋይታ ኩመ ደንዳ” ያግዶሶና።<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>ያትን፥ “ሀእካ አኬክበከቲ?” ያግስ።<verse eid="MRK 8:21"/></para>
  <para style="s1">ቤተሳይዳን ደእያ እስ ቆቀ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>ኤንቲ ቤተሳይዳ ካታማ ብዶሶና። ጉ አሳት ቆቀ ኡራ የሱሳኮ ኤህድ ሄ ኡራ ቦቻና መላ እያ ዎስዶሶና። <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>የሱሲ ቆቀ ኡራ ኩሽያ ኦይክድ ካታማፐ ጋፃ ከስስ። እያ አይፍያን ጩትድ ባ ኩሽያ እያ ቦላ ዎድ፥ “ነዉ አይኮይ በንቲ?” ያግድ ኦይችስ።<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>ኡራይ ቁ ግድ ፄልድ፥ “ታዉ አሳይ በንቴስ፥ ሽን አሳይ ሄመትሸ ም ዳኔስ” ያግስ።<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>ሄሳፈ ጉየ፥ የሱሲ ዛሪድ፥ ኡራ አይፍያን ባ ኩሽያ ዎስ። ኡራይ ሎይ ፄልስ፥ እያ አይፈይ ፓፅስ፥ ኡባባ ጌሽድ በእስ። <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>የሱሲ አድያኮ፥ “ነ ሶ ባ፥ ሽን ጉታ ገሎፓ” ያግድ ኪትስ።<verse eid="MRK 8:26"/></para>
  <para style="s1">ጰፅሮሳ ማርካተ</para>
  <para style="r">(<ref loc="MAT 16:13-20">ማቶ 16:13-20</ref>፤ <ref loc="LUK 9:18-21">ሉቃ 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>የሱሲ ባ ታማረታራ ቅሳረ ፍልጶሳ ማታን ደእያ ጉታ ብስ። ኤንቲ ብሽን ኦገ ቦላ የሱሲ፥ “ታና አሳይ ኦና ጎና?” ያግድ ባ ታማረታ ኦይችስ።<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>እያ ታማረት፥ “እስ እስ አሳይ ነና፥ ‘ፃማቅያ ዮሃንሳ’ ጎሶና፤ ሀራት፥ ‘ኤልያሳ ጎሶና’ ቃስ ሀራት፥ ‘ናበታፐ እሱዋ’ ጎሶና” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 6:14">ማር 6:14</ref>.</char></note><verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>የሱሲ ኤንታኮ፥ “ያትን ህንተ ታና ኦና ጌቲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="MRK 8:29">ጰፅሮስ፥ “ኔኒ ክርስቶሳ” ያግድ ዛርስ።<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>የሱሲ፥ “ታባ ኦደስካ ኦዶፕተ” ያግድ ኤንታ ኪትስ።<verse eid="MRK 8:30"/></para>
  <para style="s1">የሱሲ ባና ጋካና ዋያ ኦድስ</para>
  <para style="r">(<ref loc="MAT 16:21-28">ማቶ 16:21-28</ref>፤ <ref loc="LUK 9:22-27">ሉቃ 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>የሱሲ ባ ታማረታኮ፥ “አሳ ናአይ፥ ዳሮ መቶ ኤካናዉ በሴስ፤ ጭማት፥ ካህነ ሀላቃትነ ህገ አስታማረት እያ እፃናዉ በሴስ። ኤንቲ እያ ዎናዉነ እ፥ ሄ ጋላሳፐ ጉየ፥ ሀይቆፐ ደንዳናዉ በሴስ” ያግድ ኤንታ ታማርስስ። <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>እ ሄሳ ኤንታዉ ጌሽድ ኦድስ። ጰፅሮስ እያ እስ ባጋ ዛሪድ ሀንቀትስ።<verse eid="MRK 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33"/>ሽን የሱሲ ጉየ ስሚድ፥ ባ ታማረታ ፄልድ፥ ጰፅሮሳ ሀንቀትድ፥ “ሀ ፃላሄይ፥ ታፐ ሃካ። ኔኒ አስ ዶስያባ ቆፓሳፐ አትሽን፥ ፆሳይ ዶስያባ ቆፓካ” ያግስ።<verse eid="MRK 8:33"/></para>
  <para style="s1">የሱሳ ካሎይ ጭግስያ ጋተ</para>
  <para style="r">(<ref loc="MAT 10:38-39">ማቶ 10:38-39</ref>፤ <ref loc="MAT 16:24-28">16:24-28</ref>፤ <ref loc="LUK 9:23-27">ሉቃ 9:23-27</ref>፤ <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>ቃስካ የሱሲ ዳሮ አሳነ ባ ታማረታ ባኮ ፄግድ፥ “ታና ካላናዉ ኮይያ ኦንካ ባና ካዶ፤ ባ ማስቃልያ ቶክድ ታና ካሎ።<note caller="-" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ 10:38</ref>፤ <ref loc="LUK 14:27">ሉቃ 14:27</ref>.</char></note> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>ባ ሸምፑዋ አሻናዉ ኮይያ ኡራይ ይሳና። ሽን ታ ግሾነ ዎንገላ ግሾ ባ ሸምፑዋ ይስያ ኡራይ አሻና።<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ 10:39</ref>፤ <ref loc="LUK 17:33">ሉቃ 17:33</ref>፤ <ref loc="JHN 12:25">ዮሀ 12:25</ref>.</char></note> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>እስ አስ ሳአን ደእያ ኡባባ ባዉ ሺሽድ፥ ባ ሸምፑዋ ይስኮ እያ አይ ማዳኔ? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>እስ አስ ባ ሸምፑዋ ዎዛናዉ አይ እማናዉ ዳንዳኢ? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>ፆሳ አማኖና ሀ ኢታ የለተን፥ እስ አስ ታናንነ ታ ቃላን ዬላትኮ፥ አሳ ናአይ፥ ቃስ ባ አዋ ቦንቾን ጌሻ ኪታንቾታራ ያ ዎደ እያን ዬላታና” ያግስ።<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="s1">የሱሳ ማላይ ላመትስ</para>
  <para style="r">(<ref loc="MAT 17:1-13">ማቶ 17:1-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>የሱሲ ኤንታኮ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ፆሳ ካዎተይ ዎልቃራ የይሳ በኦና ሀይቆና እስ እስ አሳት ሀይሳን ደኦሶና” ያግስ።<verse eid="MRK 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>የሱሲ ኡሱፑን ጋላሳፐ ጉየ፥ ባራ ጰፅሮሳ፥ ያይቆባነ ዮሃንሳ ኤክድ፥ ኤንታ ፃላላ ግታ ዙማ ቦላ ከስድ ኤንታ ስንን ላመትስ።<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጰፅ 1:17-18</ref>.</char></note> <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>እያ ማኦይካ ጶልስ፤ ሳአን ማኦ ሜጭያ ኦንካ ጌሻናዉ ዳንዳኦናይሳ መላ ዳሮ ቦፅስ። <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>ሄ ሄ ታማረት፥ ኤልያስነ ሙሰይ የሱሳራ ኦደትሽን በእዶሶና።<verse eid="MRK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5"/>ጰፅሮስ የሱሳ፥ “አስታማርያዉ፥ ኑኒ ሀይሳን ደኤይስ ኑስ ሎኦ፤ ኑ ሄ ሻቃራታ እሱዋ ነዉ፥ እሱዋ ሙሰስ፥ ቃስ እሱዋ ኤልያሳስ ሻቃራና” ያግስ። <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>እያራነ ሀንኮታራ ዳሮ ያይዳ ግሾ እ አይ ግያኮካ ኤርቤና።<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>ሄሳፈ ጉየ፥ ሻራይ ይድ ኤንታ ካምን ሻራፐ፥ “ሀይስ ታ ዶስያ፥ ታ ናኣ፥ እ ገይሳ ስእተ” ግያ ቃላይ ይስ። <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>ኤለስድ ኤንቲ ዩሽ አድ ፄልያ ዎደ፥ የሱሳፐ አትሽን፥ ሀራ ኦናካ ባንታ ማታን በእቦኮና።<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቶ 3:17</ref>፤ <ref loc="MRK 1:11">ማር 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃ 3:22</ref>.</char></note><verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>ኤንቲ ዙማ ቦላፈ ዎሽን፥ የሱሲ ኤንታኮ፥ “አሳ ናአይ፥ ሀይቆፐ ደንዳና ጋካናዉ፥ ህንተ በእዳባ ኦደስካ ኦዶፕተ” ያግድ ኪትስ።<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>እ ኪትዳይሳ ኤንቲ፥ “ኤሮ” ግድ፥ “ሀ ሀይቆፐ ደንዶ ጉሳይ ዎይጉሰ” ግድ፥ ባንታ ግዶን ኦደትዶሶና።<verse eid="MRK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11"/>ኤንቲ ዛሪድ፥ “ህገ አስታማረት፥ ‘ኤልያስ ኮይሮትድ ያናዉ በሴስ’ አይስ ጎና?” ያግድ ኦይችዶሶና።<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ምልክ 4:5</ref>፤ <ref loc="MAT 11:14">ማቶ 11:14</ref>.</char></note><verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>የሱሲ ዛሪድ “ኤልያስ ኮይሮትድ ይድ፥ ኡባባ ጊግሴስ፤ ያትን፥ ጌሻ ማፃፋን፥ ‘አሳ ናእ ዳሮ ዋየታና፤ እፀታና’ ያግድ አይብስ ፃፈትዴ? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>ሽን ታኒ ህንተዉ ኦዳይስ፤ ኤልያስ ይስ፤ ቃስ እያባይ ጌሻ ማፃፋን ፃፈትዳይሳዳ፥ አሳይ እያ ቦላ ባንታ ኮይዳባ ኦዶሶና” ያግስ።<verse eid="MRK 9:13"/></para>
  <para style="s1">ቱና አያን ኦይክዳ ናአ</para>
  <para style="r">(<ref loc="MAT 17:14-21">ማቶ 17:14-21</ref>፤ <ref loc="LUK 9:37-43">ሉቃ 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>የሱሲ፥ ጰፅሮስ፥ ያይቆብነ ዮሃንስ ሀንኮ እያ ታማረታኮ ስሚድ ያ ዎደ፥ ዳሮ አሳይ ኤንታ ዩሹዋን ኤቅዳይሳታነ ህገ አስታማረ ግድዳ ጉ አሳት ኤንታራ ፓላመይሳ በእዶሶና። <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>ሄ ዳሮ አሳይ የሱሳ በእዳ ዎደ ማላለትድ፥ ኤለስድ እያኮ ዎፅ ይድ፥ እያ ሳሮዶሶና። <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>የሱሲ ባ ታማረታኮ፥ “ኤንታራ አይ ፓላሜቲ?” ያግድ ኦይችስ።<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>ሄ ዳሮ አሳ ግዶፈ እስ ኡራይ ዛሪድ፥ “አስታማርያዉ፥ ታ ናኣ ቦላ ኦደተ ድግያ ቱና አያናይ ደእያ ግሾ፥ እያ ኔኮ ኤካዳ ያስ። <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>ሀ ቱና አያናይ እያ ኦይክያ ዎደ ኡባን፥ እያ ሾጭ የጌስ፤ እያ ዶናራ ጎፖንቶይ ዬስ፤ ቃስ አቸ ጋርጭሴስ፤ አሳተይካ ምኔስ። እያፐ ሀ ቱና አያና ከሳና መላ፥ ነ ታማረታስ ኦዳስ፥ ሽን ከሳናዉ ዳንዳእቦኮና” ያግስ።<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>የሱሲ ዛሪድ ኤንታኮ፥ “አማኖና ሀ ዎድያ አሳዉ! ታኒ ህንተራ አዉደ ጋካናዉ ዳኔ? ቃስ ህንተና አዉደ ጋካናዉ ዳንዳአኔ? ናኣ ታኮ ሃ ኤክ ዪተ” ያግስ። <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>ኤንቲ ናኣ እያኮ ኤህዶሶና፤ ሄ ቱና አያናይ የሱሳ በእዳ መላ ናኣ ኮኮርስስ፤ ናአይ ሳአን ኩንድድ፥ ዶናራ ጎፖንቶይ ቶፉ ግሽን ጎንዶረትስ። <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>የሱሲ ሄ ናኣ አዋኮ፥ “ሀይስ ነ ናኣ ኦይኮሳፐ አይ መላ ዎደ ግዳኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="MRK 9:21">ናኣ አዋይ፥ “እ ጉን ደእሽን ኦይክስ። <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>እያ ዎናዉ ዳሮ ዎደ ታማንነ ሃን የጌስ፥ ሽን ነ ዳንዳእኮ፥ ኑስ ቃታርክ፥ ኑና ማዳርክ” ያግስ።<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>የሱሲ እያ፥ “ ‘ኔኒ ዳንዳእኮ ጋይ?’ አማንያ ኦደስካ ኡባባይ ዳንዳኤቴስ” ያግስ።<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>ኤለስድ ናኣ አዋይ ባ ቃላ ቁ ኦድ፥ “ታኒ አማናይስ፥ ሽን ጉጃ አማናናዳ ታና ማዳርክ” ያግስ።<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>የሱሲ አሳይ ዳር ዳር በይሳ በእድ፥ ቱና አያና፥ “ሀ ቱለነ ሙመ አያናዉ፥ ሀ ናኣፐ ከያ ጋዳ ነና ታ ኪታይስ፤ ቃስ ናምአን እያን ገሎፓ” ያግስ።<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>ሄ ቱና አያናይ ዋስድ፥ ናኣ ዳሮ ኮኮርስድ፥ እያፐ ከይስ። ናአይ ሀይቅዳ ዳንን፥ ዳሮ አሳይ፥ “ናአይ ሀይቅስ” ያግዶሶና። <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>ሽን የሱሲ ናኣ ኩሽያ ኦይክድ ደንን፥ ናአይ ደንድ ኤቅስ።<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>የሱሲ ሶ ገልዳይሳፈ ጉየ፥ እያ ታማረት፥ “ኑኒ ሄ ቱና አያና ከሳናዉ አይስ ዳንዳእቦኮ?” ያግድ የሱሳ ዱማ ኦይችዶሶና።<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>የሱሲ ዛሪድ፥ “ሄሳ መላይ ዎሳፐነ ፆማፐ አትሽን፥ ሀራባን ከያናዉ ዳንዳኤና” ያግስ።<verse eid="MRK 9:29"/></para>
  <para style="s1">የሱሲ ባ ሀይቁዋባ ዛሪድ ኦድስ</para>
  <para style="r">(<ref loc="MAT 17:22-23">ማቶ 17:22-23</ref>፤ <ref loc="LUK 9:43-45">ሉቃ 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>ኤንቲ ሄ በሳፈ ደንድድ፥ ጋልላራ አድ ብዶሶና፤ የሱሲ ባ ደእያሱዋ ኦንካ ኤራና መላ ኮይቤና። <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>እ ባ ታማረታኮ፥ “አሳ ናኣ፥ አስ አሳስ አድ እማናነ ዎና፤ እ ሄ ጋላሳፐ ጉየ፥ ሀይቆፐ ደንዳና” ያግድ ታማርሴስ።<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>ሽን ኤንታዉ እ ገይስ ገልቤና፤ ቃስ እያ ኦይቻናዉካ ያይዶሶና።<verse eid="MRK 9:32"/></para>
  <para style="s1">ኡባፈ አይ ኦኔ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶ 18:1-5</ref>፤ <ref loc="LUK 9:46-48">ሉቃ 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>ኤንቲ ቅፍርናሆማ ካታማ ብድ ሶ ገልዳይሳፈ ጉየ፥ የሱሲ ኤንታኮ፥ “ኦገን አይ ኦደቴቲ?” ያግድ ኦይችስ። <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>ሽን ኤንቲ፥ “ኑ ግዶን ኡባፈ አናይ ኦኔ?” ያግድ ፓላምዳ ግሾ፥ ስእ ግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ 22:24</ref>.</char></note> <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>የሱሲ ኡትድ፥ ታማነ ናምኡ ታማረታ ፄግድ፥ “ኦንካ ስን አናዉ ኮይኮ፥ ኡባፈ ጉየ አድ፥ ኡባስ አይለ ግዳናዉ በሴስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">ማቶ 20:26</ref>.</char></note><verse eid="MRK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36"/>እስ ጉ ናኣ ኤክድ፥ ኤንታ ግዶን ኤስስ፤ ሄ ጉ ናኣ እድምድ ኤንታኮ፥ <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>“ሀይሳ መላ ጉ ናይታፐ እሱዋ ታ ሱንን ሞክያ ኦንካ ታና ሞኬስ፤ ቃስ ታና ሞክያ ኦንካ ታና ኪትዳይሳካ ሞኬስፐ አትሽን፥ ታ ፃላላ ሞከና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ 10:40</ref>፤ <ref loc="LUK 10:16">ሉቃ 10:16</ref>፤ <ref loc="JHN 13:20">ዮሀ 13:20</ref>.</char></note><verse eid="MRK 9:37"/></para>
  <para style="s1">ኑና እፆናይ ኑ ባጋ</para>
  <para style="r">(<ref loc="LUK 9:49-50">ሉቃ 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>ዮሃንስ፥ “አስታማርያዉ፥ እስ አስ ነ ሱንን ቱና አያናታ ከስሽን ኑኒ በእድ፥ ኑ ባጋ ግዶና ግሾ፥ እያ ድግዳ” ያግስ።<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>ሽን የሱሲ፥ “ኦንካ ታ ሱንን ፆሳይ ኦያ ማላታታ ኦድ፥ ኤለስድ ታ ቦላ ኢታባ ኦደታናዉ ዳንዳኤይ ባይና ግሾ ድጎፍተ። <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>ኑባ እፆና ኡራይ ኑ ባጋ።<note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">ማቶ 12:30</ref>፤ <ref loc="LUK 11:23">ሉቃ 11:23</ref>.</char></note> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተ ታባ ግድያ ግሾ፥ ኦንካ ህንተዉ ታ ሱንን ሀሎ ሃ ኡያናዉ እምኮካ፥ ባ ዎይቱዋ ኤካና።<note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">ማቶ 10:42</ref>.</char></note><verse eid="MRK 9:41"/></para>
  <para style="s1">ሀራ አሳስ በ ግዶፓ</para>
  <para style="r">(<ref loc="MAT 18:6-9">ማቶ 18:6-9</ref>፤ <ref loc="LUK 17:1-2">ሉቃ 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>“ታና አማንያ ሀ ጉታፐ እሱዋ ባለያ ኦንካ፥ ጋቻ ዎጋ ዎፃ ባ ቆን ቃችድ፥ አባን ዉልያኮ እያዉ ሎኦ። <verse eid="MRK 9:42"/><verse number="43-44" style="v" sid="MRK 9:43-44"/>ነ ኩሸይ ነና ባለኮ፥ ቃንፃ ሆላ። ኔኒ ናምኡ ኩሸራ ቶኦና ጋናመ ታማን የገተይሳፈ፥ ዱፃ ኩሸራ ደኡዋ ገሎይ ነዉ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">9:43-44 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቶ 5:30</ref>.</char></note> <verse eid="MRK 9:43-44"/><verse number="45-46" style="v" sid="MRK 9:45-46"/>ነ ቶሆይ ነና ባለኮ፥ ቃንፃ ሆላ። ኔኒ ናምኡ ቶሁዋራ ጋናመ ታማን የገተይሳፈ፥ ዎበ ግዳዳ ደኡዋ ገለይስ ነዉ ሎኦ። <verse eid="MRK 9:45-46"/><verse number="47" style="v" sid="MRK 9:47"/>ነ አይፈይ ነና ባለኮ፥ ዎጫ ከሳ ሆላ። ኔኒ ናምኡ አይፍያራ ጋናመ ታማን የገተይሳፈ፥ እስ አይፍያራ ፆሳ ካዎተ ገለይስ ነዉ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቶ 5:29</ref>.</char></note> <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>ያን ኤንታ ምያ ጉፁነይ ሀይቀና፥ ታማይካ ቶኤና።<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">እሳ 66:24</ref>.</char></note><verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>“ያርሾይ ማፅነን ጌየይሳ መላ አስ ኡባይ ታማን ሀርቀታና። <verse eid="MRK 9:49"/><verse number="50" style="v" sid="MRK 9:50"/>ማፅነይ ሎኦ፥ ሽን እ ማልኦና እፅኮ፥ ዛሪድ ዋት ማልኤኔ? ህንተናን ማፅነይ ደኦ። ያንድ፥ እሶይ እሱዋራ ሳሮተን ደእተ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">ማቶ 5:13</ref>፤ <ref loc="LUK 14:34">ሉቃ 14:34</ref>.</char></note><verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">ኤኮ ገሎ ትምርተ</para>
  <para style="r">(<ref loc="MAT 19:1-2">ማቶ 19:1-2</ref>፤ <ref loc="LUK 16:18">ሉቃ 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>የሱሲ ሄሳፈ ደንድድ፥ ይሁዳ ቢታ ብድ ዮርዳኖሰ ሻፋ ፕንስ። ዳሮ አሳይ ዛሪድ እያኮ ሺቅን፥ ካሰይሳዳካ ሄ አሳ ታማርስስ።<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>እስ እስ ፋርሳወት ፓጫናዉ ኮይድ የሱሳ፥ “እስ አስ ባ ማችዉ የዳና መላ ሙሰ ህገይ ኪቲ?” ያግድ እያ ኦይችዶሶና።<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>እ ዛሪድ፥ “ሙሰይ ህንተና ዎይግድ ኪትዴ?” ያግስ።<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>ኤንቲ፥ “ሙሰይ፥ ‘እስ አስ ባ ማቼስ አንጆ ዎርቃተ እምድ የዶ’ ግስ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1">ዛረ 24:1</ref>.</char></note><verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>የሱሲ ዛሪድ፥ ኤንታ “ህንተ ኦድን ስኦናይሳታ ግድያ ግሾ፥ ሙሰይ ሀ ኪታ ህንተዉ ፃፍስ። <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>ሽን ፆሳይ ኮይሮ መያ ዎደ፥ አደነ ማጫ ኦድ፥ ኤንታ መስ።<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">መ 1:27</ref>፤ <ref loc="GEN 5:1">5:1</ref>.</char></note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>ሄሳ ግሾ፥ እስ አስ ባ አዋነ ባ አይዉ አግድ፥ ባ ማቸራ እስፈ ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መ 2:24</ref>.</char></note> <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>ኤንቲ ናምአይ እስ አሰ ግዶሶና፤ ህዛፐ፥ ኤንቲ እስ አሰ ግዶሶናፐ አትሽን፥ ናምኡ አስ ግዶኮና። <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>ሄሳ ግሾ፥ ፆሳይ እስፈ ቃችዳይሳ አስ ሻኮፎ” ያግስ።<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>ኤንቲ ሶ ስምዳ ዎደ፥ እያ ታማረት ሀ ኦዳባ የሱሳ ናምአን ኦይችዶሶና። <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>የሱሲ ኤንታኮ፥ “ባ ማችዉ የድድ ሀራ ኤክያ ኦንካ ላይማቴስ።<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ 5:32</ref>፤ <ref loc="2CO 7:10-11">2 ቆሮ 7:10-11</ref>.</char></note> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>ቃስ ማጫስያካ ባ አዝናፐ ከያዳ ሀራ አዝና ገልኮ ላይማታዉሱ” ያግስ።<verse eid="MRK 10:12"/></para>
  <para style="s1">የሱሲ ዮጋ ናይታ አንጅስ</para>
  <para style="r">(<ref loc="MAT 19:13-15">ማቶ 19:13-15</ref>፤ <ref loc="LUK 18:15-17">ሉቃ 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>የሱሲ ጉ ናይታ ቦላ ባ ኩሽያ ዎና መላ፥ እስ እስ አሳይ ናይታ እያኮ ኤሆሶና፥ ሽን እያ ታማረት ሄ አሳ ሀንቀትዶሶና። <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>የሱሲ ሄሳ በእድ፥ ባ ታማረታ ሀንቀትድ፤ ኤንታኮ፥ “ጉ ናይት ታኮ የይሳ ድጎፍተ፤ ፆሳ ካዎተይ ሀይሳታ መላሳ። <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ፆሳ ካዎተ ጉ ናአዳ ኤኮና ኡራይ ኦንካ ሄ ካዎተ ኡባራካ ገለና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">ማቶ 18:3</ref>.</char></note> <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>ጉ ናይታ እድምድ፥ ባ ኩሽያ ኤንታ እሱዋ እሱዋ ቦላ ዎድ አንጅስ።<verse eid="MRK 10:16"/></para>
  <para style="s1">ዱረ ናአተ ኡራ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቶ 19:16-30</ref>፤ <ref loc="LUK 18:18-30">ሉቃ 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>የሱሲ ባናዉ ከይዳ ዎደ፥ እስ ኡራይ ዎፅ ይድ፥ እያ ስንን ጉልባትድ፥ “ኬሀ አስታማርያዉ፥ ታኒ መርና ደኦ ላታናዉ አይ ኦ?” ያግድ ኦይችስ።<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>የሱሲ፥ “አይስ ታና ኬሀዉ ጋዳ ፄጋይ? ፆሳ ፃላላፐ አትሽን፥ ሀር ኬህ ኦንካ ባዋ። <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>ፆሳ ኪታ፥ ዎፓ፤ ላይማቶፓ፤ ካይሶቶፓ፤ ዎርዶ ማርካቶፋ፤ እንፃርሳን ጭሞፋ፤ ነ አዋነ ነ አይዉ ቦንቻ ያገይሳ ኤራሳ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ከሳ 20:12-16</ref>፤ <ref loc="DEU 5:16-20">ዛረ 5:16-20</ref>.</char></note><verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>ኡራይ፥ “አስታማርያዉ፥ ታኒ ሄሳ ኡባ ናአተፈ ዶማዳ ሀእ ጋካናዉ ናጋይስ” ያግስ።<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>የሱሲ ኡራ ትሽ ኦ ፄልድ ዶስስ፤ “ነዉ እስባይ ፓጬስ፤ ባዳ ነዉ ደእያባ ኡባ ባይዛዳ፥ ሄ ሚሽያ ማንቆታስ እማ፤ ኔኒ ሳሎን ዱረ ግዳና። ያታ ስማዳ ታና ካላ” ያግስ። <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>ሽን ኡራይ ሄሳ ስእድ፥ እ ዳሮ ዱረ ግድያ ግሾ፥ ባ ሶምኡዋ ካሬስ፥ ኡፋይቶና አግድ ብስ።<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>የሱሲ ባ ታማረታ ዩሽ አ ፄልድ፥ “ዱረ አስ ፆሳ ካዎተ ገላናይስ ዋንድ መታንዴሻ!” ያግስ።<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>እያ ታማረት እያ ትምርትያ ስእድ ማላለትዶሶና። ሽን የሱሲ ቃስካ ኤንታኮ፥ “ናይቶ፥ ፆሳ ካዎተ ገላናይስ ዋንድ መታንዴሻ! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>ዱረ አስ ፆሳ ካዎተ ገላናይሳፈ፥ ግማለይ ናርፐ ሉሆራ አይስ ካዉዬስ” ያግስ።<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>እያ ታማረት ማላለትድ፥ “ያትን፥ ኦን አታኔ?” ያግድ፥ እሶይ እሱዋ ኦይችዶሶና።<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>የሱሲ ኤንታ ትሽ ኦ ፄልድ፥ “ሀይስ ፆሳስ ዳንዳኤተስፐ አትሽን፥ አሳስ ዳንዳኤተና፤ ፆሳስ ኡባባይ ዳንዳኤቴስ” ያግስ።<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>ጰፅሮስ የሱሳኮ፥ “ሄኮ፤ ኑኒ ኑባ ኡባ አግድ፥ ነና ካልዳ” ያግስ።<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>የሱሲ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ታ ግሾነ ዎንገላ ግሾ፥ ኬ ዎይኮ እሻታ ዎይኮ ምቸታ ዎይኮ አዋ ዎይኮ አዮ ዎይኮ ማችዉ ዎይኮ ናይታ ዎይኮ ጋደ አግዳ ኦንካ፥ <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>ሀእ ሀ ዎድያን ፄቱ ኩሸ ኬ፥ እሻታ፥ ምቸታ፥ አየታ፥ ናይታ፥ ጋድያ፥ ጎደተራ እስፈ ኤካና። ስንፈ ያና ዎድያንካ መርና ደኡዋ ኤካና። <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>ሽን ዳሮት ሀእ ደን ስን ግድዳይሳት ጉየ ግዳና፥ ቃስ ዳሮት ሀእ ጉየ ግድዳይሳት ስን ግዳና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">ማቶ 20:16</ref>፤ <ref loc="LUK 13:30">ሉቃ 13:30</ref>.</char></note><verse eid="MRK 10:31"/></para>
  <para style="s1">የሱሲ ባ ሀይቁዋባ ሄን ኦድስ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶ 20:17-19</ref>፤ <ref loc="LUK 18:31-34">ሉቃ 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>የሱሳራነ እያ ታማረታራ የሩሳላመ ብሽን፥ የሱሲ ባ ታማረታ ስንን ሄመቴስ። ኤንቲ ማላለትዶሶና። እያ ካለይሳትካ ያይዶሶና። ናምአን፥ ታማነ ናምኡ ታማረታ ጋፃ ከስድ፥ ባና ጋካናባ ዱማ ኤንታዉ ሀይሳዳ ያግድ ኦድስ። <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>“ሄኮ፥ ኑኒ የሩሳላመ ሀእ ከዮስ። ያን አሳ ናአይ፥ ካህነ ሀላቃታስነ ህገ አስታማረታስ አድ እመታና። ኤንቲ እያ ቦላ ሀይቆ ፕርዳ ፕርዳና፤ ቃስ አይሁደ ግዶና ደርያስ እያ አድ እማና። <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>አይሁደ ግዶና ደረይ እያ ቶቻና፥ እያ ቦላ ጩታና፥ ልሶን ጋራፋናነ ዎና። እ ሄ ጋላሳፐ ጉየ፥ ሀይቆፐ ደንዳና” ያግስ።<verse eid="MRK 10:34"/></para>
  <para style="s1">ያይቆባነ ዮሃንሳ ዎሳ</para>
  <para style="r">(<ref loc="MAT 20:20-28">ማቶ 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>ዛብድዮሳ ናይት ያይቆብነ ዮሃንስ የሱሳኮ ይድ፥ “አስታማርያዉ፥ ኑኒ ነና ዎስያ እስባ ኑስ ኦርክ” ያግዶሶና።<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>የሱሲ ኤንታኮ፥ “ታኒ ህንተዉ አይ ኦ?” ያግስ።<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>ኤንቲ፥ “ኔኒ ነ ቦንቾ ካዎተን ኡትያ ዎደ፥ ኑፐ እሱዋ ኡሻቻ ባጋራ ቃስ እሱዋ ሀድርሳ ባጋራ ኡትሳርክ” ያግዶሶና።<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>ሽን የሱሲ ኤንታኮ፥ “ህንተ አይ ዎስያኮ ኤረከታ፥ ታ ኡያናዉ ደእያ ፁኣ ኡያናዉ ዳንዳኤቲ? ቃስ ታኒ ፃማቀታናዉ ደእያ ፅንቃትያ ፃማቀታናዉ ዳንዳኤቲ?” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">ሉቃ 12:50</ref>.</char></note><verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>ኤንቲ ዛሪድ፥ “ኤ ዳንዳኦስ” ያግዶሶና።</para>
  <para style="p" vid="MRK 10:39">የሱሲ ቃስ፥ “ቱማካ ታ ኡያናዉ ደእያ ፁኣ ህንተ ኡያና፥ ታኒ ፃማቀታናዉ ደእያ ፅንቃትያ ህንተ ፃማቀታና። <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>ሽን ታፐ ኡሻቻ ባጋራነ ሀድርሳ ባጋራ ኡታናይሳታ ዶራናዉ ታዉ ማት ባዋ፥ ሽን ሄ በሳይ ፆሳይ እማናዉ ጊግስድ ዎዳይሳታሳ” ያግስ።<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>ሀንኮ ታሙ ታማረት ሄሳ ስእዳ ዎደ፥ ያይቆባነ ዮሃንሳ ቦላ ሀንቀትዶሶና። <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>የሱሲ ኤንታ ኡባ ባኮ ፄግድ፥ “አይሁደ ግዶና አሳ ሀላቃት ደርያ ሃረይሳታ ጌተትድ ፄገተይሳነ ሃረይሳታስ ደርያ ቦላ ማት ደኤይሳ ህንተ ኤሬታ።<note caller="-" style="x"><char style="xo" closed="false">10:42 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">ሉቃ 22:25-26</ref>፤ <ref loc="MAT 23:11">ማቶ 23:11</ref>፤ <ref loc="MRK 9:35">ማር 9:35</ref>፤ <ref loc="LUK 22:26">ሉቃ 22:26</ref>.</char></note> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>ሽን ህንተ ግዶን ሄሳ መላ ግደና፤ ህንተ ግዶን ግታታናዉ ኮየይ ኦንካ ህንተዉ አይለ ግዳናዉ በሴስ። <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>ቃስ ህንተ ግዶን ኡባፈ ቦላ ግዳናዉ ኮየይ ኦንካ ህንተ ኡባስ አይለ ግዳናዉ በሴስ። <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>ሀር አቶሽን፥ አሳ ናአይካ፥ አሳስ ኦናዉነ ዳሮታ ዎዛናዉ ባ ሸምፑዋ አድ እማናዉ ይስፐ አትሽን፥ አስ እያዉ ኦና መላ ይቤና” ያግስ።<verse eid="MRK 10:45"/></para>
  <para style="s1">ቆቅያ ባርፅሞሳ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቶ 20:29-34</ref>፤ <ref loc="LUK 18:35-43">ሉቃ 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>ኤንቲ እያርኮ ካታማ ብዶሶና። የሱሲ ባ ታማረታራነ ዳሮ አሳራ እያርኮፈ ከይሽን፥ ፅሞሳ ናአይ፥ ቆቀይ፥ ባርፅሞሳ ጌተተይስ፥ ኦገ ጋፃን ዎስሸ ኡትስ። <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>ባርፅሞስ፥ ያራ አይ ናዝረተ የሱሳ ግድዳይሳ ስእዳ ዎደ፥ ባ ቃላ ቁ ኦድ፥ “ዳዊታ ናኣ የሱሳ፥ ታና ማራርክ!” ያግድ ዋሶ ዶምስ።<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>ዳሮ አሳይ እያ፥ “ሀይዛ!” ግድ ሀንቀትዶሶና።</para>
  <para style="p" vid="MRK 10:48">ሽን፥ እ ባ ቃላ ካሰይሳፈ ዳሮ ቁ ኦድ፥ “ዳዊታ ናአዉ፥ ታና ማራርክ!” ያግስ።<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>የሱሲ ኤቅድ፥ “እያ ሃ ፄግተ” ያግስ።</para>
  <para style="p" vid="MRK 10:49">ኤንቲ ቆቅያኮ፥ “አይኮይ ባዋ፥ ደንዳ ኤቃ፥ ነና ፄጌስ” ያግዶሶና። <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>ቆቀይ ባ ማኡዋ ሆል የግድ፥ ጉፕ ደንድ ኤቅድ፥ የሱሳኮ ብስ።<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>የሱሲ፥ “ታኒ ነዉ አይ ኦና መላ ኮያይ?” ያግስ።</para>
  <para style="p" vid="MRK 10:51">ቆቀይ፥ “አስታማርያዉ፥ ታ ፄላናዉ ኮያይስ” ያግስ።<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>የሱሲ፥ “ባ፥ ነ አማኖይ ነና ፓስ” ያግስ። ኢራካ እያ አይፈይ ፄልን፥ የሱሳ ካልስ።<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">ግታ ቦንቾን የሩሳላመ ገሉዋ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ 21:1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ 19:28-40</ref>፤ <ref loc="JHN 12:12-19">ዮሀ 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>ኤንቲ የሩሳላመ ማትሸ፥ ሻማሆ ዙማ ማታን ደእያ ቤተፋገነ ብታነ ካታማታ ጋክዶሶና። የሱሲ ባ ታማረታፐ ናምአታ ስን ኪትድ፥ <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>“ህንተፈ ስንን ደእያ ጉታ ቢተ፤ ያ ገልዳ መላ ኦንካ ቶግቦና ቃሾን ደእያ ሀረ ማር ህንተ ደማና፥ እያ ብልድ፥ ሃ ኤክ ዪተ። <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>ኦንካ ህንተና፥ ‘ሀይሳ አይስ ኦቲ?’ ያግድ ኦይችኮ፥ ‘ጎዳይ እያ ኮዬስ፥ ኤለስድ ሃ የዳና’ ያግተ” ያግስ።<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>ኤንቲ ብድ፥ ሀረ ማር ካረ ቦላ ኦገ ማታን ቃሸትድ ደኤይሳ ደምድ ብልዶሶና። <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>ሄ በሳን ኤቅዳ እስ እስ አሳት ኤንታኮ፥ “ሀረ ማራ ዋታናዉ ብሌቲ?” ያግድ ኦይችዶሶና። <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>እያ ታማረት የሱሲ ባንታና ኪትዳይሳ ኦድን፥ አሳት የድ አግዶሶና። <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>ኤንቲ ሀረ ማራ የሱሳኮ ኤህድ፥ ባንታ ማኡዋ እያ ዞኮን ሂፅን የሱሲ ሄ ሀረ ማራ ቶግስ። <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>ዳሮ አሳይ ባንታ ማኡዋ ኦግያን ሂፅዶሶና፤ ቃስ ሀራት ም ታሸ ታሽድ፥ ኦገን ሂፅዶሶና። <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>የሱሳፐ ስንራ ሄመትያ አሳይነ እያ ካልያ አሳይ ባንታ ቃላ ቁ ኦድ፥</para>
  <para style="q1" vid="MRK 11:9">“ሆሳና!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fk" closed="false">ሆሳና፦ </char><char style="ft" closed="false">ማቶ 21:9 በእተ።</char></note> ፆሳይ ጋላተቶ!</para>
  <para style="q2" vid="MRK 11:9">ጎዳ ሱንን የይስ አንጀትዳይሳ።<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">ማዝ 118:25</ref>.</char></note><verse eid="MRK 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10"/>ጎዳ ሱንን ያ ኑ አዋ</para>
  <para style="q2" vid="MRK 11:10">ዳዊታ ካዎተይ አንጀትዳይሳ።</para>
  <para style="q1" vid="MRK 11:10">ኡባፈ ቦላ ሳሎን</para>
  <para style="q2" vid="MRK 11:10">ደእያ ፆሳይ ጋላተቶ”</para>
  <para style="m" vid="MRK 11:10">ያግዶሶና።<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>የሱሲ የሩሳላመ ብድ፥ ፆሳ ኬ ገልስ። ቃስ ኡባባ ዩይ ፄልዳፐ ጉየ፥ ሳእ ቃምያ ግሾ፥ ታማነ ናምኡ ታማረታራ ብታነ ካታማ ብስ።<verse eid="MRK 11:11"/></para>
  <para style="s1">የሱሲ ባድዳ ባላሰ ምዉ</para>
  <para style="r">(<ref loc="MAT 21:18-19">ማቶ 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>ዎንተ ጋላስ ኤንቲ ብታነፐ ከይድ ብሽን፥ የሱሲ ኮሻትስ። <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>ሃሆን እስ ባላሰ ምዉ ሀይ ፃላላ ማአ ኡትዳሮ በእድ፥ እ ቦላ አይፈይ በንትኮ ግድ፥ በአናዉ ኢኮ ብስ፥ ሽን ኢኮ እ ብያ ዎደ፥ ሀይ ፃላላፐ አትሽን፥ እስ አይፈካ ደምቤና፤ አይስ ጊኮ፥ ባላሰይ አይፍያ ዎደይ ጋክቤና። <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>የሱሲ ሄ ባላስዉ፥ “ህዛ፥ አስ ኔፐ መርናዉ አይፈ ሞፖ” ያግስ። እያ ታማረት እ ገይሳ ስእዶሶና።<verse eid="MRK 11:14"/></para>
  <para style="s1">ፆሳ ኬን ዛልኤይሳታ ከስስ</para>
  <para style="r">(<ref loc="MAT 21:12-17">ማቶ 21:12-17</ref>፤ <ref loc="LUK 19:45-48">ሉቃ 19:45-48</ref>፤ <ref loc="JHN 2:13-22">ዮሀ 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>ኤንቲ የሩሳላመ ብዶሶና፤ የሱሲ ፆሳ ኬ ገልድ፥ ያን ባይዘይሳታነ ሻመይሳታ ካረ ጎዶ ኦይክስ፤ ቃስ ሚሸ ላመይሳታ ፃርጴዛነ ሆለ ባይዘይሳታ ኦይድያ ሽር የግድ፥ <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>አስ አይብባካ ቶክድ፥ ፆሳ ኬ ግዶራ አና መላ ድግስ። <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>የሱሲ አሳ ሀይሳዳ ያግድ ታማርስስ፦ “ጌሻ ማፃፋን፥ ‘ታ ኬይ አስ ኡባይ ፆሳ ዎስያ ኬ ግዳና’ ጌተትድ ፃፈትስ። ሽን ህንተ እያ ፓንጋት ቆሰትያ ጎንጎሎ ኦደታ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">እሳ 56:7</ref>፤ <ref loc="JER 7:11">ኤርም 7:11</ref>.</char></note><verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>ካህነ ሀላቃትነ ህገ አስታማረት ሄሳ ስእድ፥ እያ ዎናዉ ኦገ ኮይዶሶና። ሽን ዳሮ አሳይ እያ ትምርትያን ማላለትያ ግሾ፥ እያዉ ባብዶሶና።<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>ሳአይ ኦማርስያ ዎደ የሱሲነ እያ ታማረት ካታማፐ ጋፃ ከይዶሶና።<verse eid="MRK 11:19"/></para>
  <para style="s1">ባላሰ ምያ መላሱ</para>
  <para style="r">(<ref loc="MAT 21:20-22">ማቶ 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>ኤንቲ ዎንተ ጋላስ ሄ ኦግያራ አሸ፥ ሄ ባላስያ ፃጶራ መልዳሮ በእዶሶና። <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>ጰፅሮስ አኬክድ፥ “አስታማርያዉ፥ ሄኮ፥ ኔኒ ባድዳ ባላስያ መላሱ” ያግስ።<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>የሱሲ ዛሪድ፥ “ፆሳ አማንተ። <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ኦንካ ባ ዎዛናን ስና ግዳባይ ሀናናይሳ አማንድ፥ ሀ ዙማ፥ ‘ደንዳዳ አባን ኩንዳ’ ያግኮ እያዉ ሀናና።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ 17:20</ref>፤ <ref loc="2CO 13:2">2 ቆሮ 13:2</ref>.</char></note> <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>ሄሳ ግሾ፥ ታኒ ህንተዉ ኦዳይስ፤ ፆሳ ህንተ ዎስያባነ ኦይችያባ አይባ ግድኮካ ኤክዳዳ አማንተ፥ ህንተ ኤካና። <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>ፆሳ ዎሳናዉ ህንተ ኤቅያ ዎደ፥ ሳሎን ደእያ ህንተ አዋይ ህንተ ናጋራ አቶ ጋና መላ፥ ኦንካ ህንተና ናቅዳባይ ደእኮ፥ እያዉ አቶ ጊተ። <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>ሽን አሳ ናጋራ ህንተ አቶ ጎና እፅኮ፥ ሳሎን ደእያ ህንተ አዋይካ ህንተ ናጋራ ህንተዉ አቶ ጌና” ያግስ።<verse eid="MRK 11:26"/></para>
  <para style="s1">የሱሳ ማታይ ኦይሸትስ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶ 21:23-27</ref>፤ <ref loc="LUK 20:1-8">ሉቃ 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>ኤንቲ ዛሪድ የሩሳላመ ብዶሶና። የሱሲ ፆሳ ኬን ሄመትሽን፥ ካህነ ሀላቃት፥ ህገ አስታማረትነ ጭማት እያኮ ይድ፥ <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>“ኔኒ ሀይሳ ኦናዉ ነዉ አይ ማት ደኢ? ዎይኮ ነዉ ሀ ማታ እምዳይ ኦኔ?” ያግዶሶና።<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>የሱሲ ዛሪድ፥ “ታ ህንተና እስባ ኦይቻና፥ ታዉ ኦድተ። ታ ቃስ ሀይሳ አይ ማታን ኦያኮ፥ ህንተዉ ኦዳና። <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>ዮሃንሳ ፅንቃተይ ፆሳፈየ ዎይኮ አሳፔ? ታዉ ኦድተ” ያግስ።<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>ኤንቲ ባንታ ግዶን ፓላማ ዶምድ፥ “ኑኒ፥ ‘ፆሳፈ’ ጊኮ፥ እ ኑኮ፥ ‘ያትን፥ ዮሃንስ ኦድዳይሳ አይስ አማንበከቲ?’ ያጋና። <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>‘አሳፐ ጊኮ’ አሳ ኡባይ ዮሃንስ ናበ ግደይሳ ኤሮሶና።” ሄሳ ግሾ፥ አሳስ ያይዶሶና። <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>ሄሳ ግሾ፥ ኤንቲ የሱሳኮ፥ “ኑኒ ኤሮኮ” ያግድ ዛርዶሶና።</para>
  <para style="p" vid="MRK 11:33">የሱሲ፥ “ታንካ ሀይሳ አይ ማታን ኦያኮ፥ ህንተዉ ኦድከ” ያግስ።<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">ጎሻንቾታ ሌምሶ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶ 21:33-46</ref>፤ <ref loc="LUK 20:9-19">ሉቃ 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>የሱሲ ኤንታዉ ሌምሶን ያግድ ኦድስ፦ “እስ ኡራይ ዎይነ ቶክድ፥ እያ ዩሾን ድርስ ድርስ። ቃስ ሄ ዎይነ ጉምእያ ኦላ ቦክስ። እያ ናጋናዉ አዱሳ ሻኮ ሻክስ። ሄሳፈ ጉየ፥ ኮ ኦያ አሳስ እምድ፥ ሀራ ቢታ ብስ።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ISA 5:1">እሳ 5:1</ref>.</char></note> <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>ዎይነ አይፍያ ማፅያ ዎደይ ጋክን፥ ባና ጋክያ ግሹዋ ኤሀና መላ፥ እስ ባ አይልያ ኮ አዋታኮ የድስ። <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>ኮ አዋት እያ አይልያ ኦይክድ ዋድ፥ መላ ኩሸ የድዶሶና። <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>ናምአን ሀራ አይለ ኤንታኮ ኪትን፥ ኤንቲ ሄ አይልያ ሁጵያ ቆእድ ካዉሽድ የድዶሶና። <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>ዎይነ አታክልትያ ጎዳይ ቃስካ ሀራ አይለ ኪትስ። ሄ አይልያ ዎዶሶና፥ ቃስ ሀራ ዳሮታ ሄሳዳ ኦዶሶና፥ እሶታ እሶታ ዋድ፥ ሀራታ ዎዶሶና።<verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>“ዎይነ አታክልትያ ጎዳስ ኪታናዉ ኡባፈ ዉርሰን እ ዳሮ ዶስያ ባ ናኣ ፃላል አትስ። እ፥ ‘ኤንቲ ታ ናኣ ቦንቾና አጎኮና’ ግድ፥ ባ ናኣ ኤንታኮ ኪትስ።<verse eid="MRK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7"/>“ሽን ኮ አዋት ባንታ ግዶን፥ ‘ላታናይስ ሀይሳ፤ የተ እያ ዎኦስ፤ እያ ላታይ ኑባ ግዳና!’ ያግዶሶና። <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>ናኣ ኦይክድ ዎድ፥ እያ አሀ ዎይነ ጋድያ ግዶፈ ጋፃ ከስድ የግዶሶና።<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>“ህዛ፥ ዎይነ ጋድያ ጎዳይ ዋታኔ? ይድ ሄ ኮ አዋታ ዎ ኦንግድ፥ ዎይንያ ኮ ኦያ ሀራ አሳስ እማና።<verse eid="MRK 12:9"/></para>
  <para style="q1">
    <verse number="10-11" style="v" sid="MRK 12:10-11"/>“ ‘ግምበይሳት ቦርድ እፅዳ ሹቻይ</para>
  <para style="q2" vid="MRK 12:10-11">ጎዳ ፃጱዋ ምንያ፥</para>
  <para style="q2" vid="MRK 12:10-11">ኡባፈ አያ ሹቹ ግድስ።</para>
  <para style="q1" vid="MRK 12:10-11">ሀይስ ጎዳይ ኦዳባ፤</para>
  <para style="q2" vid="MRK 12:10-11">ቃስ ኑ አይፍያስካ ማላልስያባ’</para>
  <para style="m" vid="MRK 12:10-11">ያገይሳ ጌሻ ማፃፋፐ ናባብበከቲ?” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">12:10-11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">ማዝ 118:22-23</ref>.</char></note><verse eid="MRK 12:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>ካህነ ሀላቃት፥ ህገ አስታማረትነ ጭማት የሱሲ ሄ ሌምሱዋ ባንታ ቦላ ሌምስዳይሳ ኤርዳ ግሾ፥ እያ ኦይካናዉ ኮይዶሶና፥ ሽን አሳስ ያይድ፥ አግድ ብዶሶና።<verse eid="MRK 12:12"/></para>
  <para style="s1">ጊራባ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶ 22:15-22</ref>፤ <ref loc="LUK 20:20-26">ሉቃ 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>ቃስ እያ ኦዳፐ ባላ ደምድ፥ እያ ኦይካና መላ፥ ፋርሳወታፐነ ሄሮዲሳ ባጋታፐ ጉ አሳታ እያኮ ኪትዶሶና። <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>ኤንቲ እያኮ ይድ፥ “አስታማርያዉ፥ ኔኒ ቱማ ኦደተይሳነ አሳፐ አሰ ሻኮናይሳ ኑኒ ኤሮስ። ኔኒ አሰ ዱማያካ፤ ቃስ ፆሳ ኦግያ ቱማተን ታማርሳሳ። ኑኒ ሮመ ቢታ ካዋ ቄሳረስ ጊራ ጊረይስ ዎገየ ዎጋ ግደኔ? ጊራ ጊራነ አጋኔ?” ያግዶሶና።<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>ሽን የሱሲ ኤንታ ጩቦተ ኤርድ፥ “ታና አይስ ፓጨቲ? አነ እስ ሳንትመ ታና በስተ” ያግስ። <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>ኤንቲ እያዉ ኤህዶሶና፥ “ሀ ምስለይነ ሱንይ ኦደባዬ?” ያግድ ኤንታ ኦይችስ።</para>
  <para style="p" vid="MRK 12:16">ኤንቲ፥ “ሮመ ካዋ ቄሳረይሳ” ያግዶሶና።<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>የሱሲ ዛሪድ፥ “ያትኮ፥ ቄሳረባ ቄሳረስ፥ ፆሳባ ፆሳስ እምተ” ያግን ኤንቲ እያባ ማላለትዶሶና።<verse eid="MRK 12:17"/></para>
  <para style="s1">ሀይቆፐ ደንዶባ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶ 22:23-33</ref>፤ <ref loc="LUK 20:27-40">ሉቃ 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>ሀይቅዳ አስ ደንደና ግያ ሳዱቃወታፐ እስ እስ አሳት የሱሳኮ ይድ፥ ሀይሳዳ ያግድ፥ እያ ኦይችዶሶና።<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሀዋ 23:8</ref>.</char></note> <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>“አስታማርያዉ፥ ሙሰይ ኑስ ህግያ ፃፍሸ፥ ‘ማቾ ኤክዳ አስ ናአ የሎና ሀይቅኮ፥ ሄ ሀይቅዳይሳ እሻይ እያ ማችዉ ኤክድ፥ ባ እሻስ ናአ የላናዉ በሴስ’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዛረ 25:5</ref>.</char></note> <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>በን ዎደ ላፑን እሻት ደኤይሳታፐ ባይራይ ማቾ ኤክድ፥ ናአ የሎና ሀይቅስ። <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>ናምአንይ እዮ ኤክስ፥ እካ ናአ የሎና ሀይቅስ። ሄንይካ ሄሳዳ ሀንስ። <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>ላፑናትካ ሄሳ እዮ ኤክድ፥ ናአ የሎና ሀይቅዶሶና። ኡባፈ ጉየ፥ ቃስ ሄ ማጫስያ ሀይቃሱ። <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>ያትን፥ ላፑናት እዮ ኤክዳ ግሾ ሀይቅዳ አሳይ ሀይቆፐ ደንድያ ጋላስ፥ እያ ኤንታፈ አዉሳስ ማቾ ግዳኔ?” ያግዶሶና።<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>የሱሲ ዛሪድ፥ “ህንተ ባለተይ፥ ጌሻ ማፃፋታ ዎይኮ ፆሳ ዎልቃ ኤሮና ግሾሳ! <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>ሀይቅዳ አሳይ ሀይቆፐ ደንድያ ጋላስ፥ ሳሎን ደእያ ኪታንቾታ መላ ግዳናፐ አትሽን፥ ኤኮኮና፤ ገለኮና። <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>ሽን ሀይቅዳይሳታ ደንዱዋባ ግድኮ፥ ሙሰ ማፃፋን ፃፈትዳ ፁገትያ ቱሽያባ ኦድያ በሳን፥ ፆሳይ ሙሰኮ፥ ‘ታኒ፥ አብራሃመ ፆሳ፥ ይሳቃ ፆሳ፥ ያይቆባ ፆሳ’ ግዳይሳ ናባብበከቲ?<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከሳ 3:6</ref>.</char></note> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>ሄሳ ግሾ፥ እ፥ ፓፃ ደኤይሳታ ፆሳፈ አትሽን፥ ሀይቅዳይሳታ ፆሰ ግደና። ህንተ ዳሮ ባልደታ” ያግስ።<verse eid="MRK 12:27"/></para>
  <para style="s1">ኡባፈ ባይራ ኪታ</para>
  <para style="r">(<ref loc="MAT 22:34-40">ማቶ 22:34-40</ref>፤ <ref loc="LUK 10:25-28">ሉቃ 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>ህገ አስታማረታፐ እሶይ ኤንቲ ፓላመይሳ ሺቅድ ስእስ። ቃስ የሱሲ ኤንታዉ ሎይ ዛርዳይሳ ስእድ፥ “ኪታ ኡባፈ አያ ኪታይ አዉሴ?” ያግድ የሱሳ ኦይችስ።<note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ 10:25-28</ref>.</char></note><verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>የሱሲ ዛሪድ፥ እያ ሀይሳዳ ያግስ፦ “ኪታ ኡባፈ አያ ኪታ ስእተ፤ ‘እስራኤለ አሳዉ፥ ጎዳይ ኑ ፆሳይ እስ ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">ዛረ 6:4-5</ref>.</char></note> <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>ነ ጎዳ ነ ፆሳ ነ ኩመ ዎዛናፐ፥ ነ ኩመ ሸምፑዋፈ፥ ነ ኩመ ቆፋፐ፥ ነ ኩመ ዎልቃፈ ዶሳ’ ያጌስ። <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>ቃስ ኪታ ኡባፈ አያ ናምአን ኪታይ ሀይሳ፤ ‘አሰ ኡባ ነ ሁጵያዳ ዶሳ’ ያገይሳ፤ ሀይሳታፐ አያ ሀራ ኪት ባዋ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌወ 19:18</ref>.</char></note><verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>ህገ አስታማረይ የሱሳኮ፥ “አስታማርያዉ፥ ቱማ ጋዳሳ፤ ኔኒ ‘ፆሳይ እስ ፆሳ ፃላላ። እያፐ አትሽን፥ ሀር ባዋ’ ግዳይስ ቱማ።<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">ዛረ 4:35</ref>.</char></note> <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>ፆሳ ኩመ ዎዛናፐ፥ ኩመ ቆፋፐነ ኩመ ዎልቃፈ ዶሰይስነ ቃስ አሰ ኡባ ባ ሁጵያዳ ዶሰይስ፥ ፁሳ ያርሾፈነ ሀራ ያርሾ ኡባፈ አስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">ሆሰ 6:6</ref>.</char></note><verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>የሱሲ ህገ አስታማርያ ዛሮይ አዳ ኤራንቾ አሳ ዛሮ ግድዳይሳ በእድ፥ “ኔኒ ፆሳ ካዎተፈ ሃካባካ” ያግስ፤ ሄሳፈ ጉየ፥ የሱሳ ሀራባ ኦይቻናዉ ኦንካ ምንቤና።<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ 10:25-28</ref>.</char></note><verse eid="MRK 12:34"/></para>
  <para style="s1">ክርስቶስ ኦደ ናኤ?</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶ 22:41-46</ref>፤ <ref loc="LUK 20:41-46">ሉቃ 20:41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>የሱሲ ፆሳ ኬን ታማርስሸ፥ ሀይሳዳ ያግስ፦ “ህገ አስታማረት ክርስቶሳ ዎይግድ ዳዊታ ናአ ጎና? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>ዳዊቲ ጌሻ አያናን ኩምድ፥</para>
  <para style="q1" vid="MRK 12:36">“ ‘ጎዳይ፥ ታ ጎዳ፥ “ታኒ ነ ሞርከታ</para>
  <para style="q2" vid="MRK 12:36">ነ ቶሆይ የያሶ ኦና ጋካናዉ፥</para>
  <para style="q2" vid="MRK 12:36">ሀይሳን ታፐ ኡሻቻ ባጋራ ኡታ” ግስ’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ 110:1</ref>.</char></note><verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>ዳዊቲ ባ ሁጰን ክርስቶሳ፥ ‘ጎዳ’ ግድ ፄግኮ፥ ያትን፥ ክርስቶስ ዋንድ፥ ዳዊታ ናአ ግድ?” ያግስ።</para>
  <para style="p" vid="MRK 12:37">ዳሮ አሳይ የሱሲ ገይሳ ኡፋይሳን ስእዶሶና።<verse eid="MRK 12:37"/></para>
  <para style="s1">ህገ አስታማረታነ ፋርሳወታ አየ!</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ 23:1-36</ref>፤ <ref loc="LUK 20:45-47">ሉቃ 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>የሱሲ ታማርስሸ፥ ሀይሳዳ ያግስ፦ “ህገ አስታማረታፐ ናገትተ፤ ኤንቲ አዱሳ ማኦ ማእድ ዩየይሳነ ግያንካ አሳይ ኤንታ ቦንችድ ሳሮይሳ ዶሶሶና። <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>ኤንቲ አይሁደ ዎሳ ኬታን ዳሮ ሎእያ ኦይድያ ዶሶሶና፤ ቃስ አስ ባንታና ሞክያ በሳን ቦንቾ በሲ ዶሶሶና። <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>ኤንቲ አምኤታ ኬ ቦንቅድ፥ ባንታዉ ሎኦ ዳናናዉ ዎሳ አዱሶሶና፤ ኤንቲ ኡባፈ አያ ፕርዳ ኤካና” ያግስ።<verse eid="MRK 12:40"/></para>
  <para style="s1">አምኤ ሙፃታ</para>
  <para style="r">(<ref loc="LUK 21:1-4">ሉቃ 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>የሱሲ ፆሳ ኬን ሙፃታ የግያ ሳፅንያ ማታን ኡትድ፥ አሳይ ባ ሚሽያ ሄ ሳፅንያን የገይሳ በእስ፤ ዳሮ ዱረ አሳይ ዳሮ ሚሽያ ሄ ሳፅንያን የጎሶና። <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>እስ ማንቆ አምእያ ያዳ፥ ናምኡ ባካና ሄ ሳፅንያን የጋሱ። <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>የሱሲ ባ ታማረታ ፄግድ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ሙፃታ ሳፅንያን የግዳ አሳ ኡባፈ ሀ ማንቆ አምእያ ዳርሳዳ የጋሱ። <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>አይስ ጊኮ፥ ሀራት ኡባይ ባንታዉ ፓላህዳ ሚሽያፐ የግዶሶና። ሽን እያ ባ ፓጫፐ፥ ባዉ ደእያ አቁዋ ኩመ እማሱ” ያግስ።<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">ፆሳ ኬይ ላለቶና አተና</para>
  <para style="r">(<ref loc="MAT 24:1-2">ማቶ 24:1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>የሱሲ ፆሳ ኬፈ ከይሽን፥ እያ ታማረታፐ እሶይ፥ “አስታማርያዉ፥ ሀ ሎኦ ሹቻነ ሀ ሎኦ ሹቻ ኬ በአይ!” ያግስ።<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>የሱሲ ዛሪድ፥ “ሀ ግታ ሹቻ ኬ በአይ? ሀ ኬይ ሹች ሹቻ ቦላ ግምበትዳ መላ ላለቶና አተና፤ እስ ሹችካ አቶና ኡባይ ላለታና” ያግስ።<verse eid="MRK 13:2"/></para>
  <para style="s1">ዎደ ዉርሰ ማላታታ</para>
  <para style="r">(<ref loc="MAT 24:3-14">ማቶ 24:3-14</ref>፤ <ref loc="LUK 21:7-19">ሉቃ 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>የሱሲ ፆሳ ኬፈ ህን ባጋራ ሻማሆ ዙማ ቦላ ኡትዳሽን፥ ጰፅሮስ፥ ያይቆብ፥ ዮሃንስነ እንድርያስ ባንታርካ እያኮ ይድ፥ <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>“ሀይስ አዉደ ሀናኔኮ፥ ኑስ ኦዳ፤ ሀ ኡባይ ፖለታና ዎድያ ኤርስያ ማላታይ አይቤ?” ያግድ ኦይችዶሶና።<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>የሱሲ ቃስ ኤንታኮ ሀይሳዳ ያግድ ኦድስ። “ህንተና ኦንካ ባለና መላ ናገትተ። <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>ዳሮ አሳት ታ ሱንን፥ ‘ታኒ ክርስቶሳ’ ያግድ ታማርስሸ ይድ፥ ዳሮ አሳ ባለና። <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>ማታን ደእያ ኦላነ ሃሆን ደእያ ኦላ ዎረ ህንተ ስእያ ዎደ ህርጎፍተ። ሄሳ መላባይ ሀናናዉ በሴስ፥ ሽን ዉርሰይ ቡሮና። <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>እስ ቢታ አሳይ ሀራ ቢታ አሳራ ኦለታና፤ ቃስ እስ ካዎተይ ሀራ ካዎተታራ ኦለታና፤ ቢታ ቃፆይ ኡባ በሳን ሀናና፤ ኮሻይ ዳና፥ ሽን ሄስ ኡባይ የሎ እቀስ ዞከ መላ።<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>“ሽን ህንተ፥ ህንተ ሁጰን ናገትተ። አይስ ጊኮ፥ አስ ህንተና ኦይክድ፥ ፕርዳ ኬስ አድ እማና፤ ቃስ አይሁደ ዎሳ ኬታንካ ህንተና ልሶን ጋራፋና፤ ደርያ ሃረይሳታ ስንንነ ካዎታ ስንን ታ ግሾ ህንተ ማርካታናዉ ኤቃና።<note caller="-" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">ማቶ 10:17-20</ref>፤ <ref loc="LUK 12:11-12">ሉቃ 12:11-12</ref>.</char></note> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>ዉርሰይ ጋካናፐ ስን ዎንገላይ ኮይሮ ደረ ኡባስ ኦደታናዉ በሴስ። <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>ኤንቲ ህንተና ፕርዳ ኬ ኤህያ ዎደነ አድ እምያ ዎደ፥ ዎይግድ ኦዳነኮ ኮይሮ ህርጎፍተ፤ ሄ ሳትያን ፆሳይ ህንተዉ እምያባ ኦድተ። ህንተናን ጌሻ አያናይ ኦደቴስፐ አትሽን፥ ህንተና ግደከታ።<verse eid="MRK 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12"/>“እሻይ ባ እሻ፥ አዋይ ባ ናኣ ዎሳና። ናይት ባንታና የልዳይሳታ ቦላ ደንድድ፥ ኤንታ ዎሳና። <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>አሳ ኡባይ ህንተና ታ ሱን ግሾ እፃና፥ ሽን ዉርሰ ጋካናዉ ምንዳይ አታና።<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ 10:22</ref>.</char></note><verse eid="MRK 13:13"/></para>
  <para style="s1">ያና ኢታ መቱዋ</para>
  <para style="r">(<ref loc="MAT 24:15-28">ማቶ 24:15-28</ref>፤ <ref loc="LUK 21:20-24">ሉቃ 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>“ሽን ዮ ቱናተይ ኤቃናዉ በሶና በሳን ኤቅዳሽን ህንተ በአና።” (አኬክሶ፦ ሄስ ዎይ ጉሰኮ ናባበይስ አኬኮ!) “ይሁዳ ቢታን ሄ ዎደ ደኤይሳት ደርያኮ ባቃቶ።<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DEU 9:27">ዛረ 9:27</ref>፤ <ref loc="DEU 11:31">11:31</ref>፤ <ref loc="DEU 12:11">12:11</ref>.</char></note> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>ኬ ሁጰን ደእያ ኡራይካ እስባ ኤካናዉ ዱገ ዎድ፥ ባ ሶ ገሎፖ።<note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ 17:31</ref>.</char></note> <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>ጋደን ደኤይስ ባ ማኡዋ ኤካናዉ ጉየ ስሞፎ። <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>ሄ ዎደ ቃንትዳ ማጫሳታስነ ንያ ማጫሳታስ ዳሮ ኡንአ ግዳና። <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>ሽን ሀይስ ኡባይ ሀንያ ዎደይ ባልጎ ግዶና መላ፥ ፆሳ ዎስተ። <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>አይስ ጊኮ፥ ፆሳይ አላምያ መዳ ዎድያፐ ዶምድ፥ ሀእ ጋካናዉ ሀንቦና መቶይነ ስንፈካ ሀኖና መቶይ አሳ ቦላ ሄ ዎደ ሀናና።<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 12:1">ዛረ 12:1</ref>፤ <ref loc="REV 7:14">ቆን 7:14</ref>.</char></note> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>ጎዳይ ሄ ጋላሳታ ታይቡዋ ጉናኮ፥ አሰ ግድዳይ ኦንካ አተና። ሽን እ ባ ዶርዳ አሳ ግሾ፥ ሄ ጋላሳታ ታይቡዋ ጉስ።<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>“ሄ ዎደ ኦንካ ህንተና፥ ‘ሄኮ፥ ክርስቶስ ሀይሳን ደኤስ ዎይኮ ክርስቶስ ህንን ደኤስ’ ያግኮ፥ ሄሳ አማኖፕተ። <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>ዎርዳንቾ ክርስቶሳትነ ዎርዶ ናበት ደንድድ ባንታዉ ዳንዳኤትኮ፥ ሀር አቶሽን ፆሳይ ዶርዳይሳታካ ባለናዉ ማላታታነ ማላልስያባታ በሳና። <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>ሽን ህንተ ናገትተ፤ ታኒ ህንተዉ ኡባባ ካሰታዳ ኦዳስ።<verse eid="MRK 13:23"/></para>
  <para style="s1">አሳ ናአ ናምአን ዩሳ</para>
  <para style="r">(<ref loc="MAT 24:29-31">ማቶ 24:29-31</ref>፤ <ref loc="LUK 21:25-28">ሉቃ 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>“ሽን ሄ ዎደ ሄ ዋያፐ ጉየ፥</para>
  <para style="q2" vid="MRK 13:24">አዋይ ማና፤</para>
  <para style="q2" vid="MRK 13:24">አጌናይ ፖኡዋ አጋና።<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">እሳ 13:10</ref>፤ <ref loc="JER 2:10">ኤርም 2:10</ref>.</char></note><verse eid="MRK 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25"/>ፆልንቶት ሳሎፐ ኩንዳና፤</para>
  <para style="q2" vid="MRK 13:25">ቃስ ሳሎን ደእያ ዎልቃትካ ቃፃና።<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">እሳ 34:4</ref>፤ <ref loc="REV 6:13">ቆን 6:13</ref>፤ <ref loc="JER 2:10">ኤርም 2:10</ref>.</char></note><verse eid="MRK 13:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="MRK 13:26"/>ሄ ዎደ አሳ ናአይ፥ ግታ ዎልቃራነ ቦንቹዋራ ሻራ ግዶራ ይሽን ኤንቲ በአና።<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DEU 7:13">ዛረ 7:13</ref>፤ <ref loc="REV 1:7">ቆን 1:7</ref>.</char></note> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>ሄ ዎደ ታኒ ኪታንቾታ ሳአ ኦይዱ ባጋ ኪታና፤ ሳአ ጋፃፐ ሳሎ ጋፃ ጋካናዉ፥ ፆሳይ ዶርዳ አሳ ሺሻና።<verse eid="MRK 13:27"/></para>
  <para style="s1">ባላሰ ምፈ ታማርተ</para>
  <para style="r">(<ref loc="MAT 24:32-35">ማቶ 24:32-35</ref>፤ <ref loc="LUK 21:29-33">ሉቃ 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>“ሌምሱዋ ባላሰ ምፈ አኬክተ፤ ባላስያ አጭያ ዎደነ እ ሀይይ ጭልእያ ዎደ፥ ቶርቸይ ማታትዳይሳ ህንተ ኤሬታ። <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>ሄሳዳካ፥ ህንተ ሄ ኡባባይ ሀነይሳ በእያ ዎደ፥ እ ማትድ ፐንገ ጋክዳይሳ ኤርተ። <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ሀ ኡባባይ ሀናና ጋካናዉ ሀይሳን ደእያ አሳ ኡባይ ሀይቀና። <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>ሳሎይነ ሳእ አና፥ ሽን ታ ቃላይ አና።<verse eid="MRK 13:31"/></para>
  <para style="s1">የሱሲ ያና ጋላሳይ ኤረተና</para>
  <para style="r">(<ref loc="MAT 24:36-44">ማቶ 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>“ሽን ሄ ጋላሳነ ሄ ሳትያ አዋ ፃላላፐ አትሽን፥ ሀር አቶሽን ሳሎን ደእያ ኪታንቾታ ግድን ዎይኮ ናኣ ግድን ኦንካ ኤረይ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">ማቶ 24:36</ref>.</char></note> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>ሄ ዎደይ አዉደ ግዳኔኮ፥ ህንተ ኤሮና ግሾ፥ ናገትተነ ምንተ። <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>ታ ዩሳይ፥ ባ ኬ አግድ፥ ኦገ ብያ አሳ መላ። ኡራይ ባ አይለታስ ሁጰን ሁጰን ኦሶ እምድ ኤንታ ባ ኦሱዋ ቦላ አዋ ኦስ፤ ቃስ ናገይስ ምንድ ናጋና መላ ኪትስ።<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36">ሉቃ 12:36</ref>.</char></note><verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>“ሄሳ ግሾ፥ ምንተ። አይስ ጊኮ፥ ጎዳይ ኦማርስ ግድን ዎይኮ ግድ ብላሄ ግድን ዎይኮ ኩቶ ዋሶ ግድን ዎይኮ ዎንት ማ ግድን አዉደ ያነኮ፥ ህንተ ኤረከታ። <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>ህንተ አኬኮና እ ይድ ህንተ ስክድ ደእሽን ደሞና መላ ምንተ። <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>ታኒ ህንተዉ ኦደይሳ አሳ ኡባስ ኦዳይስ፤ ምንተ” ያግስ።<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">የሱሳ ቦላ ማቀትዶሶና</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ 26:1-5</ref>፤ <ref loc="LUK 22:1-2">ሉቃ 22:1-2</ref>፤ <ref loc="JHN 11:45-53">ዮሀ 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>ፓስካ ባኣለ ቦንችያ ጋላስነ ኡይ ባኣለ ቦንችያ ጋላስ ጋካናዉ ናምኡ ጋላስ አትስ። ካህነ ሀላቃትነ ህገ አስታማረት አስ ኤሮና የሱሳ ኦይክድ ዎያ ኦገ ኮዮሶና።<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1">ከሳ 12:1</ref>.</char></note> <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>“አሳይ ኦሽ ከሶና መላ ፓስካ ቦንችያ ጋላሳን ሄሳ ኦኮ” ያግዶሶና።<verse eid="MRK 14:2"/></para>
  <para style="s1">የሱሳ ሽቶ ትይዳ ማጫስዉ</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማቶ 26:6-13</ref>፤ <ref loc="JHN 12:1-8">ዮሀ 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>የሱሲ ብታነ ካታማን ባሮ ሀርጋንቾ ግድዳ ስሞና ሶን ግብራ ቦላ ኡትዳሽን፥ እስ ማጫስያ አልባስፅሮሳ ሹቻፈ ኦሰትዳ ጵልቃፀ ኩመ ናርዶሰ ጌተትያ ዳሮ አልኦ ሽቶ ኤካዳ ያሱ። ሄ ጵልቃፀ መንዳ ሽቱዋ የሱሳ ሁጰን ትጋሱ።<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">ሉቃ 7:37</ref>.</char></note> <figure style="fig" alt="Alabaster jars" file="HK00142B.tif" size="col" ref="14:3">አልባስፅሮሰ</figure> <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>ሄ በሳን ደእያ አሳፐ እሶት እሶት ሀንቀትድ፥ “ሀ ሽቶይ መላ ጮ ኢተይ አይብሴ? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>ሀ ሽቱዋ ሄ ፄቱ ድናረን<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fk" closed="false">ሄ ፄቱ ድናረ፦ </char><char style="ft" closed="false">እስ አሳስ ላይን ጭገትያ ሎኦ ዳሞዘፐ ቦላ ግድያ ሚሸ።</char></note> ባይዝድ፥ ሚሽያ ማንቆታስ እማናዉ ዳንዳኤቴስ” ያግድ ባንታ ግዶን ኦደትዶሶና። ያትድ፥ ሄ ማጫስዉ ዳሮ ቦርዶሶና።<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>ሽን የሱሲ “ሀ ማጫስዉ አይኮካ ጎፕተ፤ እዮ አይስ ዋይሰቲ? እያ ታዉ ሎኦባ ኦሱ። <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>ማንቆት ኡባ ዎደ ህንተራ ደኦሶና። ህንተ ኮይዳ ዎደ አዉደካ ህንተ ኤንታ ማዳናዉ ዳንዳኤታ፥ ሽን ታኒ ኡባ ዎደ ህንተራ ደእከ።<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ዛረ 15:11</ref>.</char></note> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>እያ ባ ዳንዳእዳይሳ ኦሱ፤ ቃስ ታና ሞጎስ ጊግሳናዉ ካሰታዳ ሽቶ ትያሱ። <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ሳአ ኡባን ዎንገላ ኦድያ በሳ አዉንካ፥ አሳይ እዮ አኬካና መላ ሀ እያ ኦዳይስ ኦደታና” ያግስ።<verse eid="MRK 14:9"/></para>
  <para style="s1">ይሁድ የሱሳ አድ እሙዋ</para>
  <para style="r">(<ref loc="MAT 26:14-16">ማቶ 26:14-16</ref>፤ <ref loc="LUK 22:3-6">ሉቃ 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>ታማነ ናምኡ ታማረታፐ እሶይ አስቆሮታ ይሁዳ ጌተተይስ የሱሳ ካህነ ሀላቃታስ አድ እማናዉ ኤንታኮ ብስ። <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>ኤንቲ ሄሳ ስእዳ ዎደ ኡፋይትድ፥ “ኑኒ ነዉ ሚሸ እማና” ያግዶሶና፤ ይሁድ የሱሳ አድ እማናዉ እንጀ ዎደ ኮዬስ።<verse eid="MRK 14:11"/></para>
  <para style="s1">ጎዳ ካሁዋ</para>
  <para style="r">(<ref loc="MAT 26:26-30">ማቶ 26:26-30</ref>፤ <ref loc="LUK 22:14-20">ሉቃ 22:14-20</ref>፤ <ref loc="2CO 11:23-25">2 ቆሮ 11:23-25</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>ኡይ ምያ ጋላስ ቦንችያ ኮይሮ ጋላስ፥ ፓስካ ካ ማናዉ ማራዘ ሹክያ ዎደ፥ የሱሳ ታማረት እያኮ፥ “ፓስካ ቦንችያ ጋላስ ኔኒ ማና ካ ኑኒ አዉ ብድ ጊግስኖ?” ግድ ኦይችዶሶና።<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>የሱሲ ባ ታማረታፐ ናምአታ ሀይሳዳ ያግድ ኪትስ፦ “ካታማ ቢተ፤ ህንተ ብሽን፥ ኦቶራ ሃ ቶክዳ እስ ኡራይ ህንተራ ጋሄታና፤ እያ ካልተ። <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>እ ብድ ገልያ ኬ ጎዳ፥ ‘አስታማረይ ኔኮ፥ “ታኒ ታ ታማረታራ ፓስካ ማናዉ እማ ክፍለይ አዉኔ?” ያጌስ’ ያግተ። <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>ጎዳይ ህንተና ፖቅያ ቦላ ደእያ ጊግድ ኡትዳ ዳልጋ ክፍለ በሳና፤ ሄሳን ጊግስተ” ያግስ።<figure style="fig" alt="Two-story house with steps to roof" file="LB00235B.tif" size="col" ref="14:15">አይሁደ ኬ ካራ</figure><verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>ሄ ናምኡ ታማረት ከይድ፥ ካታማ ብዶሶና፤ የሱሲ ኤንታዉ ኦድዳይሳዳ ደምድ፥ ፓስካ ካ ጊግስዶሶና።<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>ሳአይ ኦማርስያ ዎደ የሱሲ ታማነ ናምኡ ታማረታራ ያ ብስ። <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>ኤንቲ ኡትድ ካ ምሽን፥ የሱሲ ኤንታኮ፥ “ታኒ ህንተዉ ቱማ ኦዳይስ፤ ህንተፈ እሶይ ታራ መይስ፥ ታና አድ እማና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ 41:9</ref>.</char></note><verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>እያ ታማረት ዳጋምድ፥ ባንታ ሁጰን ሁጰን፥ “ቱማ ታነሻ?” ያግድ እያ ኦይችዶሶና።<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>የሱሲ ዛሪድ፥ “ሄ ኡራይ፥ ህንተ ታማነ ናምአታፐ እሱዋ፤ እ ታራ እስፈ ቱሻናዉ ባ ኡይ ሻተን የደይሳ። <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>አሳ ናአይ፥ ጌሻ ማፃፋይ ሀይቃና ግዳይሳዳ ሀይቃና፥ ሽን አሳ ናአ፥ አድ እምያ ኡራ አየ! ሄ ኡራይ የለቶና አትዳኮ እያዉ ሎኦሽን” ያግስ።<verse eid="MRK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>ኤንቲ ምሽን፥ የሱሲ ኡይ ኤክድ፥ ፆሳ ጋላትስ፤ ሄ ኡይ መንድ፥ ባ ታማረታስ እምሸ፥ “ሄእተ፥ ሀይስ ታ አሹዋ” ያግስ።<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>ፁአ ኤክድ፥ ፆሳ ጋላትድ፥ ኤንታዉ እምን ኡባይካ ሄ ፁአፐ ኡይዶሶና። <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>የሱሲ፥ “ሀይስ ኦራ ጫቁዋን ዳሮ አሳ ግሾ ጉክያ ታ ሱ። <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>ታኒ ህንተዉ ቱማ ኦዳይስ፤ ታኒ ፆሳ ካዎተን ኦራ ዎይነ ኡያና ጋላስ ጋካናዉ ዛራዳ ሀ ዎይንያፐ ኡይከ” ያግስ።<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>ማዝሙረ የፅዳፐ ጉየ፥ ሻማሆ ዙማ ቦላ ብዶሶና።<verse eid="MRK 14:26"/></para>
  <para style="s1">ጰፅሮስ የሱሳ ካዳናይስ ኦደትስ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶ 26:31-35</ref>፤ <ref loc="LUK 22:31-34">ሉቃ 22:31-34</ref>፤ <ref loc="JHN 13:36-38">ዮሀ 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>የሱሲ ኤንታኮ፥ “ህንተ ኡባይ ታና የግ አግድ ባቃታና፤ ጌሻ ማፃፋይ፥</para>
  <para style="q1" vid="MRK 14:27">“ ‘ፆሳይ ዉደ አዋ ሾጫና፥</para>
  <para style="q2" vid="MRK 14:27">ዶርሳት ኡባይ ላለታና’</para>
  <para style="m" vid="MRK 14:27">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዛካ 13:7</ref>.</char></note> <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>ሽን ታኒ ሀይቆፐ ደንድዳፐ ጉየ፥ ህንተፈ ስንታዳ ጋልላ ባና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቶ 28:16</ref>.</char></note><verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>ጰፅሮስ ዛሪድ፥ “ኤንቲ ኡባይ ነና የግ አግድ ባቃትኮካ፥ ታ ነና አግከ” ያግስ።<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>የሱሲ ጰፅሮሳኮ፥ “ታኒ ነዉ ቱማ ኦዳይስ፤ ሀች ቃማ ኩቶይ ናምኡ ቶሆ ዋሳናፐ ስን ኔኒ ታና ሄ ቶሆ ካዳና” ያግስ።<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>ሽን ጰፅሮስ ካሰይሳፈ ምንድ፥ “ታኒ ሀር አቶሽን፥ ኔራ እስፈ ሀይቅያኮካ፥ ነና ካድከ” ያግስ። ቃስ ሀራት ኡባትካ ሄሳዳ ግዶሶና።<verse eid="MRK 14:31"/></para>
  <para style="s1">የሱሲ ጌታሳማነን ዎስስ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቶ 26:36-46</ref>፤ <ref loc="LUK 22:39-46">ሉቃ 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>ጌታሰማነ ጌተትያ በሳ ብዶሶና፤ የሱሲ ባ ታማረታኮ፥ “ታኒ ፆሳ ዎሳዳ ስማና ጋካናዉ ህንተ ሀይሳን ኡትሽተ” ያግስ።<verse eid="MRK 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 14:33"/>የሱሲ ጰፅሮሳ፥ ያይቆባነ ዮሃንሳ ባራ ኤክድ ብስ፤ ዳሮ ዋየትስነ ኡንኤትስ። <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>ቃስ ኤንታኮ፥ “ታኒ ሀይቃና ጋካናዉ አዛናስ፥ ሀይሳን ጋምእሽተ፤ ስኮፍተ” ያግስ።<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>ጉ ስን ሺቅድ፥ ሳአን ጉፋንድ፥ ዳንዳኤትያባ ግድኮ፥ ሄ ዋይያ ሳተይ ባፐ አና መላ፥ ፆሳ ዎስስ። <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>ቃስ፥ “አባ፥ ታ አዋዉ፥ ኡባባይ ነዉ ዳንዳኤቴስ፥ ሀ ዋየ ፁኣ ታፐ ድጋ። ሽን ነ ሸነይ ሀኖፐ አትሽን፥ ታ ሸነይ ሀኖፖ” ያግስ።<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>የሱሲ ባ ታማረታኮ ስም ይድ፥ ኤንቲ ስክዳሽን ደምድ፥ ጰፅሮሳኮ፥ “ስሞና፥ ስካዲ? ኔኒ እስ ሳተካ ባርካዳ ናጋናዉ ዳንዳአብኪ? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>ፓጨን ህንተ ገሎና መላ ባርክድ ናግተነ ፆሳ ዎስተ። ህንተዉ ሎኦ አሞይ ደኤስ፥ ሽን ህንተ ዳቡራንቾ አስ” ያግስ።<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>ቃስካ ብድ ካሰይሳዳ ፆሳ ዎስስ። <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>ባ ታማረታኮ ጉየ ስሚድ ያ ዎደ፥ ስክዳሽን ደምስ። ኤንታ አይፍያ ስኮይ ጎዝ ዎዳ ግሾ፥ እያኮ አይ ኦደትያኮካ ኤሮኮና።<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>ሄን ኤንታኮ ይድ፥ “ሀእ ጋካናዉካ ስከትነ ሸምፐቲ? ህዛ፥ ግዳና፤ ሳተይ ጋክስ፤ በእተ! አሳ ናአይ፥ ናጋራንቾ አሳስ አድ እመታና ዎደይ ጋክስ። <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>ደንድድ የተ፤ በእተ፥ ታና አድ እማናይስ ጋክስ” ያግስ።<verse eid="MRK 14:42"/></para>
  <para style="s1">የሱሲ ኦይከተ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ 26:47-56</ref>፤ <ref loc="LUK 22:47-53">ሉቃ 22:47-53</ref>፤ <ref loc="JHN 18:3-12">ዮሀ 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>የሱሲ ሄሳ ቡሮ ኦድሽን፥ ታማነ ናምኡ እያ ታማረታፐ እሶይ፥ ይሁድ፥ ኤለስድ ጋክ ዎስ። ቃስ ካህነ ሀላቃት፥ ህገ አስታማረትነ ጭማት ኪትን፥ ማሻነ ፃምአ ኦይክዳ ዳሮ አሳይ እያራ እስፈ ይዶሶና። <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>የሱሳ አድ እማናይስ ሄ ዳሮ አሳስ፥ “ታኒ ዬርያ ኡራይ እያ፤ እያ ኦይክድ፥ ሎይ ናግድ ኤፍተ” ያግድ ማላ ኦድ ዎስ።<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>ይሁድ ጋክ ዎዳ መላ የሱሳኮ ሺቅድ፥ “አስታማርያዉ” ያግድ የሱሳ ዬር ኤክስ። <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>ሄ ዳሮ አሳይ የሱሳ ኦይክዶሶና። <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>ሽን ማታን ኤቅዳይሳታፐ እሶይ ባ ማሻ ሾድድ ካህነ ሀላቃ አይልያ ሾጭድ፥ እያ ሀይ ቃንፅድ ሆልስ።<verse eid="MRK 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48"/>የሱሲ ዛሪድ፥ ሄ ሺቅዳ ዳሮ አሳኮ፥ “ታና ፓንጋ ከስድ፥ ፓንጋ ኦይከይሳዳ ኦይካናዉ ማሸነ ፃምአ ኦይክድ ይደቲ? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>ታኒ ፆሳ ኬን ታማርሳሸ፥ ጋላስ ጋላስ ህንተራ ደእያ ዎደ ታና ኦይክቤከታ፥ ሽን ጌሻ ማፃፋይ ግዳይስ ፖለታናዉ በሴስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ 19:47</ref>፤ <ref loc="LUK 21:37">21:37</ref>.</char></note><verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>እያ ታማረት ኡባይ እያ የግ አግድ ባቃትዶሶና።<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>ላፃና ፃላላ ማእዳ እስ ናአተ ኡራይ የሱሳ ካለይሳ አሳይ ኦይክስ። <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>ሽን ሄ ኡራይ ላፃና የግ አግድ፥ ፅረ ካሎ ባቃትስ።<verse eid="MRK 14:52"/></para>
  <para style="s1">የሱሲ ፕርዳ ሻንጎ ስንን</para>
  <para style="r">(<ref loc="MAT 26:57-68">ማቶ 26:57-68</ref>፤ <ref loc="LUK 22:54-55">ሉቃ 22:54-55</ref>፥ <ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ዮሀ 18:13-14</ref>፥ <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>አሳይ የሱሳ ካህነ ሀላቃ ሶ ኤፍዶሶና። ያን ካህነ ሀላቃት፥ ጭማትነ ህገ አስታማረት ሺቅድ ደኦሶና። <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>ጰፅሮስ ካህነ ሀላቃ ዛባ ጋካናዉ ሃሆን እያ ካል ብድ ያን ናገይሳታራ ኡትድ ታማ ካዬስ።<verse eid="MRK 14:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55"/>ካህነ ሀላቃትነ ሺቅዳ አሳ ኡባይ የሱሳ ዎናዉ እያ ቦላ ማርካ ኮይዶሶና፥ ሽን አይኮካ ደምቦኮና። <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>ዳሮ አሳት እያ ቦላ ዎርዶ ማርካትዶሶና፥ ሽን ኤንታ ማርካተይ እስኖ ግድቤና።<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57-58" style="v" sid="MRK 14:57-58"/>እስ እስ አሳት ደንድ ኤቅድ የሱሳ ቦላ፥ “እ፥ ‘ታኒ አስ ኬፅዳ ሀ ፆሳ ኬ ላላዳ፥ አሳ ኩሸን ኬፀትቦና ሀራ ፆሳ ኬ ሄ ጋላሳ ግዶን ኬፃና’ ግሽን ኑኒ ስእዳ” ያግድ ዎርዶ ማርካትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">14:57-58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ዮሀ 2:19</ref>.</char></note> <verse eid="MRK 14:57-58"/><verse number="59" style="v" sid="MRK 14:59"/>ግዶሽን፥ ኤንታ ማርካተይ ሄሳንካ እስኖ ግድቤና።<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>ካህነ ሀላቃይ አሳ ኡባ ስንን ደንድ ኤቅድ፥ “ሀይሳቲ ነና ሞትያ ሞቱዋስ ነ ዛርያባይ ባዌ?” ያግድ የሱሳ ኦይችስ። <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>ሽን የሱሲ ስእ ግስ፤ አይኮካ ዛርቤና። ካህነ ሀላቃይ፥ “አንጀትዳ ፆሳ ናአይ፥ ክርስቶስ ነነዬ?” ያግድ ዛር ኦይችስ።<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>የሱሲ ዛሪድ፥ “ኤ ታና፥ ህንተ አሳ ናአይ፥ ዎልቃማ ፆሳፈ ኡሻቻ ባጋራ ኡትዳሽን ቃስ ሳሉዋ ሻራራ ይሽን በአና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳነ 7:13</ref>.</char></note><verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>ካህነ ሀላቃይ ባ ማኡዋ ፔድ፥ “ኑና ሀራ ማርካ አይ ኮሺ? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>ህንተ እያ ጫሻ ስእደታ፤ ህንተ ቆፋይ አይቤ?” ያግስ። ኤንቲ ኡባይ፥ “እ ሀይቃናዉ በሴስ” ያግድ እያ ቦላ ፕርድዶሶና።<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:15">ሌወ 24:15</ref>.</char></note><verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>ኤንታፈ እሶት እሶት እያ ቦላ ጩተ ኦይክዶሶና። እያ አይፍያ ጎዝድ ባቅሸ፥ “ነና ደችዳይ ኦኔ? አነ ኑስ ኦዳ!” ያግዶሶና። ናገይሳት እያ ኤክ ኤፍድ ጋራፍዶሶና።<verse eid="MRK 14:65"/></para>
  <para style="s1">ጰፅሮስ የሱሳ ካድስ</para>
  <para style="r">(<ref loc="MAT 26:69-75">ማቶ 26:69-75</ref>፤ <ref loc="LUK 22:56-62">ሉቃ 22:56-62</ref>፤ <ref loc="JHN 18:15-18">ዮሀ 18:15-18</ref>፥ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>ጰፅሮስ ካህነ ሀላቃ ዛባን ጋርሳ ባጋራ ደእሽን፥ ካህነ ሀላቃ ጋንዶታፐ እስንያ ያ ያሱ። <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>ጰፅሮስ ታማ ካየይሳ ደማዳ፥ ትሽ ኦ ፄላዳ፥ “ነካ ናዝረተ የሱሳራ ደኣሳ” ያጋሱ።<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>ሽን ጰፅሮስ፥ “ነ ገይስ አይበኮ ታ ኤርከ፥ ታዉ አኬከተና” ያግድ ካድስ። ያግ ስሚድ፥ ዛጎ ከይያ ዎደ ኢራካ ኩቶይ ዋስስ።<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>ሄ ጋንድያ ጰፅሮሳ በአዳ፥ እያ ማታን ኤቅዳ አሳታኮ፥ “ሀ ኡራይካ ኤንታራ ደኤስ” ጋዳ ዛራ ኦዳሱ። <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>ሽን ጰፅሮስ ቃስካ ካድስ።</para>
  <para style="p" vid="MRK 14:70">ጉ ጋምእሽን፥ ማታን ኤቅዳ አሳት ናምአን ጰፅሮሳኮ፥ “ኔኒ ጋልላ ቢታ አስ ግድያ ግሾ ቱማ ኤንታራ ደኣሳ” ያግዶሶና።<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>ሽን ጰፅሮስ፥ “ታኒ ህንተ ግያ ኡራ ኤርከ!” ያግድ ባና ባደነ ጫቆ ኦይክስ።<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>ኤለስድ ኩቶይ ናምአን ዋስ አግስ። ጰፅሮስ፥ የሱሲ እያኮ፥ “ኔኒ ኩቶይ ናምኡ ቶሆ ዋሳናፐ ስን ሄ ቶሆ ታና ካዳና” ግዳይሳ አኬክድ ዳሮ ዬክስ።<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">የሱሲ ጵላፆሳ ስንን</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ 27:1-2</ref>፥ <ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="LUK 23:1-5">ሉቃ 23:1-5</ref>፤ <ref loc="JHN 18:28-38">ዮሀ 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>ዎንታ ጉራ ኤለስድ ካህነ ሀላቃት፥ ጭማት፥ ህገ አስታማረትነ አይሁደ ሻንጎት ኡባይ ሺቅድ ማቀትዶሶና። ኤንቲ የሱሳ ቃች ኤፍድ ጵላፆሳስ አድ እምዶሶና።<verse eid="MRK 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2"/>ጵላፆስ እያኮ፥ “ኔኒ አይሁደ ካዎ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="MRK 15:2">የሱሲ ዛሪድ፥ “ነ ጋዳሳ” ያግስ።<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>ካህነ ሀላቃት የሱሳ ዳሮባን ሞትዶሶና። <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>ሽን ጵላፆስ ዛሪድ የሱሳኮ፥ “ነዉ ዛርያባይ ባዌ? ኤንቲ ነ ቦላ አይ መላ ሞቱዋ ኤህያኮ በእኪ?” ያግስ።<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>ሽን የሱሲ ሀራባ ዛሮና እፅን፥ ጵላፆስ ማላለትስ።<verse eid="MRK 15:5"/></para>
  <para style="s1">የሱሲ ሀይቆ ፕርደትስ</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማቶ 27:15-26</ref>፤ <ref loc="LUK 23:13-25">ሉቃ 23:13-25</ref>፤ <ref loc="JHN 18:39-40">ዮሀ 18:39-40</ref>፤ <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>ጵላፆሳስ ፓስካ ባኣለ ቦንችያ ጋላሳን አሳይ ኮያ እስ አስ ቃሾፐ ብልያ ሜዘይ ደኤስ። <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>ሄ ዎደ እስ ባርባና ጌተትያ ኡራይ ኦሹ ከስድ ሸምፖ ዎዳ አሳራ እስፈ ቃሾ ኬን ደኤስ። <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>ሺቅዳ ዳሮ አሳይ ጵላፆስ ካሰይሳዳ ኦና መላ እያ ኦይችዶሶና። <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>ጵላፆስ አሳ ዛሪድ፥ “ታኒ ህንተዉ አይሁደታ ካዋ ብላናይሳ ኮዬቲ?” ያግድ ኦይችስ። <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>ሄሳ እ ግዳይ፥ ካህነ ሀላቃት የሱሳ ቃናትድ አድ እምዳይሳ ኤርያ ግሾሳ።<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>ሽን ካህነ ሀላቃት የሱሳ ግሾ ባርባና ብላናዳ፥ ሄ ሺቅዳ አሳይ ጵላፆሳ ዎሳና መላ አሳ ማቅዶሶና። <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>ጵላፆስ ዛሪድ፥ “ያትን፥ ሀ ህንተ አይሁደ ካዎ ገይሳ ዋቶ?” ያግስ።<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>አሳይ ጵላፆሳ ቦላ ዋስድ፥ “ማስቃለ ቦላ እያ ካቃ” ያግዶሶና።<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>ጵላፆስ፥ “አይስ? እ አይ ኢታባ ኦዴ?” ያግስ።</para>
  <para style="p" vid="MRK 15:14">ሽን አሳይ ካሰይሳፈ ጉጅ ዋስድ፥ “ማስቃለ ቦላ እያ ካቃ” ያግዶሶና።<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>ጵላፆስ አሳ ኡፋይሳናዉ ኮይድ፥ ባርባና አሳስ ብልስ፤ ያትድ ልሶን የሱሳ ጋራፍድ፥ ማስቃልያ ቦላ ካቃና መላ ኤንታዉ አድ እሚስ።<verse eid="MRK 15:15"/></para>
  <para style="s1">የሱሲ ቶሸትስ</para>
  <para style="r">(<ref loc="MAT 27:27-31">ማቶ 27:27-31</ref>፤ <ref loc="JHN 19:2-3">ዮሀ 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>ሄሳፈ ጉየ፥ ዎታዳረት የሱሳ ደርያ ሃረይሳ ኦሶ ኬ ኤፍድ፥ ሀራ ዎታዳረታ ኡባ እስፈ ፄግዶሶና። <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>ቃስ ዞኦ አፍላ እያ ማይዝዶሶና፤ አጉን ካላቻ ጊግስድ፥ እያ ሁጰን ዎዶሶና። <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>ሄሳፈ ጉየ፥ እያኮ፥ “አይሁደታ ካዋዉ መርናዉ ካዎታ” ያግድ፥ እያዉ ዝግዶሶና። <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>እያ ሁጵያ ፃምአን ሾጭዶሶና፤ ቃስ እያ ቦላ ጩትዶሶና፤ ጉልባትድ እያዉ ጎይንዶሶና። <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>እያ ቶችዳፐ ጉየ ዞኦ አፍላ እያፐ ቃር ኤክድ፥ እያ አፍላ እያ ማይዝድ ማስቃለ ቦላ እያ ካቃናዉ ኤፍዶሶና።<verse eid="MRK 15:20"/></para>
  <para style="s1">የሱሲ ካቀትስ</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቶ 27:32-44</ref>፤ <ref loc="LUK 23:26-43">ሉቃ 23:26-43</ref>፤ <ref loc="JHN 19:17-27">ዮሀ 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>ኤንቲ ብሸ፥ እስክንድረነ ሩፎሳ አዋ፥ ስሞና ጌተትያ ቀሬና ቢታ አስ፥ ጋፃረፐ ካታማ የይሳራ ጋሄትድ፥ የሱሳ ማስቃልያ ዎልቃን ቶስዶሶና።<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">ሮመ 16:13</ref>.</char></note> <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>ያትድ ጎልጎታ ጌተትያ በሳ የሱሳ ኤፍዶሶና። “ጎልጎታ” ጉሳይ “ሁጰ ጉገ” ጉሱ። <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>ሳኮይ ስኤቶና መላ ካርበራ ዋላከትዳ ዎይነ ኡዮ ግድ እያዉ እምዶሶና፤ ሽን እ ኡዮና እፅስ። <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>ኤንቲ ማስቃለ ቦላ እያ ካቅዶሶና። ኦና አይብ ጋካኔኮ ግድ እያ አፍላ ሻክድ ሳማ የግዶሶና።<verse eid="MRK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25"/>ኤንቲ ማስቃለ ቦላ እያ ካቅያ ዎደ ዎንታፈ ሄ ሳተ። <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>ኤንቲ፥ “አይሁደ ካዋ” ያግድ እያ ሞትያ ፁፈ ፃፍድ ዎዶሶና። <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>የሱሳራ ናምኡ ፓንጋታ እሱዋ እያፐ ኡሻቻ ባጋራ ሀንኩዋ እያፐ ሀድርሳ ባጋራ ማስቃለ ቦላ ካቅዶሶና። <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>ጌሻ ማፃፋይ፥ “ኢታባ ኦዳ አሳታራ እ ፓይደትስ” ጌተትዳይስ ፖለትስ።<note caller="-" style="x"><char style="xo" closed="false">15:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">እሳ 53:12</ref>.</char></note><verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>ኦገራ አያ አሳይ የሱሳ ካድ፥ ባንታ ሁጵያ ቃድ ጫይዶሶና፤ “ሄኮ! ፆሳ ኬ ላላዳ ሄ ጋላሳ ግዶን ኬፀይሶ፥ ነ ሁጵያ አሻ፤<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">ማዝ 22:7</ref>፤ <ref loc="PSA 109:25">109:25</ref>፤ <ref loc="MRK 14:58">ማር 14:58</ref>፤ <ref loc="JHN 2:19">ዮሀ 2:19</ref>.</char></note> <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>አነ ማስቃልያ ቦላፈ ዎ” ያግዶሶና።<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>ሄሳዳካ፥ ካህነ ሀላቃት ህግያ ታማርሰይሳታራ እስፈ የሱሳ ቶችድ፥ “ሀራታ አሽስ፥ ሽን ባና አሻናዉ ዳንዳኤና፤ <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>ኑኒ በእድ አማናና መላ ክርስቶስ፥ እስራኤለ ካዎይ፥ አነ ማስቃለ ቦላፈ ሀእ ዎ” ያግዶሶና። ቃስ ሀር አቶሽን፥ እያራ ማስቃለ ቦላ ካቀትዳይሳትካ እያ ቶችዶሶና።<verse eid="MRK 15:32"/></para>
  <para style="s1">የሱሳ ሀይቁዋ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ 27:45-56</ref>፤ <ref loc="LUK 23:44-49">ሉቃ 23:44-49</ref>፤ <ref loc="JHN 19:28-30">ዮሀ 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>ኡሱፑን ሳተፐ ዶምድ፥ ኡዱፉን ሳተ ጋካናዉ ቢታ ኡባይ ምስ። <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>ኡዱፉን ሳተን የሱሲ፥ “ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታኒ?” ያግድ ዋስስ። ሄሳ ጉሳይ፥ “ታ ፆሳዉ፥ ታ ፆሳዉ፥ ታና አይስ አጋዲ?” ጉሱ።<note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">ማዝ 22:1</ref>.</char></note><verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>ሄሳን ኤቅዳ አሳፐ እሶይ እሶይ ሄሳ ስእድ፥ “ሄኮ፥ ኤልያሳ ፄጌስ” ያግስ። <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>ሄ አሳፐ እሶይ ዎፅድ፥ እስፖንጀን ጫላ ዎይነ ኩንስ፤ ሄሳ ፃምአ ፄራን ዎድ፥ “ናግተ፤ ኤልያስ ማስቃለ ቦላፈ እያ ዎሳናዉ ያነኮ አነ በኦስ” ያግድ የሱሳ ዶናኮ ኡሻናዉ ሺሽስ።<note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ 69:21</ref>.</char></note><verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>የሱሲ ባ ቃላ ቁ ኦ ዋስድ፥ ሀይቅስ።<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>ፆሳ ኬን ካቀትዳ ማጋራጆይ ቆሞፈ ዱገ ጋካናዉ፥ ናምኡ ከይድ ዳከት ዎስ።<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31">ከሳ 26:31</ref>.</char></note> <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>ማስቃልያፐ ስን ባጋራ ያን ኤቅዳ እስ ማቶ ሀላቃይ፥ የሱሲ ዋንድ ሀይቅዳኮ በእዳ ዎደ፥ “ሀ ኡራይ ቱማ ፆሳ ናአ” ያግስ።<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>ሄሳ ሃሆን ኤቅድ በእያ ጉ ማጫሳት ደኦሶና። ኤንታ ግዶን ማግደላ ማይራማ፥ ካሉዋ ያይቆባነ ዮሳ አይያ ማይራማነ ሳሎማ ደኦሶና። <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>ሄ ማጫሳት የሱሲ ጋልላን ደእያ ዎደ እያ ካልዳይሳታነ እያ ሞክዳይሳታ ቃስ የሱሳራ እስፈ የሩሳላመ ብዳ ሀራ ዳሮ ማጫሳት ያን ደኦሶና።<note caller="-" style="x"><char style="xo" closed="false">15:41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ 8:2-3</ref>.</char></note><verse eid="MRK 15:41"/></para>
  <para style="s1">የሱሲ ሞገትስ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ 27:57-61</ref>፤ <ref loc="LUK 23:50-56">ሉቃ 23:50-56</ref>፤ <ref loc="JHN 19:38-42">ዮሀ 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43"/>ሳእ ኦማርስዳ ዎደ፥ ሺቅዳ አሳን ቦንቸትዳ አይሁደ ሻንጎታፐ እሶይ፥ ዮሰፋ ጌተትያ ኡራይ፥ ፆሳ ካዎተይ ያናይሳ ናግሸ ደኤይስ፥ አርማተ ካታማ አስ ደኤይስ ይስ። ዎንተ ሳምባታስ ጊገትያ ጋላስ ግድዳ ግሾ፥ ዮሰፍ ምንድ ጵላፆሳኮ ብድ፥ የሱሳ አሀ ኤካናዉ ዎስስ። <verse eid="MRK 15:42-43"/><verse number="44" style="v" sid="MRK 15:44"/>ጵላፆስ፥ የሱሲ ሀይቅዳይሳ ስእዳ ዎደ ማላለትስ፤ ማቶ ሀላቃ ፄግድ፥ “እ ሀይቅድ ጋምእዴ?” ያግድ ኦይችስ። <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>ጵላፆስ፥ የሱሲ ሀይቅዳይሳ ማቶ ሀላቃፐ ስእድ እያ አሀ ዮሰፋስ እሚስ። <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>ዮሰፍ ሞጎ አፍላ ሻምስ፤ የሱሳ አሀ ማስቃልያፐ ዎድ፥ አፍላን ፃፅድ፥ ሹቻፈ ዎጨትዳ ዱፎን እያ አሀ ሞግስ። ቃስ ሄ ዱፉዋ ዶናን ግታ ሹቹ ጎንዶርስድ ዎስ። <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>ማግደላ ማይራማነ ዮሳ አይያ ማይራማ የሱሳ አሀ ኤንቲ አዉን ዎያኮ በኦሶና።<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">የሱሳ ሀይቆፐ ደንዱዋ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቶ 28:1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃ 24:1-12</ref>፤ <ref loc="JHN 20:1-10">ዮሀ 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>ሳምባት አዳፐ ጉየ፥ ማግደላ ማይራማ፥ ያይቆባ አይያ ማይራማነ ሳሎማ ብድ፥ የሱሳ አሀ ትያናዉ ሽቶ ሻምዶሶና። <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>ዎጋ ዎደ ዎንታ ዳሮ ጉራ ፃልቀይ ጫርሽን፥ ዱፎ ብዶሶና። <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>ኤንቲ ባንታ ግዶን እሶይ እሱዋራ፥ “ዱፉዋ ዶናፐ ኑስ ሹቻ ኦኔ ጎንዶርስድ ድጋናይ?” ያግድ ኦደትዶሶና።<verse eid="MRK 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4"/>ኤንቲ ፄልያ ዎደ ሄ ዳሮ ግታ ሹቻይ ጎንዶረትድ ክችዳይሳ በእዶሶና። <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>የሱሲ ሞገትዳ ዱፉዋ ግዶ ገልያ ዎደ እስ ፓን አደይ ቦ ማኦ ማእድ፥ ኡሻቻ ባጋራ ኡትዳይሳ በእድ ዳጋምዶሶና።<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>ሽን እ ኤንታኮ፥ “ዳጋሞፍተ፤ ማስቃልያ ቦላ ካቀትዳ፥ ናዝረተ የሱሳ ህንተ ኮየይሳ ታኒ ኤራይስ። እ ሀይሳን ዴና፥ ሀይቆፐ ደንድስ። ኤንቲ እያ ሞግዳ በሳ ሀይሳ በእተ። <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>ሀእ ብድ የሱሳ ታማረታስነ ጰፅሮሳስ፥ ‘የሱሲ ህንተፈ ስንትድ ጋልላ ቤስ። እ፥ ህንተዉ ኦድዳይሳዳ ህንተ እያ ያን በአና’ ያግድ ኦድተ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">ማቶ 26:32</ref>፤ <ref loc="MRK 14:28">ማር 14:28</ref>.</char></note><verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>ማጫሳት ያሻን ኮኮርሸ ዱፎፐ ከይድ ባቃትዶሶና። ቃስ ኤንቲ ያይዳ ግሾ፥ ሄሳ ኦደስካ አይኮካ ኦድቦኮና።<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">እስ እስ በን ማፃፋት ማርቆሳ ዎንገላ ፓይዶ 8 ቦላ ኤሶሶና። ቃስ እስ እስ ማፃፋት ፓይዶ 9-20 ጋካናዉ ደእያ ቆፋ ጉጆኮና። ግዶሽን፥ ፓይዶ 8 ካልድ ደእያ ጉጆሶና። ሄስካ [ማጫሳት ብድ፥ ኪታንቾይ ኦድዳባ ኡባ ጰፅሮሳስነ እያራ ደኤይሳታስ ቃንን ኦድዶሶና። ሄሳፈ ጉየ፥ የሱሲ ባ ታማረታ ጌሽነ መርና አቶተ ዎንገላ ኪታ ዶሎሀፐ ዉሎሀ ጋካናዉ ኪትስ።]</char></note><verse eid="MRK 16:8"/></para>
  <para style="s1">የሱሲ ማግደላ ማይራምስ ቆንጭስ</para>
  <para style="r">(<ref loc="MAT 28:9-10">ማቶ 28:9-10</ref>፤ <ref loc="JHN 20:11-18">ዮሀ 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>የሱሲ ሀይቆፐ ደንድዳፐ ጉየ፥ ዎጋ ጋላስ ዎንታ፥ ላፑን ቱና አያናታ ከስዳ ማግደላ ማይራምስ ኮይሮትድ በንትስ። <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>እያ ባዳ ካሰ እያራ ደኤይሳታስ፥ ኤንቲ አዛንሸነ ዬክሸ ደእሽን ኦዳሱ። <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>ሽን የሱሲ ፓፃ ደኤይሳነ እዉ በንትዳይሳ ኤንቲ ስእዳ ዎደ እያ ገይሳ አማንቦኮና።<verse eid="MRK 16:11"/></para>
  <para style="s1">የሱሲ ናምኡ ታማረታስ ቆንጭስ</para>
  <para style="r">(<ref loc="LUK 24:13-35">ሉቃ 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>ሄሳፈ ጉየ፥ ኤንታፈ ናምአት ካታማፐ ከይድ ብሽን፥ ኦገ ቦላ የሱሲ ካሰፐ ዱማትድ ኤንታዉ በንትስ። <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>ኤንቲ ጉየ ስሚድ፥ ሀራታስ ኦድዶሶና፥ ሽን ሀራትካ ኤንታ ኦዳ ቱማ ግቦኮና።<verse eid="MRK 16:13"/></para>
  <para style="s1">የሱሲ ታማነ እስ ታማረታስ ቆንጭስ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ 28:16-20</ref>፤ <ref loc="LUK 24:36-49">ሉቃ 24:36-49</ref>፤ <ref loc="JHN 20:19-23">ዮሀ 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ሀዋ 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>ጉየፐ ታማነ እስ እያ ታማረት ካ ምሽን፥ የሱሲ ኤንታዉ በንትስ። ኤንታዉ አማኖይ ባይና ግሾነ ሀይቆፐ እ ደንድዳይሳ በእዳ አሳይ ኦድን፥ ኤንቲ አማኖና እፅዳ ግሾ እ ኤንታ ቦርስ።<verse eid="MRK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15"/>እ ኤንታኮ፥ “ቢታ ኡባ ብድ አሳ ኡባስ ዎንገላ ኦድተ።<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ሀዋ 1:8</ref>.</char></note> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>አማነይነ ፃማቀተይ አታና፥ ሽን አማኖናይ ፕርደታና። <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>አማነይሳታስ ሀ ማላታት እመታና። ኤንቲ ታ ሱንን ቱና አያናታ ከሳና፥ ኦራ ዶናን ኦደታና። <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>ኤንቲ ሾሹ ኦይክኮካ ዎይኮ ዎያባ ኡይኮካ ኤንታ ቆሄና። ቃስ ኤንቲ ባንታ ኩሽያ ሀርጋንቾታ ቦላ ዎድ ኤንታ ፓና” ያግስ።<verse eid="MRK 16:18"/></para>
  <para style="s1">የሱሲ ፑደ ሳሎ ብስ</para>
  <para style="r">(<ref loc="LUK 24:50-53">ሉቃ 24:50-53</ref>፤ <ref loc="ACT 1:9-11">ሀዋ 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>ጎዳይ የሱሲ ታማረታራ ኦደትዳፐ ጉየ፥ ፑደ ሳሎ ከይስ፤ ፆሳፈ ኡሻቻ ባጋራ ኡትስ።<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 1:9">ሀዋ 1:9</ref>.</char></note> <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>እያ ታማረት ብዳ በሳ ኡባን ቃላ ኦድዶሶና። ጎዳይካ ኤንታራ እስፈ ኦስ። ኤንቲ ኦድያ ቃላይ ቱማ ግድዳይሳ ፆሳይ ኤንታዉ እምያ ማላታታን ኤርስስ።<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
