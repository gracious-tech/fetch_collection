<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ኤርምያሳ ምላልሳ</para>
  <para style="toc1">ኤርምያሳ ምላልሳ</para>
  <para style="toc3">ምላ</para>
  <para style="toc2">ምላልሳ</para>
  <para style="mt">ኤርምያሳ ዘለልሳ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ኤርምያሳ ምላልሳይ ክ.የ.ስ. 600 ላይ ሄራን የሩሳላመ ላለተነ አሳ ድኤተ ጋሶን ግንፆን ጊግዳ አዛኖ ሚላልሳታ ኦይክስ። ሀ ማፃፋ ዳሮ ባጋይ ዬሆባነ ዘለልሳባ ኦድኮካ ፆሳን አማነተባነ ኡፋይሳን ዱሳባ ኦድያ ክፍለት ደኦሶና።</para>
  <para style="ip">ሀ ግንፆታ አይሁደ አሳይ ባንታ ቢታ ቦላ ጋክዳ ዩዋ ሀሳያናዉ ላይን ላይን ፆማን አዛኖ ጎይኖ ዎጋታ ፖልያ ጋላሳታን ጎኤቶሶና።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">የሩሳላመ ዋይያ (<char style="ior"><ref loc="LAM 1:1-22">1:1-22</ref></char>)</para>
  <para style="io1">ፆሳ ሀንቆነ የሩሳላመ ፕርደተ (<char style="ior"><ref loc="LAM 2:1-22">2:1-22</ref></char>)</para>
  <para style="io1">ፆሳ ደርያስ ኡፋይስ ደኤስ (<char style="ior"><ref loc="LAM 3:1-66">3:1-66</ref></char>)</para>
  <para style="io1">የሩሳላመይ ዝነ፥ ሀችነ ዎንቶ (<char style="ior"><ref loc="LAM 4:1-22">4:1-22</ref></char>)</para>
  <para style="io1">ማሮታ ዎሳ (<char style="ior"><ref loc="LAM 5:1-22">5:1-22</ref></char>)</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="s1">የሩሳላመ ዋየ</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>ካሰ አስ ኩምዳ ካታምያ</para>
  <para style="q2" vid="LAM 1:1">ሀእ ዋናዳ አስ ባይና በሲ ግዳዴ?</para>
  <para style="q1" vid="LAM 1:1">ካሰ ካዎተታ ግዶን ግታ ግድዳራ</para>
  <para style="q2" vid="LAM 1:1">ሀእ ዋናዳ አምኦ ግዳዴ?</para>
  <para style="q1" vid="LAM 1:1">ካታማታ ግዶን ካዎ ግድዳራ</para>
  <para style="q2" vid="LAM 1:1">ሀእ ዋናዳ አይለ ግዳዴ?<verse eid="LAM 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>ቃማ ይባታ ዬሆ ዬካሸ አቃዉሱ፤</para>
  <para style="q2" vid="LAM 1:2">አፉ እ አይፈ ካረራ ዱገ ዎስ።</para>
  <para style="q1" vid="LAM 1:2">ካሰ እዮ ዶሰይሳታፐ</para>
  <para style="q2" vid="LAM 1:2">ሀእ እዮ ምንያ እሶይካ ባዋ።</para>
  <para style="q1" vid="LAM 1:2">እ ላገት እዮ አድ እምዶሶና፤</para>
  <para style="q2" vid="LAM 1:2">እዉ ሞርከ ግድዶሶና።<verse eid="LAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>ይሁድ ናቀታዳ፤ አይለታዳ ድኤታሱ፤</para>
  <para style="q2" vid="LAM 1:3">ሀእ ካዎተታ ግዶን ደአዉሱ፤</para>
  <para style="q2" vid="LAM 1:3">ሽን ሸምፖ በሲ ደማቡኩ።</para>
  <para style="q1" vid="LAM 1:3">እያ መቶታዳ ደእሽን፥</para>
  <para style="q2" vid="LAM 1:3">የደይሳት እዮ ደምዶሶና።<verse eid="LAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>ላይ ባኣለ ቦንቻናዉ ያ አስ ባይና ግሾ፥</para>
  <para style="q2" vid="LAM 1:4">ፅዮነ ኦገት ዬኮሶና።</para>
  <para style="q1" vid="LAM 1:4">እ ድርሳ ፐንገት ባይሳትዶሶና፤</para>
  <para style="q2" vid="LAM 1:4">እ ካህነት ኦሎሶና።</para>
  <para style="q1" vid="LAM 1:4">ያን ደእያ ጌላኦ ናይት ኡንኤትዶሶና፤</para>
  <para style="q2" vid="LAM 1:4">እያካ ኡንኤታዳ ዬካዉሱ።<verse eid="LAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>እ ሞርከት እዉ ጎዳ ግድዶሶና፤</para>
  <para style="q2" vid="LAM 1:5">ኤንታዉ እንጀትን ደእዶሶና።</para>
  <para style="q1" vid="LAM 1:5">እ፥ ናጋራ ጋሶን ጎዳይ እዮ ኡንኤስ፤</para>
  <para style="q2" vid="LAM 1:5">እ ናይት ሞርከታን ድኤትድ ብዶሶና።<verse eid="LAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>ፅዮን ቦንቾይ ኢፐ ቃረትስ፤</para>
  <para style="q2" vid="LAM 1:6">እ፥ ሀላቃትካ ምያ በሲ ይዳ ጋራዳ ሀንዶሶና፤</para>
  <para style="q1" vid="LAM 1:6">ኤንቲ ዎልቃ ይድ</para>
  <para style="q2" vid="LAM 1:6">ባንታና የደይሳታ ስንፈ ባቃትዶሶና።<verse eid="LAM 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>የሩሳላመይ ባ መቱዋነ ባ ኡንአ ጋላሳን፥</para>
  <para style="q2" vid="LAM 1:7">በን ባ ቦንቾ ሻሉዋ ሀሳያዉሱ።</para>
  <para style="q1" vid="LAM 1:7">እ፥ አሳይ ሞርከታ ኩሸን አድ እመትዳ ዎደ፥</para>
  <para style="q2" vid="LAM 1:7">እዮ ማድያ እሶይካ በንትቤና።</para>
  <para style="q1" vid="LAM 1:7">እ ሞርከት እዮ ፄልድ፥</para>
  <para style="q2" vid="LAM 1:7">እ ዩዋን ሚጭዶሶና።<verse eid="LAM 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>የሩሳላመይ ግታ ናጋራ ኦዳ ግሾ ቱናሱ፤</para>
  <para style="q2" vid="LAM 1:8">እዮ ቦንችዳ ኡባይ እ ካሉዋ በእዳ ግሾ ካስ፤</para>
  <para style="q2" vid="LAM 1:8">እያ ኦላሸ ጉየ ስማሱ።<verse eid="LAM 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>ቱናተ እ አፍላ ቦላ በንትስ፤</para>
  <para style="q2" vid="LAM 1:9">ስንፈ ባ ቦላ ያናባ ቆፓቡኩ።</para>
  <para style="q1" vid="LAM 1:9">እ ኩንደይ ዳጋንያባ ግድስ፤</para>
  <para style="q2" vid="LAM 1:9">እዮ ምንያ ኦንካ ባዋ።</para>
  <para style="q1" vid="LAM 1:9">እያ፥ “አቤት ጎዳዉ፥ ታ ኡንኤተ በአ!</para>
  <para style="q2" vid="LAM 1:9">ታ ሞርከት ታና ፆንዶሶና” ያጋሱ።<verse eid="LAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>ሞርከት እ ቦንቾ ሻሉዋ ቦንቅዶሶና፤</para>
  <para style="q2" vid="LAM 1:10">ካሰ ነ ማባራ ግዶ ገሎና መላ፥</para>
  <para style="q2" vid="LAM 1:10">ኔኒ ድግዳ አሳት፥ እ ኬ ገልሽን በአሱ።<verse eid="LAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>እ አሳት ኮሻትድ ካ ደማናዉ ኦሎሶና፤</para>
  <para style="q2" vid="LAM 1:11">ኤንቲ ደኦን ዳናዉ ባንታ ሻሉዋ ካን ላሞሶና።</para>
  <para style="q1" vid="LAM 1:11">የሩሳላመይ ሀይሳዳ ያጋሱ፤</para>
  <para style="q2" vid="LAM 1:11">አቤት ጎዳዉ፥ ታና ፄላ፤</para>
  <para style="q2" vid="LAM 1:11">ታ ካዉሻተ በአ!<verse eid="LAM 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>ህንተኖ፥ ሀይሳራ አይሳቶ፥</para>
  <para style="q2" vid="LAM 1:12">ሀይስ ህንተዉ አይኮካ ዳነኔ?</para>
  <para style="q1" vid="LAM 1:12">አነ በእተ፤ አኬክተ፤</para>
  <para style="q2" vid="LAM 1:12">ባ ኤፅያ ሀንቆ ጋላሳን፥</para>
  <para style="q1" vid="LAM 1:12">ፆሳይ ታ ቦላ ኤህዳ</para>
  <para style="q2" vid="LAM 1:12">መቱዋ መላ መቶይ ደኢ?<verse eid="LAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>ቦላፈ ታማ ዱገ የድስ፤</para>
  <para style="q2" vid="LAM 1:13">ሄ ታማይ ታ መቀ ግዶ ገልስ።</para>
  <para style="q1" vid="LAM 1:13">ታ ቶሆይ ፅሄን ኦይከትስ፤ ታና ጉየ ዛርስ፤</para>
  <para style="q2" vid="LAM 1:13">ታና ጋላስ ኡባ ላባንድ የግ አግስ።<verse eid="LAM 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>ታ ኦዳ ናጋራ ኡባ ሺሽ ቃችድ፥</para>
  <para style="q2" vid="LAM 1:14">ቃምባራዳ ታ ጋናን ዎስ፤</para>
  <para style="q2" vid="LAM 1:14">ያትድ ታ ዎልቃ ዉርስስ።</para>
  <para style="q1" vid="LAM 1:14">ታ ኤቀታናዉ ዳንዳኦና አሳስ፥</para>
  <para style="q2" vid="LAM 1:14">ታና አድ እሚስ።<verse eid="LAM 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>ጎዳይ ታ ግዶን ደእያ</para>
  <para style="q2" vid="LAM 1:15">ዎልቃማ ኦላንቾታ ኡባ ድግስ።</para>
  <para style="q1" vid="LAM 1:15">ታ ያላጋታ ይሳናዉ ዎደ ቃችስ፤</para>
  <para style="q2" vid="LAM 1:15">ዎይነ የይሳዳ፥</para>
  <para style="q2" vid="LAM 1:15">ጎዳይ ይሁዳ ጌላኦታ የስ።<verse eid="LAM 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>ታኒ ዬካሸ ታ አፉ ጉሰይ ሄሳሳ፤</para>
  <para style="q2" vid="LAM 1:16">ታና ምንይነ ካትስያ ኦንካ ባዋ፤</para>
  <para style="q2" vid="LAM 1:16">ሞርከይ ጎብን፥ ታ ናይት ኡንኤትዶሶና።<verse eid="LAM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LAM 1:17"/>ፅዮነይ ባ ኩሽያ ምጫሱ፤</para>
  <para style="q2" vid="LAM 1:17">ሽን እዮ ምንያ ኦንካ ባዋ።</para>
  <para style="q1" vid="LAM 1:17">እ ዩሹዋን ደኤይሳት</para>
  <para style="q2" vid="LAM 1:17">እዮ ሞርካናዳ ጎዳይ ኦስ።</para>
  <para style="q2" vid="LAM 1:17">የሩሳላመይ ኤንታ ግዶን ቱና ግዳሱ።<verse eid="LAM 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>እያ ሀይሳዳ ያጋሱ፤ “ጎዳይ ፅሎ፤</para>
  <para style="q2" vid="LAM 1:18">እያ ኪተቶና እፅዳይ ታና።</para>
  <para style="q1" vid="LAM 1:18">ህንተኖ፥ አሳቶ ኡባይ ስእተ፤ ታ መቱዋካ በእተ፤</para>
  <para style="q2" vid="LAM 1:18">ታ ፓንትነ ታ ጌላኦት ድኤትዶሶና።<verse eid="LAM 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>ታ ላገታ ፄጋስ፤ ሽን ኤንቲ ታና ጭምዶሶና፤</para>
  <para style="q2" vid="LAM 1:19">ካህነትነ ጭማት ባንታ ሸምፑዋ አሻናዉ፥</para>
  <para style="q2" vid="LAM 1:19">ካ ኮይሸ ካታማ ግዶን ሀይቅዶሶና።<verse eid="LAM 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>አቤት ጎዳዉ፥ ታ ዋይያ በአ!</para>
  <para style="q2" vid="LAM 1:20">ታ ጋርሳይ ዳጋምስ።</para>
  <para style="q1" vid="LAM 1:20">ታኒ ዳሮ ማካልዳ ግሾ፥ ታ ዎዛናይ መቅስ፤</para>
  <para style="q2" vid="LAM 1:20">ካረን ማሽ ዉርሴስ፤ ሶን ሀይቆይ ደኤስ።<verse eid="LAM 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>አሳይ ታ ዘለልሳ ስእዶሶና፤</para>
  <para style="q2" vid="LAM 1:21">ሽን ታና ምንያ እስ አስካ ባዋ።</para>
  <para style="q1" vid="LAM 1:21">ታ ሞርከት ታ መቱዋ ስእዶሶና፤</para>
  <para style="q2" vid="LAM 1:21">ነ ታ ቦላ ኦዳባን ኡፋይትዶሶና።</para>
  <para style="q1" vid="LAM 1:21">ኤንቲ ታዳ ሀናና መላ፥</para>
  <para style="q2" vid="LAM 1:21">ኤንታ ቦላ ነ አዋጅዳ ጋላሳ ኤሀ!<verse eid="LAM 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>ኤንታ ኢታተ ኡባይ ነ ስን ጋኮ፤</para>
  <para style="q2" vid="LAM 1:22">ታ ናጋራ ግሾ ታና ሴርዳይሳዳ ኤንታካ ሴራ፤</para>
  <para style="q2" vid="LAM 1:22">ታ ዘለልሳይ ዳርስ፤ ታ ዎዛናይካ መቅስ።”<verse eid="LAM 1:22"/></para>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="s1">ቃይ ባይና ሴራ</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1"/>ጎዳይ ባ ሀንቆ ሻራፐ ጋርሳን፥</para>
  <para style="q2" vid="LAM 2:1">ፅዮነ ናእዉ፥ ዋትድ ዎደ!</para>
  <para style="q1" vid="LAM 2:1">እስራኤለ ቦንቹዋ ሳሎፐ ሳአ ሆልስ፤</para>
  <para style="q2" vid="LAM 2:1">ባ ሀንቁዋ ጋላስ፥</para>
  <para style="q2" vid="LAM 2:1">እያ ቶሆይ የያ በሳ ቆፕቤና።<verse eid="LAM 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>ጎዳይ ይሁዳን ኬታ ኡባ ቃቶና ይስስ፤</para>
  <para style="q2" vid="LAM 2:2">ባ ሀንቁዋን ይሁዳ ቢታ ሚፃ ኡባ ላልስ፤</para>
  <para style="q2" vid="LAM 2:2">ሄ ካዎተነ ሀላቃታ ሳአን ዱገ የግድ ካዉሽስ።<verse eid="LAM 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>ባ ዎልቃማ ሀንቁዋን እስራኤለ ዎልቃ መንረስ፤</para>
  <para style="q2" vid="LAM 2:3">ሞርከይ እያ ኦላናዉ ያ ዎደ</para>
  <para style="q2" vid="LAM 2:3">ጎዳይ ባ ኡሻቻ ኩሽያ ኤንታ ቦላፈ ድግስ።</para>
  <para style="q1" vid="LAM 2:3">ባ ዩሹዋን ደእያባ ኡባ ምያ ታማዳ፥</para>
  <para style="q2" vid="LAM 2:3">ያይቆባ ቦላ ታማ ላጮይ ኤፅስ።<verse eid="LAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>ሞርከዳ እ ባ ዶንግያ ኤንታ ቦላ ዳፍስ፤</para>
  <para style="q2" vid="LAM 2:4">ኡንኤያ እያ ኡሻቻ ኩሸይ ጊግስ።</para>
  <para style="q1" vid="LAM 2:4">አይፌስ ሎእያ አሳ ኡባ ዎስ፤</para>
  <para style="q2" vid="LAM 2:4">ፅዮነ ቦላ ባ ሸንያ ታማዳ ቆልስ።<verse eid="LAM 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>ጎዳይ ሞርከዳ ሀንድ፥ እስራኤለ ይስስ፤</para>
  <para style="q2" vid="LAM 2:5">ካዎ ጋታነ ሚፃ ኡባ ላልስ</para>
  <para style="q2" vid="LAM 2:5">ይሁዳ አሳስ ዬሆነ ካዮ ጉጅስ።<verse eid="LAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>ባ ኬ አታክልተ ጋደን ደእያ ሻቃራዳ ሾድድ ሆልስ፤</para>
  <para style="q2" vid="LAM 2:6">ላይ ባለትነ ሳምባታት ዶገታናዳ ኦስ፤</para>
  <para style="q2" vid="LAM 2:6">ባ ግታ ሀንቁዋን ካዋነ ካህንያ ካዉሽስ።<verse eid="LAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>ጎዳይ ባ ያርሾ በሳ ካስ፤ ባ ኬ አጋግስ፤</para>
  <para style="q2" vid="LAM 2:7">ካዎ ጋታ ግምብያ ሞርከታ ኩሸን የግስ።</para>
  <para style="q1" vid="LAM 2:7">ላይ ባኣለ ቦንችያ ጋላሳ ዎጫማዳ፥</para>
  <para style="q2" vid="LAM 2:7">ሞርከት ፆሳ ኬን ዎጫምዶሶና።<verse eid="LAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>ጎዳይ ፅዮን ናኤ ድርሳ ግምብያ፥</para>
  <para style="q2" vid="LAM 2:8">ላላናዉ ቃችስ፤ እ ቦላ ዋ ዎዶሮ የግስ።</para>
  <para style="q1" vid="LAM 2:8">እዮ ይሶና ደእሸ ባ ኩሽያ ዛረና፤</para>
  <para style="q2" vid="LAM 2:8">ግምበይነ ሚፃይ እስፈ ኩንዳናዳ ኦስ።<verse eid="LAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>የሩሳላመ ፐንገ ሳንቃት ቢታን ሞገትዶሶና፤</para>
  <para style="q2" vid="LAM 2:9">ኤንታ ጎርደ ምታ መንረድ ይስስ።</para>
  <para style="q1" vid="LAM 2:9">ካዎይነ ሞርናት ድኤትድ ካዎተታ ግዶ ብዶሶና፤</para>
  <para style="q2" vid="LAM 2:9">ህገ ታማርሰይ ባዋ፤</para>
  <para style="q2" vid="LAM 2:9">ናበትካ ህዛፐ ጉየ ቆንጨ በኦኮና።<verse eid="LAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>ፅዮነ ጭማት ስእ ግድ ቢታን ኡትዶሶና፤</para>
  <para style="q2" vid="LAM 2:10">ባንታ ሁጰን ባና ቆልድ ካዮ ማኦ ማእዶሶና፤</para>
  <para style="q2" vid="LAM 2:10">የሩሳላመ ጌላኦት ሳአን ዱገ ሆክዶሶና።<verse eid="LAM 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>ታ አሳይ ይዳ ግሾ፥</para>
  <para style="q2" vid="LAM 2:11">ጉ ናይት ካታማ ኦግያ ቦላ</para>
  <para style="q2" vid="LAM 2:11">ዳቡርድ ኩንድዳ ግሾ፥</para>
  <para style="q2" vid="LAM 2:11">ታ አይፈይ አፉን ቱልጫትስ፤</para>
  <para style="q2" vid="LAM 2:11">ታ ዎዛናይ አዛኖን ዳጋምስ።<verse eid="LAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>ኤንቲ ባንታ አየታኮ፥</para>
  <para style="q2" vid="LAM 2:12">“ካ እማ! ሃ እማ”</para>
  <para style="m" vid="LAM 2:12">ያግድ ዋሶሶና፤</para>
  <para style="q2" vid="LAM 2:12">ካታማ ኦግያን ማዱንፅድ ላባንያ አሳዳ፥</para>
  <para style="q2" vid="LAM 2:12">ኤንቲ ዳቡርን ኤንታ ሸምፖይ ኤንታ አየታ ክኦን ከዬስ።<verse eid="LAM 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LAM 2:13"/>የሩሳላመ ናተ፥ ታኒ ነባ አይ ጋኔ?</para>
  <para style="q2" vid="LAM 2:13">ነ ቆሁዋ ታ አይብራ ግናዮ?</para>
  <para style="q1" vid="LAM 2:13">ዶሰትዳ ፅዮነ ጌላኤ፥ ታ ነና ዋታዳ ምን?</para>
  <para style="q2" vid="LAM 2:13">ነ ማዱንይ አባ መላ ጪሞ፤</para>
  <para style="q2" vid="LAM 2:13">ነና ኦን ፓናዉ ዳንዳኢ?<verse eid="LAM 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>ነ ናበት ዎርዶነ ፓና ቆንጨ በእዶሶና፤</para>
  <para style="q2" vid="LAM 2:14">ነ ድኤቶና መላ ነ ናጋራ ቆንጭስድ ኦድቦኮና፤</para>
  <para style="q2" vid="LAM 2:14">ኤንቲ ባለያ ዎርዶ ቆንጨ ነዉ በእዶሶና።<verse eid="LAM 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15"/>ነ ማታራ አያ ኡባይ ባ ኩሽያ ባቄስ፤</para>
  <para style="q2" vid="LAM 2:15">“ቢታን ኡባፈ አዳ ሎእያ ካታምያ ሀኖ?</para>
  <para style="q1" vid="LAM 2:15">ቢታ ኡባስ ኡፋይስ ጌተትዳ ካታምያ ሀኖ?”</para>
  <para style="q2" vid="LAM 2:15">ያግድ ነና ቀልቅስሸ ባንታ ሁጵያ ቃዶሶና።<verse eid="LAM 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>ነ ሞርከት ኡባይ ባንታ ዶና</para>
  <para style="q2" vid="LAM 2:16">ነ ቦላ ዶይዶሶና፤</para>
  <para style="q2" vid="LAM 2:16">ነ ቦላ ቀልቅስዶሶና።</para>
  <para style="q1" vid="LAM 2:16">ባንታ አቻ ቃርጭሸ ሀይሳዳ ያጎሶና፤</para>
  <para style="q2" vid="LAM 2:16">ኑ ኤንታ ይስዳ፥ ኑ አሞትዳይ ሄሳ</para>
  <para style="q2" vid="LAM 2:16">ዉርሰን በእዳ።<verse eid="LAM 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>ጎዳይ ባ ቆፕዳባ ኦስ፤</para>
  <para style="q2" vid="LAM 2:17">ካሰ ኦድዳ ባ ቃላ ፖልስ።</para>
  <para style="q1" vid="LAM 2:17">የሩሳላመስ ቃቶና እዮ ላልስ</para>
  <para style="q1" vid="LAM 2:17">እ ሞርከት ኡፋይታና መላ፥</para>
  <para style="q2" vid="LAM 2:17">ሞርከታ ዎልቃ ምንስ።<verse eid="LAM 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>ፅዮነ፥ ነ ድርሳ ግምበይ ጎዳኮ ዋሶ!</para>
  <para style="q2" vid="LAM 2:18">ነ አፉይ ቃማነ ጋላስ ሻፋዳ ጎጎ!</para>
  <para style="q1" vid="LAM 2:18">ነዉካ ሸምፖፋ፤</para>
  <para style="q2" vid="LAM 2:18">ነ አይፍያስ ሸምፖ እሞፋ!<verse eid="LAM 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>ቃማ ደንዳዳ ዋሳ፤</para>
  <para style="q2" vid="LAM 2:19">ጎዳ ስንን ነ ዎዛና ሃዳ ጉሳ።</para>
  <para style="q1" vid="LAM 2:19">ኮሻትድ ኦገ ዶናን ኩንድዳ ነ ናይታ ሸምፑዋስ</para>
  <para style="q2" vid="LAM 2:19">ነ ኩሽያ እያኮ ፑደ ደንዳ ዎሳ!<verse eid="LAM 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>አቤት ጎዳዉ፥ በአ!</para>
  <para style="q2" vid="LAM 2:20">ካሰ ሀይሳዳ ኔኒ ኦደ ቦላ ኦዲ?</para>
  <para style="q1" vid="LAM 2:20">አየት ባንታ ክኦን ኮእስድ</para>
  <para style="q2" vid="LAM 2:20">ድችዳ ባንታ ናይታ ሞ ጋይ?</para>
  <para style="q2" vid="LAM 2:20">ካህነትነ ናበት ፆሳ ኬን ሀይቆ ጋይ?<verse eid="LAM 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>ጭምነ ናአተ ኦገ ቦላ ኩንድዶሶና፤</para>
  <para style="q2" vid="LAM 2:21">ጌላኦትነ ፓንት ማሻን ዉርዶሶና።</para>
  <para style="q1" vid="LAM 2:21">ኔኒ ነ ሀንቁዋ ጋላስ ኤንታ ዎዳሳ፤</para>
  <para style="q2" vid="LAM 2:21">ኤንታዉ ቃቶና ኤንታ ቡዳሳ።<verse eid="LAM 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>ግብራ ጋላስ አሰ ፄገይሳዳ፥</para>
  <para style="q2" vid="LAM 2:22">ዳጋንያ ታ ሞርከታ ኡባ በሳፈ ፄጋዳሳ።</para>
  <para style="q1" vid="LAM 2:22">ጎዳ ሀንቆ ጋላሳን</para>
  <para style="q2" vid="LAM 2:22">ኦንካ ከስ ኤክቤና ዎይኮ አትቤና።</para>
  <para style="q1" vid="LAM 2:22">ታኒ ታ ክኦን ኮእሳዳ ድችዳ</para>
  <para style="q2" vid="LAM 2:22">ናይታ ኡባ ሞርከይ ዎድ ይስስ።<verse eid="LAM 2:22"/></para>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="s1">ፆሳይ አማንስ</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 3:1"/>ጎዳ ሸነ ፃምአን</para>
  <para style="q2" vid="LAM 3:1">መቶ በእዳ አስ ታና።<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>ታና ባ ስንፈ ከስድ፥</para>
  <para style="q2" vid="LAM 3:2">ፖኦይ ባይና ማን ዎስ።<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>ጋላስ ኩመ ታና ሾጫናዉ</para>
  <para style="q2" vid="LAM 3:3">ዛር ዛር ባ ኩሽያ ደንስ።<verse eid="LAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>እ፥ ታ ጋልባነ ታ አሹዋ ጭምስስ፤</para>
  <para style="q2" vid="LAM 3:4">ታ መቀ መንስ።<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>እ፥ ታ ዩሹዋ መቶንነ</para>
  <para style="q2" vid="LAM 3:5">ዳቡራን ድርስ።<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>በን ሀይቅዳ አሳዳ</para>
  <para style="q2" vid="LAM 3:6">ታና ማን ዎስ።<verse eid="LAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>ታ ከሳ ኤኮና መላ፥</para>
  <para style="q2" vid="LAM 3:7">ታ ዩሹዋ ድርስ፤</para>
  <para style="q2" vid="LAM 3:7">ዴፆ ዱን ታና ዱፅስ።<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>ታኒ ማደ ኮያዳ እያ ፄግን፥</para>
  <para style="q2" vid="LAM 3:8">እያኮ ዋስን፥ ታና ስኦና እፅስ።<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>ታ ኦግያ ዎልቃማ ሹቻን ጎርድስ፤</para>
  <para style="q2" vid="LAM 3:9">ታ ኦግያ ጌላይስ።<verse eid="LAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>እ፥ ታዉ ዙግድ ናግያ ባባን መላ፥</para>
  <para style="q2" vid="LAM 3:10">ቆሰትድ ናግያ ጋሞ መላ ግድስ።<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>እ፥ ታና ታ ኦግያፐ ከስድ ዱሰረስ፤</para>
  <para style="q2" vid="LAM 3:11">ታና አስ ባይና በሳን የግ አግስ።<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>ባ ዶንግያ ዳፍድ፥</para>
  <para style="q2" vid="LAM 3:12">ታና ዱካናዉ ማልስ።<verse eid="LAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>ባ ዶንግያ ዳፍድ፥</para>
  <para style="q2" vid="LAM 3:13">ታ ዎዛና አይፈን ጫድስ።<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>ታኒ አሳ ኡባስ ሚቻስ አታስ፤</para>
  <para style="q2" vid="LAM 3:14">ጋላስ ኩመ ቦረ የስ ግዳስ።<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>እ፥ ታና መቶን ጫምስስ፤</para>
  <para style="q2" vid="LAM 3:15">ጫሞ ጎዳረ ኡ ታና ኡሽድ ካልስስ።<verse eid="LAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>እ፥ ታ አቻ አጨን መንስ፤</para>
  <para style="q2" vid="LAM 3:16">ታና ባናን የስ።<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>ሳሮይ ታፐ ሃክስ፤</para>
  <para style="q2" vid="LAM 3:17">ታኒ እንጀ ዱሱ ዶጋስ።<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>ሄሳ ግሾ፥</para>
  <para style="q2" vid="LAM 3:18">“ታ ዎልቃይ ታፐ ኤከትስ፤</para>
  <para style="q2" vid="LAM 3:18">ታኒ ጎዳን ዎዳ ኡፋይሳ ኡባይ ይስ”</para>
  <para style="m" vid="LAM 3:18">ያጋስ።<verse eid="LAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>ታ መቱዋነ ታ ኡንኣ ሀሳይን ደኦይ ታና ጫምስ።<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>ታ ሄሳ ኩመ ዶግከ፤ ታ ሸምፖይ አዛኔስ።<verse eid="LAM 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LAM 3:21"/>ግዶሽን፥ ታ እስባ ታ ዎዛናን ቆፕያ ዎደ ታ ኡፋይሳን ኩማይስ።<verse eid="LAM 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>ሄስካ፥ ኑኒ ይቦናይ</para>
  <para style="q2" vid="LAM 3:22">ጎዳ ሲቁዋፐ ደንዶይሳና፤</para>
  <para style="q2" vid="LAM 3:22">እያ ቃይ ዉር ኤረና።<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>ኤንቲ ዎንታ ዎንታ ኦራ፤</para>
  <para style="q2" vid="LAM 3:23">ነ ዳሮ አማንሳ።<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>ጎዳይ ታ ሳማ፤</para>
  <para style="q2" vid="LAM 3:24">ሄሳ ግሾ፥ ታ እያን ኡፋይስ ዎና።<verse eid="LAM 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>እያን ባንታ ኡፋይሳ ዎይሳታስነ</para>
  <para style="q2" vid="LAM 3:25">እያ ኮየይሳታስ ጎዳይ ሎኦ።<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>አስ ስእ ግድ ጎዳ አቶተን ናግኮ ሎኦ።<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>አስ ባ ናአተን መቶ ዳንዳአ ታማርኮ ሎኦ።<verse eid="LAM 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>ጎዳይ መቶ ኤህያ ዎደ ስእ ግድ ኡቶ።<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>እያዉ ስንፈ ኡፋይስ ዳናዉ ዳንዳእያ ግሾ ባና ዝቅ ኦ።<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>እ ባ ሻካላ ባቀይሳስ እሞ፤ ጫሸ ካሎ።<verse eid="LAM 3:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>ጎዳይ አሰ መርናዉ የገና።<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>እ አሳ ቦላ መቶ ኤህኮካ፥</para>
  <para style="q2" vid="LAM 3:32">ባ መርና ሲቁዋ ዳሮተን ዛሪድ ቃቴስ።<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>እ አሳ ቦላ መቶ ዎይኮ ኡንአ ኤህድ ኡፋይተና።<verse eid="LAM 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>ብታን ደኢያ ቃሾ አሳታ የያ ዎደ፥<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>ኡባፈ ዎልቃማ ፆሳ ስንን አሳ ማት የትያ ዎደ፥<verse eid="LAM 3:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36"/>ፅሎ ፕርድ ይያ ዎደ ጎዳይ ሄሳ ኡባ በኤነዬ?<verse eid="LAM 3:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>ጎዳይ ኪቶናሽን ኦድድ ፖልሳናዉ ዳንዳኤይ ኦኔ?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>ኢታባ ግድን ሎኦባ ኦድ ፖለይ ኡባፈ ቃ ፆሳ ግደነዬ?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>ያትን፥ አስ ደኦን ደእሸ ባ ናጋራ ግሾ ሴረትያ ዎደ አይስ ዙዙሚ?<verse eid="LAM 3:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>አነ ኑ ኦግያ ፓጮስ፤ ጎዳኮ ስሞስ።<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>ኑ ዎዛና ኑ ኩሽያራ ሳሎን ደእያ ፆሳኮ ደንድ ሀይሳዳ ያጎስ፦<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>ኑ ነና ናቅዳ፤ ነዉ ማካልዳ፤</para>
  <para style="q2" vid="LAM 3:42">ነካ ኑስ አቶ ጋባካ።<verse eid="LAM 3:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>ነ ሀንቁዋን ካመታዳ ኑና የደዳ፤</para>
  <para style="q2" vid="LAM 3:43">ነ ኑስ ቃቶና ኑና ዎዳሳ።<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>ኑ ዎሳይ ኔኮ ጋኮናዳ፥ ነናተ ሻራን ካማዳሳ።<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>አሳ ግዶን ኑና ፕቶነ ቡረ ኦዳሳ።<verse eid="LAM 3:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>ኑ ሞርከት ኡባይ ኑ ቦላ ባንታ ዶና ዶይዶሶና።<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>ኑ ዳጋማንነ ግተን ገልዳ፤ መቶንነ ኡንአን ላለትዳ።<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>ታ አሳ ጋክዳ ዋይያ ጋሶን ታ አይፈፐ አፉ ሻፋዳ ጎጌስ።<verse eid="LAM 3:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>ታ አይፈይ አጎና አፉፄስ።<verse eid="LAM 3:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50"/>ጎዳይ ሳሎፐ ዱገ በአና ጋካናዉ ሄስ ሀኔስ።<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>ታ ካታማን ደእያ ማጫሳታ ቦላ ጋክዳባ ታ አይፈይ በእዳ ዎደ ታ ዎዛናይ አዛንስ።<verse eid="LAM 3:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>ጮ ታና ሞርከይሳት ካፎ ሻንካትያዳ ታና ሻንካትዶሶና።<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>ታ ፓፃ ደእሽን ታና ኦላን የግድ፥</para>
  <para style="q2" vid="LAM 3:53">ኦላ ዶና ሹቻን ጎርድዶሶና።<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>ሃ ኩምድ ታ ሁጰራ ጎግያ ዎደ ታ ያስ ጋዳ ቆፓስ።<verse eid="LAM 3:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>አቤት ጎዳዉ፥ ታ ጪሞ ኦላን ደአሸ ነ ሱን ፄጋስ።<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>ታ ዋሱዋ ስአናዳ ታ ነና ዎስያ ዎደ ታና ስአዳሳ።<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>ታኒ ነና ፄግዳ ዎደ ታኮ ሺቃዳ፥ “ባቦፋ” ያጋዳሳ።<verse eid="LAM 3:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>አቤት ጎዳዉ ነ ታ ሞቱዋ ሞተታዳ ታና ዎዛዳሳ።<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>አቤት ጎዳዉ፥ ነ ታ ኡንኣ በአዳሳ፤</para>
  <para style="q2" vid="LAM 3:59">ሄሳ ግሾ፥ ነ ታዉ ፕርዳ።<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>ኤንቲ ሀሎ ከያናዉ ታ ቦላ ማቀትያ ማቁዋ ኡባ በአዳሳ።<verse eid="LAM 3:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>አቤት ጎዳዉ፥ ኤንቲ ታና ጫይያ ጫሻነ</para>
  <para style="q2" vid="LAM 3:61">ታ ቦላ ማቀትያ ማቁዋ ኡባ ስአዳሳ።<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>ታ ሞርከት ጋላስ ኩመ</para>
  <para style="q2" vid="LAM 3:62">ታ ቦላ ዙዙመይሳነ ካልካሸይሳ ስአዳሳ።<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>ኤንቲ ኡትሸነ ኤቅሸ ታና ቦርድ የፆሶና።<verse eid="LAM 3:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>አቤት ጎዳዉ፥ ኤንቲ ኦዳ ኦሱዋስ በሲያ ዛሩዋ ኤንታዉ ቃንፃ!<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>ኤንታ ዎዛና ኤይሳ፤ ነ ባደይ ኤንታ ጋኮ።<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>አቤት ጎዳዉ፥ ነ ኤንታ ነ ሀንቁዋን የደ፤</para>
  <para style="q2" vid="LAM 3:66">ሳሎፐ ጋርሳን ኤንታ ይሳ።<verse eid="LAM 3:66"/></para>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="s1">ጌሻ ሹቻት ላለትዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 4:1"/>ዎርቀይ ጶለይሳ ዋንድ አግዴ?</para>
  <para style="q2" vid="LAM 4:1">ጌሻ ዎርቃይ ዋንድ ዳምዴ? ፆሳ ኬይ ግምበትዳ ሹቻይ ኦገ ዶናን ላለትስ።<verse eid="LAM 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>ካሰ አልኦ ዎርቃ መላ ቦንቸትዳ ፅዮነ ናይት</para>
  <para style="q2" vid="LAM 4:2">ሀእ ቢታፈ መትዳ ኦቶ ግድዶሶና።<verse eid="LAM 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>ሀር አቶሽን ዎራካን ባ ማር ንዉሱ፤</para>
  <para style="q2" vid="LAM 4:3">ሽን ታ አሳይ ባዞን ደእያ ያንቾዳ፥ ባ ናይታስ ኢታ ግድስ።<verse eid="LAM 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>ሳሞ ጋሶን ዮጋ ናይታ እንፃርሳይ ኮቶኖራ ኦይከትስ፤</para>
  <para style="q2" vid="LAM 4:4">ናይት ካ ዎሶሶና፤</para>
  <para style="q2" vid="LAM 4:4">ሽን ኤንታዉ እምያ ኦንካ ባዋ።<verse eid="LAM 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>ካሰ ማልኦ ካ ፃላላ መይሳት</para>
  <para style="q2" vid="LAM 4:5">ሀእ ኦገ ዶናን ኮሻን ዉርዶሶና።</para>
  <para style="q1" vid="LAM 4:5">ካሰ ሊኖ ማእድ ድጭዳይሳት</para>
  <para style="q2" vid="LAM 4:5">ሀእ ብዶ ቦላ ዝንእዶሶና።<verse eid="LAM 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>ታ አሳ ናጋራይ፥</para>
  <para style="q2" vid="LAM 4:6">ኦደ ኩሸይካ እዮ ቦቾና፥</para>
  <para style="q2" vid="LAM 4:6">ቆፖና ሽረትድ ዎዳ ሶዶመ አሳ ናጋራፐ ዳሮ።<verse eid="LAM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>ይሁዳ ሀላቃት ሻቻፈ አዳ ጌሽ፥</para>
  <para style="q2" vid="LAM 4:7">ማፈ አዳ ቦ።</para>
  <para style="q1" vid="LAM 4:7">ኤንታ አሳተይ ዞኦ እንቆፈ አዳ አርሰ፤</para>
  <para style="q2" vid="LAM 4:7">ኤንታ መይ ሳንፓረ አልኦ ሹቻ መላ።<verse eid="LAM 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>ሽን ሀእ ኤንታ ሶምኦይ ሻላፐ አድ ካሬፅስ፤</para>
  <para style="q2" vid="LAM 4:8">አስ ኦገን ኤንታ በእድ ኤረና፤</para>
  <para style="q2" vid="LAM 4:8">ኤንታ ጎጋይ መቀራ ኦይከትድ ምዳ መልስ።<verse eid="LAM 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>ምያባ ይድ፥ ኮሻን ሀይቅዳይሳታፐ</para>
  <para style="q2" vid="LAM 4:9">ኦላን ሀይቅዳይሳት ሎኦ።<verse eid="LAM 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>ታ አሳ ቦላ ይዳ ዩዋ ጋሶን፥</para>
  <para style="q2" vid="LAM 4:10">ቃትያ አየት ባንታ ናይታ ዶይስድ ምዶሶና።<verse eid="LAM 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>ጎዳ ሀንቆ ፁአይ ኩምስ፤ እ ባ ሱልያ ሸንያ ትግስ።</para>
  <para style="q2" vid="LAM 4:11">የሩሳላመ ባሱዋ ታማ ኦይስ።<verse eid="LAM 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>ሀ ሳአ ካዎታፐ ዎይኮ ካዎተታን ደእያ አሳፐ ኦንካ</para>
  <para style="q2" vid="LAM 4:12">ሞርከይ የሩሳላመ ፐንግያራ ገላና ግድ አማንበና።<verse eid="LAM 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>ሽን ሀይስ ሀንዳይ እያ ናበታ ናጋራስነ እያ ካህነት ኦዳ ናቁዋሳ፥</para>
  <para style="q2" vid="LAM 4:13">ፅሎታ ሱ እያ ግዶን ጉስዳ ግሾሳ።<verse eid="LAM 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>ኤንቲ ቆቀ አሳዳ፥ ኦገ ታታፎሶና፤</para>
  <para style="q2" vid="LAM 4:14">ኤንቲ ሱን ቱንዳ ግሾ</para>
  <para style="q2" vid="LAM 4:14">ኤንታ ማኡዋ ኦንካ ቦቻናዉ ኮየና።<verse eid="LAM 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>ሄሳ ግሾ፥ አሳይ፥ “ክችተ! ህንተ ቱና ግድያ ግሾ፥</para>
  <para style="q2" vid="LAM 4:15">ኑና ቦቾፍተ!” ያግድ ኤንታ ቦላ ዋስዶሶና።</para>
  <para style="q1" vid="LAM 4:15">ኤንቲ ባቃትድ ቶይላትያ ዎደ፥</para>
  <para style="q2" vid="LAM 4:15">ካዎተታን ደእያ አሳይ፥</para>
  <para style="q2" vid="LAM 4:15">“ህንተ ኑራ ሀይሳን ዳናዉ ዳንዳኤከታ” ያግዶሶና።<verse eid="LAM 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>ጎዳይ ኤንታ ላልስ፤ እ ኤንታባ ዛሪድ ቆፐና፤</para>
  <para style="q2" vid="LAM 4:16">ኤንታ ካህነት ቦንቸቶኮና፤</para>
  <para style="q2" vid="LAM 4:16">ኤንታ ጭማት ናሸቶኮና።<verse eid="LAM 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>ኑ አይፈይ ማዶ ደማናዉ ፄልሸ ጮ ዳቡርስ፤</para>
  <para style="q2" vid="LAM 4:17">ኑና አሻናዉ ዳንዳኦና</para>
  <para style="q2" vid="LAM 4:17">ካዎተታፐ ማዶ ናግዳ።<verse eid="LAM 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>አሳይ ኑ ገዳ ካልያ ግሾ፥</para>
  <para style="q2" vid="LAM 4:18">ኑ ካታማ ኦገራ ሄመታናዉ ዳንዳእቦኮ።</para>
  <para style="q1" vid="LAM 4:18">ኑ ዉርሰይ ማትስ፤ ኑ ላይይ ዉርስ፤</para>
  <para style="q2" vid="LAM 4:18">ኑስ ዮ ዎደይካ ጋክስ።<verse eid="LAM 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>ኑና የደይሳት ፕራያ አርጋንፈ አድ ኤሶቶሶና፤</para>
  <para style="q2" vid="LAM 4:19">ኤንቲ ኑና ደረ ሁጰራ የደዶሶና፤</para>
  <para style="q2" vid="LAM 4:19">ባዞን ሆክድ ኑና ናግዶሶና።<verse eid="LAM 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>ጎዳይ ትይዳ ካዎይ፥ ኑ ደኡዋስ ሸምፖይ፥</para>
  <para style="q2" vid="LAM 4:20">ኤንታ ፅህያን ኦይከትስ።</para>
  <para style="q1" vid="LAM 4:20">ኑ እያ ኩያ ጋርሳን ኡትድ፥</para>
  <para style="q2" vid="LAM 4:20">ካዎተታ ግዶን ዳና ግድ ቆፕዳ።<verse eid="LAM 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>ህንተኖ፥ ኡፃ ቢታን ደእያ ኤዶመ አሳዉ፥</para>
  <para style="q2" vid="LAM 4:21">ኡፋይትተ፤ ሀሹ ጊተ።</para>
  <para style="q1" vid="LAM 4:21">ሽን ፁአይ ህንተ ቦላ ያና፤</para>
  <para style="q2" vid="LAM 4:21">ህንተ ማትድ ካሎ አታና።<verse eid="LAM 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>ህንተኖ፥ ፅዮነ አሳዉ፥ ህንተ ሴራይ ግዳና፤</para>
  <para style="q2" vid="LAM 4:22">እ ህዛፐ ህንተና ድኦ ቢታን ዎና።</para>
  <para style="q1" vid="LAM 4:22">ሽን ኤዶመ አሳዉ፥ ህንተ ሴረታና፤</para>
  <para style="q2" vid="LAM 4:22">ህንተ ናጋራይካ ቆንጫና።<verse eid="LAM 4:22"/></para>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="s1">ጎዳዉ፥ ኑና ኔኮ ዛራ</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 5:1"/>አቤት ጎዳዉ፥ ኑና ጋክዳባ ኡባ ቆፓ፤</para>
  <para style="q2" vid="LAM 5:1">ኑ ካዉሻተ በአ!<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>ኑ ላታይ አላጋታስ፥</para>
  <para style="q2" vid="LAM 5:2">ኑ ኬይካ እማ አሳስ እመትስ።<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>ኑኒ አው ሀይቅዳ ናአ ግድዳ፤</para>
  <para style="q2" vid="LAM 5:3">ኑ አየትካ አምኦ ግድዶሶና።<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>ኑኒ ኡሻ ሃ ሻምድ ኤኮስ፤</para>
  <para style="q2" vid="LAM 5:4">ኤያ ምስ ጋተ ቃንፆስ።<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>ኑና የደይሳት ኑ ግንድያ ጋርሳና፤</para>
  <para style="q2" vid="LAM 5:5">ኑ ዳቡርዳ ሽን ሸምፓናዉ ዳንዳእቦኮ።<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>ኑኒ ካ ካላና ግድ፥</para>
  <para style="q2" vid="LAM 5:6">ግብፀታስነ አሶረታስ ኩሸ እምዳ።<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>ናጋራ ኦዳይ ኑ ማይዛታ፥</para>
  <para style="q2" vid="LAM 5:7">ሽን ኤንቲ ሀእ ዶኮና፤</para>
  <para style="q2" vid="LAM 5:7">ኤንቲ ኤካናዉ በሲያ ሴራ ኤክዳይ ኑና።<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>ኑና አይለት ሃሮሶና፤</para>
  <para style="q2" vid="LAM 5:8">ኤንታ ኩሸፐ ኑና አሽያ ኦንካ ባዋ።<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>ማሻን ዎይሳት ባዞን ደእያ ግሾ፥</para>
  <para style="q2" vid="LAM 5:9">ኑ ሸምፑዋ ባይዝድ ካ ደምዳ።<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>ኢታ ኮሻ ጋሶን፥</para>
  <para style="q2" vid="LAM 5:10">ኑ ጎጋይ ታማ ጮጨዳ ምቼስ።<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>ማጫሳታ ፅዮነን</para>
  <para style="q2" vid="LAM 5:11">ጌላኦታ ይሁዳ ካታማታን</para>
  <para style="q2" vid="LAM 5:11">ዎልቃን ኦይክድ ቱንስዶሶና።<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>ሀላቃታ ኤፍድ ካቅዶሶና፤</para>
  <para style="q2" vid="LAM 5:12">ጭማት ቦንቸትቦኮና።<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>ያላጋ አደት ዎፃን ጋጭዶሶና፤</para>
  <para style="q2" vid="LAM 5:13">አደ ናይት ዴፆ ም ቶክድ ጋንድጋርዶሶና።<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>ጭማት ካታማ ፐንገን ፕርዳናዉ ኡተይሳ አግዶሶና፤</para>
  <para style="q2" vid="LAM 5:14">ያላጋ አደት ናይት የ ዶግዶሶና።<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>ኑ ዎዛናፐ ኡፋይስ ክችስ፤</para>
  <para style="q2" vid="LAM 5:15">ኑ ዱርሳይ ዬሆን ላመትስ።<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>ኑ ሁጵያፐ ካላቻይ ኩንድስ፤</para>
  <para style="q2" vid="LAM 5:16">ኑ ናጋራ ኦዳ ግሾ ኑና አየ!<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>ሄሳ ግሾ፥ ኑ ዎዛናይ ዳቡርስ፤</para>
  <para style="q2" vid="LAM 5:17">ኑ አይፈይ ተልጁምስ።<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>ፅዮነ ደረይ ባይሳ ግድዳ ግሾ፥</para>
  <para style="q2" vid="LAM 5:18">ዎርካናት ያን ጉፖሶና።<verse eid="LAM 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>አቤት ጎዳዉ፥ ነ መርናዉ ሃራሳ፤</para>
  <para style="q2" vid="LAM 5:19">ነ አራታይ የለታፐ የለታ ጋካናሳ።<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>ኔኒ ኑና አይስ ኡባ ዎደ ዶጋይ?</para>
  <para style="q2" vid="LAM 5:20">ሀይሳ መላ አዱሳ ዎደ ኑና አይስ አጋይ?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>አቤት ጎዳዉ፥ ኑና ኔኮ ዛራ፤ ኑ ስማና፤</para>
  <para style="q2" vid="LAM 5:21">ኑ ዎድያ በንይሳ ዛራዳ ኦራ።<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>ኔኒ ኑና ፖሎ አጋድዬ?</para>
  <para style="q2" vid="LAM 5:22">ነ ሀንቁዋስ ዛው ባወዬ?<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
