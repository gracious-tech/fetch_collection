<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ናሆመ ማፃፋ</para>
  <para style="toc1">ናሆመ ማፃፋ</para>
  <para style="toc3">ናሆ</para>
  <para style="toc2">ናሆመ</para>
  <para style="mt">ናሆመ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ናበይ ዮናስ ናናወስ ትንብተ ኦድድ ስምን፥ ፄቱ ላይፈ ጉየ፥ ናሆመይ ዛሪድ ናናወ ቦላ ትንብተ ኦዳና መላ ፆሳይ እያ ፄግስ። ግዶሽን፥ ዮናሳ ዎደ አሳይ ባንታ ናጋራ ፓፅድ ስምዳይሳዳ ሀእ ስምቦኮና። ሀ ናምኡ ናበታፐ ግዶን፥ አሶረይ እስራኤለ ኦላዳ ይሳሱ።</para>
  <para style="ip">ማፃፋይ፥ አሶረ ዋና ካታማ ግድዳ ናናወባ ሄ ትንብተ ኦይክስ።</para>
  <para style="ipi">1. ሸምፖ 1፥ ናጋራንቾ ኡባ ቦላ ፆሳይ ባ ፕርዳ ኤሀናዉ ደኤይሳ፥ ኡባፈ አድ ናናወይ ፕርደቶና አቶናይሳ ኦዴስ።</para>
  <para style="ipi">2. ሸምፖ 2፥ ማታ ዎደን ናናወይ ፕርደታናይሳነ ሄ ፕርዳይ አይ ዳንያኮ ኦዴስ።</para>
  <para style="ipi">3. ሸምፖ 3፥ ናናወ ናጋራ ፓድድ በስዳፐ ጉየ፥ ፆሳይ ባ ፕርዳን ፅሎ ግደይሳ ኦዴስ።</para>
  <para style="ip">ናሆመ ማፃፋይ እስራኤለ ካጫማ ሞርከ ግድዳ ናናወ ዋና ካታማ ኩንደ ማላልስያ ግንፆን ቆንጭስስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ፆሳ ኦናተነ እያ ፕርዳ (<char style="ior"><ref loc="NAM 1:1-15">1:1-15</ref></char>)</para>
  <para style="io1">ናናወ ኩንደይ አተና (<char style="ior"><ref loc="NAM 2:1-13">2:1-13</ref></char>)</para>
  <para style="io1">ናናወ ኩንደስ ጋሶታ (<char style="ior"><ref loc="NAM 3:1-19">3:1-19</ref></char>)</para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="s1">ጎዳ ሀንቆይ ናናወ ቦላ</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>ኤልቆሻ ካታማን ደእያ ናሆም ናናወባ ኦድዳ ቃላይነ በእዳ ቆንጨይ ሀይሳ። <verse eid="NAM 1:1"/><verse number="2" style="v" sid="NAM 1:2"/>ጎዳይ ቃናተይሳነ ሀሎ ከይያ ፆሲ፤ ጎዳይ ሀሎ ከየይሳነ ሀንቆን ኩምዳይሳ። ጎዳይ ባራ ኤቀተይሳታ ሀሎ ከዬስ፤ ባ ሞርከታ ሴራናዉ ጊገት ኡትስ። <verse eid="NAM 1:2"/><verse number="3" style="v" sid="NAM 1:3"/>ጎዳይ ሀንቀታናዉ ኤለሰና፤ እያ ዎልቃይ ግታ፤ እ ቆህዳይሳ ሴሮና አገና።</para>
  <para style="p" vid="NAM 1:3">ጎዳስ ጎትያነ ሆቢያ ግዶራ ኦገይ ደኤስ፤ ሻራይ እያ ቶሆይ የን ደንድያ ባና። <verse eid="NAM 1:3"/><verse number="4" style="v" sid="NAM 1:4"/>እ አባነ ሻፋ ሀንቅድ መልሴስ፤ ባሳነነ ቃርመሎስ ሹሎሶና። ልባኖሰ ጪሻይ ቆቆፈቴስ። <verse eid="NAM 1:4"/><verse number="5" style="v" sid="NAM 1:5"/>እያ ስንን ደረት ቃፆሶና፤ ዙማት ትልኦሶና። እ ቆንጭያ ዎደ ቢት ቃፃና፤ ሳአን ደእያ ኡባይ ኮኮራና። <verse eid="NAM 1:5"/><verse number="6" style="v" sid="NAM 1:6"/>እያ ሀንቁዋ ስንን ኤቃናይ ኦኔ? እያ ሀንቁዋ ሱሏ ዳንዳአናይ ኦኔ? እያ ሀንቆይ ታማዳ ቡክያ ዎደ ዛላት ዛእድ ጳልቀቶሶና።<verse eid="NAM 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NAM 1:7"/>ጎዳይ ሎኦ፤ መቶ ጋላስ ቆሰትድ አትያ በሰ፤ እ ባናን አማነተይሳታ ኤሬስ። <verse eid="NAM 1:7"/><verse number="8" style="v" sid="NAM 1:8"/>ሽን እ ባ ሞርከታ ድኦን ሙክድ ይሳና፤ ባራ ኤቀተይሳታ ማን ገልሳና።<verse eid="NAM 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NAM 1:9"/>ህንተ ጎዳ ቦላ ማቀተይ አይብሴ? እ ህንተና ኩም ይሳና፤ መቶይ ዛር ደንደና። <verse eid="NAM 1:9"/><verse number="10" style="v" sid="NAM 1:10"/>ህንተ ማትድ ጋንድጋረይሳት፥ ዎልራ ኦይከትዳ አጉንነ ቡረይ ታማን ፁገትያ መላ ህንተ ታማን ፁገትድ ያና። <verse eid="NAM 1:10"/><verse number="11" style="v" sid="NAM 1:11"/>ናናወ፥ ጎዳ ቦላ ኢታባ ማቀተይነ ኢታ ዞረ ዞረይ ነ ግዶፈ ከይስ።<verse eid="NAM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12"/>ጎዳይ፥ “ናናወት ምኖነ ዳሮ ግድኮካ፥ ሾደትድ ያና። ታኒ ካሰ ይሁዳ አሳ ኡንኤስ፥ ሽን ህዛፐ ጉየ ኡንኤከ። <verse eid="NAM 1:12"/><verse number="13" style="v" sid="NAM 1:13"/>ታኒ ሀእ አሶረታ ቃምባራ ህንተ ጋናፈ መንና፤ ህንተ ቃሸትዳ ሳንላታ ዱሰረና” ያጌስ።<verse eid="NAM 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NAM 1:14"/>ናናወ፥ ጎዳይ ነ ቦላ ፕርድዳ ፕርዳይ ሀይሳ: “ህዛፐ ጉየ ነ ሱን ፄግስያ ኮቸ ነዉ ዴና። ነ ፆሳታ ኬን ደእያ ምስለታነ ኤቃታ ታኒ ይሳና። ኔኒ ፓናባ ግድያ ግሾ፥ ታኒ ነ ዱፉዋ ቦካና” ያጌስ።<verse eid="NAM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NAM 1:15"/>ሄኮ፥ ሎኦ ዎረ ኦድሸነ ሳሮተ አዋጅሸ ኪተትድ የይሳ ቶሆይ ደርያ ቦላራ ጋክስ። ይሁዳ አሳዉ፥ ህንተ ሞርከት ኩም ይዶሶና፤ ኤንቲ ዛሪድ ህንተ ቢታ ኦልድ ኦይኮኮና። ሄሳ ግሾ፥ ህንተ ባለታ ቦንችተ፤ ህንተ ቃንገ ጋተ።<verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">ናናወ ኩንደ</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 2:1"/>ነኖ፥ ናናወ፥ መንረይስ ከይስ! ሄሳ ግሾ፥ ነ ሚፃ ናጋ፤ ነ ኦግያ ዎቻ፤ ነ ዳንጩዋ ምን፤ ነና ጊግሳ።<verse eid="NAM 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NAM 2:2"/>ቦንቀይሳት ቦንቅድ፥ ኤንታ ዎይንያ ይስኮካ፥ ጎዳይ እስራኤለ ቦንቹዋ ዛርዳይሳዳ ያይቆባ ቦንቹዋ ዛራና።<verse eid="NAM 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NAM 2:3"/>ኦላንቾት ዞኦ ጎንዳለ ኦይክዶሶና፤ ዞኦ ማኦ ማእዶሶና። ኤንቲ ኦላስ ጊግያ ዎደ ፓራ ጋረት ቅንኣሮሶና፤ ኤንቲ ባንታ ቶራ ሉፆሶና። <verse eid="NAM 2:3"/><verse number="4" style="v" sid="NAM 2:4"/>ፓራ ጋረት ኦግያን አዳርሶሶና፤ ኤንቲ ያነ ሃነ ሄመትሸ ካታማ ኦግያን ዩዮሶና። ቃስ ኤንቲ ላጮይ ሎጩ ግያ ፆምፐ ዳኖሶና፤ ዎልአንዳ ኤለሶሶና። <verse eid="NAM 2:4"/><verse number="5" style="v" sid="NAM 2:5"/>ናናወይ ባ ሀላቃታ ፄግድ ሺሻና፥ ሽን ኤንቲ ይሸ ኦገ ቦላ በታና። ኤንቲ ካታማ ግምበ ድርሳኮ ኤለሳና፥ ሞርከታ ቆሁዋፐ ኤንታ ናግያ ጎንዳለይ ጊግስ። <verse eid="NAM 2:5"/><verse number="6" style="v" sid="NAM 2:6"/>ሻፋ ባጋራ ደእያ ካታማ ድርሳ ፐንገት ዶየትዶሶና፤ ካዎ ጋይ ዳጋምስ። <verse eid="NAM 2:6"/><verse number="7" style="v" sid="NAM 2:7"/>ካውያ ድኤታዳ ባሱ፤ እ ማጫ አይለት አዛንድ ሆለዳ ጉጉማና፤ ባንታ ትራ ባቅሸ ዬካና። <verse eid="NAM 2:7"/><verse number="8" style="v" sid="NAM 2:8"/>ተቀትዳ ሃ ዶይ በስን ጎገይሳዳ ናናወ አሳይ ካታማፐ ባቃታና። አስ ኤንታ ባ ቃላ ቁ ኦድ፥ “ኤቅተ! ኤቅተ!” ያግድ ፄጋና፥ ሽን ኦንካ ጉየ ፄለና። <verse eid="NAM 2:8"/><verse number="9" style="v" sid="NAM 2:9"/>ሄ ካታማ ሻሉዋስነ፥ እያን ምንጀትዳ ቦንቾ ሚሽያስ ታይቦይ ባዋ። ሄሳ ግሾ፥ ሄ ብራነ ዎርቃ ቦንቅተ!<verse eid="NAM 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NAM 2:10"/>ናናወይ ባይሳ ግድስ፤ ካይሳትድ፥ ባዞ ግድስ! አሳ ዎዛናይ ያሻን ትልእስ፤ ጋደይ ኮኮርስ፤ ፄሳይ ፃፀትስ፤ ሶምኦይ ቡላትስ! <verse eid="NAM 2:10"/><verse number="11" style="v" sid="NAM 2:11"/>ጋሞት አቅያ በሳይ፥ ዎዳላ ጋሞት ደእያ በሳይ፥ አደይነ ማጫ ጋሞት ባንታ ማራታራ ያሽ ባይና ጉፕያ በሲ ዳንያ ናናወ ካታማይ ሀእ አዉን ደኢ? <verse eid="NAM 2:11"/><verse number="12" style="v" sid="NAM 2:12"/>ጋሞይ ባ ማራታስ ግድያባ ኦይክስ፤ ባራ ደእያ ማጫ ጋመስ መንረድ እሚስ። ባ ጎንጎሉዋ ዎን፥ ባ ኦላ አሾን ኩንስ።<verse eid="NAM 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NAM 2:13"/>ኡባፈ ዎልቃማ ጎዳይ፥ “ሄኮ፥ ታኒ ነ ቦላ ደንዳስ! ታኒ ነ ፓራ ጋረታ ታማን ፁጋና፤ ነ ዎዳላ ጋሞታ ማሽ ማና። ኔኒ ሀራታፐ ኤክዳባ ታኒ ኔፐ ዎስሳና፤ ነ ኪታንቾታ ቃላይ ህዛፐ ስኤተና” ያጌስ።<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s1">ናናወ አየ!</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 3:1"/>ዳሮ አሳ ሱ ጉስዳ ናናወ ካታማ አየ! ዎርዶይ ኩምስ፤ ቦንቅ ኤክዳ ሻሉዋስ ታይቦይ ባዋ። <verse eid="NAM 3:1"/><verse number="2" style="v" sid="NAM 3:2"/>ናናወ ካታመን ልሶ ግርሳይ፥ ገርቶ ጎንዶርሳይ፥ ፓራታ አዳርሶይነ ፓራ ጋረታ ጉፋይ ስኤቴስ። <verse eid="NAM 3:2"/><verse number="3" style="v" sid="NAM 3:3"/>ፓራ አሳት ፒርፆሶና፤ ማሻይ ሎጬስ፤ ቶራይ ጶሌስ። ዳሮ አስ ሀይቅስ! አህ አሀ ቦላ ዶረትስ፤ ሀይቅዳባስ ታይቦይ ባዋ! ያራ ካንድ ብያ አስ አሀን በቴስ። <verse eid="NAM 3:3"/><verse number="4" style="v" sid="NAM 3:4"/>ሄስ ኡባይ ሀንዳይ ማር ባይና ናናወ ላይማተ ጋሱዋና። እ ዳሮ ሙሩኖ ኦሱ፤ ካዎተታ ባ ላይማተን፥ አሳ ባ ሙሩኑዋን አይለያሱ።<verse eid="NAM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NAM 3:5"/>ኡባፈ ዎልቃማ ጎዳይ፥ “ሄኮ፥ ታኒ ነ ቦላ ደንዳስ! ታኒ ነ ማኡዋ ኔፐ ቃራና፤ ነ ካሉዋ አሳ፥ ነ ፖኩዋ ካዎተታ በሳና። <verse eid="NAM 3:5"/><verse number="6" style="v" sid="NAM 3:6"/>ታኒ ነና ፕቶ የግያ በሲ ከሳና፤ ነና ካና፤ አስ ኡባይ ነና ሚጫናዳ ኦና። <verse eid="NAM 3:6"/><verse number="7" style="v" sid="NAM 3:7"/>ነና በእያ ኡባይ ኔፐ ሃክድ፥ ‘ሄኮ፥ ናናወ ካታማይ ባይሳትስ፤ እያዉ አዛናናይ ኦኔ? እያ ምንያ አስ አዉፐ በንታንደሻ?’ ያጋና” ያጌስ።<verse eid="NAM 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NAM 3:8"/>ነኖ፥ ናናወ፥ ኔኒ ግብፀን ደእያ ተብሶ ካታማፐ አይ? እያ ናይለ ሻፋ ማታን ደአዉሱ፤ ሃ እ ዩሹዋ ተቅስ፤ ሻፋይ እዉ ሚፃ ግድስ፤ ቃስ ሃይካ እዉ ድርስ። <verse eid="NAM 3:8"/><verse number="9" style="v" sid="NAM 3:9"/>ቶጰይነ ግብፀይ እዉ ዛው ባይና ዎልቃ፤ ፑፅነ ሊበይ እዮ ማደይሳታ። <verse eid="NAM 3:9"/><verse number="10" style="v" sid="NAM 3:10"/>ግዶሽን፥ እያ ድኤታሱ፤ እ ጉ ናይት ደሸትድ፥ ኦገ ጋፃ ኡባን ኩንድዶሶና። እ ቦንቸትዳ አሳታ ቦላ ሳም የገትስ፤ እ ግታ አሳት ኡባይ ሳንላታን ቃሸትዶሶና።<verse eid="NAM 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NAM 3:11"/>ነኖ፥ ናናወ፥ ኔኒ ማትድ ጋንድጋርያ አሳዳ ሀናና። ነ ሞርከታ ስንፈ ባቃታዳ አትያ በሲ ኮያና። <verse eid="NAM 3:11"/><verse number="12" style="v" sid="NAM 3:12"/>ነ ሚፃት ኡባይ ኮይሮ ቴርዳ አይፈይ ደእያ ባላሰ ም መላ። ባላሰ ም ቃያ ዎደ ቴራይ መይሳ ዶናን ዎስ። <verse eid="NAM 3:12"/><verse number="13" style="v" sid="NAM 3:13"/>ሄኮ፥ ነ ኦላንቾት ኡባይ ማጫሳ መላ። ነ ዛዋ ፐንገት ነ ሞርከታስ ዳልግድ ዶየትዶሶና፤ ኮበ ም ታም ምስ። <verse eid="NAM 3:13"/><verse number="14" style="v" sid="NAM 3:14"/>ነ ሞርከት ነ ዩሹዋ ኡንኤያ ዎደ ኡያና ሃ ሀእ ትካ። ነ ሚፃ ምን፤ ኡርቃ የዳ ፁበ መ፤ ኦቶ ጊግሳ። <verse eid="NAM 3:14"/><verse number="15" style="v" sid="NAM 3:15"/>ነና ያን ታም ማና፤ ቦለይ ካ መይሳዳ ነና ማሽ ማና። ኔኒ ቦለዳ ዳራ ጎንዶዳ የለታ። <verse eid="NAM 3:15"/><verse number="16" style="v" sid="NAM 3:16"/>ኔኒ ነ ዛልአንቾታ ሳሎ ፆልንቶታፐ አዳ ዳርሳዳሳ። ሽን ኤንቲ ቦለዳ ኡባ ም ድግድ ፓልድ ያና። <verse eid="NAM 3:16"/><verse number="17" style="v" sid="NAM 3:17"/>ነ ቶራ ሞጮናትነ ነ ሞርናት ሜጎ ዎደ ድርሳ ቦላ ኡትዳ ቦለ መላ። ኤንቲ አው ከይያ ዎደ ፓልድ ዮሶና፤ ኤንቲ ደእያ በሳ ኤረይ ባዋ።<verse eid="NAM 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NAM 3:18"/>ነኖ አሶረ ካዋዉ፥ ነ ሀላቃት ስክዶሶና፤ ነ ቦንቸትዳ አሳት ኩንድዶሶና። ነ አሳይ ደረታ ቦላ ላለትስ፤ ኤንታ ሺሽያ አስካ ባዋ። <verse eid="NAM 3:18"/><verse number="19" style="v" sid="NAM 3:19"/>ኔኒ ዛው ባይና ኢታተፈ ከስ ኤክዳ አስ ባይና ግሾ፥ ነ መኦይ ኮለተና፤ ነ ማዱንይ ፓፀና። ነባ ስእዳ ኡባይ ነ ቦላ ኩሸ ባቃና።<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
