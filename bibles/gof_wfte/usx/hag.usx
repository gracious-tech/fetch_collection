<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAG" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ሀገ ማፃፋ</para>
  <para style="toc1">ሀገ ማፃፋ</para>
  <para style="toc3">ሀገ</para>
  <para style="toc2">ሀገ</para>
  <para style="mt">ሀገ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሀገ ማፃፋይ ፃፈትዳይ ክ.የ.ስ. 520 ላይ ሄራና። ይሁዳ አሳይ ድኦፐ ስሚድ የሩሳላመን ዱሱ ዶምን፥ ጉ ላይ አዳባ ግድኮካ፥ ቡሮ ፆሳ ኬይ ላለትዳ መላ ደእሽና። ሄሳ ግሾ፥ ሀ ማፃፋ ኪታይ አሳ ካለይሳት፥ ፆሳ ኬ ኬፃና መላ ኤንታ ደንናሳ።</para>
  <para style="ip">ሀገ ማፃፋይ ኦይዱ ኪታታ ኦይክስ። እስ ኪታይ “ጎዳ ቃላይ” ሀገ ባጋራ ያግድ ቆንጭስ ግድ ኦዴስ (<char style="xt"><ref loc="HAG 1:1">1:1</ref>፤ <ref loc="HAG 2:1">2:1</ref>፤ <ref loc="HAG 2:10">2:10</ref>፤ <ref loc="HAG 2:20">2:20</ref></char>)።</para>
  <para style="ipi">1. ድኦፐ ስምዳ ኮይሮ አሳይ ፆሳ ኬይ ላለትድ ደእሽን፥ ኤንቲ ሎኦ ኬን ደኤይሳ ቦርስ (<char style="xt"><ref loc="HAG 1:4">1:4</ref></char>)። ኤንታ ሀኖታፐ ደንዶይሳን ፆሳይ ኤንታ አንጁዋ ተቅዳይሳነ (<char style="xt"><ref loc="HAG 1:9-11">1:9-11</ref></char>)፤ አሳይ ባንታ ሀኖታ ጉየ ስሚድ ፄላና መላ ኤንታ ዞርስ (<char style="xt"><ref loc="HAG 1:5">1:5</ref>፥ <ref loc="HAG 1:7">7</ref></char>)።</para>
  <para style="ipi">2. ኮይሮ ፆሳ ኬ ቦንቹዋ በእዳ አሳይ ሀንያባ በእድ ኡፋይስ ቃንፅዶሶና (<char style="xt"><ref loc="HAG 2:3">2:3</ref></char>)።</para>
  <para style="ipi">3. አሳይ ጌሻተን ፆሳስ ኪተታና መላ ዞሬስ (<char style="xt"><ref loc="HAG 2:10-19">2:10-19</ref></char>)።</para>
  <para style="ipi">4. ዛሩባበላስ እመትዳ ኡፋይሳ ቃላ ኦዴስ (<char style="xt"><ref loc="HAG 2:20-23">2:20-23</ref></char>)።</para>
  <para style="ip">ዉርሰን፥ አሳይ ኦራፅኮነ ጌሻተን ደእኮ፥ ፆሳይ ኤንታዉ ሳሮነ ዱረተ እማናዉ ደኤይሳ ኦድድ ኩዬስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ፆሳ ኬይ ኬፀቶ (<char style="ior"><ref loc="HAG 1:1-15">1:1-15</ref></char>)</para>
  <para style="io1">ግታ ቦንቾ ኡፋይሳ ቃላ (<char style="ior"><ref loc="HAG 2:1-9">2:1-9</ref></char>)</para>
  <para style="io1">አንጆስነ ጌሻተስ ፄገተ (<char style="ior"><ref loc="HAG 2:10-19">2:10-19</ref></char>)</para>
  <para style="io1">ዛሩባበላስ እመትዳ ኡፋይሳ ቃላ (<char style="ior"><ref loc="HAG 2:20-23">2:20-23</ref></char>)</para>
  <chapter number="1" style="c" sid="HAG 1"/>
  <para style="s1">ፆሳ ኬይ ኬፀታና መላ እመትዳ ኪታ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 1:1"/>ካዎይ ዳርዮስ ካዎትዳ ናምአን ላይን፥ ኡሱፑን አጌናን ኮይሮ ጋላሳን፥ ጎዳ ቃላይ ናብያ ሀገ ባጋራ ይሁዳ ቢታ ሃርያ ሳላትያላ ናኣ፥ ዛሩባበላኮነ ካህነ ሀላቃ ግድዳ እዮሳደቃ ናኣ፥ እያሱኮ ሀይሳዳ ያግድ ይስ። <verse eid="HAG 1:1"/><verse number="2" style="v" sid="HAG 1:2"/>ኡባፈ ዎልቃማ ጎዳይ፥ “ሀ አሳይ ጎዳ ኬ ዛሪድ ኬፅያ ዎደይ ቡሮ ጋክቤና” ያጌስ።<verse eid="HAG 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HAG 1:3"/>ያትን፥ ጎዳ ቃላይ ናብያ ሀገ ባጋራ ሀይሳዳ ያግስ: <verse eid="HAG 1:3"/><verse number="4" style="v" sid="HAG 1:4"/>“ታ አሳዉ፥ ታ ኬይ ላለትድ ኡትን፥ ህንተ፥ ህንተ አሌቀትዳ ኬታን ዳናዉ ሀይስ ህንተዉ ዎዴ?” ያግስ።<verse eid="HAG 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HAG 1:5"/>ሄሳ ግሾ፥ ኡባፈ ዎልቃማ ጎዳይ፥ “አነ ህንተ ህንተና ጋክሸ ደእያባ ቆፕተ። <verse eid="HAG 1:5"/><verse number="6" style="v" sid="HAG 1:6"/>ህንተ ዳሮ ዘርደታ፥ ሽን ጉ ሺሽደታ። ሜታ፥ ሽን ካለከታ፤ ኡዬታ፥ ሽን አለከታ። ማኤታ፥ ሽን ህንተና ሆኤና። ዳሞዘ ኤኬታ፥ ሽን ፔ ኪሰን የግያዳ ጮ ዬስ” ያጌስ።<verse eid="HAG 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HAG 1:7"/>ኡባፈ ዎልቃማ ጎዳይ፥ “አነ ህንተ ህንተና ጋክሸ ደእያባ ቆፕተ። <verse eid="HAG 1:7"/><verse number="8" style="v" sid="HAG 1:8"/>ህዛ ደርያ ቦላ ከይድ፥ ም ቃንፅድ ኤህተ፤ ታኒ እያን ኡፋይታና መላነ ቦንቸታና መላ ፆሳ ኬ ዛሪድ ኬፅተ። <verse eid="HAG 1:8"/><verse number="9" style="v" sid="HAG 1:9"/>ህንተ ዳሮ ካ ሺሻናዉ ቆፕደታ፥ ሽን ጉ ግድስ። እያ ህንተ ሶ ገልስያ ዎደ ታ ፑንን ይ አግስ። ሀይስ አይብስ ሀንዴ? ታኒ ሀይሳ ኦዳይ ህንተ ኡባይ ህንተ ኬ ኬ ኬፅሽን፥ ታ ኬይ ላለትድ አትዳ ግሾሳ። <verse eid="HAG 1:9"/><verse number="10" style="v" sid="HAG 1:10"/>ሄሳ ግሾ፥ ሳሎይ እራ ድግስ፥ ሳእ ካ እሞና እፅስ። <verse eid="HAG 1:10"/><verse number="11" style="v" sid="HAG 1:11"/>ታኒ ቢታነ ዙማ ቦላ፥ ካ ቦላ፥ ዎይንያነ ዛይትያ ቦላ፥ ቢት ዶልስያባ ኡባ ቦላ፥ አሳነ መህያ ቦላነ ህንተ ዳቡራ ኡባ ቦላ ኮሻ ፄጋስ” ያጌስ። <verse eid="HAG 1:11"/><verse number="12" style="v" sid="HAG 1:12"/>ሀይሳፈ ጉየ፥ ሳላትያላ ናአይ ዛሩባበል፥ ካህነ ሀላቃ ግድዳ እዮሳደቃ ናአይ፥ እያሱይነ ድኤተፈ ስምዳ አሳ ኡባይ፥ ጎዳ ባንታ ፆሳ ቃላስነ ጎዳይ ኤንታ ፆሳይ ኪትዳ ናብያ ሀገ ቃላስ፥ ኪተትዶሶና፤ አሳይ ጎዳ ያይዶሶና። <verse eid="HAG 1:12"/><verse number="13" style="v" sid="HAG 1:13"/>ያትን፥ ጎዳይ ኪትዳ ሀገይ አሳኮ፥ “ ‘ታኒ ህንተራ ደአይስ’ ያጌስ” ያግድ ጎዳ ኪታ አሳስ ኦድስ። <verse eid="HAG 1:13"/><verse number="14" style="v" sid="HAG 1:14"/>ያትን፥ ጎዳይ፥ ይሁዳ ቢታ ሃርያ ሳላትያላ ናኣ፥ ዛሩባበላ፥ ካህነ ሀላቃ ግድዳ እዮሳደቃ ናኣ፥ እያሱነ ድኤተፈ ስምዳ አሳ ኡባ ደንስ። ኤንቲ ኡባፈ ዎልቃማ ጎዳ፥ ባንታ ፆሳ ኬ ኬፆ ዶምዶሶና። <verse eid="HAG 1:14"/><verse number="15" style="v" sid="HAG 1:15"/>ሀይስ ሀንዳይ ካዎይ ዳርዮስ ካዎትዳ ናምአን ላይን፥ ኡሱፑን አጌናን ላታማነ ኦይዳን ጋላሳና።<verse eid="HAG 1:15"/></para>
  <chapter eid="HAG 1"/>
  <chapter number="2" style="c" sid="HAG 2"/>
  <para style="s1">ኦራ ኬ ቦንቹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 2:1"/>ዳርዮስ ካዎትዳ ናምአን ላይን፥ ላፑን አጌናን ላታማነ እስን ጋላሳን፥ ጎዳ ቃላይ ናብያ ሀገ ባጋራ ሀይሳዳ ያግስ። <verse eid="HAG 2:1"/><verse number="2" style="v" sid="HAG 2:2"/>“ይሁዳ ሃርያ፥ ሳላትያላ ናኣ፥ ዛሩባበላስ፥ ካህነ ሀላቃ ግድዳ እዮሳደቃ ናኣ፥ እያሱስነ ድኤተፈ ስምዳ አሳስ ሀይሳዳ ያጋዳ ኦዳ: <verse eid="HAG 2:2"/><verse number="3" style="v" sid="HAG 2:3"/>ሀ ፆሳ ኬ ካሰ ቦንቾይ አይ መለኮ በእዳ አሳፐ ህንተ ግዶን አትዳ አስ ደኢ? ሀች ህንተ በእያ ዎደ አይ ዳኒ? ህንተ አይፍያ ስንን ባይናባ ዳነኔ? <verse eid="HAG 2:3"/><verse number="4" style="v" sid="HAG 2:4"/>ግዶሽን፥ ዛሩባበላ፥ ሀእ ምና! ካህነ ሀላቃ ግድዳ እዮሳደቃ ናአዉ፥ እያሱ ምና! ቢታን ደእያ አሳዉ ህንተ ምንድ ኦተ! ታኒ ህንተራ ደአይስ። ታኒ ኡባፈ ዎልቃማ ጎዳይ ሀይሳ ኦዳይስ። <verse eid="HAG 2:4"/><verse number="5" style="v" sid="HAG 2:5"/>ህንተ ግብፀፈ ከይያ ዎደ ታኒ ህንተራ ግዳና ጋዳ ጫቅዳይሳዳ ታ አያናይ ህንተራ ደእያ ግሾ ያዮፍተ!” ያግስ።<verse eid="HAG 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HAG 2:6"/>ኡባፈ ዎልቃማ ጎዳይ፥ “ታኒ ቃን ዎደን እስ ቶሆ ጉጃዳ ሳሎታነ ሳኣ፥ አባነ ቢታ ቃና። <verse eid="HAG 2:6"/><verse number="7" style="v" sid="HAG 2:7"/>ካዎተታ ኡባ ቃዳ ካዎተታ ኡባን ደእያ ሻሎይ ሃ ያና መላ ኦና። ሀ ፆሳ ኬ ቦንቾን ኩንና። <verse eid="HAG 2:7"/><verse number="8" style="v" sid="HAG 2:8"/>ብራይ ታባ፤ ዎርቃይ ታባ። <verse eid="HAG 2:8"/><verse number="9" style="v" sid="HAG 2:9"/>ኮይሮ ቦንቹዋፈ ሀ ናምአን ፆሳ ኬ ቦንቾይ አና። ታኒ ኡባፈ ዎልቃማ ጎዳይ ሀ በሳን ሳሮተ እማና ያጋዳ ኦዳ” ያግስ።<verse eid="HAG 2:9"/></para>
  <para style="s1">ሀንቆነ አንጆ</para>
  <para style="p">
    <verse number="10" style="v" sid="HAG 2:10"/>ዳርዮስ ካዎትዳ ናምአን ላይን፥ ኡዱፉን አጌናን ላታማነ ኦይዳን ጋላሳን፥ ጎዳ ቃላይ ናብያ ሀገ ባጋራ ሀይሳዳ ያግድ ይስ። <verse eid="HAG 2:10"/><verse number="11" style="v" sid="HAG 2:11"/>ኡባፈ ዎልቃማ ጎዳይ፥ “ህገይ ዎይግያኮ ኤራናዉ ካህነታ ኦይቻ። <verse eid="HAG 2:11"/><verse number="12" style="v" sid="HAG 2:12"/>‘እስ አስ ጌሻ አሹዋ ባ አፍላ ማጫራን ቃችድ ኤክ ብሽን፥ ሄ አፍላ ማጫራይ፥ ኡይ ዎይኮ ዎፅያ ዎይኮ ዎይንያነ ዛይትያ ዎይኮ ሀራ አይ ቆሞ ካ ቦችኮ፥ ሄ ቦሸትዳ ካይ ጌሽ ግዳናዉ ዳንዳኢ?’ ያጋዳ ኦይቻ” ያግስ።</para>
  <para style="p" vid="HAG 2:12">ካህነይ ዛሪድ፥ “ጌሽ ግዳናዉ ዳንዳኤና” ያግስ።<verse eid="HAG 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 2:13"/>ሀገይ ዛሪድ፥ “አሀ ቦችድ ቱንዳ እስ አስ ሀይሳታፐ እስ ቆሞ ካ ቦችኮ ሄ ካይ ቱና ግዳኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="HAG 2:13">ካህነይ፥ “ኤ ቱናና” ያግድ ዛርስ።<verse eid="HAG 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HAG 2:14"/>ሀገይ ዛሪድ፥ “ሀ አሳይነ ሀ ካዎተይ ታ ስንን ሄሳ መላ። ኤንቲ ኦያ ኦሶይነ ኤንቲ እምያ እሞታይ ኡባይ ሄሳ መላ ቱና” ያጌስ ጎዳይ። <verse eid="HAG 2:14"/><verse number="15" style="v" sid="HAG 2:15"/>“ሀችፈ ዶምድ፥ ህንተ ቦላ ጋክዳባ አኬክተ! ጎዳ ኬ ኬፆ ዶማናፐ ካሰ፥ <verse eid="HAG 2:15"/><verse number="16" style="v" sid="HAG 2:16"/>ህንተ ናምኡ ኩንታለ ካ ኤካና ግድ፥ ካ ዎዳ በሳ ብደታ፥ ሽን እስ ኩንታለ ፃላላ ደምደታ። እስ ፄቱ ልትሮ ዎይነ ኤካናዉ ዎይነ ጉምእያ ኦላ ብደታ፥ ሽን ህንተ ኦይታሙ ልትሮ ፃላላ ዎይነ ደምደታ። <verse eid="HAG 2:16"/><verse number="17" style="v" sid="HAG 2:17"/>ታኒ ህንተ ኩሸ ኦሶ ኡባ ቦላ መልስያ ጫርኮ፥ ካ ሀርገነ ሻች የዳዳ ይሳስ። ሽን ህንተ ሀ ኡባን ታኮ ስምበከታ” ያጌስ ጎዳይ።<verse eid="HAG 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HAG 2:18"/>“ሀች ጋላሳፐ፥ ሀ ኡዱፉን አጌናን ላታማነ ኦይዳን ጋላሳፐ ዶምድ አነ አኬክተ። ጎዳ ኬ ባሶይ ባሰትዳ ጋላሳፐ ዶምድ ቆፕተ። <verse eid="HAG 2:18"/><verse number="19" style="v" sid="HAG 2:19"/>ሀእ ዘረስ ሀንያ ካ ህንተ ሻለን ይኮ፥ ዎይነይ፥ ባላሰይ፥ ኦሮማነይነ ሻማሆይ ሀች ጋካናዉ አይፎና እፅኮካ፥ ሀችፈ ዶማዳ ታኒ ህንተና አንጃና” ያጌስ ጎዳይ።<verse eid="HAG 2:19"/></para>
  <para style="s1">ዛሩባበላስ እመትዳ ኡፋይሳ ቃላ</para>
  <para style="p">
    <verse number="20" style="v" sid="HAG 2:20"/>ሄ አጌናን ላታማነ ኦይዳን ጋላሳን ጎዳ ቃላይ ናምአን ሀገኮ ሀይሳዳ ያግስ። <verse eid="HAG 2:20"/><verse number="21" style="v" sid="HAG 2:21"/>ይሁዳ ሃርያ ዛሩባበላስ ሀይሳዳ ያጋዳ ኦዳ: “ታኒ ሳሎታነ ሳኣ ቃና። <verse eid="HAG 2:21"/><verse number="22" style="v" sid="HAG 2:22"/>ካዎተታ አራታ ሽራ የጋና፤ ኤንታ ዎልቃ ይሳና። ፓራ ጋረታ ኤንታ ላገይሳታራ ሽራ የጋና፤ ኤንታ ፓራት ዉራና፤ ፓራ አሳት ዎሉ ዎና። <verse eid="HAG 2:22"/><verse number="23" style="v" sid="HAG 2:23"/>‘ታ አይልያዉ፥ ሳላትያላ ናአ ዛሩባበላ፥ ታኒ ኡባፈ ዎልቃማ ጎዳይ ነና ሄ ጋላስ ኤካና። ታኒ ነና ታ ምግዶ ማታመ መላ ኦና። ታኒ ነና ዶራስ’ ያጌስ” ያጋዳ ኦዳ።<verse eid="HAG 2:23"/></para>
  <chapter eid="HAG 2"/>
</usx>
