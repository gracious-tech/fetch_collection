<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">3 ዮሃንሳ ኪታ</para>
  <para style="toc1">3 ዮሃንሳ ኪታ</para>
  <para style="toc3">3 ዮሀ</para>
  <para style="toc2">3 ዮሃንሳ</para>
  <para style="mt1">ዮሃንስ ፃፍዳ</para>
  <para style="mt2">ሄን ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ዮሃንስ ፃፍዳ ሄን ኪታ፥ የሱሳ ሀዋረ ግድዳ ጭማይ፥ ዮሃንስ ፃፍስ። እ ሀ ኪታ ፃፍዳይ፥ ጋዮሳ ጌተትያ እስ ዎሳ ኬ አድያሳ። ፃፈይ እስ ባጋራ፥ ጋዮስ ሀራ አማንያ አሳ ማድዳ ግሾ እያ ጋላቴስ፤ ሀራ ባጋራ ቃስ፥ ድዮትራፍሳ ጌተትያ ዎሳ ኬ ሀላቃ ግዳናዉ ኮያ ጌላ ኡራፐ ናገታና መላ አኬክሴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሳሮነ ዎሳ (1-4)</para>
  <para style="io1">ጋዮስ ሳበትስ (5-8)</para>
  <para style="io1">ድዮትራፍስ ቦረትስ (9-10)</para>
  <para style="io1">ድመፅሮስ ናሸትስ (11-12)</para>
  <para style="io1">ሳሮ (13-15)</para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="s1">ሳሮነ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>ታኒ ጭማይ፥ ቱማ ዶስያ ጋዮሳስ ኪትዳ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">1 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ሀዋ 19:29</ref>፤ <ref loc="ROM 16:23">ሮመ 16:23</ref>፤ <ref loc="2CO 1:14">2 ቆሮ 1:14</ref>.</char></note> <verse eid="3JN 1:1"/><verse number="2" style="v" sid="3JN 1:2"/>ታ ሲቁዋዉ፥ ኔኒ ነ ሸምፑዋን ሎኦ ደኤይሳ ታ ኤረይሳዳ ነዉ ፓያተ ዳና መላነ ነ ኦያባይ ሱራና መላ ነዉ ፆሳ ዎሳይስ። <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>ጉ አማንያ አሳት ይድ፥ ኡባ ዎደ ኔኒ ቱማን ደኤይሳነ ነ ቱማተባ ማርካትዳ ዎደ ታኒ ዳሮ ኡፋይታስ። <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>ታ ናይት ቱማተን ደኤይሳ ስኤይሳፈ አድ፥ ታና ኡፋይስያባይ ባዋ።<verse eid="3JN 1:4"/></para>
  <para style="s1">ጋዮስ ሳበትስ</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>ታ ሲቁዋዉ፥ ኤንቲ ነዉ እማ ግድኮካ፥ ኔኒ አማንያ አሳታስ አማንያ ኦሶ ኦሳ። <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>ኤንቲ ነ ሲቁዋባ ዎሳ ኬን ማርካቶሶና። ሀእካ ኤንቲ ብያ ኦግያን ፆሳይ ዶሰይሳዳ ኦዳ ኤንታ ማድኮ ሎኦ ኦሳ። <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>ኤንቲ ክርስቶሳ ሱን ግሾ ከይሸ፥ አማኖና አሳታፐ አይኮካ ኤክቦኮና። <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ኑኒ ቱማ ኦሱዋ ኤንታራ እስፈ ኦናዉ ሀይሳ መላ አሳታ ማዳናዉ በሴስ።<verse eid="3JN 1:8"/></para>
  <para style="s1">ድዮትራፍስ ቦረትስ</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ታኒ ዎሳ ኬታስ ዳብዳበ ፃፋስ፥ ሽን ኤንታ ሀላቃ ግዳናዉ ኮይያ ድዮትራፍስ ኑኒ ገይሳ ኤከና። <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>ሄሳ ግሾ፥ ታኒ ያ ብያ ዎደ እ ኑ ቦላ ኦደትያ ኢታ ኦዳነ እ ኦዳ ኦሱዋ ኦዳና። እ ሄስ ጉፅስ ግድ፥ ኑ እሻት ያ ዎደ ሞከና። ሀር አቶሽን፥ ኤንታ ሞካናዉ ኮየይሳታካ ድግድ ዎሳ ኬፈ ከሴስ።<verse eid="3JN 1:10"/></para>
  <para style="s1">ድመፅሮስ ናሸትስ</para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>ታ ሲቁዋዉ፥ ሎኦባ ዳናፐ አትሽን፥ ኢታባ ዳኖፓ። ሎኦባ ኦያ ኦንካ ፆሳ አስ፥ ሽን ኢታባ ኦያ ኦንካ ፆሳ በእቤና።<verse eid="3JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12"/>ድመፅሮስ ሎኦ አስ ግደይሳ አሳ ኡባይ ማርካቴስ። ቱማይ ባ ሁጰን እያባ ማርካቴስ፤ ኑካ እያባ ማርካቶስ፤ ኑ ማርካተይ ቱማ ግደይሳ ህንተ ኤሬታ።<verse eid="3JN 1:12"/></para>
  <para style="s1">ሳሮ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>ታኒ ነዉ ፃፋናዉ ኮይዳ ዳሮባይ ደኤስ፥ ሽን ቃላመንነ ዎርቃተን ፃፋናዉ ኮይከ። <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>ሽን ታኒ ማታራ ኔራ ጋሄታናዉ ቆፓይስ፤ ሄ ዎደ ኑኒ ኦደታና።<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>ሳሮይ ነዉ ግዶ።</para>
  <para style="p" vid="3JN 1:15">ነ ዳቦት ነና ሳሮ ያጎሶና። ኑ ዳቦታ ኡባ ኤንታ ሱን ሱን ፄጋዳ ታና “ሳሮ ግስ” ያጋ።<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
