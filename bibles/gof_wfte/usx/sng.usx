<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ሶሎሞነ ማዝሙረ ማፃፋ</para>
  <para style="toc1">ሶሎሞነ ማዝሙረ ማፃፋ</para>
  <para style="toc3">ሶሎ</para>
  <para style="toc2">ሶሎሞነ</para>
  <para style="mt">ሶሎሞነ ማዝሙረ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">“ሶሎሞነ ማዝሙረ ማፃፋ” ጌተትያ ማፃፋይ ሲቆ ግንፆን ፃፈትዳ ማፃፋ። ሀ ግንፆታፐ ዳሮ ባጋይ ማዝሙረ ማራን ፃፈትስ። ሀ ግንፆት ፃፈትሸ፥ አደይ ማጫሳስ፥ ቃስ ማጫስ አደስ ፃፍዳ ግንፆ። ሀ ማፃፋይ እስ እስ ብርሸታን “ሲቆ ሳባ” ዎይኮ “ማዝሙረታፐ አያ ማዝሙረ” ጌተቴስ። ሀራ ብርሸን ቃስ “ሶሎሞነ ማዝሙረ” ጌተትድ ኤረቴስ።</para>
  <para style="ip">ሀ ማዝሙረይ ዱማ ዱማ ኦገን ብርሸትሸ ጋምእስ። እስ እስ አሳይ፥ ክርስቶሳስነ ዎሳ ኬስ ግዶን ደእያ ሲቆ በሲያ ሌምሶ ግድ ቆፖሶና። አይሁደት ቃስ፥ “ፆሳስነ እስራኤለ አሳስ ግዶን ደእያ ሲቆ ሌምሶታ ኦይክዳ ማፃፋ” ጎሶና።</para>
  <para style="ip">ግዶሽን፥ ሀ ማዝሙረይ አደ ግዶንነ ማጫ ግዶን ደእያ ሲቆ ማዝሙረ። እስ መሄ ሄምያ ፓንይ እስ መሄ ሄምያ ጌላእዉ ደማናዉ ኮዬስ (1:7-8)። ኤንቲ ባንታ ማዝሙርያ ዎደ ዎንቶ ኤንቲ ኤከት ገለትያ ዎደ ኤንታ ኡፋይሳይ ኩመ ግዳናይሳ ቆንጭሶሶና።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ኮይሮ ማዝሙረ (<char style="ior"><ref loc="SNG 1:1-2:7">1:1—2:7</ref></char>)</para>
  <para style="io1">ናምአን ማዝሙረ (<char style="ior"><ref loc="SNG 2:8-3:5">2:8—3:5</ref></char>)</para>
  <para style="io1">ሄን ማዝሙረ (<char style="ior"><ref loc="SNG 3:6-5:1">3:6—5:1</ref></char>)</para>
  <para style="io1">ኦይዳን ማዝሙረ (<char style="ior"><ref loc="SNG 5:2-6:3">5:2—6:3</ref></char>)</para>
  <para style="io1">እቻሻን ማዝሙረ (<char style="ior"><ref loc="SNG 6:4-8:4">6:4—8:4</ref></char>)</para>
  <para style="io1">ኡሱፑን ማዝሙረ (<char style="ior"><ref loc="SNG 8:5-14">8:5-14</ref></char>)</para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>ማዝሙረ ኡባፈ አያ ሶሎሞነ ማዝሙረይ ሀይሳ።<verse eid="SNG 1:1"/></para>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>ነ ሲቆይ ዎይነፐ አድ ኡፋይስያ ግሾ</para>
  <para style="q2" vid="SNG 1:2">ታና ዛራ ዛራ ዬራ።<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>ነ ትየትያ ሽቶይ ዋንድ ሳዊ!</para>
  <para style="q2" vid="SNG 1:3">ነ ሱንይ ጎግያ ሽቶ መላ፤</para>
  <para style="q2" vid="SNG 1:3">ጌላኦት ነና ሲቀይ ሄሳሳ።<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>ታና ኔራ ኤካዳ ባ፤ አነ እስፈ ዎፆስ!</para>
  <para style="q2" vid="SNG 1:4">ካዋዉ፥ ታና ነ ቁሩፁዋን ገልሳ።</para>
  <para style="s1" vid="SNG 1:4">የሩሳላመ ማጫሳታ</para>
  <para style="q1" vid="SNG 1:4">ነናን ኑ ኡፋይቶስ፤</para>
  <para style="q2" vid="SNG 1:4">ነ ሲቁዋ ዎይነ ኡሻፈ አድ ናሾስ።</para>
  <para style="q2" vid="SNG 1:4">ማጫስ ኡባይ ነና ሲቀይሳ በሳ።<verse eid="SNG 1:4"/></para>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>ህንተኖ፥ የሩሳላመ ማጫሳቶ ስእተ፤</para>
  <para style="q2" vid="SNG 1:5">ታኒ ካሬ ግድኮካ ማላ ሎኦ።</para>
  <para style="q1" vid="SNG 1:5">ታ ካሬተይ ቀዳረ ዱንካነ መላ፤</para>
  <para style="q2" vid="SNG 1:5">ሽን ታ ማላይ ሶሎሞነ ማጋራጆታ መላ።<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>ታ ማላ ካሬዳይ አዋ፤</para>
  <para style="q2" vid="SNG 1:6">ታኒ ካሬ ግድዳ ግሾ ታና ቦሮፕተ።</para>
  <para style="q1" vid="SNG 1:6">ታ እሻት፥ ታ አየ ናይት ታራ ኦየትድ፥</para>
  <para style="q2" vid="SNG 1:6">ታና ዎይነ ጋደ ናግስዶሶና፤</para>
  <para style="q2" vid="SNG 1:6">ሄሳ ግሾ ታ ዎይንያ ናጋብከ።<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>ታ ሲቁዋዉ፥ አነ ታዉ ኦዳ፤</para>
  <para style="q2" vid="SNG 1:7">ነ ዶርሳ ዉድያ አዉን ሄማይ?</para>
  <para style="q2" vid="SNG 1:7">ሴታ ጋላስ ኤንታ አዉን ሸምፕሳይ?</para>
  <para style="q1" vid="SNG 1:7">ነና ደማናዉ ነ ላገታ ዉድያ ካላዳ፥</para>
  <para style="q2" vid="SNG 1:7">አይስ ጉሉንታዳ ብያ ማጫስ ግዶ?<verse eid="SNG 1:7"/></para>
  <para style="s1">ፓን</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>ማጫሳ ኡባፈ ሎእያረ፥</para>
  <para style="q2" vid="SNG 1:8">በሳ ኤሮና እፅኮ ዶርሳታ ጌዶ ካላ።</para>
  <para style="q1" vid="SNG 1:8">ነ ዴሻ ማራታ ሄንንቾታ</para>
  <para style="q2" vid="SNG 1:8">ዱንካንያ ማታን ሄማ።<verse eid="SNG 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="SNG 1:9"/>ታ ሲቀ! ግብፀ ካዎ ፓራ ጋረታ ጎችያ፥</para>
  <para style="q2" vid="SNG 1:9">ፓራታ ግዶን ደእያ ማጋየዳ ሎኣሳ።<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>ነ ሀይን ደእያ አሌቁዋራ ሺቅድ፥</para>
  <para style="q2" vid="SNG 1:10">ነ ሻካላይ ዋንድ ሎእ!</para>
  <para style="q2" vid="SNG 1:10">ነ ቆይ አልኦ ሹቻን አሌቀትስ።<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>ኑኒ ነዉ ብራን ጫደትዳ፥</para>
  <para style="q2" vid="SNG 1:11">ዎርቃ አሌቁዋ ኦስሳና።<verse eid="SNG 1:11"/></para>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>ካዎይ ጋይታ ቦላ ኡትዳሽን፥</para>
  <para style="q2" vid="SNG 1:12">ታ ሽቱዋ ሳዎይ ኬን ቶንኩ ግስ።<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>ታ ሲቆይ ታ ንታ ግዶን ደእያ፥</para>
  <para style="q2" vid="SNG 1:13">ፁንተትዳ ሳውያ ካርበ ዳኔስ።<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>ታ ሲቆይ፥ ኤንጋዳ ዎይነ ጋደን፥</para>
  <para style="q2" vid="SNG 1:14">ዶልዳ ሄና ጪሻ መላ።<verse eid="SNG 1:14"/></para>
  <para style="s1">ፓን</para>
  <para style="p">
    <verse number="15" style="v" sid="SNG 1:15"/>ታ ሲቀ፥ ኔኒ ዋና ሎአይ!</para>
  <para style="q2" vid="SNG 1:15">ኔኒ ዋና ሎአይ!</para>
  <para style="q2" vid="SNG 1:15">ነ አይፈት ሆለ አይፈዳ ሎኦሶና።<verse eid="SNG 1:15"/></para>
  <para style="b"/>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>ታ ሲቁዋዉ፥ ኔኒ ዋና ሎአይ!</para>
  <para style="q2" vid="SNG 1:16">አይባ ኡፋይሳይ፤</para>
  <para style="q2" vid="SNG 1:16">ኑ አርሳይ ጭልኦ ማታ መላ ኡፋይሴስ።<verse eid="SNG 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>ኑ ኬ ቱሳይ ዝጋ፤</para>
  <para style="q2" vid="SNG 1:17">ኑ ካራይ ፂዳን ኦይከትስ።<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>ታኒ ሳሮናን ዶልያ ጪሻነ</para>
  <para style="q2" vid="SNG 2:1">ዛንጋራን ዶልያ ሱፈ ጪሻ መላ።<verse eid="SNG 2:1"/></para>
  <para style="s1">ፓን</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>ታ ሲቅያ ማጫሳ ግዶን በእያ ዎደ፥</para>
  <para style="q2" vid="SNG 2:2">አጉን ግዶን በንትያ ሱፈ ጪሻ መላ።<verse eid="SNG 2:2"/></para>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>ታ ሲቆይ ሀራ ፓንታ ግዶን ፄልያ ዎደ</para>
  <para style="q2" vid="SNG 2:3">ዎራን ደእያ አፕለ ም መላ።</para>
  <para style="q1" vid="SNG 2:3">ታና ዳሮ ኡፋይስን፥ እያ ኩያ ግዶን ኡታስ፤</para>
  <para style="q2" vid="SNG 2:3">እያ አይፈይ ምን ታና ማልኤስ።<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>እ ታና ግብራ ምያ ኬ ገልስስ፤</para>
  <para style="q2" vid="SNG 2:4">ባ ሲቁዋ ባንድራዳ ታ ቦላ ቁ ቁ ኦስ። <verse eid="SNG 2:4"/><verse number="5" style="v" sid="SNG 2:5"/>ታኒ እያ ሲቁዋን ኦይከታዳ ሀርግዳ ግሾ፥</para>
  <para style="q2" vid="SNG 2:5">ዛብበ አይፈ ሙዝድ ታና ጋሽትስተ፤</para>
  <para style="q2" vid="SNG 2:5">አፕለ ሙዝድ ታ ዎልቃ ምንተ።<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>ባ ሀድርሳ ኩሽያ ታና ቦርኮትስስ፤</para>
  <para style="q2" vid="SNG 2:6">ባ ኡሻቻ ኩሽያን ታና ቆምስ።<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>ህንተኖ፥ የሩሳላመ ያላጋ ማጫሳዉ፥</para>
  <para style="q2" vid="SNG 2:7">ሲቆይ ባዉ ዶስድ ደንዳና ጋካናዉ፥</para>
  <para style="q2" vid="SNG 2:7">እያ ህንተ ባርከና መላ፥</para>
  <para style="q2" vid="SNG 2:7">ታ ህንተና ገንኤንነ ዎራ ዎሽኤን አማታይስ።<verse eid="SNG 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="SNG 2:8"/>ታ ሲቁዋ ግርሳይ ደርያ ቦላራ ጉፕሸነ፥</para>
  <para style="q2" vid="SNG 2:8">ዙማ ቦላራ ፆንገትሸ የይስ ስኤቴስ።<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>ታ ሲቆይ ዎሽኤ ዎይኮ ገንኤ ማር ዳኔስ፤</para>
  <para style="q2" vid="SNG 2:9">ሄኮ፥ ኑ ኬ ማታን ኤቅስ፤</para>
  <para style="q2" vid="SNG 2:9">ማስኮተራ ሶ ፄሌስ፤</para>
  <para style="q2" vid="SNG 2:9">ማጋራጁዋ ግዶራ ፄሌስ።<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>ታ ሲቆይ፥ ሀይሳዳ ያጌስ፤</para>
  <para style="q2" vid="SNG 2:10">“ታ ሲቀ፥ ደንዳ!</para>
  <para style="q2" vid="SNG 2:10">ታ የገልሰ፥ ሃያ፥ እስፈ አነ ቦስ።<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>ሄኮ፥ ባልጎይ አስ፤</para>
  <para style="q2" vid="SNG 2:11">እራይካ ኤቅስ።<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>ቢታን ጪሽ ጪይስ፤</para>
  <para style="q2" vid="SNG 2:12">የ የፅያ አጌናይ ጋክስ፤</para>
  <para style="q2" vid="SNG 2:12">ሆለ የ ኑ ቢታን ስኤትስ።<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>ባላሰ ምይ አይፈ ዶምስ፤</para>
  <para style="q2" vid="SNG 2:13">ዎይነይ ጪይስ፤</para>
  <para style="q2" vid="SNG 2:13">ጪሻ ሳዎይ ቢታን ቶንኩ ጌስ።</para>
  <para style="q1" vid="SNG 2:13">ታ ሲቀ፥ ደንዳ፤ ታ የገልሰ፥</para>
  <para style="q2" vid="SNG 2:13">ሃያ፤ አነ እስፈ ቦስ።”<verse eid="SNG 2:13"/></para>
  <para style="s1">ፓን</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>አፎ ዶናን ዛላ ቆጶን፥</para>
  <para style="q2" vid="SNG 2:14">ቆሰትዳ ሆለ ዳንያረ፤</para>
  <para style="q2" vid="SNG 2:14">አነ እስ ቶሆ ታና ነ ሶምኡዋ በሳ፤</para>
  <para style="q2" vid="SNG 2:14">ነ ግርሳ ስሳ።</para>
  <para style="q1" vid="SNG 2:14">ነ ቃላይ ታና ማልኤስ፤</para>
  <para style="q2" vid="SNG 2:14">ነ ሶምኦይ ዳሮ ሎኤስ።<verse eid="SNG 2:14"/></para>
  <para style="s1">የሩሳላመ ጌላኦታ</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>ኑ ዎይነይ ጪይስ፤</para>
  <para style="q2" vid="SNG 2:15">ኑ ዎይነ ጋድያ ኢስያ ዎርካናታ፥</para>
  <para style="q2" vid="SNG 2:15">ሄ ጉ ቡታለታ ፅሄን ኦይክተ።<verse eid="SNG 2:15"/></para>
  <para style="b"/>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>ታ ሲቆይ ታባ፤ ታንካ እያባ፤</para>
  <para style="q2" vid="SNG 2:16">ጪሻታ ግዶን እ ባ ዉድያ ሄሜስ።<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>ሳእ ጌያና ጋካናዉ፥</para>
  <para style="q2" vid="SNG 2:17">ኩያይ ያና ጋካናዉ፥</para>
  <para style="q2" vid="SNG 2:17">ታ ሲቁዋዉ፥ ገንኤዳ ዎይኮ ዎሽኤ ማራዳ፥</para>
  <para style="q2" vid="SNG 2:17">አፎትያ ደርያራ ዎፃሸ ሃ ስማ።<verse eid="SNG 2:17"/></para>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>ቃማ ኩመ ሂፃን ዝንአዳ፥</para>
  <para style="q2" vid="SNG 3:1">ታ ሲቁዋ ደማናዉ አሞታስ፤</para>
  <para style="q2" vid="SNG 3:1">ምንዳ ኮያስ፤ ሽን ደማብከ።<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>ካታማ ግዶን ደእያ ዳልጋነ</para>
  <para style="q2" vid="SNG 3:2">ፁን ኦገታ ኡባን ዩያስ።</para>
  <para style="q2" vid="SNG 3:2">ታ ሲቁዋ ደማናዉ ኮያስ፤</para>
  <para style="q2" vid="SNG 3:2">ምንዳ ኮያስ፤ ሽን ደማናዉ ዳንዳአብከ።<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>ካታማ ዩይድ ናገይሳት ታና ደምዶሶና፤</para>
  <para style="q2" vid="SNG 3:3">ታኒ፥ “ታ ሲቁዋ በእደቲ?” ያጋዳ ኦይቻስ።<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>ኤንታ አጋዳ አዳ መላ ታ ሲቁዋ ደማስ፤</para>
  <para style="q2" vid="SNG 3:4">እ ታፐ ከስ ኤኮናዳ ምንዳ ኦይካስ።</para>
  <para style="q1" vid="SNG 3:4">ታ አየ ሶ ኤፋስ፤</para>
  <para style="q2" vid="SNG 3:4">ታ የለትዳ ክፍልያ ገልሳስ።<verse eid="SNG 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>ህንተኖ የሩሳላመ ማጫ ናይቶ፥</para>
  <para style="q2" vid="SNG 3:5">ሲቆይ ባዉ ዶስድ ደንዳና ጋካናዉ፥</para>
  <para style="q2" vid="SNG 3:5">እያ ህንተ ባርክሶና መላ</para>
  <para style="q2" vid="SNG 3:5">ታኒ ህንተና ገንኤንነ ዎሽኤን አማታይስ።<verse eid="SNG 3:5"/></para>
  <para style="s1">የሩሳላመ ጌላኦታ</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>ዛልአንቾ እፃነዳነ ካርበዳ ሳውያራ፥</para>
  <para style="q2" vid="SNG 3:6">ጩያ ቱሱ ዳንያራ፥</para>
  <para style="q2" vid="SNG 3:6">ሀና መላ ቢታፈ ያራ እያ ኦኔ?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>ሄኮ፥ ሶሎሞነ ፓራ ጋርያ ያዉሱ፤</para>
  <para style="q2" vid="SNG 3:7">ሄ ፓራ ጋርዉ እስራኤለፐ ዶረትዳ፥</para>
  <para style="q2" vid="SNG 3:7">ኡሱፑን ታሙ ዎልቃማ ቶራንቾት አጃብዶሶና።<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>ኤንቲ ኡባይ ማሻ ኦይን ሜዘትዶሶና፤</para>
  <para style="q2" vid="SNG 3:8">ኦላንካ ፓጨትዶሶና።</para>
  <para style="q1" vid="SNG 3:8">ቃማ ጋክያ መቱዋ ተቃናዉ፥</para>
  <para style="q2" vid="SNG 3:8">ኤንቲ ማሸ ዳንጭድ ጊግዶሶና።<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>ካዋ ሶሎሞነይ ፓራ ጋረ ግዶን፥</para>
  <para style="q2" vid="SNG 3:9">ባዉ ኡትያ አራታ ጊግስስ፤</para>
  <para style="q2" vid="SNG 3:9">እያ አራታይ ልባኖሰፐ ይዳ ምን ኦሰትስ።<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>አራታ ቱሳይ ብራን ላንፀትስ፤</para>
  <para style="q2" vid="SNG 3:10">ዘምፖይ ዎርቃን አሌቀትስ።</para>
  <para style="q1" vid="SNG 3:10">ኦይደይ ኦቻ ቴራ ዳንያ ቃጭናን ካመትስ፤</para>
  <para style="q2" vid="SNG 3:10">ጋይ የሩሳላመ ጌላኦታ ሲቆን አሌቀትስ።<verse eid="SNG 3:10"/></para>
  <para style="b"/>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11"/>ህንተኖ፥ ፅዮነ ጌላኦቶ፥</para>
  <para style="q2" vid="SNG 3:11">ካዋ ሶሎሞነ በአናዉ ሃይተ።</para>
  <para style="q1" vid="SNG 3:11">እ ዳሮ ኡፋይትዳ እያ ያጋኑዋ ጋላስ</para>
  <para style="q2" vid="SNG 3:11">እያ አይያ እያ ሁጰን ዎዳ ካላቻ ዎስ።<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="s1">ፓን</para>
  <para style="p">
    <verse number="1" style="v" sid="SNG 4:1"/>ታ ሲቀ፥ ኔኒ ዋና ሎአይ!</para>
  <para style="q2" vid="SNG 4:1">ኔኒ ዋንዳ የገልሰ!</para>
  <para style="q1" vid="SNG 4:1">ነ አይፈት ጉሉን ግዶራ በእያ ዎደ፥</para>
  <para style="q2" vid="SNG 4:1">ሆለዳ ሎኦሶና።</para>
  <para style="q1" vid="SNG 4:1">ነ ብናናይ ጋላዳ ዙማፐ</para>
  <para style="q2" vid="SNG 4:1">ዎያ ዴሻ ዉደ ዳኔስ።<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>ነ አቻይ ሜደትድ ሃን ሜጨትዳ፥</para>
  <para style="q2" vid="SNG 4:2">ኡባይ መንተ የልያ፥</para>
  <para style="q2" vid="SNG 4:2">ኤንታ ግዶን አዉጫየይ ባይና ዶርሳ ዉደ መላ።<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>ነ መተርሻይ ዞኦ ቃጭና ዳኔስ፤</para>
  <para style="q2" vid="SNG 4:3">ነ ሃሳያ ዎደ ዳሮ ኡፋይሶሶና።</para>
  <para style="q1" vid="SNG 4:3">ነ ናምኡ ሻካላይ ጉሉን ግዶራ ፄልያ ዎደ፥</para>
  <para style="q2" vid="SNG 4:3">ናምአ ከስድ ጳልቅዳ ኦሮማነ ዳኖሶና።<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>ነ ቆይ ሎይ ኦዳ፥</para>
  <para style="q2" vid="SNG 4:4">እያ ቦላ ኦላንቾታ ጎንዳለይ ደእያ፥</para>
  <para style="q2" vid="SNG 4:4">ሙኩሉ ምኖ ኦላንቾታ ጎንዳለይ ካቀትዳ፥</para>
  <para style="q2" vid="SNG 4:4">ዳዊታ አዱሳ ግምብያ ዳኔስ።<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>ነ ናምኡ ንት መንተ የለትዳ፥</para>
  <para style="q2" vid="SNG 4:5">ሎኦ ጪሻታ ግዶን</para>
  <para style="q2" vid="SNG 4:5">ምያ ዎሽኤ ማራታ ዳኖሶና።<verse eid="SNG 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>ሳእ ጌያናፐ ስን፥</para>
  <para style="q2" vid="SNG 4:6">ማይ ክቻናፐ ስን፥</para>
  <para style="q2" vid="SNG 4:6">ካርበ ደርያነ እፃነ ዙማ ባዳ ሸምፓና።<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>ታ ሲቀ፥ ነ አሳተይ ኩመ ሎኦ፤</para>
  <para style="q2" vid="SNG 4:7">ነናን ቦረትያባይ ባዋ።<verse eid="SNG 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8"/>ታ ሙሹራተ፥ ልባኖሰፐ ሃያ፤</para>
  <para style="q2" vid="SNG 4:8">ጋሞይ ፔእያ፥ ማሄይ አቅያ፥</para>
  <para style="q1" vid="SNG 4:8">አማና ዙማፐ፥ ሳንራ ሊጰፐ</para>
  <para style="q2" vid="SNG 4:8">አርሞና ሁጵያፐ ዎ።<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>ታ ሲቀ፥ ምቾ ግድዳ ታ ሙሹራተ፤</para>
  <para style="q2" vid="SNG 4:9">ነ አይፍያ ፄሎይነ ነ ቆያ አሌቆይ፥</para>
  <para style="q2" vid="SNG 4:9">ታ ዎዛና ኡፋይሳን ጎሽስ።<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>ታ ሲቆ ምቾ ግድዳ ታ ሙሹራተ!</para>
  <para style="q2" vid="SNG 4:10">ነ ሲቆይ ታና ዋን ኡፋይስ!</para>
  <para style="q1" vid="SNG 4:10">ነ ሲቆይ ዎይነ ኡሻፈ አድ ኡፋይሴስ፤</para>
  <para style="q2" vid="SNG 4:10">ነ ሽቶይ ኡባፈ አድ ሳዌስ።<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>ታ ሙሹራተ፥ ነ መተርሻፈ እልሎ ኤስ ፆኬስ፤</para>
  <para style="q2" vid="SNG 4:11">ነ ዶናፐ ኤስነ ማ ፑልቴስ፤</para>
  <para style="q2" vid="SNG 4:11">ነ ማኦይ ልባኖሰ ሽቶዳ ሳዌስ።<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>ታ ሲቆ ምቾ ግድዳ ታ ሙሹራተ፥</para>
  <para style="q2" vid="SNG 4:12">ነ ዩሾይ ድረትድ ናገትያ አታክልተ በሳ መላ፤</para>
  <para style="q2" vid="SNG 4:12">ነ ሀራታስ ጎርደትዳ፥ ታዉ ዶየትዳ ፑልቶ መላ።<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>ኔኒ አታክልተ ግዶን፥</para>
  <para style="q2" vid="SNG 4:13">ኦሮማነይ፥ ዶረትዳ አታክልተ አይፈት፥</para>
  <para style="q2" vid="SNG 4:13">ናርዶሰ ጌተትያ አይፈት ደእያ በሳ መላ።<verse eid="SNG 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14"/>ናርዶሰይ፥ ላደይ፥ ሳውያ ማት፥ ቃራፍን፥</para>
  <para style="q2" vid="SNG 4:14">እፃናዳ ሳውያባት ደኦሶና።</para>
  <para style="q1" vid="SNG 4:14">ካርበይ፥ ጎዳረ ኡ ጪሽነ</para>
  <para style="q2" vid="SNG 4:14">ዱማ ዱማ ቅማመ አታክልተት ዶሎሶና።<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>ኔኒ አታክልተ በሳ ኡሽያ ፑልቶ መላ፤</para>
  <para style="q2" vid="SNG 4:15">ደኦ ሃ በንትያ ኦላ መላ፤</para>
  <para style="q2" vid="SNG 4:15">ልባኖሰ ዙማፐ ጎግያ ሻፋ መላ።<verse eid="SNG 4:15"/></para>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>ፑደሀ ባጋ ጫርኩዋዉ፥ ደንዳ!</para>
  <para style="q2" vid="SNG 4:16">ዱገሀ ባጋ ጫርኩዋዉ፥ ሃያ!</para>
  <para style="q1" vid="SNG 4:16">ታ አታክልትያ ቦላ ጫርካ!</para>
  <para style="q2" vid="SNG 4:16">እያ ሳዎይ ቶንኩ ጎ።</para>
  <para style="q1" vid="SNG 4:16">ታ ሲቆይ ባ አታክልትያ ግዶ ዮ፤</para>
  <para style="q2" vid="SNG 4:16">ዳሮ ማልእያ አይፈታ ሞ።<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="s1">ፓን</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>ታ ምቸ፥ ታ ሙሹራተ፥</para>
  <para style="q2" vid="SNG 5:1">ታኒ ታ አታክልትያ ግዶ ገላስ።</para>
  <para style="q1" vid="SNG 5:1">ታ ካርብያነ ታ ሽቶ ጪሻ ቆራስ፤</para>
  <para style="q2" vid="SNG 5:1">ታኒ ኤሳ ኡይ ማስ፤</para>
  <para style="q2" vid="SNG 5:1">ታ ዎይንያነ ታ ማ ኡያስ።</para>
  <para style="s1" vid="SNG 5:1">የሩሳላመ ጌላኦታ</para>
  <para style="q1" vid="SNG 5:1">እያ ላገቶ፥ ሚተ ኡይተ፤</para>
  <para style="q2" vid="SNG 5:1">ሲቆ አላና ጋካናዉ ኡይተ።<verse eid="SNG 5:1"/></para>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>ታኒ ስካስ፤ ሽን ታ ዎዛናይ ባርክስ፤</para>
  <para style="q2" vid="SNG 5:2">ታ ሲቆይ ሀይሳዳ ያግድ ፐንግያ ቆንክሽን ስአስ።</para>
  <para style="q1" vid="SNG 5:2">“ታ ምቸ፥ ታ ሲቀ፥ ታ የገልሰ፤</para>
  <para style="q2" vid="SNG 5:2">ቦረይ ባይና ታ ሆለ፥</para>
  <para style="q2" vid="SNG 5:2">ታዉ ፐንግያ ዶያ።</para>
  <para style="q1" vid="SNG 5:2">ታ ሁጰይ አካን ላክስ፤</para>
  <para style="q2" vid="SNG 5:2">ታ ብናናይ ቃማ ፑሰን እርፅስ።”<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>ታ ማኡዋ ቃራስ፥ ዛራዳ ማኦዬ?</para>
  <para style="q2" vid="SNG 5:3">ታ ቶሁዋ ሜጨታስ፥ ዛራዳ ቅታዮዬ?<verse eid="SNG 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>ታ ሲቆይ እብ ፆኤራ ባ ኩሽያ ሶ የድስ፤</para>
  <para style="q2" vid="SNG 5:4">ታ ዎዛናይ እያ ግሾ ሴሌስ።<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>ታ ሲቁዋስ ዶያናዉ ደንዳስ፤</para>
  <para style="q2" vid="SNG 5:5">ፐንግያ ዶያናዉ ኮብያ ኦይክያ ዎደ፥</para>
  <para style="q2" vid="SNG 5:5">ታ ኩሽያፐ ካርበይ፥</para>
  <para style="q2" vid="SNG 5:5">ታ ብራያፈ ሽቶይ ፆኬስ።<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>ታ ሲቁዋስ ካርያ ዶያስ፥ ሽን እ ዴና፤</para>
  <para style="q2" vid="SNG 5:6">እያ ቃላ ስአናዉ ዳሮ አሞታስ።</para>
  <para style="q1" vid="SNG 5:6">ምንዳ ኮያስ፥ ሽን እያ ደማብከ፤</para>
  <para style="q2" vid="SNG 5:6">ፄጋስ፥ ሽን ታዉ ኮይቤና።<verse eid="SNG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>ካታማ ናገይሳት ታና ደምድ፥</para>
  <para style="q2" vid="SNG 5:7">ዋዶሶና፤ ማዱንፅስዶሶና።</para>
  <para style="q1" vid="SNG 5:7">ካታማ ድርሳ ናገይሳት፥</para>
  <para style="q2" vid="SNG 5:7">ታ ላፃና ቃር ኤክዶሶና።<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>ህንተኖ፥ የሩሳላመ ጌላኦቶ፥</para>
  <para style="q2" vid="SNG 5:8">ታ ሲቁዋ ደምኮ፥</para>
  <para style="q2" vid="SNG 5:8">ታኒ እያ ሲቁዋን ሀርግዳይሳ፥</para>
  <para style="q2" vid="SNG 5:8">ሀዳራ እያዉ ኦድተ።<verse eid="SNG 5:8"/></para>
  <para style="s1">የሩሳላመ ጌላኦታ</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>ነኖ፥ ማጫሳ ኡባፈ ሎእያራ፥</para>
  <para style="q2" vid="SNG 5:9">ነ ላገይ ሀራታፐ ዋንድ ዱማቲ?</para>
  <para style="q1" vid="SNG 5:9">ኔኒ ኑና ሀዳራ ገይ፥</para>
  <para style="q2" vid="SNG 5:9">እ ሀራታፐ አይብን ዱማቲ?<verse eid="SNG 5:9"/></para>
  <para style="b"/>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>ታ ሲቆይ ማላ ሎኦነ አያንታ፤</para>
  <para style="q2" vid="SNG 5:10">ታሙ ሙኩሉ አደታ ግዶን እያ መል ባዋ።<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>እያ ሁጰይ አልኦ ዎርቃ ዳኔስ፤</para>
  <para style="q2" vid="SNG 5:11">እያ ብናናይ ሎኦነ ቁሮ መላ ካሬ።<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>እያ አይፈይ ሻፋ ማታን ኤቅዳ፥</para>
  <para style="q2" vid="SNG 5:12">ማን ሜጨትዳ ሆለታ ዳኔስ።<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>እያ ሻካላይ ሳውያ ቅማመይ ቶከትዳ ማዳበዳ ሎኤስ፤</para>
  <para style="q2" vid="SNG 5:13">እያ መተርሻይ ካርበ ሽቶይ ፆክያ ዎራ ጪሻዳ ሎኤስ።<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>እያ ቀሰይ አልኦ ሹቻን አሌቀትዳ ዎርቃ ፃምአዳ ሎኤስ፤</para>
  <para style="q2" vid="SNG 5:14">እያ አሳተይ ሳንፓረ አልኦ ሹቻን አሌቀትዳ ዳንጋርሳ ዛለ መላ።<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>እያ ቶሆት ዎርቃ ባሶን ኤቅዳ ሳሎ ሹቻ ቱስ ዳኖሶና፤</para>
  <para style="q2" vid="SNG 5:15">እያ ማላይ ዝጋን አሌቀትዳ ልባኖሰ ዙማ መላ።<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>እያ ዶናይ ኤሳዳ ማልኤስ፤</para>
  <para style="q2" vid="SNG 5:16">እያ ኩመ አሳተይ ሎኤስ።</para>
  <para style="q1" vid="SNG 5:16">ህንተኖ የሩሳላመ ጌላኦቶ፥</para>
  <para style="q2" vid="SNG 5:16">ታ ሲቆይነ ታ ላገይ ሀይሳ ዳነስ።<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="s1">የሩሳላመ ጌላኦታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>ማጫሳ ኡባፈ ሎእያረ፥ ነ ላገይ አዉ ብዴ?</para>
  <para style="q2" vid="SNG 6:1">ኑ ኔራ ኮያና መላ እ ብዳ ግና ኑስ ኦዳ።<verse eid="SNG 6:1"/></para>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>ታ ሲቆይ ዶርሳ ዉደ ሄማናዉ፥</para>
  <para style="q2" vid="SNG 6:2">ሎኦ ጪሻ ሺሻናዉ፥</para>
  <para style="q2" vid="SNG 6:2">ሽቶ ማታይ ደእያ አታክልትያ ግዶ ብስ።<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>ታኒ ታ ሲቁዋባ፤ ታ ሲቆይ ታባ፤</para>
  <para style="q2" vid="SNG 6:3">እ ሱፈ ጪሻ ግዶን ዉደ ሄሜስ።<verse eid="SNG 6:3"/></para>
  <para style="s1">ፓን</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>ታ ሲቀ፥ ነ ትርሳ ካታሜዳ ሎኣሳ፤</para>
  <para style="q2" vid="SNG 6:4">የሩሳላመዳ ዳሮ ሎኣሳ።</para>
  <para style="q1" vid="SNG 6:4">ባንድራ ኦይክድ ሳልፕያ፥</para>
  <para style="q2" vid="SNG 6:4">ኦላንቾዳ ያሻሳ።<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>ኤንቲ ታና ኡንኤዳ ግሾ፥</para>
  <para style="q2" vid="SNG 6:5">ሀያና ነ አይፍያ ታፐ ደን።</para>
  <para style="q1" vid="SNG 6:5">ነ ብናናይ ጋላዳ ዙማፐ ዎያ፥</para>
  <para style="q2" vid="SNG 6:5">ዴሻ ዉደ ዳኔስ።<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>ነ አቻይ ሜጨትድ ከይያ፥</para>
  <para style="q2" vid="SNG 6:6">ኡባይ መንተ የልያ፥</para>
  <para style="q2" vid="SNG 6:6">ኤንታ ግዶን አዉጫየይ ባይና ዶርሳ ዉደ መላ።<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>ነ ናምኡ ሻካላይ ጉሉን ግዶራ ፄልያ ዎደ፥</para>
  <para style="q2" vid="SNG 6:7">ናምኡ ከስድ ጳልቅዳ ኦሮማነ ዳኖሶና።<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>ኡሱፑን ታሙ ማጫ ካዎት፥</para>
  <para style="q2" vid="SNG 6:8">ሆስፑን ታሙ ላገት፥</para>
  <para style="q2" vid="SNG 6:8">ታይቦይ ባይና ጌላኦት ደኦሶና።<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>ሽን ቦረይ ባይና ታ ሆልያ ታዉ ዱማ፤</para>
  <para style="q2" vid="SNG 6:9">እያ ባ አየስ እስኖ።</para>
  <para style="q1" vid="SNG 6:9">እዮ የልዳ አይያ ኡባፈ አዳ እዮ ዶሳዉሱ፤</para>
  <para style="q2" vid="SNG 6:9">ጌላኦት እዮ በእድ፥ “ሀና አንጀትዳሮ” ያጎሶና፤</para>
  <para style="q2" vid="SNG 6:9">ማጫ ካዎትነ ላገት እዮ ሳቦሶና።<verse eid="SNG 6:9"/></para>
  <para style="s1">የሩሳላመ ጌላኦታ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>ሀና ዎንታ ፃልቀዳ ዶልያራ፥</para>
  <para style="q2" vid="SNG 6:10">አጌናዳ ፖእያራ፥ ፃልቀዳ ጫድያራ፥</para>
  <para style="q2" vid="SNG 6:10">ባንድራ ኦይክድ ሳልፐ ከይዳ፥</para>
  <para style="q2" vid="SNG 6:10">ኦላንቾዳ ያሽያራ ሀና ኦኔ?<verse eid="SNG 6:10"/></para>
  <para style="s1">ፓን</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>ታኒ ዛንጋራን ቶከትዳ ምታ በአናዉ፥</para>
  <para style="q2" vid="SNG 6:11">ዎይነይ አጭዳኮ ኦሮማነይ አይፍዳኮ ፄላናዉ፥</para>
  <para style="q2" vid="SNG 6:11">ዱገ ኦቾሎነ ጋደ ዎስ።<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>ታ ቆፖና ደእሽን ታ አሞይ ታና ኤፍድ፥</para>
  <para style="q2" vid="SNG 6:12">ካዋ አሳ ፓራ ጋረታ ግዶን ታና ኡትስስ።<verse eid="SNG 6:12"/></para>
  <para style="s1">የሩሳላመ ጌላኦታ</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>ነኖ ሱላማፐ ይዳረ፥ ሃያ፤ ሃ ስማ፤</para>
  <para style="q2" vid="SNG 6:13">ኑ ነና ሎይድ ፄላና መላ ሃ ስማ።</para>
  <para style="s1" vid="SNG 6:13">ጌላእዉ</para>
  <para style="q1" vid="SNG 6:13">ዳሮ አሳ ስንን የፅያ አሳዳ፥</para>
  <para style="q2" vid="SNG 6:13">ታና አይስ ፄሌቲ?<verse eid="SNG 6:13"/></para>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="s1">ፓን</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>ካዎ ናአዳ ሎእያረ፥</para>
  <para style="q2" vid="SNG 7:1">ላፃና ጫማ አዳ ነ ቶሆት ዋን ሎእ!</para>
  <para style="q1" vid="SNG 7:1">ነ ሼቸይ ሂላንቾይ ቆፅድ፥</para>
  <para style="q2" vid="SNG 7:1">አሌቅስዳ አልኦ ሹቹ ዳኔስ።<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>ነ ጉልአይ ዎይነይ ኩምዳ ብርለ ዳኔስ፤</para>
  <para style="q2" vid="SNG 7:2">ነ ፄሳ ዩሾይ ጪሻን ቃሸትዳ ግስተ ምርቀ ዳኔስ።<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>ነ ንት መንተ የለትዳ፥</para>
  <para style="q2" vid="SNG 7:3">ገንኤ ማር ዳኖሶና።<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>ነ ቆይ ዳንጋርሳ ዛለን</para>
  <para style="q2" vid="SNG 7:4">አሌቀትዳ አዱሳ ሻኮ መላ።</para>
  <para style="q1" vid="SNG 7:4">ነ አይፈይ ግታ ሀሰቦና ካታማ ፐንግያ ማታን፥</para>
  <para style="q2" vid="SNG 7:4">ደእያ ዜሮ ሃ ዳኔስ።</para>
  <para style="q1" vid="SNG 7:4">ነ ሲይ ዳማስቆኮ ዛሪድ ግምብዳ፥</para>
  <para style="q2" vid="SNG 7:4">ልባኖሰ ግምብያ ዳኔስ።<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>ነ ሁጰይ ቃርመሎሳ ዙማ ዳኔስ፤</para>
  <para style="q2" vid="SNG 7:5">ነ ብናናይ ቃጭና ፃ ዳኔስ፤</para>
  <para style="q2" vid="SNG 7:5">ነ ሁጵያ ዳይ ካዋ ኡፋይሴስ።<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>ታ ሲቀ፥ ነ ዋና ሎአይ!</para>
  <para style="q2" vid="SNG 7:6">ነ ዋንዳ የገልሰ!</para>
  <para style="q2" vid="SNG 7:6">ነ ሲቆይ ታና ዋን ኡፋይስ!<verse eid="SNG 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>ነ ጌሳይ ዛምባ ዳኔስ፤</para>
  <para style="q2" vid="SNG 7:7">ነ ንይ ዛምባ ሞርኤ ዳኔስ።<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>ታኒ፥ “ዛምባ ቦላ ከያና፤</para>
  <para style="q2" vid="SNG 7:8">እያ አይፍያ ማፃና” ያጋስ።</para>
  <para style="q1" vid="SNG 7:8">ነ ንይ ዎይነ ሞርኤ መላ፤</para>
  <para style="q2" vid="SNG 7:8">ነ ሲያራ ከያ ፔኖይ አፕለዳ ሳዌስ።<verse eid="SNG 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9"/>ነ ዶናፐ ከይያ ፔኖይ</para>
  <para style="q2" vid="SNG 7:9">ሎኦ ዎይነ መላ።</para>
  <para style="s1" vid="SNG 7:9">ጌላእዉ</para>
  <para style="q1" vid="SNG 7:9">ህዛ ሎእያ ዎይነ ኡሻይ፥</para>
  <para style="q2" vid="SNG 7:9">ነ ሲቀ መተርሻፈነ አቻፈ ግዶራ፥</para>
  <para style="q2" vid="SNG 7:9">ለፕ ግድ ጎጎ።<verse eid="SNG 7:9"/></para>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>ታኒ ታ ሲቁዋባ፤ እካ ታና አሞቴስ።<verse eid="SNG 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11"/>ታ ሲቁዋዉ፥ ሃያ፤</para>
  <para style="q2" vid="SNG 7:11">ካታማፐ ከይድ ጋፃረ ቦስ፤</para>
  <para style="q2" vid="SNG 7:11">ናምአይ ቃማ ያን አና።<verse eid="SNG 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12"/>ዎንታ ጉራ ዎይነ አታክልትያ ግዶ ቦስ፤</para>
  <para style="q2" vid="SNG 7:12">ዎይነይ ጪይዳኮ፥ አይፈ አዳኮ፥</para>
  <para style="q2" vid="SNG 7:12">ኦሮማነይ አይፍዳኮ አነ በኦስ።</para>
  <para style="q1" vid="SNG 7:12">ታኒ ታ ሲቁዋ ነና ያን በሳና።<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>እንኮየ አይፈ ሳዎይነ</para>
  <para style="q2" vid="SNG 7:13">ዱማ ዱማ ኡፋይስያ አታክልተ አይፈይ</para>
  <para style="q2" vid="SNG 7:13">ኑ ካረን ኩምስ።</para>
  <para style="q1" vid="SNG 7:13">ታ ሲቁዋዉ! ሀ አይፈታፐ ቴርዳይሳነ</para>
  <para style="q2" vid="SNG 7:13">ኦራ ማፅዳይሳ ነዉ ዎስ።<verse eid="SNG 7:13"/></para>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 8:1"/>ነ ታዉ ታ አየ ን ምዳ</para>
  <para style="q2" vid="SNG 8:1">ታ እሻ ግድዳኮ አይበ!</para>
  <para style="q1" vid="SNG 8:1">ታ ነና ኦገን ደማዳ ዬርዳኮ፥</para>
  <para style="q2" vid="SNG 8:1">ታና ኦንካ ቦረናሽን።<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>ታኒ ነና ካለዳ፥</para>
  <para style="q2" vid="SNG 8:2">ታና ታማርስዳ ታ አየ ሶ ገልሳርክናሽን።</para>
  <para style="q1" vid="SNG 8:2">ማልእያ ኦሮማነ ጉምኤነ</para>
  <para style="q2" vid="SNG 8:2">ሎእያ ዎይነ ኡሻ ታ ነና ያን ኡሻርክና።<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>ታና ነ ሀድርሳ ኩሸይ ቦርኮትሴስ፥</para>
  <para style="q2" vid="SNG 8:3">ነ ኡሻቻ ኩሸይ ታና ቆመስ።<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>ህንተኖ፥ የሩሳላመ ጌላኦቶ፥</para>
  <para style="q2" vid="SNG 8:4">ታ ሲቆይ ባ ዎደ ደንዳና ጋካናዉ፥</para>
  <para style="q2" vid="SNG 8:4">ኮይሮትድ ህንተ እያ ደንናዳ ሀዳራ ጋይስ።<verse eid="SNG 8:4"/></para>
  <para style="s1">የሩሳላመ ጌላኦታ</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>ባ ሲቁዋ ሀሸን ዘምፓዳ፥</para>
  <para style="q2" vid="SNG 8:5">መላ ቢታፈ ያራ ሀና ኦኔ?</para>
  <para style="s1" vid="SNG 8:5">ጌላእዉ</para>
  <para style="q1" vid="SNG 8:5">በን ነ አይያ ነና እቀታዳ የልዳ፥</para>
  <para style="q2" vid="SNG 8:5">አፕለ ም ጋርሳን ነ ዝንእዳሽን፥</para>
  <para style="q2" vid="SNG 8:5">ነና ታ ባርክሳስ።<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>መርና ሲቁዋን ታና ነ ዎዛናን አታማ፤</para>
  <para style="q2" vid="SNG 8:6">ነ ቀስያን ማታመዳ ታ ፃላላ ኦይካ።</para>
  <para style="q1" vid="SNG 8:6">ሲቆይ ሀይቆ መላ ምኖ፤</para>
  <para style="q2" vid="SNG 8:6">ቃናተይ ስኦለ መላ ኢታ፤</para>
  <para style="q2" vid="SNG 8:6">እያ ላጮይ ፆሳ ታማ ላጮ መላ።<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>ዳሮ ሃ ሲቆ ታማ ቶይሳናዉ ዳንዳኤና፤</para>
  <para style="q2" vid="SNG 8:7">ድኦይካ ሜጭድ ኤፋናዉ ዳንዳኤና።</para>
  <para style="q1" vid="SNG 8:7">አስ ሲቆ ሻማናዉ ባዉ ደእያ ኡባ እምኮካ፥</para>
  <para style="q2" vid="SNG 8:7">ሲቆይ ሚሸን ሻመቶና ግሾ፥ አስ እያ ካስ።<verse eid="SNG 8:7"/></para>
  <para style="s1">ጌላኤ እሻታ</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>ን ትራን ኡትቦና ምቻ ኑስ ደአዉሱ፤</para>
  <para style="q2" vid="SNG 8:8">አዝን እዮ ኦይችኮ፥ ኑ እዉ አይ ኦኔ?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>እያ ግምበ ድርስ ግድያኮ፥</para>
  <para style="q2" vid="SNG 8:9">ኑኒ እ ቦላ አዱሳ ብራ ግምበ ግምባና፤</para>
  <para style="q2" vid="SNG 8:9">እያ ድርሳ ፐንገ ግድያኮ ዝጋ እብ መና።<verse eid="SNG 8:9"/></para>
  <para style="s1">ጌላእዉ</para>
  <para style="p">
    <verse number="10" style="v" sid="SNG 8:10"/>ታኒ ድርሳ ግምበ፤</para>
  <para style="q2" vid="SNG 8:10">ታ ንይ ግምበ ቦላ ደእያ ሻኮ መላ፤</para>
  <para style="q2" vid="SNG 8:10">ታኒ ታ ሲቁዋራ ደእያ ዎደ እ ታናን ኡፋይቴስ።<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>ሶሎሞነስ ባኣል-ሀሞናን ዎይነ ጋደይ ደኤስ፤</para>
  <para style="q2" vid="SNG 8:11">ሄ ዎይነ ጋድያ ኡነ ኦይሳታስ እሚስ።</para>
  <para style="q1" vid="SNG 8:11">ከራ ኤክዳይሳት አይፍያ ግሾ፥</para>
  <para style="q2" vid="SNG 8:11">እሶይ እሶይ ሙኩሉ ብራ እያዉ ኤሆሶና።<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>ሽን ታዉ ታ ቡዞ ዎይነ ጋደይ ደኤስ፤</para>
  <para style="q2" vid="SNG 8:12">ሶሎሞነ፥ ኔኒ ሙኩሉ ብራ ኤካ፤</para>
  <para style="q2" vid="SNG 8:12">ኡነ ኤክድ ኦይሳት ናምኡ ፄቱ ብራ ኤኮ።<verse eid="SNG 8:12"/></para>
  <para style="s1">ፓን</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>ነኖ፥ አታክልትያ ግዶን ደእያ ታ ሲቀ፥</para>
  <para style="q2" vid="SNG 8:13">ነ ላገት ነ ቃላ ስአናዉ ኮዮሶና፤</para>
  <para style="q2" vid="SNG 8:13">ነ ቃላ ታናካ ስሳ።<verse eid="SNG 8:13"/></para>
  <para style="s1">ጌላእዉ</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>ታ ሲቁዋዉ፥ ታኮ ኤለ ያ!</para>
  <para style="q2" vid="SNG 8:14">ሽቶ ማታይ ዶልያ ደረታ ቦላራ፥</para>
  <para style="q2" vid="SNG 8:14">ጉፕያ ገንኤ ዎይኮ ዎሽኤ ማራዳ ሀና።<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
