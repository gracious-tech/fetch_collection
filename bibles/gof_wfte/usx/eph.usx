<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ኤፈሶና ኪታ</para>
  <para style="toc1">ኤፈሶና ኪታ</para>
  <para style="toc3">ኤፈ</para>
  <para style="toc2">ኤፈሶና</para>
  <para style="mt1">ጳዉሎስ ኤፈሶና አሳስ</para>
  <para style="mt2">ፃፍዳ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ጳዉሎስ ኤፈሶናን ደእያ አማንያ አሳስ ፃፍዳ ኪታን ኡባፈ አድ በሰይ፥ “ዎደይ ጋክያ ዎደ ፆሳይ ፖላናዉ ቆፕዳ ቆፋይ፥ ሳሎንነ ሳአን ደእያ መተ ኡባይ ክርስቶሳፐ ጋርሳን ግዳና መላሳ” ግያ ቆፋ (<char style="xt"><ref loc="EPH 1:10">1:10</ref></char>)። የሱስ ክርስቶሳራ ደእያ እስፈተን፥ አሳ ኮች ኡባይ እስኖ ግዳና መላ ሀ ግታ ቆፋ ኦሶን ፔሻና መላ ፆሳ አሳ አኬክሴስ።</para>
  <para style="ip">ኤፈሶና ኪታን፥ ኮይሮ ሻሁዋን፥ ፃፈይ ካራ ቆፋ ግድዳ እስፈተባ ፃፋናዉ ዶምዳይሳ ዳልግስድ፥ ፆሳ አዋይ ባ አሳ ዋትድ ዶርዳኮ፥ ኤንትካ እያ ናኣ፥ የሱስ ክርስቶሳን ባንታ ናጋራፐ ማሮታ ደምድ ዋንድ ላአ ከይዳኮነ፥ ፆሳ ግታ ኡፋይሳ ቃላይ ጌሻ አያና ባጋራ ቱማ ግደይስ ዋንድ ኤረትዳኮ ኦዴስ። ናምአን ሻሁዋን ቃስ፥ ፃፈይ ሀ ኪታ ናባብያ አሳይ፥ ክርስቶሳን ኤንታዉ ደእያ እስፈተይ ቱማ ግዳና መላ ኤንቲ ዋንድ ዳናዉ በሲያኮ ቆፍሴስ።</para>
  <para style="ip">አሳይ ክርስቶሳን ደእያ እስፈተን ዋንድ ዳናዉ በሲያኮ ዱማ ዱማ ሌምሶን ቆንጭስ። ዎሳ ኬ አሳተ ሌምሶ ግድያ ዎደ ክርስቶስ ሄ አሳተስ ሁጰ። ዎሳ ኬ ግምበ ኬን ሌምሰትያ ዎደ ክርስቶስ ኬ ምንያ ማዛነ ሹቹ። ዎሳ ኬ ማችን ሌምሰትያ ዎደ ክርስቶስ አዝናን ሌምሰትስ። ፃፈይ ክርስቶሳ ባጋራ ቆንጭዳ ፆሳ አ ኬሀተ ዳሮ ናሽድ ኦድሸ፥ ቆፋይ ጪሞ ግድዳ ኦዳ ኦድስ። ጳዉሎስ፥ ኡባባ ክርስቶሳ ሲቁዋ፥ እያ ያርሸተ፥ እ እምዳ ናጋራ አቶተ፥ እያ አ ኬሀተነ እያ ጌሻተ ባጋራ ፄሌስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሳሮ (<char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref></char>)</para>
  <para style="io1">ክርስቶሳነ ዎሳ ኬ (<char style="ior"><ref loc="EPH 1:3-3:21">1:3—3:21</ref></char>)</para>
  <para style="io1">ክርስቶሳን ደእያ ኦራ ደኡዋ (<char style="ior"><ref loc="EPH 4:1-6:20">4:1—6:20</ref></char>)</para>
  <para style="io1">አኬክሶነ ሳሮ (<char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref></char>)</para>
  <chapter number="1" style="c" sid="EPH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1"/>ፆሳ ሸነን ክርስቶስ የሱሳ ሀዋረ ግድዳ ጳዉሎሳፐ፥ ኤፈሶናን ደእያ ጌሻታስነ ክርስቶስ የሱሳ አማነይሳታስ ፃፈትዳ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 18:19-21">ሀዋ 18:19-21</ref>፤ <ref loc="ACT 19:1">19:1</ref>.</char></note><verse eid="EPH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2"/>ፆሳ ኑ አዋፐነ ጎዳ የሱስ ክርስቶሳፐ አ ኬሀተይነ ሳሮተይ ህንተዉ ግዶ።<verse eid="EPH 1:2"/></para>
  <para style="s1">ክርስቶሳን ደእያ አያና አንጁዋ</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3"/>ሳሎን ደእያ አያና አንጆ ኡባን ክርስቶሳ ባጋራ ኑና አንጅዳ፥ ኑ ጎዳ የሱስ ክርስቶሳ አዋይ፥ ፆሳይ ጋላተቶ። <verse eid="EPH 1:3"/><verse number="4" style="v" sid="EPH 1:4"/>ኑኒ እያ ስንን ጌሻታነ ቦረይ ባይናይሳታ ግዳና መላ ፆሳይ አላመይ መታናፐ ካሰ ክርስቶሳ ባጋራ ባ ሲቁዋን ኑና ዶርስ። <verse eid="EPH 1:4"/><verse number="5" style="v" sid="EPH 1:5"/>ፆሳይ ባ ሸንያን ባ ዶስዳይሳዳ የሱስ ክርስቶሳ ባጋራ ኑና ባ ናይታ ኦናዉ ካሰትድ ቆፕ ዎስ። <verse eid="EPH 1:5"/><verse number="6" style="v" sid="EPH 1:6"/>ፆሳይ ባ ሲቅያ ናኣ ባጋራ ኑስ ጮ እምዳ አ ኬሀተይ ቦንቸታና መላ ሄሳ ኦስ።<verse eid="EPH 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 1:7"/>ፆሳ አ ኬሀተ ዱረተዳ ክርስቶሳ ሱን ዎዘትድ ናጋራ አቶተ ደምዳ። <verse eid="EPH 1:7"/><verse number="8" style="v" sid="EPH 1:8"/>ባ አ ኬሀተ ጭንጫተንነ ኤራተን ኩንድ ኑስ እሚስ።<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="COL 1:14">ቆላ 1:14</ref>.</char></note> <verse eid="EPH 1:8"/><verse number="9" style="v" sid="EPH 1:9"/>ፆሳይ ባ ዶስዳይሳዳ ክርስቶሳ ባጋራ እያ ሸንያ ፁራ ኑ ኤራና መላ ኦስ። <verse eid="EPH 1:9"/><verse number="10" style="v" sid="EPH 1:10"/>ዎደይ ጋክያ ዎደ ፆሳይ ፖላናዉ ቆፕዳ ቆፋይ፥ ሳሎንነ ሳአን ደእያ መተ ኡባይ ክርስቶሳፐ ጋርሳን ግዳና መላሳ።<verse eid="EPH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11"/>ኡባባ ባ ሸንያዳ ኦያ ፆሳይ፥ ካሰትድ ሀልችዳይሳ ክርስቶሳ ባጋራ ኑኒ እያባ ግዳና መላ ኑና ዶርስ። <verse eid="EPH 1:11"/><verse number="12" style="v" sid="EPH 1:12"/>ሄሳ እ ኦዳይ፥ ክርስቶሳን ኡፋይስ ዎድ ናጎን ኮይሮ ግድዳ ኑኒ ፆሳ ቦንቹዋ ጋላታን ቆንጭሳና መላሳ። <verse eid="EPH 1:12"/><verse number="13" style="v" sid="EPH 1:13"/>ህንተካ ህንተ አቶተ ዎንገላ፥ ሄስካ ቱማ ቃላ ስእዳ ዎደ ክርስቶሳ አማንደታ። ፆሳይ ህንተዉ እማና ግዳ ጌሻ አያናን ህንተ አታመትደታ። <verse eid="EPH 1:13"/><verse number="14" style="v" sid="EPH 1:14"/>ፆሳ ቦንቾይ ጋላተታና መላ ፆሳይ ባ አሳ ዎዛና ጋካናዉ ጌሻ አያና ኑስ ኦይ ኦድ እሚስ።<verse eid="EPH 1:14"/></para>
  <para style="s1">ጳዉሎሳ ዎሳ</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15"/>ሄሳ ግሾ፥ ጎዳ የሱሳ ህንተ አማነይሳነ ጌሻታ ኡባ ህንተ ሲቀይሳ ታ ስእዳ ዎደ <verse eid="EPH 1:15"/><verse number="16" style="v" sid="EPH 1:16"/>ታ ዎሳን ህንተና ቆፓሸ ህንተ ግሾ ፆሳ ጋላተይሳ አጋብከ። <verse eid="EPH 1:16"/><verse number="17" style="v" sid="EPH 1:17"/>ጎዳ የሱስ ክርስቶሳ ፆሳይ፥ ቦንቾ አዋይ፥ ፆሳ ህንተ አድ ኤራናዳ ጭንጫተነ ቆንጨ አያና ህንተዉ እማናዳ ታኒ ፆሳ ዎሳይስ። <verse eid="EPH 1:17"/><verse number="18" style="v" sid="EPH 1:18"/>ፆሳይ ህንተና ፄግዳ ኡፋይሳይነ ጌሻት ላትያ ቦንቾ ላታይ አይ መላ ዳሮኮ ህንተ ኤራና መላ ፆሳይ ህንተ ዎዛና አይፍያ ዶያና መላ ታኒ ፆሳ ዎሳይስ።<verse eid="EPH 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 1:19"/>ቃስ እያ አማንያ ኑናን ኦያ እያ ዎልቃይ አይ መላ አዳ ግቴኮ ህንተ ኤራና መላ ዎሳይስ። ሄ ዎልቃይ ፆነቶናነ ዳቡሮና ዎልቃ። ሀ ኑናን ደእድ ኦያ ዎልቃይነ፥ <verse eid="EPH 1:19"/><verse number="20" style="v" sid="EPH 1:20"/>ክርስቶሳ ሀይቆፐ ደንድ፥ ሳሎን ፆሳፈ ኡሻቻ ባጋራ ኡትስዳ ግታ ዎልቃይ እስኖ።<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ 110:1</ref>.</char></note> <verse eid="EPH 1:20"/><verse number="21" style="v" sid="EPH 1:21"/>እያ ሱንይ፥ አይሰይሳታፐነ ማታ አዋታፐ፥ ሃረይሳታፐነ ጎዳታፐ፥ ቦላ ግድድ ሀ አላምያ ፃላላን ግዶናሽን፥ ስንፈ ያና አላምያንካ ሀራ ሱንታ ኡባፈ ቃ። <verse eid="EPH 1:21"/><verse number="22" style="v" sid="EPH 1:22"/>ፆሳይ ኡባ ክርስቶሳ ቶሆፐ ጋርሳን ሃርስስ፤ ቃስ ዎሳ ኬን፥ ኡባባን ጎዳ ግዳና መላ እያ ሹምስ።<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="PSA 8:6">ማዝ 8:6</ref>፤ <ref loc="COL 1:22-23">ቆላ 1:22-23</ref>፤ <ref loc="COL 1:18">1:18</ref>.</char></note> <verse eid="EPH 1:22"/><verse number="23" style="v" sid="EPH 1:23"/>ዎሳ ኬ ክርስቶሳ ኩመ ኦያ እያ አሳተ። መተይ ደእያ በሳ ኡባን ክርስቶስ ባ ሁጰን ኡባባ ኩንይሳ።<verse eid="EPH 1:23"/></para>
  <chapter eid="EPH 1"/>
  <chapter number="2" style="c" sid="EPH 2"/>
  <para style="s1">ክርስቶሳን ሀይቆፐ ደኦ ፕነ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1"/>ሀይሳፈ ካሰ ህንተ፥ ህንተ ናጋራነ ህንተ ቆሁዋ ጋሶን ሀይቅዳይሳታ።<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="COL 2:13">ቆላ 2:13</ref>.</char></note> <verse eid="EPH 2:1"/><verse number="2" style="v" sid="EPH 2:2"/>ሄ ዎደ ህንተ ሀ አላምያ ኢታ ኦግያ ካልደታ። ጫርኩዋ ቦላ ደእያ አያና ዎልቃታ ሀላቃስነ ሀእካ ፆሳስ ኪተቶና አሳ ሃርያ አያናስ ኪተትደታ። <verse eid="EPH 2:2"/><verse number="3" style="v" sid="EPH 2:3"/>ኑ ኡባይካ ካሰ ሄ አሳታ ግዶን ኑ አሾ አሙዋነ ኑ ዎዛና ሸንያ ካልድ ደእዳ። ኑካ ሀራታ መላ ኑ መተን ፆሳ ሀንቁዋ ኤካናዉ ደኤይሳታ።<verse eid="EPH 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4"/>ሽን ፆሳ ግታ ማሮተፈነ ኑስ ደእያ ግታ ሲቁዋፐ ደንድዳይሳን፥ <verse eid="EPH 2:4"/><verse number="5" style="v" sid="EPH 2:5"/>ሀር አቶሽን ኑኒ ኑ ቆሁዋን ሀይቅድ ደእሽን ክርስቶሳ ባጋራ ኑስ ደኦ እሚስ። ህንተካ አትዳይ ፆሳ አ ኬሀተና። <verse eid="EPH 2:5"/><verse number="6" style="v" sid="EPH 2:6"/>ፆሳይ ኑና ክርስቶሳራ እስፈ ሀይቆፐ ደንድ ሳሎን እያራ እስፈ ዎስ። <verse eid="EPH 2:6"/><verse number="7" style="v" sid="EPH 2:7"/>እ ሄሳ ኦዳይ፥ ክርስቶስ የሱሳ ባጋራ ኑስ ቆንጭስዳ ባ ኬሀተነ ዛው ባይና ባ አ ኬሀተ ዱረተ ያና ላይን ኑና በሳናሳ። <verse eid="EPH 2:7"/><verse number="8" style="v" sid="EPH 2:8"/>ህንተ አ ኬሀተን አማኖን አትደታ። ሄስካ፥ ፆሳ እሞታፐ አትሽን፥ ህንተ ኦሶን በንትዳባ ግደና። <verse eid="EPH 2:8"/><verse number="9" style="v" sid="EPH 2:9"/>ኦንካ ጬቀቶና መላ አቶተይ በንትዳይ ኦሶን ግደና። <verse eid="EPH 2:9"/><verse number="10" style="v" sid="EPH 2:10"/>ኑኒ ፆሳ መተ፤ እ ኑስ ካሰትድ ጊግስ ዎዳ ሎኦ ኦሶታ ኦና መላ ክርስቶስ የሱሳ ባጋራ ኦራ መትዳ።<verse eid="EPH 2:10"/></para>
  <para style="s1">ክርስቶሳራ ደእያ እስፈተ</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11"/>ሄሳ ግሾ፥ ህንተኖ የለታን አይሁደ ግዶናይሳቶ፥ አይሁደት ባንታዉ አሳ ኩሸን ቃፃረትድ፥ ህንተና ቃስ ቃፃረትቦናይሳታ ግድ ፄገይሳ አኬክተ። <verse eid="EPH 2:11"/><verse number="12" style="v" sid="EPH 2:12"/>ሄ ዎደ ህንተ ክርስቶሳፐ ሻከት ደእዳይሳ፥ እስራኤለ አሳስ አላጋ ግድድ ደእዳይሳ፥ ፆሳ ኡፋይሳ ቃላፐ ሃክድ ደእዳይሳነ ሀ አላምያን ኡፋይስነ ፆሲ ባይና ደእዳይሳ አኬክተ። <verse eid="EPH 2:12"/><verse number="13" style="v" sid="EPH 2:13"/>ሽን ህንተ ካሰ ሃክድ ደእዳይሳት፥ ሀእ ክርስቶስ የሱሳን ደእድ ክርስቶሳ ሱን ማታ ሺቅደታ።<verse eid="EPH 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14"/>ክርስቶስ ኑ ሳሮተ፤ እ አይሁደነ አይሁደ ግዶና አሳ ትምድ፥ ናምኣ ሻክ ዎዳ ሞርከተ ጎዳ ላልስ። <verse eid="EPH 2:14"/><verse number="15" style="v" sid="EPH 2:15"/>እ ባናን ሀ ናምኡ ኮቻታፐ እስ ኦራ አሰ መድ፥ ህግያ እያ ኪታራነ ዎጋታራ እስፈ ባ አሳተን ይስድ ሳሮተ እሚስ።<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="COL 2:14">ቆላ 2:14</ref>.</char></note> <verse eid="EPH 2:15"/><verse number="16" style="v" sid="EPH 2:16"/>ክርስቶስ ማስቃልያ ቦላ ሀይቅድ ሞርከተ ይስስ፤ ቃስ ናምኡ ኮቻታ እስ አሳተ ኦድ ፆሳራ ስገስ።<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="COL 1:20">ቆላ 1:20</ref>.</char></note> <verse eid="EPH 2:16"/><verse number="17" style="v" sid="EPH 2:17"/>ክርስቶስ ይድ፥ ፆሳፈ ሃክድ ደእያ ህንተዉ፥ ቃስ ማትድ ደእያ ኤንታዉ ሳሮተ ዎንገላ ኦድስ።<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="ISA 57:19">እሳ 57:19</ref>.</char></note> <verse eid="EPH 2:17"/><verse number="18" style="v" sid="EPH 2:18"/>ኑ ኡባይ እያ ባጋራ እስ አያናን አዋ ስን ሺቃናዉ ዳንዳኦስ።<verse eid="EPH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19"/>ህዛፐ ህንተ አላጋ ዎይኮ እማ ግደከታ፥ ሽን ህንተ ሀእ ጌሻታ ቢታ አስነ ፆሳ ሶ አስ። <verse eid="EPH 2:19"/><verse number="20" style="v" sid="EPH 2:20"/>ህንተ ሀዋረትነ ናበት ባስዳ ባሱዋ ቦላ ኬፀትደታ። ጎዳ ፃጱዋ ምንያ ሹቻይ ክርስቶስ የሱሳ። <verse eid="EPH 2:20"/><verse number="21" style="v" sid="EPH 2:21"/>እያን ኬ ኡባይ እስፈ ኦይከትድ ጎዳን ጌሻ ፆሳ ኬ ግዳናዉ ድጬስ። <verse eid="EPH 2:21"/><verse number="22" style="v" sid="EPH 2:22"/>ህንተ ቃስ ፆሳይ ባ አያናን ደእያ ኬ ግዳናዉ ክርስቶሳን እስፈ ኬፀተታ።<verse eid="EPH 2:22"/></para>
  <chapter eid="EPH 2"/>
  <chapter number="3" style="c" sid="EPH 3"/>
  <para style="s1">አይሁደ ግዶና አሳስ ሀዋረ ግድዳ ጳዉሎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1"/>ሄሳ ግሾ፥ ታኒ፥ ጳዉሎስ፥ አይሁደ ግዶና ህንተ ግሾ ክርስቶስ የሱሳን ቃሾ አስ ግዳስ። <verse eid="EPH 3:1"/><verse number="2" style="v" sid="EPH 3:2"/>ታ ህንተና ማዳና መላ ፆሳይ ባ አ ኬሀተን ታዉ እምዳ ሀ ኦሱዋባ ህንተ ሎይ ስእደታ። <verse eid="EPH 3:2"/><verse number="3" style="v" sid="EPH 3:3"/>ታ ህንተዉ ካሰ ቃንን ፃፍዳይሳዳ ፆሳይ ባ ፁራ ቆንጨን ታዉ ቆንጭስስ። <verse eid="EPH 3:3"/><verse number="4" style="v" sid="EPH 3:4"/>ታ ፃፍዳይሳ ህንተ ናባብያ ዎደ ክርስቶሳ ፁራ ታ አይ መላ ኤርዳኮ ህንተ አኬካናዉ ዳንዳኤታ።<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="COL 1:26-27">ቆላ 1:26-27</ref>.</char></note> <verse eid="EPH 3:4"/><verse number="5" style="v" sid="EPH 3:5"/>ሀ ፁራይ ጌሻ ሀዋረታስነ ናበታስ ሀእ አያና ባጋራ ቆንጭዳይሳዳ በን ዎደ አሳስ ሄሳዳ ቆንጭስቤና። <verse eid="EPH 3:5"/><verse number="6" style="v" sid="EPH 3:6"/>ፁራይ ሀይሳ: አይሁደ ግዶና አሳይ ዎንገላ ባጋራ እስራኤለታራ እስፈ ፆሳ አንጁዋ ላቶሶና። እስራኤለታራ እስ ኬ አስ ግዶሶና፤ ክርስቶስ የሱሳ ባጋራ ፆሳ ኡፋይሳ ቃላ ኤኮሶና።<verse eid="EPH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7"/>ፆሳይ ባ ኦያ ዎልቃ ባጋራ ታዉ እምዳ አ ኬሀተን ሀ ዎንገላስ ኦሳንቾ ግዳስ። <verse eid="EPH 3:7"/><verse number="8" style="v" sid="EPH 3:8"/>ታኒ ጌሻታ ኡባፈ ላፋ ግድኮካ አይሁደ ግዶና አሳስ ዛው ባይና ክርስቶሳ ዱረተ ዎንገላ ኦዳና መላ ሀ አ ኬሀተይ ታዉ እመትስ። <verse eid="EPH 3:8"/><verse number="9" style="v" sid="EPH 3:9"/>ቃስ ካሰ ዎድያን ኡባ መዳ ፆሳን ቆሰትድ ደእያ ፁራስ፥ ፆሳ ቆፋይ አይበኮ ቆንጭሳናዉ አ ኬሀተይ ታዉ እመትስ። <verse eid="EPH 3:9"/><verse number="10" style="v" sid="EPH 3:10"/>ፆሳይ ሄሳ ኦዳይ ሀእ ዎድያን ዎሳ ኬ ባጋራ ሳሎን ደእያ ሀላቃታስነ ሃረይሳታስ ባ ዱማ ዱማ ቆንጨ ኤርሳናሳ። <verse eid="EPH 3:10"/><verse number="11" style="v" sid="EPH 3:11"/>ፆሳይ ባ መርና ቆፋ ኑ ጎዳ ክርስቶስ የሱሳ ባጋራ ፖላናዉ ሄሳ ኦስ። <verse eid="EPH 3:11"/><verse number="12" style="v" sid="EPH 3:12"/>ኑ አማኖን ያሽ ባይና ፆሳኮ ሺቃና መላ ክርስቶስ ኑስ ምኖተነ ላአተ እሚስ።<verse eid="EPH 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 3:13"/>ታኒ ህንተ ግሾ ዋየ ኤክያ ግሾ፥ ህንተ ታ ዋያን ዬላቶናዳ ህንተና ዎሳይስ፤ ታኒ ህንተ ቦንቹዋስ ዋየታይስ።<verse eid="EPH 3:13"/></para>
  <para style="s1">ኤፈሶና አሳስ ዎሰትዳ ዎሳ</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14"/>ታኒ አዋ ስንን ጉልባታዳ ዎሰይ ሄሳ ግሾሳ። <verse eid="EPH 3:14"/><verse number="15" style="v" sid="EPH 3:15"/>ሳሎንነ ሳአን ደእያ እስ እስ ሶ አሳይ እያን ሱንቴስ። <verse eid="EPH 3:15"/><verse number="16" style="v" sid="EPH 3:16"/>ፆሳይ ባ ቦንቾ ዱረተፈ ህንተ ጋርሳ አሳተ ምንያ ዎልቃ ባ አያና ባጋራ እማና መላ ህንተዉ ዎሳይስ። <verse eid="EPH 3:16"/><verse number="17" style="v" sid="EPH 3:17"/>ቃስ አማኖን ክርስቶስ ህንተ ዎዛናን ዳና መላነ ህንተ ሲቆን ፃጶ የድድ ምንድ ዳና መላ ዎሳይስ። <verse eid="EPH 3:17"/><verse number="18" style="v" sid="EPH 3:18"/>ሄሳዳካ፥ ክርስቶሳ ሲቆይ አይ መላ ዳልገኮ፥ አዱሰኮ፥ ቀኮነ ጪሞኮ ጌሻታ ኡባራ፥ ህንተ አኬካና ዎልቃ ደማና መላ ዎሳይስ። <verse eid="EPH 3:18"/><verse number="19" style="v" sid="EPH 3:19"/>ኤራተፈ አያ ክርስቶሳ ሲቁዋ ህንተ ኤራና መላ ቃስ ደኦ እምያ ፆሳ ዎልቃን ህንተ ኩማና መላ ታ ዎሳይስ።<verse eid="EPH 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20"/>ህዛ፥ ኑ ግዶን ኦያ ባ ዎልቃ ባጋራ ኑኒ ዎሰይሳፈ ዎይኮ ቆፐይሳፈ አድ ኦናዉ ዳንዳእያ ፆሳስ፥ <verse eid="EPH 3:20"/><verse number="21" style="v" sid="EPH 3:21"/>ዎሳ ኬንነ ክርስቶስ የሱሳን ዎደ ኡባን መርናፐ መርና ጋካናዉ ቦንቾይ ግዶ። አምንእ።<verse eid="EPH 3:21"/></para>
  <chapter eid="EPH 3"/>
  <chapter number="4" style="c" sid="EPH 4"/>
  <para style="s1">ኑኒ ክርስቶሳን እስኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1"/>ህዛ፥ ጎዳ ግሾ ቃሸትዳ ታኒ፥ ህንተ ፄገትዳ ፄሳስ በሲያ ደኦ ዳና መላ ህንተና ዎሳይስ። <verse eid="EPH 4:1"/><verse number="2" style="v" sid="EPH 4:2"/>ህንተ ኡባ ዎደ አዳታነ ሀዮ ግድተ፤ እሶይ እሱዋ ዳንዳእተነ ሲቆን ደእተ።<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="COL 3:12-13">ቆላ 3:12-13</ref>.</char></note> <verse eid="EPH 4:2"/><verse number="3" style="v" sid="EPH 4:3"/>ሳሮተን ቃሸትድ አያናይ እምያ እስፈተ ናጋናዉ ምንተ። <verse eid="EPH 4:3"/><verse number="4" style="v" sid="EPH 4:4"/>ፆሳይ ህንተና ፄግዳ ዎደ እስ ኡፋይሳስ ፄግዳይሳዳ እስ አሳተነ እስ አያን ደኤስ። <verse eid="EPH 4:4"/><verse number="5" style="v" sid="EPH 4:5"/>እስ ጎዳይ፥ እስ አማኖይነ እስ ፅንቃተይ ደኤስ። <verse eid="EPH 4:5"/><verse number="6" style="v" sid="EPH 4:6"/>ኡባፈ ቦላ ግድዳ፥ ኡባ ባጋራ ኦያነ ኡባ ግዶን ደእያ እስ ፆሳይ፥ ኡባ አዋይ ደኤስ።<verse eid="EPH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7"/>ሽን ክርስቶስ እማናዉ ኮይዳይሳዳ ኑ እሶይ እሶይ ዱማ ዱማ እሞታ ኤክዳ። <verse eid="EPH 4:7"/><verse number="8" style="v" sid="EPH 4:8"/>ሄሳ ግሾ፥ ፆሳ ቃላይ፥</para>
  <para style="q1" vid="EPH 4:8">“እ ፑደ ከይዳ ዎደ</para>
  <para style="q2" vid="EPH 4:8">ድኤትዳ ዳሮታ ባራ ኤክድ ብስ፤</para>
  <para style="q2" vid="EPH 4:8">አሳስካ እሞታ እሚስ”</para>
  <para style="m" vid="EPH 4:8">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PSA 68:18">ማዝ 68:18</ref>.</char></note> <verse eid="EPH 4:8"/><verse number="9" style="v" sid="EPH 4:9"/>ያትን፥ “ፑደ ከይስ” ጉሳይ ዎይ ጉሴ? እ ኮይሮ ዱገ፥ ሳኣ ዝቃ በሳ ዎስ ጉሱ ግዶና እፅኮ አይ ጉሴ? <verse eid="EPH 4:9"/><verse number="10" style="v" sid="EPH 4:10"/>ሀ ዱገ ዎዳይስ፥ ኡባ በሳን በንታናዉ ኡባፈ ቃ ሳሉዋ ከይዳይስ እያ።<verse eid="EPH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 4:11"/>እ እሶታ እሶታ ሀዋረታ፥ እሶታ እሶታ ናበታ፥ እሶታ እሶታ ዎንገላ ሳባከታ፥ እሶታ እሶታ ዎሳ ኬ ሄመይሳታ፥ እሶታ እሶታ አስታማረታ ኦድ እሚስ። <verse eid="EPH 4:11"/><verse number="12" style="v" sid="EPH 4:12"/>እ ሄሳ ኦዳይ ክርስቶሳ አሳተ ግድዳ ዎሳ ኬ ድቻናዉነ አማንያ አሳ ፆሳ ኦሶስ ጊግሳናሳ። <verse eid="EPH 4:12"/><verse number="13" style="v" sid="EPH 4:13"/>ሄሳዳካ፥ ኑ ኡባይ ፆሳ ናኣ ኤርድ አማኖን በንትያ እስፈተኮ ጋክድ፥ ክርስቶሳ አያና ደኡዋ ኩመ ጋክድ ድጫና መላሳ።<verse eid="EPH 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14"/>ህዛፐ ጉየ፥ አሳ ገነ ጭሞን ጊግዳ ባለያ ዎርዶ ትምርተ ጫርኮንነ ሆበን ገደነ ሃ ኩሎ ካእያ ናይታ መላ ግዳናዉ በሰና። <verse eid="EPH 4:14"/><verse number="15" style="v" sid="EPH 4:15"/>ሽን ኑኒ ቱማ ሲቆን ኦድሸ፥ አሳተስ ሁጰ ግድያ ክርስቶሳራ ደእያ እስፈተ ጉጅ ጉጅ ድቾስ። <verse eid="EPH 4:15"/><verse number="16" style="v" sid="EPH 4:16"/>ኩመ አሳተይ ክርስቶሳ ቦላ ዘምፔስ ቃስ ዱማ ዱማ አሳተ ብልተት እሶይ እሱዋራ ኦይከትድ ኡትስ። እስ እስ አሳተ ክፍለይ ባ ኦሱዋ ኦያ ዎደ ኩመ አሳተይ ሲቆን ድጬስ።<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="COL 2:19">ቆላ 2:19</ref>.</char></note><verse eid="EPH 4:16"/></para>
  <para style="s1">ጋልአ ደኦነ ኦራ ደኦ</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17"/>ሄሳ ግሾ፥ ታኒ ሀይሳ ህንተዉ ጎዳ ሱንን ኦዳይስነ ማርካታይስ። ጎእ ባይና ቆፋ ቆፕያ አይሁደ ግዶና አሳታዳ ደኦፕተ። <verse eid="EPH 4:17"/><verse number="18" style="v" sid="EPH 4:18"/>ኤንታ ቆፋይ ምስ፤ ባንታ ዎዛና ሙምስዶሶና። ኤንቲ ኤራተ ዮንነ እፃስ ግድ ፆሳይ እምያ ደኡዋፐ ሃክዶሶና። <verse eid="EPH 4:18"/><verse number="19" style="v" sid="EPH 4:19"/>ኤንቲ ዬላ ግያባ ኤሮኮና፤ ኤንቲ ላይማተስ ባንታና አድ እምዶሶና፤ ቃስ ቱናባ ኡባ ጉየ ጎና ኦሶና።<verse eid="EPH 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20"/>ሽን ህንተ ክርስቶሳ ኤርዳይ ሄሳ መላ ኦገን ግደና። <verse eid="EPH 4:20"/><verse number="21" style="v" sid="EPH 4:21"/>እያባ ቱማ ስእደታ። ቃስ የሱሳን ደእያ ቱማ መላ እያፐ ታማርደታ። <verse eid="EPH 4:21"/><verse number="22" style="v" sid="EPH 4:22"/>ህንተ ካሰ ደእዳ ደኦ ኦግያ አግተ። ቃስ ባ ጭምያ አሞን ይያ ህንተ ጬጋ አሳተ ድግተ።<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="COL 3:9">ቆላ 3:9</ref>.</char></note> <verse eid="EPH 4:22"/><verse number="23" style="v" sid="EPH 4:23"/>ህንተ ዎዛና ቆፋን ኦራፅተ። <verse eid="EPH 4:23"/><verse number="24" style="v" sid="EPH 4:24"/>ቱማ ፅሎተንነ ጌሻተን ፆሳ ሌምሶን መትዳ ኦራ አሳተ ማእተ።<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="GEN 1:26">መ 1:26</ref>፤ <ref loc="COL 3:10">ቆላ 3:10</ref>.</char></note><verse eid="EPH 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25"/>ህዛ፥ ዎርዶ ኦደቶፍተ። ኑኒ ኡባይ ክርስቶሳ አሳተ ብልተታ ግድያ ግሾ አሳ ኡባራ ቱማ ኦደትተ።<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="ZEC 8:16">ዛካ 8:16</ref>.</char></note> <verse eid="EPH 4:25"/><verse number="26" style="v" sid="EPH 4:26"/>ሀንቀትተ፥ ሽን ህንተ ሀንቁዋን ናጋራ ኦፍተ። ህንተ ሀንቀት ደእሽን አው ዉሎፎ።<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="PSA 4:4">ማዝ 4:4</ref>.</char></note> <verse eid="EPH 4:26"/><verse number="27" style="v" sid="EPH 4:27"/>ፃላሄስ በሰ እሞፍተ። <verse eid="EPH 4:27"/><verse number="28" style="v" sid="EPH 4:28"/>ካይሶትያ ኡራይ ህዛፐ ጉየ ካይሶቶፖ። ሽን ማንቆታ ማድያባይ እያዉ ዳና መላ ባ ኩሸን ሎኦባ ኦ።<verse eid="EPH 4:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29"/>ህንተ ዶናፐ ኢታ ቃል ከዮፖ። ሽን ስኤይሳታ ጎአና መላነ ሀራታ ምንያ ኮሽያ ሎኦ ቃል ህንተ ዶናፐ ከዮ። <verse eid="EPH 4:29"/><verse number="30" style="v" sid="EPH 4:30"/>ፆሳይ ህንተና ዎዝያ ጋላሳስ ህንተና አታምድ ዎዳ ፆሳ አያና አዛንፍተ። <verse eid="EPH 4:30"/><verse number="31" style="v" sid="EPH 4:31"/>ጫመተ፥ ይሎ፥ ሀንቆ፥ ዋሶ፥ ጫሸነ ኢታ ኡባ ህንተፈ ሃስተ። <verse eid="EPH 4:31"/><verse number="32" style="v" sid="EPH 4:32"/>አድ እሶይ እሱዋስ ኬሀነ ቃተይሳታ ግድተ። ፆሳይ ክርስቶሳ ባጋራ ህንተዉ አቶ ግዳይሳዳ ህንተካ ዎልስ አቶ ጊተ።<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="COL 3:13">ቆላ 3:13</ref>.</char></note><verse eid="EPH 4:32"/></para>
  <para style="b"/>
  <chapter eid="EPH 4"/>
  <chapter number="5" style="c" sid="EPH 5"/>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1"/>ህዛ፥ ፆሳይ ዶስያ ናይታዳ እያ ዳንተ። <verse eid="EPH 5:1"/><verse number="2" style="v" sid="EPH 5:2"/>ክርስቶስ ኑና ዶስድ ባና ኑ ግሾ ፆሳስ ሳውያ እሞነ ያርሾ ኦድ እምዳይሳዳ ህንተካ ሲቆን ደእተ።<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="EXO 29:18">ከሳ 29:18</ref>፤ <ref loc="PSA 40:6">ማዝ 40:6</ref>.</char></note><verse eid="EPH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3"/>ሽን ላይማተ፥ ቱናተነ ኡዘተ አማንያ አሳስ በሶና ግሾ ህንተ ግዶን ኡባራካ ስኤቶፎ። <verse eid="EPH 5:3"/><verse number="4" style="v" sid="EPH 5:4"/>ፆሳ ጋላትተፐ አትሽን፥ ዬላያባይነ ኤያ ኦድ ዎይኮ ቅይ ህንተዉ በሶና ግሾ ህንተ ግዶን ኡባካ ደኦፖ። <verse eid="EPH 5:4"/><verse number="5" style="v" sid="EPH 5:5"/>ሀይሳ ኤርተ፤ ኦንካ ላይማተይ ዎይኮ ቱናባ ኦይ ዎይኮ ኡዘተይ ክርስቶሳ ካዎተነ ፆሳ ካዎተ ላታናዉ ዳንዳኤና። ኡዘተ ኤቃ ጎይኖ መላ።<verse eid="EPH 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6"/>ሀይሳታ ጋሶን ፆሳ ሀንቆይ ኪተቶና አሳ ቦላ ያና ግሾ ኦንካ ህንተና ፓና ኦዳን ጭሞፎ። <verse eid="EPH 5:6"/><verse number="7" style="v" sid="EPH 5:7"/>ሄሳ መላ አሳራ እስፈተ ኦፍተ። <verse eid="EPH 5:7"/><verse number="8" style="v" sid="EPH 5:8"/>ካሰ ህንተ ማን ደእደታ፥ ሽን ሀእ ጎዳ ባጋራ ፖኦን ደኤታ። ህዛ፥ ፖኦ አሳዳ ፖኦን ስመረትተ። <verse eid="EPH 5:8"/><verse number="9" style="v" sid="EPH 5:9"/>ፖኦይ ሎኦተ፥ ፅሎተነ ቱማተ አይፌስ።<verse eid="EPH 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 5:10"/>ጎዳ ኡፋይስያባ ኦናዉ ኮይተ። <verse eid="EPH 5:10"/><verse number="11" style="v" sid="EPH 5:11"/>ጎእ ባይና ማ ኦሶ ቆንጭስተፐ አትሽን፥ እያራ እስፎፕተ። <verse eid="EPH 5:11"/><verse number="12" style="v" sid="EPH 5:12"/>ኤንቲ ጌማን ኦያ ኦሱዋ ሀር አቶሽን ኦዳናዉካ ዬላዬስ። <verse eid="EPH 5:12"/><verse number="13" style="v" sid="EPH 5:13"/>ሽን ኡባባይ ፖኦን ከይያ ዎደ ቆንጨን በንቴስ። <verse eid="EPH 5:13"/><verse number="14" style="v" sid="EPH 5:14"/>ፖኦይ ኡባባ ቆንጨን በሴስ። ሄሳ ግሾ፥</para>
  <para style="q1" vid="EPH 5:14">“ነኖ ስከይሶ ባርካ፤</para>
  <para style="q2" vid="EPH 5:14">ሀይቆፐ ደንዳ፤</para>
  <para style="q1" vid="EPH 5:14">ክርስቶስ ነ ቦላ ፖአና” ያገትስ።<verse eid="EPH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15"/>ህዛ፥ ህንተ ዋንድ ደእያኮ አኬክ በእተ። ጭንጫታ ግድተፐ አትሽን፥ ኤያታ ግዶፕተ። <verse eid="EPH 5:15"/><verse number="16" style="v" sid="EPH 5:16"/>ላይይ ኢታ ግድያ ግሾ እንጀትያ ዎደ ኡባ ጎኤትተ።<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="COL 4:5">ቆላ 4:5</ref>.</char></note> <verse eid="EPH 5:16"/><verse number="17" style="v" sid="EPH 5:17"/>ሄሳ ግሾ፥ ጎዳ ሸነይ አይበኮ አኬክተፐ አትሽን፥ ኤዮፕተ።<verse eid="EPH 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18"/>ጌሻ አያናን ጋላስ ጋላስ ኩምተፐ አትሽን፥ ዮኮ ህንተና ካለያ ግሾ ዎይነ ኡሻን ማቶፍተ። <verse eid="EPH 5:18"/><verse number="19" style="v" sid="EPH 5:19"/>ማዝሙረን፥ ሳባንነ አያና የን፥ እሶይ እሱዋራ ኦደትተ። ቃስ ህንተ ዎዛናን የፅሸነ ሳቢሸ ጎዳ ጋላትተ።<note caller="-" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="COL 3:16-17">ቆላ 3:16-17</ref>.</char></note> <verse eid="EPH 5:19"/><verse number="20" style="v" sid="EPH 5:20"/>ኑ ጎዳ የሱስ ክርስቶሳ ሱንን ኡባ ዎደ ፆሳ አዋ ኡባባስ ጋላትተ።<verse eid="EPH 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21"/>ክርስቶሳ ቦንቹዋስ ግድ እሶይ እሱዋስ ሃረትተ።<verse eid="EPH 5:21"/></para>
  <para style="s1">አዝናባነ ማችባ</para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22"/>ማቸቶ፥ ጎዳስ ሃረተይሳዳ ህንተ አዝናታስ ሃረትተ።<note caller="-" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="COL 3:18">ቆላ 3:18</ref>፤ <ref loc="1PE 3:1">1 ጰፅ 3:1</ref>.</char></note> <verse eid="EPH 5:22"/><verse number="23" style="v" sid="EPH 5:23"/>ክርስቶስ ዎሳ ኬስ ሁጰ ግደይሳዳ አዝንካ ባ ማቼስ ሁጰ። ቃስ ክርስቶስ ባ አሳተ ግድዳ ዎሳ ኬ አሸይሳ። <verse eid="EPH 5:23"/><verse number="24" style="v" sid="EPH 5:24"/>ሽን ዎሳ ኬይ ክርስቶሳስ ሃረተይሳዳ ማቸት ባንታ አዝናታስ ኡባባን ሃረታናዉ በሴስ።<verse eid="EPH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25"/>አዝናቶ፥ ክርስቶስ ዎሳ ኬ ዶስድ ባና እዉ እምዳይሳዳ ህንተካ ህንተ ማቸታ ዶስተ።<note caller="-" style="x"><char style="xo" closed="false">5:25 </char><char style="xt" closed="false"><ref loc="COL 3:19">ቆላ 3:19</ref>፤ <ref loc="1PE 3:7">1 ጰፅ 3:7</ref>.</char></note> <verse eid="EPH 5:25"/><verse number="26" style="v" sid="EPH 5:26"/>እ ዎሳ ኬ ባ ቃላ ባጋራ ሃን ሜጭድ ጌሽስ። <verse eid="EPH 5:26"/><verse number="27" style="v" sid="EPH 5:27"/>ክርስቶስ ዎሳ ኬ ቅት ዎይኮ ሶምኦ ቱስ ዎይኮ ሄሳ መላባይ ባይና እ ኩመ ቦንቹዋራ ጌሽነ ቦረቶናሮ ኦድ ባኮ ሺሻናዉ ኮይድ ሄሳ ኦስ። <verse eid="EPH 5:27"/><verse number="28" style="v" sid="EPH 5:28"/>ሄሳዳካ፥ አዝናት ባንታና ዶሰይሳዳ ባንታ ማቸታ ዶሳናዉ በሴስ። ባ ማችዉ ዶሰይስ ባና ዶሴስ። <verse eid="EPH 5:28"/><verse number="29" style="v" sid="EPH 5:29"/>ባና እፅያ አስ ኦንካ ባዋ፥ ሽን ክርስቶስ ዎሳ ኬስ ኦይሳዳ ባ አሳተ ሙዜስነ ናጌስ። <verse eid="EPH 5:29"/><verse number="30" style="v" sid="EPH 5:30"/>ኑኒ ክርስቶሳ አሳተ ብልተታ።<verse eid="EPH 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 5:31"/>ፆሳ ቃላይ፥ “ሄሳ ግሾ፥ አስ ባ አዋነ ባ አይዉ አግድ፥ ባ ማቸራ እስፈ ዳና፤ ኤንቲ ናምአይካ እስ አሾ ግዳና” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መ 2:24</ref>.</char></note> <verse eid="EPH 5:31"/><verse number="32" style="v" sid="EPH 5:32"/>ሀይስ ግታ ፁራ፥ ሽን ታኒ ሄሳ ክርስቶሳባነ ዎሳ ኬባ ሌምሶ ኦዳ ኦዳይስ። <verse eid="EPH 5:32"/><verse number="33" style="v" sid="EPH 5:33"/>ግዶሽን፥ ህንተ እሶይ እሶይ ህንተ ማቸታ ህንተ፥ ህንተና ዶሰይሳዳ ዶስተ። እስ እስ ማቻ ባ አዝና ቦንቻናዉ በሴስ።<verse eid="EPH 5:33"/></para>
  <chapter eid="EPH 5"/>
  <chapter number="6" style="c" sid="EPH 6"/>
  <para style="s1">ናይታነ ኤንታ የልዳይሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1"/>ናይቶ፥ ህንተ ጎዳባ ግድያ ግሾ ህንተና የልዳይሳታስ ኪተትተ። ሄስ ህንተዉ በሲያባ።<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="COL 3:20">ቆላ 3:20</ref>.</char></note> <verse eid="EPH 6:1"/><verse number="2" style="v" sid="EPH 6:2"/>“ነ አይዉነ ነ አዋ ቦንቻ።” ሄስ ኡፋይሳ ቃል ደእያ ኮይሮ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከሳ 20:12</ref>፤ <ref loc="DEU 5:16">ዛረ 5:16</ref>.</char></note> <verse eid="EPH 6:2"/><verse number="3" style="v" sid="EPH 6:3"/>“ነ ሄሳ ፖልያባ ግድኮ ኡባይ ነዉ እንጀታና፤ ነ ላይይ ሳአ ቦላ አዱቃና።”<verse eid="EPH 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4"/>አዋቶ፥ ህንተ ናይታ ጎዳ ቃላ ታማርሶንነ ኤንታ ካለሶን ድችተፐ አትሽን፥ ኤንታና ጫምሶፕተ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="COL 3:21">ቆላ 3:21</ref>.</char></note><verse eid="EPH 6:4"/></para>
  <para style="s1">ጎዳታነ አይለታ</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5"/>አይለቶ፥ ክርስቶሳስ ኪተተይሳዳ ህንተ ሳአ ጎዳታስ ያሻን፥ ቦንቾንነ ሱረ ዎዛናን ኪተትተ።<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="COL 3:22-25">ቆላ 3:22-25</ref>.</char></note> <verse eid="EPH 6:5"/><verse number="6" style="v" sid="EPH 6:6"/>ኤንታ ስንን ሳባ ደማናዉ ኤንቲ በእያ ዎደ ፃላላ ኦፍተ። ሽን ክርስቶሳ አይለታዳ ፆሳ ሸንያ ዎዛናፐ ፖልተ። <verse eid="EPH 6:6"/><verse number="7" style="v" sid="EPH 6:7"/>አሳስ ግዶናሽን፥ ጎዳስ ግድ ህንተ ኩመ ዎዛናፐ ኦተ። <verse eid="EPH 6:7"/><verse number="8" style="v" sid="EPH 6:8"/>አይለ ግድን ዎይኮ ጎዳ ግድን እሶይ እሶይ ባ ኦዳ ሎኦ ኦሱዋስ ጎዳፐ ዎይቶ ኤካናይሳ ኤሬታ።<verse eid="EPH 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9"/>ጎዳቶ፥ አሳ ሶምኦ በእድ ማዶና ጎዳይ፥ ሳሉዋን ደኤይሳ ኤሬታ። ሄሳ ግሾ፥ ህንተ አይለታ ማንደይሳ አግድ ኤንቲ ህንተዉ ቦንቾን ኪተተይሳ መላ ህንተ ኤንታዉ ሎኦባ ኦተ።<note caller="-" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="COL 4:1">ቆላ 4:1</ref>፤ <ref loc="DEU 10:17">ዛረ 10:17</ref>፤ <ref loc="COL 3:25">ቆላ 3:25</ref>.</char></note><verse eid="EPH 6:9"/></para>
  <para style="s1">ፆሳ ኦላ ሚሸ</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10"/>ዉርሰን፥ ጎዳንነ እያ ግታ ዎልቃን ምንተ። <verse eid="EPH 6:10"/><verse number="11" style="v" sid="EPH 6:11"/>ፃላሄ ጭሙዋ ኤቀታናዉ ዳንዳአና መላ ፆሳይ ህንተዉ እምዳ ኦላ ሚሽያ ኡባ ማእተ። <verse eid="EPH 6:11"/><verse number="12" style="v" sid="EPH 6:12"/>ኑ ኦላይ አሳራ ግዶናሽን፥ ሳሎን ደእያ ቱና አያና ኦላንቾታራ፥ ማታ አዋታራ፥ ሃረይሳታራነ ሀ ማ አላምያ ዎልቃታራ።<verse eid="EPH 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 6:13"/>ሄሳ ግሾ፥ ኢታ ጋላሳ ተቃናዉነ ኡባ ፖልድ፥ ምንድ ኤቃናዉ ህንተ ዳንዳአና መላ ፆሳ ኦላ ሚሸታ ኡባ ማእተ። <verse eid="EPH 6:13"/><verse number="14-15" style="v" sid="EPH 6:14-15"/>ቱማ ፄሳን ዳንጮዳ ዳንጭድ፥ ፅሎተ ፁሩረዳ ትራን ዎድ፥ ሳሮተ ዎንገላ ህንተ ቶሁዋን ጫማዳ አድ ምንድ ኤቅተ።<note caller="-" style="x"><char style="xo" closed="false">6:14-15 </char><char style="xt" closed="false"><ref loc="ISA 11:5">እሳ 11:5</ref>፤ <ref loc="ISA 59:17">እሳ 59:17</ref>፤ <ref loc="ISA 52:7">52:7</ref>.</char></note> <verse eid="EPH 6:14-15"/><verse number="16" style="v" sid="EPH 6:16"/>ሄ ኡባፈ አድ፥ ፃላሄይ የድያ ላፅያ ታማ ዶንገ ኡባ ቶይሳናዉ ዳንዳእያ አማኑዋ ኡባ ዎደ ጎንዳለዳ ኦይክተ። <verse eid="EPH 6:16"/><verse number="17" style="v" sid="EPH 6:17"/>ፆሳ አቶተ ብራታ ባርኔፃዳ ህንተ ሁጰን ዎተ፤ ቃስ ጌሻ አያና ማሻ እካ፥ ፆሳ ቃላ ኦይክተ።<note caller="-" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="ISA 59:17">እሳ 59:17</ref>.</char></note> <verse eid="EPH 6:17"/><verse number="18" style="v" sid="EPH 6:18"/>ዎሳ አጎፍተ፤ ሀራታስካ ጋናትተ፤ ኡባ ዎደ አያናን ዎስተ። ሄሳን፥ ጌሻታስ ሳለቶና ምንድ ኡባ ዎደ ዎስተ።<figure style="fig" alt="Roman soldier in armor" file="LB00196B.tif" size="col" ref="6:18">ሮመ ዎታዳረይ ኩመ ኦላ ሚሸ ማእድ</figure><verse eid="EPH 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 6:19"/>ታኒ ዎንገላ ፁራ ያሽ ባይና ቆንጭሳዳ ኦዳና መላ ፆሳይ ታዉ ቃላ እማና መላ ዎስተ። <verse eid="EPH 6:19"/><verse number="20" style="v" sid="EPH 6:20"/>ታኒ ሄሳ ኦናዉ ኪተታስ ሀእካ ቃሾን ደኤይ ሄ ዎንገላ ግሾሳ። ያንያ ግሾ፥ ታኒ ያሽ ባይና በሰይሳዳ ኦዳና መላ ታዉ ዎስተ።<verse eid="EPH 6:20"/></para>
  <para style="s1">ሳሮ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21"/>ታኒ ዋና ደእያኮነ አይ ኦያኮ ህንተ ኤራና መላ ኑ ሲቆ እሻይ፥ ጎዳ ኦሱዋን አማነትዳ ኦሳንቾይ፥ ትክቆስ፥ ታባ ኡባ ህንተዉ ኦዳና።<note caller="-" style="x"><char style="xo" closed="false">6:21 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሀዋ 20:4</ref>፤ <ref loc="2TI 4:12">2 ፅሞ 4:12</ref>፤ <ref loc="COL 4:7-8">ቆላ 4:7-8</ref>.</char></note> <verse eid="EPH 6:21"/><verse number="22" style="v" sid="EPH 6:22"/>ኑኒ ኡባይ ዋንድ ደእያኮ ህንተዉ ኦዳና መላነ ህንተና ምንና መላ ታኒ እያ ህንተኮ ኪታስ።<note caller="-" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="GEN 21:10">መ 21:10</ref>.</char></note><verse eid="EPH 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23"/>ፆሳ አዋፐ፥ ጎዳ የሱስ ክርስቶሳፐ ሳሮተይነ ሲቆይ አማኖራ እስፈ አማንያ ኡባስ ግዶ። <verse eid="EPH 6:23"/><verse number="24" style="v" sid="EPH 6:24"/>እርፆና ሲቆን ኑ ጎዳ የሱስ ክርስቶሳ ሲቅያ ኡባራ ፆሳ አ ኬሀተይ ግዶ።<verse eid="EPH 6:24"/></para>
  <chapter eid="EPH 6"/>
</usx>
