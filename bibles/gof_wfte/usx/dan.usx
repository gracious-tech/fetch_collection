<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ዳነላ ማፃፋ</para>
  <para style="toc1">ዳነላ ማፃፋ</para>
  <para style="toc3">ዳነ</para>
  <para style="toc2">ዳነላ</para>
  <para style="mt">ዳነላ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ዳነላ ጌተትያ ሱን ብርሸይ ፆሳይ ታዉ ዳይና ዎይኮ ታዉ ፕርደይሳ ጉሱ። ዳነል ባብሎነ ቢታን ኤረታናዉ ጋሶ ግድዳይ፥ እያ ሎኦ ካንዱዋ፥ ትንብተ እሞታ፥ ፆሳይ እያ ደኡዋን ኦዳ ኦሱዋ፥ ባ እመትዳ ማታን ኤህዳ ላምያነ ድቻ (<char style="xt"><ref loc="DAN 2:46-49">2:46-49</ref>፤ <ref loc="DAN 6:1-3">6:1-3</ref></char>)።</para>
  <para style="ip">ዳነል፥ ክ.የ.ስ. 605 ላይን ድኤትድ ባብሎነ ብዳ ኮይሮ አሳራ ደኤስ (<char style="xt"><ref loc="DAN 1:1-2">1:1-2</ref></char>)። ዳነል ካዋ ናቡካዳናፆራ ካዎ ጋን ኦና መላ ዶረትዳ ናአተታፐ እሱዋ። ዳነል ኢታ ካዎተታ ዎደ ኡባን ባ ፆሳስ አማነትድ ደእስ። ዳነላ ማፃፋን ኤረትዳ ታርከት፥ ላፅያ እቶነ ታማ፥ ጋሞ ኦላነ ጎዳ ቦላ ፃፈትዳ ፁፍያ። ዳነል አሙሆ በኦንነ አሙሆ ብለን ኤረትዳ አስ።</para>
  <para style="ip">ዳነላ ማፃፋይ ፃፈትዳ ዋና ጋሶት ናምአ። ሄሳትካ:-</para>
  <para style="ipi">1. አይሁደ ግዶና ደርያን ድኤትድ አይለ ግድድ አላጋ ቢታን ዱስ፣ እስራኤለ አሳስ ዉርሰ ቃዳ ግዶናይሳ አኬክስድ፥ ኤንታ ዛሪድ ምንናሳ።</para>
  <para style="ipi">2. ታርከ ግዶን ሀንዳ ትንብተ ቆንጨን፥ ፆሲ ካዎተታ ኡባ ቦላ ጎዳ ግደይሳነ እያ ካዎተይ ፆነይሳ ፆሳ ደርያ አኬክሳናሳ።</para>
  <para style="ip">ዳነላ ማፃፋይ ናምኡ ግታ ክፍለታን ሻከቴስ።</para>
  <para style="ipi">1. ዳነል ደእዳ ዎደ ሀንዳ ታርከታ ኦድያ ክፍልያ (ሸም 1-6)። ሄ ዎደ ደንድዳ ካዎተታነ ፆሳይ ዳነላነ እያ ላገታ ዋትድ አሽዳኮ ኦዴስ።</para>
  <para style="ipi">2. ዳነል በእዳ ዱማ ዱማ ቆንጨታ ኦድያ ክፍልያ (ሸም 7-12)። ሀ ክፍልያን ካዎተታ ደንዶይነ ኩንደይ ዱማ ዱማ ማላታንነ ሌምሶታን ቆንጭስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ዳነልነ እያ ላገት ካዎ ጋን (<char style="ior"><ref loc="DAN 1:1-21">1:1-21</ref></char>)</para>
  <para style="io1">ፆሲ ካዎተታ ኡባ ቦላ ጎዳ (<char style="ior"><ref loc="DAN 2:1-6:28">2:1—6:28</ref></char>)</para>
  <para style="io2">ናቡካዳናፆራ አሙሁዋ (<char style="ior"><ref loc="DAN 2:1-49">2:1-49</ref></char>)</para>
  <para style="io2">ዎርቃ ምስለነ ላፅያ እቶነ ታማ (<char style="ior"><ref loc="DAN 3:1-30">3:1-30</ref></char>)</para>
  <para style="io2">ናቡካዳናፆራ ጎየ (<char style="ior"><ref loc="DAN 4:1-37">4:1-37</ref></char>)</para>
  <para style="io2">ብልፃሶራነ ጎዳ ቦላ ፁፍያ (<char style="ior"><ref loc="DAN 5:1-31">5:1-31</ref></char>)</para>
  <para style="io2">ዳነል ጋሞፈ አትስ (<char style="ior"><ref loc="DAN 6:1-28">6:1-28</ref></char>)</para>
  <para style="io1">ዳነል በእዳ ቆንጨታ (<char style="ior"><ref loc="DAN 7:1-12:13">7:1—12:13</ref></char>)</para>
  <para style="io2">ኦይዱ ዶአታ ቆንጨ (<char style="ior"><ref loc="DAN 7:1-8:27">7:1—8:27</ref></char>)</para>
  <para style="io2">ዳነል ባ አሳስ ዎስዳ ዎሳ (<char style="ior"><ref loc="DAN 9:1-27">9:1-27</ref></char>)</para>
  <para style="io2">ፀግሮሳ ሻፋ ማታን በእዳ ቆንጨ (<char style="ior"><ref loc="DAN 10:1-12:13">10:1—12:13</ref></char>)</para>
  <chapter number="1" style="c" sid="DAN 1"/>
  <para style="s1">ዳነልነ እያ ላገት ባብሎነን</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1"/>ይሁዳ ካዎይ እዮአቄም ካዎትዳ ሄን ላይን ባብሎነ ካዎይ ናቡካዳናፆር የሩሳላመ ካታማ ቦላ ደንድ ካታማ ተቅስ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2 ካዎ 24:1</ref>፤ <ref loc="2CH 36:5-7">2 ታር 36:5-7</ref>.</char></note> <verse eid="DAN 1:1"/><verse number="2" style="v" sid="DAN 1:2"/>ጎዳይ ይሁዳ ካዋ እዮአከመነ ፆሳ ኬን ደእያ ሚሸታፐ ባጋ፥ እያ ኩሸን አድ እሚስ። እ ሄ ሚሸታ ሳናኦራ ቢታን ደእያ ባ ኤቃ ፆሳታ ኬ ኤፍድ፥ ሚሸ ምንጅያ ኬን ዎስ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2KI 20:17">2 ካዎ 20:17</ref>፤ <ref loc="2KI 24:10-16">24:10-16</ref>፤ <ref loc="2CH 36:10">2 ታር 36:10</ref>፤ <ref loc="ISA 39:7-8">እሳ 39:7-8</ref>.</char></note><verse eid="DAN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 1:3"/>ካዎይ፥ አስፋናዛ ጌተትያ ባ ኦሳንቾታ ሀላቃ ሀይሳዳ ያግድ ኪትስ፦ “እስራኤለ አሳ ግዶፈ ካዎ ኮቸ ግድዳይሳታነ ግታ አሳታ ኮቸ ግድዳይሳታ ዶራ። <verse eid="DAN 1:3"/><verse number="4" style="v" sid="DAN 1:4"/>ዶረታና ናአተት፥ ቦረይ ባይናይሳታ፥ ማላ ሎኦታ፥ ትምርተ ኤለስድ ኤካናዉ ዳንዳኤይሳታ፥ አኬካንቾታ፥ ኤራተ ኩምዳይሳታነ ካዎ ጋን ኦናዉ ዳንዳኤይሳታ ግዳናዉ በሴስ። ኤንታ ባብሎነ ዶናነ ፃፎ ታማርሳ” ያግስ። <verse eid="DAN 1:4"/><verse number="5" style="v" sid="DAN 1:5"/>ኤንቲ ማና ካነ ኡያና ዎይነ ኡሻ ካዋ ካፈነ ኡሻፈ ጋላስ ጋላስ እማና መላ ካዎይ ኪትስ። ሄ ላይ ሎህዳፐ ጉየ ካዋ ስን ሺቅድ ኦሶ ዶማና መላ ቆፋ ኩይስ።<verse eid="DAN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 1:6"/>ዶረትዳይሳታ ግዶፈ ይሁዳ ኮቸ ግድዳ ዳነላ፥ አናና፥ ምሳኤላነ አዛራ ጌተተይሳት ደኦሶና። <verse eid="DAN 1:6"/><verse number="7" style="v" sid="DAN 1:7"/>ካዋ ኦሳንቾታ ሀላቃይ ኤንታ ሱን ላምድ፥ ዳነላ ብልፃሶራ፥ አናና ስድራቃ፥ ምሳኤላ ምሳቃ፥ አዛራ አብዳናጎ ግድ ሱንስ።<verse eid="DAN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8"/>ዳነል ካዋ ካ ምድነ ዎይነ ኡሻ ኡይድ፥ ባና ቱንሶና መላ ባ ዎዛናን ቆፋ ቃችድ፥ ሄ ቆፋ ኤካናዳ፥ ካዋ ኦሳንቾታ ሀላቃ ዎስስ። <verse eid="DAN 1:8"/><verse number="9" style="v" sid="DAN 1:9"/>ፆሳይ፥ ኦሳንቾታ ሀላቃ ስንን ዳነላስ ሳባነ ቃ እሚስ። <verse eid="DAN 1:9"/><verse number="10" style="v" sid="DAN 1:10"/>ግዶሽን፥ ኦሳንቾታ ሀላቃይ ዳነላኮ፥ “ህንተዉ ሀ ካነ ኡሻ ኪትዳ ታ ጎዳ፥ ካዋ ያያይስ። ህንተ ላገ ግድዳ ናአተታ ሶምኡዋፈ ህንተ ሶምኦይ ግልቅድ በንትኮ፥ ህንተ ጋሶን ካዎይ ታና ዎና” ያግስ።<verse eid="DAN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 1:11"/>ኦሳንቾታ ሀላቃይ ሹምን ዳነላ፥ አናና፥ ምሳኤላነ አዛራ ናግያ አድያኮ፥ ዳነል ሀይሳዳ ያግስ፦ <verse eid="DAN 1:11"/><verse number="12" style="v" sid="DAN 1:12"/>“ማናዉ ኑስ አታክልተ፥ ኡያናዉ ሃ ፃላላ እማዳ፥ ኑና ነ አይለታ ታሙ ጋላስ ፓጫ። <verse eid="DAN 1:12"/><verse number="13" style="v" sid="DAN 1:13"/>ያታዳ፥ ኑ ሶምኡዋነ ካዎ ካ ምያ ናአተታ ሶምኡዋ ፄላዳ፥ ኑና ነ አይለታ ነዉ በንትዳይሳዳ ኦ” ያግስ።<verse eid="DAN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 1:14"/>እ፥ ሄሳ ኤክድ ታሙ ጋላስ ኤንታ ፓጭስ። <verse eid="DAN 1:14"/><verse number="15" style="v" sid="DAN 1:15"/>ታሙ ጋላሳፐ ጉየ፥ ካዋ ካ ምዳ ናአተታ ኡባፈ ኤንታ ሶምኦይ ጪይን፥ ሞድ በንትዶሶና። <verse eid="DAN 1:15"/><verse number="16" style="v" sid="DAN 1:16"/>እ፥ ኤንታዉ ጊግዳ ካነ ዎይነ ኡሻ ድግድ አታክልተ እሚስ።<verse eid="DAN 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17"/>ሀ ኦይዱ ናአተታስ ፆሳይ ኤራነ ኡባ ቆሞ ፁፈነ ትምርተ ኤክያ አኬካ እሚስ። ዳነል ቆንጨነ አሙሆ ብርሸ ኤሬስ።<verse eid="DAN 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18"/>ካዎይ፥ ናአተት ባኮ ገላናዳ ኪትዳ ዎደይ ጋክን፥ ኦሳንቾታ ሀላቃይ ኤንታ ናቡካዳናፆራ ስን ኤህስ። <verse eid="DAN 1:18"/><verse number="19" style="v" sid="DAN 1:19"/>ካዎይ፥ ኤንታ ኦድስያ ዎደ ዳነላ፥ አናና፥ ምሳኤላነ አዛራ መላ አስ ኤንታ ግዶን በንትቤና። ያትን፥ ኤንቲ ካዋስ ኦናዉ ገልዶሶና። <verse eid="DAN 1:19"/><verse number="20" style="v" sid="DAN 1:20"/>ካዎይ ኤንታ ኦይችዳ አይ ጭንጫተነ አኬካ ኦይሻን፥ እያ ካዎተን ደእያ ማሮታፐነ ብታንቾታፐ ኤንቲ ታሙ ኩሸ አድ በንትዶሶና። <verse eid="DAN 1:20"/><verse number="21" style="v" sid="DAN 1:21"/>ዳነል፥ ካዎይ ቅሮስ ካዎትዳ ኮይሮ ላይ ጋካናዉ ጋምእስ።<verse eid="DAN 1:21"/></para>
  <chapter eid="DAN 1"/>
  <chapter number="2" style="c" sid="DAN 2"/>
  <para style="s1">ናቡካዳናፆራ አሙሁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1"/>ናቡካዳናፆር ካዎትዳ ናምአን ላይን አሙሆ አሙህስ። ሄ አሙሆይ እያ ዳጋንን፥ ስኮይ እያ ኤኮና እፅስ። <verse eid="DAN 2:1"/><verse number="2" style="v" sid="DAN 2:2"/>ሄሳ ግሾ፥ እ አሙህዳ አሙሁዋ እያዉ ኦዳና መላ ማሮት፥ ብታንቾት፥ ሙሩነይሳትነ ፆልንቶ ታይበይሳት ያና መላ ካዎይ ኪትስ። ኤንቲ ይድ እያ ስንን ኤቅዶሶና። <verse eid="DAN 2:2"/><verse number="3" style="v" sid="DAN 2:3"/>ካዎይ ኤንታኮ፥ “ታና ዳጋንያ አሙሆ አሙሀስ፤ ሄ አሙሆይ አይበኮ ኤራናዉ ኮያይስ” ያግስ።<verse eid="DAN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 2:4"/>ፆልንቶ ታይበይሳት ሶረ ዶናን፥ “ካዋዉ፥ መርናዉ ካዎታ! ነ አሙሁዋ ኑስ ነ አይለታስ ኦዳ፤ ኑ ነዉ እያ ብርሸ ኦዳና” ያግዶሶና።<verse eid="DAN 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 2:5"/>ካዎይ ኤንታኮ፥ “ህንተ ሀ አሙሁዋነ እያ ብርሸ ታና ኤርሶና እፅኮ፥ ታ ህንተና ቃንፃና፤ ህንተ ኬይ ቡረ የግያ በሲ ግዳናይሳ ታ ህንተዉ ምንዳ ኦዳይስ። <verse eid="DAN 2:5"/><verse number="6" style="v" sid="DAN 2:6"/>ሽን ህንተ አሙሁዋነ እያ ብርሸ ታዉ ኦድኮ፥ እሞታ፥ ዎይቶነ ዳሮ ቦንቾ ታፐ ደማና። ሄሳ ግሾ፥ አነ አሙሁዋነ እያ ብርሸ ታና ኤርስተ” ያግስ።<verse eid="DAN 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7"/>ኤንቲ ዛሪድ፥ “ካዎይ አሙሁዋ ኑስ ባ አይለታስ ኦዶ፤ ኑ እያ ብርሸ ኤርሳና” ያግዶሶና።<verse eid="DAN 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8"/>ካዎይ ዛሪድ፥ “ታ ምኖ ቆፋ ህንተ ኤርያ ግሾ ዎደ አዱሳናዉ ህንተ ኮየይሳ ታ ኤራይስ። <verse eid="DAN 2:8"/><verse number="9" style="v" sid="DAN 2:9"/>ህንተ አሙሁዋ ታዉ ኦዶና እፅኮ፥ እስ ፕርድ ህንተና ናጌስ። ሀኖታይ ላመታና ግድ ህንተ ኡፋይስ ኦያ ግሾ ታዉ ዎርዶነ ገነ ቃላ ኦዳናዉ ማቀትደታ። ሄሳ ግሾ፥ አሙሁዋ ታዉ ኦድተ። ያትኮ፥ ህንተ እያ ብርሸ ኤርሳናዉ ዳንዳኤይሳ ታ ኤራና” ያግስ።<verse eid="DAN 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10"/>ፆልንቶ ታይበይሳት ዛሪድ፥ “ካዎይ ኦይችያ ኦይሻ ዛራናዉ ዳንዳእያ እስ አስካ ቢታን ባዋ። አይ ግታነ ዎልቃማ ካዎይ ማሮታ፥ ብታንቾታነ ፆልንቶ ታይበይሳታ ሄሳ መላባ ኦይችድ ኤረና። <verse eid="DAN 2:10"/><verse number="11" style="v" sid="DAN 2:11"/>ካዎይ ኦይችዳ ኦይሾይ ዴፆ፤ አሳ ግዶን ዶና ፆሳታፐ አትሽን፥ ሄሳ ካዋስ ቆንጭሳናዉ ዳንዳኤይ ባዋ” ያግዶሶና።<verse eid="DAN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12"/>ካዎይ ዳሮ ይሎትድ፥ ባብሎነን ደእያ ጭንጫታ ኡባ ዎናዳ ኪትስ። <verse eid="DAN 2:12"/><verse number="13" style="v" sid="DAN 2:13"/>ጭንጫታ ዎናዉ አዋጆይ ከይስ፤ ዳነላነ እያ ላገታ ዎናዉ አስ ኪተትስ።<verse eid="DAN 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14"/>ካዋ ናገይሳታ ሀላቃይ አርዮክ፥ ባብሎነን ደእያ ጭንጫታ ዎናዉ ከይያ ዎደ ዳነል እያ ጭንጫተንነ ሂላን ኦድስስ። <verse eid="DAN 2:14"/><verse number="15" style="v" sid="DAN 2:15"/>እ ካዋ ናገይሳታ ሀላቃ አርዮካ፥ “ካዎይ ሀይሳ መላ ኢታ አዋጆ አይስ ከስዴ?” ግድ ኦይችስ። አርዮክ ሀኖታ ዳነላስ ኦድስ። <verse eid="DAN 2:15"/><verse number="16" style="v" sid="DAN 2:16"/>ዳነል ካዋኮ ገልድ፥ አሙሁዋ ብርሸ ኤርሳናዉ ባዉ ዎደይ እመታና መላ ዎስስ።<verse eid="DAN 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 2:17"/>ሄሳፈ ጉየ ዳነል ባ ሶ ስሚድ፥ ባ ሄ ላገታስ፥ አናንያስ፥ ምሳኤላስነ አዛርያስ ሀኖታ ኦድስ። <verse eid="DAN 2:17"/><verse number="18" style="v" sid="DAN 2:18"/>ኤንቲ ባብሎነን ደእያ ሀንኮ ጭንጫታራ እስፈ ሀይቆናዳ፥ ሳሎ ፆሳይ ማሮታ ኦድ፥ ሀ ፁራ ኤንታዉ ቆንጭሳናዳ ዎሳና መላ ኤንታዉ ኦድስ።<verse eid="DAN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 2:19"/>ሄ ቃማ ፁራይ ዳነላስ ቆንጭስ። ዳነል ሳሎ ፆሳ ሀይሳዳ ያግድ ጋላትስ፤<verse eid="DAN 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="DAN 2:20"/>“ጭንጫተነ ዎልቅ ፆሳሳ ግድያ ግሾ፥</para>
  <para style="q2" vid="DAN 2:20">እያ ሱንይ መርናፐ መርና ጋካናዉ ጋላተቶ።<verse eid="DAN 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="DAN 2:21"/>እ ዎደታነ አጌናታ ላሜስ፤</para>
  <para style="q2" vid="DAN 2:21">ካዎታ አራታን ኡትሴስ፤ አራታፐ ድጌስ።</para>
  <para style="q1" vid="DAN 2:21">ጭንጫታስ ጭንጫተ እሜስ፤</para>
  <para style="q2" vid="DAN 2:21">አኬካንቾታስ ኤራ እሜስ።<verse eid="DAN 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="DAN 2:22"/>እ ፁራነ ጌምዳባ ቆንጭሴስ፤</para>
  <para style="q2" vid="DAN 2:22">እ ማን ደእያባ ኤሬስ፤</para>
  <para style="q2" vid="DAN 2:22">ፖኦይ እያራ ደኤስ።<verse eid="DAN 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="DAN 2:23"/>ታ ማይዛታ ፆሳዉ፥</para>
  <para style="q2" vid="DAN 2:23">ታ ነና ጋላታይስ፤ ሳባይስ።</para>
  <para style="q1" vid="DAN 2:23">ነ ታዉ ጭንጫተነ ዎልቃ እማዳሳ፤</para>
  <para style="q2" vid="DAN 2:23">ኑኒ ነና ኦይችዳባ ታና ኤርሳዳሳ፤</para>
  <para style="q2" vid="DAN 2:23">ካዋ አሙሁዋ ኑና ኤርሳዳሳ”</para>
  <para style="m" vid="DAN 2:23">ያግስ።<verse eid="DAN 2:23"/></para>
  <para style="s1">ዳነል አሙሆ ብርሽስ</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24"/>ሄሳፈ ጉየ፥ ዳነል ባብሎነን ደእያ ጭንጫታ ዎሳናዉ ካዉዋፐ ኪታ ኤክዳ፥ አርዮካኮ ብድ፥ “ጭንጫታ ዎፓ፤ ታና ካዋኮ ገልሳ፤ ታኒ እያ አሙሁዋ ብርሸ እያ ኤርሳና” ያግስ።<verse eid="DAN 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25"/>አርዮክ ኤለስድ ዳነላ ካዋኮ ገልስድ፥ ካዋኮ፥ “ይሁዳፐ ድኤትድ ይዳ አሳፐ ካዋ አሙሁዋ ብርሸ ኤርሳናዉ ዳንዳእያ አሰ ደማስ” ያግስ።<verse eid="DAN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 2:26"/>ካዎይ ብልፃሶራ ጌተትያ ዳነላ፥ “ታ አሙህዳ አሙሁዋነ እያ ብርሸ ታና ኤርሳናዉ ዳንዳአይ?” ግድ ኦይችስ።<verse eid="DAN 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 2:27"/>ዳነል ሀይሳዳ ያግድ ዛርስ፦ “ካዋዉ፥ ነ ኦይችዳ ፁራ ቆንጭሳናዉ ዳንዳእያ ጭንጫ አስ፥ ማሮይ፥ ብታንቾይነ፥ ሙሩንያ አስ ባዋ። <verse eid="DAN 2:27"/><verse number="28" style="v" sid="DAN 2:28"/>ሽን ፁራ ቆንጭስያ እስ ፆሲ ሳሎን ደኤስ። ዉርሰ ዎደታን ሀናናባ እ፥ ነና በስስ። ነ አርሳን ዝንአዳ፥ ነ በእዳ አሙሆይነ ቆንጨይ ሀይሳ።<verse eid="DAN 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 2:29"/>“ካዋዉ፥ ነ አርሳን ዝንአዳ፥ ስንፈ ያናባ ቆፓዳሳ። ሄ ዎደ ፁራ ቆንጭስያ ፆሳይ ስንፈ ሀናናባ ነና በስስ። <verse eid="DAN 2:29"/><verse number="30" style="v" sid="DAN 2:30"/>ሀ ፁራይ ታዉ ቆንጭዳይ፥ ታ ሀራ አሳፐ ጭንጫ ግድዳ ግሾ ግደና። ሽን ኔኒ ካዎይ፥ አሙሁዋ ብርሸ ኤራናዳነ ነ ሁጰን ስመረትያ ቆፋ አኬካና መላሳ።<verse eid="DAN 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 2:31"/>“ካዋዉ፥ ነ ዳሮ ግታ፥ ጶልያነ ፄላናዉ ያሽያ ምስለይ ነ ስንን ኤቅዳይሳ በአዳሳ። <verse eid="DAN 2:31"/><verse number="32" style="v" sid="DAN 2:32"/>ሄ ምስልያ ሁጰይ፥ ዋላህ ባይና ዎርቃፈ፥ እያ ትራይነ ኩሸት ብራፐ፥ ኡሎይነ ዎድረት ናሰ ብራታፐ፥ <verse eid="DAN 2:32"/><verse number="33" style="v" sid="DAN 2:33"/>ሱይለይ ብራታፐነ ቶሆ ያቻ ባጋይ ብራታፐ ባጋይ ቢታፈ መትስ። <verse eid="DAN 2:33"/><verse number="34" style="v" sid="DAN 2:34"/>ኔኒ ምስልያ ፄልያ ዎደ፥ እስ ሹች አሳ ኩሸይ ቦቾና ቆለትድ፥ ብራታፐነ ቢታፈ መትዳ ምስልያ ቶሆ ያቻ ቦላ ዎድ ጋጭስ። <verse eid="DAN 2:34"/><verse number="35" style="v" sid="DAN 2:35"/>ሄ ዎደ ብራት፥ ኡርቅ፥ ናሰ ብራታይ፥ ብርነ ዎርቀይ ኡባይ ጋጨትድ፥ ቦነን ዉዱማን ደእያ ሱላ መላ ግድን፥ አይኮይካ አቶናሽን ጫርኮይ ፕትድ ኤፍስ። ሽን ምስልያ ቦላ ዎዳ ሹቻይ ዙማ ግድድ ሳኣ ኩምስ።<verse eid="DAN 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 2:36"/>“አሙሆይ ሀይሳ፤ ሀእ ብርሸ ኑኒ ነዉ ኦዳና። <verse eid="DAN 2:36"/><verse number="37" style="v" sid="DAN 2:37"/>ካዋዉ፥ ኔኒ ካዎታ ካዎ። ሳሎ ፆሳይ ነዉ ካዎተነ ዎልቃ፥ ምኖተነ ቦንቾ እሚስ። <verse eid="DAN 2:37"/><verse number="38" style="v" sid="DAN 2:38"/>ኔኒ ቢታ ኡባ ሃራናዳ ኦስ፤ አሰ፥ ዶአነ ሳሎ ካፎ ነ ኩሸን ዎስ። ሄሳ ግሾ፥ ዎርቃ ሁጰይ ነና።<verse eid="DAN 2:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="DAN 2:39"/>“ኔፐ ጉየ፥ ምኖተን ነና ጋኮና ሀራ ካዎተ ደንዳና። ካልድ፥ ቢታ ኡባ ሃርያ፥ ናሰ ብራታ ግድያ፥ ሄን ካዎተ ደንዳና። <verse eid="DAN 2:39"/><verse number="40" style="v" sid="DAN 2:40"/>ዉርሰን ኡባ ጋጭድ ሊቅስያ ብራታዳ ምንዳ ኦይዳን ካዎተ ደንዳና። ብራት ኡባ ጋጭድ ሊቅሰይሳዳ እ፥ ባፐ ካሰ ደንድዳ ካዎተታ ጋጭድ ሊቅሳና።<verse eid="DAN 2:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="DAN 2:41"/>“ቶሆትነ ቶሆ ብራት ባጋይ ብራታፐ፥ ባጋይ ቢታፈ መትዳይሳ ነ በእዳይሳዳ፥ ሄ ካዎተይ ሻከትዳ ካዎተ ግዳና። ብራት ቢታራ ዋላከትን፥ ኔኒ በእዳይሳዳ ባጋይ ብራታዳ ምኖ ግዳና። <verse eid="DAN 2:41"/><verse number="42" style="v" sid="DAN 2:42"/>ቶሆ ብራት ባጋይ ብራታ፥ ባጋይ ቢታ ግድዳይሳዳ፥ ሀ ካዎተስ ባጋይ ምኖ፥ ባጋይ ሹጎ ግዳና። <verse eid="DAN 2:42"/><verse number="43" style="v" sid="DAN 2:43"/>ብራት ቢታራ ዋላከትን ኔኒ በእዳይሳዳ ሄ ናምኡ ባጋ አሳይ ገሎንነ ኤኮን ዋላከታና። ሽን ብራት ቢታራ ዋላከታናዉ ዳንዳኦናይሳዳ ኤንቲ እስኖ ግድድ ጋምአናዉ ዳንዳኦኮና።<verse eid="DAN 2:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="DAN 2:44"/>“ሄ ካዎታ ላይን፥ ሳሎ ፆሳይ ኩንዶና፥ ሀራ አሳስ አድ እመቶና ካዎተ ኤሳና። ሄ ኤቅዳ ካዎተይ፥ ሄ ካዎተታ ኡባ ጋጭድ ይሳና፤ ሽን እ መርናዉ ኤቅድ ዳና። <verse eid="DAN 2:44"/><verse number="45" style="v" sid="DAN 2:45"/>አሳ ኩሸይ ቦቾና ዙማፐ ቆለትድ፥ ዎድ፥ ብራታፐ፥ ናሰ ብራታፐ፥ ቢታፈ፥ ብራፐነ ቢታፈ መትዳ ምስልያ ጋጭዳ ሹቻ ብርሸይ ሄ ካዎተ።</para>
  <para style="p" vid="DAN 2:45">“ግታ ፆሳይ ስንፈ ሀናናባ ካዋ በስስ። አሙሆይ ቱማ፤ ብርሸይካ አማነትዳይሳ” ያግድ ዛርስ።<verse eid="DAN 2:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46"/>ሄሳፈ ጉየ፥ ካዎይ ናቡካዳናፆር ዳነላ ቦንችድ፥ ጉፋንስ፤ አሳይ እያ ስንን ያርሾ ያርሻና መላነ እፃነ ጩይሳና መላ ኪትስ። <verse eid="DAN 2:46"/><verse number="47" style="v" sid="DAN 2:47"/>ካዎይ ዳነላ፥ “ቱማ ነ ፆሳይ ፆሳታ ፆሰ፥ ካዎታ ጎዳነ ፁራ ቆንጭስያ ፆሰ። ኔኒ ሀ ፁራ ቆንጭሳናዉ ዳንዳእዳይ ሄሳ ግሾሳ” ያግስ።<verse eid="DAN 2:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="DAN 2:48"/>ሄሳፈ ጉየ፥ ካዎይ ዳነላ አድ ቦንችስ፤ ዳሮነ አልኦ እሞታታ እያዉ እሚስ። ባብሎነ ቢታ ሃርያ አሰ ኦስ፤ ባብሎነን ደእያ ጭንጫታ ኡባ ቦላ ሀላቃ ኦድ ሹምስ። <verse eid="DAN 2:48"/><verse number="49" style="v" sid="DAN 2:49"/>ዳነል ኦይሻን፥ ካዎይ ስድራቃ፥ ምሳቃነ አብዳናጎ ባብሎነ ቢታ አይሰይሳታ ኦድ ሹምስ፤ ሽን ዳነል ካዎ ኬን ጋምእስ።<verse eid="DAN 2:49"/></para>
  <chapter eid="DAN 2"/>
  <chapter number="3" style="c" sid="DAN 3"/>
  <para style="s1">ዎርቃ ምስለነ እቶነ ታማ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1"/>ካዎይ ናቡካዳናፆር አዱሳተይ ኡሱፑን ታሙ ዋ፥ ጎምፓይ ኡሱፑን ዋ ግድያ ምስለ ዎርቃፈ መድ፥ ባብሎነ ቢታን ዱራ ደምባን ኤስስ። <verse eid="DAN 3:1"/><verse number="2" style="v" sid="DAN 3:2"/>ሄ ምስልያ አንጅሳናዉ ያና መላ፥ ካዎ ሞርናታ፥ ሹማታ፥ ቢታ አይሰይሳታ፥ ካዋ ዞረይሳታ፥ ሚሸ ኬን ኦይሳታ፥ ፕርዳ ዳይናታ፥ ህገ ኤራንቾታነ አዉራጃ ሹማታ ፄግስ። <verse eid="DAN 3:2"/><verse number="3" style="v" sid="DAN 3:3"/>ሄ ዎደ ካዎ ሞርናት፥ ሹማት፥ ቢታ አይሰይሳት፥ ካዋ ዞረይሳት፥ ሚሸ ኬን ኦይሳት፥ ፕርዳ ዳይናት፥ ህገ ኤራንቾትነ አዉራጃ ሹማት ሺቅድ፥ ካዎይ ናቡካዳናፆር ኤስዳ ምስልያ ስንን ኤቅዶሶና። <verse eid="DAN 3:3"/><verse number="4" style="v" sid="DAN 3:4"/>ሄ ዎደ አዋጅያ አደይ ባ ቃላ ቁ ኦድ፥ ሀይሳዳ ያግስ፦ “ህንተኖ፥ አሳዉ፥ ካዎተቶ፥ ዱማ ዱማ ዶና ኦደተይሳቶ፥ <verse eid="DAN 3:4"/><verse number="5" style="v" sid="DAN 3:5"/>ኡባይ ሞይዘ፥ ሱሱልኤ፥ ማስንቆ፥ ዲ፥ ዛየነ ሀራ የ ሚሸ ግርስ ስእያ ዎደ፥ ካዎይ ናቡካዳናፆር ኤስዳ ዎርቃ ምስልያስ ጉፋንድ ጎይንተ። <verse eid="DAN 3:5"/><verse number="6" style="v" sid="DAN 3:6"/>ምስልያ ስንን ጉፋንድ ጎይኖና ኦንካ፥ ሄ ሳትያን ኤፅያ እቶነ ታማን ሆለታና” ያግስ።<verse eid="DAN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 3:7"/>ሄሳ ግሾ፥ አሳይ፥ ካዎተትነ ዱማ ዱማ ዶና ኦደትያ ኡባይ ሞይዘ፥ ሱሱልኤ፥ ማስንቆ፥ ዲ፥ ዛየነ ሀራ የ ሚሸ ግርስ ስእዳ ዎደ ቢታን ጉፋንድ፥ ካዎይ ናቡካዳናፆር ኤስዳ ዎርቃ ምስልያስ ጎይንዶሶና።<verse eid="DAN 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8"/>ሄ ዎደ ባብሎነ አሳታፐ እሶት እሶት አይሁደታ ሞትዶሶና። <verse eid="DAN 3:8"/><verse number="9" style="v" sid="DAN 3:9"/>ኤንቲ ካዋ ናቡካዳናፆራኮ ሀይሳዳ ያግዶሶና፤ “ካዋዉ፥ መርናዉ ካዎታ። <verse eid="DAN 3:9"/><verse number="10" style="v" sid="DAN 3:10"/>ካዋዉ፥ ነ ሞይዘ፥ ሱሱልኤ፥ ማስንቆ፥ ዲ፥ ዛየነ ሀራ የ ሚሸ ግርስ ስእያ ኦንካ ጉፋንድ፥ ዎርቃ ምስልያስ ጎይናና መላ፥ <verse eid="DAN 3:10"/><verse number="11" style="v" sid="DAN 3:11"/>ቢታን ጉፋንድ ጎይኖና አስ ደእኮ፥ እቶነ ታማን ሆለታና መላ አዋጆ ከሳዳሳ። <verse eid="DAN 3:11"/><verse number="12" style="v" sid="DAN 3:12"/>ሽን ካዋዉ፥ ኔኒ ባብሎነ ቢታን ሹምዳ አይሁደት፥ ስድራቅ፥ ምሳቅነ አብዳናጎይ ነ ኪታ እፅዶሶና። ነ ፆሳታስ ኦኮና፤ ቃስ ነ ኤስዳ ዎርቃ ምስልያካ ጎይኖኮና” ያግዶሶና። <verse eid="DAN 3:12"/><verse number="13" style="v" sid="DAN 3:13"/>ናቡካዳናፆር ሄሳ ስእዳ ዎደ፥ ይሎ ኤፅድ፥ ስድራቃ፥ ምሳቃነ አብዳናጎ ኤሀና መላ ኪትስ፤ ኤንታ ካዋ ስን ኤህዶሶና። <verse eid="DAN 3:13"/><verse number="14" style="v" sid="DAN 3:14"/>ናቡካዳናፆር ኤንታ ሀይሳዳ ያግስ፦ “ስድራቃ፥ ምሳቃ፥ አብዳናጎ፥ ህንተ ታ ፆሳታስ ኦቦናይስነ ታ ኤስዳ ዎርቃ ምስልያ ጎይንቦናይስ ቱሜ? <verse eid="DAN 3:14"/><verse number="15" style="v" sid="DAN 3:15"/>ሀእ ሞይዘ፥ ሱሱልኤ፥ ማስንቆ፥ ዲ፥ ዛየነ ሀራ የ ሚሸ ግርስ ስእያ ዎደ ታ ኤስዳ ምስልያስ ጉፋንድ ጎይንኮ ሎኦ። ሽን ህንተ ጎይኖና እፅኮ፥ ኤለስድ ኤፅያ እቶነ ታማን ሆለታና። አይ ፆስካ ህንተና ታ ኩሸፐ አሸና” ያግስ።<verse eid="DAN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16"/>ስድራቅ፥ ምሳቅነ አብዳናጎይ ዛሪድ፥ “ካዋዉ፥ ናቡካዳናፆራ፥ ሀይሳስ ኑ ነዉ ዛሮ እማናዉ በሰና። <verse eid="DAN 3:16"/><verse number="17" style="v" sid="DAN 3:17"/>ካዋዉ፥ ኑ ኤፅያ እቶነ ታማን ሆለትያኮካ፥ ኑ እያዉ ኦያ ፆሳይ ታማፐ ኑና አሻናዉ ዳንዳኤስ። ቃስ ካዋዉ፥ እ ኑና ነ ኩሸፐ አሻና። <verse eid="DAN 3:17"/><verse number="18" style="v" sid="DAN 3:18"/>ሽን ካዋዉ፥ እ ኑና አሾና እፅኮካ፥ ኑኒ ነ ፆሳታስ ኦናይሳነ ነ ኤስዳ ዎርቃ ምስልያ ጎይናናይሳ ኤራ” ያግዶሶና።<verse eid="DAN 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19"/>ሄ ዎደ ናቡካዳናፆር ስድራቃ፥ ምሳቃነ አብዳናጎ ቦላ ይሎ ኤፅን፥ እያ ሶምኦይ ላመትስ። ታማይ ካሰ ኤፀይሳፈ ላፑን ኩሸ አድ ኤፃና መላ ኪትስ። <verse eid="DAN 3:19"/><verse number="20" style="v" sid="DAN 3:20"/>ስድራቃ፥ ምሳቃነ አብዳናጎ ቃችድ፥ ኤፅያ እቶነ ታማን ሆላና መላ፥ ባ ኦላንቾታ ግዶፈ ምኖ አሳታ ኪትስ። <verse eid="DAN 3:20"/><verse number="21" style="v" sid="DAN 3:21"/>ኤንቲ ባንታ አፍላራ፥ ሱርያራ፥ ሁጰ ፃራነ ሀራ ማኦ ኡባራ ደእሽን፥ ኤፅያ እቶነ ታማን ሆልዶሶና። <verse eid="DAN 3:21"/><verse number="22" style="v" sid="DAN 3:22"/>ካዋ ኪታይ ዳሮ ኤሶ ግድዳ ግሾነ እቶነ ታማይ ካሰፐ አድ ኤፅያ ግሾ፥ ስድራቃ፥ ምሳቃነ፥ አብዳናጎ ታማን ሆልዳ፥ ምኖ አሳታ ታማ ላጮይ ዎስ። <verse eid="DAN 3:22"/><verse number="23" style="v" sid="DAN 3:23"/>ሀ ሄ ቃሸትዳ አሳት፥ ስድራቅ፥ ምሳቅነ አብዳናጎይ፥ ኤፅያ እቶነ ታማን ዎዶሶና።<verse eid="DAN 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24"/>ሄሳፈ ጉየ፥ ካዎይ ናቡካዳናፆር ማላለትድ፥ ኤሶን ደንድ ኤቅድ፥ “ኑ ቃችድ ኤፅያ እቶነ ታማን የግዳ አሳት ሄ ግዶኮናዬ?” ያግድ ባና ዞረይሳታ ኦይችስ።</para>
  <para style="p" vid="DAN 3:24">ኤንቲ፥ “ካዋዉ፥ ኤ፥ ቱማ ሄ” ያግድ ዛርዶሶና።<verse eid="DAN 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 3:25"/>ካዎይ ዛሪድ፥ “ቃሾፐ ብርሸትድ፥ ታማ ግዶን ያነ ሃነ ሄመትያ፥ ታማይ አይኮካ ቦቾና ኦይዱ አሳታ በአይስ፤ ኦይዳንይ ፆሳታ ናአ ዳኔስ” ያግስ።<verse eid="DAN 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26"/>ናቡካዳናፆር ኤፅያ እቶነ ታማ ማታ ሺቅድ፥ ባ ቃላ ቁ ኦድ፥ “ኡባፈ ቃ ፆሳ ኦሳንቾቶ፥ ስድራቃ፥ ምሳቃ፥ አብዳናጎ፥ ከይድ ሃ ዪተ!” ያግድ ፄግስ። ስድራቅ፥ ምሳቅነ አብዳናጎይ ታማ ግዶፈ ከይዶሶና። <verse eid="DAN 3:26"/><verse number="27" style="v" sid="DAN 3:27"/>ካዉዋፐ ጋርሳራ ቢታ አይሰይሳት፥ ሞርናት፥ ሹማትነ ካዋ ዞረይሳት ኤንታኮ ሺቅዶሶና። ታማይ ኤንታ አሳተ ቦችቦናይሳ፥ ኤንታ ሁጰ ብናናፐ እሶይካ ፁገትቦናይሳ፥ ኤንታ ማኦይካ ሜተትቦናይሳነ ታማ ፔኖይ ኤንታ ቦላ ባይናይሳ በእዶሶና።<verse eid="DAN 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28"/>ሄሳፈ ጉየ፥ ናቡካዳናፆር ሀይሳዳ ያግስ፦ “ስድራቃ፥ ምሳቃነ አብዳናጎ ፆሳይ ጋላተቶ። እ፥ ባ ኪታንቹዋ ኪትድ፥ ባናን አማነትዳ፥ ባ አይለታ አሽስ። ኤንቲ ካዋ ኪታ እፅድ፥ ባንታ ፆሳፈ አትሽን፥ ሀራ ፆሰ ጎይናናፐ ሀይቃናዉ ዶስዶሶና። <verse eid="DAN 3:28"/><verse number="29" style="v" sid="DAN 3:29"/>ሄሳ ግሾ፥ ሀራ አይ ፆስካ ሀይሳዳ ኦድ አሰ አሾና ግሾ፥ ስድራቃ፥ ምሳቃነ አብዳናጎ ፆሳ ቶችድ ኦደትያ አይ አስካ፥ ዎይኮ አይ ካዎተካ፥ ዎይኮ ዱማ ዱማ ዶናን ኦደትያ አይ ኮቻይካ ቃንፀታና መላ ኤንታ ኬይካ ላለትድ፥ ፕቶ ዶረ ግዳና መላ ታኒ ኪታስ” ያግስ።<verse eid="DAN 3:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 3:30"/>ካዎይ ስድራቃ፥ ምሳቃነ አብዳናጎ ባብሎነ ቢታን ቁ ቁ ኦድ ሹምስ።<verse eid="DAN 3:30"/></para>
  <chapter eid="DAN 3"/>
  <chapter number="4" style="c" sid="DAN 4"/>
  <para style="s1">ናቡካዳናፆራ ናምአን አሙሁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1"/>ካዎይ ናቡካዳናፆር፥</para>
  <para style="pi" vid="DAN 4:1">አሳስ፥ ካዎተታስ፥ ዱማ ዱማ ዶናን ኦደትያ ኮቻታስ ሀይሳዳ ያግድ ዳብዳበ ፃፍስ፦</para>
  <para style="pi" vid="DAN 4:1">ሳሮይ ህንተዉ ግዶ፥<verse eid="DAN 4:1"/></para>
  <para style="pi">
    <verse number="2" style="v" sid="DAN 4:2"/>ኡባፈ ቃ ፆሳይ ታዉ ኦዳ፥ ማላልስባነ ኦራባ ታ ህንተዉ ኦዳናዉ ኮያይስ።<verse eid="DAN 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="DAN 4:3"/>እያ ማላታይ አይባ ግተ!</para>
  <para style="q2" vid="DAN 4:3">እ ኦያ ኦራባይ አይባ ምኖ!</para>
  <para style="q1" vid="DAN 4:3">እያ ካዎተይ መርና ካዎተ፤</para>
  <para style="q2" vid="DAN 4:3">እ የለታፐ የለታ ጋካናዉ ሃሬስ።<verse eid="DAN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 4:4"/>ታኒ፥ ናቡካዳናፆር ታ ኬን እንጀትን፥ ታ ካዎ ጋን ሚኮትን ደአይስ። <verse eid="DAN 4:4"/><verse number="5" style="v" sid="DAN 4:5"/>እስ ጋላስ ታኒ ያሽያ አሙሆ በአስ። ታኒ ታ አርሳን ዝንአዳ፥ በእዳ አሙሆይነ ቆንጨይ ታና ዳጋንስ። <verse eid="DAN 4:5"/><verse number="6" style="v" sid="DAN 4:6"/>ሄሳ ግሾ፥ አሙሁዋ ብርሸ ታና ኤርሳና መላ ባብሎነን ደእያ ጭንጫታ ኡባ ታኮ ኤሀና መላ ኪታስ። <verse eid="DAN 4:6"/><verse number="7" style="v" sid="DAN 4:7"/>ሄ ዎደ ማሮት፥ ሙራንቾት፥ ፆልንቶ ታይበይሳትነ ብታንቾት ታኮ ይን፥ ታ አሙሁዋ ኤንታዉ ኦዳስ፤ ሽን ኤንቲ ብርሸ ታና ኤርሳናዉ ዳንዳእቦኮና። <verse eid="DAN 4:7"/><verse number="8" style="v" sid="DAN 4:8"/>ዉርሰን ታ ፆሳ ሱንን ብልፃሶራ ጌተትድ ፄገትያ፥ ጌሻ ፆሳታ አያን እያን ደእያ፥ ዳነል ታኮ ገልን፥ እያዉ ታ አሙሁዋ ኦዳስ።<verse eid="DAN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 4:9"/>ጭንጫታ ሀላቃ ግድዳ ብልፃሶራ፥ ጌሻ ፆሳታ አያን ነናን ደኤይሳነ አይባ ፁርካ ኔፐ ጌሞናይሳ ታኒ ኤራይስ። ታኒ በእዳ አሙሆይ ሀይሳ፤ አነ ታዉ እያ ብርሸ ኦዳ። <verse eid="DAN 4:9"/><verse number="10" style="v" sid="DAN 4:10"/>ታኒ ታ አርሳን ዝንአዳ፥ ቢታስ ግድ ዛዋን እስ ግታ ም ኤቅዳይሳ ቆንጨን በአስ። <verse eid="DAN 4:10"/><verse number="11" style="v" sid="DAN 4:11"/>ሄ ምይ ድጭድ ግታትስነ ምንስ። እያ ፄራይ ሳሎ ጋኬስ፤ ሳኣ ጋፃፐ ጋፃ ጋካናዉ በንቴስ። <verse eid="DAN 4:11"/><verse number="12" style="v" sid="DAN 4:12"/>ሄ ም ሀይይ ፄላናዉ ሎኤስ፤ እያ አይፈይካ ዳሮ፤ እያ ቦላ ኡባስ ሜተትያባይ ደኤስ። ሳአ ዶአት እያ ኩያን ሸምፖሶና፤ ሳሎ ካፎት እያ ታሽያ ቦላ ኬፅድ ደኦሶና። ደኦራ ደእያ ኡባይ እያፐ ሜስ።<verse eid="DAN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 4:13"/>“ታኒ ታ አርሳን ዝንአዳ፥ ጌሻ ኪታንቾይ ሳሎፐ ዎሽን ቆንጨን በአስ። <verse eid="DAN 4:13"/><verse number="14" style="v" sid="DAN 4:14"/>እካ ባ ቃላ ቁ ኦድ፥ ሀይሳዳ ያግስ፦ ‘ሀ ም ቃንፅተ፤ እያ ታሽያ ካርተ፤ እያ ሀይ ዱተ፤ እያ አይፍያ ላልተ። እያ ጋርሳን ደእያ ዶአትነ እያ ታሽያን ኡትያ ካፎት ኡባይ ባቃቶ። <verse eid="DAN 4:14"/><verse number="15" style="v" sid="DAN 4:15"/>ሽን ዱሩማነ እያ ፃጱዋ ብራታንነ ናሰ ብራታ ሳንላታን ቃችድ፥ ቢታን፥ ማታ ግዶን አጋግተ። ሳሎ አካን ላኮ፤ ባዞን ማታ ግዶን ዶአራ ደኦ። <verse eid="DAN 4:15"/><verse number="16" style="v" sid="DAN 4:16"/>እያ ካሀይ አሳፐ ዶአይሳን ላመቶ፤ ሄሳዳ ሀንድ ላፑን ላይ ደኦ። <verse eid="DAN 4:16"/><verse number="17" style="v" sid="DAN 4:17"/>ኡባፈ ቃ ፆሳይ አሳ ናይታ ካዎተ ኡባ ሃረይሳ፥ ካዎተ ኮይያ አሳስ እመይሳነ ሀር አቶሽን ቦረትዳይሳ ሹመይሳ ደኦን ደእያ አስ ኡባይ ኤራና መላ፥ ሄሳ ኪታንቾት አዋጅዶሶና፤ ጌሻት ፕርዳ ኤህዶሶና’ ” ያግስ።<verse eid="DAN 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 4:18"/>“ታኒ፥ ካዎይ ናቡካዳናፆር በእዳ አሙሆይ ሀይሳ፦ ሀእ፥ ብልፃሶራ፥ ታዉ እያ ብርሸ ኦዳ። ታ ካዎተን ደእያ ጭንጫታፐ እሶይካ ታና ብርሸ ኤርሳናዉ ዳንዳእቤና። ሽን ጌሻ ፆሳታ አያን ነናን ደእያ ግሾ፥ ኔኒ ዳንዳኣሳ” ያጋስ።<verse eid="DAN 4:18"/></para>
  <para style="s1">ዳነል አሙሆ ብርሸ</para>
  <para style="pi">
    <verse number="19" style="v" sid="DAN 4:19"/>ሄ ዎደ ብልፃሶራ ጌተትያ ዳነል ዳጋምድ፥ ሀንያባ ይስ። እ ዳጋምዳ ግሾ ጉ ዎደ ስእ ግድ ጋምእስ። ያትን፥ ካዎይ፥ “ብልፃሶራ፥ ሀ አሙሆይነ እያ ብርሸይ ነና ዳጋንፎ” ያግስ።</para>
  <para style="pi" vid="DAN 4:19">ብልፃሶር ዛሪድ፥ “ታ ጎዳዉ፥ ሀ አሙሆይ ነና እፀይሳታስ፥ እያ ብርሸይ ነ ሞርከታስ ግዶ። <verse eid="DAN 4:19"/><verse number="20" style="v" sid="DAN 4:20"/>ነ አሙሆን በእዳ ምይ፥ ድጭድ ምንዳይ፥ ዳይድ ሳሎ ጋክዳይ፥ ሳአ ጋፃፐ ጋፃ ጋካናዉ በንትዳይ፥ <verse eid="DAN 4:20"/><verse number="21" style="v" sid="DAN 4:21"/>ሀይይ ፄላናዉ ሎኤይ፥ አይፈይ ዳርዳይ፥ እያ ቦላ ኡባስ ምያባይ ደኤይ፥ ዶአት እያ ኩያን ሸምፕዳይነ ሳሎ ካፎት እያ ታሽያን ኬፅድ ደኤይ፥ <verse eid="DAN 4:21"/><verse number="22" style="v" sid="DAN 4:22"/>ካዋዉ፥ ሄ ምይ ነና። ኔኒ ግታታዳሳ፤ ምናዳሳ፤ ነ ግታተይ ድጭድ፥ ሳሎ ጋክስ፤ ነ ማታይ ሳኣ ጋፃፐ ጋፃ ጋክስ።”<verse eid="DAN 4:22"/></para>
  <para style="pi">
    <verse number="23" style="v" sid="DAN 4:23"/>“ካዋዉ፥ ጌሻ ኪታንቾይ ሳሎፐ ዎድ፥ ‘ሀ ም ቃንፅድ ይስተ፤ ሽን እያ ዱሩማነ እያ ፃጱዋ ብራታንነ ናሰ ብራታ ሳንላታን ቃችድ፥ ቢታን፥ ማታ ግዶን አጋግተ። እ ሳሎ አካን ላኮ፤ ላፑን ላይ ጋካናዉ ዎራን ዶአዳ ደኦ’ ” ግያ ዎደ በአዳሳ።<verse eid="DAN 4:23"/></para>
  <para style="pi">
    <verse number="24" style="v" sid="DAN 4:24"/>“ካዋዉ፥ ብርሸይ ሀይሳ፦ ሀይስ ኡባፈ ቃ ፆሳይ ታ ጎዳ፥ ካዋ ቦላ ፖላናዉ ኪትዳ ፕርዳ። <verse eid="DAN 4:24"/><verse number="25" style="v" sid="DAN 4:25"/>ኔኒ አሳ ግዶፈ ጎደታዳ ዶአታራ እስፈ ዳና። ኔኒ ቦራዳ ማታ ማናነ ሳሎ አካን ላካና። ቃስ ኡባፈ ቃ ፆሳይ፥ አሳ ናይታ ካዎተ ኡባ ሃረይሳነ ካዎተ ባ ኮይዳ አሳስ እመይሳ ነ ኤራና ጋካናዉ፥ ላፑን ላይ ነ ቦላራ አና። <verse eid="DAN 4:25"/><verse number="26" style="v" sid="DAN 4:26"/>ዱሩማይ ፃጶራ ቢታን አታናዳ ኪተትዳይስ፥ ሳሎ ፆሳይ ቢታ ኡባ ሃረይሳ ኔኒ ኤርያ ዎደ፥ ነ ካዎተይ ነዉ ስማናይሳ በሴስ። <verse eid="DAN 4:26"/><verse number="27" style="v" sid="DAN 4:27"/>ካዋዉ፥ ታ ዞርያ ኤካ። ናጋራ ኦሶ አጋዳ ሱረባ ኦ፤ ኡንኤትዳይሳታ ናቆ አጋዳ ኤንታዉ ቃታ። ኦን ኤር ኔኒ ሳሮ ዳና ዎደይ አዱቆና አገና” ያግስ።<verse eid="DAN 4:27"/></para>
  <para style="s1">አሙሆይ ፖለትስ</para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 4:28"/>ሀ ኡባይ ካዋ ናቡካዳናፆራ ቦላ ጋክስ። <verse eid="DAN 4:28"/><verse number="29" style="v" sid="DAN 4:29"/>ታማነ ናምኡ አጌናፐ ጉየ፥ ካዎይ ባብሎነን ደእያ ካዎ ጋ ቦላ ደእያ በሳን ስመረቴስ። <verse eid="DAN 4:29"/><verse number="30" style="v" sid="DAN 4:30"/>ካዎይ፥ “ታኒ፥ ታ ግታ ዎልቃን፥ ታ ግታ ቦንቹዋስ ካዎይ ዳና መላ ታ ኬፅዳ ዎልቃማ ባብሎነ ካታማይ ሀይሳ ግደኔ?” ያግስ።<verse eid="DAN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 4:31"/>እ፥ ባ ኦዳ ዉርሶና ደእሽን፥ ሳሎፐ ሀይሳዳ ግያ ቃል ይድ፥ “ካዋ ናቡካዳናፆራ፥ ነ ቦላ ፕርደትዳ ፕርዳይ ሀይሳ፦ ነ ካዎተይ ኔፐ ኤከትስ። <verse eid="DAN 4:31"/><verse number="32" style="v" sid="DAN 4:32"/>ኔኒ አሳ ግዶፈ ጎደታዳ፥ ባዞ ዶአታራ ዳና፤ ነ ቦራዳ ማታ ማና። ኡባፈ ቃ ፆሳይ አሳ ናይታ ካዎተ ኡባ ሃረይሳነ እ ባ ኮይዳ አሳስ ካዎተ እመይሳ ኔኒ ኤራና ጋካናዉ ላፑን ላይ ነ ቦላራ አና” ያግስ።<verse eid="DAN 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 4:33"/>ናቡካዳናፆራ ቦላ ጌተትዳባይ ኤለስድ ፖለትስ። አሳ ግዶፈ ጎደትድ፥ ቦራዳ ማታ ምስ። እያ አሳተይ ሳሎ አካን ላክስ። እያ ብናናይ አንኮ ባለዳ፥ እያ ፁጉንይካ ካፎ ፁጉንዳ ድጭስ።<verse eid="DAN 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34"/>“ሄ ላፑን ላይይ ዉርዳፐ ጉየ፥ ታኒ ናቡካዳናፆር ቁ ጋዳ ሳሎ ፄላስ። ታ ካሀይ ስምን፥ ኡባፈ ቃ ፆሳ ጋላታስ፤ መርና ፆሳ ቦንቻስ፤ ሳባስ።</para>
  <para style="q1" vid="DAN 4:34">“እ መርናፐ መርናዉ ሃሬስ፤</para>
  <para style="q2" vid="DAN 4:34">እያ ካዎተይ የለተፈ የለተ ጋካናሳ።<verse eid="DAN 4:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="DAN 4:35"/>ሳአን ደእያ አሳ ኡባይ</para>
  <para style="q2" vid="DAN 4:35">እያ ስንን ላፋባ።</para>
  <para style="q1" vid="DAN 4:35">ሳሎ መተታ ቦላነ</para>
  <para style="q2" vid="DAN 4:35">ሳአን አሳ ቦላ እ ዶስዳባ ኦስ።</para>
  <para style="q1" vid="DAN 4:35">እያ ኩሽያ ተቃናዉ ዳንዳኤይ ባዋ፥</para>
  <para style="q2" vid="DAN 4:35">እያ፥ ‘አይ ኦይ?’ ያግድ ኦይቸይ ዴና።<verse eid="DAN 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 4:36"/>ታ ካሀይ ስምን፥ ታ ካዎተ ቦንቾይነ ታ ቴማይ ታዉ ስምስ። ካሰ ታና ዞረይሳትነ ታ ሞርናት ታና ኮይዶሶና። ታኒ ታ አራታን ምናስ፤ ታዉ ካሰይሳፈ አያ ግታተ ጉዠትስ። <verse eid="DAN 4:36"/><verse number="37" style="v" sid="DAN 4:37"/>ህዛ፥ ታኒ ናቡካዳናፆር ሳሎ ካዋ ጋላታይስ፤ እያ ቁ ቁ ኦይስ፤ እያ ቦንቻይስ። እ ኦያባ ኡባይ ልከ፤ እያ ኦገ ኡባይ ሱረ፤ እ ኦቶሮን ሄመተይሳታ ካዉሻናዉ ዳንዳኤስ” ያግስ።<verse eid="DAN 4:37"/></para>
  <chapter eid="DAN 4"/>
  <chapter number="5" style="c" sid="DAN 5"/>
  <para style="s1">ካዋ ብልፃሶራ ግብራ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1"/>እስ ጋላስ ካዎይ ብልፃሶር ሙኩሉ ግድያ ባ ሹማታስ ግብራ ጊግስድ፥ ኤንታራ እስፈ ዎይነ ኡሻ ኡይስ። <verse eid="DAN 5:1"/><verse number="2" style="v" sid="DAN 5:2"/>ብልፃሶር ዎይነ ኡሻ ኡይድ ማትዳ ዎደ፥ እያ አዋይ ናቡካዳናፆር የሩሳላመን ደእያ ፆሳ ኬፈ ኤህዳ ዎርቃፈነ ብራፐ ኦሰትዳ ኡሻ ሚሸታ ኤሀና መላ ኪትስ። እ ሄሳ ኦዳይ እ፥ እያ ሹማታስ፥ እያ ማቸትነ እያ ላገት ኡሻ ሄ ሚሸታን ኡያናዉ ኮይዳ ግሾሳ። <verse eid="DAN 5:2"/><verse number="3" style="v" sid="DAN 5:3"/>ኤንቲ የሩሳላመን ደእያ ፆሳ ኬፈ ኤህዳ ዎርቃፈ ኦሰትዳ ኡሻ ሚሸታ ካዋስ ኤህዶሶና። ያትን ካዎይ፥ እያ ሹማት፥ እያ ማቸትነ እያ ላገት ሄ ሚሸታን ትገትዳ ዎይነ ኡሻ ኡይዶሶና። <verse eid="DAN 5:3"/><verse number="4" style="v" sid="DAN 5:4"/>ኤንቲ ሄ ዎይነ ኡሻ ኡይሸ፥ ዎርቃፈ ብራፐ፥ ናሰ ብራታፐ፥ ብራታፐ፥ ምፈነ ሹቻፈ ኦሰትዳ ፆሳታ ጋላትዶሶና።<verse eid="DAN 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5"/>ሄ ዎደ ቆፖና ደእሽን፥ አሳ ኩሸ ብራት ከይድ፥ ፆምፐ ዎያ ኮጫ ስንን፥ ሜሸትዳ ካዎ ጋ ጎዳ ቦላ ፃፍዶሶና። ሄ ኩሸይ ፃፍያ ዎደ ካዎይ በእስ። <verse eid="DAN 5:5"/><verse number="6" style="v" sid="DAN 5:6"/>ሄ ዎደ እያ ሶምኦይ ላመትድ፥ ብዶ ግድስ፤ ያሻን እያ ጋደይ ኮኮርስ፤ እያ ጉልባታይ እፅስ።<verse eid="DAN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 5:7"/>ካዎይ ባ ቃላ ቁ ኦድ፥ ሙራንቾታ፥ ማሮታነ ፆልንቶ ፓይደይሳታ ኤሀና መላ ኪትስ። እ፥ ባብሎነ ጭንጫታኮ ሀይሳዳ ያግስ፦ “ሀ ፁፍያ ናባብድ፥ እያ ብርሸ ታዉ ኦድያ ኦንካ፥ ኦቻ ቴራ ዳንያ ማኡዋ ማአና፤<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="fq" closed="false">ኦቻ ቴራ ዳንያ ማኡዋ ማአና፦ </char><char style="ft" closed="false">ሀ ማኦይ ዳሮ አልኦነ በን ዎደ ካዎት ማእያ ማኦ።</char></note> እያ ቆን ዎርቃ አና፤ እ፥ ታ ካዎተ ሃርያ ሄን አስ ግዳና” ያግስ።<verse eid="DAN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 5:8"/>ባብሎነ ጭንጫት ኡባይ እያ ስን ይዶስና፤ ሽን ኤንታፈ ኦንካ ሄ ፁፍያ ናባባናዉ ዎይኮ እያ ብርሸ ኦዳናዉ ዳንዳእቤና። <verse eid="DAN 5:8"/><verse number="9" style="v" sid="DAN 5:9"/>ካዎይ ብልፃሶር ካሰይሳፈ አድ ዳጋምን፥ እያ ሶምኦይ ካሰይሳፈ አድ ብዶ ግድስ። እያ ሹማት ሀንያባ ይዶሶና።<verse eid="DAN 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10"/>እያ አይያ፥ ካዋነ እያ ሹማታ ፓላማ ስአዳ፥ ኤንቲ ግብራ ምያ ኬ ገላዳ፥ ሀይሳዳ ያጋሱ፦ “ካዋዉ፥ መርናዉ ካዎታ! ሀ ቆፋን ዳሮ ዳጋሞፋ፤ ነ ሶምኦይ ላመቶፎ። <verse eid="DAN 5:10"/><verse number="11" style="v" sid="DAN 5:11"/>ጌሻ ፆሳታ አያን እያ ቦላ ደእያ፥ እስ አስ ነ ካዎተ ግዶን ደኤስ። እያዉ ኤራተ፥ አኬክነ ጭንጫተ ደኤስ። ካሰ ነ አዋይ፥ ካዎይ ናቡካዳናፆር እያ፥ ማሮታ፥ ሙራንቾታ፥ ብታንቾታነ ፆልንቶ ፓይደይሳታ ሀላቃ ኦድ ሹምስ። <verse eid="DAN 5:11"/><verse number="12" style="v" sid="DAN 5:12"/>እ፥ ሎኦ አያን፥ ኤርነ አኬክ ደእያ አሰ። እ አሙሆ ብርሻናዉ፥ ቃንእሸ ኦዳናዉነ ፁራ ቆንጭሳናዉ ዳንዳኤስ። ካዎይ ብልፃሶራ ግድ ሱንዳ ዳነላ ፄጋ። እ ነዉ ፁፍያ ብርሸ ኦዳና” ያጋሱ።<verse eid="DAN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13"/>ሄ ዎደ ዳነላ ካዋኮ ኤህን፥ ካዎይ እያኮ ሀይሳዳ ያግስ፦ “ዳነል ነኔ? ታ አዋይ፥ ካዎይ ይሁዳፐ ድእድ ኤህዳይሳታፐ እሶይ ነኔ? <verse eid="DAN 5:13"/><verse number="14" style="v" sid="DAN 5:14"/>ፆሳታ አያን ነናን ደኤይሳ፥ ኤር፥ አኬክነ ጭንጫተ ነዉ ደኤይሳ ታ ስአስ። <verse eid="DAN 5:14"/><verse number="15" style="v" sid="DAN 5:15"/>ሀ ፁፍያ ናባባናዉነ እያ ብርሸ ታዉ ኦዳናዉ ሙራንቾትነ ጭንጫት ይዶሶና፤ ሽን ኤንቲ ታዉ ብርሸ ኦዳናዉ ዳንዳእቦኮና። <verse eid="DAN 5:15"/><verse number="16" style="v" sid="DAN 5:16"/>ኔኒ ብርሸ ኦዳናዉነ ዴፆ ኦይሻ ኡባ ዛራናዉ ዳንዳኤይሳ ታ ስአስ። ህዛ ነ ሀ ፁፍያ ናባባናዉነ እያ ብርሸ ታዉ ኦዳናዉ ዳንዳእኮ፥ ኦቻ ቴራ ዳንያ ማኡዋ ማይዛና፤ ነ ቆን ዎርቃ አና፤ ኔኒ፥ ካዎተ ሃርያ ሄን አሰ ግዳና።”<verse eid="DAN 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17"/>ዳነል ካዋስ ዛሪድ፥ “ነ እሞይ ነዉ ግዶ፤ ነ ዎይቱዋ ሀራ አሳስ እማ። ግዶሽን፥ ታኒ ፁፍያ ካዋስ ናባባና፤ ብርሸካ ኦዳና።”<verse eid="DAN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 5:18"/>“ካዋዉ፥ ኡባፈ ቃ ፆሳይ ነ አዋ ናቡካዳናፆራስ ካዎተ፥ ግታተ፥ ቦንቾነ ቴማ እሚስ። <verse eid="DAN 5:18"/><verse number="19" style="v" sid="DAN 5:19"/>እያ ግታተ ጋሶን ደረይ፥ ካዎተትነ ዱማ ዱማ ዶናን ኦደትያ ኮቻት እያዉ ያሻን ኮኮርዶሶና። እ ዎናዉ ኮየይሳ ዎስ፤ አሻናዉ ኮየይሳ አሼስ፤ ሹማናዉ ኮየይሳ ሹሜስ፤ ካዉሻናዉ ኮየይሳ ካዉሼስ። <verse eid="DAN 5:19"/><verse number="20" style="v" sid="DAN 5:20"/>ሽን እ ኦቶርትዳ ዎደነ እያ ዎዛናይ ሙምዳ ዎደ፥ ባ አራታፐ ዎስ፤ እያ ቦንቾይካ ቃረትስ። <verse eid="DAN 5:20"/><verse number="21" style="v" sid="DAN 5:21"/>አሳ ግዶፈ ጎደትስ፤ እያ ካሀይ ላመትን ዶአ ግድስ። ቦራዳ ማታ ምሸ ደምባ ሀረታራ እስፈ ደእስ። እያ አሳተይ ሳሎ አካን ላክስ። ሄስ ሀንዳይ፥ ኡባፈ ቃ ፆሳይ አሳ ናይታ ካዎተ ኡባ ሃረይሳነ ባ ኮይዳይሳስ እመይሳ እ ኤራና መላሳ።<verse eid="DAN 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 5:22"/>“ሽን ብልፃሶራ፥ ኔኒ እያ ናአይ፥ ሀ ኡባ ኤራሸ ነ ነናተ ካዉሻባካ። <verse eid="DAN 5:22"/><verse number="23" style="v" sid="DAN 5:23"/>ቃስ ሳሎ ጎዳ ቦላ ኦቶርታዳ፥ ነናተ ቁ ቁ ኦዳሳ። እያ ኬፈ ቦንቀትድ ይዳ ዎርቃ ሚሸታን ኔኒ፥ ነ ሹማት፥ ነ ማቸትነ ነ ላገት፥ ዎይነ ኡሻ ኡይደታ። ቃስ ፄላናዉ፥ ስአናዉነ ኤራናዉ ዳንዳኦና ብራፐ፥ ዎርቃፈ፥ ናሰ ብራታፐ፥ ብራታፐ፥ ምፈነ ሹቻፈ ኦሰትዳ ፆሳታ ጋላትደታ። ነ ደኡዋነ ነ ኦግያ ባ ኩሸን ኦይክዳ ፆሳ ቦንቻባካ። <verse eid="DAN 5:23"/><verse number="24" style="v" sid="DAN 5:24"/>ሄሳ ግሾ፥ ኩሸ ብራት እያፐ ኪተትን፥ ሀ ፁፈይ ፃፈትስ።<verse eid="DAN 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 5:25"/>“ፁፈይ፥</para>
  <para style="li1" vid="DAN 5:25">‘ማነ፥ ማነ፥ ተቀል፥ ፓረስ’ ያጌስ።<verse eid="DAN 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 5:26"/>“አራምከ ዶናን እያ ብርሸይ ሀይሳ።</para>
  <para style="li1" vid="DAN 5:26">ማነ፦ (ታይበትስ) ‘ፆሳይ ነ ካዎታ ላይ ታይብድ ዉራናዳ ኦስ’ ጉሱ።<verse eid="DAN 5:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="DAN 5:27"/>ተቀል፦ (ማዛነትስ) ‘ምዛነን ማዛነታዳ፥ ካዉያዳ በንታዳሳ’ ጉሱ።<verse eid="DAN 5:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="DAN 5:28"/>ፓረስ፦ (ሻከትስ) ‘ነ ካዎተይ ሻከትድ ሜዶናስነ ፋርሰስ እመትስ’ ” ጉሱ።<verse eid="DAN 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 5:29"/>ሄ ዎደ፥ ብልፃሶራ ኪታን፥ ኦቻ ቴራ ዳንያ ማኡዋ ዳነላ ማይዝዶሶና፤ እያ ቆን ዎርቃ አዶሶና፤ ቃስ ካዎተ ሃርያ ሄን አስ ግዳና መላ አዋጅዶሶና።<verse eid="DAN 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 5:30"/>ሄ ዎደ ቃማ ሞርከት ገልድ፥ ባብሎነ ካዋ ብልፃሶራ ዎዶሶና። <verse eid="DAN 5:30"/><verse number="31" style="v" sid="DAN 5:31"/>እያ ካዎተ፥ ላይ ኡሱፑን ታማነ ናምአ ግድዳ ሜዶና አደይ ዳርዮስ ኤክስ።<verse eid="DAN 5:31"/></para>
  <chapter eid="DAN 5"/>
  <chapter number="6" style="c" sid="DAN 6"/>
  <para style="s1">ዳነል ጋሞ ኦላን</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1"/>ካዎይ ዳርዮስ ባ ካዎተ ኡባ ግዶን ባፐ ጋርሳራ ቢታ ሃርያ ፄታነ ላታሙ አሳታ ሹማናዉ ቆፕስ። <verse eid="DAN 6:1"/><verse number="2" style="v" sid="DAN 6:2"/>ካዋስ አይብካ ፓጮና መላ ሹማታ አዋተን ፄላና መላ ሄ አሳታ ሀላቃ ኦድ ዶርስ፤ ዶረትዳይሳታፐ እሶይ ዳነላ። <verse eid="DAN 6:2"/><verse number="3" style="v" sid="DAN 6:3"/>ዳነል ኦሶ ኦናዉ ባዉ ደእያ ዱማ ኤራን ሀራ ሀላቃታፐነ ሹማታፐ አድ በንትስ። ሄሳ ግሾ፥ ካዎይ እያ ባ ኩመ ካዎተ ቦላ ሹማናዉ ቆፕስ።<verse eid="DAN 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 6:4"/>ቢታ ሹማትነ ሀላቃት ዳነላ ሞታናዉ፥ እ አይስያ አይሱዋ ቦላ ባላ ደማናዉ ኮይዶሶና። ሽን እ፥ ባና ናግያነ አማነትዳ አስ ግድያ ግሾ፥ እያ ሞታናዉ እያ ቦላ አይ ባላካ ደምቦኮና። <verse eid="DAN 6:4"/><verse number="5" style="v" sid="DAN 6:5"/>ዉርሰን ኤንቲ፥ “እያ ፆሳ ህግያ ባጋራ ግዶና እፅኮ፥ ሀራ ባጋራ ዳነላ ሞትያባ ደሞኮ” ያግዶሶና።<verse eid="DAN 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 6:6"/>ሄሳፈ ጉየ፥ ቢታ ሹማትነ ሀላቃት እስፈ ካዋኮ ብድ፥ ሀይሳዳ ያግዶሶና፦ “ካዋዉ ዳርዮሳ፥ መርናዉ ካዎታ! <verse eid="DAN 6:6"/><verse number="7" style="v" sid="DAN 6:7"/>ኑኒ ነ ካዎተ ኦሶ ኦያ ሀላቃት፥ ሹማት፥ አይሰይሳት፥ ዞረይሳትነ ቢታ ሃረይሳት ኡባይ ዞረትዳ እስ ዞረይ ደኤስ። ሄስካ ሀስታሙ ጋላስ ጋካናዉ፥ አይ አስካ ካዋ ዎሳናፐ አትሽን፥ ሀራ አይ አስ ዎይኮ አይ ፆሰ ዎሶናዳ፥ ኔኒ አዋጆ ከሳና መላሳ። ሄ አዋጁዋ ኤኮናይ ጋሞ ኦላን የገታና መላ ኔኒ ኪታ። <verse eid="DAN 6:7"/><verse number="8" style="v" sid="DAN 6:8"/>ህዛ ካዋዉ፥ ሀ አዋጆይ ሻረቶና ሜዶናነ ፋርሰ ህገዳ ምኖነ ላመቶናይሳ ግዳና መላ ፓራማ” ያግዶሶና። <verse eid="DAN 6:8"/><verse number="9" style="v" sid="DAN 6:9"/>ሄሳ ግሾ፥ ካዎይ ዳርዮስ አዋጁዋ ፃፍድ ፓራምስ።<verse eid="DAN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 6:10"/>ዳነል አዋጆይ ፓራመትድ ከይዳይሳ ኤርዳ ዎደ ባ ሶ ብስ፤ ፖቀ ቦላ ደእያ ክፍልያ ገልስ። ሄ ክፍልያ ማስኮተይ የሩሳላመ ባጋ ስሚድ ዶየትድ ደእሽን፥ ካሰ ዎሰይሳዳ ጉልባትድ፥ ባ ፆሳ ጋላትሸ፥ እስ ጋላሳን ሄ ቶሆ ዎሴስ።<verse eid="DAN 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 6:11"/>ሄ አሳት እስፈ ብድ፥ ዳነል ባ ፆሳ ዎስሽንነ ባ ጎዳ ማዶ ኦይችሽን ደምዶሶና። <verse eid="DAN 6:11"/><verse number="12" style="v" sid="DAN 6:12"/>ኤንቲ ካዋኮ ብድ፥ “ካዋዉ፥ ሀስታሙ ጋላሳታ ግዶን ነ አትሽን፥ ሀራ አይ አሰ ዎይኮ አይ ፆሰ ዎስያ ኦንካ ጋሞ ኦላን የገታና መላ አዋጆ ከሳብኪ?” ያግዶሶና።</para>
  <para style="p" vid="DAN 6:12">ካዎይ ዛሪድ፥ “ኤ አዋጃይ ከይስ፤ ሻረቶና ሜዶናነ ፋርሰ ህገዳ ምንዳይሳ” ያግስ።<verse eid="DAN 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 6:13"/>ኤንቲ፥ “ካዋዉ፥ ሄኮ ይሁዳፐ ድኤትድ፥ ይዳ አሳፐ እሶይ፥ ዳነል፥ ነዉ ግድን ነ ፓራማዳ ከስዳ ነ አዋጁዋካ ኪተተና። እ ሀእ ጋካናዉ ጋላሳን ሄ ቶሆ ባ ፆሳ ዎሴስ” ያግዶሶና።<verse eid="DAN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 6:14"/>ካዎይ ሄሳ ስእዳ ዎደ ዳሮ አዛንስ፤ ዳነላ አሻናዉ ቆፕድ፥ አው ዉላና ጋካናዉ እያ አሻና ኦገ ኡባ ኮይስ። <verse eid="DAN 6:14"/><verse number="15" style="v" sid="DAN 6:15"/>ሄ ዎደ አሳት እስፈ ካዋኮ ብድ፥ “ካዋዉ፥ ሜዶናነ ፋርሰ ህግያዳ፥ ካዎይ አዋጅዳ አዋጆይ ዎይኮ ኪታይ ላመቶናይሳ ኤራ” ያግዶሶና።<verse eid="DAN 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16"/>ካዋ ኪታን፥ ዳነላ ኤህድ፥ ጋሞ ኦላን የግዶሶና። ካዎይ ዳነላኮ፥ “ነ ኡባ ዎደ ጎይንያ ፆሳይ ነና አሾ” ያግስ። <verse eid="DAN 6:16"/><verse number="17" style="v" sid="DAN 6:17"/>ኤንቲ ሹቹ ኤህድ፥ ኦላ ዶና ጎርድዶሶና። ኦንካ ዳነላ ቦላ ኦሰትዳባይ ላመቶና መላ፥ ካዎይ ባ ማታመነ ባ ሞርናታ ማታመ ሹቻ ቦላ ዎስ። <verse eid="DAN 6:17"/><verse number="18" style="v" sid="DAN 6:18"/>ካዎይ ባ ጋ ስሚድ፥ ካ ሞናነ ኡፋይስያባ ባኮ ሺሾና፥ ስኮ ይድ አቅስ።<verse eid="DAN 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19"/>ካዎይ ዎንታ ጉራ ደንድድ፥ ኤለስድ ጋሞ ኦላኮ ብስ። <verse eid="DAN 6:19"/><verse number="20" style="v" sid="DAN 6:20"/>እ አዛንሸ ያ ጋክድ፥ “ደኦ ፆሳ አይልያዉ፥ ዳነላ፥ ኔኒ ኡባ ዎደ ጎይንያ ነ ፆሳይ፥ ነና ጋሞታፐ አሻናዉ ዳንዳእዴ?” ያግድ ፄግስ።<verse eid="DAN 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 6:21"/>ዳነል ዛሪድ፥ “ካዋዉ፥ መርናዉ ካዎታ! <verse eid="DAN 6:21"/><verse number="22" style="v" sid="DAN 6:22"/>ታ ፆሳይ ባ ኪታንቹዋ ኪትድ፥ ጋሞታ ዶና ጎርድስ፤ ኤንቲ ታና ቦችቦኮና። ታኒ እያ ስንን ፅሎ፤ ቃስ ካዋዉ፥ ነ ስንንካ ባላ ኦብከ” ያግስ።<verse eid="DAN 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 6:23"/>ካዎይ ዳሮ ኡፋይትድ፥ ዳነላ ኦላፈ ከሳና መላ ኪትስ። ዳነል ኦላፈ ከይስ፤ እ ባ ፆሳን አማነትዳ ግሾ፥ እያ አሳተ ቦላ ቆሆይ በንትቤና። <verse eid="DAN 6:23"/><verse number="24" style="v" sid="DAN 6:24"/>ካዎይ ዳነላ ሞትዳ አሳታ ኤሀና መላ ኪትስ። ኤንቲ ኦይከትድ፥ ባንታ ማቸታራነ ባንታ ናይታራ ይድ፥ ኡባይ ጋሞ ኦላን የገትዶሶና። ኤንቲ ኦላ ዉርሰ ጋኮና ደእሽን፥ ጋሞት ጉፕ ኤክድ፥ ኤንታ መቀ መንረ አግዶሶና።<verse eid="DAN 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25"/>ካዎይ ዳርዮስ አሳስ፥ ካዎተታስነ ዱማ ዱማ ዶናን ኦደትያ ኮቻታስ ሀይሳዳ ያግድ ፃፍስ፦</para>
  <para style="p" vid="DAN 6:25">“ሳሮይ ህንተዉ ግዶ!<verse eid="DAN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 6:26"/>“ታ ካዎተን ደእያ አሳ ኡባይ ዳነላ ፆሳ ያያና መላነ ኮኮራና መላ ታኒ አዋጆ ከሳስ።</para>
  <para style="q1" vid="DAN 6:26">“እ መርናዉ ደእያ ደኦ ፆሳ፤</para>
  <para style="q2" vid="DAN 6:26">እያ ካዎተይ ፖሎ የና፤</para>
  <para style="q2" vid="DAN 6:26">እያ ካዎተስ ዛው ባዋ።<verse eid="DAN 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="DAN 6:27"/>እ፥ አሼስ፤ መቶፐ ከስድ ኤኬስ፤</para>
  <para style="q2" vid="DAN 6:27">ሳሎንነ ሳአን ማላታነ ማላታታ ኦስ፤</para>
  <para style="q2" vid="DAN 6:27">እ፥ ዳነላ ጋሞታ ዶናፐ አሽስ” ያግስ።<verse eid="DAN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 6:28"/>ዳነል ዳርዮሳ ካዎተ ዎደነ ፋርሰ ካዋ ቅሮሳ ካዎተ ዎደ ኡባን እንጀትን ደእስ።<verse eid="DAN 6:28"/></para>
  <chapter eid="DAN 6"/>
  <chapter number="7" style="c" sid="DAN 7"/>
  <para style="s1">ኦይዱ ዶአታ ቆንጨ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1"/>ባብሎነ ካዎይ ብልፃሶር ካዎትዳ ኮይሮ ላይን፥ ዳነል ባ አርሳን ዝንእድ፥ አሙሆነ ቆንጨ በእስ። ባ አሙሁዋን በእዳ አይፈ ቆፋታ ፃፍስ።<verse eid="DAN 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 7:2"/>ዳነል ሀይሳዳ ያግስ፦ “ሳሎፐ ይዳ ኦይዱ ጫርኮት ግታ አባ ቡቅሽን ታ ቃማ ቆንጨን በአስ። <verse eid="DAN 7:2"/><verse number="3" style="v" sid="DAN 7:3"/>እሶይ እሱዋፈ ዱማ ግድዳ ኦይዱ ግታ ዶአት አባፈ ከይዶሶና።<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="REV 13:1">ቆን 13:1</ref>፤ <ref loc="REV 17:8">17:8</ref>.</char></note><verse eid="DAN 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 7:4"/>“ኮይሮ ዶአይ ጋሞ ዳኔስ፤ እያዉ አርጋን ቀፈይ ደኤስ። ታ በእሽን፥ እያ ቀፈይ ሾደትን፥ ሳአፐ ደንድድ፥ አሳዳ ናምኡ ቶሆን ኤቃናዳ ኦሰትስ፤ እያዉ አሳ ዎዛን እመትስ።<verse eid="DAN 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 7:5"/>“ናምአን ዶአይ እስ ባጋ ቁ ግድ ኤቅዳ ባባን ጌተትያ ዶአ ዳኔስ። ሄ ዶአይ ሄ ጋይለ መቀ ባ ዶናን ባርድ፥ ባ አቻን ሳፅድ ኦይክስ። እካ፥ ‘ደንዳ፤ ካላና ጋካናዉ አሾ ማ’ ጌተትስ።<verse eid="DAN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 7:6"/>“ሄሳፈ ካላዳ፥ ማሄ ዳንያ ሀራ ዶአ በአስ። እያ ዞኮን ካፎ ቀፈ ዳንያ ኦይዱ ቀፈት ደኦሶና። እያዉ ኦይዱ ሁጰት ደኦሶና፤ እያዉ ሃሮ ማት እመትስ።<verse eid="DAN 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 7:7"/>“ሄሳፈ ጉየ፥ ቃማ ቆንጨን ያሽያ፥ ዳጋንያነ ዳሮ ምኖ ግድዳ ኦይዳን ዶአ በአስ። እያዉ ግታ ብራታ አች ደኤስ። እ ባናን ጋሄትያ ኡባ ኤንታን መንረድ ሜስ፤ አትዳይሳታ ባ ቶሁዋን የረስ። ካሰ ታ በእዳ ዶአታ ኡባፈ እ ዱማቴስ፤ እያዉ ታሙ ካጨይ ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="REV 12:3">ቆን 12:3</ref>፤ <ref loc="REV 13:1">13:1</ref>.</char></note> <verse eid="DAN 7:7"/><verse number="8" style="v" sid="DAN 7:8"/>ታኒ ሄ ካጨታባ ቆፕሽን፥ ኤንታ ግዶፈ ሀራ እስ ጉ ካጨይ ከይሽን በአስ። ሄ ካጨይ ሀንኮ ካጨታፐ ሄታ ቆልድ ሆልስ። ሄ ቃጭያስ አሳ አይፈ ዳንያ አይፈይነ ኦቶሮን ኦደትያ እንፃርስ ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="REV 13:5-6">ቆን 13:5-6</ref>.</char></note><verse eid="DAN 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9"/>“ታኒ ሄሳ በእሽን፥ አራታት ኡተስ ጊግዶሶና። መርናዉ ደኤይስ ባ አራታን ኡትስ፤ እያ ማኦይ ሻቻዳ፥ እያ ሁጰ ብናናይ ሙቃዳዳ ቦ። እያ አራታይነ አራታ ገርቶይ ታማዳ ሎጬስ።<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 20:4">ቆን 20:4</ref>፤ <ref loc="REV 1:14">1:14</ref>.</char></note> <verse eid="DAN 7:9"/><verse number="10" style="v" sid="DAN 7:10"/>እያ አራታ ግዶፈ ታማ ሻፍ ፑልትድ፥ ከዬስ። ሙኩሉ ቶሆ ሙኩላን ታይበተይሳት እያዉ ኦሶና፤ ታሙ ሙኩሉ ቶሆ ታሙ ሙኩላን ታይበተይሳት እያ ስንን ኤቆሶና። ፕርድ ዶመትስ፤ ማፃፋት ዶየትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="REV 5:11">ቆን 5:11</ref>፤ <ref loc="REV 20:12">20:12</ref>.</char></note><verse eid="DAN 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 7:11"/>“ካጨይ ኦደትያ ኦቶሮ ቃላ ታኒ ስእዳ ግሾ፥ እያ ጫዳ ፄላስ። ታኒ በእሽን ዶአይ ሀይቅድ፥ ኤፅያ ታማን የገትድ፥ ይስ። <verse eid="DAN 7:11"/><verse number="12" style="v" sid="DAN 7:12"/>ሀንኮ ሄ ዶአታ ማታይ ኤከትስ፤ ሽን ኤንቲ ጉ ዎደ ደኦን ዳና መላ ኤንታዉ እመትስ።<verse eid="DAN 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13"/>“ታኒ፥ ቃማ ቆንጨን፥ አሳ ናአ ዳነይስ ሳሎፐ ሻራራ ይሽን በአስ። መርናዉ ደኤይሳኮ ሺቅን፥ እያ ስን አዶሶና።<note caller="-" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="MAT 24:30">ማቶ 24:30</ref>፤ <ref loc="MAT 26:64">26:64</ref>፤ <ref loc="MRK 13:26">ማር 13:26</ref>፤ <ref loc="MRK 14:62">14:62</ref>፤ <ref loc="LUK 21:27">ሉቃ 21:27</ref>፤ <ref loc="REV 1:7">ቆን 1:7</ref>፥ <ref loc="REV 1:13">13</ref>፤ <ref loc="REV 14:14">14:14</ref>.</char></note> <verse eid="DAN 7:13"/><verse number="14" style="v" sid="DAN 7:14"/>እያዉ ማት፥ ቦንቾይነ ካዎተ እመትስ፤ ደረይ፥ ካዎተትነ ዱማ ዱማ ዶናን ኦደትያ ኡባይ ሃረትዶሶና። እያ ማታይ መርናዉ ሻረቶና ማታ፤ እያ ካዎተስ ዛው ባዋ።<verse eid="DAN 7:14"/></para>
  <para style="s1">ቆንጨ ብርሸ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15"/>“ታኒ፥ ዳነል፥ ታ በእዳባን ዳጋማስ፤ ቆንጨይ ታና ህርግስስ። <verse eid="DAN 7:15"/><verse number="16" style="v" sid="DAN 7:16"/>ታኒ ያን ኤቅዳይሳታፐ እሱዋኮ ሺቃዳ፥ ሀ ኡባስ ቱማ ብርሸይ አይበኮ ኦይቻስ። እ ታዉ እያ ብርሸ ኡባ ሀይሳዳ ያግድ ኦድስ፦ <verse eid="DAN 7:16"/><verse number="17" style="v" sid="DAN 7:17"/>‘ሀ ኦይዱ ግታ ዶአት ሳአን ስንፈ ደንዳና ኦይዱ ካዎተታ። <verse eid="DAN 7:17"/><verse number="18" style="v" sid="DAN 7:18"/>ሽን ኡባፈ ቃ ፆሳ ጌሻት እያ ካዎተ ኤክድ፥ መርናዉ ባንታባ ኦና፤ መርናዉ ካዎተ ኤንቲ ላታና’ ያግስ።<verse eid="DAN 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 7:19"/>“ሄሳፈ ጉየ፥ ታኒ ሀራ ዶአታ ኡባፈ ዱማ ግድዳ ያሽያ ኦይዳን ዶኣስ ደእያ ቱማ ብርሸ ኤራናዉ ኮያስ። ሄ ዶኣስ ብራታ አችነ ናሰ ብራታ ፁጉን ደኤስ፤ እ ባናን ጋሄትያ ኡባ መንረድ ሜስ፤ አትዳይሳ ባ ቶሁዋን የረስ። <verse eid="DAN 7:19"/><verse number="20" style="v" sid="DAN 7:20"/>ሄ ዶኣ ሁጰን ደእያ ታሙ ካጨታባነ ጉየፐ ከይድ፥ ኤንታፈ ሄታ ቆልድ የግዳ ጉ ካጭያባ ኤራናዉ ኮያስ። ሄ ጉ ቃጭያስ አይፈይነ ኦቶሮ ቃላ ኦደትያ እንፃርስ ደኤስ። ሄ ካጨይ ሀንኮታፐ አድ ያሼስ። <verse eid="DAN 7:20"/><verse number="21" style="v" sid="DAN 7:21"/>ታኒ በእያ ዎደ ሄ ካጨይ ጌሻታራ ኦለትድ፥ ኤንታ ፆንስ። <verse eid="DAN 7:21"/><verse number="22" style="v" sid="DAN 7:22"/>ሄስ ሀንዳይ፥ መርናዉ ደኤይስ ያና ጋካናዉነ ኡባፈ ቃ ፆሳ ጌሻታስ ፕርዳና ጋካናሳ፤ ኤንቲ ካዎተ ላትያ ዎደይ ጋክስ።<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="REV 20:4">ቆን 20:4</ref>.</char></note><verse eid="DAN 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23"/>“እ ብርሸ ታዉ ሀይሳዳ ያግድ ኦድስ፤ ‘ኦይዳን ዶአይ ሀ ሳአን ስንፈ ደንዳና ኦይዳን ካዎተ። ሄ ካዎተይ ሀራ ካዎተ ኡባፈ ዱማ፤ እ፥ ቢታ ኡባ ማና፥ የናነ መንረና። <verse eid="DAN 7:23"/><verse number="24" style="v" sid="DAN 7:24"/>ታሙ ካጨት ሀ ካዎተፈ ደንዳና ታሙ ካዎታ። ሄሳፈ ጉየ፥ ካሰ ታሙ ካዎታፐ ዱማ ግድዳ ሀራ ካዎይ ደንዳና። እ፥ ኤንታፈ ሄ ካዎታ ፆንድ ሃራና።<note caller="-" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="REV 17:12">ቆን 17:12</ref>.</char></note> <verse eid="DAN 7:24"/><verse number="25" style="v" sid="DAN 7:25"/>እ፥ ኡባፈ ቃ ፆሳ ቦላ ኦቶሮን ኦደታና፤ ኡባፈ ቃ ፆሳ ጌሻታ ኡንኤና። ቃስ ዎደታነ ህግያ ላማናዉ አሞታና። ዎደይ፥ ዎደትነ ዎደ ባጋይ ጋካናዉ፥ ጌሻት እያ ማታፐ ጋርሳን ሃረታና። <verse eid="DAN 7:25"/><verse number="26" style="v" sid="DAN 7:26"/>ሽን ፕርድ ዶመታና፤ እያ ማታይ ኩመ ኤከታና፤ እ መርናዉ ያና። <verse eid="DAN 7:26"/><verse number="27" style="v" sid="DAN 7:27"/>ሳሎፐ ጋርሳን ደእያ ካዎተታ ማታይ፥ ዎልቃይነ ግታተይ፥ ኡባፈ ቃ ፆሳ ጌሻታስ እመታና። እያ ካዎተይ መርናዉ ዳና፤ ቢታ ሃረይሳት እያዉ ኪተታና፤ እያ ጎይናና’ ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="REV 20:4">ቆን 20:4</ref>፤ <ref loc="REV 22:5">22:5</ref>.</char></note><verse eid="DAN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 7:28"/>ታ ቆንጨባይ ሀይሳን ዉርስ። ታኒ፥ ዳነል፥ ታ ቆፋን ዳሮ ዳጋማስ፤ ታ ሶምኦይ ብዶ ግድስ። ሽን ኡባባ ታኒ ታ ዎዛናን ዎስ።<verse eid="DAN 7:28"/></para>
  <chapter eid="DAN 7"/>
  <chapter number="8" style="c" sid="DAN 8"/>
  <para style="s1">ዳነል በእዳ ዶርሰነ ዴሸ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1"/>ብልፃሶር ካዎትዳ ሄን ላይን፥ ታኒ፥ ዳነል፥ ካሰ በእዳ ቆንጨፈ ሀራ ቆንጨ በአስ። <verse eid="DAN 8:1"/><verse number="2" style="v" sid="DAN 8:2"/>ሄ ቆንጨን፥ ኤላማ ቢታን፥ ሱሳ ካታማን፥ ኡባላ ሻፋ ማታን ኤቃዳ ታና ደማስ። <verse eid="DAN 8:2"/><verse number="3" style="v" sid="DAN 8:3"/>ሄ ሻፋ ማታን ናምኡ አዱሳ ካጨት ደእያ ዶርስ ኤቅስ። ናምኡ ካጨታፐ እሶይ ጉየፐ ዶልስ፤ ሽን ኮይሮ ዶልዳይሳፈ አዱሰ። <verse eid="DAN 8:3"/><verse number="4" style="v" sid="DAN 8:4"/>ሄ ዶርሳይ ባ ካጭያን ቃይጫናዉ፥ ዉሎሀ፥ ፑደሀነ ዱገሀ ባጋ ኮልሽን በአስ። እያራ ኤቀታናዉነ እያ ዎልቃፈ ከስ ኤካናዉ አይ መሄይካ ዳንዳእቤና። እ፥ ባ ኮይዳባ ኦስ፤ ያትድ ግታ ግድስ።<verse eid="DAN 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5"/>ታኒ ሀ ቆንጨባ ቆፕሽን፥ እስ ዴሽ ዉሎሀ ባጋፈ ከይድ፥ ቢታ ካንድ፥ ቶሆይ ሳአ የና ይስ። እያ ናምኡ አይፈታፐ ግዶን እስ ግታ ካጨይ ደኤስ። <verse eid="DAN 8:5"/><verse number="6" style="v" sid="DAN 8:6"/>እ፥ ዳሮ ይሎራ፥ ሻፋ ማታን ታኒ በእዳ ናምኡ ካጨራ ደእያ ዶርሳኮ ይስ። <verse eid="DAN 8:6"/><verse number="7" style="v" sid="DAN 8:7"/>እ፥ ዳሮ ይሎትድ፥ ታ በእሽን፥ ዶርሳ ካጨት ናምአይ መቃና ጋካናዉ፥ ኢታ ዶምኤ ዶምእስ። ዶርሳይ እያራ ኤቀታናዉ ዎልቅ ይስ፤ ዴሻይ እያ ሳአን የግድ የድ ኤቅስ። ዴሻ ዎልቃፈ ሄ ዶርሳ አሽያባይ ባዋ። <verse eid="DAN 8:7"/><verse number="8" style="v" sid="DAN 8:8"/>ሄ ዴሻይ ዳሮ ዎልቃምስ፤ ሽን እያ ዎልቃይ ዳርሸ ብን፥ እያ ግታ ካጨይ መቅስ። እያ በሳን ኦይዱ ግታ ካጨት ቢታ ኦይዱ ባጋ ስሚድ ድጭዶሶና።<verse eid="DAN 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 8:9"/>ሀ ኦይዱ ካጨታፐ እሱዋ ቦላ ሀራ ጉ ካጨይ ዶልድ፥ ዱገሀ፥ ዶሎሀነ እስራኤለ ቢታኮ ስሚድ ዎልቃራ ድጭስ። <verse eid="DAN 8:9"/><verse number="10" style="v" sid="DAN 8:10"/>እ፥ ብድ ሳሎን ደእያ ኦላንቾታ ጋካናዉ ድጭድ፥ ሳሎ ፆልንቶታፐ ጉታ ሳአን የግድ ኤንታ የስ።<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="REV 12:4">ቆን 12:4</ref>.</char></note> <verse eid="DAN 8:10"/><verse number="11" style="v" sid="DAN 8:11"/>ሳሎ ቶራ ሞጮና ግድዳ ፆሳራ ባና ልክሳና ጋካናዉ ቁ ቁ ግስ። እያዉ ጋላስ ጋላስ ያርሸትያ ያርሹዋ ድግስ፤ እያ ኬካ ቱንስስ። <verse eid="DAN 8:11"/><verse number="12" style="v" sid="DAN 8:12"/>ናጋራ ጋሶን ኦላንቾትነ ጋላስ ጋላስ ያርሸትያ ያርሾይ ሄ ካጭያስ እመትስ። ቱም ሳአን ሆለትስ፤ ሄ ካጨይ ኦያባ ኡባይ እያዉ እንጀትስ።<verse eid="DAN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 8:13"/>ሄሳፈ ጉየ፥ እስ ጌሻ ኪታንቾይ፥ ሀራ ጌሻ ኪታንቹዋራ ኦደትሽን ታኒ ስአስ። እሶይ እሱዋ፥ “ጋላስ ጋላስ ያርሸትያ ያርሹዋባ፥ ዮ ኤህያ ማካላተባ፥ ሳሎ ኦላንቾትነ ፆሳ ኬይ የትሸ ዳናባ ኦድያ፥ ቆንጨይ አዉደ ፖለታኔ?” ያግድ ኦይችስ።<verse eid="DAN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 8:14"/>እ ዛሪድ፥ “ናምኡ ሙኩሉነ ሄ ፄቱ ዎንታነ ኦማርስ ጋካናዉ ጋምአና፤ ሄሳፈ ጉየ፥ ፆሳ ኬይ ጌያና” ያግድ ኦድሽን ስአስ።<verse eid="DAN 8:14"/></para>
  <para style="s1">ቆንጨ ብርሸ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15"/>ታኒ፥ ዳነል፥ ሀ ቆንጨ በአሸነ እያ ብርሸ ኤራናዉ ቆፓሸ ደእሽን፥ እስ አሰ ዳንያባይ ታ ስንን ኤቅዳይሳ በአስ። <verse eid="DAN 8:15"/><verse number="16" style="v" sid="DAN 8:16"/>ኡባላ ሻፋፐ፥ “ጋብሬላ፥ ሀ አድያስ ሀ ቆንጨ ብርሸ ኦዳ” ግያ ግርስ ስአስ።<verse eid="DAN 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 8:17"/>እ፥ ይድ ታ ማታን ኤቅዳ ዎደ፥ ታኒ ዳጋማዳ፥ ሳአን ኩንዳስ። እ ታኮ፥ “አሳ ናአዉ፥ ሀ ቆንጨይ ዉርሰ ዎድያባ ኦደይሳ አኬካ” ያግስ።<verse eid="DAN 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 8:18"/>እ ታራ ኦደትያ ዎደ፥ ታኒ ሳአን ታ ሶምኡዋራ ጉፋናዳ፥ ታና ባላ አጋስ። እ ታና ሳኣፐ ደንድ፥ ታ ቶሁዋን ኤስስ። <verse eid="DAN 8:18"/><verse number="19" style="v" sid="DAN 8:19"/>እ ታኮ፥ “ሀ ቆንጨይ ዉርሰ ዎድያባ በሲያ ግሾ፥ ጎዳ ሀንቆ ጋላሳን ሀናናዉ ደእያባ ታ ነዉ ኦዳና። <verse eid="DAN 8:19"/><verse number="20" style="v" sid="DAN 8:20"/>ኔኒ በእዳ ናምኡ ካጨራ ደእያ ዶርሳይ፥ ሜዶናነ ፋርሰ ካዎታ ሌምሶ። <verse eid="DAN 8:20"/><verse number="21" style="v" sid="DAN 8:21"/>ዴሻይ ግርከ ካዋ ሌምሶ፤ እያ ናምኡ አይፍያፐ ግዶን ደእያ ግታ ካጨይ ግርከ ካዋ። <verse eid="DAN 8:21"/><verse number="22" style="v" sid="DAN 8:22"/>ካጨ መቅን እያ በሳን ዶልዳ ኦይዱ ካጨት እያ ካዎተፈ ሻከትድ ከያና ኦይዱ ካዎተታ ሌምሶ። ሽን ኤንታ ዎልቃይ ኮይሮ ካዋ ዎልቃ ጋከና።<verse eid="DAN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 8:23"/>“ኤንታ ካዎተ ዉርሰን፥ ኤንታ ናጋራይ ዛዋ ጋክያ ዎደ፥ ኢታነ ጭምያ ካዎይ ደንዳና። <verse eid="DAN 8:23"/><verse number="24" style="v" sid="DAN 8:24"/>እ ዳሮ ምኖ ግዳና፤ ሽን ባ ዎልቃን ግደና። እ ዳጋንያ ዮ ይሳና፤ እ ኦያባ ኡባይ እያዉ እንጀታና። እ ምኖ አሳታነ ጌሻ አሳታ ይሳና። <verse eid="DAN 8:24"/><verse number="25" style="v" sid="DAN 8:25"/>እ ጭምያ ግሾ እያዉ እንጀታና፤ እ ባና ኡባፈ ቁ ቁ ኦና። ኤንቲ ሳእ ሳሮ ግድ ደእሽን፥ ኤንታፈ ዳሮታ ዎና። እ ሀላቃታ ሀላቃራ ኤቀታና፥ ሽን እ፥ አስ ቦቾና ባዉ ያና።<verse eid="DAN 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 8:26"/>“ነዉ ኦደትዳ ናምኡ ሙኩሉነ ሄ ፄቱ ዎንታነ ኦማርሳ ቆንጨይ ቱማ። ሽን ሀ ቆንጨይ ዳሮ ዎደፐ ጉየ ፖለታናዉ ደእያ ግሾ፥ ማታመ እያ ቦላ ዎዳ ጎርዳዳ ናጋ” ያግስ።<verse eid="DAN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 8:27"/>ታኒ ዳነል፥ ዳሮ ዳቡርዳ ግሾ፥ ሳከታዳ ዳሮ ጋላስ ዝንአስ። ሄሳፈ ጉየ ደንዳዳ፥ ካዋ ኦሶስ ባስ። ሀ ቆንጨን ታኒ ዳሮ ዳጋማስ፤ አኬካናዉ ዳንዳአብከ።<verse eid="DAN 8:27"/></para>
  <chapter eid="DAN 8"/>
  <chapter number="9" style="c" sid="DAN 9"/>
  <para style="s1">ዳነላ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1"/>ሜዶና አስ ግድዳ አርፀክስሳ ናአይ፥ ዳርዮስ ባብሎነን ካዎትስ። <verse eid="DAN 9:1"/><verse number="2" style="v" sid="DAN 9:2"/>እ ካዎትዳ ኮይሮ ላይን፥ ታኒ ዳነል፥ ጌሻ ማፃፋታ ናባባሸ፥ ናበይ ኤርምያስ ኦድዳይሳዳ፥ የሩሳላመይ ላፑን ታሙ ላይ ላለትድ ጋምአናዉ ደኤይሳ አኬካስ።<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="JER 25:11">ኤርም 25:11</ref>፤ <ref loc="JER 29:10">29:10</ref>.</char></note> <verse eid="DAN 9:2"/><verse number="3" style="v" sid="DAN 9:3"/>ሄሳ ግሾ፥ ካዮ ማኦ ማአዳ፥ ብዶ ታ ሁጰን ቆላዳ፥ ፆማሸነ ዎሳሸ ታ ጎዳ ፆሳኮ ታ ሶምኡዋ ዛራስ።<verse eid="DAN 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 9:4"/>ታ ናጋራ ፓፃሸ፥ ጎዳ፥ ታ ፆሳ ሀይሳዳ ያጋዳ ዎሳስ፦ “አቤት ጎዳዉ፥ ዎልቃማነ ያሽያ ፆሳዉ፥ ነና ዶሰይሳታስነ ነዉ ኪተተይሳታስ ነ መርና ሲቁዋነ ጫቁዋ ናገይሶ፥ <verse eid="DAN 9:4"/><verse number="5" style="v" sid="DAN 9:5"/>ኑ ናጋራ ኦዳ ባልዳ። ኑ ኢታባ ሀንዳ፤ ማካልዳ፤ ነ ኪታፐነ ነ ህግያፈ ካረ ከይዳ። <verse eid="DAN 9:5"/><verse number="6" style="v" sid="DAN 9:6"/>ኑ ካዎታስ፥ ኑ ሀላቃታስ፥ ኑ አዋታስነ ቢታን ደእያ አሳ ኡባስ ነ ሱንን ትንብተ ኦድዳ ነ ናበታ ስኦና እፅዳ።<verse eid="DAN 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 9:7"/>“አቤት ጎዳዉ፥ ነ ፅሎ፤ ሽን ኑኒ ሀች ዬላ ማእዳ። ይሁዳንነ የሩሳላመን ደእያ አሳ ኡባይ ነዉ አማነቶና እፅን፥ ነ ሃሆ ቢታንነ ማታ ቢታን ላልዳ እስራኤለ አሳ ኡባይ ዬላትዳ። <verse eid="DAN 9:7"/><verse number="8" style="v" sid="DAN 9:8"/>አቤት ጎዳዉ፥ ኑኒ፥ ኑ ካዎት፥ ኑ ሀላቃትነ ኑ አዋት ነና ናቅዳ ግሾ ዬላ ማእዳ። <verse eid="DAN 9:8"/><verse number="9" style="v" sid="DAN 9:9"/>ሽን ኑ እያ ቦላ ማካልኮካ፥ ጎዳይ ኑ ፆሳይ ማርያነ አቶ ግያ ፆሲ። <verse eid="DAN 9:9"/><verse number="10" style="v" sid="DAN 9:10"/>ኑኒ ኑ ጎዳ፥ ኑ ፆሳ፥ ኪተትቦኮ፤ ቃስ ባ ናበታ ባጋራ እምዳ እያ ህግያ ናግቦኮ። <verse eid="DAN 9:10"/><verse number="11" style="v" sid="DAN 9:11"/>እስራኤለ አሳ ኡባይ ነ ህግያ መንድ፥ ካረ ከይዶሶና፤ ነዉ ኪተትቦኮና።</para>
  <para style="p" vid="DAN 9:11">“ኑ ነ ቦላ ናጋራ ኦዳ ግሾ፥ ፆሳ አይልያ ሙሰ ህገ ማፃፋን ፃፈትዳ ባደይነ ፕርዳይ ኑ ቦላ ጋክስ። <verse eid="DAN 9:11"/><verse number="12" style="v" sid="DAN 9:12"/>ቃስ ኑ ቦላነ ኑና ካለይሳታ ቦላ ግታ መቶ ኤሀናዉ ነ ኦድዳ ቃላ ኑ ቦላ ፖላዳሳ። የሩሳላመ ቦላ ጋክዳ መቱዋ መል ሳሎፐ ጋርሳን ሀራ ቢታ ቦላ ጋክቤና። <verse eid="DAN 9:12"/><verse number="13" style="v" sid="DAN 9:13"/>ሙሰ ህግያን ፃፈትዳይሳዳ፥ ሀ ዮ ኡባይ ኑ ቦላ ጋክስ። ኑኒ ኑ ናጋራፐ ስምቦኮ፤ ነ ቱማ ስእቦኮ፤ ነና፥ ጎዳ፥ ኑ ፆሳ ማሮታ ኦይችቦኮ። <verse eid="DAN 9:13"/><verse number="14" style="v" sid="DAN 9:14"/>ጎዳይ ሀ ዩዋ ኑ ቦላ ኤሀናዉ ጉየ ግቤና። ጎዳይ፥ ኑ ፆሳይ ባ ኦያባ ኡባን ፅሎ፥ ሽን ኑ እያዉ ኪተቶና እፅዳ።<verse eid="DAN 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 9:15"/>“አቤት ጎዳዉ፥ ኑ ፆሳዉ፥ ካሰ ነ አሳ፥ ነ ምኖ ኩሽያን ግብፀፈ ከሳዳ፥ ሀች ጋካናዉ ነ ሱን ፄግሳዳሳ፤ ኑኒ ናጋራ ኦዳ፤ ባልዳ። <verse eid="DAN 9:15"/><verse number="16" style="v" sid="DAN 9:16"/>አቤት ጎዳዉ፥ ኔኒ ካሰ ነ ፅሎ ኦሶ ኡባ ኦዳይሳዳ፥ ሀእ ነ ሀንቁዋነ ነ ጋዱዋ ነ ካታማፐ፥ የሩሳላመፐ፥ ነ ጌሻ ዙማፐ ደን። ኑኒ ኦዳ ናጋራይነ ኑ አዋት ኦዳ ባላይ የሩሳላመነ ነ አሳ ኑ ዩሹዋን ደእያ ኡባ ስንን ካዉሽስ።<verse eid="DAN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 9:17"/>“ህዛ ኑ ፆሳዉ፥ ታኒ ነ አይለይ ዎስያ ዎሳነ ማጋኑዋ ስአ። ጎዳዉ፥ ነ ሱን ግሾ ጋዳ፥ ሀ ላለትዳ ነ ኬ፥ ነ ኬሀ አይፍያን ፄላ። <verse eid="DAN 9:17"/><verse number="18" style="v" sid="DAN 9:18"/>አቤት ታ ፆሳዉ፥ ነ ሀይ ኑኮ ዛራ፤ ነ አይፍያ ዶያዳ፥ ነ ሱንይ ፄገትዳ ካታማ ዩዋ በአ። ኑኒ፥ ነና ዎሰይ፥ ኑ ፅሎተ ግሾ ግዶናሽን፥ ነ ግታ ማሮተ ግሾሳ። <verse eid="DAN 9:18"/><verse number="19" style="v" sid="DAN 9:19"/>አቤት ጎዳዉ፥ ስአ! አቤት ጎዳዉ፥ አቶ ጋዳ! አቤት ጎዳዉ፥ ነ ኦሱዋ ቆንጭሳ! ነ ካታማይነ ነ አሳይ ነ ሱንን ፄገትዳ ግሾ፥ አቤት ታ ፆሳዉ፥ ነ ሱን ግሾ ጋምኦፋ።”<verse eid="DAN 9:19"/></para>
  <para style="s1">ጋብሬለይ ስንፈ ሀናናባ ኦድስ</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20"/>ታኒ ዎሳሸ፥ ታ ናጋራነ ታ አሳ እስራኤለ ናጋራ ፓፃሸነ ታ ፆሳ ጌሻ ዙማባ፥ የሩሳላመባ ጎዳ፥ ታ ፆሳስ ኦዳሸ ጋምአስ። <verse eid="DAN 9:20"/><verse number="21" style="v" sid="DAN 9:21"/>ታኒ ዎሳ ቦላ ደእሽን፥ ካሰ ቆንጨን ታ በእዳ ጋብሬለይ፥ ታኮ ኤሶን ፕራሸ፥ ኦማርሳ ያርሾ ያርሽያ ዎደ ፑቱ ግስ።<note caller="-" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LUK 1:19">ሉቃ 1:19</ref>፥ <ref loc="LUK 1:26">26</ref>.</char></note> <verse eid="DAN 9:21"/><verse number="22" style="v" sid="DAN 9:22"/>እ ሀይሳዳ ያግድ፥ ታዉ ኦድስ፦ “ዳነላ፥ ታ ነዉ ኤራነ አኬካ እማናዉ ሀእ ያስ። <verse eid="DAN 9:22"/><verse number="23" style="v" sid="DAN 9:23"/>ኔኒ ቡሮ ዎሳ ዶምዳ ዎደ ነ ዎሳ ዛሮይ እመትስ፤ ታ ሄሳ ነዉ ኦዳናዉ ያስ። ፆሳይ ነና ዳሮ ዶሴስ። ሄሳ ግሾ፥ ታ ኦደይሳ ቆፓ፤ ቆንጨ አኬካ።<verse eid="DAN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 9:24"/>“ፆሳይ ነ አሳስነ ነ ጌሻ ካታማስ ቃችዳ ዎደይ፥ ላፑን ቶሆ ላፑን ታሙ ላይ። ሄ ዎደ ናቆይ ዉራና፤ ናጋራ ኦሶይ አታና፤ ቆሆይ አቶ ጌተታና፤ መርና ፅሎተ ካዎታና፤ ቆንጨነ ትንብተይ ፖለታና<note caller="+" style="f"><char style="fr" closed="false">9:24 </char><char style="fq" closed="false">ቆንጨነ ትንብተይ ፖለታና፦ </char><char style="ft" closed="false">እብራወ ዶናን ቆንጨይነ ትንብተይ ቱማ ግደይስ አታመታና ጌስ።</char></note> ኡባፈ ጌሻ በሳይ ትየታና።<verse eid="DAN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 9:25"/>“ሀይሳ ኤራ፤ አኬካ። የሩሳላመ ኦራናዉነ ኬፃናዉ ኪት ከይዳ ጋላሳፐ ብድ ትየትዳ ሀላቃይ ያና ጋካናዉ፥ ላፑን ቶሆ ላፑናነ ኡሱፑን ታማነ ናምኡ ቶሆ ላፑን ላይ አና። ሄ ዎደ የሩሳላመ ካታማይ ኦራፃና፤ ኦገትነ ዩሾ ግምበት ኦሰታና፤ ሽን ግምበትያ ዎደይ፥ መቶ ዎደ ግዳና። <verse eid="DAN 9:25"/><verse number="26" style="v" sid="DAN 9:26"/>ኡሱፑን ታማነ ናምኡ ቶሆ ላፑን ላይፈ ጉየ ትየትዳይስ ሀይቃና፤ እያዉ አይኮይካ አትቤና። ያና ሀላቃ ኦላንቾት ካታማነ ፆሳ ኬ ላላና። ሄ ካታማ ዉርሰይ ድኦዳ አኬኮና ያና። ሄ ዎደፐ ብድ ዉርሰ ጋካናዉ ኦልነ ዮይ አዋጀትስ። <verse eid="DAN 9:26"/><verse number="27" style="v" sid="DAN 9:27"/>ላፑን ላይ ግዶን፥ ሄ ሀላቃይ አሳራ ምኖ ጫቆ ጫቀታና። ሄ ላፑን ላይታ ባጋ ዛዋን ያርሾነ እሞታ ድጋና። አዋጀትዳ ፕርዳይ፥ እያ ቦላ ትገታና ጋካናዉ፥ እ ዮ ኤህያ ቱናተ ፆሳ ኬን ኤሳና”<note caller="-" style="x"><char style="xo" closed="false">9:27 </char><char style="xt" closed="false"><ref loc="DAN 11:31">ዳነ 11:31</ref>፤ <ref loc="DAN 12:11">12:11</ref>፤ <ref loc="MAT 24:15">ማቶ 24:15</ref>፤ <ref loc="MRK 13:14">ማር 13:14</ref>.</char></note> ያግስ።<verse eid="DAN 9:27"/></para>
  <chapter eid="DAN 9"/>
  <chapter number="10" style="c" sid="DAN 10"/>
  <para style="s1">ዳነል አሙሆን በእዳ አድያ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1"/>ፋርሰ ካዎይ ቅሮስ ካዎትዳ ሄን ላይን፥ ብልፃሶራ ጌተትያ ዳነል ሀራ ቆንጨ በእስ። ሄ ቆንጨይ ቱማ፤ ቆንጭዳባይ ዎልቃማ ኦላባ። ሄ ቆንጨ ኤራና መላ አኬክ እያዉ እመትስ።<verse eid="DAN 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 10:2"/>ሄ ዎደ ታኒ፥ ዳነል፥ ሄ ሳምንታ ዬካስ። <verse eid="DAN 10:2"/><verse number="3" style="v" sid="DAN 10:3"/>ሄ ሳምንታይ ዉራና ጋካናዉ ካ ማብከ፤ አሾይ ዎይኮ ዎይነ ኡሽ ታ ዶናኮ ሺቅበና፤ ታ ሁጵያ ትየታብከ <verse eid="DAN 10:3"/><verse number="4" style="v" sid="DAN 10:4"/>ኮይሮ አጌናን ላታማነ ኦይዳን ጋላሳን፥ ግታ ፀግሮሳ ሻፋ ማታን ኤቃስ። <verse eid="DAN 10:4"/><verse number="5" style="v" sid="DAN 10:5"/>ታኒ ፄልያ ዎደ ሊኖ ማኦ ማእዳ እስ አድያ በአስ። እ ባ ፄሳን አፌዛ ዎርቃፈ ኦሰትዳ ዳንጮ ዳንጭስ። <verse eid="DAN 10:5"/><verse number="6" style="v" sid="DAN 10:6"/>እያ አሳተይ ጶልያ አልኦ ሹቹ ዳኔስ፤ እያ ሶምኦይ ዎልአን መላ ዎልአሜስ፤ እያ አይፈይ ታማ ላጮ ዳኔስ፤ እያ ኩሸይነ እያ ቶሆይ ቁሸትዳ ናሰ ብራታዳ ፖኤስ፤ እያ ቃላይ ዳሮ አሳ ግርሳዳ ኮሽሜስ።<verse eid="DAN 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 10:7"/>ሀ ቆንጨ ታኒ፥ ዳነል ታርካ በአስ። ታራ ደእያ አሳይ በእቦኮና፤ ኤንቲ ዳሮ ዳጋምዳ ግሾ ባቃትድ ቆሰትዶሶና። <verse eid="DAN 10:7"/><verse number="8" style="v" sid="DAN 10:8"/>ታኒ ሀ ግታ ቆንጨ በአሸ፥ ታርካ አታስ። ታዉ ዎልቅ እፅን ዳቡራስ፤ ታ ሶምኦይ ቡላትስ። <verse eid="DAN 10:8"/><verse number="9" style="v" sid="DAN 10:9"/>ታኒ እያ ኮሽንቻ ስእዳ ዎደ ሳአን ታ ሶምኡዋራ ጉፋናዳ፥ ታና ባላ አጋስ።<verse eid="DAN 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 10:10"/>ሄሳፈ ጉየ፥ እስ ኩሸይ ታና ቦችስ፤ ታኒ ኮኮራሽን፥ ታ ኩሽያንነ ታ ጉልባታን ታና ደንድ ኤስስ። <verse eid="DAN 10:10"/><verse number="11" style="v" sid="DAN 10:11"/>እ ታኮ፥ “ዳሮ ዶሰትዳ ዳነላ፥ ታኒ ነዉ ኦድያ ቃላ ሎይዳ አኬካ፤ ደንዳ ኤቃ። ታኒ ኪተታዳ ኔኮ ያስ” ያግስ። እ ታኮ ሀይሳዳ ግን፥ ታኒ ኮኮራሸ ደንዳ ኤቃስ።<verse eid="DAN 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 10:12"/>ቃስካ፥ “ዳነላ፥ ያዮፋ! ኔኒ አኬካ ደማናዉ ቆፓዳ፥ ነ ፆሳ ስንን ነናተ ካዉሽዳ ኮይሮ ጋላሳፐ ዶምድ፥ ነ ዎሳይ ስኤትስ፤ ታ ነዉ ዛሮ ኤካዳ ያስ። <verse eid="DAN 10:12"/><verse number="13" style="v" sid="DAN 10:13"/>ሽን ፋርሰ ካዎተ ሀላቃ ግድዳ አያናይ ላታማነ እስ ጋላስ ታና ተቅስ። ታኒ፥ ታርካ ፋርሰ ካዎተ ሀላቃራ ያን አትዳ ግሾ፥ ኪታንቾታ ሀላቃታፐ እሶይ፥ ምካኤል፥ ታና ማዳናዉ ይስ።<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="REV 1:13-15">ቆን 1:13-15</ref>.</char></note> <verse eid="DAN 10:13"/><verse number="14" style="v" sid="DAN 10:14"/>ሀ ቆንጨይ ስንፈ ሀናናባ በሲያ ግሾ፥ ታኒ ኔኮ ይዳይ፥ ዉርሰ ጋላሳን ነ አሳ ቦላ ሀናናዉ ደእያባ ነዉ ቆንጭሳናሳ” ያግስ።<verse eid="DAN 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 10:15"/>እ ሄሳ ታዉ ኦድያ ዎደ፥ ታኒ ሳአን ጉፋናዳ፥ ጋናባ ያስ። <verse eid="DAN 10:15"/><verse number="16" style="v" sid="DAN 10:16"/>ሄሳፈ ጉየ፥ አሰ ዳንያ እሶይ ታ መተርሻ ቦችስ፤ ታ ዶናይ ዶየትን፥ ኦደተ ዶማስ። ታ ስንን ኤቅዳይሳኮ፥ “ታ ጎዳዉ፥ ሀ ቆንጨይ ታና ዳሮ ዳጋንዳ ግሾ ዳሮ ዳቡራስ። <verse eid="DAN 10:16"/><verse number="17" style="v" sid="DAN 10:17"/>ታኒ ነ አይለይ፥ ኔራ፥ ታ ጎዳራ ዋናዳ ኦደታናዉ ዳንዳአይና? ታ ዎልቃይ ዉርስ፤ ሸምፓናዉካ ታዉ እፀትስ” ያጋስ።<verse eid="DAN 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18"/>ሄ አሰ ዳንያ እሶይ ናምአን ታና ቦችድ፥ ታዉ ዎልቃ እሚስ። <verse eid="DAN 10:18"/><verse number="19" style="v" sid="DAN 10:19"/>እ ታኮ፥ “ዳሮ ዶሰትዳ አድያዉ ያዮፋ! ሳሮይ ነዉ ግዶ። ምና፤ ፃላ” ያግስ።</para>
  <para style="p" vid="DAN 10:19">እ ሄሳ ግድ ታና ምንን፥ ታኒ ምናዳ፥ “ታ ጎዳዉ፥ ኔኒ ታና ምንዳ ግሾ ታዉ ኦዳ” ያጋስ።<verse eid="DAN 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 10:20"/>እ ዛሪድ፥ “ታኒ ኔኮ አይስ ይዳኮ ነ ኤራይ? ሀእ ታ ስማዳ ፋርሰ ሀላቃ ግድዳ አያናራ ኦለታናዉ ባና፤ ታኒ ቢኮ ግርከ ሀላቃ ግድዳ አያናይ ያና። <verse eid="DAN 10:20"/><verse number="21" style="v" sid="DAN 10:21"/>ሽን ቱማ ማፃፋን ፃፈትዳባ ታኒ ነዉ ኦዳና። ታኒ ኤንታራ ኦለትያ ዎደ፥ ህንተ ሀላቃ ምካኤላፐ አትሽን፥ ታና ማድያ ሀር ባዋ።”<verse eid="DAN 10:21"/></para>
  <chapter eid="DAN 10"/>
  <chapter number="11" style="c" sid="DAN 11"/>
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1"/>“ሜዶና አስ ግድዳ ዳርዮስ፥ ካዎትዳ ኮይሮ ላይን፥ ታኒ እያ ማዳናዉነ ምንናዉ እያ ምየን ኤቃስ።”<verse eid="DAN 11:1"/></para>
  <para style="s1">ፑደሀነ ዱገሀ ካዎታ</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2"/>“ህዛ ታ ነዉ ቱማ ኦዳይስ። ሀራ ሄ ካዎት ፋርሰ ቢታን ካዎታና፤ ኤንታፈ ጉየ ካዎትያ ኦይዳን ካዎይ፥ ሀንኮታፐ አዳ ዱረ ግዳና። እ ባ ዱረተ ጋሶን ዎልቃ ደምያ ዎደ፥ አሳ ኡባይ ግርከ ካዎተራ ኦለታና መላ ደንና።<verse eid="DAN 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 11:3"/>“ሄሳፈ ጉየ፥ ዎልቃን ሃርያ ምኖ ካዎይ ደንድድ፥ ባ ኮይዳባ ኡባ ኦና። <verse eid="DAN 11:3"/><verse number="4" style="v" sid="DAN 11:4"/>እ ዎልቃን ምንዳ ዎደ እያ ካዎተይ ላለትድ፥ ኦይዱ በሳን ሻከታና። እያ ኮቻት እያ ካዎተ ላቶኮና፤ ካዎተይ እ ካሰ አይሰይሳዳ ዎልቃማ ግደና፤ እያ ካዎተይ እያፐ ኤከትድ፥ ሀራታስ እመታና።<verse eid="DAN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5"/>“ዱገሀ ቢታ ካዎይ ምኖ ግዳና፤ ሽን እያ ሹማታፐ እሶይ እያፐ ዳሮ ምንድ፥ ሄ ግታ ካዎተ ሃራና። <verse eid="DAN 11:5"/><verse number="6" style="v" sid="DAN 11:6"/>ጉ ላይፈ ጉየ፥ ዱገሀ ቢታ ካዎይነ ፑደሀ ቢታ ካዎይ ባንታ ግዶን ዳቦተ ጫቆ ጫቀታና። ዱገሀ ቢታ ካዋ ናእያ ፑደሀ ቢታ ካዋ ገላና፤ ሽን እ ዎልቃይ ምነና፤ ቃስ እካ እያ ዎልቃይካ ዳሮ ዎደ ጋምኤና። ሄ ዎደ፥ ኢራ እስፈ፥ እዮ ማደይሳት፥ እ ናአይነ እ አዝናይ፥ ኡባይ አድ እመታና።<verse eid="DAN 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 11:7"/>“ጉ ዉደፐ ጉየ፥ እ ዳቦታፐ እሶይ ዱገሀ ቢታን ካዎታና። ፑደሀ ቢታ ካዋ ቦላ ደንዳና፤ እያ ሚፃ መን ገልድ እያ ፆናና። <verse eid="DAN 11:7"/><verse number="8" style="v" sid="DAN 11:8"/>ቃስ ኤንታ ፆሳታ፥ ምስለታነ ብራፐነ ዎርቃፈ ኦሰትዳ ሚሸታ ኤክድ፥ ግብፀ ኤፋና። ጉ ዎደስ ፑደሀ ቢታ ካዋ ኦላናዉ ደንደና። <verse eid="DAN 11:8"/><verse number="9" style="v" sid="DAN 11:9"/>ፑደሀ ቢታ ካዎይ ዱገሀ ቢታ ካዋ ቦላ ደንዳና፤ ሽን ባ ይዳ ኦግያራ ጉየ ስማና።<verse eid="DAN 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 11:10"/>“ፑደሀ ቢታ ካዋ አደ ናይት ኦላስ ጊግድ፥ ዳሮ ኦላንቾታ ሺሻና። ኤንታራ ጋሄትያባ ኡባ ሜጭድ ኤፍያ ዎልቃማ ድኦዳ ካንድ አና፤ ዛር ኦልድ ዱገሀ ካዋ ሚፃ ጋካናዉ ባና። <verse eid="DAN 11:10"/><verse number="11" style="v" sid="DAN 11:11"/>ሄ ዎደ ዱገሀ ቢታ ካዎይ ዳሮ ሀንቀትድ፥ ፑደሀ ቢታ ካዋ ኦላናዉ ደንዳና። ፑደሀ ቢታ ካዎይ ሺሽዳ ዳሮ ኦላንቾታራ ኦለትድ፥ ኤንታ ፆናና። <verse eid="DAN 11:11"/><verse number="12" style="v" sid="DAN 11:12"/>ዳሮ ኦላንቾታ ድእዳፐ ጉየ፥ ኦቶሮን ፑነታና። ዳሮ ሙኩሉ አሳ ዎና፤ ሽን እያ ፆኖይ እያራ ጋምኤና።<verse eid="DAN 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 11:13"/>“ፑደሀ ቢታ ካዎይ ካሰይሳፈ አያ ሀራ ኦላንቾታ ጊግሳና። ጉ ላይ ጋምእዳፐ ጉየ፥ ኩመ ኦላ ሚሸ ኦይክዳ፥ ኦላንቾታ ኤክድ ኦላስ ከያና። <verse eid="DAN 11:13"/><verse number="14" style="v" sid="DAN 11:14"/>ሄ ዎደ ዳሮ አሳይ ዱገሀ ቢታ ካዋ ቦላ ደንዳና። ቆንጨይ ፖለታና መላ ነ አሳፐ እስ እስ ማካላንቾት ደንዳና፥ ሽን ኤንቲ ፆኖኮና። <verse eid="DAN 11:14"/><verse number="15" style="v" sid="DAN 11:15"/>ፑደሀ ቢታ ካዎይ ዱገሀ ቢታ ይድ፥ ዩሾይ ግምበትዳ እስ ካታማ ኦልድ ኦይካና። ዱገሀ ቢታ ካዋ ኦላንቾት ዎልቃ ያና፤ ሀር አቶሽን፥ ኤንታፈ ምኖ ኦላንቾትካ ኤንታራ ኤቀታናዉ ዳንዳኦኮና። <verse eid="DAN 11:15"/><verse number="16" style="v" sid="DAN 11:16"/>እያራ ኤቀታናዉ ዳንዳኤይ ባይና ግሾ ፑደሀ ቢታ ካዎይ ባ ኮይዳባ ኡባ ኦና። እ ዶረትዳ ቢታን ምን ኤቅድ፥ እያ ይስያ ዎልቃ ደማና። <verse eid="DAN 11:16"/><verse number="17" style="v" sid="DAN 11:17"/>እ ባ ካዎተን ደእያ ዎልቃ ኡባ ኤክድ ያናዉ ሀልቻና፤ ዱገሀ ቢታ ካዉዋራ ዳቦተ ጫቆ መና። ሄ ካዎተ ይሳናዉ ሀልችድ፥ ባ ናእዉ እያዉ እማና፥ ሽን እያ ሀልቾይ ፖለተና። <verse eid="DAN 11:17"/><verse number="18" style="v" sid="DAN 11:18"/>ባ ሶምኡዋ ዩሾይ አባን ተቀትዳ ቢታታኮ ዛሪድ፥ ኤንታፈ ዳሮታ ኦልድ ባዉ ኤካና። ሽን እስ ቶራ ሞጮናይ እያ ፆንድ እያ ኦቶሩዋ ጊሻና፤ እያ ኦቶሮ ኦዳ እያ ቦላ ዛራና። <verse eid="DAN 11:18"/><verse number="19" style="v" sid="DAN 11:19"/>ፑደሀ ቢታ ካዎይ ባ ቢታ፥ ባ ሚፃኮ ስማና። ሽን እ በትድ ኩንዳና፤ እያ ናምአን ኦንካ በኤና።<verse eid="DAN 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20"/>“እያ በሳን ካዎትያ ሀራ ካዎይ ባ ካዎተ ቦንቹዋ ናጋናዉ ጊራ ጊርስያ አሰ ካዎተ ግዶ ኪታና። ግዶሽን፥ ጉ ዎደፐ ጉየ፥ ቆንጨን ዎይኮ ኦላን ግዶናሽን፥ እ ጮ ሀይቅድ ያና።<verse eid="DAN 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21"/>“እያ በሳን እስ ካትዳ አስ ደንዳና፤ ሽን ኤንቲ እያዉ ካዎተ ቦንቾ እሞኮና። አሳይ ሳእ ሳሮ ግድ ኡትዳሽን፥ ጭምድ ካዎተ ኦይካና። <verse eid="DAN 11:21"/><verse number="22" style="v" sid="DAN 11:22"/>ዳሮ ኦላንቾት እያ ስንፈ ፕተትድ ያና፤ ጫቆ ሀላቃይካ ሀይቃና። <verse eid="DAN 11:22"/><verse number="23" style="v" sid="DAN 11:23"/>እያራ ጫቁዋ ጫቅ ስሚድ፥ ባ ኦያባ ጭሞን ኦና፤ ጉ አሳታ ፃላላራ እ ምናና። <verse eid="DAN 11:23"/><verse number="24" style="v" sid="DAN 11:24"/>አሳይ ሳእ ሳሮ ግድ ኡትዳሽን፥ ሄ ቢታን እ፥ ዳሮ ዱረ ግድዳ እስ ባጋ ኦይካና። ካሰ እያ አዋይ ዎይኮ እያ ማይዛይ ኦቦናባ ኦና፤ እ ድእድ ሺሽዳ ዱረተነ አቁዋ ባና ካለይሳታስ ግሻና። እ ሚፃታ ላላናዉ ሀልቻና፤ ሽን ሄስ ሀናናይ ጉ ዎደሳ። <verse eid="DAN 11:24"/><verse number="25" style="v" sid="DAN 11:25"/>ባ ዎልቃ ምንድ፥ ዳሮ ኦላንቾታራ ዱገሀ ቢታ ካዋ ቦላ ደንዳና። ዱገሀ ቢታ ካዎይ ዳሮነ ዎልቃማ ኦላንቾታራ ኦላስ ደንድድ፥ እያራ ኦለታና። ሽን እያ ቦላ ኤንቲ ማቅዳ ማቁዋ ጋሶን፥ እ ኤንታራ ኤቀታናዉ ዳንዳኤና። <verse eid="DAN 11:25"/><verse number="26" style="v" sid="DAN 11:26"/>ካዉዋራ እስ ጋይታን መይሳት እያ ይሳና፤ እያ ኦላንቾት ፕተታና፤ ዳሮት ኦላን ሀይቃና። <verse eid="DAN 11:26"/><verse number="27" style="v" sid="DAN 11:27"/>ሀ ናምኡ ካዎት ባንታ ዎዛናን ኢታ ቆፋ ኦይክድ፥ እስፈ እስ ጋይታ ቦላ ኡታና፤ እሶይ እሱዋ ጭማናዉ ዎርዶ ኦደታና። ሽን ቃመትዳ ዎደይ ቡሮ ጋክቦና ግሾ ኤንቲ ኦና ግድ ቆፕያባይ ኤንታዉ እንጀተና። <verse eid="DAN 11:27"/><verse number="28" style="v" sid="DAN 11:28"/>ፑደሀ ቢታ ካዎይ ዳሮ ዱረተራ ባ ቢታ ስማና። ሽን እ ባ ዎዛናን ጌሻ ጫቁዋ እፃና። ጌሻ ጫቁዋ ቆሀናዉ እያ ቦላ እስባ ኦድ፥ ባ ቢታ ስማና።<verse eid="DAN 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29"/>“ቃመትዳ ዎደይ ጋክን፥ እ ዛሪድ ዱገሀ ቢታ ቦላ ደንዳና፥ ሽን እያዉ ካሰይሳዳ እንጀተና። <verse eid="DAN 11:29"/><verse number="30" style="v" sid="DAN 11:30"/>ክፅማፐ ያ ኦላ ማርካበት እያ ዳጋንና። ጉየ ስሚድ፥ ጌሻ ጫቁዋ ቦላ ሀንቀታና። ቃስ ያፐ ስሚድ፥ ጌሻ ጫቁዋ አግዳይሳታራ ዳቦታና።<verse eid="DAN 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 11:31"/>“እያ ኦላንቾት ፆሳ ኬነ እያ ዩሹዋ ቱንሳና፤ ጋላስ ጋላስ ያርሸትያ ያርሹዋ ድጋና። ያትድ፥ ዮ ቱናተ ያን ኤሳና።<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳነ 9:27</ref>፤ <ref loc="DAN 12:11">12:11</ref>፤ <ref loc="MAT 24:15">ማቶ 24:15</ref>፤ <ref loc="MRK 13:14">ማር 13:14</ref>.</char></note> <verse eid="DAN 11:31"/><verse number="32" style="v" sid="DAN 11:32"/>እ ጫቆ ቃላ መንይሳታ፥ ጭሞ ቃላን ባ ባጋ ዛራና፤ ሽን ባንታ ፆሳ ኤርያ አሳይ ምናናነ እያራ ኤቀታና።<verse eid="DAN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 11:33"/>“አሳ ግዶን ደእያ ጭንጫት ዳሮ አሳ ታማርሳና። ሽን ጉ ዎደን ሄ አሳት ማሻን ሀይቃና፥ ታማን ፁገታና፥ ድኤታና ዎይኮ ቦንቀታና። <verse eid="DAN 11:33"/><verse number="34" style="v" sid="DAN 11:34"/>ሄ መቱዋ ግዶን ደእሸ፥ ኤንቲ ጉ ማዶ ደማና፤ ዳሮ አሳይ ኤንታ ባጋ ዳንድ፥ ኤንታኮ ስማና፤ ሽን ቱማ ዎዛናፐ ግደና። <verse eid="DAN 11:34"/><verse number="35" style="v" sid="DAN 11:35"/>ጭንጫታፐ እሶት እሶት በታና። ቃመትዳ ዎደይ ቡሮ ጋክቦና ግሾ፥ ኤንቲ ሄሳዳ ሀንድ፥ ዉርሰ ዎደይ ጋካናዉ፥ ፓጨትድ ከያና፥ ጌያናነ ቦረይ ባይናይሳታ ግዳና።”<verse eid="DAN 11:35"/></para>
  <para style="s1">ባና ቁ ኦያ ካዋ</para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36"/>“ካዎይ ባና ሎእዳባ ኦና፤ ባና ፆሳታ ኡባፈ ቁ ኦድ ግታያና፤ ፆሳታ ፆሳ ቦላ ካሰ ስኤትድ ኤሮና ኢታ ቃላ ኦደታና። ሀናናዉ ደእያባይ ሀናናዉ በሲያ ግሾ፥ ፆሳ ሀንቆይ ፖለታና ጋካናዉ እ ኦያባ ኡባይ እያዉ እንጀታና።<note caller="-" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="2TH 2:3-4">2 ታሰ 2:3-4</ref>፤ <ref loc="REV 13:5-6">ቆን 13:5-6</ref>.</char></note> <verse eid="DAN 11:36"/><verse number="37" style="v" sid="DAN 11:37"/>እ፥ ባ ማይዛታ ፆሳታ ዎይኮ ማጫሳይ ዶስያ ፆሳታ ካና። እ ባና ኡባፈ አድ ቁ ኦያ ግሾ፥ ሀራ ፆሳታ ኤከና። <verse eid="DAN 11:37"/><verse number="38" style="v" sid="DAN 11:38"/>እ ኤንታ ቦንቾ አግድ ሚፃታ ፆሳ ቦንቻና፤ እያ ማይዛት ኤሮና ፆሰ፥ ዎርቃ፥ ብራ፥ አልኦ ሹችነ ሎኦ እሞታ እምድ ቦንቻና። <verse eid="DAN 11:38"/><verse number="39" style="v" sid="DAN 11:39"/>እማ ፆሳን ማደትድ፥ እ ምኖ ሚፃታ ቦላ ደንዳና። ቃስ እያ ማታ ኤርያ አሳ ዳሮ ቦንቻና። እ ኤንታ፥ አሳ ቦላ ሹማና፤ ቢታ ዎይቶ ኦድ ኤንታዉ ሻክ ሻክ እማና።<verse eid="DAN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40"/>“ዉርሰ ዎደይ ጋክን፥ ዱገሀ ቢታ ካዎይ ደንድድ፥ ፑደሀ ቢታ ካዋ ኦላና። ሽን ፑደሀ ቢታ ካዎይ ፓራ ጋረታ፥ ፓራ አሳታነ ዳሮ ማርካበታ ኤክድ፥ እያ ቦላ ጎተዳ ያና። ዳሮ ቢታ ኦይክድ፥ ድኦዳ ሜጭድ ኤፋና። <verse eid="DAN 11:40"/><verse number="41" style="v" sid="DAN 11:41"/>እ ጌሻ ቢታ ቦላ ደንዳና፤ ዳሮ ቢታት እያ ኩሸን ኩንዳና። ሽን ኤዶመይ፥ ሞአበይነ አሞነፐ ዳርያ ባጋይ እያ ኩሸፐ አታና። <verse eid="DAN 11:41"/><verse number="42" style="v" sid="DAN 11:42"/>እ ዳሮ ቢታታ ቦላ ደንድያ ዎደ፥ ግብፀይካ እያፐ ከስ ኤከና። <verse eid="DAN 11:42"/><verse number="43" style="v" sid="DAN 11:43"/>ግብፀ ዎርቃ፥ ብራነ ዱረተ ኡባ፥ ባ ኩሸን አና። ሊበነ ቶጰ አሳይ እያዉ ሃረታና። <verse eid="DAN 11:43"/><verse number="44" style="v" sid="DAN 11:44"/>ሽን ዶሎሀ ባጋፈነ ፑደሀ ባጋፈ ያ ኦዳይ፥ እያ ዳጋንና። ሀንቆ ኤፅ ከይድ፥ ዳሮታ ዎናነ ይሳና። <verse eid="DAN 11:44"/><verse number="45" style="v" sid="DAN 11:45"/>እ ባ ካዎታ ዱንካንያ አባፈነ ሎኦ ጌሻ ዙማፐ ግዶን ቶካና። ሽን እ፥ ዉርሰን ባዉ ያና፤ እያ ማድያ ኦንካ በንተና።”<verse eid="DAN 11:45"/></para>
  <chapter eid="DAN 11"/>
  <chapter number="12" style="c" sid="DAN 12"/>
  <para style="s1">ዎደ ዉርሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1"/>“ሄ ዎደ ነ አሳ ናግያ ግታ ሀላቃይ፥ ምካኤል ደንዳና። ካዎተ መትዳ ዎድያፐ ዶምድ፥ ሀን ኤሮና መቶ ዎደይ ያና። ግዶሽን፥ ኤንታ ሱንይ ፆሳ ማፃፋን ፃፈትዳ ነ አሳ ኡባይ ሄ ዎደ አታና።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 24:21">ማቶ 24:21</ref>፤ <ref loc="MRK 13:19">ማር 13:19</ref>፤ <ref loc="REV 7:14">ቆን 7:14</ref>፤ <ref loc="REV 12:7">12:7</ref>.</char></note> <verse eid="DAN 12:1"/><verse number="2" style="v" sid="DAN 12:2"/>ሀይቅዳ አሳፐ ዳሮት ደንዳና። ኤንታፈ ባጋት መርና ደኦስ፥ ባጋት ቃስ ዬላስነ መርና ካዉሻስ ደንዳና።<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="ISA 26:19">እሳ 26:19</ref>፤ <ref loc="MAT 25:46">ማቶ 25:46</ref>፤ <ref loc="JHN 5:29">ዮሀ 5:29</ref>.</char></note> <verse eid="DAN 12:2"/><verse number="3" style="v" sid="DAN 12:3"/>ጭንጫት ሳሎ ፖኦዳ ቃስ ዳሮታ ፅሎተ ኦገ ካለይሳት መርናዉ ፆልንቶዳ ፖአና። <verse eid="DAN 12:3"/><verse number="4" style="v" sid="DAN 12:4"/>ሽን ነኖ ዳነላ፥ ነ ዉርሰ ዎደይ ጋካናዉ፥ ሀ ማፃፋ ጎርዳዳ፥ ማታመ ዎ። ዳሮት ኤራተ ደማናዉ ያነ ሃነ ዎፀረታና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="REV 22:10">ቆን 22:10</ref>.</char></note><verse eid="DAN 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5"/>ታኒ፥ ዳነል፥ ናምኡ አሳታ፥ እሶይ ሻፋፐ ሀፍን፥ እሶይ ሻፋፐ ሄፍንን ኤቅዳይሳታ በአስ። <verse eid="DAN 12:5"/><verse number="6" style="v" sid="DAN 12:6"/>ኤንታፈ እሶይ ሊኖ ማእድ፥ ሻፋፐ ቦላ ባጋራ ኤቅዳ ኪታንቹዋ፥ “ሀ ማላታት ፖለታናዉ አይ መላ ዎደ ጋምአኔ?” ያግድ ኦይችስ።<verse eid="DAN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 12:7"/>ሊኖ ማእድ፥ ሻፋፐ ቆሞ ባጋራ ኤቅዳ ኪታንቾይ፥ ባ ኡሻቻ ኩሽያነ ባ ሀድርሳ ኩሽያ ሳሎ ደንድ፥ መርናዉ ደኤይሳ ሱንን ሀይሳዳ ያግድ ጫቅስ፦ “ሀይስ፥ ዎደይ፥ ዎደትነ ዎደ ባጋይ ጋካናዉ ጋምአና፤ ጌሻ አሳታ ዎልቃይ ዉርያ ዎደ ሀ ኡባይ ፖለታና”<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="REV 10:5">ቆን 10:5</ref>፤ <ref loc="REV 12:14">12:14</ref>.</char></note> ያግስ።<verse eid="DAN 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8"/>ሀ ኡባ ታኒ ስአስ፥ ሽን ታዉ ገልቤና። ያትን፥ ታኒ፥ “ታ ጎዳዉ፥ ሀ ኡባስ ዉርሰይ አይ ግዳንዴ?” ጋዳ ኦይቻስ።<verse eid="DAN 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 12:9"/>እ ዛሪድ፥ “ዳነላ፥ ሀ ቃላይ ዉርሰ ዎደይ ጋካናዉ ጎርደትዳነ አታመትዳ ግሾ ኔኒ ባ፤ <verse eid="DAN 12:9"/><verse number="10" style="v" sid="DAN 12:10"/>ዳሮት ፓጨትድ ከያና፥ ጌያናነ ቦረይ ባይናይሳታ ግዳና፤ ሽን ኢታት፥ ኢታባ ኦና። ኢታታፐ እስ አስካ አኬከና፤ ሽን ጭንጫት አኬካና።<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="REV 22:11">ቆን 22:11</ref>.</char></note><verse eid="DAN 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 12:11"/>“ጋላስ ጋላስ ያርሸትያ ያርሾይ ድገትዳፐነ ዮ ቱናተይ ሄ በሳን ኤቅዳፐ ስምን፥ 1,290 ጋላስ።<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳነ 9:27</ref>፤ <ref loc="DAN 11:31">11:31</ref>፤ <ref loc="MAT 24:15">ማቶ 24:15</ref>፤ <ref loc="MRK 13:14">ማር 13:14</ref>.</char></note> <verse eid="DAN 12:11"/><verse number="12" style="v" sid="DAN 12:12"/>ገንጭድ 1,335 ጋላስ ጋካናዉ ናግያ አስ አንጀትዳይሳ።<verse eid="DAN 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 12:13"/>“ኔኒ ዉርሰ ጋካናዉ ባ። ነ ሸምፓና፤ ዉርሰን ነና ጋክያ ላታ ኤካናዉ ደንዳና” ያግስ።<verse eid="DAN 12:13"/></para>
  <chapter eid="DAN 12"/>
</usx>
