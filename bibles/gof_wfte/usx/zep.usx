<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ሶፎናሳ ማፃፋ</para>
  <para style="toc1">ሶፎናሳ ማፃፋ</para>
  <para style="toc3">ሶፎ</para>
  <para style="toc2">ሶፎናሳ</para>
  <para style="mt">ሶፎናሳ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሶፎናሳ ማፃፋይ ፃፈትዳይ፥ ይሁድነ የሩሳላመይ ጎዳ ጋላሳን ያናዉ ደእያ ዳጋንያ ፕርዳባ ኦዳናሳ። ማፃፋይ፥ አሳ ኮቸ ኡባ ቦላ ፆሳ ፕርድ ያናይስ አቶናባ ግድኮካ (<char style="xt"><ref loc="ZEP 1:2">1:2</ref>፤ <ref loc="ZEP 3:8">3:8</ref></char>)፥ ኡባፈ አድ እ ናጋራ ጋሶን ይሁዳ ቦላ ያናዉ ደእያ ፕርዳ ኦዴስ (<char style="xt"><ref loc="ZEP 1:4-18">1:4-18</ref>፤ <ref loc="ZEP 3:1-7">3:1-7</ref></char>)። ሄሳ ግሾ፥ ፆሳ ፕርዳ ጋላሳይ ጋካናፐ ስን አሳይ ባንታ ናጋራ ፓፅድ፥ ፆሰ ኮያና መላ አሳ ደንስ (<char style="xt"><ref loc="ZEP 2:1-3">2:1-3</ref></char>)።</para>
  <para style="ip">ሶፎናስ፥ እቻሹ አላጋ ቢታታ ቦላ ፆሳይ ፕርዳናይሳ ኦዴስ። ኤንትካ፥ ፍልስፄመ፥ አሞነ፥ ሞአበ፥ ቶጰነ አሶረ (<char style="xt"><ref loc="ZEP 2:4-15">2:4-15</ref> </char>)። ናበይ የሩሳላመ ናጋራ ኦድዳፐ ጉየ፥ ፆሳይ ባ አሳ ሺሻናይሳ፥ ዎዛናይሳነ ዛሪድ ኦራናይሳ ኦዴስ (3:9-20)። “ህንተኖ፥ ቢታን ደእያ አሽከቶ፥ እያ ኪታ ናግያ ኡባቶ፥ ጎዳ ኮይተ፤ ፅሎተ ኮይተ፤ አሽከተ ኮይተ። ኦን ኤር ጎዳ ሀንቆ ጋላስ ህንተ አቶና አገከታ” ያግስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ጎዳ ጋላሳን ይሁድነ እስራኤለይ ፕርደታና (<char style="ior"><ref loc="ZEP 1:1-18">1:1-18</ref></char>)</para>
  <para style="io1">ፆሳኮ ስሞ (<char style="ior"><ref loc="ZEP 2:1-3">2:1-3</ref></char>)</para>
  <para style="io1">ሀራ ካዎተታ ቦላ ያና ፕርዳ (<char style="ior"><ref loc="ZEP 2:4-15">2:4-15</ref></char>)</para>
  <para style="io1">ይሁድነ ሀራ ካዎተት ጎዳኮ ስማና (<char style="ior"><ref loc="ZEP 3:1-20">3:1-20</ref></char>)</para>
  <chapter number="1" style="c" sid="ZEP 1"/>
  <para style="s1">ጎዳ ፕርዳ ጋላሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1"/>አሞነ ናአይ እዮስያስ ይሁዳን ካዎትዳ ዎደ ሶፎንያሳኮ ይዳ ጎዳ ቃላይ ሀይሳ። ሶፎንያስ ኩሻ ናኣ፤ ኩሽ ጋዳላ ናአ፤ ጋዳል አማረ ናአ፤ አማረይ ህዝቅያሳ ናኣ። <verse eid="ZEP 1:1"/><verse number="2" style="v" sid="ZEP 1:2"/>“ታኒ ቢታ ቦላ ደእያባ ኡባ ይሳና። <verse eid="ZEP 1:2"/><verse number="3" style="v" sid="ZEP 1:3"/>አሰነ መሄ፥ ሳሎ ካፎታነ አባ ሞሎታ ይሳና። ኢታ አሳታ ሽራ የጋና፤ አሳ ዛረ ቢታ ቦላፈ ይሳና” ያጌስ ጎዳይ።<verse eid="ZEP 1:3"/></para>
  <para style="s1">ይሁዳ ቦላ ያና ፕርዳ</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEP 1:4"/>“ይሁዳንነ የሩሳላመን ደእያ ኡባ ሴራናዉ ታ ኩሽያ ደንና። ባኣለ ኤቃ ጎይነይሳታነ እያ ሀጋዝያ ካህነታ ሄ በሳፈ ይሳና። <verse eid="ZEP 1:4"/><verse number="5" style="v" sid="ZEP 1:5"/>ኬ ቦላ ከይድ አዋስ፥ አጌናስነ ፆልንቶታስ ጎይነይሳታ ታኒ ይሳና። ጎዳ ጎይንሸነ እያ ሱንን ጫቅሸ ሞሎካ ጌተትያ ኤቃ ሱንን ጫቀይሳታ ታኒ ይሳና። <verse eid="ZEP 1:5"/><verse number="6" style="v" sid="ZEP 1:6"/>ታና ካሎ አግድ ጉየ ስምዳይሳታ፥ ታና ኮይቦናይሳታነ ታና ኦይችቦናይሳታ ታኒ ይሳና” ያጌስ ጎዳይ።<verse eid="ZEP 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEP 1:7"/>ጎዳ ጋላሳይ ማትዳ ግሾ፥ ኡባ ሃርያ ጎዳ ስንን ስእ ጊተ! ጎዳይ ያርሹዋ ጊግስስ፤ ቃስ ባ ፄግዳ እማታ ጌሽስ።<verse eid="ZEP 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEP 1:8"/>“ጎዳ ያርሹዋ ጋላስ ሀላቃታ፥ ካዋ ናይታነ አላጋ ቢታ ማኦ ማእዳ ኡባ ታኒ ሴራና። <verse eid="ZEP 1:8"/><verse number="9" style="v" sid="ZEP 1:9"/>ሄ ጋላስ አላጋ ቢታ አሳታዳ፥ ኤቃ ጎይነይሳታነ ባንታ ጎዳ ኬ ጌላተንነ ጭሞን ኩንይሳታ ታኒ ሴራና” ያጌስ ጎዳይ።<verse eid="ZEP 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEP 1:10"/>“ሄ ጋላስ ሞሎ ፐንግያ ባጋራ ዋሶይ፥ ካታማስ ናምአን ሻሁዋን ዬሆነ ዙማታ ቦላ ግታ ዶምኤ ግርስ ስኤታና። <verse eid="ZEP 1:10"/><verse number="11" style="v" sid="ZEP 1:11"/>ህንተኖ፥ ካታማስ ጋርሳ ባጋን ደኤይሳቶ፥ ዬክተ። ያን ዛልእያ ኡባይ ይዶሶና፤ ብራ ኦይክዳይሳት ሀይቅ ዉርዶሶና። <verse eid="ZEP 1:11"/><verse number="12" style="v" sid="ZEP 1:12"/>ሄ ጋላስ ታኒ ፆምፐ ኦይዳ የሩሳላመ ግዱዋ ኮያና። ህርግ ባይና ዎ ኡትድ ባንታ ዎዛናን፥ ‘ጎዳይ ሎኦካ ኢታካ’ ገይሳታ ታኒ ሴራና። <verse eid="ZEP 1:12"/><verse number="13" style="v" sid="ZEP 1:13"/>ኤንታ ሻሎይ ቦንቀታና፤ ኤንታ ኬይ ላለታና። ኤንቲ ኬ ኬፃና፥ ሽን ሄ ኬን ዶኮና፤ ዎይነ ቶካና፥ ሽን ሄ ዎይንያ ኡዮኮና” ያጌስ ጎዳይ።<verse eid="ZEP 1:13"/></para>
  <para style="s1">ጎዳ ግታ ጋላሳ</para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14"/>“ጎዳ ግታ ጋላሳይ ማትስ፤</para>
  <para style="q2" vid="ZEP 1:14">ኤለስድ ጋክስ።</para>
  <para style="q1" vid="ZEP 1:14">ጎዳ ጋላሳይ ጫሞ ጋላስ፤</para>
  <para style="q2" vid="ZEP 1:14">ሄ ጋላስ ምኖ ኦላንቾትካ ዋሶ ጎቻና።<verse eid="ZEP 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15"/>ሄ ጋላሳይ ሀንቆ ጋላስ፥</para>
  <para style="q2" vid="ZEP 1:15">ሄ ጋላሳይ መቶነ ኡንአ ጋላስ፥</para>
  <para style="q2" vid="ZEP 1:15">ዮነ ላለተ ጋላስ፥</para>
  <para style="q2" vid="ZEP 1:15">ማነ ጫጋና ጋላስ፥</para>
  <para style="q2" vid="ZEP 1:15">ሻራነ ሳካና ማ ጋላስ ግዳና።<verse eid="ZEP 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 1:16"/>ሄ ጋላሳይ ድረትዳ ካታማታ ቦላ፥</para>
  <para style="q2" vid="ZEP 1:16">አዱሳ ግምበታ ቦላ ኦላ ሞይዘይ ፑነታና፤</para>
  <para style="q2" vid="ZEP 1:16">ጊገታ ግያ ዋሶይ ስኤታና።<verse eid="ZEP 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17"/>ኤንቲ ታና ቆህዳ ግሾ፥</para>
  <para style="q2" vid="ZEP 1:17">ቆቀዳ ታታፋና ጋካናዉ፥ ኤንታ ቦላ መቶ ኤሀና።</para>
  <para style="q1" vid="ZEP 1:17">ኤንታ ሱይ ድኦዳ ጎጋና፤</para>
  <para style="q2" vid="ZEP 1:17">ኤንታ አሀይ ፕቶዳ የገታና።<verse eid="ZEP 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18"/>ጎዳ ሀንቆ ጋላስ</para>
  <para style="q2" vid="ZEP 1:18">ኤንታ ብራይነ ኤንታ ዎርቃይ ኤንታ አሸና።</para>
  <para style="q1" vid="ZEP 1:18">እ ሳአን ደእያ ኡባ ቆፖና ይሳና፤</para>
  <para style="q2" vid="ZEP 1:18">ቢታ ኡባይ እያ ሀንቁዋ ታማን ሜተታና” ያጌስ ጎዳይ።<verse eid="ZEP 1:18"/></para>
  <chapter eid="ZEP 1"/>
  <chapter number="2" style="c" sid="ZEP 2"/>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 2:1"/>ህንተኖ፥ ዬል ባይና አሳዉ፥ አነ እስፈ ሺቅተ! <verse eid="ZEP 2:1"/><verse number="2" style="v" sid="ZEP 2:2"/>ጫርኮይ ፑንድ ኤፍያ ባናዳ ሀኖና ደእሽን፥ ያሽያ ጎዳ ሀንቆይ ህንተ ቦላ ዎና ደእሽን፥ ጎዳ ሀንቆ ሱላ ጋላሳይ ህንተ ቦላ ዮና ደእሽን ጎዳኮ ስምተ። <verse eid="ZEP 2:2"/><verse number="3" style="v" sid="ZEP 2:3"/>ህንተኖ፥ ቢታን ደእያ አሽከቶ፥ እያ ኪታ ናግያ ኡባቶ፥ ጎዳ ኮይተ፤ ፅሎተ ኮይተ፤ አሽከተ ኮይተ። ኦን ኤር ጎዳ ሀንቆ ጋላስ ህንተ አቶና አገከታ።<verse eid="ZEP 2:3"/></para>
  <para style="s1">ፍልስፄመ ቦላ ያና ፕርዳ</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEP 2:4"/>ጋዛ ካታማይ ኦና ግዳና፤ አስቃሎና ካታማይ ባይሳ ግዳና። አሽዶዳ ካታማ አሳይ ሴታ ጋላስ ጎደታና፤ ኤቅሮና ካታማይ ሾደታና። <verse eid="ZEP 2:4"/><verse number="5" style="v" sid="ZEP 2:5"/>ህንተኖ፥ አባ ጋፃን ደእያ ከልታወቶ፥ ህንተና አየ! ነኖ፥ ፍልስፄመት ደእያ ካናነ ቢታዉ፥ ጎዳ ፕርዳይ ነ ቦላ ዬስ። ታኒ ነና ይሳና፤ እስ አስካ አተና። <verse eid="ZEP 2:5"/><verse number="6" style="v" sid="ZEP 2:6"/>አባ ጋፃን ደእያ ህንተ ቢታይ መሄ ሄመትያ በሲ፥ ሄንንቾት ደእያ በስነ መሄ ዳራ ግዳና። <verse eid="ZEP 2:6"/><verse number="7" style="v" sid="ZEP 2:7"/>ይሁዳ አሳፐ አትዳይሳት አባ ጋፃን ደእያ በሳ ላታና፤ ኤንቲ ያን ሄማና። ሳአይ ቃምያ ዎደ ኤንቲ አስቃሎና ካታማን ደእያ ኬታን አቃና። ጎዳይ ኤንታ ፆሳይ ኤንታባ ቆፓና፤ እ ኤንታ ዛሪድ ናንሳና።<verse eid="ZEP 2:7"/></para>
  <para style="s1">ሞአበነ አሞነ ፕርደተ</para>
  <para style="p">
    <verse number="8" style="v" sid="ZEP 2:8"/>ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ፥ “ታኒ ሞአበ ቶሽያነ አሞነ ጫሻ ስአስ። ኤንቲ ታ አሳ ዋትድ ቶችዳኮነ ኤንታ ቢታ ኤካናዉ ዋትድ ማንድዳኮ ታ ኤራይስ። <verse eid="ZEP 2:8"/><verse number="9" style="v" sid="ZEP 2:9"/>ሄሳ ግሾ፥ ታ ደኦ ሱንን ጫቃይስ፤ ሞአበይ ሶዶመዳ ሀናና፤ አሞነይ ጋሞራዳ ሀናና። ኤንቲ መርናዉ ማፅነ ኦላነ አጉን ማእዳ ባዞ ግዳና። ታ አሳፐ አትዳይሳት ኤንታ ሻሉዋ ቦንቃና፤ ኤንታ ቢታ ላታና” ያጌስ።<verse eid="ZEP 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEP 2:10"/>ኤንቲ ኡባፈ ዎልቃማ ጎዳ አሳ ቶችዳ ግሾነ ጫይዳ ግሾ፥ ኤንታ ቦላ መቶይ ጋካና። <verse eid="ZEP 2:10"/><verse number="11" style="v" sid="ZEP 2:11"/>ኤንታ ቢታን ደእያ ፆሳታ እ ይስያ ዎደ ጎዳይ ኤንታና ያሽሳና። ሳአን ደእያ ካዎተታን ደእያ አሳ ኡባይ ባ ደእያ በሳን እያ ጎይናና።<verse eid="ZEP 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEP 2:12"/>ህንተኖ፥ ቶጰ አሳዉ፥ ህንተ ታ ማሻን ሀይቃና።<verse eid="ZEP 2:12"/></para>
  <para style="s1">ሶረ ቦላ ያና ፕርዳ</para>
  <para style="p">
    <verse number="13" style="v" sid="ZEP 2:13"/>እ ባ ኩሽያ ፑደሀ ባጋ የድድ አሶረ ቢታ ይሳና። ቃስ ናናወ ካታማ መላ ባዞዳ ባይሳ በሲ ኦና። <verse eid="ZEP 2:13"/><verse number="14" style="v" sid="ZEP 2:14"/>መሄ ዉደይነ ቢታን ደእያ ዶአት ኡባይ ያን ሄመታና፤ ጉቶይነ ቁፃረይ ላለትዳ ግምብያ ግዶን ዳና። ኤንታ ቃላይ ማስኮተራነ ፐንግያራ ስኤታና፤ ዝጋ ቱቀት ካሎታና። <verse eid="ZEP 2:14"/><verse number="15" style="v" sid="ZEP 2:15"/>“ታፐ አትሽን፥ ሀር ባዋ” ያግድ ኦቶርትድ ደእዳ ካታማይ ሀእ ዋንድ ዶአት አቅያ በሲ ግድዴ? እያ ማታራ አያ ኡባይ ባንታ ኩሽያ ባቅሸ፥ “ፖራ!” ጋና።<verse eid="ZEP 2:15"/></para>
  <chapter eid="ZEP 2"/>
  <chapter number="3" style="c" sid="ZEP 3"/>
  <para style="s1">የሩሳላመ ዎዘተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 3:1"/>ማካላንቹዋስ፥ ቱንዳይሳስነ ባ ደርያ ኡንኤዳ የሩሳላመ ካታማ አየ! <verse eid="ZEP 3:1"/><verse number="2" style="v" sid="ZEP 3:2"/>እ ኦናካ ኪተተና፤ ሴርን ስመና፤ ጎዳን አማነተና፤ ባ ፆሳኮ ሺቀና። <verse eid="ZEP 3:2"/><verse number="3" style="v" sid="ZEP 3:3"/>እያ ሀላቃት ጉድያ ጋሞ መላ፤ እያ ዳይናት ደምዳባ ዎንቶስ አሾና ኡባ ምድ ኦንግያ ኦማርሳ ሱመ መላ። <verse eid="ZEP 3:3"/><verse number="4" style="v" sid="ZEP 3:4"/>እያ ናበት ኦቶራንቾነ ገናንቾ፤ እያ ካህነት ጌሻ ቱንሰይሳታ፤ ኤንቲ ጎዳ ህግያ ምርቆሶና። <verse eid="ZEP 3:4"/><verse number="5" style="v" sid="ZEP 3:5"/>ሽን እያ ግዶን ደእያ ጎዳይ ፅሎ፤ እ ባላ ኦና። ዎንታ ዎንታ እ ፅሎ ፕርዴስ፤ ጋላስ ጋላስ ሄሳ አገና። ግዶሽን፥ ያን ደእያ ጌላይ ዬላ ኤረና።<verse eid="ZEP 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEP 3:6"/>“ታኒ ካዎተታ ይሳስ፤ ኤንታ ግምበታ ላላስ። ኤንታ ካታማታ እስ ዶና ባይሳ ቢታ ኦስ፤ ኤንታ ኦገታ አስ ካንና ባዞ ኦስ። <verse eid="ZEP 3:6"/><verse number="7" style="v" sid="ZEP 3:7"/>ታኒ ሀይሳ ኡባ ኦዳ፥ ‘ታ አሳይ ታና ቦንቻና፤ ታ ሴራ ኤካና፤ ታ ኪትዳባ ዶገና’ ያጋስ። ሽን ኤንቲ ካሰፐ አድ ኢትዶሶና፤ ባንታ ኦሱዋን ቱንዶሶና” ያጌስ ጎዳይ።<verse eid="ZEP 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEP 3:8"/>“አነ ታኒ ፕርድያ ጋላሳይ ጋካናዉ ጉ ናግተ። ታኒ ደረታነ ካዎተታ ሺሻናዉ ቆፋ ቃቻስ፤ ታ ሀንቁዋ ሱላ ኤንታ ቦላ ጉሳና፤ ቢታይ ኩመ ታ ሀንቁዋ ታማን ፁገታና።<verse eid="ZEP 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEP 3:9"/>“ሄ ዎደ አሳ ኡባይ ጌሻ ኦዳ ኦደታና መላ ኦና። ኤንቲ ኡባይ ጎዳ ሱን ፄጋና፤ እስፈ እያዉ ጎይናና። <verse eid="ZEP 3:9"/><verse number="10" style="v" sid="ZEP 3:10"/>ላለትዳ አሳይ፥ ታና ቱማ ጎይነይሳት፥ ቶጰ ሻፋታፐ ሄፍንን ደኤይሳት ታዉ እሞታ ኤሀና። <verse eid="ZEP 3:10"/><verse number="11" style="v" sid="ZEP 3:11"/>ኦቶረይሳታነ ጬቀተይሳታ ታ ህንተ ግዶፈ ይስያ ግሾ፥ ሄ ዎደ ህንተ ታ ቦላ ኦዳ ኦሱዋ ጋሶን ዬላተከታ። ህዛፐ ጉየ ህንተ ታ ጌሻ ዙማ ቦላ ኦቶርተከታ። <verse eid="ZEP 3:11"/><verse number="12" style="v" sid="ZEP 3:12"/>ታኒ ህንተ ግዶፈ ባንታና ካዉሸይሳታነ አዳታ አሻና፤ ኤንቲ ጎዳ ሱንን አማነታና። <verse eid="ZEP 3:12"/><verse number="13" style="v" sid="ZEP 3:13"/>እስራኤለ አሳፐ አትዳይሳት ኢታባ ኦኮና፤ ዎርዶ ኦደቶኮና፤ ኤንታ እንፃርሳን ጭሞይ በንተና። ሄሳ ግሾ፥ ኤንቲ ምድ ካልድ ሳሮን ዳና፤ ኤንታ ያሽስያባይ ባዋ” ያጌስ።<verse eid="ZEP 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14"/>ፅዮነ ናኤ፥ ማዝሙርያ የፃ!</para>
  <para style="q2" vid="ZEP 3:14">እስራኤለ አሳዉ፥ እልልተ!</para>
  <para style="q1" vid="ZEP 3:14">የሩሳላመ ናኤ፥ ነ ፖሎ ዎዛናፐ ኡፋይታ፤</para>
  <para style="q2" vid="ZEP 3:14">ሀሹ ጋ!<verse eid="ZEP 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15"/>ጎዳይ ህንተ ቦላ ፕርድዳ ፕርዳ አግስ፤</para>
  <para style="q2" vid="ZEP 3:15">ህንተ ሞርከታ ድግስ።</para>
  <para style="q1" vid="ZEP 3:15">ጎዳይ፥ እስራኤለ ካዎይ ህንተ ግዶን ደኤስ፤</para>
  <para style="q2" vid="ZEP 3:15">ህዛፐ ጉየ ህንተና ያሽስያባይ ባዋ።<verse eid="ZEP 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16"/>ሄ ጋላስ ኤንቲ የሩሳላመ ሀይሳዳ ያጋና፦</para>
  <para style="q2" vid="ZEP 3:16">“ፅዮነ፥ ያዮፋ! ነ ኩሸይ አርጋጮፖ።<verse eid="ZEP 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17"/>ጎዳይ፥ ነ ፆሳይ ነ ግዶን ደኤስ፤</para>
  <para style="q2" vid="ZEP 3:17">እ ነዉ ፆኖ እምያ ኦላንቹዋ።</para>
  <para style="q1" vid="ZEP 3:17">እ ነናን ኡፋይታና፤</para>
  <para style="q2" vid="ZEP 3:17">ባ ሲቁዋን ነና ኦራና።</para>
  <para style="q1" vid="ZEP 3:17">አሳይ ባኣለ ጋላስ ማዝሙረ የፀይሳዳ፥</para>
  <para style="q2" vid="ZEP 3:17">እ ነናን ኡፋይተይሳ ማዝሙረ የፅድ በሳና” ያጋና።<verse eid="ZEP 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18"/>ጎዳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q2" vid="ZEP 3:18">“ህዛፐ ጉየ ነ ቦላ ዮይ ጋኮናዳ ኦና፤</para>
  <para style="q2" vid="ZEP 3:18">ነ ዬላ ድጋና።<verse eid="ZEP 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19"/>ሄ ዎደ ታኒ ነና ኡንኤዳይሳታ ኡባ ሴራና፤</para>
  <para style="q2" vid="ZEP 3:19">ዎበታ አሻና፤ ላለትዳይሳታ ሺሻና።</para>
  <para style="q1" vid="ZEP 3:19">ኤንቲ ዬላትዳ በሳን ዛራዳ ቦንቻና፤</para>
  <para style="q2" vid="ZEP 3:19">ኤንታ ዬላ ቦንቾንነ ሳባን ላማና።<verse eid="ZEP 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20"/>ሄ ዎደ ታኒ ህንተና ሺሻና፤</para>
  <para style="q2" vid="ZEP 3:20">ህንተና እስፈ ዛራዳ ሺሻና።</para>
  <para style="q1" vid="ZEP 3:20">ታኒ ህንተና ናንስያ ዎደ፥</para>
  <para style="q2" vid="ZEP 3:20">ህንተ ሀ ሳአን ደእያ አሳ ኡባ ማታን፥</para>
  <para style="q2" vid="ZEP 3:20">ቦንቸትዳይሳታነ ኤረትዳይሳታ ግዳና” ያጌስ ጎዳይ።<verse eid="ZEP 3:20"/></para>
  <chapter eid="ZEP 3"/>
</usx>
