<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">2 ጰፅሮሳ ኪታ</para>
  <para style="toc1">2 ጰፅሮሳ ኪታ</para>
  <para style="toc3">2 ጰፅ</para>
  <para style="toc2">2 ጰፅሮሳ</para>
  <para style="mt1">ጰፅሮስ ፃፍዳ</para>
  <para style="mt2">ናምአን ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሀዋርያ ጰፅሮስ ፃፍዳ ናምአን ኪታይ፥ ዱማ ዱማ በሳን ደእያ በን አማንያ አሳሳ። ሀ ኪታይ ፃፈትዳ ጋሶይ፥ ዎርዶ አስታማረታ ኢታ ኦሱዋነ ኤንታ ትምርትያ ጋሶን መትዳ ዬላ ደኡዋ አማንያ አሳይ እፃና መላሳ። ሄ መትዳ መቶታ ድጋናዉ ኦገ ግዳናይ፥ የሱሳ ባንታ አይፈን በእዳ አሳትነ እ ታማርስያ ዎደ ባንታ ሀይን ስእዳ አሳት ታማርስዳ ትምርትያ ባጋራ ፆሳባነ ጎዳ የሱስ ክርስቶሳባ አማንያ ኤራ ኦይከ። ፃፈይ ምንድ ኦድዳይ፥ “ክርስቶስ ናምአን ዬና” ግያ ዎርዶ ትምርትያባ። ሄ ቆፋ ምንድ ኦድሸ፥ “ክርስቶስ ስሚድ ዮና ጋምእዳይ፥ አስ ኡባይ ባ ናጋራፐ ስማና መላፐ አትሽን፥ ኦንካ ያና መላ ኮዮና ግሾሳ” ያጌስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሳሮነ ዎሳ (<char style="ior"><ref loc="2PE 1:1-2">1:1-2</ref></char>)</para>
  <para style="io1">አማንያ አሳይ ዳና ዱሳ (<char style="ior"><ref loc="2PE 1:3-15">1:3-15</ref></char>)</para>
  <para style="io1">ክርስቶሳ ቦንቹዋ (<char style="ior"><ref loc="2PE 1:16-21">1:16-21</ref></char>)</para>
  <para style="io1">ዎርዶ አስታማረታነ ናበታ (<char style="ior"><ref loc="2PE 2:1-22">2:1-22</ref></char>)</para>
  <para style="io1">ክርስቶሳ ናምአን ዩሳይ ቱማ (<char style="ior"><ref loc="2PE 3:1-18">3:1-18</ref></char>)</para>
  <chapter number="1" style="c" sid="2PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1"/>የሱስ ክርስቶሳ ሀዋረይነ እያ አይለይ፥ ታኒ፥ ስሞን ጰፅሮስ፥ ኑ ፆሳነ ኑና አሽያ የሱስ ክርስቶሳ ፅሎተ ባጋራ ኑይሳ መላ አልኦ አማኖ ኤክዳይሳታስ ሀ ዳብዳብያ ፃፋስ።<verse eid="2PE 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2"/>ፆሳነ ኑ ጎዳ የሱሳ ኤሮን አ ኬሀተይነ ሳሮይ ህንተዉ ኩሞ።<verse eid="2PE 1:2"/></para>
  <para style="s1">ፆሳ ፄሳነ ዶሩዋ</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3"/>ባ ቦንቾንነ ሎኦተን ኑና ፄግዳ እያ ኤሮን ደኦስነ ፆሳ ዳንድ ዳናዉ ኮሽያባ ኡባ ፆሳይ ባ ዎልቃን ኑስ እሚስ። <verse eid="2PE 1:3"/><verse number="4" style="v" sid="2PE 1:4"/>ህንተ ኢታ አሞ ጋሶን መትያ ሀ አላምያን ደእያ ዮፐ ከስ ኤካናዳነ ፆሳ ፆሳተን ሻከታናዳ፥ ሀ እሞታታ ባጋራ ዳሮ አልኦነ ግታ ኡፋይሳ ኑስ እሚስ። <verse eid="2PE 1:4"/><verse number="5" style="v" sid="2PE 1:5"/>ሄሳ ግሾ፥ ምንድ፥ ህንተ አማኑዋ ቦላ ሎኦተ፥ ሎኦተ ቦላ ኤራተ፥ <verse eid="2PE 1:5"/><verse number="6" style="v" sid="2PE 1:6"/>ኤራተ ቦላ ባና ሃሮ፥ ባና ሃሮ ቦላ ገንጫ፥ ገንጫ ቦላ ፆሳ ዳኖ፥ <verse eid="2PE 1:6"/><verse number="7" style="v" sid="2PE 1:7"/>ፆሳ ዳኖ ቦላ እሻተ ኬሀተ፥ እሻተ ኬሀተ ቦላ ሲቆ ጉጅተ። <verse eid="2PE 1:7"/><verse number="8" style="v" sid="2PE 1:8"/>ሀይሳቲ ህንተዉ ዳርድ ደእያባ ግድኮ፥ ጎዳ የሱስ ክርስቶሳ ኤሮን ማድያ አስነ አይፈራ ደእያ አስ ኦና። <verse eid="2PE 1:8"/><verse number="9" style="v" sid="2PE 1:9"/>ሽን ሄሳት ባይና ኦንካ ማታን ደእያባ ፃላላ በእያ ቆቀ። እ ባ ካሰ ናጋራፐ ጌይዳይሳ ዶግስ።<verse eid="2PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10"/>ሄሳ ግሾ፥ ታ እሻቶ፥ ህንተ ፄሳነ ህንተ ዶሩዋ ምንናዉ ካሰይሳፈ አድ ምንተ። ህንተ ሄሳታ ኦያባ ግድኮ፥ በተከታ። <verse eid="2PE 1:10"/><verse number="11" style="v" sid="2PE 1:11"/>ሄሳን ኑ ጎዳነ ኑና አሽያ የሱስ ክርስቶሳ መርና ካዎተ ገልያ ኩመ ማታይ ህንተዉ እመታና።<verse eid="2PE 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12"/>ሄሳ ግሾ፥ ህንተ ሀይሳታ ኤርያባነ ሄ ኦይክዳ ቱማን ምንድ ደእያባ ግድኮካ፥ ታኒ ሀይሳታ ኡባ ዎደ ህንተና ሀሳይሶ አግከ። <verse eid="2PE 1:12"/><verse number="13" style="v" sid="2PE 1:13"/>ታኒ ሸምፖራ ደእዳ ዎደ ኡባን ህንተና ሀሳይሳናይስ ኮሽያባ ጋዳ ቆፓይስ። <verse eid="2PE 1:13"/><verse number="14" style="v" sid="2PE 1:14"/>ኑ ጎዳ የሱስ ክርስቶሲ ታዉ ቆንጭሳዳይሳዳ ታኒ ሀ ሀይቅያ አሳተ ጋምኦና ቃራ የጋዳ ባናይሳ ኤራይስ። <verse eid="2PE 1:14"/><verse number="15" style="v" sid="2PE 1:15"/>ታኒ ህንተፈ ሻከትኮካ ህንተ ሀይሳታ ኡባ ዎደ አኬካና መላ ታዉ ዳንዳኤትያባ ኡባ ኦና።<verse eid="2PE 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16"/>ኑኒ ጎዳ ክርስቶሳ ዎልቃነ እያ ዩሳባ ህንተዉ ኦደይ፥ እያ ግታ ቦንቹዋ በእድፐ አትሽን፥ መ ከስዳ ሀይሰ ግደና። <verse eid="2PE 1:16"/><verse number="17" style="v" sid="2PE 1:17"/>ዳሮ ዎልቃማ ቦንቹዋፈ፥ “ታኒ ኡፋይትያ፥ ታ ዶስያ ናአይ ሀይሳ” ግያ ቃላይ ይዳ ዎደ፥ ፆሳ አዋፐ ቦንቾነ ጋላታ ኤክስ።<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAT 17:1-5">ማቶ 17:1-5</ref>፤ <ref loc="MRK 9:2-7">ማር 9:2-7</ref>፤ <ref loc="LUK 9:28-35">ሉቃ 9:28-35</ref>.</char></note> <verse eid="2PE 1:17"/><verse number="18" style="v" sid="2PE 1:18"/>ኑኒ ጌሻ ዙማ ቦላ እያራ ደእያ ዎደ ሄ ቃላይ ሳሎፐ ይሽን ስእዳ።<verse eid="2PE 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19"/>ኑስ ሄሳፈ አያ አማነትዳ ትንብተ ቃል ደኤስ። ሳእ ዎንታና ጋካናዉነ ባካል ህንተ ዎዛናን ዶላና ጋካናዉ፥ ማን ፖእያ ፖኦ አስ ናገይሳዳ፥ ህንተ ሄ ቃላ ናግኮ ሎኦ ኦታ። <verse eid="2PE 1:19"/><verse number="20" style="v" sid="2PE 1:20"/>ኡባፈ ካሰትድ ሀይሳ ኤርተ። ጌሻ ማፃፋን ፃፈትዳ ትንብተ ቃላ ኦንካ ባ ዶስዳዳ ብርሻናዉ ዳንዳኤና። <verse eid="2PE 1:20"/><verse number="21" style="v" sid="2PE 1:21"/>ትንብተ ኡባ፥ ፆሳይ ኪትዳ አሳት ጌሻ አያናይ ካለን፥ ኦድዶሶናፐ አትሽን፥ አሳ ሸነን ኦድቦኮና።<verse eid="2PE 1:21"/></para>
  <chapter eid="2PE 1"/>
  <chapter number="2" style="c" sid="2PE 2"/>
  <para style="s1">ዎርዶ አስታማረታ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1"/>ሽን ዎርዶ ናበት ካሰ አሳ ግዶን ደኤይሳ መላ ሀእካ ዎርዶ አስታማረት ህንተ ግዶን ደንዳና። ኤንቲ ባንታና ዎዝዳ፥ ጎዳ ካድድ፥ ይስያ ዎርዶ ትምርትያ ኤሀና። ሄሳን ኤንቲ ባንታ ቦላ ኤለስድ ዮ ኤሆሶና። <verse eid="2PE 2:1"/><verse number="2" style="v" sid="2PE 2:2"/>ዳሮ አሳይ ዬላይያ ኤንታ ኢታ ኦግያ ካላና፤ ኤንታ ጋሶን ቱማ ኦገይ ጫየታና። <verse eid="2PE 2:2"/><verse number="3" style="v" sid="2PE 2:3"/>ዎርዶ አስታማረት ሚሸ ያርድ ባንታዉ መ ከስዳ ሀይሰን ህንተና ቦንቃና። በንፐ ዶምድ ኤንታ ፕርዳይ ጊግድ ኡትስ፤ ኤንታ ዮይካ ኤንታና ናግድ ኡትስ።<verse eid="2PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4"/>ናጋራ ኦዳ ኪታንቾታስ ፆሳይ ቃቶና፥ ፕርዳ ጋላስ ጋካናዉ ጋናመ ማ ኦላን ኤንታ ቃች የግስ። <verse eid="2PE 2:4"/><verse number="5" style="v" sid="2PE 2:5"/>ሄሳዳካ፥ ፆሳይ ፅሎተባ ኦድያ ኖሄነ ሀራ ላፑን አሳታ አሽድ፥ ፆሳ ጎይኖና አሳይ ደእያ በን አላምያ ቃቶና ዮ ሃን ይስስ።<note caller="-" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="GEN 6:1-7:24">መ 6:1—7:24</ref>.</char></note> <verse eid="2PE 2:5"/><verse number="6" style="v" sid="2PE 2:6"/>ጌላታስ ሌምሶ ግዳና መላ ፆሳይ ሶዶመነ ጋሞራ ካታማታ ብዶ ኦድ ፁግድ ይስስ።<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="GEN 19:24">መ 19:24</ref>.</char></note> <verse eid="2PE 2:6"/><verse number="7" style="v" sid="2PE 2:7"/>ህገስ ኪተቶና ላይማትያ አሳታ ግዶን ዋየትሸ ደእዳ ፅሎ ሎፀ ፆሳይ አሽስ።<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-16">መ 19:1-16</ref>.</char></note> <verse eid="2PE 2:7"/><verse number="8" style="v" sid="2PE 2:8"/>ሄ ፅሎ አደይ ኤንታ ግዶን ደእሸ፥ ኤንቲ ኦያ ኢታ ኦሱዋ ጋላስ ጋላስ በእዳ ዎደነ ስእዳ ዎደ እያ ሎኦ ዎዛናይ ኡንኤቴስ። <verse eid="2PE 2:8"/><verse number="9" style="v" sid="2PE 2:9"/>ሄሳ ግድኮ፥ ጎዳይ፥ ባና ጎይንያ አሳታ ፓጨፐ ዋት አሻነኮ፥ ቃስ ናጋራንቾታ ፕርዳ ጋላሳስ ጋካናዉ ዋትድ ሴርሸ ናግሳኔኮ ኤሬስ። <verse eid="2PE 2:9"/><verse number="10" style="v" sid="2PE 2:10"/>ኡባፈ አድ ቱና አሞን አሾ ቆፋ ካለይሳታነ ማታ አዋታ ካይሳታ፥ ፕርዳ ጋላስ ጋካናዉ ጎዳይ ናግስስ።</para>
  <para style="p" vid="2PE 2:10">ሄ አሳት ጋንጀ ምኖነ ኦቶራንቾ ግድያ ግሾ፥ ሳሎ መተታ ጫይሸ ያዮኮና። <verse eid="2PE 2:10"/><verse number="11" style="v" sid="2PE 2:11"/>ሽን ኪታንቾት ዎርዶ አስታማረታፐ ዎልቃንነ ምኖተን ዳሮ አሶናሽን ጎዳ ስንን ሳሎ መተታ ጫዮኮና። <verse eid="2PE 2:11"/><verse number="12" style="v" sid="2PE 2:12"/>ሽን ሄ አሳት ባንታ ኤሮናባን ገልድ ጫዮሶና። ኤንቲ ኦይከታናዉነ ሀይቃናዉ የለትዳ፥ ዎዛን ባይና ዶአ መላ ሀኖሶና፤ ኤንትካ ዎራ ዶአዳ ጮ ያና።<verse eid="2PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 2:13"/>ኤንቲ ጋዳ መቱዋዳ ዛር መቶታና። ሴታ ጋላስ የፅሸ ጉፐይሳ ኡፋይስያባ ግድ ቆፖሶና። ኤንቲ ካዉሻታነ ቱናታ ግድ ደእሸ ህንተራ ሻከትያ ሲቆ እማቱዋን ኡፋይቶሶና። <verse eid="2PE 2:13"/><verse number="14" style="v" sid="2PE 2:14"/>ላይማትያ ማጫስ ፄልድ አጎና አይፈይ ኤንታዉ ደኤስ፤ ቃስ ናጋራ ኦይሳ አጎኮና። አማኖን ምንቦና አሳ ጭሞሶና። ኤንታዉ ኡባ ዎደ አሞትያ ዎዛን ደኤስ፤ ኤንቲ ባደትዳይሳታ። <verse eid="2PE 2:14"/><verse number="15" style="v" sid="2PE 2:15"/>ኤንቲ ሱረ ኦገ አግድ፥ ማካላ ሚሸ ሲቅድ ባልዳ፥ ብኦራ ናኣ ባላማ ኦግያ ካልዶሶና።<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="NUM 22:4-35">ታይቦ 22:4-35</ref>.</char></note> <verse eid="2PE 2:15"/><verse number="16" style="v" sid="2PE 2:16"/>እ ባ ናጋራ ጋሶን ሀንቀትስ፤ ዶን ባይና ሀረይ አሳዳ ሃሳይድ ናብያ ጎሻተ ተቅስ።<verse eid="2PE 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17"/>ሄ አሳት መልዳ ፑልቶታ መላነ ጫርኮይ ቶክድ ኤፍያ ሻራ መላ፤ ኤንታ ናገይ ሳካና ማ። <verse eid="2PE 2:17"/><verse number="18" style="v" sid="2PE 2:18"/>ኤንቲ ሀዳነ ኦቶሮ ኦዳ ኦደትሸ ባላን ደእያ አሳ ግዶፈ ከስ ኤክድ ቡሮ ምንቦና አሳታ ላይማተ አሾ አሞን ጭምድ ባለሶና። <verse eid="2PE 2:18"/><verse number="19" style="v" sid="2PE 2:19"/>ኤንቲ ባንታዉ ዮ አይለተን ደእሸ ሀራታኮ፥ “ህንተ አይለተፈ ከያና” ያጎሶና። አይስ ጊኮ፥ አስ ባ ፆነትዳባ ኡባስ አይለ። <verse eid="2PE 2:19"/><verse number="20" style="v" sid="2PE 2:20"/>ኤንቲ አሽያ ኑ ጎዳ የሱስ ክርስቶሳ ኤርድ ሀ አላምያ ቱናተፈ ከስ ኤክዳፐ ጉየ፥ ዛር ቃፀትድ ፆነትኮ ካሰ ደእያ ደኡዋፐ ጉየይስ ኤንታዉ ኢታ ግዳና። <verse eid="2PE 2:20"/><verse number="21" style="v" sid="2PE 2:21"/>ኤንቲ ፅሎተ ኦግያ ኤር ስሚድ አገይሳፈ ኮይሮትድ ጌሻ ኪታ ኤሮናኮ ኤንታዉ ሎኦሽን። <verse eid="2PE 2:21"/><verse number="22" style="v" sid="2PE 2:22"/>“ካን ባ ጮሻኮ ጉየ ስሜስ” ቃስ፥ “ሜጨትዳ ጉዱንይ ጉየ ስሚድ ኡርቃን ጎንዶረቴስ” ግያ ሌምሶይ ቱማ ግደይስ ኤንታ ቦላ ኦስ።<note caller="-" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="PRO 26:11">ሌም 26:11</ref>.</char></note><verse eid="2PE 2:22"/></para>
  <chapter eid="2PE 2"/>
  <chapter number="3" style="c" sid="2PE 3"/>
  <para style="s1">ጎዳይ ያና</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1"/>ታ ሲቆ እሻቶ፥ ሀይስ ታ ህንተዉ ፃፍዳ ዳብዳበይ ናምአን። ታኒ ሀ ናምኡ ዳብዳበታካ ህንተዉ ፃፍዳይ፥ ህንተ ሱረ ቆፋ ቆፓናዳ ህንተና ደንናሳ። <verse eid="2PE 3:1"/><verse number="2" style="v" sid="2PE 3:2"/>ቃስ ጌሻ ናበት በን ኦድዳ ቃላነ ኑና አሽያ ጎዳይ፥ ሀዋረታ ባጋራ ኪትዳ ኪታ ህንተ ሀሳያና መላ ኮያይስ። <verse eid="2PE 3:2"/><verse number="3" style="v" sid="2PE 3:3"/>ኡባፈ ካሰትድ፥ ዎደ ዉርሰን ባንታ አሙዋ ካልድ አሰ ቶቸይሳት፥ ቶችሸ ያናይሳ ኤርተ።<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="JUD 1:18">ይሁ 18</ref>.</char></note> <verse eid="2PE 3:3"/><verse number="4" style="v" sid="2PE 3:4"/>ኤንቲ፥ “ታ ያና ግዳይስ አዉን ደኢ? ኑ አዋት ሀይቅዶሶና፥ ሽን ኡባባይ ሳእ መቶሳፐ ዶምድ ደኤይሳዳ ደኤስ” ያጎሶና። <verse eid="2PE 3:4"/><verse number="5" style="v" sid="2PE 3:5"/>ዳሮ ዎደፐ ካሰ ሳሎይ ፆሳ ቃላን መትዳይሳ፤ ቃስ ሳእ ሃፈነ ሃን መትዳይሳ ኤርሸ ካዶሶና።<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="GEN 1:6-9">መ 1:6-9</ref>.</char></note> <verse eid="2PE 3:5"/><verse number="6" style="v" sid="2PE 3:6"/>ሄ ዎደ ደእያ ሳአይ ሃን ምተትድ ይስ።<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 7:11">መ 7:11</ref>.</char></note> <verse eid="2PE 3:6"/><verse number="7" style="v" sid="2PE 3:7"/>ሽን ሀእ ደእያ ሳሎይነ ሳእ፥ ጌላት ፕርደትያ ጋላሳይነ ይያ ጋላሳይ ጋካናዉ ሄ ቃላን ታማስ ናገትድ ደኦሶና።<verse eid="2PE 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8"/>ሽን ታ ሲቆ እሻቶ፥ ሀ እስባ ዶጎፕተ። ጎዳ ማታን እስ ጋላስ ሙኩሉ ላይ መላ ግደይሳነ ሙኩሉ ላይ እስ ጋላሳ መላ ግደይሳ ዶጎፕተ።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="PSA 90:4">ማዝ 90:4</ref>.</char></note> <verse eid="2PE 3:8"/><verse number="9" style="v" sid="2PE 3:9"/>እሶት እሶት ጋምእስ ግድ ቆፐይሳዳ፥ ጎዳይ ባ ኡፋይሳ ቃላ ግሾ ጋምኤና። ሽን ኦንካ ዮና መላ ኮይድ፥ ኡባይ ባንታ ናጋራፐ ስማና መላ ህንተ ግሾ ግድ ገንጬስ።<verse eid="2PE 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10"/>ሽን ጎዳ ጋላሳይ ካይሶዳ ያና። ሄ ጋላሳን ሳሎት ዎልቃማ ጉንን ያና፤ ሳሎ መተት ታማን ፁገታና፤ ሳእነ እያ ቦላ ደእያ ኡባይ ያና።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 24:43">ማቶ 24:43</ref>፤ <ref loc="LUK 12:39">ሉቃ 12:39</ref>፤ <ref loc="1TH 5:2">1 ተሰ 5:2</ref>፤ <ref loc="REV 16:15">ቆን 16:15</ref>.</char></note> <verse eid="2PE 3:10"/><verse number="11" style="v" sid="2PE 3:11"/>ህዛ፥ ኡባባይ ሄሳዳ ሀንዳ ይያባ ግድኮ ህንተ አይ መላ አስ ግዳናዉ በሲ? ህንተ ጌሽነ ፆሳ ዳንያ ደኦ ዳናዉ በሴስ። <verse eid="2PE 3:11"/><verse number="12" style="v" sid="2PE 3:12"/>ህንተ ስንራ ያ ፆሳ ጋላሳ ናግሸ ህንተዉ ዳንዳኤትያባ ኡባ ኦድ ሄ ጋላሳ ኤሶይተ። ሄ ጋላስ ሳሎትነ እያን ደእያባይ ታማን ፁገታና፤ ዎልቃማ ሱላን ትልአና። <verse eid="2PE 3:12"/><verse number="13" style="v" sid="2PE 3:13"/>ሽን ኑኒ ፅሎተ ሃርያ ኦራ ሳሎነ ኦራ ሳአ ፆሳ ኡፋይሳ ቃላዳ ናጎስ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ISA 65:17">እሳ 65:17</ref>፤ <ref loc="ISA 66:22">66:22</ref>፤ <ref loc="REV 21:1">ቆን 21:1</ref>.</char></note><verse eid="2PE 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14"/>ሄሳ ግሾ፥ ታ ሲቆ እሻቶ፥ ኑ ሄ ጋላሳ ናግያ ግሾ ፖኮይነ ቦረይ ባይናይሳታ ግድድ፥ ጎዳራ ሳሮን ዳናዉ ምንተ። <verse eid="2PE 3:14"/><verse number="15" style="v" sid="2PE 3:15"/>አስ ኡባይ አታና መላ ኮይድ ጎዳይ ዳንዳኤይሳ ዶጎፕተ። ቃስ ኑ ሲቆ እሻይ፥ ጳዉሎስ፥ ፆሳይ እያዉ እምዳ ጭንጫተን ሄሳዳ ህንተዉ ፃፍስ። <verse eid="2PE 3:15"/><verse number="16" style="v" sid="2PE 3:16"/>እ ባ ዳብዳበታ ኡባን ሄሳታባ ፃፍስ። እያ ዳብዳበታ ግዶን አኬካናዉ ዋይስያ ቆፋት ደኦሶና። ታማርቦናነ ምንቦና አሳት ሀራ ፆሳ ቃላ ምርቀይሳዳ ሀ ኪታታካ ያናዉ ማችድ ምርቆሶና።<verse eid="2PE 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17"/>ሄሳ ግሾ፥ ታ ሲቆ እሻቶ፥ ህንተ ሄሳ ኤርያ ግሾ ማካላታ ባላን ጭመትድ፥ ዮና መላነ ምንድ ደእያ በሳፈ ኩንዶና መላ ናገትተ። <verse eid="2PE 3:17"/><verse number="18" style="v" sid="2PE 3:18"/>ሽን ህንተ ኑና አሽያ ኑ ጎዳ፥ የሱስ ክርስቶሳ አ ኬሀተንነ ኤራተን ድጭተ። እያዉ ሀእካ መርናዉካ ቦንቾይ ግዶ። አምንእ።<verse eid="2PE 3:18"/></para>
  <chapter eid="2PE 3"/>
</usx>
