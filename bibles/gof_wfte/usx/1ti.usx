<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">1 ፅሞትዮሳ ኪታ</para>
  <para style="toc1">1 ፅሞትዮሳ ኪታ</para>
  <para style="toc3">1 ፅሞ</para>
  <para style="toc2">1 ፅሞትዮሳ</para>
  <para style="mt1">ጳዉሎስ ፅሞትዮሳስ</para>
  <para style="mt2">ፃፍዳ ኮይሮ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ፅሞትዮሳ ጌተትያ፥ አማንያ ናአተይ፥ ጉ ኢሰን የለትስ (<char style="xt"><ref loc="ACT 16:1-3">ሀዋ 16:1-3</ref></char>)። እያ አይያ አይሁደ፤ እያ አዋይ ቃስ ግርከ አስ። እ ጳዉሎሳራ እስፈ ኦስ፤ ቃስ ዎንገላ ኦሶን ጳዉሎሳ ማታን ማድያ አስ። ጳዉሎስ፥ ፅሞትዮሳስ ፃፍዳ ኮይሮ ኪታይ፥ ሄ አይፈ ኦዳታ ምንድ ፄሌስ።</para>
  <para style="ipi">ሀ ኪታ ኮይሮ ቆፋይ፥ ዎሳ ኬን ደንድዳ ዎርዶ ትምርትያባ ምንድ ኦዴስ። ሀ እማ ትምርተይ አይሁደ ትምርትያፈ ባጋ፥ ቃስ አይሁደ ግዶና አሳ ትምርትያፈ ባጋ ኤኬስ። ሄስካ፥ “ሀ በንትያ አላመይ ናጋራን ኢትዳ ግሾ፥ አስ አቶተ ደማናዉ ዱማ ግድዳ ፁራ ኤራናዉ፥ እስ እስ ካታ ሞና አጋናዉነ ማቾ ኤኮና ዎይኮ አዝና ገሎና ዳናዉ ኮሼስ” ግያ ቆፋ ባሶ ኦድ ደንድስ።</para>
  <para style="ipi">ናምአን ቆፋይ፥ ዎሳ ኬ አይሶባነ ጎይኖ ዎጋባ ታማርስያ ትምርተ፥ ሄሳዳካ ዎሳ ኬ ካለይሳትነ ኤንታ ማደይሳት አይ መላ ማራ ዱሱ ዳናዉ በሲያኮ ኦዴስ።</para>
  <para style="ipi">ሄን ቆፋይ፥ ፅሞትዮስ የሱስ ክርስቶሳስ ኦያ ሎኦ አስ ዋንድ ግዳናዉ በሲያኮ፥ ቃስ አማንያ አሳ ማታን እያዉ ደእያ አዋተይ አይበኮ፥ ጳዉሎስ እያ ዞርዳ ዞርያ በሴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ገሎ ቆፋ (<char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref></char>)</para>
  <para style="io1">ዎሳ ኬ አይስያ አሳ (<char style="ior"><ref loc="1TI 1:3-3:13">1:3—3:13</ref></char>)</para>
  <para style="io1">ኑ አማኑዋ ፁራ (<char style="ior"><ref loc="1TI 3:14-4:5">3:14—4:5</ref></char>)</para>
  <para style="io1">ፅሞትዮሳስ እመትዳ ዞረ (<char style="ior"><ref loc="1TI 4:6-6:21">4:6—6:21</ref></char>)</para>
  <chapter number="1" style="c" sid="1TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1"/>ኑና አሽያ ፆሳንነ ኑ ኡፋይሳን ናግያ የሱስ ክርስቶሳን ኪተትዳ፥ የሱስ ክርስቶሳ ሀዋረ ግድዳ፥ ጳዉሎሳፐ፥ <verse eid="1TI 1:1"/><verse number="2" style="v" sid="1TI 1:2"/>አማኖን ታዉ ቱማ ናአ ግድዳ ፅሞትዮሳስ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሀዋ 16:1</ref>.</char></note></para>
  <para style="p" vid="1TI 1:2">ፆሳ ኑ አዋ፥ ኑ ጎዳ ክርስቶሳ አ ኬሀተይ፥ ማሮተይነ ሳሮተይ ነዉ ግዶ።<verse eid="1TI 1:2"/></para>
  <para style="s1">ዎርዶ ትምርተፈ ናገተ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3"/>ታኒ ማቀዶነ ባሸ ነና ሀዳርዳይሳዳ፥ እስ እስ አሳት ዎርዶ ትምርትያ ታማርሰይሳ ድጋናዉ ነ ኤፈሶናን ጋምአና መላ ኮያይስ። <verse eid="1TI 1:3"/><verse number="4" style="v" sid="1TI 1:4"/>ኤንቲ ጎእ ባይና ሀይሰ ኦዳነ ባንታ ኮቻ ታይቡዋ አጋናዳ ኦዳ። ሄሳ መላባይ ፓላማ ካለስፐ አትሽን፥ አማኖን ኦሰትያ ፆሳ ኦሱዋስ ማደና። <verse eid="1TI 1:4"/><verse number="5" style="v" sid="1TI 1:5"/>ሀ ኪታ ሁጰ ቆፋይ ጌሻ ዎዛናፐ፥ ሎኦ ካሀፐነ ቱማ አማኑዋፐ በንትያ ሲቁዋ ደንናሳ። <verse eid="1TI 1:5"/><verse number="6" style="v" sid="1TI 1:6"/>እስ እስ አሳት ሀይሳ አግድ፥ ፓና ኦዳኮ ስምዶሶና። <verse eid="1TI 1:6"/><verse number="7" style="v" sid="1TI 1:7"/>ኤንቲ ፆሳ ህግያ አስታማረ ግዳናዉ ኮዮሶና። ሽን ኤንቲ አይ ኦድያኮ ዎይኮ ቱማ ኦድ ኦደይስ እ አይበኮ ኤሮኮና።<verse eid="1TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8"/>አስ በሰይሳዳ ህግያን ጎኤትኮ ህገይ ሎኦ ግደይሳ ኤሮስ። <verse eid="1TI 1:8"/><verse number="9" style="v" sid="1TI 1:9"/>እስባ አኬካናዉ ኮሼስ። ህገይ ሎኦ አሳስ መትቤና። ሽን ህገይ፥ ህገ መንይሳታ፥ ዎራንታ፥ ፆሰ ያዮናይሳታ፥ ሸምፖ ዎይሳታ፥ ናጋራንቾታ፥ ጌሻተ ባይናይሳታ፥ ቱናታ፥ ሀር አቶሽን ባንታ አይዉ ዎይኮ አዋ ዎይሳታ፥ <verse eid="1TI 1:9"/><verse number="10" style="v" sid="1TI 1:10"/>ላመይሳታ፥ አደይ አደራ ላይማተይሳታ፥ አሰ ባይዘይሳታ፥ ዎርዳንቾታ፥ ዎርዶን ጫቀይሳታ፥ ዎይኮ ቱማ ትምርትያራ ጋሄቶና አይ ኦሶ ኦይሳታ ሴራናዉ ከይስ። <verse eid="1TI 1:10"/><verse number="11" style="v" sid="1TI 1:11"/>ሄ ትምርተይ ቦንቾነ አንጀትዳ ፆሳይ ታኒ አዋጃና መላ ታዉ ሀዳራ እምዳ ዎንገላ ግዶን ደኤስ።<verse eid="1TI 1:11"/></para>
  <para style="s1">ፆሳ ማሮተስ ጋላታ</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12"/>ታኒ ኦያ ኦሱዋን ታዉ ዎልቃ እምዳ ኑ ጎዳ ክርስቶስ የሱሳ ጋላታይስ። ታና ባ ኦሱዋስ ሹምድ ሄ ኦሱዋስ በሰይሳ ግድ ታይብዳ ግሾ እያ ጋላታይስ። <verse eid="1TI 1:12"/><verse number="13" style="v" sid="1TI 1:13"/>ታኒ ሀይሳፈ ካሰ እያ ጫየይሳ፥ እያ የደይሳነ መቶይሳ ግድኮካ ታኒ ሄሳ ኤሮናነ አማኖና ኦዳ ግሾ ፆሳይ ታና ማርስ።<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሀዋ 8:3</ref>፤ <ref loc="ACT 9:4-5">9:4-5</ref>.</char></note> <verse eid="1TI 1:13"/><verse number="14" style="v" sid="1TI 1:14"/>ኑ ጎዳይ ባ አ ኬሀተ ታ ቦላ ጉስድ፥ ሄ አ ኬሀተራ አማኖነ ሲቆ ክርስቶስ የሱሳ ባጋራ ታዉ እሚስ።<verse eid="1TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15"/>“ክርስቶስ የሱሲ ናጋራንቾታ አሻናዉ ሀ አላምያ ይስ” ግያ ቃላይ አማንይሳነ አሳ ኡባይ ኤካናዉ በሰይሳ። ኡባፈ አዳ ናጋራንቾይ ታና። <verse eid="1TI 1:15"/><verse number="16" style="v" sid="1TI 1:16"/>ሽን መርና ደኡዋ ኤካናዉ እያ አማንያ አሳስ ታኒ ሌምሶ ግዳና መላ የሱስ ክርስቶሲ ዳሮ ዳንዳእስ። ታዉ ኡባፈ አዳ ናጋራንቹዋስ ፆሳይ ባ ማሮታ ዳርስስ። <verse eid="1TI 1:16"/><verse number="17" style="v" sid="1TI 1:17"/>አይፈን በንቶናይሳስ፥ እስ ፆሳስ፥ ሀይቆናይሳስ፥ መርና ካዋስ፥ መርናፐ መርና ጋካናዉ ጋላታይነ ቦንቾይ ግዶ። አምንእ።<verse eid="1TI 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18"/>ፅሞትዮሳ፥ ታ ናአዉ፥ ካሰ ነባ ናበት ኦድዳ ቃላ ቦላ ኤቃዳ ሀ ኪታ ሀዳራ ነዉ እማይስ። ነ ሄ ቃላ ካልኮ ሎኦ ኦላ ኦለታና። <verse eid="1TI 1:18"/><verse number="19" style="v" sid="1TI 1:19"/>አማኖይነ ሎኦ ካህ ነዉ ደኦ። እሶት እሶት ካሀ ይድ ማርካበይ ሆበን የይሳዳ ባንታ አማኑዋ ይስዶሶና። <verse eid="1TI 1:19"/><verse number="20" style="v" sid="1TI 1:20"/>ሄሳ ሀንዳይሳታ ግዶን ሄመነዮስነ እስክንድረይ ደኦሶና። ኤንቲ ታማርድ ፆሳ ጫየይሳ አጋና መላ ታኒ ፃላሄስ ኤንታና አ እማስ።<verse eid="1TI 1:20"/></para>
  <chapter eid="1TI 1"/>
  <chapter number="2" style="c" sid="1TI 2"/>
  <para style="s1">ኡባስ ዎስተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1"/>ኡባፈ ስንታዳ፥ አሳ ኡባስ ፆሳ ኦይቻናዉ፥ ዎሳናዉ፥ ጋናታናዉነ ጋላታናዉ በሰይሳ ታኒ ነና አኬክሳይስ። <verse eid="1TI 2:1"/><verse number="2" style="v" sid="1TI 2:2"/>ኑኒ ቱማ አያና ደኦንነ ጌሻተን ፆሳ ጎይንሸ ሳሮተንነ ዎፑ ግዳ ደኦን ዳና መላ ካዎታስነ ሹማታ ኡባስ ዎስተ። <verse eid="1TI 2:2"/><verse number="3" style="v" sid="1TI 2:3"/>ሄሳ መላ ዎሳይ ኑና አሽያ ፆሳ ስንን ሎኦነ ኡፋይስያባ። <verse eid="1TI 2:3"/><verse number="4" style="v" sid="1TI 2:4"/>ፆሳይ አስ ኡባይ አታናዳነ ቱማ ኤራናዳ ኮዬስ። <verse eid="1TI 2:4"/><verse number="5" style="v" sid="1TI 2:5"/>እስ ፆሲ ደኤስ። ፆሳፈነ አሳፐ ግዶን ግድድ ስገያ እሶይ ደኤስ፤ እካ አሰ ግድዳ ክርስቶስ የሱሳ። <verse eid="1TI 2:5"/><verse number="6" style="v" sid="1TI 2:6"/>እ አሳ ኡባ ዎዛናዉ ባና አድ እሚስ። ፆሳይ ባ ዎድያን አሳ ኡባ ዎዛናዉ ኮየይሳ በሲያ ማርካይ ሀይሳ። <verse eid="1TI 2:6"/><verse number="7" style="v" sid="1TI 2:7"/>ፆሳይ ታና ዎንገላስ አስታማረነ ሀዋረ ኦድ ዶርዳይ ሄሳሳ። ታኒ ቱማ ኦዳይስ፤ ዎርዶትከ፤ አማኖንነ ቱማን አይሁደ ግዶና አሳስ ማርካታና መላ ፆሳይ ታና ሹምስ።<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="2TI 1:11">2 ፅሞ 1:11</ref>.</char></note><verse eid="1TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8"/>ሄሳ ግሾ፥ ኡባ በሳን ደእያ አደት፥ ባንታና ፆሳስ ዱማይድ፥ ሀንቆነ ፓላማ ድግድ፥ ባንታ ኩሽያ ፑደ ደንድ ፆሳ ዎሳና መላ ኮያይስ።<verse eid="1TI 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 2:9"/>ሄሳዳ ማጫሳይ ባንታና ሃርዳይሳ ቆንጭስያ፥ ቦንቾይነ ማር ደእያ ማኡዋ ማአናዉ በሴስ። ኤንቲ ማር ባይና ሁጰ ዳን፥ ዎርቃን ዎይኮ እንቆን፥ ዎይኮ አልኦ አፍላን ባንታና አሌቅሶፖ።<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1PE 3:3">1 ጰፅ 3:3</ref>.</char></note> <verse eid="1TI 2:9"/><verse number="10" style="v" sid="1TI 2:10"/>ሽን ፆሳስ ጎይናይስ ግያ ማጫሳይ ባንታዉ በሰይሳዳ ሎኦባ ኦና።<verse eid="1TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11"/>ማጫስ ኪተተን ስእ ግድ ታማሮ። <verse eid="1TI 2:11"/><verse number="12" style="v" sid="1TI 2:12"/>ታኒ ማጫሳይ ታማርሳና መላ ዎይኮ አደ ቦላ አዋታና መላ ግዶናሽን፥ ስእ ግድ ዳና መላ ኮያይስ። <verse eid="1TI 2:12"/><verse number="13" style="v" sid="1TI 2:13"/>አዳመይ ኮይሮ መትስ፤ ጉየፐ ሄዋና መታሱ።<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="GEN 2:7">መ 2:7</ref>፥ <ref loc="GEN 2:21-22">21-22</ref>.</char></note> <verse eid="1TI 2:13"/><verse number="14" style="v" sid="1TI 2:14"/>ቃስ ጭመታዳ ፆሳ ህግያ መንዳይ ማጫስፐ አትሽን፥ አዳመ ግደና።<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="GEN 3:1-6">መ 3:1-6</ref>.</char></note> <verse eid="1TI 2:14"/><verse number="15" style="v" sid="1TI 2:15"/>ሽን ማጫስ አማኖን፥ ሲቆንነ ጌሻተን ባንታና ሃርድ ደእኮ<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fq" closed="false">ባንታና ሃርድ ደእኮ፦ </char><char style="ft" closed="false">ዎይኮ እያ የልዳ ናይት አማኖን፥ ሲቆንነ ጌሻተን ባንታና ሃርድ ደእኮ።</char></note> ናይታ የሎን አታና።<verse eid="1TI 2:15"/></para>
  <chapter eid="1TI 2"/>
  <chapter number="3" style="c" sid="1TI 3"/>
  <para style="s1">ዎሳ ኬ ጭማታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1"/>ኦንካ፥ “ዎሳ ኬ ካለያ አስ ግዳናዉ ኮይኮ ሎኦባ አሞቴስ” ግያ ኦዳይ ቱማ። <verse eid="1TI 3:1"/><verse number="2" style="v" sid="1TI 3:2"/>ዎሳ ኬ ካለያ አስ ቦረቶናይሳ፥ እስ ማቸ ፃላል ደኤይሳ፥ ማራን ደኤይሳ፥ ባና ሃረይሳ፥ በሰይሳዳ ኦይሳ፥ እማ ሞከይሳ፥ ታማርሳናዉ ዳንዳኤይሳ፥<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">ትቶ 1:6-9</ref>.</char></note> <verse eid="1TI 3:2"/><verse number="3" style="v" sid="1TI 3:3"/>ማቶናይሳ፥ ኦየቶናይሳ፥ ፓላሞናይሳ፥ ሚሸ ሲቆናይሳ፥ <verse eid="1TI 3:3"/><verse number="4" style="v" sid="1TI 3:4"/>እያ ናይት እያዉ ኪተተይሳነ ቦንቸይሳ፥ ባ ኬ አይሳናዉ ዳንዳኤይሳ ግዳናዉ በሴስ። <verse eid="1TI 3:4"/><verse number="5" style="v" sid="1TI 3:5"/>እስ አስ ባ ኬ አይሳናዉ ዳንዳኦና እፅኮ፥ ፆሳ ዎሳ ኬ ዋት አይሳናዉ ዳንዳኢ?<verse eid="1TI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 3:6"/>ኦቶሮን ሱገትድ፥ ፃላሄይ ፆሳ ፕርዳን ኩንድዳይሳዳ ኩንዶና መላ፥ ኦራ አማንዳ አስ ግዳናዉ በሰና። <verse eid="1TI 3:6"/><verse number="7" style="v" sid="1TI 3:7"/>ቦረንነ ፃላሄ ፅሄን ገሎና መላ ሄ ኡራይ አማኖና አሳ ማታን ናሸተይሳ ግዳናዉ በሴስ።<verse eid="1TI 3:7"/></para>
  <para style="s1">ዎሳ ኬ ዳቆነታ</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8"/>ሄሳዳ ቃስ ዎሳ ኬ ዳቆነት ቦንቸትዳይሳታ፥ ናምኡ ዶና ኦደቶናይሳታ፥ ዳሮ ዎይነ ኡሹ ኡዮናይሳታ፥ ሚሸ ያረቶናይሳታ፥ <verse eid="1TI 3:8"/><verse number="9" style="v" sid="1TI 3:9"/>አማኑዋ ፁራ ጌሻ ካሀን ናገይሳታ ግዳናዉ በሴስ። <verse eid="1TI 3:9"/><verse number="10" style="v" sid="1TI 3:10"/>ኤንቲ ኮይሮትድ ፓጨታናዉ ኮሼስ፤ ኤንታ ቦላ ቦረይ ባይና እፅኮ፥ ዎሳ ኬ ዳቆነ ግድድ ኦ።<verse eid="1TI 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11"/>ሄሳዳካ፥ ኤንታ ማጫሳት ቦንቸትዳይሳታ፥ ዝግሮናይሳታ፥ ማራን ደኤይሳታ፥ ኡባባን አማነተይሳታ ግዳናዉ በሴስ።<verse eid="1TI 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12"/>ዎሳ ኬ ዳቆነት እስ ማች ፃላል ደኤይሳ ግዶ። ባ ናይታነ ባ ኬ ሎይ አይሰይሳ ግዳናዉ በሴስ። <verse eid="1TI 3:12"/><verse number="13" style="v" sid="1TI 3:13"/>ዎሳ ኬ ዳቆነ ግድድ፥ ሎኦ ኦሶ ኦይሳት፥ ኤንታዉ ግታ ቦንቾ ቃስ ክርስቶስ የሱሳን ባንታዉ ደእያ አማኑዋባ ኦዳናዉ ዳሮ ምኖተ ደማና።<verse eid="1TI 3:13"/></para>
  <para style="s1">አማኖ ግታ ፁራ</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14"/>ታኒ ሀ ኪታ ነዉ ፃፋሸ፥ ኤለሳዳ ኔኮ ባና ጋዳ ኡፋይስ ዎይስ። <verse eid="1TI 3:14"/><verse number="15" style="v" sid="1TI 3:15"/>ሽን ታኒ ቦና ጋምእኮ፥ ፆሳ ኬን አሳይ ዋንድ ዳናዉ በሲያኮ ኤራና መላ ሀይሳ ነዉ ፃፋይስ። ደኦ ፆሳ ኬይ ቱማተስ ቱስነ ባሶ። <verse eid="1TI 3:15"/><verse number="16" style="v" sid="1TI 3:16"/>ኑ አማኑዋ ፁራይ ስይ ባይና ግታ።</para>
  <para style="q1" vid="1TI 3:16">ክርስቶስ አሾ ማእድ ቆንጭስ፤</para>
  <para style="q2" vid="1TI 3:16">እያ ቱማተ ጌሻ አያናይ ማርካትስ።</para>
  <para style="q1" vid="1TI 3:16">ኪታንቾታስ በንትስ፤</para>
  <para style="q2" vid="1TI 3:16">እ ካዎተ ኡባስ ሳባከትስ።</para>
  <para style="q1" vid="1TI 3:16">አላመን ደእያ አሳን አማነትስ፤</para>
  <para style="q2" vid="1TI 3:16">ቦንቾን ሳሎ ኤከትስ።<verse eid="1TI 3:16"/></para>
  <chapter eid="1TI 3"/>
  <chapter number="4" style="c" sid="1TI 4"/>
  <para style="s1">ዎርዶ አስታማረታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1"/>ያና ዎድያን ባለያ አያናታነ ቱና አያናታ ትምርተ ካልድ፥ እስ እስ አሳይ አማኑዋ ካዳናይሳ ጌሻ አያናይ ቆንጭስድ ኦድስ። <verse eid="1TI 4:1"/><verse number="2" style="v" sid="1TI 4:2"/>ሄሳ መላ ትምርተይ ኤንታ ካሀይ ዶጭን፥ አሳ ባለያ ዎርዳንቾ አስታማረታፐ ዬስ።<verse eid="1TI 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 4:3"/>ሄሳ መላ አሳት ኤኮነ ገሎ ቃስ እስ እስ ካታ ሞና መላ ድጎሶና። ሽን አማነይሳትነ ቱማ ኤረይሳት ፆሳ ጋላት ዎስድ ማና መላ ፆሳይ ካ መስ። <verse eid="1TI 4:3"/><verse number="4" style="v" sid="1TI 4:4"/>ፆሳይ መዳ ኡባባይ ሎኦ። ፆሳ ጋላትድ ሚኮ ዎራ ዎያባይ አይብካ ባዋ። <verse eid="1TI 4:4"/><verse number="5" style="v" sid="1TI 4:5"/>ኡባባይ ፆሳ ቃላንነ ዎሳን ጌሽ ግዴስ።<verse eid="1TI 4:5"/></para>
  <para style="s1">ክርስቶሳ አማንያ አይለ</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6"/>ሄሳ ግሾ፥ ኔኒ ሀ ትምርትያ አማነይሳታ ታማርስኮ፥ ኑ አማኑዋንነ ሎኦ ትምርትያ ኪተታዳ ድጭዳ፥ ክርስቶስ የሱሳ ሎኦ አይለ ግዳና። <verse eid="1TI 4:6"/><verse number="7" style="v" sid="1TI 4:7"/>ሽን ጎእ ባይና ቱማ ግዶና ኦዳፐነ ጭማ ማጫሳ ሀይሰፐ ባቃታ። ቱማ አያና ደኦን ዳናዉ ነና ሎህሳ። <verse eid="1TI 4:7"/><verse number="8" style="v" sid="1TI 4:8"/>አስ ባ አሳተ ምንናዉ ኦያ ኦሶይ ጉስ ማዴስ። ሽን ቱማ አያና ደኦን ባና ሎህሶይ ሀእስካ መርናዉካ ደኦ እምያ ኡፋይስ ደእያ ግሾ፥ ኡባስ ማዴስ። <verse eid="1TI 4:8"/><verse number="9" style="v" sid="1TI 4:9"/>ሀ ቃላይ አሳ ኡባይ ኤካናዉ በሲያ ቱማ ኦዳ። <verse eid="1TI 4:9"/><verse number="10" style="v" sid="1TI 4:10"/>ኑኒ አሳ ኡባ፥ ኡባፈ አድ አማነይሳታ አሽያ ደኦ ፆሳፈ ኤካና ግድ ኡፋይሳን ናግያ ግሾ፥ ሄሳስ ኑኒ ኦሶን ዳቡሮስነ ባፀቶስ።<verse eid="1TI 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11"/>ሀይሳ ኪታነ ታማርሳ። <verse eid="1TI 4:11"/><verse number="12" style="v" sid="1TI 4:12"/>ኔኒ ያላጋ ግድያ ግሾ፥ ነና ኦንካ ካፖ። ሽን አማነይሳታስ ኔኒ ኦዳን፥ ኦሶን፥ ሲቆን፥ አማኖንነ ጌሻተን ሌምሶ ግዳ። <verse eid="1TI 4:12"/><verse number="13" style="v" sid="1TI 4:13"/>ታኒ ያና ጋካናዉ አሳስ ጌሻ ማፃፋ ናባቦን፥ ሳባኮንነ ታማርሶን ምና። <verse eid="1TI 4:13"/><verse number="14" style="v" sid="1TI 4:14"/>ትንብተይ ኦደትን፥ ጭማት ባንታ ኩሽያ ነ ቦላ ዎዳ ዎደ ኔኒ ኤክዳ፥ ነናን ደእያ ጌሻ አያና እሞታ ካፓ።<verse eid="1TI 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15"/>ነ ድቻይ አሳ ኡባስ ቆንጫና መላ ሄሳ ምን ቆፓ፤ ሀይሳ ኡባ ዎደ ኦ። <verse eid="1TI 4:15"/><verse number="16" style="v" sid="1TI 4:16"/>ነ ሁጵያስነ ነ ትምርትያስ ናገታ። ኔኒ ሄሳ ኡባ ዎደ ኦኮ ነናነ ነና ስኤይሳታ አሻሳ።<verse eid="1TI 4:16"/></para>
  <chapter eid="1TI 4"/>
  <chapter number="5" style="c" sid="1TI 5"/>
  <para style="s1">አምኤታባ እመትዳ ዞረ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1"/>ጭማ አደታ ነ አዋዳ ቦንቻፈ አትሽን፥ ሀንቀቶፋ። ያላጋ አደታ ነ እሻዳ ኦዳ ፄላ። <verse eid="1TI 5:1"/><verse number="2" style="v" sid="1TI 5:2"/>ጭማ ማጫሳታ ነ አይዳ፥ ያላጋ ማጫሳታ ነ ምችዳ፥ ፖሎ ጌሻተን ኦይካ።<verse eid="1TI 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3"/>አዝን ሀይቅዳ ቱማ አምኤታ ቦንቻ። <verse eid="1TI 5:3"/><verse number="4" style="v" sid="1TI 5:4"/>ሽን አምኤስ ናይት ዎይኮ ናይታ ናይት ደእኮ፥ ሄ ናይት ቱማ አያና ደኦን ደኤይሳ በሳናዉ ባንታና የልዳይሳታነ፥ ባንታ ዎጋ አይዉነ ዎጋ አዋ ማድድ ኩሸ ዛሮ ታማሮ። ሄስ ፆሳ ኡፋይስያባ።<verse eid="1TI 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1TI 5:5"/>ባርካ ደእያ ቱማ አምእያ ፆሳፈ ማደ ደማናዉ ኡፋይሳን ናጋሱ። ጋላስነ ቃማ ፆሳይ ባና ማዳና መላ ዎሳዉሱነ ኦይቻዉሱ። <verse eid="1TI 5:5"/><verse number="6" style="v" sid="1TI 5:6"/>ሽን ሀ አላምያን ሎኦ ዱሳ ፃላላ ኮይያ አምእያ ፓፃ ደአሸ ሀይቅዳሮ። <verse eid="1TI 5:6"/><verse number="7" style="v" sid="1TI 5:7"/>ኦንካ ኤንታ ቦሮና መላ ሀ ኪታ ኤንታዉ እማ። <verse eid="1TI 5:7"/><verse number="8" style="v" sid="1TI 5:8"/>ሽን ባ ዳቦታስ፥ ኡባፈ አድ ባ ሶ አሳስ ቆፖና ኦንካ ባ አማኑዋ ካድዳይሳ፤ አማኖና አሳፐካ አዳ ኢታ።<verse eid="1TI 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9"/>ላይ ኡሱፑን ታሙ ኩምቦና አምኤ ሱን ማዝጋበን ፃፎፓ። ቃስ ሄሳ ቦላ እያ ባ አዝናስ አማነትዳሮ ግዳናዉ ኮሼስ። <verse eid="1TI 5:9"/><verse number="10" style="v" sid="1TI 5:10"/>ናይታ ድሾን፥ እማ ሞኮን፥ ጌሻታ ቶሁዋ ሜቻን፥ መቶትያ አሳ ማደን፥ ሎኦ ኦሶ ኡባስ ባና አ እምዳሮነ ሎኦ ኦሶን ኤረትዳሮ ግዳናዉ በሴስ።<verse eid="1TI 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11"/>ሽን ያላጋ አምኤታ ሱን ማዝጋበን ፃፎፓ። ኤንታና አዝና ገሎ ገሎ ግያ አሾ አሞይ ኦይክያ ዎደ ክርስቶሳ አጋና። <verse eid="1TI 5:11"/><verse number="12" style="v" sid="1TI 5:12"/>ኤንቲ ኮይሮ ገልዳ ቃላ መንዳ ግሾ ፕርደታና። <verse eid="1TI 5:12"/><verse number="13" style="v" sid="1TI 5:13"/>ሄሳ ቦላ ኤንቲ ኦሶ ይድ ኬፈ ኬ ዩያና። ዩሻ ፃላላ ግዶናሽን፥ ዝግርሳንነ ባንታና ጋናባን ገልድ በሶናባ ኦደቶሶና። <verse eid="1TI 5:13"/><verse number="14" style="v" sid="1TI 5:14"/>ሄሳ ግሾ፥ ኑ ሞርከት ኑ ቦላ ኦደትያ ኢታባ ደሞና መላ ያላጋ አምኤት አዝና ገልድ፥ ናአ የልድ፥ ባንታ ኬ አይሳና መላ ዞራይስ። <verse eid="1TI 5:14"/><verse number="15" style="v" sid="1TI 5:15"/>ሀይሳፈ ካሰ ጉ አምኤት ፃላሄ ካላናዉ ጉየ ስምዶሶና።<verse eid="1TI 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16"/>እስ አማንያ ማጫሴስ ሶ አሳ ግዶን አምኤት ደእኮ፥ እያ ኤንታ ማዳናዉ በሴስ። ሄሳዳ ኦኮ፥ ዎሳ ኬስ ቶሆይ ካዉዬስ። ሄ ዎደ ዎሳ ኬይ ማደ በሲያ ቱማ አምኤታ ማዳናዉ ዳንዳኤስ።<verse eid="1TI 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17"/>ዎሳ ኬ ሎይ ሄምያ ጭማት፥ ኡባፈ አድ፥ ቃላ ሳባኮንነ ታማርሶን ዳቡረይሳት ዳኮ ቦንቾ ኤካናዉ በሴስ። <verse eid="1TI 5:17"/><verse number="18" style="v" sid="1TI 5:18"/>ጌሻ ማፃፋይ፥ “ዉዱማን ካ የያ ቦራ ዶና ቃቾፋ” ሄሳዳካ፥ “ኦሳንቾይ ባ ዳሞዝያ ኤካናዉ በሴስ”<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ዛረ 25:4</ref>፤ <ref loc="MAT 10:10">ማቶ 10:10</ref>፤ <ref loc="LUK 10:7">ሉቃ 10:7</ref>.</char></note> ያጌስ።<verse eid="1TI 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TI 5:19"/>ናምኡ ዎይኮ ሄ ማርክ ባይና፥ ዎሳ ኬ ጭማ ሞትያባ ስኦፓ።<note caller="-" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ዛረ 17:6</ref>፤ <ref loc="DEU 19:15">19:15</ref>.</char></note> <verse eid="1TI 5:19"/><verse number="20" style="v" sid="1TI 5:20"/>ሀራት ያያና መላ ናጋራ ኦያ ኦናካ አሳ ኡባ ስንን ሀንቀታ።<verse eid="1TI 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21"/>ኔኒ አሳ ሶምኦ በኦና፥ እሱዋ እሱዋፈ ዱማዮና ሀ ኪታ ናጋና መላ ፆሳ፥ ጎዳ የሱስ ክርስቶሳነ ዶረትዳ ኪታንቾታ ስንን ታ ነና ዞራይስ። <verse eid="1TI 5:21"/><verse number="22" style="v" sid="1TI 5:22"/>ኦደ ቦላካ ነ ኩሽያ ዎዳ ሹማናዉ ኤለሶፓ። ሀራታ ናጋራን ገሎፓ፤ ነና ጌሻተን ናጋ።<verse eid="1TI 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23"/>ኔኒ ኡባ ዎደ ሀርገትያ ግሾነ ነ ኡሎ ሀርግያ ግሾ ሃ ፃላላ ኡዮፓ፤ ጉ ዎይነ ኡያ።<verse eid="1TI 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24"/>እስ እስ አሳታ ናጋራይ ቆንጨ፤ ኤንታ ናጋራይ ኤንታ ፕርዳናዉ ኤንታፈ ስን አስ፥ ሽን ሀራታ ናጋራይ ጉየፐ ጋምእድ ቆንጬስ። <verse eid="1TI 5:24"/><verse number="25" style="v" sid="1TI 5:25"/>ሄሳዳ፥ ሎኦ ኦሶይካ ቆንጨ፤ ቆንጮና እፅኮካ ጌማናዉ ዳንዳኤና።<verse eid="1TI 5:25"/></para>
  <chapter eid="1TI 5"/>
  <chapter number="6" style="c" sid="1TI 6"/>
  <para style="s1">አይለታስ እመትዳ ዞረ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1"/>ፆሳ ሱንይነ ኑ ትምርተይ ጫየቶና መላ አይለተን ደኤይሳት ባንታና ሃርያ ጎዳታ ቦንቾ። <verse eid="1TI 6:1"/><verse number="2" style="v" sid="1TI 6:2"/>አማንያ ጎዳት ደእያ አይለት፥ ኤንታ ጎዳት ኤንታዉ እሻ ግድያ ግሾ ኤንታ ካፖ። ኤንታ ኦሱዋን ማደትያ ጎዳት፥ አማነይሳታነ ዶሰትዳይሳታ ግድያ ግሾ ኤንቲ ካሰፐ አድ ኦናዉ በሴስ። ኔኒ ሀይሳ ታማርሳናዉነ ኤንቲ ኦና መላ ዞራናዉ በሴስ።<verse eid="1TI 6:2"/></para>
  <para style="s1">ቱማ ዱረተ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3"/>ኦንካ ዱማ ትምርተ ታማርስያባ ግድኮ፥ ኑ ጎዳ የሱስ ክርስቶሳ ቱማ ቃላራነ ኑ አማኖ ትምርትያራ ጋሄተና። <verse eid="1TI 6:3"/><verse number="4" style="v" sid="1TI 6:4"/>ሄ ኡራይ ኦቶሮን ሱገቴስፐ አትሽን፥ አይኮካ ኤረና። ኤንታዉ እስ ቆፋ ቦላ ፓላማናዉነ ኦየታናዉ ኢታ አሞይ ደኤስ። ሄስ ቃናተ፥ ኦሽ፥ ጫሸ፥ ኢታ ስነ፥ <verse eid="1TI 6:4"/><verse number="5" style="v" sid="1TI 6:5"/>ጊጎና ፓላማ ካለስ። ቃስ ኤንታዉ ኢታ ዎዛን ደኤስ፤ ቱማ ባልዶሶና፤ ኤንቲ ፆሳ አማኖይ ዱረተስ ኦገ ግድ ቆፖሶና።<verse eid="1TI 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6"/>ሽን ታዉ ደእያባይ ግዳና ግያ አሳስ ቱማ አያና ደኦይ ግታ ዎ። <verse eid="1TI 6:6"/><verse number="7" style="v" sid="1TI 6:7"/>ኑኒ ሀ አላምያ አይኮካ ኤህቦኮ፤ ቃስ እያፐ አይኮካ ኤክድ ቦኮ። <verse eid="1TI 6:7"/><verse number="8" style="v" sid="1TI 6:8"/>ኑስ ካነ ማኦይ ደእኮ ሄስ ግዳና። <verse eid="1TI 6:8"/><verse number="9" style="v" sid="1TI 6:9"/>ሽን ዱረተ ኮየይሳት ፓጨንነ ፅሄን ገሎሶና። ቃስ ኤንታና ዱገ ዳፍያነ ይስያ ኤያተነ ቆህያ አሞን ኩንዶሶና። <verse eid="1TI 6:9"/><verse number="10" style="v" sid="1TI 6:10"/>ሚሸ ሲቆይ ኢታተ ኡባስ ፑልቶ። እሶት እሶት ሚሸ አሞትሸ አማኖፐ ባለትድ ዳሮ መቶን ባንታና የግዶሶና።<verse eid="1TI 6:10"/></para>
  <para style="s1">ዞረነ ኪታ</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11"/>ሽን ነኖ፥ ፆሳ አሶ፥ ሄሳፈ ባቃታ። ፅሎተ፥ ፆሳ ዳኖ፥ አማኖ፥ ሲቆ፥ ዳንዳአነ አሽከተ ካላ። <verse eid="1TI 6:11"/><verse number="12" style="v" sid="1TI 6:12"/>አማኖ ባፅያ ሎይ ባፀታ። ዳሮ አሳ ስንን ነ ማርካትዳ ነ አማኑዋባ፥ ፆሳይ ነና እያዉ ፄግዳ መርና ደኡዋ ኦይካ። <verse eid="1TI 6:12"/><verse number="13" style="v" sid="1TI 6:13"/>ኡባስ ደኦ እምያ ፆሳ ስንንነ፥ ጰንፀ ጵላፆሳ ስንን ሎኦ ማርካ ማርካትዳ ክርስቶስ የሱሳ ስንን ታ ነና ኪታይስ።<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JHN 18:37">ዮሀ 18:37</ref>.</char></note> <verse eid="1TI 6:13"/><verse number="14" style="v" sid="1TI 6:14"/>ኑ ጎዳ የሱስ ክርስቶሲ ቆንጫና ጋካናዉ ሀ ኪታ ባልነ ቦረይ ባይና ናጋ። <verse eid="1TI 6:14"/><verse number="15" style="v" sid="1TI 6:15"/>ባ ፃላላ ኡባ ሃርያ ቦንቾ ፆሳይ፥ ካዎታ ካዎይ፥ ጎዳታ ጎዳይ፥ ባ ቆፕዳ ቃማን የሱስ ክርስቶሳ ዛር ኪታና። <verse eid="1TI 6:15"/><verse number="16" style="v" sid="1TI 6:16"/>እስ እያ ፃላል ሀይቀና። ኦንካ ሺቃናዉ ዳንዳኦና ፖኦን ደኤስ። ኦንካ እያ በእቤና፤ ቃስ በአናዉካ ዳንዳኤና። ቦንቾይነ መርና ዎልቃይ እያዉ ግዶ። አምንእ።<verse eid="1TI 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17"/>ሀ አላምያ ዱረት ጮ ይያ ሻሎን ኦቶርቶና መላነ ጬቆና መላ ኦዳ። ኑስ ኮሽያባ ፓላህስድ እምያ ኑና አንጅያ፥ ዱረ ፆሳን አማነታና መላ ኤንታ ኪታ። <verse eid="1TI 6:17"/><verse number="18" style="v" sid="1TI 6:18"/>ኤንቲ ሎኦ ኦሶ ኦናዳ ሎኦ ኦሶን ዱረታናዳ፥ ኬሀታነ ሀራታስ ሻከይሳታ ግዳና መላ ኪታ። <verse eid="1TI 6:18"/><verse number="19" style="v" sid="1TI 6:19"/>ሄስ ኤንታዉ ስንስ ምኖ ባሶ ግድያ ግሾ፥ ሄ ዎደ ኤንቲ ቱማ ደኦይ አይ ዳንያኮ ኤራና።<verse eid="1TI 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20"/>ፅሞትዮሳ፥ እስ እስ አሳይ፥ “ኤራተ” ግያ ኤያ ፓላማፐነ ሀዳ ኦዳፐ ባቃታ፤ ነዉ እመትዳ ሀዳራ ናጋ። <verse eid="1TI 6:20"/><verse number="21" style="v" sid="1TI 6:21"/>እሶት እሶት ኑስ ኤራተ ደኤስ ያግሸ አማኑዋ አግዶሶና።</para>
  <para style="p" vid="1TI 6:21">ፆሳ አ ኬሀተይ ህንተ ኡባራ ግዶ።<verse eid="1TI 6:21"/></para>
  <chapter eid="1TI 6"/>
</usx>
