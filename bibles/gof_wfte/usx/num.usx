<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ታይቦ ማፃፋ</para>
  <para style="toc1">ታይቦ ማፃፋ</para>
  <para style="toc3">ታይቦ</para>
  <para style="toc2">ታይቦ</para>
  <para style="mt">ታይቦ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ታይቦ ማፃፋይ፥ እስራኤለ አሳይ ሲና ዙማፐ ደንድዳ ዎደፐ ዶምድ፥ ፆሳይ ኤንታዉ እማና ግድ ቃላ ገልዳ ቢታስ ዶሎሀ ባጋ ዛዋ ጋካናዉ ሄመትዳ ኦይታሙ ላይ ታርከ ኦዴስ። ማፃፋ ሱንይ፥ እስራኤለ አሳይ ሲና ዙማፐ ደንድድ ባናፐ ስን፥ እስ የለታፐ ጉየ ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋን፥ ሞአበ ቢታን፥ ሙሰይ አሳ ታይብዳ ታይቡዋ በሴስ። ናምኡ ታይቦታፐ ግዶን ደእያ ዎደን፥ እስራኤለ አሳይ ካናነፐ ዱገሀ ባጋ ዛዋን ደእያ ቃደስ-ባርነ ማትድ ደኤስ። ግዶሽን፥ ኤንቲ ፆሳይ እማና ግዳ ቢታ ያራ ገላናዉ ዳንዳእቦኮና። ሄሳ ግሾ፥ ኤንቲ ሄ ሄራን ዳሮ ላይ አዳፐ ጉየ፥ ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋራ ደእያ ቢታ ጋክዶሶና። ኤንታፈ ባጋይ ያን ዳናዉ ቆፋ ቃችን፥ አትዳ አሳይ ዮርዳኖሰ ፕንድ፥ ካናነ ባናዉ ባንታና ጊግስዶሶና።</para>
  <para style="ip">ታይቦ ማፃፋይ፥ ዳሮ መቶይ ጋክያ ዎደ ያይያነ ኡፋይስ ቃንፅያ አሳ ታርከ በሴስ። ፆሳ ቦላነ ኤንታ ካለና መላ ፆሳይ ዶርዳ ሙሰ ቦላ ጌላተን ደንድዳ አሳ ታርከ ቆንጭሴስ። አሳይ ዳቡራንቾነ ኪተቶና ደረ ግድኮካ፥ ፆሳይ አማንያ ፆሰ ግድድ፥ ኤንታ ናግድ ዎዳይሳ ታርከይ ኦዴስ። ሄሳዳካ፥ ሙሰይ እስ እስ ቶሆ ዳንዳአ ይኮካ፥ ምኖ አማኖይ እያዉ ደእያ ግሾ፥ ፆሳስነ አሳስ አማነትድ ኦያ አስ ግድድ በንትስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ኮይሮ ታይቡዋ (<char style="ior"><ref loc="NUM 1:1-4:49">1:1—4:49</ref></char>)</para>
  <para style="io1">ሌወታነ ዱማ ዱማ ህገ (<char style="ior"><ref loc="NUM 5:1-8:26">5:1—8:26</ref></char>)</para>
  <para style="io1">ፓስካ ባኣለ (<char style="ior"><ref loc="NUM 9:1-23">9:1-23</ref></char>)</para>
  <para style="io1">ሲና ዙማፐ ሞአበ ጋካናዉ ሄመትዳ ሄመ (<char style="ior"><ref loc="NUM 10:1-15:41">10:1—15:41</ref></char>)</para>
  <para style="io1">አሳ ጌላተ (<char style="ior"><ref loc="NUM 16:1-17:13">16:1—17:13</ref></char>)</para>
  <para style="io1">ካህነታነ ሌወታ (<char style="ior"><ref loc="NUM 18:1-19:22">18:1—19:22</ref></char>)</para>
  <para style="io1">ሞአበ ጋካናዉ ሄመትዳ ሄመ (<char style="ior"><ref loc="NUM 20:1-21:35">20:1—21:35</ref></char>)</para>
  <para style="io1">ባላማነ ባላቃ (<char style="ior"><ref loc="NUM 22:1-24:25">22:1—24:25</ref></char>)</para>
  <para style="io1">አሳ አማነቶና እፁዋነ ናምአን ታይቡዋ (<char style="ior"><ref loc="NUM 25:1-26:65">25:1—26:65</ref></char>)</para>
  <para style="io1">ሰሎጳዳ ማጫ ናይታነ እያሱ ዶረተ (<char style="ior"><ref loc="NUM 27:1-23">27:1-23</ref></char>)</para>
  <para style="io1">ዱማ ዱማ ህገታነ ባኣለ ዎደ ያርሾታ (<char style="ior"><ref loc="NUM 28:1-30:16">28:1—30:16</ref></char>)</para>
  <para style="io1">ምድያመታ ፆነተነ ዮርዳኖሰ ፕነ (<char style="ior"><ref loc="NUM 31:1-36:13">31:1—36:13</ref></char>)</para>
  <chapter number="1" style="c" sid="NUM 1"/>
  <para style="s1">ኮይሮ እስራኤለ አሳ ታይበተ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1"/>እስራኤለ አሳይ ግብፀ ቢታፈ ከይዳ ናምአን ላይን፥ ናምአን አጌናን፥ ሄ አጌና ኮይሮ ጋላሳን፥ ጎዳይ ሲና መላ ቢታን ጌሻ ዱንካንያን ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="NUM 1:1"/><verse number="2" style="v" sid="NUM 1:2"/>“ኔራነ አሮናራ እስራኤለ አሳ ኡባ ኤንታ ኮቻን ኮቻን፥ ቃስ ኤንታ ሶ አሳን አሳን ታይባድ፥ አደ አሳ ሱን ፃፍተ። <verse eid="NUM 1:2"/><verse number="3" style="v" sid="NUM 1:3"/>ላይ ላታማነ እያፐ ቦላ ግድዳ፥ ኦለታናዉ ዳንዳእያ እስራኤለ አሳ ኡባ ታይብተ። <verse eid="NUM 1:3"/><verse number="4" style="v" sid="NUM 1:4"/>ኮቻፐ ኮቻፐ እስ እስ አስ ባ ሶ አሳስ ሀላቃ ግድድ ህንተና ማዶ። <verse eid="NUM 1:4"/><verse number="5" style="v" sid="NUM 1:5"/>ህንተና ማዳና አሳ ሱንይ ሀይሳፈ ካልድ ፃፈትዳይሳ።</para>
  <para style="li1" vid="NUM 1:5">ሮቤላፐ፥ ሻደኡራ ናኣ ኤልፁራ፤ <verse eid="NUM 1:5"/><verse number="6" style="v" sid="NUM 1:6"/>ስሞናፐ ሱርሳዳያ ናአ ሳሉምኤላ፤<verse eid="NUM 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 1:7"/>ይሁዳፐ አምናዳበ ናኣ ናአሶና፤<verse eid="NUM 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 1:8"/>ይሳኮራፐ ዙአራ ናኣ ናትናኤላ፤<verse eid="NUM 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 1:9"/>ዛብሎናፐ ሄሎና ናኣ ኤልኣባ፤<verse eid="NUM 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 1:10"/>ዮሰፋ ናይታፐ፥</para>
  <para style="li1" vid="NUM 1:10">ኤፍሬማፐ አምሁዳ ናኣ ኤልሻማአ፤</para>
  <para style="li1" vid="NUM 1:10">ምናሰፐ ፓዳዙራ ናኣ ጋማልኤላ፤<verse eid="NUM 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 1:11"/>ብንያመፐ ጋድዮና ናኣ አብዳና፤<verse eid="NUM 1:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 1:12"/>ዳናፐ አምሳዳያ ናኣ አክኤዘራ፤<verse eid="NUM 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 1:13"/>አሴራፐ ኦክራና ናኣ ፓግኤላ፤<verse eid="NUM 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 1:14"/>ጋዳፐ ራጉኤላ ናኣ ኤልያሳፋ፤<verse eid="NUM 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 1:15"/>ንፍታለመፐ ኤናና ናአ አክራ፤<verse eid="NUM 1:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="NUM 1:16"/>ሀ አሳይ ባንታ አዋታ ኬ አሳፐ ካለናዉ ዶረትዳ እስራኤለ ያራታ ሀላቃታ” ያግስ።<verse eid="NUM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17"/>ያትን ሙሰይነ አሮን ሄ ዶረትዳ አሳታ ኤክድ፥ <verse eid="NUM 1:17"/><verse number="18" style="v" sid="NUM 1:18"/>ናምአን አጌናን ኮይሮ ጋላሳን ኩመ ማባራ ፄግድ ሺሽዶሶና። አሳይ ባንታ ኮቻን ኮቻን፥ ቃስ ባንታ ሶ አሳን አሳን ላታሙ ላይነ እያፐ ቦላ ግድዳ አደ ኡባይ ፃፈትስ። <verse eid="NUM 1:18"/><verse number="19" style="v" sid="NUM 1:19"/>ጎዳይ እያ ኪትዳይሳዳ ሙሰይ ኤንታ ሲና መላ ቢታን ታይብስ።<verse eid="NUM 1:19"/></para>
  <para style="p">
    <verse number="20-21" style="v" sid="NUM 1:20-21"/>ኦለታናዉ ዳንዳእያ አደ ኡባይ፥ ላታሙ ላይነ እያፐ ቦላ ግድዳ አደ ኡባይ ታይበትድ ሁጰን ሁጰን ፃፈትዶሶና። ኤንቲ ባንታ ኮቻን ኮቻንነ ባንታ ሶ አሳን ሻከትድ ሀይሳፈ ካልድ ደእያ ታይቦ ማራን ማዝጋበትዶሶና።</para>
  <para style="li1" vid="NUM 1:20-21">ባይራ ናኣ ሮቤላፐ 46,500 <verse eid="NUM 1:20-21"/><verse number="22-23" style="v" sid="NUM 1:22-23"/>ስሞናፐ 59,300<verse eid="NUM 1:22-23"/></para>
  <para style="li1">
    <verse number="24-25" style="v" sid="NUM 1:24-25"/>ጋዳፐ 45,650<verse eid="NUM 1:24-25"/></para>
  <para style="li1">
    <verse number="26-27" style="v" sid="NUM 1:26-27"/>ይሁዳፐ 74,600<verse eid="NUM 1:26-27"/></para>
  <para style="li1">
    <verse number="28-29" style="v" sid="NUM 1:28-29"/>ይሳኮራፐ 54,400<verse eid="NUM 1:28-29"/></para>
  <para style="li1">
    <verse number="30-31" style="v" sid="NUM 1:30-31"/>ዛብሎናፐ 57,400<verse eid="NUM 1:30-31"/></para>
  <para style="li1">
    <verse number="32-33" style="v" sid="NUM 1:32-33"/>ዮሰፋ ናኣ ኤፍሬማፐ 40,500<verse eid="NUM 1:32-33"/></para>
  <para style="li1">
    <verse number="34-35" style="v" sid="NUM 1:34-35"/>ዮሰፋ ናኣ ምናሰፐ 32,200<verse eid="NUM 1:34-35"/></para>
  <para style="li1">
    <verse number="36-37" style="v" sid="NUM 1:36-37"/>ብንያመፐ 35,400<verse eid="NUM 1:36-37"/></para>
  <para style="li1">
    <verse number="38-39" style="v" sid="NUM 1:38-39"/>ዳነፐ 62,700<verse eid="NUM 1:38-39"/></para>
  <para style="li1">
    <verse number="40-41" style="v" sid="NUM 1:40-41"/>አሴራፐ 41,500<verse eid="NUM 1:40-41"/></para>
  <para style="li1">
    <verse number="42-43" style="v" sid="NUM 1:42-43"/>ንፍታለመፐ 53,400<verse eid="NUM 1:42-43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44"/>ሙሰይ፥ አሮንነ ባንታ ሶ አሳፐ አሳፐ ዶረትዳ ታማነ ናምኡ እስራኤለ ኮቻ ሀላቃት ታይብዳ አሳይ ሀይሳታ። <verse eid="NUM 1:44"/><verse number="45" style="v" sid="NUM 1:45"/>ኦለታናዉ ዳንዳእያ አደ ኡባይ፥ ላታሙ ላይነ እያፐ ቦላ ግድዳ አሳይ ባንታ ሶ አሳን አሳን ታይበትዶሶና። <verse eid="NUM 1:45"/><verse number="46" style="v" sid="NUM 1:46"/>ኩመ አሳ ታይቦይ 603,550.<verse eid="NUM 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47"/>ሽን ሌወ ኮቻት ታይበትቦኮና። <verse eid="NUM 1:47"/><verse number="48" style="v" sid="NUM 1:48"/>ጋሶይካ ካሰ ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="NUM 1:48"/><verse number="49" style="v" sid="NUM 1:49"/>“ሌወ ኮቻታ ታይቦፓ፤ ኤንታ አትዳ እስራኤለ አሳ ታይቦን ገልሶፋ። <verse eid="NUM 1:49"/><verse number="50" style="v" sid="NUM 1:50"/>ሌወታ፥ ጌሻ ዱንካንያንነ እያን ደእያ ሚሸታ ኡባ ቦላ ሀላቃ ኦዳ ሹማ። ኤንቲ ዱንካንያነ እያን ደእያ ሚሸታ ቶካና፤ እያ ግዶን ኦናነ እያ ዩሾን ዱንካናና። <verse eid="NUM 1:50"/><verse number="51" style="v" sid="NUM 1:51"/>ጌሻ ዱንካነይ ሾደትያ ዎደ ሌወት ሾዶ፤ ጌሻ ዱንካነይ ኤቅያ ዎደ ሌወት ኤሶ፤ ኤንታፈ ሀር ኦንካ እያኮ ሺቅኮ ሀይቆ። <verse eid="NUM 1:51"/><verse number="52" style="v" sid="NUM 1:52"/>ሀንኮ እስራኤለ አሳይ ባንታ ሄራንነ ባንታ ጩጋን ጩጋን ሻከትድ፥ ባንታ ዱንካንያ ዱንካኖና። <verse eid="NUM 1:52"/><verse number="53" style="v" sid="NUM 1:53"/>ሽን ጎዳ ሀንቆይ እስራኤለ ማባራ ቦላ ዎና መላ ሌወት ዱንካንያ ዩሹዋን ባንታ ዱንካንያ ዱንካንድ ናጎ” ያግስ። <verse eid="NUM 1:53"/><verse number="54" style="v" sid="NUM 1:54"/>እስራኤለ አሳይ ጎዳይ ሙሰ ኪትዳ ኡባ ኦዶሶና።<verse eid="NUM 1:54"/></para>
  <chapter eid="NUM 1"/>
  <chapter number="2" style="c" sid="NUM 2"/>
  <para style="s1">እስራኤለ ኮቻታ ማራ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1"/>ጎዳይ ሙሰነ አሮና ሀይሳዳ ያግስ፤ <verse eid="NUM 2:1"/><verse number="2" style="v" sid="NUM 2:2"/>እስራኤለ አሳይ ባንታ ኮቻን ኮቻን ማላነ ባንታ ኮቻ ኮቻ ኤርስያ ባንድራ ካልድ፥ ጌሻ ዱንካንያፐ ጉ ሃክድ እያ ዩሹዋን ዱንካኖና።<verse eid="NUM 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 2:3"/>ዶሎሀ ባጋራ ይሁዳ ኮቻይ ባንታ ማላ ካልድ ዱንካኖና። ይሁዳ ኮቻ ካለይ አምናዳበ ናኣ ናአሶና። <verse eid="NUM 2:3"/><verse number="4" style="v" sid="NUM 2:4"/>እያ ጩጋ ታይቦይ 74,600.<verse eid="NUM 2:4"/></para>
  <para style="m">
    <verse number="5" style="v" sid="NUM 2:5"/>ይሁዳ ጋክድ ዱንካናናይ ይሳኮረ ኮቻ። ይሳኮራ ኮቻ ካለይ ዙአራ ናኣ ናትናኤላ። <verse eid="NUM 2:5"/><verse number="6" style="v" sid="NUM 2:6"/>እያ ጩጋ ታይቦይ 54,400.<verse eid="NUM 2:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="NUM 2:7"/>እያፐ ካልድ ዛብሎና ኮቻይ ዱንካኔስ። ዛብሎና ኮቻ ካለይ ሄሎና ናኣ ኤልኣባ። <verse eid="NUM 2:7"/><verse number="8" style="v" sid="NUM 2:8"/>እያ ጩጋ ታይቦይ 57,400<verse eid="NUM 2:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="NUM 2:9"/>ይሁዳ ባጋን ዱንካንዳ ኦላንቾታ ታይቦይ 186,400. እስራኤለ አሳይ ጉታ የድድ ብያ ዎደ ኮይሮት ከየይ ኤንታ።<verse eid="NUM 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 2:10"/>ዱገሀ ባጋራ ሮቤላ ኮቻይ ባንታ ማላ ካልድ ዱንካኖና። ኤንታ ካለይ ሳድዮራ ናኣ ኤልሱራ። <verse eid="NUM 2:10"/><verse number="11" style="v" sid="NUM 2:11"/>እያ ጩጋ ታይቦይ 46,500. <verse eid="NUM 2:11"/><verse number="12" style="v" sid="NUM 2:12"/>ሮቤላ ጋክድ ዱንካነይ ስሞና ኮቻ። ስሞና ኮቻ ካለይ ዙርሻዳያ ናአ ሳሉምኤላ። <verse eid="NUM 2:12"/><verse number="13" style="v" sid="NUM 2:13"/>እያ ጩጋ ታይቦይ 59,300.<verse eid="NUM 2:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="NUM 2:14"/>እያፐ ካልድ ጋደ ኮቻይ ዱንካኔስ። ኤንታ ካለይ ደኡኤላ ናኣ ኤልያሳፋ። <verse eid="NUM 2:14"/><verse number="15" style="v" sid="NUM 2:15"/>ኤንታ ጩጋ ታይቦይ 45,650.<verse eid="NUM 2:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 2:16"/>ሮቤላ፥ ባጋን ዱንካንዳ ኦላንቾታ ታይቦይ 151,450. እስራኤለ አሳይ ጉታ የድድ ብያ ዎደ ናምአን ከየይ ኤንታ።<verse eid="NUM 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 2:17"/>ሄሳፈ ጉየ ኮይሮ ከይያ ይሁዳ ጩጋፐነ ናምአን ከይያ ሮቤላ ጩጋፐ ግዶን ጌሻ ዱንካንያ ቶክድ ሌወት ገሎሶና። እስ እስ ኮቻይ ባንታ ዱንካንዳ ማራን ባንታ ማላ ኦይክድ ከዮ።<verse eid="NUM 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 2:18"/>ዉሎሀ ባጋራ ኤፍሬማ ባጋይ ባንታ ማላ ካልድ ዱንካኖና። ኤንታና ካለይ አምሁዳ ናኣ ኤልሻማአ። <verse eid="NUM 2:18"/><verse number="19" style="v" sid="NUM 2:19"/>ኤንታ ጩጋ ታይቦይ 40,500. <verse eid="NUM 2:19"/><verse number="20" style="v" sid="NUM 2:20"/>ኤንታ ጋክድ ምናሰ ኮቻይ ዱንካኔስ። ኤንታና ካለይ ፓዳዙራ ናኣ ጋማልኤላ። <verse eid="NUM 2:20"/><verse number="21" style="v" sid="NUM 2:21"/>ኤንታ ኦላንቾታ ታይቦይ 32,200. <verse eid="NUM 2:21"/><verse number="22" style="v" sid="NUM 2:22"/>እያፐ ካልድ ዱንካነይ ብንያመ ኮቻ። ብንያመ ኮቻ ካለይ ግድኦና ናኣ አብዳና። <verse eid="NUM 2:22"/><verse number="23" style="v" sid="NUM 2:23"/>ኤንታ ጩጋ ታይቦይ 35,400. <verse eid="NUM 2:23"/><verse number="24" style="v" sid="NUM 2:24"/>ኤፍሬማ ባጋን ዱንካንዳ ኦላንቾታ ታይቦይ 108,100. እስራኤለ አሳይ ጉታ የድድ ብያ ዎደ ሄን ከየይ ኤንታ።<verse eid="NUM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 2:25"/>ፑደሀ ባጋራ ዳነ ኮቻይ ባንታ ማላ ካልድ ዱንካኖና። ኤንታና ካለይ አምሳዳያ ናኣ አክኤዘራ። <verse eid="NUM 2:25"/><verse number="26" style="v" sid="NUM 2:26"/>ኤንታ ጩጋ ታይቦይ 62,700. <verse eid="NUM 2:26"/><verse number="27" style="v" sid="NUM 2:27"/>ኤንታና ጋክድ አሴራ ኮቻይ ዱንካኔስ። አሴራ ኮቻ ካለይ ኦክራና ናኣ ፓግኤላ። <verse eid="NUM 2:27"/><verse number="28" style="v" sid="NUM 2:28"/>ኤንታ ጩጋ ታይቦይ 41,500. <verse eid="NUM 2:28"/><verse number="29" style="v" sid="NUM 2:29"/>እያፐ ካልድ ንፍታለመ ኮቻይ ዱንካኔስ። ንፍታለመ ኮቻ ካለይ ኤናና ናኣ አክራ። <verse eid="NUM 2:29"/><verse number="30" style="v" sid="NUM 2:30"/>ኤንታ ጩጋ ታይቦይ 53,400<verse eid="NUM 2:30"/></para>
  <para style="m">
    <verse number="31" style="v" sid="NUM 2:31"/>ዳነ ባጋን ዱንካንዳ ኦላንቾታ ታይቦይ 157,600. እስራኤለ አሳይ ጉታ የድድ ብያ ዎደ ዉርሰን ከየይ ኤንታ።<verse eid="NUM 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32"/>ባንታ ኮቻን ኮቻን ሻከትድ ታይበትዳ እስራኤለ ኦላንቾታ ታይቦይ 603,550. <verse eid="NUM 2:32"/><verse number="33" style="v" sid="NUM 2:33"/>ሽን ጎዳይ ሙሰ ኪትዳይሳዳ፥ ሌወት ሀራ እስራኤለ አሳራ ታይበትቦኮና። <verse eid="NUM 2:33"/><verse number="34" style="v" sid="NUM 2:34"/>እስራኤለ አሳይ፥ ጎዳይ ሙሰ ኪትዳባ ኡባ ኦዶሶና። ኤንቲ ባንታ ማላ ካልድ ዱንካንዶሶና፤ ቃስ ባንታ ኮቻነ ባንታ ሶ አሳ አሳ ካልድ ከዮሶና።<verse eid="NUM 2:34"/></para>
  <chapter eid="NUM 2"/>
  <chapter number="3" style="c" sid="NUM 3"/>
  <para style="s1">አሮና አደ ናይታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1"/>ጎዳይ ሲና ዙማ ቦላ ሙሰራ ኦደትያ ዎደ ደእያ አሮናነ ሙሰ ሶ አሳይ ሀይሳፈ ካልድ ፃፈትዳይሳ። <verse eid="NUM 3:1"/><verse number="2" style="v" sid="NUM 3:2"/>አሮና አደ ናይታ ሱንይ፥ ባይራይ ናዳባ፥ ካለይ አብዮዳ፥ አላዛራነ እታማራ። <verse eid="NUM 3:2"/><verse number="3" style="v" sid="NUM 3:3"/>ሄ አሮና አደ ናይት ኡባይ፥ ካህነ ግድድ ኦናዉ ትየትድ ሹመትዶሶና። <verse eid="NUM 3:3"/><verse number="4" style="v" sid="NUM 3:4"/>ሽን ኤንታ ግዶፈ ናዳበይነ አብዮድ ሲና መላ ቢታን ጎዳ ስንን ጌሽ ግዶና ታማን ያርሾ ያርሽድ ሀይቅዶሶና። ኤንታዉ ናእ ባዋ። ሄሳ ግሾ፥ ኤንታ አዋይ አሮን ፓፃ ደእዳ ላይ ኡባን አላዛርነ እታማራ ፃላል ካህነ ግድድ ኦዶሶና።<verse eid="NUM 3:4"/></para>
  <para style="s1">ሌወታ ኦሶ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 3:5"/><verse number="6" style="v" sid="NUM 3:6"/>“ሌወ ኮቻታ ኤሀዳ ካህንያ አሮና ማዳና መላ ኤንታ እያ ስን ሺሻ። <verse eid="NUM 3:6"/><verse number="7" style="v" sid="NUM 3:7"/>ኤንቲ አሮናነ እስራኤለ ማባራ ኡባ ጌሻ ዱንካንያ ስንን ዱማ ዱማ ኦሶ ኦድ ማዶ። <verse eid="NUM 3:7"/><verse number="8" style="v" sid="NUM 3:8"/>ኤንቲ ጌሻ ዱንካንያ ግዶን ደእያ ሚሸ ኡባ አዋተን አይሶ። እስራኤለ አሳ ግሾ ጌሻ ዱንካንያ ግዶን ኦሶ ኡባ ኤንቲ ኦና። <verse eid="NUM 3:8"/><verse number="9" style="v" sid="NUM 3:9"/>አሮናነ እያ አደ ናይታ ማዳና መላ ሌወታ ሹማ። ኤንቲ እስራኤለ አሳ ግዶፈ ሻከትድ አሮና ማዳና መላ እመትዶሶና። <verse eid="NUM 3:9"/><verse number="10" style="v" sid="NUM 3:10"/>አሮናነ እያ አደ ናይታ ካህነ ኦዳ ሹማ። ኤንታፈ ሀራ አስ ኦንካ ጌሻ ዱንካንያኮ ሺቅኮ ሀይቆ” ያግስ።<verse eid="NUM 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11"/>ቃስ ጎዳይ ሙሰኮ፥ <verse eid="NUM 3:11"/><verse number="12" style="v" sid="NUM 3:12"/>“ታኒ እስራኤለን የለትያ ባይራ አደ ናይታ ግሾ ሌወታ ኤካስ። ሌወት ታባ። <verse eid="NUM 3:12"/><verse number="13" style="v" sid="NUM 3:13"/>አይስ ጊኮ፥ ባይራ የለትዳ ኡባይ ታባ። ታ ግብፀ ቢታን ባይራ የለትዳ ኡባ ዎዳ ጋላሳን፥ እስራኤለን ባይራ የለትዳባ ኡባ አሰ ግድን፥ መሄ ግድን፥ ታዉ ዱማያስ። ኤንቲ ታባ ግዳና። ታኒ ጎዳ” ያግስ።<verse eid="NUM 3:13"/></para>
  <para style="s1">ሌወታ ታይቡዋ</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14"/>ቃስካ ጎዳይ ሙሰኮ ሲና መላ ቢታን፥ <verse eid="NUM 3:14"/><verse number="15" style="v" sid="NUM 3:15"/>“ሌወታ ኤንታ ኮቻን፥ ቃስ ኤንታ ሶ አሳን አሳን ታይባ። የለትን እስ አጌናነ እያፐ ቦላ ግድዳ አደ ናይታ ኡባ ታይባ” ያግስ። <verse eid="NUM 3:15"/><verse number="16" style="v" sid="NUM 3:16"/>ያትን ጎዳይ ኪትዳይሳዳ ሙሰይ ኤንታ ታይብስ።<verse eid="NUM 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 3:17"/>ሌወ አደ ናይት ገድሶና፥ ቃሀታ ማራራ። <verse eid="NUM 3:17"/><verse number="18" style="v" sid="NUM 3:18"/>ገድሶና አደ ናይት ልብናነ ሳመአ ጌተቶሶና። <verse eid="NUM 3:18"/><verse number="19" style="v" sid="NUM 3:19"/>ቃሃታ አደ ናይት አምራማ፥ ይዝሃራ፥ ከብሮናነ ኡዝኤላ። <verse eid="NUM 3:19"/><verse number="20" style="v" sid="NUM 3:20"/>መራራ አደ ናይት ማህላነ ሙሳ ጌተቶሶና። ሌወታ ማይዛት ሀይሳታ።<verse eid="NUM 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21"/>ናምኡ ገድሶና ኮቻት ልብናነ ስምአ። <verse eid="NUM 3:21"/><verse number="22" style="v" sid="NUM 3:22"/>የለትን እስ አጌናነ እያፐ ቦላ ግድዳ አደ ናይታ ታይቦይ 7,500. <verse eid="NUM 3:22"/><verse number="23" style="v" sid="NUM 3:23"/>ገድሶና ኮቻት ጌሻ ዱንካንያፐ ጉየን ዉሎሀ ባጋን ዱንካንዶሶና። <verse eid="NUM 3:23"/><verse number="24" style="v" sid="NUM 3:24"/>ገድሶና ኮቻ ሶ አሳ ሀላቃይ ላኤላ ናኣ ኤልያሳፋ። <verse eid="NUM 3:24"/><verse number="25" style="v" sid="NUM 3:25"/>ገድሶና ኮቻስ ጌሻ ዱንካንያ ቦላ ደእያ አዋተይ፥ ዱንካንያ፥ ጋ ካማ፥ ካረ ካማ፥ ዉላ ማጋራጁዋ፥ <verse eid="NUM 3:25"/><verse number="26" style="v" sid="NUM 3:26"/>ዱንካንያ ዩሾን ደእያ ዳባባ ማጋራጁዋ፥ ያርሾ በሳ ማጋራጁዋ፥ ዳባባ ዉላ ማጋራጁዋ፥ ዎዶሮታነ እያን ጎኤትያ ሚሸታ ኡባ አዋተን አይሶሶና።<verse eid="NUM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27"/>ቃሃታ ኮቻት አምራማ፥ ይዝሃራ፥ ከብሮናነ ኡዝኤላ። <verse eid="NUM 3:27"/><verse number="28" style="v" sid="NUM 3:28"/>የለትን እስ አጌናነ እያፐ ቦላ ግድዳ አደ ናይታ ታይቦይ 8,600. ቃሃታ ኮቻት ጌሻ ዱንካንያ አዋተን ናጎሶና። <verse eid="NUM 3:28"/><verse number="29" style="v" sid="NUM 3:29"/>ቃሃታ ኮቻት ጌሻ ዱንካንያፐ ዱገሀ ባጋራ ዱንካንዶሶና። <verse eid="NUM 3:29"/><verse number="30" style="v" sid="NUM 3:30"/>ቃሃታ ኮቻ ካለይ ኡዝኤላ ናኣ ኤልዛፋና። <verse eid="NUM 3:30"/><verse number="31" style="v" sid="NUM 3:31"/>ኤንቲ ታቦትያ፥ ፃርጴዛ፥ ፆምፐ ዎያ ኮጫ፥ ያርሽሶ በሳ፥ ካህነት ጎኤትያ ጌሻ ዱንካንያ ሚሸታ፥ ኡባፈ ጌሻ በሳ ገልያ ዉላ ቦላ ደእያ ማጋራጁዋ አዋተን አይሶ። <verse eid="NUM 3:31"/><verse number="32" style="v" sid="NUM 3:32"/>ሌወታ ሀላቃይ ካህንያ አሮና ናኣ አላዛራ። እ ጌሻ በሳን ኦይሳታስ ሹማ።<verse eid="NUM 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 3:33"/>መራራ ኮቻት ማህላነ ሙሳ። <verse eid="NUM 3:33"/><verse number="34" style="v" sid="NUM 3:34"/>የለትን እስ አጌናነ እያፐ ቦላ ግድዳ አደ ናይታ ታይቦይ 6,200. <verse eid="NUM 3:34"/><verse number="35" style="v" sid="NUM 3:35"/>መራራ ኮቻ ካለይ አብካላ ናኣ ዙርኤላ። መራራ ኮቻይ ጌሻ ዱንካንያፐ ፑደሀ ባጋራ ዱንካንዶሶና። <verse eid="NUM 3:35"/><verse number="36" style="v" sid="NUM 3:36"/>መራራ ኮቻይ ዱንካንያ ቱቀታ፥ ልዮታ፥ ቱሳታነ ቱሳት ኤቅያ ገዳታ፥ ሄሳዳካ ግዶን ኮሽያ ሚሸታ ኡባ ኤንቲ አዋተን አይሶሶና። <verse eid="NUM 3:36"/><verse number="37" style="v" sid="NUM 3:37"/>ጉጅድካ፥ ዱንካንያ ዩሾን ደእያ ዳባባ ቱሳታነ ኤንታ ገዳታ፥ ሸታነ ዎዶሮታ አዋተን አይሶሶና።<verse eid="NUM 3:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 3:38"/>ጌሻ ዱንካንያ ስንን ዶሎሀ ባጋራ ሙሰይ፥ አሮንነ እያ አደ ናይት ዱንካንዶሶና። ጌሻ ዱንካንያ ግዶን እስራኤላ አሳ ግሾ ኦሰትያ ኦሶ ኡባ ኤንቲ አዋተን አይሶሶና። ሀራ አስ ጌሻ ዱንካንያኮ ሺቅኮ ሀይቆ።<verse eid="NUM 3:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 3:39"/>ጎዳይ፥ ሙሰነ አሮና ኪትዳይሳ መላ እስ አጌናነ እያፐ ቦላ ግድዳ ሌወታ አደ ናይታ ታይቦይ 22,000.<verse eid="NUM 3:39"/></para>
  <para style="s1">ባይራ አደ ናይታ ዎዞ</para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40"/>ጎዳይ ሙሰኮ፥ “የለትን እስ አጌናነ እያፐ ቦላ ግድዳ እስራኤለ ባይራ አደ ናይታ ታይባዳ ኤንታ ሱን ፃፋ። <verse eid="NUM 3:40"/><verse number="41" style="v" sid="NUM 3:41"/>እስራኤለ ባይራ አደ ናይታ በሳን ሌወታ፥ ቃስ እስራኤለ ባይራ መህያ በሳን ሌወታ ባይራ መህያ ታዉ ኤካ። ታኒ ጎዳ” ያግስ። <verse eid="NUM 3:41"/><verse number="42" style="v" sid="NUM 3:42"/>ጎዳይ ሙሰ ኪትዳይሳዳ እስራኤለን ባይራ የለትዳ ኡባ ታይብስ። <verse eid="NUM 3:42"/><verse number="43" style="v" sid="NUM 3:43"/>የለትን እስ አጌናነ እያፐ ቦላ ግድዳ ባይራ አደ ናይታ ታይቦይ 22,273.<verse eid="NUM 3:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 3:44"/><verse number="45" style="v" sid="NUM 3:45"/>“እስራኤለ ባይራ አደ ናይታ በሳን ሌወታ ታዉ ዱማያ። ቃስ እስራኤለ ባይራ መሄታ በሳን ሌወታ ባይራ መህያ ታዉ ዱማያ፤ ታኒ ጎዳ። <verse eid="NUM 3:45"/><verse number="46" style="v" sid="NUM 3:46"/>እስራኤለ ባይራ አደ ናይታ ታይቦይ ሌወታ ባይራ አደ ናይታ ታይቡዋፐ 273 አያ ግሾ ሄ አትዳይሳታ ታዉ ዎዛ። <verse eid="NUM 3:46"/><verse number="47" style="v" sid="NUM 3:47"/>እሱዋስ እሱዋስ ጌሻ ዱንካነን ኤረትዳ ምዛነን እቻሹ ብራ ሳንትመን ዎዛ። <verse eid="NUM 3:47"/><verse number="48" style="v" sid="NUM 3:48"/>ሄ ዎዞ ሚሽያ አሮናስነ እያ አደ ናይታስ እማ” ያግስ። <verse eid="NUM 3:48"/><verse number="49" style="v" sid="NUM 3:49"/>ፓላህዳይሳታ ዎዞ ሚሽያ ሙሰይ ሺሽስ። <verse eid="NUM 3:49"/><verse number="50" style="v" sid="NUM 3:50"/>ጌሻ ዱንካንያ ምዛንያ ልከን እስራኤለ ባይራ አደ ናይታ ዎዞ ሚሽያ 1,365 ብራ ሳንትመ ኤክስ። <verse eid="NUM 3:50"/><verse number="51" style="v" sid="NUM 3:51"/>ጎዳይ ኪትዳይሳዳ ሙሰይ ዎዞ ሚሽያ አሮናስነ እያ አደ ናይታስ እሚስ።<verse eid="NUM 3:51"/></para>
  <chapter eid="NUM 3"/>
  <chapter number="4" style="c" sid="NUM 4"/>
  <para style="s1">ቃኣታ ኮቻስ እመትዳ ኦሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1"/>ጎዳይ ሙሰነ አሮና ሀይሳዳ ያግስ፤ <verse eid="NUM 4:1"/><verse number="2" style="v" sid="NUM 4:2"/>“ሌወ ኮቻታፐ ቃሃታ ኮቻታነ ኤንታ ሶ አሳ አሳ ሻካዳ ታይባ። <verse eid="NUM 4:2"/><verse number="3" style="v" sid="NUM 4:3"/>ላይ 30-50 ጋክዳ አደ ኡባ ጌሻ ዱንካንያን ኦናዉ ዳንዳኤይሳታ ታይባ። <verse eid="NUM 4:3"/><verse number="4" style="v" sid="NUM 4:4"/>ቃሃታ ኮቻት ጌሻ ዱንካንያን ኦና ኦሶይ ዱንካንያን ጎኤትያ ጌሻ ሚሸታ አዋተን ናጎ።<verse eid="NUM 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 4:5"/>“አሳይ ጉታፐ ባናዉ ደንድያ ዎደ አሮንነ እያ አደ ናይት ጌሻ ዱንካንያ ግዶ ገልድ፥ ጫቆ ታቦትያ ስንን ደእያ ማጋራጁዋ ዎስድ ሄ ጫቆ ታቦትያ እያራ ፃፆ። <verse eid="NUM 4:5"/><verse number="6" style="v" sid="NUM 4:6"/>ሄ ካማ ቦላ ሊቆ ጋልባ ካሞ፤ እያ ቦላ ጉጅድ ካሎሰ ጫርቀ ካሞ፤ ቶክያ ካሶታ ሳጋዮታን አ።<verse eid="NUM 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7"/>“ጎዳስ ሺቅያ ኡይ ዎያ ፃርጴዛ ቦላ ካሎሰ ጫርቀ ካሞ። ፃርጴዛ ቦላ ሳነታ፥ ጭልፓታ፥ ፁአታነ ዎይነ ኡሻ ያርሹዋ ዱቅያ ኦቶታ ዎና። ኡይይ ኡባ ዎደ ፃርጴዛ ቦላ ደኦ። <verse eid="NUM 4:7"/><verse number="8" style="v" sid="NUM 4:8"/>ሄ ኡባ ቦላ ዞኦ ጫርቀ ካምድ እያ ቦላ ቃስ ሊቆ ጋልባ ካሞ፤ ሄሳፈ ካልድ ቶክያ ካሶታ ሳጋዮታን አ።<verse eid="NUM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9"/>“ካሎሰ ጫርቀ ኤክድ ፆምፐ ዎያ ኮጫ፥ እያ ፆምፐታራ፥ እያ ቃጰታራ፥ ብዶ ከስያ ከረታራነ ዛይተ ትግያ ፃሮታራ ኡባ ካሞ። <verse eid="NUM 4:9"/><verse number="10" style="v" sid="NUM 4:10"/>ያትድ እያ ሚሸታ ኡባ ሊቆ ጋልባን ካምድ ቶክያ አርሳ ቦላ ዎና።<verse eid="NUM 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11"/>“ካልድ ዎርቃ ያርሾ ሳፅንያ ካሎሰ ጫርቀን ካሞ፤ ቃስ እያ ቦላራ ሊቆ ጋልባ የጎ። ያትድ ቶክያ ካሶታ ሳጋዮታን አ። <verse eid="NUM 4:11"/><verse number="12" style="v" sid="NUM 4:12"/>ሄሳዳካ፥ ጌሻ ዱንካንያ ግዶን ጎኤትያ ሚሸታ ኡባ ካሎሰ ጫርቀን ፃፆ፤ እያ ቦላ ሊቆ ጋልባ የግድ፥ ቶክያ አልጋ ቦላ ዎ።<verse eid="NUM 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13"/>“ናሰ ያርሾ በሳፈ ብዱዋ ፕትድ እያ ቦላ ኦቻ ቴራ ዳንያ ጫርቀ ካሞ። <verse eid="NUM 4:13"/><verse number="14" style="v" sid="NUM 4:14"/>ያርሾ በሳን ጎኤትያ ሚሸታ ኡባ፤ ታማ ጮጨታ፥ አሾ ቃጰታ፥ አካፋታነ ሃ ከረታ እያ ቦላ ዎድ፥ ሊቆ ጋልባ ካሞ። ያትድ ቶክያ ካሶታ ሳጋዮታን አ። <verse eid="NUM 4:14"/><verse number="15" style="v" sid="NUM 4:15"/>አሮንነ እያ አደ ናይት፥ ጌሻባታነ እያን ጎኤትያ ጌሻ ሚሸታ ኡባ ካምዳፐ ጉየ እስራኤለ አሳይ ጉታፐ ደንድያ ዎደ ቃሃታ ኮቻይ ይድ ቶኮ። ሽን ኤንቲ ሀይቆና መላ ጌሻ ሚሸታ ቦቾፎ። ጌሻ ዱንካነይ በሳፈ ደንድያ ዎደ ቃሃታ ኮቻስ ደእያ አዋተይ ሀይሳ።<verse eid="NUM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16"/>“ካህንያ አሮና ናአይ አላዛር ፆምፐ ዛይትያ፥ ሳውያ እፃንያ፥ ያርሾ ካነ ትዮ ዛይትያ፥ ሄሳዳካ ጌሻ ዱንካንያን ደእያ ዱማ ዱማ ጌሻ ሚሸታ ኡባ ቦላ አዋተ ደኤስ” ያግስ።<verse eid="NUM 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17"/>ጎዳይ ሙሰኮነ አሮናኮ፥ <verse eid="NUM 4:17"/><verse number="18" style="v" sid="NUM 4:18"/>“ቃሃታ ኮቻይ ሌወ ኮቻ ግዶፈ ሀይቅድ ያና መላ ኦፍተ። <verse eid="NUM 4:18"/><verse number="19" style="v" sid="NUM 4:19"/>ኡባፈ ጌሻ ሚሽያኮ ሺቅድ ሀይቆና መላ አሮንነ እያ አደ ናይት ጌሻ ዱንካንያ ግዶ ገልድ፥ ቆሃታ ኮቻይ ሁጰን ሁጰን ኦና ኦሱዋነ ቶካና ቶሁዋ ሻክድ በሶ። <verse eid="NUM 4:19"/><verse number="20" style="v" sid="NUM 4:20"/>ቃሃታ ኮቻይ ሀይቆናዳ ጌሻ ሚሸታ በአናዉ ጉ ዎደስካ ዱንካንያ ግዶ ገሎፖ” ያግስ።<verse eid="NUM 4:20"/></para>
  <para style="s1">ገድሶና ኮቻስ እመትዳ ኦሶ</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 4:21"/><verse number="22" style="v" sid="NUM 4:22"/>“ሌወ ኮቻፈ ገድሶና ኮቻነ ኤንታ ሶ አሳ አሳ ሻካዳ ታይባ። <verse eid="NUM 4:22"/><verse number="23" style="v" sid="NUM 4:23"/>ላይ 30-50 ጋክዳ አደ ኡባ ጌሻ ዱንካንያ ግዶን ኦናዉ ዳንዳኤይሳታ ታይባ። <verse eid="NUM 4:23"/><verse number="24" style="v" sid="NUM 4:24"/>ገድሶና ኮቻት ኦና ኦሶይ ሀይሳፈ ካልድ ደኤይሳ፤ <verse eid="NUM 4:24"/><verse number="25" style="v" sid="NUM 4:25"/>ኤንቲ ጌሻ ዱንካንያ ጋ ካማ፥ ካረ ካማ፥ ቦላራ የገትያ ሊቆ ዶአ ጋልባ፥ ገልያ ዉላ ቦላ ካቀትያ ማጋራጁዋ ቶኮ። <verse eid="NUM 4:25"/><verse number="26" style="v" sid="NUM 4:26"/>ሄሳዳካ ጌሻ ዱንካንያነ ያርሾ በሳ ዩሹዋን ደእያ ዳባባ ማጋራጆታ፥ ዳባባ ገልያ ዉላ ቦላ ደእያ ገሸታ፥ ዎዶሮታነ እያዉ ጎኤትያ ሚሸታ ኡባ ቶኮ። ገድሶና ኮቻይ ሚሸታን ኦናዉ በሲያ ኦሶ ኡባ ኦ። <verse eid="NUM 4:26"/><verse number="27" style="v" sid="NUM 4:27"/>ቶሆ ግድን፥ ሀራ ኦሶ ግድን፥ ኤንቲ ኦያ ኦሶ ኡባ አሮንነ እያ አደ ናይት ኤንታ ካል ኦስሶ። ኤንቲ ቶካናዉ በሲያባታ ኡባ ነ አዋተን ኤንታዉ ግሻ። <verse eid="NUM 4:27"/><verse number="28" style="v" sid="NUM 4:28"/>ጌሻ ዱንካንያ ግዶን ገድሶና ኮቻይ ኦና ኦሶይ ሀይሳ። ኤንታ ኦሱዋ ካህንያ አሮና ናአይ እታማር ካልድ ኦስሶ።<verse eid="NUM 4:28"/></para>
  <para style="s1">ማራራ ኮቻስ እመትዳ ኦሶ</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29"/>“ሌወ ኮቻፈ መራራ ኮቻነ ኤንታ ሶ አሳ አሳ ሻካዳ ታይባ። <verse eid="NUM 4:29"/><verse number="30" style="v" sid="NUM 4:30"/>ላይ 30-50 ጋክዳ አደ ኡባ ጌሻ ዱንካንያ ግዶን ኦናዉ ዳንዳኤይሳታ ታይባ።<verse eid="NUM 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 4:31"/>“ኤንቲ ዱንካንያ ቱቀታ፥ ልዮታ፥ ቱሳታ፥ ዱንካንያ ገዳታ፥ <verse eid="NUM 4:31"/><verse number="32" style="v" sid="NUM 4:32"/>ዱንካንያ ዩሾን ዳባባን ኤቅያ ቱሳታ፥ ሄ ቱሳታ ገዳታ፥ ሸታ፥ ዎዶሮታነ እያን ኮሽያ ሚሸታ ኡባ ቶኮ። እሶይ እሶይ ቶካናዉ በሲያ ሚሽያ እያ ሱንን ሻካዳ ግሻ። <verse eid="NUM 4:32"/><verse number="33" style="v" sid="NUM 4:33"/>ጌሻ ዱንካንያ ግዶን መራራ ኮቻይ ኦና ኦሶይ ሀይሳ። ኤንቲ ኦና ኦሶ ኡባ ካህንያ አሮና ናኣ እታማር አዋተን ካልድ ኦስሶ” ያግስ።<verse eid="NUM 4:33"/></para>
  <para style="s1">ሌወ ኮቻ ታይቡዋ</para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34"/>ሙሰይ፥ አሮንነ እስራኤለ ሀላቃት ቃሃታ ኮቻ ኤንታ ሶ አሳን አሳን ሻክድ ታይብዶሶና። <verse eid="NUM 4:34"/><verse number="35" style="v" sid="NUM 4:35"/>ላይ 30-50 ጋክዳ አደ ኡባ ጌሻ ዱንካንያ ግዶን ኦናዉ ዳንዳኤይሳታ ታይብዶሶና። <verse eid="NUM 4:35"/><verse number="36" style="v" sid="NUM 4:36"/>ኤንታ ታይቦይ 2,750. <verse eid="NUM 4:36"/><verse number="37" style="v" sid="NUM 4:37"/>ጎዳይ ሙሰ ኪትዳይሳዳ ጌሻ ዱንካንያ ግዶን ኦና መላ ሙሰይነ አሮን ታይብዳ ቃሃታ ኮቻት ሀይሳታ።<verse eid="NUM 4:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38"/>ገድሶና ኮቻት ባንታ ሶ አሳን አሳን ሻከትድ ታይበትዶሶና። <verse eid="NUM 4:38"/><verse number="39" style="v" sid="NUM 4:39"/>ላይ 30-50 ጋክዳ አደት ኡባ ጌሻ ዱንካንያ ግዶን ኦናዉ ዳንዳኤይሳታ <verse eid="NUM 4:39"/><verse number="40" style="v" sid="NUM 4:40"/>ታይቦይ 2,630. <verse eid="NUM 4:40"/><verse number="41" style="v" sid="NUM 4:41"/>ጎዳይ ሙሰ ኪትዳይሳዳ ጌሻ ዱንካንያ ግዶን ኦና መላ ሙሰይነ አሮን ታይብዳ ገድሶና ኮቻት ሀይሳታ።<verse eid="NUM 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42"/>መራራ ኮቻት ባንታ ሶ አሳን አሳን ሻከትድ ታይበትዶሶና። <verse eid="NUM 4:42"/><verse number="43" style="v" sid="NUM 4:43"/>ላይ 30-50 ጋክዳ አደት ኡባይ፥ ጌሻ ዱንካንያ ግዶን ኦናዉ ዳንዳኤይሳታ <verse eid="NUM 4:43"/><verse number="44" style="v" sid="NUM 4:44"/>ታይቦይ 3,200. <verse eid="NUM 4:44"/><verse number="45" style="v" sid="NUM 4:45"/>ጎዳይ ሙሰ ኪትዳይሳዳ ጌሻ ዱንካንያ ግዶን ኦና መላ ሙሰይነ አሮን ታይብዳ መራራ ኮቻት ሀይሳታ።<verse eid="NUM 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46"/>ሙሰይ፥ አሮንነ እስራኤለ ሀላቃት ሌወታ ኡባ ኤንታ ኮቻንነ ኤንታ ሶ አሳን አሳን ሻክድ ታይባ። <verse eid="NUM 4:46"/><verse number="47" style="v" sid="NUM 4:47"/>ላይ 30-50 ጋክዳ አደት ኡባይ፥ ጌሻ ዱንካንያ ግዶን ኦናዉኑነ ሚሸታ ቶካናዉ ዳንዳእያ፥ <verse eid="NUM 4:47"/><verse number="48" style="v" sid="NUM 4:48"/>ሌወታ ታይቦይ 8,580. <verse eid="NUM 4:48"/><verse number="49" style="v" sid="NUM 4:49"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ ኤንቲ ሁጰን ሁጰን ታይበትዶሶና። ሄሳዳካ ጎዳይ ሙሰ ኪትዳይሳዳ ኤንቲ ኦና ኦሶይነ ቶካና ቶሆይ እመትስ።<verse eid="NUM 4:49"/></para>
  <chapter eid="NUM 4"/>
  <chapter number="5" style="c" sid="NUM 5"/>
  <para style="s1">ጌሻ ጉታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 5:1"/><verse number="2" style="v" sid="NUM 5:2"/>“እስራኤለ አሳይ ባሮ ሀርገን ኦይከትዳ አስ ዎይኮ አሳተፈ ጎግያባይ ደእያ አስ ዎይኮ አሀ ቦችድ ቱንዳ አስ ኦናካ ባንታ ጉታፐ ከሳና መላ ኪታ። <verse eid="NUM 5:2"/><verse number="3" style="v" sid="NUM 5:3"/>ታ ኤንታ ግዶን ደእያ ጉታ ቱንሶና መላ ሀ ጌሽ ግዶና አሳት ማጫ ግድን አደ ኤንታ ግዶፈ ከሳዳ ጎዳ” ያግስ። <verse eid="NUM 5:3"/><verse number="4" style="v" sid="NUM 5:4"/>ጎዳይ ሙሰ ኪትዳይሳዳ እስራኤለ አሳይ ኤንታ ኡባ ጉታፐ ከስድ ጎድዶሶና።<verse eid="NUM 5:4"/></para>
  <para style="s1">ናቆ አጫ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 5:5"/><verse number="6" style="v" sid="NUM 5:6"/>“ኔኒ እስራኤለ አሳስ ሀይሳ ኦዳ፤ አደ ግድን ዎይኮ ማጭ ግድን ኦንካ ጎዳስ አማነቶና እፅድ ሀራ አስ ናቅኮ ሄ ኡራይ ባላ ኦስ። <verse eid="NUM 5:6"/><verse number="7" style="v" sid="NUM 5:7"/>እ ባ ናጋራ ፓፆ፤ ባ ናጋራ አጭያ ኩመ አጫ ቦላ ፄታፐ ላታሙ ኩሸ ጉጅድ እ ናቅዳ ኡራስ ጭጎ። <verse eid="NUM 5:7"/><verse number="8" style="v" sid="NUM 5:8"/>ሽን ሄ ናቀትዳ ኡራይ ሀይቅዳባ ግድኮ፥ አጫ ኤካናዉ ማታ ዳቦይ እያዉ ይኮ፥ ሄ አጫይ ጎዳስ ግድድ ካህንያስ እመቶ። ሄ አጫ ቦላ ጉጅድ እያ ናጋራ አቶተስ ቆሆ ያርሾስ ግድያ ማራዘ ዶርስ እሞ። <verse eid="NUM 5:8"/><verse number="9" style="v" sid="NUM 5:9"/>ቃስ እስራኤለ አሳይ ጎዳስ እምያ ጌሻ እሞ ኡባይ ሄ ካህንያስ ግዶ። <verse eid="NUM 5:9"/><verse number="10" style="v" sid="NUM 5:10"/>እስ እስ አስ እምያ ጌሻ እሞታይ ሄ ኡራባ፥ ሽን ካህንያስ እምኮ ሄ እሞታይ ካህንያሳ” ያግስ።<verse eid="NUM 5:10"/></para>
  <para style="s1">አዝን ስያ ማችዉ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 5:11"/><verse number="12" style="v" sid="NUM 5:12"/>“እስራኤለ አሳስ ያጋዳ ኦዳ፤ እስ አድያ ማችያ ካረ ሄመታዳ እያዉ አማነቶና እፅኮ፥ <verse eid="NUM 5:12"/><verse number="13" style="v" sid="NUM 5:13"/>ሀራ አደራ አቅኮ፥ ቃስ ሄሳ እያ ባ አዝናፐ ቆስኮ፥ እያ ላይማትሽን በእዳ ማርክ ባይናባ ግድኮ፥ <verse eid="NUM 5:13"/><verse number="14" style="v" sid="NUM 5:14"/>እ አዝናይ እዮ ቱናሱ ግድ ስኮ፥ ዎይኮ እያ ቱኖና ደእሽን እ ባ ማችዉ ስኮ፥ <verse eid="NUM 5:14"/><verse number="15" style="v" sid="NUM 5:15"/>ሄ አደይ ባ ማችዉ ካህንያኮ ኤፎ። እ ግሾ ያርሻናዉ እስ ክሎ ግራመ ባንጋ ለ ኤፎ። ሄ አደይ ባ ማችዉ ስዳ ግሾ፥ እ ቆሁዋ ቆንጭስያ ካ ያርሾ ግድያ ግሾ፥ ልያ ቦላ ዛይተ ትጎፖ፤ እፃነ እያ ቦላ ዎፎ።”<verse eid="NUM 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16"/>ካህነይ ሄ ማጫስዉ ጎዳ ስንን ኤሶ። <verse eid="NUM 5:16"/><verse number="17" style="v" sid="NUM 5:17"/>ጌሻ ሃ ከረን ኤኮ። ጌሻ ዱንካንያ ዉይግያፐ ቢታ ኤክድ ሄ ሃን ጉጆ። <verse eid="NUM 5:17"/><verse number="18" style="v" sid="NUM 5:18"/>ሄ ማጫስዉ ጎዳ ስንን ኤሶ፤ ሄ ማጫሰ ሁጵያ ብልድ ስዳ ግሾ ያርሸትያ ቆሁዋ ቆንጭስያ ካ ያርሾ እ ኩሸን ዎ፤ ቃስ ካህነይ ባ ኩሸን ባደ ኤህያ ጫሞ ሃ ከረን ኦይኮ። <verse eid="NUM 5:18"/><verse number="19" style="v" sid="NUM 5:19"/>ሄሳፈ ጉየ ማጫስዉ ያግድ ጫቅሶ፤ “ኔኒ ሀራ አደራ አቃቦናባ ግድኮ፥ ነናተ ቱንሳቦናባ ግድኮ፥ ባደ ኤህያ ሃይ ነዉ ጎመ ግዶፖ። <verse eid="NUM 5:19"/><verse number="20" style="v" sid="NUM 5:20"/>ሽን ኔኒ ነ አዝና አጋዳ ሀራ አደራ አቃዳ ቱንዳባ ግድኮ፥ <verse eid="NUM 5:20"/><verse number="21" style="v" sid="NUM 5:21"/>ጎዳይ ነ የሎ ኬ ጉንድስድ፥ ነ ኡሉዋ ጋቢስድ ነ አሳ ስንን ነና ባደትዳባ ኦ። <verse eid="NUM 5:21"/><verse number="22" style="v" sid="NUM 5:22"/>ሀ ባደ ኤህያ ሃይ ነ ኡሉዋን ገልድ ነ ኡሉዋ ጋቢሶ፤ ነ የሎ ኬ ጉንድሶ” ያግድ ጫቅሶ።</para>
  <para style="p" vid="NUM 5:22">ማጫስያ፥ “አምንእ፥ ሄስ ታና ጋኮ” ያጎ።<verse eid="NUM 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23"/>“ሀይሳፈ ጉየ፥ ካህነይ ሄ ባደ ፃፎ፤ ሄ ፃፍዳይሳ ከርያን ደእያ ሃን ሜጮ። <verse eid="NUM 5:23"/><verse number="24" style="v" sid="NUM 5:24"/>ቃንገ ኤህያ ሃ ማጫስዉ ኡሻናፐ ስን፥ <verse eid="NUM 5:24"/><verse number="25" style="v" sid="NUM 5:25"/>ካህነይ ማጫሰ ኩሸፐ ያርሾ ልያ ኤክድ፥ ደን ያርሾ ኦድ ጎዳስ ያርሾ። <verse eid="NUM 5:25"/><verse number="26" style="v" sid="NUM 5:26"/>ካህነይ ያርሾ ካፈ ዞለ ኤክድ ባላ ቆንጭስያ ያርሾ ኦድ ያርሾ በሳን ፁጎ። ሄሳፈ ጉየ፥ ማጫስዉ ሄ ሃ ኡሾ። <verse eid="NUM 5:26"/><verse number="27" style="v" sid="NUM 5:27"/>እያ ባ አዝናስ አማነቶና እፃዳ ቱንዳባ ግድኮ ባደ ሃይ እ ኡሉዋን ጫሞ ሳሆ መ። እ ኡሎይ ጋባና፤ እ የሎ ኬይካ ጉንዳና፤ እያ ባ አሳ ግዶን ባደትዳሮ ግዳና። <verse eid="NUM 5:27"/><verse number="28" style="v" sid="NUM 5:28"/>እያ ቱናቦናባነ ፅሎ ማጫስ ግድኮ፥ እያ ጌሽ ግዳና፤ ናአ የላናዉ ዳንዳአዉሱ።<verse eid="NUM 5:28"/></para>
  <para style="p">
    <verse number="29-30" style="v" sid="NUM 5:29-30"/>“እስ አስ ባ ማችዉ ላይማታሱ ግድ ስኮ ዎይኮ ቃናትኮ ያርሾ በሲ ኤህድ እዮ ኤሶ። ካህነይ ሄ ዎጋ ኡባ እ ቦላ ፖሎ። <verse eid="NUM 5:29-30"/><verse number="31" style="v" sid="NUM 5:31"/>አዝናይ፥ ቆሆይ ባይናባ ግዳና፥ ሽን ማችያ ባ ናጋራ ጋሶን ጋክያ ዋየ ኡባ ቶካና” ያግስ።<verse eid="NUM 5:31"/></para>
  <chapter eid="NUM 5"/>
  <chapter number="6" style="c" sid="NUM 6"/>
  <para style="s1">ናዝራወ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 6:1"/><verse number="2" style="v" sid="NUM 6:2"/>“እስራኤለ አሳ ሀይሳዳ ጋዳ ኪታ፤ አደ ግድን ዎይኮ ማጫ ባና ጎዳስ ዱማይድ ናዝራወ ግዳናዉ ቃንግኮ፥ <verse eid="NUM 6:2"/><verse number="3" style="v" sid="NUM 6:3"/>ዎይነ ዎይኮ ሀራ ማይያ ኡሽ ኡዮፖ። ጫላባነ ማያባ ኡዮፖ፤ ዎይነ ቴራ፥ ትያነ መላ ሞፖ። <verse eid="NUM 6:3"/><verse number="4" style="v" sid="NUM 6:4"/>እ ባና ጎዳስ ዱማይዳ ዎደ ኡባን፥ ዎይነ አይፍያ ግድን ፖቁዋ ግድን ዎይኮ ኮቻ ግድን ሞፖ።<verse eid="NUM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5"/>“እ ባና ጎዳስ ዱማይዳ ዎደ ኡባን፥ ባ ሁጵያ ሜደቶፎ ዎይኮ ቃንፀቶፎ። እ ባ ሁጰ ብናና አዱስድ ድቾ። እ ባና ጎዳስ ዱማይዳ ዎደይ ፖለታና ጋካናዉ ጌሽ ግዳናዉ ኮሼስ። <verse eid="NUM 6:5"/><verse number="6" style="v" sid="NUM 6:6"/>እ ባና ጎዳስ ዱማይዳ ዎደን ኡባን አሀኮ ሺቆፖ። <verse eid="NUM 6:6"/><verse number="7" style="v" sid="NUM 6:7"/>እ ባና ዱማይዳይሳ ኤርሰይ እያ ሁጵያ ግድያ ግሾ፥ እያ አዋይ ዎይኮ እያ አይያ ዎይኮ እያ እሻይ ዎይኮ እያ ምችያ ሀይቅኮ ኤንታ አሀ ቦችድ ባና ቱንሶፖ። <verse eid="NUM 6:7"/><verse number="8" style="v" sid="NUM 6:8"/>እ ባና ጎዳስ ዱማይዳ ዎደ ኡባን ጎዳስ ጌሽ።<verse eid="NUM 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9"/>“አስ እያ ማታን ቆፖና ሀይቅኮ፥ ጎዳስ ጌሽ ግድዳ ባ ሁጵያ ቱንስኮ ላፑን ጋላስ ጋምእድ ባ ሁጵያ ሜደቶ። <verse eid="NUM 6:9"/><verse number="10" style="v" sid="NUM 6:10"/>ሆስፑን ጋላሳን ናምኡ ሆለታ ዎይኮ ናምኡ ኩራቾታ ጌሻ ዱንካንያ ፐንገን ደእያ ካህንያስ ኤሆ። <verse eid="NUM 6:10"/><verse number="11" style="v" sid="NUM 6:11"/>ናዝራወይ አሀ ቦችድ ቱንዳ ግሾ ናጋራፐ እያ ጌሻናዉ ካህነይ ሆለታፐ እሱዋ ናጋራ ያርሾ፥ ሀንኩዋ ቃስ ፁሳ ያርሾ ኦድ ያርሾ። ሄ ጋላስ እ ባ ሁጵያ ዎጋዳ ዛሪድ ጎዳስ ጌሾ፤ <verse eid="NUM 6:11"/><verse number="12" style="v" sid="NUM 6:12"/>እ ባና ዛሪድ ጎዳስ ዱማዮ። ያትድ እስ ላይ ማራዘ ናቆ ያርሾ ኦድ ያርሾ። እ ጎዳስ ዱማይዳ ሁጰይ ቱንዳ ግሾ፥ ካሰ እ ባና ጎዳስ ዱማይድ ደእዳ ዎደይ ታይበተና።<verse eid="NUM 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13"/>“እስ ናዝራወይ ባ ቃንገ ዎድያ ኦንግዳ ዎደ ፖላና ዎጋይ ሀይሳ፤ ጌሻ ዱንካንያ ፐንገ ብድ፤ <verse eid="NUM 6:13"/><verse number="14" style="v" sid="NUM 6:14"/>ቦረይ ባይና እስ ላይ ዶርሳ ኡርገ ፁሳ ያርሾስ፥ እስ ላይ ኡዞ ዶርስ ናጋራ ያርሾስ፥ እስ ማራዘ እስፈተ ያርሾስ ሄ በሳ ኤሆ። <verse eid="NUM 6:14"/><verse number="15" style="v" sid="NUM 6:15"/>ቃስ ካ ያርሾነ ኡሻ ያርሾ ኤንታራ እስፈ ያርሻናዉ ኤሆ። ሄ ካ ያርሾይ እርሾይ ገልቦና ሎኦ ለ ሻማሆ ዛይተራ ኡከትዳ ኦርደ ኡይነ ሻማሆ ዛይተን ትየትዳ ሌኦ ጋይታን ኤሆ።<verse eid="NUM 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16"/>“ካህነይ ሄ ኡባ ናጋራ ያርሾነ ፁሳ ያርሾ ኦድ ጎዳስ ያርሾ። <verse eid="NUM 6:16"/><verse number="17" style="v" sid="NUM 6:17"/>ካህነይ ማራዝያ ጋይታን ደእያ ኡይራ ጎዳስ እስፈተ ያርሾ ኦድ ያርሾ፤ ካልድ ካ ያርሹዋነ ኡሻ ያርሹዋ ያርሾ። <verse eid="NUM 6:17"/><verse number="18" style="v" sid="NUM 6:18"/>ናዝራወይ ጎዳስ ዱማይዳ ባ ሁጵያ ጌሻ ዱንካንያ ፐንገን ሜደትድ፥ ብናና እስፈተ ያርሾይ ኤፅያ ታማን የጎ።<verse eid="NUM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19"/>“ናዝራወይ ባ ሁጵያ ሜደትዳፐ ጉየ፥ ካህነይ ዶይሰትዳ ማራዝያ ገዳ አሹዋ ጋይታን ደእያ ኦርደ ኡይፈነ ሌኦ ኡይፈ ኤክድ፥ ናዝራውያ ኩሸን ዎ። <verse eid="NUM 6:19"/><verse number="20" style="v" sid="NUM 6:20"/>ያትድ ካህነይ ሄ ኡባ ዩሾ ያርሾ ኦድ፥ ጎዳስ ያርሾ። ሄ ኡባይ ካህንያ ግሾ ግድያ አንጋሱዋራነ ገዳራ ካህንያስ ጌሻ ያርሾ ግዴስ። ሄሳፈ ጎዳስ ናዝራወይ ዎይነ ኡሻ ኡዮ። <verse eid="NUM 6:20"/><verse number="21" style="v" sid="NUM 6:21"/>ህዛ ጎዳስ ባና ዱማይዳ ናዝራወይ ኦና መላ እመትዳ ዎጋይ ሀይሳ። ሽን ናዝራወይ ያርሻናዉ ኮሽያ ያርሾታፐ አድ እማናዉ ቃንግዳባ ግድኮ፥ ባ ቃንገ ጋናዉ ኮሼስ” ያግስ።<verse eid="NUM 6:21"/></para>
  <para style="s1">ካህነት አንጅያ አንጁዋ</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 6:22"/><verse number="23" style="v" sid="NUM 6:23"/>“አሮንነ እያ አደ ናይት እስራኤለ አሳ አንጅያ ዎደ ሀይሳዳ ያግድ አንጅተ ያጋ፤<verse eid="NUM 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24"/>“ ‘ጎዳይ ህንተና አንጆ፥ ጎዳይ ህንተና ናጎ፤<verse eid="NUM 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25"/>ጎዳይ ባ ሶምኡዋ ህንተዉ ፖእሶ፤ እ ህንተዉ ቃቶ፤<verse eid="NUM 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26"/>ጎዳይ ባ ኬሀ አይፍያን ፄሎ፤ እ ህንተዉ ሳሮተ እሞ’ ያግድ አንጅተ” ያጋ።<verse eid="NUM 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27"/>“ኤንቲ እስራኤለ አሳ ታ ሱንን አንጅያ ዎደ ታ ኤንታ አንጃና” ያግስ።<verse eid="NUM 6:27"/></para>
  <chapter eid="NUM 6"/>
  <chapter number="7" style="c" sid="NUM 7"/>
  <para style="s1">ጌሻ ዱንካንያ አንጅሶ እሞታታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1"/>ሙሰይ ጌሻ ዱንካንያ ቶክድ ኦንግዳ ዎደ ሄ ዱንካንያነ እያ ሚሽያ፥ ያርሾ በሳነ እያ ሚሽያ ኡባ ዛይተን ትይድ ጌሽስ። <verse eid="NUM 7:1"/><verse number="2" style="v" sid="NUM 7:2"/>ሄሳፈ ጉየ፥ እስራኤለ አሳ ኮቻን ኮቻን ታይብድ ካለያ ዎደ ሀላቃ ግድዳ ኡባይ፥ <verse eid="NUM 7:2"/><verse number="3" style="v" sid="NUM 7:3"/>ጎዳስ እሞታ ሺሽዶሶና። ኤንቲ እምዳ እሞታይ ናምኡ ሀላቃ ሱንን እስ ፓራ ጋረ፥ ቃስ እስ እስ ሀላቃ ሱንን እስ እስ ቦሩ ኦድ፥ ኡሱፑን ጋረታነ ታማነ ናምኡ ቦራታ ጌሻ ዱንካንያ ኤህዶሶና።<verse eid="NUM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 7:4"/><verse number="5" style="v" sid="NUM 7:5"/>“ጌሻ ዱንካንያ ኦሱዋስ ጎአና መላ ኔኒ ሄ እሞታ ኤንታፈ ኤካዳ፥ ኤንታ ኦሱዋስ ኦሱዋስ ኮሸይሳዳ ሻካዳ ሌወታስ እማ” ያግስ። <verse eid="NUM 7:5"/><verse number="6" style="v" sid="NUM 7:6"/>ሄሳ ግሾ፥ ሙሰይ ጋረታነ ቦራታ ኤክድ ሌወታስ እሚስ። <verse eid="NUM 7:6"/><verse number="7" style="v" sid="NUM 7:7"/>ገድሶና ኮቻስ ኮሸይሳዳ ሻክድ ኤንታ ኦሱዋስ ናምኡ ጋረታነ ኦይዱ ቦራታ እሚስ። <verse eid="NUM 7:7"/><verse number="8" style="v" sid="NUM 7:8"/>መራራ ኮቻስ ኮሸይሳዳ ሻክድ፥ ኤንታ ኦሱዋስ ኡይዱ ጋረታነ ሆስፑን ቦራታ እሚስ። ኤንታ ኦሱዋ አዋተን ካለይ ካህንያ አሮና ናኣ እታማራ። <verse eid="NUM 7:8"/><verse number="9" style="v" sid="NUM 7:9"/>ሽን ቃሃታ ኮቻ ኦሶይ ዱንካንያ ጌሻ ሚሸታ ሀሸን ቶሆ ግድያ ግሾ ሙሰይ ኤንታዉ ፓራ ጋረነ ቦሩ እምቤና።<verse eid="NUM 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10"/>ሙሰይ ያርሾ በሲ ጎዳስ ዱማይዳ ጋላስ ሀላቃት ያርሾ በሳ ስን ባንታ እሞታ ኤህዶሶና። <verse eid="NUM 7:10"/><verse number="11" style="v" sid="NUM 7:11"/>ጎዳይ ሙሰኮ፥ “እስ እስ ጋላስ እስ እስ ሀላቃይ ያርሾ በሲ ጎዳስ ዱማያናዉ ባ እሞታ እሞ” ያግስ።<verse eid="NUM 7:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="NUM 7:12"/>ኮይሮ ጋላስ ባ እሞታ ኤህዳይ ይሁዳ ኮቻፈ አምናዳበ ናኣ ናአሶና።<verse eid="NUM 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 7:13"/>ናአሶን ኤህዳ እሞታይ ጌሻ ዱንካነን ኤረትዳ ምዛነን 1,500 ግራመ ብራፐ ኦሰትዳ ፕጫ ሳነ፥ 800 ግራመ ብራፐ ኦሰትዳ ኦላትያ ሳነ፥ ናምኣካ ካ ያርሾ ያርሻናዉ ዛይተራ ዋላከትዳ ሎኦ ለ ኩምዳይሳ፤ <verse eid="NUM 7:13"/><verse number="14" style="v" sid="NUM 7:14"/>ቃስ 110 ግራመ ዎርቃፈ ኦሰትዳ እፃነይ ኩምዳ ሻተ፤ <verse eid="NUM 7:14"/><verse number="15" style="v" sid="NUM 7:15"/>ፁሳ ያርሾስ፥ እስ ዎፋኖ፥ እስ ማራዘ፥ እስ ላይ ኡርገ ዶርስ፤ <verse eid="NUM 7:15"/><verse number="16" style="v" sid="NUM 7:16"/>ናጋራ ያርሾስ እስ ኮለ፤ <verse eid="NUM 7:16"/><verse number="17" style="v" sid="NUM 7:17"/>እስፈተ ያርሾስ ናምኡ ቦራታ፥ እቻሹ ማራዘታ፥ እቻሹ ኮለታነ እቻሹ ኡርገ ዶርሳታ ኤህስ።</para>
  <para style="m" vid="NUM 7:17">ካልያ ሀንኮ ሀላቃትካ አምናዳበ ናአይ ናአሶን እምዳይሳዳ ባንታ እሞታ ኤህዶሶና።<verse eid="NUM 7:17"/></para>
  <para style="p">
    <verse number="18-23" style="v" sid="NUM 7:18-23"/>ናምአን ጋላሳን ይሳኮራ ኮቻፈ ዙአራ ናአይ ናትናኤል ባ እሞታ ኤህስ።<verse eid="NUM 7:18-23"/></para>
  <para style="p">
    <verse number="24-29" style="v" sid="NUM 7:24-29"/>ሄን ጋላሳን ዛብሎና ኮቻፈ ሄሎና ናአይ ኤልኣብ ባ እሞታ ኤህስ።<verse eid="NUM 7:24-29"/></para>
  <para style="p">
    <verse number="30-35" style="v" sid="NUM 7:30-35"/>ኦይዳን ጋላሳን ሮቤላ፥ ኮቻፈ ሻደኡራ ናአይ ኤልዙር ባ እሞታ ኤህስ።<verse eid="NUM 7:30-35"/></para>
  <para style="p">
    <verse number="36-40" style="v" sid="NUM 7:36-40"/>እቻሻን ጋላሳን ስሞና ኮቻፈ ዙርሻዳያ ናአይ ሳሉምኤል ባ እሞታ ኤህስ።<verse eid="NUM 7:36-40"/></para>
  <para style="p">
    <verse number="41-47" style="v" sid="NUM 7:41-47"/>ኡሱፑን ጋላሳን ጋደ ኮቻፈ ራጉኤላ ናአይ ኤልያሳፍ ባ እሞታ ኤህስ።<verse eid="NUM 7:41-47"/></para>
  <para style="p">
    <verse number="48-53" style="v" sid="NUM 7:48-53"/>ላፑን ጋላሳን ኤፍሬማ ኮቻፈ አምሁዳ ናአይ ኤልሻማእ ባ እሞታ ኤህስ።<verse eid="NUM 7:48-53"/></para>
  <para style="p">
    <verse number="54-59" style="v" sid="NUM 7:54-59"/>ሆስፑን ጋላሳን ምናሰ ኮቻፈ ፓዳዙራ ናአይ ጋማልኤል ባ እሞታ ኤህስ።<verse eid="NUM 7:54-59"/></para>
  <para style="p">
    <verse number="60-65" style="v" sid="NUM 7:60-65"/>ኡዱፉን ጋላሳን ብንያመ ኮቻፈ ግዳኦና ናአይ አብዳን ባ እሞታ ኤህስ።<verse eid="NUM 7:60-65"/></para>
  <para style="p">
    <verse number="66-71" style="v" sid="NUM 7:66-71"/>ታማን ጋላሳን ዳነ ኮቻፈ አምሳዳያ ናአይ አክኤዘር ባ እሞታ ኤህስ።<verse eid="NUM 7:66-71"/></para>
  <para style="p">
    <verse number="72-77" style="v" sid="NUM 7:72-77"/>ታማነ እስን ጋላሳን አሴራ ኮቻፈ ኦክራና ናአይ ፓግኤል ባ እሞታ ኤህስ።<verse eid="NUM 7:72-77"/></para>
  <para style="p">
    <verse number="78-83" style="v" sid="NUM 7:78-83"/>ታማነ ናምአን ጋላሳን ንፍታለመ ኮቻፈ ኤናና ናአይ አክራ ባ እሞታ ኤህስ።<verse eid="NUM 7:78-83"/></para>
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84"/>ያርሾ በሳይ ትየትያ ዎደ ጎዳስ ዱማያናዉ እስራኤለ ሀላቃት ኤህዳ እሞታይ ሀይሳፈ ካልድ ደኤይሳ።</para>
  <para style="p" vid="NUM 7:84">ብራፐ ኦሰትዳ ታማነ ናምኡ ፕጫ ሳነታነ ኦላትያ ሳነታ፤ ዎርቃፈ ኦሰትዳ ታማነ ናምኡ እፃነይ ኩምዳ ሻተታ ኤህዶሶና። <verse eid="NUM 7:84"/><verse number="85" style="v" sid="NUM 7:85"/>እሶይ እሶይ 1,500 ግራመ ብራፐ ኦሰትዳ ፕጫ ሳነ፤ ቃስ እሶይ እሶይ 800 ግራመ ብራፐ ኦሰትዳ ኦላትያ ሳነ፥ ጌሻ ዱንካነን ኤረትዳ ምዛነን ሄ ኡባ 28 ክሎ ግራመ ኤህዶሶና። <verse eid="NUM 7:85"/><verse number="86" style="v" sid="NUM 7:86"/>እፃነይ ኩምዳ ታማነ ናምኡ ዎርቃ ሻተታ 1.4 ክሎ ግራመ ጌሻ ዱንካነን ኤረትዳ ምዛነን ሺሽዶሶና። <verse eid="NUM 7:86"/><verse number="87" style="v" sid="NUM 7:87"/>ፁሳ ያርሾስ ሺቅዳ መሄይ ካ ያርሹዋራ ዎላ ታማነ ናምኡ ዎፋኖታ፥ ታማነ ናምኡ ማራዘ፥ ታማነ ናምኡ እስ ላይ ኡርገ ዶርስነ፥ ታማነ ናምኡ ኮለታ ናጋራ ያርሾስ ሺሽዶሶና። <verse eid="NUM 7:87"/><verse number="88" style="v" sid="NUM 7:88"/>እስፈተ ያርሾስ ላታማነ ኦይዱ ቦራት፥ ኡሱፑን ታሙ ማራዘታ፥ ኡሱፑን ታሙ ኮለታ፥ ኡሱፑን ታሙ እስ ላይ ኡርገ ዶርሳታ ሺሽዶሶና። ጌሻ ዱንካንያ ዱማያናዉ ትያ ዎደ ሺቅዳ ያርሾት ሀይሳታ።<verse eid="NUM 7:88"/></para>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89"/>ሙሰይ ጎዳራ ኦደታናዉ ጌሻ ዱንካንያ ገልያ ዎደ ጫቆ ታቦትያ ካማ ቦላ ደእያ ናምኡ ክሩበታፐ ግዶን ግድድ ጎዳይ ኦድሽን ስእስ።<verse eid="NUM 7:89"/></para>
  <chapter eid="NUM 7"/>
  <chapter number="8" style="c" sid="NUM 8"/>
  <para style="s1">ፆምፐታ ኡተ ማራ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 8:1"/><verse number="2" style="v" sid="NUM 8:2"/>“አሮን ላፑን ፆምፐታ ኮጫ ቦላ ዎያ ዎደ ፖኦይ ስን ባጋራ ደእያ ሄራ ፖእሳና መላ ኦድ ዎ ጋዳ ኦዳ” ያግስ።<verse eid="NUM 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ አሮን ፆምፐታ ኮጫ ቦላ ዎድ ስን ባጋራ ደእያ ሄራ ፖእሳና መላ ኦስ። <verse eid="NUM 8:3"/><verse number="4" style="v" sid="NUM 8:4"/>ፆምፐ ዎያ ኮጫይ፥ ጎዳይ ሙሰ በስዳይሳዳ ቶማፐ ብድ ቦላ ጪሻ ጋካናዉ ቆፀትዳ ዎርቃፈ ኦሰትስ።<verse eid="NUM 8:4"/></para>
  <para style="s1">ሌወታ ጌሾ ዎጋ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 8:5"/><verse number="6" style="v" sid="NUM 8:6"/>“እስራኤለ አሳ ግዶፈ ሌወታ ሻካዳ ዎጋዳ ኤንታ ጌሻ። <verse eid="NUM 8:6"/><verse number="7" style="v" sid="NUM 8:7"/>ኔኒ ኤንታ ጌሻናዉ ሀይሳዳ ኦ፤ ጌሽያ ሃ ኤካዳ ኤንታ ቦላ ዉርፃ፤ ኤንቲ ባንታ አሳተ ኡባ ሜደቶ፤ ባንታ ማኡዋ ሜጮ፤ ያንድ ኤንቲ ዎጋዳ ጌሽ ግዳና። <verse eid="NUM 8:7"/><verse number="8" style="v" sid="NUM 8:8"/>ካልድ ኤንቲ እስ ዎፋኖነ ካ ያርሾስ ግድያ ዛይተራ ዋላሄትዳ ሎኦ ለ ኤኮ፤ ቃስ ኔኒ ናጋራ ያርሾስ ሀራ እስ ዎፋኖ ኤካ። <verse eid="NUM 8:8"/><verse number="9" style="v" sid="NUM 8:9"/>ሄሳፈ ጉየ እስራኤለ አሳ ኡባ ሺሻዳ፥ ሌወታ ጌሻ ዱንካንያ ስን ኤሀዳ ኤሳ። <verse eid="NUM 8:9"/><verse number="10" style="v" sid="NUM 8:10"/>እስራኤለ አሳይ ኤንታ ሁጵያ ቦላ ባንታ ኩሽያ ዎ። <verse eid="NUM 8:10"/><verse number="11" style="v" sid="NUM 8:11"/>ሌወት እስራኤለ አሳ ግዶፈ ታዉ ዱማትድ ኦና መላ ዩሾ ያርሾ ኦድ አሮን ታ ስን ሺሾ። <verse eid="NUM 8:11"/><verse number="12" style="v" sid="NUM 8:12"/>ሌወት ባንታ ኩሽያ ናምኡ ዎፋኖታ ሁጰን ዎ። ሌወታ ናጋራ አቶተስ እሱዋ ናጋራ ያርሾ፥ ቃስ ሀንኩዋ ፁሳ ያርሾ ኦዳ ጎዳስ ያርሻ።<verse eid="NUM 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 8:13"/>“ሌወታ ሻካዳ ታዉ ዱማያ፤ አሮናነ እያ አደ ናይታ ኤንታ ቦላ ሹማ። <verse eid="NUM 8:13"/><verse number="14" style="v" sid="NUM 8:14"/>ሄሳዳ ኦዳ ሌወታ እስራኤለ አሳፐ ታዉ ዱማያ፤ ኤንቲ ታባ ግዳና።<verse eid="NUM 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 8:15"/>“ኔኒ ኤንታ ጌሽዳፐነ ዱማይዳፐ ጉየ ሌወት ጌሻ ዱንካንያን ባንታ ኦሱዋ ኦናዉ ዮ። <verse eid="NUM 8:15"/><verse number="16" style="v" sid="NUM 8:16"/>እስራኤለ አሳ ግዶፈ ኩመ ኤንቲ ታዉ እመትዶሶና፤ እስራኤለን ባይራ የለትዳ አደ ናይታ በሳን ሌወታ ታዉ ኤካስ። <verse eid="NUM 8:16"/><verse number="17" style="v" sid="NUM 8:17"/>እስራኤለ አሳ ግዶን ባይራ የለትዳ አሰ ግድን መሄ ግድን ኡባይ ታባ። ታኒ ግብፀ ቢታን ባይራ ኡባ ዎዳ ዎደ ኤንታ ታዉ ዱማያስ። <verse eid="NUM 8:17"/><verse number="18" style="v" sid="NUM 8:18"/>እስራኤለን ባይራ የለትዳ አደ ናይታ በሳን ታዉ ሌወታ ኤካስ። <verse eid="NUM 8:18"/><verse number="19" style="v" sid="NUM 8:19"/>እስራኤለ አሳ ግዶፈ ሌወታ አሮናስነ እያ አደ ናይታስ እማስ። እስራኤለ አሳይ ጌሻ ዱንካንያኮ ሺቅድ ቆሄቶና መላ ሌወት እስራኤለ አሳ ግሾ ጌሻ ዱንካንያን ኦናዉነ ናጋራ አቶተ ኤሀናዉ ዶረትዶሶና” ያግስ።<verse eid="NUM 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ ሙሰይ፥ አሮንነ እስራኤለ አሳ ኡባይ ሌወታ ዱማይዶሶና። <verse eid="NUM 8:20"/><verse number="21" style="v" sid="NUM 8:21"/>ሌወት ባንታና ጌሽዶሶና፤ ባንታ ማኡዋ ሜጭዶሶና። አሮን ኤንታ ጎዳስ ዱማ እሞ ኦድ ሺሽስ፤ ኤንታዉ ናጋራ አቶተስ ያርሽድ ኤንታ ጌሽስ። <verse eid="NUM 8:21"/><verse number="22" style="v" sid="NUM 8:22"/>ሄሳፈ ጉየ፥ ሌወት አሮናነ እያ አደ ናይታ አዋተ ጋርሳን ግድድ ጌሻ ዱንካንያ ግዶን ባንታ ኦሱዋ ኦናዉ ይዶሶና። ጎዳይ ሙሰ ሌወታ ዱማያናዉ ኪትዳይሳዳ ኤንቲ ኦዶሶና።<verse eid="NUM 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 8:23"/><verse number="24" style="v" sid="NUM 8:24"/>“ሀይስ ሌወት ኦና ዎጋ፤ ላይ ላታማነ እቻሻነ እያፐ ቦላ ግድዳ ሌወ አደ ኡባይ ጌሻ ዱንካንያን ኦናዉ ዮ። <verse eid="NUM 8:24"/><verse number="25" style="v" sid="NUM 8:25"/>ሽን ላይ እሻታሙ ግድያ ዎደ ባንታ ኦሱዋፐ ሸምፖ፤ ዛር ኦፎ። <verse eid="NUM 8:25"/><verse number="26" style="v" sid="NUM 8:26"/>ኤንቲ ጌሻ ዱንካንያን ኦያ ባንታ እሻታ ኦ ማዳናዉ ዳንዳኦሶና። ሽን ኤንቲ ባንታዉ አይ ኦሶካ ኦፎ። ህዛ ኔኒ ሌወታ ሀይሳዳ ኦስሳ” ያግስ።<verse eid="NUM 8:26"/></para>
  <chapter eid="NUM 8"/>
  <chapter number="9" style="c" sid="NUM 9"/>
  <para style="s1">ፓስካ ባኣለ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1"/>እስራኤለ አሳይ ግብፀፈ ከይዳ ናምአን ላይን ኮይሮ አጌናን ሲና መላ ቢታን ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="NUM 9:1"/><verse number="2" style="v" sid="NUM 9:2"/>“እስራኤለ አሳይ ፓስካ ባኣለ እያ ቃማን ቦንቾ። <verse eid="NUM 9:2"/><verse number="3" style="v" sid="NUM 9:3"/>ሀ አጌናን ታማነ ኦይዳን ጋላሳን እያ ቃማን ኦማርስ እያ ዎጋ ኡባዳነ እያ ኪታ ኡባዳ ቦንቾ” ያግስ። <verse eid="NUM 9:3"/><verse number="4" style="v" sid="NUM 9:4"/>ሄሳ ግሾ፥ ሙሰይ እስራኤለ አሳይ ፓስካ ባኣለ ቦንቻና መላ ኤንታዉ ኦድስ። <verse eid="NUM 9:4"/><verse number="5" style="v" sid="NUM 9:5"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ እስራኤለ አሳይ ኮይሮ አጌናን ታማነ ኦይዳን ጋላሳን፥ ኦማርስ ሲና መላ ቢታን ፓስካ ባኣለ ቦንችዶሶና።<verse eid="NUM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6"/>ሽን ኤንታፈ ባጋት አሀ ቦችድ ቱንዳ ግሾ ሄ ጋላስ ፓስካ ባኣለ ቦንቻናዉ ዳንዳእቦኮና። ሄሳ ግሾ፥ ኤንቲ ሄ ጋላስ ሙሰኮነ አሮናኮ ይድ፥ <verse eid="NUM 9:6"/><verse number="7" style="v" sid="NUM 9:7"/>“ኑኒ አሀ ቦችዳ ግሾ ቱንዳ፥ ሽን ሄ ቃማን ሀራ እስራኤለ አሳራ ጎዳስ ያርሾ ያርሾና መላ አይስ ድገትዶ?” ያግዶሶና።<verse eid="NUM 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8"/>ሙሰይ ዛሪድ፥ “ጎዳይ ህንተባ ታዉ ኦዳና ጋካናዉ ጋምእሽተ” ያግስ።<verse eid="NUM 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 9:9"/><verse number="10" style="v" sid="NUM 9:10"/>“እስራኤለ አሳኮ ሀይሳዳ ያጋ፤ ህንተፈ ዎይኮ ህንተ ኮቻፈ ኦንካ አሀ ቦችድ ቱንኮ ዎይኮ ኦገትዳባ ግድኮ፥ ፓስካ ባኣለ ቦንቻናዉ ዳንዳኤስ። <verse eid="NUM 9:10"/><verse number="11" style="v" sid="NUM 9:11"/>ናምአን አጌናን ታማነ ኦይዳን ጋላስ ኦማርስ ፓስካ ባኣለ ቦንቾ። ፓስካ ዶርሳ ኡይራነ ጫሞ ቦንጮራ ሞ። <verse eid="NUM 9:11"/><verse number="12" style="v" sid="NUM 9:12"/>ሳአይ ዎንታና ጋካናዉ ዶርሳ አሹዋፐ አይብካ አቶፎ፤ ቃስ እያ መቀፈ እሱዋካ መንፎ። ፓስካ ባልያ ዎጋ ኡባ ኦ። <verse eid="NUM 9:12"/><verse number="13" style="v" sid="NUM 9:13"/>ሽን ጌሽነ ኦገቶና አስ ፓስካ ቦንቾና እፅኮ፥ እ ታ አሳ ግዶፈ ኩረቶ። ጎዳ ያርሹዋ እያ ቃማን ያርሽቦና ግሾ ባ ናጋራ ግሾ ፕርዳ ኤኬስ።<verse eid="NUM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14"/>“ህንተ ግዶን ደእያ በተ አስ ፓስካ ባኣለ ቦንቻናዉ ኮይኮ፥ ፓስካ ዎጋዳ ቦንቾ። በታንቾይነ ቢታ አዉ ናእ ኡባይ ሄ ዎጋ ኦ” ያግስ።<verse eid="NUM 9:14"/></para>
  <para style="s1">ታማ ሻራ</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15"/>ጌሻ ዱንካነይ ቶከትዳ ጋላስ ሻራይ ጌሻ ዱንካንያ ማእስ። ኦማርሳፈ ዶምድ፥ ዎንታ ጋካናዉ ጌሻ ዱንካንያ ቦላራ ደእያ ሻራይ ታማ ዳኔስ። <verse eid="NUM 9:15"/><verse number="16" style="v" sid="NUM 9:16"/>ሄሳዳ ጋላስ ጋላስ ሻራይ ማኤስ፤ ቃማ ቃማ ሄ ሻራይ ታማዳ ፖኤስ። <verse eid="NUM 9:16"/><verse number="17" style="v" sid="NUM 9:17"/>ሄ ሻራይ ጌሻ ዱንካንያ ቦላፈ ደንድያ ዎደ ኡባን እስራኤለ አሳይ ባንታ ዱንካንዳ ጉታፐ ደንዶሶና። ቃስ ሄ ሻራይ ዎያ በሳን እስራኤለ አሳይ ዱንካኖሶና። <verse eid="NUM 9:17"/><verse number="18" style="v" sid="NUM 9:18"/>እስራኤለ አሳይ ጎዳ ኪታን ጉታፐ ደንዶሶና፤ ቃስ ጎዳ ኪታን ዱንካኖሶና። ሻራይ ጌሻ ዱንካንያ ቦላ ጋምእያ ዎደ ኡባን ባንታ ዱንካንዳ ጉታን ጋምኦሶና። <verse eid="NUM 9:18"/><verse number="19" style="v" sid="NUM 9:19"/>ሻራይ ጌሻ ዱንካንያ ቦላ ዳሮ ጋላስ ጋምእኮካ፥ እስራኤለ አሳይ ጎዳ ኪታ ናጎሶናፐ አትሽን፥ አዉካ ቦኮና። <verse eid="NUM 9:19"/><verse number="20" style="v" sid="NUM 9:20"/>እስ እስ ቶሆ ሻራይ ጌሻ ዱንካንያ ቦላ ጉ ጋላስ ጋምኤስ። ግድኮካ ኤንቲ ጎዳ ኪታን ዱንካኖሶና፤ ቃስ ጎዳ ኪታን ጉታፐ ደንዶሶና። <verse eid="NUM 9:20"/><verse number="21" style="v" sid="NUM 9:21"/>እስ እስ ቶሆ ሻራይ ኦማርሳፈ ዎንታና ጋካናዉ ፃላላ ጋምኤስ፤ ሻራይ ደንድያ ዎደ ኤንቲ ደንዶሶና። ጋላስ ግድን፥ ቃማ ግድን፥ ሻራይ ደንድያ ዎደ ኤንቲ ደንዶሶና። <verse eid="NUM 9:21"/><verse number="22" style="v" sid="NUM 9:22"/>ሻራይ ጌሻ ዱንካንያ ቦላ ናምኡ ጋላስ ግድን ዎይኮ እስ አጌና ዎይኮ እስ ላይ ጋምእን እስራኤለ አሳይ ባንታ ዱንካንዳ ጉታን ጋምኦሶናፐ አትሽን፥ ቦኮና። ሽን ሻራይ ደንድያ ዎደ ኤንትካ ደንዶሶና። <verse eid="NUM 9:22"/><verse number="23" style="v" sid="NUM 9:23"/>ጎዳይ ሙሰ ኪትዳይሳዳ ኤንቲ ጎዳ ኪታን ዱንካኖሶና ቃስ ጎዳ ኪታን ጉታፐ ደንድድ ቦሶና።<verse eid="NUM 9:23"/></para>
  <chapter eid="NUM 9"/>
  <chapter number="10" style="c" sid="NUM 10"/>
  <para style="s1">ብራ ብራታፐ ኦሰትዳ ሞይዘታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 10:1"/><verse number="2" style="v" sid="NUM 10:2"/>አሳ ሺቆስ ፄጋናዉነ ዱንካንዳ ጉታፐ ደንናዉ ማድያ ናምኡ ሞይዘታ ብራፐ ቆፃዳ መ። <verse eid="NUM 10:2"/><verse number="3" style="v" sid="NUM 10:3"/>ሀ ናምኡ ሞይዘት ፑነትያ ዎደ አሳ ኡባይ ጌሻ ዱንካንያ ፐንገን ኔኮ ሺቆ። <verse eid="NUM 10:3"/><verse number="4" style="v" sid="NUM 10:4"/>ሽን እስ ሞይዘ ፃላል ፑነትኮ፥ እስራኤለ ኮቻ ሀላቃት ነ ስን ሺቆ። <verse eid="NUM 10:4"/><verse number="5" style="v" sid="NUM 10:5"/>ሞይዘይ ኮይሮ ፑነትያ ዎደ ጌሻ ዱንካንያፐ ዶሎሀ ባጋን ዱንካንዳ ኮቻይ ደንዶ። <verse eid="NUM 10:5"/><verse number="6" style="v" sid="NUM 10:6"/>ሞይዘይ ናምአን ፑነትያ ዎደ ዱገሀ ባጋን ዱንካንዳ ኮቻይ ደንዶ። ሞይዘይ ሄሳ ፑነትያ ዎደ ጉታፐ ደንዳናዉ ማላ ግዶ። <verse eid="NUM 10:6"/><verse number="7" style="v" sid="NUM 10:7"/>አሳ ሺሻናዉ ሞይዘ ፑና፥ ሽን ሀንኮይሳዳ ዱማ ማላራ ፑኖፋ። <verse eid="NUM 10:7"/><verse number="8" style="v" sid="NUM 10:8"/>ካህነት፥ አሮና ናይት ሞይዘ ፑኖ። ሀይስ ነዉነ ያና የለተ ኡባስ መርና ዎጋ ግዶ።<verse eid="NUM 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 10:9"/>“ህንተ ጋድያ ቦላ ኦላ ደንዳ ህንተ ሞርክያራ ህንተ ኦለታናዉ ከይያ ዎደ ሄ ሞይዘታ ጎችድ ፑንተ። ሄ ዎደ ጎዳይ፥ ህንተ ፆሳይ ህንተና አኬክድ፥ ህንተ ሞርከታፐ አሻና። <verse eid="NUM 10:9"/><verse number="10" style="v" sid="NUM 10:10"/>ህንተ ኡፋይሳ ጋላሳታን ሄስካ አጌና ፄሮን፥ ኤረትዳ ባለታን፥ ፁሳ ያርሾ ዎደንነ እስፈተ ያርሾ ዎደ ሞይዘ ፑንተ። ሄስ ፆሳ ስንን ህንተና አኬክስያባ ግዳና። ታኒ ጎዳ፥ ህንተ ፆሳ” ያግስ።<verse eid="NUM 10:10"/></para>
  <para style="s1">እስራኤለት ሲና የድድ ደንዱዋ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11"/>አሳይ ግብፀፈ ከይን፥ ናምአን ላይን፥ ናምአን አጌናን፥ ላታማን ጋላሳን፥ ሻራይ ጌሻ ዱንካንያ ቦላፈ ደንድስ። <verse eid="NUM 10:11"/><verse number="12" style="v" sid="NUM 10:12"/>ያትን አሳይ ሲና መላ ቢታፈ ማራን ማራን ደንድዶሶና፤ ሻራይ ፓራና መላ ቢታ ጋክድ ዎስ። <verse eid="NUM 10:12"/><verse number="13" style="v" sid="NUM 10:13"/>ጎዳይ ሙሰ ኪትዳይሳዳ ኤንቲ ባናዉ ኮይሮ ደንድዶሶና።<verse eid="NUM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14"/>ኮይሮ ይሁዳ ኮቻ ባጋን ዱንካንዳ ኮቻይ ባንታ ማላ ኤክድ ከይዶሶና። ኤንታና ካለይ አምናዳበ ናኣ ናአሶና። <verse eid="NUM 10:14"/><verse number="15" style="v" sid="NUM 10:15"/>ይሳኮራ ኮቻ ካለይ ዙአራ ናኣ ናትናኤላ። <verse eid="NUM 10:15"/><verse number="16" style="v" sid="NUM 10:16"/>ዛብሎና ኮቻ ካለይ ሄሎና ናኣ ኤልኣባ።<verse eid="NUM 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 10:17"/>ያትን፥ ጌሻ ዱንካነይ ሾደትን፥ ገድሶና ኮቻትነ መራራ ኮቻት ቶክድ ደንድዶሶና።<verse eid="NUM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18"/>ካልድ ሮቤላ ኮቻ ባጋን ዱንካንዳ ኮቻይ ባንታ ማላ ኦይክደ ከይዶሶና። ሮቤላ ኮቻ ካለይ ሻደኡራ ናኣ ኤልዙራ። <verse eid="NUM 10:18"/><verse number="19" style="v" sid="NUM 10:19"/>ስሞና ኮቻ ካለይ ዙርሻዳያ ናኣ ሳሉምኤላ። <verse eid="NUM 10:19"/><verse number="20" style="v" sid="NUM 10:20"/>ጋደ ኮቻ ካለይ ራጉኤላ ናኣ ኤልያሳፋ።<verse eid="NUM 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 10:21"/>ያትን ቃሃታ ኮቻይ ጌሻ ሚሸታ ቶክድ ደንድዶሶና። ኤንቲ ካልያ ጉታ ጋካናፐ ስን ጌሻ ዱንካነይ ቶከትድ ኡቴስ።<verse eid="NUM 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22"/>ካልድ ኤፍሬማ ኮቻ ባጋን ዱንካንዳ ኮቻት ባንታ ማላ ኦይክድ ከዮሶና። ኤፍሬማ ኮቻ ካለይ አምሁዳ ናኣ ኤልሻማአ። <verse eid="NUM 10:22"/><verse number="23" style="v" sid="NUM 10:23"/>ምናሰ ኮቻ ካለይ ፓዳዙራ ናኣ ጋማልኤላ። <verse eid="NUM 10:23"/><verse number="24" style="v" sid="NUM 10:24"/>ብንያመ ኮቻ ካለይ ጋድዮና ናኣ አብዳና።<verse eid="NUM 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25"/>ዉርሰን ዳነ ኮቻ ባጋን ዱንካንዳ ኮቻይ፥ ኡባስ ጉየ ባጋራ ካተ ግድድ፥ ባንታ ማላ ኦይክድ ከይዶሶና። ዳነ ኮቻ ካለይ አምሳዳያ ናኣ አክኤዘራ። <verse eid="NUM 10:25"/><verse number="26" style="v" sid="NUM 10:26"/>አሴራ ኮቻ ካለይ ኦክራና ናኣ ፓግኤላ። <verse eid="NUM 10:26"/><verse number="27" style="v" sid="NUM 10:27"/>ንፍታለመ ኮቻ ካለይ ኤናና ናኣ አክራ። <verse eid="NUM 10:27"/><verse number="28" style="v" sid="NUM 10:28"/>እስራኤለ አሳይ ባንታ ዘረን ዘረን ጉታፐ ደንድድ ብያ ማራይ ሄሳ።<verse eid="NUM 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29"/>ሙሰይ ምድያመ አድያ ራጉኤላ ናኣ ሆባባኮ፥ “ጎዳይ ኑስ እማና ግዳ ቢታ ላታናዉ ቦስ፤ ጎዳይ እስራኤለ አንጃና ግዳ ግሾ ኑራ የ፤ ኑኒ ነዉ ሎኦባ ኦና” ያግስ።<verse eid="NUM 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30"/>ያትን ሆባብ፥ “አካይ፥ ታኒ ታ ቢታ ታ ዳቦታኮ ባና” ያግስ።<verse eid="NUM 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31"/>ሙሰይ ዛሪድ፥ “ሀያና፥ ኑና የጋዳ ቦፓ። ኑ ብያ መላ ቢታን ኑኒ ዱንካናና በሳ ነ ኤራሳ፤ ኑ ባና ኦግያ ኑና ካለናዉ ዳንዳኣሳ። <verse eid="NUM 10:31"/><verse number="32" style="v" sid="NUM 10:32"/>ኔኒ ኑራ ቢኮ፥ ጎዳይ ኑስ እምያ አንጁዋ ኡባ ኑ ኔው ሻካና” ያግስ።<verse eid="NUM 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33"/>አሳይ ጎዳ ዙማፐ ደንድድ፥ ሄ ጋላሳ ኦገ ብዶሶና። ጎዳ ጫቆ ታቦተይ ኤንቲ ሸምፓና በሲ ኮይሸ ሄ ጋላስ ኤንታፈ ስን ስን ብስ። <verse eid="NUM 10:33"/><verse number="34" style="v" sid="NUM 10:34"/>ኤንቲ ዱንካንዳ ጉታፐ ደንድያ ዎደ ኡባን ጎዳ ሻራይ ጋላስ ጋላስ ኤንታፈ ቦላራ ደኤስ። <verse eid="NUM 10:34"/><verse number="35" style="v" sid="NUM 10:35"/>ታቦተይ ደንድያ ዎደ ኡባን ሙሰይ፥ “አቤት ጎዳዉ፥ ደንዳ፤ ነ ሞርከት ላለቶ፤ ነና እፀይሳት ነ ስንፈ ባቃቶ” ያጌስ። <verse eid="NUM 10:35"/><verse number="36" style="v" sid="NUM 10:36"/>ታቦተይ ሸምፕያ ዎደ ኡባን ሙሰይ፥ “አቤት ጎዳዉ፥ ዳሮ ሙኩላን ታይበትያ እስራኤለ አሳኮ ስማ” ያጌስ።<verse eid="NUM 10:36"/></para>
  <chapter eid="NUM 10"/>
  <chapter number="11" style="c" sid="NUM 11"/>
  <para style="s1">ጎዳፐ ይዳ ታማ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1"/>እስራኤለ አሳይ ባንታና ጋክዳ መቱዋን ጎዳ ቦላ ዙዙምዶሶና። ኤንታ ዙዙን ጎዳይ ስእዳ ዎደ እያ ሀንቆይ ኤፅን፥ ፁግያ ታማ ኤንታ ቦላ የድስ፤ ሄ ታማይ ኤንቲ ዱንካንዳ ጉታፐ እስ ባጋ ጋፃ ምስ። <verse eid="NUM 11:1"/><verse number="2" style="v" sid="NUM 11:2"/>ያትን ሙሰይ ኤንታ ግሾ ጎዳ ዎሳና መላ ኤንቲ ሙሰኮ ይድ ዬክዶሶና። ሙሰይ ዎስን ታማይ ቶእስ። <verse eid="NUM 11:2"/><verse number="3" style="v" sid="NUM 11:3"/>ጎዳ ታማይ ኤንታ ግዶን ኤፅዳ ግሾ፥ ሄ በሳይ ታቤራ<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="fq" closed="false">ታቤራ፦ </char><char style="ft" closed="false">ጉሳይ “ታማ ፁስ” ጉሱ።</char></note> ጌተትድ ፄገትስ።<verse eid="NUM 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4"/>እስራኤለታራ ግብፀፈ ከይዳ ዱማ ዱማ ደረይ ሀራ ካ ማናዉ ዳሮ አሞትዶሶና። ኤንቲ፥ “ኑ አሾ አዉፐ ደማኔ? <verse eid="NUM 11:4"/><verse number="5" style="v" sid="NUM 11:5"/>ኑኒ ግብፀን ደእያ ዎደ ሚሸ ቃንፆና ምያ ሞሉዋ፥ ሌህያ፥ ሀባበ፥ ሹንኩርተ፥ ምስካት ባይና ሹንኩርተነ ቱሙዋ ሀሳዮስ። <verse eid="NUM 11:5"/><verse number="6" style="v" sid="NUM 11:6"/>ሽን ሀእ ኑ ቆይ ጎርደትስ፤ ኑ አይፈይካ ሀ ማናፈ አትሽን፥ ሀራባ አይባካ በኤና” ያግድ ዬክዶሶና።<verse eid="NUM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7"/>ማናይ ዴቦ አይፈ ዳኔስ፤ እያ ማላይ ቦ አድልኤ ጪሸ ዳኔስ። <verse eid="NUM 11:7"/><verse number="8" style="v" sid="NUM 11:8"/>ማናይ ቃማ ዎስ፤ አሳይ ዩይድ እያ ማፅድ ዎፃን ጋጭድ ዎይኮ ኡዱላን ጫድድ ካሶና። ያትድ ኡኮሶና፤ እያ ማልኦይ ሻማሆ ዛይተራ ኡከትዳ ኡይ መላ። <verse eid="NUM 11:8"/><verse number="9" style="v" sid="NUM 11:9"/>ማን ቃማ ኤንታ ጉታን አካራ ዎስ።<verse eid="NUM 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10"/>አሳይ ባንታ ዱንካንያ ፐንገን ፐንገን ኤቅድ ዬክሽን ሙሰይ ስእስ። ኤንቲ ጎዳ ሀንቁዋ ደንዳ ግሾ፥ ሙሰይ ኡንኤትስ። <verse eid="NUM 11:10"/><verse number="11" style="v" sid="NUM 11:11"/>ሙሰይ ጎዳኮ፥ “ነ አይልያ፥ ታ ቦላ አይስ ሀ መቱዋ ኤሀዲ? ነ ታናን አይስ ኡፋይታብኪ? ነ ሀ አሳ ኡባ ቶሁዋ ታ ቦላ አይስ ዎዲ? <verse eid="NUM 11:11"/><verse number="12" style="v" sid="NUM 11:12"/>ሀ አሳ ኡባ ታ ቃንታድናዬ? ዎይኮ ኤንታ ታ የላድናዬ? ነ ኤንታ ማይዛታስ፥ እማና ጋዳ ጫቅዳ ቢታ ጋ ጋዳ ናአ እድማዳ ድችያ አሴዳ ታ ክኦን አይስ ኤንታ የጋዲ? <verse eid="NUM 11:12"/><verse number="13" style="v" sid="NUM 11:13"/>ሀ አሳ ኡባስ ታ አሾ አዉፐ ኤሀኔ? ኤንቲ ታኮ ይድ፥ ‘ማናዉ ኑስ አሾ እማ’ ያግድ ዬኮሶና። <verse eid="NUM 11:13"/><verse number="14" style="v" sid="NUM 11:14"/>ታኒ ሀ አሳ ኡባ ታርካ ቶካናዉ ዳንዳእከ፤ ታዉ ሄስ ዴፆ ቶሆ። <verse eid="NUM 11:14"/><verse number="15" style="v" sid="NUM 11:15"/>ህዛ ኔኒ ታና ሀይሳዳ ኦናፐ ታዉ ቃታ፤ ሀእ ታና ዎ፤ ሀ መቱዋፐ ታ ሸምፓ አጋና” ያግስ።<verse eid="NUM 11:15"/></para>
  <para style="s1">ላፑን ታሙ አሳ ዶረተ</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16"/>ጎዳይ ሙሰኮ፥ “አሳ ካለናዉ ዳንዳእያ እስራኤለ ሀላቃታፐ ላፑን ታሙ ጭማታ ዶራ። ኤንታ ጌሻ ዱንካንያኮ ኤሀዳ ነ ማታን ኤሳ። <verse eid="NUM 11:16"/><verse number="17" style="v" sid="NUM 11:17"/>ታኒ ዎዳ ኔራ ያን ኦደታና፤ ታ ነዉ እምዳ አያናፐ ሻካዳ ኤንታ ቦላ ዎና። ኔኒ አሳ ቶሁዋ ነርካ ቶኮና መላ ኤንቲ ነና ማዳና።<verse eid="NUM 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18"/>“ኔኒ አሳኮ ሀይሳዳ ያጋ፤ ‘ዎንቶ ህንተ አሾ ማና ግሾ ህንተና ጌሽተ። ኑ አሾ አዉፐ ደማኔ? ኑስ ግብፀን ሳእ ሎኦሽን’ ያግድ ህንተ ዬክዳ ዬሁዋ ጎዳይ ስእስ። ሀእ ጎዳይ አሾ እማና፤ ህንተካ ማና። <verse eid="NUM 11:18"/><verse number="19" style="v" sid="NUM 11:19"/>ህንተ ማናይ እስ ጋላስ ዎይኮ ናምኡ ጋላስ ዎይኮ እቻሹ ጋላስ ዎይኮ ታሙ ጋላስ ዎይኮ ላታሙ ጋላስ ፃላላ ግደና። <verse eid="NUM 11:19"/><verse number="20" style="v" sid="NUM 11:20"/>ሽን ‘ህንተ ግዶን ደእያ ጎዳ ህንተ ካዳ ግሾነ ግብፀፈ ከዮና አትዳኮ ኑስ ሎኦሽን ግዳ ግሾ፥ ህንተዉ ሲራ ከያና ጋካናዉነ ህንተ ሳለታና ጋካናዉ እስ አጌና ኩመ ህንተ አሾ ማና’ ያጋ” ያግስ።<verse eid="NUM 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21"/>ሽን ሙሰይ ጎዳኮ፥ “ሄኮ፥ ታ 600,000 አሳ ካለሸ ደአይስ። ኔኒ እስ አጌና ኩመ ኤንቲ አሾ ማና መላ እማና ጋሳ። <verse eid="NUM 11:21"/><verse number="22" style="v" sid="NUM 11:22"/>ሚዛ ዉደነ ዶርሳ ዉደ ኡባ ሹክን ኤንታዉ ግዳኔ? አባን ደእያ ሞሎ ኡባ ሺሽያኮ ኤንታዉ ግዳኔ?” ያግስ።<verse eid="NUM 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23"/>ያትን፥ ጎዳይ ሙሰኮ፥ “ጎዳ ኩሸይ ቃንዬ? ታኒ ነዉ ኦድያባይ ቱሜኮነ ዎርዶኮ ኔኒ ሀእ በአና” ያግስ።<verse eid="NUM 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24"/>ሄሳ ግሾ ሙሰይ ካረ ከይድ፥ ጎዳይ ግዳይሳ አሳስ ኦድስ። እስራኤለ ጭማታፐ ላፑን ታሙ አሳ ሺሽድ፥ ጌሻ ዱንካንያ ዩሾን ኤስስ። <verse eid="NUM 11:24"/><verse number="25" style="v" sid="NUM 11:25"/>ያትን፥ ጎዳይ ሻራራ ዎድ እያራ ኦደትስ፤ እያ ቦላ ደእያ አያናፐ ኤክድ፥ ሄ ላፑን ታሙ ጭማታ ቦላ ዎስ። አያናይ ኤንታ ቦላ ሸምፕዳ ዎደ ኤንቲ ናበዳ ትንብተ ኦድዶሶና። ሽን ሄሳፈ ጉየ ዛሪድ ትንብተ ኦድቦኮና።<verse eid="NUM 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26"/>ሄ ላፑን ታሙ ጭማታራ ፃፈትዳ አሳታፐ ኤልዳዳነ ሞዳዳ ጌተትያ ናምአት ዱንካንዳ ጉታን አትድ ጌሻ ዱንካንያኮ ይቦኮና። ሽን ኤንታ ቦላካ አያናይ ዎን፥ ዱንካንዳ ጉታን ትንብተ ኦድዶሶና። <verse eid="NUM 11:26"/><verse number="27" style="v" sid="NUM 11:27"/>እስ ፓን አደይ ሙሰኮ ዎፅ ይድ፥ “ኤልዳድነ ሞዳድ ዱንካንዳ ጉታን ትንብተ ኦዶሶና” ያግስ።<verse eid="NUM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 11:28"/>ያንን፥ ባ ናአተፈ ዶምድ፥ ሙሰ ማድያ ናወ ናኣ እያሱይ ሙሰኮ፥ “ታ ጎዳዉ፥ ሙሰ፥ ኤንታ ተቃ” ያግስ።<verse eid="NUM 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29"/>ሽን ሙሰይ ዛሪድ፥ “ታ ግሾ ነ ቃናታይ? ጎዳይ ባ አሳ ኡባ ቦላ ባ አያና ዎድ ናበዳ ትንብተ ኦድስያባ ግድያኮ ታ ኡፋይታይስ” ያግስ። <verse eid="NUM 11:29"/><verse number="30" style="v" sid="NUM 11:30"/>ያትድ፥ ሙሰይነ እስራኤለ ጭማት ዱንካንዳ ጉታ ስምዶሶና።<verse eid="NUM 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31"/>ቆፖና ጎዳይ ጫርኮ ደንድ፥ ሳአፐ ናምኡ ዋ መላ ቁ ግድ ፕራያ ኩራቾታ አባፈ ኤህስ። ኤንታ ዱንካንያ ዩሹዋን ኡባ ባጋራ እስ ጋላሳ ኦገ መላ ሳአን ዎዶሶና። <verse eid="NUM 11:31"/><verse number="32" style="v" sid="NUM 11:32"/>ሄ ጋላስነ ሄ ቃማ ኡባ፥ ቃስ ዎንተ ጋላስካ አሳይ ካረ ከይድ፥ ሄ ኩራቾታ ኦይክድ ሺሽዶሶና። ኤንታፈ ኦንካ 10 ክሎ ግራመፐ ጉ ሺሽበና። ኤንቲ ዱንካንያ ጉታ ዩሾን መልሳናዉ ምጭዶሶና። <verse eid="NUM 11:32"/><verse number="33" style="v" sid="NUM 11:33"/>ሽን አሾይ ቡሮ ኤንታ ዶናን ደእሽንነ ሜተትድ ዉሮና ደእሽን፥ ጎዳ ሀንቆይ አሳ ቦላ ኤፅስ፤ ጎዳይ አሳ ዎልቃማ ቦሻን ሾጭስ። <verse eid="NUM 11:33"/><verse number="34" style="v" sid="NUM 11:34"/>አሾ አሞትድ ሀይቅዳ አሳ ኤንቲ ሄ በሳን ሞግዳ ግሾ ሄ በሳይ ከብሮት-ሀታባ<note caller="+" style="f"><char style="fr" closed="false">11:34 </char><char style="fq" closed="false">ከብሮት-ሀታባ፦ ሀ ሱን ብርሸይ “አሞ ዱፎ” ጉሱ።</char></note> ጌተትድ ሱንትስ። <verse eid="NUM 11:34"/><verse number="35" style="v" sid="NUM 11:35"/>አሳይ ሄ በሳፈ ደንድ ብድ ሀፀሮታ ጌተትያ በሳን ዱንካንዶሶና።<verse eid="NUM 11:35"/></para>
  <chapter eid="NUM 11"/>
  <chapter number="12" style="c" sid="NUM 12"/>
  <para style="s1">አሮንነ ማይራማ ሙሰራ ኤቀትዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1"/>ሙሰይ ቶጰ ቢታ ማጫስ ኤክዳ ግሾ፥ ማይራማነ አሮን ሙሰ ያግድ ቦርዶሶና። <verse eid="NUM 12:1"/><verse number="2" style="v" sid="NUM 12:2"/>“ጎዳይ ሙሰ ባጋራ ፃላላ ኦደትዴ? እ ኑ ባጋራ ኦድቤኔ?” ያግዶሶና። ጎዳይ ኤንቲ ግዳይሳ ስእስ። <verse eid="NUM 12:2"/><verse number="3" style="v" sid="NUM 12:3"/>ሙሰይ ቢታን ደእያ አሳ ኡባፈ አያ አዳ አስ።<verse eid="NUM 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4"/>ቆፖና ጎዳይ ሙሰ፥ አሮናነ ማይራሞ፥ “ህንተ ሄት ጌሻ ዱንካንያኮ ከይተ” ያግስ። ኤንትካ ከይዶሶና። <verse eid="NUM 12:4"/><verse number="5" style="v" sid="NUM 12:5"/>ጎዳይ ሻራ ቱሳራ ዎድ ጌሻ ዱንካንያ ፐንገን ኤቅድ፥ አሮና! ማይራመ! ያግድ ፄግስ። ኤንቲ ናምአይ እያ ስን ሺቅን፥ <verse eid="NUM 12:5"/><verse number="6" style="v" sid="NUM 12:6"/>ጎዳይ፥ “ታ ኦደይሳ ስእተ፤ ህንተ ግዶን ናበይ ደእኮ፥ ታ እያዉ ቆንጫይስ፤ ቃስ እያዉ አሙሆን ኦዳይስ። <verse eid="NUM 12:6"/><verse number="7" style="v" sid="NUM 12:7"/>ሽን ታ አይለይ ሙሰ ሄሳዳ ግደና፤ እ ታ ኬ ኡባን አማነትዳይሳ። <verse eid="NUM 12:7"/><verse number="8" style="v" sid="NUM 12:8"/>ታኒ ሙሰራ ሶምኦን ኦደታስፐ አትሽን፥ ሌምሶን ኦድከ። እ ታ ማላ በኤስ። ያትን፥ ህንተ ታ አይልያ ሙሰ ቦራናዉ አይስ ያይበከቲ?” ያግስ።<verse eid="NUM 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9"/>ጎዳ ሀንቆይ ኤንታ ቦላ ኤፅን፥ እ ኤንታ አግድ ብስ። <verse eid="NUM 12:9"/><verse number="10" style="v" sid="NUM 12:10"/>ሻራይ ጌሻ ዱንካንያ ቦላፈ ደንድዳ ዎደ ማይራማ ባሮ ሀርገን ምልፅ ጋዳ ቦፃሱ። አሮን ኢኮ ስሚድ ፄልያ ዎደ ባሮ ሀርገን ኦይከትዳሮ በእስ። <verse eid="NUM 12:10"/><verse number="11" style="v" sid="NUM 12:11"/>አሮን ሙሰኮ፥ “ሀይ ታ ጎዳዉ፥ ኑኒ ኤያተን ኦዳ ናጋራስ ኑና ሀይሳዳ ሴሮፓ። <verse eid="NUM 12:11"/><verse number="12" style="v" sid="NUM 12:12"/>እዮ ባ አየ ኡሎፐ ከይያ ዎደ እ አሳተፈ ባጋይ ሜተትን፥ ሀይቅድ የለትዳ ናአ መላ ኦፋ” ያግስ።<verse eid="NUM 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13"/>ያትን፥ ሙሰይ፥ “አቤት ጎዳዉ፥ እዮ ፓርክ” ያግድ ጎዳ ዎስስ።<verse eid="NUM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14"/>ጎዳይ ሙሰኮ፥ “እ አዋይ እ ሶምኦን ጩትያባ ግድያኮ፥ እያ ላፑን ጋላስ ዬላራ ጋምአዉሱ ግድኬ? ሄሳ ግሾ፥ ላፑን ጋላስ ዱንካንያ ጉታፐ እዮ ጋፃ ከሳዳ ዱማ በሳን ዎ፤ ሄሳፈ ጉየ ስማዳ ዮ” ያግስ። <verse eid="NUM 12:14"/><verse number="15" style="v" sid="NUM 12:15"/>ያትን፥ ማይራማ ዱንካንያ ጉታፐ ጋፃ ከያዳ ላፑን ጋላስ ኡታሱ። እያ ስማና ጋካናዉ አሳይ ጉታ አግድ ባናዉ ደንድቤና። <verse eid="NUM 12:15"/><verse number="16" style="v" sid="NUM 12:16"/>ሄሳፈ ጉየ፥ አሳይ ሀፀሮታ ጌተትያ በሳፈ ደንድድ፥ ፓራና መላ ቢታን ዱንካንዶሶና።<verse eid="NUM 12:16"/></para>
  <chapter eid="NUM 12"/>
  <chapter number="13" style="c" sid="NUM 13"/>
  <para style="s1">ካናነ ዎቻናዉ ኪተትዳ አሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 13:1"/><verse number="2" style="v" sid="NUM 13:2"/>“ታኒ እስራኤለታስ እማና ካናነ ቢታ ዎቻና መላ ታማነ ናምኡ እስራኤለ ኮቻፈ እስ እስ አስ ሀላቃ ኦዳ ኪታ” ያግስ።<verse eid="NUM 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 13:3"/>ያትን ሙሰይ ጎዳይ ኪትዳይሳዳ ፓራና መላ ቢታፈ እስራኤለ ኮቻፈ ታማነ ናምኡ ሀላቃታ ኪትስ። <verse eid="NUM 13:3"/><verse number="4" style="v" sid="NUM 13:4"/>ኤንታ ሱንይ ሀይሳፈ ካልድ ፃፈትዳይሳታ።</para>
  <para style="li1" vid="NUM 13:4">ሮቤላ ኮቻፈ ዛኩራ ናኣ ሳሙአ፤<verse eid="NUM 13:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 13:5"/>ስሞና ኮቻፈ ሆራ ናኣ ሻፋፃ፤<verse eid="NUM 13:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 13:6"/>ይሁዳ ኮቻፈ ዮፎና ናኣ ካለባ፤<verse eid="NUM 13:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 13:7"/>ይሳኮራ ኮቻፈ ዮሰፋ ናኣ ይግኣላ፤<verse eid="NUM 13:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 13:8"/>ኤፍሬማ ኮቻፈ ናወ ናኣ አውሰ፤<verse eid="NUM 13:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 13:9"/>ብንያመ ኮቻፈ ራፉ ናኣ ፋልፃ፤<verse eid="NUM 13:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 13:10"/>ዛብሎና ኮቻፈ ሶዳ ናኣ ጋድኤላ፤<verse eid="NUM 13:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 13:11"/>ዮሰፋ ናኣ ምናሰ ኮቻፈ ሱሳ ናኣ ጋደ፤<verse eid="NUM 13:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 13:12"/>ዳነ ኮቻፈ ጋማላ ናኣ አምኤላ፤<verse eid="NUM 13:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 13:13"/>አሴራ ኮቻፈ ምካኤላ ናኣ ሳቱራ፤<verse eid="NUM 13:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 13:14"/>ንፍታለመ ኮቻፈ ዋፍሳ ናኣ ናህባ፤<verse eid="NUM 13:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 13:15"/>ጋደ ኮቻፈ ማካ ናኣ ገኡኤላ።<verse eid="NUM 13:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 13:16"/>ሄ ቢታ ዎቻና መላ ሙሰይ ኪትዳ አሳታ ሱንይ ሀይሳታ። ሙሰይ ናወ ናኣ አውሰ ሱን እያሱ ግድ ሱን ላምስ።<verse eid="NUM 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17"/>ሙሰይ ኤንታ፥ “ነገበ መላ ቢታ ካንድ ፑደ ደረይ ዳርያ ቢታ ከይተ። <verse eid="NUM 13:17"/><verse number="18" style="v" sid="NUM 13:18"/>ቢታይ አይ መላ ቢታኮ፥ አሳይ አይ መላ ምኖኮነ ታይቦን ጉኮ ዳሮኮ በእተ። <verse eid="NUM 13:18"/><verse number="19" style="v" sid="NUM 13:19"/>ኤንቲ ደእያ ቢታይ ሎኦኮ ኢተኮ፥ ኤንታ ካታማት ድረትዳኮነ መላ ደእያኮ፥ <verse eid="NUM 13:19"/><verse number="20" style="v" sid="NUM 13:20"/>ቢታይ አራደኮ ላደኮ፥ ቢታይ ዎራን ካመትዳኮነ ቁኤኮ በእተ። ምንተ፤ ሄ ቢታን ደእያ ካ አይፍያፐ ኤኮና ዮፕተ” ያግስ። ሄ ዎደይ ዎይነይ ቴርድ ማፀትያ ዎደ።<verse eid="NUM 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21"/>ኤንቲ ከይድ ሲና መላ ቢታፈ ዶምድ፥ ለቦ-ሀማታ ማታን ደእያ ረሆባ ጋካናዉ ደእያ ቢታ ዎችዶሶና። <verse eid="NUM 13:21"/><verse number="22" style="v" sid="NUM 13:22"/>ነገበ መላ ቢታ ካንድ፥ ከብሮና ጋክዶሶና። ሄ በሳን አክማና፥ ሰሳያነ ታልማያ ጌተትያ ኤናቃ ኮቻት ደኦሶና። ከብሮን ግብፀን ደእያ ፆኣነ ካታማፐ ላፑን ላይ ኮይሮትድ ኬፀትስ።<verse eid="NUM 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 13:23"/>ያራ ካንድ፥ ኤሽኮላ ዛንጋራ ብድ ጋክያ ዎደ ቴራ ዎይነ ታሽያራ ቃንፅዶሶና። ሄ ታሸይ ዴፆ ግድያ ግሾ ናምኡ አስ ካሶ አድ ቶክዶሶና። እያ ቦላ ጉጅድ ኦሮማነነ ባላሰ ም አይፈ ኤክድ ይዶሶና። <verse eid="NUM 13:23"/><verse number="24" style="v" sid="NUM 13:24"/>እስራኤለ አሳይ ሄ በሳፈ ዎይነ ታሽያ ቃንፅዳ ግሾ ሄ በሳ ኤሽኮላ ዛንጋራ ግድ ፄግዶሶና።<verse eid="NUM 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 13:25"/>ኤንቲ ሄ ቢታ ኦይታሙ ጋላስ ዎችድ ጉየ ስምዶሶና። <verse eid="NUM 13:25"/><verse number="26" style="v" sid="NUM 13:26"/>ፓራና መላ ቢታን ቃደሳን ደእያ ሙሰኮ፥ አሮናኮነ እስራኤለ ማባራ ኡባኮ ይዶሶና። ኤንቲ በእዳባ አሳ ኡባስ ኦድዶሶና፤ ሄ ቢታፈ ኤክድ ይዳ አይፍያካ ኤንታ በስዶሶና።<verse eid="NUM 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 13:27"/>ኤንቲ ሙሰኮ፥ “ኔኒ ኑና የድዳ ቢታ ብዳ፤ ሄ ቢታን ማነ ኤስ ጎጌስ፤ ሄ ቢታ አይፍያካ ሀይሳ በአ። <verse eid="NUM 13:27"/><verse number="28" style="v" sid="NUM 13:28"/>ሽን ሄ ቢታን ደእያ አሳይ ዎልቃማ፤ ኤንታ ካታማትካ ግምበ ድርሳን ድረትዳይሳታነ ግታ። ኑኒ ኡባፈ አድ ኤናቃ ኮቻታ ያን በእዳ። <verse eid="NUM 13:28"/><verse number="29" style="v" sid="NUM 13:29"/>አማለቃት ነገበ መላ ቢታን፤ ህተትነ፥ ያቡሰት ደረይ ዳርያ አሞረታ ቢታን፤ ቃስ ካናነት መደትራነ አባ ዶናንነ ዮርዳኖሰ ሻፋ ጋፃን ደኦሶና” ያግዶሶና።<verse eid="NUM 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30"/>ያትን ካለብ አሳ ሙሰ ስንን ስእ ኦድ፥ “ኑኒ ፆናናዉ ዳንዳእያ ግሾ፥ ሀእ ከይድ ሄ ቢታ የግስድ አነ ኦይኮስ” ያግስ።<verse eid="NUM 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31"/>ሽን ካለባራ ብዳ አሳት፥ “ሄ ቢታ አሳይ ኑፐ አድ ምንያ ግሾ፥ ኑኒ ኤንታ ፆናናዉ ዳንዳኦኮ” ያግዶሶና። <verse eid="NUM 13:31"/><verse number="32" style="v" sid="NUM 13:32"/>ኤንቲ ዩይድ ዎችዳ ቢታባ እስራኤለ አሳስ ሀይሳዳ ያግድ ኢታ ኦዳ ኦድዶሶና። “ኑኒ ዎችዳ ቢታይ ያን ደእያ አሳካ ምያ ቢታ፤ ያን ደእያ አሳይካ ዳሮ አዱሰ። <verse eid="NUM 13:32"/><verse number="33" style="v" sid="NUM 13:33"/>ኑኒ ያን ኤናቃ ኮቸ ግድዳ ንፍልመ አሳታ በእዳ። ኤንታ በእዳ አይፈን ኑና ፄልያ ዎደ ኑኒ ፃቆ መላ፤ ኤንትካ ኑና ሄሳዳ በኦሶና” ያግዶሶና።<verse eid="NUM 13:33"/></para>
  <chapter eid="NUM 13"/>
  <chapter number="14" style="c" sid="NUM 14"/>
  <para style="s1">አሳ ዙዙን</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1"/>ሄ ዎደ ቃማ ማባራ ኡባይ ባንታ ቃላ ቁ ኦድ ዬክዶሶና። <verse eid="NUM 14:1"/><verse number="2" style="v" sid="NUM 14:2"/>እስራኤለ አሳይ ሙሰ ቦላነ አሮና ቦላ ዙዙምዶሶና። ኩመ ማባራይ፥ “ኑኒ ግብፀ ቢታን ደእሸ ዎይኮ ሀ መላ ቢታን ሀይቅዳ ግዶርኮ። <verse eid="NUM 14:2"/><verse number="3" style="v" sid="NUM 14:3"/>ኑኒ ማሻን ዉራና መላ ጎዳይ ሀ ቢታ ኑና አይስ ኤሂ? ኑ ማቸትነ ኑ ናይት ድኤታና፤ ሄሳ ሀናናፐ ጉየ ግብፀ ስሞይ ኑስ ኬሄኔ?” ያግዶሶና። <verse eid="NUM 14:3"/><verse number="4" style="v" sid="NUM 14:4"/>ኤንቲ እሶይ እሱዋኮ፥ “ኑና ካለያ አስ ዶርድ ጉየ ግብፀ ስሞስ” ያግዶሶና።<verse eid="NUM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5"/>ያትን፥ ሙሰይነ አሮን ሄ በሳን ሺቅዳ እስራኤለ ማባራ ስንን ሶምኦራ ሳአን ጉፋንዶሶና። <verse eid="NUM 14:5"/><verse number="6" style="v" sid="NUM 14:6"/>ቢታ ዎቻናዉ ብዳ አሳ ግዶፈ ናወ ናኣ እያሱይነ ዮፎና ናኣ ካለብ ባንታ ማኡዋ ፔዶሶና። <verse eid="NUM 14:6"/><verse number="7" style="v" sid="NUM 14:7"/>እስራኤለ ማባራኮ፥ “ኑኒ ካን ከይድ ዎችዳ ቢታይ ዳሮ ሎኦ። <verse eid="NUM 14:7"/><verse number="8" style="v" sid="NUM 14:8"/>ጎዳይ ኑናን ኡፋይትያባ ግድኮ ማነ ኤስ ጎግያ ቢታ ኑና ገልሳና፤ ሄ ቢታ ኑስ እማና። <verse eid="NUM 14:8"/><verse number="9" style="v" sid="NUM 14:9"/>ሄሳ ግሾ፥ ጎዳ ቦላ ማካሎፍተ። ሄ ቢታ አሳስ ያዮፍተ፤ ኤንቲ ኑስ ኦይካ ግዶኮና። ኤንታዉ ኤሾይ ባዋ፤ ጎዳይ ኑራ ደኤስ፤ ህንተ ኤንታዉ ያዮፍተ” ያግዶሶና። <verse eid="NUM 14:9"/><verse number="10" style="v" sid="NUM 14:10"/>ያትን እስራኤለ ማባራይ ኤንታ ሹቻን ጫዳናዉ ደንድስ።</para>
  <para style="p" vid="NUM 14:10">ሄ ዎደ ጎዳ ቦንቾይ ፆሳ ዱንካንያን እስራኤለ አሳ ኡባስ ቆንጭስ። <verse eid="NUM 14:10"/><verse number="11" style="v" sid="NUM 14:11"/>ጎዳይ ሙሰኮ፥ “ሀ አሳይ ታና ካይ አዉደ ጋካናሴ? ታኒ ኤንታ ግዶን ኦዳ ማላታታ በእሸ፥ አዉደ ጋካናዉ ታናን አማኖና እፃኔ? <verse eid="NUM 14:11"/><verse number="12" style="v" sid="NUM 14:12"/>ታኒ ኤንታ ጋዶን ሾጫዳ ይሳና፥ ሽን ነና ኤንታፈ ዳርያነ ምንያ ካዎተስ አዋ ኦና” ያግስ።<verse eid="NUM 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13"/>ሙሰይ ዛሪድ ጎዳኮ፥ “ኔኒ ነ ዎልቃን ሀ አሳ ግብፀፈ ከስዳይሳ ኤርያ ግብፀት ሄሳ ስእኮ ዎይጋኔ? <verse eid="NUM 14:13"/><verse number="14" style="v" sid="NUM 14:14"/>ኤንቲ ሄ ቢታን ደእያ አሳስ ሄሳ ኦዳና። አቤት ጎዳዉ፥ ኔኒ ሀ አሳራ ደኤይሳ ኤንቲ ስእዶሶና። አቤት ጎዳዉ፥ ኑኒ ነና በእዳይሳ፥ ነ ሻራይ ኑ ቦላ ኩያትዳይሳነ ጋላስ ሻራ ቱሳን፥ ቃማ ታማ ቱሳን ኔኒ ኑና ካለዳይሳ ኤንቲ በእዶሶና። <verse eid="NUM 14:14"/><verse number="15" style="v" sid="NUM 14:15"/>ያትን፥ ሀእ ኔኒ ሀ አሳ ኡባ እስ ቶሆ ዎ ይስያባ ግድኮ ነ ካሰ ኦዳይሳ ስእዳ ካዎተት፥ <verse eid="NUM 14:15"/><verse number="16" style="v" sid="NUM 14:16"/>‘ጎዳይ፥ ሀ አሳስ እማና ግድ ጫቅዳ ቢታ ኤንታ ገልሳናዉ ዳንዳእቦና ግሾ መላ ቢታን ዎ ይስስ ያግድ’ ኦዳና።<verse eid="NUM 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 14:17"/>“ሄሳ ግሾ፥ ጎዳዉ፥ ነ ዎልቃ ኑና በሳ፤ ነ ኑስ ገልዳ ቃላ ቆፓ። <verse eid="NUM 14:17"/><verse number="18" style="v" sid="NUM 14:18"/>‘ጎዳይ ኤለ ሀንቀተና፤ ማሮትነ ሲቆይ ኩምዳይሳ ናጋራነ ጌላተ አቶ ገይሳ፤ ሽን ባልዳ ኡራ ሴሮና አገና። የልዳይሳታ ናጋራ ግሾ ሄንነ ኦይዳን የለተ ጋካናዉ ናይታ ሴራና’ ያጋዳሳ። <verse eid="NUM 14:18"/><verse number="19" style="v" sid="NUM 14:19"/>ሀ አሳይ ግብፀፈ ከዮሶፐ ዶማዳ ሀች ጋካናዉ ኤንታ ማርዳይሳዳ ነ መርና ሲቁዋን ሀ አሳ ናጋራ አቶ ጋርክ” ያግስ።<verse eid="NUM 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20"/>ጎዳይ ዛሪድ፥ “ነ ኦይችዳይሳዳ ታ ኤንታ ማራና። <verse eid="NUM 14:20"/><verse number="21" style="v" sid="NUM 14:21"/>ሽን ታ ደኦ ግደይሳዳነ ታ ቦንቾይ ሳአ ኡባ ኩምዳይሳዳ፥ <verse eid="NUM 14:21"/><verse number="22" style="v" sid="NUM 14:22"/>ሀ አሳፐ እስ አስካ ሄ ቢታ በኤና። ግብፀ ቢታንነ መላ ቢታን ኦዳ ማላታታ ሀ አሳት በእዶሶና፤ ሽን ኤንቲ ታሙ ቶሆ ታና ፓጭድ ታዉ ኪተቶና እፅዶሶና። <verse eid="NUM 14:22"/><verse number="23" style="v" sid="NUM 14:23"/>ሄሳ ግሾ፥ ታ ኤንታ ማይዛታስ እማና ጋዳ ጫቅዳ ቢታ ታና ካዳይሳታፐ እሶይካ ገለና። <verse eid="NUM 14:23"/><verse number="24" style="v" sid="NUM 14:24"/>ሽን ታ አይለይ ካለብ ኤንታፈ ዱማትያ ግሾነ ታና ፖሎ ዎዛናፐ ካልዳ ግሾ፥ እ ካሰ ዎችዳ ቢታ እያዉ እማና፤ እያ ዘረይካ ሄ ቢታ ላታና። <verse eid="NUM 14:24"/><verse number="25" style="v" sid="NUM 14:25"/>ሽን ሀእ አማለቃትነ ካናነት ዛንጋራን ደእያ ግሾ፥ ዎንቶ ዞኦ አባኮ ኤፍያ ኦግያ ኦይክድ መላ ቢታ ጉየ ስምተ” ያግስ።<verse eid="NUM 14:25"/></para>
  <para style="s1">ዙዙምዳ አሳ ሴረተ</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26"/>ጎዳይ ሙሰኮነ አሮናኮ፥ <verse eid="NUM 14:26"/><verse number="27" style="v" sid="NUM 14:27"/>“ሀ ኢታ አሳይ ታ ቦላ አዉደ ጋካናዉ ዙዙማኔ? ታኒ እስራኤለ አሳ ዙዙን ስአስ። <verse eid="NUM 14:27"/><verse number="28" style="v" sid="NUM 14:28"/>ሄሳ ግሾ፥ ኔኒ ኤንታዉ ሀይሳዳ ጋዳ ኦዳ፤ ‘ታኒ ታ ደኡዋን ጫቃይስ፤ ህንተ ግዳይሳዳ ታ ህንተዉ ኦና።’ ታኒ፥ ጎዳይ ሀይሳ ኦዳይስ። <verse eid="NUM 14:28"/><verse number="29" style="v" sid="NUM 14:29"/>አሳይ ታይበትያ ዎደ ላይ ላታማነ እያፐ ቦላ ግድዳ አስ ኡባይ ታ ቦላ ዙዙምዳ ግሾ፥ ህንተ አሀይ ሀ መላ ቢታን ኩንዳና። <verse eid="NUM 14:29"/><verse number="30" style="v" sid="NUM 14:30"/>ዮፎና ናአ ካለባፐነ ናወ ናአ እያሱፐ አትሽን፥ ህንተፈ ኦንካ ታ ህንተና ላትሳናዉ ጫቅዳ ሄ ቢታ ገለና። <verse eid="NUM 14:30"/><verse number="31" style="v" sid="NUM 14:31"/>ህንተ፥ ‘ኑ ናይት ድኤት አታና’ ግዳ ህንተ ናይታ፥ ሄ ህንተ ካዳ ቢታ ገልሳና፤ ሄ ቢታይ ኤንታዉ ላታ ግዳና። <verse eid="NUM 14:31"/><verse number="32" style="v" sid="NUM 14:32"/>ሽን ህንተ አሀይ ሀ መላ ቢታን ኩንድድ አታና። <verse eid="NUM 14:32"/><verse number="33" style="v" sid="NUM 14:33"/>ህንተ አማነትቦና ግሾ፥ ህንተፈ ዉርሰ አሀይ ሀ መላ ቢታን ኩንዳና ጋካናዉ፥ ህንተ ናይት ሀ መላ ቢታን ዋየትሸ ኦይታሙ ላይ ዶርሰ ሄማና። <verse eid="NUM 14:33"/><verse number="34" style="v" sid="NUM 14:34"/>ህንተ ቢታ ዎችዳ ኦይታሙ ጋላሳ ታይቦን፥ እስ ጋላሳስ እስ ላይ፥ ኦይታሙ ላይ ህንተ ናጋራ ግሾ ዋየታና፤ ሄ ዎደ ታ ህንተ ቦላ አይ መላ ሀንቀትዳኮ ህንተ ኤራና። <verse eid="NUM 14:34"/><verse number="35" style="v" sid="NUM 14:35"/>እስፈ ታ ቦላ ደንድዳ ሀ ኢታ ማባራ ቦላ ታ ሀይሳዳ ኦና፤ ኤንቲ ሀ መላ ቢታን ኩንድ አታና ሀይሳን ኤንቲ ሀይቃና፤ ታ ጎዳይ ሀይሳ ኦዳይስ” ያግስ።<verse eid="NUM 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36"/>ሄ ቢታ ዎቻና መላ ሙሰይ ኪትዳ አሳት ስሚድ፥ ሄ ቢታባ ኢታ ኦዳ ኦድድ፥ ሙሰ ቦላ አሳይ ዙዙማና መላ ኦዳይሳት፥ <verse eid="NUM 14:36"/><verse number="37" style="v" sid="NUM 14:37"/>ጎዳ ስንን ቦሻን ሀይቅዶሶና። <verse eid="NUM 14:37"/><verse number="38" style="v" sid="NUM 14:38"/>ሄ ቢታ ዎቻናዉ ብዳ አሳፐ ዮፎና ናአይ ካለብነ ናወ ናአይ እያሱ ፃላል አትዶሶና።<verse eid="NUM 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39"/>ሙሰይ ሄሳ እስራኤለ አሳስ ኦድዳ ዎደ አሳይ ዳሮ ዬክስ። <verse eid="NUM 14:39"/><verse number="40" style="v" sid="NUM 14:40"/>ዎንተ ጋላስ ዎንታ ጉራ ደንድድ፥ ገዘ ቢታ ከይድ፥ “ኑኒ ናጋራ ኦዳ፥ ሽን ሀእ ጎዳይ ኑስ እማና ግዳ በሳ ፑደ ከያና” ያግዶሶና።<verse eid="NUM 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41"/>ሽን ሙሰይ ኤንታኮ፥ “ጎዳ ኪታ ህንተ አይስ መንቲ? ህንተዉ ሀነና። <verse eid="NUM 14:41"/><verse number="42" style="v" sid="NUM 14:42"/>ጎዳይ ህንተራ ዶና ግሾ፥ ቦፕተ፤ ህንተ ሞርከት ህንተና ፆናና። <verse eid="NUM 14:42"/><verse number="43" style="v" sid="NUM 14:43"/>አማለቃ አሳራነ ካናነ አሳራ ህንተ ኦለትድ ማሻን ሀይቃና። ጎዳስ ህንተ ኪተቶና እፅዳ ግሾ፥ ጎዳይ ህንተራ ዴና” ያግስ።<verse eid="NUM 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44"/>ሽን ኤንቲ ጎዳ ጫቆ ታቦተይነ ሙሰይ ጉታፐ ደንዶና ደእሽን፥ ደረይ ዳርያ ቢታ ባናዉ ምንድ ደንድዶሶና። <verse eid="NUM 14:44"/><verse number="45" style="v" sid="NUM 14:45"/>ያንን ደረይ ዳርያ ቢታን ደእያ አማለቃ አሳይነ ካናነ አሳይ ኤንታ ኦላን ፆንድ፥ ሆርማ ጋካናዉ ኤንታ የደዶሶና።<verse eid="NUM 14:45"/></para>
  <chapter eid="NUM 14"/>
  <chapter number="15" style="c" sid="NUM 15"/>
  <para style="s1">ያርሾ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 15:1"/><verse number="2" style="v" sid="NUM 15:2"/>“እስራኤለ አሳ ሀይሳዳ ያጋ፤ ህንተ ዳና መላ ታ ህንተዉ እምያ ቢታ ገልያ ዎደ፥ <verse eid="NUM 15:2"/><verse number="3" style="v" sid="NUM 15:3"/>ፁሳ ያርሾ ግድን ዎይኮ ጋሶ ያርሾ ግድን ዎይኮ ዶሳን ያርሽያ ያርሾ ግድን ዎይኮ ባኣለ ጋላሳ ያርሾ ግድን፥ መሄፐ ዎይኮ ዶርሳፈ ጎዳስ ታማን ፁገትያ ሳውያ ያርሾ ያርሽተ። <verse eid="NUM 15:3"/><verse number="4" style="v" sid="NUM 15:4"/>ያርሹዋ ያርሽያ ኡራይ ካ ያርሹዋስ እስ ክሎ ግራመ ሎኦ ለ ሳይሶ ልትሮ ሻማሆ ዛይተን ሙኑቀትዳይሳ ኤሆ። <verse eid="NUM 15:4"/><verse number="5" style="v" sid="NUM 15:5"/>ቃስ ፁሳ ያርሾስ ዎይኮ ሀራ ያርሾስ ኤህያ እስ እስ ዶርሳራ ሳይሶ ልትሮ ዎይነ ኡሻ ያርሾ ኦድ ጊግስተ። <verse eid="NUM 15:5"/><verse number="6" style="v" sid="NUM 15:6"/>ማራዘ ያርሽያ ዎደ ናምኡ ክሎ ግራመ ሎኦ ለ እስ ልትሮነ ባጋ ሻማሆ ዛይተን ሙኑቀትዳይሳ ኤህተ። <verse eid="NUM 15:6"/><verse number="7" style="v" sid="NUM 15:7"/>ኡሻ ያርሹዋስ ስኮ ልትሮ ዎይነ ኡሻ ያርሹዋስ ኤህተ። ሄስ ጎዳስ ሳውያ ያርሾ ግዳና። <verse eid="NUM 15:7"/><verse number="8" style="v" sid="NUM 15:8"/>ጋሶ ዎይኮ እስፈተ ያርሾስ ዎፋኖ ፁሳ ያርሾ ኦዳ ጎዳስ ያርሽያ ዎደ፥ <verse eid="NUM 15:8"/><verse number="9" style="v" sid="NUM 15:9"/>ዎፋኑዋራ እስፈ ሄ ክሎ ግራመ ሎኦ ለ፥ ናምኡ ልትሮ ሻማሆ ዛይተን ሙኑቀትዳይሳ ካ ያርሾ ኦዳ ኤሀ። <verse eid="NUM 15:9"/><verse number="10" style="v" sid="NUM 15:10"/>ኡሻ ያርሹዋስ ባጋ ልትሮ ዎይነ ኡሻ ኤህተ። ሄስ ጎዳስ ሳውያ ፁሳ ያርሾ ግዳና።<verse eid="NUM 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 15:11"/>“እስ እስ ዎፋኖይ ዎይኮ እስ እስ ማራዘይ ዎይኮ እስ እስ ኮለይ ያርሸትያ ዎደ ሀይሳዳ ሀንድ ኦሰቶ። <verse eid="NUM 15:11"/><verse number="12" style="v" sid="NUM 15:12"/>ዳሮ መሄይ ያርሸትያ ዎደ ያርሸትያ ካ ያርሾይካ ሄሳዳ ዳሮ። <verse eid="NUM 15:12"/><verse number="13" style="v" sid="NUM 15:13"/>እስራኤለ አስ ግድዳ ኦንካ ሳውያ ፁሳ ያርሾ ጎዳስ ያርሽያ ዎደ ኡባን ሀይሳዳ ኦናዉ ኮሼስ። <verse eid="NUM 15:13"/><verse number="14" style="v" sid="NUM 15:14"/>ያና የለተን ህንተ ግዶን ደእያ በተ ዎይኮ ሀራ አስ ኦንካ ሳውያ ፁሳ ያርሾ ጎዳስ ያርሻናዉ ኮይኮ ሄሳዳ ኦናዉ ኮሼስ። <verse eid="NUM 15:14"/><verse number="15" style="v" sid="NUM 15:15"/>ህንተዉነ ህንተ ግዶን ደእያ በተ አሳስ ሄ ዎጋይ እስኖ፤ ሄስ ያና የለተስካ ኤቅድ ዳና ዎጋ፤ ህንተካ በተ አሳትካ ጎዳ ስንን እስኖ። <verse eid="NUM 15:15"/><verse number="16" style="v" sid="NUM 15:16"/>ህንተዉነ ህንተ ግዶን ደእያ በተ አሳስ ህገይነ ዎጋይ እስኖ” ያግስ።<verse eid="NUM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 15:17"/><verse number="18" style="v" sid="NUM 15:18"/>“እስራኤለ አሳስ ሀይሳዳ ጋዳ ኦዳ፤ ታኒ ህንተና ኤፍያ ቢታ ህንተ ገልድ፥ <verse eid="NUM 15:18"/><verse number="19" style="v" sid="NUM 15:19"/>ሄ ቢታን ካፅያ ካ ህንተ ምያ ዎደ ሄ ካፈ ፄራ ከስድ ህንተ ጎዳስ ያርሽተ። <verse eid="NUM 15:19"/><verse number="20" style="v" sid="NUM 15:20"/>ሄስካ፥ ባይራ ካፅዳ ካፈ ኡክዳ ኮይሮ ኡይ፥ ግድሽን፥ ካ ቡክያ ዉዱማፈ እምያ ያርሾ ኦድ ያርሽተ። <verse eid="NUM 15:20"/><verse number="21" style="v" sid="NUM 15:21"/>የለተ ኡባን ህንተ ቢታን ካፅዳ ካፈ ኮይሩዋ ኡክድ ጎዳስ ያርሾ ያርሽተ።<verse eid="NUM 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22"/>“ጎዳይ፥ ሙሰስ ኦድዳ ኪታ ህንተ ኤሮና እፅድ ናጎና አትኮ፥ <verse eid="NUM 15:22"/><verse number="23" style="v" sid="NUM 15:23"/>ዎይኮ ጎዳይ እያ ባጋራ እምዳ ኪታ ኡባ፥ ጎዳይ እምዳ ጋላሳፐ ዶምድ ያና የለተ ጋካናዉ ናጎና እፅኮ፥ <verse eid="NUM 15:23"/><verse number="24" style="v" sid="NUM 15:24"/>ቃስ ሄሳ እስራኤለ ማባራይ ኤሮና ኦዳባ ግድኮ ማባራ ኡባይ ጎዳስ እስ ዎፋኖ ሳውያ ፁሳ ያርሾ ኦድ፥ ዎጋይ ኪተይሳዳ ካ ያርሹዋራነ ኡሻ ያርሹዋራ ያርሾ፤ ቃስ ናጋራ ያርሾ ኦድ እስ ኮለ ያርሾ። <verse eid="NUM 15:24"/><verse number="25" style="v" sid="NUM 15:25"/>ካህነይ ኩመ እስራኤለ ማባራስ ናጋራ አቶተ ያርሾ ሺሼስ። ኤንቲ ኤሮና ባልዳ ባንታ ናቁዋ ግሾ ጎዳስ ፁሳ ያርሾነ ናጋራ ያርሾ ያርሽዳ ግሾ ኤንታ ናጋራይ አቶ ጌተታና። <verse eid="NUM 15:25"/><verse number="26" style="v" sid="NUM 15:26"/>እስራኤለ ማባራይነ ኤንታ ግዶን ደእያ በተ አሳይ ኤሮና ሄ ባላ ኦዳ ግሾ አሳ ኡባ ናጋራይ አቶ ጌተታና።<verse eid="NUM 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27"/>“እስ አስ ኤሮና ናጋራ ኦኮ እስ ላይ ኮለ ናጋራ ያርሾ ኦድ ያርሾ። <verse eid="NUM 15:27"/><verse number="28" style="v" sid="NUM 15:28"/>ኤሮና ደእሸ ናጋራ ኦዳ ኡራስ ካህነይ ጎዳ ስንን ናጋራ አቶተ ዎጋ ፖሎ፤ እያ ናጋራይ አቶ ጌተታና። <verse eid="NUM 15:28"/><verse number="29" style="v" sid="NUM 15:29"/>ኤሮና ናጋራ ኦዳ ኡራስ ካህነይ ጎዳ ስንን ናጋራ አቶተ ዎጋ ፖሎ፤ እያ ናጋራይ አቶ ጌተታና።<verse eid="NUM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30"/>“ሽን እስራኤለ አስ ግድን ዎይኮ በተ አስ ግድን ኤርሸ ኦቶሮን ናጋራ ኦያ ኡራይ ጎዳ ጫዬስ። ሄ ኡራይ ደርያ ግዶፈ ዮ። <verse eid="NUM 15:30"/><verse number="31" style="v" sid="NUM 15:31"/>ሄ ኡራይ ጎዳ ኪታ ኤርሸ ካዳ ግሾነ እያ ኪታ ካዉሽዳ ግሾ እያዉ ዮይ በሴስ። እያ ባላይ እያ ቦላ ግዶ” ያግስ።<verse eid="NUM 15:31"/></para>
  <para style="s1">ሳምባታ መንዳ ኡራ</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32"/>እስ ጋላስ እስራኤለ አሳይ መላ ቢታን ደእሽን፥ እስ ኡራይ ሳምባታ ጋላስ ም ምፅሸ ኦይከትስ። <verse eid="NUM 15:32"/><verse number="33" style="v" sid="NUM 15:33"/>ሄ ኡራ አሳይ ሙሰኮ፥ አሮናኮነ እስራኤለ ማባራኮ ኤህዶሶና። <verse eid="NUM 15:33"/><verse number="34" style="v" sid="NUM 15:34"/>ኤንቲ እያ ቦላ ኦናባ ኤርቦና ግሾ ቃሾን ጋምእስዶሶና። <verse eid="NUM 15:34"/><verse number="35" style="v" sid="NUM 15:35"/>ሄሳፈ ጉየ ጎዳይ ሙሰኮ፥ “ሀ ኡራይ ሀይቃናዉ በሴስ፤ እስራኤለ ማባራይ ባንታ ጉታፐ ጋፃ ከስድ ሹቻን ጫድድ ዎ” ያግስ። <verse eid="NUM 15:35"/><verse number="36" style="v" sid="NUM 15:36"/>ያትን እስራኤለ ማባራ ኡባይ ጎዳይ ሙሰ ኪትዳይሳዳ፥ ጉታፐ ጋፃ ከስድ ሹቻን ጫድድ ዎዶሶና።<verse eid="NUM 15:36"/></para>
  <para style="s1">አፍላ ማጫራ ዎጋ</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 15:37"/><verse number="38" style="v" sid="NUM 15:38"/>“እስራኤለ አሳስ ሀይሳዳ ጋዳ ኦዳ፤ ህንተነ ያና የለተይ ህንተ አፍላ ጋፃን ማጫራ ከስድ ሄ ማጫራ ጋፃን ካሎሰ ቃጭና ስክተ። <verse eid="NUM 15:38"/><verse number="39" style="v" sid="NUM 15:39"/>ሄ ማጫራ ህንተ በእያ ዎደ ኡባን ታ ኪታታ፥ አኬክድ ፖሌታ፤ ታፐ ሃክድ ህንተ አይፍያ አሙዋነ ህንተ ዎዛና ቆፋ ካልድ ላመተከታ። <verse eid="NUM 15:39"/><verse number="40" style="v" sid="NUM 15:40"/>ሄ ማጫራ በእድ ህንተ ታ ኪታ ኡባ አኬክድ ፖላናነ ፆሳስ ዱማትዳይሳታ ግዳና። <verse eid="NUM 15:40"/><verse number="41" style="v" sid="NUM 15:41"/>ታኒ ጎዳ፥ ህንተ ፆሳ፤ ታ ህንተ ፆሳ ግዳናዉ ህንተና ግብፀፈ ከሳስ። ታኒ ጎዳ፥ ህንተ ፆሳ ያጋ” ያግስ።<verse eid="NUM 15:41"/></para>
  <chapter eid="NUM 15"/>
  <chapter number="16" style="c" sid="NUM 16"/>
  <para style="s1">ቆረ፥ ዳታነነ አቤሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1"/>ሌወ ኮቻፈ ቃሃታ ኮቸ ግድዳ ይስአራ ናአይ ቆረይ፥ ሮቤላ ኮቻፈ ኤልኣባ ናይት ዳታነይነ አቤሮይ ቃስ ፋለታ ናአይ ኦን፥ <verse eid="NUM 16:1"/><verse number="2" style="v" sid="NUM 16:2"/>ሙሰ ቦላ ደንድዶሶና። ኤንታራ ናምኡ ፄታነ እሻታሙ አሳት ደኦሶና፤ ሄ አሳት አሳን ኤረትዳይሳታነ ማባራ ካለይሳታ። <verse eid="NUM 16:2"/><verse number="3" style="v" sid="NUM 16:3"/>ኤንቲ ሙሰነ አሮና ስን ሺቅድ፥ “ህንተ ዳርስደታ፤ ማባራ ኡባይ ጌሽ፤ ጎዳይ ኤንታራ ደኤስ። ያትን፥ ጎዳ ማባራ ቦላ ህንተና አይስ ቁ ቁ ኦቲ?” ያግዶሶና።<verse eid="NUM 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4"/>ሙሰይ ሄሳ ስእዳ ዎደ ጎዳ ስንን ጉፋንስ። <verse eid="NUM 16:4"/><verse number="5" style="v" sid="NUM 16:5"/>ቆረኮነ እያ ጩጋኮ፥ “ጎዳይ ዎንቶ ዎንታ ኦን እያ ባገኮነ ኦን ጌሸኮ በሳና፤ ሄ እ ዶርዳ ኡራ ባኮ ሺሻና፤ ሄ ኡራይ እያኮ ሺቃና። <verse eid="NUM 16:5"/><verse number="6" style="v" sid="NUM 16:6"/>ዎንቶ ዎንታ ኔራነ ነ አሳራ ሀይሳ ኦተ፤ እፃነ ጩይስያ ሚሸ ኤክድ፥ <verse eid="NUM 16:6"/><verse number="7" style="v" sid="NUM 16:7"/>ቦንቆ ታማ እያን ዎድ፥ ጎዳ ስንን እፃነ ጩይስተ። ጎዳይ ዶርያ ኡራይ እ ጌሽ ግዳና። ህንተ፥ ሌወት ዛዋፐ አደታ።”<verse eid="NUM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8"/>ቃስካ ሙሰይ ቆረኮ፥ “ህንተ ሌወት ስእተ። <verse eid="NUM 16:8"/><verse number="9" style="v" sid="NUM 16:9"/>እስራኤለ ፆሳይ ህንተና ባ ማባራ ግዶፈ ዱማይድ፥ ጌሻ ዱንካንያን ኦና መላነ ባ አሳ ስንን ኤቅድ ሀጋዛና መላ ባኮ ሺሽዳይስ ህንተዉ ጉፅዴ? <verse eid="NUM 16:9"/><verse number="10" style="v" sid="NUM 16:10"/>እ ህንተናነ ህንተ እሻታ ሌወታ ኡባ ባኮ ሺሽስ፤ ሽን ሀእ ህንተ ካህነታ በሳ ኮዬታ። <verse eid="NUM 16:10"/><verse number="11" style="v" sid="NUM 16:11"/>ኔንነ ነ ጩጋ ኡባይ ጎዳ ቦላ ማካልድ ደንድደታ፤ ህንተ እያ ቦላ ዙዙማናዉ እ አሮን ኦኔ?” ያግስ።<verse eid="NUM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12"/>“ያትድ፥ ሙሰይ፥ ኤልኣባ ናይታ፥ ዳታነነ አቤሮ ፄግስስ፤ ሽን ኤንቲ፥ ‘ኑኒ ቦኮ’ ያግዶሶና። <verse eid="NUM 16:12"/><verse number="13" style="v" sid="NUM 16:13"/>ኔኒ መላ ቢታን ኑና ዎናዉ ማነ ኤስ ጎግያ ቢታፈ ኑና ከስዳይስ ጉፅስ ጋዳ ሀእ ኑ ቦላ ሀላቃ ግዳናዉ ኮያይ? <verse eid="NUM 16:13"/><verse number="14" style="v" sid="NUM 16:14"/>ኔኒ ኑና ማነ ኤስ ጎግያ ቢታ ገልሳባካ፤ ዎይኮ ኔኒ ኑስ ላታ ኦዳ ጎሻ ጋደነ ዎይነ ጋደ እማባካ፤ ኔኒ ኑና ጭማሳ፤ ኑኒ ቦኮ” ያግዶሶና።<verse eid="NUM 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15"/>ያትን፥ ሙሰይ ዳሮ ሀንቀትድ፥ ጎዳኮ፥ “ኔኒ ኤንታ ያርሹዋ ኤኮፋ፤ ታ ኤንታፈ እሱዋካ ቆሀብከ፤ ቃስ ሀር አቶሽን እስ ሀረካ ኤንታፈ ኤካብከ” ያግስ።<verse eid="NUM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16"/>ቃስ ሙሰይ ቆረኮ፥ “ዎንቶ ኔራነ ነ አሳራ ሄሳዳ አሮንካ ጎዳ ስን ሺቅተ። <verse eid="NUM 16:16"/><verse number="17" style="v" sid="NUM 16:17"/>እስ እስ አስ ባ እፃነ ጩይስያ ሚሽያ ኤኮ፤ እፃነካ እያን ዎ፤ ኡባይ እስፈ ናምኡ ፄታነ እሻታሙ እፃነ ጩይስያ ሚሸ ግዴስ፤ እፃነ እያን ዎድ ጎዳ ስን ሺሾ። ኔኒነ አሮን ህንተ እፃንያ ሄሳዳ ሺሽተ” ያግስ። <verse eid="NUM 16:17"/><verse number="18" style="v" sid="NUM 16:18"/>ያትን፥ እስ እስ አስ ባ ሚሸን እፃነነ ታማ ቦንቆ ዎድ ጌሻ ዱንካንያ ፐንገን ሙሰራነ አሮናራ እስፈ ኤቅዶሶና። <verse eid="NUM 16:18"/><verse number="19" style="v" sid="NUM 16:19"/>ቆረይ ባ አሳራ ጌሻ ዱንካንያ ፐንገን ሙሰ ስንንነ አሮና ስንን ኤቅዶሶና። ሄ ዎደ ጎዳ ቦንቾይ ኩመ ማባራስ ቆንጭስ። <verse eid="NUM 16:19"/><verse number="20" style="v" sid="NUM 16:20"/>ጎዳይ ሙሰኮነ አሮናኮ፥ <verse eid="NUM 16:20"/><verse number="21" style="v" sid="NUM 16:21"/>“ታኒ እስ ቶሆ ሀ አሳ ይሳና ግሾ፥ ኤንታፈ ሻከትተ” ያግስ።<verse eid="NUM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22"/>ሽን ሙሰይነ አሮን ሳአን ጉፋንድ፥ “አቤት ፆሳዉ፥ አሳ ሸምፖ ኡባ መዳ ፆሳዉ፥ እስ አስ ናጋራ ኦኮ፥ ኔኒ ኩመ ማባራ ሀንቀታዬ?” ያግዶሶና።<verse eid="NUM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23"/>ያትን፥ ጎዳይ ሙሰኮ፥ <verse eid="NUM 16:23"/><verse number="24" style="v" sid="NUM 16:24"/>“አሳስ ‘ቆረ፥ ዳታነነ አቤሮ ዱንካንያ ማታፐ ክችተ’ ጋዳ ኦዳ” ያግስ።<verse eid="NUM 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25"/>ሙሰይ ደንድድ፥ ዳታነኮነ አቤሮኮ ብን፥ እስራኤለ ጭማት እያ ካልዶሶና። <verse eid="NUM 16:25"/><verse number="26" style="v" sid="NUM 16:26"/>እ ማባራኮ፥ “ሀ ኢታ አሳ ዱንካንያ ማታፐ ክችተ፤ ኤንታባ አይብባካ ቦቾፍተ። አካይ፥ ጊኮ፥ ኤንታ ናጋራ ጋሶን ህንተካ ፕተትድ ያና” ያግድ ምንድ ኦድስ።<verse eid="NUM 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 16:27"/>ያትን አሳይ ቆረ፥ ዳታነነ አቤሮ ዱንካንያ ማታፐ ክችዶሶና። ዳታነይነ አቤሮይ ካረ ከይድ፥ ባንታ ማቸታራነ ባንታ ናይታራ ባንታ ዱንካነታ ፐንገን ኤቅዶሶና። <verse eid="NUM 16:27"/><verse number="28" style="v" sid="NUM 16:28"/>ሙሰይ አሳኮ፥ “ታኒ ሀ ኦሶ ኡባ ኦና መላ፥ ጎዳይ ታና ኪትዳይሳነ ታኒ ታ ሸነን ኦናይሳ ህንተ ኤራናይ ሀይሳና። <verse eid="NUM 16:28"/><verse number="29" style="v" sid="NUM 16:29"/>ሀ አሳት አስ ሀይቀይሳዳ ሀይቅኮ ዎይኮ አሳ ቦላ ጋክያባ ፃላል ኤንታ ቦላ ጋክኮ ጎዳይ ታና ኪትቤና። <verse eid="NUM 16:29"/><verse number="30" style="v" sid="NUM 16:30"/>ሽን፥ ጎዳይ ኦራባ ኦድ፥ ቢታይ ዶየትድ ኤንታነ ኤንታዉ ደእያባ ኡባ ምትኮነ ኤንቲ ፓፃ ደእሸ ዱፎ ገልኮ ሄ ዎደ ሀ አሳት ጎዳ ካዳይሳ ህንተ ኤራና” ያግስ።<verse eid="NUM 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31"/>እ ያግድ ኦንግዳ ዎደ ኤንቲ ኤቅዳ ቢታይ ዶየትድ፥ <verse eid="NUM 16:31"/><verse number="32" style="v" sid="NUM 16:32"/>ኤንታነ ኤንታ ሶ አሳ፥ ቆረ ጩጋ ኡባነ ኤንታዉ ደእያባ ኡባ ምትስ። <verse eid="NUM 16:32"/><verse number="33" style="v" sid="NUM 16:33"/>ያትን ኤንቲ ባንታዉ ደእያባ ኡባራ ፓፃ ደእሸ፥ ዱፎ ገልዶሶና። ቢታይ ኤንታ ቦላ ጎርደትስ፤ ኤንቲ ማባራ ግዶፈ ይዶሶና። <verse eid="NUM 16:33"/><verse number="34" style="v" sid="NUM 16:34"/>ኤንታ ዋሱዋ ጋሶን ኤንታ ማታን ደእያ እስራኤለ አሳ ኡባይ፥ “ቢታይ ኑናካ ምታና ሀኔስ” ያግድ ባቃትዶሶና።<verse eid="NUM 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 16:35"/>ቃስ ታም ጎዳ ማታፐ ይድ እፃነ ጩይስያ ናምኡ ፄታነ እሻታሙ አሳ ምስ።<verse eid="NUM 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36"/>ሄሳፈ ጉየ ጎዳይ ሙሰኮ፥ <verse eid="NUM 16:36"/><verse number="37" style="v" sid="NUM 16:37"/>“ካህነይ፥ አሮና ናኣ አላዛር ናሰ ብራታፐ ኦሰትዳ እፃነ ጩይስያ ሚሸታ ፁገትዳ አሳፐ ኤክድ፥ ሄ ሚሸት ጌሽ ግድያ ግሾ፥ ቦንቆ ታማ ሀራ ሶ ኤፍድ ላላና መላ ኦዳ። <verse eid="NUM 16:37"/><verse number="38" style="v" sid="NUM 16:38"/>ሄ ሚሸት ባንታ ደኡዋ ይሳናዉ ናጋራ ኦዳ አሳይ እፃነ ጩይስያ ሚሸ። ሄ ሚሸት ጎዳስ እመትዳ ግሾነ ጌሽ ግድያ ግሾ ሌእሳ ቆፃዳ ያርሾ በሳ ላንፃ። ሄስ እስራኤለ አሳስ ናግሶ ማላ ግዶ” ያግስ።<verse eid="NUM 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39"/>ያትን ካህነይ አላዛር እፃነ ጩይስያ ሚሸታ ኤክድ ያርሾ በሳ ላንፃናዉ ሌእስድ ቆፅስ። <verse eid="NUM 16:39"/><verse number="40" style="v" sid="NUM 16:40"/>ጎዳይ ሙሰ ባጋራ ኪትዳይሳዳ፥ አሮና ኮቸ ግዶና ኦንካ ጎዳ ስንን እፃነ ጩይሳናዉ ሺቆና መላ፥ እፃስ ጊኮ፥ ቆረ ቦላነ እያ ካለይሳታ ቦላ ጋክዳይስ እያ ጋኮና መላ እስራኤለ አሳ አኬክሳናዉ ሀይሳታ ኦስ።<verse eid="NUM 16:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41"/>ዎንተ ጋላስ እስራኤለ ማባራ ኡባይ፥ “ጎዳ አሳ ህንተ ዎደታ” ያግድ ሙሰ ቦላነ አሮና ቦላ ዙዙምዶሶና። <verse eid="NUM 16:41"/><verse number="42" style="v" sid="NUM 16:42"/>ኤንቲ ሙሰነ አሮና ቦላ ደንዳናዉ ሺቅድ፥ ኤንቲ ጌሻ ዱንካንያ ፄልያ ዎደ ሻራይ ጌሻ ዱንካንያ ካምን፥ ጎዳ ቦንቾይ ቆንጭስ።<verse eid="NUM 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="NUM 16:43"/>ሄሳፈ ጉየ፥ ሙሰይነ አሮን ጌሻ ዱንካንያ ስን ይድ ኤቅዶሶና። <verse eid="NUM 16:43"/><verse number="44" style="v" sid="NUM 16:44"/>ያትን ጎዳይ ሙሰኮ፥ <verse eid="NUM 16:44"/><verse number="45" style="v" sid="NUM 16:45"/>“ሀ አሳ ግዶፈ ክችተ፤ ታ ኤንታ እስ ቶሆን ይሳና” ያግስ።</para>
  <para style="p" vid="NUM 16:45">ሙሰይነ አሮን ሳአን ጉፋንዶሶና። <verse eid="NUM 16:45"/><verse number="46" style="v" sid="NUM 16:46"/>ሙሰይ አሮናኮ፥ “እፃነ ጩይስያ ነ ሚሽያ ኤካዳ ያርሾ በሳፈ ቦንቆ ታማ ኤካዳ እያን ዎ፤ እያ ቦላ እፃነ ጉጃዳ እስራኤለ ማባራኮ ኤፋ። ጎዳ ሀንቆይ እያ ማታፐ ከይ ክችስ፤ ቦሻይካ ዶምስ” ያግስ። <verse eid="NUM 16:46"/><verse number="47" style="v" sid="NUM 16:47"/>ያትን አሮን፥ ሙሰይ ኪትዳይሳዳ ባ እፃነ ጩይስያ ሚሽያ ኤክድ ማባራ ግዶ ዎፅድ ገልስ። ቦሻይ አሳ ዎ ኦይክስ ሽን፥ አሮን እፃነ ጩይስድ አሳስ አቶተ ኤህስ። <verse eid="NUM 16:47"/><verse number="48" style="v" sid="NUM 16:48"/>ያትድ፥ እ ሀይቅዳይሳታነ ፓፃታ ግዶን ኤቅን፥ ቦሻይ አግስ። <verse eid="NUM 16:48"/><verse number="49" style="v" sid="NUM 16:49"/>ቆረ ጋሶን ሀይቅዳ አሳይ አትሽን፥ ሄ ቦሻን ሀይቅዳ አሳ ታይቦይ 14,700. <verse eid="NUM 16:49"/><verse number="50" style="v" sid="NUM 16:50"/>ቦሻይ ኤቅዳፐ ጉየ፥ አሮን ጌሻ ዱንካንያ ፐንገን ደእያ ሙሰኮ ስምስ።<verse eid="NUM 16:50"/></para>
  <chapter eid="NUM 16"/>
  <chapter number="17" style="c" sid="NUM 17"/>
  <para style="s1">አሮና ፃምአ አጨ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 17:1"/><verse number="2" style="v" sid="NUM 17:2"/>“እስራኤለ አሳይ እስ እስ ኮቻ ሀላቃታፐ እስ እስ ፃምአ ኤክድ ታማነ ናምኡ ፃምአ ነዉ ኤሀና መላ ኤንታዉ ኦዳ። ሄ ፃምኣ ቦላ እስ እስ አሳ ሱን ፃፋ። <verse eid="NUM 17:2"/><verse number="3" style="v" sid="NUM 17:3"/>እስ እስ ኮቻ ሀላቃስ እስ ፃምአ ኮሽያ ግሾ፥ ሌወ ፃምኣ ቦላ አሮና ሱን ፃፋ። <verse eid="NUM 17:3"/><verse number="4" style="v" sid="NUM 17:4"/>ሄ ፃምአታ ጌሻ ዱንካንያ ግዶን ታ ኔራ ጋሄትያ ታቦትያ ስንን ዎ። <verse eid="NUM 17:4"/><verse number="5" style="v" sid="NUM 17:5"/>ታ ዶርያ ኡራ ፃምአይ አጫና፤ ሄሳዳ ኦዳ ህንተ ቦላ እስራኤለ አሳ ዙዙን ታ ተቃና” ያግስ።<verse eid="NUM 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6"/>ሄሳ ሙሰይ እስራኤለ አሳስ ኦድን፥ ታማነ ናምኡ ሀላቃት ሁጰን ሁጰን እስ እስ ፃምአ ኤህዶሶና። አሮና ፃምአይካ ሄ ፃምአታ ግዶን ደኤስ። <verse eid="NUM 17:6"/><verse number="7" style="v" sid="NUM 17:7"/>ሙሰይ ሄ ፃምአታ ኡባ ጌሻ ዱንካንያ ግዶን ጎዳ ስንን ዎስ።<verse eid="NUM 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8"/>ዎንተ ጋላስ ሙሰይ ጌሻ ዱንካንያ ግዶ ገልያ ዎደ ሌወ ኮቸ ግድዳ አሮና ፃምአይ አጭዳይሳ፥ ጋምቡፅዳይሳ፥ ጪይዳይሳነ ላዉዘ ም አይፈ አይፍዳይሳ በእስ። <verse eid="NUM 17:8"/><verse number="9" style="v" sid="NUM 17:9"/>ሙሰይ ፃምአ ኡባ ጎዳ ስንፈ ኤህድ እስራኤለ አሳ በስስ። ኤንቲ ሀንዳባ በእዳፐ ጉየ እስ እስ ሀላቃይ ባንታ ፃምኣ ፃምኣ ኤክዶሶና። <verse eid="NUM 17:9"/><verse number="10" style="v" sid="NUM 17:10"/>ጎዳይ ሙሰኮ፥ “አሮና ፃምኣ ታቦትያ ስንን ዛራዳ ዎ። ማካልዳ እስራኤለ አሳይ ታ ቦላ ዙዙን አጎና እፅኮ ሀይቃናይሳ ኤንታዉ ማላታ ኦዳ ዎ” ያግስ። <verse eid="NUM 17:10"/><verse number="11" style="v" sid="NUM 17:11"/>ሙሰይ፥ ጎዳይ ኪትዳይሳዳ ኦስ።<verse eid="NUM 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12"/>እስራኤለ አሳይ ሙሰኮ፥ “ሄሳ ግድኮ፥ ኑ ኡባይ ሀይቃና፤ ያና። <verse eid="NUM 17:12"/><verse number="13" style="v" sid="NUM 17:13"/>ጌሻ ዱንካንያኮ ሺቅያ ኡባይ ሀይቃና ግድኮ፥ ኑ ኡባይካ ሀይቆስ ጉሰዬ?” ያግዶሶና።<verse eid="NUM 17:13"/></para>
  <chapter eid="NUM 17"/>
  <chapter number="18" style="c" sid="NUM 18"/>
  <para style="s1">ካህነታነ ሌወታ ኦሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1"/>ጎዳይ አሮናኮ፥ “ጌሻ ዱንካንያን ኦሰትያ ናጋራስ ኔኒ፥ ነ አደ ናይትነ ነ አዋ ሶ አሳይ ኦይሸታና፤ ህንተ ካህነተ ኦሱዋን ፖለትያ ናጋራ ነነ ነ አደ ናይታ ፃላል ኦይሸታና። <verse eid="NUM 18:1"/><verse number="2" style="v" sid="NUM 18:2"/>ኔንነ ነ አደ ናይት ጌሻ ዱንካንያ ስንን ኦያ ዎደ ህንተና ኦድ ማዳና መላ ሌወ ኮቸ ግድዳ ነ ዳቦታ ኤሀ። <verse eid="NUM 18:2"/><verse number="3" style="v" sid="NUM 18:3"/>ኤንቲ ህንተፈ ጋርሳን ጌሻ ዱንካንያ ኦሶ ኡባ ኦና፤ ሽን ኤንትካ ህንተካ ሀይቆና መላ ኤንቲ ጌሻ ዱንካንያ ሚሽያኮነ ያርሾ በሳኮ ሺቆፖ። <verse eid="NUM 18:3"/><verse number="4" style="v" sid="NUM 18:4"/>ኤንቲ ህንተራ እስፈ ግድድ ጌሻ ዱንካንያን ደእያ ኦሶ ኡባ ኦ። ሽን ሌወታፐ አትሽን፥ ሀራ አስ ኦንካ ህንተ ደእያ በሳ ሺቆፖ። <verse eid="NUM 18:4"/><verse number="5" style="v" sid="NUM 18:5"/>ዛሪድ እስራኤለ አሳ ቦላ ሀንቆይ ዎና መላ ጌሻ ዱንካንያንነ ያርሾ በሳን ኦሰትያ ኦሱዋ ህንተ ፃላላ ኦተ። <verse eid="NUM 18:5"/><verse number="6" style="v" sid="NUM 18:6"/>ሌወታ፥ ህንተ ዳቦታ፥ እስራኤለ አሳ ግዶፈ ታ ዶራስ። ኤንቲ ጌሻ ዱንካንያ ኦሱዋ ኦና መላ ታኒ ኤንታ ታዉ ዱማያስ። <verse eid="NUM 18:6"/><verse number="7" style="v" sid="NUM 18:7"/>ሽን ያርሾ በሳንነ ማጋራጁዋፈ ጋ ባጋን ደእያ ኦሱዋ ነነ ነ አደ ናይታ ፃላል ኦተ። ካህነተ ኦሱዋ ታኒ ህንተዉ እሞታ ኦዳ እማስ፤ ሀራ አስ ኦንካ ሄ በሳ ሺቅኮ ሀይቆ” ያግስ።<verse eid="NUM 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8"/>ጎዳይ አሮናኮ፥ “እስራኤለ አሳይ ታዉ እምያ ጌሻ እሞታ ኡባ ታ ነዉ እማስ። ታኒ ነዉነ ነ አደ ናይታስ መርና ግሾ ኦዳ እማስ። <verse eid="NUM 18:8"/><verse number="9" style="v" sid="NUM 18:9"/>ታዉ እመትያ ዳሮ ጌሻ እሙዋፐ ታማን ፁገቶና ባጋይ ህንተባ ግዳና። ኤንቲ ታዉ እምያ ጌሻ እሞ ኡባይ ካ ያርሾ ግድን ናጋራ ያርሾ ግድን ናቆ ያርሾ ግድን ነዉነ ነ አደ ናይታስ ግዳና። <verse eid="NUM 18:9"/><verse number="10" style="v" sid="NUM 18:10"/>ህንተ ሄሳ ጌሻ በሳን ሚተ፤ አደ ኡባይ ሄሳ ሞ፤ ሄስ ህንተዉ ጌሽ ግዳና።<verse eid="NUM 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11"/>“ቃስ እስራኤለ አሳይ ታዉ ያርሽያ ዩሾ ያርሾ ኡባ ነዉ፥ ነ አደ ናይታስነ ነ ማጫ ናይታስ መርናዉ ግሾ ኦዳ እማስ፤ ህንተ ሶ አሳ ግዶን ዎጋዳ ቱና ግዶና ኡባይ ሄሳ ሞ።<verse eid="NUM 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 18:12"/>“እስራኤለ አሳይ ታዉ ባይራ ኦድ እምያ ኮይሮ አይፍያፐ፥ ሻማሆ ዛይተ ኡባ፥ ያላጋ ዎይነ ኡባነ ካ ኡባ ነዉ እማስ። <verse eid="NUM 18:12"/><verse number="13" style="v" sid="NUM 18:13"/>ኤንቲ ጎዳስ ኤህያ ጋደን ኮይሮ ጋክዳ አይፈይ ህንተሳ፤ ህንተ ሶ አሳ ግዶን ዎጋዳ ቱና ግዶና ኡባይ ሄሳ ሞ።<verse eid="NUM 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14"/>“እስራኤለ አሳ ግዶፈ ጎዳስ ዱማትዳ ኡባይ ህንተሳ። <verse eid="NUM 18:14"/><verse number="15" style="v" sid="NUM 18:15"/>ባይራ የለትዳ አስ ዎይኮ መሄይ እስራኤለ አሳይ ጎዳስ እምዳ ኡባይ ህንተሳ። ሽን ባይራ የለትዳ አደ ናአነ ባይራ የለትዳ ጌሽ ግዶና መሄ ህንተ ዎዛናዉ በሴስ። <verse eid="NUM 18:15"/><verse number="16" style="v" sid="NUM 18:16"/>እስ አጌና ናይታ ዎዛናዉ ጌሻ ዱንካነን ኤረትዳ ምዛነን እቻሹ ብራ ሳንትመ ዎዞ ጋተ ቃንፅተ። <verse eid="NUM 18:16"/><verse number="17" style="v" sid="NUM 18:17"/>ሽን ኤንቲ ጌሽ ግድያ ግሾ መሄ፥ ዶርሰነ ዴሻ ባይራ ህንተ ዎዛናዉ ኮሸና። ኤንታ ሱ ያርሾ በሳ ቦላ ጉሳ፤ ጎዳስ ሳውያ ፁሳ ያርሾ ኦዳ ኤንታ ሞ አሹዋ ታማን ፁጋ። <verse eid="NUM 18:17"/><verse number="18" style="v" sid="NUM 18:18"/>አንጋሶይነ ኡሻቻ ገዳይ ዩሾ ያርሾን ነባ ግድዳይሳዳ ኤንታ አሾይካ ነባ። <verse eid="NUM 18:18"/><verse number="19" style="v" sid="NUM 18:19"/>እስራኤለ አሳይ ጎዳስ እምያ ጌሻ ያርሾ ኡባ ነዉ፥ ነ አደ ናይታስነ ነ ማጫ ናይታስ መርናዉ ግሾ ኦዳ እማስ። ሄስ ታኒ ኔራነ ነ ኮቻራ ጫቅያ መርና ጫቁዋ።”<verse eid="NUM 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20"/>ቃስካ ጎዳይ አሮናኮ፥ “ኤንታ ቢታፈ ነና ጋክያ ግሾይ ዎይኮ ላት ባዋ፤ እስራኤለ አሳ ግዶን ነ ላታይነ ነና ጋክያ ግሾይ ታና።”<verse eid="NUM 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21"/>ጎዳይ፥ “ሌወት ጌሻ ዱንካንያን ኦያ ኦሱዋስ ዳሞዘ ግዳና መላ እስራኤለ አሳይ ታዉ ኤህያ አስራታ ኡባ ኤንታዉ እማስ። <verse eid="NUM 18:21"/><verse number="22" style="v" sid="NUM 18:22"/>ሀችፈ ዶምድ እስራኤለ አሳይ ባንታ ናጋራ ጋሶን ሀይቆና መላ ጌሻ ዱንካንያኮ ሺቆፖ። <verse eid="NUM 18:22"/><verse number="23" style="v" sid="NUM 18:23"/>ጌሻ ዱንካንያ ግዶን ኦይሳትነ እያ ግዶን ፖለትያ ናጋራ ቶከይ ሌወታ። ሄስ የለተ ኡባስ መርና ዎጋ። ሌወታስ እስራኤለ አሳ ግዶን ላት ባዋ። <verse eid="NUM 18:23"/><verse number="24" style="v" sid="NUM 18:24"/>ሄሳ ግሾ፥ እስራኤለ አሳይ ጎዳስ እምያ አስራታ፥ ታ ሌወታስ እማስ። ታኒ፥ ኤንታዉ እስራኤለ አሳ ግዶን ላት ባዋ ግዳይ ሄሳሳ” ያግስ።<verse eid="NUM 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25"/>ቃስ ጎዳይ ሙሰኮ፥ <verse eid="NUM 18:25"/><verse number="26" style="v" sid="NUM 18:26"/>“ኔኒ ሌወታኮ ሀይሳዳ ያጋ፤ ታኒ ህንተዉ ላታ ኦዳ እምዳ አስራታ ህንተ እስራኤለ አሳፐ ኤክያ ዎደ ህንተ ሄ አስራታፐ አስራታ ጎዳስ እምተ። <verse eid="NUM 18:26"/><verse number="27" style="v" sid="NUM 18:27"/>ህንተ እሞይ ዉዱማፈ ሺቅዳ ካዳ ዎይኮ ጉምእያ በሳፈ ሀእ ከይዳ ዎይነዳ ህንተዉ ታይበታና። <verse eid="NUM 18:27"/><verse number="28" style="v" sid="NUM 18:28"/>ሄሳዳካ እስራኤለ አሳፐ ህንተ ኤክያ አስራታ ኡባፈ ዱማ እሞ ጎዳስ እምተ፤ ህንተ አስራታፐ ጎዳ ግሾ ግድዳ እሞታ ካህንያ አሮናስ እምተ። <verse eid="NUM 18:28"/><verse number="29" style="v" sid="NUM 18:29"/>ህንተ ኤክያ እሞታ ኡባፈ ሎኡዋነ ጌሻ ጎዳስ ግሾ ኦድ እማናዉ በሴስ። <verse eid="NUM 18:29"/><verse number="30" style="v" sid="NUM 18:30"/>ኡባፈ ሎኦ እሙዋ ህንተ እምያ ዎደ አትዳይስ ህንተዉ ቡከትያ ዉዱማ ካዳነ ጉምኤትያ ዎይንያዳ ታይበታና። <verse eid="NUM 18:30"/><verse number="31" style="v" sid="NUM 18:31"/>አትዳይስ ጌሻ ዱንካንያን ህንተ ኦያ ኦሱዋስ ዳሞዘ ግድያ ግሾ ህንተነ ህንተ ሶ አሳይ አዉንካ ማናዉ ዳንዳኤታ። <verse eid="NUM 18:31"/><verse number="32" style="v" sid="NUM 18:32"/>ሎኦ ባጋ ጎዳስ እምዳፐ ጉየ ህንተ ሚኮ ሄስ ህንተዉ ናጋራ ግደና። ሎኦ ባጋ ከሶና ደእሸ ሄ እሞታፐ ምድ ህንተ እስራኤለ አሳ እሞታ ቱንሶና መላ ናገትተ፤ ሄሳ ህንተ ኦና እፅኮ ህንተ ሀይቃና” ያጋዳ ሌወታስ ኦዳ።<verse eid="NUM 18:32"/></para>
  <chapter eid="NUM 18"/>
  <chapter number="19" style="c" sid="NUM 19"/>
  <para style="s1">ጌሾ ሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1"/>ጎዳይ ሙሰኮነ አሮናኮ፥ <verse eid="NUM 19:1"/><verse number="2" style="v" sid="NUM 19:2"/>“ጎዳይ ህግያን ኪተትዳ ዎጋይ ሀይሳ፤ ቦርሶይ ባይና፥ እ ጋናን ቃምባር ዎቦና ዞኦ ኡሱ ኤሀና መላ እስራኤለ አሳስ ኦድተ። <verse eid="NUM 19:2"/><verse number="3" style="v" sid="NUM 19:3"/>ካህንያ አላዛራስ እዮ እምተ፤ ጉታፐ እዮ ጋፃ ከስድ ካህንያ ስንን ሹኮ። <verse eid="NUM 19:3"/><verse number="4" style="v" sid="NUM 19:4"/>ካህነይ አላዛር እ ሱፈ ጉራ ኤክድ ባ ብራያን ጌሻ ዱንካንያኮ ስሚድ ላፑን ቶሆ ዉርፆ። <verse eid="NUM 19:4"/><verse number="5" style="v" sid="NUM 19:5"/>ካህነይ በእሽን ኡስያ ፁገቶ፤ ጋልባይ፥ አሾይ፥ ሱይነ ቶጨይ ፁገቶ። <verse eid="NUM 19:5"/><verse number="6" style="v" sid="NUM 19:6"/>ካህነይ ዝጋ ም፥ ህሶጰ ታሸነ ዞኦ ቃጭና ኤክድ ኡስያ ኤፅያ ታማን የጎ። <verse eid="NUM 19:6"/><verse number="7" style="v" sid="NUM 19:7"/>ሄሳፈ ጉየ ካህነይ ባ ማኡዋነ ባ አሳተ ሜጨትድ ጉታ ገሎ፤ ሽን ኦማርስ ጋካናዉ ዎጋዳ ቱና ግዳና። <verse eid="NUM 19:7"/><verse number="8" style="v" sid="NUM 19:8"/>ሄ ኡስዉ ፁግዳይስ ባ ማኡዋነ ባ አሳተ ሜጨቶ፤ እካ ኦማርስ ጋካናዉ ዎጋዳ ቱና ግዳና።<verse eid="NUM 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9"/>“ሄሳፈ ጉየ፥ ሀራ ጌሻ አስ ኡስያ ፁገትዳ ብዱዋ ሺሽድ ጉታፐ ጋፃን ጌሻ በሳን ዎ። እስራኤለ አሳይ ቱናተፈ ጌሽያ ሃን ጎኤታናዉ ሄስ ናገትድ ኡታና፤ ሄስ ናጋራፐ ጌሻናዉ ጎኤስ። <verse eid="NUM 19:9"/><verse number="10" style="v" sid="NUM 19:10"/>ቃስ ኡሴ ብዱዋ ሺሽዳ ኡራይካ ባ ማኡዋ ሜጮ፤ እ ኦማርስ ጋካናዉ ዎጋዳ ቱና ግዳና። ሀ ዎጋይ እስራኤለ አሳስነ ኤንታ ግዶን ደእያ ሀራ ደረ አሳስ መርና ዎጋ ግዳና።<verse eid="NUM 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11"/>“አሀ ቦችያ ኦንካ ላፑን ጋላስ ዎጋዳ ቱና ግዳና። <verse eid="NUM 19:11"/><verse number="12" style="v" sid="NUM 19:12"/>ቱናተፈ ጌሽያ ሃን ሄን ጋላስነ ላፑን ጋላስ እ ባና ጌሾ፤ ሄሳፈ ጉየ፥ እ ዎጋዳ ጌሽ ግዳና። ሽን ሄን ጋላስነ ላፑን ጋላስ እ ባና ጌሾና እፅኮ እ ጌሽ ግደና። <verse eid="NUM 19:12"/><verse number="13" style="v" sid="NUM 19:13"/>ሀይቅዳ አሳ አሀ ቦችያ ኦንካ ባና ጌሾና እፅኮ እ ጎዳ ዱንካንያ ቱንሴስ፤ ሄ ኡራይ እስራኤለ አሳ ግዶፈ ኩረቶ። ቱናተፈ ጌሽያ ሃይ እያ ቦላ ዉርፀትቦና ግሾ እ ቱና፤ እ ቱና ግድድ ጋምኤስ።<verse eid="NUM 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14"/>“እስ አስ ዱንካንያ ግዶን ሀይቅኮ ኦና ዎጋይ ሀይሳ፤ ዱንካንያ ግዶ ገልያ ኦንካ፥ ቃስ ዱንካንያ ግዶን ደእያ ኦንካ ላፑን ጋላስ ጋካናዉ ቱና ግዳና። <verse eid="NUM 19:14"/><verse number="15" style="v" sid="NUM 19:15"/>ሄሳዳካ፥ ካመቶና ዶያ ደእያ ሚሸ ኡባይ ቱና ግዳና። <verse eid="NUM 19:15"/><verse number="16" style="v" sid="NUM 19:16"/>ቃስ ደንባን ሀይቅዳ አሳ አሀ ዎይኮ ሀርገትድ ሀይቅዳ አሳ አሀ ዎይኮ መቀ ዎይኮ ዱፎ ቦችያ ኦንካ ላፑን ጋላስ ጋካናዉ ቱና ግዳና።<verse eid="NUM 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17"/>“ቱናተፈ ጌሻናዉ ፁገትዳ ኡሴ ብዱዋፐ ጉራ ኤካዳ ኦቶን የጋዳ ፑልቶ ሃ እያ ቦላ ትጋ። <verse eid="NUM 19:17"/><verse number="18" style="v" sid="NUM 19:18"/>ጌሻ አስ ህሶጰ ውርጮ ኤክድ ሃን ናቅ ከስድ፥ ዱንካንያ፥ እያ ግዶን ደእያ ሚሽያነ አሳ ኡባ ቦላ ዉርፆ። ቃስ ሀይቅዳ አሳ አሀ ዎይኮ መቀ ዎይኮ ዱፎ ዎይኮ ሀርገት ሀይቅዳ አስ ቦችዳ አሳ ቦላ ዉርፆ። <verse eid="NUM 19:18"/><verse number="19" style="v" sid="NUM 19:19"/>ጌይዳ አስ ሄን ጋላስነ ላፑን ጋላስ ጌይቦና ኡራ ቦላ ዉርፆ። እ ላፑን ጋላስ ሄ ኡራ ቱናተፈ ጌሾ፤ ሄ ጌይዳ አደይ፥ ባ ማኡዋነ ባ አሳተ ሜጨቶ፤ ሄ ጋላስ ኦማርስ እ ጌሽ ግዳና።<verse eid="NUM 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 19:20"/>“ሽን ቱና ኡራይ ባና ጌሾና እፅኮ፥ ሄ ኡራይ ጌሻ ዱንካንያ ቱንስዳ ግሾ፥ እስራኤለ አሳ ግዶፈ ኩረቶ፤ ቱናተፈ ጌሽያ ሃይ እያ ቦላ ዉርፀትቦና ግሾ እ ቱና። <verse eid="NUM 19:20"/><verse number="21" style="v" sid="NUM 19:21"/>ሀይስ ህንተዉ መርና ዎጋ ግዳና። ቱናተፈ ጌሽያ ሃ ዉርፅያ ኡራይ ባ ማኡዋ ሜጮ፤ ቃስ ቱናተፈ ጌሽያ ሃ ቦችያ ኦንካ ኦማርስ ጋካናዉ ቱና ግዳና። <verse eid="NUM 19:21"/><verse number="22" style="v" sid="NUM 19:22"/>ቱና ኡራይ ቦችያ አይብባይካ ቱኔስ፤ ቃስ ሄ ሚሽያ ቦችያ ኦንካ ኦማርስ ጋካናዉ ቱና ግዴስ” ያግስ።<verse eid="NUM 19:22"/></para>
  <chapter eid="NUM 19"/>
  <chapter number="20" style="c" sid="NUM 20"/>
  <para style="s1">ዛላፈ ፑልትዳ ሃ</para>
  <para style="r">(<ref loc="EXO 17:1-7">ከሳ 17:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1"/>ኮይሮ አጌናን እስራኤለ አሳ ኡባይ ሲና መላ ቢታ ጋክድ፥ ቃደሳ ጌተትያ በሳን ዱንካንዶሶና። ማይራማ ያን ሀይቃዳ ሞገታሱ።<verse eid="NUM 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2"/>ሄ በሳን አሳስ ሃ ይን፥ አሳይ ሙሰ ቦላነ አሮና ቦላ ደንድዶሶና። <verse eid="NUM 20:2"/><verse number="3" style="v" sid="NUM 20:3"/>ኤንቲ፥ “ኑ እሻት ጎዳ ስንን ሀይቅዳ ዎደ ኑካ ሀይቅዳ ግዶርኮሽን። <verse eid="NUM 20:3"/><verse number="4" style="v" sid="NUM 20:4"/>ኑነ ኑ መሄይ ሀ መላ ቢታን ሀይቃና መላ ጎዳ ማባራ ሀ በሳ አይስ ኤህደቲ? <verse eid="NUM 20:4"/><verse number="5" style="v" sid="NUM 20:5"/>ግብፀፈ ከስድ ሀ ኢታ በሳ ኑና አይስ ኤህደቲ? ሀይሳን ካ ዎይኮ ባላሰይ ዎይኮ ዎይነይ ዎይኮ ኦሮማነይ ባዋ፤ ሀር አቶሽን ኡየትያ ሃካ ሀይሳን ባዋ” ያግድ ሙሰራ ካጨትዶሶና።<verse eid="NUM 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6"/>ያትን ሙሰይነ አሮን አሳ ማታፐ ጌሻ ዱንካንያ ፐንገ ብድ ሳአን ጉፋንዶሶና፤ ጎዳ ቦንቾይካ ኤንታዉ ቆንጭስ። <verse eid="NUM 20:6"/><verse number="7" style="v" sid="NUM 20:7"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 20:7"/><verse number="8" style="v" sid="NUM 20:8"/>“ነ ፃምአ ኤካ፤ ኔራነ ነ እሻ አሮናራ ማባራ ሺሽተ። ኤንታ ስንን ዛላይ ሃ ከሳና መላ ኦዳ። ህንተ ዛላፈ ሃ ከስድ፥ ኤንታነ ኤንታ መህያ ኡሻና” ያግስ። <verse eid="NUM 20:8"/><verse number="9" style="v" sid="NUM 20:9"/>ጎዳይ ኪትዳይሳዳ ሙሰይ ጎዳ ስንፈ ፃምኣ ኤክስ።<verse eid="NUM 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 20:10"/>ሙሰይነ አሮን ማባራ ዛላ ስንን ሺቃና መላ ኦድ፥ አሳኮ፥ “ህንተኖ ጌላቶ፥ ስእተ፤ ሀ ዛላፈ ህንተዉ ኑኒ ቱማ ሃ ከሳኔ?” ያግስ። <verse eid="NUM 20:10"/><verse number="11" style="v" sid="NUM 20:11"/>ሙሰይ ባ ፃምአ ደንድ ዛላ ናምኡ ቶሆ ሾጭስ፤ ሃ ቅድ ከይን ኤንትነ ኤንታ መሄት ኡይዶሶና።<verse eid="NUM 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12"/>ሽን ጎዳይ ሙሰኮነ አሮናኮ፥ “እስራኤለ አሳ ስንን ህንተ ታ ጌሻተ በሳናዉ አማነትቦና ግሾ ታ ኤንታዉ እምያ ቢታ ሀ አሳ ካለድ ህንተ ገለከታ” ያግስ።<verse eid="NUM 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 20:13"/>እስራኤለ አሳይ ጎዳራ ካጨትዳ ግሾነ ጎዳይ ባ ጌሻተ ኤንታ ግዶን ቆንጭስዳ ግሾ ሄ በሳይ ማርባ<note caller="+" style="f"><char style="fr" closed="false">20:13 </char><char style="fq" closed="false">ማርባ፦ </char><char style="ft" closed="false">ካጨተ ጉሱ።</char></note> ሃ ጌተትስ።<verse eid="NUM 20:13"/></para>
  <para style="s1">እስራኤለት ኤዶመራ አ ድገትዶሶና</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14"/>ኤዶመ ካዋኮ ሙሰይ ቃደሳፐ ሀይሳዳ ያግድ ኪታ የድስ። “ነ እሻይ እስራኤለይ ሀይሳዳ ያጌስ፤ ኑና ጋክዳ መቶ ኡባ ነ ስአዳሳ። <verse eid="NUM 20:14"/><verse number="15" style="v" sid="NUM 20:15"/>ኑ ማይዛት ዱገ ግብፀ ዎዶሶና፤ ያን ኑኒ ዳሮ ላይ ደእዳ። ግብፀት ኑናነ ኑ አዋታ ኡንኤዶሶና። <verse eid="NUM 20:15"/><verse number="16" style="v" sid="NUM 20:16"/>ኑኒ ጎዳኮ ዋስን፥ እ ኑ ዋሱዋ ስእድ፥ ባ ኪታንቹዋ ኪትድ ኑና ግብፀፈ ከስስ። ሀእ ኑኒ ነ ቢታ ጋፃን ደእያ ቃደሳ ካታማን ደኦስ። <verse eid="NUM 20:16"/><verse number="17" style="v" sid="NUM 20:17"/>ሀያና፥ ኑኒ ነ ቢታራ ካንድ አና መላ ኦርክ፤ ኑኒ ኦገፐ ጋፃ ከዮኮ፤ ነ ጎሻ ዎይኮ ዎይነ ጋደ ግዶ ገሎኮ፤ ኑኒ ሃ ኦላፈ ሃ ኡዮኮ። ኑኒ ካዎ ኦገ ኦይክድ ባና፤ ኑኒ ነ ቢታራ ካንድ አና ጋካናዉ ሀድርስ ዎይኮ ኡሻች ጎኮ” ያግስ።<verse eid="NUM 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18"/>ሽን ኤዶመ አሳይ፥ “ኑ ቢታራ ካንሶኮ፤ ህንተ ሀይሳራ ካንናዉ ቆፕኮ፥ ኑኒ ደንድድ ህንተና ኦላና” ያግዶሶና።<verse eid="NUM 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19"/>ያትን እስራኤለ አሳይ፥ “ኑኒ ካዎ ኦግያራ ባና፤ ኑኒ ዎይኮ ኑ መሄይ ህንተ ሃፈ ኡይኮ፥ ኑኒ ሄሳስ ጋተ ጭጋና፤ ኑኒ ቶሆራ አ ፃላላ ኮዮስ፤ ሀራባ አይኮካ ኮዮኮ” ያግዶሶና።<verse eid="NUM 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20"/>ኤዶመ አሳይ ዛሪድ፥ “ህንተ ሀይሳራ አናዉ ዳንዳኤከታ” ያግስ። ካልድ፥ ዳሮነ ዎልቃማ ኦላንቾታ ኤክድ እስራኤለ አሳ ኦላናዉ ከይስ። <verse eid="NUM 20:20"/><verse number="21" style="v" sid="NUM 20:21"/>ኤዶመ አሳይ ባንታ ቢታራ እስራኤለ አሳ አና እፅን፥ እስራኤለ አሳይ ስሚድ ሀራ ኦገራ ብዶሶና።<verse eid="NUM 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22"/>እስራኤለ አሳ ኡባይ ቃደሳፐ ደንድድ ሆራ ዙማኮ ብዶሶና። <verse eid="NUM 20:22"/><verse number="23" style="v" sid="NUM 20:23"/>ኤዶመ ዛዋን ደእያ ሆራ ዙማን፥ ጎዳይ ሙሰኮነ አሮናኮ፥ <verse eid="NUM 20:23"/><verse number="24" style="v" sid="NUM 20:24"/>“አሮን ባ ማይዛታን ጋሄትያ ዎደይ ጋክስ። ህንተ ናምአይ ማርባ ሃ ማታን ታ ኪታ ቦላ ጌላትዳ ግሾ እስራኤለ አሳስ ታ እምያ ቢታ እ ገለና። <verse eid="NUM 20:24"/><verse number="25" style="v" sid="NUM 20:25"/>አሮናነ እያ ናኣ አላዛራ ኤካዳ ሆራ ዙማ ቦላ ከያ። <verse eid="NUM 20:25"/><verse number="26" style="v" sid="NUM 20:26"/>አሮና ካህነተ ማኡዋ ቃራዳ፥ እያ ናኣ አላዛራ ማይዛ። አሮን ያን ሀይቃና” ያግስ።<verse eid="NUM 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27"/>ጎዳይ ኪትዳይሳዳ ሙሰይ ኦስ፤ እስራኤለ አሳ ኡባይ በእሽን፥ ኤንቲ ሆራ ዙማ ቦላ ከይዶሶና። <verse eid="NUM 20:27"/><verse number="28" style="v" sid="NUM 20:28"/>ሙሰይ አሮና ካህነተ ማኡዋ ቃርድ እያ ናኣ አላዛራ ማይዝስ። አሮን ሄ ዙማ ሁጰን ሀይቅስ። ሙሰይነ አላዛር ዙማፐ ዎዶሶና። <verse eid="NUM 20:28"/><verse number="29" style="v" sid="NUM 20:29"/>አሮን ሀይቅዳይሳ እስራኤለ አሳይ ኤርዳ ዎደ እስራኤለ አሳይ አሮናስ ሀስታሙ ጋላስ ዬክዶሶና።<verse eid="NUM 20:29"/></para>
  <chapter eid="NUM 20"/>
  <chapter number="21" style="c" sid="NUM 21"/>
  <para style="s1">አራዳ ፆነተ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1"/>ካናነ ቢታን፥ ነገበ መላ ቢታን ደእያ አራዳ ካዎይ፥ እስራኤለ አሳይ አታርማ ኤፍያ ኦግያራ የይሳ ስእዳ ዎደ እስራኤለ አሳራ ኦለትድ ኤንታፈ ጉ አሳ ድእዶሶና። <verse eid="NUM 21:1"/><verse number="2" style="v" sid="NUM 21:2"/>ሄ ዎደ እስራኤለ አሳይ፥ “ኔኒ ሀ አሳ ኑ ኩሸን አዳ እምኮ፥ ኑኒ ኤንታነ ኤንታ ካታማታ ኩመ ይሳና” ያግድ ጎዳስ ቃንግዶሶና። <verse eid="NUM 21:2"/><verse number="3" style="v" sid="NUM 21:3"/>ጎዳይ እስራኤለ አሳ ዎሳ ስእድ፥ ካናነታ ኤንታ ኩሸን አድ እምን፥ ኤንቲ ካናነታነ ኤንታ ካታማታ ኩመ ይስዶሶና። ሄሳ ግሾ፥ ሄ በሳይ ሆርማ<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="fq" closed="false">ሆርማ፦ </char><char style="ft" closed="false">ኩመ ዎይኮ ፖሎ ይሶ ጉሱ</char></note> ጌተትድ ሱንትስ።<verse eid="NUM 21:3"/></para>
  <para style="s1">ናሰ ብራታፐ ኦሰትዳ ሾሹ</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4"/>እስራኤለ አሳይ ሆራ ዙማፐ ደንድድ፥ ኤዶመ ቢታ ዩሹዋራ ባናዉ ዞኦ አባኮ ኤፍያ ኦግያራ ብዶሶና፤ ሽን ኦገ ቦላ አሳስ ዳንዳአይ ዉርስ። <verse eid="NUM 21:4"/><verse number="5" style="v" sid="NUM 21:5"/>አሳይ፥ “ኑኒ መላ ቢታ ሀይቃና መላ ግብፀፈ ኑና አይስ ከስደቲ? ካ ባዋ፤ ሃ ባዋ፤ ሀ ኢታ ካይ ኑና ሻትስ” ያግድ ፆሳ ቦላነ ሙሰ ቦላ ዙዙምዶሶና።<verse eid="NUM 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 21:6"/>ያትን፥ ጎዳይ አሳ ግዶ ማርዘራ ደእያ ሾሽ የድን፥ እስራኤለ አሳፐ ዳሮት ዱከትድ ሀይቅዶሶና። <verse eid="NUM 21:6"/><verse number="7" style="v" sid="NUM 21:7"/>አሳይ ሙሰኮ ይድ፥ “ኑኒ ጎዳ ቦላነ ነ ቦላ ዙዙምድ፥ ናጋራ ኦዳ። ጎዳይ ሀ ሾሻታ ኑፐ ሃሳና መላ ኑስ ዎሳርክ” ያግዶሶና። ያትን፥ ሙሰይ አሳ ግሾ ዎስስ።<verse eid="NUM 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8"/>ሄ ዎደ ጎዳይ ሙሰኮ፥ “ናሰ ብራታፐ ሾሽ መዳ፥ ኤንታ ስንን ም ቦላ ካቃ፤ ሾሻን ዱከትዳ ኦንካ እያ በእኮ ፓፃና” ያግስ። <verse eid="NUM 21:8"/><verse number="9" style="v" sid="NUM 21:9"/>ያትን፥ ሙሰይ ናሰ ብራታፐ ሾሽ መድ፥ ም ቦላ ካቅስ። ሾሻን ዱከትዳ አሳ ኡባይ ናሰ ብራታ ሾሻ በእድ ፓፅዶሶና።<verse eid="NUM 21:9"/></para>
  <para style="s1">ሆራ ዙማፐ ሞአበ ጋካናዉ</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10"/>እስራኤለ አሳይ ሆራፐ ደንድድ ኦቦታ ጌተትያ በሳን ዱንካንዶሶና። <verse eid="NUM 21:10"/><verse number="11" style="v" sid="NUM 21:11"/>ኦቦታፐ ደንድድ፥ ሞአበፐ ስን ባጋን ደእያ መላ ቢታን፥ ዶሎሀ ባጋን አባሪማን ዱንካንዶሶና። <verse eid="NUM 21:11"/><verse number="12" style="v" sid="NUM 21:12"/>ያፐ ደንድድ፥ ዛሬዳ ዛንጋራን ዱንካንዶሶና። <verse eid="NUM 21:12"/><verse number="13" style="v" sid="NUM 21:13"/>ያፐ ደንድድ፥ አሞረታ ቢታ ጋፃ ጋካናዉ ደእያ መላ ቢታን አርኖና ሻፋፐ ሄፍንን ዱንካንዶሶና። አርኖና ሻፋይ ሞአበ ቢታስነ አሞረ ቢታስ ግዶን ደእያ ዛዋ። <verse eid="NUM 21:13"/><verse number="14" style="v" sid="NUM 21:14"/>ሄሳ ግሾ፥ ጎዳ ኦላ ታርክያ ኦድያ ማፃፋን፥ “ሱፋ ሄራን ደእያ ዋሄባ ካታማነ አርኖና ሻፋ ዛንጋራ፥ <verse eid="NUM 21:14"/><verse number="15" style="v" sid="NUM 21:15"/>ኤራ ካታማነ ሞአበ ቢታ ዛዋ ጋካናዉ ደእያ ዛንጋራ” ያገትድ ፃፈትስ።<verse eid="NUM 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 21:16"/>ኤንቲ ያፐ ደንድድ፥ ጎዳይ ሙሰኮ፥ “አሳ ሺሻ፤ ታ ኤንታዉ ሃ እማና” ያግድ ኦድዳ ቤራ ጌተትያ ሃ ኦላኮ ብዶሶና።<verse eid="NUM 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17"/>ሄ ዎደ እስራኤለ አሳይ ሀ ማዝሙርያ የፅዶሶና።</para>
  <para style="q1" vid="NUM 21:17">“ሃ ኦላዉ፥ ፑልታ፤</para>
  <para style="q2" vid="NUM 21:17">ህንተካ የፅተ።<verse eid="NUM 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18"/>ሀላቃት ቦክዳ ሃ ኦላስ፥</para>
  <para style="q2" vid="NUM 21:18">ካለይሳት ካዎተ ፃምአንነ ባንታ ፃምአን</para>
  <para style="q2" vid="NUM 21:18">ቦክዳ ሃ ኦላስ የፅተ” ያግስ።</para>
  <para style="p" vid="NUM 21:18">ኤንቲ ሄ መላ ቢታፈ ደንድድ ማታና ጌተትያ በሳ ብዶሶና። <verse eid="NUM 21:18"/><verse number="19" style="v" sid="NUM 21:19"/>ማታናፐ ናህልኤላ፥ ናሀልኤላፐ ባሞታ ጌተትያ በሳ ብዶሶና። <verse eid="NUM 21:19"/><verse number="20" style="v" sid="NUM 21:20"/>ባሞታፐ ደንድድ፥ ሞአበን ደእያ ዛንጋራ ብዶሶና፤ ሄ ዛንጋራይ ፕስጋ ዙማፐ ጋርሳን ባዙዋ ግናን ደኤስ።<verse eid="NUM 21:20"/></para>
  <para style="s1">ስሆናነ ኦገ ፆነተ</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21"/>ሄሳፈ ጉየ፥ እስራኤለ አሳይ አሞረ ካዋ ስሆነኮ ሀይሳዳ ያግድ ኪታ የድዶሶና። <verse eid="NUM 21:21"/><verse number="22" style="v" sid="NUM 21:22"/>“ሀያና፥ ኑ ነ ቢታራ ካንድ አና መላ ኦርክ፤ ኑኒ ኦገፐ ጋፃ ከዮኮ፤ ነ ጎሻ ዎይኮ ዎይነ ጋደ ግዶ ገሎኮ፤ ኑኒ ሃ ኦላፈ ሃ ኡዮኮ። ኑኒ ነ ቢታራ ካንድ አና ጋካናዉ ሀድርስ ዎይኮ ኡሻች ጎኮ” ያግስ።<verse eid="NUM 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23"/>ስሆነይ እስራኤለ አሳይ ባ ቢታራ ካንና መላ ድግስ። እ ባ ኦላንቾታ ኡባ ሺሽድ፥ እስራኤለ አሳ ኦላናዉ መላ ቢታ ብስ፤ ያሃፃ ጌተትያ በሳ ብድ እስራኤለ አሳራ ኦለትስ። <verse eid="NUM 21:23"/><verse number="24" style="v" sid="NUM 21:24"/>እስራኤለ አሳይ ኦላን አሞረታፐ ዳሮታ ማሻን ዎድ፥ አርኖና ሻፋፐ ዶምድ፥ አሞነታ ዛዋን ደእያ ያቦቃ ሻፋ ጋካናዉ ኦይክስ። አሞነ አሳ ቢታ ዛዋይ ግምበትድ ደእያ ግሾ፥ ኤንቲ ያ ገልቦኮና። <verse eid="NUM 21:24"/><verse number="25" style="v" sid="NUM 21:25"/>እስራኤለ አሳይ አሞረታ፥ ሀሰቦናነ እያ ዩሹዋን ደእያ ካታማታ ኡባ ፆን ኤክድ ያን ኡትዶሶና። <verse eid="NUM 21:25"/><verse number="26" style="v" sid="NUM 21:26"/>ሀሰቦና ካታማይ አሞረታ ካዋ ስሆነ ኡትያ ካታማ። ስሆነይ ካሰ ሞአበ ቢታ ካዋ ኦልድ፥ አርኖና ሻፋ ጋካናዉ ደእያ ቢታ ኡባ ኤክስ።<verse eid="NUM 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 21:27"/>ሄሳ ግሾ፥ ሌምሶን ሀይሳዳ ያግዶሶና፤</para>
  <para style="q1" vid="NUM 21:27">“ሀሰቦናኮ ሃይተ፤</para>
  <para style="q2" vid="NUM 21:27">ሀ ካታማይ ዛሪድ ኬፀቶ፤</para>
  <para style="q1" vid="NUM 21:27">ስሆነ ካታማይ</para>
  <para style="q2" vid="NUM 21:27">ካሰ ባ በሳ ስሞ።<verse eid="NUM 21:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28"/>ታም ሀሰቦናፐ ከይስ፤</para>
  <para style="q2" vid="NUM 21:28">ላጮይ ስሆና ካታማን በንትስ፤</para>
  <para style="q1" vid="NUM 21:28">ሞአበን ደእያ ኤራ ይስስ፤</para>
  <para style="q2" vid="NUM 21:28">አርኖና ቃ በሳታ ምስ።<verse eid="NUM 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29"/>ሞአበ፥ ነና አየ!</para>
  <para style="q2" vid="NUM 21:29">ካሞሻ አሳይ ይደታ።</para>
  <para style="q1" vid="NUM 21:29">ህንተ አደ ናይት ባቃታናዳ፥</para>
  <para style="q2" vid="NUM 21:29">ህንተ ማጫ ናይት ድኤታናዳ፥</para>
  <para style="q2" vid="NUM 21:29">አሞረታ ካዋ ስሆነስ እሚስ።<verse eid="NUM 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30"/>ኑኒ ህንተ ኮቻታ ሀሰቦናፐ ዶምድ፥</para>
  <para style="q2" vid="NUM 21:30">ድቦና ጋካናዉ ኩመ ይስዳ።</para>
  <para style="q1" vid="NUM 21:30">መደባ ማታን ደእያ ኖፋ ጋካናዉ</para>
  <para style="q2" vid="NUM 21:30">ደእያ ኡባ ታም ይስስ” ያግዶሶና።<verse eid="NUM 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31"/>ያትድ፥ እስራኤለ አሳይ አሞረታ ቢታን ደእዶሶና። <verse eid="NUM 21:31"/><verse number="32" style="v" sid="NUM 21:32"/>ቃስ ሙሰይ ዎቸይሳታ ያእዜራ ካታማ የድን፥ እስራኤለ አሳይ ሄ ካታማነ እያ ሄራን ደእያ ጉ ካታማታ ኦይክድ፥ ያን ደእያ አሞረታ ከስድ ጎድዶሶና።<verse eid="NUM 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 21:33"/>ሄሳፈ ጉየ፥ እስራኤለ አሳይ ስሚድ፥ ባሳነ ኤፍያ ኦግያራ ከይዶሶና። ባሳነ ካዎይ ኦገይ ባ ኦላንቾታራ ኤድራአ ካታማን ኤንታራ ኦለታናዉ ከይስ። <verse eid="NUM 21:33"/><verse number="34" style="v" sid="NUM 21:34"/>ሽን ጎዳይ ሙሰኮ፥ “ሀ ኡራስ ባቦፋ፤ ህዛ፥ ካዋ ኦገ፥ እያ አሳነ እያ ቢታ ኡባ ነ ኩሸን አዳ እማስ። ሀሰቦናን ኡትድ ሃርዳ አሞረታ ካዋ ስሆነ ቦላ ኦይሳዳ ኔኒ እያ ቦላ ኦና” ያግስ። <verse eid="NUM 21:34"/><verse number="35" style="v" sid="NUM 21:35"/>ሄሳ ግሾ፥ እስራኤለ አሳይ ኦገ፥ እያ ናይታነ እያ አሳ ኡባ እሶይ አቶና ዎድ እያ ቢታ ላትዶሶና።<verse eid="NUM 21:35"/></para>
  <chapter eid="NUM 21"/>
  <chapter number="22" style="c" sid="NUM 22"/>
  <para style="s1">ባላቅ ባላማ ፄግስስ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1"/>እስራኤለ አሳይ ደንድድ፥ እያርኮ ግናን፥ ዮርዳኖሰፐ ሄፍንን ደእያ ሞአበ ደንባን ዱንካንዶሶና።<verse eid="NUM 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2"/>እስራኤለ አሳይ አሞረታ ቦላ ኦዳይሳ ኡባ ስፎራ ናአይ ባላቅ ስእስ። <verse eid="NUM 22:2"/><verse number="3" style="v" sid="NUM 22:3"/>እስራኤለ አሳይ ዳሮ ግድዳ ግሾ፥ ሞአበት ዳሮ ዳጋምድ ያይዶሶና። <verse eid="NUM 22:3"/><verse number="4" style="v" sid="NUM 22:4"/>ሞአበት ምድያመ ጭማታኮ፥ “ቦር ማታ ፕትድ ምድ ይሰይሳዳ ሀ ዉደ አሳይ ኑ ዩሹዋን ደእያ ኡባ ምድ ይሳና” ያግዶሶና።</para>
  <para style="p" vid="NUM 22:4">ሄ ዎደ ሞአበ ካዎይ፥ ስፎራ ናአይ ባላቅ፥ <verse eid="NUM 22:4"/><verse number="5" style="v" sid="NUM 22:5"/>አማዋ ቢታን፥ ኤፍራፂሳ ሻፋ ማታን፥ ፓቶራ ካታማን ደእያ ብኦራ ናኣ ባላማኮ ሀይሳዳ ያግድ ኪትስ። “ግብፀፈ ከይዳ ዳሮ አሳይ ቢታ ኡባ ማእድ፥ ታ ማታን ዱንካንዶሶና። <verse eid="NUM 22:5"/><verse number="6" style="v" sid="NUM 22:6"/>ኤንቲ ታፐ ዳሮ ዎልቃማ ግድያ ግሾ፥ ሀያና ያዳ ኤንታ ባዳርክ። ኦን ኤር፥ ታ ኤንታ ፆናናዉነ ቢታፈ ከሳናዉ ዳንዳአና። ህዛ፥ ኔኒ አንጀይስ አንጀተይሳ ቃስ ኔኒ ባደይስ ባደትዳባ ግደይሳ ታኒ ኤራይስ” ያግስ።<verse eid="NUM 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7"/>ሞአበ ጭማትነ ምድያመ ጭማት ባደ ሚሽያ ኤክድ ባላማኮ ብድ ባላቅ ግዳይሳ እያዉ ኦድዶሶና። <verse eid="NUM 22:7"/><verse number="8" style="v" sid="NUM 22:8"/>ባላም ኤንታኮ፥ “ሀች ቃማ ሀይሳን አቅተ፤ ጎዳይ ታዉ ኦደይሳ ታ ህንተዉ ኦዳና” ያግስ። ያንን፥ ሞአበ ሀላቃት ባላማራ ጋምእዶሶና።<verse eid="NUM 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9"/>ፆሳይ ባላማ፥ “ሀይሳቲ ኔራ ደእያ አሳት ኦኔ?” ያግድ ኦይችስ።<verse eid="NUM 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10"/>ባላም ፆሳኮ፥ “ሞአበ ካዎይ፥ ስፎራ ናአይ ባላቅ፥ <verse eid="NUM 22:10"/><verse number="11" style="v" sid="NUM 22:11"/>‘ግብፀፈ ከይዳ ዳሮ አሳይ፥ ኤንቲ ቢታ ኡባ ኩምዶሶና። ኔኒ ያዳ፥ ኤንታ ባዳርክ። ኦን ኤር፥ ታ ኤንታ ፆናናዉነ ቢታፈ ከሳናዉ ዳንዳኦና አግከ’ ያግድ ኤንታ ታኮ ኪትስ” ያግስ።<verse eid="NUM 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12"/>ያትን ፆሳይ ባላማኮ፥ “ኔኒ ኤንታራ ቦፓ፤ እስራኤለ አሳይ አንጀትዳ ደረ ግድያ ግሾ፥ ኔኒ ኤንታ ባዶፋ” ያግስ።<verse eid="NUM 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13"/>ዎንተ ጋላስ ዎንታ ባላም ደንድድ፥ ባላቃ ሀላቃታኮ፥ “ታኒ ህንተራ ቦናዳ ጎዳይ ድግዳ ግሾ፥ ህንተ ቢታ ስምተ” ያግስ።<verse eid="NUM 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14"/>ሞአበ ሀላቃት ባላቃኮ ጉየ ስሚድ፥ “ባላም ኑራ ዮና እፅስ” ያግዶሶና።<verse eid="NUM 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15"/>ዛሪድ ባላቅ ካሰይሳታፐ አ ቦንቸትዳነ ታይቦን ዳሮ ሀላቃታ እያኮ ኪትስ። <verse eid="NUM 22:15"/><verse number="16" style="v" sid="NUM 22:16"/>ኤንቲ ባላማኮ ብድ፥ “ስፎራ ናአይ ባላቅ፥ ‘ኔኒ ታኮ ያናይሳ ነና አይብካ ተቆፎ። <verse eid="NUM 22:16"/><verse number="17" style="v" sid="NUM 22:17"/>ታ ነዉ ዳሮ ዎይቶ እማና፤ ነ ኦይችያባ ኡባ ታ ነዉ ኦና። ሀያና ያዳ ሀ አሳ ባዳርክ’ ያግስ” ያግድ ኦድዶሶና።<verse eid="NUM 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18"/>ሽን ባላም ኤንታኮ፥ “ባላቅ ሀር አቶሽን ባ ካዎተን ኩምዳ ብራነ ዎርቃ ታዉ እምያባ ግድኮካ ጎዳ፥ ታ ፆሳ ኪታ መንዳ አይኮካ ፓጭሳናዉ ዎይኮ ጉጃናዉ ዳንዳእከ። <verse eid="NUM 22:18"/><verse number="19" style="v" sid="NUM 22:19"/>ጎዳይ ታዉ በሲያ ሀራባይ ደእኮ ታ ኤራና መላ ህንተካ ሀች ቃማ ሀይሳን አቅተ” ያግስ።<verse eid="NUM 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20"/>ሄ ቃማ ፆሳይ ባላማኮ፥ “ሀ አሳይ ነና ፄጋናዉ ይዳ ግሾ፥ ኔኒ ኤንታራ ባ፤ ሽን ታ ነዉ ኦደይሳ ፃላላ ኦ” ያግስ።<verse eid="NUM 22:20"/></para>
  <para style="s1">ባላማነ እያ ሃሪዉ</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21"/>ያትን ዎንተ ጋላስ ባላም ባ ሃሪው ኮርድ ሞአበ ሀላቃታራ ብስ። <verse eid="NUM 22:21"/><verse number="22" style="v" sid="NUM 22:22"/>ሽን እ ብያ ግሾ ፆሳይ ሀንቀትስ። ሄ ዎደ ባላም ባ ሃሪው ቶግድ፥ ባ ናምኡ አይለታራ ብሽን ጎዳ ኪታንቾይ እያ ተቃናዉ ኦገን ኤቅስ። <verse eid="NUM 22:22"/><verse number="23" style="v" sid="NUM 22:23"/>ጎዳ ኪታንቾይ ማሻ ሾድድ ኦገን ኤቅዳይሳ ሀሪያ በአዳ፥ ኦግያ አጋዳ ጎሻ ግዶ ገላሱ። ባላም ሀሪው ኦገን ዛራናዉ ሾጭስ።<verse eid="NUM 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 22:24"/>ያትን፥ ጎዳ ኪታንቾይ ናምኡ ዎይነ ጋደታፐ ግዶን ያ ባጋራነ ሀ ባጋራ ግምበን ድረትዳ ፁን ኦገን ኤቅስ። <verse eid="NUM 22:24"/><verse number="25" style="v" sid="NUM 22:25"/>ሀርያ ጎዳ ኪታንቹዋ በእዳ ዎደ ግምበ ድርሳኮ ሺቅዳ፥ ባላማ ቶሁዋ ግምበ ድርሳራ ኦይሱ፤ ያትን እ ሃሪው ናምአን ሾጭስ።<verse eid="NUM 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 22:26"/>ሄሳፈ ጉየ፥ ጎዳ ኪታንቾይ ስን አድ፥ ሀድርስ ዎይኮ ኡሻች ስማናዉ ኦገይ ባይና ፁን በሳን ኤቅስ። <verse eid="NUM 22:26"/><verse number="27" style="v" sid="NUM 22:27"/>ሀርያ ጎዳ ኪታንቹዋ በአዳ፥ ባላም ቶግድ ደእሽን ዝንአሱ፤ ባላም ዳሮ ይሎትድ፥ ባ ፃምአን ሃሪው ሾጭስ። <verse eid="NUM 22:27"/><verse number="28" style="v" sid="NUM 22:28"/>ሄሳፈ ጉየ፥ ጎዳይ ሀረይ ዶና ዶይን፥ ሀርያ ባላማ፥ “ታ ነዉ አይ ኢስን ታና ሄ ቶሆ ሾጫዲ?” ያጋሱ።<verse eid="NUM 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29"/>ባላም ዛሪድ፥ “ኔኒ ታና ይሎይዳ ግሾሳ፤ ታ ኩሸን ማሽ ደእያባ ግድያኮ ታ ነና ሀእ ዎናሽን” ያግስ።<verse eid="NUM 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30"/>ሃሪያ ባላማኮ፥ “ኔኒ ሀች ጋካናዉ ቶግያ ነ ሃሪው ግድክና? ታኒ ነዉ ሀይሳዳ ሀና ኤርያና?” ያጋሱ።</para>
  <para style="p" vid="NUM 22:30">ባላም ዛሪድ፥ “ሀና ኤራካ” ያግስ።<verse eid="NUM 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31"/>ሄ ዎደ ጎዳይ ባላማ አይፍያ ዶይን፥ ጎዳ ኪታንቾይ ሾደትዳ ማሻ ኦይክድ ኦገን ኤቅዳይሳ በእስ። እ ልች ግድ ሶምኦራ ሳአን ጉፋንስ። <verse eid="NUM 22:31"/><verse number="32" style="v" sid="NUM 22:32"/>ጎዳ ኪታንቾይ፥ “ነ ሃሪው ሄ ቶሆ አይስ ሾጫዲ? ነ ኦገይ ታ ስንን ጌላ ግድያ ግሾ ታ ነና ተቃናዉ ያስ። <verse eid="NUM 22:32"/><verse number="33" style="v" sid="NUM 22:33"/>ሀርያ ታና በአዳ ታ ስንፈ ሄ ቶሆ ሀራ ሶ ስማሱ። ሀርያ ሀራ ሶ ስማቦናባ ግድያኮ፥ ሀኖደ ታ ነና ዎዳ ሀርው አሻናሽን” ያግስ።<verse eid="NUM 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34"/>ባላም ዛሪድ፥ “ታኒ ናጋራ ኦስ፤ ኔኒ ታና ተቃናዉ ኦገ ቦላ ኤቅዳይሳ ታ ኤራብከ። ነ ዶሶናባ ግድኮ ታ ሀእ ጉየ ስማና” ያግስ።<verse eid="NUM 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35"/>ሽን ኪታንቾይ ባላማኮ፥ “ኔኒ ሀ አሳታራ ባ፤ ሽን ታ ነዉ ኦደይሳ ፃላላ ኦዳ” ያግስ። ያትን፥ ባላም ባላቃ ቢታ ሀላቃታራ ብስ።<verse eid="NUM 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36"/>ባላም የይሳ ባላቅ ስእዳ ዎደ አርኖና ሻፋ ጋፃን ባ ቢታ ዛዋን ደእያ ሞአበታ ካታማን እያ ሞካናዉ ብስ። <verse eid="NUM 22:36"/><verse number="37" style="v" sid="NUM 22:37"/>ባላቅ ባላማኮ፥ “ኔኒ ኤለሳዳ ያና መላ ታ ኪታብክና? ኔኒ አይስ ታኮ ኤለሳዳ ያብኪ? ታኒ ነዉ ኩሸ ዛራናዉ ዳንዳእክና?” ያግስ።<verse eid="NUM 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38"/>ባላም ባላቃኮ፥ “ሄኮ፥ ሀእ ታ ኔኮ ያስ፤ ሽን ታ አይኮካ ታፐ ጋናዉ ዳንዳእከ። ፆሳይ ታና ኦዳ ግዳባ ፃላላ ኦዳና” ያግስ። <verse eid="NUM 22:38"/><verse number="39" style="v" sid="NUM 22:39"/>ያትን፥ ባላም ባላቃራ ቅርያት-ሀፆታ ካታማ ብስ። <verse eid="NUM 22:39"/><verse number="40" style="v" sid="NUM 22:40"/>ያን ባላቅ መሄነ ዶርሰ ያርሽድ፥ አሹዋፐ ጉራ ባላማስነ እያራ ደእያ ሀላቃታስ እሚስ።<verse eid="NUM 22:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 22:41"/>ዎንተ ጋላስ ባላቅ ባላማ ባሞት-ባኣል ጌተትያ በሳ ከስስ፤ ባላም ያን ኤቅድ እስራኤለ አሳፐ ባጋ በእስ።<verse eid="NUM 22:41"/></para>
  <chapter eid="NUM 22"/>
  <chapter number="23" style="c" sid="NUM 23"/>
  <para style="s1">ባላማ ኮይሮ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1"/>ባላም ባላቃኮ፥ “ሀይሳን ታዉ ላፑን ያርሾ በሳታ ግምባ፤ ቃስ ላፑን ኮርማታነ ላፑን ማራዘታ ታዉ ጊግሳ” ያግስ። <verse eid="NUM 23:1"/><verse number="2" style="v" sid="NUM 23:2"/>ባላም ግዳይሳዳ ባላቅ ኦስ፤ ኤንቲ ናምአይ እስ እስ ያርሾ በሳን እስ ኮርማነ እስ ማራዘ ያርሽዶሶና።<verse eid="NUM 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 23:3"/>ያትድ፥ ባላም ባላቃኮ፥ “ኔኒ ነ ያርሹዋ ማታን ደኣሻ፤ ታኒ ገደ ባና። ኦን ኤር ጎዳይ ታራ ጋሄታናዉ ዮና አገና፤ እ ታዉ ቆንጭስያባ ኡባ ታ ነዉ ኦዳና” ያግድ እስ ደረ ቦላ ከይስ። <verse eid="NUM 23:3"/><verse number="4" style="v" sid="NUM 23:4"/>ያን ፆሳይ ባላማራ ጋሄትን፥ ባላም፥ “ታኒ ላፑን ያርሾ በሳታ ጊግሳስ፤ እስ እስ ያርሾ በሳን እስ ኮርማነ እስ ማራዘ ያርሻስ” ያግስ።<verse eid="NUM 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5"/>ባላም ጋናባ ጎዳይ እያዉ ኦድድ፥ “ኔኒ ባላቃኮ ስማዳ እያዉ ሀ ኪታ ኦዳ” ያግስ። <verse eid="NUM 23:5"/><verse number="6" style="v" sid="NUM 23:6"/>ባላም ስምያ ዎደ ባላቅ ሞአበ ሀላቃታ ኡባራ ባ ያርሹዋ ማታን ኤቅስ።<verse eid="NUM 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 23:7"/>ባላም ሀይሳዳ ያግድ ትንብተ ኦድስ፤</para>
  <para style="q1" vid="NUM 23:7">“ሞአበ ካዎይ፥ ባላቅ፥ ዶሎሀ ባጋ ደረታፐ፥</para>
  <para style="q2" vid="NUM 23:7">ሶረ ቢታፈ ታና ኤህስ፤</para>
  <para style="q1" vid="NUM 23:7">‘ሃ ያ፤ ያይቆባ ታዉ ባዳ፤</para>
  <para style="q2" vid="NUM 23:7">እስራኤለ አሳ ባዳ’ ያግስ።<verse eid="NUM 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8"/>ፆሲ ባድቦናይሳ ታ ዋታዳ ባዶ?</para>
  <para style="q1" vid="NUM 23:8">ጎዳይ፥ ባድቦናይሳ ታ ዋታዳ ባዶ?<verse eid="NUM 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9"/>ታ ቃ ዛላ ሁጰን ኤቃዳ ኤንታ ፄላይስ፤</para>
  <para style="q2" vid="NUM 23:9">ዙማ ቦላ ኤቃዳ ኤንታ በአይስ።</para>
  <para style="q1" vid="NUM 23:9">ኤንቲ ባንታርካ ደእያ ደረ፤</para>
  <para style="q2" vid="NUM 23:9">ኤንቲ ሀራ ካዎተታፐ ዱማ ግደይሳ ኤሮሶና።<verse eid="NUM 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10"/>ያይቆባ ባና ኦን ታይብ ኦንጋኔ?</para>
  <para style="q2" vid="NUM 23:10">እስራኤለ ሳይሱዋ ኦን ታይብ ካንኔ?</para>
  <para style="q1" vid="NUM 23:10">ፅሎታ ሀይቁዋ ታ ሀይቃርክና፤</para>
  <para style="q2" vid="NUM 23:10">ታ ዉርሰይ ኤንታይሳዳ ሀኖ” ያግስ።<verse eid="NUM 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11"/>ባላቅ ባላማኮ፥ “ኔኒ ታ ቦላ ኦያባይ አይቤ? ታኒ ነና ታ ሞርከታ ባዳና መላ ኤሀስ፥ ሽን ኔኒ ኤንታ አንጃዳሳ፤ ሀራባ አይኮካ ኦባካ” ያግስ።<verse eid="NUM 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12"/>ባላም ዛሪድ፥ “ጎዳይ ታዉ ኦደይሳፈ ሀራ ኦዶዬ?” ያግስ።<verse eid="NUM 23:12"/></para>
  <para style="s1">ባላማ ናምአን ሃሳያ</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13"/>ባላቅ ባላማኮ፥ “ኤንታ ኔኒ በአናዉ ዳንዳእያ ሀራ በሲ ታራ የ፤ ያንካ ነ ኤንታፈ ጉራ በኣሳፐ አትሽን፥ ኡባ በአካ። ኔኒ ያን ኤቃዳ ኤንታ ባዳርክ” ያግስ። <verse eid="NUM 23:13"/><verse number="14" style="v" sid="NUM 23:14"/>ፕስጋ ደርያ ሁጰን ደእያ ፆፍማ ደምባ ኤፍስ። ያን ላፑን ያርሾ በሳታ ግምብድ፥ እስ እስ ያርሾ በሳን እስ ኮርማነ እስ ማራዘ ያርሽስ።<verse eid="NUM 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15"/>ባላም ባላቃኮ፥ “ኔኒ ሀይሳን ነ ያርሹዋ ማታን ደኣሻ፤ ታኒ ጎዳራ ጋሄታናዉ ገደ ባና” ያግስ።<verse eid="NUM 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16"/>ጎዳይ ባላማራ ጋሄትድ፥ “ኔኒ ባላቃኮ ስማዳ እያዉ ሀ ኪታ ኦዳ” ያግስ።<verse eid="NUM 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17"/>ባላም ስሚድ ያ ዎደ ባላቅ ሞአበ ቢታ ሀላቃታራ ያርሹዋ ማታን ኤቅዳይሳ ደምስ። ባላቅ እያኮ፥ “ጎዳይ ነዉ አይ ኦድዴ?” ያግስ።<verse eid="NUM 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18"/>ባላም ሀይሳዳ ያግድ ትንብተ ኦድስ፤</para>
  <para style="q1" vid="NUM 23:18">“ስፎራ ናአዉ፥ ባላቃ፥ ደንዳ፤</para>
  <para style="q2" vid="NUM 23:18">ታ ኦደይሳ ሎይዳ ስአ።<verse eid="NUM 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19"/>ዎርዶታናዉ ፆሳይ አሰ ግደና፤</para>
  <para style="q2" vid="NUM 23:19">ባ ቆፋ ላማናዉ አሳ ናአ ግደና።</para>
  <para style="q1" vid="NUM 23:19">ኦድድ፥ ባ ኦድዳይሳ ኦኔ?</para>
  <para style="q2" vid="NUM 23:19">ዎይኮ ባ ግዳይሳ ፖለኔ?<verse eid="NUM 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20"/>ታኒ አንጃናዉ ኪታ ኤካስ፤</para>
  <para style="q2" vid="NUM 23:20">እ አንጅስ፤ ታ ላማናዉ ዳንዳእከ።<verse eid="NUM 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21"/>ያይቆባ ኮቻ ቦላ ኢታባይ ዬና፤</para>
  <para style="q2" vid="NUM 23:21">እስራኤለ አሳ መቶይ ጋከና።</para>
  <para style="q1" vid="NUM 23:21">ጎዳይ፥ ኤንታ ፆሳይ ኤንታራ ደኤስ፤</para>
  <para style="q2" vid="NUM 23:21">እ ኤንታዉ ካዎ ግደይሳ አዋጆሶና።<verse eid="NUM 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22"/>ፆሳይ ኤንታ ግብፀፈ ከስስ፤</para>
  <para style="q2" vid="NUM 23:22">እ ምኖ መንዳ ኤንታዉ ኦለቴስ።<verse eid="NUM 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23"/>ያይቆባ ኮቻ ቦላ ብት ኦና፤</para>
  <para style="q2" vid="NUM 23:23">እስራኤለ አሳ ቆሀና ሙሩኖይ ባዋ።</para>
  <para style="q1" vid="NUM 23:23">ሄኮ፥ ያይቆባስነ እስራኤለስ</para>
  <para style="q2" vid="NUM 23:23">‘ፆሳይ ኦዳባ በእተ’ ያጋና።<verse eid="NUM 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24"/>ሀ አሳይ ማጫ ጋሞዳ ደንዴስ፤</para>
  <para style="q2" vid="NUM 23:24">ባ ኦይክዳባ ማና ጋካናዉ፥</para>
  <para style="q2" vid="NUM 23:24">ባ ዎዳይሳ ሱ ኡያና ጋካናዉ፥</para>
  <para style="q2" vid="NUM 23:24">ሸምፖና ጋሞዳ ደንዶሶና” ያግስ።<verse eid="NUM 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25"/>ያትን፥ ባላቅ ባላማኮ፥ “ነ ኤንታ ኡባካ ባዶፋ፤ ኡባካ አንጆፋ” ያግስ።<verse eid="NUM 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26"/>ባላም ዛሪድ፥ “ታኒ ጎዳይ ግያባ ፃላላ ኦና ጋዳ ነዉ ኦዳብክና?” ያግስ።<verse eid="NUM 23:26"/></para>
  <para style="s1">ባላማ ሄን ሃሳያ</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27"/>ባላቅ ባላማኮ፥ “ሃያ፤ ታ ነና ሀራ በሲ ኤፋና። ኦን ኤር፥ ሄሳን ፆሳይ ኡፋይትድ፥ ኔኒ ያን ኤቃዳ ኤንታ ባዳና መላ ኦናዉ ዳንዳኤስ” ያግስ። <verse eid="NUM 23:27"/><verse number="28" style="v" sid="NUM 23:28"/>ባላቅ ባላማ ባዙዋ ዱገ ፄልያ ፓኦራ ዙማ ቦላ ኤፍስ።<verse eid="NUM 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29"/>ባላም፥ “ኔኒ ሀይሳን ታዉ ላፑን ያርሾ በሳታ ግምባ፤ ቃስ ላፑን ኮርማታነ ላፑን ማራዘታ ታዉ ጊግሳ” ያግስ። <verse eid="NUM 23:29"/><verse number="30" style="v" sid="NUM 23:30"/>ባላም ግዳይሳዳ ባላቅ ኦስ፤ እስ እስ ያርሾ በሳን እስ ኮርማነ እስ ማራዘ ያርሽስ።<verse eid="NUM 23:30"/></para>
  <chapter eid="NUM 23"/>
  <chapter number="24" style="c" sid="NUM 24"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1"/>ባላም እስራኤለ አንጀይስ ጎዳ ኡፋይስዳይሳ እ በእዳ ዎደ ካሰ እ ኦይሳዳ ብታ ማላ ኮይቤና፥ ሽን ባ ሶምኡዋ መላ ቢታኮ ዛርስ። <verse eid="NUM 24:1"/><verse number="2" style="v" sid="NUM 24:2"/>እ ቁ ግድ ፄልያ ዎደ እስራኤለ አሳይ ባ ኮቻን ኮቻን ዱንካንድ ኡትዳይሳ በእያ ዎደ ፆሳ አያናይ እያ ቦላ ዎስ። <verse eid="NUM 24:2"/><verse number="3" style="v" sid="NUM 24:3"/>እ ሀይሳዳ ያግድ ትንብተ ኦድስ፤</para>
  <para style="q1" vid="NUM 24:3">“ብኦራ ናኣ ባላማ ትንብትያ፤</para>
  <para style="q2" vid="NUM 24:3">እያ አይፈይ ዶየትን ፄልያ አድያ ትንብትያ፤<verse eid="NUM 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4"/>ፆሳይ ግያባ ስኤይሳ ትንብትያ፤</para>
  <para style="q2" vid="NUM 24:4">እ ሶምኦራ ጉፋንን፥ እያ አይፈይ ዶየትዳይስ፤</para>
  <para style="q2" vid="NUM 24:4">ኡባ ዳንዳእያ ፆሳ ቆንጨ በእዳ አድያ ትንብተይ ሀይሳ።<verse eid="NUM 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5"/>ያይቆባ፥ ነ ዱንካነት፥</para>
  <para style="q2" vid="NUM 24:5">እስራኤለ፥ ነ ጉታት፥</para>
  <para style="q2" vid="NUM 24:5">አይባ ሎኦና።<verse eid="NUM 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6"/>ኤንቲ ምጨትዳ ዛንጋራዳ፥</para>
  <para style="q2" vid="NUM 24:6">ሻፋ ጋፃን ደእያ አታክልትያ በሳዳ፥</para>
  <para style="q2" vid="NUM 24:6">ጎዳይ ቶክዳ ጎዳረ ኡዳ፥</para>
  <para style="q2" vid="NUM 24:6">ሃ ጋፃን ደእያ ዝጋ ምዳ ሀኖሶና።<verse eid="NUM 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7"/>ኤንታ ፁጋይ ሃን ኩማና፤</para>
  <para style="q2" vid="NUM 24:7">ኤንታ ኮቻይ ግድያ ሃ ደማና።</para>
  <para style="q1" vid="NUM 24:7">ኤንታ ካዎይ ካዋ አጋጋፐ አና፤</para>
  <para style="q2" vid="NUM 24:7">ኤንታ ካዎተይ ቦንቸታና።<verse eid="NUM 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8"/>ፆሳይ ኤንታ ግብፀፈ ከስስ፤</para>
  <para style="q2" vid="NUM 24:8">እ ምኖ መንዳ ኤንታዉ ኦለቴስ።</para>
  <para style="q1" vid="NUM 24:8">ኤንታ ሞርከታ መንረስ፤</para>
  <para style="q2" vid="NUM 24:8">ኤንታ መቀ ጋጬስ፤</para>
  <para style="q2" vid="NUM 24:8">ባ ዶንግያን ጫዴስ።<verse eid="NUM 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9"/>ኤንቲ ጋሞዳ ዝንእዶሶና፤</para>
  <para style="q2" vid="NUM 24:9">ማጫ ጋሞዳ ዛቁልዶሶና፤</para>
  <para style="q2" vid="NUM 24:9">ኤንታ ቦሸቻናዉ ዳንዳኤይ ኦኔ?</para>
  <para style="q1" vid="NUM 24:9">ኤንታ አንጅያ ኡባይ አንጀታና፤</para>
  <para style="q2" vid="NUM 24:9">ኤንታ ባድያ ኡባይ ባደታና” ያግስ።<verse eid="NUM 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10"/>ያትን፥ ባላቅ ባላማ ቦላ ይሎትስ። ባ ኩሽያ ባቅድ ባላማኮ፥ “ታ ሞርከታ ባዳና መላ ታ ነና ኤሀስ፥ ሽን ኔኒ ሄ ቶሆ ኤንታ አንጃዳሳ። <verse eid="NUM 24:10"/><verse number="11" style="v" sid="NUM 24:11"/>ሀእ ኤለሳዳ ነ ሶ ባ፤ ታ ነና ዳሮባ ዎይታና ጋስ፥ ሽን ኔኒ ዎይቱዋ ኤኮና መላ ጎዳይ ነና ድግስ” ያግስ።<verse eid="NUM 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12"/>ባላም ባላቃኮ ዛሪድ፥ “ኔኒ ታኮ ኪትዳ አሳኮ፥ <verse eid="NUM 24:12"/><verse number="13" style="v" sid="NUM 24:13"/>‘ባላቅ ሀር አቶሽን ባ ካዎተን ኩምዳ ብራነ ዎርቃ ታዉ እምያባ ግድኮካ ጎዳይ ኦድዳይሳ መንዳ ሎኦ ዎይኮ ኢታ ታ ሸነን ኦናዉ ዳንዳእከ። ታኒ ጎዳይ ግያባ ፃላላ ኦዳና’ ጋዳ ነዉ ኦዳብክናዬ?” ያግስ።<verse eid="NUM 24:13"/></para>
  <para style="s1">ባላማ ኦይዳን ሃሳያ</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 24:14"/>ባላም ባላቃኮ፥ “ታኒ ሀእ ታ አሳኮ ባይስ፤ ሽን ነ ሃያ፤ እስራኤለ አሳይ ያና ዎድያን ነ አሳ ኦናባ ታ ነዉ ኦዳና” ያግስ። <verse eid="NUM 24:14"/><verse number="15" style="v" sid="NUM 24:15"/>እ ባ ትንብትያ ሀይሳዳ ያግድ ኦድስ፤</para>
  <para style="q1" vid="NUM 24:15">“እያ አይፈይ ትሽ ኦድ ፄልያ፥</para>
  <para style="q2" vid="NUM 24:15">ብኦራ ናኣ ባላማ ትንብተይ ሀይሳ።<verse eid="NUM 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16"/>ሀይስ ፆሳይ ግያባ ስኤይሳ ትንብትያ፥</para>
  <para style="q2" vid="NUM 24:16">ኡባ ዳንዳእያ ፆሳፈ</para>
  <para style="q2" vid="NUM 24:16">ግድዳ ኤራተ ደእያ ኡራይ።</para>
  <para style="q1" vid="NUM 24:16">ልች ግድ ሶምኦራ ጉፋንን፥</para>
  <para style="q2" vid="NUM 24:16">እያ አይፈይ ዶየትዳይስነ</para>
  <para style="q1" vid="NUM 24:16">ኡባ ዳንዳእያ ፆሳ</para>
  <para style="q2" vid="NUM 24:16">ቆንጨ በኤይሳ ትንብተይ ሀይሳ።<verse eid="NUM 24:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17"/>“ታኒ እያ በአይስ፥ ሽን ዎደይ ሀእ ግደና፤</para>
  <para style="q2" vid="NUM 24:17">ታ እያ ፄላይስ፥ ሽን ማታን ዴና።</para>
  <para style="q1" vid="NUM 24:17">ያይቆባ ሼሻፐ ፆልንቶይ ከያና፤</para>
  <para style="q2" vid="NUM 24:17">እስራኤለፐ ካዎተ ፃምአይ ከያና።</para>
  <para style="q1" vid="NUM 24:17">ሞአበ አሳ ሶምኡዋ እ ጋጫና፤</para>
  <para style="q2" vid="NUM 24:17">ሴታ አሳ ኡባ ሁጵያ እ ትንቻና።<verse eid="NUM 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18"/>ኤዶመይ ፆነታና፤</para>
  <para style="q2" vid="NUM 24:18">እያ ሞርከይ ሳይረይ ኦይከታና፤</para>
  <para style="q2" vid="NUM 24:18">ሽን እስራኤለይ ምን ምን ባና።<verse eid="NUM 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19"/>ያይቆባፐ ሃረይስ ከያና፤</para>
  <para style="q2" vid="NUM 24:19">ካታማን ፓፃ አትዳይሳታ ይሳና” ያግስ።<verse eid="NUM 24:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20"/>ሄሳፈ ጉየ፥ ባላም አማለቃ በእድ ሀይሳዳ ያግድ ትንብተ ኦድስ፤</para>
  <para style="q1" vid="NUM 24:20">“አማለቅ ካዎተታ ግዶን ኮይሮ፥</para>
  <para style="q2" vid="NUM 24:20">ሽን ኤንታ ዉርሰይ ዮ” ያግስ።<verse eid="NUM 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21"/>ቃስ ባላም ቄና በእድ ሀይሳዳ ያግድ ትንብተ ኦድስ።</para>
  <para style="q1" vid="NUM 24:21">“ህንተ ደእያ በሳይ ሳሮ በሲ፤</para>
  <para style="q2" vid="NUM 24:21">ህንተ ኬይ ዛላ ቦላ ኬፀትስ።<verse eid="NUM 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22"/>ሽን አሶረት ህንተና ድእያ ዎደ፥</para>
  <para style="q2" vid="NUM 24:22">ህንተ ቄና አሳይ ያና” ያግስ።<verse eid="NUM 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23"/>ዉርሰን ባላም ሀይሳዳ ያግድ ትንብተ ኦድስ፤</para>
  <para style="q1" vid="NUM 24:23">“ፆሳይ ሄሳ ኦያ ዎደ፥</para>
  <para style="q2" vid="NUM 24:23">ኦን ደኦን ዳናዉ ዳንዳኢ?<verse eid="NUM 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 24:24"/>ማርካበት ቆጵሮሳፐ ያና፤</para>
  <para style="q2" vid="NUM 24:24">ኤንቲ አሶረነ ኤቤራ ፆናና፤</para>
  <para style="q2" vid="NUM 24:24">ሽን ኤንትካ ቃስ ያና” ያግስ።<verse eid="NUM 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25"/>ሄሳፈ ጉየ፥ ባላም ደንድድ ባ ሶ ስምስ፤ ባላቅካ ባ ኦግያ ብስ።<verse eid="NUM 24:25"/></para>
  <chapter eid="NUM 24"/>
  <chapter number="25" style="c" sid="NUM 25"/>
  <para style="s1">ሞአበት እስራኤለታ ባለዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1"/>እስራኤለ አሳይ ሴፅማ ጌተትያ በሳን ዱንካንድ ደእሽን፥ እስራኤለ አደት ሞአበ ማጫታራ ላይማቶ ዶምዶሶና። <verse eid="NUM 25:1"/><verse number="2" style="v" sid="NUM 25:2"/>ሄ ማጫሳት ባንታ ፆሳታ ያርሹዋ ማና መላ ፄግዶሶና። ኤንቲ ሄ ያርሾ ካ ምድ ኤንታ ፆሳታ ጎይንዶሶና። <verse eid="NUM 25:2"/><verse number="3" style="v" sid="NUM 25:3"/>እስራኤለት ብኤል-ፋጎራ ጌተትያ ኤቃ ጎይንዳ ግሾ ጎዳይ ኤንታ ቦላ ሀንቀትስ። <verse eid="NUM 25:3"/><verse number="4" style="v" sid="NUM 25:4"/>ያትን፥ ጎዳይ ሙሰኮ፥ “ጎዳ ሀንቆይ እስራኤለፐ ስማና መላ ካለያ አሳ ኡባ ኤፋዳ ሴታ ጋላስ ጎዳ ስንን ካቃ” ያግስ። <verse eid="NUM 25:4"/><verse number="5" style="v" sid="NUM 25:5"/>ሙሰይ እስራኤለ ዳይናታኮ፥ “ህንተ እሶይ እሶይ ብኤል-ፋጎራ ጌተትያ ኤቃ ጎይንዳ አሳ ኡባ ዎተ” ያግስ።<verse eid="NUM 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6"/>ሙሰይነ ማባራይ ኡባይ ጌሻ ዱንካንያ ፐንገን ዬክሽን፥ እስራኤለታፐ እሶይ ምድያመ ማጫስዉ ኤንታ ስንራ አድ፥ ባ ኬ አሳኮ ኤህስ። <verse eid="NUM 25:6"/><verse number="7" style="v" sid="NUM 25:7"/>ካህንያ አሮና ናኣ አላዛራ ናአይ ፕንሃስ ሄሳ በእዳ ዎደ ማባራ ግዶፈ ደንድድ፥ ቶራ ኤክድ፥ <verse eid="NUM 25:7"/><verse number="8" style="v" sid="NUM 25:8"/>እስራኤለ አድያ ካልድ ዱንካንያ ግዶ ገልድ፥ ኡራነ ማጫስዉ ቶራን ጫድድ ካን ከስስ። ሄስ ሀንን እስራኤለታ ዉርስያ ጋዶይ ኤቅስ። <verse eid="NUM 25:8"/><verse number="9" style="v" sid="NUM 25:9"/>ሽን ሄ ጋዶይ ላታማነ ኦይዱ ሙኩሉ አሳ ዎስ።<verse eid="NUM 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 25:10"/><verse number="11" style="v" sid="NUM 25:11"/>“ካህንያ አሮና ናኣ አላዛራ ናአይ ፕንሃስ እስራኤለ አሳ ግዶን ታኒ ታ ቦንቹዋስ ምሸተይሳዳ ምሸትዳ ግሾ፥ ታኒ ህንተ ቦላ ሀንቀትዳ ሀንቁዋ ዶሽስስ። ታኒ ታ ቃናትያን ኤንታ ፖሎ ይሳብከ። <verse eid="NUM 25:11"/><verse number="12" style="v" sid="NUM 25:12"/>ሄሳ ግሾ፥ ታኒ ታ ሳሮተ ጫቁዋ እያራ ጫቃናይሳ ፕንሃሳስ ኦዳ። <verse eid="NUM 25:12"/><verse number="13" style="v" sid="NUM 25:13"/>እ ባ ፆሳ ቦንቹዋስ ምሸትዳ ግሾነ እስራኤለ አሳስ ናጋራ አቶተ ኤህዳ ግሾ፥ እነ እያ ኮቻይ መርናዉ ካህነ ግዳና” ያግስ።<verse eid="NUM 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14"/>ምድያመ ማጫሴራ ሀይቅዳ ኡራ ሱንይ ሳሉ ናኣ ዝምራ ጌተቴስ። ሳሉ ስሞና ኮቻን እስ ኮቻ ሀላቃ። <verse eid="NUM 25:14"/><verse number="15" style="v" sid="NUM 25:15"/>ሀይቅዳ ምድያመ ማጫሰ ሱንይ ኮዝቦ፤ እ አዋይ ዙር ምድያመታ ኮቻ ሀላቃ።<verse eid="NUM 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 25:16"/><verse number="17" style="v" sid="NUM 25:17"/>“ምድያመ ቢታ አሳ ሞርክድ ኤንታ ዎተ። <verse eid="NUM 25:17"/><verse number="18" style="v" sid="NUM 25:18"/>ኤንቲ ህንተና ሞርክድ ፓኦራን ጭምዶሶና ቃስ ቦሻ ጋላስ ፓኦራን ሀይቅዳ ምድያመታ ኮቻ ሀላቃ ናኤ ኮዝብ ጋሶን ህንተና ሞርክዶሶና” ያግስ።<verse eid="NUM 25:18"/></para>
  <chapter eid="NUM 25"/>
  <chapter number="26" style="c" sid="NUM 26"/>
  <para style="s1">ናምአን እስራኤለ አሳ ታይበተ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1"/>ቦሻፐ ጉየ፥ ጎዳይ ሙሰኮነ ካህንያ አሮና ናኣ አላዛራኮ፥ <verse eid="NUM 26:1"/><verse number="2" style="v" sid="NUM 26:2"/>“ላይ ላታማነ እያፐ ቦላ ግድዳ እስራኤለታ፥ ኦላናዉ ዳንዳኤይሳታ ኡባ፥ ኤንታ ኬን ኬን ታይብተ” ያግስ።<verse eid="NUM 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 26:3"/>ያትን፥ ሙሰይነ ካህነይ አላዛር ዮርዳኖሰ ሻፋፐ ሄፍንን፥ እያርኮ ማታን፥ ሞአበ ደንባን አሳ ሺሽድ፥ <verse eid="NUM 26:3"/><verse number="4" style="v" sid="NUM 26:4"/>“ጎዳይ ሙሰ ኪትዳይሳዳ፥ ላይ ላታማነ እያፐ ቦላ አሳ ታይብዶሶና።”</para>
  <para style="p" vid="NUM 26:4">ግብፀፈ ከይዳ እስራኤለ አሳይ ሀይሳታ።<verse eid="NUM 26:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 26:5"/>እስራኤለ ባይራ ናኣ ሮቤላ ኮቻት ባንታ ኮቻን ኮቻን፥ ሀኖካ ኮቻ፥ ፋሉ ኮቻ፥ <verse eid="NUM 26:5"/><verse number="6" style="v" sid="NUM 26:6"/>ሄስሮና ኮቻነ ካርማ ኮቻ፤ <verse eid="NUM 26:6"/><verse number="7" style="v" sid="NUM 26:7"/>ሀይሳቲ ሮቤላ ኮቻታ፤ ኤንታ ኩመ ታይቦይ 43,730. <verse eid="NUM 26:7"/><verse number="8" style="v" sid="NUM 26:8"/>ፋሉ ናአይ ኤልኣባ፤ <verse eid="NUM 26:8"/><verse number="9" style="v" sid="NUM 26:9"/>ኤልኣባ አደ ናይት ነሙኤላ፥ ዳታነነ አቤሮ። ዳታንነ አቤሮይ ማባራይ ዶርዳይሳታ፥ ሽን ኤንቲ ቆረነ እያ ካለይሳታራ ቶቢድ ጎዳ ቦላ ማካልድ ሙሰ ቦላነ አሮና ቦላ ደንድዶሶና። <verse eid="NUM 26:9"/><verse number="10" style="v" sid="NUM 26:10"/>ቢታይ ዶየትድ ኤንታ ቆረራ እስፈ ምትስ፤ ኤንታ ካልያ 250 አሳ ታም ምን ሀይቅዶሶና። ያትን፥ ሀራት ኤንታ በእድ ናገታና መላ ማላ ግድዶሶና። <verse eid="NUM 26:10"/><verse number="11" style="v" sid="NUM 26:11"/>ሽን ቆረ አደ ናይት ኡባይ ሀይቅድ ይቦኮና።<verse eid="NUM 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 26:12"/>ስሞና ዘረይ ባንታ ኮቻን ኮቻን፥ ነሙኤላ ኮቻ፥ ያምና ኮቻ፥ ያክና ኮቻ፥ <verse eid="NUM 26:12"/><verse number="13" style="v" sid="NUM 26:13"/>ዛራ ኮቻነ ሳኡላ ኮቻ። <verse eid="NUM 26:13"/><verse number="14" style="v" sid="NUM 26:14"/>ሀይሳቲ ስሞና ኮቻታ፤ ኤንታ ኩመ ታይቦይ 22,200.<verse eid="NUM 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 26:15"/>ጋደ ዘረይ ባንታ ኮቻ ኮቻን፥ ፅፎና ኮቻ፥ ሀግ ኮቻ፥ ሹና ኮቻ፥ <verse eid="NUM 26:15"/><verse number="16" style="v" sid="NUM 26:16"/>ኤስና ኮቻ፥ ኤራ ኮቻ፥ <verse eid="NUM 26:16"/><verse number="17" style="v" sid="NUM 26:17"/>አሮዳ ኮቻነ አርኤላ ኮቻ። <verse eid="NUM 26:17"/><verse number="18" style="v" sid="NUM 26:18"/>ሀይሳቲ ጋደ ኮቻታ፤ ኤንታ ኩመ ታይቦይ 40,500.<verse eid="NUM 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 26:19"/>ይሁዳ አደ ናይት ኤርነ ኦናን ካናነ ቢታን ሀይቅዶሶና። <verse eid="NUM 26:19"/><verse number="20" style="v" sid="NUM 26:20"/>ይሁዳ ኮቻት ባንታ ኮቻን ኮቻን፥ ሴላ ኮቻ፥ ፋረሳ ኮቻነ ዛራ ኮቻ። <verse eid="NUM 26:20"/><verse number="21" style="v" sid="NUM 26:21"/>ፋረሳ ኮቻይ ሄስሮናነ ሀሙላ። <verse eid="NUM 26:21"/><verse number="22" style="v" sid="NUM 26:22"/>ሀይሳቲ ይሁዳ ኮቻታ፤ ኤንታ ኩመ ታይቦይ 76,500.<verse eid="NUM 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 26:23"/>ይሳኮራ ዘረይ ባንታ ኮቻን ኮቻን፥ ቶላ ኮቻ፥ ፑአ ኮቻ፥ <verse eid="NUM 26:23"/><verse number="24" style="v" sid="NUM 26:24"/>ያሱባ ኮቻነ ሽምሮና ኮቻ። <verse eid="NUM 26:24"/><verse number="25" style="v" sid="NUM 26:25"/>ሀይሳቲ ይሳኮራ ኮቻታ፤ ኤንታ ኩመ ታይቦይ 64,300.<verse eid="NUM 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 26:26"/>ዛብሎና ዘረይ ባንታ ኮቻን ኮቻን፥ ሳረዳ ኮቻ፥ ኤሎና ኮቻነ ያህላላ ኮቻ። <verse eid="NUM 26:26"/><verse number="27" style="v" sid="NUM 26:27"/>ሀይሳቲ ዛብሎና ኮቻታ፤ ኤንታ ኩመ ታይቦይ 60,500.<verse eid="NUM 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 26:28"/>ዮሰፋ ናይታ ምናሰነ ኤፍሬማ ኮቻት ባንታ ኮቻን ኮቻን፥ <verse eid="NUM 26:28"/><verse number="29" style="v" sid="NUM 26:29"/>ምናሰይ ማክራ የልስ፥ ማክር ጋላዳ የልስ። <verse eid="NUM 26:29"/><verse number="30" style="v" sid="NUM 26:30"/>ጋላዳ ኮቻት፥ እዘራ ኮቸ፥ ከለጋ ኮቸ፥ <verse eid="NUM 26:30"/><verse number="31" style="v" sid="NUM 26:31"/>አስርኤላ ኮቸ፥ ሴከማ ኮቻ፥ <verse eid="NUM 26:31"/><verse number="32" style="v" sid="NUM 26:32"/>ሻምዳ ኮቸነ ሄፌራ ኮቸ። <verse eid="NUM 26:32"/><verse number="33" style="v" sid="NUM 26:33"/>ሄፌራ ናአይ ሰሎጳድ ማጫ ናአ ፃላላ የልስ፤ እያዉ አደ ናእ ባዋ። ሰሎጳዳ ማጫ ናይታ ሱንይ ማህሎ፥ ኖኦ፥ ሆግሎ፥ ምልኮነ ትርፆ። <verse eid="NUM 26:33"/><verse number="34" style="v" sid="NUM 26:34"/>ሀይሳቲ ምናሰ ኮቻታ፤ ኤንታ ኩመ ታይቦይ 52,700.<verse eid="NUM 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 26:35"/>ኤፍሬማ ዘረይ ባንታ ኮቻን ኮቻን፥ ሹቱላ ኮቻ፥ በከራ ኮቻ፥ ታሀና ኮቻታነ <verse eid="NUM 26:35"/><verse number="36" style="v" sid="NUM 26:36"/>ሹቱላ ናኣ ኤራና ኮቻታ። <verse eid="NUM 26:36"/><verse number="37" style="v" sid="NUM 26:37"/>ሀይሳቲ ኤፍሬማ ኮቻታ፤ ኤንታ ኩመ ታይቦይ 32,500. ዮሰፋ ኮቻት ባንታ ኮቻን ኮቻን ሀይሳታ።<verse eid="NUM 26:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 26:38"/>ብንያመ ዘረይ ባንታ ኮቻን ኮቻን፥ ቤላ ኮቻ፥ አስቤላ ኮቻ፥ አክራ ኮቻ፥ <verse eid="NUM 26:38"/><verse number="39" style="v" sid="NUM 26:39"/>ሹፋማ ኮቻ፥ ሁፋማ ኮቻ፥ <verse eid="NUM 26:39"/><verse number="40" style="v" sid="NUM 26:40"/>ቤላ ናኣ አራዳ ኮቻነ ቤላ ናኣ ናማነ ኮቻ። <verse eid="NUM 26:40"/><verse number="41" style="v" sid="NUM 26:41"/>ሀይሳቲ ብንያመ ኮቻታ፤ ኤንታ ኩመ ታይቦይ 45,600.<verse eid="NUM 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 26:42"/>ዳነ ዘረይ ሳማ ኮቻ። <verse eid="NUM 26:42"/><verse number="43" style="v" sid="NUM 26:43"/>ሹሃማ ኮቻ ኩመ ታይቦይ 64,400.<verse eid="NUM 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 26:44"/>አሴራ ዘረይ ባንታ ኮቻን ኮቻን፥ ይምና ኮቻ፥ ይስዋ ኮቻ፥ በርአ ኮቻ፥ <verse eid="NUM 26:44"/><verse number="45" style="v" sid="NUM 26:45"/>በርአ ናአ ሄቤራ ኮቻነ በርአ ናኣ ማልክኤላ ኮቻ። <verse eid="NUM 26:45"/><verse number="46" style="v" sid="NUM 26:46"/>አሴራስ ሳራሆ ጌተትያ ማጫ ናእ ደአዉሱ። <verse eid="NUM 26:46"/><verse number="47" style="v" sid="NUM 26:47"/>ሀይሳቲ አሴራ ኮቻታ፤ ኤንታ ኩመ ታይቦይ 53,400.<verse eid="NUM 26:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 26:48"/>ንፍታለመ ዘረይ ባንታ ኮቻን ኮቻን፥ ያህፄላ ኮቻ፥ ጉና ኮቻ፥ <verse eid="NUM 26:48"/><verse number="49" style="v" sid="NUM 26:49"/>የፀራ ኮቻነ ሽለመ ኮቻ። <verse eid="NUM 26:49"/><verse number="50" style="v" sid="NUM 26:50"/>ሀይሳቲ ንፍታለመ ኮቻታ፤ ኤንታ ኩመ ታይቦይ 45,400.<verse eid="NUM 26:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 26:51"/>ታይበትዳ እስራኤለ አደ አሳ ታይቦይ ኩመ 601,730.<verse eid="NUM 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 26:52"/><verse number="53" style="v" sid="NUM 26:53"/>“ሀ ኮቻታስ ኤንታ ሱን ሱን ታይቡዋን ቢታ ሻካዳ ላታ ኦዳ ኤንታዉ እማ። <verse eid="NUM 26:53"/><verse number="54" style="v" sid="NUM 26:54"/>ታይቦን ዳረይሳታስ ዳርሳዳ ቃስ ታይቦን ጉፀይሳታስ ጉዳ እማ። ኡባይካ ፃፈትዳ ባንታ ታይቡዋ ኬና ኤኮ። <verse eid="NUM 26:54"/><verse number="55" style="v" sid="NUM 26:55"/>ሽን ቢታይ ሳማን ሻከቶ፤ እስ እስ ኮቻይ ላታ ኤከይ ባ ኮቻ ሱንን ግዶ። <verse eid="NUM 26:55"/><verse number="56" style="v" sid="NUM 26:56"/>እስ እስ ላታይ ታይቦን ዳሮታ ግዶንነ ታይቦን ጉታ ግዶን ሳማን ሻከቴስ” ያግስ።<verse eid="NUM 26:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="NUM 26:57"/>ባንታ ዘረን ዘረን ታይበትዳ ሌወ ኮቻት ሀይሳታ፤ ገድሶና ኮቻ፥ ቃሃታ ኮቻነ መራራ ኮቻ። <verse eid="NUM 26:57"/><verse number="58" style="v" sid="NUM 26:58"/>ሀይሳቲካ ቃስ ሌወ ኮቻታ፤ ልብና ኮቻ፥ ከብሮና ኮቻ፥ ሞሆላ ኮቻ፥ ሙሰ ኮቻነ ቆረ ኮቻ። ቃሃት አምራማ የልስ። <verse eid="NUM 26:58"/><verse number="59" style="v" sid="NUM 26:59"/>አምራማ ማቸ ሱንይ ዮከቤዶ፤ እያ ግብፀን ሌወፐ የለትዳ ሌወ ናአ። እያ አሮና፥ ሙሰነ ኤንታ ምችዉ ማይራሞ የላሱ። <verse eid="NUM 26:59"/><verse number="60" style="v" sid="NUM 26:60"/>አሮናስ ናዳበ፥ አብዮዳ፥ አላዛራነ እታማራ ጌተትያ ኦይዱ ናይት ደኦሶና። <verse eid="NUM 26:60"/><verse number="61" style="v" sid="NUM 26:61"/>ሽን ናዳበይነ አብዮድ ጎዳ ስንን ጌሽ ግዶና ታማን ያርሾ ያርሽዳ ግሾ ቦሻን ሀይቅዶሶና። <verse eid="NUM 26:61"/><verse number="62" style="v" sid="NUM 26:62"/>ላይ እስ አጌናነ እያፐ ቦላ ግድዳ ሌወ አደ ናይታ ታይቦይ ላታማነ ሄ ሙኩላ። እስራኤለ አሳ ግዶን ኤንታዉ ላታ ቢት እመትቦና ግሾ ኤንቲ እስራኤለታራ ታይበትቦኮና።<verse eid="NUM 26:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63"/>ዮርዳኖሰ ሻፋፐ ሄፍንን፥ እያርኮ ማታን፥ ሞአበ ደንባን ሙሰይነ ካህነይ አላዛር እስራኤለ አሳ ታይብዳ ዎደ ታይበትዳ አሳይ ሀይሳ። <verse eid="NUM 26:63"/><verse number="64" style="v" sid="NUM 26:64"/>ሙሰይነ ካህነይ አሮን ኮይሮ ሲና መላ ቢታን እስራኤለ ታይብዳ ዎደ ታይበትዳ አሳፐ መፅ እስ አስካ አትቤና። <verse eid="NUM 26:64"/><verse number="65" style="v" sid="NUM 26:65"/>ጎዳይ ሀ እስራኤለታባ፥ “ኤንቲ ኡባይ መላ ቢታን ሀይቃና” ያግድ ኦድዳ ግሾ፥ ዮፎና ናኣ ካለባፐነ ናወ ናኣ እያሱፐ አትሽን፥ ሀር እስ አስካ አትቤና።<verse eid="NUM 26:65"/></para>
  <chapter eid="NUM 26"/>
  <chapter number="27" style="c" sid="NUM 27"/>
  <para style="s1">ሰሎጳዳ ማጫ ናይታ ኦይሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1"/>ሰሎጳድ ሄፌራ ናአ፤ ሄፌር ጋላዳ ናአ፤ ጋላድ ማክራ ናአ፤ ማክር ምናሰ ናአ፤ ምናሰይ ዮሰፋ ናአ። ሰሎጳዳ ማጫ ናይት ማህሎ፥ ኖኦ፥ ሆግሎ፥ ምልኮነ ትርፆ። <verse eid="NUM 27:1"/><verse number="2" style="v" sid="NUM 27:2"/>ሀ ማጫ ናይት ጌሻ ዱንካንያ ፐንገን ሙሰ ስንን፥ ካህንያ አላዛራ ስንን፥ ሀላቃታ ስንንነ ማባራ ኡባ ስንን ኤቅድ፥ <verse eid="NUM 27:2"/><verse number="3" style="v" sid="NUM 27:3"/>“ኑ አዋይ መላ ቢታን ሀይቅስ፤ እ ባ ናጋራ ጋሶን ሀይቅስፐ አትሽን፥ ጎዳ ቦላ ደንድዳ ቆረ ካለይሳታ ግዶን ዴና። እያዉ አደ ናእ ባዋ። <verse eid="NUM 27:3"/><verse number="4" style="v" sid="NUM 27:4"/>ያትን፥ ኑ አዋይ አደ ናአ የልቦና ግሾ እያ ሱንይ እያ ኮቻ ግዶፈ ዋንድ ዪ? ኑ አዋ ዳቦታ ግዶን ኑስ ላታ ቢታ እማ” ግዶሶና።<verse eid="NUM 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5"/>ያትን፥ ሙሰይ ኤንታ ኦይሻ ጎዳ ስን ሺሽስ። <verse eid="NUM 27:5"/><verse number="6" style="v" sid="NUM 27:6"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 27:6"/><verse number="7" style="v" sid="NUM 27:7"/>“ሰሎጳዳ ማጫ ናይታ ኦይሻይ ልከ፤ ኤንታ አዋ ዳቦታ ግዶን ኔኒ ኤንታዉ ላታ ቢታ እማ፤ እያ ግሾይ ኤንታ ላታ ግዶ። <verse eid="NUM 27:7"/><verse number="8" style="v" sid="NUM 27:8"/>ቃስ እስራኤለ አሳኮ፥ ‘እስ አስ አደ ናአ የሎና ሀይቅኮ እያ ማጫ ናይት ላቶ። <verse eid="NUM 27:8"/><verse number="9" style="v" sid="NUM 27:9"/>እያዉ ማጫ ናእ ባይናባ ግድኮ እያ እሻት ላቶ። <verse eid="NUM 27:9"/><verse number="10" style="v" sid="NUM 27:10"/>እያዉ እሽ ባይናባ ግድኮ እያ አዋ እሻት ላቶ። <verse eid="NUM 27:10"/><verse number="11" style="v" sid="NUM 27:11"/>እያዉ አዋ እሽ ባይናባ ግድኮ እያ ማታ ዳቦይ ላቶ። ታኒ ጎዳይ ነና ኪትዳይሳዳ ሀይስ እስራኤለ አሳስ ዎጋ ግዶ’ ” ያግስ።<verse eid="NUM 27:11"/></para>
  <para style="s1">ሙሰ በሳን እያሱ ዶረተ</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12"/>ጎዳይ ሙሰኮ፥ “አባሪማ ዙማ ቦላ ከያዳ ታ እስራኤለ አሳስ እምዳ ቢታ በአ። <verse eid="NUM 27:12"/><verse number="13" style="v" sid="NUM 27:13"/>ነ በእዳፐ ጉየ፥ ነ እሻ አሮናዳ ነካ ሀይቃዳ ነ ማይዛታን ጋሄታና። <verse eid="NUM 27:13"/><verse number="14" style="v" sid="NUM 27:14"/>ፂና መላ ቢታን፥ ማርባ ሃ ማታን አሳይ ታ ቦላ ዙዙምዳ ዎደ ህንተ ናምአይ ኤንታ ስንን ታና ጌሽ ኦድ ቦንችቤከታ” ያግስ። (ማርባ ሃይ ፂና መላ ቢታን፥ ቃደሳ ጌተትያ በሳን ደእያ ፑልቶ።)<verse eid="NUM 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15"/>ሙሰይ ጎዳኮ፥ <verse eid="NUM 27:15"/><verse number="16" style="v" sid="NUM 27:16"/>“አሳ ኡባስ ደኦ እምያ ጎዳ ፆሳዉ፥ ነ አሳይ ሄንንቾይ ባይና ዉደ መላ ግዶናዳ፥ <verse eid="NUM 27:16"/><verse number="17" style="v" sid="NUM 27:17"/>ሀ አሳ ስንን ከያነ ገልያ ቃስ ኤንታ ካለድ ከስያነ ገልስያ እስ አስ ሀ ማባራ ቦላ ሹማ” ያግስ።<verse eid="NUM 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18"/>ጎዳይ ሙሰኮ፥ “አያናይ እያን ደእያ ናወ ናኣ እያሱ ኤካዳ ነ ኩሽያ እያ ቦላ ዎ። <verse eid="NUM 27:18"/><verse number="19" style="v" sid="NUM 27:19"/>እያ ካህንያ አላዛራ ስንንነ ማባራ ኡባ ስንን ኤሳዳ ኤንቲ በእሽን ሹማ። <verse eid="NUM 27:19"/><verse number="20" style="v" sid="NUM 27:20"/>እስራኤለ ኡባይ እያዉ ኪተታና መላ ነ ማታፐ እያዉ ሻካዳ እማ። <verse eid="NUM 27:20"/><verse number="21" style="v" sid="NUM 27:21"/>እካ ኡሪመን ጎዳ ሸንያ ኦይችድ ሻክያ ካህንያ አላዛራ ስንን ኤቆ። እያሱይነ እስራኤለ ማባራይ ኡባይ አላዛራ ኪታን ከዮነ ገሎ” ያግስ።<verse eid="NUM 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22"/>ሙሰይ ጎዳይ ኪትዳይሳዳ ኦስ፤ እያሱ ኤፍድ፥ ካህንያ አላዛራ ስንንነ ማባራ ኡባ ስንን ኤስስ። <verse eid="NUM 27:22"/><verse number="23" style="v" sid="NUM 27:23"/>ጎዳይ ኪትዳይሳዳ ሙሰይ ባ ኩሽያ እያ ቦላ ዎድ ሹምስ።<verse eid="NUM 27:23"/></para>
  <chapter eid="NUM 27"/>
  <chapter number="28" style="c" sid="NUM 28"/>
  <para style="s1">ጋላሳ ያርሹዋ</para>
  <para style="r">(<ref loc="EXO 29:38-46">ከሳ 29:38-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 28:1"/><verse number="2" style="v" sid="NUM 28:2"/>“እስራኤለ አሳ ሀይሳዳ ያጋዳ ኪታ፤ ፁገትያ ሳውያ ካ ያርሾ ዎደን ዎደን ታዉ ያርሽተ። <verse eid="NUM 28:2"/><verse number="3" style="v" sid="NUM 28:3"/>ጎዳስ ታማን ፁገትድ ያርሸትያ ያርሾይ ሀይሳ፤ ኩመ ቦላራ ደእያ እስ ላይ ኩምዳ ናምኡ ማራዘታ ዎንታ ዎንታ ፁሳ ያርሾ ኦድ ያርሽተ። <verse eid="NUM 28:3"/><verse number="4" style="v" sid="NUM 28:4"/>ማራዘታፐ እሱዋ ዎንታ እሱዋ ቃስ ኦማርስ ያርሽተ። <verse eid="NUM 28:4"/><verse number="5" style="v" sid="NUM 28:5"/>ቃስ ሄ ማራዝያራ እስ ልትሮ ሻማሆ ዛይተን ሙኑቀትዳ እስ ክሎ ግራመ ሎኦ ግስተ ለ ካ ያርሾ ያርሽተ። <verse eid="NUM 28:5"/><verse number="6" style="v" sid="NUM 28:6"/>ሀይስ ጎዳ ኡፋይስያ ፁሳ ያርሾ። እካ ሲና ዙማ ቦላ ያርሸትዳ ኮይሮ ፁሳ ያርሾ። <verse eid="NUM 28:6"/><verse number="7" style="v" sid="NUM 28:7"/>ኮይሮ ማራዝያራ እስ ልትሮ ጫላ ዎይነ ኡሻ ያርሾ ኦድ ያርሾ በሳን ጎዳስ ጉስተ። <verse eid="NUM 28:7"/><verse number="8" style="v" sid="NUM 28:8"/>ኦማርስ ናምአን ማራዝያ ያርሽያ ዎደ ኮይሮይሳ መላ ካ ያርሹዋነ ኡሻ ያርሹዋ ጉጅድ ያርሽተ። እካ ጎዳ ኡፋይስያ ሳዎ ያርሾ ግዳና።”<verse eid="NUM 28:8"/></para>
  <para style="s1">ሳምባታ ያርሾ</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9"/>“ሳምባታ ጋላስ ቦረይ ባይና እስ ላይ ኩምዳ ናምኡ ማራዘታ ዛይተን ሙኑቀትዳ ናምኡ ክሎ ግራመ ሎኦ ግስተ ለ ኤክድ ካ ያርሾነ ኡሻ ያርሾ ኦድ ያርሽተ። <verse eid="NUM 28:9"/><verse number="10" style="v" sid="NUM 28:10"/>ጋላስ ጋላስ ያርሸትያ ፁሳ ያርሹዋ ቦላ ሳምባታን ሳምባታን ህንተ ያርሻና ፁሳ ያርሾይነ ኡሻ ያርሾይ ሀይሳ።”<verse eid="NUM 28:10"/></para>
  <para style="s1">አጌና ፄሮ ያርሾ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11"/>“አጌን ፄርያ ኮይሮ ጋላስ ናምኡ ዎፋኖታ፥ እስ ማራዘነ እስ ላይ ኩምዳ ቦረይ ባይና ላፑን ዶርሳ ኡርገታ ፁሳ ያርሾ ኦድ ጎዳስ ያርሽተ። <verse eid="NUM 28:11"/><verse number="12" style="v" sid="NUM 28:12"/>እስ እስ ዎፋኑዋራ ሻማሆ ዛይተን ሙኑቀትዳ ሄ ክሎ ግራመ ግድያ ሎኦ ግስተ ለራ ካ ያርሾ ኦድ ያርሽተ። ቃስ ሻማሆ ዛይተን ሙኑቀትዳ ናምኡ ክሎ ግራመ ግድያ ሎኦ ግስተ ልያ ማራዝያራ ዎላ ያርሻ። <verse eid="NUM 28:12"/><verse number="13" style="v" sid="NUM 28:13"/>ላፑን ማራዘታፐ እስ እስ ማራዘ ሻማሆ ዛይተን ሙኑቀትዳ እስ ክሎ ግራመ ሎኦ ግስተ ለራ ፁገትያ ሳውያ ካ ያርሾ ኦዳ ጎዳስ ያርሻ። <verse eid="NUM 28:13"/><verse number="14" style="v" sid="NUM 28:14"/>ቃስ ኡሻ ያርሹዋ እስ እስ ዎፋኑዋስ ናምኡ ልትሮ ዎይነ፥ እስ ማራዝያስ እስ ልትሮነ ባጋ ዎይነ ኡሻነ እስ እስ ዶርሳ ኡርግያስ እስ ልትሮ ግድያ ዎይነ ኡሽ ሺሽተ። ሀይስ ላይ ግዶን አጌን ፄርያ ኮይሮ ጋላሳን ኦሰትያ ፁሳ ያርሾ። <verse eid="NUM 28:14"/><verse number="15" style="v" sid="NUM 28:15"/>ጋላስ ጋላስ ያርሸትያ ፁሳ ያርሹዋ ቦላነ ኡሻ ያርሹዋ ቦላ እስ ኮለ ናጋራ ያርሾ ኦድ ጎዳስ ያርሽተ።”<verse eid="NUM 28:15"/></para>
  <para style="s1">ፓስካ ያርሾ</para>
  <para style="r">(<ref loc="LEV 23:5-14">ሌወ 23:5-14</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16"/>“ኮይሮ አጌናን ታማነ ኦይዳን ጋላሳይ ጎዳ ፓስካ ቦንችያ ጋላስ ግዶ። <verse eid="NUM 28:16"/><verse number="17" style="v" sid="NUM 28:17"/>ቃስ ሄ አጌናን ታማነ እቻሻን ጋላሳን ኡይ ባለይ ቦንቸቴስ፤ ሄ ጋላሳፐ ዶምድ ላፑን ጋላስ ጋካናዉ እርሾይ ገልቦና ኡይ ሚተ። <verse eid="NUM 28:17"/><verse number="18" style="v" sid="NUM 28:18"/>ሄ ጋላሳታፐ ኮይሮ ጋላሳን ጎይናናዉ ሺቅተ፤ ሄ ጋላሳን አይ ኦሶካ ኦፍተ። <verse eid="NUM 28:18"/><verse number="19" style="v" sid="NUM 28:19"/>ቦረይ ባይና ናምኡ ዎፋኖታ፥ እስ ማራዘነ እስ ላይ ኩምዳ ላፑን ዶርሳ ኡርገታ ፁሳ ያርሾ ኦድ ጎዳስ ያርሽተ። <verse eid="NUM 28:19"/><verse number="20" style="v" sid="NUM 28:20"/>እስ ዎፋኑዋራ ሻማሆ ዛይተን ሙኑቀትዳ ሄ ክሎ ግራመ ሎኦ ግስተ ለ፥ እስ ማራዝያራ ናምኡ ክሎ ግራመ ለነ <verse eid="NUM 28:20"/><verse number="21" style="v" sid="NUM 28:21"/>ላፑን ዶርሳ ኡርገታፐ እስ እስ ዶርሳራ እስ ክሎ ግራመ ለ ያርሽተ። <verse eid="NUM 28:21"/><verse number="22" style="v" sid="NUM 28:22"/>ቃስ እስ ዴሽ ደርያ ናጋራስ አቶተ ግዳና መላ ናጋራ ያርሾ ኦድ ያርሽተ። <verse eid="NUM 28:22"/><verse number="23" style="v" sid="NUM 28:23"/>ሄሳ ኡባ ዎደ ጋላስ ጋላስ ያርሸትያ ያርሹዋ ቦላ ጉጅድ ያርሽተ። <verse eid="NUM 28:23"/><verse number="24" style="v" sid="NUM 28:24"/>ኡባ ዎደ ኦሰትያ ፁሳ ያርሹዋ ቦላነ ኡሻ ያርሹዋ ቦላ ጉጅድ ላፑን ጋላስ ጎዳስ ሳውያ ካ ያርሾ ኦድ ያርሽተ። <verse eid="NUM 28:24"/><verse number="25" style="v" sid="NUM 28:25"/>ላፑን ጋላሳን ጎይኖስ ሺቅተ፤ ሄ ጋላስ አይ ኦሶካ ኦፍተ።”<verse eid="NUM 28:25"/></para>
  <para style="s1">ካ ሺሾ ባኣለ</para>
  <para style="r">(<ref loc="LEV 23:15-22">ሌወ 23:15-22</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26"/>“ካ ሺሾ ባኣለ ሳምንታን ኮይሮ ጋላስ ጎይኖስ ሺቅያ ዎደ ህንተ ኦራ ካፈ ያርሾ ያርሽተ፤ ሄ ዎደ አይ ኦሶካ ኦፍተ። <verse eid="NUM 28:26"/><verse number="27" style="v" sid="NUM 28:27"/>ናምኡ ዎፋኖታ፥ እስ ማራዝያነ እስ ላይ ኩምዳ ላፑን ዶርሳ ኡርገታ ጎዳስ ሳውያ ፁሳ ያርሾ ኦድ ያርሽተ። <verse eid="NUM 28:27"/><verse number="28" style="v" sid="NUM 28:28"/>እስ እስ ዎፋኑዋራ ሻማሆ ዛይተን ሙኑቀትዳ ሄ ክሎ ግራመ ሎኦ ግስተ ለ፥ እስ ዶርሳ ኡርግያራ ናምኡ ክሎ ግራመ ለነ <verse eid="NUM 28:28"/><verse number="29" style="v" sid="NUM 28:29"/>ላፑን ዶርሳ ኡርገታፐ እስ እስ ኡርግያራ እስ ክሎ ግራመ ግስተ ለ ኤክድ ያርሽተ። <verse eid="NUM 28:29"/><verse number="30" style="v" sid="NUM 28:30"/>እያ ቦላ ጉጅድ እስ ኮለ ናጋራ አቶ ያርሾ ኦድ ያርሽተ። <verse eid="NUM 28:30"/><verse number="31" style="v" sid="NUM 28:31"/>ጋላስ ጋላስ ያርሸትያ ያርሹዋ ቦላነ ኡሻ ያርሹዋ ቦላ ካ ያርሾ ያርሽተ። ህንተ ያርሽያ መሄት ቦረይ ባይናባ ግዶ።”<verse eid="NUM 28:31"/></para>
  <chapter eid="NUM 28"/>
  <chapter number="29" style="c" sid="NUM 29"/>
  <para style="s1">ሞይዘ ፑኖ ያርሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1"/>“ላፑን አጌናስ ኮይሮ ጋላሳን ጎይናናዉ ሺቅተ፤ አይ ኦሶካ ኦፍተ፤ ሄ ጋላሳይ ሞይዘይ ፑነትያ ጋላስ። <verse eid="NUM 29:1"/><verse number="2" style="v" sid="NUM 29:2"/>ቦረይ ባይና እስ ዎፋኖ፥ እስ ማራዘነ እስ ላይ ኩምዳ ላፑን ዶርሳ ኡርገታ ሳውያ ፁሳ ያርሾ ኦድ ጎዳስ ያርሽተ። <verse eid="NUM 29:2"/><verse number="3" style="v" sid="NUM 29:3"/>ሄ ዎፋኑዋራ ሻማሆ ዛይተን ሙኑቀትዳ ሄ ክሎ ግራመ ሎኦ ግስተ ለ፥ እስ ማራዝያራ ናምኡ ክሎ ግራመ ግስተ ለነ፥ <verse eid="NUM 29:3"/><verse number="4" style="v" sid="NUM 29:4"/>ላፑን ዶርሳ ኡርገታፐ እስ እስ ኡርግያራ እስ ክሎ ግራመ ለ ያርሽተ። <verse eid="NUM 29:4"/><verse number="5" style="v" sid="NUM 29:5"/>ቃስ እስ ኮለ ህንተዉ ናጋራ አቶተስ ያርሽተ። <verse eid="NUM 29:5"/><verse number="6" style="v" sid="NUM 29:6"/>ዎጋይ ኪተይሳ፥ አጌና ፄሮን ያርሸትያ ፁሳ ያርሾ ቦላ፥ ካ ያርሾ ቦላ፥ ጋላስ ጋላስ ያርሸትያ ፁሳ ካ ያርሾ ቦላነ ኡሻ ያርሾ ቦላ ጉጅድ ያርሽተ፤ ሄስ ጎዳ ሳውያ ፁሳ ያርሾ።<verse eid="NUM 29:6"/></para>
  <para style="s1">ናጋራ አቶተ ያርሾ</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7"/>“ላፑን አጌናን ታማን ጋላሳን አይ ኦሶካ ኦፍተ፤ ህንተና ካዉሽድ ጎይኖስ ሺቅተ። <verse eid="NUM 29:7"/><verse number="8" style="v" sid="NUM 29:8"/>ቦረይ ባይና እስ ዎፋኖ፥ እስ ማራዘነ እስ ላይ ኩምዳ ላፑን ዶርሳ ኡርገታ ሳውያ ፁሳ ያርሾ ኦድ ጎዳስ ያርሽተ። <verse eid="NUM 29:8"/><verse number="9" style="v" sid="NUM 29:9"/>ካ ያርሾ ኦድ እስ ዎፋኖራ ሻማሆ ዛይተን ሄ ክሎ ግራመ ሎኦ ግስተ ለ፥ እስ ዶርሳ ኡርግያራ ናምኡ ክሎ ግራመ ለነ <verse eid="NUM 29:9"/><verse number="10" style="v" sid="NUM 29:10"/>ላፑን ዶርሳ ኡርገታፐ እስ እስ ኡርግያራ እስ ክሎ ግራመ ለ ያርሽተ። <verse eid="NUM 29:10"/><verse number="11" style="v" sid="NUM 29:11"/>ቃስ ናጋራ ያርሾ ኦድ እስ ኮለ ያርሽተ። ናጋራ አቶ ያርሹዋ ቦላ፥ ጋላስ ጋላስ ያርሸትያ ፁሳ ያርሹዋ ቦላ፥ ካ ያርሹዋ ቦላነ ኡሻ ያርሹዋ ቦላ ሄሳ ጉጅድ ያርሽተ።<verse eid="NUM 29:11"/></para>
  <para style="s1">ሻቃራ ባኣለ ያርሾ</para>
  <para style="r">(<ref loc="LEV 23:33-44">ሌወ 23:33-44</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12"/>“ላፑን አጌናን ታማነ እቻሻን ጋላሳን፥ ዴፆ ኦሶ ኦፍተ፤ ላፑን ጋላስ ኩመ ጎዳ ቦንቻናዉ ሻቃራ ባኣለ ቦንችተ። <verse eid="NUM 29:12"/><verse number="13" style="v" sid="NUM 29:13"/>ቦረይ ባይና ታማነ ሄ ዎፋኖታ፥ ናምኡ ማራዘታ፥ እስ ላይ ኩምዳ ታማነ ኦይዱ ዶርሳ ኡርገታ ሳውያ ፁሳ ያርሾ ኦድ ጎዳስ ያርሽተ። <verse eid="NUM 29:13"/><verse number="14" style="v" sid="NUM 29:14"/>ካ ያርሾ ግዳና መላ ታማነ ሄ ዎፋኖታፐ እስ እስ ዎፋኑዋራ ሻማሆ ዛይተን ሙኑቀትዳ ሄ ክሎ ግራመ ሎኦ ግስተ ለ፥ ናምኡ ማራዘታፐ እስ እስ ኡርግያራ ናምኡ ክሎ ግራመ ለነ <verse eid="NUM 29:14"/><verse number="15" style="v" sid="NUM 29:15"/>ታማነ ኦይዱ ዶርሳ ኡርገታፐ እስ እስ ኡርግያራ እስ ክሎ ግራመ ለ ያርሽተ። <verse eid="NUM 29:15"/><verse number="16" style="v" sid="NUM 29:16"/>ቃስ ናጋራ ያርሹዋስ እስ ኮለ ያርሽተ። ሄስ ጋላስ ጋላስ ፁሳ ያርሹዋ ቦላ፥ ካ ያርሹዋ ቦላነ ኡሻ ያርሾ ቦላ ጉጅድካ ያርሽተ።<verse eid="NUM 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17"/>“ናምአን ጋላሳን ታማነ ናምኡ ቦረይ ባይና ዎፋኖታ፥ ናምኡ ማራዘታነ እስ ላይ ኩምዳ ታማነ ኦይዱ ኡርገታ ያርሽተ። <verse eid="NUM 29:17"/><verse number="18" style="v" sid="NUM 29:18"/>ዎፋኖታራ፥ ማራዘታራነ ዶርሳ ኡርገታራ ካ ያርሹዋነ ኡሻ ያርሹዋ ዎጋይ ኪተይሳ መላ ኤንታ ታይቡዋዳ ያርሽተ። <verse eid="NUM 29:18"/><verse number="19" style="v" sid="NUM 29:19"/>ጋላስ ጋላስ ያርሸትያ ፁሳ ያርሹዋ ቦላ፥ ካ ያርሹዋ ቦላነ ኡሻ ያርሹዋ ቦላ ጉጅድ ናጋራ ያርሹዋስ እስ ኮለ ያርሽተ።<verse eid="NUM 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20"/>“ሄን ጋላሳን ቦረይ ባይና ታማነ እስ ዎፋኖታ፥ ናምኡ ማራዘታ እስ ላይ ኩምዳ ታማነ ኦይዱ ዶርሳ ኡርገታ ያርሽተ። <verse eid="NUM 29:20"/><verse number="21" style="v" sid="NUM 29:21"/>ዎፋኖታራ፥ ማራዘታራነ ዶርሳ ኡርገታራ ካ ያርሹዋነ ኡሻ ያርሹዋ ዎጋይ ኪተይሳ መላ ኤንታ ታይቡዋዳ ያርሽተ። <verse eid="NUM 29:21"/><verse number="22" style="v" sid="NUM 29:22"/>ጋላስ ጋላስ ያርሸትያ ፁሳ ያርሹዋ ቦላ፥ ካ ያርሹዋ ቦላነ ኡሻ ያርሹዋ ቦላ ናጋራ ያርሾስ እስ ኮለ ጉጅድ ያርሽተ።<verse eid="NUM 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23"/>“ኦይዳን ጋላሳን ቦረይ ባይና ታሙ ዎፋኖታ፥ ናምኡ ማራዘታነ እስ ላይ ኩምዳ ታማነ ኦይዱ ዶርሳ ኡርገታ ያርሽተ። <verse eid="NUM 29:23"/><verse number="24" style="v" sid="NUM 29:24"/>ዎፋኖታራ፥ ማራዘታራነ ዶርሳ ኡርገታራ ካ ያርሹዋነ ኡሻ ያርሹዋ ዎጋይ ኪተይሳ መላ ኤንታ ታይቡዋዳ ያርሽተ። <verse eid="NUM 29:24"/><verse number="25" style="v" sid="NUM 29:25"/>ጋላስ ጋላስ ያርሸትያ ፁሳ ያርሹዋ ቦላ፥ ካ ያርሹዋ ቦላነ ኡሻ ያርሹዋ ቦላ ጉጅድ ናጋራ ያርሾስ እስ ኮለ ያርሽተ።<verse eid="NUM 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26"/>“እቻሻን ጋላሳን ቦረይ ባይና ኡዱፉን ዎፋኖታ፥ ናምኡ ማራዘታነ እስ ላይ ኩምዳ ታማነ ኦይዱ ዶርሳ ኡርገታ ያርሽተ። <verse eid="NUM 29:26"/><verse number="27" style="v" sid="NUM 29:27"/>ዎፋኖታራ፥ ማራዘታራነ ዶርሳ ኡርገታራ ካ ያርሹዋነ ኡሻ ያርሹዋ ዎጋይ ኪተይሳዳ ኤንታ ታይቡዋዳ ያርሽተ። <verse eid="NUM 29:27"/><verse number="28" style="v" sid="NUM 29:28"/>ጋላስ ጋላስ ያርሸትያ ፁሳ ያርሹዋ ቦላ፥ ካ ያርሹዋ ቦላነ ኡሻ ያርሹዋ ቦላ ጉጅድ ናጋራ ያርሾስ እስ ኮለ ያርሽተ።<verse eid="NUM 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29"/>“ኡሱፑን ጋላሳን ቦረይ ባይና ሆስፑን ዎፋኖታ፥ ናምኡ ማራዘታነ እስ ላይ ኩምዳ ታማነ ኦይዱ ዶርሳ ኡርገታ ያርሽተ። <verse eid="NUM 29:29"/><verse number="30" style="v" sid="NUM 29:30"/>ዎፋኖታራ፥ ማራዘታራነ ዶርሳ ኡርገታራ ካ ያርሹዋነ ኡሻ ያርሹዋ ዎጋይ ኪተይሳ መላ ኤንታ ታይቡዋዳ ያርሽተ። <verse eid="NUM 29:30"/><verse number="31" style="v" sid="NUM 29:31"/>ጋላስ ጋላስ ያርሸትያ ፁሳ ያርሹዋ ቦላ፥ ካ ያርሹዋ ቦላነ ኡሻ ያርሹዋ ቦላ ጉጅድ ናጋራ ያርሾስ እስ ኮለ ያርሽተ።<verse eid="NUM 29:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32"/>“ላፑን ጋላሳን ላፑን ዎፋኖታ፥ ናምኡ ማራዘታነ እስ ላይ ኩምዳ ታማነ ኦይዱ ዶርሳ ኡርገታ ያርሽተ። <verse eid="NUM 29:32"/><verse number="33" style="v" sid="NUM 29:33"/>ዎፋኖታራ፥ ማራዘታራነ ዶርሳ ኡርገታራ ካ ያርሹዋነ ኡሻ ያርሹዋ ዎጋይ ኪተይሳ መላ ኤንታ ታይቡዋዳ ያርሽተ። <verse eid="NUM 29:33"/><verse number="34" style="v" sid="NUM 29:34"/>ጋላስ ጋላስ ያርሸትያ ፁሳ ያርሹዋ ቦላ፥ ካ ያርሹዋ ቦላነ ኡሻ ያርሹዋ ቦላ ጉጅድ ናጋራ ያርሾስ እስ ኮለ ያርሽተ።<verse eid="NUM 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35"/>“ሆስፑን ጋላሳን ጎይናናዉ ሺቅተ፤ አይ ኦሶካ ኦፍተ። <verse eid="NUM 29:35"/><verse number="36" style="v" sid="NUM 29:36"/>ቦረይ ባይና እስ ዎፋኖ፥ እስ ማራዘ፥ እስ ላይ ኩምዳ ላፑን ዶርሳ ኡርገታ ሳውያ ፁሳ ያርሾ ኦድ ጎዳስ ያርሽተ። <verse eid="NUM 29:36"/><verse number="37" style="v" sid="NUM 29:37"/>ዎፋኖታራ፥ ማራዘታራነ ዶርሳ ኡርገታራ ካ ያርሹዋነ ኡሻ ያርሹዋ ዎጋይ ኪተይሳዳ ኤንታ ታይቡዋዳ ያርሽተ። <verse eid="NUM 29:37"/><verse number="38" style="v" sid="NUM 29:38"/>ጋላስ ጋላስ ያርሸትያ ፁሳ ያርሹዋ ቦላ፥ ካ ያርሹዋ ቦላነ ኡሻ ያርሹዋ ቦላ ጉጅድ ናጋራ ያርሾስ እስ ኮለ ያርሽተ።<verse eid="NUM 29:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39"/>“ህንተ ጋሶ ያርሹዋ ቦላነ ህንተ ዶሳ ያርሹዋ ቦላ ፁሳ ያርሾ፥ ካ ያርሾ፥ ኡሻ ያርሾነ እስፈተ ያርሾ ባልያ ቦንቻናዉ ኪተትዳ ዎድያን ያርሽተ” ያግስ።<verse eid="NUM 29:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40"/>ሙሰይ፥ ጎዳይ ባና ኪትዳይሳ ኡባ እስራኤለ አሳስ ኦድስ።<verse eid="NUM 29:40"/></para>
  <chapter eid="NUM 29"/>
  <chapter number="30" style="c" sid="NUM 30"/>
  <para style="s1">ጋሶ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1"/>ሙሰይ እስራኤለ ዘረ ሀላቃታኮ፥ “ጎዳ ኪታይ ሀይሳ፤ <verse eid="NUM 30:1"/><verse number="2" style="v" sid="NUM 30:2"/>እስ አስ ጎዳስ እስባ ኦናዉ ጫቅኮ ዎይኮ እስባፐ ባና ናጋናዉ ቃንግኮ ጉየ ጎና ፖሎ።<verse eid="NUM 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3"/>“ባ አዋ ሶን ደእያ ጌላእያ ጎዳስ እስባ ኦናዉ ጫቅኮ ዎይኮ እስባፐ ባና ናጋናዉ ቃንግኮ፥ <verse eid="NUM 30:3"/><verse number="4" style="v" sid="NUM 30:4"/>እ አዋይ እያ ጫቅዳይሳ ዎይኮ እያ ቃንገትዳይሳ ስእድ፥ እዮ ድጎና እፅኮ፥ እያ ፖላናዉ ኮሼስ። <verse eid="NUM 30:4"/><verse number="5" style="v" sid="NUM 30:5"/>ሽን እ አዋይ ሄሳ ስእድ እዮ ድግኮ እ ጫቆይነ እ ቃንገይ አታናዉ ዳንዳኤስ። እ አዋይ እዮ ድግዳ ግሾ ጎዳይ እዉ አቶ ጋና።<verse eid="NUM 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6"/>“ገሎና ማጫ ናእያ ጫቃዳ ደአሸ ዎይኮ እስባፐ ባና ናጋናዉ ቃንገታዳ ደአሸ አዝና ገልኮ፥ <verse eid="NUM 30:6"/><verse number="7" style="v" sid="NUM 30:7"/>እ አዝናይ ሄሳ ስእድ እዮ ድጎና እፅኮ እያ ባ ጫቁዋነ ባ ቃንገ ፖላናዉ ኮሼስ። <verse eid="NUM 30:7"/><verse number="8" style="v" sid="NUM 30:8"/>ሽን እ አዝናይ ሄሳ ስእድ እዮ ድግኮ እያ ጫቅዳ ጫቆይ ዎይኮ ቃንገትዳ ቃንገይ እዮ ጎመና። ሄሳ ጎዳይ እዉ አቶ ጋና።<verse eid="NUM 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9"/>“ሽን አምእያ ዎይኮ ሳዮ ማጫስ ጫቅዳ ጫቁዋ ዎይኮ ቃንግዳ ቃንገ ፖላናዉ በሴስ።<verse eid="NUM 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10"/>“አዝናራ ደእያ ማጫስ ጫቅኮ ዎይኮ እስባ ኦናዉ ቃንግኮ፥ <verse eid="NUM 30:10"/><verse number="11" style="v" sid="NUM 30:11"/>እ አዝናይ ሄሳ ስእድ እዮ ድጎና እፅኮ፥ እያ ጫቅዳ ጫቁዋነ ቃንገትዳ ቃንገ ፖሎ። <verse eid="NUM 30:11"/><verse number="12" style="v" sid="NUM 30:12"/>እ አዝናይ ሄሳ ስእዳ ጋላስ እዮ ድግኮ እ ጫቆይ ዎይኮ እያ ኦናዉ ቃንገትዳ ቃንገይ እዮ ጎመና። እ አዝናይ ድግዳ ግሾ ጎዳይ እዉ አቶ ጋና። <verse eid="NUM 30:12"/><verse number="13" style="v" sid="NUM 30:13"/>እ አዝናይ እያ ጫቅዳ ጫቁዋ ዎይኮ እያ ባና ካዉሻናዉ ቃንገትዳ ቃንገ ላላናዉ ዎይኮ ምንናዉ ዳንዳኤስ። <verse eid="NUM 30:13"/><verse number="14" style="v" sid="NUM 30:14"/>ሽን እ አዝናይ ሄ ጋላስ ዎይኮ ዎንተ ጋላስ አይኮካ ጎና እፅኮ፥ እ ጫቁዋ ዎይኮ እ ቃንገ ምንስ ጉሱ። እ ሄሳ ስእድ፥ ስእ ጊኮ እ ቆፋ ማእስ ጉሱ። <verse eid="NUM 30:14"/><verse number="15" style="v" sid="NUM 30:15"/>ሽን እ ሄሳ ስእ ጋምእድ ዛር ድግያባ ግድኮ ሄሳስ ኦይሸተይ እያ” ያግስ።<verse eid="NUM 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16"/>ህዛ ሀይስ አዝና ግዶንነ ማች ግዶን፥ ባ አዋራ ሶን ደእያ ጌላኦ ግዶንነ እ አዋ ግዶን ደእያ ጋሄተባ ጎዳይ ሙሰስ እምዳ ዎጋ።<verse eid="NUM 30:16"/></para>
  <chapter eid="NUM 30"/>
  <chapter number="31" style="c" sid="NUM 31"/>
  <para style="s1">ምድያመ ቦላ ደንድዳ ኦላ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 31:1"/><verse number="2" style="v" sid="NUM 31:2"/>“እስራኤለ አሳ ቆህዳ ግሾ ምድያመ አሳ ኦላዳ ሀሎ ከያ፤ ሄሳፈ ጉየ፥ ኔኒ ሀይቃዳ ነ ማይዛታ ጋካና” ያግስ።<verse eid="NUM 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3"/>ሄሳ ግሾ፥ ሙሰይ አሳኮ፥ “ምድያመ አሳ ኦልድ ጎዳ ሀሎ ከያና መላ ህንተ ግዶፈ ጉ አሳ ኦላስ ዳንጭስተ። <verse eid="NUM 31:3"/><verse number="4" style="v" sid="NUM 31:4"/>እስ እስ እስራኤለ ኮቻፈ እስ ሙኩሉ አደ አሳ ኦላስ የድተ” ያግስ።<verse eid="NUM 31:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 31:5"/>ሄሳ ግሾ፥ እስ እስ እስራኤለ ኮቻፈ እስ እስ ሙኩሉ አሳይ ከይድ፥ ታማነ ናምኡ ሙኩሉ ኦላንቾት ኦላስ ጊግዶሶና። <verse eid="NUM 31:5"/><verse number="6" style="v" sid="NUM 31:6"/>ሙሰይ ካህንያ አላዛራ ናኣ ፕንሃሳ አዋተን፥ እስ እስ ኮቻፈ እስ እስ ሙኩሉ አስ ዶርድ ኦላስ የድስ፤ ፕንሃስ ብሸ ጌሻ ሚሸታነ ማላስ ፑንያ ዛየ ኤክድ ብስ። <verse eid="NUM 31:6"/><verse number="7" style="v" sid="NUM 31:7"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ ኤንቲ ምድያመ አሳ ኦልድ አደ ኡባ ዎዶሶና። <verse eid="NUM 31:7"/><verse number="8" style="v" sid="NUM 31:8"/>እቻሹ ምድያመ ካዎታ፥ ኤዋ፥ ረቄማ፥ ዙራ፥ ሁራነ ሬባ ጌተትያ አሳታ ዎዶሶና፤ ቃስ ብኦራ ናኣ ባላማካ ማሻን ዎዶሶና። <verse eid="NUM 31:8"/><verse number="9" style="v" sid="NUM 31:9"/>እስራኤለ አሳይ ምድያመ ማጫሳነ ናይታ ድእዶሶና፤ ኤንታ መህያ፥ ዶርሳነ ዴሻ ዉድያነ ኤንታ ሚሸ ኡባ ድእዶሶና። <verse eid="NUM 31:9"/><verse number="10" style="v" sid="NUM 31:10"/>ኤንቲ ደእያ ካታማታነ ኤንታ ጉታታ ኡባ ፁግዶሶና። <verse eid="NUM 31:10"/><verse number="11" style="v" sid="NUM 31:11"/>አሳ መህያነ ደእዳባ ኡባ ኤክድ ብዶሶና። <verse eid="NUM 31:11"/><verse number="12" style="v" sid="NUM 31:12"/>ኤንቲ ድእዳ አሳ፥ መህያነ ሻሎ ኡባ እያርኮፈ ሄፍንን፥ ዮርዳኖሰ ሻፋ ማታን ደእያ ሞአበ ደንባን ዱንካንዳ ሙሰኮ፥ ካህንያ አላዛራኮነ እስራኤለ ማባራኮ ኤህዶሶና።<verse eid="NUM 31:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13"/>ሙሰይ፥ ካህነያ አላዛርነ ማባራ ሀላቃት ኡባይ ዱንካንዳ ጉታፐ ጋፃ ከይድ ኤንታና ሞክዶሶና። <verse eid="NUM 31:13"/><verse number="14" style="v" sid="NUM 31:14"/>ሙሰይ ኦላፐ ስምዳ ቾራ ሞጮናታ፥ ሻላቃታነ ማቶ ሀላቃታ ቦላ ሀንቀትስ። <verse eid="NUM 31:14"/><verse number="15" style="v" sid="NUM 31:15"/>ሙሰይ ኤንታኮ፥ “ማጫሳ ኡባ አይስ ዎቤከቲ? <verse eid="NUM 31:15"/><verse number="16" style="v" sid="NUM 31:16"/>ኤንቲ ባላማ ዞርያ ስእድ፥ ፐኦራ ጌተትያ በሳን እስራኤለ አሳይ ጎዳ አግድ፥ ቦሻን ሀይቃናዳ ኦዳይ ማጫሳ ግደይሳ ዶግደቲ? <verse eid="NUM 31:16"/><verse number="17" style="v" sid="NUM 31:17"/>ሄሳ ግሾ፥ ሀእ አደ ናይታነ አደራ አቅዳ ማጫስ ኡባ ዎተ። <verse eid="NUM 31:17"/><verse number="18" style="v" sid="NUM 31:18"/>ሽን አደራ አቅቦና ማጫ ናይታ ኡባ ህንተዉ አሽተ። <verse eid="NUM 31:18"/><verse number="19" style="v" sid="NUM 31:19"/>ህንተ ግዶፈ አሰ ዎዳ አስ ዎይኮ አሀ ቦችዳ ኦንካ ጉታፐ ጋፃን ላፑን ጋላስ ኡቶ፤ ሄን ጋላሳንነ ላፑን ጋላሳን ህንተናነ ህንተ ድእዳ አሳ ጌሽተ። <verse eid="NUM 31:19"/><verse number="20" style="v" sid="NUM 31:20"/>ሄሳዳካ ማኦ ኡባ፥ ጋልባፈ፥ ዴሻ እክሰፐነ ምፈ ኦሰትዳባታ ኡባ ጌሽተ” ያግስ።<verse eid="NUM 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21"/>ካህነይ አላዛር ኦላፐ ስምዳ ኦላንቾታኮ፥ “ጎዳይ ሙሰስ እምዳ ህግያ ማራይ ሀይሳ፤ <verse eid="NUM 31:21"/><verse number="22" style="v" sid="NUM 31:22"/>ዎርቃ፥ ብራ፥ ናሰ፥ ብራታ፥ ቆርቆሮ፥ እርሳሰ፥ <verse eid="NUM 31:22"/><verse number="23" style="v" sid="NUM 31:23"/>ታማን ሜተቶናባት ኡባይ ታማን ጌያናዉ በሴስ። ሽን ታማን ሜተትያባት ጌሾ ሃን ጌያናዉ በሴስ። <verse eid="NUM 31:23"/><verse number="24" style="v" sid="NUM 31:24"/>ላፑን ጋላሳን ህንተ ማኡዋ ሜጭተ፤ ህንተና ጌሽተ። ሄሳፈ ጉየ፥ ጉታ ገልተ” ያግስ።<verse eid="NUM 31:24"/></para>
  <para style="s1">ድእዳባ ሻከትዶሶና</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 31:25"/><verse number="26" style="v" sid="NUM 31:26"/>“ኔራ፥ ካህንያ አላዛራራነ እስራኤለ ማባራ ሀላቃት ድኤትዳ አሳነ መህያ ታይብተ። <verse eid="NUM 31:26"/><verse number="27" style="v" sid="NUM 31:27"/>ኦላ ብዳይሳታስነ ቦናይሳታስ ናምኡ ከስድ ሻክተ። <verse eid="NUM 31:27"/><verse number="28" style="v" sid="NUM 31:28"/>ኦላ ብዳይሳታ ግሹዋፐ አሰ ግድን ሚዝ ግድን ሀረ ግድን ዶርሰ ዎይኮ ዴሸ ግድን እቻሹ ፄታፐ እስኖ ጎዳስ እምተ። <verse eid="NUM 31:28"/><verse number="29" style="v" sid="NUM 31:29"/>ኤንታ ግሹዋፐ ኤክዳ ጎዳ እሞታ ካህንያ አላዛራስ እምተ። <verse eid="NUM 31:29"/><verse number="30" style="v" sid="NUM 31:30"/>ሀንኮ እስራኤለታ ጋክዳ ግሹዋፐ፥ አሰ ግድን ሚዝ ግድን ሀረ ግድን ዶርሰ ዎይኮ ዴሸ ግድን እሻታማፈ እስኖ ኤክድ ጎዳ ዱንካንያ አዋተን አይስያ ሌወታስ እምተ” ያግስ። <verse eid="NUM 31:30"/><verse number="31" style="v" sid="NUM 31:31"/>ሙሰይነ ካህነይ አላዛር ጎዳይ ኪትዳይሳዳ ኦዶሶና።<verse eid="NUM 31:31"/></para>
  <para style="p">
    <verse number="32-35" style="v" sid="NUM 31:32-35"/>ኦላንቾት ባንታዉ ኤክን አትዳ ድኦይ 675,000 ዶርሳታ፥ 72,000 ሚዛታ፥ 61,000 ሀረታነ 32,000 ጌላኦ ማጫ ናይታ። <verse eid="NUM 31:32-35"/><verse number="36" style="v" sid="NUM 31:36"/>ኦላ ብዳይሳታ ጋክዳ ግሾይ 337,500 ዶርሳታ፤ <verse eid="NUM 31:36"/><verse number="37" style="v" sid="NUM 31:37"/>ኤንታፈ ጎዳስ እመትዳይ 675. <verse eid="NUM 31:37"/><verse number="38" style="v" sid="NUM 31:38"/>ሚዛት 36,000፤ ኤንታፈ ጎዳስ እመትዳይ 72. <verse eid="NUM 31:38"/><verse number="39" style="v" sid="NUM 31:39"/>ሀረት 30,500፤ ኤንታፈ ጎዳስ እመትዳይ 61. <verse eid="NUM 31:39"/><verse number="40" style="v" sid="NUM 31:40"/>ማጫሳት 16,000፤ ኤንታፈ ጎዳስ እመትዳይ 32. <verse eid="NUM 31:40"/><verse number="41" style="v" sid="NUM 31:41"/>ጎዳይ ሙሰ ኪትዳይሳዳ ጎዳ እሞታ ካህንያ አላዛራስ እሚስ።<verse eid="NUM 31:41"/></para>
  <para style="p">
    <verse number="42-46" style="v" sid="NUM 31:42-46"/>ኦላ ቦና እስራኤለ ማባራ ጋክዳ ግሾይ ኦላ ብዳ አሳ ግሹዋራ እስ ግና፤ እካ 337,500 ዶርሳታ፥ 36,000 ሚዛታ፥ 30,500 ሀረታነ 16,000 ጌላኦ ማጫ ናይታ። <verse eid="NUM 31:42-46"/><verse number="47" style="v" sid="NUM 31:47"/>እስራኤለ ማባራ ጋክዳ ግሹዋፐ እሻታሙ አሳፐነ መህያፐ እሶ እሶ ከስድ ጎዳይ እያ ኪትዳይሳዳ ጌሻ ዱንካንያ አዋተን አይስያ ሌወታስ እሚስ።<verse eid="NUM 31:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48"/>ሄሳፈ ጉየ፥ ቶራ ሞጮናት፥ ሻላቃትነ ማቶ ሀላቃት ሙሰኮ ሺቅድ፥ <verse eid="NUM 31:48"/><verse number="49" style="v" sid="NUM 31:49"/>“ኑኒ ነ አይለት ኑ አዋተ ጋርሳን ደእያ ኦላንቾታ ታይብን እሶይካ ፓጭቤና። <verse eid="NUM 31:49"/><verse number="50" style="v" sid="NUM 31:50"/>ጎዳይ ኑ ሸምፑዋ አሽዳ ግሾ፥ ኑ እሶይ እሶይ ኤክዳ ዎርቃ አሌቆታ፥ ሳጋዮታ፥ ቶሆ አልቦታ፥ ምግዶታ፥ ሀይ ዎርቃታነ ቆ ዎርቃታ ጎዳስ እማናዉ ኤክድ ይዳ” ያግዶሶና። <verse eid="NUM 31:50"/><verse number="51" style="v" sid="NUM 31:51"/>ሙሰይነ ካህነይ አላዛር ዎርቃ አሌቆታ ኡባ ኤንታፈ ኤክዶሶና። <verse eid="NUM 31:51"/><verse number="52" style="v" sid="NUM 31:52"/>ሻላቃትነ ማቶ ሀላቃት ጎዳስ እምዳ ዎርቃይ ናምኡ ፄቱ ክሎ ግራመ ግድስ። <verse eid="NUM 31:52"/><verse number="53" style="v" sid="NUM 31:53"/>ሀንኮ ኦላንቾት ኤህዳ ድኡዋ ባንታዉ ኤክዶሶና። <verse eid="NUM 31:53"/><verse number="54" style="v" sid="NUM 31:54"/>ሙሰይነ ካህነይ አላዛር ሻላቃታፐነ ማቶ ሀላቃታፐ ኤክዳ ዎርቃ ጎዳ ስንን እስራኤለ አሳ ሀሳይስያባ ኦድ ጌሻ ዱንካንያ ግዶ ኤህዶሶና።<verse eid="NUM 31:54"/></para>
  <chapter eid="NUM 31"/>
  <chapter number="32" style="c" sid="NUM 32"/>
  <para style="s1">ዮርዳኖሰፐ ሄፍንን ኡትዳ ኮቻታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1"/>ሮቤላነ ጋደ ኮቻስ ዳሮ መሄይ ደኤስ። ኤንቲ ያእዜራ ቢታይነ ጋላዳ ቢታይ መሄስ እንጀ ግደይሳ፥ <verse eid="NUM 32:1"/><verse number="2" style="v" sid="NUM 32:2"/>በእድ ሙሰኮ፥ ካህንያ አላዛራኮነ እስራኤለ ማባራ ሀላቃታኮ ይድ ሀይሳዳ ያግዶሶና። <verse eid="NUM 32:2"/><verse number="3-4" style="v" sid="NUM 32:3-4"/>“እስራኤለ አሳይ ላታና መላ ጎዳይ ማድዳ ቢታይ፥ አፃሮተይ፥ ድቦን፥ ያእዜር፥ ንምር፥ ሀሰቦን፥ ኤልያል፥ ሰባም፥ ናቦይነ ባኦን መሄስ እንጀ ቢታ፤ ኑስ ህንተ አይለታስ ዳሮ መሄይ ደኤስ። <verse eid="NUM 32:3-4"/><verse number="5" style="v" sid="NUM 32:5"/>ኑኒ ህንተ ስንን ሳባ ደምዳባ ግድኮ፥ ሄ ቢታ ኑስ ህንተ አይለታ ላታ ኦድ እምተ፤ ኑና ዮርዳኖሰ ሻፋፐ ሄፍን ፕንፍተ” ያግዶሶና።<verse eid="NUM 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6"/>ሙሰይ ጋደ ኮቻታኮነ ሮቤላ ኮቻታኮ፥ “ህንተ ባጋ ግድዳ እስራኤለ አሳይ ኦላስ ብያ ዎደ ህንተ ሀይሳን ኡታናዉ ኮዬቲ? <verse eid="NUM 32:6"/><verse number="7" style="v" sid="NUM 32:7"/>ጎዳይ ኤንታዉ እምዳ ቢታ ኤንቲ ፕኖና መላ ህንተ አይስ ኤንታ ዎዛና ሹግሴቲ? <verse eid="NUM 32:7"/><verse number="8" style="v" sid="NUM 32:8"/>ቃደሳ ባርነፈ ሀ ቢታ ዎቻና መላ ህንተ አዋታ ታ የድዳ ዎደ ኤንትካ ሀይሳዳ ኦዶሶና። <verse eid="NUM 32:8"/><verse number="9" style="v" sid="NUM 32:9"/>ኤንቲ ኤሽኮላ ዛንጋራ ጋካናዉ ብድ ሄ ቢታ በእ ስሚድ እስራኤለት ጎዳይ ኤንታዉ እምዳ ቢታ ገሎና መላ እስራኤለታ ዎዛና ሹግስዶሶና። <verse eid="NUM 32:9"/><verse number="10" style="v" sid="NUM 32:10"/>ጎዳይ ሄ ጋላስ ዳሮ ሀንቀትድ ሀይሳዳ ያግድ ጫቅስ፤ <verse eid="NUM 32:10"/><verse number="11" style="v" sid="NUM 32:11"/>‘ባንታ ኩመ ዎዛናፐ ታና ካልቦና ግሾ፥ ግብፀ ቢታፈ ከይዳይሳታፐ ላይ ላታማነ እያፐ ቦላ ግድዳ አደ አሳፐ እሶይካ አብራሃመስ፥ ይሳቃስነ ያይቆባስ እማና ጋዳ ጫቅዳ ቢታ ገለኮና። <verse eid="NUM 32:11"/><verse number="12" style="v" sid="NUM 32:12"/>ባንታ ኩመ ዎዛናፐ ካልዳ ግሾ፥ ቀነዛ ዮፎና ናኣ ካለባፐነ ናወ ናኣ እያሱፐ አትሽን፥ ሀር ኦንካ ገለና’ ያግስ። <verse eid="NUM 32:12"/><verse number="13" style="v" sid="NUM 32:13"/>ጎዳ ሀንቆይ እስራኤለ አሳ ቦላ ኤፅዳ ግሾ ጎዳ ስንን ኢታ ኦዳ ሄ የለተ ኡባይ ያና ጋካናዉ መላ ቢታን ኦይታሙ ላይ ቶይላትዶሶና። <verse eid="NUM 32:13"/><verse number="14" style="v" sid="NUM 32:14"/>ህንተኖ፥ ናጋራንቾታ ናይቶ ህንተ አዋታ በሳን ኤቅድ ጎዳይ እስራኤለ አሳ ቦላ ጉጅድ ሀንቀታና መላ ኦታ። <verse eid="NUM 32:14"/><verse number="15" style="v" sid="NUM 32:15"/>ህንተ ጎዳ ካሎና እፅኮ፥ እ ቃስካ ባ ደርያ መላ ቢታን አጋና። ኤንታና ጋክያ ዩዋስ ህንተ ኦይሸታና” ያግስ።<verse eid="NUM 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16"/>ኤንቲ ሙሰኮ ሺቅድ፥ “ኑኒ ሀይሳን ኑ መህያስ ዳራ፥ ኑ ናይታስነ ኑ ማቸታስ ካታማ ኬፃናዉ ኮዮስ። <verse eid="NUM 32:16"/><verse number="17" style="v" sid="NUM 32:17"/>ሽን እስራኤለ አሳይ ባንታ በሳ ኤካና ጋካናዉ ኑኒ ኦላ ሚሸ ዳንጭድ ኤንታ ስንን ከይድ ኦለታናዉ ጊገትዳ። ሄ ዎደ ሄ ቢታን ደእያ አሳይ ኑ ናይታነ ኑ ማቸታ ቆሆና መላ ግምበትድ ኡትዳ ካታማታን ደኦና። <verse eid="NUM 32:17"/><verse number="18" style="v" sid="NUM 32:18"/>እስራኤለ አሳ ኡባይ ባንታ ላታ ላታ ኤካና ጋካናዉ፥ ኑኒ ኑ ሶ ስሞኮ። <verse eid="NUM 32:18"/><verse number="19" style="v" sid="NUM 32:19"/>ኑኒ ኑ ላታ ዮርዳኖሰ ሻፋፐ ሀፍንን ዶሎሀ ባጋን ላትዳ ግሾ፥ ዮርዳኖሰፐ ሄፍንን ዉሎሀ ባጋን ኤንታራ ላታ ኤኮኮ” ያግዶሶና።<verse eid="NUM 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20"/>ሙሰይ ኤንታኮ፥ “ህንተ ገይስ ቱማ ግድኮ ሀይሳን ጎዳ ስንን ኦላ ባናዉ ዳንጨትተ። <verse eid="NUM 32:20"/><verse number="21" style="v" sid="NUM 32:21"/>ጎዳይ ባ ሞርከታ ባ ስንፈ ጎዳና ጋካናዉ ህንተ ኦላ ሚሽያ ዳንጭድ፥ ዮርዳኖሰ ሻፋ ጎዳ ስንን ፕንኮ፥ <verse eid="NUM 32:21"/><verse number="22" style="v" sid="NUM 32:22"/>ሄ ቢታ ጎዳይ ፆንዳፐ ጉየ ህንተ ስማናዉ ዳንዳኤታ። ሄ ዎደ ህንተ ጎዳስነ እስራኤለ አሳስ ኦለትድ ፖልደታ ጉሱ። ቃስ ሄ ቢታይ ጎዳ ስንን ህንተዉ ላታ ግዳና።<verse eid="NUM 32:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 32:23"/>“ህንተ ሄሳ ኦና እፅኮ ጎዳ ቦላ ናጋራ ኦታ፤ ህዛ፥ ህንተ ናጋራ ግሾ ህንተና ሴር ጋካናይሳ ሎይ ኤርተ። <verse eid="NUM 32:23"/><verse number="24" style="v" sid="NUM 32:24"/>ህንተ ህንተዉ ካታማታ፥ ህንተ መህያስ ዳራ ኬፅተ፥ ሽን ህንተ ገልዳ ቃላ ፖልተ” ያግስ።<verse eid="NUM 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25"/>ጋደ ኮቻይነ ሮቤላ፥ ኮቻይ ሙሰኮ፥ “ኑኒ ነ አይለት ነ ኪትዳይሳዳ ኦና። <verse eid="NUM 32:25"/><verse number="26" style="v" sid="NUM 32:26"/>ኑ ናይት፥ ኑ ማቸት፥ ኑ ዶርሳትነ ኑ መሄይ ሀይሳን ጋላዳ ካታማታን ደእሾና። <verse eid="NUM 32:26"/><verse number="27" style="v" sid="NUM 32:27"/>ሽን ኑኒ ነ አይለት፥ ኦላንቾት ኡባይ፥ ኔኒ ኑ ጎዳይ ግዳይሳዳ ኦለታናዉ ጎዳ ስንን ዮርዳኖሰ ሻፋ ፕናና” ያግዶሶና።<verse eid="NUM 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28"/>ሄሳ ግሾ፥ ሙሰይ ካህንያ አላዛራ፥ ናወ ናአ እያሱነ እስራኤለ ኮቻታ ሀላቃታ ኤንታባ ያግድ ኪትስ። <verse eid="NUM 32:28"/><verse number="29" style="v" sid="NUM 32:29"/>“ጋደ ኮቻይነ ሮቤላ ኮቻይ ኡባይ ኦላ ሚሽያ ዳንጭድ፥ ጎዳ ስንን ህንተራ ዮርዳኖሰ ሻፋ ፕንኮነ ህንተ ሄ ቢታ ፆንኮ፥ ሄሳፈ ጉየ፥ ጋላዳ ቢታ ህንተ ኤንታ ላትስተ። <verse eid="NUM 32:29"/><verse number="30" style="v" sid="NUM 32:30"/>ሽን ኤንቲ ኦላ ሚሽያ ዳንጭድ፥ ህንተራ ፕንድ ኦላስ ቦና እፅኮ፥ ህንተዳ ኤንታዉ ካናነ ቢታን ላት እመቶ” ያግስ።<verse eid="NUM 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31"/>ያትን። ጋደ ኮቻይነ ሮቤላ ኮቻይ ዛሪድ፥ “ኑኒ ነ አይለት ጎዳይ ግዳይሳ ኦና። <verse eid="NUM 32:31"/><verse number="32" style="v" sid="NUM 32:32"/>ኑኒ ኦላ ሚሽያ ዳንጭድ፥ ጎዳ ስንን ካናነ ቢታ ገላናዉ ፕናና፤ ሽን ኑኒ ላትያ ላታይ ዮርዳኖሰፐ ሀፍን ባጋ ግዶ” ያግዶሶና።<verse eid="NUM 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33"/>ሄሳ ግሾ፥ ሙሰይ ጋደ ኮቻስ፥ ሮቤላ ኮቻስነ ዮሰፋ ናኣ ምናሰ ኮቻፈ ባጋስ አሞረ ካዋ ስሆና ካዎተነ ባሳነ ካዋ ኦገ ካዎተ ኤንታ ዩሹዋን ደእያ ካታማታራ እሚስ። <verse eid="NUM 32:33"/><verse number="34" style="v" sid="NUM 32:34"/>ጋደ ኮቻይ ድቦና፥ አፃሮታ፥ አሮኤራ <verse eid="NUM 32:34"/><verse number="35" style="v" sid="NUM 32:35"/>አፅሮት-ሻፋና፥ ያእዜራ፥ ዮግባ፥ <verse eid="NUM 32:35"/><verse number="36" style="v" sid="NUM 32:36"/>ቤት-ንምራነ ቤት-ሀራና ጌተትያ ግምበን ድረትዳ ካታማታ ዛሪድ ኬፅዶሶና፤ ባንታ መህያስ ዳራ ኬፅዶሶና።<verse eid="NUM 32:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 32:37"/>ሮቤላ፥ ኮቻይ ሀሰቦና፥ ኤልኣላ፥ ቅራታይማ፥ <verse eid="NUM 32:37"/><verse number="38" style="v" sid="NUM 32:38"/>ናባ፥ ባኣል-ማኦናነ ሰባማ ጌተትያ ካታማታ ዛረ ኬፅዶሶና፤ ሄ ካታማታ ሱን ላምዶሶና።<verse eid="NUM 32:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39"/>ምናሰ ናኣ ማክራ ኮቻት ጋላዳ ቢታ ኦል ኦይክድ ያን ደእያ አሞረታ ጎድዶሶና። <verse eid="NUM 32:39"/><verse number="40" style="v" sid="NUM 32:40"/>ሄሳ ግሾ፥ ምናሰ ናኣ ማክራ ኮቻስ ሙሰይ ጋላዳ ቢታ እምን ኤንቲ ያን ደእዶሶና። <verse eid="NUM 32:40"/><verse number="41" style="v" sid="NUM 32:41"/>ምናሰ ኮች ግድዳ ያእር ሄ ካታማታ ኦል ኦይክድ፥ “ያእራ ካታማታ” ያግድ ሱንስ። <verse eid="NUM 32:41"/><verse number="42" style="v" sid="NUM 32:42"/>ኖባ ቃናታ ካታማነ እያ ዩሹዋን ደእያ ጉታታ ኦላን ኦይክደ፥ ባ ሱንን “ኖባ” ግድ ሱንስ።<verse eid="NUM 32:42"/></para>
  <chapter eid="NUM 32"/>
  <chapter number="33" style="c" sid="NUM 33"/>
  <para style="s1">ግብፀፈ ሞአበ ጋካናዉ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1"/>ሙሰይነ አሮን ካለን፥ እስራኤለ አሳይ፥ ባንታ ጩጋን ጩጋን ግብፀፈ ከይድ ሲራትዳ ጉታታ ኦድያ ታርከይ ሀይሳ። <verse eid="NUM 33:1"/><verse number="2" style="v" sid="NUM 33:2"/>ጎዳይ ኪትዳይሳ መላ ሙሰይ ኤንቲ ሲራትዳ በሳታ ሱን ኡባ ካል ካል ፃፍስ።<verse eid="NUM 33:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 33:3"/>እስራኤለ አሳይ ኮይሮ አጌናን፥ ታማነ እቻሻን ጋላሳን፥ ፓስካ ቦንችያ ናምአን ጋላስ ደንድድ፥ ግብፀ አሳ ኡባይ በእሽን፥ ያዮና ራምሰፐ ከይዶሶና። <verse eid="NUM 33:3"/><verse number="4" style="v" sid="NUM 33:4"/>ሄ ዎደ ግብፀ አሳይ ጎዳ ጋዶን ሀይቅዳ ባንታ ባይራ ናይታ ሞጎሶና። ሄሳዳ ኦድ፥ ጎዳይ ኤንታ ፆሳታ ቦላ ፕርዳ ኤህስ።<verse eid="NUM 33:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 33:5"/>እስራኤለ አሳይ ራምሰፐ ደንድድ ሱኮታ ጌተትያ በሳን ዱንካንዶሶና።<verse eid="NUM 33:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 33:6"/>ሱኮታፐ ደንድድ መላ ቢታ ጋፃን ደእያ ኤታማን ዱንካንዶሶና።<verse eid="NUM 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 33:7"/>ኤታማፐ ደንድድ ባአል-ፃፎናፐ ዶሎሀ ባጋን ደእያ ፕሀህሮታ ስሚድ ምግዶላ ማታን ዱንካንዶሶና።<verse eid="NUM 33:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 33:8"/>ፕሀህሮታፐ ደንድድ፥ ዞኦ አባ ፕንድ፥ ሱዛ መላ ቢታ ብዶሶና። ኤታማ መላ ቢታን ሄ ጋላስ ሄመትድ ማራን ዱንካንዶሶና።<verse eid="NUM 33:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 33:9"/>ማራፐ ደንድድ ታማነ ናምኡ ፑልቶትነ ላፑን ታሙ ዛምባት ደእያ ኤልማን ዱንካንዶሶና።<verse eid="NUM 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 33:10"/>ኤልማፐ ደንድድ ዞኦ አባ ማታን ዱንካንዶሶና።<verse eid="NUM 33:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 33:11"/>ዞኦ አባ ማታፐ ደንድድ ሲና መላ ቢታን ዱንካንዶሶና።<verse eid="NUM 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 33:12"/>ሲና መላ ቢታፈ ደንድድ ራፋቃን ዱንካንዶሶና።<verse eid="NUM 33:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 33:13"/>ራፋቃፐ ደንድድ ኤሉሳን ዱንካንዶሶና።<verse eid="NUM 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 33:14"/>ኤሉሳፐ ደንድድ ሃ ባይና በሳን ራፍድማን ዱንካንዶሶና።<verse eid="NUM 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 33:15"/>ራፍድማፐ ደንድድ ሲና መላ ቢታን ዱንካንዶሶና።<verse eid="NUM 33:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 33:16"/>ሲና መላ ቢታፈ ደንድድ ክብሮት ሀትአዋን<note caller="+" style="f"><char style="fr" closed="false">33:16 </char><char style="fk" closed="false">ክብሮት ሀትአዋን፦ </char><char style="ft" closed="false">አሞ ዱፎ ጌተትያ በሲ</char></note> ዱንካንዶሶና።<verse eid="NUM 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 33:17"/>ክብሮት ሀትአዋፐ ደንድድ ሀፀሮታን ዱንካንዶሶና።<verse eid="NUM 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 33:18"/>ሀፀሮታፐ ደንድድ እርትማን ዱንካንዶሶና።<verse eid="NUM 33:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 33:19"/>እርትማፐ ደንድድ እርሞን-ፓሬዛን ዱንካንዶሶና።<verse eid="NUM 33:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 33:20"/>እርሞን-ፓሬዛፐ ደንድድ ልብናን ዱንካንዶሶና።<verse eid="NUM 33:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 33:21"/>ልብናፐ ደንድድ እርሳን ዱንካንዶሶና።<verse eid="NUM 33:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 33:22"/>እርሳፐ ደንድድ ቃሄላታን ዱንካንዶሶና።<verse eid="NUM 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 33:23"/>ቃሄላታፐ ደንድድ ሸፋራ ዙማን ዱንካንዶሶና።<verse eid="NUM 33:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 33:24"/>ሸፋራ ዙማፐ ደንድድ ሀራዳን ዱንካንዶሶና።<verse eid="NUM 33:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 33:25"/>ሀራዳፐ ደንድድ ማቅሄሎታን ዱንካንዶሶና።<verse eid="NUM 33:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 33:26"/>ማቅሄሎታፐ ደንድድ ታሀታን ዱንካንዶሶና።<verse eid="NUM 33:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 33:27"/>ታሀታፐ ደንድድ ታራን ዱንካንዶሶና።<verse eid="NUM 33:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 33:28"/>ታራፐ ደንድድ ምትቃን ዱንካንዶሶና።<verse eid="NUM 33:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 33:29"/>ምትቃፐ ደንድድ ሀሽሞናን ዱንካንዶሶና።<verse eid="NUM 33:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 33:30"/>ሀሽሞናፐ ደንድድ ሞሰሮታን ዱንካንዶሶና።<verse eid="NUM 33:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 33:31"/>ሞሰሮታፐ ደንድድ በን-ያእቃናን ዱንካንዶሶና።<verse eid="NUM 33:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 33:32"/>በን-ያእቃናፐ ደንድድ ሆር-ሀግድጋዳን ዱንካንዶሶና።<verse eid="NUM 33:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 33:33"/>ሆር-ሀግድጋዳፐ ደንድድ ዮፅባታን ዱንካንዶሶና።<verse eid="NUM 33:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 33:34"/>ዮፅባታፐ ደንድድ አብሮናን ዱንካንዶሶና።<verse eid="NUM 33:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 33:35"/>አብሮናፐ ደንድድ ኤፅዮን-ጋብራን ዱንካንዶሶና።<verse eid="NUM 33:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 33:36"/>ኤፅዮን-ጋብራፐ ደንድድ ሲና መላ ቢታን ቃደሳን ዱንካንዶሶና።<verse eid="NUM 33:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 33:37"/>ቃደሳፐ ደንድድ ኤዶመ ቢታ ዛዋን ደእያ ሆራ ዙማን ዱንካንዶሶና። <verse eid="NUM 33:37"/><verse number="38" style="v" sid="NUM 33:38"/>ካህነይ አሮን ጎዳ ኪታን ሆራ ዙማ ቦላ ከይድ፥ እስራኤለ አሳይ ግብፀ ቢታፈ ከይዳ ኦይታማን ላይን፥ እቻሻን አጌናን፥ ኮይሮ ጋላሳን ያን ሀይቅስ። <verse eid="NUM 33:38"/><verse number="39" style="v" sid="NUM 33:39"/>አሮን ሆራ ዙማ ቦላ ሀይቅያ ዎደ እያዉ ላይ ፄታነ ላታማነ ሄ።<verse eid="NUM 33:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 33:40"/>ነገበ መላ ቢታን ካናነን ደእያ አራዳ ካዎይ እስራኤለ አሳ ዩሳ ስእስ።<verse eid="NUM 33:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 33:41"/>እስራኤለ አሳይ ሆራ ዙማፐ ደንድድ ፃልሞናን ዱንካንዶሶና።<verse eid="NUM 33:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 33:42"/>ፃልሞናፐ ደንድድ ፑኖናን ዱንካንዶሶና።<verse eid="NUM 33:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="NUM 33:43"/>ፑኖናፐ ደንድድ ኦቦታን ዱንካንዶሶና።<verse eid="NUM 33:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 33:44"/>ኦቦታፐ ደንድድ ሞአበ ቢታ ዛዋን ደእያ አባሪማን ዱንካንዶሶና።<verse eid="NUM 33:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="NUM 33:45"/>አባሪማፐ ደንድድ ድቦን-ጋዳን ዱንካንዶሶና።<verse eid="NUM 33:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 33:46"/>ድቦን-ጋዳፐ ደንድድ አልሞን-ድብላታይማን ዱንካንዶሶና።<verse eid="NUM 33:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 33:47"/>አልሞን-ድብላታይማፐ ደንድድ ናቦ ዙማ ስንን አባሪማ ዙማታ ቦላ ዱንካንዶሶና።<verse eid="NUM 33:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 33:48"/>አባሪማ ዙማታፐ ደንድድ እያርኮፈ ሄፍንን፥ ዮርዳኖሰ ሻፋ ማታን ደእያ ሞአበ ደንባን ዱንካንዶሶና። <verse eid="NUM 33:48"/><verse number="49" style="v" sid="NUM 33:49"/>ዮርዳኖሰ ሻፋ ማታን ደእያ ሞአበ ደንባን፥ ቤት-ያሽሞታፐነ አቤል-ሳፅማ ዛንጋራፐ ግዶን ዱንካንዶሶና።<verse eid="NUM 33:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50"/>እያርኮፈ ሄፍንን፥ ዮርዳኖሰ ሻፋ ማታን ደእያ ሞአበ ደምባን ጎዳይ ሙሰኮ፥ <verse eid="NUM 33:50"/><verse number="51" style="v" sid="NUM 33:51"/>“እስራኤለ አሳስ ያጋዳ ኦዳ፤ ዮርዳኖሰ ሻፋ ፕንድ፥ ካናነ ቢታ ህንተ ገልያ ዎደ <verse eid="NUM 33:51"/><verse number="52" style="v" sid="NUM 33:52"/>ሄ ቢታን ደእያ አሳ ኡባ ህንተ ስንፈ የደተ። ሹቻፈ ማሰትድ ኦሰትዳ ምስለታነ ሼሽድ መዳ ኤቃታ ይስተ። ቃ ጎይኖ በሳታ ኡባ ላልተ። <verse eid="NUM 33:52"/><verse number="53" style="v" sid="NUM 33:53"/>ሄ ቢታ ታ ህንተዉ እምዳ ግሾ እያ ላትድ ያን ደእተ። <verse eid="NUM 33:53"/><verse number="54" style="v" sid="NUM 33:54"/>ህንተ ኮቻን ኮቻን ሳማ ከስድ ቢታ ሻከትተ። ታይቦን ዳርያ ኮቻታስ ዳልጋ ላታ እምተ፤ ታይቦን ጉፅያ ኮቻታስ ጉ ላታ እምተ። ሳማን ኤንታ ጋክዳ ቢታይ ኤንታባ ግዳና። ቢታ ህንተ ማይዛታ ኮቻን ኮቻን ሻክድ ኤክተ። <verse eid="NUM 33:54"/><verse number="55" style="v" sid="NUM 33:55"/>ሽን ሄ ቢታን ደእያ አሳ ህንተ የደና እፅኮ፥ ህንተ አሽዳይሳት ህንተ አይፍያስ ፕንጮ፥ ህንተ ምይያስ አጉን ግዳና፤ ህንተ ዳና ቢታን ኡባ ዎደ ኦላ ደንድ ህንተና ዋይሳና። <verse eid="NUM 33:55"/><verse number="56" style="v" sid="NUM 33:56"/>ህንተ ኤንታ የደና እፅኮ፥ ታ ኤንታ ቦላ ኦናዉ ሀልችዳባ ህንተ ቦላ ኦና ጋዳ ኦዳ” ያግስ።<verse eid="NUM 33:56"/></para>
  <chapter eid="NUM 33"/>
  <chapter number="34" style="c" sid="NUM 34"/>
  <para style="s1">እስራኤለ ቢታ ዛዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 34:1"/><verse number="2" style="v" sid="NUM 34:2"/>“እስራኤለ አሳስ ሀይሳዳ ጋዳ ኦዳ፤ ህንተ ካናነ ገልያ ዎደ ታ ህንተዉ ላታ ኦዳ እማና ቢታ ዛዋይ ሀይሳ። <verse eid="NUM 34:2"/><verse number="3" style="v" sid="NUM 34:3"/>ዱገሀ ባጋ ዛዋይ ሲና መላ ቢታፈ ደንድድ ኤዶመ ዛዋ ካንስ። ዶሎሀ ባጋራ ህንተ ዛዋይ ማፅነ አባፈ ዱገ ባጋራ ዶምድ፥ <verse eid="NUM 34:3"/><verse number="4" style="v" sid="NUM 34:4"/>አቅራብማ አያ በሳ ሻክድ ሲና ቢታ ባዙዋ ካንድ ዱገሀ ባጋራ ቃደስ-ባርነ ጋኬስ። ያፐ ሀዳር-አዳራ ካንድ አፅሞና ጋኬስ። <verse eid="NUM 34:4"/><verse number="5" style="v" sid="NUM 34:5"/>አፅሞናፐ ደንድድ ግብፀ ሻፋ ጉየ ስሚድ መደትራነ አባ ጋኬስ።<verse eid="NUM 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 34:6"/>“ዉሎሀ ባጋ ዛዋይ መደትራነ አባ ጋፃ ግዳና።<verse eid="NUM 34:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 34:7"/>“ፑደሀ ባጋ ዛዋይ መደትራነ አባ ካልድ ሆራ ዙማ ጋካናዉ ቤስ። <verse eid="NUM 34:7"/><verse number="8" style="v" sid="NUM 34:8"/>ሆራ ዙማፐ ሀማታ ገልያ በሳ ጋካናዉ ቤስ፤ ሄ ዛዋ ዉርሰይ ፃዳዳ። <verse eid="NUM 34:8"/><verse number="9" style="v" sid="NUM 34:9"/>ያፐ ደንድድ ዝፍሮና ጋክድ፥ ሀፃር-ኤናናን ኤቄስ፤ ፑደሀ ባጋ ዛዋይ ሀይሳ።<verse eid="NUM 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 34:10"/>“ዶሎሀ ባጋ ዛዋይ ሀፃር-ኤናናፐ ሳፋማ ማላ ጋኬስ። <verse eid="NUM 34:10"/><verse number="11" style="v" sid="NUM 34:11"/>ሳፋማ ማላፈ ደንድድ አይናፐ ዶሎሀ ባጋራ እርብላ ዱገ ዎድ ከነሬታ አባፈ ዶሎሀ ባጋራ ደእያ ዙማታ ጋኬስ። <verse eid="NUM 34:11"/><verse number="12" style="v" sid="NUM 34:12"/>ሄሳፈ ህንተ ዛዋይ ዱገ ዮርዳኖሰ ሻፋ ዎ ዛዋይድ ማፅነ አባ ጋኬስ። ህንተ ቢታ ዩሾ ዛዋት ሀይሳታ” ያግስ።<verse eid="NUM 34:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13"/>ሙሰይ እስራኤለ አሳ ሀይሳዳ ያግድ ኪትስ፤ “ኡዱፉን ባጋ ኮቻስ ህንተ ሳማ የግድ ሻካና ላታ ቢታይ ሀይሳ። <verse eid="NUM 34:13"/><verse number="14" style="v" sid="NUM 34:14"/>ሮቤላ ኮቻይ፥ ጋደ ኮቻይነ ምናሰ ኮቻፈ ባጋይ፥ <verse eid="NUM 34:14"/><verse number="15" style="v" sid="NUM 34:15"/>ባንታ ላታ እያርኮፈ ሄፍንን፥ ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋን ኤክዶሶና” ያግስ።<verse eid="NUM 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 34:16"/><verse number="17" style="v" sid="NUM 34:17"/>“ካህንያ አላዛራነ ናወ ናኣ እያሱይ ሄ ቢታ አሳስ ሻኮ። <verse eid="NUM 34:17"/><verse number="18" style="v" sid="NUM 34:18"/>ቃስ ቢታ ሻካናዉ ማዳና መላ እስ እስ ኮቻፈ እስ እስ ሀላቃ ዶርተ። <verse eid="NUM 34:18"/><verse number="19" style="v" sid="NUM 34:19"/>ኤንታ ሱንይ ሀይሳፈ ካልድ ደኤይሳ።</para>
  <para style="li1" vid="NUM 34:19">ይሁዳ ኮቻፈ ዮፎና ናኣ ካለባ፤<verse eid="NUM 34:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 34:20"/>ስሞና ኮቻፈ አምሁዳ ናኣ ሳላምኤላ፤<verse eid="NUM 34:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="NUM 34:21"/>ብንያመ ኮቻፈ ክስሎና ናኣ ኤልዳዳ፤<verse eid="NUM 34:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 34:22"/>ዳነ ኮቻፈ ዮግላ ናኣ ቡቃ፤<verse eid="NUM 34:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 34:23"/>ዮሰፋ ናኣ ምናሰ ኮቻፈ ሱፌዳ ናኣ ሀንኤላ፤<verse eid="NUM 34:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 34:24"/>ዮሰፋ ናኣ ኤፍሬማ ኮቻፈ ሽፍፃና ናኣ፤ ቃሙኤላ፤<verse eid="NUM 34:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 34:25"/>ዛብሎና ኮቻፈ ፋርናካ ናኣ ኤልሳፋና፤<verse eid="NUM 34:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 34:26"/>ይሳኮራ ኮቻፈ ሆዛ ናኣ ፓልፅኤላ፤<verse eid="NUM 34:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 34:27"/>አሴራ ኮቻፈ ሳሎማ ናኣ አሁዳ፤<verse eid="NUM 34:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 34:28"/>ንፍታለመ ኮቻፈ አምሁዳ ናኣ ፓዳህኤላ፤<verse eid="NUM 34:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 34:29"/>ካናነ ቢታ እስራኤለ አሳስ ላታ ኦድ ሻክድ እማና መላ ጎዳይ ኪትዳ አሳት ሀይሳታ” ያግስ።<verse eid="NUM 34:29"/></para>
  <chapter eid="NUM 34"/>
  <chapter number="35" style="c" sid="NUM 35"/>
  <para style="s1">ሌወታስ እመትዳ ካታማታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1"/>እያርኮፈ ሄፍንን፥ ዮርዳኖሰ ሻፋ ማታን ደእያ ሞአበ ደንባን፥ ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="NUM 35:1"/><verse number="2" style="v" sid="NUM 35:2"/>“እስራኤለት ባንታ ላታፐ ሌወት ዳና ካታማታነ ኤንታ ዩሹዋን ሄን ቢታ እማና መላ ኤንታዉ ኦዳ። <verse eid="NUM 35:2"/><verse number="3" style="v" sid="NUM 35:3"/>ሄ ካታማት ኤንታዉ ዱሳ በሲ ግዶ፤ ሄን ቢታት ኤንታ ሚዛስ፥ ኤንታ ዶርሳስነ ኤንታ ሀራ መሄታስ ግዶ። <verse eid="NUM 35:3"/><verse number="4" style="v" sid="NUM 35:4"/>ህንተ ኤንታዉ እምያ ሄን ቢታይ ኡባ ባጋራ ካታማ ግምበ ድርሳፈ እስ ሙኩሉ ዋ ግዶ። <verse eid="NUM 35:4"/><verse number="5" style="v" sid="NUM 35:5"/>ካታማ ግዶ ኦድ ዶሎሀ ባጋራ ናምኡ ሙኩሉ ዋ፥ ዱገሀ ባጋራ ናምኡ ሙኩሉ ዋ፥ ዉሎሀ ባጋራ ናምኡ ሙኩሉ ዋነ ፑደሀ ባጋራ ናምኡ ሙኩሉ ዋ ዋተ። ሌወት ሄ ሄራ ባንታ ካታማስ ሄን ቢታ ኦ።<verse eid="NUM 35:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6"/>“ሌወታስ ህንተ እምዳ ካታማት፥ አሰ ዎዳ ኡራይ ባቃትድ አትያ ኡሱፑን ካታማታ፤ ሄሳታ ቦላ ጉጅድካ፥ ኦይታማነ ናምኡ ሀራ ካታማታ ኤንታዉ እምተ። <verse eid="NUM 35:6"/><verse number="7" style="v" sid="NUM 35:7"/>ኦይታማነ ሆስፑን ካታማታ ኤንታ ሄን ቢታራ እስፈ ሌወታስ እምተ። <verse eid="NUM 35:7"/><verse number="8" style="v" sid="NUM 35:8"/>እስራኤለ አሳ ላታፐ ኤንታ ላታ መላ ዳሮ ኮቻፈ ዳሮ ካታማ፥ ጉ ኮቻፈ ጉ ካታማ ኤክድ ሌወታስ እምተ” ያግስ።<verse eid="NUM 35:8"/></para>
  <para style="s1">ባቃትድ አትያ ካታማታ</para>
  <para style="r">(<ref loc="DEU 19:1-13">ዛረ 19:1-13</ref>፤ <ref loc="JOS 20:1-9">እያ 20:1-9</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9"/>ጎዳይ ሙሰኮ፥ <verse eid="NUM 35:9"/><verse number="10" style="v" sid="NUM 35:10"/>“እስራኤለ አሳኮ ሀይሳዳ ያጋ፤ ዮርዳኖሰ ሻፋ ፕንድ፥ ካናነ ቢታ ህንተ ገልያ ዎደ፥ <verse eid="NUM 35:10"/><verse number="11" style="v" sid="NUM 35:11"/>እስ አስ ቆፖና አሰ ዎዳባ ግድኮ ሄ ኡራይ ባቃትድ አታና መላ ካታማታ ህንተዉ ዶርተ። <verse eid="NUM 35:11"/><verse number="12" style="v" sid="NUM 35:12"/>ያን ሱ ዛራናዉ ኮያ ሀይቅዳ ኡራ ዳቦታፐ እ አቴስ። ሸምፖ ዎዳ ደርያ ስንን ፕርዳስ ሺቆና ሀይቃናዉ በሰና። <verse eid="NUM 35:12"/><verse number="13" style="v" sid="NUM 35:13"/>ሀ ህንተ እምያ ኡሱፑን ካታማት ህንተ ባቃትድ አትያ ካታማ ግዶ። <verse eid="NUM 35:13"/><verse number="14" style="v" sid="NUM 35:14"/>ሄ ካታማት ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋን ግዶ፤ ቃስ አትዳ ሄት ካናነ ቢታን ግዶ። <verse eid="NUM 35:14"/><verse number="15" style="v" sid="NUM 35:15"/>ሀ ኡሱፑን ካታማት ኤሮና አሰ ዎዳ እስራኤለ አሳይ፥ በታንቾትነ ጉ ዎደስ ህንተ ግዶን ደእያ አሳት ባቃትድ አትያ በሲ ግዶ።<verse eid="NUM 35:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16"/>“እስ አስ ሀራ አስ ብራታ ሚሸን ሾጭድ ዎኮ ሄ ኡራይ ሸምፖ ዎስ፤ እ ሀይቆ። <verse eid="NUM 35:16"/><verse number="17" style="v" sid="NUM 35:17"/>እስ አስ ዎናዉ ዳንዳእያ ሹቻን ሀራ አስ ጫድድ ዎኮ ሄ ኡራይ ሸምፖ ዎስ፤ እ ሀይቆ። <verse eid="NUM 35:17"/><verse number="18" style="v" sid="NUM 35:18"/>እስ አስ ዎናዉ ዳንዳእያ ም ሚሸን ሀራ አስ ሾጭድ ዎኮ ሄ ኡራይ ሸምፖ ዎስ፤ እ ሀይቆ። <verse eid="NUM 35:18"/><verse number="19" style="v" sid="NUM 35:19"/>ሱ ዛርያ ማታ ዳቦይ ሄ ሸምፖ ዎዳይሳ ደምኮ ዎ።<verse eid="NUM 35:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 35:20"/>“እስ አስ ሀራ አስ ባ ዎዛናን ሞርክድ ሱግ የግኮ ዎይኮ ሀይቆ ግድ እያ ቦላ እስባ ሆልን ሄ ኡራይ ሀይቅኮ፥ <verse eid="NUM 35:20"/><verse number="21" style="v" sid="NUM 35:21"/>ዎይኮ ሞርክድ ባ ኩሸ ጩጩምድ ደችን ሄ ኡራይ ሀይቅኮ፥ እ ሸምፖ ዎስ፤ እ ሀይቆ። ሱ ዛርያ ማታ ዳቦይ ሸምፖ ዎዳይሳ ደምኮ ዎ።<verse eid="NUM 35:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22"/>“ሽን ሞርከተ ባይናን፥ እስ አስ ሀራ አስ አኬኮና ሱግድ ዎይኮ ቆፖና እያ ቦላ እስባ ሆልኮ፥ <verse eid="NUM 35:22"/><verse number="23" style="v" sid="NUM 35:23"/>ዎይኮ ዎናዉ ዳንዳእያ ሹቹ እ በኦና እያ ቦላ ሆልን፥ ሄ ኡራይ ሀይቅኮ፥ ሄሳን ሞርከተ ባይና ግሾነ እያ ቆሀናዉ ቆፕድ ደንዶና ግሾ፥ <verse eid="NUM 35:23"/><verse number="24" style="v" sid="NUM 35:24"/>ዱላታይ እያ ግዶንነ እያ ሱ ዛራናዉ ኮያ ኡራ ግዶን ፕርድያ ዎጋይ ካልድ ደእያ ዎጋ ግዶ። <verse eid="NUM 35:24"/><verse number="25" style="v" sid="NUM 35:25"/>ኤሮና ዎዳይሳ ሱ ዛራናዉ ኮየይሳ ኩሸፐ ሄ ኡራ ዱላታይ አሽድ፥ እ ባቃትድ አትያ ካታማ ዛሮ። ሄ ዎደ ደእያ ዛይተን ትየትዳ ካህነ ሀላቃይ ሀይቃና ጋካናዉ እ ያን ደኦ።<verse eid="NUM 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26"/>“ሽን ኤሮና ዎዳይስ ባቃትድ አትያ ካታማ ዛዋፐ በትኮ፥ <verse eid="NUM 35:26"/><verse number="27" style="v" sid="NUM 35:27"/>ሀይቅዳ ኡራ ዳቦይ እያ ደምድ ዎኮ፥ ሸምፖ ዎን ኦይሸተና። <verse eid="NUM 35:27"/><verse number="28" style="v" sid="NUM 35:28"/>ሄ ዎደ ደእያ ካህነ ሀላቃይ ሀይቃና ጋካናዉ ሄ ኤሮና ዎዳ ኡራይ ባቃትድ አትያ ካታማን ኡቶ። ሽን ሄ ካህነ ሀላቃይ ሀይቅዳፐ ጉየ ኤሮና ዎዳ ኡራይ ባ ሶ ስማናዉ ዳንዳኤስ።<verse eid="NUM 35:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29"/>“ሀ ዎጋይነ ህገይ ህንተ ደእያ ቢታን ህንተዉነ ህንተ ዘረስ ኤቅድ ደእያ ዎጋ ግዶ።<verse eid="NUM 35:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30"/>“አሰ ዎዳ ኦንካ እ ሸምፖ ዎዳይሳ ናምኡ ዎይኮ ሄ ማርክ ማርካትኮ ሀይቆ፥ ሽን እስ አሳ ማርካተን ኦንካ ሀይቃናዉ በሰና። <verse eid="NUM 35:30"/><verse number="31" style="v" sid="NUM 35:31"/>ቃስ ሸምፖ ዎዳ አሳፐ አጫ ኤኮፍተ፤ እ ሀይቃናዉ በሴስ። <verse eid="NUM 35:31"/><verse number="32" style="v" sid="NUM 35:32"/>ባቃትድ አትያ ካታማ በትዳ ኦደፈካ ካህነ ሀላቃይ ሀይቃናፐ ስን ባ ሶ ስማና መላ አጫ እያፐ ኤኮፍተ። <verse eid="NUM 35:32"/><verse number="33" style="v" sid="NUM 35:33"/>ሱ ቢታ ቱንስያ ግሾ ሱ ጉሶፍተ። ሱ ጉስዳ ኡራ ሱፈ አትሽን፥ ሱ ጉክዳ ቢታ ሀራ ኦገራ ቱናተፈ ጌሽያ ዎግ ባዋ። <verse eid="NUM 35:33"/><verse number="34" style="v" sid="NUM 35:34"/>ታኒ፥ ጎዳይ እስራኤለ አሳ ግዶን ደእያ ግሾ፥ ህንተ ደእያ ቢታ፥ ታኒ አቅያ ቢታ ቱንሶፕተ” ያግስ።<verse eid="NUM 35:34"/></para>
  <chapter eid="NUM 35"/>
  <chapter number="36" style="c" sid="NUM 36"/>
  <para style="s1">ሰሎጳዳ ማጫ ናይታ ላታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1"/>ዮሰፋ ኮቻፈ፥ ምናሰ ናኣ ማክራ ናኣ ጋላዳ ኮቻ ሀላቃት ሙሰኮነ እስራኤለ ሀላቃታኮ ይድ <verse eid="NUM 36:1"/><verse number="2" style="v" sid="NUM 36:2"/>“ኑ ጎዳዉ፥ እስራኤለ አሳስ ላታ ቢታ ሳማን ሻካዳ እማና መላ ጎዳይ ነና ኪትስ፤ ቃስ ኑ እሻ ሰሎጳዳ ላታ እያ ማጫ ናይታስ እማና መላ ነና ኪትስ። <verse eid="NUM 36:2"/><verse number="3" style="v" sid="NUM 36:3"/>ኤንቲ ሀራ ኮቸ ግድዳ እስራኤለ አስ ገልኮ ኤንታ ላታይ ኑ አዋታ ላታፐ ኤከትድ ኤንታ ኤክያ ዘረስ ጉዠቴስ። ሄሳ ግሾ፥ ኑስ ሳማን እመትዳ ላታይ ጉፄስ። <verse eid="NUM 36:3"/><verse number="4" style="v" sid="NUM 36:4"/>እስራኤለ አሳስ እሻታማን ላይ ቦንችያ ባለይ ጋክያ ዎደ ኤንታ ላታይ ኤንታ ኤክዳ አሳ ኮቻስ ጉዠቴስ፤ ሄሳ ግድኮ ኤንታ ላታይ ኑ አዋታ ኮቻ ላታፐ ኤከታና” ያግዶሶና።<verse eid="NUM 36:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5"/>ሄሳ ግሾ፥ ሙሰይ ጎዳፐ ኤክዳ ኪታ እስራኤለ አሳስ ሀይሳዳ ያግድ ኦድስ፤ “ዮሰፋ ኮቻይ ግዳይስ ልከ። <verse eid="NUM 36:5"/><verse number="6" style="v" sid="NUM 36:6"/>ጎዳይ ሰሎጳዳ ማጫ ናይታባ ኪትዳይስ ሀይሳ፤ ኤንቲ ባንታዉ ዶስዳ አዝና ገላናዉ ዳንዳኦሶና፥ ሽን ኤንታ ኮቻፈ ግዳናዉ ኮሼስ። <verse eid="NUM 36:6"/><verse number="7" style="v" sid="NUM 36:7"/>እስራኤለ አሳ ላታይ እስ ኮቻፈ ሀራ ኮቻስ አፎ፤ እስራኤለ አሳይ ባንታ ኮቻ ላታ ቢታ ምንድ ናጎ። <verse eid="NUM 36:7"/><verse number="8" style="v" sid="NUM 36:8"/>እስራኤለ አሳ ግዶን ላታ ቢታ ኤክዳ ማጫስ ኦንካ ባ አዋ ኮቸ ግድዳ አዝና ገላናዉ ኮሼስ። ሄሳዳ ኦኮ ኤንታ ኮቻ ላታይ ኤንታ ኩሸን ጋምኤስ። <verse eid="NUM 36:8"/><verse number="9" style="v" sid="NUM 36:9"/>ያትኮ፥ ላታይ እስ ኮቻፈ ሀራ ኮቻኮ አና። እስ እስ ኮቻይ ባ ላታ ቢታ ኦይክዳ መላ ዳና” ያግስ።<verse eid="NUM 36:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10"/>ያትን፥ ሰሎጳዳ ማጫ ናይት ጎዳይ ሙሰ ኪትዳይሳዳ ኦዶሶና። <verse eid="NUM 36:10"/><verse number="11" style="v" sid="NUM 36:11"/>ሰሎጳዳ ማጫ ናይት፥ ማህሎ፥ ትርፆ፥ ሆግሎ፥ ምልኮነ ኖኦ ጌተተይሳት ባንታ አዋ እሻታ ናይታ ገልዶሶና። <verse eid="NUM 36:11"/><verse number="12" style="v" sid="NUM 36:12"/>ኤንቲ ዮሰፋ ናኣ ምናሰ ናይታ ኮቻፈ አዝና ገልዶሶና፤ ኤንታ ላታይ ኤንታ አዋ ኮቻስ ግድስ። <verse eid="NUM 36:12"/><verse number="13" style="v" sid="NUM 36:13"/>እያርኮፈ ሄፍንን፥ ዮርዳኖሰ ሻፋ ማታን፥ ደእያ ሞአበ ደንባን ሙሰ ባጋራ፥ ጎዳይ እስራኤለ አሳስ ኪትዳ ህገትነ ዎጋት ሀይሳታ።<verse eid="NUM 36:13"/></para>
  <chapter eid="NUM 36"/>
</usx>
