<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZR" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">እዝራ ማፃፋ</para>
  <para style="toc1">እዝራ ማፃፋ</para>
  <para style="toc3">እዝ</para>
  <para style="toc2">እዝራ</para>
  <para style="mt">እዝራ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">እዝራ ማፃፋይ፥ አይሁደታፐ ድኤትድ ብዳ ጉ አሳት ባብሎነፐ ስምዳይሳነ የሩሳላመን ደኦይነ ጎይኖ ዎጋይ ኦራፅዳይሳ ኦዴስ። ሀ ሀኖታት ካልድ ደእያ ከሶታን ቆንጭዶሶና።</para>
  <para style="ipi">1. ፋርሰ ካዋ ቅሮሳ ሸነን ኮይሮ አይሁደት ድኦፐ ስምዶሶና።</para>
  <para style="ipi">2. ፆሳ ኬይ ዛር ኬፀትድ አንጀትስ፤ ፆሳ ጎይኖ ዎጋይ ዛሪድ ዶመትስ።</para>
  <para style="ipi">3. ዳሮ ላይፈ ጉየ፥ ፆሳ ህገ አስታማረ ግድዳ እዝር ካለን፥ ሀራ አይሁደት የሩሳላመ ስምዶሶና። እዝር፥ እስራኤለ አሳይ አማኖ ደኡዋነ እስፈተ ዱሳ ዛራና መላ ማድድ፥ ኤንታ አያና ደኡዋነ ሳአ ዱሳ ዛሪድ ምንስ።</para>
  <para style="ip">እዝራ ማፃፋይ ናምኡ ክፍለን ሻከቴስ።</para>
  <para style="ipi">1. ሸምፖ 1—6 ጋካናዉ ደእያ ክፍለይ፥ ይሁዳ አሳይ ክ.የ.ስ.538 ላይን የሩሳላመ ስምዳይሳነ ጎይኖ ዎጋ ኤስዳይሳ ኦዴስ።</para>
  <para style="ipi">2. ሸምፖ 7—10 ጋካናዉ ደእያ ክፍለይ፥ ዳሮ ላይፈ ጉየ እዝር አሳ ታማርሳናዉ የሩሳላመ ይዳይሳ ኦዴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">አይሁደ አሳ ድኦፐ ስሙዋ (<char style="ior"><ref loc="EZR 1:1-2:70">1:1—2:70</ref></char>)</para>
  <para style="io1">ፆሳ ኬይ ዛሪድ ኬፆ ዶመተ (<char style="ior"><ref loc="EZR 3:1-4:6">3:1—4:6</ref></char>)</para>
  <para style="io1">የሩሳላመ ዛር ኬፆ ቦላ መትዳ መቱዋ (<char style="ior"><ref loc="EZR 4:6-23">4:6-23</ref></char>)</para>
  <para style="io1">ፆሳ ኬ ኦሱዋ ዉርሰ (<char style="ior"><ref loc="EZR 4:24-6:22">4:24—6:22</ref></char>)</para>
  <para style="io1">እዝር አሳ ካለድ የሩሳላመ ኤሁዋ (<char style="ior"><ref loc="EZR 7:1-8:36">7:1—8:36</ref></char>)</para>
  <para style="io1">አላጋ ማጫሳታ ኤክዳ አደት ባንታ ማቸታ የዱዋ (<char style="ior"><ref loc="EZR 9:1-10:44">9:1—10:44</ref></char>)</para>
  <chapter number="1" style="c" sid="EZR 1"/>
  <para style="s1">ቅሮሳ አዋጁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1"/>ፋርሰ ካዎይ ቅሮስ ካዎትዳ ኮይሮ ላይን፥ ናብያ ኤርምያሳ ባጋራ ጎዳይ ኦድዳባ ፖልስ። ፋርሰ ካዎይ ቅሮስ ባ ካዎተ ግዶን ሀይሳዳ ያግድ አዋጃና መላነ ሄ አዋጁዋ ፃፍድ ዎና መላ ጎዳይ እያ ዎዛና ደንስ። <verse eid="EZR 1:1"/><verse number="2" style="v" sid="EZR 1:2"/>ፋርሰ ካዎይ ቅሮስ ሀይሳዳ ያጌስ፤ “ጎዳይ፥ ሳሎ ፆሳይ ሀ ሳኣ ካዎተታ ኡባ ታዉ እሚስ። ቃስ ይሁዳን ደእያ የሩሳላመን እያዉ ኬ ኬፃና መላ ታና ሹምስ። <verse eid="EZR 1:2"/><verse number="3" style="v" sid="EZR 1:3"/>ፆሳ አስ ግድዳ ኦንካ ያ ቦ፤ እያ ፆሳይ እያራ ግዶ! ህንተ ይሁዳን ደእያ የሩሳላመ ብድ፥ ያን የሩሳላመን ጎዳ፥ እስራኤለ ፆሳ ኬ ዛሪድ ኬፆ። <verse eid="EZR 1:3"/><verse number="4" style="v" sid="EZR 1:4"/>ዱማ ዱማ ቢታን ደእያ አሳ ኡባይ አይሁደታፐ አትዳይሳት ብራ፥ ዎርቃ፥ ዱማ ዱማ ሚሸታነ መሄ እምድ ማዶ፤ ቃስ የሩሳላመን ደእያ ፆሳ ኬ ባንታ ዶሳን እምያ እሞታ ቦላ ጉጅድ እሞ” ያጌስ።<verse eid="EZR 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5"/>ሄሳፈ ጉየ፥ ይሁዳነ ብንያመ ኮቸ ሀላቃት፥ ካህነትነ ሌወት፥ ቃስ ፆሳይ ኤንታ ዎዛና ደንዳ ኡባይ የሩሳላመን ጎዳ ፆሳ ኬ ኬፃናዉ ባናዉ ደንድዶሶና። <verse eid="EZR 1:5"/><verse number="6" style="v" sid="EZR 1:6"/>ቃስ ኤንታ ሾሮን ደኤይሳትካ ባንታ ዶሳን እምዳባ ቦላ ጉጅድ፥ ብራፐነ ዎርቃፈ ኦሰትዳ ሚሸታ፥ ሀራ ዱማ ዱማ ሚሸታነ መሄ እምድ፥ ኤንታ ማድዶሶና። <verse eid="EZR 1:6"/><verse number="7" style="v" sid="EZR 1:7"/>ሄሳ ቦላ ካዎይ ቅሮስ ናቡካዳናፆር የሩሳላመፐ ኤፍድ ባ ኤቃ ኬን ዎዳ ጎዳ ኬ ሚሸታ እሚስ። <verse eid="EZR 1:7"/><verse number="8" style="v" sid="EZR 1:8"/>ፋርሰ ካዎይ ቅሮስ ሚሸታ ዎያ ኬ ሀላቃ ምትርዳፁ ታይብስድ፥ ይሁዳ ሃርያ ሰሳብሳራ ኩሸን ዎስ። <verse eid="EZR 1:8"/><verse number="9" style="v" sid="EZR 1:9"/>ስምዳ ሚሸታ ታይቦይ ሀይሳ፤ ሀስታሙ ዎርቃ ሻተ፥ ሙኩሉ ብራ ሻተ፥ ላታማነ ኡዱፉን ፕልኦ፥ <verse eid="EZR 1:9"/><verse number="10" style="v" sid="EZR 1:10"/>ሀስታሙ ዎርቃ ከረ፥ ኦይዱ ፄታነ ታሙ ብራ ከረ ሙኩሉ ሀራ ዱማ ዱማ ሚሸ። <verse eid="EZR 1:10"/><verse number="11" style="v" sid="EZR 1:11"/>ዎርቃ ሚሸታነ ብራ ሚሸታ ታይቦይ ኩመ እቻሹ ሙኩሉነ ኦይዱ ፄታ፤ ሴሳብሳር ባብሎነፐ የሩሳላመ ስምያ ዎደ ድኦፐ ስምዳ አሳራ ኤክድ ይስ።<verse eid="EZR 1:11"/></para>
  <chapter eid="EZR 1"/>
  <chapter number="2" style="c" sid="EZR 2"/>
  <para style="s1">ድኦፐ ስምዳ አሳ ታይቦ</para>
  <para style="r">(<ref loc="NEH 7:4-73">ናህ 7:4-73</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 2:1"/>ባብሎነ ካዎይ ናቡካዳናፆር ድእድ፥ ባ ቢታ ኤፍዳ አሳፐ ጉየ፥ የሩሳላመነ ይሁዳ ባንታ ካታማ ካታማ ስምዳ አሳይ ሀይሳፈ ካልድ ፃፈትዳይሳታ። <verse eid="EZR 2:1"/><verse number="2" style="v" sid="EZR 2:2"/>ኤንታ ሀላቃት ዛሩባበላ፥ እያሱ፥ ናህመ፥ ሳራያ፥ ራእላ፥ ማርድክዮሳ፥ ብልሳና፥ ማሰፋራ፥ ባጉዋያ፥ ረሁማነ ባአና።</para>
  <para style="p" vid="EZR 2:2">ድኦፐ ስምዳ አሳ ታይቦይ ሀይሳ።<verse eid="EZR 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 2:3"/>ፋሮሳ ያራይ 2,172፤<verse eid="EZR 2:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 2:4"/>ሳፋፃ ያራይ 372፤<verse eid="EZR 2:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 2:5"/>ኤራ ያራይ 775፤<verse eid="EZR 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 2:6"/>እያሱነ ዮኣባ ኮቸ ግድዳ ፋሀት-ሞአበ ያራይ 2,812፤<verse eid="EZR 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 2:7"/>ኤላማ ያራይ 1,254፤<verse eid="EZR 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 2:8"/>ዛታ ያራይ 945፤<verse eid="EZR 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 2:9"/>ዛካያ ያራይ 760፤<verse eid="EZR 2:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 2:10"/>ባና ያራይ 642፤<verse eid="EZR 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 2:11"/>በባያ ያራይ 623፤<verse eid="EZR 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 2:12"/>አዝጋዳ ያራይ 1,222፤<verse eid="EZR 2:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 2:13"/>አዶንቃማ ያራይ 666፤<verse eid="EZR 2:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 2:14"/>በጉዋያ ያራይ 2,056፤<verse eid="EZR 2:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="EZR 2:15"/>አድና ያራይ 454፤<verse eid="EZR 2:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="EZR 2:16"/>ህዝቅያሳ ኮቸ ግድዳ አፄራ ያራይ 98፤<verse eid="EZR 2:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="EZR 2:17"/>ባሳያ ያራይ 323፤<verse eid="EZR 2:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="EZR 2:18"/>ዮራ ያራይ 112፤<verse eid="EZR 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="EZR 2:19"/>ሀሱማ ያራይ 223፤<verse eid="EZR 2:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 2:20"/>ግባራ ያራይ 95፤<verse eid="EZR 2:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EZR 2:21"/>ቤተለመ አሳይ 123፤<verse eid="EZR 2:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 2:22"/>ናፆፋ አሳይ 56፤<verse eid="EZR 2:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="EZR 2:23"/>አናቶታ አሳይ 128፤<verse eid="EZR 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 2:24"/>አዝሞታ አሳይ 42፤<verse eid="EZR 2:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="EZR 2:25"/>ቅርያት-ይኣርማ፥ ካፍራነ ብኤሮታ አሳይ 743፤<verse eid="EZR 2:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 2:26"/>ራማነ ግብአ አሳይ 621፤<verse eid="EZR 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 2:27"/>ምክማሳ አሳይ 122፤<verse eid="EZR 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 2:28"/>ቤተለነ ጋየ አሳይ 223፤<verse eid="EZR 2:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 2:29"/>ናቦ አሳይ 52፤<verse eid="EZR 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 2:30"/>ማግብሳ አሳይ 156፤<verse eid="EZR 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 2:31"/>ናምአን ኤላማ አሳይ 1,254፤<verse eid="EZR 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="EZR 2:32"/>ካርማ አሳይ 320፤<verse eid="EZR 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 2:33"/>ሎዳ፥ ሀድዳነ ኦኖ አሳይ 725፤<verse eid="EZR 2:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 2:34"/>እያርኮ አሳይ 345፤<verse eid="EZR 2:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="EZR 2:35"/>ሳናአ አሳይ 3,630፤<verse eid="EZR 2:35"/></para>
  <para style="m">
    <verse number="36" style="v" sid="EZR 2:36"/>ድኦፐ ስምዳ ካህነታ ሶ አሳ ታይቦይ ሀይሳ።</para>
  <para style="li1" vid="EZR 2:36">እያሱ ኮቸ ግድዳ ያዳያ ያራይ 973፤<verse eid="EZR 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="EZR 2:37"/>እመራ ያራይ 1,052፤<verse eid="EZR 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 2:38"/>ፓስኮራ ያራይ 1,247፤<verse eid="EZR 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="EZR 2:39"/>ካርማ ያራይ 1,017.<verse eid="EZR 2:39"/></para>
  <para style="m">
    <verse number="40" style="v" sid="EZR 2:40"/>ድኦፐ ስምዳ ሌወታ ታይቦይ ሀይሳ፤</para>
  <para style="li1" vid="EZR 2:40">ሆዳዋ ኮቸ ግድዳ እያሱነ ቃድሜላ ያራይ 74፤<verse eid="EZR 2:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="EZR 2:41"/>አሳፋ ኮቸ ግድዳ ዛማረት 128፤<verse eid="EZR 2:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="EZR 2:42"/>ፆሳ ኬ ፐንገ ናግያ ሳሎማ፥ አፄራ፥ ፃልሞና፥ አቁባ፥ ሀፅፃነ ሶባያ ያራይ 139.<verse eid="EZR 2:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="EZR 2:43"/>ሀይሳቲ ድኦፐ ስሚድ፥ ፆሳ ኬን ኦያ አሳ ያራታ፤ ፅሀ ያራ፥ ሀሱፋ ያራ፥ ፃባኦታ ያራ፥ <verse eid="EZR 2:43"/><verse number="44" style="v" sid="EZR 2:44"/>ከራሳ ያራ፥ ስሀ ያራ፥ ፋዶና ያራ፥ <verse eid="EZR 2:44"/><verse number="45" style="v" sid="EZR 2:45"/>ልባና ያራ፥ አጋባ ያራ፥ አቁባ ያራ፥ <verse eid="EZR 2:45"/><verse number="46" style="v" sid="EZR 2:46"/>አጋባ ያራ፥ ሳምላ ያራ፥ ሀናና ያራ፥ <verse eid="EZR 2:46"/><verse number="47" style="v" sid="EZR 2:47"/>ጋዳላ ያራ፥ ጋሃራ ያራ፥ ራያ ያራ፥ <verse eid="EZR 2:47"/><verse number="48" style="v" sid="EZR 2:48"/>ራአሶና ያራ፥ ናቆዳ ያራ፥ ጋሳማ ያራ፥ <verse eid="EZR 2:48"/><verse number="49" style="v" sid="EZR 2:49"/>ኦዛ ያራ፥ ፋሴሀ ያራ፥ በሳያ ያራ፥ <verse eid="EZR 2:49"/><verse number="50" style="v" sid="EZR 2:50"/>አስና ያራ፥ መኡንማ ያራ፥ ንፉሴስማ ያራ፥ <verse eid="EZR 2:50"/><verse number="51" style="v" sid="EZR 2:51"/>ባቅቡቃ ያራ፥ ሀቁፋ ያራ፥ ሀርሁራ ያራ፥ <verse eid="EZR 2:51"/><verse number="52" style="v" sid="EZR 2:52"/>ባስሉታ ያራ፥ ማህዳ ያራ፥ ሀርሳ ያራ፥ <verse eid="EZR 2:52"/><verse number="53" style="v" sid="EZR 2:53"/>ባርቆሳ ያራ፥ ስሳራ ያራ፥ ቴማ ያራ፥ <verse eid="EZR 2:53"/><verse number="54" style="v" sid="EZR 2:54"/>ናስያ ያራነ ሀፅፋ ያራ።<verse eid="EZR 2:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="EZR 2:55"/>ሀይሳቲ ድኦፐ ስምዳ ሶሎሞነ ኦሳንቾታ ያራታ፤ ሶፃያ ያራ፥ ሶፌረታ ያራ፥ ፋሩዳ ያራ፥ <verse eid="EZR 2:55"/><verse number="56" style="v" sid="EZR 2:56"/>ያእላ ያራ፥ ዳርቆና ያራ፥ ጋዳላ ያራ፥ <verse eid="EZR 2:56"/><verse number="57" style="v" sid="EZR 2:57"/>ሳፋፃ ያራ፥ ሀፄላ ያራ፥ ፋክራታ ያራ፥ ሀፃቦይማ ያራነ አማ ያራ። <verse eid="EZR 2:57"/><verse number="58" style="v" sid="EZR 2:58"/>ድኦፐ ስሚድ፥ ፆሳ ኬን ኦያ አሳ ያራትነ ሶሎሞነ አይለታ ያራታ ታይቦይ 392.<verse eid="EZR 2:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="EZR 2:59"/>ሀይሳፈ ካለይሳት ቃስ ታልመላ፥ ተላረሳ፥ ካሩባ፥ አዳናነ እመራ ካታማታፐ የሩሳላመ ስምዶሶና። ሽን ኤንቲ ዎይኮ ኤንታ አዋት እስራኤለ ሼሽ ግደይሳ ኤርሳናዉ ኤንቲ ዳንዳእቦኮና። <verse eid="EZR 2:59"/><verse number="60" style="v" sid="EZR 2:60"/>ዳላያ፥ ፆቢያነ ናቆዳ ያራት 652.<verse eid="EZR 2:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="EZR 2:61"/>ካህነታፐ አባያ ያራይ፥ አቆሳ ያራይነ ባርዝለ ያራይ ስምዶሶና። ባርዝለይ ሀ ሱንን ፄገታናዉ ዳንዳእዳይ ጋላዳ ቢታ አስ ግድዳ ባርዝለ ናእዉ ማቾ ኤክዳ ግሾሳ። <verse eid="EZR 2:61"/><verse number="62" style="v" sid="EZR 2:62"/>ሀይሳቲ ባንታ የለታ ፃጱዋ ኤራናዉ የለታ ማፃፋን ኮይዶሶና፥ ሽን ደምቦኮና። ሄሳ ግሾ፥ ኤንቲ ቱና ጌተትድ ካህነተን ኦና መላ ድገትዶሶና። <verse eid="EZR 2:62"/><verse number="63" style="v" sid="EZR 2:63"/>ኡሪመንነ ቱሚመን ሻክድ ፕርድያ ካህነይ ደንዳና ጋካናዉ፥ ኤንቲ ጌሻ ካፈ ማናዉ ዳንዳኦናይሳ አይሁደታ አይሰይስ ኤንታዉ ኦድስ።<verse eid="EZR 2:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="EZR 2:64"/>ድኦፐ ይሁዳ ስምዳ አሳ ታይቦይ ኩመ 42,360. <verse eid="EZR 2:64"/><verse number="65" style="v" sid="EZR 2:65"/>ሄስካ 7,337 አደነ ማጫ አይለታ ጉጁና ደእሽና። ኤንታ ግዶን 200 አደነ ማጫ ዛማረት ደኦሶና። <verse eid="EZR 2:65"/><verse number="66" style="v" sid="EZR 2:66"/>ድኦፐ ስምዳ አሳ ፓራት 736፤ ባቁሎት 245፤ <verse eid="EZR 2:66"/><verse number="67" style="v" sid="EZR 2:67"/>ግማለት 435፤ ሀረት 6,720.<verse eid="EZR 2:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68"/>ኤንቲ የሩሳላመን ደእያ ፆሳ ኬ ጋክዳ ዎደ እስ እስ ሶ አሳ ሀላቃት ፆሳ ኬይ ካሰ ባ በሳን ኬፀታና መላ ባንታ ዶሳን እሞታ እምዶሶና። <verse eid="EZR 2:68"/><verse number="69" style="v" sid="EZR 2:69"/>እሶይ እሶይ ባዉ ዳንዳእዳ መላ ፆሳ ኬ ኦሱዋስ እሞታ እሚስ፤ እሞታይ 500 ክሎ ግራመ ዎርቃ፥ 2,800 ክሎ ግራመ ብራነ 100 ካህነታ ማኦ እምዶሶና።<verse eid="EZR 2:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70"/>ሄሳፈ ጉየ፥ ካህነት፥ ሌወትነ ጉ አሳይ የሩሳላመን ኡትዶሶና፤ ዛማረት፥ ፆሳ ኬ ፐንገ ናገይሳትነ ፆሳ ኬን ኦያ ኦሳንቾት የሩሳላመ ዩሾን ደእያ ካታማታን ኡትዶሶና፤ አትዳ አሳ ኡባይ ባንታ ካታማታን ካታማታን ኡትዶሶና።<verse eid="EZR 2:70"/></para>
  <chapter eid="EZR 2"/>
  <chapter number="3" style="c" sid="EZR 3"/>
  <para style="s1">ያርሾ በሳይ ዛሪድ ኬፀትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1"/>ላፑን አጌናን እስራኤለ አሳይ ባንታ ደእያ ካታማታፐ እስ አስ ግድድ የሩሳላመ ሺቅዶሶና። <verse eid="EZR 3:1"/><verse number="2" style="v" sid="EZR 3:2"/>እዮሳደቃ ናኣ እያሱነ፥ እያራ ኦያ ካህነት፥ ሳላትያላ ናኣ ዛሩባበልነ እያ ዳቦት ፆሳ አስ ግድዳ ሙሰ ህግያን ፃፈትዳይሳዳ ፁሳ ያርሾ ያርሻናዉ፥ እስራኤለ ፆሳስ ያርሾ በሲ ጊግስዶሶና። <verse eid="EZR 3:2"/><verse number="3" style="v" sid="EZR 3:3"/>ሄ ቢታን ደእያ አሳ እፁዋፐ ደንዶይሳን ያይኮካ፥ ያርሾ በሲ ካሰ በሳን ኬፅድ፥ ፁሳ ያርሾ ጎዳስ ኡባ ዎደ ዎንታነ ኦማርስ ሺሽዶሶና። <verse eid="EZR 3:3"/><verse number="4" style="v" sid="EZR 3:4"/>ካሰ ፃፈትዳይሳዳ ሻቃራ ባኣለ ቦንችዶሶና፤ ፁሳ ያርሾ እስ እስ ጋላስ ኮሸይሳዳ ፓጭሶና ያርሽዶሶና። <verse eid="EZR 3:4"/><verse number="5" style="v" sid="EZR 3:5"/>ቃስ ኡባ ዎደ ሺቅያ ፁሳ ያርሾ፥ አጌና ፄሮ ያርሾነ ጎዳ ጌሻ ባለታን ያርሽያ ያርሾ ኡባ ያርሽዶሶና። ሄሳ ቦላካ አሳይ ባ ዶሳን ጎዳስ እምዳ እሞታ ኡባ ያርሽዶሶና። <verse eid="EZR 3:5"/><verse number="6" style="v" sid="EZR 3:6"/>ፆሳ ኬ ባሶይ ቡሮ ዶመቶናባ ግድኮካ ላፑን አጌናን ኮይሮ ጋላስ ኤንቲ ጎዳስ ፁሳ ያርሾ ሺሾ ዶምዶሶና።<verse eid="EZR 3:6"/></para>
  <para style="s1">ፆሳ ኬይ ዛሪድ ኬፀትስ</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7"/>ሄሳፈ ጉየ፥ ሹቹ ማሰይሳታስነ አናፀታስ ሚሸ እምድ ኦሶ ኦይክዶሶና። ፋርሰ ካዎይ ቅሮስ ኤንታዉ ኪትዳ ግሾ፥ ልባኖሳፐ ዝጋ አባ ፕንድ፥ ዮጰ ኤሀናዉ ስዶናነ ፅሮሳ አሳስ ካ፥ ኡሽነ ዛይተ እምዶሶና።<verse eid="EZR 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 3:8"/>ኤንቲ የሩሳላመ ስምዳ ናምአን ላይን ናምአን አጌናን፥ ሳላትያላ ናአይ ዛሩባበል፥ እዮሳደቃ ናኣ እያሱይነ ኤንታ ዳቦት፥ ካህነት፥ ሌወትነ ድኦፐ ስምዳ አሳ ኡባይ ፆሳ ኬ ካሰ በሳን ኬፆ ዶምዶሶና። ቃስ ፆሳ ኬ ኦሱዋ አዋተን ፄላና መላ ላታሙ ላይ ግድዳይሳታነ ላታሙ ላይፈ አዳ ሌወታ ሹምዶሶና። <verse eid="EZR 3:8"/><verse number="9" style="v" sid="EZR 3:9"/>ሌወ ኮቸ ግድዳ እያሱ፥ እያ ናይታነ እያ ዳቦት፥ ሆዳዋ ሶ አስ ግድዳ ቃድምኤልነ እያ ናይት እስፈ ግድድ፥ ፆሳ ኦሱዋ ኦስሳና መላ አዋተ ኤክዶሶና፤ ኤንሀዳዳ ኮቸ ግድዳ ሌወት ኤንታ ማድዶሶና።<verse eid="EZR 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10"/>አናፀት ፆሳ ኬ ባሱዋ የገ ኦይክያ ዎደ፥ ካህነት ባንታ ማኦ ማእድ ሞይዘ ኦይክድ፥ አሳፋ ኮቸ ግድዳ፥ ሌወት ዳላ ኦይክድ፥ እስራኤለ ካዋ ዳዊታ ዎጋ መላ ጎዳ ጋላታናዉ ኤቅዶሶና። <verse eid="EZR 3:10"/><verse number="11" style="v" sid="EZR 3:11"/>ኤንቲ ጎዳ ጋላትሸነ እሶይ እሱዋ ካል ካል ማዝሙረን ሳቢሸ፥ ሀይሳዳ ያግድ ዛማርዶሶና።</para>
  <para style="q1" vid="EZR 3:11">“ጎዳይ ኬሀ፤</para>
  <para style="q2" vid="EZR 3:11">እስራኤለስ ደእያ እያ ሲቆይ መርናሳ” ያግዶሶና።</para>
  <para style="m" vid="EZR 3:11">ፆሳ ኬ ባሶይ የገትያ ግሾ፥ አሳ ኡባይ ባንታ ቃላ ቁ ኦድ እልልሸ ጎዳ ጋላትዶሶና። <verse eid="EZR 3:11"/><verse number="12" style="v" sid="EZR 3:12"/>ሽን ካሰ ፆሳ ኬ በእዳ ጭማ ካህነታፐ፥ ሌወታፐነ ኮቻታ ሀላቃታፐ ዳሮት ሀእ ፆሳ ኬ ኬፃናዉ የገትዳ ባሱዋ በእዳ ዎደ ባንታ ቃላ ቁ ኦድ ዬክዶሶና፤ ሀራት ቃስ ኡፋይትሸ ቦንችዶሶና። <verse eid="EZR 3:12"/><verse number="13" style="v" sid="EZR 3:13"/>ኦንካ ኡፋይሳ እልልሳነ ዬሆ ዋሱዋ ሻካናዉ ዳንዳእቤና፤ አሳይ ዋስያ ዋሶይ ዎልቃማ ግድያ ግሾ ዋሶይ ሃሆን ስኤቴስ።<verse eid="EZR 3:13"/></para>
  <chapter eid="EZR 3"/>
  <chapter number="4" style="c" sid="EZR 4"/>
  <para style="s1">ሞርከይ መዳ ኤቀተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1"/>ይሁዳስነ ብንያመስ ሞርከ ግድዳ አሳይ፥ ድኦፐ ስምዳይሳት ጎዳስ፥ እስራኤለ ፆሳስ ኬ ኬፀይሳ ስእዶሶና። <verse eid="EZR 4:1"/><verse number="2" style="v" sid="EZR 4:2"/>ዛሩባበላኮነ እስራኤለ ያራ ሀላቃታኮ ይድ፥ “አሶረ ካዎይ አስራዶን ኑና ሀ በሳ ኤህዳ ጋላሳፐ ዶምድ፥ ኑካ ህንተ ፆሳ ጎይኖስ፥ እያዉ ያርሾስ። ሄሳ ግሾ፥ ኑካ ህንተራ ኬፃና” ያግዶሶና።<verse eid="EZR 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3"/>ሽን ዛሩባበል፥ እያሱይነ እስራኤለ ያራ ሀላቃት፥ “ኑ ፆሳ ኬ ኬፃናዉ ኑስነ ህንተዉ ግሾይ ባዋ። ሽን ፋርሰ ካዎይ ቅሮስ ኪትዳይሳዳ ጎዳ፥ እስራኤለ ፆሳ ኬ ኑኒ ኑ ፃላላ ኬፃና” ያግዶሶና።<verse eid="EZR 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4"/>ሄሳፈ ጉየ፥ ሄ ቢታን ደእያ አሳይ፥ ይሁዳ አሳይ ፆሳ ኬ ኬፆና መላ ኡፋይስ ቃንፅሳናዉነ ያሽሳናዉ ደንድዶሶና። <verse eid="EZR 4:4"/><verse number="5" style="v" sid="EZR 4:5"/>ፋርሰ ካዋ ቅሮሳ ላይፈ ብድ ዳርዮሳ ካዎተ ጋካናዉ ኤንቲ ይሁዳ አሳ ዞረታ ላላና መላ አሰ ሻምዶሶና።<verse eid="EZR 4:5"/></para>
  <para style="s1">አርፀክስሳስ ፃፈትዳ ዳብዳበ</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6"/>አርፀክስስ ካዎትዳ ዎደ ይሁዳነ የሩሳላመ አሳ ሞታናዉ ፓይለ ዶይዶሶና።<verse eid="EZR 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7"/>አርፀክስሳ ካዎተ ላይን፥ ብሽላም፥ ምትርዳት፥ ፃቤልነ ኤንታ ባጋ ግድድ፥ ፋርሰ ካዋ አርፀክስሳስ ዳብዳበ ፃፍዶሶና፤ ሄ ዳብዳበይ አራምከ ፕዳለንነ ዶናን ፃፈትስ።<verse eid="EZR 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8"/>ቢታ አይስያ ረሁምነ ፃፈይ ስምሳይ የሩሳላመባ ሀይሳዳ ያግድ፥ ካዋ አርፀክስሳስ ዳብዳበ ፃፍዶሶና፤ <verse eid="EZR 4:8"/><verse number="9" style="v" sid="EZR 4:9"/>“ሀ ዳብዳበይ ቢታ አይስያ ረሁማፐ፥ ፃፍያ ስምሳያፐ፥ በተራፕለሳፐ፥ ፋርሰፐ፥ አርካፈ፥ ባብሎነፐ ሱሳፐነ ኤላማ ቢታን ደእያ ዳይናታፐነ ቢታ አይሰይሳፈ፥ <verse eid="EZR 4:9"/><verse number="10" style="v" sid="EZR 4:10"/>ቃስ ግታነ ቦንቸትዳ ካዋ አስናፋር ድእድ ሳማረንነ ኤፍራፂሳ ሻፋፐ ሄፍንን ዎዳ አሳ ኡባፈ ፃፈትስ” ያግዶሶና።<verse eid="EZR 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11"/>ኤንታ ዳብዳበይ ሀይሳዳ ያጌስ፤ “ካዋ አርፀክስሳስ፥ ኤፍራፂሳ ሻፋፐ ሄፍንን ደእያ ነ ሞርናታፐ የደትዳ ዳብዳበ።<verse eid="EZR 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 4:12"/>“ካዋዉ፥ ነ ማታፐ ኑኮ ይዳ አይሁደት የሩሳላመ ይድ፥ ሀ ማካላነ ኢታ ካታምዉ ዛሪድ ኬፆ ቦላ ደኤይሳ ኤራ። እ ግምበ ድርሳ ኦራሶና፤ እ ባሱዋ የጎሶና፤ እ ፃጱዋ ምንሶና። <verse eid="EZR 4:12"/><verse number="13" style="v" sid="EZR 4:13"/>ሄሳ ቦላ ቃስ፥ ሀ ካታምያ ኬፀትኮነ እ ድርሳ ግምበይ ኦራፅኮ ኤንቲ ጊራነ ቃራፃ ቃንፆናይሳ ኤራ፤ ካዎ ኬ ገልያ ሚሸይ ጉፃናይሳ አኬካ። <verse eid="EZR 4:13"/><verse number="14" style="v" sid="EZR 4:14"/>ኑኒ ካዎይ ሹምን ኦይሳታ ግድያ ግሾነ ካዎይ ካዉይሽን በአናዉ ኮዮና ግሾ ሀይሳ ነ ኤራና መላ ግድ ኦዶስ። <verse eid="EZR 4:14"/><verse number="15" style="v" sid="EZR 4:15"/>ሄሳ ግሾ፥ ካሰ ነ አዋታ ታርከ ማፃፋይ ኮየትድ ፄለቶ፤ ሄ ፃፈትዳባፐ ሀ ካታምያ ማካላነ ካዎታስነ ቢታታስ መቶ መሸ ደእዳይሳ ኤራናዉ ዳንዳኣሳ፤ ሄሳ ጋሶን እያ ላለታሱ። <verse eid="EZR 4:15"/><verse number="16" style="v" sid="EZR 4:16"/>ሀ ካታምያ ኬፀትያነ እ ድርሳ ግምበይ ኦራፅያባ ግድኮ፥ ኤፍራፂሳ ሻፋፐ ሄፍንን ደእያ ቢታይ ነ ኩሸፐ ከይዳይሳ ኤራ” ያግዶሶና።<verse eid="EZR 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17"/>ካዎይ ሀይሳዳ ግያ ዛሮ ኤንታዉ የድስ፤ “ቢታ አይስያ ረሁማ፥ ፃፍያ ስምሳያ፥ ሳማረንነ ኤፍራፂሳ ሻፋፐ ሄፍንን ደእያ ኤንታራ እስፍዳ አሳ ሳሮ ጋይስ። <verse eid="EZR 4:17"/><verse number="18" style="v" sid="EZR 4:18"/>ህንተ ታዉ የድዳ ዳብዳበይ ብርሸትድ ናባበትን ስአስ። <verse eid="EZR 4:18"/><verse number="19" style="v" sid="EZR 4:19"/>ታ ኪታን፥ ካሰ ታርከይ ኮየትድ ፄለትያ ዎደ፥ ሀ ካታምያ በንፐካ ካዎታስ ማካላነ መቶ መሸ ደእያ ቢታ ግደይስ ኤረትስ። <verse eid="EZR 4:19"/><verse number="20" style="v" sid="EZR 4:20"/>የሩሳላመን ዎልቃማ ካዎት ካዎትዶሶና፤ ኤፍራፂሳ ሻፋፐ ሄፍንን ደእያ ቢታፈካ ሄ ካዎት ጊራነ ቃራፃ ኤክዶሶና። <verse eid="EZR 4:20"/><verse number="21" style="v" sid="EZR 4:21"/>ሄሳ ግሾ፥ ታኒ ኤንታዉ ሀ ኪታ እማና ጋካናዉ፥ ሀ አሳት ሄ ካታምዉ ኬፀይሳ ኤሳና መላ ኦድተ። <verse eid="EZR 4:21"/><verse number="22" style="v" sid="EZR 4:22"/>ህንተ ሀ ኦዳ ቀል ጎና መላ ናገትተ፤ ካዎታስ መቶ ዳርሳናዉ ኮሸና” ያግድ ኪትስ።<verse eid="EZR 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23"/>ካዋ አርፀክስሳ ዳብዳበይ ረሁማስ፥ ፃፍያ ስምሳያስነ ኤንታራ ደእያ ኡባስ ናባበትዳ ዎደ የሩሳላመን ደእያ አይሁደታኮ ኤለስ ብድ፥ ኤንቲ ኬፀይሳ ዎልቃን ኤስዶሶና።<verse eid="EZR 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 4:24"/>ሄ ዎደፐ ዶምድ የሩሳላመን ደእያ ፆሳ ኬ ኦሶይ ዳርዮስ ካዎትዳ ናምአን ላይ ጋካናዉ ኤቅስ።<verse eid="EZR 4:24"/></para>
  <chapter eid="EZR 4"/>
  <chapter number="5" style="c" sid="EZR 5"/>
  <para style="s1">ታንታን ዳርዮሳስ ፃፍዳ ዳብዳበ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1"/>ሄ ዎደ ናምኡ ናበት ሀገይነ ዛካርያስ ይሁዳንነ የሩሳላመን ደእያ አይሁደ አሳስ እስራኤለ ፆሳ ሱንን ትንብተ ኦድዶሶና። <verse eid="EZR 5:1"/><verse number="2" style="v" sid="EZR 5:2"/>ሳላትያላ ናአይ ዛሩባበልነ እዮሳደቃ ናአይ እያሱይ ደንድድ፥ የሩሳላመን ደእያ ጎዳ ኬ ዛሪድ ኬፃናዉ ዶምዶሶና። ፆሳ ናበትካ ኤንታ ማድሸ ኤንታራ ደእዶሶና።<verse eid="EZR 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3"/>ሄ ዎደ ኤፍራፂሳ ሻፋፐ ሄፍንን ደእያ ቢታ አይስያ ታንታን፥ ሳታርቡዛንነ ኤንታራ ደኤይሳት የሩሳላመ ይድ፥ “ሀ ኬ ህንተ ኬፃና ማላ ህንተዉ ማታ እምዳይ ኦኔ?” ያግድ ኦይችዶሶና። <verse eid="EZR 5:3"/><verse number="4" style="v" sid="EZR 5:4"/>ቃስ፥ “ሀ ኬ ኬፅያ አሳታ ሱንይ ኦኔ?” ያግድ ኦይችዶሶና። <verse eid="EZR 5:4"/><verse number="5" style="v" sid="EZR 5:5"/>ሽን ፆሳ አይፈይ ይሁዳ ጭማታ ቦላ ደእያ ግሾ፥ ሀ ኦዳይ ዳርዮሳኮ ጋክን፥ ዳብዳበይ ያና ጋካናዉ ኤንታ ኦንካ ኦሶ ድግበና።<verse eid="EZR 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6"/>ኤፍራፂሳ ሻፋፐ ሄፍን ቢታ አይስያ ታንታናያ፥ ሳታርቡዛንነ ኤንታራ ኦያ ካዋ ዳርዮሳስ ፃፍዳ ዳብዳበይ ሀይሳ። <verse eid="EZR 5:6"/><verse number="7" style="v" sid="EZR 5:7"/>ኤንቲ እያዉ የድዳ ዳብዳበይ ሀይሳዳ ያግድ ናባበቴስ።</para>
  <para style="p" vid="EZR 5:7">ካዋ ዳርዮሳ፥ ሳሮይ ነዉ ግዶ።<verse eid="EZR 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 5:8"/>ኑኒ ይሁዳ ቢታን ደእያ ግታ ፆሳ ኬ ብድ በእዳይሳ ካዎይ ኤሮ። ሄ ፆሳ ኬይ ግታ ሹቻን ኬፀትስ፤ ግምበ ቱሳት ከይዶሶና፤ ኦሶይካ ግታ አኬካንነ ኤሶን ኦሰትሸ ደኤስ።<verse eid="EZR 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 5:9"/>“ኑኒ፥ ሀ ኬ ኬፃና ማላ ህንተዉ ማታ እምዳይ ኦኔ?” ያግድ ጭማታ ኦይችዳ። <verse eid="EZR 5:9"/><verse number="10" style="v" sid="EZR 5:10"/>ቃስ ኤንታና ካለያ አሳታ ሱንይ ኦነኮ ፃፍድ ነና ኤርሳናዉ ኤንታ ኦይችዳ።<verse eid="EZR 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 5:11"/>ኤንቲ ሀይሳዳ ያግድ ዛርዶሶና፦</para>
  <para style="p" vid="EZR 5:11">“ኑኒ ሳሎነ ሳአ ፆሳ አይለታ፤ ኑኒ ዳሮ ላይፈ ካሰ ግታ እስራኤለ ካዎይ ኬፅድ ፖልዳ ኬ ዛሪድ ኬፆስ። <verse eid="EZR 5:11"/><verse number="12" style="v" sid="EZR 5:12"/>ኑ አዋት ሳሎ ፆሳ ሀንቀዳ ግሾ፥ እ ኤንታ ባብሎነ ካዋ ናቡካዳናፆራ ኩሸን አድ እሚስ። እ ሀ ኬ ላልስ፤ አሳ ድእድ ባብሎነ ቢታ ኤፍስ።”<verse eid="EZR 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 5:13"/>“ሽን ባብሎነ ካዎይ ቅሮስ ባ ካዎትዳ ኮይሮ ላይን፥ ፆሳ ኬ ዛር ኬፃና መላ አዋጆ ከስስ። <verse eid="EZR 5:13"/><verse number="14" style="v" sid="EZR 5:14"/>ናቡካዳናፆር የሩሳላመን ደእያ ፆሳ ኬፈ ኤክ ኤፍድ፥ ባብሎነ ቢታን ደእያ ባ ካዎ ጋን ዎዳ ዎርቃነ ብራ ሚሸታካ ቅሮስ ዛሪድ የድስ። ሄ ሚሸት ካዎይ ቅሮስ ይሁዳ ቢታ አይሳና መላ ዶርዳ ሰሳብሳራ ኩሸን እመትስ። <verse eid="EZR 5:14"/><verse number="15" style="v" sid="EZR 5:15"/>ካዎይ፥ ‘ሀ ሚሸታ ኤካ ኤፋዳ የሩሳላመን ደእያ ፆሳ ኬን ዎ፤ ፆሳ ኬይካ ካሰ ደእያ በሳን ኬፀቶ’ ያግን፥ <verse eid="EZR 5:15"/><verse number="16" style="v" sid="EZR 5:16"/>ሰሳብሳር ይድ፥ ‘ፆሳ ኬ ኬፅያ በሳን የሩሳላመን ባስስ። እ ሀእ ጋካናዉ ዉርቤና፤ ሄ ዎደፐ ዶምድ፥ ኬፀትሸ ደኤስ’ ” ያግዶሶና።<verse eid="EZR 5:16"/></para>
  <para style="b"/>
  <para style="pi">
    <verse number="17" style="v" sid="EZR 5:17"/>“ህዛ ሀ ኦዳይ ካዋ ኡፋይስያባ ግድኮ፥ አነ ካዎይ ቅሮስ ሀ ፆሳ ኬ የሩሳላመን ኬፃና መላ፥ ቱማካ አዋጁዋ ከስዳኮ ኤራናዉ ካሰ አዳ ባብሎነ ካዎታ ታርከ ማዝጋበይ ኮየትድ ፄለቶ። ሄሳፈ ጉየ፥ ካዎይ ሀ ኦዳ ዋታናዉ ቆፕዳኮ ኑና ኤርሶ” ያግድ ፃፍዶሶና።<verse eid="EZR 5:17"/></para>
  <chapter eid="EZR 5"/>
  <chapter number="6" style="c" sid="EZR 6"/>
  <para style="s1">ዳርዮሳ አዋጁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1"/>ሄሳ ግሾ፥ ካዎይ ዳርዮሳ ኪታን፥ ባብሎነ ደእያ ሚሸ ዎያ ኬን ደእያ ታርከ ማዝጋበታ ኮይዶሶና። <verse eid="EZR 6:1"/><verse number="2" style="v" sid="EZR 6:2"/>ሜዶና አዉራጃን አህማታ ካታማን እስ ፃ ማፃፍ በንትስ፤ ሄ ማፃፋን ፃፈትዳባይ ሀይሳዳ ያጌስ፦<verse eid="EZR 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 6:3"/>“ካዎይ ቅሮስ ባ ካዎትዳ ኮይሮ ላይን፥ የሩሳላመን ደእያ ፆሳ ኬ ግሾ፥ ሀይሳዳ ግያ አዋጆ ከስስ። ፆሳ ኬይ ያርሾ ሺሽያ በሲ ግድድ ዛር ኬፀቶ፤ እያ ባሶይካ የገቶ። ሄ ኬ አዱሳተይ ኡሱፑን ታሙ ዋ፥ ዳልጋተይ ኡሱፑን ታሙ ዋ ግዶ። <verse eid="EZR 6:3"/><verse number="4" style="v" sid="EZR 6:4"/>ሄ ቶሆ ግታ ሹቻን ዩሾ፥ እስ ቶሆ ም ቱሳት ዩዮ። ሄሳስ ኮሽያ ሚሸ ኡባይ ካዎ ሻሎ ምንጅያ ኬፈ እመቶ። <verse eid="EZR 6:4"/><verse number="5" style="v" sid="EZR 6:5"/>ናቡካዳናፆር የሩሳላመን ደእያ ፆሳ ኬፈ ኤክድ፥ ባብሎነ ኤህዳ ፆሳ ኬ ዎርቃነ ብራ ሚሸት ባንታ በሳ ጉየ የሩሳላመ ስሚድ፤ ፆሳ ኬን ደኦ” ያግስ።<verse eid="EZR 6:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="EZR 6:6"/>ሄሳፈ ጉየ፥ ዳርዮስ ፃፍዳ ዳብዳበይ ሀይሳዳ ያጌስ። “ህንተኖ ኤፍራፂሳ ሻፋፐ ሄፍን ቢታ አይስያ ታታናያ፥ ሳታርቦዝንያነ ኤንታራ ኦይሳቶ፥ ሀ ፆሳ ኬኮ ሺቆፕተ። <verse eid="EZR 6:6"/><verse number="7" style="v" sid="EZR 6:7"/>ሀ ፆሳ ኬ ኦሱዋስ በ ግዶፕተ። አይሁደታ ሀላቃትነ አይሁደ ጭማት ፆሳ ኬ ካሰ በሳን ዛሪድ ኬፆ።”<verse eid="EZR 6:7"/></para>
  <para style="pi">
    <verse number="8" style="v" sid="EZR 6:8"/>ሄሳ ቦላ ቃስ፥ “ሀ አይሁደ ጭማት ፆሳ ኬ ኬፅያ ዎደ፥ ኤንቲ ኦያ ኦሶይ ኤቆና መላ ኤንታዉ ኮሽያ ሚሸ ኡባ ኤፍራፂሳ ሻፋፐ ሄፍን ቢታፈ ሺሽዳ ካዋ ጊራ ሚሽያፐ ኤንታዉ እማና መላ ታኒ ኪታስ። <verse eid="EZR 6:8"/><verse number="9" style="v" sid="EZR 6:9"/>የሩሳላመን ደእያ ካህነት ሳሎ ፆሳስ ፁሳ ያርሾ ያርሻናዉ ኮሽያ ዎፋኖ ግድን፥ ማራዘ ግድን ዎይኮ ዶርሳ ኡርገ ግድን ኤንታዉ እምተ። ቃስ አይባካ ፓጭሶና ኤንቲ ኮይያ ግስተ፥ ማፅነ፥ ዎይነነ ዛይተ ኤንታዉ ጋላስ ጋላስ እምተ። <verse eid="EZR 6:9"/><verse number="10" style="v" sid="EZR 6:10"/>ሄሳ ህንተ እመይ ኤንቲ ሳሎ ፆሳ ኡፋይስያ ያርሾ ያርሻናሳነ ካዋስነ እያ ናይታስ ዎሳናሳ። <verse eid="EZR 6:10"/><verse number="11" style="v" sid="EZR 6:11"/>ሀ አዋጁዋ ላምያ ኦንካ ደእኮ፥ እያ ኬ ቱሳ ሾድድ፥ ሄ ቱሳ ቦላ እያ ካቆ፤ እያ ኬይካ ፕቶ የግያ በሰ ግዶ። <verse eid="EZR 6:11"/><verse number="12" style="v" sid="EZR 6:12"/>ሀ ኪታ ላማናዉ ዎይኮ የሩሳላመን ደእያ ፆሳ ኬ ላላናዉ ኩሸ ደንያ አይ ካዎይ ዎይኮ አስ ግድን፥ ባ ሱንይ ፄገታና መላ የሩሳላመ ዶርዳ ፆሳይ እያ ይሶ። ታኒ ዳርዮስ ሀይሳ ኪታስ። ሀ ኡባይ ምኖተን ፖለቶ” ያግስ።<verse eid="EZR 6:12"/></para>
  <para style="s1">ፆሳ ኬ አንጅሶ ባኣለ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13"/>ሄሳፈ ጉየ፥ ኤፍራፂሳ ሻፋፐ ሄፍን ቢታ አይስያ ታታናያ፥ ሳታርቡዛንነ ኤንታራ ኦያ ኡባይ ካዎይ ዳርዮስ ኪትዳይሳዳ ምኖተን ኦድ ፖልዶሶና። <verse eid="EZR 6:13"/><verse number="14" style="v" sid="EZR 6:14"/>አይሁደ ጭማት ባንታ ኦሱዋ አጎና ኦዶሶና፤ ቃስ ናበይ ሀገይነ እዶ ናአይ ዛካርያስ ኦድዳ ቃላን ምነትዶሶና። እስራኤለ ፆሳይ ኪትዳይሳዳ ፋርሰ ካዎት ቅሮስ፥ ዳርዮስነ አርፀክስስ አዋጅዳይሳዳ ፆሳ ኬ ኬፅድ ዉርስዶሶና። <verse eid="EZR 6:14"/><verse number="15" style="v" sid="EZR 6:15"/>ዳርዮስ ካዎትዳ ኡሱፑን ላይን አዳረ ጌተትያ አጌናን ሄን ጋላሳን፥ ፆሳ ኬ ኦሶይ ፖለትስ።<verse eid="EZR 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16"/>እስራኤለ አሳይ፥ ካህነት፥ ሌወትነ ድኦፐ ስምዳ አሳ ኡባይ ፆሳ ኬ አንጅስያ ባኣለ ኡፋይሳን ቦንችዶሶና። <verse eid="EZR 6:16"/><verse number="17" style="v" sid="EZR 6:17"/>ሄ ባለይ ቦንቸትያ ዎደ ኤንቲ እስ ፄቱ ኮርማ፥ ናምኡ ፄቱ ማራዘ፥ ኦይዱ ፄቱ ዶርሳ ኡርገታ ያርሽዶሶና። ቃስ ናጋራ ያርሾስ ታማነ ናምኡ እስራኤለ ኮቻታ ታይቦን ታማነ ናምኡ ኮለ ያርሽዶሶና። <verse eid="EZR 6:17"/><verse number="18" style="v" sid="EZR 6:18"/>ሙሰ ማፃፋን ፃፈትዳይሳዳ፥ የሩሳላመን ደእያ ፆሳ ኬን ኦና መላ ካህነትነ ሌወት ኤንታ ማራዳ ማራዳ ዎዶሶና።<verse eid="EZR 6:18"/></para>
  <para style="s1">ፓስካ ባኣለ</para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19"/>ድኦፐ ስምዳ አሳይ ኮይሮ አጌናን ታማነ ኦይዳን ጋላስ ፓስካ ባኣለ ቦንችዶሶና። <verse eid="EZR 6:19"/><verse number="20" style="v" sid="EZR 6:20"/>ካህነትነ ሌወት ባንታና ጌሽዶሶና፤ ኤንቲ ኡባይ ዎጋዳ ጌይዶሶና። ሌወት ድኦፐ ስምዳ ኡባስ፥ ካህነታስነ ባንታዉ ፓስካ ዶርሰ ሹክዶሶና። <verse eid="EZR 6:20"/><verse number="21" style="v" sid="EZR 6:21"/>ድኦፐ ስምዳ እስራኤለ አሳይነ አይሁደ ግዶና አሳይ ኦያ ቱናተፈ ባንታና ሻክድ፥ ጎዳኮ፥ እስራኤለ ፆሳኮ ስምዳ አሳ ኡባይ ፓስካ ምዶሶና። <verse eid="EZR 6:21"/><verse number="22" style="v" sid="EZR 6:22"/>ጎዳይ አሶረ ካዋ ቆፋ ላምድ እስራኤለ ጎዳ፥ ፆሳ ኬ ኬፅድ ፖላና መላ ማድዳ ግሾ፥ ኤንቲ ላፑን ጋላስ ኡይ ባኣለ ኡፋይሳን ቦንችዶሶና።<verse eid="EZR 6:22"/></para>
  <chapter eid="EZR 6"/>
  <chapter number="7" style="c" sid="EZR 7"/>
  <para style="s1">እዝር የሩሳላመ ዩሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1"/>ዳሮ ዎደፐ ጉየ፥ ፋርሰ ካዉአ አርፀክስስ ካዎትዳ ዎደ እዝራ ጌተትያ እስ አስ ደእስ። እዝር ሳራያ ናአ፤ አዛራ ናአ፤ ካልቀ ናአ፤ <verse eid="EZR 7:1"/><verse number="2" style="v" sid="EZR 7:2"/>ሳሉማ ናአ፤ ሳዶቃ ናአ፤ አክፁባ ናአ፤ <verse eid="EZR 7:2"/><verse number="3" style="v" sid="EZR 7:3"/>አማረ ናአ፤ አዛራ ናአ፤ ማራዮታ ናአ፤ <verse eid="EZR 7:3"/><verse number="4" style="v" sid="EZR 7:4"/>ዛራሀ ናአ፤ ኦዛ ናአ፤ ቡቃ ናአ፤ <verse eid="EZR 7:4"/><verse number="5" style="v" sid="EZR 7:5"/>አብሱ ናአ፤ ፍንሃሳ ናአ፤ ፍንሃስ አላዛራ ናአ፤ ካህነ ሀላቃ አሮና ናአ።<verse eid="EZR 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 7:6"/>ሀይስ እዝር ባብሎነፐ ብስ። ጎዳይ፥ እስራኤለ ፆሳይ እምዳ ሙሰ ህግያ ኤርያ አስ። ጎዳ፥ ፆሳ ኩሸይ እያ ቦላ ደእያ ግሾ፥ እ ኦይችዳባ ኡባ ካዎይ እያዉ እሚስ። <verse eid="EZR 7:6"/><verse number="7" style="v" sid="EZR 7:7"/>ካዎይ አርፀክስስ ካዎትዳ ላፑን ላይን እስራኤለ አሳፐ ጉታራ፥ ካህነት፥ ሌወት፥ ዛማረት፥ ፐንገ ናገይሳትነ ፆሳ ኬ ኦሳንቾት እዝራራ እስፈ የሩሳላመ ብዶሶና። <verse eid="EZR 7:7"/><verse number="8" style="v" sid="EZR 7:8"/>ካዎይ ካዎትዳ ላፑን ላይን እቻሻን አጌናን እዝር የሩሳላመ ጋክስ። <verse eid="EZR 7:8"/><verse number="9" style="v" sid="EZR 7:9"/>ፆሳ ሎኦ ኩሸይ እያ ቦላ ደእያ ግሾ ኮይሮ አጌናን ኮይሮ ጋላስ ባብሎነፐ ከይድ፥ እቻሻን አጌናን ኮይሮ ጋላስ የሩሳላመ ጋክስ። <verse eid="EZR 7:9"/><verse number="10" style="v" sid="EZR 7:10"/>እዝር ጎዳ ህግያ ፃናኦን፥ ኦሶ ቦላ ፔሾንነ እስራኤለ አሳ እያ ዎጋነ እያ ህግያ ታማርሳናዉ ባ ዎዛና ጊግስስ።<verse eid="EZR 7:10"/></para>
  <para style="s1">አርፀክስስ እዝራስ ፃፍዳ ዳብዳበ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11"/>ጎዳይ እስራኤለስ እምዳ ህግያነ ዎጋ፥ ሎይ ኤርያ ካህነነ ፃፈ ግድዳ እዝራስ ካዎይ አርፀክስስ ፃፍዳ ዳብዳበይ ሀይሳ።<verse eid="EZR 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 7:12"/>“ካዎታ ካዋ አርፀክስሳፐ፥ ካህነነ ሳሎ ፆሳ ህገ ሎይ ኤርያ እዝራስ፥ ሳሮይ ነዉ ግዶ!<verse eid="EZR 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 7:13"/>“ታ ካዎተ ግዶን ደእያ እስራኤለ አሳፐ ኦንካ፥ ካህነ ዎይኮ ሌወ ግድን፥ የሩሳላመ ባናዉ ኮይያ አሳይ ኔራ ባና መላ ታኒ ኪታስ። <verse eid="EZR 7:13"/><verse number="14" style="v" sid="EZR 7:14"/>ታንነ ታራ ዞረትያ ላፑን አሳት እስፈ ግድድ፥ ነ ኩሸን ደእያ ፆሳ ህግያዳ፥ ባዳ ይሁዳንነ የሩሳላመን ደእያ ሀኖተይ አይ መለኮ ኦይቻና መላ ነና ኪቶስ። <verse eid="EZR 7:14"/><verse number="15" style="v" sid="EZR 7:15"/>የሩሳላመን ደእያ እስራኤለ ፆሳስ፥ ታንነ ታራ ዞረትያ አሳት ኑ ዶሳን እምዳ ዎርቃነ ብራ እሞታ ኤካዳ ባ። <verse eid="EZR 7:15"/><verse number="16" style="v" sid="EZR 7:16"/>ሄሳ ቦላ ቃስ ኔኒ ባብሎነ ቢታ ኩመፈ ደምዳ ብራነ ዎርቃ ኡባ፥ ቃስ እስራኤለ አሳይነ ካህነት የሩሳላመን ደእያ ባንታ ፆሳ ኬስ ዶሳን እምዳ እሞታ ኤካዳ ባ። <verse eid="EZR 7:16"/><verse number="17" style="v" sid="EZR 7:17"/>ሀ ሚሽያን ኮርማታ፥ ማራዘታ፥ ዶርሳ ኡርገታነ፥ ካ ያርሾስነ ኡሻ ያርሾስ ኮሽያባ ሻማዳ፥ የሩሳላመን ደእያ ህንተ ፆሳ ኬን ያርሾ በሳን ያርሻ።<verse eid="EZR 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 7:18"/>“ሄሳፈ ፓላህዳ ብራነ ዎርቃ ኔንነ ኔራ ደእያ አይሁደ ግድዳ ነ እሻት ህንተ ፆሳ ሸነን፥ ህንተ ኦናዉ ኮያባ ኦተ። <verse eid="EZR 7:18"/><verse number="19" style="v" sid="EZR 7:19"/>ቃስ ኑኒ ህንተ ፆሳ ኬስ፥ እምዳ ሚሸታ ኡባ የሩሳላመ ፆሳ ስንን ሺሻ። <verse eid="EZR 7:19"/><verse number="20" style="v" sid="EZR 7:20"/>ሄሳፈ ሀራባይ ፆሳ ኬስ ኮሽያባይ አይብካ ደእኮ፥ ካዎ ሚሸ ምንጅያ ኬፈ ኤካናዉ ዳንዳኣሳ።<verse eid="EZR 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 7:21"/>“ታኒ ካዎይ አርፀክስስ ኤፍራፂሳ ሻፋፐ ሄፍንን ቢታን ደእያ ሚሸ ኬን አዋተይ ደእያ ኡባታስ ሀ ኪታ እማስ። ካህነነ ሳሎ ፆሳ ህግያ ሎይ ኤርያ እዝር ህንተና ኦይችያባይ አይባ ግድኮካ እያዉ እምተ። <verse eid="EZR 7:21"/><verse number="22" style="v" sid="EZR 7:22"/>ሄ ሙኩሉነ ኦይዱ ፄቱ ክሎ ግራመ ብራ፥ እስ ፄቱ ኩንታለ ግስተ፥ ናምኡ ሙኩሉ ልትሮ ዎይነ ኡሽ፥ ናምኡ ሙኩሉ ልትሮ ሻማሆ ዛይተነ ኮሽያ መላ ማፅነ እያዉ እምተ። <verse eid="EZR 7:22"/><verse number="23" style="v" sid="EZR 7:23"/>ካዋ ቦላነ ካዋ ናይታ ካዎተ ቦላ ሀንቆይ ዮና መላ ሳሎ ፆሳይ ባ ኬስ ኮይያባ ኡባ እምተ። <verse eid="EZR 7:23"/><verse number="24" style="v" sid="EZR 7:24"/>ካህነታፐ፥ ሌወታፐ፥ ዛማረታፐ ፐንገ ናገይሳታፐ፥ ፆሳ ኬ ኦሳንቾታፐነ ፆሳ ኬ ግዶን ዱማ ዱማ ኦሶ ኦያ አሳፐ ህንተ ጊራነ ቃራፃ ኤካናዉ ህንተዉ ማት ባዋ።<verse eid="EZR 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 7:25"/>“ላ እዝራ፥ ኔኒ፥ ነዉ ፆሳይ እምዳ ጭንጫተን ኤፍራፂሳ ሻፋፐ ሄፍን ቢታን ደእያ ነ ፆሳ ህግያ ኤርያ አሳ ቦላ ፕርዳና መላ ዳይናታነ አይሰይሳታ ሹማ። ህግያ ኤሮና አስ ደእኮ ኔኒ ኤንታ ታማርሳ። <verse eid="EZR 7:25"/><verse number="26" style="v" sid="EZR 7:26"/>ነ ፆሳ ህግያነ ካዋ ህግያ ኪተቶና ኦንካ ደእኮ፥ እ ቃይ ባይና ሀይቆ ዎይኮ ጋደፐ ጎደቶ ዎይኮ እያ ሻሎይ ቦንቀቶ ዎይኮ ቃሾን ሴረቶ” ያግስ።<verse eid="EZR 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27"/>የሩሳላመን ደእያ ፆሳ ኬ ሀይሳዳ ቦንቸታና መላ ካዋ ዎዛናን ሀ ቆፋ ዎዳ ጎዳ፥ ኑ አዋታ ፆሳ ጋላት ጋኮ! <verse eid="EZR 7:27"/><verse number="28" style="v" sid="EZR 7:28"/>ካዋ፥ ካዉዋራ ዞረተይሳታነ እያራ ኦያ ዎልቃማ ሀላቃታ ስንን ባ ቴማ ታዉ እምዳ ፆሳስ ጋላት ግዶ! ጎዳ፥ ታ ፆሳ ኩሸይ ታራ ደእያ ግሾ፥ እስራኤለ ሀላቃታፐ ኤረትዳይሳታ ዶራዳ የሩሳላመ ኤካ ባና መላ እ ታዉ ምኖተ ግድስ።<verse eid="EZR 7:28"/></para>
  <chapter eid="EZR 7"/>
  <chapter number="8" style="c" sid="EZR 8"/>
  <para style="s1">እዝራራ ድኦፐ ስምዳ አሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 8:1"/>ካዎይ አርፀክስስ ካዎትዳ ዎደ ታራ እስፈ ባብሎነ ቢታፈ ስምዳ ሶ አሳ ሀላቃት ሀይሳታ፤<verse eid="EZR 8:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="EZR 8:2"/>ፍንሃሳ ያራፐ ገርሶና፥ እታማራ ያራፐ ዳነላ፥ ዳዊታ ያራፐ ሳካና ናኣ ሀፁሳ፥<verse eid="EZR 8:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="EZR 8:3"/>ፓሮሳ ያራፐ ዛካርያሳነ ኤንታ የለታ ማራን ፃፈትዳ ሀራ እስ ፄታነ እሻታሙ አደታ።<verse eid="EZR 8:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 8:4"/>ፓሀት-ሞአበ ያራፐ ዛራሀ ናኣ ኤልሆኤናያነ እያራ ደእያ ናምኡ ፄቱ አደታ።<verse eid="EZR 8:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 8:5"/>ዛታ ያራፐ ያሀዝኤላ ናአ ሳካናነ እያራ ደእያ ሄ ፄቱ አደታ።<verse eid="EZR 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 8:6"/>አድና ያራፐ ዮናታና ናኣ ኤቤዳነ እሻታሙ አደታ።<verse eid="EZR 8:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 8:7"/>ኤላማ ያራፐ ጎቶላ ናአ ይሻያነ እያራ ደእያ ላፑን ታሙ አደታ።<verse eid="EZR 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 8:8"/>ሳፋፃ ያራፐ ምካኤላ ናአ ዝባዳነ እያራ ደእያ ሆስፑን ታሙ አደታ።<verse eid="EZR 8:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 8:9"/>እዮኣባ ያራፐ ይኤላ ናአ አብድዩነ እያራ ደእያ ናምኡ ፄታነ ታማነ ሆስፑን አደታ።<verse eid="EZR 8:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 8:10"/>ባና ያራፐ ዮስፍያ ናአ ሳሎምታነ እያራ ደእያ እስ ፄታነ ኡሱፑን ታሙ አደታ።<verse eid="EZR 8:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 8:11"/>በባያ ያራፐ በባያ ናኣ ዛካርያሳነ እያራ ደእያ ላታማነ ሆስፑን አደታ፥<verse eid="EZR 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 8:12"/>አዝጋዳ ያራፐ ሀቃፃና ናአ ዮሃናነ እያራ ደእያ እስ ፄታነ ታሙ አደታ።<verse eid="EZR 8:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 8:13"/>አዶንቃማ ያራፐ ዉርሰን ስምዳይሳት፥ ኤልፋላፃ፥ ይኡኤላ፥ ሻማያነ ኤንታራ ደእያ ኡሱፑን ታሙ አደታ።<verse eid="EZR 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 8:14"/>ብግዋያ ያራፐ ኡታያ፥ ዛኩራነ ኤንታራ እስፈ ሀራ ላፑን ታሙ አደታ።<verse eid="EZR 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15"/>ታኒ አሀዋኮ ጎግያ ሻፋ ማታን ኤንታ ሺሻስ። ኑኒ ሄ በሳን ዱንካንድ፥ ሄ ጋላስ ታክዳ። ታኒ ሄ በሳን ደእያ አሳነ ካህነታ ታይብያ ዎደ ሌወ ያራፐ እስ አስካ ደማብከ። <verse eid="EZR 8:15"/><verse number="16" style="v" sid="EZR 8:16"/>ሄሳ ግሾ፥ አላዛራ፥ አርኤላ፥ ሻማያ፥ ኤልናታና፥ ያርባ፥ ኤልናታና፥ ናታና፥ ዛካርያሳነ ማሱላማ ጌተተይሳታነ ጭንጫ አስ ግድዳ ዮያርባነ ኤልናታና ፄጋስ። <verse eid="EZR 8:16"/><verse number="17" style="v" sid="EZR 8:17"/>ኤንታ ካስፍያ ጌተትያ በሳን ሌወታስ ሀላቃነ ፆሳ ኬ ኦሳንቾ ግድዳ አዶስነ እያ ዳቦታስ ኦዳናባ አኬክሳዳ ኑ ፆሳ ኬን ኦያ አሰ ኤሀና መላ ኪታስ። <verse eid="EZR 8:17"/><verse number="18" style="v" sid="EZR 8:18"/>ኑ ፆሳ ሎኦ ኩሸይ ኑ ቦላ ደእያ ግሾ፥ እስራኤለ ናአ ሌወ ያራ ማህላ ያራነ ዳሮ ጭንጫ አስ ግድዳ ሳረባያ ጌተትያ አድያ ታማነ ሆስፑን እያ ናይታነ እያ እሻታ፥ ኑስ የድዶሶና። <verse eid="EZR 8:18"/><verse number="19" style="v" sid="EZR 8:19"/>ሄሳዳካ፥ ሀሻባ፥ ማራራ ያራ ግድዳ ያሻያ፥ እያ ናይታነ ላታሙ ግድያ እያ እሻታራ የድዶሶና። <verse eid="EZR 8:19"/><verse number="20" style="v" sid="EZR 8:20"/>ሄሳ ቦላ ካሰ አዋት ሌወታ ማዳና መላ ዳዊቲነ እያራ ኦያ ሀላቃት ሹምዳ ፆሳ ኬ ኦሳንቾታፐ ናምኡ ፄታነ ላታሙ አሳታ የድዶሶና። ሄሳት ኡባይ ባንታ ሱንን ፃፈትዶሶና።<verse eid="EZR 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21"/>ኑ ፆሳ ስንን ኑ ሁጵያ ካዉሽድ፥ ኦገይ ኑስ፥ ኑ ናይታስነ ኑ ሻሎ ኡባስ ሳሮ ግዳና መላ ዎሳና መላ ያን አሀዋ ሻፋ ማታን ፆማ አዋጃስ። <verse eid="EZR 8:21"/><verse number="22" style="v" sid="EZR 8:22"/>ካሰ ኑኒ ካዋስ፥ “ኑ ፆሳ ሎኦ ኩሸይ እያ ኮየይሳታ ቦላ ደኤስ፤ ሽን እያ ዎልቃማ ሀንቆይ እያ አገይሳታ ቦላ ደኤስ” ያግድ ኦድዳ ግሾ፥ ኑኒ ብያ ኦግያን ደእያ ሞርከታፐ ኑና ናጋና መላ ዎታዳረነ ፓራታ እማናዳ ካዋ ኦይቻናዉ ዬላታስ። <verse eid="EZR 8:22"/><verse number="23" style="v" sid="EZR 8:23"/>ሄሳ ግሾ፥ ኑኒ ፆምድ፥ ፆሳ ዎስዳ፤ እካ ኑ ዎሳ ስእስ።<verse eid="EZR 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24"/>ካህነ ሀላቃታፐ ሳረባያ፥ ሀሳባያነ ሀራ ኤንታ ዳቦ ግድዳ ታሙ አሳታ ዶራስ። <verse eid="EZR 8:24"/><verse number="25" style="v" sid="EZR 8:25"/>ካዎይ፥ እያራ ዞረተይሳት፥ እያ ሹማትነ እስራኤለ ኡባይ ኑ ፆሳ ኬስ እምዳ ብራ፥ ዎርቃነ፥ ሀራ ሚሸታ ኡባ ልካዳ ኤንታ ኩሸን ዎስ። <verse eid="EZR 8:25"/><verse number="26" style="v" sid="EZR 8:26"/>ታኒ ኤንታዉ እምዳባይ ሀይሳ፤ ላታማነ ናምኡ ሙኩሉ ክሎ ግራመ ብራ፥ ሄ ሙኩሉነ ኦይዱ ፄቱ ክሎ ግራመ ብራፐ ኦሰትዳ ሚሸታ፥ ሄ ሙኩሉነ ኦይዱ ፄቱ ክሎ ግራመ ዎርቃ፥ <verse eid="EZR 8:26"/><verse number="27" style="v" sid="EZR 8:27"/>ሆስፑን ክሎ ግራመነ ኦይዱ ፄቱ ግራመ ዎርቃፈ ኦሰትዳ ላታሙ ሳነታነ ዎርቃዳ አልኦነ ሙሩቶ ግድዳ ናሰ ብራታፐ ኦሰትዳ ናምኡ ሳነታ።<verse eid="EZR 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 8:28"/>ሄሳፈ ጉየ፥ ታኒ ኤንታኮ ሀይሳዳ ያጋስ፤ “ህንተነ ሀ ሚሸት ጎዳስ ዱማትደታ፤ ሀ ብራይነ ዎርቃይ፥ አሳይ ባ ዶሳን ጎዳስ፥ ህንተ አዋታ ፆሳስ እምዳ እሞታ። <verse eid="EZR 8:28"/><verse number="29" style="v" sid="EZR 8:29"/>የሩሳላመን ደእያ ፆሳ ኬን ሚሸ ምንጅያ ኬ ጋክድ፥ ካህነ ሀላቃታ ስንን፥ ሌወታ ስንንነ እስራኤለ ያራታ ሀላቃታ ስንን እማና ጋካናዉ፥ ሀ ሚሸታ ሎይድ ናግተ” ያጋስ። <verse eid="EZR 8:29"/><verse number="30" style="v" sid="EZR 8:30"/>ሄሳ ግሾ፥ ካህነትነ ሌወት የሩሳላመን ደእያ ፆሳ ኬ ኤፋናዉ ብራ፥ ዎርቃነ ሀራ ሚሸታ ኡባ ምዛነን ልክድ አዋተን ኤክዶሶና።<verse eid="EZR 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31"/>ኮይሮ አጌናን ታማነ ናምአን ጋላሳን የሩሳላመ ባናዉ አሀዋ ሻፋ ማታፐ ደንድዳ። ኑ ቦላ ደእያ ኑ ፆሳ ሎኦ ኩሸይ ኑ ብያ ኦገን ደእያ ሞርከታፐነ ፓንጋታፐ ኑና አሽስ። <verse eid="EZR 8:31"/><verse number="32" style="v" sid="EZR 8:32"/>ኑኒ የሩሳላመ ጋክድ፥ ያን ሄ ጋላስ ሸምፕዳ።<verse eid="EZR 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 8:33"/>ኦይዳን ጋላስ ብራ፥ ዎርቃነ ሀራ ሚሸታ ኡባ ልክድ፥ ኡራያ ናኣ ካህንያ ማረሞታስ እምዳ። ፍንሃሳ ናኣ አላዛር፥ ሌወ ግድዳ እያሱ ናኣ ዮዛባትነ ብንያ ናአ ኖኣድ እያራ እስፈ ደኦሶና። <verse eid="EZR 8:33"/><verse number="34" style="v" sid="EZR 8:34"/>ኡባባይ ሄ ዎደ ታይበት ልከትድ ፃፈትስ።<verse eid="EZR 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35"/>ሄሳፈ ጉየ፥ ድኦፐ ስምዳ አሳይ፥ እስራኤለ ፆሳስ፥ ታማነ ናምኡ ኮርማ፥ ኡዱፉን ታማነ ኡሱፑን ማራዘነ ላፑን ታማነ ላፑን ዶርሳ ኡርገታ ፁሳ ያርሾ ኦድ፥ ቃስ ታማነ ናምኡ ኮለ ናጋራ ያርሾ ኦድ ጎዳስ ያርሽዶሶና። ሄስ ኡባይ ፁሳ ያርሾ ግድድ ጎዳስ ሺቅስ። <verse eid="EZR 8:35"/><verse number="36" style="v" sid="EZR 8:36"/>ካዎይ ኪትዳ ኪታካ ካዉዋፐ ጋርሳራ ቢታ አይሰይሳታስነ ኤፍራፂሳ ሻፋፐ ሄፍን ቢታ አይሰይሳታስ እምዶሶና፤ ኤንቲ እስራኤለ አሳነ ፆሳ ኬ ኦሱዋ ማድዶሶና።<verse eid="EZR 8:36"/></para>
  <chapter eid="EZR 8"/>
  <chapter number="9" style="c" sid="EZR 9"/>
  <para style="s1">በሶና ኤኮ-ገሎ ዎጋ ድጉዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1"/>ሀ ኡባይ ሀንዳፐ ጉየ፥ ደርያ ካለይሳት ታኮ ይድ፥ ሀይሳዳ ያግዶሶና፤ “እስራኤለ አሳይ፥ ሀር አቶሽን፥ ካህነት፥ ሌወት፥ ባንታ ሄራን ደእያ፥ ካናነታ፥ ህተታ፥ ፓርዘታ፥ ያቡሰታ፥ አሞነታ፥ ሞአበታ፥ ግብፀታነ አሞረታ ቱናፐ ባንታና ሻክቦኮና። <verse eid="EZR 9:1"/><verse number="2" style="v" sid="EZR 9:2"/>ባንታዉነ ባንታ ናይታስ አይሁደ ግዶና ማጫ ናይታፐ ማቾ ኤክዶሶና፤ ሄሳ ጋሶን ጌሻ ዘረ አይሁደ ግዶና አሳራ ዋላክዶሶና። ሀ ባላን ኮይሮ ግድዳይ ካለይሳታነ ሀላቃታ” ያግዶሶና።<verse eid="EZR 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 9:3"/>ታኒ ሀ ኦዳ ስእዳ ዎደ ታ ማኡዋነ ታ ቃምስያ ዳካስ፤ ታ ሁጵያነ ታ ቡቻ ስካስ፤ ዳሮ ዳጋማዳ ኡታ አጋስ። <verse eid="EZR 9:3"/><verse number="4" style="v" sid="EZR 9:4"/>ድኦፐ ስምዳ አሳይ ኦዳ ናጋራ ግሾ፥ እስራኤለ ፆሳይ ኦድዳ ቃላስ ያይዳ አሳ ኡባይ ታኒ ደእያ በሳ ታኮ ሺቅዶሶና። ኦማርሳ ያርሾ ያርሽያ ዎደ ጋካናዉ ዳጋማዳ ኡትዳ በሳፈ ደንዳብከ።<verse eid="EZR 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5"/>ሽን ኦማርሳ ያርሾይ ሺቅያ ዎደ፥ ታ ማኦይነ ታ ቃምሰይ ዳከትድ ደእሽን፥ ታኒ አዛናዳ ኡትዳ በሳፈ ደንዳስ። ጉልባታዳ ጎዳኮ፥ ታ ፆሳኮ፥ ታ ኩሽያ ደንዳ፥ ሀይሳዳ ያጋዳ ዎሳስ። <verse eid="EZR 9:5"/><verse number="6" style="v" sid="EZR 9:6"/>“አቤት ታ ፆሳዉ፥ ኑ ናጋራይ ዶረትድ ኑ ሁጵያፐ አዳ ግሾነ ኑ ናቆይ ሳሎ ጋክዳ ግሾ ታኒ ታ ሶምኡዋ ኔኮ ደንናዉ ያያይስነ ዬላታይስ። <verse eid="EZR 9:6"/><verse number="7" style="v" sid="EZR 9:7"/>ኑኒ ኑ ማይዛታ ዎደፐ ዶምን፥ ሀች ጋካናዉ፥ ነና ዳሮ ናቅዳ። ኑ ናጋራ ጋሶን ኑኒ፥ ኑ ካዎትነ ኑ ካህነት ሀእይሳዳ አላጋ ካዎታ ኩሸን ኩንድዳ፤ ማሻስ፥ ዶኦስ፥ ቦንቄስነ ዬላስ አድ እመትዳ።<verse eid="EZR 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 9:8"/>“ሽን ሀእ ጎዳይ ኑ ፆሳይ ኑፐ ጉ አስ አሻናዉነ ባ ኬን ኑስ በሰ እማናዉ ኮይድ ጉ ዎደስ ማሮተ እሚስ። ሄሳ ግሾ ፆሳይ ኑ አይፊያ ዶይስ፤ ኑ አይለተን ደእሽን ጉ ዎደስ ሸምፖ እሚስ። <verse eid="EZR 9:8"/><verse number="9" style="v" sid="EZR 9:9"/>ኑኒ አይለ ግድኮካ፥ ኑ ፆሳይ ኑና አይለተን አግቤና፤ ኑ ደኡዋ ኦራስ። ኑ ፆሳ ኬ ኬፃና መላ፥ ላለትዳይሳ ኦራና መላነ ይሁዳንነ የሩሳላመን ሳሮ ዳና መላ ፋርሰ ካዎታ ስንን ኑስ ቴሞ እሚስ።<verse eid="EZR 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 9:10"/>“ሽን ኑ ፆሳዉ፥ ሀእ ያትን፥ ኑኒ ዎይጋኔ? ሄኮ ሀእካ ነ ኪታ ቶችዳ። <verse eid="EZR 9:10"/><verse number="11" style="v" sid="EZR 9:11"/>ኑ ቶችዳይ ነ አይለ ግድዳ ናበታ ባጋራ ‘ህንተ ላታናዉ ገልያ ቢታይ፥ እን ደእያ አሳን ቱንዳሮ፤ ሀ ጋፃፐ ህን ጋፃ ጋካናዉ ኤንታ ኢታ ኦሱዋንነ ቱናተን ኩማሱ። <verse eid="EZR 9:11"/><verse number="12" style="v" sid="EZR 9:12"/>ሄሳ ግሾ፥ ህንተ ምኖ ግዳና መላ፥ ሄ ቢታ አይፍያ ማና መላነ መርናዉ ህንተ ናይታስ ላትሳና መላ፥ ህንተ ማጫ ናይታ ኤንታ አደ ናይታስ እሞፍተ፤ ኤንታ ማጫ ናይታ ህንተ አደ ናይታስ ኤኮፍተ። ኤንቲ ሳሮተንነ ዱረተን ዳና መላ አሞቶፍተ’ ያጋዳሳ።<verse eid="EZR 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 9:13"/>“ኑ ቦላ ጋክዳ ኢታባ ኡባይ ኑ ኢታ ኦሱዋነ ኑ ግታ ናጋራ ጋሶና። ግዶሽን፥ ኔኒ ኑ ፆሳይ ኑ ናጋራ ዳሮተ መላ ኑና ፕርዳባካ፤ ሽን ኑፐ ጉታ አሻዳሳ። <verse eid="EZR 9:13"/><verse number="14" style="v" sid="EZR 9:14"/>ኑኒ ሀይሳ መላ ቱናባ ኦያ አሳራ ኤኮንነ ገሎን ዋላከትድ፥ ዋንድ ነ ኪታ እፃስ ጋኔ? ሀ አትዳ ጉ ኮቻይ ያና ጋካናዉ ነ ሀንቆይ ኑ ቦላ ዳረነዬ? <verse eid="EZR 9:14"/><verse number="15" style="v" sid="EZR 9:15"/>አቤት ጎዳዉ፥ እስራኤለ ፆሳዉ፥ ኔኒ ፅሎ፤ ኑኒ ሀእ ጋካናዉ አትድ ደኦን ደኦስ። ኑ ናጋራ ጋሶን ኑፐ እሶይካ ነ ስንን ኤቃናዉ ዳንዳኤይ ባዋ፤ አትዳይሳት ሀች ሀይሳን ነ ስንን ደኦስ” ያጋስ።<verse eid="EZR 9:15"/></para>
  <chapter eid="EZR 9"/>
  <chapter number="10" style="c" sid="EZR 10"/>
  <para style="s1">አሳይ ባንታ ናጋራ ፓፅዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1"/>እዝር ፆሳ ኬ ስንን ኩንድድ ዬክሸ ዎስያ ዎደነ ናጋራ ፓፅያ ዎደ ማጭ፥ አደይነ ናእ ደእያ እስራኤለ አሳይ እያኮ ሺቅድ፥ ይባታ ዬሆ እያራ ዬክዶሶና። <verse eid="EZR 10:1"/><verse number="2" style="v" sid="EZR 10:2"/>ኤላማ ያራ ግድዳ ይኤላ ናአይ ሳካን ሀይሳዳ ያግስ፤ “ኑኒ ኑ ዩሾን ደእያ አላጋ ማጫሳታ ኤክድ፥ ኑ ፆሳስ አማነትቦኮ። ግዶሽን፥ ሀእካ እስራኤለስ ኡፋይስ ደኤስ። <verse eid="EZR 10:2"/><verse number="3" style="v" sid="EZR 10:3"/>ታ ጎዳዉ፥ ኔንነ ኑ ፆሳ ኪታ ናገይሳት ዞርዳይሳዳ ኑኒ ሀ ማጫሳነ ኤንታፈ የለትዳ ናይታ ኡባ የዳናዉ ቃላ ገሎስ። ሄስ ኡባይ ጎዳ ህገይ ገይሳዳ ፖለቶ። <verse eid="EZR 10:3"/><verse number="4" style="v" sid="EZR 10:4"/>እዝራ፥ ሀ ኦሶይ ነ ኩሸን ደኤስ፥ ደንዳ፤ ኑኒ ነና ማዳና፤ ምና!” ያግስ።<verse eid="EZR 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5"/>እዝር ደንድ ኤቅድ፥ ካህነታ፥ ሌወታነ እስራኤለ አሳ ኡባ ሀ ጌተትዳይሳታ ኦና መላ ጫቅስስ፤ ኤንትካ ጫቅዶሶና። <verse eid="EZR 10:5"/><verse number="6" style="v" sid="EZR 10:6"/>እዝር ፆሳ ኬ ስንፈ ደንድድ፥ ኤልያሴባ ናአይ ዮሃን ደእያ ክፍለ ገልስ። ያን ድኦፐ ስምዳ አሳይ ናጋራስ ዬክሸ አቅዳ ግሾ፥ ሄ በሳን ካ ምቤና፤ ሃካ ኡይቤና።<verse eid="EZR 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7"/>ድኦፐ ስምዳ አሳይ የሩሳላመ ሺቃና መላ፥ ይሁዳንነ የሩሳላመን አዋጅዶሶና። <verse eid="EZR 10:7"/><verse number="8" style="v" sid="EZR 10:8"/>ሀ ሄ ጋላሳታ ግዶን ሄ በሳን ሺቆና ኦንካ ደእኮ፥ እያዉ ደእያባይ ኡባይ ኤከታና መላነ እካ ድኦፐ ስምዳ አሳ ሺቁዋፐ ኩረታና መላ ሀላቃትነ ጭማት ኦዳ ኩይዶሶና።<verse eid="EZR 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 10:9"/>ሄ ጌተትዳ ሄ ጋላሳታ ግዶን፥ ኡዱፉን አጌናን ላታማን ጋላሳን ይሁዳነ ብንያመ አሳ ኡባይ የሩሳላመ ሺቅዶሶና። ሀ ዴፆ ኦዳነ ዎልቃማ እራ ጋሶን፥ ኮኮርሸ፥ ፆሳ ኬ ስንን ደእያ ዳባባን ኡትዶሶና። <verse eid="EZR 10:9"/><verse number="10" style="v" sid="EZR 10:10"/>ካህነ እዝር ደንዲድ ሀይሳዳ ያግስ፤ “ህንተ አማነቶና እፅደታ፤ አላጋ ማጫሳታ ማቾ ኤክድ፥ እስራኤለ ናቁዋ ቦላ ናቆ ጉጅደታ። <verse eid="EZR 10:10"/><verse number="11" style="v" sid="EZR 10:11"/>ህንተ ናጋራ ጎዳስ፥ ህንተ አዋታ ፆሳስ ፓፅተ፤ እያ ኡፋይስያባ ኦተ። ሄ ቢታን ደእያ አይሁደ ግዶና አሳፐነ ህንተ ኤክዳ አይሁደ ግዶና ህንተ ማቸታፐ ሻከትተ” ያግስ።<verse eid="EZR 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12"/>ሺቅዳ አሳይ ባንታ ቃላ ቁ ኦድ፥ ሀይሳዳ ያግዶሶና። “ነ ግያባ ኡባ ኑኒ ኦና! <verse eid="EZR 10:12"/><verse number="13" style="v" sid="EZR 10:13"/>ሽን ሀይሳን ሺቅዳ አሳይ ዳሮ፤ ሄሳ ቦላ ዎልቃማ እር ቡኬስ። ኑኒ እራፐ አትያ በሲ ሀይሳን ባዋ። ሀ ናጋራን ቆህዳ አሳይ ዳሮ ግድዳ ግሾ፥ እስ ጋላሳን ዎይኮ ናምኡ ጋላሳን ሀ ኦዳ ፖላናዉ ዳንዳኦኮ። <verse eid="EZR 10:13"/><verse number="14" style="v" sid="EZR 10:14"/>ሀ ሺቅዳ አሳ ሱንን ኑ ሀላቃት የሩሳላመን ጋምእድ፥ ኮሽያባ ኦ። ሄሳ ጋሶን ደንዳዳ ፆሳ ዎልቃማ ሀንቆይ ኑፐ ስማና ጋካናዉ፥ ኑ ካታማታን ደእያ አይሁደ ግዶና ማጫሳታ ኤክዳ ኡባይ ኬርዳ ቃማን ካታማታ ጭማትነ ዳይናታራ እስፈ የሩሳላመ ዮ። <verse eid="EZR 10:14"/><verse number="15" style="v" sid="EZR 10:15"/>አሳሄላ ናአይ ዮናታንነ ተቁዋ ናአይ ያህዝ ኤንታ ቆፋ ጳልቅዶሶና፤ ማሱላምነ ሌወ ግድዳ ሳባት ኤንታና ማድዶሶና” ያግዶሶና።<verse eid="EZR 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16"/>ድኦፐ ስምዳ አሳይ ግዳይሳዳ ኦዶሶና። ካህነይ እዝር ኡባ ኮቻታፐ ሀላቃታ ዶርድ፥ ኡባ ኤንታ ሱንን ሱንን ፃፍስ። ታማን አጌናን ኮይሮ ጋላሳን ሀላቃት ኦዳ ፕልግድ በኦ ዶምዶሶና። <verse eid="EZR 10:16"/><verse number="17" style="v" sid="EZR 10:17"/>ኮይሮ አጌናን ኮይሮ ጋላሳይ ጋካናዉ፥ አይሁደ ግዶና ማጫሳታ ኤክዳ አሳታ ኡባ ፕልግድ ዉርስዶሶና።<verse eid="EZR 10:17"/></para>
  <para style="s1">አላጋ ማቾ ኤክዳ አሳታ</para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 10:18"/>ካህነ ኮቻታ ግዶፈ አላጋ ማጫሳታ ኤክዳይሳት ሀይሳታ፤ እዮሳደቃ ናአ እያሱ ኮቻታፐነ እያ እሻታ ግዶፈ ማእሰያ፥ አላዛራ፥ ያርባነ ጎዶልያ። <verse eid="EZR 10:18"/><verse number="19" style="v" sid="EZR 10:19"/>ኤንቲ ባንታ ማቸታ የዳናዉ ቃላ ገልዶሶና፤ ባንታ ናጋራ ግሾ፥ ዉድያፐ እስ እስ ማራዘ ናቆ ያርሾ ኦድ ያርሽዶሶና። <verse eid="EZR 10:19"/><verse number="20" style="v" sid="EZR 10:20"/>እመራ ያራፐ አላጋ ማቸታ ኤክዳይሳት ሀናናነ ዛባዳ። <verse eid="EZR 10:20"/><verse number="21" style="v" sid="EZR 10:21"/>ሀርማ ያራፐ ማእሰያ፥ ኤልያሳ፥ ሻማያ፥ ይኤላነ ኦዝያ። <verse eid="EZR 10:21"/><verse number="22" style="v" sid="EZR 10:22"/>ፓስኮራ ያራፐ ኤልዮአናያ፥ ማእሰያ፥ እስማኤላ፥ ናትናኤላ፥ ዮዛባታነ ኤልስ።<verse eid="EZR 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 10:23"/>ሌወታፐ፥ ዮዛባታ፥ ሳመአ፥ ቃልፃ ጌተትያ ቀላያ፥ ፋታያ፥ ይሁዳነ አላዛራ።<verse eid="EZR 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 10:24"/>ዛማረታፐ፥ ኤልያሴባ።</para>
  <para style="p" vid="EZR 10:24">ፐንገ ናገይሳታፐ፥ ሳሉማ፥ ፀለማነ ኡረ።<verse eid="EZR 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 10:25"/>እስራኤለታፐ፥ ፋሮሳ ያራፐ ራምያ፥ ይዛያ፥ ማልክያ፥ ማያምና፥ አላዛራ፥ ማልክያነ ባናያ።<verse eid="EZR 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZR 10:26"/>ኤላማ ያራፐ ማታና፥ ዛካርያሳ፥ ይኤላ፥ አብዳ፥ ይረሞታነ ኤላ።<verse eid="EZR 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 10:27"/>ዛታ ያራፐ ኤልዮአና፥ ኤልያሴባ፥ ማታና፥ ይረሞታ፥ ዛባዳነ አዚዛ።<verse eid="EZR 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 10:28"/>ባባያ ያራፐ ዮሃና፥ ሀናና፥ ዛባያነ አትላያ።<verse eid="EZR 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZR 10:29"/>ባና ያራፐ ማሱላማ፥ ማሉካ፥ አዳያ፥ ያሱባ፥ ሻላነ ይረሞታ።<verse eid="EZR 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZR 10:30"/>ፓሀት-ሞአባ ያራፐ አድና፥ ካላላ፥ ባናያ፥ ማእሰያ፥ ማታና፥ ባስልኤላ፥ ብኑያነ ምናሰ።<verse eid="EZR 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 10:31"/>ካርማ ያራፐ አላዛራ፥ ይሸያ፥ ማልክያ፥ ሻማያ፥ ስሞና፥ <verse eid="EZR 10:31"/><verse number="32" style="v" sid="EZR 10:32"/>ብንያመ፥ ማሉካነ ሳማራያ።<verse eid="EZR 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 10:33"/>ሀሱማ ያራፐ ማታና፥ ማታታ፥ ዛባዳ፥ ኤልፋላፃ፥ የረማያ፥ ምናሰነ ሳመአ።<verse eid="EZR 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="EZR 10:34"/>ባና ያራፐ ማዳያ፥ አምራማ፥ ኡላ፥ <verse eid="EZR 10:34"/><verse number="35" style="v" sid="EZR 10:35"/>ባናያ፥ በዳያ፥ ካልቀ፥ <verse eid="EZR 10:35"/><verse number="36" style="v" sid="EZR 10:36"/>ዋንያ፥ ማረሞታ፥ ኤልያሴባ፥ <verse eid="EZR 10:36"/><verse number="37" style="v" sid="EZR 10:37"/>ማታና ማትናያነ ያእሳ።<verse eid="EZR 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="EZR 10:38"/>ብኑያ ያራፐ ሳማአ፥ <verse eid="EZR 10:38"/><verse number="39" style="v" sid="EZR 10:39"/>ሰለማ፥ ናታና፥ አዳያ፥ <verse eid="EZR 10:39"/><verse number="40" style="v" sid="EZR 10:40"/>ማክናዳባያ፥ ሳሳያ፥ ሳራያ፥ <verse eid="EZR 10:40"/><verse number="41" style="v" sid="EZR 10:41"/>አዛርኤላ፥ ሰለማ፥ ሳማራ፥ <verse eid="EZR 10:41"/><verse number="42" style="v" sid="EZR 10:42"/>ሳሉማ፥ አማረነ ዮሰፋ።<verse eid="EZR 10:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="EZR 10:43"/>ናቦ ያራፐ ይኤላ፥ ማትታ፥ ዛባዳ፥ ዛብና፥ ያዳያ፥ እዩኤላነ ባናያ።<verse eid="EZR 10:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="EZR 10:44"/>ሀ ኡባይ አይሁደ ግዶና ማቸታ ኤክዳይሳታ፤ እሶት እሶት ናአካ የልዶሶና።<verse eid="EZR 10:44"/></para>
  <chapter eid="EZR 10"/>
</usx>
