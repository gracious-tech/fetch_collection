<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2SA" style="id">1SA - GOOFA FULL BIBLE</book>
  <para style="h">2 ሳሜላ ማፃፋ</para>
  <para style="toc1">2 ሳሜላ ማፃፋ</para>
  <para style="toc3">2 ሳሜ</para>
  <para style="toc2">2 ሳሜላ</para>
  <para style="mt">2 ሳሜላ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ናምአን ሳሜላ ማፃፋይ ኮይሮ ሳሜላ ማፃፋ ካሌስ። ሀ ማፃፋይ ዳዊቲ ኮይሮ ዱገሀ ባጋን ደእያ ይሁዳ ካዎ ግድድ (ሸም 1-4)፥ ጉ ጋምእድ፥ ፑደሀ ባጋን ደእያ እስራኤለ ጉጅድ ኩመ ቢታ ካዎ ግድድ ሃርዳ ታርከታ ኦዴስ (ሸም 5-24)። ሀ ማፃፋይ ዳዊቲ ባ ካዎተ ዳልግሳናዉነ ባ ማታ ምንናዉ፥ ሶራነ ካረራ ደእያ ሞርከታራ ኦለትዳ ኦላ ሎይድ ቆንጭሴስ።</para>
  <para style="ip">ዳዊቲ ፆሳ ኬ ኬፃናዉ ኮይስ፥ ሽን እ ሄሳ ኦና መላ ፆሲ ዶስቤና ዎይኮ ኮይቤና (7:1-3)።</para>
  <para style="ip">ፆሲ ዳዊታራ ጫቅዳባ ግድኮካ፥ እ ኦርዮ ማቸ በርሳብራ ላይማትዳ ዎደ እያ ካዎተይነ እያ ሶ አሳይ መቶ ቦላ ዎዶሶና (ሸም 13-18፤ 20-21)። ሄሳ ጋሶን እያ ሶ አሳ ግዶን ኢታባይ መትስ፤ እያ ናይታፐ ዳሮት ሀይቅዶሶና።</para>
  <para style="ip">ዳዊቲ ኦዳ ግታ ኦሶታፐ ጉት፥ እስራኤለ ካዎተ ሀራ ካዎተት ቆሆና መላ ናግስ (1 ሳሜ 31)፤ ታማነ ናምኡ እስራኤለ ኮቻት እስፈ ዳና መላ ኦስ፤ ካዎተ አቆ ዎጋ ዎስ (2 ሳሜ 8:15-18)። ዳዊቲ ባ ዱሳን ናጋር ዎይኮ ቦረይ ባይና አስ ግደና፥ ሽን እስ ቱማ ፆሳፈ አትሽን ሀራ ፆሲ ጎይንቤና። ይሁዳ ካዎተይ ኤቅድ ደእዳ ዎደ ኡባን፥ ፆሳይ ዳዊታስ ጫቅዳ ጫቁዋ ናግስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ዳዊቲ ሳኦላስ ዬሁዋ (<char style="ior"><ref loc="2SA 1:1-27">1:1-27</ref></char>)</para>
  <para style="io1">ዳዊቲ ይሁዳ ቦላ ካዎቱዋ (<char style="ior"><ref loc="2SA 2:1-4:12">2:1—4:12</ref></char>)</para>
  <para style="io1">ዳዊቲ እስራኤለ ኡባ ቦላ ካዎቱዋ (<char style="ior"><ref loc="2SA 5:1-6:23">5:1—6:23</ref></char>)</para>
  <para style="io1">ፆሳይ ዳዊታስ ጫቅዳ ጫቁዋ (<char style="ior"><ref loc="2SA 7:1-29">7:1-29</ref></char>)</para>
  <para style="io1">ዳዊቲ ኦለትዳ ኦላ (<char style="ior"><ref loc="2SA 8:1-10:19">8:1—10:19</ref></char>)</para>
  <para style="io1">ዳዊታነ በርሳቦ (<char style="ior"><ref loc="2SA 11:1-12:31">11:1—12:31</ref></char>)</para>
  <para style="io1">ዳዊታ ሶን መትዳ ጌላተ (<char style="ior"><ref loc="2SA 13:1-14:33">13:1—14:33</ref></char>)</para>
  <para style="io1">አበሰሎመ ጌላተነ ሀራ ሀኖታታ (<char style="ior"><ref loc="2SA 15:1-21:22">15:1—21:22</ref></char>)</para>
  <para style="io1">ናምኡ ዳዊታ ማዝሙረታ (<char style="ior"><ref loc="2SA 22:1-23:7">22:1—23:7</ref></char>)</para>
  <para style="io1">ዳዊታ ቶራ ሞጮናታ (<char style="ior"><ref loc="2SA 23:8-39">23:8-39</ref></char>)</para>
  <para style="io1">ዳዊቲ እስራኤለ አሳ ታይቡዋ (<char style="ior"><ref loc="2SA 24:1-25">24:1-25</ref></char>)</para>
  <chapter number="1" style="c" sid="2SA 1"/>
  <para style="s1">ዳዊቲ ሳኦላ ሀይቁዋ ስእስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1"/>ሳኦል ሀይቅዳፐ ጉየ፥ ዳዊቲ አማለቃታ ፆን ስሚድ ፅቅላጋን ናምኡ ጋላስ ጋምእስ። <verse eid="2SA 1:1"/><verse number="2" style="v" sid="2SA 1:2"/>ሄን ጋላስ እስ አደይ ባ ማኡዋ ዳክድ፥ ባ ሁጰን ባና ቆልድ፥ ሳኦል ዱንካንዳ ጉታፐ ይስ። እ ዳዊታኮ ይድ ሳአን ጉፋንድ ዝግስ። <verse eid="2SA 1:2"/><verse number="3" style="v" sid="2SA 1:3"/>ዳዊቲ፥ “ኔኒ አዋፐ ያዲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 1:3">እ ዛሪድ፥ “ታኒ እስራኤለት ዱንካንዳ ጉታፐ ከሳ ኤካዳ ያስ” ያግስ።<verse eid="2SA 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 1:4"/>ዳዊቲ፥ “አነ ሀንዳባ ታዉ ኦዳ” ያግስ።</para>
  <para style="p" vid="2SA 1:4">እ ዛሪድ፥ “ኑ ኦላንቾት ኦላፐ ባቃትዶሶና፤ ኑ አሳፐ ዳሮት ሀይቅዶሶና፤ ሳኦልነ እያ ናአይ ዮናታን ሀይቅዶሶና” ያግስ።<verse eid="2SA 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 1:5"/>ዳዊቲ እያዉ ኦድዳ ፓን፥ “ሳኦልነ እያ ናኣ ዮናታን ሀይቅዳይሳ ኔኒ አይብን ኤራይ?” ያግድ ኦይችስ።<verse eid="2SA 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 1:6"/>ፓንይ፥ “ታኒ ግልቦአ ደርያ ቦላ ደእሽን፥ ሳኦል ባ ቶራ ጉፈትድ ኤቅዳይሳ በአስ፤ ፓራ ጋረትነ ፓራ አሳት ሳኦላኮ ማታትዶሶና። <verse eid="2SA 1:6"/><verse number="7" style="v" sid="2SA 1:7"/>ሄ ዎደ ሳኦል ጉየ ስሚድ ታና ደምድ ፄግስ። ታኒ፥ ‘ዬ’ ያጋዳ ኮያስ። <verse eid="2SA 1:7"/><verse number="8" style="v" sid="2SA 1:8"/>ሳኦል፥ ‘ኔኒ ኦኔ?’ ያግድ ኦይችን፥ ‘ታኒ አማለቃ አስ’ ያጋዳ ዛራስ። <verse eid="2SA 1:8"/><verse number="9" style="v" sid="2SA 1:9"/>ሄሳፈ ጉየ ሳኦል፥ ‘ታኒ ማዱንፃዳ፥ ሀይቆስ ጋካስ፤ ኔኒ ታ ቦላ ከይያ ኤቃዳ ታና ዎ’ ያግስ። <verse eid="2SA 1:9"/><verse number="10" style="v" sid="2SA 1:10"/>እ ኩንድዳፐ ጉየ ሀይቆፐ አቶናይሳ ኤርዳ ግሾ ታኒ እያ ቦላ ከያ ኤቃዳ እያ ዎስ። እያ ሁጰን ደእያ ካላቻነ እያ ቀሰን ደእያ አምባርያ ኤካዳ ኔኮ ታ ጎዳኮ ያስ” ያግስ።<verse eid="2SA 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 1:11"/>ዳዊቲነ ዳዊታ አሳይ ካዮትድ፥ ባንታ ማኡዋ ዳክዶሶና። <verse eid="2SA 1:11"/><verse number="12" style="v" sid="2SA 1:12"/>ኤንቲ ሳኦል፥ ዮናታን፥ ጎዳ ኦላንቾትነ እስራኤለ አሳይ ኦላን ዉርዳ ግሾ ኦማርስ ጋካናዉ ካዮትዶሶና፤ ዬክዶሶና፤ ፆምዶሶና።<verse eid="2SA 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 1:13"/>ዳዊቲ ሄሳ ኤንታዉ ኤህዳ ፓን፥ “ነ አዉፐ ያዲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 1:13">እ ዛሪድ፥ “ታኒ በተ አስ ግድድ ደእያ አማለቃ አድያ ናአ” ያግስ።<verse eid="2SA 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 1:14"/>ዳዊቲ፥ “ጎዳይ ትይዳ ካዋ ዎናዉ ነ ኩሽያ ደንሸ ዋናዳ ያያብኪ?” ያግስ። <verse eid="2SA 1:14"/><verse number="15" style="v" sid="2SA 1:15"/>ዳዊቲ ባ አሳታፐ እሱዋ ፄግድ፥ “እያ ዎ” ያግን፥ እ አማለቃ ፓን ጫድድ ዎስ። <verse eid="2SA 1:15"/><verse number="16" style="v" sid="2SA 1:16"/>ዳዊቲ አማለቃ አድያኮ፥ “ጎዳይ ትይዳ ካዋ ታኒ ዎስ” ያጋዳ “ኔኒ ነ ዶናን ማርካትዳ ግሾ ነ ሱ ጎመይ ነና ኦይኮ” ያግስ።<verse eid="2SA 1:16"/></para>
  <para style="s1">ዳዊቲ ሳኦላስነ ዮናታናስ ዬክስ</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17"/>ዳዊቲ ሳኦላስነ እያ ናኣ ዮናታናስ ሀይሳዳ ያግድ ዘሌልስ። <verse eid="2SA 1:17"/><verse number="18" style="v" sid="2SA 1:18"/>ይሁዳ አሳይ፥ “ዶንገ ዬሆ” ጌተትያ ሀ ዘለልሳ ታማራና መላ ኪትስ፤ ሀ ዘለልሳይ ያሻራ<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="fq" closed="false">ያሻራ፦ </char><char style="ft" closed="false">ፅሎታ ማፃፋ ጉሱ</char></note> ማፃፋን ፃፈትስ።<verse eid="2SA 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 1:19"/>“ነኖ እስራኤለ፥ ነ ሀላቃት፥</para>
  <para style="q2" vid="2SA 1:19">ቃ በሳን ሀይቅዶሶና።</para>
  <para style="q2" vid="2SA 1:19">ዎልቃማት ዋንድ ኩንድዶና!<verse eid="2SA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 1:20"/>ፍልስፄመ ማጫ ናይት ሄሳ ስእድ ኡፋይቶና መላ፥</para>
  <para style="q2" vid="2SA 1:20">ቃፃረትቦና አሳ ማጫ ናይት ሀሹ ጎና መላ፥</para>
  <para style="q2" vid="2SA 1:20">ሀይሳ ጋተ ካታማን ኦዶፕተ</para>
  <para style="q2" vid="2SA 1:20">አስቃሎና ኦገታን አዋጆፍተ።<verse eid="2SA 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="2SA 1:21"/>ህንተኖ ግልቦአ ደረቶ፥</para>
  <para style="q2" vid="2SA 1:21">ህንተ ቦላ እር ቡኮፎ፤ አክ ዎፎ።</para>
  <para style="q1" vid="2SA 1:21">ሄ በሳን ዎልቃማታ ጎንዳለይ ቱንዳ ግሾ፥</para>
  <para style="q1" vid="2SA 1:21">ሳኦላ ጎንዳለይ ዛይተን ቁሸትቦና ግሾ፥</para>
  <para style="q2" vid="2SA 1:21">ሄ ጋድያን ካ ዶሎፖ።<verse eid="2SA 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 1:22"/>ጎይረትዳይሳታ ሱፈ፥</para>
  <para style="q2" vid="2SA 1:22">ዎልቃማታ ሞዋፈ፥</para>
  <para style="q1" vid="2SA 1:22">ዮናታና ዶንገይ ጉየ ግቤና፤</para>
  <para style="q2" vid="2SA 1:22">ሳኦላ ማሻይ ካሎና ስምቤና።<verse eid="2SA 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 1:23"/>ሳኦልነ ዮናታን ዶሰተይሳታ፤</para>
  <para style="q2" vid="2SA 1:23">ሀይቆንነ ፓፃን ሻከትቦኮና።</para>
  <para style="q1" vid="2SA 1:23">ኤንቲ አርጋንፈ አድ ኤሶ፤</para>
  <para style="q2" vid="2SA 1:23">ጋሞፈ አድ ምኖ።<verse eid="2SA 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 1:24"/>ህንተኖ እስራኤለ ማጫሳዉ፥</para>
  <para style="q2" vid="2SA 1:24">ዞኦነ አሌቆ ማኦ ማይዝዳይሳስ፥</para>
  <para style="q2" vid="2SA 1:24">ህንተ ማኡዋ ዎርቃን አሌቅስዳ ሳኦላስ ዬክተ።<verse eid="2SA 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 1:25"/>ዎልቃማት ኦላን ዋንድ ኩንድዶና?</para>
  <para style="q2" vid="2SA 1:25">ዮናታን ቃ በሳን ሀይቅስ።<verse eid="2SA 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 1:26"/>ታ እሻ ዮናታና፥ ታ ነዉ አዛናይስ፤</para>
  <para style="q2" vid="2SA 1:26">ነ ታዉ ዳሮ አልኦ።</para>
  <para style="q1" vid="2SA 1:26">ኔኒ ታና ዶስያ ዶሶይ ማላልሴስ፤</para>
  <para style="q2" vid="2SA 1:26">ማጫ ሲቆፐካ አስ።<verse eid="2SA 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 1:27"/>ዎልቃማት ዋንድ ኩንድዶና?</para>
  <para style="q2" vid="2SA 1:27">ኦላ ሚሸይካ ዋንድ ይዴ?”</para>
  <para style="m" vid="2SA 1:27">ያግድ ዳዊቲ ዘሌልስ።<verse eid="2SA 1:27"/></para>
  <chapter eid="2SA 1"/>
  <chapter number="2" style="c" sid="2SA 2"/>
  <para style="s1">ዳዊቲ ይሁዳ ቦላ ካዎትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1"/>ሄሳፈ ጉየ፥ ዳዊቲ፥ “ይሁዳ ካታማታፐ እሱዋ ቦ?” ያግድ ጎዳ ኦይችስ።</para>
  <para style="p" vid="2SA 2:1">ጎዳይ፥ “ኤ፥ ባ” ያግስ።</para>
  <para style="p" vid="2SA 2:1">ዳዊቲ፥ “አዉ ቦ” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 2:1">ጎዳይ፥ “ከብሮና ባ” ያግድ ዛርስ።<verse eid="2SA 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 2:2"/>ዳዊቲ ባ ናምኡ ማቸታ፥ እዝራኤለ አክናሆማነ ካሰ ናባላ ማችዉ ቃርመሎሳ አብግያ ኤክድ ከብሮና ካታማ ብስ። <verse eid="2SA 2:2"/><verse number="3" style="v" sid="2SA 2:3"/>ዳዊቲ ባራ ደእያ አሳታነ ኤንታ ሶ አሳ ኡባ ኤህን፥ ከብሮናንነ እያ ሄራን ደእያ ካታማታን ደእዶሶና። <verse eid="2SA 2:3"/><verse number="4" style="v" sid="2SA 2:4"/>ይሁዳ አሳት ከብሮና ካታማ ይድ፥ ዳዊታ ትይድ ይሁዳ ቦላ ካዎዶሶና።</para>
  <para style="p" vid="2SA 2:4">ዳዊቲ ያበሳ ጋላዳ አሳይ ሳኦላ ሞግዳይሳ ስእዳ ዎደ፥ <verse eid="2SA 2:4"/><verse number="5" style="v" sid="2SA 2:5"/>እ አሰ ኪትድ፥ “ህንተ ህንተ ጎዳ ሳኦላ ሞግዳ ግሾ ሄ ኬሀተስ ጎዳይ ህንተና አንጆ። <verse eid="2SA 2:5"/><verse number="6" style="v" sid="2SA 2:6"/>ጎዳይ ሲቁዋነ ቱማተ ህንተዉ ቆንጭሶ፤ ታንካ ሀ ኬሀተ ግሾ ህንተዉ ሎኦ ኩሸ ዛራና። <verse eid="2SA 2:6"/><verse number="7" style="v" sid="2SA 2:7"/>ህዛ ምንተ፤ ፃልተ፤ ህንተ ጎዳይ ሳኦል ሀይቅስ። ይሁዳ አሳይ ታና ትይድ፥ ባንታ ቦላ ካዎዶሶና” ያግስ።<verse eid="2SA 2:7"/></para>
  <para style="s1">ናምኡ ኬታ ግዶን ደእያ ኦላ</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8"/>ሳኦላ ቶራ ሞጮናይ ኔራ ናአይ አበኔር ሳኦላ ናኣ እያቡስተ ኤክድ፥ ማህናይማ ጌተትያ በሳ ኤፍስ። <verse eid="2SA 2:8"/><verse number="9" style="v" sid="2SA 2:9"/>እያ ጋላዳን፥ አሴራን፥ እዝራኤላን፥ ኤፍሬማን፥ ብንያመንነ እስራኤለ ቢታ ኡባን ካዎስ። <verse eid="2SA 2:9"/><verse number="10" style="v" sid="2SA 2:10"/>ሳኦላ ናአይ፥ እያቡስተይ እስራኤለ ቦላ ካዎትያ ዎደ እያዉ ኦይታሙ ላይ፤ እ ናምኡ ላይ ካዎትስ። ግዶሽን፥ ይሁዳ አሳይ ዳዊታ ካልዶሶና። <verse eid="2SA 2:10"/><verse number="11" style="v" sid="2SA 2:11"/>ዳዊቲ ከብሮናን ይሁዳ ቦላ ላፑን ላይነ ባጋ ካዎትስ።<verse eid="2SA 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12"/>ኔራ ናአይ አበኔርነ ሳኦላ ናአይ እያቡስተ አሳይ ማህናይማፐ ጋባኦና ብዶሶና። <verse eid="2SA 2:12"/><verse number="13" style="v" sid="2SA 2:13"/>ፃሩያ ናአይ እዮኣብነ ዳዊታ አሳይ ጋባኦና ኦላ ሃ ማታን ኤንታራ ጋሄትዶሶና። እስ ጩጋይ ኦላ ሃፈ ሄፍንን ኡትን፥ እስ ጩጋይ ሀፍንን ኡትስ። <verse eid="2SA 2:13"/><verse number="14" style="v" sid="2SA 2:14"/>አበኔር እዮኣባኮ፥ “አነ ህንተፈነ ኑፐ ፓንት ደንድድ፥ ኑ ስንን ኦለቶ” ያግስ።</para>
  <para style="p" vid="2SA 2:14">እዮኣብ፥ “ኤሮ፥ ደንድድ ኦለቶ” ያግስ። <verse eid="2SA 2:14"/><verse number="15" style="v" sid="2SA 2:15"/>ሄሳ ግሾ፥ ብንያመፐ ሳኦላ ናኣ እያቡስተስ ታማነ ናምኡ አሳት ከይድ፥ ዳዊታስ ኤቅዳ ታማነ ናምኡ አሳታራ ኦላ ጋሄትዶሶና። <verse eid="2SA 2:15"/><verse number="16" style="v" sid="2SA 2:16"/>እሶይ እሶይ ባ ሞርክያ ሁጵያ ኦይክድ፥ ማሻን ምየን ጫድስ፤ ሄሳዳ ሀንድ ላታማነ ኦይዳይ ሀይቅዶሶና። ሄሳ ግሾ ጋባኦናን ደእያ ሄ በሳይ ማሻ ቢታ ጌተትስ። <verse eid="2SA 2:16"/><verse number="17" style="v" sid="2SA 2:17"/>ሄ ጋላስ ዎልቃማ ኦላ ኦለትድ፥ ዳዊታ አሳይ አበኔራነ እስራኤለ አሳ ፆንስ።<verse eid="2SA 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 2:18"/>ፃሩያ ናይት ሄይ እዮኣብ፥ አብስነ አሳሄል ሄ በሳን ደኦሶና፤ አሳሄል ዎሽኤዳ ኤሶን ዎፅድ፥ <verse eid="2SA 2:18"/><verse number="19" style="v" sid="2SA 2:19"/>አሳሄል አበኔራ ኡሻች ዎይኮ ሀድርስ ጎና የደስ። <verse eid="2SA 2:19"/><verse number="20" style="v" sid="2SA 2:20"/>አበኔር ጉየ ስሚድ፥ “አሳሄላ፥ ነኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 2:20">አሳሄል፥ “ኤ ታና” ያግስ።<verse eid="2SA 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 2:21"/>አበኔር፥ “ኡሻች ዎይኮ ሀድርስ ስማዳ፥ አሳታፐ እሱዋ ኦይካዳ እያ ኦላ ሚሽያ ኤካ” ያግስ። ሽን አሳሄል እያ የደይሳ አጎና እፅስ።<verse eid="2SA 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 2:22"/>ቃስካ አበኔር፥ “ታኒ ነና ሳአራ ጋዳ ኦይና ደእሽን፥ ታና የደይሳ አጋ! ነና ዎዳ ታኒ ነ እሻ እዮኣባ ሶምኡዋ ዋታዳ ፄላኔ?” ያግድ ዋስስ። <verse eid="2SA 2:22"/><verse number="23" style="v" sid="2SA 2:23"/>ሽን አሳሄል እያ የደይሳ አጎና እፅስ። ሄሳ ግሾ፥ አበኔር ቶራ ጉየ የድድ፥ አሳሄላ ኡሉዋ ጫድን ቶራይ ዞኮራ ካንድ ከይስ። አሳሄል ሄ በሳን ኩንድድ ሀይቅስ፤ አሳሄል ሀይቅዳ በሳ ጋክዳ አሳ ኡባይ ያን ኤቅስ።<verse eid="2SA 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24"/>ሽን እዮኣብነ አብስ አበኔራ ጎድዶሶና፤ አው ዉልያ ዎደ ጋባኦና መላ ቢታኮ ኤፍያ ኦግያን ጋዳፐ ስን ባጋራ ደእያ አማ ዙማኮ ጋክዶሶና። <verse eid="2SA 2:24"/><verse number="25" style="v" sid="2SA 2:25"/>ብንያመ አሳይ አበኔራኮ ሺቅዶሶና፤ እስ ጩጋ መድ እስ ዙማ ቦላ ኤቅዶሶና። <verse eid="2SA 2:25"/><verse number="26" style="v" sid="2SA 2:26"/>አበኔር እዮኣባ ፄግድ፥ “መርናዉ ኦለትሸ ዳነዬ? ሀይሳ ዉርሰይ ጫሞ ግዳናይሳ ኔኒ ኤርኪ? ነ አሳይ፥ ባንታ እሻታ ጎደይሳ አጋና መላ አይስ ኦድኪ?” ያግስ።<verse eid="2SA 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 2:27"/>እዮኣብ፥ “ደኦ ፆሳይ ኤሮ! ኔኒ ኦዶናባ ግድያኮ ታ አሳይ ባ እሻታ ሳእ ዎንታና ጋካናዉ ጎዳ አጎኮና” ያግስ። <verse eid="2SA 2:27"/><verse number="28" style="v" sid="2SA 2:28"/>እዮኣብ ሞይዘ ፑንን አሳ ኡባይ ኤስስ። እስራኤለታ ዛር ጎድቦኮና ዎይኮ ኦልቦኮና። <verse eid="2SA 2:28"/><verse number="29" style="v" sid="2SA 2:29"/>አበኔርነ እያ አሳይ ሄ ቃማ ኩመ ሄመትድ አራባ ጋ ጋክዶሶና። ዮርዳኖሰ ሻፋ ፕንድ፥ በትሮና ካንድ ማህናይመ ይዶሶና።<verse eid="2SA 2:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30"/>እዮኣብ አበኔራ ጎደይሳ አግድ፥ ባ አሳ ኡባ እስ በሲ ሺሽድ ፄልያ ዎደ፥ አሳሄላ ጉጆና ዳዊታ አሳፐ ታማነ ኡዱፉን አስ ፓጭስ። <verse eid="2SA 2:30"/><verse number="31" style="v" sid="2SA 2:31"/>ሽን ዳዊታ አሳይ አበኔራራ ደእያ ብንያመ ኮቻታፐ ሄ ፄታነ ኡሱፑን ታሙ አስ ዎዶሶና። <verse eid="2SA 2:31"/><verse number="32" style="v" sid="2SA 2:32"/>አሳሄላ አሀ ኤክድ፥ ቤተለመ ካታማን ደእያ እያ አዋ ዱፎን ሞግዶሶና። እዮኣብነ እያ አሳይ ቃማ ኩመ ሄመትድ ሳእ ዎንትያ ዎደ ከብሮና ጋክዶሶና።<verse eid="2SA 2:32"/></para>
  <chapter eid="2SA 2"/>
  <chapter number="3" style="c" sid="2SA 3"/>
  <para style="p">
    <verse number="1" style="v" sid="2SA 3:1"/>ሳኦላ ሶ አሳይነ ዳዊታ አሳይ ዳሮ ዎደ ኦለትዶሶና፤ ዳዊቲ ኦላን ምን ምን ብያ ዎደ ሳኦላ አሳይ ዳቡር ዳቡር ብስ።<verse eid="2SA 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 3:2"/>ከብሮናን ዳዊታስ ናይት የለትዶሶና፤ እዝራኤለ አክናሆማ የልዳ ባይራ ናአይ አምኖና፤ <verse eid="2SA 3:2"/><verse number="3" style="v" sid="2SA 3:3"/>ቃርመሎሳ አብግያ ካሰ ናባላ ማችያ የልዳ ክልኣብ ናምአን ናአ። ጋሹራ ካዋ ታልማያ ናእያ ማእካ የልዳ አበሰሎመይ ሄን ናአ። <verse eid="2SA 3:3"/><verse number="4" style="v" sid="2SA 3:4"/>ኦይዳንይ ሃግታ ናኣ አዶና፤ እቻሻንይ አብፃላ ናኣ ሳፋፃ። <verse eid="2SA 3:4"/><verse number="5" style="v" sid="2SA 3:5"/>ኡሱፑንይ ዳዊታ ማቸ ኤግል ናኣ ይትራኣማ፤ ሀ ናይት ኡባይ ከብሮናን የለትዶሶና።<verse eid="2SA 3:5"/></para>
  <para style="s1">አበኔር ዳዊታራ ጫቅስ</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6"/>ሳኦላ ሶ አሳራነ ዳዊታ ሶ አሳራ ኦለትያ ዎደ አበኔር ሳኦላ አሳ ቦላ ምን ምን ብስ። <verse eid="2SA 3:6"/><verse number="7" style="v" sid="2SA 3:7"/>ሳኦላስ እዮሄላ ናአ ግድዳ እርፅፎ ጌተትያ እስ ላገያ ደአዉሱ፤ እያቡስተይ አበኔራኮ፥ “ታ አዋ ላገራ አይስ አቃዲ?” ያግድ ኦይችስ።<verse eid="2SA 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 3:8"/>አበኔር እያ ኦዳን ዳሮ ይሎትድ፥ “ታና ኔኒ ይሁዳኮ ስምዳ ጋታ ካና ጋድዬ? ታኒ ነ አዋ ሳኦላስ፥ እያ እሻታስነ እያ ዳቦታስ አማነታዳ ደአስ፤ ነናካ ዳዊታስ አዳ እማብከ። ሽን ሀእ ኔኒ ታና ሀ ማጫሰ ግሾ ሞታሳ! <verse eid="2SA 3:8"/><verse number="9" style="v" sid="2SA 3:9"/>ፆሳይ ዳዊታስ ኦና ግድ ጫቅዳ ቃላ ታኒ ፖሎና እፅኮ፥ ፆሲ ታና ፕርዶ። <verse eid="2SA 3:9"/><verse number="10" style="v" sid="2SA 3:10"/>ሳኦላ ኮቻፈ ካዎተ ዎስስድ፥ ዳነፐ በርሳበ ጋካናዉ እስራኤለ ቦላነ ይሁዳ ቦላ፥ ዳዊታ አራታ ምንናዉ ጎዳይ ጫቅስ” ያግስ። <verse eid="2SA 3:10"/><verse number="11" style="v" sid="2SA 3:11"/>እያቡስተይ አበኔራስ ያይዳ ግሾ ሀራ ቃላ ፖግቤና።<verse eid="2SA 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12"/>አበኔር ዳዊታኮ፥ “ቢታይ ኦሴ? ኔኒ ታራ ጫቃ፤ እስራኤለ አሳ ኡባይ ኔኮ ስማና መላ ታ ነና ማዳና” ያግድ አሰ ኪትስ።<verse eid="2SA 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 3:13"/>ዳዊቲ፥ “ሎኦ! ታ ኔራ ጫቃና። ሽን ታኒ ነና እስባ ኦይቻይስ፤ ኔኒ ታና በአናዉ ያ ዎደ ሳኦላ ናእዉ መልኮሎ ኤኮና ዮፓ” ያግስ። <verse eid="2SA 3:13"/><verse number="14" style="v" sid="2SA 3:14"/>ሄሳፈ ጉየ፥ ዳዊቲ ሳኦላ ናአ እያቡስተኮ፥ “ፄቱ ፍልስፄመታ ቃራታዳ ኮይታ ኦዳ እምዳ ታ ማችዉ መልኮሎ ታዉ እማ” ያግድ አሰ ኪትስ። <verse eid="2SA 3:14"/><verse number="15" style="v" sid="2SA 3:15"/>እያቡስተይ አሰ ኪትድ እ አዝና ላዉሻ ናአ ፓልፅኤላፐ ከስ ኤክስ። <verse eid="2SA 3:15"/><verse number="16" style="v" sid="2SA 3:16"/>እ አዝናይ ብራቅማ ካታማ ጋካናዉ ዬክሸ እ ጌዶ ካልስ። አበኔር እያኮ፥ “ጉየ ሶ ባ” ያግን አደይ ጉየ ስሚድ ብስ።<verse eid="2SA 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 3:17"/>አበኔር እስራኤለ ጭማታኮ ብድ፥ “ዳዊቲ ህንተ ቦላ ካዎታና መላ ዳሮ ዎደ አሞትደታ። <verse eid="2SA 3:17"/><verse number="18" style="v" sid="2SA 3:18"/>ሀእ ፖልተ! ጎዳይ፥ ‘ታ አሳ እስራኤለ፥ ፍልስፄመታ ኩሸፐነ ኤንታ ሞርከታ ኡባ ኩሸፐ ታ አይልያ ዳዊታ ባጋራ አሻና’ ግዳይሳ ሀሳይተ” ያግስ። <verse eid="2SA 3:18"/><verse number="19" style="v" sid="2SA 3:19"/>አበኔር ብንያመ ኮቻታስ ሄሳ ኦድስ። እስራኤለ አሳይነ ብንያመ አሳ ኡባይ ኦናዉ ኮይዳ ኡባ ዳዊታስ ኦዳናዉ አበኔር ከብሮና ብስ።<verse eid="2SA 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 3:20"/>አበኔር ባራ ላታሙ አስ ኤክድ፥ ከብሮና ብን፥ ዳዊቲ እያዉነ እያ አሳስ ግብራ ጊግስስ። <verse eid="2SA 3:20"/><verse number="21" style="v" sid="2SA 3:21"/>አበኔር ዳዊታኮ፥ “ኤንቲ ኔራ ጫቃና መላነ ነ ዎዛናይ አሞትያ ኡባ ነ ሃራና መላ ታ ባዳ እስራኤለ አሳ ካዋስ ታ ጎዳስ ሺሻና” ያግስ። ያግን ዳዊቲ አበኔራ ሞይዝድ ሳሮ የድስ።<verse eid="2SA 3:21"/></para>
  <para style="s1">እዮኣብ አበኔራ ዎስ</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22"/>ሄ ዎደ ዳዊታ አሳይነ እዮኣብ ኦላፐ ዳሮባ ድእድ ስምዶሶና። ሽን ዳዊቲ እያ ሳሮ ባ ግድ የድዳ ግሾ፥ አበኔር ከብሮናን ዳዊታራ ዴና። <verse eid="2SA 3:22"/><verse number="23" style="v" sid="2SA 3:23"/>እዮኣብነ እያራ ደእያ ኦላንቾት ጋክያ ዎደ አሳይ፥ “ኔራ ናኣ አበኔር ካዋ ዳዊታኮ ይን፥ ካዎይ እያ የድን ሳሮ ብስ” ያግድ ኦድዶሶና።<verse eid="2SA 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 3:24"/>ሄሳ ግሾ፥ እዮኣብ ካዋኮ ብድ፥ “ሄስ ዋንድ ሀንዴ? አበኔር ኔኮ ይን፥ አይስ የዳዲ? ሄኮ እ ብክችስ! <verse eid="2SA 3:24"/><verse number="25" style="v" sid="2SA 3:25"/>ኔራ ናአይ አበኔር ነና ጭማናዉ፥ ኔኒ ገልያሶነ ከያሶ በአናዉነ ኔኒ ኦያ ኡባ ኤራናዉ ይስ” ያግስ።<verse eid="2SA 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26"/>እዮኣብ ዳዊታ ስንፈ ከይድ፥ አበኔራ ጌዶ ኪታ የድን፥ ኤንቲ እያ ሲራ ኦላ ሃ ማታፐ ጉየ ዛርዶሶና፤ ሽን ዳዊቲ ሄሳ ኤረና። <verse eid="2SA 3:26"/><verse number="27" style="v" sid="2SA 3:27"/>አበኔር ከብሮና ስሚድ ይዳ ዎደ እዮኣብ እያራ ዱማ ኦደታናዉ ኮይዳ ዳንስድ ድርሳ ፐንግያኮ ደእያ ክፍልያነ እያ ኤፍስ። ባ እሻ አሳሄላ ሱ ዛራናዉ አበኔራ ኡሎን ጫድን አበኔር ሄ በሳን ሀይቅስ።<verse eid="2SA 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 3:28"/>ዳዊቲ ጉየፐ ሄሳ ስእዳ ዎደ፥ “ታንነ ታ ካዎተይ ኔራ ናኣ አበኔራ ሱ ግሾ ጎዳ ስንን መርናዉ ኦይሸቶኮ። <verse eid="2SA 3:28"/><verse number="29" style="v" sid="2SA 3:29"/>እያ ሱይ እዮኣባነ እያ አዋ ሶ አሳ አቾ፤ ማዱን ደእያ አስ ዎይኮ ጎጋ ሀርገይ ደእያ አስ ዎይኮ ዎበ አስ ዎይኮ ማሻን ሀይቅያ አስ ዎይኮ ኮሻትያ አስ እዮኣባ ኮቻን ዮፖ” ያግስ። <verse eid="2SA 3:29"/><verse number="30" style="v" sid="2SA 3:30"/>ጋባኦናን ከይዳ ኦላን ባንታ እሻ አሳሄላ አበኔር ዎዳ ግሾ፥ እዮኣብነ እያ እሻ አብስ አበኔራ ዎዶሶና።<verse eid="2SA 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31"/>ዳዊቲ እዮኣባነ እያራ ደእያ አሳ፥ “ህንተ ማኡዋ ዳክተ፤ ባና ቆልተ፤ አበኔራ ሀላ ስንን ዬክተ” ያግስ። ካዎ ዳዊቲ ሀላ ካልድ ዱፎ ብስ። <verse eid="2SA 3:31"/><verse number="32" style="v" sid="2SA 3:32"/>አበኔር ከብሮናን ሞገትስ፤ ካዎይ ባ ቃላ ቁ ኦድ ዱፎን ዬክስ፤ አሳ ኡባይ ዬክዶሶና። <verse eid="2SA 3:32"/><verse number="33" style="v" sid="2SA 3:33"/>ካዎይ አበኔራስ፥</para>
  <para style="q1" vid="2SA 3:33">“አበኔር ኤያ አሳዳ ሀይቃናዉ በሲ?<verse eid="2SA 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 3:34"/>ነ ኩሸይ ቃሸትቤና፤</para>
  <para style="q2" vid="2SA 3:34">ነ ቶሆይ ሳንላታን ኦይከትቤና።</para>
  <para style="q1" vid="2SA 3:34">አስ ኢታ አሳ ኩሸን ሀይቀይሳዳ ሀይቅስ”</para>
  <para style="m" vid="2SA 3:34">ያግድ ዘሌልስ። አሳ ኡባይ አበኔራስ ዛሪድ ዬክዶሶና።<verse eid="2SA 3:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 3:35"/>ሄ ጋላስ ዳዊቲ ካ ማና መላ አሳይ እያ ሾቢዶሶና። ሽን ዳዊቲ፥ “አዋ አይፈይ ደእሽን፥ ካ ዎይኮ ሀራባ ባርኮ ፆሲ ታና ፕርዶ” ያግድ ጫቅስ። <verse eid="2SA 3:35"/><verse number="36" style="v" sid="2SA 3:36"/>ካዎይ ኦዳባ አሳ ኡባይ በእድ ኡፋይትዶሶና፤ ቱማካ ካዎይ ኦዳባ ኡባይ አሳ ኡፋይስስ። <verse eid="2SA 3:36"/><verse number="37" style="v" sid="2SA 3:37"/>ሄሳ ግሾ፥ ሄ ጋላስ ዳዊታ አሳይነ እስራኤለ አሳ ኡባይ ካዎይ ኔራ ናኣ አበኔራ ዎስቦናይሳ ኤርዶሶና።<verse eid="2SA 3:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 3:38"/>ካዎይ ባ አይለታኮ፥ “እስራኤለ ቢታን ግታ አስነ ሀላቅ ሀይቅዳይሳ ህንተ አኬከከቲ? <verse eid="2SA 3:38"/><verse number="39" style="v" sid="2SA 3:39"/>ታኒ ፆሳይ ትይዳ ካዎ ግድኮካ፥ ታኒ ዳቡራንቾ፤ ሀይሳቲ ፃሩያ ናይት ታ ቦላ ምንዶሶና፤ ኢታ ኦዳይሳታስ ጎዳይ ኤንታ ኦሱዋዳ ዛሮ” ያግስ።<verse eid="2SA 3:39"/></para>
  <chapter eid="2SA 3"/>
  <chapter number="4" style="c" sid="2SA 4"/>
  <para style="s1">እያቡስተ ሀይቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1"/>ሳኦላ ናአይ እያቡስተይ አበኔር ከብሮናን ሀይቅዳይሳ ስእዳ ዎደ እያ ዎዛናይ ትልእስ፤ እስራኤለ አሳ ኡባይካ ዳጋምስ። <verse eid="2SA 4:1"/><verse number="2" style="v" sid="2SA 4:2"/>ሳኦላ ናኣ እያቡስተስ ኦላ ካለያ ናምኡ ሀላቃት ደኦሶና፤ እሱዋ ሱንይ ባአና፤ ሀንኮይ ቃስ ራካባ። ኤንቲ ብንያመ ኮቸ ግድዳ ባኣሮተ አድያ እርሞና ናይታ። ባኣሮተይ ብንያመ ባጋዳ ታይበቴስ። <verse eid="2SA 4:2"/><verse number="3" style="v" sid="2SA 4:3"/>ባኣሮታን ደእዳ ኮይሮ አሳት ግታይማ ቢታ ባቃትድ፥ ሀች ጋካናዉ በተ አሳዳ ያን ደእዶሶና።<verse eid="2SA 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4"/>ሳኦላ ናኣ ዮናታናስ ናምኡ ቶሆይ ስልዳ ናእ ደኤስ፤ ሳኦላነ ዮናታና ሀይቁዋ ዎረይ እዝራኤለፐ ስኤትያ ዎደ እ እቻሹ ላይ ናአ። ሄ ናኣ ድችያራ እያ ኤካዳ ባቃትሽን ናአይ ኩንድን እያ ቶሆይ ስልስ፤ ሄ ናኣ ሱንይ መምፕቦስተ።<verse eid="2SA 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 4:5"/>ባኣሮተ አድያ እርሞና ናይት ረካብነ ባኣን እያቡስተ ሶ ብድ ሴታ ጋላስ ጋክዶሶና። ኤንቲ ጋክያ ዎደ እ ሸምፓናዉ አልጋ ቦላ ዝንእስ። <verse eid="2SA 4:5"/><verse number="6" style="v" sid="2SA 4:6"/>ኤንቲ ግስተ ኮይያ አሳዳ ሀንድ ሶ ገልድ፥ እያ ኡሉዋን ጫድዶሶና። ረካብነ እያ እሻ ባኣን ለፓራ ከይድ ብዶሶና።<verse eid="2SA 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 4:7"/>እያቡስተይ ቆልአን አርሳን ዝንእዳይሳ ደምድ፥ እያዉ ኡሉዋን ጫድድ ዎዶሶና፤ እያ ሁጵያ ቃንፅ ኤክድ፥ አራባ ጋ ኤፍያ ኦግያ ኦይክድ፥ ቃማራ ብዶሶና። <verse eid="2SA 4:7"/><verse number="8" style="v" sid="2SA 4:8"/>እያቡስተ ሁጵያ ከብሮናን ደእያ ዳዊታስ ኤህዶሶና። ካዋ፥ “ነና ዎናዉ ኮይያ ነ ሞርክያ ሳኦላ ናኣ እያቡስተ ሁጵያ ሀይሳ በአ። ሳኦላ ቦላነ እያ ናይታ ቦላ ካዋ ኑ ጎዳ ግሾ ፆሳይ ሀች ሀሎ ከይስ” ያግዶሶና።<verse eid="2SA 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9"/>ሽን ባኣሮተ አድያ እርሞና ናይታ ረካባነ እያ እሻ ባአና ዳዊቲ ሀይሳዳ ያግስ፤ “መቶ ኡባፈ ታና አሽዳ ደኦ ጎዳይ ኤርያ መላ። <verse eid="2SA 4:9"/><verse number="10" style="v" sid="2SA 4:10"/>ታዉ ምሽራቾ ኦድያ አሳዳ፥ ‘ሳኦል ሀይቅስ’ ያግድ ታዉ ኦድን፥ ታኒ እያ ፅቅላጋን ኦይካዳ ዎስ፤ ታኒ እያ ምሽራቹዋስ እምዳ ዎይቶይ ሀይሳ። <verse eid="2SA 4:10"/><verse number="11" style="v" sid="2SA 4:11"/>ባ ሶን ባ አርሳን ዝንእዳ ፅሎ አድያ ዎዳ ኢታ አሳታስ እያ ሃሉዋ ከየይስ አይ መላ ኢታንደሻ! እያ ሱ ታኒ ህንተ ኩሸፐ አቻና፤ ህንተና ታኒ ቢታ ቦላፈ ይሳና!” ያግስ።<verse eid="2SA 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 4:12"/>ረካባነ ባአና ዎና መላ ዳዊቲ ባ ኦላንቾታ ኪትን፥ ኦላንቾት ኤንታ ዎዶሶና። ኤንታ ኩሽያነ ቶሁዋ ቃንፅድ፥ ከብሮናን ኦላ ሃ ማታን ካቅዶሶና። እያቡስተ ሁጵያ ኤፍድ፥ አበኔራ ዱፎን ከብሮናን ሞግዶሶና።<verse eid="2SA 4:12"/></para>
  <chapter eid="2SA 4"/>
  <chapter number="5" style="c" sid="2SA 5"/>
  <para style="s1">ዳዊቲ እስራኤለ ቦላ ካዎትስ</para>
  <para style="r">(<ref loc="1CH 11:1-9">1 ታር 11:1-9</ref>፤ <ref loc="1CH 14:1-7">14:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1"/>እስራኤለ ዛረ ኡባይ ዳዊታኮ ከብሮና ይድ፥ “ኑኒ ነ አሾነ ነ ሱ። <verse eid="2SA 5:1"/><verse number="2" style="v" sid="2SA 5:2"/>ካሰ ሳኦል ኑስ ካዎ ግድድ ደእያ ዎደካ እስራኤለ አሳ ኦላስ ካለዳይ ነና። ጎዳይ ነና፥ ‘ኔኒ ታ አሳ እስራኤለ ሄማና፤ ኤንታ ቦላ ካዎታና’ ያግድ ቃላ ገልስ” ያግዶሶና። <verse eid="2SA 5:2"/><verse number="3" style="v" sid="2SA 5:3"/>እስራኤለ ጭማት ኡባይ ካዋ ዳዊታኮ ከብሮና ይዶሶና፤ እ ኤንታራ ከብሮናን ጎዳ ስንን ጫቅስ፤ እስራኤለ ቦላ ካዎታና መላ ዳዊታ ትይዶሶና።<verse eid="2SA 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 5:4"/>ዳዊቲ ካዎትያ ዎደ እያዉ ሀስታሙ ላይ፤ እ ኦይታሙ ላይ ካዎትስ። <verse eid="2SA 5:4"/><verse number="5" style="v" sid="2SA 5:5"/>ከብሮናን ይሁዳ ቦላ ላፑን ላይነ ኡሱፑን አጌና ካዎትስ፤ የሩሳላመን እስራኤለ ቦላነ ይሁዳ ቦላ ሀስታማነ ሄ ላይ ካዎትስ።<verse eid="2SA 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6"/>የሩሳላመን ደእያ ያቡሰ አሳ ኦላናዉ ዳዊቲነ እያ አሳይ ብዶሶና። ያቡሰ አሳይ፥ “ዳዊቲ ሀ ካታማ ገላናዉ ዳንዳኤና” ግድ ቆፕዳ ግሾ ሀር አቶሽን፥ “ቆቀትነ ዎበት ነና ተቃናዉ ዳንዳኦሶና፤ ነ ሀ ካታማ ገላካ” ያግዶሶና። <verse eid="2SA 5:6"/><verse number="7" style="v" sid="2SA 5:7"/>ግዶሽን፥ ዳዊቲ ፅዮነን ደእያ ኤንታ ሚፃ ኦይክን፥ እያ ዳዊታ ካታማ ግዳሱ።<verse eid="2SA 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 5:8"/>ሄ ጋላስ ዳዊቲ፥ “ያቡሰ አሳ ኦልድ ኦይክያ ኦንካ ዳዊታ ሞርከ ግድዳ ዎበትነ ቆቀት ደእያ በሳ ጋካናዉ ሻፋራ ፑደ ከያናዉ ኮሼስ” ያግስ። ሄሳ ግሾ፥ “ቆቀትነ ዎበት ጋ ገሎኮና” ጌተትስ። <verse eid="2SA 5:8"/><verse number="9" style="v" sid="2SA 5:9"/>ዳዊቲ ሄ ሚፃ ኦይክድ፥ ያን ደእስ፤ ሄ ሚፃ ዳዊታ ካታማ ያግድ ሱንስ። ዳዊቲ ሚሎፐ ዶምድ ሄ ካታማ ዩሽድ ግምብስ። <verse eid="2SA 5:9"/><verse number="10" style="v" sid="2SA 5:10"/>ኡባፈ ዎልቃማ ጎዳይ ፆሳይ እያራ ደእያ ግሾ ዳዊቲ ምን ምን ብስ።<verse eid="2SA 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 5:11"/>ፅሮሳ ካዎይ ክራም ዳዊታስ ካዎ ጋ ኬፃና መላ ዝጋ ም፥ አናፀታነ ሹቹ ማሰይሳታ የድን፥ ኤንቲ እያዉ ኬ ኬፅዶሶና። <verse eid="2SA 5:11"/><verse number="12" style="v" sid="2SA 5:12"/>ጎዳይ እስራኤለ ቦላ እያ ካዎ ኦድ ምንዳይሳነ ባ አሳ እስራኤለ ግሾ እያ ካዎተ ቁ ኦድ ቦንችዳይሳ ዳዊቲ ኤርስ።<verse eid="2SA 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13"/>ዳዊቲ ከብሮናፐ የሩሳላመ ይዳፐ ጉየ፥ ሀራ ላገታነ ማቸታ ጉጅድ ኤክን፥ ሀራ ማጫ ናይትነ አደ ናይት እያዉ የለትዶሶና። <verse eid="2SA 5:13"/><verse number="14" style="v" sid="2SA 5:14"/>የሩሳላመን እያዉ የለትዳ አደ ናይታ ሱንይ ሳሙአ፥ ሾባባ፥ ናታና፥ ሶሎሞነ፥ <verse eid="2SA 5:14"/><verse number="15" style="v" sid="2SA 5:15"/>ይብሃራ፥ ኤልሹአ፥ ነፈጋ፥ ያፍአ፥ <verse eid="2SA 5:15"/><verse number="16" style="v" sid="2SA 5:16"/>ኤልሻማአ፥ ኤልያዳነ ኤልፋላፃ።<verse eid="2SA 5:16"/></para>
  <para style="s1">ዳዊቲ ፍልስፄመታ ፆንስ</para>
  <para style="r">(<ref loc="1CH 14:8-17">1 ታር 14:8-17</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17"/>ዳዊቲ እስራኤለ ቦላ ካዎ ግድድ ትየትዳይሳ ፍልስፄመት ስእዳ ዎደ ኤንቲ ኡባይ ዳዊታ ኮያናዉ ከይዶሶና፤ ሽን ዳዊቲ ሄሳ ስእድ ሚፃን ብድ ገልስ። <verse eid="2SA 5:17"/><verse number="18" style="v" sid="2SA 5:18"/>ፍልስፄመት ብድ፥ ራፋይመ ዛንጋራን ላለትድ ኡትዶሶና። <verse eid="2SA 5:18"/><verse number="19" style="v" sid="2SA 5:19"/>ሄሳ ግሾ፥ ዳዊቲ፥ “ታኒ ባዳ ፍልስፄመታ ኦሎ? ኔኒ ኤንታ ታዉ አዳ እማኔ?” ያግድ ጎዳ ኦይችስ።</para>
  <para style="p" vid="2SA 5:19">ጎዳይ፥ “ኤ ኦላ፤ ቱማ ታ ኤንታ ነዉ አዳ እማና” ያግስ።<verse eid="2SA 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 5:20"/>ዳዊቲ ባአል-ፓራስመ ጌተትያ በሳ ብድ፥ ያን ኤንታ ፆንስ። እ፥ “ድኦ ሃ መንድ ከየይሳዳ ጎዳይ ታ ሞርከታ ታ ስንን መንረስ” ያግስ። ሄሳ ግሾ፥ ሄ በሳ ሱንይ ባአል-ፓራስመ<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="fq" closed="false">ባአል-ፓራስመ፦ </char><char style="ft" closed="false">ሀ ሱን ብርሸይ “መንድ ገልዳ ጎዳ” ጉሱ።</char></note> ጌተትስ። <verse eid="2SA 5:20"/><verse number="21" style="v" sid="2SA 5:21"/>ፍልስፄመት ባንታ ኤቃታ ሄ በሳን የግድ ብን፥ ዳዊቲነ እያ አሳይ ሄ ኤቃታ ኤክድ ብዶሶና።<verse eid="2SA 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 5:22"/>ፍልስፄመት ጉየ ብድ፥ ናምአን ራፋይመ ዛንጋራን ላለትድ ኡትዶሶና። <verse eid="2SA 5:22"/><verse number="23" style="v" sid="2SA 5:23"/>ዳዊቲ ጎዳ ናምአን ኦይችን፥ ጎዳይ፥ “ኤንታ ጉየ ባጋራ ተቃዳ ዎላ ስንን ኤንታ ኦላ፥ ሽን ኤንታዉ ሶምኦን ከዮፓ። <verse eid="2SA 5:23"/><verse number="24" style="v" sid="2SA 5:24"/>ዎላ ም ፄራን ሳልፐ ቃላ ኔኒ ስእያ ዎደ ፍልስፄመ ኦላንቾታ ሾጫናዉ ጎዳይ ኔፐ ስን አዳይሳ ኤራዳ ኤለሳ” ያግስ። <verse eid="2SA 5:24"/><verse number="25" style="v" sid="2SA 5:25"/>ዳዊቲ ጎዳይ ኪትዳይሳዳ ኦስ፤ ጌባፐ ገዘራ ጋካናዉ ፍልስፄመ ኦላንቾታ ዎስ።<verse eid="2SA 5:25"/></para>
  <chapter eid="2SA 5"/>
  <chapter number="6" style="c" sid="2SA 6"/>
  <para style="s1">ታቦተይ የሩሳላመ ስምስ</para>
  <para style="r">(<ref loc="1CH 13:1-14">1 ታር 13:1-14</ref>፤ <ref loc="1CH 15:25-16:6">15:25—16:6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1"/>እስራኤለ ግዶፈ ዶረትዳ ሀስታሙ ሙኩሉ አሳታ ዳዊቲ ዛሪድ ሺሽስ። <verse eid="2SA 6:1"/><verse number="2" style="v" sid="2SA 6:2"/>ዳዊቲነ እያ አሳ ኡባይ ይሁዳ ባላ<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">ይሁዳ ባላ፦ </char><char style="ft" closed="false">ቅርያት ይኣርመ ጉሱ።</char></note> ካታማፐ ደንድድ፥ ክሩበታፐ ግዶን ባ ካዎተ አራታ ቦላ ኡትዳ ኡባፈ ዎልቃማ ጎዳ ሱንን ፄገትዳ ፆሳ ታቦትያ ኤሀናዉ ብዶሶና። <verse eid="2SA 6:2"/><verse number="3" style="v" sid="2SA 6:3"/>ኤንቲ ፆሳ ታቦትያ ኦራ ጋረን ዎድ፥ ደረ ሁጰን ደእያ አምናዳበ ሶፐ ኤህዶሶና። አምናዳበ ናይት ኦዝነ አህዮይ ኦራ ጋርያ ካለሶና። <verse eid="2SA 6:3"/><verse number="4" style="v" sid="2SA 6:4"/>ደረ ሁጰን ደእያ አምናዳበ ሶፐ ፆሳ ታቦትያ ኤህያ ዎደ አህዮይ ታቦትያፐ ስንራ ሄመቴስ። <verse eid="2SA 6:4"/><verse number="5" style="v" sid="2SA 6:5"/>ዳዊቲነ እስራኤለ አሳ ኡባይ ዲን፥ ማስንቆን፥ ካራቦን ዳላንነ ሻሾተን ካእሸ ባንታ ኩመ ዎልቃን ጎዳ ስንን ኡፋይትድ ቦንቾሶና።<verse eid="2SA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6"/>ናኮን ካ ቡክያ ዉዱማ ጋክያ ዎደ ቦራት በትን፥ ኦዝ ባ ኩሽያ የድድ፥ ፆሳ ታቦትያ ኦይክስ። <verse eid="2SA 6:6"/><verse number="7" style="v" sid="2SA 6:7"/>ኦዝ ታቦትያ ቦችዳ ግሾ ጎዳ ሀንቆይ እያ ቦላ ኤፅስ። ፆሳይ እያ ሾጭን ሄ በሳን ፆሳ ታቦትያ ማታን ሀይቅስ። <verse eid="2SA 6:7"/><verse number="8" style="v" sid="2SA 6:8"/>ጎዳ ሀንቆይ ኦዛ ሾጭዳ ግሾ ዳዊቲ አዛንስ። ሄ በሳይ ሀች ጋካናዉ ኦዝ ሾጨትዳ በሳ ጌተቴስ።<verse eid="2SA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 6:9"/>ሄ ጋላስ ዳዊቲ ጎዳ ያይዳ ግሾ “ጎዳ ታቦተይ ታኮ ዋንድ ያኔ?” ያግስ። <verse eid="2SA 6:9"/><verse number="10" style="v" sid="2SA 6:10"/>ሄሳ ግሾ፥ እ ጎዳ ታቦትያ ባራ ዳዊታ ካታማ ኤሀናዉ ኮይቤና። ሄሳ አግድ ጋተ አድያ አብዳራ ሶ ኤፍስ። <verse eid="2SA 6:10"/><verse number="11" style="v" sid="2SA 6:11"/>ጎዳ ታቦተይ አብዳራ ሶን ሄ አጌና ጋምእስ፤ ጎዳይ አብዳራነ እያ ሶ አሳ ኡባ አንጅስ።<verse eid="2SA 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 6:12"/>ፆሳ ታቦትያ ግሾ ጎዳይ አብዳራ ሶ አሳነ እያዉ ደእያ ኡባ አንጅዳይሳ ካዎይ ዳዊቲ ስእስ። ሄሳ ግሾ፥ ዳዊቲ አብዳራ ሶ ብድ፥ ፆሳ ታቦትያ ዳዊታ ካታማ ኡፋይሳን ኤህስ። <verse eid="2SA 6:12"/><verse number="13" style="v" sid="2SA 6:13"/>ዳዊቲ ጎዳ ታቦትያ ቶክዳ አሳት ኡሱፑና ታንጎ ታንግዳ ዎደ ኤንታ ኤስድ፥ እስ ኮርማነ እስ አንቃራ ማር ያርሽስ። <verse eid="2SA 6:13"/><verse number="14" style="v" sid="2SA 6:14"/>ዳዊቲ ሊኖፐ ኦሰትዳ ኤፉደ ማእድ፥ ባዉ ደእያ ዎልቃ ኡባን ጎዳ ስንን ዱርስ። <verse eid="2SA 6:14"/><verse number="15" style="v" sid="2SA 6:15"/>ዳዊቲነ እስራኤለ አሳ ኡባይ ኡፋይሳን እልልሸነ ሞይዘ ፑንሸ ጎዳ ታቦትያ ዳዊታ ካታማ ኤህዶሶና።<verse eid="2SA 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 6:16"/>ጎዳ ታቦተይ ዳዊታ ካታማ ገልያ ዎደ ሳኦላ ናእያ መልኮላ ማስኮተራ ፄላዳ፥ ካዎይ ዳዊቲ ጎዳ ስንን ጉፕሽንነ ዱርሽን በአዳ ባ ዎዛናን ካሱ።<verse eid="2SA 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 6:17"/>ዳዊቲ ጎዳ ታቦትያ ዎናዉ ቶልዳ ዱንካንያ ግዶን ታቦትያ ዎን፥ ዳዊቲ ፁሳ ያርሾነ እስፈተ ያርሾ ጎዳስ ያርሽስ። <verse eid="2SA 6:17"/><verse number="18" style="v" sid="2SA 6:18"/>ዳዊቲ ፁሳ ያርሾነ እስፈተ ያርሾ ያርሽዳፐ ጉየ ኡባፈ ዎልቃማ ጎዳ ሱንን አሳ አንጅስ። <verse eid="2SA 6:18"/><verse number="19" style="v" sid="2SA 6:19"/>እስራኤለ አሳ ኡባስ፥ ማጫስ አደስ ሁጰን ሁጰን እስ እስ ኡይ፥ እስ እስ ቃንፆ አሾነ እስ እስ ዎይነ ኑካ ግሽስ። ሄሳፈ ጉየ አሳ ኡባይ ባ ሶ ሶ ስምስ።<verse eid="2SA 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 6:20"/>ዳዊቲ ባ ሶ አሳ አንጃናዉ ሶ ስምዳ ዎደ ሳኦላ ናእያ መልኮላ እያ ሞካናዉ ከያዳ፥ “ፓና አሳት ካሎ ሄመተይሳዳ ሀች እስራኤለ ካዎይ ባ ማጫ አይለታ ስንን ካሎትድ አይ መላ ቦንቸትደ!” ያጋሱ።<verse eid="2SA 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 6:21"/>ዳዊቲ፥ “ነ አዋፐነ እያ ሶ አሳፐ አድ ባ አሳ እስራኤለ ካለና መላ ታና ዶርዳ ጎዳ ስንን ዱራስ። ታኒ ጎዳ ቦንቾስ ዱርሳ አግከ። <verse eid="2SA 6:21"/><verse number="22" style="v" sid="2SA 6:22"/>ታኒ ሀይሳፈ አዳ ቡሮ ታና ቶቻና፤ ታናተ ዝቅ ኦና። ሽን ኔኒ ግዳ ማጫ አይለታ ስንን ታ ቦንቸታና” ያግስ።<verse eid="2SA 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 6:23"/>ሳኦላ ናእያ መልኮላ ሀይቃና ጋካናዉ ናአ የላቡኩ።<verse eid="2SA 6:23"/></para>
  <chapter eid="2SA 6"/>
  <chapter number="7" style="c" sid="2SA 7"/>
  <para style="s1">ፆሳይ ዳዊታስ ገልዳ ቃላ</para>
  <para style="r">(<ref loc="1CH 17:1-15">1 ታር 17:1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1"/>ካዎይ ባ ጋን ዎፑ ግድ ኡትዳፐነ ጎዳይ እያ ዩሹዋን ደእያ እያ ሞርከታፐ ሸምፕስዳፐ ጉየ፥ <verse eid="2SA 7:1"/><verse number="2" style="v" sid="2SA 7:2"/>ናብያ ናታናኮ፥ “ታኒ ዝጋፐ ኬፀትዳ ኬን ደአይስ፥ ሽን ፆሳ ታቦተይ ዱንካነን ደኤስ” ያግስ።<verse eid="2SA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 7:3"/>ናታን፥ “ኦናዉ ነ ዎዛናን ቆፕዳባ ኡባ ኦ፤ ጎዳይ ኔራ ደኤስ” ያግስ።<verse eid="2SA 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 7:4"/>ሽን ሄ ቃማ ጎዳ ቃላይ ናታናኮ ይድ፥ <verse eid="2SA 7:4"/><verse number="5" style="v" sid="2SA 7:5"/>“ባዳ ታ አይልያ ዳዊታ ሀይሳዳ ያጋ፤ ‘ታኒ ዳና ኬ ኬፃናይ ነና ግዳካ። <verse eid="2SA 7:5"/><verse number="6" style="v" sid="2SA 7:6"/>ታኒ እስራኤለታ ግብፀ ቢታፈ ከስዳ ዎደፐ ዶማዳ ሀች ጋካናዉ ኬን ደአብከ፤ ታኒ ዱንካነን ያነ ሃነ ዩያሸ ደአስ። <verse eid="2SA 7:6"/><verse number="7" style="v" sid="2SA 7:7"/>ታኒ እስራኤለ አሳራ ዩይዳ በሳ ኡባን ታ አስ እስራኤለ ሄማና መላ ታኒ ሹምዳ፥ “ታዉ ዝጋ ምን አይስ ኬ ኬፃብኪ?” ጋዳ ኦይቻብከ’ ያግስ።<verse eid="2SA 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 7:8"/>“ህዛ፥ ታ አይልያ ዳዊታስ ኦዳ፤ ‘ኡባፈ ዎልቃማ ጎዳይ ኔኮ ሀይሳዳ ያጌስ፤ ታኒ ነና ሄን በሳፈ፥ ዶርሰ ሄምያ ሶፐ ደንዳ ታ አሳ እስራኤለ ካለና መላ ኦስ። <verse eid="2SA 7:8"/><verse number="9" style="v" sid="2SA 7:9"/>ኔኒ ብዳ በሳ ኡባን ታኒ ኔራ ግዳስ፤ ነ ሞርከታ ኡባ ነ ስንፈ ይሳስ። ሀእ ዛራዳ ታኒ ሀ ሳአን ኤረትዳ ግታ አሳታዳ ነ ሱን ግታያና። <verse eid="2SA 7:9"/><verse number="10" style="v" sid="2SA 7:10"/>ታኒ ታ አሳ እስራኤለስ በሰ እማዳ፥ ኤንታ ሄ በሳን ቶካና። ኤንቲ ባንታ በሳን ዳና፤ ናምአን ዳጋሞኮና። ካሰ ዳይናታ ዎደፐ ዶምድ ሀንዳይሳዳ ህዛፐ ጉየ ኤንታ ኢታ አስ ሃረና። <verse eid="2SA 7:10"/><verse number="11" style="v" sid="2SA 7:11"/>ታኒ ነና ነ ሞርከታ ኡባፈ ሸምፕሳና።</para>
  <para style="p" vid="2SA 7:11">“ ‘ሄሳ ቦላ ጉጅድ ጎዳይ ባ ሁጰን ታኒ ነዉ ኬ ኬፃና<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">ነ አራታን ኡትያ ሼሽ እማና።</char></note> ያግድ ኦድስ። <verse eid="2SA 7:11"/><verse number="12" style="v" sid="2SA 7:12"/>ነ ባረይ ዉርን፥ ሀይቃዳ ነ ማይዛታ ነ ጋክያ ዎደ ነ ጉልባታፐ ከይዳ ናአ ታኒ ደንና፤ እያ ካዎተ ምንና። <verse eid="2SA 7:12"/><verse number="13" style="v" sid="2SA 7:13"/>ታ ሱንስ ኬ ኬፃናይ እያ፤ ታኒ እያ አራታ መርናዉ ምን ኤሳና። <verse eid="2SA 7:13"/><verse number="14" style="v" sid="2SA 7:14"/>ታኒ እያዉ አዋ ግዳና፤ እካ ታዉ ናአ ግዳና። እ ባልያ ዎደ ታኒ እያ አሳ ፃምአን፥ አስ ሾጭያ ልሶን ሴራና። <verse eid="2SA 7:14"/><verse number="15" style="v" sid="2SA 7:15"/>ሽን ታኒ ነ ስንፈ ድግዳ ሳኦላፐ ታ ኬሀተይ ኤከትዳይሳዳ እያፐ ኩም ኤከተና። <verse eid="2SA 7:15"/><verse number="16" style="v" sid="2SA 7:16"/>ነ ኮቻትነ ነ ካዎተይ ታ ስንን መርናዉ ዳና፤ ነ አራታይ መርናዉ ምንድ ኤቃና’ ” ያጋ።<verse eid="2SA 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 7:17"/>ናታን ጎዳይ እያዉ ቆንጨን በስዳ ቃላ ኡባ ዳዊታስ ኦድስ።<verse eid="2SA 7:17"/></para>
  <para style="s1">ዳዊታ ዎሳ</para>
  <para style="r">(<ref loc="1CH 17:16-27">1 ታር 17:16-27</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18"/>ሄሳፈ ጉየ፥ ካዎይ ዳዊቲ ግዶ ገልድ ጎዳ ስንን ኡትድ ሀይሳዳ ያግድ ዎስስ። “አቤት ታ ጎዳ ፆሳዉ፥ ሀች ጋካናዉ ኔኒ ሀይሳ ኡባ ኦናዉ ታ ኦኔ? ታ ሶ አሳይካ አይቤ? <verse eid="2SA 7:18"/><verse number="19" style="v" sid="2SA 7:19"/>አቤት ታ ጎዳዉ፥ ፆሳዉ፥ ሀይስ ነ አይፈ ስንን ጉ ዳንን፥ ስንፈ ነ አይልያ ኮቻታስ ኦናባ ኦዳዳሳ። ታ ጎዳ ፆሳዉ፥ ኔኒ አሳራ ኦደትያ ኦገይ ሀይሴ?<verse eid="2SA 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 7:20"/>“ሀይሳፈ አያባ ታኒ፥ ዳዊቲ አይ ጋናዉ ዳንዳእያና? ታ ጎዳ ፆሳዉ፥ ኔኒ ታና ነ አይልያ ኤራሳ። <verse eid="2SA 7:20"/><verse number="21" style="v" sid="2SA 7:21"/>ኔኒ ነ ቃላ ግሾ፥ ነ ዎዛና ቆፋዳ ሀ ግታባ ኦዳ ታና ነ አይልያ በሳዳሳ።<verse eid="2SA 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 7:22"/>“አቤት ታ ጎዳ ፆሳዉ፥ ኔኒ ግታ። ነ መል ባዋ፤ ኑኒ ኑ ሀይን ስእዳይሳዳ ኔፐ አትሽን፥ ሀራ ፆሲ ባዋ። <verse eid="2SA 7:22"/><verse number="23" style="v" sid="2SA 7:23"/>ነ አሰ ኦናዉ ግብፀፈ ዎዝዳ ነ አሳ እስራኤለ ዳንያ ሀራ ካዎተ ሳአ ቦላ ባዋ። ኔኒ ኤንታዉ ኦዳ ግታነ ማላልስያ ኦሶታ ጋሶን ነ ሱንይ ቢታን ኤረትስ። ኔኒ ነ አሳ ስንፈ ሀራ ካዎተታነ ኤንታ ፆሳታ ጎዳ ከሳዳሳ። <verse eid="2SA 7:23"/><verse number="24" style="v" sid="2SA 7:24"/>ነ አሳ እስራኤለ መርናዉ ነባ ኦዳሳ፤ ምንዳሳ። አቤት ጎዳዉ፥ ነ ኤንታ ፆሳ ግዳዳሳ።<verse eid="2SA 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 7:25"/>“አቤት ታ ጎዳዉ፥ ፆሳዉ፥ ኔኒ ነ አይልያስነ እያ ኬስ ኦና ጋዳ ገልዳ ቃላ መርናዉ ናጋ፤ ነ ቃላ ኦ። <verse eid="2SA 7:25"/><verse number="26" style="v" sid="2SA 7:26"/>ሄሳን ነ ሱንይ መርናዉ ግታ ግዳና። አሳይ ነና፥ ‘ኡባፈ ዎልቃማ ጎዳይ እስራኤለ ፆሳ’ ያጋና። ነ አይልያ ዳዊታ ኮቻትካ ነ ስንን ምንድ ኤቃና።<verse eid="2SA 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 7:27"/>“አቤት ኡባፈ ዎልቃማ ጎዳዉ፥ እስራኤለ ፆሳዉ፥ ኔኒ፥ ‘ነ ኮቻት መርናዉ ካዎታና’ ያጋዳ ታዉ ነ አይልያስ ጫቃዳሳ። ሄሳ ግሾ፥ ታኒ ነ አይለይ ሀ ዎሳ ዎሳናዉ ፃላስ። <verse eid="2SA 7:27"/><verse number="28" style="v" sid="2SA 7:28"/>አቤት ታ ጎዳ ፆሳዉ፥ ኔኒ ፆሰ! ነ ቃላይ ቱማ፤ ኔኒ ሀ ሎኦባታ ኦና ጋዳ ታዉ ነ አይልያስ ኦዳዳሳ። <verse eid="2SA 7:28"/><verse number="29" style="v" sid="2SA 7:29"/>ነ ስንን መርናዉ ዳና መላ ነ አይልያ ኮቻ አንጃ። አቤት ታ ጎዳ ፆሳዉ ነ ግዳይሳዳ ነ አንጅኮ ነ አይልያ ኬይ መርናዉ አንጀታና” ያግድ ዎስስ።<verse eid="2SA 7:29"/></para>
  <chapter eid="2SA 7"/>
  <chapter number="8" style="c" sid="2SA 8"/>
  <para style="s1">ዳዊታ ፆኖታ</para>
  <para style="r">(<ref loc="1CH 18:1-17">1 ታር 18:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1"/>ሄሳፈ ጉየ፥ ካዎይ ዳዊቲ ፍልስፄመታ ፆንድ ሃርስ፤ ያትድ መተግ-አማ ካታማ<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="fq" closed="false">መተግ-አማ፦ </char><char style="ft" closed="false">1 ታርከ ማፃፋን ፃፈትዳይሳዳ ጋተነ እያ ሄራን ደእያ ጉታታ በሴስ።</char></note> ፍልስፄመታ ኩሸፐ ኤክስ።<verse eid="2SA 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2"/>ዳዊቲ ቃስ ሞአበታ ፆንስ። እ ኤንታ ቢታን ዝንእስድ ኩሸን ዋስ፤ ኤንታፈ ናምኡ ኩሽያ ዎድ፥ ሄን ኩሽያ ፓፃ አግስ። ያትን ሞአበት ዳዊታስ ሃረትድ ጊርዶሶና።<verse eid="2SA 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3"/>ረሆባ ናአይ፥ ሱባ ካዎይ፥ አድራዛር ኤፍራፂሳ ሻፋ ማታን ደእያ ባ ዛዋ ዛራናዉ ብዳ ዎደ ዳዊቲ እያ ኦልድ ፆንስ። <verse eid="2SA 8:3"/><verse number="4" style="v" sid="2SA 8:4"/>ዳዊቲ እያ አሳፐ እስ ሙኩሉነ ላፑን ፄቱ ፓራ አሳታነ ላታሙ ሙኩሉ ቶሆ አሳታ ድእስ። ዳዊቲ ጋረታ ጎቻናዉ ፄቱ ፓራታ አሽድ ሀራ ፓራታ ኡባስ ጋድያ ግልዳይስ።<verse eid="2SA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5"/>ዳማስቆን ደእያ ሶረ ኦላንቾት ሱባ ካዋ አድራዛራ ማዳናዉ ይዳ ዎደ ዳዊቲ ኤንታፈ ላታማነ ናምኡ ሙኩሉ አሳ ዎስ። <verse eid="2SA 8:5"/><verse number="6" style="v" sid="2SA 8:6"/>ዳዊቲ ሶረ ካዎተን፥ ዳማስቆን፥ ኦላንቾታስ ሚፃ መስ። ያትን ሶረ አሳይ ዳዊታስ ሃረትድ ጊርዶሶና። ዳዊቲ ብዳ በሳ ኡባን ጎዳይ እያዉ ፆኖ እሚስ።<verse eid="2SA 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 8:7"/>አድራዛራ ቶራ ሞጮናት ኦይክያ ዎርቃ ጎንዳልያ ዳዊቲ ኤክድ የሩሳላመ ኤህስ። <verse eid="2SA 8:7"/><verse number="8" style="v" sid="2SA 8:8"/>በፃሀነ በሮታ ጌተትያ አድራዛራ ካታማታፐ ካዎይ ዳዊቲ ዳሮ ናሰ ብራታ ኤክስ።<verse eid="2SA 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 8:9"/>አድራዛራ ኦላንቾታ ኡባ ዳዊቲ ፆንዳይሳ ሀማታ ካዎይ ቶእ ስእስ። <verse eid="2SA 8:9"/><verse number="10" style="v" sid="2SA 8:10"/>ዳዊቲ አድራዛራ ኦልድ ፆንዳ ዎደ ሀዳድዘር ቶአራራ ኦለትሸ ጋምእዳ ግሾ እያ ሀሹ ጋናዉነ ሳሮናዉ ባ ናኣ ዮራማ ዳዊታኮ ኪትስ። ዮራም ዎርቃፈ፥ ብራፐነ ናሰ ብራታፐ ኦሰትዳ እሞታታ ዳዊታስ ኤህስ። <verse eid="2SA 8:10"/><verse number="11" style="v" sid="2SA 8:11"/>ካዎይ ዳዊቲ ካሰ ጊርስያ ካዎተታ ኡባፈ ኤክዳ ዎርቃነ ብራ ኦዳይሳዳ ሀ እሞታታካ ጎዳስ ዱማይስ። <verse eid="2SA 8:11"/><verse number="12" style="v" sid="2SA 8:12"/>እ ፆንዳ ካዎተት ኤዶመ፥ ሞአበ፥ አሞነ፥ ፍልስፄመነ አማለቃ። ሄሳዳካ ረሆባ ናኣ፥ ሱባ ካዋ አድራዛራ ኤክዳ ዲኡዋ ጎዳስ ዱማይስ።<verse eid="2SA 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13"/>ማፅነ ዛንጋራን ታማነ ሆስፑን ሙኩሉ ኤዶመ<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="ft" closed="false">አራመ ዎይኮ ሶረ ጉሱ።</char></note> አሳታ ዳዊቲ ዎድ ስምዳፐ ጉየ እያ ሱንይ ከይስ። <verse eid="2SA 8:13"/><verse number="14" style="v" sid="2SA 8:14"/>ዳዊቲ ኤዶመ ቢታን ኦላንቾታ ሚፃ መስ፤ ሄ ቢታይ ዳዊታስ ሃረትስ። ዳዊቲ ብዳ በሳ ኡባን ጎዳይ እያዉ ፆኖ እሚስ።<verse eid="2SA 8:14"/></para>
  <para style="s1">ዳዊታ ሞርናታ</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15"/>ዳዊቲ እስራኤለ ኡባ ቦላ ካዎትስ፤ ባ አሳ ኡባ ፅሎተንነ ሱረ ፕርዳን አይስስ። <verse eid="2SA 8:15"/><verse number="16" style="v" sid="2SA 8:16"/>ፃሩያ ናአይ እዮኣብ ቶራ ሞጮና ግድሽን፥ አህሉዳ ናአይ እዮሳፈፅ ታርከ ፃፈ። <verse eid="2SA 8:16"/><verse number="17" style="v" sid="2SA 8:17"/>አህፁባ ናአይ ሳዶቅነ አብያታራ ናአይ አብመለከ ካህነ ግድሽን፥ ሳራይ ቃስ ፃፈ። <verse eid="2SA 8:17"/><verse number="18" style="v" sid="2SA 8:18"/>ዮዳሄ ናአይ ባናያስ ካዋ ናገይሳታ<note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="fq" closed="false">ካዋ ናገይሳታ፦ </char><char style="ft" closed="false">ከርታወታነ ከልታወታ ጌተቶሶና።</char></note> ሀላቃ ግድሽን፥ ዳዊታ አደ ናይት ካዋ ዞረይሳታ።<note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="fq" closed="false">ካዋ ዞረይሳታ፦ </char><char style="ft" closed="false">ዎይኮ ካህነታ</char></note><verse eid="2SA 8:18"/></para>
  <chapter eid="2SA 8"/>
  <chapter number="9" style="c" sid="2SA 9"/>
  <para style="s1">ዳዊታነ መምፕቦስተ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1"/>ዳዊቲ፥ “ዮናታና ግሾ ታኒ እያዉ ኬሀተ ኦናዉ ሳኦላ ኬፈ አትዳ አስ ደእሻ?” ያግድ ኦይችስ።<verse eid="2SA 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 9:2"/>ሄ ዎደ ሲባ ጌተትያ እስ አይለይ ሳኦላ ሶን ደኤስ። እ ዳዊታ ስን ያና መላ ፄግን፥ ካዎይ፥ “ኔኒ ሲቤ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 9:2">ሲብ፥ “ኤ፥ ታኒ ነ አይልያ ሲባ” ያግስ።<verse eid="2SA 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 9:3"/>ካዎይ፥ “ፆሳ ኬሀተ ታኒ በሳና መላ ሳኦላ ኬፈ አትዳ አስ ባዌ?” ያግስ።</para>
  <para style="p" vid="2SA 9:3">ሲብ፥ “ናምኡ ቶሆይ ስልዳ ዮናታና ናይታፐ እሶይ ሀኖ ጋካናዉ ፓፃ ደኤስ” ያግስ።<verse eid="2SA 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 9:4"/>ካዎይ፥ “እ አዉን ደኢ?” ያግስ።</para>
  <para style="p" vid="2SA 9:4">ሲብ፥ “ሎዶባራ ጌተትያ በሳን አምኤላ ናኣ ማክራ ሶን ደኤስ” ያግስ።<verse eid="2SA 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 9:5"/>ካዎይ ዳዊቲ ሎዶባራፐ አምኤላ ናኣ ማክራ ሶፐ መምፕቦስተ ኤህስስ።<verse eid="2SA 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6"/>ሳኦላ ናኣ ዮናታና ናአይ መምፕቦስተይ ዳዊታኮ ይድ፥ ዳዊታ ስንን ዝግድ ቦንችስ።</para>
  <para style="p" vid="2SA 9:6">ዳዊቲ፥ “መምፕቦስተ” ያግድ ፄግስ።</para>
  <para style="p" vid="2SA 9:6">እ፥ “አበ ታ ጎዳዉ፥ ታ ነ አይልያ” ያግስ።<verse eid="2SA 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 9:7"/>ዳዊቲ፥ “ያዮፋ፤ ነ አዋ ዮናታና ግሾ ታኒ ነዉ ኬሀና። ነ አዋ አዋ ሳኦላ ጋድያ ኡባ ታኒ ነዉ ዛራና፤ ቃስ ኔኒ ኡባ ዎደ ታ ጋይታፐ ማና” ያግስ።<verse eid="2SA 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 9:8"/>መምፕቦስተይ ዝግድ፥ “ሀይቅዳ ካና ዳንያ ታና ኔኒ ዉዳዳ ፄላናዉ ነ አይለይ ታኒ ኦኔ?” ያግስ።<verse eid="2SA 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 9:9"/>ካዎይ ሳኦላ አይልያ ሲባ ፄግድ፥ “ሳኦላባነ እያ ሶ አሳባ ግድዳባ ኡባ ታኒ ነ ጎዳ ናኣ ናኣስ እማስ። <verse eid="2SA 9:9"/><verse number="10" style="v" sid="2SA 9:10"/>ነ ጎዳ ናኣ ናአይ ማና መላ ኔኒ፥ ነ ናይትነ ነ አይለት እያ ጋድያ ጎይድ፥ ካፅዳ ካ እያዉ ኤህተ። ግዶሽን፥ ነ ጎዳ ናኣ ናአይ መምፕቦስተይ ኡባ ዎደ ታ ጋይታፐ ማና” ያግስ። ሲባስ ታማነ እቻሹ አደ ናይትነ ላታሙ አይለት ደኦሶና።<verse eid="2SA 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 9:11"/>ሲብ፥ “ኔኒ ታ ጎዳይ፥ ካዎይ ነ አይልያ ኪትዳ ኡባ ታኒ ነ አይለይ ኦና” ያግስ። ሄሳ ግሾ፥ መምፕቦስተይ ካዋ ናይታፐ እሱዋ መላ ካዎ ጋይታፐ ሜስ።<verse eid="2SA 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 9:12"/>መምፕቦስተስ ምካ ጌተትያ ጉ ናእ ደኤስ። ሲባ ሶን ደእያ አሳ ኡባይ መምፕቦስተስ አይለ ግድዶሶና። <verse eid="2SA 9:12"/><verse number="13" style="v" sid="2SA 9:13"/>ናምኡ ቶሆት ስልዳ መምፕቦስተይ ኡባ ዎደ ካዋ ጋይታፐ ምሸ የሩሳላመን ደእስ።<verse eid="2SA 9:13"/></para>
  <chapter eid="2SA 9"/>
  <chapter number="10" style="c" sid="2SA 10"/>
  <para style="s1">ዳዊቲ ሶረታነ አሞነታ ፆንስ</para>
  <para style="r">(<ref loc="1CH 19:1-19">1 ታር 19:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1"/>ሄሳፈ ጉየ፥ አሞነታ ካዎይ ሀይቅን እያ ናአይ ሀኑኒ እያ በሳን ካዎትስ። <verse eid="2SA 10:1"/><verse number="2" style="v" sid="2SA 10:2"/>ዳዊቲ፥ “እያ አዋይ ታዉ ኬህዳይሳዳ ናኦሳ ናኣ ሀኑናስ ታካ ኬሀና” ያግስ። ሄሳ ግሾ፥ እያ ምንናዉ ዳዊቲ አሰ እያኮ ኪትስ።</para>
  <para style="p" vid="2SA 10:2">ዳዊቲ ኪትዳ አሳይ አሞነ ቢታ ጋክዳ ዎደ፥ <verse eid="2SA 10:2"/><verse number="3" style="v" sid="2SA 10:3"/>አሞነ ሀላቃት ባንታ ጎዳ ሀኑናኮ፥ “ዳዊቲ ሀ አሳ ኪትዳይ ነ አዋ ቦንችድ ነና ምንናዉ ኮይዳ ግሾ ዳኒ? እ አሰ ኪትዳይ ሀ ካታማ ዎች በእድ ኦላናሳ” ያግዶሶና። <verse eid="2SA 10:3"/><verse number="4" style="v" sid="2SA 10:4"/>ሀኑኒ ዳዊቲ ኪትዳ አሳታ ኦይክድ፥ ኤንታ ቡቻፈ ባጋ ሜድስ፤ ኤንታ ማኡዋ ጋርሳፈ ዱለ ጋካናዉ ቃንፅድ ኤንታ የድስ።<verse eid="2SA 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 10:5"/>ዳዊቲ ሄሳ ስእድ፥ ኤንቲ ዬላትዳ ግሾ፥ “ህንተ ቡቻይ ድጫና ጋካናዉ እያርኮን ደእሽተ፤ ሄሳፈ ጉየ ሃ ዪተ” ያግድ አሰ ኪትስ።<verse eid="2SA 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6"/>አሞነት ዳዊቲ ኤንታ ሞርክዳይሳ ኤርዳ ዎደ ቤት-ረሆባነ ሱባን ደእያ አራመ አሳፐ ላታሙ ሙኩሉ ቶሆ ኦላንቾታ፥ ፆባፐ ታማነ ናምኡ ሙኩሉ አሳታነ ማካ ካዉዋፐ እስ ሙኩሉ አሳታ ሻምዶሶና።<verse eid="2SA 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 10:7"/>ዳዊቲ ሄሳ ስእዳ ዎደ እዮኣባ ኩመ ኦላንቾታራ ኤንታ ቦላ የድስ። <verse eid="2SA 10:7"/><verse number="8" style="v" sid="2SA 10:8"/>አሞነት ከይድ፥ ካታማ ፐንግያን ኦላስ ሳልፕዶሶና፤ ሱባፈነ ረሆባፐ ይዳ አራመ አሳት፥ ፆባ አሳትነ ማካ አሳት ደንባን ዱማ ሳልፕዶሶና።<verse eid="2SA 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 10:9"/>እዮኣብ ባና ኦል ስንራነ ጉየራ ተቅዳይሳ በእድ፥ እስራኤለ ኦላንቾታፐ ምኖታ ዶርድ ሶረ አሳታ ስንን ኤስስ። <verse eid="2SA 10:9"/><verse number="10" style="v" sid="2SA 10:10"/>አትዳ አሳታ ባ እሻ አብስ ኪታና መላ ኦድ አሞነታ ስንን ሳልፕስስ። <verse eid="2SA 10:10"/><verse number="11" style="v" sid="2SA 10:11"/>እዮኣብ አብሳኮ፥ “ሶረ አሳት ታ ቦላ ዎልቃምኮ ነ ያዳ ታና ማዳ፤ አሞነ አሳት ነ ቦላ ዎልቃምኮ ታ ባዳ ነና ማዳና። <verse eid="2SA 10:11"/><verse number="12" style="v" sid="2SA 10:12"/>ህዛ ምና! ኑ አሳ ግሾነ ኑ ፆሳ ካታማታ ግሾ፥ አነ ምን ኦለቶስ። ጎዳይ ባና ሎእያባ ኦ” ያግስ።<verse eid="2SA 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13"/>እዮኣብነ እያራ ደእያ ኦላንቾት ሶረ አሳታ ኦላናዉ ከይዶሶና፤ ሶረ አሳት እያ ስንፈ ባቃትዶሶና። <verse eid="2SA 10:13"/><verse number="14" style="v" sid="2SA 10:14"/>ሶረ አሳት ባቃትዳይሳ አሞነ አሳት በእዳ ዎደ ኤንትካ አብሳ ስንፈ ባቃትድ፥ ካታማ ገልዶሶና። እዮኣብ አሞነታ ኦለይሳ አግድ፥ የሩሳላመ ስምስ።<verse eid="2SA 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 10:15"/>ሶረ አሳት እስራኤለ አሳይ ኤንታ ፆንዳይሳ ኤርዳ ዎደ ባንታ ኦላንቾታ ኡባ ሺሽዶሶና። <verse eid="2SA 10:15"/><verse number="16" style="v" sid="2SA 10:16"/>ካዎይ ሀዳድዘር ሶረ አሳታ ኤፍራፂሳ ሻፋ ሄፍንፈ ኪትድ ኤህስን፥ ኤላማ ብዶሶና። አድራዛራ ቶራ ሞጮናይ ሾባክ ኤንታ ካለስ።<verse eid="2SA 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 10:17"/>ዳዊቲ ሄሳ ስእዳ ዎደ፥ እስራኤለ ኦላንቾታ ሺሽድ፥ ዮርዳኖሰ ሻፋ ፕንድ ኤላማ ጋክስ። ሶረ አሳት በሰ ኦይክድ፥ ጊግድ፥ ዳዊታራ ኦለትዶሶና። <verse eid="2SA 10:17"/><verse number="18" style="v" sid="2SA 10:18"/>ሽን ሶረ አሳት እስራኤለታ ስንፈ ባቃትዶሶና። ዳዊቲይ ሶረ ኦላንቾታፐ ፓራ ጋረ ላግያ ላፑን ፄቱ አሳታነ ኦይታሙ ሙኩሉ ቶሆ ኦላንቾታ ዎስ። ኤንታ ቶራ ሞጮና ሾባክካ ሄ በሳን ሾጨትድ ሀይቅስ። <verse eid="2SA 10:18"/><verse number="19" style="v" sid="2SA 10:19"/>አድራዛራስ ሃረትድ ደእያ ካዎት እስራኤለት ኤንታ ፆንዳይሳ ኤርዳ ዎደ እስራኤለታራ ስገትድ፥ ኤንታዉ ሃረትዶሶና። ሄሳፈ ስምን፥ ሶረ አሳት አሞነ አሳታ ማዳናዉ ያይዶሶና።<verse eid="2SA 10:19"/></para>
  <chapter eid="2SA 10"/>
  <chapter number="11" style="c" sid="2SA 11"/>
  <para style="s1">ዳዊታነ በርሳቦ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1"/>ላይ ላመን<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="fq" closed="false">ላይ ላመ፦ </char><char style="ft" closed="false">እስራኤለ ላይ ላመይ ማጋብተፐነ ማዘፐ ግዶን ደእያ ቃማ።</char></note> ካዎት ኦላስ ከይያ ዎደ ዳዊቲ ባ አሳራነ እስራኤለ ኦላንቾታራ እስፈ እዮኣባ ኦላስ የድስ። ኤንቲ አሞነ ኦልድ፥ ራባ ካታማ ተቅዶሶና። ሽን ዳዊቲ የሩሳላመን አትስ።<verse eid="2SA 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 11:2"/>እስ ጋላስ ኦማርስ ዳዊቲ ባ ሂፃፐ ደንድድ፥ ኬ ቦላ ደእያ በሳ ከይድ ሄመትሸ ቦላ ሜጨትያ እስ ማጫስ በእስ፤ ሄ ማጫስያ ዳሮ ማላ ሎኦ። <verse eid="2SA 11:2"/><verse number="3" style="v" sid="2SA 11:3"/>ዳዊቲ እያ ኦነኮ ኤራናዉ ኮይድ አሰ ኪትስ። ኪተትዳ አደይ፥ “እያ ኤልያባ ናእዉ፥ ህተ አድያ ኦርዮና ማችዉ በርሳቦ” ያግስ። <verse eid="2SA 11:3"/><verse number="4" style="v" sid="2SA 11:4"/>ዳዊቲ አሰ ኪትድ፥ እዮ ኤህስስ፤ ኢራ አቅስ። ሄ ዎደ እያ ኩሸ መቶይ አን፥ ጌያዳ ደአዉሱ። እያ ባ ሶ ስማዳ ባሱ። <verse eid="2SA 11:4"/><verse number="5" style="v" sid="2SA 11:5"/>ጉየፐ እያ ቃንትዳይሳ ኤርዳ ዎደ ዳዊታኮ፥ “ነዉ ቃንታስ” ያጋሱ።<verse eid="2SA 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 11:6"/>ዳዊቲ፥ “ህተ አድያ ኦርዮና ሃ የዳ” ያግድ እዮኣባኮ ኪትስ። እዮኣብ ኦርዮና ዳዊታኮ የድስ። <verse eid="2SA 11:6"/><verse number="7" style="v" sid="2SA 11:7"/>ኦርዮን ይን ዳዊቲ፥ “እዮኣብ አይ መሌ? ኦላንቾት አይ መሌ? ኦላይ ዋኒ?” ያግድ ኦይችስ። <verse eid="2SA 11:7"/><verse number="8" style="v" sid="2SA 11:8"/>ዳዊቲ ኦርዮናኮ፥ “ሶ ባዳ ሸምፓ” ያግን፥ ኦርዮን ካዎ ጋፐ ከይድ ብስ። ካዎይ ኦርዮና ጉየራ ካ የድስ። <verse eid="2SA 11:8"/><verse number="9" style="v" sid="2SA 11:9"/>ሽን ኦርዮን ሶ ቦና ካዎ ጋ ድርሳ ፐንግያን ባ ጎዳ አይለታራ አቅስ።<verse eid="2SA 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 11:10"/>ኦርዮን ባ ሶ ቦናይሳ ዳዊቲ ስእድ፥ “ኔኒ ሃሆሶፐ ያዳሳ ግድኪ? ነ ሶ አይስ ባብኪ?” ያግድ ኦይችስ።<verse eid="2SA 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 11:11"/>ኦርዮን ዳዊታኮ፥ “ታቦተይ፥ እስራኤለ አሳይ፥ ይሁዳ አሳይ፥ ታ ሀላቃይ እዮኣብነ ካዋ አሳይ ደንባን ዱንካነን ደኦሶና። ያትን ታ ዋናዳ ሶ ባዳ ሞ፥ ኡዮ፥ ቃስ ታ ማቸራ ዋናዳ አቆ? ነ ሸምፖይ ኤሮ! ታኒ ሀይሳ መላባ ኦከ” ያግድ ዛርስ።<verse eid="2SA 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 11:12"/>ዳዊቲ፥ “እስ ጋላስ ሀይሳን ጋምአ፤ ዎንቶ ነና ጉየ የዳና” ያግስ። ኦርዮን ሄ ጋላስነ ዎንተ ጋላስ የሩሳላመን ጋምእስ። <verse eid="2SA 11:12"/><verse number="13" style="v" sid="2SA 11:13"/>ዳዊቲ ሾቢን ኦርዮን እያራ ምስ፤ እ ማታና ጋካናዉ ዳዊቲ እያ ኡሽስ። ሽን ሄ ዎደ ኦማርስ ኦርዮን ባ ሶ ቦና፥ ባ ሂፃ ሂፅድ ባ ጎዳ አይለታራ አቅስ።<verse eid="2SA 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14"/>ዎንተ ዳዊቲ እዮኣባስ ዳብዳበ ፃፍድ፥ ኦርዮና ቦላ የድስ። <verse eid="2SA 11:14"/><verse number="15" style="v" sid="2SA 11:15"/>ዳዊቲ ባ ዳብዳብያን፥ “ኦርዮና ኦላይ ጎብያ በሳን ስን ባጋ አ። እ ሾጨትድ ሀይቃና መላ እያ ማታፐ ሃክተ” ያግስ።<verse eid="2SA 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 11:16"/>እዮኣብ ሄ ካታማ ተቅዳ ዎደ እ ኤርያ ምኖ ሞርከ ኦላንቾት ደእያ በሳን ኦርዮና ኤስስ። <verse eid="2SA 11:16"/><verse number="17" style="v" sid="2SA 11:17"/>ካታማ አሳት ከይድ እዮኣባራ ኦለትዶሶና። ዳዊታ ኦላንቾታፐ ጉ አሳት ሀይቅዶሶና፤ ኦርዮን ህተ አደይካ ሀይቅስ።<verse eid="2SA 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 11:18"/>እዮኣብ ኦላን ሀንዳባ ኡባ ዳዊታስ ኪትስ። <verse eid="2SA 11:18"/><verse number="19" style="v" sid="2SA 11:19"/>እዮኣብ ኪተትድ ብያ አድያኮ፥ “ኦላን ሀንዳባ ነ ካዋስ ኦዳ ዉርስዳ ዎደ፥ <verse eid="2SA 11:19"/><verse number="20" style="v" sid="2SA 11:20"/>ካዎይ ሸነትድ፥ ‘ህንተ ኤንታራ ኦለታናዉ ካታማኮ አይስ ሺቅደቲ? ኤንቲ ግምብያ ቦላ ኤቅድ ዶንገን ዱካናይሳ ኤረከቲ? <verse eid="2SA 11:20"/><verse number="21" style="v" sid="2SA 11:21"/>ገድዮና ናአይ አብመለከይ ዋንድ ሀይቅዳኮ አኬከከቲ? ማይደ ግምብያ ቦላራ ዱገ ሆላዳ ተበሳ ጌተትያ በሳን ዎዳይ እስ ማጫስ ግደኬ? ያትን፥ ህንተ ግምብያኮ አይስ ሺቅደቲ?’ ያግድ ኦይችኮ፥ ኔኒ፥ ‘ነ አይለይ፥ ህተ አደይ ኦርዮንካ ሀይቅስ’ ” ያጋ።<verse eid="2SA 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 11:22"/>ኪተትዳይስ ብድ እዮኣብ ኪትዳባ ኡባ ዳዊታስ ኦድስ። <verse eid="2SA 11:22"/><verse number="23" style="v" sid="2SA 11:23"/>አደይ፥ “ኑ ሞርከት ኑፐ ዎልቃምዶሶና፤ ኑራ ኦለታናዉ ካታማ ጋፃን ደእያ ደምባ በሳ ከይዶሶና። ሽን ኑ ኤንታ ካታማ ፐንግያ ጋካናዉ ጉየ ዛሪድ የደዳ። <verse eid="2SA 11:23"/><verse number="24" style="v" sid="2SA 11:24"/>ሄሳፈ ጉየ፥ ዶንገን ዱከይሳት ግምብያ ቦላ ግድድ ነ አይለታ ዶንገን ዱክዶሶና። ካዋዉ፥ ነ አሳታፐ ጉት ሀይቅዶሶና፤ ነ አይለይ፥ ህተ አደይ ኦርዮንካ ሀይቅስ” ያግስ።<verse eid="2SA 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 11:25"/>ዳዊቲ ኪተትዳይሳኮ፥ “ኔኒ እዮኣባኮ ሀይሳዳ ያጋ፤ ‘ቶሪ ገደካ ሃካ ምያ ግሾ ሀይሳስ አዛኖፓ፤ ካታማ ኦላዳ ኦይካናዉ ምና’ ያጋዳ እያ ምን” ያግስ።<verse eid="2SA 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 11:26"/>ኦርዮና ማችያ ባ አዝናይ ሀይቅዳይሳ ስእዳ ዎደ እያዉ ዬካሱ። <verse eid="2SA 11:26"/><verse number="27" style="v" sid="2SA 11:27"/>እያ ካዮ ዎ ስምን፥ ዳዊቲ ኪትድ እዮ ባ ሶ ኤህስ። እያ እያዉ ማቾ ግዳዳ አደ ናአ የላሱ። ሽን ዳዊቲ ኦዳ ኦሶይ ኢታ ግድያ ግሾ ጎዳይ ኡፋይትቤና።<verse eid="2SA 11:27"/></para>
  <chapter eid="2SA 11"/>
  <chapter number="12" style="c" sid="2SA 12"/>
  <para style="s1">ናታን ዳዊታ ሀንቀትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1"/>ጎዳይ ናብያ ናታና ዳዊታኮ ኪትን፥ ናታን እያኮ ይድ፥ “እስ ካታማን ናምኡ አሳት ደኦሶና፤ ኤንታፈ እሶይ ዱረ፤ ቃስ ሀንኮይ ማንቆ። <verse eid="2SA 12:1"/><verse number="2" style="v" sid="2SA 12:2"/>ዱረ አድያስ ዳሮ ዶርስነ መሄይ ደኤስ። <verse eid="2SA 12:2"/><verse number="3" style="v" sid="2SA 12:3"/>ሽን ማንቆ አድያስ ሻምድ ሄምያ እስ ዶርሳ ማሬፐ አትሽን፥ ሀር ባዋ። ሄ ዶርስያ እያ ሶን እያ ናይታራ እስፈ ድጫሱ። እ ባ ምያ ካፈ ሙዜስ፤ ባ ኡያ ኡሻፈ ኡሼስ፤ እያ እያ ክኦነ ዝንአዉሱ። ሄ ዶርስያ እያዉ ማጫ ናአ መላ።<verse eid="2SA 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 12:4"/>“እስ ጋላስ እስ እማ ዱርያ ሶ ይስ። ዱረይ ባ ዶርሳፈ ዎይኮ ባ መሄፐ ሹክድ፥ እማ ሞካናዉ ኮይቤና። ሽን እ ሄ ማንቆ አድያ ዶርስዉ ኤክድ፥ ሄ እማስ ምያባ ጊግስስ” ያግስ።<verse eid="2SA 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5"/>ዳዊቲ ሄ ዱረ አድያ ቦላ ሸነ ኤፅድ፥ “ደኦ ጎዳይ ኤርያ መላ፥ ሀይሳ ኦዳ አደይ ሀይቃናዉ በሴስ። <verse eid="2SA 12:5"/><verse number="6" style="v" sid="2SA 12:6"/>ቃስ ቃይ ባይና እ ሄሳ ኦዳ ግሾ፥ ሄ ዶርሳ ማረ ግሾ ኦይዱ ኩሸ ዛራናዉ ኮሼስ” ያግስ።<verse eid="2SA 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7"/>ናታን ዳዊታኮ፥ “ሄ አደይ ነና! ጎዳይ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፤ ‘ታኒ ነና እስራኤለ ቦላ ትያዳ ካዎስ፤ ሳኦላ ኩሽያፐ ነና አሻስ። <verse eid="2SA 12:7"/><verse number="8" style="v" sid="2SA 12:8"/>ታኒ ነ ጎዳ፥ ሳኦላ ኬ ነዉ እማስ፤ ነ ጎዳ ማቸታ ነ ክኦን የጋስ። እስራኤለ አሳነ ይሁዳ አሳ ታኒ ነዉ እማስ። ሀ ኡባይ ጉፅስ ጊኮ፥ ታኒ ነዉ ሀራ ጉጃ እማናሽን። <verse eid="2SA 12:8"/><verse number="9" style="v" sid="2SA 12:9"/>ሀይሳ መላ ኢታባ ጎዳ ስንን ኦዳ፥ አይስ ጎዳ ቃላ ካዲ? ህተ አድያ ኦርዮና ማሻን ዎዳሳ፤ እያ ማችዉ ነው ኤካዳሳ። አሞነ አሳታ ማሻን እያ ዎዳሳ። <verse eid="2SA 12:9"/><verse number="10" style="v" sid="2SA 12:10"/>ኔኒ ታና ካዳ፥ ህተ አድያ ኦርዮና ማችዉ ኤክዳ ግሾ ነ ሶ አሳፐ ማሽ ሻከተና’ ” ያጌስ።<verse eid="2SA 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 12:11"/>ጎዳይ ሀይሳዳ ያጌስ፤ “ታኒ ነ ሶ አሳ ግዶፈ ነ ቦላ ኢታ ኤሀና፤ ነ ማቸታ ኔኒ ፄልሽን ደንዳ፥ ነዉ ማትያ አድያስ እማና፤ ሴታ ጋላስ ሄ አደይ ነ ማቸታራ ዝንአና። <verse eid="2SA 12:11"/><verse number="12" style="v" sid="2SA 12:12"/>ኔኒ ሄሳ ጌማን ኦዳሳ፤ ሽን ታኒ ሴታ ጋላስ እስራኤለ አሳ ኡባ ስንን ኦና” ያግስ።<verse eid="2SA 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13"/>ያትን፥ ዳዊቲ፥ “ታኒ ጎዳ ቦላ ናጋራ ኦስ” ያግስ።</para>
  <para style="p" vid="2SA 12:13">ናታን፥ “ጎዳይ ነ ናጋራ አቶ ግስ፤ ኔኒ ሀይቃካ። <verse eid="2SA 12:13"/><verse number="14" style="v" sid="2SA 12:14"/>ሽን ነ ሀይሳ ኦዳ፥ ጎዳ ሞርከት እያ ካና መላ ኦዳ ግሾ የለትዳ ናአይ ቱማ ሀይቃና” ያግስ።<verse eid="2SA 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 12:15"/>ናታን ባ ሶ ብዳፐ ጉየ፥ ኦርዮና ማችያ ዳዊታስ የልዳ ናኣ ጎዳይ ሾጭን እ ሀርግስ። <verse eid="2SA 12:15"/><verse number="16" style="v" sid="2SA 12:16"/>ዳዊቲ ባ ናኣ ግሾ ፆሳ ዎስስ፤ ዳዊቲ ፆምስ፤ ባ ክፍልያ ገልድ ቃማ ቃማ ሳአን ዝንእ አቄስ። <verse eid="2SA 12:16"/><verse number="17" style="v" sid="2SA 12:17"/>እያ ሶ ጭማት እያ ሳአፐ ደንዳና መላ እያ ማታን ኤቅድ ዎስዶሶና፤ ሽን እ ደንዶና እፅስ፤ እ ኤንታራ ካ ምቤና።<verse eid="2SA 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 12:18"/>ላፑን ጋላስ ናአይ ሀይቅስ። ዳዊታ አይለት ናኣ ሀይቁዋ ኦዳናዉ ያይድ፥ “ናአይ ፓፃ ደእሽን ኑኒ ዳዊታስ ኦድን፥ ስኦና እፅስ። ያትን፥ ናአይ ሀይቅዳይሳ ኑኒ ዋትድ እያዉ ኦዳኔ? ኦን ኤር፥ እ ባና ቆሀነኮሺ?” ያግዶሶና።<verse eid="2SA 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19"/>ባ አይለት እሶይ እሱዋራ ካልካሸይሳ ዳዊቲ ስእዳ ዎደ ናአይ ሀይቅዳይሳ ኤርስ። ዳዊቲ፥ “ናአይ ሀይቅዴ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 12:19">ኤንቲ፥ “ኤ ሀይቅስ” ያግዶሶና።<verse eid="2SA 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 12:20"/>ያትን፥ ዳዊቲ ሳአፐ ደንድድ ሜጨትስ፤ ቅባተ ትየትስ፤ ባ ማኡዋ ላምድ፥ ጎዳ ኬ ገልድ ጎይንስ። ሄሳፈ ጉየ ባ ሶ ብድ፥ ካ ኦይችን፥ ኤንቲ እያ ስን አን ምስ።<verse eid="2SA 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 12:21"/>እያ አይለት፥ “ኔኒ ሀይሳዳ አይስ ሀናዲ? ናአይ ፓፃ ደእሽን ፆማዳሳነ ዬካዳሳ፤ ሽን ናአይ ሀይቅን ደንዳዳ፥ ካ ማዳሳ” ያግዶሶና።<verse eid="2SA 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 12:22"/>ዳዊቲ፥ “ናአይ ፓፃ ደእሽን ታኒ ፆማስነ ዬካስ፤ ጎዳይ ታና ማርን፥ ናአይ ፓፃነኮነ” ጋዳ ቆፓስ። <verse eid="2SA 12:22"/><verse number="23" style="v" sid="2SA 12:23"/>ሽን፥ “ናአይ ሀይቅን፥ ታኒ አይስ ፆሞ? ታኒ ናኣ ጉየ ዛራናዉ ዳንዳእያና? ታኒ እያኮ ባናፐ አትን፥ እ ታኮ ዬና” ያግስ።<verse eid="2SA 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24"/>ሄሳፈ ጉየ፥ ዳዊቲ ባ ማችዉ በርሳቦ ምንስ። ዳዊቲ ኢኮ ገልድ ኢራ አቅስ፤ እያ እያዉ አደ ናአ የላሱ። ናኣ ሶሎሞነ ግድ ሱንስ፤ ጎዳይ ሄ ናኣ ዶስስ። <verse eid="2SA 12:24"/><verse number="25" style="v" sid="2SA 12:25"/>ጎዳይ ናኣ ዶስዳ ግሾ፥ እያ ሱን “ይድድያ” ግድ ሱንና መላ ናብያ ናታና ኪትስ።<verse eid="2SA 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26"/>ሄ ዎደ እዮኣብ አሞነታ ካታማ ራባ ኦልድ ካዎ ሚፃ ኦይክስ። <verse eid="2SA 12:26"/><verse number="27" style="v" sid="2SA 12:27"/>እዮኣብ ዳዊታኮ፥ “ታኒ ራባ ካታማ ኦላዳ፥ ሃ ዱቅያ በሳ ኦይካስ። <verse eid="2SA 12:27"/><verse number="28" style="v" sid="2SA 12:28"/>ሀእ አትዳ ኦላንቾታ ሺሻዳ ካታማ ኦላዳ ኦይካ። ሄስ ሀኖና እፅኮ፥ ታኒ ካታማ ኦይካዳ ታ ሱንን ፄገታና መላ ኦና” ያግስ።<verse eid="2SA 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 12:29"/>ዳዊቲ ባ ኦላንቾታ ኡባ ሺሽድ፥ ራባ ካታማ ብድ፥ ኦልድ ኦይክስ። <verse eid="2SA 12:29"/><verse number="30" style="v" sid="2SA 12:30"/>ኤንታ ካዋ ካላቻ እያ ሁጰፐ ኤክስ። ሄ ዎርቃ ካላቻይ ሀስታማነ እቻሹ ክሎ ግራመ ዴፄስ። እያ ግዶን እንቆ ጌተትያ አልኦ ሹች ደኤስ። ሄ ካላቻ ዳዊቲ ባ ሁጰን ዎስ። ዳዊቲ ካታማፐ ዳሮ ድኦ ድእስ። <verse eid="2SA 12:30"/><verse number="31" style="v" sid="2SA 12:31"/>ሄ ካታማን ደእያ አሳ ከስድ፥ ማጋዘን፥ ብራታ ኮንተንነ ብራታ ካልታን ኦና መላ ኦስ። ቃስ ኤንቲ ፁበ መና መላ ኦስ። አሞነ ካታማ ኡባን ደእያ አሳ እ ሀይሳዳ ኦስ። ሄሳፈ ጉየ፥ ዳዊቲነ እያ ኦላንቾት የሩሳላመ ስምዶሶና።<verse eid="2SA 12:31"/></para>
  <chapter eid="2SA 12"/>
  <chapter number="13" style="c" sid="2SA 13"/>
  <para style="s1">አምኖናነ ትማሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1"/>እስ ዎደ ሀይሳዳ ሀንስ። ዳዊታ ናኣ አበሰሎመስ ትማሮ ጌተትያ እስ ማላ ሎኦ ምቻ ደአዉሱ። ዳዊታ ናአይ አምኖን ትማሮ ዶስስ። <verse eid="2SA 13:1"/><verse number="2" style="v" sid="2SA 13:2"/>አምኖን ባ ምችዉ ትማሮ ዶስዳ ግሾ እዮ ቆፕሸ ዳሮ ግልቅስ። እያ ጌላኦ ግድዳ ግሾ እዮ አይኮካ ኦናዉ ዳንዳኤቶናባ እያዉ ዳንስ።<verse eid="2SA 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 13:3"/>ሽን አምኖናስ ዳዊታ እሻ ሳማ ናኣ እዮናዳባ ጌተትያ ላገይ ደኤስ፤ እዮናዳብ ዳሮ ኤጫ አስ። <verse eid="2SA 13:3"/><verse number="4" style="v" sid="2SA 13:4"/>እዮናዳብ፥ “ኔኒ ካዎ ናአ ግዳሸ ዎንታ ዎንታ አይስ ግልቃይ? ኔኒ ታዉ አይስ ኦድኪ?” ያግድ አምኖና ኦይችስ።</para>
  <para style="p" vid="2SA 13:4">አምኖን፥ “ታ እሻ አበሰሎመ ምችዉ ትማሮ ታኒ ዶሳስ” ያግስ።<verse eid="2SA 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 13:5"/>እዮናዳብ፥ “ሀርገትያ አሳዳ ሀናዳ ሂፃን ዝንአ። ነ አዋይ ነና በአናዉ ያ ዎደ፥ ‘ታ ምችያ ትማራ ያዳ ታዉ ምያባ እሞ፤ ታኒ እዮ በእሽን ታ ስንን ካዳ ታና ባርሶ’ ያጋዳ ኦይቻ” ያግስ።<verse eid="2SA 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 13:6"/>አምኖን ሀርገትዳ አሳዳ ሀንድ ሂፃን ዝንእስ። ካዎይ እያ በአናዉ ያ ዎደ አምኖን፥ “ታ ምችያ ትማራ ያዳ፥ ታ በእሽን ታ ስንን ኡይ ኡካዳ ታና ባ ኩሸራ ባርሶ” ያግስ።<verse eid="2SA 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 13:7"/>ዳዊቲ፥ ካዎ ጋን ደእያ ትማርኮ ኪትድ፥ “ነ እሻ አምኖና ሶ ባዳ እያዉ ካ ካ” ያግስ። <verse eid="2SA 13:7"/><verse number="8" style="v" sid="2SA 13:8"/>ትማራ ባ እሻ አምኖና ሶ ባሱ፤ ሄ ዎደ እ ሂፃን ዝንእስ። ትማራ ጉ ለ ሙኑቃዳ አምኖን በእሽን ኡይ ኡካሱ። <verse eid="2SA 13:8"/><verse number="9" style="v" sid="2SA 13:9"/>ትማራ ኡይ ባሸፐ ከሳዳ እያዉ አሱ፤ ሽን እ ሞና እፅስ።</para>
  <para style="p" vid="2SA 13:9">አምኖን፥ “አሳ ኡባ ካረ ከስተ” ያግን፥ አሳ ኡባይ እያ ማታፐ ከይስ። <verse eid="2SA 13:9"/><verse number="10" style="v" sid="2SA 13:10"/>ሄሳፈ ጉየ አምኖን፥ “ታኒ ነ ኩሸፐ ማና መላ ካ ሃ ቆልአ ኤካዳ ያ” ያግስ። ትማራ ባ ኡክዳ ኡይ ኤካዳ፥ ባ እሻ አምኖና ስን ሺሻሱ። <verse eid="2SA 13:10"/><verse number="11" style="v" sid="2SA 13:11"/>ትማራ ካ እያኮ ሺሽያ ዎደ እዮ ኦይክድ፥ “ታ ምቸ፥ ሃያ! ታራ ዝንአ” ያግስ።<verse eid="2SA 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 13:12"/>እያ፥ “ታ እሻዉ፥ አካይ ሀነና! ታና ዎልቃንፋ! ሀይሳ መላባይ እስራኤለን ሀን ኤረና፤ ሀይሳ መላ ቦርሶባ ኦፋ። <verse eid="2SA 13:12"/><verse number="13" style="v" sid="2SA 13:13"/>ታ ፖኩዋ ታኒ ዋታዳ ገንናዉ ዳንዳእያና? ቃስ ነካ እስራኤለ ግዶን ካዉሻ አስ ግዳና። ሀያና ካዋ ኦይቻ፤ ታኒ ነና ገላናይሳ እ ድገና” ያጋሱ። <verse eid="2SA 13:13"/><verse number="14" style="v" sid="2SA 13:14"/>ሽን እ እዮ ስኦና እፅስ። እ ዎልቃማ ግድያ ግሾ፥ እዮ ዎልቃን ኦይክድ ኢስስ።<verse eid="2SA 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 13:15"/>ሄሳፈ ጉየ፥ አምኖን እዮ ዳሮ እፅስ፤ ካሰ እዮ ዶስዳይሳፈ አድ እፅስ። አምኖን፥ ደንዳ፥ “ከያ! ከያዳ ባ!” ያግስ።<verse eid="2SA 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 13:16"/>እያ፥ “ኔኒ ታና ከያዳ ባ ገይስ ካሰ ነ ታ ቦላ ኦዳ ኢታፐ አስ” ያጋሱ።</para>
  <para style="p" vid="2SA 13:16">ሽን እ እዮ ስኦና እፅስ። <verse eid="2SA 13:16"/><verse number="17" style="v" sid="2SA 13:17"/>አምኖን ባ አይልያ ፄግድ፥ “ሀ ማጫስዉ ታ ስንፈ ከሳ፤ እዮ ካረ ከሳዳ ዉላ ጎርዳ” ያግስ። <verse eid="2SA 13:17"/><verse number="18" style="v" sid="2SA 13:18"/>አይለይ እዮ ካረ ከስድ ዉላ ጎርድስ።</para>
  <para style="p" vid="2SA 13:18">ጌላኦ ግድዳ ካዎ ማጫ ናይት ማእያ አሌቆ ማኦ ማአሱ። <verse eid="2SA 13:18"/><verse number="19" style="v" sid="2SA 13:19"/>ትማራ ብዶ ባ ሁጰን ቆላዳ፥ ባ ማእዳ አሌቆ ማኡዋ ዳካዳ፤ ባ ሁጵያ ኦይካዳ፥ ዋሶ ጎቻሸ ባሱ።<verse eid="2SA 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 13:20"/>እ እሻ አበሰሎመይ እዮ በእዳ ዎደ፥ “ነ እሻይ አምኖን ነና ኢስዴ? ታ ምቸ፥ ኔኒ ሀእ ስእ ጋ። እ ነ እሻ፤ ሀ ኦዳ ነ ኡሎን ኦይኮፋ” ያግስ። ያትን፥ ትማራ አዛናሸ፥ አሳን ከዮና ባ እሻ አበሰሎመ ሶን ደአሱ።<verse eid="2SA 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 13:21"/>ካዎይ ዳዊቲ ሀ ኦዳ ስእዳ ዎደ ዳሮ ይሎትስ። <verse eid="2SA 13:21"/><verse number="22" style="v" sid="2SA 13:22"/>አበሰሎመይ አምኖናኮ ጫማ ማልአ ፖግቤና። ባ ምችዉ ትማሮ ኢስዳ ግሾ አምኖና ሞርክስ።<verse eid="2SA 13:22"/></para>
  <para style="s1">አበሰሎመይ አምኖና ዎስ</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23"/>ናምኡ ላይፈ ጉየ፥ ኤፍሬማ ዛዋ ማታን ሀፆራ ጌተትያ በሳነ አበሰሎመይ ዶርሳ እክሰ ሜዴስ። ካዋ አደ ናይት ኡባይ ሄ በሳ ያና መላ አበሰሎመ ኤንታ ፄግስ። <verse eid="2SA 13:23"/><verse number="24" style="v" sid="2SA 13:24"/>አበሰሎመይ ካዋኮ ብድ፥ “ታኒ ነ አይለይ ታ ዶርሳታ እክስያ ሜድሳይስ፤ ነነ ነ ሞርናት ኑራ የርከቲ?” ያግስ።<verse eid="2SA 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 13:25"/>ካዎይ፥ “አካይ፥ ታ ናአዉ! ኑ ኡባይ ቢኮ፥ ነዉ ቶሆ ግዳና” ያግስ። አበሰሎመይ ካዋ ዳሮ ሾቢንካ ካዎይ ቦና እፅስ፤ ሽን አበሰሎመ አንጅስ።<verse eid="2SA 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 13:26"/>አበሰሎመይ፥ “ኔኒ ቦና እፅኮ፥ ታ እሻ አምኖን ኑራ ቦ” ያግስ።</para>
  <para style="p" vid="2SA 13:26">ካዎይ፥ “እ ኔራ አይስ ቢ?” ያግስ። <verse eid="2SA 13:26"/><verse number="27" style="v" sid="2SA 13:27"/>ሽን አበሰሎመይ ሾቢድ አጎና እፅን፥ ዳዊቲ አምኖናነ ባ አደ ናይታ እያራ የድስ።<verse eid="2SA 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 13:28"/>አበሰሎመይ ባ አይለታኮ፥ “አምኖን ዎይነ ኡይድ ማትያ ዎደ ታኒ ህንተና፥ ‘አምኖና ሾጭተ’ ያጋዳ ኪትያ ዎደ እያ ዎተ። ያዮፍተ! ህንተና ኪተይ ታና። ምንተ! ፃልተ!” ያግድ ኪትስ። <verse eid="2SA 13:28"/><verse number="29" style="v" sid="2SA 13:29"/>አበሰሎመ አይለት እ ኪትዳይሳዳ አምኖና ዎዶሶና። ሄሳፈ ጉየ፥ ካዋ አደ ናይት ኡባይ ደንድድ፥ ባንታ ባቁሉዋ ባቁሉዋ ቶግድ ባቃትዶሶና።<verse eid="2SA 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 13:30"/>ኤንቲ ቡሮ ኦገ ቦላ ደእሽን፥ “አበሰሎመየ ካዋ ናይታ ኡባ ዉርስስ፤ ኤንታፈ እሶይካ አትቤና” ጌተትያ ዎረይ ዳዊታ ጋክስ። <verse eid="2SA 13:30"/><verse number="31" style="v" sid="2SA 13:31"/>ካዎይ ደንድ ኤቅድ፥ አዛንድ፥ ባ ማኡዋ ዳክድ ቢታን ዝንእስ። እያ አይለት ኡባይ ባንታ ማኡዋ ዳክድ፥ እያ ማታን ኤቅዶሶና።<verse eid="2SA 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 13:32"/>ዳዊታ እሻ ሳማ ናአይ እዮናዳብ፥ “ታ ጎዳዉ፥ ካዎ ናይት ኡባይ ሀይቅዶሶና ጋዳ ቆፖፋ፤ አምኖና ፃላል ሀይቅስ። አምኖን ባ ምችዉ ትማሮ ኢስዳ ጋላሳፐ ዶምን፥ አበሰሎመይ እያ ቦላ ኦናዉ ቆፕዳባይ ሀንስ። <verse eid="2SA 13:32"/><verse number="33" style="v" sid="2SA 13:33"/>ህዛ ሀይቅዳይ አምኖና ፃላላ ግድያ ግሾ፥ ‘ካዋ አደ ናይት ኡባይ ሀይቅዶሶና’ ግያ ዎርያ ካዎይ ቱማ ጎፖ” ያግስ።<verse eid="2SA 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34"/>ሄ ዎደ አበሰሎመይ ባቃትስ።</para>
  <para style="p" vid="2SA 13:34">ናግያ አደይ ቁ ግድ ፄልያ ዎደ ዉሎሀ ባጋራ ደእያ ኦግያራ ደረ ላንቅያ ኦይክድ ዳሮ አሳይ የይሳ በእድ ካዋስ ኦድስ። <verse eid="2SA 13:34"/><verse number="35" style="v" sid="2SA 13:35"/>ሄ ዎደ እዮናዳብ፥ “ሄኮ፥ ታኒ ነ አይለይ ኦድዳይሳዳ ካዋ አደ ናይት ይዶሶና” ያግስ።<verse eid="2SA 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 13:36"/>እ ኦድ ዉርስያ ዎደ ካዋ አደ ናይት ገልድ ባንታ ቃላ ቁ ኦድ ዋስዶሶና። ቃስ ካዎይነ እያ ሞርናት ኡባይ ይባታ ዬሆ ዬክዶሶና።<verse eid="2SA 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 13:37"/>አበሰሎመይ ባቃትድ፥ ገሹራ ካዎ ግድዳ አምሁዳ ናኣ ታልማያኮ ብስ። ሽን ካዎይ ዳዊቲ ባ ናኣስ ዳሮ ጋላስ ዬክስ።<verse eid="2SA 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 13:38"/>አበሰሎመይ ባቃትድ ገሹራ ቢታ ብዳፐ ጉየ ያን ሄ ላይ ደእስ። <verse eid="2SA 13:38"/><verse number="39" style="v" sid="2SA 13:39"/>ካዎይ ዳዊቲ አምኖና ሀይቁዋን ጋክዳ አዛንያፐ ምንዳ ግሾ፥ አበሰሎመ በአናዉ ላሞትስ።<verse eid="2SA 13:39"/></para>
  <chapter eid="2SA 13"/>
  <chapter number="14" style="c" sid="2SA 14"/>
  <para style="s1">አበሰሎመይ የሩሳላመ ስምስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1"/>ፃሩያ ናአይ እዮኣብ ካዎይ ዳዊቲ አበሰሎመ ላሞትዳይሳ ኤርስ። <verse eid="2SA 14:1"/><verse number="2" style="v" sid="2SA 14:2"/>ሄሳ ግሾ፥ እዮኣብ ተቁሄ ካታማ ኪትድ፥ እስ ጭንጫ ማጫስ ኤህስስ። ኢኮ፥ “ኔኒ ካዮትያ አሳዳ ሀና፤ ካዮ ማኦ ማአ፤ ቅባተ ትየቶፋ፤ ዳሮ ዎደፐ ዶምድ፥ ሀይቅዳ አሳስ ካዮትያ ማጫሳዳ ሀና። <verse eid="2SA 14:2"/><verse number="3" style="v" sid="2SA 14:3"/>ካዋኮ ባዳ ሀ ቃላ እያዉ ኦዳ” ያግስ። እዮኣብ እያ ካዋስ ኦዳናባ እዉ ኦድስ።<verse eid="2SA 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 14:4"/>ተቁሄ ማጫስያ ካዋኮ ባዳ ቢታን ጉፋናዳ፥ “ካዋዉ፥ ታና ማዳርክ!” ያጋሱ።<verse eid="2SA 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 14:5"/>ካዎይ፥ “ነና አይበ መትዳይ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 14:5">እያ፥ “ታኒ አዝን ሀይቅዳ ማጫስ። <verse eid="2SA 14:5"/><verse number="6" style="v" sid="2SA 14:6"/>ታዉ ነ አይሌስ ናምኡ አደ ናይት ደኦሶና። ኤንቲ እሶይ እሱዋራ ደንባን ዋትዶሶና፤ ኤንታ ሻካናዉ አስ ይን፥ እሶይ እሱዋ ሾጭድ ዎስ። <verse eid="2SA 14:6"/><verse number="7" style="v" sid="2SA 14:7"/>ታ ዳቦት ኡባይ ታ ቦላ ደንድድ፥ ‘ባ እሻ እ ዎዳ ግሾ ኑኒ እያ ዎና መላ ባ እሻ ዎዳ ኡራ ኑስ ሀማ፤ ያትድ ኑኒ ላትያ አስ ይሳና’ ያግዶሶና። ኤንቲ ታዉ ላታስ አትዳ እስ ዱንቻ ቶይሶሶና፤ ታ አዝና ሱንነ እያ ኮቻ ቢታፈ ይሶሶና” ያጋሱ።<verse eid="2SA 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 14:8"/>ካዎይ ማጫሴኮ፥ “ነ ሶ ባ፤ ታ ነ ግሾ ኪታና” ያግስ።<verse eid="2SA 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 14:9"/>ሽን ተቁሄ ማጫስያ፥ “ታ ጎዳዉ፥ ካዋዉ፥ ጎመይ ታናነ ታ አዋ ሶ አሳ ኦይኮ፤ ሽን ካዎይነ እያ አራታይ ጌሽ ግዶ” ያጋሱ።<verse eid="2SA 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 14:10"/>ካዎይ፥ “ነ ቦላ ዶና ፖግያ ኦናካ ታኮ ኤሀ፤ እ ነና ናምአን ቦቸና” ያግስ።<verse eid="2SA 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 14:11"/>ማጫስያ፥ “ሱ ዛርያ ኡራይ ቆሆ ቦላ ቆሆ ኤሆናዳነ ታ ናኣካ ዎናዳ ካዎይ ጎዳ፥ ባ ፆሳ ሱንን ታዉ ጫቆ” ያጋሱ።</para>
  <para style="p" vid="2SA 14:11">ካዎይ፥ “ደኦ ጎዳይ ኤርያ መላ፥ ነ ናኣ ብናናፐ እሶይካ ሳአን ዎና” ያግስ።<verse eid="2SA 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 14:12"/>ማጫስያ ዛራዳ፥ “ታ ጎዳዉ፥ ታ ካዋዉ፥ ታ እስባ ኦደቶ” ያጋሱ።</para>
  <para style="p" vid="2SA 14:12">ካዎይ፥ “ሃሳያ” ያግስ።<verse eid="2SA 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 14:13"/>ማጫስያ፥ “ያትን፥ ኔኒ ፆሳ ደርያ ቦላ ሀይሳ መላ ቆሆ አይስ ኦዲ? ካዎይ ይዳ ባ ናኣ ጉየ ዛርቤና። ባ ኦድዳ ቃላን ካዎይ ባላ ግደኔ? <verse eid="2SA 14:13"/><verse number="14" style="v" sid="2SA 14:14"/>ኑ ኡባይ ሀይቃና፤ ጉክዳ ሃ ስሞናይሳዳ ኑ ስሞኮ። ሽን ፆሳይ ሸምፖ ዮ ዶሰና፤ ዶገትዳ አስ ኩመ ዮና መላ እያዉ ኦገ ጊግሴስ።<verse eid="2SA 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 14:15"/>“ታና አሳይ ያሽስያ ግሾ ታ ጎዳ፥ ካዋስ፥ ሀይሳ ኦዳናዉ ሀእ ያስ። ‘ታኒ ነ አይልያ፥ ታኒ ካዋስ ኦዳና፤ ኦን ኤር፥ ታኒ እያ አይልያ ኦይችዳባ ካዎይ ኦና አገና። <verse eid="2SA 14:15"/><verse number="16" style="v" sid="2SA 14:16"/>ካዎይ ስእድ፥ ፆሳይ ኑስ እምዳ ላታፐ ታናነ ታ ናኣ ይሳናዉ ኮይያ አሳ ኩሸፐ አሻና’ ጋዳ ቆፓስ። <verse eid="2SA 14:16"/><verse number="17" style="v" sid="2SA 14:17"/>ሄሳዳካ ካዎይ ሎኦነ ኢታ ሻካናዉ ፆሳ ኪታንቾ መላ ግድያ ግሾ፥ ታ ጎዳ ካዋ ነ ቃላይ ታና ሸምፕሶ። ጎዳይ፥ ነ ፆሳይ ኔራ ግዶ” ያጋሱ።<verse eid="2SA 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 14:18"/>ካዎይ፥ “ታኒ ነና ኦይቻና፤ ኔኒ ታፐ ቆቶፋ” ያግስ።</para>
  <para style="p" vid="2SA 14:18">ማጫስያ፥ “ታ ጎዳይ፥ ካዎይ ኦደቶ” ያጋሱ።<verse eid="2SA 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 14:19"/>ካዎይ ማጫስዉ፥ “ሀይሳ ኡባን እዮኣባ ኩሸይ ኔራ ደኢ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 14:19">ማጫስያ፥ “ታ ጎዳዉ፥ ካዋዉ፥ ነ ሸምፖይ ኤሮ! ኔኒ ታ ጎዳይ፥ ካዎይ፥ ኦድዳ ኡባፈ ኡሻች ዎይኮ ሀድርስ ጋናዉ ዳንዳእያ አስ ባዋ። ኤ፥ ሀይሳ ታና ኪትዳይ፥ ነ አይለ ዶናን ሀይሳ ዎዳይ ነ አይልያ እዮኣባ። <verse eid="2SA 14:19"/><verse number="20" style="v" sid="2SA 14:20"/>ነ አይለይ እዮኣብ ሀይሳ ኦዳይ ሀእ ደእያ ሀኖታ ላማናሳ። ካዋዉ፥ ነ ፆሳ ኪታንቾ መላ ጭንጫ ግድያ ግሾ ቢታን ሀንያባ ኡባ ኤራሳ” ያጋሱ።<verse eid="2SA 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 14:21"/>ካዎይ እዮኣባኮ፥ “ሎኦ! ታኒ ሀይሳ ኦና! ባዳ ሄ ናአተ አበሰሎመ ኤካዳ ያ” ያግስ።<verse eid="2SA 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 14:22"/>እዮኣብ ካዋ ስንን ጉፋንድ፥ “ታ ጎዳዉ፥ ካዋዉ፥ ባ አይለይ ኦይችዳባ ኦናዉ ኤሮ ግዳ ግሾ፥ ነ ስንን ሳባ ደምዳይሳ ነ አይለይ ሀች ኤርስ” ያግስ።<verse eid="2SA 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 14:23"/>ሄሳፈ ጉየ፥ እዮኣብ ደንድድ ገሹራ ብድ አበሰሎመ የሩሳላመ ኤክድ ይስ። <verse eid="2SA 14:23"/><verse number="24" style="v" sid="2SA 14:24"/>ሽን ካዎይ፥ “አበሰሎመይ ባ ሶ ባናዉ በሴስ፤ እ ታ ሶምኦን ከዮፖ” ያግስ። አበሰሎመይ ባ ሶ ብስ፤ ካዋ ሶምኡዋ በእቤና።<verse eid="2SA 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25"/>እስራኤለ ግዶን ማላ ሎኦተን አበሰሎመ መላ ሳበትዳ አስ ባዋ። ሁጰፐ ቶሆ ጋካናዉ እያን ቦርያባይ ባዋ። <verse eid="2SA 14:25"/><verse number="26" style="v" sid="2SA 14:26"/>እ ባና ዴፅያ ዎደ ባ ሁጵያ ቃንፅሴስ። ባ ሁጵያ ቃንፅስያ ዎደ ኡባን ምዛነን ማዛኔስ፤ እያ ብናናይ ካዎ ምዛነ ልከን ናምኡ ክሎ ግራመፐ አስ። <verse eid="2SA 14:26"/><verse number="27" style="v" sid="2SA 14:27"/>አበሰሎመስ ሄ አደ ናእነ እስ ማጫ ናእ የለትዶሶና፤ ማጫ ናኤ ሱንይ ትማሮ፤ እያ ማላ ሎኦ ናአ።<verse eid="2SA 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 14:28"/>አበሰሎመይ ናምኡ ላይ ኩመ ካዋ ሶምኦ በኦና የሩሳላመን ደእስ። <verse eid="2SA 14:28"/><verse number="29" style="v" sid="2SA 14:29"/>አበሰሎመይ፥ “ታኒ ነና ካዋኮ ኪታናዉ ኮይያ ግሾ ታኮ ሃያ” ያግድ እዮኣባኮ ኪትስ፤ ሽን እዮኣብ ዮና እፅስ። ናምአን ኪትስ፤ ሽን እዮኣብ ሀእካ ዮና እፅስ። <verse eid="2SA 14:29"/><verse number="30" style="v" sid="2SA 14:30"/>አበሰሎመይ ባ አይለታኮ፥ “ሄኮ፥ ታ ጋድያ ማታን እዮኣባስ ጋደይ ደኤስ፤ እያን ባንግ ደኤስ። ብድ እያን ታማ የድተ” ያግስ። አበሰሎመ አይለት እዮኣባ ባንጋን ታማ የድዶሶና።<verse eid="2SA 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 14:31"/>እዮኣብ አበሰሎመ ሶ ብድ፥ “ነ አይለት ታ ባንጋን አይስ ታማ የድዶና?” ያግድ ኦይችስ።<verse eid="2SA 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 14:32"/>አበሰሎመይ፥ “ታ ፄግን ነ ዮና እፅዳ ግሾሳ። ኔኒ ካዋኮ ባዳ፥ ‘ታኒ ገሹራፐ አይስ ያድና? ታኒ ሀኖ ጋካናዉ ያን ደእዳኮ ሎኦሽን’ ያጌስ ጋዳ ታዉ ኦይቻና መላ ኮያስ። ሀእ ታኒ ካዋ ሶምኦ በአናዉ ኮያይስ፤ ታኒ ባላ ግድኮ፥ እ ታና ዎ” ያግስ።<verse eid="2SA 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 14:33"/>እዮኣብ ካዋኮ ብድ፥ አበሰሎመይ ግዳይሳ ኦድስ። ካዎይ አበሰሎመ ፄግስስ፤ አበሰሎመይ ሶ ገልድ፥ ካዋ ስንን ጉፋንድ ዝግስ፤ ካዎይ አበሰሎመ ዬርስ።<verse eid="2SA 14:33"/></para>
  <chapter eid="2SA 14"/>
  <chapter number="15" style="c" sid="2SA 15"/>
  <para style="s1">አበሰሎመ ማቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1"/>ሄሳፈ ጉየ፥ አበሰሎመይ እስ ፓራ ጋረ፥ ፓራታነ ባ ስንን ዎፃናዉ እሻታሙ አሳታ ጊግስስ። <verse eid="2SA 15:1"/><verse number="2" style="v" sid="2SA 15:2"/>አበሰሎመይ ጉራ ደንድድ፥ ካታማ ፐንግያን ኤቄስ። ሞቶይ ደእያ አይ አስካ ካዋ ስን ፕርዳስ ብያ ዎደ አበሰሎመይ ፄግድ፥ “ኔኒ አዉ ካታማፐ ያይ?” ያግድ ኦይቼስ። ሄ ኡራይ፥ “ታ ነ አይለይ እስራኤለ ዛረ እሱዋፈ ያስ” ያግድ እያዉ ዛሬስ። <verse eid="2SA 15:2"/><verse number="3" style="v" sid="2SA 15:3"/>አበሰሎመይ፥ “ሄኮ፥ ነ ኦዳይ ሎኦነ ሱረ፤ ሽን ካዋ ባጋፈ ነና ስአናይ ባዋ” ያጌስ። <verse eid="2SA 15:3"/><verse number="4" style="v" sid="2SA 15:4"/>አበሰሎመይ ጉጅድ፥ “ታ እስራኤለ ቦላ ፕርዳናዉ ሹመትዳባ ግዳርክናሽን። ሄስ ሀንዳኮ፥ ሞቶይ ዎይኮ ኦድ ደእያ ኦንካ ታኮ ይን፥ ታኒ እያዉ ሱረ ፕርዳ ፕርዳናሽን” ያጌስ።<verse eid="2SA 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 15:5"/>ኦንካ እያኮ ይድ እያዉ ዝግያ ዎደ አበሰሎመይ ባ ኩሽያ የድድ ሄ አድያ ኦይክድ ዬሬስ። <verse eid="2SA 15:5"/><verse number="6" style="v" sid="2SA 15:6"/>ፕርደታናዉ ካዋኮ ያ እስራኤለ ኡባስ አበሰሎመይ ሄሳዳ ሀንድ እስራኤለ አሳ ዎዛና ኤክስ።<verse eid="2SA 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 15:7"/>ኦይዱ ላይፈ ጉየ፥ አበሰሎመይ፥ “ታኒ ጎዳስ ቃንግዳ ቃንገ ጋናዉ ከብሮና ባና። <verse eid="2SA 15:7"/><verse number="8" style="v" sid="2SA 15:8"/>ታኒ ነ አይለይ ሶረ ቢታን ገሹራ ካታማን ደአሸ፥ ‘ታና ጎዳይ የሩሳላመ ጉየ ዛርኮ፥ ጎዳስ ጎይናና’ ያጋዳ ቃንጋስ” ያግስ።<verse eid="2SA 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 15:9"/>ካዎይ፥ “ሳሮ ባ” ግን፥ እ ደንድድ ከብሮና ካታማ ብስ።<verse eid="2SA 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 15:10"/>ሽን አበሰሎመይ እስራኤለ ዛረ ኡባስ ቆሳን ኪታ የድድ፥ “ሞይዘ ፑኖ ህንተ ስእዳ ዎደ፥ ‘አበሰሎመይ ከብሮናን ካዎትስ’ ያግተ” ያግስ። <verse eid="2SA 15:10"/><verse number="11" style="v" sid="2SA 15:11"/>አበሰሎመይ ፄግን፥ የሩሳላመፐ እያራ ብዳ አሳታ ታይቦይ ናምኡ ፄታ። ኤንቲ ሄ ሀኖታባ አይኮካ ኤሮና አሽከተን ብዶሶና። <verse eid="2SA 15:11"/><verse number="12" style="v" sid="2SA 15:12"/>አበሰሎመይ ያርሾ ያርሽያ ዎደ ዳዊታ ዞርያ አሳፐ እሱዋ አክፆፈላ ግሎ ካታማፐ ፄግስስ። ካዋ ቦላ ደንድዳ ማቆይ ጎብስ፤ አበሰሎመ ካልያ አሳ ታይቦይ ጉጅ ጉጅ ብስ።<verse eid="2SA 15:12"/></para>
  <para style="s1">ዳዊቲ ባቃትስ</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13"/>እስ ኪተትዳ አስ ይድ ዳዊታኮ፥ “እስራኤለ አሳ ዎዛናይ አበሰሎመራ ደኤስ” ያግስ።<verse eid="2SA 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 15:14"/>ዳዊቲ ባራ የሩሳላመን ደእያ ባ ሞርናታኮ፥ “ደንድተ! ኑኒ ባቃቶስ! ያኖና እፅኮ፥ ኑ ግዶፈ አይ አስካ አበሰሎመፐ ከስ ኤከና። ኑኒ ኤለስድ ባናዉ ኮሼስ፤ ሀንኮደ፥ እ ኤለስ ይድ ኑና ይሳና፤ ኑ ካታማ ማሻን ቡና” ያግስ።<verse eid="2SA 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 15:15"/>ካዋ ሞርናት፥ “ኑ ጎዳይ፥ ካዎይ ዶርዳ ኡባ ኑኒ ነ አይለት ኦናዉ ጊግድ ኡትዳ” ያግዶሶና።<verse eid="2SA 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 15:16"/>ካዎይ ከይድ ቶሆራ ብስ፤ እያ ሶ አሳይነ እያ ሞርናት ኡባይ እያራ ብስ፤ ሽን ባ ጋዋ ናጋና መላ ታሙ ላገታ ሶን አሽስ። <verse eid="2SA 15:16"/><verse number="17" style="v" sid="2SA 15:17"/>ካዎይ ከይን አሳ ኡባይ እያራ ሃሆን ደእያ እስ ኬ ማታን ኤቅዶሶና። <verse eid="2SA 15:17"/><verse number="18" style="v" sid="2SA 15:18"/>እያ አሳት ኡባይ እያፐ ስንራ ሳልፕድ አዶሶና፤ ኤንታ ካልድ ካዋ ናገይሳት ሳልፕዶሶና። ቃስ ኤንታ ካልድ ጋተ ካታማፐ ይዳ ኡሱፑን ፄቱ አሳት፥ ካዋ ስንራ ሳልፕድ አዶሶና።<verse eid="2SA 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 15:19"/>ካዎይ ጋተ አድያ እታያኮ፥ “ኔኒ ኑራ አይስ ያይ? ጉየ ስማዳ፥ ካዋ አበሰሎመራ ደኣሻ። ኔኒ አሳ ቢታ አስ፤ ነ ድኤታዳ ይዳ አስ። <verse eid="2SA 15:19"/><verse number="20" style="v" sid="2SA 15:20"/>ኔኒ ዝነ ያዳሳ፤ ታኒ ታ ሁጰን ብያ ሶ ኤሮና ደአሸ፥ ነና ዋታዳ ዳቡርሶ? ጉየ ስማ፤ ነ ቢታ አስ ኔራ ኤፋ። ጎዳይ ነዉ ኬሆነ አማነቶ!” ያግስ።<verse eid="2SA 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 15:21"/>ሽን እታይ፥ “ደኦ ጎዳይ ኤርያ መላ፥ ታ ጎዳይ ካዎይ ኤርያ መላ፥ ታ ጎዳይ ካዎይ ደእያ አዉንካ፥ ፓፃን ግድን ሀይቆን ታኒ ነ አይለይ ኔፐ ሻከትከ” ያግስ።<verse eid="2SA 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 15:22"/>ዳዊቲ፥ “ሎኦ! ባ፥ አ” ያግስ። ጋተ አደይ እታይ አሳራነ ናይታራ አሳ ኡባራ ብስ።<verse eid="2SA 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 15:23"/>ሄ አሳ ኡባይ ብያ ዎደ ሄ ቢታ አሳይ ባንታ ቃላ ቁ ኦድ ዬክዶሶና። ካዎይ ቀድሮና ዛንጋራ ፕንስ፤ አሳ ኡባይ መላ ቢታኮ ስሚድ ብስ።<verse eid="2SA 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 15:24"/>ካህነይ ሳዶቅ ሄ በሳን ደኤስ፤ ፆሳ ጫቆ ታቦትያ ቶክያ ሌወትነ ካህንያ አብያታር ያን ደኦሶና። አሳ ኡባይ ካታማፐ ከይድ ዉራና ጋካናዉ ፆሳ ታቦትያ ሳአን ሸምፕስዶሶና።<verse eid="2SA 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 15:25"/>ሄሳፈ ጉየ ካዎይ ሳዶቃኮ፥ “ፆሳ ታቦትያ ካታማ ጉየ ዛራ። ጎዳይ ታናን ኡፋይትያባ ግድኮ፥ እስ ጋላስ ጉየ ዛሪድ ባ ታቦትያነ ባ ኬ በሳና። <verse eid="2SA 15:25"/><verse number="26" style="v" sid="2SA 15:26"/>ሽን እ፥ ‘ነናን ኡፋይትከ’ ጊኮ፥ እ ባና ሎእያባ ኦ፤ ታኒ ጊገታ ኡታስ” ያግስ።<verse eid="2SA 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 15:27"/>ቃስ ካዎይ ካህንያ ሳዶቃኮ፥ አነ አኬካ “ኔኒ ነ ናኣ አክማሳነ አብያታራ ናኣ ዮናታና ኤክዳ ካታማ ሳሮ ባ። <verse eid="2SA 15:27"/><verse number="28" style="v" sid="2SA 15:28"/>ህንተ ታዉ ኪታና ጋካናዉ ታኒ መላ ቢታን ደእያ ሻፋ ፕኑዋን ደአሻና” ያግስ። <verse eid="2SA 15:28"/><verse number="29" style="v" sid="2SA 15:29"/>ሄሳ ግሾ፥ ሳዶቅነ አብያታር ፆሳ ታቦትያ የሩሳላመ ጉየ ኤፍድ ያን ደእዶሶና።<verse eid="2SA 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30"/>ሽን ዳዊቲ ዬክሸ ሻማሆ ደርያ ቦላ ከይስ። እ አዛኖን ባ ሁጵያ ጉሉንትድ መላ ቶሆን ሄመትስ፤ እያራ ደእያ አሳት ጉሉንትድ ዬክሸ ፑደ ከይዶሶና። <verse eid="2SA 15:30"/><verse number="31" style="v" sid="2SA 15:31"/>አክፆፈል አበሰሎመራ ማቀትዳይሳ ዳዊቲ ስእዳ ዎደ “ጎዳዉ፥ አክፆፈላ ዞርያ ኤያተ ላማ” ያግድ ዎስስ።<verse eid="2SA 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 15:32"/>ዳዊቲ አሳይ ፆሳ ጎይንያ ዙማ ሁጰ ጋክዳ ዎደ፥ አርካያ አድያ<note caller="+" style="f"><char style="fr" closed="false">15:32 </char><char style="ft" closed="false">አርካያ አድያ ገይስ በሰ ግዶናሽን ኮቸ ግዳናዉ ዳንዳኤስ።</char></note> ኩስ ባ ማኡዋ ዳክድ፥ ባ ሁጵያን ባና ቆልድ፥ ዳዊታራ ጋሄታናዉ ይስ። <verse eid="2SA 15:32"/><verse number="33" style="v" sid="2SA 15:33"/>ዳዊቲ፥ “ኔኒ ታራ ቢኮ ታዉ ቶሆ ግዳና። <verse eid="2SA 15:33"/><verse number="34" style="v" sid="2SA 15:34"/>ሽን ኔኒ ካታማ ጉየ ስማዳ አበሰሎመኮ፥ ‘ካዋዉ፥ ሀይሳፈ ካሰ ታኒ ነ አዋ አይለ ግድዳይሳዳ ሀእ ነዉካ አይለ ግዳና’ ያግኮ፥ አክፆፈላ ዞርያ ላላዳ ታና ማዳና። <verse eid="2SA 15:34"/><verse number="35" style="v" sid="2SA 15:35"/>ካህነት ሳዶቅነ አብያታር ኔራ ያን ደኦሶና ግዶኮና? ኔኒ ካዎ ጋን ስእያባ ኡባ ኤንታዉ ኦዳ። <verse eid="2SA 15:35"/><verse number="36" style="v" sid="2SA 15:36"/>ሳዶቃ ናኣ አክማስነ አብያታራ ናኣ ዮናታን ያን ኤንታራ ደኦሶና፤ ኔኒ ስእያባ ኡባ ኤንታ ቦላ ታዉ ኪታ” ያግስ።<verse eid="2SA 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 15:37"/>አበሰሎመይ የሩሳላመ ገልሽን፥ ዳዊታ ላገይ ኩስ ካታማ ጋክስ።<verse eid="2SA 15:37"/></para>
  <chapter eid="2SA 15"/>
  <chapter number="16" style="c" sid="2SA 16"/>
  <para style="s1">ዳዊታነ ሲባ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1"/>ዳዊቲ ደርያ ሁጵያራ ሄፍን አሽን፥ ሲባ ጌተትያ መምፕቦስተ አይለይ እያራ ጋሄትስ። ናምኡ ፄቱ ኡይ፥ እስ ፄቱ ዛብበ ኑካ፥ እስ ፄቱ ትያ አይፈ፥ እስ ኦጎሮ ዎይነ ኡሹ ናምኡ ሀረታን ጫንስ።<verse eid="2SA 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 16:2"/>ካዎይ፥ “ሀይሳ አይስ ኤሀዲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 16:2">ሲብ፥ “ሀረታ፥ ካዋ ሶ አሳይ ቶጋና መላ፥ ኡይነ ትይያ አይፍያ አሳይ ማና መላነ ዎይነ ኡሻይ ባዞን ዳቡርያ አሳት ኡያና መላሳ” ያግስ።<verse eid="2SA 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 16:3"/>ካዎይ፥ “ነ ጎዳ ናኣ ናአይ አዉን ደኢ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 16:3">ሲብ፥ “ ‘እስራኤለ አሳይ ታ አዋ ካዎተ ሀች ታዉ ዛር እማና’ ያግድ የሩሳላመን ኡትስ” ያግስ።<verse eid="2SA 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 16:4"/>ካዎይ፥ “መምፕቦስተስ ደእያባ ኡባይ ነዉ ግዶ” ያግስ።</para>
  <para style="p" vid="2SA 16:4">ሲብ፥ “አቤት ጎዳዉ፥ ካዋዉ! ታኒ ነ ስንን ቴሞ ደማይስ” ያግድ ቢታን ጉፋንዳ ዝጋይስ።<verse eid="2SA 16:4"/></para>
  <para style="s1">ዳዊታነ ሳም</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5"/>ካዎይ ዳዊቲ ብራቅማ ካታማ ያ ዎደ ሳኦላ ዳቦ ግድዳ እስ አደይ ያፐ ከይስ። እያ ሱንይ ጌራ ናኣ ሳም። እ ዳዊታ ባድሸ ከይስ። <verse eid="2SA 16:5"/><verse number="6" style="v" sid="2SA 16:6"/>ኦላንቾትነ ካዋ ናገይሳት ኡሻቻራነ ሀድርሳራ ዳዊታ ተቅድ ደእሽን፥ ሳም ዳዊታ ቦላነ ካዋ ሞርናታ ቦላ ሹቹ ሆልስ። <verse eid="2SA 16:6"/><verse number="7" style="v" sid="2SA 16:7"/>ሳም ዳዊታ ባድሸ፥ “ክቻ፤ ሀ ኢታይ ክቻ! አሳ ሱ ጉስያ ሀ ፓናይስ ክቻ። <verse eid="2SA 16:7"/><verse number="8" style="v" sid="2SA 16:8"/>ኔኒ ሳኦላ በሳን ካዎታዳሳ፤ ኔኒ ጉስዳ ሳኦላ ሶ አሳ ሱ ኡባ ጎዳይ ነ ቦላ ዛርስ። ጎዳይ ካዎተ ነ ናኣ አበሰሎመስ እሚስ፤ ኔኒ ሱ ጉስዳ አስ ግድያ ግሾ፥ ነዉ ዮ ዎደይ ጋክስ” ያግስ።<verse eid="2SA 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 16:9"/>ሄሳፈ ጉየ፥ ፃሩያ ናአይ አብስ፥ ካዋኮ፥ “ሀ ባዉታ ካናይ፥ ታ ጎዳ ካዋ አይስ ባዲ? ታኒ ባዳ እያ ቆያ ቃንፃና” ያግስ።<verse eid="2SA 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 16:10"/>ካዎይ፥ “ህንተኖ፥ ፃሩያ ናይቶ፥ ህንተራ ታራ አይብ ጋ? ጎዳይ፥ ‘ዳዊታ ባዳ’ ያግዳ ግሾ እ ባድያባ ግድኮ፥ ‘ኔኒ አይስ ሄሳ ኦይ?’ ያግድ ኦይቻናዉ ዳንዳኤይ ኦኔ?” ያግስ።<verse eid="2SA 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 16:11"/>ሄሳፈ ጉየ፥ ዳዊቲ አብሳነ ባ ሞርናታ፥ “ታ ናአይ፥ ታ አሾይ፥ ታና ዎናዉ ኮዬስ፤ ያትን፥ ሀ ብንያመ አደይ ዋት አጋነ! ጎዳይ እያ ኪትዳ ግሾ እ ባዴስ፥ እያ ቦቾፍተ። <verse eid="2SA 16:11"/><verse number="12" style="v" sid="2SA 16:12"/>ኦን ኤር፥ ጎዳይ ታ መቱዋ በእድ፥ ታኒ ሀች ኤክያ ባደ ግሾ ታዉ ኬሀ ቆፓኔኮ” ያግስ።<verse eid="2SA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 16:13"/>ሄሳፈ ጉየ፥ ዳዊቲነ እያ አሳይ ኦግያ ኦይክድ ቦሶና። ሳም ዙማ ምያራ ብሸ ዳዊታ ባዴስ፤ ሹቹ ሆሌስ፤ እያ ቦላ ቢታ ላሌስ። <verse eid="2SA 16:13"/><verse number="14" style="v" sid="2SA 16:14"/>ካዎይነ እያራ ደእያ አሳት ባንታ ብያ በሳ ዳቡርድ ጋክን ካዎይ ያን ሸምፕስ።<verse eid="2SA 16:14"/></para>
  <para style="s1">አበሰሎመነ እያ ሞርናታ</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15"/>አበሰሎመይነ እስራኤለ አሳ ኡባይ የሩሳላመ ገልዶሶና፤ አክፆፈል ኤንታራ ደኤስ። <verse eid="2SA 16:15"/><verse number="16" style="v" sid="2SA 16:16"/>ዳዊታ ላገይ አርካያ ኮቻይ ኩስ አበሰሎመኮ ይድ፥ “ካዎይ ብራታ ቱሱ ግዶ! ካዎይ ሙኩሉ ላይ ካዎቶ!” ያግስ።<verse eid="2SA 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 16:17"/>አበሰሎመይ፥ “ኔኒ ነ ላግያ ዶስያ ዶሶይ ሀይሴ? ነ ላግያራ አይስ ባብኪ?” ያግስ።<verse eid="2SA 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 16:18"/>ኩስ፥ “አካይ! ጎዳይ፥ ሀ አሳይነ እስራኤለ አሳይ ዶርዳይሳስ ታኒ አቃና፤ ታኒ እያራ አታና። <verse eid="2SA 16:18"/><verse number="19" style="v" sid="2SA 16:19"/>ህዛ ታኒ ታ ጎዳ ናኣስ ኦና ኦደስ ኦኔ? ታኒ ነ አዋስ ኦዳይሳዳ ሀእ ነዉካ ኦና” ያግስ።<verse eid="2SA 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 16:20"/>አበሰሎመይ አክፆፈላኮ፥ “ኔኒ አነ ኑና ዞራ፤ ኑኒ አይ ኦኖ?” ያግስ።<verse eid="2SA 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 16:21"/>አክፆፈል፥ “ካዎ ጋ ናጋናዉ ሶን አትዳ ነ አዋ ላገታራ ባዳ ዝንአ። ኔኒ ነ አዋ ካዉሽዳይሳ እስራኤለ አሳ ኡባይ ስአና፤ ኔራ ደእያ ኡባ ኩሸይ ምናና” ያግስ። <verse eid="2SA 16:21"/><verse number="22" style="v" sid="2SA 16:22"/>ካዎ ኬ ፖቅያ ቦላ አበሰሎመስ ዱንካነ ቶክዶሶና፤ አሳ ኡባይ ፄልሽን አበሰሎመይ ገልድ ባ አዋ ላገታራ ዝንእስ።<verse eid="2SA 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 16:23"/>ሄ ዎደ አክፆፈል ዞርያ ዞረይ እስ አስ ጎዳ ኦይችድ ኤክያ ዞረ መላ። ዳዊቲነ አበሰሎመይ አክፆፈላ ዞርያ ሄሳዳ ኦድ ኤክዶሶና።<verse eid="2SA 16:23"/></para>
  <chapter eid="2SA 16"/>
  <chapter number="17" style="c" sid="2SA 17"/>
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1"/>ሄሳፈ ጉየ አክፆፈል፥ “ሀች ቃማ ታኒ ታማነ ናምኡ ሙኩሉ አሳታ ዶራዳ ዳዊታ የደዳ ኦይካና። <verse eid="2SA 17:1"/><verse number="2" style="v" sid="2SA 17:2"/>እ ዳቡርድ ዎልቃ ይድ ደእሽን ታኒ እያ ቦላ ዎና። ታኒ እያ ዳጋንና፤ ያን እያራ ደእያ አሳ ኡባይ ባቃትያ ዎደ ታኒ ካዋ ፃላላ ሾጫና። <verse eid="2SA 17:2"/><verse number="3" style="v" sid="2SA 17:3"/>ያታዳ ታኒ አሳ ኡባ ኔኮ ዛራና። ኔኒ እስ አሳ ፃላላ ዎናዉ ኮያሳ፤ ሀንኮ አሳይ ሳሮ አታና” ያግስ። <verse eid="2SA 17:3"/><verse number="4" style="v" sid="2SA 17:4"/>አክፆፈላ ዞረይ አበሰሎመነ እስራኤለ ጭማታ ኡባ ኡፋይስስ።<verse eid="2SA 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5"/>አበሰሎመይ፥ “ቃስ አርካያ ኮቻ ኩሳ ፄግተ፤ እ ግያባ አነ ስኦስ” ያግስ። <verse eid="2SA 17:5"/><verse number="6" style="v" sid="2SA 17:6"/>ኩስ እያኮ ይዳ ዎደ አበሰሎመይ፥ “አክፆፈል ዞርዳ ዞረይ ሀይሳ፤ ኑኒ እ ግያባ ኦናዉ በሲ? በሶናባ ግድኮ፥ ነ ቆፋይ አይቤ?” ያግስ።<verse eid="2SA 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 17:7"/>ኩስ፥ “አክፆፈል ዞርዳ ዞረይ ሀ ዎድያን ሎኦ ግደና። <verse eid="2SA 17:7"/><verse number="8" style="v" sid="2SA 17:8"/>ነ አዋይነ ነ አዋ አሳት ምኖ ኦላንቾታ ግደይሳነ ባ ማራታ ቦንቀትዳ ማሄ መላ ያሸይሳታ ግደይሳ ኔኒ ኤራሳ። ነ አዋይ ኦላ ሜዘትዳ አስ፤ እ ቃማ ባ ኦላንቾታራ አቀና። <verse eid="2SA 17:8"/><verse number="9" style="v" sid="2SA 17:9"/>እ ሀኖደ ጎንጎሎ ግዶን ዎይኮ ሀራ በሳን ቆሰትድ ኡትስ። እ ህንተ ጩጋታ ኮይሮትድ ቆህኮ፥ ሄሳ ስእዳ ኦንካ፥ ‘አበሰሎመ ካልድ ብዳ አሳይ ሾጨትዶሶና’ ያጋና። <verse eid="2SA 17:9"/><verse number="10" style="v" sid="2SA 17:10"/>ነ አዋይ ቶራ ቃራ ግደይሳነ እያራ ደእያ አሳይ ምኖ ግደይሳ እስራኤለ አሳ ኡባይ ኤርያ ግሾ፥ ሀር አቶሽን ጋሞዳ ምኖታ ዎዛናይ ትልአና።<verse eid="2SA 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 17:11"/>“ሽን ታኒ ነና ዞረይ ሀይሳ፤ አባ ጋፃን ደእያ ሻፈ መላ ዳርዳ፥ ዳነፐ በርሳበ ጋካናዉ ደእያ እስራኤለ ኡባ ኔኮ ሺሻ፤ ያታዳ ኔኒ ኤንታ ኦላስ ካለ። <verse eid="2SA 17:11"/><verse number="12" style="v" sid="2SA 17:12"/>ኑኒ እያ ደምዳ በሳ አዉንካ ሾጫና፤ አክ ሳአን ዎያዳ ኑኒ እያ ቦላ ዎና። እያ ግድን ዎይኮ እያራ ደእያ አሳ ግድን እሶይካ ፓፃ አተና። <verse eid="2SA 17:12"/><verse number="13" style="v" sid="2SA 17:13"/>እ ካታማ ገልኮካ፥ እስራኤለ አሳ ኡባይ ዎዶሮ ኤህድ፥ ካታማ ግዶን እስ ሹች አጎና ሄ ካታማ ጎችድ ዛንጋራን የጋና” ያግስ።<verse eid="2SA 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 17:14"/>አበሰሎመይነ እስራኤለ አሳ ኡባይ፥ “አርካያ ኮቻ ኩሳ ዞረይ አክፆፈላ ዞርያፐ ሎኦ” ያግዶሶና። ጎዳይ አበሰሎመ ቦላ ኢታባ ኤሀናዉ ቆፕዳ ግሾ አክፆፈላ ዞርያ ኤኮናዳ ኦስ።<verse eid="2SA 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15"/>ኩስ ካህነታ ሳዶቃነ አብያታራ፥ “አክፆፈል አበሰሎመነ እስራኤለ ጭማታ ሀይሳ ሀይሳ ግድ ዞርስ፤ ታንካ ኤንታ ሀይሳ ሀይሳ ጋዳ ዞራስ። <verse eid="2SA 17:15"/><verse number="16" style="v" sid="2SA 17:16"/>ሀእ ዳዊታኮ ኤሶን ኪትድ፥ ‘ባዞን ደእያ ሻፋ ጋፃን ሀች ቃማ አቆፓ፤ ሄፍን ፕና ክቻ! ሄስ ሀኖና እፅኮ፥ ካዎይነ እያራ ደእያ አሳ ኡባይ ያና’ ያግድ ኦድተ” ያግስ።<verse eid="2SA 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 17:17"/>ዮናታንነ አክማስ ቆንጨን ካታማ ገልሽን ኤንታ አስ በኦና መላ አይኖጌላ ጌተትያ በሳን ኡትድ ናጎሶና። እስ ማጫ አይልያ ያዳ ኤንታዉ ኦድን፥ ኤንቲ ብድ ካዋ ዳዊታስ ኦዶሶና። <verse eid="2SA 17:17"/><verse number="18" style="v" sid="2SA 17:18"/>ሽን እስ ፓንይ ኤንታ በእድ አበሰሎመስ ኦድስ። ሄሳ ግሾ፥ ኤንቲ ናምአይ ሄ በሳፈ ኤሶን ክችድ ብራቅማ ካታማን እስ አድያ ሶ ጋክዶሶና። ሄ አድያ ሶ ማታን ሃ ኦል ደኤስ፤ ኤንቲ ሄ ኦላን ገልዶሶና። <verse eid="2SA 17:18"/><verse number="19" style="v" sid="2SA 17:19"/>ሄ አድያ ማችያ ኦንካ ኤሮናዳ ኦላ ዶና ካማዳ እያ ቦላ ካ ምጫሱ።<verse eid="2SA 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 17:20"/>አበሰሎመ አይለት አድያ ሶ ይድ ማችዉ፥ “አክማስነ ዮናታን አዉን ደኦና?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="2SA 17:20">ማችያ፥ “ኤንቲ ሻፋ ፕንድ ብዶሶና” ያጋሱ። ኤንቲ ኮይን፥ በንቶና እፅን፥ የሩሳላመ ስምዶሶና።<verse eid="2SA 17:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 17:21"/>ሄ አሳት ብዳፐ ጉየ፥ ናምኡ አሳት ኦላፈ ከይድ፥ ካዋ ዳዊታስ ኦዳናዉ ብዶሶና። ዳዊታኮ፥ “አክፆፈል ህንተ ቦላ ሀይሳ ሀይሳ ኦና ግድ ዞር ዎዳ ግሾ ኤሶን ደንድድ፥ ሻፋ ፕንተ” ያግዶሶና። <verse eid="2SA 17:21"/><verse number="22" style="v" sid="2SA 17:22"/>ዳዊቲነ እያራ ደእያ አሳ ኡባይ ዮርዳኖሰ ፕንድ ብዶሶና። ሳእ ዎንትያ ዎደ ኡባይ ፕንድ ዉርዶሶና።<verse eid="2SA 17:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 17:23"/>አክፆፈል ባ ዞረይ ኤከትቦናይሳ ኤርዳ ዎደ ባ ሀርያ ኮርድ ባ ደእያ ካታማ ብስ። አክፆፈል ባ ሶ ጊግስድ ሱለትድ፥ ሀይቅድ ባ አዋ ዱፎን ሞገትስ።<verse eid="2SA 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 17:24"/>አበሰሎመይነ እያራ ደእያ አሳ ኡባይ ዮርዳኖሰ ፕንያ ዎደ ዳዊቲ ማሀናይማ ካታማ ጋክስ። <verse eid="2SA 17:24"/><verse number="25" style="v" sid="2SA 17:25"/>አበሰሎመይ ባ ኦላንቾታ ቦላ እዮኣባ በሳን አማሳያ ሹምስ። አማሳይ እስራኤለ አድያ ዮቶራ ናአ። ዮቶር ናኦሳ ናእዉ፥ እዮኣባ አይዉ ፃሩያ ምችዉ አብግያ ኤክስ። <verse eid="2SA 17:25"/><verse number="26" style="v" sid="2SA 17:26"/>እስራኤለትነ አበሰሎመይ ጋላዳ ቢታን ዱንካንዶሶና።<verse eid="2SA 17:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 17:27"/>ዳዊቲ ማሀናይማ ካታማ ጋክያ ዎደ አሞነ ቢታን ራባፐ ይዳ ናኦሳ ናአይ ሾብ፥ ሎዶባራ ካታማፐ ይዳ አምኤላ ናአይ ማክርነ ኦሮጋልማ ካታማፐ ይዳ ጋላዳ አደይ ባርዝለይ፥ <verse eid="2SA 17:27"/><verse number="28" style="v" sid="2SA 17:28"/>ሂፅያባታ፥ ከረታነ ሻተታ ኤህዶሶና። ቃስ ኤንቲ ግስተ፥ ባንጋ፥ ለ፥ ሻሽ፥ ቆምኦሎነ ምስረ፥ <verse eid="2SA 17:28"/><verse number="29" style="v" sid="2SA 17:29"/>ኤስ፥ ፕላ፥ መቃ ማነ ዶርሰ ዳዊታነ እያ አሳይ ማና መላ ኤክድ ይዶሶና። ሄሳ ኤንቲ ኤህዳይ፥ “አሳይ ባዞን ኮሻትስ፥ ዳቡርስ፥ ሳሞትስ” ግድ ቆፕዳ ግሾሳ።<verse eid="2SA 17:29"/></para>
  <chapter eid="2SA 17"/>
  <chapter number="18" style="c" sid="2SA 18"/>
  <para style="s1">አበሰሎመ ሀይቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1"/>ዳዊቲ ባራ ደእያ አሳ ታይብድ ሻላቃታነ ማቶ ሀላቃታ ኤንታ ቦላ ሹምስ። <verse eid="2SA 18:1"/><verse number="2" style="v" sid="2SA 18:2"/>ዳዊቲ አሳ ሄ ጩጋን ሻክስ፤ እስ ጩጋ እዮኣብ፥ ናምአን ጩጋ እዮኣባ እሻይ፥ ፃሩያ ናአይ አብስ፥ ሄን ጩጋ ጋተ አደይ እታይ ኪቴስ። ካዎይ አሳኮ፥ “ቱማ ታ ህንተራ እስፈ ባና” ያግስ።<verse eid="2SA 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 18:3"/>ሽን አሳይ፥ “ኔኒ ባናዉ በሰና! ኑኒ ባቃትያኮ ኤንቲ ኑና ኮዮኮና፤ ሀር አቶሽን ኑፐ ባጋይ ሀይቅያኮካ ኑባ ዉዳ ጎኮና። ሽን ኔኒ ነ ፃላላ ታሙ ሙኩሉፐ ዳራሳ። ሄሳ ግሾ፥ ኔኒ ካታማን ኡታዳ ኑስ ማዶ ኪትኮ ሎኦ” ያግስ።<verse eid="2SA 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 18:4"/>ካዎይ፥ “ህንተና ሎእያባ ታ ኦና” ያግስ።</para>
  <para style="p" vid="2SA 18:4">ዳዊቲ ድርሳ ፐንግያ ማታን ኤቅድ፥ አሳ ኡባይ ፄታንነ ሙኩላን ሳልፕድ ከይሽን በእስ። <verse eid="2SA 18:4"/><verse number="5" style="v" sid="2SA 18:5"/>ካዎይ እዮኣባ፥ አብሳነ እታያ፥ “ታ ግሾ ግድ፥ ሄ ናአተ አድያ አበሰሎመ ቆሆፕተ” ያግድ ኪትስ። ካዎይ ሄሳ ሀላቃታስ ኦድያ ዎደ ኦላንቾት ኡባይ ስእዶሶና።<verse eid="2SA 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 18:6"/>ዳዊታ ኦላንቾት እስራኤለታራ ኦለታናዉ ኤፍሬማ ዎራን ሳልፕዶሶና። <verse eid="2SA 18:6"/><verse number="7" style="v" sid="2SA 18:7"/>ሄ በሳን ዳዊታ ኦላንቾት እስራኤለ ኦላንቾታ ፆንዶሶና። ሄ ጋላስ ዳሮ አስ ዉርስ፥ ላታሙ ሙኩሉ አስ ሀይቅስ። <verse eid="2SA 18:7"/><verse number="8" style="v" sid="2SA 18:8"/>ኦላይ ጋፃረ ኡባ ጋክስ፤ ሄ ጋላስ ዎር ዉርስዳ አሳይ ማሽ ዉርስዳ አሳፐ ዳሮ።<verse eid="2SA 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 18:9"/>አበሰሎመይ ቆፖና ደእሸ ዳዊታ አሳራ ጋሄትስ። አበሰሎመይ ባ ባቁሉዋ ቶግዳሽን ዳሻ ዎላ ጋርስ ባቁሎይ ገልን፥ አበሰሎመ ሁጰይ ምን ኦይከትስ። እ ቶግዳ ባቁሎይ እያ ቶሁዋ ጋርሳፈ ብን፥ አበሰሎመይ ጫርኮ ቦላ ካቃትድ አትስ። <verse eid="2SA 18:9"/><verse number="10" style="v" sid="2SA 18:10"/>አሳፐ እሶይ ሄሳ በእድ፥ “አበሰሎመይ እስ ዎላ ቦላ ካቀትዳይሳ ታ በአስ” ያግድ እዮኣባስ ኦድስ።<verse eid="2SA 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 18:11"/>እዮኣብ ባዉ ኦድዳ አድያ፥ “ዬ፥ በአስ ጋይ? ያትን አይስ እያ ዎብኪ? ነ ሄሳ ኦዳባ ግድያኮ፥ ታኒ ነዉ ታሙ ብራ ሳንትመነ እስ ሳቀ እማናሽን” ያግስ።<verse eid="2SA 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 18:12"/>አደይ ዛሪድ፥ “ኔኒ ሙኩሉ ብራ ሳንትመ ታ ኩሸን ዎያኮካ ታኒ ካዋ ናኣ ቦላ ታ ኩሽያ ደንከ! ኑኒ ኡባይ ስእሽን፥ ካዎይ ነና፥ አብሳነ እታያ፥ ‘ታ ግሾ ግድ፥ ናአተ አበሰሎመ ቆሆፕተ’ ያግድ ኪትስ። <verse eid="2SA 18:12"/><verse number="13" style="v" sid="2SA 18:13"/>ታኒ ካዋ እፃዳ አበሰሎመ ዎዳባ ግድያኮ፥ ካዎይ ኡባ ስኤይሳዳ ሄሳ ስአናይስ አተና። ሄ ዎደ ኔኒ ሃክ ኤቅያ አሳፐ እሱዋ ግዳና” ያግስ።<verse eid="2SA 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 18:14"/>እዮኣብ፥ “ታኒ ኔራ ኦደታሸ ዎደ ዉርስከ” ያግድ ሄ ቶራ ኤክድ፥ አበሰሎመይ ዎላ ቦላ ካቀትድ፥ ፓፃ ደእሽን ዎዛና አይፈን ጫድስ። <verse eid="2SA 18:14"/><verse number="15" style="v" sid="2SA 18:15"/>እዮኣባ ኦላ ሚሽያ ቶክያ ታሙ አሳት አበሰሎመ ዩሹዋ ተቅድ እያ ሾጭድ ዎዶሶና።<verse eid="2SA 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 18:16"/>ሄሳፈ ጉየ፥ እዮኣብ ኦላ ኤሳናዉ ሞይዘ ፑንን አሳይ እስራኤለታ የደይሳ አግስ። <verse eid="2SA 18:16"/><verse number="17" style="v" sid="2SA 18:17"/>ኤንቲ አበሰሎመ ኤፍድ ዎራን ደእያ ግታ ኦላን የግድ፥ ግታ ሹቹ እያ ቦላ ዶርዶሶና። ሄ ዎደ እስራኤለ አሳ ኡባይ ባ ሶ ሶ ባቃትስ።<verse eid="2SA 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 18:18"/>አበሰሎመይ ፓፃ ደእሸ፥ “ታ ሱንን ፄገትያ አደ ናእ ታዉ ባዋ” ያግድ፥ ባና ቆፍስያ ሹቹ ማስዳ ሀዉልተ ካዎ ዛንጋራን ኤስድ ሄ ሀዉልትያ ባ ሱንን ፄግስ። ሀች ጋካናዉ ሄ ሀዉልተይ “አበሰሎመ ሀዉልትያ” ጌተቴስ።<verse eid="2SA 18:18"/></para>
  <para style="s1">ዳዊቲ አበሰሎመስ ዬክስ</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19"/>ሄሳፈ ጉየ፥ ሳዶቃ ናኣ አክማስ እዮኣባኮ፥ “እያ ሞርከታ ኩሸፐ ጎዳይ እያ አሽዳ ምሽራቹዋ ስሳናዉ ታኒ ካዋኮ ዎፃ ባዳ ኦዳና” ያግስ።<verse eid="2SA 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 18:20"/>እዮኣብ፥ “አካይ! ሀች ኔኒ ምሽራቾ ኦድያ ጋላስ ግደና፤ ሀራ ጋላስ ኦዳናዉ ዳንዳኣሳ። ካዋ ናአይ ሀይቅዳ ግሾ ሀች ኦዳናዉ ኮሸና” ያግስ።<verse eid="2SA 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 18:21"/>እዮኣብ ቶጰ አስ ግድዳ እስ አድያ ፄግድ፥ “ባዳ፥ ነ በእዳባ ካዋስ ኦዳ” ያግስ። ሄ አደይ እዮኣባስ ጉፋን ዝግድ ዎፅስ።<verse eid="2SA 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 18:22"/>ሳዶቃ ናአይ አክማስ ናምአን እዮኣባኮ፥ “አይብካ ሀኖ፤ ታኒ ሀ ቶጰ አድያ ጌዶ ዎፃና” ያግስ።</para>
  <para style="p" vid="2SA 18:22">እዮኣብ፥ “ታ ናአዉ፥ ነዉ ዎይቶይ ባይናባን አይስ ዎፃናዉ ኮያይ?” ያግስ።<verse eid="2SA 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 18:23"/>አክማስ፥ “አይብካ ሀኖ፤ ታኒ ዎፃናዉ ኮያይስ” ያግስ።</para>
  <para style="p" vid="2SA 18:23">እዮኣብ፥ “ያኮ ዎፃ” ያግስ። ሄሳ ግሾ፥ አክማስ ደምባ ኦግያ ኦይክድ ዎፅሸ ብድ ቶጰ አድያ የግድ አስ።<verse eid="2SA 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 18:24"/>ዳዊቲ ሶ ፐንግያፈነ ካረ ፐንግያፈ ግዶን ኡትዳሽን፥ ናግያ ኡራይ ኬ ቦላ ከይድ፥ እስ አደይ ባርካ ዎፅሸ የይሳ በእስ። <verse eid="2SA 18:24"/><verse number="25" style="v" sid="2SA 18:25"/>ናግያ ኡራይ ካዋ ፄግድ ኦድስ።</para>
  <para style="p" vid="2SA 18:25">ካዎይ፥ “እ ባርካ ደእኮ፥ ምሽራቾ ኤክድ ዬስ” ያግስ። ዎፅያ አደይ ኤንታኮ ማትሸ ይስ።<verse eid="2SA 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 18:26"/>ናገይስ ሀራ ዎፅያ አስ በእድ ፐንግያ ናግያ አድያኮ፥ “ሀራ አስካ ባርካ ዎፅሸ ዬስ” ያግስ።</para>
  <para style="p" vid="2SA 18:26">ካዎይ፥ “ሀ አደይካ ቃስ ምሽራቾ ኤክድ ዬስ” ያግስ።<verse eid="2SA 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 18:27"/>ናገይስ፥ “ኮይሮ አድያ ዎይ ሳዶቃ ናኣ አክማሳ ዎ ታዉ ዳኔስ” ያግስ።</para>
  <para style="p" vid="2SA 18:27">ካዎይ፥ “እ ሎኦ አስ፤ እ ሎኦ ኦዳራ ዬስ” ያግስ።<verse eid="2SA 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 18:28"/>አክማስ ካዋ ፄግድ፥ “ኡባባይ ሎኦ!” ያግስ። ካዋ ስንን ጉፋን ዝግድ፥ “ታ ጎዳ፥ ካዋ ቦላ ባንታ ኩሽያ ደንዳ አሳታ ነዉ አድ እምዳ ጎዳይ፥ ነ ፆሳይ ጋላተቶ” ያግስ።<verse eid="2SA 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 18:29"/>ካዎይ፥ “ናአተይ፥ አበሰሎመይ ሳሮ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 18:29">አክማስ፥ “እዮኣብ ታና ኪታና ሀንያ ዎደ ዎልቃማ ዋሶ ስአስ፥ ሽን እ አይበኮ ታኒ ኤራብከ” ያግስ።<verse eid="2SA 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 18:30"/>ካዎይ፥ “ያ ሺቃ ኤቃ” ያግን እ ሃክድ ኤቅስ።<verse eid="2SA 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 18:31"/>ሄሳፈ ጉየ፥ ቶጰ አደይ ጋክድ፥ “ታ ጎዳዉ፥ ካዋዉ፥ ታ ነዉ ምሽራቾ ኦዳይስ! ነ ቦላ ደንድያ ኡባ ኩሸፐ ጎዳይ ሀች ነና አሽስ” ያግስ።<verse eid="2SA 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 18:32"/>ካዎይ ቶጰ አድያኮ፥ “ናአተ አደይ አበሰሎመይ ሳሮ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2SA 18:32">ቶጰ አደይ፥ “ታ ጎዳዉ፥ ካዋዉ፥ ነ ሞርከትነ ነ ቦላ ኢታባ ኦናዉ ደንደይሳት ኡባይ ሄ ናአተ አድያዳ ሀኖና” ያግስ።<verse eid="2SA 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 18:33"/>ካዎይ ዳሮ አዛንስ፤ ፐንግያፈ ቆሞ ባጋን ደእያ ኬ ገልድ ዬክስ። ካዎይ፥ “ዪ፥ ታ ናአዉ አበሰሎመ ታሳ! ታ ናአዉ ታሳ! ነ ግሾ ታ ሀይቃርክና! ዪ፥ ታ ናአዉ አበሰሎመ ታሳ!” ያግድ ዬክስ።<verse eid="2SA 18:33"/></para>
  <chapter eid="2SA 18"/>
  <chapter number="19" style="c" sid="2SA 19"/>
  <para style="p">
    <verse number="1" style="v" sid="2SA 19:1"/>ካዎይ፥ “ባ ናኣ አበሰሎመስ ዬከስነ ዘሌለስ” ያግድ እዮኣባስ ኦድዶሶና። <verse eid="2SA 19:1"/><verse number="2" style="v" sid="2SA 19:2"/>ካዎይ ባ ናኣስ ዬከይሳ ስእዳ ግሾ፥ ሄ ጋላስ ኤንቲ ኡባይ ፆንዳ ፆኖይ ዬሆን ላመትስ። <verse eid="2SA 19:2"/><verse number="3" style="v" sid="2SA 19:3"/>ኦላፐ ባቃትድ ዬላን ጉየ ስምዳ ኦላንቾዳ ሄ ጋላስ አሳይ ዶና ፖጎና ካታማ ገልዶሶና። <verse eid="2SA 19:3"/><verse number="4" style="v" sid="2SA 19:4"/>ካዎይ ጉሉንትድ፥ ባ ቃላ ቁ ኦድ፥ “ዪ፥ ታ ናአዉ አበሰሎመ! ዪ፥ ታ ናአዉ! አበሰሎመ ዪ!” ያግድ ዘሌልስ።<verse eid="2SA 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 19:5"/>ሄሳፈ ጉየ፥ እዮኣብ ካዋ ሶ ብድ፥ “ነና፥ ነ አደ ናይታ፥ ነ ማጫ ናይታ፥ ነ ማቸታነ ነ ላገታ አሽዳ ነ አሳ ኡባ ሀች ኔኒ ካዉሻዳሳ። <verse eid="2SA 19:5"/><verse number="6" style="v" sid="2SA 19:6"/>ነና እፀይሳታ ኔኒ ዶሳሳ፤ ነና ዶሰይሳታ ኔኒ እፃሳ። ነ ኦላንቾትነ ኤንታ ሀላቃት ነዉ አይኮካ ግዶናይሳ ኔኒ ሀች ቆንጭሳዳሳ። ኑኒ ኡባይ ሀይቅን፥ አበሰሎመይ ሀች ፓፃ አትዳኮ ኔኒ ኡፋይታናይሳ ታ በአስ። <verse eid="2SA 19:6"/><verse number="7" style="v" sid="2SA 19:7"/>ሀእ ደንዳ! ካረ ከያዳ ነ አሳ ምን። ታ ጎዳ ሱንን ጫቃይስ፤ ኔኒ ከዮና እፅኮ፥ ሀች ቃማ ኔራ እስ አስካ አተና። ናአተፈ ሀች ጋካናዉ ነና ጋክዳ ኢታ ኡባፈ ሀይስ ነዉ አዳ ኢታ ግዳና” ያግስ።<verse eid="2SA 19:7"/></para>
  <para style="s1">ዳዊቲ የሩሳላመ ስምስ</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 19:8"/>ሄሳ ግሾ፥ ካዎይ ደንድድ ፐንግያ ማታን ኡትስ። ካዎይ ፐንገን ኡትዳይሳ አሳ ኡባይ ስእዳ ዎደ ካዋኮ ይዶሶና።</para>
  <para style="p" vid="2SA 19:8">ሄ ዎደ እስራኤለ አሳ ኡባይ ባንታ ሶ ሶ ባቃትዶሶና። <verse eid="2SA 19:8"/><verse number="9" style="v" sid="2SA 19:9"/>እስራኤለ ኮቻት ኡባይ እሶይ እሱዋራ ሀይሳዳ ያግድ ፓላምዶሶና፤ “ካዎይ ዳዊቲ ኑና ኑ ሞርከታ ኩሸፐ አሽስ፤ ኑና ፍልስፄመታ ኩሸፐ ዎስስስ፤ ሽን እ ሀእ አበሰሎመ ጋሶን ቢታ አግድ ባቃትስ። <verse eid="2SA 19:9"/><verse number="10" style="v" sid="2SA 19:10"/>ኑ ቦላ ካዎታናዳ ኑኒ ትይዳ አበሰሎመይ ኦላን ሀይቅስ። ያትን፥ ካዋ ጉየ ኤሀናባ ህንተ አይስ ስእ ግደቲ?” ያግዶሶና።<verse eid="2SA 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 19:11"/>ካዎይ ዳዊቲ ካህነታ ሳዶቃነ አብያታራ ኪትድ፥ ይሁዳ ጭማታኮ ሀይሳዳ ያግስ፤ “እስራኤለ አሳ ኡባይ ኦደትያ ኦዳይ ካዋ ጋክስ። ያትን፥ ካዋ እያ ጋ ዛር ኤሀናዉ ህንተ አይስ ጉየ አቴቲ? <verse eid="2SA 19:11"/><verse number="12" style="v" sid="2SA 19:12"/>ህንተ ታ እሻታ፤ ህንተ ታ አሾነ ታ ሱ። ያትን፥ ካዋ ጉየ ዛር ኤሀናዉ ህንተ አይስ ሀራታፐ ጉየ አቴቲ?” ያግስ። <verse eid="2SA 19:12"/><verse number="13" style="v" sid="2SA 19:13"/>ቃስ ዳዊቲ አማሳኮ፥ “ኔኒ ታ አሾነ ታ ሱ ግድኪ? ሀችፈ ዶምን፥ ታኒ ነና እዮኣባ በሳን ታ ቶራ ሞጮና ኦና እፅኮ፥ ፆሲ ታና ፕርዶ” ያግስ።<verse eid="2SA 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 19:14"/>እ ይሁዳ አሳ ኡባ ዎዛና እስኖ ኦድ ሻምስ። ሄሳ ግሾ፥ ኤንቲ ካዋኮ ኪትድ፥ “ኔራ ነ አሳራ ኡባይ ሃ ስምተ” ያግዶሶና። <verse eid="2SA 19:14"/><verse number="15" style="v" sid="2SA 19:15"/>ካዎይ ስሚድ፥ ዮርዳኖሰ ሻፋ ጋካናዉ ይስ። ይሁዳ አሳይ ካዋ ዮርዳኖሰ ሻፋ ፕንናዉ ጋልጋላ ብዶሶና።<verse eid="2SA 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 19:16"/>ብራቅማ አደይ፥ ብንያመ ኮቻይ፥ ጌራ ናአይ ሳም ዳዊታ ሞካናዉ ኤለስድ ይሁዳ አሳራ ብስ። <verse eid="2SA 19:16"/><verse number="17" style="v" sid="2SA 19:17"/>እያራ ብንያመ ኮቸ ግድዳ ሙኩሉ አሳይ፥ ሳኦላ አይለይ ሲብ፥ ታማነ እቻሹ እያ ናይትነ ላታሙ አይለት እያራ ደኦሶና። ኤንቲ ካዎይ ደእያ በሳ ዮርዳኖሰ ሻፋ ድርግሸ ብዶሶና። <verse eid="2SA 19:17"/><verse number="18" style="v" sid="2SA 19:18"/>ካዋ ሶ አሳ ኤሀናዉነ ካዋ ኡፋይስያባ ኦናዉ ፕንያ በሳራ ፕንዶሶና።</para>
  <para style="p" vid="2SA 19:18">ጌራ ናአይ ሳም ዮርዳኖሰ ሻፋ ፕንዳ ዎደ ካዋ ስንን ጉፋንድ፥ <verse eid="2SA 19:18"/><verse number="19" style="v" sid="2SA 19:19"/>“ካዋዉ ታ ናጋራ ታይቦፓ። ታ ጎዳይ፥ ካዎይ፥ የሩሳላመፐ ከይያ ዎደ ታኒ ነ አይለይ ቆህዳ ቆሁዋ ሀሳዮፓ። ሄሳ ነ ኡሎን ኦይኮፋ። <verse eid="2SA 19:19"/><verse number="20" style="v" sid="2SA 19:20"/>ነ አይለይ ታኒ ናጋራ ኦዳይሳ ኤራይስ፤ ሽን ታ ጎዳ፥ ካዋ ሞካናዉ ዮሰፋ ሶ አሳ<note caller="+" style="f"><char style="fr" closed="false">19:20 </char><char style="ft" closed="false">ዎይኮ ፑደሀ ባጋን ደእያ እስራኤለ ዘረ ኡባፈ ጉሱ።</char></note> ኡባፈ ኮይሮታዳ ታኒ ሀች ያስ” ያግስ።<verse eid="2SA 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 19:21"/>ፃሩያ ናአይ አብስ፥ “ሳም ጎዳይ ትይዳ ካዋ ባድዳ ግሾ ሀይቃናዉ በሰነዬ?” ያግስ።<verse eid="2SA 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 19:22"/>ዳዊቲ አብሳኮ፥ “ህንተኖ፥ ፃሩያ ናይቶ፥ ህንተና ጋያባይ አይቤ? ህንተ ሀች ታዉ ሞርከ ግዴት! ሀች እስራኤለን አይ አስካ ሀይቀና! ሀች እስራኤለ ካዎይ ታና!” ያግስ።<verse eid="2SA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 19:23"/>ካዎይ ሳም፥ “ነ ሀይቃካ” ያግድ ጫቅስ።<verse eid="2SA 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24"/>ቃስ ሳኦላ ናአይ መምፕቦስተይ ካዋ ሞካናዉ ዱገ ዎስ። ካዎይ ብዳ ጋላሳፐ ዶምድ እ ሳሮን ጉየ ስምያ ጋላስ ጋካናዉ መምፕቦስተይ ባ ቶሁዋነ ባ ማኡዋ ሜጭቤና፤ ባ ቡቻ ሜድቤና። <verse eid="2SA 19:24"/><verse number="25" style="v" sid="2SA 19:25"/>መምፕቦስተይ ካዉዋራ ጋሄታናዉ የሩሳላመፐ ይዳ ዎደ ካዎይ፥ “መምፕቦስተ፥ ኔኒ ታራ አይስ ባብኪ?” ያግድ ኦይችስ።<verse eid="2SA 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 19:26"/>መምፕቦስተይ፥ “ታ ጎዳዉ ካዋዉ፥ ታኒ ነ አይለይ ስላ ግድያ ግሾ ‘ታኒ ቶጋዳ ካዉዋራ ባና መላ ታ ሀርያ ኮራ’ ያጋስ። ሽን ታ አይለይ ሲብ ታና ጭምስ። <verse eid="2SA 19:26"/><verse number="27" style="v" sid="2SA 19:27"/>ታ ጎዳ፥ ካዋስ ዎርዶ ኦድድ ታ ሱን ኢስስ። ኔኒ ታ ጎዳይ፥ ካዎይ ፆሳ ኪታንቾ መላ ግድያ ግሾ ነና ሎእዳባ ኦ። <verse eid="2SA 19:27"/><verse number="28" style="v" sid="2SA 19:28"/>ታ አዋ ሶ አሳ ኡባይ ሀይቃናዉ በሴስ፥ ሽን ታኒ ነ አይለይ ነ ጋይታፐ መይሳታራ ማና መላ ታዉ በሰ እማዳሳ። ያትን፥ ሄሳፈ አያባ ካዋ ኦይቻናዉ ታዉ አይ ማት ደኢ?” ያግስ።<verse eid="2SA 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 19:29"/>ካዎይ ዛሪድ፥ “ኔኒ ዳሮባ ኦደታናዉ ኮሸና። ኔራ ሲባራ ጋድያ ሻከትድ ኤካና መላ ኪታስ” ያግስ። <verse eid="2SA 19:29"/><verse number="30" style="v" sid="2SA 19:30"/>መምፕቦስተይ፥ “ታ ጎዳይ፥ ካዎይ ሳሮ ሶ ስማፈ አትሽን፥ ኡባይ ሲባስ ግዶ” ያግስ።<verse eid="2SA 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31"/>ጋላዳ አደይ ባርዝለይ ካዉዋራ እስፈ ዮርዳኖሰ ፕንድ እያ ሞይዛናዉ ሮጋልማፐ ይስ። <verse eid="2SA 19:31"/><verse number="32" style="v" sid="2SA 19:32"/>ባርዝለይ ላይ ሆስፑን ታሙ ግድዳ ጭማ አስ። እ ዳሮ ዱረ ግድያ ግሾ ካዎይ ማሀናይማ ካታማን ደእያ ዎደ ካዋስ ኮሽያባ እሚስ። <verse eid="2SA 19:32"/><verse number="33" style="v" sid="2SA 19:33"/>ካዎይ እያኮ፥ “ኔኒ ታራ የሩሳላመ የ፤ ታኒ ነዉ ኮሽያባ እማና” ያግስ።<verse eid="2SA 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 19:34"/>ሽን ባርዝለይ፥ “ታኒ ህዛፐ ዳሮ ላይ ደእከ፤ ታኒ ካዉዋራ የሩሳላመ አይስ ቦ? <verse eid="2SA 19:34"/><verse number="35" style="v" sid="2SA 19:35"/>ታኒ ሀእ ሆስፑን ታሙ ላይ አስ፤ ታኒ ኢታነ ሎኦ ሻካዳ ኤራናዉ ዳንዳእያና? ታኒ ነ አይለይ ታ ምያባነ ኡያባ ማልኡዋ ሻካዳ ኤራናዉ ዳንዳእያና? ታኒ አደነ ማጫ የ ሻካዳ ስአናዉ ዳንዳእያና? ያትን፥ ታኒ ነ አይለይ፥ ታ ጎዳዉ ካዋዉ አይስ ቶሆ ግዶ? <verse eid="2SA 19:35"/><verse number="36" style="v" sid="2SA 19:36"/>ታኒ ነ አይለይ ነና ዮርዳኖሰ ፕንና። ሽን ካዎይ ታዉ ኩሸ ዛራናዉ አይስ ኮሺ? <verse eid="2SA 19:36"/><verse number="37" style="v" sid="2SA 19:37"/>ታኒ ታ አዋነ ታ አየ ዱፉዋ ማታን ታ ካታማን ሀይቃና መላ ስማይስ። ነ አይለይ ክምሃም ሀይስሽ፤ ታ ጎዳ፥ ካዉዋራ እ ቦ፤ ነና ኡፋይስያባ እያዉ ኦ” ያግስ።<verse eid="2SA 19:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 19:38"/>ካዎይ፥ “ክምሃም ታራ ፕኖ፤ ነና ኡፋይስያባ ታኒ እያዉ ኦና። ቃስ ኔኒ ታና ኦይችያባ አይባ ግድኮካ ታኒ ነዉ ኦና” ያግስ። <verse eid="2SA 19:38"/><verse number="39" style="v" sid="2SA 19:39"/>ሄሳፈ ጉየ፥ አሳ ኡባይ ዮርዳኖሰ ፕንዶሶና፤ ካዎይካ ፕንስ። ካዎይ ባርዝለ ዬርድ አንጅስ፤ ባርዝለይ ባ ሶ ስምስ።<verse eid="2SA 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="2SA 19:40"/>ካዎይ ዮርዳኖሰ ፕንድ ጋልጋላ ብያ ዎደ ክምሃም እያራ እስፈ ብስ። ይሁዳ ኦላንቾት ኡባይነ እስራኤለ ኦላንቾታፐ ባጋት ካዉዋራ ብዶሶና።<verse eid="2SA 19:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="2SA 19:41"/>እስራኤለ ኡባይ ካዋኮ ብድ፥ “ኑ እሻት፥ ይሁዳ አሳይ ካዋነ እያ ሶ አሳ ቆስድ፥ እያ አሳራ እስፈ ዮርዳኖሰ አይስ ፕንዶና?” ያግዶሶና።<verse eid="2SA 19:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="2SA 19:42"/>ይሁዳ አሳይ፥ “ኑኒ ሄሳ ኦዳይ ካዎይ ኑስ ማታ ዳቦ ግድያ ግሾሳ። ያትን፥ ህንተ ሄሳስ አይስ ይሎተቲ? ኑኒ ካዉዋፐ አይኮ ምዶ? ዎይኮ ኑኒ እያፐ አይኮ ኤክዶ?” ያግዶሶና።<verse eid="2SA 19:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="2SA 19:43"/>እስራኤለ አሳይ፥ “ካዉዋፐ ታሙ ኩሸይ ኑሳ፤ ዳዊታ ማታን ኑስ ህንተፈ አ ማት ደኤስ! ያትን፥ ህንተ ኑና አይስ ካደቲ? ካዋ ጉየ ዛሪድ ኤሀናዉ ኮይሮትድ ኦድዳይ ኑና ግዶኮ?” ያግዶሶና።</para>
  <para style="p" vid="2SA 19:43">ሽን እስራኤለ አሳፐ ይሁዳ አሳይ ዳሮ ዎልቃንድ ሃሳይዶሶና።<verse eid="2SA 19:43"/></para>
  <chapter eid="2SA 19"/>
  <chapter number="20" style="c" sid="2SA 20"/>
  <para style="s1">ሳበእ ዳዊታ ቦላ ደንድስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1"/>ብንያመ ኮቸ ግድዳ ብክራ ናአይ ሳበአ ጌተትያ መቶ መያ አደይ ያን ደኤስ። ሄ አደይ ሞይዘ ፑንድ፥ “ኑስ ዳዊታራ ግሾይ ባዋ! እሰየ ናኣራ ኑስ ላት ባዋ! እስራኤለ አሳዉ፥ ኡባይ ህንተ ሶ ሶ ገልተ!” ያግስ። <verse eid="2SA 20:1"/><verse number="2" style="v" sid="2SA 20:2"/>እስራኤለ አሳ ኡባይ ዳዊታ አግድ፥ ብክራ ናኣ ሳበኤራራ ብዶሶና። ሽን ይሁዳ አሳይ ዮርዳኖሰፐ የሩሳላመ ጋካናዉ አጎና ባንታ ካዋ ካልዶሶና።<verse eid="2SA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 20:3"/>ዳዊቲ የሩሳላመን ደእያ ባ ጋ ስምዳ ዎደ፥ ካዎ ጋ ናጋና መላ አሽዳ ታሙ ላገታ ኤፍድ እስ ኬን ናግስድ ዎስ። ኤንታዉ ኮሽያባ እሚስ፥ ሽን ኤንታራ አቅቤና። ኤንቲ ሄ ኬን ናገትድ፥ ሀይቃና ጋካናዉ አምኦ ግድድ ደእዶሶና።<verse eid="2SA 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 20:4"/>ካዎይ አማሳኮ፥ “ይሁዳ አሳ ኡባ ሄ ጋላሳን ታዉ ፄጋዳ ሺሻ፤ ነካ ኤንታራ ሺቃ” ያግስ። <verse eid="2SA 20:4"/><verse number="5" style="v" sid="2SA 20:5"/>አማስ ይሁዳ አሳ ፄጋናዉ ብስ፤ ሽን ካዎይ ግዳ ጋላሳን ስማናዉ ዳንዳእቤና።<verse eid="2SA 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 20:6"/>ዳዊቲ አብሳኮ፥ “ሀእ ብክራ ናኣ ሳበእ አበሰሎመፐ አድ ኑና ቆሀና። ነ ጎዳ ኦላንቾታ ኤካዳ ኔኒ እያ ጌዶ ካላ። ሄስ ሀኖና እፅኮ እ ግምበትዳ ካታማታ ደምድ ኑፐ ከስ ኤካና” ያግስ። <verse eid="2SA 20:6"/><verse number="7" style="v" sid="2SA 20:7"/>እዮኣባ አሳይ፥ ካዋ ናገይሳትነ ምኖ ኦላንቾት ኡባይ አብሳራ ብክራ ናኣ ሳበአ ጌዶ ካላናዉ የሩሳላመፐ ከይድ ብዶሶና።<verse eid="2SA 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 20:8"/>ኤንቲ ብድ ጋባኦናን ደእያ ዎጋ ዛላ ጋክያ ዎደ አማስ ኤንታራ ጋሄታናዉ ይስ። እዮኣብ ኦላ ማኡዋ ማእ ኡትስ፤ ባ ፄሳን ማሻ ዳንጭስ። እ ታንግሽን እያ ማሻይ ሾሁዋፐ ከስ ኤክድ ዎስ።<verse eid="2SA 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 20:9"/>እዮኣብ፥ “ታ እሻዉ፥ ነ ሳሮ ደአይ?” ያግድ፥ አማሳ ዬራናዉ ባ ኡሻቻ ኩሽያን እያ ቡቻ ኦይክስ። <verse eid="2SA 20:9"/><verse number="10" style="v" sid="2SA 20:10"/>ሽን አማስ እዮኣባ ሀድርሳ ኩሽያን ደእያ ማሻ በእቦና ግሾ፥ እያፐ ናገትቤና። እዮኣብ እያ ኡሉዋን ጫድድ ማራጭያ ቢታን ዛዝስ። አማስ እስ ጫቻን ሀይቅዳ ግሾ ዛር ጫድቤና።</para>
  <para style="p" vid="2SA 20:10">እዮኣብነ እያ እሻ አብስ ብክራ ናኣ ሳበአ ጌዶ ካልዶሶና። <verse eid="2SA 20:10"/><verse number="11" style="v" sid="2SA 20:11"/>እዮኣባ አሳፐ እሶይ አማሳ አሀ ማታን ኤቅድ፥ “እዮኣባ ዶሰይነ ዳዊታባ ግድያ ኦንካ እዮኣባ ካሎ” ያግስ። <verse eid="2SA 20:11"/><verse number="12" style="v" sid="2SA 20:12"/>አማስ ሱን ኢትድ ኦግያስ ግዶን ኩንድድ ዝንእስ። ኦላንቾት ኡባይ ይድ፥ ሄ በሳን ኤቅዳይሳ ሄ አደይ በእድ፥ አማሳ አሀ ኦግያፐ ሾቃን ጎች ከስድ፥ እያ ቦላ ማኦ የግስ። <verse eid="2SA 20:12"/><verse number="13" style="v" sid="2SA 20:13"/>አማሳ ኦገፐ ድግዳፐ ጉየ፥ ብክራ ናኣ ሳበአ ጌዶ ካላናዉ ኦላንቾት ኡባይ እዮኣባራ ብዶሶና።<verse eid="2SA 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14"/>ሳበእ እስራኤለ ኮቻታ ቢታራ ካንድ፥ አቤል-ቤት-ማእካ ካታማ ጋክስ። በራታ ቢታራ ካንሽን፥ አሳ ኡባይ ሺቅድ እያ ካልዶሶና። <verse eid="2SA 20:14"/><verse number="15" style="v" sid="2SA 20:15"/>እዮኣባራ ደእያ አሳይ ጋክድ፥ ሳበእ ደእያ አቤል-ቤት-ማእካ ካታማ ተቅዶሶና። ኤንቲ ካታማ ግምብያስ ጉየ ባጋራ ቢታ ዶርዶሶና። እዮኣባራ ደእያ አሳይ ግምብያ ላላናዉ ቆፆሶና። ኤንቲ ቆፅሽን፥ <verse eid="2SA 20:15"/><verse number="16" style="v" sid="2SA 20:16"/>ካታማፐ እስ ጭንጫ ማጫስ ኤንታ ፄጋዳ፥ “ስእተ! ስእተ! ብድ፥ እዮኣባ ፄግተ። ታኒ እያዉ ኦዳናባይ ደኤስ” ያጋሱ። <verse eid="2SA 20:16"/><verse number="17" style="v" sid="2SA 20:17"/>እ ማጫሴኮ ይን፥ እያ፥ “ኔኒ እዮኣቤ?” ያጋዳ ኦይቻሱ።</para>
  <para style="p" vid="2SA 20:17">እዮኣብ፥ “ኤ፥ ታና” ያግስ።</para>
  <para style="p" vid="2SA 20:17">ማጫስያ፥ “ታኒ ነ አይልያ ግያባ ስአ” ያጋሱ።</para>
  <para style="p" vid="2SA 20:17">እዮኣብ፥ “ታኒ ስአይስ” ያግስ።<verse eid="2SA 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 20:18"/>ማጫስያ፥ “በን ዎደ አሳይ፥ ‘ነ ኦይሻስ አብኤላ ካታማ ባ’ ጊኮ ኦድ ዉሬስ። <verse eid="2SA 20:18"/><verse number="19" style="v" sid="2SA 20:19"/>እስራኤለ ግዶን ሳሮነ አማንያ አስ ኑና። እስራኤለ ቢታን አዮ ግድዳ ካታምዉ ኔኒ ይሳናዉ ቆፓሳ። ኔኒ ጎዳ ላታ ቢታ አይስ ይሳናዉ ኮያይ?” ያጋሱ።<verse eid="2SA 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 20:20"/>እዮኣብ፥ “ሄስ ታፐ ሃኮ! ካታማ ይሶይ ዎይኮ ላለ ታፐ ሃኮ! <verse eid="2SA 20:20"/><verse number="21" style="v" sid="2SA 20:21"/>ኑ ቆፋይ ሄሳ ግደና። ደረይ ዳርያ ኤፍሬማ ቢታን ብክራ ናኣ ሳበአ ጌተትያ አደይ ካዋ ዳዊታ ቦላ ደንድስ። ሄ አድያ ታዉ እምተ፤ ታኒ ካታማ የዳዳ ባና” ያግስ።</para>
  <para style="p" vid="2SA 20:21">ማጫስያ፥ “እያ ሁጵያ ግምብያ ቦላራ ነዉ ሆላና” ያጋሱ።<verse eid="2SA 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 20:22"/>ሄሳፈ ጉየ፥ ማጫስያ ባ ጭንጫ ዞርያራ አሳኮ ባሱ። አሳይ ብክራ ናኣ ሳበአ ቆፐ ቃንፅድ ሁጵያ እዮኣባስ ሆልዶሶና። ያትን፥ እዮኣብ ሞይዘ ፑንን አሳ ኡባይ ካታማፐ ከይድ፥ ባ ሶ ሶ ብን፥ እዮኣብ ካዋኮ የሩሳላመ ስምስ።<verse eid="2SA 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 20:23"/>እዮኣብ እስራኤለ ኦላንቾታ ኡባ ሀላቃ ግድሽን፥ ዮዳሄ ናአይ ባናያስ ዳዊታ ናገይሳታ ሀላቃ። <verse eid="2SA 20:23"/><verse number="24" style="v" sid="2SA 20:24"/>አዶንራም ዎልቃ ኦሶ ኦይሳታ ሀላቃ ግድሽን፥ አህሉዳ ናአይ እዮሳፍፅ ሀንዳባ ፃፈይሳ። <verse eid="2SA 20:24"/><verse number="25" style="v" sid="2SA 20:25"/>ሱስ ዋና ፃፈ ግድሽን፥ ሳዶቅነ አብያታር ካህነ። <verse eid="2SA 20:25"/><verse number="26" style="v" sid="2SA 20:26"/>ቃስ ያእራ አደይ እርክ ዳዊታ ካህነታፔ እሱዋ።<verse eid="2SA 20:26"/></para>
  <chapter eid="2SA 20"/>
  <chapter number="21" style="c" sid="2SA 21"/>
  <para style="s1">ጋባኦናታ ሀሎ ከሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1"/>ዳዊታ ካዎተ ላይን ቢታይ ሄ ላይ ኩመ ኮሻትስ። ሄሳ ግሾ፥ ዳዊታ ጎዳ ኦይችን፥ ጎዳይ፥ “ሄስ ሀንዳይ ሳኦልነ እያ ሶ አሳይ ጋባኦና አሳ ዎዳ ግሾ ሱ ጎመይ ኤንታ ጋክስ” ያግስ።<verse eid="2SA 21:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 21:2"/>ያትን ካዎይ ጋባኦና አሳ ፄግድ ኦድስስ። ጋባኦና አሳት እስራኤለ ዛረ ግዶናሽን፥ ኤንቲ አሞረ አሳፐ አትዳይሳታ። እስራኤለት ኤንታ አሻናዉ ኤንታራ ጫቅዶሶና፤ ሽን ሳኦል እስራኤለስነ ይሁዳስ ምሸትዳ ግሾ፥ ኤንታ ኩመ ይሳናዉ ኮይስ። <verse eid="2SA 21:2"/><verse number="3" style="v" sid="2SA 21:3"/>ዳዊቲ ጋባኦና አሳ፥ “ታኒ ህንተዉ አይ ኦ? ጎዳ ላታ ህንተ አንጃና መላ ታኒ ህንተና አይ አጮ?” ያግስ።<verse eid="2SA 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 21:4"/>ኤንቲ ዛሪድ፥ “ኑኒ ሳኦላፐ ዎይኮ እያ ሶ አሳፐ ዎርቃ ዎይኮ ብራ ኦይቾኮ። ቃስ እስራኤለ ግዶፈ እስ አስካ ዎናዉ ኑስ ማት ባዋ” ያግዶሶና።</para>
  <para style="p" vid="2SA 21:4">ዳዊቲ፥ “ያትን፥ ታኒ ህንተዉ አይ ኦና መላ ኮዬቲ?” ያግድ ኦይችስ።<verse eid="2SA 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 21:5"/>ኤንቲ፥ “ሳኦል ኑና ይስስ፤ ኑፐ አይ አስካ እስራኤለ ቢታን አዉንካ ፓፃ ዶና መላ ማቀትስ። <verse eid="2SA 21:5"/><verse number="6" style="v" sid="2SA 21:6"/>ሄሳ ግሾ፥ ሳኦላ ኮቻፈ ላፑን አደታ ኑስ እማ። ጎዳይ ዶርድ እያ ካዎዳ ሳኦላ ካታማን፥ ግብአን፥ ጎዳ ስንን ኑኒ ኤንታ ካቃና” ያግዶሶና።</para>
  <para style="p" vid="2SA 21:6">ካዎይ፥ “ታኒ ኤንታ ህንተዉ አዳ እማና” ያግስ።<verse eid="2SA 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 21:7"/>ሳኦላ ናአይ ዮናታንነ ዳዊቲ ጎዳ ስንን ጫቅዳ ጫቁዋ ግሾ፥ ሳኦላ ናኣ፥ ዮናታና ናኣ መምፕቦስተ ካዎይ አሽስ። <verse eid="2SA 21:7"/><verse number="8" style="v" sid="2SA 21:8"/>ሽን ካዎይ ዳዊቲ እዮሄላ ናእያ ራፅፋ ሳኦላስ የልዳ ናምኡ አደ ናይታ፥ አርሞናነ መምፕቦስተ፥ ቃስ ሳኦላ ናእያ መሮባ፥ ማሆላ አድያ ባርዝለ ናኣ አድርኤላስ የልዳ እቻሹ አደ ናይታ ኤክስ። <verse eid="2SA 21:8"/><verse number="9" style="v" sid="2SA 21:9"/>ጋባኦና አሳስ አድ እምን፥ ኤንቲ ጎዳ ስንን ዙማ ሁጰን ካቅዶሶና፤ ላፑናይ እስፈ ሀይቅዶሶና። ኤንቲ ባንጋ ጫካ ዶምያ ዎደ ሀይቅዶሶና።<verse eid="2SA 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 21:10"/>እዮሄላ ናእያ ራፅፋ ካዮ አፍላ ኤካዳ ዛላ ቦላ ባዉ ሂፃዳ፥ ካ ጫክያ ዎድያፐ ብድ አሀታ ቦላ እር ቡካና ጋካናዉ ጋላስ ካፎይ፥ ቃማ ዶእ ቦቾናዳ ናጋሱ።<verse eid="2SA 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 21:11"/>ሳኦላ ላገያ፥ እዮሄላ ናእያ ራፅፋ ኦዳይሳ ዳዊቲ ስእስ። <verse eid="2SA 21:11"/><verse number="12" style="v" sid="2SA 21:12"/>ዳዊቲ ብድ፥ ሳኦላ መቀነ እያ ናኣ ዮናታና መቀ ጋላዳን ደእያ ያበሳ አሳፐ ኤክስ። ፍልስፄመት ሳኦላነ እያ ናይታ ግልቦአ ደርያ ቦላ ዎድ፥ ቤት-ሳና ጉታራፐ ያበሳ አሳይ ካይሶትድ ኤክዶሶና። <verse eid="2SA 21:12"/><verse number="13" style="v" sid="2SA 21:13"/>ዳዊቲ ሳኦላ መቀነ እያ ናኣ ዮናታና መቀ ሄ በሳፈ ኤህስ። ቃስ ካቀትዳ ላፑን አሳታ መቀካ ሺሽስ። <verse eid="2SA 21:13"/><verse number="14" style="v" sid="2SA 21:14"/>ሳኦላ መቀነ እያ ናኣ ዮናታና መቀ ብንያመ ቢታን ፀላ ካታማን እያ አዋ ቂሳ ዱፉዋን ሞግዶሶና። ካዎይ ኪትዳባ ኡባ ኤንቲ ፖልዶሶና። ሄሳፈ ጉየ፥ ኤንቲ ሄ ቢታ ግሾ ዎስዳ ዎሳ ፆሳይ ስእስ።<verse eid="2SA 21:14"/></para>
  <para style="s1">ፍልስፄመታራ ኦለትዳ ኦላ</para>
  <para style="r">(<ref loc="1CH 20:4-8">1 ታር 20:4-8</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15"/>ፍልስፄመታ ግዶንነ እስራኤለ አሳ ግዶን ዛሪድ ኦል ደንድን፥ ዳዊቲ ባ አሳራ ብስ። ፍልስፄመታራ ኦለትድ ዳዊቲ ዳቡርስ። <verse eid="2SA 21:15"/><verse number="16" style="v" sid="2SA 21:16"/>ራፋያ ያራፐ ይሽብብኖባ ጌተትያ አደይ ደኤስ። ናሰ ብራታፐ ኦሰትዳ እ ኦይክያ ቶራይ ሄ ክሎ ግራመነ ባጋ፤ እ ኦራ ማሽ ዳንጭድ፥ ዳዊታ ዎናዉ ቆፕድ ደኤስ። <verse eid="2SA 21:16"/><verse number="17" style="v" sid="2SA 21:17"/>ሽን ፃሩያ ናአይ አብስ ዳዊታ አሽስ፤ እ ፍልስፄመ አድያ ዎስ። ሄሳፈ ጉየ፥ ዳዊታ አሳይ፥ “እስራኤለ ፆምፐይ ቶኦናዳ ኔኒ ዛራዳ ኑራ ኦላ ባካ” ያግድ ጫቅዶሶና።<verse eid="2SA 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 21:18"/>ጎባ ጌተትያ በሳን ፍልስፄመታራ ሀራ ኦል ደንድስ። ሄ ዎደ ኩሳታ አደይ ሳባክ፥ ራፋ ያራ ግድዳ ሳፋ ጌተትያ ኡራ ዎስ። <verse eid="2SA 21:18"/><verse number="19" style="v" sid="2SA 21:19"/>ቃስካ ሄ በሳን ፍልስፄመታራ ሀራ ኦል ደንድን፥ ቤተለመፐ ይዳ ያእራ ናኣ፥ ኤልሀናን፥ ቶራ ቶማይ ዋንዳራሸ መላ ግድዳ ጋተ አድያ ጎልያዳ ዎስ።<verse eid="2SA 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 21:20"/>ቃስካ ጋተን ሀራ ኦል ደንድስ። ሄ በሳን እስ አዱሳ አደይ ደኤስ። ሄ አድያስ እስ እስ ኩሽያንነ እስ እስ ቶሁዋን ኡሱፑን፥ ዎል ቦላ ላታማነ ኦይዱ ብራት ደኦሶና። እካ ራፋያ ያራፐ ግድዳ አስ። <verse eid="2SA 21:20"/><verse number="21" style="v" sid="2SA 21:21"/>ሄ አደይ እስራኤለ ቡሻይዳ ዎደ ዳዊታ እሻ ሳማ ናአይ ዮናታን እያ ዎስ።<verse eid="2SA 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 21:22"/>ሀ ኦይዳት ጋተን ደእያ ራፋያ ያራታ። ኤንታ ዳዊቲነ እያ አሳይ ዎዶሶና።<verse eid="2SA 21:22"/></para>
  <chapter eid="2SA 21"/>
  <chapter number="22" style="c" sid="2SA 22"/>
  <para style="s1">ዳዊታ ፆኖ ማዝሙረ</para>
  <para style="r">(<ref loc="PSA 18:1-50">ማዝ 18:1-50</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1"/>ጎዳይ ሳኦላ ኩሸፐነ እያ ሞርከታ ኡባ ኩሸፐ አሽዳ ጋላስ ዳዊቲ ጎዳስ ሀ ማዝሙርያ የፅስ።<verse eid="2SA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="2SA 22:2"/>ጎዳይ ታ ዛላ፤</para>
  <para style="q2" vid="2SA 22:2">ታዉ ሚፃ፤</para>
  <para style="q2" vid="2SA 22:2">እ ታና አሸይሳ።<verse eid="2SA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 22:3"/>ታ ፆሳይ ታኒ ባቃታዳ አትያ ዛላ፤</para>
  <para style="q2" vid="2SA 22:3">እ ታ ጎንዳልያ፤</para>
  <para style="q2" vid="2SA 22:3">እ ታ አቶተ ዎልቃ።</para>
  <para style="q1" vid="2SA 22:3">እ ታኒ ባቃታዳ አትያ በሲ፤</para>
  <para style="q2" vid="2SA 22:3">ነ ታና ማካላንቾታ ኩሸፐ አሻሳ።<verse eid="2SA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 22:4"/>ጋላት በሲያ ጎዳ ታኒ ፄጋና፤</para>
  <para style="q2" vid="2SA 22:4">ታኒ ታ ሞርከታፐ አታና።<verse eid="2SA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 22:5"/>ሀይቆ ዙለይ ታና ተቅስ፤</para>
  <para style="q2" vid="2SA 22:5">ዮ ድኦይ ታና ዳጋንስ።<verse eid="2SA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 22:6"/>ስኦለ ዎዶሮይ ታና ቃቻና ሀኔስ፤</para>
  <para style="q2" vid="2SA 22:6">ሀይቆይ ፅሄዳ ታና ኦይክስ።<verse eid="2SA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 22:7"/>ታና መቶይ ኡንኤን ጎዳ ፄጋስ፤</para>
  <para style="q2" vid="2SA 22:7">ታና ማዳና መላ ታ ፆሳኮ ዋሳስ።</para>
  <para style="q1" vid="2SA 22:7">እ ባ ኬን ታ ቃላ ስእስ፤</para>
  <para style="q2" vid="2SA 22:7">ታ ዋስዳ ዋሶይ እያ ሀይን ዎስ።<verse eid="2SA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="2SA 22:8"/>ፆሳይ ሀንቀትዳ ግሾ፥</para>
  <para style="q2" vid="2SA 22:8">ቢት ቃፅስ፤ ቡቀትስ፤</para>
  <para style="q2" vid="2SA 22:8">ሳሎታ ፃጶይ ኮኮርስ፤ ቃፅስ<verse eid="2SA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="2SA 22:9"/>እያ ሲያፐ ጩያይ ከይስ፤</para>
  <para style="q2" vid="2SA 22:9">እያ ዶናፐ ታማ ላጮይነ</para>
  <para style="q2" vid="2SA 22:9">ፁግያ ቦንቆይ ከይስ።<verse eid="2SA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="2SA 22:10"/>ሳሉዋ ጳልቅድ ዱገ ዎስ፤</para>
  <para style="q2" vid="2SA 22:10">እያ ቶሁዋፐ ጋርሳራ ሳካና ም ደኤስ።<verse eid="2SA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="2SA 22:11"/>ክሩበታን ኡትድ ፓልስ፤</para>
  <para style="q2" vid="2SA 22:11">ጫርኮ ቀፍያ ቦላ ኡትድ ብስ።<verse eid="2SA 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2SA 22:12"/>ባና ማን ተቅስ፤</para>
  <para style="q2" vid="2SA 22:12">እያ ዱንካነይ እራራ ስከትዳ ሻራ።<verse eid="2SA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2SA 22:13"/>እያ ስንን ደእያ ፖኡዋፐ</para>
  <para style="q2" vid="2SA 22:13">ታማ ቦንቆይ ከዬስ።<verse eid="2SA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="2SA 22:14"/>ጎዳይ ሳሎፐ ጉምስ፤</para>
  <para style="q2" vid="2SA 22:14">ኡባፈ ቃ ፆሳይ ባ ቃላ ስስስ።<verse eid="2SA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="2SA 22:15"/>ባ ዶንግያ ዱክድ፥ ባ ሞርከታ ላልስ፤</para>
  <para style="q2" vid="2SA 22:15">ዎልአን ፖኦ ኪትድ፥ ኤንታ የደስ።<verse eid="2SA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="2SA 22:16"/>ጎዳይ ሴርዳ ዎደነ</para>
  <para style="q2" vid="2SA 22:16">ሀንቀትድ ፔኑቅዳ ዎደ፥</para>
  <para style="q2" vid="2SA 22:16">አባ ግዶን ቢታይ በንትስ፤</para>
  <para style="q1" vid="2SA 22:16">ሳኣ ባሶይካ ቆንጭስ።<verse eid="2SA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="2SA 22:17"/>ጎዳይ ቦላፈ ኩሸ የድድ፥</para>
  <para style="q2" vid="2SA 22:17">ታና ኦይክስ፤</para>
  <para style="q2" vid="2SA 22:17">ጪሞ ሃፈ ታና ከስስ።<verse eid="2SA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="2SA 22:18"/>እ ታና ታ ዎልቃማ ሞርከታፐ፥</para>
  <para style="q2" vid="2SA 22:18">ታ ዎልቃፈ ቦላ ግድዳ ታና እፀይሳታፐ አሽስ።<verse eid="2SA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 22:19"/>ታ መቱዋ ጋላስ ኤንቲ ታ ቦላ ደንድዶሶና፤</para>
  <para style="q2" vid="2SA 22:19">ሽን ጎዳይ ታና ዘምፕሰይሳ።<verse eid="2SA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 22:20"/>እ ታና ዳልጋ በሲ ከስስ፤</para>
  <para style="q2" vid="2SA 22:20">ታናን ኡፋይትዳ ግሾ ታና አሽስ።<verse eid="2SA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="2SA 22:21"/>ታ ፅሎተዳ ጎዳይ ታዉ ቃንፅስ፤</para>
  <para style="q2" vid="2SA 22:21">ታ ኩሸ ጌሻተዳ ታዉ ዛርስ።<verse eid="2SA 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 22:22"/>አይስ ጊኮ ታኒ ጎዳ ኦግያ ካላስ፤</para>
  <para style="q2" vid="2SA 22:22">ቃስ ታ ፆሳ አጋዳ ኢታ ኦብከ።<verse eid="2SA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 22:23"/>ታኒ እያ ህግያ ኡባ ናጋስ፤</para>
  <para style="q2" vid="2SA 22:23">እያ ዎጋ ፖላናይሳ አጋብከ።<verse eid="2SA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 22:24"/>ታኒ እያ ስንን ሱረ ደአስ፤</para>
  <para style="q2" vid="2SA 22:24">ታና ናጋራፐ ናጋስ።<verse eid="2SA 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 22:25"/>ጎዳይ ታዉ ታ ፅሎተዳነ</para>
  <para style="q2" vid="2SA 22:25">ታ ጌሻተዳ ዛርስ።<verse eid="2SA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 22:26"/>ኔኒ ኬሀታስ ኬሀ፤</para>
  <para style="q2" vid="2SA 22:26">ሱረታስ ኔኒ ሱረ።<verse eid="2SA 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 22:27"/>ጌሻታስ ኔኒ ጌሽ፤</para>
  <para style="q2" vid="2SA 22:27">ሽን ጌላታስ ኔኒ ሞርከ።<verse eid="2SA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="2SA 22:28"/>ባንታና ካዉሸይሳታ አሻሳ፤</para>
  <para style="q2" vid="2SA 22:28">ሽን ኦቶራንቾታ ካዉሻሳ።<verse eid="2SA 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="2SA 22:29"/>አቤት ጎዳዉ፥ ታ ፆምፐይ ነና፤</para>
  <para style="q2" vid="2SA 22:29">ጎዳይ ታ ማ ፖእስስ።<verse eid="2SA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="2SA 22:30"/>ነ ማዱዋን ታ ሞርከታ የዳ ባና፤</para>
  <para style="q2" vid="2SA 22:30">ታ ፆሳን ግምበ ድርሳ ጉፓ አና።<verse eid="2SA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="2SA 22:31"/>ፆሳ ኦገይ ሱረ፤</para>
  <para style="q2" vid="2SA 22:31">ጎዳ ቃላይ ጌሽ፤</para>
  <para style="q2" vid="2SA 22:31">እያኮ ባቃትያ ኡባስ እ ጎንዳለ።<verse eid="2SA 22:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="2SA 22:32"/>ጎዳይ አትሽን፥ ሀራ ፆሲ ኦኔ?</para>
  <para style="q2" vid="2SA 22:32">ኑ ፆሳይ አትሽን፥ ሀራ ዛል ኦኔ?<verse eid="2SA 22:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="2SA 22:33"/>ፆሳይ ታዉ ምኖ ሚፃ፤</para>
  <para style="q2" vid="2SA 22:33">እ ታ ኦግያ ፖሎ ኦስ።<verse eid="2SA 22:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 22:34"/>እ ታ ቶሁዋ ገንኤ ቶሆዳ ምንስ፤</para>
  <para style="q2" vid="2SA 22:34">ታና ቃ በሳን ምንድ ኤሴስ።<verse eid="2SA 22:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="2SA 22:35"/>እ ታ ኩሽያ ኦላስ ሎህሴስ፤</para>
  <para style="q2" vid="2SA 22:35">ታ ቀሰይ ናሰ ብራታ ዶንገ ዱኬስ።<verse eid="2SA 22:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="2SA 22:36"/>ታና አሽያ ነ ጎንዳልያ ታዉ እማዳሳ፤</para>
  <para style="q2" vid="2SA 22:36">ነ ካትሶይ ታና ግታዬስ።<verse eid="2SA 22:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="2SA 22:37"/>ታ ሄመ ዳልግሳሳ፤</para>
  <para style="q2" vid="2SA 22:37">ታ ጋድያ ምንሳ።<verse eid="2SA 22:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="2SA 22:38"/>ታ ሞርከታ የደዳ መንረስ፤</para>
  <para style="q2" vid="2SA 22:38">ኤንቲ ዮና ደእሽን ጉየ ስምከ።<verse eid="2SA 22:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="2SA 22:39"/>ኤንቲ ዛሪድ ደንዶና መላ ሾጫስ፤</para>
  <para style="q2" vid="2SA 22:39">ታ ቶሁዋፐ ጋርሳን ኩንድዶሶና።<verse eid="2SA 22:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="2SA 22:40"/>ኦላስ ታዉ ዎልቃ ዳንጭሳዳሳ፤</para>
  <para style="q2" vid="2SA 22:40">ታ ሞርከታ ታዉ ጉልባትሳዳሳ።<verse eid="2SA 22:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="2SA 22:41"/>ታ ሞርከታ ታ ስንፈ ባቃትሳዳሳ፤</para>
  <para style="q2" vid="2SA 22:41">ታና እፀይሳታ ይሳስ።<verse eid="2SA 22:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="2SA 22:42"/>ማደ ኮይድ ዋስዶሶና፤</para>
  <para style="q2" vid="2SA 22:42">ሽን ኦንካ ኤንታ አሽቤና።</para>
  <para style="q1" vid="2SA 22:42">ጎዳ ኤንቲ ፄግዶሶና፤</para>
  <para style="q2" vid="2SA 22:42">ሽን እ ኤንታዉ ኮይቤና።<verse eid="2SA 22:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="2SA 22:43"/>ታኒ ኤንታ ባናዳ ሊቅሳስ፤</para>
  <para style="q2" vid="2SA 22:43">ኦገ ኡርቃዳ ኤንታ የስ።<verse eid="2SA 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="2SA 22:44"/>ማካላ ታ አሳፐ ታና አሻዳሳ፤</para>
  <para style="q2" vid="2SA 22:44">ካዎተታ ቦላ ታና ሹማዳሳ፤</para>
  <para style="q2" vid="2SA 22:44">ታ ኤሮና አሳይ ታዉ ሃረትስ።<verse eid="2SA 22:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="2SA 22:45"/>አላጋ ደረይ ታና አዳሼስ፤</para>
  <para style="q2" vid="2SA 22:45">ታ ዎርያ ስእድ ታዉ ኪተቶሶና።<verse eid="2SA 22:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="2SA 22:46"/>ኤንቲ ዎልቃ ይዶሶና፤</para>
  <para style="q2" vid="2SA 22:46">ባንታ ሚፃፐ ኮኮርሸ ከይድ ዮሶና።<verse eid="2SA 22:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="2SA 22:47"/>ጎዳይ ደኦን ደኤስ! ታ ዛላይ አንጀቶ።</para>
  <para style="q2" vid="2SA 22:47">ታና አሽያ ዛላይ ቁ ቁ ጎ።<verse eid="2SA 22:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="2SA 22:48"/>እ ታ ሃሉዋ ከይያ ፆሳ፤</para>
  <para style="q2" vid="2SA 22:48">ካዎተታ ታፐ ጋርሳን ሃርሴስ።<verse eid="2SA 22:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="2SA 22:49"/>ታ ሞርከታፐ ታና አሼስ፤</para>
  <para style="q2" vid="2SA 22:49">ታ ሞርከታ ቦላ ታና ቁ ቁ ኦሳ፤</para>
  <para style="q2" vid="2SA 22:49">ኦዳ መያ አሳፐ ታና አሻሳ።<verse eid="2SA 22:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="2SA 22:50"/>አቤት ጎዳዉ ታኒ ካዎተታ ግዶን ነና ጋላታና፤</para>
  <para style="q2" vid="2SA 22:50">ነ ሱን የፃና።<verse eid="2SA 22:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="2SA 22:51"/>ፆሳይ ባ ካዋስ ግታ ፆኖ እሜስ፤</para>
  <para style="q2" vid="2SA 22:51">ባ ትይዳ ዳዊታስነ እያ ኮቻስ፥</para>
  <para style="q2" vid="2SA 22:51">መርና ሲቁዋ በሴስ።<verse eid="2SA 22:51"/></para>
  <chapter eid="2SA 22"/>
  <chapter number="23" style="c" sid="2SA 23"/>
  <para style="s1">ዳዊታ ዉርሰ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1"/>ሀይስ ዳዊታ ዉርሰ ሃሳያ።</para>
  <para style="q1" vid="2SA 23:1">እሰየ ናኣ ዳዊታ ዉረሰይ ሀይሳ፤</para>
  <para style="q2" vid="2SA 23:1">እ ያይቆባ ፆሳን ትየትዳይሳ፤</para>
  <para style="q2" vid="2SA 23:1">ፆሳይ እያ ቁ ቁ ኦዳይሳ፤</para>
  <para style="q2" vid="2SA 23:1">እስራኤለን ሎኦ ማዝሙረ የፀይሳ።<verse eid="2SA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="2SA 23:2"/>“ጎዳ አያናይ ታ ባጋራ ኦዴስ፤</para>
  <para style="q2" vid="2SA 23:2">እያ ቃላይ ታ እንፃርሳን ደኤስ።<verse eid="2SA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 23:3"/>እስራኤለ ፆሳይ ታዉ ኦድስ፤</para>
  <para style="q2" vid="2SA 23:3">እስራኤለ ዛላይ ሀይሳዳ ያግስ።</para>
  <para style="q1" vid="2SA 23:3">‘ፅሎተን ሃርያ ካዎይ፥</para>
  <para style="q2" vid="2SA 23:3">ፆሳ ያሻን አይስያ ካዎይ፥<verse eid="2SA 23:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="2SA 23:4"/>እ ሻር ባይና ጉራ ዶልያ</para>
  <para style="q2" vid="2SA 23:4">ፃልቀ ፖኦ መላ።</para>
  <para style="q1" vid="2SA 23:4">እ እር ቡክድ አን፥</para>
  <para style="q2" vid="2SA 23:4">ቢታፈ ማታ ዶልስያ ቦቃልሳ መላ።’<verse eid="2SA 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 23:5"/>ቱማ ታ ኬ አሳይ ፆሳ ስንን ሱረ፤</para>
  <para style="q2" vid="2SA 23:5">እ ታራ መርናዉ ጫቅስ፤</para>
  <para style="q2" vid="2SA 23:5">ሀ ጫቆይ ጊግድ፥ ምንድነ ናገትድ ደኤስ።</para>
  <para style="q1" vid="2SA 23:5">ፆሳይ ታዉ ፆኖ እማና፤</para>
  <para style="q2" vid="2SA 23:5">ታ አሞትዳባ ኡባ እ ቱማ ፖላና።<verse eid="2SA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 23:6"/>ሽን ኢታ አሳት ኡባይ</para>
  <para style="q2" vid="2SA 23:6">ኩሸን ሺሻናዉ ሀኖና አጉንዳ ዎራ ሆለታና።<verse eid="2SA 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 23:7"/>አጉን ቦችያ ኦንካ</para>
  <para style="q2" vid="2SA 23:7">ዋለ ዎይኮ ፃምአ ባ ኩሸን ኦይካናዉ ኮሼስ፤</para>
  <para style="q2" vid="2SA 23:7">ሄስ ባ ደእያ በሳን ኤፃና” ያግስ።<verse eid="2SA 23:7"/></para>
  <para style="s1">ዳዊታራ ደእያ ምኖ አሳታ</para>
  <para style="r">(<ref loc="1CH 11:10-41">1 ታር 11:10-41</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 23:8"/>ምኖ ዳዊታ አሳታ ሱንይ ሀይሳፈ ካልድ ደኤይሳታ። ኮይሮይ፥ ታክሞና የለታ ግድዳ ዮሴብ-በስትቤተ ጌተቴስ፤ እ ሄታ ሀላቃ፤ እስ ቶሆ ኦላን ባ ቶራን ሆስፑን ፄቱ አስ ዎስ።<verse eid="2SA 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 23:9"/>ሄታፐ እሶይ፥ እያ ካልያ ናምአንይ፥ አሆሀ ሼሽ ግድዳ ዶዶ ናኣ አላዛራ። እስ ጋላስ እነ ዳዊቲ ኦላስ ሺቅዳ ፍልስፄመታ ማንድዶሶና፤ እስራኤለ አሳይ ጉየ ስምስ። <verse eid="2SA 23:9"/><verse number="10" style="v" sid="2SA 23:10"/>ሽን እ ባ በሳን ምን ኤቅድ፥ እያ ኩሸይ አርጋጭድ ማሻራ ኦይከታና ጋካናዉ ፍልስፄመታ ሾጭስ። ሄ ጋላስ ጎዳይ ግታ ፆኖ እሚስ። ኦላይ ኤቅን፥ ኦላንቾት አላዛራኮ ስሚድ ይዶሶና፤ ሽን ኤንቲ ሀይቅዳ ፍልስፄመታፐ ኦላ ማኦ ቃርዶሶናፐ አትሽን፥ ሀራባ ኦቦኮና።<verse eid="2SA 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 23:11"/>እያፐ ካለይ ቃስ አሮዳ የለታ ግድዳ አጋ ናኣ ሳማ። እስ ጋላስ ፍልስፄመት ምስረይ ኩምዳ ሾቃን፥ ሌህ ጌተትያ በሳን ሺቅን፥ እስራኤለት ኤንታ ስንፈ ባቃትዶሶና። <verse eid="2SA 23:11"/><verse number="12" style="v" sid="2SA 23:12"/>ሽን ሳም ሾቃ ግዶን ሙርት ኤቅድ ኦለትስ። ፍልስፄመታ ዎስ፤ ሄ ጋላስ ጎዳይ ዎልቃማ ፆኖ እሚስ።<verse eid="2SA 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 23:13"/>ካ ጫካ ዎደ ሀስታሙ ምኖ አሳታፐ ሄት አዱላማ ጎንጎሉዋ ዳዊታኮ ብዶሶና። ሄ ዎደ ፍልስፄመ ኦላንቾት ራፋይመ ዛንጋራን ዱንካንዶሶና። <verse eid="2SA 23:13"/><verse number="14" style="v" sid="2SA 23:14"/>ሄ ዎደ ዳዊቲ ሚፃን ደኤስ፤ ፍልስፄመ ኦላንቾታ ጩጋይ ቃስ ቤተለመን ኦላ ካምበ ደኤስ። <verse eid="2SA 23:14"/><verse number="15" style="v" sid="2SA 23:15"/>ዳዊቲ ሃ ኡያናዉ አሞትድ፥ “ቤተለመ ካታማ ፐንግያ ማታን ደእያ ኦላፐ ሃ ታና ኦነ ኡሻናይ” ያግስ። <verse eid="2SA 23:15"/><verse number="16" style="v" sid="2SA 23:16"/>ሀ ሄ ምኖ አሳት ፍልስፄመ ኦላንቾታ ጉታ ካንድ፥ ቤተለመ ካታማ ፐንገን ደእያ ኦላፈ ሃ ዱቅድ ዳዊታስ ኤህዶሶና። ሽን እ ኡዮና እፅድ፥ ጎዳ ስንን ትግድ፥ <verse eid="2SA 23:16"/><verse number="17" style="v" sid="2SA 23:17"/>“አቤት ጎዳዉ፥ ሀይሳ ኡያናይስ ታፐ ሃኮ! ሀ ሃ ባንታ ሸምፑዋ ባይዝድ ኤህዳ አሳታ ሱ ግደኔ?” ያግድ ኡዮና እፅስ።</para>
  <para style="p" vid="2SA 23:17">ሀ ሄ ምኖ አሳት ሀይሳ ኦዶሶና።<verse eid="2SA 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 23:18"/>ፃሩያ ናኣ እዮኣባ እሻይ አብስ ሀስታማታ ሀላቃ፤ እ ሄ ፄቱ አሳታ ባ ቶራን ኦልድ ዎስ፤ እካ ሄታዳ ኤረትስ። <verse eid="2SA 23:18"/><verse number="19" style="v" sid="2SA 23:19"/>እ ሀስታማታፐ አድ ቦንቸትዳ አስ፤ እ ሄታ መላ ኤረትዳ አስ ግዶና እፅኮካ ሀስታማታስ ሀላቃ።<verse eid="2SA 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 23:20"/>ቃብፅኤላ የለታ ግድዳ ዮዳሄ ናአይ ባናያስ ምኖ ኦሶ ኦዳ ግታ አስ። እ ናምኡ ኤረትዳ ሞአበ አሳታ ዎስ። እስ ዎደ ሻች ዎያ ጋላስ ኦላን ዎድ ጋሞ ዎስ። <verse eid="2SA 23:20"/><verse number="21" style="v" sid="2SA 23:21"/>ቃስ እስ ግታ ግብፀ አድያ ዎስ፤ ግብፀ አደይ ቶራ ኦይክስ፤ ሽን እ ፃምአ ኦይክድ እያኮ ብድ፥ እያ ኩሸፐ ቶራ ዳፍ ኤክድ፥ እያ ቶራራ እያ ዎስ። <verse eid="2SA 23:21"/><verse number="22" style="v" sid="2SA 23:22"/>ዮዳሄ ናአይ ባናያስ ሀይሳ ኦስ፤ እያ ሱንይ ሄታይሳዳ ኤረትስ። <verse eid="2SA 23:22"/><verse number="23" style="v" sid="2SA 23:23"/>እ ሀስታማታ ግዶን ዳሮ ቦንቸትዳ አስ፥ ሽን እ ሄታ ታይቡዋን ዴና። ዳዊቲ እያ ባና ናግያ ዎታዳረታስ ቶራ ሞጮና ኦስ።<verse eid="2SA 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 23:24"/>ሄ ሀስታማታ ግዶን ደኤይሳት፥ እዮኣባ እሻ አሳሄላ፥ ቤተለመ የለታ ግድዳ ዶዳ ናኣ ኤልያና፥ <verse eid="2SA 23:24"/><verse number="25" style="v" sid="2SA 23:25"/>አሮዳ የለታ ግድዳ ሳማነ ኤልቃ፥ <verse eid="2SA 23:25"/><verse number="26" style="v" sid="2SA 23:26"/>ፋልፃ ያራ ግድዳ ሰለሳ፥ ታቆሀ አድያ ኤስካ ናኣ እራሳ፥ <verse eid="2SA 23:26"/><verse number="27" style="v" sid="2SA 23:27"/>አናቶተ የለታ ግድዳ አብኤዘራ፥ ኩሳ የለታ ግድዳ ማቡናያ፥ <verse eid="2SA 23:27"/><verse number="28" style="v" sid="2SA 23:28"/>አሆሀ ያራ ግድዳ ፃልሞና፥ <verse eid="2SA 23:28"/><verse number="29" style="v" sid="2SA 23:29"/>ናፆፋ የለታ ግድዳ ማህራያነ ባአና ናኣ ሄለባ። ብንያመ ቢታን፥ ግብአ የለታ ግድዳ ርባያ ናኣ እታያ፥ <verse eid="2SA 23:29"/><verse number="30" style="v" sid="2SA 23:30"/>ጵርአቶና የለታ ግድዳ ባናያ፥ ጋኣሳ ዛንጋራ ማታፐ ይዳ ህዳያ፥ <verse eid="2SA 23:30"/><verse number="31" style="v" sid="2SA 23:31"/>አራባ የለታ ግድዳ አባልቦና፥ ባርሁማ አድያ አዝሞታ፥ <verse eid="2SA 23:31"/><verse number="32" style="v" sid="2SA 23:32"/>ሻአልቦና የለታ ግድዳ ኤልያባ፥ አሳና ናይታ፥ ዮናታና፥ <verse eid="2SA 23:32"/><verse number="33" style="v" sid="2SA 23:33"/>አሮዳ የለታ ግድዳ ሳማነ ሻራ ናኣ አህኣማ፥ <verse eid="2SA 23:33"/><verse number="34" style="v" sid="2SA 23:34"/>ማእካ የለታ ግድዳ አሀስባያ ናኣ ኤልፋላፃ፥ ግሎ የለታ ግድዳ አክፆፈላ ናኣ ኤልኣማ፥ <verse eid="2SA 23:34"/><verse number="35" style="v" sid="2SA 23:35"/>ቃርመሎሳ የለታ ግድዳ ሄፅራ፥ አራባ የለታ ግድዳ ፓኣራ፥ <verse eid="2SA 23:35"/><verse number="36" style="v" sid="2SA 23:36"/>ሱባ የለታ ግድዳ ናታና ናኣ ይግኣላ፥ ጋደ የለታ ግድዳ ባና፥ <verse eid="2SA 23:36"/><verse number="37" style="v" sid="2SA 23:37"/>አሞነ የለታ ግድዳ ሰለቃ፥ ፃሩያ ናኣ እዮኣባ ኦላ ሚሽያ ቶክያ ባኤሮታ የለታ ግድዳ ናህራያ፥ <verse eid="2SA 23:37"/><verse number="38" style="v" sid="2SA 23:38"/>ያትራ ያራ ግድያ እራያነ ጋሬባ፥ <verse eid="2SA 23:38"/><verse number="39" style="v" sid="2SA 23:39"/>ህተ አድያ ኦርዮና። ኤንቲ ኩመ ሀስታማነ ላፑና።<verse eid="2SA 23:39"/></para>
  <chapter eid="2SA 23"/>
  <chapter number="24" style="c" sid="2SA 24"/>
  <para style="s1">ዳዊቲ አሳ ታይብስ</para>
  <para style="r">(<ref loc="1CH 21:1-27">1 ታር 21:1-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1"/>ጎዳ ሀንቆይ ቃስካ እስራኤለ ቦላ ኤፅስ፤ ጎዳይ ዳዊታ ኤንታ ቦላ ደንድ፥ “ባዳ እስራኤለነ ይሁዳ አሳ ታይባ” ያግስ። <verse eid="2SA 24:1"/><verse number="2" style="v" sid="2SA 24:2"/>ሄሳ ግሾ፥ ካዎይ ቶራ ሞጮናታ እዮኣባነ ባራ ደኤይሳታኮ ሀይሳዳ ያግስ፤ “እስራኤለ ኮቻታ ዳነፐ በርሳበ ጋካናዉ ታኒ ኤራና መላ እስራኤለ አሳ ብድ ታይብተ” ያግስ።<verse eid="2SA 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 24:3"/>ሽን እዮኣብ፥ “ጎዳይ ነ ፆሳይ ሀ ደእያ አሳ ቦላ ፄቱ ኩሸ ጉጆ! ሄሳ ታ ጎዳ፥ ካዋ አይፈይ በኦ! ሽን ታ ጎዳይ፥ ካዎይ አይስ ሄሳ መላባ ኦናዉ ኮዪ?” ያግስ። <verse eid="2SA 24:3"/><verse number="4" style="v" sid="2SA 24:4"/>ሽን ካዋ ቃላይ እዮኣባነ ቶራ ሞጮናታ ፆንን፥ ኤንቲ ካዋ ስንፈ ከይድ፥ እስራኤለ አሳ ታይባናዉ ብዶሶና።<verse eid="2SA 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 24:5"/>ኤንቲ ዮርዳኖሰ ፕንድ ዱገሀ ባጋን ደእያ፥ ዛንጋራ ግዶን ደእያ አሮኤራ ካታማን ዱንካንዶሶና፤ ያፐ ጋደ ካንድ እያዜራ ጋክዶሶና። <verse eid="2SA 24:5"/><verse number="6" style="v" sid="2SA 24:6"/>ያፐ ኤንቲ ጋላዳነ ህተታ ቢታን ደእያ ቃደሳ ብዶሶና፤ ያፐ ቃስ ዳነ ብዶሶና፤ ያራ ስዶና ጋክዶሶና። <verse eid="2SA 24:6"/><verse number="7" style="v" sid="2SA 24:7"/>ያፐ ደንድድ፥ ፅሮሳ ሚፃነ ህወታነ ካናነታ ካታማ ኡባ ብዶሶና። ዉርሰን ይሁዳ ነገባን ደእያ በርሳበ ብዶሶና።<verse eid="2SA 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 24:8"/>ኤንቲ ቢታ ኡባ ዩይሸ ኡዱፉን አጌናነ ላታሙ ጋላስ ጋምእድ፥ የሩሳላመ ስምዶሶና።<verse eid="2SA 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 24:9"/>እዮኣብ አሳ ታይቡዋ ካዋ ኤርስስ፤ እስራኤለን ማሻን ኦለታናዉ ዳንዳእያ ሆስፑን ፄቱ ሙኩሉ ምኖ ኦላንቾት፥ ይሁዳን ቃስ እቻሹ ፄቱ ሙኩሉ ኦላንቾት ደኦሶና።<verse eid="2SA 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 24:10"/>አሳ ታይብዳፐ ጉየ፥ ዳዊታ ዎዛናይ ህርግን፥ ዳዊቲ፥ “ታኒ ሀ ኦሱዋን ግታ ናጋራ ኦስ። ሽን ሀእ አቤት ጎዳዉ፥ ታኒ ነና ዎሳይስ፤ ታ ናጋራ፥ ነ አይልያ ናጋራ አቶ ጋ። ታኒ ዳሮ ቦዛባ ሀናስ” ያግስ።<verse eid="2SA 24:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 24:11"/>ዎንተ ጋላስ ዳዊቲ ሂፃፐ ደንድያ ዎደ ዳዊታስ ቆንጨ በእያ፥ ናብያ ጋደኮ ጎዳ ቃል ይስ። <verse eid="2SA 24:11"/><verse number="12" style="v" sid="2SA 24:12"/>“ባዳ፥ ዳዊታኮ፥ ‘ታኒ ነና ሄባፐ እሱዋ ዶራና መላ በሳይስ፤ ታኒ ነ ቦላ ፖላናዉ ኤንታፈ እሱዋ ዶራ’ ያጌስ ጎዳይ” ያግስ።<verse eid="2SA 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 24:13"/>ጋድ ዳዊታኮ ብድ፥ “ሄ ላይ ነ ቢታ ቦላ ኮሻ ኤሆዬ? ዎይኮ ነ ሞርከት ነና የደን፥ ሄ አጌና ኤንታ ስንፈ ባቃታነዬ? ዎይኮ ነ ቢታ ቦላ ሄ ጋላስ ጋዶይ ያናይሳ ዶራይ? አነ ሀእ ቆፓዳ ታኒ ታና ኪትዳይሳስ ዛራናባ ኦዳ” ያግስ።<verse eid="2SA 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 24:14"/>ዳዊቲ ጋደኮ፥ “ታኒ ዳሮ ኡንኤታስ። ጎዳ ማሮታይ ግታ ግድያ ግሾ፥ ኑኒ እያ ኩሸን ኩንዳና፤ ታና አሳ ኩሸን የጎፎ” ያግስ።<verse eid="2SA 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 24:15"/>ሄሳ ግሾ፥ ዎንታፈ ብድ እ ግዳ ጋላሳይ ጋካናዉ ጎዳይ እስራኤለ ቢታን ጋዶ ኪትስ። እስራኤለ ቢታን ዳነፐ ብድ በርሳበ ጋካናዉ ላፑን ታሙ ሙኩሉ አስ ሀይቅስ። <verse eid="2SA 24:15"/><verse number="16" style="v" sid="2SA 24:16"/>የሩሳላመ ይሳናዉ ኪታንቾይ ባ ኩሽያ ምጭዳ ዎደ አሳ ቦላ ጋክዳ ጋዶይ ጎዳ አዛንዳ ግሾ፥ አሳ ሾጭያ ኪታንቹዋኮ፥ “ግዳና! ነ ኩሽያ ዛራ” ያግስ። ጎዳ ኪታንቾይ ሄ ዎደ ያቡሰ አድያ ኦርና ዉዱማን ደኤስ።<verse eid="2SA 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 24:17"/>አሳ ሾጭያ ኪታንቹዋ ዳዊቲ በእዳ ዎደ ጎዳኮ፥ “ናጋራ ኦዳይ ታና፤ ታ ባላስ! ሀ ዶርሳት አይ ኦዶና? ሀያና፥ ታናነ ታ አዋ ሶ አሳ ነ ሴራና መላ ታኒ ዎሳይስ” ያግስ።<verse eid="2SA 24:17"/></para>
  <para style="s1">ዳዊቲ ያርሾ በሲ ጊግስስ</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18"/>ሄ ጋላስ ጋድ ዳዊታኮ ይድ፥ “ባዳ፥ ያቡሰ አድያ ኦርና ዉዱማን ጎዳስ ያርሾ በሲ ጊግሳ” ያግስ። <verse eid="2SA 24:18"/><verse number="19" style="v" sid="2SA 24:19"/>ዳዊቲ፥ ጎዳይ ጋደ ባጋራ ኪትዳይሳዳ ኦናዉ ፑደ ብስ። <verse eid="2SA 24:19"/><verse number="20" style="v" sid="2SA 24:20"/>ኦርን ዱገ ፄልያ ዎደ፥ ካዎይነ እያ አሳት ባኮ የይሳ በእስ። እ ጋፃ ከይድ፥ ጉፋንድ ካዋስ ዝግስ።<verse eid="2SA 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 24:21"/>ኦርን፥ “ታ ጎዳይ ካዎይ ባ አይልያኮ፥ አይስ ይዴ?” ያግስ።</para>
  <para style="p" vid="2SA 24:21">ዳዊቲ፥ “አሳ ቦላፈ ጋዶይ ስማና መላ ታኒ ጎዳስ ያርሾ በሲ ጊግሳናዉ ነ ዉዱማ ሻማናዉ ያስ” ያግስ።<verse eid="2SA 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 24:22"/>ኦርን፥ “ታ ጎዳይ፥ ካዎይ ባ ኮይዳባ ኤክድ ያርሾ! ፁሳ ያርሾስ ቦራት ደኦሶና፤ ኤሶ ምስ ቃስ ካ ቡክያ ሚሸይነ ቦራ ቃምባር ደኤስ። <verse eid="2SA 24:22"/><verse number="23" style="v" sid="2SA 24:23"/>ካዋዉ፥ ሀይሳ ኡባ ኦርን ካዋስ እምስ” ያግስ። ጉጅድ ኦርን፥ “ጎዳይ ነ ፆሳይ ነ ያርሹዋ ኤኮ” ያግስ።<verse eid="2SA 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 24:24"/>ሽን ካዎይ፥ “አካይ፥ ታኒ ታ ሚሸን ሻማና። ታ ጎዳ፥ ፆሳስ ፁሳ ያርሾ ጋተይ ባይና ያርሽከ” ያግስ።</para>
  <para style="p" vid="2SA 24:24">ሄሳ ግሾ፥ ካዎይ ዉዱማነ ቦራታ ኦርናፈ እሻታሙ ብራ ሳንትመን ሻምስ። <verse eid="2SA 24:24"/><verse number="25" style="v" sid="2SA 24:25"/>ዳዊቲ ሄ በሳን ያርሾ በሲ ጊግስድ ፁሳ ያርሾነ እስፈተ ያርሾ ጎዳስ ያርሽስ። ጎዳይ ቢታ ግሾ ዎሰትዳ ዎሳ ስእድ፥ ጋዱዋ እስራኤለፐ ድግስ።<verse eid="2SA 24:25"/></para>
  <chapter eid="2SA 24"/>
</usx>
