<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1SA" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">1 ሳሜላ ማፃፋ</para>
  <para style="toc1">1 ሳሜላ ማፃፋ</para>
  <para style="toc3">1 ሳሜ</para>
  <para style="toc2">1 ሳሜላ</para>
  <para style="mt">1 ሳሜላ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሳሜላ ማፃፋን ኮይሮ ሻሆይ፥ እስራኤለ አሳይ ዳይናት አይስያ ካዎተፈ ካዎት አይስያ ካዎተኮ ፕንዳ ሀኖታ ኦዴስ። ሀ ላመይ እስራኤለ አሳ ደኡዋን ኦናዉ ዳንዳእዳይ፥ ሄ አሳታ ጋሶና። ኤንታፈ ኮይሮይ፥ ዉርሰን ደእዳ፥ አይሰይሳታ ግዶፈ ግታ ግድዳ ናብያ ሳሜላ። ሳሜል ሌወ ኮቸ ግዶና እፅኮካ ካህነታዳ ያርሾ ያርሽስ (<char style="xt"><ref loc="1SA 7:17">7:17</ref></char>)። ናምአንይ፥ እስራኤለስ ኮይሮ ካዎ ግድዳ ሳኦላ፤ ሄንይ፥ ማታ ኦይካናፐ ካሰ እያ ታርከይ ሳሜላነ ሳኦላ ታርክያራ ጋሄትድ ደእያ ዳዊታ። ኤንታ ቦላ ቆሆ ጋዳ ግሾ፥ ናአተይ ሳሜል አይስያ አስ ግድድ ደንድያ ዎደ፥ ፍልስፄመ አሳይ እስራኤለ ኦልድ ታቦትያ ድእድ፥ ቅርያት-ይኣርመን ዎዶሶና (<char style="xt"><ref loc="1SA 4:1-7:2">4:1—7:2</ref></char>)።</para>
  <para style="ip">ሀ ማፃፋስ ዋና ኪታይ፥ ጋልአ ጫቆን ደእያ ሀራ ታርከ ማፃፋታዳ ፆሳስ አማነተ፥ አንጆስነ እንጀ ዱሳስ ጋይሳነ ኪተተ እፆይ ኩንደነ ዮ ኤሄይሳ በሴስ። ሄስካ፥ ፆሳይ ካህንያ ኤለስ ኦድዳይሳዳ፥ “ታና ቦንቸይሳታ ታኒ ቦንቻና፤ ታና ካይሳት ባንታዉ ካታና” ግዳ ቃላ (<char style="xt"><ref loc="1SA 2:30">2:30</ref></char>) ቆንጭስ።</para>
  <para style="ip">ሀ ማፃፋይ ካዎይ ሃርያ ካዎተ ኤስያ ዎደ አሳስ ስኤትያ ሀኖታ ቆንጭሴስ። እስራኤለ አሳስ ኤረትዳ ቱማ ካዎይ ፆሰ። ሽን ጉየፐ አሳይ ኦይሻ ደንን፥ ፆሳይ ኤንታዉ ካዎ ዶርስ። ሄስ ሀንኮካ፥ እስራኤለ አሳ ግድን፥ ኤንታና አይስያ ካዋ ግድን፥ ፆሳ ግታተፈነ እያ ፕርዳፈ ጋርሳን ደኤይሳ ኤራናዉ በሴስ (<char style="xt"><ref loc="1SA 2:7-10">2:7-10</ref></char>)።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሳሜላ የለተነ ናአተ ዎድያ (<char style="ior"><ref loc="1SA 1:1-2:10">1:1—2:10</ref></char>)</para>
  <para style="io1">ሳሜል ጌሻ ዱንካንያ ግዶን (<char style="ior"><ref loc="1SA 2:11-3:2">2:11—3:2</ref></char>)</para>
  <para style="io1">ታቦትያ ድኤተነ ስሙዋ (<char style="ior"><ref loc="1SA 4:1-7:2">4:1—7:2</ref></char>)</para>
  <para style="io1">ሳሜል እስራኤለ ካለያ አስ ግድስ (<char style="ior"><ref loc="1SA 7:3-17">7:3-17</ref></char>)</para>
  <para style="io1">ሳኦል ካዎ ግዳናዉ ሹመተ (<char style="ior"><ref loc="1SA 8:1-11:15">8:1—11:15</ref></char>)</para>
  <para style="io1">ሳሜላ ሻከተ ሃሳያ (<char style="ior"><ref loc="1SA 12:1-25">12:1-25</ref></char>)</para>
  <para style="io1">ሳኦላ ኮይሮ አይሶ ላይታ (<char style="ior"><ref loc="1SA 13:1-15:35">13:1—15:35</ref></char>)</para>
  <para style="io1">ዳዊቲ ካዎ ግዳናዉ ዶረተ (<char style="ior"><ref loc="1SA 16:1-23">16:1—16:23</ref></char>)</para>
  <para style="io1">ዳዊቲ ጎልያዳ ዎዋነ ሳኦል ዳዊታ ዎናዉ ኮሻ (<char style="ior"><ref loc="1SA 17:1-18:30">17:1—18:30</ref></char>)</para>
  <para style="io1">ዮናታን፥ ሳሜልነ አብመለከይ ዳዊታ ማዱዋ (<char style="ior"><ref loc="1SA 19:1-21:9">19:1—21:9</ref></char>)</para>
  <para style="io1">ዳዊቲ ሳኦላፐ ባቃቱዋነ ሳኦል ካህነታ ዎዋ (<char style="ior"><ref loc="1SA 21:10-22:23">21:10—22:23</ref></char>)</para>
  <para style="io1">ዳዊቲ ሳኦላ ዎናዉ ኮይቤና (<char style="ior"><ref loc="1SA 23:1-26:25">23:1—26:25</ref></char>)</para>
  <para style="io1">ዳዊቲ ፍልስፄመ ባቃቱዋነ ሳኦል ሳሜላ ሞይትለ ኦድሱዋ (<char style="ior"><ref loc="1SA 27:1-28:25">27:1—28:25</ref></char>)</para>
  <para style="io1">ዳዊቲ ባ ሶ አሳ ዛርስ (<char style="ior"><ref loc="1SA 29:1-30:31">29:1—30:31</ref></char>)</para>
  <para style="io1">ሳኦላነ እያ ናይታ ሀይቁዋ (<char style="ior"><ref loc="1SA 31:1-13">31:1-13</ref></char>)</para>
  <chapter number="1" style="c" sid="1SA 1"/>
  <para style="s1">ሳሜላ የለተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 1:1"/>ደረይ ዳርያ ኤፍሬማ ቢታን፥ ራማ ካታማን ደእያ፥ ኤፍሬማ ኮቸነ ዙፋ ኮቸ ግድዳ፥ ህልቃና ጌተትያ እስ አደይ ደኤስ። እ ይሮሃማ ናአ፤ ይሮሃም ኤልሁ ናአ፤ ኤልሁ ቶሁ ናአ፤ ቶሁይ ዙፋ ናኣ። <verse eid="1SA 1:1"/><verse number="2" style="v" sid="1SA 1:2"/>ህልቃናስ ናምኡ ማቸት ደኦሶና፤ እስነ ሱንይ ሃኖ፤ ሀንኮር ሱንይ ፕናኖ። ፕናንስ ናይት ደኦሶና፥ ሽን ሃናስ ናእ ባዋ።<verse eid="1SA 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 1:3"/>ህልቃን ላይን ላይን ኡባፈ ዎልቃማ ጎዳ ጎይናናዉነ እያዉ ያርሻናዉ ሴሎ ቤስ። ኤል ናይት ናምአይ፥ አፍናንነ ፍንሃስ ጎዳ ካህነ ግድድ ሴሎን ሀጋዞሶና። <verse eid="1SA 1:3"/><verse number="4" style="v" sid="1SA 1:4"/>ህልቃን ያርሾ ያርሽያ ዎደ ኡባን አሹዋፐ እስ እስ ኩሸ ባ ማቸ ፕናንስ፥ ባ አደ ናይታስነ ማጫ ናይታስ ሁጰን ሁጰን እሜስ። <verse eid="1SA 1:4"/><verse number="5" style="v" sid="1SA 1:5"/>ጎዳይ ሃኖ የሎ ድግኮካ፥ ህልቃን እዮ ዶስያ ግሾ፥ እዉ ናምኡ ኩሸ እሜስ። <verse eid="1SA 1:5"/><verse number="6" style="v" sid="1SA 1:6"/>ጎዳይ ሃኖ የሎ ድግዳ ግሾ፥ እ ዳዉያ እዮ ቶቻዳ ይሎያዉሱ። <verse eid="1SA 1:6"/><verse number="7" style="v" sid="1SA 1:7"/>ሄስ ላይን ላይን ኡባ ዎደ ሀንያባ። ሃና ጎዳ ኬ ብዳ ዎደ ኡባን እ ዳዉያ እያ ዬካና ጋካናዉነ ካ እፃና ጋካናዉ ይሎያዉሱ። <verse eid="1SA 1:7"/><verse number="8" style="v" sid="1SA 1:8"/>እ አዝናይ ህልቃን፥ “ሃነ፥ ነ አይስ ዬካይ? አይስ ካ ሚኪ? ነ ዎዛናይ አይስ አዛኒ? ታኒ ነዉ ታሙ ናይታፐ አክናዬ?” ያጌስ።<verse eid="1SA 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 1:9"/>እስ ጋላስ ኤንቲ ሴሎን ምዳፐነ ኡይዳፐ ጉየ፥ ሃና ደንዳ ኤቃሱ። ካህነይ ኤል ጎዳ ኬ ፐንግያ ማታን ባ ኡትያ በሳን ኡትስ። <verse eid="1SA 1:9"/><verse number="10" style="v" sid="1SA 1:10"/>ሃና ዳሮ አዛንዳ ግሾ ጫመታዳ ዬካሸ ጎዳ ዎሳሱ። <verse eid="1SA 1:10"/><verse number="11" style="v" sid="1SA 1:11"/>እያ ሀይሳዳ ያጋዳ ቃንገታሱ፤ “ኡባፈ ዎልቃማ ጎዳዉ፥ ታና ነ አይልዉ በአ። ታ መቱዋ በአዳ፥ ታና ሀሳያ፤ ታና ነ አይልዉ ዶጎፓ። ኔኒ ታዉ ነ አይሌስ አደ ናአ እምኮ፥ እያ ደኦ ላይ ኡባን ታኒ እያ ነዉ እማና፤ እያ ሁጰይ ፖሎ ሜደተና” ያጋሱ።<verse eid="1SA 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 1:12"/>ሃና ጎዳ ዎሳ አዱስዳ ዎደ ኤል እ ዶና በኤስ። <verse eid="1SA 1:12"/><verse number="13" style="v" sid="1SA 1:13"/>ሃና ባ ዎዛናን ፆሳ ዎስያ ዎደ እ መተርሻይ ቃፄስ፥ ሽን እ ቃላይ ስኤተና፤ ሄሳ ግሾ፥ ኤል እዮ ማትዳዳ ቆፕስ። <verse eid="1SA 1:13"/><verse number="14" style="v" sid="1SA 1:14"/>እ፥ “ኔኒ አዉደ ጋካናዉ ማታይ? ዎይነ ኡሻ ኔፐ ድጋ” ያግስ።<verse eid="1SA 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 1:15"/>ሃን ዛራዳ፥ “ታ ጎዳዉ፥ ግደና፤ ታኒ ዳሮ አዛንዳ ማጫስ፤ ታኒ ታ ሸምፑዋፈ ጎዳ ዎሳይስፐ አትሽን፥ ዎይነ ዎይኮ ማይያ ኡሹ ኡያብከ። <verse eid="1SA 1:15"/><verse number="16" style="v" sid="1SA 1:16"/>ታኒ መቶይነ አዛኖይ ዳርዳ ግሾ ዎሳይስ። ታና ነ አይልዉ ፓና ማጫስ ኦዳ ቆፖፋ” ያጋሱ።<verse eid="1SA 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 1:17"/>ኤል ዛሪድ፥ “ሳሮ ባ፤ ኔኒ ዎስያባ እስራኤለ ፆሳይ ነዉ እሞ” ያግስ።<verse eid="1SA 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 1:18"/>ሃና፥ “ነ አይልያ ነ ስንን ሳባ ደሞ” ያጋሱ። ሄሳፈ ጉየ፥ እያ ባ ኦግያ ባዳ ካ ማሱ፤ ሄሳፈ ስማዳ እያ አዛናቡኩ።<verse eid="1SA 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 1:19"/>ዎንተ ጋላስ ጉራ ደንድድ፥ ህልቃንነ እያ ሶ አሳይ ጎዳ ጎይንዳፐ ጉየ፥ ራማ ካታማን ደእያ ባንታ ሶ ስምዶሶና። ህልቃን ባ ማቸ ሃንራ አቅስ፤ ጎዳይ እዮ ቆፕስ። <verse eid="1SA 1:19"/><verse number="20" style="v" sid="1SA 1:20"/>እያ ቃንታዳ አደ ናአ የላሱ። ሃና፥ “ታኒ ጎዳ ዎስን እ ታና ስእስ” ጋዳ እያ ሱን ሳሜላ ሱንሱ።<verse eid="1SA 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 1:21"/>ህልቃን ባ ሶ አሳ ኡባራ ላይ ያርሾ ጎዳስ ያርሻናዉነ ቃንገ ጋናዉ ሴሎ ብስ። <verse eid="1SA 1:21"/><verse number="22" style="v" sid="1SA 1:22"/>ሽን ሃና ባቡኩ። እያ ባ አዝናኮ፥ “ናአይ ን ዱዳፐ ጉየ፥ እያ ኤፋዳ፥ ጎዳስ እማና፤ እ መርናዉ ያን ዳና” ያጋሱ።<verse eid="1SA 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 1:23"/>ህልቃን፥ “ነና ሎእዳባ ኦ፤ እ ን ዱና ጋካናዉ ሶን ጋምአናዉ ዳንዳኣሳ፤ ጎዳይ ባ ገልዳ ቃላ ነዉ ፖሎ” ያግስ። ሃና ባ ናኣ ን ዱና ጋካናዉ ሶን ጋምአሱ።<verse eid="1SA 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 1:24"/>ሃና ናአይ ን ዱዳፐ ጉየ፥ ናኣነ ሄ ላይ ዎፋኖ<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="fq" closed="false">ሜ ላይ ዎፋኖ፦ </char><char style="ft" closed="false">እብራወ ብርሸይ ሄ ዎፋኖ ጌስ፤ ቃስ ግርከ ብርሸይ ሄ ላይ ዎፋኖ ጌስ።</char></note> ላታሙ ክሎ ግራመ ለነ ኦጎሮ ኩመ ዎይነ ኡሹ ኤካዳ ሴሎን ደእያ ጎዳ ኬ ባሱ፤ ሄ ዎደ ናአይ ጉ። <verse eid="1SA 1:24"/><verse number="25" style="v" sid="1SA 1:25"/>ኤንቲ ዎፋኑዋ ሹክዳፐ ጉየ ናኣ ኤልኮ ኤፍዶሶና። <verse eid="1SA 1:25"/><verse number="26" style="v" sid="1SA 1:26"/>ሃና፥ “ታ ጎዳዉ፥ ነ ሸምፖይ ኤሮ፤ ነ ስንን ኤቃዳ ጎዳ ዎስዳ ማጫስያ ታና። <verse eid="1SA 1:26"/><verse number="27" style="v" sid="1SA 1:27"/>ሀ ናኣ እማና መላ ዎስን፥ ጎዳይ ታ ዎስዳባ እሚስ። <verse eid="1SA 1:27"/><verse number="28" style="v" sid="1SA 1:28"/>ሄሳ ግሾ፥ ታኒ እያ ጎዳስ እማስ፤ እ ባ ደኦ ላይ ኡባን ጎዳስ እመትስ” ያጋሱ። ኤንቲ ያን ጎዳ ጎይንዶሶና።<verse eid="1SA 1:28"/></para>
  <chapter eid="1SA 1"/>
  <chapter number="2" style="c" sid="1SA 2"/>
  <para style="s1">ሃን ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 2:1"/>ሃና ሀይሳዳ ያጋዳ ዎሳሱ፤</para>
  <para style="q1" vid="1SA 2:1">“ታ ዎዛናይ ጎዳን ኡፋይቴስ፤</para>
  <para style="q2" vid="1SA 2:1">ታ ካጨይ<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">ካጨይ፦ </char><char style="ft" closed="false">ሀ በሳንነ ሀራ በሳን አጨይ ምኖተ ማላ።</char></note> ጎዳን ቁ ግስ።</para>
  <para style="q1" vid="1SA 2:1">ታ ሞርከታ ቦላ ታኒ ጬቀታይስ፤</para>
  <para style="q2" vid="1SA 2:1">ነ አሾይ ታና ኡፋይሴስ።<verse eid="1SA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="1SA 2:2"/>ጎዳ መላ ጌሽ ባዋ፤</para>
  <para style="q2" vid="1SA 2:2">ነ መል ኦንካ ባዋ።</para>
  <para style="q1" vid="1SA 2:2">ኑ ፆሳፈ አትሽን፥</para>
  <para style="q2" vid="1SA 2:2">ሀራ ዛል ባዋ።<verse eid="1SA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="1SA 2:3"/>ኦቶሮ ሃሳያ አግተ፤</para>
  <para style="q2" vid="1SA 2:3">ኦቶሮ ቃል ህንተ ዶናፐ ከዮፖ።</para>
  <para style="q1" vid="1SA 2:3">ጎዳ ፆሳይ ኡባ ኤሬስ፤</para>
  <para style="q2" vid="1SA 2:3">አሳ ኦሶ ይግድ ፄሌስ።<verse eid="1SA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="1SA 2:4"/>ኦላንቾታ ዶንገይ መቅስ፤</para>
  <para style="q2" vid="1SA 2:4">ሽን ዳቡራንቾት ዎልቃ ደምዶሶና።<verse eid="1SA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="1SA 2:5"/>ካልዳይሳት ኮሻትድ ኡነትዶሶና፤</para>
  <para style="q2" vid="1SA 2:5">ሽን ኮሻትዳይሳት ሀእ ካልዶሶና።</para>
  <para style="q1" vid="1SA 2:5">ማይንያ ላፑን ናይታ የላሱ፤</para>
  <para style="q2" vid="1SA 2:5">ሽን ዳሮ ናይታ የልዳራ ባርካ አታሱ<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="fq" closed="false">ባርካ አታሱ፦ </char><char style="ft" closed="false">ሀራ ብርሸይ ዳቡራሱ ጉሱ።</char></note><verse eid="1SA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="1SA 2:6"/>ጎዳይ ዎስ፥ ፓስ፤</para>
  <para style="q2" vid="1SA 2:6">ስኦለን የጌስ፥ ያፐ ከሴስ።<verse eid="1SA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="1SA 2:7"/>ጎዳይ ዱረዬስ፤ ጎዳይ ማንቀስ፤</para>
  <para style="q2" vid="1SA 2:7">ካዉሼስ፤ ቁ ኦስ።<verse eid="1SA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1SA 2:8"/>እ ማንቆታ ባናፐ ደንስ፤</para>
  <para style="q2" vid="1SA 2:8">መቶታንቾታ ብዶፐ ደንስ።</para>
  <para style="q1" vid="1SA 2:8">ኤንታ ቦንቾ አሳራ ኡትሴስ፤</para>
  <para style="q2" vid="1SA 2:8">ቦንቾ አራታ ላትሴስ።</para>
  <para style="q1" vid="1SA 2:8">ቢታ ባሶት ጎዳሳ፤</para>
  <para style="q2" vid="1SA 2:8">ኤንታ ቦላ አላምያ ኤስስ።<verse eid="1SA 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="1SA 2:9"/>“እ ጌሻታ ቶሁዋ ናጌስ፤</para>
  <para style="q2" vid="1SA 2:9">ሽን ኢታታ ማን ስእ ኦና፤</para>
  <para style="q2" vid="1SA 2:9">አስ ባ ዎልቃን ፆነና፤<verse eid="1SA 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1SA 2:10"/>ጎዳራ ኤቀተይሳት ሊቃና፤</para>
  <para style="q2" vid="1SA 2:10">ጎዳይ ሳሎፐ ኤንታ ቦላ ዳዳዳ ደቻና።</para>
  <para style="q1" vid="1SA 2:10">ጎዳይ ሳአን ደእያ ኡባ ፕርዳና፤</para>
  <para style="q2" vid="1SA 2:10">እ ባ ካዋስ ምኖተ እማና፤</para>
  <para style="q2" vid="1SA 2:10">እ ባ ትይዳይሳስ ፆኖ እማና።”<verse eid="1SA 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 2:11"/>ሄሳፈ ጉየ፥ ህልቃን ራማን ደእያ ባ ሶ ብስ፤ ሽን ናአይ ሳሜል ካህንያ ኤልፐ ጋርሳራ ጎዳስ ኦስ።<verse eid="1SA 2:11"/></para>
  <para style="s1">ኤል ናይታ ኢታተ</para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 2:12"/>ኤል አደ ናይት ኢታ፤ ኤንቲ ጎዳ ቦንቾኮና። <verse eid="1SA 2:12"/><verse number="13" style="v" sid="1SA 2:13"/>ሄ ዎደ ካህነት አሳራ ደእያ ጋሄተን ኦያ ዎግ ደኤስ። ሄስካ አሳይ ያርሾ ያርሽያ ዎደ ካህንያ ኦሳንቾይ ሄ አቻራ ደእያ ቃጰ ኤክድ ቡሮ አሾይ ካፅሽን ዬስ። <verse eid="1SA 2:13"/><verse number="14" style="v" sid="1SA 2:14"/>ዶይስያ ኦቱዋን ዎይኮ ድስትያን ዎይኮ ፃሩዋን ባ ቃጵያ የድድ፥ አይ ቆሞ አሾ ግድኮካ ከስ ኤፍድ ካህንያስ እሜስ። ያርሾ ያርሻናዉ ሴሎ ያ እስራኤለ አሳ ኡባ ቦላ ኤንቲ ሀይሳዳ ኦሶና። <verse eid="1SA 2:14"/><verse number="15" style="v" sid="1SA 2:15"/>ቃስ ሞዋ ያርሾ በሳን ፁጋናፐ ስን ካህንያ ኦሳንቾይ ያርሾ ያርሽያ አድያኮ ብድ፥ “ካህነይ ቃየ አሾፐ አትሽን፥ ካፅዳ አሾ ኔፐ ኤኮና ግሾ፥ እያዉ ጫጫናዉ አሾ ሀማ” ያጌስ።<verse eid="1SA 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 2:16"/>አደይ ዛሪድ፥ “ኮይሮትድ ሞይ ፁገቶ፤ ሄሳፈ ጉየ፥ ነ ኮየይሳ ኤካ” ያጌስ፤ ሽን ካህንያ አይለይ፥ “አካይ፥ ታዉ ሀእ እማ፥ ነ ድግኮ፥ ታኒ ዎልቃን ኤካና” ያጌስ።<verse eid="1SA 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 2:17"/>ጎዳስ እምያ ያርሹዋ ኤል ናይት ካዳ ግሾ፥ ኤንታ ናጋራይ ጎዳ ስንን አድ ዳርስ።<verse eid="1SA 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 2:18"/>ሽን ሳሜል ናአ ደእሸ ሊኖፐ ኦሰትዳ ኤፉደ<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fq" closed="false">ኤፉደ፦ </char><char style="ft" closed="false">እብራወ ዶናን ካህነይ ማእያ ማኦ ቃን ጉሱ።</char></note> ማኦ ማእድ ጎዳ ስንን ኦስ። <verse eid="1SA 2:18"/><verse number="19" style="v" sid="1SA 2:19"/>ሳሜላ አይያ ላይን ላይን ጉ ቆለ ጊግሳዳ፥ ላይ ያርሾ ያርሻናዉ ባ አዝናራ ባሸ እያዉ ኤካዳ ባዉሱ። <verse eid="1SA 2:19"/><verse number="20" style="v" sid="1SA 2:20"/>ኤል ህልቃናነ እያ ማችዉ፥ “ህንተ ጎዳስ ዱማይድ እምዳ ሀ ናኣ በሳን ጎዳይ ነዉ ሀ ማቸፈ ሀራ ናይታ እሞ” ያግድ አንጄስ፤ ያትን፥ ኤንቲ ባንታ ሶ ስሞሶና። <verse eid="1SA 2:20"/><verse number="21" style="v" sid="1SA 2:21"/>ጎዳይ ሃና አንጅን፥ ቃንታዳ ሄ አደ ናይታነ ናምኡ ማጫ ናይታ የላሱ። ናአይ ሳሜል ጎዳ ስንን ድጭስ።<verse eid="1SA 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 2:22"/>ኤል ዳሮ ጭምስ። እያ ናይት እስራኤለ አሳ ኡባ ቦላ ኦዳ ኢታባነ ጌሻ ዱንካንያ ፐንገን ጎዳስ ኦያ ማጫሳታራ ቱንዳይሳ ስእስ። <verse eid="1SA 2:22"/><verse number="23" style="v" sid="1SA 2:23"/>ሄሳ ግሾ ኤንታኮ፥ “ህንተ ሀይሳ መላባ አይስ ኦቲ? ህንተ ኢታ ኦሱዋ ታኒ አሳ ኡባፈ ስአስ። <verse eid="1SA 2:23"/><verse number="24" style="v" sid="1SA 2:24"/>ታ ናይቶ፥ ሄሳ አግተ፤ ጎዳ አሳይ ህንተና ግያባይ ሎኦ ግደና። <verse eid="1SA 2:24"/><verse number="25" style="v" sid="1SA 2:25"/>እስ አስ አሰ ናቅኮ፥ ፆሳይ እያዉ ጋናታና፤ ሽን አስ ጎዳ ናቅኮ፥ እያዉ ጋናታናይ ኦኔ?” ያግስ።</para>
  <para style="p" vid="1SA 2:25">ጎዳይ ኤንታና ዎናዉ ኮይዳ ግሾ ኤንቲ ባንታ አዋ ዞርያ ስኦና እፅዶሶና።<verse eid="1SA 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 2:26"/>ናአይ ሳሜል ጎዳ ስንንነ አሳ ስንን ድጭስነ ሳበትስ።<verse eid="1SA 2:26"/></para>
  <para style="s1">ኤል ኬ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="27" style="v" sid="1SA 2:27"/>እስ ጋላስ ናበይ ኤልኮ ይድ፥ “ጎዳይ ሀይሳዳ ያጌስ። ‘ነ አዋ ሶ አሳይ ግብፀ ቢታን ፓሮና ኩሸን ደእያ ዎደ ታ ኤንታዉ ቆንጫብክና? <verse eid="1SA 2:27"/><verse number="28" style="v" sid="1SA 2:28"/>ነ አዋይ ካህነ ግድድ ታ ያርሾ በሳ ከያና መላ፥ እፃነ ጩይሳና መላነ ታ ስንን ኤፉደ ማእድ ኦና መላ እስራኤለ ዛረ ኡባፈ እያ ዶራስ። እስራኤለ አሳይ ታማን ያርሽያ ያርሾ ኡባ ታኒ ነ አዋ ኮቻስ እማስ። <verse eid="1SA 2:28"/><verse number="29" style="v" sid="1SA 2:29"/>ታኒ ታ ደእያ በሳን ሺቃና መላ ኪትዳ ታ ያርሹዋነ እሙዋ ህንተ አይስ ካደቲ? ታ አሳ እስራኤለ፥ ታዉ ሺሽዳ ያርሾ ኡባፈ ዶረትዳይሳ ምድ ሞና መላ ኦዳ ነ ናይታ ታፐ አዳ አይስ ቦንቻዲ?’<verse eid="1SA 2:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 2:30"/>“ሄሳ ግሾ፥ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ። ነ ኮቻይነ ነ አዋ ኮቻይ መርናዉ ታዉ ኦና። ሽን ሀእ ሄስ ታፐ ሃኮ፤ ታና ቦንቸይሳታ ቦንቻና፤ ታና ካይሳት ካታና። <verse eid="1SA 2:30"/><verse number="31" style="v" sid="1SA 2:31"/>ነ ኮቻን አስ ጬጎና መላ ታኒ ነ ዎልቃነ ነ አዋ ሶ አሳ ዎልቃ ይስያ ዎደይ ያና። <verse eid="1SA 2:31"/><verse number="32" style="v" sid="1SA 2:32"/>ኔኒ ታ ኬን መቶ በአና፤ ታኒ እስራኤለ አሳስ እምያ አንጁዋ ኔኒ በአዳ ቃናታና፤ ሽን ነ ሶ አሳን ጬጋና አስ ኦንካ ባዋ። <verse eid="1SA 2:32"/><verse number="33" style="v" sid="1SA 2:33"/>ታኒ ታ ያርሾ በሳፈ ይሶና አስ ደእኮ፥ እያ ጋሶን ነ አይፈይ አፉፅሸ ቆቃና፤ ነ ዎዛናይ አዛኖን ፁገታና፤ ነ ኮቻ ኡባይ ናአተን ሀይቃና። <verse eid="1SA 2:33"/><verse number="34" style="v" sid="1SA 2:34"/>ነ ናይት ናምአይ፥ አፍናንነ ፍንሃስ እስ ጋላስ ሀይቃና፤ ሄሳ ነዉ ማላ ግዳና። <verse eid="1SA 2:34"/><verse number="35" style="v" sid="1SA 2:35"/>ታ ዎዛናዳነ ታ ቆፋዳ ኦያ ታዉ አማነትያ ካህነ ደንና። ታኒ እያዉ አማነትዳ ሶ አስ እማና፤ ታኒ ትይዳ ካዋ ስንን ኤንቲ ኡባ ዎደ ኦና። <verse eid="1SA 2:35"/><verse number="36" style="v" sid="1SA 2:36"/>ነ ኮቻ ግዶፈ አትዳ ኡባይ ጉ ሚሸ ዎይኮ ባሶ ኡይ ዎሳናዉ ይድ፥ እያ ስንን ጉፋንድ፥ ‘ታኒ ምያባ ደማና መላ ካህነ ኦዳ ታና ሹማርክ’ ያጋና” ያግስ።<verse eid="1SA 2:36"/></para>
  <chapter eid="1SA 2"/>
  <chapter number="3" style="c" sid="1SA 3"/>
  <para style="s1">ሳሜላ ፄገተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 3:1"/>ናአይ ሳሜል ኤልፐ ጋርሳራ ጎዳስ ኦስ፤ ጎዳ ቃላይ ሄ ዎደ ዳሮ አልኦ፤ ቆንጨካ ባዋ። <verse eid="1SA 3:1"/><verse number="2" style="v" sid="1SA 3:2"/>አይፈይ ዳቡርን ዋየትድ ፄልያ ኤል እስ ቃማ ባ በሳን ዝንእስ። <verse eid="1SA 3:2"/><verse number="3" style="v" sid="1SA 3:3"/>ሄ ዎደ ፆሳ ፆምፐይ ቡሮ ቶእቤና፤ ጎዳ ታቦተይ ደእያ ኬን ሳሜል ስክስ። <verse eid="1SA 3:3"/><verse number="4" style="v" sid="1SA 3:4"/>ጎዳይ ሳሜላ ፄግስ፤ ሳሜል፥ “ዬ” ግድ ኮይስ። <verse eid="1SA 3:4"/><verse number="5" style="v" sid="1SA 3:5"/>እ ኤልኮ ዎፅ ብድ፥ “ኔኒ ፄግን ሄኮ ያስ” ያግስ።</para>
  <para style="p" vid="1SA 3:5">ሽን ኤል፥ “ታ ነና ፄጋብከ፤ ባዳ ዝንአ” ያግን፥ ሳሜል ብድ ዝንእስ።<verse eid="1SA 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 3:6"/>ቃስ ጎዳይ፥ “ሳሜላ” ያግድ ናምአን ፄግን፥ ሳሜል ደንድድ፥ ኤልኮ ብድ፥ “ኔኒ ፄግን ሄኮ ያስ” ያግስ።</para>
  <para style="p" vid="1SA 3:6">ሽን ኤል፥ “ታ ናአዉ፥ ታ ነና ፄጋብከ፤ ባዳ ዝንአ” ያግስ።<verse eid="1SA 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 3:7"/>ጎዳ ቃላይ ቡሮ እያዉ ቆንጭቦና ግሾ፥ ሳሜል ጎዳ ግደይሳ ኤርቤና። <verse eid="1SA 3:7"/><verse number="8" style="v" sid="1SA 3:8"/>ጎዳይ ሳሜላ ሄን ፄግን ደንድድ፥ ኤልኮ ብድ፥ “ኔኒ ፄግን ሄኮ ያስ” ያግስ።</para>
  <para style="p" vid="1SA 3:8">ሄሳን ጎዳይ ናኣ ፄግዳይሳ ኤል አኬክድ፥ <verse eid="1SA 3:8"/><verse number="9" style="v" sid="1SA 3:9"/>“ባዳ ዝንአ፤ እ ነና ፄግያባ ግድኮ፥ ‘ጎዳዉ፥ ኦዳ፤ ታ ነ አይለይ ስአይስ’ ያጋ” ግድ፥ ኤል እያዉ ኦድን፥ ሳሜል ባ በሳ ብድ ዝንእስ።<verse eid="1SA 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 3:10"/>ሄሳፈ ጉየ፥ ጎዳይ ይድ እያ ማታን ኤቅድ፥ ካሰይሳዳ፥ “ሳሜላ፥ ሳሜላ” ያግድ ፄግስ።</para>
  <para style="p" vid="1SA 3:10">ሳሜል፥ “ነ አይለይ ስኤስ፥ ኦዳ” ያግስ።<verse eid="1SA 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 3:11"/>ጎዳይ ሳሜላ፥ “ሄኮ፥ ታኒ አሳ ሀይስ ኢትያ እስባ እስራኤለ ቦላ ኦና ሀናይስ። <verse eid="1SA 3:11"/><verse number="12" style="v" sid="1SA 3:12"/>ሄ ጋላስ ታኒ ኤል ሶ አሳ ቦላ ኦና ጋዳ ኦድዳ ኡባ ኮይሮፐ ዉርሰ ጋካናዉ ፖላና። <verse eid="1SA 3:12"/><verse number="13" style="v" sid="1SA 3:13"/>ኤል ኤርድ ሴሮና አግዳ እያ ናይታ ናጋራ ግሾ፥ ታኒ እያ ሶ አሳ ቦላ መርናዉ ፕርዳናይሳ እያዉ ካሰ ኦዳ ዎስ። <verse eid="1SA 3:13"/><verse number="14" style="v" sid="1SA 3:14"/>ሄሳ ግሾ፥ ‘ኤል ሶ አሳ ናጋራይ ያርሾንነ እሞን ፖሎ አቶ ጌተተና’ ያጋዳ ታኒ እያ ሶ አሳስ ካሰ ጫቃስ” ያግስ።<verse eid="1SA 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 3:15"/>ሳሜል ዎንታና ጋካናዉ ስክስ፤ ዎንትን ደንድድ፥ ፆሳ ኬ ፐንግያ ዶይስ። ሳሜል ቆንጭዳባ ኤልስ ኦዳናዉ ያይስ። <verse eid="1SA 3:15"/><verse number="16" style="v" sid="1SA 3:16"/>ኤል፥ “ታ ናአዉ፥ ሳሜላ” ያግድ ፄግስ።</para>
  <para style="p" vid="1SA 3:16">ሳሜል፥ “ዬ” ግድ ኮይስ።<verse eid="1SA 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 3:17"/>ኤል፥ “ጎዳይ ነዉ ኦድዳይ አይቤ? ታፐ አይኮካ ቆሶፓ፤ ኔኒ ፆሳይ ነዉ ኦድዳባፐ እስባካ ታፐ ቆስኮ፥ ፆሲ ነና ፕርዶ” ያግድ ኦይችስ። <verse eid="1SA 3:17"/><verse number="18" style="v" sid="1SA 3:18"/>ሳሜል አይኮካ ቆሶና ኡባ ኤልስ ኦድስ። ኤል፥ “እ ጎዳ፤ ባና ሎእዳባ ኦ” ያግስ።<verse eid="1SA 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 3:19"/>ሳሜል ድጭሸ ብስ፤ ጎዳይ እያራ ደኤስ። ሳሜል ኦድዳባፐ እስ ቃልካ ሳአን ዎና። <verse eid="1SA 3:19"/><verse number="20" style="v" sid="1SA 3:20"/>ዳነፐ በርሳበ ጋካናዉ፥ ሳሜል ቱማ ጎዳ ናበ ግደይሳ እስራኤለ አሳ ኡባይ ኤርስ። <verse eid="1SA 3:20"/><verse number="21" style="v" sid="1SA 3:21"/>ጎዳይ ሴሎን ቆንጬስ፤ ያን ባ ቃላን ባናተ ሳሜላስ ቆንጭሴስ።<verse eid="1SA 3:21"/></para>
  <chapter eid="1SA 3"/>
  <chapter number="4" style="c" sid="1SA 4"/>
  <para style="s1">ታቦትያ ድኤተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 4:1"/>ሳሜል ኦድዳ ቃላይ እስራኤለ ኡባ ጋክስ። እስራኤለት ፍልስፄማታራ ኦለታናዉ ከይዶሶና፤ እስራኤለት አበንኤዘራን ዱንካንን፥ ፍልስፄመት አፌቃን ዱንካንዶሶና። <verse eid="1SA 4:1"/><verse number="2" style="v" sid="1SA 4:2"/>ፍልስፄመት ጩጋን ጩጋን ግድድ፥ እስራኤለታራ ኦለታናዉ ደንድዶሶና፤ ኦላይ ምንዳ ዎደ ፍልስፄመት እስራኤለታ ፆንድ ኦይዱ ሙኩሉ ግድያ አሳ ዎዶሶና። <verse eid="1SA 4:2"/><verse number="3" style="v" sid="1SA 4:3"/>ኦላንቾት ዱንካንዳ ጉታ ስምዳ ዎደ እስራኤለ ጭማት፥ “ሀች ጎዳይ ኑና ፍልስፄመታ ኩሸን አይስ አድ እምዴ? ኑራ ባና መላነ ኑ ሞርከታ ኩሸፐ ኑና አሻና መላ ጎዳ ታቦትያ ሴሎፐ አነ ኤሆስ” ያግዶሶና። <verse eid="1SA 4:3"/><verse number="4" style="v" sid="1SA 4:4"/>ሄሳ ግሾ፥ አሳይ ሴሎ ኪትን፥ ክሩበታ ግዶን አራታን ኡትያ ኡባፈ ዎልቃማ ጎዳ ታቦትያ ኤህዶሶና። ኤል ናይት ናምአይ አፍናንነ ፍንሃስ ጫቆ ታቦትያራ ያን ደኦሶና።<verse eid="1SA 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 4:5"/>ጎዳ ጫቆ ታቦተይ አሳይ ዱንካንዳ ጉታ ጋክዳ ዎደ እስራኤለ ኡባይ ቢት ቃፃና ጋካናዉ ባንታ ቃላ ቁ ኦድ፥ “ጎዳ ጫቆ ታቦተይ ጋክስ” ያግድ ዋስዶሶና።<verse eid="1SA 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 4:6"/>እስራኤለታ ዋሱዋ ፍልስፄመት ስእድ፥ “እብራወታ ጉታን ስኤትያ ዎልቃማ ዋሶይ አይቤ?” ያግዶሶና።</para>
  <para style="p" vid="1SA 4:6">ጎዳ ታቦተይ ኤንታ ጉታ ይዳይሳ ፍልስፄመት ኤርዳ ዎደ፥ <verse eid="1SA 4:6"/><verse number="7" style="v" sid="1SA 4:7"/>ያይድ ሀይሳዳ ያግዶሶና፤ “ፆሳይ ኤንታ ጉታ ይስ፤ ኑና አየ! ሀይሳ መላባይ ሀይሳፈ ካሰ ሀን ኤረና። <verse eid="1SA 4:7"/><verse number="8" style="v" sid="1SA 4:8"/>ኑና አየ! ሀ ዎልቃማ ፆሳ ኩሸፐ ኑና አሻናይ ኦኔ? ሀ ፆሳይ ግብፀታ መላ ቢታን ዱማ ዱማ ጋዶን ሾጭስ። <verse eid="1SA 4:8"/><verse number="9" style="v" sid="1SA 4:9"/>ህንተኖ ፍልስፄመቶ፥ ምንተ! አደ ግድተ! ሄስ ሀኖና እፅኮ፥ ህንተ ኤንታ ካሰ አይለተን ሃርዳይሳዳ ኤንቲ ህንተና ሃራና። አደ ግድተ፤ ኦለትተ” ያግዶሶና።<verse eid="1SA 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 4:10"/>ፍልስፄመት ኦለትድ፥ እስራኤለታ ፆንን እስራኤለት ባንታ ሶ ሶ ባቃትዶሶና። ሄ ኦላን ዳሮ አሳይ ሀይቅዶሶና፤ እስራኤለ ቶሆ ኦላንቾታፐ ሀስታሙ ሙኩሉ አሳይ ሀይቅዶሶና። <verse eid="1SA 4:10"/><verse number="11" style="v" sid="1SA 4:11"/>ፆሳ ታቦተይ ድኤትስ፤ ኤል ናይት ናምአይ፥ አፍናንነ ፍንሃስ ሀይቅዶሶና።<verse eid="1SA 4:11"/></para>
  <para style="s1">ኤል ሀይቁዋ</para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 4:12"/>ሄ ጋላስ ብንያመ ኮቸ ግድዳ እስ አደይ ኦላ ደምባፈ ዎፅሸ ይድ ሴሎ ጋክስ። ባ አዛኑዋ ኤርሳናዉ እ ባ ማኡዋ ዳክድ፥ ባ ሁጰን ቢታ ቆልስ። <verse eid="1SA 4:12"/><verse number="13" style="v" sid="1SA 4:13"/>ሄ አደይ ጋክያ ዎደ ኤል ባ ዎዛናን ፆሳ ታቦትያስ ህርግዳ ግሾ ናግሸ ኦገ ዶናን ደእያ ባ ኦይድያን ኡትስ። አደይ ካታማ ገልድ፥ ሀንዳባ ኦድን፥ ካታማ ኡባይ ዋሶ ጎች አግስ።<verse eid="1SA 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 4:14"/>ኤል ሄ ዋሱዋ ስእድ፥ “ሀይስ አይብ ዋሶ?” ያግስ።</para>
  <para style="p" vid="1SA 4:14">አደይ ኤለስ ብድ ኤልስ ኦድስ። <verse eid="1SA 4:14"/><verse number="15" style="v" sid="1SA 4:15"/>ኤል ኡዱፉን ታማነ ሆስፑን ላይ ግድዳ ጭማ፤ እያ አይፈይ ዳቡርድ ፄሎ አግስ። <verse eid="1SA 4:15"/><verse number="16" style="v" sid="1SA 4:16"/>አደይ ኤልኮ፥ “ኦላ ደምባፈ ይዳይ ታና፤ ታኒ ሀች ያፐ ባቃታዳ ያስ” ያግስ።</para>
  <para style="p" vid="1SA 4:16">ኤል፥ “ታ ናአዉ፥ ያትን ዋንዴ?” ያግድ ኦይችስ።<verse eid="1SA 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 4:17"/>አደይ፥ “እስራኤለት ፍልስፄመታ ስንፈ ባቃትዶሶና፤ ዳሮ አስ ዉርስ፤ ነ ናይት ናምአይ አፍናንነ ፍንሃስ ሀይቅዶሶና፤ ፆሳ ታቦተይ ድኤትስ” ያግስ።<verse eid="1SA 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 4:18"/>አደይ ፆሳ ታቦትያባ ኦድዳ ዎደ ፐንግያ ማታን ደእያ ባ ኦይድያፐ ኤል ጉየ ኩንድስ። እ ጭማነ ሞሎ ግድያ ግሾ ሞርገይ መቅን ሀይቅስ። ኤል እስራኤለ ቢታ ኦይታሙ ላይ ሃርስ።<verse eid="1SA 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 4:19"/>ኤል ናኣ ፕንሃሳ ማችያ የላናዉ ዎደይ ዉርዳ ቃን። ፆሳ ታቦተይ ድኤተ፥ ባ ቦሉዋነ ባ አዝና ሀይቁዋ ስእዳ ዎደ ቆፖና እቀ እዮ ኦይክን የላሱ። <verse eid="1SA 4:19"/><verse number="20" style="v" sid="1SA 4:20"/>እ ሸምፖይ ከይያ ዎደ የልሰይሳት፥ “አደ ናአ የላዳሳ፤ ያዮፋ” ያግዶሶና። ሽን ኤንታዉ አይኮካ ዛራቡኩ፤ ኤንቲ ግያባካ ስአቡኩ። <verse eid="1SA 4:20"/><verse number="21" style="v" sid="1SA 4:21"/>እያ ባ ናኣ እካቦዳ<note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="fq" closed="false">እካቦዳ፦ </char><char style="ft" closed="false">እብራወ ዶናን ሀ ሱን ብርሸይ “ቦንቾይ ባዋ” ጉሱ።</char></note> ጋዳ ሱንሱ፤ ፆሳ ታቦተይ ድኤትዳ ግሾነ ባ ቦሎይነ ባ አዝናይ ሀይቅዳ ግሾ፥ “ቦንቾይ እስራኤለፐ ሻከትስ” ያጋሱ። <verse eid="1SA 4:21"/><verse number="22" style="v" sid="1SA 4:22"/>እያ፥ “ፆሳ ታቦተይ ድኤትዳ ግሾ ቦንቾይ እስራኤለፐ ሻከትስ” ያጋሱ።<verse eid="1SA 4:22"/></para>
  <chapter eid="1SA 4"/>
  <chapter number="5" style="c" sid="1SA 5"/>
  <para style="s1">ታቦተይ ፍልስፄመ ካታማታን</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 5:1"/>ፍልስፄመት ፆሳ ታቦትያ ድእዳፐ ጉየ አበንኤዘራፐ አሽዶዳ ኤፍዶሶና። <verse eid="1SA 5:1"/><verse number="2" style="v" sid="1SA 5:2"/>ፆሳ ታቦትያ ኤፍድ፥ ዳጎነ ኤቃ ኬን ገልስድ፥ ዳጎነ ምስልያ ማታን ዎዶሶና። <verse eid="1SA 5:2"/><verse number="3" style="v" sid="1SA 5:3"/>አሽዶዳ አሳይ ዎንተ ጋላስ ጉራ ደንድድ በእያ ዎደ ጎዳ ታቦትያ ስንን ዳጎን ጉፋንዳይሳ በእዶሶና። ዳጎነ ደንድ፥ ካሰ በሳን ኤስዶሶና። <verse eid="1SA 5:3"/><verse number="4" style="v" sid="1SA 5:4"/>ቃስ ዎንተ ጋላስ ጉራ ደንድድ በእያ ዎደ ጎዳ ታቦትያ ስንን ዳጎን ሳአን ጉፋንዳይሳ በእዶሶና። ሄ ዎደ ዳጎነ ሁጰይነ እያ ናምኡ ኩሸይ መቅድ ፐንግያ ቦላ ደኤስ፤ ሀንኮ አሳተይ ዱማ አትስ። <verse eid="1SA 5:4"/><verse number="5" style="v" sid="1SA 5:5"/>ሀች ጋካናዉ ዳጎነ ካህነትነ አሽዶዳን ደእያ ዳጎነ ኬ ገልያ አሳት ኡባይ ዳጎነ ፐንግያ የና ፃምባል አይ ሄሳ ግሾሳ።<verse eid="1SA 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 5:6"/>አሽዶዳ ካታማ ቦላነ እያ ሄራን ደእያ አሳ ቦላ ጎዳ ኩሸይ ዴፅስ፤ ጎዳይ ክፃ ሀርገ የድድ ኤንታ ሴርስ።<verse eid="1SA 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 5:7"/>አሽዶዳ ካታማ አሳይ ሀንዳባ በእዳ ዎደ፥ “እስራኤለ ፆሳ ኩሸይ ኑ ቦላነ ኑ ፆሳ ዳጎነ ቦላ ዴፅዳ ግሾ፥ እስራኤለ ፆሳ ታቦተይ ኑ ማታን ጋምኦፎ” ያግዶሶና። <verse eid="1SA 5:7"/><verse number="8" style="v" sid="1SA 5:8"/>ሄሳ ግሾ፥ እቻሹ ፍልስፄመ ሀላቃታ ኡባ ፄግድ፥ “እስራኤለ ፆሳ ታቦትያ ዋትኖ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="1SA 5:8">ሀላቃት፥ “እስራኤለ ፆሳ ታቦተይ ጋተ ካታማ ቦ” ያግድ ዛርዶሶና። እስራኤለ ፆሳ ታቦትያ ጋተ ኤፍዶሶና።<verse eid="1SA 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 5:9"/>ሽን ታቦተይ ጋተ ጋክዳፐ ጉየ፥ ጎዳ ኩሸይ ሄ ካታማ ቦላ ዴፅድ፥ ዳሮ ዳጋንስ። ካታማን ደእያ አሳ ናአፐ ጭማ ጋካናዉ ክፃ ሀርገን ሾጭስ። <verse eid="1SA 5:9"/><verse number="10" style="v" sid="1SA 5:10"/>ሄሳ ግሾ፥ ፆሳ ታቦትያ ኤቅሮና ካታማ የድዶሶና።</para>
  <para style="p" vid="1SA 5:10">ፆሳ ታቦተይ ኤቅሮና ገልያ ዎደ፥ ኤቅሮና አሳይ፥ “ኑናነ ኑ አሳ ይሳናዉ እስራኤለ ፆሳ ታቦትያ ኑኮ ኤህዶሶና” ያግድ ዋስዶሶና። <verse eid="1SA 5:10"/><verse number="11" style="v" sid="1SA 5:11"/>ሄሳ ግሾ፥ ኤንቲ ፍልስፄመ ሀላቃታ ፄግድ፥ “ኑናነ ኑ አሳ ይሳናፐ ስን እስራኤለ ፆሳ ታቦትያ ሀይሳፈ ድግተ፤ እያ እያ በሳ ጉየ ዛርተ” ያግዶሶና። ጎዳ ኩሸይ ካታማ ቦላ ዴፅዳ ግሾ ካታማ ኡባይ ሀይቆ ዳጋማን ኦይከትስ። <verse eid="1SA 5:11"/><verse number="12" style="v" sid="1SA 5:12"/>ሀይቆፐ አትዳ አሳ ክፃ ሀርገይ ኡንኤዳ ግሾ ሄ ካታማ አሳ ዬሆይ ሳሎ ጋክስ።<verse eid="1SA 5:12"/></para>
  <chapter eid="1SA 5"/>
  <chapter number="6" style="c" sid="1SA 6"/>
  <para style="s1">ታቦተይ እስራኤለ ስምስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 6:1"/>ጎዳ ታቦተይ ፍልስፄመ ቢታን ላፑን አጌና ኡትስ። <verse eid="1SA 6:1"/><verse number="2" style="v" sid="1SA 6:2"/>ሄ ዎደ ፍልስፄመ አሳይ ባንታ ካህነታነ ማሮታ ፄግድ፥ “ጎዳ ታቦትያ ኑኒ ዋትኖ? ኑኒ ጉየ እያ በሳ እያ ዋት የዳኔኮ ኑስ ኦድተ” ያግዶሶና።<verse eid="1SA 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 6:3"/>ኤንቲ ዛሪድ፥ “እስራኤለ ፆሳ ታቦትያ ጉየ የድሸ መላ ኩሸ የዶፍተ። አይ ሀንድካ ናጋራ ያርሾራ የድተ። ሄሳ ኦኮ ህንተ ፓፃና፤ እያ ኩሸይ ህንተ ቦላፈ አይስ ክችቦናኮ ህንተ ኤራና” ያግዶሶና።<verse eid="1SA 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 6:4"/>ፍልስፄመ አሳይ፥ “ኑኒ የዳናዉ በሲያ ናጋራ ያርሾይ አይቤ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="1SA 6:4">ኤንቲ፥ “ህንተናነ ህንተ ሀላቃታ ጋክዳ ጋዶይ እስኖ ግድያ ግሾ፥ ፍልስፄመ ሀላቃታ ታይቦን እቻሹ ዎርቃ ክፃታነ እቻሹ ዎርቃ ኤጨረታ የድተ። <verse eid="1SA 6:4"/><verse number="5" style="v" sid="1SA 6:5"/>ህንተ ሄ ክፃታነ ህንተ ቢታ ይስያ ሄ ኤጨረታ ምስለታ መድ፥ እስራኤለ ፆሳስ ቦንቾ እምተ። ኦን ኤር እ ህንተ ቦላፈ፥ ህንተ ፆሳታ ቦላፈነ ህንተ ቢታ ቦላፈ ባ ኩሽያ ደንና። <verse eid="1SA 6:5"/><verse number="6" style="v" sid="1SA 6:6"/>ግብፀ አሳይነ ኤንታ ካዎይ ዞረ ኤኮና እፅዳይሳዳ ህንተ አይስ ዞረ ኤከከቲ? ጎዳይ ኤንታ ዳሮ ሴርን እስራኤለት ባንታ ኦግያ ባና መላ የድቦኮና? <verse eid="1SA 6:6"/><verse number="7" style="v" sid="1SA 6:7"/>ሀእ እስ ኦራ ጋረ ጊግስተ፤ ቃምባራ ዎቦና ናምኡ ንያ ሚዛታ ሄ ጋርያን ዋፅተ፤ ሽን ማራታ ኤንታፈ ዱድ ሶን አሽተ። <verse eid="1SA 6:7"/><verse number="8" style="v" sid="1SA 6:8"/>ጎዳ ታቦትያ ጋርያ ቦላ ዎተ፤ ናጋራ ያርሾስ ጊግስዳ ዎርቃ ክፃታነ ዎርቃ ኤጨረታ ሳፅነን የግድ ጎዳ ታቦትያ ማታን ዎድ እ ባና መላ የድተ። <verse eid="1SA 6:8"/><verse number="9" style="v" sid="1SA 6:9"/>ሽን እ ብያ በሳ በእተ፤ እ ባ ዛዋ ኦይክድ፥ ቤት-ሳሜሳ ስሚድ ብያባ ግድኮ፥ ሀ ጋዱዋ ኑ ቦላ ኤህዳይ ጎዳ ግደይሳ በሴስ። ሽን እ ሀራ ሶ ቢኮ ሀይስ ኑ ቦላ ጮ ጋክስፐ አትሽን፥ ኑና ደችዳይ ጎዳ ኩሸ ግዶናይሳ ኤራና” ያግድ ዛርዶሶና።<verse eid="1SA 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 6:10"/>ኤንቲ ጌተትዳይሳዳ ኦዶሶና፤ ናምኡ ንያ ሚዛታ ኤክድ፥ ጋረን ዋፅዶሶና፤ ማራታ ሶ ዛሪድ ጎርድዶሶና። <verse eid="1SA 6:10"/><verse number="11" style="v" sid="1SA 6:11"/>ኤንቲ ጎዳ ታቦትያ፥ ዎርቃ ክፃነ ኤጨረ ምስለት ደእያ ሳፅንያ ጋረን ዎዶሶና። <verse eid="1SA 6:11"/><verse number="12" style="v" sid="1SA 6:12"/>ሄሳፈ ጉየ፥ ሚዛት ቤት-ሳሜሳ ኤፍያ ኦግያ ኦይክድ ገደ ሃ ጎና “ህምባ” ግድ ዋስሸ ብዶሶና። ፍልስፄመ ሀላቃት ሚዛታ ጌዶ ካልድ፥ ቤት-ሳሜሳ ዛዋ ጋካናዉ ብዶሶና።<verse eid="1SA 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 6:13"/>ቤት-ሳሜሳ አሳይ ሄ ዎደ ዛንጋራን ግስተ ጫኮሶና፤ ኤንቲ ቁ ግድ ፄልድ፥ ታቦትያ በእድ ኡፋይትዶሶና። <verse eid="1SA 6:13"/><verse number="14" style="v" sid="1SA 6:14"/>ጋረይ ቤት-ሳሜሳን ደእያ እያሱ ጌተትያ ኡራ ጋደ ጋክድ፥ እስ ግታ ሹቻ ማታን ኤቅስ። ኤንቲ ጋርያ ም ቀርድ፥ ፁሳ ያርሾ ኦድ ሄ ሚዛታ ጎዳስ ያርሽዶሶና። <verse eid="1SA 6:14"/><verse number="15" style="v" sid="1SA 6:15"/>ሌወት ጎዳ ታቦትያነ ዎርቃ ሚሸት ደእያ ሳፅንያ ጋርያፐ ዎስድ፥ ግታ ሹቻ ቦላ ዎዶሶና። ሄ ጋላስ ቤት-ሳሜሳ አሳይ ጎዳስ ፁሳ ያርሾነ ሀራ ያርሾታ ያርሽዶሶና። <verse eid="1SA 6:15"/><verse number="16" style="v" sid="1SA 6:16"/>እቻሹ ፍልስፄመ ሀላቃት ሀንዳባ ኡባ በእድ ሄ ጋላስ ኤቅሮና ስምዶሶና።<verse eid="1SA 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 6:17"/>ዎርቃ ክፃት ፍልስፄመ ሀላቃት ናጋራ ያርሾ ኦድ ጎዳስ ኪትዳ አሽዶዳ፥ ጋዛ፥ አስቃሎና፥ ጋተነ ኤቅሮና ጌተትያ እቻሹ ካታማታ ሱንን እሱዋ እሱዋ እምዶሶና። <verse eid="1SA 6:17"/><verse number="18" style="v" sid="1SA 6:18"/>ዎርቃ ኤጨረታ ታይቦይ ፍልስፄመ ሀላቃታ እቻሻይ ደእያ ግምበትዳ ካታማታነ ሄራን ደእያ ጉታታ ታይቡዋ መላ። ቤት-ሳሜሳን ደእያ እያሱ ጌተትያ ኡራ ጋደን ጎዳ ታቦትያ ዎዳ ግታ ሹቻይ ሀች ጋካናዉ ማርካ ግድድ ደኤስ።<verse eid="1SA 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 6:19"/>ሽን ኤንቲ ጎዳ ታቦትያስ ግዶ ባጋ በእዳ ግሾ ጎዳይ ቤት-ሳሜሳ አሳፐ ላፑን ታሙ አሳታ ዎስ። ጎዳይ ኤንታፈ ዳሮ አሳ ዎዳ ግሾ አሳይ ዬክዶሶና። <verse eid="1SA 6:19"/><verse number="20" style="v" sid="1SA 6:20"/>ሄሳ ግሾ፥ ቤት-ሳሜሳ አሳይ፥ “ጎዳ ስንን፥ ሀ ጌሻ ፆሳ ስንን ኦን ኤቃናዉ ዳንዳኢ? ታቦተይ ኑፐ ከይድ ኦደኮ ባኔ?” ያግዶሶና። <verse eid="1SA 6:20"/><verse number="21" style="v" sid="1SA 6:21"/>ቅርያት-ይኣርማን ደእያ አሳኮ ኪታ የድድ፥ “ፍልስፄመ አሳይ ጎዳ ታቦትያ ዛርዶሶና፤ ይድ እያ ህንተኮ ኤክተ” ያግዶሶና።<verse eid="1SA 6:21"/></para>
  <chapter eid="1SA 6"/>
  <chapter number="7" style="c" sid="1SA 7"/>
  <para style="p">
    <verse number="1" style="v" sid="1SA 7:1"/>ቅርያት-ይኣርማ አሳይ ይድ፥ ጎዳ ታቦትያ ኤፍድ ደረ ሁጰን ደእያ አምናዳበ ሶን ዎዶሶና። ጎዳ ታቦትያ ናጋና መላ አምናዳበ ናኣ አላዛራ ዱማይድ ሱንዶሶና።<verse eid="1SA 7:1"/></para>
  <para style="s1">ሳሜላ ሹመተ</para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 7:2"/>ታቦተይ ቅርያት-ይኣርማን ዳሮ ዎደ ጋምእስ፤ ያን ላታሙ ላይ ኡትስ። እስራኤለ አሳ ኡባይ አዛንድ ጎዳ ኮይዶሶና።<verse eid="1SA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 7:3"/>ሳሜል እስራኤለ አሳኮ፥ “ኩመ ዎዛናፐ ህንተ ጎዳኮ ስምዳባ ግድኮ፥ አላጋ ፆሳታነ አስታሮተ ኤቃ ህንተ ግዶፈ ድግተ። ህንተናተ ጎዳስ ሼተ፤ እያ ፃላላስ ኪተትተ፤ እ ህንተና ፍልስፄመታ ኩሸፐ አሻና” ያግስ። <verse eid="1SA 7:3"/><verse number="4" style="v" sid="1SA 7:4"/>ሄሳ ግሾ፥ እስራኤለ አሳይ ባኣለነ አስታሮተ ኤቃ ባንታ ግዶፈ ድግድ፥ ጎዳ ፃላላ ጎይንዶሶና።<verse eid="1SA 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 7:5"/>ሄሳፈ ጉየ፥ ሳሜል፥ “እስራኤለታ፥ ኡባይ ምፅጳ ሺቅተ፤ ታኒ ያን ህንተዉ ጎዳ ዎሳና” ያግስ። <verse eid="1SA 7:5"/><verse number="6" style="v" sid="1SA 7:6"/>ኤንቲ ምፅጳ ሺቅድ ሃ ዱቅድ፥ ጎዳ ስንን ጉስዶሶና፤ ሄ ጋላስ ፆምዶሶና፤ ሄ በሳን፥ “ኑኒ ጎዳ ቦላ ናጋራ ኦዳ” ያግድ ፓፅዶሶና። ምፅጳን ሳሜል እስራኤለ አሳ ቦላ ዳይናትስ።<verse eid="1SA 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 7:7"/>እስራኤለት ምፅጳን ሺቅዳይሳ ፍልስፄመ አሳይ ስእዳ ዎደ ኤንታ ኦላናዉ ከይዶሶና። እስራኤለት ሄሳ ስእድ፥ ፍልስፄመታስ ያይዶሶና። <verse eid="1SA 7:7"/><verse number="8" style="v" sid="1SA 7:8"/>እስራኤለ አሳይ ሳሜላኮ፥ “ፍልስፄመ አሳ ኩሸፐ ኑና አሻና መላ ኔኒ ጎዳ፥ ኑ ፆሳ ዎሳ አጎፋ” ያግዶሶና። <verse eid="1SA 7:8"/><verse number="9" style="v" sid="1SA 7:9"/>ሳሜል እስ ምያ ዶርሳ ናአ ኤክድ፥ ኩመ ፁሳ ያርሾ ኦድ ጎዳስ ያርሽስ፤ እስራኤለ አሳ ግሾ ጎዳ ዎስስ፤ ጎዳይ እያ ዎሳ ስእስ።<verse eid="1SA 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 7:10"/>ሳሜል ፁሳ ያርሾ ያርሽያ ዎደ ፍልስፄመት እስራኤለታ ኦላናዉ ሺቅዶሶና። ሽን ሄ ጋላስ ፍልስፄመታ ቦላ ጎዳይ ግታ ዳዳ ጉንድ ዳጋንን፥ ኤንቲ እስራኤለታ ስንፈ ባቃትዶሶና። <verse eid="1SA 7:10"/><verse number="11" style="v" sid="1SA 7:11"/>እስራኤለት ምፅጳፈ ከይድ፥ ፍልስፄመታ የደድ፥ ቤት-ካራፐ ጋርሳ ባጋራ ደእያ በሳ ጋካናዉ ኦገ ቦላ ዎዶሶና።<verse eid="1SA 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 7:12"/>ሄሳፈ ጉየ፥ ሳሜል እስ ሹቹ ኤክድ፥ ምፅጳፈነ ሸናፐ ግዶን ኤስስ፤ “ሀእ ጋካናዉ ጎዳይ ኑና ማድስ” ያግድ ሄ በሳ አበንኤዘራ ግድ ሱንስ።<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="fq" closed="false">አበንኤዘራ፦ </char><char style="ft" closed="false">ሀ ሱን ብርሸይ “ማዶ ሹቹ” ጉሱ።</char></note> <verse eid="1SA 7:12"/><verse number="13" style="v" sid="1SA 7:13"/>ፍልስፄመ አሳይ ፆነትዶሶና፤ ኤንቲ እስራኤለ ቢታ ቦላ ናምአን ደንድቦኮና። ሳሜል ደእዳ ላይ ኡባን ጎዳ ኩሸይ ፍልስፄመ አሳ ቦላ ዴፅስ። <verse eid="1SA 7:13"/><verse number="14" style="v" sid="1SA 7:14"/>ፍልስፄመ አሳይ ኤቅሮናፐ ጋተ ጋካናዉ እስራኤለፐ ድእዳ ካታማት እስራኤለስ ስምዶሶና። እስራኤለ አሳይ ባንታ ካሰ ዛዋ ፍልስፄመ አሳ ኩሸፐ ዎ ኤክዶሶና። እስራኤለ አሳይነ አሞረ አሳይ ሳሮ ደእስ።<verse eid="1SA 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 7:15"/>ሳሜል ባ ደኦ ላይ ኡባን እስራኤለ ቦላ ፕርዴስ። <verse eid="1SA 7:15"/><verse number="16" style="v" sid="1SA 7:16"/>ሳሜል ላይን ላይን ቤተለ፥ ጋልጋላነ ምፅጳ ዩይድ እስራኤለ ቦላ ፕርዴስ። <verse eid="1SA 7:16"/><verse number="17" style="v" sid="1SA 7:17"/>እያ ኬይ ራማን ደእያ ግሾ ያ ስሚድ ሄ በሳንካ እስራኤለ ቦላ ፕርዴስ። እ ራማን ጎዳስ ያርሾ በሲ ኬፅስ።<verse eid="1SA 7:17"/></para>
  <chapter eid="1SA 7"/>
  <chapter number="8" style="c" sid="1SA 8"/>
  <para style="s1">እስራኤለት ካዎ ኮይዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 8:1"/>ሳሜል ጭምዳ ዎደ ባ ናይታ እስራኤለ ቦላ ዳይና ኦድ ሹምስ። <verse eid="1SA 8:1"/><verse number="2" style="v" sid="1SA 8:2"/>እያ ባይራ ናኣ ሱንይ እዩኤላ፤ ካሎ ናአ ሱንይ አብያ፤ ኤንቲ በርሳበን ፕርዶሶና። <verse eid="1SA 8:2"/><verse number="3" style="v" sid="1SA 8:3"/>ሽን እያ ናይት ባንታ አዋ ኦግያ ካልቦኮና። ኤንቲ በሶና ጎአ ደማናዉ ጉየ ስምዶሶና፤ ዎፈ ኤክዶሶና፥ ሱረ ፕርዳ ዎቢስዶሶና።<verse eid="1SA 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 8:4"/>ሄሳ ግሾ፥ እስራኤለ ጭማት እስፈ ሺቅድ፥ ሳሜላኮ ራማ ይድ፥ <verse eid="1SA 8:4"/><verse number="5" style="v" sid="1SA 8:5"/>“ሄኮ ኔኒ ጭማዳሳ፤ ነ ናይት ነ ኦግያ ካሎኮና፤ ሀራ ካዎተት ኦይሳዳ ኑና አይስያ ካዎ ሀእ ኑስ ሹማ” ያግዶሶና።<verse eid="1SA 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 8:6"/>ኤንቲ፥ “ኑና አይስያ ካዎ ኑስ እማ” ግድ ኦይችዳይስ ሳሜላ ኡፋይስቤና። ሄሳ ግሾ፥ ሳሜል ጎዳ ዎስስ። <verse eid="1SA 8:6"/><verse number="7" style="v" sid="1SA 8:7"/>ጎዳይ ሳሜላ፥ “ታኒ ኤንታ ቦላ ካዎቶናዳ ነና ግዶናሽን ታና እፅዳ ግሾ አሳይ ኔኮ ግያባ ኡባ ስአ። <verse eid="1SA 8:7"/><verse number="8" style="v" sid="1SA 8:8"/>ኤንታ ታኒ ግብፀፈ ከስዳ ዎድያፐ ዶምድ ሀች ጋካናዉ ታና አግድ፥ ሀራ ፆሳታ ጎይንሸ ደእዶሶና። ሀእ ኤንቲ ታ ቦላ ኦዳ ኡባ ነ ቦላ ኦሶና። <verse eid="1SA 8:8"/><verse number="9" style="v" sid="1SA 8:9"/>ሀእ ኤንቲ ግያባ ስአ፤ ሽን ኤንታ ቦላ ካዎታና ካዋ ዎጋ ኤንታዉ ምንዳ ኦዳ” ያግስ።<verse eid="1SA 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 8:10"/>ካዎ ኦይችዳ ደርያስ ጎዳይ ኦድዳ ቃላ ኡባ ሳሜል ያግድ ኦድስ። <verse eid="1SA 8:10"/><verse number="11" style="v" sid="1SA 8:11"/>“ህንተ ቦላ ካዎታና ካዎይ ኦናባይ ሀይሳ፤ እ ህንተ አደ ናይታ ኤክድ፥ ፓራ ጋረ አሳታነ ፓራ አሳታ ኦና፤ ኤንቲ እያ ጋርያ ስንን ዎፃና። <verse eid="1SA 8:11"/><verse number="12" style="v" sid="1SA 8:12"/>ኤንታፈ አትዳይሳታ ሻላቃታነ ሀምሳላቃታ፥ ሀራታ እያ ቢታ ጎየይሳታ እያ ካ ጫከይሳታ፥ ቃስ ሀራታ እያ ኦላ ሚሸነ ፓራ ጋረ ሚሸ ኦይሳታ ከሳና። <verse eid="1SA 8:12"/><verse number="13" style="v" sid="1SA 8:13"/>ህንተ ማጫ ናይታካ ኤፍድ፥ ባዉ ሽቶ ጊግሰይሳታ፥ ካይሳታነ ኡከይሳታ ኦና። <verse eid="1SA 8:13"/><verse number="14" style="v" sid="1SA 8:14"/>ህንተ ጎሻፈ፥ ዎይነ ጋደፐነ ሻማሆ ጋደፐ ሎኦ በሳታ ኤክድ፥ ባ ሞርናታስ እማና። <verse eid="1SA 8:14"/><verse number="15" style="v" sid="1SA 8:15"/>ካፈነ ዎይንያፐ ታማፈ እስ ኩሽያ ኤክድ ባ ሹማታስነ ባ ሞርናታስ እማና። <verse eid="1SA 8:15"/><verse number="16" style="v" sid="1SA 8:16"/>ህንተ አደ አይለታፐ፥ ማጫ አይለታፐ፥ ህንተ ናአተታፈነ ህንተ ሀርያፐ ሎኤይሳ ባዉ ጎኤታናዉ ኤካና። <verse eid="1SA 8:16"/><verse number="17" style="v" sid="1SA 8:17"/>ህንተ ዶርሳፈነ ዴሻፐ ታማፈ እስ ኩሸ ኤካና፤ ህንተ እያ ኦሳንቾ ግዳና። <verse eid="1SA 8:17"/><verse number="18" style="v" sid="1SA 8:18"/>ሄ ጋላሳይ ጋክዳ ዎደ ህንተ ዶርዳ ካዎይ ጋያ ቆሁዋ ግሾ ዋሳና፤ ሽን ሄ ጋላስ ጎዳይ ህንተ ዋሱዋ ስኤና” ያግስ።<verse eid="1SA 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 8:19"/>ግዶሽን፥ አሳይ ሳሜላ ቃላ ስኦና እፅድ፥ “አካይ፥ ኑስ ካዎይ ደኦ። <verse eid="1SA 8:19"/><verse number="20" style="v" sid="1SA 8:20"/>ሀራ ካዎተታ መላ ኑና ካለያ፥ ኑ ስንን ብያነ ኑ ኦላ ኦለትያ ካዎይ ደኦ።”<verse eid="1SA 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 8:21"/>ሳሜል አሳ ቃላ ኡባ ስእድ፥ ጎዳስ ኦድስ። <verse eid="1SA 8:21"/><verse number="22" style="v" sid="1SA 8:22"/>ጎዳይ ሳሜላኮ፥ “ኤንታ ቃላ ስአ፤ ኤንታ ቦላ ካዎ ካዎ” ያግስ።</para>
  <para style="p" vid="1SA 8:22">ሳሜል እስራኤለ አሳኮ፥ “ህንተ ሶ ሶ ስምተ” ያግስ።<verse eid="1SA 8:22"/></para>
  <chapter eid="1SA 8"/>
  <chapter number="9" style="c" sid="1SA 9"/>
  <para style="s1">ሳኦላነ ሳሜላ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 9:1"/>ብንያመ ኮቸ ግድዳ እስ ቂሳ ጌተትያ አደይ ደኤስ፤ እ ኤረትዳ አስ። እ አብኤላ ናአ፤ አቤል ፃሮራ ናአ፤ ፃሮር ባኮራተ ናአ፤ ባኮራት ብንያመ ኮቸ ግድዳ አፌቃ ናአ። <verse eid="1SA 9:1"/><verse number="2" style="v" sid="1SA 9:2"/>እያዉ ሳኦላ ጌተትያ እስ ማላ ሎኦ ግድዳ ፓን ናእ ደኤስ። እስራኤለታ ግዶን እያ መላ ማላ ሎኦይ ባዋ፤ እ አስ ኡባይ እያ ሀሸፐ ጋርሳን አትያ አዱሳ አስ።<verse eid="1SA 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 9:3"/>እስ ጋላስ ሳኦላ አዋ ቂሳ ሀረት ይዶሶና፤ ቂስ ባ ናኣ ሳኦላኮ፥ “ኦሳንቾታፐ እሱዋ ኤካዳ ሀረታ ኮያናዉ ባ” ያግስ። <verse eid="1SA 9:3"/><verse number="4" style="v" sid="1SA 9:4"/>ኤንቲ ደረይ ዳርያ ኤፍሬማ ቢታራነ ሻልሻ ቢታራ ኮይሸ አዶሶና፥ ሽን ሀረታ ደምቦኮና። ቃስ ሻአልማ ቢታራ ኮይሸ አዶሶና፥ ሽን ያንካ ሀረት ዶኮና። ብንያመ ቢታራ አዶሶና፥ ሽን ያንካ ደምቦኮና።<verse eid="1SA 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 9:5"/>ኤንቲ ዙፋ ቢታ ጋክዳ ዎደ ሳኦል ባራ ደእያ ኦሳንቹዋኮ፥ “ሃያ፤ አነ ጉየ ስሞስ፤ አዋይ ሀረታባ ቆፐይሳ አግድ፥ ኑስ ህርጋና” ያግስ።<verse eid="1SA 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 9:6"/>ሽን ኦሳንቾይ፥ “ሄኮ፥ እስ ቦንቸትዳ ፆሳ አስ ሀ ካታማን ደኤስ፤ እ ኦድያ ኡባይ ፖለቴስ። አነ ሀእ ያ ቦስ፤ ኦን ኤር ኑ ባና ኦግያ እ ኑስ ኦዳነኮ” ያግስ።<verse eid="1SA 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 9:7"/>ሳኦል፥ “ኑ ብያባ ግድኮ እያዉ አይ እማኔ? ኑ ኦይክዳ ካይ ዉርስ፤ ኑ ፆሳ አሳስ እምያባይ ባዋ። ኑስ አይብ ደኢ?” ያግስ።<verse eid="1SA 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 9:8"/>ኦሳንቾይ ዛሪድ፥ “ታ ኩሸን ጉ ብራ ሳንትመይ ደኤስ፤ ኑ ባና ኦግያ ኑስ ኦዳና መላ ፆሳ ኡራስ ሀኖ እማና” ያግስ።<verse eid="1SA 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 9:9"/>(በን ዎደ እስራኤለ ቢታን እስ አስ ፆሰ ኦይቻናዉ ብሸ፥ “አነ ቆንጨ በእያ አሳኮ ቦስ” ያጌስ። ሀእ ናበ ጌተተይስ ሄ ዎደ ቆንጨ በእያ አስ ጌተቴስ።) <verse eid="1SA 9:9"/><verse number="10" style="v" sid="1SA 9:10"/>ሳኦል ዛሪድ፥ “ሎኦ፤ የ” ያግን፥ ፆሳ ኡራይ ደእያ ካታማ ብዶሶና። <verse eid="1SA 9:10"/><verse number="11" style="v" sid="1SA 9:11"/>ኤንቲ ፑደ ካታማ ከይሽን፥ ሃ ትካናዉ ያ ጌላኦታራ ኦገን ጋሄትድ፥ “ቆንጨ በእያ አስ ሀይሳን ደኢ?” ያግድ ኦይችዶሶና።<verse eid="1SA 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 9:12"/>ኤንቲ፥ “ኤ ደኤስ፤ እ ህንተፈ ስንን ደኤስ፤ ኤለስድ ቢተ። ሀች አሳይ ቃ ጎይኖ በሳን ያርሾ ያርሽያ ግሾ፥ እ ኑ ካታማ ይስ። <verse eid="1SA 9:12"/><verse number="13" style="v" sid="1SA 9:13"/>ህንተ ካታማ ገልያ ዎደ እ ማናዉ ቃ ጎይኖ በሳ ከዮና ደእሽን ህንተ እያ ደማና። እ ያርሹዋ አንጃናዉ ኮሽያ ግሾ እ ጋኮና ደእሽን አሳይ ካ ሜና። እ አንጅዳፐ ጉየ ፄገትዳይሳት ማና። ኤለ ከይተ፤ ህንተ እያ ሀእ ደማና” ያግዶሶና። <verse eid="1SA 9:13"/><verse number="14" style="v" sid="1SA 9:14"/>ኤንቲ ካታማ ገልያ ዎደ ሳሜል ጎይኖ በሳ ከያናዉ ብሸ ኤንታራ ጋሄትስ።<verse eid="1SA 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 9:15"/>ሳኦል ያናፐ ካሰ ጋላስ ሳሜላስ ጎዳይ ሀይሳዳ ያግድ ቆንጭስስ፤ <verse eid="1SA 9:15"/><verse number="16" style="v" sid="1SA 9:16"/>“ዎንቶ ሀኖደ ብንያመ ቢታፈ እስ አስ ታ ኔኮ የዳና፤ እ ታ አሳ እስራኤለ ካለና መላ ትያ። እ ታ አሳ ፍልስፄመ ኩሸፐ አሻና፤ ታ አሳ ዋሶይ ታኮ ጋክዳ ግሾ ታ ኤንታ በአስ” ያግስ።<verse eid="1SA 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 9:17"/>ሳሜል ሳኦላ በእዳ ዎደ ጎዳይ፥ “ታኒ ነዉ ኦድዳ ኡራይ ሀይሳ፤ እ ታ አሳ ካለና” ያግስ።<verse eid="1SA 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 9:18"/>ሳኦል ግምበ ድርሳ ፐንግያ ማታን ደእያ ሳሜላኮ ሺቅድ፥ “ቆንጨ በእያ ኡራ ሶይ አዉነኮ ታዉ ኦዳርኪ?” ያግስ።<verse eid="1SA 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 9:19"/>ሳሜል ዛሪድ፥ “ቆንጨ በኤይ ታና። ሀች ህንተ ታራ ምያ ግሾ ታፐ ስንትድ ጎይኖ በሳ ቢተ። ታኒ ነና ዎንቶ ጉራ የዳና፤ ነ ዎዛናን ደእያ ኡባ ታ ነዉ ኦዳና። <verse eid="1SA 9:19"/><verse number="20" style="v" sid="1SA 9:20"/>ሄ ጋላሳፐ ስን ይዳ ሀረታባ ግድኮ ኤንቲ በንትዳ ግሾ ህርጎፋ። እስራኤለ አሳ ኡባ አሞይ ኦኔ? ነናነ ነ አዋ ሶ አሳ ግደኔ?”<note caller="+" style="f"><char style="fr" closed="false">9:20 </char><char style="ft" closed="false">እስራኤለ ኡባን ኮየተይ ነና ግድኪ?</char></note> ያግስ።<verse eid="1SA 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 9:21"/>ሳኦል ዛሪድ፥ “ሽን ታኒ እስራኤለ ዛረ ኡባፈ ላፋ ግድዳ ብንያመ ኮቸ ግድክና? ታ ሶ አሳይ ብንያመ ኮቻ ግዶን ጉ ግደኔ? ኔኒ አይስ ታዉ ሀይሳ መላባ ኦዳይ?” ያግስ።<verse eid="1SA 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 9:22"/>ሄሳፈ ጉየ፥ ሳሜል ሳኦላነ እያ ኦሳንቾይ ኤፍድ፥ ዳልጋ ኬ ገልስድ ሄ በሳ ፄገትዳ ሀስታሙ ግድያ አሳ ግዶን ቦንቾ በሳን ኡትስስ። <verse eid="1SA 9:22"/><verse number="23" style="v" sid="1SA 9:23"/>ሳሜል ካ ካይሳኮ፥ “ነ ማታን ዱማ ዎሻ ጋዳ ታኒ ነዉ እምዳ አሹዋ ሀማ” ያግስ።<verse eid="1SA 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 9:24"/>ካ ካይስ ምሳ አሹዋ ኤህድ፥ ሳኦላ ስንን ዎስ። ሳሜል ሳኦላኮ፥ “ታ ነዉ ዱማ ሻካዳ ዎዳ አሾይ ሀይሳ፤ ኤካዳ ማ። ታኒ እማታ ፄግዳ ዎደፐ ዶማዳ ሀይሳ ነዉ አሻስ” ያግስ። ሄ ጋላስ ሳኦል ሳሜላራ ምስ። <verse eid="1SA 9:24"/><verse number="25" style="v" sid="1SA 9:25"/>ኤንቲ ጎይኖ በሳፈ ዱገ ካታማ ዎን፥ ኬ ቦላ ደእያ በሳን ሳሜል ሳኦላራ ኦደትስ።<verse eid="1SA 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 9:26"/>ሳእ ዎንትን፥ ሳሜል ሳኦላ ኬ ቦላፈ ፄግድ፥ “ደንዳ፤ ታ ነና ሞይዛና” ያግስ። ሳኦል ደንድን፥ ናምአይ ኦገ ቦላ ከይዶሶና። <verse eid="1SA 9:26"/><verse number="27" style="v" sid="1SA 9:27"/>ኤንቲ ካታማ ጋፃ ጋክሽን፥ ሳሜል ሳኦላኮ፥ “ነ ኦሳንቾይ ስን ባና መላ ኦዳ” ያግስ። ኦሳንቾይ ስን አድ ብን፥ ሳሜል ሳኦላኮ፥ “ፆሲ ግዳባ ታ ነዉ ኦዳና መላ ሀይሳን ጉ ጋምአ” ያግስ።<verse eid="1SA 9:27"/></para>
  <chapter eid="1SA 9"/>
  <chapter number="10" style="c" sid="1SA 10"/>
  <para style="p">
    <verse number="1" style="v" sid="1SA 10:1"/>ሄ ዎደ ሳሜል ትግያባራ ዛይተ ኤክድ፥ ሳኦላ ሁጰን ትይስ። ሳኦላ ዬርድ፥ ሀይሳዳ ያግስ፤ “ባ አሳ እስራኤለ ካለና መላ ጎዳይ ነና ትይስ።<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">ግርከ ብርሸይ፥ “ኔኒ እያ አሳ ካለዳ ኤንታ ዩሹዋን ደእያ ሞርከታ ኩሸፐ ኤንታ አሻና። እያ ላታ ኔኒ ካለና መላ ጎዳይ ነና ትይዳይሳስ ሀይስ ማላ” ያግድ ጉጅስ።</char></note> <verse eid="1SA 10:1"/><verse number="2" style="v" sid="1SA 10:2"/>ኔኒ ሀች ታፐ ሻከታዳ ብያ ዎደ ራሄል ዱፉዋ ማታን ብንያመ ዛዋን ደእያ ፃልፃሀ ጌተትያ በሳን ናምኡ አሳታራ ጋሄታና። ኤንቲ ነና፥ ‘ነ ኮያናዉ ብዳ ሀረት በንትዶሶና፤ ሀእ ነ አዋይ ሀረታ ቆፐይሳ አግድ፥ ታ ናአይ ዋንደሻ?’ ያግድ ነዉ ህርጌስ” ያግድ ኦዳና።<verse eid="1SA 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 10:3"/>ኔኒ ሄ በሳፈ ደንዳዳ፥ ታቦረ ግታ ም ጋካናዉ ባና። ፆሳኮ ቤተለ ብያ ሄ አሳት ያን ኔራ ጋሄታና። ኤንታፈ እሶይ ሄ ዴሻ ማር ቶክስ፤ ናምአንይ ሄ ኡይ ቶክስ፤ ሄንይ ኦጎሮ ኩም ዎይነ ቶክስ። <verse eid="1SA 10:3"/><verse number="4" style="v" sid="1SA 10:4"/>ኤንቲ ነና ሳሮና፤ ነዉ ናምኡ ኡይ እማና፤ ነ ኤንታ ኩሸፐ ሄ ኡይ ኤካናዉ ኮሼስ።<verse eid="1SA 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 10:5"/>“ሄሳፈ ጉየ፥ ኔኒ ፍልስፄመ ኦላንቾታ ጩጋይ ደእያ ፆሳ ደርያ ግብአ ባና። ኔኒ ሄ ካታማ ጋክያ ዎደ ዲራ ካራቦራ፥ ሱሱልኤነ ዛየ ፑንድ ካእሸነ ትንብተ ኦድሸ፥ ጎይኖ በሳፈ ዎያ ናበ ጩጋራ ጋሄታና። <verse eid="1SA 10:5"/><verse number="6" style="v" sid="1SA 10:6"/>ጎዳ አያናይ ነ ቦላ ዎልቃን ዎና፤ ኔኒ ኤንታራ ትንብተ ኦዳና፤ ኔኒ ላመታዳ ሀራ አስ ግዳና። <verse eid="1SA 10:6"/><verse number="7" style="v" sid="1SA 10:7"/>ሀ ማላት ፖለትያ ዎደ ፆሳይ ኔራ ደእያ ግሾ ነ ኦናዉ ዳንዳእያባ ኡባ ኦ።<verse eid="1SA 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 10:8"/>“ኔኒ ታፐ ስንታዳ ጋልጋላ ዎ። ታኒ ፁሳ ያርሾነ ሳሮተ ያርሾ ያርሻናዉ ኔኮ ባና። ታ ኔኮ ባዳ ነ ኦናባ ኦዳና ጋካናዉ ላፑን ጋላስ ጋምአ” ያግስ።<verse eid="1SA 10:8"/></para>
  <para style="s1">ሳኦል ካዎትስ</para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 10:9"/>ሳኦል ሳሜላፐ ሻከትዳ ዎደ ፆሳይ ሳኦላ ዎዛና ላምስ፤ ሳሜል ኦድዳ ማላት ኡባይ ሄ ጋላስ ሀንዶሶና። <verse eid="1SA 10:9"/><verse number="10" style="v" sid="1SA 10:10"/>ሳኦልነ እያ አይለይ ግብአ ጋክያ ዎደ ናበ ጩጋይ እያራ ጋሄትስ። ፆሳ አያናይ እያ ቦላ ዎልቃራ ዎን እ ኤንታ ግዶን ትንብተ ኦደትስ። <verse eid="1SA 10:10"/><verse number="11" style="v" sid="1SA 10:11"/>ሳኦላ ካሰ ኤርያ ኡባይ እ ናበታራ ትንብተ ኦደተይሳ በእዳ ዎደ፥ “ቂሳ ናአይ ዋንዴ? ሳኦል ናበ ያሬ?” ያግዶሶና። <verse eid="1SA 10:11"/><verse number="12" style="v" sid="1SA 10:12"/>ሄ በሳን ደእያ እስ ኡራይ፥ “ኑ ኤንታ አዋይ ኦነኮ ኤርዉ?” ያግድ ኦይችስ። ሄሳ ግሾ፥ “ሳኦል ናበ ኮቼ?” ገይስ ሀይሰ ግድስ። <verse eid="1SA 10:12"/><verse number="13" style="v" sid="1SA 10:13"/>ሳኦል ትንብተ ኦደይሳ ዉርስዳፐ ጉየ ጎይኖ ዙማ ቦላ ከይስ።<verse eid="1SA 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 10:14"/>ሳኦላ አዋ እሻይ ሳኦላነ እያ አይልያ፥ “አዉ ብደቲ?” ያግስ።</para>
  <para style="p" vid="1SA 10:14">ሳኦል፥ “ሀረታ ኮያናዉ ብዳ፤ ሀረት በንቶና እፅን ሳሜላ ኦይቻናዉ ብዳ” ያግስ።<verse eid="1SA 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 10:15"/>ሳኦላ አዋ እሻይ፥ “ሀያና ሳሜል ነዉ ግዳባ ታዉ ኦዳርኪ” ያግስ።<verse eid="1SA 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 10:16"/>ሳኦል፥ “ሀረት በንትዳይሳ ናበይ ሳሜል ኑስ ጌሽድ ኦድስ” ያግስ። ሽን “ነ ካዎ ግዳና” ግድ ሳሜል እያዉ ኦድዳይሳ ባ አዋ እሻስ ኦድቤና።<verse eid="1SA 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 10:17"/>ሄሳፈ ጉየ፥ ሳሜል ምፅጳን እስራኤለ አሳ ጎዳ ስንን ሺሽስ። <verse eid="1SA 10:17"/><verse number="18" style="v" sid="1SA 10:18"/>ኤንታ፥ “ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፤ ‘ታኒ እስራኤለ ግብፀፈ ከሳስ፤ ግብፀ አሳ ኩሸፐነ ህንተና ኡንኤያ ካዎተታ ኡባ ኩሸፐ አሻስ።’ <verse eid="1SA 10:18"/><verse number="19" style="v" sid="1SA 10:19"/>ሽን ሀች ህንተና ህንተ መቱዋፐነ ዋያፐ አሽያ ታና ህንተ ፆሳ እፅደታ። ‘አካይ፥ ኑስ ካዎ ካዎ’ ያግደታ። ሄሳ ግሾ፥ ሀእ ህንተ፥ ህንተ ኮቻን ኮቻን ግድድ ጎዳ ስን ሺቅተ” ያግስ።<verse eid="1SA 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 10:20"/>ሳሜል እስራኤለ ዛረ ሺሽን፥ ብንያመ ኮቻይ ዶረትስ። <verse eid="1SA 10:20"/><verse number="21" style="v" sid="1SA 10:21"/>ብንያመ ኮቻ ሺሽን፥ ማፅራ ኮቻይ ዶረትስ። ዉርሰን ቂሳ ናአይ ሳኦል ዶረትስ፤ ኤንቲ እያ ኮይዶሶና፥ ሽን እ በንትቤና። <verse eid="1SA 10:21"/><verse number="22" style="v" sid="1SA 10:22"/>ሄሳ ግሾ ኤንቲ፥ “አደይ ሀ በሳ ይዴ?” ያግድ ጎዳ ኦይችዶሶና።</para>
  <para style="p" vid="1SA 10:22">ጎዳይ፥ “ኤ፥ ሳኦል ሚሸ ግዶን ቆሰትድ ኡትስ” ያግስ።<verse eid="1SA 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 10:23"/>ኤንቲ ዎፅ ብድ፥ ቆሰትዳ በሳፈ ከስ ኤህዶሶና። አሳ ግዶን እ ኤቅያ ዎደ አስ ኡባይ እያ ሀሸፐ ጋርሳራ አትያ አዱሳ አስ። <verse eid="1SA 10:23"/><verse number="24" style="v" sid="1SA 10:24"/>ሳሜል አሳኮ፥ “ጎዳይ ዶርዳ አድያ በእቴ? እያ ዳንያ አስ ሀ አሳ ግዶን ኦንካ ባዋ” ያግስ።</para>
  <para style="p" vid="1SA 10:24">አሳ ኡባይ ባንታ ቃላ ቁ ኦድ፥ “ካዎይ ብራታ ቱስ ግዶ” ያግስ።<verse eid="1SA 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 10:25"/>ሄሳፈ ጉየ፥ ሳሜል ካዎተ ዎጋ አሳስ ኦድስ፤ ፃ ማፃፋን ሄ ዎጋ ፃፍድ ጎዳ ስንን ዎስ። ያትድ ሳሜል አሳ ኡባ ባ ሶ ሶ ሞይዝስ።<verse eid="1SA 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 10:26"/>ሳኦል ባ ሶ ግብአ ብስ፤ ፆሳይ ኤንታ ዎዛና ቦችዳ ምኖ አሳት ሳኦላራ ብዶሶና። <verse eid="1SA 10:26"/><verse number="27" style="v" sid="1SA 10:27"/>ሽን እስ እስ ፓና አሳት፥ “ሀ አደይ ኑና ዋትድ አሻኔ?” ያግዶሶና። ኤንቲ እያ ካድ፥ እያዉ አይ እሞታካ እምቦኮና። ሽን ሳኦል ስእ ግስ።<verse eid="1SA 10:27"/></para>
  <chapter eid="1SA 10"/>
  <chapter number="11" style="c" sid="1SA 11"/>
  <para style="s1">ሳኦል አሞነታ ፆንስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 11:1"/>እስ አጌናፐ ጉየ፥<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">ግርከ ብርሸይ እስ አጌናፐ ጉየ ግድ ጉጄስ</char></note> አሞነ ካዎይ ናኦስ ደንድድ፥ ጋላዳን ደእያ ያበሳ ካታማ ተቅስ። ያበሳ አሳይ፥ “ኔኒ ኑራ ጫቃ፤ ኑኒ ነዉ ሃረታና” ያግዶሶና።<verse eid="1SA 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 11:2"/>ናኦስ፥ “ታኒ ህንተራ ጫቃናይ ህንተ ኡሻቻ አይፍያ ዎጫ ከሳዳ እስራኤለ ካዉሽዳፐ ጉየና” ያግስ።<verse eid="1SA 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 11:3"/>ያበሳ ጭማት ናኦሳኮ፥ “እስራኤለ ቢታ ኡባ ኑኒ ኪታ የዳና መላ ላፑን ጋላስ ታካ፤ ኑና አሽያ አስ ይኮ ኑኒ ነዉ ኩሸ እማና” ያግዶሶና።<verse eid="1SA 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 11:4"/>ኪተትዳ አሳይ ሳኦል ደእያ በሳ ግብአ ጋክድ ሀ ኦዳ አሳስ ኦድዶሶና፤ አሳ ኡባይ ባንታ ቃላ ቁ ኦድ ዬክዶሶና። <verse eid="1SA 11:4"/><verse number="5" style="v" sid="1SA 11:5"/>ሄ ዎደ ሳኦል ባ ቦራታ ላግድ ጎሻፈ ይሸ፥ “አሳይ ዋንዴ? አይስ ዬኮና?” ያግድ ኦይችስ። ኤንቲ ያበሳ አሳይ ግዳባ እያዉ ኦድዶሶና።<verse eid="1SA 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 11:6"/>ሀ ቃላ ሳኦል ስእዳ ዎደ ፆሳ አያናይ እያ ቦላ ዎልቃን ዎስ፤ ሳኦል ሸነ ኤፅስ። <verse eid="1SA 11:6"/><verse number="7" style="v" sid="1SA 11:7"/>ሳኦል ዋፃ ቦራታ ሙፀረድ፥ “ሳኦላነ ሳሜላ ካልድ፥ ከዮና አሳ ቦራት ሀይሳዳ ሙፀታና” ያግድ ኪተትዳ አሳታ ቦላ እስራኤለ ቢታ ኡባ የድስ።</para>
  <para style="p" vid="1SA 11:7">ሄ ዎደ አሳ ኡባይ ጎዳስ ያይዶሶና፤ ኤንቲ እስ አሳዳ ሀንድ ከይዶሶና። <verse eid="1SA 11:7"/><verse number="8" style="v" sid="1SA 11:8"/>ሳኦል ቤዘቃን ኤንታ ሺሽድ ታይብዳ ዎደ እስራኤለ አሳይ ሄ ፄቱ ሙኩሉ፤ ይሁዳ አሳይ ሀስታሙ ሙኩሉ ግድስ። <verse eid="1SA 11:8"/><verse number="9" style="v" sid="1SA 11:9"/>ኪተትዳ አሳይ፥ “ብድ ያበሳ ጋላዳ አሳስ፥ ‘ዎንቶ ፃልቀይ ምችያ ዎደ ኑኒ ህንተና አሻና ያግድ ኦድተ’ ” ያግዶሶና። ኪተትዳ አሳይ ብድ፥ ያበሳ አሳስ ሄሳ ኦድን፥ ኤንቲ ዳሮ ኡፋይትዶሶና።<verse eid="1SA 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 11:10"/>ያበሳ አሳይ አሞነታኮ፥ “ኑኒ ዎንቶ ህንተዉ ኩሸ እማና፤ ህንተ ኑ ቦላ ዶስዳባ ኦተ” ያግዶሶና።<verse eid="1SA 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 11:11"/>ዎንተ ጋላስ ሳኦል ባ አሳ ሄ ጩጋን ሻክስ። ኤንቲ ሳእ ዎንትያ ዎደ አሞነ አሳይ ዱንካንዳ ጉታ ገልድ፥ ፃልቀይ ምቻና ጋካናዉ አሞነታ ጎይርዶሶና። ጎይረተፈ አትዳይሳት ናምኡ አስ እስፈ ዶናዳ ባዉ ባዉ ባቃቲስ።<verse eid="1SA 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 11:12"/>እስራኤለ አሳይ ሳሜላኮ፥ “ሳኦል ኑ ቦላ ካዎታነ ያግዳ አሳት ኦናንቴ? ኤንቲ ኦነኮ ከስተ፤ ኑ ኤንታ ዎና” ያግስ።<verse eid="1SA 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 11:13"/>ሽን ሳኦል፥ “ሀች ጎዳይ እስራኤለ አሽዳ ግሾ እስ አስካ ሀይቀና” ያግድ ዛርስ።<verse eid="1SA 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 11:14"/>ሳሜል፥ “ሃይተ፤ ጋልጋላ ብድ፥ ያን ሳኦል ካዎ ግደይሳ ዛሪድ ኤርሶስ” ያግስ። <verse eid="1SA 11:14"/><verse number="15" style="v" sid="1SA 11:15"/>ሄሳ ግሾ፥ አሳ ኡባይ ጋልጋላ ብድ፥ ጎዳ ስንን ሳኦል ካዎ ግደይሳ ኤርስዶሶና። ያን እስፈተ ያርሾ ጎዳ ስንን ያርሽዶሶና። ሳኦልነ እስራኤለ አሳ ኡባይ ሄ በሳን ባኣለ ኡፋይሳን ቦንችዶሶና።<verse eid="1SA 11:15"/></para>
  <chapter eid="1SA 11"/>
  <chapter number="12" style="c" sid="1SA 12"/>
  <para style="s1">ሳሜላ ዉርሰ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 12:1"/>ሳሜል እስራኤለ ኡባኮ፥ “ህንተ ታዉ ኦድዳ ኡባ ስአዳ፥ ህንተ ቦላ ካዎ ካዎስ። <verse eid="1SA 12:1"/><verse number="2" style="v" sid="1SA 12:2"/>ሀእ ህንተና ካለናዉ ካዎይ ደኤስ። ታኒ ዳሮ ጭማዳ ፑሉማስ፤ ታ ናይት ህንተራ ደኦሶና። ታኒ ታ ናአተፈ ዶማዳ ሀች ጋካናዉ ህንተና ካለስ። <verse eid="1SA 12:2"/><verse number="3" style="v" sid="1SA 12:3"/>ሄኮ፥ ታኒ ህንተ ስንን ኤቃስ፤ ጎዳ ስንንነ እ ትይዳ ካዋ ስንን ታ ቦላ ማርካትተ። ታኒ ኦደ ቦሩ ኤካድና? ኦደ ሀረ ኤካድና? ኦና ጭማድና? ኦና ኡንኤድና? በአሸ በኦናዳ ሀናናዉ ኦደፈ ዎፈ ኤካድና? ሀይሳታፐ እሱዋ ታኒ ኦዳባ ግድኮ ታዉ ኦድተ፤ ታ ቃንፃና” ያግስ።<verse eid="1SA 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 12:4"/>ኤንቲ ዛሪድ፥ “ኔኒ ኑና ጭማባካ፤ ዎይኮ ኑና ኡንኤባካ፤ ነ ኦደ ኩሸፐ አይባካ ኤካባካ” ያግዶሶና።<verse eid="1SA 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 12:5"/>ሳሜል፥ “ህንተ ታ ኩሸን አይ ባላካ ደምቦናይሳ ጎዳይነ እ ትይዳ ካዎይ ሀች ህንተ ቦላ ማርካ” ያግስ።</para>
  <para style="p" vid="1SA 12:5">አሳይ፥ “ኤ፥ ፆሳይ ማርካ” ያግዶሶና።<verse eid="1SA 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 12:6"/>ቃስካ ሳሜል፥ “ሙሰነ አሮና ዶርዳይነ ህንተ ማይዛታ ግብፀፈ ከስዳይ ጎዳ። <verse eid="1SA 12:6"/><verse number="7" style="v" sid="1SA 12:7"/>ሀእ ህንተዉነ ህንተ ማይዛታስ ጎዳይ ኦዳ ፅሎ ኦሶ ኡባስ ታኒ ህንተነራ ጎዳ ስንን ሞተታና መላ ሀይሳን ኤቅተ። <verse eid="1SA 12:7"/><verse number="8" style="v" sid="1SA 12:8"/>ያይቆብነ እያ ሶ አሳይ ግብፀን ደእሽን፥ ግብፀ አሳይ ኤንታ ኡንኤዳ ዎደ ህንተ ማይዛት ጎዳኮ ዋስዶሶና። ጎዳይ ሙሰነ አሮና ኪትስ፤ ኤንቲ ህንተ ማይዛታ ግብፀፈ ከስድ ሀይሳን ዎዶሶና።<verse eid="1SA 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 12:9"/>“ሽን እስራኤለ አሳይ ጎዳ ባንታ ፆሳ ዶግዶሶና። ጎዳይ ኤንታ ሀፆራ ቶራ ሞጮና ስሳራ ኩሸን፥ ፍልስፄመ አሳ ኩሸንነ ሞአበ ካዋ ኩሸን አድ እምን ኤንታ ኦልዶሶና። <verse eid="1SA 12:9"/><verse number="10" style="v" sid="1SA 12:10"/>ኤንቲ፥ ‘ኑኒ ናጋራ ኦዳ፤ ጎዳ አግድ፥ ባኣለነ አስታሮታ ጎይንዳ። ሽን ሀእ ነ ኑና ኑ ሞርከታ ኩሸፐ አሻ፤ ኑኒ ነና ጎይናና’ ያግድ ጎዳኮ ዋስዶሶና። <verse eid="1SA 12:10"/><verse number="11" style="v" sid="1SA 12:11"/>ጎዳይ ገድዮና፥<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="fq" closed="false">ገድዮና፦ </char><char style="ft" closed="false">እብራወ ዶናን የሩባኣላ ጌተቴስ</char></note> ባራቃ፥<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="fq" closed="false">ባራቃ፦ </char><char style="ft" closed="false">እብራወ ዶናን ባዳና ጌተቴስ</char></note> ዮፍታሄነ ሳሜላ ኪትድ፥ ህንተ ዩሾ ኡባን ደእያ ሞርከታ ኩሸፐ ህንተና አሽስ። ያትን፥ ህንተ ሳሮ ደእደታ።<verse eid="1SA 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 12:12"/>“አሞነ ካዎይ ናኦስ ህንተኮ ይዳይሳ በእዳ ዎደ ጎዳይ ህንተ ፆሳይ ህንተ ካዎ ግድኮካ፥ ህንተ፥ ‘አካይ፥ ኑኒ ካዎ ኮዮስ’ ያግደታ። <verse eid="1SA 12:12"/><verse number="13" style="v" sid="1SA 12:13"/>ሀእ ህንተ ዶርዳነ ኦይችዳ ካዎይ ሀይስሽ። ሄኮ፥ ጎዳይ ህንተ ቦላ ካዎስ። <verse eid="1SA 12:13"/><verse number="14" style="v" sid="1SA 12:14"/>ህንተ ጎዳስ ያይኮ፥ እያዉ ኪተትኮ፥ እያ ቃላ ስእኮ፥ እያ ኪታ ቦላ ማካሎና እፅኮ፥ ህንተነ ህንተ ቦላ ካዎትያ ካዎይ ጎዳ ህንተ ፆሳ ካልኮ ኡባባይ ሱራና። <verse eid="1SA 12:14"/><verse number="15" style="v" sid="1SA 12:15"/>ሽን ህንተ ጎዳ ቃላስ ኪተቶና እፅኮነ እያ ኪታ ቦላ ማካልኮ፥ ጎዳ ፕርዳይ ካሰ ህንተ አዋታ ቦላ ይዳይሳዳ ህንተ ቦላካ ያና።<verse eid="1SA 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 12:16"/>“ህዛ ምንድ ኤቅተ፤ ጎዳይ ህንተ አይፍያ ስንን ኦና ግታባ በእተ። <verse eid="1SA 12:16"/><verse number="17" style="v" sid="1SA 12:17"/>ሀእ ግስተ ጫካ ዎደ ግደኔ? ጎዳይ ዳዳነ እራ የዳና መላ ታኒ ጎዳ ዎሳና። ህንተ ካዎ ኦይችድ፥ ጎዳ ስንን አይ መላ ኢታባ ኦዳኮ ህንተ አኬካና” ያግስ።<verse eid="1SA 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 12:18"/>ሳሜል ጎዳ ዎስስ፤ ጎዳይ ሄ ጋላስ ዳዳነ እራ የድስ፤ ሄሳ ግሾ፥ አሳይ ጎዳነ ሳሜላ ዳሮ ያይዶሶና።<verse eid="1SA 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 12:19"/>አሳይ፥ “ኑኒ ካዎ ኦይችድ፥ ኑ ናጋራ ኡባ ቦላ ሀ ኢታተ ጉጅዳ ግሾ ኑኒ ነ አይለት ሀይቆና መላ ኑስ ጎዳ ነ ፆሳ ዎሳርክ” ያግስ።<verse eid="1SA 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 12:20"/>ሳሜል አሳኮ፥ “ያዮፍተ፤ ህንተ ሀ ኢታተ ኡባ ኦደታ፤ ሽን ህንተ ኩመ ዎዛናን ጎዳስ ኪተትተ፤ እያ ካሎ አጎፍተ። <verse eid="1SA 12:20"/><verse number="21" style="v" sid="1SA 12:21"/>ፓናባ ግድያ ግሾ ማዶናነ አሾና ኤቃታ ካሎፍተ። <verse eid="1SA 12:21"/><verse number="22" style="v" sid="1SA 12:22"/>ጎዳይ ባ ግታ ሱን ግሾ ባ አሳ አገና፤ እ ህንተና ባ አሰ ኦናዉ ኡፋይቴስ። <verse eid="1SA 12:22"/><verse number="23" style="v" sid="1SA 12:23"/>ህንተ ግሾ ዎሳ አጋዳ ጎዳ ቆሆይ ታፐ ሃኮ፤ ታኒ ህንተና ሎኦነ ሱረ ኦግያ ታማርሳና። <verse eid="1SA 12:23"/><verse number="24" style="v" sid="1SA 12:24"/>ጎዳ ያይተ፤ ህንተ ኩመ ዎዛናን አማነትድ፥ እያዉ ኪተትተ፤ ህንተዉ እ ኦዳ ግታባ ሀሳይተ። <verse eid="1SA 12:24"/><verse number="25" style="v" sid="1SA 12:25"/>ሽን ህንተ ዛር ዛር ናጋራ ኦኮ፥ ህንተነ ህንተ ካዎይ ያና” ያግስ።<verse eid="1SA 12:25"/></para>
  <chapter eid="1SA 12"/>
  <chapter number="13" style="c" sid="1SA 13"/>
  <para style="s1">ሳሜል ሳኦላ ሀንቀትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 13:1"/>ሳኦል ካዎትያ ዎደ እያዉ ላይ ሀስታማ፤ እ እስራኤለ ቦላ ናምኡ ላይ ካዎትዳፐ ጉየ፥ <verse eid="1SA 13:1"/><verse number="2" style="v" sid="1SA 13:2"/>እስራኤለታ ግዶፈ ሄ ሙኩሉ አስ ዶርስ። ኤንታፈ ናምኡ ሙኩሉ አሳይ ምክማሳንነ ደረይ ዳርያ ቤተለ ቢታን ሳኦላራ ደኤስ። እስ ሙኩሉ አሳይ ቃስ ብንያመን ደእያ ግብአን ዮናታናራ ደኤስ፤ አትዳ አሳ ሳኦል ኤንታ ሶ ሶ የድስ።<verse eid="1SA 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 13:3"/>ዮናታን ግብአን<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="ft" closed="false">ጋባኦናን</char></note> ደእያ ፍልስፄመ ኦላንቾታ ኦልስ፤ ፍልስፄመ አሳይ ሄሳ ስእዶሶና። ሄሳፈ ጉየ፥ ሳኦል፥ “እብራወት ሀይሳ ስኦ” ግድ ቢታ ኡባን ሞይዘ ፑንስስ። <verse eid="1SA 13:3"/><verse number="4" style="v" sid="1SA 13:4"/>ሳኦል ፍልስፄመ አሳ ኦልድ ፆንዳይሳ እስራኤለ አሳይ ስእዶሶና፤ እስራኤለ አሳይ ፍልስፄመ አሳ ማታን እፀትዳይሳታ ግደይሳ ኤርዶሶና። እስራኤለ አሳይ ሳኦላ ካላናዉ ፄገትድ ጋልጋላን ሺቅዶሶና።<verse eid="1SA 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 13:5"/>ፍልስፄመ አሳይ እስራኤለ አሳ ኦላናዉ ሄ ሙኩሉ ፓራ ጋረታራ፥ ኡሱፑን ሙኩሉ ፓራ አሳታራነ አባ ዶናን ደእያ ሻፈዳ ዳርዳ ኦላንቾታራ ሺቅዶሶና። ኤንቲ ብድ፥ ቤት-አዌናፐ ዶሎሀ ባጋራ ደእያ ምክማሳን ዙግድ ኡትዶሶና። <verse eid="1SA 13:5"/><verse number="6" style="v" sid="1SA 13:6"/>እስራኤለ አሳይ ሳእ ኤንታዉ ኢታ ግደይሳነ ኦላንቾት ዳጋምዳይሳ በእዳ ዎደ ጎንጎሎን፥ ቡረን፥ ዛላ ግዶን፥ ካካን፥ ሃ ኦላን ቆሰትዶሶና። <verse eid="1SA 13:6"/><verse number="7" style="v" sid="1SA 13:7"/>እብራወታፐ ጉት ዮርዳኖሰ ሻፋ ፕንድ፥ ጋደነ ጋላዳ ቢታ ብዶሶና። ሽን ሳኦል ጋልጋላን አትስ፤ እያራ ደእያ ኦላንቾት ኡባይ ያሻን ኮኮርዶሶና።<verse eid="1SA 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 13:8"/>ሳኦል ሳሜል ኬርዳ ላፑን ጋላስ ጋካናዉ ጋምእስ፤ ሽን ሳሜል ጋልጋላ ይቤና፤ ያትን፥ ሳኦላራ ደእያ ኦላንቾት ላለተ ዶምዶሶና። <verse eid="1SA 13:8"/><verse number="9" style="v" sid="1SA 13:9"/>ሄሳ ግሾ፥ ሳኦል፥ “ፁሳ ያርሾነ እስፈተ ያርሾታ ታዉ ኤህተ” ያግድ፥ ፁሳ ያርሾ ያርሽስ። <verse eid="1SA 13:9"/><verse number="10" style="v" sid="1SA 13:10"/>ሳኦል ፁሳ ያርሹዋ ያርሽድ ፖልዳፐ ጉየ ሳሜል ይስ። ያትን፥ ሳኦል ሳሜላ ሞካናዉ ካረ ከይስ።<verse eid="1SA 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 13:11"/>ሳሜል፥ “ሀ ኔኒ ኦዳባይ አይቤ?” ያግድ ሳኦላ ኦይችስ።</para>
  <para style="p" vid="1SA 13:11">ሳኦል፥ “አሳይ ላለታናዉ ማትዳይሳ፥ ነካ ግዳ ዎድያን ያናዉ ጋምእዳይሳነ ፍልስፄመት ምክማሳን ሺቅዳይሳ ታኒ በአስ። <verse eid="1SA 13:11"/><verse number="12" style="v" sid="1SA 13:12"/>ሄሳ ግሾ፥ ‘ፍልስፄመት ታራ ኦለታናዉ ጋልጋላ ዎና ሀኖሶና፤ ታኒ ጎዳ ማዶ ኦይቻብከ’ ጋዳ ቆፓስ። ያትን፥ ፁሳ ያርሾ ያርሻናይስ ታዉ አቶናባ ግድስ” ያግድ ዛርስ።<verse eid="1SA 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 13:13"/>ሳሜል፥ “ኔኒ ቦዛባ ኦዳሳ፤ ጎዳይ፥ ነ ፆሳይ ነዉ እምዳ ኪታ ናጋባካ። ኔኒ ናግዳኮ ጎዳይ ሀች ነ ካዎተ እስራኤለ ቦላ መርናዉ ምንናሽን። <verse eid="1SA 13:13"/><verse number="14" style="v" sid="1SA 13:14"/>ሽን ሀእ ነ ካዎተይ ጋምኤና፤ ኔኒ ጎዳ ኪታ ናጋቦና ግሾ፥ ጎዳይ ባ ዎዛናዳ ኦያ አስ ደምስ፤ ባ አሳ ካለና መላ እያ ዶርስ” ያግስ።<verse eid="1SA 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 13:15"/>ሳሜል ጋልጋላፐ ደንድድ፥ ብንያመን ደእያ ግብአ ብስ። ሳኦል ባራ ደእያ አሳ ታይብን፥ አሳይ ኡሱፑን ፄቱ ግድስ። <verse eid="1SA 13:15"/><verse number="16" style="v" sid="1SA 13:16"/>ሳኦል፥ እያ ናኣ ዮናታንነ ኤንታራ ደእያ አሳይ ብንያመን ደእያ ግብአን ጋምእዶሶና፤ ፍልስፄመ አሳይ ምክማሳን ዱንካንዶሶና። <verse eid="1SA 13:16"/><verse number="17" style="v" sid="1SA 13:17"/>ፍልስፄመ ኦላንቾት ሄ ጩጋን ሻከትድ ከይዶሶና። ኤንታፈ እስ ጩጋይ ሹኣላ ቢታን ደእያ ኦፍራኮ ስሚድ ብስ፤ <verse eid="1SA 13:17"/><verse number="18" style="v" sid="1SA 13:18"/>ናምአንይ ቤት-ሆሮናኮ ብስ፤ ሄን ጩጋይ መላ ቢታ ስንን ደእያ ሳቦይማ ዛንጋራ ዱገ ፄልያ ዛዋ ኦግያ ኦይክድ ብስ።<verse eid="1SA 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 13:19"/>ፍልስፄመ አሳይ፥ “እብራወት ማሸነ ቶራ ቆፆፎ” ግዳ ግሾ፥ እስራኤለ ቢታን ብራታ ቆፅያ አስ ባዋ። <verse eid="1SA 13:19"/><verse number="20" style="v" sid="1SA 13:20"/>ሄሳ ግሾ፥ እስራኤለ አሳይ ባንታ ማራሻ፥ ኮንተ፥ ካልታነ ባጫ ፖሽሳናዉ ፍልስፄመ ቦሶና። <verse eid="1SA 13:20"/><verse number="21" style="v" sid="1SA 13:21"/>ማራሻነ ኮንተ ፖሽሳናዉ ሆስፑን ግራመ ዴፅያ ብራ ቃንፆሶና፤ ካልታነ ፆፀ ፖሽሳናዉ ኦይዱ ግራመ ቃንፆሶና። <verse eid="1SA 13:21"/><verse number="22" style="v" sid="1SA 13:22"/>ሄሳ ግሾ፥ ኦላ ጋላስ ሳኦልነ እያ ናኣ ዮናታን አትሽን፥ ሀራታ ኩሸን ቶርነ ማሽ ባዋ። <verse eid="1SA 13:22"/><verse number="23" style="v" sid="1SA 13:23"/>ፍልስፄመ ጩጋይ ምክማሳ ፕን ባናዉ ከይስ።<verse eid="1SA 13:23"/></para>
  <chapter eid="1SA 13"/>
  <chapter number="14" style="c" sid="1SA 14"/>
  <para style="s1">ዮናታን ፍልስፄመታ ኦልስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 14:1"/>እስ ጋላስ ሳኦላ ናአይ ዮናታን ባ ኦላ ሚሽያ ቶክያ ፓንኮ ሀይሳዳ ያግስ፤ “ሃያ፤ ሄፍንን ደእያ ፍልስፄመት ዱንካንዳ ጉታ አነ ቦስ” ያግስ። ሽን ባ አዋስ ሄሳ ኦድቤና።<verse eid="1SA 14:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 14:2"/>ሄ ዎደ ሳኦል ግብአ ማታን ምግሮናን፥ ኦሮማነ ም ጋርሳን ደኤስ። እያራ ኡሱፑን ፄቱ አሳት ደኦሶና። <verse eid="1SA 14:2"/><verse number="3" style="v" sid="1SA 14:3"/>ሴሎን ጎዳ ካህነ ግድዳ ኤል ናአይ፥ ካህነይ ፍንሃስ የልዳ እካቦዳ እሻይ፥ አክፁባ ናአይ፥ አክይ ኤፉደ ማእድ፥ ኤንታ ግዶን ደኤስ። ዮናታን ኤንታ ግዶን ባይናይሳ ኦንካ ኤርቤና።<verse eid="1SA 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 14:4"/>ዮናታን ፍልስፄመት ዱንካንዳ ጉታ ፕናናዉ ብያ ኦግያ ቦላ ኡሻቻ ባጋንነ ሀድርሳ ባጋን፥ እሶይ ቦፀፃ፥ ሀንኮይ ሳና ጌተትያ ናምኡ ፖፀትዳ ግታ ዛላት ደኦሶና። <verse eid="1SA 14:4"/><verse number="5" style="v" sid="1SA 14:5"/>ዛላታፐ እሶይ ፑደሀ ባጋን ምክማሳ ስንን ደእያ ዎደ፥ እሶይ ቃስ ዱገሀ ባጋን ግብአ ስንን ደኤስ።<verse eid="1SA 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 14:6"/>ዮናታን ባ ኦላ ሚሽያ ቶክያ ፓንኮ፥ “ሃያ፤ ሀ ቃፃረትቦና አሳይ ዱንካንዳ ጉታ አነ ቦስ። ጎዳይ ኑ ግሾ ኦለቶና አገና፤ ዳሮ አሳን ግድን ጉ አሳን፥ አሻናይስ ጎዳ ፆነና” ያግስ።<verse eid="1SA 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 14:7"/>እያ ኦላ ሚሽያ ቶከይስ፥ “ኔኒ ቆፕዳባ ኡባ ኦ፤ ጉየ ጎፓ፤ ታ ዎዛናይ ኔራ ደኤስ” ያግስ።<verse eid="1SA 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 14:8"/>ዮናታን፥ “ያኮ ሃያ፤ ሄፍን ፕንድ አሳስ በንቶስ። <verse eid="1SA 14:8"/><verse number="9" style="v" sid="1SA 14:9"/>ኤንቲ፥ ‘ኑኒ ህንተኮ ያና ጋካናዉ ያን ናግተ’ ጊኮ፥ ኑኒ ደእያ በሳን ናጋናፐ አትሽን፥ ኤንታኮ ቦኮ። <verse eid="1SA 14:9"/><verse number="10" style="v" sid="1SA 14:10"/>ሽን ኤንቲ፥ ‘ኑኮ ሃ ዪተ’ ጊኮ፥ ኑኒ ኤንታኮ ከያና። ሄስ ጎዳይ ኤንታ ኑ ኩሸን አድ እምዳይሳስ ማላ ግዳና” ያግስ።<verse eid="1SA 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 14:11"/>ኤንቲ ናምአይ ከይድ ፍልስፄመታስ በንትዳ ዎደ ፍልስፄመት፥ “ሄኮ፥ እብራወት ባንታ ቆሰትዳ ኦላፈ ዙምድ ከዮሶና” ያግዶሶና። <verse eid="1SA 14:11"/><verse number="12" style="v" sid="1SA 14:12"/>ፍልስፄመ ኦላንቾት፥ ዮናታናነ ኦላ ሚሽያ ቶከይሳ ፄግድ፥ “ሃ ኑኮ ከይተ፤ ኑኒ ህንተና እስባ በሳና” ያግዶሶና።</para>
  <para style="p" vid="1SA 14:12">ሄሳ ግሾ፥ ዮናታን ባ ኦላ ሚሽያ ቶከይሳኮ፥ “ታና ካላዳ ሀ ከያ። ጎዳይ ኤንታ እስራኤለ ኩሸን አድ እሚስ” ያግስ።<verse eid="1SA 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 14:13"/>ዮናታን ባ ኦላ ሚሽያ ቶከይሳ ካለድ፥ ቶሆንነ ኩሸን ዙምድ ከይስ። ፍልስፄመታ ዮናታን ሾጭድ የግን፥ እያ ኦላ ሚሽያ ቶከይስ ካልድ ኤንታ ዎስ። <verse eid="1SA 14:13"/><verse number="14" style="v" sid="1SA 14:14"/>ሄ ኮይሮ ኦላን ዮናታንነ እያ ኦላ ሚሽያ ቶከይስ ባጋ ቦራ ሶ ጋደን ላታሙ ግድያ አስ ዎዶሶና። <verse eid="1SA 14:14"/><verse number="15" style="v" sid="1SA 14:15"/>ሄሳፈ ጉየ፥ ጉታንንን ጎሻን፥ ኦላስ ከይዳ አሳትነ ናጎን ደእያ ፍልስፄመት ዳጋምዶሶና። ቢት ቃፅስ፤ ሄ ዳጋማይ ፆሳፈ ኪተትስ።<verse eid="1SA 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 14:16"/>ሳኦል ብንያመ ቢታን፥ ግብአን ዎዳ ዎችያ አሳት፥ ፍልስፄመ ኦላንቾት ያራ ሃራ ፕስክ ግድ ላለተይሳ በእዶሶና። <verse eid="1SA 14:16"/><verse number="17" style="v" sid="1SA 14:17"/>ያትን፥ ሳኦል ባራ ደእያ አሳኮ፥ “አነ ኦላንቾታ ሺሽድ ኑ ግዶፈ ኦን ብዳኮ በእተ” ያግስ። ኤንቲ ሺሽድ ታይብያ ዎደ ዮናታንነ እያ ኦላ ሚሽያ ቶከይስ ባይናይሳ በእዶሶና።<verse eid="1SA 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 14:18"/>ሳኦል ካህንያ አክያ፥ “ፆሳ ታቦትያ ሃ ኤካዳ ያ” ያግስ። ሄ ዎደ ታቦተይ እስራኤለራ ደኤስ<note caller="+" style="f"><char style="fr" closed="false">14:18 </char><char style="ft" closed="false">“ኤፉድያ ሃ ኤካዳ ያ” ያግስ። ሄ ዎደ አክይ ኤፉደ ማእድ እስራኤለ አሳ ስንን ደኤስ</char></note> <verse eid="1SA 14:18"/><verse number="19" style="v" sid="1SA 14:19"/>ሳኦል ካህንያራ ሃሳይሽን፥ ፍልስፄመት ዱንካንዳ ጉታን ዎጫማይ ዳር ዳር ብስ። ሄሳ ግሾ፥ ሳኦል ካህንያ፥ “ታቦትያፐ ነ ኩሽያ ከሳ” ያግስ።<verse eid="1SA 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 14:20"/>ሄሳፈ ጉየ፥ ሳኦልነ እያ ኦላንቾት ሺቅድ ኦላ ብዶሶና። ፍልስፄመ አሳ ኡባይ ሀናና ባ ይድ፥ ባንታ ማሻን እሶይ እሱዋ ቡዶሶና። <verse eid="1SA 14:20"/><verse number="21" style="v" sid="1SA 14:21"/>ካሰ ፍልስፄመ አሳራ ዎላ ኦላ በሳ ብዳ እብራወት ኤንታ አግድ፥ ሳኦላራነ ዮናታናራ ደእያ እስራኤለ አሳራ ዋላከትዶሶና። <verse eid="1SA 14:21"/><verse number="22" style="v" sid="1SA 14:22"/>ደረይ ዳርያ ኤፍሬማ ቢታን ቆሰትዳ ሀራ እስራኤለትካ ፍልስፄመት ባቃተይሳ ስእዶሶና። ኤንትካ እስራኤለታራ ዋላከትድ የደ ኦይክዶሶና። <verse eid="1SA 14:22"/><verse number="23" style="v" sid="1SA 14:23"/>ጎዳይ ሄ ጋላስ እስራኤለ አሳ አሽስ። ቤት-አዌናፐ ሄፍን ጋካናዉ ኦላይ ካንስ።<verse eid="1SA 14:23"/></para>
  <para style="s1">ዮናታና ኤሳ ሙሳ</para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 14:24"/>ሄ ጋላስ እስራኤለ አሳይ ኮሻን ላባንዶሶና። ሳኦል፥ “ሳእ ቃማናፐ ስን ታኒ ታ ሞርከታ ሀሎ ከዮና ደእሽን፥ ካ ምያ ኦንካ ባደትዳይሳ ግዶ” ያግድ አሳ ጫቅስድ ዎስ። ሄሳ ግሾ፥ ኦላንቾታፐ ካ ዶናኮ ሺሽዳ አስ ኦንካ ባዋ።<verse eid="1SA 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 14:25"/>ኦላንቾት ኡባይ ዎራ ግዶ ገልያ ዎደ ም ቦላ ኤስ ደኤስ። <verse eid="1SA 14:25"/><verse number="26" style="v" sid="1SA 14:26"/>ኤንቲ ዎራ ግዶን ኤስ ፆከይሳ በእዶሶና፤ ሽን ጫቁዋ ያይዳ ግሾ፥ እስ አስካ ባ ኩሽያ ዶናኮ ሺሽበና። <verse eid="1SA 14:26"/><verse number="27" style="v" sid="1SA 14:27"/>ሽን ዮናታን እያ አዋይ አሳራ ኦዳ ቃችዳይሳ ስእቤና። ሄሳ ግሾ፥ ባ ኩሸን ደእያ ፃምአ ፄራ እልሎ ኤሳን የድ ከስድ፥ ላጭን እያ አይፈይ ፄልስ። <verse eid="1SA 14:27"/><verse number="28" style="v" sid="1SA 14:28"/>ሄሳፈ ጉየ፥ ኦላንቾታፐ እሶይ፥ “ነ አዋይ ኦላንቾታ ኡባ፥ ‘ሀች ካ ምያ አስ ባደትዳይሳ ግዶ’ ያግድ፥ ጫቅስድ ዎስ፤ አሳ ኡባይ ላባንዳይ ሄሳሳ” ያግስ።<verse eid="1SA 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1SA 14:29"/>ዮናታን፥ “ታ አዋይ ቢታስ መቶ መስ። ታኒ ሀ ኤሳፈ ጉራ ላጭዳ አይ መላ ምንዳኮ በአ። <verse eid="1SA 14:29"/><verse number="30" style="v" sid="1SA 14:30"/>አሳይ ባ ሞርከታፐ ድእዳ ካፈ ሀች ምዳባ ግድያኮ ሎኦሽን፤ ኤንቲ ዎና ፍልስፄመታ ታይቦይካ አይ መላ ዳራነሽን” ያግስ።<verse eid="1SA 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1SA 14:31"/>ሄ ጋላስ እስራኤለ አሳይ ምክማሳፐ ኤሎና ጋካናዉ ፍልስፄመታ ሾጭ ስሚድ ዳቡርዶሶና። <verse eid="1SA 14:31"/><verse number="32" style="v" sid="1SA 14:32"/>ኤንቲ ድእዳ ዶርሳታ፥ ሚዛታነ ማራታ ሹክድ ሱ ጉሶና ምዶሶና። <verse eid="1SA 14:32"/><verse number="33" style="v" sid="1SA 14:33"/>እስ አስ ሳኦላኮ፥ “ሄኮ፥ አሳይ ሱራ ደእያ አሾ ምድ፥ ጎዳ ስንን ናጋራ ኦሶና” ያግስ።</para>
  <para style="p" vid="1SA 14:33">ሳኦል፥ “ህንተ ናጋራ ኦደታ፤ ግታ ሹቹ ጎንዶርስድ ኤለ ታኮ ሃ ሺሽተ” ያግስ። <verse eid="1SA 14:33"/><verse number="34" style="v" sid="1SA 14:34"/>ሄሳፈ ጉየ፥ “አሳ ግዶ ብድ፥ ‘ህንተ እሶይ እሶይ ህንተ መሄታነ ዶርሳታ ታኮ ሃ ኤህተ፤ ሀይሳን ዎጋዳ ሹክድ ሚተ። ሱራ ደእያ አሾ ምድ፥ ጎዳ ስንን ናጋራ ኦፕተ’ ያጋ” ያግስ።</para>
  <para style="p" vid="1SA 14:34">ሄሳ ግሾ፥ ሄ ቃማ እሶይ እሶይ ባ ቦራ ኤህድ ያን ሹክዶሶና። <verse eid="1SA 14:34"/><verse number="35" style="v" sid="1SA 14:35"/>ሳኦል ሄ በሳን ጎዳስ ያርሾ በሲ ግምብስ፤ ጎዳስ ያርሾ በሲ ግምብሽን ሀይስ እያዉ ኮይሮ።<verse eid="1SA 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1SA 14:36"/>ሳኦል፥ “ሀች ቃማ ፍልስፄመታ ካል፥ ብድ ሳእ ዎንታና ጋካናዉ ኤንታባ ኡባ ቦንቆስ፤ ኤንታፈ እሱዋካ አሾና ዎኦስ” ያግስ።</para>
  <para style="p" vid="1SA 14:36">ኤንቲ፥ “ኤሮ፥ ነና ሎእዳባ ኦ” ያግድ ዛርዶሶና።</para>
  <para style="p" vid="1SA 14:36">ሽን ካህነይ፥ “አነ ፆሳ ሸነይ አይበኮ ኦይቾስ” ያግስ።<verse eid="1SA 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1SA 14:37"/>ሄሳ ግሾ፥ ሳኦል፥ “ፍልስፄመ አሳ ካላዳ ቦ? ኔኒ ኤንታ እስራኤለ ኩሸን አዳ እማኔ?” ያግድ ፆሳ ኦይችስ። ሽን ሄ ጋላስ ፆሳይ እያዉ ዛሮ እምቤና።<verse eid="1SA 14:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1SA 14:38"/>ሳኦል፥ “ካለይሳታ ፄግድ፥ ኡባይ ሃይተ፤ ሀች አይባ ናጋር ኦሰትዳኮ አነ ቆርድ ደሞስ። <verse eid="1SA 14:38"/><verse number="39" style="v" sid="1SA 14:39"/>እስራኤለ አሽያ ደኦ ጎዳይ ኤርያ መላ። ታ ናአ ዮናታና ግድኮካ፥ ሀይቃናዉ በሴስ” ያግስ። ሽን አሳፐ እስ አስካ ዶና ፖግቤና።<verse eid="1SA 14:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1SA 14:40"/>ሄሳፈ ጉየ፥ ሳኦል እስራኤለ አሳኮ፥ “ህንተ ኡባይ ያ ባጋን ኤቅተ፤ ታንነ ታ ናኣ ዮናታን ሀ ባጋን ኤቃና” ያግስ።</para>
  <para style="p" vid="1SA 14:40">አሳይ፥ “ኤሮ፥ ነና ሎእዳባ ኦ” ያግዶሶና።<verse eid="1SA 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 14:41"/>ሄሳፈ ጉየ፥ ሳኦል፥ “ታዉ ልከ ዛሮ እማ” ያግድ ጎዳ እስራኤለ ፆሳ ዎስስ። ሳማይ ሳኦላ ቦላነ ዮናታና ቦላ ዎን አሳይ ጌይስ። <verse eid="1SA 14:41"/><verse number="42" style="v" sid="1SA 14:42"/>ቃስ ሳኦል፥ “ታ ቦላነ ታ ናኣ ዮናታና ቦላ ሳማ የግተ” ያግስ። ሳማይ ዮናታና ቦላ ዎስ።<verse eid="1SA 14:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1SA 14:43"/>ሳኦል ዮናታና፥ “አነ ኔኒ ኦዳባ ኦዳ” ያግስ።</para>
  <para style="p" vid="1SA 14:43">ዮናታን፥ “ታኒ ጉ ኤሳ እልሎ ታ ፃምኣ ፄራን ቦቻዳ ላጫስ። ሄኮ ታኒ ሀይሳን ደአይስ፤ ሀይቆስ ጊገታስ” ያግስ።<verse eid="1SA 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="1SA 14:44"/>ሳኦል፥ “ዮናታና፥ ኔኒ ሀይቆና እፅኮ፥ ፆሲ ታና ፕርዶ” ያግስ።<verse eid="1SA 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1SA 14:45"/>ሽን አሳይ ሳኦላኮ፥ “ዮናታን፥ እስራኤለስ ሄሳ መላ ግታ ፆኑዋ ኤህዳይስ ሀይቃኔ? ሄስ ፖሎ ሀነና! ደኦ ፆሲ ኤርያ መላ! እያ ሁጵያፐ እስ ብናንካ ቢታን ዎና። እ ሀች ሀይሳ ፆሳ ማዶን ኦስ” ያግዶሶና። ያትድ አሳይ ዮናታና አሽን፥ እ ሀይቆፐ አትስ።<verse eid="1SA 14:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="1SA 14:46"/>ሄሳፈ ጉየ፥ ሳኦል ፍልስፄመ አሳ የደይሳ አግን ኤንቲ ባንታ ቢታ ስምዶሶና።<verse eid="1SA 14:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="1SA 14:47"/>ሳኦል እስራኤለ ቦላ ካዎትዳፐ ጉየ፥ ኡባ ባጋራ ደእያ ባ ሞርከታ ኦልስ። ሄሳትካ፥ ሞአበታ፥ አሞነታ፥ ኤዶመታ፥ ሱባ ካዎታነ ፍልስፄመታ። ኦላናዉ ብዳ በሳ ኡባን ፆንስ። <verse eid="1SA 14:47"/><verse number="48" style="v" sid="1SA 14:48"/>እ ምንድ ኦለትስ፤ አማለቃታ ፆንስ፤ እስራኤለ አሳ ቦንቀይሳታ ኩሸፐ አሽስ።<verse eid="1SA 14:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="1SA 14:49"/>ሳኦላ አደ ናይት ዮናታና፥ የሱዋነ ማልክሳ፤ እያዉ ባይራ ናኤ ሱንይ መራቦ፤ ካሎ ናኤ ሱንይ መልኮሎ። <verse eid="1SA 14:49"/><verse number="50" style="v" sid="1SA 14:50"/>እያ ማችያ፥ አክማሳ ናእያ አክናሆሞ። እያ ቶራ ሞጮናይ እያ አዋ እሻ ኔራ ናኣ አበኔራ። <verse eid="1SA 14:50"/><verse number="51" style="v" sid="1SA 14:51"/>ሳኦላ አዋ ቂስነ አበኔራ አዋ ኔር አብኤላ ናይታ።<verse eid="1SA 14:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="1SA 14:52"/>ሳኦል ደእዳ ላይ ኡባን ፍልስፄመታራ ሞርከተን ኦለትዳ መላ ደእስ። ምኖ አስ ዎይኮ ፃላ አስ ደምዳ ዎደ ኡባን እ ሄ ኡራ ባ ኦላንቾታን ጉጄስ።<verse eid="1SA 14:52"/></para>
  <chapter eid="1SA 14"/>
  <chapter number="15" style="c" sid="1SA 15"/>
  <para style="s1">ሳኦል ቦረትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 15:1"/>ሳሜል ሳኦላኮ፥ “ባ አሳ እስራኤለ ቦላ ኔኒ ካዎታናዳ ትያና መላ ጎዳይ ኪትዳይ ታና። ሄሳ ግሾ፥ ጎዳ ቃላ ስአ። <verse eid="1SA 15:1"/><verse number="2" style="v" sid="1SA 15:2"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፤ ‘እስራኤለት ግብፀፈ ከይድ ያ ዎደ አማለቃት ኦገን ኤንታራ ኤቀትዳ<note caller="-" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="EXO 17:8-14">ከሳ 17:8-14</ref>፤ <ref loc="DEU 25:17-19">ዛረ 25:17-19</ref>.</char></note> ግሾ ታኒ አማለቃታ ሴራና። <verse eid="1SA 15:2"/><verse number="3" style="v" sid="1SA 15:3"/>ሀእ ባዳ አማለቃታ ሾጫ፤ ኤንታዉ ደእያባ ኡባ ፖሎ ይሳ። ኤንታ አሾፋ፤ ማጫነ አደ፥ ናይታነ ዮጋ ናይታ፥ ሚዝነ ዶርሰ፥ ግማለነ ሀረ ኡባ ዎ’ ” ያግስ።<verse eid="1SA 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 15:4"/>ሳኦል አሳ ፄግድ፥ ፀላመ ጌተትያ በሳን ታይብስ። ታይብያ ዎደ እስራኤለፐ ናምኡ ፄቱ ሙኩሉ ቶሆ ኦላንቾታ፤ ይሁዳፐ ታሙ ሙኩሉ አስ ደምስ። <verse eid="1SA 15:4"/><verse number="5" style="v" sid="1SA 15:5"/>ሳኦል አማለቃታ ካታማ ብድ እስ ሻፋን ቆሰትድ ኡትስ። <verse eid="1SA 15:5"/><verse number="6" style="v" sid="1SA 15:6"/>ሳኦል፥ “እስራኤለት ግብፀፈ ከይያ ዎደ ህንተ ኤንታዉ ኬህዳ ግሾ ታኒ ህንተና አማለቃታራ እስፈ ይሶና መላ ደንድድ ኤንታ ግዶፈ ከይተ” ያግድ ቄና አሳስ ኦድስ። ያትን ቄና አሳይ አማለቃታ ግዶፈ ከይድ ብዶሶና።<verse eid="1SA 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 15:7"/>ሳኦል አማለቃታ ሀውላፐ ዶምድ፥ ግብፀፈ ዶሎሀ ባጋን ደእያ ሹራ ጋካናዉ ሾጭስ። <verse eid="1SA 15:7"/><verse number="8" style="v" sid="1SA 15:8"/>አማለቃታ ካዋ አጋጋ ፓፃ ድእስ፤ እያ አሳ ኡባ ማሻን ዎድ ዉርስስ። <verse eid="1SA 15:8"/><verse number="9" style="v" sid="1SA 15:9"/>ሽን ሳኦልነ እያ ኦላንቾት፥ አጋጋነ ሎኦ ዶርሳታ፥ ሚዛታ፥ አንቃራ ማራታነ ማራዘታ፥ ሄሳዳካ ሀራ ሎኦባታ ኡባ አሽዶሶና። ኤንቲ ሀይሳታ ፖሎ ዎናዉ ኮይቦኮና፤ ሽን ኤንቲ ላፋታነ ፓናይሳታ ይስዶሶና።<verse eid="1SA 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 15:10"/>ጎዳይ ሳሜላኮ፥ <verse eid="1SA 15:10"/><verse number="11" style="v" sid="1SA 15:11"/>“ሳኦል ታና ካለይሳ አግድ፥ ታ ኪታ ናግቦና ግሾ፥ ታኒ ሳኦላ ካዎዳይሳን ቂሮታስ” ያግስ። ሳሜል ሄሳ ስእዳ ዎደ ኡንኤትድ ቃማ ኩመ ጎዳኮ ዋስስ።<verse eid="1SA 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 15:12"/>ሳሜል ዎንታ ጉራ ደንድድ፥ ሳኦላራ ጋሄታናዉ ብስ። ሽን አሳይ፥ “ሳኦል ቃርመሎሳ ካታማ ብድ፥ ያን ባና ሀሳይስያ ሀዉልተ ኤስዳፐ ጉየ፥ ጋልጋላ ዎስ” ያግድ ኦድዶሶና።<verse eid="1SA 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 15:13"/>ሳሜል ሳኦላ ደምዳ ዎደ ሳኦል ሳሜላኮ፥ “ጎዳይ ነና አንጆ፤ ታኒ ጎዳ ኪታ ፖላስ” ያግስ።<verse eid="1SA 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 15:14"/>ሽን ሳሜል ሳኦላኮ፥ “ያትን፥ ሀ ታኒ ስእያ ዶርሳ ዋሶይነ መሄ ዋሶይ አይቤ?” ያግስ።<verse eid="1SA 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 15:15"/>ሳኦል፥ “ኦላንቾት ሀይሳታ አማለቃታፐ ኤህዶሶና፤ ኤንቲ ጎዳስ፥ ነ ፆሳስ ያርሻናዉ፥ ኡባፈ ሎእያ ዶርሳታነ መሄታ አሽዶሶና፥ ሽን ሀራታ ኡባ ይስዳ” ያግስ።<verse eid="1SA 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 15:16"/>ሳሜል፥ “አነ አጋጋ፤ ጎዳይ ዝነ ቃማ ታዉ ኦድዳባ ታ ነዉ ኦዳና” ያግስ።</para>
  <para style="p" vid="1SA 15:16">ሳኦል፥ “ኤሮ ኦዳ” ያግስ።<verse eid="1SA 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 15:17"/>ሳሜል ዛሪድ፥ “ነ አይፈ ስንን ነ ጉ ግድኮካ፥ እስራኤለ ዘረስ ካዎ ግዳብኪ? እስራኤለ ቦላ ካዎታና መላ ጎዳይ ነና ትይስ። <verse eid="1SA 15:17"/><verse number="18" style="v" sid="1SA 15:18"/>ጎዳይ፥ ‘ኔኒ ባዳ ኢታ ግድዳ አማለቃታ ኩመ ይሳ፤ ኤንቲ ዉራና ጋካናዉ ዎ’ ያግድ ኪትስ። <verse eid="1SA 15:18"/><verse number="19" style="v" sid="1SA 15:19"/>ያትን፥ አይስ ጎዳስ ኪተታብኪ? ድኦስ ያረታዳ ጎዳ ስንን አይስ ኢታባ ኦዲ?” ያግስ።<verse eid="1SA 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 15:20"/>ሳኦል፥ “ታኒ ጎዳስ ኪተታስ፤ እ ታና ኪትዳይሳዳ ባዳ አማለቃታ ዎ ዉርሳስ፤ ኤንታ ካዋ አጋጋ ኤሀስ። <verse eid="1SA 15:20"/><verse number="21" style="v" sid="1SA 15:21"/>ሽን ኦላንቾት ድኡዋፐ ሎእያ ዶርሰነ መህያ ጎዳስ፥ ነ ፆሳስ፥ ጋልጋላን ያርሻናዉ ኤህዶሶና” ያግስ።<verse eid="1SA 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 15:22"/>ሳሜል፥ “ጎዳይ ባ ቃላስ ኪተተይሳን ኡፋይተይሳ መላ ፁሳ ያርሾንነ ሀራ ያርሾን ኡፋይቲ? ሄኮ፥ ኪተተ ያርሾፈ አስ፤ እያ ስስ ዶርሳ ሞ ያርሸይሳፈ አስ። <verse eid="1SA 15:22"/><verse number="23" style="v" sid="1SA 15:23"/>ጌላተ ማሮ ናጋራ መላ፤ ቃስ ኦቶሮይ ኢታ ኤቃ ጎይኖ መላ። ኔኒ ጎዳ ቃላ እፅዳ ግሾ ጎዳይ ነ ካዎ ግዶና መላ እፅስ” ያግስ።<verse eid="1SA 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 15:24"/>ሳኦል፥ “ታኒ ናጋራ ኦስ፤ ጎዳ ኪታነ ነ ቃላ ቶቻስ። ታኒ አሳስ ያይዳ ግሾ ኤንቲ ግዳባ ኦስ። <verse eid="1SA 15:24"/><verse number="25" style="v" sid="1SA 15:25"/>ሀእ ታ ናጋራ አቶ ጋርክ፤ ታኒ ጎዳ ጎይናና መላ ታራ የርክ” ያግስ።<verse eid="1SA 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 15:26"/>ሳሜል፥ “ታኒ ኔራ ስማዳ ቢከ፤ ኔኒ ጎዳ ቃላ እፅዳ ግሾ ነ እስራኤለ ቦላ ካዎ ግዶና መላ ጎዳይ እፅስ” ያግስ።<verse eid="1SA 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1SA 15:27"/>ሳሜል ባናዉ ደንድን፥ ሳኦል እያ ማኡዋ ማጫራ ኦይክን፥ ማኦይ ዳከትስ። <verse eid="1SA 15:27"/><verse number="28" style="v" sid="1SA 15:28"/>ሳሜል፥ “ጎዳይ ሀች እስራኤለ ካዎተ ኔፐ ዳክድ ኔፐ ሎእያ ሀራ አሳስ እሚስ። <verse eid="1SA 15:28"/><verse number="29" style="v" sid="1SA 15:29"/>እስራኤለ ቦንቾይ፥ ፆሳይ ዎርዶተና ዎይኮ ባ ቆፋ ላመና፤ ባ ቃላ ላማናዉ እ አስ ግደና” ያግስ።<verse eid="1SA 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 15:30"/>ሳኦል፥ “ታኒ ናጋራ ኦስ፤ ሽን ታ ቢታ ጭማታ ስንንነ እስራኤለ አሳ ስንን ታና ቦንቻ። ታኒ ጎዳ፥ ነ ፆሳ ጎይናና መላ ታራ የርክ” ያግድ ዎስስ።<verse eid="1SA 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1SA 15:31"/>ሄሳ ግሾ፥ ሳሜል እያራ እስፈ ብን፥ ሳኦል ጎዳ ጎይንስ።<verse eid="1SA 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 15:32"/>ሳሜል፥ “አማለቃታ ካዋ አጋጋ ታኮ ኤህተ” ያግስ።</para>
  <para style="p" vid="1SA 15:32">አጋግ ኮኮርሸ<note caller="+" style="f"><char style="fr" closed="false">15:32 </char><char style="fq" closed="false">ኮኮርሸ፦ </char><char style="ft" closed="false">ዎይኮ ቃሸትድ</char></note> ሳሜላኮ ይድ፥ “ቱማ ሀይቆይ ሀይሳዳ ጫሚ?” ያግስ።<note caller="+" style="f"><char style="fr" closed="false">15:32 </char><char style="fq" closed="false">ቱማ ሀይቆይ ሀይሳዳ ጫሚ </char><char style="ft" closed="false">ቱማ ታ ሀይቃናዉ በሰና</char></note><verse eid="1SA 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1SA 15:33"/>ሳሜል አጋጋኮ፥ “ነ ማሻይ ማጫሳ ናይታፐ መላ አሽዳይሳዳ ነ አያካ ማጫሳ ግዶን ናይታፐ መላ አታና” ያግስ። ሳሜል አጋጋ ጎዳ ስንን ጋልጋላን ቃንፀረስ።<verse eid="1SA 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1SA 15:34"/>ሳሜል ደንድድ፥ ራማ ብስ፤ ሳኦልካ ባ ሶ ግብአ ብስ። <verse eid="1SA 15:34"/><verse number="35" style="v" sid="1SA 15:35"/>ሳሜል ሀይቃና ጋካናዉ ሳኦላ በአናዉ ስሚድ ብቤና፥ ሽን ሳሜል ሳኦላ ግሾ ዬክስ። ሳኦላ እስራኤለ ቦላ ካዎ ኦዳይሳስ ጎዳይ አዛንስ።<verse eid="1SA 15:35"/></para>
  <chapter eid="1SA 15"/>
  <chapter number="16" style="c" sid="1SA 16"/>
  <para style="s1">ዳዊቲ ካዎተስ ትየትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 16:1"/>ጎዳይ ሳሜላኮ፥ “እስራኤለ ቦላ እ ካዎ ግዶና መላ ታኒ እፅዳ ሳኦላስ ኔኒ አዉደ ጋካናዉ ዬካይ? አነ ካጨን ዛይተ ኩንዳ ቤተለመ አድያ እሰየኮ ባ፤ ካዎ ግዳና መላ ታኒ እያ ናይታ ግዶፈ እሱዋ ዶራ ዎስ” ያግስ።<verse eid="1SA 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 16:2"/>ሳሜል፥ “ታኒ ዋናዳ ቦ? ሳኦል ስእድ ታና ዎና” ያግስ።</para>
  <para style="p" vid="1SA 16:2">ጎዳይ፥ “እስ ኡስ ኤካ ባዳ፥ ‘ታኒ ጎዳስ ያርሻናዉ ያስ’ ያጋ። <verse eid="1SA 16:2"/><verse number="3" style="v" sid="1SA 16:3"/>እሰየካ ያርሾስ ፄጋ። ነ ኦናባ ታ ነና በሳና፤ ታ ነና በሰይሳ ትያ” ያግስ።<verse eid="1SA 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 16:4"/>ሳሜል ጎዳይ ኦድዳይሳ ኦስ፤ ቤተለመ ብድ ካታማ ጭማታራ ጋሄትዳ ዎደ ኤንቲ ኮኮርሸ እያኮ ይድ፥ “ነ ሳሮ ያዲ?” ያግድ ኦይችዶሶና።<verse eid="1SA 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 16:5"/>ሳሜል፥ “ኤ፥ ሳሮ ያስ፤ ታ ጎዳስ ያርሻናዉ ያስ፤ ህንተካ ጌይድ ታራ ያርሾስ የተ” ያግስ። ቃስ እሰየነ እያ ናይታ ጌሽድ ኤንታ ያርሾስ ፄግስ።<verse eid="1SA 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 16:6"/>ኤንቲ ያ ጋክያ ዎደ ሳሜል እሰየ ናኣ ኤልያባ በእድ፥ “ቱማ እያ ስንን ኤቅዳ፥ ጎዳይ ትያ ኡራይ ሀይሳ” ያግድ ቆፕስ።<verse eid="1SA 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 16:7"/>ሽን ጎዳይ ሳሜላ፥ “እያ ማላ ዎይኮ እያ አዱሳተ ፄሎፋ፤ ታኒ እያ ካስ። ታኒ ጎዳይ አስ በኤይሳዳ በእከ፤ አስ ሶምኦ በኤስ፥ ሽን ጎዳይ ዎዛና በኤስ” ያግስ።<verse eid="1SA 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 16:8"/>እሰየይ አብናዳበ ፄግድ፥ ሳሜላ ስን አን፥ ሳሜል፥ “ጎዳይ ሀይሳካ ዶርቤና” ያግስ። <verse eid="1SA 16:8"/><verse number="9" style="v" sid="1SA 16:9"/>እሰየይ ሳማ አን፥ ሳሜል፥ “ጎዳይ ሀይሳካ ዶርቤና” ያግስ። <verse eid="1SA 16:9"/><verse number="10" style="v" sid="1SA 16:10"/>ሄሳዳ ኦድ፥ እሰየይ ባ ናይታ ላፑናታ ሳሜላ ስን አስ፤ ሽን ሳሜል እሰየኮ፥ “ጎዳይ ሀይሳታ ዶርቤና” ያግስ። <verse eid="1SA 16:10"/><verse number="11" style="v" sid="1SA 16:11"/>ሳሜል፥ “ነዉ ደእያ አደ ናይት ሀይሳታ ፃላሌ?” ያግድ እሰየ ኦይችስ።</para>
  <para style="p" vid="1SA 16:11">እሰየይ፥ “ኡባፈ ካሎ ናአይ አትስ፤ ሽን እ ዶርሰ ሄማናዉ ብስ” ያግስ።</para>
  <para style="p" vid="1SA 16:11">ሳሜል፥ “ኪታዳ እያ ኤህሳ፤ እ ያና ጋካናዉ ኑ ማናዉ ኡቶኮ” ያግስ። <verse eid="1SA 16:11"/><verse number="12" style="v" sid="1SA 16:12"/>እሰየይ ኪትድ ናኣ ኤህስስ፤ ሄ ናአይ አርሰ፤ አይፈይ ሎኦነ ማላ ሎኦ ናአ።</para>
  <para style="p" vid="1SA 16:12">ጎዳይ ሳሜላ፥ “ታ ዶርዳይ ሀይሳ ግድያ ግሾ ደንዳ ኤቃዳ ትያ” ያግስ። <verse eid="1SA 16:12"/><verse number="13" style="v" sid="1SA 16:13"/>ሳሜል ካጨን ኩምዳ ዛይተ ኤክድ፥ እያ እሻታ ስንን ዳዊታ ትይስ። ሄ ጋላሳፐ ዶምድ፥ ጎዳ አያናይ ዳዊታ ቦላ ዎልቃን ዎስ። ሄሳፈ ጉየ፥ ሳሜል ደንድድ፥ ራማ ብስ።<verse eid="1SA 16:13"/></para>
  <para style="s1">ዳዊቲ ሳኦላ ጋን</para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 16:14"/>ጎዳ አያናይ ሳኦላፐ ሻከትን ጎዳፐ ኪተትዳ ኢታ አያናይ ሳኦላ ዋይሴስ። <verse eid="1SA 16:14"/><verse number="15" style="v" sid="1SA 16:15"/>ሳኦላ አይለት፥ “ፆሳፈ ኪተትዳ ኢታ አያናይ ነና ዋይሴስ። <verse eid="1SA 16:15"/><verse number="16" style="v" sid="1SA 16:16"/>ኑኒ ዲ ዲፅያ አስ ኮይድ ኤሀና መላ ኑ ጎዳይ ባ አይለታ ኪቶ። ፆሳፈ ኪተትዳ ኢታ አያናይ ነና ኦይክያ ዎደ ሄ ኡራይ ዲ ዲፅኮ ነዉ ሎኦ ግዳና” ያግዶሶና።<verse eid="1SA 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 16:17"/>ሳኦል ባ አይለታ፥ “ዲ ዲፅያ አስ ኮይድ ታዉ ኤህተ” ያግስ።<verse eid="1SA 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 16:18"/>አይለታፐ እሶይ፥ “ቤተለመን እሰየስ ዲ ዲፅያ እስ ናእ ደኤስ። ሄ ናአይ ፃላነ ቶራንቾ። እ ማላ ሎኦነ ጭንጫ፤ ጎዳይ እያራ ደኤስ” ያግስ።<verse eid="1SA 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 16:19"/>ሳኦል እሰየኮ ኪትድ፥ “ዶርሰ ሄምያ ነ ናኣ ዳዊታ ታዉ የዳ” ያግስ። <verse eid="1SA 16:19"/><verse number="20" style="v" sid="1SA 16:20"/>እሰየይ ኡይነ ኦጎሮ ዎይነ ኡሹ ሀረን ጫንድ፥ እስ ኮለ ጎሽስድ ባ ናኣ ዳዊታራ ሳኦላስ የድስ።<verse eid="1SA 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 16:21"/>ዳዊቲ ሳኦላኮ ይድ ኦሶ ዶምስ። ሳኦል ዳዊታ ዳሮ ዶስስ፤ ዳዊቲ ሳኦላስ ኦላ ሚሸ ቶከይሳ ግድስ። <verse eid="1SA 16:21"/><verse number="22" style="v" sid="1SA 16:22"/>ሳኦል፥ “ዳዊቲ ታዉ ኦሸ ታ ማታን ጋምኦ፤ ታኒ እያ ዶሳስ” ያግድ እሰየኮ ኪትስ።<verse eid="1SA 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 16:23"/>ሄሳፈ ስምን፥ ፆሳፈ ኪተትዳ ኢታ አያናይ ሳኦላ ኦይክያ ዎደ ኡባን ዳዊቲ ዲ ኤክድ ዲፄስ። እ ዲፅያ ዎደ ኢታ አያናይ ሳኦላ የዴስነ እያዉ ሎኤስ።<verse eid="1SA 16:23"/></para>
  <chapter eid="1SA 16"/>
  <chapter number="17" style="c" sid="1SA 17"/>
  <para style="s1">ዳዊታነ ጎልያዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 17:1"/>ፍልስፄመት ባንታ ኦላንቾታ ይሁዳን ደእያ ሶኮ ጌተትያ በሳን ኦላስ ሺሽዶሶና። ኤንቲ ሶኮፐነ አዜቃፐ ግዶን ደእያ ኤፌስ-ዳምማ ጌተትያ በሳን ሺቅድ ኡትዶሶና። <verse eid="1SA 17:1"/><verse number="2" style="v" sid="1SA 17:2"/>ሳኦልነ እስራኤለት ኤላ ዛንጋራን ሺቅድ፥ ፍልስፄመታራ ኦለታናዉ ከይዶሶና። <verse eid="1SA 17:2"/><verse number="3" style="v" sid="1SA 17:3"/>ፍልስፄመ ኦላንቾት እስ ባጋ ዙማ ቦላ ሳልፕን፥ እስራኤለት ሀንኮ ባጋ ዙማን ሳልፕዶሶና፤ ዛንጋራይ ኤንታዉ ግዶን ደኤስ።<verse eid="1SA 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 17:4"/>ጋተ ካታማን ደእያ ጎልያዳ ጌተትያ እስ ቶራ ቃራ አደይ ፍልስፄመት ዱንካንዳ ጉታፐ ከይስ፤ እያ ጌሳይ ኡሱፑን ዋነ ታካ። <verse eid="1SA 17:4"/><verse number="5" style="v" sid="1SA 17:5"/>እ እሻታማነ ላፑን ክሎ ግራመ ዴፅያ ናሰ ብራታ ፁሩረ ማእስ፤ ቃስ ናሰ ብራታ ባርኔፃ ባ ሁጰን ዎስ። <verse eid="1SA 17:5"/><verse number="6" style="v" sid="1SA 17:6"/>ናሰ ብራታ ጋምባለ ባ ቶሆን አስ፤ ባ ሀሽያን ናሰ ብራታ ቶራ ቶክስ። <verse eid="1SA 17:6"/><verse number="7" style="v" sid="1SA 17:7"/>እያ ቶራ ቶማይ ዋንዳራሸ መላ ኦርደ፤ እያ ቶራ አይፈይ ላፑን ክሎ ግራመ ዴፄስ፤ እያ ጎንዳልያ ቶክያ እስ አደይ እያ ስንን ሄመቴስ።<verse eid="1SA 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 17:8"/>ጎልያድ ኤቅድ ባ ቃላ ቁ ኦድ፥ “እስራኤለ ኦላንቾታ ቦላ ሀይሳዳ ያግድ ጋይሬስ፤ ህንተ ዋናና ግድ ኦላስ ከይደቲ? ታኒ ፍልስፄመ አስ፤ ህንተ ቃስ ሳኦላ አይለታ ግደከቲ? አነ ህንተ ግዶፈ እስ አስ ዶርተ፤ ሄ አደይ ታኮ ዱገ ዎ። <verse eid="1SA 17:8"/><verse number="9" style="v" sid="1SA 17:9"/>ሄ አደይ ታራ ኦለትድ ታና ዎኮ፥ ኑኒ ህንተ አይለ ግዳና፤ ሽን ታኒ እያ ፆናዳ ዎኮ ህንተ ኑ አይለ ግዳናነ ኑስ ሃረታና” ያግስ። <verse eid="1SA 17:9"/><verse number="10" style="v" sid="1SA 17:10"/>ቃስካ ሄ ፍልስፄመ አደይ፥ “ታኒ ሀች እስራኤለ ኦላንቾታ ማንዳይስ፤ ታዉ እስ አስ እምተ፤ አነ ናምአይ ኦለታና” ያግስ። <verse eid="1SA 17:10"/><verse number="11" style="v" sid="1SA 17:11"/>ሳኦልነ እስራኤለት ፍልስፄመ አድያ ቃላ ስእድ ዳጋምዶሶና፥ ዳሮ ያይዶሶና።<verse eid="1SA 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 17:12"/>ዳዊቲ ይሁዳ ቢታን ቤተለመን ደእያ ኤፍራታ አድያ እሰየ ናአ። እሰየስ ሆስፑን አደ ናይት ደኦሶና፤ ሳኦላ ካዎተ ላይን እሰየይ ዳሮ ላይ ደእዳ ጭማ። <verse eid="1SA 17:12"/><verse number="13" style="v" sid="1SA 17:13"/>እሰየ ሄ ባይራ አደ ናይት ሳኦላ ካልድ ኦላ ብዶሶና። ኤንታ ሱንይ:- ባይራይ ኤልያባ፤ ካሎይ አምናዳበ፤ ሄንይ ሳማ። <verse eid="1SA 17:13"/><verse number="14" style="v" sid="1SA 17:14"/>ዳዊቲ ናይታ ኡባፈ ካሎ፤ ባይራ ሄ ናይት ሳኦላ ካልዶሶና። <verse eid="1SA 17:14"/><verse number="15" style="v" sid="1SA 17:15"/>ሽን ዳዊቲ ባ አዋ ዶርሳታ ሄማናዉ ሳኦላ ማታፐ ቤተለመ ስመረቴስ።<verse eid="1SA 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 17:16"/>ሄ ፍልስፄመ አደይ ኦይታሙ ጋላስ ዎንታነ ኦማርስ ይድ እስራኤለታ ማንዴስ።<verse eid="1SA 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 17:17"/>እስ ጋላስ እሰየይ ባ ናኣ ዳዊታ ሀይሳዳ ያግስ፤ “ሀ ጫጨትዳ ትያፐ ላታሙ ክሎ ግራመነ ሀ ታሙ ኡይታ ኤካዳ ነ እሻታስ ኤፋዳ ነ እሻት ዱንካንዳ ጉታ ኤለ ጋ። <verse eid="1SA 17:17"/><verse number="18" style="v" sid="1SA 17:18"/>ሀ ታሙ ኑካ ፕላ ኤንታ ሻላቃስ ኤፋ፤ ነ እሻት ዋን ደእያኮ በአዳ፥ ኤንቲ ሳሮ ደኤይሳስ ማላታ ኤንታፈ ኤካዳ ያ። <verse eid="1SA 17:18"/><verse number="19" style="v" sid="1SA 17:19"/>ካዎይ ሳኦል፥ ነ እሻትነ እስራኤለ አሳ ኡባይ ፍልስፄመታራ ኦለትሸ ኤላ ዛንጋራን ደኦሶና” ያግስ።<verse eid="1SA 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 17:20"/>ዳዊቲ ጉራ ደንድድ ዶርሳታ ሀራ አስ ሄንድ፥ እሰየይ ኪትዳባ ጫን ኤክድ ብስ። እስራኤለ ኦላንቾት ባንታ ቃላ ቁ ኦድ ጋይርሸ ኦላስ ከይሽን ዳዊቲ ጋክስ። <verse eid="1SA 17:20"/><verse number="21" style="v" sid="1SA 17:21"/>እስራኤለትነ ፍልስፄመት እሶይ እሱዋኮ ስሚድ ሳልፕዶሶና። <verse eid="1SA 17:21"/><verse number="22" style="v" sid="1SA 17:22"/>ዳዊቲ ባ ኤህዳባ ሽንቀ ናገይሳ ኩሸን ዎድ፥ ኦላ ሳልፕያ ግዶ ዎፅ ብድ፥ ባ እሻታ ሳሮስ። <verse eid="1SA 17:22"/><verse number="23" style="v" sid="1SA 17:23"/>ዳዊቲ ባ እሻታራ ሃሳይሽን፥ ጋተፐ ይዳ ቶራ ቃራይ፥ ፍልስፄመ ጎልያድ ባ ሳልፕያፈ ጋፃ ከይድ ካሰይሳዳ እስራኤለታ ማንድሽን ዳዊቲ ስእስ። <verse eid="1SA 17:23"/><verse number="24" style="v" sid="1SA 17:24"/>እስራኤለ አሳ ኡባይ ሄ አድያ በእዳ ዎደ ዳሮ ያይድ ባቃትዶሶና።<verse eid="1SA 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 17:25"/>እስራኤለ አሳይ እሶይ እሱዋኮ፥ “ሀ ከይያ አድያ በእደቲ? እ ቱማ እስራኤለ ማንዳናዉ ከይስ። ሀ አድያ ዎያ ኡራስ ካዎይ ሳኦል ዳሮ ሻሎ እማና፤ ባ ናእዉካ እያዉ እማና፤ እያ አዋ ኬ አሳይ እስራኤለን ካዎ ጊራ ጊረና” ያግዶሶና።<verse eid="1SA 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 17:26"/>ዳዊቲ ባ ማታን ኤቅዳ አሳ፥ “ሀ ፍልስፄመ አድያ ዎድ፥ ሀ ዬላ እስራኤለፐ ደንያ ኡራስ አይበ ኦሰታናይ? ሀ ቃፃረትቦና ፍልስፄመይ ደኦ ፆሳ ኦላንቾታ ማንደይ እ ኦኔ?” ያግድ ኦይችስ።<verse eid="1SA 17:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1SA 17:27"/>ኤንቲ፥ “ሀ አድያ ዎያ ኡራስ ሀይስ ሀይስ ኦሰታና” ያግድ ካሰይሳዳ ዛርዶሶና።<verse eid="1SA 17:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 17:28"/>ዳዊቲ አሳራ ኦደተይሳ እያ ባይራ እሻይ ኤልያብ ስእድ፥ ዳዊታ ቦላ ሸነ ኤፅስ። “ኔኒ ሀ በሳ አይስ ያዲ? ሄ ጉ ዶርሳታ ባዞን ኦደስ የጋዲ? ነ ኦቶሩዋነ ነ ዎዛና ኢታተ ታ ኤራይስ፤ ኔኒ ኦላ በአናዉ ያዳሳ” ያግስ።<verse eid="1SA 17:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1SA 17:29"/>ዳዊቲ፥ “ታኒ ሀእ አይ ኦድና? ሀር አቶሽን ኦደታናዉካ ዳንዳእክና?” ያግስ። <verse eid="1SA 17:29"/><verse number="30" style="v" sid="1SA 17:30"/>ዳዊቲ ባ እሻ አግድ፥ ሀራ አሳኮ ስሚድ፥ ካሰይሳዳ ኦይችን አሳይ እያዉ ካሰይሳዳ ዛርዶሶና።<verse eid="1SA 17:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1SA 17:31"/>ዳዊቲ ኦድዳይሳ ስእዳ አሳይ ሳኦላስ ኦድን፥ ሳኦል ዳዊታ ፄግስስ። <verse eid="1SA 17:31"/><verse number="32" style="v" sid="1SA 17:32"/>ዳዊቲ ሳኦላኮ፥ “ሀ አድያ ጋሶን ኦደ ዎዛንካ ትልኦፎ፤ ታኒ ነ አይለይ ባዳ፥ ሀ ፍልስፄመ አድያራ ኦለታና” ያግስ።<verse eid="1SA 17:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1SA 17:33"/>ሳኦል ዳዊታኮ፥ “ኔኒ ናአ፤ እ ባ ናአተፈ ዶምድ ኦላ ሜዘትድ ድጭዳ ግሾ፥ ሀ ፍልስፄመ አድያራ ኔኒ ኦለታናዉ ዳንዳአካ” ያግስ።<verse eid="1SA 17:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1SA 17:34"/>ሽን ዳዊቲ፥ “ታኒ፥ ነ አይለይ ታ አዋ ዶርሳታ ሄምያ ዎደ ጋሞይ ዎይኮ ጋርማፌለይ ከይድ ዶርሰ ኦይክያ ዎደ፥ <verse eid="1SA 17:34"/><verse number="35" style="v" sid="1SA 17:35"/>እያ ካላ ባዳ እያ ዶናፐ ዎ ኤካይስ። ታኮ ስምያ ዎደ ቆያ ጩላዳ ዎይስ። <verse eid="1SA 17:35"/><verse number="36" style="v" sid="1SA 17:36"/>ታኒ ነ አይለይ ጋሞነ ጋርማፌለ ዎስ፤ ሀ ቃፃረትቦና ፍልስፄመ አደይ ደኦ ፆሳ ኦላንቾታ ጉዳ ግሾ እ ኤንታፈ እሱዋዳ ሀናና። <verse eid="1SA 17:36"/><verse number="37" style="v" sid="1SA 17:37"/>ጋሞፈነ ጋርማፌለፐ ታና አሽዳ ጎዳይ፥ ሀ ፍልስፄመ አድያ ኩሸፐ ታና አሻና” ያግስ።</para>
  <para style="p" vid="1SA 17:37">ሳኦል ዳዊታኮ፥ “ባ፥ ጎዳይ ኔራ ግዶ” ያግስ።<verse eid="1SA 17:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1SA 17:38"/>ሳኦል ባ ማኡዋ ዳዊታ ማይዝስ፤ ዳዊታ ሁጰን ናሰ ብራታ ባርኔፃ ዎስ፤ ናሰ ብራታ ፁሩርያ ዳዊታ ማይዝስ። <verse eid="1SA 17:38"/><verse number="39" style="v" sid="1SA 17:39"/>ዳዊቲ ባ ኦላ ማኡዋ ቦላ ማሻ ዳንጭድ ሄመትድ በእስ። ሽን ሄሳ መላ ማኦ ማእድ ኤሮና ግሾ ሄመታናዉ ዳንዳእቤና።</para>
  <para style="p" vid="1SA 17:39">ሄሳ ግሾ፥ ዳዊቲ ሳኦላኮ፥ “ታኒ ሀይሳ መላ ማኦ ማአዳ ሜዘታቦና ግሾ ሀይሳራ ባናዉ ዳንዳእከ” ያግድ ኦላ ማኡዋ ቃርስ። <verse eid="1SA 17:39"/><verse number="40" style="v" sid="1SA 17:40"/>ዳዊቲ ባ ሄን ፃምአ ኦይክድ፥ ሻፋፐ እቻሹ ሙሉሙቀ ሹቹ ዶር ኤክድ፥ ባ ሄን ቃርፂታን የግድ፥ ባ ያምባርሻ ኦይክድ፥ ጎልያዳኮ ሺቅስ።<verse eid="1SA 17:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 17:41"/>ጎልያድ ባ ጎንዳልያ ቶክያ አድያራ እስፈ ሄመትሸ ዳዊታኮ ማትስ። <verse eid="1SA 17:41"/><verse number="42" style="v" sid="1SA 17:42"/>እ ዳዊታ ትሽ ኦ ፄልድ፥ ዳዊቲ አርሰ፥ ማላ ሎኦነ ናአ ግደይሳ በእድ ካስ። <verse eid="1SA 17:42"/><verse number="43" style="v" sid="1SA 17:43"/>እ ዳዊታኮ፥ “ኔኒ ፃምአ ኦይካዳ ታኮ ያናዉ ታና ካና ጋዲ?” ያግስ። ባ ፆሳታ ሱንን ዳዊታ ባድስ። <verse eid="1SA 17:43"/><verse number="44" style="v" sid="1SA 17:44"/>ካልድ ዳዊታኮ፥ “ሃያ፤ ታኒ ነ አሹዋ ሳሎ ካፎታስነ ሳአ ዶአታስ እማና” ያግስ።<verse eid="1SA 17:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1SA 17:45"/>ዳዊቲ፥ “ኔኒ ማሻ፥ ቶራነ ጉምባ ኦይካዳ ታኮ ያሳ፤ ሽን ታኒ ኡባፈ ዎልቃማ ጎዳ ሱንን፥ ኔኒ ጉዳ እስራኤለ ኦላንቾታ ፆሳ ሱንን ነ ቦላ ያይስ። <verse eid="1SA 17:45"/><verse number="46" style="v" sid="1SA 17:46"/>ሀች ጎዳይ ነና ታ ኩሸን አድ እማና፤ ታኒ ነና ሾጫና፤ ነ ቆያ ሙጫ ሆላና። ፍልስፄመ ኦላንቾታ አሀ ሳሎ ካፎታስነ ሳአ ዶአታስ ሀች እማና። ሄ ዎደ እስራኤለን ፆሲ ደኤይሳ ሳአን ደእያ አሳ ኡባይ ኤራና። <verse eid="1SA 17:46"/><verse number="47" style="v" sid="1SA 17:47"/>ጎዳይ ባ አሳ አሻናዉ ቶራ ዎይኮ ማሸ ኮዮናይሳ ሀይሳን ሺቅዳ አሳ ኡባይ ኤራና። ኦላይ ጎዳባ ግድያ ግሾ፥ እ ህንተና ኡባ ኑ ኩሸን አድ እማና” ያግስ። <verse eid="1SA 17:47"/><verse number="48" style="v" sid="1SA 17:48"/>ፍልስፄመ አደይ ደንድድ፥ ዳዊታራ ኦላ ጋሄታናዉ ሺቅዳ ዎደ ዳዊቲ እያራ ጋሄታናዉ ኦላ ደምባ ዎፅድ ብስ። <verse eid="1SA 17:48"/><verse number="49" style="v" sid="1SA 17:49"/>ዳዊቲ ባ ቃርፂታን ኩሸ የድድ፥ እስ ሹቹ ኤክ ያምባርድ፥ ፍልስፄመ አድያ ሶምኡዋን ጫድስ። ሹቻይ እያ ሶምኡዋ ሉክድ ገልስ፤ ያትን፥ አደይ ባ ሶምኡዋራ ሳአን ኩንድስ።<verse eid="1SA 17:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1SA 17:50"/>ዳዊቲ ፍልስፄመ አድያ ያምባርሻንነ ሹቻን ፆንስ። ዳዊቲ ባ ኩሸን ማሽ ባይና ፍልስፄመ አድያ ጫድድ ዎስ። <verse eid="1SA 17:50"/><verse number="51" style="v" sid="1SA 17:51"/>ዳዊቲ ዎፅ ብድ፥ እያ ቦላ ከይ ኤቅድ፥ እያ ዎድ፥ ፍልስፄመ አድያ ማሻ ሾሁዋፐ ሾድድ፥ እያ ቆያ ሙጭ የግስ።</para>
  <para style="p" vid="1SA 17:51">ፍልስፄመት ባንታ ቶራ ቃራይ ሀይቅዳይሳ በእዳ ዎደ ባቃትዶሶና። <verse eid="1SA 17:51"/><verse number="52" style="v" sid="1SA 17:52"/>እስራኤለ አሳይነ ይሁዳ አሳይ ደንድድ ገሬርሸ፥ ፍልስፄመታ ጋተነ ኤቅሮና ፐንገታ ጋካናዉ የደዶሶና። ፍልስፄመ አሳ አሀይ ጋተነ ኤቅሮና ጋካናዉ ሻእራይማ ኤፍያ ኦግያ ኡባን ኩንድስ። <verse eid="1SA 17:52"/><verse number="53" style="v" sid="1SA 17:53"/>እስራኤለ አሳይ ፍልስፄመታ የደ ስሚድ፥ ኤንቲ ዱንካንዳ ጉታ ቦንቅዶሶና። <verse eid="1SA 17:53"/><verse number="54" style="v" sid="1SA 17:54"/>ዳዊቲ ፍልስፄመ አድያ ሁጵያ የሩሳላመ ኤህስ፤ ሽን ፍልስፄመ አድያ ኦላ ሚሽያ ባ ዱንካንያ ግዶን ዎስ።<verse eid="1SA 17:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="1SA 17:55"/>ዳዊቲ ፍልስፄመ አድያራ ኦለታናዉ ብሽን፥ ሳኦል በእድ፥ ቶራ ሞጮና አበኔራ፥ “ሀ ናአይ ኦደ ናኤ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="1SA 17:55">አበኔር ዛሪድ፥ “ካዋዉ፥ ቱማ ነ አሾ ታኒ እያ ኤርከ” ያግስ።<verse eid="1SA 17:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="1SA 17:56"/>ካዎይ ዛሪድ፥ “ሀ ናአይ ኦደ ናኤኮ አነ ኦይቻ” ያግስ።<verse eid="1SA 17:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="1SA 17:57"/>ዳዊቲ ፍልስፄመ አድያ ዎድ ስምዳ ዎደ አበኔር እያ ሳኦላ ስን ኤህስ። ሄ ዎደ ዳዊቲ ሙጭዳ ፍልስፄመ አድያ ሁጵያ ባ ኩሸን ኦይክድ ኡትስስ። <verse eid="1SA 17:57"/><verse number="58" style="v" sid="1SA 17:58"/>ሳኦል፥ “ታ ናአዉ፥ ነ ኦደ ናኤ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="1SA 17:58">ዳዊቲ ዛሪድ፥ “ታኒ ቤተለመን ደእያ ነ ኦሳንቹዋ፥ እሰየ ናአ” ያግስ።<verse eid="1SA 17:58"/></para>
  <chapter eid="1SA 17"/>
  <chapter number="18" style="c" sid="1SA 18"/>
  <para style="s1">ዳዊታነ ዮናታና</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 18:1"/>ዳዊቲ ሳኦላራ ሃሳያ ዉርስዳፐ ጉየ፥ ሳኦላ ናአይ ዮናታን ዳዊታራ ዳሮ ማታ ዳቦተ መስ፤ ዮናታን ዳዊታ ባ ሸምፑዋዳ ዶስስ። <verse eid="1SA 18:1"/><verse number="2" style="v" sid="1SA 18:2"/>ሄ ጋላሳፐ ዶምድ፥ ሳኦል ዳዊታ ባራ ዎስ፤ ባ አዋ ሶ ጉየ ስሞና መላ ድግስ። <verse eid="1SA 18:2"/><verse number="3" style="v" sid="1SA 18:3"/>ዮናታን ዳዊታ ባ ሁጰዳ ዶስያ ግሾ እያራ ጫቅስ። <verse eid="1SA 18:3"/><verse number="4" style="v" sid="1SA 18:4"/>ዮናታን ባ ማእዳ ካባ፥ ባ ኦላ ማኡዋ፥ ባ ማሻ፥ ባ ዶንግያነ ባ ሳቅያ ከስድ ዳዊታስ እሚስ።<verse eid="1SA 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 18:5"/>ሳኦል ኪትዳ ኡባ ዳዊቲ ናገትድ ኦያ ግሾ፥ ሳኦል ዳዊታ ባ ኦላንቾታ ግዶን ሀላቃ ኦድ ሹምስ። ሄስ አሳ ኡባነ እያ ሞርናታ ኡፋይስስ።<verse eid="1SA 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 18:6"/>ዳዉተ ፍልስፄመ አድያ ጎልያዳ ዎን፥ አሳይ ሶ ስምያ ዎደ ማጫሳይ ኡፋይሳ የ የፅሸነ ዱርሸ፥ ካራቦ ባቅሸነ ዲ ዲፅሸ፥ ካዋ ሳኦላ ሞካናዉ እስራኤለ ካታማታ ኡባፈ ከይዶሶና። <verse eid="1SA 18:6"/><verse number="7" style="v" sid="1SA 18:7"/>ማጫሳት ዱርሸ፥</para>
  <para style="q1" vid="1SA 18:7">“ሳኦል ሙኩላታ ዎስ፤</para>
  <para style="q2" vid="1SA 18:7">ዳዊቲ ታሙ ሙኩላታ ዎስ”</para>
  <para style="m" vid="1SA 18:7">ያግድ የፅዶሶና። <verse eid="1SA 18:7"/><verse number="8" style="v" sid="1SA 18:8"/>ሳኦላ ሀ የይ ሻትን፥ ዳሮ ሀንቀትስ። ሳኦል ባ ቆፋን፥ “ዳዊቲ፥ ‘ታሙ ሙኩላታ ዎዳሳ ግድ፥ ታና ሙኩላታ ዎዳሳ’ ግዶሶና። ያትን፥ ካዎተፈ አትሽን ሀር አይብ አትዴ?” ያግስ። <verse eid="1SA 18:8"/><verse number="9" style="v" sid="1SA 18:9"/>ሄ ዎደፐ ዶምድ ሳኦል ዳዊታ ቃናተ አይፈን ፄሌስ።<verse eid="1SA 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 18:10"/>ዎንተ ጋላስ ኢታ አያን ፆሳፈ ኪተትድ ሳኦላ ኦይክን፥ ሳኦል ባ ሶን ኤልሞቴስ። ዳዊቲ ካሰይሳዳ ዲ ዲፅሽን ሳኦል ቶራ ባ ኩሸን ኦይክድ ኡትስ። <verse eid="1SA 18:10"/><verse number="11" style="v" sid="1SA 18:11"/>እ፥ “ዳዊታ ጎዳራ ጋዳ ስካና” ያግ ቆፕድ ቶራ ፆንግስ። ሽን ዳዊቲ ናምኡ ቶሆ እያፐ አትስ።<verse eid="1SA 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 18:12"/>ጎዳይ ሳኦላ አግድ ዳዊታራ ደእያ ግሾ ሳኦል ዳዊታ ያይስ። <verse eid="1SA 18:12"/><verse number="13" style="v" sid="1SA 18:13"/>ሳኦል ዳዊታ ባ ስንፈ ሃሳናዉ ኮይድ ሙኩሉ ኦላንቾታስ ሀላቃ ኦስ። ያትን፥ ዳዊቲ ባ ጩጋ ኦላስ ካለስ። <verse eid="1SA 18:13"/><verse number="14" style="v" sid="1SA 18:14"/>ጎዳይ ዳዊታራ ደእያ ግሾ እ ኦያባይ ኡባይ እያዉ እንጀቴስ። <verse eid="1SA 18:14"/><verse number="15" style="v" sid="1SA 18:15"/>ዳዊቲ ኦያባ ኡባይ እንጀተይሳ ሳኦል በእድ እያዉ ዳሮ ያይስ። <verse eid="1SA 18:15"/><verse number="16" style="v" sid="1SA 18:16"/>ሽን ዳዊቲ ኤንታ ኦላን ካለያ ግሾ እስራኤለ አሳይነ ይሁዳ አሳ ኡባይ እያ ዶሶሶና።<verse eid="1SA 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 18:17"/>ሳኦል ዳዊታኮ፥ “ታ ናአ ባይርያ መራባ ሀናሹ፤ ታኒ እዮ ነዉ ማቾ እማና፤ ኔኒ ምኖ አስ ግዳ፤ ጎዳ ኦላ ኦለታ” ያግስ። ሳኦል ባ ዎዛናን፥ “ታኒ እያ ቦችከ፤ ፍልስፄመት እያ ዎ” ያግድ ቆፕስ። <verse eid="1SA 18:17"/><verse number="18" style="v" sid="1SA 18:18"/>ሽን ዳዊቲ፥ “ካዎራ ቦሎታናዉ ታኒ ኦኔ? ታ ሶ አሳይ አይቤ? ዎይኮ ታ አዋ ያራይ እስራኤለ አሳ ግዶን አይቤ?” ያግስ። <verse eid="1SA 18:18"/><verse number="19" style="v" sid="1SA 18:19"/>ሽን ሳኦላ ናእያ መራባ ዳዊታስ እመትያ ዎደይ ጋክን፥ ማሆላ አድያ አድርኤላስ እመታሱ።<verse eid="1SA 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 18:20"/>ግዶሽን፥ ሳኦላ ናእያ መልኮላ ዳዊታ ዶሳሱ፤ ሳኦል ሄሳ ስእድ ኡፋይትስ። <verse eid="1SA 18:20"/><verse number="21" style="v" sid="1SA 18:21"/>እ ባ ዎዛናን፥ “እያዉ ፅሄ ግዳና መላነ ፍልስፄመት እያ ዎና መላ ታኒ ምልኮሎ ዳዊታስ እማና” ያግድ ቆፕስ። ሄሳ ግሾ፥ ሳኦል ዳዊታ፥ “ኔኒ ታራ ቦሎታናዉ ናምአን ቃዳ ነዉ እማስ” ያግስ።<verse eid="1SA 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 18:22"/>ሳኦል ባ ኦሳንቾታ ፄግድ፥ “ ‘ካዎይ ነናን ኡፋይትስ፤ እያ አይለት ኡባይ ነና ዶሶሶና፤ ሀእ ኔኒ ካዉዋራ ቦሎታ’ ያግድ ዱማ ዳዊታስ ኦድተ” ያግድ ኪትስ።<verse eid="1SA 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 18:23"/>ሳኦል ግዳይሳዳ ኤንቲ ዳዊታስ ኦድዶሶና። ሽን ዳዊቲ፥ “ካዎራ ቦሎታናይስ ህንተዉ ላፋባ ዳንዬ? ታኒ ማንቆነ ኤረቶና አስ” ያግድ ዛርስ።<verse eid="1SA 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 18:24"/>ሳኦላ ሞርናት ዳዊቲ ግዳባ ሳኦላስ ኦድዶሶና። <verse eid="1SA 18:24"/><verse number="25" style="v" sid="1SA 18:25"/>ሳኦል ባ አይለታኮ፥ “ዳዊታስ ሀይሳዳ ያግድ ኦድተ፤ ‘ካዎይ ባ ሞርከታ ሀሎ ከያናዉ ፄቱ ፍልስፄመ አሳታ ቃራትድ ኤሀና መላፐ አትሽን፥ ኔፐ ሀራ ኮይታ ኮየና’ ያግተ” ያግስ። ሳኦል ሄሳ ግዳይ ዳዊቲ ፍልስፄመታ ኩሸን ሀይቃና መላ ቆፕዳ ግሾሳ።<verse eid="1SA 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 18:26"/>ሳኦላ አይለት ሳኦል ግዳባ ዳዊታስ ኦድዶሶና፤ ካዋራ ቦሎታናይስ ዳዊታ ኡፋይስስ። ዎደይ አናፐ ስን፥ <verse eid="1SA 18:26"/><verse number="27" style="v" sid="1SA 18:27"/>ዳዊቲነ እያ አሳይ ደንድ ብድ ፍልስፄመታፐ ናምኡ ፄቱ አሳ ዎዶሶና። ዳዊቲ ካዋራ ቦሎታናዉ ሄ አሳታ ቃራት ኤህድ፥ ካዋስ ኩመ ታይብድ ሼስ። ሳኦል ባ ናእዉ መልኮሎ ዳዊታስ እሚስ።<verse eid="1SA 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 18:28"/>ሳኦል ጎዳይ ዳዊታራ ደኤይሳነ እያ ናእያ ምልኮላ ዳዊታ ዶሰይሳ ኤርስ። <verse eid="1SA 18:28"/><verse number="29" style="v" sid="1SA 18:29"/>ሳኦል ዳዊታስ ካሰይሳፈ አድ ያይስ። ሳኦል ባ ደኦ ላይ ኡባን ዳዊታስ ሞርከ ግድስ።<verse eid="1SA 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 18:30"/>ፍልስፄመ ኦላንቾት ኦላስ ከስ አግቦኮና። ሽን ኦላስ ከይዳ ዎደ ኡባን ሳኦላ ቶራ ሞጮናታፐ አድ ፆኖይ ሀነይ ዳዊታሳ፤ ሄሳ ግሾ እ ኤረትዳ አስ ግድስ።<verse eid="1SA 18:30"/></para>
  <chapter eid="1SA 18"/>
  <chapter number="19" style="c" sid="1SA 19"/>
  <para style="s1">ሳኦል ዳዊታ ዎናዉ ኮይስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 19:1"/>ዳዊታ ዎና መላ ሳኦል ባ ናኣ ዮናታናስነ ባ ኦሳንቾታስ ኦድስ። ሽን ሳኦላ ናአይ ዮናታን ዳዊታ ዳሮ ዶሴስ። <verse eid="1SA 19:1"/><verse number="2" style="v" sid="1SA 19:2"/>ሄሳ ግሾ፥ ዮናታን ዳዊታኮ፥ “ታ አዋይ ሳኦል ነና ዎናዉ ኮይያ ግሾ ዎንቶ ዎንታ ነና ናጋ፤ እስ በሳን ቆሰታዳ ደኣሻ። <verse eid="1SA 19:2"/><verse number="3" style="v" sid="1SA 19:3"/>ታኒ ታ አዋራ ባዳ፥ ኔኒ ቆሰትዳ ጋድያን ኤቃና፤ ታኒ ነባ እያዉ ኦዳዳ፥ እያፐ ስእያባ ነዉ ኦዳና” ያግድ ኪትስ።<verse eid="1SA 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 19:4"/>ዮናታን ዳዊታ ናሽድ፥ ባ አዋ ሳኦላኮ ሀይሳዳ ያግስ፤ “ካዎይ ባ አይልያ ዳዊታ ቆህድ ናጋራ ኦፎ፤ እ ነና ቆህቤና፤ እ ኦዳባይ ነና ዳሮ ጎእስ። <verse eid="1SA 19:4"/><verse number="5" style="v" sid="1SA 19:5"/>እ ፍልስፄመ አድያ ዎዳ ዎደ ባ ሸምፑዋስ ቃትቤና። ጎዳይ እስራኤለ ኡባስ ግታ ፆኖ እሚስ፤ ሄሳ በአዳ ነካ ኡፋይታዳሳ። ያትን፥ ኔኒ ጌሻ አስ ቆሀናዉ አይስ ቆፓይ? ጋሶይ ባይና ዳዊታ ዎናዉ አይስ ኮያይ?” ያግስ።<verse eid="1SA 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 19:6"/>ሳኦል ዮናታን ኦድዳባ ስእድ፥ “ደኦ ፆሲ ኤርያ መላ፥ ታኒ ዳዊታ ዎከ” ያግድ ጫቅስ።<verse eid="1SA 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 19:7"/>ዮናታን ዳዊታ ፄግድ ኤንቲ ኦደትዳባ ኡባ እያዉ ኦድስ። ያትድ ዳዊታ ሳኦላኮ ኤህን ዳዊቲ ካሰይሳዳ ሳኦላራ ደእስ።<verse eid="1SA 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 19:8"/>ፍልስፄመታራ ዛሪድ ሀራ ኦል ደንድስ፤ ዳዊቲ ከይድ ፍልስፄመታራ ኦለትድ፥ ኤንታ ግታ ሾቹ ሾጭን፥ ኤንቲ እያ ስንፈ ባቃትዶሶና።<verse eid="1SA 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 19:9"/>ሄሳፈ ስምን፥ ሳኦል ቶራ ኦይክድ ባ ሶን ኡትዳሽን፥ ኢታ አያን ጎዳፐ ኪተትድ እያ ኦይክስ። ያትን፥ ዳዊቲ ዲ ዲፅሽን፥ <verse eid="1SA 19:9"/><verse number="10" style="v" sid="1SA 19:10"/>ሳኦል ዳዊታ ጎዳራ ጋድ ስካናዉ ቶራ ፆንግስ፤ ሽን ዳዊቲ እያፐ ደሽ ግድ አትን፥ ቶራይ ጎዳን ቶከትስ። ሄ ቃማ ዳዊቲ ከስ ኤክድ ባቃትስ።<verse eid="1SA 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 19:11"/>ዳዊታ ኬን ናግድ ዎንታ ዎና መላ ሳኦል አሰ ኪትስ።</para>
  <para style="p" vid="1SA 19:11">ዳዊታ ማችያ መልኮላ፥ “ሀች ቃማ ኔኒ ነ ሸምፑዋ አሾና እፅኮ፥ ዎንቶ ሀይቃሳ” ያጋዳ ዳዊታስ ኦዳሱ። <verse eid="1SA 19:11"/><verse number="12" style="v" sid="1SA 19:12"/>ምልኮላ ዳዊታ ማስኮተራ ከስን፥ ዳዊቲ ከስ ኤክድ ባቃትስ። <verse eid="1SA 19:12"/><verse number="13" style="v" sid="1SA 19:13"/>ሄሳፈ ጉየ መልኮላ ኤቃ ምስለ ኤካዳ አርሳን ዝንእሳሱ፤ ሁጰሶን ዴሻ እክሰ ዎዳ አፍላ ማይዛሱ።<verse eid="1SA 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 19:14"/>ዳዊታ ኦይክድ ኤሀና መላ ሳኦል አሰ ኪትን ምልኮላ፥ “ዳዊቲ ሳከትስ” ያጋሱ።<verse eid="1SA 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 19:15"/>ዳዊታ በአና መላ ሳኦል ሄ አሳታ ጉየ ኪትድ፥ “ታኒ ዳዊታ ዎና መላ እያ አልጋራ ቶክድ ኤክ ዪተ” ያግስ። <verse eid="1SA 19:15"/><verse number="16" style="v" sid="1SA 19:16"/>ሽን አሳት ሶ ገልያ ዎደ ኤቃ ምስለይ አርሳን ዝንእዳይሳነ እያ ሁጰሶን ዴሻ እክሰይ ደኤይሳ ደምዶሶና።<verse eid="1SA 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 19:17"/>ሳኦል መልኮሎ፥ “ኔኒ አይስ ሀይሳዳ ኦዳ ታና ጭማዲ? ታ ሞርከይ ከስ ኤካና መላ አይስ ኦዲ?” ያግስ።</para>
  <para style="p" vid="1SA 19:17">ምልኮላ ዛራዳ፥ “እ ታኮ፥ ‘ታና ከሳዳ የዳ፤ እፅኮ ታ ነና ዎና’ ያግስ” ያጋሱ።<verse eid="1SA 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 19:18"/>ዳዊቲ ከስ ኤክድ ራማን ደእያ ሳሜላኮ ብድ ሳኦል ባና ኦዳ ኡባ እያዉ ኦድስ። ዳዊትነ ሳሜል ናዮታ ብድ ያን ኡትዶሶና። <verse eid="1SA 19:18"/><verse number="19" style="v" sid="1SA 19:19"/>ሳኦል ዳዊቲ ራማን ደእያ ናዮታን ደኤይሳ ስእስ። <verse eid="1SA 19:19"/><verse number="20" style="v" sid="1SA 19:20"/>ዳዊታ ኦይክድ ኤሀና መላ አሰ ያ ኪትስ። ሽን ናበ ጩጋይ ሳሜላ ካለዋን ትንብተ ኦድሽን በእዳ ዎደ ሳኦል የድዳ አሳታ ቦላ ፆሳ አያናይ ዎን፥ ኤንትካ ትንብተ ኦድዶሶና። <verse eid="1SA 19:20"/><verse number="21" style="v" sid="1SA 19:21"/>ሳኦል ሄሳ ስእዳ ዎደ ሀራ አስ የድስ፤ ኤንትካ ቃስ ትንብተ ኦድዶሶና። ሳኦል ሄን አሰ የድን ኤንትካ ትንብተ ኦድዶሶና። <verse eid="1SA 19:21"/><verse number="22" style="v" sid="1SA 19:22"/>ዉርሰን፥ ሳኦል ባ ሁጰን ራማ ብድ፥ ሴኩን ደእያ ግታ ኦላ ጋክድ፥ “ሳሜልነ ዳዊቲ አዉን ደኦና?” ያግድ ኦይችስ።</para>
  <para style="p" vid="1SA 19:22">ኤንቲ፥ “ህንን ራማን ደእያ ናዮታን ደኦሶና” ያግድ ዛርዶሶና።<verse eid="1SA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 19:23"/>ሄሳ ግሾ፥ ሳኦል ራማን ደእያ ናዮታ ብስ፤ ቃስ ፆሳ አያናይ እያ ቦላካ ዎን፥ ራማን ደእያ ናዮታ ጋካናዉ ትንብተ ኦድሸ ብስ። <verse eid="1SA 19:23"/><verse number="24" style="v" sid="1SA 19:24"/>እ ባ ማኡዋ ቃርድ፥ ሳሜላ ስንን ትንብተ ኦድስ፤ ጋላስነ ቃማ ኩመ ካሎ ዝንእስ። አሳይ፥ “ሳኦልካ ናበታፐ እሱዋ ግድደየ” ገይስ ሄሳሳ።<verse eid="1SA 19:24"/></para>
  <chapter eid="1SA 19"/>
  <chapter number="20" style="c" sid="1SA 20"/>
  <para style="s1">ዮናታን ዳዊታ ማድስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 20:1"/>ዳዊቲ ራማን ደእያ ናዮታፐ ባቃትድ፥ ዮናታናኮ ብድ፥ “ታኒ አይ ኦድና? ታ ባላይ አይቤ? ነ አዋይ ታና ዎናዉ ኮየይ ታኒ እያ አይ ቆህኔ?” ያግድ ኦይችስ።<verse eid="1SA 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 20:2"/>ዮናታን፥ “ሄስ ኔፐ ሃኮ፤ ኔኒ ሀይቃካ። ጉባ ግድን፥ ግታባ ግድን፥ ታ አዋይ ታፐ ቆስድ አይኮካ ኦና። ታ አዋይ ታፐ አይስ ሄሳ ቆስዴ? ሄስ ሀነና” ያግድ ዛርስ።<verse eid="1SA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 20:3"/>ሽን ዳዊቲ፥ “ነ ታና ዶሰይሳ ነ አዋይ ሎይ ኤሬስ። እ ባ ዎዛናን፥ ዮናታን ሀ ኦዳ ኤሮፖ፤ እ ኤርኮ አዛናና” ያግስ። ሽን፥ “ደኦ ፆሲ ኤርያ መላ፥ ነ ሸምፖይ ኤሮ፤ ታፐነ ሀይቆፐ ግዶን እስ ታንጎ ፃላል አትስ” ያግድ ጫቅስ።<verse eid="1SA 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 20:4"/>ዮናታን፥ “ኔኒ ኦ ግዳባ አይባካ ታኒ ነዉ ኦና” ያግስ።<verse eid="1SA 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 20:5"/>ዳዊቲ ዛሪድ፥ “ዎንቶ አጌና ፄሮ ባኣለ ቦንችያ ጋላስ፤ ታኒ ካዉዋራ ካ ማናዉ ኮሼስ። ሽን ዎንት ፔእን ኦማርስ ጋካናዉ ታኒ ጋደን ቆሰታና። <verse eid="1SA 20:5"/><verse number="6" style="v" sid="1SA 20:6"/>ነ አዋይ ታና ኮይኮ፥ ኔኒ፥ ‘ዳዊቲ ባ አሳራ ላይ ያርሾ ያርሽያ ዎደ ግድያ ግሾ ባ ሶ ቤተለመ ባናዉ ታና ኦይችድ ብስ’ ያጋ። <verse eid="1SA 20:6"/><verse number="7" style="v" sid="1SA 20:7"/>እ፥ ‘ያኮ ሎኦ’ ጊኮ፥ ታዉ ነ አይልያስ ሳሮ፤ ሽን እ ሀንቀትኮ፥ እ ታና ቆሀናዉ ባ ዎዛናን ቆፕዳይሳ ሄሳን ኤራ። <verse eid="1SA 20:7"/><verse number="8" style="v" sid="1SA 20:8"/>ሽን ኔኒ ታዉ ነ አይልያስ ሎኦባ ኦ፤ ኔኒ ታራ ነ አይልያራ ጎዳ ስንን ጫቃዳሳ። ታኒ ባላ ግድኮ፥ ታና ነ ዎ፤ ነ አዋስ ታና አዳ እሞፋ” ያግስ።<verse eid="1SA 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 20:9"/>ዮናታን፥ “ሄስ ኔፐ ሃኮ፤ ታ አዋይ ነና ቆሀናዉ ቆፕዳባ ታ ኤርዳኮ፥ ነዉ ኦድክና?” ያግስ።<verse eid="1SA 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 20:10"/>ዳዊቲ “ነ አዋይ ነዉ ኢታ ዛሮ ዛርኮ፥ ታዉ ኦዳናይ ኦኔ?” ያግድ ኦይችስ።<verse eid="1SA 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 20:11"/>ዮናታን፥ “ሃያ፤ ጋደ ቦስ” ያግን፥ ናምአይ ጋደ ብዶሶና።<verse eid="1SA 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 20:12"/>ዮናታን ዳዊታኮ፥ “ጎዳይ እስራኤለ ፆሳይ ኤሮ፥ ታኒ ዎንት ፔእን ታ አዋይ ነባ ግያባ ስአዳ ነዉ እ ቆፕያ ቆፋይ ሎኦ ግድኮ ታኒ ኪታዳ ነና ኤርሳና። <verse eid="1SA 20:12"/><verse number="13" style="v" sid="1SA 20:13"/>ሽን ታ አዋይ ነና ቆሀናዉ ኮያባ ግድኮ፥ ሄሳ ታኒ ነና ኤርሶናነ ኔኒ ሳሮን ከሳ ኤካና መላ ኦና እፅኮ፥ ጎዳይ ታና ፕርዶ፤ ጎዳይ ታ አዋራ ግድዳይሳዳ ኔራ ግዶ። <verse eid="1SA 20:13"/><verse number="14" style="v" sid="1SA 20:14"/>ታ ደኦ ላይ ኡባን ታ ሀይቆና መላ ጎዳ ሲቁዋ ታና በሳ። <verse eid="1SA 20:14"/><verse number="15" style="v" sid="1SA 20:15"/>ጎዳይ ዳዊታ ሞርከታ ኡባ ቢታፈ ይስያ ዎደካ ነ ሲቁዋ ታ ሶ አሳስ በሳ” ያግስ።<verse eid="1SA 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 20:16"/>ሄሳ ግሾ፥ ዮናታን፥ “ጎዳይ ዳዊታ ሞርከታ ፕርዶ” ያግድ ዳዊታ ሶ አሳራ ጫቅስ። <verse eid="1SA 20:16"/><verse number="17" style="v" sid="1SA 20:17"/>ዮናታን ዳዊታ ባ ሁጰዳ ዶስያ ግሾ፥ “ኔኒ ታና ቱማ ዶሰይሳ ቆንጭሳናዉ ታዉ አነ ናምአን ጫቃ” ያግስ።<verse eid="1SA 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 20:18"/>ሄሳፈ ጉየ፥ ዮናታን፥ “ዎንቶ አጌና ፄሮ ባኣለ ቦንችያ ጋላስ፤ ኔኒ ኡትያ በሳይ መላ አትኮ ነ ባይናይስ ኤረታና። <verse eid="1SA 20:18"/><verse number="19" style="v" sid="1SA 20:19"/>ዎንት ፔእን ኦማርስ ባዳ፥ ሀ መቶይ ዶምዳ ጋላስ ኔኒ ቆሰትዳ በሳን፥ ኤፀላ ዛላፈ ጉየራ ቆሰታ። <verse eid="1SA 20:19"/><verse number="20" style="v" sid="1SA 20:20"/>ታኒ እስባ ቦላ ፆንግያ አሳዳ ሀናዳ ሄ ዶንገ ቶራታ ሄ ዛላ ምየ የዳና። <verse eid="1SA 20:20"/><verse number="21" style="v" sid="1SA 20:21"/>ሄሳፈ ጉየ፥ ‘ባዳ ዶንገ ቶራታ ኮያ’ ያጋዳ እስ ናአ ኪታና። ታኒ እያኮ፥ ‘ዶንገ ቶራት ኔፐ ሀ ባጋራ ደኦሶና፤ ሃ ኤካዳ ያ’ ግያባ ግድኮ፥ ሃያ፤ ደኦ ጎዳይ ኤርያ መላ፥ ነዉ ሳእ ሳሮ፤ ነና አይኮይካ ቦቸና። <verse eid="1SA 20:21"/><verse number="22" style="v" sid="1SA 20:22"/>ሽን ታኒ ናኣኮ፥ ‘ዶንገ ቶራት ኔፐ ህን ባጋራ ደኦሶና’ ግያባ ግድኮ፥ ኔኒ አጋዳ ባ፤ ጎዳይ ነ ባና መላ ኮይያ ግሾ ባ። <verse eid="1SA 20:22"/><verse number="23" style="v" sid="1SA 20:23"/>ኔራ ታራ ኦደትዳ ኦዳስ ጎዳይ ኑ ግዶን መርናዉ ማርካ” ያግስ።<verse eid="1SA 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 20:24"/>ሄሳ ግሾ፥ ዳዊቲ ጋደን ቆሰትስ። አጌና ፄሮ ባኣለ ቦንችያ ጋላስ ጋክዳ ዎደ ካዎይ ሳኦል ግብራ ቦላ ኡትስ። <verse eid="1SA 20:24"/><verse number="25" style="v" sid="1SA 20:25"/>ካዎይ ባ ኡትያ በሳን ጎዳ ማታን ኡትስ፤ ዮናታን እያፐ ስን ባጋን፥ አበኔር ሳኦላ ማታን ኡትስ፤ ሽን ዳዊታ በሳይ መላ ደኤስ። <verse eid="1SA 20:25"/><verse number="26" style="v" sid="1SA 20:26"/>ሳኦል ሄ ጋላስ አይኮካ ግቤና። ሳኦል ባ ዎዛናን፥ “ዳዊቲ ዎጋዳ ጌዮና መላ እስባይ እያ ጋክስ፤ እ ጌይቤና” ያግድ ቆፕስ። <verse eid="1SA 20:26"/><verse number="27" style="v" sid="1SA 20:27"/>ሽን ዎንተ ጋላስ፥ አጌናይ ፄርን ናምአን ጋላስ ዳዊታ በሳይ መላ ደኤስ። ሳኦል ባ ናኣ ዮናታና ፄግድ፥ “እሰየ ናአይ ዝነካ ሀችካ ግብራ ማናዉ አይስ ይበኔ?” ያግድ ኦይችስ።<verse eid="1SA 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 20:28"/>ዮናታን፥ “ዳዊቲ ቤተለመ ባና ግድ ታና ምንድ ኦይችስ። <verse eid="1SA 20:28"/><verse number="29" style="v" sid="1SA 20:29"/>እ ታኮ፥ ‘ኑ ሶ አሳይ ካታማን ያርሾ ያርሽያ ግሾነ ታ ያን በንታና መላ ታ እሻይ ታና ኪትዳ ግሾ ታና የዳርክ። ታ ነ ስንን ሳባ ደምዳባ ግድኮ ታኒ ታ እሻታ በአና መላ ታና የዳ’ ያግድ ኦይችስ። ካዋ ግብራፐ ማናዉ እ ዮናይ ሄሳ ግሾሳ” ያግድ ዛርስ።<verse eid="1SA 20:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 20:30"/>ሳኦል ዮናታና ቦላ ሸነ ኤፅ ከይድ፥ “ላ፥ ጌላነ ማካላንቾ ማጫሰ ናአዉ፥ ኔኒ ነዉ ካዉሸ፥ ነ አየስ ዬላ ኤሀናዉ እሰየ ናኣራ ላገተይሳ ታ ኤርክናዬ? <verse eid="1SA 20:30"/><verse number="31" style="v" sid="1SA 20:31"/>እሰየ ናአይ ሀ ሳአ ቦላ ደእዳ ፔሻን ነ ዎይኮ ነ ካዎተይ ኤቀና። ሀእ ኪታዳ ኤለ ኤህሳ፤ እ ሀይቃናዉ በሴስ” ያግስ።<verse eid="1SA 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 20:32"/>ዮናታን ባ አዋ፥ “እ አይስ ሀይቂ? እ አይ ኢታባ ኦዴ?” ያግድ ኦይችስ።<verse eid="1SA 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1SA 20:33"/>ሳኦል ዮናታና ዎናዉ ቶራ እያ ቦላ ፆንግስ። ሄሳ ግሾ፥ ዮናታን ባ አዋ ሳኦል፥ ዳዊታ ዎናዉ ቆፕዳይሳ ጌሽድ ኤርስ። <verse eid="1SA 20:33"/><verse number="34" style="v" sid="1SA 20:34"/>ዮናታን ሸነትድ ግብራ ቦላፈ ደንድስ፤ ባ አዋይ፥ ዳዊታ ካዉሽዳ ግሾ ዮናታን አዛንድ፥ አጌና ፄሮ ባኣለ ቦንችያ ናምአን ጋላስ ካ ምቤና።<verse eid="1SA 20:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1SA 20:35"/>ዮናታን ባራ እስ ናአ ኤክድ ዎንታ ጉራ ዳዊታራ ጋሄታናዉ ጋደ ብስ። <verse eid="1SA 20:35"/><verse number="36" style="v" sid="1SA 20:36"/>ዮናታን፥ “ታኒ ዱክያ ዶንገ ቶራታ ዎፃ ባዳ ኤካዳ ያ” ያግስ። ናአይ ዎፅያ ዎደ እስ ዶንገ ቶራ ሄፍን ዱክስ። <verse eid="1SA 20:36"/><verse number="37" style="v" sid="1SA 20:37"/>ናአይ ዮናታና ዶንገ ቶራይ ዎዳ በሳ ጋክያ ዎደ ዮናታን ናኣ ፄግድ፥ “ዶንገ ቶራይ ኔፐ ህን ባጋራ ደኤኔ?” <verse eid="1SA 20:37"/><verse number="38" style="v" sid="1SA 20:38"/>ዮናታን ናኣ፥ “ኤለሳ፤ ባ፤ ኤቆፋ” ያግድ ባ ቃላ ቁ ኦድ ኦድስ። ናአይ ዶንገ ቶራ ማፅድ ባ ጎዳስ ኤህስ። <verse eid="1SA 20:38"/><verse number="39" style="v" sid="1SA 20:39"/>ዮናታናፐነ ዳዊቲፐ አትሽን፥ ናአይ ሄ ፁራ ኤረና። <verse eid="1SA 20:39"/><verse number="40" style="v" sid="1SA 20:40"/>ዮናታን ባ ኦላ ሚሽያ ናኣስ እምድ፥ “ሀይሳ ካታማ ኤካዳ ባ” ያግስ።<verse eid="1SA 20:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 20:41"/>ናአይ ብዳፐ ጉየ፥ ዳዊቲ ሄ ዛላ ጉየፐ ከይድ ዮናታና ስንን ጉልባትድ፥ ባ ሶምኡዋ ሳአ ጋድ ሄ ቶሆ ዝግስ። ሄሳፈ ጉየ፥ እሶይ እሱዋራ ዬረትድ ዬክዶሶና፥ ሽን ዳዊቲ ዮናታናፐ አ ዬክስ።<verse eid="1SA 20:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1SA 20:42"/>ዮናታን፥ “ሳሮ ባ፤ ‘ነ ግዶንነ ታ ግዶን፥ ነ ኮቻ ግዶንነ ታ ኮቻ ግዶን፥ ጎዳይ መርናዉ ማርካ ግዶ’ ያግድ ኑ ናምአይ ጎዳ ሱንን ጫቅዳ” ያግስ። ሄሳፈ ጉየ፥ ዳዊቲ ደንድድ ብስ፤ ዮናታንካ ካታማ ጉየ ስምስ።<verse eid="1SA 20:42"/></para>
  <chapter eid="1SA 20"/>
  <chapter number="21" style="c" sid="1SA 21"/>
  <para style="s1">ዳዊቲ ሳኦላፐ ባቃትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 21:1"/>ዳዊቲ ካህንያ አብመለከኮ ኖባ ብስ። አብመለከይ ዳዊታራ ጋሄታናዉ ኮኮርሸ ይድ፥ “ኔኒ ነርካ ዋናዳ ያዲ? ኔራ አስ ዋንድ ባዌ?” ያግድ ኦይችስ።<verse eid="1SA 21:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 21:2"/>ዳዊቲ ካህንያ አብመለከ፥ “ካዎይ ታኮ፥ ‘ታኒ ነና ኪትዳ ኪታነ ታ ነዉ ኦድዳባ ኦንካ ኤሮፖ’ ያግድ ታና ኪትስ። ታ አሳት እስ በሳን ታራ ጋሄታና መላ ኦዳ ዎስ። <verse eid="1SA 21:2"/><verse number="3" style="v" sid="1SA 21:3"/>ሀእ ነ ኩሸን አይብ ደኢ? እቻሹ ኡይ ዎይኮ ነዉ ደእያባ ታዉ እማ” ያግስ።<verse eid="1SA 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 21:4"/>ካህነይ ዛሪድ፥ “ጮ አስ ምያ ኡይ ታዉ ባዋ፤ ሽን ነ አሳት ባንታና ማጫሳፐ ናግዳባ ግድኮ፥ ኤንቲ ማናዉ ዳንዳእያ ጌሻ ኡይ ደኤስ” ያግስ።<verse eid="1SA 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 21:5"/>ዳዊተይ ዛሪድ፥ “ቱማ ኑኒ ሀ ኪታ ኤክድ ከይዳፐ ዶምድ፥ ማጫሳፐ ናገትዳ፤ ሀር አቶሽን ሀራ ኪታካ ኤክድ ከይያ ዎደ ኤንቲ ባንታ ጌሻተ ናጎሶና። ሽን ሀች ዋንድ ጌያናዉ ኮሸኔ?” ያግስ። <verse eid="1SA 21:5"/><verse number="6" style="v" sid="1SA 21:6"/>ሄሳ ግሾ፥ ካህነይ ዳዊታስ ጌሻ ኡይ እሚስ። ካህንያስ ደእያ ኡይይ፥ ጎዳ ስንን ዎናዉ ሄ ጋላስ ሆኦ ኡይራ ላመትዳ ኡይፈ አትሽን፥ ሀር ባዋ።<verse eid="1SA 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 21:7"/>ሳኦላ አይለታፐ እሶይ፥ እያ መህያ ሄመይሳታ ሀላቃይ፥ ዶይቃ ጌተትያ ኤዶመ አደይ፥ ሄ ጋላስ ጎዳ ስንን ናግሸ ደኤስ።<verse eid="1SA 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 21:8"/>ዳዊቲ አብመለከኮ፥ “ቶር ዎይኮ ማሽ ነዉ ዳንዴሻ? ካዋ ኪታይ ኤሶያ ግሾ ታኒ ታ ማሻ ዎይኮ ሀራ ኦላ ሚሸ ኤሀብከ” ያግድ ኦይችስ።<verse eid="1SA 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 21:9"/>አብመለከይ፥ “ኔኒ ኤላ ዛንጋራን ዎዳ ፍልስፄመ አድያ ጎልያዳ ማሻይ ሀይሳን ደኤስ፤ ጩርቃራ ፃፀትድ፥ ኤፉደ ማኡዋፐ ጉየ ባጋራ ደኤስ። ኔኒ ኮያባ ግድኮ እያ ኤካ፤ እያፐ አትሽን፥ ሀራ ማሽ ሀይሳን ባዋ” ያግስ።</para>
  <para style="p" vid="1SA 21:9">ዳዊቲ፥ “እያ መላ ማሽ ባዋ፤ እያ ታዉ ሀማ” ያግስ።<verse eid="1SA 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 21:10"/>ሄ ጋላስ ዳዊቲ ሳኦላፐ ባቃትድ፥ ጋተ ካዋ አንኩሳኮ ብስ። <verse eid="1SA 21:10"/><verse number="11" style="v" sid="1SA 21:11"/>ሽን አንኩሳ ሞርናት፥ “ሀይስ ዳዊቲ ባ ቢታን ካዎ ግደኔ? ማጫሳይ የፅሸነ ዱርሸ፥ ‘ሳኦል ሙኩሉ ዎስ፤ ዳዊቲ ታሙ ሙኩሉ ዎስ’ ያግድ ሳቢዳ አድያ ግደኔ?” ያግዶሶና።<verse eid="1SA 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 21:12"/>ዳዊቲ ኤንታ ሃሳያ ባ ዎዛናን ስእድ፥ ጋተ ካዋ አንኩሳ ዳሮ ያይስ። <verse eid="1SA 21:12"/><verse number="13" style="v" sid="1SA 21:13"/>ሄሳ ግሾ፥ ዳዊቲ ኤንታ ስንን ጎሹ ዳንስ። ኤንቲ እያ ኦይካና ሀንያ ዎደ ጎሻዳ ፐንገ እብ ቃጨ ኦይክስ፤ ቡቻራ ሳሶ ቆልስ። <verse eid="1SA 21:13"/><verse number="14" style="v" sid="1SA 21:14"/>አንኩስ ባ ኦሳንቾታኮ፥ “ሄኮ፥ ሀ አደይ ጎዬስ፤ ህንተ አይስ እያ ታኮ ኤህደቲ? <verse eid="1SA 21:14"/><verse number="15" style="v" sid="1SA 21:15"/>ሀ አደይ ታ ስንን ጎያናዳ ህንተ ኤህዳይ፥ ታ ማታን ሀር ጎየይ ይነዬ? ሀ አደይ ታ ሶ ገላናዉ በሲ?” ያግስ።<verse eid="1SA 21:15"/></para>
  <chapter eid="1SA 21"/>
  <chapter number="22" style="c" sid="1SA 22"/>
  <para style="s1">ዳዊቲ አዱላማንነ ምፅጳን</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 22:1"/>ዳዊቲ ጋተፐ ባቃትድ፥ አዱላማ ማታን ደእያ ጎንጎሉዋ ብስ። እያ እሻትነ እያ አዋ ሶ አሳ ኡባይ ሄሳ ስእዳ ዎደ ያ እያኮ ብዶሶና። <verse eid="1SA 22:1"/><verse number="2" style="v" sid="1SA 22:2"/>መቶትዳይ፥ አጮትዳይነ ሳእ ኢትዳ ኡባይ ዳዊታኮ ሺቅን፥ ኤንታ ታይቦይ ኦይዱ ፄቱ ግድስ፤ እ ኤንታ ሀላቃ ግድስ።<verse eid="1SA 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 22:3"/>ዳዊቲ ያፐ ደንድድ ሞአበን ደእያ ምፅጳ ብድ ሞአበ ካዋ፥ “ፆሳይ ታዉ ኦናባ ታ ኤራና ጋካናዉ ታ አዋነ አይዉ ነ ማታን ዎርክ” ያግድ ዎስስ። <verse eid="1SA 22:3"/><verse number="4" style="v" sid="1SA 22:4"/>ዳዊቲ ኤንታ ሞአበ ካዋ ማታን ዎስ፤ ዳዊቲ ቆሰትዳ በሳን ደእያ ዎደ ኡባን ኤንቲ ካዋ ማታን ደእዶሶና።<verse eid="1SA 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 22:5"/>ሄሳፈ ጉየ፥ ናበይ ጋድ ዳዊታኮ ይድ፥ “ቆሰትዳ በሳን ጋምኦፋ፤ ሀይሳፈ ደንዳዳ ይሁዳ ቢታ ባ” ያግስ፤ ዳዊቲ ያፐ ከይድ ሄረታ ዎራ ብስ።<verse eid="1SA 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 22:6"/>ዳዊቲነ እያ አሳይ በንትዳይሳ ሳኦል ስእስ። ሳኦል ግብአ ማታን ደእያ ደረ ቦላ፥ ታማርስከ ም ጋርሳን ቶራ ኦይክድ ኡትስ፤ እያ ሞርናት እያ ዩሹዋን ኤቅዶሶና። <verse eid="1SA 22:6"/><verse number="7" style="v" sid="1SA 22:7"/>ሳኦል ኤንታኮ፥ “ህንተኖ፥ ብንያመ አሳዉ፥ ስእተ፤ እሰየ ናአይ ጋደነ ዎይነ ቶክያ በሲ ህንተ ኡባስ እማኔ? ሻላቃታነ ማቶ ሀላቃታ ኦድ ህንተና ሹማኔ? <verse eid="1SA 22:7"/><verse number="8" style="v" sid="1SA 22:8"/>ህንተ ኡባይ ታ ቦላ ማቀትደታ፤ ታ ናአይ እሰየ ናኣራ ጫቅዳባ ታዉ ኦንካ ኦድቤና። ህንተፈ እስ አስካ ታዉ ቃተና፤ ሀች ሀንዳይሳዳ ታ ናአይ ታ አይልያን ታና ዎሳናዉ ደንዳይሳ ታዉ ኦንካ ኦድቤና” ያግስ።<verse eid="1SA 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 22:9"/>ሳኦላ ሞርናታራ ኤቅዳ ኤዶመ አደይ ዶይቅ፥ “እሰየ ናአይ አክፁባ ናኣ አብመለከኮ ኖባ ብዳይሳ ታኒ በአስ። <verse eid="1SA 22:9"/><verse number="10" style="v" sid="1SA 22:10"/>ዳዊቲ አይ ኦነኮ አብመለከይ ጎዳ ኦይችስ፤ ያትድ ዳዊታስ ሽንቀነ ፍልስፄመ አድያ ጎልያዳ ማሻ እያዉ እሚስ” ያግድ ሳኦላስ ኦድስ።<verse eid="1SA 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 22:11"/>ሄሳፈ ጉየ፥ አክፁባ ናኣ ካህንያ አብመለከነ ኖባን ካህነ ግድድ ደእያ እያ አዋ ሶ አሳ ኡባ ካዎይ ፄግስን፥ ኤንቲ ካዋኮ ይዶሶና። <verse eid="1SA 22:11"/><verse number="12" style="v" sid="1SA 22:12"/>ሳኦል፥ “አክፁባ ናአዉ፥ ስአ” ያግስ።</para>
  <para style="p" vid="1SA 22:12">አብመለከይ፥ “ኤሮ ታ ጎዳዉ” ያግስ።<verse eid="1SA 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 22:13"/>ሳኦል፥ “ኔራ እሰየ ናኣራ ታ ቦላ አይስ ማቀትደቲ? ኔኒ እያዉ ኡይነ ማሸ እማዳ፥ እ ታና ዎናዉ ደንዳና መላ እያ ግሾ ፆሳ አይስ ኦይቻዲ?” ያግስ።<verse eid="1SA 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 22:14"/>አብመለከይ፥ “ነ ኦሳንቾታ ኡባ ግዶን ዳዊቲ መላ አማነተይ፥ ካዋ ቦሎይ፥ ነና ናገይሳታ ኪተይነ ነ ሶ አሳ ግዶን ዳሮ ቦንቸተይ እያ መል ኦኔ? <verse eid="1SA 22:14"/><verse number="15" style="v" sid="1SA 22:15"/>ታኒ እያ ግሾ ፆሳ ኦይችሽን፥ ሀይስ ታዉ ኮይሮ? ግደና፥ ካዋዉ፥ ታና ነ አይልያ ዎይኮ ታ አዋ ሶ አሳ ኡባ አይኮካ ሞቶፓ። ታኒ ነ አይለይ ሀ ኦዳባ ጉ ግድን ዎይኮ ግታ ግድን ኤርከ” ያግስ።<verse eid="1SA 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 22:16"/>ካዎይ፥ “አብመለከ፥ ነነ ነ አዋ ሶ አሳ ኡባይ ሀይቃና” ያግስ። <verse eid="1SA 22:16"/><verse number="17" style="v" sid="1SA 22:17"/>ሳኦል ባ ማታን ኤቅድ ናገይሳታ፥ “ጎዳ ካህነታ ዎተ፤ ኤንቲ ዳዊታ ማድዶሶና። ዳዊቲ ባቃትዳይሳ ኤርሸ ታዉ ኦድቦኮና” ያግስ። ሽን ካዋ ናገይሳት ጎዳ ካህነታ ቦላ ባንታ ኩሽያ ደንና እፅዶሶና።<verse eid="1SA 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 22:18"/>ካዎይ ዶይቃ፥ “ኤንታ ነ ዎ” ያግድ ኪትስ። ኤዶመ አደይ ዶይቅ ካህነታ ሾጭድ፥ ሄ ጋላስ ኤፉደ ማእዳ ሆስፑን ታማነ እቻሹ ካህነታ ዎስ። <verse eid="1SA 22:18"/><verse number="19" style="v" sid="1SA 22:19"/>ቃስ ዶይቅ ካህነታ ካታማ፥ ኖባ ማሻን ዉርስስ፤ ሄ ካታማን ደእያ አደነ ማጫ፥ ናይታነ ዮጋ ናይታ፥ መሄታ፥ ሀረታነ ዶርሳታ ማሻን ዎስ።<verse eid="1SA 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 22:20"/>ሽን አክፁባ ናኣ አብመለከ ናይታፐ አብያታራ ጌተትያ እስ ናአይ ከስ ኤክድ፥ ዳዊታኮ ባቃትስ። <verse eid="1SA 22:20"/><verse number="21" style="v" sid="1SA 22:21"/>እ፥ ሳኦል ጎዳ ካህነታ ዎዳይሳ ዳዊታስ ኦድስ። <verse eid="1SA 22:21"/><verse number="22" style="v" sid="1SA 22:22"/>ዳዊቲ አብያታራ፥ “ኤዶመ አደይ ዶይቅ ሄ በሳን ደኤይሳ ታኒ በእዳ ዎደ እ ሳኦላስ ኦዳናይሳ ሄ ጋላስ ኤራስ። ነ አዋ ሶ አሳ ኡባ ሀይቆስ ጋዳይ ታና። <verse eid="1SA 22:22"/><verse number="23" style="v" sid="1SA 22:23"/>ህዛ ኔኒ ታራ ደአ፤ ያዮፋ። ነና ዎናዉ ኮይያ ኡራይ ታና ዎናዉ ኮዬስ፤ ኔኒ ታ ማታን ሳሮ ዳና” ያግስ።<verse eid="1SA 22:23"/></para>
  <chapter eid="1SA 22"/>
  <chapter number="23" style="c" sid="1SA 23"/>
  <para style="s1">ዳዊቲ ቃእላ አሽስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 23:1"/>ፍልስፄመት ቃእላ ኦልድ፥ ዉዱማን ደእያ ካ ቦንቅዳይሳ ዳዊቲ ስእስ።<verse eid="1SA 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 23:2"/>ዳዊቲ፥ “ታኒ ባዳ ፍልስፄመታ ኦሎ?” ያግድ ጎዳ ኦይችስ።</para>
  <para style="p" vid="1SA 23:2">ጎዳይ፥ “ባ፤ ፍልስፄመታ ኦላ፤ ቃእላ አሻ” ያግስ።<verse eid="1SA 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 23:3"/>ሽን ዳዊታ ካለይሳት፥ “ኑኒ ሀይሳን ይሁዳ ቢታን ደእሸ ዳሮባን ያዮስ። ፍልስፄመታራ ኦለታናዉ ቃእላ ኑ ቢኮ ኑና ኡባ ሳእ መታና” ያግዶሶና።<verse eid="1SA 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 23:4"/>ዳዊቲ ዛሪድ ጎዳ ኦይችን ጎዳይ፥ “ፍልስፄመታ ታኒ ነዉ አ እማና፤ ደንዳዳ ቃእላ ባ” ያግስ። <verse eid="1SA 23:4"/><verse number="5" style="v" sid="1SA 23:5"/>ዳዊቲነ እያ ካለይሳት ቃእላ ብድ፥ ፍልስፄመታራ ኦለትድ ኤንታ መህያ ድእዶሶና። ኤንታፈ ዳሮ አሳ ዎድ፥ ዳዊቲ ቃእላ አሳ አሽስ።<verse eid="1SA 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 23:6"/>አብመለከ ናአይ አብያታር ዳዊታኮ ቃእላ ባቃትዳ ዎደ ኤፉደ ማኡዋ ኤክድ ብስ።<verse eid="1SA 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 23:7"/>ዳዊቲ ቃእላ ብዳይሳ ሳኦል ስእድ፥ “ፆሳይ ዳዊታ ታ ኩሸን አድ እሚስ፤ ዳዊቲ ግምበን ድረትዳ ካታማ ገልድ ባና ባዉ ቃችስ” ያግስ። <verse eid="1SA 23:7"/><verse number="8" style="v" sid="1SA 23:8"/>ቃእላ ብድ፥ ዳዊቲነ እያ አሳ ተቃና መላ ሳኦል ባ ኦላንቾታ ኡባ ፄግስ።<verse eid="1SA 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 23:9"/>ሳኦል ባ ቦላ ኢታባ ኦናዉ ማቅዳይሳ ዳዊቲ ኤርድ ካህንያ አብያታራኮ፥ “ኤፉድያ ሃ ኤካ ያ” ያግስ። <verse eid="1SA 23:9"/><verse number="10" style="v" sid="1SA 23:10"/>ዳዊቲ፥ “አቤት ጎዳዉ፥ እስራኤለ ፆሳዉ፥ ታ ጋሶን ሳኦል ቃእላ ይሳናዉ ማቅዳይሳ ታኒ ነ አይለይ ስአስ። <verse eid="1SA 23:10"/><verse number="11" style="v" sid="1SA 23:11"/>ቃእላ አሳይ ታና ሳኦላስ አድ እማነሻ? ታኒ ነ አይለይ ስእዳይሳዳ ሳኦል ቱማካ ሃ ያነሻ? አቤት ጎዳዉ፥ እስራኤለ ፆሳዉ፥ ታዉ ነ አይልያስ ኦዳ” ያግስ።</para>
  <para style="p" vid="1SA 23:11">ጎዳይ ዳዊታኮ፥ “ኤ፤ ሳኦል ያና” ያግድ ዛርስ።<verse eid="1SA 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 23:12"/>ዳዊቲ፥ “ቃእላ አሳይ ታናነ ታ አሳ ሳኦላስ አድ እማነሻ?” ያግድ ዛሪድ ጎዳ ኦይችስ።</para>
  <para style="p" vid="1SA 23:12">ጎዳይ፥ “ኤ፤ ኤንቲ ህንተና አድ እማና” ያግስ። <verse eid="1SA 23:12"/><verse number="13" style="v" sid="1SA 23:13"/>ዳዊቲነ ኡሱፑን ፄቱ ግድያ አደት ቃእላፐ ከይድ፥ እስ በሳፈ ሀራ በሲ ዩይዶሶና። ዳዊቲ ቃእላፐ ባቃትዳይሳ ሳኦል ስእዳ ዎደ ባናዉ ቆፕዳይሳ አጋግስ።<verse eid="1SA 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 23:14"/>ዳዊቲ ባዞ ሚፃታንነ ዚፋ መላ ቢታን ደእያ ዙማታ ቦላ ደእስ። ሳኦል እያ ደማናዉ ኡባ ጋላስ ኮዬስ፥ ሽን ፆሳይ እያ ሳኦላ ኩሸን አድ እምቤና። <verse eid="1SA 23:14"/><verse number="15" style="v" sid="1SA 23:15"/>ዳዊቲ ዚፋ መላ ቢታን ደእያ ሆረሳን ደእሽን፥ ሳኦል እያ ዎናዉ ከይዳይሳ ዳዊቲ ኤርስ። <verse eid="1SA 23:15"/><verse number="16" style="v" sid="1SA 23:16"/>ሳኦላ ናኣ ዮናታን ደንድድ፥ ዳዊታኮ ሆረሳ ብድ ዳዊቲ ጎዳ ዎልቃን ምናናዳ ዞርድ፥ <verse eid="1SA 23:16"/><verse number="17" style="v" sid="1SA 23:17"/>“ያዮፋ፤ ታ አዋ ሳኦል ነና ኩሸራካ ቦቸና፤ ኔኒ እስራኤለ ቦላ ካዎታና፤ ታንካ ኔፐ ጋርሳራ ሃራና፤ ታ አዋይ ሳኦል ሄሳ ሎይድ ኤሬስ” ያግስ። <verse eid="1SA 23:17"/><verse number="18" style="v" sid="1SA 23:18"/>ኤንቲ ናምአይ ጎዳ ስንን እሶይ እሱዋራ ጫቅዶሶና፤ ዳዊቲ ሆረሳን ጋምእን ዮናታን ባ ሶ ብስ።<verse eid="1SA 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 23:19"/>ዚፋ አሳይ ሳኦላኮ ግብአ ብድ፥ “ዳዊቲ ያስሞናፐ ዱገሀ ባጋን፥ ሀክላ ዙማ ቦላ ሆረሳ ሚፃታን ኑ ማታን ቆሰትድ ደኤስ። <verse eid="1SA 23:19"/><verse number="20" style="v" sid="1SA 23:20"/>ካዋዉ፥ ሀእካ ነ ዶስዳ ዎደ ዱገ ዎ፤ ኑኒ እያ ነ ኩሸን አድ እማና” ያግዶሶና።<verse eid="1SA 23:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 23:21"/>ሳኦል፥ “ህንተ ታዉ ቆፕዳ ግሾ ህንተና ጎዳይ አንጆ። <verse eid="1SA 23:21"/><verse number="22" style="v" sid="1SA 23:22"/>ብድ አነ ጉጅድካ ጌሽተ፤ ዳዊቲ ዳሮ ቶሆ አዉ ብያኮካ ኦን እያ በእዳኮ፥ ሻክድ ኤርተ፤ እ ገነ አስ ግደይሳ ታ ስአስ። <verse eid="1SA 23:22"/><verse number="23" style="v" sid="1SA 23:23"/>ዳዊቲ ቆሰትያ በሳታ ኡባ በእድ፥ ሙሩታ ኦዳ ኤክድ ታኮ ስሚድ ዪተ። ሄሳፈ ጉየ፥ ታኒ ህንተራ ባና፤ እ ሄ ሄራን ደእኮ፥ ታኒ እያ ይሁዳ ቢታ ኡባን ደማና ጋካናዉ ኮያና” ያግስ።<verse eid="1SA 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 23:24"/>ሄሳ ግሾ፥ ኤንቲ ሳኦላፐ ስንትድ ዚፋ ብዶሶና። ሄ ዎደ ዳዊቲነ እያ አሳይ ያስሞናፐ ዱገሀ ባጋራ ደእያ ማኦና መላ ቢታን አራባ ጋን ደኦሶና። <verse eid="1SA 23:24"/><verse number="25" style="v" sid="1SA 23:25"/>ሳኦልነ እያ አሳይ ዳዊታ ኮያናዉ ብዶሶና። ዳዊቲ ሄሳ ስእዳ ዎደ ዛላኮ ዎድ፥ ማኦና ባዙዋን ኡትስ። ሳኦል ሄሳ ስእዳ ዎደ ማኦና ባዙዋን ዳዊታ ኮይሸ ብስ። <verse eid="1SA 23:25"/><verse number="26" style="v" sid="1SA 23:26"/>ሳኦል ዙማፐ እስ ባጋ ምይያራ ቤስ፤ ዳዊቲነ እያ አሳይ ሀንኮ ባጋ ምይያራ ቦሶና። ኤንቲ ሳኦላፐ ባቃታናዉ ኤሶቶሶና፤ ሳኦልነ እያ አሳት፥ ዳዊቲነ እያ አሳታ ኦይካናዉ ማት ኡትዶሶና። <verse eid="1SA 23:26"/><verse number="27" style="v" sid="1SA 23:27"/>ሽን፥ “ኤለሳዳ ሃያ፤ ፍልስፄመት ኑ ቢታ ኦላናዉ ይዶሶና” ግያ ሀራ ኪት ሳኦላ ጋክስ። <verse eid="1SA 23:27"/><verse number="28" style="v" sid="1SA 23:28"/>ሳኦል ዳዊታ ኮየይሳ አግድ፥ ፍልስፄመታራ ኦለታናዉ ብስ። ሄሳ ግሾ፥ ሄ በሳይ “ከስ ኤክድ አትያ ዛላ” ጌተትስ። <verse eid="1SA 23:28"/><verse number="29" style="v" sid="1SA 23:29"/>ዳዊቲ ሄ በሳፈ ከይድ፥ ኤንጋዳ ማታን ደእያ ሚፃታን ኡትስ።<verse eid="1SA 23:29"/></para>
  <chapter eid="1SA 23"/>
  <chapter number="24" style="c" sid="1SA 24"/>
  <para style="s1">ዳዊቲ ሳኦላ ዎና አግስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 24:1"/>ሳኦል ፍልስፄመታ ኦልድ ስምዳፐ ጉየ፥ ዳዊቲ ኤንጋዳ ባዙዋን ደኤስ ገይሳ ስእስ። <verse eid="1SA 24:1"/><verse number="2" style="v" sid="1SA 24:2"/>ሳኦል እስራኤለ ግዶፈ ዶረትዳ ሄ ሙኩሉ አሳ ኤክድ፥ ዳዊታነ እያ አሳ ኮያናዉ፥ “ባዞ ዴሻታ ዛላ” ጌተትያ በሳ ማታ ብስ።<verse eid="1SA 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 24:3"/>ሳኦል ኦግያ ዶናን ዶርሳ ግርብያ ማታን ደእያ ጎንጎሉዋ ግዶ ገልድ ሼአናዉ ኡትስ። ዳዊቲነ እያ አሳይ ጎንጎሉዋስ ጉየ ባጋራ ሺቅድ ኡትዶሶና። <verse eid="1SA 24:3"/><verse number="4" style="v" sid="1SA 24:4"/>ዳዊታ አሳይ፥ “ ‘ሄኮ፥ ታኒ ነ ሞርክያ ነ ኩሸን አ እማና፤ ኔኒ እያ ቦላ ኮይዳባ ኦና’ ያግድ ጎዳይ ነዉ ኦድዳ ጋላሳይ ሀች” ያግዶሶና። ዳዊቲ ሳኦላ ኤርሶና ሺቅድ ሳኦላ ማኡዋ ማጫራፐ ቃንፅ ኤክስ።<verse eid="1SA 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 24:5"/>ዳዊቲ ሳኦላ ማኡዋ ማጫራ ቃንፅዳ ግሾ እያ ዎዛናይ ቂሮትስ። <verse eid="1SA 24:5"/><verse number="6" style="v" sid="1SA 24:6"/>ዳዊቲ ባ አሳኮ፥ “ጎዳይ ትይዳ ካዋ፥ ታ ጎዳ ቦላ ታኒ ሄሳ ኦናይስ ዎይኮ እያ ቦላ ታ ኩሽያ ደንናይስ ታፐ ሃኮ፤ ጎዳይ ትይድ እያ ካዎስ” ያግስ። <verse eid="1SA 24:6"/><verse number="7" style="v" sid="1SA 24:7"/>ዳዊቲ ሀይሳዳ ግድ፥ ሳኦላ ባ አሳን ቦሽሶና ድግስ። ሳኦል ጎንጎሉዋ ግዶፈ ከይድ ባ ኦግያ ብስ።<verse eid="1SA 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 24:8"/>ሳኦል ብዳፐ ጉየ፥ ዳዊቲ ጎንጎሉዋ ግዶፈ ከይድ፥ “ታ ጎዳዉ፥ ካዋዉ” ያግድ ሳኦላ ፄግን፥ ሳኦል ጉየ ስሚድ ፄልስ። ዳዊቲ ሳአን ጉፋንድ ሳኦላስ ዝግስ። <verse eid="1SA 24:8"/><verse number="9" style="v" sid="1SA 24:9"/>ዳዊቲ ሳኦላኮ፥ “ዳዊቲ ነና ቆሀናዉ ኮዬስ” ግያ አሳ ኔኒ አይስ ስአይ? <verse eid="1SA 24:9"/><verse number="10" style="v" sid="1SA 24:10"/>ሀች ሀ ጎንጎሉዋን ጎዳይ ነና ታዉ አድ እምዳይሳ ኔኒ ነ አይፈን በአዳሳ። ታኒ ነና ዎና መላ ጉ አሳት ታና ደንዶሶና። ሽን፥ “እ፥ ጎዳይ ትይድ ካዎዳይሳ ግድያ ግሾ ታኒ ታ ጎዳ ቦላ ታ ኩሽያ ደንከ” ያጋዳ ነና አጋስ። <verse eid="1SA 24:10"/><verse number="11" style="v" sid="1SA 24:11"/>ታ አዋዉ፥ ታ ኩሸን ደእያ ነ ማኡዋ ማጫራ ሀይሳ ፄላ። ነ ማኡዋ ማጫራፐ ቃንፃ ኤካስ፥ ሽን ነና ዎብከ። ታኒ ነና ቆሆናይሳነ ነ ቦላ ማካሎናይሳ አኬካ፤ ታኒ ነና ቆሀብከ፥ ሽን ኔኒ ታና ዎናዉ ሻንካታሳ። <verse eid="1SA 24:11"/><verse number="12" style="v" sid="1SA 24:12"/>ነባነ ታባ ጎዳይ ፕርዶ፤ ጎዳይ ኔኒ ታና ቆህዳይሳ ሃሉዋ ከሶ፥ ሽን ታኒ ነ ቦላ ታ ኩሽያ ደንከ። <verse eid="1SA 24:12"/><verse number="13" style="v" sid="1SA 24:13"/>“ኢታ ኦይሳታፐ ኢት ከዬስ” ግያ በን ሌምሶይ ደኤስ። ሄሳ ግሾ፥ ታኒ ነና ኩሸንካ ቦችከ።<verse eid="1SA 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 24:14"/>“እስራኤለ ካዎይ ኦደ ቦላ ደንዲ? ኦና ኦይካናዉ ካሊ? ሀይቅዳ ካና ዎይኮ ካስቶለ ጎድዬ? <verse eid="1SA 24:14"/><verse number="15" style="v" sid="1SA 24:15"/>ጎዳይ ኑ ቦላ ዳናቶ፤ ነባነ ታባ እ ፕርዶ፤ ታ ግሾ እ ሞተቶ፤ ነ ኩሸፐ ታና እ አሾ” ያግስ።<verse eid="1SA 24:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 24:16"/>ዳዊቲ ሃሳያ ዉርስዳ ዎደ ሳኦል ዳዊታኮ፥ “ታ ናአ ዳዊታ፥ ሄስ ነ ቃሌ?” ያግድ ሳኦል ባ ቃላ ቁ ኦድ ዬክስ።<verse eid="1SA 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 24:17"/>“ኔኒ ታፐ አዳ ፅሎ፤ ታኒ ነዉ ኢታባ ኦን፥ ኔኒ ታዉ ሎኦባ ኦዳሳ። <verse eid="1SA 24:17"/><verse number="18" style="v" sid="1SA 24:18"/>ጎዳይ ታና ሀች ነዉ አድ እምን ኔኒ ታና ዎቦና ግሾ ኔኒ ታዉ ሎኦባ ኦዳ በሳዳሳ። <verse eid="1SA 24:18"/><verse number="19" style="v" sid="1SA 24:19"/>አስ ባ ሞርከ ደምድ ቆሆና የድዬ? ኔኒ ታዉ ሀች ኦዳ ኬሀተ ግሾ፥ ጎዳይ ነና አንጆ። <verse eid="1SA 24:19"/><verse number="20" style="v" sid="1SA 24:20"/>ኔኒ እስራኤሌ ካዎ ግዳናይሳነ እስራኤለ ካዎተይ ነ ማታ ጋርሳን ኤቃናይሳ ታ ኤራይስ። <verse eid="1SA 24:20"/><verse number="21" style="v" sid="1SA 24:21"/>ህዛ ታ ኮቻ ይሶና መላነ ታ ሱን ታ አዋ ሶ አሳ ግዶፈ ቁቾና መላ ጎዳ ሱንን ታዉ ጫቃ” ያግስ።<verse eid="1SA 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 24:22"/>ዳዊቲ ሳኦላስ ጫቅስ። ሄሳፈ ጉየ፥ ሳኦል ባ ሶ ስሚድ ብስ፤ ዳዊቲነ እያ አሳይ ባንታ ሚፃ ብዶሶና።<verse eid="1SA 24:22"/></para>
  <chapter eid="1SA 24"/>
  <chapter number="25" style="c" sid="1SA 25"/>
  <para style="s1">ዳዊታ ፥ ናባላነ አብግያ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 25:1"/>ሳሜል ሀይቅን፥ እስራኤለ አሳ ኡባይ ሺቅድ፥ እያዉ ዬክዶሶና፤ ራማ ካታማን እያ ሞግዶሶና።</para>
  <para style="p" vid="1SA 25:1">ሄሳፈ ጉየ፥ ዳዊቲ ማኦና መላ ቢታ ብስ። <verse eid="1SA 25:1"/><verse number="2" style="v" sid="1SA 25:2"/>ማኦና መላ ቢታን፥ ቃርመሎሳን ሻሎይ ደእያ እስ ዱረ አደይ ደኤስ። እያዉ እስ ሙኩሉ ዴሻትነ ሄ ሙኩሉ ዶርሳት ደኦሶና። እ ኤንታ እክስያ ቃርመሎሳን ሜዴስ። <verse eid="1SA 25:2"/><verse number="3" style="v" sid="1SA 25:3"/>ሄ አድያ ሱንይ ናባላ፥ እ ካለባ ያራ፤ እያ ማቸ ሱንይ አብግያ። እያ አኬካንቾነ ማላ ሎኦ ማጫስ፥ ሽን እ አዝናይ ዎዛን ባይና ኢታ አስ።<verse eid="1SA 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 25:4"/>ዳዊቲ መላ ቢታን ደእሸ፥ ናባል ዶርሳ እክሰ ሜደይሳ ስእስ። <verse eid="1SA 25:4"/><verse number="5" style="v" sid="1SA 25:5"/>ዳዊቲ ታሙ ፓንታ ሀይሳዳ ያግድ ኪትስ፤ “ናባላኮ ቃርመሎሳ ብድ፥ ታ ሱንን እያ ሳሮተ። <verse eid="1SA 25:5"/><verse number="6" style="v" sid="1SA 25:6"/>‘ነ ባረይ አዱቆ! ሳሮይ ነዉነ ነ ሶ አሳስ ግዶ፤ ነዉ ደእያ ኡባስ ሳሮይ ግዶ! <verse eid="1SA 25:6"/><verse number="7" style="v" sid="1SA 25:7"/>ነ ዶርሳ እክሰ ሜደይሳ ታኒ ስአስ፤ ነ ዶርሳ ሄመይሳት ኑራ ደእዳ ዎደ ኑኒ ኤንታ ገንቦኮ፤ ኤንቲ ቃርመሎሳን ደእዳ ዎደ ኡባን ኤንታባፐ አይብካ ፓጭቤና። <verse eid="1SA 25:7"/><verse number="8" style="v" sid="1SA 25:8"/>ሄሳ ኔኒ ነ አይለታ ኦይችኮ ኤንቲ ነዉ ኦዳና። ኑኒ ሀች ግብራ ጋላስ ኔኮ ይዳ ግሾ፥ ታ ፓንታስ ሀያና ኬሀ። ነ ኩሸን ደእያባፐ ነ አይለታስነ ነ ናኣ ዳዊታስ ሀያና እማ’ ያግተ” ያግድ ኪትስ።<verse eid="1SA 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 25:9"/>ዳዊታ አሳት ናባላኮ ጋክድ፥ ዳዊታ ሱንነ ኪታ እያዉ ኦድድ፥ እ ጋናባ ናግሸ ያን ኡትዶሶና።<verse eid="1SA 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 25:10"/>ናባል፥ “ዳዊቲ ኦኔ? እሰየ ናአይ ኦኔ? ሀ ዎድያን ዳሮ አይለት ባንታ ጎዳታፐ ባቃቶሶና። <verse eid="1SA 25:10"/><verse number="11" style="v" sid="1SA 25:11"/>ታ ካ፥ ታ ሃነ ታ ዶርሳታ ሜደይሳታስ ሹከትዳ አሹዋ ኤካዳ፥ ጉዬይ ኤረቶና አሳስ አይስ እሞ?” ያግስ።<verse eid="1SA 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 25:12"/>ዳዊቲ አሳት ጉየ ስም ብድ ናባል ግዳባ ኡባ ዳዊታስ ኦድዶሶና። <verse eid="1SA 25:12"/><verse number="13" style="v" sid="1SA 25:13"/>ዳዊቲ፥ “ህንተ ማሻ ዳንጭተ” ያግን፥ ኡባይ ባንታ ማሻ ዳንጭዶሶና፤ ዳዊቲካ ባ ማሻ ዳንጭስ። ዳዊቲ ኦይዱ ፄቱ ግድያ አሳታራ ደንድድ ብስ፤ ናምኡ ፄቱ አሳይ ኤንታባ ናግድ አትስ።<verse eid="1SA 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 25:14"/>ናባላ አይለታፐ እሶይ ናባላ ማቸ አብግያኮ ሀይሳዳ ያግስ፤ “ዳዊቲ መላ ቢታን ደእሸ ኑ ጎዳ ሳሮ ጋናዉ አሰ ኪትስ፥ ሽን እ ኤንታ ጫይድ የድስ። <verse eid="1SA 25:14"/><verse number="15" style="v" sid="1SA 25:15"/>ግዶሽን፥ ሀ አሳት ኑስ ዳሮ ሎኦ፤ ኤንቲ ኑና ገንቦኮና፤ ኑኒ ኤንታራ ባዞን ፔእዳ ዎደ ኡባን ኑባፐ አይኮይካ ፓጭቤና። <verse eid="1SA 25:15"/><verse number="16" style="v" sid="1SA 25:16"/>ኑኒ ኑ ዶርሳ ዉድያ ኤንታ ማታን ሄምያ ዎደ፥ ቃማነ ጋላስ ኤንቲ ኑስ ድርስ ግድዶሶና። <verse eid="1SA 25:16"/><verse number="17" style="v" sid="1SA 25:17"/>ኑ ጎዳ ቦላነ እያ ሶ አሳ ቦላ ኢታባይ ጋካና ሀንያ ግሾ፥ ሀያና ሀ ኦዳ ዋታነኮ ቆፓ። ኑ ጎዳይ አሳ ዞረ ስኦና ኢታ አስ ግድያ ግሾ፥ ኦንካ እያ ሃሳይሳናዉ ዳንዳኤና” ያግስ።<verse eid="1SA 25:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 25:18"/>አብግያ ኤሶን ናምኡ ፄቱ ኡይ፥ ናምኡ ኦጎሮ ዎይነ ኡሹ፥ እቻሹ ጫጨትዳ ዶርሳታ፥ እሻታሙ ክሎ ግራመ ጫጨትዳ ትያ፥ እስ ፄቱ ኡከትዳ ዎይነ ሞርኤነ ናምኡ ፄቱ ባላሰ ኑካ ኤካዳ ሀረታ ቦላ ጫናሱ። <verse eid="1SA 25:18"/><verse number="19" style="v" sid="1SA 25:19"/>ባ አይለታኮ፥ “ህንተ ስንትድ ቢተ፤ ታ ህንተና ካላና” ያጋሱ፤ ሽን ባ አዝና ናባላስ አይኮካ ኦዳቡኩ። <verse eid="1SA 25:19"/><verse number="20" style="v" sid="1SA 25:20"/>ባ ሀርያ ቶጋዳ ዙማ ሎቡዋ ዱገ ዎያ ዎደ ዳዊቲነ እያ አሳይ ይሸ ኢራ ጋሄትዶሶና።<verse eid="1SA 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 25:21"/>ዳዊቲ፥ “እያባፐ አይኮይካ ፓጮና መላ ታኒ ሀ አድያ ሻሉዋ ናግዳይ ጮ መላ፤ ታኒ ኦዳ ሎኦ ኦሱዋስ እ ታዉ ኢታ ኩሸ ዛርስ። <verse eid="1SA 25:21"/><verse number="22" style="v" sid="1SA 25:22"/>ዎንቶ ዎንታ ጋካናዉ፥ እያባ ግድዳ አደታፐ እሱዋ ታ ፓፃ አግኮ፥ ፆሲ ታና ፕርዶ” ያግስ።<verse eid="1SA 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 25:23"/>አብግያ ዳዊታ በእዳ ዎደ ሀርያፐ ኤሶታ ዎዳ፥ ዳዊታ ስንን ጉፋናዳ ዝጋሱ። <verse eid="1SA 25:23"/><verse number="24" style="v" sid="1SA 25:24"/>እያ ቶሁዋ ቦላ ኩንዳዳ፥ “ታ ጎዳዉ፥ ታ ባላይ ታ ቦላ ግዶ! ታ እስባ ኦዳና፤ ታ ነ አይልያ ግያባ ስአ። <verse eid="1SA 25:24"/><verse number="25" style="v" sid="1SA 25:25"/>ሀ ዎዛን ባይና አደይ፥ ናባል<note caller="+" style="f"><char style="fr" closed="false">25:25 </char><char style="fq" closed="false">ናባላ፦ </char><char style="ft" closed="false">ናባላ ጉሳይ ኤያ ጉሱ።</char></note> ግያባ ስኦፓ፤ እ ባ ሱንዳ ኤያ። ታ ጎዳዉ፥ ነ ኪትዳ አሳታ ታ ነ አይልያ በአብከ። <verse eid="1SA 25:25"/><verse number="26" style="v" sid="1SA 25:26"/>ደኦ ጎዳይ ኤርያ መላ፥ ነ ሸምፖይ ኤርን፥ ነ ሱ ጉሶናዳነ ሀሎ ከዮናዳ ነና ተቅዳይ ጎዳ። ነ ሞርከትነ ነና ቆሀናዉ ኮየይሳት ናባላዳ ሀኖ። <verse eid="1SA 25:26"/><verse number="27" style="v" sid="1SA 25:27"/>ሀ እሞታይ ታኒ ነ አይልያ ነዉ፥ ታ ጎዳስ ኤህዳይስ ነና ካልያ አሳታስ እመቶ። <verse eid="1SA 25:27"/><verse number="28" style="v" sid="1SA 25:28"/>ታ ጎዳዉ፥ ነ አይለ ናጋራ አቶ ያጋ! ኔኒ ጎዳ ኦላ ኦለትያ ግሾ፥ ጎዳይ ነናነ ነ ሼሻ ካዎያና። ነ ደኦ ላይ ኡባን ኢታተ ነ ቦላ በንቶፎ። <verse eid="1SA 25:28"/><verse number="29" style="v" sid="1SA 25:29"/>አይ አስካ ነና ዎናዉ ኮይኮ፥ እስ አስ ባ አልኦ ሻሉዋ ናገይሳዳ ጎዳይ፥ ነ ፆሳይ ነና ሳሮ ናጋና። ሽን ያምባርሻን ሹቹ ሆለይሳዳ እ ነ ሞርከታ ሆላና። <verse eid="1SA 25:29"/><verse number="30" style="v" sid="1SA 25:30"/>ጎዳይ፥ ታ ጎዳስ ኦናዉ ቃላ ገልዳ ኬሀተ ኡባ ኦያ ዎደነ እስራኤለ ቦላ ካዎያ ዎደ፥ <verse eid="1SA 25:30"/><verse number="31" style="v" sid="1SA 25:31"/>ታ ጎዳይ አዛንያ ጋሶይ ዎይኮ ቂሮያባይ ባዋ። ጋሶይ ባይና ሱ ጉስዳባይ ዎይኮ ሀሎ ከይዳባይ ባይና ግሾ ነ ዎዛናይ ዳጋመና። ጎዳይ ነዉ ሎኦባ ኦዳ ዎደ ታና ነ አይልዉ ዶጎፓ” ያጋሱ።<verse eid="1SA 25:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 25:32"/>ዳዊቲ አብግያኮ፥ “ታራ ጋሄታና መላ ሀች ነና ኪትዳ ጎዳይ፥ እስራኤለ ፆሳይ ጋላተቶ። <verse eid="1SA 25:32"/><verse number="33" style="v" sid="1SA 25:33"/>ታኒ አሳ ሱ ጉሶናዳነ ሀሎ ከዮናዳ ነ ሎኦ ቆፋይ ታና ተቅዳ ግሾ ኔኒ አንጀታ። <verse eid="1SA 25:33"/><verse number="34" style="v" sid="1SA 25:34"/>ታ ነና ቆሆናዳ ተቅዳ ደኦ ጎዳይ፥ እስራኤለ ፆሳይ ኤርያ መላ ነ ታራ ጋሄታናዉ ኤለሳዳ ዮናኮ፥ ሳእ ዎንታና ጋካናዉ ናባላ አሳፐ እስ አደይካ ፓፃ አተና” ያግስ። <verse eid="1SA 25:34"/><verse number="35" style="v" sid="1SA 25:35"/>አብግያ እያዉ ኤህዳ እሞታ እ ኩሸፐ ዳዊቲ ኤክድ፥ “ነ ሶ ሳሮ ባ፤ ታኒ ነ ግዳባ ስአስ፤ ነ ኦይሻካ ኤካስ” ያግስ።<verse eid="1SA 25:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1SA 25:36"/>አብግያ ስማዳ ናባላኮ ያ ዎደ፥ ካዎ ሶን ጊግያ ግብራ መላ ግብራ ሙዝሸ ሶን ኡትስ። ናባል ዳሮ ማትድ፥ ባ ዎዛናን ኡፋይትያ ግሾ ሳእ ዎንታና ጋካናዉ አብግያ እያዉ አይኮካ ኦዳቡኩ። <verse eid="1SA 25:36"/><verse number="37" style="v" sid="1SA 25:37"/>ዎንታ ናባላ ማይ ስምዳፐ ጉየ፥ እያ ማችያ ሀንዳባ ኡባ እያዉ ኦዳሱ፤ ናባላ ዎዛናይ ዎን፥ እ ዳቡርስ። <verse eid="1SA 25:37"/><verse number="38" style="v" sid="1SA 25:38"/>ታሙ ጋላሳፐ ጉዬ ጎዳይ ናባላ ሾጭን፥ እ ሀይቅስ።<verse eid="1SA 25:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1SA 25:39"/>ናባል ሀይቅዳይሳ ዳዊቲ ስእዳ ዎደ፥ “ጎዳይ ጋላተቶ! ናባል ታና ጫይዳይሳ ሀሎ ጎዳይ ከስስ። ታኒ እያ አይለይ ኢታባ ኦና መላ ታና ተቅስ። ናባል ኦዳ ኢታባ ጎዳይ እያ ቦላ ዛርስ” ያግስ።</para>
  <para style="p" vid="1SA 25:39">ሄሳፈ ጉየ፥ ዳዊቲ አብግያ ኤካናዉ ኮይድ ኪታ የድስ። <verse eid="1SA 25:39"/><verse number="40" style="v" sid="1SA 25:40"/>ዳዊታ አይለት ቃርመሎሳን ደእያ አብግያኮ ብድ፥ “ዳዊቲ ነና ማቻናዉ ዶስዳ ግሾ ኑኒ ነና ኤካናዉ ይዳ” ያግዶሶና።<verse eid="1SA 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 25:41"/>አብግያ ጉፋና ዝጋዳ፥ “ታኒ ነ አይልያ ነዉ ኪተታናዉነ ነ አይለታ ቶሁዋ ሜጫናዉ ጊገታ ኡታስ” ያጋሱ። <verse eid="1SA 25:41"/><verse number="42" style="v" sid="1SA 25:42"/>አብግያ ኤለሳ ደንዳዳ ባ ሀርያ ቶጋሱ፥ እያ ባ እቻሹ ማጫ አይለታራነ ዳዊታ ኪትዳ ኣሳራ ባዳ ዳዊታ ገላሱ።<verse eid="1SA 25:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1SA 25:43"/>ዳዊቲ ካሰ እዝራኤለ ማጫስዉ አክናሆሞ ኤክድ ደኤስ፤ ኤንቲ ናምአይ እያ ማቸታ። <verse eid="1SA 25:43"/><verse number="44" style="v" sid="1SA 25:44"/>ሳኦል ዳዊታ ማችዉ፥ ባ ናእዉ መልኮሎ ጋልማ አድያ ሌሳ ናኣ ፋልፃስ እሚስ።<verse eid="1SA 25:44"/></para>
  <chapter eid="1SA 25"/>
  <chapter number="26" style="c" sid="1SA 26"/>
  <para style="s1">ዳዊቲ ዛርድካ ሳኦላ ዎና አግስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 26:1"/>ዚፋ አሳይ ሳኦላኮ ግብአ ብድ፥ “ዳዊቲ ያስሞና ስንን ደእያ ሀክላ ዙማን ቆሰትስ?” ያግዶሶና። <verse eid="1SA 26:1"/><verse number="2" style="v" sid="1SA 26:2"/>ሳኦል፥ እስራኤለታፐ ዶረትዳ ሄ ሙኩሉ አስ ኤክድ፥ ዳዊታ ኮያናዉ ዚፋ መላ ቢታ ብስ። <verse eid="1SA 26:2"/><verse number="3" style="v" sid="1SA 26:3"/>ሳኦል ያስሞና ስንን ደእያ ሀክላ ዙማ ቦላ ደእያ ኦግያ ማታን ዱንካንስ፤ ሽን ዳዊቲ ሄ መላ ቢታን ኡትስ። ሳኦል እያ ካልድ ይዳይሳ ዳዊቲ ኤርዳ ዎደ፥ <verse eid="1SA 26:3"/><verse number="4" style="v" sid="1SA 26:4"/>ዎችያ አስ የድድ፥ ሳኦል ቱማ ሄ በሳ ጋክዳይሳ ሻክድ ኤርስ። <verse eid="1SA 26:4"/><verse number="5" style="v" sid="1SA 26:5"/>ዳዊቲ ደንድድ፥ ሳኦል ዱንካንዳ በሳ ብድ ሳኦልነ ቶራ ሞጮናይ ኔራ ናአይ አበኔር ዝንእዳ በሳ በእስ። ሳኦል ዱንካንዳ ጉታን ኦላንቾት እያ ዩሹዋ ተቅን እ ስክስ።<verse eid="1SA 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 26:6"/>ዳዊቲ ህተ አድያ አብመለከነ ፃሩያ ናኣ እዮኣባ እሻ አብሳያ፥ “ሳኦል ዱንካንዳ በሳ ታራ ባናይ ኦኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="1SA 26:6">አብሳይ፥ “ታኒ ኔራ ባና” ያግስ።<verse eid="1SA 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 26:7"/>ሄሳ ግሾ፥ ዳዊቲነ አብሳይ ሄ ቃማ ኦላንቾታኮ ያ ዎደ ሳኦል ባ ሁጰ ሶን ቶራ ኤስድ፥ ዱንካንያ ግዶን ዝንእዳይሳ ደምዶሶና። አበኔርነ ኦላንቾት እያ ዩሹዋን ዝንእዶሶና።<verse eid="1SA 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 26:8"/>አብሳይ፥ “ፆሳይ ነ ሞርክያ ሀች ነ ኩሸን አድ እሚስ፤ ታኒ ቶራን እያ እስ ቶሆ ሳአራ ኦይዳ ጫዳና፤ እያ ዛራ ጫዳናዉ ኮሸና” ያግስ።<verse eid="1SA 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 26:9"/>ሽን ዳዊቲ አብሳያኮ፥ “ኔኒ እያ ዎፓ፤ ጎዳይ ትይዳ ካዋ ቦላ ባ ኩሽያ ደንያ ኦናካ ጎዳይ ሴራና። <verse eid="1SA 26:9"/><verse number="10" style="v" sid="1SA 26:10"/>ደኦ ጎዳይ ኤርያ መላ፥ ፆሳይ እያ ዎና፤ እ ባ ጋላሳን ዎይኮ ኦላን ሀይቃና። <verse eid="1SA 26:10"/><verse number="11" style="v" sid="1SA 26:11"/>ጎዳይ ትይዳ ካዋ ቦላ ታ ኩሽያ ደንናዳ ታና ጎዳይ ተቆ። አነ እያ ሁጰ ሶን ደእያ ቶራነ ሃ ኦይክያ ሚሽያ ኤክድ ቦስ” ያግስ።<verse eid="1SA 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 26:12"/>ዳዊቲ ሳኦላ ሁጰ ሶን ደእያ ቶራነ ሃ ኦይክያ ሚሽያ ኤክን፥ ኤንቲ ብዶሶና። ኤንታ ኦንካ በእቤና ዎይኮ ኦንካ ኤርቤና ዎይኮ ኦንካ ባርክቤና። ጎዳይ ኤንታ ቦላ ዎልቃማ ስኮ የድዳ ግሾ ኡባይ ስኮ ሀይቅ አግዶሶና።<verse eid="1SA 26:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 26:13"/>ዳዊቲ ሄፍን ፕንድ፥ ኤንታፈ ሃክድ ሀራ ደረ ቦላ ከይድ ኤቅስ። <verse eid="1SA 26:13"/><verse number="14" style="v" sid="1SA 26:14"/>ዳዊቲ ሳኦላ ኦላንቾታነ ኔራ ናኣ አበኔራ ፄግድ፥ “አበኔራ፥ ታኒ ፄግያ ዎደ ስእኪ?” ያግድ ዋስስ።</para>
  <para style="p" vid="1SA 26:14">አበኔር፥ “ቃላ ቁ ኦ ፄግድ ካዋ ስኮ ድገይ ኦኔ?” ያግስ።<verse eid="1SA 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 26:15"/>ዳዊቲ፥ “ኔኒ ዎዛናማ አስ ግድኪ? እስራኤለ ግዶን ነ መላ አስ ኦኔ? ያትን፥ ካዋ፥ ነ ጎዳ አይስ ናግኪ? እስ አስ ካዋ፥ ነ ጎዳ ዎናዉ ብስ። <verse eid="1SA 26:15"/><verse number="16" style="v" sid="1SA 26:16"/>ነ ኦዳባይ ሎኦ ግደና። ደኦ ጎዳይ ኤርያ መላ፥ ነነ ነ ኦላንቾት ፆሳይ ትይዳ ህንተ ጎዳ ናግቦና ግሾ ህንተ ሀይቃናዉ በሴስ። ካዋ ቶራይነ እያ ሁጰ ሶን ደእያ ሃ ኦይክያ ሚሸይ አዉን ደእያኮ በአ” ያግስ።<verse eid="1SA 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 26:17"/>ዳዊታ ቃላ ግደይሳ ሳኦል ኤርድ፥ “ታ ናአዉ ዳዊታ፥ ሄስ ነ ቃሌ?” ያግስ።</para>
  <para style="p" vid="1SA 26:17">ዳዊትቲ፥ “ኤ፥ ታ ጎዳዉ፥ ካዋዉ፥ ሄስ ታ ቃላ። <verse eid="1SA 26:17"/><verse number="18" style="v" sid="1SA 26:18"/>ታ ጎዳዉ፥ ታና ነ አይልያ ኔኒ አይስ ካላይ? ታኒ አይ ኦድና? ታ ባላይ አይቤ? <verse eid="1SA 26:18"/><verse number="19" style="v" sid="1SA 26:19"/>ታ ጎዳዉ፥ ካዋዉ፥ ኔኒ ነ አይልያ ቃላ ስአና መላ ታ ነና ዎሳይስ። ጎዳይ ነና ታ ቦላ ደንዳባ ግድኮ፥ እ ያርሾ ኤኮ። ሽን አስ ነና ደንዳባ ግድኮ፥ ‘ባዳ ሀራ ፆሳታ ጎይና’ ያግዶሶና። ጎዳ ቢታን ታዉ ደእያ ላታፐ ኤንቲ ታና ጎድዳ ግሾ ኤንቲ ጎዳ ስንን ባደትዳባ ግዶ! <verse eid="1SA 26:19"/><verse number="20" style="v" sid="1SA 26:20"/>ሀእ ጎዳ ስንፈ ሃክድ፥ አላጋ ቢታን ደእያ ኡራ ሱ ጉሶፋ። እስ አስ ኩራቾ ሻንካታናዉ ደረ ቦላ ከየይሳዳ፥ እስራኤለ ካዎይ ካስቶለ ኮያናዉ ከይስ” ያግስ።<verse eid="1SA 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 26:21"/>ሳኦል፥ “ታኒ ነና ቆሀስ። ታ ናአዉ፥ ዳዊታ፥ ሃ ስማ! ሀች ነ ታ ሸምፕዉ ሀይቆፐ አሽዳ ግሾ ታኒ ነና ዛራዳ ገንከ። ቱማ ታኒ ኤያባ ሀናስ፤ ግታ ባላ ባላስ” ያግስ።<verse eid="1SA 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 26:22"/>ዳዊቲ ዛሪድ፥ “ካዋዉ፥ ነ ቶራይ ሀይስሽ፥ ነ አሳፐ እስ አስ ይድ ኤኮ። <verse eid="1SA 26:22"/><verse number="23" style="v" sid="1SA 26:23"/>እስ እስ አሳስ እያ ፅሎተ መላነ እያ አማነተ መላ ጎዳይ ጋተ ቃንፄስ። ሀች ጎዳይ ነና ታ ኩሸን አድ እሚስ፤ ሽን ጎዳይ ትይዳ ካዋ ቦላ ታኒ ታ ኩሽያ ዎናዉ ኮያብከ። <verse eid="1SA 26:23"/><verse number="24" style="v" sid="1SA 26:24"/>ሀች ነ ሸምፑዋ ታ አሽዳይሳዳ ጎዳይ ታና መቶ ኡባፈ አሽድ ቦንቾ” ያግስ።<verse eid="1SA 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 26:25"/>ሳኦል፥ “ታ ናአዉ፥ ዳዊታ፥ ኔኒ አንጀታ። ኔኒ ግታባ ኦና፤ ነዉ እንጀታና” ያግስ። ዳዊቲ ባ ኦግያ ብስ፤ ሳኦልካ ባ ሶ ስምስ።<verse eid="1SA 26:25"/></para>
  <chapter eid="1SA 26"/>
  <chapter number="27" style="c" sid="1SA 27"/>
  <para style="s1">ዳዊቲ ፍልስፄመ ባቃትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 27:1"/>ዳዊቲ ባ ዎዛናን፥ “እስ ጋላስ ታኒ ሳኦላ ኩሸን ዳፋታና፤ ታኒ ፍልስፄመ ቢታ ባቃታናፐ አትሽን፥ ሀራባይ ታዉ ሎኤና። ያንኮ፥ ሳኦል እስራኤለ ቢታ ኡባን ታና ኮየይሳ አጋና፤ ታኒ እያ ኩሸፐ ከሳ ኤካና” ያግድ ቆፕስ።<verse eid="1SA 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 27:2"/>ሄሳ ግሾ፥ ዳዊቲነ እያራ ደእያ ኡሱፑን ፄቱ አሳት ደንድድ፥ ጋተ ካዋ ማኦካ ናኣ አንኩሳኮ ብዶሶና። <verse eid="1SA 27:2"/><verse number="3" style="v" sid="1SA 27:3"/>ዳዊቲነ እያ አሳይ አንኩሳራ ጋተን ኡትዶሶና። አሳ ኡባይ ባ ሶ አሳ አሳ ኤክድ ብስ፤ ዳዊቲካ ባ ማቸታ፥ እዝራኤለ አክናሆሞነ ናባላ አምእዉ፥ ቃርመሎሳ ማጫስዉ፥ አብግያ ኤክድ ብስ። <verse eid="1SA 27:3"/><verse number="4" style="v" sid="1SA 27:4"/>ዳዊቲ ጋተ ባቃትስ ገይሳ ስእድ፥ ሳኦል ዛሪድ እያ ኮየይሳ አግስ።<verse eid="1SA 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 27:5"/>ዳዊቲ ካዋ አንኩሳኮ፥ “ኔኒ ታናን ኡፋይትኮ፥ ታኒ ያን ዳና መላ ነ ካዎተን ደእያ ካታማታፐ እሱዋ ታዉ እማ። ታኒ ነ አይለይ ካዎይ ደእያ ካታማን ኔራ አይስ ኡታኔ?” ያግስ።<verse eid="1SA 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 27:6"/>ሄ ጋላስ አንኩስ ፅቅላጋ ካታማ ዳዊታስ እሚስ፤ ሀች ጋካናዉ ፅቅላጋ ካታማይ ይሁዳ ካዎታባ ግድድ አትስ። <verse eid="1SA 27:6"/><verse number="7" style="v" sid="1SA 27:7"/>ዳዊቲ ፍልስፄመ ቢታን እስ ላይነ ኦይዱ አጌና ደእስ።<verse eid="1SA 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 27:8"/>ዳዊቲነ እያ አሳት ፑደ ከይድ፥ ጌሹረታ፥ ጋርዘታነ አማለቃታ ኦሎሶና። በንፐ ዶምድ፥ ሄ አሳት ሹራፐ ብድ ግብፀ ጋካናዉ ደእያ ቢታን ደእዶሶና። <verse eid="1SA 27:8"/><verse number="9" style="v" sid="1SA 27:9"/>ዳዊቲ ሄ ቢታ ኦልያ ዎደ ኡባን ሄ ቢታን ደእያ ማጫ ግድን፥ አደ ግድን፥ ፓፃ አግቤና። ዶርሰነ መሄ፥ ሀረነ ግማለ ማኦ ድኤስ፤ ያትድ አንኩሳኮ ስሜስ። <verse eid="1SA 27:9"/><verse number="10" style="v" sid="1SA 27:10"/>አንኩስ፥ “ሀች አዉን ኦልደቲ?” ግድ ዳዊታ ኦይቼስ።</para>
  <para style="p" vid="1SA 27:10">ዳዊቲ፥ “ይሁዳ ዱገሀ ባጋ ዎይኮ ይራማኤላ ዱገሀ ባጋ ዎይኮ ቄና ዱገሀ ባጋ ኦልዳ” ያጌስ።<verse eid="1SA 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 27:11"/>ኤንታፈ እስ አስ ጋተ ብድ፥ “ዳዊቲ ሀይሳ ኦስ” ግድ ኦዶና መላ ዳዊቲነ እያ አሳት ማጫ አደ አሾና ዎዶሶና። ዳዊቲ ፍልስፄመ ቢታን ደእዳ ዎደ ኡባን ሀይሳዳ ኦስ። <verse eid="1SA 27:11"/><verse number="12" style="v" sid="1SA 27:12"/>አንኩስ ዳዊታን አማነትድ፥ “ዳዊቲ ባ አሳን፥ እስራኤለን ዳሮ እፀትስ፤ ሄሳ ግሾ፥ እ ታዉ መርናዉ አይለ ግዳና” ያግድ ቆፕስ።<verse eid="1SA 27:12"/></para>
  <chapter eid="1SA 27"/>
  <chapter number="28" style="c" sid="1SA 28"/>
  <para style="s1">ሳኦላነ ሞይትለ ፄግያ ማጫስዉ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 28:1"/>ሄ ዎደ ፍልስፄመ አሳት እስራኤለታ ኦላናዉ ባንታ ኦላንቾታ ሺሽዶሶና። አንኩስ ዳዊታኮ፥ “ነነ ነ አሳት ታራ ኦላስ ባናይሳ ቱማ ኤራ ኡታ” ያግስ።<verse eid="1SA 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 28:2"/>ዳዊቲ፥ “ሄሳ ግድኮ፥ ታ ነ አይለይ ኦናባ ነ በአና” ያግስ።</para>
  <para style="p" vid="1SA 28:2">አንኩስ፥ “ዳሮ ሎኦ፤ ታኒ ነና ታ ደኦ ላይ ኡባን ታና ናገይሳ ኦና” ያግስ።<verse eid="1SA 28:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 28:3"/>ሀይሳፈ ካሰ ሳሜል ሀይቅን፥ እስራኤለ አሳ ኡባይ እያዉ ዬክድ፥ እያ ካታማን ራማን እያ ሞግዶሶና። ሳኦል ሞይትለ ፄገይሳታነ ማሮታ እስራኤለ ቢታፈ የደድ ከስስ።<verse eid="1SA 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 28:4"/>ፍልስፄመ ኦላንቾት ሺቅድ፥ ሱኔማ ካታማን ዱንካንዶሶና፤ ሳኦል እስራኤለ አሳ ኡባ ሺሽድ፥ ግልቦአ ዙማን ዱንካንስ። <verse eid="1SA 28:4"/><verse number="5" style="v" sid="1SA 28:5"/>ሳኦል ፍልስፄመ ኦላንቾታ በእድ ያይስ፤ እያ ዎዛናይ ዳሮ ዳጋምስ። <verse eid="1SA 28:5"/><verse number="6" style="v" sid="1SA 28:6"/>ሄሳ ግሾ፥ አይ ኦነኮ ጎዳ ኦይችስ፤ ሽን ጎዳይ አሙሆን ዎይኮ ኡሪመን<note caller="-" style="x"><char style="xo" closed="false">28:6 </char><char style="xt" closed="false"><ref loc="EXO 28:30">ከሳ 28:30</ref>.</char></note> ዎይኮ ናበታ ባጋራ እያዉ ኦድቤና። <verse eid="1SA 28:6"/><verse number="7" style="v" sid="1SA 28:7"/>ሄሳፈ ጉየ፥ ሳኦል ባ አይለታ፥ “ሞይትለ ፄግያ ማሮ ታዉ ኮይተ፤ ታኒ ኢኮ ባዳ እዮ ኦይቻና” ያግድ ኪትስ።</para>
  <para style="p" vid="1SA 28:7">ሳኦላ አይለት፥ “ሞይትለ ፄግያ እስ ማሮይ ኤንዶራን ደአኡሱ” ያግዶሶና።<verse eid="1SA 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 28:8"/>ያግን ሳኦል ባና ኤርሶና መላ ሀራ ማኦ ማእድ፥ ናምኡ አሳታ ኤክድ፥ ቃማ ሄ ማሬኮ ብድ፥ ማጫስዉ፥ “ሀያና፥ ታዉ እስ ሞይትለ ፄጋርክ፤ ታኒ ሱን ኦድያ አሳ ታዉ ደንርክ” ያግስ።<verse eid="1SA 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 28:9"/>ያግን ማጫስያ፥ “ሞይትለ ፄገይሳታነ ማሮታ እስራኤለ ቢታፈ ሳኦል ዋት የደ ከስዳኮ፥ ቱማ ኔኒ ኤራሳ። ታና ዎሳናዉ ኔኒ ታዉ አይስ ፅሄ የጋይ?” ያጋሱ።<verse eid="1SA 28:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 28:10"/>ያግን ሳኦል ማጫስዉ፥ “ደኦ ፆሳይ ኤርያ መላ፥ ኔኒ ሀይሳ ግሾ ሴረታካ” ያግድ ጎዳን ጫቅስ።<verse eid="1SA 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 28:11"/>ማጫስያ፥ “ታኒ ነዉ ኦና ደን?” ያጋዳ ኦይቻሱ።</para>
  <para style="p" vid="1SA 28:11">ሳኦል፥ “ሳሜላ ታዉ ደን” ያግስ።<verse eid="1SA 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 28:12"/>ማጫስያ ሳሜላ በአዳ፥ ዋሶ ጎቻዳ፥ ሳኦላኮ፥ “ኔኒ ታና አይስ ጭማዲ? ኔኒ ሳኦላ ግድክ!” ያጋሱ።<verse eid="1SA 28:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 28:13"/>ካዎይ፥ “ያዮፋ! ነዉ አይበ በንተይ?” ያግስ።</para>
  <para style="p" vid="1SA 28:13">ማጫስያ፥ “እስ ሞይትለይ ቢታ ግዶፈ ከይሽን በአስ” ያጋሱ።<verse eid="1SA 28:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 28:14"/>ሳኦል ማጫስዉ፥ “እ አይ ዳኒ?” ያግስ።</para>
  <para style="p" vid="1SA 28:14">ማጫስያ፥ “ካባ ማእዳ እስ ጭማ አደይ ከይስ” ያጋሱ።</para>
  <para style="p" vid="1SA 28:14">ሳኦል ሄ አደይ ሳሜላ ግደይሳ ኤርድ፥ እያ ስንን ሳአን ጉፋንስ።<verse eid="1SA 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 28:15"/>ሳሜል ሳኦላኮ፥ “ታና ደንዳ አይስ ዋይሳይ?” ያግስ።</para>
  <para style="p" vid="1SA 28:15">ሳኦል፥ “ታኒ ዳሮ ኡንኤታስ፤ ፍልስፄመ አሳት ታና ኦሎሶና፤ ፆሳይ ታፐ ሻከትስ፤ ናበታ ባጋራ ዎይኮ አሙሆን እ ታኒ ኦይችያባ ኦደና። ሄሳ ግሾ፥ ታኒ ኦናባ ነ ታዉ ኦዳና መላ ነና ፄጋስ” ያግስ።<verse eid="1SA 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 28:16"/>ሳሜል፥ “ጎዳይ ሻከትድ ነዉ ሞርከ ግድኮ ታና አይስ ዞረ ኦይቻይ? <verse eid="1SA 28:16"/><verse number="17" style="v" sid="1SA 28:17"/>ጎዳይ ታ ባጋራ ካሰት ኦድዳባ ኦስ፤ ጎዳይ ካዎተ ኔፐ ኤክድ፥ ነ ሾሩዋ ዳዊታስ እሚስ። <verse eid="1SA 28:17"/><verse number="18" style="v" sid="1SA 28:18"/>ኔኒ ጎዳስ ኪተታቦና ግሾነ እያ ኤፅያ እያ ሸንያ አማለቃ ቦላ ፖላቦና ግሾ ጎዳይ ሀች ሀይሳ ነ ቦላ ኤህስ። <verse eid="1SA 28:18"/><verse number="19" style="v" sid="1SA 28:19"/>ነናነ እስራኤለ፥ ጎዳይ ፍልስፄመታስ አድ እማና፤ ነነ ነ አደ ናይት ዎንቶ ታናን ጋሄታና፤ ጎዳይ እስራኤለ ኦላንቾታ ፍልስፄመታስ አድ እማና” ያግስ።<verse eid="1SA 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 28:20"/>ሳኦል ሳሜላ ኦዳ ስእድ ያይዳ ግሾ ዳቡርድ፥ ባና ዶግድ ሳአን ኩንድስ። ሳኦል ቃማነ ጋላስ ካ ምቦና ግሾ እያዉ ዎልቅ እፅስ። <verse eid="1SA 28:20"/><verse number="21" style="v" sid="1SA 28:21"/>ሄ ማጫስያ ሳኦላኮ ያዳ፥ እ ዳሮ ኮኮረይሳ በአዳ፥ “ታኒ ነ አይልያ ነዉ ኪተታስ፤ ኔኒ ታና ኦይችዳባ ታ ሸምፑዋ ዶጋዳ ኦስ። <verse eid="1SA 28:21"/><verse number="22" style="v" sid="1SA 28:22"/>ሀእ ታኒ ነ አይልያ ግያባ ሀያና ስአ፤ ኔኒ ማዳ ጋሽታዳ ነ ኦግያ ባና መላ ታኒ ነዉ ጉ ካ ጊግሳስ” ያጋሱ።<verse eid="1SA 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 28:23"/>ሳኦል፥ “ሚከ” ያግስ። ሽን እያ አሳት ሄ ማጫሴራ ግድድ እያ ዎስዶሶና፤ ኤንታ ዎሳ ስእስ፤ ቢታፈ ደንድድ ሂፃን ኡትስ። <verse eid="1SA 28:23"/><verse number="24" style="v" sid="1SA 28:24"/>ሄ ማጫስያ ባ ሶን ደእያ አንቃራ ማራ ሹካሱ፤ ለ ኤካ ሙኑቃዳ፥ ኡይ ኡካሱ። <verse eid="1SA 28:24"/><verse number="25" style="v" sid="1SA 28:25"/>ያታዳ ካ ሳኦላስነ እያ አሳታስ አን፥ ኤንቲ ምዶሶና። ሄ ቃማ ደንድድ ብዶሶና።<verse eid="1SA 28:25"/></para>
  <chapter eid="1SA 28"/>
  <chapter number="29" style="c" sid="1SA 29"/>
  <para style="s1">አንኩስ ዳዊታ ፅቅላጋ ዛርስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 29:1"/>ፍልስፄመት ባንታ ኦላንቾታ ኡባ አፌቃን ሺሽዶሶና። እስራኤለት እዝራኤለን ደእያ ፑልቶ ሃ ማታን ዱንካንዶሶና። <verse eid="1SA 29:1"/><verse number="2" style="v" sid="1SA 29:2"/>ፍልስፄመ ሀላቃት ባንታ ኦላንቾታ ፄታንነ ሙኩሉ ጩጋን ሳልፕስዶሶና፤ ዳዊቲነ እያ አሳይ አንኩሳራ እስፈ ግድድ ጉየ ባጋራ ሳልፕዶሶና። <verse eid="1SA 29:2"/><verse number="3" style="v" sid="1SA 29:3"/>ፍልስፄመ ሀላቃት ኤንታ በእድ፥ “ሀ እብራወት ሀይሳን አይ ኦና?” ያግዶሶና።</para>
  <para style="p" vid="1SA 29:3">አንኩስ፥ “ሀይስ እስራኤለ ካዋ ሳኦላ አይልያ ዳዊታ ግደኔ? እ ዳሮ ዎደ ታራ አስ፤ እ ሳኦላ ካድድ ከዮደፐ ሀች ጋካናዉ ታኒ እያፐ ባላ ደማብከ” ያግስ።<verse eid="1SA 29:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 29:4"/>ሽን ፍልስፄመ ሀላቃት አንኩሳ ቦላ ሀንቀትድ፥ “ሀ አድያ ኔኒ እያዉ እምዳ ካታማ ጉየ ዛራ። ኦላይ ጎብያ ዎደ እ ኑ ቦላ ስሚድ ደንዶና መላ እ ኑራ ኦላ ቦፖ። እ ባ ጎዳራ ስገታናዉ ኑ አሳታ ቆያ ቃንፆፈ አትሽን፥ ሀራ አይ ኦኔ? <verse eid="1SA 29:4"/><verse number="5" style="v" sid="1SA 29:5"/>ሀይሳፈ ካሰ ማጫሳይ፥ ‘ሳኦል ሙኩላታ ዎስ፤ ዳዊቲ ታሙ ሙኩላታ ዎስ’ ያግድ ዱርሸነ የፅሸ ሳቢዳይ ዳዊታ ግደኔ?” ያግዶሶና።<verse eid="1SA 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 29:6"/>ሄሳ ግሾ፥ አንኩስ ዳዊታ ፄግድ፥ “ደኦ ጎዳይ ኤርያ መላ፥ ኔኒ አማንያ አስ፤ ኔኒ ታራ ኦላስ በይሳ ታ ዶሳይስ። ኔኒ ታኮ ዮሳፐ ሀች ጋካናዉ ታኒ ነ ቦላ ባላ ደማብከ። ሽን ሀላቃት ኔኒ ኦላስ በይሳ ዶሶኮና። <verse eid="1SA 29:6"/><verse number="7" style="v" sid="1SA 29:7"/>ኔኒ ጉየ ስማዳ ሳሮ ባ፤ ፍልስፄመ ሀላቃታ ኡፋይሶናባ አይኮካ ኦፋ” ያግስ።<verse eid="1SA 29:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 29:8"/>ዳዊቲ፥ “ታኒ አይ ኦድና? ታኒ ኔራ ደኦደፐ ሀች ጋካናዉ ነ ታፐ አይ ባላ ደማዲ? ያትን፥ ካዋ፥ ታ ጎዳ ሞርከታራ አይስ ኦለትክና?” ያግስ።<verse eid="1SA 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 29:9"/>አንኩስ፥ “ፆሳ ኪታንቾዳ ኔኒ ታዉ ሎኦ ግደይሳ ታኒ ኤራይስ። ሽን ፍልስፄመ ሀላቃት፥ ‘እ ኑራ ኦላ ቦፖ’ ያግዶሶና። <verse eid="1SA 29:9"/><verse number="10" style="v" sid="1SA 29:10"/>ነነ ኔራ ይዳ ነ ጎዳ አይለታራ ዎንቶ ጉራ ደንድድ ቢተ” ያግስ።<verse eid="1SA 29:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 29:11"/>ሄሳ ግሾ ዳዊቲነ እያ አሳት ፍልስፄመ ስማናዉ ዎንታ ጉራ ደንድዶሶና፤ ፍልስፄመት እዝራኤለ ብዶሶና።<verse eid="1SA 29:11"/></para>
  <chapter eid="1SA 29"/>
  <chapter number="30" style="c" sid="1SA 30"/>
  <para style="s1">ዳዊቲ አማለቃታ ኦልስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 30:1"/>ዳዊቲነ እያ አሳት ሄን ጋላስ ፅቅላጋ ጋክዶሶና። አማለቃት ነገባነ ፅቅላጋ ኦልድ፥ ፅቅላጋ ታማን ፁግዶሶና። <verse eid="1SA 30:1"/><verse number="2" style="v" sid="1SA 30:2"/>ፅቅላጋን ደእያ ማጫሳነ ናአፐ ጭማ ጋካናዉ ደእያ ኡባ ድእዶሶና፤ ኤንታፈ እስ አስካ ዎና ኤንታ ኡባ ድእድ ኤፍዶሶና።<verse eid="1SA 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 30:3"/>ዳዊቲነ እያ አሳት ፅቅላጋ ጋክያ ዎደ ካታማይ ታማን ፁገትዳይሳነ ኤንታ ማቸት፥ አደ ናይትነ ማጫ ናይት ድኤትዳይሳ በእዶሶና። <verse eid="1SA 30:3"/><verse number="4" style="v" sid="1SA 30:4"/>ዳዊቲነ እያራ ደእያ አሳይ ባንታ ዎልቃይ እፃና ጋካናዉ ዋስድ ዬክዶሶና። <verse eid="1SA 30:4"/><verse number="5" style="v" sid="1SA 30:5"/>ዳዊታ ማቸት እዝራኤለ አክናሆማነ ካሰ ናባላ ማችያ ቃርመሎሳ አብግያ ናምአይካ ድኤትዶሶና።<verse eid="1SA 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 30:6"/>እያ አሳይ ባንታ አደ ናይትነ ማጫ ናይት ድኤትዳ ግሾ ይሎትድ ዳዊታ ሹቻን ጫዳናዉ ኦደትን፥ ዳዊቲ ዳሮ ኡንኤትስ። ግዶሽን፥ ዳዊቲ ጎዳን ባ ፆሳን ምነትስ።<verse eid="1SA 30:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 30:7"/>ዳዊቲ አብመለከ ናኣ ካህንያ አብያታራኮ፥ “ኤፉድያ ኤካዳ ያ” ያግን፥ አብያታር ኤፉድያ ዳዊታስ ኤህስ። <verse eid="1SA 30:7"/><verse number="8" style="v" sid="1SA 30:8"/>ዳዊቲ፥ “ታኒ፥ ታና ኦልያ አሳታ ካላዳ ጋካኔ?” ያግድ ጎዳ ኦይችስ።</para>
  <para style="p" vid="1SA 30:8">ጎዳይ፥ “ኤ፤ ኤንታ ካላዳ ባ፤ ቱማ ኤንታ ነ ጋካና፤ ቱማ ድኡዋ ዛራና” ያግስ።<verse eid="1SA 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 30:9"/>ዳዊቲነ እያራ ደእያ ኡሱፑን ፄቱ አሳት ደንድድ ቦሶራ ሻፋ ጋክያ ዎደ ኤንታፈ ጉ አሳት ያን አትዶሶና። <verse eid="1SA 30:9"/><verse number="10" style="v" sid="1SA 30:10"/>ናምኡ ፄቱ አሳይ ሻፋ ፕናናዉ ዳሮ ዳቡርዶሶና። ሽን ዳዊቲነ ኦይዱ ፄቱ አሳይ ካልዶሶና።<verse eid="1SA 30:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 30:11"/>ኤንቲ እስ ግብፀ አስ ደንባን ደምድ፥ ዳዊታኮ ኤህድ፥ እያዉ ሃነ ካ እምዶሶና። <verse eid="1SA 30:11"/><verse number="12" style="v" sid="1SA 30:12"/>ባላሰ ኦንጎቾነ ናምኡ ዎይነ ኑካ እያዉ እምን ምድ ጋሽትስስ። እ ሄ ጋላስነ ሄ ቃማ ካ ሞና ሃ ኡዮና ጋምእስ። <verse eid="1SA 30:12"/><verse number="13" style="v" sid="1SA 30:13"/>ዳዊቲ፥ “ኔኒ ኦደ አይሌ? አዉፐ ያዲ?” ያግድ አድያ ኦይችስ።</para>
  <para style="p" vid="1SA 30:13">አደይ፥ “ታኒ አማለቃ አድያስ አይለትዳ ግብፀ አስ፤ ሄ ጋላሳፐ ካሰ ታ ሳከትን፥ ታ ጎዳይ ታና የግ አግድ ብስ። <verse eid="1SA 30:13"/><verse number="14" style="v" sid="1SA 30:14"/>ኑኒ ይሁዳ ዛዋ፥ ከልታወታ ዱገሀ ባጋነ ካለባ ዱገሀ ባጋ ኦልድ ፅቅላጋ ታማን ፁግዳ” ያግስ።<verse eid="1SA 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 30:15"/>ዳዊቲ፥ “ኔኒ ታና ሄ ኦልዳ ጩጋታኮ ካለናዉ ዳንዳአይ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="1SA 30:15">እ ዛሪድ፥ “ኔኒ ታና ዎና መላነ ታ ጎዳስ አዳ እምከ ጋዳ ታዉ ፆሳን ጫቃ፤ ታኒ ነና ኤንታኮ ካለና” ያግስ።<verse eid="1SA 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 30:16"/>ዳዊቲ ካለድ ኤንታኮ ጋስ። ኤንቲ ፍልስፄመፐነ ይሁዳፐ ዳሮ ድኦ ድእዳ ግሾ ኡፋይትድ ምሸነ ኡይሸ ላለትድ ኡትዶሶና። <verse eid="1SA 30:16"/><verse number="17" style="v" sid="1SA 30:17"/>ሄ ጋላስ ኦማርሳፈ ዶምድ ዎንተ ጋላስ ኦማርስ ጋካናዉ ዳዊቲ ኤንታ ሾጭስ። ግማለ ቶግድ ባቃትዳ ኦይዱ ፄቱ ፓንታፐ አትሽን፥ ሀር እስ አስካ አትቤና። <verse eid="1SA 30:17"/><verse number="18" style="v" sid="1SA 30:18"/>አማለቃ አሳት ኤፍዳ ኡባ፥ ባ ናምኡ ማቸታራ እስፈ ዳዊቲ ዎስስድ ኤክስ። <verse eid="1SA 30:18"/><verse number="19" style="v" sid="1SA 30:19"/>አሳት ድእድ ኤፍዳባፐ እስባይካ ፓጭቤና፤ ናእ ዎይኮ ጭም፥ አደይ ዎይኮ ማጭ፥ ሄሳዳካ ኤንቲ ድእድ ኤፍዳ ሀራባ ኡባይ ፓጮና ደእሽን ዳዊቲ ኡባ ዛርስ። <verse eid="1SA 30:19"/><verse number="20" style="v" sid="1SA 30:20"/>ዳዊቲ ዶርሰ፥ ዴሸነ መሄ ኡባ ድእስ፤ ዳዊቲ አሳይ እ ድእዳ መህያ ሀንኮ መህያፐ ስንራ ላግሸ፥ “ሀይስ ዳዊታ ድኦ” ያግዶሶና።<verse eid="1SA 30:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 30:21"/>ዳዊቲ ዳቡርድ ቦሶራ ሻፋ አቻን አትዳ ናምኡ ፄቱ አሳኮ ይስ። ኤንቲ ዳዊታነ እያራ ደእያ አሳ ሞካናዉ ከይዶሶና። ዳዊቲ ባ አሳራ ሺቅድ ኤንታ ሳሮስ። <verse eid="1SA 30:21"/><verse number="22" style="v" sid="1SA 30:22"/>ሽን ዳዊታራ ብዳ አሳታ ግዶፈ ፓና ኢታ አሳት፥ “ኤንቲ ኑራ ቦና ግሾ ኑኒ ዛሪድ ኤህዳባፐ አይኮካ ኤንታዉ ሻኮኮ፤ ኤንቲ ባንታ ናይታነ ባንታ ማቸታ ኤክድ ቦና” ያግዶሶና።<verse eid="1SA 30:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 30:23"/>ዳዊቲ ዛሪድ፥ “ታ እሻቶ፥ ጎዳይ ኑስ እምዳባን ህንተ ሀይሳዳ ኦናዉ በሰና። እ ኑና ናግድ፥ ኑና ኦልዳ ጩጋታ ኑስ አድ እሚስ። <verse eid="1SA 30:23"/><verse number="24" style="v" sid="1SA 30:24"/>ህንተ ግያባ ኦንካ ኤከና። ኦለታናዉ ብዳይሳታነ ኑባ ናግሸ ሀይሳን ጋምእዳይሳታ ግሾይ እስኖ፤ ኡባይ ግና ሻከታና” ያግስ። <verse eid="1SA 30:24"/><verse number="25" style="v" sid="1SA 30:25"/>ሄ ጋላሳፐ ዶምድ ሀች ጋካናዉ እስራኤለ ቢታን ሄስ ህገነ ዎጋ ግድስ።<verse eid="1SA 30:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 30:26"/>ዳዊቲ ፅቅላጋ ጋክዳ ዎደ ባ ላገ ግድዳ ይሁዳ ጭማታኮ፥ “ጎዳ ሞርከታፐ ድኤትዳባፐ ታኒ ህንተዉ እመይሳ ኤክተ” ያግድ ጉራ የድስ። <verse eid="1SA 30:26"/><verse number="27" style="v" sid="1SA 30:27"/>እ ሄሳ ቤተለን፥ ራሞታ ነገባንነ ያትራን ደኤይሳታስ፥ <verse eid="1SA 30:27"/><verse number="28" style="v" sid="1SA 30:28"/>አሮኤራን፥ ስፍሞታን፥ ኤሽታሞአንነ <verse eid="1SA 30:28"/><verse number="29" style="v" sid="1SA 30:29"/>ራካላን፥ ይራህማኤላን፥ ቄና ካታማታን፥ <verse eid="1SA 30:29"/><verse number="30" style="v" sid="1SA 30:30"/>ሆርማና፥ ቦራሳና፥ አታካንነ <verse eid="1SA 30:30"/><verse number="31" style="v" sid="1SA 30:31"/>ከብሮናን ደኤይሳታስ የድስ። እነ እያ አሳት ዩይዳ በሳ ኡባን ደእያ አሳስ የድስ።<verse eid="1SA 30:31"/></para>
  <chapter eid="1SA 30"/>
  <chapter number="31" style="c" sid="1SA 31"/>
  <para style="s1">ሳኦላ ሀይቁዋ</para>
  <para style="r">(<ref loc="1CH 10:1-12">1 ታር 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 31:1"/>ፍልስፄመት እስራኤለታራ ኦለትዶሶና፤ እስራኤለት ፍልስፄመታ ስንፈ ባቃትዶሶና፤ ዳሮ እስራኤለት ግልቦአ ደርያ ቦላ ሀይቅዶሶና። <verse eid="1SA 31:1"/><verse number="2" style="v" sid="1SA 31:2"/>ፍልስፄመት ሳኦላነ እያ አደ ናይታ የደድ፥ እያ አደ ናይታ ዮናታና፥ አምናዳበነ ማልክሳ ዎዶሶና። <verse eid="1SA 31:2"/><verse number="3" style="v" sid="1SA 31:3"/>ኦላይ ተቅድ ሳኦላ ኡንኤስ፤ ዶንገን ዱከይሳት እያ ጫድድ ዳሮ ማዱንፅስዶሶና።<verse eid="1SA 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 31:4"/>ሳኦል ባ ኦላ ሚሽያ ቶከይሳኮ፥ “ሀ ቃፃረትቦናይሳት ይድ፥ ታና ጫድድ ካኦና መላ ነ ማሻን ታና ጫዳዳ ዎ” ያግስ።</para>
  <para style="p" vid="1SA 31:4">ሽን እያ ኦላ ሚሽያ ቶከይስ ያይድ እፅን፥ ሳኦል ባ ማሻ ሳአን ኤስድ፥ እያ ቦላ ኩንድስ። <verse eid="1SA 31:4"/><verse number="5" style="v" sid="1SA 31:5"/>እያ ኦላ ሚሽያ ቶከይስ ሳኦል ሀይቅዳይሳ በእድ፥ እካ ባ ማሻ ሳአን ኤስድ፥ እያ ቦላ ኩንድድ እያራ እስፈ ሀይቅስ። <verse eid="1SA 31:5"/><verse number="6" style="v" sid="1SA 31:6"/>ሀይሳዳ ሀንድ፥ ሳኦልነ እያ ሄ አደ ናይት፥ እያ ኦላ ሚሽያ ቶከይስነ እያ አሳት ኡባይ ሄ ጋላስ ሀይቅዶሶና።<verse eid="1SA 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 31:7"/>ዛንጋራንነ ዮርዳኖሰ ሻፋፐ ሄፍን ባጋራ ደእያ እስራኤለ አሳይ፥ እስራኤለ ኦላንቾት ባቃትዳይሳ፥ ሳኦልነ እያ ናይት ሀይቅዳይሳ በእድ ባንታ ካታማ አግድ ባቃትዶሶና። ፍልስፄመት ይድ፥ ሄ ካታማታ ኦይክዶሶና።<verse eid="1SA 31:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 31:8"/>ዎንተ ጋላስ ፍልስፄመት አሀ ቦላፈ ኦላ ሚሸታ ቃርድ ኤካናዉ ይድ፥ ሳኦልነ እያ ሄ አደ ናይት ግልቦአ ደርያ ቦላ ሀይቅድ ዝንእዳይሳታ ደምዶሶና። <verse eid="1SA 31:8"/><verse number="9" style="v" sid="1SA 31:9"/>ኤንቲ ሳኦላ ቆያ ቃንፅድ እያ ኦላ ሚሽያ ቃር ኤክዶሶና። ያትድ ባንታ ኤቃ ኬንነ ባንታ አሳ ግዶን ፆኑዋ አዋጃና መላ ፍልስፄመ ቢታ ኡባስ ኪታ የድዶሶና። <verse eid="1SA 31:9"/><verse number="10" style="v" sid="1SA 31:10"/>ሳኦላ ኦላ ሚሽያ አስታሮተ ጌተትያ ኤንታ ማጫ ፆሰ ኬን ዎዶሶና። ሳኦላ አሀ ቤት-ሳና ካታማ ግምብያ ቦላ ምስማረን ሽድ ካቅዶሶና።<verse eid="1SA 31:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 31:11"/>ፍልስፄመት ሳኦላ ኦዳባ ጋላዳን ደእያ ያበሳ አሳይ ስእዳ ዎደ፥ <verse eid="1SA 31:11"/><verse number="12" style="v" sid="1SA 31:12"/>ምኖ አሳት ቃማ ደንድ ብድ፥ ሳኦላ አሃነ እያ ናይታ አሀ ቤት-ሳና ካታማ ግምብያ ቦላፈ ዎስድ ያበሳ ካታማ ኤህድ፥ ያን ፁግዶሶና። <verse eid="1SA 31:12"/><verse number="13" style="v" sid="1SA 31:13"/>ሄሳፈ ጉየ፥ ኤንታ መቀ ማፅ ኤክድ፥ ያበሳን ደእያ ታማርስከ ም ጋርሳን ሞግዶሶና፤ ያትድ ላፑን ጋላስ ፆምዶሶና።<verse eid="1SA 31:13"/></para>
  <chapter eid="1SA 31"/>
</usx>
