<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">እብራወ ኪታ</para>
  <para style="toc1">እብራወ ኪታ</para>
  <para style="toc3">እብራ</para>
  <para style="toc2">እብራወ</para>
  <para style="mt1">እብራወ አሳስ</para>
  <para style="mt2">ፃፈትዳ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሀ ኪታይ ፃፈትዳይ፥ ዎልቃማ መቶይ ጋክን፥ ባንታ አማኑዋ አጋናዉ ማትዳ አማንያ አሳሳ። ሀ ማፃፋ ፃፈይ፥ የሱስ ክርስቶሲ ዉርሰነ ቱማ ፆሳ ቆንጨ ግደይሳ እብራወ አሳስ በሴስ። አማንያ አሳይ ባንታ አማኑዋን ምናና መላ ኤንታ ምንስ። እ ሄሳን ሄ አይፈ ቆፋታ ቆንጭስድ በሴስ።</para>
  <para style="ipi">1. የሱሲ ባ ኤክዳ መቱዋን አዋስ ቱማ ኪተትዳ መርና ፆሳ ናአ። እ ፆሳ ናአ ግድዳ ግሾ፥ ጋልአ ጫቁዋ ዎደ ደእያ ናበታፐ፥ ኪታንቾታፐነ ሙሰፐ ቦላ።</para>
  <para style="ipi">2. የሱሲ ጋልአ ጫቁዋ ካህነታፐ ዳሮ አያ መርና ካህነ ግደይሳ ፆሳይ ባ ሁጰን ማርካትስ።</para>
  <para style="ipi">3. የሱሳ ባጋራ አማንያ አስ ናጋራፐ፥ ያሻፈነ ሀይቆፐ አቴስ። የሱሲ ካህነ ሀላቃ ግደይሳዳ፥ ካሰ እብራወታ አማኖ ዎጋንነ መሄ ያርሾን ኩያዳ በንትያ አቶተ ኦሱዋ ሀእ ቱማ ኦስ።</para>
  <para style="ip">ፃፈይ እስራኤለ አሳ ታርከን ዳሮ ኤረትዳ አሳ አማኖ ሌምሶ ኦ ኤክድ (ሸም 11) ሀ ማፃፋ ናባብያ አሳይ ባንታ አማኑዋን ምናና መላ አኬክሴስ። ሄሳዳካ፥ ሸምፖ 12 ናባብያ አሳይ ባንታ አይፍያ የሱሳ ቦላ ዎድ፥ ባንታ አማኑዋን ምናና መላነ አይ መቶይነ ዋየይ ጋክኮካ፥ ገንጫና መላ ዞሬስ። ዉርሰን ዞረንነ አኬክሶ ቃላን ባ ኪታ ኩዬስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ፆሳይ ክርስቶሳ ባጋራ ቆንጭስ (<char style="ior"><ref loc="HEB 1:1-4">1:1-4</ref></char>)</para>
  <para style="io1">ክርስቶስ ኪታንቾታፐ ቦላ (<char style="ior"><ref loc="HEB 1:4-2:18">1:4—2:18</ref></char>)</para>
  <para style="io1">ክርስቶስ ሙሰፐነ እያሱፐ ቦላ (<char style="ior"><ref loc="HEB 3:1-4:13">3:1—4:13</ref></char>)</para>
  <para style="io1">ክርስቶሳ ካህነተይ ቦላ (<char style="ior"><ref loc="HEB 4:14-7:28">4:14—7:28</ref></char>)</para>
  <para style="io1">ክርስቶሳ ጫቆይ ቦላ (<char style="ior"><ref loc="HEB 8:1-9:22">8:1—9:22</ref></char>)</para>
  <para style="io1">ክርስቶሳ ያርሾይ ቦላ (<char style="ior"><ref loc="HEB 9:23-10:39">9:23—10:39</ref></char>)</para>
  <para style="io1">አማኖ ባይራተ (<char style="ior"><ref loc="HEB 11:1-12:29">11:1—12:29</ref></char>)</para>
  <para style="io1">ፆሰ ኡፋይስያ ደኦ (<char style="ior"><ref loc="HEB 13:1-19">13:1-19</ref></char>)</para>
  <para style="io1">አኬክሶነ ዞረ (<char style="ior"><ref loc="HEB 13:20-25">13:20-25</ref></char>)</para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s1">ናአይ ኪታንቾታፐ ቦላ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>ካሰ ፆሳይ፥ ኑ አዋታስ ናበታ ባጋራ ዱማ ዱማ ኦገን ዳሮ ዎደ ኦድስ። <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>ሽን ሀ ዉርሰ ዎድያን ኡባ እያ ላትስዳ ቃስ አላመ እያ ባጋራ መዳ ባ ናኣ ባጋራ ኑስ ኦድስ። <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>ናአይ ፆሳ ቦንቹዋ ጶለነ ኩመ ፆሳ ፆሳተ ኤክድ፥ ባ ዎልቃማ ቃላን ሀ አላምያ ካትስድ ኦይክስ። አሳ ኤንታ ናጋራፐ ጌሽዳፐ ጉየ ኡባፈ ቦላ ፆሳ ኡሻቻ ባጋን ሳሉዋን ኡትስ።<verse eid="HEB 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>እያዉ እመትዳ ሱንይ ኪታንቾታ ሱንፈ ቦላ ግደይሳዳ እ ኤንታፈ ቦላ። <verse eid="HEB 1:4"/><verse number="5" style="v" sid="HEB 1:5"/>ህዛ፥ ፆሳይ ኪታንቾታፐ ኦደኮ፥</para>
  <para style="q1" vid="HEB 1:5">“ኔኒ ታ ናአ፤</para>
  <para style="q2" vid="HEB 1:5">ታ ሀች ነዉ አዋ ግዳስ” ግዴ?</para>
  <para style="m" vid="HEB 1:5">ዎይኮ ቃስ ኦደኮ፥</para>
  <para style="q1" vid="HEB 1:5">“ታኒ እያዉ አዋ ግዳና፤</para>
  <para style="q2" vid="HEB 1:5">እካ ታዉ ናአ ግዳና” ግዴ?<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ማዝ 2:7</ref>፤ <ref loc="2SA 7:14">2 ሳሜ 7:14</ref>፤ <ref loc="1CH 17:13">1 ታር 17:13</ref>.</char></note><verse eid="HEB 1:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6"/>ቃስ ፆሳይ ባ ባይራ ናኣ ሀ አላምያ ኪትሸ፥</para>
  <para style="q1" vid="HEB 1:6">“ፆሳ ኪታንቾት ኡባይ እያዉ ጎይኖ”</para>
  <para style="m" vid="HEB 1:6">ያግስ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ዛረ 32:43</ref>.</char></note> <verse eid="HEB 1:6"/><verse number="7" style="v" sid="HEB 1:7"/>ፆሳይ ኪታንቾታባ ኦድሸ፥</para>
  <para style="q1" vid="HEB 1:7">“ፆሳይ ባ ኪታንቾታ ጫርኮ፥</para>
  <para style="q2" vid="HEB 1:7">ባ አይለታ ታማ ላጮ ኦስ”</para>
  <para style="m" vid="HEB 1:7">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">ማዝ 104:4</ref>.</char></note> <verse eid="HEB 1:7"/><verse number="8" style="v" sid="HEB 1:8"/>ሽን ባ ናአባ ኦድሸ፥</para>
  <para style="q1" vid="HEB 1:8">“ፆሳዉ፥ ነ አራታይ መርናዉ ደኤስ።</para>
  <para style="q2" vid="HEB 1:8">ነ ካዎተ ነ ፅሎተን አይሳሳ።<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="PSA 45:6-7">ማዝ 45:6-7</ref>.</char></note><verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>ኔኒ ፅሎተ ዶሳዳሳ፤ ኢታ እፃዳሳ።</para>
  <para style="q2" vid="HEB 1:9">ፆሳይ፥ ነ ጎዳይ፥ ነና ነ ላገታፐ አድ ዶርስ፥</para>
  <para style="q2" vid="HEB 1:9">ኡፋይሳ ዛይተ<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">ኡፋይሳ ዛይተ፦ </char><char style="ft" closed="false">እ ካዎትያ ዎደ አሳይ ኡፋይሳን እልልድ እያ ካዎይሳ በሴስ።</char></note> ነና ትይስ”</para>
  <para style="m" vid="HEB 1:9">ያጌስ። <verse eid="HEB 1:9"/><verse number="10" style="v" sid="HEB 1:10"/>ፆሳይ ዛሪድ፥</para>
  <para style="q1" vid="HEB 1:10">“ጎዳዉ፥ ኮይሮ ኔኒ ሳአ መዳሳ፤</para>
  <para style="q2" vid="HEB 1:10">ሳሎት ነ ኩሸ ኦሶ።<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">ማዝ 102:25-27</ref>.</char></note><verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>ሄሳት ኡባይ ያና፤</para>
  <para style="q2" vid="HEB 1:11">ሽን ኔኒ ዳና።</para>
  <para style="q2" vid="HEB 1:11">ኤንቲ ኡባይ አፍላዳ ዉራና።<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>ኔኒ ኤንታ ሳሌናዳ ፃፃና፤</para>
  <para style="q2" vid="HEB 1:12">ቃስ ኤንቲ አፍላዳ ላመታና።</para>
  <para style="q1" vid="HEB 1:12">ሽን ኔኒ ኡባ ዎደ ነና፤</para>
  <para style="q2" vid="HEB 1:12">ነ ላይይካ ዉረና”</para>
  <para style="m" vid="HEB 1:12">ያጌስ። <verse eid="HEB 1:12"/><verse number="13" style="v" sid="HEB 1:13"/>ሽን ፆሳይ ኪታንቾታፐ ኦደኮ፥</para>
  <para style="q1" vid="HEB 1:13">“ታኒ ነ ሞርከታ ነ ቶሆይ</para>
  <para style="q2" vid="HEB 1:13">የያሶ ኦና ጋካናዉ፥</para>
  <para style="q2" vid="HEB 1:13">ሀይሳን ታፐ ኡሻቻ ባጋን ኡታ” ግዴ?<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ 110:1</ref>.</char></note><verse eid="HEB 1:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14"/>ኪታንቾት ኡባይ አቶተ ደማናዉ ደእያ አሳታ ማዳናዉ ፆሳይ ኪትዳ አያናታ ግዶኮናዬ?<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">ግታ አንጆ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>ሄሳ ግሾ፥ ኑኒ ስእዳ ቱማፐ ሀራሶ ኤከቶና መላ ሄ ስእዳይሳ ምንድ ናጋናዉ በሴስ። <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>ህዛ፥ ኪታንቾታ ባጋራ ኦደትዳ ቃላይ ቱማ ግድኮ፥ እያ ናቆይነ ኪተቶና እፆይ ፕርዳ ኤህያባ ግድኮ፥ <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>ያትን፥ ኑኒ ሀይሳ መላ ግታ አቶተ እፃስ ጊኮ፥ ዋንድ አታኔ? ኮይሮ ጎዳይ ባ ሁጰን ሄ አቶተ ኦድስ፤ ቃስ እያፐ ስእዳይሳት ኑስ ጌሽድ ማርካትዶሶና። <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>ቃስ ፆሳይ ማላታታን፥ ኦራባታን፥ ዱማ ዱማ ማላታንነ ባ ሸንያዳ እምዳ ጌሻ አያና እሞታታን ማርካተ ምንስ።<verse eid="HEB 2:4"/></para>
  <para style="s1">የሱሲ አሰ ግድስ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>ፆሳይ ሀ ኑኒ ኦድያ ስንፈ ያና አላምያ፥ ኪታንቾታስ ሃርስቤና። <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>ጌሻ ማፃፋይ እስ በሳን ሀይሳዳ ያጌስ፦</para>
  <para style="q1" vid="HEB 2:6">“ኔኒ አሳስ ቆፓናዉ አስ አይቤ?</para>
  <para style="q2" vid="HEB 2:6">ዎይኮ ኔኒ እያ ናጋናዉ እ አይቤ?<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="PSA 8:4-6">ማዝ 8:4-6</ref>.</char></note><verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>ነ እያ ኪታንቾታፐ ጉ ዎደስ ጉዳሳ፤</para>
  <para style="q2" vid="HEB 2:7">እያ ሁጰን ቦንቾነ ሳባ ካላቻ ዎዳሳ።<verse eid="HEB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8"/>ቃስ ኡባባ እያ ቶሁዋፐ ጋርሳን ዎዳሳ”</para>
  <para style="m" vid="HEB 2:8">ያጌስ። ፆሳይ ኡባባ እያዉ ሃርስያ ዎደ እያዉ ሃረትቦናባይ አይብካ ባዋ። ሽን ሀእ ኡባባይ እያዉ ሃረትሽን ኑኒ በእቦኮ። <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>ሽን ኑኒ ኪታንቾታፐ ጉራ ጉፅዳ የሱሳ በኦስ። ፆሳ አ ኬሀተ ጋሶን የሱሲ አሳ ኡባስ ሀይቅስ። እ ዋየ ሀይቆ ሀይቅዳ ግሾ፥ ቦንቾነ ሳባ ካላቻ እያ ሁጰን ዎስ። <verse eid="HEB 2:9"/><verse number="10" style="v" sid="HEB 2:10"/>ኡባባይ እያዉነ እያ ጋሶን መትዳ ፆሳይ፥ ዳሮ ናይታ ባራ ቦንችሳናዉ ኤንታ አቶተ ሁጵያ፥ የሱሳ ዋየን ፖሎ ኦናዉ እያዉ በሴስ።<verse eid="HEB 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11"/>የሱሲነ ሄ እ ጌሽዳ አሳ ኡባይ እስ አዋ ናይታ። የሱሲ ኤንታ፥ “ታ እሻታ” ግድ ፄጋናዉ ዬላቶናይ ሄሳሳ። <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>የሱሲ፥</para>
  <para style="q1" vid="HEB 2:12">“ታኒ ነ ሱን ታ እሻታስ አዋጃና፤</para>
  <para style="q2" vid="HEB 2:12">ደርያ ሺቁዋን ነና ጋላታና”</para>
  <para style="m" vid="HEB 2:12">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">ማዝ 22:22</ref>.</char></note> <verse eid="HEB 2:12"/><verse number="13" style="v" sid="HEB 2:13"/>ቃስ እ፥ “ታኒ ታ አማኑዋ እያ ቦላ ዎና” ቃስካ፥ “ፆሳይ ታዉ እምዳ ናይታራ ታ ሀይሳን ደአይስ” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="ISA 8:17-18">እሳ 8:17-18</ref>.</char></note><verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>ናይት አሾይነ ሱ ደኤይሳታ ግድያ ግሾ፥ የሱሲካ ኤንታዳ አሰ ግድስ። እ ሄሳ ኦዳይ፥ ሀይቆ ቦላ ዎልቅ ደእያ ፃላህያ ባ ሀይቁዋን ይሳናሳ። <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>ቃስ ባንታ ደኦ ላይ ኡባን ሀይቆ ያሻን አይለትድ ደኤይሳታ አይለተፈ ዎዛናሳ።<verse eid="HEB 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 2:16"/>ቱማ የሱሲ ይዳይ አብራሃመ ኮቸ ማዳናሳፈ አትሽን፥ ኪታንቾታ ማዳናሳ ግደና።<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 41:8-9">እሳ 41:8-9</ref>.</char></note> <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>አሳ ናጋራይ አቶ ጌተታና መላ ፆሳ ስንን ማርያነ አማነትዳ ካህነ ሀላቃ ግድስ። ሄሳ ግሾ፥ እ ኡባባን ባ እሻታ ዳናናዉ በሴስ። <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>እ ባ ሁጰን ፓጨን ዋየትዳ ግሾ ፓጨተይሳታ ማዳናዉ ዳንዳኤስ።<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">የሱሲ ሙሰፐ ቦላ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>ሄሳ ግሾ፥ ፆሳይ ፄግዳ ጌሻ እሻቶ፥ ኑ አማኖን ጎዳ ግድ ፄግያ ሀዋርያነ ካህነ ሀላቃ የሱሳ በእተ። <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>ሙሰይ ፆሳ ኬ ኡባን አማነትዳይሳዳ የሱሲካ ባና ዶርዳ ፆሳስ አማነትዳይሳ። <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>ኬ ኬፀይስ ኬፈ አድ ቦንቸተይሳዳ የሱሲ ሙሰፐ አያ ቦንቾ ኤካናዉ በሴስ። <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>እስ እስ ኬ ኬፅዳ አስ ደኤስ፥ ሽን ኡባ ጊግስዳይ ፆሳ። <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>ሙሰይ ፆሳ ኬ ኡባን አማነትዳ አይለ ግድድ፥ ፆሳይ ስንፈ ጋናባስ ማርካ ግድስ። <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>ሽን ክርስቶስ ፆሳ ኬን ናአዳ አማነትዳይሳ። ኑኒ ኤካና ግድ ናግያ ኡፋይሳ ምንድ ናግኮ ፆሳ ኬ ግዶስ።<verse eid="HEB 3:6"/></para>
  <para style="s1">ፆሳ አሳስ ደእያ ሸምፖ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>ሄሳ ግሾ፥ ጌሻ አያናይ ገይሳዳ፥</para>
  <para style="q1" vid="HEB 3:7">“ሀች ህንተ ፆሳይ ገይሳ ስእያ ዎደ፥<verse eid="HEB 3:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8"/>መላ ቢታን ፓጭያ ጋላስ፥</para>
  <para style="q2" vid="HEB 3:8">ህንተ አዋት ማካልዳይሳዳ፥</para>
  <para style="q2" vid="HEB 3:8">ህንተ ዎዛና ምንፍተ።<verse eid="HEB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9"/>ህንተ አዋት ታና ፓጭዶሶና፤</para>
  <para style="q2" vid="HEB 3:9">ኦይታሙ ላይ ታ ኦሱዋ በእዶሶና።<verse eid="HEB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>ሄሳ ግሾ፥ ታ ሄ የለተ ሀንቀታዳ፥</para>
  <para style="q2" vid="HEB 3:10">‘ኤንቲ ኡባ ዎደ ባንታ ዎዛናን ባሎሶና፤</para>
  <para style="q2" vid="HEB 3:10">ታ ኦግያ ኤርቦኮና’ ያጋስ።<verse eid="HEB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11"/>ሄሳ ግሾ፥ ታኒ ታ ሀንቁዋን ጫቃዳ፥</para>
  <para style="q2" vid="HEB 3:11">‘ታ ሸምፖ በሳ ኡባካ ገሎኮና’ ያጋስ”<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">ማዝ 95:7-11</ref>.</char></note></para>
  <para style="m" vid="HEB 3:11">ያጌስ።<verse eid="HEB 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12"/>ታ እሻቶ፥ ህንተፈ ኦደንካ፥ ደኦ ፆሳፈ ህንተና ሻክያ ኢታነ አማኖና ዎዛን ዶና መላ ናገትተ። <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>ህንተፈ ኦናካ ናጋር ባለን፥ ባ ዎዛና ምንና መላ “ሀች” ያገትድ ፄገትሽን ጋላስ ጋላስ እሶይ እሱዋራ ዞረትተ። <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>ኑ ኮይሮ አማኑዋ ኑኒ ዉርሰ ጋካናዉ ምንድ ናግኮ፥ ክርስቶሳራ እስፈ ላታና። <verse eid="HEB 3:14"/><verse number="15" style="v" sid="HEB 3:15"/>ጌሻ ማፃፋን፥</para>
  <para style="q1" vid="HEB 3:15">“ሀች ፆሳይ ገይሳ ህንተ ስእያ ዎደ፥</para>
  <para style="q2" vid="HEB 3:15">ሄ ዎደ ኤንቲ ማካላተን ሀንዳይሳዳ፥</para>
  <para style="q2" vid="HEB 3:15">ህንተ ዎዛና ምንፍተ”</para>
  <para style="m" vid="HEB 3:15">ያግስ።<note caller="-" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">ማዝ 95:7-8</ref>.</char></note><verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>ፆሳይ ግያባ ስእድ ማካልዳይ ኦኔ? ሙሰይ ግብፀፈ ካለ ከስዳ ኡባ ግዶኮናዬ?<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">ታይቦ 14:1-35</ref>.</char></note> <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>ፆሳይ ኦይታሙ ላይ ኦና ሀንቀትዴ? ናጋራ ኦዳይሳታነ ኤንታ አሀይ መላ ቢታን ዎ አትዳ አሳታ ግዶኮናዬ? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>ቃስ ፆሳይ፥ “ታ ሸምፖ በሳ ገለከታ” ያግድ ጫቅዳይ፥ እያዉ ኪተቶና እፅዳ አሳፐ አትሽን፥ ኦደሴ? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>ህዛ፥ ኤንቲ ሄ ሸምፖ በሳ ገሎና አትዳይ አማንቦና ግሾ፥ ግደይሳ ኑ በኦስ።<verse eid="HEB 3:19"/></para>
  <para style="b"/>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>ህዛ፥ ፆሳይ ኑና ባ ሸምፖ በሳ ገልሳና ግዳ ቃላይ ቡሮ ስንፈ ደእያ ግሾ፥ ህንተፈ ኦንካ ሄ ሸምፖ በሳ ገሎና አቶና መላ ናገቶስ። <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>ኤንታዉ ዎንገላይ ሳባከትዳይሳዳ፥ ኑስካ ሳባከትስ። ሽን ኤንቲ ስእዳባ አማንድ ኤክቦና ግሾ ኤንታ ጎእቤና። <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>ግዶሽን፥ አላመይ መቶሳፐ ዶምድ ፆሳ ኦሶይ ፖለትዳይሳ ግድኮካ፥ ፆሳይ፥</para>
  <para style="q1" vid="HEB 4:3">“ታኒ ታ ሀንቁዋን ጫቃዳ፥</para>
  <para style="q2" vid="HEB 4:3">ታ ሸምፖ በሳ ኡባካ ገሎኮና”</para>
  <para style="m" vid="HEB 4:3">ግዳይሳዳ፥ ኑኒ አማንዳይሳት እያ ሸምፖ በሳ ገላና።<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">ማዝ 95:11</ref>.</char></note> <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>ላፑን ጋላሳባ እስ በሳን፥ “ፆሳይ ላፑን ጋላሳን ባ ኦሶ ኡባፈ ሸምፕስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">መ 2:2</ref>.</char></note> <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>ቃስካ ሄ በሳን፥ “ኤንቲ ታ ሸምፖ በሳ ኡባራካ ገሎኮና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">ማዝ 95:11</ref>.</char></note> <verse eid="HEB 4:5"/><verse number="6" style="v" sid="HEB 4:6"/>ኮይሮ ዎንገላ ስእዳይሳት ኪተቶና እፅድ ሸምፖ በሳ ገልቦኮና። ያንያ ግሾ፥ ሀእካ ሄ ሸምፖ በሳ ገላና እስ እስ አሳት ደኦሶና። <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>ሄሳ ግሾ፥ ፆሳይ፥ “ሀች” ግድ ፄግሸ እስ ጋላስ ኑስ ቃንፅስ። ዳሮ ዎደፐ ጉየ ፆሳይ ዳዊታ ባጋራ፥</para>
  <para style="q1" vid="HEB 4:7">“ፆሳይ ግያባ ሀች ህንተ ስእያ ዎደ፥</para>
  <para style="q2" vid="HEB 4:7">ህንተ ዎዛና ምንፍተ”</para>
  <para style="m" vid="HEB 4:7">ያግድ ኦድስ።<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">ማዝ 95:7-8</ref>.</char></note> <verse eid="HEB 4:7"/><verse number="8" style="v" sid="HEB 4:8"/>እያሱይ ኤንታዉ ሸምፑዋ እምዳባ ግድያኮ፥ ፆሳይ ሀራ ጋላሳባ ጉየፐ ኦደናሽን።<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 31:7">ዛረ 31:7</ref>፤ <ref loc="JOS 22:4">እያ 22:4</ref>.</char></note> <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>ህዛ፥ ፆሳ አሳስ ሳምባታ ሸምፖይ ናገትድ ደኤስ። <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>ፆሳ ሸምፖ በሳ ገልያ ኦንካ፥ ፆሳይ ባ ኦሱዋፐ ሸምፕዳይሳዳ እካ ባ ኦሱዋፐ ሸምፓና።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="GEN 2:2">መ 2:2</ref>.</char></note> <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>ሄሳ ግሾ፥ ኦንካ ሄ አሳ ኪተተ እፁዋ ካልድ፥ ኩንዶናዳ ፆሳ ሸምፖ በሳ ገላናዉ ምኖስ።<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>ፆሳ ቃላይ ደኦነ ኦይሳ። ናምኡ ባጋራ ቃራትዳ ማሻፈካ አድ ኦጮ። እ ሸምፖ፥ አያና፥ ፃጶነ ኮልዘ ጋካናዉ ካንድ ጫዴስ። ቃስ አሳ ዎዛናን ደእያ ጌምዳ ቆፋነ አሙዋ ሻክድ ፕርዴስ። <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>ፆሳ ስንፈ ቆሰትያባይ አይባ መተካ ባዋ። እያ አይፈ ስንን ኡባባይ ቆንጨነ ካሎ ደኤስ። ኑኒ ዛሮ እማናዉ በሰይ እያ ስንና።<verse eid="HEB 4:13"/></para>
  <para style="s1">የሱሲ ግታ ካህነ ሀላቃ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>ህዛ፥ ሳሎ ከይዳ ግታ ካህነ ሀላቃይ፥ ፆሳ ናአይ የሱሲ፥ ኑስ ደእያ ግሾ፥ ኑ አማኑዋ ምንድ ናጎስ። <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>ኑ ካህነ ሀላቃይ ኑ ዳቡርያ ዎደ ኑስ ቃታናዉ ዳንዳኤይሳ። እ ኑዳ ኡባባን ፓጨትስፐ አትሽን፥ ናጋራ ኦቤና። <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>ህዛ፥ ማሮተ ኤካናዉነ ማደ ኮሽያ ዎደ አ ኬሀተ ደማናዉ አ ኬሀተይ ደእያሱዋ ፆሳ አራታኮ ያዮና ሺቆስ።<verse eid="HEB 4:16"/></para>
  <para style="b"/>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>እስ እስ ካህነ ሀላቅ አሳ ግዶፈ ዶረትድ፥ ፆሳራ ጋያባን አሳ ግሾ እሞታነ ናጋራ ያርሾ ያርሻናዉ ሹመቴስ። <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>እ ባ ሁጰን ዳቡራንቾ ግድያ ግሾ፥ ኤሮናይሳታስነ ባለይሳታስ ቃታናዉ ዳንዳኤስ። <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>እ ባ ናጋራ ግሾነ አሳ ኡባ ናጋራ ግሾ ያርሾ ያርሻናዉ በሰይ ሄሳሳ።<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ሌወ 9:7</ref>.</char></note><verse eid="HEB 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4"/>ኦንካ ሀ ቦንቹዋ ባዉ ኤካናዉ ዳንዳኤና፥ ሽን አሮን ካህነ ሀላቃ ግዳናዉ ፄግዳይሳዳ ፆሳን ፄገታናዉ በሴስ።<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="EXO 28:1">ከሳ 28:1</ref>.</char></note> <verse eid="HEB 5:4"/><verse number="5" style="v" sid="HEB 5:5"/>ሄሳዳካ፥ ክርስቶስ ካህነ ሀላቃ ግድያ ቦንቹዋ ባዉ ኤክቤና። ሽን ፆሳይ እያ፥</para>
  <para style="q1" vid="HEB 5:5">“ኔኒ ታ ናአ፤</para>
  <para style="q2" vid="HEB 5:5">ሀች ታ ነዉ አዋ ግዳስ”</para>
  <para style="m" vid="HEB 5:5">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ማዝ 2:7</ref>.</char></note> <verse eid="HEB 5:5"/><verse number="6" style="v" sid="HEB 5:6"/>ቃስ ሀራሶን፥</para>
  <para style="q1" vid="HEB 5:6">“ማልከፃደቅ ካህነ ግድዳይሳዳ፥</para>
  <para style="q2" vid="HEB 5:6">ኔኒ መርናዉ ካህነ ግዳና”</para>
  <para style="m" vid="HEB 5:6">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ 110:4</ref>.</char></note><verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>የሱሲ አሰ ግድድ ሀ አላምያን ደእያ ዎደ ባና ሀይቆፐ አሻናዉ ዳንዳእያ ፆሳ ዳሮ ዬሆንነ አፉን ዎስስ። እ፥ እያ ቦንችድ ኪተትዳ ግሾ ፆሳይ እያ ዎሳ ስእስ።<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="MAT 26:36-46">ማቶ 26:36-46</ref>፤ <ref loc="MRK 14:32-42">ማር 14:32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ 22:39-46</ref>.</char></note> <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>የሱሲ ፆሳ ናአ ግድኮካ ባ ዋየትዳ ዋያን ኪተተ ታማርስ። <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>ሄሳንካ፥ የሱሲ ባ ኦሱዋ ፖልዳፐ ጉየ ባዉ ኪተትያ ኡባይ መርና አቶተ ደማና መላ ጋሶ ግድስ። <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>ፆሳይ ማልከፃደቃ ሹምዳይሳዳ ካህነ ሀላቃ ኦድ እያ ሹምስ።<verse eid="HEB 5:10"/></para>
  <para style="s1">ህንተ አማኑዋን ዳቡሮፕተ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>ሀ ኑ ኦዳ ቦላ ጉጅ ኦዳናባይ ዳሮባይ ደኤስ፥ ሽን ህንተ አኬካይ ጉ ግድያ ግሾ ህንተዉ ኦድ ገልሳናዉ ዋይሴስ። <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>ህንተ ሀኖደ አስታማረ ግዳናዉ በሴስ፥ ሽን ፆሳ ቃላ ኮይሮ ትምርትያ ህንተና ዛር ታማርስያ ሀራ አስ ኮሼስ። ህንተ ምኖ ካ ማናዉ ዳንዳኦና ግሾ ማ ኮሼስ።<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CO 3:2">2 ቆሮ 3:2</ref>.</char></note> <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>ማ ፓሄትያ ኦንካ ዮጋ ናአ ግድያ ግሾ፥ ሎኦነ ኢታ ሻክ ኤረና። <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>ሽን ምኖ ካ ሎኦነ ኢታ ሻክ ኤርያ ካሃማ አሳሳ።<verse eid="HEB 5:14"/></para>
  <para style="b"/>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>ህዛ፥ ክርስቶሳባ ታማርስያ ኮይሮ ትምርትያ አግድ ክርስቶሳን ካሃማተኮ ቦስ። ሀይቆ ኦሶፐ ስሞባነ ፆሳ አማኖባ ኮይሮ ትምርትያኮ ጉየ ስሞኮ። <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>ሄሳዳካ፥ ፅንቃተታባ፥<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">ፅንቃተታባ፦ </char><char style="ft" closed="false">ሀ በሳን ፅንቃተታባ ጌተትዳይ ዱማ ዱማ ጌሾ ዎጋታባ ኦዳናሳ።</char></note> ኩሸ ዎሶባ፥ ሀይቆፐ ደንዶባነ መርና ፕርዳባ ዛር ታማሮኮ። <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>ፆሳይ ጊኮ ኑ ሄሳ ኦና።<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>እስ ቶሆ ፖኦይ ፖእዳይሳታ፥ ሳሎ እሞታ ኤክዳይሳታ፥ ጌሻ አያናን ሻከትዳይሳታ፥ <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>ሎኦ ፆሳ ቃላነ ስንፈ ያና አላምያ ዎልቃ በእዳይሳታ፥ <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>ጉየፐ ካድዳይሳታ ናጋራፐ ናምአን ዛራናዉ ዳንዳኤተና። አይስ ጊኮ፥ ኤንቲ ባንታ ዩዋስ ፆሳ ናኣ ዛር ካቅያ መላ ማስቃልያ ቦላ እያ ካቆሶናነ አሳ ስንን ካዉሾሶና።<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>ኡባ ዎደ እ ቦላ ቡክያ እራ ኡያዳ፥ ጎይዳ ኡራ ማድያ ካ እምያ ቢትያ ፆሳን አንጀትዳሮ። <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>ሽን አጉንነ ክንቾተ ዶልያ ቢትያ አይብባካ ማዱኩ፤ እዉ ባደይ ማታትስ፤ ዉርሰን ፁገታና።<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="GEN 3:17-18">መ 3:17-18</ref>.</char></note><verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>ኑ ሲቆ እሻቶ፥ ኑኒ ሀይሳዳ ኦድያባ ግድኮካ፥ ህንተና አቶተኮ ካለያ ሎኦባይ ህንተዉ ደኤይሳ ኤሮስ። <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>ፆሳይ ሱረ ፕርደይሳ። ፆሳይ፥ ህንተ ኦዳ ኦሱዋነ ካሰ ግድን ሀእካ አማነይሳታ ማድድ፥ እያዉ ደእያ ሲቁዋ በስዳይሳ ዶገና። <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>ህንተ ኡባይ ኡፋይሳን ናገይሳ ደማና ጋካናዉ ሀ ምኖተ ዉርሰ ጋካናዉ በሳና መላ ኑ አሞቶስ። <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>ህንተ አማኖንነ ዳንዳአን ናግያ ኡፋይሳ ላትያ አሳ ዳናና መላፐ አትሽን፥ አዛላ ግዳና መላ ኮዮኮ።<verse eid="HEB 6:12"/></para>
  <para style="s1">ፆሳ ኡፋይሳ ቃላይ ስሰና</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>ፆሳይ አብራሃመስ እማና ግድ ጫቅዳ ዎደ ባፐ አያ ሀር ግት ባይና ግሾ ባ ሁጰን ጫቅስ። <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>እያኮ፥ “ታኒ ነና አንጃና፤ ነ ዘረካ ዳርሳና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">መ 22:16-17</ref>.</char></note> <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>አብራሃመይ ዳንዳአን ናግድ ፆሳይ እማና ግዳ ኡፋይሳ ኤክስ።<verse eid="HEB 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16"/>አስ ጫቅሸ ባፐ ግታትያ ኡራን ጫቄስ፤ ሄ ጫቆይ ጌተትዳባ ምንድ፥ ፓላማ ኡባ ተቄስ። <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>ሄሳ ግሾ፥ ፆሳይ ባ ላመቶና ቆፋ ኡፋይሳ ቃላ ላተይሳታስ ቆንጭሳናዉ ኮይዳ ግሾ ጫቆን ምንስ። <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>ፆሳይ ዎርዶተና። እያ ኡፋይሳ ቃላይነ ጫቆይ፥ ናምአይካ ላመቶኮና። ሀ ናምኡባታን ኑ ስንን ደእያ ኡፋይሳ ኦይካናዉ ዳንዳአና መላ ገሸ ደማናዉ እያኮ ባቃትዳ ኑኒ፥ ዎልቃማ ምን ደማና።<verse eid="HEB 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 6:19"/>ሀ ኡፋይሳይ ኑ ሸምፑዋ፥ ማርካበይ ቃፆናዳ ምን ኦይክያ ብራታ መላ። ሄ ኡፋይሳይ ማጋራጁዋፈ ጉየ ባጋን ደእያ ጌሻ በሳ ገልስ።<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="LEV 16:2">ሌወ 16:2</ref>.</char></note> <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>የሱሲ ማልከፃደቃ ሹማተዳ መርናዉ ካህነ ሀላቃ ግድድ፥ ኑ ግሾ ኑፐ ስንትድ ሄ በሳ ገልስ።<note caller="-" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ 110:4</ref>.</char></note><verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">ካህንያ ማልከፃደቃ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>ማልከፃደቀይ፥ ሳሌማ ካዎይ፥ ኡባፈ ቦላ ፆሳ ካህነ። ሄ ማልከፃደቅ አብራሃመይ ካዎታ ኦል ፆንድ ስምሽን እያራ ጋሄትድ እያ አንጅስ።<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="GEN 14:17-20">መ 14:17-20</ref>.</char></note> <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>አብራሃመይ ባ ድእዳባ ኡባፈ እያዉ አስራታ ከስድ እሚስ። ማልከፃደቃ ሱንይ ኮይሮ “ፅሎተ ካዋ”፥ ናምአን፥ “ሳሌማ ካዎ” ብርሸይካ “ሳሮተ ካዋ” ጉሱ። <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>ማልከፃደቃስ አይያ ዎይኮ አዉ ዎይኮ ኮቻ ፓይዶይ ባዋ። እያ የለተስ ዶመ ዎይኮ እያ ደኡዋስ ዉርሰ ባዋ፥ ሽን ፆሳ ናአ ዳንድ መርናዉ ካህነ ግድስ።<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>ማልከፃደቅ አይ መላ ግቴኮ በእተ። ኑ አዋታ ማይዛይ፥ አብራሃመይ፥ ባ ደእዳባፐ እያዉ አስራታ እሚስ። <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>ካህነ ግድያ ሌወ ኮቻይ እስራኤለ አሳፐ፥ ሄስካ አብራሃመ ኮቸ ግድዳ ባንታ እሻታፐ አስራታ ኤካና መላ ህገይ ኪቴስ።<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ታይቦ 18:21</ref>.</char></note> <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>ማልከፃደቅ ሌወ ኮቸ ግዶና እፅኮካ አብራሃመፐ አስራታ ኤክስ፤ ኡፋይሳ ቃል ደእያ አብራሃመ አንጅስ። <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>ጉይ ግታን አንጀተይስ ፓላንና።<verse eid="HEB 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 7:8"/>እስ ባጋራ፥ አስራታ ኤከይሳት ሀይቅያ አሳታ፥ ሽን ሀራ ባጋራ አስራታ ኤከይስ ደኦን ደኤስ ያግድ ኦደትዳይሳ። <verse eid="HEB 7:8"/><verse number="9" style="v" sid="HEB 7:9"/>ህዛ፥ አስራታ ኤክያ ሌወይ፥ አብራሃመ ባጋራ አስራታ እሚስ ጋናዉ ዳንዳኤቴስ። <verse eid="HEB 7:9"/><verse number="10" style="v" sid="HEB 7:10"/>አይስ ጊኮ፥ ማልከፃደቅ አብራሃመራ ጋሄትያ ዎደ ሌወይ የለትቦናባ ግድኮካ፥ ባ ማይዛ አብራሃመ ጉልባታን ደኤስ።<verse eid="HEB 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>እስራኤለ አሳስ ህገይ ሌወ ካህነተ ባጋራ እመትስ። ሀ ሌወ ካህነተይ ፖሎ ግድዳባ ግድያኮ አሮናይሳ መላ ግዶናሽን፥ ማልከፃደቃ መላ ሀራ ካህነ ሹማናዉ አይስ ኮሽዴ? <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>ህዛ፥ ካህነት ላመትያ ዎደ ህገይካ ቃስ ላመታናዉ በሴስ። <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>ሀ ኑ እያባ ኦድያ ኡራይ ሀራ ኮቸ፤ እያ ሼሻፐ ኦንካ ያርሾ በሳን ካህነተን ኦቤና። <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>ኑ ጎዳይ ይሁዳ ሼሻፐ ይዳይስ ኤረትዳይሳ። ግዶሽን፥ ሙሰይ ካህነተባ ኦድሸ ይሁዳ ኮቻባ አይባካ ኦድቤና።<verse eid="HEB 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>ማልከፃደቃ መላ ሀራ ካህነይ ይዳባ ግድያኮ ሀ ኑ ኦድያባይ አድ ቆንጫና። <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>እ ካህነ ግድዳይ ዮና ደኦ ዎልቃናፐ አትሽን፥ እያ ማይዛ ህገንነ ዎጋን ግደና። <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>ጌሻ ማፃፋይ፥</para>
  <para style="q1" vid="HEB 7:17">“ማልከፃደቃ ካህነተ መላ፥</para>
  <para style="q2" vid="HEB 7:17">ኔኒ መርናዉ ካህነ”</para>
  <para style="m" vid="HEB 7:17">ያግድ ማርካቴስ።<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ 110:4</ref>.</char></note> <verse eid="HEB 7:17"/><verse number="18" style="v" sid="HEB 7:18"/>ኮይሮ ህገይ ዳቡራንቾነ ማዶናባ ግድያ ግሾ ሻረትስ። <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>ሙሰ ህገይ አይብንካ ፖሎ ኦናዉ ዳንዳእቤና። ሽን ኑኒ እያ ባጋራ ፆሳኮ ሺቅያ ኡባፈ አያ ኡፋይሳ ቃላይ ኑስ እመትስ።<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20"/>ክርስቶስ ካህነ ግድያ ዎደ ፆሳይ ጫቅስ፥ ሽን ሀራት ካህነ ግድዳ ዎደ ሄሳ መላ ጫቆይ ባዋ። <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>ሽን የሱሲ ጫቆን ካህነ ግድስ። ፆሳይ ያግድ ጫቅስ፤</para>
  <para style="q1" vid="HEB 7:21">“ጎዳይ ጫቅስ፤ እ ባ ቆፋ ላመና፤</para>
  <para style="q2" vid="HEB 7:21">‘ኔኒ መርና ካህነ’ ”</para>
  <para style="m" vid="HEB 7:21">ያግስ።<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ 110:4</ref>.</char></note> <verse eid="HEB 7:21"/><verse number="22" style="v" sid="HEB 7:22"/>ሀ ጫቁዋ ጋሶን የሱሲ ኑስ ኡባፈ አያ ቃላ ጫቁዋስ ዋሰ ግድስ።<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>ካህነተን ኦና መላ ሀይቆይ ኤንታ ድግዳ ግሾ ኮይሮ ካህነታ ታይቦይ ዳሮ። <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>ሽን የሱሲ መርናዉ ደእያ ግሾ እያ ካህነተ ሀሪ ላተና። <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>ሄሳ ግሾ፥ እ ኡባ ዎደ ኤንታ ግሾ ጋናታናዉ መርናዉ ደእያ ግሾ ፆሳኮ እያ ባጋራ የይሳታ ፖሎ አሻናዉ ዳንዳኤስ።<verse eid="HEB 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26"/>ህዛ፥ ኑስ ኮሽያባ እምያ፥ ጌሻይ፥ ቦረይነ ቱን ባይናይስ፥ ናጋራንቾታፐ ሻከትዳይስነ ሳሉዋፐ አድ ቅዳ ካህነ ሀላቃይ ኑስ ኮሼስ። <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>እ ሀንኮ ካህነ ሀላቃታ መላ ኮይሮ ባ ናጋራ ግሾ፥ ካልድ አሳ ናጋራ ግሾ ጋላስ ጋላስ ያርሾ ያርሻናዉ ኮሸና። እ ባና ያርሽዳ ዎደ ዛረና ኦገን እስ ቶሆ ባና ያርሽስ።<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ሌወ 9:7</ref>.</char></note> <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>ሙሰ ህገይ ዳቡራንቾ አሳ ካህነ ሀላቃ ኦድ ሹሜስ። ሽን ህግያፈ ጉየ ይዳ ጫቆ ቃላይ መርናዉ ፖሎ ግድዳ ፆሳ ናኣ ሹምስ።<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">የሱሲ ኑ ካህነ ሀላቃ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>ኑኒ ሃሳያ ግታባይ ሄሳ። ሳሉዋን ኡባፈ ቦላ ፆሳ አራታፐ ኡሻቻ ባጋን ኡትዳ ሀይሳ መላ ካህነ ሀላቃይ ኑስ ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ 110:1</ref>.</char></note> <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>እ አሳን ግዶናሽን፥ ጎዳን ኤቅዳ ቱማ ዱንካንያን ፆሳ ኬን ኦስ።<verse eid="HEB 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3"/>ካህነ ሀላቃ ኡባይ እሞነ ያርሾ ያርሻናዉ ሹመቴስ። ሄሳ ግሾ፥ ሀ ካህነይ ያርሻናዉ እስባይ ዳናዉ ኮሼስ። <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>ህገይ ኪተይሳዳ ያርሽያ ካህነት ደእያ ግሾ፥ ክርስቶስ ሳአን ደእያባ ግድያኮ እ ካህነ ግደና። <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>ኤንቲ ካህነተን ኦያ ዱንካነይ ሳሎን ደኤይሳስ ሌምሶነ ኩያ። ሙሰይ ዱንካንያ ኤስያ ዎደ ፆሳይ እያኮ፥ “ታኒ ነና ዙማ ቦላ በስዳ ሌምሱዋ ካላዳ ኦ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ታይቦ 18:21</ref>.</char></note> <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>ሽን የሱሲ ግዶ ግድድ ስገያ ጫቆይ፥ ኮይሮ ጫቁዋፐ አይሳዳ እ ኤክዳ ኦሶይ ኤንታይሳፈ አስ። ሄስ ኤቅዳይ አያ ጫቆ ቃላና።<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>ኮይሮ ጫቁዋን ባል ባይናባ ግድያኮ ናምአን ጫቆ ኮሸና። <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>ሽን ጎዳይ ኤንታ ቦርድ፥ ሀይሳዳ ያግስ፦</para>
  <para style="q1" vid="HEB 8:8">“ታኒ እስራኤለ አሳራነ ይሁዳ አሳራ</para>
  <para style="q2" vid="HEB 8:8">ኦራ ጫቆ ጫቅያ ዎደይ ያና።<note caller="-" style="x"><char style="xo" closed="false">8:8 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">ኤርም 31:31-34</ref>.</char></note><verse eid="HEB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9"/>ሄ ጫቆይ ታ ኤንታ አዋታ ግብፀ ቢታፈ ኩሽያ ኦይካዳ፥</para>
  <para style="q2" vid="HEB 8:9">ጎቻ ከስዳ ዎደ ኤንታራ ጫቅዳ ጫቁዋ መላ ግደና።</para>
  <para style="q1" vid="HEB 8:9">ኤንቲ ታ ጫቁዋን አማነትቦና ግሾ፥</para>
  <para style="q2" vid="HEB 8:9">ታኒ ኤንታ የጋ አጋስ ያጌስ ጎዳይ።<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>ሽን ህዛፐ ጉየ እስራኤለ አሳራ</para>
  <para style="q2" vid="HEB 8:10">ታ ጫቃና ጫቆይ ሀይሳ ያጌስ ጎዳይ።</para>
  <para style="q1" vid="HEB 8:10">ታኒ ታ ህግያ ኤንታ ጉግያን ዎና፤</para>
  <para style="q2" vid="HEB 8:10">ኤንታ ዎዛናን ፃፋና።</para>
  <para style="q1" vid="HEB 8:10">ታኒ ኤንታ ፆሳ ግዳና፤</para>
  <para style="q2" vid="HEB 8:10">ኤንትካ ታ አሰ ግዳና።<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>ኤንታፈ ኦንካ ባ ሾሩዋ ዎይኮ ባ እሻ፥</para>
  <para style="q2" vid="HEB 8:11">‘ጎዳ ኤራ’ ያግድ ታማርሰና።</para>
  <para style="q1" vid="HEB 8:11">ኤንቲ ጉፈ ግታ ጋካናዉ</para>
  <para style="q2" vid="HEB 8:11">ኡባይ ታና ኤራና።<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>ታኒ ኤንታ ናቁዋ አቶ ጋና፤</para>
  <para style="q2" vid="HEB 8:12">ኤንታ ናጋራ ዛራ ቆፕከ” ያጌስ።<verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>ፆሳይ ሀ ጫቁዋ “ኦራ” ግድ ፄግሸ ኮይሮይሳ ጋልእስስ። ህዛ፥ ጋልአይነ ጬጋይ ይያ ዎደይ ጋክስ።<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">ሳአ ፆሳ ኬን ደእያ ጎይኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>ኮይሮ ጫቁዋስ ፆሳ ጎይንያ ዎጋይነ ሳአ ፆሳ ኬይ ደኤስ። <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>ዱንካነይ ኤቅስ። እያን ፆምፐ ዎያ ኮጫይ፥ ፃርጴዛይነ ጎዳ ስንን ዎያ ኡይይ ደኤስ፤ ሄ በሳይ ጌሻ በሳ ጌተቴስ።<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="EXO 26:1-30">ከሳ 26:1-30</ref>፤ <ref loc="EXO 25:31-40">25:31-40</ref>.</char></note> <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>ናምአን ማጋራጁዋፈ ጉየ ባጋራ ደእያ በሳይ ኡባፈ ጌሻ በሳ ጌተቴስ።<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ከሳ 26:31-33</ref>.</char></note> <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>እያ ግዶን እፃነ ጩይስያ ዎርቃ ሳፅነይነ ዎርቃን ሜሸትዳ ጫቆ ታቦተይ ደኤስ። ሄ ጫቆ ታቦትያን ማናይ ደእያ ዎርቃ ፃሮይ፥ አጭዳ አሮና ፃምአይነ ሙሰ ህገይ ፃፈትዳ ናምኡ ሎቸ ሹቻት ደኦሶና።<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EXO 30:1-6">ከሳ 30:1-6</ref>፤ <ref loc="EXO 25:10-16">25:10-16</ref>፤ <ref loc="EXO 16:33">16:33</ref>፤ <ref loc="NUM 17:8-10">ታይቦ 17:8-10</ref>፤ <ref loc="EXO 25:16">ከሳ 25:16</ref>፤ <ref loc="DEU 10:3-5">ዛረ 10:3-5</ref>.</char></note> <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>ሄ ታቦትያፐ ቦላ ባጋራ አቶተ ካማ ባንታ ቀፍያን ገንያ ቦንቾ ክሩበት ደኦሶና። ሽን ሀእ ሄ ኡባ ቆንጭስድ ኦዳናዉ ዳንዳኦኮ።<note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">ከሳ 25:18-22</ref>.</char></note><verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>ሀ ኡባይ ሀይሳዳ ጊግዳፐ ጉየ፥ ካህነት ኡባ ዎደ ባንታ ኦሱዋ ኦናዉ ዱንካንያስ ኮይሮ ክፍልያ ገሎሶና።<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="NUM 18:2-6">ታይቦ 18:2-6</ref>.</char></note> <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>ሽን ካህነ ሀላቃ ፃላል ዱንካንያስ ናምአን ክፍልያ ላይፈ እስ ቶሆ ገሌስ። እ ያ ገልሸ ባ ናጋራ ግሾነ አሳይ ኤሮና ኦዳ ናጋራ ግሾ ሱ ያርሾ ኤኮና ገለና።<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="LEV 16:2-34">ሌወ 16:2-34</ref>.</char></note> <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>ኮይሮ ዱንካነይ ኤቅድ ደእሽን፥ ኡባፈ ጌሻ በሳ ኤፍያ ኦገይ ቡሮ ዶየትቦናይሳ ጌሻ አያናይ ሄሳን ኤርሴስ።<verse eid="HEB 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 9:9"/>ሄስ ሀ ዎድያስ ሌምሶ፤ ፆሳስ እመትያ እሞይነ ያርሾይ ጎይንያ ኡራ ካሀ ጌሻናዉ ዳንዳኦናይሳ ሀይስ በሴስ። <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>ሄሳት ሙሳባ፥ ኡሻባነ ዱማ ዱማ ሜቻ ዎጋታ ኦደይሳታ። ኤንቲ ኦራ ዎጋይ ያና ጋካናዉ ኦሰትያ ካረ ባጋ ዎጋታ።<verse eid="HEB 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>ሽን ክርስቶስ ሀእ ኑ ደምዳ ሎኦባታስ ካህነ ሀላቃ ግድድ ይስ። እ ገልዳ ዱንካነይ ግታነ ፖሎ ግድዳይሳ። ሄ ዱንካነይ አሳ ኩሸን ኦሰትቤና ቃስ ሀ አላምያባ ግደና። <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>ክርስቶስ ኡባፈ ጌሻ በሳ ገልያ ዎደ ዴሻ ሱነ ማር ሱ ኤክድ ገልቤና። ሽን መርና አቶተ እማናዉ ባ ሱ ኤክድ ዛረና ኦገን እስ ቶሆ ገልስ። <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>ዴሻ ሱይነ ኮርማ ሱይ፥ ፁገትዳ ኡሳ ብዶይ፥ ቱንዳ አሳ ቦላ ርጨትድ ኤንታና ጌሽያባ ግድኮ፥<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="LEV 16:15-16">ሌወ 16:15-16</ref>፤ <ref loc="NUM 19:9">ታይቦ 19:9</ref>፥ <ref loc="NUM 19:17-19">17-19</ref>.</char></note> <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>መርና ጌሻ አያና ባጋራ ቦረይ ባይና ያርሾ ኦድ፥ ፆሳስ ባና እምዳ ክርስቶሳ ሱይ፥ ደኦ ፆሳ ጎይናና መላ ሀይቆ ካለያ ኦሱዋፐ ኑ ካሀ ዋት አድ ጌሸኔ?<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>ሄሳ ግሾ፥ ፄገትዳይሳት ፆሳይ እምዳ መርና ላታ ኤካና መላ ክርስቶስ ኦራ ጫቁዋስ ግዶ ግድድ ስገይሳ ግድስ። ሄስ ሀንዳይ አሳይ ኮይሮ ጫቁዋፐ ጋርሳን ደእያ ዎደ ኦዳ ናጋራፐ ኤንታና ዎዛናዉ እ ሀይቅዳይሳና።<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>ህዛ፥ ኬከይ ደእኮ፥ ሄ ኬክዳ ኡራ ሀይቆይ ኤረታናዉ ኮሼስ። <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>ኬክዳ ኡራይ ሀይቅኮ እያ ኬከይ ምኔስ። ኬክዳ ኡራይ ሀይቆና አትኮ እያ ኬከይ ኦና።<verse eid="HEB 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 9:18"/>ሀር አቶሽን፥ ኮይሮ ጫቆይካ ሱ ባይና ምንቤና። <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>ሙሰይ ህገ ኪታ ኡባ አሳስ ኦድዳፐ ጉየ ማራ ሱነ ዴሻ ሱ ሃራ ዋላክድ፥ ዞኦ ዶርሳ እክሰነ ህሶጰ ውርጮ ኤክድ፥ ማፃፋ ቦላነ አሳ ቦላ ዉርፅስ።<note caller="-" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ከሳ 24:6-8</ref>.</char></note> <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>ሙሰይ አሳኮ፥ “ህንተ ናጋና መላ ፆሳይ ኪትዳ ሱ ጫቆይ ሀይሳ” ያግስ። <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>ሄሳዳካ፥ ዱንካንያ ቦላነ ኦያ ሚሸ ኡባ ቦላ ሱ ዉርፅስ።<note caller="-" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">ሌወ 8:15</ref>.</char></note> <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>ቱማካ ህገይ ገይሳዳ ጉባታፐ አትሽን፥ ኡባባይ ሱን ጌዬስ። ሱ ጉኮናሽን አቶተ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="LEV 17:11">ሌወ 17:11</ref>.</char></note><verse eid="HEB 9:22"/></para>
  <para style="s1">የሱሲ ፖሎ ያርሸትስ</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>ሳሉዋባስ ሌምሶ ግድዳይሳት ኡባይ መሄ ያርሾን ጌያናዉ ኮሼስ። ሽን ሳሎባት ባንታ ሁጰን ሄሳፈ አያ ያርሹዋን ጌያናዉ ኮሼስ።<verse eid="HEB 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 9:24"/>ክርስቶስ ቱማ ፆሳ ኬስ ሌምሶ ግድዳ፥ አሳ ኩሸን ኦሰትዳ ኡባፈ ጌሻ በሳ ገልቤና። ሽን እ ሀእ ኑ ግሾ፥ ፆሳ ስንን በንታናዉ ሳሉዋ ገልስ። <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>ካህነ ሀላቃይ ላይን ላይን ባ ሱ ግዶናይሳ ኤክድ፥ ኡባፈ ጌሻ በሳ ገሌስ። ሽን ክርስቶስ ዳሮ ቶሆ ባና ያርሻናዉ ሳሎ ገልቤና። <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>ሄሳዳ ሀንዳባ ግድያኮ፥ ክርስቶስ አላመይ መቶሳፐ ዶምድ ዳሮ ቶሆ ዋየታናዉ ኮሼስ። ሽን ሀእ ዎድያ ዉርሰን ናጋራ ድጋናዉ ባና ያርሽድ ዛረና ኦገን እስ ቶሆ በንትስ።<verse eid="HEB 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 9:27"/>አስ ኡባይ እስ ቶሆ ሀይቃናዉ ሄሳፈ ጉየ ፕርደታናዉ በሴስ። <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>ሄሳዳካ፥ ክርስቶስ ዳሮ አሳ ናጋራ ድጋናዉ እስ ቶሆ ያርሸትስ። ሽን እ ናጋራ ቶካናዉ ግዶናሽን፥ ባና ናገይሳታ አሻናዉ ናምአን ቆንጫና።<note caller="-" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">እሳ 53:12</ref>.</char></note><verse eid="HEB 9:28"/></para>
  <para style="b"/>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>ሙሰ ህገይ ያናዉ ደእያ ሎኦባታስ ኩያፐ አትሽን፥ ባ ሁጰን ዋና ግደና። ሄሳ ግሾ፥ ላይን ላይን ፓጨይ ባይና ያርሸትያ ያርሾይ ጎይናናዉ ሺቅያ አሳ ፖሎ ኦናዉ ዳንዳኤና። <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>ህገይ ኤንታ ፖሎ ኦናዉ ዳንዳእዳባ ግድያኮ ኤንቲ ያርሾ ያርሸይሳ አጋናሽን። ቃስ ጎይናናዉ ሺቅያ አሳይ ባንታ ናጋራፐ ጌያና፤ ኤንታ ካሀይካ ኤንታና ባላ ግድ ሞተና። <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>ሽን ሄ ያርሾት ላይን ላይን ናጋራ ቆፍሶሶና። <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>አይስ ጊኮ፥ ኮርማ ሱነ ዴሻ ሱ ናጋራ ድጋናዉ ዳንዳኤና።<verse eid="HEB 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5"/>ሄሳ ግሾ፥ ክርስቶስ ሀ አላምያ ይዳ ዎደ ሀይሳዳ ያግስ:<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">ማዝ 40:6-8</ref>.</char></note></para>
  <para style="q1" vid="HEB 10:5">“ኔኒ ያርሾነ እሞ ኮያባካ፤</para>
  <para style="q2" vid="HEB 10:5">ሽን ታዉ አሾ ጊግሳዳሳ።<verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>ኔኒ ፁሳ ያርሾንነ</para>
  <para style="q2" vid="HEB 10:6">ናጋራ ያርሾን ኡፋይታባካ።<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>ሄ ዎደ፥ ‘ታ ግሾ ማፃፋን ፃፈትዳይሳዳ፥</para>
  <para style="q2" vid="HEB 10:7">ጎዳዉ፥ ታኒ ነ ሸንያ ኦናዉ ያስ’ ያጋስ”</para>
  <para style="m" vid="HEB 10:7">ያግስ። <verse eid="HEB 10:7"/><verse number="8" style="v" sid="HEB 10:8"/>ያርሾይ ያርሸታና መላ ህገይ ኪትያባ ግድኮካ፥ ክርስቶስ ኮይሮ፥ “ኔኒ ያርሾነ እሞ፥ ፁሳ ያርሾነ ናጋራ ያርሾ ኮያባካ፤ ኤንታን ኡፋይታባካ” ያግስ። <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>ካልድካ እ፥ “ጎዳዉ፥ ሄኮ ታኒ ነ ሸንያ ኦናዉ ያስ” ያግስ። ሄሳ ግሾ፥ ክርስቶስ ናምአንዋ ኤሳናዉ ኮይሮይሳ ሻርስ። <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>የሱስ ክርስቶሲ ፆሳ ሸንያ ኦድ፥ ዛረና ኦገን እስ ቶሆ ባ አሹዋ ያርሽዳ ግሾ ኑኒ ጌይዳ።<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>ካህነ ኡባይ፥ ናጋራ ድጋናዉ ዳንዳኦና ሄ ያርሾታ ጋላስ ጋላስ ያርሽሸ ኤቅድ ባ ኦሱዋ ኦስ።<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="EXO 29:38">ከሳ 29:38</ref>.</char></note> <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>ሽን ክርስቶስ ኡባ ዎደስ ግድያ እስ ናጋራ ያርሹዋ ያርሽድ፥ ፆሳፈ ኡሻቻ ባጋን ኡትስ።<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ 110:1</ref>.</char></note> <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>ሄ ዎድያፐ ዶምድ እያ ሞርከት እያ ቶሆይ የያባ ኦና ጋካናዉ ናጌስ። <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>እ ዛረና ኦገን እስ ቶሆ ባና ያርሽዳ ያርሹዋን ጌሻታ መርናዉ ፖሎ ኦስ።<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>ቃስ ጌሻ አያናይ ኑስ ሀይሳ ማርካቴስ። ኮይሮ ሀይሳዳ ያግስ፦<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>“ሄ ጋላሳታፐ ጉየ፥</para>
  <para style="q2" vid="HEB 10:16">ታኒ ኤንታራ ጫቅያ ጫቆይ ሀይሳ፦</para>
  <para style="q1" vid="HEB 10:16">ታኒ ታ ህግያ ኤንታ ቆፋን ዎና፤</para>
  <para style="q2" vid="HEB 10:16">ኤንታ ዎዛናን ፃፋና”</para>
  <para style="m" vid="HEB 10:16">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="JER 31:33">ኤርም 31:33</ref>.</char></note> <verse eid="HEB 10:16"/><verse number="17" style="v" sid="HEB 10:17"/>ካልድካ፥</para>
  <para style="q1" vid="HEB 10:17">“ታኒ ኤንታ ናጋራነ</para>
  <para style="q2" vid="HEB 10:17">ኤንታ ኢታ ኦሱዋ ዛራ ቆፕከ”</para>
  <para style="m" vid="HEB 10:17">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="JER 31:34">ኤርም 31:34</ref>.</char></note> <verse eid="HEB 10:17"/><verse number="18" style="v" sid="HEB 10:18"/>ህዛ፥ ናጋር አቶ ጌተትዳፐ ጉየ ናጋራስ ያርሸትያ ያርሾ ኮሸና።<verse eid="HEB 10:18"/></para>
  <para style="s1">አነ ፆሳኮ ሺቆስ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>ህዛ፥ ታ እሻቶ፥ ኑኒ የሱሳ ሱ ባጋራ ኡባፈ ጌሻ በሳ ገላናዉ ኑስ ምኖተ ደኤስ። <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>ኑ ገላናይ ክርስቶስ ባ ማጋራጁዋ፥ ሄስካ ባ አሹዋ ባጋራ ኑስ ዶይዳ ኦራነ ደኦ ግድዳ ኦግያና። <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>ኑስ ፆሳ ኬ ቦላ ሹመትዳ ግታ ካህነ ሀላቃይ ደኤስ። <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>ኑኒ ኢታ ካሀፐ ጌያናዉ ኑ ዎዛና ዉርፀትድ፥ ኑ አሳተ ፅሎ ሃን ሜጨትድ፥ ሱረ ዎዛናንነ ፖሎ አማኖን ፆሳኮ ሺቆስ።<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="LEV 8:30">ሌወ 8:30</ref>፤ <ref loc="EZK 36:25">ህዝ 36:25</ref>.</char></note><verse eid="HEB 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 10:23"/>ኑስ ኡፋይሳ ቃላ እምዳ ፆሳይ አማነትዳይሳ ግድያ ግሾ ኑ ማርካትያ ኡፋይሳ ኡሻች ሀድርስ ጎና ምንድ ኦይኮስ። <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>እሶይ እሱዋ ሲቆስነ ሎኦ ኦሶስ ዋት ደንነኮ አነ ቆፖስ። <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>እሶት እሶት ሜዘ ኦድ ሺቀይሳ አግዳይሳዳ ኑኒ እስፈ ሺቀይሳ አጎኮ። ሽን ጎዳ ጋላሳይ ማታትዳይሳ ህንተ በእያ ግሾ ሄሳ ካሰይሳፈ አድ ኦተ።<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>ኑኒ ቱማ ኤራተ ኤክዳፐ ጉየ ኤርሸ ናጋራ ኦኮ፥ ህዛፐ ኑ ናጋራ ግሾ ያርሸታና ያርሾይ ባዋ። <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>ሽን ህዛ አትዳይ ያሽያ ፕርዳነ ፆሳ ሞርከታ ፁጋናዉ ጊግዳ ዎልቃማ ታማ።<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="ISA 26:11">እሳ 26:11</ref>.</char></note> <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>ሙሰ ህግያ ኪተቶና እፅዳ ኦንካ ናምኡ ዎይኮ ሄ አስ እያ ቦላ ማርካትኮ ቃይ ባይናሽን ሀይቄስ።<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ዛረ 17:6</ref>፤ <ref loc="DEU 19:15">19:15</ref>.</char></note> <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>ያትን፥ ፆሳ ናኣ ካዳ ኡራይ፥ ባና ጌሽዳ ፆሳ ጫቆ ሱ ቱናባዳ ቆፕዳ ኡራይ፥ ቃስ አ ኬሀተ አያና ጫይዳ ኡራይ፥ አይ መላ ኢታ ፕርዳ ኤካናዉ በሲያኮ አነ ቆፕተ።<verse eid="HEB 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 10:30"/>ህዛ፥ “ሀሎ ከሶይ ታባ፥ ታ ኩሸ ዛራና” ግዳይሳ ኑ ኤሮስ። ቃስካ፥ “ጎዳይ ባ አሳ ፕርዳና” ያግስ። <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>ደኦ ፆሳ ኩሸን ኩንደ ዳሮ ያሼስ።<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>ህንተዉ ፆሳ ፖኦይ ፖእዳፐ ጉየ ህንተ ዳሮ ዋየን፥ ግታ ባፀን ገንጭዳ በን ዎድያ ቆፕተ። <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>እስ እስ ቶሆ ህንተ አሳ ስንን ጫየትደታ፤ ጎደትደታ፤ እስ እስ ቶሆ ሄሳ መላ ዋየይ ጋክዳ አሳራ እስፈ ዋይደታ። <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>ቃሾን ደእያ አሳስካ ቃትደታ። ህንተዉ ሎኦነ ዮና ሻሎይ ሳሎን ደኤይሳ ህንተ ኤርዳ ግሾ ህንተ ሻሎይ ቦንቀትያ ዎደ ኡፋይሳን ዳንዳእደታ።<verse eid="HEB 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35"/>ሄሳ ግሾ፥ ግታ ዎይቶይ ደእያ ህንተ ምኖተ የጎፍተ። <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>ፆሳ ሸንያ ፖልድ፥ እ ህንተዉ እማና ግዳ ኡፋይሳ ኤካና ጋካናዉ ገንጫናዉ ኮሼስ። <verse eid="HEB 10:36"/><verse number="37" style="v" sid="HEB 10:37"/>ህዛ፥ ጌሻ ማፃፋን፥</para>
  <para style="q1" vid="HEB 10:37">“እ፥ ያና ግዳይስ ያና፤ ጋምኤና።<note caller="-" style="x"><char style="xo" closed="false">10:37 </char><char style="xt" closed="false"><ref loc="HEB 2:3-4">እብራ 2:3-4</ref>.</char></note><verse eid="HEB 10:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38"/>ሽን ታ ፅሎይ፥ ታናን አማነትድ ዳና፤</para>
  <para style="q2" vid="HEB 10:38">ኦንካ ጉየ ስምኮ ታና ኡፋይሰና”</para>
  <para style="m" vid="HEB 10:38">ያጌስ። <verse eid="HEB 10:38"/><verse number="39" style="v" sid="HEB 10:39"/>ኑኒ አማንድ አትያ አሳ ባጋፈ አትሽን፥ ጉየ ስሚድ ይያ አሳ ባጋ ግዶኮ።<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">አማኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>አማኖ ጉሳይ፥ ደማና ግድ ኡፋይሳን አማነትድ ናግያባነ ኑ በኦናባ በእያዳ ኦድ ኤክያባ። <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>በን አዋት አማኖን ፆሳፈ ማርካተ ኤክዶሶና።<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>አላመይ ፆሳ ቃላን መትዳይሳ ኑ አማኖን ኤሮስ። ቃስ በንትያባይ በንቶናባፐ መትስ።<note caller="-" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="GEN 1:1">መ 1:1</ref>፤ <ref loc="PSA 33:6">ማዝ 33:6</ref>፥ <ref loc="PSA 33:9">9</ref>፤ <ref loc="JHN 1:3">ዮሀ 1:3</ref>.</char></note><verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>አበል ቃየላፐ አያ ያርሾ ፆሳስ ያርሽዳይ አማኖና። ፆሳይ አበላ እሙዋ ኡፋይትድ ኤክዳ ዎደ እ ፅሎ ግድዳይሳ ማርካትስ። አበል ሀር አቶሽን፥ ሀይቅድካ ባ አማኑዋን ሀእ ጋካናዉ ኦዴስ።<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="GEN 4:3-10">መ 4:3-10</ref>.</char></note><verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>ሄኖከይ ሀይቆና ሳሎ ብዳይ አማኖና። ፆሳይ እያ ኤክዳ ግሾ ኦንካ እያ በአናዉ ዳንዳእቤና። ሄኖከይ ሳሎ ኤከታናፐ ስን እ ፆሳ ኡፋይስዳ አስ ግደይስ ኦደትስ።<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="GEN 5:21-24">መ 5:21-24</ref>.</char></note> <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>አማኖይ ባይና ኦንካ ፆሳ ኡፋይሳናዉ ዳንዳኤና። ፆሳኮ ያ ኦንካ ፆሳይ ደኤይሳነ ባና ኮየይሳታስ ዎይቶ እመይሳ አማናናዉ ኮሼስ።<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>ኖሄይ ቡሮ በንቶናባስ ፆሲ እያዉ ኦድዳ ዎደ ፆሳስ ያይድ፥ ባናነ ባ ሶ አሳ አሻናዉ አማኖን ማርካበ ኬፅስ። ያትድ ባ አማኑዋን አላመ ፕርድድ፥ አማኖን በንትያ ፅሎተ ፆሳፈ ኤክስ።<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 6:13-22">መ 6:13-22</ref>.</char></note><verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>አብራሃመይ ላታ ኦድ ኤካና ቢታ ባና መላ ፆሳይ እያ ፄግዳ ዎደ ሀር አቶሽን፥ እ አዉ ብያኮ ኤሮና እፅኮካ ኪተትዳይ አማኖና።<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 12:1-5">መ 12:1-5</ref>.</char></note> <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>አብራሃመይ ፆሳይ እያዉ እማና ግዳ ቢታን በተ አሳዳ ደእዳይ አማኖና። ፆሳይ ሄ እማና ግዳይሳ እያራ እስፈ ላታናው ደእያ ይሳቃራነ ያይቆባራ ዎላ ዱንካነን ደእስ።<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="GEN 35:27">መ 35:27</ref>.</char></note> <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>እ፥ ፆሳይ ቆፕድ ኬፅዳ ፃላ ባሶይ ደእያ ካታማ ናጌስ።<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>ሳራ ባ ሁጰን ጭምዳባ ግድኮካ ኡፋይስ እምዳ ፆሳይ አማነትዳይሳ ግደይሳ ኤርዳ ግሾ ቃንታናዉ ዎልቃ ደምዳይ አማኖና።<note caller="-" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="GEN 18:11-14">መ 18:11-14</ref>፤ <ref loc="GEN 21:2">21:2</ref>.</char></note> <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>ሄሳ ግሾ፥ ሀይቅዳ አስ ዳንያ እስ አድያፈ ሳሎ ፆልንቶ መላነ አባ ጋፃን ደእያ ታይቦይ ባይና ሻፈ መላ ዘረይ የለትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="GEN 15:5">መ 15:5</ref>፤ <ref loc="GEN 22:17">22:17</ref>፤ <ref loc="GEN 32:12">32:12</ref>.</char></note><verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>ሄ አሳ ኡባይ ባንታዉ ጌተትዳ ኡፋይሳ ቃላ ኤኮና አማኖን ሀይቅዶሶና። ሽን ሃሆራ ሄሳ በእድ፥ ደምዳዳ ኦድ፥ ኡፋይሳን ኤክዶሶና። ቃስ ኤንቲ ሳአን እማነ በተ አስ ግደይሳ ኤርዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="GEN 23:4">መ 23:4</ref>፤ <ref loc="1CH 29:15">1 ታር 29:15</ref>፤ <ref loc="PSA 39:12">ማዝ 39:12</ref>.</char></note> <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>ሄሳዳ ግያ አሳይ ባንታ ቢታ ናገይሳ ቆንጨን በሴስ። <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>ኤንቲ ሄ አግድ ከይዳ ቢታ ጉየ ቆፕዳባ ግድያኮ ጉየ ስማናዉ ዳንዳኦሶና። <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>ሽን ሀእ አድ ሎእያ ሳሎ ቢታ ላሞቶሶና። ሄሳ ግሾ፥ ፆሳይ ኤንታዉ ካታማ ጊግስዳ ግሾ፥ “ኤንታ ፆሳ” ጌተትድ ፄገታናዉ ዬላተና።<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>አብራሃመይ ፓጨትዳ ዎደ ይሳቃ ያርሽዳይ አማኖና። ሄ ኡፋይሳ ቃላ ኤክዳ አብራሃመይ ባ እስ ናኣ ያርሻናዉ ጊግስ።<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">መ 22:1-14</ref>.</char></note> <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>ፆሳይ አብራሃመኮ፥ “ነ ዘረይ ይሳቃ ባጋራ ፄገታና” ያግድ ኦድስ።<note caller="-" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">መ 21:12</ref>.</char></note> <verse eid="HEB 11:18"/><verse number="19" style="v" sid="HEB 11:19"/>ፆሳይ ሀይቆፐ ደንናዉ ዳንዳኤይሳ አብራሃመይ አማንዳ ግሾ፥ ይሳቃ ሀይቆፐ ፓፅ ደንድዳዳ ኦድ ዛር ኤክስ።<verse eid="HEB 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20"/>ይሳቅ ዎደፐ ሀናናባ ኤርድ ያይቆባነ ኤሳዌ አንጅዳይ አማኖና።<note caller="-" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="GEN 27:27-29">መ 27:27-29</ref>፥ <ref loc="GEN 27:39-40">39-40</ref>.</char></note><verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>ያይቆብ ሀይቃና ሀንሸ፥ እስ እስ ዮሰፋ ናይታ አንጅዳይነ ጉፈ ቦላ ካትድ ጎይንዳይ አማኖና።<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="GEN 47:3">መ 47:3</ref>፤ <ref loc="GEN 48:1-20">48:1-20</ref>.</char></note><verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>ዮሰፍ ሀይቃናዉ ማትዳ ዎደ እስራኤለ አሳይ ግብፀፈ ከያናይሳ ኦድዳይነ ባ መቀ ኦናባ ኤንታ ኪትዳይ አማኖና።<note caller="-" style="x"><char style="xo" closed="false">11:22 </char><char style="xt" closed="false"><ref loc="GEN 50:24-25">መ 50:24-25</ref>፤ <ref loc="EXO 13:19">ከሳ 13:19</ref>.</char></note><verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>ሙሰይ የለትዳፐ ጉየ እያ አያነ እያ አዋይ ማላ ሎኦ ናአ ግድዳይሳ በእድ ሄ አጌና ቆትዳይ አማኖና፤ ኤንቲ ካዋ አዋጁዋ ባብቦኮና።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="EXO 1:22">ከሳ 1:22</ref>፤ <ref loc="EXO 2:2">2:2</ref>.</char></note><verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>ሙሰይ ድጭዳፐ ጉየ ግብፀ ካዋ ናኤ ናአ ጌተታናይሳ እፅዳይ አማኖና።<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="EXO 2:10-12">ከሳ 2:10-12</ref>.</char></note> <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>ሙሰይ ናጋራን ጉ ዎደስ ኡፋይታናፐ፥ ፆሳ አሳራ ዋየ ኤካናይሳ ዶርስ። <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>እ ዎደፐ ደማና ዎይቱዋ ትሽ ኦድ ፄልዳ ግሾ፥ ግብፀ ሻሉዋፐ አድ ክርስቶሳ ግሾ ቦረታናይስ ዳሮ አያ ዱረተ ግድዳይሳ ኤርስ።<verse eid="HEB 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27"/>ሙሰይ ካዋ ሀንቁዋ ያዮና፥ ግብፀፈ ከይዳይ አማኖና። በንቶና ፆሳ በእዳ አሳዳ ሀንድ ባ ቆፋን ገንጭስ። <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>ሀይቆ ኤህያ ኪታንቾይ እስራኤለ አሳ ባይራ ናይታ ዎና መላ ሙሰይ ፓስካነ ሱ ዉርፀ ዎጋ ኦዳይ አማኖና።<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="EXO 12:21-30">ከሳ 12:21-30</ref>.</char></note><verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>እስራኤለ አሳይ መላ ቢታራ ሄመትያዳ ሄመትድ፥ ዞኦ አባ ፕንዳይ አማኖና። ሽን ግብፀ አሳይ ገላናዉ ፓጭድ በእያ ዎደ ሃይ ኤንታ ምትስ።<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">ከሳ 14:21-31</ref>.</char></note><verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>እስራኤለ አሳይ እያርኮ ካታማ ሹቻ ድርሳ ላፑን ጋላስ ዩይድ፥ ኩንድስዳይ አማኖና።<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JOS 6:12-21">እያ 6:12-21</ref>.</char></note> <verse eid="HEB 11:30"/><verse number="31" style="v" sid="HEB 11:31"/>ላይምያ ራኣባ ቢታ ዎቸይሳታ ሞክዳ ግሾ፥ ኪተቶና አሳራ ሀይቆና አትዳይ አማኖና።<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">እያ 2:1-21</ref>፤ <ref loc="JOS 6:22-25">6:22-25</ref>.</char></note><verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>ህዛ፥ ሀራ ታ አይ ጎ? ገድዮናባ፥ ባራቃባ፥ ሳምሶናባ፥ ዮፍታሄባ፥ ዳዊታባ፥ ሳሜላባ፥ ቃስ ናበታባ ኦዳናዉ ታዉ ዎደይ ግደና።<note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JDG 6:11-8:32">አይሰ 6:11—8:32</ref>፤ <ref loc="JDG 4:6-5:31">4:6—5:31</ref>፤ <ref loc="JDG 13:2-16">13:2-16</ref>፤ <ref loc="JDG 11:1-12">11:1-12</ref>፤ <ref loc="1SA 16:1">1 ሳሜ 16:1</ref>፤ <ref loc="1KI 2:11">1 ካዎ 2:11</ref>፤ <ref loc="1SA 1:1-25">1 ሳሜ 1:1-25</ref>.</char></note> <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>ኤንቲ አማኖን ካዎተታ ፆንዶሶና፤ ፅሎተን አይስዶሶና፤ ፆሳይ እማና ግዳ ኡፋይሳ ኤክዶሶና፤ ጋሞታ ዶና ጎርድዶሶና፤<note caller="-" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="DAN 6:1-27">ዳነ 6:1-27</ref>.</char></note> <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>ታማ ዎልቃ ቶይስዶሶና፤ ሞርከታ ማሻፈ አትዶሶና፤ ባንታ ዳቡራን ምንዶሶና፤ ኦላን ዎልቃማ ግድዶሶና፤ አላጋ ቶራ ጎድዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:34 </char><char style="xt" closed="false"><ref loc="DAN 3:1-30">ዳነ 3:1-30</ref>.</char></note> <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>ማጫሳት ባንታ ሀይቅዳይሳታ ሀይቆፐ ፓፅን ኤክዶሶና።</para>
  <para style="p" vid="HEB 11:35">ቃስ ሀራት አያ ሀይቆፐ ደንዱዋ ኤካናዉ ኮይድ ቃሾፐ ብለታናይሳ እፅዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:35 </char><char style="xt" closed="false"><ref loc="1KI 17:17-24">1 ካዎ 17:17-24</ref>፤ <ref loc="2KI 4:25-37">2 ካዎ 4:25-37</ref>.</char></note> <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>ሀራት አሳን ቦረትድ ልሶን ጋራፈትዶሶና፤ ሀራት ሳንላታን ቃሸትድ ቃሾ ኬን የገትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="1KI 22:26-27">1 ካዎ 22:26-27</ref>፤ <ref loc="2CH 18:25-26">2 ታር 18:25-26</ref>፤ <ref loc="JER 20:2">ኤርም 20:2</ref>፤ <ref loc="JER 37:15">37:15</ref>፤ <ref loc="JER 38:6">38:6</ref>.</char></note> <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>ኤንቲ ሹቻን ጫደትዶሶና፤ ማጋዘን ናምአ ከይድ ጳልቀትዶሶና፤ ፓጨትዶሶና፤ ማሻን ሀይቅዶሶና፤ ኤንታዉ ኡባባይ ይን መቶትዶሶና። ዶርሳ እተነ ዴሻ እተ ማእድ ዩይዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:37 </char><char style="xt" closed="false"><ref loc="2CH 24:21">2 ታር 24:21</ref>.</char></note> <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>ኤንታዉ ሀ አላመይ ጊጎና እፅን መላ ቢታን፥ ደረ ቦላ፥ ጎንጎሎንነ ኦላ ግዶን ዩይዶሶና።<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>ፆሳይ ኤንታ አማኑዋባ ማርካትኮካ፥ ሄ ኡባይ ጌተትዳ ኡፋይሳ ቃላ ኤክቦኮና። <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>ፆሳይ ኑስ ሎኦባ ቆፕ ዎዳ ግሾ ኤንቲ ኑኒ ባይና ፖሎ ግዶኮና።<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s1">ፆሳይ ኑስ አዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>ህዛ፥ ሻራዳ ኑ ዩሹዋን ዳርዳ ሀይሳ መላ ማርካት ኑ ማታን ደእያ ግሾ ኑና ብያ ኡባነ ኦይክድ ሃርያ ናጋራ ድግድ፥ ኑ ስንን ደእያ ጋደ ዎ ገንጫን ዎፆስ። <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>ኑ አማኑዋስ ኦገ ዶይዳይሳነ ኑ ዉርሰ ፖሉዋኮ ኑና ጋያ የሱሳ ቦላ ኑ አይፍያ ዎስ። የሱሲ ዎደፐ ደእያ ኡፋይሳ ግሾ ማስቃልያ ዋይያ ዳንዳእድ፥ ዬላ ሀይቁዋ ካድ፥ ፆሳፈ ኡሻቻ ባጋን ኡትስ።<verse eid="HEB 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3"/>ህዛ፥ ህንተ ዶጭድ ኡፋይስ ቃንፆና መላ ናጋራንቾታ እፁዋ ዳንዳእዳ የሱሳ ቆፕተ። <verse eid="HEB 12:3"/><verse number="4" style="v" sid="HEB 12:4"/>ናጋራራ ደእያ ባፅያን ቡሮ ሱ ጉሳና ጋካናዉ ኤቀትበከታ። <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>ፆሳይ ባ ቃላን፥ ባ ናይታዳ ህንተና ዞርዳይሳ ዶግደታ።<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="JOB 5:17">እዮ 5:17</ref>፤ <ref loc="PRO 3:11-12">ሌም 3:11-12</ref>.</char></note></para>
  <para style="q1" vid="HEB 12:5">“ታ ናአዉ፥ ፆሳ ሴራ ለቆፋ፤</para>
  <para style="q2" vid="HEB 12:5">እ ነና ሴርያ ዎደ ኡፋይስ ቃንፆፋ።<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>ጎዳይ ባ ዶስያ ኡራ ሴሬስ፤</para>
  <para style="q2" vid="HEB 12:6">ቃስ ባ ናአዳ ኤክያ ኡባ ጋራፈስ” ያጌስ።<verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>ፆሳይ ህንተና ባ ናይታዳ ሴርያ ዎደ ገንጭተ፤ አዋይ ሴሮና ናእ ኦኔ? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>ፆሳይ ባ ናይታ ኡባ ሴሬስ፤ ህንተ ሴረቶና እፅኮ ቱማ እያ ናይታ ግዶናሽን ባላኮ ናይታ። <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>ቃስ ኑና የልዳ ኑ አዋት ኑና ሴሮሶና፤ ኑካ ኤንታና ቦንቾስ። ያትን፥ ኑኒ ኑ አያና አዋስ ዋንድ አድ ሃረቶኮ? <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>ህዛ፥ ኑ አዋት ባንታዉ ሎኦ ዳንዳ መላ ጉ ዎደስ ኑና ሴርዶሶና። ሽን ፆሳይ ኑ ጎአስ፥ ኑ እያ ጌሻተን ሻከታና መላ ሴሬስ። <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>ኑኒ ሴረትያ ዎደ ይሎዬስፐ አትሽን፥ ኡፋይሰና። ሽን ጉየፐ ሴረተ ሜዘትዳ አሳስ ሴራይ፥ ሳሮይ ኩምዳ ፅሎተ አይፈ አይፍሴስ።<verse eid="HEB 12:11"/></para>
  <para style="s1">ዞረነ ናግሶ</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>ህዛ፥ ህንተ አርጋጭዳ ቀስያነ ህንተ ዳቡርዳ ጉልባታ ምንተ።<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">እሳ 35:3</ref>.</char></note> <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>ዎበይ ፓፃና መላፐ አትሽን፥ አድ መቆና መላ ህንተ ቶሁዋስ ሱረ ኦገ ጊግስተ።<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">ሌም 4:26</ref>.</char></note><verse eid="HEB 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>አሳ ኡባራ ሳሮ ዳናዉነ ጌሻተን ዳናዉ ምንተ፤ ጌሻተ ባይና ኦንካ ጎዳ በአናዉ ዳንዳኤና። <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>ህንተፈ ኦደስካ ፆሳ አ ኬሀተይ ፓጮናዳ፥ ቃስ ጫሞ አይፈ አይፍድ ዳሮ አሳ ቱንስያነ ይስያ ዘረዳ ግዶና መላ ናገትተ።<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="DEU 29:18">ዛረ 29:18</ref>.</char></note> <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>ህንተ ግዶን ላይማትያ አስ ዎይኮ እስ ቶሆ ምያ ካስ ባ ባይራተ ቶችድ ባይዝዳ ኤሳዌ መላ አስ ዶና መላ ናገትተ።<note caller="-" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="GEN 25:29-34">መ 25:29-34</ref>.</char></note> <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>ጉየፐ ኤሳዌይ ሄ አንጁዋ ኤካናዉ ኮይዳ ዎደ ድገትዳይሳ ኤሬታ። እ ሄ አንጁዋ አፉን ምንድ ኮይኮካ፥ ደማናዉ ዳንዳእቤና፤ እ ናጋራፐ ስማናዉ ቃዳ ደምቤና።<note caller="-" style="x"><char style="xo" closed="false">12:17 </char><char style="xt" closed="false"><ref loc="GEN 27:30-40">መ 27:30-40</ref>.</char></note><verse eid="HEB 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>ህንተ ኩሸን ቦሸትያ ሲና ደርያኮ፥ ኤፅያ ታማኮ፥ ማኮ፥ ጫጋናኮ፥ ጎትያኮ፥<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="EXO 4:11-12">ከሳ 4:11-12</ref>፤ <ref loc="EXO 19:16-22">19:16-22</ref>፤ <ref loc="EXO 20:18-21">20:18-21</ref>.</char></note> <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>ሞይዘ ፑኑኮ ዎይኮ ቃላይ ስኤትያ በሳኮ ይቤከታ። ሄ ቃላ ስእዳ አሳይ ሀራ ጉዣ ቃላ ስኦና መላ ዎስዶሶና። <verse eid="HEB 12:19"/><verse number="20" style="v" sid="HEB 12:20"/>አይስ ጊኮ፥ “ሀር አቶሽን፥ ዶእ ሄ ዙማ ቦችኮ፥ ሹቻን ጫደትድ ሀይቆ” ያግዳ ኪታ ኤንቲ ቶካናዉ ዳንዳእቦኮና።<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">ከሳ 19:12-13</ref>.</char></note> <verse eid="HEB 12:20"/><verse number="21" style="v" sid="HEB 12:21"/>ሄ ሀንያባይ ዳሮ ዳጋንያባ ግድዳ ግሾ ሙሰይካ፥ “ታኒ ያሻን ኮኮራስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">ዛረ 9:19</ref>.</char></note><verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>ሽን ህንተ ፅዮነ ዙማኮ፥ ደኦ ፆሳይ ደእያ የሩሳላመ ካታማኮ፥ እስፈ ሺቅድ ኡፋይትያ ዳሮ ሙኩሉ ኪታንቾታኮ ሳሉዋ ይደታ። <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>ኤንታ ሱንይ ሳሎን ፃፈትዳ ዎሳ ኬ ባይራ ናይታኮ፥ አሳ ኡባ ዳይና ግድዳ ፆሳኮ፥ ፖሎ ግድዳ ፅሎ አሳ አያናታኮ ይደታ። <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>ኦራ ጫቁዋስ ግዶ ግድድ ስገያ የሱሳኮ፥ አበላ ሱፈ አያባ ኦድያ ዉርፀትዳ ሱኮ ይደታ።<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="GEN 4:10">መ 4:10</ref>.</char></note><verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>ህንተዉ ኦድያ ኡራ ቃላ እፃስ ጎና መላ ናገትተ። ካሰይሳት ሳአን ግድድ ኦድዳ ኪታ ስኦና እፅድ፥ ከስ ኤክቦናባ ግድኮ፥ ያትን፥ ሳሎን ግድድ ኦድያ ቃላ ኑኒ እፃስ ጊኮ ዋንድ ከስ ኤካኔ?<note caller="-" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="EXO 20:22">ከሳ 20:22</ref>.</char></note> <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>ሄ ዎደ እያ ቃላይ ሳአ ቃስ። ሽን ሀእ ታኒ፥ “ሳአ ፃላላ ግዶናሽን፥ እስ ቶሆ ዛራዳ ሳሉዋካ ቃና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">ሀገ 2:6</ref>.</char></note> <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>“እስ ቶሆ ዛራዳ” ግያ ቃላይ ቃፆናባይ ምንድ ዳናይሳ፥ ቃስ ቃፅያ መትዳባት ያናይሳ በሴስ።<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>ኑኒ ቃፃናዉ ዳንዳኦና ካዎተ ኤክያ ግሾ ፆሳ ጋላቶስ፤ ፆሳ ኡፋይስያ ኦገን ቦንቾንነ ያሻተን እያ ጎይኖስ። <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>ህዛ፥ ኑ ፆሳይ ቱማ ፁግያ ታማ።<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">ዛረ 4:24</ref>.</char></note><verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">ዉርሰ ዞረ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>አማንያ አሳዳ እሶይ እሱዋራ ፖሎ ሲቀትተ። <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>እማ ሞከይሳ ዶጎፕተ። እስ እስ አሳት ሄሳዳ ኦሸ ኤሮና ኪታንቾታ ሞክዶሶና።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="GEN 18:1-8">መ 18:1-8</ref>፤ <ref loc="GEN 19:1-3">19:1-3</ref>.</char></note> <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>ቃሾን ደኤይሳታ ህንተካ ኤንታራ እስፈ ቃሾን ደእያዳ ኦድ ኤንታና ቆፕተ። ዋየ ኤክያ አሳራ እስፈ ህንተካ ዋየ ኤክያዳ ኦድ ኤንታና ቆፕተ።<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>ኤኮይነ ገሎይ አሳ ኡባ ማታን ቦንቸትዳባ ግዶ። ቃስ ፆሳይ ላይማተይሳታነ ላመይሳታ ፕርዳናዉ ደእያ ግሾ አዝናይነ ማችያ እሶይ እሱዋስ አማነታናዉ በሴስ።<verse eid="HEB 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5"/>ሚሸ ሲቆፐ ህንተና ናግተ፤ ህንተዉ ደእያባን አልተ። ፆሳይ፥ “ታኒ ነና ኡባራካ የግከ ዎይኮ አግከ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">ዛረ 31:6</ref>፥ <ref loc="DEU 31:8">8</ref>፤ <ref loc="JOS 1:5">እያ 1:5</ref>.</char></note> <verse eid="HEB 13:5"/><verse number="6" style="v" sid="HEB 13:6"/>ሄሳ ግሾ፥ ኑኒ አማነትድ፥</para>
  <para style="q1" vid="HEB 13:6">“ጎዳይ ታና ማደይሳ፤</para>
  <para style="q2" vid="HEB 13:6">ታ ያይከ፤ አስ ታና አይ ኦኔ?”</para>
  <para style="m" vid="HEB 13:6">ያጎስ።<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">ማዝ 118:6</ref>.</char></note><verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>ፆሳ ቃላ ኮይሮ ህንተዉ ኦድዳ ህንተና ካለይሳታ ቆፕተ። ኤንቲ ዋንድ ደእዳኮ ኤንታ ዱሳ በእድ ኤንታ አማኑዋ ካልተ።<verse eid="HEB 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 13:8"/>የሱስ ክርስቶሲ ዝነካ ሀችካ መርናዉካ ላመተና። <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>ዱማ ዱማ ኦራ ትምርተን ሀራሶ ብድ ዮፕተ፤ ቦፕተ። ኑ ዎዛናይ ፆሳ አ ኬሀተን ምናናዉ በሴስፐ አትሽን፥ ምን ጎኦና ካን ዎጋ ፖሎን ግዶፖ።<verse eid="HEB 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10"/>ሽን ዱንካንያ ግዶን ኦያ ካህነት ሄ ያርሾ ካፈ ማናዉ ኤንታዉ ማት ባይና ያርሾ በሳይ ኑስ ደኤስ። <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>ካህነ ሀላቃይ ናጋራ ያርሾስ መሄ ሱ ኤክድ ያርሻናዉ ኡባፈ ጌሻ በሳ ገሌስ። ሽን ሄ መህያ አሹዋ ድርሳፈ ካረን ፁጌስ።<note caller="-" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="LEV 16:27">ሌወ 16:27</ref>.</char></note> <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>ሄሳዳካ፥ የሱሲ ደርያ ናጋራፐ ባ ሱን ጌሻናዉ ካታማ ፐንግያፈ ካረን ዋየትስ። <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>ህዛ፥ ኑኒ ቦርያ ቶክድ ድርሳፈ ካረ እያኮ ከዮስ። <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>ህዛ፥ ኑስ ሀይሳን መርናዉ ደእያ ካታም ባዋ፥ ሽን ኑኒ ያና ካታማ ናጎስ።<verse eid="HEB 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15"/>ህዛ፥ የሱሳ ባጋራ ኡባ ዎደ እያ ሱንስ ማርካትያ መተርሻ ጋላታ ያርሾ ፆሳስ እሞስ። <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>ሎኦባ ኦሶነ ህንተዉ ደእያባፐ መቶትዳ አሳስ እሞ ዶጎፕተ። ህዛ፥ ሄሳ መላ ያርሾይ ፆሳ ኡፋይሴስ።<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>ህንተና ካለይሳታስ ኪተትተ፤ ኤንቲ ግያባ ኦተ። ኤንቲ ባንታ ኦያባስ ፆሳ ስንን ኦይሸታናዉ ደእያ ግሾ፥ ህንተና ሄሞሶና። ህንተ ኤንታዉ ኪተትኮ፥ ባንታ ኦሱዋ ኡፋይትድ ኦና፤ ሄስ ሀኖና እፅኮ፥ ኤንቲ አዛንሸ ኦና፤ ሄስ ህንተና አይብባካ ማደና።<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>ኑስ ፆሳ ዎስተ። ኑ ካሀይ ጌሽ፤ ኑ ኡባ ዎደ ሎኦባ ኦናዉ ኮዮስ። <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>ታኒ ህንተኮ ኤለሳዳ ያና መላ ህንተ ታዉ ምንድ ፆሳ ዎሳና መላ ታ ህንተና ሀዳራ ጋይስ።<verse eid="HEB 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>ሳሮተ ፆሳይ፥ ዶርሳ ሄምያ ኑ ጎዳ የሱሳ፥ ባ መርና ጫቆ ሱን ሀይቆፐ ደንዳይስ፥ <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>እያ ሸንያ ኦና መላ ሎኦባ ኡባን እ ህንተና ዳንጭሶ። እያ ኡፋይስያባ የሱስ ክርስቶሳ ባጋራ ኑናን ፆሳይ ኦ። የሱስ ክርስቶሳ ባጋራ ፆሳስ መርናፐ መርና ጋካናዉ ቦንቾይ ግዶ። አምንእ።<verse eid="HEB 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>ታ እሻቶ፥ ታ ሀ ዳብዳብያ ህንተዉ ቃንን ፃፍዳ ግሾ፥ ህንተ ታ ዞርያ ሳለቶና ኤካና መላ ታ ህንተና ዎሳይስ።<verse eid="HEB 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23"/>ኑ እሻይ፥ ፅሞትዮስ ቃሾፐ ብለትዳይሳ ኤርተ። እ ኤለስድ ታኮ ዪኮ ታ እያራ ህንተና ባዳ በአና።<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>ህንተና ካለይሳታነ አማንያ ኡባ ሳሮ ጊተ። ፃለፐ ይዳ አማንያ አሳይ ህንተና ሳሮ ያጎሶና።<verse eid="HEB 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>ፆሳ አ ኬሀተይ ህንተ ኡባራ ግዶ። አምንእ።<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
