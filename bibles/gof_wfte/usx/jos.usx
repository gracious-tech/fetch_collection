<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOS" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">እያሱ ማፃፋ</para>
  <para style="toc1">እያሱ ማፃፋ</para>
  <para style="toc3">እያ</para>
  <para style="toc2">እያሱ</para>
  <para style="mt">እያሱ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">እያሱ ማፃፋይ፥ እቻሹ ሙሰ ማፃፋታ ካልድ ፃፈትዳ ማፃፋ። እስራኤለ አሳይ ሙሰ በሳን ሹመትዳ እያሱይ ካለን፥ ኦላ ፆንድ፥ ካናነ ቢታ ዋት ኦይክዳኮ ኦድያ ታርከ። ሀ ማፃፋይ ሱንትዳይ፥ እስራኤለ አሳ ካለና መላ ሙሰ በሳን ሹመትዳ እያሱ ሱንና።</para>
  <para style="ip">እያሱ ማፃፋይ ፃፈትዳ ዋና ጋሶይ፥ ፆሳይ እስራኤለ አሳስ ካናነ ቢታ እማና ግድ ጫቅዳ ጫቁዋ ፖልዳ፥ አማንያ ፆስ ግደይሳ በሳናሳ (<char style="xt"><ref loc="JOS 23:14">23:14</ref></char>)። እስራኤለ አሳይ ሀእካ ዮርዳኖሰ ሻፋፐ ዉሎሀ ባጋን ደእያ ሞአበ ደንባን ዱንካንድ ደኦሶና (ዛረ 34:1)። እያሱ ማፃፋይ ሄ ክፍለታን ሻከቴስ።</para>
  <para style="ipi">1. ፆሳ ኪታን፥ እያሱይ ሙሰ በሳን ሹመተነ እስራኤለ አሳይ ካናነ ገላናዉ ጊገተ (<char style="xt"><ref loc="JOS 1:1-5:15">1:1—5:15</ref></char>) ኦዴስ። ፆሳይ እያሱኮ፥ “ህንተ ቶሆይ የያ በሲ ኡባ ህንተዉ እማስ” ያግስ።</para>
  <para style="ipi">2. እስራኤለ አሳይ ፆሰ ኪተትድ፥ ሚፃን ተቀትዳ ቢታ፥ ድረትዳ ካታማታነ ዳንጨትዳ ኦላንቾታ ቦላ ዋንድ ፆኖ ደምዳኮ ኦዴስ (<char style="xt"><ref loc="JOS 6:1-13:7">6:1—13:7</ref></char>)</para>
  <para style="ipi">3. እያሱይ ታማነ ናምኡ እስራኤለ ኮቻታስ ቢታ ግሹዋ፥ ካለባስ ላታ ቢታ እሙዋ፥ ባቃትድ አትያ ካታማታነ ሌወታስ እምዳ ካታማታ ፓድድ ኦድያ ክፍለ (<char style="xt"><ref loc="JOS 13:1-22:34">13:1—22:34</ref></char>)።</para>
  <para style="ip">ማፃፋይ ባ ቆፋ፥ እያሱይ ሻከታና ዎይኮ ሀይቃና ሀንሸ ኦደትዳ ኦዳን ፃፄስ። ዉርሰን፥ ማፃፋይ እያሱነ አላዛራ ሀይቁዋ በስድ ቃቼስ። ሀ ማፃፋ ቁልፐ ፅቅሰይ (<char style="xt"><ref loc="JOS 24:15">24:15</ref></char>) ቦላ፥ “ህንተ ጎይናና ፆሳ ሀች ዶርተ። ሽን ታኒ፥ ታ ሶ አሳራ ኑ ጎዳ ጎይናና” ግያ ክፍልያ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ዮርዳኖሰ ፕነነ እያርኮ ኦይከተ (<char style="ior"><ref loc="JOS 1:1-6:27">1:1—6:27</ref></char>)</para>
  <para style="io2">እያሱይ ሙሰ በሳን ሹመትስ (<char style="ior"><ref loc="JOS 1:1-18">1:1-18</ref></char>)</para>
  <para style="io2">ናምኡ ዎችያ አሳት እያርኮ ቡሳ (<char style="ior"><ref loc="JOS 2:1-24">2:1-24</ref></char>)</para>
  <para style="io2">ዮርዳኖሰ ፕነነ ቆፍሶ ሹቻታ (<char style="ior"><ref loc="JOS 3:1-5:1">3:1—5:1</ref></char>)</para>
  <para style="io2">ኦራ የለተይ ቃፃረትስ (<char style="ior"><ref loc="JOS 5:2-15">5:2-15</ref></char>)</para>
  <para style="io2">እያርኮነ ጋየ ካታማታ (<char style="ior"><ref loc="JOS 6:1-8:29">6:1—8:29</ref></char>)</para>
  <para style="io1">እስራኤለ አሳይ ካናነ ቢታ ኦይከ (<char style="ior"><ref loc="JOS 8:30-12:24">8:30—12:24</ref></char>)</para>
  <para style="io1">እስራኤለ አሳይ ኦይክቦና ቢታ (<char style="ior"><ref loc="JOS 13:1-7">13:1-7</ref></char>)</para>
  <para style="io1">ዮርዳኖሰፐ ዶሎሀ ባጋን ደእያ ቢታ (<char style="ior"><ref loc="JOS 13:8-33">13:8-33</ref></char>)</para>
  <para style="io1">ዮርዳኖሰፐ ዉሎሀ ባጋን ደእያ ቢታ (<char style="ior"><ref loc="JOS 14:1-19:51">14:1—19:51</ref></char>)</para>
  <para style="io1">ቆሰትድ አትያ ካታማታ (<char style="ior"><ref loc="JOS 20:1-9">20:1-9</ref></char>)</para>
  <para style="io1">ሌወታስ እመትዳ ካታማታ (<char style="ior"><ref loc="JOS 21:1-45">21:1-45</ref></char>)</para>
  <para style="io1">ዶሎሀፐ ይዳ ኮቻት ባንታ ቢታ ስሙዋ (<char style="ior"><ref loc="JOS 22:1-34">22:1-34</ref></char>)</para>
  <para style="io1">እያሱ ዉርሰ ኦዳነ ሀይቁዋ (<char style="ior"><ref loc="JOS 23:1-24:33">23:1—24:33</ref></char>)</para>
  <chapter number="1" style="c" sid="JOS 1"/>
  <para style="s1">ፆሳይ እያሱ ኪትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 1:1"/>ጎዳ አይለይ ሙሰይ ሀይቅዳፐ ጉየ፥ ጎዳይ ሙሰ ማድያ ናወ ናኣ እያሱ፥ ሀይሳዳ ያግስ፤ <verse eid="JOS 1:1"/><verse number="2" style="v" sid="JOS 1:2"/>“ታ አይለይ፥ ሙሰይ ሀይቅስ። ሄሳ ግሾ፥ ኔራነ ሀ አሳ ኡባይ ደንድድ፥ ታኒ እስራኤለ አሳስ እማናዉ ደእያ ቢታ ገላናዉ፥ ዮርዳኖሰ ሻፋ ፕንተ። <verse eid="JOS 1:2"/><verse number="3" style="v" sid="JOS 1:3"/>ታኒ ሙሰስ ኦድዳይሳዳ፥ ህንተ ቶሆይ የያሶ ኡባ ህንተዉ እማስ። <verse eid="JOS 1:3"/><verse number="4" style="v" sid="JOS 1:4"/>ህንተ ዛዋይ ዱገሀ ነገበ መላ ቢታፈ ደንድድ፥ ፑደሀን ደእያ ልባኖሰ ዙማ ጋካናሳ። ቃስ ዶሎሃ ባጋን ደእያ ኤፍራፂሳ ዎጋ ሻፋፐ ደንድድ፥ ህተታ ቢታ ኡባ ኤክድ ዉሎሀ ባጋን ደእያ መደትራነ አባ ጋካናሳ። <verse eid="JOS 1:4"/><verse number="5" style="v" sid="JOS 1:5"/>እያሱ፥ ነ ላይ ኡባን ኦንካ ኔራ ኤቀታናዉ ዳንዳኤና። ታኒ ሙሰራ ግድዳይሳዳ፥ ኔራካ ግዳና። ታኒ ነና የግከ፤ አግከ። <verse eid="JOS 1:5"/><verse number="6" style="v" sid="JOS 1:6"/>አይኮይ ባዋ ምና። ታኒ ኤንታ ማይዛታስ እማና ጋዳ ጫቅዳ ቢታ ኔን ሀ አሳ ላትሳና። <verse eid="JOS 1:6"/><verse number="7" style="v" sid="JOS 1:7"/>አይኮይ ባዋ ምና። ታ አይለይ ሙሰይ ነዉ እምዳ ህግያ ኡባ ምንዳ ናጋ። ኔን ብያ በሳ ኡባን ነዉ እንጀታና መላ እያፐ ኡሻች ዎይኮ ሀድርስ ጎፓ። <verse eid="JOS 1:7"/><verse number="8" style="v" sid="JOS 1:8"/>ሀ ህገ ማፃፋይ ነ ዶናፐ ሻከቶፎ። እያን ፃፈትዳባ ኡባ ምንዳ ናጋናዉ ጋላስነ ቃማ እያ ቆፓ። ሄሳ ነ ኦኮ፥ ነዉ ኡባባይ እንጀታናነ ፖለታና። <verse eid="JOS 1:8"/><verse number="9" style="v" sid="JOS 1:9"/>ነ ብያ በሳ ኡባን ታኒ ጎዳይ ነ ፆሳይ ኔራ ደእያ ግሾ፥ ባቦፋ፤ ህርጎፋ፤ ያጋዳ ነዉ ኦዳይስ” ያግስ።<verse eid="JOS 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 1:10"/>ሄሳፈ ጉየ፥ እያሱይ ደርያ ሀላቃታ ሀይሳዳ ያግስ፤ <verse eid="JOS 1:10"/><verse number="11" style="v" sid="JOS 1:11"/>“አሳይ ዱንካንድ ደእያ ጉታ ብድ፥ ሄ ጋላሳ ጋርሳን፥ ‘ጎዳይ፥ ህንተ ፆሳይ፥ ህንተዉ እምያ ቢታ ላታናዉ ዮርዳኖሰ ሻፋ ፕንያ ግሾ፥ ህንተዉ ሽንቀ ጊግስተ’ ያግድ ደርያስ ኦድተ” ያግስ።<verse eid="JOS 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 1:12"/>እያሱይ፥ ሮቤላነ ጋዳ ኮቻታ ቃስ ምናሰ ኮቻታፐ ባጋ ሀይሳዳ ያግስ፤ <verse eid="JOS 1:12"/><verse number="13" style="v" sid="JOS 1:13"/>“ጎዳይ፥ ህንተ ፆሳይ፥ ህንተና ሸምፕሳና፥ ሀ ቢታ ህንተዉ እማና ያግድ፥ ጎዳ አይለይ ሙሰይ ኦድዳይሳ ቆፕተ። <verse eid="JOS 1:13"/><verse number="14" style="v" sid="JOS 1:14"/>ህንተ ማቸት፥ ህንተ ናይትነ ህንተ መሄይ ዮርዳኖሰ ሻፋፐ ሀፍንን ሙሰይ ህንተዉ እምዳ ቢታን ደእሾና። ሽን ህንተ ኦላንቾት ባንታ ኦላ ሚሽያ ኦይክድ፥ ህንተ አሳፐ ስንትድ፥ ኦለታናዉ ዮርዳኖሰ ሻፋ ፕኖና። <verse eid="JOS 1:14"/><verse number="15" style="v" sid="JOS 1:15"/>ጎዳይ ህንተና ሸምፕስዳይሳዳ፥ ኤንታካ ሸምፕሳና ጋካናዉነ ጎዳይ ህንተ ፆሳይ ኤንታዉ እምያ ቢታ ኤንቲ ላታና ጋካናዉ፥ ኤንታ ማድተ፤ ኦለትተ። ያትድ፥ ስም ይድ፥ ዮርዳኖሰ ሻፋፐ ሀፍንን ዶሎሀ ባጋን፥ ጎዳ አይለይ ሙሰይ እምዳ ህንተ ቡዞ ቢታን ደእተ” ያግስ።<verse eid="JOS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 1:16"/>ኤንቲ ዛሪድ እያሱኮ፥ “ነ ኑና ኪትዳ ኡባ ኑኒ ኦና፤ ነ ኪትያሶ ኡባ ባና። <verse eid="JOS 1:16"/><verse number="17" style="v" sid="JOS 1:17"/>ኑኒ ሙሰስ ኡባባን ኪተትዳይሳዳ፥ ነዉካ ኪተታና። ጎዳይ፥ ነ ፆሳይ ሙሰራ ግድዳይሳዳ፥ ኔራካ ግዶ። <verse eid="JOS 1:17"/><verse number="18" style="v" sid="JOS 1:18"/>ኔራ ኤቀተይነ ነ ኪታ እፅያ ኦንካ ደእኮ፥ ሀይቆ። ግዶሽን ኔን ምና” ያግዶሶና።<verse eid="JOS 1:18"/></para>
  <chapter eid="JOS 1"/>
  <chapter number="2" style="c" sid="JOS 2"/>
  <para style="s1">ራቦነ ዎችያ አሳታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 2:1"/>ናወ ናአይ እያሱይ፥ ቢታ ዎች በእያ ናምኡ አሳታ ሴፅማ<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fk" closed="false">ሴፅማ </char><char style="ft" closed="false">ሀ ቃላይ እብራወ ዶናን ሶቃላ ጉሱ።</char></note> ጌተትያ በሳፈ ቆሳን ኪትሸ፥ “ብድ ቢታ ዎችተ፤ ቃስ እያርኮ ካታማ ዱማይድ ዎችተ” ያግድ ኪትስ።</para>
  <para style="p" vid="JOS 2:1">ኤንቲ ብድ፥ ራቦ ጌተትያ ላይማተን አቅያ አሰ ሶ አቃናዉ ገልዶሶና። <verse eid="JOS 2:1"/><verse number="2" style="v" sid="JOS 2:2"/>እያርኮ ካዎይ፥ “እስራኤለ አሳፐ ኪተትዳይሳት ሀ ቢታ ዎቻናዉ ሀች ቃማ ይዶሶና” ግያ ኦዳ ስእስ።<verse eid="JOS 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 2:3"/>ያትን፥ እያርኮ ካዎይ ራብኮ፥ “ነ ሶ ገልዳ አሳት ቢታ ዎቻናዉ ይዳ አስ ግድያ ግሾ፥ ኤንታና ከሳዳ እማ” ያግድ ኪትስ።<verse eid="JOS 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 2:4"/>ሽን ማጫስያ ሄ ናምኡ አሳታ ቆታዳ፥ “ኤ አሳት ታኮ ይዶሶና፥ ሽን ኤንቲ አዉፐ ይዳኮ ታ ኤርከ። <verse eid="JOS 2:4"/><verse number="5" style="v" sid="JOS 2:5"/>ኦማርስ ካታማ ፐንግያ ጎርዳና ሀንያ ዎደ፥ ኤንቲ ከይድ ብዶሶና። ኤንቲ አዉ ብዳኮ ታ ኤርከ። ኤለስድ ኤንታ ህንተ ካልኮ፥ ኦይካና” ያጋዳ ኤንታዉ ኦዳሱ። <verse eid="JOS 2:5"/><verse number="6" style="v" sid="JOS 2:6"/>ሽን እያ አሳታ ዳሳ ቦላ ከሳዳ ታልባ ጮይና ግዶን ቆሳሱ። <verse eid="JOS 2:6"/><verse number="7" style="v" sid="JOS 2:7"/>ያትን፥ ካዎይ ኪትዳ አሳት ዎቸይሳታ ኮይሸ፥ ዮርዳኖሰ ሻፋ ፕንያ ኦግያ ጋካናዉ ብዶሶና። ኤንቲ ካታማፐ ቡሮ ከይዳ መላ ካታማ ፐንገይ ጎርደትስ።<verse eid="JOS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 2:8"/>ዎቸይሳት ስካናፐ ካሰታዳ፥ እያ ኤንታኮ ከያዳ፥ <verse eid="JOS 2:8"/><verse number="9" style="v" sid="JOS 2:9"/>ሀይሳዳ ያጋሱ፤ “ጎዳይ ሀ ቢታ ህንተዉ እምዳይሳ ታ ኤራይስ። ጋሶይካ፥ ህንተፈ ደንድዳይሳን ግታ ያሻን አሳ ኡባይ ትልእስ። <verse eid="JOS 2:9"/><verse number="10" style="v" sid="JOS 2:10"/>ግብፀ ቢታፈ ህንተ ከይዳ ዎደ፥ ጎዳይ ህንተ ስንን ዞኦ አባ ዋት መልስዳኮ ኑ ስእዳ። ቃስ ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋራ ደእያ አሞረ ካዎታ ናምአታ፥ ስሆናነ ኦገ ህንተ ዋትድ ዎዳኮነ ኤንታ ካታማ ዋትድ ይስዳኮ ኑ ስእዳ። <verse eid="JOS 2:10"/><verse number="11" style="v" sid="JOS 2:11"/>ኑኒ ሄሳ ስእዳ ዎደ፥ ኑ ዎዛናይ ያሻን ትልእስ። ህዛ፥ ህንተ ጎዳይ፥ ፆሳይ ሳሉዋካ ሳኣካ ሃረይስ እያ ግደይሳ ኑ ኤርዳ። <verse eid="JOS 2:11"/><verse number="12" style="v" sid="JOS 2:12"/>ሄሳ ግሾ፥ ታ ህንተዉ ኬህዳይሳዳ ህንተ ታ አዋ ሶ አሳስ ኬሀናዳ ጎዳ ሱንን ጫቅተ። ሄሳስ አማንያ ማላ ታዉ እምተ። <verse eid="JOS 2:12"/><verse number="13" style="v" sid="JOS 2:13"/>ታ አዋነ ታ አይዉ፥ ታ እሻታነ ታ ምቸታ ኤታ ሶ አሳ ኡባ ዎኮ ግድ ጫቅተ” ያጋሱ።<verse eid="JOS 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 2:14"/>ሄ አሳት ዛሪድ፥ “ኑ ነዉ ጫቅዳ ጫቁዋ ፖሎና እፅኮ፥ ፆሳይ ኑና ዎ። ኑ ኦያባ ነ አሳስ ቆንጭሶና እፅኮ፥ ጎዳይ ሀ ቢታ ኑስ እምያ ዎደ፥ ኑኒ ነዉ አማነታናነ ኬሀና” ያግዶሶና።<verse eid="JOS 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 2:15"/>ራኣብ ኬይ ካታማ ግምበ ድርሳራ ኦይከትድ ኬፀትዳ ግሾ፥ ማስኮትያራ ዎዶሮ ዱገ የዳዳ፥ ኤንታና ዱገ ዎሳሱ። <verse eid="JOS 2:15"/><verse number="16" style="v" sid="JOS 2:16"/>ራኣባ ኤንታኮ፥ “ህንተና ኮየይሳት ደሞና መላ ደርያኮ፥ ብድ ኤንቲ ስማና ጋካናዉ ያን ሄ ጋላስ ቆሰትተ። ያን ስሚድ፥ ህንተ ብያ በሳ ባናዉ ዳንዳኤታ” ያጋሱ።<verse eid="JOS 2:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" sid="JOS 2:17-18"/>አሳት ዛሪድ፥ “ኑኒ ሀ ቢታ ኦይካናዉ ገልያ ዎደ፥ ሀ ዞኦ ዎዶሩዋ ነ ኑና ዎስዳ ማስኮትያን ቃቾና እፅኮነ ነ አዋ፥ ነ አይዉ፥ ነ እሻታነ ነ ሶ አሳ ኡባ ነ ሶ ሺሾና እፅኮ፥ ነ ኑና ጫቅስዳ ጫቆይ ኑስ ጎመ ግደና። <verse eid="JOS 2:17-18"/><verse number="19" style="v" sid="JOS 2:19"/>ኦንካ ነ ሶፐ ካረ ከይድ ሀይቅኮ፥ ሄስ እያ ጎመ። ኑኒ ሄሳስ ኦይሸቶኮ። ኔራ ሶን ደእሸ ኦንካ ቆሄትኮ፥ እያ ሱ ጎመይ ኑና ጋኮ። <verse eid="JOS 2:19"/><verse number="20" style="v" sid="JOS 2:20"/>ሽን ኑ ኦያባ ኔን አሳስ ቆንጭስኮ ኔን ኑና ጫቅስዳ ጫቆይ ኑስ ጎመ ግደና” ያግዶሶና።<verse eid="JOS 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 2:21"/>እያ ዛራዳ፥ “ህንተ ቃላዳ ሀኖ” ጋዳ ኤንታ ሞይዛሱ። ኤንቲ ብዳፐ ጉየ፥ ሄ ዞኦ ዎዶሩዋ ማስኮትያን ቃቻሱ።<verse eid="JOS 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 2:22"/>ኤንቲ ደርያኮ ብድ፥ ኤንታ ኮየይሳት እያርኮ ስማና ጋካናዉ ያን ሄ ጋላስ ቆሰትዶሶና። ኤንታ ኮየይሳት ኦገ ኡባን ኮይዶሶና፥ ሽን ደምቦኮና። <verse eid="JOS 2:22"/><verse number="23" style="v" sid="JOS 2:23"/>ሄሳፈ ጉየ ሄ ናምኡ አሳት ደርያፐ ዎዶሶና። ዮርዳኖሰ ፕንድ፥ ናወ ናኣ እያሱኮ ይድ፥ ባንታና ጋክዳባ ኡባ ኦድዶሶና። <verse eid="JOS 2:23"/><verse number="24" style="v" sid="JOS 2:24"/>ኤንቲ እያሱኮ፥ “ጎዳይ ቱማ ሄ ቢትዉ ኑስ አድ እምስ። ቃስ ሄ ቢታን ደእያ አሳ ኡባይ፥ ኑስ ያይድ ትልእዶሶና” ያግዶሶና።<verse eid="JOS 2:24"/></para>
  <chapter eid="JOS 2"/>
  <chapter number="3" style="c" sid="JOS 3"/>
  <para style="s1">እስራኤለ አሳይ ዮርዳኖሰ ፕነ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 3:1"/>ዎንተ ጋላስ፥ ዎንታ ጉራ እያሱይነ አሳይ ሴፅማ ጌተትያ በሳፈ ደንድድ፥ ዮርዳኖሰ ሻፋ ብድ፥ ፕኖና ያን ዱንካንዶሶና። <verse eid="JOS 3:1"/><verse number="2" style="v" sid="JOS 3:2"/>ሄ ጋላሳፐ ጉየ፥ ሀላቃት ኤንቲ ዱንካንዳ ጉታ ገልድ፥ <verse eid="JOS 3:2"/><verse number="3" style="v" sid="JOS 3:3"/>“ሌወ ኮቸ ግድዳ ካህነት ቶክዳ፥ ጎዳ፥ ህንተ ፆሳ ጫቆ ታቦትያ ህንተ በእዳ ዎደ ዱንካንዳ ጉታፐ ደንድድ ኤንታ ካልተ። <verse eid="JOS 3:3"/><verse number="4" style="v" sid="JOS 3:4"/>ህንተ ካሰ ሀ ኦግያራ ብድ ኤሮና ግሾ፥ ህንተ ባና ኦግያ ኤንቲ በሳና። ሽን ጫቆ ታቦትያኮ ሺቆፕተ። ህንተ ግዶንነ ጫቆ ታቦትያ ግዶን ናምኡ ሙኩሉ ዋ ግድያ ሃሆተ ደኦ” ያግድ ኦድዶሶና።<verse eid="JOS 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 3:5"/>እያሱይ አሳኮ፥ “ጎዳይ ዎንቶ ህንተ ግዶን ማላልስያባ ኦና ግሾ፥ ህንተናተ ጌሽተ” ያግስ። <verse eid="JOS 3:5"/><verse number="6" style="v" sid="JOS 3:6"/>ቃስ ካህነታስ፥ “ጫቆ ታቦትያ ቶክድ፥ አሳፐ ስን አተ” ያግድ ኪትስ። ካህነት ጫቆ ታቦትያ ቶክድ፥ አሳፐ ስን አዶሶና።<verse eid="JOS 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 3:7"/>ጎዳይ እያሱኮ፥ “ታኒ ሙሰራ ግድዳይሳዳ፥ ኔራካ ግዳናይሳ አሳ ኡባይ ኤራና መላ ሀች እስራኤለ ኡባ ስንን ነና ቁ ቁ ኦሶ ዶማና። <verse eid="JOS 3:7"/><verse number="8" style="v" sid="JOS 3:8"/>ኔን፥ ጫቆ ታቦትያ ቶክያ ካህነታስ፥ ‘ዮርዳኖሰ ሻፋ ዶና ጋክያ ዎደ ሃ ግዶ ገልድ ኤቅተ’ ጋዳ ኪታ” ያግስ።<verse eid="JOS 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 3:9"/>እያሱይ እስራኤለ አሳኮ፥ “ሃ ይድ ጎዳ፥ ህንተ ፆሳ ቃላ ስእተ። <verse eid="JOS 3:9"/><verse number="10" style="v" sid="JOS 3:10"/>ደኦ ፆሳይ ህንተ ግዶን ደኤይሳ ህንተ ኤራናይ፥ ካናነታ፥ ህተታ፥ ህወታ፥ ፓርዘታ፥ ገርገሰታ፥ አሞረታነ ያቡሰታ ህንተ ስንፈ እ ጎድድ ከሰይሳና። <verse eid="JOS 3:10"/><verse number="11" style="v" sid="JOS 3:11"/>ቢታ ኡባ ጎዳ ጫቆ ታቦተይ ህንተፈ ስንትድ፥ ዮርዳኖሰ ሻፋ ፕናና። <verse eid="JOS 3:11"/><verse number="12" style="v" sid="JOS 3:12"/>ህዛ ታማነ ናምኡ እስራኤለ ዘረታፐ እስ እስ አስ ዶርተ። <verse eid="JOS 3:12"/><verse number="13" style="v" sid="JOS 3:13"/>ቢታ ኡባ ጎዳ ጫቆ ታቦትያ ቶክዳ ካህነታ ቶሆይ ዮርዳኖሰ ሃ የያ ዎደ ሃይ ኤቃና። ቆሞፈ ዱገ ጎግያ ዮርዳኖሰ ሃይ እስ ቦላ ሺቅድ ዶረታና” ያግስ።<verse eid="JOS 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 3:14"/>አሳይ ዮርዳኖሰ ሻፋ ፕናናዉ ዱንካንዳ ጉታፐ ደንድያ ዎደ፥ ጫቆ ታቦትያ ቶክዳ ካህነት አሳ ስንን ቦሶና። <verse eid="JOS 3:14"/><verse number="15" style="v" sid="JOS 3:15"/>ካ ሺሽያ ዎደ ዮርዳኖሰ ሻፋይ መይሳዳ ክፅኮካ፥ ጫቆ ታቦትያ ቶክዳ ካህነት ዮርዳኖሰ ሻፋ ጋክድ፥ ኤንታ ቶሆይ ሃ ጋፃ የዳ ዎደ፥ <verse eid="JOS 3:15"/><verse number="16" style="v" sid="JOS 3:16"/>ቆሞፈ ዱገ ጎግያ ሃይ ኤቅስ። ዛርታና ማታን ደእያ አዳማ ካታማ ጋካናዉ ሺቅድ ዶረትስ። ዱገ ማፅነ አባኮ ጎግያ ሃይ ኤቅስ። ያንን፥ አሳይ እያርኮ ካታማ ፕንዶሶና። <verse eid="JOS 3:16"/><verse number="17" style="v" sid="JOS 3:17"/>እስራኤለ አሳይ መላ ቢታራ ፕንድ ዉራና ጋካናዉ ጎዳ ጫቆ ታቦትያ ቶክዳ ካህነት ዮርዳኖሰ ሻፋ ግዶን መላ ቢታን ኤቅዶሶና።<verse eid="JOS 3:17"/></para>
  <chapter eid="JOS 3"/>
  <chapter number="4" style="c" sid="JOS 4"/>
  <para style="s1">ሀሳይሶ ሹቻታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 4:1"/>አሳ ኡባይ ዮርዳኖሰ ፕንዳፐ ጉየ ጎዳይ እያሱኮ፥ <verse eid="JOS 4:1"/><verse number="2" style="v" sid="JOS 4:2"/>“እስ እስ እስራኤለ ኮቻፈ እስ እስ አስ ኤካዳ ታማነ ናምኡ አሳታ ዶራ። <verse eid="JOS 4:2"/><verse number="3" style="v" sid="JOS 4:3"/>ሄ አሳት ዮርዳኖሰ ሻፋ ግዶን ካህነት ኤቅዳ በሳፈ ታማነ ናምኡ ሹቻታ ኤካና መላነ ሄ ሹቻታ ሀች ህንተ ዱንካንድ አቅያ በሳን ዎና መላ ኦዳ” ያግስ።<verse eid="JOS 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 4:4"/>እያሱይ እስራኤለ ዘረታፐ ዶረትዳ ታማነ ናምኡ አሳታ ፄግስ። <verse eid="JOS 4:4"/><verse number="5" style="v" sid="JOS 4:5"/>ኤንታኮ፥ “ጎዳ ህንተ ፆሳ ጫቆ ታቦተይ ደእያ በሳ ጉየ ዮርዳኖሰ ሻፋ ገልድ፥ እስ እስ እስራኤለ ዘረታ ታይቦን ኡባይ እስ እስ ሹች ህንተ ሀሸን ቶክተ። <verse eid="JOS 4:5"/><verse number="6" style="v" sid="JOS 4:6"/>ሀ ሹቻት፥ ጎዳይ ሀች ኦዳባ ህንተና ቆፍስያ ማላታ ግዳና። ዎንቶ ህንተ ናይት፥ ‘ሀ ሹቻት አይብሴ?’ ያግድ ኦይችያ ዎደ፥ <verse eid="JOS 4:6"/><verse number="7" style="v" sid="JOS 4:7"/>ህንተ ዛሪድ፥ ‘ጎዳ ጫቆ ታቦተይ ፕንያ ዎደ ዮርዳኖሰ ሃይ ጎገ አግስ። ሄሳ ግሾ፥ ሀ ሹቻት ሀ በሳን ሀንዳባ እስራኤለ አሳ ኡባ ዎደ ቆፍስያባ ግዳና’ ” ያግስ።<verse eid="JOS 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 4:8"/>ሄ አሳት እያሱይ ኪትዳይሳዳ ኦዶሶና። ጎዳይ እያሱስ ኦድዳይሳዳ፥ እስራኤለ ዘረታ ታይቦን ዮርዳኖሰ ሻፋፐ ታማነ ናምኡ ሹቻታ ኤፍድ፥ ኤንቲ አቅያ በሳን ዎዶሶና። <verse eid="JOS 4:8"/><verse number="9" style="v" sid="JOS 4:9"/>እያሱይ፥ ካህነት ዮርዳኖሰ ሻፋን ጫቆ ታቦትያ ቶክድ፥ ኤቅዳ በሳን ታማነ ናምኡ ሹቻታ ኤስስ። ሄ ሹቻት ሀች ጋካናዉ ያን ደኦሶና። <verse eid="JOS 4:9"/><verse number="10" style="v" sid="JOS 4:10"/>ሙሰይ እያሱ ኪትዳይሳ መላ፥ ጎዳይ እያሱ ኪትዳባ ኡባይ ፖለታና ጋካናዉ፥ ጫቆ ታቦትያ ቶክዳ ካህነት ዮርዳኖሰ ሻፋን ኤቅድ ጋምእዶሶና። አሳይ ኤለስድ ሻፋ ፕንዶሶና። <verse eid="JOS 4:10"/><verse number="11" style="v" sid="JOS 4:11"/>አሳ ኡባይ፥ ፕንዳፐ ጉየ፥ ጎዳ ጫቆ ታቦትያ ቶክዳ ካህነት አሳፐ ስን አድ ካለዶሶና። <verse eid="JOS 4:11"/><verse number="12" style="v" sid="JOS 4:12"/>ሙሰይ ኪትዳይሳዳ፥ ሮቤላነ ጋዳ ኮቻት፥ ቃስ ምናሰ ኮቻፈ ባጋይ ኦላስ ዳንጨትድ፥ አሳፐ ስንትድ ፕንዶሶና። <verse eid="JOS 4:12"/><verse number="13" style="v" sid="JOS 4:13"/>ዳሮተን ኦይታሙ ሙኩሉ ግድያ ኦላንቾት፥ ጎዳ ስንን፥ እያርኮ ማታን ደእያ ደንባን ኦለታናዉ ሺቅዶሶና። <verse eid="JOS 4:13"/><verse number="14" style="v" sid="JOS 4:14"/>ሄ ጋላስ፥ ጎዳይ እያሱ እስራኤለ አሳ ኡባ ስንን ቁ ቁ ኦስ። ኤንቲ ሙሰ ቦንችዳይሳዳ እያሱካ እያ ደኦ ላይ ኡባን ቦንችዶሶና።<verse eid="JOS 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 4:15"/>ጎዳይ እያሱኮ፥ <verse eid="JOS 4:15"/><verse number="16" style="v" sid="JOS 4:16"/>“ጫቆ ታቦትያ ቶክዳ ካህነት ዮርዳኖሰ ሻፋፐ ከያና መላ ኦዳ” ያግስ። <verse eid="JOS 4:16"/><verse number="17" style="v" sid="JOS 4:17"/>እያሱይ ካህነት ዮርዳኖሰ ሻፋፐ ከያና መላ ኦድስ። <verse eid="JOS 4:17"/><verse number="18" style="v" sid="JOS 4:18"/>ጎዳ ጫቆ ታቦትያ ቶክዳ ካህነት ዮርዳኖሰ ሻፋፐ ከይዶሶና። ኤንታ ቶሆይ መላ ቢታ የዳ ዎደ ኤለስድ፥ ዮርዳኖሰ ሃይ ባ በሳ ስሚድ፥ ካሰ ጎገይሳዳ ጋፃ ጋክድ ጎገ ኦይክስ።<verse eid="JOS 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 4:19"/>አሳይ ኮይሮ አጌናን ታማን ጋላሳን ዮርዳኖሰ ሻፋ ፕንድ፥ እያርኮስ ዶሎሀ ባጋን ደእያ ጋልጋላን ዱንካንዶሶና። <verse eid="JOS 4:19"/><verse number="20" style="v" sid="JOS 4:20"/>እያሱይ ዮርዳኖሰ ሻፋፐ ኤከትዳ ታማነ ናምኡ ሹቻታ ጋልጋላን ኤስድ፥ <verse eid="JOS 4:20"/><verse number="21" style="v" sid="JOS 4:21"/>እስራኤለ አሳኮ ሀይሳዳ ያግስ፤ “ዎንቶ ህንተ ናይት፥ ‘ሀ ሹቻት አይብሴ?’ ያግድ ህንተና ኦይችያ ዎደ፥ <verse eid="JOS 4:21"/><verse number="22" style="v" sid="JOS 4:22"/>‘እስራኤለ አሳይ ዮርዳኖሰ ሻፋ መላ ቢታራ የድ ፕንዳይሳ ቆፍስያባ’ ያግድ ኦዴታ። <verse eid="JOS 4:22"/><verse number="23" style="v" sid="JOS 4:23"/>ኑኒ ፕናና ጋካናዉ፥ ጎዳይ፥ ኑ ፆሳይ ዞኦ አባ ካሰ ኑ ስንን መልስዳይሳዳ፥ ህንተካ ፕናና ጋካናስ፥ ጎዳይ፥ ህንተ ፆሳይ ዮርዳኖሰ ሻፋ ህንተ ስንን መልስዳይሳ ኦድተ። <verse eid="JOS 4:23"/><verse number="24" style="v" sid="JOS 4:24"/>ሄሳ ግሾ፥ ቢታን ደእያ አሳ ኡባይ፥ ጎዳ ዎልቃይ አይ መላ ግቴኮ ኤራና፤ ህንተካ ጎዳ፥ ህንተ ፆሳ፥ መርናዉ ቦንቻና” ያግስ።<verse eid="JOS 4:24"/></para>
  <chapter eid="JOS 4"/>
  <chapter number="5" style="c" sid="JOS 5"/>
  <para style="s1">እስራኤለ አሳ ቃፃረተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 5:1"/>ዮርዳኖሰ ሻፋፐ ዉሎሀ ባጋን ደእያ አሞረታ ካዎትነ መደትራነ አባ ላንቀን ደእያ ካናነታ ካዎት ኡባይ፥ እስራኤለ አሳይ ፕናና ጋካናስ ዮርዳኖሰ ሻፋ ጎዳይ ዋት መልስዳኮ ስእዳ ዎደ ኤንታ ዎዛናይ ትልእን፥ እስራኤለ አሳራ ኤቀታናዉ ፃላተ ይዶሶና።<verse eid="JOS 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 5:2"/>ሄ ዎደ ጎዳይ እያሱኮ፥ “ሳሎ ሹቹ ቃራያዳ እስራኤለ አደ አሳ ናምአን ቃፃራ” ያግስ። <verse eid="JOS 5:2"/><verse number="3" style="v" sid="JOS 5:3"/>እያሱይ ቃራ ሳሎ ሹቻ ኤክድ፥ “ቃፃራ ደረ” ጌተትያ በሳን እስራኤለታ ቃፃርስ። <verse eid="JOS 5:3"/><verse number="4" style="v" sid="JOS 5:4"/>እ ሄሳ ኦዳይ፥ ግብፀፈ ከይዳ አደታን ላይ ኦላስ ጋክዳ ኡባይ መላ ቢታን ሀይቅ ዉርዳ ግሾሳ። <verse eid="JOS 5:4"/><verse number="5" style="v" sid="JOS 5:5"/>ግብፀፈ ከይዳ አደ አሳ ኡባይ፥ ቃፃረትዶሶና፥ ሽን ግብፀፈ ብሸ መላ ቢታን የለትዳ አደ ናይት ቃፃረትቦኮና። <verse eid="JOS 5:5"/><verse number="6" style="v" sid="JOS 5:6"/>ግብፀፈ ከይያ ዎደ ላይ ኦላስ ጋክዳ አደ አሳ ኡባይ ጎዳስ ኪተቶና እፅዳ ግሾ፥ ኤንቲ ሀይቅድ ዉራና ጋካናስ እስራኤለት መላ ቢታን ኦይታሙ ላይ ዩይዶሶና። ጎዳይ፥ ኑስ እማና ግድ ኤንታ ማይዛታስ ጫቅዳ ኤስነ ማ ጎግያ አራዳ ቢታ ሀይቅዳ ኤንታ ናይት ላቶና መላ ካሰ ጫቅስ።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="NUM 14:28-35">ታይቦ 14:28-35</ref>.</char></note> <verse eid="JOS 5:6"/><verse number="7" style="v" sid="JOS 5:7"/>ሄሳ ግሾ እያሱይ ቃፃርዳይ ጎዳይ ኤንታ በሳን ደንዳ ኤንታ ናይታ። ኤንቲ ኦገ ቦላ የለትዳ ግሾ ቃፃረትቦኮና።<verse eid="JOS 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 5:8"/>አሳ ኡባይ፥ ቃፃረትዳፐ ጉየ፥ ኤንታ ማዱንይ ፓፃና ጋካናዉ ኤንቲ ዱንካንዳ በሳን ጋምእዶሶና። <verse eid="JOS 5:8"/><verse number="9" style="v" sid="JOS 5:9"/>ጎዳይ እያሱኮ፥ “ሀች ታኒ ግብፀታ ቦርያ<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="fqa" closed="false">ግብፀ ቦርያ፦ </char><char style="ft" closed="false">ግብፀ ቦርያ ጌተትዳይ ኤንቲ ግብፀን አይለተን ደእዳይሳ በሳና።</char></note> ህንተፈ ድጋስ” ያግስ። ሄሳ ግሾ፥ ሄ በሳ ሱንይ ሀች ጋካናዉ ጋልጋላ<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="fq" closed="false">ጋልጋላ፦ </char><char style="ft" closed="false">እብራወ ዶናን ጋልጋላ ጉሳይ “ድግስ” ዎይኮ “ጎንዶርስስ” ጉሱ።</char></note> ጌተትድ ፄገቴስ።<verse eid="JOS 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 5:10"/>እስራኤለ አሳይ እያርኮ ደንባን ጋልጋላ ጌተትያ በሳን ዱንካንድ፥ ኮይሮ አጌናን ታማነ ኦይዳን ጋላሳን ኦማርስ ፓስካ ባልያ ቦንችዶሶና። <verse eid="JOS 5:10"/><verse number="11" style="v" sid="JOS 5:11"/>ፓስካፐ ጉየ፥ ዎንተ ጋላስ፥ ሄ ጋድያን ዶልዳ ካ አይፍያ፥ ኡይነ ትያ ጫጫ ምዶሶና። <verse eid="JOS 5:11"/><verse number="12" style="v" sid="JOS 5:12"/>ሄ ጋድያን ሞክዳ ካ ኤንቲ ምዳ ዎንተ ጋላስ ማናይ ዎይሳ አግስ። ሄ ዎደፐ ዶምድ እስራኤለ አሳይ ማና ደምቦኮና። ሄሳፈ ጉየ ኤንቲ ካናነን ካፅዳ ካ ምድ ደእዶሶና።<verse eid="JOS 5:12"/></para>
  <para style="s1">እያርኮ ኩንደ</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 5:13"/>እያሱይ እያርኮ ማታን ደእያ ዎደ ማሻ ኦይክድ ባ ስንን ኤቅዳ እስ አደ በእስ። እያሱይ እያኮ ሺቅድ፥ “ኔን ኑ ባጋየ ዎይኮ ኑ ሞርከታ ባጌ?” ያግድ ኦይችስ።<verse eid="JOS 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 5:14"/>አደይ ዛሪድ፥ “ታኒ ኦደ ባጋካ ግድከ። ሽን ታ ጎዳ ቶራ ሞጮና ግዳዳ ያስ” ያግስ።</para>
  <para style="p" vid="JOS 5:14">እያሱይ ሳአን ኩንድ ጎይንድ፥ “ታ ጎዳዉ፥ ታ ኦናባ ታዉ ኦዳ” ያግስ።<verse eid="JOS 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 5:15"/>ጎዳ ቶራ ሞጮናይ እያሱኮ፥ “ኔን ኤቅዳ በሳይ ጌሽ ግድያ ግሾ፥ ነ ቶሁዋፐ ጫማ ከሳ” ያግስ። ያትን እያሱይ እ ግዳይሳዳ ኦስ።<verse eid="JOS 5:15"/></para>
  <chapter eid="JOS 5"/>
  <chapter number="6" style="c" sid="JOS 6"/>
  <para style="p">
    <verse number="1" style="v" sid="JOS 6:1"/>እስራኤለ አሳስ ያይዳ ግሾ፥ እያርኮ ካታማ ግምበ ድርሳ ፐንገት ጎርደትዶሶና። ኦንካ ካታማ ገላናዉነ ከያናዉ ዳንዳኤና። <verse eid="JOS 6:1"/><verse number="2" style="v" sid="JOS 6:2"/>ጎዳይ እያሱኮ፥ “እያርኮ ካታማ እያ ካዉራነ እያ ምኖ ኦላንቾታራ ነ ኩሸን አ እማስ። <verse eid="JOS 6:2"/><verse number="3" style="v" sid="JOS 6:3"/>ኔራነ ነ ኦላንቾታራ ሳልፕድ፥ ጋላሳን እስ ቶሆ ኡሱፑን ጋላስ ጋካናዉ፥ ካታማ ግምበ ድርሳ ዩሹዋ ዩይተ። <verse eid="JOS 6:3"/><verse number="4" style="v" sid="JOS 6:4"/>ላፑን ካህነት እሶይ እሶይ ሞይዘ ኦይክድ፥ ጎዳ ጫቆ ታቦትያ ስንን ቦ። ላፑን ጋላስ ካህነት ሞይዘ ፑንያ ዎደ ህንተ ካታማ ላፑን ቶሆ ዩይተ። <verse eid="JOS 6:4"/><verse number="5" style="v" sid="JOS 6:5"/>ካህነት ሞይዘ ጎችድ ፑኑዋ ህንተ ስእያ ዎደ፥ አሳ ኡባይ ኤለስድ ባንታ ቃላ ቁ ኦድ ዋሶ። ሄሳፈ ጉየ፥ ካታማ ግምበ ድርሳይ ኩንዳና። ሄ ዎደ አሳ ኡባይ ግዶ ላዉሁ ግድ ገላና” ያግስ።<verse eid="JOS 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 6:6"/>ናወ ናአ እያሱ ካህነታ ፄግድ፥ “ጎዳ ጫቆ ታቦትያ ቶክተ። ህንተፈ ላፑን ካህነት ሞይዘ ኦይክድ፥ ጫቆ ታቦትያፐ ስን አድ ቦ” ያግስ። <verse eid="JOS 6:6"/><verse number="7" style="v" sid="JOS 6:7"/>አሳኮ ቃስ፥ “ብድ፥ ካታማ ዩሹዋን ዩይተ፤ ኦላንቾት ጎዳ ጫቆ ታቦትያ ስንን ሄመቶና” ያግድ ኪትስ።<verse eid="JOS 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 6:8"/>እያሱይ ኦድዳይሳዳ፥ ላፑን ካህነት ላፑን ሞይዘ ፑንሸ ጎዳ ስንን ሄመትዶሶና፤ ቃስ ጎዳ ጫቆ ታቦተይ ኤንታ ካልስ።<figure style="fig" alt="Trumpet of ram’s horn" file="co01481b.tif" size="col" ref="6:8">ሞይዘ </figure> <verse eid="JOS 6:8"/><verse number="9" style="v" sid="JOS 6:9"/>ኦላስ ዳንጭዳይሳት ሞይዘ ፑንያ ካህነታ ስንን ሄመቶሶና። ካህነት ቃንፆና ሞይዘ ፑንያ ዎደ ደረይ ታቦትያፐ ጉየራ ካሌስ። <verse eid="JOS 6:9"/><verse number="10" style="v" sid="JOS 6:10"/>ሽን እያሱይ፥ “ታ ህንተና ዋሶ ጎናሽን ዋሶፍተ ዎይኮ ህንተ ቃላ ስሶፍተ፤ ሀር አቶሽን እስ ቃላካ ኦደቶፍተ። ታ ህንተና ዋሶ ግያ ሄ ጋላስ ዋስተ” ያግድ አሳ ኪትስ። <verse eid="JOS 6:10"/><verse number="11" style="v" sid="JOS 6:11"/>ሄሳ ግሾ፥ ጎዳ ጫቆ ታቦተይ ሄ ካታማ እስ ቶሆ ዩያናዳ ኦስ። ያትድ አሳይ ባንታ ዱንካንዳ ጉታ ስሚድ፥ ያን አቅዶሶና።<verse eid="JOS 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 6:12"/>ዎንተ ጋላስ እያሱይ ጉርድ ደንድስ፤ ካህነትካ ጎዳ ጫቆ ታቦትያ ቶክዶሶና። <verse eid="JOS 6:12"/><verse number="13" style="v" sid="JOS 6:13"/>ላፑን ሞይዘታ ኦይክዳ ላፑን ካህነት ባንታ ሞይዝያ ቃንፆና ፑንሸ ጫቆ ታቦትያ ስንን ቦሶና። ሞይዘይ ቃንፆና ፑነትያ ዎደ ኦላንቾት ካህነታፐ ስንን ቃስ ደረይ ታቦትያፐ ጉየራ ካሌስ። <verse eid="JOS 6:13"/><verse number="14" style="v" sid="JOS 6:14"/>ናምአን ጋላስ ካታማ እስ ቶሆ ዩይድ፥ ባንታ ዱንካንዳ ጉታ ስምዶሶና። ኡሱፑን ጋላስ ጋካናዉ ሄሳዳ ኦዶሶና።<verse eid="JOS 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 6:15"/>ላፑን ጋላስ ጎንተይ ዋሽን ደንድድ፥ ካሰይሳዳ ካታማ ላፑን ቶሆ ዩይዶሶና። ሄ ጋላሳ ፃላላ ካታማ ላፑን ቶሆ ኤንቲ ዩይዶሶና። <verse eid="JOS 6:15"/><verse number="16" style="v" sid="JOS 6:16"/>ላፑን ዩሹዋን፥ ካህነት ሞይዘ ፑንያ ዎደ፥ እያሱይ አሳኮ፥ “ጎዳይ ሀ ካታማ ህንተዉ አድ እምዳ ግሾ፥ ዋስተ” ያግድ ኪትስ።<verse eid="JOS 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 6:17"/>“ካታማይነ እያ ግዶን ደእያባ ኡባይ ጎዳስ ቃንገትዳባ ግድድ ያናዉ በሴስ። ኑኒ ቢታ ፆሞሳና መላ የድዳ አሳታ ቆሳዳ አሽዳ፥ ላይምያ ራባነ እ ሶን ደእያ አሳ ፃላል አታናዉ በሴስ። <verse eid="JOS 6:17"/><verse number="18" style="v" sid="JOS 6:18"/>ሽን ህንተ መቶነ ቆሆ እስራኤለ ጉታ ቦላ ኤሆና መላ ያናዉ በሲያባፐ አይባካ አሞትድ ኤኮናዳ ህንተ ሁጰስ ናገትተ። <verse eid="JOS 6:18"/><verse number="19" style="v" sid="JOS 6:19"/>ብራይነ ዎርቀይ፥ ናሰ ብራታፐ ኦሰትዳ ሚሸት ኡባይ፥ ጎዳስ ዱማትዳባ ግዶ። ኤንቲ ጎዳ ሚሽያ ምንጅያ ሻልያን ደኦ” ያግስ።<verse eid="JOS 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 6:20"/>ሄሳ ግሾ፥ ሞይዘይ ፑነትስ፤ አሳይ ዋስስ። ደረይ ሞይዘ ፑኑዋ ስእዳ ዎደ ባንታ ቃላ ቁ ኦ ዋስን፥ ካታማ ግምብያ ድርሳይ ኩንድስ። ሄ ሳተን አሳይ ላዉሁ ግድ ገልድ ካታማ ኦይክዶሶና። <verse eid="JOS 6:20"/><verse number="21" style="v" sid="JOS 6:21"/>ባንታ ማሻ ደንድ፥ ማጫ አደ፥ ናአ ጭማ፥ መሄ፥ ዶርሰ፥ ሀረነ ካታማን ሸምፖራ ደእያባ ኡባ ዎዶሶና።<verse eid="JOS 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 6:22"/>እያሱይ ቢታ ፆሞሳናዉ ኪተትዳ ናምኡ አሳታኮ፥ “ላይመ ራብ ሶ ብድ፥ ካሰ ህንተ እዉ ጫቅዳይሳዳ፥ እዮነ እ ሶ አሳ ኡባ ከስተ” ያግስ። <verse eid="JOS 6:22"/><verse number="23" style="v" sid="JOS 6:23"/>ኤንቲ ብድ፥ ራቦ፥ እ አዋ፥ እ አይዉ፥ እ እሻታነ እ ዳቦታ ኡባ እስራኤለ አሳይ ዱንካንዳ ጉታፐ ጋፃ ከስድ ዎዶሶና። <verse eid="JOS 6:23"/><verse number="24" style="v" sid="JOS 6:24"/>ያት ስሚድ ካታማነ እያ ግዶን ደእያባ ኡባ ፁግዶሶና። ሽን ብራነ ዎርቃ፥ ናሰ ብራታፐ ኦሰትዳ ሚሸታ ጎዳ ሚሽያ ምንጅያ ሻልያን ዎዶሶና። <verse eid="JOS 6:24"/><verse number="25" style="v" sid="JOS 6:25"/>ሽን ላይምያ ራባ እያርኮ ፆሞሳና መላ ኪተትዳ አሳታ ቆሳዳ አሽዳ ግሾ፥ እያሱይ እዮ፥ እ አዋ ሶ አሳነ ኢራ ደእያ ዳቦታ ኡባ ሀይቆፐ አሽስ። እ ኮቻት ሀች ጋካናዉ እስራኤለ ቢታን ደኦሶና።<verse eid="JOS 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 6:26"/>ሄ ዎደ እያሱይ፥</para>
  <para style="q1" vid="JOS 6:26">“እያርኮ ካታማ ዛር ኬፃናዉ ደንድያ ኦንካ፥</para>
  <para style="q2" vid="JOS 6:26">ጎዳ ስንን ባደትዳባ ግዶ።</para>
  <para style="q1" vid="JOS 6:26">ቡሮ ባስያ ዎደ እያ ባይራ ናአይ ሀይቆ፥</para>
  <para style="q2" vid="JOS 6:26">ፐንግያ አያ ዎደ እያ ተሾ ናአይ ሀይቆ”</para>
  <para style="m" vid="JOS 6:26">ያግድ ባድስ።<verse eid="JOS 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 6:27"/>ጎዳይ እያሱራ ግድዳ ግሾ፥ እያ ሱንይ ቢታ ኡባ ጋክስ።<verse eid="JOS 6:27"/></para>
  <chapter eid="JOS 6"/>
  <chapter number="7" style="c" sid="JOS 7"/>
  <para style="s1">አካና ናጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 7:1"/>እስራኤለ አሳይ ድገትዳባ ቦችድ፥ ጎዳስ ኪተቶና እፅዶሶና። ይሁዳ ኮቸ ግድዳ ካርማ ናአይ፥ ዘብዳ ናኣ ናአይ፥ ዛራ ናአይ አካን፥ ድገትዳባታፐ ኤክድ እስራኤለ ቦላ ጎዳ ሀንቁዋ ደንስ።<verse eid="JOS 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 7:2"/>እስራኤለ አሳይ እያርኮ ማታን ዱንካንድ ደእሽን፥ እያሱይ ቤት-አዌና ማታን ቤተለፐ ዶሎሀ ባጋን ደእያ ጋየ ካታማነ እያ ሄራ ፆሞስድ ያና መላ ጉ አሳታ ኪትስ። ኪተትዳ አሳት ብድ፥ ጋየ ካታማ ፆሞስዶሶና።<verse eid="JOS 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 7:3"/>ኤንቲ እያሱኮ ስሚድ ይድ፥ “ጋየ ካታማ ኦላናዉ አሳ ኡባይ ባናዉ ኮሸና፤ ናምኡ ዎይኮ ሄ ሙኩሉ ኦላንቾት ቢኮ ግዳና። ያን ጉ አስ ደእያ ግሾ፥ አሳ ኡባይ ዳቡራናዉ በሰና” ያግዶሶና። <verse eid="JOS 7:3"/><verse number="4" style="v" sid="JOS 7:4"/>ያትን፥ ሄ ሙኩሉ ግድያ አሳት ኦላናዉ ጋየ ካታማ ብዶሶና። ሽን እስራኤለት ጋየ ካታማ አሳ ስንፈ ባቃትዶሶና። <verse eid="JOS 7:4"/><verse number="5" style="v" sid="JOS 7:5"/>ጋየ ካታማ አሳይ እስራኤለ አሳፐ ሀስታማነ ኡሱፑን አሳ ዎድ፥ ካታማ ድርሳ ፐንግያፈ ዶምድ፥ ሸባርመ ጋካናዉ እስራኤለ አሳ ዎሸ ጎድዶሶና። እስራኤለ አሳ ዎዛናይ ትልእድ፥ ሃ ግድስ።<verse eid="JOS 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 7:6"/>ያንን፥ እያሱይነ እስራኤለ ጭማት አዛንድ፥ ባንታ ማኡዋ ዳክዶሶና። ጎዳ ታቦትያ ስንን ኦማርስ ጋካናዉ ጉፋንዶሶና። ባንታ ሁጰን ብዶ ቆልዶሶና። <verse eid="JOS 7:6"/><verse number="7" style="v" sid="JOS 7:7"/>ያትን፥ እያሱይ፥ “ሀይእ ጎዳ ፆሳዉ፥ ዮርዳኖሰ ሻፋ ፕንዳ ነ ኑና ኤህዳይ አሞረታስ ኑና አ እማናሴ? ዮርዳኖሰፐ ሄፍንን ደእዳኮ ኑስ ሎኦሽን። <verse eid="JOS 7:7"/><verse number="8" style="v" sid="JOS 7:8"/>አቤት ጎዳዉ፥ እስራኤለ አሳይ ፆነትድ፥ ባንታ ሞርከታ ስንፈ ባቃትኮ፥ ታ ዎይጎ? <verse eid="JOS 7:8"/><verse number="9" style="v" sid="JOS 7:9"/>ካናነትነ ሀ ቢታን ደእያ አሳ ኡባይ፥ ሄሳ ስእድ፥ ኑና ተቅድ፥ ቢታፈ ይሳና። ያትን፥ ነ ግታ ሱን ግሾ ነ ኦናይ አይቤ?” ያግስ።<verse eid="JOS 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 7:10"/>ጎዳይ እያሱኮ፥ “አይስ ጉፋናዲ? ደንዳ ኤቃ። <verse eid="JOS 7:10"/><verse number="11" style="v" sid="JOS 7:11"/>እስራኤለ አሳይ ቆህዶሶና፤ ታ ኤንታና ኪትዳ ኪታ ናጎና እፅድ፥ ጫቁዋ መንዶሶና። ኤንቲ ድገትዳባፐ ኤክዶሶና፤ ካይሶትዶሶና፤ ዎርዶትዶሶና፤ ቃስ ሄ ሚሽያ ባንታ ሚሽያራ ዋላክዶሶና። <verse eid="JOS 7:11"/><verse number="12" style="v" sid="JOS 7:12"/>ሄሳ ግሾ፥ እስራኤለ አሳይ ባንታ ሞርከታ ስንን ኤቃናዉ ዳንዳእቦኮና። ኤንቲ ያናዉ በሲያ ግሾ፥ ባንታ ሞርከታ ስንፈ ጉየ ስሚድ ባቃትዶሶና። ህንተ ግዶፈ ያናዉ በሲያባ ህንተ ይሶና እፅኮ፥ ህዛፐ ታ ህንተራ ግድከ።”<verse eid="JOS 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 7:13"/>ባዳ አሳ ጌሻ። ጎዳይ፥ እስራኤለ ፆሳይ፥ “ህንተ ኤካናዉ በሶናባ ኤክዳ ግሾ፥ ዎንቶስ ህንተናተ ጌሽተ” ያጌስ ጋዳ ኦዳ። እስራኤለ አሳዉ፥ ሄሳ ህንተ ግዶፈ ድጎና እፅኮ፥ ህንተ ሞርከታ ስንን ኤቃናዉ ዳንዳኤከታ። <verse eid="JOS 7:13"/><verse number="14" style="v" sid="JOS 7:14"/>ዎንቶ ዎንታ፥ ህንተ ዛርያን ዛርያን ሺቅተ። ጎዳይ ሻክያ ዛረይ ባ ኮቻን ኮቻን ሺቆ። ጎዳይ ሻክያ ኮቻይ ባ ሶ አሳን አሳን ሺቆ፤ ቃስ ጎዳይ ሻክያ ሶ አሳይ፥ እሶይ እሶይ ባዉ ሺቆ። <verse eid="JOS 7:14"/><verse number="15" style="v" sid="JOS 7:15"/>ድገትዳባ ኤክዳ ኡራይ ጎዳ ጫቁዋ መንዳይነ እስራኤለ አሳ ቆህዳይ እያ ግድያ ግሾ፥ እነ እያዉ ደእያባ ኡባይ ታማን ፁገቶ።<verse eid="JOS 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 7:16"/>እያሱይ ዎንተ ጋላስ ጉራ ደንድድ፥ ኮቻን ኮቻን እስራኤለ አሳ ሺሽን፥ ጎዳይ ይሁዳ ኮቻይ ባላ ግደይሳ በስስ። <verse eid="JOS 7:16"/><verse number="17" style="v" sid="JOS 7:17"/>እያሱይ ይሁዳ ኮቻ ሺሽን፥ ጎዳይ ዛራሀ ኮቻይ ባላ ግደይሳ በስስ። ዛራሀ ኮቻ ሺሽን፥ ጎዳይ ዛብዳ ሶ አሳይ ባላ ግደይሳ በስስ። <verse eid="JOS 7:17"/><verse number="18" style="v" sid="JOS 7:18"/>ዛብዳ ሶ አሳይ እሶይ እሶይ ባዉ ሺቅን፥ ዉርሰን ጎዳይ ዛብዳ ናአ ናኣ፥ ካርማ ናኣ አካን ባላ ግደይሳ ቆንጭስስ። <verse eid="JOS 7:18"/><verse number="19" style="v" sid="JOS 7:19"/>እያሱይ አካናኮ፥ “ታ ናአዉ፥ ጎዳ፥ እስራኤለ ፆሳ ቦንቻ፤ አነ ነ ኦዳባ ታዉ ቆሶና ኦዳ” ያግስ።<verse eid="JOS 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 7:20"/>አካን ዛሪድ፥ “ኤ ቱማ፥ ታኒ ጎዳ እስራኤለ ፆሳ ናቃስ። ታኒ ኦዳይ ሀይሳ፤ <verse eid="JOS 7:20"/><verse number="21" style="v" sid="JOS 7:21"/>ኑኒ ድእድ ኤክዳ ሚሽያ ግዶፈ እስ ሎኦ ሳናኦራ ቢታ ካባ፥ ናምኡ ክሎ ግድያ ብራታ ብራነ ባጋ ክሎ ግድያ ዎርቃ በአዳ አሞታስ፤ ኤካስ። ያታዳ ታ ዱንካንያ ግዶን ቢታ ቦካዳ ብራ ጋርሳራ ዎዳ ሞጋስ።”<verse eid="JOS 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 7:22"/>ያትን፥ እያሱይ አሰ ኪትስ። ኤንቲ ዎፅ ብድ ዱንካንያ ግዶን ብራ ጋርሳራ ዎድ ሞግዳ ሚሸታ ደምዶሶና። <verse eid="JOS 7:22"/><verse number="23" style="v" sid="JOS 7:23"/>ኪተትድ ብዳ አሳት ሄ ሚሸታ ዱንካንያፐ እያሱኮነ እስራኤለ አሳ ኡባኮ ኤህድ፥ ጎዳ ስንን ዎዶሶና።<verse eid="JOS 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 7:24"/>ያትን እያሱይነ እስራኤለ አሳ ኡባይ፥ አካና፥ ብራ፥ ካባ፥ ዎርቃ፥ እያ አደ ናይታነ እያ ማጫ ናይታ፥ እያ መህያ፥ እያ ሀረታ፥ እያ ዶርሳታ፥ እያ ዱንካንያነ እያዉ ደእያባ ኡባ መቶ ዛንጋራ ጌተትያ በሳ ኤፍዶሶና። <verse eid="JOS 7:24"/><verse number="25" style="v" sid="JOS 7:25"/>እያሱይ አካናኮ፥ “ሀ መቱዋ ኑ ቦላ አይስ ኤሀዲ? ጎዳይ ሀች ነ ቦላ መቶ ኤሀና” ያግስ።</para>
  <para style="p" vid="JOS 7:25">ያትን እስራኤለ አሳ ኡባይ፥ አካናነ እያ ሶ አሳ ሹቻን ጫድ ዎድ፥ እያዉ ደእያባ ኡባራ ዎል ጋድ ታማን ፁግዶሶና። <verse eid="JOS 7:25"/><verse number="26" style="v" sid="JOS 7:26"/>ኤንቲ አካና ቦላ ሀች ጋካናዉ በንትያ ዳሮ ሹች ኬልዶሶና። ያትን፥ ጎዳይ ባ ኤፅያ ሀንቁዋፈ ስምስ። ሀች ጋካናዉ ሄ በሳይ መቶ ዛንጋራ<note caller="+" style="f"><char style="fr" closed="false">7:26 </char><char style="fq" closed="false">መቶ ዛንጋራ፦ </char><char style="ft" closed="false">እብራወ ዶናን አኮራ ዛንጋራ ጌተቴስ።</char></note> ጌተትድ ፄገቴስ።<verse eid="JOS 7:26"/></para>
  <chapter eid="JOS 7"/>
  <chapter number="8" style="c" sid="JOS 8"/>
  <para style="s1">ጋየ ካታማ ኩንደ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 8:1"/>ጎዳይ እያሱኮ፥ “ያዮፋ፤ ህርጎፋ፤ ኦላንቾታ ኡባ ኔራ ኤካዳ፥ ጋየ ካታማ ኦላናዉ ከያ። ጋየ ካዋ፥ እያ አሳ፥ እያ ካታማነ እያ ቢታ ታ ነ ኩሸን አዳ እማስ። <verse eid="JOS 8:1"/><verse number="2" style="v" sid="JOS 8:2"/>ኔን እያርኮ ቦላነ እያ ካዋ ቦላ ኦዳይሳዳ ጋየ ቦላነ እያ ካዋ ቦላ ኦና። ሽን ህንተ ሀእ ኦልድ ድእያ ሻሎነ መሄ ህንተዉ ኤክተ። ካታማፐ ጉየ ባጋራ ቆፖና መን ገላናዉ ጊገታ።”<verse eid="JOS 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 8:3"/>ሄሳ ግሾ፥ እያሱይነ ኦላንቾት ኡባይ፥ ጋየ ካታማ ኦላናዉ ደንድዶሶና። እያሱይ ባ ኦላንቾታ ግዶፈ ሀስታሙ ሙኩሉ ግድያ ምኖ ኦላንቾታ ዶርድ ቃማ የድሸ፥ <verse eid="JOS 8:3"/><verse number="4" style="v" sid="JOS 8:4"/>ኤንታና ሀይሳዳ ያግድ ኪትስ፤ “ብድ ካታማፐ ጉየ ባጋራ ቆሰትድ ናግተ። ካታማፐ ሃክድ ቦናሽን፥ መን ገላናዉ ጊግድ ናግተ። <verse eid="JOS 8:4"/><verse number="5" style="v" sid="JOS 8:5"/>ታነ ታራ ደእያ አሳ ኡባይ፥ ካታማኮ ሺቃና። ሄ ዎደ ጋየ ካታማ አሳይ ኑና ኦላናዉ ያ ዎደ ካሰይሳዳ ኑ ኤንታ ስንፈ ጉየ ስሚድ ባቃታና። <verse eid="JOS 8:5"/><verse number="6" style="v" sid="JOS 8:6"/>ኤንቲ ከሰይሳዳ ኑ ኤንታ ስንፈ ባቃትያ ዳንን፥ ኑፐ ባቃቶሶና ግድ፥ ካታማፐ ኑ ኤንታ ሃሳና ጋካናዉ ኑና ካላና። <verse eid="JOS 8:6"/><verse number="7" style="v" sid="JOS 8:7"/>ሄ ዎደ ህንተ ቆሰትዳ በሳፈ ከይድ ካታማ ኦይክተ። ጎዳይ ህንተ ፆሳይ ካታማ ህንተ ኩሸን አድ እማና። <verse eid="JOS 8:7"/><verse number="8" style="v" sid="JOS 8:8"/>ካታማ ኦይክዳፐ ጉየ፥ ጎዳይ ኪትዳይሳ መላ ታማን ፁግተ። ታ ህንተና ኪታስ” ያግስ።<verse eid="JOS 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 8:9"/>ሄሳፈ ጉየ እያሱይ ኦላንቾታ ኪትስ። ኤንቲ ብድ ጋየ ካታማፐ ዉሎሀ ባጋን ቤተለፐነ ጋየፐ ግዶን ቆሰትድ ናግዶሶና። ሽን እያሱይ ሄ ቃማ አሳራ አቅስ።<verse eid="JOS 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 8:10"/>ዎንተ ጋላስ ጉራ እያሱይ ደንድድ፥ ኦላንቾታ ፄግስ። ያትድ፥ እነ እስራኤለ ጭማት ኦላንቾታ ካለድ ጋየ ካታማ ብዶሶና። <verse eid="JOS 8:10"/><verse number="11" style="v" sid="JOS 8:11"/>እያራ ደእያ ኦላንቾት ኡባይ፥ ስን ብድ ጋየ ካታማ ማትድ፥ ካታማፐ ፑደሀ ባጋን ዱንካንዶሶና። ኤንታፈነ ጋየ ካታማፐ ግዶን ዛንጋር ደኤስ። <verse eid="JOS 8:11"/><verse number="12" style="v" sid="JOS 8:12"/>እያሱይ እቻሹ ሙኩሉ ኦላንቾታ ዶርድ፥ ካታማፐ ዉሎሀ ባጋራ፥ ቤተለፐነ ጋየፐ ግዶን ቆስድ ዎስ። <verse eid="JOS 8:12"/><verse number="13" style="v" sid="JOS 8:13"/>ኦላንቾታፐ ባጋ ካታማፐ ፑደሀ ባጋራ፥ ቃስ ካታማ መንድ ገላና ኦላንቾታ ዉሎሀ ባጋራ በሰ በሰ ኦይስ። ሄ ቃማ እያሱይ ሄ ዛንጋራን አቅስ።<verse eid="JOS 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 8:14"/>ጋየ ካታማ ካዎይ ሄሳ በእዳ ዎደ፥ ባ ኦላንቾታ ኡባ ኤክድ፥ እስራኤለ አሳራ ኦለታናዉ ደምባ ቢታ ከይዶሶና። ሽን ካዎይ ካታማፐ ጉየ ባጋራ ቆሰት ኡትዳ ኦላንቾት ደኤይሳ ኤርቤና። <verse eid="JOS 8:14"/><verse number="15" style="v" sid="JOS 8:15"/>እያሱይነ እስራኤለ አሳ ኡባይ ፆነትዳባ ዳንድ፥ ኤንታ ስንፈ መላ ቢታ ስሚድ ባቃትዶሶና። <verse eid="JOS 8:15"/><verse number="16" style="v" sid="JOS 8:16"/>ጋየ ካታማን ደእያ አሳ ኡባይ፥ ኤንታ የደናዉ ፄገረት ከይድ፥ እያሱ ጎድሸ ካታማፐ ሃክድ ብዶሶና። <verse eid="JOS 8:16"/><verse number="17" style="v" sid="JOS 8:17"/>ጋየ ዎይኮ ቤተለን ደእያ አሳ ኡባይ፥ እስራኤለ አሳ የደናዉ ካታማ የግድ ከይን ካታማ ፐንገያ ናግያ አስ ይዳ ግሾ፤ ዶያ አትስ።<verse eid="JOS 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 8:18"/>ሄሳፈ ጉየ ጎዳይ እያሱኮ፥ “ነ ቶራ ጋየ ካታማ ቦላ ደን። ታኒ ጋየ ካታማ ነ ኩሸን አዳ እማና” ያግስ። ያትን እያሱይ ባ ቶራ ካታማ ቦላ ደንስ። <verse eid="JOS 8:18"/><verse number="19" style="v" sid="JOS 8:19"/>እያሱይ ባ ቶራ ደንዳ ዎደ ቆሰትዳ ኦላንቾት ባንታ በሳፈ ደንድድ፥ ካታማ ገል ኦይክድ፥ ኤለስድ ታማን ፁግዶሶና።<verse eid="JOS 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 8:20"/>ጋየ ካታማ አሳይ ጉየ ስሚድ ፄልያ ዎደ፥ ካታማ ጩያይ ሳሎ ደንድሽን በእዶሶና። መላ ቢታ ባቃትዳ እስራኤለ አሳይ፥ ባንታና የደያ አሳ ቦላ ጉየ ስምዳ ግሾ፥ ኤንቲ አዉ ባጋራካ ከስ ኤካናዉ ዳንዳእቦኮና። <verse eid="JOS 8:20"/><verse number="21" style="v" sid="JOS 8:21"/>እያሱነ እያራ ደእያ አሳ ኡባይ፥ ቆሰት ኡትዳ ኦላንቾት ካታማ ኦይክዳይሳነ ጩያይ ሳሎ ደንድዳይሳ በእዳ ዎደ ጉየ ስሚድ፥ ጋየ ካታማ አሳ ዎዶሶና። <verse eid="JOS 8:21"/><verse number="22" style="v" sid="JOS 8:22"/>ካታማ ገልድ ኦይክዳ ኦላንቾትካ ካታማፐ ኤንታ ቦላ ከይዶሶና። ያትን፥ ጋየ አሳይ እስራኤለ ኦላንቾታን ኡባ ባጋራ ተቀትዳ ግሾ፥ እሶይካ አቶና ዎይኮ ከስ ኤኮና ኡባ ዎድ ዉርስዶሶና። <verse eid="JOS 8:22"/><verse number="23" style="v" sid="JOS 8:23"/>ሽን ጋየ ካታማ ካዋ ደእድ፥ እያሱኮ ኤህዶሶና።<verse eid="JOS 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 8:24"/>እስራኤለ አሳይ ጋየ ካታማ አሳ ኤንታና የደዳ በሳን ማሻን ዎድ ኦንግዳፐ ጉየ፥ ኡባይ ጉየ ካታማ ስሚድ፥ ካታማን አትዳ አሳ ኡባ ማሻን ዎዶሶና። <verse eid="JOS 8:24"/><verse number="25" style="v" sid="JOS 8:25"/>ሄ ጋላስ ጋየ ካታማን ሀይቅዳ አደይነ ማጭ ታማነ ናምኡ ሙኩላ። <verse eid="JOS 8:25"/><verse number="26" style="v" sid="JOS 8:26"/>እያሱይ ጋየ ካታማን ደእያባ ኡባ ኦንጋና ጋካናዉ ካታማ ቦላ ደንዳ ቶራ ዱገ ዎቤና። <verse eid="JOS 8:26"/><verse number="27" style="v" sid="JOS 8:27"/>ሽን ጎዳይ እያሱ ኪትዳይሳ መላ እስራኤለ አሳይ ሄ ካታማ መህያነ ሻሉዋ ባንታዉ ድእዶሶና። <verse eid="JOS 8:27"/><verse number="28" style="v" sid="JOS 8:28"/>እያሱይ ጋየ ካታማ ፁግስ፤ ሄ ካታማይ ሀች ጋካናዉ ላለ ዶረነ አስ ባይና በሲ ግድድ አትስ። <verse eid="JOS 8:28"/><verse number="29" style="v" sid="JOS 8:29"/>እያሱይ፥ ጋየ ካታማ ካዋ ዎድ ኦማርስ ጋካናዉ ም ቦላ ካቅስ። አው ዉልያ ዎደ፥ እያ አሀ ካታማ ገልያ ፐንገን የጋና መላ ኦስ። እያ ቦላ ዳሮ ሹቻ ኬልዶሶና፤ ሄ ኬላ ሹቻይ ሀች ጋካናዉ ሄ በሳን ደኤስ።<verse eid="JOS 8:29"/></para>
  <para style="s1">ጫቆ ቃላይ ኦራፅስ</para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 8:30"/>ሄሳፈ ጉየ፥ እያሱይ ኤባላ ደርያ ቦላ ጎዳስ እስራኤለ ፆሳስ ያርሾ በሲ ኬፅስ። <verse eid="JOS 8:30"/><verse number="31" style="v" sid="JOS 8:31"/>ጎዳ አይለይ ሙሰይ እስራኤለ አሳ ኪትዳይሳዳነ ህገ ማፃፋን ፃፈትዳይሳዳ፥ ያርሾ በሳ ማሰትቦናነ ብራት ቦችቦና ሹቻፈ ኬፅድ፥ እያ ቦላ ጎዳስ ፁሳ ያርሾነ እስፈተ ያርሾ ያርሽዶሶና። <verse eid="JOS 8:31"/><verse number="32" style="v" sid="JOS 8:32"/>እያሱይ፥ እስራኤለ አሳ ስንን፥ ሙሰ ህግያ ሹቻ ቦላ ዛሪድ ፃፍስ። <verse eid="JOS 8:32"/><verse number="33" style="v" sid="JOS 8:33"/>እስራኤለ አሳ አንጃና መላ ጎዳ አይለይ ሙሰይ ኪትዳይሳዳ እስራኤለ አሳ ኡባይ፥ አሳ ጋደ አሳታ፥ ኤንታ ጭማት፥ ኤንታ ሹማትነ ዳይናት ኡባይ፥ ጎዳ ጫቆ ታቦትያ ቶክዳ ሌወ ኮቸ ግድዳ ካህነታ ስንን ኡሻቻ ባጋንነ ሀድርሳ ባጋን ኤቅዶሶና። ኤንታፈ ባጋይ ጋርዛና ዙማ ስንን፥ ቃስ ባጋይ ኤባላ ደርያ ስንን ኤቅዶሶና።<note caller="-" style="x"><char style="xo" closed="false">8:33 </char><char style="xt" closed="false"><ref loc="DEU 11:29">ዛረ 11:29</ref>፤ <ref loc="DEU 27:11-14">27:11-14</ref>.</char></note> <verse eid="JOS 8:33"/><verse number="34" style="v" sid="JOS 8:34"/>ህገ ማፃፋን ፃፈትዳይሳዳ፥ እያሱይ ህገ ቃላ ኡባ፥ አንጁዋነ ባደ ናባብስ። <verse eid="JOS 8:34"/><verse number="35" style="v" sid="JOS 8:35"/>ሙሰይ ኪትዳ ህግያ እያሱይ፥ እስራኤለ አሳ ኡባስ፥ ማጫሳስ፥ ናይታስነ፥ አሳ ጋደ አሳስ እስ ቃላካ አሾና ናባብስ።<verse eid="JOS 8:35"/></para>
  <chapter eid="JOS 8"/>
  <chapter number="9" style="c" sid="JOS 9"/>
  <para style="s1">ጋባኦናታ ጭሙዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 9:1"/>ዮርዳኖሰ ሻፋፐ ዉሎሀ ባጋን ደረይ ዳርያ ቢታንነ ጋን መደትራነ አባፈ ብድ ልባኖሰ ጋካናዉ ደእያ ህተታ፥ አሞረታ፥ ካናነታ፥ ፓርዘታ፥ ህወታነ ያቡሰታ ካዎት ኡባይ፥ ጋየ አሳይ ፆነትዳይሳ ስእዳ ዎደ፥ <verse eid="JOS 9:1"/><verse number="2" style="v" sid="JOS 9:2"/>እያሱነ እስራኤለታ ኦላናዉ እስፈ ሺቅድ ዞረትዶሶና።<verse eid="JOS 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 9:3"/>ጋባኦና አሳይ እያሱይ እያርኮ ቦላነ ጋየ ካታማ ቦላ ኦዳባ ስእድ፥ <verse eid="JOS 9:3"/><verse number="4" style="v" sid="JOS 9:4"/>እያሱ ጭማናዉ ኮይዶሶና። ኤንቲ ሽንቀ ቃችድ፥ ጭማ ዎይነ ኦጎሮነ ጩርቃ ቃርፂቴ ሀረ ቦላ ጫንድ፥ እያሱኮ አሰ ኪትዶሶና። <verse eid="JOS 9:4"/><verse number="5" style="v" sid="JOS 9:5"/>ኪተትዳ አሳት ዉርዳ ጫማ አዶሶና፤ ፔትዳ አፍላ ማእዶሶና፤ ኤንቲ ኦይክዳ ሽንቀይካ መልዳባነ መቀርትዳባ። <verse eid="JOS 9:5"/><verse number="6" style="v" sid="JOS 9:6"/>ኤንቲ እስራኤለ አሳይ ዱንካንዳ ጉታ ጋልጋላ ብድ፥ እያሱኮነ እስራኤለ አሳኮ፥ “ኑኒ ሃሆ ጋደፐ ይዳ። ኑ ይዳይ ህንተራ ጫቀትድ ሳሮ ዳናሳ” ያግዶሶና።<verse eid="JOS 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 9:7"/>ያትን፥ እስራኤለ አሳይ ጋባኦነ አሳኮ፥ “ህንተ ኑ ማታን ደእያ አሰኮሽ? ኑ አይብን ኤርድ ህንተራ ጫቀታኔ?” ያግዶሶና።<verse eid="JOS 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 9:8"/>ኤንቲ እያሱኮ፥ “ኑ ነ አይለታ” ያግድ ዛርዶሶና።</para>
  <para style="p" vid="JOS 9:8">እያሱይ ዛሪድ፥ “ህንተ ኦናንቴ? አዉፐ ይደቲ?” ያግድ ኦይችስ።<verse eid="JOS 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 9:9"/>ኤንቲ ዛሪድ፥ “ኑኒ ነ አይለት ጎዳይ ህንተ ፆሳይ ግብፀን ኦዳይሳ ስእዳ ግሾ፥ ዳሮ ሃሆ ጋደፐ ይዳ። <verse eid="JOS 9:9"/><verse number="10" style="v" sid="JOS 9:10"/>ቃስ ዮርዳኖሰ ሻፋፐ ሄፍንን ዉሎሀ ባጋን ደእያ ናምኡ አሞረ ካዎታ፥ ሀሰቦና ካዋ ስሆናነ አስታሮተን ደእያ ባሳነ ካዋ ኦገ ቦላ እ ኦዳይሳ ኑ ስእዳ። <verse eid="JOS 9:10"/><verse number="11" style="v" sid="JOS 9:11"/>ኑ ቢታ ጭማትነ ኑ ቢታን ደእያ ኡባይ፥ ኦገስ ሽንቀ ጊግስ ኦይክድ ብድ ኤንታራ ጋሄትድ፥ ኤንታኮ፥ ‘ኑ ህንተ አይለታ፤ ኑ ይዳይ ህንተራ ጫቀትድ ሳሮ ዳናሳ’ ያግተ።<verse eid="JOS 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 9:12"/>“ኑ ኦይክዳ ሽንቅያ በእተ። ኑ ሶፐ ኤክድ ከይያ ዎደ ሆኦ፥ ሽን ሀእ መልዳይሳነ ፑሉምዳይሳ በእተ። <verse eid="JOS 9:12"/><verse number="13" style="v" sid="JOS 9:13"/>ሀ ዎይንያ ኦጎሮታን ኑ ኩንያ ዎደ ኦራ፥ ሽን ሀእ ዳከትዳይሳ በእተ። ኦግያ ሃሆተፈ ደንዶይሳን ኑ ማኦይነ ኑ ጫማይ ዉርስ” ያግዶሶና። <verse eid="JOS 9:13"/><verse number="14" style="v" sid="JOS 9:14"/>ሽን ጎዳ ሸንያ ኦይቾና ደእሸ፥ እስራኤለ አሳይ ኤንታ ሽንቅያፈ ጉራ ኤክዶሶና። <verse eid="JOS 9:14"/><verse number="15" style="v" sid="JOS 9:15"/>ያትን፥ እያሱይ ህንተና ዎኮ ግድ ሳሮ ጫቆ ኤንታራ ጫቀትስ። እስራኤለ ጭማትካ ሄ ጫቁዋ መንኮ ግድ ጫቅዶሶና።<verse eid="JOS 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 9:16"/>ኤንታራ ጫቅዳ ሄን ጋላሳን ሄ አሳት ኤንታ ቢታን ደኤይሳነ ኤንታዉ ሾሮ ግደይሳ እስራኤለ አሳይ ስእዶሶና። <verse eid="JOS 9:16"/><verse number="17" style="v" sid="JOS 9:17"/>እስራኤለ አሳይ ሄ ጋላስ ሄመትድ፥ ሄ አሳት ደእያ ካታማታ ጋክዶሶና። ኤንታ ካታማት ጋባኦና፥ ካፍራ፥ ባሮተነ ቅርያት-ይኣርማ ጌተትድ ፄገቶሶና። <verse eid="JOS 9:17"/><verse number="18" style="v" sid="JOS 9:18"/>ሽን እስራኤለ ጭማት ኤንታዉ ጎዳ፥ እስራኤለ ፆሳ ሱንን ጫቅዳ ግሾ፥ እስራኤለ አሳይ ኤንታ ዎቦኮና። ያትን፥ አሳ ኡባይ ጭማታ ቦላ ዙዙምዶሶና። <verse eid="JOS 9:18"/><verse number="19" style="v" sid="JOS 9:19"/>ሽን እስራኤለ ጭማት፥ “ኑ ኤንታዉ ጎዳ እስራኤለ ፆሳ ሱንን ጫቅዳ ግሾ፥ ሀእ ኤንታ ቦቻናዉ ዳንዳኦኮ። <verse eid="JOS 9:19"/><verse number="20" style="v" sid="JOS 9:20"/>ኑኒ ኤንታዉ ሀይሳዳ ኦና፤ ኑኒ ኤንታዉ ጫቅዳ ጫቁዋ መንን ጎዳ ሀንቆይ ኑ ቦላ ዮናዳ ኤንታ ዎኮ። <verse eid="JOS 9:20"/><verse number="21" style="v" sid="JOS 9:21"/>ኤንቲ ደኦ ጊተ። ግዶሽን እስራኤለ አሳ ኡባስ ምነ ሃ ሺሸይሳታ ግዶ” ያግዶሶና። ሄሳ ግሾ፥ ጭማት ባንታ ጫቁዋ ናግዶሶና።<verse eid="JOS 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 9:22"/>እያሱይ ጋባኦና አሳ ፄግድ፥ “ኑ ማታን ደእሸ፥ ‘ኑኒ ዳሮ ሃሆ ቢታፈ ይዳ’ ግድ፥ ኑና አይስ ጭምደቲ? <verse eid="JOS 9:22"/><verse number="23" style="v" sid="JOS 9:23"/>ህንተ ሄሳ ኦዳ ግሾ፥ ባደትዳይሳታ። ህንተ መርናዉ ታ ፆሳ ኬን ምነ ሃ ሺሽያ አይለ ግዳና” ያግስ።<verse eid="JOS 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 9:24"/>ኤንቲ ዛሪድ፥ “ኑኒ ነ አይለት፥ ጎዳይ ህንተ ፆሳይ ሀ ቢታን ደእያ አሳ ኡባ ይስድ፥ ቢታ ህንተዉ እማናዉ ባ አይልያ ሙሰስ ኦድዳይሳ ስእዳ። ሄሳ ግሾ፥ ህንተዉ ባብድ ሀይሳ ኦዳ። <verse eid="JOS 9:24"/><verse number="25" style="v" sid="JOS 9:25"/>ሀእ ኑኒ ነ ኩሸን ደኦስ። ነዉ ሎኦነ ሱረ ዳንድ በንትዳባ ኦ” ግድ ዛርዶሶና። <verse eid="JOS 9:25"/><verse number="26" style="v" sid="JOS 9:26"/>እያሱይ እስራኤለ አሳይ ኤንታ ዎና መላ አሽስ። <verse eid="JOS 9:26"/><verse number="27" style="v" sid="JOS 9:27"/>ሄ ጋላስ እያሱይ፥ ጋባኦና አሳታ እስራኤለታስነ ጎዳይ ዶርዳ በሳን ደእያ እያ ያርሾ በሳስ ሃነ ም ሺሽያ አስ ግዳና መላ ኦስ። ጋባኦና አሳት ሀች ጋካናዉ ሄሳ ኦሶና።<verse eid="JOS 9:27"/></para>
  <chapter eid="JOS 9"/>
  <chapter number="10" style="c" sid="JOS 10"/>
  <para style="s1">አው ኤቅስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 10:1"/>እያሱይ እያርኮ ካታማ ኦል ይስድ፥ እያ ካዋ ዎዳይሳዳ፥ ጋየ ካታማ ኦል ይስድ፥ እያ ካዋ ዎዳይሳ የሩሳላመ ካዎይ አዶን-ፀደቅ ስእስ። ቃስ ጋባኦና አሳይ እስራኤለ አሳራ ሳሮ ዳናዉ ጫቀትዳይሳ ስእስ። <verse eid="JOS 10:1"/><verse number="2" style="v" sid="JOS 10:2"/>ጋባኦን ሀንኮ ካዎ ካታማታዳ ግታ ካታማ፤ ሄ ካታማይ ጋየ ካታማፐ አስ፤ እያን ደእያ አደትካ ምኖ ኦላንቾ ግደይሳ ኤርያ ግሾ፥ አዶንፀደቅነ እያ አሳይ ዳሮ ያይዶሶና። <verse eid="JOS 10:2"/><verse number="3" style="v" sid="JOS 10:3"/>ሄሳ ግሾ፥ የሩሳላመ ካዎይ አዶን-ፀደቅ፥ ከብሮና ካዋ ሆሀማስ፥ ያርሙታ ካዋ ፕራማስ፥ ላክሶ ካዋ ያፍአስነ፥ ኤግሎና ካዋ ዳብራስ ሀይሳዳ ያግድ ኪትስ፤ <verse eid="JOS 10:3"/><verse number="4" style="v" sid="JOS 10:4"/>“ጋባኦና አሳይ እያሱራነ እስራኤለ አሳራ ሳሮ ደአናዉ ጫቅዳ ግሾ፥ ኤንታ ኦላናዉ ይድ ታና ማድተ” ያግስ። <verse eid="JOS 10:4"/><verse number="5" style="v" sid="JOS 10:5"/>ሀ እቻሹ አሞረ ካዎት ባንታ ኦላንቾታ እስፈ ጋድ፥ ጋባኦና ኦልዶሶና።<verse eid="JOS 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 10:6"/>ጋባኦና አሳይ ጋልጋላን ዱንካንዳ እያሱኮ፥ “ኑና ነ አይለታ አጎፋ፤ ኤለሳ ያዳ ኑና አሻ። ደረይ ዳርያ ቢታን ደእያ አሞረ ካዎት ኡባይ ኑና ኦላናዉ ባንታ ኦላንቾታ እስኖ ኦዳ ግሾ፥ ነ ኑና ማዳ” ያግድ ኪትዶሶና።<verse eid="JOS 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 10:7"/>ሄሳ ግሾ፥ እያሱይ፥ ባራ ደእያ ኦላንቾታነ ምኖ አሳታ ኡባ፥ ጋልጋላፐ ኤክድ ብስ። <verse eid="JOS 10:7"/><verse number="8" style="v" sid="JOS 10:8"/>ጎዳይ እያሱኮ፥ “ኤንታዉ ባቦፋ፤ ታኒ ኤንታ ነ ኩሸን አዳ እማስ። ኤንታፈ እስ አስካ ኔራ ኤቀታናዉ ዳንዳኤና” ያግስ። <verse eid="JOS 10:8"/><verse number="9" style="v" sid="JOS 10:9"/>እያሱይ ጋልጋላፐ ቃማ ኩመ ሄመትሸ አቅድ፥ ጋባኦነ አሳይ ቆፖና ደእሽን ኤንታ ቦላ ኦላ ደንስ። <verse eid="JOS 10:9"/><verse number="10" style="v" sid="JOS 10:10"/>ጎዳይ እስራኤለ አሳ ስንን ኤንታዉ ዎዛና ካሀ ይስስ። እስራኤለ አሳይ ኤንታ ጋባኦናን ዎዶሶና። እስራኤለት ኤንታ ቤት-ሆሮና ኤፍያ ኦግያ ኦይድ ጎድሸ፥ አዜቃነ ማቀዳ ጋካናዉ ጎድዶሶና። <verse eid="JOS 10:10"/><verse number="11" style="v" sid="JOS 10:11"/>ኤንቲ ቤት-ሆሮናፐ ዱገ አዜቃ ኤፍያ ኦግያራ እስራኤለ አሳ ስንፈ ባቃትሽን፥ ጎዳይ ግታ ሻቻ ሹቹ ሳሎፐ ኤንታ ቦላ ቡክስስ። እስራኤለ አሳይ ዎዳ አሳፐ፥ ሻቻይ ዎዳ አሳይ ዳሮ።<verse eid="JOS 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 10:12"/>ጎዳይ እስራኤለ አሳስ አሞረታ፥ አድ እምዳ ጋላስ፥ እስራኤለ አሳይ ስእሽን፥ እያሱይ፥</para>
  <para style="q1" vid="JOS 10:12">“አዋይ ጋባኦና ቦላ ዉሎና ኤቆ።</para>
  <para style="q2" vid="JOS 10:12">አጌናይካ ኤሎና ዛንጋራ ቦላ ኤቆ”</para>
  <para style="m" vid="JOS 10:12">ያግድ ጎዳ ዎስስ።<verse eid="JOS 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 10:13"/>እስራኤለ አሳይ ባንታ ሞርከታ ፆናና ጋካናዉ፥ አዋይ ዉሎና ኤቅስ፤ አጌናይካ ባ ደእያ በሳፈ ቃፅቤና።</para>
  <para style="p" vid="JOS 10:13">ሄስ ያሻራ ማፃፋን ፃፈትስ። አዋይ ሳሎስ ግዶን ቃፆና ኤቅስ፤ እስ ጋላስ ኩመ አዋይ ዉሎና ጋምእስ። <verse eid="JOS 10:13"/><verse number="14" style="v" sid="JOS 10:14"/>ጎዳይ አሳ ቃላ ስእዳ ሄ ጋላሳ መላ ጋላስ ሀይሳፈ ካሰካ ሀይሳፈ ስንንካ ዴና። ቱማካ ጎዳይ እስራኤለ አሳስ ኦለትስ። <verse eid="JOS 10:14"/><verse number="15" style="v" sid="JOS 10:15"/>ሄሳፈ ጉየ፥ እያሱይነ እያ ኦላንቾት ባንታ ዱንካንዳ ጉታ ጋልጋላ ስምዶሶና።<verse eid="JOS 10:15"/></para>
  <para style="s1">እቻሹ አሞረ ካዎታ ሀይቁዋ</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 10:16"/>ሄ እቻሹ አሞረ ካዎት ባቃትድ፥ ማቀዳ ጎንጎሉዋን ቆሰትዶሶና። <verse eid="JOS 10:16"/><verse number="17" style="v" sid="JOS 10:17"/>እቻሹ ካዎት፥ ማቀዳ ጎንጎሉዋን ቆሰትድ ደእሽን ደምዳይሳ እያሱስ ኦድዶሶና።<verse eid="JOS 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 10:18"/>እያሱይ ዛሪድ፥ “ግታ ሹቻታ ጎንዶርስድ፥ ጎንጎሉዋ ዶና ጎርድተ፤ ኤንታ ናጋና መላ አሰ ያን ዎተ። <verse eid="JOS 10:18"/><verse number="19" style="v" sid="JOS 10:19"/>ሽን ህንተ ያን ጋምኦፍተ፤ ኤንቲ ባንታ ካታማ ገልድ አቶና መላ ህንተ ሞርከታ ጎድድ ኤንታ ዎተ። ጎዳይ ህንተ ፆሳይ ኤንታ ህንተ ኩሸን አድ እምስ” ያግስ። <verse eid="JOS 10:19"/><verse number="20" style="v" sid="JOS 10:20"/>ጉ አሳት ባቃትድ ባንታ ግምበትዳ ካታማ ገልድ አትኮካ፥ እያሱይነ እስራኤለ አሳይ አሳ ኡባ ዎዶሶና። <verse eid="JOS 10:20"/><verse number="21" style="v" sid="JOS 10:21"/>ሄሳፈ ጉየ፥ እስራኤለ አሳ ኡባይ ሳሮን ስሚድ፥ እያሱይ ዱንካንድ ደእያ ጉታ ማቀዳ ይዶሶና። ሄ ዎደፐ ዶምድ ኦንካ እስራኤለ አሳ ቦላ እስ ቃላካ ኦደታናዉ ፃልዳ አስ ባዋ።<verse eid="JOS 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 10:22"/>ሄሳፈ ጉየ፥ እያሱይ፥ “ጎንጎሉዋ ዶና ዶይድ፥ ሄ እቻሹ ካዎታ ከስድ፥ ታዉ ሀ ኤክድ ዪተ” ያግስ። <verse eid="JOS 10:22"/><verse number="23" style="v" sid="JOS 10:23"/>ጎንጎሉዋ ዶና ዶይድ፥ የሩሳላመ ካዋ፥ ከብሮና ካዋ፥ ያርሙታ ካዋ፥ ላክሶ ካዋነ ኤግሎና ካዋ እያኮ ኤህዶሶና። <verse eid="JOS 10:23"/><verse number="24" style="v" sid="JOS 10:24"/>ኤንቲ ሄ ካዎታ እያኮ ኤህዳ ዎደ፥ እያሱይ እስራኤለ አሳ ኡባ ባኮ ፄግድ፥ ባራ ብዳ ቶራ ሞጮናታኮ፥ “ሃ ይድ፥ ህንተ ቶሁዋ ሀ ካዎታ ቆያን ዎተ” ያግስ። ኤንቲ ይድ ኪተትዳይሳዳ ኦዶሶና። <verse eid="JOS 10:24"/><verse number="25" style="v" sid="JOS 10:25"/>እያሱይ ኤንታኮ፥ “ህንተ ኦለትያ ህንተ ሞርከታ ቦላ ጎዳይ ሀይሳዳ ኦና ግሾ፥ አይኮይ ባዋ ያዮፍተ፤ ምንተ” ያግስ።<verse eid="JOS 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 10:26"/>እያሱይ ሄ እቻሹ ካዎታ ዎድ፥ እቻሹ ም ቦላ ካቅስ፤ ኤንታ አሀይ ኦማርስ ጋካናዉ ያን ፔእስ። <verse eid="JOS 10:26"/><verse number="27" style="v" sid="JOS 10:27"/>አው ዉልያ ዎደ እያሱይ፥ “አሀ ዎስድ፥ ኤንቲ ካሰ ቆሰትዳ ጎንጎሉዋን ሆልተ። ያትድ፥ ሄ ጎንጎሉዋ ዶና ግታ ሹቻን ጎርድተ” ያግድ ኪትስ። ሄ ሹቻት ሀች ጋካናዉ ያን ደኦሶና።<verse eid="JOS 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 10:28"/>ሄ ጋላስ እያሱይ ማቀዳ ካታማ ኦይክስ፤ ካታማ ካዋካ ዎስ፤ ካታማን ደእያ አሳ ኡባ እስ አስካ አሾና ይስስ። እያርኮ ካታማ ካዋ ቦላ ኦዳይሳዳ፥ ማቀዳ ካታማ ካዋ ቦላ ኦስ።<verse eid="JOS 10:28"/></para>
  <para style="s1">ዱገሀ ካታማታ ፆነተ</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 10:29"/>ያፐ ስሚድ፥ እያሱይነ እያ ኦላንቾት ኡባይ ማቀዳፐ ብድ ልብና ካታማ ኦልዶሶና። <verse eid="JOS 10:29"/><verse number="30" style="v" sid="JOS 10:30"/>ጎዳይ ሄ ካታማነ ካታማ ካዋ ኤንታ ኩሸን አድ እምስ። እያሱይ ካታማን ደእያ አሳፐ እሱዋካ አሾና ማሻን ዎስ። እያርኮ ካታማ ካዋ ቦላ ኦዳይሳዳ ልብና ካታማ ካዋ ቦላ ኦስ።<verse eid="JOS 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 10:31"/>እያሱይነ እያ ኦላንቾት ልብና ካታማፐ ላክሶ ካታማ ብድ፥ ሄ ካታማ ኦልዶሶና። <verse eid="JOS 10:31"/><verse number="32" style="v" sid="JOS 10:32"/>ጎዳይ ላክሶ ካታማ እስራኤለ አሳ ኩሸን አድ እምን፥ እያሱይ ሄ ካታማ ዩሹዋ ተቅድ ናምአን ጋላሳን ኦይክስ። ልብና ካታማን ኦዳይሳዳ ላክሶ ካታማን ደእያ አሳ ኡባ ማሻን ዎስ። <verse eid="JOS 10:32"/><verse number="33" style="v" sid="JOS 10:33"/>ሄ ዎደ፥ ገዘራ ካዎይ ሆራም፥ ላክሶ ካዋ ማዳናዉ ይስ፥ ሽን እያሱይ እያነ እያ ኦላንቾታ ይስስ፤ ኤንታፈ እስ አስካ አትቤና።<verse eid="JOS 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 10:34"/>ሄሳፈ ስሚድ፥ እያሱይነ እያ ኦላንቾት ኡባይ ላክሶ ካታማፐ ኤግሎና ካታማ ብድ፥ ሄ ካታማ ዩሹዋ ተቅድ ኦልዶሶና። <verse eid="JOS 10:34"/><verse number="35" style="v" sid="JOS 10:35"/>ሄ ጋላስ ኤግሎና ካታማ ኦይክድ፥ ላክሶ ካታማን ኦዳይሳዳ ማሻን አሰ ኡባ ዎዶሶና።<verse eid="JOS 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JOS 10:36"/>ያት ስሚድ፥ እያሱይነ እያ ኦላንቾት ኤግሎናፐ ከብሮና ብድ፥ ከብሮና ኦልዶሶና። <verse eid="JOS 10:36"/><verse number="37" style="v" sid="JOS 10:37"/>ሄ ካታማነ እያ ዩሹዋን ደእያ ጉ ካታማታ ኦይክድ እያን ደእያ አሳነ ካዋ ዎዶሶና። እያሱይ ኤግሎናን ኦዳይሳዳ ሄ ካታማ ቦላካ ኦስ።<verse eid="JOS 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JOS 10:38"/>ሄሳፈ ጉየ፥ እያሱይነ እያራ ደእያ እስራኤለ ኦላንቾት ጉየ ስሚድ ዳብራ ካታማ ኦልዶሶና። <verse eid="JOS 10:38"/><verse number="39" style="v" sid="JOS 10:39"/>ሄ ካታማነ እያ ዩሹዋን ደእያ ጉ ጉታታ ኦይክድ፥ እያን ደእያ አሳነ ካዋ ዎዶሶና። እያሱይ ከብሮናነ ልብና ካታማታ ቦላ ኦዳይሳዳ ዳብራ ቦላ ኦስ።<verse eid="JOS 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 10:40"/>እያሱይ ሄ ቢታን ደእያ ካታማታ ኡባ ኦይክስ። ደረይ ዳርያ ቢታን፥ ነገበ ጋን፥ ሎቡዋነ ኤንታ ካዎታ ኡባ ኦይክስ። ጎዳይ እስራኤለ ፆሳይ እያ ኪትዳይሳዳ፥ ቢታ ቦላ ደእያ አስ እሱዋካ አሾና ኡባ ዎድ ይስስ። <verse eid="JOS 10:40"/><verse number="41" style="v" sid="JOS 10:41"/>እያሱይ ቃደስ-ባርነፈ ብድ ጋዛ ጋካናዉ ቃስ ጎሸና ቢታፈ ብድ ጋባኦና ጋካናዉ ደእያ ኡባ ኦልድ ፆንስ። <verse eid="JOS 10:41"/><verse number="42" style="v" sid="JOS 10:42"/>ጎዳይ፥ እስራኤለ ፆሳይ፥ እስራኤለታስ ኦለትዳ ግሾ እያሱይ ሀ ካዎታነ ኤንታ ቢታ ኡባ ኦልድ ኦይክስ። <verse eid="JOS 10:42"/><verse number="43" style="v" sid="JOS 10:43"/>ሄሳፈ ጉየ፥ እያሱይነ እስራኤለ ኦላንቾት ባንታ ዱንካንዳ ጉታ ጋልጋላ ስምዶሶና።<verse eid="JOS 10:43"/></para>
  <chapter eid="JOS 10"/>
  <chapter number="11" style="c" sid="JOS 11"/>
  <para style="s1">ፑደሀ ካዎታ ፆነተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 11:1"/>ሀዞራ ካዎይ ያብን፥ እስራኤለታ ፆኑዋ ስእዳ ዎደ ማዶና ካዋ ዮባባስ፥ ሽምሮና ካዋስ፥ አዝፋ ካዋስ፥ <verse eid="JOS 11:1"/><verse number="2" style="v" sid="JOS 11:2"/>ፑደሀ ገዘን ደእያ ካዎታስ፥ ከነሬታ አባፈ ዱገሀ ባጋን ዮርዳኖሰ ዛንጋራን ደእያ ካዎታስ፥ ናፋት-ዶራፐ ዉሎሀ ባጋራ ጋን ደእያ ካዎታስ ኪታ የድስ። <verse eid="JOS 11:2"/><verse number="3" style="v" sid="JOS 11:3"/>ቃስ ዶሎሀነ ዉሎሀ ባጋን ደእያ ካናነታስ፥ አሞረታስ፥ ህተታስ፥ ፓርዘታስ፥ ደረይ ዳርያ ቢታን ደእያ ያቡሰታስነ ምፅጳን አርሞና ዙማፐ ጋርሳን ደእያ ህወታስ ኪትስ። <verse eid="JOS 11:3"/><verse number="4" style="v" sid="JOS 11:4"/>ኤንቲ ኡባይ፥ ባንታ ኦላንቾታ፥ ፓራታነ ፓራ ጋረታ እስፈ ጋድ ይዶሶና። ኤንታ ታይቦይ አባ ጋፃን ደእያ ሻፈ መላ። <verse eid="JOS 11:4"/><verse number="5" style="v" sid="JOS 11:5"/>ሄ ካዎት ኡባይ ባንታ ዎልቃ እስፈ ጋድ፥ እስራኤለታ ኦላናዉ መሮመ ሃ ማታን ዱንካንዶሶና።<verse eid="JOS 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 11:6"/>ጎዳይ እያሱኮ፥ “ነ ኤንታዉ ባቦፋ፤ ታኒ ዎንቶ ሀኖደ ኤንታ ኡባ ዎዳ እስራኤለ አሳስ አ እማና። ኔን ኤንታ ፓራታ ጋድያ ቃንፃና፤ ኤንታ ፓራ ጋረታካ ታማን ፁጋና” ያግስ። <verse eid="JOS 11:6"/><verse number="7" style="v" sid="JOS 11:7"/>እያሱይነ እያ ኦላንቾት ኡባይ ኤንቲ ቆፖና ደእሽን መሮመ ሃ ማታን ኤንታ ቦላ ከይድ ኦልዶሶና። <verse eid="JOS 11:7"/><verse number="8" style="v" sid="JOS 11:8"/>ጎዳይ ኤንታና እስራኤለታ ኩሸን አድ እምስ። እስራኤለት ኤንታ ኦልድ፥ ግታ ስዶናነ ማስሮታ ጋካናዉ፥ ቃስ ዶሎሀ ባጋን ደእያ ምፅጳ ዛንጋራ ጋካናዉ ኤንታና የደዶሶና። ኤንታፈ እስ አስካ አሾና ኡባ ዎዶሶና። <verse eid="JOS 11:8"/><verse number="9" style="v" sid="JOS 11:9"/>እያሱይ፥ ጎዳይ ኪትዳይሳዳ ኡባ ቦላ ኦስ፤ ኤንታ ፓራታ ጋድያ ቃንፅስ፤ ኤንታ ጋረታ ፁግስ።<verse eid="JOS 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 11:10"/>ያትድ፥ እያሱይ ጉየ ስሚድ፥ ሀዞራ ኦል ኦይክድ፥ ካዉዋካ ማሻን ዎስ። ሄ ዎደ ሀዞራ ካዎተይ ሀራ ካዎተ ኡባስ ሁጰ። <verse eid="JOS 11:10"/><verse number="11" style="v" sid="JOS 11:11"/>እስራኤለ አሳይ ሀዞራን ደእያ አሳ ኡባ ማሻን ዎዳ ግሾ ሸምፖራ አትዳ አስ ባዋ። ሄ ካታማይ ታማን ፁገትስ።<verse eid="JOS 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 11:12"/>ጎዳ አይለይ ሙሰይ ኪትዳይሳዳ፥ እያሱይ ሄ ካታማታነ ኤንታ ካዎታ ኡባ ድእስ። እስ አስካ አሾና አሳ ኡባ ማሻን ዎስ። <verse eid="JOS 11:12"/><verse number="13" style="v" sid="JOS 11:13"/>ግዶሽን፥ እያሱይ ፁግዳ ሀዞራ ካታማፐ አትሽን፥ ዞዘ ቦላ<note caller="+" style="f"><char style="fr" closed="false">11:13 </char><char style="fq" closed="false">ዞዘ ቦላ፦ </char><char style="ft" closed="false">ሄስ መ ዞዘ ግዶናሽን ካታማት ኦላን ላለትን ካሰ ቢታ ደንናሽን እያ ቦላ ኬፅሽን ዶረትድ ዞዘ ግድስ ጉሱ።</char></note> ኬፀትዳ ካታማታ እስራኤለ አሳይ ፁግቦኮና። <verse eid="JOS 11:13"/><verse number="14" style="v" sid="JOS 11:14"/>እስራኤለ አሳይ ሄ ካታማታፐ ቦንቅዳ፥ ሚሽያነ መሄ ኡባ ባንታዉ ኤክዶሶና። እስ አስካ አሾና አሳ ኡባ ማሻን ዎዶሶና። <verse eid="JOS 11:14"/><verse number="15" style="v" sid="JOS 11:15"/>ጎዳይ ባ አይልያ ሙሰ ኪትዳይሳዳ፥ ሙሰይ እያሱ ኪትስ፤ እያሱይካ ኪታ ፖልስ። ጎዳይ ሙሰ ኪትዳባፐ እስባካ እያሱይ አሽቤና፤ ኡባ ኦስ።<verse eid="JOS 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 11:16"/>እያሱይነ እያ ኦላንቾት ደረይ ዳርያ ቢታ፥ ነገበ መላ ቢታ፥ ጎሸና ቢታ ኡባ፥ ዉሎሀ ባጋን ደእያ ጋነ ዮርዳኖሰ ዛንጋራ ኦልድ ኦይክስ። <verse eid="JOS 11:16"/><verse number="17" style="v" sid="JOS 11:17"/>እ ሳይረ ካንስያ ሀላቃ ዙማፐ ብድ፥ አርሞና ዙማፐ ጋርሳ ባጋን ደእያ ልባኖሰ ዛንጋራነ ባኣል-ጋደ ጋካናዉ ደእያ ቢታታ ኦይክስ። ኤንታ ካዎታ ኡባ ሾጭስ፤ ድእድ ዎስ። <verse eid="JOS 11:17"/><verse number="18" style="v" sid="JOS 11:18"/>እያሱይ ዳሮ ዎደ ሄ ካዎታ ኡባራ ኦለትስ። <verse eid="JOS 11:18"/><verse number="19" style="v" sid="JOS 11:19"/>ጋባኦናን ደእያ ህወታፐ አትሽን፥ ሀራ ካታም እስራኤለታራ ሳሮ ዳናዉ ጫቅዳይ ባዋ። እስራኤለት ሀራ ካታማታ ኡባ ኦላን ፆንድ ኦይክዶሶና። <verse eid="JOS 11:19"/><verse number="20" style="v" sid="JOS 11:20"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ እያሱይ ኤንታ ማሮት ባይና ኡባ ዎና መላ ጎዳይ ኤንታ ዎዛና ሙምስድ እስራኤለታ ኦላና መላ ደንስ።<verse eid="JOS 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 11:21"/>ሄ ዎደ እያሱይ ብድ ደረይ ዳርያ ከብሮናን፥ ዳብራን፥ አናባን፥ ደረይ ዳርያ ይሁዳንነ እስራኤለን ደእያ አዱሳታ፥ አናቀ ኮቻታ ዎድ ኦንግስ። እያሱይ ኤንታነ ኤንታ ካታማታ ኩመ ይስስ። <verse eid="JOS 11:21"/><verse number="22" style="v" sid="JOS 11:22"/>አናቀ ኮቻታፐ ኦንካ እስራኤለ ቢታን አትቤና፥ ሽን ጋዛን፥ ጋታንነ አሽዶዳን ጉት አትዶሶና። <verse eid="JOS 11:22"/><verse number="23" style="v" sid="JOS 11:23"/>ጎዳይ ሙሰ ኪትዳይሳዳ እያሱይ ቢታ ኡባ ኦይክድ፥ እስራኤለ አሳ ኮቻን ኮቻን ሻክድ ላትስስ።</para>
  <para style="p" vid="JOS 11:23">ሄሳፈ ጉየ ቢታይ ኦላፐ ሸምፕስ።<verse eid="JOS 11:23"/></para>
  <chapter eid="JOS 11"/>
  <chapter number="12" style="c" sid="JOS 12"/>
  <para style="s1">ፆነትዳ ካዎታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 12:1"/>እስራኤለ አሳይ ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋራ ደእያ አርኖና ዛንጋራፐ ብድ አርሞና ዙማ ጋካናዉ፥ ቃስ ዶሎሀ ባጋራ ዮርዳኖሰ ዛንጋራ ጋካናዉ ደእያ ቢታ ኡባ ኦልድ ኦይክስ። ሄ ፆነትዳ ካዎት ሀይሳፈ ካልድ ፃፈትዳይሳታ፤ <verse eid="JOS 12:1"/><verse number="2" style="v" sid="JOS 12:2"/>ሀሰቦናን ኡትድ ሃርያ አሞረታ ካዋ ስሆና። እ ጋላዳ ቢታስ ባጋ ኤክድ፥ አርኖና ዛንጋራ ማታን ደእያ አሮራፐ ደንድድ፥ አሞነታ ዛዋ ያቦቃ ሻፋ ጋካናዉ ደኤይሳ ሃሬስ። <verse eid="JOS 12:2"/><verse number="3" style="v" sid="JOS 12:3"/>ቃስ ዶሎሀ ባጋራ ዮርዳኖሰ ዛንጋራን ከነሬታ አባፈ ብድ፥ ቤት-ያሽሞታ ባጋራ ማፅነ አባ ካንድ፥ ፕስጋ ደርያፐ ጋርሳ ባጋራ ደእያ ቢታታ ሃሬስ።<verse eid="JOS 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 12:4"/>ሄሳዳካ፥ ራፋይመታ ሼሻፐ ዉርሰ ግድዳ፥ አስታሮተነ ኤድራአ ሃርያ፥ ባሳነ ካዋ ኦገ ፆንስ። <verse eid="JOS 12:4"/><verse number="5" style="v" sid="JOS 12:5"/>ኦገይ፥ ሃርያ ዛዋይ ፑደሀን አርሞና ዙማ፥ ዶሎሀን ሳላካ ካታማ ጋክድ፥ ዉሎሀን ጌሹረታነ ማካታ ዛዋ ጋካናዉ ደእያ ባሳነ ቢታ ኡባ ጋኬስ። ሀሰቦና ካዋ ስሆና ቢታ ጋላዳ ፑደሀ ባጋ ጉጅድ ሃሬስ።<verse eid="JOS 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 12:6"/>ጎዳ አይለይ ሙሰይ ካለን፥ እስራኤለ አሳይ ሀ ካዎታ ፆንዶሶና። ጎዳ አይለይ ሙሰይ ኤንታ ቢታ ሮቤላ ኮቻታስ፥ ጋዳ ኮቻታስነ ምናሰ ኮቻፈ ባጋስ ሻክድ ላትስስ።<verse eid="JOS 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 12:7"/>እያሱይነ እስራኤለ አሳይ ዮርዳኖሰ ሻፋፐ ዉሎሀ ባጋን ደእያ ካዎታ ኡባ ፆንዶሶና። ሄ ቢታይ ልባኖሰ ዛንጋራን ደእያ ባኣል-ጋደፐ ብድ፥ ዱገሀ ባጋራ ሳይረ ማታን ደእያ ሀላቃ ደርያ ጋኬስ። እያሱይ ሄ ቢታ ሻክድ፥ እስራኤለ ኮቻታስ ላታ ቢታ ኦድ እምስ። <verse eid="JOS 12:7"/><verse number="8" style="v" sid="JOS 12:8"/>ሄ እ እምዳ ቢታይ፥ ደረይ ዳርያ ቢታ፥ ዉሎሀ ባጋን ደእያ ጋ፥ ዮርዳኖሰ ዛንጋራ፥ ይሁዳነ ነገበ መላ ቢታ። ሄ ቢታይ ካሰ ህተት፥ አሞረት፥ ካናነት፥ ፓርዘት፥ ህወትነ ያቡሰት ደእያ ቢታ። <verse eid="JOS 12:8"/><verse number="9" style="v" sid="JOS 12:9"/>እስራኤለ አሳይ ፆንዳ ካዎት ሀይሳፈ ካልድ ፃፈትዳይሳታ፤ እያርኮ ካዋ፥ ቤተለ ማታን ደእያ ጋየ ካዋ፥ <verse eid="JOS 12:9"/><verse number="10" style="v" sid="JOS 12:10"/>የሩሳላመ ካዋ፥ ከብሮና ካዋ፥ <verse eid="JOS 12:10"/><verse number="11" style="v" sid="JOS 12:11"/>ያርሙታ ካዋ፥ ላክሶ ካዋ፥ <verse eid="JOS 12:11"/><verse number="12" style="v" sid="JOS 12:12"/>ኤግሎና ካዋ፥ ገዘራ ካዋ፥ <verse eid="JOS 12:12"/><verse number="13" style="v" sid="JOS 12:13"/>ዳብራ ካዋ፥ ገደራ ካዋ፥ <verse eid="JOS 12:13"/><verse number="14" style="v" sid="JOS 12:14"/>ሆርማ ካዋ፥ አራዳ ካዋ፥ <verse eid="JOS 12:14"/><verse number="15" style="v" sid="JOS 12:15"/>ልብና ካዋ፥ አዱላማ ካዋ፥ <verse eid="JOS 12:15"/><verse number="16" style="v" sid="JOS 12:16"/>ማቀዳ ካዋ፥ ቤተለ ካዋ፥ <verse eid="JOS 12:16"/><verse number="17" style="v" sid="JOS 12:17"/>ታፑሀ ካዋ፥ ሄፌራ ካዋ፥ <verse eid="JOS 12:17"/><verse number="18" style="v" sid="JOS 12:18"/>አፌቃ ካዋ፥ ሳሮና ካዋ፥ <verse eid="JOS 12:18"/><verse number="19" style="v" sid="JOS 12:19"/>ማዶና ካዋ፥ ሀዞራ ካዋ፥ <verse eid="JOS 12:19"/><verse number="20" style="v" sid="JOS 12:20"/>ሽምሮን-ማሮና ካዋ፥ አዝፋ ካዋ፥ <verse eid="JOS 12:20"/><verse number="21" style="v" sid="JOS 12:21"/>ታናካ ካዋ፥ ማግዶ ካዋ፥ <verse eid="JOS 12:21"/><verse number="22" style="v" sid="JOS 12:22"/>ቃደሳ ካዋ፥ ቃርመሎሳን ደእያ ዮቅናመ ካዋ፥ <verse eid="JOS 12:22"/><verse number="23" style="v" sid="JOS 12:23"/>ገዘን ደእያ ዶራ ካዋ፥ ጋልጋላን ደእያ ጎይማ ካዋነ <verse eid="JOS 12:23"/><verse number="24" style="v" sid="JOS 12:24"/>ትርሳ ካዋ።</para>
  <para style="m" vid="JOS 12:24">ኤንቲ ኩመ ሀስታማነ እስ ካዎታ።<verse eid="JOS 12:24"/></para>
  <chapter eid="JOS 12"/>
  <chapter number="13" style="c" sid="JOS 13"/>
  <para style="s1">ቡሮ ኦይከትቦና ቢታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 13:1"/>እያሱይ ዳሮ ጭምዳ ዎደ ጎዳይ እያኮ፥ “ኔን ጭማዳሳ፤ ነ ላይይካ ሱገትስ፥ ግዶሽን ኦይከቶና አትዳ ዳሮ ቢታት ደኦሶና። <verse eid="JOS 13:1"/><verse number="2" style="v" sid="JOS 13:2"/>ኦይከትቦና ቢታት ሀይሳታ፤ ፍልስፄመታነ ጌሹረታ ቢታ ኡባ። <verse eid="JOS 13:2"/><verse number="3" style="v" sid="JOS 13:3"/>ግብፀፈ ዶሎሀ ባጋን ደእያ ሽሆራ ሻፋፐ ብድ፥ ፑደሀ ባጋን ደእያ ኤክሮና ቢታ ጋካናዉ ደእያ ቢታ ኡባ። ሄ ቢታት ካናነ ቢታ ጌተቶሶና። ኤንትካ እቻሹ ፍልስፄመ ካዎት አይስያ ጋዛ፥ አሽዶዳ፥ አስቀሎና፥ ጋተነ ኤክሮና ጌተትያ ካታማታ። አዌታ ቢታይካ ቡሮ ኦይከትቤና። <verse eid="JOS 13:3"/><verse number="4" style="v" sid="JOS 13:4"/>ዱገሀ ባጋን ደእያ ካናነታ ቢታነ፥ ስዶናታ ቢታ ግድዳ ማራፐ ብድ አሞረታ ዛዋ አፌቃ ጋካናዉ ደእያ ቢታይ ኦይከትቤና። <verse eid="JOS 13:4"/><verse number="5" style="v" sid="JOS 13:5"/>ገባላታ ቢታይነ ባኣል-ጋደፐ ዶሎሀ ባጋን ደእያ አርሞና ዙማፐ ብድ፥ ሀማታ ፕኖ ጋካናዉ ቡሮ ኦይከትቤና። <verse eid="JOS 13:5"/><verse number="6" style="v" sid="JOS 13:6"/>ልባኖሰፐ ብድ ማሰሮና ጋካናዉ ገዘ ቢታን ደእያ ስዶናታ ኡባ ታኒ እስራኤለታ ስንፈ ጎዳ ከሳና። ታኒ ነና ኪትዳይሳዳ ሄ ቢታ እስራኤለ አሳስ ላታ ኦዳ ሻካ። <verse eid="JOS 13:6"/><verse number="7" style="v" sid="JOS 13:7"/>ኔን ሄ ቢታ ኡዱፉን ኮቻታስነ ምናሰ ኮቻፈ ባጋስ ሻካ” ያግስ።<verse eid="JOS 13:7"/></para>
  <para style="s1">ዮርዳኖሰፐ ዶሎሀ ባጋ ቢታ</para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 13:8"/>ሮቤላ ኮቻይ፥ ጋዳ ኮቻይነ ምናሰ ኮቻፈ ባጋይ ጎዳ አይለይ ሙሰይ ዮርዳኖሰፐ ሄፍንን፥ ዶሎሀ ባጋን ደእያ ቢታ ካሰ ላታ ኦድ ኤንታዉ እምስ። <verse eid="JOS 13:8"/><verse number="9" style="v" sid="JOS 13:9"/>ኤንታ ቢታይ አርኖና ዛንጋራ ማታን ደእያ አሮኤራፐ ብድ፥ ሄ ዛንጋራን ደእያ ካታማፐ ብድ፥ መደባ ገዝያ ካንድ ድቦና ጋካናሳ። <verse eid="JOS 13:9"/><verse number="10" style="v" sid="JOS 13:10"/>ቃስ ሀሰቦናን ኡትድ አሞነታ ዛዋ ጋካናዉ ሃርያ አሞረታ ካዋ ስሆና ካታማታ ኡባ ጋኬስ። <verse eid="JOS 13:10"/><verse number="11" style="v" sid="JOS 13:11"/>ሄሳዳካ፥ ጋላዳታ፥ ጌሹረታነ ማእካታ ቢታ ኡባ፥ አርሞና ዙማ ኡባነ ሳላካ ጋካናዉ ደእያ ባሳነ ቢታ ኡባ ኦይኬስ። <verse eid="JOS 13:11"/><verse number="12" style="v" sid="JOS 13:12"/>አስታሮተንነ ኤድራአን ኡትድ፥ ሃርዳ ባሳነ ካዋ ኦገ ቢታ ኡባ ኦይኬስ፤ ሄ ቢታይ ካሰ ራፋይመታፐ አትዳ ቢታ። ሙሰይ ኤንታ ፆንድ ቢታፈ ጎድድ ከስስ። <verse eid="JOS 13:12"/><verse number="13" style="v" sid="JOS 13:13"/>ሽን እስራኤለ አሳይ ጌሹረታነ ማእካታ ጎድድ ከስቦኮና። ኤንቲ ሀች ጋካናዉ እስራኤለ አሳ ግዶን ደኦሶና።<verse eid="JOS 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 13:14"/>ሙሰይ ሌወ ኮቻስ ላታ ቢታ እምቤና። ጎዳይ፥ እስራኤለ ፆሳይ፥ ኤንታዉ ኪትዳይሳዳ ታማን ፁሳ ያርሾ ኤንታዉ ላታ ኦድ እምስ።<verse eid="JOS 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 13:15"/>ሙሰይ ሮቤላ ኮቻስ ኤንታ ኮቻን ኮቻን ላታ እምስ። <verse eid="JOS 13:15"/><verse number="16" style="v" sid="JOS 13:16"/>ኤንታ ቢታይ አርኖና ዛንጋራ ማታን ደእያ አሮኤራፐ ብድ፥ ሄ ዛንጋራን ደእያ ካታማ ካንድ ገዘ መደባ ጋኬስ። <verse eid="JOS 13:16"/><verse number="17" style="v" sid="JOS 13:17"/>ሀሰቦና፥ ገዘ ካታማታ፥ ድቦና፥ ባሞት-ባኣላ፥ ቤት-ባል-መኦና፥ <verse eid="JOS 13:17"/><verse number="18" style="v" sid="JOS 13:18"/>ያሃፃ፥ ቀደሞታ፥ መፋታ፥ <verse eid="JOS 13:18"/><verse number="19" style="v" sid="JOS 13:19"/>ቅራታይማ፥ ሰባማ፥ ደረይ ዳርያ ዛንጋራን ደእያ ፀረት-ሻሃረ፥ <verse eid="JOS 13:19"/><verse number="20" style="v" sid="JOS 13:20"/>ቤት-ፓኦራ፥ ፕስጋ ዙማፐ ጋርሳን ደእያ ቢታነ ቤት-ያሽሞታ ጌተትያ ቢታታ ኡባ ጋኬስ። <verse eid="JOS 13:20"/><verse number="21" style="v" sid="JOS 13:21"/>ቃስ ገዘን ደእያ ካታማታነ ሀሰቦናን ኡትድ ሃርዳ አሞረታ ካዋ ስሆና ቢታ ኡባ ጋኬስ። ሙሰይ ካዋ ስሆናነ ምድያመታ ሀላቃታ ኤዋ፥ ረቄማ፥ ፁራ፥ ሁራነ ሬባ ኦልድ ፆንስ። ሀይሳቲ ካዋ ስሆናፐ ጋርሳን ሄ ቢታ ሃረይሳታ። <verse eid="JOS 13:21"/><verse number="22" style="v" sid="JOS 13:22"/>እስራኤለ አሳይ ማሩዋ፥ ብኦራ ናኣ፥ ባላማ ዎዶሶና። <verse eid="JOS 13:22"/><verse number="23" style="v" sid="JOS 13:23"/>ሮቤላ ኮቻስ ዉሎሀ ባጋ ዛዋይ ዮርዳኖሰ ሻፋ። ሮቤላ ኮቻስ ኮቻን ኮቻን ላታ ግድድ እመትዳ ካታማትነ ጉታት ሀይሳታ።<verse eid="JOS 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 13:24"/>ሙሰይ ጋዳ ኮቻስ ኤንታ ኮቻን ኮቻን ላታ ቢታ ሻክድ እምስ። <verse eid="JOS 13:24"/><verse number="25" style="v" sid="JOS 13:25"/>ኤንታ ቢታይ ያእዜራ፥ ጋላዳን ደእያ ካታማታ ኡባነ አሞነታ ቢታፈ ባጋ ኤክድ፥ ራባ ዶሎሀ ባጋን ደእያ አሮኤራ ጋኬስ። <verse eid="JOS 13:25"/><verse number="26" style="v" sid="JOS 13:26"/>ሄሳዳካ፥ ሀሰቦናፐ ደንድድ፥ ራሞት-ምፅጳነ በፆንማ ጋኬስ። ቃስ ማህናይማፐ ብድ ዳቤራ ዛዋ ጋኬስ። <verse eid="JOS 13:26"/><verse number="27" style="v" sid="JOS 13:27"/>ቃስ ዮርዳኖሰ ዛንጋራን፥ ሀሰቦና ካዋ ስሆና ካዎተፈ አትዳ፥ ቤት-ሀራመ፥ ቤት-ንምራ፥ ሱኮታነ ፃፎና ጌተትያ ካታማታ ኤኬስ። ኤንታ ዛዋይ ዉሎሀ ባጋን ዮርዳኖሰ ሻፋ፥ ቃስ ፑደሀ ባጋን ከነሬታ አባ ጋኬስ። <verse eid="JOS 13:27"/><verse number="28" style="v" sid="JOS 13:28"/>ጋዳ ኮቻስ ኮቻን ኮቻን ላታ ቢታ ግድድ እመትዳ ካታማትነ ጉታት ሀይሳታ።<verse eid="JOS 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 13:29"/>ሙሰይ ምናሰ ኮቻፈ ባጋስ ኤንታ ኮቻን ኮቻን ላታ ቢታ እምስ። <verse eid="JOS 13:29"/><verse number="30" style="v" sid="JOS 13:30"/>ኤንታ ቢታይ ማህናይማነ ባሳነ ቢታ ኡባ ጋክ ኦይኬስ። ባሳነ ካዋ ኦገ ካዎተ ኡባነ ባሳነን ደእያ ኡሱፑን ታሙ ያእራ ካታማታ ኦይኬስ። <verse eid="JOS 13:30"/><verse number="31" style="v" sid="JOS 13:31"/>ቃስ ጋላዳፐ ባጋነ ባሳነን ኦገ ካዎተስ ዋና ካታማ ግድዳ አስታሮተነ ኤድራአ ጌተትያ ካታማታ ጋኬስ። ሄ ኡባይ ምናሰ ናአ ማክራ ኮቻስ ኤንታ ኮቻን ኮቻን ጋክዳይሳ።<verse eid="JOS 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 13:32"/>ሙሰይ ዮርዳኖሰፐ ሄፍንን፥ እያርኮፈ ዶሎሀ ባጋን ደእያ ሞአበ ደንባን ደእሸ ሻክድ እምዳ ቢታይ ሀይሳ። <verse eid="JOS 13:32"/><verse number="33" style="v" sid="JOS 13:33"/>ሽን ሙሰይ ሌወ ኮቻስ ላታ ቢታ እምቤና። ጎዳይ፥ እስራኤለ ፆሳይ ኤንታ ላታ።<verse eid="JOS 13:33"/></para>
  <chapter eid="JOS 13"/>
  <chapter number="14" style="c" sid="JOS 14"/>
  <para style="s1">ዮርዳኖሰፐ ዉሎሀ ባጋ ቢታታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 14:1"/>ካህነይ አላዛር፥ ናወ ናአይ እያሱይነ እስራኤለ ሶ አሳ ሀላቃት፥ ካናነ ቢታ ኤንታ ኮቻን ኮቻን ሻክን፥ እስራኤለ አሳ ጋክዳ ቢታይ ሀይሳፈ ካልድ ደኤይሳ። <verse eid="JOS 14:1"/><verse number="2" style="v" sid="JOS 14:2"/>ጎዳይ ሙሰ ኪትዳይሳዳ ላታ ቢታይ ኡዱፉናነ ባጋ ኮቻስ ሳማን ሻከትስ። <verse eid="JOS 14:2"/><verse number="3" style="v" sid="JOS 14:3"/>ሙሰይ ካሰ ናምአነ ባጋ ኮቻስ ዮርዳኖሰፐ ዶሎሀ ባጋን ደእያ ቢታ እምስ፥ ሽን ሌወ ኮቻስ ኤንታ ግዶን ላታ ቢታ እምቤና። <verse eid="JOS 14:3"/><verse number="4" style="v" sid="JOS 14:4"/>ዮሰፋ ናይት ምናሰይነ ኤፍሬመይ ናምኡ ኮቸ ግድዶሶና። ሌወ ኮቻስ ዱሳ ካታማታነ መሄ ሄምያ ቢታ እምስፐ አትሽን፥ ላታ ቢታ እምቤና። <verse eid="JOS 14:4"/><verse number="5" style="v" sid="JOS 14:5"/>ጎዳይ ሙሰ ኪትዳይሳዳ እስራኤለ አሳይ ቢታ ሻከትድ ኤክዶሶና።<verse eid="JOS 14:5"/></para>
  <para style="s1">ከብሮነይ ካለባስ እመትስ</para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 14:6"/>እስ ጋላስ ይሁዳ አሳይ እያሱኮ ጋልጋላ ይዶሶና። ኤንታፈ እሶይ፥ ቀነዛ ኮቻይ፥ ዮፎና ናአይ ካለብ እያሱኮ፥ “ኑኒ ቃደስ-ባርነን ደእያ ዎደ ጎዳይ ናብያ ሙሰ ባጋራ ነባነ ታባ ኦድዳይሳ ኤራሳ። <verse eid="JOS 14:6"/><verse number="7" style="v" sid="JOS 14:7"/>ጎዳ አይለይ ሙሰይ ሀ ቢታ ዎቻና መላ ቃደስ-ባርነፈ ታና ኪትያ ዎደ ታዉ ላይ ኦይታማ። ሄ ዎደ ታኒ አማንያ ኦዳ ሙሰስ ኤሀስ። <verse eid="JOS 14:7"/><verse number="8" style="v" sid="JOS 14:8"/>ታራ ብዳ አሳት አሳ ዎዛና ያሻን ትልእስዶሶና፥ ሽን ታኒ ጎዳ፥ ፆሳ ፖሎ ካላስ። <verse eid="JOS 14:8"/><verse number="9" style="v" sid="JOS 14:9"/>ሄ ጋላስ ሙሰይ፥ ‘ኔን፥ ጎዳ፥ ፆሳ ፖሎ ካልዳ ግሾ፥ ነ ቶሆይ የዳ ቢታይ ነዉነ ነ ኮቻስ መርና ላታ ቢታ ግዳና’ ግድ ታዉ ጫቅስ። <verse eid="JOS 14:9"/><verse number="10" style="v" sid="JOS 14:10"/>እያሱ፥ አነ ቆፓ፤ ጎዳይ ሄሳ ሙሰስ ኦድ ስምን ሀች ኦይታማነ እቻሹ ላይ ግድስ። እስራኤለ አሳይ መላ ቢታን ስመረትያ ዎደ ኡባን ሀች ጋናዉ ጎዳይ ታና ፓፃ ዎስ። ሀእ ታዉ ላይ ሆስፑን ታማነ እቻሻ ግድስ። <verse eid="JOS 14:10"/><verse number="11" style="v" sid="JOS 14:11"/>ታዉ ሄ ዎደ ደእያ ምኖተይ ሀችካ ደኤስ። ኦለታናዉ፥ ከያናዉነ ገላናዉ ታዉ ሀእካ ዎልቅነ ፃላተ ደኤስ። <verse eid="JOS 14:11"/><verse number="12" style="v" sid="JOS 14:12"/>ሄ ዎደ ጎዳይ ታዉ እማና ግድ ጫቅዳ ሄ ደረይ ዳርያ ቢታ ታዉ እማ። ሄ ቢታን አናቀት ደኤይሳነ ኤንታ ካታማት ግታነ ግምበትዳ ካታማ ግደይሳ ሄ ዎደ ነ ስአዳሳ። ግድኮካ ጎዳይ ግዳይሳዳ እ ታራ ግድኮ፥ ኤንታ ሄ ቢታፈ ታኒ ጎዳና” ያግስ።<verse eid="JOS 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 14:13"/>እያሱይ ዮፎና ናአ ካለባ አንጅድ፥ ከብሮና እያዉ ላታ ኦ እምስ። <verse eid="JOS 14:13"/><verse number="14" style="v" sid="JOS 14:14"/>እ ጎዳ፥ እስራኤለ ፆሳ ፖሎ ካልዳ ግሾ፥ ከብሮና ሀች ጋካናዉ ቀነዛ ኮቻ ዮፎና ናኣ ካለባ ኮቻስ ላታ ቢታ ግድስ። <verse eid="JOS 14:14"/><verse number="15" style="v" sid="JOS 14:15"/>ካሰ ከብሮና ሱንይ ቅርያት-አርባ ጌተቴስ። አርብ፥ አናቀታ ግዶን ኤረትዳ ግታ አሰ።</para>
  <para style="p" vid="JOS 14:15">ሄሳፈ ጉየ፥ ቢታይ ኦላፐ ሸምፕስ።<verse eid="JOS 14:15"/></para>
  <chapter eid="JOS 14"/>
  <chapter number="15" style="c" sid="JOS 15"/>
  <para style="s1">ይሁዳ ላታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 15:1"/>ይሁዳ ኮቻስ ኤንታ ኮቻን ኮቻን ሻከትዳ ቢታይ ኤዶመን ዛዋትድ፥ ዱገሀ ባጋን ደእያ ፂነ መላ ቢታ ዉርሰ ጋኬስ። <verse eid="JOS 15:1"/><verse number="2" style="v" sid="JOS 15:2"/>ዱገሀ ባጋን ኤንታ ዛዋይ ማፅነ አባፈ ዱገሀ ባጋን ዉርሰ ጋፃ ጋኬስ። <verse eid="JOS 15:2"/><verse number="3" style="v" sid="JOS 15:3"/>አክራብማ ፕኑዋ ካንድ፥ ፂነፐ ብድ፥ ቃደስ-ባርነስ ዱገሀ ባጋ ጋኬስ። ቃስ ሄፅሮና ካንድ፥ አዳረ ከይድ፥ ቃርቃኮ ስሜስ። <verse eid="JOS 15:3"/><verse number="4" style="v" sid="JOS 15:4"/>ሄሳፈ ቃስ አፅሞና ካንድ፥ ግብፀ ሻፋ ጋክድ፥ መደትራነ አባን ዛዋቴስ። ዱገሀ ባጋን ደእያ ይሁዳ ዛዋይ ሄሳ።<verse eid="JOS 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 15:5"/>ዶሎሀ ባጋ ዛዋይ ማፅነ አባ ብድ፥ ዮርዳኖሰ ሻፋ ዉርሰ ጋኬስ። ፑደሀ ባጋ ዛዋይ ቃስ ዮርዳኖሰ ሻፋይ ገልያሱዋፕ ብድ፥ <verse eid="JOS 15:5"/><verse number="6" style="v" sid="JOS 15:6"/>ቤት-ሆግላ ከዬስ። ያፐ ቤት-አራባ ባጋራ ካንድ፥ ሮቤላ ናኣ ቦሃና ቆፍሶ ሹቻን ዛዋቴስ። <verse eid="JOS 15:6"/><verse number="7" style="v" sid="JOS 15:7"/>ያፐ ዛዋይ አኮራ ዛንጋራፐ ዳብራ ከይድ፥ ዛንጋራፐ ዱገሀ ባጋን ደእያ አዱምማ ፕኑዋ ስን ባጋን አግድ ፑደሀ ባጋራ ጋልጋላ ስሜስ። ሄሳፈ ቃስ ኤንሸመሸ ፑልቱዋ ካንድ፥ ኤንሮጌላን ዛዋቴስ። <verse eid="JOS 15:7"/><verse number="8" style="v" sid="JOS 15:8"/>ሄሳፈ ህኖማ ዛንጋራ ካንድ፥ ያቡሰታ ካታማ ግድዳ የሩሳላመ ዱገሀ ባጋ ጋኬስ። ካልድ ዛዋይ ህኖመ ዛንጋራፐ ዉሎሀ ባጋን ደእያ ዙማ ሁጵያ ከይድ፥ ፑደሀ ባጋን ራፋይመ ዛንጋራ ጋኬስ። <verse eid="JOS 15:8"/><verse number="9" style="v" sid="JOS 15:9"/>ሄ ዙማ ሁጵያፐ ብድ፥ ናፍቶሀ ፑልቱዋ ካንድ፥ ኤፍሮና ዙማ ቦላ ደእያ ካታማታኮ ከዬስ። ሄሳፈ ቃስ ባኣላ ዎይኮ ቅርያት-ይኣርማ ስሜስ። <verse eid="JOS 15:9"/><verse number="10" style="v" sid="JOS 15:10"/>ባላ ፑደሀ ባጋራ ዛዋይድ፥ ሳይረ ዙማኮ ዉሎሀ ባጋ ምርቀትድ፥ ይኣርመ ዎይኮ ክሳሎነ ደርያ ጋክድ፥ እያፐ ዱገ ቤት-ሳሜሳ ዎድ፥ ትምና ፕኔስ። <verse eid="JOS 15:10"/><verse number="11" style="v" sid="JOS 15:11"/>ሄ ዛዋይ ኤቅሮና ፑደሀ ባጋራ ካንድ፥ ሽክሮና ምርቀትድ፥ ባላ ዙማራ ብድ፥ ያብንኤላን ዛዋቴስ። ሄ ዛዋ ዉርሰይ መደትራነ አባ ግድድ፥ <verse eid="JOS 15:11"/><verse number="12" style="v" sid="JOS 15:12"/>ዉሎሀ ባጋ ዛዋይ መደትራነ አባስ ጋፃ ግዴስ። ይሁዳ ኮቻይ ደእዳ ቢታ ዛዋይ ሀይሳ።<verse eid="JOS 15:12"/></para>
  <para style="s1">ካለባ ቢታ</para>
  <para style="r">(<ref loc="JDG 1:11-15">አይሰ 1:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 15:13"/>ጎዳይ ኪትዳይሳዳ፥ እያሱይ፥ ዮፎና ናኣ ካለባ ጋክያ ላታ ይሁዳ ቢታፈ ቅርያት-አርባ ጌተትያ ከብሮና እምስ። አርብ አናቀ አዋ። <verse eid="JOS 15:13"/><verse number="14" style="v" sid="JOS 15:14"/>ካለብ አናቀ ኮቻታ፥ ሰሳያ፥ አክማናነ ታልማያ ጌተትያ ሄታ ከብሮናፐ ከስስ። <verse eid="JOS 15:14"/><verse number="15" style="v" sid="JOS 15:15"/>ሄሳፈ ደንድድ፥ ዳብራን ደእያ አሳ ኦላናዉ ብስ። ዳብራ ካታማይ ካሰ ቅርያት-ሰፈራ ጌተቴስ። <verse eid="JOS 15:15"/><verse number="16" style="v" sid="JOS 15:16"/>ካለብ፥ “ቅርያት-ሰፈራ ኦልድ፥ ኦይክያ አድያስ ታኒ፥ ታ ናእዉ አክሶ እማና” ያግስ። <verse eid="JOS 15:16"/><verse number="17" style="v" sid="JOS 15:17"/>ያትን፥ ካለባ እሻ ቃናዛ ናአይ፥ ጎቶንያል ሄ ካታማ ኦልድ ኦይክን፥ ካለብ ባ ናእዉ አክሶ እያዉ እምስ።<verse eid="JOS 15:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 15:18"/>አክሳ ጎቶንያላ ገልያ ዎደ እ አዋይ እዉ ጋደ እማናዳ ዎሳና መላ ጎቶንያል እዮ ዞርስ። እያ ባቁሎ ቦላፈ ዎን፥ ካለብ እዮ፥ “አይ ኮያይ?” ያግድ ኦይችስ።<verse eid="JOS 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 15:19"/>እያ ዛራዳ፥ “ነ ካሰ ታዉ ዎይትዳ ቢታይ መላ ቢታ ግድያ ግሾ፥ ሃ ፑልቶይ ደእያ ቢታ ታዉ ጉጃዳ እማርክ” ያጋሱ። ያትን፥ ካለብ ቆሞንነ ጋርሳን ደእያ ፑልቶ ሃ እዉ እምስ።<verse eid="JOS 15:19"/></para>
  <para style="s1">ይሁዳ ካታማታ</para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 15:20"/>ይሁዳ ኮቻት ባንታ ኮቻን ኮቻን ኤክዳ ላታይ ሀይሳፈ ካልድ ፃፈትዳይሳ። <verse eid="JOS 15:20"/><verse number="21" style="v" sid="JOS 15:21"/>ዱገሀ ባጋን ኤዶመ ጋፃን ደእያ ይሁዳ ካታማት፥ ቃብዱኤላ፥ ኤደራ፥ ያጉራ፥ <verse eid="JOS 15:21"/><verse number="22" style="v" sid="JOS 15:22"/>ቂና፥ ድሞና፥ አዳዳ፥ <verse eid="JOS 15:22"/><verse number="23" style="v" sid="JOS 15:23"/>ቃደሳ፥ ሀፆራ፥ ይትናና፥ <verse eid="JOS 15:23"/><verse number="24" style="v" sid="JOS 15:24"/>ዚፋ፥ ፀለማ፥ ባሎታ፥ <verse eid="JOS 15:24"/><verse number="25" style="v" sid="JOS 15:25"/>ሀፆር-ሀዳታ፥ ቅርዮት-ሄፅሮና ዎይኮ ሀፆራ፥ <verse eid="JOS 15:25"/><verse number="26" style="v" sid="JOS 15:26"/>አማማ፥ ሻማአ፥ ሞሎዳ፥ <verse eid="JOS 15:26"/><verse number="27" style="v" sid="JOS 15:27"/>ሀፃር-ጋዳ፥ ሄሽሞና፥ ቤት-ፓለፃ፥ <verse eid="JOS 15:27"/><verse number="28" style="v" sid="JOS 15:28"/>ሀፃር-ሹኣላ፥ በርሳበህ፥ ብዝዮታ፥ <verse eid="JOS 15:28"/><verse number="29" style="v" sid="JOS 15:29"/>ባኣላ፥ እዩማ፥ ኤፀማ፥ <verse eid="JOS 15:29"/><verse number="30" style="v" sid="JOS 15:30"/>ኤልቶላዳ፥ ከስላ፥ ሆርማ፥ <verse eid="JOS 15:30"/><verse number="31" style="v" sid="JOS 15:31"/>ፅቅላጋ፥ ማድማና፥ ሳንሳና፥ <verse eid="JOS 15:31"/><verse number="32" style="v" sid="JOS 15:32"/>ለባዎታ፥ ሽልሃማ፥ አይናነ እርሞና። ሀ ካታማት ባንታ ጉታታራ እስፈ ላታማነ ኡዱፉና።<verse eid="JOS 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 15:33"/>ዉሎሀ ባጋን ዙማ ፃጶን ደእያ ካታማት፥ ኤሽታኦላ፥ ፆርአ፥ አሽና፥ <verse eid="JOS 15:33"/><verse number="34" style="v" sid="JOS 15:34"/>ዛኖሀ፥ ኤንጋንማ፥ ታፑሀ፥ ኤናማ፥ <verse eid="JOS 15:34"/><verse number="35" style="v" sid="JOS 15:35"/>ያርሙታ፥ አዱላማ፥ ሶኮ፥ አዜቃ፥ <verse eid="JOS 15:35"/><verse number="36" style="v" sid="JOS 15:36"/>ሻእራይማ፥ አድታይማ፥ ገደራነ ገደሮታይማ። ሀ ካታማት ባንታ ጉታታራ እስፈ ታማነ ኦይዳ።<verse eid="JOS 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JOS 15:37"/>ቃስ ሀራ ካታማት፥ ፅናና፥ ሀዳሻ፥ ምግዳል-ጋዳ፥ <verse eid="JOS 15:37"/><verse number="38" style="v" sid="JOS 15:38"/>ድልአና፥ ምፅጳ፥ ዮቅትኤላ፥ <verse eid="JOS 15:38"/><verse number="39" style="v" sid="JOS 15:39"/>ላክሶ፥ ቦፅቃታ፥ ኤግሎና፥ <verse eid="JOS 15:39"/><verse number="40" style="v" sid="JOS 15:40"/>ካቦና፥ ላህማሳ፥ ክትሊሻ፥ <verse eid="JOS 15:40"/><verse number="41" style="v" sid="JOS 15:41"/>ገደሮታ፥ ቤት-ዳጎና፥ ናእማናነ ማቀዳ። ሀ ካታማት ባንታ ጉታታራ እስፈ ታማነ ኡሱፑና።<verse eid="JOS 15:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JOS 15:42"/>ቃስ ልብና፥ ኤተራ፥ አሸና፥ <verse eid="JOS 15:42"/><verse number="43" style="v" sid="JOS 15:43"/>ይፍታሄ፥ አሽና፥ ነፅባ፥ <verse eid="JOS 15:43"/><verse number="44" style="v" sid="JOS 15:44"/>ቃእላ፥ አክዚባነ ማሬሳ። ሀ ካታማት ባንታ ጉታታራ እስፈ ኡዱፉና።<verse eid="JOS 15:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JOS 15:45"/>ሄሳዳካ፥ ኤቅሮና ካታማይ ባ ጉታራ ያን ደኤስ። <verse eid="JOS 15:45"/><verse number="46" style="v" sid="JOS 15:46"/>ኤቅሮናፐ ዉሎሀ ባጋን አሽዶዳ ካታማይነ እያ ጉታት ደኦሶና።<verse eid="JOS 15:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JOS 15:47"/>ቃስ አሽዶዳነ ጋዛ ካታማት ባንታ ጉታታራ ብድ፥ ግብፀ ሻፋ ዛዋነ መደትራነ አባ ላንቅያ ጋካናዉ ደኦሶና።<verse eid="JOS 15:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JOS 15:48"/>ደረይ ዳርያ ካታማት፥ ሳምራ፥ ያትራ፥ ሶኮ፥ <verse eid="JOS 15:48"/><verse number="49" style="v" sid="JOS 15:49"/>ዳነ፥ ቅርያት-ሰፈራ ዎይኮ ዳብራ፥ <verse eid="JOS 15:49"/><verse number="50" style="v" sid="JOS 15:50"/>አናባ፥ ኤሽታሞአ፥ አንማ፥ <verse eid="JOS 15:50"/><verse number="51" style="v" sid="JOS 15:51"/>ጎሸና፥ ሆሎናነ ግሎ። ሀ ካታማት ባንታ ጉታታራ እስፈ ታማነ እስኖ።<verse eid="JOS 15:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JOS 15:52"/>ቃስ አራባ፥ ዱማ፥ ኤሽአና፥ <verse eid="JOS 15:52"/><verse number="53" style="v" sid="JOS 15:53"/>ያንማ፥ ቤት-ታፑሀ፥ አፌቃ፥ <verse eid="JOS 15:53"/><verse number="54" style="v" sid="JOS 15:54"/>ሁምፃ፥ ከብሮና ዎይኮ ቅርያት-አርባነ ፅኦራ። ሀ ካታማት ባንታ ጉታታራ እስፈ ኡዱፉና።<verse eid="JOS 15:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JOS 15:55"/>ቃስ ማኦና፥ ቃርመሎሳ፥ ዚፋ፥ ዩፃ፥ <verse eid="JOS 15:55"/><verse number="56" style="v" sid="JOS 15:56"/>እዝራኤለ፥ ዮቅድኣማ፥ ዛኖሀ፥ <verse eid="JOS 15:56"/><verse number="57" style="v" sid="JOS 15:57"/>ቃይና፥ ግብአነ ትምና። ሀ ካታማት ባንታ ጉታታራ እስፈ ታማ።<verse eid="JOS 15:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JOS 15:58"/>ሄሳዳካ ሀልሁላ፥ ቤት-ፁራ፥ ጋዶራ፥ <verse eid="JOS 15:58"/><verse number="59" style="v" sid="JOS 15:59"/>ማእራታ፥ ቤት-አኖታነ ኤልትቆና። ሀ ካታማት ባንታ ጉታታራ እስፈ ኡሱፑና።<verse eid="JOS 15:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="JOS 15:60"/>ቃስ ቅርያት-ባኣለ ዎይኮ ቅርያት-ይኣርማነ ራባ። ሀ ካታማት ባንታ ጉታታራ እስፈ ናምአ።<verse eid="JOS 15:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JOS 15:61"/>መላ ቢታን ቃስ ቤት-አራባ፥ ምድና፥ ሰካካ፥ <verse eid="JOS 15:61"/><verse number="62" style="v" sid="JOS 15:62"/>ንብሻና፥ ማፅነ ካታማነ ኤንጋደ። ሀ ካታማት ባንታ ጉታታራ እስፈ ኡሱፑና።<verse eid="JOS 15:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="JOS 15:63"/>ግዶሽን፥ ይሁዳ አሳይ የሩሳላመን ደእያ ያቡሰታ ጎድድ ከሳናዉ ዳንዳእቦኮና። ሄሳ ግሾ፥ ያቡሰት ሀች ጋካናዉ የሩሳላመን ይሁዳ አሳራ እስፈ ደኦሶና።<verse eid="JOS 15:63"/></para>
  <chapter eid="JOS 15"/>
  <chapter number="16" style="c" sid="JOS 16"/>
  <para style="s1">ኤፍሬማነ ምናሰ ላታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 16:1"/>ዮሰፋ ኮቻታ ጋክዳ ላታ ቢታይ ዱገሀ ባጋራ እያርኮ ማታን ደእያ ዮርዳኖሰን ዶሜስ። እያርኮ ፑልቱዋስ ዉሎሀ ባጋ ጋፃፐ ብድ፥ መላ ቢታ ካንድ፥ ደረይ ዳርያ ቢታ ኤክድ፥ ቤተለ ጋኬስ። <verse eid="JOS 16:1"/><verse number="2" style="v" sid="JOS 16:2"/>ቤተለፐ ብድ፥ አርከት ደእያ አፃሮት-አዳረ ካንድ፥ ሎዛ ጋኬስ። <verse eid="JOS 16:2"/><verse number="3" style="v" sid="JOS 16:3"/>ሄሳፈ ዉሎሀ ባጋን ደእያ ያፍሌፃታ ቢታ ዱገ ዎድ፥ ጋርሳ ቤት-ሆሮና ጋክድ፥ ያፐ ገዘራ ካንድ፥ መደትራነ አባን ዛዋቴስ።<verse eid="JOS 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 16:4"/>ዮሰፋ ኮቻት፥ ምናሰነ ኤፍሬማ ኮቻት፥ ባንታና ጋክያ ቢታ ላትዶሶና።<verse eid="JOS 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 16:5"/>ኤፍሬማ ኮቻ ኤንታ ኮቻን ኮቻን ጋክዳ ቢታይ ሀይሳ፤ ኤንታ ዛዋይ ዶሎሀ ባጋራ ደእያ አፃሮት-አዳረፐ ብድ፥ ቆሞ ባጋ ቤት-ሆሮና ከዬስ። <verse eid="JOS 16:5"/><verse number="6" style="v" sid="JOS 16:6"/>ያፐ ካንድ መደትራነ አባን ዛዋቴስ። ቃስ ፑደሀ ባጋራ ደእያ ዛዋይ ምክማታታ። ያፐ ዶሎሀ ባጋራ ደእያ ታናት-ሴሎኮ ምርቀትድ፥ ያኖሀ ጋኬስ። <verse eid="JOS 16:6"/><verse number="7" style="v" sid="JOS 16:7"/>ያኖሃፐ ደንድድ፥ አፃሮተነ ናአራተ ዎድ፥ እያርኮ ጋክድ፥ ዉርሰይ ዮርዳኖሰ ሻፋን ኤቄስ። <verse eid="JOS 16:7"/><verse number="8" style="v" sid="JOS 16:8"/>ጋፃ ዛዋይ ታፑሀፐ ብድ፥ ዉሎሀ ባጋራ ደእያ ቃና ሻፋ ላንቅያ ኦይክድ፥ መደትራነ አባን ኤቄስ። ኤፍሬማ ኮቻይ ባንታ ኮቻን ኮቻን ላትዳ ቢታይ ሀይሳ። <verse eid="JOS 16:8"/><verse number="9" style="v" sid="JOS 16:9"/>ሄስ ምናሰ ኮቻ ላታ ግዶን ኤፍሬማ ኮቻስ እመትዳ ካታማታነ ኤንታ ጉታታ ኡባ ጉጄስ። <verse eid="JOS 16:9"/><verse number="10" style="v" sid="JOS 16:10"/>ግዶሽን፥ ኤፍሬማ ኮቻይ ገዘራን ደእያ ካናነታ ጎድድ ከስቦኮና። ሄሳ ግሾ፥ ካናነት ሀች ጋካናዉ ኤፍሬማ ኮቻ ግዶን ደኦሶና። ሽን ኤፍሬማ ኮቻስ አይለትድ ኦሶና።<verse eid="JOS 16:10"/></para>
  <chapter eid="JOS 16"/>
  <chapter number="17" style="c" sid="JOS 17"/>
  <para style="p">
    <verse number="1" style="v" sid="JOS 17:1"/>ዮሰፋ ባይራ ናኣ ምናሰ ኮቻስ እመትዳ ላታ ቢታይ ካልድ ደኤይሳ፤ ጋላዳ አዋይ ማክር ምናሰ ባይራ ናአ። ማክር ምኖ ኦላንቾ ግድዳ ግሾ፥ ጋላዳነ ባሳነ ቢታ ኤክዶሶና። <verse eid="JOS 17:1"/><verse number="2" style="v" sid="JOS 17:2"/>ዮርዳኖሰ ሻፋፐ ዉሎሀ ባጋራ ደእያ ቢታይ ሀንኮ አትዳ ምናሰ ኮቻስ፥ አብኤዘራስ፥ ሄለቃስ፥ አስርኤላስ፥ ሴከማስ፥ ሄፌራስነ ሻምዳአስ እመትስ። ሀይሳቲ ዮሰፋ ናኣ ምናሰ ኮቻታ።<verse eid="JOS 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 17:3"/>ሄፌራ ናኣ ሰሎጳዳ፥ ጋላዳ ናኣ ሄፌራ፥ ማክራ ናኣ ጋላዳ፥ ምናሰ ናኣ ማክራ። ሰሎጳዳስ ማጫ ናአፐ አትሽን፥ አደ ናእ ባዋ። ሄ ማጫ ናይታ ሱንይ ማህሎ፥ ኖኦ፥ ሆግሎ፥ ምልኮነ ትርፆ። <verse eid="JOS 17:3"/><verse number="4" style="v" sid="JOS 17:4"/>ኤንቲ ካህንያ አላዛራኮ፥ ናወ ናኣ እያሱኮነ ደርያ ጭማታኮ ብድ፥ “ኑ ዳቦታዳ ኑስካ ላታ ቢታ እማና መላ ጎዳይ ሙሰ ኪትስ” ያግዶሶና። ያትን፥ ጎዳይ ኪትዳይሳዳ ኤንታ ዳቦታዳ ኤንታዉካ ላታ ቢታ እምስ። <verse eid="JOS 17:4"/><verse number="5" style="v" sid="JOS 17:5"/>ምናሰ ኮቻት ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋን ደእያ ጋላዳነ ባሳነ ቦላ ጉጅድ ታሙ ቢታታ ሳማን ኤክዶሶና። <verse eid="JOS 17:5"/><verse number="6" style="v" sid="JOS 17:6"/>ሄሳ ግሾ፥ ምናሰ ኮቻፈ ማጫ ናይት አደ ናይታራ እስፈ ላታ ቢታ ሻከትዶሶና። ጋላዳ ቢታይ አትዳ ምናሰ ኮቻስ ግድስ።<verse eid="JOS 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 17:7"/>ምናሰ ኮቻ ቢታ ዛዋይ አሴራፐ ብድ፥ ሴከማፐ ዶሎሀ ባጋን ደእያ ምክማታታ ጋኬስ። ሄ ዛዋይ ያፐ ካንድ፥ ዱገሀ ባጋን አንታፑሀን ደእያ ደርያ ጉጄስ። <verse eid="JOS 17:7"/><verse number="8" style="v" sid="JOS 17:8"/>ታፑሀ ቢታይ ምናሰ ኮቻሳ፥ ሽን ምናሰ ዛዋን ደእያ ታፑሀ ካታማይ ኤፍሬማ ኮቻሳ። <verse eid="JOS 17:8"/><verse number="9" style="v" sid="JOS 17:9"/>ቃስ ሄ ዛዋይ ያፐ ብድ፥ ቃና ሻፋን ዛዋቴስ። ምናሰ ካታማታ ግዶን ኤፍሬማ ካታማትካ ደኦሶና። ሽን ምናሰ ዛዋይ ቃና ሻፋፐ ፑደሀ ባጋራ ብድ መደትራነ አባን ኤቄስ። <verse eid="JOS 17:9"/><verse number="10" style="v" sid="JOS 17:10"/>ሻፋፐ ዱገሀ ባጋን ደእያ ቢታይ ኤፍሬማሳ፤ ቃስ ፑደሀ ባጋን ደእያ ቢታይ ምናሰሳ። ምናሰ ቢታ ዛዋይ መደትራነ አባ ጋኬስ። እያዉ ፑደሀ ባጋራ አሴር፥ ቃስ ዶሎሀ ባጋራ ይሳኮር ዛዋቴስ። <verse eid="JOS 17:10"/><verse number="11" style="v" sid="JOS 17:11"/>ይሳኮራነ አሴራ ቢታታ ግዶን፥ ቤት-ሳና፥ ይብላማ፥ ዶራ፥ ኤንዶራ፥ ታናካነ ማግዶ ጌተትያ ካታማትነ ጉታት ምናሰሳ። <verse eid="JOS 17:11"/><verse number="12" style="v" sid="JOS 17:12"/>ሽን ምናሰ ኮቻት ሄ ካታማታን ደእያ አሳታ ከስድ ካታማታ ኦይካናዉ ዳንዳእቦኮና። ሄሳ ግሾ፥ ካናነት ያን ዱስ ኦይክዶሶና። <verse eid="JOS 17:12"/><verse number="13" style="v" sid="JOS 17:13"/>እስራኤለ አሳይ ዎልቃን ምንኮካ፥ ካናነት ዎልቃ ኦሶ ኦና መላ ኡንኤዶሶናፐ አትሽን፥ ኤንታ ኩመ ጎድድ ከስቦኮና።<verse eid="JOS 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 17:14"/>ዮሰፋ ኮቻይ፥ “ጎዳይ ኑና አንጅድ፥ ዳርስስ፤ ያትን፥ አይስ እስ ሳማ ፃላላ ላታ ቢታ ኑስ እማዲ?” ያግድ እያሱ ኦይችዶሶና።<verse eid="JOS 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 17:15"/>እያሱይ ዛሪድ፥ “ህንተ ዳሮ ግድኮ፥ ደረይ ዳርያ ኤፍሬማ ቢታይ ህንተዉ ጉፅዳባ ግድኮ፥ ፓርዘትነ ራፋይመት ደእያ ቢታ ብድ ዎራ ቄፅተ” ያግስ።<verse eid="JOS 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 17:16"/>ዮሰፋ ኮቻይ፥ “ሄ ደረይ ዳርያ ቢታይካ ኑስ ግደና። ቃስ ቤት-ሳና ካታማንነ እያ ጉታን ደኤይሳታስነ እዝራኤለ ዛንጋራን ደእያ ካናነታስ ብራታ ፓራ ጋረት ደኦሶና” ያግዶሶና።<verse eid="JOS 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 17:17"/>ያትን እያሱይ ዮሰፋ ኮቸ ግድዳ ኤፍሬማነ ምናሰ፥ “ህንተ ዳሮነ ዎልቃማ፤ ህንተዉ እስ ሳማ ፃላላ ግዳናዉ በሰና። <verse eid="JOS 17:17"/><verse number="18" style="v" sid="JOS 17:18"/>ሄሳ ግሾ፥ ደረይ ዳርያ ቢታይ ህንተባ ግዳና። ሄ ገዘይ ዎራ ግድኮካ ቄፅድ፥ ጋፃ ጋካናዉ ህንተባ ኦተ። ካናነታስ ብራታ ፓራ ጋረት ደእኮካ፥ ቃስ ኤንቲ አይ ምኖ ግድኮካ ህንተ ኤንታ ጎድድ ከሳናዉ ዳንዳኤታ” ያግስ።<verse eid="JOS 17:18"/></para>
  <chapter eid="JOS 17"/>
  <chapter number="18" style="c" sid="JOS 18"/>
  <para style="s1">አትዳ ቢታ ሻሆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 18:1"/>ቢታ ኦል ፆንድ ኦይክዳፐ ጉየ፥ እስራኤለ አሳ ኡባይ ሴሎን ሺቅድ፥ ጎዳ ጎይኖ ዱንካንያ ያን ኤስዶሶና። <verse eid="JOS 18:1"/><verse number="2" style="v" sid="JOS 18:2"/>ሽን እስራኤለ አሳፐ ላታ ቢታ ኤክቦና ላፑን ኮቻት አትዶሶና።<verse eid="JOS 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 18:3"/>ሄሳ ግሾ፥ እያሱይ እስራኤለ አሳኮ፥ “ጎዳይ ህንተ አዋታ ፆሳይ ህንተዉ እምዳ ቢታ ላቶና አዉደ ጋካናዉ ጋምአኔ? <verse eid="JOS 18:3"/><verse number="4" style="v" sid="JOS 18:4"/>እስ እስ ኮቻፈ ሄ ሄ አሳታ ዶርተ። እስ እስ ኮቻይ ላታና ቢታ ኤንቲ ዩይድ፥ ፆሞስ በእድ፥ ማዝጋብድ ያና መላ ታ ኤንታ ኪታና። ኤንቲ ሄ ቢታባ ፃፍ ኤክድ፥ ስሚድ ታኮ ያና። <verse eid="JOS 18:4"/><verse number="5" style="v" sid="JOS 18:5"/>ሄ ቢታ ላፑን በሳን ሻካና። ይሁዳ ኮቻይ ዱገሀ ባጋን፥ ዮሰፋ ኮቻይ ፑደሀ ባጋን ደእያ ባንታ ቢታ ኦይክዳ መላ ዳና። <verse eid="JOS 18:5"/><verse number="6" style="v" sid="JOS 18:6"/>ሀ ላፑን በሳን ሻከታና ቢታ ቆንጭስ ፃፍድ ኤክ ዪተ። ጎዳ፥ ኑ ፆሳ ስንን ኤንታዉ ሳማ የጋና። <verse eid="JOS 18:6"/><verse number="7" style="v" sid="JOS 18:7"/>ግዶሽን፥ ሌወ ኮቻት ካህነ ግድድ፥ ጎዳስ ኦያ ግሾ፥ ህንተራ ላታ ቢታ ኤኮኮና። ጋዳ ኮቻይ፥ ሮቤላ ኮቻይነ፥ ምናሰ ኮቻፈ ባጋይ ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋን፥ ጎዳ አይለይ፥ ሙሰይ ኤንታዉ እምዳ ቢታ ኮይሮትድ ላትዶሶና” ያግስ።<verse eid="JOS 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 18:8"/>ሄ አሳት ቢታ ፆሞስድ፥ ፃፋናዉ ባናፐ ስን፥ እያሱይ፥ “ብድ ቢታ ዩይድ ፆሞስድ ፃፍተ፤ ስሚድ ታኮ ዪተ። ታኒ ሀይሳን፥ ሴሎን፥ ጎዳ ስንን ህንተዉ ሳማ የጋና” ያግድ ኪትስ። <verse eid="JOS 18:8"/><verse number="9" style="v" sid="JOS 18:9"/>አሳት ብድ፥ ቢታ ኡባ ዩይዶሶና። ካታማታ ኡባ ፃፍድ፥ ቢታ ዋት ላፑን በሳን ሻካነኮ ቆንጭስዶሶና። ያት ስሚድ፥ እያሱይ ዱንካንዳ ጉታ፥ ሴሎ ስምዶሶና። <verse eid="JOS 18:9"/><verse number="10" style="v" sid="JOS 18:10"/>እያሱይ ጎዳ ስንን፥ ሴሎን ኤንታዉ ሳማ የግስ። አትዳ እስራኤለ ዘረታ ጋክያ ላታ ቢታ ሻክድ እምስ።<verse eid="JOS 18:10"/></para>
  <para style="s1">ብንያመ ላታ</para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 18:11"/>ኮይሮ ሳማይ ብንያመ ኮቻ ኤንታ ኮቻን ኮቻን ጋክስ። ኤንታ ጋክዳ ቢታይ ይሁዳፐነ ዮሰፋ ኮቻፈ ግዶን ደኤስ። <verse eid="JOS 18:11"/><verse number="12" style="v" sid="JOS 18:12"/>ፑደሀ ባጋራ ኤንታ ዛዋይ ዮርዳኖሰፐ ደንድድ፥ እያርኮ ፑደ ከይድ፥ ዉሎሀ ባጋን ደእያ ደረይ ዳርያ ቢታ ካንድ፥ ቤት-አዌና መላ ቢታን ኤቄስ። <verse eid="JOS 18:12"/><verse number="13" style="v" sid="JOS 18:13"/>ሄ ዛዋይ ዱገሀ ባጋራ ካሰ ሎዛ ጌተትድ ፄገትያ ቤተለ ካንድ፥ ዱገሀ አፃሮት-አዳረ ዎድ፥ ቤት-ሆሮናፐ ዱገሀ ባጋን ደእያ ዙማን ዛዋቴስ። <verse eid="JOS 18:13"/><verse number="14" style="v" sid="JOS 18:14"/>ሄ ዛዋይ ዱገሀ ባጋራ ቤት-ሆሮና ስንን ደእያ ዙማፐ ዉሎሀ ባጋ ፃፀትድ፥ ይሁዳ ኮቻ ካታማ ግድዳ፥ ቅርያት-ባኣለ ዎይኮ ቅርያት-ይኣርማ አስ። ሄስ ዉሎሀ ባጋራ ደእያ ዛዋ። <verse eid="JOS 18:14"/><verse number="15" style="v" sid="JOS 18:15"/>ዱገሀ ባጋ ዛዋይ ዉሎሀ ባጋራ ቅርያት-ይኣርመፐ ደንድድ፥ ናፍቶሀ ፑልቶታን ዛዋቴስ። <verse eid="JOS 18:15"/><verse number="16" style="v" sid="JOS 18:16"/>ሄሳፈ ሄ ዛዋይ ዱገ ብድ ራፋይመ ዛንጋራፐ ፑደሀ ባጋን ደእያ ሄኖማ ዛንጋራፐ ስን ባጋራ ዱገ ዎስ። ያፐ ያቡሰታ ካታማፐ ዱገሀ ባጋን ደእያ ላንቅያ ኦይክድ፥ ህኖመ ዛንጋራ ዎድ፥ ኤንሮጌላን ዛዋቴስ። <verse eid="JOS 18:16"/><verse number="17" style="v" sid="JOS 18:17"/>ያፐ ፑደሀ ባጋ ምርቀትድ ኤንሸመሸ ባጋራ አዱምማ ዙማ ስንን ደእያ ገልሎታ ጋኬስ። ያፐ ቃስ ሮቤላ ናኣ ቦሃና ሹቻኮ ዱገ ዎስ። <verse eid="JOS 18:17"/><verse number="18" style="v" sid="JOS 18:18"/>ቃስ ቤት-አራባ ፑደሀ ባጋ ላንቅያ ኦይክድ፥ ዱገ ዮርዳኖሰ ዛንጋራ ዎስ። <verse eid="JOS 18:18"/><verse number="19" style="v" sid="JOS 18:19"/>ሄሳፈ ቤት-ሆግላ ፑደሀ ላንቅያ ካን ብድ፥ ዮርዳኖሰ ሻፋይ ጎግድ ገልያ ማፅነ አባፈ ፑደሀ ባጋ ጋፃ ጋኬስ። ሀይስ ዱገሀ ባጋ ዛዋ። <verse eid="JOS 18:19"/><verse number="20" style="v" sid="JOS 18:20"/>ዶሎሀ ባጋ ዛዋይ ዮርዳኖሰ ሻፋ። ብንያመ ኮቻት ላትዳ ቢታይ ኡባ ባጋራ ዛዋትዳ ዛዋይ ሀይሳ።<verse eid="JOS 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 18:21"/>ብንያመ ኮቻይ ባንታ ኮቻን ኮቻ ላትዳ ካታማት፥ እያርኮ፥ ቤት-ሆግላ፥ ኤመቅ-ቃፅፃ፥ <verse eid="JOS 18:21"/><verse number="22" style="v" sid="JOS 18:22"/>ቤት-አራባ፥ ዛማራይመ፥ ቤተለ፥ <verse eid="JOS 18:22"/><verse number="23" style="v" sid="JOS 18:23"/>አዊመ፥ ፓራ፥ ኦፍራ፥ <verse eid="JOS 18:23"/><verse number="24" style="v" sid="JOS 18:24"/>ከፋር-አሞና፥ ኦፍናነ ግብአ። ኤንቲ ኩመ ታማነ ናምኡ ካታማ። ኤንታ ዩሹዋን ደእያ ጉታትካ ኤንታ ቦላ ጉዠቶሶና። <verse eid="JOS 18:24"/><verse number="25" style="v" sid="JOS 18:25"/>ቃስ ጋባኦና፥ ራማ፥ በኤሮታ፥ <verse eid="JOS 18:25"/><verse number="26" style="v" sid="JOS 18:26"/>ምፅጳ፥ ከፍራ፥ ሞፃ፥ <verse eid="JOS 18:26"/><verse number="27" style="v" sid="JOS 18:27"/>ረቄማ፥ ይርጳኤላ፥ ታራላ፥ <verse eid="JOS 18:27"/><verse number="28" style="v" sid="JOS 18:28"/>ፀላአ፥ ኤለፋ፥ የሩሳላመ ጌተትያ ያቡሰታ ካታማ፥ ግብአነ ቅርያት-ይኣርማ። ኤንቲ ኩመ ታማነ ኦይዱ ካታማ። ኤንታ ዩሹዋን ደእያ ጉታትካ ኤንታ ቦላ ጉዠቶሶና። ብንያመ ኮቻይ ባንታ ኮቻን ላትዳ ቢታይ ሀይሳ።<verse eid="JOS 18:28"/></para>
  <chapter eid="JOS 18"/>
  <chapter number="19" style="c" sid="JOS 19"/>
  <para style="s1">ስሞና ላታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 19:1"/>ናምአን ሳማይ ስሞና ኮቻ ኤንታ ኮቻን ኮቻን ጋክስ። ኤንቲ ላትዳ ቢታይ ይሁዳ ኮቻት ላትዳ ቢታ ግዶን ደኤስ። <verse eid="JOS 19:1"/><verse number="2" style="v" sid="JOS 19:2"/>ኤንቲ ላትዳ ካታማት፥ በርሳበ ዎይኮ ሴባ፥ ሞላዳ፥ <verse eid="JOS 19:2"/><verse number="3" style="v" sid="JOS 19:3"/>ሀፃር-ሹኣላ፥ ባላ፥ ኤፀማ፥ <verse eid="JOS 19:3"/><verse number="4" style="v" sid="JOS 19:4"/>ኤልቶላዳ፥ ባቱላ፥ ሆርማ፥ <verse eid="JOS 19:4"/><verse number="5" style="v" sid="JOS 19:5"/>ፅቅላጋ፥ ቤት-ማርካቦታ፥ ሀፃር-ሱሳ፥ <verse eid="JOS 19:5"/><verse number="6" style="v" sid="JOS 19:6"/>ቤት-ላባኦታነ ሻሩሀ። ኤንቲ ኩመ ታማነ ሄ ካታማ። ኤንታ ዩሹዋን ደእያ ጉታት ኤንታ ቦላ ጉዠቶሶና። <verse eid="JOS 19:6"/><verse number="7" style="v" sid="JOS 19:7"/>ቃስ ሀራ በሳን አይና፥ እርሞና፥ ኤተራነ አሻና ጌተትያ ኦይዱ ካታማታነ ኤንታ ዩሹዋን ደእያ ጉታታ ኦይክዶሶና። <verse eid="JOS 19:7"/><verse number="8" style="v" sid="JOS 19:8"/>ስሞና ቢታይ ዱገሀ ባጋን ደእያ ባእላት-ባኤራ ዎይኮ ራማ ካታማታነ ኤንታ ዩሹዋን ደእያ ጉታታ ኡባ ጋኬስ። ስሞና ኮቻይ ባንታ ኮቻን ኮቻን ላትዳ ቢታይ ሀይሳ። <verse eid="JOS 19:8"/><verse number="9" style="v" sid="JOS 19:9"/>ይሁዳ ኮቻታ ጋክዳ ቢታይ ዳልጋ ግድዳ ግሾ፥ እያፐ ሻከትድ፥ ስሞና ኮቻታስ እመትስ።<verse eid="JOS 19:9"/></para>
  <para style="s1">ዛብሎና ላታ</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 19:10"/>ሄን ሳማይ ዛብሎና ኮቻ ኤንታ ኮቻን ኮቻን ጋክስ። ኤንቲ ላትዳ ቢታይ ሳርዳ ጋኬስ። <verse eid="JOS 19:10"/><verse number="11" style="v" sid="JOS 19:11"/>ያፐ ደንድድ ዛዋይ ዉሎሀ ባጋን ደእያ ማርአላ ካንድ፥ ዳባሼታ ቦችሸ፥ ዮቅናማ ማታን ደእያ ሃ ጋኬስ። <verse eid="JOS 19:11"/><verse number="12" style="v" sid="JOS 19:12"/>ሳርዳፐ ዶሎሀ ባጋ ምርቀትድ፥ ክስሎት-ታቦራ ካንድ ዳብራታንነ ያፋን ዛዋቴስ። <verse eid="JOS 19:12"/><verse number="13" style="v" sid="JOS 19:13"/>ያፐ ዉሎሀ ባጋራ ካንድ፥ ጋት-ሄፌራነ እት-ቃፅናና ጋክድ፥ እርሞናኮነ ነአኮ ምርቀቴስ። <verse eid="JOS 19:13"/><verse number="14" style="v" sid="JOS 19:14"/>ፑደሀ ባጋ ዛዋይ ሀናቶነ ዩይድ፥ ይፍታሄ ዛንጋራን ዛዋቴስ። <verse eid="JOS 19:14"/><verse number="15" style="v" sid="JOS 19:15"/>ሄ ዛዋይ ቃፃታ፥ ናህላላ፥ ሽምሮና፥ ይዳላነ ቤተለመ ጌተትያ ካታማታ ኦይኬስ። ኤንቲ ኩመ ታማነ ናምኡ ካታማ፤ ኤንታ ዩሹዋን ደእያ ጉታት ኤንታ ቦላ ጉዠቶሶና። <verse eid="JOS 19:15"/><verse number="16" style="v" sid="JOS 19:16"/>ዛብሎና ኮቻት ባንታ ኮቻን ኮቻን ላትዳ ካታማትነ ኤንታ ዩሹዋን ደእያ ጉታት ሀይሳታ።<verse eid="JOS 19:16"/></para>
  <para style="s1">ይሳኮራ ላታ</para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 19:17"/>ኦይዳን ሳማይ ይሳኮራ ኮቻ ኤንታ ኮቻን ኮቻን ጋክስ። <verse eid="JOS 19:17"/><verse number="18" style="v" sid="JOS 19:18"/>ኤንታ ዛዋይ እዝራኤለ፥ ካሱሎታ፥ ሱኔማ፥ <verse eid="JOS 19:18"/><verse number="19" style="v" sid="JOS 19:19"/>ሀፋራይማ፥ ሽኦና፥ አናሃራታ፥ <verse eid="JOS 19:19"/><verse number="20" style="v" sid="JOS 19:20"/>ራብታ፥ ቅሶና፥ አቤፃ፥ <verse eid="JOS 19:20"/><verse number="21" style="v" sid="JOS 19:21"/>ራመታ፥ ኤንጋንማ፥ ኤንሀዳነ ቤት-ጳፀፃ ኦይኬስ። <verse eid="JOS 19:21"/><verse number="22" style="v" sid="JOS 19:22"/>ሄ ቢታ ዛዋይ ታቦረ፥ ሻሀፁማነ ቤት-ሳሜሳ ቦችሸ ብድ፥ ዮርዳኖሰ ሻፋን ዛዋቴስ። ኤንቲ ኩመ ታማነ ኡሱፑን ካታማ፤ ኤንታ ዩሹዋን ደእያ ጉታት ኤንታ ቦላ ጉዠቶሶና። <verse eid="JOS 19:22"/><verse number="23" style="v" sid="JOS 19:23"/>ይሳኮራ ኮቻይ ባንታ ኮቻን ኮቻን ላትዳ ቢታ ግዶን ደእያ ካታማትነ ኤንታ ዩሹዋን ደእያ ጉታት ሀይሳታ።<verse eid="JOS 19:23"/></para>
  <para style="s1">አሴራ ላታ ቢታ</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 19:24"/>እቻሻን ሳማይ አሴራ ኮቻ ኤንታ ኮቻን ኮቻን ጋክስ። <verse eid="JOS 19:24"/><verse number="25" style="v" sid="JOS 19:25"/>ኤንታ ቢታ ዛዋይ፥ ሄልቃታ፥ ሀላ፥ በፀና፥ አዝፋ፥ <verse eid="JOS 19:25"/><verse number="26" style="v" sid="JOS 19:26"/>አላመለከ፥ አማዳነ ምሻላ ኤኬስ። ዉሎሀ ባጋራ ቃርመሎሳንነ ስሆር-ልብናታን ዛዋቴስ። <verse eid="JOS 19:26"/><verse number="27" style="v" sid="JOS 19:27"/>ቃስ ዶሎሀ ባጋራ ቤት-ዳጎናኮ ምርቀትድ፥ ዛብሎናነ ይፍታህኤላ ዛንጋራ ቦችሸ ብድ፥ ፑደሀ ባጋራ ቤት-ኤመቃነ ንኤላ ጋኬስ። ቃስ ፑደሀ ባጋራ ካቡላ፥ <verse eid="JOS 19:27"/><verse number="28" style="v" sid="JOS 19:28"/>ኤብሮና፥ ረሆባ፥ ሀሞናነ ቃና ካንድ፥ ስዶናን ዛዋቴስ። <verse eid="JOS 19:28"/><verse number="29" style="v" sid="JOS 19:29"/>ሄ ዛዋይ ራማ ዩይድ፥ ግምበን ድረትዳ ፅሮሳ ካታማ ጋክድ፥ ሆሳኮ ምርቀትድ፥ መደትራነ አባን ዛዋቴስ። ቃስ ማሀላባ፥ አክዚባ፥ <verse eid="JOS 19:29"/><verse number="30" style="v" sid="JOS 19:30"/>ኡማ፥ አፌቃነ ረሆባ ጌተትያ ካታማታ ጋክድ ዛዋቴስ። ኤንቲ ኩመ ላታማነ ናምኡ ካታማ፤ ኤንታ ዩሹዋን ደእያ ጉታት ኤንታ ቦላ ጉዠቶሶና። <verse eid="JOS 19:30"/><verse number="31" style="v" sid="JOS 19:31"/>አሴራ ኮቻይ ባንታ ኮቻን ኮቻን ላትዳ ካታማትነ ኤንታ ዩሹዋን ደእያ ጉታት ሀይሳታ።<verse eid="JOS 19:31"/></para>
  <para style="s1">ንፍታለመ ላታ</para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 19:32"/>ኡሱፑን ሳማይ ንፍታለመ ኮቻ ኤንታ ኮቻን ኮቻን ጋክስ። <verse eid="JOS 19:32"/><verse number="33" style="v" sid="JOS 19:33"/>ኤንታ ዛዋይ ሄለፋፐነ ዛናንመ ዎላፐ ብድ፥ አዳም-ነቀባ፥ ያብንኤላነ ላቁማ ካንድ፥ ዉርሰይ ዮርዳኖሰ ሻፋን ኤቄስ። <verse eid="JOS 19:33"/><verse number="34" style="v" sid="JOS 19:34"/>ቃስ ሄ ዛዋይ ዉሎሀ ባጋራ አዝኖት-ታቦራኮ ምርቀትድ፥ ሁቆቃን ኤቄስ። ሄ ዛዋይ ዱገሀ ባጋን ዛብሎና፥ ዉሎሀ ባጋን አሴራ፥ ዶሎሀ ባጋን ዮርዳኖሰ ሻፋ ካንድ ይሁዳን ጋኬስ። <verse eid="JOS 19:34"/><verse number="35" style="v" sid="JOS 19:35"/>ግምበን ድረትዳ ካታማት፥ ፅድማ፥ ፄራ፥ ሀማታ፥ ራቃታ፥ ከነሬታ አባ፥ <verse eid="JOS 19:35"/><verse number="36" style="v" sid="JOS 19:36"/>አዳማ፥ ራማ፥ ሀፆራ፥ <verse eid="JOS 19:36"/><verse number="37" style="v" sid="JOS 19:37"/>ቄደሻ፥ ኤድራአ፥ ኤንሀፆራ፥ <verse eid="JOS 19:37"/><verse number="38" style="v" sid="JOS 19:38"/>ይርኦና፥ ማግደላ፥ ሆረማ፥ ቤት-አናታነ ቤት-ሳሜሳ ካታማታ ኦይኬስ። ሄ ካታማት ኩመ ታማነ ኡዱፉና፤ ኤንታ ዩሹዋን ደእያ ጉታት ኤንታ ቦላ ጉዠቶሶና። <verse eid="JOS 19:38"/><verse number="39" style="v" sid="JOS 19:39"/>ንፍታለመ ኮቻይ ባንታ ኮቻን ኮቻን ላትዳ ካታማትነ ኤንታ ዩሹዋን ደእያ ጉታት ሀይሳታ።<verse eid="JOS 19:39"/></para>
  <para style="s1">ዳነ ላታ</para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 19:40"/>ላፑን ሳማይ ዳነ ኮቻ ኤንታ ኮቻን ኮቻን ጋክስ። <verse eid="JOS 19:40"/><verse number="41" style="v" sid="JOS 19:41"/>ኤንቲ ላትዳ ካታማት ፆርአ፥ ኤሽታኦላ፥ እርሸመሻ፥ <verse eid="JOS 19:41"/><verse number="42" style="v" sid="JOS 19:42"/>ሻአልብማ፥ ኤሎና፥ ይታላ፥ <verse eid="JOS 19:42"/><verse number="43" style="v" sid="JOS 19:43"/>ኤሎና፥ ትምና፥ ኤቅሮና፥ <verse eid="JOS 19:43"/><verse number="44" style="v" sid="JOS 19:44"/>ኤልታቃ፥ ግብቶና፥ ባላታ፥ <verse eid="JOS 19:44"/><verse number="45" style="v" sid="JOS 19:45"/>የሁዳ፥ በነባራቃ፥ ጋት-ርሞና፥ <verse eid="JOS 19:45"/><verse number="46" style="v" sid="JOS 19:46"/>ማያርቆና፥ ራቆናነ ዮጰ ካታማ ዩሹዋን ደእያ ሄራታ ኦይኬስ። <verse eid="JOS 19:46"/><verse number="47" style="v" sid="JOS 19:47"/>ዳነ ኮቻይ ኤንታ ላታ ቢታይ ኤንታፈ ኤከትን፥ ላሸማ ካታማ ብድ፥ ኦላን ፆንድ፥ ሄ ካታማን ደእያ አሳ ማሻን ዎድ፥ ሄ ቢታ ባንታባ ኦዶሶና። ሄ ካታማ ሱን ላምድ፥ ባንታ አዋ ዳነ ሱንን ዳነ ግድ ሱንዶሶና። <verse eid="JOS 19:47"/><verse number="48" style="v" sid="JOS 19:48"/>ዳነ ኮቻት ባንታ ኮቻን ኮቻን ላትዳ ካታማትነ ኤንታ ዩሹዋን ደእያ ጉታት ሀይሳታ።<verse eid="JOS 19:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JOS 19:49"/>እስራኤለ አሳይ ቢታ ሻሁዋ ኦንግዳ ዎደ፥ ናወ ናኣ እያሱስ ላታ ቢታ እምዶሶና። <verse eid="JOS 19:49"/><verse number="50" style="v" sid="JOS 19:50"/>ጎዳይ ካሰ ኪትዳይሳዳ እያሱይ ደረይ ዳርያ ኤፍሬማን ደእያ ትምናት-ሳራ ካታማ እማና መላ ኦይችን፥ እያዉ እምዶሶና። ሄ ካታማ ዛር ጊግስድ፥ ያን ደእስ። <verse eid="JOS 19:50"/><verse number="51" style="v" sid="JOS 19:51"/>ካህነይ አላዛር፥ ናወ ናኣ እያሱይነ እስራኤለ ሶ አሳ ሀላቃት ሴሎን፥ ጎዳ ስንን ፆሳ ዱንካንያ ፐንገን ሳማ የግድ፥ ሻክዳ ላታ ቢታይ ሀይሳ። ኤንቲ ቢታ ያት ሻክድ ኦንግዶሶና።<verse eid="JOS 19:51"/></para>
  <chapter eid="JOS 19"/>
  <chapter number="20" style="c" sid="JOS 20"/>
  <para style="s1">ባቃትድ አትያ ካታማታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 20:1"/>ሄሳፈ ጉየ ጎዳይ እያሱኮ ሀይሳዳ ያግስ፤ <verse eid="JOS 20:1"/><verse number="2" style="v" sid="JOS 20:2"/>“ታኒ ሙሰ ባጋራ ኪትዳይሳዳ፥ ‘አሳይ ባቃትድ አትያ ካታማታ ዱማያና መላ’ እስራኤለ አሳስ ኦዳ። <verse eid="JOS 20:2"/><verse number="3" style="v" sid="JOS 20:3"/>ኦንካ ቆፖናነ ኤሮና አሰ ዎኮ፥ ያ ባቃትድ ጉክዳ ሱ ግሾ ሱ ዛራናዉ ኮያ ኡራፐ አታና። <verse eid="JOS 20:3"/><verse number="4" style="v" sid="JOS 20:4"/>አሰ ዎዳይስ ሄ ካታማታፐ እሱዋኮ ባቃትድ ብድ፥ ካታማ ፐንገን ኤቅድ፥ ሀንዳባ ኡባ ሄ ካታማ ጭማታስ ኦዶ። ሄሳፈ ጉየ፥ ኤንቲ ባንታ ካታማ ኤፍድ፥ እ ዳና በሲ እምኮ ኤንታራ ያን ደኦ። <verse eid="JOS 20:4"/><verse number="5" style="v" sid="JOS 20:5"/>ሱ ግሾ ሱ ዛራናዉ ኮያ ኡራይ እያ ካልድ ዪኮ፥ እ ባ እሻ ኤርድ፥ ቆሀናዉ ኮይድ ዎቦና ግሾ ሄ ካታማ ጭማት እያ አድ እሞፎ። <verse eid="JOS 20:5"/><verse number="6" style="v" sid="JOS 20:6"/>ሻንጎ ስንን ሺቅድ፥ ፕርደታና ጋካናዉነ ሄ ዎደ ደእያ ካህነ ሀላቃይ ሀይቃና ጋካናዉ ሄ ካታማን ደኦ። ሄሳፈ ጉየ፥ ባቃትድ ከይዳ ካታማ ጉየ ስሚድ ባ ሶ ገሎ” ያግስ።<verse eid="JOS 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 20:7"/>ያትን እስራኤለ አሳይ ደረይ ዳርያ ንፍታለመን ጋልላን ደእያ ቃደሳ፥ ደረይ ዳርያ ኤፍሬማን ደእያ ሴከማነ ደረይ ዳርያ ይሁዳን ደእያ ቅርያት-አርባ ዎይኮ ከብሮና ዱማይዶሶና። <verse eid="JOS 20:7"/><verse number="8" style="v" sid="JOS 20:8"/>ዮርዳኖሰ ሻፋፐ ሄፍንን፥ እያርኮፈ ዶሎሀ ባጋን ቃን፥ መላ ቢታን፥ ሮቤላ፥ ኮቻታ ቢታን ደእያ ቦሶራ፥ ጋዳ ኮቻታ ቢታን፥ ጋላዳን ደእያ ራሞታነ ምናሰ ኮቻታ ቢታን፥ ባሳነን ደእያ ጎላና ዱማይዶሶና። <verse eid="JOS 20:8"/><verse number="9" style="v" sid="JOS 20:9"/>እስራኤለ አሳይነ ኤንታ ግዶን ደእያ በታንቾት ባቃትድ አታና መላ ዱማትዳ ካታማት ሀይሳታ። ኦንካ ኤሮና ደእሸ አሰ ዎኮ፥ ሻንጎ ስንን ፕርደቶና ደእሸ፥ ሀይቆና አታናዉ ሀ ካታማታፐ እሱዋኮ ባቃታናዉ ዳንዳኤስ።<verse eid="JOS 20:9"/></para>
  <chapter eid="JOS 20"/>
  <chapter number="21" style="c" sid="JOS 21"/>
  <para style="s1">ሌወታ ካታማታ</para>
  <para style="p">
    <verse number="1-2" style="v" sid="JOS 21:1-2"/>ሄሳፈ ጉየ፥ እስራኤለ አሳይ ካናነ ቢታን፥ ሴሎን ዱንካንድ ደእሽን፥ ሌወ ሶ አሳ ሀላቃት ካህንያ አላዛራኮ፥ ናወ ናኣ እያሱኮነ እስራኤለ ሀላቃታኮ ይድ፥ “ኑኒ ዳና ካታማታነ መሄ ሄምያ ቢታ ኑስ እማና መላ፥ ጎዳይ ሙሰ ባጋራ ኪትስ” ያግዶሶና። <verse eid="JOS 21:1-2"/><verse number="3" style="v" sid="JOS 21:3"/>ሄሳ ግሾ፥ ጎዳይ ኪትዳይሳዳ፥ እስራኤለ አሳይ ሌወታስ ካታማታነ መሄ ሄምያ ቢታ ባንታ ቢታፈ ሻክድ፥ እምዶሶና።<verse eid="JOS 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 21:4"/>ኮይሮ ሳማይ ቃሃታ ኮቻስ ከይስ። ካህንያ አሮና ኮቻይ፥ ይሁዳ፥ ስሞናነ ብንያመ ኮቻፈ ታማነ ሄ ካታማታ ሳማን ኤክዶሶና። <verse eid="JOS 21:4"/><verse number="5" style="v" sid="JOS 21:5"/>አትዳ ቃሃታ ኮቻይ፥ ኤፍሬማ፥ ዳነነ ዉሎሀ ባጋን ደእያ ምናሰ ኮቻፈ ታሙ ካታማታ ሳማን ኤክዶሶና።<verse eid="JOS 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 21:6"/>ገድሶና ኮቻይ፥ ይሳኮራ፥ አሴራ ንፍታለመነ ዶሎሀ ባጋን ደእያ ምናሰ ኮቻፈ ታማነ ሄ ካታማታ ሳማን ኤክዶሶና።<verse eid="JOS 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 21:7"/>መራራ ኮቻይ፥ ሮቤላ፥ ጋደነ ዛብሎና ኮቻፈ ታማነ ናምኡ ካታማታ ኤክዶሶና።<verse eid="JOS 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 21:8"/>ጎዳይ ሙሰ ባጋራ ኪትዳይሳዳ፥ እስራኤለ አሳይ ሀ ካታማታነ መሄ ሄምያ ቢታ ሌወታስ ሳማን ሻክድ እምዶሶና።<verse eid="JOS 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 21:9"/>እስራኤለ አሳይ ይሁዳነ ስሞና ኮቻፈ ካልድ ሱንን ፄገትዳ ካታማታ እምዶሶና። <verse eid="JOS 21:9"/><verse number="10" style="v" sid="JOS 21:10"/>ኮይሮ ሳማይ ሌወ ኮቻፈ የለትዳ፥ ቃሃታ ኮቸ ግድዳ አሮና ያራስ ከይን፥ ኤንታዉ እመትዳ ካታማት ሀይሳታ፤ <verse eid="JOS 21:10"/><verse number="11" style="v" sid="JOS 21:11"/>ደረይ ዳርያ ይሁዳን ደእያ ቅርያት-አርባ ዎይኮ ከብሮነነ እያ ዩሹዋን ደእያ ሄን ቢታታ ኤንታዉ እምዶሶና። (አርብ አናቀ አዋ።) <verse eid="JOS 21:11"/><verse number="12" style="v" sid="JOS 21:12"/>ሽን ኮይሮ ሄ ካታማ ዩሹዋን ደእያ ቢታነ ጉታታ ዮፎና ናኣ ካለባስ ላታ ኦድ እምዶሶና። <verse eid="JOS 21:12"/><verse number="13" style="v" sid="JOS 21:13"/>ካህንያ አሮና ያራስ አሰ ዎዳ አስ ባቃትድ አትያ ከብሮነነ ሄን ቢታ፥ ልብናነ ሄን ቢታ፥ <verse eid="JOS 21:13"/><verse number="14" style="v" sid="JOS 21:14"/>ያትራነ ሄን ቢታ፥ ኤሽታሞአነ ሄን ቢታ፥ <verse eid="JOS 21:14"/><verse number="15" style="v" sid="JOS 21:15"/>ሆሎናነ ሄን ቢታ፥ ዳብራነ ሄን ቢታ፥ <verse eid="JOS 21:15"/><verse number="16" style="v" sid="JOS 21:16"/>አይናነ ሄን ቢታ፥ ዩፃነ ሄን ቢታ፥ ቤት-ሳሜሳነ ሄን ቢታ። ሀይሳቲ ይሁዳፐነ ስሞናፐ ኤከትዳ፥ ካታማት ኩመ ኡዱፉና። <verse eid="JOS 21:16"/><verse number="17" style="v" sid="JOS 21:17"/>ብንያመ ኮቻፈ ኤከትዳ ኦይዱ ካታማት፥ ጋባኦናነ ሄን ቢታ፥ ግብአነ ሄን ቢታ፥ <verse eid="JOS 21:17"/><verse number="18" style="v" sid="JOS 21:18"/>አናቶተነ ሄን ቢታ፥ አልሞናነ ሄን ቢታ። <verse eid="JOS 21:18"/><verse number="19" style="v" sid="JOS 21:19"/>አሮና ኮቸ ግድዳ ካህነታስ እመትዳ ካታማትነ ሄን ቢታት ታማነ ሄ።<verse eid="JOS 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 21:20"/>ሌወ ኮቸ ግድዳ፥ አትዳ ቃሃታ ኮቻስ፥ ኤፍሬማስ እመትዳ ቢታፈ ሻከትድ እመትስ። <verse eid="JOS 21:20"/><verse number="21" style="v" sid="JOS 21:21"/>ቃስ ኤንታዉ ደረይ ዳርያ ኤፍሬማን፥ አሰ ዎዳ አስ ባቃትድ አትያ ኦይዱ ካታማት ሴከማነ ሄን ቢታ፥ ገዘራነ ሄን ቢታ፥ <verse eid="JOS 21:21"/><verse number="22" style="v" sid="JOS 21:22"/>ቅብፃይማነ ሄን ቢታ፥ ቤት-ሆሮናነ ሄን ቢታ እምዶሶና። <verse eid="JOS 21:22"/><verse number="23" style="v" sid="JOS 21:23"/>ዳነ ኮቻፈ ሻከት እመትዳ ኦይዱ ካታማት፥ ኤልታቃነ ሄን ቢታ፥ ግበቶናነ ሄን ቢታ፥ <verse eid="JOS 21:23"/><verse number="24" style="v" sid="JOS 21:24"/>ኤሎናነ ሄን ቢታ፥ ጋት-ርሞናነ ሄን ቢታ። <verse eid="JOS 21:24"/><verse number="25" style="v" sid="JOS 21:25"/>ምናሰ ኮቻ ባጋፈ ሻከት እመትዳ ናምኡ ካታማት፥ ታናካነ ሄን ቢታ፥ ጋት-ርሞናነ ሄን ቢታ። <verse eid="JOS 21:25"/><verse number="26" style="v" sid="JOS 21:26"/>አትዳ ቃሃታ ኮቻት ሄን ቢታራ እስፈ ታሙ ካታማ ኤክዶሶና።<verse eid="JOS 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 21:27"/>ሀራ ሌወ ኮቸ ግድዳ ገድሶና ኮቻስ እመትዳ ቢታይ፥ ምናሰ ኮቻ ባጋፈ አሰ ዎዳ አስ ባቃትድ አትያ ናምኡ ካታማት፥ ባሳነን ደእያ ጎላናነ ሄን ቢታ፥ በኤሽትራነ ሄን ቢታ። <verse eid="JOS 21:27"/><verse number="28" style="v" sid="JOS 21:28"/>ይሳኮራ ኮቻፈ እመትዳ ኦይዱ ካታማት፥ ቅሶናነ ሄን ቢታ፥ ደብራታነ ሄን ቢታ። <verse eid="JOS 21:28"/><verse number="29" style="v" sid="JOS 21:29"/>ያርሙታነ ሄን ቢታ፥ ኤንጋንማነ ሄን ቢታ። <verse eid="JOS 21:29"/><verse number="30" style="v" sid="JOS 21:30"/>አሴራ ኮቻፈ ሻከት እመትዳ ኦይዱ ካታማት ምሻላነ ሄን ቢታ፥ አብዶናነ ሄን ቢታ፥ <verse eid="JOS 21:30"/><verse number="31" style="v" sid="JOS 21:31"/>ሄልቃተነ ሄን ቢታ፥ ረሆባነ ሄን ቢታ። <verse eid="JOS 21:31"/><verse number="32" style="v" sid="JOS 21:32"/>ንፍታለመ ኮቻፈ ሻከት እመትዳ ሄ ካታማት፥ አሰ ዎዳ አስ ባቃትድ አትያ፥ ጋልላን ደእያ ቃደሳነ ሄን ቢታ፥ ሀሞት-ዶራነ ሄን ቢታ፥ ቃርታናነ ሄን ቢታ። <verse eid="JOS 21:32"/><verse number="33" style="v" sid="JOS 21:33"/>ገድሶና ኮቻት ሄን ቢታራ እስፈ ታማነ ሄ ካታማታ ኤክዶሶና።<verse eid="JOS 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 21:34"/>ሌወ ኮቸ ግድዳ አትዳ መራራ ኮቻት፥ ዛብሎና ኮቻፈ ሻከት እመትዳ ኦይዱ ካታማት፥ ዮቅናማነ ሄን ቢታ፥ ቃርታናነ ሄን ቢታ፥ <verse eid="JOS 21:34"/><verse number="35" style="v" sid="JOS 21:35"/>ድምናነ ሄን ቢታ፥ ናህላላነ ሄን ቢታ ኤክዶሶና። <verse eid="JOS 21:35"/><verse number="36" style="v" sid="JOS 21:36"/>ሮቤላ፥ ኮቻፈ ሻከትድ እመትዳ ኦይዱ ካታማት፥ ቦሶራነ ሄን ቢታ፥ ያሃፃነ ሄን ቢታ፥ <verse eid="JOS 21:36"/><verse number="37" style="v" sid="JOS 21:37"/>ቅደሞታነ ሄን ቢታ፥ መፋታነ ሄን ቢታ። <verse eid="JOS 21:37"/><verse number="38" style="v" sid="JOS 21:38"/>ጋዳ ኮቻፈ ሻከትድ እመትዳ ኦይዱ ካታማት፥ ጋላዳን አሰ ዎዳ አስ ባቃትድ አትያ፥ ራሞታነ ሄን ቢታ፥ ማህናይመ፥ <verse eid="JOS 21:38"/><verse number="39" style="v" sid="JOS 21:39"/>ሀሰቦና፥ ያእዜራ። <verse eid="JOS 21:39"/><verse number="40" style="v" sid="JOS 21:40"/>ሌወ ኮቸ ግድዳ አትዳ መራራ ኮቻይ ኤክዳ ካታማት ታማነ ናምአ።<verse eid="JOS 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JOS 21:41"/>እስራኤለ አሳይ ላትዳ ቢታፈ ሌወ ኮቻስ እመትዳ ካታማት ሄን ቢታራ እስፈ ኦይታማነ ሆስፑና። <verse eid="JOS 21:41"/><verse number="42" style="v" sid="JOS 21:42"/>ሄ ካታማታ ኡባ ዩሹዋን ሄን ቢታት ደኦሶና።<verse eid="JOS 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JOS 21:43"/>ጎዳይ ኤንታ አዋታስ እማና ግድ ጫቅዳ ቢታ ኡባ እስራኤለ አሳስ እምስ። ኤንቲ ሄ ቢታ ላትድ፥ ያን ደእዶሶና። <verse eid="JOS 21:43"/><verse number="44" style="v" sid="JOS 21:44"/>ጎዳይ ኤንታ አዋታስ ጫቅዳይሳዳ፥ ኤንታ ሳሮን ዎስ። ኤንቲ ኦላስ ከይዳ ዎደ ኡባን ኤንታ ሞርከት ኤንታራ ኤቀታናዉ ዳንዳእቦኮና። <verse eid="JOS 21:44"/><verse number="45" style="v" sid="JOS 21:45"/>ጎዳይ እስራኤለ አሳስ እማና ግድ ጫቅዳ ሎኦባ ኡባ ፖልስፐ አትሽን፥ እሶይካ አትቤና።<verse eid="JOS 21:45"/></para>
  <chapter eid="JOS 21"/>
  <chapter number="22" style="c" sid="JOS 22"/>
  <para style="s1">ዶሎሀ ባጋ ኮቻት ስምዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 22:1"/>ሄሳፈ ጉየ፥ እያሱይ ሮቤላ፥ ጋደነ ምናሰ ኮቻፈ ባጋ ፄግድ፥ <verse eid="JOS 22:1"/><verse number="2" style="v" sid="JOS 22:2"/>“ጎዳ አይለይ ሙሰይ ህንተና ኪትዳ ኡባ ፖልደታ፤ ቃስ ታዉ ኪተትደታ። <verse eid="JOS 22:2"/><verse number="3" style="v" sid="JOS 22:3"/>ሄ ኡባን ሀች ጋካናዉ ህንተ እሻታ የግቤከታ። ጎዳ፥ ህንተ ፆሳ ኪታ ኡባ ፖልደታ። <verse eid="JOS 22:3"/><verse number="4" style="v" sid="JOS 22:4"/>ጎዳይ ህንተ ፆሳይ ህንተዉ ጫቅዳ ቃላዳ፥ ህንተ እሻታ ሸምፕስስ። ሄሳ ግሾ፥ ጎዳ አይለይ ሙሰይ ህንተዉ ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋን እምዳ፥ ላታ ቢታን ደእያ ህንተ ሶ ሶ ስምተ። <verse eid="JOS 22:4"/><verse number="5" style="v" sid="JOS 22:5"/>ጎዳ አይለይ ሙሰይ ህንተና ኪትዳ ህግያ ምንድ ናግተ። ጎዳ ህንተ ፆሳ ሲቅተ። እያ ኦግያፐ ደሾፕተ፤ እያ ኪታ ፖልተ። እያራ ሽጵ ግድ ደእተ፤ ህንተ ኩመ ዎዛናፐነ ኩመ ሸምፑዋፈ እያዉ ኦተ” ያግስ።<verse eid="JOS 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 22:6"/>እያሱይ ኤንታ አንጅድ የድን ኤንቲ ባንታ ሶ ስምዶሶና። <verse eid="JOS 22:6"/><verse number="7" style="v" sid="JOS 22:7"/>እያሱይ፥ ምናሰ ኮቻ ባጋስ ባሳነን ላታ ቢታ እምስ። አትዳ ባጋ ኮቻስ ቃስ ዮርዳኖሰፐ ዉሎሀ ባጋን ላታ ቢታ እምስ። እያሱይ ኤንታ አንጅድ ሞይዝሸ፥ <verse eid="JOS 22:7"/><verse number="8" style="v" sid="JOS 22:8"/>ህንተ፥ “ዳሮ መሄ፥ ብራ፥ ዎርቃ፥ ናሰ፥ ብራታነ ዳሮ ማኦ ኤክድ ህንተ ሶ ስማና ሀኔታ። ሄሳ ግሾ፥ ህንተ ሞርከታፐ ድእዳይሳ ህንተ እሻታራ ሻከትተ” ያግስ።<verse eid="JOS 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 22:9"/>ሮቤላ፥ ጋድነ ምናሰ ኮቻ ባጋይ ባንታ ላታ ቢታ ስምዶሶና። ኤንቲ፥ ጎዳይ ሙሰ ባጋራ ኪትን ላትዳ ጋላዳ ቢታ፥ ካናነ ቢታን፥ ሴሎን ደእያ እስራኤለ አሳፐ ሻከትድ ብዶሶና።<verse eid="JOS 22:9"/></para>
  <para style="s1">ዶሎሀ ባጋ ያርሾ በሳ</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 22:10"/>ሮቤላ፥ ጋድነ ምናሰ ኮቻፈ ባጋይ ዮርዳኖሰ ማታን ካናነ ቢታን ደእያ ጋልሎታ ይድ፥ ሻፋ ማታን ማላልስያ ግታ ያርሾ በሲ ኬፅዶሶና። <verse eid="JOS 22:10"/><verse number="11" style="v" sid="JOS 22:11"/>ሮቤላ፥ ጋድነ ምናሰ ኮቻፈ ባጋይ ዮርዳኖሰ ማታን፥ ጋልሎታን፥ ካናነ ቢታን ያርሾ በሲ ኬፅዳይሳ አትዳ እስራኤለ አሳይ ስእዶሶና። <verse eid="JOS 22:11"/><verse number="12" style="v" sid="JOS 22:12"/>እስራኤለ አሳይ ሄሳ ስእድ፥ ኤንታ ኦላናዉ ሴሎን ሺቅዶሶና።<verse eid="JOS 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 22:13"/>ሄሳፈ ስን እስራኤለ አሳይ፥ ካህንያ አላዛራ ናኣ ፕንሃሳ፥ ጋላዳን ደእያ ሮቤላ፥ ጋደነ ምናሰ ኮቻፈ ባጋታኮ የድዶሶና። <verse eid="JOS 22:13"/><verse number="14" style="v" sid="JOS 22:14"/>እስ እስ ኮቻይ ባ ሶ ሀላቃታፐ እስ እስ አሰ ዶርድ፥ ታሙ አስ ፕንሃሳራ የድዶሶና።<verse eid="JOS 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 22:15"/>ኤንቲ ሮቤላ፥ ጋድነ ምናሰ ኮቻፈ ባጋይ ጋላዳ ብድ፥ <verse eid="JOS 22:15"/><verse number="16" style="v" sid="JOS 22:16"/>“ጎዳ አሳይ፥ ‘እስራኤለ ፆሳ ቦላ ደእያ ህንተ አማኑዋ አይስ ፓጭሴቲ? ህንተዉ ያርሾ በሲ ኬፅድ፥ ጎዳፐ ሃክደታ። እያ ቦላ አይስ ማካልደቲ? <verse eid="JOS 22:16"/><verse number="17" style="v" sid="JOS 22:17"/>ፐኦራን ኑ ኦዳ ናጋራይ ግደኔ? ጎዳ አሳ ቦላ ቦሽ ዎስ፤ ሀች ጋካናዉ ኑኒ ሄ ናጋራፐ ጌይቦኮ። <verse eid="JOS 22:17"/><verse number="18" style="v" sid="JOS 22:18"/>ጎዳ ቦላ ሀች ህንተ ዞኮ ዛርደታ። ሀች ህንተ እያ ቦላ ዞኮ ዛርኮ ዎንቶ እ ኩመ እስራኤለ አሳ ሀንቃና። <verse eid="JOS 22:18"/><verse number="19" style="v" sid="JOS 22:19"/>ህንተ ደእያ ቢታይ ቱንዳባ ግድኮ፥ ጎዳ ዱንካነይ ደእያ ቢታ፥ ሃ ኑኮ ይድ፥ ኑ ላታ ሻከትተ። ሽን ጎዳ፥ ኑ ፆሳ ያርሾ በሳፈ ሀራ ያርሾ በሲ ኬፅድ ፆሳ ቦላ ዎይኮ ኑ ቦላ ማካሎፍተ። <verse eid="JOS 22:19"/><verse number="20" style="v" sid="JOS 22:20"/>ዛራ ናአይ አካን ድገትዳባ ኤክድ፥ ናጋራ ኦዳ ግሾ፥ ኩመ እስራኤለ አሳ ቦላ ጎዳ ሀንቆይ ዎቤነዬ? እያ ናጋራ ጋሶን ሀይቅዳይ እያ ፃላላ ግደና’ ” ያግዶሶና።<verse eid="JOS 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 22:21"/>ያትን ሮቤላ፥ ጋደነ ምናሰ ኮቻፈ ባጋይ ሀይሳዳ ያግድ ዛርዶሶና። <verse eid="JOS 22:21"/><verse number="22" style="v" sid="JOS 22:22"/>“ጎዳ ፃላል ፆሰ! ጎዳ ፃላል ፆሰ! ኑኒ ሀይሳ አይስ ኦዳኮ እ ኤሬስ፤ ህንተካ ኤራና መላ ኑ ኮዮስ። ኑኒ ጎዳ ቦላ ማካልዳባነ ኪተቶና እፅዳባ ግድኮ፥ ሀች ኑና ፓፃ ዎፍተ። <verse eid="JOS 22:22"/><verse number="23" style="v" sid="JOS 22:23"/>ኑ ጎዳስ ኪተቶና እፅድ፥ ፁሳ ያርሹዋ፥ ካ ያርሹዋነ እስፈተ ያርሹዋ ያርሻናዉ ያርሾ በሲ ኬፅዳባ ግድኮ፥ ጎዳይ ኑና ሀንቆ። <verse eid="JOS 22:23"/><verse number="24" style="v" sid="JOS 22:24"/>ኑ ሄሳ ቆፕድ ኬፅቦኮ። ኑኒ ያርሾ በሲ ኬፅዳይ፥ ዎንቶ ህንተ ናይት፥ ኑ ናይታኮ፥ ‘ህንተዉ ጎዳ፥ እስራኤለ ፆሳራ አይ ጋሄተ ደኢ? <verse eid="JOS 22:24"/><verse number="25" style="v" sid="JOS 22:25"/>ጎዳይ ኑ ግዶንነ ሮቤላነ ጋዳ ኮቻ ግዶን ዮርዳኖሰ ሻፋ ዛዋ ዎስ። ሄሳ ግሾ፥ ጎዳራ ህንተዉ ጋሄተ ባዋ’ ጋንደሻ ግድ ያይዳ ግሾሳ። ቃስ ህንተ ኮቻይ ኑ ኮቻ ጎዳ ጎይኖ ድጎና አጎኮና” ያግድ ቆፕዳ።<verse eid="JOS 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 22:26"/>“ኑ ያርሾ በሲ ኬፅዳይ ሄሳሳ። ፁሳ ዎይኮ ሀራ ያርሾ ያርሻናሳ ግደና። <verse eid="JOS 22:26"/><verse number="27" style="v" sid="JOS 22:27"/>ኑኒ ያርሾ በሲ ኬፅዳይ፥ ፁሳ፥ እስፈተነ ሀራ ያርሹዋ ያርሽሸ ደእዳይሳስነ ጎዳ ዱንካንያ ስንን ጎይንሸ ደእዳይሳስ፥ ኑ ግዶንነ ህንተ ግዶን ቃስ ካልያ የለታ ግዶን ሄስ ማርካ ግዳና መላሳ። ሄስ ህንተ ናይት ኑ ናይታኮ፥ ‘ህንተዉ ጎዳራ አይ ጋሄተካ ባዋ’ ያጎና መላ ማዳና። <verse eid="JOS 22:27"/><verse number="28" style="v" sid="JOS 22:28"/>ኤንቲ ዎደፐ ኑኮ ዎይኮ ኑ ኮቻኮ ሄሳዳ ጊኮ፥ ኑ ናይት ዛሪድ፥ ‘ኑ አዋት ጎዳስ ኬፅዳ ያርሾ በሳ ሌምሱዋ ሀይሳ በእተ። ሄስ ህንተ ግዶንነ ኑ ግዶን ማርካ ግዳና መላሳፈ አትሽን፥ ፁሳ ዎይኮ ሀራ ያርሾ ያርሻናሳ ግደና’ ጋናዉ ዳንዳአና መላሳ። <verse eid="JOS 22:28"/><verse number="29" style="v" sid="JOS 22:29"/>ኑ ጎዳ ቦላ ማካላናይስ ኑፐ ሃኮ። ጎዳ ኑ ፆሳ ዱንካንያ ስንን ደእያ ያርሾ በሳፈ ሀራ ፁሳ፥ ካነ ሀራ ያርሾ በሲ ኬፅድ ፆሳ ጎይኖ አጎኮ” ያግድ ዛርዶሶና።<verse eid="JOS 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 22:30"/>ካህነይ ፕንሃስነ እያራ ደእያ እስራኤለ ሀላቃት፥ ሮቤላ፥ ጋደነ ምናሰ ኮቻፈ ባጋይ ኦድዳይሳ ስእድ፥ ኡፋይትዶሶና። <verse eid="JOS 22:30"/><verse number="31" style="v" sid="JOS 22:31"/>ካህንያ አላዛራ ናአይ ፕንሃስ፥ ሮቤላ፥ ጋደነ ምናሰ ኮቻታኮ፥ “ጎዳይ ኑራ ደኤይሳ ኑ ሀች ኤርዳ። ህንተ ጎዳ ቦላ ማካልቤከታ። ህንተ እስራኤለ አሳ ጎዳ ፕርዳፈ አሽደታ” ያግስ።<verse eid="JOS 22:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 22:32"/>ካህንያ አላዛራ ናአይ ፕንሃስነ እያራ ደእያ ሀላቃት ጋላዳን ደእያ ሮቤላነ ጋዳ ኮቻ ማታፐ ካናነን ደእያ እስራኤለ አሳኮ ስሚድ፥ ሀንዳባ ኤንታዉ ኦድዶሶና። <verse eid="JOS 22:32"/><verse number="33" style="v" sid="JOS 22:33"/>እስራኤለ አሳይ ኡፋይትድ፥ ፆሳ ጋላትዶሶና። ሄሳፈ ጉየ፥ ሮቤላነ ጋዳ አሳት ደእያ ቢታ ኦልድ ይሳናዉ ኦደትቦኮና።<verse eid="JOS 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 22:34"/>ሮቤላነ ጋዳ ኮቻይ፥ “ሀ ያርሾ በሳይ ጎዳ ፃላል ፆሳ ግደይሳስ ኑስ ማርካ” ያግድ፥ ሄ ያርሾ በሳ “ማርካ” ግድ ሱንዶሶና።<verse eid="JOS 22:34"/></para>
  <chapter eid="JOS 22"/>
  <chapter number="23" style="c" sid="JOS 23"/>
  <para style="s1">እያሱ ዉርሰ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 23:1"/>ዳሮ ዎደ ጋካናዉ ጎዳይ እስራኤለ አሳ ኤንታ ዩሹዋን ደእያ ሞርከታፐ ሸምፕስስ። ሄ ዎደ እያሱይ ጭምን፥ ላይ ሱገትስ። <verse eid="JOS 23:1"/><verse number="2" style="v" sid="JOS 23:2"/>እያሱይ፥ እስራኤለ አሳ ኡባ፥ ጭማታ፥ ሀላቃታ፥ ዳይናታነ ቶራ ሞጮናታ እስፈ ፄግድ፥ “ታኒ ሀእ ዳሮ ጭማስ። <verse eid="JOS 23:2"/><verse number="3" style="v" sid="JOS 23:3"/>ጎዳይ፥ ህንተ ፆሳይ ሀ ቢታን ደእያ ካዎተታ ኦል ፆናና መላ ዋትድ ህንተና ማድዳኮ በእደታ። <verse eid="JOS 23:3"/><verse number="4" style="v" sid="JOS 23:4"/>ዶሎሀን ዮርዳኖሰ ሻፋ፥ ዉሎሀን መደትራነ አባ ጋካናዉ ደእያ ኦይከትዳ ቢታነ ኦይከቶና ቢታ ኡባ ህንተ ኮቻስ ሻካ እማስ። <verse eid="JOS 23:4"/><verse number="5" style="v" sid="JOS 23:5"/>ጎዳይ፥ ህንተ ፆሳይ ኤንታ ህንተ ስንፈ ጎድድ ከሳና። ጎዳይ፥ ህንተ ፆሳይ ህንተዉ ጫቅዳይሳዳ ህንተ ኤንታ ቢታ ላታና።<verse eid="JOS 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 23:6"/>“ሙሰ ህገ ማፃፋን ፃፈትዳ ኡባ ምንድ ናግተነ ፖልተ፤ እያፐ ኡሻች ዎይኮ ሀድርስ ጎፕተ። <verse eid="JOS 23:6"/><verse number="7" style="v" sid="JOS 23:7"/>ህንተ ግዶን አትዳ ደርያራ ዋላከቶፍተ። ኤንታ ፆሳታ ሱን ፄጎፕተ ዎይኮ ኤንታ ሱንን ጫቆፍተ። ኤንታዉ ኦፍተ ዎይኮ ኤንታዉ ጎይኖፍተ። <verse eid="JOS 23:7"/><verse number="8" style="v" sid="JOS 23:8"/>ሽን ሀች ጋካናዉ ህንተ ኦዳይሳዳ ጎዳ ህንተ ፆሳስ አማነትተ።<verse eid="JOS 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 23:9"/>“ጎዳይ፥ ግታነ ምኖ ካዎተታ ህንተ ስንፈ ጎድድ ከስስ። ህንተራ ሀች ጋካናዉ ኦንካ ኤቀታናዉ ዳንዳእቤና። <verse eid="JOS 23:9"/><verse number="10" style="v" sid="JOS 23:10"/>ጎዳይ፥ ህንተ ፆሳይ ህንተዉ ጫቅዳይሳዳ፥ እ ህንተዉ ኦለትያ ግሾ፥ ህንተፈ እስ አስ ሙኩሉ አሳ የደና። <verse eid="JOS 23:10"/><verse number="11" style="v" sid="JOS 23:11"/>ጎዳ፥ ህንተ ፆሳ ኡባ ዎደ ሲቅተ። <verse eid="JOS 23:11"/><verse number="12" style="v" sid="JOS 23:12"/>ሽን ህንተ ጉየ ስሚድ፥ ህንተ ግዶን አትዳ ደርያራ ዋላከትኮ፥ ህንተ ኤንታ ማጫሳ፥ ቃስ ኤንቲ ህንተ ማጫሳ ኤክድ ኤንታራ ቃሸትኮ፥ <verse eid="JOS 23:12"/><verse number="13" style="v" sid="JOS 23:13"/>ጎዳይ፥ ህንተ ፆሳይ ሄ ደርያ ህንተ ስንፈ ጎድድ ከሶናይሳ ኤርተ። ጎዳይ፥ ህንተ ፆሳይ ህንተዉ እምዳ ሀ ሎኦ ቢታፈ ህንተ ያና ጋካናዉ፥ ኤንቲ ህንተዉ ፅሄነ ግተ ግዳና። ኤንቲ ህንተ ዞኩዋስ ልሶ፥ ህንተ አይፍያስ አጉን ግዳና።<verse eid="JOS 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 23:14"/>“ሀእ ታ ሀይቃናዉ ማታስ። ጎዳይ፥ ህንተ ፆሳይ ህንተዉ እማና ግድ ጫቅዳ ሎኦባ ኡባፈ እሶይካ አትቦናይሳ ህንተ ኡባይ፥ ህንተ ዎዛናንነ ሸምፑዋን ኤሬታ። እ ህንተዉ እማና ግድ ጫቅዳባፐ እሶይካ አቶና ኡባይ ፖለትስ። <verse eid="JOS 23:14"/><verse number="15" style="v" sid="JOS 23:15"/>ጎዳይ፥ ህንተ ፆሳይ ህንተራ ጫቅዳ ጫቁዋ ህንተ መንድ፥ ሀራ ፆሳታስ ኦኮነ ጎይንኮ፥ ጎዳ ሀንቆይ ህንተ ቦላ ኤፃና። <verse eid="JOS 23:15"/><verse number="16" style="v" sid="JOS 23:16"/>ጎዳይ፥ ህንተ ፆሳይ ህንተዉ እማና ግድ ጫቅዳ ሎኦባ ኡባ አሾና ፖልዳይሳዳ፥ እ ህንተዉ እምዳ ሀ ሎኦ ቢታፈ ህንተና ይሳና ጋካናዉ ኢታ ኡባ ህንተ ቦላ ኤሀና። እ ህንተዉ እምዳ ሎኦ ቢታፈ ኤለስድ ህንተ ያና።”<verse eid="JOS 23:16"/></para>
  <chapter eid="JOS 23"/>
  <chapter number="24" style="c" sid="JOS 24"/>
  <para style="s1">ሴከማን ጫቆ ቃል ኦራፅስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 24:1"/>እያሱይ እስራኤለ አሳ ኡባ ሴከማን ፄግስ። ጭማታ፥ ሀላቃታ፥ ዳይናታነ ኦላ ሞጮናታ ፄግን፥ ኤንቲ ፆሳ ስንን ሺቅዶሶና። <verse eid="JOS 24:1"/><verse number="2" style="v" sid="JOS 24:2"/>እያሱይ አሳኮ፥ “ጎዳይ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፤ ‘በን ህንተ አዋት ኤፍራፂሳ ሻፋፐ ሄፍንን፥ ሀራ ፆሳታስ ጎይንሸ ደእዶሶና። ኤንታፈ እሶይ አብራሃመነ ናኮራ አዋ ታራ። <verse eid="JOS 24:2"/><verse number="3" style="v" sid="JOS 24:3"/>ሽን ህንተ አዋ አብራሃመ፥ ኤፍራፂሳ ሻፋፐ ሄፍንን ደእያ ቢታፈ ፄጋዳ፥ ካናነ ቢታን ካለስ። እያ ኮቻ ዳርሳስ፤ ይሳቃካ እያዉ እማስ። <verse eid="JOS 24:3"/><verse number="4" style="v" sid="JOS 24:4"/>ይሳቃስ ያይቆባነ ኤሳዌ እማስ። ኤሳዌ፥ ደረይ ዳርያ ሳይረ ቢታ ላትሳስ፥ ሽን ያይቆብነ እያ ናይት ግብፀ ብዶሶና።<verse eid="JOS 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 24:5"/>“ ‘ጉየፐ ሙሳነ አሮና ኪታዳ ግብፀ ቢታ ጋዶን ሾጫስ፤ ዉርሰን ህንተና ከሳስ። <verse eid="JOS 24:5"/><verse number="6" style="v" sid="JOS 24:6"/>ህንተ አዋታ ግብፀፈ ከስዳ ዎደ ዞኦ አባኮ ብዶሶና። ግብፀት ፓራታንነ ፓራ ጋረታን ህንተ አዋታ ጉየ ዛራናዉ የደዶሶና። <verse eid="JOS 24:6"/><verse number="7" style="v" sid="JOS 24:7"/>ኤንቲ ታኮ ዋስዳ ዎደ ኤንታ ግዶንነ ግብፀታ ግዶን ማ የጋስ። ያታዳ፥ አባይ ኤንታ ቦላ ስማናዳነ ኤንታ ምታናዳ ኦስ። ታኒ ግብፀታ ቦላ ኦዳባ ህንተ ህንተ አይፈን በእደታ። ህንተ መላ ቢታን ዳሮ ዎደ ደእደታ። <verse eid="JOS 24:7"/><verse number="8" style="v" sid="JOS 24:8"/>ሄሳፈ ጉየ፥ ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋን ደእያ አሞረታ ቢታ ህንተና ኤሀስ። ኤንቲ ህንተና ኦልዶሶና፥ ሽን ታ ህንተዉ ፆኖ እማስ። ታ ኤንታ ይስን፥ ህንተ ኤንታ ቢታ ላትደታ። <verse eid="JOS 24:8"/><verse number="9" style="v" sid="JOS 24:9"/>ሄሳፈ ጉየ፥ ሞአበ ቢታ ካዎይ፥ ስፎራ ናአይ ባላቅ፥ ደንድድ፥ እስራኤለታራ ኦለትስ። እ ህንተና ባዳና መላ ብኦራ ናኣ፥ ባላማ ፄግስ። <verse eid="JOS 24:9"/><verse number="10" style="v" sid="JOS 24:10"/>ሽን ታ ባላማ ስአብከ፤ እ ህንተና አንጃና መላ ኦዳ፥ ህንተና ባላቃ ኩሽያፐ አሻስ። <verse eid="JOS 24:10"/><verse number="11" style="v" sid="JOS 24:11"/>ህንተ ዮርዳኖሰ ሻፋ ፕንድ፥ እያርኮ ይደታ። እያርኮ አሳይ፥ አሞረት፥ ፓርዘት፥ ካናነት፥ ህተት፥ ገርገሰት፥ ህወትነ ያቡሰት ህንተራ ኦለታናዉ ደንድዶሶና፥ ሽን ታ ህንተና ፆንሳስ። <verse eid="JOS 24:11"/><verse number="12" style="v" sid="JOS 24:12"/>ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋን ደእያ ናምኡ አሞረ ካዎታ ቦላ ኦዳይሳዳ፥ ካዠ ኪታዳ ኤንታና ህንተ ስንፈ ጎዳ ከሳስ። ሄስ ሀንዳይ፥ ህንተ ማሻና ዎይኮ ህንተ ዶንግያና ግደና። <verse eid="JOS 24:12"/><verse number="13" style="v" sid="JOS 24:13"/>ህንተ ቄፅ ከስቦና ቢታነ ህንተ ኬፅቦና ካታማታ ታኒ ህንተዉ እምን ደኤታ። ሀእ ህንተ ቶክቦና ዎይነ አይፍያነ ሻማሆ አይፍያ ሜታ’ ” ያጌስ።<verse eid="JOS 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 24:14"/>ቃስካ እያሱይ ካልድ፥ “ጎዳ ቦንችተ፤ ፖሎ አማነተንነ ሱረ ዎዛናን እያዉ ኪተትተ። ህንተ ማይዛት ኤፍራፂሳ ሻፋፐ ሄፍንንነ ግብፀን ጎይንዳ ኤቃታ አግድ ጎዳ ጎይንተ። <verse eid="JOS 24:14"/><verse number="15" style="v" sid="JOS 24:15"/>ህንተ ጎዳ ጎይናናዉ ኮዮና እፅኮ፥ ህንተ አዋት ኤፍራፂሳ ሻፋፐ ሄፍንን ደእሸ ጎይንዳ ኤቃታ ግድን፥ ዎይኮ ሀእ ህንተ ደእያ አሞረታ ኤቃታ ግድን፥ ህንተ ጎይናና ፆሳ ሀች ዶርተ። ሽን ታኒ፥ ታ ሶ አሳራ ኑ ጎዳ ጎይናና” ያግስ።<verse eid="JOS 24:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 24:16"/>አሳይ ዛሪድ፥ “ጎዳ አግድ፥ ሀራ ኤቃ ፆሳታ ጎይናናይስ ኑፐ ሃኮ። <verse eid="JOS 24:16"/><verse number="17" style="v" sid="JOS 24:17"/>ኑ ጎዳ ፆሳይ ኑናነ ኑ አዋታ ግብፀ አይለተፈ ከስስ፤ እ ኦዳ ግታ ማላታታ በእዳ። ኑ ካንድ አዳ ቢታ ኡባን ጎዳይ ኑና ናግስ። <verse eid="JOS 24:17"/><verse number="18" style="v" sid="JOS 24:18"/>ጎዳይ አሞረታነ ሄ ቢታን ደእያ ሀራ ካዎተታ ኑ ስንፈ ጎድድ ከስስ። ሄሳ ግሾ፥ እ ኑ ፆሳ ግድያ ግሾ ኑ እያ ጎይናና” ያግዶሶና።<verse eid="JOS 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 24:19"/>እያሱይ ዛሪድ፥ “ጎዳይ ጌሽነ ቃናትያ ፆስ<note caller="+" style="f"><char style="fr" closed="false">24:19 </char><char style="fq" closed="false">ቃናትያ ፆስ፦ </char><char style="ft" closed="false">ፆሳይ ባ ቦንቹዋ ሀራራ ሻከቶና ፆስ ዎይኮ ባርካ ደእያ ዎይኮ ዱማ ፆስ ግደይሳ በሳናሳ።</char></note> ግድያ ግሾ፥ ህንተ እያ ጎይናናዉ ዳንዳኤከታ። እ ህንተ ናቁዋ ዎይኮ ህንተ ናጋራ አቶ ጌና። <verse eid="JOS 24:19"/><verse number="20" style="v" sid="JOS 24:20"/>ህንተ ጎዳስ ዞኮ ዛሪድ፥ ኤቃ ፆሳታ ጎይንኮ፥ እ ህንተዉ ካሰ ሎኦ ግድኮካ ስሚድ ህንተና ቆሀናነ ይሳና” ያግስ።<verse eid="JOS 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 24:21"/>አሳይ ዛሪድ፥ “ኑ ሀራ ኤቃ ፆሳታ ጎይኖኮ፤ ኑኒ ጎዳ፥ እያ ፃላላ ጎይናና” ያግስ።<verse eid="JOS 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 24:22"/>እያሱይ፥ “ህንተ ጎዳ ጎይናና ግዳይሳስ ህንተ፥ ህንተ ሁጰን ማርካ” ያግስ።</para>
  <para style="p" vid="JOS 24:22">ኤንትካ፥ “ኤ ኑኒ ማርካ” ያግዶሶና።<verse eid="JOS 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 24:23"/>እያሱይ ዛሪድ፥ “ህንተ ግዶን ደእያ ኤቃ ፆሳታ ድግተ፤ ህንተ ዎዛና ጎዳኮ፥ እስራኤለ ፆሳኮ ዛርተ” ያግስ።<verse eid="JOS 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 24:24"/>ኤንትካ፥ “ኑኒ ጎዳ፥ ኑ ፆሳ ጎይናና፤ እያ ኪታ ናጋና” ያግዶሶና።<verse eid="JOS 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 24:25"/>ሄ ጋላስ እያሱይ፥ ሴከማን አሳይ ፆሳራ ጫቃና መላ ኦስ። ኤንቲ ካላና ህግያ ኤንታዉ ጊግስድ፥ <verse eid="JOS 24:25"/><verse number="26" style="v" sid="JOS 24:26"/>ህገ ማፃፋን ፃፍስ። ሄሳፈ ጉየ፥ እስ ግታ ሹች ኤክድ፥ ጎዳ ዱንካንያ ማታን ደእያ ዎላ ጋርሳን ኤስስ። <verse eid="JOS 24:26"/><verse number="27" style="v" sid="JOS 24:27"/>እያሱይ አሳኮ፥ “ሀ ሹቻ በእተ፤ እ ኑ ቦላ ማርካ። ጎዳይ ኑስ ኦድዳባ ኡባ ሀ ሹቻይ ስእስ። ህንተ ፆሳ ቦላ ማካልኮ፥ ሀ ሹቻይ ህንተ ቦላ ማርካ ግዳና” ያግስ።<verse eid="JOS 24:27"/></para>
  <para style="s1">እያሱነ አላዛራ ሀይቁዋ</para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 24:28"/>ያትድ፥ እያሱይ አሳ ኡባ ሞይዝስ። አሳ ኡባይ ባንታ ላታ ቢታ ስሚድ ብዶሶና። <verse eid="JOS 24:28"/><verse number="29" style="v" sid="JOS 24:29"/>ጎዳ አይለይ፥ ናወ ናኣ እያሱይ ፄታነ ታሙ ላይን ሀይቅስ። <verse eid="JOS 24:29"/><verse number="30" style="v" sid="JOS 24:30"/>አሳይ እያ ጋኣሳ ዙማፐ ፑደሀ ባጋን፥ ደረይ ዳርያ ኤፍሬማን ደእያ እያ ላታ ቢታን፥ ትምናት-ሳራን እያ ሞግዶሶና።<verse eid="JOS 24:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 24:31"/>እያሱይ ፓፃ ደእዳ ዎደ ኡባን እስራኤለ አሳይ ጎዳ ጎይንዶሶና። እያፐ ጉየ፥ ፆሳይ እስራኤለ አሳስ ኦዳ ኦሶ ኡባ ባንታ አይፈን በእዳ ጭማታ ዎደ ኡባን ጎዳ ጎይንዶሶና።<verse eid="JOS 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 24:32"/>እስራኤለ አሳይ ግብፀ ቢታፈ ኤክ ከይዳ፥ ዮሰፋ መቀ ሴከማን ሞግዶሶና። ሄ በሳ ያይቆብ ሴከማ አዋ ሀሞራ ናይታፐ እስ ፄቱ ብራ ሳንትመን ሻምስ። ሄ ቢታ ጉየፐ ዮሰፋ ኮቻይ ላትዶሶና።<verse eid="JOS 24:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 24:33"/>አሮና ናአይ አላዛር ሀይቅድ፥ እያ ናኣ ፕንሃሳስ እመትዳ ደረይ ዳርያ ኤፍሬማ ቢታን ደእያ ግብአን ሞገትስ።<verse eid="JOS 24:33"/></para>
  <chapter eid="JOS 24"/>
</usx>
