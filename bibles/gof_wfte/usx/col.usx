<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="COL" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ቆላስያሳ ኪታ</para>
  <para style="toc1">ቆላስያሳ ኪታ</para>
  <para style="toc3">ቆላ</para>
  <para style="toc2">ቆላስያሳ</para>
  <para style="mt1">ጳዉሎስ ቆላስያሳ አሳስ</para>
  <para style="mt2">ፃፍዳ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ጳዉሎስ ቆላስያሳ አሳስ ፃፍዳ ኪታይ ፃፈትዳይ፥ ጉ ኢሰን፥ ኤፈሶናፐ ዶሎሀ ባጋራ ደእያ ቆላስያሳ ካታማን ደእያ ዎሳ ኬሳ። ሄ ዎሳ ኬ ኤስዳይ ጳዉሎሳ ግዶና እፅኮካ፥ ሮመ ቢታን ኢሰ ዋና ካታማ ግድዳ ኤፈሶናፐ ዎንገላ ኦድያ አሳ ኪተይ እያ ግድያ ግሾ፥ ቆላስያሳስካ እያዉ አዋተ ደኤስ። ቆላስያሳ ዎሳ ኬን፥ “ፆሰ ኤራናዉነ ኩመ አቶተ ደማናዉ አስ ኡባይ አያና ዎልቃታነ ማታታ ጎይናናዉ ኮሼስ” ግያ ዎርዶ አስታማረት ደኤይሳ ጳዉሎስ ስእስ። ሄ አስታማረት ታማርስያ ሀራባይ ቃስ፥ “አስ ኡባይ ቃፃሮ ዳንያ ዎጋታስ ሃረታናዉነ ካ ዎጋ ኡባ ናጋናዉ ኮሼስ” ያጎሶና።</para>
  <para style="ip">ጳዉሎስ ሀ ኪታ ፃፍዳይ፥ ቱማ አማኖ ትምርትያ ታማርስድ፥ ኤንታ ዎርዶ ትምርትያ ላላናሳ። እ ዛርዳ ዛሮታፐ እሶይ፥ “የሱስ ክርስቶሲ ኩመ አቶተ እሜስ፤ ሀራ ሀይማኖተትነ ኦሶት እያፐ ሃሶሶና” ያጌስ። ፆሳይ ክርስቶሳ ባጋራ አላምያ መስ፤ ቃስ እያ ባጋራ ዛሪድ ባኮ ኤሀና። ሀ አላምያስ አቶተ ኡፋይስ ደኤይ ክርስቶሳ አማኖና። ሄሳ ግሾ፥ ጳዉሎስ ሀ ግታ ትምርተይ አማንያ አሳ ደኦን ዋንድ ኦሶን ፔአናዉ በሲያኮ ኦዴስ። ሀ ኪታይነ ኤፈሶና አሳስ ፃፍዳ ኪታይ፥ ባንታ ኦይክዳ ቆፋንነ ኪታን ዎል ዳኖሶና። ሀ ናምኡ ማፃፋታ ግዶን ደእያ ዱማተይ፥ ኤፈሶናን ክርስቶስ ዎሳ ኬስ ሁጰ፥ ቆላስያሳን ክርስቶስ መተስ ሁጰ።</para>
  <para style="ip">ሀ ኪታ ጳዉሎሳፐ ኤክድ ቆላስያሳ ጋናዉ ብዳ ትክቆሳራ እስፈ ደኤይ አናስሞሳ ግደይሳ ኤርሶይ ማድያባ። አይስ ጊኮ፥ ጳዉሎስ አናስሞሳ ጌተትያ ባ ኦሳንቹዋባ ፍልሞናስ ሀራ ኪታ ፃፍስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ገሎ ቆፋ (<char style="ior"><ref loc="COL 1:1-8">1:1-8</ref></char>)</para>
  <para style="io1">ጋላታ ዎሳ (<char style="ior"><ref loc="COL 1:3-8">1:3-8</ref></char>)</para>
  <para style="io1">ክርስቶስ ኦነ (<char style="ior"><ref loc="COL 1:9-2:19">1:9—2:19</ref></char>)</para>
  <para style="io1">ክርስቶሳን ደእያ ኦራ ደኦ (<char style="ior"><ref loc="COL 2:20-4:6">2:20—4:6</ref></char>)</para>
  <para style="io1">ኩሻ ቆፋነ ሳሮ (<char style="ior"><ref loc="COL 4:7-18">4:7-18</ref></char>)</para>
  <chapter number="1" style="c" sid="COL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1"/>ፆሳ ሸነን ክርስቶስ የሱሳ ሀዋረ ግድዳ ጳዉሎስነ ኑ እሻ ፅሞትዮስ፥ <verse eid="COL 1:1"/><verse number="2" style="v" sid="COL 1:2"/>ቆላስያሳ ካታማን ደእያ ክርስቶሳን ጌሻታስነ አማነትዳ አሳስ ፃፍዳ ኪታ።</para>
  <para style="p" vid="COL 1:2">ፆሳ ኑ አዋፐ አ ኬሀተይነ ሳሮተይ ህንተዉ ግዶ።<verse eid="COL 1:2"/></para>
  <para style="s1">ጋላታ ዎሳ</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3"/>ኑኒ ህንተዉ ዎስያ ዎደ ፆሳ ኑ ጎዳ፥ የሱስ ክርስቶሳ አዋ ኡባ ዎደ ጋላቶስ። <verse eid="COL 1:3"/><verse number="4" style="v" sid="COL 1:4"/>ኑኒ ክርስቶስ የሱሳን ደእያ ህንተ አማኑዋነ ጌሻታ ኡባስ ደእያ ህንተ ሲቁዋ ስእዳ። <verse eid="COL 1:4"/><verse number="5" style="v" sid="COL 1:5"/>ሄሳ ህንተ ኦዳይ ህንተ ኡፋይሳይ ሳሎን ህንተዉ ናገትዳ ግሾሳ። ህንተ ቱማ ኪታ ግድዳ ዎንገላ ኮይሮ አማንዳ ዎደ ሄ ኡፋይሳ ስእደታ። <verse eid="COL 1:5"/><verse number="6" style="v" sid="COL 1:6"/>ህንተ ሄ ዎንገላ ስእዳ ዎደነ ፆሳ አ ኬሀተ ቱማ ሻክ ኤርዳ ዎደፐ ዶምድ ህንተ ግዶን ሀንዳይሳዳ ቢታ ኡባን ድጭሸነ አይፍሸ ደኤስ።<verse eid="COL 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="COL 1:7"/>ህንተ ሄሳ ኑራ እስፈ ክርስቶሳስ ኦያ አማነትዳ፥ ዶሰትዳ ኤጳፍራፐ ታማርደታ።<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 4:12">ቆላ 4:12</ref>፤ <ref loc="PHM 1:23">ፍልሞ 23</ref>.</char></note> <verse eid="COL 1:7"/><verse number="8" style="v" sid="COL 1:8"/>እ ሄሳ ቦላ ጉጅድ አያናይ ህንተዉ እምዳ ሲቁዋባ ኑስ ኦድስ።<verse eid="COL 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9"/>ሄሳ ግሾ፥ ኑኒ ህንተባ ስእዳ ጋላሳፐ ዶምድ፥ ፆሳይ ባ ሸንያ ህንተና በሳና መላነ፥ ጌሻ አያናይ እምያ ኤራተንነ ጭንጫተ ኡባን ህንተና ኩንና መላ ኡባ ዎደ ህንተዉ ፆሳ ዎሶስ። <verse eid="COL 1:9"/><verse number="10" style="v" sid="COL 1:10"/>ሄሳዳካ፥ ህንተ፥ ጎዳይ ኮየይሳዳ ዳና መላ፥ ኡባ ዎደ እያ ኡፋይሳና መላ፥ ሎኦ ኦሶ ኡባን ህንተ አይፈ አይፋና መላነ ፆሳ አድ ኤርሸ ድጫና መላ ፆሳ ዎሶስ።<verse eid="COL 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 1:11"/>ፆሳ ቦንቾ ዎልቃይ ህንተ ኡባባ ገንጫናዳነ ዳንዳአናዳ ባ ምኖተ እምድ ህንተና ኡፋይሶ። <verse eid="COL 1:11"/><verse number="12" style="v" sid="COL 1:12"/>ቃስ ጌሻታ ፖኦ ካዎተ ላታና መላ ህንተና ኦዳ አዋ ጋላትተ። <verse eid="COL 1:12"/><verse number="13" style="v" sid="COL 1:13"/>እ ኑና ማ ዎልቃፈ አሽድ ባ ዶስያ ናኣ ካዎተኮ ኤህስ። <verse eid="COL 1:13"/><verse number="14" style="v" sid="COL 1:14"/>እያን ዎዘትድ እያ ሱን ናጋራ አቶተ ደምዳ።<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="EPH 1:7">ኤፈ 1:7</ref>.</char></note><verse eid="COL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15"/>ክርስቶስ በንቶና ፆሳስ ቱማ ሌምሶ። እ መተ ኡባፈ ባይራ። <verse eid="COL 1:15"/><verse number="16" style="v" sid="COL 1:16"/>ኡባባይ እያ ባጋራ መትስ። በንትያባትነ በንቶናባት፥ ዎልቃትነ ጎዳት፥ ሃረይሳትነ ማታ አዋት፥ ሳሎንነ ሳአን ደእያ ኡባይ እያዉነ እያ ባጋራ መትስ። <verse eid="COL 1:16"/><verse number="17" style="v" sid="COL 1:17"/>እ ኡባባፐ ካሰ ደኤስ። ኡባባይ እያን ባ በሳን በሳን ኦይከትድ ደኤስ። <verse eid="COL 1:17"/><verse number="18" style="v" sid="COL 1:18"/>እ ባ አሳተ ግድዳ ዎሳ ኬስ ሁጰ። እ ኡባፈ ቦላ ግዳናዉ ሀይቆፐ ደንዶን ስንነ ባይራ።<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="EPH 1:22-23">ኤፈ 1:22-23</ref>.</char></note><verse eid="COL 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 1:19"/>ፆሳይ ባ ኩመ ፆሳተራ እያን ዳናዉ ኮይስ። <verse eid="COL 1:19"/><verse number="20" style="v" sid="COL 1:20"/>ቃስ ማስቃልያ ቦላ ጉስዳ ባ ናኣ ሱን ሳሮተ መድ ሳሎንነ ሳአን ደእያ ኡባ እያ ባጋራ ባራ ስገስ።<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="EPH 2:16">ኤፈ 2:16</ref>.</char></note><verse eid="COL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21"/>ሀይሳፈ ካሰ ህንተ ቆፋ ኢታተይ ህንተና ፆሳፈ ሻክስነ እያራ ሞርከ ኦስ፤ ህንተ ኦሶይካ ኢታ። <verse eid="COL 1:21"/><verse number="22" style="v" sid="COL 1:22"/>ሽን ሀእ ክርስቶስ አሾን ሀይቅዳ ሀይቁዋ ባጋራ ፆሳይ ህንተና ባራ ስገድ፥ ጌሻታ፥ ቦረይ ባይናይሳታነ ፅሎታ ኦስ። <verse eid="COL 1:22"/><verse number="23" style="v" sid="COL 1:23"/>ህንተ፥ ህንተ አማኑዋን ቃፆና ምንድነ ፃጵድ ዳናዉ በሴስ። ህንተ ዎንገላ ቃላ ስእዳ ዎደ ኤክዳ ኡፋይሳ ምን ኦይክተ። ሄ ዎንገላይ ህንተ ስእዳይሳነ ቢታ ኡባን ሳባከትዳይሳ። ታ፥ ጳዉሎስካ ሀ ዎንገላስ ኦሳንቾ ግዳስ።<verse eid="COL 1:23"/></para>
  <para style="s1">ጳዉሎሳ ሀዋረተ ኦሶ</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24"/>ታኒ ህንተ ግሾ ሀእ ኤክያ ዋያን ኡፋይታይስ። ክርስቶስ እያ አሳተ ግድዳ ዎሳ ኬስ ኤክዳ ዋይያ ታኒ ታ አሹዋን ፖላይስ። <verse eid="COL 1:24"/><verse number="25" style="v" sid="COL 1:25"/>ፆሳ ቃላ ህንተዉ ፖላዳ ኦዳና መላ ታዉ እመትዳ ማታን ዎሳ ኬስ ኦሳንቾ ግዳስ። <verse eid="COL 1:25"/><verse number="26" style="v" sid="COL 1:26"/>ሀ ቃላይ ካሰ አዳ ዎድያን የለተ ኡባፈ ጌምድ ደእስ። ሽን ሀእ ፆሳይ ሀ ፁራ አማንያ ኡባስ ቆንጭስስ። <verse eid="COL 1:26"/><verse number="27" style="v" sid="COL 1:27"/>ፆሳይ አይሁደ ግዶና አሳ ግዶን ሀ ፁራ ቦንቾ ዱረተ ቆንጭስስ። እካ ቦንቾ ኡፋይስ ግድዳ ህንተ ግዶን ደእያ ክርስቶሳ።<verse eid="COL 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="COL 1:28"/>ሄሳ ግሾ፥ እስ እስ አስ ክርስቶሳን ኩመ አስ ኦድ ሺሻናዉ ጭንጫተ ኡባን አሳ ታማርሶንነ ዞረን ክርስቶሳባ ሳባኮስ። <verse eid="COL 1:28"/><verse number="29" style="v" sid="COL 1:29"/>ፆሳይ ባ ግታ ዎልቃን ታናን ኦያ ግሾ፥ ሀእ ጋካናዉ እያ ዎልቃን ባፀታይስነ ዳቡራይስ።<verse eid="COL 1:29"/></para>
  <para style="b"/>
  <chapter eid="COL 1"/>
  <chapter number="2" style="c" sid="COL 2"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1"/>ታ ህንተዉነ ሎዶቀ ካታማን ደእያ አሳስ፥ ሄሳዳካ ታና አይፈን በእቦና አሳ ኡባስ አይ መላ ባፀትያኮ ህንተ ኤራና መላ ኮያይስ። <verse eid="COL 2:1"/><verse number="2" style="v" sid="COL 2:2"/>ታ ባፀትያ ጋሶይካ ኤንቲ ባንታ ዎዛናን ምንድ፥ ሲቆን ቃሸትድ፥ ፖሎ ግድዳ ኩመ አኬካ ዱረተ ደምድ ፆሳ ፁራ ክርስቶሳ ኤራና መላሳ። <verse eid="COL 2:2"/><verse number="3" style="v" sid="COL 2:3"/>እያን ፆሳይ ምንጅዳ ኤራይነ ጭንጫተ ኡባይ ደኤስ።<verse eid="COL 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4"/>ታ ሄሳ ኦንካ ህንተና ጭሞ ቃላን ባለና መላ ኮያዳ ጋይስ። <verse eid="COL 2:4"/><verse number="5" style="v" sid="COL 2:5"/>ታ ህንተፈ ሃካዳ ደእኮካ አያናን ህንተራ ደአይስ። ህንተ ዱሳ ማራነ ክርስቶሳ ህንተ ምንድ አማነይሳ በአዳ ኡፋይታይስ።<verse eid="COL 2:5"/></para>
  <para style="s1">ክርስቶሳን ኩመ ደኦ</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6"/>ህንተ ጎዳ ክርስቶስ የሱሳ ኤክዳይሳዳ እያን ደእተ። <verse eid="COL 2:6"/><verse number="7" style="v" sid="COL 2:7"/>እያን ፃጶ የድተ፤ እያን ኬፀትተ። ህንተ ታማርዳይሳዳ አማኖን ምንተ፤ ፆሳስ ኩምድ ፓላህዳ ጋላታ እምተ።<verse eid="COL 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8"/>ክርስቶሳፐ ግዶናሽን፥ አሳ ዎጋንነ ሀ አላምያ ጮ ዎጋን ካትዳ ትምርተንነ አሳፐ ይዳ ኤራተን ኦንካ ህንተና ጭም ባለድ ድኦና መላ ናገትተ። <verse eid="COL 2:8"/><verse number="9" style="v" sid="COL 2:9"/>ፆሳ ፆሳተይ ክርስቶሳ አሳተን ኩመ ደኤስ። <verse eid="COL 2:9"/><verse number="10" style="v" sid="COL 2:10"/>ህንተካ ማታስነ ዎልቃ ኡባስ ሁጰ ግድያ ክርስቶሳን ኩምደታ።<verse eid="COL 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11"/>ህንተ ክርስቶሳ አማንድ ቃፃረትደታ። ሄስካ አሳ ኩሸን ግዶናሽን፥ ህንተና ኢታ ሀኖተፈ ድግያ ክርስቶሳን ኦሰትዳ ቃፃረተ። <verse eid="COL 2:11"/><verse number="12" style="v" sid="COL 2:12"/>ህንተ ፃማቀትዳ ዎደ ክርስቶሳራ እስፈ ሞገትድ፥ ክርስቶሳ ሀይቆፐ ደንዳ ፆሳ ዎልቃ አማንድ፥ ክርስቶሳራ እስፈ ደንድደታ።<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ROM 6:4">ሮመ 6:4</ref>.</char></note><verse eid="COL 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="COL 2:13"/>ህንተ፥ ህንተ ናጋራ ግሾነ ህንተ ጬጋ አሳተ ቃፃረቶና ግሾ ሀይቅድ ደእሽን፥ ፆሳይ ህንተ ናጋራ አቶ ግስ። ክርስቶሳራ ህንተዉ ደኦ እሚስ።<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EPH 2:1-5">ኤፈ 2:1-5</ref>.</char></note> <verse eid="COL 2:13"/><verse number="14" style="v" sid="COL 2:14"/>እ ኑና ሞትያነ ኑራ ኤቀትያ፥ ኑ ቦላ ፃፈትዳ አጩዋ ዳክድ ማስቃልያ ቦላ ሽድ ኦገፐ ድግስ።<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="EPH 2:15">ኤፈ 2:15</ref>.</char></note> <verse eid="COL 2:14"/><verse number="15" style="v" sid="COL 2:15"/>ክርስቶስ ዎልቃታነ ማታታ ማስቃልያን ፆንድ፥ ኤንታ ኦላ ዳንጩዋ ብልስድ፥ ድኤትዳ አሳዳ ኤንታ ቆንጨን ዩሽ በስስ።<verse eid="COL 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16"/>ሄሳ ግሾ፥ ምያባን ዎይኮ ኡያባን፥ ባኣለ ጋላስ ዎይኮ አጌን ፄርያ ቃማ ቦንቾን ኦንካ ህንተ ቦላ ፕርዶፎ።<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ROM 14:1-6">ሮመ 14:1-6</ref>.</char></note> <verse eid="COL 2:16"/><verse number="17" style="v" sid="COL 2:17"/>ሀይሳቲ ስንፈ ያናዉ ደእያባታስ ኤሾ፥ ሽን ቱማይ ክርስቶሳ። <verse eid="COL 2:17"/><verse number="18" style="v" sid="COL 2:18"/>ቆፐ ቆሞ አሽከተንነ ኪታንቾ ጎይኖን ጬቀትያ ኦንካ ህንተና ህንተ ዎይቱዋፐ አሾፎ። ሄሳ መላ አስ ባ በእዳ ቆንጨን ናሸትሸ ባ አሾ ቆፋን ጮ ኦቶርቴስ። <verse eid="COL 2:18"/><verse number="19" style="v" sid="COL 2:19"/>ሄሳ መላ አሳስ ሁጰ ግድዳ ክርስቶሳራ ጋሄተ ባዋ። እ አሳተ ኡባ ሻያንነ ከሶን ከሶን ጋ ኦይድ ሙዝድ ድቼስ። ፆሳይ ሄሳ መላ ኦገን አሳተ ኡባስ ድች እሜስ።<note caller="-" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="EPH 4:16">ኤፈ 4:16</ref>.</char></note><verse eid="COL 2:19"/></para>
  <para style="s1">ኦራ ደኦ</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20"/>ህንተ ክርስቶሳራ ሀይቅድ ሀ አላምያ ሃርያ አያናታ ዎልቃፈ ላአ ከይደታ። ያትን፥ አይስ ሻከቶና አሳዳ ግድድ ሀ ዎጋታስ ሀረተቲ? <verse eid="COL 2:20"/><verse number="21" style="v" sid="COL 2:21"/>ሄ ዎጋት፥ “ኦይኮፋ፤ ላጮፋ፤ ቦቾፋ” ጌተተይሳታ። <verse eid="COL 2:21"/><verse number="22" style="v" sid="COL 2:22"/>ሀ ኡባይ አሳ ዎጋነ ትምርተ ግድያ ግሾ ኦሶ ቦላ ፔእዳፐ ጉየ ያና። <verse eid="COL 2:22"/><verse number="23" style="v" sid="COL 2:23"/>ሀ ኪታት ቦንቾነ ጭንጫተ ዳንድ በንታናዉ ዳንዳኦሶና። ሀ ዎጋት ፆሰ ዳሮ ዶስስያባ፥ አሽከነ ህንተ አሳተ ሃርስያባ ዳኖሶና፥ ሽን ኑ ኢታ አሞተ ቦላ ኤንታዉ ዎልቅ ባዋ።<verse eid="COL 2:23"/></para>
  <chapter eid="COL 2"/>
  <chapter number="3" style="c" sid="COL 3"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1"/>ህዛ፥ ህንተ ክርስቶሳራ ሀይቆፐ ደንድዳይሳዳ፥ ፆሳፈ ኡሻቻ ባጋን ኡትዳ ክርስቶስ ደእያ በሳን፥ ሳሎን ደእያባታ ኮይተ።<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ 110:1</ref>.</char></note> <verse eid="COL 3:1"/><verse number="2" style="v" sid="COL 3:2"/>ሳሎን ደኤይሳታ ቦላ ህንተ ቆፋ ዎተፐ አትሽን፥ ሳአን ደእያባታ ቦላ ዎፍተ። <verse eid="COL 3:2"/><verse number="3" style="v" sid="COL 3:3"/>ህንተ ሀይቆን ሻከትዳ መላ ሀ አላምያፐ ሻከትደታ። ህንተ ደኦይ ክርስቶሳራ እስፈ ፆሳን ጌምስ። <verse eid="COL 3:3"/><verse number="4" style="v" sid="COL 3:4"/>ህንተዉ ደኦ ግድዳ ክርስቶስ ቆንጭያ ዎደ ሄ ዎደ ህንተካ እያራ ቦንቾን ቆንጫና።<verse eid="COL 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5"/>ሄሳ ግሾ፥ ህንተናን ደእያ አላመ አሞታ ዎተ። ሄሳትካ ላይማተ፥ ቱናተ፥ ላይማታናዉ አሞተ፥ ኤቃ ጎይኖ መላ ግድዳ ኡዘተ። <verse eid="COL 3:5"/><verse number="6" style="v" sid="COL 3:6"/>ሀይሳታ ጋሶን ፆሳ ሀንቆይ ኪተቶና አሳ ቦላ ያና። <verse eid="COL 3:6"/><verse number="7" style="v" sid="COL 3:7"/>ህንተካ ካሰ ሄ ኢታ ኦግያን ብያ አሳ ግዶን ደእሸ ሀይሳታ ኦደታ።<verse eid="COL 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8"/>ሀእ ህንተ ሄሳታ ኦፍተ። ቃስ ሀንቆ፥ እፆ፥ ካች፥ ዝግርስነ ቦርሶ ኦዳ ህንተፈ ድግት። <verse eid="COL 3:8"/><verse number="9" style="v" sid="COL 3:9"/>ጬጋ አሳተ እያ ኦሱዋራ ህንተፈ ቃርዳ ግሾ፥ እሶይ እሱዋስ ዎርዶቶፕተ።<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="EPH 4:22">ኤፈ 4:22</ref>.</char></note> <verse eid="COL 3:9"/><verse number="10" style="v" sid="COL 3:10"/>ፆሳ መ ዳንያ፥ ኤራተን ላመትዳ ኦራ አሳተ ማእተ።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">መ 1:26</ref>፤ <ref loc="EPH 4:24">ኤፈ 4:24</ref>.</char></note> <verse eid="COL 3:10"/><verse number="11" style="v" sid="COL 3:11"/>ሀ ኦራ መተን፥ ግርከ አስ ዎይኮ አይሁደ አስ፥ ቃፃረትዳይ ዎይኮ ቃፃረቶናይ፥ ባርባረ አስ<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="fq" closed="false">ባርባረ አስ፦ </char><char style="ft" closed="false">ጉሳይ ታማርቦና ዎይኮ ኤሮና ዎይኮ የለትዳ መላ ስእ ግድ ደእያ አስ ጉሱ።</char></note> ዎይኮ እስኩተ አስ<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="fq" closed="false">እስኩተ አስ፦ </char><char style="ft" closed="false">ጉሳይ ዎዛና ምኖ አስ ዎይኮ ዎዛና ኢታ አስ ጉሱ።</char></note> አይለይ ዎይኮ ዎማኖይ ባዋ። ክርስቶስ ኡባ፤ እ ኡባን ደኤስ።<verse eid="COL 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12"/>ሄሳ ግሾ፥ ፆሳን ዶረትዳ አሳዳ ጌሻታነ ዶሰትዳይሳታ ግድድ፥ ማሮተ፥ ኬሀተ፥ አሽከተነ ዳንዳአ ማእተ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="EPH 4:2">ኤፈ 4:2</ref>.</char></note> <verse eid="COL 3:12"/><verse number="13" style="v" sid="COL 3:13"/>እሶይ እሱዋ ዳንዳእተ። ኦንካ ባ ላግያን ቆሄትዳባይ ደእኮ እያዉ አቶ ጎ። ጎዳይ ህንተዉ አቶ ግዳይሳዳ ህንተካ ዎልስ አቶ ጊተ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EPH 4:32">ኤፈ 4:32</ref>.</char></note> <verse eid="COL 3:13"/><verse number="14" style="v" sid="COL 3:14"/>ሄ ኡባ ቦላ ኡባባ እስፈ ሺሽድ ቃችያ ሲቆ ማእተ። <verse eid="COL 3:14"/><verse number="15" style="v" sid="COL 3:15"/>ፆሳይ ህንተና እስ አስ ኦድ ፄግዳይ፥ ሳሮተስ ግድያ ግሾ ክርስቶሳ ሳሮተይ ህንተ ዎዛና ሃሮ።<verse eid="COL 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 3:16"/>ክርስቶሳ ቃላይ ህንተ ዎዛናን ኩምድ ደኦ። ጭንጫተ ኡባን እሶይ እሱዋ ታማርስተነ ዞርተ። ማዝሙረን፥ ሳባንነ አያና የን ፆሳ ዎዛናፐ ጋላትሸ የፅተ።<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="EPH 5:19-20">ኤፈ 5:19-20</ref>.</char></note> <verse eid="COL 3:16"/><verse number="17" style="v" sid="COL 3:17"/>ፆሳ አዋ የሱሳ ባጋራ ጋላትሸ ህንተ ኦደትያባ ዎይኮ ኦያባ ኡባ ጎዳ የሱሳ ሱንን ኦተ።<verse eid="COL 3:17"/></para>
  <para style="s1">አማንያ አሳ ዱሱ</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18"/>ማቸቶ፥ አማንያ አሳስ በሲያባ ግድያ ግሾ፥ ህንተ አዝናታስ ሃረትተ።<note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="EPH 5:22">ኤፈ 5:22</ref>፤ <ref loc="1PE 3:1">1 ጰፅ 3:1</ref>.</char></note><verse eid="COL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19"/>አዝናቶ፥ ህንተ ማቸታ ሲቅተ፤ ኤንታዉ ኢቶፕተ።<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="EPH 5:25">ኤፈ 5:25</ref>፤ <ref loc="1PE 3:7">1 ጰፅ 3:7</ref>.</char></note><verse eid="COL 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20"/>ናይቶ፥ ህንተና የልዳይሳታስ ኡባባን ኪተትተ፤ ሄስ ጎዳ ኡፋይስያባ።<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="EPH 6:1">ኤፈ 6:1</ref>.</char></note><verse eid="COL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21"/>አዋቶ፥ ህንተ ናይት ኡፋይስ ቃንፆና መላ ኤንታ ጫመፍተ።<note caller="-" style="x"><char style="xo" closed="false">3:21 </char><char style="xt" closed="false"><ref loc="EPH 6:4">ኤፈ 6:4</ref>.</char></note><verse eid="COL 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22"/>አይለቶ፥ ሳአን ህንተዉ ጎዳ ግድዳይሳታስ ኡባባን ኪተትተ። ጎዳ ቦንችሸ ሱረ ዎዛናፐ ኪተትድ ኤንታ ኡፋይስተፐ አትሽን፥ አስ በኦ ግድ ኦፍተ።<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="EPH 6:5-8">ኤፈ 6:5-8</ref>.</char></note> <verse eid="COL 3:22"/><verse number="23" style="v" sid="COL 3:23"/>ህንተ ኦያ ኦሶ ኡባ አሳስ ግዶናሽን፥ ጎዳስ ኦያ መላ ዎዛናፐ ኦተ። <verse eid="COL 3:23"/><verse number="24" style="v" sid="COL 3:24"/>ጎዳፐ ላታ ዎይቶ ኦድ ህንተ ኤከይሳ ኤርተ፤ ህንተ ጎዳ ክርስቶሳ ሀጋዜታ። <verse eid="COL 3:24"/><verse number="25" style="v" sid="COL 3:25"/>ፆሳይ አሳ ሶምኦ በእድ ፕርዶና ግሾ፥ ኦንካ ኢታ ኦሶ ኦኮ ባ ኢታ ኦሱዋ ግሾ ዛሮ ኤካና።<note caller="-" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="EPH 6:5-8">ኤፈ 6:5-8</ref>.</char></note><verse eid="COL 3:25"/></para>
  <para style="b"/>
  <chapter eid="COL 3"/>
  <chapter number="4" style="c" sid="COL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1"/>ጎዳቶ፥ ህንተዉካ ቃስ ሳሎን ጎዳይ ደኤይሳ ኤርድ፥ ህንተ አይለታስ ፅሎተንነ እሱዋ እሱዋፈ ሻኮና ኮሽያባ ኦተ።<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="EPH 6:9">ኤፈ 6:9</ref>.</char></note><verse eid="COL 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2"/>ፆሳ ባርክድ ጋላትሸ ቃንፆና ዎስተ። <verse eid="COL 4:2"/><verse number="3" style="v" sid="COL 4:3"/>ፆሳይ ባ ቃላስ ፐንገ ዶያና መላነ ታኒ ሄሳ ጋሶን ቃሾን ደእያ ክርስቶሳ ፁራ አዋጃና መላ ኑስካ ዎስተ። <verse eid="COL 4:3"/><verse number="4" style="v" sid="COL 4:4"/>ቃስ ታካ በሰይሳዳ ቃላ ቆንጭሳዳ ኦዳና መላ ታዉ ፆሳ ዎስተ።<verse eid="COL 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5"/>እንጀትያ ዎደ ኡባ ጎኤትሸ አማኖና አሳ ማታን ጭንጫተን ደእተ።<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="EPH 5:16">ኤፈ 5:16</ref>.</char></note> <verse eid="COL 4:5"/><verse number="6" style="v" sid="COL 4:6"/>ህንተ አሳ ኡባስ ኮሽያ ዛሮ እሞ ኤራና መላ ህንተ ኦዳይ ኡባ ዎደ አ ኬሀተን ኩምዳይሳነ ማፅነዳ ማልእያባ ግዳናዉ በሴስ።<verse eid="COL 4:6"/></para>
  <para style="s1">ሳሮ</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7"/>ኑ ሲቆ እሻይ ትክቆስ፥ ታራ እስፈ ጎዳ ኦሱዋን አይለ ግድዳ፥ አማነትያ ኦሳንቾይ፥ ታ ደኡዋባ ህንተዉ ኦዳና።<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሀዋ 20:4</ref>፤ <ref loc="2TI 4:12">2 ፅሞ 4:12</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="EPH 6:21-22">ኤፈ 6:21-22</ref>.</char></note> <verse eid="COL 4:7"/><verse number="8" style="v" sid="COL 4:8"/>ታኒ እያ ህንተኮ ኪትዳይ፥ ኑ ዋንድ ደእያኮ ህንተዉ ኦድድ ህንተና ምንና መላሳ። <verse eid="COL 4:8"/><verse number="9" style="v" sid="COL 4:9"/>አናስሞስ፥ አማነትያ ሲቆ እሻይ፥ ህንተ ባጋይ፥ እያራ ህንተኮ ቤስ። ኤንቲ ሀይሳን ሀንያባ ኡባ ህንተዉ ኦዳና።<note caller="-" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="PHM 1:10-12">ፍልሞ 10-12</ref>.</char></note><verse eid="COL 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10"/>ታራ ቃሸትዳ አርስፅሮኮስነ ባርናባሳ እሻ ናአይ ማርቆስ፥ ህንተና ሳሮ ያጎሶና። ታ ህንተዉ ካሰ ኦድዳይሳዳ ማርቆስ ህንተኮ ቢኮ እያ ሞክተ።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ሀዋ 19:29</ref>፤ <ref loc="ACT 27:2">27:2</ref>፤ <ref loc="PHM 1:24">ፍልሞ 24</ref>፤ <ref loc="ACT 12:12">ሀዋ 12:12</ref>፥ <ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13:13</ref>፤ <ref loc="ACT 15:37-39">15:37-39</ref>.</char></note> <verse eid="COL 4:10"/><verse number="11" style="v" sid="COL 4:11"/>የሱሳ ጌተትያ ያስፆስ ህንተና ሳሮ ሳሮ ያጌስ። ፆሳ ካዎተ ግሾ ታራ ኦያ አሳታ ግዶፈ አይሁደ ግድዳይሳት ሀ ሄታ፤ ኤንቲ ታና ዳሮ ምንዶሶና።<verse eid="COL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12"/>ህንተ ባጋይ፥ ክርስቶስ የሱሳ አይለይ፥ ኤጳፍር ህንተና ሳሮ ሳሮ ያጌስ። እ ህንተ ፆሳ ስንን ምንድ ኤቃናዳነ ፆሳ ሸንያ ኤርድ ፖላና መላ ኡባ ዎደ ፆሳ ህንተ ግሾ ዎሴስ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="COL 1:7">ቆላ 1:7</ref>፤ <ref loc="PHM 1:23">ፍልሞ 23</ref>.</char></note> <verse eid="COL 4:12"/><verse number="13" style="v" sid="COL 4:13"/>እ ህንተ ግሾነ ሎዶቀንነ ህራፖልሳ ካታማን ደእያ አሳ ግሾ ዳሮ ዳቡርዳይሳ ታ ማርካታይስ።<verse eid="COL 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="COL 4:14"/>ኑ ሲቆ እሻይ ዶቶረይ ሉቃስነ ዴማስ፥ ህንተና ሳሮ ሳሮ ያጎሶና።<note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="2TI 4:10-11">2 ፅሞ 4:10-11</ref>፤ <ref loc="PHM 1:24">ፍልሞ 24</ref>.</char></note> <verse eid="COL 4:14"/><verse number="15" style="v" sid="COL 4:15"/>ሎዶቀን ደእያ ኑ እሻታስ፥ ንምፋስነ እ ኬን ሺቅያ አሳስ ኑ ሳሮዋ ኦድተ።<verse eid="COL 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 4:16"/>ሀ ዳብዳብያ ህንተ ናባብዳፐ ጉየ፥ ሎዶቀ ዎሳ ኬን ናባብስተ። ህንተካ ሎዶቀ ዎሳ ኬይ ህንተዉ የድያ ዳብዳብያ ናባብተ። <verse eid="COL 4:16"/><verse number="17" style="v" sid="COL 4:17"/>ቃስ አርክጳሳ፥ “ጎዳይ ነዉ እምዳ ኦሱዋ ፖላናይሳ ዶጎፓ” ያግድ ቆፍስተ።<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="PHM 1:2">ፍልሞ 2</ref>.</char></note><verse eid="COL 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18"/>ታኒ፥ ጳዉሎስ፥ ሀ ሳሮዋ ታ ኩሸን ፃፋስ። ታ ቃሹዋ ቆፕተ።</para>
  <para style="p" vid="COL 4:18">ፆሳ አ ኬሀተይ ህንተራ ግዶ።<verse eid="COL 4:18"/></para>
  <chapter eid="COL 4"/>
</usx>
