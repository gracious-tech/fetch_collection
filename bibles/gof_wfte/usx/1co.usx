<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">1 ቆሮንቶሳ ኪታ</para>
  <para style="toc1">1 ቆሮንቶሳ ኪታ</para>
  <para style="toc3">1 ቆሮ</para>
  <para style="toc2">1 ቆሮንቶሳ</para>
  <para style="mt1">ጳዉሎስ ቆሮንቶሳ አሳስ</para>
  <para style="mt2">ፃፍዳ ኮይሮ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ጳዉሎስ ቆሮንቶሳ አሳስ ፃፍዳ ኮይሮ ኪታይ ፃፈትዳይ፥ ጳዉሎስ ቆሮንቶሳን ኤስዳ ዎሳ ኬን አማንያ አሳ ደኦንነ አማኖ ቦላ ደንድዳ መቱዋስ ዛሮ እማናሳ። ሄ ዎደ ቆሮንቶሳ ካታማይ፥ ዱማ ዱማ አሳይ ደእያ ግርከ ካታማነ አካያ ቢታስ ዋና ካታማ። ቆሮንቶሳ ካታማይ ዛልኤን ኤረትዳ፥ ዎጋን ምንዳ፥ ዱማ ዱማ ኢታ ደኦን ዳልግዳነ ሀይማኖተ ዳሮተን ኤረትዳ ቢታ።</para>
  <para style="ip">ሀ ኪታን፥ ሀዋረይ ምንድ ኦደይ፥ ቆሮንቶሳ ዎሳ ኬን መትዳ ሻሄተባ፥ ዱማ ዱማ ኢታ ደኦባ፥ ላይማተባ፥ ኤኮ ገሎባ፥ ጌሻ አያና እሞታታባነ ሀይቆፐ ደንዶባ። የሱስ ክርስቶሳ ዎንገል ሀ ኦይሻታ ዋትድ ዛርያኮ ሀዋረይ ምንድ ኦዴስ።</para>
  <para style="ip">ጳዉሎስ፥ ሸምፖ ታማነ ሄን፥ ሲቆይ አማኖፐ፥ ኡፋይሳፈነ ዱማ ዱማ ጌሻ አያና እሞታታፐ ኦዴስ። አማንያ አሳይ እሶይ እሱዋ ሲቅያባ ግድኮ፥ ዎሳ ኬን መትያ መቶት ቃንን ስሜስ። ሲቆይ ይኮ፥ ፓላም፥ ሻከተ፥ እፆይነ ሄሳ ሄሳ መላባት ዳሬስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ገሎ ቆፋ (<char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref></char>)</para>
  <para style="io1">አማንያ አሳ ግዶን መትዳ ሻከተ (<char style="ior"><ref loc="1CO 1:9-4:21">1:9—4:21</ref></char>)</para>
  <para style="io1">ላይማተነ እሶይ እሱዋራ ስጋ ደኦ (<char style="ior"><ref loc="1CO 5:1-7:40">5:1—7:40</ref></char>)</para>
  <para style="io1">ኤቃ አግድ ፆሰ ቦንቾ (<char style="ior"><ref loc="1CO 8:1-11:1">8:1—11:1</ref></char>)</para>
  <para style="io1">ዎሳ ኬነ ጎይኖ ዎጋ (<char style="ior"><ref loc="1CO 11:2-14:40">11:2—14:40</ref></char>)</para>
  <para style="io1">ክርስቶስ ሀይቆ ፆንድ ደንድስ (<char style="ior"><ref loc="1CO 15:1-58">15:1-58</ref></char>)</para>
  <para style="io1">መቶተትዳ አሳስ እመትያ እሞታ (<char style="ior"><ref loc="1CO 16:1-4">16:1-4</ref></char>)</para>
  <para style="io1">ኦገ ቡሳ ሀልቾነ ሳሮ (<char style="ior"><ref loc="1CO 16:5-24">16:5-24</ref></char>)</para>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>ፆሳ ሸንያን የሱስ ክርስቶሳ ሀዋረ ግዳናዉ ፄገትዳ ጳዉሎስነ፥ ኑ እሻ ሶስተኔስ፥ <verse eid="1CO 1:1"/><verse number="2" style="v" sid="1CO 1:2"/>ቆሮንቶሳን ደእያ ፆሳ ዎሳ ኬስ፥ የሱስ ክርስቶሳን ጌይዳይሳታስነ ጌሽ ግዳና መላ ፄገትዳይሳታስ፤ ቃስ ኤንታዉነ ኑስ ጎዳ ግድያ ኑ ጎዳ የሱስ ክርስቶሳ ሱን ኡባ በሳን ፄግያ ኡባስ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 18:1">ሀዋ 18:1</ref>.</char></note><verse eid="1CO 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3"/>ፆሳይ፥ ኑ አዋይነ ጎዳይ የሱስ ክርስቶሲ ህንተዉ አ ኬሀተነ ሳሮተ እሞ።<verse eid="1CO 1:3"/></para>
  <para style="s1">ጳዉሎስ ፆሰ ጋላቴስ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>ፆሳይ ክርስቶስ የሱሳ ባጋራ ህንተዉ እምዳ አ ኬሀተ ግሾ፥ ታኒ ኡባ ዎደ ፆሳ ጋላታይስ። <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>እያን ኦዳንነ ኤራተ ኡባን ህንተ ዱረትደታ። <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>ታኒ ክርስቶሳባ ማርካትዳይስ ቱማ ግደይሳ ሄስ ቆንጭሴስ። <verse eid="1CO 1:6"/><verse number="7" style="v" sid="1CO 1:7"/>ሄሳ ግሾ፥ ህንተ ኑ ጎዳ የሱስ ክርስቶሳ ዩሳ ናግሸ ደእሽን፥ አይ አያና እሞይካ ህንተዉ ፓጨና። <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>ኑ ጎዳ የሱስ ክርስቶሲ ስምያ ዎደ ህንተ ቦረቶናይሳታ ግዳና መላ ዉርሰ ጋካናዉ እ ህንተና ምንና። <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>ባ ናአ፥ ኑ ጎዳ፥ የሱስ ክርስቶሳራ እስፈተ ዳና መላ ህንተና ፄግዳ ፆሳይ አማነትዳይሳ።<verse eid="1CO 1:9"/></para>
  <para style="s1">ዎሳ ኬን ደእያ ሻከተ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>ታ እሻቶ፥ ህንተ ግዶን ሻከተ ዶና መላነ ህንተ እስ ዎዛናንነ እስ ቆፋን እሶ ግድድ ዳና መላ፥ ኑ ጎዳ የሱስ ክርስቶሳ ሱንን ህንተና ዎሳይስ። <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>ታ እሻቶ፥ ቀሎኤ ሶ አሳይ ህንተ ግዶን ኦሽ ደኤይሳ ታዉ ኦድዶሶና። <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/>ታ ህንተዉ ኦደይስ ሀይሳ፦ ህንተፈ እሶት እሶት፥ “ታኒ ጳዉሎሳሳ፤ ታኒ አጵሎሳሳ፤ ታኒ ጰፅሮሳሳ፤ ታኒ ክርስቶሳሳ” ያጌታ።<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">ሀዋ 18:24</ref>.</char></note> <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>ክርስቶስ ሻከትደዬ? ህንተ ግሾ፥ ማስቃልያ ቦላ ካቀትዳይ ጳዉሎሰዬ? ዎይኮ ህንተ ጳዉሎሳ ሱንን ፃማቀትደትዬ?<verse eid="1CO 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14"/>ታኒ ቃርስጶስነ ጋዮስ አትሽን፥ ህንተፈ ኦናካ ፃማቃቦና ግሾ፥ ፆሰ ጋላታይስ።<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">ሀዋ 18:8</ref>፤ <ref loc="ACT 19:29">ሀዋ 19:29</ref>፤ <ref loc="ROM 16:23">ሮመ 16:23</ref>.</char></note> <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>ሄሳ ግሾ፥ ኦንካ ህንተና ታ ሱንን ፃማቀትደታ ጋናዉ ዳንዳኤና። <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>[ቃስ እስፅፋኖሰ ሶ አሳካ ታ ፃማቅዳይሳ አኬካይስ፥ ሽን ሀራ ኦና ፃማቅዳኮ ሀሳይከ።] <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>ክርስቶስ ታና ኪትዳይ ዎንገላ ኦዳና መላሳፈ አትሽን፥ ፃማቃና መላ ግደና። ክርስቶስ ማስቃለይ ሀዳ ግዶና መላ ታኒ አሳ ጭንጫተ ቃላን ኦድከ።<verse eid="1CO 1:17"/></para>
  <para style="s1">ክርስቶስ ፆሳ ዎልቃነ ጭንጫተ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>ክርስቶሳ ማስቃላ ቃላይ የይሳታስ ኤያተ፥ ሽን ኑስ አተይሳታስ ፆሳ ዎልቃ። <verse eid="1CO 1:18"/><verse number="19" style="v" sid="1CO 1:19"/>ጌሻ ማፃፋን፥</para>
  <para style="q1" vid="1CO 1:19">“ታኒ ጭንጫታ ጭንጫተ ይሳና፤</para>
  <para style="q2" vid="1CO 1:19">አኬካንቾታ አኬካ ባለና”</para>
  <para style="m" vid="1CO 1:19">ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">እሳ 29:14</ref>.</char></note><verse eid="1CO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20"/>ያትን፥ ጭንጭ አዉን ደኢ? ህገ አስታማረይ አዉኔ? ዎይኮ ሀ ሳአ ኤራንቾይ አዉን ደኢ? ፆሳይ ሀ ሳኣ ጭንጫተ ኤያተ ኦቤኔ?<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="JOB 12:17">እዮ 12:17</ref>፤ <ref loc="ISA 19:12">እሳ 19:12</ref>፤ <ref loc="ISA 33:18">33:18</ref>፤ <ref loc="ISA 44:25">44:25</ref>.</char></note><verse eid="1CO 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21"/>ሀ ሳኣ አሳይ ባንታ ጭንጫተን ፆሳ ኤሮና መላ ባ ጭንጫተን ድግድ፥ ኤያተን ታይበትያ፥ ኑኒ ኦድያ ቃላን አማነይሳታ አሻናዉ ፆሳ ሸነ ግድስ። <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>አይሁደት ማላታ በአናዉ ኮዮሶና፤ ቃስ ግርከት ጭንጫተ ኮዮሶና። <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>ሽን ኑኒ ማስቃለ ቦላ ካቀትዳ ክርስቶሳ ሳባኮስ። ሄስ አይሁደታስ በ፤ ቃስ ግርከታስ ኤያተ ግድስ። <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>ሽን ፆሳይ ፄግዳይሳታስ፥ አይሁደ ግድን፥ ግርከ ግድን ክርስቶስ ፆሳ ዎልቃነ እያ ጭንጫተ። <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>ፆሳ ኤያተ አሳ ጭንጫተፈ አስ፤ ቃስ ፆሳ ዳቡራይ አሳ ምኖተፈ ምኔስ።<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>ህዛ፥ ታ እሻቶ፥ ፆሳይ ህንተና ፄግያ ዎደ ህንተ አይ መላ አሴኮ ቆፕተ። አሳ ቆፋን፥ ህንተ ግዶፈ ዳሮት ጭንጫ፥ ዎልቃማነ ቃ ኮቸ ግደከታ። <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>ሽን ፆሳይ ጭንጫታ ዬላያናዉ አላመን ደእያ ኤያታ ዶርስ፤ ቃስ ምኖታ ዬላያናዉ አላመን ደእያ ዳቡራንቾታ ዶርስ። <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>ሀ አላምያን ግታ ጌተትዳባ ይሳናዉ፥ ፆሲ፥ ሀ ሳኣ ካዉሻባ፥ ካትዳባነ ፓናባ ዶርስ። <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>ፆሳ ስንን ኦንካ ጬቀቶና መላ ሄሳ ኦስ። <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>ሽን፥ ህንተዉ ክርስቶስ የሱሳራ እስፈተ ዳና መላ ፆሳይ ሄሳ ኦስ። እ፥ ኑስ ፆሳፈ ጭንጫተ፥ ፅሎተ፥ ጌሻተነ አቶተ ግድስ። <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>ሄሳ ግሾ፥ ጌሻ ማፃፋን፥ “ጬቀትያ ኦንካ ጎዳን ጬቆ” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="JER 9:24">ኤርም 9:24</ref>.</char></note><verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>ታ እሻቶ፥ ታኒ ኮይሮ ፆሳ ቃላ ህንተዉ ኦዳሸ ይዳ ዎደ፥ ዶና ብላተንነ ጭንጫተን ያቢከ። <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>ታኒ ህንተራ ደእያ ዎደ ማስቃልያ ቦላ ካቀትዳ የሱስ ክርስቶሳፐ አትሽን፥ ሀራባ ኤራናዉ ኮይከ ጋዳ ታ ቆፋ ቃቻስ። <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/>ታ ህንተራ ደእያ ዎደ ዳቡራን፥ ያሻንነ ዳሮ ኮኮርሳን ደአስ።<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ACT 18:9">ሀዋ 18:9</ref>.</char></note> <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>ታ ኪታይነ ታ ትምርተይ ዶና ብላተንነ ጭንጫተን ግዶናሽን፥ ጌሻ አያና ዎልቃ ቆንጭሰና። <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>ሄስካ፥ ህንተ አማኖይ ፆሳ ዎልቃናፐ አትሽን፥ አሳ ጭንጫተን ዘምፖና መላሳ።<verse eid="1CO 2:5"/></para>
  <para style="s1">ፆሳ ጭንጫተ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>አያና ደኦን ድጭዳይሳታስ ኑኒ ጭንጫተ ቃላን ኦዶስ። ሽን ሄ ጭንጫተይ፥ ሀ ሳአ ጭንጫተ ዎይኮ ያናዉ ደእያ ሀ ሳአ ሃረይሳታ ጭንጫተ ግደና። <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>ሽን ኑኒ ኦድያ ጭንጨተይ፥ ዳሮ ዎደፐ ስን ፆሳይ ኑ ቦንቹዋስ ጊግስዳይሳነ ጌምድ ደእያ ፁራ ጭንጫተ። <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>ሀ ሳኣ ሃረይሳታፐ ኦንካ ሀ ጭንጫተ ኤርቦኮና። ኤንቲ ኤርዳባ ግድያኮ፥ ቦንቾ ጎዳ ማስቃልያ ቦላ ካቆኮና። <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>ሽን ጌሻ ማፃፋን፥</para>
  <para style="q1" vid="1CO 2:9">“አይፈይ በእቦናባ፥</para>
  <para style="q2" vid="1CO 2:9">ሀይ ስእቦናባ፥</para>
  <para style="q2" vid="1CO 2:9">ዎዛን ቆፕቦናባ፥</para>
  <para style="q2" vid="1CO 2:9">ፆሳይ ባና ዶሰይሳታስ ጊግስስ” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">እሳ 64:4</ref>.</char></note><verse eid="1CO 2:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10"/>ፆሳይ ባ ፁራ ባ አያና ባጋራ ኑስ ቆንጭስስ። ጌሻ አያናይ ሀር አቶሽን፥ ጌምዳ ፆሳ ፁራ ኡባ ፕልጌስ። <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>አሳን ደእያ አሳ አያናፐ አትሽን፥ አሳባ ኦንካ ኤረና። ሄሳዳካ፥ ፆሳባ፥ ፆሳ አያናፐ አትሽን፥ ኦንካ ኤረና። <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>ፆሳይ ኑስ ጮ እምዳባ ኑ ኤራና መላ ፆሳ አያና ኤክዳፐ አትሽን፥ ሀ ሳአ አያና ኤክቦኮ።<verse eid="1CO 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13"/>ኑኒ አያናባ፥ አያና አሳታስ አሳ ጭንጫተን ግዶናሽን፥ ፆሳ አያናይ እምያ ጭንጫተን ታማርሶስ። <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>ጌሻ አያን ባይና አስ ፆሳ አያና እሞታታ ኤከና። ሄስ እያዉ ኤያተ፤ ኡባይ ጌሻ አያናን ፕልገትያ ግሾ፥ እ ኤራናዉ ዳንዳኤና። <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>ጌሻ አያን ደእያ አስ ኡባባ ፕልጌስ፥ ሽን እያ ኦንካ ፕልገና። <verse eid="1CO 2:15"/><verse number="16" style="v" sid="1CO 2:16"/>ጌሻ ማፃፋን፥</para>
  <para style="q1" vid="1CO 2:16">“ጎዳ ዎዛና ኤረይ ኦኔ?</para>
  <para style="q2" vid="1CO 2:16">እያ ዞራናዉ ዳንዳኤይ ኦኔ?”</para>
  <para style="m" vid="1CO 2:16">ጌተትድ ፃፈትዳይሳ መላ። ሽን ኑስ ክርስቶሳ ዎዛን ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">እሳ 40:13</ref>.</char></note><verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s1">ዎሳ ኬን ደእያ ሻከተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>ታ እሻቶ፥ ህንተ ክርስቶሳን ቡሮ ዮጋነ አማኖና አሳ ደእያ ግሾ፥ ታኒ አያናባ ህንተዉ ኦዳናዉ ዳንዳአብከ። <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>ህንተ ምኖ ካ ማናዉ ዳንዳእቦና ግሾ፥ ታኒ ህንተና ማ ፓሀስ፤ ሀእካ ዳንዳእቤከታ።<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="HEB 5:12-13">እብራ 5:12-13</ref>.</char></note> <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>ሀእካ ህንተ አማኖና አሳዳ ደኤታ። ህንተ ግዶን ደእያ ቃናተይነ ኦሽ ህንተ አማኖና አሳዳ ደኤይሳ ኤርሰኔ? ህንተ አማኖና አሳዳ ሀኔታ። <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>ህንተፈ እሶይ፥ “ታኒ ጳዉሎሳሳ” ሀራይ ቃስ፥ “ታኒ አጵሎሳሳ” ጊኮ፥ አማኖና አሳ መላ ግደከቲ?<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2CO 1:12">2 ቆሮ 1:12</ref>.</char></note><verse eid="1CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5"/>ያትን፥ አጵሎስ ኦኔ? ጳዉሎስ ኦኔ? ኑኒ ህንተና አማንዳ ፆሳ ኦሳንቾታ። ፆሳይ እሱዋስ እሱዋስ እምዳ እሞታ መላ ኦያ ኦሳንቾታ ግዶኮናዬ? <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/>ታኒ ቶካስ፤ አጵሎስ ሃ ኡሽስ፥ ሽን ድቸይ ፆሰ።<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">ሀዋ 18:4-11</ref>፥ <ref loc="ACT 18:24-28">24-28</ref>.</char></note> <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>ሄሳ ግሾ፥ ድችያ ፆሳፈ አትሽን፥ ቶከይካ ሃ ኡሸይካ አይኮካ ግደና። <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>ቶከይነ ሃ ኡሸይ ዎል መላ፥ ሽን እሶይ እሶይ ባ ኦሱዋ መላ ፆሳይ እምያ ዎይቱዋ ኤካና። <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>ኑኒ እስፈ ፆሳስ ኦያ እያ ኦሳንቾታ ግድያ ግሾ፥ ህንተ ፆሳ ሾቃ፤ ፆሳ ኬ። <verse eid="1CO 3:9"/><verse number="10" style="v" sid="1CO 3:10"/>ፆሳይ ታዉ እምዳ አ ኬሀተ መላ ሂላንቾ አናፀዳ ባሶ የጋስ። ሀራ አስ እያ ቦላ ኬፄስ። ሽን እያ ቦላ ኬፅያ ኦንካ ዋትድ ኬፅያኮ፥ ባዉ ናገቶ። <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>እስ ቶሆ የገትዳ ባሶፐ ሀራ ባሶ የጋናዉ ኦንካ ዳንዳኤና። ሄ ባሶይካ የሱስ ክርስቶሳ። <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>ሽን ሀ ባሱዋ ቦላ ኦንካ ዎርቃን ዎይኮ ብራን ግድን፥ አልኦ ሹቻን ዎይኮ ምን ግድን፥ ማታን ዎይኮ ማቃን ኬፅኮ፥ <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>እስ እስ አስ ሄ ባሱዋ ቦላ አይብን ኬፅዳኮ ፕርዳ ጋላስ ታማን ፓጨትድ ቆንጫና። <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>ኦንካ ሄ ባሱዋ ቦላ ኬፅዳ ኬይ ታማን ፁገቶና አትኮ፥ ባ ዎይቱዋ ኤካና። <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>ሽን ኦደ ኦሶይካ ታማን ፁገትኮ፥ ሄ ኡራስ ዎይቶይ ባዋ። ግዶሽን፥ እ ባ ሁጰን ታማፐ ከስ ኤክዳ አሳዳ አታና።<verse eid="1CO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16"/>ህንተ ፆሳ ኬ ግደይሳነ ፆሳ አያን ህንተናን ደኤይሳ ኤረከቲ? <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>ኦንካ ፆሳ ኬ ላልኮ፥ ፆሲ እያ ላላና። ፆሳ ኬ ጌሽ፤ ሄ ኬይካ ህንተና።<verse eid="1CO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18"/>ኦንካ ባና ጭሞፎ። ሀ ሳኣ ጭንጫተን ባና ጭንጫ ኦድ ኤክያ ኦንካ ፆሳ ስንን ጭንጫ ግዳናዉ ኤያ ግዶ። <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>ሀ ሳአ ጭንጫተይ ፆሳ ስንን ኤያተ። ጌሻ ማፃፋን፥</para>
  <para style="q1" vid="1CO 3:19">“ፆሳይ ጭንጫታ ኤንታ ገነ ቆፋን ኦይኬስ” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="JOB 5:13">እዮ 5:13</ref>.</char></note><verse eid="1CO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CO 3:20"/>ቃስ፥ “ጭንጫታ ቆፋይ ማዶናባ ግደይሳ ጎዳይ ኤሬስ” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">ማዝ 94:11</ref>.</char></note><verse eid="1CO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 3:21"/>ሄሳ ግሾ፥ ኡባይ ህንተባ ግድያ ግሾ፥ ኦንካ አሳን ጬቀቶፎ። <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>ጳዉሎስ፥ አጵሎስነ ጰፅሮስ፥ ሀ አላመይ፥ ደኦይ፥ ሀይቆይ፥ ሀእ ደኤይ፥ ስንፈ ያናይስ፥ ኡባይ ህንተሳ። <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>ህንተ ክርስቶሳሳ፤ ክርስቶስ ፆሳሳ።<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s1">ክርስቶሳ ሀዋረታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>አሳይ ኑና ክርስቶሳ አይለዳነ ፆሳ ፁራ ቆንጭሳናዉ ሀዳር እመትዳ አሳዳ ኦድ ቆፖ። <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>ሀዳራ ኤክዳ አሳት ባንታ ጎዳስ አማነትዳይሳታ ግዳናዉ በሴስ። <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>ሽን ህንተ ዎይኮ ሀር ታና ፕርድኮ፥ ታዉ አይኮካ ግደና። ሀር አቶሽን፥ ታካ ታ ቦላ ፕርድከ። <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>ታ ካሀይ ጌሽ፥ ሽን ሄስ ታኒ ፖሎ ፅሎ ግደይሳ በሰና። ታ ቦላ ፕርዳናይ ጎዳ ፃላላ። <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>ሄሳ ግሾ፥ ዎደይ ጋኮና፥ ጎዳይ ዮና ኦደ ቦላካ ፕርዶፍተ። እ ማን ጌምዳባ ፖኦን ከሰና፤ አሳ ዎዛናን ቆሰትዳ ቆፋ ቆንጭሳና። ሄ ዎደ፥ እሶይ እሶይ ፆሳፈ ጋላታ ኤካና።<verse eid="1CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6"/>ታ እሻቶ፥ ህንተ ግሾ፥ ታናነ አጵሎሳ፥ ህንተዉ ሌምሶ ኦዳ ኦዳስ። ሄሳ ታ ኦዳይ፥ “ፃፈትዳይሳፈ አፋ” ግያ ዞርያ ህንተ ኑፐ ታማራና መላሳ። ሄሳ ግሾ፥ ኦንካ እሱዋ ሳብድ ሀንኩዋ ካናዉ በሰና። <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>ነ ሀራታፐ አይብን አይ? ኔኒ ኤካቦናባይ አይብ ደኢ? ኔኒ ኤክዳባ ሀራ አሳፐ ኤክዳ ግድኮ፥ ያትን፥ ኤክቦና አሳዳ አይስ ጬቀታይ?<verse eid="1CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8"/>ሀእ ህንተ ካልደታ። ሀእ ህንተ ዱረትደታ። ኑኒ ባይና ህንተ ፃላላ ካዎትደታ። ህንተ ቱማ ካዎትዳባ ግድያኮ፥ ኑካ ህንተራ ካዎታናሽን። <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>ታዉ፥ ፆሳይ ኑና ሀዋረታ፥ ሀይቆስ ፕርደትዳ አሳዳ፥ አሳ ኡባፈ ኑና ጉየ አዳ ዳኔስ። ኑኒ ሀ አላምያስ፥ ኪታንቾታስነ አሳስ ካሳባ ግድዳ።<verse eid="1CO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 4:10"/>ኑኒ ክርስቶሳ ግሾ ኤያ ግድዳ፥ ሽን ህንተ ክርስቶሳን ጭንጫታ ግድደታ። ኑኒ ዳቡራንቾ፥ ሽን ህንተ ምኖ ግድደታ። ህንተ ቦንቸትደታ፥ ሽን ኑኒ ቶሸትዳ። <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>ሀእ ጋካናዉ ኑ ኮሻቶስ፥ ሳሞቶስ፥ ካሎቶስ፥ ዋቶስ፤ ዳና ሶ ይድ ቶይላቶስ። <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/>ኑኒ ኑ ኩሸን ኦድ አቆስ። ኑና አስ ባድያ ዎደ አንጆስ፤ ኑና ጎድያ ዎደ ዳንዳኦስ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">ሀዋ 18:3</ref>.</char></note> <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>ኑ ቦላ ኢታባ ኦደትያ ዎደ ሎኦ ቃላ ዛሮስ። ኑ ሀእ ጋካናዉ ሀ አላምያ ፕቶነ ዎራ የገትያ ቡረ ግድዳ።<verse eid="1CO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14"/>ታኒ ሄሳ ፃፍዳይ፥ ታ ዶስያ ናይታዳ፥ ህንተና ዞራናዉ ፃፋስፐ አትሽን፥ ዬላያናዉ ግደና። <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>ክርስቶሳን ህንተና ድችያ ታይቦፐ ቦላ ግድዳ ካለይሳት ደእኮካ፥ ህንተዉ ዳሮ አዋት ዶኮና። ታ ህንተና ክርስቶስ የሱሳ ዎንገላን የላስ። <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>ህዛ፥ ህንተ ታና ሌምሶ ኦድ ካላና መላ ህንተና ዎሳይስ።<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="2CO 11:1">2 ቆሮ 11:1</ref>፤ <ref loc="PHP 3:17">ፍልጵ 3:17</ref>.</char></note> <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>ሄሳ ግሾ፥ አማነትዳ፥ ታ ዶስያ፥ ጎዳን ታ ናአ፥ ፅሞትዮሳ ህንተኮ ኪታይስ። እ ዱማ ዱማ በሳን ደእያ ዎሳ ኬን ታኒ ታማርስዳ፥ ክርስቶሳ የሱሳን ደእያ፥ ታ ኦግያ ህንተና ሀሳይሳና።<verse eid="1CO 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18"/>ታኒ ህንተኮ ዮናባ ዳንን፥ ኦቶርትያ እስ እስ አሳት ደኦሶና። <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>ሽን ጎዳይ ጊኮ፥ ማታ ዎደ ታኒ ህንተኮ ባና። ሄ ዎደ ኦቶራንቾታ ሃሳያ ፃላላ ግዶናሽን፥ ኤንታ ዎልቃካ ኤራና። <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>ፆሳ ካዎተይ ኦዳ ግዶናሽን፥ ዎልቃ። <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>ታኒ ህንተኮ ፃምአራ ቦየ ዎይኮ ሲቆራነ አሽከ አያናራ ቦ? አዉሳ ዶረቲ?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s1">አሳ ግዶን ደእያ ዬላያ ኦሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>ህንተ ግዶን ላይማተ ደኤይስ ዝግረቴስ። ሄሳ መላ ላይማተ ሀር አቶሽን፥ አማኖና አሳይካ ኦኮና። ህንተ ግዶን ባ አዋ ማቸራ ቱንዳ አስ ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="DEU 22:30">ዛረ 22:30</ref>.</char></note> <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>ህንተ ሄሳን ቂሮታናዉነ ዬላታናዉ በሰነ፥ ሽን ኦቶርትደታ። ሄሳ መላ ቦርሶባ ኦዳ ኡራ ህንተ ግዶፈ ከሳናዉ በሰኔ?<verse eid="1CO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 5:3"/>ታኒ አሾን ህንተራ ዶና እፅኮካ አያናን ታ ህንተራ ደአይስ። ታኒ ህንተራ ደእያ አሳዳ ሀናዳ ሄሳ መላ ኦሱዋ ኦዳ ኡራ ቦላ ፕርዳስ። <verse eid="1CO 5:3"/><verse number="4" style="v" sid="1CO 5:4"/>ኑ ጎዳ የሱስ ክርስቶሳ ሱንን ህንተ ሺቅያ ዎደ ታኒ አያናን ህንተራ ዳና። ሄሳን ጎዳ የሱስ ክርስቶሳ ዎልቃይ ህንተራ ግዳና። <verse eid="1CO 5:4"/><verse number="5" style="v" sid="1CO 5:5"/>ሄ ኡራ ናጋራ አሾይ<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="fq" closed="false">ናጋራ አሾይ፦ </char><char style="ft" closed="false">ናጋራ መይ ዎይኮ ናጋራ አሳተይ።</char></note> ይድ፥ እያ አያናይ ጎዳ የሱሳ ፕርዳ ጋላሳን አታና መላ እ፥ ፃላሄስ አድ እመቶ።<verse eid="1CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6"/>ህንተ ጬቆይ ሎኦ ግደና። ጉ እርሾይ ሙኑቃ ኡባ ደንይሳ ኤረከትዬ?<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GAL 5:9">ጋላ 5:9</ref>.</char></note> <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>ህንተ ሀእ እርሾይ ባይና ሙኑቃ ግዳና መላ፥ ህንተፈ ናጋራ እርሾ ከስተ። ኑስ ፓስካ ዶርሰ ግድዳ ክርስቶስ ያርሸትስ።<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="EXO 12:5">ከሳ 12:5</ref>.</char></note> <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>ሄስ ግሾ፥ ገነይነ ኢታተ ደእያ እርሾራ ግዶናሽን፥ ቱማተነ ጌሻተ ደእያ ኡይራ ኑ ባልያ ቦንቾስ።<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EXO 13:7">ከሳ 13:7</ref>፤ <ref loc="DEU 16:3">ዛረ 16:3</ref>.</char></note><verse eid="1CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9"/>ታ ካሰ ፃፍዳ ዳብዳብያን ህንተ ላይማትያ አሳራ ጋሄቶና መላ ህንተዉ ኦዳስ። <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>ሄሳ ጉሳይ ሀ አላምያን ደእያ ላይማተይሳታራ ዎይኮ ኡዘታራ ዎይኮ ካይሶታራ ዎይኮ ኤቃ ጎይነይሳታራ ፖሎ ጋሄቶፍተ ጉሱ ግደና። ሄሳ ግድኮ፥ ሀ አላምያፐ ህንተ ከያናዉ በሴስ ሽን አትስ። <verse eid="1CO 5:10"/><verse number="11" style="v" sid="1CO 5:11"/>ሽን አማናይስ ያግሸ ላይማተይሳታራ ዎይኮ ኡዘታራ ዎይኮ ኤቃ ጎይነይሳታራ ዎይኮ ጫየይሳታራ ዎይኮ ማተይሳታራ ዎይኮ ካይሶታራ ጋሄቶፍተ ጋዳ ህንተዉ ኦዳይስ። ሄሳ መላ አሳራ ሀር አቶሽን፥ ካካ ሞፕተ።<verse eid="1CO 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12"/>ዎሳ ኬፈ ካረራ ደኤይሳታ ቦላ ፕርዳናዉ ታና አይበ ጋይ? ዎሳ ኬን ደኤይሳታ ቦላ ህንተ ፕርደከትዬ? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>ሽን ካረራ ደኤይሳታ ቦላ ፆሳይ ፕርዳና። ሄ ኢታባ ኦያ ኡራ ህንተ ግዶፈ ከስተ።<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="DEU 13:5">ዛረ 13:5</ref>፤ <ref loc="DEU 17:7">17:7</ref>.</char></note><verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s1">አሳ ግዶን ደእያ ሞቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>ህንተ ግዶፈ እሶይ እሱዋራ ሞቶይ ደእኮ፥ ሄሳ አማንያ አሳ ስንን ፕርደታናይሳ አግድ፥ አማኖና አሳ ስንን ፕርደታናዉ ዋንድ ቢ? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>አማንያ አሳይ አላመ ቦላ ፕርዳናይሳ ህንተ ኤረከቲ? ያትን፥ ህንተ አላመ ቦላ ፕርድያባ ግድኮ፥ ሀይሳ መላ ጉባ ፕርዳናዉ ዋንድ ዳንዳኤከቲ? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>ኑኒ ኪታንቾታ ቦላ ፕርዳናይሳ ኤረከቲ? ያትን፥ ሀ ሳአ ዱሳባ ቦላ ፕርዳናይስ ህንተና ዋንድ ፆኒ? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>ያትን፥ ሄሳ መላ መቶይ ህንተ ግዶን መትኮ፥ ዎሳ ኬ አይፈን ካትዳ አሳ ስንን ፕርደታናዉ ዋትድ ኤፌቲ? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>ታኒ ህንተና ዬላያናዉ ሄሳ ጋይስ። ህንተ ግዶን ካጨትዳ እሻታ ስገናዉ ዳንዳእያ አኬካ አስ ባዌ? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>ያትን፥ እስ አማንያ እሻይ ሀንኮ አማንያ እሻ ፕርዳ ኬን አማኖና አሳ ስንን ሞታናዉ በሲ?<verse eid="1CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7"/>ህዛ፥ ህንተ እሶይ እሱዋ ሞትያባ ግድኮ ሄስ ህንተ ኩንደ በሴስ። ሄሳፈ ህንተ ቆሄትኮ ኬሄኔ? ህንተ ጭመትኮ ሎኤኔ? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>ሽን ህንተ ዎል ግዶን አማነይሳት፥ እሶይ እሱዋ ቆሄታነ ጭሜታ።<verse eid="1CO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9"/>ጌላት ፆሳ ካዎተ ላቶናይሳ ህንተ ኤረከቲ? ህንተና ጭሞፍተ፤ ላይማተይሳት ዎይኮ ኤቃ ጎይነይሳት ዎይኮ ላመይሳት ዎይኮ አደራ አደራ ጋሄተይሳት፥ <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>ዎይኮ ካይሶት ዎይኮ ኡዘት ዎይኮ ማተይሳት ዎይኮ ጫየይሳት ዎይኮ ቦንቀይሳት ፆሳ ካዎተ ላቶኮና። <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>ህንተፈ እስ እስ አሳት ካሰ ሄሳ መላ። ሽን ሀእ፥ ህንተ ጎዳ የሱስ ክርስቶሳ ሱንንነ ፆሳ አያናን ሜጨትደታ፤ ጌይደታ፤ ፅልደታ።<verse eid="1CO 6:11"/></para>
  <para style="s1">ህንተ አሳተን ፆሰ ቦንችተ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>ህንተ፥ “ኑ ኮይዳባ ኦናዉ ዳንዳኦስ” ያጌታ። ሽን ኡባይ ማደና። “ታኒ ኮይዳባ ኡባ ኦናዉ ዳንዳአይስ” ያጌታ። ሽን አይብካ ታና ሃረና። <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>ህንተ፥ “ካ ኡሎሳ፤ ኡሎይካ ካሳ” ያጌታ። ሽን ፆሲ ኡሎካ ካካ ይሳናይሳ ታ ህንተዉ ኦዳይስ። ኑ አሳተይ ጎዳሳፈ አትሽን፥ ላይማተስ ግደና። ጎዳይካ ኑ አሳተሳ። <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>ፆሳይ ጎዳ ሀይቆፐ ደንዳይሳዳ፥ ኑናካ ሀይቆፐ ባ ዎልቃን ደንና።<verse eid="1CO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15"/>ህንተ አሳተይ ክርስቶሳ አሳተፈ እስ ባጋ ግደይሳ ኤረከቲ? ያትን፥ ታኒ ክርስቶሳ አሳተፈ እስ ባጋ ኤፋዳ ላይማተ አሳተ ግዳና መላ ኦ? ሀነና! <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>ላይማትያ አደይ፥ እ ጋሄትያ ማጫሴራ እስ አሳተ ግደይሳ ኤረከቲ? ጌሻ ማፃፋን፥ “ኤንቲ ናምአይ እስ አሳተ ግዳና” ጌተትድ ፃፈትስ።<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መ 2:24</ref>.</char></note> <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>ሽን ጎዳራ እስፍያ አስ እያራ አያናን እስኖ ግዴስ።<verse eid="1CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18"/>ላይማተፈ ሃክተ። እስ አስ ኦያ ሀራ ናጋር እያ አሳተፈ ካረራ ኦሰቴስ፥ ሽን ላይማትያ አስ ባ አሳተ ቦላ ናጋራ ኦስ። <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/>ህንተ አሳተይ፥ ፆሳይ ህንተዉ እምዳ ህንተናን ደእያ ጌሻ አያና ኬ ግደይሳ ኤረከቲ? ህንተ ህንተባ ግደከታ።<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="2CO 3:16">2 ቆሮ 3:16</ref>፤ <ref loc="2CO 6:16">2 ቆሮ 6:16</ref>.</char></note> <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>ፆሳይ ህንተና ጋተን ሻምስ። ሄሳ ግሾ፥ ህንተ አሳተን ፆሰ ቦንችተ።<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s1">ኤኮ ገሎባ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>ህንተ ታዉ ፃፍዳ ዳብዳብያስ ዛሮይ ሀይሳ። እስ አስ ማጫስ ቦቾና አግኮ ሎኦ። <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>ሽን ላይማተፈ አታናዉ እስ እስ አደይ ማቾ ኤኮ፤ ቃስ እስ እስ ማጫሳስ አዝን ደኦ።<verse eid="1CO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 7:3"/>አዝናይ ባ ማቼስ፥ ቃስ ማችያ ባ አዝናስ በሲያባ ኩን። <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>ማቼስ ባ አሳተ ቦላ ማት ባዋ፥ ሽን ማት እ አዝናሳ። ሄሳዳካ፥ አዝናስ ባ አሳተ ቦላ ማት ባዋ፥ ሽን ማት ማቸሳ። <verse eid="1CO 7:4"/><verse number="5" style="v" sid="1CO 7:5"/>ህንተ ዎሳን ጉ ዎደ ጋምአናዉ ዞረተን ግዶና እፅኮ፥ እሶይ እሱዋ ድጎፍተ። ሄሳ ጋሶን ህንተናተ ሃራናዉ ፆነትን፥ ፃላሄይ ህንተና ፓጮና መላ እስፈ ደእተ። <verse eid="1CO 7:5"/><verse number="6" style="v" sid="1CO 7:6"/>ሽን ታኒ ህንተና ዞራናዉ ሀይሳ ጋይስፐ አትሽን፥ ኪታ ግደና። <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>አስ ኡባይ ታዳ ማቾ ኤኮና ደእያኮ ዶሳይስ፥ ሽን ፆሲ እሱዋስ እሱዋስ እምዳ ዱማ እሞት ደኤስ። እሱዋስ ሀይሳ መላ ሀንኩዋስ ሄሳ መላ እሞት ደኤስ።<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>ማቾ ኤክቦናይሳታስነ አዝና ገልቦናይሳታስ ቃስ አምኤታስ ታኒ ኦደይ፥ ታዳ ደእተ ጋዳ ዞራይስ። <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>ሽን አሞን ፁገተይሳፈ ኤከይስነ ገለይስ ሎኦ ግድያ ግሾ፥ ኤንቲ ባንታና ሃራናዉ ዳንዳኦና እፅኮ፥ ኤኮነ ገሎ።<verse eid="1CO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10"/>ታኒ ኤክዳይሳታነ ገልዳይሳታ ሀይሳዳ ጋዳ ዞራይስ፤ ታና ግድከ ጎዳይ ኪቴስ፤ ማችያ ባ አዝናፐ ሻከቶፎ።<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ 5:32</ref>፤ <ref loc="MAT 19:9">19:9</ref>፤ <ref loc="MRK 10:11-12">ማር 10:11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ 16:18</ref>.</char></note> <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>ሽን ሻከትኮ ሀራ አዝና ገሎና ባርካ ደኦ ዎይኮ ባ አዝናራ ስገቶ። አዝን ባ ማችዉ ብሎፎ።<verse eid="1CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12"/>ሽን ሀራታስ ጎዳ ግዶናሽን፥ ታኒ ሀይሳዳ ጋይስ። አማኖና ማቻ ደእያ አማንያ አዝን ደእኮ፥ እያ ማችያ እያራ እስፈ ዳናዉ ኮይኮ እዮ ብሎፎ። <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>ቃስ አማኖና አዝን ደእያ አማንያ ማቻ ደእኮ፥ እ አዝናይ ኢራ እስፈ ዳናዉ ኮይኮ እያፐ ብለቶፎ። <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>አማኖና አዝን ባ አማንያ ማቸ ባጋራ ፅሌስ፤ ቃስ አማኖና ማችያ ባ አማንያ አዝና ባጋራ ፅላዉሱ። ሄስ ባይነኮ፥ ህንተ ናይት ቱና ግዶሶና፥ ሽን ሀእ ኤንቲ ጌሽ። <verse eid="1CO 7:14"/><verse number="15" style="v" sid="1CO 7:15"/>ሽን አማኖና አዝናይ ዎይኮ ማችያ ብላናዉ ኮይኮ ብሎ። አማንያ ማችያ ዎይኮ አዝናይ ሄሳ መላባን ቃሸቶኮና። ፆሲ ኑና ሳሮተን ዳና መላ ፄግስ። <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>ነኖ፥ አማንያ ማቸተ፥ ኔኒ አማኖና ነ አዝና አሻነኮ አይ ኤራይ? ዎይኮ አማንያ አዝናዉ፥ ኔኒ አማኖና ነ ማችዉ አሻነኮ አይ ኤራይ?<verse eid="1CO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>እስ እስ አስ ጎዳይ እያዉ እምዳ እሞታዳነ ፆሳይ እያ ፄግዳይሳዳ ደኦ። ዎሳ ኬ ኡባን ታኒ ታማርስያ ዎጋይ ሀይሳ። <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>ኦንካ ቃፃረትድ ፄገትዳባ ግድኮ፥ ቃፃረቶናዳ ሀኖፖ። ቃፃረቶና ፄገትዳ ኦንካ ደእኮ፥ ቃፃረታናዉ ኮዮፖ። <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>ፆሳ ኪታ ፖላናዉ በሴስፐ አትሽን፥ ቃፃረትን ቃፃረቶና አግን አይኮካ ማደና።<verse eid="1CO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 7:20"/>እስ እስ አስ ፆሳይ ባና ፄግያ ዎደ ደኤይሳዳ ደኦ። <verse eid="1CO 7:20"/><verse number="21" style="v" sid="1CO 7:21"/>ፆሳይ ነና ፄግያ ዎደ ኔኒ አይሌ? አይኮይ ባዋ ሄሳስ ኡንኤቶፋ። ሽን ኔኒ አይለተፈ ላአ ከያናዉ ዳንዳእኮ ላአ ከያ። <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>አይለ ግድድ ደእሸ ጎዳን ፄገትዳ አስ ጎዳን አይለተፈ ላአ ከይስ። ሄሳዳካ፥ አይለ ግዶና ደእሸ፥ ጎዳን ፄገትዳ አስ ክርስቶሳ አይለ። <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>ፆሳይ ህንተና ጋተን ሻምዳ ግሾ አሳ አይለ ግዶፕተ። <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>ታ እሻቶ፥ ህንተ እሶይ እሶይ ፄገትያ ዎደ ደእያ ደኡዋን ፆሳራ እስፈ ደእተ።<verse eid="1CO 7:24"/></para>
  <para style="s1">አምኤታባነ ሶይዝቦናይሳታባ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>ጌላኦታባ ጎዳይ ታና ኪትዳባይ ባዋ። ሽን ጎዳይ ታዉ እምዳ ማሮተ መላ ታኒ ህንተና ዞራይስ። <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>ህዛ፥ ሀእ መቱዋ ግሾ፥ ኤኮና ዎይኮ ገሎና ዱስ ታዉ ሎኦ ዳኔስ። <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>ነ ማቾ ኤክዳባ ግድኮ፥ ሻከታናዉ ኮዮፓ። ኔኒ ማቾ ኤካቦናባ ግድኮ፥ ኤካናዉ ኮዮፓ። <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>ሽን ነ ማቾ ኤክኮ ናጋር ባዋ። ሄሳዳ ጌላእያ አዝና ገልኮ ናጋር ባዋ። ሽን ኤክያ ገልያ አሳስ ሀ ሳአን ዳሮ መቶይ ደእያ ግሾ ህንተ ሄሳፈ አታና መላ ታኒ ኮያይስ።<verse eid="1CO 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29"/>ታ እሻቶ፥ ታ ገይ ሄሳ፤ ዎደይ ዉርስ። ህዛፐ ጉየ ማቻ ደኤይ ማቾ ኤኮናዳ ደኦ። <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>ዬከይሳት ዬኮናዳ፥ ኡፋይተይሳት ኡፋይቶናዳ፥ ሻመይሳት አይኮይካ ባይናዳ ባንታና ታይቦ። <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>ሀ ሳኣ ሻሎን ማደተይሳት ማደትቦናዳ ሀኖ። ሀ አላምያ ማላይ አና።<verse eid="1CO 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32"/>ህንተ ህርግ ባይና ዳና መላ ታ ዶሳይስ። ማቾ ኤክቦናይስ ጎዳ ኡፋይሳናዉ ኮያ ግሾ፥ ጎዳባ ቆፔስ። <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>ሽን ማቾ ኤክዳይስ ባ ማችዉ ኡፋይሳናዉ ኮያ ግሾ፥ ሀ ሳአባ ቆፔስ። <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>እያ ቆፋይ ናምአን ሻከቴስ። አዝና ገላቦና ጌላእያ ባ አሳተንነ ባ ሸምፑዋን ጌያዳ ጎዳ ኡፋይሳናዉ ኮያ ግሾ፥ ጎዳባ ቆፓዉሱ። ሽን አዝና ገልዳራ ባ አዝና ኡፋይሳናዉ ኮያ ግሾ፥ ሳአባ ቆፓዉሱ። <verse eid="1CO 7:34"/><verse number="35" style="v" sid="1CO 7:35"/>ታኒ ሄሳ ህንተዉ ኦደይ፥ ህንተ ማደታና መላሳፈ አትሽን፥ ህንተና ኡንኤናዉ ግደና። ሽን ህንተ ቆፋይ ሻከቶና ማራን ደእድ ጎዳ ኡፋይስያባ ህንተ ኦና መላ ታኒ ኦዳይስ።<verse eid="1CO 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36"/>ኦንካ ባ ኦይችዳ ጌላኤስ ገሎ ዎደይ አስ ግድ እዮ አጋናዉ ቆፕኮ፥ ሄስ ቃስ እዉ ሎኦ ግዶናይስ እያዉ ስኤትኮ፥ ባ ኮይዳይሳ ኦ፤ ኤንቲ ኤከቶ፥ ገለቶ፤ ሄሳን ናጋር ባዋ። <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>ሽን እስ አስ ኡንኤያባይ ይን፥ ባ ዎዛናን ምንድ፥ ባና ሃርድ፥ ባ ኦይችዳ ጌላእዉ ኤከናዉ አጋናዉ ኮይኮ ሎይስ። <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>ሄሳ ግሾ፥ ጌላእዉ ኤክያ ኡራይ ሎይስ፤ ቃስ ኤኮና ኡራይ ዳሮ ሎይስ።<verse eid="1CO 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39"/>ማችያ ባ አዝናይ ፓፃ ደእያ ዎደ ኡባን እያራ ቃሸታሱ። ሽን እ አዝናይ ሀይቅኮ፥ ባ ዶስዳ አዝና ገላናዉ ዳንዳአዉሱ። ግዶሽን፥ እያ ገልያ አደይ አማንያ አስ ግዳናዉ በሴስ። <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>ታ ቆፋን ግድኮ፥ እያ ገሎና ደእኮ ኡፋይሳን ዳና። ቃስ ታዉ፥ ታ ቦላ ፆሳ አያን ደእያ ዳኔስ።<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s1">ኤቃስ ያርሸትዳ ካባ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>ኤቃስ ያርሸትያ ካባ ግድኮ ኑ ኡባይ ኤሮስ። ኤራተ ኦቶርሴስ፥ ሽን ሲቆይ ድቼስ። <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>ኦንካ ባና ኤራይስ ግድ ቆፕኮ፥ እ ቡሮ ኤራናዉ በሰይሳ ኤርቤና። <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>ሽን ኦንካ ፆሰ ሲቅኮ፥ እ ፆሳ ማታን ኤረትዳይሳ።<verse eid="1CO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4"/>ሄሳ ግሾ፥ ኤቃስ ያርሸትዳ ካ ሙሳባ ግድኮ፥ ሀ አላምያን ጎድ እስ ፆሳፈ አትሽን፥ ሀር ባይና ግሾ፥ ኤቅ ፓናባ ግደይሳ ኑኒ ኤሮስ። <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>ፆሰ ግዶናሽን፥ ሳሎንነ ሳአን ፆሰ ጌተትድ ፄገትያ ዳሮ ፆሳትነ ጎዳት ደእኮካ፥ <verse eid="1CO 8:5"/><verse number="6" style="v" sid="1CO 8:6"/>ኡባባ መዳ፥ ኑ እያባ ግድዳ፥ እስ ፆሲ፥ አው፥ ኑስ ደኤስ<note caller="-" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="DEU 6:4">ዛረ 6:4</ref>፤ <ref loc="DEU 10:13">10:13</ref>.</char></note>። ኡባይ እያ ባጋራ መትዳ፥ ኑካ እያ ባጋራ ደኦ ደምዳ እስ ጎዳይ፥ የሱስ ክርስቶሲ ኑስ ደኤስ።<verse eid="1CO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7"/>ሽን ሀ ኤረይ ኡባ ማታን ዴና። እስ እስ አሳይ ኤቃ ጎይኖራ ሜዘትዳ ግሾ፥ ካ ምያ ዎደ ኤቃስ ያርሸትዳባ ኦድ ኤኮሶና። ሄ ዎደ ኤንታ ካሀይ ዳቡራ ግድያ ግሾ ቱኔስ። <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>ሽን ካ ኑና ፆሳራ ዳቦየና። ኑ ሞና አግድ አይኮካ ቆሄቶኮ፤ ቃስ ምድ ዱማ ጎኤቶኮ።<verse eid="1CO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9"/>ሽን ህንተ ኮይዳባ ማናዉ ማት ህንተዉ ደእኮካ ሄስ አማኖን ምኖና አሳታ ቦና መላ ናገትተ። <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>ኔኒ ነና ኤራንቾ ጋዳ ኤቃስ ያርሸትዳ ካ ማናዉ ኤቃ ኬን ኡትዳሽን፥ አማኖን ምኖና አስ ነና በእኮ፥ ሄስ ኤቃስ ያርሸትዳ ካ እ ማና መላ ደንነዬ? <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>ህዛ፥ ነ ኤራተ ጋሶን ክርስቶስ እያ ግሾ ሀይቅዳ፥ አማኖን ምኖና ነ እሻይ ይስ። <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>ሄሳዳ ኦድ፥ አማኖን ምኖና ህንተ እሻታ ቆህሸነ ኤንታ ካሀ ማዱንፅስሸ ክርስቶሳ ቆሄታ። <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>ሄሳ ግሾ፥ ካ ታ እሻ ብያባ ግድኮ፥ እ በቶና መላ ኡባራካ አሾ ሚከ።<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s1">ሀዋረታ ማታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>ታኒ የዳ ደእያ አስ ግድክና? ታ ሀዋረ ግድክና? ታኒ ኑ ጎዳ የሱስ ክርስቶሳ በአብክና? ህንተ ጎዳን ታ ዳቡራ አይፈ ግደከቲ? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>ህንተ ጎዳባ ግድያ ግሾ፥ ታ ሀራታስ ሀዋረ ግዶና እፅኮካ፥ ህንተዉ ሀዋረ ግደይሳስ ህንተ ማርካ።<verse eid="1CO 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3"/>ታና ሀዋረ ግደና ገይሳታስ ታኒ እምያ ዛሮይ ሀይሳ። <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>ኑ ህንተፈ ማናዉነ ኡያናዉ ቱማ ኑስ ማት ባዌ? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>ሀንኮ ሀዋረታዳ፥ ጎዳ እሻታዳነ ጰፅሮሳዳ፥ አማንያ ኑ ማቸታ ኤክድ ሄመታናዉ ኑስ ማት ባዌ? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>ዎይኮ ኦድ አቃናዉ በሰይ ታራነ ባርናባሳ ፃላሌ? <verse eid="1CO 9:6"/><verse number="7" style="v" sid="1CO 9:7"/>ባ ሚሸን ዎታዳረታ ኦይ ኦኔ? ዎይኮ ዎይነ ቶክድ፥ እያፐ አይፈ ሞናይ ኦኔ? ዎይኮ ዉደ ሄምሸ፥ ሄ ዉድያፐ ማ ኡዮናይ ኦኔ?<verse eid="1CO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8"/>ታኒ ሄሳ አሳ ቆፋ ጋይናዬ? ሙሰ ህገይ ሄሳ ጌነዬ? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/>ሙሰ ህግያን፥ “ዉዱማን ካ የያ ቦራ ዶና ቃቾፋ” ጌተትድ ፃፈትስ። ያትን ፆሳይ ሄሳ ቦራስ ቆፕድ ኦድዴ?<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ዛረ 25:4</ref>፤ <ref loc="1TI 5:18">1 ፅሞ 5:18</ref>.</char></note> <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>ፆሳይ ሄሳ ግዳይ ኑስ ቆፕድ ግደኔ? ኤ፥ ኑ ግሾሳ። ቢታ ጎየይስነ ካ ጌሸይስ ባና ጋከይሳ ኤካና ግድ ኡፋይሳን ኦናዉ በሴስ ጌተትድ ቱማ ኑ ግሾ ፃፈትስ። <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/>ኑኒ ህንተ ግዶን አያና ዘረ ዘርዳ ግድኮ፥ አሾስ ኮሽያባ ኑ ህንተፈ ኤክኮ፥ ሄስ ግታባዬ?<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">ሮመ 15:27</ref>.</char></note> <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>ሀራት ሄሳ ህንተፈ ኤካናዉ ኤንታዉ ማት ደእኮ፥ ኑስ ኤንታፈ አያ ማት ዴኔ?</para>
  <para style="p" vid="1CO 9:12">ሽን ኑኒ ክርስቶሳ ዎንገላስ በ ግዶና መላ፥ ኡባባ ገንጮስፐ አትሽን፥ ሄ ማታን ጎኤትቦኮ። <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>ፆሳ ኬን ኦያ አሳት ባንታ ካ ፆሳ ኬፈ ኤከይሳ ኤረከቲ? ቃስ ያርሾ በሳን ኦያ አሳት ያርሹዋፈ ኤከይሳ ኤረከቲ?<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ዛረ 25:4</ref>፤ <ref loc="1TI 5:18">1 ፅሞ 5:18</ref>.</char></note> <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>ሄሳዳካ፥ ዎንገላ ማርካተይሳት ዱሳስ ኮሽያባ ዎንገላፐ ኤካና መላ ጎዳይ ኪትስ።<note caller="-" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">ማቶ 10:10</ref>፤ <ref loc="LUK 10:7">ሉቃ 10:7</ref>.</char></note><verse eid="1CO 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15"/>ሽን ታኒ ሀ ማታ ኡባን አይኮካ ጎኤታብከ። ታኒ ሄሳ ፃፍዳይ ታ ማታ ቦንችሳናዉ ኮያዳ ግደና። ኦንካ ታ ጬቁዋ ሀዳ ኦናፐ ሀይቆይ ታዉ ሎኦ። <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>ታኒ ዎንገላ ኦደይ ኪተትዳ ግሾሳፈ አትሽን፥ ታና ጬቅስያባ ግደና። ዎንገላ ኦዶና እፅኮ፥ ታና አየ!። <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>ታኒ ዎንገላ ዶሳዳ ኦድኮ፥ ታዉ ዎይቶይ ደኤስ። ሽን ታኒ ዎንገላ ዶሶና ኦድያባ ግድኮ፥ ሄሳ ፆሲ ታዉ ሀዳራ እሚስ። <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>ያትን፥ ታ ዎይቶይ አይቤ? ታኒ ዎንገላ ኦድያ ዎደ ታ ማታን ጎኤቶና፥ ዎንገላ ጋተይ ባይና ኦደይስ ታዉ ዎይቶ።<verse eid="1CO 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19"/>ታኒ ኦደስካ አይለ ግድከ፥ ሽን ዳሮታ ማዳናዉ ኡባስ አይለ ግዳስ። <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>ታኒ አይሁደታ ማዳናዉ ኤንታራ ኤንታ ግዳስ። ታ ሁጰን ህገፈ ጋርሳን ደእከ፥ ሽን ህገፈ ጋርሳን ደኤይሳታ ማዳናዉ ህገፈ ጋርሳን ደእያ አስ ግዳስ። <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>ፆሳ ህግያፈ ካረ ከዮና፥ ክርስቶሳ ህግያስ ኪተታሸ፥ ህገይ ባይናይሳታ ማዳናዉ ህገይ ባይና አሳዳ ሀናስ። <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>ታኒ ዳቡራንቾታ ማዳናዉ ዳቡራንቾ ግዳስ። ታኒ እሶታ እሶታ ማዳናዉ ኡባራ ኡባባ ሀናስ። <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>ታኒ ዎንገላ አንጁዋ ሻከታናዉ፥ ዎንገላ ግሾ፥ ሀ ኡባ ሀናስ።<verse eid="1CO 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24"/>ዎን ጋደትያ ኡባይ ዎፄስ፥ ሽን እሱዋ ፃላል ዎይቶ ኤከይሳ ኤረከቲ? ሄሳዳ ህንተካ ዎይቶ ኤካናዉ ዎፅተ። <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>ጋደትያ አሳ ኡባይ ኡባባን ባንታና ሃሬስ። ኤንቲ ሄሳ ዳቡረይ ይያ ዎይቶ ኤካናሳ። ሽን ኑኒ ዳቡረይ መርና ዎይቶ ኤካናሳ። <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>ሄሳ ግሾ፥ ታኒ ቆፍ ባይና አሳዳ ዎፅከ። ጫርኮ ይምፕያ አሳዳ ጮ ኩሸ የድከ። <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>ሽን ታኒ ሀራታስ ዎንገላ ኦድዳፐ ጉየ፥ ታኒ ታ ሁጰን የገትዳ አስ ግዶና መላ ታ አሳተ ዎልቃን ሃራዳ ታዉ ኪተታና መላ ኦይስ።<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s1">ኤቃ ጎይኖፍተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>ታ እሻቶ፥ ታኒ ህንተ ሀይሳ አኬካና መላ ኮያይስ። ኑ ማይዛት ኡባይ ሻራፐ ጋርሳራ ሄመትዶሶና፤ ኡባይ አባ ፕንዶሶና።<note caller="-" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ከሳ 13:21-22</ref>፤ <ref loc="EXO 14:22-29">14:22-29</ref>.</char></note> <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>ኤንቲ ሙሰራ እስፋናዉ ሻራንነ አባን ፃማቀትዶሶና። <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>ኤንቲ ኡባይ እስ አያና ካ ምዶሶና።<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">ከሳ 16:35</ref>.</char></note> <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>ቃስ ኡባይ እስ አያና ኡሻ ኡይዶሶና። ኤንቲ ባንታና ካልያ አያና ዛላፈ ፑልትዳ ኡሻ ኡይዶሶና፤ ሄ ዛላይካ ክርስቶሳ።<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">ከሳ 17:6</ref>፤ <ref loc="NUM 20:11">ታይቦ 20:11</ref>.</char></note> <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>ሽን ፆሳይ ኤንታፈ ዳሮታን ኡፋይትቦና ግሾ፥ ኤንታ አሀይ መላ ቢታን ዎድ አትስ።<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="NUM 14:29-30">ታይቦ 14:29-30</ref>.</char></note><verse eid="1CO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6"/>ኤንቲ ኢታባ አሞትዳይሳዳ፥ ኑካ ኢታባ አሞቶና መላ ሄ ኡባይ ኑስ ሌምሶ ግድስ።<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="NUM 11:4">ታይቦ 11:4</ref>.</char></note> <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>ጌሻ ማፃፋን፥ “አሳይ ማናዉነ ኡያናዉ ኡትዶሶና፤ ቃስ የፃናዉ ደንድዶሶና” ጌተትዳይሳዳ ኤንታፈ እሶት እሶት ኤቃ ጎይንዳይሳ መላ ህንተ ኤቃ ጎይኖፍተ።<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">ከሳ 32:6</ref>.</char></note> <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>ኤንታፈ እሶት እሶት ላይማትዳይሳዳ ኑ ላይማታናዉ በሰና። ሄሳ ጋሶን ኤንታፈ እስ ጋላስ ላታማነ ሄ ሙኩላይ ሀይቅስ።<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="NUM 25:1-18">ታይቦ 25:1-18</ref>.</char></note> <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>ኤንታፈ እሶት እሶት ጎዳ ፓጭድ ሾሻን ዱከትድ ሀይቅዳይሳዳ ኑ ጎዳ ፓጫናዉ በሰና።<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="NUM 21:5-6">ታይቦ 21:5-6</ref>.</char></note> <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>ኤንታፈ እሶት እሶት ዙዙምድ ሀይቆ ኤህያ ኪታንቹዋን ይዳይሳዳ ህንተካ ዙዙሞፍተ።<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="NUM 16:41-49">ታይቦ 16:41-49</ref>.</char></note><verse eid="1CO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11"/>ሀ ኤንታ ቦላ ጋክዳ ኡባይ ኑ ናገታና መላ ኑስ ሌምሶ ግድስ። ቃስ ዎደ ዉርሰ ቦላ ደእያ ኑስ ትምርተ ግዳና መላ ሀ ኡባይ ፃፈትስ።<verse eid="1CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12"/>ሄሳ ግሾ፥ ታ ኤቃስ ግያ ኦንካ ኩንዶና መላ ባና ናጎ። <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>አሰ ኡባ ጋክያ ፓጨፐ አትሽን፥ ዱማ ፓጨይ ህንተና ጋክቤና። ህንተ ዎልቃይ ዳንዳኤይሳፈ አያ ፓጨን ህንተ ፓጨቶና መላ አድ እሞና ፆሳይ አማነትዳይሳ። ህንተና ፓጨይ ጋክያ ዎደ ሄ ፓጭያ እ ህንተና ዳንዳእሳና። ቃስ ሄ ፓጭያፐ ህንተ ከያና ኦግያ እ ጊግሳና።<verse eid="1CO 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14"/>ህዛ፥ ታ አልኦ እሻቶ፥ ኤቃ ጎይኖፈ ሃክተ። <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>ህንተ ዎዛናማ አስ ግድዳ ግሾ ታ ሀይሳ ኦዳይስ። ታኒ ገይስ ቱማ ግደይሳ ህንተ ህንተ ሁጰን ፕርድተ። <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>ኑኒ ፆሳ ጋላትድ ሻከትያ አንጆ ፁአይ ክርስቶሳ ሱራ እስፈተ ደኤይሳ ግደነዬ? ቃስ ኑኒ ባያ ኡይይ ክርስቶሳ አሹዋራ እስፈተ ደኤይሳ ግደነዬ?<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">ማቶ 26:26-28</ref>፤ <ref loc="MRK 14:22-24">ማር 14:22-24</ref>፤ <ref loc="LUK 22:19-20">ሉቃ 22:19-20</ref>.</char></note> <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>ኑኒ ዳሮ ግድኮካ ኡይይ እስኖ፥ ኑ ሄ እስ ኡይ ሻከትያ ግሾ እስ አሳተ።<verse eid="1CO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18"/>አነ እስራኤለ አሳይ ኦዳይሳ አኬክተ። ያርሸትዳ ያርሹዋ መይሳት ያርሾ በሳራ እስፈተ ባወዬ?<note caller="-" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="LEV 7:6">ሌወ 7:6</ref>.</char></note> <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>ታኒ አይ ጋናዉ ኮያዳ ጋይና? ኤቃስ ያርሸትዳ ካይ ዎይኮ ኤቃይ ፓያባ ጉሰዬ? <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>ግደና፥ ኤንቲ ያርሸይ ፆሳስ ግዶናሽን፥ ቱና አያናታሳ። ሄሳ ግሾ፥ ህንተዉ ቱና አያናታራ እስፈተ ዳና መላ ኮይከ።<note caller="-" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">ዛረ 32:17</ref>.</char></note> <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>ህንተ ጎዳ ፁአፐ ኡይሸ፥ ቃስ ቱና አያናታ ፁአፐ ኡያናዉ ዳንዳኤከታ። ጎዳ ጋይታፐ ምሸ ቃስ ቱና አያናታ ጋይታፐ ማናዉ ዳንዳኤከታ። <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>ኑኒ ሄሳ ኦድ ጎዳ ይሎይኖ? ኑኒ እያፐ አያ ምኖዬ?<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">ዛረ 32:21</ref>.</char></note><verse eid="1CO 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>ህንተ፥ “ኡባባ ኦና መላ ድግያባይ ባዋ” ጌታ፥ ሽን ኡባይ ማደና። ህንተ፥ “ኡባባ ኦና መላ ድግያባይ ባዋ” ጌታ፥ ሽን ኡባይ ድቸና።<note caller="-" style="x"><char style="xo" closed="false">10:23 </char><char style="xt" closed="false"><ref loc="2CO 6:12">2 ቆሮ 6:12</ref>.</char></note> <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>እስ እስ አስ፥ ሀራ አስ ማድያባ ቆፓናዉ በሴስፐ አትሽን፥ ባና ማድያባ ፃላላ ቆፖፎ።<verse eid="1CO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25"/>ህንተ ካሀ ስን ገልስያ ኦይሻ ደንና ግያን ባይዘትያ አሹዋ ጮ ሚተ። <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>አይስ ጊኮ፥ ሳእነ ሳአን ደእያ ኡባይ ጎዳባ።<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="PSA 24:1">ማዝ 24:1</ref>.</char></note><verse eid="1CO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27"/>እስ አማኖና አስ ህንተና እማታናዉ ኮይድ ፄግኮ ባናዉ ኮይኮ ቢተ። ህንተ ካሀን መትያ ኦይሻን ስና ህንተ ስን አያባ ኡባ ሚተ። <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>ሽን እስ አስ፥ “ሀይስ ኤቃስ ያርሸትዳባ” ጊኮ፥ ሄ ህንተዉ ኦድዳ አድያ ግሾነ ካሀ ግሾ ሄ ካ ሞፕተ። <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>ታኒ፥ ካሀ ግሾ ገይ፥ ሄ ህንተዉ ኦድዳ ኡራ ካሀ ጉሱፈ አትሽን፥ ህንተ ካሀ ግደና።</para>
  <para style="p" vid="1CO 10:29">ሀራ አሳ ካሀ ግሾ ጋዳ ታኒ ታ ላአተ ቦላ አይስ ፕርዶ? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>ታኒ ምያ ካ ፆሳ ጋላታዳ ሚኮ ባልዳዳ አይስ ቦረትያና?<verse eid="1CO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31"/>ህዛ፥ ህንተ አይ ሚኮ አይ ኡይኮ፥ ዎይኮ አይ ኦኮካ ኡባባ ፆሳ ቦንቾስ ኦተ። <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>አይሁደታ ግድን ግርከታ ግድን ዎይኮ ፆሳ ዎሳ ኬ ግድን ኦደስካ በ ግዶፕተ። <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>ታኒ ኡባ ዎደ ዳሮታ አሻናዉ ኤንቲ ማደትያ ኦገ ኮያይስፐ አትሽን ታና ማድያ ኦገ ኮይከ።<verse eid="1CO 10:33"/></para>
  <para style="b"/>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>ታኒ ክርስቶሳ ሌምሱዋ ካለይሳዳ፥ ህንተካ ታና ካልተ።<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="2CO 4:16">2 ቆሮ 4:16</ref>፤ <ref loc="PHP 3:17">ፍልጵ 3:17</ref>.</char></note><verse eid="1CO 11:1"/></para>
  <para style="s1">ጎይኖ ማራ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>ህንተ ኡባባን ታና ቆፕያ ግሾነ ታኒ ታማርስዳ ትምርትያ ምንድ ናግዳ ግሾ ታኒ ህንተና ጋላታይስ። <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>ሽን ክርስቶስ አደ ኡባስ ሁጰ፥ አደይ ማጫሳስ ሁጰ፥ ቃስ ፆሲ ክርስቶሳስ ሁጰ ግደይሳ ህንተ ኤራና መላ ኮያይስ። <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>ባ ሁጵያ ጉሉንትድ ፆሰ ዎስያ ዎይኮ ትንብተ ኦድያ አደይ ኡባይ ሁጰ ግድዳ ክርስቶሳ ቶቼስ። <verse eid="1CO 11:4"/><verse number="5" style="v" sid="1CO 11:5"/>ባ ሁጵያ ቃጮና ፆሰ ዎስያ ዎይኮ ትንብተ ኦድያ ማጫስያ ሁጰ ግድዳ ባ አዝና ቶቻዉሱ። ባ ሁጵያ ቃጮና ማጫስያ ባ ሁጵያ ሜደትዳ ማጫሳ መላ።<verse eid="1CO 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 11:6"/>ማጫስ ባ ሁጰ ካሞና እፅኮ፥ ባ ሁጵያ ቃንፀቶ። ሽን እዉ ሁጰ ቃንፆይ ዎይኮ ሜዶይ ቦርሶ ግድኮ፥ ባ ሁጵያ ቃጮ። <verse eid="1CO 11:6"/><verse number="7" style="v" sid="1CO 11:7"/>አደይ ፆሳ ሌምሶነ ፆሳ ቦንቾ ግድያ ግሾ፥ ባ ሁጵያ ካማናዉ በሰና፥ ሽን ማጫስ አደስ ቦንቾ።<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 1:26-27">መ 1:26-27</ref>.</char></note> <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>ማጫስ አደፈ መታሱፐ አትሽን፥ አደይ ማጫሳፐ መትቤና።<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 2:18-23">መ 2:18-23</ref>.</char></note> <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>ማጫስ አደስ መትስፐ አትሽን፥ አደይ ማጫሳስ መትቤና። <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>ሀይሳ ግሾነ ኪታንቾታ ግሾ ማጫስ ባዉ ማት ደኤይሳ በሲያ ማላ ባ ሁጰን ቃጫናዉ በሴስ።<verse eid="1CO 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11"/>ሽን ጎዳ ቆፋን ማጫስ አደይ ባይና ዴና፤ አደይካ ማጫስ ባይና ዴና። <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>ማጫስ አደፈ መትዳይሳዳ አደይካ ማጫሳፐ የለትስ። ሽን ኡባይካ ፆሳፈ መትስ።<verse eid="1CO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13"/>አነ ህንተ ፕርድተ፤ ማጫስ ባ ሁጰ ካሞና ፆሳ ዎሳናዉ በሲ? <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>አደይ ባ ሁጵያ ድችኮ እያዉ ቦርሶ ግደይሳ ሀር አቶሽን መተ ህንተና ታማርሰኔ? <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>ሽን ማጫስ ባ ሁጰ ድችኮ እዉ ቦንቾ ግደኔ? ማጫሳስ ሁጰይ እመትዳይ እያ ባና ካማና መላሳ። <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>ሽን ሀይሳ ቦላ ፓላማናዉ ኮያ አስ ደእኮ፥ ኑስ ግድን ዎይኮ ፆሳ ዎሳ ኬታስ ግድን ሀይሳፈ ሀራ ዎግ ባዋ።<verse eid="1CO 11:16"/></para>
  <para style="s1">ጎዳ ካሆ ኤኮ ማራ</para>
  <para style="r">(<ref loc="MAT 26:26-29">ማቶ 26:26-29</ref>፤ <ref loc="MRK 14:22-25">ማር 14:22-25</ref>፤ <ref loc="LUK 22:14-20">ሉቃ 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>ህንተ እስፈ ሺቀይ ጎአስ ግዶናሽን ቆሆስ ግድያ ግሾ፥ ሀእ ታኒ እምያ ኪታን ህንተና ናሽከ። <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>ታኒ ኮይሮ ስእዳይ፥ ዎሳ ኬን ሺቅያ ዎደ ህንተ ግዶን ሻከተ ደኤይሳ። ሀ ታ ስእዳይስ ቱማ ግደይሳ አማናይስ። <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>ህንተ ግዶፈ ቱም ደኤይሳት ኦናንተኮ ኤረታና መላ ህንተ ግዶን ሻሆይ ዳናይስ አተና። <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>ህንተ እስፈ ሺቅያ ዎደ ህንተ ሺቀይ ጎዳ ካሁዋ ማናሳ ግደና። <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>ህንተ ካ ምያ ዎደ እሶይ እሱዋ ናጎና ባይሳ ባይሳ ምያ ግሾ፥ እሶይ ኮሻቴስ ሀንኮይ ቃስ ማቴስ። <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>ቱማ ህንተ ማናዉነ ኡያናዉ ህንተዉ ኬ ባዌ? ዎይኮ ፆሳ ዎሳ ኬ ካቲ? አይኮይ ባይና ማንቆታ ዬላየቲ? ታ ህንተና ዎይጎ? ሀይሳስ ታ ህንተና ናሾዬ? ናሽከ።<verse eid="1CO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23"/>ታኒ ህንተዉ እምዳ ትምርትያ ጎዳፐ ኤካስ። ጎዳይ የሱሲ አድ እመትያ ቃማ ኡይ ኤክድ፥ <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>ፆሳ ጋላትስ። ኡይ ባድ “ሄእተ፤ ሚተ። ሀይስ ህንተዉ እመትያ ታ አሹዋ። ሀይሳ ምሸ ታና ሀሳይተ” ያግስ። <verse eid="1CO 11:24"/><verse number="25" style="v" sid="1CO 11:25"/>ሄሳዳካ፥ ካሁዋ ምድ ስምን፥ ፁኣ ኤክድ፥ “ሀይስ ፁአይ ታ ሱን ኤቅያ ኦራ ጫቁዋ። ህንተ እያፐ ኡያ ዎደ ኡባን ታና ሀሳይተ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ከሳ 24:6-8</ref>፤ <ref loc="JER 31:31-34">ኤርም 31:31-34</ref>.</char></note> <verse eid="1CO 11:25"/><verse number="26" style="v" sid="1CO 11:26"/>ህንተ ሀ ኡይ ምያ ዎደነ ሀ ፁአ ኡያ ዎደ ኡባን ጎዳይ ያና ጋካናዉ እያ ሀይቁዋ ኦዴታ።<verse eid="1CO 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27"/>ሄሳ ግሾ፥ በሶና ኦገን ጎዳ ኡይ ምያ ዎይኮ ጎዳ ፁአ ኡያ ኦንካ እያ አሹዋነ ሱ ቶችዳ ግሾ ባ ናጋራን ኦይሸቴስ። <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>ሽን አስ ባና ፓጮ። ያትድ ኡይ ሞ፤ ፁአፐ ኡዮ። <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>ጎዳ አሹዋባ ሻክድ ኤሮና፥ ኡይ መይነ ፁአፐ ኡየይ፥ ባ ቦላ ፕርዳ ሜስነ ኡዬስ። <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>ሄሳ ግሾ፥ ህንተ ግዶፈ ዳሮት ዳቡርዶሶና፤ ሀርግዶሶና፤ ቃስ ኡንደና አሳት ሀይቅዶሶና። <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>ሽን ኑኒ ኑና ፓጭድ በእዳባ ግድያኮ፥ ኑ ቦላ ፕርደታናሽን። <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>አላመይ ፕርደትያ ዎደ ኑኒ አላምያራ ፕርደቶና መላ ሀእ ጎዳይ ኑና ሴሬስ።<verse eid="1CO 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33"/>ሄሳ ግሾ፥ ታ እሻቶ፥ ጎዳ ካሁዋ ኤካናዉ ህንተ ሺቅያ ዎደ እሶይ እሱዋ ናግድ ኤክተ። <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>ህንተ ሺቆይ ፕርዳስ ግዶና መላ ኮሻትዳ ኦንካ ደእኮ፥ ባ ሶን ሞ።</para>
  <para style="p" vid="1CO 11:34">አትዳባ ታኒ ያ ባዳ ህንተዉ ኦዳና።<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s1">ጌሻ አያና እሞታታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>ታ እሻቶ፥ ጌሻ አያና እሞታታባ ህንተ ኤራና መላ ታ ኮያስ። <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>ህንተ ፆሳ አማኖና ዎደ ዶን ባይና ኤቃታን ጎሸትድ፥ ህንተ ኤሮና ሶ ብዳይሳ ኤሬታ። <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>ፆሳ አያናይ ካለያ አስ ኦንካ፥ “የሱሲ ባደቶ” ያገና። ቃስ ጌሻ አያናይ ካለና ደእሽን፥ ኦንካ፥ “የሱሲ ጎዳ” ጋናዉ ዳንዳኦናይሳ ህንተ ኤራና መላ ኮያይስ።<verse eid="1CO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4"/>ዱማ ዱማ አያና እሞታት ደኦሶና፥ ሽን እሞታታ እምያ አያናይ እሱዋ።<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="ROM 12:6-8">ሮመ 12:6-8</ref>.</char></note> <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>ኑ ጎዳስ ኦያ ዱማ ዱማ ኦሶት ደኦሶና፥ ሽን ጎዳይ እሱዋ። <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>ኑ ጎዳስ ኦያ ዱማ ዱማ ኦገት ደኦሶና፥ ሽን ሄ ኦገታን ኦያ አሳ ኡባን ኦያ ፆሳይ እሱዋ። <verse eid="1CO 12:6"/><verse number="7" style="v" sid="1CO 12:7"/>ሽን እሱዋስ እሱዋስ እመትዳ እሞታታን ሀራታ ማዳና መላ ጌሻ አያናይ ቆንጬስ።<verse eid="1CO 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 12:8"/>ጌሻ አያናይ እሱዋስ ጭንጫተ ኩምዳ ቃላ እሜስ፤ ቃስ እሱዋስ ኤራተ ኩምዳ ቃላ እሜስ። <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>ሄ ጌሻ አያናይ እሱዋስ አማኖ፥ ሀንኩዋስ ቃስ ፓያ ዎልቃ እሜስ። <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>ጌሻ አያናይ እሱዋስ ማላታ ኦያ ዎልቃ፥ እሱዋስ ትንብተ ኦድያ ዎልቃ እሜስ። እሱዋስ አያናፐ አያና ሻክ ኤርያ ዎልቃ፥ እሱዋስ ዱማ ዱማ ዶናን ኦድያ ዎልቃ፥ ቃስ እሱዋስ ዱማ ዱማ ዶናን ኦደትዳይሳ ብርሽያ ዎልቃ እሜስ። <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>ሽን ሀ ኡባ ኦይ ሄ እስ ጌሻ አያና። እ ኮይያ መላ እስ እስ አሳስ ዱማ ዱማ እሞታ እሜስ።<verse eid="1CO 12:11"/></para>
  <para style="s1">አሳተነ ብልተታ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>እስ አሳተን ዳሮ ብልተት ደኦሶና፥ ሽን ሄ ዱማ ዱማ ብልተት እስ አሳተ ግዶሶና። ሄሳዳካ፥ ክርስቶስ ዱማ ዱማ ብልተት ደእያ አሳተ መላ።<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ROM 12:4-5">ሮመ 12:4-5</ref>.</char></note> <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>ኑኒ አይሁደ ግድን ግርከ ግድን አይለ ግድን ዎማኖ ግድን፥ ኡባይ እስ አሳተ ግዳናዉ ጌሻ አያናን ፃማቀትዳ። ቃስ ኑ ኡባይ እስ ጌሻ አያና ኤክዳ።<verse eid="1CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14"/>ኑ አሳተን ዱማ ዱማ ብልተት ደኦሶናፐ አትሽን፥ እስ ብልተ ግደና። <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>ቶሆይ፥ “ታኒ ኩሸ ግዶና ግሾ ብልተ ግድከ” ጊኮ፥ እ ሄሳ ግዳ ግሾ ብልተተይ አትዬ? <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>ሀይ፥ “ታኒ አይፈ ግዶና ግሾ ብልተ ግድከ” ጊኮ፥ እ ሄሳ ግዳ ግሾ አሳተፈ እስ ብልተ ግደይስ አትዬ? <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>አሳተ ኡባይ አይፈ ፃላላ ግድዳኮ፥ ኑ አይብን ስአኔ? ቃስ አሳተ ኡባይ ሀይ ፃላላ ግድዳኮ ኑ አይብን ስንጋኔ?<verse eid="1CO 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 12:18"/>ሽን ፆሳይ ባ ኮይዳይሳዳ፥ አሳተ ግዶን ዱማ ዱማ ብልተታ ዎስ። <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>ኡባይ እስ ብልተ ግድዳኮ አሳተ ዋንድ ዳኔ? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>ሽን ብልተት ዳሮ ግድኮካ፥ አሳተይ እሱዋ።<verse eid="1CO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21"/>አይፈይ ኩሸኮ፥ “ነ ታዉ ኮሻካ” ጋናዉ ዳንዳኤና። ዎይኮ ሁጰይ ቶሆኮ፥ “ነ ታዉ ኮሻካ” ጋናዉ ዳንዳኤና። <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>ሽን ዳቡራ ዳንያ አሳተ ብልተት ኑስ አድ ኮሾሶና። <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>ቦንቾ ኮሸና ግድ ኑ ቆፕያ ኑ ብልተታፐ ባጋታ ዳሮ ቦንቾስ። ቃስ ኑ ቦርሰትያ ኑ አሳተ ብልተታ አድ ቦንችድ ናጎስ። <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>ኑ በእን ቦርሶና አሳተ ብልተታስ ቦንቾ ኮሸና። ሽን ፆሳይ ኑ አሳተ ብልተታ ዎልራ ጋሰድ ቦርስያ ብልተታስ አያ ቦንቾ እሚስ። <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>አሳተ ብልተት እሶይ እሱዋራ ሻኮ መና ዎልስ ቆፓና መላ ኦድ መስ። <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>አሳተ ብልተታፐ እሶይ ሳከትኮ ብልተት ኡባይ እያራ ሳከቶሶና። አሳተ ብልተታፐ እሶይ ቦንቸትኮ ብልተት ኡባይ እያራ ኡፋይቶሶና።<verse eid="1CO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27"/>ህንተ ኡባይ ክርስቶሳ አሳተ፤ ቃስ ህንተ እሶይ እሶይ እያ ብልተታ። <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/>ዎሳ ኬን ፆሳይ፥ ኮይሮ ሀዋረታ፥ ናምአን ናበታ፥ ሄን አስታማረታ፥ ካልድ ማላታ ኦይሳታ፥ ፓይሳታ፥ ሀራታ ማደይሳታ፥ ዎሳ ኬ አይሰይሳታነ፥ ዱማ ዱማ ዶናን ኦደተይሳታ ዎስ።<note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">ኤፈ 4:11</ref>.</char></note><verse eid="1CO 12:28"/></para>
  <para style="m">
    <verse number="29" style="v" sid="1CO 12:29"/>ኡባይ ሀዋሬ? ኡባይ ናቤ? ኡባይ አስታማሬ? ኡባይ ማላታ ኦ? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>ኡባይ ፓዬ? ኡባይ ዱማ ዱማ ዶናን ኦዴቲ? ኡባይ ዱማ ዱማ ዶናን ኦደቶይሳ ብርሺ? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>ሽን ኡባፈ አያ እሞታ ምንድ ኮይተ።</para>
  <para style="p" vid="1CO 12:31">ቃስ ኡባፈ አያ ኦግያ ታ ህንተና በሳና።<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s1">ቱማ ሲቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>ታኒ አሳ ቃላነ ኪታንቾ ቃላ ኦደታናዉ ዳንዳእኮካ፥ ታዉ ሲቆይ ይኮ፥ ጮ ጊርያ ዳላ መላ። <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>ትንብተ ኦድያ እሞት ታዉ ደእኮካ፥ ፁራ ኡባ ኤርኮካ፥ ኤራተ ኡባይ ደእኮካ፥ ቃስ ደርያ ደንድ ሀራሶ ኤፍያ አማኖይ ታዉ ደእኮካ፥ ሲቆይ ይኮ፥ ታ አይኮካ ግድከ።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ 17:20</ref>፤ <ref loc="MAT 21:21">21:21</ref>፤ <ref loc="MRK 11:23">ማር 11:23</ref>.</char></note> <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>ታዉ ደእያባ ኡባ ማንቆታስ እምኮካ፥ ሀር አቶሽን፥ ታና ታማስ አ እምኮካ፥ ሲቆይ ይኮ ታና አይኮካ ማደና።<verse eid="1CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4"/>ሲቆይ ዳንዳአንቾ። ሲቆይ ኬሀ። ሲቆይ ቃናተና። ሲቆይ ጬቀተና። ሲቆይ ኦቶረና። <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>ሲቆይ በሶናባ ኦና። ሲቆይ ኡዘተና። ሲቆይ ይሎተና። ሲቆይ ባ ቆሆ ፓይደና። <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>ሲቆይ ቱማን ኡፋይተስፐ አትሽን፥ ዎርዶን ኡፋይተና። <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>ሲቆይ ኡባ ዳንዳኤስ፤ ኡባ አማኔስ፤ ሎኦባይ ሀናና ግድ፥ ኡፋይሳን ናጌስ፤ ኡባ ገንጬስ።<verse eid="1CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8"/>ሲቆይ ዉርሰ ጋካናዉ የና። ሽን ትንብተይ አታና፤ ዱማ ዱማ ዶናን ኦደተይስ አታና፤ ኤራተካ አና። <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>ኑ ኤራተፈ ጉ ኤሮስ፤ ትንብተፐ ባጋ ኦዶስ። <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>ሽን ፖሎ ግድዳይስ ያ ዎደ ፖሎ ግዶናይስ አታና።<verse eid="1CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11"/>ታኒ ናአ ደእያ ዎደ ናአዳ ሃሳይስ፤ ናአዳ ቆፓይስ፤ ናአዳ አኬካይስ። ታ ካሃምዳ ዎደ ናአተ ሀኑዋ አጋስ። <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>ሀእ ፖኦይ ባይና ሶን ማስቶተን በኤይሳዳ በኦስ፥ ሽን ሄ ዎደ ኑ ቆንጨን በአና። ሀእ ኑ ኤራተፈ ጉ ኤሮስ፥ ሽን ሄ ዎደ ፆሳይ ኑና ኤረይሳዳ ፖሎ ኤራና።<verse eid="1CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13"/>ህዛ፥ አማኖይ፥ ኡፋይስነ ሲቆይ፥ ሀ ሄት ኤቅድ ዳና። ሽን ሀይሳታፐ አይ ሲቆ።<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s1">ትንብተነ ዱማ ዱማ ዶና</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>ሲቆ ካልተ። አያና እሞታታ ምንድ ኮይተ፤ ኡባፈ አድ፥ ትንብተ እሞታ ምንድ ኮይተ። <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>ዱማ ዱማ ዶናን ኦደትያ አስ ፆሳስ ኦዴስፐ አትሽን፥ አሳስ ኦደና። ሽን አሳስ ቆንጭቦና ፁራ አያና ዎልቃን ኦደትያ ግሾ፥ ኦንካ እ ኦደተይሳ አኬከና። <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>ሽን ትንብተ ኦደይሳት አሰ ድቻናዉ፥ ምንናዉነ ምንናዉ አሳስ ኦዴስ። <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>ዱማ ዱማ ዶናን ኦድያ አስ ባና ድቼስ። ሽን ትንብተ ኦድያ አስ ዎሳ ኬ ድቼስ።<verse eid="1CO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5"/>ህንተ ኡባይ ዱማ ዱማ ዶናን ኦደትያኮ ታ ዶሳይስ፥ ሽን ትንብተ ኦዳናይሳ አዳ ዶሳይስ። ዱማ ዱማ ዶናን ኦደተይሳ ዎሳ ኬ ድቻናዉ ብርሽያ አስ ይኮ፥ ዱማ ዱማ ዶና ኦደተይሳፈ ትንብተ ኦደይስ አስ።<verse eid="1CO 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6"/>ሽን ታ እሻቶ፥ ታኒ ህንተኮ ባዳ፥ ቆንጨን ዎይኮ ኤራተን ዎይኮ ትንብተ ኦዶን ዎይኮ ትምርተን ግዶናሽን፥ ዱማ ዱማ ዶናን ኦደትኮ ህንተና አይ ማዳኔ? <verse eid="1CO 14:6"/><verse number="7" style="v" sid="1CO 14:7"/>ዱማ ዱማ የ ሚሸታስ እስ ቆሞ ግርስ ደእኮ፥ ሱሱልኤ ግርስነ ዲ ግርስ ዋትድ ሻክ ኤራኔ? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>ቃስ ሞይዘ ፑኖይ ጌይድ ኤረቶና እፅኮ ኦላስ ጊገተይ ኦኔ? <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>ሄሳዳካ፥ ዱማ ዱማ ዶናን ህንተ ኦደተይስ ቆንጨ ግዶና እፅኮ ህንተ ኦደይሳ ኦን ኤራኔ? ሄስ ጫርኮስ ኦድያ መላ።<verse eid="1CO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 14:10"/>ሀ አላምያን ዳሮ ዶናት ደኦሶና፤ ሄ ኡባስ ብርሸ ደኤስ። <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>ሽን እስ አስ ኦደትያ ዶና ታኒ ኤሮና እፅኮ እ ታዉ እማ ግዴስ፤ ታካ እያዉ እማ ግዳይስ። <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>ሄሳዳካ፥ ጌሻ አያና እሞታ ህንተ ኤካናዉ ምንድ ኮይኮ፥ ዎሳ ኬ ድቻናዉ ኡባፈ አያ እሞታ ኮይተ።<verse eid="1CO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13"/>ዱማ ዱማ ዶናን ኦደትያ አስ ባ ኦዳ ብርሻናዉ ብርሸ እሞታይ እመታና መላ ፆሳ ዎሶ። <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>ታኒ ዱማ ዱማ ዶናን ፆሳ ዎስኮ፥ ታ አያናይ ዎሴስ፥ ሽን ታ ዎዛናይ አይኮካ ጎኤተና። <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>ያትን፥ ታ አይ ኦናዉ ኮሺ? ታኒ ታ አያናን ዎሳይስ፤ ታ ዎዛናንካ ዎሳይስ። ታኒ ታ አያናን የፃይስ፤ ታ ዎዛናንካ የፃይስ። <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>ሄሳ ግዶና እፅኮ ኔኒ ነ አያናን ፆሳ ጋላትያ ዎደ ሄ በሳን ኔኒ ገይሳ ኤሮና አስ ነ ጋላተይሳ ዎይግድ፥ “አምንእ” ጋኔ? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>ኔኒ ፆሳ ጋላተይስ ሎኦ፥ ሽን ሀራ አስ ማደና።<verse eid="1CO 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18"/>ታ ህንተ ኡባፈ አዳ ዱማ ዱማ ዶናን ኦደትያ ግሾ ፆሳ ጋላታይስ። <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>ሽን ታኒ ዎሳ ኬን ሀራታ ታማርሳናዉ ዱማ ዱማ ዶናን ታሙ ሙኩሉ ቃላ ኦደታናፐ እቻሹ ቃላ ኤረትያ ዶናን ኦደታናዉ ዶሳይስ።<verse eid="1CO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20"/>ታ እሻቶ፥ ህንተ ቆፋን ናይታዳ ሀኖፕተ። ህንተ ኢታባስ ናይታዳ ሀንተፐ አትሽን፥ ህንተ ቆፋን ካሃማታ ግድተ። <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>ጎዳይ፥ ጌሻ ማፃፋን፥</para>
  <para style="q1" vid="1CO 14:21">“ታኒ ሀ አሳስ፥</para>
  <para style="q2" vid="1CO 14:21">ዱማ ዱማ ዶናን ኦደትያ አሳንነ</para>
  <para style="q2" vid="1CO 14:21">እማ እንፃርሳን ኦደትያ አሳን ኦዳና።</para>
  <para style="q1" vid="1CO 14:21">ሽን ሄስ ሀንንካ ታና ስኦኮና” ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="ISA 28:11-12">እሳ 28:11-12</ref>.</char></note><verse eid="1CO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22"/>ህዛ፥ ዱማ ዱማ ዶናን ሃሳዮይ፥ አማኖና አሳስ ማላ ግዴስፐ አትሽን፥ አማንያ አሳሳ ግደና። ትንብተይ አማንያ አሳስ ማላ ግዴስፐ አትሽን፥ አማኖና አሳሳ ግደና።<verse eid="1CO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23"/>ዎሳ ኬ አሳይ እስፈ ሺቅያ ዎደ፥ ኡባይ ዱማ ዱማ ዶናን ኦደትኮ ኤሮና ዎይኮ አማኖና አሳይ ህንተ ሺቁዋ ይድ፥ “ሀይሳቲ ጎዮሶና” ጎኮናዬ? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>ሽን ኤሮና ዎይኮ አማኖና አሳይ ዎሳ ኬ ያ ዎደ አሳይ ትንብተ ኦድሽን፥ ስእኮ ባ ናጋራ አኬካና፤ ቃስ እ ስእዳ ቃላን ፕርደታና። <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>ኤንቲ እያ ዎዛናን ጌምዳ ቆፋ ቆንጭሳና። ሄሳዳካ፥ “ቱማ ፆሳይ ህንተ ግዶን ደኤስ” ያግድ ማርካትድ፥ ጉፋንድ ፆሳስ ጎይናና።<verse eid="1CO 14:25"/></para>
  <para style="s1">ጎይኖ ማራ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>ታ እሻቶ፥ ኑ ዎይግኖ? ህንተ እስፈ ሺቅያ ዎደ እሱዋስ ማዝሙረይ ደኤስ፤ እሱዋስ ታማርሶ እሞት ደኤስ፤ እሱዋስ ቆንጨ ደኤስ፤ እሱዋስ ዱማ ዱማ ዶናን ሃሳዮይ ደኤስ፤ እሱዋስ ብርሸ እሞት ደኤስ። ሄ ኡባይ ዎሳ ኬ ድችያባ ግዳናዉ በሴስ። <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>ዱማ ዱማ ዶናን ኦደትያ አሳት ደእኮ፥ ናምአ ዎይኮ ዳርኮ ሄ ግድድ ማራን ማራን ኦደታናዉ በሴስ። ኤንቲ ኦደተይሳ ሀራ አስ ብርሾ። <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>ሽን ብርሽያ አስ ይኮ፥ ዱማ ዱማ ዶናን ኦደተይስ ዎሳ ኬን ስእ ጎ። ባዉነ ባ ፆሳስ ኦዶ።<verse eid="1CO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29"/>ትንብተ ኦደይሳት ናምአ ዎይኮ ሄ ግድድ ኦዶ። ቃስ ሀራት ኤንቲ ግያባ ፕርዶና። <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>ሄ ሺቁዋን ደእያ ሀራ አሳስ እስባይ ቆንጭኮ ካሰ ኦደተይስ ስእ ጎ። <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>ኡባይ ታማራና መላነ ኡባይ ምናና መላ ማራን ማራን ትንብተ ኦዳናዉ ዳንዳኤታ። <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>ናበታ አያናይ ናበታስ ኪተቴስ። <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>ጌሻታ ዎሳ ኬ ኡባይ ሜዘትዳይሳዳ ፆሳይ ሳሮተ ፆሳፈ አትሽን፥ ቡቀ መያ ፆሲ ግደና።<verse eid="1CO 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CO 14:34"/>ማጫስ ዎሳ ኬን ስእ ጎ። ሙሰ ህገይ ገይሳዳ ኤንቲ ሃረቶፈ አትሽን፥ ዎሳ ኬን ኦዳናዉ ኤንታዉ ማት ባዋ። <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>ማጫስ ዎሳ ኬን ሃሳዮይ ቦርሶ ግድያ ግሾ እስባ ኤራናዉ ኮይኮ ሶን ባንታ አዝናታ ኦይቾና።<verse eid="1CO 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36"/>ፆሳ ቃላ ኮይሮ ህንተ ኤህደቲ? ዎይኮ ፆሳ ቃላይ ህንተ ፃላላኮ ይዴ? <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>ኦንካ ባና ናበ ዎይኮ ባና ፆሳ አስ ግድ ቆፕኮ፥ ታኒ ህንተዉ ፃፈይስ ጎዳ ኪታ ግደይሳ አኬኮ። <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>ሽን ኦንካ አኬኮና እፅኮ እካ አኬከቶፎ።<verse eid="1CO 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39"/>ሄሳ ግሾ፥ ታ እሻቶ፥ ትንብተ ኦዳናዉ ምንድ አሞትተ፤ ቃስ ዱማ ዱማ ዶናን ኦደተይሳካ ድጎፍተ። <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>ሽን ኡባይካ ዎጋንነ ማራን ግዶ።<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s1">ክርስቶስ ሀይቆፐ ደንዱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>ታ እሻቶ፥ ታ ህንተዉ ማርካትዳ ዎንገላ ህንተ ኤክዳይሳነ ህንተ አማኖይ እያን ኤቅዳይሳ ህንተ አኬካና መላ ታኒ ኮያይስ። <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>ታ ታማርስዳ ዎንገላ ምንድ ኦይክኮ ህንተ እያን አታና። ሄስ ሀኖና እፅኮ ህንተ አማኖይ ሀዳ ግዳና።<verse eid="1CO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3"/>ታኒ ኤክዳ ኡባፈ አያ ኪታ ካሰታዳ ህንተዉ እማስ። ሄስካ፥ ጌሻ ማፃፋይ ገይሳዳ፥ ክርስቶስ ኑ ናጋራ ግሾ ሀይቅስ።<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="ISA 53:5-12">እሳ 53:5-12</ref>.</char></note> <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>ሞገትስ፤ ጌሻ ማፃፋይ ገይሳዳ፥ ሄን ጋላሳን ሀይቆፐ ደንድስ።<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="PSA 16:8-10">ማዝ 16:8-10</ref>፤ <ref loc="MAT 12:40">ማቶ 12:40</ref>፤ <ref loc="ACT 2:24-32">ሀዋ 2:24-32</ref>.</char></note> <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/>ጰፅሮሳስ ቆንጭስ። ሄሳፈ ጉየ፥ ታማነ ናምኡ ሀዋረታስ ቆንጭስ።<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="MAT 28:16-17">ማቶ 28:16-17</ref>፤ <ref loc="MRK 16:14">ማር 16:14</ref>፤ <ref loc="LUK 24:34">ሉቃ 24:34</ref>፥ <ref loc="LUK 24:36">36</ref>፤ <ref loc="JHN 20:19">ዮሀ 20:19</ref>.</char></note> <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>ሄሳፈ ጉየ፥ እቻሹ ፄታፐ ዳርያ አሳስ እስቶሆ ቆንጭስ። ኤንታፈ ዳርያ ባጋይ ሀእ ጋካናዉ ፓፃ ደኦሶና፥ ሽን ጉት ሀይቅዶሶና። <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>ሄሳፈ ጉየ፥ ያይቆባስ ቆንጭስ፤ ጉየፐ ባ ሀዋረታ ኡባስ ቆንጭስ።<verse eid="1CO 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8"/>ቃስ ዉርሰን አዉጫያ መላ ግድዳ ታዉ ቆንጭስ።<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">ሀዋ 9:3-6</ref>.</char></note> <verse eid="1CO 15:8"/><verse number="9" style="v" sid="1CO 15:9"/>ታኒ የሱሳ ሀዋረታ ኡባፈ ላፋ። ታኒ ፆሳ ዎሳ ኬ ጎድዳ ግሾ የሱሳ ሀዋረ ጌተታዳ ፄገታናዉ በሶናይሳ።<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሀዋ 8:3</ref>.</char></note> <verse eid="1CO 15:9"/><verse number="10" style="v" sid="1CO 15:10"/>ሽን ፆሳ አ ኬሀተን ታ ሀእ ግድዳይሳ ግዳስ፤ እ ታዉ እምዳ አ ኬሀተይ መላ አትቤና። ታኒ ሀንኮ ሀዋረታፐ አዳ ዳቡራስ። ሽን ታራ ደእያ ፆሳ አ ኬሀተይ ኦስፐ አትሽን፥ ታና ግድከ። <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>ህዛ፥ ታና ግድን ኤንቲ፥ ኑ ኡባይ ታማርሰይ ሄሳ፤ ህንተካ ሄ ኪታ አማንደታ።<verse eid="1CO 15:11"/></para>
  <para style="s1">ሀይቅዳ አስ ሀይቆፐ ደንዶ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>ክርስቶስ ሀይቆፐ ደንድዳይሳ ኑ ሳባክያ ዎደ ህንተፈ እሶት እሶት ያትን፥ ዎይግድ፥ “ሀይቆፐ ደንዶይ ባዋ” ያጎና? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>ሀይቆፐ ደንዶይ ባይናባ ግድኮ ክርስቶስ ሀይቆፐ ደንድቤና ጉሱ። <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>ክርስቶስ ሀይቆፐ ደንድቦናባ ግድኮ ኑ ትምርተይ ቃስ ህንተ አማኖይካ ሀዳ። <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>ሀይቆፐ ደንዶይ ባይናሽን፥ ኑኒ ፆሳይ፥ “ክርስቶሳ ሀይቆፐ ደንስ” ያግድ ሳባክሸ ፆሳ ዎርዳንቾ ማርካታ ግድዳ ጉሱ። <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>ሀይቅዳ አሳይ ሀይቆፐ ደንድቦናባ ግድኮ ህዛ፥ ክርስቶስ ሀይቆፐ ደንድቤና። <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>ክርስቶስ ሀይቆፐ ደንዶናባ ግድኮ፥ ህንተ አማኖይ ሀዳ፤ ቃስ ህንተ ሀእ ጋካናዉ ህንተ ናጋራን ደኤታ። <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>ህዛ፥ ክርስቶሳ አማንድ ሀይቅዳይሳትካ ይዶሶና ጉሱ። <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>ኑኒ ሀ አላምያ ደኡዋ ፃላላስ ክርስቶሳን ኡፋይስ ኦዳባ ግድኮ፥ ሀ ሳአን ደእያ አሳ ኡባፈ ኑባይ አዳ ይባታ።<verse eid="1CO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20"/>ሽን ክርስቶስ ሀይቅዳይሳታስ ሀይቆፐ ደንዶን ባይራ ግድድ ቱማ ደንድስ። <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>ሀይቆይ እስ አሳ ባጋራ ሀ አላምያ ይዳይሳዳ ሀይቆፐ ደንዶይ እስ አሳ ባጋራ ይስ። <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>አዳመ ባጋራ አሳ ኡባይ ሀይቅዳይሳዳ ክርስቶሳ ባጋራ አሳ ኡባይ ደኦን ዳና። <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>ሽን እሶይ እሶይ ባ ማራን ማራን ደንዳና። ክርስቶስ ኡባፈ ካሰትድ ደንድስ፤ ሄሳፈ ጉየ፥ ክርስቶሳይሳት እ ያ ዎደ ደንዳና።<verse eid="1CO 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 15:24"/>ሄሳፈ ጉየ፥ ክርስቶስ ሀላቃተ፥ ማታነ ዎልቃ ኡባ ይስድ፥ ካዎተ ፆሳ አዋስ እምያ ዎደ ዎድያ ዉርሰይ ያና። <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>ፆሳይ እያ ሞርከታ ኡባ እያ ቶሁዋፐ ጋርሳን ዎና ጋካናዉ ክርስቶስ ሃራናዉ በሴስ።<note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ 110:1</ref>.</char></note> <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>ዉርሰን እ ይሳናዉ ደእያ ሞርከይ ሀይቆ። <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>ጌሻ ማፃፋን፥ “ፆሳይ ኡባባ እያ ማታፐ ጋርሳን ሃርስስ” ጌተትድ ፃፈትስ። ሽን ኡባ እያ ማታፐ ጋርሳን ሃርስስ ገይስ፥ ኡባባ እያ ማታፐ ጋርሳን ሃርስዳ ፆሳ ጉጀና።<note caller="-" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">ማዝ 8:6</ref>.</char></note> <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>ኡባባይ ክርስቶሳ ማታፐ ጋርሳን ሃረትዳፐ ጉየ ክርስቶስ ቃስ ባ ሁጰን ኡባባ ባዉ ሃርስዳ ፆሳስ ሃረታና። ሄ ዎደ ፆሳይ ባ ፃላላ ኡባ ሃራና።<verse eid="1CO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29"/>ሀይቅዳይሳት ደንዶናባ ግድኮ ኤንታ ግሾ ፃማቀትያ አሳስ አይባ ዎይ ደኢ? ሀይቅዳይሳት ደንዶናባ ግድኮ ያትን፥ አይስ፥ አሳይ ሀይቅዳይሳታ ግሾ ፃማቀቶና?<verse eid="1CO 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1CO 15:30"/>ያትን፥ ኑኒ አይስ ኡባ ዎደ ኑናተ መቶስ አድ እሞና? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>ታ እሻቶ፥ ታ ጋላስ ጋላስ ሀይቆስ አዳ እመታይስ። ሄስካ፥ ጎዳ ክርስቶስ የሱሳን ደእያ ደኡዋ እስፈተን ህንተናን ጬቅያ ግሾሳ። <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>አሳ ቆፋ ግድኮ፥ ታኒ ኤፈሶናን ዶአራ ቡተትዳይስ ታና አይ ማዲ? ሀይቅዳይሳት ሀይቆፐ ደንዶናባ ግድኮ፥ “ዎንቶ ኑ ሀይቅያ ግሾ ሀች ማና ኡያና” ግያ አሳ መላ ግዶስ።<note caller="-" style="x"><char style="xo" closed="false">15:32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">እሳ 22:13</ref>.</char></note><verse eid="1CO 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33"/>ጭመቶፍተ! ኢታ ላገተ ሎኦ አማለ ኢሴስ። <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>ህንተ አኬካኮ ስምተ። ናጋራ ኦፍተ። ህንተፈ እስ እስ አሳይ ፆሳ ኤሮኮና። ታኒ ህንተና ዬላያናዉ ሄሳ ጋይስ።<verse eid="1CO 15:34"/></para>
  <para style="s1">ደንዶ አሳተ</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>እስ አስ፥ “ሀይቅዳ አሳይ ዋንድ ደንዳኔ? ኤንቲ አይ መላ አሳተራ ያኔ?” ያጎና አገና። <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>ነኖ ኤያዉ፥ ኔኒ ቢታን ዘርያ ዘረይ ሀይቆና ዶለና። <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>ኔኒ ዘረይ ግስተ ግድን ዎይኮ ሀራ ካ ቆሞ አይፈ ፃላላ ዘራሳፐ አትሽን፥ ዶልዳ ዶላ ግደና። <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>ሽን ፆሳይ ዘረስ ባ ዶስዳ መላ መተ እሜስ። ዱማ ዱማ ዘረስ ዱማ ዱማ አሳተ እሜስ። <verse eid="1CO 15:38"/><verse number="39" style="v" sid="1CO 15:39"/>መተ ኡባ አሾይ እሶ ግደና። ሽን አሳ አሾይ እሱዋ፤ መሄ አሾይ ዱማ፤ ካፎታ አሾይ ዱማ፤ ቃስ ሞሎ አሾይ ዱማ።<verse eid="1CO 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40"/>ሳሎ አሳተ ደኤስ፤ ቃስ ሳአ አሳተ ደኤስ። ሽን ሳሎ አሳተ ቦንቾይ ዱማ፤ ቃስ ሳአ አሳተ ቦንቾይ ዱማ። <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>አዋ ቦንቾይ ዱማ፤ አጌና ቦንቾይ ዱማ፤ ፆልንቶታ ቦንቾይ ዱማ፤ እስ ፆልንቶይ ሀንኮ ፆልንቱዋፈ ቦንቾን ዱማቴስ።<verse eid="1CO 15:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42"/>ሀይቅዳይሳት ሀይቆፐ ደንድያ ዎደ ሄሳዳ ሀናና። ሀይቅያ አሳተይ ዘረቴስ፤ ሀይቆና አሳተ ግድድ ደንዴስ። <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>ቶሸን ዘረትድ፥ ቦንቾን ደንዳና፤ ዳቡራን ዘረትድ፥ ዎልቃን ደንዳና። <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>መተ አሳተይ ዘረትድ፥ አያና አሳተ ግድድ ደንዳና። መታ አሳተ ደእኮ፥ አያና አሳተ<note caller="+" style="f"><char style="fr" closed="false">15:44 </char><char style="fq" closed="false">አያና አሳተ፦ </char><char style="ft" closed="false">ጌሻ አያናይ ሃርዳ ዎይኮ ጌሻ አያናይ ደኦ እምዳ አሳተ ጉሱ።</char></note> ደኤስ።<verse eid="1CO 15:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45"/>ሄሳዳካ፥ ጌሻ ማፃፋን፥ “ኮይሮ አደይ፥ አዳመይ፥ ፓፃ ደእያ አሰ ግድድ መትስ”<note caller="-" style="x"><char style="xo" closed="false">15:45 </char><char style="xt" closed="false"><ref loc="GEN 2:7">መ 2:7</ref>.</char></note> ያጌስ። ሽን ዉርሰ አዳመይ፥ ክርስቶስ፥ ደኦ እምያ አያና ግድስ። <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>ሽን መታ አስ ኮይሮ ይን፥ ጉየፐ አያና አስ ይስፐ አትሽን፥ አያና አስ ኮይሮ ይቤና። <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>ኮይሮ አዳመይ ቢታፈ መትዳ ቢታ አስ፤ ናምአን አዳመይ ሳሎፐ ይዳ ሳሎ አስ። <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>ቢታፈ መትዳይሳት ቢታፈ መትዳይሳ ዳኖሶና። ሳሎይሳት ሳሎፐ ይዳይሳ ዳኖሶና። <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>ኑኒ ቢታፈ መትዳ አድያ ዳነይሳ መላ ሳሎፐ ይዳ አድያ ዳናና።<verse eid="1CO 15:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50"/>ታ እሻቶ፥ ታ ገይስ ሄሳ፤ ሀእ ኑ ማእዳ አሳተይ ፆሳ ካዎተ ላታናዉ ዳንዳኤና። ዎቅያ አሳተይ ዎቆና አሳተ ላተና።<verse eid="1CO 15:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51"/>ታ ህንተዉ እስ ፁራ ኦዳና። ኑ ኡባይ ሀይቆኮ፥ ሽን ዉርሰን ኡባይ ላመታና። <verse eid="1CO 15:51"/><verse number="52" style="v" sid="1CO 15:52"/>ሞይዘይ ፑነትያ ዎደ፥ አይፈይ ቅጵ ፄላናዉ ሀሳዮና ላመታና። ሀይቅዳ አሳይ ዎቆና አስ ግድድ ደንዳና፤ ኑካ ላመታና።<note caller="-" style="x"><char style="xo" closed="false">15:52 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1 ተሰ 4:15-17</ref>.</char></note> <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>ሀይስ ዎቀይስ ዎቆናይሳ፥ ሀይስ ሀይቀይስ ሀይቆናይሳ ማአናዉ በሴስ።<verse eid="1CO 15:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="1CO 15:54"/>ሀይስ ዎቀይስ ዎቆናይሳ፥ ቃስ ሀይስ ሀይቀይስ ሀይቆናይሳ ማእያ ዎደ፥ ጌሻ ማፃፋን፥ “ሀይቆይ ፆኖን ምተትስ”<note caller="-" style="x"><char style="xo" closed="false">15:54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">እሳ 25:8</ref>.</char></note> ግያ ቃላይ ፖለታና። <verse eid="1CO 15:54"/><verse number="55" style="v" sid="1CO 15:55"/>ሄሳዳካ፥</para>
  <para style="q1" vid="1CO 15:55">“ሀይቆ፥ ነ ፆኖይ አዉን ደኢ?</para>
  <para style="q2" vid="1CO 15:55">ሀይቆ፥ ነ ቆህያ ዎልቃይ አዉን ደኢ?”<note caller="-" style="x"><char style="xo" closed="false">15:55 </char><char style="xt" closed="false"><ref loc="HOS 13:14">ሆሰ 13:14</ref>.</char></note></para>
  <para style="m" vid="1CO 15:55">ግዳ ቃላይ ፖለታና። <verse eid="1CO 15:55"/><verse number="56" style="v" sid="1CO 15:56"/>ሀይቆይ ዱክያ ዎልቃይ ናጋራ፤ ቃስ ናጋራ ዎልቃይ ህገ። <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>ሽን ኑ ጎዳ የሱስ ክርስቶሳ ባጋራ ኑስ ፆኖ እምያ ፆሳ ጋላት ጋኮ።<verse eid="1CO 15:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58"/>ሄሳ ግሾ፥ ታ ሲቆ እሻቶ፥ ቃፆና ምንድ ኤቅተ። ጎዳ ኦሱዋን ህንተ ዳቡረይስ ጮ ግዶናይሳ ኤርድ ኡባ ዎደ ጎዳ ኦሱዋ አዛሎና ኦተ።<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s1">አማንያ አሳስ ሺቅዳ እሞታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>አማንያ አሳስ ሚሸ ሺሾባ ጋላትያ ዎሳ ኬታስ ታኒ ኪትዳይሳዳ ህንተካ ኦተ።<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="ROM 15:25-26">ሮመ 15:25-26</ref>.</char></note> <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>ሚሽያ ሺሾይ ታ ህንተኮ ብያ ዎደ ግዶና መላ እሶይ እሶይ ሳምንታፈ ኮይሮ ጋላስ፥ ዎጋ ዎደ፥ ዎጋ ዎደ፥ ባ ደመይሳፈ ከስድ ባ ሶን ዳጋዮ። <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>ታኒ ያ ብዳ ዎደ ሚሽያ የሩሳላመ ጋና መላ ህንተ ዶርያ አሳስ ዳብዳበ እማዳ ኤንታ የሩሳላመ ኪታና። <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>ኤንታራ ታ ቡሳይ ኮሽያባ ግድኮ ኤንቲ ታራ ባናዉ ዳንዳኦሶና።<verse eid="1CO 16:4"/></para>
  <para style="s1">ጳዉሎሳ ሀልቾ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>ታኒ ማቀዶነራ አናዉ ቆፕዳ ግሾ፥ ያ ባዳ ህንተኮ ያና።<note caller="-" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="ACT 19:21">ሀዋ 19:21</ref>.</char></note> <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>ታ ብያ በሳ አዉ ግድኮካ፥ ታ ቡሳን ህንተ ታና ማዳና መላ ህንተ ማታን ጉ ዎደ ጋምኦና አግከ። ባልጎ አጌናታ ህንተ ማታን አና ዋያ አጋና። <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>ታኒ ኦገራ አሸ ህንተና በአናዉ ኮይከ። ጎዳይ ጊኮ፥ ህንተ ማታን ጉ ዎደ ታካናዉ ቆፓይስ።<verse eid="1CO 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8"/>ሽን ታኒ ጳንፀቆስፀ ባለይ ጋካናዉ ኤፈሶናን ጋምአና። <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>ታዉ ኦሶይ ኩምዳ ዳልጋ ፐንገይ ዶየትስ፥ ሽን ዳሮ ኤቀትያ ሞርከት ደኦሶና።<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ሌወ 23:15-21</ref>፤ <ref loc="DEU 16:9-11">ዛረ 16:9-11</ref>፤ <ref loc="ACT 19:8-10">ሀዋ 19:8-10</ref>.</char></note><verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>እ ታ መላ ጎዳ ኦሶ ኦያ አስ ግድያ ግሾ፥ ፅሞትዮስ ህንተኮ ቢኮ፥ ህንተ ማታን እ ህርጎና ዳና መላ ኦተ።<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="2CO 4:17">2 ቆሮ 4:17</ref>.</char></note> <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>ኦንካ እያ ካፖ። እ ታኮ ሳሮ ስማና መላ እያ ማድድ ሞይዝተ። ታኒ እ ሀንኮ አማነይሳታራ ስማናይሳ ናጋይስ።<verse eid="1CO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12"/>ኑ እሻ አጵሎስ ሀንኮ አማነይሳታራ ህንተኮ ባና መላ ታ እያ ምን ዎሳስ። ሀእ ህንተኮ ባናዉ ኮይቤና፥ ሽን እያዉ እንጀትያ ዎደ ህንተኮ ባና።<verse eid="1CO 16:12"/></para>
  <para style="s1">ዞረነ ሳሮ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>ባርክተ፤ አማኖን ኤቅተ፤ ፃልተ፤ ምንተ። <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>ኦሶ ኡባ ሲቆን ኦተ።<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15"/>ታ እሻቶ፥ እስፅፋኖሰይነ እያ ሶ አሳይ አካያን ኤንቲ ኮይሮ አማንዳይሳታ ግደይሳነ አማነይሳታ ማዳናዉ ባንታና አድ እምዳይሳ ህንተ ኤሬታ።<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="2CO 1:16">2 ቆሮ 1:16</ref>.</char></note> <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>ህንተካ ኤንታ መላ አሳስነ፥ ኤንታራ ኦሶን ዳቡርያ ኡባስ ኪተታና መላ ታ ህንተና ዎሳይስ።<verse eid="1CO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17"/>እስፅፋኖሰይ፥ ፈርዶናፅስነ አካይቆስ ታኮ ይዳይስ ታና ኡፋይስስ። ህንተ ባይና በሳን ኤንቲ ህንተና ግድድ ታ ፓጫ ኩንዶሶና። <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>ኤንቲ ህንተና ኡፋይስዳይሳዳ ታናካ ኡፋይስዶሶና። ሄሳ መላ አሳታ ዶጎፕተ።<verse eid="1CO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19"/>ኢሰ ዎሳ ኬ አሳይ ህንተና ሳሮ ጎሶና። አቅልነ ጵርስቅላ ባንታ ሶን ሺቅያ ዎሳ ኬ አሳራ እስፈ ህንተና ጎዳ ሱንን ዎዛናፐ ሳሮሶና።<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሀዋ 18:2</ref>.</char></note> <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>አማንያ እሻት ኡባይ ህንተና ሳሮ ያጎሶና።</para>
  <para style="p" vid="1CO 16:20">ጌሻ ዬረተ ዬረትሸ እሶይ እሱዋ ሳሮተ። <verse eid="1CO 16:20"/><verse number="21" style="v" sid="1CO 16:21"/>ታኒ፥ ጳዉሎስ፥ ሀ ሳሮዋ ታ ኩሸን ፃፋስ።<verse eid="1CO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22"/>ጎዳ ዶሶና አስ ደእኮ፥ ባደትዳይሳ ግዶ። ኑ ጎዳዉ፥ ሃያ!<verse eid="1CO 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23"/>ጎዳ የሱስ ክርስቶሳ አ ኬሀተይ ህንተራ ግዶ።<verse eid="1CO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24"/>ታ ሲቆይ ክርስቶስ የሱሳን ደእያ ህንተ ኡባራ ግዶ። አምንእ።<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
