<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ኤራታ ማፃፋ</para>
  <para style="toc1">ኤራታ ማፃፋ</para>
  <para style="toc3">ኤራ</para>
  <para style="toc2">ኤራታ</para>
  <para style="mt">ኤራታ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ኤራታ ማፃፋን አሳ ደኦይ ቃን ግደይሳ ፃላላ ግዶናሽን፥ ዳቡራን፥ ዳጋማን፥ ፕርዳ ጌላተንነ ፆነተን ኩምዳይሳ በሳናሳ። ሄሳ ግሾ ፃፈይ፥ “አሳ ደኦይ ሀዳ” ያግድ ባ ቆፋ ቆንጭሴስ። ሀ ጭንጫ ኡራይ፥ አሳ ደኡዋ ዉርሰ ጋካናዉ ዎችያ ፆሳ ኦሱዋ አኬካናዉ ፆነትስ። ግዶሽን፥ አስ ባ ደእዳ ላይ ኡባን ባዉ ዳንዳኤትዳባ ኡባ ምንድ ኦናዉ በሰይሳነ ፆሳይ እምዳባን ኡፋይታናዉ ኮሸይሳ ዞሬስ።</para>
  <para style="ip">ኤራ ኡራ ቆፋታፐ ዳሮት ኡሎነ ዞኮ ግድዳ ቆፋታንነ ኡፋይሳ ቃንፆን ኩምዳ ቆፋታ በሴስ። ግዶሽን፥ ሀ ማፃፋይ ጌሻ ማፃፋ ቦላ ኤቅዳ አማኖይ ሀር አቶሽን፥ ጋሄቶናነ ስን ኩምዳ ቆፋታ ባ ጋን ኦይካና ጋካናዉ ዳልጋ ግደይሳ በሴስ።</para>
  <para style="ip">ሀ ኤራታ ማፃፋይ አሳ ደኦ ማስቶተዳ በሲያ ግሾ፥ ዳሮ አሳት ሀ ማፃፋፐ ምን ደምዶሶና። ሄሳዳካ፥ ሀ ቆፋታ ኦይክዳ ጌሻ ማፃፋይ፥ ደኦስ ግታ ብርሸ እምያ ፆሳን ኡፋይስ ኦና መላ ዞሬስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ዱሳ ብርሸ (<char style="ior"><ref loc="ECC 1:1-2:26">1:1—2:26</ref></char>)</para>
  <para style="io1">ኡባባስ ዎደይ ደኤስ (<char style="ior"><ref loc="ECC 3:1-8">3:1-8</ref></char>)</para>
  <para style="io1">ጭንጫተን ደአ (<char style="ior"><ref loc="ECC 3:9-6:12">3:9—6:12</ref></char>)</para>
  <para style="io1">ዎንቶባ ኦንካ ኤረና (<char style="ior"><ref loc="ECC 7:1-11:6">7:1—11:6</ref></char>)</para>
  <para style="io1">ፆሰ ቦንቻ እያዉ ኪተታ (<char style="ior"><ref loc="ECC 11:7-12:14">11:7—12:14</ref></char>)</para>
  <chapter number="1" style="c" sid="ECC 1"/>
  <para style="s1">ኡባባይ ሀዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1"/>ሀይስ፥ ዳዊታ ናኣ፥ የሩሳላመን ካዎትዳ ጭንጫ ኡራ ቃላ።<verse eid="ECC 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 1:2"/>ሄ ጭንጫይ፥ “ኡባባይ ሀዳ፤</para>
  <para style="q2" vid="ECC 1:2">ኡባባይ ሀዳፐ ሀዳ፤</para>
  <para style="q2" vid="ECC 1:2">ኡባባይ ኩመ ሀዳ” ያግስ።<verse eid="ECC 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3"/>ባ ደእያ በሳን ኡባን፥</para>
  <para style="q2" vid="ECC 1:3">አስ ዳቡርድ ኦያባ ኡባን</para>
  <para style="q2" vid="ECC 1:3">እያዉ ዎይ አይቤ?<verse eid="ECC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4"/>እስ የለተ አያ ዎደ፥ ሀራ የለተ በሳ ኦይኬስ።</para>
  <para style="q2" vid="ECC 1:4">ሽን ሀ ቢታይ መርናዉካ ላመቶና ደኤስ።<verse eid="ECC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5"/>አው ዶሌስ ዉሌስ፤</para>
  <para style="q2" vid="ECC 1:5">ናምአን ዶላናዉ ያ ዶልያ በሳ ኤለሴስ።<verse eid="ECC 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6"/>ጫርኮይ እስ ቶሆ ዱገ እስ ቶሆ ፑደ ጫርኬስ፤</para>
  <para style="q2" vid="ECC 1:6">ቃስ ዩይ ዩይ አድ፥ ስመረትድ ዬስ።<verse eid="ECC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7"/>ጎግያ ሃ ኡባይ አባን ገሌስ፤</para>
  <para style="q2" vid="ECC 1:7">ሽን አባይ ኩም ኤረና።</para>
  <para style="q1" vid="ECC 1:7">ሄ ሃይ ስሚድ ጎጋናዉ፥</para>
  <para style="q2" vid="ECC 1:7">ጉየ ባ ፑልትያ በሳ ቤስ።<verse eid="ECC 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8"/>ኡባባይ ሳለያባ፤</para>
  <para style="q2" vid="ECC 1:8">እ አይ መላ ሳለያኮ ኦድ ዉርሳናዉ ዳንዳኤተና።</para>
  <para style="q1" vid="ECC 1:8">አይፈይ ፄልድ ካል ኤረና፤</para>
  <para style="q2" vid="ECC 1:8">ሀይ ስእድ፥ ታዉ ግድስ ጌና።<verse eid="ECC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9"/>ካሰ ሀንዳባይ ዎንቶካ ስሚድ እ ሀናና፤</para>
  <para style="q2" vid="ECC 1:9">ቃስ ሀእ ሀንሸ ደኤይስ ካሰ ሀንዳባ።</para>
  <para style="q2" vid="ECC 1:9">ሄሳ ግሾ፥ ሳሎ ጉፋንን ኦራባይ አይብካ ባዋ።<verse eid="ECC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10"/>ኦንካ፥ “ሄኮ፥ ሀይስ ኦራባ” ጊኮ፥</para>
  <para style="q2" vid="ECC 1:10">ሄስ ኦራ ግደና፤ ሄስ ኑኒ የለታናፐ ካሰ ሀንዳባ።<verse eid="ECC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11"/>ካሰ አዳ ዎደታን ሀንዳባታ ዛሪድ ሀሳያባይ ባዋ፤</para>
  <para style="q2" vid="ECC 1:11">ጉየፐ ሀናናባታ ኤንታፈ ጉየ ኦንካ ሀሳየና።<verse eid="ECC 1:11"/></para>
  <para style="s1">ጭንጫተ ሀዳ</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12"/>ታኒ ጭንጫይ፥ የሩሳላመን እስራኤለስ ካዎ ግዳዳ ደአስ። <verse eid="ECC 1:12"/><verse number="13" style="v" sid="ECC 1:13"/>ታኒ ሳአን ደእያባ ኡባ ሻካዳ ኤራናዉነ ጭንጫተን ፕልጋዳ ፄላናዉ ቆፋ ቃቻስ። ያታዳ አሳ ኡባስ ፆሳይ እምዳ ደኦይ ዳሮ ዳቡርስያባነ ኡፋይሶናባ ግደይሳ አኬካስ። <verse eid="ECC 1:13"/><verse number="14" style="v" sid="ECC 1:14"/>ሳሎፐ ጋርሳን ሀንዳባ ኡባ ታኒ በአስ፤ ሽን ኡባይካ ሀዳ፤ ጫርኮ ኦይካናዉ የደይሳ መላ።<verse eid="ECC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15"/>ጌል ሱራናዉ ዳንዳኤና፤</para>
  <para style="q2" vid="ECC 1:15">ባይናባ ታይባናዉ ዳንዳኤተና።<verse eid="ECC 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16"/>ታኒ ታ ዎዛናን ሀይሳዳ ያጋዳ ቆፓስ፤ “ታፐ ካሰ የሩሳላመ ሃርዳ ኡባታፐ ታኒ ግታነ ጭንጫ ግዳስ። ጭንጫተነ ኤራ ጉስ እ አይበኮ ፓጫዳ ኤራስ” ያጋስ። <verse eid="ECC 1:16"/><verse number="17" style="v" sid="ECC 1:17"/>ታኒ ጭንጫተፈ፥ ጎሻተፈነ ኤያተፈ ግዶን ደእያ ዱማተ አይበኮ ኤራናዉ ዳሮ ዳቡራስ። ሽን ዉርሰን ሄስካ ጫርኮ ኦይካናዉ የደይሳ መላ ሀዳ ግደይሳ ኤራስ።<verse eid="ECC 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 1:18"/>ጭንጫተ ዳርያ ዎደ አዛንያባይ ዳሬስ፤</para>
  <para style="q2" vid="ECC 1:18">ኤር ዳርያ ዎደ ቃስ መቶይ ዳሬስ።<verse eid="ECC 1:18"/></para>
  <chapter eid="ECC 1"/>
  <chapter number="2" style="c" sid="ECC 2"/>
  <para style="s1">ባና ዶሶይ ሀዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1"/>ታኒ ታኮ፥ “ሃያ፥ ታ ነና ኡፋይስ አይበኮ ኤርሳናዉ ሎኦባ በሳና” ያጋስ፤ ሽን ሄስካ ሀዳ። <verse eid="ECC 2:1"/><verse number="2" style="v" sid="ECC 2:2"/>ሚች ኤያተ ግደይሳ፥ ቃስ ሚኮይነ ኡፋይስ አይኮካ ጎኦናይሳ አኬካስ። <verse eid="ECC 2:2"/><verse number="3" style="v" sid="ECC 2:3"/>ሀእካ ታ ዎዛናይ ጭንጫተን ታና ካለሽን፥ ታና ዎይነ ኡሻን ኡፋይሳናዉ፥ ኤያካ ግዳናዉ ፓጫስ። አስ ባ ቃን ዎደን ሳሎፐ ጋርሳን ደእያባ ቦላ አይ ኦኮ ጎአነኮ ኤራናዉ ኮያስ።<verse eid="ECC 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4"/>እስ ግታባ ኦስ፤ ታ ዳና ኬታ ኬፃስ፤ ዎይነ ቶካስ። <verse eid="ECC 2:4"/><verse number="5" style="v" sid="ECC 2:5"/>ዱማ ዱማ አታክልትያነ አይፈ አይፍያ ምታ ቶካስ፤ አስ ሸምፕያ በሳ ጊግሳስ። ሄ በሳን ዱማ ዱማ አይፈ አይፍያ ምታ ቶካስ። <verse eid="ECC 2:5"/><verse number="6" style="v" sid="ECC 2:6"/>ሄ ምታ ኡሻናዉ፥ ሃ ዳጋያ በሲ ዜራዳ ጊግሳስ። <verse eid="ECC 2:6"/><verse number="7" style="v" sid="ECC 2:7"/>አደነ ማጫ አይለታ ሻማስ፤ ቃስ ታ ሶን የለትዳ ሀራ አይለትካ ታዉ ደኦሶና። ታፐ ካሰ የሩሳላመን ደእዳ አሳፐ አያ መሄ፥ ዴሸነ ዶርሰ ሃራስ። <verse eid="ECC 2:7"/><verse number="8" style="v" sid="ECC 2:8"/>ታ ሃርያ ዱማ ዱማ ቢታታፐነ ካዎታፐ ቦንቸትዳ ቡቁራ ኤህሳዳ፥ ዳሮ ዎርቃነ ብራ ታዉ ዳጋያስ። ቃስ፥ ታና ሳቢድ የፅያ አደነ ማጫ ሺሻስ፤ ሄሳ ቦላ፥ አሳስ ኡፋይስ እምያ ዳሮ ማጫሳታ ሺሻስ።<verse eid="ECC 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9"/>ታኒ ካሰ የሩሳላመን ደእዳ ኦደፈካ አዳ ግታ አስ ግዳስ። ታ ጭንጫተይካ ታራ ዉርሰ ጋካናዉ ደእስ። <verse eid="ECC 2:9"/><verse number="10" style="v" sid="ECC 2:10"/>ታ አይፈይ ፄልዳባነ ታ ዎዛናይ አሞትዳባ ኡባ ደማስ፤ ታ አሳተይ ኮይያ ኡፋይስ ኡባ ድጋብከ። ታኒ ኦዳ ኦሶ ኡባን ኡፋይታስ፤ ታ ዳቡራ ዎይ ሄሳ። <verse eid="ECC 2:10"/><verse number="11" style="v" sid="ECC 2:11"/>ግዶሽን፥ ሄሳ ኡባ ኦ ስማዳ ታኒ አኬክያ ዎደ፥ ዳሮ ታኒ እያዉ ዳቡርዳ ኡባይ ሀዳ ግደይሳ በአስ። ሳሎፐ ጋርሳን ጎእያባይ አይኮይ ባዋ፤ ኡባይ ጫርኮ ኦይካናዉ የደያ መላ።<verse eid="ECC 2:11"/></para>
  <para style="s1">ጭንጫተነ ኤያተ ሀዳ</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12"/>ሄሳፈ ጉየ፥ ታኒ ጭንጫተ፥ ኤያተነ ጎሻተ አይበኮ ፓጫዳ ኤራናዉ ቆፋ ዶማስ። አዉደ ግድንካ ካዎይ ኦናዉ ዳንዳኤይ እያፐ ካሰ ካዎትዳ ካዎይ ኦዳይሳፈ ሀራባይ አይብ ደኢ? <verse eid="ECC 2:12"/><verse number="13" style="v" sid="ECC 2:13"/>ፖኦይ ማፐ፥ ጭንጫተ ኤያተፈ ሎኦ ግደይሳ ታኒ በአስ። <verse eid="ECC 2:13"/><verse number="14" style="v" sid="ECC 2:14"/>ጭንጫ አሳ አይፈት እያ ሁጵያ ግዶን ደኦሶና፤ ሽን ኤያት ማን ሄመቶሶና። ግዶሽን፥ ኤንታ ናምኣ ዉርሰይ እስኖ ግደይሳ አኬካስ።<verse eid="ECC 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 2:15"/>ታኒ ታኮ፥ “ኤያ ጋከያ ቃዳይ ታናካ ጋኬስ፤ ያትን፥ ታኒ ጭንጫ ግደይስ ታና አይ ማዲ?” ያጋዳ ቆፓስ። ቃስ ታኒ ታ ዎዛናን፥ “ሀይስካ ሀዳ” ያጋስ። <verse eid="ECC 2:15"/><verse number="16" style="v" sid="ECC 2:16"/>ኤያ ግድን ጭንጫ፥ ሀይቆፐ ጉየ፥ እያ ሀሳየይ ባዋ፤ ስንፈ ያ ላይን ኑኒ ኡባይ ዶገትድ አታና። ኤያይ ሀይቀይሳዳ፥ ጭንጫይካ ሀይቄስ።<verse eid="ECC 2:16"/></para>
  <para style="s1">ኦሶን ዳቡር ሀዳ</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17"/>መቶፐ አትሽን፥ ጎእያባይ ባይና ግሾ፥ ሀ ደኦይ ታና ሻትስ። ሄስካ ሀዳ፤ ጫርኮ ኦይካናዉ የደያ መላ። <verse eid="ECC 2:17"/><verse number="18" style="v" sid="ECC 2:18"/>ሳሎፐ ጋርሳን ታኒ ዳሮ ዳቡራዳ ደምዳ ታ ሻሉዋ ኡባ ታፐ ጉየራ ያ ኡራስ አጋዳ ብያ ግሾ፥ ታኒ ዳቡርዳ ኡባይ ታና ሻትስ። <verse eid="ECC 2:18"/><verse number="19" style="v" sid="ECC 2:19"/>ታፐ ጉየራ ያ አደይ ጭንጨኮ ኤየኮ ኦን ኤሪ? ሽን እ ኦና ግድንካ፥ ታኒ ዳሮ ዳቡርዳባነ ታ ጭንጫተን ደምዳባ ኡባ ባዉ ኤክድ፥ ጎዳ ግዳና፤ ሄስካ ሀዳ።<verse eid="ECC 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 2:20"/>ሄሳ ግሾ፥ ሳሎፐ ጋርሳን ታ ዳቡርዳባ ቦላ ታ ዎዛናይ ኡፋይስ ቃንፅስ። <verse eid="ECC 2:20"/><verse number="21" style="v" sid="ECC 2:21"/>አስ ባ ደእዳ ላይን ባዉ ደእዳ ጭንጫተን፥ ኤራንነ ሂላን ዳቡርድ ደምዳባ ኡባ አይኮካ ዳቡሮናይሳስ የግድ ቤስ። ሄስካ ሀዳነ ግታ ቆሆ። <verse eid="ECC 2:21"/><verse number="22" style="v" sid="ECC 2:22"/>ያትን፥ ሳሎፐ ጋርሳን አስ ዳሮ ዳቡርድ ኦዳባ ኡባፈ አይ ጎአ ደሚ? <verse eid="ECC 2:22"/><verse number="23" style="v" sid="ECC 2:23"/>እ ባ ደኦ ላይን ዳቡርያ ዳቡር ኡባይ አዛኖፐነ ሙደፈ አትሽን፥ ሀር አይብካ እያዉ ጉጀና፤ ሀር አቶሽን ቃማካ እያ ሁጰይ ቆፋፐ ሸምፐና፤ ሄ ኡባይካ ሀዳ።<verse eid="ECC 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24"/>ህዛ አሳስ ጎአ ግድያባይ አይበ ጊኮ፥ አስ ምድ ኡይድ ባ ዳቡራን ኡፋይታናይሳ። ሄ ኡፋይሳይ ቃስ ፆሳ ኩሽያፐ እመትዳባ ግደይሳ ታኒ አኬካስ።<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ECC 3:13">ኤራ 3:13</ref>፤ <ref loc="ECC 5:18">5:18</ref>፤ <ref loc="ECC 9:7">9:7</ref>፤ <ref loc="LUK 12:19">ሉቃ 12:19</ref>፤ <ref loc="1CO 15:32">1 ቆሮ 15:32</ref>.</char></note> <verse eid="ECC 2:24"/><verse number="25" style="v" sid="ECC 2:25"/>እያ ሸነ ግዶና፥ ምን ኡይን አሳስ ኡፋይስ አዉን ደኢ? <verse eid="ECC 2:25"/><verse number="26" style="v" sid="ECC 2:26"/>ፆሳ ኡፋይስያ ኡራስ ፆሳይ ጭንጫተ፥ ኤራተነ ኡፋይስ እሜስ፤ ናጋራንቹዋስ እ ዳቡርድ ሺሻና መላ፥ ዳቡራ እሜስ። ሽን እ ሺሽዳይሳ ፆሳይ ኤክድ፥ ባዉ ያይያ ሀራስ እሜስ። ሄሳ ግሾ፥ ሀ ኡባይ ሀዳነ ጫርኮ ኦይካናዉ የደ መላ።<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="JOB 32:8">እዮ 32:8</ref>፤ <ref loc="PRO 2:6">ሌም 2:6</ref>.</char></note><verse eid="ECC 2:26"/></para>
  <chapter eid="ECC 2"/>
  <chapter number="3" style="c" sid="ECC 3"/>
  <para style="s1">ኡባባስ ዎደይ ደኤስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1"/>ኡባባስ ዎደይ ደኤስ፤ ሳሎፐ ጋርሳን ኦሰትያባ ኡባስ</para>
  <para style="q2" vid="ECC 3:1">ዎደይነ ቃም ደኤስ።<verse eid="ECC 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2"/>የለታናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:2">ሀይቃናዉ ዎደይ ደኤስ።</para>
  <para style="q1" vid="ECC 3:2">ቶካናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:2">ሾዳናዉ ዎደይ ደኤስ።<verse eid="ECC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3"/>ዎናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:3">ፓናዉ ዎደይ ደኤስ።</para>
  <para style="q1" vid="ECC 3:3">ላላናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:3">ኬፃናዉ ዎደይ ደኤስ።<verse eid="ECC 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4"/>ዬካናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:4">ሚጫናዉ ዎደይ ደኤስ።</para>
  <para style="q1" vid="ECC 3:4">ካዮታናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:4">የፃናዉ ዎደይ ደኤስ።<verse eid="ECC 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 3:5"/>ሹቹ ላላናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:5">ሹቹ ሺሻናዉ ዎደይ ደኤስ።</para>
  <para style="q1" vid="ECC 3:5">ቆመታናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:5">ዱፃናዉ ዎደይ ደኤስ።<verse eid="ECC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6"/>ኮያናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:6">ኮሽ አጋናዉ ዎደይ ደኤስ።</para>
  <para style="q1" vid="ECC 3:6">ሺሽ ኦይካናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:6">ላላናዉ ዎደይ ደኤስ።<verse eid="ECC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 3:7"/>ፔናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:7">ስካናዉ ዎደይ ደኤስ።</para>
  <para style="q1" vid="ECC 3:7">ስእ ጋናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:7">ኦደታናዉ ዎደይ ደኤስ።<verse eid="ECC 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8"/>ዶሳናዉ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:8">እፃናዉ ዎደይ ደኤስ።</para>
  <para style="q1" vid="ECC 3:8">ኦላስ ዎደይ ደኤስ፤</para>
  <para style="q2" vid="ECC 3:8">ሳሮ ዳናዉ ዎደይ ደኤስ።<verse eid="ECC 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9"/>ያትን፥ ኦሳንቾይ ባ ዳቡርዳ ዳቡራፐ አይ ዎ ደሚ? <verse eid="ECC 3:9"/><verse number="10" style="v" sid="ECC 3:10"/>ታኒ ቃስ፥ አሳ ናእ ዳቡርድ ኦና መላ፥ ፆሳይ እምዳ ቶሆይ ዳሮ ዴፆ ግደይሳ በአስ። <verse eid="ECC 3:10"/><verse number="11" style="v" sid="ECC 3:11"/>ፆሳይ ኡባባ እያ ዎድያን ዎድያን ሎይድ ኦስ። ፆሳይ አሳ ዎዛናን መርናተ ዎስ፤ ግድኮካ፥ ፆሳይ ኦዳባ ኡባ ኮይሮፐ ዉርሰ ጋካናዉ፥ አስ ኩመ ኤራናዉ ዳንዳኤና። <verse eid="ECC 3:11"/><verse number="12" style="v" sid="ECC 3:12"/>አስ ባ ደእዳ ላይን ሎእያባ ኦይሳፈነ፥ ኡፋይተይሳፈ አያባይ አይብካ ባይናይሳ ታኒ አኬካስ። <verse eid="ECC 3:12"/><verse number="13" style="v" sid="ECC 3:13"/>ቃስ፥ አሳስ ኦ ዳቡርድ ደምያ ዳቡራስ ጋተይ፥ ምድነ ኡይድ ኡፋይተይስ ፆሳፈ እያዉ እመትዳ እሞታ።<verse eid="ECC 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 3:14"/>ፆሳይ ኦዳባ ኡባይ መርናዉ ደኤይሳ ታኒ ኤራስ፤ እ ኦዳባ ቦላ ጉጃናዉ ዎይኮ እያፐ ደንናዉ ኦደስካ ዳንዳኤተና። ፆሲ ሄሳ ኦይ፥ አስ እያ ያይድ ቦንቻና መላሳ። <verse eid="ECC 3:14"/><verse number="15" style="v" sid="ECC 3:15"/>ሀእ ሀንሸ ደእያባይ ዎይኮ ስንፈ ሀናናዉ ደእያባ ኡባይ ካሰ ሀንዳባ፤ ፆሳይ ካሰ ሀንዳባይ ዛር ሀናናዳ ኮዬስ።<verse eid="ECC 3:15"/></para>
  <para style="s1">ፕርዳ ጌላተ</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16"/>ቃስ ታኒ፥ ሳሎፐ ጋርሳን ፅሎ ፕርዳ በሳን ኢታተ፥ ፅሎተ በሳን ገነይ ደኤይሳ በአስ። <verse eid="ECC 3:16"/><verse number="17" style="v" sid="ECC 3:17"/>ታ ዎዛናን፥ “ፆሳይ ፅሉዋነ ዎርዱዋ ናምኣካ ፕርዳስ ሺሻና፤ ፆሳይ ሀንዳባ ኡባስነ ኦሶ ኡባስ ዎደ ቃንፅ ዎስ” ያጋዳ ቆፓስ።<verse eid="ECC 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18"/>ታኒ ታኮ፥ “አስ ዶአፐ ዱማቶናይሳ ኤንቲ አኬካና መላ ፆሳይ ኤንታ ፓጬስ” ያጋስ። <verse eid="ECC 3:18"/><verse number="19" style="v" sid="ECC 3:19"/>አሰ ግድን፥ ዶአ ግድን፥ ኤንታ ቃዳይ እስኖ፤ እሶይ ሀይቀይሳዳ፥ ሀንኮይካ ሀይቄስ። ናምአይ እስ ጫርኮ ሸምፖሶና፤ ሄሳ ግሾ፥ አስ ዶአፐ ዱማተና፤ ሄስካ ሀዳ። <verse eid="ECC 3:19"/><verse number="20" style="v" sid="ECC 3:20"/>ኤንቲ ናምአይ እስ በሲ ቦሶና፤ ናምአይ ቢታፈ መትዳ ግሾ፥ ቢታ ስሞሶና። <verse eid="ECC 3:20"/><verse number="21" style="v" sid="ECC 3:21"/>ያትን፥ አሳ ሸምፖይ ሳሎ ፑደ ከየይሳነ ዶአ ሸምፖይ ቢታ ዱገ ዎይሳ ሻክድ ኤረይ ኦኔ? <verse eid="ECC 3:21"/><verse number="22" style="v" sid="ECC 3:22"/>አስ ባ ኦዳ ኦሶን ኡፋይተይሳፈ ሎእያ ሀራባይ እያዉ ባይናይሳ በአስ። እያዉ ደእያ ሎኦ ቃዳይ ሄሳ ፃላላ። አስ ሀይቅ ስምን እያፐ ጉየ ሀንያባ በሳናዉ፥ እያ ጉየ ኤሀናዉ ዳንዳኤይ ኦኔ?<verse eid="ECC 3:22"/></para>
  <chapter eid="ECC 3"/>
  <chapter number="4" style="c" sid="ECC 4"/>
  <para style="s1">ገነ፥ ዳቡራነ ብዛተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1"/>ታኒ ዛራዳ፥ ሳሎፐ ጋርሳን አይ መላ ናቆይ ደእያኮ በአስ። ናቀተይሳት ምን ይድ ዬኮሶና። ናቀይሳታ ኩሸን ማት ደእያ ግሾ ናቀተይሳታ ማደይ ባዋ። <verse eid="ECC 4:1"/><verse number="2" style="v" sid="ECC 4:2"/>ታኒ፥ “ሀእ ፓፃ ደኤይሳታፐ ካሰ ሀይቅዳይሳት ሎኦ” ያጋስ። <verse eid="ECC 4:2"/><verse number="3" style="v" sid="ECC 4:3"/>ግዶሽን፥ ሀ ናምአታፐ አድ የለትቦናይሳታነ ሳሎፐ ጋርሳን ኦሰትያ ናቁዋ በኦናይሳታ ቃዳይ ሎኦ።<verse eid="ECC 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4"/>አሳ ዳቡርነ አሞትዳባ ደሞይ፥ አሳስ ባ ላግያ ቦላ ደእያ ቃናተፐ ፑልተይሳ በአስ። ሄስካ ሀዳ፤ ጫርኮ ኦይካናዉ ካሎ መላ። <verse eid="ECC 4:4"/><verse number="5" style="v" sid="ECC 4:5"/>ባ ኩሸ እድምድ ኡትያ አዛላይ ኮሻን ሀይቄስ። <verse eid="ECC 4:5"/><verse number="6" style="v" sid="ECC 4:6"/>ዳቡራንነ ጫርኮ ካሎን ደምያ ዳኮባፐ ዎፓን ደምያ እስ ኩሸይ ሎኦ።<verse eid="ECC 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7"/>ሳሎፐ ጋርሳን ሀዳ ግድዳባ ሀራባ በአስ። <verse eid="ECC 4:7"/><verse number="8" style="v" sid="ECC 4:8"/>ሄስካ ናእ ዎይኮ እሽ ባይና እስ ብዛ አደይ ደኤስ። ሽን እያ ዳቡራስ ዛው ባዋ፤ ባዉ ደእያባን አለና። እ ባና፥ “ታ ሀይሳ ኦደስ ዳቡራይና? ታኒ ታና አይስ ኡፋይስ ድጋድና?” ያግድ ኦይችስ። ሄስካ ቃስ ሀዳነ መቶ ደኦ።<verse eid="ECC 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 4:9"/>ባንታ ኦሱዋን ሎኦ አይፈ ደምያ ግሾ እስኖ ግደይሳፈ ናምአ ግደይስ ሎኦ። <verse eid="ECC 4:9"/><verse number="10" style="v" sid="ECC 4:10"/>ናምኣፈ እሶይ ኩንድኮ እሶይ ደንስ፤ ሽን ባርካ ደእያ ኡራይ ኩንድኮ እያ ደንይ ባይና ግሾ እያ አየ! <verse eid="ECC 4:10"/><verse number="11" style="v" sid="ECC 4:11"/>ናምአይ እስፈ ዝንእኮ ሆኤስ፤ ሽን ባርካ ዝንእያ ኡራ ዋንድ ሆአናዉ ዳንዳኢ? <verse eid="ECC 4:11"/><verse number="12" style="v" sid="ECC 4:12"/>እስ አስ ባርካ ተቃናዉ ዳንዳኦና መቱዋ ናምኡ አሳት ተቃናዉ ዳንዳኦሶና። ሄ አይፈን ዶቀትዳ ዎዶሮይ ኤለ ዱፀና።<verse eid="ECC 4:12"/></para>
  <para style="s1">አሳፐ አድ በንቶይ ሀዳ</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13"/>ዞረ ኤኮና ኤያነ ጬጋ ካዉዋፐ ማንቆነ ጭንጫ ግድዳ ናአተ ካዎይ ሎኦ። <verse eid="ECC 4:13"/><verse number="14" style="v" sid="ECC 4:14"/>ሄ ናአተይ ቃሾ ኬፈ ከይድ ዎይኮ ማንቆተፈ ደንድድ ካዎ ግዳናዉ ዳንዳኤስ። <verse eid="ECC 4:14"/><verse number="15" style="v" sid="ECC 4:15"/>ሳሎፐ ጋርሳን ደእያነ ስመረትያ አሳ ኡባይ ካዋ ላትያ ናአተ ካለይሳ በአስ። <verse eid="ECC 4:15"/><verse number="16" style="v" sid="ECC 4:16"/>እስ ካዎይ ሃርያ አሳ ታይቦይ ዳሮ ግዳናዉ ዳንዳኤስ። ሽን ካልያ የለተይ እያ ካዎተን ኡፋይትቤና። ሄስካ ሀዳ፤ ጫርኮ ኦይካናዉ ካሎ መላ።<verse eid="ECC 4:16"/></para>
  <chapter eid="ECC 4"/>
  <chapter number="5" style="c" sid="ECC 5"/>
  <para style="s1">ፆሰ ያያ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1"/>ፆሳ ኬ ገልያ ዎደ አኬካዳ ታንጋ። ኤንቲ ባንታ ኢታ ኦሱዋ ኤሮና ግሾ፥ ስአናዉ ሺቆይ ኤያታ ያርሹዋፈ አስ። <verse eid="ECC 5:1"/><verse number="2" style="v" sid="ECC 5:2"/>ኦደታናዉ ኤሶቶፓ፤ ፆሳ ስንን ኦደታናዉ ነ ዎዛናን ድርጎፋ። ፆሳይ ሳሎና፥ ኔኒ ሳአና፤ ሄሳ ግሾ፥ ነ ቃላይ ጉ ግዶ። <verse eid="ECC 5:2"/><verse number="3" style="v" sid="ECC 5:3"/>ቆፍ ዳርያ ዎደ አሙሆይ ዳሬስ፤ ኦዳ ዳሮይ ኤያተ ቆንጭሴስ። <verse eid="ECC 5:3"/><verse number="4" style="v" sid="ECC 5:4"/>ፆሳስ ገፕዳባ ፖላናዉ ጋምኦፋ፤ ኤያታን ፆሳይ ኡፋይተና። ሄሳ ግሾ፥ ኔኒ ገፕዳባ ኡባ ፖላ። <verse eid="ECC 5:4"/><verse number="5" style="v" sid="ECC 5:5"/>እስባ ገፕድ ፖሎና አጋናፐ ኮይሮ ገፖና አጎይ ሎኦ። <verse eid="ECC 5:5"/><verse number="6" style="v" sid="ECC 5:6"/>ናጋራን ነና ገልሶና መላ ነ እንፃርሳ የዳ ኦፋ። ፆሳ ኬን ኦይሳኮ፥ “ኮይሮ ሀይሳ ታኒ አኬኮና ገፓስ” ጎፓ። ሄስ ፆሳ ዳሮ ሀንቀያ ግሾ፥ ነ ኩሸ ኦሶ ኡባ እ ባ ሀንቁዋን ይሳናዉ ዳንዳኤስ። <verse eid="ECC 5:6"/><verse number="7" style="v" sid="ECC 5:7"/>ዳሮ አሙሆይነ ዳሮ ኦድ ሀዳ። ሄሳ ግሾ፥ ፆሳ ያያ።<verse eid="ECC 5:7"/></para>
  <para style="s1">ዱረተ ሀዳ</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8"/>እስ ቢታን ማንቆት ናቀትሽን፥ ፕርድ ጌላትሽን ኔኒ በእኮ ማላለቶፋ። እስ እስ ሀላቃስ እያፐ ቦላራ ሹመትድ እያ ፄልያ ሀራ ሀላቅ ደኤስ። ቃስ ኤንታፈ ቦላራ ሹመትድ ኤንታ ፄልያ ሀራ ሀላቃት ደኦሶና። <verse eid="ECC 5:8"/><verse number="9" style="v" sid="ECC 5:9"/>ቢታፈ በንትያ ዎይ ኡባሳ፤ ሀር አቶሽን፥ ካዎይካ ጎሻፈ ጎኤቴስ።<verse eid="ECC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 5:10"/>ብራ ዶስያ ኡራስ ብር ግድ ኤረና፤ ዱረተ ሲቅያ ኡራይ ሚሸ ካል ኤረና፤ ሄ ኡባይ ሀዳ። <verse eid="ECC 5:10"/><verse number="11" style="v" sid="ECC 5:11"/>ዱረተ ዳርያ ዎደ ምያ አስ ዳሬስ። ባ ሻሉዋ ጮ አይፈን ፄልድ፥ “ታኒ ዱረ” ጋናፐ ሀራባ አይ ማዲ?<verse eid="ECC 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 5:12"/>ኦሶ ኦያ አስ ጉ ምን ዳሮ ምን፥ ሳሮ ስኮ ስኬስ፤ ሽን ዱረይ ባ ዱረተስ ኡባ ዎደ ኡንኤትያ ግሾ ስኮ ይድ ደኤስ።<verse eid="ECC 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13"/>ሳሎፐ ጋርሳን ዳሮ አዛንያባ ሀራባ ታኒ በአስ። ሄስካ ኢታ ዎደ ባና አሾ ግድ ምንጅዳ ሻሎ፥ <verse eid="ECC 5:13"/><verse number="14" style="v" sid="ECC 5:14"/>ዎይኮ እስ ኢታባይ ጋክን ይዳ ዱረተ። እ ናአ የልዳባ ግድኮካ ናኣ ላትስያባ ይድ መላ አቴስ። <verse eid="ECC 5:14"/><verse number="15" style="v" sid="ECC 5:15"/>አስ ኡባይ ካሎ የለትዳይሳዳ መላ ኩሸ ስሚድ ባና። አይ መላ እ ዳቡርድ ኦኮካ ኤክድ ብያባይ ባዋ።<verse eid="ECC 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 5:16"/>አስ ካሎ የለትድ ካሎ ጉየ ስመይስ ዳሮ አዛንያ ኢታባ። እያ ዳቡራ ኡባይ ጫርኮ ኦይክያባዳ ሀዳ ግድኮ እያ አይ ማዲ? <verse eid="ECC 5:16"/><verse number="17" style="v" sid="ECC 5:17"/>እ ባ ላይ ኡባ ማ ደኦን፥ አዛኖን፥ ዬላን፥ ሀርገንነ ይሎን ዉርሴስ።<verse eid="ECC 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18"/>ህዛ፥ ታኒ አኬክዳ እስ ሎኦባይ፥ ሳሎፐ ጋርሳን ፆሲ አሳስ እምዳ ቃን ላይን፥ አስ ባ ዳቡራፐ ምድ ኡይድ ኡፋይተይስ ሎኦነ በሲያባ፤ እያ ቃዳይ ሄሳ። <verse eid="ECC 5:18"/><verse number="19" style="v" sid="ECC 5:19"/>ፆሲ አሳስ ዱረተነ ሻሎ እመይ፥ ባ ዳቡራ ጋትያ ደምድ፥ ምድ ኡይድ ኡፋይታና መላሳ፤ ሄስካ ፆሳፈ እያዉ እመትዳ እሞታ። <verse eid="ECC 5:19"/><verse number="20" style="v" sid="ECC 5:20"/>ፆሲ እያ ዎዛናን ኡባ ዎደ ኡፋይስ ኩንያ ግሾ እ ባ ደኦ ላይባ ዳሮ ቆፐና።<verse eid="ECC 5:20"/></para>
  <chapter eid="ECC 5"/>
  <chapter number="6" style="c" sid="ECC 6"/>
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1"/>ሳሎፐ ጋርሳን አሳ ቦላ ጋክያ ዳሮ ኢታባ ታኒ በአስ። <verse eid="ECC 6:1"/><verse number="2" style="v" sid="ECC 6:2"/>ፆሲ አሳስ ሻሎ፥ ዱረተነ ቦንቾ እሜስ፤ እያዉ ኮሽያባፐ እስባካ ፓጭሰና። ሽን እያዉ እመትዳ ሻሉዋንነ ዱረተን ኡፋይታና መላ ኩመ ማታ እመና። ሄሳ ፃላላ ግዶናሽን እ ዳቡርድ ደምዳባን ሀር ኡፋይታና መላ ኦስ፤ ሄስካ ሀዳነ አዛንያ ኢታባ።<verse eid="ECC 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3"/>እስ አስ ፄቱ ናአ የልድ፥ አዱሳ ላይ ደእድ ጭማናዉ ዳንዳኤስ። ሽን እ ባዉ እመትዳባን ኡፋይቶናነ ዉርሰን ቦንቾን ሞገቶና አትኮ እያፐ ቦሽ ሎኦ ጋይስ። <verse eid="ECC 6:3"/><verse number="4" style="v" sid="ECC 6:4"/>ሄ ቦሻይ ጮ የለትድ ኦንካ ሀሳዮና ማ ብያ ግሾ እያ ሱንይ ማን ካመትድ አቴስ። <verse eid="ECC 6:4"/><verse number="5" style="v" sid="ECC 6:5"/>እ፥ አዋ ፖኦ በኦና ዎይኮ አይብባካ ኤሮና አትኮካ ሄ ኡራፐ አድ እያዉ ሸምፖይ ደኤስ። <verse eid="ECC 6:5"/><verse number="6" style="v" sid="ECC 6:6"/>ሄሳ ግሾ፥ ኡፋይስ ባይና ናምኡ ሙኩሉ ላይ ደእያ አሳፐ ሄ ቦሻ ቃዳይ ሎኦ። ዉርሰን ናምአይ እስ በሲ ቦሶና።<verse eid="ECC 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 6:7"/>አስ ዳቡርድ ኦያ ኡባይ ባዉ ምያባ ደማናሳ፤ ሽን እያ አሞይ አል ኤረና። <verse eid="ECC 6:7"/><verse number="8" style="v" sid="ECC 6:8"/>ያትን፥ ጭንጫ አስ ኤያ አሳፐ አይብን ዱማቲ? ማንቆይ ዳሮ ጭንጭድ፥ ሀራታ ስንን ዋንድ ዳነኮ ኤሮይ እያ አይ ማዲ? <verse eid="ECC 6:8"/><verse number="9" style="v" sid="ECC 6:9"/>አሞን ፁገታናፐ አይፈን በኦይ ሎኦ፤<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">አይፈን በኦይ ሎኦ፦ አስ አሞን ፁገትሸ ዳናፐ ባዉ ደእያባን አልድ ደኦ ጉሱ።</char></note> ሄስካ ጫርኮ ኦይካናዉ ካሎ መላ ሀዳ።<verse eid="ECC 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 6:10"/>ሀንያባ ኡባይ ኮይሮትድ ኤረትድ ደኤስ። እስ እስ አስ ዋናናዉ ደእያኮ አዱሳ ዎደፐ ካሰ ኤረትድ ኡትስ። አይ አስካ ባፐ ምነይሳራ ባፀታናዉ ዳንዳኤና። <verse eid="ECC 6:10"/><verse number="11" style="v" sid="ECC 6:11"/>ኦድ ዳርያ ዎደ ሀዳባይ ዳሬስ፤ ያትን ሄስ አሰ አይ ማዲ?<verse eid="ECC 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 6:12"/>ሀዳ ግድድ ኩያዳ ጮ አያ ባ ጉ ላይ አስ ዋትድ አናዉ ኮሽያኮ ኤረይ ኦኔ? አስ ሀይቅድ አግን ሳሎፐ ጋርሳን ሀናናዉ ደእያባ አሳስ ኦዳናዉ ዳንዳኤይ ኦኔ?<verse eid="ECC 6:12"/></para>
  <chapter eid="ECC 6"/>
  <chapter number="7" style="c" sid="ECC 7"/>
  <para style="s1">ጭንጫተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 7:1"/>አልኦ ሽቶፈ ሎኦ ሱን አስ፤</para>
  <para style="q2" vid="ECC 7:1">የለትያ ጋላሳፐ ሀይቆ ጋላስ ሎኦ።<verse eid="ECC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2"/>አሳ ኡባ ዉርሰይ ሀይቆ ግድዳ ግሾ፥</para>
  <para style="q2" vid="ECC 7:2">ግብራ ኬ በይሳፈ ዬሆ ኬ በይስ ሎኦ፤</para>
  <para style="q2" vid="ECC 7:2">ደኦን ደእያ አስ ሄሳ ባ ዎዛናን ዎናዉ ኮሼስ።<verse eid="ECC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3"/>አዛኖይ ሶምኦ ካሬኮካ፥</para>
  <para style="q2" vid="ECC 7:3">ዎዛና ፖእስያ ግሾ ሚቻፈ አዛኖይ ሎኦ።<verse eid="ECC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4"/>ጭንጫ አሳ ዎዛን ዬሆ ሶን ደኤስ፤</para>
  <para style="q2" vid="ECC 7:4">ሽን ኤያ አሳ ዎዛን ኡፋይሳ ሶን ደኤስ።<verse eid="ECC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5"/>ኤያታ የ ስአናፐ</para>
  <para style="q2" vid="ECC 7:5">ጭንጫታ ሴራ ስስ ሎኦ።<verse eid="ECC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6"/>ኤያ አሳ ሚች አጉንን ታማ የድን</para>
  <para style="q2" vid="ECC 7:6">ቀይሳ መላ፤ ሄስካ ሀዳ።<verse eid="ECC 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7"/>ገነ ኦሶይ ጭንጫ አስ ኤያ ከሴስ፤</para>
  <para style="q2" vid="ECC 7:7">ዎፈ ኤኮይ ዎዛና ኢሴስ።<verse eid="ECC 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8"/>ዶመፈ ዉርሰ ሎኦ፤</para>
  <para style="q2" vid="ECC 7:8">ኦቶሮፐ ዳንዳእ ሎኦ።<verse eid="ECC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9"/>ኤያታ ሀንቆይ ኤንታ ክኦን ደእያ ግሾ፥</para>
  <para style="q2" vid="ECC 7:9">ኔኒ ነ ሸምፑዋን ሀንቆስ ኤለሶፓ።<verse eid="ECC 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 7:10"/>“ሀእ ዎድያፐ ካሰ ዎደይ አይስ ሎኦ ግድዴ?” ጋዳ ኦይቾፋ፤</para>
  <para style="q2" vid="ECC 7:10">ሄሳ መላ ኦይሾይ ጭንጫ አስ ኦይችያ ኦይሾ ግደና።<verse eid="ECC 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11"/>ሀ ሳአን ደእያ አስ ኡባይ ጭንጫ ግዳናዉ ኮሼስ፤</para>
  <para style="q2" vid="ECC 7:11">ጭንጫተ ደሞይ ላታፐ ሎኦ።<verse eid="ECC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12"/>ሚሸይ አሰ ኢታፐ ካምድ አሸይሳዳ ጭንጫተካ አሼስ።</para>
  <para style="q2" vid="ECC 7:12">ሽን ጭንጫተ ሚሸፐ አይ አሳ ደኦ ናጋናዉ ዳንዳእያ ግሾሳ።<verse eid="ECC 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 7:13"/>አነ ፆሲ ኦዳባ አኬካ!</para>
  <para style="q2" vid="ECC 7:13">ፆሲ ጌላይዳባ ኦን ሱርሳናዉ ዳንዳኢ? <verse eid="ECC 7:13"/><verse number="14" style="v" sid="ECC 7:14"/>ሳእ ጊግዳ ዎደ ኡፋይታ፤ መቶይ ጋክያ ዎደ አኬካ።</para>
  <para style="q2" vid="ECC 7:14">ኡፋይስ ግድን መቶ ግድን ፆሲ የድያ ዎደን ዬስ።</para>
  <para style="q2" vid="ECC 7:14">ሽን አዉስ ኮይሮትድ ያነኮ ኔኒ ኤራካ።<verse eid="ECC 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15"/>ሀ ሀዳ ግድዳ ታ ላይን ዳሮባ በአስ። ሄስካ፥ ጌላይ ባ ጌላተን አዱሳ ላይ ደእያ ዎደ ፅሎይ ቃን ላይን ሀይቄስ። <verse eid="ECC 7:15"/><verse number="16" style="v" sid="ECC 7:16"/>ሄሳ ግሾ፥ ኔኒ ኤለ ዮናዳ ዳሮ ፅሎ ዎይኮ ዳሮ ጭንጫ ግዶፓ። <verse eid="ECC 7:16"/><verse number="17" style="v" sid="ECC 7:17"/>ኔኒ ዎደይ ጋኮና ሀይቆናዳ አዳ ኢታ ግዶፓ፤ አዳ ኤያ ግዶፓ። <verse eid="ECC 7:17"/><verse number="18" style="v" sid="ECC 7:18"/>ሀ ኡባን ፆሰ ያያ፤ አስ መቶ ኡባ ፆኖን ከያናዉ ዳንዳእያ ግሾ ኔኒ ዳሮ ኢታ ዎይኮ ዳሮ ፅሎ ግዶናሽን ግዶ አስ ግዳ።<verse eid="ECC 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 7:19"/>ጭንጫተ ጭንጫስ እምያ ዎልቃይ እስ ካታማ ሃርያ ታሙ አሳታ ዎልቃፈ አስ።<verse eid="ECC 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 7:20"/>ፅሎባ ፃላላ ኦድ ናጋራ ኦና ደእያ አስ ሀ ሳኣ ቦላ ባዋ።<verse eid="ECC 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 7:21"/>አስ ሃሳያ ቃላ ኡባ ስአዳ ፖላና ጎፓ፤ ኔኒ ኡባ ስአና ጊኮ ነ አይለይ ነና ባድሽን ስአና። <verse eid="ECC 7:21"/><verse number="22" style="v" sid="ECC 7:22"/>ቃስ ኔኒ ነ ሁጰን ሀራታ ባድያባ ነ ዎዛናይ ኤሬስ።<verse eid="ECC 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23"/>ሄሳ ኡባ ታኒ ጭንጫተን ፕልጋዳ በአስ። ያታዳ፥ “ታኒ ጭንጫ ግዳና” ያጋስ። ሽን ታኒ ግዳይሳዳ ሀንቤና። <verse eid="ECC 7:23"/><verse number="24" style="v" sid="ECC 7:24"/>ጭንጫተ ኡባ ዎደ ሃሆን ደእያባነ ጪሞባ፤ ያትን፥ እያ ኮይድ ደማናዉ ዳንዳኤይ ኦኔ? <verse eid="ECC 7:24"/><verse number="25" style="v" sid="ECC 7:25"/>ታኒ ፕልጋዳ ፄላናዉ ጭንጫተነ ኦዳ ኡባ ዉርሰ ኤራናዉ ቆፓስ። ናጋር ኤያተ፥ ኤያተ ጎሻተ ግደይሳ ኤራናዉ ጋካስ።<verse eid="ECC 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ECC 7:26"/>ታኒ ሀይቆፐ አድ ጫምያ ሀራባ ደማስ። ሄስካ፥ እ ዎዛናይ ግተ፥ እ ኩሸይ ሳንላታ ግድድ ፅሄዳ ኦይክያ እስ ማጫስ በአስ። ፆሰ ያይያ አስ ኢፐ ከስ ኤካና፤ ሽን ናጋራንቹዋ እያ ባ ፅህያን ፃፃዳ ኦይካና።<verse eid="ECC 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ECC 7:27"/>አስታማረይ ሀይሳዳ ያግስ፤ “ታኒ ፕልጋዳ ደምዳባይ ሀይሳ። <verse eid="ECC 7:27"/><verse number="28" style="v" sid="ECC 7:28"/>ሄስካ፥ ታኒ ሀች ጋካናዉ ኮያዳ ደማቦናባ። ሙኩሉ አደ አሳ ግዶፈ ቦንቾይ በሲያ እስ አደ ፃላላ ደማስ፤ ሽን ማጫ አሳ ግዶፈ እስኖካ ደማናዉ ዳንዳአብከ። <verse eid="ECC 7:28"/><verse number="29" style="v" sid="ECC 7:29"/>ታኒ ፕልጋዳ ደምዳ ሀራባይ፥ ፆሲ አሰ ሱረ ቆፋራ መስ፤ ሽን አስ ዳሮ ገነ ኦገ ኮይድ ብስ” ያግስ።<verse eid="ECC 7:29"/></para>
  <chapter eid="ECC 7"/>
  <chapter number="8" style="c" sid="ECC 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 8:1"/>ጭንጫ አስ ዳነይ ኦኔ?</para>
  <para style="q2" vid="ECC 8:1">ኡባባስ ብርሸ ኤረይ ኦኔ?</para>
  <para style="q2" vid="ECC 8:1">ጭንጫተ ፓሽክስድ፥ ምዳ ሶምኡዋ ፖእሴስ።<verse eid="ECC 8:1"/></para>
  <para style="s1">ካዎስ ኪተታ</para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 8:2"/>ካዎስ ኪተታ፤ ካሰ ኔኒ ኪተታና</para>
  <para style="q2" vid="ECC 8:2">ጋዳ ፆሳ ስንን ጫቃዳሳ።<verse eid="ECC 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 8:3"/>ካዋ ስንፈ ኤለሳዳ ከዮፓ፤ ካዎይ ባ ኮይዳባ ኦናዉ ዳንዳእያ ግሾ ኢታ ኦሶ ኦናዉ ደንዶፋ። <verse eid="ECC 8:3"/><verse number="4" style="v" sid="ECC 8:4"/>ኡባባ ኦናዉ ካዋስ ማት ደእያ ግሾ፥ “አይስ ሀይሳ ኦዲ?” ያግድ እያ ኦይቻናዉ ዳንዳኤይ ኦኔ? <verse eid="ECC 8:4"/><verse number="5" style="v" sid="ECC 8:5"/>እያ ኪታ ፖልያ አስ ቆሄተና፤ ጭንጫ አስ ልከ ዎድያነ ኦያ ኦግያ ኤሬስ። <verse eid="ECC 8:5"/><verse number="6" style="v" sid="ECC 8:6"/>አሰ ዴፆ መቶይ ጋክኮካ ኡባባስ ዎደይነ ኦገይ ደኤስ። <verse eid="ECC 8:6"/><verse number="7" style="v" sid="ECC 8:7"/>ስንፈ ሀናናባ ኤርያ አስ ባዋ፤ “ሀይስ ሀናና” ግድ ኦዳናዉ ዳንዳኤይ ኦኔ? <verse eid="ECC 8:7"/><verse number="8" style="v" sid="ECC 8:8"/>ሸምፖይ ሻከትድ ብያ ጋላስ ኦይክድ ተቃናዉ ዳንዳእያ አስ ባዋ፤ ዎይኮ ሀይቆይ ባ ጋላሳን ዮናዳ ድጋናዉ ዳንዳእያ አስ ባዋ። ኦላ ዎደ ኦንካ ኦለትከ ጋናዉ ዳንዳኦናይሳዳ ኢታተ ኢታ ኦያ ኡራ የደና። <verse eid="ECC 8:8"/><verse number="9" style="v" sid="ECC 8:9"/>ሳሎፐ ጋርሳን ሀንያባ ኡባ ታኒ አኬካዳ ቆፕያ ዎደ አስ ባዉ ደእያ ማታ ሀራ አስ ቆሀናዉ ጎኤተይሳ በአስ።<verse eid="ECC 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 8:10"/>ኢታ አሳት ቦንቾን ሞገትሽን በአስ። ኤንቲ ኢታተ ኦዳ ካታማ አሳይ ሺቅድ ኤንታ ሳቢሽን ስአስ፤ ሄስ ኡባይ ሀዳ።<verse eid="ECC 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11"/>አስ ቆፕድ ኢታባ ኦያ ጋሶይ፥ ኢታባ ኦዳ አሳታ ኤለስድ ሴረይ ባይና ግሾሳ። <verse eid="ECC 8:11"/><verse number="12" style="v" sid="ECC 8:12"/>ናጋራንቾይ ፄቱ ቶሆ ኢታባ ኦሽን እያ ባረይ አዱቅኮካ፥ ፆሰ ያየይሳታስነ ቦንቸይሳታስ ሳእ ሎአናይሳ ታ ኤራይስ። <verse eid="ECC 8:12"/><verse number="13" style="v" sid="ECC 8:13"/>ኢታት ፆሰ ያዮና ግሾ ሳሮተ ኤንታዉ ባዋ፤ ኤንቲ ፆሰ ያዮና ግሾ ኤንታ ባረይ ኩያዳ ቃማና።<verse eid="ECC 8:13"/></para>
  <para style="s1">አስ ፆሳ ኦገ ኤረና</para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14"/>ሀ ሳአን ኦሰትያ ሀራ ሀዳባይ ደኤስ። ሄስካ፥ ጌሻ አሳት፥ ናጋራንቾት ኤካናዉ በሲያ ሴራ ኤክያ ዎደ ናጋራንቾት ጌሻት ኤካናዉ በሲያ ሎኦባ ኤከይሳ፤ ሄስ ኡባይ ሀዳ። <verse eid="ECC 8:14"/><verse number="15" style="v" sid="ECC 8:15"/>አስ ምያባፐ፥ ኡያባፐነ ባና ኡፋይስያባፐ አድ ሎኦባይ ሳሎፐ ጋርሳን ሀር ባይና ግሾ፥ አስ ባ ደኦን ኡፋይትኮ ሎኦ ጋስ። ፆሲ እያዉ እምዳ ላይን እ ዳቡርድ ደምዳባን ኡፋይታናዉ ዳንዳኤስ።<verse eid="ECC 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16"/>ታኒ ጭንጫተ አይበኮ ኤራናዉነ አስ ሀ ሳአ ቦላ ዳቡርያ ዳቡራ አኬካናዉ ሀልቻስ፤ ዉርሰን አስ ስኮ ይድ ኦያ ኦሶይ ደኤይሳ በአስ። <verse eid="ECC 8:16"/><verse number="17" style="v" sid="ECC 8:17"/>ታኒ ፆሲ ኦዳባ ኡባ በአስ። ሳሎፐ ጋርሳን ኦሰትዳ ኦሶ አስ ፕልግድ ኤራናዉ ዳንዳኦናይሳ ኤራስ። አስ አይ መላ ዳቡርድ ፕልግ ፄልኮካ፥ እያ ብርሸ ኤራናዉ ዳንዳኤና። ቃስ ጭንጫ አስ ሀይሳ ኤራይስ ጋናዉ ዳንዳኤና።<verse eid="ECC 8:17"/></para>
  <chapter eid="ECC 8"/>
  <chapter number="9" style="c" sid="ECC 9"/>
  <para style="s1">ኡባ ናግያ ዉርሰ ቃዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1"/>ሀ ኡባ ታ ዎዛናን ቆፕዳፐ ጉየ ጭንጫትነ ፅሎት፥ ኤንታ ኦሶት ፆሳ ኩሸን ደኦሶና ጋዳ ኩያስ። ሽን ሲቆ ግድን ዎይኮ እፆ አይብ እያ ናግያኮ ኦንካ ኤረና። <verse eid="ECC 9:1"/><verse number="2" style="v" sid="ECC 9:2"/>ዱማተ ባይና ኡባ ጋክያ ቃዳይ እስኖ፤ ፅሎ ግድን ጌላ፥ ሎኦ ግድን ኢታ፥ ቱና ግድን ቱና ግዶና እፅን፥ ያርሾ ያርሸይሳ ግድን ያርሾናይሳ ኡባ ቃዳይ እስኖ። ሎኦ አሳስ ናጋራንቹዋፈ ሎእያ ቃድ ባዋ፤ ጫቆ ያየይስ ያዮናይሳፈ ዱማተና።<verse eid="ECC 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3"/>አሳ ኡባ ቃዳይ እስኖ ግደይስ፥ ሀ ሳአን ደእያ ሀራ ኢታተ መላ ዳሮ ኢታ። አስ ደኦን ደእዳ ላይ ኡባን እያ ዎዛናይ ኢታተንነ ጎሻተን ኩምድ ደኤስ፤ ዉርሰን ሀይቅድ አጌስ። <verse eid="ECC 9:3"/><verse number="4" style="v" sid="ECC 9:4"/>ሀይቅዳ ጋሞፈ ፓፃ ደእያ ካን ሎኦ፤ ደኦን ደኤይሳታራ ደእያ ኡራስ ኡፋይስ ደኤስ።<verse eid="ECC 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 9:5"/>ደኦን ደእያ አሳት እስ ቶሆ ሀይቃናዉ ደኤይሳ ኤሮሶና፤ ሽን ሀይቅዳይሳት እስባካ ኤሮኮና። ኤንቲ ዶገትዳይሳታ ግድያ ግሾ አይኮካ ማዶኮና። <verse eid="ECC 9:5"/><verse number="6" style="v" sid="ECC 9:6"/>ኤንታ ሲቆይ፥ እፆይነ ቃናተ ኡባይ ኤንታራ እስፈ ዬስ። ህዛፐ ጉየ ሳሎፐ ጋርሳን ሀንያባ ኡባን መርናዉ ኤንታዉ ቃድ ባዋ።<verse eid="ECC 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7"/>ባ፥ ነ ካ ኡፋይሳን ማ፤ ነ ዎይነ ኡሻ ነ ዎዛናይ ኡፋይትን ኡያ። ፆሳይ ሄሳ ነዉ ካሰፐ ጊግስድ ዎስ። <verse eid="ECC 9:7"/><verse number="8" style="v" sid="ECC 9:8"/>ኡባ ዎደ ነ ማኦይ ቦ ግዶ፤ ነ ሁጰን ዛይተ ትያ። <verse eid="ECC 9:8"/><verse number="9" style="v" sid="ECC 9:9"/>ሳሎፐ ጋርሳን ፆሳይ ነዉ እምዳ ሀ ሀዳ ደኡዋን፥ ሀዳ ግድዳ ነ ቃማታን ነ ሲቅያ ነ ማቸራ ኡፋይታዳ ደአ። ኔኒ ሳሎፐ ጋርሳን ዳቡራዳ ኦዳባ ኡባፈ ነና ጋክያ ሳማይ ሄሳ። <verse eid="ECC 9:9"/><verse number="10" style="v" sid="ECC 9:10"/>ነ ኩሸይ ኦናዉ ደምዳባ ኡባ ነ ኩመ ዎልቃን ኦ፤ ኔኒ ባና ዱፉዋን ኦሶይ ዎይኮ ሀልቾይ ዎይኮ ኤር ዎይኮ ጭንጫተ ባዋ።<verse eid="ECC 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11"/>ታኒ ሳሎፐ ጋርሳን ሀራባ በአስ። ሄስካ፥ ኤሶን ዎፀይሳት ኡባ ዎደ ፆኖኮና፤ ምኖ ኦላንቾት ኡባ ዎደ ኦላን ካንኮና፤ ጭንጫት ኡባ ዎደ ካ ደሞኮና፤ ሂላንቾት ኡባ ዎደ ዱረቶኮና፤ ታማርዳ አሳት ኡባ ዎደ ሳበቶኮና። ሽን ኡባ ቃድነ ዎደይ ጋዳይሳዳ ሀኔስ።<verse eid="ECC 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 9:12"/>ግዶሽን ሄ ዎደይ አዉደ ያነኮ ኤራናዉ ዳንዳእያ አስ ባዋ። ካፎይ ፅሄን ገለይሳዳ ዎይኮ ሞሎይ ግተን ኦይከተይሳዳ አስ ኡባይ ቆፖና ጋክያ ኢታ ዎደን ኦይከቴስ።<verse eid="ECC 9:12"/></para>
  <para style="s1">ጭንጫተነ ኤያተ</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13"/>ሳሎፐ ጋርሳን ታኒ በእዳባ ሀራባይ ደኤስ። ሄስካ ጭንጫተ ግታ ሌምሶ ግደይሳ። <verse eid="ECC 9:13"/><verse number="14" style="v" sid="ECC 9:14"/>ጉ አስ ደእያ እስ ጉ ካታምያ ደአዉሱ። ሄ ካታምዉ እስ ዎልቃማ ካዎይ ኦላናዉ ደንድስ፤ እዮ ተቅድ ኦይክስ። <verse eid="ECC 9:14"/><verse number="15" style="v" sid="ECC 9:15"/>ሄ ካታመን ማንቆ ግድዳ እስ ጭንጫ አደይ ደኤስ፤ እ ባ ጭንጫተን ሄ ካታምዉ አሽስ። ሽን ሄ ማንቆ አድያ ዛሪድ ሀሳይዳይ ባዋ። <verse eid="ECC 9:15"/><verse number="16" style="v" sid="ECC 9:16"/>ታኒ፥ “ጭንጫተ ዎልቃፈ አስ” ያጋስ። ግዶሽን፥ ጭንጫ ግድኮካ ማንቆ አስ ካቴስ፤ እ ኦድያባ ስኤይ ባዋ። <verse eid="ECC 9:16"/><verse number="17" style="v" sid="ECC 9:17"/>ሄስ ሀንኮካ፥ ደርያ ሃረይስ ኤያታ ሺቆን ዋስያ ዋሱዋ ስአናፐ ሎዳራ ኦደትያ ጭንጫ አሳ ቃላ ስኤይስ ሎኦ። <verse eid="ECC 9:17"/><verse number="18" style="v" sid="ECC 9:18"/>ጭንጫተ ኦላ ሚሸፐ አስ፤ ሽን እስ ናጋራንቾይ ዳሮ ሎኦባ ይሴስ።<verse eid="ECC 9:18"/></para>
  <chapter eid="ECC 9"/>
  <chapter number="10" style="c" sid="ECC 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ECC 10:1"/>ሀይቅዳ ኡዱንፀት ሳውያ ሽቱዋ ፅንቅሶሶና፤ ሄሳዳካ፥ ጉ ኤያተ ጭንጫተነ ግታ ቦንቹዋ ኢሴስ።<verse eid="ECC 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 10:2"/>ጭንጫ አሳ ዎዛናይ እያ ኡሻች ካለስ፤ ሽን ኤያ አሳ ዎዛን ሀድርስ ካለስ። <verse eid="ECC 10:2"/><verse number="3" style="v" sid="ECC 10:3"/>ኤያ አስ ኦገ ሄመትያ ዎደ እያዉ አኬክ ባዋ፤ እ ኤያ ግደይሳ አስ ኡባይ ኤሬስ።<verse eid="ECC 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 10:4"/>ነ ሀላቃይ ነ ቦላ ሀንቀትኮ ነ በሳ የዶፋ፤ ስእ ግድ ዳንዳኦይ ግታ ናጋራ አቶ ጊሴስ።<verse eid="ECC 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 10:5"/>ሳሎፐ ጋርሳን ታኒ በእዳ ሀራ ኢታባይ ደኤስ። ሄስካ ደርያ ሃረይሳት ኦያ ናቁዋ። <verse eid="ECC 10:5"/><verse number="6" style="v" sid="ECC 10:6"/>ኤያት ዳሮ ቃ ሹማተ ኦይክድ ደእያ ዎደ ዱረት ዝቃ በሳን ኡትዶሶና። <verse eid="ECC 10:6"/><verse number="7" style="v" sid="ECC 10:7"/>ታኒ አይለት ሃረይሳታዳ ፓራ ቶግድ ብሽን ቃስ ሃረይሳት አይለታዳ ቶሆን ሄመትሽን በአስ።<verse eid="ECC 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 10:8"/>ኦላ ቦክያ አስ ሄ ኦላን ኩንዴስ፤ ግምበ ድርስ ላልያ ኡራ ሾሽ ዱኬስ። <verse eid="ECC 10:8"/><verse number="9" style="v" sid="ECC 10:9"/>ሹቹ ደንያ አስ ሄ ሹቻን፥ ም ቀርያ አስ ሄ ምን ደሸቴስ።<verse eid="ECC 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 10:10"/>ዱንእዳ ካልታ ሌፎና ቀርኮ ዳሮ ዎልቃ ዉርሴስ፤ ሽን ጭንጫተን ኦያ ኦሱዋስ አይፈይ ደኤስ።<verse eid="ECC 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 10:11"/>ሾሽ ዱክ አግን ሾሹ ዶቅያ ለ ዎይስ ሄ ኡራ አይኮካ ማደና።<verse eid="ECC 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 10:12"/>ጭንጫ አሳ ኦድ እያዉ ቦንቾ እምሴስ፤ ሽን ኤያይ ባ ዶናፐ ከይዳ ቃላን ባዉ መቶን ገሌስ።<verse eid="ECC 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 10:13"/>ኤያይ ባ ሃሳያ ኤያ ቃላን ዶምድ፥ ኢታተንነ ጎሻተን ፖሌስ።<verse eid="ECC 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 10:14"/>ኤያ አስ ዳሮባ ኦደቴስ። ግዶሽን፥ ስንፈ ሀናናዉ ደእያባ ኦንካ ኤረና። አስ ሀይቅ አግን፥ ሀንያባ እያዉ ኦዳናዉ ዳንዳኤይ ባዋ።<verse eid="ECC 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 10:15"/>ኤያ አስ ባ ኦሶን ዳቡሬስ፤ እ ባ ሶ ብያ ኦግያ ኤረና።<verse eid="ECC 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 10:16"/>ናአ ግድዳ ካዎይነ ዎንታ ጉራ ግብራ ምያ ሀላቃት ደእያ ቢተ ነና አየ! <verse eid="ECC 10:16"/><verse number="17" style="v" sid="ECC 10:17"/>ቦንቸትዳ ካዎይነ ማታናዉ ግዶናሽን ዎልቃነ ምኖተ ደማናዉ ማራን ምያነ ኡያ ሀላቃት ደእያ ቢትያ አንጀትዳሮ።<verse eid="ECC 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 10:18"/>አደይ አዛላ ግድኮ እያ ካራይ ዎዴስ፤ እያ ኩሸይ ኦናባ ግድኮ፥ እያ ኬይ ፆኬስ።<verse eid="ECC 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 10:19"/>ካ ሙሳንነ ዎይነ ኡሻን ኡፋይስ በንቴስ፤ ሽን ሚሸይ ኡባባ ሻሜስ።<verse eid="ECC 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 10:20"/>ስእያ አስ ባዋ ጋዳ ነ ዎዛናን ካዎ ጫዮፓ፤ ዎይኮ ነ ዝንእያ ክፍልያን ዱረ ኡራ ባዶፋ። ነ ግዳይሳ ሳሎ ካፎይ ብድ ኤንታዉ ኦዳናዉ ዳንዳኤስ።<verse eid="ECC 10:20"/></para>
  <chapter eid="ECC 10"/>
  <chapter number="11" style="c" sid="ECC 11"/>
  <para style="s1">ዱማ ዱማ ዞረታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1"/>ነ ካ ሃ ቦላ የጋ፤ ዳሮ ጋላሳፐ ጉየ ኔኒ ዛራዳ ደማና። <verse eid="ECC 11:1"/><verse number="2" style="v" sid="ECC 11:2"/>ነዉ ደእያ ሻሉዋ ላፑን ዎይኮ ሆስፑን በሳን ሻካዳ ዎ። ስንፈ ሀ ሳኣ ቦላ አይ ኢታባይ ያነኮ ኔኒ ኤራካ።<verse eid="ECC 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 11:3"/>ሻር እራ ቶክኮ ቢታ ቦላ እር ቡኬስ።</para>
  <para style="p" vid="ECC 11:3">ም ፑደ ኩንድን ዱገ ኩንድን ባ ኩንድዳ በሳን ደኤስ።<verse eid="ECC 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 11:4"/>ጫርኮ ናግያ ኦንካ ካ ዘረና፤ ሻር ደንዳና ጋካናዉ ናግያ ኦንካ ባ ካ ጫከና።<verse eid="ECC 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 11:5"/>ጫርኮይ ብያ ኦግያነ ናእ ባ አየ ኡሎን ዋንድ መትያኮ ነ ኤሮናይሳዳ ኡባባ መዳ ፆሳይ ባ ኦሱዋ ዋት ኦያኮ ኤራናዉ ዳንዳአካ።<verse eid="ECC 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 11:6"/>ጉራ ግድን ኦማርስ ነ ዘረ ዘረይሳ አጎፋ፤ ዎንታይስ ዎይኮ ኦማርሳይስ ሎአነኮ ኔኒ ኤራካ።<verse eid="ECC 11:6"/></para>
  <para style="s1">ነ ናአተ ዎደን ፆሳ ቆፓ</para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 11:7"/>ፖኦይ ኡፋይስያባ፤ አዋ አይፈ በኦይ ሎኦባ። <verse eid="ECC 11:7"/><verse number="8" style="v" sid="ECC 11:8"/>አስ አዱሳ ላይ ሀ ሳአን ደእኮ ሄ ላይን ኡፋይቶ። ሽን ሀ አላምያባይ ሀዳ ግደይሳነ ያና ማ ዎደይ መርናዉ ዳናይሳ ቆፖ።<verse eid="ECC 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9"/>ነኖ ናአተዉ፥ ናአተ ዳሮ ሎኦባ ግድያ ግሾ ነ ናአተ ላይን ኡፋይታ፤ ነ ዎዛናይካ ኡፋይቶ። ነ አይፈይ በእዳባነ ነ ዎዛናይ አሞትዳባ ኡባ ፖላ። ሽን ሄ ኔኒ ኦዳባ ኡባ ግሾ ነና ፆሳይ ፕርዳናዉ ደኤይሳ ዶጎፓ።<verse eid="ECC 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 11:10"/>ናአተነ ጎባተ ሀዳ ግድያ ግሾ ነ ዎዛናፐ አዛኖ፥ ነ አሳተፈ ኢታተ ድጋ።<verse eid="ECC 11:10"/></para>
  <chapter eid="ECC 11"/>
  <chapter number="12" style="c" sid="ECC 12"/>
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1"/>ነ ናአተ ላይን ነና መዳይሳ ቆፓ። ኡንአ ጋላሳት ዮና ደእሽን፥ “ሀይስ ታና ኡፋይሰና” ጌተትያ ዎደት ጋኮና ደእሽን፥ <verse eid="ECC 12:1"/><verse number="2" style="v" sid="ECC 12:2"/>አውነ ፖኦይ፥ አጌንነ ፆልንቶት ሞና ደእሽን፥ እር ቡክድ አን፥ ሻር ስሞና ደእሽን፥ ነና መዳይሳ ቆፓ። <verse eid="ECC 12:2"/><verse number="3" style="v" sid="ECC 12:3"/>ሄ ዎደይ ኬ ናገይሳት ኮኮርያ ዎደ፥ ምኖ አስ ኩንያ ዎደ፥ ጋጨይሳት ታይቦን ጉፅዳ ግሾ ጋቸ አግያ ዎደነ ማስኮተራ ፄለይሳት ዳቡርያ ዎደ ግዳና። <verse eid="ECC 12:3"/><verse number="4" style="v" sid="ECC 12:4"/>ሄ ዎደይ፥ ዎጋ ኦግያኮ ስምዳ ፐንገት ጎርደትያ ዎደ፥ ጋጭያ ዎፃ ግርሳይ ዝቅ ግያ ዎደ፥ ካፎ ዋሶይ አሰ ስኮፈ ባርክስያ ዎደ፥ ማጫ ናይታ የ ግርሳይ ለፕያ ዎደ ግዳና። <verse eid="ECC 12:4"/><verse number="5" style="v" sid="ECC 12:5"/>ሄ ዎደይ፥ ደረ ከያናዉ ፆነትያ ዎደ፥ ዳልጋ ኦገታራ ሄመታናዉ ያሽያ ዎደ፥ ላዉዘ ም ጪይያ ዎደ፥ ቦለይ ቃፃናዉ ፆነትያ ዎደ፥ አሞያባይ አግያ ዎደ ግዳና። ሄ ዎደይ፥ አስ ባ መርና ኬ ብያ ዎደ፥ ዬከይሳት ዳልጋ ኦግያራ ዬክሸ ዩይያ ዎደ ግዳና።<verse eid="ECC 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 12:6"/>ብራ ሳንላታይ ዱፆና ደእሽን፥ ዎርቃ ከረይ መቆና ደእሽን፥ ሃ ኦቶይ ፑልቱዋ ማታን መቆና ደእሽን፥ ሃ ኦላፈ ጎች ከስያ ዎዶሮይ ዱፆና ደእሽን፥ <verse eid="ECC 12:6"/><verse number="7" style="v" sid="ECC 12:7"/>ቢታይ ቢታኮ ስሞና ደእሽን፥ ሸምፖይ ባና እምዳ ፆሳኮ ስሞና ደእሽን፥ ነና መዳይሳ ቆፓ። <verse eid="ECC 12:7"/><verse number="8" style="v" sid="ECC 12:8"/>አስታማረይ፥ “ሀዳ! ሀዳ! ኡባባይ ሀዳ” ያግስ።<verse eid="ECC 12:8"/></para>
  <para style="s1">ኩሻ ቆፋታ</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9"/>አስታማረይ ጭንጫ ፃላላ ግዶናሽን ኤራካ ግድያ ግሾ ደርያ ታማርስስ። እ ዳሮ ሌምሶታ ፕልግድ እሱዋ እሱዋ እያ ማራን ማራን ዱማይድ ዎስ። <verse eid="ECC 12:9"/><verse number="10" style="v" sid="ECC 12:10"/>አስታማረይ ልከ ግድዳ ቃላ ደማናዉ ኮይስ፤ ሄሳ ግሾ፥ እ ፃፍዳባይ ሱረነ ቱማ።<verse eid="ECC 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11"/>ጭንጫታ ቃላይ ሄንንቾይ ዉደ ላግያ ፄራ ኦጮ ፃምአ መላ። እስፈ ሺቅዳ ሌምሶት ጋ ኦይያ ምስማረ መላ።<verse eid="ECC 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 12:12"/>ታ ናአዉ፥ ሀ ኡባፈ ቦላራ ኔኒ ናገታናዉ ኮሽያባይ ደኤስ። ማፃፋ ፃፍድ ዉርሳናዉ ዳንዳኤተና። ቃስ ዳሮባ ፕልግድ አጎና እፆይ አሳተ ዳቡርሴስ።<verse eid="ECC 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 12:13"/>ሄኮ ኡባባይ ኦደትስ፤ ኡባባስ ኩሻይ ሀይሳ፤ ፆሰ ያይያ፤ እያ ኪታ ናጋ፤ ሄስ አሳስ ዋና ኦሶ። <verse eid="ECC 12:13"/><verse number="14" style="v" sid="ECC 12:14"/>ፆሳይ ኦሶ ኡባ ቃስ ጌምዳ ኡባ ሎኦ ግድን ኢታ ፕርዳናዉ ደኤስ።<verse eid="ECC 12:14"/></para>
  <chapter eid="ECC 12"/>
</usx>
