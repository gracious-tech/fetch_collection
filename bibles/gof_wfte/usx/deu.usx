<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="DEU" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ዛረ ማፃፋ</para>
  <para style="toc1">ዛረ ማፃፋ</para>
  <para style="toc3">ዛረ</para>
  <para style="toc2">ዛረ</para>
  <para style="mt">ዛረ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">“ዛረ ማፃፋ” ጌተትያ ሀ ማፃፋይ፥ እስራኤለ አሳይ ዳሮ ዎደ መላ ቢታን ሄመትዳፐ ጉየ፥ ካናነ ጋካናዉ ጉ አትሽን፥ ሞአበ ቢታን ጋምእዳ ዎደ ኡባን፥ ሙሰይ ሀይቃናፐ ስን፥ ዛር ዛር ኤንታዉ ኦድዳ ኦዳ ኦይክስ።</para>
  <para style="ip">ሙሰይ ሀ ማፃፋ እስራኤለ አሳስ ዛሪድ ፃፍዳ ግሾ ሀ ማፃፋይ፥ “ዛረ ዎጋ” ጌተትድ ሱንትስ።</para>
  <para style="ip">ሙሰይ፥ አዳ ኦይታሙ ላይታ ግዶን ፖለትዳ፥ ግታ ግታ ኦሶታ ሀሳይድ ኦዴስ። ፆሳይ ኤንታ መላ ቢታን ዋትድ ካለዳኮ አሳ ሀሳይስድ፥ ኤንቲ ፆሳስ አማነትዳ አስ ግዳና መላነ ሱረተን ኪተታና መላ ቆፍሴስ።</para>
  <para style="ip">ሙሰይ ታሙ ኪታታ ዛር ዛር ኦድድ፥ ኮይሮ ኪታ ብርሸ ኤንታዉ ቆንጭስስ። አሳይ ፆሳ ፃላላ ጎይናና መላ ሀሳይሴስ። እያራ ጋድ፥ እስራኤለ አሳይ ኡፋይስ ኦዳ ቢታን አቃና ዱማ ዱማ አይሶ ዎጋ ኦድስ። ሙሰይ፥ ፆሳይ ኤንታራ ጫቅዳ ጫቆይ አይ መለኮ ኤንታዉ ብርሽድ፥ ኤንቲ ሄ ጫቁዋ ኦራድ አማነታና መላ ኤንታ ቆፍሴስ።</para>
  <para style="ip">እያሱይ፥ ሙሰ በሳን ሹመትድ ፆሳ አሳ ካለያ አስ ግድስ። ሙሰይ፥ ፆሳይ አማነትያ ፆሰ ግደይሳ ሳባናዉ ከይድ፥ ማዝሙረ የፅዳፐነ እስራኤለ ኮቻ ኡባ አንጅዳፐ ጉየ፥ ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋን ደእያ ሞአበ ቢታን ሀይቅስ።</para>
  <para style="ip">ማፃፋ አይፈ ቆፋይ፥ ፆሳይ ባ ሲቁዋን ዶርዳ ባ አሳ አሽዳይሳነ አንጅዳይሳ ኦዴስ። ፆሳ አንጆይ ኤንታፈ ሻከቶና ደኦን ዳና መላ ፆሳይ ኤንታዉ ኦዳባ ኡባ አኬክሴስ። ኤንቲ ኡባ ዎደ ፆሳ ዶሳና መላነ እያዉ ኪተታና መላ ኤንታ ዞሬስ።</para>
  <para style="ip">ማፃፋ ዋና ቆፋ ኦይክዳ ፅቅሰይ፥ የሱሲ “ኪታ ኡባፈ አያ ኪታ” ያግድ ኦድዳ ቃላ ኦይክዳ (6:4-6) ክፍልያ። ሄስካ፥ “ነኖ፥ እስራኤለ ስአ፤ ጎዳይ ኑ ፆሳይ እስ ፆሲ። ጎዳ፥ ነ ፆሳ ነ ኩመ ዎዛናፐ፥ ነ ኩመ ሸምፑዋፈነ ነ ኩመ ዎልቃፈ ዶሳ” ያጌስ። ሀ ክፍለይ እስራኤለ ካዎተይ ኩመ ዎስያ ኤረትዳ ዎሳ ክፍለ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሙሰይ በን አዳ ታርከ ቆፍሴስ (<char style="ior"><ref loc="DEU 1:1-4:49">1:1—4:49</ref></char>)</para>
  <para style="io1">ፆሲ አሳፐ ኮየይ አይበኮ ሙሰይ አኬክሴስ (<char style="ior"><ref loc="DEU 5:1-28:68">5:1—28:68</ref></char>)</para>
  <para style="io1">አሳይ ባንታ ጫቅዳ ቃላ ፖላናዉ በሴስ (<char style="ior"><ref loc="DEU 29:1-30:20">29:1—30:20</ref></char>)</para>
  <para style="io1">እያሱይ አሳ ካለናዉ ሹመተ (<char style="ior"><ref loc="DEU 31:1-13">31:1-13</ref></char>)</para>
  <para style="io1">አሳይ ፆሳ ዶጋና (<char style="ior"><ref loc="DEU 31:14-29">31:14-29</ref></char>)</para>
  <para style="io1">ሙሰ ማዝሙረ (<char style="ior"><ref loc="DEU 31:30-32:47">31:30—32:47</ref></char>)</para>
  <para style="io1">ሙሰይ ቢታ በእስ፤ እስራኤለ ኮቻ አንጅስ (<char style="ior"><ref loc="DEU 32:48-33:29">32:48—33:29</ref></char>)</para>
  <para style="io1">ሙሰ ሀይቁዋ (<char style="ior"><ref loc="DEU 34:1-12">34:1-12</ref></char>)</para>
  <chapter number="1" style="c" sid="DEU 1"/>
  <para style="s1">እስራኤለት ሲናፐ ደንድዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 1:1"/>ሀ ማፃፋን ፃፈትዳ ቃላ ኡባይ ዮርዳኖሰ ሻፋፐ ሄፍንን ደእያ መላ ቢታን ኤንቲ ደእሽን፥ ሙሰይ እስራኤለ አሳስ ኦድዳ ቃላ። ሄ ዎደ ኤንቲ ሱፋፐ ስን ባጋራ ፓራና ካታማስ እስ ባጋራ፥ ቃስ ቶፌላ፥ ላባና፥ ሀፀሮታነ ድዛባ ካታማታ ግዶን ደእያ ዮርዳኖሰ ዛንጋራን ደኦሶና። <verse eid="DEU 1:1"/><verse number="2" style="v" sid="DEU 1:2"/>ሳይረ ደርያ ባጋራ ኮሬባ ዙማፐ ብድ ቃደስ-ባርነ ጋካናዉ ቶሆን ታማነ እስ ጋላሳ ኦገ።<verse eid="DEU 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 1:3"/>ግብፀፈ ኤንቲ ከይዳ ኦይታማን ላይን፥ ታማነ እስን አጌናን፥ ኮይሮ ጋላሳን፥ ጎዳይ ኤንታባ ሙሰ ኪትዳባ ኡባ እስራኤለ አሳስ ኦድስ። <verse eid="DEU 1:3"/><verse number="4" style="v" sid="DEU 1:4"/>ሄስ ሀንዳይ ሀሰቦና ካታማን ካዎትድ አሞረታ ሃርያ ስሆናነ አስታሮታንነ ኤድራአን ካዎትድ ባሳነ ሃርያ ኦገ፥ ሙሰይ ፆንዳፐ ጉየና።<verse eid="DEU 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 1:5"/>አሳይ ዮርዳኖሰፐ ዶሎሀ ባጋራ፥ ሞአበን ደእሽን፥ ሙሰይ ሀ ህግያ ሀይሳዳ ያግድ ኤንታዉ ቆንጭሰ ዶምስ።<verse eid="DEU 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 1:6"/>ኑኒ ኮሬባ ዙማ ቦላ ደእሽን፥ ጎዳይ፥ ኑ ፆሳይ ኑኮ ሀይሳዳ ያግስ። “ህንተ ሀ ደርያ ቦላ ዳሮ ጋምእደታ። <verse eid="DEU 1:6"/><verse number="7" style="v" sid="DEU 1:7"/>ዱንካንያ ላልተ፤ ደንድድ ደረይ ዳርያ አሞረታ ቢታነ አራባን ደእያ ኤንታ ዩሹዋን ደእያ ቢታ ኡባ ቢተ። ሄስካ ዮርዳኖሰ ዛንጋራ፥ ገዘነ ጋ ቢታ፥ ነገባነ መደትራነ አባ ጋፃ አተ። ካናነ ቢታ ቢተ፤ ልባኖሰ ደረታ ካንድ፥ ኤፍራፂሳ ሻፋ ጋካናዉ ቢተ። <verse eid="DEU 1:7"/><verse number="8" style="v" sid="DEU 1:8"/>ሄኮ፥ ታኒ ህንተዉ ሀ ቢታ እማስ። ብድ ህንተ አዋታስ፥ አብራሃመስ፥ ይሳቃስ፥ ያይቆባስነ ኤንታ ሼሻስ እማናዉ ጎዳይ ጫቅዳ ቢታ ላትተ” ያግስ።<verse eid="DEU 1:8"/></para>
  <para style="s1">ሙሰይ ሀላቃታ ሹምስ</para>
  <para style="r">(<ref loc="EXO 18:13-27">ከሳ 18:13-27</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 1:9"/>ሙሰይ አሳኮ፥ “ሄ ዎደ ታኒ ህንተዉ ሀይሳዳ ያጋዳ ኦዳስ፤ ታኒ ታርካ ህንተና ቶካናዉ ዳንዳእከ። <verse eid="DEU 1:9"/><verse number="10" style="v" sid="DEU 1:10"/>ጎዳይ፥ ህንተ ፆሳይ ህንተ ታይቡዋ ሳሎ ፆልንቶዳ ዳርስስ። <verse eid="DEU 1:10"/><verse number="11" style="v" sid="DEU 1:11"/>ጎዳይ ህንተ አዋታ ፆሳይ፥ ህንተና ሀይሳፈ አድ ሙኩሉ ቶሆ ጉጅድ ዳርሶነ እ ግዳይሳዳ ህንተና አንጆ። <verse eid="DEU 1:11"/><verse number="12" style="v" sid="DEU 1:12"/>ሽን ህንተ መቱዋ፥ ህንተ ቶሁዋነ ህንተ ኦሻ ኡባ ታኒ ታርካ ዋታ ቶካናዉ ዳንዳአይና? <verse eid="DEU 1:12"/><verse number="13" style="v" sid="DEU 1:13"/>ህንተ ኮቻታፐ ጭንጫ፥ አኬካንቾነ ቦንቸትዳ አሳታ ዶርተ፤ ታኒ ህንተ ቦላ ኤንታ ሀላቃ ኦና” ያግስ።<verse eid="DEU 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 1:14"/>ህንተ ዛሪድ፥ “ነ ቆፋይ ሎኦ” ያግደታ። <verse eid="DEU 1:14"/><verse number="15" style="v" sid="DEU 1:15"/>ሄሳ ግሾ፥ ታኒ ህንተ ኮቻፈ ጭንጫነ ቦንቸትዳ አሳታ ኤካዳ፥ ሻላቃ፥ ማቶ ሀላቃ፥ ሀምሳላቃነ አስራላቃ፥ ህንተና አይሰይሳታ ኦዳ ህንተ ቦላ ሹማስ።<verse eid="DEU 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 1:16"/>ታኒ ኤንታ፥ “ህንተ እሻታ ግዶን ደእያ ኦዳ ስእተ፤ ሄ ኦዳይ እስ እስራኤለ አሳፐነ እያ እሻፐ ግዶን ዎይኮ እስራኤለ አሳፐነ ሀራ ደረ አሳፐ ግዶን ደእያባ ግድኮካ፥ ኦዳ ስእድ ሱረ ፕርድተ። <verse eid="DEU 1:16"/><verse number="17" style="v" sid="DEU 1:17"/>ፕርድ ፆሳባ ግድያ ግሾ፥ ህንተ ፕርዳን እስ ባጋ ማዶፍተ፤ ግታ ስኤይሳዳ ጉ ስእተ፤ አሳ ሶምኦስ ያዮፍተ። ዳሮ ዴፆ ግድዳ ኦዳታ ታኮ ኤህተ፤ ሄሳ ታኒ ስአና።” <verse eid="DEU 1:17"/><verse number="18" style="v" sid="DEU 1:18"/>ህንተ ኦናባ ኡባ ታ ሄ ዎደ ህንተና ኪታና።<verse eid="DEU 1:18"/></para>
  <para style="s1">ካናነ ዎቻናዉ ኪተትዳ አሳታ</para>
  <para style="r">(<ref loc="NUM 13:1-33">ታይቦ 13:1-33</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 1:19"/>ሄሳፈ ጉየ፥ “ኑኒ ኮሬባ ዙማፐ ደንድዳ፤ ጎዳይ ኑ ፆሳይ ኑና ኪትዳይሳዳ፥ ደረይ ዳርያ አሞረታ ቢታ ብያ ኦገን ደእያ ሄ ህንተ በእዳ ግታነ ያሽያ መላ ቢታ ካንድ ቃደስ-ባርነ ጋክዳ። <verse eid="DEU 1:19"/><verse number="20" style="v" sid="DEU 1:20"/>ጎዳይ ኑ ፆሳይ ኑና ላትስያ፥ ደረይ ዳርያ አሞረታ ቢታይ ሀይሳ። <verse eid="DEU 1:20"/><verse number="21" style="v" sid="DEU 1:21"/>ጎዳይ ህንተ ፆሳይ ሀ ቢታ ህንተዉ እሚስ። ጎዳይ ህንተ አዋታ ፆሳይ ህንተዉ ኦድዳይሳዳ ከይድ፥ ሀ ቢታ ላትተ፤ ያዮፍተ፤ ኡፋይስ ቃንፆፍተ” ያጋስ።<verse eid="DEU 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 1:22"/>ህንተ ኡባይ ታኮ ይድ፥ “ሄ ቢታ ፆሞስድ፥ ኑ ባናዉ በሲያ ኦግያባነ ገላና ካታማታ ሀኖታ ነዉ ኤህያ አሳታ ኑፐ ስን የዶስ” ያግደታ።<verse eid="DEU 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 1:23"/>ሄ ቆፋይ ታዉ ሎኦ ዳንን፥ ህንተፈ ታማነ ናምኡ አሳ፥ ኮቻፈ ኮቻፈ እስ አስ ዶራስ። <verse eid="DEU 1:23"/><verse number="24" style="v" sid="DEU 1:24"/>ኤንቲ ብድ፥ ሄ ደረይ ዳርያ ቢታ ካንድ፥ ኤሽኮላ ዛንጋራ ጋካናዉ ደእያ ቢታ ዎችዶሶና። <verse eid="DEU 1:24"/><verse number="25" style="v" sid="DEU 1:25"/>ሄ ቢታን ዶልያባፐ ጉ አይፈ ባንታ ኩሸን ኦይክድ ኑኮ ይዶሶና። ቃስ፥ “ጎዳይ ኑ ፆሳይ ኑስ እምያ ቢታይ ሎኦ ቢታ” ግያ ዎረ ኤክድ ይዶሶና።<verse eid="DEU 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 1:26"/>ሽን ህንተ ጎዳ ህንተ ፆሳ ኪታ እፃስ ግድ ያ ቦና እፅደታ። <verse eid="DEU 1:26"/><verse number="27" style="v" sid="DEU 1:27"/>ህንተ ዱንካንያ ግዶን እሶይ እሱዋራ ሀይሳዳ ያግድ ዙዙምደታ። “ጎዳይ ኑና እፅዳ ግሾ፥ ይሳናዉ አሞረ ቢታ አሳታ ኩሸን አድ እማናዉ ግብፀ ቢታፈ ከስስ። <verse eid="DEU 1:27"/><verse number="28" style="v" sid="DEU 1:28"/>ያትን ያ አይስ ባኔ? ኑ እሻት፥ ‘ሄ ቢታን ደእያ አሳት ኑፐ ዳሮሶናነ አዱቆሶና። ካታማትካ ግታነ ሳሎ ጋካናዉ ግምበትዳይሳታ። ሄሳ ቦላ ቃስ አናቀ ጌተትያ ዳሮ አዱሳ አሳታ ያን በእዳ’ ያግድ፥ ኑ ዎዛና ትልእስዶሶና” ያግደታ።<verse eid="DEU 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 1:29"/>ያትን ታኒ፥ “ያዮፍተ ዎይኮ ዳጋሞፍተ። <verse eid="DEU 1:29"/><verse number="30" style="v" sid="DEU 1:30"/>ህንተ ስንራ ብያ ጎዳይ ህንተ ፆሳይ ካሰ ግብፀን ህንተ አይፍያ ስንን ህንተዉ ኦዳይሳዳ ሀእካ ህንተዉ እ ኦለታና። <verse eid="DEU 1:30"/><verse number="31" style="v" sid="DEU 1:31"/>ቃስ ህንተ ሀ መላ ቢታ ጋካናዉ ይዳ ኦገ ኡባን አስ ባ ናአ ቶከይሳዳ ጎዳይ ህንተ ፆሳይ ህንተና ቶክዳይሳ በእደታ” ያጋስ።<verse eid="DEU 1:31"/></para>
  <para style="p">
    <verse number="32-33" style="v" sid="DEU 1:32-33"/>ሀ ኡባይ ሀንንካ፥ ህንተ ዱንካናና በሳነ ህንተ ባና ኦግያ በሳናዉ ቃማ ታማ ቱሳን፥ ጋላስ ሻራ ቱሳን ህንተና ካለዳ ጎዳ ህንተ ፆሳ አማንበከታ።<verse eid="DEU 1:32-33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="DEU 1:34"/>“ጎዳይ ህንተ ሃሳያ ስእድ ሀንቀትስ፤ ሀይሳዳ ያግድ ጫቅስ፤ <verse eid="DEU 1:34"/><verse number="35" style="v" sid="DEU 1:35"/>ታኒ ህንተ ማይዛታስ እማና ጋዳ ጫቅዳ ሀ ሎኦ ቢታ፥ ሀ ኢታ የለተፈ እሶይካ በኤና። <verse eid="DEU 1:35"/><verse number="36" style="v" sid="DEU 1:36"/>ሀ ቢታ በአናይ ዮፎና ናኣ ካለባ ፃላላ። እ የዳ ቢታ እያስነ እያ ኮቻስ እማና፤ እ ባ ኩመ ዎዛናፐ ጎዳ ካልስ” ያግድ ጫቅስ።<verse eid="DEU 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="DEU 1:37"/>ህንተ ጋሶን ጎዳይ ታ ቦላካ ሀንቀትድ፥ ሀይሳዳ ያግስ፤ “ሀር አቶሽን፥ ነካ ሄ ቢታ ገላካ። <verse eid="DEU 1:37"/><verse number="38" style="v" sid="DEU 1:38"/>ሽን ነና ማድያ ናወ ናአይ፥ እያሱይ ሄ ቢታ ገላና። እ እስራኤለ አሳ ሄ ቢታ ላትሳናዉ ደእያ ግሾ ኔኒ እያ ምን። <verse eid="DEU 1:38"/><verse number="39" style="v" sid="DEU 1:39"/>ህንተ፥ ኑ ናይት ድኤታና ግዳ ጉት፥ ኢታነ ኬሀ ሻክድ ኤሮና ህንተ ናይት ሄ ቢታ ገላና። ታኒ ሄ ቢታ ኤንታዉ እማና፤ ኤንትካ ላታና። <verse eid="DEU 1:39"/><verse number="40" style="v" sid="DEU 1:40"/>ሽን ህንተ ጉየ ስሚድ፥ ዞኦ አባ ኤፍያ ኦግያ ኦይክድ፥ መላ ቢታ ቢተ” ያግስ።<verse eid="DEU 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 1:41"/>ህንተ ዛሪድ፥ “ኑኒ ጎዳ ቦላ ናጋራ ኦዳ፤ ሀእ ኑኒ ጎዳይ ኑ ፆሳይ ኪተይሳዳ፥ ከይድ ኦለታና” ያግደታ። ህንተ ኡባይ ኦላ ሚሸ ዳንጭድ፥ ደረይ ዳርያ ቢታ ከይድ ኦለታናይሳ ላፋባ ኦድ ቆፕደታ።<verse eid="DEU 1:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="DEU 1:42"/>ሽን ጎዳይ ታኮ፥ “ታኒ ኤንታራ ዶና ግሾ፥ ኤንቲ ከይድ ኦለቶና መላ ኦዳ። አካይ፥ ጊኮ፥ ኤንታ ሞርከት ኤንታ ፆናና” ያግስ። <verse eid="DEU 1:42"/><verse number="43" style="v" sid="DEU 1:43"/>ያግን፥ ታኒ ህንተዉ ኦዳስ፥ ሽን ህንተ ጎዳ ኪታ እፅደታፐ አትሽን፥ ታ ኦደይሳ ስእቤከታ፤ ያትድ ኦቶሮን ደረይ ዳርያ ቢታ ከይደታ። <verse eid="DEU 1:43"/><verse number="44" style="v" sid="DEU 1:44"/>ሄ ደረይ ዳርያ ቢታን ደእያ አሞረት ህንተራ ኦላ ጋሄትድ፥ ህንተና ማ ጎደይሳዳ ጎድድ፥ ሳይረ ቢታፈ ብድ ሆርማ ጋካናዉ ሾጭዶሶና። <verse eid="DEU 1:44"/><verse number="45" style="v" sid="DEU 1:45"/>ህንተ ጉየ ስሚድ፥ ጎዳኮ ዬክደታ፤ ሽን ጎዳይ ህንተ ዬሁዋ ስእቤና ዎይኮ ሀይዝቤና። <verse eid="DEU 1:45"/><verse number="46" style="v" sid="DEU 1:46"/>ሄሳ ግሾ፥ ህንተ ቃደሳን አዱሳ ዎደ ጋምእደታ።<verse eid="DEU 1:46"/></para>
  <chapter eid="DEU 1"/>
  <chapter number="2" style="c" sid="DEU 2"/>
  <para style="s1">መላ ቢታን ብፃትዳ ዎደታ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 2:1"/>ሄሳፈ ጉየ፥ ጎዳይ ታና ኪትዳይሳዳ፥ ኑኒ ዞኦ አባ ኤፍያ ኦግያ ኦይክድ ጉየ ስሚድ መላ ቢታ መቶትሸ፥ ደረይ ዳርያ ሳይረ ቢታን ዳሮ ጋላሳ ቶይላትሸ ዩይዳ።<verse eid="DEU 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 2:2"/>ሄሳፈ ጉየ፥ ጎዳይ ታኮ ሀይሳዳ ያግስ። <verse eid="DEU 2:2"/><verse number="3" style="v" sid="DEU 2:3"/>“ሀ ደረይ ዳርያ ቢታ አዱሳ ዎደ ዩይዳይስ ህንተዉ ግዳና፤ ፑደሀ ባጋ ስሚድ ቢተ። <verse eid="DEU 2:3"/><verse number="4" style="v" sid="DEU 2:4"/>አሳ ኔኒ ያጋዳ ኪታ፤ ‘ሳይረን ደኤይ ኤሳዌ ናይታ ህንተ እሻታ ግድያ ግሾ ኤንታ ቢታራ ህንተ ካንታ። ኤንቲ ህንተዉ ያያና፥ ሽን ህንተ ኬህ ናገትተ። <verse eid="DEU 2:4"/><verse number="5" style="v" sid="DEU 2:5"/>ታኒ ኤንታ ቢታፈ ቶሆይ የያ በሳ መላ ህንተዉ እሞና ግሾ ኤንታራ ኦለቶፍተ። ታኒ ደረይ ዳርያ ሳይረ ቢታ ላታ ኦዳ ኤሳዌስ ኮይሮታዳ እማስ። <verse eid="DEU 2:5"/><verse number="6" style="v" sid="DEU 2:6"/>ህንተ ምያ ካነ ኡያ ሃ ኤንታፈ ሚሸን ሻምተ’ ” ያጋዳ ኪታ።<verse eid="DEU 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 2:7"/>ጎዳይ ህንተ ፆሳይ ህንተ ኦዳባ ኡባ አንጅስ፤ ህንተ ሀ ዎልቃማ መላ ቢታን ሄመትያ ዎደ ህንተና ናግስ። ኦይታሙ ላይ ኡባን ጎዳይ ህንተ ፆሳይ ህንተራ ደእስ፤ ህንተዉ አይባካ ፓጭስቤና።<verse eid="DEU 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 2:8"/>ሄሳ ግሾ፥ “ኑኒ ኑ እሻታ ግድያ ኤሳዌ ናይት ደእያ ሳይረ ቢታራ ካንድ ብዳ። ቃስ ኤላታነ ኤፅዮን-ጋብራ ካታማታፐ ደንድድ፥ ማፅነ አባኮ ጋያ ኦግያ አግድ፥ ሞአበ መላ ቢታራ አዳ። <verse eid="DEU 2:8"/><verse number="9" style="v" sid="DEU 2:9"/>ጎዳይ ታኮ፥ ‘ታኒ ኤንታ ቢታፈ አይባካ ህንተዉ እሞና ግሾ፥ ሞአበ አሳራ ካጨቶፍተ ዎይኮ ኤንታ ኦሎፕተ። ኤራ ካታማ ታኒ ላታ ኦዳ ሎፀ ኮቻስ ኮይሮ እማስ’ ” ያግስ።<verse eid="DEU 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 2:10"/>(ሄ ቢታን ካሰ ምኖነ ዳሮ ግድዳ፥ ቃስ አናቀ ኮቻታዳ አዱሰ ግድዳ ኤምመታ ጌተትያ አሳት ደእዶሶና። <verse eid="DEU 2:10"/><verse number="11" style="v" sid="DEU 2:11"/>ኤንቲ አናቀታዳ ራፋይመታ ጌተቶሶና። ሽን ሞአበ አሳይ ኤንታ ኤምመታ ግድ ፄጎሶና። <verse eid="DEU 2:11"/><verse number="12" style="v" sid="DEU 2:12"/>ሆራ ቢታ አሳይ ካሰ ሳይረን ደእዶሶና፥ ሽን እስራኤለ አሳይ ላታና መላ ጎዳይ ኤንታዉ እምዳ ቢታን ኤንቲ ኦዳይሳዳ ኤሳዋ ኮቻት ሆራታ ኤንታ ቢታፈ ሾድዶሶና። ቃስ ባንታ ስንፈ ኤንታ ይስድ ኤንታ በሳን ኡትዶሶና።)<verse eid="DEU 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 2:13"/>ጎዳይ ኑኮ፥ “ሀእ ደንድተ፥ ዛረአዳ ሻፋ ፕንተ” ያግን፥ ኑኒ ዛረዳ ሻፋ ፕንዳ። <verse eid="DEU 2:13"/><verse number="14" style="v" sid="DEU 2:14"/>ኑኒ ቃደስ-ባርነፈ ደንድድ፥ ዛረዳ ሻፋ ፕናና ጋካናዉ ሀስታማነ ሆስፑን ላይ አስ። ሄ ዎደ ጎዳይ ኤንታዉ ጫቅዳይሳዳ ኦላስ ጋክዳ አደ ኡባይ ዉርስ። <verse eid="DEU 2:14"/><verse number="15" style="v" sid="DEU 2:15"/>ዱንካንዳ ጉታፐ ኤንቲ ኩመ ያና ጋካናዉ፥ ጎዳ ኩሸይ ኤንታ ቦላ ዴፅስ።<verse eid="DEU 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 2:16"/>ኦላስ ጋክዳ አደ አሳ ኡባይ ኩመ ይዳፐነ አሳ ግዶፈ ሀይቅድ ዉርዳፐ ጉየ፥ <verse eid="DEU 2:16"/><verse number="17" style="v" sid="DEU 2:17"/>ጎዳይ ታኮ፥ <verse eid="DEU 2:17"/><verse number="18" style="v" sid="DEU 2:18"/>“ኤራ ኦግያራ ሀች ህንተ ሞአበ ቢታ ካንታ። <verse eid="DEU 2:18"/><verse number="19" style="v" sid="DEU 2:19"/>ህንተ አሞነ አሳ ቢታ ጋክያ ዎደ ኤንታ ቦቾፍተ ዎይኮ ኤንታራ ኦየቶፍተ። አሞነ አሳታ ቢታፈ አይብባካ ታኒ ህንተዉ ላታ ኦዳ እምከ። ታኒ ሄ ቢታ ሎፀ ኮቻስ ላታ ኦዳ ኮይሮ እማስ” ያግስ።<verse eid="DEU 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 2:20"/>[ሄ ቢታይ ካሰ ያን ደእያ አሳይ ፄገትያ ሱን ራፋይመታ ቢታ ጌተትድ ፄገቴስ። ቃስ አሞነት ኤንታ ዛምዙመታ ግድ ፄጎሶና። <verse eid="DEU 2:20"/><verse number="21" style="v" sid="DEU 2:21"/>ኤንቲ አናቀታዳ አዱሰ፥ ምኖነ ዳሮ ደረ፥ ሽን ጎዳይ ኤንታ ይስን፥ አሞነት ኤንታ ቢታ ላትድ ኡትዶሶና። <verse eid="DEU 2:21"/><verse number="22" style="v" sid="DEU 2:22"/>ጎዳይ ሳይረን ደእያ ኤሳዌ ኮቻስ ኦዳይሳዳ፥ ኤንታ ቦላ ኦስ። ሄስካ እ ሄ ቢታን ደእያ ሆራታ ይስን፥ ኤሳዌ ኮቻይ ኤንታ ቢታ ላትድ ሀች ጋካናዉ ኡትዶሶና። <verse eid="DEU 2:22"/><verse number="23" style="v" sid="DEU 2:23"/>ጋዛ ጋካናዉ ደእያ ሄራን ደእያ አዌት፥ ካፍቶረ ቢታፈ ይዳ ካፍቶረት ኤንታ ይስድ ኤንታ ቢታን ኡትዶሶና።]<verse eid="DEU 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 2:24"/>ቃስካ ጎዳይ ኑኮ፥ “ደንድተ፤ አርኖና ሻፋ ፕንተ። ሄኮ፥ አሞረ ቢታ አስ ግድዳ ሀሰቦና ካዋ ስሆናነ እያ ቢታ ታ ህንተ ኩሸን አዳ እማስ፤ እያ ኦልድ እያ ቢታ ላትተ። <verse eid="DEU 2:24"/><verse number="25" style="v" sid="DEU 2:25"/>ሀችፈ ዶምን ሳሎፐ ጋርሳን ደእያ አሳ ኡባይ ህንተዉ ያያና መላ ታኒ ኦና። ኤንቲ ህንተባ ስእያ ዎደ ኡባን ያሻን ኮኮራና” ያግስ።<verse eid="DEU 2:25"/></para>
  <para style="s1">ስሆነ ፆነተ</para>
  <para style="r">(<ref loc="NUM 21:21-30">ታይቦ 21:21-30</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 2:26"/>ሄሳፈ ጉየ፥ ቅደሞታ መላ ቢታፈ ሀሰቦና ካዋ ስሆናስ ኪታንቾታ ቦላ ሀይሳዳ ያጋዳ ሳሮ ቃላ ኪታስ። <verse eid="DEU 2:26"/><verse number="27" style="v" sid="DEU 2:27"/>“ኑና ነ ቢታራ አርክ፤ ኑኒ ዎጋ ኦግያ ፃላላ ኦይክድ ባና፤ እያፐ ኡሻች ዎይኮ ሀድርስ ጎኮ። <verse eid="DEU 2:27"/><verse number="28" style="v" sid="DEU 2:28"/>ኑኒ ምያ ካስነ ኡያ ሃስ ሚሸ ቃንፃና። ኑ ኮየይ ነ ቢታራ ካን አ ፃላላ። <verse eid="DEU 2:28"/><verse number="29" style="v" sid="DEU 2:29"/>ሳይረን ደእያ ኤሳዌ ኮቻትነ፥ ኤራን ደእያ ሞአበ ኮቻት ኑና አዳይሳዳ ጎዳይ ኑ ፆሳይ፥ ኑስ እምያ ቢታስ ዮርዳኖሰ ሻፋ ኑኒ ፕናና ጋካናዉ ያራ ኑና አ” ያጋስ። <verse eid="DEU 2:29"/><verse number="30" style="v" sid="DEU 2:30"/>ሽን ሀሰቦና ካዎይ ስሆነይ ኑና አና እፅስ። ጎዳይ ህንተ ፆሳይ ሀእ ኦዳይሳዳ እያ ህንተ ኩሸን አድ እማናዉ ኮይዳ ግሾ እያ ዎዛና ሙምስስድ፥ ኦቶራንቾ ኦስ።<verse eid="DEU 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="DEU 2:31"/>ሄሳፈ ጉየ ጎዳይ ታኮ፥ “ሄኮ፥ ስሆናነ እያ ቢታ ታ ነዉ አዳ እሞ ዶማስ፤ ሀእ ፆናዳ እያ ቢታ ላታ” ያግስ።<verse eid="DEU 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 2:32"/>ስሆነይ ባ ኦላንቾታ ኡባ ኤክድ ያሃፃ ጌተትያ በሳን ኑራ ኦለታናዉ ከይስ። <verse eid="DEU 2:32"/><verse number="33" style="v" sid="DEU 2:33"/>ሽን ጎዳይ ኑ ፆሳይ ኑስ እያ አድ እምን፥ እያ፥ እያ አደ ናይታነ እያ ኦላንቾታ ኡባ ኑኒ ዎዳ። <verse eid="DEU 2:33"/><verse number="34" style="v" sid="DEU 2:34"/>ሄ ዎደ ኑኒ እያ ካታማታ ኡባ ኦይክድ፥ እያን ደእያ አደ፥ ማጫነ ናአ ኡባ አሾና ይስዳ። <verse eid="DEU 2:34"/><verse number="35" style="v" sid="DEU 2:35"/>ኤንታ መህያነ ኑኒ ኦይክዳ ካታማታፐ ድእዳይሳ ፃላላ ኑስ ኤክዳ። <verse eid="DEU 2:35"/><verse number="36" style="v" sid="DEU 2:36"/>አርኖና ዛንጋራ ጋፃን ደእያ አሮኤራፐነ ሄ ዛንጋራ ግዶን ደእያ ካታማፐ ብድ ጋላዳ ቢታ ጋካናዉ ኑራ ኤቀትዳ እስ ካታምካ ዴና። ጎዳይ ኑ ፆሳይ ኤንታ ኡባ ኑ ኩሸን አድ እሚስ። <verse eid="DEU 2:36"/><verse number="37" style="v" sid="DEU 2:37"/>ሽን ኑኒ አሞነ ቢታኮ፥ ያቦቃ ሻፋ ጋፃን ደእያ ቢታኮ፥ ገዘ ቢታን ደእያ ካታማታኮነ ጎዳይ ኑ ፆሳይ ኑኒ ቦና መላ ድግዳ በሳ ኡባ ሺቅቦኮ።<verse eid="DEU 2:37"/></para>
  <chapter eid="DEU 2"/>
  <chapter number="3" style="c" sid="DEU 3"/>
  <para style="s1">ኦገ ፆነተ</para>
  <para style="r">(<ref loc="NUM 21:31-35">ታይቦ 21:31-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 3:1"/>ሄሳፈ ጉየ፥ ኑኒ ስሚድ ባሳነ ኤፍያ ኦግያራ ከይዳ። ባሳነ ካዎይ ኦገይ፥ ባ ኦላንቾታ ኡባራ ኤድራአ ጌተትያ በሳን ኑራ ኦለታናዉ ከይስ። <verse eid="DEU 3:1"/><verse number="2" style="v" sid="DEU 3:2"/>ሽን ጎዳይ ታኮ፥ “እያዉ ያዮፋ፤ ታኒ እያ፥ እያ ኦላንቾታነ እያ ቢታ ኡባ ነ ኩሸን አዳ እማስ። ሀሰቦናን ኡትድ ካዎትዳ አሞረታ ካዋ ስሆና ቦላ ኦዳይሳዳ ኔኒ እያ ቦላ ኦና” ያግስ።<verse eid="DEU 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 3:3"/>ሄሳ ግሾ፥ ጎዳይ ኑ ፆሳይ ባሳነ ካዋ ኦገነ እያ አሳ ኡባ ኑ ኩሸን አድ እሚስ፤ ኑኒ ኤንታፈ እሱዋካ አሾና ዉርስድ ዎዳ። <verse eid="DEU 3:3"/><verse number="4" style="v" sid="DEU 3:4"/>ሄ ዎደ ኑኒ እያ ካታማታ ኡባ ኦይክዳ፤ ኑኒ ኦይክቦና እስ ካታምካ ዴና፤ ሄስካ፥ ባሳነ ካዋ ኦገይ አርጎባ ቢታን አይስያ ኡሱፑን ታሙ ካታማታ ኡባ ኦይክዳ። <verse eid="DEU 3:4"/><verse number="5" style="v" sid="DEU 3:5"/>ሀ ካታማት ኡባይ አዱሳ ግምበን ድረትዳይሳታነ ፐንገት ኮበትዳይሳታ። ግምበ ድርስ ባይና ዳሮ ጉታትካ ደኦሶና። <verse eid="DEU 3:5"/><verse number="6" style="v" sid="DEU 3:6"/>ሀሰቦና ካዋ ስሆና ቦላ ኦዳይሳዳ ኑኒ ኤንታ ኩመ ይስዳ። ኤንታ ካታማታን ደእያ አደ፥ ማጫነ ናአ አሾና ይስዳ። <verse eid="DEU 3:6"/><verse number="7" style="v" sid="DEU 3:7"/>ሽን መሄ ኡባነ ካታማታፐ ድእዳባ ኑስ ኤክዳ።<verse eid="DEU 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 3:8"/>ሄ ዎደ ኑኒ አርኖና ዛንጋራፐ ብድ አርሞና ዙማ ጋካናዉ ደእያ ቢታ፥ ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋራ ደእያ ናምኡ አሞረ ቢታታ ካዎታፐ ኤክዳ። <verse eid="DEU 3:8"/><verse number="9" style="v" sid="DEU 3:9"/>(ስዶና ቢታ አሳይ አርሞና ዙማ፥ ስርዮና ግድ ፄግያ ዎደ፥ አሞረ ቢታ አሳይ ሳንራ ግድ ፄጎሶና።) <verse eid="DEU 3:9"/><verse number="10" style="v" sid="DEU 3:10"/>ኑኒ ደምባ ቢታን ደእያ ካታማታ ኡባ፥ ጋላዳ ቢታ ኡባ፥ ባሳነ ቢታ ኡባነ ባሳነ ቢታን ኦገይ ሃርያ ሳላካነ ኤድራአ ካታማታ ጋካናዉ ደእያ በሳ ኦይክዳ። <verse eid="DEU 3:10"/><verse number="11" style="v" sid="DEU 3:11"/>(ራፋይመታፐ አትዳይ ባሳነ ካዋ ኦገ ፃላላ። እያ አርሳይ ብራታ አርስ፤ ሄ አርሳይ ሀች ጋካናዉ ራባ ጌተትያ አሞነታ ካታማን ደኤስ፤ እያ አዱሳተይ ሆስፑን ዋ፤ ጎምፓይ ኦይዱ ዋ።)<verse eid="DEU 3:11"/></para>
  <para style="s1">ዮርዳኖሰፐ ሄፍንን ኡትዳ ኮቻታ</para>
  <para style="r">(<ref loc="NUM 32:1-42">ታይቦ 32:1-42</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 3:12"/>ሄ ቢታ ኑኒ ላትዳፐ ጉየ፥ አርኖና ሻፋ ዶናን ደእያ አሮኤራ ካታማፐ ዶምድ ደእያ በሳነ ደረይ ዳርያ ጋላዳ ቢታፈ ባጋ ጉጃዳ እያ ካታማታራ ሮቤላስነ ጋደ ኮቻስ ታኒ እማስ። <verse eid="DEU 3:12"/><verse number="13" style="v" sid="DEU 3:13"/>ጋላዳፐ አትዳይሳነ ኦገይ ሃርያ ባሳነ ቢታ ኡባ ምናሰ ኮቻ ባጋስ እማስ፤ ሄስካ፥ አርጎባ ካዎተ። (ሄ ባሳነ ቢታይ ኡባይ ራፋይመታ ቢታ ጌተትድ ፄገቴስ። <verse eid="DEU 3:13"/><verse number="14" style="v" sid="DEU 3:14"/>ምናሰ ኮቻፈ ያእር ኩመ አርጎባ ቢታ ላትስ፤ ሄስካ ጌሹረታነ ማእካታ ቢታ ጋፃ ጋካናዉ ደእያ ባሳነ ቢታ። እ ሄ ካታማታ ባ ሱንን ፄገታና መላ ኦስ፤ ሄሳ ግሾ፥ ኤንቲ ሀች ጋካናዉ፥ ያእራ ካታማታ ጌተትድ ፄገቶሶና።)<verse eid="DEU 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 3:15"/>ጋላዳ ቢታ ምናሰ ኮቸ ግድዳ ማክራስ እማስ። <verse eid="DEU 3:15"/><verse number="16" style="v" sid="DEU 3:16"/>ሮቤላነ ጋደ ኮቻስ ጋላዳፐ ብድ አርኖና ሻፋ ማታ ጋካናዉ ደእያ ቢታ እማስ። ዱገሀ ባጋራ አርኖና ሻፋፐ ባጋይ ኤንታ ዛዋ፤ ቃስ ፑደሀ ባጋራ አሞነታ ቢታስ ጋፃ ግድዳ ያቦቃ ሻፋይ ዛዋ። <verse eid="DEU 3:16"/><verse number="17" style="v" sid="DEU 3:17"/>ዉሎሀ ባጋራ፥ ኤንታ ዛዋይ አራባን ደእያ ዮርዳኖሰ ሻፋ ጋኬስ፤ ሄስካ ጋልላ አባፈ ዶምድ ፕስጋ ዙማ ፃጶን ደእያ ማፅነ አባ (ሃይቆ አባ) ጋካናሳ።<verse eid="DEU 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 3:18"/>ሄ ዎደ ታኒ ህንተና ሀይሳዳ ያጋዳ ኪታስ። “ጎዳይ ህንተ ፆሳይ ሄ ቢታ ህንተ ላታና መላ ህንተዉ እሚስ። ህዛ ህንተዉ ደእያ ቶራንቾታ ኡባ ኦላ ሚሸ ዳንጭስድ፥ ህንተ እሻታ ግድዳ እስራኤለ አሳፐ ስን አተ። <verse eid="DEU 3:18"/><verse number="19" style="v" sid="DEU 3:19"/>ህንተዉ ዳሮ መሄይ ደኤይሳ ታኒ ኤራይስ፤ ሄሳ ግሾ፥ ህንተ ማቸት፥ ህንተ ናይትነ ህንተ መሄይ ታኒ ህንተዉ እምዳ ካታማታን ደእሾና። <verse eid="DEU 3:19"/><verse number="20" style="v" sid="DEU 3:20"/>ጎዳይ ህንተና ሸምፕስዳይሳዳ ህንተ እሻታ ሸምፕሳና ጋካናዉነ ዮርዳኖሰ ሻፋፐ ሄፍንን ጎዳይ፥ ህንተ ፆሳይ ኤንታዉ እምያ ቢታ ኤንቲ ኤካና ጋካናዉ ኤንታዉ ኦለትተ። ሄሳፈ ጉየ፥ ታኒ ህንተዉ እምዳ ቢታ ስመታ” ያግስ።<verse eid="DEU 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 3:21"/>ታኒ ሄ ዎደ እያሱ ሀይሳዳ ያጋዳ ኪታስ። “ጎዳይ፥ ህንተ ፆሳይ ሀ ናምኡ ካዎታ ቦላ ኦዳባ ኡባ ኔኒ ነ አይፈን በአዳሳ፤ ህንተ ኦይካናዉ ብያ ካዎተታ ኡባ ቦላ ጎዳይ ሄሳዳ ኦና። <verse eid="DEU 3:21"/><verse number="22" style="v" sid="DEU 3:22"/>ህንተዉ ኦለተይ ጎዳ ህንተ ፆሳ ግድያ ግሾ፥ ኤንታዉ ያዮፍተ” ያጋስ።<verse eid="DEU 3:22"/></para>
  <para style="s1">ሙሰይ ካናነ ገልቤና</para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 3:23"/>ሄ ዎደ ታኒ ሀይሳዳ ያጋዳ ጎዳ ምንዳ ዎሳስ። <verse eid="DEU 3:23"/><verse number="24" style="v" sid="DEU 3:24"/>“ኡባ ሃርያ ጎዳዉ፥ ነ ግታተነ ነ ምኖ ኩሽያ ታና፥ ነ አይልያ በሳናዉ ዶማዳሳ። ነ ኦያ ዎልቃማ ኦሶታ ኦናዉ ዳንዳኤይ ሳሎን ግድን ሳአን ሀራ ፆሲ ደኢ? <verse eid="DEU 3:24"/><verse number="25" style="v" sid="DEU 3:25"/>ጎዳዉ፥ ታኒ ባዳ ዮርዳኖሰ ሻፋፐ ሄፍንን ደእያ ደረይ ዳርያ ሎኦ ቢታነ ልባኖሰ ደርያ በአና መላ ታና የዳርክ” ያግስ።<verse eid="DEU 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 3:26"/>ሽን ጎዳይ ህንተ ጋሶን ታና ሀንቀትድ ስኦናን እፅስ። ጎዳይ ታኮ፥ “ህዛ ነዉ ግዳና፤ ሀ ኦዳ ናምአን ደንዳ ሃሳዮፓ። <verse eid="DEU 3:26"/><verse number="27" style="v" sid="DEU 3:27"/>ሄሳ አጋዳ ደንዳ፤ ፕስጋ ዙማ ቦላ ከያ፤ ያን ኤቃዳ ሄ ቢታ ዉሎሀ ባጋ፥ ፑደሀ ባጋ፥ ዱገሀ ባጋነ ዶሎሀ ባጋ ነ አይፍያ ቁ ኦዳ ፄላ። ኔኒ ሀ ዮርዳኖሰ ሻፋ ፖሎ ፕናካ። <verse eid="DEU 3:27"/><verse number="28" style="v" sid="DEU 3:28"/>ሽን ኔኒ እያሱ ኪታ፤ እያ ዞራነ ምን። እ ሀ አሳ ካለድ ፕንናነ ሀ ኔኒ በእያ ቢታ ኤንታ ላትሳና” ያግስ።<verse eid="DEU 3:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 3:29"/>ሄሳ ግሾ፥ ኑኒ ቤት-ፓኦራ ስንን ደእያ ዛንጋራን ጋምእዳ።<verse eid="DEU 3:29"/></para>
  <chapter eid="DEU 3"/>
  <chapter number="4" style="c" sid="DEU 4"/>
  <para style="s1">ሙሰይ እስራኤለ አሳ ዞርስ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 4:1"/>ሀእካ እስራኤለ አሳዉ፥ ህንተ ደኦን ዳና መላነ ጎዳይ፥ ህንተ ማይዛታ ፆሳይ፥ ህንተዉ እምያ ቢታ ህንተ ላታና መላ ታ ህንተና ታማርስያ ዎጋነ ህግያ ስእተነ ኦተ። <verse eid="DEU 4:1"/><verse number="2" style="v" sid="DEU 4:2"/>ታ ህንተና ኪትያ፥ ጎዳ ህንተ ፆሳ ኪታ ናግተፐ አትሽን፥ እያ ቦላ አይኮካ ጉጆፍተ፤ እያፐ አይኮካ ፓጭሶፕተ። <verse eid="DEU 4:2"/><verse number="3" style="v" sid="DEU 4:3"/>ብኤል-ፋጎራ ዙማ ቦላ ጎዳይ ኦዳባ ህንተ፥ ህንተ አይፈን በእደታ። ጎዳይ፥ ህንተ ፆሳይ ብኤል-ፋጎራ ኤቃ ጎይንዳይሳታ ኡባ ህንተ ግዶፈ ይስስ። <verse eid="DEU 4:3"/><verse number="4" style="v" sid="DEU 4:4"/>ሽን ህንተ ጎዳስ፥ ህንተ ፆሳስ አማነትዳ ግሾ፥ ሀች ጋካናዉ ኡባይካ ደኦን ደኤታ።<verse eid="DEU 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 4:5"/>ሄኮ፥ ህንተ ላታናዉ ገልያ ቢታን ኦና መላ ጎዳይ፥ ታ ፆሳይ ታና ኪትዳ ዎጋነ ህግያ ታ ህንተና ታማርሳስ። <verse eid="DEU 4:5"/><verse number="6" style="v" sid="DEU 4:6"/>ህንተ ኤንታ ናግተነ ኦተ። ህንተ ሄሳ ኦኮ፥ ህንተ አይ መላ ጭንጨኮ ሀራ አሳይ ህንተና በአና። ኤንቲ ሀ ዎጋባ ስእያ ዎደ፥ “ቱማካ ሀ ግታ ካዎተይ ጭንጫነ አኬካንቾ ካዎተ” ያጋና። <verse eid="DEU 4:6"/><verse number="7" style="v" sid="DEU 4:7"/>ኑኒ እያ ፄግያ ዎደ ኡባን ጎዳይ፥ ኑ ፆሳይ ኑስ ማታ ግደይሳዳ ፆሲ ማታ ግድዳ ሀራ አይ ዎልቃማ ካዎተ ደኢ? <verse eid="DEU 4:7"/><verse number="8" style="v" sid="DEU 4:8"/>ታኒ ሀች ህንተ ስንን ዎያ ሀ ህገ ኡባ መላ ፅሎ ግድዳ ዎግነ ህገይ ደእያ ሀራ አይ ግታ ካዎተ ደኢ?<verse eid="DEU 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 4:9"/>ህዛ ነ ደኦ ላይ ኡባን ሀ ነ በእዳባ ኡባ ዶጎና መላነ ነ ዎዛናን ዎና መላ ናገታ። ነ ናይታነ ነ ናይታ ናይታ ታማርሳ። <verse eid="DEU 4:9"/><verse number="10" style="v" sid="DEU 4:10"/>ኮሬባ ዙማ ቦላ ጎዳ፥ ህንተ ፆሳ ስንን ህንተ ኤቅዳ ዎደ ጎዳይ ታኮ፥ “ታ ቃላ ኤንቲ ስእድ፥ ባንታ ላይ ኡባን ታዉ ያያና መላነ ባንታ ናይታ ሄሳ ታማርሳና መላ አሳ ታኮ ሺሻ” ግዳይሳ አኬክተ። <verse eid="DEU 4:10"/><verse number="11" style="v" sid="DEU 4:11"/>ሄ ዎደ ህንተ ሺቅድ ዙማ ፃጶን ኤቅደታ፤ ሳሎ ጋካናዉ ታም ኤፅስ። ሄ ዙማ ፃጶይ ሳካና ማንነ ሻራን ጎዘትስ። <verse eid="DEU 4:11"/><verse number="12" style="v" sid="DEU 4:12"/>ጎዳይ ታማ ግዶን ግድድ ህንተዉ ኦድስ። ህንተ እያ ግርሳ ስእደታፐ አትሽን፥ እያ ማላ በእቤከታ። <verse eid="DEU 4:12"/><verse number="13" style="v" sid="DEU 4:13"/>ህንተ ኦና መላ እ ህንተና ኪትዳ ባ ጫቁዋ ህንተዉ ኦድስ፤ ሄስካ ታሙ ኪታታ። እ ኤንታ ናምኡ ሎቸ ሹቻታ ቦላ ፃፍስ። <verse eid="DEU 4:13"/><verse number="14" style="v" sid="DEU 4:14"/>ህንተ ላታናዉ ብያ ቢታን ኦና መላ ዎጋነ ህግያ ህንተና ታማርሳና መላ ጎዳይ ታና ሄ ዎደ ኪትስ።<verse eid="DEU 4:14"/></para>
  <para style="s1">ኤቃ ጎይኖይ ናጋራ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 4:15"/>ጎዳይ ኮሬባ ዙማ ቦላ ታማ ግዶን ግድድ ህንተዉ ኦድዳ ጋላስ ህንተ እያ ማላ በእቦና ግሾ ሎይ ናገትተ። <verse eid="DEU 4:15"/><verse number="16" style="v" sid="DEU 4:16"/>አደ ዎይኮ ማጫ መን ኦሰትዳባ ግድን፥ <verse eid="DEU 4:16"/><verse number="17" style="v" sid="DEU 4:17"/>ሳአን ደእያ ዶአ ኡባ ሌምሶን ግድን፥ ሳሎራ ፓልያ ካፎ ኡባ ሌምሶን ግድን፥ <verse eid="DEU 4:17"/><verse number="18" style="v" sid="DEU 4:18"/>ሳአ ቦላ ኡሎራ ጎሸትያ መተ ሌምሶን ግድን፥ ሃ ግዶን ደእያ ሞሎ ሌምሶን ግድን፥ ህንተ ቱኖና መላ ህንተዉ ፆሰ ኦድ መፍተ። <verse eid="DEU 4:18"/><verse number="19" style="v" sid="DEU 4:19"/>ሳሎ ፑደ ፄልዳ፥ ጎዳይ ነ ፆሳይ ሳሎፐ ጋርሳን ደእያ ካዎተታስ እምዳ አዋ፥ አጌና፥ ፆልንቶታነ ሳሎ መተታ ኡባ በእዳ፥ ነ ኤንታዉ ጎይናዳ ባሎና መላ ናገታ። <verse eid="DEU 4:19"/><verse number="20" style="v" sid="DEU 4:20"/>ሽን ጎዳይ ህንተና ሀች ህንተ ሀንዳይሳዳ ባዉ ዱማትዳ አሰ ኦናዉ ብራታ ሴርስያ ጮጨ መላ ግድዳ ግብፀፈ ከስድ ኤህስ።<verse eid="DEU 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 4:21"/>ህንተ ጋሶን ጎዳይ ታና ሀንቀትድ፥ ዮርዳኖሰ ፕኖና መላነ ጎዳይ ህንተ ፆሳይ፥ ላታ ኦድ ህንተዉ እምያ ሎኦ ቢታ ታኒ ገሎና መላ ጫቅስ። <verse eid="DEU 4:21"/><verse number="22" style="v" sid="DEU 4:22"/>ሄሳ ግሾ፥ ታኒ ዮርዳኖሰ ሻፋ ፕኖና ሀ ቢታን ሀይቃና፥ ሽን ህንተ ፕንድ ሄ ሎኦ ቢታ ላቴታ። <verse eid="DEU 4:22"/><verse number="23" style="v" sid="DEU 4:23"/>ህዛ ጎዳይ፥ ህንተ ፆሳይ ህንተራ ጫቅዳ ጫቁዋ ዶጎፕተ። ጎዳይ፥ ነ ፆሳይ ነና ኦፋ ግዳ አይ መን ኦሰትዳ ምስለ ነዉ ኤቃ ኦና መላ ናገታ። <verse eid="DEU 4:23"/><verse number="24" style="v" sid="DEU 4:24"/>ጎዳይ፥ ነ ፆሳይ ምያ ታማነ ቃናትያ ፆሲ።<verse eid="DEU 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 4:25"/>ነ ናይታነ፥ ናይታ ናይታ የላዳ ሄ ቢታን አዱሳ ዎደ ደእያ ዎደ አይ መን ኦሰትዳ ምስለ ጎይናዳ ቱንኮ፥ ቃስ ጎዳ፥ ነ ፆሳ ሀንቀናዉ እያ ስንን ኢታባ ኦኮ፥ <verse eid="DEU 4:25"/><verse number="26" style="v" sid="DEU 4:26"/>ህንተ ዮርዳኖሰ ሻፋ ፕንድ ላታናዉ ብያ ቢታፈ እሶይካ አቶና ኤለ ያናዉ ደኤይሳስ፥ ታ ሀች ህንተ ቦላ ሳሎነ ሳአ ማርካያይስ። ህንተ ፖሎ ያናፐ አትሽን፥ ሄ ቢታን አዱሳ ዎደ ደኤከታ። <verse eid="DEU 4:26"/><verse number="27" style="v" sid="DEU 4:27"/>ጎዳይ ህንተና ሀራ አሳ ግዶን ላላና፤ ህንተና እ ላልያ ካዎተታ ግዶን ህንተ ታይቦይ ጉ ግዳና። <verse eid="DEU 4:27"/><verse number="28" style="v" sid="DEU 4:28"/>ያን ህንተ ምፈነ ሹቻፈ አሳ ኩሸን ጊግዳ በኦና፥ ስኦና፥ ሞናነ ስንጎና ፆሳታ ጎይናና። <verse eid="DEU 4:28"/><verse number="29" style="v" sid="DEU 4:29"/>ሽን ያን ደአሸ ነ ጎዳ፥ ነ ፆሳ ኮያና፤ ነ እያ ኩመ ዎዛናፐነ ኩመ ሸምፖፈ ኮይኮ ደማና። <verse eid="DEU 4:29"/><verse number="30" style="v" sid="DEU 4:30"/>ሄ መቶ ኡባ ግዶን ነ ኡንኤታዳ ደእያ ዎደ ዉርሰን ጎዳኮ፥ ነ ፆሳኮ ስማናነ እያ ቃላስ ኪተታና። <verse eid="DEU 4:30"/><verse number="31" style="v" sid="DEU 4:31"/>ጎዳይ፥ ነ ፆሳይ ማሮተን ኩምዳ ፆሰ ግድያ ግሾ፥ እ ነና አገና ዎይኮ ይሰና፤ ነ ማይዛታስ ጫቅዳ ጫቁዋ ዶገና።<verse eid="DEU 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 4:32"/>ጎዳይ ቢታን አሰ መዳ ጋላሳፐ ዶምድ፥ ህንተፈ ካሰ አዳ ዎድያ አነ ፕልግተ፤ ሄሳ መላ ግታባይ ፖሎ ሀን ኤርያኮ ዎይኮ ስኤትድ ኤርያኮ ሳሉዋስ ሀ ጋፃፐ ያ ጋፃ ጋካናዉ አነ ኦይችተ። <verse eid="DEU 4:32"/><verse number="33" style="v" sid="DEU 4:33"/>ታማ ላጮ ግዶን ጎዳይ ሃሳይን ስእድ፥ ህንተ ዮና ደኦን ደኤይሳዳ ጎዳይ ኦድሽን ስእድ፥ ደኦን ደእዳ ሀራ አስ ደኢ? <verse eid="DEU 4:33"/><verse number="34" style="v" sid="DEU 4:34"/>ዎይኮ ጎዳይ፥ ህንተ ፆሳይ ህንተ ፄልሽን፥ ግብፀ ቢታን ህንተዉ ኦዳይሳዳ ፓጨን፥ ማላታን፥ ማላልስያባን፥ ኦላን፥ ዎልቃማ ኩሸንነ ምጨትዳ ቀሰን፥ ግታ ያሻን ሀራ ካዎተ ግዶ ገልድ፥ እስ ካዎተ ባዉ ኤካናዉ ቡተትዳ ሀራ ፆሲ ደኢ? <verse eid="DEU 4:34"/><verse number="35" style="v" sid="DEU 4:35"/>ጎዳይ፥ ፆሰ ግደይሳ ህንተ ኤራና መላ ሄሳ እ ህንተና በስስ፤ እያፐ አትሽን፥ ሀራ ፆሲ ባዋ። <verse eid="DEU 4:35"/><verse number="36" style="v" sid="DEU 4:36"/>እ ህንተና ታማርሳናዉ ኮይዳ ግሾ፥ ባ ግርሳ ሳሎፐ ስስስ። ቃስ ሀ ሳአን ባ ግታ ታማ ህንተና በስስ፤ ሄ ታማ ግዶፈ ህንተ እያ ቃላ ስእደታ። <verse eid="DEU 4:36"/><verse number="37" style="v" sid="DEU 4:37"/>እ ሄሳ ኦዳይ ህንተ አዋታ ሲቅድ፥ ኤንታፈ ጉየ የለትያ ኤንታ ሼሻታ ዶርዳ ግሾ፥ ህንተና ግብፀፈ ባ ግታ ዎልቃን ከስስ። <verse eid="DEU 4:37"/><verse number="38" style="v" sid="DEU 4:38"/>ሀች ህንተ በኤይሳዳ፥ ህንተና ገልሳናዉነ ኤንታ ቢታ ህንተዉ ላታ ኦድ እማናዉ፥ ህንተፈ ዳርያነ ዎልቃምያ ካዎተታ ህንተ ስንፈ የደድ ከስስ። <verse eid="DEU 4:38"/><verse number="39" style="v" sid="DEU 4:39"/>ህዛ፥ ቦላ ሳሎን ግድን፥ ጋርሳ ሳአን ግድን፥ ጎዳይ ፆሰ ግደይሳ ኤርተ፤ ህንተ ዎዛናን ዎተ፤ ሀራ ፆሲ ባዋ። <verse eid="DEU 4:39"/><verse number="40" style="v" sid="DEU 4:40"/>ሄሳ ግሾ፥ ህንተዉነ ህንተፈ ጉየ ህንተ ናይታስ ኡባባይ ሎኦ ግዳና መላ፥ ቃስ ጎዳይ ህንተ ፆሳይ ህንተዉ መርናዉ እምያ ቢታን ህንተ ላይይ አዱቃና መላ፥ ታኒ ሀች ህንተና ኪትያ ዎጋነ ህግያ ናግተ።<verse eid="DEU 4:40"/></para>
  <para style="s1">ባቃትድ አትያ ካታማታ</para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 4:41"/>ሄሳፈ ጉየ፥ ሙሰይ ዮርዳኖሰ ሄፍንን ዶሎሀ ባጋራ ሄ ካታማታ ዱማይስ። <verse eid="DEU 4:41"/><verse number="42" style="v" sid="DEU 4:42"/>ሄሳ እ ዱማይዳይ ካሰ ሞርከተ ባይና ደእሽን፥ ኤሮና ደእሸ አሰ ዎዳ አስ ያ ባቃታና መላሳ። ሄ ኡራይ ሄ ካታማታፐ እሱዋኡ ባቃትድ ባ ሸምፑዋ አሻናዉ ዳንዳኤስ። <verse eid="DEU 4:42"/><verse number="43" style="v" sid="DEU 4:43"/>ሄሳ ግሾ፥ ሮቤላ ኮቻስ ጋን ደረ ቦላ ደእያ ቦሶራ ካታማ፥ ጋደ ኮቻስ ጋላዳን ደእያ ራሞታነ ምናሰ ኮቻስ ባሳነን ደእያ ጎላና ካታማታ ዱማይስ።<verse eid="DEU 4:43"/></para>
  <para style="s1">እመትዳ ህግያ ብርሸ</para>
  <para style="p">
    <verse number="44" style="v" sid="DEU 4:44"/>ሙሰይ እስራኤለ አሳስ እምዳ ጎዳ ህገይ ሀይሳ፤ <verse eid="DEU 4:44"/><verse number="45" style="v" sid="DEU 4:45"/>ሙሰይ ሀ ዎጋ፥ አዋጁዋነ ህግያ ኤንቲ ግብፀፈ ከይዳ ዎደ እሚስ። <verse eid="DEU 4:45"/><verse number="46" style="v" sid="DEU 4:46"/>ሄስ ኤንታዉ እመትዳይ ኤንቲ ቤት-ፓኦራ ካታማ ስንን ደእያ ዮርዳኖሰፐ ዶሎሀ ባጋራ ደእያ ዛንጋራን ደእሽና። ሄ በሳይ ሙሰይነ እስራኤለ አሳይ ግብፀፈ ከይዳ ዎደ ኦልድ ፆንዳ፥ ሀሰቦናን ኡትድ አሞረ ሃርያ ካዋ ስሆና ቢታ። <verse eid="DEU 4:46"/><verse number="47" style="v" sid="DEU 4:47"/>ሄ ዎደ ኤንቲ እያ ቢታነ ባሳነ ካዋ ኦገ ቢታ፥ ሄስካ ዮርዳኖሰፐ ዶሎሀ ባጋን ደእያ ናምኡ አሞረ ካዎታ ላትዶሶና። <verse eid="DEU 4:47"/><verse number="48" style="v" sid="DEU 4:48"/>ሄ ቢታይ አርኖና ዛንጋራን አሮኤራ ካታማፐ ብድ፥ ስርዮና ደርያ ጋኬስ፤ ስርዮና ጌተትድ ፄገትያ ደረይ አርሞና ዙማ። <verse eid="DEU 4:48"/><verse number="49" style="v" sid="DEU 4:49"/>ሄ ቢታይ ዮርዳኖሰፐ ዶሎሀ ባጋራ ደእያ አራባ ቢታ ኡባ ኤክድ ብድ፥ ፕስጋ ደርያ ፃጶን ደእያ ማፅነ አባ ጋኬስ።<verse eid="DEU 4:49"/></para>
  <chapter eid="DEU 4"/>
  <chapter number="5" style="c" sid="DEU 5"/>
  <para style="s1">ታሙ ኪታታ</para>
  <para style="r">(<ref loc="EXO 20:1-17">ከሳ 20:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 5:1"/>ሙሰይ እስራኤለ አሳ ኡባ እስፈ ፄግድ፥ ሀይሳዳ ያግስ፤ “ህንተኖ፥ እስራኤለ አሳዉ ታኒ ሀች ህንተዉ ኦድያ ዎጋነ ህግያ ስእተ፤ ኤንታ ታማርተ፤ ምንድ ናግተ። <verse eid="DEU 5:1"/><verse number="2" style="v" sid="DEU 5:2"/>ጎዳይ፥ ኑ ፆሳይ ኮሬባ ዙማ ቦላ ኑራ ጫቅስ። <verse eid="DEU 5:2"/><verse number="3" style="v" sid="DEU 5:3"/>ጎዳይ ሄ ጫቁዋ ጫቅዳይ ኑ አዋታ ፃላላራ ግዶናሽን፥ ሀች ደኦን ደእያ ኑ ኡባራ ጫቅስ። <verse eid="DEU 5:3"/><verse number="4" style="v" sid="DEU 5:4"/>ሄ ዙማ ቦላ ኤፅያ ታማ ግዶን ግድድ፥ ጎዳይ ሶምኦን ህንተራ ሃሳይስ። <verse eid="DEU 5:4"/><verse number="5" style="v" sid="DEU 5:5"/>ታኒ ሄ ዎደ ጎዳይ ግያባ ህንተዉ ኦዳናዉ፥ ጎዳፐነ ህንተፈ ግዶን ኤቃስ። ህንተ ታማስ ያይድ ዙማ ቦላ ከይበከታ። ጎዳይ ሀይሳዳ ያግስ።<verse eid="DEU 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 5:6"/>“ግብፀ ቢታፈ፥ አይለተ ኬፈ ነና ዎዝዳይ ታኒ ጎዳ፥ ነ ፆሳ።<verse eid="DEU 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 5:7"/>“ታፐ አትሽን፥ ሀራ ፆሳት ነዉ ደኦፖ።<verse eid="DEU 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 5:8"/>“ቦላ ሳሎን ደእያባ ግድን፥ ጋርሳ ሳአን ደእያባ ግድን፥ ዎይኮ ሃ ግዶን ደእያባ ግድን፥ አይ ምስለ ነዉ ኤቃ ኦፋ። <verse eid="DEU 5:8"/><verse number="9" style="v" sid="DEU 5:9"/>ነ እያዉ ሆኮፋ ዎይኮ እያዉ ጎይኖፋ። ታኒ ታና እፀይሳታ አዋታ ናጋራ ግሾ፥ ናይታ ሄንነ ኦይዳን የለታ ጋካናዉ ሴራይስ። ታኒ፥ ጎዳይ፥ ነ ፆሳይ ቃናትያ ፆሳ። <verse eid="DEU 5:9"/><verse number="10" style="v" sid="DEU 5:10"/>ሽን ታኒ ታና ሲቀይሳታነ ታ ኪታ ናገይሳታ ሙኩሉ የለታ ጋካናዉ ታ መርና ሲቁዋ በሳይስ።<verse eid="DEU 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 5:11"/>“ጎዳ፥ ነ ፆሳ ሱን ጮ ፄጎፓ። ጎዳይ ባ ሱን ጮ ፄግያ ኡራ ሴሮና አገና።<verse eid="DEU 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 5:12"/>“ጎዳይ፥ ነ ፆሳይ ነና ኪትዳይሳዳ ሳምባታ ጋላሳ ጌሽ ኦዳ ናጋ። <verse eid="DEU 5:12"/><verse number="13" style="v" sid="DEU 5:13"/>ኔኒ ነ ኦሶ ኡባ ኡሱፑን ጋላሳን ኦ። <verse eid="DEU 5:13"/><verse number="14" style="v" sid="DEU 5:14"/>ሽን ላፑን ጋላሳይ ጎዳስ፥ ነ ፆሳስ ሳምባታ። ሄ ጋላስ አይ ኦሶካ ኦፋ። ኔኒ ዎይኮ ነ አደ ናአይ ዎይኮ ነ ማጫ ናእያ ዎይኮ ነ ኦሳንቾይ ዎይኮ ነ ኦሳንችያ ዎይኮ ነ ቦራይ ዎይኮ ነ ሀረይ ዎይኮ ነ ሀራ መሄት ዎይኮ ነ ካታማን ደእያ በተ አስ ሄ ጋላስ አይ ኦሶካ ኦፕተ። ኔኒ ሸምፐይሳዳ ነ አደ አይለይትነ ማጫ አይለት ሸምፖ። <verse eid="DEU 5:14"/><verse number="15" style="v" sid="DEU 5:15"/>ኔኒ ግብፀ ቢታን አይለ ግዳዳ ደእዳይሳ ዶጎፓ። ጎዳይ፥ ነ ፆሳይ ባ ዎልቃማ ኩሽያንነ ባ ምጨትዳ ቀስያን ያፐ ነና ከስዳይሳ ዶጎፓ። ጎዳይ፥ ነ ፆሳይ ሳምባታ ጋላስ ኔኒ ናጋና መላ ኪትዳይ ሄሳ ግሾሳ።<verse eid="DEU 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 5:16"/>“ጎዳይ፥ ነ ፆሳይ ነዉ እምያ ቢታን ነ ላይይ አዱቃና ማላነ ነዉ ሎአና መላ ጎዳይ፥ ነ ፆሳይ ነና ኪትዳይሳዳ ነ አዋነ ነ አይዉ ቦንቻ።<verse eid="DEU 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 5:17"/>“ዎፓ።<verse eid="DEU 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 5:18"/>“ላሞፋ።<verse eid="DEU 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 5:19"/>“ካይሶቶፓ።<verse eid="DEU 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 5:20"/>“ዎርዶ ማርካቶፋ።<verse eid="DEU 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 5:21"/>“ሀራ አሳ ማቾ አሞቶፋ፤ እያ ኬ፥ እያ ሾቃ፥ እያ አደ አይልያ ዎይኮ እያ ማጫ አይልዉ ዎይኮ እያ ቦራ ዎይኮ እያ ሀርያ ዎይኮ እያዉ ደእያባ አይባካ አሞቶፋ” ያግስ።<verse eid="DEU 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 5:22"/>ዙማ ቦላ ታማ፥ ሻራነ ማ ግዶፈ ጎዳይ ቁ ግዳ ግርሳን ዱላታ ኡባስ ኦድዳ ቃላት ሀይሳታ። እ ኤንታ ቦላ አይባካ ጉጅቤና፤ ኤንታ ናምኡ ሎቸ ሹቻታ ቦላ ፃፍድ ታዉ እሚስ።<verse eid="DEU 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 5:23"/>ዙማይ ታማን ፁገትሽን፥ ማ ግዶፈ ግርሳ ህንተ ስእዳ ዎደ ህንተ ኮቻ ሀላቃትነ ጭማት ታኮ ይድ፥ <verse eid="DEU 5:23"/><verse number="24" style="v" sid="DEU 5:24"/>ሀይሳዳ ያግዶሶና፤ “ኑኒ ጎዳ፥ ኑ ፆሳ ግርሳ ታማ ግዶፈ ስእዳ ዎደ ጎዳይ፥ ኑ ፆሳይ ባ ቦንቹዋነ ባ ግታተ ኑና በስስ። ፆሲ አሳራ ሃሳይን ስእድ አስ ደኦን ዳናዉ ዳንዳኤይሳ ሀች ኑኒ በእዳ። <verse eid="DEU 5:24"/><verse number="25" style="v" sid="DEU 5:25"/>ሽን ሀ ዎልቃማ ታማይ ኑና ይሳናዉ ዳንዳኤስ፤ ያትን፥ ኑኒ አይስ ሀይቃኔ? ጎዳ፥ ኑ ፆሳ ቃላ ኑኒ ናምአን ስእኮ ሀይቃና። <verse eid="DEU 5:25"/><verse number="26" style="v" sid="DEU 5:26"/>አሾ ማእዳ አሳን ኑኒ ስእዳይሳዳ ታማ ግዶን ግድድ ኦድሽን፥ ደኦ ፆሳ ቃላ ስእድ ደኦን ደእዳ አስ ኦኔ? <verse eid="DEU 5:26"/><verse number="27" style="v" sid="DEU 5:27"/>ሄሳ ግሾ፥ ኔኒ ሺቃዳ ጎዳይ፥ ኑ ፆሳይ ግያባ ኡባ ስአ፤ ጎዳይ፥ ኑ ፆሳይ ነዉ ኦድያባ ኑስ ኦዳ፤ ኑካ ስእድ ኪተታና” ያግደታ።<verse eid="DEU 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 5:28"/>ህንተ ታዉ ኦድሽን ጎዳይ፥ ህንተ ግያባ ስእድ፥ ታኮ ሀይሳዳ ያግስ፤ “ሀ አሳይ ነዉ ኦድያባ ኡባ ስአስ፤ ኤንቲ ግዳባ ኡባይ ልከ። <verse eid="DEU 5:28"/><verse number="29" style="v" sid="DEU 5:29"/>ኤንታዉነ ኤንታ ናይታስ መርናዉ ኡባባይ እንጀታና መላ ታዉ ያያናዉነ ታ ኪታ ናጋናዉ ኤንታዉ ኡባ ዎደ ሄሳ መላ ዎዛን ደኤረነ። <verse eid="DEU 5:29"/><verse number="30" style="v" sid="DEU 5:30"/>ሀእ ኔኒ ባዳ ኤንቲ ባንታ ዱንካንያ ስማና መላ ኦዳ። <verse eid="DEU 5:30"/><verse number="31" style="v" sid="DEU 5:31"/>ሽን ኔኒ ሀይሳን ታ ማታን ጋምአ። ኤንቲ ላታና መላ ታኒ ኤንታዉ እምያ ቢታን ኤንቲ ኦናባ ኔኒ ኤንታ ታማርሳና ታ ኪታ፥ ታ አዋጁዋነ ታ ህግያ ኡባ ታ ነዉ ኦዳና” ያግስ።<verse eid="DEU 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 5:32"/>ህንተኖ፥ እስራኤለ አሳዉ፥ ጎዳይ፥ ህንተ ፆሳይ ህንተና ኪትዳባ ኡባ ኦናዉ ናገትተ፤ እያፐ ኡሻች ዎይኮ ሀድርስ ጎፕተ። <verse eid="DEU 5:32"/><verse number="33" style="v" sid="DEU 5:33"/>ህንተ ደኦን ዳና መላ፥ ኡባይ ህንተዉ እንጀታና መላነ ህንተ ላትያ ቢታን ህንተ ላይይ አዱቃና መላ፥ ጎዳይ ህንተ ፆሳይ ህንተና ኪትዳ ኪታ ናግተ።<verse eid="DEU 5:33"/></para>
  <chapter eid="DEU 5"/>
  <chapter number="6" style="c" sid="DEU 6"/>
  <para style="s1">ግታ ኪታ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 6:1"/>ህንተ ላታናዉ ብያ ቢታን ህንተ ኦና መላ ታ ህንተና ታማርሳና መላ ጎዳይ፥ ህንተ ፆሳይ ታና ኪትዳ ኪታይ፥ አዋጆይነ ህገይ ሀይሳ። <verse eid="DEU 6:1"/><verse number="2" style="v" sid="DEU 6:2"/>ነ ላይይ አዱቃና መላ ነ፥ ነ ናይትነ ነ ናይታ ናይት ጎዳ ነ ፆሳ ያይተ፤ ታ ሀች ነዉ እምያ ጎዳ አዋጅያነ ህግያ ነ ላይ ኡባን ናጋ። <verse eid="DEU 6:2"/><verse number="3" style="v" sid="DEU 6:3"/>ነኖ፥ እስራኤለ ስአ፤ ኡባባይ ነዉ እንጀታና መላነ ጎዳይ ነ አዋታ ፆሳይ፥ ነዉ ግዳይሳዳ ማነ ኤስ ጎግያ ቢታን ነ ዳራና መላ ሀ ህገታ ስአ፤ ምንዳ ናጋ።<verse eid="DEU 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 6:4"/>ነኖ፥ እስራኤለ ስአ፤ ጎዳይ ኑ ፆሳይ እስ ፆሲ። <verse eid="DEU 6:4"/><verse number="5" style="v" sid="DEU 6:5"/>ነ ጎዳ፥ ነ ፆሳ ነ ኩመ ዎዛናፐ፥ ነ ኩመ ሸምፑዋፈነ ነ ኩመ ዎልቃፈ ዶሳ። <verse eid="DEU 6:5"/><verse number="6" style="v" sid="DEU 6:6"/>ሀች ታ ነና ኪትያ ሀ ኪታ ነ ዎዛናን ዎ። <verse eid="DEU 6:6"/><verse number="7" style="v" sid="DEU 6:7"/>ኤንታ ኔኒ ነ ናይታ ታማርሳ፤ ኔኒ ነ ሶን ኡትያ ዎደ፥ ኦገ ሄመትያ ዎደ፥ ዝንእያ ዎደነ ደንድያ ዎደ ኤንታባ ሃሳያ። <verse eid="DEU 6:7"/><verse number="8" style="v" sid="DEU 6:8"/>ማላ ኦዳ ነ ኩሸን ኤንታ ቃቻ፤ ቃስ ነ ሶምኦን ማላዳ ዎ። <verse eid="DEU 6:8"/><verse number="9" style="v" sid="DEU 6:9"/>ነ ፐንገ ዝዝገታ ቦላነ ነ ድርሳ ፐንግያ ቦላ ኤንታ ፃፋ።<verse eid="DEU 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 6:10"/>ጎዳይ፥ ነ ፆሳይ ነዉ እማና ግድ ነ አዋታስ አብራሃመስ፥ ይሳቃስነ ያይቆባስ ጫቅዳ፥ ነ ኬፃቦና ግታነ ሎኦ ካታማት ኩምዳ ቢታ ነዉ እማና። <verse eid="DEU 6:10"/><verse number="11" style="v" sid="DEU 6:11"/>ኔኒ ሺሻቦና ዱረተን ኩምዳ ኬታ፥ ነ ቦካቦና ሃ ኦላታ፥ ነ ቶካቦና ዎይነነ ሻማሆ ነዉ እምያ ዎደ፥ ኔኒ ማዳ ካልዳ ዎደ፥ <verse eid="DEU 6:11"/><verse number="12" style="v" sid="DEU 6:12"/>ነና ግብፀ አይለተ ቢታፈ ከስዳ፥ ጎዳ ዶጎና መላ ናገታ። <verse eid="DEU 6:12"/><verse number="13" style="v" sid="DEU 6:13"/>ጎዳ፥ ነ ፆሳ ያያ፤ እያ ፃላላ ጎይና፤ እያ ሱንን ጫቃ። <verse eid="DEU 6:13"/><verse number="14" style="v" sid="DEU 6:14"/>ነ ዩሾን ደእያ አሳይ ጎይንያ ሀራ ፆሳታ ጎይኖፋ። <verse eid="DEU 6:14"/><verse number="15" style="v" sid="DEU 6:15"/>ነ ግዶን ደእያ ጎዳይ፥ ነ ፆሳይ ቃናትያ ፆሱ። እያ ሀንቆይ ነ ቦላ ኤፃና፤ እ ነና ቢታ ቦላፈ ፕትድ ይሳና። <verse eid="DEU 6:15"/><verse number="16" style="v" sid="DEU 6:16"/>ማሳሀን ህንተ እያ ፓጭዳይሳዳ ጎዳ ህንተ ፆሳ ፓጮፕተ። <verse eid="DEU 6:16"/><verse number="17" style="v" sid="DEU 6:17"/>ጎዳይ፥ ህንተ ፆሳይ ህንተና ኪትዳ እያ ኪታ፥ እያ ዎጋነ እያ አዋጁዋ ምንድ ናግተ። <verse eid="DEU 6:17"/><verse number="18" style="v" sid="DEU 6:18"/>ነዉ ኡባባይ እንጀታና መላ ጎዳ ስንን ነ ሱረባነ ሎኦባ ኦ። ሄሳ ኦኮ፥ ነዉ እማናዉ ጎዳይ ነ አዋታስ ጫቅዳ፥ ሄ ሎኦ ቢታ ነ ላታና። <verse eid="DEU 6:18"/><verse number="19" style="v" sid="DEU 6:19"/>ጎዳይ ግዳይሳዳ ኔኒ፥ ነ ሞርከታ ኡባ ነ ስንፈ ጎዳና።<verse eid="DEU 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 6:20"/>ዎደፐ ነ ናይት፥ “ጎዳይ፥ ኑ ፆሳይ ህንተና ኪትዳ ሀ ዎጋ፥ አዋጅያነ ህግያ ብርሸይ አይቤ?” ያግድ ህንተና ኦይችያ ዎደ፥ <verse eid="DEU 6:20"/><verse number="21" style="v" sid="DEU 6:21"/>ነ ኤንታዉ ሀይሳዳ ያጋዳ ዛራና፤ “ኑኒ ግብፀ ቢታን ግብፀ ካዋ አይለታ፥ ሽን ጎዳይ ባ ምኖ ኩሽያን ኑና ግብፀፈ ከስስ። <verse eid="DEU 6:21"/><verse number="22" style="v" sid="DEU 6:22"/>ጎዳይ ኑ ፄልሽን፥ ግብፀ ቢታ ቦላ፥ ግብፀ ካዋ ቦላነ እያ ሹማታ ኡባ ቦላ ግታነ ያሽያ ማላታታነ ማላልስያባታ ኦስ። <verse eid="DEU 6:22"/><verse number="23" style="v" sid="DEU 6:23"/>ሽን እ ኑ ማይዛስ እማና ግድ ጫቅዳ ቢታ ኑስ እማናዉ ኑና ግብፀፈ ከስስ። <verse eid="DEU 6:23"/><verse number="24" style="v" sid="DEU 6:24"/>ያትድ ሀች ህንተ በኤይሳዳ ኑስ ኡባ ዎደ ሎኦ ግዳና መላነ ኑኒ ደኦን ዳና መላ፥ ጎዳይ፥ ሀ አዋጆታ ኡባ ኑን ናጋና መላነ ጎዳስ ኑ ፆሳስ ያያና መላ ኪትስ። <verse eid="DEU 6:24"/><verse number="25" style="v" sid="DEU 6:25"/>እ ኑና ኪትዳይሳዳ፥ ጎዳ፥ ኑ ፆሳ ስንን ሀ ኪታ ኡባ ምንድ ናግኮ፥ ሄስ ኑስ ፅሎተ ግዳና” ያግተ።<verse eid="DEU 6:25"/></para>
  <chapter eid="DEU 6"/>
  <chapter number="7" style="c" sid="DEU 7"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 7:1"/>ጎዳይ፥ ነ ፆሳይ ነ ላታናዉ ብያ ቢታ ነና ገልስያ ዎደነ ኔፐ ዎልቃማነ ምንያ ላፑን ካዎተታ፥ ሄሳትካ ህተታ፥ ገርገሰታ፥ አሞረታ፥ ካናነታ፥ ፓርዘታ፥ ህወታነ ያቡሰታ ነ ስንፈ ጎድያ ዎደ፥ <verse eid="DEU 7:1"/><verse number="2" style="v" sid="DEU 7:2"/>ጎዳይ ነ ፆሳይ ነ ኩሸን አድ እምን፥ ነ ኤንታ ፆንያ ዎደ፥ ኤንታ ኩመ ይሳ። ኤንታራ አይብባካ ጫቆፋ፤ ኤንታዉ ቃቶፋ። <verse eid="DEU 7:2"/><verse number="3" style="v" sid="DEU 7:3"/>ኤንታራ ኤከቶፋ፤ ገለቶፋ። ነ ማጫ ናይታ ኤንታ አደ ናይታስ እሞፋ ዎይኮ ኤንታ ማጫ ናይታ ነ አደ ናይታስ ኤኮፋ። <verse eid="DEU 7:3"/><verse number="4" style="v" sid="DEU 7:4"/>ኤንቲ ነ ናይታ ታና ካለይሳ አግድ ሀራ ኤቃታ ጎይናና መላ ኦና። ሄ ዎደ ጎዳ ሀንቆይ ነ ቦላ ኤፃና፤ ነና ኤለስድ ይሳና። <verse eid="DEU 7:4"/><verse number="5" style="v" sid="DEU 7:5"/>ሄሳ ግሾ፥ ኤንታ ያርሾ በሳ ላልተ፤ ጎይንያ ሹቻ ኤቃታ መንረተ። አሼራ ጌተትያ ኤቃ ምስልያ ትንቸረተ፤ ኩሸን ኦሰትዳ ምስለታ ታማን ፁግተ። <verse eid="DEU 7:5"/><verse number="6" style="v" sid="DEU 7:6"/>ኔኒ፥ ነ ጎዳ ፆሳስ ጌሻ ደረ። ጎዳይ፥ ነ ፆሳይ ነና ባዉ ዱማ አስ ኦድ ቢታ ቦላ ደእያ አሳ ኡባፈ ነና ዶርስ።<verse eid="DEU 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 7:7"/>ጎዳይ ህንተና ዶስዳይነ ዶርዳይ ህንተ ሀራ አሳፐ ታይቦን ዳርዳ ግሾ ግደና። ህንተ ሀራ አሳ ኡባፈ ታይቦን ጉ። <verse eid="DEU 7:7"/><verse number="8" style="v" sid="DEU 7:8"/>ሽን ጎዳይ ህንተና ዶስዳ ግሾነ ህንተ ማይዛታስ ጫቅዳ ጫቁዋ ናግዳ ግሾ፥ እ ህንተና አይለተ ቢታፈ፥ ግብፀ ካዋ ኩሸፐ፥ ባ ዎልቃማ ኩሽያን ከስስነ ዎዝስ። <verse eid="DEU 7:8"/><verse number="9" style="v" sid="DEU 7:9"/>ሄሳ ግሾ፥ ጎዳይ፥ ህንተ ፆሳይ ፆሴ ግደይሳ ኤርተ። እ ባና ዶሰይሳታስነ ባ ኪታ ናገይሳታስ ሙኩሉ የለተ ጋካናዉ፥ ባ ሲቁዋ ናግያ አማነትያ ፆሲ። <verse eid="DEU 7:9"/><verse number="10" style="v" sid="DEU 7:10"/>ሽን እ ባና እፀይሳታ ሴራናዉነ ይሳናዉ ጉየ ጌና። <verse eid="DEU 7:10"/><verse number="11" style="v" sid="DEU 7:11"/>ሄሳ ግሾ፥ ታኒ ሀች ነዉ እምያ ኪታ፥ አዋጁዋነ ህግያ ናጋ።<verse eid="DEU 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 7:12"/>ነ ሀ ኪታ ስአዳ ምን ናግኮ፥ ጎዳይ፥ ነ ፆሳይ ህንተ ማይዛታስ ጫቅዳይሳዳ ባ ሲቆ ጫቁዋ ነዉ ናጋና። <verse eid="DEU 7:12"/><verse number="13" style="v" sid="DEU 7:13"/>እ ነና ዶሳና፤ ነና አንጃና፤ ነ ታይቡዋ ዳርሳና። ቃስ እ ነዉ እማናዉ ነ ማይዛታስ ጫቅዳ ቢታን ነ ኡሎ አይፍያ፥ ቢታ አይፍያ፤ ካ፥ ዎይንያ፥ ዛይትያ፥ መሄ ማራታነ ዶርሳ ማራታ ዳርስድ ነና አንጃና። <verse eid="DEU 7:13"/><verse number="14" style="v" sid="DEU 7:14"/>ነ ሀራ አሳፐ አዳ አንጀትዳይሳ ግዳና። አደይ ዎይኮ ማጭ ዎይኮ ነ መሄይ ማይነና። <verse eid="DEU 7:14"/><verse number="15" style="v" sid="DEU 7:15"/>ጎዳይ ሀርገ ኡባፈ ነና ናጋና። ነኒ ግብፀ ቢታን ኤርያ ኢታ ሀርግያ ነ ቦላ ኤሄና፥ ሽን እ ነና እፅያ ኡባ ቦላ ሄ ሀርግያ ኤሀና። <verse eid="DEU 7:15"/><verse number="16" style="v" sid="DEU 7:16"/>ጎዳይ፥ ነ ፆሳይ ነዉ አድ እምያ አሳ ኡባ ቃቶና ይሳ። ሄስ ነዉ ፅሄ ግዳና ግሾ፥ ኤንታ ፆሳታ ጎይኖፋ።<verse eid="DEU 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 7:17"/>ኔኒ፥ ነ ዎዛናን፥ “ሀ ካዎተት ታፐ ምኖሶና፤ ያትን፥ ታ ኤንታ ዋታዳ ጎዳዳ ከሳኔ?” ጋናዉ ዳንዳኣሳ። <verse eid="DEU 7:17"/><verse number="18" style="v" sid="DEU 7:18"/>ሽን ኤንታዉ ያዮፋ። ጎዳይ፥ ነ ፆሳይ፥ ግብፀ ካዋ ቦላነ ግብፀ ቢታ ኡባ ቦላ ኦዳይሳ አኬካ። <verse eid="DEU 7:18"/><verse number="19" style="v" sid="DEU 7:19"/>ጎዳይ፥ ነ ፆሳይ ነና ግብፀፈ ከስያ ዎደ ኦዳ ግታ ጋዶታ፥ ማላታታ፥ ማላልስያባታ፥ እያ ዎልቃማ ኩሽያነ እያ ምጨትዳ ቀስያ ነ፥ ነ አይፈን በአዳሳ። ሀች ነ ያይያ አሳ ኡባ ቦላ ጎዳይ፥ ነ ፆሳይ ሄሳዳ ኦና። <verse eid="DEU 7:19"/><verse number="20" style="v" sid="DEU 7:20"/>ቃስ ኔፐ ባቃትድ ቆሰትዳይሳት ያና ጋካናዉ ጎዳይ፥ ነ ፆሳይ ኤንታ ግዶን ካዠ የዳና። <verse eid="DEU 7:20"/><verse number="21" style="v" sid="DEU 7:21"/>ሄሳ ግሾ፥ ነ ኤንታዉ ያዮፋ፤ ኔራ ደእያ ጎዳይ፥ ነ ፆሳይ፥ ግታነ ያሽያ ፆሲ። <verse eid="DEU 7:21"/><verse number="22" style="v" sid="DEU 7:22"/>ጎዳይ፥ ነ ፆሳይ ሄ ካዎተታ ጉራ ጉራ ጎድድ፥ ነ ስንፈ ይሳና። ነ ኤንታ ኡባ እስ ቶሆ ይሳካ፤ ሄሳ ነ ኦኮ፥ ቢታን ደእያ ዶአት ዳርድ ነና ዋይሳና። <verse eid="DEU 7:22"/><verse number="23" style="v" sid="DEU 7:23"/>ሽን ጎዳይ፥ ነ ፆሳይ ኤንታ ነ ኩሸን አድ እማና፤ ኤንቲ ያና ጋካናዉ እ ኤንታ ዳጋንና። <verse eid="DEU 7:23"/><verse number="24" style="v" sid="DEU 7:24"/>ኤንታ ካዎታ ነ ኩሸን አድ እማና። ነ ኤንታ ሱን ሳሎፐ ጋርሳን ቁቻዳ ይሳና። ኦንካ ኔራ ኤቀትድ ዳንዳኤና፤ ነ ኤንታ ይሳና።<verse eid="DEU 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 7:25"/>ኩሸን ኦሰትዳ ኤንታ ኤቃ ምስለታ ታማን ፁጋ። ሄ ምስለታ ቦላ ደእያ ብራ ዎይኮ ዎርቃ አሞቶፍተ፤ ነባ ኦዳ ኤኮፋ። ሄስ ጎዳስ፥ ነ ፆሳስ ቱና ግድያ ግሾ፥ እያፐ ነ ኤክኮ ነዉ ፅሄ ግዳና። <verse eid="DEU 7:25"/><verse number="26" style="v" sid="DEU 7:26"/>ኤንቲ ባንታ ሁጰን ቃንገትዳይሳታ ግድያ ግሾ፥ ነ ሄ ቱና ኤቃታ ነ ሶ ገልሳዳ፥ ኤንታ መላ ባደትዳይሳታ ግዶፓ። ኤንታ ኩመ እፃ፤ ሻተታ።<verse eid="DEU 7:26"/></para>
  <chapter eid="DEU 7"/>
  <chapter number="8" style="c" sid="DEU 8"/>
  <para style="s1">ጎዳ ዶጎፕተ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 8:1"/>ህንተ ደኦን ዳና መላ፥ ህንተ ታይቦይ ዳራና መላነ ጎዳይ ካሰ ህንተ ማይዛታስ እማና ግድ ጫቅዳ ቢታ ገልድ፥ ህንተ ላታና መላ ሀች ታ ህንተና ኪትያ ኪታ ኡባ ምንድ ናግተ። <verse eid="DEU 8:1"/><verse number="2" style="v" sid="DEU 8:2"/>ጎዳይ፥ ነ ፆሳይ ነዉ እምዳ ኪታ ነ ናግያኮነ ናጎናኮ፥ ነ ዎዛና ቆፋ ኤራናዉ ነና ፓጫናዉነ ነና አዳ ኦናዉ ኦይታሙ ላይ ኩመ ነና መላ ቢታን ዋት ካለዳኮ አኬካ። <verse eid="DEU 8:2"/><verse number="3" style="v" sid="DEU 8:3"/>አዳተ ኤርሳናዉ ነና ኮሻይስስ፤ ያትድ ነ ዎይኮ ነ ማይዛት ኤሮና ማና ነና ሙዝስ። ሄሳ እ ኦዳይ አስ ጎዳ ዶናፐ ከይያ ቃላ ኡባናፐ አትሽን፥ ካ ፃላላን ደኦናይሳ ነና ታማርሳናሳ። <verse eid="DEU 8:3"/><verse number="4" style="v" sid="DEU 8:4"/>ሀ ኦይታሙ ላይታ ግዶን ነ ማእዳ ማኦይ ዉርቤና፤ ነ ቶሆይ ክፅቤና። <verse eid="DEU 8:4"/><verse number="5" style="v" sid="DEU 8:5"/>አስ ባ ናአ ሴረይሳዳ ጎዳይ፥ ነ ፆሳይ ነና ሴሮይሳ አኬካ።<verse eid="DEU 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 8:6"/>እያዉ ያያሸነ እያ ቦንቻሸ ጎዳ ነ ፆሳ ኪታ ናጋ። <verse eid="DEU 8:6"/><verse number="7" style="v" sid="DEU 8:7"/>ጎዳይ ነ ፆሳይ ነና ዛንጋራፐነ ደርያፐ ጎግያ ሻፋትነ ፑልቶት ደእያ ሎኦ ቢታ ገልሳናዉ ኤህስ። <verse eid="DEU 8:7"/><verse number="8" style="v" sid="DEU 8:8"/>ሄ ቢታይ ግስተይነ ባንግ፥ ዎይነይነ ባላሰይ፥ ኦሮማነይ፥ ሻማሆ ዛይተይነ ኤስ ኩምዳ ቢታ። <verse eid="DEU 8:8"/><verse number="9" style="v" sid="DEU 8:9"/>ሄ ቢታይ አይኮይካ ፓጮና ህንተ ካልድ ምያ ቢታ። ሄ ቢታይ ብራት ሹቻዳ ገላ ግድዳ ቢታ። ዙማፐ ማዳበ ብራታ ቦክድ ኤክያ ቢታ። <verse eid="DEU 8:9"/><verse number="10" style="v" sid="DEU 8:10"/>ነ ማዳ ካልዳ ዎደ ነው እ እምዳ ሎኦ ቢታ ግሾ፥ ጎዳ ነ ፆሳ ጋላታ። <verse eid="DEU 8:10"/><verse number="11" style="v" sid="DEU 8:11"/>ታ ሀች ነና ኪትያ እያ ኪታ፥ እያ ህግያነ እያ አዋጁዋ ናጎና እፃዳ፥ ጎዳ ነ ፆሳ ዶጎና መላ ናገታ። <verse eid="DEU 8:11"/><verse number="12" style="v" sid="DEU 8:12"/>ነ ማዳ ካልያ ዎደ፥ ሎኦ ኬ ኬፃዳ እያን ደእያ ዎደ፥ <verse eid="DEU 8:12"/><verse number="13" style="v" sid="DEU 8:13"/>ነ መሄይነ ዶርሳይ ዳርያ ዎደ፥ ነዉ ብርነ ዎርቅ ዳጋየትያ ዎደ፥ ነዉ ደእዳባይ ኡባይ ዳርያ ዎደ፥ <verse eid="DEU 8:13"/><verse number="14" style="v" sid="DEU 8:14"/>ሄ ዎደ፥ ነ ዎዛናይ ኦቶርቶና መላ፥ ግብፀ አይለተ ኬፈ ነና ዎዝዳ ጎዳ፥ ነ ፆሳ ዶጎና መላ ናገታ። <verse eid="DEU 8:14"/><verse number="15" style="v" sid="DEU 8:15"/>እ ነና ኢታ ሾሻይነ ኮርነይ ኩምዳ፥ ሃ ባይና፥ ግታነ ያሽያ መላ ቢታራ ነና ካለዳይሳ ዶጎፓ። እ ነዉ መላ ቢታን ዛላፈ ሃ ስስ። <verse eid="DEU 8:15"/><verse number="16" style="v" sid="DEU 8:16"/>ነ ማይዛት ኤሮና ማና እ ነና መላ ቢታን ሙዝስ። ዉርሰን ነዉ ኡባባይ እንጀታና መላ ነና አዳ ኦናዉነ ፓጫናዉ ሄሳ ኦስ። <verse eid="DEU 8:16"/><verse number="17" style="v" sid="DEU 8:17"/>ኔኒ፥ “ታ ዎልቃይነ ታ ኩሸ ምኖተይ ሀ ዱረተ ታዉ ኤህስ” ጎና መላ ናገታ። <verse eid="DEU 8:17"/><verse number="18" style="v" sid="DEU 8:18"/>ሽን ነ ዱረታና መላ ነዉ ዎልቃ እምዳይ ጎዳ፥ ነ ፆሳ ግደይሳ አኬካ። እ ሄሳ ኦዳይ፥ ሀች ነ በኤይሳዳ፥ ነ ማይዛታራ ጫቅዳ ጫቁዋ ምንናሳ።<verse eid="DEU 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 8:19"/>ሽን ህንተ ጎዳ ህንተ ፆሳ አግድ፥ ሀራ ፆሳታ ካልኮ፥ ኤንታዉ ሆክኮነ ጎይንኮ፥ ህንተ ቱማ ያናይሳ ታ ሀች ማርካታይስ። <verse eid="DEU 8:19"/><verse number="20" style="v" sid="DEU 8:20"/>ጎዳይ፥ ህንተ ፆሳይ ሀራ ካዎተታ ህንተ ስንፈ ይስዳይሳዳ ህንተ እያዉ ኪተቶና እፅኮ ህንተናካ ይሳና።<verse eid="DEU 8:20"/></para>
  <chapter eid="DEU 8"/>
  <chapter number="9" style="c" sid="DEU 9"/>
  <para style="s1">ኪተተ እፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 9:1"/>ነኖ፥ እስራኤለ ስአ፤ ኔፐ ግታትያነ ዎልቃምያ ካዎተታ፥ ግምበይ ሳሎ ጋክዳ ግታ ካታማታ ላታናዉ ሀች ዮርዳኖሰ ፕናሳ። <verse eid="DEU 9:1"/><verse number="2" style="v" sid="DEU 9:2"/>ሄ ቢታን ደእያ አሳይ ምኖነ አዱሰ። ኔኒ፥ “ኦንካ ኤንታራ ኤቀታናዉ ዳንዳኦና አናቀ ኮቻታ” ግሽን ስአዳሳ። <verse eid="DEU 9:2"/><verse number="3" style="v" sid="DEU 9:3"/>ሽን ምያ ታማዳ ኔፐ ስንራ በይ ጎዳ፥ ነ ፆሳ ግደይሳ ሀች ኤራ። እ ኤንታ ይሳናነ ነ ስንን ኤንታ ካዉሻና። ጎዳይ ነዉ ግዳይሳዳ ነ ኤንታ ጎዳዳ ከሳናነ ኤለሳዳ ይሳና።<verse eid="DEU 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 9:4"/>ጎዳይ፥ ነ ፆሳይ ኤንታ ነ ስንፈ ጎድዳፐ ጉየ፥ ነ ዎዛናን፥ “ታኒ ፅሎ ግድያ ግሾ፥ ሀ ቢታ ታ ላታና መላ ጎዳይ ታና ኤህስ” ጎፓ። ጎዳይ ኤንታ ነ ስንፈ የደድ ከስዳይ ኤንቲ ኢታ ግድያ ግሾሳ። <verse eid="DEU 9:4"/><verse number="5" style="v" sid="DEU 9:5"/>ነ ኤንታ ቢታ ላታናዉ ይዳይ ነ ፅሎነ ሱረ ግድያ ግሾ ግደና። ሽን ጎዳይ፥ ነ ፆሳይ ኤንታ ነ ስንፈ ጎድዳይ ሀ ካዎተት ኢታ ግድያ ግሾነ በን ነ ማይዛታስ አብራሃመስ፥ ይሳቃስነ ያይቆባስ ጫቅዳ ጫቁዋ ናጋናሳ። <verse eid="DEU 9:5"/><verse number="6" style="v" sid="DEU 9:6"/>ህዛ ነ ሄሳ አኬካ። ጎዳይ፥ ነ ፆሳይ ሀ ሎኦ ቢታ ነና ላትሰይ ነ ፅሎተ ግሾሳ ግደና፤ ነኒ ዎዛን ሙምዳ አስ።<verse eid="DEU 9:6"/></para>
  <para style="s1">ዎርቃ ማር</para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 9:7"/>ጎዳ፥ ህንተ ፆሳ መላ ቢታን ዋትድ ይሎይዳኮ ዶጎፕተ። ህንተ ግብፀ ቢታፈ ከይዳ ጋላሳፐ ዶምድ፥ ሀች ሀ በሳ ጋካናዉ ጎዳ ቦላ ማካልደታ። <verse eid="DEU 9:7"/><verse number="8" style="v" sid="DEU 9:8"/>ኮሬባ ዙማ ቦላ ጎዳይ ህንተና ይሳናዉ ደንዳና ጋካናዉ ህንተ ጎዳ ይሎይደታ። <verse eid="DEU 9:8"/><verse number="9" style="v" sid="DEU 9:9"/>ጎዳይ ህንተራ ጫቅዳ ጫቆይ ፃፈትዳ ሎቸ ሹቻታ ኤካናዉ ታኒ ዙማ ቦላ ከይዳ ዎደ፥ ያን ካ ሞናነ ሃ ኡዮና ኦይታሙ ጋላስነ ኦይታሙ ቃማ ጋምአስ። <verse eid="DEU 9:9"/><verse number="10" style="v" sid="DEU 9:10"/>ሄሳፈ ጉየ፥ ፆሳ ብራን ፃፈትዳ ናምኡ ሎቸ ሹቻታ ጎዳይ ታዉ እሚስ። ህንተ ዙማ ፃጶን ሺቅዳ ዎደ ታማ ግዶን ጎዳይ ህንተዉ እምዳ ኪታት ሄ ሎቸ ሹቻ ቦላ ፃፈትድ ኡትዶሶና። <verse eid="DEU 9:10"/><verse number="11" style="v" sid="DEU 9:11"/>ኦይታሙ ጋላሳፐነ ቃማፈ ጉየ፥ ጎዳይ ባ ጫቆ ቃላይ ፃፈትዳ ናምኡ ሎቸ ሹቻታ ታዉ እሚስ። <verse eid="DEU 9:11"/><verse number="12" style="v" sid="DEU 9:12"/>ሄሳፈ ጉየ፥ ጎዳይ ታኮ፥ “ኤለሳዳ ሀይሳፈ ዱገ ዎ፤ ኔኒ ግብፀፈ ከስዳ ነ አሳይ ቱንስ፤ ኤንቲ ታ ኪታ ኤሶን አግድ፥ ኩሸን ኦሰትዳ ኤቃ ጎይናናዉ ስምዶሶና” ያግስ።<verse eid="DEU 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 9:13"/>ቃስካ ጎዳይ ታኮ፥ “ታኒ ሀ አሳ በአስ፤ ኤንቲ ቱማ ዎዛና ሙመ አስ። <verse eid="DEU 9:13"/><verse number="14" style="v" sid="DEU 9:14"/>ህዛ ታ ኤንታ ይሶና መላነ ኤንታ ሱን ቢታ ቦላፈ ቁቾና መላ ታና ድጎፋ። ታ ነና ኤንታፈ ምኖነ ዳርያ ካዎተ ከሳና” ያግስ።<verse eid="DEU 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 9:15"/>ታኒ ጫቆ ቃላይ ፃፈትዳ ናምኡ ሎቸ ሹቻታ ታ ኩሸን ኦይካዳ ዙማ ቦላፈ ዎስ፤ ሄ ዎደ ታማ ላጮይ ዙማ ቦላ በንቴስ። <verse eid="DEU 9:15"/><verse number="16" style="v" sid="DEU 9:16"/>ሄ ዎደ ጎዳ፥ ህንተ ፆሳ ቦላ ህንተ ናጋራ ኦዳይሳ በአስ። ህንተ ማራ ምስለን ኦሰትዳ ዎርቃ ኤቃ ጊግስደታ። ጎዳይ፥ ህንተና ኪትዳ ኦግያፐ ኤሶን ሀራ ሶ ስምደታ። <verse eid="DEU 9:16"/><verse number="17" style="v" sid="DEU 9:17"/>ታኒ ታ ኩሸን ኦይክዳ ናምኡ ሎቸ ሹቻታ ሆላዳ ህንተ በእሽን መንስ። <verse eid="DEU 9:17"/><verse number="18" style="v" sid="DEU 9:18"/>ሄሳፈ ጉየ፥ ጎዳ ይሎያናዉ ህንተ እያ ስንን ኢታ ኦሶ ኦድ፥ ናጋራ ኦዳ ግሾ፥ ካሰይሳዳ ኦይታሙ ጋላስነ ኦይታሙ ቃማ ጎዳ ስንን ጉፋናዳ ጋምአስ፤ ሄ ዎደ ታ ካ ማብከ፤ ሃ ኡያብከ። <verse eid="DEU 9:18"/><verse number="19" style="v" sid="DEU 9:19"/>ጎዳይ ህንተ ቦላ ይሎትድ ይሳናዉ ደንድዳ ግሾ ታኒ ያያስ። ሽን ጎዳይ ዛሪድ ታና ስእስ። <verse eid="DEU 9:19"/><verse number="20" style="v" sid="DEU 9:20"/>ቃስ ጎዳይ ይሎትድ አሮናካ ይሳናዉ ኮይስ፤ ሽን ታኒ ሄ ዎደ አሮናስ ዎሳስ። <verse eid="DEU 9:20"/><verse number="21" style="v" sid="DEU 9:21"/>ታኒ ህንተ ናጋራን ኩምዳ ሄ ማራ ምስልያ ኤካዳ፥ ታማን ፁጋስ። እያ ትንቸረ ጋጫዳ ለ ከሳስ፤ ሄ ልያ ዙማፐ ጎግያ ሃራ የዳስ።<verse eid="DEU 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 9:22"/>ቃስ ህንተ ታበራን፥ ማሳሀንነ ቅብሮት-ሀታዋን ጎዳ ይሎይደታ። <verse eid="DEU 9:22"/><verse number="23" style="v" sid="DEU 9:23"/>ጎዳይ ህንተኮ፥ “ብድ፥ ታኒ ህንተዉ እምዳ ቢታ ላትተ” ያግድ፥ ቃደስ-ባርነፈ የድዳ ዎደካ ህንተ ጎዳ፥ ህንተ ፆሳ ኪታ እፅድ ማካልደታ። እያዉ አማነትበከታ ዎይኮ እያ ቃላስ ኪተትበከታ። <verse eid="DEU 9:23"/><verse number="24" style="v" sid="DEU 9:24"/>ታኒ ህንተና ኤርዳ ዎድያፐ ዶምድ፥ ህንተ ጎዳስ ማካልደታ።<verse eid="DEU 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 9:25"/>ጎዳይ ህንተና ይሳና ግዳ ግሾ፥ ታኒ ኦይታሙ ጋላስነ ኦይታሙ ቃማ ጎዳ ስንን ጉፋናዳ ጋምአስ። <verse eid="DEU 9:25"/><verse number="26" style="v" sid="DEU 9:26"/>ታኒ ጎዳ ፆሳኮ ሀይሳዳ ያጋዳ ዎሳስ፤ “አቤት ኡባ ሃርያ ጎዳዉ፥ ኔኒ ነ ግታ ዎልቃን ዎዝዳነ ነ ምኖ ኩሸን ግብፀፈ ከስዳ፥ ነ ላታ ግድዳ ነ አሳ ይሶፋ። <verse eid="DEU 9:26"/><verse number="27" style="v" sid="DEU 9:27"/>ነ አይለታ፥ አብራሃመ፥ ይሳቃነ ያይቆባ ቆፓ፤ ኤንታ ዎዛና ምኖተ፥ ኤንታ ኢታተነ ኤንታ ናጋራ ታይቦፓ። <verse eid="DEU 9:27"/><verse number="28" style="v" sid="DEU 9:28"/>ሄስ ሀኖና አትኮ፥ ኔኒ ኑና ያፐ ከስዳ ግብፀ አሳይ፥ ‘ጎዳይ ኤንታዉ እማና ግዳ ቢታ ገልሳናዉ ዳንዳእቦና ግሾነ ኤንታ እፅዳ ግሾ፥ መላ ቢታን ዎናዉ ኤንታ ከስስ’ ያጋና። <verse eid="DEU 9:28"/><verse number="29" style="v" sid="DEU 9:29"/>ግዶሽን፥ ሀ አሳይ ኔኒ ነ ግታ ዎልቃንነ ነ ምጨትዳ ቀሰን ግብፀፈ ከስዳ ነ ላታ ግድዳ ነ አሳ” ያጋስ።<verse eid="DEU 9:29"/></para>
  <chapter eid="DEU 9"/>
  <chapter number="10" style="c" sid="DEU 10"/>
  <para style="s1">ናምአን ታሙ ኪታታ</para>
  <para style="r">(<ref loc="EXO 34:1-10">ከሳ 34:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 10:1"/>ሄ ዎደ ጎዳይ ታኮ፥ “ኮይሮይሳ መላ ናምኡ ሎቸ ሹቻታ ጊግሳዳ ታኮ ዙማ ቦላ ከያ። ቃስ እያ ዎናዉ ምፈ ታቦተ ኦ። <verse eid="DEU 10:1"/><verse number="2" style="v" sid="DEU 10:2"/>ታኒ ካሰ ነ መንዳ ሹቻታ ቦላ ደእያ ቃላታ ሀ ሹቻታ ቦላ ፃፋና፤ ነ ኤንታ ታቦትያ ግዶን ዎ” ያግስ።<verse eid="DEU 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 10:3"/>ታኒ ሶቃላ ምፈ ታቦተ ኦስ። ካሰይሳ መላ ናምኡ ሎቸ ሹቻታ ጊግሳስ፤ ሄ ሹቻታ ታ ኩሸን ኦይካዳ ዙማ ቦላ ከያስ። <verse eid="DEU 10:3"/><verse number="4" style="v" sid="DEU 10:4"/>ህንተ ዙማ ፃጶን ሺቅዳ ጋላስ፥ ታማ ግዶፈ ጎዳይ ህንተዉ ኦድዳ ቃላታ፥ ሄስካ ታሙ ኪታታ፥ ካሰ ፃፍዳይሳታ ሄ ሹቻታ ቦላ ጎዳይ ፃፍድ ኤንታ ታዉ እሚስ። <verse eid="DEU 10:4"/><verse number="5" style="v" sid="DEU 10:5"/>ሄሳፈ ጉየ፥ ታኒ ዙማ ቦላፈ ዎዳ፥ ጎዳይ ታና ኪትዳይሳዳ፥ ሄ ሹቻታ ታ ኦዳ ታቦትያ ግዶን ዎስ፤ ሀእካ ኤንቲ ያን ደኦሶና።<verse eid="DEU 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 10:6"/>እስራኤለ አሳይ ባኣሮታ በንያቃናፐ ደንድድ፥ ሙሰራ ብዶሶና። አሮን ያን ሀይቅድ ሞገትስ፤ እያ ናአይ አላዛር እያ ላትድ፥ እያ በሳን ካህነ ሀላቃ ግድስ። <verse eid="DEU 10:6"/><verse number="7" style="v" sid="DEU 10:7"/>ኤንቲ ያፐ ጉድጎዳ ጌተትያ በሳ ብዶሶና፤ ያፐ ቃስ ጎግያ ሃት ደእያ ዮፅባታ ጌተትያ በሳ ብዶሶና። <verse eid="DEU 10:7"/><verse number="8" style="v" sid="DEU 10:8"/>ሄ ዎደ ጎዳ ጫቆ ታቦትያ ቶካና መላ፥ ጎዳ ስንን ኤቅድ እያ ሀጋዛና መላነ ሀች ጋካናዉ ኤንቲ ኦይሳ መላ ጎዳ ሱንን አንጃና መላ ሌወ ኮቻ ጎዳይ ባዉ ዱማይስ። <verse eid="DEU 10:8"/><verse number="9" style="v" sid="DEU 10:9"/>ሄሳ ግሾ፥ ሌወ ኮቻስ ኤንታ እሻታ ግዶን ግሾይ ዎይኮ ላት ባዋ፤ ጎዳይ፥ ህንተ ፆሳይ ኤንታዉ ግዳይሳዳ ኤንታ ላታይ ጎዳ።<verse eid="DEU 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 10:10"/>ታኒ ካሰይሳዳ ኦይታሙ ጋላስነ ኦይታሙ ቃማ ዙማ ቦላ ጋምአስ። ጎዳይ ዛሪድ ታ ዎሳ ስእድ ህንተና ይሳናዉ ኮይቤና። <verse eid="DEU 10:10"/><verse number="11" style="v" sid="DEU 10:11"/>ጎዳይ ታኮ፥ “ታኒ ኤንታ አዋታስ እማና ጋዳ ጫቅዳ ቢታ ኤንቲ ገላና መላነ ላታና መላ ሀ አሳ ካለ” ያግስ።<verse eid="DEU 10:11"/></para>
  <para style="s1">ፆሳስ ኪተተ</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 10:12"/>ነኖ፥ እስራኤለ፥ ጎዳይ ኔፐ ኮየይ ሀይሳ፤ ጎዳ፥ ነ ፆሳ ያያ፤ እያ ኦግያ ኡባን ባ፤ እያ ዶሳ፤ ነ ኩመ ዎዛናፐነ ነ ኩመ ሸምፑዋፈ ጎዳ ነ ፆሳስ ኦ። <verse eid="DEU 10:12"/><verse number="13" style="v" sid="DEU 10:13"/>ነዉ እንጀታና መላ ታ ሀች ነዉ እምያ ጎዳ ኪታታነ አዋጆታ ናጋ።<verse eid="DEU 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 10:14"/>ሳሎይነ ሳሎፐ ቦላራ ደእያ ሳሎት፥ ቃስ ሳእነ ሳአን ደእያ ኡባይ ጎዳ፥ ነ ፆሳባ ግደይስ ቱማ። <verse eid="DEU 10:14"/><verse number="15" style="v" sid="DEU 10:15"/>ግዶሽን፥ ጎዳይ ህንተ ማይዛታን ኡፋይትድ፥ ኤንታ ሲቅስ፤ ሀች ህንተ በኤይሳዳ ኤንታፈ ጉየን ኤንታ ሼሽ ግድዳ ህንተና ካዎተታ ኡባፈ አድ ዶርስ። <verse eid="DEU 10:15"/><verse number="16" style="v" sid="DEU 10:16"/>ሄሳ ግሾ፥ ህንተ ዎዛና ቃፃርተ፤ ህዛፐ ህንተ ዎዛና ምንፍተ። <verse eid="DEU 10:16"/><verse number="17" style="v" sid="DEU 10:17"/>ጎዳይ፥ ህንተ ፆሳይ ፆሳታ ፆስነ ጎዳታ ጎዳ። እ ግታ ፆሲ፤ እ ዎልቃማነ ያሽያ ፆሲ። እ ሶምኦ በእድ ፕርደና፤ ዎፈ ኤከና። <verse eid="DEU 10:17"/><verse number="18" style="v" sid="DEU 10:18"/>እ ይኦታስነ አምኤታስ ሱረ ፕርዴስ፤ በታንቹዋ ሲቅድ፥ እያዉ ካነ ማኦ እሜስ። <verse eid="DEU 10:18"/><verse number="19" style="v" sid="DEU 10:19"/>ህንተካ በታንቾታ ሲቅተ፤ ህንተ ህንተ ሁጰን በተ አስ ግድድ ግብፀን ደእደታ። <verse eid="DEU 10:19"/><verse number="20" style="v" sid="DEU 10:20"/>ጎዳ፥ ነ ፆሳ ያያ፤ እያዉ ኦ፤ እያራ ኦይከታ፤ እያ ሱንን ጫቃ። <verse eid="DEU 10:20"/><verse number="21" style="v" sid="DEU 10:21"/>ኔኒ ነ አይፈን በእዳ ግታነ ያሽያ ማላልስያባታ ነዉ ኦዳይ፥ እ ነ ጋላታ፤ ነ ፆሳ። <verse eid="DEU 10:21"/><verse number="22" style="v" sid="DEU 10:22"/>ግብፀ ቢታ ዎዳ ህንተ ማይዛት ኩመ ላፑን ታማ፤ ሀእ ጎዳይ፥ ህንተ ፆሳይ ህንተና ሳሎ ፆልንቶታዳ ዳርስስ።<verse eid="DEU 10:22"/></para>
  <chapter eid="DEU 10"/>
  <chapter number="11" style="c" sid="DEU 11"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 11:1"/>ህዛ ጎዳ፥ ነ ፆሳ ዶሳ፤ እያ አዋጁዋ፥ ዎጋ፥ እያ ህግያነ እያ ኪታ ኡባ ዎደ ናጋ። <verse eid="DEU 11:1"/><verse number="2" style="v" sid="DEU 11:2"/>ህንተ ናይት በኦናባነ ኤሮናባ ግድኮካ፥ ህንተ ሀች ጎዳ ሴራ፥ እያ ግታተ፥ እያ ዎልቃማ ኩሽያነ ምጨትዳ ቀስያ በእዳይሳ አኬክተ። <verse eid="DEU 11:2"/><verse number="3" style="v" sid="DEU 11:3"/>ህንተ እ ኦዳ ማላታታነ ግብፀ ካዋ ቦላነ እያ ቢታ ኡባ ቦላ ኦዳ ማላልስያባታ በእደታ። <verse eid="DEU 11:3"/><verse number="4" style="v" sid="DEU 11:4"/>ኤንቲ ህንተና ካልድ ጎድዳ ዎደ፥ ጎዳይ ግብፀ ቢታ ኦላንቾታ፥ ኤንታ ፓራታነ ፓራ ጋረታ ዞኦ አባን ምትስድ፥ ሀች ጋካናዉ ኤንታ ኩመ ይስዳይሳ በእደታ። <verse eid="DEU 11:4"/><verse number="5" style="v" sid="DEU 11:5"/>ህንተ ሀ በሳ ጋካናዉ መላ ቢታን ጎዳይ ህንተዉ ኦዳባ ህንተ ኤሬታ። <verse eid="DEU 11:5"/><verse number="6" style="v" sid="DEU 11:6"/>ሮቤላ ኮቻፈ ኤልኣባ ናይታ ግድዳ ዳታነ ቦላነ አቤሮ ቦላ ጎዳይ ኦዳይሳ አኬክተ። እስራኤለ አሳ ኡባይ በእሽን፥ ቢታይ ዶየትድ፥ ኤንታ፥ ኤንታ ሶ አሳ፥ ኤንታ ዱንካንያነ ሸምፖራ ደእያ ኤንታባ ኡባ ምትስ። <verse eid="DEU 11:6"/><verse number="7" style="v" sid="DEU 11:7"/>ጎዳይ ኦዳ ሀ ግታ ኦሶታ ኡባ ህንተ፥ ህንተ አይፈን በእደታ።<verse eid="DEU 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 11:8"/>ህዛ ህንተ ምኖ ግዳና መላነ ዮርዳኖሰ ፕንድ ህንተ ኤካናዉ ብያ ቢታ ላታና መላ ታኒ ሀች ህንተና ኪትያ ኪታ ኡባ ናግተ። <verse eid="DEU 11:8"/><verse number="9" style="v" sid="DEU 11:9"/>ህንተ ኪተትኮ፥ ጎዳይ ህንተ ማይዛታስነ ኤንታ ኮቻስ እማና ግድ ጫቅዳ፥ ማነ ኤስ ጎግያ ቢታን ህንተ አዱሳ ላይ ዳና። <verse eid="DEU 11:9"/><verse number="10" style="v" sid="DEU 11:10"/>ነ ላታናዉ ብያ ቢታይ፥ ነ ከያዳ ይዳ ግብፀ ቢታ መላ ግደና። ግብፀን ነ ካ ዘራዳ፥ ጎሻ ቢታ ኡባ አታክልተ በሳዳ ሃ ኡሻሳ። <verse eid="DEU 11:10"/><verse number="11" style="v" sid="DEU 11:11"/>ሽን ዮርዳኖሰ ፕንድ ህንተ ላታናዉ ብያ ቢታይ፥ ደረይነ ዛንጋራይ ደእያ፥ ሳሎ እራን አልያ ቢታ። <verse eid="DEU 11:11"/><verse number="12" style="v" sid="DEU 11:12"/>ሄ ቢታይ፥ ጎዳይ ነ ፆሳይ ናግያ ቢታ፤ ላይ ዶመፈ ብድ ላይ ዉርሰ ጋካናዉ ጎዳ፥ ነ ፆሳ አይፈይ እያ ቦላ ደእያ ቢታ።<verse eid="DEU 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 11:13"/>ሄሳ ግሾ፥ ጎዳ፥ ህንተ ፆሳ ሲቅኮ፥ ህንተ ኩመ ዎዛናፐነ ህንተ ኩመ ሸምፑዋፈ እያ ጎይንኮ፥ ታኒ ሀች ህንተዉ እምያ ኪታ ህንተ ናግኮ፥ <verse eid="DEU 11:13"/><verse number="14" style="v" sid="DEU 11:14"/>ነ ካ፥ ዎይነይ ዛይተይ ፓጮና ሺሻና መላ ቶርቸነ ስላ እራ ዎደን ዎደን ቡክሳና። <verse eid="DEU 11:14"/><verse number="15" style="v" sid="DEU 11:15"/>ጎዳይ ነ መህያስ ማታ ዳርሳና፤ ነ ማና፤ ካላና።<verse eid="DEU 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 11:16"/>ህንተ ዎዛና ሀራ ሶ ዛሪድ፥ ሀራ ፆሳታ ጎይኖና መላነ ሆኮና መላ ናገትተ። <verse eid="DEU 11:16"/><verse number="17" style="v" sid="DEU 11:17"/>ሄሳ ህንተ ኦኮ፥ ጎዳ ሀንቆይ ህንተ ቦላ ኤፃና፤ እራይ ቡኮና መላነ ካ ዶሎና መላ እ ሳሉዋ ጎርዳና። ህንተ ጎዳይ ህንተዉ እምያ ሎኦ ቢታፈ ኤሶን ያና።<verse eid="DEU 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 11:18"/>ህዛ፥ ሀ ኪታታ ህንተ ዎዛናንነ ህንተ ቆፋን ዎተ። ማላዳ ኤንታ ህንተ ኩሸን ቃችተ፤ ቃስ ህንተ ሶምኦን ቃችተ። <verse eid="DEU 11:18"/><verse number="19" style="v" sid="DEU 11:19"/>ህንተ ናይታ ታማርስተ። ህንተ ሶን ደእያ ዎደ፥ ኦገን ሄመትያ ዎደ፥ ዝንእያ ዎደነ ደንድያ ዎደ ኤንታዉ ኦድተ። <verse eid="DEU 11:19"/><verse number="20" style="v" sid="DEU 11:20"/>ህንተ ፐንገ ዝዝግያ ቦላነ ህንተ ድርሳ ፐንግያ ቦላ ፃፍተ። <verse eid="DEU 11:20"/><verse number="21" style="v" sid="DEU 11:21"/>ሄሳ ህንተ ኦኮ፥ ጎዳይ ህንተ ማይዛታስ እማና ግድ ጫቅዳ ቢታን፥ ህንተ ላይይነ ህንተ ናይታ ላይይ ሳአፐ ቦላራ ደእያ ሳሎ መላ ግዳና።<verse eid="DEU 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 11:22"/>ህንተ ጎዳ፥ ህንተ ፆሳ ዶስኮ፥ እያ ኦገ ኡባን ህንተ ቢኮ፥ እያዉ አማነትኮ፥ ታ ሀች ህንተዉ እምያ ኪታ ህንተ ምንድ ናግኮ፥ <verse eid="DEU 11:22"/><verse number="23" style="v" sid="DEU 11:23"/>ጎዳይ ሀ ካዎተታ ኡባ ህንተ ስንፈ ጎድድ ከሳና። ህንተፈ ዳርያነ ዎልቃምያ ካዎተታ ቢታ የግስድ ኤካና። <verse eid="DEU 11:23"/><verse number="24" style="v" sid="DEU 11:24"/>ቶሆን ህንተ የዳ ቢታ ኡባይ ህንተባ ግዳና። ህንተ ዛዋይ ዱገሀ መላ ቢታፈ ብድ ልባኖሰ ጋካናዉነ ኤፍራፂሳ ሻፋፐ ብድ ግታ አባ ጋካናዉ ግዳና። <verse eid="DEU 11:24"/><verse number="25" style="v" sid="DEU 11:25"/>ህንተራ አይ አስካ ኤቀታናዉ ዳንዳኤና፤ ጎዳይ፥ ህንተ ፆሳይ ህንተዉ ግዳይሳዳ ህንተ ብያ ሶ ኡባን አሳይ ህንተና በእድ ዳጋማና መላነ ህንተዉ ያያና መላ ኦና።<verse eid="DEU 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 11:26"/>ሄኮ፥ ታ ሀች ህንተ ስንን አንጆነ ባደ ዎይስ። <verse eid="DEU 11:26"/><verse number="27" style="v" sid="DEU 11:27"/>ታ ሀች ህንተና ኪትያ ጎዳ፥ ህንተ ፆሳ ኪታ ናግኮ፥ ህንተ አንጀታና። <verse eid="DEU 11:27"/><verse number="28" style="v" sid="DEU 11:28"/>ሽን ታኒ ህንተና ሀች ኪትያ ጎዳ፥ ህንተ ፆሳ ኪታ ናጎና እፅድ፥ ሀራ ፆሳታ ጎይናናዉ እያ ኦግያፐ ደሽኮ፥ ህንተ ባደታና። <verse eid="DEU 11:28"/><verse number="29" style="v" sid="DEU 11:29"/>ጎዳይ፥ ህንተ ፆሳይ ህንተ ላታናዉ ብያ ቢታ ህንተና ገልስያ ዎደ፥ ባደ ጋርዛና ዙማ ቦላ፥ አንጁዋ ኤባላ ዙማ ቦላ አዋጅተ። <verse eid="DEU 11:29"/><verse number="30" style="v" sid="DEU 11:30"/>ሀ ዙማት ዮርዳኖሰ ሻፋፐ ሄፍንን ኦግያፐ ዉሎሀ ባጋን፥ አራባን ደእያ ካናነታ ቢታን፥ ጋልጋላ ስንን ደእያ ሞረ ም ማታን ደኦሶና። <verse eid="DEU 11:30"/><verse number="31" style="v" sid="DEU 11:31"/>ህንተ ሀእ ጎዳይ፥ ህንተ ፆሳይ ህንተዉ እምያ ቢታ ላታናዉ ዮርዳኖሰ ሻፋ ፕናና ሀኔታ። ህንተ ሄ ቢታ ኤክድ ያን ደእያ ዎደ፥ <verse eid="DEU 11:31"/><verse number="32" style="v" sid="DEU 11:32"/>ታ ሀች ህንተዉ እምያ አዋጆታነ ህግያ ኡባ ምንድ ናግተ።<verse eid="DEU 11:32"/></para>
  <chapter eid="DEU 11"/>
  <chapter number="12" style="c" sid="DEU 12"/>
  <para style="s1">ጎዳይ ዶርዳ ጎይኖ በሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 12:1"/>ህንተ ላታና መላ ጎዳይ፥ ህንተ አዋታ ፆሳይ ህንተዉ እምዳ ቢታን ህንተ ደእዳ ዎደ ኡባን ህንተ ኦናዉ በሲያ አዋጆትነ ህገት ሀይሳታ። <verse eid="DEU 12:1"/><verse number="2" style="v" sid="DEU 12:2"/>ህንተ ላትያ ቢታን ደእያ ካዎተታስ ደርያ ቦላ፥ ዙማ ቦላነ እስ እስ ም ጋርሳን ደእያ ጎይኖ በሳታ ይስተ። <verse eid="DEU 12:2"/><verse number="3" style="v" sid="DEU 12:3"/>ኤንታ ያርሾ በሳታ ላልተ፤ ኤንታ ጎይኖ ሹቻ ቱሳታ መንረተ። አሼራ ጌተትያ ኤንታ ኤቃ ምስልያ ታማን ፁግተ፤ ኩሸን ኦሰትዳ ኤንታ ፆሳታ ምስለታ ይስተ፤ ኤንታ ሱንታ ሄ በሳፈ ቁችተ።<verse eid="DEU 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 12:4"/>ጎዳ፥ ህንተ ፆሳ ኤንቲ ባንታ ፆሳ ጎይንያ ኦገን ጎይኖፍተ። <verse eid="DEU 12:4"/><verse number="5" style="v" sid="DEU 12:5"/>ጎዳይ፥ ህንተ ፆሳይ ህንተ ኮቸ ኡባ ግዶፈ ባ ሱንይ ያን ፄገታና መላ ዶርዳ በሳ ኮይተ። ሄ በሳ ህንተ ባናዉ ኮሼስ። <verse eid="DEU 12:5"/><verse number="6" style="v" sid="DEU 12:6"/>ህንተ ፁሳ ያርሹዋ፥ ሀራ ያርሹዋ፥ ህንተ አስራታ፥ ህንተ እሙዋ፥ ህንተ ቃንገ፥ ህንተ ዶስድ እምያ እሙዋ፥ ህንተ መህያፐነ ዶርሳፈ ባይራ ሄ በሳ ኤህተ። <verse eid="DEU 12:6"/><verse number="7" style="v" sid="DEU 12:7"/>ጎዳይ፥ ህንተ ፆሳይ ህንተና አንጅዳ ግሾ፥ ሄሳን፥ ጎዳይ፥ ህንተ ፆሳይ ደእያ በሳን፥ ህንተነ ህንተ ሶ አሳይ ማና፤ ህንተ ኩሸይ ኦዳባ ኡባን ህንተ ኡፋይታና።<verse eid="DEU 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 12:8"/>ሀች ሀይሳን ህንተ እሶይ እሶይ፥ ዶስዳባ ኦይሳዳ ሄ ዎደ ኦከታ። <verse eid="DEU 12:8"/><verse number="9" style="v" sid="DEU 12:9"/>ጎዳይ፥ ህንተ ፆሳይ ህንተዉ እምያ ሸምፖ ቢታ ቡሮ ጋክበከታ። <verse eid="DEU 12:9"/><verse number="10" style="v" sid="DEU 12:10"/>ሽን ህንተ ዮርዳኖሰ ፕንድ፥ ጎዳይ ህንተ ፆሳይ እምያ ሄ ቢታ ላትድ ያን ኡታና። ህንተና ተቅዳ ሞርከታፐ እ ህንተና ሸምፕስያ ግሾ ያን ዎፑ ግድ ህንተ ዳና። <verse eid="DEU 12:10"/><verse number="11" style="v" sid="DEU 12:11"/>ሄ ዎደ ጎዳይ፥ ህንተ ፆሳይ ባ ሱንይ ሄሳን ፄገታናዉ ዶርዳ ሄ በሳን፥ ታ ህንተና ኪትያባ ኡባ፥ ፁሳ ያርሹዋ፥ ሀራ ያርሹዋ፥ ህንተ አስራታ፥ ህንተ እሙዋነ ህንተ ቃንገ ኡባ ያ ኤሄታ። <verse eid="DEU 12:11"/><verse number="12" style="v" sid="DEU 12:12"/>ህንተ፥ ህንተ አደ ናይትነ ህንተ ማጫ ናይት፥ ህንተ አደ አይለትነ ማጫ አይለት ህንተራ ላታ ኤክቦና ህንተ ካታማን ደእያ ሌወታራ እስፈ ያን ጎዳ፥ ህንተ ፆሳ ስንን ኡፋይታና። <verse eid="DEU 12:12"/><verse number="13" style="v" sid="DEU 12:13"/>ኔኒ ፁሳ ያርሹዋ ነ ኮይዳ በሳን ጮ ያርሾና መላ ናገታ። <verse eid="DEU 12:13"/><verse number="14" style="v" sid="DEU 12:14"/>ኔኒ፥ ነ ኮቻፈ እሱዋን፥ ጎዳይ ዶርዳ በሳን፥ ነ ፁሳ ያርሹዋ ያርሻ፤ ታ ነና ኪትዳ ኡባ ያን ኦ።<verse eid="DEU 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 12:15"/>ግዶሽን ነ ደእያ በሳን አዉንካ ነ መህያፐ ጎዳይ ነና አንጅዳይሳዳ ሹካዳ ማ። ዎጋዳ ቱና ግድን ዎይኮ ቱና ግዶና አስ ኦንካ ጋራነ ገንኤ መይሳዳ ነ መህያፐ ሹካዳ ማ። <verse eid="DEU 12:15"/><verse number="16" style="v" sid="DEU 12:16"/>ሽን ሱ ሃዳ ሳአን ጉሳፈ አትሽን፥ ሞፓ። <verse eid="DEU 12:16"/><verse number="17" style="v" sid="DEU 12:17"/>ነ ካፈ፥ ዎይንያፐነ ዛይትያፐ እምያ አስራታ፥ ነ መህያፐነ ዶርሳ ዉድያፐ እምያ ባይራ፥ ጎዳስ ቃንግዳባ ኡባነ ነ ዶሳን እምያ እሙዋ ኡባ ነ ደእያ ሄራን ሞፓ። <verse eid="DEU 12:17"/><verse number="18" style="v" sid="DEU 12:18"/>ሽን ነኒ፥ ነ አደ ናይትነ ነ ማጫ ናይት፥ ነ አደ አይለትነ ማጫ አይለት ኔራ ላታ ኤክቦና ነ ካታማን ደእያ ሌወታራ እስፈ ጎዳይ፥ ነ ፆሳይ ዶርዳ በሳን፥ ጎዳ፥ ነ ፆሳ ስንን፥ ሀ ያርሾ ኡባ ማ። ነ ዳቡራዳ ሺሽዳባን ጎዳ፥ ነ ፆሳ ስንን ኡፋይታ። <verse eid="DEU 12:18"/><verse number="19" style="v" sid="DEU 12:19"/>ነ ደኦ ላይ ኡባን ሌወታ ቀል ጎና መላ ናገታ።<verse eid="DEU 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 12:20"/>እ ነዉ ገልዳ ቃላዳ ጎዳይ ነ ፆሳይ ነ ዛዋ ዳልግስያ ዎደ ነና አሾ ማናዉ ኮሽያ ዎደ ነ ኮይዳ መላ ማ። <verse eid="DEU 12:20"/><verse number="21" style="v" sid="DEU 12:21"/>ሽን ጎዳይ፥ ነ ፆሳይ ባ ሱንይ ያን ፄገታና መላ ዶርዳ በሳይ ነዉ ሃክኮ፥ ጎዳይ ነዉ እምዳ ነ መሄ ዎይኮ ዶርሳ ዉድያፐ ታ ነና ኪትዳይሳዳ፥ ነ ኮይዳ መላ ነ ካታማን ሹካዳ ማ። <verse eid="DEU 12:21"/><verse number="22" style="v" sid="DEU 12:22"/>ዎጋዳ ቱና ግድን ዎይኮ ቱና ግዶና አስ ኦንካ ጋራ ዎይኮ ገንኤ መይሳዳ ሞ። <verse eid="DEU 12:22"/><verse number="23" style="v" sid="DEU 12:23"/>ደኦይ ሱን ደእያ ግሾ፥ ሱ ደእያ አሾ ሞና መላ ናገታ፤ ሄሳ ግሾ፥ ደኦ አሾራ ጋዳ ሞፓ። <verse eid="DEU 12:23"/><verse number="24" style="v" sid="DEU 12:24"/>ሱ ሃዳ ቢታን ጉሳፈ አትሽን፥ ሞፓ። <verse eid="DEU 12:24"/><verse number="25" style="v" sid="DEU 12:25"/>ነዉነ ኔፐ ጉየራ ያና ነ ናይታስ እንጀታና መላ ሱ ሞፓ። ሄሳ ነ ኦኮ ጎዳ ኡፋይሳሳ።<verse eid="DEU 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 12:26"/>ሽን ነ ጎዳስ ዱማይዳባነ እያዉ ቃንግዳባ ኤካዳ፥ ጎዳይ ዶርዳ በሳ ባ። <verse eid="DEU 12:26"/><verse number="27" style="v" sid="DEU 12:27"/>ፁሳ ያርሾ አሹዋነ ሱ ጎዳ፥ ነ ፆሳ ያርሾ በሳን ያርሻ። ሀራ ያርሾ ሱ ጎዳ፥ ነ ፆሳ ያርሾ በሳ ማታን ጉሳዳ አሹዋ ማ። <verse eid="DEU 12:27"/><verse number="28" style="v" sid="DEU 12:28"/>ነዉነ ነ ናይታስ እንጀታና መላ ታ ነና ኪትያ ኪታ ምንዳ ናጋ። ሄሳ ነ ኦኮ፥ ጎዳ ነ ፆሳ ኡፋይስያባነ ሱረባ ኦሳ።<verse eid="DEU 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 12:29"/>ነ ላታናዉ ብያ ካዎተ፥ ጎዳይ ነ ፆሳይ ነ ስንፈ ይስያ ዎደነ ነ ኤንታ ቢታ ላትያ ዎደ፥ <verse eid="DEU 12:29"/><verse number="30" style="v" sid="DEU 12:30"/>ኤንቲ ነ ስንፈ ይዳፐ ጉየ፥ ነ ኤንታ ፆሳታ ጎይናዳ፥ ፅሄን ኦይከቶና መላ ናገታ። ኔኒ፥ “ሀ ካዎተት ባንታ ፆሳታ ዋትድ ጎይኖና?” ያጋዳ ካላዳ ኦይቾና መላ ናገታ። <verse eid="DEU 12:30"/><verse number="31" style="v" sid="DEU 12:31"/>ኤንቲ ባንታ ፆሳታ ጎይንያ ዎደ ጎዳይ እፅያ ኡባ ኦያ ግሾ፥ ጎዳ ነ ፆሳ ነ ሄሳዳ ጎይናናዉ በሰና። ኤንቲ ሀር አቶሽን፥ ባንታ አደ ናይታነ ማጫ ናይታ ባንታ ፆሳታስ ያርሾ ኦድ ታማን ፁጎሶና።<verse eid="DEU 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 12:32"/>ህዛ ታ ነና ኪትዳባ ኡባ ኦ፤ እያ ቦላ ጉጆፋ፤ እያፐ ፓጭሶፓ።<verse eid="DEU 12:32"/></para>
  <chapter eid="DEU 12"/>
  <chapter number="13" style="c" sid="DEU 13"/>
  <para style="s1">ሀራ ፆሳታ ጎይኖፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 13:1"/>ነ ግዶን ትንብተ ኦድያ ዎይኮ አሙሆ ብርሽያ አስ ደንድድ፥ ማላታነ ማላልስያባታ ኦኮ፥ <verse eid="DEU 13:1"/><verse number="2" style="v" sid="DEU 13:2"/>እ ኦድዳ ማላታይ ዎይኮ ማላልስያባይ ቱማ ግድድ ፖለትን፥ እ ኔኮ፥ “አነ ካሰ ነ ኤሮና ሀራ ፆሳታ ጎይኖስ” ያግኮ፥ <verse eid="DEU 13:2"/><verse number="3" style="v" sid="DEU 13:3"/>ነ እያ ኡባራካ ስኦፓ። ህንተ ኩመ ዎዛናፐነ ኩመ ሸምፑዋፈ ጎዳ ህንተ ፆሳ ዶስያኮነ ዶሶናኮ ፓጫናዉ ሄሳ ኦስ። <verse eid="DEU 13:3"/><verse number="4" style="v" sid="DEU 13:4"/>ጎዳ ህንተ ፆሳ ካልተ፤ እያዉ ያይተ፤ እያ ኪታ ናግተ፤ እያ ቃላ ስእተ፤ እያዉ ጎይንተ፤ እያፐ ዱፆፍተ። <verse eid="DEU 13:4"/><verse number="5" style="v" sid="DEU 13:5"/>ህንተና ግብፀ አይለተፈ ዎዝዳ ጎዳ፥ ህንተ ፆሳ ቦላ ህንተ ማካላና መላ ታማርስያ ናበ ዎይኮ አሙሆ ብርሽያ ኡራ ዎተ። ሄሳ መላ አስ ህንተ ጎዳ፥ ህንተ ፆሳ ኪታፐ ካረ ከያና መላ ኦያ ግሾ፥ እያ ዎተ፤ ኢታ ህንተ ግዶፈ ድግተ።<verse eid="DEU 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 13:6"/>ሀር አቶሽን፥ ነ እሻይ ዎይኮ ነ አደ ናአይ ዎይኮ ነ ማጫ ናእያ ዎይኮ ነ ዶስያ ማችያ ዎይኮ ነ ማታ ላገይ፥ “ካሰ ነነ ነ ማይዛት ጎይን ኤሮና ፆሳታ ጎይናናዉ የ። <verse eid="DEU 13:6"/><verse number="7" style="v" sid="DEU 13:7"/>ቢታ ሀ ጋፃፐ ያ ጋፃ ጋካናዉ ደእያ፥ ነ ዩሾ ኡባን ማታንነ ሃሆን ደእያ አሳ ኡባይ ጎይንያ ፆሳታ ጎይናናዉ የ” ያግድ ባለኮ፥ <verse eid="DEU 13:7"/><verse number="8" style="v" sid="DEU 13:8"/>እያዉ ኤሮ ጎፓ፤ እ ገይሳ ስኦፓ። እያዉ ቃታዳ እያ ሸምፑዋ አሾፋ፤ <verse eid="DEU 13:8"/><verse number="9" style="v" sid="DEU 13:9"/>እያ ዎናዉ በሴስ። እያ ዎናዉ ኮይሮ ነ ዶማ፤ ሄሳፈ ጉየ፥ አሳ ኡባይ ካልድ ዎ። <verse eid="DEU 13:9"/><verse number="10" style="v" sid="DEU 13:10"/>እ ሀይቃና ጋካናዉ ሹቻን ጫዳ፤ እ ነና ግብፀ ቢታፈ፥ አይለተ ኬፈ ከስዳ ጎዳ፥ ነ ፆሳፈ ነና ሻካናዉ ኮዬስ። <verse eid="DEU 13:10"/><verse number="11" style="v" sid="DEU 13:11"/>እስራኤለ አሳይ ሄሳ ስእድ ያያና፤ ቃስ ሄሳ መላ ኢታባ ዛሪድ ህንተ ግዶን ኦንካ ኦና።<verse eid="DEU 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 13:12"/>ጎዳይ፥ ነ ፆሳይ ነ ዳና መላ እምዳ ካታማፐ እሱዋን ነ ደእያ ዎደ፥ <verse eid="DEU 13:12"/><verse number="13" style="v" sid="DEU 13:13"/>ነ አሳ ግዶን ኢታት ደንድድ፥ አሳኮ፥ “ኑኒ ኤሮና ፆሳታ ጎይናናዉ ደንድተ” ያግድ ባለሽን ነ ስእኮ፥ <verse eid="DEU 13:13"/><verse number="14" style="v" sid="DEU 13:14"/>ሄ ሀኖታ ኦይቻ፤ ምንዳ ፕልጋ። ሄ ነ ግዶን ኦሰትዳ ቱናባይ ቱማ ግደይሳ ሻካዳ ኤርኮ፥ <verse eid="DEU 13:14"/><verse number="15" style="v" sid="DEU 13:15"/>ሄ ካታማን ደእያ አሳ ኡባ ማሻን ዉርሳ፤ ሄ ካታማነ እያን ደእያ መህያ አሾና ይሳ። <verse eid="DEU 13:15"/><verse number="16" style="v" sid="DEU 13:16"/>ሄ ካታማፐ ነ ኤክዳ ድኦ ኡባ ካታማ ዳባባ ሺሻዳ፥ ሄ ካታማነ እያ ድኡዋ ኡባ ጎዳስ፥ ነ ፆሳስ፥ ፁሳ ያርሾ ኦዳ ዉርሳዳ ፁጋ። እ መርናዉ ዛሪድ ኬፀቶና ላለ ዶረ ግድድ አታና። <verse eid="DEU 13:16"/><verse number="17" style="v" sid="DEU 13:17"/>ሀ ድገትዳ ሚሸታፐ አይብካ ነ ኩሸን በንቶፎ። ጎዳይ ባ ዎልቃማ ሀንቁዋፈ ስሚድ፥ ነና ማራና፤ እ ነዉ ቃታና። ካሰ ነ ማይዛታስ ጫቅዳ ጫቁዋዳ ነ ታይቡዋ ዳርሳና። <verse eid="DEU 13:17"/><verse number="18" style="v" sid="DEU 13:18"/>ታኒ ሀች ነና ኪትያ ኪታ ኡባ ነ ናጋዳ፥ ጎዳ፥ ነ ፆሳስ ኪተትኮ፥ ጎዳ ነ ፆሳ ኡፋይስያባ ኦኮ፥ ሀ ግዳባይ ነዉ ፖለታና።<verse eid="DEU 13:18"/></para>
  <chapter eid="DEU 13"/>
  <chapter number="14" style="c" sid="DEU 14"/>
  <para style="s1">ቱናነ ቱና ግዶና ካ</para>
  <para style="r">(<ref loc="LEV 11:1-47">ሌወ 11:1-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 14:1"/>ህንተ፥ ጎዳ ህንተ ፆሳ ናይታ፤ ሀይቅዳ አሳስ ህንተ አሳተ ጋሮፕተ፤ ህንተ ሁጵያ ቡሉሶፕተ። <verse eid="DEU 14:1"/><verse number="2" style="v" sid="DEU 14:2"/>ህንተ፥ ጎዳ ህንተ ፆሳስ ጌሻ ደረ፤ ጎዳይ ህንተና ባ አሰ ግዳና መላ ቢታን ደእያ አሳ ኡባፈ ባዉ ዶርስ።<verse eid="DEU 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 14:3"/>ኔኒ ቱናባ አይባካ ሞፓ። <verse eid="DEU 14:3"/><verse number="4" style="v" sid="DEU 14:4"/>ነ ማና መሄትነ ዶአት ሀይሳታ፤ ቦር፥ ዶርሰ፥ ዴሸ፥ <verse eid="DEU 14:4"/><verse number="5" style="v" sid="DEU 14:5"/>ዶገ፥ ባቾ፥ ዎሽኤ፥ ዎራ ዴሽ፥ ዋልያ፥ ጋራነ ዙማ ዶርሰ። <verse eid="DEU 14:5"/><verse number="6" style="v" sid="DEU 14:6"/>ሹቁለይ ጳልቀትዳይሳነ ዋሞትያ መሄታነ ዶአታ ኡባ ሚተ። <verse eid="DEU 14:6"/><verse number="7" style="v" sid="DEU 14:7"/>ሽን ሹቁለይ ጳልቀቶናይሳታነ ዋሞቶናይሳታ ሞፓ፤ ሄስካ ግማለ፥ ኤሸነ ጉፓለ። ሀይሳቲ ዋሞቶሶና፥ ሽን ኤንታ ሹቁለይ ጳልቀትቦና ግሾ፥ ኤንቲ ህንተዉ ቱና። <verse eid="DEU 14:7"/><verse number="8" style="v" sid="DEU 14:8"/>ጉዱንስ ሹቁለይ ጳልቀ፥ ሽን ዋሞቶና ግሾ እ ህንተዉ ቱና። እያ አሹዋ ሞፓ፤ እያ ባዉታ ቦቾፍተ።<verse eid="DEU 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 14:9"/>ሃ ግዶን ደእያ መተታ ግዶፈ ህንተ ማናይሳት ሀይሳታ፤ ሞሎ መላ ቀፈይነ ፖቆይ ደእያ ኡባ ሚተ። <verse eid="DEU 14:9"/><verse number="10" style="v" sid="DEU 14:10"/>ሽን ሞሎ መላ ቀፈይነ ፖቆይ ባይናይሳታ ሞፕተ ሄስ ህንተዉ ቱና።<verse eid="DEU 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 14:11"/>ቱና ግዶና ካፎ ኡባ ሚተ። <verse eid="DEU 14:11"/><verse number="12" style="v" sid="DEU 14:12"/>ሽን ካፎታፐ ህንተ ሞና አጋና ካፎት ሀይሳታ፤ አርጋን፥ ባዞ አንኮ፥ ካሬ አንኮ፥ <verse eid="DEU 14:12"/><verse number="13" style="v" sid="DEU 14:13"/>ጵርጮ፥ ፅሎ ኮቸ ኡባ፥ <verse eid="DEU 14:13"/><verse number="14" style="v" sid="DEU 14:14"/>ቆራሰ ኮቸ ኡባ፥ <verse eid="DEU 14:14"/><verse number="15" style="v" sid="DEU 14:15"/>ያንቾ፥ ሃ ካፎ፥ ቃማ ካፎ ኮቸ ኡባ፥ <verse eid="DEU 14:15"/><verse number="16" style="v" sid="DEU 14:16"/>ላፋ ጉቶ፥ ዲድን፥ ሃ ኩቶ፥ <verse eid="DEU 14:16"/><verse number="17" style="v" sid="DEU 14:17"/>ባዞ ጉቶ፥ ሞሎ ካፎ፥ ሶሌ፥ ሀዛዞ፥ <verse eid="DEU 14:17"/><verse number="18" style="v" sid="DEU 14:18"/>ሳብሳ ጌተትያ ካፎ ኮቸ ኡባ፥ አያና ካፎነ ሽርሽቆ። <verse eid="DEU 14:18"/><verse number="19" style="v" sid="DEU 14:19"/>ቀፈራ ደእያ ላፋ መተት ኡባይ ህንተዉ ቱና፤ ኤንታ ሞፕተ። <verse eid="DEU 14:19"/><verse number="20" style="v" sid="DEU 14:20"/>ሽን ቀፈራ ደእያባታፐ ቱና ግዶናይሳታ ሚተ።<verse eid="DEU 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 14:21"/>ኔኒ፥ ጎዳ ነ ፆሳስ ጌሻ አስ ግድያ ግሾ፥ ባዉታ ኡባ ሞፓ። ሄሳ ህንተ ካታማን ደእያ በተ አሳይ ማና መላ ኤንታዉ እማናዉ ዳንዳኤታ፤ ዎይኮ ሀራ ቢታ አሳስ ባይዛናዉ ዳንዳኤታ።</para>
  <para style="p" vid="DEU 14:21">ዴሻ ናአ እያ አየ ማራ ካፋ።<verse eid="DEU 14:21"/></para>
  <para style="s1">አስራታ እሞ ዎጋ</para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 14:22"/>ነ ጋደን ላይን ላይን ካፅያ ካ አይፈ ኡባፈ አስራታ ከሳ። <verse eid="DEU 14:22"/><verse number="23" style="v" sid="DEU 14:23"/>ነ ኡባ ዎደ ጎዳስ ነ ፆሳስ፥ ያሽ ታማራና መላ ባ ሱንይ ፄገታና መላ እ ዶርዳ በሳን፥ ነ ካ፥ ዎይነ ኡሻነ ዛይትያ አስራታ፥ ነ ዶርሳፈነ መህያፐ ባይራ የለትዳይሳ ያን፥ ጎዳ፥ ነ ፆሳ ስንን ማ። <verse eid="DEU 14:23"/><verse number="24" style="v" sid="DEU 14:24"/>ጎዳይ ነ ፆሳይ ባ ሱንይ ፄገታና መላ ዶርዳ በሳይ፥ ነ ደእያ በሳፈ ዳሮ ሃሆ ግድኮ፥ ጎዳይ ነና አንጃና መላ ነ አስራታ ያ ኤፋናዉ ዳንዳኦናባ ግድኮ፥ <verse eid="DEU 14:24"/><verse number="25" style="v" sid="DEU 14:25"/>ሄ አስራታ ባይዛዳ ሚሽያ ጎዳይ፥ ነ ፆሳይ ዶርዳ በሳ ኤፋ። <verse eid="DEU 14:25"/><verse number="26" style="v" sid="DEU 14:26"/>ሄ ሚሽያን ነ ኮይዳ ሚዝ ዎይኮ ዶርሰ ዎይኮ ዎይነ ኡሽ ዎይኮ ሀራ ምኖ ኡሽ ዎይኮ ሀራ ነ ኮይያባ ሻማዳ፥ ነነ ነ ሶ አሳይ ጎዳ፥ ነ ፆሳ ስንን ሄሳ ማዳ ኡፋይታ።<verse eid="DEU 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="DEU 14:27"/>ኤንቲ ኔራ ሻከትድ ኤክዳ ሀራ ላት ኤንታዉ ባይና ግሾ፥ ሄሳ ነ ኦያ ዎደ ነ ካታማን ደእያ ሌወታ ዶጎፓ። <verse eid="DEU 14:27"/><verse number="28" style="v" sid="DEU 14:28"/>ሄን ላይን ላይን ነ ካ አስራታ ኤሀዳ ነ ካታማን ሺሻ። <verse eid="DEU 14:28"/><verse number="29" style="v" sid="DEU 14:29"/>ሄሳ ነ ካታማን ደእያ፥ ኔራ ሻክትድ ኤክዳ ሀራ ላት ባይና ሌወት፥ በተ አሳይ፥ ይኦ ናይትነ አምኤት ይድ ሞ። ያትኮ፥ ነ ኦያ ኦሶ ኡባን ጎዳይ፥ ነ ፆሳይ ነና አንጃና።<verse eid="DEU 14:29"/></para>
  <chapter eid="DEU 14"/>
  <chapter number="15" style="c" sid="DEU 15"/>
  <para style="s1">ላፑን ላይ</para>
  <para style="r">(<ref loc="LEV 25:1-7">ሌወ 25:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 15:1"/>“ላፑን ላይ ዉርሰን ታልኤ አጮ ኡባ ማራ። <verse eid="DEU 15:1"/><verse number="2" style="v" sid="DEU 15:2"/>ነ አጮ ማራና ዎጋይ ሀይሳ፤ እስራኤለ ግድዳ ባ እሻስ ታልእዳ ኦንካ ሄ አጩዋ ማሮ። ጎዳ ማሮተይ አዋጀትዳ ግሾ፥ እስራኤለ ግድዳ ባ እሻስ ታልእዳ ባ ታልእያ ኦይቾፎ። <verse eid="DEU 15:2"/><verse number="3" style="v" sid="DEU 15:3"/>ሀራ ቢታ አሳስ ነ ታልእዳ አጩዋ ኤካናዉ ዳንዳኣሳ፥ ሽን ነ ኮቻስ ታልእዳባ ኡባ ማራ።<verse eid="DEU 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 15:4"/>“ነ ላታና መላ ጎዳይ፥ ነ ፆሳይ ነዉ አቆ ኦድ እምያ ቢታን፥ ጎዳይ ነና አንጃና ግሾ ነ ግዶን ማንቆይ ዴና። <verse eid="DEU 15:4"/><verse number="5" style="v" sid="DEU 15:5"/>ነ ጎዳስ ነ ፆሳስ ኪተትኮ፥ ታ ሀች ነና ኪትያ ኪታ ኡባ ናግኮ፥ ነ ፖሎ አንጀታና። <verse eid="DEU 15:5"/><verse number="6" style="v" sid="DEU 15:6"/>ጎዳይ፥ ነ ፆሳይ ነዉ ኦድዳይሳዳ ነና አንጃና፤ ዳሮ ካዎተት ህንተፈ ታልአና፥ ሽን ህንተ እሱዋፈካ ታልኤከታ። ቃስ ነ ካዎተታ ሃራና፥ ሽን እሶይካ ነና ሃረና።<verse eid="DEU 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 15:7"/>“ጎዳይ፥ ነ ፆሳይ ነዉ እምያ ቢታን ደእያ ካታማታፐ እሱዋን ደእያ እስራኤለ አስ ማንቅድ በንትኮ፥ እያዉ ኡሎ ምኖፋ፤ ነ ኩሽያ ሺሻ ኤኮፋ። <verse eid="DEU 15:7"/><verse number="8" style="v" sid="DEU 15:8"/>ነ ኩሽያ እያዉ ብርሻ፤ እያ ኮሽያባ ታልአ።<verse eid="DEU 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 15:9"/>“አጮ ማርያ ላፑን ላይ ማትስ” ጋዳ፥ ማንቆ እስራኤለ አስ ታልኤ ድጎፋ፤ ሄሳ መላ ኢታ ቆፍ ነ ዎዛናን ገሎፖ። ነ እያዉ ታልኦና እፅን፥ እ ፆሳኮ ዬክኮ፥ ሄስ ነዉ ናጋራ ግዳና። <verse eid="DEU 15:9"/><verse number="10" style="v" sid="DEU 15:10"/>ነ እያዉ ኬሀተን እማ፤ ነ ዎዛናን አይስ እምያና ጋዳ ኡዘቶፋ። ሄሳ ነ ኦኮ፥ ጎዳይ ነ ፆሳይ ነና ኦይክዳባን የዳባን ኡባን አንጃና። <verse eid="DEU 15:10"/><verse number="11" style="v" sid="DEU 15:11"/>አዉደካ ግድን፥ ቢታ ቦላፈ ማንቆይ ዮና ግሾ፥ ነ እስራኤለታስ፥ ማንቆታስነ መቶታንቾታስ ህንተ ኬሀ ግዳና መላ ኪታይስ።<verse eid="DEU 15:11"/></para>
  <para style="s1">አይለታ ኦይ ዎጋ</para>
  <para style="r">(<ref loc="EXO 21:1-11">ከሳ 21:1-11</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 15:12"/>አደ ግድን ማጫ ግድን፥ እስራኤለ አስ፥ አይለ ኦድ ሻምኮ፥ እ ነዉ ኡሱፑን ላይ ኦ፤ ላፑን ላይን አይለተፈ ላአ ከዮ። <verse eid="DEU 15:12"/><verse number="13" style="v" sid="DEU 15:13"/>ነኒ አይለተፈ እያ ከሳ የድያ ዎደ መላ ኩሸ የዶፋ። <verse eid="DEU 15:13"/><verse number="14" style="v" sid="DEU 15:14"/>ጎዳይ ነ ፆሳይ ነና አንጅዳይሳ መላ ነ መህያፐ፥ ሻልያፐነ ዎይነ ጉምኤፈ ኤንታዉ ኬሀተን እማ። <verse eid="DEU 15:14"/><verse number="15" style="v" sid="DEU 15:15"/>ነኒ ካሰ ግብፀ ቢታን አይለ ግድዳይሳነ ጎዳይ ነ ፆሳይ ነና ያፐ ዎዝዳይሳ ዶጎፓ። ታ ሀች ሀ ኪታ ነዉ እመይ ሄሳሳ።<verse eid="DEU 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 15:16"/>ሽን ነ አይለይ ነናነ ነ ኬ አሳ ዶስዳ ግሾነ ኔራ ደኦይ እያዉ ሎኦ ግድያ ግሾ፥ “ታኒ ነ ሶፐ ቢከ” ያግኮ፥ <verse eid="DEU 15:16"/><verse number="17" style="v" sid="DEU 15:17"/>እያ ፐንገ ኤፋዳ፥ ጎ ኤካዳ፥ እያ ሀይ ሉካ። ያትኮ፥ እ ነዉ መርናዉ አይለ ግዳና፤ ቃስ ማጫ አይለስካ ሄሳዳ ኦ። <verse eid="DEU 15:17"/><verse number="18" style="v" sid="DEU 15:18"/>እያ ኔኒ አይለተፈ ከሳዳ የድያ ዎደ ኔኒ ቆሄታስ ጋዳ ቆፖፋ። እ ሀ ኡሱፑን ላይታ ግዶን አስ ኡነ ኦይሳፈ ዳኮ ዳሮ ነዉ ኦስ። ሄሳ ግሾ፥ ኔኒ ኦያባ ኡባን ጎዳይ፥ ነ ፆሳይ ነና አንጃና።<verse eid="DEU 15:18"/></para>
  <para style="s1">ባይራ የለትያ ማራታ</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 15:19"/>ነ መህያፐነ ነ ዶርሳ ዉድያፐ ባይራ የለትዳ አደ ኡባ ጎዳስ፥ ነ ፆሳስ ዱማያ። ነ ዱማይዳ መህያፐ ባይራ የለትዳ ቦራ ጎዮፓ፤ ነ ዶርሳ ዉድያፐ ባይራ የለትዳ ዶርሳ እክስያ ሜዶፓ። <verse eid="DEU 15:19"/><verse number="20" style="v" sid="DEU 15:20"/>ነነ ነ ሶ አሳይ ጎዳይ ዶርያ በሳን ጎዳ፥ ነ ፆሳ ስንን ሄሳታ ላይን ላይን ማ። <verse eid="DEU 15:20"/><verse number="21" style="v" sid="DEU 15:21"/>ሽን ነ ያርሽያ መህያ ቦላ ቦርስያባይ በንትኮ፥ እ ዎበ ዎይኮ ቆቀ ዎይኮ ሀራ ኢታ ቦርስያባይ እያ ቦላ ደእኮ፥ ሄሳ ጎዳስ፥ ነ ፆሳስ ያርሾፋ። <verse eid="DEU 15:21"/><verse number="22" style="v" sid="DEU 15:22"/>ሄሳ ነ ደእያ ነ ካታማን ማ፤ ዎጋዳ ቱና ግዶና አስ ግድን ዎይኮ ቱና አስ ግድን ጋራነ ገንኤ አሾዳ ሞ። <verse eid="DEU 15:22"/><verse number="23" style="v" sid="DEU 15:23"/>ግዶሽን፥ ነ እያ ሱ ሃዳ ሳአን ጉሳፈ አትሽን፥ ሞፓ።<verse eid="DEU 15:23"/></para>
  <chapter eid="DEU 15"/>
  <chapter number="16" style="c" sid="DEU 16"/>
  <para style="s1">ፓስካ ባኣለ</para>
  <para style="r">(<ref loc="EXO 12:1-20">ከሳ 12:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 16:1"/>አቢባ አጌናን ጎዳ፥ ነ ፆሳ ፓስካ ባኣለ ቦንቻ፤ ጎዳይ፥ ነ ፆሳይ ነና አቢባ አጌናን ቃማ ግብፀፈ ከስስ። <verse eid="DEU 16:1"/><verse number="2" style="v" sid="DEU 16:2"/>ኔኒ ዶርሳፈነ መሄ ዉድያፐ ጎዳይ ባ ሱንይ ፄገታና መላ ዶርዳ በሳን፥ ጎዳስ፥ ነ ፆሳስ፥ ፓስካ ያርሻ። <verse eid="DEU 16:2"/><verse number="3" style="v" sid="DEU 16:3"/>ሄ ያርሹዋ ነ ምያ ዎደ እርሾይ ገልዳ ኡይራ ሞፓ። ኔኒ ግብፀ የዳዳ ኤሶን ከይያ ዎደ ኦዳይሳዳ እርሾይ ገልቦና መቶ ኡይ ላፑን ጋላስ ኩመ ማ። ነ ደኦ ላይ ኡባን ነ ግብፀፈ ከይዳ ጋላሳ ሀሳያና። <verse eid="DEU 16:3"/><verse number="4" style="v" sid="DEU 16:4"/>ነ ቢታ ኡባን ላፑን ጋላሳስ አይባ እርሾይ በንቶፎ። ቃስ ነ ኮይሮ ጋላስ ኦማርስ ያርሽዳ አሹዋፐ ዎንታስ አይብካ አቶፎ።<verse eid="DEU 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 16:5"/>ነ ፓስካ ያርሹዋ ጎዳይ ነ ፆሳይ ነዉ እምያ ካታማ አዉንካ ጮ ሹኮፋ። <verse eid="DEU 16:5"/><verse number="6" style="v" sid="DEU 16:6"/>ጎዳይ ነ ፆሳይ ባ ሱንይ ፄገታና መላ ዶርያ በሳን ነ ፓስካ ያርሹዋ ሹካ። ቃስ አው ዉልያ ዎደ ግብፀፈ ነ ከይዳ ግሾ ሄ ሳትያን ሹካ። <verse eid="DEU 16:6"/><verse number="7" style="v" sid="DEU 16:7"/>ጎዳይ፥ ነ ፆሳይ ዶርያ በሳን፥ ያን ካዳ ማ፤ ያታዳ ሳእ ዎንትያ ዎደ ነ ሶ ሶ ባ። <verse eid="DEU 16:7"/><verse number="8" style="v" sid="DEU 16:8"/>ኡሱፑን ጋላስ ኩመ እርሾይ ገልቦና ኡይ ማ፤ ላፑን ጋላስ ጎዳ፥ ነ ፆሳ ጎይናናዉ ሺቃ፤ ሄ ጋላስ አይ ኦሶካ ኦፋ።<verse eid="DEU 16:8"/></para>
  <para style="s1">ሳምንታ ባኣለ</para>
  <para style="r">(<ref loc="EXO 34:22">ከሳ 34:22</ref>፤ <ref loc="LEV 23:15-21">ሌወ 23:15-21</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 16:9"/>ነ ካ ጫካ ኦይክዳ ኮይሮ ዎድያፐ ዶማዳ፥ ላፑን ሳምንታ ኩመ ታይባ። <verse eid="DEU 16:9"/><verse number="10" style="v" sid="DEU 16:10"/>ያታዳ፥ ጎዳይ፥ ነ ፆሳይ ነና አንጅዳይሳ መላ ነ፥ ነ ዶሳን እምያ እሙዋ ኤሀዳ፥ ጎዳ፥ ነ ፆሳ ሳምንታ ባኣለ ቦንቻ። <verse eid="DEU 16:10"/><verse number="11" style="v" sid="DEU 16:11"/>ሄሳን ኔኒ፥ ነ አደ ናይት፥ ነ ማጫ ናይት፥ ነ አደ አይለትነ ነ ማጫ አይለት፥ ነ ካታማን ደእያ ሌወት፥ በተ አሳይ፥ ይኦ ናይትነ ነ ግዶን ደእያ አምኤት ኡባይ፥ ጎዳይ፥ ነ ፆሳይ ባ ሱንይ ፄገታና መላ ዶርያ በሳን ኡፋይትተ። <verse eid="DEU 16:11"/><verse number="12" style="v" sid="DEU 16:12"/>ኔኒ ግብፀ ቢታን አይለ ግድዳይሳ ሀሳያዳ ሀ ዎጋ ናጋ።<verse eid="DEU 16:12"/></para>
  <para style="s1">ሻቃራ ባኣለ</para>
  <para style="r">(<ref loc="LEV 23:33-43">ሌወ 23:33-43</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 16:13"/>ነ ዉዱማፈ ነ ካ፥ ዎይነ የያ በሳፈ ነ ዎይንያ ሺሽዳፐ ጉየ፥ ላፑን ጋላስ ሻቃራ ባኣለ ቦንቻ። <verse eid="DEU 16:13"/><verse number="14" style="v" sid="DEU 16:14"/>ኔኒ፥ ነ አደ ናይትነ ማጫ ናይት፥ ነ አደ አይለትነ ማጫ አይለት፥ ነ ካታማን ደእያ ሌወት፥ በተ አሳይ፥ ይኦ ናይትነ አምኤት ኡባይ ሄ ባልያን ኡፋይትተ። <verse eid="DEU 16:14"/><verse number="15" style="v" sid="DEU 16:15"/>ጎዳይ ዶርያ በሳን ላፑን ጋላስ ጎዳ፥ ነ ፆሳ፥ ባኣለ ቦንቻ። ነ ኡፋይታና መላ ነ አይፍስዳባንነ ነ ኩሸ ኦሶ ኡባን ጎዳይ፥ ነ ፆሳይ ነና አንጃና።<verse eid="DEU 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 16:16"/>ህንተ ቢታን ደእያ አደ ኡባይ ላይን ሄ ቶሆ፥ ኡይ ባኣለ ዎደ፥ ሳምንታ ባኣለ ዎደነ ሻቃራ ባኣለ ዎደ ጎዳ፥ ህንተ ፆሳ ስንን፥ እ ዶርያ በሳን በንቶ። ኤንቲ ጎዳ ስን ይሸ፥ መላ ኩሸ ዮፖ። <verse eid="DEU 16:16"/><verse number="17" style="v" sid="DEU 16:17"/>ጎዳይ፥ ነ ፆሳይ ነና አንጅዳይሳ መላ እሶይ እሶይ ባዉ ዳንዳኤይሳ መላ እሞ።<verse eid="DEU 16:17"/></para>
  <para style="s1">ፅሎ ፕርዳ</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 16:18"/>ጎዳይ፥ ህንተ ፆሳይ እምያ ካታማታን እስ እስ ኮቻስ ዳይናነ ሀላቃ ህንተዉ ሹምተ፤ ኤንቲ አሳስ ፅሎ ፕርዳ ፕርዶ። <verse eid="DEU 16:18"/><verse number="19" style="v" sid="DEU 16:19"/>ፅሎ ፕርዳ ዎቢሶፓ፤ ሶምኦ በአዳ ማዶፋ፤ ዎፈ ኤኮፋ። ዎፈይ ጭንጫታ አይፍያ ቆቅሴስ፥ ፅሎታ ቃላ ጌላዬስ። <verse eid="DEU 16:19"/><verse number="20" style="v" sid="DEU 16:20"/>ነ ደኦን ዳና ማላነ ጎዳይ ነ ፆሳይ ነዉ እምያ ቢታ ነ ላታና መላ ፅሎ ፕርዳ።<verse eid="DEU 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 16:21"/>ኔኒ ጎዳ፥ ፆሳ ያርሾ በሳ ማታን አሼራ ኤቃ ምስልያ ኤሶፋ። <verse eid="DEU 16:21"/><verse number="22" style="v" sid="DEU 16:22"/>ህንተ ጎዳይ፥ ፆሳይ እፅያ ጎይኖ ሹቻ ቱሱ ነዉ ኤሶፋ።<verse eid="DEU 16:22"/></para>
  <chapter eid="DEU 16"/>
  <chapter number="17" style="c" sid="DEU 17"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 17:1"/>ጎዳስ፥ ነ ፆሳስ፥ ቦርስያባይ ደእያ መሄ ዎይኮ ዶርሰ ያርሾ ኦዳ ሺሾፓ፤ ሄስ ፆሳ ስንን እፀትዳባ።<verse eid="DEU 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 17:2"/>ጎዳይ፥ ነ ፆሳይ ነዉ እምያ ካታማታፐ አዉንካ አደ ዎይኮ ማጫ ግድን ጎዳ፥ ነ ፆሳ ስንን ኢታባ ኦኮነ እያ ጫቁዋ መንድ በንትኮ፥ <verse eid="DEU 17:2"/><verse number="3" style="v" sid="DEU 17:3"/>ታ ኪታ አግድ፥ ሀራ ፆሳታ፥ አዋ ዎይኮ አጌና ዎይኮ ሳሎ ፆልንቶ ጎይንዳ አስ ደእኮ፥ <verse eid="DEU 17:3"/><verse number="4" style="v" sid="DEU 17:4"/>ሄሳ መላባ ህንተ ስእኮ፥ ሄ ኦዳ ምንድ ፕልጋ። ህንተ ኮይን፥ ሄሳ መላ ቱናባይ እስራኤለ ግዶን ኦሰትዳይስ ቱማነ ጌሽ ግድኮ፥ <verse eid="DEU 17:4"/><verse number="5" style="v" sid="DEU 17:5"/>ሄ ኢታ ኦዳ አድያ ዎይኮ ማጫስዉ ነ ካታማፐ ጋፃ ከሳዳ፥ ሹቻን ጫዳዳ ዎ። <verse eid="DEU 17:5"/><verse number="6" style="v" sid="DEU 17:6"/>እስ አስ ናምኡ ዎይኮ ሄ ማርክ ማርካቶና ደእሽን ሀይቆፎ፤ እስ አሳ ማርካን አይ አስካ ሀይቆፎ። <verse eid="DEU 17:6"/><verse number="7" style="v" sid="DEU 17:7"/>እያ ቦላ ማርካትዳ አሳት ኮይሮ እያ ሹቻን ጫዶ፤ ኤንታ ካልድ ሀንኮ አሳይ ጫዶ። ሄሳዳ ኦዳ፥ ኢታ ነ ግዶፈ ድጋ።<verse eid="DEU 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 17:8"/>ህንተ ስን ሺቅያ ሞቶይ ዴፆ ግድኮ፥ ሄስካ፥ ሸምፖ ዎ፥ ሾቸ፥ ማዱን፥ ዱማ ዱማ ሞቶታ ጎዳይ፥ ነ ፆሳይ ዶርዳ በሳ ኤሀ። <verse eid="DEU 17:8"/><verse number="9" style="v" sid="DEU 17:9"/>ካህነ ግድዳ ሌወታኮነ ዳይናታኮ ሄ ሞቱዋ ሺሻ፤ ሄ ሞቱዋ ኤንቲ ፕርዶ። <verse eid="DEU 17:9"/><verse number="10" style="v" sid="DEU 17:10"/>ጎዳይ ዶርዳ በሳን ኤንቲ ፕርድዳይሳዳ ኦ፤ ነ ኦና መላ ኤንቲ ኪትያባ ኡባ አኬካዳ ኦ። <verse eid="DEU 17:10"/><verse number="11" style="v" sid="DEU 17:11"/>ኤንቲ ነና ታማርስዳ ህግያዳነ ኤንቲ ኦድዳ ፕርዳዳ ኦ፤ ኤንቲ ፕርድዳ ፕርዳፈ ኡሻች ዎይኮ ሀድርስ ጎፓ። <verse eid="DEU 17:11"/><verse number="12" style="v" sid="DEU 17:12"/>ጎዳስ፥ ነ ፆሳስ ኦያ ዳይናስ ዎይኮ ካህንያስ ኪተቶና እፅያ አስ ደእኮ፥ ሄ ኡራይ ሀይቆ። ሄሳዳ ኦዳ፥ ኢታ እስራኤለ ግዶፈ ድጋ። <verse eid="DEU 17:12"/><verse number="13" style="v" sid="DEU 17:13"/>አሳ ኡባይ ሄሳ ስእድ ያያና፤ ዛሪድ ሄሳ መላ ኢታ ኦያ አስ ዴና።<verse eid="DEU 17:13"/></para>
  <para style="s1">ካዎ ፄልያ ዎጋታ</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 17:14"/>ጎዳይ፥ ነ ፆሳይ ነዉ እምያ ቢታ ላታዳ፥ ያን ደኦ ዶምያ ዎደ፥ ነ ዩሾን ደእያ ካዎተታዳ፥ “ኑካ ኑ ቦላ ካዎ ካዎና” ያግኮ፥ <verse eid="DEU 17:14"/><verse number="15" style="v" sid="DEU 17:15"/>ነ ካዎና ካዎይ ጎዳይ፥ ነ ፆሳይ ነዉ ዶርዳይሳ ግዳናዉ በሴስ። ሄስካ፥ ነ አሳ ግዶፈ ዶረትዳይሳ ግዶፐ አትሽን፥ ሀራ ቢታ አስ ነ ቦላ ካዎፋ። <verse eid="DEU 17:15"/><verse number="16" style="v" sid="DEU 17:16"/>ጎዳይ፥ “ሄ ኦግያራ ግብፀ ስሞፕተ” ያግዳ ግሾ፥ ሄ ካዎይ ዳሮ ፓራ ሺሻናዉ በሰና፤ ባ አሳካ ፓራ ሻማና መላ ግብፀ የዶፎ። <verse eid="DEU 17:16"/><verse number="17" style="v" sid="DEU 17:17"/>እያ ዎዛና ባለና መላ ካዎይ ዳሮ ማቾ ኤኮፎ፤ ዳሮ ዎርቃነ ብራ ሺሾፖ።<verse eid="DEU 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 17:18"/>እ ባ አራታን ኡትያ ዎደ ሌወ ኮቸ ግድዳ ካህነት ናግያ ማፃፋፐ ሀ ህግያ ዱቅድ ባዉ ኤኮ። <verse eid="DEU 17:18"/><verse number="19" style="v" sid="DEU 17:19"/>እ ሀ ህግያ ቃላነ ዎጋ ናጎነ ፖሎ ኤርድ ጎዳስ፥ ባ ፆሳስ፥ ያሽ ታማራና መላ፥ ሀ ማፃፋይ እያራ ደኦ፤ እካ ሀ ማፃፋ ባ ደኦ ላይ ኡባን ናባቦ። <verse eid="DEU 17:19"/><verse number="20" style="v" sid="DEU 17:20"/>እ ባ ዎዛናን፥ “ታኒ ታ ላገታፐ አይስ” ግድ ባ እሻታ ቦላ ኦቶርተና። እካ ፆሳ ህግያፈ ሀድርስ ዎይኮ ኡሻች ጌና። እ ባ ካዎተን አዱሳ ላይ ካዎታና፤ እያ ናይት እስራኤለ ቢታን ዳሮ ላይ ካዎታና።<verse eid="DEU 17:20"/></para>
  <chapter eid="DEU 17"/>
  <chapter number="18" style="c" sid="DEU 18"/>
  <para style="s1">ካህነታነ ሌወታ ግሹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 18:1"/>ሌወ ኮቸ ግድዳ ካህነታስነ አትዳ ኤንታ ኮቻስ እስራኤለ ግዶን ላታ ቢት ባዋ። አሳይ ጎዳስ ሺሽያ ፁሳ ያርሾይ ኤንታ ግሾ ግድያ ግሾ እያ ምሸ ዳና። <verse eid="DEU 18:1"/><verse number="2" style="v" sid="DEU 18:2"/>ኤንታዉ ኤንታ እሻታ ግዶን ላት ዴና፤ ጎዳይ ኤንታዉ ግዳይሳዳ እ ኤንታ ላታ።<verse eid="DEU 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 18:3"/>ኮርማ ዎይኮ ዶርሰ አሳይ ያርሾስ ሺሽዳይሳፈ ካህነታ ግሾይ ሀይሳ፤ ምሳይ፥ ጋጮይነ ኡሎ አሾይ ኤንታዉ እመቶ። <verse eid="DEU 18:3"/><verse number="4" style="v" sid="DEU 18:4"/>ነ ካፈ፥ ዎይንያፐነ ዛይትያፐ ኮይሮ ጋክዳ አይፍያነ ነ ዶርሳ እክስያፐ ባይራ ካህነታስ እማ። <verse eid="DEU 18:4"/><verse number="5" style="v" sid="DEU 18:5"/>ሌወት ጎዳ ሱንን መርናዉ ካህነ ግድድ ኦና መላ ነ ኮቻ ግዶፈ ጎዳይ፥ ነ ፆሳይ ኤንታ ዶርስ።<verse eid="DEU 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 18:6"/>እስ ሌወይ እስራኤለ ቢታን ደእያ እስ ካታማፐ ደንድድ፥ ጎዳይ ዶርያ በሳ ባናዉ ኮይኮ፥ <verse eid="DEU 18:6"/><verse number="7" style="v" sid="DEU 18:7"/>እ ብያ በሳን ደእያ ሌወት ጎዳ ስንን ኤቅድ ኦይሳዳ እካ ጎዳ ባ ፆሳ ስንን ኤቅድ ኦ። <verse eid="DEU 18:7"/><verse number="8" style="v" sid="DEU 18:8"/>ባና ጋክያ ግሹዋ ኤክዳባ ግድኮካ፥ ካህነት ጎኤትያ ኡባ ኤንታራ ግና ሻከትድ ኤኮ።<verse eid="DEU 18:8"/></para>
  <para style="s1">እፀትዳ ኦሶታ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 18:9"/>ጎዳይ ነ ፆሳይ እምዳ ቢታ ነ ገልያ ዎደ ሄ ቢታን ደእያ አሳይ ኦያ እፀትዳ ኦሶታ ኦፋ። <verse eid="DEU 18:9"/><verse number="10" style="v" sid="DEU 18:10"/>ባ አደ ናኣ ዎይኮ ማጫ ናእዉ ያርሾስ ታማን ፁግያ ኦንካ ነ ግዶን በንቶፎ። ብት፥ ማራጨ በኤይ፥ ማሮተይ፥ ህግሸይ፥ <verse eid="DEU 18:10"/><verse number="11" style="v" sid="DEU 18:11"/>ሞይትለ በኤይ፥ ሀይቅዳ አሳ አያና ፄገይ፥ ዎይኮ ሀይቅዳ አሳ አያናራ ኦደተይ ነ ግዶን ደኦፖ። <verse eid="DEU 18:11"/><verse number="12" style="v" sid="DEU 18:12"/>ሄሳ መላባ ኦያ ኦንካ ጎዳ ማታን እፀትዳ አስ። ኤንቲ ሄሳ መላ ቱና ኦያ ግሾ፥ ጎዳይ ነ ፆሳይ ሄ ካዎተታ ነ ስንፈ ጎዳና። <verse eid="DEU 18:12"/><verse number="13" style="v" sid="DEU 18:13"/>ሽን ነኒ ጎዳ ነ ፆሳ ስንን ቦረይ ባይናይሳ ግዳ። <verse eid="DEU 18:13"/><verse number="14" style="v" sid="DEU 18:14"/>ነኒ ላታናዉ ብያ ቢታን ደእያ ካዎተት ሙሩነይሳታነ ብተይሳታ፤ ሽን ነ ሄሳ ኦና መላ ጎዳይ ነ ፆሳይ ነና ድግስ።<verse eid="DEU 18:14"/></para>
  <para style="s1">ፆሳይ ደንና ናብያ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 18:15"/>ጎዳይ፥ ነ ፆሳይ ነ ኮቻ ግዶፈ ታ መላ ናበ ነዉ ደንና። ነ እ ገይሳ ስአ። <verse eid="DEU 18:15"/><verse number="16" style="v" sid="DEU 18:16"/>ኮሬባ ዙማ ቦላ ነ ሺቅዳ ዎደ ጎዳ ነ ፆሳ ሀይሳዳ ያጋዳ ኦይቻዳሳ፤ “ታ ሀይቆና መላ ጎዳ፥ ታ ፆሳ ግርሳ ዛራዳ ስእከ፤ ሀ ዎልቃማ ታማ ዛራዳ በእከ” ያጋዳሳ።<verse eid="DEU 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 18:17"/>ጎዳይ ታኮ፥ “ኤንቲ ቱማ ግዶሶና። <verse eid="DEU 18:17"/><verse number="18" style="v" sid="DEU 18:18"/>ታ ኤንታ ኮቻ ግዶፈ ነ መላ ናበ ኤንታዉ ደንና፤ ታኒ ታ ቃላ እያ ዶናን ዎና፤ እ፥ ታ ኪትያ ኡባ ኤንታዉ ኦዳና። <verse eid="DEU 18:18"/><verse number="19" style="v" sid="DEU 18:19"/>እ ታ ሱንን ኦድያ ታ ቃላ ስኦና ኦናካ ታ ኦይቻና። <verse eid="DEU 18:19"/><verse number="20" style="v" sid="DEU 18:20"/>ሽን ታ ኪቶናባ ታ ሱንን ኦድያ ዎይኮ ሀራ ፆሳታ ሱንን ኦድያ ሄ ናበይ ሀይቆ” ያግስ።<verse eid="DEU 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 18:21"/>ኔኒ፥ “ናበይ ኦድያ ቃላይ ፆሳፈ ግዶናይሳ ታ አይብን ሻካዳ ኤራኔ?” ያግኮ፥ <verse eid="DEU 18:21"/><verse number="22" style="v" sid="DEU 18:22"/>ሄ ናበይ ጎዳ ሱንን ኦድዳ ቃላይ ፖለቶና እፅኮ፥ ሄስ ጎዳይ ኦድቦና ቃላ ግደይሳ ኤራሳ። ሄ ናበይ ኦድያ ቃላይ ዎርዶ ግድዳ ግሾ እያ ያዮፋ።<verse eid="DEU 18:22"/></para>
  <chapter eid="DEU 18"/>
  <chapter number="19" style="c" sid="DEU 19"/>
  <para style="s1">ባቃትድ አትያ ካታማታ</para>
  <para style="r">(<ref loc="NUM 35:9-34">ታይቦ 35:9-34</ref>፤ <ref loc="JOS 20:1-9">እያ 20:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 19:1"/>ጎዳይ፥ ነ ፆሳይ ነዉ እምያ ቢታን ደእያ ካዎተታ ይስያ ዎደነ ነ ኤንታ ጎዳዳ፥ ኤንታ ካታማታንነ ኤንታ ኬታን ዱሱ ዶምያ ዎደ፥ <verse eid="DEU 19:1"/><verse number="2" style="v" sid="DEU 19:2"/>ጎዳይ፥ ነ ፆሳይ ላታ ኦድ እምያ ቢታን ደእያ ካታማታፐ ሄ ካታማታ ነዉ ዱማያ። <verse eid="DEU 19:2"/><verse number="3" style="v" sid="DEU 19:3"/>ጎዳይ፥ ነ ፆሳይ ነዉ ላታ ኦድ እምያ ቢታ ሄ ከሳዳ ሻካ። ያታዳ አሰ ዎዳ ኦንካ ሄ ካታማታኮ ኤሶን ባቃትድ አታና መላ ኦገ ጊግሳ።<verse eid="DEU 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 19:4"/>እስ አስ ካሰ ሞርከተ ባይና ደእሽን፥ ኤሮና ባ ላግያ ዎኮ፥ እ ሄ ካታማታፐ እሱዋኮ ባቃትድ ባ ሸምፑዋ አሾ። <verse eid="DEU 19:4"/><verse number="5" style="v" sid="DEU 19:5"/>ናምኡ አሳት ም ቃንፃናዉ ዎራ ብን፥ እሶይ ም ቃንፅሽን፥ ምፈ ካልታ አይፈይ ኮለትድ ሀንኩዋ ዎኮ፥ ዎዳ ኡራይ ሀ ሄ ካታማታፐ እሱዋኮ ባቃትድ፥ ባ ሸምፑዋ አሾ። <verse eid="DEU 19:5"/><verse number="6" style="v" sid="DEU 19:6"/>ባቃትድ አትያ ካታማይ እስን ፃላላ ግድኮ፥ ዎዳ ኡራይ ኤሶን ዎፅድ ጋካናዉ ኦገይ አዱሰ ግድኮ፥ ሱ ዛርያ ማታ ዳቦይ ጎድ ጋክድ፥ ይሎን ደንድድ ሀይቃናዉ በሶና ኡራ ዎናዉ ዳንዳኤስ። እ ባ ላግያ ዎዳይ ካሰ ሞርከተ ደእያ ግሾ ግደና። <verse eid="DEU 19:6"/><verse number="7" style="v" sid="DEU 19:7"/>ህንተ ሄ ካታማታ ዱማይ ዎና መላ ታ ነና ኪተይ ሄሳሳ።<verse eid="DEU 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 19:8"/>ጎዳይ፥ ነ ፆሳይ ካሰ ነ ማይዛታስ ጫቅዳይሳዳ ነ ዛዋ ዳልግስኮነ ነ ማይዛታስ እማና ግዳ ቢታ ኡባ ነዉ እምኮ፥ <verse eid="DEU 19:8"/><verse number="9" style="v" sid="DEU 19:9"/>ሀ ሄ ካታማታ ቦላ ሀራ ሄ ካታማታ ጉጃ። ሀች ታ ነና ኪትያ ኡባ ነ ፖልኮ፥ ጎዳ ነ ፆሳ ዶስኮነ እ ነና ታማርስዳ ኦግያን ምናዳ ደእኮ፥ ሀ ቢታይ ነዉ እመታና። <verse eid="DEU 19:9"/><verse number="10" style="v" sid="DEU 19:10"/>ሄሳ ነ ኦኮ፥ ጎዳይ፥ ነ ፆሳይ ላታ ኦድ ነዉ እምያ ቢታን ፅሎ አሳ ሱ ጉከና፤ ነካ ሱ ጉሳዳ ኦይሸታካ።<verse eid="DEU 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 19:11"/>ሽን እስ አስ ባ ሾሩዋ እፅድ፥ ቆሰት ናግድ እያ ዎድ፥ ሀ ካታማታፐ እሱዋኮ ባቃትኮ፥ <verse eid="DEU 19:11"/><verse number="12" style="v" sid="DEU 19:12"/>እ ደእያ ካታማን ደእያ ጭማት እ ባቃትዳ ካታማፐ ኤህስድ፥ ኩሸ ዛራናዉ ኮየይሳስ አድ እሞ። <verse eid="DEU 19:12"/><verse number="13" style="v" sid="DEU 19:13"/>እያዉ አይባካ ቃቶፋ፤ ነዉ ኡባባይ እንጀታና መላ፥ ፅሎ ሱ ጉስዳ ኡራ እስራኤለ ግዶፈ ድጋ።<verse eid="DEU 19:13"/></para>
  <para style="s1">ማርካተባ</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 19:14"/>ጎዳይ ነ ፆሳይ ነኒ ላታና መላ እምያ ቢታን፥ በን አሳይ ኤስዳ ጋደ ዛዋ ሾዶፋ።<verse eid="DEU 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 19:15"/>እስ አስ ባላ ኦናዉ እስ ማርካ ፃላል ግደና። ናምኡ ዎይኮ ሄ ማርክ ማርካትን፥ ሄ ሞቶይ ፕርደታናዉ ኮሼስ።<verse eid="DEU 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 19:16"/>እስ አስ ሀራ አስ ዎርዶን ሞትኮ፥ <verse eid="DEU 19:16"/><verse number="17" style="v" sid="DEU 19:17"/>ሞተይስነ ሞተተይስ ናምአይ ጎዳ ስንን፥ ካህነታ ስንንነ ዳይናታ ስንን ኤቆ። <verse eid="DEU 19:17"/><verse number="18" style="v" sid="DEU 19:18"/>ዳይናት ሄ ኦዳ ምንድ ፕልጎ፤ ሄ ኡራይ ባ እሻ ዎርዶን ሞተይስ ቱማ ግድኮ፥ <verse eid="DEU 19:18"/><verse number="19" style="v" sid="DEU 19:19"/>ሄ ሞተተይስ ኤካናዉ ደእያ ሴራ ሞተይስ ሴረቶ። ሄሳዳ ኦዳ፥ ኢታ ኡራ ነ ግዶፈ ድጋ። <verse eid="DEU 19:19"/><verse number="20" style="v" sid="DEU 19:20"/>ሄሳዳ ኦኮ፥ ሀራ አሳይ ሄሳ ስእድ ያያና፤ ሄሳ መላ ኢታ ኦሶይ ዛሪድ ኦሰተና። <verse eid="DEU 19:20"/><verse number="21" style="v" sid="DEU 19:21"/>ሄሳ መላ ኢታ ኦሶ ኦዳይሳስ ቃቶፋ፤ ሸምፖ ግሾ ሸምፖ፤ አይፈ ግሾ አይፈ፤ አቻ ግሾ አቸ፤ ኩሸ ግሾ ኩሸ፤ ገዳ ግሾ ገዳ መን።<verse eid="DEU 19:21"/></para>
  <chapter eid="DEU 19"/>
  <chapter number="20" style="c" sid="DEU 20"/>
  <para style="s1">ኦላባ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 20:1"/>ነኒ ሞርከታራ ኦለታናዉ ብያ ዎደ፥ ኤንታ ፓራት፥ ፓራ ጋረትነ ኤንታ ኦላንቾት ኔፐ ዳርን በአዳ፥ ኤንታዉ ያዮፋ፤ ነና ግብፀፈ ከስዳ ጎዳይ፥ ነ ፆሳይ ኔራ ደኤስ። <verse eid="DEU 20:1"/><verse number="2" style="v" sid="DEU 20:2"/>ህንተ ኦላ ዶማናፐ ኮይሮ፥ ካህነይ ኦላንቾታ ስን አድ ሀይሳዳ ያጎ፤ <verse eid="DEU 20:2"/><verse number="3" style="v" sid="DEU 20:3"/>“እስራኤለ አሳዉ፥ ስእተ፤ ሀች ህንተ፥ ህንተ ሞርከታራ ኦለታናዉ ሀኔታ። ህዛ ህንተ ዎዛናይ ዳጋሞፎ፤ ያዮፍተ፤ ኤንታ ስንን ኮኮሮፕተ፤ ህርጎፍተ። <verse eid="DEU 20:3"/><verse number="4" style="v" sid="DEU 20:4"/>ጎዳይ፥ ህንተ ፆሳይ ህንተራ ብያ ግሾ፥ ህንተ ሞርከታ ኦልድ፥ ህንተዉ ፆኖ እማና” ያጎ።<verse eid="DEU 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 20:5"/>ቶራ ሞጮናት ኦላንቾታኮ፥ “ኦራ ኬ ኬፅድ ገልቦና አስ ደእኮ፥ እ ኦላን ሀይቅን፥ ሀራ አስ እያ ኬን ገሎና መላ እ ሶ ስሞ። <verse eid="DEU 20:5"/><verse number="6" style="v" sid="DEU 20:6"/>ዎይኮ ዎይነ ቶክድ፥ አይፈ ሞና አስ ደእኮ፥ እ ኦላን ሀይቅን፥ ሀራ አስ እያ ዎይነ አይፍያ ሞና መላ እ ሶ ስሞ። <verse eid="DEU 20:6"/><verse number="7" style="v" sid="DEU 20:7"/>ማቾ ኦይችድ ኤክቦና አስ ደእኮ፥ እ ኦላን ሀይቅን፥ ሀራ አስ እያ ማችዉ ኤኮና መላ እ ሶ ስሞ” ያጎ። <verse eid="DEU 20:7"/><verse number="8" style="v" sid="DEU 20:8"/>ቶራ ሞጮናት ጉጅድ ሀይሳዳ ያጎ፤ “ሀ አሳ ግዶን ያያነ ህርግያ ኦንካ ደእኮ፥ እ ባ ላገታ ዎዛና ያሻን ትልእሳናፐ ሶ ስሞ” ያጎ። <verse eid="DEU 20:8"/><verse number="9" style="v" sid="DEU 20:9"/>ቶራ ሞጮናት ሄሳ አሳስ ኦድ ዉርስያ ዎደ ጩጋስ ጩጋስ ቶራ ሞጮናታ ዶሮ።<verse eid="DEU 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 20:10"/>እስ ካታማ ኦላናዉ ባዳ ነ እያኮ ማትያ ዎደ፥ ኮይሮትድ ሳሮራ ኤንቲ ኩሸ እማና መላ ኦይቻ። <verse eid="DEU 20:10"/><verse number="11" style="v" sid="DEU 20:11"/>ኤንቲ ሳሮራ ባንታ ኩሽያ እምድ፥ ባንታ ግምበ ፐንግያ ዶይድ ነና ገልስኮ፥ ሄ ካታማን ደእያ አሳ ኡባይ ነዉ ዴፆ ኦሶ ኦድ ሀጋዞ። <verse eid="DEU 20:11"/><verse number="12" style="v" sid="DEU 20:12"/>ሄ ካታማ አሳይ ነዉ ሳሮራ ኩሸ እሞና እፅድ፥ ኦላስ ጊገትኮ፥ ነ ሄ ካታማ ዩሹዋ ተቃ። <verse eid="DEU 20:12"/><verse number="13" style="v" sid="DEU 20:13"/>ጎዳይ፥ ነ ፆሳይ ኤንታ ነዉ አድ እምያ ዎደ ሄ ካታማን ደእያ አደ ኡባ ማሻን ዉርሳ። <verse eid="DEU 20:13"/><verse number="14" style="v" sid="DEU 20:14"/>ግዶሽን፥ ማጫሳ፥ ናይታ፥ መህያነ ካታማን ደእያ ኡባባ ነዉ ድአ። ጎዳይ፥ ነ ፆሳይ ነዉ እምያ ነ ሞርከታ ሻሉዋ ጎኤታ። <verse eid="DEU 20:14"/><verse number="15" style="v" sid="DEU 20:15"/>ነ ደእያ በሳፈ ሃክድ ደእያ ካታማታ ነ ኦይክያ ዎደ ሄሳዳ ኦ።<verse eid="DEU 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 20:16"/>ሽን ጎዳይ፥ ነ ፆሳይ ነዉ ላታ ኦድ እምያ ቢታን ሸምፖራ ደእያባ እሱዋካ አሾና ዎ። <verse eid="DEU 20:16"/><verse number="17" style="v" sid="DEU 20:17"/>ጎዳይ፥ ነ ፆሳይ ኪትዳይሳዳ ህተታ፥ አሞረታ፥ ካናነታ፥ ፓርዘታ፥ ህወታነ ያቡሰታ ዉርሳዳ ዎ። <verse eid="DEU 20:17"/><verse number="18" style="v" sid="DEU 20:18"/>ሄስ ሀኖና እፅኮ፥ ኤንቲ ባንታ ፆሳታ ጎይንሸ ኦያ እፀትዳ ኦሶታ ህንተ ኦና መላ ህንተና ታማርስድ፥ ጎዳ ህንተ ፆሳ ቦላ ህንተ ናጋራ ኦና መላ ደንና።<verse eid="DEU 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 20:19"/>እስ ካታማ ኦይካናዉ ዩሹዋ ነ ተቃዳ፥ ዳሮ ጋላስ ኦለታሸ ጋምእያ ዎደ፥ እያን ደእያ አይፈ እምያ ም አይፍያ ማፐ አትሽን፥ ቃንፆፋ። ነ ዩሹዋ ተቅድ ኦለይ አሰፐ አትሽን፥ ደንባን ደእያ ም ግደና። <verse eid="DEU 20:19"/><verse number="20" style="v" sid="DEU 20:20"/>ግዶሽን፥ ነ አይፈ እሞና ሀራ ምታ ቃንፃዳ፥ ኔራ ኦለትያ ካታማይ ኩንዳና ጋካናዉ ያን ሚፃ ኬፃ።<verse eid="DEU 20:20"/></para>
  <chapter eid="DEU 20"/>
  <chapter number="21" style="c" sid="DEU 21"/>
  <para style="s1">ዎዳ ኡራይ ኤረቶና ሀይቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 21:1"/>ነ ላታና መላ ጎዳይ፥ ነ ፆሳይ ነዉ እምያ ቢታን፥ ኦን ዎዳኮ ኤረቶና አህ ኩንድድ በንትኮ፥ <verse eid="DEU 21:1"/><verse number="2" style="v" sid="DEU 21:2"/>ህንተ ዳይናትነ ጭማት ብድ፥ አሀይ ኩንድዳ በሳፈ ማታ ካታማታ ጋካናዉ ደእያ ሃሆተ ዋ። <verse eid="DEU 21:2"/><verse number="3" style="v" sid="DEU 21:3"/>ሄሳፈ ጉየ፥ አሀይ ኩንድዳ በሳስ ማትያ ካታማ ጭማት፥ ዋታቦናነ ሞርገን ቃምባር ዎቦና ኡስ ኤኮ። <verse eid="DEU 21:3"/><verse number="4" style="v" sid="DEU 21:4"/>እዮ ጎግያ ሃ ደእያ ጎየትድ ኤሮናነ ዘረትድ ኤሮና ዛንጋራ ኤፍድ፥ ሄ ኡሴ ቆያ ምርቅድ መን። <verse eid="DEU 21:4"/><verse number="5" style="v" sid="DEU 21:5"/>ሄሳ መላ ቆሁዋነ ኦሻ ሻክድ ፕርዳናዉ ጎዳይ፥ ህንተ ፆሳይ ባ ስንን ኦና መላነ ባ ሱንን አንጃና መላ ኤንታ ዶርዳ ግሾ፥ ሌወ ኮቸ ግድዳ ካህነት ሄ በሳ ቦ። <verse eid="DEU 21:5"/><verse number="6" style="v" sid="DEU 21:6"/>ሄሳፈ ጉየ፥ አሀይ ኩንድዳ በሳስ ማትያ ካታማ ጭማት ዛንጋራን ቆ ምርቅድ ዎዳ ኡሴ ቦላ ባንታ ኩሽያ ሜጨትድ፥ <verse eid="DEU 21:6"/><verse number="7" style="v" sid="DEU 21:7"/>“ኑ ኩሸይ ሀ ሱ ጉስቤና፤ ኑ አይፈይ ሄሳ በእቤና። <verse eid="DEU 21:7"/><verse number="8" style="v" sid="DEU 21:8"/>አቤት ጎዳዉ፥ ኔኒ ዎዝዳ ነ አሳ፥ እስራኤለ ማራ፤ ሀ ፅሎ ሱ ነ አሳ ቦላ ናቆ ኦዳ ታይቦፓ። ሀ ፅሎ ሱ ግሾ ኑ ናጋራይ አቶ ጋ” ያጎ። <verse eid="DEU 21:8"/><verse number="9" style="v" sid="DEU 21:9"/>ነኒ ጎዳ አይፍያ ስንን ሄሳዳ ኦዳ፥ ፅሎ ሱይ ጉክዳ ናጋራ ነ ግዶፈ ድጋ።<verse eid="DEU 21:9"/></para>
  <para style="s1">ኦላን ድኤትዳ ማጫሳታባ</para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 21:10"/>ነ ሞርከታራ ነ ኦለታናዉ ከይን፥ ጎዳይ፥ ነ ፆሳይ ኤንታ ነ ኩሸን አድ እምን፥ ኤንታ ድእያ ዎደ፥ <verse eid="DEU 21:10"/><verse number="11" style="v" sid="DEU 21:11"/>ድኤትዳ አሳ ግዶን እስ ማላ ሎኦ ማጫስ በአዳ፥ እዉ ምሸታዳ ማቻናዉ ኮይኮ፥ <verse eid="DEU 21:11"/><verse number="12" style="v" sid="DEU 21:12"/>እዮ ነ ሶ ኤሀ። እ ሁጵያ ሜዳ፤ እ ፁጉን ጭጋ፤ <verse eid="DEU 21:12"/><verse number="13" style="v" sid="DEU 21:13"/>ድኤትያ ዎደ ደእያ ማኡዋ ላማዳ፥ እስ አጌና ነ ሶን ኡታዳ፥ ባ አዋስነ ባ አየስ ካዮቶ። ሄሳፈ ጉየ፥ እዮ ማቻ። <verse eid="DEU 21:13"/><verse number="14" style="v" sid="DEU 21:14"/>ያታ ስማዳ፥ ኢራ ዱሳይ ነና ኡፋይሶና እፅኮ፥ እያ ባ ኮይዳ ሶ ባና መላ እዮ የዳ። ኔኒ እዮ ማቾ ኦዳ ኢራ እስፈ አቅዳ ግሾ፥ እዮ ሚሸን ባይዛናዉ ዎይኮ አይለ ኦናዉ በሰና።<verse eid="DEU 21:14"/></para>
  <para style="s1">ባይራ ናአ ላታ ማታ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 21:15"/>እስ አሳስ እ ዶስያነ ዶሶና ናምኡ ማቸት ደእኮ፥ ሄ ናምአይካ እያዉ አደ ናአ የልኮ፥ ባይራይ እ ዶሶና ማቸፔ የለትዳባ ግድኮ፥ <verse eid="DEU 21:15"/><verse number="16" style="v" sid="DEU 21:16"/>እ ባ ናይታ ባ ሻሉዋ ላትስያ ዎደ፥ እ ዶሶናርፐ የለትዳ ባይራይ ደእሽን፥ እ ዶስያርፐ የለትዳ ካሉዋ ባይራያናዉ በሰና። <verse eid="DEU 21:16"/><verse number="17" style="v" sid="DEU 21:17"/>ሀራ ናይታስ እመይሳፈ እያዉ ናምኡ ኩሸ አድ እምድ እ ዶሶናር ናአይ ባይራ ግደይሳ ኤርሳናዉ በሴስ። ሄ ናአይ እያዉ ኩሸ ቶሆ ጳልቅዳ ባይራ ግድያ ግሾ፥ ባይራተ እ ኤካናዉ በሴስ።<verse eid="DEU 21:17"/></para>
  <para style="s1">ዱማ ዱማ ህገታ</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 21:18"/>አዋስነ አየስ ኪተቶና እፅዳ፥ ኤንቲ ሴርንካ ስሞና፥ ዎዛና ሙመነ ማካላንቾ ግድዳ ናእ ደእኮ፥ <verse eid="DEU 21:18"/><verse number="19" style="v" sid="DEU 21:19"/>አዋይነ አይያ ሄ ካታማ ፐንገን ደእያ ጭማታኮ እያ ኤሆ። <verse eid="DEU 21:19"/><verse number="20" style="v" sid="DEU 21:20"/>ኤንቲ ጭማታኮ፥ “ሀይስ ኑ ናአይ ዎዛና ሙመነ ማካላንቾ፤ እ ኑስ ኪተተና፤ እ ያራምባነ ኡሻንቾ” ያግድ ኦዶ። <verse eid="DEU 21:20"/><verse number="21" style="v" sid="DEU 21:21"/>ሄሳፈ ጉየ፥ ሄ ካታማን ደእያ አደ ኡባይ እያ ሹቻን ጫድድ ዎ። ሄሳዳ ኦድ ህንተ ግዶፈ ኢታ ኡራ ይስተ፤ እስራኤለ ኡባይ ሄሳ ስእድ ያያና።<verse eid="DEU 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 21:22"/>እስ አስ ሀይቆ ፕርድስያ ባላ ኦኮ፥ ነ እያ ም ቦላ ካቃዳ ዎኮ፥ <verse eid="DEU 21:22"/><verse number="23" style="v" sid="DEU 21:23"/>ሄ ም ቦላ እያ አሀይ አቆፖ፤ እያ ሄ ጋላስ ሞጋ። ም ቦላ ካቀትድ ሀይቅያ ኦንካ ፆሳን ባደትዳይሳ። ጎዳይ፥ ነ ፆሳይ ነዉ ላታ ኦድ እምያ ነ ቢታ ቱንሶፓ።<verse eid="DEU 21:23"/></para>
  <chapter eid="DEU 21"/>
  <chapter number="22" style="c" sid="DEU 22"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 22:1"/>እስራኤለ አሳ ቦር ዎይኮ ዶርስ ይድ ብሽን ደምኮ አጋ አፋ፤ ላጋ ኤሀዳ እያ ጎዳስ እማ። <verse eid="DEU 22:1"/><verse number="2" style="v" sid="DEU 22:2"/>ሄ መህያ ጎዳይ ነ ሄራ አስ ግዶና እፅኮ ዎይኮ እያ ጎዳይ ኦነኮ ነ ኤሮና እፅኮ፥ እያ ጎዳይ ኮይሸ ያና ጋካናዉ ነ ሶ ኤፋ፤ እ ኮይሸ ዪኮ እያዉ እማ። <verse eid="DEU 22:2"/><verse number="3" style="v" sid="DEU 22:3"/>ሄሳዳ ሀረ ዎይኮ ማኦ ዎይኮ አይባካ ይዳባ ደምኮ፥ ሄሳዳ ኦ።<verse eid="DEU 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 22:4"/>እስራኤለ አሳ ሀረይ ዎይኮ ቦር ኦገን ኩንድን በእኮ፥ ማዳዳ ደንፈ አትሽን፥ አጋዳ አፋ።<verse eid="DEU 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 22:5"/>ማጫስ አደ ማኦ ማኦፎ፤ አደይካ ማጫሳ ማኦ ማኦፎ። ሄሳ መላባ ኦያ ኦናካ ጎዳይ፥ ህንተ ፆሳይ እፄስ።<verse eid="DEU 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 22:6"/>ነ ኦገ ብሽን፥ ም ቦላ ግድን፥ ሳአን ባ ናኣ ዎይኮ ባ ጱጱልያ ሀጵዳ ካፎ ደምኮ፥ እዮ፥ እ ናይታራ ኦይካዳ ነ ሶ ኤፎፓ። <verse eid="DEU 22:6"/><verse number="7" style="v" sid="DEU 22:7"/>ናይታ ኤፋናዉ ዳንዳኣሳ፤ ሽን አይዉ ባና መላ የዳ አጋ። ሄሳዳ ኦኮ፥ ኔኒ ዱረታዳ አዱሳ ላይ ዳና።<verse eid="DEU 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 22:8"/>ኦራ ኬ ኬፅያ ዎደ ካራፐ አስ ኩንድ ሀይቅን ነ ኦይሸቶና መላ ኬ ቦላ ካተ ጊግሳ።<verse eid="DEU 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 22:9"/>ነ ዎይነ ጋደን ናምኡ ቆሞ ካ ዘሮፓ፤ ሄሳዳ ኦኮ፥ ነ ዘርዳ ካይነ ዎይነይ ናምአይካ ኢታና።<verse eid="DEU 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 22:10"/>ቦርነ ሀረ እስፈ ዋፃዳ ጎዮፓ።<verse eid="DEU 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 22:11"/>ሱፈፐነ ሊኖፐ ኦሰትዳ ማኦ ማኦፋ።<verse eid="DEU 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 22:12"/>ነ ማእያ ማኦይ ኦይዱ ባጋራ ማጫር ደእያባ ግዶ።<verse eid="DEU 22:12"/></para>
  <para style="s1">ኤኮ ገሎ ጌሻተ</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 22:13"/>እስ አስ ማቾ ኤክ ስሚድ እዮ ዶሶና እፅድ፥ <verse eid="DEU 22:13"/><verse number="14" style="v" sid="DEU 22:14"/>“ሀ ማችው ታ ኤክያ ዎደ ኩመ ግዱኩ” ያግድ እዮ ኢስድ ኦደትኮ፥ <verse eid="DEU 22:14"/><verse number="15" style="v" sid="DEU 22:15"/>ናኤ አዋይነ ናኤ አይያ እ ጌላኦተ ማላ ኤፍድ፥ ካታማ ፐንገን ደእያ ጭማታ በሶ። <verse eid="DEU 22:15"/><verse number="16" style="v" sid="DEU 22:16"/>ናኤ አዋይ ጭማታስ ሀይሳዳ ያግድ ኦዶ፤ “ታኒ ታ ናእዉ ሀ ኡራስ ማቾ ኦዳ እማስ፥ ሽን እዮ እፅስ። <verse eid="DEU 22:16"/><verse number="17" style="v" sid="DEU 22:17"/>እ፥ ‘ነ ናእያ ኩመ ግዱኩ’ ያግድ እዮ ኢስድ ኦድስ። ግዶሽን፥ ‘ታ ናኤ ጌላኦተ ማላ ሀይሳ በእተ’ ” ያግድ፥ እ ጌላኦተ ኤርስያ ጫርቅያ በሶ። <verse eid="DEU 22:17"/><verse number="18" style="v" sid="DEU 22:18"/>ያትኮ፥ ሄ ካታማ ጭማት እያ ጋራፎ። <verse eid="DEU 22:18"/><verse number="19" style="v" sid="DEU 22:19"/>እ እስራኤለ ጌላኤ ሱን ኢስዳ ግሾ፥ ጭማት እያ ፄቱ ብራ ሳንትመ<note caller="+" style="f"><char style="fr" closed="false">22:19 </char><char style="fk" closed="false">ፄቱ ብራ ሳንትመ፦ </char><char style="ft" closed="false">እስ ክሎነ ባጋ ግራመ ዴፅያ ብራ ሳንትመ</char></note> አጭስድ፥ ናኤ አዋስ እሞ። ናእያ እያዉ ማቾ ግዳዳ ደኦ፤ ባ ደኦ ላይ ኡባን እዮ የዳናዉ በሰና።<verse eid="DEU 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 22:20"/>እያ ሞቶይ ቱማ ግድድ፥ ናእያ ኩመ ግዶና እፅኮ፥ <verse eid="DEU 22:20"/><verse number="21" style="v" sid="DEU 22:21"/>እያ ባ አዋ ሶን ደአሸ ላይማትዳ ግሾ፥ ናእዉ እ አዋ ካረ ኤህድ፥ ሄ ካታማ አደት እዮ ሹቻን ጫድድ ዎ። እስራኤለ ግዶን እያ ቦርሶባ ኦሱ፤ ሄሳዳ ኦዳ ነ ግዶፈ ኢታ ድጋ።<verse eid="DEU 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 22:22"/>እስ አስ ሀራ አሳ ማችራ ላይማትሸ ኦይከትኮ፥ እነ እያራ ላይማትዳ ማጫስያ ሀይቆ። ሄሳዳ ኦዳ ነ ግዶፈ ኢታ ድጋ።<verse eid="DEU 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 22:23"/>እስ አስ ሀራ አሳስ ኦይሸታ ጊግዳ ጌላእዉ ካታማ ግዶን ደምድ ኢራ ላይማትኮ፥ <verse eid="DEU 22:23"/><verse number="24" style="v" sid="DEU 22:24"/>ኤንታ ናምኣ ካታማፐ ጋፃ ከስድ፥ ሹቻን ጫድድ ዎተ። ናእያ ሀይቀይ፥ ካታማ ግዶን ደአሸ፥ አስ አሻና መላ ዋሳቦና ግሾሳ። ናአይ ሀይቀይ፥ ሀራ አሳስ ጊግዳ ጌላእዉ ኢስዳ ግሾሳ። ሄሳዳ ኦዳ ነ ግዶፈ ኢታ ድጋ።<verse eid="DEU 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 22:25"/>እስ አስ አሳስ ጊግዳ ጌላእዉ አስ ባይና በሳን ዎልቃን ኦይክድ፥ እዮ ኢስኮ፥ እያ ፃላል ሀይቆ። <verse eid="DEU 22:25"/><verse number="26" style="v" sid="DEU 22:26"/>እያ ሀይቆስ ጋያ ናጋራ ኦቦና ግሾ፥ ናኤ ቦላ አይባካ ኦፕተ። ሄስ እስ አስ ጮ ደንድድ ሀራ አስ ዎይሳ መላ። <verse eid="DEU 22:26"/><verse number="27" style="v" sid="DEU 22:27"/>እ እዮ አስ ባይና በሳን ደምድ ኦይክን፥ ሄ ጌላእያ ዋሳሱ፥ ሽን እዮ አሽያ አስ በንትቤና።<verse eid="DEU 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 22:28"/>እስ አስ ኦይሸታቦና ጌላእዉ ኦይክድ፥ እ ጌላኦተ ኤክድ ኦይከተኮ፥ <verse eid="DEU 22:28"/><verse number="29" style="v" sid="DEU 22:29"/>ናኤ አዋ እሻታሙ ብራ ሳንትመ<note caller="+" style="f"><char style="fr" closed="false">22:29 </char><char style="fk" closed="false">እሻታሙ ብራ ሳንትመ </char><char style="ft" closed="false">ኡሱፑን ፄቱ ግራመ ዴፅያ ብራ ሳንትመ።</char></note> አጮ። ያትድ ናእዉ ባዉ ማቾ ኦ። ባ ደኦ ላይ ኡባን እዮ የዶፎ።<verse eid="DEU 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 22:30"/>እስ አስ ባ አዋ ማችዉ ኤክድ፥ ባ አዋ ካዉሾፎ።<verse eid="DEU 22:30"/></para>
  <chapter eid="DEU 22"/>
  <chapter number="23" style="c" sid="DEU 23"/>
  <para style="s1">ፆሳ ሺቆፐ ድግያ ጋሶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 23:1"/>ሳንጋትዳ ዎይኮ ቃራተትዳ አደይ ጎዳ ሺቁዋ ገሎፖ።<verse eid="DEU 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 23:2"/>ላይማተን የለትዳ አስ ጎዳ ሺቁዋ ገሎፖ። ሀር አቶሽን ታማን የለተ ጋካናዉ፥ እያ ኮቻፈ ኦንካ ጎዳ ሺቁዋ ገሎፖ። <verse eid="DEU 23:2"/><verse number="3" style="v" sid="DEU 23:3"/>አሞነ አስ ግድን ዎይኮ ሞአበ አስ ግድን፥ ጎዳ አሳ ሺቁዋ ገሎፖ። ሀር አቶሽን ታማን የለተ ጋካናዉ ኤንታ አሰ ግድዳ ኦንካ ጎዳ አሳ ሺቁዋ ገሎፖ። <verse eid="DEU 23:3"/><verse number="4" style="v" sid="DEU 23:4"/>ኔኒ ግብፀፈ ከያዳ ብሽን፥ ኤንቲ ካራነ ሃራ ነና ሞክቦኮና። ኤንቲ ማሰጰፆመን ፓቶራ ካታማን ደእያ ብኦራ ናኣ ባላም ነና ባዳና መላ ሻምዶሶና። <verse eid="DEU 23:4"/><verse number="5" style="v" sid="DEU 23:5"/>ጎዳይ፥ ነ ፆሳይ ነና ዶስዳ ግሾ ባላማ ስእቤና፤ እያ ባደ ነዉ አንጆን ላምስ። <verse eid="DEU 23:5"/><verse number="6" style="v" sid="DEU 23:6"/>ነ ደኦ ላይ ኡባን ኤንቲ ሳሮ ዳና መላነ ዱረታና መላ አሞቶፋ። <verse eid="DEU 23:6"/><verse number="7" style="v" sid="DEU 23:7"/>ኤዶመት ነዉ ዳቦ ግድያ ግሾ ኤንታ ካፓ፤ ነ ኤንታ ቢታን በተ አስ ግዳዳ ደእዳ ግሾ ግብፀታ ካፓ። <verse eid="DEU 23:7"/><verse number="8" style="v" sid="DEU 23:8"/>ኤንታ ሄን የለተይ ጎዳ ሺቁዋ ገላናዉ ዳንዳኦሶና።<verse eid="DEU 23:8"/></para>
  <para style="s1">ጉታ ቱናተፈ ናጎ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 23:9"/>ነ ሞርከታ ኦላናዉ ከያዳ ዱንካንዳ በሳን ነና ቱናተፈ ናጋ። <verse eid="DEU 23:9"/><verse number="10" style="v" sid="DEU 23:10"/>ቃማ አሙሆን አቱንይ ጉክን፥ እርፃባይ እያ ቦላ ደእያ ኦንካ ጉታፐ ጋፃ ከይድ ያን ጋምኦ። <verse eid="DEU 23:10"/><verse number="11" style="v" sid="DEU 23:11"/>ሳእ ኦማርስያ ዎደ ባ አሳተ ሜጨትድ፥ አው ዉልያ ዎደ ጉታ ስሞ።<verse eid="DEU 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 23:12"/>ነ ዎራ ሼሽ ኡትያ በሲ ጉታፐ ካረን ጊግሳ። <verse eid="DEU 23:12"/><verse number="13" style="v" sid="DEU 23:13"/>ሼሻስ ኡትያ ኦላ ቦክያ ሚሸ ኦላ ሚሸራ ጋዳ ኦይካ፤ ሼሻስ ኡታ ስማዳ ኦላን ቢታ ዛራ። <verse eid="DEU 23:13"/><verse number="14" style="v" sid="DEU 23:14"/>ጎዳይ፥ ነ ፆሳይ ነና ናጋናዉነ ነ ሞርከታ ነ ኩሸን አድ እማናዉ፥ ነ ጉታን ስመረቴስ። እ ያን ሻትያባ በእድ፥ ነና አግድ ስሞና መላ ነ ጉታይ ጌሽ ግዳናዉ ኮሼስ።<verse eid="DEU 23:14"/></para>
  <para style="s1">ዱማ ዱማ ህገታ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 23:15"/>ባ ጎዳፐ ባቃትድ፥ ኔኮ ይዳ አይልያ ዛራዳ እያ ጎዳስ እሞፋ። <verse eid="DEU 23:15"/><verse number="16" style="v" sid="DEU 23:16"/>እ ነ ካታማታፐ እሱዋን፥ ባ ኮይዳ በሳን ባ ኮይዳ ዎደ ጋካናዉ ደኦ፤ እያ ኡንኤፋ።<verse eid="DEU 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 23:17"/>እስራኤለ አሳፐ ኦንካ አደ ግድን ዎይኮ ማጫ ግድን፥ ኤቃ ጎይንያ አሳይ ኦይሳዳ ላይማቶፖ። <verse eid="DEU 23:17"/><verse number="18" style="v" sid="DEU 23:18"/>አደ ግድን ዎይኮ ማጫስ ግድን፥ ላይማተን ደምዳ ሚሸ ቃንገ ጋናዉ ጎዳ ነ ፆሳ ኬ ኤሆፖ። ኤንታ ናምኣ ጎዳይ ነ ፆሳይ እፄስ።<verse eid="DEU 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 23:19"/>ህንተ ኮቸ ግድዳ እስራኤለ አሳስ ሚሸ ዎይኮ ካ ዎይኮ ሀራባ ታልአዳ የሎ ኤኮፋ። <verse eid="DEU 23:19"/><verse number="20" style="v" sid="DEU 23:20"/>ሀራ ቢታ አሳፐ የሎ ኤካናዉ ዳንዳኣሳ፤ ሽን ኔኒ ላታናዉ ገልያ ቢታን ነ ኦያባ ጎዳይ፥ ነ ፆሳይ አንጃና መላ ነ ኮቸ ግድዳ እስራኤለ አሳስ የሎራ ታልኦፋ።<verse eid="DEU 23:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 23:21"/>ጎዳስ፥ ነ ፆሳስ፥ እማናዉ ቃንገትዳባ ጋናዉ ጋምኦፋ። ጎዳይ ነ ፆሳይ ነ ቃንግዳይሳ ኩመ ኔፐ ኮይያ ግሾ፥ ፖሎና እፅኮ ነዉ ናጋራ ግዳና። <verse eid="DEU 23:21"/><verse number="22" style="v" sid="DEU 23:22"/>ሽን ነ ቃንጎና አግኮ ሄስ ናጋራ ግደና። <verse eid="DEU 23:22"/><verse number="23" style="v" sid="DEU 23:23"/>ጎዳስ ነ ፆሳስ፥ እማና ግዳ ነ ዶናን ኦደትዳባ ኔኒ ዶሳን እማና ግዳ ግሾ፥ ነ እንፃርሳን ኦደትዳባ ፖላ።<verse eid="DEU 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 23:24"/>ኔኒ እስ አሳ ዎይነ ጋደ ግዶራ አያ ዎደ ዎይንያፐ ኮይዳ መላ ማ፥ ሽን እያፐ አይባካ ነ ኦይክዳ ሚሸን የጎፋ። <verse eid="DEU 23:24"/><verse number="25" style="v" sid="DEU 23:25"/>እስ አሳ ጋደራ ኔኒ አያ ዎደ ሄ ጋድያን ደእያ ትያፐ ዱዳ ማ፤ ሽን ካፈ ጫካዳ ነ ሶ ኤፎፓ።<verse eid="DEU 23:25"/></para>
  <chapter eid="DEU 23"/>
  <chapter number="24" style="c" sid="DEU 24"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 24:1"/>እስ አስ ማቾ ኤክ ስሚድ፥ እስ ኢታባ እ ቦላ ደምድ እዮ እፅድ፥ ፕርማ ዳክድ፥ የድኮ፥ <verse eid="DEU 24:1"/><verse number="2" style="v" sid="DEU 24:2"/>እያ ሶፐ ከያዳ፥ ሀራ አዝና ገልኮ፥ <verse eid="DEU 24:2"/><verse number="3" style="v" sid="DEU 24:3"/>ሄ ናምአን አዝናይ እዮ ዶሶና እፅድ፥ ፕርማ ዳክድ፥ እዮ ባ ሶፐ ከስድ የድኮ፥ ዎይኮ እዮ ኤክዳ ናምአን አዝናይ ሀይቅኮ፥ <verse eid="DEU 24:3"/><verse number="4" style="v" sid="DEU 24:4"/>እያ ቱንዳ ግሾ፥ ኮይሮ ኤክዳ አዝናይ፥ ዛሪድ እዮ ኤኮፎ። ሄስ ጎዳ ስንን እፀትዳባ፤ ነ ጎዳይ፥ ነ ፆሳይ ነ እምያ ቢታን ሄሳ መላ ናጋራ ኦፋ።<verse eid="DEU 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 24:5"/>ኦራ ማቾ ኤክዳ አስ ኦላስ ቦፖ፤ ሀራ ዴፆ ኦሶ ኦፎ። እስ ላይ አና ጋካናዉ አዉካ ቦና ባ ማችዉ ኡፋይሶ።<verse eid="DEU 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 24:6"/>እስ አሳ ዎፃ ዎይኮ ማይደ አጮስ ኦይኮፋ፤ ሄስ ኬ አሳይ ምያባ ይድ ሀይቆ ጉሱ።<verse eid="DEU 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 24:7"/>እስ እስራኤለ ግድዳ ባ እሻ ካይሶት ኤፍድ፥ አይለ ከሰይ ዎይኮ ሀራስ ባይዝያ ኡራይ ሀይቆ። ሄሳዳ ኦዳ ኢታ ኡራ ነ ግዶፈ ድጋ።<verse eid="DEU 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 24:8"/>ጎጋ ሀርገፈ ነና ምንዳ ናጋ፤ ሌወ ኮቸ ግድዳ ካህነት ነና ታማርስያ ኡባ ፖላ፤ ታ ኤንታዉ እምዳ ኪታ ናጋ። <verse eid="DEU 24:8"/><verse number="9" style="v" sid="DEU 24:9"/>ኔኒ ግብፀፈ ከያዳ ኦገን ደእሽን፥ ጎዳይ ነ ፆሳይ ማይራም ቦላ ኦዳይሳ አኬካ።<verse eid="DEU 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 24:10"/>እስ አሳስ እስባ ታልአዳ፥ ኦይያባ ኦይቻናዉ እያ ሶ ገሎፓ። <verse eid="DEU 24:10"/><verse number="11" style="v" sid="DEU 24:11"/>ኔኒ ካረን ኤቅዳሽን፥ ነ ታልእዳ ኡራይ ኦያባ ሶፐ ከስድ ነዉ እሞ። <verse eid="DEU 24:11"/><verse number="12" style="v" sid="DEU 24:12"/>እ ማንቆ ግድኮ፥ ኔኒ አጮስ ኦይክዳ እያ ማኡዋ ነ ሶን አይሶፓ። <verse eid="DEU 24:12"/><verse number="13" style="v" sid="DEU 24:13"/>እ ማእድ አቃና መላ ሳእ ኦማርስያ ዎደ እያዉ ጉየ ዛራ፤ እ ነና ጋላታና። ሄስ ጎዳ ነ ፆሳ ስንን ነዉ ፅሎተ ኦሶ ግድድ ታይበታና።<verse eid="DEU 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 24:14"/>ማንቆነ ማደ ኮይድ ዶካለትዳ፥ እስራኤለ ግድዳ ነ እሻ ግድን ዎይኮ ነ ካታማታፐ እሱዋን ደእያ ሀራ ቢታ አስ ናቆፋ። <verse eid="DEU 24:14"/><verse number="15" style="v" sid="DEU 24:15"/>እ ሀች ኦዳይሳ ሀች ኤካናዉ ምንድ ኮይያ ግሾ፥ አው ዉሎና እያዉ ቃንፃ። ሄስ ሀኖና እፅኮ፥ ማንቆይ ጎዳኮ ዋስን ሄስ ነዉ ናጋራ ግዳና።<verse eid="DEU 24:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 24:16"/>ናይት ኦዳ ናጋራ ግሾ፥ አዋታ ዎናዉ በሰና፤ ቃስ አዋት ኦዳ ናጋራ ግሾ ናይታ ዎናዉ በሰና። ኦንካ ባ ኦዳ ናጋራን ናጋራን ሀይቃናዉ በሴስ።<verse eid="DEU 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 24:17"/>ሀራ ቢታ አሳ ፕርዳነ ይኦ ናይታ ፕርዳ ዎቢሶፓ፤ አምኤ ማኡዋ አጮ ግሾ ኦይኮፋ። <verse eid="DEU 24:17"/><verse number="18" style="v" sid="DEU 24:18"/>ኔኒ ግብፀ ቢታን አይለ ግድዳይሳነ ጎዳይ ነ ፆሳይ ነና ያፐ ዎዝድ ከስዳይሳ አኬካ። ታኒ ነና ኪተይ ሄሳ ግሾሳ።<verse eid="DEU 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 24:19"/>ኔኒ ካ ጫክያ ዎደ ነ ዶግዳ ምርቅያ ኤካናዉ ጉየ ስሞፋ። ጎዳይ፥ ነ ፆሳይ ነ ኩሸ ኦሶ ኡባን ነና አንጃና መላ ሄሳ በተ አሳስ፥ ይኦ ናይታስነ አምኤታስ አጋጋ። <verse eid="DEU 24:19"/><verse number="20" style="v" sid="DEU 24:20"/>ኔኒ ሻማሆ አይፈ ማፅያ ዎደ ዉርሳዳ ማፃናዉ ናምአን ጉየ ስሞፋ። አትዳይሳ በተ አሳስ፥ ይኦ ናይታስነ አምኤታስ አጋጋ። <verse eid="DEU 24:20"/><verse number="21" style="v" sid="DEU 24:21"/>ኔኒ ዎይነ አይፈ ማፅያ ዎደ ዉርሳዳ ማፃናዉ ናምአን ጉየ ስሞፋ። አትዳይሳ በተ አሳስ፥ ይኦ ናይታስነ አምኤታስ አጋጋ። <verse eid="DEU 24:21"/><verse number="22" style="v" sid="DEU 24:22"/>ኔኒ ግብፀ ቢታን አይለ ግዳዳ ደእዳይሳ ዶጎፓ። ታኒ ነና ኪተይ ሄሳ ግሾሳ።<verse eid="DEU 24:22"/></para>
  <chapter eid="DEU 24"/>
  <chapter number="25" style="c" sid="DEU 25"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 25:1"/>ናምኡ አሳት ኦየትድ ፕርዳ ኬ ቢኮ፥ ዳይናት ፅሉዋ ነ ልከ ግድ፥ ናቅዳይሳ ነ ባላ ግድ ፕርዶ። <verse eid="DEU 25:1"/><verse number="2" style="v" sid="DEU 25:2"/>ባልዳይሳ ጋራፎ በሲያባ ግድኮ፥ እያ ትራራ ዝንእስድ ዞኮን ሾጫና መላ ዳይናይ ኪቶ። እ ጋራፈተይ ዳይና ስንንነ እ ኦዳ ባላ መላ ግዶ። <verse eid="DEU 25:2"/><verse number="3" style="v" sid="DEU 25:3"/>እ ኦይታሙ ጋካናዉ ጋራፈታናዉ ዳንዳኤስ፥ ሽን ሄሳፈ ዳሮፖ። ሄሳፈ ዳርኮ ነ እሻይ ነ ስንን ካዉያና።<verse eid="DEU 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 25:4"/>ዉዱማን ካ የያ ቦራ ዶና ቃቾፋ።<verse eid="DEU 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 25:5"/>እስፈ ደእያ እሻታፐ እሶይ ናአ የሎና ሀይቅኮ፥ እያ ማችያ ሀራ አስ ገሎፖ። እ አዝና እሻይ እዮ ኤክድ፥ እዉ ኮሽያባ ኩን። <verse eid="DEU 25:5"/><verse number="6" style="v" sid="DEU 25:6"/>ሀይቅዳ እሻ ሱንይ እስራኤለ አሳ ግዶፈ ቁሸትድ ዮና መላ እያ፥ ኮይሮ የልያ አደ ናአይ ሀይቅዳ እሻ ሱንን ፄገቶ።<verse eid="DEU 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 25:7"/>ግዶሽን፥ እ ባ እሻ ማችዉ ኤካናዉ ኮዮና እፅኮ፥ ማጫስያ ካታማ ፐንገን ደእያ ጭማታኮ ባዳ፥ “ታ አዝና እሻይ ባ እሻ ሱንይ እስራኤለን ዳና መላ ኮይቤና፤ ታና ኤክድ፥ ታዉ ኮሽያባ ኩንና እፅስ” ያጋዳ ኦዶ። <verse eid="DEU 25:7"/><verse number="8" style="v" sid="DEU 25:8"/>ካታማ ጭማት እያ ፄግድ ኦይችን፥ እ ሀእካ፥ “ታኒ እዮ ኤክከ” ጊኮ፥ <verse eid="DEU 25:8"/><verse number="9" style="v" sid="DEU 25:9"/>ማጫስያ ጭማታ ስንን እያኮ ሺቃዳ፥ እያ ጫማፈ እሱዋ ከሳዳ፥ እያ ሶምኦን ጩታዳ፥ “ባ እሻስ ዘረ ዳና መላ ኮዮና አሳ ቦላ ሀይሳ መላ ካዉሽ ጋካናዉ በሴስ” ያጎ። <verse eid="DEU 25:9"/><verse number="10" style="v" sid="DEU 25:10"/>ያትን፥ ሄ ኡራ ሶ አሳይ እስራኤለ ኮቻ ግዶን፥ “ጫማ ከስዳ አሳ ሶ” ጌተትድ ፄገትሸ ዳና።<verse eid="DEU 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 25:11"/>ናምኡ አሳት ዋትሽን፥ እሱዋ ማችያ ያዳ፥ ባ አዝና ሾጨይሳ ኩሸፐ አሻናዉ፥ ባ ኩሽያ የዳዳ ሀንኩዋ አደተ ኦይክኮ፥ <verse eid="DEU 25:11"/><verse number="12" style="v" sid="DEU 25:12"/>እ ኩሸይ ቃይ ባይና ቃንፀቶ።<verse eid="DEU 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 25:13"/>ግታነ ጉ ግድዳ ናምኡ ምዛነ ኦይኮፋ። <verse eid="DEU 25:13"/><verse number="14" style="v" sid="DEU 25:14"/>ዳሮነ ጉ ማክያ ናምኡ ማካ ሚሸይ ነዉ ዶፖ። <verse eid="DEU 25:14"/><verse number="15" style="v" sid="DEU 25:15"/>ጎዳይ፥ ነ ፆሳይ ነዉ እምያ ቢታን አዱሳ ላይ ነ ዳና መላ ልከ ምዛነይነ ማካ ሚሸይ ነዉ ደኦ። <verse eid="DEU 25:15"/><verse number="16" style="v" sid="DEU 25:16"/>ጎዳይ ነ ፆሳይ ሄሳ መላባ ኦድ፥ ባለያ ኦናካ እፄስ።<verse eid="DEU 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 25:17"/>ነ ግብፀፈ ከያዳ ኦገ ቦላ ደእሽን፥ አማለቃት ነ ቦላ ኦዳባ አኬካ። <verse eid="DEU 25:17"/><verse number="18" style="v" sid="DEU 25:18"/>ኤንቲ ፆሰ ያዮና ደረ፤ ነ ኦግያን ኤንቲ ኔራ ኤቀትዶሶና። ነ ብሽን፥ ዳቡርድ ጉየ አትዳ አሳ ኡባ ዎዶሶና። <verse eid="DEU 25:18"/><verse number="19" style="v" sid="DEU 25:19"/>ሄሳ ግሾ፥ ጎዳይ ነ ፆሳይ ነና ሄ ቢታ ላትስድ፥ ነ ዩሹዋን ደእያ ሞርከታፐ ነና ሸምፕስያ ዎደ ሀ ቢታን ኤንታ ሀሳይያ አስ ያና ጋካናዉ አማለቃታ ኡባ ይሳ፤ ሄሳ ኦናይሳ ዶጎፓ።<verse eid="DEU 25:19"/></para>
  <chapter eid="DEU 25"/>
  <chapter number="26" style="c" sid="DEU 26"/>
  <para style="s1">ባይራ ካ ያርሾነ አስራታ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 26:1"/>ጎዳይ፥ ነ ፆሳይ ነና ላትስያ ቢታ ገላዳ፥ ዎፑ ጋዳ ዱስ ኦይክያ ዎደ፥ <verse eid="DEU 26:1"/><verse number="2" style="v" sid="DEU 26:2"/>ጎዳይ፥ ነ ፆሳይ ነዉ እምያ ቢታን ሞክዳ ካ ኡባፈ ባይራ፥ ጎዳይ ነ ፆሳይ ባ ሱንይ ፄገታና መላ ዶርዳ በሳ ኤካዳ ባ። <verse eid="DEU 26:2"/><verse number="3" style="v" sid="DEU 26:3"/>ሄ ዎደ አዋትያ ካህንያኮ ባዳ፥ “ጎዳይ ታዉ እማና ግድ ካሰ ኑ ማይዛታስ ጫቅዳ በሳ ኑና ገልስዳ ጎዳስ፥ ኑ ፆሳስ፥ ሀች ማርካታይስ” ያግተ። <verse eid="DEU 26:3"/><verse number="4" style="v" sid="DEU 26:4"/>ካህነይ ካ ነ ኩሸፐ ኤክድ፥ ጎዳ ነ ፆሳ ያርሾ በሳ ስንን ዎ። <verse eid="DEU 26:4"/><verse number="5" style="v" sid="DEU 26:5"/>ሄሳፈ ጉየ፥ ጎዳ ነ ፆሳ ስንን ሀይሳዳ ያጋ፤ “ታ ማይዛይ በሳፈ በሰ ዩይሸ ደእዳ ሶረ ቢታ አስ፤ እ ታይቦን ጉ አሳታራ ግብፀ ዎድ ያን ደእስ። እ ያን ደእሸ ግታ፥ ዎልቃማነ ታይቦን ዳሮ ደረ ግድስ። <verse eid="DEU 26:5"/><verse number="6" style="v" sid="DEU 26:6"/>ሽን ግብፀት ኑኒ አይለ ግድድ ኦና መላ ኡንኤዶሶና፤ ካዉሽዶሶና። <verse eid="DEU 26:6"/><verse number="7" style="v" sid="DEU 26:7"/>ያትን፥ ኑኒ ጎዳኮ፥ ኑ አዋታ ፆሳኮ ዋስዳ። ጎዳይ ኑ ዋሱዋ ስእስ፤ ኑ ዋይያ፥ ኑ ዳቡራነ ኑ ኡንኤተ በእስ። <verse eid="DEU 26:7"/><verse number="8" style="v" sid="DEU 26:8"/>ጎዳይ ባ ዎልቃማ ኩሽያን፥ ባ ምጨትዳ ቀስያን፥ ግታ ዳጋማን፥ ማላታንነ ማላልስያባታን ኑና ግብፀፈ ከስስ። <verse eid="DEU 26:8"/><verse number="9" style="v" sid="DEU 26:9"/>ሀ በሳ ኑና ኤህድ፥ ማነ ኤስ ጎግያ ሀ ቢታ ኑስ እሚስ። <verse eid="DEU 26:9"/><verse number="10" style="v" sid="DEU 26:10"/>ሄኮ፥ ጎዳይ ኑስ እምዳ ቢታ አይፍያፐ ባይራ ኤሀስ” ያጋዳ፥ ካ ጎዳ ነ ፆሳ ስንን ዎዳ፥ እያ ስንን ጉፋና። <verse eid="DEU 26:10"/><verse number="11" style="v" sid="DEU 26:11"/>ነዉነ ነ ሶ አሳስ ጎዳይ፥ ነ ፆሳይ እምዳ ሎኦባ ኡባን ኡፋይታሸ፥ ጎዳ ጋላታ። ሌወትነ ነ ግዶን ደእያ በተ አሳ ኡባይካ ኔራ ኡፋይቶ።<verse eid="DEU 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 26:12"/>አስራታ ከስያ ሄን ላይን፥ ነ ካፈ አስራታ ከሳ ኦንግዳፐ ጉየ ነ ካታማን ደእያ ሌወታስ፥ በተ አሳስ፥ ይኦታስነ አምኤታስ እማዳ ኤንቲ ካልድ ማና መላ ኦ። <verse eid="DEU 26:12"/><verse number="13" style="v" sid="DEU 26:13"/>ጎዳ፥ ነ ፆሳኮ፥ “ታኒ ታ ሶፐ ዱማትዳ ካ እሞታ ከሳዳ፥ ነ ታና ኪትዳይሳዳ ሌወታስ፥ በተ አሳስ፥ ይኦታስነ አምኤታስ እማስ። ታኒ ነ ኪታፐ እሱዋካ መንብከ፤ እሱዋካ ዶጋ አጋብከ። <verse eid="DEU 26:13"/><verse number="14" style="v" sid="DEU 26:14"/>ታ ካዮትያ ዎደካ፥ ሄ አስራታፐ አይባካ ማብከ፤ ታ ቱንዳ ዎደካ እያ ቦቻብከ፤ ሀይቅዳ አሳስ እያፐ እማብከ። ታኒ ጎዳ፥ ታ ፆሳ ቦንቻስ፤ እ ታና ኪትዳባ ኡባ ፖላስ። <verse eid="DEU 26:14"/><verse number="15" style="v" sid="DEU 26:15"/>ነኒ ደእያ ጌሻ በሳፈ፥ ሳሎፐ ዱገ ፄላ፤ ነ ደርያ እስራኤለ አንጃ፤ ካሰ ኑ ማይዛታስ ነ እማና ጋዳ ጫቅዳ ማነ ኤስ ጎግያ ቢታ ኑስ አንጃ” ያጋ።<verse eid="DEU 26:15"/></para>
  <para style="s1">ፆሳስ ዱማትዳ ደረ</para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 26:16"/>ነ ሀ አዋጆታነ ዎጋታ ናጋና መላ ጎዳይ ነ ፆሳይ ሀች ነና ኪትስ። ሄሳ ግሾ፥ ነ ኩመ ዎዛናፐነ ኩመ ሸምፑዋፈ ኤንታ ናጋ። <verse eid="DEU 26:16"/><verse number="17" style="v" sid="DEU 26:17"/>ጎዳይ፥ ነው ፆሰ ግደይሳነ ነኒ እያ ኦግያን ባናዉ፥ እያ ዎጋ፥ እያ ኪታነ ህግያ ናጋናይሳ ሀች ኤርሳዳሳ። <verse eid="DEU 26:17"/><verse number="18" style="v" sid="DEU 26:18"/>ጎዳይ ባ ገልዳ ቃላዳ ነኒ እያ ደረ ግደይሳ፥ እያዉ ቡዞ ሚሸ ግደይሳነ እያ ኪታ ኡባ ናገይሳታ ግደይሳ ሀች ነና ኤርስስ። <verse eid="DEU 26:18"/><verse number="19" style="v" sid="DEU 26:19"/>ሄሳ ነኒ ኦኮ፥ እ መዳ ደረ ኡባፈ አድ ነና ጋላታን፥ ሱንንነ ቦንቾን ግታ ደረ ኦና። እ ገልዳ ቃላዳ ነኒ እያዉ ጌሻ ደረ ግዳና።<verse eid="DEU 26:19"/></para>
  <chapter eid="DEU 26"/>
  <chapter number="27" style="c" sid="DEU 27"/>
  <para style="s1">ኤባላን ደእያ ያርሾ በሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 27:1"/>ሄሳፈ ጉየ፥ ሙሰይነ እስራኤለ ጭማት አሳኮ፥ “ታኒ ሀች ህንተና ኪትያ ኪታ ናግተ። <verse eid="DEU 27:1"/><verse number="2" style="v" sid="DEU 27:2"/>ዮርዳኖሰ ሻፋ ፕናዳ፥ ጎዳይ ነ ፆሳይ ነዉ እምያ ቢታ ገልያ ዎደ ግታ ሹቻታ ኤሳዳ ኖራ ትያ። <verse eid="DEU 27:2"/><verse number="3" style="v" sid="DEU 27:3"/>ጎዳይ፥ ነ አዋታ ፆሳይ ነዉ እማና ግዳይሳዳ ማነ ኤስ ጎግያ ቢታ፥ ጎዳይ ነ ፆሳይ ነዉ እምያ ቢታ ነ ፕንያ ዎደ ሀ ህገታ ኡባ ሄ ሹቻታ ቦላ ፃፋ። <verse eid="DEU 27:3"/><verse number="4" style="v" sid="DEU 27:4"/>ኔኒ ዮርዳኖሰ ፕንዳ ዎደ ታ ነና ሀች ኪትዳይሳዳ ሀ ሹቻታ ኤባላ ዙማ ቦላ ኤሳዳ ኤንታ ቦላ ኖራ ትያ። <verse eid="DEU 27:4"/><verse number="5" style="v" sid="DEU 27:5"/>ሄ በሳን ጎዳስ፥ ነ ፆሳስ፥ ብራት ቦቾና ሹቻፈ ያርሾ በሲ ጊግሳ። <verse eid="DEU 27:5"/><verse number="6" style="v" sid="DEU 27:6"/>ጎዳስ፥ ነ ፆሳስ ያርሾ በሲ ማሰትቦና ሹቻፈ ኦ፤ እያ ቦላ ጎዳስ፥ ነ ፆሳስ ፁሳ ያርሾ ያርሻ። <verse eid="DEU 27:6"/><verse number="7" style="v" sid="DEU 27:7"/>እስፈተ ያርሹዋ ሺሻዳ ማሸ ጎዳ፥ ነ ፆሳ ስንን ኡፋይታ። <verse eid="DEU 27:7"/><verse number="8" style="v" sid="DEU 27:8"/>ሀ ህገታ በንታና መላ ኦዳ ሀ ሹቻታ ቦላ ቆንጨን ፃፋ” ያግስ።<verse eid="DEU 27:8"/></para>
  <para style="s1">ኤባላፐ ዎያ ባደ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 27:9"/>ሙሰይነ ሌወ ግድዳ ካህነት እስፈ አሳኮ፥ “እስራኤለ፥ ስእ ጋዳ ዎዛናፐ ስአ፤ ሀች ነ ጎዳ፥ ነ ፆሳ ደረ ግዳዳሳ። <verse eid="DEU 27:9"/><verse number="10" style="v" sid="DEU 27:10"/>ታ ሀች ነዉ እምያ ጎዳ፥ ነ ፆሳ አዋጆታ ናጋነ ኪተታ” ያግስ።<verse eid="DEU 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 27:11"/>ሄ ጋላስ ሙሰይ አሳ ሀይሳዳ ያግድ ኪትስ። <verse eid="DEU 27:11"/><verse number="12" style="v" sid="DEU 27:12"/>“ህንተ ዮርዳኖሰ ፕንዳፐ ጉየ ጋርዛና ዙማ ቦላ ኤቅድ አሳ አንጃናይሳት፥ ስሞና፥ ሌወ፥ ይሁዳ፥ ይሳኮራ፥ ዮሰፋነ ብንያመ ኮቻታ። <verse eid="DEU 27:12"/><verse number="13" style="v" sid="DEU 27:13"/>ቃስ ኤባላ ዙማ ቦላ ኤቅድ አሳ ባዳናይሳት፥ ሮቤላ፥ ጋደ፥ አሴራ፥ ዛብሎና፥ ዳነነ ንፍታለመ ኮቻታ።<verse eid="DEU 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 27:14"/>“ሌወት ባንታ ቃላ ቁ ኦድ፥ እስራኤለ አሳኮ ሀይሳዳ ያጎ።<verse eid="DEU 27:14"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="15" style="v" sid="DEU 27:15"/>ጎዳ ስንን እፀትዳባ ግድያ ግሾ፥ ኩሸ ሂላንችጮይ ም ማስድ፥ ብራታ ሼሽድ ዎይኮ ሹች ቆፅድ ኦዳ ኤቃ ጌማን ጎይንያ ኦንካ ባደትዳይሳ ግዶ” ጊኮ፥</para>
  <para style="pmr" vid="DEU 27:15">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:15"/></para>
  <para style="pm">
    <verse number="16" style="v" sid="DEU 27:16"/>“ባ አዋ ዎይኮ ባ አይዉ ካዉሽያ ኦንካ ባደትዳይሳ ግዶ” ጊኮ፥</para>
  <para style="pmr" vid="DEU 27:16">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:16"/></para>
  <para style="pm">
    <verse number="17" style="v" sid="DEU 27:17"/>“ባ ሾሩዋ ዛዋ ሱግያ አስ ባደትዳይሳ ግዶ” ጊኮ፥</para>
  <para style="pmr" vid="DEU 27:17">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="DEU 27:18"/>“ቆቀይ ባናዉ በሲያ ኦግያፐ ሀራ ሶ ዛርያ አስ ባደትዳይሳ ግዶ” ጊኮ፥</para>
  <para style="pmr" vid="DEU 27:18">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:18"/></para>
  <para style="pm">
    <verse number="19" style="v" sid="DEU 27:19"/>“በተ አሳ፥ ይኦ ናይታነ አምኤታ ፕርዳ ጌላይያ አስ ባደትዳይሳ ግዶ” ያግኮ፥</para>
  <para style="pmr" vid="DEU 27:19">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="DEU 27:20"/>“ባ አዋ ማችዉ ፃልድ፥ ባ አዋ ቦንቹዋ ቃርያ አስ ባደትዳይሳ ግዶ” ጊኮ፥</para>
  <para style="pmr" vid="DEU 27:20">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:20"/></para>
  <para style="pm">
    <verse number="21" style="v" sid="DEU 27:21"/>“መሄራ ቱንያ አስ ባደትዳይሳ ግዶ” ጊኮ፥</para>
  <para style="pmr" vid="DEU 27:21">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:21"/></para>
  <para style="pm">
    <verse number="22" style="v" sid="DEU 27:22"/>“ባ ምቾ ግድዳ አዋ ዎይኮ አየ ናኤራ ቱንያ አስ ባደትዳይሳ ግዶ” ጊኮ፥</para>
  <para style="pmr" vid="DEU 27:22">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="DEU 27:23"/>“ባ ማቸ አየራ ቱንያ አስ ባደትዳይሳ ግዶ” ጊኮ፥</para>
  <para style="pmr" vid="DEU 27:23">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="DEU 27:24"/>“አሰ ጌማን ዎያ አስ ባደትዳይሳ ግዶ” ጊኮ፥</para>
  <para style="pmr" vid="DEU 27:24">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="DEU 27:25"/>“ሚሸን ሻመትድ፥ ፅሎ አስ ዎያ አስ ባደትዳይሳ ግዶ” ጊኮ፥</para>
  <para style="pmr" vid="DEU 27:25">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:25"/></para>
  <para style="pm">
    <verse number="26" style="v" sid="DEU 27:26"/>“ሀ ህገታ ናጎና አስ ባደትዳይሳ ግዶ” ጊኮ፥</para>
  <para style="pmr" vid="DEU 27:26">አሳ ኡባይ፥ “አምንእ” ያጎ።<verse eid="DEU 27:26"/></para>
  <chapter eid="DEU 27"/>
  <chapter number="28" style="c" sid="DEU 28"/>
  <para style="s1">ኪተተ ኤህያ አንጆ</para>
  <para style="r">(<ref loc="LEV 26:3-13">ሌወ 26:3-13</ref>፤ <ref loc="DEU 7:12-24">ዛረ 7:12-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 28:1"/>ኔኒ ጎዳ ነ ፆሳስ ፖሎ ኪተትኮ፥ ሀች ታ ነዉ እምያ ኪታ ኡባ ምንዳ ናግኮ፥ ጎዳይ፥ ነ ፆሳይ ቢታን ደእያ ካዎተታ ኡባፈ አድ ነና ቁ ቁ ኦና። <verse eid="DEU 28:1"/><verse number="2" style="v" sid="DEU 28:2"/>ኔኒ ጎዳ፥ ነ ፆሳስ ኪተትኮ፥ ሀይሳፈ ካልድ ደእያ አንጆ ኡባይ ነባ ግዳና።<verse eid="DEU 28:2"/></para>
  <para style="pi">
    <verse number="3" style="v" sid="DEU 28:3"/>ነ ካታማንነ ነ ጎሻን አንጀትዳይሳ ግዳና።<verse eid="DEU 28:3"/></para>
  <para style="pi">
    <verse number="4" style="v" sid="DEU 28:4"/>ነ ኡሎ አይፈይ፥ ነ ካይ፥ ነ መሄይ፥ ነ ዶርሳትነ ነ ዴሻት አንጀትዳይሳታ ግዳና።<verse eid="DEU 28:4"/></para>
  <para style="pi">
    <verse number="5" style="v" sid="DEU 28:5"/>ነ ኬሸይነ ነ ሙናቃ ሚሸይ አንጀትዳይሳ ግዳና።<verse eid="DEU 28:5"/></para>
  <para style="pi">
    <verse number="6" style="v" sid="DEU 28:6"/>ነ ከሳይነ ነ ገሎይ አንጀትዳይሳ ግዳና።<verse eid="DEU 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 28:7"/>ነ ቦላ ደንድያ ነ ሞርከታ፥ ጎዳይ ነ ስንን ፆነትዳይሳታ ኦና። ኤንቲ ነ ቦላ እስ ኦገራ ያና፥ ሽን ላፑን ኦገራ ነ ስንፈ ባቃታና።<verse eid="DEU 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 28:8"/>ጎዳይ ነ ኩሸይ ኦይክያባነ ነ ሻልያ አንጃና፤ ጎዳይ፥ ነ ፆሳይ ነዉ እምያ ቢታን ነና አንጃና።<verse eid="DEU 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 28:9"/>ኔኒ ጎዳ፥ ነ ፆሳ ኪታ ናግኮነ እያ ኦግያን ቢኮ፥ እ ነዉ ጫቅዳይሳዳ ጎዳይ ነና ባዉ ጌሻ ደረ ኦድ ኤሳና። <verse eid="DEU 28:9"/><verse number="10" style="v" sid="DEU 28:10"/>ሄሳፈ ጉየ፥ ቢታን ደእያ አሳ ኡባይ ጎዳይ ባ ሱንን ነና ፄግዳይሳ በእድ ያያና። <verse eid="DEU 28:10"/><verse number="11" style="v" sid="DEU 28:11"/>ጎዳይ ነዉ እማናዉ ነ ማይዛታስ ጫቅዳ ሄ ቢታን፥ ነ ኡሎ አይፍያ፥ ነ መህያ፥ ነ ጎሻ አይፍያ ዳርስድ አንጃና። <verse eid="DEU 28:11"/><verse number="12" style="v" sid="DEU 28:12"/>ነ ኩሸ ኦሶ ኡባ አንጃናዉነ፥ ጎዳይ ነ ቢታስ እራ ዎደን ዎደን ቡክሳናዉ ባ ምንጃ ኬ፥ ሳሎ ፐንግያ ነዉ ዶያና። ኔኒ ዳሮ ካዎተታስ ገደ ታልአናፐ አትሽን፥ ኦደፈካ ሃ ታልአካ። <verse eid="DEU 28:12"/><verse number="13" style="v" sid="DEU 28:13"/>ጎዳይ ነና ኡባስ ካጨ ከሳናፐ አትሽን፥ ጎይና ከሰና። ሀች ታ ነዉ እምያ፥ ጎዳ፥ ነ ፆሳ ኪታ ስአዳ፥ ምንዳ ናግኮ፥ ነ ቦላ ግዳናፐ አትሽን፥ ጋርሰ ግዳካ። <verse eid="DEU 28:13"/><verse number="14" style="v" sid="DEU 28:14"/>ታ ነዉ ሀች እምዳ ኪታፐ ሀድርስ ዎይኮ ኡሻች ጋዳ፥ ሀራ ፆሳታ ካሎፋ፤ ኤንታ ጎይኖፋ።<verse eid="DEU 28:14"/></para>
  <para style="s1">ኪተቶና እፆይ ኤህያ ባደ</para>
  <para style="r">(<ref loc="LEV 26:14-46">ሌወ 26:14-46</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 28:15"/>ሽን ኔኒ ጎዳ፥ ነ ፆሳስ ኪተቶና እፃዳ፥ ሀች ታ ነና ኪትያ ዎጋነ ህግያ ኡባ ናጎና እፅኮ፥ ሀይሳፈ ካልድ ደእያ ባደት ኡባይ ነ ቦላ ያናነ ነና ደማና።<verse eid="DEU 28:15"/></para>
  <para style="b"/>
  <para style="pi">
    <verse number="16" style="v" sid="DEU 28:16"/>ነ ካታማንነ ነ ጎሻን ባደትዳይሳ ግዳና።<verse eid="DEU 28:16"/></para>
  <para style="pi">
    <verse number="17" style="v" sid="DEU 28:17"/>ነ ኬሸይነ ሙናቃ ሚሸይ ባደትዳይሳ ግዳና።<verse eid="DEU 28:17"/></para>
  <para style="pi">
    <verse number="18" style="v" sid="DEU 28:18"/>ነ ኡሎ አይፈይ፥ ነ ካ አይፈይ፥ ነ መሄይ፥ ነ ዶርሳይነ ዴሻይ ባደትዳይሳ ግዳና።<verse eid="DEU 28:18"/></para>
  <para style="pi">
    <verse number="19" style="v" sid="DEU 28:19"/>ነ ከሳይነ ነ ገሎይ ባደትዳይሳ ግዳና።<verse eid="DEU 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 28:20"/>ኔኒ ኢታ ኦሶ ኦዳ ታና አግዳ ግሾ፥ ኔኒ ኤሶን ያና ጋካናዉ ነ ኦያ ኦሶ ኡባን ጎዳይ ባደ፥ ዳጋማነ ካዉሻተ የዳና። <verse eid="DEU 28:20"/><verse number="21" style="v" sid="DEU 28:21"/>ኔኒ ላታናዉ ብያ ቢታፈ ያና ጋካናዉ ጎዳይ፥ ጋዶይ ኔፐ ዱፆና መላ ኦና። <verse eid="DEU 28:21"/><verse number="22" style="v" sid="DEU 28:22"/>ጎዳይ ነና ግልቃተን፥ ምሻን፥ ማዱንን፥ ፁግያ አዋን፥ ኮሻን፥ ዎልኦንነ ካ ይስያ ሀርመን ነ ያና ጋካናዉ ሾጫና። <verse eid="DEU 28:22"/><verse number="23" style="v" sid="DEU 28:23"/>ኔፐ ቦላራ ደእያ ሳሎይ ናሰ ብራታ ግዳና፤ ኔፐ ጋርሳራ ደእያ ቢታይ ብራታ ግዳና። <verse eid="DEU 28:23"/><verse number="24" style="v" sid="DEU 28:24"/>ጎዳይ ነ ቢታን ቡክያ እራ ብዶነ ባና ከሳና፤ ኔኒ ያና ጋካናዉ ሳሎፐ ባን ቡካና።<verse eid="DEU 28:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 28:25"/>ጎዳይ ነና ነ ሞርከታን ፆንሳና። ነኒ ኤንታ ኦላናዉ እስ ኦገራ ከያና፤ ሽን ላፑን ኦገራ ነ ኤንታ ስንፈ ባቃታና። ቢታን ደእያ ካዎተ ኡባይ ነ ቦላ ጋክዳባ በእድ፥ ያሻን ኮኮራና። <verse eid="DEU 28:25"/><verse number="26" style="v" sid="DEU 28:26"/>ነ አሀይ ሳሎ ካፎታስነ ባዞ ዶአታስ ካ ግዳና፤ ኤንታ የደያ ኦንካ ዴና።<verse eid="DEU 28:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="DEU 28:27"/>ጎዳይ ነና ፓፆይ ባይና ግብፀ ጋዶን፥ ክፃን፥ ማዱንንነ ፑሶ ሄርገን ሾጫና። <verse eid="DEU 28:27"/><verse number="28" style="v" sid="DEU 28:28"/>ጎዳይ ነና ጎሻተን፥ ቆቀተንነ ዳጋማን ሾጫና። <verse eid="DEU 28:28"/><verse number="29" style="v" sid="DEU 28:29"/>ሴታ ጋላስ ኔኒ ቆቀይ ታታፈይሳዳ ታታፋና፤ ነ ኦያባ ኡባይ ነዉ ጊጎና እፃና። ነ ደኦ ላይ ኡባን ነ ኡንኤታናነ ቦንቀታዳ ዳና። ነና ማድያ አስ ደማካ።<verse eid="DEU 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 28:30"/>ነ ማቾ ኦይቻ ጊግሳና፥ ሽን እዮ ሀር ዳፍ ኤክድ ኢሳና። ኔኒ ኬ ኬፃና፥ ሽን እያን ደአካ። ዎይነ ቶካና፥ ሽን እያ አይፍያ ማካ። <verse eid="DEU 28:30"/><verse number="31" style="v" sid="DEU 28:31"/>ነ ቦራይ ነ ስንን ሹከታና፥ ሽን እያ አሹዋ ማካ። ነ ሀረይ ኔፐ ዎልቃን ኤከታና፥ ሽን ነዉ ጉየ ስመና። ነ ዶርሳት ነ ሞርከታስ እመታና፥ ኤንታ አሻናዉ ነና ማድያ አስ ዴና። <verse eid="DEU 28:31"/><verse number="32" style="v" sid="DEU 28:32"/>ነ አይፈይ በእሽን ነ አደ ናይትነ ማጫ ናይት ሀራ ካዎተስ እመታና። ኤንቲ ስምን በአና ጋዳ ፄልሽን፥ ነ አይፈይ ቶሉ ግድ አታና፤ ሄሳ ድጋናዉ ነዉ ዎልቅ ዴና። <verse eid="DEU 28:32"/><verse number="33" style="v" sid="DEU 28:33"/>ነ ቢታ አይፍያነ ነ ጫዋ ኡባ ነ ኤሮና አስ ማና፤ ነ ደኦ ላይ ኡባን ኡንኤትዳይሳነ ናቀትዳይሳ ግዳና። <verse eid="DEU 28:33"/><verse number="34" style="v" sid="DEU 28:34"/>ነ በእያ ኢታት ነና ጎሻና። <verse eid="DEU 28:34"/><verse number="35" style="v" sid="DEU 28:35"/>ጎዳይ ፓፆይ ባይና ኢታ ማዱንን ነ ጉልባታነ ነ ዎድርያ ሀርግሳና፤ ቶሆፐ ሁጰ ጋካናዉ፥ ነና ሄ ማዱንን ሾጫና።<verse eid="DEU 28:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="DEU 28:36"/>ጎዳይ ነናነ ነ ካዋ፥ ነናነ ነ ማይዛታ ኤሮና አሳ ቢታ ኤፋና። ሄሳን ኔኒ ምፈነ ሹቻፈ ኦሰትዳ ሀራ ፆሳታ ጎይናና። <verse eid="DEU 28:36"/><verse number="37" style="v" sid="DEU 28:37"/>ጎዳይ ነና ላልያ ሀራ ካዎተታ ግዶን ኔኒ ሚቻስነ ካሳስ አታና።<verse eid="DEU 28:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="DEU 28:38"/>ኔኒ ዳሮ ካ ነ ጎሻን ዘራና፤ ሽን ቦለይ ምድግን፥ ጉ ካ ሺሻና። <verse eid="DEU 28:38"/><verse number="39" style="v" sid="DEU 28:39"/>ዎይነ ቶካዳ እያ ሀርማና፥ ሽን ጉፁነይ እያ ምድግን፥ እያፐ አይፈ ደማካ ዎይኮ እያፐ ኡያካ። <verse eid="DEU 28:39"/><verse number="40" style="v" sid="DEU 28:40"/>ነ ቢታ ኡባን ሻማሆይ ዶላና፥ ሽን አይፈይ ቆቆፈትድ ዉርያ ግሾ፥ ሻማሆ ዛይተ ደማካ። <verse eid="DEU 28:40"/><verse number="41" style="v" sid="DEU 28:41"/>ነ አደነ ማጫ የላና፥ ሽን ኦል ድእድ ኤፍያ ግሾ ኤንቲ ኔራ ዶኮና። <verse eid="DEU 28:41"/><verse number="42" style="v" sid="DEU 28:42"/>ነ ምነ ነ ቢታ አይፍያ ቦለይ ዉርሳና።<verse eid="DEU 28:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="DEU 28:43"/>ነ ግዶን ደእያ በተ አሳይ ነ ቦላ ቁ ቁ ጋና፥ ሽን ነ ጉየ አታዳ ዝቅ ዝቅ ጋና። <verse eid="DEU 28:43"/><verse number="44" style="v" sid="DEU 28:44"/>እ ነዉ ታልአናፐ አትሽን፥ ነ እያዉ ታልአካ፤ እ ሁጰ ግዳና፤ ኔኒ ጎይና ግዳና።<verse eid="DEU 28:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="DEU 28:45"/>ጎዳ፥ ነ ፆሳ፥ ነ ኪተቶና እፅዳ ግሾነ እያ ዎጋነ ህግያ ናጎና እፅዳ ግሾ፥ ነ ያና ጋካናዉ ሀ ባደት ኡባይ ነ ቦላ ዎና፤ ነና ኤንቲ የደና። <verse eid="DEU 28:45"/><verse number="46" style="v" sid="DEU 28:46"/>ሀ ባደት ነ ቦላነ ነ ኮቻ ቦላ መርናዉ ማላታነ ማላልስያባ ግዳና። <verse eid="DEU 28:46"/><verse number="47" style="v" sid="DEU 28:47"/>ነዉ ሳእ እንጀትዳ ዎደ ጎዳ፥ ነ ፆሳ ኡፋይሳንነ ጋላታን ጎይኖና ግሾ፥ <verse eid="DEU 28:47"/><verse number="48" style="v" sid="DEU 28:48"/>ነና ኮሻን፥ ሳሞን፥ ካሎተንነ መቶን ኡባባ ያዳ፥ ጎዳይ ነ ቦላ የድያ ነ ሞርከታስ ሃረታና። ጎዳይ ነና ይሳና ጋካናዉ ነ ሞርገን ብራታ ቃምባራ ዎና።<verse eid="DEU 28:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="DEU 28:49"/>ጎዳይ ነ ኤንታ ቃላ ኤሮና ካዎተታ፥ ቢታ ጋፃፐ አንኮይ ፕራድ ዎይሳዳ ነ ቦላ ኤሀና። <verse eid="DEU 28:49"/><verse number="50" style="v" sid="DEU 28:50"/>ኤንቲ ዎዛና ምኖታ፤ ጭማ ቦንቾናይሳታ፤ ናይታስ ቃቶናይሳታ። <verse eid="DEU 28:50"/><verse number="51" style="v" sid="DEU 28:51"/>ነ ያና ጋካናዉ ኤንቲ ነ መህያነ ጎሻ አይፍያ ማና። ኔኒ ያና ጋካናዉ ነ ካ፥ ነ ዎይንያ፥ ነ ዛይትያ፥ ነ ሚዛነ ነ ዶርሳ ዉድያ ማሮኮና። <verse eid="DEU 28:51"/><verse number="52" style="v" sid="DEU 28:52"/>ጎዳይ፥ ነ ፆሳይ ነዉ እምያ ቢታን ደእያ ነ አማነትያ አዱሰነ ምኖ ድርሳት ላለታና ጋካናዉ ነ ካታማ ዩሹዋ ተቅድ ነና ኡንኤና።<verse eid="DEU 28:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="DEU 28:53"/>ነ ሞርከት ካታማ ተቅድ ነና ኡንኤያ ዎደ ምያባ ያዳ፥ ጎዳይ ነ ፆሳይ ነዉ እምዳ ነ ኡሎ አይፈ ግድዳ ነ አደ ናይታነ ነ ማጫ ናይታ ማና። <verse eid="DEU 28:53"/><verse number="54" style="v" sid="DEU 28:54"/>ነ ግዶን ሀር አቶሽን ካሰ እንጀን ደእዳ አስካ ባ እሻስ፥ ባ ዶስያ ማቸስነ ባ የልዳ ናይታስ ባ ካፈ ሻከና። <verse eid="DEU 28:54"/><verse number="55" style="v" sid="DEU 28:55"/>ሞርከት ካታማ ተቅድ ኡንኤያ ዎደ ማናባይ ሀር ባይና ግሾ፥ ምያ ባ ናይታ አሹዋፐ ሀራ ኦደስካ እመና። <verse eid="DEU 28:55"/><verse number="56" style="v" sid="DEU 28:56"/>ነ ግዶን ካሰ እንጀን ደእዳ፥ ባ እንጅያፈ ደንዶይሳን ሳአ የናዉ ሻተትያ ማጫስያ፥ ባ ዶስያ አዝናስነ ባ የልዳ ናይታስ ኡዘታና። <verse eid="DEU 28:56"/><verse number="57" style="v" sid="DEU 28:57"/>ሞርከት እያ ደእያ ካታማ ተቅድ እዮ ኡንኤዳ ግሾነ ዋይስዳ ግሾ፥ እዉ ሀር ምያባይ ይን፥ ባ የልዳ ናኣነ ዶኣ ኤንታ ጋና ጌማን ባርካ ማና።<verse eid="DEU 28:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="DEU 28:58"/>ሀ ማፃፋን ፃፈትዳ ህገታ ነ ናጎና እፅኮ፥ ማላልስያነ ያሽያ ጎዳ፥ ነ ፆሳ ሱን ቦንቾና እፅኮ፥ <verse eid="DEU 28:58"/><verse number="59" style="v" sid="DEU 28:59"/>ነ ቦላነ ነ ኮቻ ቦላ ጎዳይ፥ ያሽያ ጋዶ፥ ዳሮ ዎደ ጋምእያ፥ ፓፆይ ባይና ኢታ ሀርገ የዳና።<verse eid="DEU 28:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="DEU 28:60"/>ካሰ ግብፀ አሳ ቦላ በአዳ፥ ነ ያይዳ ግብፀ ሀርገ ኡባ ዛሪድ ነ ቦላ ኤሀና፤ ሄ ሀርገይ ነና የደና። <verse eid="DEU 28:60"/><verse number="61" style="v" sid="DEU 28:61"/>ጉጅድካ፥ ሀ ህገ ማፃፋን ፃፈትቦና ሀርገታነ ጋዶታ ኡባ ነ ያና ጋካናዉ ጎዳይ ነ ቦላ ኤሀና። <verse eid="DEU 28:61"/><verse number="62" style="v" sid="DEU 28:62"/>ጎዳ፥ ህንተ ፆሳ ህንተ ስኦና እፅዳ ግሾ፥ ሳሎ ፆልንቶዳ ዳርዳ ህንተፈ ጉ አታና። <verse eid="DEU 28:62"/><verse number="63" style="v" sid="DEU 28:63"/>ጎዳይ፥ ህንተዉ ሎኦባ ኦያ ዎደነ ህንተ ታይቦይ ዳርያ ዎደ ኡፋይትዳይሳዳ ሀእ ህንተ ቦላ ጋዶ ኤህያ ዎደነ ህንተና ይስያ ዎደ ኡፋይታና፤ ህንተ ላታናዉ ብያ ቢታፈ ሾደትድ ያና።<verse eid="DEU 28:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="DEU 28:64"/>ጎዳይ ነና ሀ ጋፃፐ ያ ጋፃ ጋካናዉ ካዎተታ ኡባ ግዶን ላላና። ያን ነኒ ዎይኮ ነ ማይዛት ኤሮና ሀራ ምነ ሹቻ ፆሳታ ጎይናና። <verse eid="DEU 28:64"/><verse number="65" style="v" sid="DEU 28:65"/>ሄ ካዎተታ ግዶን ህንተ ሸምፖ ደመከታ፤ ቶሆይ የያ በስካ ነዉ ዴና። ያን ጎዳይ ነዉ ቆፋን ኩምዳ ጉገ፥ አሞን አርጋጭዳ አይፈነ ኡፋይስ ቃንፅዳ ዎዛና እማና። <verse eid="DEU 28:65"/><verse number="66" style="v" sid="DEU 28:66"/>ነ ደኦይ ህርጋን ኩማና፤ ጋላስነ ቃማ ዳጋማንነ ሀይቆ ያሻን ኡንኤታዳ ዳና። <verse eid="DEU 28:66"/><verse number="67" style="v" sid="DEU 28:67"/>ነ ዎዛናን ኩምዳ ያሻፈነ ነ አይፈይ በእያ ፓላባፐ ደንዶይሳን፥ ዎንትያ ዎደ ነኒ፥ “አዉደ ቃማንዴሻ” ቃስ ቃምያ ዎደ፥ “አዉደ ዎንታንደሻ” ያጋና። <verse eid="DEU 28:67"/><verse number="68" style="v" sid="DEU 28:68"/>ታ ነና፥ “ዛራዳ ሀ ኦግያራ ባካ” ግዳ ኦግያራ ጎዳይ ነና ዛሪድ ማርካበን ጉየ ግብፀ የዳና። ያን ነኒ አይለ ግዳናዉ ነ ሞርከታስ ነና ባይዛናዉ ኮያና፥ ሽን ህንተና አይለያናዉ ሻምያ አስ ደመከታ።<verse eid="DEU 28:68"/></para>
  <chapter eid="DEU 28"/>
  <chapter number="29" style="c" sid="DEU 29"/>
  <para style="s1">ሞአበን ዛር ኢምዳ ጫቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 29:1"/>ጎዳይ ኮሬባ ዙማን፥ እስራኤለ አሳራ ጫቅዳ ጫቁዋ ቦላ ጉጅድ ሞአበን ኤንታራ ጫቃናዉ ሙሰ ኪትዳ ጫቆ ቃላት ሀይሳታ። <verse eid="DEU 29:1"/><verse number="2" style="v" sid="DEU 29:2"/>ሙሰይ እስራኤለ አሳ ኡባ ፄግ ሺሽድ፥ ሀይሳዳ ያግስ።</para>
  <para style="p" vid="DEU 29:2">ጎዳይ ግብፀ ካዋ ቦላ፥ እያ ኦላንቾታ ቦላነ እያ ቢታ ኡባ ቦላ ኦዳባነ ጋዳባ ህንተ፥ ህንተ አይፈን በእደታ። <verse eid="DEU 29:2"/><verse number="3" style="v" sid="DEU 29:3"/>ኤንታ ቦላ ጋዳ ኢታ መቶታ፥ ማላልስያባታነ ግታ ማላታታ ህንተ፥ ህንተ አይፈን በእደታ። <verse eid="DEU 29:3"/><verse number="4" style="v" sid="DEU 29:4"/>ሽን ሀች ጋካናዉ ጎዳይ፥ ህንተዉ አኬክያ ዎዛና፥ ፄልያ አይፈነ ስእያ ሀይ እምቤና። <verse eid="DEU 29:4"/><verse number="5" style="v" sid="DEU 29:5"/>ጎዳይ ኦይታሙ ላይ ኩመ ህንተና መላ ቢታን ካለያ ዎደ ህንተ ማኦይ ዉርቤና፥ ህንተ ጫማይ ጭምቤና። <verse eid="DEU 29:5"/><verse number="6" style="v" sid="DEU 29:6"/>ጎዳይ፥ ህንተ ፆሳ ግደይሳ ህንተ ኤራና መላ ኡይ ምቤከታ፤ ዎይነ ዎይኮ ሀራ ማይያ ኡሽ ኡይቤከታ።<verse eid="DEU 29:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 29:7"/>ኑኒ ሀ በሳ ጋክዳ ዎደ ሀሰቦና ካዎይ ስሆንነ ባሳነ ካዎይ ኦገይ ኑራ ኦለታናዉ ከይዶሶና፥ ሽን ኑኒ ኤንታ ፆንዳ። <verse eid="DEU 29:7"/><verse number="8" style="v" sid="DEU 29:8"/>ኤንታ ቢታ ኤክድ፥ ሮቤላነ ጋደ ኮቻስ፥ ቃስ ምናሰ ኮቻፈ ባጋስ ላታ ኦድ እምዳ።<verse eid="DEU 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 29:9"/>ህንተ ኦይክያባይነ የያባይ ህንተዉ አንጀታና መላ ሀ ጫቆ ቃላታ አማነትድ ናግተ። <verse eid="DEU 29:9"/><verse number="10" style="v" sid="DEU 29:10"/>ሀች ህንተ ኡባይ፥ ኮቻታ ሀላቃት፥ ጭማት፥ ሹማትነ እስራኤለ አሳ ኡባይ ሀይሳን ጎዳ ስንን ኤቅደታ። <verse eid="DEU 29:10"/><verse number="11" style="v" sid="DEU 29:11"/>ህንተ ናይታራ፥ ህንተ ማቸታራ፥ ህንተ ግዶን ደእድ፥ ም ምፅያነ ሃ ትክያ ሀራ ቢታ አሳራ እስፈ ሀይሳን ኤቅደታ። <verse eid="DEU 29:11"/><verse number="12" style="v" sid="DEU 29:12"/>ጎዳ፥ ህንተ ፆሳራ ቃላ ገላናዉ ሀይሳን ኤቅደታ። ጎዳይ ሀ ቃላ ሀች ህንተራ ጫቆን ምንና። <verse eid="DEU 29:12"/><verse number="13" style="v" sid="DEU 29:13"/>ጎዳይ ህንተና ባ አሰ ኦድ ምንና፤ ህንተዉነ ህንተ ማይዛታስ፥ አብራሃመስ፥ ይሳቃስነ ያይቆባስ ጫቅዳይሳዳ እ ህንተዉ ፆሰ ግዳና። <verse eid="DEU 29:13"/><verse number="14" style="v" sid="DEU 29:14"/>ጎዳይ ሀ ጫቆ ቃላ ኤሰይ ህንተ ፃላላራ ግደና። <verse eid="DEU 29:14"/><verse number="15" style="v" sid="DEU 29:15"/>ሀች ሀይሳን፥ ጎዳ፥ ኑ ፆሳ ስንን ኤቅዳ ኑ ኡባራነ ስንፈ ያና የለታ ኡባራ ኤሴስ።<verse eid="DEU 29:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 29:16"/>ኑኒ ግብፀን ዋንድ ደእዳኮነ ሀእ ጋካናዉ ኦገን ደእያ ካዎተታ ግዶራ ዋንድ ካንድ ይዳኮ ኤሬታ። <verse eid="DEU 29:16"/><verse number="17" style="v" sid="DEU 29:17"/>ኤንታ ግዶን ደእያ እፀትዳ ም፥ ሹቻ፥ ብራነ ዎርቃ ኤቃ ምስለታ በእደታ። <verse eid="DEU 29:17"/><verse number="18" style="v" sid="DEU 29:18"/>ሀ ህንተፈ ኦንካ አደ ግድን ማጫ ግድን፥ እስ ሶ አስ ግድን፥ እስ ኮች ግድን ጎዳ፥ ኑ ፆሳፈ፥ ሃክድ ሀራ ካዎተታ ፆሳታ ጎይኖና መላ ናገትተ። ሄሳ መላ ጫምያነ ዎያ አይፈ አይፍያ አስ ህንተ ግዶን ደኦፖ።<verse eid="DEU 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 29:19"/>ሀ ጫቆ ቃላ ስእድ፥ ባ ዎዛናን፥ “ታ ሸነን ታኒ ቢኮካ፥ መቶይ ባዋ” ያግድ ባና ጭምኮ፥ ሄሳ መላ አስ ሎኦታ ቦላነ ኢታታ ቦላ ዮ ኤሄስ። <verse eid="DEU 29:19"/><verse number="20" style="v" sid="DEU 29:20"/>ጎዳ ሀንቆይነ ቃናተይ ሄሳ መላ አሰ ቦላ ኤፅድ ከያና። ሀ ማፃፋን ፃፈትዳ ባደ ኡባይ እያ ቦላ ያና፤ ሳሎፐ ጋርሳን እያ ሱን ጎዳይ ቁቻና። <verse eid="DEU 29:20"/><verse number="21" style="v" sid="DEU 29:21"/>ጎዳይ ሀ ህገ ማፃፋን ፃፈትዳ ባደ ጫቆ ቃላዳ ሄ ኡራ እስራኤለ ግዶፈ ሻክድ ይሳና።<verse eid="DEU 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 29:22"/>ያና የለተይ፥ ህንተ ሼሻይነ ሃሆ ቢታፈ ያ ሀራ ቢታ አሳይ፥ ጎዳይ ህንተ ቦላ ኤህዳ ጋዱዋነ ሀርግያ በአና። <verse eid="DEU 29:22"/><verse number="23" style="v" sid="DEU 29:23"/>ቢታ ኡባይ ዲነንነ ማፅነን ኩማና፤ ቶከትያባይ ዴና፤ ዶልያባይ በንተና፤ ማትነ ም ዶለና። ጎዳይ ባ ሀንቆን ይስዳ ሶዶማዳነ ጋሞራዳ፥ አዳማዳነ ፃቦይማ ካታማታዳ ሀናና። <verse eid="DEU 29:23"/><verse number="24" style="v" sid="DEU 29:24"/>ካዎተት፥ “ጎዳይ ሀ ቢታ ቦላ ሀይሳ መላባ አይስ ኦዴ? ሀ ዎልቃማ ሀንቁዋስ ጋሶይ አይቤ?” ያጋና።<verse eid="DEU 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 29:25"/>አሳይ ዛሪድ፥ “ኤንቲ ጎዳይ፥ ኤንታ አዋታ ፆሳይ፥ ኤንታ ግብፀፈ ከስዳ ዎደ ኤንታራ ገልዳ ጫቆ ቃላ መንዳ ግሾሳ። <verse eid="DEU 29:25"/><verse number="26" style="v" sid="DEU 29:26"/>ኤንቲ ኤሮና ፆሳታስነ እ ጎይኖፍተ ግዳ ፆሳታ ጎይንዶሶና። <verse eid="DEU 29:26"/><verse number="27" style="v" sid="DEU 29:27"/>ሄሳ ግሾ፥ ጎዳይ ሀንቀትድ፥ ሀ ማፃፋን ፃፈትዳ ባደታ ኡባ ኤንታ ቦላ ኤህስ። <verse eid="DEU 29:27"/><verse number="28" style="v" sid="DEU 29:28"/>ጎዳይ ዎልቃማ ሀንቆ ሀንቀትድ፥ ኤንታ ቢታፈ ኤንታና ሾድድ ሀራ ቢታ የደስ” ያጋና።<verse eid="DEU 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 29:29"/>ፁራይ ኑ ጎዳ ኑ ፆሳሳ፥ ሽን ኑኒ ሀ ህገ ቃላ ኦና መላ ቆንጭዳይሳት መርናዉ ኑሳነ ኑ ናይታሳ።<verse eid="DEU 29:29"/></para>
  <chapter eid="DEU 29"/>
  <chapter number="30" style="c" sid="DEU 30"/>
  <para style="s1">ፆሳኮ ስሞን በንትያ አንጆ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 30:1"/>ሀች ታ ነ ስንን ዎዳ አንጆይነ ባደይ ነ ቦላ ጋክያ ዎደ ጎዳይ፥ ነ ፆሳይ ነና ላልያ ሀራ ካዎተታ ግዶን ደእሸ ሀይሳ ነ አኬክኮ፥ <verse eid="DEU 30:1"/><verse number="2" style="v" sid="DEU 30:2"/>ነነ ነ ናይት ጎዳ፥ ነ ፆሳኮ፥ ስማዳ፥ ነ ኩመ ዎዛናፐነ ነ ኩመ ሸምፑዋፈ ታ ሀች ነና ኪትያ ህግያስ ኪተትኮ፥ <verse eid="DEU 30:2"/><verse number="3" style="v" sid="DEU 30:3"/>ያን ጎዳይ፥ ነ ፆሳይ ነ ድኤትዳ ቢታፈ ነና ዛራና። እ ህንተዉ ቃትድ ህንተና ላልዳ ካዎተታ ኡባ ግዶፈ ዛሪድ ሺሻና። <verse eid="DEU 30:3"/><verse number="4" style="v" sid="DEU 30:4"/>ቢታ ጋፃፐ ጋፃ ጋካናዉ ነ ላለትኮካ፥ ያፐ ጎዳይ፥ ነ ፆሳይ ነና ዛሪድ ሺሻና። <verse eid="DEU 30:4"/><verse number="5" style="v" sid="DEU 30:5"/>ነ አዋት ካሰ ላትዳ ቢታ፥ ነካ ላታና መላ ጎዳይ፥ ነ ፆሳይ ነና ሄ ቢታ ኤሀና። ያን ነና ነ አዋታፐ አድ ዱረያና፤ ነ ታይቡዋ ዳርሳና።<verse eid="DEU 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 30:6"/>ነ ደኦን ዳና መላነ ጎዳ፥ ነ ፆሳ ነ ኩመ ዎዛናፐነ ነ ኩመ ሸምፑዋፈ ዶሳና መላ እ ነዉነ ነ ናይታስ ኪተትያ ዎዛና እማና። <verse eid="DEU 30:6"/><verse number="7" style="v" sid="DEU 30:7"/>ጎዳይ፥ ነ ፆሳይ ሀ ባደታ ኡባ ነ ሞርከታነ ነና ጎደይሳታ ቦላ ኤሀና። <verse eid="DEU 30:7"/><verse number="8" style="v" sid="DEU 30:8"/>ሀች ታ ነና ኪትያ ህግያ ነ ናጋና፤ ዛራዳ ጎዳስ፥ ነ ፆሳስ ኪተታና። <verse eid="DEU 30:8"/><verse number="9" style="v" sid="DEU 30:9"/>ሄ ዎደ ጎዳይ ነ ፆሳይ ነና ነ ኩሸ ኦሶ ኡባን፥ ነ ኡሎ አይፍያን፥ መህያንንነ ነ ጎሻ አይፍያን ነና ዳርስድ አንጃና። ጎዳይ ካሰ ነ አዋታ አንጅድ ኡፋይትዳይሳዳ ነና አንጅድ ኡፋይታና። <verse eid="DEU 30:9"/><verse number="10" style="v" sid="DEU 30:10"/>ሄስ ሀናናይ ሀ ህገ ማፃፋን ፃፈትዳ ጎዳ፥ ነ ፆሳ ህግያነ ዎጋ ናጋዳ፥ ጎዳ፥ ነ ፆሳኮ ነ ኩመ ዎዛናፐነ ነ ኩመ ሸምፑዋፈ ስምኮ።<verse eid="DEU 30:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 30:11"/>ሀች ታ ነና ኪትያ ኪታት ሄሳ መላ ዴፆ ግዶኮና፤ ኔፐ ሃኮኮና። <verse eid="DEU 30:11"/><verse number="12" style="v" sid="DEU 30:12"/>ኔኒ፥ “ኑኒ ስእድ ኪተታና መላ ሳሎ ከይድ ኑስ ዎሳናይ ኦኔ?” ጎና መላ ሳሎና ግደና። <verse eid="DEU 30:12"/><verse number="13" style="v" sid="DEU 30:13"/>“ኑኒ ስእድ ኪተታና መላ ኑስ አባ ፕንድ ኤሀናይ ኦኔ?” ጎና መላ አባፈ ሄፍንና ግደና። <verse eid="DEU 30:13"/><verse number="14" style="v" sid="DEU 30:14"/>ቃላይ ነዉ ዳሮ ማታን ደኤስ፤ ነ ኦና መላ ቃላይ ነ ዎዛናንነ ነ ዶናን ደኤስ።<verse eid="DEU 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 30:15"/>ሄኮ፥ ታ ሀች ነ ስንን ደኦነ ሎኦተ፥ ሀይቆነ ዮ ዎስ። <verse eid="DEU 30:15"/><verse number="16" style="v" sid="DEU 30:16"/>ነ ጎዳ፥ ነ ፆሳ ዶስኮ፥ እያ ኦግያን ቢኮ፥ እያ ኪታ፥ እያ አዋጁዋነ እያ ህግያ ታግኮ፥ ነ ደኦን ዳናነ ዳራና። ነ ላታናዉ ገልያ ቢታን ጎዳይ፥ ነ ፆሳይ ነና አንጃና።<verse eid="DEU 30:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 30:17"/>ሽን ነ ዎዛናይ ጎዳፐ ሃክን፥ እያዉ ኪተቶና እፃዳ፥ ሀራ ፆሳታስ ጉፋናዳ ኤንታ ጎይንኮ፥ <verse eid="DEU 30:17"/><verse number="18" style="v" sid="DEU 30:18"/>ህንተ ኡባይ ያናይሳ ታ ሀች ህንተዉ ኦዳይስ። ዮርዳኖሰ ፕንድ ህንተ ላታናዉ ብያ ቢታን ህንተ ላይይ አዱቀና።<verse eid="DEU 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 30:19"/>ታ ህንተ ስንን ደኦነ ሀይቆ፥ አንጆነ ባደ ዎዳይሳስ ሀች ሳሎነ ሳአ ህንተ ቦላ ማርካያና። ህዛ ህንተነ ህንተ ሼሻይ ደኦን ዳና መላ ደኦ ዶርተ። <verse eid="DEU 30:19"/><verse number="20" style="v" sid="DEU 30:20"/>ጎዳ ነ ፆሳ ዶሳ፤ እያ ቃላ ስአ፥ እያዉ ኪተታ፤ እያራ ኦይከታ። ሄሳዳ ሀንኮ፥ ጎዳይ ካሰ ነ ማይዛታስ፥ አብራሃመስ፥ ይሳቃስነ ያይቆባስ እማናዉ ጫቅዳ ቢታን ነነ ነ ሼሻይ አዱሳ ላይ ዳና።<verse eid="DEU 30:20"/></para>
  <chapter eid="DEU 30"/>
  <chapter number="31" style="c" sid="DEU 31"/>
  <para style="s1">እያሱይ ሙሰ በሳን ሱንትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 31:1"/>ሙሰይ ባ ኦዳ ዉርስዳፐ ጉየ እስራኤለ አሳኮ ሀይሳዳ ያግስ፤ <verse eid="DEU 31:1"/><verse number="2" style="v" sid="DEU 31:2"/>“ሀእ ታዉ ፄታነ ላታሙ ላይ ግድዳ ግሾ፥ ህዛፐ ጉየ ካለናዉ ዳንዳእከ። ጎዳይ ታኮ፥ ‘ነ ዮርዳኖሰ ፕናካ’ ያግስ። <verse eid="DEU 31:2"/><verse number="3" style="v" sid="DEU 31:3"/>ጎዳይ፥ ነ ፆሳይ ነ ስን አድ ነና ካለና። ያን ደእያ ካዎተታ እ ይሳና ግሾ፥ ኤንታ ቢታ ነ ላታና። ጎዳይ ግዳይሳዳ እያሱይ ህንተና ካለና። <verse eid="DEU 31:3"/><verse number="4" style="v" sid="DEU 31:4"/>ጎዳይ አሞረ ካዎታ ስሆናነ ኦገ ፆንድ፥ ኤንታ ቢታ ይስዳይሳዳ ህንተ ሞርከታ ሄሳዳ ኦና። <verse eid="DEU 31:4"/><verse number="5" style="v" sid="DEU 31:5"/>ጎዳይ ኤንታ ህንተዉ አድ እምን፥ ህንተ ኤንታ ቦላ ታ ህንተና ኪትዳይሳዳ ኦና። <verse eid="DEU 31:5"/><verse number="6" style="v" sid="DEU 31:6"/>ምንተ፤ ገንጭተ፤ ያዮፍተ። ኤንታ በእድ ዳጋሞፕተ። ጎዳይ ህንተ ፆሳይ ህንተራ ግዳና፤ እ ህንተና የገና፥ አገና” ያግስ።<verse eid="DEU 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 31:7"/>ሙሰይ እያሱ ፄግድ፥ እስራኤለ አሳ ኡባ ስንን ሀይሳዳ ያግስ፤ “ምና፤ ገንጫ። ነ ሀ አሳራ እስፈ ጎዳይ ኤንታ ማይዛታስ እማና ግድ ጫቅዳ ቢታ ገላሳ፤ ሄ ቢታ ኤንታ ላትሳሳ። <verse eid="DEU 31:7"/><verse number="8" style="v" sid="DEU 31:8"/>ጎዳይ፥ እ ባ ሁጰን ኔራ ግድድ ነና ካለና። እ ነና የገና፤ አገና። ሄሳ ግሾ፥ ያዮፋ፤ ኡፋይስ ቃንፆፋ” ያግስ።<verse eid="DEU 31:8"/></para>
  <para style="s1">ህገይ ቆንጨን ናባበቶ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 31:9"/>ሙሰይ ሀ ህግያ ፃፍድ፥ ጎዳ ቃላ ጫቆ ታቦትያ ቶክያ ካህነ ግድዳ ሌወ ናይታስነ እስራኤለ ጭማታስ እሚስ። <verse eid="DEU 31:9"/><verse number="10" style="v" sid="DEU 31:10"/>ሙሰይ ኤንታኮ፥ “አጮ ኡባይ አቶ ጌተትያ ላፑን ላይ ዉርሰን፥ ሻቃራ ባለይ ቦንቸትያ ጋላስ፥ ሀ ህግያ ቁ ኦድ ናባብተ። <verse eid="DEU 31:10"/><verse number="11" style="v" sid="DEU 31:11"/>ጎዳ፥ ህንተ ፆሳ ስንን፥ እ ዶርዳ በሳን፥ እያ ጎይናናዉ እስራኤለ አሳ ኡባይ ሺቅያ ዎደ ኤንታዉ ናባብተ። <verse eid="DEU 31:11"/><verse number="12" style="v" sid="DEU 31:12"/>ኤንቲ ኡባይ ስእድ፥ ጎዳ፥ ህንተ ፆሳስ ያሽ ታማራና መላ ሀ ህገ ቃላ ኡባ ናጋና መላ አደታ፥ ማጫሳታ፥ ናይታነ ህንተ ቢታን ደእያ ሀራ ቢታ አሳ እስፈ ሺሽተ። <verse eid="DEU 31:12"/><verse number="13" style="v" sid="DEU 31:13"/>ሀ ህገ ቃላ ኤሮና ኤንታ ናይትካ ዮርዳኖሰ ፕንድ፥ ህንተ ላታናዉ ብያ ቢታን፥ ህንተ ደእያ ላይ ኡባን ሀ ህግያ ስኦ፤ ጎዳስ፥ ህንተ ፆሳስ፥ ያሽ ታማሮ” ያግድ ኪትስ።<verse eid="DEU 31:13"/></para>
  <para style="s1">እስራኤለ ጌላተይ ኮይሮትድ ኦደትስ</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 31:14"/>ጎዳይ ሙሰኮ፥ “ነ ሀይቅያ ዎደይ ማትስ። እ ካለና ዎጋ ታ እያዉ እማና መላ እያሱ ፄጋዳ፥ እያራ እስፈ ዱንካንያ ፐንገ ሺቅተ” ያግን፥ ሙሰይነ እያሱይ ዱንካንያ ፐንግያኮ ሺቅዶሶና።<verse eid="DEU 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 31:15"/>ጎዳይ ዱንካንያ ፐንገን ኤቅዳ ሻራ ቱሳን ኤንታዉ ቆንጭስ።<verse eid="DEU 31:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 31:16"/>ጎዳይ ሙሰኮ፥ “ኔኒ ማታ ዎደ ሀይቃዳ ነ አዋታን ጋሄታሳ። ኔፐ ጉየ፥ ሀ አሳይ ታዉ አማነቶናይሳታ ግዳና፤ ታ ኤንታራ ገልዳ ጫቁዋ መንና። ኤንቲ ታና አግድ፥ ባንታ ላትያ ቢታን ደእያ ኤቃታ ካላና። <verse eid="DEU 31:16"/><verse number="17" style="v" sid="DEU 31:17"/>ሄስ ሀንያ ዎደ ታ ሀንቆይ ኤንታ ቦላ ኤፃና፤ ታ ኤንታ አጋጋና፤ ታ ሶምኡዋ ኤንታፈ ሀራ ሶ ዛራና። ኤንቲ ያና፤ ኢታ መቶይነ ዮይ ኤንታ ቦላ ያና። ሄ ዎደ ኤንቲ፥ ‘ቱማ ሀ መቶይ ኑና ጋክዳይ ኑ ፆሳይ ኑ ግዶን ባይና ግሾ ግደኔ?’ ያጋና። <verse eid="DEU 31:17"/><verse number="18" style="v" sid="DEU 31:18"/>ሀራ ፆሳታ ጎይንድ፥ ኤንቲ ኦዳ ኢታ ኦሱዋ ግሾ፥ ታ ሄ ጋላስ ታ ሶምኡዋ ኤንታፈ ሀራ ሶ ዛራና።<verse eid="DEU 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 31:19"/>“ሀእ ሀ ማዝሙርያ ፃፋዳ፥ እስራኤለ አሳ ኡባ ታማርሳ። ሀ ማዝሙረይ ታዉ እስራኤለ አሳ ቦላ ማርካ ግዳና መላ ኤንታ የፅሳ። <verse eid="DEU 31:19"/><verse number="20" style="v" sid="DEU 31:20"/>ኤንታ ማይዛታስ ገልዳ ቃላዳ፥ ማነ ኤስ ጎግያ ቢታ ታ ኤንታ ገልሳ ስምን፥ ኤንቲ ም ካልድ ጎብዳፐ ጉየ፥ ሀራ ፆሳታ ጎይንድ፥ ታና ካና፤ ታ ጫቁዋ መንና። <verse eid="DEU 31:20"/><verse number="21" style="v" sid="DEU 31:21"/>ዳሮ መቶይነ ዮይ ኤንታ ቦላ ጋክዳ ዎደ ሀ ማዝሙረይ ኤንታ ናይታፐ ባለቶና ግሾ፥ ኤንታ ቦላ ማርካ ግዳና። ታኒ ጫቅዳ ቢታ ኤንታ ቡሮ ገልሶና ደእሽን፥ ሃራ ኤንቲ ቆፕያ ቆፋ ታኒ ኤራይስ” ያግስ። <verse eid="DEU 31:21"/><verse number="22" style="v" sid="DEU 31:22"/>ሙሰይ ሄ ጋላስ ማዝሙርያ ፃፍድ፥ እስራኤለ አሳ ታማርስስ።<verse eid="DEU 31:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 31:23"/>ሄሳፈ ጉየ፥ ጎዳይ ናወ ናኣ እያሱኮ፥ “ምና፥ ገንጫ፤ ታ ኤንታዉ እማናዉ ቃላ ገልዳ ቢታ እስራኤለ አሳ ኤፋዳ ገልሳ። ታ ኔራ ግዳና” ያግስ።<verse eid="DEU 31:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 31:24"/>ሙሰይ ሀ ህገታ ኮይሮፐ ዉርሰ ጋካናዉ ፃፍድ ዉርስዳፐ ጉየ፥ <verse eid="DEU 31:24"/><verse number="25" style="v" sid="DEU 31:25"/>ጎዳ፥ ቃላ ጫቆ ታቦትያ ቶክያ ሌወታ ሀይሳዳ ያግድ ኪትስ፤ <verse eid="DEU 31:25"/><verse number="26" style="v" sid="DEU 31:26"/>“ጎዳ ህገይ ፃፈትዳ ሀ ማፃፋ ኤፍድ፥ ጎዳ፥ ህንተ ፆሳ ቃላ ጫቆ ታቦትያ ማታን ዎተ። ያን እ ህንተ ቦላ ማርካ ግዳና። <verse eid="DEU 31:26"/><verse number="27" style="v" sid="DEU 31:27"/>ህንተ አይ መላ ጌለኮነ ዎዛና ኢተኮ ታ ኤራይስ። ቱማ፥ ታ ህንተራ ደእዳ ላይ ኡባን ህንተ ጎዳስ ማካላታ፥ ሽን ታ ሀይቅን፥ ኡባ ዋንድ ማካላንደቲ? <verse eid="DEU 31:27"/><verse number="28" style="v" sid="DEU 31:28"/>ሄሳ ግሾ፥ ሀይሳ ኡባ ታ ኤንታዉ ኦዳናዉነ ሳሎነ ሳአ ታ ኤንታ ቦላ ማርካያናዉ ህንተ ኮቻ ሀላቃታነ ደርያ ካለያ አሳ ኡባ ታዉ ሺሽተ። <verse eid="DEU 31:28"/><verse number="29" style="v" sid="DEU 31:29"/>ታ ሀይቅዳፐ ጉየ፥ ህንተ ቱማ ኢታ አሰ ግዳናይሳነ ታኒ ህንተና ታማርስዳ ኪታፐ ሀራ ሶ ስማናይሳ ታኒ ኤራይስ። ህንተ እያ ስንን ኢታባ ኦድ፥ ጎዳ ይሎይያ ግሾ፥ ዎደፐ እ ህንተ ቦላ ኢታ ጋዶ ኤሀና” ያግስ።<verse eid="DEU 31:29"/></para>
  <para style="s1">ሙሰ ማዝሙርያ</para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 31:30"/>ሄሳፈ ጉየ፥ ሙሰይ ሀ ማዝሙረ ቃላታ ዉራና ጋካናዉ ሺቅዳ እስራኤለ ማባራ ኡባ ናባብድ ስስስ።<verse eid="DEU 31:30"/></para>
  <chapter eid="DEU 31"/>
  <chapter number="32" style="c" sid="DEU 32"/>
  <para style="q1">
    <verse number="1" style="v" sid="DEU 32:1"/>ሳሎቶ፥ ታኒ ኦደይሳ ስእተ፤</para>
  <para style="q2" vid="DEU 32:1">ቢታይ ታ ዶና ቃላ ሀይዞ።<verse eid="DEU 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="DEU 32:2"/>ታ ትምርተይ እራ መላ ቡኮ፤</para>
  <para style="q2" vid="DEU 32:2">ታ ቃላይ አካዳ ዎ።</para>
  <para style="q1" vid="DEU 32:2">ማታ ቦላ ዎያ ፃሳዳ</para>
  <para style="q2" vid="DEU 32:2">ዶላ ቦላ ዎያ ፑሰዳ ዎ።<verse eid="DEU 32:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="DEU 32:3"/>ታኒ ጎዳ ሱን አዋጃና፤</para>
  <para style="q2" vid="DEU 32:3">ግታተ ኑ ፆሳስ እምተ።<verse eid="DEU 32:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="DEU 32:4"/>እ ኑ ዛላ፤ እያ ኦሶይ ፖሎ፤</para>
  <para style="q2" vid="DEU 32:4">እያ ኦገይ ሱረ።</para>
  <para style="q1" vid="DEU 32:4">ፆሳይ አማንይሳ፤ ዎርዶይ ባይናይሳ፤</para>
  <para style="q2" vid="DEU 32:4">እ ቱማንቾነ ሱረ።<verse eid="DEU 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="DEU 32:5"/>እያ ስንን ባንታ ቱናተ በስዶሶና፤</para>
  <para style="q2" vid="DEU 32:5">ኤንቲ እያ ናአ ግዶኮና፤</para>
  <para style="q2" vid="DEU 32:5">ኤንቲ ኢታነ ጌላ የለተ።<verse eid="DEU 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="DEU 32:6"/>ህንተኖ፥ ኤያነ አኬክ ባይና አሳዉ፥</para>
  <para style="q2" vid="DEU 32:6">ህንተ ጎዳስ እምያ ዛሮይ ሀይሴ?</para>
  <para style="q1" vid="DEU 32:6">እ ህንተና መዳ ህንተ አዋ ግደኔ?</para>
  <para style="q2" vid="DEU 32:6">ህንተና መድ ምን ኤስዳይ እያ ግደኔ?<verse eid="DEU 32:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="DEU 32:7"/>በን ዎድያ ቆፓ፤</para>
  <para style="q2" vid="DEU 32:7">አዳ የለተ አኬካ።</para>
  <para style="q1" vid="DEU 32:7">ነ አዋ ኦይቻ፤ እ ነዉ ኦዳና፤</para>
  <para style="q2" vid="DEU 32:7">ጭማታ ኦይቻ፤ ኤንቲ ነዉ ቆንጭሳና።<verse eid="DEU 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="DEU 32:8"/>ኡባፈ ዎልቃማይ ካዎተታስ</para>
  <para style="q2" vid="DEU 32:8">ኤንታ ላታ ሻክዳ ዎደ፥</para>
  <para style="q2" vid="DEU 32:8">አሳ ዘረካ ዱማይዳ ዎደ፥</para>
  <para style="q1" vid="DEU 32:8">እስራኤለ አሳ ታይቡዋ መላ፥</para>
  <para style="q2" vid="DEU 32:8">አሳስ ኤንታ ዛዋ ኤስስ።<verse eid="DEU 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="DEU 32:9"/>ጎዳ ጋክዳ ግሾይ እስራኤለ፤</para>
  <para style="q2" vid="DEU 32:9">ያይቆብ እያ ጋክዳ ላታ።<verse eid="DEU 32:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="DEU 32:10"/>እ ኤንታ መላ ቢታን፥</para>
  <para style="q2" vid="DEU 32:10">አይኮይ ባይና መላ ቢታን፥</para>
  <para style="q2" vid="DEU 32:10">ጫርኮይ ባቅሽን ደምስ።</para>
  <para style="q1" vid="DEU 32:10">እያዉ ጎንዳለ ግድስ፥ እያ ናግስ፤</para>
  <para style="q2" vid="DEU 32:10">ባ አይፈ ናኤዳ ምንድ ናግስ።<verse eid="DEU 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="DEU 32:11"/>አርጋን ባ ናአ ፓሎ ታማርሰይሳዳ፥</para>
  <para style="q2" vid="DEU 32:11">ባ ምጭዳ ቀፍያን ጋክድ አሸይሳዳ፥</para>
  <para style="q2" vid="DEU 32:11">ጎዳይ ባ ቀፍያን ሀጵድ ኤንታ አሽስ።<verse eid="DEU 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="DEU 32:12"/>ጎዳይ ባ ፃላላ ኤንታ ካለስ፤</para>
  <para style="q2" vid="DEU 32:12">ሀራ አላጋ ፆሲ እያራ ባዋ።<verse eid="DEU 32:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="DEU 32:13"/>እ ቢታስ ቃ በሳ ኤንታ ከስስ፤</para>
  <para style="q2" vid="DEU 32:13">ጎሻ አይፍያ ኤንታ ሙዝስ።</para>
  <para style="q1" vid="DEU 32:13">ዛላ ቆጶፐ ኤንታ ኤስ ካልስስ፤</para>
  <para style="q2" vid="DEU 32:13">ሹቻ ቢታፈ በንትያ ዛይተ ኡሽስ።<verse eid="DEU 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="DEU 32:14"/>ኤንታ መህያፐ ቄሳ ማ፥</para>
  <para style="q2" vid="DEU 32:14">ዶርሳፈነ ዴሻፐ ፃማታ ማ፥</para>
  <para style="q2" vid="DEU 32:14">ሞ ዶርሰነ ዴሻ አሾ ምዶሶና።</para>
  <para style="q1" vid="DEU 32:14">ባሳነ ዶርሳነ ዴሻ አሹዋ፥</para>
  <para style="q2" vid="DEU 32:14">ሎኦ ግስተ ኡይራ ምዶሶና፤</para>
  <para style="q2" vid="DEU 32:14">ሱ ዳንያ ዎይነ ኡሻ ኡይዶሶና።<verse eid="DEU 32:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="DEU 32:15"/>ሽን እስራኤለይ ኦርድስ፤ ማካልስ፤</para>
  <para style="q2" vid="DEU 32:15">ምድ ካልድ ሞሎትስ።</para>
  <para style="q1" vid="DEU 32:15">ባና መዳ ፆሳ አግስ፤</para>
  <para style="q2" vid="DEU 32:15">ባ አቶተ ዛላ ካዉሽስ።<verse eid="DEU 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="DEU 32:16"/>ኤንቲ አላጋ ፆሳታ ጎይንድ፥</para>
  <para style="q2" vid="DEU 32:16">እያ ቃናትስዶሶና።</para>
  <para style="q1" vid="DEU 32:16">እፀትዳ ባንታ ኤቃታን</para>
  <para style="q2" vid="DEU 32:16">እያ ሀንቀዶሶና።<verse eid="DEU 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="DEU 32:17"/>ፆሰ ግዶናይሳታስ፥</para>
  <para style="q2" vid="DEU 32:17">ካሰ ኤንቲ ኤሮና ፆሳታስ፥</para>
  <para style="q2" vid="DEU 32:17">ዝነ ደንድዳይሳታስ፥</para>
  <para style="q2" vid="DEU 32:17">ኤንታ አዋት ጎይንቦና</para>
  <para style="q2" vid="DEU 32:17">ፆሳታስ ያርሽዶሶና።<verse eid="DEU 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="DEU 32:18"/>ኤንታዉ ደኦ እምያ ዛላ ዶግዶሶና፤</para>
  <para style="q2" vid="DEU 32:18">የልድ ድችዳ ፆሳ አግዶሶና።<verse eid="DEU 32:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="DEU 32:19"/>አደ ናይትነ ማጫ ናይት እያ ይሎይዶሶና፤</para>
  <para style="q2" vid="DEU 32:19">ጎዳይ ሄሳ በእድ ኤንታ ካስ።<verse eid="DEU 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="DEU 32:20"/>እ፥ “ኤንቲ ጌላነ አማነቶና ደረ ግድያ ግሾ፥</para>
  <para style="q2" vid="DEU 32:20">ታኒ ታ ሶምኡዋ ኤንታፈ ገንና፤</para>
  <para style="q2" vid="DEU 32:20">ኤንታ ዉርሰ ስእ ጋዳ በአና” ያግስ።<verse eid="DEU 32:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="DEU 32:21"/>ፆሰ ግዶናይሳታን ታና ቃናትስዶሶና፤</para>
  <para style="q2" vid="DEU 32:21">ባንታ ኤቃታን ታና ይሎይዶሶና።</para>
  <para style="q1" vid="DEU 32:21">ታኒ ኤንታ ካትዳ አሳን ቃናትሳና፤</para>
  <para style="q2" vid="DEU 32:21">ኤያ አሳን ኤንታ ይሎያና።<verse eid="DEU 32:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="DEU 32:22"/>ታ ሀንቆይ ታማዳ ኤፃና፤</para>
  <para style="q2" vid="DEU 32:22">ስኦለ ጋካናዉ ፁጋና።</para>
  <para style="q1" vid="DEU 32:22">ቢታን ደእያባ ኡባ ማና፥</para>
  <para style="q2" vid="DEU 32:22">ደርያ ባሱዋ ጋካናዉ ፁጋና።<verse eid="DEU 32:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="DEU 32:23"/>“ታኒ ኤንታ ቦላ መቶ ዶራና፤</para>
  <para style="q2" vid="DEU 32:23">ታ ዶንግያን ኤንታ ዱካና።<verse eid="DEU 32:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="DEU 32:24"/>ታ ኤንታ ቦላ ኢታ ኮሻ የዳና፤</para>
  <para style="q2" vid="DEU 32:24">ኤንቲ ሀርገንነ ጋዶን ዉራና።</para>
  <para style="q1" vid="DEU 32:24">ኤንታ ቦላ ኢታ ባዞ ዶአታነ</para>
  <para style="q2" vid="DEU 32:24">ዱክድ ዎያ ኢታ ሾሻታ የዳና።<verse eid="DEU 32:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="DEU 32:25"/>ኤንታ፥ ማሽ ኦገ ቦላ ዉርሳና፤</para>
  <para style="q2" vid="DEU 32:25">ኬ ጋርሳን ዳጋም ካዎታና።</para>
  <para style="q1" vid="DEU 32:25">ናአተ አደትነ ማጫት ዉራና፤</para>
  <para style="q2" vid="DEU 32:25">ጉ ናይትነ ጭማት አቶኮና።<verse eid="DEU 32:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="DEU 32:26"/>ታ ኤንታ ይሳናዉነ</para>
  <para style="q2" vid="DEU 32:26">ኤንታ ሀሳይያ አስ</para>
  <para style="q2" vid="DEU 32:26">ዶና መላ ኦናዉ ቆፓስ።<verse eid="DEU 32:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="DEU 32:27"/>ሽን ኤንታ ሞርከት፥ ‘ፆንዳይ ኑና፤</para>
  <para style="q2" vid="DEU 32:27">ሀ ኡባ ኦዳይ ጎዳ ግደና፤</para>
  <para style="q2" vid="DEU 32:27">ያግድ ኦቶሮን ጬቀቶና መላ ጋዳ አጋጋስ’ ” ያግስ።<verse eid="DEU 32:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="DEU 32:28"/>እስራኤለ አሳይ ዎዛን ባይና አስ፤</para>
  <para style="q2" vid="DEU 32:28">ኤንቲ አኬኮኮና።<verse eid="DEU 32:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="DEU 32:29"/>ኤንቲ ጭንጭድ አኬክዳኮ ሀይሳ ኤራና፥</para>
  <para style="q2" vid="DEU 32:29">ባንታ ዉርሰካ ሻካናሽን።<verse eid="DEU 32:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="DEU 32:30"/>ጎዳይ ኤንታ ፆሳይ ኤንታ ባይዞናኮ፥</para>
  <para style="q2" vid="DEU 32:30">ኤንታ መዳ ዎልቃማይ አድ እሞናኮ፥</para>
  <para style="q2" vid="DEU 32:30">ዋትድ እስ አስ ሙኩሉ አሳ፥</para>
  <para style="q2" vid="DEU 32:30">ኑምኡ አስ ታሙ ሙኩሉ አሳ ፆኒ?<verse eid="DEU 32:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="DEU 32:31"/>ኑ ዛላይ ኑ ሞርከታ ዛላ መላ</para>
  <para style="q2" vid="DEU 32:31">ግዶናይሳ ኤንቲ ኤሮሶና።<verse eid="DEU 32:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="DEU 32:32"/>ኤንታ ዎይነይ ሶዶመ ዎይንያፐ ዬስ፥</para>
  <para style="q2" vid="DEU 32:32">ኤንቲ ጋሞራ ጎሻን ዶልዶሶና፤</para>
  <para style="q2" vid="DEU 32:32">አይፍያን ማርዘይነ ጫሞይ ኩምስ።<verse eid="DEU 32:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="DEU 32:33"/>ኤንታ ዎይነይ ሾሻ ማርዘ፤</para>
  <para style="q2" vid="DEU 32:33">ዎያ ሶጎ።<verse eid="DEU 32:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="DEU 32:34"/>ጎዳይ፥ “ታ ሄሳ ዶጋድና?</para>
  <para style="q2" vid="DEU 32:34">ታ ማዝጋበን ፃፋብክና?<verse eid="DEU 32:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="DEU 32:35"/>ኤንታዉ ዮ ጋላስ ማትስ፤</para>
  <para style="q2" vid="DEU 32:35">ኤንታ ቦላ ጋካናባይ ኤለሴስ።</para>
  <para style="q1" vid="DEU 32:35">ሄ ዎደ ኤንታ ቶሆይ በታና፤</para>
  <para style="q2" vid="DEU 32:35">ታ ሀሎ ከያናነ ኩሸ ዛራና።”<verse eid="DEU 32:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="DEU 32:36"/>ኤንታ ዎልቃይ ዉርዳይሳነ</para>
  <para style="q2" vid="DEU 32:36">ኤንታ ማድያ አስ ባይናይሳ በእዳ ዎደ፥</para>
  <para style="q2" vid="DEU 32:36">ጎዳይ ባ አሳስ ፕርዳና፤ ባ አይለታስ ቃታና።<verse eid="DEU 32:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="DEU 32:37"/>ፆሳይ ኤንታኮ፥ “ኤንቲ አማነትያ ኤንታ ፆሳት አዉኔ?</para>
  <para style="q2" vid="DEU 32:37">ኤንቲ ባቃትድ ቆሰትያ ኤንታ ዛላይ አዉኔ?” ያጋና።<verse eid="DEU 32:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="DEU 32:38"/>ኤንታ ሞ ያርሹዋ ምዳይሳት፥</para>
  <para style="q2" vid="DEU 32:38">ኤንታ ዎይነ ኡሻ ያርሹዋ ኡይዳይሳት፥</para>
  <para style="q2" vid="DEU 32:38">ሀእ ደንድድ ኤንታ ማዶ፤ ኤንታ አሾ።<verse eid="DEU 32:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="DEU 32:39"/>“ቱማ፥ ጎድ ታና፤ ፆሲ ታ ፃላላ፤</para>
  <para style="q2" vid="DEU 32:39">ታፐ አትሽን፥ ሀራ ፆሲ ባዋ።</para>
  <para style="q1" vid="DEU 32:39">ዎይነ ፓይ ታና፤</para>
  <para style="q2" vid="DEU 32:39">ታ ማዱንፅሳይስ፤ ታ ፓይስ፤</para>
  <para style="q2" vid="DEU 32:39">ታ ኩሸፐ ኦንካ አሸና።<verse eid="DEU 32:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="DEU 32:40"/>ታ ኩሽያ ደንዳ ሀይሳዳ ያጋና፤</para>
  <para style="q2" vid="DEU 32:40">ታኒ መርናዉ ደኦ፤<verse eid="DEU 32:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="DEU 32:41"/>ጶልያ ታ ማሻ ሌፋዳ፥</para>
  <para style="q2" vid="DEU 32:41">ፕርዳናዉ ታ ኩሸን ኦይክያ ዎደ፥</para>
  <para style="q2" vid="DEU 32:41">ታ ሞርከታ ቦላ ታ ሀሎ ከያና፤</para>
  <para style="q2" vid="DEU 32:41">ታና እፀይሳታስ ኩሸ ዛራና።<verse eid="DEU 32:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="DEU 32:42"/>ታ ዶንገይ ኤንታ ሱን ማታና፤</para>
  <para style="q2" vid="DEU 32:42">ታ ማሻይ ኤንታ አሹዋ ማና።</para>
  <para style="q1" vid="DEU 32:42">ታና እፅያ ኡባ ማርከ፤</para>
  <para style="q2" vid="DEU 32:42">ማዱንፅዳይሳትነ ድኤትዳይሳት ሀይቃና።”<verse eid="DEU 32:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="DEU 32:43"/>ካዎተቶ፥ ጎዳ አሳራ ኡፋይትተ፤</para>
  <para style="q2" vid="DEU 32:43">እ ባ አይለታ ሱ አጫና።</para>
  <para style="q1" vid="DEU 32:43">ባ ሞርከታ ቦላ ሀሎ ከያና፤</para>
  <para style="q2" vid="DEU 32:43">ቢታን ደእያ ባ አሳ ናጋራ አቶ ጋና።<verse eid="DEU 32:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="DEU 32:44"/>ሙሰይነ ናወ ናአይ እያሱይ እስራኤለ አሳ ሺሽድ፥ ሀ ማዝሙርያ ኡባ አሳይ ስእሽን የፅዶሶና።<verse eid="DEU 32:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="DEU 32:45"/>ሙሰይ ሀ ቃላ ኡባ እስራኤለ አሳስ ኦድ ዉርስዳፐ ጉየ፥ <verse eid="DEU 32:45"/><verse number="46" style="v" sid="DEU 32:46"/>ኤንታኮ፥ “ሀ ህገ ቃላ ኡባ ህንተ ናይት ናጋና መላነ ኪተታና መላ ሀች ታ ህንተዉ ማርካ ኦዳ እምያ ቃላ ኡባ ህንተ ዎዛናን ዎተ። <verse eid="DEU 32:46"/><verse number="47" style="v" sid="DEU 32:47"/>ሀ ቃላይ ህንተዉ ደኦፐ አትሽን፥ ጮ ቃላ ግደና። ህንተ ሀ ቃላ ናግኮ፥ ዮርዳኖሰ ፕንድ ላታና ቢታን አዱሳ ላይ ዳና” ያግስ።<verse eid="DEU 32:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="DEU 32:48"/>ሄ ጋላስ ጎዳይ ሙሰ ሀይሳዳ ያግስ፤ <verse eid="DEU 32:48"/><verse number="49" style="v" sid="DEU 32:49"/>“ሞአበን፥ እያርኮ ካታማፐ ስን ባጋራ ደእያ አባሪማ ዙማታፐ እሱዋ ግድዳ ናቦ ዙማ ቦላ ከያ፤ ያን እስራኤለ አሳ ታ ላትሳና፥ ካናነ ቢታ ሃሆን ፄላ። <verse eid="DEU 32:49"/><verse number="50" style="v" sid="DEU 32:50"/>ነ እሻ አሮን ሆራ ዙማ ቦላ ሀይቅድ፥ ባ ማይዛታ ጋክዳይሳዳ ነካ ሀ ዙማ ቦላ ሀይቃዳ ነ ማይዛታ ጋካና። <verse eid="DEU 32:50"/><verse number="51" style="v" sid="DEU 32:51"/>ህንተ ናምአይ እስራኤለ አሳ ስንን ታዉ አማነትበከታ። ሲና መላ ቢታን፥ ቃደሳ ማታን ደእያ ማርባ ሃ ማታን ታ ጌሻተ እስራኤለ አሳ በስበከታ። <verse eid="DEU 32:51"/><verse number="52" style="v" sid="DEU 32:52"/>ሄሳ ግሾ፥ ኔኒ ሄ ቢታ ሃሆን ፄላናፐ አትሽን፥ ታ እስራኤለ አሳ ላትሳና ቢታ ገላካ” ያግስ።<verse eid="DEU 32:52"/></para>
  <chapter eid="DEU 32"/>
  <chapter number="33" style="c" sid="DEU 33"/>
  <para style="s1">ሙሰይ እስራኤለ ኮቻ አንጅስ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 33:1"/>ፆሳ አስ ግድዳ ሙሰይ ሀይቃናፐ ስን፥ እስራኤለ አሳ አንጅዳ አንጆ ቃላይ ሀይሳ።<verse eid="DEU 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="DEU 33:2"/>ሙሰይ፥ “ጎዳይ ሲና ዙማፐ ይስ፤</para>
  <para style="q2" vid="DEU 33:2">ሳይረ ዙማፐ ኑ ቦላ ፖእስ።</para>
  <para style="q2" vid="DEU 33:2">ፓራና ዙማፐ ጶልስ።</para>
  <para style="q1" vid="DEU 33:2">ሙኩላን ታይበትያ ኪታንቾት እያራ ደኦሶና፤</para>
  <para style="q2" vid="DEU 33:2">እያ ኡሻቻን ታማ ላጮይ ደኤስ።<verse eid="DEU 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="DEU 33:3"/>ጎዳዉ ኔኒ ነ አሳ ዶሳዳሳ፤</para>
  <para style="q2" vid="DEU 33:3">ጌሻት ኡባይ ነ ኩሸን ደኦሶና።</para>
  <para style="q1" vid="DEU 33:3">ነ ቶሁዋ ጋርሳን ኡባይ ጉልባትድ ጎይኖሶና፤</para>
  <para style="q2" vid="DEU 33:3">ኔፐ ኪታ ኤኮሶና።<verse eid="DEU 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="DEU 33:4"/>ሙሰይ እምዳ ህግያ</para>
  <para style="q2" vid="DEU 33:4">እስራኤለ አሳ ላታ ኤኮሶና።<verse eid="DEU 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="DEU 33:5"/>እስራኤለ ዘረት ደርያ ሀላቃታራ ሺቅዳ ዎደ፥</para>
  <para style="q2" vid="DEU 33:5">ጎዳይ ባ አሳ፥ እስራኤለ ቦላ ካዎትስ።<verse eid="DEU 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="DEU 33:6"/>“ሮቤላ ኮቻይ ታይቦን ጉ ግድኮካ፥</para>
  <para style="q2" vid="DEU 33:6">እ ሀይቆፎ፤ ፓፃ ደኦ።”<verse eid="DEU 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 33:7"/>ሙሰይ ይሁዳ ኮቻባ፥</para>
  <para style="q1" vid="DEU 33:7">“ጎዳዉ፥ ይሁዳ ዋሱዋ ስአ፤</para>
  <para style="q2" vid="DEU 33:7">ሀንኮ እያ ያራታራ እያ ቡአ።</para>
  <para style="q1" vid="DEU 33:7">ኤንታ ኩሽያ ምን፤</para>
  <para style="q2" vid="DEU 33:7">ኤንቲ ባንታ ሞርከታራ ኦለትያ ዎደ</para>
  <para style="q2" vid="DEU 33:7">ኤንታ ማዳ።<verse eid="DEU 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="DEU 33:8"/>ሙሰይ ሌወ ኮቻባ፥</para>
  <para style="q2" vid="DEU 33:8">ነ ቱሚመይነ ኡሪመይ፥</para>
  <para style="q2" vid="DEU 33:8">ኔኒ ማሳሀን ፓጭዳነ ማርባን ፓላምዳ፥</para>
  <para style="q2" vid="DEU 33:8">ነ ጌሻ አሳሳ።<verse eid="DEU 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="DEU 33:9"/>ባንታና የልዳይሳታፐ፥</para>
  <para style="q2" vid="DEU 33:9">ባንታ እሻታፐነ ባንታ ናይታፐ አድ፥</para>
  <para style="q2" vid="DEU 33:9">ኤንቲ ነዉ አማነትዶሶና፤</para>
  <para style="q2" vid="DEU 33:9">ነ ጫቆ ቃላ ናግዶሶና።<verse eid="DEU 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="DEU 33:10"/>ኤንቲ ነ ዎጋ ያይቆባ፥</para>
  <para style="q2" vid="DEU 33:10">ነ ህግያ እስራኤለ ታማርሶሶና።</para>
  <para style="q1" vid="DEU 33:10">ኤንቲ ነ ስንን እፃነ ጩይሶሶና፤</para>
  <para style="q2" vid="DEU 33:10">ያርሾ በሳን ፁሳ ያርሾ ያርሾሶና።<verse eid="DEU 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="DEU 33:11"/>አቤት ጎዳዉ፥ ሌወታ አንጃ፤</para>
  <para style="q2" vid="DEU 33:11">ኤንታ ኩሸ ኦሱዋን ነ ኡፋይታ።</para>
  <para style="q1" vid="DEU 33:11">ኤንታ ቦላ ደንድያ ሞርከታ መንረ</para>
  <para style="q2" vid="DEU 33:11">ዛር ደንዶና መላ ኤንታ ሞርከታ ጫዳ።”<verse eid="DEU 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="DEU 33:12"/>ብንያመ ኮቻባ፥</para>
  <para style="q2" vid="DEU 33:12">“ጎዳን ዶሰትዳይ እያን አማነትድ ደኤስ፤</para>
  <para style="q2" vid="DEU 33:12">ቃማ ጋላስ እ ኤንታ ናጌስ፤</para>
  <para style="q2" vid="DEU 33:12">ባ ሀሽያን ቶክድ ሸምፕሴስ።”<verse eid="DEU 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="DEU 33:13"/>ዮሰፋ ኮቻባ፥</para>
  <para style="q2" vid="DEU 33:13">“ጎዳይ፥ ሳሎፐ እራን፥</para>
  <para style="q2" vid="DEU 33:13">ሳአፐ ፑልቶ ሃን</para>
  <para style="q2" vid="DEU 33:13">ኤንታ ቢታ አንጆ።<verse eid="DEU 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="DEU 33:14"/>አዋን ካፅድ ዶረትዳ አይፈንነ</para>
  <para style="q2" vid="DEU 33:14">ዎደን ዎደን ካፅያ አይፈን አንጀቶ።<verse eid="DEU 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="DEU 33:15"/>በንፐ ደእያ ደረትነ</para>
  <para style="q2" vid="DEU 33:15">ዙማት ሎኦ አይፈን አንጀቶ።<verse eid="DEU 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="DEU 33:16"/>ኤንታ ቢታይ ሎኦባይ ኩምዳ ቢታ ግዶ፤</para>
  <para style="q2" vid="DEU 33:16">ቱሽያ ግዶን ኤፅያ ታማን ቆንጭዳ ጎዳይ እያ አንጆ።</para>
  <para style="q1" vid="DEU 33:16">ሀ አንጆት ኡባይ ዮሰፋ ኮቻ ጋኮ፤</para>
  <para style="q2" vid="DEU 33:16">እ ባ እሻታ ግዶን ሀላቃ ግዶ።<verse eid="DEU 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="DEU 33:17"/>ዮሰፍ ኮይሮ የለትዳ ኮርማዳ ምኖ፤</para>
  <para style="q2" vid="DEU 33:17">እያ ካጨት መን ካጨዳ ምኖ።</para>
  <para style="q1" vid="DEU 33:17">እያ ካጨት ታሙ ሙኩሉን ታይበትያ ኤፍሬማ ኮቻታ፤</para>
  <para style="q2" vid="DEU 33:17">ሙኩላን ታይበትያ ምናሰ ኮቻታ።</para>
  <para style="q1" vid="DEU 33:17">ሄ ካጨታን እ ካዎተታ ቃይጫና፤</para>
  <para style="q2" vid="DEU 33:17">ቢታ ጋፃ ጋካናዉ እ ኤንታ ሱጋና።”<verse eid="DEU 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="DEU 33:18"/>ዛብሎና ኮቻባ፥</para>
  <para style="q2" vid="DEU 33:18">“ዛብሎና፥ ኔኒ ነ ከሳን ኡፋይታ፤</para>
  <para style="q2" vid="DEU 33:18">ይሳኮራ፥ ኔኒ ነ ዱንካንያን ኡፋይታ።<verse eid="DEU 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="DEU 33:19"/>ኤንቲ አሳ ባንታ ዙማኮ ፄጋና፤</para>
  <para style="q2" vid="DEU 33:19">ያን ኤንቲ ጌሻተ ያርሾ ያርሻና።</para>
  <para style="q1" vid="DEU 33:19">ባንታ አቁዋነ ባንታ ዱረተ፥</para>
  <para style="q2" vid="DEU 33:19">አባፈነ አባ ጋፃን ደእያ ሻፍያፐ ደማና” ያግስ።<verse eid="DEU 33:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="DEU 33:20"/>ጋደ ኮቻባ፥</para>
  <para style="q1" vid="DEU 33:20">“ኤንታ ቢታ ዳልግስዳ ጎዳይ ጋላተቶ፤</para>
  <para style="q2" vid="DEU 33:20">ጋድ ሞርከ ሶምኦ ዎይኮ ቀሰ መንናዉ፥</para>
  <para style="q2" vid="DEU 33:20">ጋሞዳ ናጌስ።<verse eid="DEU 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="DEU 33:21"/>ኤንቲ ሎኦ ቢታ ባንታዉ ዶርዶሶና፤</para>
  <para style="q2" vid="DEU 33:21">ሀላቃታስ ግዳ ቢታ ኤንቲ ኤክዶሶና።</para>
  <para style="q1" vid="DEU 33:21">እስራኤለ ሀላቃት ሺቅዳ ዎደ፥</para>
  <para style="q2" vid="DEU 33:21">ጎዳ ጌሻ ሸንያ ሻክድ ኤርዶሶና</para>
  <para style="q2" vid="DEU 33:21">እስራኤለስ ሱረ ፕርዳ ፕርድዶሶና” ያግስ።<verse eid="DEU 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="DEU 33:22"/>ዳነ ኮቻባ፥</para>
  <para style="q1" vid="DEU 33:22">“ዳነይ ዎዳላ ጋሞ መላ፤</para>
  <para style="q2" vid="DEU 33:22">እ ባሳነፐ ጉፕድ ከያና” ያግስ።<verse eid="DEU 33:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="DEU 33:23"/>ንፍታለመ ኮቻባ፥</para>
  <para style="q1" vid="DEU 33:23">“ንፍታለመይ ጎዳ አ ኬሀተን፥</para>
  <para style="q2" vid="DEU 33:23">እያ አንጁዋን ዱረትስ፤</para>
  <para style="q2" vid="DEU 33:23">ኤንታ ቢታይ አባፈ ዱገሀ ባጋ ጋኬስ” ያግስ።<verse eid="DEU 33:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="DEU 33:24"/>አሴራ ኮቻባ፥</para>
  <para style="q1" vid="DEU 33:24">“አሴር ሀራ ኮቻታፐ አድ አንጀትዳይሳ፤</para>
  <para style="q2" vid="DEU 33:24">ባ እሻታን ዶሰትዳይሳ ግዶ፤</para>
  <para style="q2" vid="DEU 33:24">እያ ቢታይ ሻማሆ ዛይተን ዱረቶ።<verse eid="DEU 33:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="DEU 33:25"/>እያ ካታማት ብራታ ፐንገን ጎርደትድ ናገቶ፤</para>
  <para style="q2" vid="DEU 33:25">ባ ላይ ኡባን እ ዎልቃማ ግዶ።<verse eid="DEU 33:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="DEU 33:26"/>እስራኤለ፥ ሳሎፐ ነና ማዳናዉ፥</para>
  <para style="q2" vid="DEU 33:26">ባ ግታተን ሻራ ቦላ ሄመትያ፥</para>
  <para style="q2" vid="DEU 33:26">ነ ፆሳ መላ ፆሲ ኦኔ?<verse eid="DEU 33:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="DEU 33:27"/>መርና ፆሳይ ነ ደእያ በሲ፤</para>
  <para style="q2" vid="DEU 33:27">እያ መርና ኩሸት ኔፐ ጋርሳራ ደኦሶና።</para>
  <para style="q1" vid="DEU 33:27">እ ነ ሞርከታ ነ ስንፈ ከስድ፥</para>
  <para style="q2" vid="DEU 33:27">‘ኤንታ ይሳ’ ያግስ።<verse eid="DEU 33:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="DEU 33:28"/>ሄሳ ግሾ፥ እስራኤለ ኮቻይ፥</para>
  <para style="q2" vid="DEU 33:28">ሳሎ እራይ ቡክያ በሳን፥</para>
  <para style="q2" vid="DEU 33:28">ካነ ዎይነይ ኩምዳ ቢታን፥</para>
  <para style="q2" vid="DEU 33:28">ህርግ ባይና ሳሮ ዳና።<verse eid="DEU 33:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="DEU 33:29"/>እስራኤለ፥ ነ አንጀታዳይሳ፤</para>
  <para style="q2" vid="DEU 33:29">ጎዳይ አሽዳ ነ መል ኦኔ?</para>
  <para style="q1" vid="DEU 33:29">እ ነዉ ጎንዳለነ ማድያ ማሻ፤</para>
  <para style="q2" vid="DEU 33:29">ነ ሞርከት ነ ስንን ጉፋናና፤</para>
  <para style="q2" vid="DEU 33:29">ነ ኤንታ ባሱዋ ላላና” ያግስ።<verse eid="DEU 33:29"/></para>
  <chapter eid="DEU 33"/>
  <chapter number="34" style="c" sid="DEU 34"/>
  <para style="s1">ሙሰ ሀይቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 34:1"/>ሙሰይ ሞአበ ደምባፈ ደንድድ፥ ናቦ ዙማ ሁጵያ፥ ቃስ እያርኮፈ ዶሎሀ ባጋራ ደእያ ፕስጋ ዙማ ሁጵያ ጋክስ። ያን ጎዳይ ዳነ ጋካናዉ ደእያ ጋላዳ ቢታ፥ <verse eid="DEU 34:1"/><verse number="2" style="v" sid="DEU 34:2"/>ንፍታለመ ቢታ ኡባ፥ ኤፍሬመነ ምናሰ ቢታ፥ ዉሎሀ ባጋራ ብድ መደትራነ አባ ጋካናዉ ደእያ ይሁዳ ቢታነ <verse eid="DEU 34:2"/><verse number="3" style="v" sid="DEU 34:3"/>ዱገሀ ባጋራ ዞኣረፐ ደንድድ፥ ዛምብ ደእያ እያርኮ ካታማ፥ ዛንጋራን ደእያ ደምባ ኡባ በስስ። <verse eid="DEU 34:3"/><verse number="4" style="v" sid="DEU 34:4"/>ጎዳይ ሙሰኮ፥ “ታኒ ህንተ ሼሻስ እማና ጋዳ አብራሃመስ፥ ይሳቃስነ ያይቆባስ፥ ጫቅዳ ቢታይ ሀይሳ። ሀእ ኔኒ ነ አይፈን በአና መላ ኦስ፥ ሽን ኔኒ ያ ፕናካ” ያግስ።<verse eid="DEU 34:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 34:5"/>ጎዳ አይለይ፥ ሙሰይ፥ ጎዳይ ግዳይሳዳ፥ ያን ሞአበ ቢታን ሀይቅስ። <verse eid="DEU 34:5"/><verse number="6" style="v" sid="DEU 34:6"/>ጎዳይ ቤት-ፓኦራ ካታማፐ ስን ባጋን ሞአበ ዛንጋራን እያ ሞግስ። ሽን ሀች ጋካናዉ እ ሞገትዳ ዱፉዋ ኤርያ አስ ባዋ። <verse eid="DEU 34:6"/><verse number="7" style="v" sid="DEU 34:7"/>ሙሰይ ሀይቅያ ዎደ እያዉ ላይ ፄታነ ላታማ፤ ሽን እያ አይፈይ እፅቤና፤ እያ ዎልቃይ ዳቡርቤና። <verse eid="DEU 34:7"/><verse number="8" style="v" sid="DEU 34:8"/>እስራኤለ አሳይ ሞአበ ደንባን ሀስታሙ ጋላስ ሙሰስ ዬክዶሶና። ሄሳፈ ጉየ፥ ባለይ ደንድን፥ ዬሆ ዎደይ ዉርስ።<verse eid="DEU 34:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 34:9"/>ሙሰይ፥ ባ በሳን ኦና መላ፥ እያ ቦላ ባ ኩሽያ ዎዳ ግሾ፥ ናወ ናአይ እያሱይ ጭንጫተ አያናን ኩምስ። እስራኤለ አሳይ እያሱስ ኪተትዶሶና፤ ጎዳይ ሙሰ ባጋራ እምዳ ኪታ ናግዶሶና።<verse eid="DEU 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 34:10"/>ጎዳ ሶምኦን ኦድስዳ፥ ሙሰ መላ ናበይ፥ እስራኤለ ቢታን ደንድቤና። <verse eid="DEU 34:10"/><verse number="11" style="v" sid="DEU 34:11"/>ጎዳይ ሙሰ ግብፀ ካዋኮ፥ እያራ ኦያ ሞርናታኮነ ኩመ አሳኮ የድድ፥ እያ ባጋራ ማላታታነ ማላልስያባታ ኡባ ኦዳ፥ ሙሰ መላ ሀራ ናበይ ኦንካ ባዋ። <verse eid="DEU 34:11"/><verse number="12" style="v" sid="DEU 34:12"/>እስራኤለ ኡባ ስንን ግታ ዎልቃን ማላልስያባ ኦዳ፥ ሙሰ መላ አስ ኦንካ ባዋ።<verse eid="DEU 34:12"/></para>
  <chapter eid="DEU 34"/>
</usx>
