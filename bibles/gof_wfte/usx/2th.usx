<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">2 ታሰሎንቀ ኪታ</para>
  <para style="toc1">2 ታሰሎንቀ ኪታ</para>
  <para style="toc3">2 ታሰ</para>
  <para style="toc2">2 ታሰሎንቀ</para>
  <para style="mt1">ጳዉሎስ ተሰሎንቀ አሳስ</para>
  <para style="mt2">ፃፍዳ ናምአን ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ክርስቶሳ ናምአን ዩሳ ቦላ ደንድዳ ኦይሾይ ፓላማ መዳ ግሾ፥ ተሰሎንቀ ዎሳ ኬን መቶይ ዳር ዳር ብስ። ጳዉሎስ ተሰሎንቀ አሳስ ፃፍዳ ናምአን ኪታይ፥ “ጎዳ ዩሳ ጋላሳይ ማትስ” ግያ አማኖ ትምርትያ ቦላ ምንድ ኦዴስ። ጳዉሎስ ኦድሸ፥ ክርስቶስ ያናፐ ስን፥ “ጌላ ኡራ” ጌተትያ “ክርስቶሳ እፀይስ ካለን፥ ሀ አላምያ ቦላ ኢታተነ ጌላተ ዳርሸ ባና” ያግድ ኤንታ አማኑዋ ሱርሴስ።</para>
  <para style="ip">ሀዋረይ፥ መቶይነ ዋየይ ዳርኮካ፥ ኤንቲ ባንታ አማኑዋን ምናናዳ፥ ባንታ ዱሳስ ኮሽያባ ደማናዉ ምንድ ኦና መላነ ሎኦ ኦሶ ኦናዉ ጉየ ጎና መላ ኤንታ ምንድ ዞሬስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ገሎ ቆፋ (<char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref></char>)</para>
  <para style="io1">ጎዳ ዩሳነ ሱረ ፕርዳ (<char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref></char>)</para>
  <para style="io1">ጎዳይ ያና (<char style="ior"><ref loc="2TH 2:1-12">2:1-12</ref></char>)</para>
  <para style="io1">አማነታዳ ደአ (<char style="ior"><ref loc="2TH 2:13-17">2:13-17</ref></char>)</para>
  <para style="io1">ዎስተ፤ ምንድ ኦተ (<char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref></char>)</para>
  <para style="io1">ሳሮነ አንጆ (<char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref></char>)</para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>ጳዉሎስ፥ ስላሰይነ ፅሞትዮስ ተሰሎንቀ ዎሳ ኬን ደእያ፥ ፆሳ አዋባነ ጎዳ የሱስ ክርስቶሳባ ግድዳ አሳስ ፃፈትዳ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 17:1">ሀዋ 17:1</ref>.</char></note><verse eid="2TH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2"/>ፆሳ ኑ አዋፐነ ጎዳ የሱስ ክርስቶሳፐ አ ኬሀተይነ ሳሮተይ ህንተዉ ግዶ።<verse eid="2TH 1:2"/></para>
  <para style="s1">ክርስቶስ ስምያ ዎደ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>ኑ እሻቶ፥ ህንተ አማኖይነ ህንተ እሶይ እሱዋነ ሀራታ ሲቅያ ሲቆይ ዳሮ ድጭያ ግሾ፥ ኑኒ ሄሳስ ፆሳ ኡባ ዎደ ጋላታናዉ በሴስ። <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>ህንተና ጋክዳ ጎዳንነ ዋየ ኡባን ገንጫንነ አማኖን ምንድ ኤቅዳ ግሾ፥ ኑኒ ኑ ሁጰን ፆሳ ዎሳ ኬታን ህንተባ ማርካትሸ ህንተናን ጬቀቶስ።<verse eid="2TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5"/>ህንተ እያ ግሾ ግድ መቶ ኤክያ ፆሳ ካዎተስ በሰይሳታ ግድድ ታይበታና መላ ፆሳ ፅሎ ፕርዳስ ሀይስ ማላ። <verse eid="2TH 1:5"/><verse number="6" style="v" sid="2TH 1:6"/>ፆሳይ ቱማ ፕርዳ ፕርዳና። ፆሳይ ህንተና ዋይሰይሳታ ቦላ ዋየ ኤሀና። <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>ጎዳይ የሱሲ ባ ዎልቃማ ኪታንቾታራ፥ ታማ ላጮራ ሳሎፐ ያ ዎደ ዋየትያ ህንተናነ ኑና ሸምፕሳና። <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>ቃስ ፆሳይ ባና ኤሮናይሳታነ ኑ ጎዳ የሱስ ክርስቶሳ ዎንገላስ ኪተቶናይሳታ ፕርዳና። <verse eid="2TH 1:8"/><verse number="9" style="v" sid="2TH 1:9"/>ኤንቲ ጎዳ ስንፈነ እያ ቦንቹዋ ዎልቃፈ ሻከትድ መርና ዩዋን ፕርደታና።<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="ISA 2:10">እሳ 2:10</ref>.</char></note> <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>ሄ ጋላስ፥ እ ባ ጌሻ አሳንነ ባና አማንያ ኡባን ቦንቸታናዉነ ሳበታናዉ ያ ዎደ ኑ ህንተዉ ኦድዳ ኪታ ህንተ አማንዳ ግሾ፥ ህንተ እያ ቦንቸይሳታ ግዶንነ ሳበይሳታ ግዶን ዳና።<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>ኑኒ ህንተዉ ኡባ ዎደ ፆሳ ዎሰይ ሄሳሳ። ኑ ፆሳይ ህንተና ፄግዳ ደኡዋስ በሰይሳታ ግድድ ታይበታና መላ ኑኒ ዎሶስ። ህንተ ሎኦባ ኦናዉ አሞትያ አሙዋነ ህንተ አማኖ ኦሱዋ እ ባ ዎልቃን ፖሎ። <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>ሄሳን ኑ ፆሳነ ኑ ጎዳ የሱስ ክርስቶሳ አ ኬሀተን፥ ጎዳ የሱሳ ሱን ህንተ ቦንቻና፤ ህንተናካ እ ቦንቻና።<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s1">ጌላ ኡራ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>ኑ እሻቶ፥ ኑ ጎዳ የሱስ ክርስቶሳ ዩሳባነ ኑ እያራ ጋሄታናዉ ሺቃናባስ ኑ ህንተና ዎሶስ።<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="ISA 2:10">እሳ 2:10</ref>.</char></note> <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>ትንብተን ዎይኮ ሀራ አሳፐ ስእዳ ቃላን ዎይኮ ኑፐ ኤክዳ ኪታዳ ኦድ፥ “ጎዳ ጋላሳይ ጋክስ” ግድ ህንተ ዎዛናይ ዳጋሞፎነ ዋባቆፖ። <verse eid="2TH 2:2"/><verse number="3" style="v" sid="2TH 2:3"/>ህንተና ኦንካ አይ ኦገንካ ባለፎ። ካሰትድ ጌላተይ ቆንጮናነ ዮይ በሲያ ጌላ ኡራይ ዮና ደእሽን፥ ጎዳ ጋላሳይ ጋከና። <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>አስ ጎይንያባነ ፆሳያባ ኡባ እ እፃናነ ባና ቁ ኦና። ሀር አቶሽን፥ ፆሳ ኬ ገል ኡትድ፥ “ታኒ ፆሰ” ጋና።<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="DAN 11:36">ዳነ 11:36</ref>፤ <ref loc="EZK 28:2">ህዝ 28:2</ref>.</char></note><verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>ታኒ ህንተራ ደአሸ ህንተዉ ኦድዳይሳ አኬከከቲ? <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>እ ባ ጋላሳን ያናፐ አትሽን፥ ሀእ ያናይሳ አይብ እያ ተቅያኮ ህንተ ኤሬታ።<verse eid="2TH 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2TH 2:7"/>አሳስ ቆንጭቦና ጌላተ ፁራ ዎልቃይ ሀእካ ኦስ፥ ሽን ሀእ እያ ተቀይስ ደኤስ። እያ ተቀይስ ኦገፐ ክቻና ጋካናዉ እ ቆንጨና። <verse eid="2TH 2:7"/><verse number="8" style="v" sid="2TH 2:8"/>ሄሳፈ ጉየ፥ ጌላ ኡራይ ቆንጫና፥ ሽን ጎዳ የሱሲ ባ ዶናፐ ከይያ ሸምፑዋን፥ ባ ቦንቾ ዩሳን እያ ዎና።<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 11:4">እሳ 11:4</ref>.</char></note> <verse eid="2TH 2:8"/><verse number="9" style="v" sid="2TH 2:9"/>ጌላ ኡራይ፥ ፃላሄ ዎልቃን ይድ ዎርዶ ማላታታነ ማላልስያባታ ኦና።<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="MAT 24:24">ማቶ 24:24</ref>.</char></note> <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>ሄሳዳካ፥ ዮስ ደእያ አሳታ ዱማ ዱማ ጭምያ ኢታ ኦሶን ባለና። ኤንቲ ይዳይ አሽያ ቱማ ዶስድ ኤኮና እፅዳ ግሾሳ። <verse eid="2TH 2:10"/><verse number="11" style="v" sid="2TH 2:11"/>ሄሳ ግሾ፥ ኤንቲ ዎርዶ ግድያባ አማናና መላ ፆሳይ ዎልቃማ ባለሶ ኤንታ ቦላ የዳና። <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>ሄስካ፥ ቱማ አማኖና አሳት፥ ናጋራ ኦሶን ኡፋይተይሳት ኡባይ ፕርደታና መላሳ።<verse eid="2TH 2:12"/></para>
  <para style="s1">አማንያ አስ ግዳ</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>ጎዳይ ዶስያ ኑ እሻቶ፥ ኑኒ ፆሳ ህንተ ግሾ፥ ኡባ ዎደ ጋላታናዉ በሴስ። ህንተ አታና መላ ፆሳይ ጌሻ አያና ዎልቃን ህንተና ጌሽዳይሳነ ህንተካ ቱማ አማንዳይሳን እ ህንተና ባይራዳ ዶርስ። <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>ፆሳይ፥ ኑ ህንተዉ ኦድዳ ዎንገላ ባጋራ ህንተና ፄግዳይ፥ ህንተ ኑ ጎዳ የሱስ ክርስቶሳራ እስፈ ቦንቸታናሳ። <verse eid="2TH 2:14"/><verse number="15" style="v" sid="2TH 2:15"/>ህዛ፥ ኑ እሻቶ፥ ምንድ ኤቅተ። ኑኒ ህንተና ኑ ዶናን ግድን ዎይኮ ዳብዳብያን ግድን ታማርስዳ ትምርትያ ኦይክተ።<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16-17" style="v" sid="2TH 2:16-17"/>ፆሳይ ኑ አዋይ ኑና ዶሴስ። እ ኑስ ኬሀ፤ እ መርና ምንነ ሎኦ ኡፋይሳ ኑስ እሚስ። ህንተ ኡባ ዎደ ሎኦባ ኦናዉነ ኦደታናዉ ምንና መላነ ማዳና መላ ኑ ጎዳ የሱስ ክርስቶሳነ ፆሳ ኑ አዋ ዎሶስ።<verse eid="2TH 2:16-17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s1">ኑስ ዎስተ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>ዉርሰን ኑ እሻቶ፥ ጎዳ ቃላይ ህንተ ግዶን ኤለስድ ዳልጋናዳነ ቦንቸታናዳ ኑስ ዎስተ። <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>ሄሳዳካ፥ አስ ኡባይ ቃላ ስእድ አማኖና ግሾ፥ ፆሳይ ጌላታፐነ ኢታ አሳታፐ ኑና አሻና መላ ኑስ ዎስተ።<verse eid="2TH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3"/>ሽን ጎዳይ አማነትዳይሳ፤ እ ህንተና ምንናነ ፃላሄፐ ናጋና። <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>ኑኒ ህንተና ኪተይሳ ሀእካ ስንፈካ ህንተ ኦናይሳስ ጎዳን ኑኒ አማነቶስ።<verse eid="2TH 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5"/>ጎዳይ ህንተ ዎዛና ፆሳ ሲቁዋኮነ ክርስቶሳ ዳንዳኣኮ ካለ።<verse eid="2TH 3:5"/></para>
  <para style="s1">ቦዞፕተ</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>ኑ እሻቶ፥ ህንተ ኑፐ ኤክዳ ኪታ ካሎናይሳታፐነ ኦሶ ብልያ አዛላ አማንያ አሳታፐ ህንተ ሻከታናዳ ጎዳ የሱስ ክርስቶሳ ሱንን ህንተና ኪቶስ። <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>ኑዳ ሀንድ ዳናዉ በሰይሳ ህንተ፥ ህንተ ሁጰን ኤሬታ። ኑኒ ህንተራ ደእያ ዎደ ኦሶ ብልቦኮ። <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>ኑኒ ኦደፈካ ካ መላ ምቦኮ። ኑስ ዳንዳኤትዳ መላ ቃማነ ጋላስ ኦ ዳቡርድ ደእዳፐ አትሽን፥ ኦደስካ ቶሆ ግድቦኮ። <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>ኑኒ ሄሳ ኦዳይ፥ ህንተዉ ሌምሶ ግዳናሳፈ አትሽን፥ ህንተፈ ማደ ኦይቻናዉ ኑስ ማት ይና ግደና። <verse eid="2TH 3:9"/><verse number="10" style="v" sid="2TH 3:10"/>ኑ ህንተራ ደእያ ዎደካ፥ “ኦናዉ ኮዮና አስ ኦንካ ሞፖ” ያግድ ኪትዳ።<verse eid="2TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11"/>ኑኒ ሄሳ ግዳይ፥ ህንተ ግዶን እስ እስ አዛላት ደኤይሳ ስእዳ ግሾሳ። ሄ አሳት ገልሶናባን ገልድ ሀራታ ኦሶ ብልሶሶናፐ አትሽን፥ አይኮካ ኦኮና። <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>ኑኒ ሄሳ መላ አሳት ማራ ደኦ ዳናዳነ ባንታና ኮሽያባ ኦድ ደማናዳ ጎዳ የሱስ ክርስቶሳ ሱንን ኤንታ ኪቶስነ ዞሮስ።<verse eid="2TH 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13"/>ሽን ኑ እሻቶ፥ ሎኦ ኦሶ ኦናዉ አዛሎፍተ። <verse eid="2TH 3:13"/><verse number="14" style="v" sid="2TH 3:14"/>ሀእ ኑኒ ሀ ዳብዳብያን ኪትዳ ኪታስ ኪተቶና አስ ኦንካ ደእኮ ሄ ኡራ ኤርተ። እ ዬላታና መላ እያፐ ሻከትተ። <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>ሽን እያ እሻዳ ሴርተፐ አትሽን፥ ሞርከዳ ፄሎፍተ።<verse eid="2TH 3:15"/></para>
  <para style="s1">ሳሮ</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>ሳሮ እምያ ጎዳይ፥ ባ ሁጰን ህንተዉ ኡባ ዎደነ ኡባ ባጋራ ሳሮ እሞ። ጎዳይ ህንተ ኡባራ ግዶ።<verse eid="2TH 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17"/>ታኒ ጳዉሎስ፥ ሀ ኪታ ታ ኩሸን ፃፋስ። ታ ኪታ ኡባስ ማላይ ሀይሳ፤ ታኒ ሄሳዳ ፃፋይስ።<verse eid="2TH 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18"/>ኑ ጎዳ የሱስ ክርስቶሳ አ ኬሀተይ ህንተ ኡባራ ግዶ።<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
