<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2KI" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">2 ካዎታ ማፃፋ</para>
  <para style="toc1">2 ካዎታ ማፃፋ</para>
  <para style="toc3">2 ካዎ</para>
  <para style="toc2">2 ካዎታ</para>
  <para style="mt">2 ካዎታ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ናምአን ካዎታ ማፃፋይ፥ 1 ካዎታ ማፃፋፔነ ሳሜላ ማፃፋፔ ካልድ ፃፈትዳ ማፃፋ። ሀ ማፃፋን ኤልሳነ ኤልያሳ ታርከይ ዳሮ ቆንጭድ ፃፈትስ። ሀ ማፃፋይ፥ ይሁዳ ታርከ ዳርስድ ኦድኮካ፥ እስራኤለይ ኩመ ያና ጋካናዉ ይሁዳነ እስራኤለ ካዎታ ታርከ አ አ ደንድ ኦዴስ።</para>
  <para style="ip">2 ካዎታ ማፃፋ ናምኡ ዋና ዋና ክፍለታን ሻክድ በአናዉ ዳንዳኤቴስ።</para>
  <para style="ipi">1. ክርስቶስ የለታናፐ ስን 900 ላይ ባጋፈ ዶምድ፥ ክርስቶስ የለተናፐ ስን 722 ላይን ፑደሀ ባጋ ካዎተይ ኩንዳና ጋካናዉ ደእያ ናምኡ ካዎተታ ታርከ (ሸም 1-17)።</para>
  <para style="ipi">2. እስራኤለ ካዎተ ኩንደፔ ብድ፥ ክርስቶስ የለታናፔ ስን 586 ላይን ካዎይ ናቡካዳናፆሬይ የሩሳላመ ካታማ ኦይክድ ይስዳ ዎደ ጋካናዉ ደእያ ይሁዳ ካዎተ ታርከ (ሸም 18-25)።</para>
  <para style="ip">ሀ ዮ ኡባይ እስራኤለ ቦላ ይዳ ጋሶይ፥ ይሁዲነ እስራኤለ አሳይ ሄሳዳካ ኤንታ ካዎት ፆሳስ አማነተ አግዳ ግሾሳ። የሩሳላመ ካታማይ ላለትዳይነ ይሁዳ አሳፐ ዳሮ ባጋይ ባንታ ቢታፈ በትዳይ ሄሳ ጋሶና።</para>
  <para style="imq">“ጎዳይ ሀንቀትዳ ግሾ፥ የሩሳላመ አሳ ቦላነ ይሁዳ አሳ ቦላ ሀይስ ሀንስ፤ ዉርሰን እ፥ ኤንታ ባ ስንፈ ድግስ።”</para>
  <para style="ip">2 ካዎታ ማፃፋ ዳሮ ኤረትዳ ናበይ፥ ኤልያሳ በሳን ደንድዳ ኤልሳ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ኤልያስ እስራኤለ ካዋ አካዛ ቦርስ (<char style="ior"><ref loc="2KI 1:1-18">1:1-18</ref></char>)</para>
  <para style="io1">ናብያ ኤልሳ (<char style="ior"><ref loc="2KI 2:1-8:15">2:1—8:15</ref></char>)</para>
  <para style="io1">ይሁዳነ እስራኤለ ካዎታ (<char style="ior"><ref loc="2KI 8:16-16:20">8:16—16:20</ref></char>)</para>
  <para style="io1">እስራኤለ ካዋ ሆሰነ ፑደሀ ካዎተ ኩንደ (<char style="ior"><ref loc="2KI 17:1-41">17:1-41</ref></char>)</para>
  <para style="io1">ይሁዳ ካዋ ህዝቅያሳነ አሶረ ኦይከተ (<char style="ior"><ref loc="2KI 18:1-20:21">18:1—20:21</ref></char>)</para>
  <para style="io1">ኢታ ግድዳ ይሁዳ ካዎ ምናሰነ አሞፀ (<char style="ior"><ref loc="2KI 21:1-26">21:1-26</ref></char>)</para>
  <para style="io1">እዮስያሳ አይሱዋነ ህገ ማፃፋ (<char style="ior"><ref loc="2KI 22:1-23:30">22:1—23:30</ref></char>)</para>
  <para style="io1">ዉርሰ ይሁዳ ካዎታ (<char style="ior"><ref loc="2KI 23:31-24:20">23:31—24:20</ref></char>)</para>
  <para style="io1">ባብሎነ ድኡዋነ የሩሳላመ ኩንደ (<char style="ior"><ref loc="2KI 25:1-30">25:1-30</ref></char>)</para>
  <chapter number="1" style="c" sid="2KI 1"/>
  <para style="s1">ኤልያሳነ ካዋ አካዝያሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 1:1"/>አካብ ሀይቅዳፐ ጉየ፥ ሞአበ አሳይ እስራኤለ ቦላ ደንድዶሶና።<verse eid="2KI 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 1:2"/>ሄ ዎደ ካዎይ አካዝያስ ሳማረ ካታማ ቦላ ደእያ ፖቅያ ባራንዳፈ ኩንድድ ደሸትስ። ሄሳ ግሾ አሳታኮ፥ “ብድ፥ ታኒ ሀ ሀርግያፈ ፓፃነኮ ፓፆናኮ ኤቅሮና ፆሳ ብኤል-ዘቡላ አነ ኦይችተ” ያግድ ኪትስ።<verse eid="2KI 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 1:3"/>ሽን ጎዳ ኪታንቾይ ተስባ አድያ ኤልያሳ ሀይሳዳ ያግስ፤ “ፑደ ባዳ፥ ሳማረ ካዎይ ኪትዳ አሳታራ ጋሄታዳ፥ ‘ህንተ ኤቅሮና ፆሳ ብኤል-ዘቡላ ኦይቻናዉ ብዳይ፥ እስራኤለን ፆሲ ይነዬ?’ <verse eid="2KI 1:3"/><verse number="4" style="v" sid="2KI 1:4"/>ጎዳይ ሀይሳዳ ያጌስ፤ ‘ካዋዉ፥ ኔኒ ሀይቃናፐ አትሽን፥ ሀ ዝንእዳ ሂፃፐ ደንዳካ’ ያጌስ” ያጋ። ሄሳ ግሾ፥ ኤልያስ ብድ ኤንታዉ ኦድስ።<verse eid="2KI 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 1:5"/>ኪተትዳ አሳት ካዋኮ ጉየ ስምን፥ “አይስ ስምደቲ?” ያግድ ኤንታ ኦይችስ።<verse eid="2KI 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 1:6"/>ኤንቲ፥ “እስ አደይ ኑራ ጋሄታናዉ ይድ፥ ህንተና ኪትዳ ካዋኮ ስሚድ፥ ሀይሳዳ ያግድ ኦድተ። ጎዳይ ኔኮ፥ ‘ኤቅሮና ፆሳ ብኤል-ዘቡላ ኦይቻናዉ ኔኒ አሰ ኪተይ፥ እስራኤለን ፆሲ ይነዬ? ሄሳ ግሾ፥ ኔኒ ሀይቃናፐ አትሽን፥ ሀ ዝንእዳ ሂፃፐ ደንዳካ’ ያጌስ” ያግዶሶና።<verse eid="2KI 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 1:7"/>ካዎይ፥ “ህንተራ ጋሄታናዉ ይድ፥ ሀይሳ ህንተዉ ኦድዳ አደይ አይ መላ አሴ?” ያግድ ኦይችስ።<verse eid="2KI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 1:8"/>ኤንቲ፥ “እክሰፐ ኦሰትዳ ማኦ ማእድ፥ ባ ፄሳን ዳፎ ዳንጬስ” ያግድ ዛርዶሶና።</para>
  <para style="p" vid="2KI 1:8">ካዎይ፥ “ሄስ ተስባ አድያ ኤልያሳ” ያግስ።<verse eid="2KI 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 1:9"/>ሄሳፈ ጉየ፥ ካዎይ እስ ቶራ ሞጮና እሻታሙ ዎታዳረታራ ኪትስ። ቶራ ሞጭናይ ደረ ሁጰን ኡትዳ ኤልያሳኮ ከይድ፥ “ፆሳ አሶ፥ ካዎይ ነና፥ ዱገ ዎዳ ሃያ” ያጌስ።<verse eid="2KI 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 1:10"/>ሽን ኤልያስ ቶራ ሞጮናኮ፥ “ታኒ ፆሳ አስ ግድኮ፥ ታም ሳሎፐ ዎድ፥ ነናነ ነ ዎታዳረታ ሞ” ያግድ ዛርስ። ታም ሳሎፐ ዎድ፥ እያነ እያ ዎታዳረታ ምስ።<verse eid="2KI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 1:11"/>ካዎይ ሀራ ቶራ ሞጮና እሻታሙ ዎታዳረታራ ኤልያሳኮ ኪትስ። ቶራ ሞጮናይ ኤልያሳኮ፥ “ፆሳ አሶ፥ ካዎይ ነና ዱገ ዎዳ ሃያ” ያጌስ።<verse eid="2KI 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 1:12"/>ኤልያስ፥ “ታኒ ፆሳ አስ ግድኮ፥ ታም ሳሎፐ ዎድ፥ ነናነ ነ ዎታዳረታ ሞ” ያግስ። ፆሳ ታም ሳሎፐ ዎድ፥ እያነ እያ ዎታዳረታ ምስ።<verse eid="2KI 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 1:13"/>ካዎይ ሄን ሀራ ቶራ ሞጮና እሻታሙ ዎታዳረታራ ኤልያሳኮ ኪትስ። ቶራ ሞጮናይ ኤልያሳኮ ብድ፥ እያ ስንን ጉልባትድ፥ “ፆሳ አሶ፥ ሀያና ታውነ ታራ ደእያ አሳስ ቃታ፤ ኑ ሸምፑዋ ሀይቆፐ አሻ። <verse eid="2KI 1:13"/><verse number="14" style="v" sid="2KI 1:14"/>ሄኮ፥ ታም ሳሎፐ ዎድ፥ ካሰ ናምኡ ቶራ ሞጮናታነ ኤንታ ዎታዳረታ ምስ። ሽን ሀእ ታዉ ቃታ!” ያግድ ዎስስ።<verse eid="2KI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 1:15"/>ጎዳ ኪታንቾይ ኤልያሳኮ፥ “ያዮፋ! እያራ ዱገ ዎ” ያግስ።</para>
  <para style="p" vid="2KI 1:15">ኤልያስ ደንድድ፥ እያራ ካዋኮ ዱገ ብስ። <verse eid="2KI 1:15"/><verse number="16" style="v" sid="2KI 1:16"/>“ጎዳይ ሀይሳዳ ያጌስ፤ ‘እስራኤለን ፆሲ ይነ፥ ኔኒ ኤቅሮና ፆሳ ብኤል-ዘቡላ ኦይቻናዉ አሰ ኪትዳይ? ኔኒ ሀይሳ ኦዳ ግሾ፥ ሀይቃና! ነ ዝንእዳ ሂፃፐ ደንዳካ’ ” ያጌስ።<verse eid="2KI 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 1:17"/>ኤልያስ ኦድዳ ፆሳ ቃላዳ አካዝያስ ሀይቅስ፤ አካዝያሳስ አደ ናእ ባይና ግሾ፥ እያ እሻይ እዮራም እያ በሳን ካዎትስ። ሄስ ሀንዳይ እዮሳፈፃ ናአይ እዮራም ይሁዳን ካዎትዳ ናምአን ላይና። <verse eid="2KI 1:17"/><verse number="18" style="v" sid="2KI 1:18"/>አካዝያስ ኦዳ ሀራባ ኡባይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትድ ደኤስ።<verse eid="2KI 1:18"/></para>
  <chapter eid="2KI 1"/>
  <chapter number="2" style="c" sid="2KI 2"/>
  <para style="s1">ኤልያስ ሳሎ ኤከትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 2:1"/>ጎዳይ ኤልያሳ ጎተን ሳሎ ኤፋናዉ ሀንያ ዎደ፥ ኤልያስነ ኤልስ ጋልጋላፐ ደንድድ ብዶሶና። <verse eid="2KI 2:1"/><verse number="2" style="v" sid="2KI 2:2"/>ኤልያስ ኤልሳኮ፥ “ጎዳይ ታና ቤተለ ኪትዳ ግሾ፥ ሀያና ኔኒ ሀይሳን ጋምኣሻ” ያግስ።</para>
  <para style="p" vid="2KI 2:2">ሽን ኤልስ፥ “ጎዳይ ኤርያ መላ፥ ነ ሸምፖይ ኤሮ! ታኒ ኔፐ ሻከትከ” ያግስ። ኤንቲ ዱገ ቤተለ ዎዶሶና።<verse eid="2KI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 2:3"/>ቤተለን ደእያ ናበታ ጩጋይ ኤልሳኮ ከይድ፥ “ጎዳይ ሀች ነ ጎዳ ኔፐ ሻክድ ኤፋና ሀነይሳ ኤራይ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="2KI 2:3">ኤልስ፥ “ኤ ኤራይስ፤ ሽን ህንተ ስእ ጊተ” ያግድ ዛርስ።<verse eid="2KI 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 2:4"/>ኤልያስ ኤልሳኮ፥ “ጎዳይ ታና እያርኮ ኪትዳ ግሾ፥ ሀያና ኔኒ ሀይሳን ጋምኣሻ” ያግስ።</para>
  <para style="p" vid="2KI 2:4">ሽን ኤልስ፥ “ጎዳይ ኤርያ መላ፥ ነ ሸምፖይ ኤሮ! ታኒ ኔፐ ሻከትከ” ያግድ ዛርስ። ሄሳ ግሾ፥ ኤንቲ እያርኮ ብዶሶና።<verse eid="2KI 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 2:5"/>እያርኮን ደእያ ናበታ ጩጋይ ኤልሳኮ ከይድ፥ “ጎዳይ ሀች ነ ጎዳ ኔፐ ሻክድ ኤፋና ሀነይሳ ኤራይ?” ያግድ ኦይችዶሶና።</para>
  <para style="p" vid="2KI 2:5">እ፥ “ኤ ኤራይስ፤ ሽን ህንተ ስእ ጊተ” ያግድ ዛርስ።<verse eid="2KI 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 2:6"/>ኤልያስ ኤልሳኮ፥ “ጎዳይ ታና ዮርዳኖሰ ሻፋ ኪትዳ ግሾ፥ ሀያና ኔኒ ሀይሳን ጋምኣሻ” ያግስ።</para>
  <para style="p" vid="2KI 2:6">ኤልስ፥ “ጎዳይ ኤርያ መላ፥ ነ ሸምፖይ ኤሮ! ታኒ ኔፐ ሻከትከ” ያግስ። ኤንቲ ናምአይ እስፈ ብዶሶና።<verse eid="2KI 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 2:7"/>ናበታፐ እሻታሙ አሳት ኤንታ ካልድ፥ ዮርዳኖሰ ሻፋ ጋካናዉ ብዶሶና። ኤልያስነ ኤልስ ሻፋ ዶናን ኤቅዳሽን፥ ናበት ኤንታፈ ጉ ሃክድ ኤቅዶሶና። <verse eid="2KI 2:7"/><verse number="8" style="v" sid="2KI 2:8"/>ሄ ዎደ ኤልያስ ባ አፍላ ኤክድ ፃፅድ፥ እያራ ሃ ሾጭን፥ ሃይ ያነ ሃነ ሻከትን መላ ቢታራ ፕንዶሶና። <verse eid="2KI 2:8"/><verse number="9" style="v" sid="2KI 2:9"/>ኤልያስ ኤልሳኮ፥ “ታኒ ኔፐ ኤከታናፐ ስን፥ ነዉ አይ ኦና መላ ኮያይ?” ያግስ።</para>
  <para style="p" vid="2KI 2:9">ኤልስ፥ “ነ አያናይ ታ ቦላ ናምኡ ኩሸ ግዳና መላ፥ ታኒ ነና ዎሳይስ” ያግድ ዛርስ።<verse eid="2KI 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 2:10"/>ኤልያስ፥ “ኔኒ ዋይስያ ኦይሾ ኦይቻዳሳ። ሽን ታኒ ኔፐ ኤከትያ ዎደ ኔኒ ታና ፄልያባ ግድኮ፥ ሄስ ነዉ ሀናና። ነ በኦና እፅኮ ሀነና” ያግስ።<verse eid="2KI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 2:11"/>ኤንቲ እስፈ ኦደትሸ ሄመትሽን፥ ታማ ፓራትነ ታማ ጋረት ኤንታ ናምኣፈ ግዶን ገልድ፥ ሻክስ። ኤልያስ ጎተን ሳሎ ከይስ። <verse eid="2KI 2:11"/><verse number="12" style="v" sid="2KI 2:12"/>ኤልስ ሄሳ በእድ፥ “ታ አዋዉ፥ ታ አዋዉ! እስራኤለ ፓራቶነ ፓራ ጋረቶ!” ያግድ ዋስስ። ሄሳፈ ስምን፥ እ ኤልያሳ ዛሪድ በእቤና።</para>
  <para style="p" vid="2KI 2:12">ኤልስ አዛንድ፥ ባ ማኡዋ ናምአ ከስድ፥ ዳክስ። <verse eid="2KI 2:12"/><verse number="13" style="v" sid="2KI 2:13"/>ኤልያሳፐ ዎዳ ማኡዋ ደንድ፥ ጉየ ስሚድ፥ ዮርዳኖሰ ሻፋ ዶናን ኤቅስ። <verse eid="2KI 2:13"/><verse number="14" style="v" sid="2KI 2:14"/>ኤልያሳፐ ዎዳ ማኡዋ ኤክድ፥ እያራ ሃ ሾጭድ፥ “ጎዳይ ኤልያሳ ፆሳይ አዉን ደኢ?” ያግስ። ኤልስ ሃ ሾጭዳ ዎደ፥ ሃይ ያነ ሃነ ሻከትን፥ ሻፋ ፕንስ።<verse eid="2KI 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 2:15"/>እያርኮ ይዳ ናበታ ጩጋይ ኤልሳ በእዳ ዎደ፥ “ኤልያሳ አያናይ ኤልሳ ቦላ ሸምፕስ” ያግዶሶና። ኤንቲ እያራ ጋሄታናዉ ይድ፥ እያ ስንን ጉፋንዶሶና። <verse eid="2KI 2:15"/><verse number="16" style="v" sid="2KI 2:16"/>ኤንቲ፥ “ኑኒ ነ አይለት እሻታሙ ምኖ አሳት ሀይሳን ደኦስ። ሀያና ኑኒ ነ ጎዳ ኮያናዉ ባና። ኦን ኤር፥ ጎዳ አያናይ እያ ኤክድ፥ እስ ዙማ ሁጰን ዎይኮ ዛንጋራ ግዶን የጎና አገና” ያግዶሶና።</para>
  <para style="p" vid="2KI 2:16">ኤልስ፥ “አካይ፥ ቦፕተ” ያግስ። <verse eid="2KI 2:16"/><verse number="17" style="v" sid="2KI 2:17"/>ሽን አካይ ጉሳይ እያ ዬላያና ጋካናዉ፥ ኤንቲ እያ ዎስድ አጎና እፅን፥ “ቢተ” ያግስ። ኤንቲ እሻታማይ ብድ ሄ ጋላስ ኩመ ኮይድ፥ እያ ደምቦኮና። <verse eid="2KI 2:17"/><verse number="18" style="v" sid="2KI 2:18"/>ኤልስ እያርኮን ደእሽን፥ ኤንቲ እያኮ ስሚድ ይዶሶና። እ፥ “ታኒ ህንተና ‘ቦፕተ’ ያጋብክና?” ያግስ።<verse eid="2KI 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 2:19"/>ሄሳፈ ጉየ፥ እያርኮን ደእያ አሳት ኤልሳ፥ “ኔኒ ኑ ጎዳይ በኤይሳዳ ሀ ካታማይ ዱሳስ ሎኦ። ሽን ሃይ ኢታ፤ ቃስ ቢታይካ አይፈና” ያግዶሶና።<verse eid="2KI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 2:20"/>እ፥ “አነ ኦራ ከረን ማፅነ የግድ፥ ኤክ ዪተ” ያግድ ኪትን፥ እያዉ ኤህዶሶና። <verse eid="2KI 2:20"/><verse number="21" style="v" sid="2KI 2:21"/>ኤልስ ፑልቱዋኮ ብድ፥ ማፅንያ እያን የግድ፥ “ጎዳይ፥ ‘ታኒ ሀ ሃ ፓስ፤ ህዛፐ ሀ ሃይ ሀይቆስ ጋሶ ግደና፤ ቢታይካ አይፋና’ ያጌስ” ያግስ። <verse eid="2KI 2:21"/><verse number="22" style="v" sid="2KI 2:22"/>ኤልስ ኦድዳይሳዳ ሀች ጋካናዉ፥ ሄ ሃይ ፅሎ ግድስ።<verse eid="2KI 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 2:23"/>ኤልስ ያፐ ደንድድ፥ ፑደ ቤተለ ከይስ። እ ኦገ ቦላ ደእሽን፥ ያላጋ አደ ናይት ካታማፐ ከይድ፥ “ላ ሀ ቦአዉ፥ ከያ! ላ ሀ ቦአዉ፥ ከያ” ያግድ እያ ቀልቅስዶሶና።<verse eid="2KI 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 2:24"/>ኤልስ ጉየ ስም ፄልድ፥ ኤንታ ጎዳ ሱንን ባድስ። ያትን፥ ናምኡ ማጫ ባባንት ከይድ፥ ናይታፐ ኦይታማነ ናምኡ ያላጋታ ፑዘረድ ዎዶሶና።<figure style="fig" alt="Bear" file="LB00048B.tif" size="col" ref="2:24">ባባን </figure> <verse eid="2KI 2:24"/><verse number="25" style="v" sid="2KI 2:25"/>ኤልስ ያፐ ደንድድ፥ ቃርመሎሳ ዙማ ቦላ ከይስ፤ ያፐ ቃስ ሳማረ ስምስ።<verse eid="2KI 2:25"/></para>
  <chapter eid="2KI 2"/>
  <chapter number="3" style="c" sid="2KI 3"/>
  <para style="s1">ሞአበይ እስራኤለ ቦላ ደንድስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 3:1"/>ይሁዳ ካዎይ እዮሳፈፅ ካዎትዳ ታማነ ሆስፑን ላይን፥ አካባ ናአይ እዮራም ሳማረን እስራኤለ ቦላ ካዎትስ፤ እ ታማነ ናምኡ ላይ ካዎትስ። <verse eid="2KI 3:1"/><verse number="2" style="v" sid="2KI 3:2"/>እ፥ ጎዳ ስንን ኢታባ ኦስ። ሽን ባ አዋነ ባ አየ ኤልዛቤል መላ ኢታ ግደና፤ እያ አዋይ ኦዳ ባኣለ ኤቃ ድግስ። <verse eid="2KI 3:2"/><verse number="3" style="v" sid="2KI 3:3"/>ናባፃ ናአይ እዮርባም እስራኤለ አሳ ኦስስዳ ናጋራን ኦይከትስ፤ እያፐ ሃክቤና።<verse eid="2KI 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 3:4"/>ሞአበ ካዎይ ሞስ ዶርሰ ሄምያ አስ። እ እስራኤለ ካዋስ 100,000 አንቃራ ዶርሳታነ 100,000 ኡርገ ዶርሳታ እክስያ ላይን ላይን ጊሬስ። <verse eid="2KI 3:4"/><verse number="5" style="v" sid="2KI 3:5"/>ሽን እስራኤለ ካዎይ አካብ ሀይቅዳፐ ጉየ፥ ሞአበ ካዎይ ሞስ እስራኤለ ቦላ ማካልስ።<verse eid="2KI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 3:6"/>ሄ ዎደ ካዎይ እዮራም ሳማረ ከይድ፥ እስራኤለ ኡባ ሺሽስ። <verse eid="2KI 3:6"/><verse number="7" style="v" sid="2KI 3:7"/>ይሁዳ ካዋ እዮሳፈፅ ኪታ የድድ፥ “ሞአበ ካዎይ ታ ቦላ ማካልስ፤ ሞአበራ ኦለታናዉ ኔኒ ታራ ባኔ?” ያግስ።</para>
  <para style="p" vid="2KI 3:7">እዮሳፈፅ፥ “ኤ ባና፤ ታኒ ነና፤ ታ አሳይ ነ አሰ፤ ታ ፓራይ ነ ፓራ ያግድ” ዛርስ። <verse eid="2KI 3:7"/><verse number="8" style="v" sid="2KI 3:8"/>እዮሳፈፅ፥ “ኑኒ አዉራ ብድ ኤንታ ኦላኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 3:8">ካዋ እዮራም፥ “ኤዶመ መላ ቢታ ኦግያራ ካን ብድ ኦላና” ያግድ ዛርስ።<verse eid="2KI 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 3:9"/>ሄሳ ግሾ፥ እስራኤለ ካዎይ፥ ይሁዳ ካዎይነ ኤዶመ ካዎይ ኦላስ ከይዶሶና። ኤንቲ ላፑን ጋላሳ ኦገ ዩይድ ብዳፐ ጉየ፥ ኦላንቾታስነ ኤንታ መህያስ አይብ ሃ አትቤና። <verse eid="2KI 3:9"/><verse number="10" style="v" sid="2KI 3:10"/>ሄ ዎደ እስራኤለ ካዎይ፥ “ጎዳይ ኑና ሀ ሄ ካዎታ እስፈ ሞአበ ካዋስ አድ እማናዉ ፄግዳ ግሾ ኑና አየ!” ያግስ። <verse eid="2KI 3:10"/><verse number="11" style="v" sid="2KI 3:11"/>ሽን እዮሳፈፅ፥ “ኑኒ እያ ባጋራ ጎዳ ኦይቻናዉ ሀይሳን ናበይ ባዌ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 3:11">እስራኤለ ካዋ ቶራ ሞጮናታፐ እሶይ፥ “ኤልያሳ ኩሸን ሃ ቆልያ ሳፋፃ ናአይ ኤልስ ሀይሳን ደኤስ” ያግድ ዛርስ። <verse eid="2KI 3:11"/><verse number="12" style="v" sid="2KI 3:12"/>እዮሳፈፅ፥ “ኤ፥ እ ቱማ ናበ” ያግስ። እስራኤለ ካዎይ፥ እዮሳፈፅ፥ ኤዶመ ካዎይነ ኤልሳኮ ብዶሶና።<verse eid="2KI 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 3:13"/>ኤልስ እስራኤለ ካዋኮ፥ “ታናነ ነና ጋይ አይቤ? ባዳ ነ አዋይነ ነ አይያ ኦይችዳ ናበታ ኦይቻ” ያግስ።</para>
  <para style="p" vid="2KI 3:13">እስራኤለ ካዎይ ዛሪድ፥ “አካይ፥ ሀ ሄ ካዎታ እስፈ ሞአበ ካዋስ አድ እማናዉ ኑና ፄግዳይ ጎዳባይ!” ያግስ።<verse eid="2KI 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 3:14"/>ኤልስ፥ “ታኒ እያዉ ኦያ ደኦ ጎዳይ ኤሮ! ይሁዳ ካዋ እዮሳፈፃ ግሾ ጎናኮ ታኒ ነና አይፈንካ ፄልከሽን። <verse eid="2KI 3:14"/><verse number="15" style="v" sid="2KI 3:15"/>አነ ሀእ ታዉ ዲ ዲፅያ አስ ኤህተ” ያግስ።</para>
  <para style="p" vid="2KI 3:15">ዲፀይስ ዲፅሽን፥ ጎዳ ዎልቃይ እያ ቦላ ዎስ። <verse eid="2KI 3:15"/><verse number="16" style="v" sid="2KI 3:16"/>ኤልስ፥ “ሀ መላ ዛንጋራ ኡባን ኦላ ቦክተ። <verse eid="2KI 3:16"/><verse number="17" style="v" sid="2KI 3:17"/>ጎዳይ፥ ‘ጫርኮ ዎይኮ እራ በኤከታ፥ ሽን ሀ ቦክዳ ዛንጋራን ሃ ኩማና፤ ህንተ፥ ህንተ መሄይነ ህንተ ጫና መሄይ ኡያና’ ያጌስ። <verse eid="2KI 3:17"/><verse number="18" style="v" sid="2KI 3:18"/>ሀይስ ፆሳ ስንን ላፋባ፤ ቃስ እ ሞአበ ህንተዉ አድ እማና። <verse eid="2KI 3:18"/><verse number="19" style="v" sid="2KI 3:19"/>ግምበትዳ ካታማታነ ግታ ካታማታ ኡባ ህንተ ፆናና። ሎኦ ምታ ኡባ ቃንፃና፤ ሃ ፑልቶታ ኡባ ህንተ ባራና፤ አራዳ ሾቃታ ኡባ ኢስድ ሹች ኩምዳ ቢታ ኦና” ያግስ።<verse eid="2KI 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 3:20"/>ዎንተ ጋላስ ዎንታ ያርሾ ያርሽያ ዎደይ ጋክን፥ ኤዶመ ባጋራ ሃ ጎግድ፥ ቢታን ኤልስ።<verse eid="2KI 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 3:21"/>ሞአበ አሳይ፥ ሄ ካዎት ኤንታ ኦላናዉ ይዳይሳ ስእድ፥ ናአተ፥ ጭም፥ ኦላ ሚሸ ቶካናዉ ዳንዳእያ አሳ ኡባይ ፄገትድ፥ ባንታ ቢታ ዛዋ ናግዶሶና። <verse eid="2KI 3:21"/><verse number="22" style="v" sid="2KI 3:22"/>ኤንቲ ጉራ ደንድያ ዎደ ሃ ቦላ ዎዳ ፃልቀይ ዞእድ፥ ኤንታዉ ሱ ዳንድ በንትስ። <verse eid="2KI 3:22"/><verse number="23" style="v" sid="2KI 3:23"/>ኤንቲ፥ “ሀይሳ ሱ በእተ! ካዎት ባንታ ግዶን እሶይ እሱዋራ ኦለትድ፥ ሀይቅ ዉርዶሶና። ሞአበ ብድ፥ አነ ኤንታ ሚፃ ቆጭሮስ” ያግዶሶና።<verse eid="2KI 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 3:24"/>ሞአበ አሳይ እስራኤለ ሚፃ ብን፥ እስራኤለት ደንድድ፥ ኤንታ ሾጭዶሶና። ሾጭድ ኤንታ ቢታ ኦይክድ፥ ሞአበ አሳ ዎዶሶና። <verse eid="2KI 3:24"/><verse number="25" style="v" sid="2KI 3:25"/>ካታማታ ኦልድ ይስዶስና። አሳ ኡባይ ሁጰን ሁጰን እስ እስ ሹቹ ኤክድ፥ አራዳ ሾቃት ኡባይ ካመታና ጋካናዉ፥ ኤንታ ቦላ ሆልዶሶና። ፑልቶ ኡባ ባርድ፥ ሎኦ ም ኡባ ቃንፅዶሶና። ቅር-ሄሬሰራ ካታማ ግምብያ ፃላል አትስ፤ ሽን ያምባርሻን ኦልያ አሳት ሄ ካታማ ሾጭዶሶና።<verse eid="2KI 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 3:26"/>ሞአበ ካዎይ ኦላይ ባ ቦላ ጎብዳይሳ በእዳ ዎደ ማሻ ዳንጭዳ ላፑን ፄቱ አሳታ ኤክስ። ኦላ ግዱዋ ዳክድ፥ ኤዶመ ካዋኮ ፕናናዉ ደንድስ፤ ሽን እያዉ ሀኖና እፅስ። <verse eid="2KI 3:26"/><verse number="27" style="v" sid="2KI 3:27"/>ሄሳፈ ጉየ፥ ባ በሳን ካዎታናዉ ደእያ ባ ባይራ ናኣ ኤክድ፥ ካታማ ግምብያ ቦላ ታማን ፁግድ ያርሽስ። ሞአበት እስራኤለታ ቦላ ሀንቆ ሱልዶሶና። እስራኤለት ሄ ካታማ አግድ፥ ባንታ ቢታ ስምዶሶና።<verse eid="2KI 3:27"/></para>
  <chapter eid="2KI 3"/>
  <chapter number="4" style="c" sid="2KI 4"/>
  <para style="s1">አምኤ ዛይተ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 4:1"/>ናበታፐ እሱዋ ማችያ ኤልሳኮ ባዳ፥ “ነ አይለይ፥ ታ አዝናይ ሀይቅስ። እ ጎዳ ያይያ አስ ግደይሳ ኔኒ ኤራሳ። ሽን ሀእ እያ አጮ አዋይ ታ ናይታ ናምአ ባዉ አይለ ኦናዉ ኮዬስ” ያጋዳ እያዉ ኦዳሱ።<verse eid="2KI 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 4:2"/>ኤልስ፥ “ያትን ታኒ ነዉ አይ ኦ? ነ ሶን አይበ ደኤይ? አነ ታዉ ኦዳ” ያግስ።</para>
  <para style="p" vid="2KI 4:2">ማጫስያ፥ “ታዉ፥ ነ አይሌስ ጉ ፃሮን ደእያ ዛይተፐ አትሽን፥ ሀራባይ አይብካ ባዋ” ያጋሱ።<verse eid="2KI 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 4:3"/>ኤልስ፥ “ባዳ ነ ሾሮታ ኡባፈ ካይሳ ኦቶታ ጋርፃ። ጋርፃሸ ጉ ጋርፆፋ። <verse eid="2KI 4:3"/><verse number="4" style="v" sid="2KI 4:4"/>ሄሳፈ ጉየ፥ ሶ ገላዳ፥ ነ ቦላነ ነ ናይታ ቦላ ካርያ ጎርዳ። ኦቶ ኡባን ዛይተ ትጋ፤ ዛይተይ ኩምዳ ኦቶታ እስ ባጋ አ” ያግስ።<verse eid="2KI 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 4:5"/>ማጫስያ ባዳ፥ ካርያ ባ ቦላነ ባ ናይታ ቦላ ጎርዳሱ። ኤንቲ እዉ ኦቶታ ሺሽን፥ እያ ዛይትያ ትገ ኦይካሱ። <verse eid="2KI 4:5"/><verse number="6" style="v" sid="2KI 4:6"/>ኦቶ ኡባይ ኩምዳ ዎደ፥ ማጫስያ ባ ናኣኮ፥ “አነ ታዉ ሀራ ኦቶ ኤካዳ ያ” ያጋሱ።</para>
  <para style="p" vid="2KI 4:6">ሽን ናአይ ዛሪድ፥ “ሀር እስ ኦቶይካ ዴና” ያግስ። ሄሳፈ ጉየ፥ ዛይተይ ጎገይሳ አጋግስ።<verse eid="2KI 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 4:7"/>ማጫስያ ስማ ባዳ ኤልሳስ ኦዳሱ። እ፥ “ባዳ ዛይትያ ባይዛዳ፥ ነ አጩዋ ቃንፃ። አትዳይሳ ኔንነ ነ ናይት ጎኤትድ ዳናዉ ዳንዳኤታ” ያግስ።<verse eid="2KI 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 4:8"/>እስ ጋላስ ኤልስ እስ ዱረ ማጫስያ ደእያ ሱኔማ ካታማ ብን፥ ማጫስያ ሾባዳ፥ እያ ካ ሙዛሱ። ሄ ጋላሳፐ ዶምን፥ እ ያራ አያ ዎደ ኡባን ካ ማናዉ እ ሶ ገሌስ። <verse eid="2KI 4:8"/><verse number="9" style="v" sid="2KI 4:9"/>እያ ባ አዝናኮ፥ “ሄኮ፥ ኡባ ዎደ ኑ ማታራ አያ አደይ ፆሳ አስ ግደይሳ ታኒ ኤራይስ። <verse eid="2KI 4:9"/><verse number="10" style="v" sid="2KI 4:10"/>አነ እስ ጉ ክፍለ ፖቅያ ቦላ እያዉ ኬፆስ፤ እያ ግዶን አርስ፥ ኦይደ፥ ፃርጴዛነ ፆምፐ ዎስ። እ ኑኮ ይዳ ዎደ ኡባን ያ ገላናዉ ዳንዳኤስ” ያጋሱ።<verse eid="2KI 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 4:11"/>እስ ጋላስ ኤልስ ሱናማ ካታማ ይድ፥ ባ ክፍልያ ፑደ ከይድ ያን ሸምፕስ። <verse eid="2KI 4:11"/><verse number="12" style="v" sid="2KI 4:12"/>ባ አይልያ ግያዛኮ፥ “ባዳ ማጫስዉ ፄጋ” ያግን፥ ግያዝ ፄግን፥ እያ ያዳ ኤልሳ ስንን ኤቃሱ። <verse eid="2KI 4:12"/><verse number="13" style="v" sid="2KI 4:13"/>ኤልስ ግያዛኮ፥ “ሀ ማጫስያ ሀ ኡባ ኑስ ኦሱ። ኑኒ ነዉ አይ ኦኖ? ኑኒ ብድ፥ ካዋ ዎይኮ ቶራ ሞጮና ኦድሳናባይ አይብ ደእያኮ እዮ ኦይቻ” ያግስ።</para>
  <para style="p" vid="2KI 4:13">ማጫስያ፥ “ታኒ ሀይሳን ታ አሳ ግዶን ደአይስ” ያጋሱ።<verse eid="2KI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 4:14"/>ኤልስ ግያዛ፥ “ያትን፥ ታኒ እዉ አይ ኦ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 4:14">ግያዝ፥ “እዉ ናእ ባዋ፤ እ አዝናይ ጭምስ” ያግስ።<verse eid="2KI 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 4:15"/>ኤልስ፥ “ማጫስዉ ፄጋ” ያግስ። ግያዝ እዮ ፄግስ፤ እያ ያዳ፥ ፐንገን ኤቃሱ። <verse eid="2KI 4:15"/><verse number="16" style="v" sid="2KI 4:16"/>ኤልስ፥ “ዎንቶ ላይ ሀኖደ ኔኒ አደ ናአ እድማና” ያግስ።</para>
  <para style="p" vid="2KI 4:16">ማጫስያ፥ “አካይ፥ ታ ጎዳዉ፥ ኔኒ ፆሳ አስ ግድክ፥ ታዉ ዎርዶቶፓ” ያጋሱ።<verse eid="2KI 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 4:17"/>ሽን ማጫስያ ቃንታሱ፤ ኤልስ እዉ ኦድዳይሳዳ፥ ካልያ ላይ አደ ናአ የላሱ።<verse eid="2KI 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 4:18"/>ናአይ ድጭስ፤ እስ ጋላስ ካ ጫክያ አሳታራ ደእያ ባ አዋኮ ብስ። <verse eid="2KI 4:18"/><verse number="19" style="v" sid="2KI 4:19"/>ባ አዋኮ፥ “ዎ ታና ሁጰይ ዎስ! ዎ ታና ሁጰይ ዎስ!” ያግስ።</para>
  <para style="p" vid="2KI 4:19">እያ አዋይ እስ አይልያ፥ “ቶካዳ አየኮ ኤፋ” ያግድ ኪትስ።<verse eid="2KI 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 4:20"/>አይለይ ናኣ ኤክድ፥ አየኮ ኤፍስ። ሴታ ጋላስ ግዳና ጋካናዉ፥ ናአይ ባ አየ ክኦን ኡትስ፤ ሄሳፈ ጉየ፥ ናአይ ሀይቅ አግስ። <verse eid="2KI 4:20"/><verse number="21" style="v" sid="2KI 4:21"/>ማጫስያ ናኣ ፑደ ኤፋዳ፥ ፆሳ አድያ አርሳን ዝንእሳሱ። ያታዳ እያ ቦላ ካረ ጎርዳዳ ባሱ።<verse eid="2KI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 4:22"/>ባ አዝና ፄጋዳ፥ “ታኒ ፆሳ አድያኮ ኤለ ባዳ ያና መላ፥ አይለታፐ እሱዋነ ሀረታፐ እሱዋ ታዉ የዳ” ያጋሱ።<verse eid="2KI 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 4:23"/>እ፥ “ሀች አጌና ፄሮ ጋላስ ዎይኮ ሳምባታ ግደና፤ ነና እያኮ ኤፈይ አይቤ?” ያግስ።</para>
  <para style="p" vid="2KI 4:23">እያ ዛራዳ፥ “አይብካ ባዋ” ያጋሱ። <verse eid="2KI 4:23"/><verse number="24" style="v" sid="2KI 4:24"/>እያ ሀረ ጫናዳ፥ ባ አይልያ፥ “ሀርያ ላጋ! ታኒ ነዉ ኦዳና ጋካናዉ፥ ለፕ ኦዳ ላጎፋ” ያጋሱ። <verse eid="2KI 4:24"/><verse number="25" style="v" sid="2KI 4:25"/>ማጫስያ ያፐ ደንዳዳ፥ ቃርመሎሳ ዙማን ደእያ ፆሳ አድያኮ ባሱ።</para>
  <para style="p" vid="2KI 4:25">ኤልስ ማጫስው ሃሆን በእድ፥ ባ አይልያ ግያዛ፥ “በአ፥ ሱናማን ደእያ ማጫስያ ያዉሱ። <verse eid="2KI 4:25"/><verse number="26" style="v" sid="2KI 4:26"/>እዮ ሞካናዉ ዎፃ ባዳ፥ ‘ኔኒ ሳሮ? ነ አዝናይ ሳሮ? ነ ናአይ ሳሮ?’ ያጋዳ ኦይቻ” ያግስ።</para>
  <para style="p" vid="2KI 4:26">ማጫስያ፥ “ኑኒ ኡባይካ ሳሮ” ያጋሱ።<verse eid="2KI 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 4:27"/>ማጫስያ ዙማ ቦላ ደእያ ፆሳ አድያኮ ጋክዳ ዎደ፥ ሆካዳ እያ ቶሁዋ ኦይካሱ።</para>
  <para style="p" vid="2KI 4:27">ግያዝ ማጫስዉ ድጋናዉ ሺቅስ፤ ሽን ፆሳ አደይ፥ “አጋ! እያ ግታ መቶን ደአዉሱ፤ ሽን ጎዳይ ታፐ ሄሳ ገንስ። እ መቱዋ ታዉ ኦድቤና” ያግስ።<verse eid="2KI 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 4:28"/>ማጫስያ፥ “ታ ጎዳዉ፥ ኔኒ ታዉ ናአ እማና መላ ታኒ ነና ኦይቻድና? ታኒ ነና፥ ‘ታና ጮ ጭሞፋ ያጋብክና?’ ” ያጋሱ።<verse eid="2KI 4:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 4:29"/>ኤልስ ግያዛኮ፥ “ነ አዱሳ ማኡዋ ነ ሳቅያን ስርቃ፤ ታ ፃምአ ኤካዳ ኤለሳ። ኦገን ኦደራካ ጋሄትኮ፥ ሳሮፋ፤ ኦንካ ነና ሳሮትኮ፥ ዛራዳ ሳሮ ጎፓ። ታ ፃምአ ናኣ ሶምኡዋ ቦላ ዎ” ያግስ።<verse eid="2KI 4:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 4:30"/>ሽን ናኣ አይያ፥ “ደኦ ጎዳይ ኤርያ መላ፥ ነ ሸምፖይ ኤሮ! ታኒ ነና የጋዳ ቢከ” ያጋሱ። ኤልስ ደንድድ፥ እዮ ካልስ። <verse eid="2KI 4:30"/><verse number="31" style="v" sid="2KI 4:31"/>ግያዝ ኤንታፈ ስንትድ ብድ፥ ፃምአ ናኣ ሶምኡዋ ቦላ ዎስ። ሽን ግርስ ዎይኮ ሸምፖይ ባዋ። ያትን ግያዝ ኤልሳራ ጋሄታናዉ ስም ይድ፥ “ናአይ ባርክቤና” ያግድ ኦድስ።<verse eid="2KI 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 4:32"/>ኤልስ ሶ ገልድ፥ ሄኮ፥ ናኣ አሀይ እያ አርሳን ዝንእዳይሳ በእስ። <verse eid="2KI 4:32"/><verse number="33" style="v" sid="2KI 4:33"/>ባ ቦላነ ናኣ ቦላነ ካርያ ጎርድድ፥ ጎዳ ዎስስ። <verse eid="2KI 4:33"/><verse number="34" style="v" sid="2KI 4:34"/>ናኣ አሀ ቦላ ከይድ፥ ባ ዶና እያ ዶናን፥ ባ አይፍያ እያ አይፍያን፥ ባ ኩሸታ እያ ኩሸታራ ጋድ ዝንእስ፤ ናኣ አሳተይ ሆእስ። <verse eid="2KI 4:34"/><verse number="35" style="v" sid="2KI 4:35"/>ኤልስ ደንድድ፥ ሶ ግዶን ያ ሃ ስመረትስ። ናምአን ስሚድ፥ ናኣ ቦላ ዝንእስ፤ ናአይ ላፑን ቶሆ ሀሽዳፐ ጉየ ፄልስ።<verse eid="2KI 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 4:36"/>ኤልስ ግያዛ ፄግድ፥ “ሱናማ ማጫስዉ ፄጋ” ያግስ። ግያዝ እዮ ፄግን፥ እያ ይዳ ዎደ፥ ኤልስ፥ “ነ ናኣ ኤካ” ያግስ። <verse eid="2KI 4:36"/><verse number="37" style="v" sid="2KI 4:37"/>ማጫስያ ኤልሳ ቶሁዋ ቦላ ኩንዳዳ፥ ሳአን ጉፋናሱ፤ ባ ናኣ ኤካዳ ካረ ከያሱ።<verse eid="2KI 4:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="2KI 4:38"/>ኤልስ ጋልጋላ ስሚድ ይዳ ዎደ፥ ቢታን ኮሽ ደኤስ። ናበታ ጩጋይ እያ ስንን ኡትድ ደእሽን፥ እ ባ አይልያ፥ “ዎጋ ኦቶ ታማ ቦላ ዎዳ፥ ናበታስ ዎፀ ካ” ያግስ። <verse eid="2KI 4:38"/><verse number="39" style="v" sid="2KI 4:39"/>ኤንታፈ እሶይ ቦንጮ ማፅድ ኤሀናዉ ዎራ ብድ፥ ኤጨረ ሌሄ ዳንያባ ደምስ። ቶካናዉ ዳንዳኤይሳ ኬና ዳሮ ኤጨረ ሌሄ ኤክድ ይስ፤ እ አይበኮ ኤሮና አንጭድ፥ ኦቱዋን የግስ። <verse eid="2KI 4:39"/><verse number="40" style="v" sid="2KI 4:40"/>አሳይ ማና መላ ዎፅያ ከስዶሶና፤ ኤንቲ ዎፅያ ቱሽ ባሪ በእድ፥ “ናብያዉ፥ ሀ ኦቱዋን ዎያባይ ደኤስ” ያግድ ዋስዶሶና። አሳይ ማናዉ ዳንዳእቦኮና።<verse eid="2KI 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="2KI 4:41"/>ኤልስ፥ “አነ ታዉ ለ ኤክድ ዪተ” ያግስ። ሄ ልያ ኦቱዋን ቆልድ፥ “አሳይ ማናዳ ዎፅያ ትግተ” ያግስ። ሄሳፈ ጉየ፥ ኦቱዋን ኢታባይ በንትቤና።<verse eid="2KI 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="2KI 4:42"/>ኮይሮ ጋክዳ ካፈ ኡከትዳ ላታሙ ባንጋ ዳቡዋ፥ ትያ ካራ እስፈ ባ ኦጎሩዋን የግድ፥ ፆሳ አድያስ ኤህያ እስ አደይ ባኣል-ሻልሻፔ ይስ። ኤልስ ባ አይልያ፥ “ማና መላ አሳስ አ” ያግስ።<verse eid="2KI 4:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="2KI 4:43"/>እያ አይለይ፥ “ታኒ ፄቱ አሳ ስን ሀይሳ ዋታዳ አ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 4:43">ሽን ኤልስ፥ “ማና መላ አሳስ አ፤ ጎዳይ ‘ኤንቲ ምድ ካልን፥ ቲፈይ አታና’ ” ያግስ። <verse eid="2KI 4:43"/><verse number="44" style="v" sid="2KI 4:44"/>ሄሳ ግሾ፥ አይለይ ኤንታ ስን አን፥ ኤንቲ ምዶሶና፤ ጎዳይ ግዳይሳዳ ቲፈይ አትስ።<verse eid="2KI 4:44"/></para>
  <chapter eid="2KI 4"/>
  <chapter number="5" style="c" sid="2KI 5"/>
  <para style="s1">ንእማን ጎጋ ሀርገፈ ፓፁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 5:1"/>አራመ ካዋስ ምኖ ቶራ ሞጮና ግድዳ ንእማን፥ ባ ጎዳን ዳሮ ዶሰትዳነ ቦንቸትዳ አስ። እያ ባጋራ ጎዳይ አራመ ኦላንቾታስ ፆኖ እሚስ። ንእማኔይ ቶራ ቃራ፤ ሽን ጎጋ ሀርገይ እያ ቦላ ደኤስ።<verse eid="2KI 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 5:2"/>እስ ዎደ አራመ ቢታፈ ፓኖት እስራኤለ ቢታ ብድ፥ እስ ማጫ ናአ እስራኤለፐ ድእዶሶና። ሄ ናእያ ንእማነ ማቼስ አይለ ግዳሱ። <verse eid="2KI 5:2"/><verse number="3" style="v" sid="2KI 5:3"/>ሄ ናእያ ባ ጎዳተኮ፥ “ታ ጎዳይ ሳማረን ደእያ ናብያኮ ብዳ ግድያኮ፥ እ ፓፃናሽን” ያጋሱ።<verse eid="2KI 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 5:4"/>ንእማን ባ ጎዳኮ ብድ፥ እስራኤለፐ ይዳ ናእያ ግዳይሳ እያዉ ኦድስ። <verse eid="2KI 5:4"/><verse number="5" style="v" sid="2KI 5:5"/>አራመ ካዎይ ንእማነኮ፥ “ባ፥ ታኒ እስራኤለ ካዋስ ዳብዳበ ፃፋና” ያግስ። ንእማን 3,000 ብራ ሳንትመ፥ 6,000 ዎርቃ ሳንትመ ታሙ ኩመ ማኦ ኤክድ ብስ። <verse eid="2KI 5:5"/><verse number="6" style="v" sid="2KI 5:6"/>እ፥ ኤክድ ብዳ ዳብዳበይ፥ “ሀ ጎጋ ሀርግያፈ ኔኒ ታ አይልያ፥ ንእማነ ፓና መላ ሀ ዳብዳብያራ ታኒ እያ ኔኮ የዳስ” ያግስ።<verse eid="2KI 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 5:7"/>እስራኤለ ካዎይ ዳብዳብያ ናባብዳ ዎደ፥ ባ ማኡዋ ዳክድ፥ “ታኒ እያ ዎናዉነ ፓናዉ ፆሰዬ? ታኒ እስ አስ እያ ጎጋ ሀርገፈ ፓና መላ ሀ አደይ ታኮ አይስ ኪትዴ? እ ታራ ኦየታናዉ ጋሶ ኮየይሳ በእተ” ያግስ።<verse eid="2KI 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 5:8"/>ፆሳ አስ ግድዳ ኤልስ እስራኤለ ካዎይ ባ ማኡዋ ዳክዳይሳ ስእዳ ዎደ አሰ ኪትድ፥ “ነ ማኡዋ አይስ ዳካዲ? እያ ሃ ታኮ የዳ፤ እስራኤለን ናበይ ደኤይሳ ታኒ እያ ኤርሳና” ያግስ።<verse eid="2KI 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 5:9"/>ንእማን ባ ፓራታነ ፓራ ጋረታራ ብድ፥ ኤልሳ ካረን ኤቅስ። <verse eid="2KI 5:9"/><verse number="10" style="v" sid="2KI 5:10"/>ኤልስ፥ “ባዳ ዮርዳኖሰ ሻፋን ላፑን ቶሆ ሜጨታ፤ ነ ሀርግያፈ ኔኒ ፓፃናነ ጌያና” ያግድ ኦዳና መላ ባ አይልያ እያኮ ኪትስ።<verse eid="2KI 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 5:11"/>ሽን ንእማን ሀንቀትድ፥ “እ ታኮ ይድ፥ ጎዳ ባ ፆሳ ሱን ፄግድ፥ ባ ኩሽያ ታ ማዱን ቦላ ዎድ፥ ታና ሀ ጎጋ ሀርግያፈ ፓስ ጋዳ ቆፓስ። <verse eid="2KI 5:11"/><verse number="12" style="v" sid="2KI 5:12"/>ዳማስቆ ሻፋት፥ አባንነ ፋርፋር እስራኤለን ደእያ ሻፋታፐ አኮናዬ? ያትን ታኒ ኤንታን ሜጨታዳ ጌይክና?” ያግድ ሀንቀትድ፥ ጉየ ስምስ።<verse eid="2KI 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 5:13"/>እያ አይለት እያኮ ሺቅድ፥ “ኑ ጎዳዉ፥ ናበይ ግታባ ኦና መላ ነዉ ኦድዳኮ፥ ኔኒ ኦክዬ? እ ነና፥ ‘ባዳ ሜጨታዳ ጌይያ’ ግዳይስ አይስ ዴፅዴ?” ያግዶሶና። <verse eid="2KI 5:13"/><verse number="14" style="v" sid="2KI 5:14"/>እ ዱገ ዎድ፥ ፆሳ አደይ እያዉ ኦድዳይሳዳ ዮርዳኖሰ ሻፋን ላፑን ቶሆ ሙከትድ ሜጨትስ። እያ አሳተይ ናአ አሳተዳ ሀንስ፤ ፓፅድ ጌይስ።<verse eid="2KI 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 5:15"/>ሄሳፈ ጉየ፥ ንእማንነ እያራ ይዳ አሳ ኡባይ ኤልሳኮ ጉየ ብዶሶና። ንእማን እያ ስንን ኤቅድ፥ “ሄኮ፥ እስራኤለ ፆሳፈ አትሽን፥ ሀራ ፆሲ ባይናይሳ ታኒ ሀእ ኤራስ። ሀያና ሀእ ታኒ፥ ነ አይለይ እምያ እሞታ ኤካ” ያግስ።<verse eid="2KI 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 5:16"/>ኤልስ፥ “ታኒ እያዉ ኦያ ጎዳይ ኤርያ መላ፥ ታኒ ኔፐ አይባካ ኤክከ” ያግስ። ኤልስ እሞታ ኤካናዳ ንእማን ዎስን እፅስ።<verse eid="2KI 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 5:17"/>ንእማን፥ “ኔኒ ኤኮና እፅኮ፥ ታዉ ናምኡ ባቁሎ ጫና ቢታ እማና መላ ታኒ ነና ዎሳይስ። ታኒ ነ አይለይ ሀችፈ ዶማዳ ፁሳ ያርሾ ነ ፆሳ ያርሻናፐ አትሽን፥ ሀራ ፆሳታስ ያርሽከ። <verse eid="2KI 5:17"/><verse number="18" style="v" sid="2KI 5:18"/>ሽን ጎዳይ ታዉ ነ አይልያስ እስባ አቶ ጎ። ታ ካዎይ እርሞና ኤቃ ጎይናናዉ ገልያ ዎደ፥ ታንካ እያ አጃባዳ ገላዳ ጎይናናዉ ኮሼስ። ጎዳይ ታዉ ነ አይልያስ ሄሳ አቶ ጎ” ያግስ።<verse eid="2KI 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 5:19"/>ኤልስ፥ “ሳሮ ጋካ!” ያግስ። ንእማን ደንድድ ብስ።</para>
  <para style="p" vid="2KI 5:19">እ ጉ ሃክድ ብሽን፥ <verse eid="2KI 5:19"/><verse number="20" style="v" sid="2KI 5:20"/>ፆሳ አስ ግድዳ ኤልሳ አይለይ ግያዝ፥ “ታ ጎዳይ፥ ኤልስ ሶረ ንእማን ኤህዳባፐ አይባካ ኤኮና ጮ የድስ። ጎዳይ ኤርያ መላ፥ ታኒ እያ ጌዶ ዎፃ ባዳ፥ እያፐ እስባ ኤካና” ያግድ ቆፕስ። <verse eid="2KI 5:20"/><verse number="21" style="v" sid="2KI 5:21"/>ሄሳ ግሾ፥ ግያዝ ንእማነ ካልስ። ባ ጌዶ ዎፅያ ንእማነ በእድ፥ እያራ ጋሄታናዉ ፓራ ጋርያፐ ዎድ፥ “አይበ፥ ሳሮ ግደኔ?” ያግድ ኦይችስ።<verse eid="2KI 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 5:22"/>ግያዝ፥ “አይኮይ ባዋ፤ ሳሮ! ሽን ታና ታ ጎዳይ፥ ‘ደረይ ዳርያ ኤፍሬማ ቢታፈ ናበታ ባጋ ግድዳ ናምኡ ፓንት ታኮ ይዶሶና። ሀያና ኤንታዉ ሄ ሙኩሉ ብራ ሳንትመነ ናምኡ ኩመ ማኦ እማ’ ያግድ ኪትስ” ያግስ።<verse eid="2KI 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 5:23"/>ንእማን፥ “ህዛ ሀያና ኡሱፑን ሙኩሉ ብራ ሳንትመ ኤካ” ያግስ። ንእማን ግያዛ ሾቢድ፥ ብራ ናምኡ ካርፂታን የግድ፥ ናምኡ ኩመ ማኦነ ናምኡ አይለታ ቶስድ፥ ግያዛፐ ስን የድስ። <verse eid="2KI 5:23"/><verse number="24" style="v" sid="2KI 5:24"/>ግያዝ ደእያ ዙማ ኤንቲ ጋክዳ ዎደ፥ ብራነ ማኡዋ ኤንታፈ ኤክድ፥ ሶ ገልስስ። ያትድ ኤንታ ሞይዝን፥ ኤንቲ ብዶሶና።<verse eid="2KI 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 5:25"/>ሄሳፈ ጉየ፥ ሶ ገልድ፥ ባ ጎዳ ኤልሳ ስንን ኤቅስ። ኤልስ፥ “አዉ ባዲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 5:25">ግያዝ፥ “ታኒ ነ አይለይ አዉካ ባብከ” ያግድ ዛርስ።<verse eid="2KI 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 5:26"/>ሽን ኤልስ፥ “አደይ ኔራ ጋሄታናዉ ፓራ ጋርያፐ ዎያ ዎደ፥ ታ አያናይ ኔራ ደኤስ ግደኔ? ሀ ዎደይ፥ ሚሸነ ማኦ፥ ዎይኮ ሻማሆነ ዎይነ ጋደ፥ ዎይኮ ዶርሳ ዉደነ ሚዛ ዉደ፥ ዎይኮ አደነ ማጫ አይለ ኤክያ ዎዴ? <verse eid="2KI 5:26"/><verse number="27" style="v" sid="2KI 5:27"/>ሄሳ ግሾ፥ ንእማነ ኦይክዳ ጎጋ ሀርገይ ነናነ ነ ኮቻ ኡባ መርናዉ ኦይካና” ያግስ። ግያዝ ኤልሳ ስንፈ ከይድ ብሽን፥ ሄ ሀርገይ እያ ኦይክን፥ እያ ጎጋይ ሻቻዳ ቦፅስ።<verse eid="2KI 5:27"/></para>
  <chapter eid="2KI 5"/>
  <chapter number="6" style="c" sid="2KI 6"/>
  <para style="s1">ሃን ዎዳ ቤፀ አይፈ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 6:1"/>ናበታ ጩጋይ፥ ኤልሳኮ፥ “ሄኮ፥ ኑኒ ደእያ በሳይ ኑስ ዳሮ ፁምስ። <verse eid="2KI 6:1"/><verse number="2" style="v" sid="2KI 6:2"/>ኑኒ ኡባይ ም ቃንፃናዉ ዮርዳኖሰ ሻፋ ቦስ። ያን ኑስ ዱሳ በሲ ኬፆስ” ያግዶሶና። ኤልስ፥ “ቢተ” ያግስ።<verse eid="2KI 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 6:3"/>ናበታፐ እሶይ፥ “ሀያና ኔንካ ኑራ ነ አይለታራ የርኪ?” ያግስ። ኤልስ፥ “ኤሮ ባና” ያግድ ዛርስ፤ <verse eid="2KI 6:3"/><verse number="4" style="v" sid="2KI 6:4"/>ኤንታራ እስፈ ብስ። ኤንቲ ዮርዳኖሰ ጋክዳ ዎደ ም ቃንፆ ዶምዶሶና። <verse eid="2KI 6:4"/><verse number="5" style="v" sid="2KI 6:5"/>ሽን ኤንታፈ እሶይ ም ቃንፅሽን፥ ቤፅያ አይፈይ ከስ ኤክድ፥ ሃን ዎስ። ሄ አደይ፥ “ታ ጎዳዉ፥ ታኒ ጋርፃ ኤክዳ ቤፀ፤ ታኒ ህዛ ዋኖ!” ያግድ ዋስስ።<verse eid="2KI 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 6:6"/>ኤልስ፥ “አዉን ገልዴ?” ያግድ ኦይችስ፤ አደይ ገልዳ በሳ በስስ። ኤልስ ፃምአ ቃንፅድ፥ ሃን ሆልስ፤ ቤፅያ አይፈይ ሃ ቦላ ቶከትስ። <verse eid="2KI 6:6"/><verse number="7" style="v" sid="2KI 6:7"/>ኤልስ አድያ፥ “ከሳዳ ኤካ” ያግስ። አደይ ባ ኩሽያ የድድ ኤክስ።<verse eid="2KI 6:7"/></para>
  <para style="s1">አራመ ኦላንቾታ</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 6:8"/>አራመ ካዎይ እስራኤለታራ ኦለትሸ ደኤስ። እ ባ ቶራ ሞጮናታራ፥ “ታኒ ዱማ ዱማ በሳን ሚፃ መና” ያግስ።<verse eid="2KI 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 6:9"/>ኤልስ፥ “አራመ አሳይ ሄ በሳን ቆሰትዳ ግሾ፥ ሄ በሳራ ያ ቦፓ” ያግድ እስራኤለ ካዋስ ኪታ የድስ። <verse eid="2KI 6:9"/><verse number="10" style="v" sid="2KI 6:10"/>ሄሳ ግሾ፥ እስራኤለ ካዎይ ፆሳ አስ ማልዳ በሳ አሰ ኪትድ፥ ያን ደእያ አሳይ ናገታና መላ ኦድስ። ካዎይ ናገታና መላ ኤልስ ዎደን ዎደን ኦዴስ።<verse eid="2KI 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 6:11"/>ሀ ሀኖታይ አራመ ካዋ ዳሮ ሀንቀን፥ ባ ቶራ ሞጮናታ ፄግድ፥ “ኑ ግዶን እስራኤለ ካዋ ባጋ ግድድ ደኤይ ኦነኮ አነ ታዉ ኦድተ” ያግድ ኦይችስ።<verse eid="2KI 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 6:12"/>እያ ቶራ ሞጮናታፐ እሶይ፥ “ታ ጎዳዉ፥ ካዋዉ፥ ኑ ግዶን ሄሳ ኦያ ኦንካ ባዋ። ሽን ኔኒ ነ ቆልአን ኦደትያባ ኡባ እስራኤለን ደእያ ናበይ ኤልስ እስራኤለ ካዋስ ኦዴስ” ያግስ።<verse eid="2KI 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 6:13"/>ካዎይ፥ “ታኒ አሰ ኪታዳ እያ ድአና መላ ብድ አዉን ደእያኮ ኮይተ” ያግስ። ኤንቲ፥ “ሄኮ፥ እ፥ ዶታነን ደኤስ” ያግድ ኦድዶሶና።<verse eid="2KI 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 6:14"/>ካዎይ ዳሮ ኦላንቾታ ፓራታራነ ፓራ ጋረታራ ያ የድስ። እ የድዳ አሳት ቃማ ይድ፥ ካታማ ተቅዶሶና። <verse eid="2KI 6:14"/><verse number="15" style="v" sid="2KI 6:15"/>ኤልሳ አይለይ ዎንተ ጋላስ ጉራ ደንድድ፥ ካረ ከይያ ዎደ፥ ኦላንቾት ፓራታራነ ፓራ ጋረታራ ካታማ ተቅዶሶና። ሄ አይለይ፥ “ሄኮ፥ ኑኒ ይዳ! ታ ጎዳዉ፥ ኑ ዋንኖ?” ያግድ ኦይችስ።<verse eid="2KI 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 6:16"/>ኤልስ፥ “ያዮፋ! ኑራ ደኤይሳት ኤንታራ ደኤይሳታፐ አሶና” ያግድ ዛርስ።<verse eid="2KI 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 6:17"/>ሄሳፈ ጉየ፥ ኤልስ፥ “አቤት ጎዳዉ፥ እ በአና መላ እያ አይፍያ ዶያ” ያግድ ዎስስ። ጎዳይ ኤልሳ አይልያ አይፍያ ዶይን፥ ሄኮ፥ ኤልሳ ዩሾ ኡባን ደእያ ታማ ፓራትነ ፓራ ጋረት ዙማ ማእስ።<verse eid="2KI 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 6:18"/>ሶረት እያ ተቅዳ ዎደ ኤልስ፥ “ሀ አሳታ አይፍያ ቆቅሳርክ” ያግድ ጎዳ ዎስስ። ኤልስ ዎስዳይሳዳ ጎዳይ ኤንታ አይፍያ ቆቅስስ። <verse eid="2KI 6:18"/><verse number="19" style="v" sid="2KI 6:19"/>ሄሳፈ ጉየ፥ ኤልስ፥ “ኦገይ ሀይሳራ ዴና፤ ካታማይ ሀይሳ ግደና። ህንተ ኮይያ ኡራ ታ ህንተና በሳና፤ ታና ካልተ” ያግድ፥ ኤንታ ካለድ፥ ሳማረ ካታማ ኤፍስ።<verse eid="2KI 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 6:20"/>ኤንቲ ሳማረ ካታማ ገልዳ ዎደ ኤልስ፥ “አቤት ጎዳዉ፥ ሀ አሳት ፄላና መላ ኤንታ አይፍያ ዶያ” ያግስ። ጎዳይ ኤንታ አይፍያ ዶይን፥ ሄኮ፥ ኤንቲ ሳማረ ግዶን ደኤይሳ በእዶሶና። <verse eid="2KI 6:20"/><verse number="21" style="v" sid="2KI 6:21"/>እስራኤለ ካዎይ ኤንታ በእዳ ዎደ፥ “ታ አዋዉ፥ ታኒ ኤንታ ዎ? ታኒ ኤንታ ዎ?” ያግድ ኦይችስ።<verse eid="2KI 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 6:22"/>ኤልስ፥ “አካይ፥ ዎፓ! ሀር አቶሽን፥ ኔኒ ነ ማሻንነ ነ ዶንግያን ድእዳይሳታካ ዎናዉ በሰና። ኤንቲ ምድ ኡይድ ባንታ ጎዳኮ ባና መላ ካ ኤንታ ሙዛ” ያግስ። <verse eid="2KI 6:22"/><verse number="23" style="v" sid="2KI 6:23"/>ሄሳ ግሾ፥ እስራኤለ ካዎይ ኤንታዉ ግብራ ጊግስን፥ ኤንቲ ምዳፐነ ኡይዳፐ ጉየ፥ ኤንታ የድን፥ ባንታ ጎዳኮ ስምዶሶና። ሄ ዎደፐ ዶምን፥ አራመት እስራኤለታ ቦላ ደንደይሳ አጋግዶሶና።<verse eid="2KI 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 6:24"/>ሄሳፈ ጉየ፥ አራመ ካዎይ ዎልደ-አዳር ባ ኦላንቾታ ኡባ ሺሽድ፥ ሳማረ ካታማ ተቅስ። <verse eid="2KI 6:24"/><verse number="25" style="v" sid="2KI 6:25"/>ሄሳ ጋሶን ሳማረ ካታማን ግታ ኮሽ ገልን፥ እስ ሀረ ሁጰይ ሆስፑን ታሙ ብራ ሳንትመን፥ ናምኡ ፄቱ ግራመ ግድያ ሆለ ሽእ እቻሹ ብራ ሳንትመን ባይዘትስ።<verse eid="2KI 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 6:26"/>እስራኤለ ካዎይ ካታማ ድርሳ ግምብያ ቦላራ አሽን፥ እስ ማጫስያ፥ “ታ ጎዳዉ፥ ካዋዉ፥ ታና ማዳርክ” ያጋዳ ዋሳሱ።<verse eid="2KI 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 6:27"/>ካዎይ፥ “ነና ጎዳይ ማዶና እፅኮ፥ ታኒ ነዉ ማዶ አዉፐ ኤሀኔ? ካ ቡክያ ዉዱማፈየ፥ ዎይነ አይፍያ ጉምእያ በሳፌ?” ያግስ። <verse eid="2KI 6:27"/><verse number="28" style="v" sid="2KI 6:28"/>ካዎይ፥ “ነ መቶይ አይቤ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 6:28">ማጫስያ ዛራዳ፥ “ሀ ማጫስያ፥ ‘ሀች ማናዉ ነ ናአ ኤካዳ ያ፤ ቃስ ዎንቶ ታ ናኣ ማና’ ያጋሱ። <verse eid="2KI 6:28"/><verse number="29" style="v" sid="2KI 6:29"/>ያትን፥ ታ ናኣ ካድ ምዳ፤ ዎንተ ጋላስ ታኒ፥ ‘ኑኒ ማናዉ ነ ናኣ ኤካዳ ያ’ ያጋስ። ሽን እያ ባ ናኣ ቆሳሱ” ያጋሱ።<verse eid="2KI 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 6:30"/>ካዎይ ማጫስያ ኦድዳይሳ ስእድ፥ ባ ማኡዋ ዳክስ። እ ግምብያ ቦላራ አሽን፥ አሳይ ጋርሳ ባጋራ እ ማእዳ ካዮ ማኡዋ በእዶሶና። <verse eid="2KI 6:30"/><verse number="31" style="v" sid="2KI 6:31"/>ካዎይ፥ “ሳፋፃ ናኣ ኤልሳ ጉገይ እያ ቦላ ሀች ፔእኮ፥ ፆሲ ታና ፕርዶ!” ያግስ።<verse eid="2KI 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 6:32"/>ሄ ዎደ ኤልስ ባ ሶን ኡትስ፤ ጭማትካ እያራ እስፈ ደኦሶና። ካዎይ ባፐ ስን አሰ ኪትስ፤ ሽን ሄ አደይ ጋካናፐ ስን፥ ኤልስ ጭማታኮ፥ “ሀ ሸምፖ ዎይስ ታ ቆያ ሙጭሳናዉ አሰ ኪትዳይሳ ህንተ በኤቲ? ሄ ኪተትዳይስ ይዳ ዎደ እብ ጎርድድ ገልሶፍተ፤ እያ ጎዳይካ እያ ካልድ ይሸ ደኤስ” ያግስ። <verse eid="2KI 6:32"/><verse number="33" style="v" sid="2KI 6:33"/>እ ጭማታራ ኦደትሽን፥ ሄኮ፥ ኪተትዳይስ ጋክ ዎስ፤ እ፥ “ሀ መቶይ ጎዳፐ ይስ። ያትን፥ ታኒ ጎዳ አይስ ናግያና?” ያግስ።<verse eid="2KI 6:33"/></para>
  <chapter eid="2KI 6"/>
  <chapter number="7" style="c" sid="2KI 7"/>
  <para style="p">
    <verse number="1" style="v" sid="2KI 7:1"/>ኤልስ፥ “ጎዳ ቃላ ስአ! ጎዳይ ሀይሳዳ ያጌስ። ዎንቶ ሀኖደ ሄ ክሎ ግራመ ግስተ ለይ ዎይኮ ኡሱፑን ክሎ ግራመ ባንግ ሳማረ ካታማ ፐንገን እስ ብራ ሳንትመን ባይዘታና” ያግስ። <verse eid="2KI 7:1"/><verse number="2" style="v" sid="2KI 7:2"/>ካዋስ ማታትያ ሀላቃይ ፆሳ አድያኮ፥ “ጎዳይ ሳሎ ማስኮተታ ዶያኮካ ሄስ ሀነና” ያግስ። ሽን ኤልስ ዛሪድ፥ “ኔኒ ሄሳ ነ አይፍያን በአና፤ ሽን እያፐ ማካ” ያግስ።<verse eid="2KI 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 7:3"/>ካታማ ገልያ ፐንግያን ግታ ጎጋ ሀርገይ ኦይክዳ ኦይዱ አሳት ደኦሶና። ኤንቲ እሶይ እሱዋኮ፥ “ኑኒ ሀይቃና ጋካናዉ፥ ሀይሳን አይስ ጋምአኔ? <verse eid="2KI 7:3"/><verse number="4" style="v" sid="2KI 7:4"/>ኑኒ ካታማ ገልኮ፥ ኮሽ ደእያ ግሾ፥ ኑኒ ያን ሀይቃና። ቃስ ሀይሳን ጋምእኮካ ሀይቃና። ሄሳ ግሾ፥ አራመታ ሚፃ አነ ቦስ። ኤንቲ ኑና አሽኮ አታና፤ ኤንቲ ዎኮ ሀይቃና” ያግዶሶና። <verse eid="2KI 7:4"/><verse number="5" style="v" sid="2KI 7:5"/>ሳእ ምያ ዎደ ደንድድ፥ አራመታ ሚፃ ብዶሶና። ኤንቲ ብድ ሚፃ ጋክያ ዎደ፥ ሄኮ፥ እስ አስካ ያን ባዋ። <verse eid="2KI 7:5"/><verse number="6" style="v" sid="2KI 7:6"/>ሄስ ሀንዳይ፥ ጎዳይ ፓራ ጋረታ፥ ፓራታነ ዳሮ ኦላንቾታ ቃላ አራመ አሳ ስስስ። ያትን ኤንቲ እሶይ እሱዋኮ፥ “ሄኮ፥ እስራኤለ ካዎይ ኑና ኦልሳናዉ፥ ህተነ ግብፀ ካዎታ ኡነይድ ኤህስ” ያግዶሶና። <verse eid="2KI 7:6"/><verse number="7" style="v" sid="2KI 7:7"/>ሄሳ ግሾ፥ ኤንቲ ደንድድ፥ ባንታ ሚፃ፥ ባንታ ዱንካንያ፥ ባንታ ፓራታነ ባንታ ሀረታ ኩመ የግ አግድ፥ ሳእ ማ ደእሽን፥ ባንታ ሸምፑዋ አሻናዉ ባቃትዶሶና።<verse eid="2KI 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 7:8"/>ሄ ግታ ጎጋ ሀርገይ ኦይክዳ አሳት አራመታ ሚፃ ጋክድ፥ ኤንታ ዱንካነታፐ እሱዋ ገልድ፥ ምዶሶናነ ኡይዶሶና፤ ብራ፥ ዎርቃነ ማኦ ኤክድ ቆትዶሶና። ናምአን ስሚድ፥ ሀራ ዱንካንያ፥ ገልድ እያፐ ኤክዳይሳ ቆትዶሶና።<verse eid="2KI 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 7:9"/>ሄሳፈ ጉየ፥ ኤንቲ እሶይ እሱዋ፥ “ኑኒ ሎኦባ ኦቦኮ። ሀች ምሽራቾ ጋላስ፤ ሽን ኑኒ ስእ ግዳ። ሳእ ዎንታና ጋካናዉ፥ ስእ ግድ ኡትኮ፥ ኑኒ ሴረታና። አነ፥ ሀእ ብድ፥ ካዎ ጋን ደእያ አሳስ ኦዳና” ያግዶሶና። <verse eid="2KI 7:9"/><verse number="10" style="v" sid="2KI 7:10"/>ሄሳ ግሾ፥ ኤንቲ ብድ፥ ካታማ ፐንግያ ናገይሳታ ፄግድ፥ “ኑኒ አራመ ሚፃ ብዳ፤ ሽን፥ ሄኮ፥ እስ አስ ዎይኮ አሳ ግርስ ሄ በሳን ባዋ። ቃሸትዳ ፓራታ ፃላልነ ሀረት ደኦሶና፤ ቃስ ኤንቲ አግድ ብዳ ዱንካነት ደኦሶና” ያግዶሶና። <verse eid="2KI 7:10"/><verse number="11" style="v" sid="2KI 7:11"/>ፐንግያ ናገይሳት ፄግድ፥ ካዎ ጋን ደእያ አሳስ ኦድዶሶና። <verse eid="2KI 7:11"/><verse number="12" style="v" sid="2KI 7:12"/>ካዎይ ቃማ ደንድድ፥ “አራመት ኑና ኦዳባ ታኒ ህንተዉ ኦዳና። ኑኒ ኮሻትዳይሳ ኤንቲ ኤሮሶና። ሄሳ ግሾ፥ ባንታ ሄራፐ ከይድ፥ ጋፃርያን ቆሰትድ፥ ኤንቲ ካታማፐ ካረ ከይን፥ ኑኒ ኤንታ ፓፃ ኦይክድ፥ ካታማ ገላና ያግድ ቆፕዶሶና” ያግድ ባ ሹማታስ ኦድስ።<verse eid="2KI 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 7:13"/>ካዋ ሀላቃታፐ እሶይ፥ “ሀ ካታማን አትዳ አሳይ ካሰ ሀይቅዳ አሳ መላ ሀይቆፐ አተና። ሄሳ ግሾ፥ ሀንዳባ ኤራናዉ አነ አሳ ዶሮስ። አትዳ እቻሹ ፓራታራ አነ ኤንታ ሶረታ ሚፃ የዶስ” ያግስ። <verse eid="2KI 7:13"/><verse number="14" style="v" sid="2KI 7:14"/>ጉ አሳታነ ናምኡ ፓራ ጋረታ ዶርዶሶና። ካዎይ ኤንታ ሶረ ኦላንቾታ ጌዶ የድድ፥ “ብድ ሀንያባ በእተ” ያግድ ኪትስ። <verse eid="2KI 7:14"/><verse number="15" style="v" sid="2KI 7:15"/>አሳት ኤንታ ጌዶ ካልድ፥ ዮርዳኖሰ ሻፋ ጋካናዉ ብዶሶና። አራመ አሳት ባቃትሸ የግዳ ማኦይነ ኦላ ሚሸይ ኦግያን ኩምስ። ኪተትዳ አሳት ጉየ ስሚድ፥ ካዋስ ኦድዶሶና።<verse eid="2KI 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 7:16"/>አሳይ ብድ፥ አራመታ ሚፃ ቦንቅዶሶና። ጎዳይ ግዳይሳዳ ሄ ክሎ ግራመ ግስተ ለይ ዎይኮ ኡሱፑን ክሎ ግራመ ባንግ እስ ብራ ሳንትመን ባይዘትስ። <verse eid="2KI 7:16"/><verse number="17" style="v" sid="2KI 7:17"/>ካዎይ ባዉ ማትያ ሀላቃ ፐንገ ናገይሳታ ሀላቃ ኦድ ሹምስ፤ ሽን አሳይ እያ ፐንገን የስ። ካዎይ ኤልሳኮ ብዳ ዎደ፥ ኤልስ ሀ ሀላቃ ቦላ ኦድዳይሳዳ አደይ ሀይቅስ። <verse eid="2KI 7:17"/><verse number="18" style="v" sid="2KI 7:18"/>ፆሳ አስ ግድዳ ኤልስ ካሰ ካዋስ፥ “ዎንቶ ሀኖደ ሄ ክሎ ግራመ ግስተ ለይ ዎይኮ ኡሱፑን ክሎ ግራመ ባንግ ሳማረ ካታማን እስ ብራ ሳንትመን ባይዘታና” ያግስ።<verse eid="2KI 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 7:19"/>ሄ ዎደ ሀላቃይ ኤልሳኮ፥ “ጎዳይ ሳሎ ማስኮተታ ዶያኮካ ሄስ ሀነና” ያግስ። ኤልስ፥ “ሄኮ፥ ኔኒ ሄሳ ነ አይፈን በአና፤ ሽን እያፐ ማካ” ያግድ ዛርስ። <verse eid="2KI 7:19"/><verse number="20" style="v" sid="2KI 7:20"/>ኤልስ ኦድዳይሳዳ፥ ሄ አደይ፥ አሳይ ፐንገን የን ሀይቅስ።<verse eid="2KI 7:20"/></para>
  <chapter eid="2KI 7"/>
  <chapter number="8" style="c" sid="2KI 8"/>
  <para style="s1">ሱናማ ማጫስዉ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 8:1"/>ኤልስ፥ ሀይቅዳ እ ናኣ ፓዳ ማጫስዉ፥ “ነ ሶ አሳ ኤካዳ ሀይሳፈ ባዳ ኔኒ ዳንዳእያ በሳን አዉንካ ደአ። ጎዳይ ላፑን ላይ ኮሻ ሀ ቢታ ቦላ የድስ” ያግስ። <verse eid="2KI 8:1"/><verse number="2" style="v" sid="2KI 8:2"/>ማጫስያ ኤልስ ኦድዳይሳዳ ባ ሶ አሳራ ባዳ፥ ፍልስፄመ ቢታን ላፑን ላይ ደአሱ። <verse eid="2KI 8:2"/><verse number="3" style="v" sid="2KI 8:3"/>ላፑን ላይ ዉርሰን ማጫስያ ፍልስፄመ ቢታፈ ስማሱ። ባ ኬነ ባ ጋድያ ኦይቻናዉ ካዋኮ ባሱ።<verse eid="2KI 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 8:4"/>ሄ ዎደ ካዎይ ፆሳ አስ ግድዳ ኤልሳ አይልያ ግያዛራ ኦደትሸ፥ “ኤልስ ኦዳ ግታ ኦሶ ኡባ አነ ታዉ ኦዳ” ያግስ። <verse eid="2KI 8:4"/><verse number="5" style="v" sid="2KI 8:5"/>ኤልስ ሀይቅዳ ናኣ ዋትድ ፓዳኮ፥ ግያዝ ካዋስ ኦድሽን፥ ሄኮ፥ ኤልስ እ ናኣ ፓዳ ማጫስያ ባ ኬነ ባ ጋድያ ኦይቻናዉ ያሱ። ግያዝ፥ “ታ ጎዳዉ፥ ካዋዉ፥ ማጫስያ ሀናሹ፤ ኤልስ ሀይቆፐ ፓዳ እ ናአይካ ሀይስሽ” ያግስ። <verse eid="2KI 8:5"/><verse number="6" style="v" sid="2KI 8:6"/>ካዎይ ማጫስዉ ኦይችን፥ እያዉ ኦዳሱ። ሄሳ ግሾ፥ ካዎይ ሀላቃ ፄግድ፥ “ሀ ማጫሴባ ግድዳ ኡባነ እያ አጋ ብዳ ዎድያፐ ሀች ጋካናዉ እ ጋደን ሞክዳ ኡባ እዉ ዛራ” ያግድ ኪትስ።<verse eid="2KI 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 8:7"/>ኤልስ ዳማስቆ ካታማ ብድ ጋክያ ዎደ፥ ሶረ ካዎይ ዎልደ-አዳር ሳከቴስ። እ፥ “ፆሳ አስ ሀይሳ ይስ” ግያ ዎረ ስእስ።<verse eid="2KI 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 8:8"/>ካዎይ አዛሄላኮ፥ “እምያባ ኤካዳ ፆሳ አድያራ ጋሄታናዉ ባዳ፥ ‘ታኒ ሀ ሀርግያፈ ፓፃኔ?’ ያጋዳ ጎዳ ኦይቻ” ያግስ።<verse eid="2KI 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 8:9"/>ሄሳ ግሾ፥ አዛሄል ዳማስቆን ደእያ ዱማ ዱማ ቆሞ ሙሩታፐ ኦይታሙ ግማለን ጫንድ፥ ኤልሳራ ጋሄታናዉ ብስ። ኤልሳ ስንን ኤቅድ፥ “ነ ናአይ አራመ ካዎይ ዎልደ-አዳር፥ ‘ታኒ ሀ ሀርግያፈ ፓፃኔ?’ ያግድ፥ ነና ኦይቻናዳ ታና ኔኮ ኪትስ” ያግስ።<verse eid="2KI 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 8:10"/>ኤልስ አዛሄላኮ፥ “ኔኒ ባዳ እያኮ፥ ‘ቱማ ኔኒ ፓፃና’ ያጋ። ሽን እ ቱማ ሀይቃናይሳ ታና ጎዳይ በስስ” ያግስ። <verse eid="2KI 8:10"/><verse number="11" style="v" sid="2KI 8:11"/>አዛሄል ዬላታና ጋካናዉ፥ ኤልስ እያ ትሽ ኦድ ፄልድ ዬክስ።<verse eid="2KI 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 8:12"/>ያትን፥ አዛሄል፥ “ታ ጎዳይ አይስ ዬኪ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 8:12">ኤልስ፥ “ኔኒ እስራኤለ አሳ ቦላ ኦና ኢታባ ታኒ ኤርያ ግሾ ዬካይስ። ኤንታ ሚፃ ኔኒ ታማን ፁጋና፤ ኤንታ ፓንታ ኔኒ ማሻን ዎና። ቃስ ኤንታ ዮጋ ናይታካ ኔኒ ሹቻን መንረና፤ ኤንታ ቃን ማጫሳታ ኡሉዋ ኔኒ ዳካና” ያግድ ዛርስ።<verse eid="2KI 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 8:13"/>አዛሄል ዛሪድ፥ “ታኒ ነ አይለይ፥ ፓና ካናይ፥ ሀይሳ መላ ግታባ ዋታዳ ኦናዉ ዳንዳእያና?” ያግስ። ኤልስ ዛሪድ፥ “ኔኒ አራመ ቢታን ካዎታናይሳ ታና ጎዳይ በስስ” ያግስ።<verse eid="2KI 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 8:14"/>ሄሳፈ ጉየ፥ አዛሄል ኤልሳፈ ሻከትድ፥ ባ ጎዳኮ ስምስ። ዎልደ-አዳር፥ “ኤልስ ነና ዎይግዴ?” ያግድ ኦይችስ። አዛሄል፥ “ኔኒ ቱማ ፓፃና” ያግስ።<verse eid="2KI 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 8:15"/>ሽን ዎንተ ጋላስ አዛሄል ቡሉኮ ኤክድ፥ ሃን ሙክድ፥ ካዋ እያራ ቱጭን፥ ካዎይ ሀይቅስ። አዛሄል እያ በሳን ባዉ ካዎትስ።<verse eid="2KI 8:15"/></para>
  <para style="s1">ይሁዳ ካዋ እዮራማ</para>
  <para style="r">(<ref loc="2CH 21:1-20">2 ታር 21:1-20</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 8:16"/>አካባ ናአይ፥ እስራኤለ ካዎይ እዮራም ካዎትዳ እቻሻን ላይን፥ ይሁዳ ካዋ እዮሳፈፃ ናአይ እዮራም ይሁዳን ካዎትስ። <verse eid="2KI 8:16"/><verse number="17" style="v" sid="2KI 8:17"/>እዮራም ካዎትያ ዎደ እያዉ ላይይ ሀስታማነ ናምአ፤ እ የሩሳላመን ሆስፑን ላይ ካዎትስ። <verse eid="2KI 8:17"/><verse number="18" style="v" sid="2KI 8:18"/>እዮራም አካባ ናእዉ ማቾ ኤክዳ ግሾ፥ አካባ ሶ አሳይ ሄመትዳይሳዳ ካሰ እስራኤለ ካዎታ ኦግያን ሄመትስ፤ ጎዳ ስንን ኢታባ ኦስ። <verse eid="2KI 8:18"/><verse number="19" style="v" sid="2KI 8:19"/>ግዶሽን፥ ባ አይልያ ዳዊታ ግሾ፥ ጎዳይ ይሁዳ ይሳናዉ ኮይቤና፤ ዳዊታ ኮቻይ መርናዉ ካዎታናዉ ደኤይሳ ጎዳይ ኡፋይሳ ቃላ እሚስ።<verse eid="2KI 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 8:20"/>እዮራም ካዎትዳ ዎደ፥ ኤዶመ አሳይ ይሁዳ ካዋ ቦላ ማካልድ፥ ባንታዉ ካዎ ካዎይዶሶና። <verse eid="2KI 8:20"/><verse number="21" style="v" sid="2KI 8:21"/>ሄሳ ግሾ፥ እዮራም ባ ፓራ ጋረታ ኡባራ ፃእራ ጌተትያ በሳ ብስ። ኤዶመ አሳት እያነ እያ ፓራ ጋረታ ሀላቃታ ተቅዶሶና፤ ሽን እዮራም ቃማ ደንድድ፥ ከስ ኤክድ ብስ። እያ ኦላንቾት ባቃትድ፥ ጉየ ሶ ስምዶሶና። <verse eid="2KI 8:21"/><verse number="22" style="v" sid="2KI 8:22"/>ሄ ዎደፐ ዶምድ ሀች ጋካናዉ፥ ኤዶመ አሳይ ይሁዳ አሳስ ሃረትቦኮና። ልብና አሳይ ቃስ ሄ ዎደ ማካልስ።<verse eid="2KI 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 8:23"/>እዮራም ሀንዳ ሀራባይነ እ ኦዳባ ኡባይ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 8:23"/><verse number="24" style="v" sid="2KI 8:24"/>እዮራም ሀይቅድ፥ ባ ማይዛታን ጋሄትስ። ባ ማይዛ ዳዊታ ካታማን ሞገትስ፤ እያ በሳን እያ ናአይ አካዝያስ ካዎትስ።<verse eid="2KI 8:24"/></para>
  <para style="s1">ይሁዳ ካዋ አካዝያሳ</para>
  <para style="r">(<ref loc="2CH 22:1-6">2 ታር 22:1-6</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 8:25"/>አካባ ናአይ፥ እስራኤለ ካዎይ እዮራም ካዎትዳ ታማነ ናምአን ላይን፥ ይሁዳ ካዋ፥ እዮራማ ናአይ አካዝያስ ይሁዳን ካዎትስ። <verse eid="2KI 8:25"/><verse number="26" style="v" sid="2KI 8:26"/>አካዝያስ ካዎትዳ ዎደ፥ እያዉ ላይ ላታማነ ናምአ፤ እ የሩሳላመን እስ ላይ ካዎትስ። እያ አየ ሱንይ ጎቶሎ፤ እያ እስራኤለ ካዋ ኦምራ ናኣ ናእዉ። <verse eid="2KI 8:26"/><verse number="27" style="v" sid="2KI 8:27"/>እ ኤንታዉ ቦሎ ግድዳ ግሾ፥ አካባ ሶ አሳ ኦግያን ሄመትስ፤ አካባ ሶ አሳይ ኦዳይሳዳ፥ እ ጎዳ ስንን ኢታባ ኦስ።<verse eid="2KI 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 8:28"/>አካዝያስ አራመ ካዋ አዛሄላራ ጋላዳን ደእያ ራሞታ ካታማን ኦለታናዉ ብድ፥ አካባ ናኣ እዮራማራ እስፈ ብን፥ አራመ አሳት እዮራማ ጫድዶሶና። <verse eid="2KI 8:28"/><verse number="29" style="v" sid="2KI 8:29"/>እዮራም አራመ ካዋ አዛሄላራ ኦለትያ ዎደ፥ አራመ አሳት ጫድዳ ጫቻፈ ፓፃናዉ እዝራኤለ ስምስ። እዮራማ ናአይ፥ ይሁዳ ካዎይ አካዝያስ፥ ጫደትዳ አካባ ናኣ እዮራማ ኦይቻናዉ ዱገ እዝራኤለ ብስ።<verse eid="2KI 8:29"/></para>
  <chapter eid="2KI 8"/>
  <chapter number="9" style="c" sid="2KI 9"/>
  <para style="s1">እዩ ትየተ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 9:1"/>ናበይ ኤልስ ናበታ ጩጋፐ እስ አስ ፄግድ፥ “ነ ማኡዋ ማአዳ፥ ፃሮ ዛይትያ ነ ኩሸን ኦይካዳ፥ ጋላዳን ደእያ ራሞታ ባ። <verse eid="2KI 9:1"/><verse number="2" style="v" sid="2KI 9:2"/>ያ ጋካዳ፥ እዮሳፈፃ ናኣ፥ ናምሳ ናኣ ናኣ እዩ ኮያ። እያ ደማዳ፥ እያ ላገታፐ እያ ሻካዳ ቆልአ ገልሳ። <verse eid="2KI 9:2"/><verse number="3" style="v" sid="2KI 9:3"/>ሄሳፈ ጉየ፥ ፃሮ ዛይትያ ኤካዳ፥ እያ ሁጵያን ትጋዳ፥ ‘ነና እስራኤለ ቦላ ካዎ ኦ ትያና መላ ጎዳይ ታና ኪትስ’ ያጋ። ያታዳ ፐንግያ ዶያዳ፥ ኤለሳዳ ባቃታ” ያግስ።<verse eid="2KI 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 9:4"/>ሄሳ ግሾ፥ ፓን ናበይ ጋላዳን ደእያ ራሞታ ብስ። <verse eid="2KI 9:4"/><verse number="5" style="v" sid="2KI 9:5"/>እ ያ ጋክዳ ዎደ ቶራ ሞጮናይ እስፈ ዞረትሽን ደምድ፥ “ጎዳዉ፥ ታኒ ነዉ ኦድያባይ ደኤስ” ያግስ።</para>
  <para style="p" vid="2KI 9:5">እዩይ፥ “ኑ ግዶፈ ኦደስ ኦዳኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 9:5">ናበይ፥ “ጎዳዉ፥ ነዉ ኦዳና” ያግድ ዛርስ። <verse eid="2KI 9:5"/><verse number="6" style="v" sid="2KI 9:6"/>እዩይ ደንድድ ሶ ገልን፥ ናበይ እያ ሁጰን ዛይተ ትግድ፥ “ጎዳይ እስራኤለ ፆሳይ፥ ነና ሀይሳዳ ያጌስ፥ ‘ኔኒ ጎዳ ደርያ፥ እስራኤለ ቦላ ካዎታና መላ ታኒ ነና ትያስ። <verse eid="2KI 9:6"/><verse number="7" style="v" sid="2KI 9:7"/>ኔኒ ነ ጎዳ አካባ ኮቻ ይሳና። ታኒ ኤልዛቤላ ጉስዳ ናበታ፥ ታ አይለታ ሱነ ታ ሀራ አይለታ ሱ ሃሉዋ ከሳና። <verse eid="2KI 9:7"/><verse number="8" style="v" sid="2KI 9:8"/>አካባ ኮቻ ኡባይ ያና፤ ታኒ እስራኤለን አካባ ኮቻፈ አይለ ግድን፥ ዎማኖ ግድን፥ አደ ኡባ ይሳና። <verse eid="2KI 9:8"/><verse number="9" style="v" sid="2KI 9:9"/>አካባ ኮቻ ናባፃ ናኣ እዮርባማ ኮቻዳነ አክያ ናኣ ባኦሳ ኮቻዳ ኦና። <verse eid="2KI 9:9"/><verse number="10" style="v" sid="2KI 9:10"/>ኤልዛቤሎ፥ እዝራኤላ ጎሻን ካናት ማና፤ ኦንካ እዮ ሞገና’ ” ያግስ። ሄሳ ኦድዳፐ ጉየ፥ ፐንግያ ዶይድ ባቃትስ።<verse eid="2KI 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 9:11"/>እዩይ ባ ላገ ግድዳ ቶራ ሞጮናታኮ ብዳ ዎደ፥ ኤንቲ፥ “ሳእ ሳሮ? ሀ ጎሻይ ኔኮ አይስ ይዴ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 9:11">እዩይ፥ “ሀ አድያባነ እያ ኦዳ ህንተ ኤሬታ” ያግስ።<verse eid="2KI 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 9:12"/>ኤንቲ፥ “ሀይስ ዎርዶ። አነ ኔኒ ኑስ ኦዳ” ያግዶሶና።</para>
  <para style="p" vid="2KI 9:12">እዩይ፥ “ኔኒ እስራኤለ ቦላ ካዎ ግዳና መላ ታኒ ነና ትያናዳ ጎዳይ ታና ኪትስ” ያግስ።<verse eid="2KI 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 9:13"/>ሄ ዎደ ኤንቲ ባንታ ማኡዋ ቃርድ፥ እዩይ የድ ከይያ ደን ሂፅድ፥ ሞይዘ ፑንዶሶና። ባንታ ቃላ ቁ ኦድ፥ “እዩይ ካዎትስ” ያግዶሶና።<verse eid="2KI 9:13"/></para>
  <para style="s1">ካዋ እዮራማ ሀይቁዋ</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 9:14"/>እዮሳፈፃ ናአይ፥ ናምሳ ናኣ ናአይ እዩይ፥ እዮራማ ቦላ ማቀትስ። ሄስ ሀንያ ዎደ፥ እስራኤለ አሳ ኡባይ አራመ ካዋ አዛሄላ ጋላዳን ደእያ ራሞታን ናጋናዉ ብዶሶና። <verse eid="2KI 9:14"/><verse number="15" style="v" sid="2KI 9:15"/>ሽን ኤንታፈ ካዎይ እዮራም ሶረ ካዋ አዛሄላራ ኦለትዳ ዎደ፥ አራመ ቢታ አሳይ እያ ጫድዳ ጫቻስ እዝራኤለ ይስ።</para>
  <para style="p" vid="2KI 9:15">እዩይ ሀላቃታ፥ “ህንተ ቆፋይ ሄሳ ግድኮ፥ ሀ ካታማፐ እስ አስካ ከይድ፥ እዝራኤለ ካታማን ሀ ኦዳ ኦዶናዳ ተቅተ” ያግስ። <verse eid="2KI 9:15"/><verse number="16" style="v" sid="2KI 9:16"/>ሄሳፈ ጉየ፥ እዩይ ፓራ ጋርያን ከይድ፥ እዝራኤለ ብስ። እዮራም ፓፅቦናይስ ያን ሸምፔስ። ቃስ ይሁዳ ካዎይ አካዝያስ እያ ኦይቻናዉ ያ ዱገ ብስ።<verse eid="2KI 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 9:17"/>እዝራኤላ ግምብያ ቦላ ኤቅድ ዎቸይሳ ፄግድ፥ “እስ ጩጋ የይሳ ታዉ በንቴስ” ያግስ።</para>
  <para style="p" vid="2KI 9:17">እዮራም፥ “ኤንታራ ጋሄታናዳ እስ ፓራ የዳ። ፓራዋይ ብድ፥ ‘ሳእ ሳሮ?’ ያጎ” ያግስ።<verse eid="2KI 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 9:18"/>ፓራዋይ እዩራ ጋሄታናዉ ብድ፥ “ካዎይ ነና፥ ‘ሳአይ ሳሮ?’ ያጌስ” ያግስ።</para>
  <para style="p" vid="2KI 9:18">እዩይ፥ “ሳሮባን ነና ጋያባይ ባዋ። ታ ጉየ አዳ ታና ካላ” ያግድ ዛርስ።</para>
  <para style="p" vid="2KI 9:18">ዎቸይስ ካዋ፥ “ኪተትዳይስ ኤንታኮ፥ ጋክስ፤ ሽን ጉየ ስምቤና” ያግድ ኦድስ።<verse eid="2KI 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 9:19"/>ሄሳ ግሾ፥ ካዎይ ናምአን ፓራዋ ኤንታኮ ኪትስ። እ ኤንታኮ ይድ፥ “ካዎይ ህንተና፥ ‘ሳእ ሳሮ?’ ያጌስ” ያግስ።</para>
  <para style="p" vid="2KI 9:19">እዩይ፥ “ነዉ ሳሮራ አይ ጋሄተ ደኢ? ታ ጉየ አዳ ታና ካላ” ያግስ።<verse eid="2KI 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 9:20"/>ዎቸይስ፥ “ናምአን ፓራዋይ ኤንታኮ ጋክስ፤ ሽን ጉየ ስሚድ ይቤና። ቃስ ጋርያ ላጎይ ናምሳ ናኣ ናኣ እዩ ላጉዋ መላ፤ እ ጎያ አሳዳ ላጌስ” ያግድ ኦድስ።<verse eid="2KI 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 9:21"/>ካዎይ እዮራም፥ “ታዉ ፓራ ጋረ ጊግስተ” ያግድ ኪትስ። ኤንቲ ፓራ ጋረ ጊግስዶሶና፤ እስራኤለ ካዎይ እዮራም ይሁዳ ካዎይ አካዝያስ ባንታ ጋርያን ጋርያን ኡትድ፥ እዩራ ጋሄታናዉ ብድ፥ እዝራኤለ ናቡተ ጋደን እያ ደምዶሶና። <verse eid="2KI 9:21"/><verse number="22" style="v" sid="2KI 9:22"/>እዮራም እዩ በእዳ ዎደ፥ “እዩ፥ ሳእ ሳሮ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 9:22">እዩይ፥ “ነ አየ ኤልዛቤል ላይማተይነ ብታይ ደእሽን፥ ሳሮይ አዉን ደኢ?” ያግድ ዛርስ።<verse eid="2KI 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 9:23"/>እዮራም ባ ፓራ ጋርያ ጉየ ዛሪድ ባቃትድ፥ አካዝያሳ ፄግድ፥ “አካዝያሳ፥ ሀይስ ማካላ” ያግስ። <verse eid="2KI 9:23"/><verse number="24" style="v" sid="2KI 9:24"/>እዩይ፥ ባ ዶንግያ ባ ኩመ ዎልቃን ዳፍድ፥ እዮራማ ናምኡ ካትሶታፐ ግዶን ዱክስ። ዶንገ ቶራይ እያ ዎዛናራ ካንድ ከይን፥ ባ ጋርያ ግዶን ኩንድስ። <verse eid="2KI 9:24"/><verse number="25" style="v" sid="2KI 9:25"/>እዩይ ቶራ ሞጮና ብድቃራኮ፥ “እዮራማ ደንዳ፥ ናቡተ ጋደን ኦላ። ኔራ ታራ እስፈ እዮራማ አዋ አካባ ካልድ ቶግድ ብሽን፥ ጎዳይ እያ ቦላ ትንብተ ኦድዳይስ አኬካ። <verse eid="2KI 9:25"/><verse number="26" style="v" sid="2KI 9:26"/>ሄ ዎደ ጎዳይ፥ ‘ናቡተ ሱነ እያ አደ ናይታ ሱ ታኒ ዝነ በአስ፤ ሄሳ አጩዋ ታኒ ነና ቱማ ሀ ጋደን ቃንፅሳና’ ያግስ። ሀእ ስሚድ ጎዳይ ግዳይሳዳ፥ እዮራማ ደንዳ፥ ሀ ጋደን ሆላ” ያግስ።<verse eid="2KI 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 9:27"/>ይሁዳ ካዎይ አካዝያስ ሄሳ በእዳ ዎደ፥ ቤት-ሀጋና ባቃትስ። እዩይ እያ ካልድ የደድ፥ “እያካ ዎተ” ያግስ። ኤንቲ እያ ካልድ፥ ይብላማ ማታን ደእያ ጉራ ፑደን እያ ጋርያ ቦላ ጫድዶሶና። እ ማግዶ ባቃትድ፥ ያን ሀይቅስ። <verse eid="2KI 9:27"/><verse number="28" style="v" sid="2KI 9:28"/>እያ አይለት ጋርያን እያ ኤክድ፥ የሩሳላመ ኤፍዶሶና፤ እያ ማይዛታ ማታን ዳዊታ ካታማን ሞግዶሶና።<verse eid="2KI 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 9:29"/>አካባ ናአይ እዮራም ካዎትዳ ታማነ እስን ላይን አካዝያስ ይሁዳን ካዎትስ።<verse eid="2KI 9:29"/></para>
  <para style="s1">ኤልዛቤል ሀይቁዋ</para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 9:30"/>ሄሳፈ ጉየ፥ እዩይ እዝራኤላ ብስ። ኤልዛቤላ ሄሳ ስእዳ ዎደ፥ ባ አይፍያ ትያዳ፥ ባ ሁጵያ ፕፃዳ፥ ማስኮትያራ ዱገ ኦግያ ፄላሱ። <verse eid="2KI 9:30"/><verse number="31" style="v" sid="2KI 9:31"/>እዩይ ፐንገራ ገልሽን፥ “ላ ነ ጎዳ ዎዳ ዘምራ ሀይሳ ሳሮ ያዲ?” ያጋሱ።<verse eid="2KI 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 9:32"/>እዩይ ፑደ ማስኮትያኮ ፄልድ፥ “ታ ባጋ ግዳናይ ኦኔ? ኦኔ?” ያግስ። ናምኡ ዎይኮ ሄ ሹፋት እያ ፄልዶሶና። <verse eid="2KI 9:32"/><verse number="33" style="v" sid="2KI 9:33"/>እዩይ፥ “እዮ ዱገ ሆልተ” ያግስ። ኤንቲ እዮ ዱገ ሆልዶሶና። እ ሱይ ጎዳ ቦላነ ፓራታ ቦላ ርጨትስ፤ ፓራት ባንታ ቶሁዋን እዮ የዶሶና።<verse eid="2KI 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 9:34"/>እዩይ ካዋ ኬ ገልድ፥ ምስነ ኡይስ። እ፥ “ሀ ባደትዳ ማጫስዉ ኤፍድ ሞግተ፤ አይ ግድኮካ እያ ካዎ ናአ” ያግስ። <verse eid="2KI 9:34"/><verse number="35" style="v" sid="2KI 9:35"/>ሽን ኤንቲ እዮ ሞጋናዉ ብድ፥ እ ጉግያፈ፥ ቶሆታፐነ ኩሸታፐ አትሽን፥ ሀራባ ደምቦኮና።<verse eid="2KI 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 9:36"/>ኤንቲ ስሚድ፥ እያዉ ኦድዶሶና፤ እ፥ “ጎዳይ ባ አይልያ ትስባ ኤልያሳ ባጋራ፥ ‘እዝራኤለ ጋደን ኤልዛቤል አሹዋ ካናት ማና። <verse eid="2KI 9:36"/><verse number="37" style="v" sid="2KI 9:37"/>አትዳይስ እዝራኤላን ፕቶ መላ የገታና። ሄሳ ግሾ ኦንካ፥ “ሀና ኤልዛቤሎ” ጋናዉ ዳንዳኤና’ ያግድ ኦድዳ ቃላይ ሀይሳ” ያግስ።<verse eid="2KI 9:37"/></para>
  <chapter eid="2KI 9"/>
  <chapter number="10" style="c" sid="2KI 10"/>
  <para style="s1">አካባ ኮቻ ኡባይ ሀይቅስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 10:1"/>አካባስ ሳማረ ካታማን ላፑን ታሙ አደ ናይት ደኦሶና። እዩይ ሳማረ ካታማ ሀላቃታስ፥ ጭማታስነ አካባ ኮቻታ ድቸይሳታስ ሀይሳዳ ያግድ ዳብዳበ ፃፍስ። <verse eid="2KI 10:1"/><verse number="2" style="v" sid="2KI 10:2"/>“ህዛ ህንተ ጎዳ ኮቻት፥ ፓራት፥ ፓራ ጋረት፥ ዩሾይ ግምበትዳ ካታማትነ ኦላ ሚሸት ህንተዉ ደእያ ግሾ፥ ሀ ዳብዳበይ ህንተና ጋክዳ መላ፥ <verse eid="2KI 10:2"/><verse number="3" style="v" sid="2KI 10:3"/>ህንተ ጎዳ ናይታፐ ሎኦ ግድዳይሳ ዶርድ፥ እያ አዋ አራታን ኡትስተ፤ ህንተ ጎዳ ኬስ ኦለትተ” ያግስ።<verse eid="2KI 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 10:4"/>ሽን ኤንቲ ዳሮ ያይድ፥ “ሄኮ፥ ናምኡ ካዎት እያ ስንን ኤቃናዉ ዳንዳእቦኮና፥ ሽን ኑኒ ዋንድ ኤቃኔ?” ያግዶሶና። <verse eid="2KI 10:4"/><verse number="5" style="v" sid="2KI 10:5"/>ሄሳ ግሾ፥ ካዎ ጋ አዋተን አይሰይስ፥ ካታማ ሀላቃይ፥ ጭማትነ አካባ ኮቻታ ድቸይሳት፥ እዩኮ ሀይሳዳ ያግድ ኪትዶሶና፤ “ኑኒ ነ አይለታ፤ ኔኒ ግያባ ኡባ ኑኒ ኦና። ኑ ቦላ ኦናካ ካዎዮኮ። ነና ሎእዳባ አይባካ ኦ” ያግድ ኪትዶሶና።<verse eid="2KI 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 10:6"/>እዩይ ኤንታዉ ናምአን ዳብዳበ ፃፍሸ፥ “ህንተ ታ ባጋ ግድድ፥ ታዉ ኪተታናዉ ጊግዳባ ግድኮ፥ ህንተ ጎዳ ናይታ ቆያ ሙጭተ፤ ኤንታ ጉግያ ኤክድ፥ ዎንቶ ሀኖደ እዝራኤለ ዪተ” ያግስ። ላፑን ታሙ ካዋ ኮቻት ባንታና ድችያ፥ ካታማን ኤረትዳ አሳታራ ደኦሶና። <verse eid="2KI 10:6"/><verse number="7" style="v" sid="2KI 10:7"/>ሄ ካዋ ኮቻታ ድችያ አሳታኮ ዳብዳበይ ጋክዳ ዎደ፥ ላፑን ታሙ ካዋ ኮቻታ ዎዶሶና። ኤንታ ቆያ ሙጭድ፥ ኤንታ ጉግያ ኬሸን ኤክድ፥ እዝራኤላን ደእያ እዩስ የድዶሶና።<verse eid="2KI 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 10:8"/>ኪተትዳ አሳይ፥ “ኤንቲ ካዋ ኮቻታ ጉግያ ኤክድ ይዶሶና” ያግድ እዩስ ኦድዶሶና።</para>
  <para style="p" vid="2KI 10:8">እዩይ፥ “ዎንቶ ዎንታ ጋካናዉ፥ ካታማ ገልያ ፐንግያን ኤንታ ናምኡ በሳን ዶርድ ዎተ” ያግድ ኪትስ።<verse eid="2KI 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 10:9"/>ዎንተ ጋላስ ዎንታ እዩይ ካረ ከይድ፥ አሳ ኡባ ስንን ኤቅድ፥ “ህንተ ፅሎ፤ ሄኮ፥ ታ ጎዳ ቦላ ማቀታዳ ዎዳይ ታና። ሽን ሀይሳታ ኡባ ዎዳይ ኦኔ? <verse eid="2KI 10:9"/><verse number="10" style="v" sid="2KI 10:10"/>ጎዳይ አካባ ኮቻታ ቦላ ኦድዳ ቃላፐ እሶይካ ሳአን ዎናይሳ ህንተ ኤርተ። ጎዳይ ባ አይልያ ኤልያሳ ባጋራ ኦድዳባ ፖልስ” ያግስ። <verse eid="2KI 10:10"/><verse number="11" style="v" sid="2KI 10:11"/>ሄሳ ግሾ፥ እዩይ እዝራኤላን አትዳ አካባ ኮቻታ፥ እያ ግታ አሳታ፥ እያ ላገታነ እያ ካህነታ ኡባ፥ እሶይካ አቶና ዎስ።<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="HOS 1:4">ሆሰ 1:4</ref>.</char></note><verse eid="2KI 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 10:12"/>ሄሳፈ ጉየ፥ እዩይ ደንድድ፥ ሳማረ ብድ ሄንንቾታ ሞ ጋክድ፥ <verse eid="2KI 10:12"/><verse number="13" style="v" sid="2KI 10:13"/>ይሁዳ ካዋ አካዝያሳ ዳቦታራ ጋሄትድ፥ “ህንተ ኦኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 10:13">ኤንቲ፥ “ኑኒ አካዝያሳ ዳቦታ፤ ካዋ ኮቻታነ ካወ ኤልዛቤል ናይታ ሳሮናዉ ቦስ” ያግዶሶና።<verse eid="2KI 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 10:14"/>እዩይ ባ አሳታ፥ “ኤንታ ፓፃ ኦይክተ” ያግድ ኪትን፥ ኤንታ ፓፃ ኦይክድ፥ ሄንንቾታ ሞን ደእያ ሃ ኦላ ማታን ኤንታ ኦይታማነ ናምአታ ዎዶሶና፤ እ ኤንታፈ እሱዋካ አሽቤና።<verse eid="2KI 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 10:15"/>እዩይ ሄ በሳፈ ደንድድ፥ ራካባ ናኣ እዮናዳባራ ጋሄትድ፥ እያ ሳሮድ፥ “ታ ቆፋይነ ነ ቆፋይ እስኖ። ኔኒ ታ ባጋ ግዳኔ?” ያግስ።</para>
  <para style="p" vid="2KI 10:15">እዮናዳብ፥ “ኤ ግዳና” ያግድ ዛርስ።</para>
  <para style="p" vid="2KI 10:15">እ “አነ ታ ኩሽያ ኦይካ” ያግስ። እያ ኩሽያ ኦይክን ፑደ ጋርያ ቦላ ከስስ። <verse eid="2KI 10:15"/><verse number="16" style="v" sid="2KI 10:16"/>“ታራ የ፤ ታኒ ጎዳስ ዋናዳ ምሸትያኮ በአ” ያግስ፤ እያ ባ ጋርያ ቦላ ኡትስስ። <verse eid="2KI 10:16"/><verse number="17" style="v" sid="2KI 10:17"/>እዩይ ሳማረ ይዳ ዎደ፥ አካባ ኮቻፈ አትዳ ኡባ ዎስ፤ ጎዳይ ኤልያሳስ ኦድዳ ቃላዳ ኤንታ ይስስ።<verse eid="2KI 10:17"/></para>
  <para style="s1">ባኣለ ናበታ ሀይቁዋ</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 10:18"/>ሄሳፈ ጉየ፥ እዩይ አሳ ኡባ እስፈ ሺሽድ፥ “አካብ ባኣለ ኤቃ ጉራ ጎይንስ፤ ሽን ታኒ እያፐ ዳሮ ጎይናና። <verse eid="2KI 10:18"/><verse number="19" style="v" sid="2KI 10:19"/>ሀእ ባኣለ ናበታ፥ እያ ጎይነይሳታ፥ እያ ካህነታ ኡባ ፄግድ ሺሽተ። ኤንታፈ እስ አስካ ፓጮናዳ ናግተ። ታኒ ባኣለ ኤቃስ ዳሮ ያርሾ ያርሻና ሀናይስ። ሄ በሳ ዮና አስ ፓፃ አተና” ያግስ። ሽን እዩይ ባኣለ ኤቃ ጎይነይሳታ ጭምድ ይሳናዉ ሄሳ ኦስ።<verse eid="2KI 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 10:20"/>እዩይ፥ “ባኣለ ኤቃ ጎይናና ጋላሳ አዋጅተ” ያግን፥ ኤንቲ አዋጅዶሶና። <verse eid="2KI 10:20"/><verse number="21" style="v" sid="2KI 10:21"/>ሄሳፈ ጉየ፥ እዩይ እስራኤለ ቢታ ኡባ ኪትን፥ ባኣለ ኤቃ ጎይነይሳታፐ እስ አስካ አቶና ኡባይ ይዶሶና። ኡባይ ባኣለ ኤቃ ኬ ጋፃፐ ጋፃ ጋካናዉ ቅልፅ ግድ ኩምስ።<verse eid="2KI 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 10:22"/>እዩይ፥ ማኦ ኬ ናግያ አድያኮ፥ “ባኣለ ጎይነይሳታ ኡባስ ማኦ ከሳ” ያግስ። አደይ ኤንታዉ ማኦ ኤህስ።<verse eid="2KI 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 10:23"/>ሄሳፈ ጉየ፥ “እዩይነ ራካባ ናአይ እዮናዳብ ባኣለ ኤቃ ኬ ገልዶሶና። እዩይ፥ ባኣለ ኤቃ ጎይነይሳታፐ አትሽን፥ ጎዳ አይለታፐ እስ አስካ ህንተ ግዶን ዶናዳ ፄልተ” ያግስ። <verse eid="2KI 10:23"/><verse number="24" style="v" sid="2KI 10:24"/>ሄሳፈ ጉየ፥ ኤንቲ ፁሳ ያርሾታነ ሀራ ያርሾታ ያርሻናዉ ግዶ ገልዶሶና።</para>
  <para style="p" vid="2KI 10:24">እዩይ ባኣለ ኤቃ ኬፈ ካረራ ሆስፑን ታሙ አሳታ ጊግስድ ዎስ። ኤንታኮ፥ “ህንተፈ እስ አደይ ታኒ ህንተ ኩሸን እምያ አሳፐ እሱዋ የድኮ፥ እያ ሸምፖይ ሄ አድያ ሸምፑዋ በሳን ገላና” ያግስ።<verse eid="2KI 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 10:25"/>እዩይ ፁሳ ያርሹዋ ፖልዳፐ ጉየ፥ ናገይሳታነ ሀላቃታ፥ “ግዶ ገልድ፥ ኤንታ ዎተ። ኤንታፈ እስ አስካ ከስ ኤኮና መላ” ያግድ ኪትን፥ ኤንታ ማሻን ዉርስዶሶና። ኤንታ አሀ ካረ ጎችድ ከስዶሶና፤ ባኣለ ኤቃ ኬ ቆልአ ገልዶሶና። <verse eid="2KI 10:25"/><verse number="26" style="v" sid="2KI 10:26"/>ባኣለ ኤቃ ኬፈ ኤቃ ቱሳታ ከስድ ፁግዶሶና። <verse eid="2KI 10:26"/><verse number="27" style="v" sid="2KI 10:27"/>ባኣለ ኤቃ ሹቻታ ትንቸረዶሶና፤ ባኣለ ኤቃ ኬካ ላልዶሶና። ሄ በሳ ሼሻ ኬ ከስዶሶና፤ ሀች ጋካናዉ ሄ በሳይ ሼሻ ኬ ግድድ አትስ።<verse eid="2KI 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 10:28"/>ሄሳዳ ኦድ፥ እዩይ ባኣለ ኤቃ እስራኤለፐ ይስስ። <verse eid="2KI 10:28"/><verse number="29" style="v" sid="2KI 10:29"/>ግዶሽን፥ ናባፃ ናአይ እዮርባም እስራኤለ አሳ ኦስስዳ ናጋራ ኦሶ አግቤና። ቤተለንነ ዳነን እዮርባም ኤስዳ ዎርቃ ማራ ምስለታ ጎይንስ።<note caller="-" style="x"><char style="xo" closed="false">10:29 </char><char style="xt" closed="false"><ref loc="1KI 12:28-30">1 ካዎ 12:28-30</ref>.</char></note><verse eid="2KI 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 10:30"/>ጎዳይ እዩኮ፥ “ኔኒ ታ ስንን ሱረባ ኦዳ ግሾነ ታ ቆፋን ደእያባ ኡባ ኔኒ አካባ ኮቻታ ቦላ ፖልዳ ግሾ፥ ነ ኮቻት ኦይዳን የለታ ጋካናዉ፥ እስራኤለ አራታን ኡታና” ያግስ። <verse eid="2KI 10:30"/><verse number="31" style="v" sid="2KI 10:31"/>እዩይ ጎዳ እስራኤለ ፆሳ ህግያ ባ ኩመ ዎዛናፐ ምንድ ናግቤና፤ ቃስ እስራኤለ አሳ ናጋራ ኦስስዳ እዮርባማ ናጋራፐ ሃክቤና።<verse eid="2KI 10:31"/></para>
  <para style="s1">እዩ ሀይቁዋ</para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 10:32"/>ሄ ዎደ ጎዳይ እስራኤለ ቢታፈ ባጋ ሻኮ ዶምስ። አራመ ካዎይ አዛሄል እስራኤለ ቢታፈ ዳሮ በሳታ ፆንድ ኦይክስ። <verse eid="2KI 10:32"/><verse number="33" style="v" sid="2KI 10:33"/>ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋራ ደእያ ጋላዳነ ባሳነ ቢታ ኡባ ኦይክስ። ሄ ቢታይ አርኖና ሻፋ ማታን ደእያ አሮኤራ ካታማፐ ዶምድ፥ ሮቤላ ቢታ፥ ጋደ ቢታነ ምናሰ ቢታ ጋኬስ።<verse eid="2KI 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 10:34"/>እዩይ ሀንዳ ሀራባይ፥ ኦዳባ ኡባይነ እያ ምኖተይ ኡባይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 10:34"/><verse number="35" style="v" sid="2KI 10:35"/>ሄሳፈ ጉየ፥ እዩይ ሀይቅድ፥ ባ ማይዛታን ጋሄትስ፤ እ ሳማረን ሞገትስ። እያ በሳን እያ ናአይ እዮአካዝ ካዎትስ። <verse eid="2KI 10:35"/><verse number="36" style="v" sid="2KI 10:36"/>እዩይ ሳማረን ኡትድ እስራኤለ ቦላ ላታማነ ሆስፑን ላይ ካዎትስ።<verse eid="2KI 10:36"/></para>
  <chapter eid="2KI 10"/>
  <chapter number="11" style="c" sid="2KI 11"/>
  <para style="s1">ይሁዳ ካውዉ ጎቶሎ</para>
  <para style="r">(<ref loc="2CH 22:10-23:15">2 ታር 22:10—23:15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 11:1"/>አካዝያሳ አይያ ጎቶላ ባ ናአይ ሀይቅዳይሳ በእዳ ዎደ፥ ደንዳዳ ካዋ ኮቻ ኡባ ይሳሱ። <verse eid="2KI 11:1"/><verse number="2" style="v" sid="2KI 11:2"/>ሽን ካዋ እዮራማ ናእያ፥ አካዝያሳ ምችያ ዮሳቤታ፥ ሀይቃናዉ ደእያ ካዋ ናይታ ግዶፈ አካዝያሳ ናኣ እዮኣሳ ካይሳዳ ኤካሱ። እያነ እያ ድችያሮ ኤፋዳ ኬን ቆሳዳ፥ ጎቶላ ዎናዳ አሻሱ። <verse eid="2KI 11:2"/><verse number="3" style="v" sid="2KI 11:3"/>ጎቶላ ቢታ ሃርያ ዎደ ኡባን፥ ናአይ ዮሳቤት ማታን፥ ፆሳ ኬን ኡሱፑን ላይ ቆሰትድ ደእስ።<verse eid="2KI 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 11:4"/>ላፑን ላይን ዮዳሄይ ካዋ ናገይሳታነ ካዎ ጋ ናገይሳታ ሀላቃታስ ኪትድ፥ ባኮ ፆሳ ኬ ኤህስ። ኤንታራ ጫቅድ፥ ኤንታ ፆሳ ኬን ጫቅስስ፤ ኤንታ ካዋ ናኣ እዮኣሳ በስስ። <verse eid="2KI 11:4"/><verse number="5" style="v" sid="2KI 11:5"/>እ ኤንታ፥ “ህንተ ኦናባይ ሀይሳ፤ ሳምባታን ናጋናዉ ገልያ ማራይ ጋክዳ ህንተ ሄ ጩጋፐ እስ ጩጋ ካዋ ኬ ናጎ። <verse eid="2KI 11:5"/><verse number="6" style="v" sid="2KI 11:6"/>እስ ጩጋይ ሱራ ፐንግያ ናጎ፤ እስ ጩጋ ናገይሳታፐ ጉየ ባጋራ ደእያ ፐንግያ ናጎ። <verse eid="2KI 11:6"/><verse number="7" style="v" sid="2KI 11:7"/>ሳምባታ ጋላስ ናጎፐ ከይያ ሀንኮ ናምኡ ጩጋይ ኩመ ካዋ ቦላ መቶይ ጋኮና መላ ፆሳ ኬ ናጎ። <verse eid="2KI 11:7"/><verse number="8" style="v" sid="2KI 11:8"/>ኦላ ሚሸ ኦይክድ፥ ካዋ ግዶን ዎድ፥ ካዎይ ከይያ ዎደነ ገልያ ዎደ ኡባን እያራ እስፈ ደኦ። ህንተኮ ሺቅያ ኦናካ ዎተ” ያግስ።<verse eid="2KI 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 11:9"/>ሄ ሀላቃት፥ ካህነይ ዮዳሄ ኪትዳባ ኡባ ኦዶሶና። ኤንቲ ኡባይ ሳምባታ ጋላሳን ናጎ ማራይ ጋክዳይሳታነ ናጉዋ ማራ ፖልዳይሳታ ኤክድ፥ ካህንያ ዮዳሄኮ ይዶሶና። <verse eid="2KI 11:9"/><verse number="10" style="v" sid="2KI 11:10"/>ካህነይ ፆሳ ኬን ደእያ፥ በን ካዋ ዳዊታ ጎንዳለታነ ቶራታ ኡባ ሀላቃታስ እሚስ። <verse eid="2KI 11:10"/><verse number="11" style="v" sid="2KI 11:11"/>ናገይሳት እሶይ እሶይ ኦላ ሚሸታ ባንታ ኩሸን ኦይክድ፥ ፆሳ ኬፈ ሀድርሳ ባጋፈ ዶምድ፥ ኡሻቻ ባጋ ጋካናዉ፥ ያርሾ በሳ ማታንነ ፆሳ ኬ ማታን ካዋ ዩሹዋን ኤቅዶሶና። <verse eid="2KI 11:11"/><verse number="12" style="v" sid="2KI 11:12"/>ዮዳሄይ ካዋ ናኣ ካረ ከስድ፥ እያ ሁጰን ካላቻ ዎስ። ህገ ማፃፋ እያዉ እምድ፥ ትይድ፥ እያ ካዎስ። አሳይ ኩሸ ባቅድ፥ ባ ቃላ ቁ ኦድ፥ “ካዎይ ብራታ ቱሱ ግዶ!” ያግስ።<verse eid="2KI 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 11:13"/>ካውያ ጎቶላ ናገይሳታ ዎጫማነ አሳ ዎጫማ ስእዳ ዎደ፥ አሳኮ ፆሳ ኬ ባሱ። <verse eid="2KI 11:13"/><verse number="14" style="v" sid="2KI 11:14"/>ካዎይ ካሰ ካዎት ሀነይሳዳ ቱሳ ማታን ኤቅድይሳ በአሱ። ሀላቃትነ ሞይዘ ፑነይሳት ካዋ ማታን ደኦሶና። ሄ ቢታ አሳ ኡባይ ኡፋይትድ፥ ሞይዘ ፑንን፥ ጎቶላ ባ ማኡዋ ዳካዳ፥ “ሄኮ፥ ሀይስ ማካላ! ሀይስ ማካላ!” ያጋዳ ዋሳሱ።<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="2KI 23:3">2 ካዎ 23:3</ref>.</char></note><verse eid="2KI 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 11:15"/>ካህነይ ዮዳሄይ ቶራ ሞጮናታኮ፥ “ጎቶሎ ፆሳ ኬን ዎፕተ! ኢፐ ያራነ ሃራ ሳልፕዳ ሳልፐታ ግዶን ዎተ፤ እዮ አሻናዉ ቆፕያ አስ ደእኮ ዎተ!” ያግስ። <verse eid="2KI 11:15"/><verse number="16" style="v" sid="2KI 11:16"/>ኤንቲ እዮ ኦይክድ፥ ካዎ ጋ ኤፍድ፥ ፓራ ፐንግያን እዮ ዎዶሶና።<verse eid="2KI 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 11:17"/>አሳይ ጎዳ አስ ግዳና መላ፥ ካዎይ ዮዳሄይነ አሳይ ጎዳራ ጫቃና መላ ኦስ። ቃስ ካዋፐነ አሳፐ ግዱዋን ጫቅስስ። <verse eid="2KI 11:17"/><verse number="18" style="v" sid="2KI 11:18"/>ሄ ዎደ ይሁዳ አሳ ኡባይ ባኣለ ኤቃ ኬ ብድ፥ ሄ ኬ ላልስ፤ ያርሾ በሳታነ እያ ምስለታ ትንቸረስ። ባኣለ ኤቃ ካህንያ ማታና ያርሾ በሳታ ስንን ዎዶሶና።</para>
  <para style="p" vid="2KI 11:18">ሄሳፈ ጉየ፥ ካህንያ ዮዳሄይ ፆሳ ኬን ናገይሳታ ዎስ። <verse eid="2KI 11:18"/><verse number="19" style="v" sid="2KI 11:19"/>ባራ ቶራ ሞጮናታ፥ ካዋ ናገይሳታ፥ ካዎ ጋ ናገይሳታነ ይሁዳ አሳ ኡባ ኤክን፥ ኤንቲ ካዋ ፆሳ ኬፈ ዱገ ኤህስ። ናገይሳታ ፐንግያ ባጋራ ካዎ ኬ እስፈ ገልድ፥ ካዎይ ባ አራታን ኡትስ። <verse eid="2KI 11:19"/><verse number="20" style="v" sid="2KI 11:20"/>ይሁዳ አሳ ኡባይ ኡፋይትዶሶና፤ ጎቶላ ካዎ ጋን ማሻን ሀይቅዳፐ ጉየ ካታማይ ዎፑ ግስ።<verse eid="2KI 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 11:21"/>እዮኣስ ካዎትያ ዎደ ላፑን ላይ ናአ።<verse eid="2KI 11:21"/></para>
  <chapter eid="2KI 11"/>
  <chapter number="12" style="c" sid="2KI 12"/>
  <para style="s1">ይሁዳ ካዋ እዮኣሳ</para>
  <para style="r">(<ref loc="2CH 24:1-16">2 ታር 24:1-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 12:1"/>እዩይ፥ እስራኤለ ቢታን ካዎትዳ ላፑን ላይን፥ እዮኣስ ይሁዳን ካዎትስ፤ እ የሩሳላመን ኦይታሙ ላይ ካዎትስ። እያ አየ ሱንይ ሳቦ፤ እያ በርሳበ ማጫስ። <verse eid="2KI 12:1"/><verse number="2" style="v" sid="2KI 12:2"/>ካህነይ ዮዳሄይ፥ እያ ታማርስዳነ ዞርዳ ግሾ፥ እ ደእዳ ላይ ኡባን እዮኣስ ጎዳ ስንን ሱረባ ኦስ። <verse eid="2KI 12:2"/><verse number="3" style="v" sid="2KI 12:3"/>አሳይ ሄ በሳን ያርሾነ እፃነ ጩይሰ አግቦና ግሾ፥ ቃ ጎይኖ በሳታ ይስቤና።<verse eid="2KI 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 12:4"/>እዮኣስ ካህነታ ፄግድ፥ “ፆሳ ኬ ያ ጌሻ ሚሸ ኡባ ሺሽተ። ሄስካ ሁጰ ታይቡዋ ዎደ እመትያ ሚሽያነ አሳይ ባ ሸነን ፆሳ ኬ ኤህያ ሚሽያ።<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="EXO 30:11-16">ከሳ 30:11-16</ref>.</char></note> <verse eid="2KI 12:4"/><verse number="5" style="v" sid="2KI 12:5"/>ካህነት ኡባይ ሄ ሚሽያ ኤህያ አሳፐ ባንታ ግሹዋ ግሹዋ ኤክድ፥ ፆሳ ኬ ግዶን ኢትዳ ኡባ ሎይና” ያግስ።<verse eid="2KI 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 12:6"/>ሽን ካዎይ እዮኣስ ካዎትዳ ላታማነ ሄን ላይ ጋካናዉ፥ ካህነት ፆሳ ኬ ኦራቦኮና። <verse eid="2KI 12:6"/><verse number="7" style="v" sid="2KI 12:7"/>ካዎይ እዮኣስ ካህንያ ዮዳሄነ ሀራ ካህነታ ፄግድ፥ “ፆሳ ኬ ግዶን ኢትዳ በሳታ አይስ ኦራከቲ? ሚሸ ፆሳ ኬ ኦራናዉ እምተፐ አትሽን፥ ህንተዉ እመትያ ሚሽያ ህንተ ኩሸን ኦይኮፍተ” ያግስ።<verse eid="2KI 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 12:8"/>ካህነት፥ “አሳፐ ሀራ ሚሸ ኤኮኮ፤ ፆሳ ኬ ግዶን ኢትዳ በሳ ኦራና” ያግድ ዛርዶሶና።<verse eid="2KI 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 12:9"/>ያትን፥ ካህንያ ዮዳሄይ እስ ሳፅነ ኤክድ፥ እያ ካማ ሉክድ፥ ያርሾ በሳ ማታን ፆሳ ኬ ገልያ ፐንግያ ኡሻቻ ባጋራ ዎስ። ፐንግያ ናግያ ካህነት ፆሳ ኬ ይዳ ሚሽያ ኡባ ሳፅንያን የጎሶና። <verse eid="2KI 12:9"/><verse number="10" style="v" sid="2KI 12:10"/>ኤንቲ ሳፅንያን ዳሮ ሚሸይ ዳጋየትዳይሳ በእዳ ዎደ ኡባን፥ ካዎ ፃፈይነ ካህነ ሀላቃይ ይድ፥ ሚሽያ ታይብድ፥ ካርፂታን ቆሎሶና።<verse eid="2KI 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 12:11"/>ታይበትዳ ሚሽያ ሳላእዳፐ ጉየ፥ ፆሳ ኬ ኦሱዋ ፄላና መላ ሱንትዳ አሳስ እሞሶና። ኤንቲ ሚሽያ ኤክድ፥ ፆሳ ኬን አናፀታስነ ግምበይሳት እሞሶና። <verse eid="2KI 12:11"/><verse number="12" style="v" sid="2KI 12:12"/>ሚሽያ ሹቹ ማሰይሳታስነ ቆኤይሳታስ ቃንፃናዉ፥ ፆሳ ኬ ኦራናዉ፥ ሳንቃ፥ ሹቹነ ኮሽያ ሀራባታ ሻማናዉ ጎኤቶሶና። <verse eid="2KI 12:12"/><verse number="13" style="v" sid="2KI 12:13"/>ፆሳ ኬ ይዳ ሚሽያፐ ፆሳ ኬ ብራ ቡርጩኮታ፥ ቃጰታ፥ ከረታነ ሞይዘታ ዎይኮ ዎርቃነ ብራ ሚሸታ ኦናዉ ከስቦኮና። <verse eid="2KI 12:13"/><verse number="14" style="v" sid="2KI 12:14"/>ሄ ሚሸ ኡባይ ፆሳ ኬ ኦራያ አሳስ ቃንፀትስ። <verse eid="2KI 12:14"/><verse number="15" style="v" sid="2KI 12:15"/>ፆሳ ኬ ኦሱዋ ፄላናዉ ሱንትዳ አሳት አማነትዳ አስ ግድዳ ግሾ፥ “ሚሽያን አይ አይ ኦደቲ?” ያግድ ኦይችዳ አስ ኦንካ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="2KI 22:7">2 ካዎ 22:7</ref>.</char></note> <verse eid="2KI 12:15"/><verse number="16" style="v" sid="2KI 12:16"/>ናቆ ያርሾነ ናጋራ ያርሾስ ቃንፀትያ ሚሸይ ካህነታስ ገለስፐ አትሽን፥ ፆሳ ኬ ኦራያ ሚሸ ሳፅንያን ገለና።<note caller="-" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="LEV 7:7">ሌወ 7:7</ref>.</char></note><verse eid="2KI 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 12:17"/>ሄ ዎደ አራመ ካዎይ አዛሄል ብድ፥ ጋተ ካታማ ኦልድ ኦይክስ። ካልድ የሩሳላመ ኦላናዉ ስምስ። <verse eid="2KI 12:17"/><verse number="18" style="v" sid="2KI 12:18"/>ሽን ይሁዳ ካዎይ እዮኣስ እያፐ ካሰ ካዎትዳ ይሁዳ ካዎት እዮሳፈፅ፥ እዮራምነ አካዝያስ ጎዳስ ዱማይዳ ሚሸታ፥ ባ እሞታ፥ ፆሳ ኬ እሞታነ ካዎ ጋ ሻሎ ምንጅያ በሳን ደእያ ዎርቃ ኡባ ኤክስ። አራመ ካዋስ አዛሄላስ የድን፥ አዛሄል የሩሳላመ ኦላናዉ ደንዶይሳ አጋግስ።<verse eid="2KI 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 12:19"/>ካዎይ እዮኣስ ሀንዳ ሀራባይነ እ ኦዳባ ኡባይ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 12:19"/><verse number="20" style="v" sid="2KI 12:20"/>ሄሳፈ ጉየ፥ እያ ሞርናት እያ ቦላ ማቀትድ፥ ሲላ ኤፍያ ኦግያን ሚሎ ጌተትያ ኬን ዎዶሶና። <verse eid="2KI 12:20"/><verse number="21" style="v" sid="2KI 12:21"/>እያ ዎዳ ኦሳንቾት ስምአታ ናኣ ዮዛካራነ ሾሜራ ናኣ ዮዛባታ። እዮኣስ ዳዊቲ ካታማን ባ ማይዛታ ዱፎን ሞገትስ፤ እያ በሳን እያ ናአይ አማስያስ ካዎትስ።<verse eid="2KI 12:21"/></para>
  <chapter eid="2KI 12"/>
  <chapter number="13" style="c" sid="2KI 13"/>
  <para style="s1">እስራኤለ ካዋ እዮአካዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 13:1"/>አካዝያሳ ናአይ፥ ይሁዳ ካዎይ እዮኣስ ካዎትዳ ላታማነ ሄን ላይን፥ እዩ ናአይ እዮአካዝ እስራኤለ ቦላ ካዎትስ፤ እ ሳማረን ኡትድ ታማነ ላፑን ላይ ካዎትስ። <verse eid="2KI 13:1"/><verse number="2" style="v" sid="2KI 13:2"/>እ፥ እስራኤለ አሳ ባለዳ እዮርባማ ሶ አሳ ናጋራ ካልድ፥ ጎዳ ስንን ኢታባ ኦስ፤ እ ሄ ናጋራ ኦሶ አግቤና። <verse eid="2KI 13:2"/><verse number="3" style="v" sid="2KI 13:3"/>ሄሳ ግሾ፥ ጎዳ ሀንቆይ እስራኤለ ቦላ ሱልስ፤ ጎዳይ ኤንታ ዳሮ ዎደ አራመ ካዋ አዛሄላ፥ ሄሳዳካ እያ ናኣ ዎልደ-አዳራ ኩሸን አድ እሚስ።<verse eid="2KI 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 13:4"/>ሄሳፈ ጉየ፥ እዮአካዝ ጎዳ ዎስስ። ጎዳይ እያ ዎሳ ስእስ፤ ሶረ ካዎይ እስራኤለ አይ መላ ኢታ መቶን ኡንኤዳኮ ጎዳይ በእስ። <verse eid="2KI 13:4"/><verse number="5" style="v" sid="2KI 13:5"/>እስራኤለ አሳ አሽያ አስ እምን፥ ኤንታ አራመ ኩሸፐ ከስ ኤክዶሶና። እስራኤለ አሳይ ካሰይሳዳ ባንታ ሶን ሳሮን ደእዶሶና። <verse eid="2KI 13:5"/><verse number="6" style="v" sid="2KI 13:6"/>ሄስ ሀንንካ እስራኤለ አሳ ባለዳ እዮርባማ ሶ አሳ ናጋራፐ ስምቦኮና፤ ኤንቲ ሄ ናጋራ ኦሶ አግቦኮና። ቃስ አሼራ ጌተትያ ፆሰ ኤቃ ምስለይ ሳማረን ኤቅድ ደኤስ። <verse eid="2KI 13:6"/><verse number="7" style="v" sid="2KI 13:7"/>እዮአካዛስ እሻታሙ ፓራ አሳታ፥ ታሙ ጋረታ፥ 10,000 ቶሆ ኦላንቾታ፥ ሀራ ኦላንቾታ ፃላል አትዶሶና። አራመ ካዎይ ኤንታ ይስስ፤ እ ኤንታ ዉዱማን ደእያ ሱላዳ ኦስ።<verse eid="2KI 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 13:8"/>እዮአካዝ ሀንዳ ሀራባይ፥ እ ኦዳባ ኡባይነ እያ ምኖተይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 13:8"/><verse number="9" style="v" sid="2KI 13:9"/>እዮአካዝ ሀይቅድ፥ ባ ማይዛታ ጋክስ፤ እያ በሳን እያ ናአይ ዮኣስ ካዎትስ።<verse eid="2KI 13:9"/></para>
  <para style="s1">እስራኤለ ካዋ ዮኣሳ</para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 13:10"/>ይሁዳ ካዎይ እዮኣስ ካዎትዳ ሀስታማነ ላፑን ላይን፥ እዮአካዛ ናአይ ዮኣስ ሳማረን እስራኤለ ቦላ ካዎትስ፤ እ ታማነ ኡሱፑን ላይ ካዎትስ። <verse eid="2KI 13:10"/><verse number="11" style="v" sid="2KI 13:11"/>ዮኣስ ጎዳ ስንን ኢታባ ኦስ። እስራኤለ አሳ ባለዳ ናባፃ ናኣ እዮርባማ ናጋራፐ እሱዋካ አሾና ኦስ፤ እ ሄ ናጋራ ኦሶ አግቤና።<verse eid="2KI 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 13:12"/>ዮኣስ ሀንዳ ሀራባይ፥ እ ኦዳባ ኡባይነ ይሁዳ ካዋ አማስያሳራ ኦለትዳ ኦላይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 13:12"/><verse number="13" style="v" sid="2KI 13:13"/>ዮኣስ ሀይቅድ፥ ባ ማይዛታ ጋክስ፤ ሳማረን እስራኤለ ካዎታራ ሞገትስ። እያ በሳን እያ ናአይ እዮርባም ካዎትስ።<verse eid="2KI 13:13"/></para>
  <para style="s1">ኤልሳ ሀይቁዋ</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 13:14"/>ኤልስ ሀይቆስ ጋያ ሀርገ ሀርገትስ፤ እስራኤለ ካዎይ ዮኣስ እያ በአናዉ ብድ፥ “ታ አዋዉ፤ ታ አዋዉ፥ ኔኒ እስራኤለ አሳስ ዎልቃነ ጎንዳለ!”<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="2KI 2:12">2 ካዎ 2:12</ref>.</char></note> ያግድ ዬክስ።<verse eid="2KI 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 13:15"/>ኤልስ፥ “ዶንገነ ዶንገ ቶራ ኤካዳ ያ” ያግን፥ ዮኣስ ኤህስ።<verse eid="2KI 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 13:16"/>ኤልስ ካዋኮ፥ “ዶንግያ ጊግሳ ኦይካ” ያግስ፤ እ ዶንግያ ጊግስድ ኦይክዳሽን፥ ኤልስ ባ ኩሽያ ካዋ ኩሽያ ቦላ ዎስ።<verse eid="2KI 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 13:17"/>ኤልስ፥ “ዶሎሀ ባጋ ማስኮትያ ዶያ” ያግስ። እ ዶይን፥ ኤልስ፥ “ዶንገ ቶራን ዱካ” ያግስ። እ ዱክን ኤልስ፥ “ሀይስ ጎዳ ዶንገ! ሀይስ አራመ አሳ ፆንያ ዶንገ! ኔኒ አራመ አሳ አፌቃን ፆናና ጋካናዉ ኦላና” ያግስ።<verse eid="2KI 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 13:18"/>ሄሳፈ ጉየ፥ ኤልስ ካዋኮ፥ “ዶንገ ቶራታ ኤካ” ያግስ። እ ኤክን፥ ኤልስ፥ “ቢታ ጫዳ” ያግስ። እ ሄ ቶሆ ቢታ ጫድድ አጋግስ። <verse eid="2KI 13:18"/><verse number="19" style="v" sid="2KI 13:19"/>ፆሳ አደይ፥ ካዋ ቦላ ሀንቀትድ፥ “እቻሹ ቶሆ ዎይኮ ኡሱፑን ቶሆ ቢታ ጫድዳባ ግድያኮ፥ ኔኒ አራመ አሳ ፆናዳ ኩመ ይሳናሽን! ኔኒ ሀእ ኤንታ ሄ ቶሆ ፃላላ ፆናና” ያግስ።<verse eid="2KI 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 13:20"/>ኤልስ ሀይቅድ ሞገትስ። ሞአበ ፓኖት እስራኤለ ቢታ ቦላ ላይን ላይን ደንዶሶና። <verse eid="2KI 13:20"/><verse number="21" style="v" sid="2KI 13:21"/>እስ ጋላስ ጉ እስራኤለ አሳት እስ ኡራ አሀ ሞግሸ፥ ሄኮ፥ ሞአበ ፓኖታ በእዶሶና። ኡራ አሀ ኤልሳ ዱፉዋ ግዶ ሆልድ ባቃትዶሶና። አሀይ ኤልሳ መቀ ቦላ ዎድ፥ ፓፅድ ደንድ ኤቅስ።<verse eid="2KI 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 13:22"/>እዮአካዝ ካዎትዳ ላይ ኡባን ሶረ ካዎይ አዛሄል እስራኤለ ኡንኤስ። <verse eid="2KI 13:22"/><verse number="23" style="v" sid="2KI 13:23"/>ሽን ጎዳይ አብራሃመራ፥ ይሳቃራነ ያይቆባራ ጫቅዳ ጫቁዋ ግሾ፥ ኤንታዉ ኬህስ፥ ቃትስ፥ ቆፕስ። ሀች ጋካናዉ እ ኤንታ ይስቤና ዎይኮ ባ ስንፈ ድግቤና።<verse eid="2KI 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 13:24"/>አራመ ካዎይ አዛሄል ሀይቅን፥ እያ በሳን እያ ናአይ ዎልደ-አዳር ካዎትስ። <verse eid="2KI 13:24"/><verse number="25" style="v" sid="2KI 13:25"/>አዛሄል እያ አዋ እዮአካዝ ኦላን ኦይክዳ ካታማታ፥ እዮአካዛ ናአይ ዮኣስ አዛሄላ ናኣ ዎልደ-አዳራፐ ኤክስ። ዮኣስ እያ ሄ ቶሆ ፆንድ፥ እስራኤለ ካታማታ ዛርስ።<verse eid="2KI 13:25"/></para>
  <chapter eid="2KI 13"/>
  <chapter number="14" style="c" sid="2KI 14"/>
  <para style="s1">ይሁዳ ካዋ አማስያሳ</para>
  <para style="r">(<ref loc="2CH 25:1-24">2 ታር 25:1-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 14:1"/>እዮአካዛ ናአይ፥ እስራኤለ ካዎይ ዮኣስ ካዎትዳ ናምአን ላይን፥ ይሁዳ ካዋ እዮኣሳ ናአይ አማስያስ ካዎትስ። <verse eid="2KI 14:1"/><verse number="2" style="v" sid="2KI 14:2"/>እ ካዎትያ ዎደ ላይ እያዉ ላታማነ እቻሻ፤ እ የሩሳላመን ላታማነ ኡዱፉን ላይ ካዎትስ። እያ አየ ሱንይ ዮዳኖ፤ እያ የሩሳላመ ማጫስ። <verse eid="2KI 14:2"/><verse number="3" style="v" sid="2KI 14:3"/>አማስያስ ጎዳ ስንን ሱረባ ኦስ፤ ሽን እያ ማይዛይ ዳዊቲ ኦዳይሳዳ ግዶናሽን፥ ባ አዋ እዮኣሳ ኦግያ ካልስ። <verse eid="2KI 14:3"/><verse number="4" style="v" sid="2KI 14:4"/>አሳይ ቃ ጎይኖ በሳታ ይስቤና፤ አሳይ ሄ በሳን ያርሾ ያርሸይሳነ እፃነ ጩይሰይሳ አግቦኮና።<verse eid="2KI 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 14:5"/>አማስያስ ካዎተ ምንድ ኦይክዳፐ ጉየ፥ ካሰ ካዋ፥ ባ አዋ እዮኣሳ ዎዳ ሹማታ ዎስ። <verse eid="2KI 14:5"/><verse number="6" style="v" sid="2KI 14:6"/>ሙሰ ህገ ማፃፋን ፃፈትዳይሳዳ፥ ጎዳይ፥ “ናይት ኦዳ ናጋራ ግሾ፥ አዋታ ዎናዉ በሰና፤ ቃስ አዋት ኦዳ ናጋራ ግሾ፥ ናይታ ዎናዉ በሰና። አስ ኡባይ ባ ኦዳ ናጋራን ናጋራን ሀይቃናዉ በሴስ”<note caller="-" style="x"><char style="xo" closed="false">14:6 </char><char style="xt" closed="false"><ref loc="DEU 24:16">ዛረ 24:16</ref>.</char></note> ያግድ ኪትዳይሳዳ ባ አዋ ዎዳ አሳ ናይታ ዎቤና። <verse eid="2KI 14:6"/><verse number="7" style="v" sid="2KI 14:7"/>አማስያስ ማፅነ ዛንጋራን ታሙ ሙኩሉ ኤዶመ አሳ ዎድ፥ ሴላ ካታማ ኦላን ኦይክድ፥ ሄ በሳ ዮቅትኤላ ግድ ሱንስ፤ ሀች ጋካናዉ ሄ ሱንን ፄገቴስ።<verse eid="2KI 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 14:8"/>ሄሳፈ ጉየ፥ አማስያስ እዩ ናኣ ናኣ፥ እዮአካዛ ናኣ፥ ዮኣሳኮ፥ “ሃያ፤ አነ ናምአይ ኦላ ጋሄቶስ” ያግድ አሰ ኪትድ ማንድስ። <verse eid="2KI 14:8"/><verse number="9" style="v" sid="2KI 14:9"/>ሽን እስራኤለ ካዎይ ዮኣስ፥ ይሁዳ ካዋ አማስያሳኮ፥ “ልባኖሰን ደእያ ክንቾተይ፥ ልባኖሰን ደእያ ዝጋኮ፥ ‘ነ ናእዉ ታ ናኣስ እማ’ ያግስ። ሽን ልባኖሰን ደእያ እስ ዶአይ ያራ ካንድ፥ ሄ ክንቾትያ የስ። <verse eid="2KI 14:9"/><verse number="10" style="v" sid="2KI 14:10"/>ኤ፥ ኔኒ ቱማ ኤዶመ ቢታ ፆናዳሳ፤ ሀእ ኦቶርታዳሳ። ኔኒ ነ ፆኑዋን ኡፋይታዳ፥ ነ ሶን ዎፑ ጋዳ ኡታ። ነ ቦላነ ነ ቢታ ይሁዳ ቦላ መቶነ ዮ ኤህያባ አይስ ደንይ?” ያግድ ዛርስ።<verse eid="2KI 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 14:11"/>ሽን አማስያስ እያ ስእቤና። እስራኤለ ካዎይ ዮኣስ ኦላስ ከይን፥ እነ ይሁዳ ካዎይ አማስያስ ይሁዳን ደእያ ቤት-ሳሜሳ ካታማን ኦላ ጋሄትዶሶና። <verse eid="2KI 14:11"/><verse number="12" style="v" sid="2KI 14:12"/>እስራኤለይ ይሁዳ ፆንን፥ ይሁዳ አሳ ኡባይ ባቃትድ፥ ባንታ ሶ ባንታ ሶ ብዶሶና። <verse eid="2KI 14:12"/><verse number="13" style="v" sid="2KI 14:13"/>እስራኤለ ካዎይ ዮኣስ አካዝያሳ ናኣ ናኣ፥ እዮኣሳ ናኣ፥ ይሁዳ ካዋ አማስያሳ ቤት-ሳሜሳ ካታማን ድእስ። የሩሳላመ ድርሳ ግምብያ፥ ኤፍሬማ ፐንግያፈ ብድ፥ ማዛነ ፐንግያ ጋካናዉ ደእያ ኦይዱ ፄቱ ዋ ግድያ በሳ ላልስ። <verse eid="2KI 14:13"/><verse number="14" style="v" sid="2KI 14:14"/>ፆሳ ኬንነ ካዎ ጋን ሻሎ ምንጅያ ኬን ደእያ ዎርቃ፥ ብራነ ሚሸ ኡባ ኤክስ፤ ቃስ ኦይ ግድድ ድኤትዳ አሳካ ኤክድ፥ ሳማረ ስምስ።<verse eid="2KI 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 14:15"/>ዮኣስ ሀንዳ ሀራባይ፥ እ ኦዳባይ፥ እያ ምኖተይነ ይሁዳ ካዋ አማስያሳራ ኦለትዳባይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 14:15"/><verse number="16" style="v" sid="2KI 14:16"/>ዮኣስ ሀይቅድ፥ ባ ማይዛታ ጋክስ፤ ሳማረን እስራኤለ ካዎታራ ሞገትስ። እያ በሳን እያ ናአይ እዮርባም ካዎትስ።<verse eid="2KI 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 14:17"/>እዮአካዛ ናአይ፥ እስራኤለ ካዎይ ዮኣስ ሀይቅዳፐ ጉየ፥ ዮኣሳ ናአይ፥ ይሁዳ ካዎይ አማስያስ ታማነ እቻሹ ላይ ደእስ። <verse eid="2KI 14:17"/><verse number="18" style="v" sid="2KI 14:18"/>አማስያስ ሀንዳ ሀራባይ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ።<verse eid="2KI 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 14:19"/>አማስያሳ ዎናዉ አሳይ የሩሳላመን ማቀትስ፤ ያትን እ ላክሶ ካታማ ባቃትስ። ሽን ኤንቲ እያ ጌዶ ላክሶ ካታማ አሰ ኪትን፥ እያ ያን ዎዶሶና። <verse eid="2KI 14:19"/><verse number="20" style="v" sid="2KI 14:20"/>ዎድ እያ አሀ ፓራን ጫን ኤህድ፥ ዳዊታ ካታማን የሩሳላመን እያ ማይዛታራ ሞግዶሶና። <verse eid="2KI 14:20"/><verse number="21" style="v" sid="2KI 14:21"/>ሄሳፈ ጉየ፥ ይሁዳ አሳ ኡባይ ታማነ ኡሱፑን ላይ ናኣ አዛርያሳ እያ አዋ አማስያሳ በሳን ካዎዶሶና። <verse eid="2KI 14:21"/><verse number="22" style="v" sid="2KI 14:22"/>እያ አዋይ አማስያስ ሀይቅዳፐ ጉየ፥ አዛርያስ ኤላታ ካታማ ዛር ኬፅድ፥ ይሁዳን ጋስ።<verse eid="2KI 14:22"/></para>
  <para style="s1">እስራኤለ ካዋ ናምአን እዮርባማ</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 14:23"/>እዮኣሳ ናአይ፥ ይሁዳ ካዎይ አማስያስ ካዎትዳ ታማነ እቻሻን ላይን፥ እስራኤለ ካዋ ዮኣሳ ናአይ እዮርባም ሳማረን ካዎትስ፤ እ ኦይታማነ እስ ላይ ካዎትስ። <verse eid="2KI 14:23"/><verse number="24" style="v" sid="2KI 14:24"/>ናምአን እዮርባም ጎዳ ስንን ኢታባ ኦስ፤ እስራኤለ አሳ ናጋራ ኦስስዳ ናባፃ ናኣ እዮርባም ኦግያፐ ሃክቤና። <verse eid="2KI 14:24"/><verse number="25" style="v" sid="2KI 14:25"/>ጋት-ሄፈራ አድያ አማተ ናኣ ናብያ፥ ባ አይልያ ዮናሳ ባጋራ ጎዳይ እስራኤለ ፆሳይ ባ ቃላን ኦድዳይሳዳ፥ ሀማታ ፕኑዋ ጌተትያ በሳፈ ዶምድ፥ ማፅነ አባ ጋካናዉ ደእያ እስራኤለ ዛዋ ዮኣሳ ናአይ እዮርባም ፆንድ ዛርስ።<note caller="-" style="x"><char style="xo" closed="false">14:25 </char><char style="xt" closed="false"><ref loc="JON 1:1">ዮና 1:1</ref>.</char></note> <verse eid="2KI 14:25"/><verse number="26" style="v" sid="2KI 14:26"/>እስራኤለን አሳ ኡባይ አይለ ግድን፥ ዎማኖ ግድን፥ አይ መላ ኡንኤትዳኮ፥ ጎዳይ በእስ፤ ኤንታ ማድያ ኦንካ ባዋ። <verse eid="2KI 14:26"/><verse number="27" style="v" sid="2KI 14:27"/>ጎዳይ እስራኤለ አሳ ሱን ሳሎፐ ጋርሳን ቁቻና ግቤና። ሄሳ ግሾ፥ ጎዳይ ኤንታ ዮኣሳ ናኣ እዮርባማ ባጋራ አሽስ።<verse eid="2KI 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 14:28"/>እዮርባም ሀንዳ ሀራባይ፥ እ ኦዳባ ኡባይ፥ ኦለትዳባይነ ይሁዳ ባጋ ግድዳ ዳማስቆነ ሀማታ ካታማታ እስራኤለስ ዛርዳባይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 14:28"/><verse number="29" style="v" sid="2KI 14:29"/>እዮርባም ሀይቅድ፥ ባ ማይዛታ፥ እስራኤለ ካዎታ ጋክስ፤ እያ በሳን እያ ናአይ ዛካርያስ ካዎትስ።<verse eid="2KI 14:29"/></para>
  <chapter eid="2KI 14"/>
  <chapter number="15" style="c" sid="2KI 15"/>
  <para style="s1">ይሁዳ ካዋ አዛርያሳ</para>
  <para style="r">(<ref loc="2CH 26:1-23">2 ታር 26:1-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 15:1"/>እስራኤለ ካዎይ እዮርባም ካዎትዳ ላታማነ ላፑን ላይን፥ ይሁዳ ካዋ አማስያሳ ናአይ አዛርያስ ካዎትስ። <verse eid="2KI 15:1"/><verse number="2" style="v" sid="2KI 15:2"/>እ ካዎትዳ ዎደ፥ እያዉ ላይ ታማነ ኡሱፑና፤ እ የሩሳላመን እሻታማነ ናምኡ ላይ ካዎትስ። እያ አየ ሱንይ ይኮሎ፤ እያ የሩሳላመ ማጫስ። <verse eid="2KI 15:2"/><verse number="3" style="v" sid="2KI 15:3"/>እያ አዋይ አማስያስ ኦዳይሳዳ፥ እካ ጎዳ ስንን ሱረባ ኦስ። <verse eid="2KI 15:3"/><verse number="4" style="v" sid="2KI 15:4"/>ግዶሽን፥ ሄ በሳን ያርሾ ያርሸይሳነ እፃነ ጩይሰይሳ አሳይ አግቦና ግሾ፥ ቃ ጎይኖ በሳታ ይስቤና፤ <verse eid="2KI 15:4"/><verse number="5" style="v" sid="2KI 15:5"/>ጎዳይ አዛርያሳ ጉ ጎጋ ሀርገን ኦይስ፤ ሀይቃና ጋካናዉ ሄ ሀርገይ እያ የድቦና ግሾ፥ ዱማ ኬን ባርካ ደእስ። ሄ ዎደ ካዋ ናአይ እዮአታም ካዎ ጋን ደእድ፥ ቢታ ሃርስ።<verse eid="2KI 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 15:6"/>አዛርያስ ሀንዳ ሀራባይነ እ ኦዳባ ኡባይ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 15:6"/><verse number="7" style="v" sid="2KI 15:7"/>አዛርያስ ሀይቅድ፥ ባ ማይዛታ ጋክስ፤ ዳዊታ ካታማን ባ ማይዛታራ ሞገትስ። እያ በሳን እያ ናአይ እዮአታም ካዎትስ።<note caller="-" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ISA 6:1">እሳ 6:1</ref>.</char></note><verse eid="2KI 15:7"/></para>
  <para style="s1">እስራኤለ ካዋ ዛካርያሳ</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 15:8"/>ይሁዳ ካዎይ አዛርያስ ካዎትዳ ሀስታማነ ሆስፑን ላይን፥ እዮርባማ ናአይ ዛካርያስ እስራኤለ ቦላ ሳማረን ካዎትስ፤ እ ኡሱፑን አጌና ካዎትስ። <verse eid="2KI 15:8"/><verse number="9" style="v" sid="2KI 15:9"/>እያ ማይዛት ኦዳይሳዳ፥ እካ ጎዳ ስንን ኢታባ ኦስ፤ ናባፃ ናአይ እዮርባም እስራኤለ አሳ ኦስስዳ ናጋራ ኦሶ አግቤና። <verse eid="2KI 15:9"/><verse number="10" style="v" sid="2KI 15:10"/>እያቤሳ ናአይ ሳሎም ዛካርያሳ ቦላ ማቀትድ፥ ይብላማ ጌተትያ በሳን ዎድ እያ በሳን ባዉ ካዎትስ።<verse eid="2KI 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 15:11"/>ዛካርያስ ሀንዳ ሀራባይነ እ ኦዳባ ኡባይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 15:11"/><verse number="12" style="v" sid="2KI 15:12"/>ሄሳዳ ሀንድ፥ ጎዳይ እዩስ፥ “ነ ኮቻይ ኦይዳን የለታ ጋካናዉ፥ እስራኤለ ካዎተ አራታን ኡታና” ያግድ ኦድዳ ቃላይ ፖለትስ።<note caller="-" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="2KI 10:30">2 ካዎ 10:30</ref>.</char></note><verse eid="2KI 15:12"/></para>
  <para style="s1">እስራኤለ ካዋ ሳሎማ</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 15:13"/>ይሁዳ ካዎይ ኦዝያን ካዎትዳ ሀስታማነ ኡዱፉን ላይን፥ ያበሳ ናአይ ሳሉም ካዎትስ፤ እ ሳማረን እስ አጌና ካዎትስ። <verse eid="2KI 15:13"/><verse number="14" style="v" sid="2KI 15:14"/>ጋደ ናአይ ምናሄም ትርሳ ካታማፐ ሳማረ ብስ። ሳማረን ደእያ ያበሳ ናኣ ሳሉማ ዎድ እያ በሳን ባዉ ካዎትስ።<verse eid="2KI 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 15:15"/>ሳሉም ሀንዳ ሀራባይነ እ ማቀትዳ ማቆይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 15:15"/><verse number="16" style="v" sid="2KI 15:16"/>ሄ ዎደ ምናሄም ትርሳፈ ደንድድ፥ ትፍሳነ፥ ያን ደእያ አሳነ ካታማ ሄራን ደእያ ቢታታ ኡባ ኦልስ። ኤንቲ ባንታ ካታማ ድርሳ ፐንግያ እያዉ ዶዮና እፅዳ ግሾ፥ ትፍሳ ኦልድ ይስስ፤ ቃስ ያን ደእያ ቃን ማጫሳ ኡባ ኡሉዋ ዳክስ።<verse eid="2KI 15:16"/></para>
  <para style="s1">እስራኤለ ካዋ ምናሄማ</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 15:17"/>ይሁዳ ካዎይ አዛርያስ ካዎትዳ ሀስታማነ ኡዱፉን ላይን፥ ጋደ ናአይ ምናሄም እስራኤለ ቦላ ካዎትስ፤ እ ሳማረን ታሙ ላይ ካዎትስ። <verse eid="2KI 15:17"/><verse number="18" style="v" sid="2KI 15:18"/>እ ጎዳ ስንን ኢታባ ኦስ፤ ናባፃ ናአይ እዮርባም እስራኤለ አሳ ኦስስዳ ናጋራፐ ሃክቤና።<verse eid="2KI 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 15:19"/>ሄሳፈ ጉየ፥ አሶረ ካዎይ ተልገልተልፈልሶር እስራኤለ ቦላ ደንድስ። ካዎተን ባና ምንና መላነ ማዳና መላ፥ ምናሄም ተልገልተልፈልሶራስ 34,000 ክሎ ግራመ ብራ ሳንትመ እሚስ። <verse eid="2KI 15:19"/><verse number="20" style="v" sid="2KI 15:20"/>ምናሄም ሄ ሚሽያ እስራኤለ አሳ ዎልቃን ከስስ፤ አሶረ ካዋስ እማናዉ ዱረ አስ ኡባይ እሶይ እሶይ እሻታሙ ብራ ሳንትመ ከስዶሶና። ሄሳዳ ኦን፥ አሶረ ካዎይ እስራኤለ ቢታ አግድ፥ ባ ቢታ ስምስ።<verse eid="2KI 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 15:21"/>ምናሄም ሀንዳ ሀራባይነ እ ኦዳባ ኡባይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 15:21"/><verse number="22" style="v" sid="2KI 15:22"/>ምናሄም ሀይቅድ፥ ባ ማይዛታን ጋሄትስ፤ እያ በሳን እያ ናአይ ፓቅስያስ ካዎትስ።<verse eid="2KI 15:22"/></para>
  <para style="s1">እስራኤለ ካዋ ፋቅስያሳ</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 15:23"/>ይሁዳ ካዎይ አዛርያስ ካዎትዳ እሻታማን ላይን፥ ምናሄማ ናአይ ፓቅስያስ እስራኤለ ቦላ ሳማረን ካዎትስ፤ እ ናምኡ ላይ ካዎትስ። <verse eid="2KI 15:23"/><verse number="24" style="v" sid="2KI 15:24"/>ፓቅስያስ ጎዳ ስንን ኢታባ ኦስ፤ ናባፃ ናአይ እዮርባም እስራኤለ አሳ ኦስስዳ ናጋራ ኦሶ አግቤና። <verse eid="2KI 15:24"/><verse number="25" style="v" sid="2KI 15:25"/>እያ ቶራ ሞጮናታፐ እሶይ፥ ራማላ ናአይ ፓቁሄይ እያ ቦላ ማቀትድ ደንድስ። ጋላዳ አሳፐ እሻታሙ አደታ ባራ ኤክድ፥ ሳማረን ካዎ ጋን ደእያ ሚፃ ገልስ። ፓቁሄይ፥ ፓቅስያሳ፥ አርጎባነ አርያ እስፈ ዎድ እያ በሳን ባዉ ካዎትስ።<verse eid="2KI 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 15:26"/>ፓቅስያስ ሀንዳ ሀራባይነ ኦዳባ ኡባይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ።<verse eid="2KI 15:26"/></para>
  <para style="s1">እስራኤለ ካዋ ፋቁሄ</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 15:27"/>ይሁዳ ካዎይ አዛርያስ ካዎትዳ እሻታማነ ናምአን ላይን፥ ራማላ ናአይ ፓቁሄይ እስራኤለ ቦላ ሳማረን ካዎትስ፤ እ ላታሙ ላይ ካዎትስ። <verse eid="2KI 15:27"/><verse number="28" style="v" sid="2KI 15:28"/>ፓቁሄይ ጎዳ ስንን ኢታባ ኦስ፤ ናባፃ ናአይ እዮርባም እስራኤለ አሳ ኦስስዳ ናጋራፐ ሃክቤና።<verse eid="2KI 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 15:29"/>እስራኤለ ካዋ ፓቁሄ ዎድያን አሶረ ካዎይ ተልገልተልፈልሶር ይድ፥ እዮና፥ አቤል-ቤት-ማእካ፥ ያኖሀ፥ ቃደሳነ ሀፆራ ኦልድ ኦይክስ፤ ቃስ ጋላዳ፥ ጋልላነ ንፍታለመ ቢታ ኡባ ኦልድ፥ አሳ ድእድ አሶረ ቢታ ኤፍስ።<verse eid="2KI 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 15:30"/>አዛርያሳ ናአይ እዮአታም ካዎትዳ ላታማን ላይን፥ ኤላ ናአይ ሆሰይ ራማላ ናኣ ፓቁሄ ቦላ ማቀትድ ዎድ፥ እያ በሳን ባዉ ካዎትስ።<verse eid="2KI 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 15:31"/>ፓቁሄይ ሀንዳ ሀራባይነ ኦዳባ ኡባይ እስራኤለ ካዎታ ታርከ ማፃፋን ፃፈትስ።<verse eid="2KI 15:31"/></para>
  <para style="s1">ይሁዳ ካዋ እዮአታማ</para>
  <para style="r">(<ref loc="2CH 27:1-9">2 ታር 27:1-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 15:32"/>ራማላ ናአይ፥ እስራኤለ ካዎይ ፓቁሄይ ካዎትዳ ናምአን ላይን፥ ይሁዳ ካዋ አዛርያስ ናአይ እዮአታም ካዎትስ። <verse eid="2KI 15:32"/><verse number="33" style="v" sid="2KI 15:33"/>እዮአታም ካዎትያ ዎደ እያዉ ላይ ላታማነ እቻሻ፤ እ የሩሳላመን ታማነ ኡሱፑን ላይ ካዎትስ። እያ አየ ሱንይ ያሩሾ፤ ያሩሻ ሳዶቃ ናእዉ። <verse eid="2KI 15:33"/><verse number="34" style="v" sid="2KI 15:34"/>ባ አዋይ አዛርያስ ኦዳይሳዳ፥ እዮአታም ጎዳ ስንን ሱረባ ኦስ። <verse eid="2KI 15:34"/><verse number="35" style="v" sid="2KI 15:35"/>ግዶሽን፥ ሄ በሳን ያርሾነ እፃነ ጩይሰ አግቦና ግሾ፥ አሳይ ቃ ጎይኖ በሳታ ይስቤና። እዮአታም ፆሳ ኬ ገልያ ቆሞ ባጋ ፐንግያ ዛሪድ ኬፅስ።<verse eid="2KI 15:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 15:36"/>እዮአታም ሀንዳ ሀራባይነ ኦዳባ ኡባይ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 15:36"/><verse number="37" style="v" sid="2KI 15:37"/>ሄ ዎደ ጎዳይ አራመ ካዋ ራአሶናነ ራማላ ናኣ፥ እስራኤለ ካዋ ፓቁሄ ይሁዳ ቢታ ኦላና መላ ደንስ። <verse eid="2KI 15:37"/><verse number="38" style="v" sid="2KI 15:38"/>እዮአታም ሀይቅድ፥ ባ አዋ ዳዊታ ካታማን ባ ማይዛታራ ሞገትስ፤ እያ በሳን እያ ናአይ አካዝ ካዎትስ።<verse eid="2KI 15:38"/></para>
  <chapter eid="2KI 15"/>
  <chapter number="16" style="c" sid="2KI 16"/>
  <para style="s1">ይሁዳ ካዋ አካዛ</para>
  <para style="r">(<ref loc="2CH 28:1-27">2 ታር 28:1-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 16:1"/>ራማላ ናአይ ፓቁሄይ ካዎትዳ ታማነ ላፑን ላይን፥ እዮአታማ ናአይ አካዝ ይሁዳን ካዎትስ። <verse eid="2KI 16:1"/><verse number="2" style="v" sid="2KI 16:2"/>እ ካዎትያ ዎደ ላይ እያዉ ላታማ፤ የሩሳላመን ታማነ ኡሱፑን ላይ ካዎትስ። እያ ማይዛይ ዳዊቲ ሱረባ ኦዳይሳዳ፥ ጎዳ ባ ፆሳ ስንን ሱረባ ኦቤና። <verse eid="2KI 16:2"/><verse number="3" style="v" sid="2KI 16:3"/>እ ካሰ ደእዳ እስራኤለ ካዎታ ኦግያን ሄመትስ። ቃስ ጎዳይ እስራኤለ አሳ ስንፈ ጎድድ ከስዳ አሳታ ዎጋ፥ እፀትዳ ኦግያ ካልድ፥ ባ አደ ናኣ ታማራ አድ ያርሽስ።<note caller="-" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="DEU 12:31">ዛረ 12:31</ref>፤ <ref loc="DEU 18:10">18:10</ref>.</char></note> <verse eid="2KI 16:3"/><verse number="4" style="v" sid="2KI 16:4"/>አካዝ ቃ ጎይኖ በሳታን፥ ዙማታ ቦላነ ዳሻ ምታ ኡባ ጋርሳን ያርሾ ያርሽስ፤ እፃነ ጩይስስ።<verse eid="2KI 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 16:5"/>ሄሳፈ ጉየ፥ አራመ ካዎይ ራአሶንነ ራማላ ናአይ፥ እስራኤለ ካዎይ ፓቁሄይ የሩሳላመ ኦላናዉ ይድ ተቅዶሶና፤ ሽን አካዛ ፆናናዉ ዳንዳእቦኮና።<note caller="-" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="ISA 7:1">እሳ 7:1</ref>.</char></note> <verse eid="2KI 16:5"/><verse number="6" style="v" sid="2KI 16:6"/>ሄ ዎደ አራመ ካዎይ ራአሶን ኤላታ ካታማ ዛር ኤክድ፥ ይሁዳ አሳ ጎድድ ከስስ። ያትን ኤዶመ አሳት ኤላታ ካታማ ይድ፥ ሀች ጋካናዉ ያን ደኦሶና።<verse eid="2KI 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 16:7"/>ሄሳ ግሾ፥ አካዝ አሶረ ካዋ ተልገልተልፈልሶራኮ ኪታ የድድ፥ “ታኒ ነ ናአነ ነ አይለ። ሀያና ሃያ፤ ታና ኦልያ አራመ ካዋ ኩሸፐነ እስራኤለ ካዋ ኩሸፐ አሻ” ያግስ። <verse eid="2KI 16:7"/><verse number="8" style="v" sid="2KI 16:8"/>ቃስ አካዝ ፆሳ ኬነ ካዎ ጋን ሻሎ ምንጅያ በሳን ደእያ ብራነ ዎርቃ ኤክድ፥ አሶረ ካዋስ እሞታ ኦድ የድስ። <verse eid="2KI 16:8"/><verse number="9" style="v" sid="2KI 16:9"/>አካዛ ኦይሻ ኤክድ፥ አሶረ ካዎይ ዳማስቆ ካታማ ኦል ኦይክድ፥ አሳ ድእድ፥ ቂራ ኤፍስ፤ ካዋ ራአሶናካ ዎስ።<verse eid="2KI 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 16:10"/>ካዎይ አካዝ አሶረ ካዋ ተልገልተልፈልሶራራ ጋሄታናዉ ዳማስቆ ብስ። ዳማስቆን ደእያ ያርሾ በሳ በእድ፥ እያ ዳንያ ያርሾ በሲ ኬፃና መላ፥ ሄ ያርሾ በሳ ምስልያነ ኬፅያ ሀኖታ ካህንያ ኡራያ ኪትስ። <verse eid="2KI 16:10"/><verse number="11" style="v" sid="2KI 16:11"/>ካዎይ አካዝ ዳማስቆፈ ስሚድ ያናስ፥ ካህነይ ኡራይ እያ ዳንያ ያርሾ በሲ ጊግስስ።<verse eid="2KI 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 16:12"/>ካዎይ ዳማስቆፈ ስምዳ ዎደ፥ ያርሾ በሳይ ኦሰትድ ፖለትዳይሳ በእድ፥ ያርሾ በሳኮ ሺቅድ፥ <verse eid="2KI 16:12"/><verse number="13" style="v" sid="2KI 16:13"/>ፁሳ ያርሾነ ካ ያርሾ ያርሽስ። ቃስ ኡሻ ያርሹዋ ጉስስ፤ እስፈተ ያርሾ ሱካ ያርሾ በሳ ቦላ ርጭስ። <verse eid="2KI 16:13"/><verse number="14" style="v" sid="2KI 16:14"/>ናሰ ብራታፐ ኦሰትድ፥ ጎዳስ ዱማትድ ኡትዳ ያርሾ በሳይ፥ ኦራ ያርሾ በሳፈነ ፆሳ ኬፈ ግዶን ደኤስ። አካዝ ሄ ጋልአ ያርሾ በሳ ደንድ፥ ባ ኦስስዳ ኦራ ያርሾ በሳፈ ፑደሀ ባጋን ዎስ።<note caller="-" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="EXO 27:1-2">ከሳ 27:1-2</ref>፤ <ref loc="2CH 4:1">2 ታር 4:1</ref>.</char></note><verse eid="2KI 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 16:15"/>ካዎይ አካዝ ካህንያ ኡራያ ሀይሳዳ ያግድ ኪትስ፤ “ሀ ግታ ያርሾ በሳን ዎንታ ፁሳ ያርሾ፥ ኦማርስ ሺሽያ ካ ያርሾ፥ ካዎይ ሺሽያ ፁሳ ያርሾነ ካ ያርሾ፥ አሳ ኡባይ ሺሽያ ፁሳ ያርሾ፥ ካ ያርሹዋነ ኡሻ ያርሹዋ ያርሾ በሳን ሺሻ። ናሰፐ ኦሰትዳ ሀንኮ ያርሾ በሳ ታኒ ታዉ ኦይችያ በሲ ኦና” ያግስ። <verse eid="2KI 16:15"/><verse number="16" style="v" sid="2KI 16:16"/>ኡራይ ካዎይ አካዝ ኪትዳይሳዳ ኦስ።<verse eid="2KI 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 16:17"/>ካዎይ አካዝ ፆሳ ኬ ግዶን ጎኤትያ፥ ናሰ ብራታፐ ኦሰትዳ ጋረታ ሎቸ ብራታ ቃንፅድ፥ ምየፐ ድግድ ሜጨትያ ከረታ ጋረታ ቦላፈ ደንስ። ቃስ ግታ ከረታ፥ እያ ዘምፕስዳ ናሰ ብራታ ቦራ ምስለታ ቦላፈ ደንድ፥ ሹቻ ባሱዋ ቦላ ዎስ።<note caller="-" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="1KI 7:23-39">1 ካዎ 7:23-39</ref>፤ <ref loc="2CH 4:2-6">2 ታር 4:2-6</ref>.</char></note> <verse eid="2KI 16:17"/><verse number="18" style="v" sid="2KI 16:18"/>አሶረ ካዋ ግሾ፥ አካዝ ሳምባታ ጋላስ ፆሳ ኬ ግዶን ካዋ አራታይ ምጨትያ ቁ ግዳ በሳነ ካዎይ ፆሳ ኬ ገልያ ካረ ኦግያ ጎርድድ፥ ዩይ አድ ገላና መላ ኦስ።<verse eid="2KI 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 16:19"/>ካዎይ አካዝ ሀንዳ ሀራባይነ እ ኦዳባ ኡባይ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 16:19"/><verse number="20" style="v" sid="2KI 16:20"/>አካዝ ሀይቅድ፥ ባ ማይዛታን ጋሄትስ፤ ዳዊታ ካታማን ባ ማይዛታራ ሞገትስ፤ እያ በሳን እያ ናአይ ህዝቅያስ ካዎትስ።<note caller="-" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="ISA 14:28">እሳ 14:28</ref>.</char></note><verse eid="2KI 16:20"/></para>
  <chapter eid="2KI 16"/>
  <chapter number="17" style="c" sid="2KI 17"/>
  <para style="s1">እስራኤለ ካዋ ሆሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 17:1"/>ይሁዳ ካዎይ አካዝ ካዎትዳ ታማነ ናምአን ላይን፥ ኤላ ናአይ ሆሰይ እስራኤለ ቦላ ሳማረን ካዎትስ፤ እ ኡዱፉን ላይ ካዎትስ። <verse eid="2KI 17:1"/><verse number="2" style="v" sid="2KI 17:2"/>እ፥ ጎዳ ስንን ኢታባ ኦስ፤ ግድኮካ፥ እያፐ ካሰ ደእዳ እስራኤለ ካዎት ኦዳይሳ መላ ኢታባ ኦቤና።<verse eid="2KI 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 17:3"/>አሶረ ካዎይ ሳልምናሶር ይድ፥ እያራ ኦላ ጋሄትን፥ ሆሰይ ፆነትድ፥ እያዉ ጊርስ። <verse eid="2KI 17:3"/><verse number="4" style="v" sid="2KI 17:4"/>ሽን ጉ ላይፈ ጉየ፥ ካዎይ ሆሰይ፥ ግብፀ ካዋ ሰጎራስ ኪታ የድድ፥ ባና ማዳና መላ ኦይችስ። ካሰይሳዳ አሶረ ካዋስ ጊራ እመይሳ አጋግስ። ካዎይ ሳልምናሶር ሄሳ ስእዳ ዎደ እያ ኦይድ፥ ቃሾ ኬ ገልስስ።<verse eid="2KI 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 17:5"/>አሶረ ካዎይ እስራኤለ ቢታ ኡባ ቦላ ደንድድ፥ ሄ ላይ ጋካናዉ ሳማረ ካታማ ተቅስ። <verse eid="2KI 17:5"/><verse number="6" style="v" sid="2KI 17:6"/>ሆሰይ ካዎትዳ ኡዱፉን ላይን አሶረ ካዎይ ሳማረ ካታማ ኦይክስ፤ እስራኤለ አሳ ኤክድ፥ አሶረ ቢታ ኤፍስ። ኤንታፈ ባጋ አላሀንነ አቦራን፥ ባጋ ቃስ ጎዛና ሻፋ ማታን፥ አትዳይሳታ ሜዶና ካታማታን ዎስ።<verse eid="2KI 17:6"/></para>
  <para style="s1">ኤቃ ጎይኖ ጋሶን ድኤተ</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 17:7"/>ሀይስ ኡባይ ሀንዳይ፥ እስራኤለ አሳይ ጎዳ ባንታ ፆሳ ቦላ፥ ኤንታ ግብፀፈ፥ ግብፀ ካዋ ኩሸፐ ከስዳይሳ ቦላ ናጋራ ኦዳ ግሾሳ። ቃስ ኤንቲ ሀራ ፆሳታስ ጎይንድ፥ <verse eid="2KI 17:7"/><verse number="8" style="v" sid="2KI 17:8"/>ጎዳይ ኤንታ ስንፈ ጎድድ ከስዳ ሀራ ካዎተታ ዎጋ ካልዳ ግሾሳ። ሄሳ ቦላ ቃስ እስራኤለ ካዎት ዶምዳ ኢታ ዎጋ ካልዳ ግሾሳ። <verse eid="2KI 17:8"/><verse number="9" style="v" sid="2KI 17:9"/>እስራኤለ አሳይ ጎዳ ባንታ ፆሳ ቦላ ጌማን ኢታባ ኦዶሶና፤ ጉ ሞፈ ብድ፥ ግታ ካታማ ጋካናዉ ደእያ በሳ ኡባን ባንታዉ ቃ ጎይኖ በሳታ መዶሶና። <verse eid="2KI 17:9"/><verse number="10" style="v" sid="2KI 17:10"/>ቃስ ኤንቲ ኤቃ ሹቻታነ አሼራ ጌተትያ ፆሰ ምስለታ ዙማ ሁጰ ኡባንነ ዳሻ ም ኡባ ጋርሳን ኤስዶሶና። <verse eid="2KI 17:10"/><verse number="11" style="v" sid="2KI 17:11"/>ጎዳይ በን ኤንታ ስንፈ ጎድድ ከስዳ አላጋ አሳይ ኦዳይሳዳ፥ ቃ በሳ ኡባን እፃነ ጩይስዶሶና። ኤንቲ ኢታባ ኦድ ጎዳ ሀንቀዶሶና። <verse eid="2KI 17:11"/><verse number="12" style="v" sid="2KI 17:12"/>ጎዳይ ኤንታ፥ “ጎይኖፍተ” ያግዳ ኤቃ ጎይንዶሶና። <verse eid="2KI 17:12"/><verse number="13" style="v" sid="2KI 17:13"/>ጎዳይ እስራኤለ አሳነ ይሁዳ አሳ ባ ናበታ ባጋራነ ቆንጨ በእያ ኡባ ባጋራ፥ “ህንተ ኢታ ኦግያፐ ስምተ፤ ታኒ ናበታ፥ ታ አይለታ ባጋራ፥ ህንተ አዋት ኪተታናዳ እምዳ ህግያን ፃፈትዳ ዎጋነ አዋጁዋ ናግተ” ያግስ። <verse eid="2KI 17:13"/><verse number="14" style="v" sid="2KI 17:14"/>ሽን ኤንቲ ስኦና እፅዶሶና። ጎዳ ባንታ ፆሳ አማነትቦና ባንታ አዋታዳ ሞርገ ምንዶሶና። <verse eid="2KI 17:14"/><verse number="15" style="v" sid="2KI 17:15"/>ኤንቲ እያ ዎጋ፥ እ ኤንታ አዋታራ ጫቅዳ ጫቁዋነ እያ ናግሱዋ ካዶሶና። ኤንቲ ላፋ ኤቃታ ጎይንድ፥ ባንታ ሁጰንካ ላፋ ግድዶሶና።</para>
  <para style="p" vid="2KI 17:15">ጎዳይ ኤንታ፥ “ህንተ ዩሹዋን ደእያ አላጋ አሳይ ኦይሳዳ ኦፍተ” ያግዳ ኪታ እፅድ፥ ኤንታ ደኡዋ ዎጋ ካልዶሶና። <verse eid="2KI 17:15"/><verse number="16" style="v" sid="2KI 17:16"/>ጎዳ ባንታ ፆሳ ኪታ ኡባ አጋግዶሶና። ማር ዳንያ፥ ናምኡ ጎይኖ ምስለታነ አሼራ ጌተትያ ኤቃ ምስልያ መዶሶና። ሳሎን ደእያ ፆልንቶ ኡባ ጎይንዶሶናነ ባኣለ ኤቃ ሀጋዝዶሶና። <verse eid="2KI 17:16"/><verse number="17" style="v" sid="2KI 17:17"/>ኤንቲ ባንታ አደ ናይታነ ማጫ ናይታ ታማ ግዶራ አዶሶና። ማሮታነ ሞይትለ ፄገይሳታ ዞረ ኦይችዶሶና። ሄሳ መላ ኢታባ ኦናዉ ባንታና ባይዝድ፥ ጎዳ ሀንቀዶሶና። <verse eid="2KI 17:17"/><verse number="18" style="v" sid="2KI 17:18"/>ሄሳ ግሾ፥ ጎዳይ እስራኤለ ቦላ ሀንቀትድ ኤንታ ባ ስንፈ ድግን፥ ይሁዳ ኮቻ ፃላል አትስ።<verse eid="2KI 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 17:19"/>ቃስ ይሁዳ አሳይካ፥ ጎዳ ባንታ ፆሳ ኪታ ናግቦኮና፤ ኤንቲ እስራኤለ አሳ ዎጋ ካልዶሶና። <verse eid="2KI 17:19"/><verse number="20" style="v" sid="2KI 17:20"/>ሄሳ ጋሶን፥ ጎዳይ እስራኤለ ኮቻታ ኡባ አጋግስ። እ ኤንታ ኡንኤድ፥ ባ ስንፈ ድጋና ጋካናዉ፥ ቦንቅያ አሳ ኩሸን የግስ።<verse eid="2KI 17:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 17:21"/>ጎዳይ እስራኤለ አሳ ዳዊታ ኮቻ ካዎተፈ በን ሻክዳ ዎደ፥ እስራኤለ አሳይ ናባፃ ናኣ እዮርባማ ባንታዉ ካዎዶሶና። ሄሳፈ ጉየ፥ እስራኤለ አሳይ ጎዳ ካሎናዳ እዮርባም ድግስ፤ እ ኤንታ ግታ ናጋራ ኦስስስ። <verse eid="2KI 17:21"/><verse number="22" style="v" sid="2KI 17:22"/>እስራኤለ አሳይ እዮርባም ኦዳ ናጋራ ኡባ ኦዶሶና፤ እያፐ ስምቦኮና። <verse eid="2KI 17:22"/><verse number="23" style="v" sid="2KI 17:23"/>ጎዳይ ናበታ፥ ባ አይለታ ኡባ ባጋራ ካሰ ኦድዳይሳዳ ኤንታ ባ ስንፈ ድግስ። እስራኤለ አሳይ ባንታ የለትዳ ቢታፈ ድኤትድ፥ አሶረ ቢታ ብድ፥ ሀች ጋካናዉ ያን ደእዶሶና።<verse eid="2KI 17:23"/></para>
  <para style="s1">አሶረት እስራኤለ ቢታን</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 17:24"/>አሶረ ካዎይ ባብሎነ ቢታን ደእያ ኩታ፥ አዋና፥ ሀማታነ ሳፋርዋይማ ካታማታን ደእያ አሳ ኤህድ፥ እስራኤለ አሳ በሳን፥ ሳማረ ካታማታን ዎስ። ኤንቲ ሄ ካታማታ ኦይክድ፥ ያን ደእዶሶና።<verse eid="2KI 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 17:25"/>ኤንቲ ኮይሮ ያን ዱሱ ዶምዳ ዎደ፥ ጎዳ ጎይንቦኮና። ሄሳ ጋሶን፥ ጎዳይ ኤንታ ግዶ ጋሞታ የድን፥ ጋሞት ኤንታ ግዶፈ ባጋታ መንረድ ዎዶሶና። <verse eid="2KI 17:25"/><verse number="26" style="v" sid="2KI 17:26"/>ያትን፥ አሶረ ካዋስ፥ “ኔኒ ኤሀዳ ሳማረ ካታማታን ዎዳ አሳይ፥ ሀ ቢታ ፆሳ ዎጋ ኤሮኮና። ሄኮ፥ ያትን፥ ኤንታ መንረ ዎያ ጋሞታ ኤንታ ቦላ የድስ” ያግድ ኦድዶሶና።<verse eid="2KI 17:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 17:27"/>አሶረ ካዎይ፥ “ህንተ ሳማረፐ ድእድ ኤህዳ ካህነታፐ እሱዋ ዛሪድ፥ ያ የድተ። እ ያ ብድ፥ ሄ ቢታ ፆሳ ዎጋ ኤንታ ታማርሶ” ያግድ ኪትስ። <verse eid="2KI 17:27"/><verse number="28" style="v" sid="2KI 17:28"/>ሄሳ ግሾ፥ ሳማረፐ ድእድ ኤህዳ ካህነታፐ እሶይ ቤተለን ዳናዉ ይድ፥ ጎዳ ጎይኖ ዎጋ ኤንታ ታማርስስ።<verse eid="2KI 17:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 17:29"/>ግዶሽን፥ ሳማረን ኡትዳ አሳይ ባንታዉ ጎይንያ ኤቃ ምስለታ ባ ደእያ በሳን በሳን መዶሶና። ኤንቲ ደእያ ካታማታን፥ ካሰ ባንታዉ ኬፅዳ ቃ ጎይኖ በሳታን ኤፍድ ዎዶሶና። <verse eid="2KI 17:29"/><verse number="30" style="v" sid="2KI 17:30"/>ሄሳዳ ኦድ፥ ባብሎነ አሳይ ሱኮት-ባኖባ ጌተትያ ኤቃ ምስለታ መዶሶና። ኩታ አሳይ አርጋላ ጌተትያ ኤቃ ምስለታ መዶሶና። ሀማታ አሳይ እስማታ ጌተትያ ኤቃ ምስለታ መዶሶና። <verse eid="2KI 17:30"/><verse number="31" style="v" sid="2KI 17:31"/>አዋዋ አሳይ አልባዛራነ ታርታቃ ጌተትያ ኤቃ ምስለታ መዶሶና። ሳፋርዋይማ አሳይ ቃስ አድራመለክነ አናመለካ ጌተትያ ባንታ ፆሳታስ ባንታ ናይታ ታማን ፁግድ ያርሽዶሶና። <verse eid="2KI 17:31"/><verse number="32" style="v" sid="2KI 17:32"/>ኤንቲ ጎዳ ጎይንዶሶና፤ ሽን ባንታ ግዶፈ ዱማ ዱማ አሳ ዶርድ፥ ቃ ጎይኖ በሳታን ካህነ ኦድ ሹምዶሶና። <verse eid="2KI 17:32"/><verse number="33" style="v" sid="2KI 17:33"/>ኤንቲ ጎዳ ጎይንዶሶና፤ ግድኮካ፥ ባንታ ይዳ ቢታ ቢታ አሳ ሜዝያ ካልድ፥ ባንታ ፆሳታካ ጎይንዶሶና። <verse eid="2KI 17:33"/><verse number="34" style="v" sid="2KI 17:34"/>ኤንቲ ሀች ጋካናዉ ካሰ ሜዘትዳይሳዳ ኦሶና።<note caller="-" style="x"><char style="xo" closed="false">17:34 </char><char style="xt" closed="false"><ref loc="GEN 32:28">መ 32:28</ref>፤ <ref loc="GEN 35:10">35:10</ref>.</char></note></para>
  <para style="p" vid="2KI 17:34">ኤንቲ ቱማ ጎዳ ጎይኖኮና ዎይኮ ጎዳይ እስራኤለ ግድ ሱንዳ ያይቆባ ዘረስ እምዳ አዋጁዋነ ዎጋ፥ ህግያነ ኪታ ናጎኮና። <verse eid="2KI 17:34"/><verse number="35" style="v" sid="2KI 17:35"/>ጎዳይ እስራኤለ አሳራ በን ጫቅዳ ዎደ፥ ኤንታ ሀይሳዳ ያግድ ኪትስ፤ “ሀራ ፆሳታ ጎይኖፍተ፤ ኤንታዉ ጉልባቶፕተ፤ ኤንታዉ ኦፍተ ዎይኮ ኤንታዉ ያርሾፍተ።<note caller="-" style="x"><char style="xo" closed="false">17:35 </char><char style="xt" closed="false"><ref loc="EXO 20:5">ከሳ 20:5</ref>፤ <ref loc="DEU 5:9">ዛረ 5:9</ref>.</char></note> <verse eid="2KI 17:35"/><verse number="36" style="v" sid="2KI 17:36"/>ሽን ግብፀፈ ህንተና ባ ግታ ዎልቃንነ ባ ምጨትዳ ኩሸን ከስዳ ጎዳስ ኦተ፤ እያዉ ጉልባትተ፤ እያዉ ያርሾ ያርሽተ።<note caller="-" style="x"><char style="xo" closed="false">17:36 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ዛረ 6:13</ref>.</char></note> <verse eid="2KI 17:36"/><verse number="37" style="v" sid="2KI 17:37"/>ጎዳይ ህንተዉ ፃፍዳ አዋጁዋነ ዎጋ፥ ህግያነ ኪታ ኡባ ዎደ ናግተ፤ ሀራ ፆሳታ ጎይኖፍተ። <verse eid="2KI 17:37"/><verse number="38" style="v" sid="2KI 17:38"/>ታኒ ህንተራ ጫቅዳ ጫቁዋ ዶጎፕተ፤ ሀራ ፆሳታ ጎይኖፍተ። <verse eid="2KI 17:38"/><verse number="39" style="v" sid="2KI 17:39"/>ሄሳ አግድ፥ ጎዳ ህንተ ፆሳ ጎይንተ። ህንተ ሞርከታ ኡባፈ ህንተና አሻናይ ታና” ያግድ ኪትስ። <verse eid="2KI 17:39"/><verse number="40" style="v" sid="2KI 17:40"/>ሽን ኤንቲ እያዉ ኤሮ ጎና እፅድ፥ ካሰ ባንታ ሜዝያ ካልዶሶና። <verse eid="2KI 17:40"/><verse number="41" style="v" sid="2KI 17:41"/>ሄ አሳት ጎዳ ጎይንሸካ፥ እስ ባጋራ ባንታ ኤቃ ምስለታ ጎይኖሶና። ሀች ጋካናዉ ኤንታ ኮቻይ ኤንታ አዋት ጎይነይሳዳ ጎይንሸ ደኦሶና።<verse eid="2KI 17:41"/></para>
  <chapter eid="2KI 17"/>
  <chapter number="18" style="c" sid="2KI 18"/>
  <para style="s1">ይሁዳ ካዋ ህዝቅያሳ</para>
  <para style="r">(<ref loc="2CH 29:1-2">2 ታር 29:1-2</ref>፤ <ref loc="2CH 31:1">31:1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 18:1"/>ኤላ ናአይ ሆሰይ እስራኤለን ካዎትዳ ሄን ላይን፥ ይሁዳ ካዋ አካዛ ናአይ ህዝቅያስ ይሁዳን ካዎትስ። <verse eid="2KI 18:1"/><verse number="2" style="v" sid="2KI 18:2"/>እ ካዎትያ ዎደ ላይ እያዉ ላታማነ እቻሻ፤ የሩሳላመን ላታማነ ኡዱፉን ላይ ካዎትስ። እያ አየ ሱንይ አብያ ጌተቴስ፤ እያ ዛካርያሳ ናእዉ። <verse eid="2KI 18:2"/><verse number="3" style="v" sid="2KI 18:3"/>እያ ማይዛይ ዳዊቲ ኦዳይሳዳ፥ ህዝቅያስ ጎዳ ስንን ሱረባ ኦስ። <verse eid="2KI 18:3"/><verse number="4" style="v" sid="2KI 18:4"/>አሳይ ቃ ጎይኖ በሳታ ድግስ። ኤቃ ቱሳታ መንረስ። አሼራ ጌተትያ ፆሰ ምስልያ ቃንፅ የግስ። ቃስ ሙሰይ ናሰ ብራታፐ መዳ፥ ናሁሽታና ጌተትያ ሾሻ ምስልያ መንረስ። ሄ ዎደይ ጋካናዉ እስራኤለ አሳይ እያዉ እፃነ ጩይስሸ ጋምእስ።<verse eid="2KI 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 18:5"/>ህዝቅያስ ጎዳ እስራኤለ ፆሳ አማንስ፤ ይሁዳ ካዎታ ኡባ ግዶን እያ መላ ካዎይ እያፐ ካሰ ግድን፥ እያፐ ጉየ ግድን በንትቤና። <verse eid="2KI 18:5"/><verse number="6" style="v" sid="2KI 18:6"/>እ ጎዳራ ኦይከትስ፤ ጎዳ ካሎ አግቤና፤ ጎዳይ ሙሰ ኪትዳ ኪታታ ናግስ። <verse eid="2KI 18:6"/><verse number="7" style="v" sid="2KI 18:7"/>ጎዳይ እያራ ግድስ፤ እ ኦያባ ኡባይ እያዉ እንጀትስ። እ አሶረ ካዋ ቦላ ማካልድ፥ እያዉ ሃረቶና እፅስ። <verse eid="2KI 18:7"/><verse number="8" style="v" sid="2KI 18:8"/>እ፥ ፍልስፄመ አሳ ኦልድ ጉ ሞታፐ ብድ፥ ግታ ካታማ ጋካናዉ፥ ጋዛነ እያ ዩሾን ደእያ ቢታት አቶና ኤንቲ ደእያ በሳታ ኡባ ፆንስ።<verse eid="2KI 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 18:9"/>ካዎይ ህዝቅያስ ካዎትዳ ኦይዳን ላይን፥ ኤላ ናአይ እስራኤለ ካዎይ፥ ሆሰይ ካዎትዳ ላፑን ላይን፥ አሶረ ካዎይ ሳልምናሶር እስራኤለ ቦላ ደንድድ፥ ሳማረ ካታማ ተቅስ። <verse eid="2KI 18:9"/><verse number="10" style="v" sid="2KI 18:10"/>ሄን ላይ ሳማረ ካታማ ፆንስ። ያትን፥ ህዝቅያስ ካዎትዳ ኡሱፑን ላይን፥ እስራኤለ ካዎይ ሆሰይ ካዎትዳ ኡዱፉን ላይን፥ ሳማረ ካታማይ ፆነትስ። <verse eid="2KI 18:10"/><verse number="11" style="v" sid="2KI 18:11"/>አሶረ ካዎይ እስራኤለ አሳ አሶረ ቢታ ኤፍድ፥ ኤንታፈ ባጋ አላሀንነ አቦራ ካታማታን፥ ባጋ አጎዛ ሻፋ ማታን ባጋ ቃስ ሜዶና ካታማታን ዎስ። <verse eid="2KI 18:11"/><verse number="12" style="v" sid="2KI 18:12"/>ሄስካ ኤንቲ ጎዳስ ባንታ ፆሳስ ኪተቶና እፅድ፥ ጎዳ ጫቁዋ፥ ጎዳ አይለይ፥ ሙሰይ ኪትዳ ኪታ ኡባ መንዳ ግሾሳ። ኤንቲ እያ ኪታ ስአናዉነ ኪተታናዉ ኮይቦኮና።<verse eid="2KI 18:12"/></para>
  <para style="s1">አሶረ ማንደ</para>
  <para style="r">(<ref loc="2CH 32:1-19">2 ታር 32:1-19</ref>፤ <ref loc="ISA 36:1-22">እሳ 36:1-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 18:13"/>ካዎይ ህዝቅያስ ካዎትዳ ታማነ ኦይዳን ላይን፥ አሶረ ካዎይ ሳናክሬም ግምበትዳ ይሁዳ ካታማታ ኡባ ኦልድ ኦይክስ። <verse eid="2KI 18:13"/><verse number="14" style="v" sid="2KI 18:14"/>ያትን፥ ይሁዳ ካዎይ ህዝቅያስ ላክሶ ካታማን ደእያ አሶረ ካዋ ሳናክሬማስ ኪታ የድድ፥ “ታኒ ባላስ፤ ሀያና ታ ቢታ የዳዳ ከያ። ኔኒ ታና ኦይችዳባ አይባካ ታ ነዉ እማና” ያግስ።</para>
  <para style="p" vid="2KI 18:14">አሶረ ካዎይ፥ ይሁዳ ካዋ ህዝቅያሳኮ፥ “ኔኒ 10,000 ክሎ ግራመ ብራነ 1,000 ክሎ ግራመ ዎርቃ ታዉ የዳ” ያግስ። <verse eid="2KI 18:14"/><verse number="15" style="v" sid="2KI 18:15"/>ህዝቅያስ ፆሳ ኬን፥ ካዎ ጋን ሻሎ ምንጅያ በሳን ደእያ ብራ ኡባ እያዉ የድስ። <verse eid="2KI 18:15"/><verse number="16" style="v" sid="2KI 18:16"/>ሄ ዎደ ይሁዳ ካዎይ ህዝቅያስ፥ ፆሳ ኬ ፐንግያ ሳንቃታ ትይዳ ዎርቃነ እ ባ ሁጰን ፐንገ ቱቀታ ትይዳ ዎርቃ ቃርድ፥ አሶረ ካዋስ የድስ።<verse eid="2KI 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 18:17"/>አሶረ ካዎይ፥ ታርታና፥ ራፌሳነ ራስፋቅሳ ጌተትያ ሄ ቶራ ሞጮናታ፥ ዳሮ ኦላንቾታራ ላክሶ ካታማፐ ካዋ ህዝቅያሳኮ የሩሳላመ የድስ። ኤንቲ ብድ፥ የሩሳላመ ጋክድ፥ ማኦ ሜጭያ አድያ ጋደ ኤፍያ ኦግያፐ ቆሞ ባጋራ ደእያ፥ ዳጋትዳ ሃይ ጎግያ ዛራ ላንቀን ኤቅዶሶና። <verse eid="2KI 18:17"/><verse number="18" style="v" sid="2KI 18:18"/>ኤንቲ ካዋ ፄግን፥ ካዎ ጋ አዋተን አይስያ ካልቀ ናአይ ኤልያቄም፥ ዋና ፃፈይ ሳምናስነ አሳፋ ናአይ ታርከ ፃፈይ ዮኣስ እያኮ ካረ ከይዶሶና።<verse eid="2KI 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 18:19"/>አሶረታ ሀላቃይ፥ “ህዝቅያሳስ ሀይሳዳ ያግድ ኦድተ። አሶረ ካዎይ፥ ዎልቃማይ ነና ሀይሳዳ ያጌስ፤ ‘ኔኒ አይብን አማነታዲ? <verse eid="2KI 18:19"/><verse number="20" style="v" sid="2KI 18:20"/>ኦላ ኦለታናዉ ነዉ ጭንጫተነ ዎልቅ ደኤስ ያጋሳ። ሽን ኔኒ አይብን አማነታዳ ታ ቦላ ሀይሳ ማካላዲ? <verse eid="2KI 18:20"/><verse number="21" style="v" sid="2KI 18:21"/>ሄኮ፥ ኔኒ ግብፀ ካዎይ ማዳና ጋዳ ቆፕያባ ግድኮ፥ መቅዳ ማይረ ፃምአን ካትያ አሳ መላ። ፃምአይ መቅን፥ ፕንጮይ ኩሸ ጫደስነ ማዱንፅሴስ። ግብፀ ካዎይ ባናን አማነትያ አሳ ኡባስ ሄሳ መላ’ ” ያግስ።<verse eid="2KI 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 18:22"/>ሽን ኔኒ፥ “ኑኒ ጎዳን ኑ ፆሳን አማነቶስ” ያግኮ፥ ህዝቅያስ፥ ይሁዳ አሳነ የሩሳላመ አሳ፥ “ህንተ የሩሳላመን ደእያ ያርሾ በሳን ጎይናናዉ ኮሼስ” ግድ፥ ቃ ጎይኖ በሳታነ ያርሾ በሳታ ድግዳይ እያ ግደኔ?<verse eid="2KI 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 18:23"/>ሀእ ሃያ፤ ታ ጎዳ አሶረ ካዉዋራ ማንደታ። ኔኒ ቶጋናዉ ዳንዳእያ፥ ግድያ አስ ደምኮ፥ ናምኡ ሙኩሉ ፓራታ ታኒ ነዉ እማና። <verse eid="2KI 18:23"/><verse number="24" style="v" sid="2KI 18:24"/>ኔኒ፥ “ግብፀት ፓራ አሳታነ ፓራ ጋረታ ታዉ የዳና” ጋዳ አማንኮ፥ ታ ጎዳ ቶራ ሞጮናታፐ እስ ጉካ ዛራናዉ ዳንዳአካ። <verse eid="2KI 18:24"/><verse number="25" style="v" sid="2KI 18:25"/>ሄሳ ቦላ ቃስ፥ ታኒ ሀእ ቱማ ጎዳ ኪት ባይና ሀ ቢታ ይሳናዉ ኮያድና? ጎዳይ ባ ሁጰን ታና፥ “ሄ ቢታ ባዳ፥ ኦላዳ ይሳ” ያግስ።<verse eid="2KI 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 18:26"/>ሄሳፈ ጉየ፥ ካልቀ ናአይ ኤልያቄም፥ ሳምናስነ ዮኣስ አሶረታ ቶራ ሞጮናኮ ሀይሳዳ ያግዶሶና፤ “ኑኒ ብርሸ ኤርያ ግሾ፥ ሀያና ኑስ ነ አይለታስ አራምከ ዶናን ኦዳ። ድርሳ ግምብያ ሁጰ ሶን ደእያ አሳይ ስኦና መላ፥ እብራወ ዶናን ኦዶፓ” ያግዶሶና። <verse eid="2KI 18:26"/><verse number="27" style="v" sid="2KI 18:27"/>ሽን ቶራ ሞጮናይ ዛሪድ፥ “ሀ ቃላ ታኒ ህንተዉነ ህንተ ጎዳ ፃላላስ ኦዳናዉ ታ ጎዳይ ታና ኪትደዬ? ህንተራ እስፈ ባንታ ሽአ ማናዉነ ባንታ ሼሻ ኡያናዉ ደእያ፥ ሀ ድርሳ ግምብያ ቦላ ኡትዳ አሳ ኡባሳ ግደነዬ?” ያግስ።<verse eid="2KI 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 18:28"/>አሶረ ቶራ ሞጮናይ ደንድ ኤቅድ፥ ባ ቃላ ቁ ኦድ፥ እብራወ ዶናን ሀይሳዳ ያግስ፤ “አሶረ ካዎይ ዎልቃማይ ህንተና ግያባ ስእተ! <verse eid="2KI 18:28"/><verse number="29" style="v" sid="2KI 18:29"/>ካዎይ ህንተኮ ሀይሳዳ ያጌስ፤ ‘ህዝቅያስ ህንተና ጭሞፎ፤ እ ህንተና ታ ኩሸፐ ከስ ኤካናዉ ዳንዳኤና። <verse eid="2KI 18:29"/><verse number="30" style="v" sid="2KI 18:30"/>ጎዳይ ቱማ ኑና አሻና፤ ሀ ካታማይካ አሶረ ካዋ ኩሸን ገለና’ ያግድ ህንተ ጎዳን አማነታና መላ ኦፎ” ያጌስ።<verse eid="2KI 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 18:31"/>ህንተ ህዝቅያስ ኦድያባ ስኦፕተ። አሶረ ካዎይ፥ “ታራ ስገትተ፤ ሃ ታኮ ከይተ። ህንተ ኡባይ ህንተ ዎይንያፐነ ህንተ ባላስያፐ ማና፤ ህንተ ቦክዳ ኦላፈ ሃ ኡያና። <verse eid="2KI 18:31"/><verse number="32" style="v" sid="2KI 18:32"/>ታኒ ያዳ፥ ህንተና ህንተ ቢታ ዳንያ ቢታ ኤፋና። ሄ ቢታይ ካነ ዎይነይ፥ ኡይነ ዎይነ ጋደይ ኩምዳ ቢታ፤ ሻማሆ ዛይተይነ ኤስ ኩምዳ ቢታ። ህንተ ታዉ ኪተትኮ፥ ደኦን ዳና፤ ሀይቀከታ። ህዝቅያስ፥ ‘ጎዳይ ኑና አሻና’ ያግድ ህንተና ጭመይሳ ስኦፕተ። <verse eid="2KI 18:32"/><verse number="33" style="v" sid="2KI 18:33"/>ሀራ ካዎተታ ፆሳታፐ ባ ቢታ አሶረ ካዋ ኩሸፐ አሽዳ ፆሲ ደኢ? <verse eid="2KI 18:33"/><verse number="34" style="v" sid="2KI 18:34"/>ሀማታ ፆሳትነ አርፋዳ ፆሳት አዉን ደኦና? ሳፋርዋይማ፥ ሄናነ እዋ ፆሳት አዉን ደኦና? ኤንቲ ሳማረ ታ ኩሸፐ ከስ ኤክዶና? <verse eid="2KI 18:34"/><verse number="35" style="v" sid="2KI 18:35"/>ሀ ቢታታ ፆሳታ ኡባ ግዶን፥ ባ ቢታ ታ ኩሸፐ አይ ፆሲ አሽዳሽን፥ ጎዳይ የሩሳላመ ታ ኩሸፐ አሻኔ?” ያግስ።<verse eid="2KI 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 18:36"/>ካዎይ ካሰ፥ “ኤንታዉ አይኮካ ዛሮፕተ” ያግድ ኦድዳ ግሾ፥ አሳይ እስ ቃላካ ዛሮና ስእ ግዶሶና። <verse eid="2KI 18:36"/><verse number="37" style="v" sid="2KI 18:37"/>ካልቀ ናአይ ካዎ ጋ አዋተን አይስያ ኤልያቄም፥ ዋና ፃፈይ ሳምናስነ ታርከ ፃፈይ አሳፋ ናአይ ዮኣስ ባንታ ማኡዋ ዳክድ፥ ህዝቅያሳኮ ብድ፥ አሶረታ ቶራ ሞጮናይ ግዳባ ኡባ እያዉ ኦድዶሶና።<verse eid="2KI 18:37"/></para>
  <chapter eid="2KI 18"/>
  <chapter number="19" style="c" sid="2KI 19"/>
  <para style="s1">ህዝቅያስ እሳያሳ ዞረ ኦይችስ</para>
  <para style="r">(<ref loc="ISA 37:1-7">እሳ 37:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 19:1"/>ካዎይ ህዝቅያስ ሄሳ ስእዳ ዎደ፥ ባ ማኡዋ ዳክድ፥ ካዮ ማኦ ማእድ፥ ፆሳ ኬ ገልስ። <verse eid="2KI 19:1"/><verse number="2" style="v" sid="2KI 19:2"/>ካዎ ጋ አዋተን አይስያ ኤልያቄም፥ ዋና ፃፈይ ሳምናስነ ጭማ ካህነት ካዮ ማኦ ማእድ፥ አሞፀ ናኣ ናብያ እሳያሳኮ ባና መላ ኪትስ። <verse eid="2KI 19:2"/><verse number="3" style="v" sid="2KI 19:3"/>ኤንቲ እሳያሳኮ ብድ፥ “ህዝቅያስ ሀይሳዳ ያጌስ፤ ‘ሀች ጋላሳይ መቶ ጋላስ፥ ሴራ ጋላስነ ዬላ ጋላስ። ሄስካ ናእ የለታናዉ ዎደይ ጋክን፥ ባናካዳ የላናዉ ዎልቅ ይዳ ማጫሳ መላ። <verse eid="2KI 19:3"/><verse number="4" style="v" sid="2KI 19:4"/>ደኦ ፆሳ ጫያና መላ፥ እያ ጎዳይ፥ አሶረ ካዎይ፥ ኪትዳ ቶራ ሞጮና ቃላ ኡባ፥ ጎዳይ ነ ፆሳይ ስኦና አገና። ቃስ ጎዳይ፥ ነ ፆሳይ ሄ ስእዳ ቃላ ጋሶን እያ ሴሮና አገና። ሄሳ ግሾ፥ ኑ አሳ ግዶፈ ፓላህድ አትዳይሳታስ ዎሳ’ ” ያግዶሶና።<verse eid="2KI 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 19:5"/>ካዋ ህዝቅያሳ አይለት እሳያሳኮ ብዳ ዎደ፥ <verse eid="2KI 19:5"/><verse number="6" style="v" sid="2KI 19:6"/>እሳያስ ኤንታ ሀይሳዳ ያግስ፤ “ህንተ ጎዳስ ሀይሳዳ ያግድ ኦድተ፤ ‘አሶረ ካዋ አይለት ታና ጫይሽን፥ ኔኒ ስእዳ ጫሻ ቃላስ ያዮፋ። <verse eid="2KI 19:6"/><verse number="7" style="v" sid="2KI 19:7"/>ሄኮ፥ ታኒ እያ ግዶ እስ አያና የዳና፤ እ ሄ ዎርያ ስእድ ባ ቢታ ስማና። እ ባ ቢታ ብድ፥ ያን ማሻን ሀይቃናዳ ኦና’ ” ያግስ።<verse eid="2KI 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 19:8"/>አሶረ ካዎይ ላክሶ ካታማፐ ደንድድ ብዳይሳ አሶረታ ቶራ ሞጮናይ ስእድ፥ ጉየ ስሚድ ካዎይ ልብና ካታማን ኦለተይሳ ደምስ።<verse eid="2KI 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 19:9"/>ካዎይ ሳናክሬም፥ “ሄኮ፥ ቶጰ ካዎይ ትርሃቅ ነና ኦላናዉ ይስ” ግያ ዎርያ ስእድ፥ ህዝቅያሳስ ሀይሳዳ ያግድ ኪትስ። <verse eid="2KI 19:9"/><verse number="10" style="v" sid="2KI 19:10"/>“ይሁዳ ካዋዉ ህዝቅያሳ፥ ኔኒ አማነትያ ፆሳይ፥ ‘የሩሳላመይ አሶረ ካዋ ኩሸን ገለና’ ያግድ ጭሞፎ። <verse eid="2KI 19:10"/><verse number="11" style="v" sid="2KI 19:11"/>አሶረ ካዎት ቢታ ኡባ ይስድ፥ ኦዳባ ኔኒ ስአዳሳ። ያትን፥ ኔኒ አታና ዳኒ? <verse eid="2KI 19:11"/><verse number="12" style="v" sid="2KI 19:12"/>በን ታ ማይዛት ይስዳ ቢታ ፆሳት፥ ሄሳትካ፥ ጎዛና፥ ካራነነ ራፌሳ ቢታ ፆሳትነ ታላሳራን ደእያ ኤደነ ፆሳት ሄ ቢታ ዮፐ አሽዶና? <verse eid="2KI 19:12"/><verse number="13" style="v" sid="2KI 19:13"/>ሀማታ ካዎይ፥ አርፋዳ ካዎይ፥ ሳፋርዋይማ ካዎይ፥ ሄና ካዎይነ እዋ ካዎይ አዉን ደኦና?” ያግድ ኪትስ።<verse eid="2KI 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 19:14"/>ህዝቅያስ ዳብዳብያ ኪተትዳ አሳፐ ኤክድ ናባብስ። ዳብዳብያ ፆሳ ኬ ኤፍድ፥ ጎዳ ስንን ምጭስ። <verse eid="2KI 19:14"/><verse number="15" style="v" sid="2KI 19:15"/>ያትድ፥ ጎዳ ሀይሳዳ ያግድ ዎስስ፤ “አቤት ጎዳዉ፥ ክሩበታፐ ግዶን ኡትያ እስራኤለ ፆሳዉ፥ ሳኣ ካዎተታ ኡባ ቦላ ነ ፃላል ፆሰ፤ ሳሉዋነ ሳኣ ኔኒ መዳሳ።<note caller="-" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="EXO 25:2">ከሳ 25:2</ref>.</char></note> <verse eid="2KI 19:15"/><verse number="16" style="v" sid="2KI 19:16"/>አቤት ጎዳዉ፥ ነ ሀይ ሃ ዛራዳ ስአ። አቤት ጎዳዉ፥ ነ አይፍያ ዶያዳ ፄላ። ነና፥ ደኦ ፆሳ ጫያናዉ ሳናክሬም የድዳ ቃላ ስአ። <verse eid="2KI 19:16"/><verse number="17" style="v" sid="2KI 19:17"/>አቤት ጎዳዉ፥ አሶረ ቢታ ካዎት ካዎተታነ ኤንታ ቢታ ይሰይስ ቱማ። <verse eid="2KI 19:17"/><verse number="18" style="v" sid="2KI 19:18"/>ኤንታ ፆሳታ ታማን ፁግድ ይስዶሶና፤ ኤንታ ፆሳት ካሰካ አሳ ኩሸይ ማስድ ከስዳ ምነ ሹቹ ግድያ ግሾ፥ ቱማ ፆሳታ ግዶኮና፤ ሄሳ ግሾ፥ ኤንቲ ኤንታ ይስዶሶና። <verse eid="2KI 19:18"/><verse number="19" style="v" sid="2KI 19:19"/>አቤት ጎዳዉ፥ ነ ፃላል ፆሰ ግደይሳ ሳኣ ካዎተት ኡባይ ኤራና መላ፥ ሀእ ዛራዳ፥ ጎዳዉ፥ ኑ ፆሳዉ፥ ኔኒ ኑና እያ ኩሸፐ አሻ” ያግድ ዎስስ።<verse eid="2KI 19:19"/></para>
  <para style="s1">እሳያስ ካዋስ የድዳ ኪታ</para>
  <para style="r">(<ref loc="ISA 37:21-38">እሳ 37:21-38</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 19:20"/>ሄሳፈ ጉየ፥ አሞፀ ናአይ እሳያስ ህዝቅያሳኮ ሀይሳዳ ያግድ ኪትስ፤ “ጎዳይ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ። ኔኒ አሶረ ካዋ ሳናክሬማ ጋሶን ታና ዎስዳ ዎሳ ስአስ።”<verse eid="2KI 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 19:21"/>ጎዳይ ሳናክሬማባ ሀይሳዳ ያጌስ።</para>
  <para style="q1" vid="2KI 19:21">“ፅዮነ ጌላእያ ነና ካዉሱ፤</para>
  <para style="q2" vid="2KI 19:21">ነና ቦራዉሱ፤</para>
  <para style="q2" vid="2KI 19:21">የሩሳላመ ማጫ ናእያ</para>
  <para style="q2" vid="2KI 19:21">ባ ሁጵያ ቃዳ ነና ቀልቅሳዉሱ።<verse eid="2KI 19:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="2KI 19:22"/>ኔኒ ጫይዳይነ</para>
  <para style="q2" vid="2KI 19:22">ቶችዳይ ኦኔ?</para>
  <para style="q1" vid="2KI 19:22">ኔኒ ነ ቃላ ኦደ ቦላ ቁ ኦዲ?</para>
  <para style="q2" vid="2KI 19:22">ኦቶሮን ቁ ጋዳ ኦና ፄላዲ?</para>
  <para style="q1" vid="2KI 19:22">ሄሳ ኔኒ ኦዳይ ታ ቦላ፥</para>
  <para style="q2" vid="2KI 19:22">እስራኤለ ጌሻ ቦላ ግደነ!<verse eid="2KI 19:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="2KI 19:23"/>ኔኒ ኪትዳ አሳ ባጋራ ጎዳ ጫያዳሳ።</para>
  <para style="q1" vid="2KI 19:23">ቃስ ሀይሳዳ ያጋዳሳ፤</para>
  <para style="q2" vid="2KI 19:23">ታኒ ታዉ ደእያ ዳሮ ፓራ ጋረታን</para>
  <para style="q2" vid="2KI 19:23">ቃ ደረታ ሁጰ፥</para>
  <para style="q2" vid="2KI 19:23">ልባኖሰ ዙማ ሁጵያ ከያስ።</para>
  <para style="q1" vid="2KI 19:23">ከያዳ ኡባፈ አዱቅያ ዝጋታነ</para>
  <para style="q2" vid="2KI 19:23">ኡባፈ ሎእያ ፂዳታ ቃንፃስ።</para>
  <para style="q1" vid="2KI 19:23">ታኒ እያዉ ዉርሰ ጋፃነ</para>
  <para style="q2" vid="2KI 19:23">ስክዳ ዎራ ጋካስ።<verse eid="2KI 19:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="2KI 19:24"/>ታኒ አላጋ ቢታታን ሃ ኦላ</para>
  <para style="q2" vid="2KI 19:24">ቦካዳ፥ ሃ ያፐ ኡያስ።</para>
  <para style="q1" vid="2KI 19:24">ግብፀ ቢታን ጎግያ ሃ ኡባ</para>
  <para style="q2" vid="2KI 19:24">ታኒ ታ ቶሁዋን የዳ መልሳስ” ያጋዳሳ።<verse eid="2KI 19:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="2KI 19:25"/>“ዳሮ ዎደፐ ካሰ ኔኒ</para>
  <para style="q2" vid="2KI 19:25">ግምበትዳ ካታማታ ላላዳ፥</para>
  <para style="q2" vid="2KI 19:25">ላለ ዶረ ከሳና መላ፥</para>
  <para style="q2" vid="2KI 19:25">ታኒ ቆፋ ቃችዳይሳ ኔኒ ስአብኪ?</para>
  <para style="q1" vid="2KI 19:25">ታኒ ሀእ ፖልያ ሀልቾታ</para>
  <para style="q2" vid="2KI 19:25">በን ሀልቻ ዎስ።<verse eid="2KI 19:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="2KI 19:26"/>ሄሳ ግሾ፥ ኤንታ አሳስ ዎልቅ እፅን፥</para>
  <para style="q2" vid="2KI 19:26">ኤንቲ ካዉይዶሶናነ ዬላትዶሶና።</para>
  <para style="q1" vid="2KI 19:26">ኤንቲ ጋደ ማታ መላ፤</para>
  <para style="q2" vid="2KI 19:26">ጎሻን ሞክዳ ጫርሻ መላ።</para>
  <para style="q1" vid="2KI 19:26">ኤንቲ ኬ ሁጰን ዶልያ ሻራፋ መላ</para>
  <para style="q2" vid="2KI 19:26">ካፆና ደእሽን፥</para>
  <para style="q2" vid="2KI 19:26">ሌገይ ምዳ ካዳ ሀንዶሶና።<verse eid="2KI 19:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="2KI 19:27"/>ሽን ኔኒ ኡትያ በሳ፥</para>
  <para style="q2" vid="2KI 19:27">ከይያነ ገልያ በሳ፥</para>
  <para style="q2" vid="2KI 19:27">ታ ቦላ ኔኒ ሸነትዳ ሸንያ ታኒ ኤራይስ።<verse eid="2KI 19:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="2KI 19:28"/>ኔኒ ታ ቦላ ይሎትዳ ግሾነ</para>
  <para style="q2" vid="2KI 19:28">ነ ኦቶሩዋካ ታኒ ስእዳ ግሾ፥</para>
  <para style="q2" vid="2KI 19:28">ታኒ ነ ሲያን ዳፎ አና፤</para>
  <para style="q2" vid="2KI 19:28">ነ ዶናን ብፃላ ባርሳና።</para>
  <para style="q1" vid="2KI 19:28">ያታዳ ነ ይዳ ኦግያራ</para>
  <para style="q2" vid="2KI 19:28">ታኒ ነና ጉየ ዛራና” ያግስ።<verse eid="2KI 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 19:29"/>እሳያስ ካዋ ህዝቅያሳኮ ሀይሳዳ ያግስ፤ “ሀይስ ፖለታናይሳስ ማላታይ ሀይሳ፤ ሀ ላይ ህንተ አሰቦ ካፅዳ ካ ማና፤ ላይ ቃስ ሀ ላይ ካፅዳ አሰቦ ማና። ሽን ካልያ ላይ ህንተ፥ ህንተዉ ዘርተነ ጫክተ፤ ዎይነ ቶክተነ እያ ሚተ። <verse eid="2KI 19:29"/><verse number="30" style="v" sid="2KI 19:30"/>ይሁዳ አሳፐ አትዳይሳት ፃጶ የድድ፥ አይፈ አይፍያ ም መላ ግዳና። <verse eid="2KI 19:30"/><verse number="31" style="v" sid="2KI 19:31"/>አትዳይሳት የሩሳላመፐ ከያና፥ ፓላህዳይሳት ፅዮነፐ ያና። ኡባፈ ዎልቃማ ጎዳ ምሻይ ሄሳ ኦና።<verse eid="2KI 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 19:32"/>“ሄሳ ግሾ፥ አሶረ ካዉዋባ ጎዳይ ሀይሳዳ ያጌስ፤ ‘አሶረ ካዎይ ሀ ካታማ ገለና፤ ዎይኮ ሀይሳን ባ ዶንገ ዱከና። እ ባ ጎንዳልያ ኦይክድ፥ ሀ ካታማ ስን አና፤ ዎይኮ ካታማ ዩሹዋ ቢታ ዶረን ተቀተና። <verse eid="2KI 19:32"/><verse number="33" style="v" sid="2KI 19:33"/>አሶረ ካዎይ ባ ይዳ ኦግያራ ጉየ ስማና፤ እ ሀ ካታማ ገለና። ታኒ ጎዳይ ሀይሳ ኦዳስ።’ <verse eid="2KI 19:33"/><verse number="34" style="v" sid="2KI 19:34"/>ታኒ ታ ቦንቹዋ ግሾነ ታ አይልያ ዳዊታ ግሾ፥ ሀ ካታማ ተቃዳ አሻና” ያግስ።<verse eid="2KI 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 19:35"/>ሄ ቃማ ጎዳ ኪታንቾይ ከይድ፥ አሶረ አሳይ ዱንካንዳ በሳን እስ ፄታነ ሆስፑን ታማነ እቻሹ ሙኩሉ አደታ ዎስ። ያትን አሳይ ዎንታ ደንድድ በእያ ዎደ፥ ሄኮ፥ አህ ሄራን ኩምስ። <verse eid="2KI 19:35"/><verse number="36" style="v" sid="2KI 19:36"/>አሶረ ካዎይ ሳናክሬም ደንድድ፥ ጉየ ስም ብድ፥ ናናወ ካታማን ኡትስ። <verse eid="2KI 19:36"/><verse number="37" style="v" sid="2KI 19:37"/>እስ ጋላስ ሳናክሬም ባ ፆሳ ናሳራካ ኤቃ ኬን ጎይንሽን፥ እያ ናይት አድራመለክነ ሳርሳር ማሻን እያ ዎድ፥ አራራተ ቢታ ባቃትዶሶና። እያ ናአይ አስራዶን እያ በሳን ካዎትስ።<verse eid="2KI 19:37"/></para>
  <chapter eid="2KI 19"/>
  <chapter number="20" style="c" sid="2KI 20"/>
  <para style="s1">ካዋ ህዝቅያሳ ፓፁዋ</para>
  <para style="r">(<ref loc="2CH 32:24-26">2 ታር 32:24-26</ref>፤ <ref loc="ISA 38:1-8">እሳ 38:1-8</ref>፥ <ref loc="ISA 38:21-22">21-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 20:1"/>ሄ ዎደ ካዎይ ህዝቅያስ ሀርግድ፥ ሀይቃናዉ ማትስ። አሞፀ ናአይ ናበይ እሳያስ እያኮ ብድ፥ “ጎዳይ፥ ‘ኔኒ ነ ሀርግያፈ ፓፃካ፤ ነ ሀይቃና፤ ሄሳ ግሾ፥ ነ ኬ ጊግሳ’ ” ያግስ።<verse eid="2KI 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 20:2"/>ህዝቅያስ ጎዳኮ ስሚድ፥ ፆሳ ዎስስ። <verse eid="2KI 20:2"/><verse number="3" style="v" sid="2KI 20:3"/>“አቤት ጎዳዉ፥ ታኒ ነ ስንን ቱማተን፥ ኩመ ዎዛናን ሄመትዳይሳነ ነና ኡፋይስያባ ኦዳይሳ ኔኒ ቆፓና መላ ታኒ ነና ዎሳይስ” ያግድ፥ ዳሮ ጫመትድ፥ ዬክድ ዎስስ።<verse eid="2KI 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 20:4"/>እሳያስ ካዋ ስንፈ ከይድ፥ ካዎ ጋ ዳባባ ካንድ ቦና ደእሽን፥ ጎዳ ቃላይ ሀይሳዳ ያግሸ እያኮ ይስ። <verse eid="2KI 20:4"/><verse number="5" style="v" sid="2KI 20:5"/>“ጉየ ስማዳ ባዳ ታ አሳ ካለያ ህዝቅያሳስ ሀይሳዳ ያጋዳ ኦዳ። ጎዳይ፥ ነ ማይዛ ዳዊታ ፆሳይ ሀይሳዳ ያጌስ፤ ‘ታኒ ነ ዎሳ ስአስ፤ ነ አፉ በአስ። ሄኮ፥ ታኒ ነና ፓና፤ ሄ ጋላሳፐ ጉየ፥ ኔኒ ፆሳ ኬ ባና። <verse eid="2KI 20:5"/><verse number="6" style="v" sid="2KI 20:6"/>ነ ላይ ቦላ ታኒ ነዉ ታማነ እቻሹ ላይ ጉጃና። ታኒ ነናነ ሀ ካታማ አሶረ ካዋ ኩሸፐ አሻና። ታኒ ታ ቦንቹዋ ግሾነ ታ አይልያ ዳዊታ ግሾ፥ ሀ ካታማስ ኦለታዳ አሻና’ ያጌስ” ያግስ። <verse eid="2KI 20:6"/><verse number="7" style="v" sid="2KI 20:7"/>እሳያስ፥ “ባላሰ ቴራ ዳፅድ፥ እያ ክፃ ቦላ ዎተ፤ እ ፓፃና” ያግስ።<verse eid="2KI 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 20:8"/>ህዝቅያስ እሳያሳ፥ “ጎዳይ ታና ፓናይሳነ ታኒ ሄን ጋላስ ፆሳ ኬ ባናይሳስ ማላታይ አይቤ?” ያግድ ኦይችስ።<verse eid="2KI 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 20:9"/>እሳያስ፥ “ጎዳይ ባ ግዳ ቃላ ፖላናዉ ነዉ ማላታ እማና። ህዛ ኔኒ ሀይሳታፐ አዉሳ ዶራይ? ኩያይ ታሙ ደ ስን ባና መላ ኮያዬ? ታሙ ደታ ጉየ ባና መላ ኮያይ?” ያግድ ኦይችስ።<verse eid="2KI 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 20:10"/>ህዝቅያስ፥ “ኩያይ ስን ባናይስ መተና፤ ኩያይ ጉየ ስማናዳ ኦ” ያግስ። <verse eid="2KI 20:10"/><verse number="11" style="v" sid="2KI 20:11"/>ናበይ እሳያስ ጎዳ ዎስን፥ ጎዳይ ካዎይ አካዝ ግምብስዳ ደ ቦላ ሸምፕዳ ኩያይ ታሙ ደ ጉየ ዛርስ።<verse eid="2KI 20:11"/></para>
  <para style="s1">ባብሎነፐ ኪተትዳ አሳታ</para>
  <para style="r">(<ref loc="ISA 39:1-8">እሳ 39:1-8</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 20:12"/>ሄ ዎደ ባልዳና ናአይ፥ ባብሎነ ካዎይ፥ ማሮዳክ ባልዳን ህዝቅያስ ሀርግዳይሳ ስእዳ ግሾ፥ ዳብዳበነ እሞታ ህዝቅያሳስ የድስ። <verse eid="2KI 20:12"/><verse number="13" style="v" sid="2KI 20:13"/>ህዝቅያስ ኪተትድ ይዳ አሳታ ሞክስ። ባ ሻሎ ምንጅያ ኬን ደእያ ብራ፥ ዎርቃ፥ ሳዉዋ፥ አልኦ ዛይትያ፥ ባ ኦላ ሚሽያነ ባ ሻሎ ምንጅያ ኬን ደእያባ ኡባ ኤንታ በስስ። ባ ሶን ዎይኮ ባ ጋን ደእያባ ኡባፈ ህዝቅያስ ኤንታ በሶና አግዳባይ አይብካ ባዋ።<verse eid="2KI 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 20:14"/>ናበይ እሳያስ ካዋ ህዝቅያሳኮ ብድ፥ “ሀ አሳት ዎይግዶና? ኤንቲ አዉፐ ይዶና?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 20:14">ህዝቅያስ፥ “ኤንቲ ታኮ ሃሆ ቢታፈ፥ ባብሎነፐ ይዶሶና” ያግስ።<verse eid="2KI 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 20:15"/>እሳያስ፥ “ኤንቲ ነ ሶን አይ አይ በእዶና?” ያግስ።</para>
  <para style="p" vid="2KI 20:15">ህዝቅያስ፥ “ኤንቲ ታ ጋን ደእያ ኡባ በእዶሶና፤ ታ ሻሎ ምንጅያ ኬን ደእያባፐ ታኒ ኤንታ በሳቦናባይ ባዋ” ያግስ።<verse eid="2KI 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 20:16"/>እሳያስ ህዝቅያሳኮ፥ “ጎዳይ ግያባ ስአ። <verse eid="2KI 20:16"/><verse number="17" style="v" sid="2KI 20:17"/>‘ሄኮ፥ ነ ጋን ደእያባ ኡባይነ ነ ማይዛት ሀች ጋካናዉ ሺሽዳባ ኡባይ ድኤትድ፥ ባብሎነ ቢታ ባና ጋላስ ያና፤ እያፐ አይብካ አተና። <verse eid="2KI 20:17"/><verse number="18" style="v" sid="2KI 20:18"/>ቃስ ነዉ የለታና፥ ነ አሾነ ነ ሱ ግድዳ ነ አደ ናይት ድኤትድ ብድ፥ ባብሎነ ካዎ ጋን ሹፋ ግድድ ኦና’ ” ያግስ።<verse eid="2KI 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 20:19"/>ህዝቅያስ ዛሪድ፥ “ኔኒ ኦድዳ ጎዳ ቃላይ ሎኦ” ያግስ። ህዝቅያስ፥ “ታኒ ደእዳ ላይን ሳሮይነ ዎፓተ ዳና ግደነ” ያግድ ቆፕስ።<verse eid="2KI 20:19"/></para>
  <para style="s1">ህዝቅያሳ ሀይቁዋ</para>
  <para style="r">(<ref loc="2CH 32:32-33">2 ታር 32:32-33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 20:20"/>ህዝቅያስ ሀንዳ ሀራባይ፥ እያ ምኖተይነ ሃ ዜርድ፥ ቢታ ግዶራ ሃ ካታማ ገልስዳባይ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 20:20"/><verse number="21" style="v" sid="2KI 20:21"/>ህዝቅያስ ሀይቅድ፥ ባ ማይዛታን ጋሄትስ፤ እያ በሳን እያ ናአይ ምናሰይ ካዎትስ።<verse eid="2KI 20:21"/></para>
  <chapter eid="2KI 20"/>
  <chapter number="21" style="c" sid="2KI 21"/>
  <para style="s1">ይሁዳ ካዋ ምናሰ</para>
  <para style="r">(<ref loc="2CH 33:1-20">2 ታር 33:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 21:1"/>ምናሰይ ካዎትያ ዎደ እያዉ ላይ ታማነ ናምአ፤ እ የሩሳላመን እሻታማነ እቻሹ ላይ ካዎትስ፤ እያ አየ ሱንይ ሄፍሴቦ።<verse eid="2KI 21:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 21:2"/>ጎዳይ እስራኤለ አሳ ስንፈ ጎድድ ከስዳ አሳታ ደኡዋ ዎጋ ካልድ፥ ምናሰይ ጎዳ ስንን ኢታባ ኦስ። <verse eid="2KI 21:2"/><verse number="3" style="v" sid="2KI 21:3"/>እያ አዋይ ህዝቅያስ ላልዳ፥ ቃ ጎይኖ በሳታ እ ዛረድ ኬፅስ፤ እስራኤለ ካዎይ አካብ ኦዳይሳዳ፥ ባኣለ ፆሳስ ያርሾ በሳታነ አሼራ ፆሰ ምስለታ መስ። ቃስ ሳሎ ፆልንቶታ ኡባ ጎይንስ፤ ኤንታና ሀጋዝስ። <verse eid="2KI 21:3"/><verse number="4" style="v" sid="2KI 21:4"/>ጎዳይ፥ “ታኒ ታ ሱን የሩሳላመን ፄግሳና” ያግድ ኦድዳ ፆሳ ኬን ሀራ ፆሳታስ ያርሾ በሳታ ጊግስስ። <verse eid="2KI 21:4"/><verse number="5" style="v" sid="2KI 21:5"/>ፆሳ ኬን ደእያ ናምኡ ዳባባታን ሳሎ ፆልንቶታ ኡባስ ያርሾ በሳታ ጊግስስ። <verse eid="2KI 21:5"/><verse number="6" style="v" sid="2KI 21:6"/>ባ ናኣ ታማ ግዶራ አስ። እ ባ ሁጰን ብታንቾነ ሙሩንያ አስ ግድድ፥ ማሮታነ ሞይትለታ ዞረ ኦይችስ። ጎዳ ስንን ዳሮ ኢታባ ኦድ፥ እያ ሀንቀስ።<verse eid="2KI 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 21:7"/>ማሰትድ ከይዳ አሼራ ፆሰ ምስልያ ኤህድ፥ ፆሳ ኬ ግዶን ኤስስ። ሄ ፆሳ ኬይ፥ ጎዳይ ዳዊታነ እያ ናኣ ሶሎሞነ፥ “እስራኤለ ዛረ ኡባ ግዶፈ ታኒ ዶርዳ ሀ ፆሳ ኬን የሩሳላመን ታኒ ታ ሱን መርናዉ ፄግሳና። <verse eid="2KI 21:7"/><verse number="8" style="v" sid="2KI 21:8"/>እስራኤለ አሳ ታኒ ኪትዳ ኪታ ኡባነ ታ አይለይ ሙሰይ ኤንታዉ እምዳ ህግያ ኡባ ናግድ ኦኮ፥ ታኒ ኤንታ ማይዛታስ እምዳ ቢታፈ ኤንታ ደንዳ ይስከ” ያግዳ ፆሳ ኬ። <verse eid="2KI 21:8"/><verse number="9" style="v" sid="2KI 21:9"/>ሽን አሳይ ስኦናን እፅስ፤ ጎዳይ እስራኤለ አሳ ስንፈ ይስዳ ሀራ ካዎተታፐ አድ ኢታ ኦና መላ ምናሰይ ኤንታ ባለስ።<verse eid="2KI 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 21:10"/>ጎዳይ ባ አይለ ግድዳ ናበታ ባጋራ ሀይሳዳ ያግስ፤ <verse eid="2KI 21:10"/><verse number="11" style="v" sid="2KI 21:11"/>“ይሁዳ ካዎይ ምናሰይ ሀ ቱና ኦሱዋ ኦስ፤ ባፐ ካሰ ደእዳ አሞረ አሳ ኡባ ናጋራፐ አያ ኢታ ናጋራ ኦስ። ይሁዳ አሳ ባ መዳ ኤቃ ምስልያ ጎይንስድ፥ ናጋራ ኦስስስ። <verse eid="2KI 21:11"/><verse number="12" style="v" sid="2KI 21:12"/>ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፤ ‘ሄኮ፥ ስእያ አሳ ኡባ ሀይስ ኢትያ ዮ የሩሳላመ ቦላነ ይሁዳ ቦላ ኤሀና ሀናይስ። <verse eid="2KI 21:12"/><verse number="13" style="v" sid="2KI 21:13"/>ሳማረ ቦላ የግዳ ዋ ዎዶሩዋ፥ የሩሳላመ ቦላ የጋና፤ አካባ ሶ አሳ ቦላ የድዳ ቱምብያ፥ የሩሳላመ ቦላ የዳና። እስ አስ ከረ ሜጭድ ጉፋንድ መልሰይሳዳ፥ ታኒ የሩሳላመ ቁቻዳ ጉፋንና። <verse eid="2KI 21:13"/><verse number="14" style="v" sid="2KI 21:14"/>ታ አሳፐ አትዳይሳታ ታኒ የጋ አጋና፤ ታኒ ኤንታ ኤንታ ሞርከታ ኩሸን አዳ እማና። ኤንታ ሞርከት ኡባይ ኤንታ ኦይካናነ ቦንቃና። <verse eid="2KI 21:14"/><verse number="15" style="v" sid="2KI 21:15"/>ኤንታ ማይዛት ግብፀፈ ከዮሶፐ ሀች ጋካናዉ፥ ኤንቲ ታ ስንን ኢታባ ኦዳ ግሾነ ታና ሀንቀዳ ግሾ፥ ታኒ ሀይሳ ኦና’ ” ያግስ።<verse eid="2KI 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 21:16"/>ምናሰይ ይሁዳ አሳ፥ ጎዳ ስንን ናጋራ ኦስስዳይሳ ቦላ ጉጅድ፥ ፅሎ አሳ ዎስ፤ የሩሳላመ ጋፃፐ ጋፃ ጋካናዉ፥ ሱን ኩንስ።<verse eid="2KI 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 21:17"/>ምናሰይ ሀንዳ ሀራባይ፥ እ ኦዳባይ፥ እ ኦዳ ናጋራይ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 21:17"/><verse number="18" style="v" sid="2KI 21:18"/>ምናሰይ ሀይቅድ፥ ባ ማይዛታን ጋሄትስ፤ ባ ጋዋ ማታን ደእያ ኦዛ ጋደን ሞገትስ፤ እያ በሳን እያ ናአይ አሞን ካዎትስ።<verse eid="2KI 21:18"/></para>
  <para style="s1">ይሁዳ ካዋ አሞነ</para>
  <para style="r">(<ref loc="2CH 33:21-25">2 ታር 33:21-25</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 21:19"/>አሞን ካዎትያ ዎደ፥ እያዉ ላይ ላታማነ ናምአ፤ እ የሩሳላመን ናምኡ ላይ ካዎትስ። እያ አየ ሱንይ ማሱላሞ፤ እያ ዮፅባ አድያ ሀሩሰ ናአ። <verse eid="2KI 21:19"/><verse number="20" style="v" sid="2KI 21:20"/>እያ አዋይ፥ ምናሰይ ኦዳይሳዳ፥ አሞነይካ ጎዳ ስንን ኢታባ ኦስ። <verse eid="2KI 21:20"/><verse number="21" style="v" sid="2KI 21:21"/>እ ባ አዋይ ሄመትዳ ኦግያን ሄመትስ፤ ባ አዋይ ኦዳ ኤቃታስ እካ ኦስ፤ ኤንታ ጎይንስ። <verse eid="2KI 21:21"/><verse number="22" style="v" sid="2KI 21:22"/>ጎዳ፥ ባ ማይዛታ ፆሳ አግስ፤ ጎዳ ኦግያን እ ሄመትቤና።<verse eid="2KI 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 21:23"/>አሞነ ሹማት እያ ቦላ ማቀትድ፥ ካዎ ጋን እያ ዎዶሶና። <verse eid="2KI 21:23"/><verse number="24" style="v" sid="2KI 21:24"/>ሄሳፈ ጉየ፥ ይሁዳ አሳይ ካዋ አሞነ ቦላ ማቀትዳ ኡባታ ዎዶሶና። አሞነ በሳን እያ ናኣ እዮስያሳ ካዎዶሶና።<verse eid="2KI 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 21:25"/>አሞን ሀንዳ ሀራባይነ እ ኦዳባ ኡባይ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 21:25"/><verse number="26" style="v" sid="2KI 21:26"/>አሞን ኦዛ ጋደን ባ ዱፉዋን ሞገትስ፤ እያ በሳን እያ ናአይ እዮስያስ ካዎትስ።<verse eid="2KI 21:26"/></para>
  <chapter eid="2KI 21"/>
  <chapter number="22" style="c" sid="2KI 22"/>
  <para style="s1">ይሁዳ ካዋ እዮስያሳ</para>
  <para style="r">(<ref loc="2CH 34:1-2">2 ታር 34:1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 22:1"/>እዮስያስ ካዎትያ ዎደ፥ እያዉ ላይ ሆስፑና፤ እ የሩሳላመን ሀስታማነ እስ ላይ ካዎትስ። እያ አየ ሱንይ ይድዳ፤ እያ ባፁሮታ አድያ አዳያ ናአ።<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="JER 3:6">ኤርም 3:6</ref>.</char></note> <verse eid="2KI 22:1"/><verse number="2" style="v" sid="2KI 22:2"/>እዮስያስ ጎዳ ስንን ሱረባ ኦስ፤ ኡሻች ሀድርስ ጎና ባ ማይዛ ዳዊታ ኦግያን ሄመትስ።<verse eid="2KI 22:2"/></para>
  <para style="s1">ህገ ማፃፋይ በንትስ</para>
  <para style="r">(<ref loc="2CH 34:8-28">2 ታር 34:8-28</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 22:3"/>ካዎይ እዮስያስ ባ ካዎትዳ ታማነ ሆስፑን ላይን፥ ማሱላማ ናኣ ናኣ፥ ኤዛላሳ ናኣ፥ ዋና ፃፍያ ሳፋና፥ ፆሳ ኬን ሀይሳዳ ያግድ ኪትስ። <verse eid="2KI 22:3"/><verse number="4" style="v" sid="2KI 22:4"/>“አሳይ ፆሳ ኬ ኤህን፥ ፆሳ ኬ ፐንግያ ናገይሳት አሳፐ ሺሽዳ ሚሽያ ታይባናዳ፥ ካህነ ሀላቃ ካልቀኮ ባ። <verse eid="2KI 22:4"/><verse number="5" style="v" sid="2KI 22:5"/>ካህነ ሀላቃይ ሚሽያ ፆሳ ኬ ኦራናዉ ሀላቃታስ እማና መላ ኦዳ። ኤንትካ ፆሳ ኬ ኦራያ ኦሳንቾታስ፥ <verse eid="2KI 22:5"/><verse number="6" style="v" sid="2KI 22:6"/>አናፀታስ፥ ግምበይሳትስነ ሹቹ ማሰይሳታስ ቃንፆ። ቃስ ፆሳ ኬ ኦራናዉ፥ ምነ ቆኤትዳ ሹቹ ሻመይሳታስ ቃንፆ። <verse eid="2KI 22:6"/><verse number="7" style="v" sid="2KI 22:7"/>ኦሱዋ አዋተን ፄለይሳት አማንያ አስ ግድያ ግሾ፥ ኤንታ ኩሸን ገልዳ ሚሽያን አይ አይ ኦዳኮ፥ ኤንታ ኦይቻናዉ ኮሸና”<note caller="-" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="2KI 12:15">2 ካዎ 12:15</ref>.</char></note> ያግስ።<verse eid="2KI 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 22:8"/>ሄሳፈ ጉየ፥ ካህነ ሀላቃይ ካልቀይ ዋና ፃፍያ ሳፋናኮ፥ “ህገ ማፃፋ ፆሳ ኬን ደማስ” ያግስ። ማፃፋ ሳፋናስ እምን ሳፋን ኤክድ ናባብስ።<verse eid="2KI 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 22:9"/>ዋና ፃፈይ ሳፋን ካዋኮ ብድ፥ “ፆሳ ኬን ደእያ ሚሽያ ነ ሹማት ኤክድ፥ ፆሳ ኬ ኦራናዉ ሀላቃታስ እምዶሶና” ያግስ። <verse eid="2KI 22:9"/><verse number="10" style="v" sid="2KI 22:10"/>ካልድ፥ ዋና ፃፈይ ሳፋን፥ “ካህነይ ካልቀይ ታዉ እምዳ ማፃፋ ሀይሳ በአ” ያግድ ካዋ ስንን ማፃፋ ናባብስ።<verse eid="2KI 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 22:11"/>ናባብን ካዎይ ህገ ማፃፋን ደእያ ቃላ ስእዳ ዎደ፥ አዛንድ ባ ማኡዋ ዳክስ። <verse eid="2KI 22:11"/><verse number="12" style="v" sid="2KI 22:12"/>ካዎይ፥ ካህንያ ካልቀ፥ ሳፋና ናኣ አክቃማ፥ ምክያሳ ናኣ አክቦራ፥ ዋና ፃፍያ ሳፋናነ ካዋ ኦሳንቹዋ አሳያ ሀይሳዳ ያግድ ኪትስ። <verse eid="2KI 22:12"/><verse number="13" style="v" sid="2KI 22:13"/>“ብድ፥ ታ ግሾ፥ ሀ አሳ ግሾነ ይሁዳ ኡባ ግሾ፥ ሀ በንትዳ ማፃፋ ቃላባ አነ ጎዳ ኦይችተ። ኑኒ ፃፈትዳ ኡባባ ኦናዉ፥ ኑ ማይዛት ሀ ማፃፋ ቃላስ ኪተትቦና ግሾ፥ ኑ ቦላ ሱልዳ ጎዳ ሀንቆይ ዳሮ” ያግስ።<verse eid="2KI 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 22:14"/>ያግን ካህነይ ካልቅያስ፥ አክቃም፥ አክቦር፥ ሳፋንነ አሳይ ማጫ ናብዉ ህልዳና ኦይቻናዉ ብዶሶና። ህልዳና ሀርሃሳ ናኣ ትቅዋ ናአ፥ ፆሳ ኬ ማኡዋ ናግያ ሳሌማ ማቾ። እያ የሩሳላመን ናምአን ጉታን ደአውሱ። ሄ ብዳ አሳት ኢራ ኦደትዶሶና።<verse eid="2KI 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 22:15"/>ህልዳና፥ “ጎዳይ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፤ ህንተና ታኮ ኪትዳ አድያስ ኦድተ። <verse eid="2KI 22:15"/><verse number="16" style="v" sid="2KI 22:16"/>ጎዳይ ሀይሳዳ ያጌስ፤ ‘ይሁዳ ካዎይ ናባብዳ ማፃፋን ፃፈትዳ ኢታ ቃላ ኡባ ታኒ ሀ በሳኒኔ ኢያን ደእያ አሳ ቦላ ኤሀና ሀናይስ። <verse eid="2KI 22:16"/><verse number="17" style="v" sid="2KI 22:17"/>ኤንቲ ታና አግድ፥ ሀራ ፆሳታስ እፃነ ጩይስዶሶና፤ ኤንቲ ባንታ ኩሸን ኦዳባ ኡባን ታና ሀንቀዶሶና። ሄሳ ግሾ፥ ታ ሀንቆይ ሀ በሳ ቦላ ኤፅስ፤ ቶአናዉ ዳንዳኤና’ ያጌስ። <verse eid="2KI 22:17"/><verse number="18" style="v" sid="2KI 22:18"/>ጎዳ ኦይቻናዉ ህንተና ኪትዳ ካዋኮ ሀይሳዳ ያግተ፤ ‘ጎዳይ እስራኤለ ፆሳይ ኔኒ ስእዳ ቃላባ ሀይሳዳ ያጌስ። <verse eid="2KI 22:18"/><verse number="19" style="v" sid="2KI 22:19"/>ታኒ ሀ በሳኒኔ ኢያን ደእያ አሳ ባደስነ ዮስ አዳ እማና ግዳ ቃላ ስእዳ ዎደ፥ ነ ዎዛናይ ሹግን፥ ታ ስንን ነና ካዉሽዳ ግሾነ ነ ማኡዋ ዳካዳ፥ ታ ስንን ዬክዳ ግሾ፥ ታኒ ነ ዎሳ ስአስ። <verse eid="2KI 22:19"/><verse number="20" style="v" sid="2KI 22:20"/>ሄሳ ግሾ፥ ታኒ ነና ሳሮን ነ ማይዛታን ጋና፤ ኔኒ ሳሮ ሞገታና። ታኒ ሀ በሳኒኔ ኢያን ደእያ አሳ ቦላ ኤሀና ኢታባ ነ አይፈይ በኤና’ ያጌስ” ያጋሱ። ኤንቲ ብድ፥ ሀ ኦደትዳባ ካዋስ ኦድዶሶና።<verse eid="2KI 22:20"/></para>
  <chapter eid="2KI 22"/>
  <chapter number="23" style="c" sid="2KI 23"/>
  <para style="s1">እዮስያስ ኤቃ ጎይኖ ይስስ</para>
  <para style="r">(<ref loc="2CH 34:3-7">2 ታር 34:3-7</ref>፥ <ref loc="2CH 34:29-33">29-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 23:1"/>ካዎይ እዮስያስ ይሁዳ ጭማታነ የሩሳላመ ጭማታ ኡባ ሺሽስ። <verse eid="2KI 23:1"/><verse number="2" style="v" sid="2KI 23:2"/>ካዎይ ፑደ ፆሳ ኬ ከይስ፤ ይሁዳ አሳይ፥ የሩሳላመን ደእያ አሳይ፥ ካህነትነ ናበት፥ ጉፈ ግታ ጋካናዉ ኡባይ እያራ እስፈ ፑደ ፆሳ ኬ ከይዶሶና። ፆሳ ኬፈ በንትዳ ጫቆ ቃላ ማፃፋ ኡባ ካዎይ ኤንታዉ ናባብስ። <verse eid="2KI 23:2"/><verse number="3" style="v" sid="2KI 23:3"/>ካዎይ ቱሳ ማታን ኤቅድ፥ ኤንቲ ጎዳ ኦግያን ሄመታናነ፥ እያ ህግያ፥ እያ ዎጋነ እያ ኪታ ኩመ ዎዛናንነ ኩመ ቆፋን ናጋናዉ፥ ቃስ ሀ ማፃፋን ፃፈትዳ ጫቁዋ ኦናዉ ጎዳ ስንን ጫቅስ። አሳ ኡባይካ እያራ ጫቅዶሶና።<verse eid="2KI 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 23:4"/>ካዎይ ካህነ ሀላቃ ካልቀ፥ እያፐ ጋርሳራ ደእያ ካህነታነ ፐንገ ናገይሳታ ባኣለ፥ አሼራነ ሳሎ ፆልንቶታ ጎይናናዉ ጊግስዳ ሚሸታ ኡባ ፆሳ ኬፈ ከሳናዳ ኪትስ። ካዎይ ሄሳታ የሩሳላመፐ ጋፃ ከስድ፥ ቀድሮና ዛንጋራን ፁግድ፥ ብዱዋ ቤተለ ኤፍስ።<verse eid="2KI 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 23:5"/>ይሁዳ ካታማታንነ የሩሳላመ ዩሹዋን ደእያ ቃ ጎይኖ በሳ ኡባን እፃነ ጩይሳናዉ ይሁዳ ካዎት ሱንዳ ኤቃታ ካህነታ ኡባ ኦሶፐ ከስስ። ባኣለስ፥ አዋስ፥ አጌናስ፥ ፆልንቶታስነ ሳሎን ደእያ ሀራ መተታስ እፃነ ጩይሰይሳታ ኡባ ድግስ።<verse eid="2KI 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 23:6"/>አሼራ ፆሰ ምስልያ ፆሳ ኬፈ ከስድ፥ የሩሳላመ ካታማፐ ጋፃ ኤፍድ፥ ቀድሮና ዛንጋራ ኤፍድ፥ ያን ፁግስ። ፁገትዳይስ ጋጭድ፥ ለ ከስስ፤ ባና ደርያ ዱፎ ቦላ ላልስ።<verse eid="2KI 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 23:7"/>ፆሳ ኬ ግዶን ጎይኖ ዎጋ ኦድ፥ አደይ አደራ ላይማትያ ኬታ ላልስ፤ ሄ ኬታን ማጫሳት አሼራ ኤቄስ ገሸ ሱቆሶና።<verse eid="2KI 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 23:8"/>እዮስያስ ካህነታ ኡባ ይሁዳ ካታማታፐ ኤህድ፥ ካሰ ካህነት እፃነ ጩይስያ ቃ ጎይኖ በሳታ፥ ግብአፐ ብድ በርሳበ ጋካናዉ ደኤይሳታ ቱንስስ። ካታማ ሃርያ እያሱ ፐንግያፈ ሀድርሳ ባጋራ ደእያ ቃ ጎይኖ በሳካ ላልስ። <verse eid="2KI 23:8"/><verse number="9" style="v" sid="2KI 23:9"/>ቃ ጎይኖ በሳ ካህነት የሩሳላመን ጎዳ ያርሾ በሳ ፑደ ዮኮና፤ ሽን ኤንቲ ሀራ ካህነታራ እስፈ እርሾይ ገልቦና ዳቦ ሞሶና።<verse eid="2KI 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 23:10"/>ካዎይ እዮስያስ ሄኖማ ዛንጋራን ደእያ ቶፈታ ያርሾ በሳ ቱንስስ። ሞሎካ ፆሳስ እስ አስካ ባ አደ ናኣ ዎይካ ማጫ ናአ ታማ ግዶራ አና መላ ድግስ።<note caller="-" style="x"><char style="xo" closed="false">23:10 </char><char style="xt" closed="false"><ref loc="LEV 18:1">ሌወ 18:1</ref>፤ <ref loc="JER 7:31">ኤርም 7:31</ref>፤ <ref loc="JER 19:1-6">19:1-6</ref>፤ <ref loc="JER 32:35">32:35</ref>.</char></note><verse eid="2KI 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 23:11"/>ይሁዳ ካዎት ፆሳ ኬ ገልያ ፐንግያን አዋስ ዱማይድ ዎዳ ፓራታ ድግስ። አዋ ፓራት ናታን-መለካ ሀላቃ ክፍልያ ማታን ደእያ ዳባባን ደኦሶና። ሄሳፈ ጉየ፥ አዋስ ዱማይድ ዎዳ ፓራ ጋረታ እዮስያስ ታማን ፁግስ።<verse eid="2KI 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 23:12"/>አካዛ ኬ ፖቅያ ቦላ ይሁዳ ካዎት ጊግስዳ ያርሾ በሳታን ምናሰይ ፆሳ ኬን ደእያ ናምኡ ዳባባታ ግዶን ጊግስዳ ያርሾ በሳታ ካዎይ እዮስያስ ላልስ። ኤንታ ሄ በሳፈ ድግድ ትንቸረድ፥ ቀድሮና ዛንጋራን ሆልስ።<note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="2KI 21:5">2 ካዎ 21:5</ref>፤ <ref loc="2CH 33:5">2 ታር 33:5</ref>.</char></note><verse eid="2KI 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 23:13"/>ካዎይ የሩሳላመ ካታማፐ ዶሎሀ ባጋራ፥ ቱናተ ዙማፐ ዱገሀ ባጋን ደእያ ቃ ጎይኖ በሳታ ቱንስስ። ሄ ቃ በሳት እስራኤለ ካዎይ ሶሎሞነይ፥ ቱና ፆሳታ፥ ስዶና ፆሰ አስታሮቶ፥ ሞአበ ፆሳ ካሞሻነ አሞነ ፆሳ ሞሎካ ጎይናናዉ ጊግስዳ ቃ በሳታ። <verse eid="2KI 23:13"/><verse number="14" style="v" sid="2KI 23:14"/>ካዎይ እዮስያስ ጎይኖ ሹቻ ቱሳታካ መንረድ፥ አሼራ ፆሰ ምስለታካ ቃንፀረስ። ኤንቲ ኤቅዳ በሳን ሀይቅዳ አሳ መቀ ኩንስ።<verse eid="2KI 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 23:15"/>እስራኤለ አሳ፥ ናጋራ ኦስስዳ ናባፃ ናአይ እዮርባም ቤተለን ቃ በሳን ጊግስዳ ያርሾ በሳ ካዎይ እዮስያስ ላልስ። ላልድ ሄ ያርሾ በሳ ሹቻታካ መንረድ፥ ለ ከስስ፤ አሼር ምስልያካ ፁግስ። <verse eid="2KI 23:15"/><verse number="16" style="v" sid="2KI 23:16"/>ሄሳፈ ጉየ፥ እዮስያስ ዩሹዋ ፄልድ፥ ዙማ ላንቀን ደእያ ዱፎታ በእስ፤ መቀታ ዱፎታፐ ከስድ፥ ያርሾ በሳ ቦላ ዎድ፥ ታማን ፁግስ። ያትድ ያርሾ በሳ ቱንስስ። ሄስ ሀንዳይ ፆሳ አስ ካሰ አዋጅዳ ጎዳ ቃላ ማራና። <verse eid="2KI 23:16"/><verse number="17" style="v" sid="2KI 23:17"/>ሄሳፈ ጉየ ካዎይ፥ “ሀ በንተይስ ኦደ ዱፎ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="2KI 23:17">ቤተለ አሳይ፥ “ይሁዳፐ ይድ፥ ቤተለ ያርሾ በሳ ቦላ ሀእ ኔኒ ኦዳባይ ፖለታናይሳ ካሰትድ ኦድዳ ናብያ ዱፎ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">23:17 </char><char style="xt" closed="false"><ref loc="1KI 13:30-32">1 ካዎ 13:30-32</ref>.</char></note><verse eid="2KI 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 23:18"/>ካዎይ፥ “ደኦ ጊተ፤ ኦንካ እያ መቀ ሀይሳፈ ቃፎ” ያግስ። ሄሳ ግሾ፥ ሳማረፐ ይዳ ናበት አድያ መቀራ እስፈ እያ መቀ ቦቾና አጋግዶሶና።<verse eid="2KI 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 23:19"/>እስራኤለ ካዎት ሳማረ ካታማታን ኦስስድ፥ ጎዳ ሀንቀዳ፥ ቃ ጎይኖ በሳታ እዮስያስ ድግስ፤ ቤተለን ኦዳይሳዳ፥ ኤንታ ቦላካ ኦስ። <verse eid="2KI 23:19"/><verse number="20" style="v" sid="2KI 23:20"/>እ ጎይኖ ቃ በሳን ኦያ ካህነታ ኡባ ያርሾ በሳ ቦላ ዎስ፤ ቃስ ሄ ያርሾ በሳ ቦላ አሳ መቀ ፁግስ። ሄሳ ኡባ ኦድ፥ የሩሳላመ ስምስ።<verse eid="2KI 23:20"/></para>
  <para style="s1">እዮስያስ ፓስካ ባኣለ ቦንችስ</para>
  <para style="r">(<ref loc="2CH 35:1-19">2 ታር 35:1-19</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 23:21"/>ካዎይ አሳ ኡባ፥ “ሀ ጫቆ ማፃፋን ፃፈትዳይሳዳ ጎዳስ፥ ህንተ ፆሳስ ፓስካ ባኣለ ቦንችተ” ያግድ ኪትስ። <verse eid="2KI 23:21"/><verse number="22" style="v" sid="2KI 23:22"/>እስራኤለ ሃርያ ዳይናታ ዎደፐ ዶምድ፥ እስራኤለ ካዎታ ዎደነ ይሁዳ ካዎታ ዎደ ኡባን ሀይሳ መላ ፓስካ ባኣለ ኩመ ቦንቸት ኤረና። <verse eid="2KI 23:22"/><verse number="23" style="v" sid="2KI 23:23"/>ሽን ካዎይ እዮስያስ ካዎትዳ ታማነ ሆስፑን ላይን የሩሳላመ ካታማን ጎዳ ቦንቻናዉ ፓስካ ባለይ ቦንቸትስ።<verse eid="2KI 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 23:24"/>ካህነ ሀላቃይ ካልቅያስ ፆሳ ኬን በንትዳ ማፃፋን ፃፈትዳ ህግያ ቃላ ምንናዳ፥ ቱና አያና ፄገይሳታነ ማሮታ፥ ሶ ግዶ ኤቃ ምስለታ፥ ኤቃ ሚሸታነ ይሁዳ ቢታንነ የሩሳላመ ካታማን በንትዳ ሀራ እፀትዳባታ ኡባ እዮስያስ ይስስ። <verse eid="2KI 23:24"/><verse number="25" style="v" sid="2KI 23:25"/>ሙሰ ህግያዳ ባ ኩመ ዎዛናን፥ ባ ኩመ ሸምፑዋንነ፥ ባ ኩመ ዎልቃን ጎዳኮ ስምዳ እዮስያሳ መላ ካዎይ፥ እያፐ ካሰ ግድን፥ እያፐ ጉየ ደንድቤና።<verse eid="2KI 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 23:26"/>ምናሰይ ጎዳ ሀንቀናዉ ኦዳ ኢታ ኦሶ ኡባ ግሾ፥ ጎዳይ ይሁዳ ቦላ ሀንቀትዳ ባ ሸንያፐ ስምቤና። <verse eid="2KI 23:26"/><verse number="27" style="v" sid="2KI 23:27"/>ጎዳይ፥ “ታኒ እስራኤለ ታ ስንፈ ድግዳይሳዳ፥ ይሁዳካ ታ ስንፈ ድጋና፤ ታኒ ዶርዳ ካታማ፥ የሩሳላመነ ‘ታ ሱንይ ሀይሳን ዳና’ ግዳ ሀ ኬ ድጋና” ያግስ።<verse eid="2KI 23:27"/></para>
  <para style="s1">እዮስያሳ ካዎተ ዉርሰ</para>
  <para style="r">(<ref loc="2CH 35:20-36:1">2 ታር 35:20—36:1</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 23:28"/>እዮስያስ ሀንዳ ሀራባይነ እ ኦዳባይ ኡባይ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 23:28"/><verse number="29" style="v" sid="2KI 23:29"/>እዮስያሳ ዎደ ግብፀ ካዎይ ናኮይ፥ አሶረ ካዋ ኦላን ማዳናዉ ኤፍራፂሳ ሻፋ ብስ። ካዎይ እዮስያስ እያራ ኦለታናዉ ባ ኦላንቾታ ኤክድ ከይስ። ሽን ካዎይ ናኮይ እያራ ማግዶን ጋሄትድ፥ እያ ዎስ። <verse eid="2KI 23:29"/><verse number="30" style="v" sid="2KI 23:30"/>አይለት እያ አሀ ፓራ ጋረ ቦላ ዎድ፥ ማግዶፐ የሩሳላመ ኤህድ፥ እያ ቡዞ ዱፉዋን ሞግዶሶና። ሄ ቢታ አሳይ እዮስያሳ ናኣ እዮአካዛ ዶርድ፥ እያ አዋ በሳን እያ ትይድ ካዎዶሶና።<verse eid="2KI 23:30"/></para>
  <para style="s1">ይሁዳ ካዋ እዮአካዛ</para>
  <para style="r">(<ref loc="2CH 36:2-4">2 ታር 36:2-4</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 23:31"/>እዮአካዝ ካዎትያ ዎደ፥ ላይ እያዉ ላታማነ ሄ፤ እ የሩሳላመን ሄ አጌና ካዎትስ። እያ አየ ሱንይ ሀሙፃሎ፤ እያ ልብና ካታማ ደእያ ኤርምያሳ ናአ። <verse eid="2KI 23:31"/><verse number="32" style="v" sid="2KI 23:32"/>እያ ማይዛት ኦዳይሳዳ፥ እዮአካዝ ጎዳ ስንን ኢታባ ኦስ። <verse eid="2KI 23:32"/><verse number="33" style="v" sid="2KI 23:33"/>እዮአካዝ የሩሳላመን ካዎተናዳ ግብፀ ካዎይ ናኮይ ሀማታ ቢታን እርብላን እያ ቃችድ ሄ ሙኩሉነ ኦይዱ ፄቱ ክሎ ግራመ ዴፅያ ብራነ ሀስታማነ ኦይዱ ክሎ ግራመ ዴፅያ ዎርቃ ይሁዳ አሳ ጊርስስ። <verse eid="2KI 23:33"/><verse number="34" style="v" sid="2KI 23:34"/>ካዎይ ናኮይ እዮስያሳ ናኣ ኤልያቄመ እያ አዋ በሳን ካዎስ፤ እያ ሱን እዮአቄማ ያግድ ላምስ። ሽን እዮአካዛ ግብፀ ኤፍን፥ እ ያን ሀይቅስ።<note caller="-" style="x"><char style="xo" closed="false">23:34 </char><char style="xt" closed="false"><ref loc="JER 22:11-12">ኤርም 22:11-12</ref>.</char></note><verse eid="2KI 23:34"/></para>
  <para style="s1">ይሁዳ ካዋ እዮአቄማ</para>
  <para style="r">(<ref loc="2CH 36:5-8">2 ታር 36:5-8</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 23:35"/>እዮአቄም፥ ካዎይ ናኮይ ኦይችዳ ብራነ ዎርቃ ጊራ እያዉ እሚስ። ሄ ጊራ ቃንፃናዉ እዮአቄም ሄ ቢታ አሳይ ደምያ ኬና ብራፐነ ዎርቃፈ ጊራ ሺሽስ።<verse eid="2KI 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 23:36"/>እዮአቄም ካዎትያ ዎደ ላይ እያዉ ላታማነ እቻሻ፤ እ የሩሳላመን ታማነ እስ ላይ ካዎትስ። እያ አየ ሱንይ ዛብዶ፤ እያ ሩማ ካታማን ደእያ ፓዳያ ናአ።<note caller="-" style="x"><char style="xo" closed="false">23:36 </char><char style="xt" closed="false"><ref loc="JER 22:18-19">ኤርም 22:18-19</ref>፤ <ref loc="JER 26:1-6">26:1-6</ref>፤ <ref loc="JER 35:1-19">35:1-19</ref>.</char></note> <verse eid="2KI 23:36"/><verse number="37" style="v" sid="2KI 23:37"/>እዮአቄም ባ ማይዛት ኦዳይሳዳ፥ ጎዳ ስንን ኢታባ ኦስ።<verse eid="2KI 23:37"/></para>
  <chapter eid="2KI 23"/>
  <chapter number="24" style="c" sid="2KI 24"/>
  <para style="p">
    <verse number="1" style="v" sid="2KI 24:1"/>እዮአቄማ ዎደ ባብሎነ ካዎይ ናቡካዳናፆር ይሁዳ ቦላ ደንድስ። እዮአቄም እያዉ ሄ ላይ ሃረትዳፐ ጉየ፥ ናቡካዳናፆራ ቦላ ማካልስ።<note caller="-" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="JER 25:1-38">ኤርም 25:1-38</ref>፤ <ref loc="DAN 1:1-2">ዳነ 1:1-2</ref>.</char></note> <verse eid="2KI 24:1"/><verse number="2" style="v" sid="2KI 24:2"/>ጎዳይ ካልዳወታ ፓኖታ፥ ሶረ ፓኖታ፥ ሞአበ ፓኖታነ አሞነ ፓኖታ እዮአቄማ ቦላ የድስ፤ ባ አይለታ ናበታ ባጋራ ጎዳይ ካሰ ኦድዳይሳዳ፥ ይሁዳ ቢታ ይሳናዳ ሀይሳታ የድስ። <verse eid="2KI 24:2"/><verse number="3" style="v" sid="2KI 24:3"/>ካዎይ ምናሰይ ኦዳ ናጋራ ጋሶን ጎዳይ ይሁዳ አሳ ባ ስንፈ ድጋናዉ ሀ ዩዋ የድስ። <verse eid="2KI 24:3"/><verse number="4" style="v" sid="2KI 24:4"/>እ ፅሎ አሳ ሱ ጉስድ፥ የሩሳላመን ኩንዳ ግሾ፥ ጎዳይ ምናሰስ ሄ ናጋራ አቶ ጋናዉ ኮይቤና።<verse eid="2KI 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 24:5"/>እዮአቄም ሀንዳ ሀራባይነ እ ኦዳባ ኡባይ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ። <verse eid="2KI 24:5"/><verse number="6" style="v" sid="2KI 24:6"/>እዮአቄም ሀይቅድ፥ ባ ማይዛታ ጋክስ፤ እያ በሳን እያ ናአይ ዮአክን ካዎትስ። <verse eid="2KI 24:6"/><verse number="7" style="v" sid="2KI 24:7"/>ግብፀ ካዎይ ናምአን ባ ቢታፈ ደንድድ፥ ኦላስ ይቤና፤ ግብፀ ሻፋፐ ዶምድ፥ ብድ ኤፍራፂሳ ሻፋ ጋካናዉ፥ ግብፀ ካዎይ ሃርዳ ቢታ ኡባ ባብሎነ ካዎይ ኤክስ።<verse eid="2KI 24:7"/></para>
  <para style="s1">ይሁዳ ካዋ ዮአክና</para>
  <para style="r">(<ref loc="2CH 36:9-10">2 ታር 36:9-10</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 24:8"/>ዮአክን ካዎትያ ዎደ ላይ እያዉ ታማነ ሆስፑና፤ ዮአክን፥ የሩሳላመን ሄ አጌና ካዎትስ። እያ አየ ሱንይ ናስታ፤ እያ የሩሳላመ አድያ ኤልናታና ናአ። <verse eid="2KI 24:8"/><verse number="9" style="v" sid="2KI 24:9"/>ዮአክን ባ አዋይ ኦዳይሳዳ፥ ጎዳ ስንን ኢታባ ኦስ።<verse eid="2KI 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 24:10"/>ሄ ዎደ ባብሎነ ካዋ ናቡካዳናፆራ ኦላንቾት የሩሳላመ ይድ፥ ካታማ ተቅዶሶና። <verse eid="2KI 24:10"/><verse number="11" style="v" sid="2KI 24:11"/>ባብሎነ ካዎይ ናቡካዳናፆር ሄ ካታማ ይስ። <verse eid="2KI 24:11"/><verse number="12" style="v" sid="2KI 24:12"/>ይሁዳ ካዎይ እዮአክና፥ እያ አይያ፥ እያ አይለት፥ እያ ሀላቃትነ ካዎ ጋ ሹማት ኡባይ ባብሎነ ካዋስ ኩሸ እምዶሶና።<note caller="-" style="x"><char style="xo" closed="false">24:12 </char><char style="xt" closed="false"><ref loc="JER 22:24-30">ኤርም 22:24-30</ref>፤ <ref loc="JER 24:1-10">24:1-10</ref>፤ <ref loc="JER 29:1-2">29:1-2</ref>.</char></note></para>
  <para style="p" vid="2KI 24:12">ዮአክን ካዎትዳ ሆስፑን ላይን፥ ባብሎነ ካዎይ ዮአክና ቃችስ። <verse eid="2KI 24:12"/><verse number="13" style="v" sid="2KI 24:13"/>ፆሳ ኬነ ካዎ ጋን ደእያ ሻሉዋ ኡባ ሄ በሳፈ ደንድ ኤፍስ። ጎዳይ ካሰ ኦድዳይሳዳ ካዎይ ሶሎሞነይ ፆሳ ኬን ጊግስዳ ዎርቃ ሚሸታ ኡባ ባብሎነ ካዎይ ቃንፀረስ። <verse eid="2KI 24:13"/><verse number="14" style="v" sid="2KI 24:14"/>ናቡካዳናፆር የሩሳላመ አሳ፥ ሀላቃታ ኡባ፥ ኦላንቾታ ኡባ፥ ኩሸ ሂላንቾታነ ብራታ ቆፀይሳታ ኡባ፥ 10,000 አሳ የሩሳላመፐ ድእድ ኤፍን፥ ቢታን ማንቆ አሳ ፃላል አትስ።<verse eid="2KI 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 24:15"/>ናቡካዳናፆር እዮአክና ድእድ፥ እያ አይዉ፥ እያ ማቸታ፥ እያ ሞርናትነ ቢታን ደእያ ግታ አሳ ኡባ ባብሎነ ኤፍስ።<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="EZK 17:12">ህዝ 17:12</ref>.</char></note> <verse eid="2KI 24:15"/><verse number="16" style="v" sid="2KI 24:16"/>ሄ አሳፐ 7,000 አሳት ኦላንቾታ፤ 1,000 አሳት ዱማ ዱማ ኩሸ ሂላንቾታ፤ ኤንቲ ኡባይ ምኖነ ኦላ ኦለታናዉ ዳንዳኤይሳታ። <verse eid="2KI 24:16"/><verse number="17" style="v" sid="2KI 24:17"/>ሄሳፈ ጉየ፥ ባብሎነ ካዎይ ዮአክና በሳን እያ አዋ እሻ ማታና ካዎስ፤ እያ ሱን ሰደቅያሳ ያግድ ላምስ።<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="JER 37:1">ኤርም 37:1</ref>፤ <ref loc="EZK 17:13">ህዝ 17:13</ref>.</char></note><verse eid="2KI 24:17"/></para>
  <para style="s1">ይሁዳ ካዋ ሰደቅያሳ</para>
  <para style="r">(<ref loc="2CH 36:11-12">2 ታር 36:11-12</ref>፤ <ref loc="JER 52:1-3">ኤርም 52:1-3</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 24:18"/>ሰደቅያስ ካዎትያ ዎደ፥ ላይ እያዉ ላታማነ እስኖ፤ እ ታማነ እስ ላይ የሩሳላመን ካዎትስ። እያ አየ ሱንይ አምፃሎ፤ እያ ልባና ካታማን ደእያ ኤርምያሳ ናአ።<note caller="-" style="x"><char style="xo" closed="false">24:18 </char><char style="xt" closed="false"><ref loc="JER 27:1-22">ኤርም 27:1-22</ref>፤ <ref loc="JER 28:1-17">28:1-17</ref>.</char></note> <verse eid="2KI 24:18"/><verse number="19" style="v" sid="2KI 24:19"/>እዮአቄም ኦዳይሳዳ፥ ሰደቅያስ ጎዳ ስንን ኢታባ ኦስ። <verse eid="2KI 24:19"/><verse number="20" style="v" sid="2KI 24:20"/>ጎዳይ ሀንቀትዳ ግሾ፥ የሩሳላመ አሳ ቦላነ ይሁዳ አሳ ቦላ ሀይስ ሀንስ፤ ዉርሰን ኤንታ እ ባ ስንፈ ድግስ።</para>
  <para style="p" vid="2KI 24:20">ሰደቅያስ ባብሎነ ካዋ ቦላ ማካልስ።<note caller="-" style="x"><char style="xo" closed="false">24:20 </char><char style="xt" closed="false"><ref loc="EZK 17:15">ህዝ 17:15</ref>.</char></note><verse eid="2KI 24:20"/></para>
  <chapter eid="2KI 24"/>
  <chapter number="25" style="c" sid="2KI 25"/>
  <para style="p">
    <verse number="1" style="v" sid="2KI 25:1"/>ሰደቅያስ ካዎትዳ ኡዱፉን ላይ፥ ታማን አጌናን፥ ታማን ጋላስ፥ ባብሎነ ካዎይ ናቡካዳናፆር ባ ኦላንቾታ ኡባ ኤክድ፥ የሩሳላመ ተቅስ፤ እያ ዩሹዋን ቢታ ዶርድ ተቅስ።<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="JER 21:1-10">ኤርም 21:1-10</ref>፤ <ref loc="JER 34:1-5">34:1-5</ref>፤ <ref loc="EZK 24:2">ህዝ 24:2</ref>.</char></note> <verse eid="2KI 25:1"/><verse number="2" style="v" sid="2KI 25:2"/>ሰደቅያስ ካዎትዳ ታማነ እስን ላይ ጋካናዉ፥ ካታማይ ተቀትድ ጋምእስ።<verse eid="2KI 25:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 25:3"/>ሄሳ ጋሶን ቢታን ኮሽ ሱልን፥ ሄ ላይ ኦይዳን አጌናን፥ ኡዱፉን ጋላሳን አሳስ ምያባይ ይስ። <verse eid="2KI 25:3"/><verse number="4" style="v" sid="2KI 25:4"/>ካታማ ዩሾ ግምበይ እስ ባጋራ መቅን፥ ካልዳወት ዩይ አድ ናግኮካ፥ ይሁዳ ካዋ ኦላንቾት ኩመ ቃማ ካዎ ጋደ ኤፍያ ኦግያ ኦይክድ፥ ናምኡ ድርሳ ግምበት ጋሄትያ ፐንግያራ ከይድ ባቃትዶሶና። ኤንቲ ዮርዳኖሰ ድልባኮ ስሚድ ባቃትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">25:4 </char><char style="xt" closed="false"><ref loc="EZK 33:21">ህዝ 33:21</ref>.</char></note> <verse eid="2KI 25:4"/><verse number="5" style="v" sid="2KI 25:5"/>ሽን ባብሎነ ኦላንቾት ካዋ የደድ፥ እያርኮ ደምባ ጋሸ ኦይክዶሶና። እያ ኦላንቾት ኡባይ እያፐ ሻከትድ ላለትዶሶና። <verse eid="2KI 25:5"/><verse number="6" style="v" sid="2KI 25:6"/>ሄሳፈ ጉየ፥ ኤንቲ እያ ራብላ ካታማን ደእያ ናቡካዳናፆራኮ ኤፍዶሶና። ባብሎነ ካዎይ ሰደቅያሳ ቦላ ፕርድስ። <verse eid="2KI 25:6"/><verse number="7" style="v" sid="2KI 25:7"/>ሰደቅያሳ ናይታ፥ ሰደቅያስ ፄልሽን ዎዶሶና። እያ አይፈታ ዎጭ ከስድ፥ ሳንላታን ቃችድ፥ ባብሎነ ቢታ ኤፍዶሶና።<note caller="-" style="x"><char style="xo" closed="false">25:7 </char><char style="xt" closed="false"><ref loc="EZK 12:13">ህዝ 12:13</ref>.</char></note><verse eid="2KI 25:7"/></para>
  <para style="s1">ፆሳ ኬ ላለተ</para>
  <para style="r">(<ref loc="JER 52:12-33">ኤርም 52:12-33</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 25:8"/>ናቡካዳናፆር ባብሎነን ካዎትዳ ታማነ ኡዱፉን ላይን፥ እቻሻን አጌናን፥ ላፑን ጋላሳን፥ ካዋ ሞርናታፐ እሶይ፥ ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን የሩሳላመ ገልስ። <verse eid="2KI 25:8"/><verse number="9" style="v" sid="2KI 25:9"/>ፆሳ ኬ፥ ካዎ ጋነ የሩሳላመን ደእያ ኬ ኡባ፥ ግታ ኬ ጌተትያ ኡባ ፁግስ። <verse eid="2KI 25:9"/><verse number="10" style="v" sid="2KI 25:10"/>ባብሎነ ኦላንቾት ኡባይ ካዋ ናገይሳታ ሀላቃ ኪታን የሩሳላመ ካታማ ዩሹዋን ደእያ ድርሳ ግምብያ ኡባ ላልዶሶና። <verse eid="2KI 25:10"/><verse number="11" style="v" sid="2KI 25:11"/>ናቡዛርዳን ካታማንነ ይሁዳን አትዳ አሳታ፥ ካድድ ባብሎነ ኦላንቾታን ጋሄትዳ አሳታ ኡባ ኦይክድ፥ ድእድ ኤፍስ። <verse eid="2KI 25:11"/><verse number="12" style="v" sid="2KI 25:12"/>ሽን ናቡዛርዳን ዉርሰ ማንቆታፐ ጉታ ዎይነ ቶካናዳነ ጋደ ጎያናዳ ይሁዳን አሽስ።<verse eid="2KI 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 25:13"/>ባብሎነ አሳት ፆሳ ኬን ደእያ ናሰ ብራታፐ መዳ ቱሳታ፥ ጫና ጋረታነ ግታ ከረታ መንረዶሶና፤ ናሰ ብራታ ኡባ ባብሎነ ኤፍዶሶና።<note caller="-" style="x"><char style="xo" closed="false">25:13 </char><char style="xt" closed="false"><ref loc="1KI 7:15-26">1 ካዎ 7:15-26</ref>፤ <ref loc="2CH 3:15-17">2 ታር 3:15-17</ref>.</char></note> <verse eid="2KI 25:13"/><verse number="14" style="v" sid="2KI 25:14"/>ከረታ፥ አካፋታ፥ ፆምፐ ፄራ ፕትያባታ፥ ጭልፓታነ ያርሾ ዎደ ጎኤትያ ናሰ ብራታ ሚሸታ ኡባ ኤፍዶሶና።<note caller="-" style="x"><char style="xo" closed="false">25:14 </char><char style="xt" closed="false"><ref loc="1KI 7:45">1 ካዎ 7:45</ref>፤ <ref loc="2CH 4:16">2 ታር 4:16</ref>.</char></note> <verse eid="2KI 25:14"/><verse number="15" style="v" sid="2KI 25:15"/>ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን ዎርቃፈ ኦሰትዳ ሚሸታ ዎርቃ፥ ብራፐ ኦሰትዳ ሚሸታ ብራ ኦ ኤክድ፥ እፃነ ጩይስያ ሻተታነ ፃሮታ ኡባ ኤፍስ። <verse eid="2KI 25:15"/><verse number="16" style="v" sid="2KI 25:16"/>ካዎይ ሶሎሞነይ ፆሳ ኬ ኦሶስ ጊግስዳ ናምኡ ቱሳታ፥ ግታ ከረታነ ጫና ጋረታ፥ ናሰ ብራታ ምዛነን ልካናዉ ዳንዳኤትቤና። <verse eid="2KI 25:16"/><verse number="17" style="v" sid="2KI 25:17"/>ናምኡ ቱሳት እስ መላ ግድድ፥ እሱዋ እሱዋ ጌሳይ ታማነ ሆስፑን ዋ፤ ቃስ እስ እስ ቱሳ ሁጰን ደእያ ጉምቦት ሄ ዋ አዱሰ። ሄ ጉምቦታ ዩሾይ ናሰ ብራታ ግተንነ ኦሮማነ ቴራ ምስለን አሌቀትስ።<verse eid="2KI 25:17"/></para>
  <para style="s1">ይሁዳ አሳ ድኤተ</para>
  <para style="r">(<ref loc="JER 52:24-27">ኤርም 52:24-27</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 25:18"/>ካዋ ናገይሳታ ሀላቃይ ናቡዛርዳን፥ ካህነ ሀላቃ ሳራያ፥ እያ ካልያ ካህንያ ሶፎንያሳነ ፐንገ ናግያ ሀራ ሄ አሳታ ኦይክስ። <verse eid="2KI 25:18"/><verse number="19" style="v" sid="2KI 25:19"/>ሄ ዎደይ ጋካናዉ፥ ካታማን ደእያ አሳፐ ይሁዳ ቶራ ሞጮና፥ ካዋ ዞረይሳታፐ እቻሹ አሳታ፥ ቶራ ሞጮናታ ፃፍያ፥ ኦላንቾታ ዶርያ ሀራ ኡሱፑን ታሙ አሳታ ኤፍስ። <verse eid="2KI 25:19"/><verse number="20" style="v" sid="2KI 25:20"/>ሀላቃይ ናቡዛርዳን ኤንታ ኡባ፥ ባብሎነ ካዋኮ ራብላ ካታማ ኤፍስ። <verse eid="2KI 25:20"/><verse number="21" style="v" sid="2KI 25:21"/>ባብሎነ ካዎይ ኤንታ ኡባ ሀማታ ቢታን ራብላ ካታማን ዎስ። ሄሳዳ ሀንድ፥ ይሁዳ አሳይ ባንታ ቢታፈ ድኤትድ ብዶሶና።<verse eid="2KI 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 25:22"/>ካዎይ ናቡካዳናፆር ሳፋና ናኣ ናኣ፥ አክቃማ ናኣ ጎዶልያ ይሁዳን አትዳ አሳ ቦላ ሹምስ። <verse eid="2KI 25:22"/><verse number="23" style="v" sid="2KI 25:23"/>ኩሸ እምቦና ይሁዳ ቶራ ሞጮናትነ ኦላንቾት ሄሳ ስእዳ ዎደ፥ ምፅጳን ደእያ ጎዶልያራ ጋሄትዶሶና። ሄ ሀላቃት ናታና ናኣ እስማኤላ፥ ቃረያ ናኣ ዮሃና፥ ናፆፋ አድያ ታንሁመታ ናኣ ሳራያነ ማካታ አድያ ያዛና ናኣ። <verse eid="2KI 25:23"/><verse number="24" style="v" sid="2KI 25:24"/>ጎዶልያ ኤንታዉነ ኤንታ ኦላንቾታስ “ሀይሳታስነ ኤንታ ሀላቃታስ ያዮፍተ። ሀ ቢታን ደእተ፤ ባብሎነ ካዋስ ሃረትተ፤ ሄሳ ህንተ ኦኮ ኡባባይ ህንተዉ እንጀታና” ያግድ ኤንታዉ ጫቅስ።<verse eid="2KI 25:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 25:25"/>ሽን ላፑን አጌናን፥ ካዎ ኮች ግድዳ ኤልሳማ ናኣ ናታና ናአይ እስማኤል ታሙ አሳራ ምፅጳ ብድ፥ ጎዶልያ፥ ይሁዳ አሳነ እያራ ደእያ ባብሎነ አሳ ኡባ ዎስ። <verse eid="2KI 25:25"/><verse number="26" style="v" sid="2KI 25:26"/>ሄሳፈ ጉየ፥ ባብሎነ አሳስ ያይድ፥ ይሁዳ አሳይ፥ ጉ ግት አቶናሽን፥ ቶራ ሞጮናት ኡባይ ግብፀ ቢታ ባቃትዶሶና።<verse eid="2KI 25:26"/></para>
  <para style="s1">ዮአክን ቃሾፐ ብለተ</para>
  <para style="r">(<ref loc="JER 52:31-34">ኤርም 52:31-34</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 25:27"/>ዮአክን ድኤትድ ብዳ ሀስታማነ ላፑን ላይን፥ ታማነ ናምአን አጌናን፥ ላታማነ ላፑን ጋላሳን፥ ዮር-ማሮዳክ<note caller="+" style="f"><char style="fr" closed="false">25:27 </char><char style="fq" closed="false">ዮር-ማሮዳካ፦ </char><char style="ft" closed="false">ሀራ ሱንይ አመል-ማሮዳካ ጌተቴስ።</char></note> ካዎትዳ ላይ፥ ይሁዳ ካዋ ዮአክና ማርድ ቃሾፐ ብልስ። <verse eid="2KI 25:27"/><verse number="28" style="v" sid="2KI 25:28"/>ዮር-ማሮዳክ፥ ዮአክናራ ሎኦ ቃላ ኦደትድ፥ ባብሎነን ድኦን ደእያ ሀራ ካዎታ ኡባፈ አድ፥ እያ ቦንችስ። <verse eid="2KI 25:28"/><verse number="29" style="v" sid="2KI 25:29"/>ሄሳ ግሾ፥ ዮአክን ቃሾ ኬን ማእዳ ማኡዋ ላምድ፥ አትዳ ባ ደኦ ላይ ኡባን ካዎ ጋይታፐ ምስ። <verse eid="2KI 25:29"/><verse number="30" style="v" sid="2KI 25:30"/>ጋላስ ጋላስ እያዉ ኮሽያባ ኡባ ባብሎነ ካዎይ እሚስ።<verse eid="2KI 25:30"/></para>
  <chapter eid="2KI 25"/>
</usx>
