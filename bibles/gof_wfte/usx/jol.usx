<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">እዩኤላ ማፃፋ</para>
  <para style="toc1">እዩኤላ ማፃፋ</para>
  <para style="toc3">እዩ</para>
  <para style="toc2">እዩኤላ</para>
  <para style="mt">እዩኤላ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ናብያ እዩኤላ ቆንጨይ ሴራፐ ፆሳኮ ስሞባነ ማሮተ ደምድ፥ ፆሳን ኦራፆባ ኦዴስ። ናበይ እዩኤል ዳሮ ቦለይ ሻር ሳሎ ካምዳ መላ ኩምድ የይሳነ ቢታ ኡባ ምድ ይሰይሳ በእስ። እዩኤል ቱማ ኦላንቾት ይድ እስራኤለ ካዎተ ኦልድ ይሳናይሳ በእስ። ግዶሽን፥ አሳይ ፆሳኮ ስምኮ፥ እ ኤንታ ማራናዉነ ዛሪድ አንጃናዉ ቃላ ገልስ።</para>
  <para style="ip">ቢታይ ፁገትዳ ግሾ ካህነት አዛኖሶና፤ ሀር አቶሽን ቢታይ ባ ሁጰን ዬኬስ። ጎዳ ፕርዳ ጋላስ ማትዳይሳ እዩኤል በእስ። ሽን፥ ሀእካ አሳይ ባንታ ኢታ ኦግያፐ ጎዳኮ ስምኮ፥ ጎዳይ ኤንታ ዛሪድ አንጃናይሳ እዩኤል ኦድስ።</para>
  <para style="ip">እዩኤል ሀናና ግድ ኦድዳባፐ ቆንጭድ በንተይ ኡፋይሳ ቃላ። ፆሳይ ባ አደ ናይታ ቦላነ ባ ማጫ ናይታ ቦላ፥ ያላጋታ ቦላነ ጭማታ ቦላ፥ ባ አሳ ኡባ ቦላ ባ አያና ጉሳናዉ ቃላ ገልስ (2:28-32)። ሀ ኡፋይሳ ቃላይ ሀዋረታ ኦሶ ማፃፋን፥ ጳንፀቆስፀ ጋላስ፥ ቱማ ግድዳይሳ ጰፅሮስ ኦድስ (2:16-21)።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ቦለ ጋዶ (<char style="ior"><ref loc="JOL 1:1-2:17">1:1—2:17</ref></char>)</para>
  <para style="io1">ፆሳይ ባ አሳ ዛሪድ አንጃና (<char style="ior"><ref loc="JOL 2:18-27">2:18-27</ref></char>)</para>
  <para style="io1">ፆሳይ ካዎተታ ፕርዳና (<char style="ior"><ref loc="JOL 2:28-3:15">2:28—3:15</ref></char>)</para>
  <para style="io1">ፆሳይ ባ አሳ ዛሪድ አንጃና (<char style="ior"><ref loc="JOL 3:16-21">3:16-21</ref></char>)</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="s1">ቦለ ጋዶ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>ባቱኤላ ናኣ እዩኤላኮ ጎዳይ ኪትዳ ቃላይ ሀይሳ። <verse eid="JOL 1:1"/><verse number="2" style="v" sid="JOL 1:2"/>ህንተኖ ጭማቶ፥ ሀይሳ ስእተ! ይሁዳ ቢታን ደእያ አሳ ኡባይ ስእተ! ሀይሳ መላባይ ህንተ ዎደ ዎይኮ ህንተ አዋታ ዎደ ሀን ኤሪ?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>ሀይሳ ህንተ ናይታስ ኦድተ፤</para>
  <para style="q2" vid="JOL 1:3">ህንተ ናይት ባንታ ናይታስ ኦዶ፤</para>
  <para style="q2" vid="JOL 1:3">ኤንታ ናይት ካልያ የለታስ ኦዶ።<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>ጎንዶፈ አትዳ ካ ቦለይ ምስ፤</para>
  <para style="q2" vid="JOL 1:4">ቦለፐ አትዳ ካ ጉዶይ ምስ፤</para>
  <para style="q2" vid="JOL 1:4">ጉዶፈ አትዳ ካ ፃቆይ ምስ።<verse eid="JOL 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>ማልእያ ዎይነይ ህንተፈ አትዳ ግሾ፥</para>
  <para style="q2" vid="JOL 1:5">ህንተኖ፥ ማተይሳቶ ባርክተ ዬክተ!</para>
  <para style="q2" vid="JOL 1:5">ህንተኖ፥ ዎይነ ኡያ ኡባት ዘሌልተ!<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>ታይቦይ ባይና ቦለይ ታ ቢታ ኦይክስ፤</para>
  <para style="q2" vid="JOL 1:6">ኤንታ አቻይ ጋሞ አቻ መላ፤</para>
  <para style="q2" vid="JOL 1:6">ኤንታ ጋጮይ ማጫ ጋሞ ጋጮ መላ።<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>ኤንቲ ታ ዎይንያ ይስዶሶና፤</para>
  <para style="q2" vid="JOL 1:7">ታ ባላስያ ም ግዶሶና።</para>
  <para style="q1" vid="JOL 1:7">ኤንቲ ፖቅድ ምዳ ግሾ፥</para>
  <para style="q2" vid="JOL 1:7">ዎይንያነ ባላስያ ታሸት ፑፁ ግስ።<verse eid="JOL 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>ጌላእያ፥ ባ ጊግዳ አዝናይ ሀይቅን፥</para>
  <para style="q2" vid="JOL 1:8">ካዮ ማኦ ማአዳ ዬከይሳዳ ህንተካ ዬክተ!<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>ካ ያርሾይነ ኡሻ ያርሾይ</para>
  <para style="q2" vid="JOL 1:9">ጎዳ ኬን ይዳ ግሾ፥</para>
  <para style="q2" vid="JOL 1:9">ጎዳ ኬን ኦያ ካህነት ዬኮሶና።<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>ጎሻይ መላ አትስ፤ ቢታይ ዬኬስ፤</para>
  <para style="q2" vid="JOL 1:10">ካይ ይስ፤ ዎይነይነ ዛይተይ መልስ።<verse eid="JOL 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>ጋደን ደእያ ግስተይነ ባንግ ይዳ ግሾ፥</para>
  <para style="q2" vid="JOL 1:11">ህንተኖ ጎሻንቾቶ፥ ካዮትተ፤</para>
  <para style="q2" vid="JOL 1:11">ህንተኖ ዎይነ ቶከይሳቶ፥ ዘሌልተ!<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>ዎይነይ መልስ፤ ባላሰይ ሹልስ፤</para>
  <para style="q2" vid="JOL 1:12">ኦሮማነይ፥ ተምረይ፥ አፕለይ፥</para>
  <para style="q2" vid="JOL 1:12">ጋደን ደእያ ሀራ ም ኡባይ መልስ፤</para>
  <para style="q2" vid="JOL 1:12">ሄሳ ግሾ፥ አሳፐ ኡፋይስ ሃክስ።<verse eid="JOL 1:12"/></para>
  <para style="s1">ማሮታኮ ፄስ</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>ህንተኖ ካህነቶ፥ ካዮ ማኦ ማእድ ዬክተ፤</para>
  <para style="q2" vid="JOL 1:13">ህንተኖ ያርሾ በሳ ስንን ኦይሳቶ፥ ዘሌልተ።</para>
  <para style="q1" vid="JOL 1:13">ህንተኖ ታ ፆሳ ስንን ኦይሳቶ፥</para>
  <para style="q2" vid="JOL 1:13">ፆሳ ኬ ገልድ ካዮ ማኦ ማእድ አቅተ።</para>
  <para style="q1" vid="JOL 1:13">ካ ያርሾይነ ኡሻ ያርሾይ፥</para>
  <para style="q2" vid="JOL 1:13">ፆሳ ኬን ያርሽያባይ ባዋ።<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>ፆማ አዋጅተ፤</para>
  <para style="q2" vid="JOL 1:14">ጌሻ ሺቆ ፄግተ።</para>
  <para style="q1" vid="JOL 1:14">ጭማታነ ቢታን ደእያ አሳ ኡባ</para>
  <para style="q2" vid="JOL 1:14">ጎዳ ህንተ ፆሳ ኬን ሺሽተ፤</para>
  <para style="q2" vid="JOL 1:14">ያን ጎዳኮ ዋስተ።<verse eid="JOL 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>ጎዳ ጋላሳይ ማትስ፤</para>
  <para style="q2" vid="JOL 1:15">ሄ ጋላሳ አየ!</para>
  <para style="q1" vid="JOL 1:15">ሄ ጋላሳይ ኡባ ዳንዳእያ ፆሳ</para>
  <para style="q2" vid="JOL 1:15">ሀንቆ ጋላስ ግድድ ዬስ።<verse eid="JOL 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>ኑ ስንፈ ካ፥</para>
  <para style="q2" vid="JOL 1:16">ኑ ፆሳ ኬፈ፥</para>
  <para style="q2" vid="JOL 1:16">ኡፋይስነ እልልስ ይስ ግደኔ?<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>ዘረትዳ ዘረይ ቢታ ግዶን ቡቅስ፤</para>
  <para style="q2" vid="JOL 1:17">ካይ ይዳ ግሾ ኤለይ ካሎትስ፤</para>
  <para style="q2" vid="JOL 1:17">ሻለይ ላለትስ።<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>ሄምያ በሲ ባይና ግሾ፥</para>
  <para style="q2" vid="JOL 1:18">መሄይ ዋሴስ።</para>
  <para style="q2" vid="JOL 1:18">ሀር አቶሽን ዶርሳ ዉደይካ</para>
  <para style="q2" vid="JOL 1:18">ማታ ይድ ኡንኤቴስ።<verse eid="JOL 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>አቤት ጎዳዉ፥ ባዙዋ ታም ምዳ ግሾ፥</para>
  <para style="q2" vid="JOL 1:19">ፃራግ ደንባን ደእያ ማታ ፁግዳ ግሾ፥</para>
  <para style="q2" vid="JOL 1:19">ዎራ ም ታማ ላጮይ ይስዳ ግሾ፥</para>
  <para style="q2" vid="JOL 1:19">ታኒ ኔኮ ዋሳይስ።<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>ጎግያ ሃ መልዳ ግሾ፥</para>
  <para style="q2" vid="JOL 1:20">ታም ባዞን ደእያ ማታ ምድግዳ ግሾ፥</para>
  <para style="q2" vid="JOL 1:20">ባዞ ዶአትካ ኔኮ ዋሶሶና።<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">ቦለይ ኦላንቾዳ ያና</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>ፅዮነን ሞይዘ ፑንተ፤</para>
  <para style="q2" vid="JOL 2:1">ታ ጌሻ ዙማ ቦላ ዋስተ።</para>
  <para style="q1" vid="JOL 2:1">ቢታን ደእያ አስ ኡባይ ኮኮሮ፤</para>
  <para style="q2" vid="JOL 2:1">ጎዳ ጋላሳይ ዬስ፤ ካረን ደኤስ።<verse eid="JOL 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2"/>ሄ ጋላሳይ ማነ ጫጋና ጋላስ፤</para>
  <para style="q2" vid="JOL 2:2">ሻራነ ሳካና ማ ጋላስ!</para>
  <para style="q1" vid="JOL 2:2">ዙማ ቦላ ፃልቀይ ጫረይሳዳ</para>
  <para style="q2" vid="JOL 2:2">ዳሮነ ዎልቃማ ቦለይ ቢታ ማአና።</para>
  <para style="q1" vid="JOL 2:2">ሄሳ መላባይ ካሰ ሀንቤና፥</para>
  <para style="q2" vid="JOL 2:2">ስንፈካ ሄሳ መላባይ ሀነና።<verse eid="JOL 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>ኤንታፈ ስንራ ምያ ታም ቤስ፤</para>
  <para style="q2" vid="JOL 2:3">ኤንታፈ ጉየራ ላጮይ ፁጌስ።</para>
  <para style="q1" vid="JOL 2:3">ኤንታ ስንይ ጋናተ መላ፤</para>
  <para style="q2" vid="JOL 2:3">ሽን ኤንታ ጉየይ ቦድላ ባዞ መላ፤</para>
  <para style="q2" vid="JOL 2:3">ኤንታፈ አይብካ ከስ ኤከና።<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>ኤንታ መይ ፓራ መ መላ፤</para>
  <para style="q2" vid="JOL 2:4">ኤንቲ ኦላ ፓራዳ አዳርሶሶና።<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>ፓር ጎችያ ጋረዳ ጊሮሶና፤</para>
  <para style="q2" vid="JOL 2:5">ደርያ ሁጰራ ጉፖሶና።</para>
  <para style="q1" vid="JOL 2:5">ቡርያ ምያ ታማ ላጮዳ ፁጎሶና፤</para>
  <para style="q2" vid="JOL 2:5">ኦላ ባናዉ ከይዳ ዎልቃማ ኦላንቾ ዳኖሶና።<verse eid="JOL 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>ኤንታ ስንን አስ ኮኮሬስ፤</para>
  <para style="q2" vid="JOL 2:6">ያሻን አሳ ሶምኦይ ካሬፄስ።<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>ኤንቲ ኦላንቾዳ ዎፆሶና፤</para>
  <para style="q2" vid="JOL 2:7">ቶራ አሳዳ ድርሳ ቦላራ ጉፖሶና።</para>
  <para style="q1" vid="JOL 2:7">ኤንቲ ኡባይ ማራን ቦሶና፤</para>
  <para style="q2" vid="JOL 2:7">ባንታ ሳልፕያፈ ጋፃ ከዮኮና።<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>እሶይ እሱዋራ ሱገቶኮና፤</para>
  <para style="q2" vid="JOL 2:8">ኡባይ ቅንፅ ግድ ስን ቦሶና።</para>
  <para style="q1" vid="JOL 2:8">ኤንቲ ባንታራ ኤቀተይሳታ መንድ ቦሶና፤</para>
  <para style="q2" vid="JOL 2:8">ኤንታ ተቅያባይ ባዋ።<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>ኤንቲ ካታማ ኦይኮሶና፤</para>
  <para style="q2" vid="JOL 2:9">ድርሳ ግምብያ ቦላራ ዎፆሶና።</para>
  <para style="q1" vid="JOL 2:9">ኤንቲ ኬ ቦላ ከዮሶና፤</para>
  <para style="q2" vid="JOL 2:9">ካይሶዳ ማስኮተራ ገሎሶና።<verse eid="JOL 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>ኤንታ ስንን ቢት ቃፄስ፤</para>
  <para style="q2" vid="JOL 2:10">ሳሎት ኮኮሮሶና።</para>
  <para style="q1" vid="JOL 2:10">አውነ አጌን ሜስ፤</para>
  <para style="q2" vid="JOL 2:10">ፆልንቶት ባንታ ፖኡዋ ድጎሶና።<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>ጎዳይ ባ ኦላንቾታ ስንን ጉሜስ፤</para>
  <para style="q2" vid="JOL 2:11">እያዉ ኪተትያ ኦላንቾት ታይቦፐ ቦላ።</para>
  <para style="q1" vid="JOL 2:11">ጎዳ ጋላሳይ ግታነ ዳሮ ያሼስ፤</para>
  <para style="q2" vid="JOL 2:11">ሄ ጋላሳ ዳንዳአናይ ኦኔ?<verse eid="JOL 2:11"/></para>
  <para style="s1">ህንተ ዎዛና ፔተ</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>“ሀእካ ፆማን፥ ዬሆንነ አዛኖን</para>
  <para style="q2" vid="JOL 2:12">ህንተ ፖሎ ዎዛናፐ ታኮ ስምተ።”<verse eid="JOL 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>ህንተ ዎዛናፐ አትሽን፥</para>
  <para style="q2" vid="JOL 2:13">ህንተ ማኡዋ ፔፕተ።</para>
  <para style="q1" vid="JOL 2:13">ጎዳ፥ ህንተ ፆሳኮ፥ ስምተ፤</para>
  <para style="q2" vid="JOL 2:13">እ፥ ቃይነ ማሮት ኩምዳይሳ፤</para>
  <para style="q1" vid="JOL 2:13">እ፥ ሀንቃናዉ ኤለሶናይሳነ ሲቆይ ዳርዳይሳ፤</para>
  <para style="q2" vid="JOL 2:13">እ፥ ህንተና ሴራናዉ ኤለሰና።<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>ጎዳይ ህንተ ፆሳይ፥</para>
  <para style="q2" vid="JOL 2:14">ባ ሀንቁዋፈ ስሚድ</para>
  <para style="q2" vid="JOL 2:14">ህንተና አንጃነኮ ኦን ኤሪ?</para>
  <para style="q1" vid="JOL 2:14">ሄ ዎደ ጎዳስ ህንተ ፆሳስ፥</para>
  <para style="q2" vid="JOL 2:14">ካ ያርሾነ ኡሻ ያርሾ ያርሻና።<verse eid="JOL 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>ፅዮነን ሞይዘ ፑንተ፤</para>
  <para style="q2" vid="JOL 2:15">ፆማ አዋጅተ፤</para>
  <para style="q2" vid="JOL 2:15">ጌሻ ሺቁዋ ሺቅተ!<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>አሳ ሺሽድ፥ ህንተ ሺቁዋ ጌሽተ፤</para>
  <para style="q2" vid="JOL 2:16">ጭማታ እስፈ ሺሽተ፤</para>
  <para style="q2" vid="JOL 2:16">ጉ ናይታነ መይሳታ አሾፍተ።</para>
  <para style="q1" vid="JOL 2:16">መዳን ደኤይሳት</para>
  <para style="q2" vid="JOL 2:16">ባንታ ቁሩፁዋፐ ከዮ።<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>ጎዳስ ኦያ ካህነት ፆሳ ኬ</para>
  <para style="q2" vid="JOL 2:17">ባራንዳፈነ ያርሾ በሳፈ ግዶን ኤቅድ ዬኮ።</para>
  <para style="q1" vid="JOL 2:17">ኤንቲ ሀይሳዳ ያግድ ዎሶ፤</para>
  <para style="q2" vid="JOL 2:17">“አቤት ጎዳዉ፥ ነ አሳስ ቃታ፤</para>
  <para style="q2" vid="JOL 2:17">ካዎተት፥ ‘ኤንታ ፆሳይ አዉኔ? ያጋና መላ ኦዳ፥</para>
  <para style="q2" vid="JOL 2:17">ነ አሳ ቦረስነ ሚቻስ የጎፋ’ ” ያጎ።<verse eid="JOL 2:17"/></para>
  <para style="s1">ጎዳ ቃያ</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>ጎዳይ ባ ቢታስ ደእያ ምሻን</para>
  <para style="q2" vid="JOL 2:18">ባ አሳስ ቃትስ።<verse eid="JOL 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19"/>ጎዳይ ዛሪድ ባ አሳ ሀይሳዳ ያጋና፤</para>
  <para style="q2" vid="JOL 2:19">“ሄኮ፥ ታኒ ህንተዉ ካ፥ ዎይንያነ ዛይትያ፥</para>
  <para style="q2" vid="JOL 2:19">ካልሳና ጋካናዉ የዳና፤</para>
  <para style="q2" vid="JOL 2:19">ህዛፐ ጉየ ካዎተታ ግዶን ህንተና ቦረስ አግከ።”<verse eid="JOL 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>“ፑደሀ ባጋራ ይዳ ቦልያ፥</para>
  <para style="q2" vid="JOL 2:20">ታኒ የደዳ ህንተፈ ሃሳና።</para>
  <para style="q1" vid="JOL 2:20">ባይሳነ መላ ቢታ ኤንታ ጎዳና፤</para>
  <para style="q2" vid="JOL 2:20">ስን ባጋራ ደኤይሳታ ማፅነ አባ፥</para>
  <para style="q2" vid="JOL 2:20">ጉየ ባጋራ ደኤይሳታ መደትራነ አባ፥ የደና፤</para>
  <para style="q2" vid="JOL 2:20">ያን ኤንቲ ሀይቅድ ፅንቃና።</para>
  <para style="q1" vid="JOL 2:20">ቱማ ጎዳይ ዎልቃማባ ህንተዉ ኦስ” ያጋና።<verse eid="JOL 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JOL 2:21"/>ቢታዉ፥ ህዛ ያዮፋ፤</para>
  <para style="q2" vid="JOL 2:21">ጎዳይ ግታባ ኦዳ ግሾ፥</para>
  <para style="q2" vid="JOL 2:21">ኡፋይታነ ሀሹ ጋ!<verse eid="JOL 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22"/>ህንተኖ ሳኣ መሄቶ፥ ያዮፍተ፤</para>
  <para style="q2" vid="JOL 2:22">ባዞን ደእያ ማታይ አጭስ።</para>
  <para style="q1" vid="JOL 2:22">ምይ አይፍስ፤</para>
  <para style="q2" vid="JOL 2:22">ባላሰይነ ዎይነ አይፈይ ቡርኩክስ።<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>ህንተኖ ፅዮነ አሳቶ፥ ኡፋይትተ፤</para>
  <para style="q2" vid="JOL 2:23">ጎዳን ህንተ ፆሳን፥ ሀሹ ጊተ!</para>
  <para style="q1" vid="JOL 2:23">እ፥ ባልጎ እራ ህንተዉ ዳርስድ እሚስ፤</para>
  <para style="q2" vid="JOL 2:23">ካሰይሳዳ ስላነ ቶርቸ እራ ግድስድ እሚስ።<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>ካ ቡክያ ዉዱማን ካ ኩማና፤</para>
  <para style="q2" vid="JOL 2:24">ዎይንያነ ዛይትያ ጉምእያ ኦላይ ኩምድ ፓላሀና።<verse eid="JOL 2:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>ካሰ ታኒ ህንተ ግዶ የድዳ፥</para>
  <para style="q2" vid="JOL 2:25">ዎልቃማ ጎንዶይ፥ ቦለይ፥ ጉዶትነ ፃቆት ምዳይሳ፥</para>
  <para style="q2" vid="JOL 2:25">ታ ህንተዉ ዛራና።<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>ህንተ ምን ካልስድ ፓላህያ ካ ዳና፤</para>
  <para style="q2" vid="JOL 2:26">ማላልስያባ ህንተዉ ኦዳ ጎዳ።</para>
  <para style="q2" vid="JOL 2:26">ህንተ ፆሳ ሱን ጋላታና፤</para>
  <para style="q2" vid="JOL 2:26">ታ አሳይ ዛሪድ ዬላተና።<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>ሄ ዎደ ታኒ እስራኤለ ግዶን ደኤይሳ፥</para>
  <para style="q2" vid="JOL 2:27">ታኒ ጎዳይ ህንተ ፆሳ ግደይሳነ</para>
  <para style="q2" vid="JOL 2:27">ታፐ ሀራ ፆሲ ባይናይሳ ህንተ ኤራና።</para>
  <para style="q1" vid="JOL 2:27">ታ አሳይ ዛሪድ ዬላተና።<verse eid="JOL 2:27"/></para>
  <para style="s1">ጎዳ ጋላሳ</para>
  <para style="p">
    <verse number="28" style="v" sid="JOL 2:28"/>ህዛፐ ጉየ ሀይሳዳ ሀናና፤</para>
  <para style="q2" vid="JOL 2:28">ታኒ አሳ ኡባ ቦላ ታ አያና ጉሳና።</para>
  <para style="q1" vid="JOL 2:28">ህንተ አደ ናይትነ ማጫ ናይት ትንብተ ኦዳና፤</para>
  <para style="q2" vid="JOL 2:28">ህንተ ጭማት አሙሆ አሙሀና፤</para>
  <para style="q2" vid="JOL 2:28">ህንተ ናአተት ቆንጨ በአና።<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>ሄ ጋላሳታን ታ አደ አይለልታ ቦላነ</para>
  <para style="q2" vid="JOL 2:29">ታ ማጫ አይለታ ቦላ ታ አያና ጉሳና።<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>ታኒ ሳሎንነ ሳአን ማላልስያባ ኦና፥</para>
  <para style="q2" vid="JOL 2:30">ታማነ ሳሎ ደንድያ ጩያ በሳና።<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>ግታነ ያሽያ ጎዳ ጋላሳይ ያናፐ ካሰ፥</para>
  <para style="q2" vid="JOL 2:31">አው ማና፤ አጌን ሱ ዳናና።<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>ሄ ዎደ ሀይሳዳ ሀናና፤</para>
  <para style="q2" vid="JOL 2:32">ጎዳ ሱን ፄግያ ኡባይ አታና።</para>
  <para style="q1" vid="JOL 2:32">ጎዳይ ግዳይሳዳ ፅዮነ ዙማንነ</para>
  <para style="q2" vid="JOL 2:32">የሩሳላመን አትዳይሳት ዳና።<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">ሀራ ካዎተት ፕርደታና</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1"/>“ሄ ጋላሳንነ ሄ ዎድያን</para>
  <para style="q2" vid="JOL 3:1">ታኒ ይሁዳነ የሩሳላመ አሳ</para>
  <para style="q2" vid="JOL 3:1">ድኤተፈ ዛራዳ አንጃና።<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>ታኒ ካዎተታን ደእያ አሳ ሺሻዳ፥</para>
  <para style="q2" vid="JOL 3:2">ዮሳፈፃ ዛንጋራ ዎሳና።</para>
  <para style="q1" vid="JOL 3:2">ታ አሳ እስራኤለ ቦላ ኤንቲ ኦዳ ኢታ ኦሱዋ ግሾ፥</para>
  <para style="q2" vid="JOL 3:2">ታኒ ኤንታ ያን ፕርዳና።</para>
  <para style="q1" vid="JOL 3:2">ኤንቲ ካዎተታ ግዶን ታ አሳ ላልዶሶና፤</para>
  <para style="q2" vid="JOL 3:2">ታ ቢታ ባንታዉ ሻክ ኤክዶሶና።<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>ታ አሳ ቦላ ሳማ የግዶሶና፤</para>
  <para style="q2" vid="JOL 3:3">ላይማትያ ማጫስ ደማናዉ፥ አደ ናይታ እምዶሶና፤</para>
  <para style="q2" vid="JOL 3:3">ዎይነ ኡሻስ ማጫ ናይታ ባይዝዶሶና።<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>“ህንተኖ፥ ፅሮሳ፥ ስዶናነ ፍልስፄመ ቢታ አሳቶ፥ ህንተ ታ ቦላ አይ ኦናዉ ቆፕደቲ? ታ ቦላ ሀሎ ከያናዉ ኮዬቲ? ህንተ ሄሳ ኮይኮ፥ ታኒ ኤለሳዳ ህንተ ኦሱዋ ህንተ ቦላ ዛራና። <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>ታ ብራ፥ ታ ዎርቃነ ታ አልኦ ሚሽያ ኡባ ኤክድ ህንተ ኤቃ ኬ ገልስደታ። <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>ይሁዳነ የሩሳላመ አሳ ኤንታ ቢታፈ ሃስ ኤፍድ፥ ግርከ አሳስ ባይዝደታ። <verse eid="JOL 3:6"/><verse number="7" style="v" sid="JOL 3:7"/>ሄኮ፥ ህንተ ባይዝዳ በሳፈ ታኒ ሀእ ኤንታ ከሳዳ ህንተ ኦዳባ ኡባ ህንተ ሁጰን ዛራና። <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>ታኒ ህንተ አደ ናይታነ ህንተ ማጫ ናይታ ይሁዳ አሳስ አ እማና። ኤንቲ ሃሆ ቢታን ደእያ ሳባ አሳስ ኤንታ ባይዛና። ታኒ ጎዳይ ሀይሳ ኦዳስ።<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>“ሀይሳዳ ያግድ ካዎተታ ግዶን አዋጅተ፤</para>
  <para style="q2" vid="JOL 3:9">ኦላስ ጊግተ፤ ምኖ አሳታ ደንተ፥</para>
  <para style="q2" vid="JOL 3:9">ኦላንቾት ሺቅድ ኦላስ ከዮ።<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>ህንተ ማራሻ ማሸ፥</para>
  <para style="q2" vid="JOL 3:10">ህንተ ባጫ ቶራ ኦድ ቆፅተ!</para>
  <para style="q2" vid="JOL 3:10">ዳቡራንቾይ፥ ‘ታኒ ምኖ!’ ያጎ።<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>ህንተኖ፥ ዩሹዋን ደእያ ካዎተቶ፥</para>
  <para style="q2" vid="JOL 3:11">ኤለ ከይተ፤ ሃ ሺቅተ” ያግተ።</para>
  <para style="q1" vid="JOL 3:11">አቤት ጎዳዉ፥ ነ ኦላንቾታ ዱገ የዳ!<verse eid="JOL 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>“ካዎተት ደንድድ፥</para>
  <para style="q2" vid="JOL 3:12">ዮሳፈፃ ዛንጋራ ዮ፤</para>
  <para style="q1" vid="JOL 3:12">እስራኤለ ዩሹዋን ደእያ ካዎተታ፥</para>
  <para style="q2" vid="JOL 3:12">ኡባ ቦላ ፕርዳናዉ ታኒ ያን ኡታና።<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>ኤንታ ኢታተይ ዳሮ፤</para>
  <para style="q2" vid="JOL 3:13">ጫካ ዎደይ ጋክዳ ካዳ ኤንታ ጫክተ።</para>
  <para style="q1" vid="JOL 3:13">ዎይነ አይፈይ ኦላን ኩምን የይሳዳ፥</para>
  <para style="q2" vid="JOL 3:13">ኤንታ የተ።<verse eid="JOL 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>ፕርዳ ዛንጋራን ጎዳይ ፕርድያ ጋላሳይ ጋክስ፤</para>
  <para style="q2" vid="JOL 3:14">ሄሳ ግሾ፥ ታይቦን ዳሮ አሳይ ሄ ዛንጋራን ሺቅስ።<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>ሄ ጋላስ አውነ አጌን ማና፤</para>
  <para style="q2" vid="JOL 3:15">ፆልንቶት ባንታ ፖኡዋ ድጋና።<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>ጎዳይ ፅዮነን ግድድ ደቻና፤</para>
  <para style="q2" vid="JOL 3:16">የሩሳላመን ባ ቃላ ስሳና፤</para>
  <para style="q2" vid="JOL 3:16">ሳሎይነ ሳእ ኮኮራና።</para>
  <para style="q1" vid="JOL 3:16">ሽን ጎዳይ ባ አሳስ፥</para>
  <para style="q2" vid="JOL 3:16">እስራኤለስ ባቃትድ አትያ በሲ ግዳና።”<verse eid="JOL 3:16"/></para>
  <para style="s1">ፆሳ ደረይ አንጀታና</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>“ሄ ዎደ ህንተ፥ ታኒ ታ ጌሻ ዙማ ቦላ፥</para>
  <para style="q2" vid="JOL 3:17">ፅዮነን ደእያ ጎዳ ህንተ ፆሳ ግደይሳ ኤራና።</para>
  <para style="q1" vid="JOL 3:17">የሩሳላመ ካታማይ ጌሽ ግዳና፤</para>
  <para style="q2" vid="JOL 3:17">አላጋት ዛሪድ የሩሳላመ ኦሎኮና።<verse eid="JOL 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>ሄ ጋላስ ደረት ማልአንቶ ዎይነ ኡሻን ፆካና፤</para>
  <para style="q2" vid="JOL 3:18">ዙማት ማ ጎጋና።</para>
  <para style="q1" vid="JOL 3:18">ይሁዳ ቢታን ደእያ ሻፋ ኡባን</para>
  <para style="q2" vid="JOL 3:18">ሃ ፑልታና።</para>
  <para style="q1" vid="JOL 3:18">ጎዳ ኬን ፑልቶይ ቃና፤</para>
  <para style="q2" vid="JOL 3:18">ሴፅማ ዛንጋራ ኡሻና።<verse eid="JOL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 3:19"/>“ግብፀይ ባይሳ ግዳና፤</para>
  <para style="q2" vid="JOL 3:19">ኤዶመይ ቦድላ ባዞ ግዳና።</para>
  <para style="q1" vid="JOL 3:19">ኤንቲ ይሁዳ አሳ ቦላ ኢታባ ኦዶሶና፤</para>
  <para style="q2" vid="JOL 3:19">ፅሎ አሳ ሱ ጉስዶሶና።<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>ሽን ይሁድነ የሩሳላመይ መርናዉ፥</para>
  <para style="q2" vid="JOL 3:20">የለታ ኡባስ ደእያ በሲ ግዳና።<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>ታኒ ሀሎ ከዮና አግዳ ኤንታ ሱ</para>
  <para style="q2" vid="JOL 3:21">ሃሉዋ ቡሮ ከያና” ያጌስ ጎዳይ።<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
