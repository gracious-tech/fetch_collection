<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- GOOF FULL BIBLE</book>
  <para style="h">ሀዋረታ ኦሶ</para>
  <para style="toc1">ሀዋረታ ኦሶ</para>
  <para style="toc3">ሀዋ</para>
  <para style="toc2">ሀዋረታ</para>
  <para style="mt">ሀዋረታ ኦሶ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሀዋረታ ኦሶ ማፃፋይ፥ ሉቃሳ ዎንገላ ካልድ ፃፈትዳ ማፃፋ። ማፃፋስ ደእያ ዋና ቆፋይ፥ የሱሳ ካልዳ ኮይሮ አሳት ጌሻ አያን ካለን፥ “የሩሳላመን፥ ይሁዳ ቢታ ኡባን፥ ሳማረን፥ ሳአ ጋፃፐ ጋፃ ጋካናዉ” (<char style="xt"><ref loc="ACT 1:8">1:8</ref></char>) ዎንገላ ቢታ ኡባ ዋት ጋዳኮ ኦዳናሳ። ማፃፋይ፥ አማኖይ አይሁደ አሳ ግዶን ዶመትድ፥ ኩመ አላመን ኤረትዳ አማኖ ግዳና ጋካናዉ ዋንድ ዳልግዳኮ ኦዴስ።</para>
  <para style="ip">ሀዋረታ ኦሶ ማፃፋይ፥ የሱሳ ዎንገላይ ጋክያ በሳይ ዎደን ዎደን ዳልግ ዳልግ በይሳነ ዎሳ ኬ ኤቅዳይሳ ቆንጭስያ ሄ አይፈ ቆፋታን ሻከቴስ።</para>
  <para style="ip">1. አማኖይ የሱሲ ሳሎ ብዳፐ ጉየ ዶመትዳይሳ ኦዴስ።</para>
  <para style="ip">2. አማኖይ እስራኤለ ቢታ ኡባ ጋክዳይሳ ኦዴስ።</para>
  <para style="ip">3. አማኖይ ሮመ ጉጅድ መደትራነ አባ ዩሾን ደእያ ቢታ ኡባን ዳልግዳይሳ በሴስ።</para>
  <para style="ip">ሀዋረታ ኦሶ ማፃፋን አድ በንተይ ጌሻ አያና ኦሶ ግድሽን፥ ጳንፀቆስፀ ጋላስ የሩሳላመን ደእያ አማንያ አሳ ቦላ ጌሻ አያን ዎልቃራ ዎዳይሳ ኦዴስ። ሄሳዳካ፥ ማፃፋ ግዶን ቆንጭዳ ኦሶታ ኡባን በንትዳይሳዳ፥ ጌሻ አያን ዎሳ ኬነ ዎሳ ኬ አይሰይሳታ ካለዳይሳነ ምንዳይሳ ጉጅድ ኦዴስ።</para>
  <para style="ip">ሀዋረታ ኦሶ ማፃፋን ኦሰትዳ ኦሶታ ኪታይ፥ አማንያ አሳ ደኦንነ ዎሳ ኬ እስፈተን ደእያ ዎልቃይ አይ መላ ግቴኮ በሴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ማርካተስ ጊገተ (<char style="ior"><ref loc="ACT 1:1-26">1:1-26</ref></char>)</para>
  <para style="io2">የሱሳ ዉርሰ ኪታነ እመትዳ ኡፋይሳ (<char style="ior"><ref loc="ACT 1:1-14">1:1-14</ref></char>)</para>
  <para style="io2">ይሁዳ በሳን ሀራ ዶሮ (<char style="ior"><ref loc="ACT 1:15-26">1:15-26</ref></char>)</para>
  <para style="io1">የሩሳላመን ማርካተ (<char style="ior"><ref loc="ACT 2:1-8:3">2:1—8:3</ref></char>)</para>
  <para style="io1">ይሁዳንነ ሳማረን ማርካተ (<char style="ior"><ref loc="ACT 8:4-12:25">8:4—12:25</ref></char>)</para>
  <para style="io1">ጳዉሎስ ሀዋረተን ኦዳ ኦሱዋ (<char style="ior"><ref loc="ACT 13:1-28:31">13:1—28:31</ref></char>)</para>
  <para style="io2">ኮይሮ ሀዋረተ ቡሳ (<char style="ior"><ref loc="ACT 13:1-14:28">13:1—14:28</ref></char>)</para>
  <para style="io2">የሩሳላመ ሺቁዋ (<char style="ior"><ref loc="ACT 15:1-35">15:1-35</ref></char>)</para>
  <para style="io2">ናምአን ሀዋረተ ቡሳ (<char style="ior"><ref loc="ACT 15:36-18:22">15:36—18:22</ref></char>)</para>
  <para style="io2">ሄን ሀዋረተ ቡሳ (<char style="ior"><ref loc="ACT 18:23-21:16">18:23—21:16</ref></char>)</para>
  <para style="io2">ጳዉሎስ የሩሳላመን፥ ቅሳረንነ ሮመን (<char style="ior"><ref loc="ACT 21:17-28:31">21:17—28:31</ref></char>)</para>
  <chapter number="1" style="c" sid="ACT 1"/>
  <para style="s1">ማርካተስ ጊገተ</para>
  <para style="p">
    <verse number="1-2" style="v" sid="ACT 1:1-2"/>ተዎፍሎሳ፥ የሱሲ ባ ኦሱዋ ኦይክዳ ዎደፐ ሳሎ ብዳ ጋላሳ ጋካናዉ፥ ኦዳባነ ታማርስዳባ ኡባ ታኒ ታ ኮይሮ ማፃፋን ፃፋስ። ሳሎ ባናፐ ስን እ ባ ዶርዳ ሀዋረታ፥ ጌሻ አያናን ኪትስ።<note caller="-" style="x"><char style="xo" closed="false">1:1-2 </char><char style="xt" closed="false"><ref loc="LUK 1:1-4">ሉቃ 1:1-4</ref>.</char></note> <verse eid="ACT 1:1-2"/><verse number="3" style="v" sid="ACT 1:3"/>እ ባ ዋያፐ ጉየ፥ ሀይቆፐ ደንድዳይሳ ስይ ባይና ቆንጭስድ ኤንታዉ ባና በስስ። ኦይታሙ ጋላስ ኤንታዉ ቆንጭድ ፆሳ ካዎተባ ኤንታ ታማርስስ። <verse eid="ACT 1:3"/><verse number="4" style="v" sid="ACT 1:4"/>እስ ዎደ ኤንታራ እስፈ ደእሸ ኤንታ ሀይሳዳ ያግድ ኪትስ፦ “ታ ህንተዉ ኦድዳ፥ ታ አዋይ እማና ግዳ ኡፋይሳ ቃላ ናግተፐ አትሽን፥ የሩሳላመፐ ከዮፕተ።<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 24:49">ሉቃ 24:49</ref>.</char></note> <verse eid="ACT 1:4"/><verse number="5" style="v" sid="ACT 1:5"/>ዮሃንስ ሃን ፃማቅስ፥ ሽን ጉ ዎደፐ ጉየ፥ ጌሻ አያናን ህንተ ፃማቀታና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቶ 3:11</ref>፤ <ref loc="MRK 1:8">ማር 1:8</ref>፤ <ref loc="LUK 3:16">ሉቃ 3:16</ref>፤ <ref loc="JHN 1:33">ዮሀ 1:33</ref>.</char></note><verse eid="ACT 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6"/>ሀዋረት እስፈ የሱሳራ ሺቅዳ በሳን፥ “ጎዳዉ፥ እስራኤለታስ ነ ካዎተ ዛራና ዎደይ ሀይሴ?” ያግድ ኦይችዶሶና።<verse eid="ACT 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7"/>የሱሲ ኤንታኮ፥ “ታ አዋይ ባ ማታን ኦያ ዎደነ ላይ ህንተ ኤራናዉ ዳንዳኤከታ። <verse eid="ACT 1:7"/><verse number="8" style="v" sid="ACT 1:8"/>ሽን ጌሻ አያናይ ህንተ ቦላ ዎያ ዎደ፥ ህንተ ዎልቃን ኩማና። ያን ስሚድ፥ የሩሳላመን፥ ይሁዳ ቢታ ኡባን፥ ሳማረንነ ሳአ ጋፃ ጋካናዉ ታዉ ማርካታ ግዳና” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">ማቶ 28:19</ref>፤ <ref loc="MRK 16:15">ማር 16:15</ref>፤ <ref loc="LUK 24:47-48">ሉቃ 24:47-48</ref>.</char></note><verse eid="ACT 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9"/>ሄሳ ግዳፐ ጉየ ኤንቲ ፄልሽን፥ ቁ ቁ ግድ፥ ሳሎ ብን፥ እያ ኤንታ አይፈፐ ሻር ገንስ።<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">ማር 16:19</ref>፤ <ref loc="LUK 24:50-51">ሉቃ 24:50-51</ref>.</char></note><verse eid="ACT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10"/>የሱሲ ብያ ዎደ ኤንቲ ሳሎ ትሽ ኦድ ፄልሽን፥ ቦ ማኦ ማእዳ ናምኡ አሳት አኬኮና ኤንታ ማታን ኤቅድ፥ <verse eid="ACT 1:10"/><verse number="11" style="v" sid="ACT 1:11"/>“ጋልላ አሳቶ፥ ሳሎ ፄልሸ፥ ህንተ አይስ ኤቅደቲ? ሀ ህንተ በእሽን ሳሎ ብዳ የሱሲ ሄሳዳካ ስሚድ ያና” ያግዶሶና።<verse eid="ACT 1:11"/></para>
  <para style="s1">ይሁዳ በሳን ማትያሳ ዶረተ</para>
  <para style="r">(<ref loc="MAT 27:3-10">ማቶ 27:3-10</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12"/>ሄሳፈ ጉየ፥ ሀዋረት ሻማሆ ዙማፐ የሩሳላመ ስምዶሶና። ሻማሆ ዙማይ የሩሳላመስ ማታን ደኤስ። <verse eid="ACT 1:12"/><verse number="13" style="v" sid="ACT 1:13"/>ኤንቲ የሩሳላመ ገልድ፥ ባንታ ደእያ በሳ፥ ፖቅያ ቦላ ከይዶሶና። ኤንትካ፦ ጰፅሮሳ፥ ዮሃንሳ፥ ያይቆባ፥ እንድርያሳ፥ ፍልጶሳ፥ ቶማሳ፥ ባርተለሞሳ፥ ማቶሳ፥ እልፍዮሳ ናአ ያይቆባ፥ ባ ቢታስ ምሸትያ ስሞናነ ያይቆባ ናአ ይሁዳ።<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">ማቶ 10:2-4</ref>፤ <ref loc="MRK 3:16-19">ማር 3:16-19</ref>፤ <ref loc="LUK 6:14-16">ሉቃ 6:14-16</ref>.</char></note> <verse eid="ACT 1:13"/><verse number="14" style="v" sid="ACT 1:14"/>ሀይሳቲ ኡባይ ማጫሳታራ፥ የሱሳ አየ ማይራምራነ የሱሳ እሻታራ ኡባይ እስ ዎዛናን ግድድ ምንድ ዎሶሶና።<verse eid="ACT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15"/>ሄ ዎደ፥ ጰፅሮስ ፄታነ ላታማ ግድያ አማንያ አሳይ ሺቅዳ በሳን ደንድ ኤቅድ፥ ሀይሳዳ ያግስ፦ <verse eid="ACT 1:15"/><verse number="16" style="v" sid="ACT 1:16"/>“አሳዉ፥ የሱሳ ኦይክዳይሳታ ካለዳ ይሁዳባ፥ ጌሻ አያናይ ካሰ ዳዊታ ዶናን ኦድዳ ፆሳ ቃላይ ፖለታናዉ በሴስ። <verse eid="ACT 1:16"/><verse number="17" style="v" sid="ACT 1:17"/>ይሁድ ኑራ እስፈ ሀ ኦሱዋ ኦናዉ ዶረትዳ አስ።”<verse eid="ACT 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18"/>ሽን ይሁድ ባ ኢታ ኦሱዋን ደምዳ ሚሸን ጋደ ሻምስ። እ ስን ጉ ኩንድን፥ እያ ኡሎይ ዳከትስ፤ እያ ማራጨ ኡባይ ካረ ከይስ።<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">ማቶ 10:2-4</ref>፤ <ref loc="MRK 3:16-19">ማር 3:16-19</ref>፤ <ref loc="LUK 6:14-16">ሉቃ 6:14-16</ref>.</char></note> <verse eid="ACT 1:18"/><verse number="19" style="v" sid="ACT 1:19"/>ይሁዳ ቦላ ሀንዳባ የሩሳላመን ደእያ አሳ ኡባይ ስእስ። ሄሳ ግሾ፥ ሄ ጋድያ ባንታ ቃላን አከልዳማ (ሱ ጋደ) ግድ ፄግዶሶና።<verse eid="ACT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20"/>“ሄስካ ማዝሙረ ማፃፋን፥</para>
  <para style="q1" vid="ACT 1:20">“ ‘እያ ኬይ ካሎ አቶ፤</para>
  <para style="q2" vid="ACT 1:20">ኦንካ እያን ደኦፖ።</para>
  <para style="q1" vid="ACT 1:20">ቃስ እያ ሹማተ ሀር ኤኮ’ ጌተትድ ፃፈትስ።<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 69:25">ማዝ 69:25</ref>፤ <ref loc="PSA 109:8">109:8</ref>.</char></note><verse eid="ACT 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21"/>“ሄሳ ግሾ፥ ጎዳ የሱሲ ኑ ግዶን ስመረትዳ ዎደ ኡባን ኑራ ደኤይሳታፐ፥ <verse eid="ACT 1:21"/><verse number="22" style="v" sid="ACT 1:22"/>ቃስ ፃማቅያ ዮሃንሳ ዎደፐ ዶምድ ጎዳ የሱሲ ሳሎ ብዳ ጋላስ ጋካናዉ ኑራ ደኤይሳታፐ እስ አስ እያ ደንዱዋስ ኑራ ማርካ ግዳናዉ በሴስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 3:16">ማቶ 3:16</ref>፤ <ref loc="MRK 1:9">ማር 1:9</ref>፤ <ref loc="LUK 3:21">ሉቃ 3:21</ref>.</char></note><verse eid="ACT 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23"/>ሄሳ ግሾ፥ አሳይ ዶሩዋስ ዮስፆሳ ዎይኮ ባርሳባሳ ጌተትያ ዮሰፋነ ማትያሳ ናምአ ሺሽዶሶና። <verse eid="ACT 1:23"/><verse number="24" style="v" sid="ACT 1:24"/>ሄሳፈ ጉየ፥ ፆሳ ዎስሸ፥ “አሳ ኡባ ዎዛና ኤርያ ጎዳዉ፥ ሀ ናምአታፐ ነ ኦና ዶርዳኮ ኑና በሳ። <verse eid="ACT 1:24"/><verse number="25" style="v" sid="ACT 1:25"/>ይሁድ ባ በሳ ብድ፥ አግዳ ኦሱዋነ ሀዋረተ ኦሱዋ ኤካና መላ ሀይሳታፐ ኑስ ቆንጭሳ” ያግዶሶና። <verse eid="ACT 1:25"/><verse number="26" style="v" sid="ACT 1:26"/>ኤንታ ቦላ ሳማ የግዶሶና። ሳማይ ማትያሳ ቦላ ዎን፥ ማትያስ ታማነ እስ ሀዋረታ ቦላ ጉዠትስ።<verse eid="ACT 1:26"/></para>
  <chapter eid="ACT 1"/>
  <chapter number="2" style="c" sid="ACT 2"/>
  <para style="s1">ጌሻ አያና ዎ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1"/>ጰንፀቆስፀ ጋላሳይ ጋክዳ ዎደ አማንያ አሳ ኡባይ እስፈ እስ በሳን ሺቅድ ደኦሶና።<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ሌወ 23:15-21</ref>፤ <ref loc="DEU 16:9-11">ዛረ 16:9-11</ref>.</char></note> <verse eid="ACT 2:1"/><verse number="2" style="v" sid="ACT 2:2"/>ቆፖና ዎልቃማ ጎተዳ ጉምያ ጉንይ አኬኮና ሳሎፐ ይድ ኤንቲ ደእያ ኬ ኩምስ። <verse eid="ACT 2:2"/><verse number="3" style="v" sid="ACT 2:3"/>ቃስ ታማ ላጮ ዳንያ እንፃርሳት ኤንታዉ በንትሸ፥ ሻከት ሻከት ኤንታ ኡባ ቦላ ዎዶሶና። <verse eid="ACT 2:3"/><verse number="4" style="v" sid="ACT 2:4"/>ኤንቲ ኡባይ ጌሻ አያናን ኩምድ ዱማ ዱማ ዶናን ኦደታና መላ ጌሻ አያናይ ኤንታ ዳንዳእስን ሃሳያ ዶምዶሶና።<verse eid="ACT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5"/>ሄ ዎደ ቢታ ኡባፈ ይዳ ፆሳስ ባቢያ አይሁደት የሩሳላመን ደኦሶና። <verse eid="ACT 2:5"/><verse number="6" style="v" sid="ACT 2:6"/>ሄ ጉን ስእዳ ዎደ ዳሮ አሳይ ሺቅዶሶና። አማንያ አሳይ ኤንታ ቃላን ኦደትሽን ስእዳ ግሾ፥ <verse eid="ACT 2:6"/><verse number="7" style="v" sid="ACT 2:7"/>ማላለትድ፥ “ሀ ኦደትያ አሳ ኡባይ ጋልላ አሰ ግዶኮናዬ? <verse eid="ACT 2:7"/><verse number="8" style="v" sid="ACT 2:8"/>ያትን፥ ኑኒ፥ ኑ የለትዳ ቢታ ዶናን ኤንቲ ኦደትሽን ዋንድ ስአናዉ ዳንዳእዶ? <verse eid="ACT 2:8"/><verse number="9" style="v" sid="ACT 2:9"/>ኑኒ ጳርፀን፥ ሜዶናን፥ ኤላማን፥ ማሰጰፆመን ደኤይሳት፥ ይሁዳን፥ ቃጳዶቃን፥ ጳንፆሳን፥ ኢሰን፥ <verse eid="ACT 2:9"/><verse number="10" style="v" sid="ACT 2:10"/>ፕርገን፥ ጵንፍለን፥ ግብፀን፥ ቃረና ማታን ደእያ ሊበን ደኤይሳታ። ኑፐ ባጋትካ ሮመፐ ይዳ አሳታ። <verse eid="ACT 2:10"/><verse number="11" style="v" sid="ACT 2:11"/>አይሁደትነ አይሁደተ አማኖ ገልዳ አሳት፥ ቃርፄሳነ አራበ አሳት፥ ፆሳይ ኦዳ ግታ ኦሱዋ ኑ ቃላን ኦደትሽን ስኦስ” ያግዶሶና። <verse eid="ACT 2:11"/><verse number="12" style="v" sid="ACT 2:12"/>ኡባይ ማላለትድ፥ ጋናባ ይድ፥ “ላ ሀይስ አይ ጉሴ?” ያግዶሶና። <verse eid="ACT 2:12"/><verse number="13" style="v" sid="ACT 2:13"/>ሽን ሀራት፥ “ሀይሳቲ ዎይነ ኡይድ ማትዶሶና” ያግድ ቀልቅስዶሶና። <figure style="fig" alt="Pentecost" file="GPS_Pentecost_B&amp;W_Flat_English.tiff" size="span" ref="2:9-11">ጴንፄቆስፄ ባልያስ አሳይ ይዳ ዱማ ዱማ ጋደታ</figure><verse eid="ACT 2:13"/></para>
  <para style="s1">ጰፅሮሳ ሃሳያ</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14"/>ሽን ጰፅሮስ፥ ታማነ እስ ሀዋረታራ ደንድ ኤቅድ፥ ባ ቃላ ቁ ኦድ፥ ኤንታዉ ሀይሳዳ ያግድ ኦድስ፦ “አይሁደቶ፥ የሩሳላመን ደእያ ኡባቶ፥ ታኒ ኦደይሳ ስእተ። <verse eid="ACT 2:14"/><verse number="15" style="v" sid="ACT 2:15"/>ዎንታፈ ሄ ሳተ ግድያ ግሾ ህንተ ቆፐይሳዳ ሀ አሳት ማትቦኮና፤ ሄስ ህንተዉ ኤረቶ። <verse eid="ACT 2:15"/><verse number="16" style="v" sid="ACT 2:16"/>ሽን ሀይስ ሀንዳይ ናበይ እዩኤል ኦድዳይስ ፖለታና መላሳ።<verse eid="ACT 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17"/>“ ‘ፆሳይ፥ ዎድያ ዉርሰን ሀይሳዳ ሀናና ያጌስ፦</para>
  <para style="q2" vid="ACT 2:17">ታኒ አሳ ኡባ ቦላ ታ አያና ጉሳና።</para>
  <para style="q1" vid="ACT 2:17">ህንተ አደ ናይትነ ማጫ ናይት፥</para>
  <para style="q2" vid="ACT 2:17">ትንብተ ኦዳና።</para>
  <para style="q1" vid="ACT 2:17">ህንተ ያላጋት ቆንጨ በአና፤</para>
  <para style="q2" vid="ACT 2:17">ህንተ ጭማት አሙሆ አሙሀና።<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="JOL 2:28-32">እዩ 2:28-32</ref>.</char></note><verse eid="ACT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18"/>ሄ ጋላሳታን ታና አማንያ አደ አይለታ ቦላነ ማጫ አይለታ ቦላ</para>
  <para style="q2" vid="ACT 2:18">ታኒ ታ አያና ጉሳና፤</para>
  <para style="q2" vid="ACT 2:18">ኤንቲ ትንብተ ኦዳና።<verse eid="ACT 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19"/>ቃስ ታኒ ቦላ ሳሎን ኦራባ፥</para>
  <para style="q2" vid="ACT 2:19">ጋርሳ ሳአንካ ማላ በሳና።</para>
  <para style="q1" vid="ACT 2:19">ሱይ፥ ታማይነ ዎልቃማ ጫጋናይ በንታና።<verse eid="ACT 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20"/>ግታነ ቦንቾ ግድዳ ጎዳ ጋላሳይ</para>
  <para style="q2" vid="ACT 2:20">ጋካናፐ ስን አው ማና፤</para>
  <para style="q2" vid="ACT 2:20">አጌን ሱ ዳናና።<verse eid="ACT 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21"/>ሄ ዎደ ሄሳዳ ሀናና፤</para>
  <para style="q2" vid="ACT 2:21">ጎዳ ሱን ፄግያ ኦንካ አታና’ ያግስ።<verse eid="ACT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22"/>“እስራኤለ አሳቶ፥ ሀ ቃላ ስእተ። ናዝረተ የሱሳ ኦናተይ፥ ፆሳይ ህንተ ግዶን ኦዳ ዎልቃማ ኦሱዋንነ ማላታታን ህንተዉ ቆንጮይሳ ህንተ፥ ህንተ ሁጰን ኤሬታ። <verse eid="ACT 2:22"/><verse number="23" style="v" sid="ACT 2:23"/>ፆሳ ካሰ ኤራንነ እያ ሸነን፥ የሱሲ ህንተዉ አድ እመትስ። ህንተ፥ ናጋራንቾት እያ ማስቃለ ቦላ ካቅድ ዎና መላ አድ እምደታ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">ማቶ 27:35</ref>፤ <ref loc="MRK 15:24">ማር 15:24</ref>፤ <ref loc="LUK 23:33">ሉቃ 23:33</ref>፤ <ref loc="JHN 19:18">ዮሀ 19:18</ref>.</char></note> <verse eid="ACT 2:23"/><verse number="24" style="v" sid="ACT 2:24"/>ሽን ፆሳይ ሀይቆ ዎልቃ ድግድ እያ ደንስ። ሄሳ ግሾ፥ ሀይቆይ እያ ኦይካናዉ ዳንዳእቤና።<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5-6">ማቶ 28:5-6</ref>፤ <ref loc="MRK 16:6">ማር 16:6</ref>፤ <ref loc="LUK 24:5">ሉቃ 24:5</ref>.</char></note> <verse eid="ACT 2:24"/><verse number="25" style="v" sid="ACT 2:25"/>ዳዊቲ እያባ ኦድሸ፥</para>
  <para style="q1" vid="ACT 2:25">“ ‘ታኒ ያርኮና መላ፥</para>
  <para style="q2" vid="ACT 2:25">ጎዳይ ታ ኡሻቻን ደኤስ።</para>
  <para style="q2" vid="ACT 2:25">ጎዳ ኡባ ዎደ ታ ማታን በአይስ።<verse eid="ACT 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26"/>ሄሳ ግሾ፥ ታ ዎዛናይ ኡፋይትስ፤</para>
  <para style="q2" vid="ACT 2:26">ታ እንፃርሳን ኡፋይስ ኩምስ፤</para>
  <para style="q2" vid="ACT 2:26">ሀይቅያ ታ አሳተይ ኡፋይሳን ዳና።<verse eid="ACT 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27"/>አይስ ጊኮ፥ ታ ሸምፑዋ ስኦለን አጋካ።</para>
  <para style="q2" vid="ACT 2:27">ቃስ ነ ጌሻ ናአ አሀ ዎቅሳካ።<verse eid="ACT 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28"/>ኔኒ ታና ደኦ ኦገ ኤርሳዳሳ።</para>
  <para style="q2" vid="ACT 2:28">ኔኒ ታራ ደኤይሳን ታ ኡፋይሳይ ኩመ ግዴስ’<note caller="-" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="PSA 16:8-11">ማዝ 16:8-11</ref>.</char></note> ያግስ።<verse eid="ACT 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29"/>“አሳዉ፥ ኑ አዋ ዳዊታባ ታ ህንተዉ ጌሻዳ ኦዳና። ዳዊቲ ሀይቅድ ሞገትስ፤ እያ ዱፎይ ሀች ጋካናዉ ኑ ማታን ደኤስ። <verse eid="ACT 2:29"/><verse number="30" style="v" sid="ACT 2:30"/>ዳዊቲ ናበ ግድዳ ግሾ፥ ፆሳይ እያ ሼሻፐ እሱዋ እያ ካዎተ አራታ ቦላ ኡትሳናዉ እያዉ ጫቅዳ ጫቁዋ ኤሬስ።<note caller="-" style="x"><char style="xo" closed="false">2:30 </char><char style="xt" closed="false"><ref loc="PSA 132:11">ማዝ 132:11</ref>፤ <ref loc="2SA 7:12-13">2 ሳሜ 7:12-13</ref>.</char></note> <verse eid="ACT 2:30"/><verse number="31" style="v" sid="ACT 2:31"/>ሄሳ ግሾ፥ ክርስቶሳ ደንዱዋ ስን ፄልድ፥ ‘እያ ሸምፖይ ስኦለን አትቤና፤ እያ አሳተይካ ዎቅቤና’ ግድ ኦድስ።<verse eid="ACT 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32"/>“ፆሳይ፥ ሀ የሱሳ ሀይቆፐ ደንዳይሳስ ኑኒ ኡባይ ማርካ። <verse eid="ACT 2:32"/><verse number="33" style="v" sid="ACT 2:33"/>ሄሳ ግሾ፥ ፆሳይ ባራ ሃራና መላ ባፐ ኡሻቻ ባጋራ እያ ቁ ቁ ኦድ፥ እያዉ እማና ጌተትዳ ጌሻ አያና ኤክድ፥ ሀይሳ ህንተ ሀእ በኤይሳነ ስኤይሳ ኑ ቦላ ጉስስ። <verse eid="ACT 2:33"/><verse number="34-35" style="v" sid="ACT 2:34-35"/>ጋሶይካ፥ ዳዊቲ ባ ሁጰን ሳሎ ብቤና ሽን ያግስ።</para>
  <para style="q1" vid="ACT 2:34-35">“ጎዳይ፥ ታ ጎዳ፥ ‘ታኒ ነ ሞርከታ</para>
  <para style="q2" vid="ACT 2:34-35">ነ ቶሆይ የያሶ ኦና ጋካናዉ</para>
  <para style="q2" vid="ACT 2:34-35">ሀይሳን፥ ታፐ ኡሻቻ ባጋራ ኡታ’ ” ግስ።</para>
  <para style="m" vid="ACT 2:34-35">ያግስ።<note caller="-" style="x"><char style="xo" closed="false">2:34-35 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ 110:1</ref>.</char></note><verse eid="ACT 2:34-35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36"/>“ሄሳ ግሾ፥ ሀ ህንተ ማስቃለ ቦላ ካቅዳ የሱሳ፥ ፆሳይ ጎዳነ ክርስቶሳ ኦዳይሳ እስራኤለ አሳ ኡባይ ቱማ ኤሮ” ያግስ።<verse eid="ACT 2:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37"/>አሳይ ጰፅሮስ ግዳይሳ ስእዳ ዎደ ባንታ ዎዛናን ቦሸትድ ጰፅሮሳነ ሀንኮ ሀዋረታኮ፥ “እሻቶ፥ ያትን ኑኒ አይ ኦኖ?” ያግዶሶና።<verse eid="ACT 2:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38"/>ጰፅሮስ ኤንታኮ፥ “ህንተ ናጋራይ አቶ ጌተታና መላ ናጋራፐ ስሚድ፥ ህንተ እሶይ እሶይ የሱስ ክርስቶሳ ሱንን ፃማቀትተ። ፆሳይ እምያ ጌሻ አያና ህንተ ኤካና። <verse eid="ACT 2:38"/><verse number="39" style="v" sid="ACT 2:39"/>ጋሶይካ ፆሳይ እማና ግዳ ኡፋይሳ ቃላይ ህንተዉ፥ ህንተ ናይታስነ ጎዳይ ኑ ፆሳይ ባኮ ፄግያ ሃሆን ደእያ ኡባሳ” ያግስ።<verse eid="ACT 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40"/>ጰፅሮስ ኤንታዉ ሀራ ቃላካ ጉጅ ማርካትድ፥ “ሀ ዎድያ ጌላ አሳ ቦላ ያናዉ ደእያ ፕርዳፈ ህንተ ሁጵያ አሽተ” ያግድ ዞርስ። <verse eid="ACT 2:40"/><verse number="41" style="v" sid="ACT 2:41"/>ጰፅሮስ ኦድዳይሳ ኤክዳይሳት ፃማቀትዶሶና። ሄ ጋላስ ሄ ሙኩሉ ግድያ አሳይ አማንዶሶና። <verse eid="ACT 2:41"/><verse number="42" style="v" sid="ACT 2:42"/>ኤንቲ ሀዋረታ ትምርትያን፥ እስፈተን፥ ኡይ ሙሳንነ ዎሳን ምኖሶና።<verse eid="ACT 2:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43"/>ሀዋረታ ኩሸን ዳሮ ኦራባይነ ማላት ኦሰትያ ግሾ አሳ ኡባይ ያይዶሶና። <verse eid="ACT 2:43"/><verse number="44" style="v" sid="ACT 2:44"/>አማንዳ ኡባይ እስፈ ደኦሶና፤ ባንታዉ ደእያባ ኡባ እስፈ ሻከቶሶና።<note caller="-" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">ሀዋ 4:32-35</ref>.</char></note> <verse eid="ACT 2:44"/><verse number="45" style="v" sid="ACT 2:45"/>ኤንቲ ባንታዉ ደእያባ ባይዝድ ሚሽያ እሱዋስ እሱዋስ ኮሽዳ መላ ሻኮሶና። <verse eid="ACT 2:45"/><verse number="46" style="v" sid="ACT 2:46"/>ኡባ ጋላስ እስ ዎዛናን ግድድ ፆሳ ኬን ሺቆሶና። ባንታ ኬን እሶይ እሱዋ ፄግድ ኡፋይሳንነ አሽከ ዎዛናን ካ ሞሶና። <verse eid="ACT 2:46"/><verse number="47" style="v" sid="ACT 2:47"/>ፆሳ ጋላትሸ አሳ ኡባን ሳበትዶሶና። ጎዳይ አተይሳታ ጋላስ ጋላስ ኤንታ ቦላ ጉጄስ።<verse eid="ACT 2:47"/></para>
  <chapter eid="ACT 2"/>
  <chapter number="3" style="c" sid="ACT 3"/>
  <para style="s1">ጉንዳ ኡራ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1"/>እስ ጋላስ ጰፅሮስነ ዮሃንስ ዎሳናዉ ኡዱፉን ሳተን ፆሳ ኬ ብዶሶና። <verse eid="ACT 3:1"/><verse number="2" style="v" sid="ACT 3:2"/>የለቶሶፐ ዶምድ ዎበ ግድዳ እስ አደይ ፆሳ ኬ ገልያ አሳፐ ሚሸ ዎሳና መላ ኡባ ጋላስ ሎኦ ጌተትያ ፆሳ ኬ ፐንገን ኤህድ ዎሶና። <verse eid="ACT 3:2"/><verse number="3" style="v" sid="ACT 3:3"/>ሄ ዎበ አደይ ጰፅሮስነ ዮሃንስ ፆሳ ኬ ገላና ሀንሽን በእድ ኤንታ ሚሸ ዎስስ።<verse eid="ACT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 3:4"/>ኤንትካ እያ ጫድ ፄልድ፥ “ኑኮ ሃ ፄላ” ያግዶሶና። <verse eid="ACT 3:4"/><verse number="5" style="v" sid="ACT 3:5"/>ዎበ አደይ ኤንታፈ አይኮ ኤካና ዳንን ኤንታኮ ፄልስ። <verse eid="ACT 3:5"/><verse number="6" style="v" sid="ACT 3:6"/>ሽን ጰፅሮስ እያኮ፥ “ታዉ ሚሸይ ባዋ፥ ሽን ታዉ ደእያባ ታኒ ነዉ እማና። ናዝረተ የሱስ ክርስቶሳ ሱንን ደንዳዳ ሄመታ” ያግስ።<verse eid="ACT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 3:7"/>ሄሳፈ ጉየ፥ ዎበ አድያስ ኡሻቻ ኩሽያ ኦይክድ ደንስ። ኤለስድ እያ ቶሆይነ ቅንጫፍለይ ምን አግስ። <verse eid="ACT 3:7"/><verse number="8" style="v" sid="ACT 3:8"/>አደይ ጉፕድ ደንድ ኤቅስ። ገደነ ሃ ሄመ ዶምስ። ሄመትሸ፥ ጉፕሸነ ፆሳ ጋላትሸ ኤንታራ እስፈ ፆሳ ኬ ገልስ።<verse eid="ACT 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 3:9"/>እ ሄመትሽንነ ፆሳ ጋላትሽን አሳ ኡባይ እያ በእዶሶና። <verse eid="ACT 3:9"/><verse number="10" style="v" sid="ACT 3:10"/>በእዳ ኡባይ ሚሸ ዎሳናዉ ሎኦ ጌተትያ ፆሳ ኬ ፐንገን ኡትዳይስ፥ እያ ግድዳይሳ ኤርዶሶና፤ እ ሀንዳባ በእድ ማላለትዶሶና።<verse eid="ACT 3:10"/></para>
  <para style="s1">ጰፅሮሳ ሃሳያ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11"/>አደይ ጰፅሮሳፐነ ዮሃንሳፐ ዱፅከ ግድ ኦይክድ ደእሽን፥ አሳ ኡባይ ማላለትድ፥ ሶሎሞነ ባራንዳ ጌተትያ በሳን እስፈ ኤንታኮ ዎፅዶሶና። <verse eid="ACT 3:11"/><verse number="12" style="v" sid="ACT 3:12"/>ጰፅሮስ አሳ በእዳ ዎደ አሳኮ፥ “እስራኤለ አሳዉ፥ አይስ ሀይሳን ማላለተቲ? ዎይኮ አይስ ኑና ጫድ ፄለቲ? ኑኒ ኑ ዎልቃን ዎይኮ ኑ ፅሎተን ሀ አድያ ሄመዳባ ህንተዉ ዳኒ? <verse eid="ACT 3:12"/><verse number="13" style="v" sid="ACT 3:13"/>አብራሃመ፥ ይሳቃ፥ ያይቆባ ፆሳይ፥ ኑ አዋታ ፆሳይ፥ ባ ናኣ የሱሳ ቦንችስ። ሽን ህንተ ሀይቆስ አድ እምዳይሳ ጵላፆስ ብላናዉ ኮይንካ ህንተ እያ ስንን፥ ‘ኑኒ እያ ኤሮኮ’ ያግደታ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 3:15">ከሳ 3:15</ref>.</char></note> <verse eid="ACT 3:13"/><verse number="14" style="v" sid="ACT 3:14"/>ህንተ ጌሻነ ፅሉዋ፥ ‘ኑኒ እያ ኤሮኮ’ ግድ፥ ሸምፖ ዎዳይሳ ህንተዉ ብላና መላ ጵላፆሳ ዎስደታ።<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">ማቶ 27:15-23</ref>፤ <ref loc="MRK 15:6-14">ማር 15:6-14</ref>፤ <ref loc="LUK 23:13-23">ሉቃ 23:13-23</ref>፤ <ref loc="JHN 19:12-15">ዮሀ 19:12-15</ref>.</char></note> <verse eid="ACT 3:14"/><verse number="15" style="v" sid="ACT 3:15"/>ደኦ እመይሳ ህንተ ዎደታ፥ ሽን ፆሳይ ሀይቆፐ እያ ደንስ። ሄሳስ ኑኒ ማርካ። <verse eid="ACT 3:15"/><verse number="16" style="v" sid="ACT 3:16"/>ሀ ህንተ በኤይስነ ኤርያ አደይ፥ ፓፅድ ምንዳይ የሱሳ ሱንን አማንዳይሳና። ሀ ህንተ ኡባ ስንን እያ ሀይሳዳ ፓዳይ፥ እ የሱሳ አማንዳ ግሾሳ።<verse eid="ACT 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17"/>“ሀእካ ታ እሻቶ፥ ህንተካ ህንተና ካለይሳታዳ፥ ኤሮና ኦዳይሳ ታኒ ኤራይስ። <verse eid="ACT 3:17"/><verse number="18" style="v" sid="ACT 3:18"/>ሽን ፆሳይ በን ናበታ ኡባ ዶናን፥ ‘ክርስቶስ ዋየ ኤካናዉ በሴስ’ ያግዳይስ ሀይሳዳ ፖለታና መላ ኦስ። <verse eid="ACT 3:18"/><verse number="19" style="v" sid="ACT 3:19"/>ህዛ፥ ፆሳይ ህንተ ናጋራ አቶ ጋና መላ ጎዳኮ ስምተ። <verse eid="ACT 3:19"/><verse number="20" style="v" sid="ACT 3:20"/>ጎዳ ማታፐ ምን ዎደይ ህንተዉ ያና። ፆሳይ ክርስቶሳ ግዳና መላ ስንትድ ዶርዳ የሱሳ ህንተዉ የዳና። <verse eid="ACT 3:20"/><verse number="21" style="v" sid="ACT 3:21"/>ፆሳይ ባ ጌሻ ናበታ ዶናን በን ኦድዳይሳ መላ ኡባባይ ኦራፅያ ዎደይ ጋካናዉ የሱሲ ሳሎን ጋምአናዉ በሴስ። <verse eid="ACT 3:21"/><verse number="22" style="v" sid="ACT 3:22"/>ሙሰይ፥ ‘ጎዳ ፆሳይ ታና ደንዳይሳ መላ ህንተ ግዶፈ ህንተዉ ናበ ደንና። ህንተ እ ገይሳ ኡባ ስእተ።<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="DEU 18:15">ዛረ 18:15</ref>፥ <ref loc="DEU 18:18">18</ref>.</char></note> <verse eid="ACT 3:22"/><verse number="23" style="v" sid="ACT 3:23"/>ሄ ናበይ ኦደይሳ ስኦና አስ ኦንካ አሳ ግዶፈ ሻከትድ ዮ’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="DEU 18:19">ዛረ 18:19</ref>.</char></note><verse eid="ACT 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24"/>“ቃስ ሳሜላፐ ዶምድ ደእያ ናበት ኡባይ ሀ ዎድያባ ኦድዶሶና። <verse eid="ACT 3:24"/><verse number="25" style="v" sid="ACT 3:25"/>ህንተ ናበታ ናይታ፤ ቃስ ፆሳይ አብራሃመስ፥ ‘ሳአን ደእያ አሳ ኡባ ታኒ ነ ሼሻ ባጋራ አንጃና’ ያግድ ኑ አዋታስ ገልዳ ቃላ ላትያ ናይታ።<note caller="-" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="GEN 22:18">መ 22:18</ref>.</char></note> <verse eid="ACT 3:25"/><verse number="26" style="v" sid="ACT 3:26"/>ፆሳይ ህንተና ኡባ ህንተ ኢታ ኦገፐ ዛሪድ አንጃና መላ ባ ናአ ደንድ ህንተዉ ኮይሮ የድስ” ያግስ።<verse eid="ACT 3:26"/></para>
  <chapter eid="ACT 3"/>
  <chapter number="4" style="c" sid="ACT 4"/>
  <para style="s1">ጰፅሮስነ ዮሃንስ ሻንጎ ስንን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1"/>ጰፅሮስነ ዮሃንስ አሳስ ኦድሽን ካህነ ሀላቃት፥ ፆሳ ኬ ናገይሳታ ሀላቃይነ ሳዱቃወት ኤንታኮ ይዶሶና። <verse eid="ACT 4:1"/><verse number="2" style="v" sid="ACT 4:2"/>ኤንቲ የሱሲ ሀይቆፐ ደንዶይሳነ እያ ጋሶን ሀይቆፐ ደንዶይ ደኤይሳ አሳ ታማርስዳ ግሾ ይሎትዶሶና። <verse eid="ACT 4:2"/><verse number="3" style="v" sid="ACT 4:3"/>ሄሳ ግሾ፥ ኤንታ ኦይክድ ሳእ ኦማርስዳ ግሾ ዎንታና ጋካናዉ ቃሾ ኬ ገልስዶሶና። <verse eid="ACT 4:3"/><verse number="4" style="v" sid="ACT 4:4"/>ሽን ቃላ ስእዳይሳታፐ ዳሮት አማንዶሶና። አማንዳ አደ አሳ ታይቦይ እቻሹ ሙኩሉኮ ብስ።<verse eid="ACT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5"/>ዎንተ ጋላስ ደርያ ሃረይሳት፥ ጭማትነ፥ ህገ አስታማረት የሩሳላመን ሺቅዶሶና። <verse eid="ACT 4:5"/><verse number="6" style="v" sid="ACT 4:6"/>ሄ አሳ ግዶን ካህነ ሀላቃይ ሃን፥ ቃያፍ፥ ዮሃንስ፥ እስክንድረይነ ካህነ ሀላቃ ሶ አሳት ኡባይ ደኦሶና። <verse eid="ACT 4:6"/><verse number="7" style="v" sid="ACT 4:7"/>ሀዋረታ ባንታ ስንን ኤስድ፥ “አይብ ዎልቃን ዎይኮ ኦደ ሱንን ሀይሳ ህንተ ኦደቲ?” ያግድ ኦይችዶሶና።<verse eid="ACT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8"/>ሄ ዎደ ጰፅሮስ ጌሻ አያናን ኩምድ፥ “ደርያ ሃረይሳቶ፥ ጭማቶ፥ <verse eid="ACT 4:8"/><verse number="9" style="v" sid="ACT 4:9"/>ሀች ሀ ዎበ አድያስ ኦሰትዳ ሎኦ ኦሱዋስነ እ ዋንድ ፓፅዳኮ ህንተ ኑና ኦይችኮ፥ <verse eid="ACT 4:9"/><verse number="10" style="v" sid="ACT 4:10"/>ማስቃልያ ቦላ ህንተ ካቅን፥ ፆሳይ ሀይቆፐ ደንዳ ናዝረተ የሱስ ክርስቶሳ ሱንን ሀ አደይ ፓፅድ ህንተ ስንን ኤቅዳይስ ህንተዉነ እስራኤለ አሳ ኡባስ ኤረቶ።<verse eid="ACT 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ACT 4:11"/>“ ‘ግምበይሳት ቦርድ እፅዳ ሹቻይ፥</para>
  <para style="q2" vid="ACT 4:11">ጎዳ ፃጱዋ ምንያ፥</para>
  <para style="q2" vid="ACT 4:11">ኡባፈ አያ ሹቹ ግድስ።</para>
  <para style="q1" vid="ACT 4:11">ሄ ሹቻይ የሱሳ።’<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዝ 118:22</ref>.</char></note><verse eid="ACT 4:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12"/>ሄሳ ግሾ፥ አቶተ እያ ባጋራፐ አትሽን፥ ሀራ ኦደ ባጋራካ ባዋ። ኑኒ እያ ሱንን አታና መላ አሳ ኡባስ ፆሳይ ሳሎፐ ጋርሳን እምዳ ሀራ ሱን ባዋ” ያግስ።<verse eid="ACT 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13"/>ሺቅዳ አሳይ ጰፅሮስነ ዮሃንስ ምንዳ ምኖተ በእዳ ዎደ ኤንቲ ታማርቦና ጮ አስ ግድዳይሳ አኬክድ፥ ማላለትዶሶና፤ ኤንቲ የሱሳራ ደኤይሳ ኤርዶሶና። <verse eid="ACT 4:13"/><verse number="14" style="v" sid="ACT 4:14"/>ቃስ ፓፅዳ አደይ ጰፅሮሳራነ ዮሃንሳራ ኤቅዳይሳ አሳይ በእድ ግያባ ይዶሶና። <verse eid="ACT 4:14"/><verse number="15" style="v" sid="ACT 4:15"/>ሽን ጰፅሮሳነ ዮሃንሳ ካረ ከያና መላ ኦድ ባንታ ግዶን፥ <verse eid="ACT 4:15"/><verse number="16" style="v" sid="ACT 4:16"/>“ሀ አሳታ ኑ አይ ኦኖ? ኤንታ ኩሸን ኦሰትዳ ግታ ማላታይ የሩሳላመን ደእያ ኡባስ በንቴስ። ኑኒ ሄሳ ኤሮኮ ጋናዉ ዳንዳኦኮ። <verse eid="ACT 4:16"/><verse number="17" style="v" sid="ACT 4:17"/>ሽን ሀ ኦዳይ አሳ ግዶን ላለቶና መላ ህዛፐ ጉየ፥ ሀ አሳት የሱሳ ሱንን ኦደስካ ኦዶና መላ ምንድ ናግሳና” ያግድ ዞረትዶሶና።<verse eid="ACT 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18"/>ኤንታ ፄግድ፥ የሱሳ ሱንን ህዛፐ ኦዶና መላ ዎይኮ ታማርሶና መላ ኪትዶሶና። <verse eid="ACT 4:18"/><verse number="19" style="v" sid="ACT 4:19"/>ሽን ጰፅሮስነ ዮሃንስ ኤንታኮ ዛሪድ፥ “ፆሳስ ኪተታናይሳፈነ ህንተዉ ኪተታናይሳፈ ፆሳ ስንን አዉስ ሎኦኮ? አነ ህንተ ፕርድተ። <verse eid="ACT 4:19"/><verse number="20" style="v" sid="ACT 4:20"/>ኑኒ በእዳባነ ስእዳባ ኦዶና አጋናዉ ዳንዳኦኮ” ያግዶሶና።<verse eid="ACT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21"/>ቢታ ጭማትነ ደርያ ሃረይሳት ካሰፐ ምን ናግስድ ኤንታ የድ አግዶሶና። አሳይ ሀንዳባስ ፆሳ ጋላትያ ግሾ ኤንታ ሴራናዉ ዳንዳእቦኮና። <verse eid="ACT 4:21"/><verse number="22" style="v" sid="ACT 4:22"/>ሄ ማላታን ሀርገፈ ፓፅዳ አድያስ ላይ ኦይታማፐ አስ።<verse eid="ACT 4:22"/></para>
  <para style="s1">አማንያ አሳ ዎሳ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23"/>ጰፅሮስነ ዮሃንስ ብርሸትድ ባንታ ዳቦታኮ ብድ፥ ካህነ ሀላቃትነ ጭማት ባንታኮ ግዳባ ኡባ ኤንታዉ ኦድዶሶና። <verse eid="ACT 4:23"/><verse number="24" style="v" sid="ACT 4:24"/>ኤንቲ ሄሳ ስእዳ ዎደ እስ ዎዛናን ግድድ ፆሳ ሀይሳዳ ያግድ ዎስዶሶና፦ “ኡባ ሃርያ ጎዳዉ፥ ሳሉዋ፥ ሳኣ፥ አባነ ኤንታ ግዶን ደእያ ኡባባ መዳይሶ፥<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ከሳ 20:11</ref>፤ <ref loc="NEH 9:6">ናህ 9:6</ref>፤ <ref loc="PSA 146:6">ማዝ 146:6</ref>.</char></note> <verse eid="ACT 4:24"/><verse number="25" style="v" sid="ACT 4:25"/>ኔኒ ነ አይልያ፥ ኑ አዋ ዳዊታ ዶናን ጌሻ አያናን፥</para>
  <para style="q1" vid="ACT 4:25">“ ‘ደረይ አይስ ይሎትዶና?</para>
  <para style="q2" vid="ACT 4:25">አሳይ አይስ ጮ ማቀትዶና?<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="PSA 2:1-2">ማዝ 2:1-2</ref>.</char></note><verse eid="ACT 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26"/>ሳኣ ካዎትነ</para>
  <para style="q2" vid="ACT 4:26">ደርያ ሃረይሳት እስፈ ጎዳ ቦላነ</para>
  <para style="q2" vid="ACT 4:26">ክርስቶሳ ቦላ ደንድዶሶና’ ያጋዳሳ።<verse eid="ACT 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27"/>“ቱማካ፥ ሄሮዲስነ ጰንፀ ጵላፆስ አይሁደ ግዶና አሳራነ እስራኤለ አሳራ ነ ዶርዳ ነ ጌሻ ናኣ የሱሳ ቦላ ደንዳናዉ ሀ ካታማን ሺቅዶሶና።<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="MAT 27:1-2">ማቶ 27:1-2</ref>፤ <ref loc="MRK 15:1">ማር 15:1</ref>፤ <ref loc="LUK 23:1">ሉቃ 23:1</ref>፥ <ref loc="LUK 23:7-11">7-11</ref>፤ <ref loc="JHN 18:28-29">ዮሀ 18:28-29</ref>.</char></note> <verse eid="ACT 4:27"/><verse number="28" style="v" sid="ACT 4:28"/>ቃስ ኔኒ ነ ዎልቃንነ ነ ሸንያን ኦና ጋዳ ቆፓ ኡትዳባ ኡባ ፖልዶሶና። <verse eid="ACT 4:28"/><verse number="29" style="v" sid="ACT 4:29"/>ሀእካ ጎዳዉ፥ ኤንታ ማንደ በአ፤ ኑኒ ነ አይለት ነ ቃላ ኩመ ዎዛናን ኦዳና መላ ኑና ዳንዳእሳ። <verse eid="ACT 4:29"/><verse number="30" style="v" sid="ACT 4:30"/>ነ ጌሻ ናኣ የሱሳ ሱንን ሀርጋንቾታ ፓናዉ፥ ኦራባይነ ማላታት ኦሰታና መላ ነ ኩሽያ ምጫ” ግድ ዎስዶሶና።<verse eid="ACT 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31"/>ኤንቲ ፆሳ ዎስዳፐ ጉየ፥ ሄ ኤንቲ ሺቅዳ በሳይ ቃፅስ። ኤንታ ኡባን ጌሻ አያን ኩምን ፆሳ ቃላ ምኖተን ኦድዶሶና።<verse eid="ACT 4:31"/></para>
  <para style="s1">ኮይሮ አማንዳ አሳ እስፈተ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32"/>አማነይሳት ኡባይ ቆፋንነ ዎዛናን እስኖ ግድዶሶና። ኤንቲ ባንታዉ ደእያባ ታባ ጎናሽን እስፈ ሻከቶሶና።<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="ACT 2:44-45">ሀዋ 2:44-45</ref>.</char></note> <verse eid="ACT 4:32"/><verse number="33" style="v" sid="ACT 4:33"/>ሀዋረት፥ ጎዳ የሱሲ ሀይቆፐ ደንድዳይሳ ግታ ዎልቃን ማርካቶሶና። ፆሳይ ኤንታ ኡባስ አ ኬሀተ ዳርስድ እሚስ። <verse eid="ACT 4:33"/><verse number="34" style="v" sid="ACT 4:34"/>ቢት ዎይኮ ኬ ደኤይሳት ኡባይ ባይዝ ኤክዳ ሚሽያ ኤህያ ግሾ፥ አማነይሳታ ግዶን መቶታንቾይ እሶይካ ባዋ። <verse eid="ACT 4:34"/><verse number="35" style="v" sid="ACT 4:35"/>ሚሸ ኤህድ ሀዋረታስ እሞሶና፤ ሄ ሚሽያ አሳስ ኮሽዳይሳዳ እሱዋስ እሱዋስ ሻክ ሻክ እሜስ።<verse eid="ACT 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36"/>ቆጵሮሳ ጌተትያ በሳን የለትዳ ዮሰፋ ጌተትያ ሌወ ሼሻፐ ግድዳ እሶይ ደኤስ። እያ ሱን ሀዋረት ባርናባሳ (ምን ናአ) ግዶሶና። <verse eid="ACT 4:36"/><verse number="37" style="v" sid="ACT 4:37"/>ባርናባስ ባዉ ደእያ ቢታ ባይዝድ ሚሽያ ኤህድ ሀዋረታስ እሚስ።<verse eid="ACT 4:37"/></para>
  <chapter eid="ACT 4"/>
  <chapter number="5" style="c" sid="ACT 5"/>
  <para style="s1">ሀናንያነ ሳፕሂሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1"/>እስ ሀናንያ ጌተትያ አደይ ባ ማቸ ሳጵርራ ጋደ ባይዝስ። <verse eid="ACT 5:1"/><verse number="2" style="v" sid="ACT 5:2"/>ሄ ባይዝዳ ሚሽያፐ ባ ማችያ ኤርሽን ባጋ አሽድ፥ አትዳይሳ ኤህድ ሀዋረታስ እሚስ።<verse eid="ACT 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3"/>ሽን ጰፅሮስ ሀናንያኮ፥ “ኔኒ ጌሻ አያና ጭማና መላነ ጋድያ ባይዝዳ ሚሽያፐ ሻካዳ አሻና መላ ፃላሄይ ነ ዎዛናን አይስ ገልዴ? <verse eid="ACT 5:3"/><verse number="4" style="v" sid="ACT 5:4"/>ኔኒ ባይዛናፐ ካሰ ጋደይ ነባ ግደነዬ? ቃስ ኔኒ ባይዛ ስምንካ ሚሸይ ነባ ግደነዬ? ያትን፥ ሄሳ መላባ ኦናዉ አይስ ነ ዎዛናን ቆፓዲ? ኔኒ ፆሳ ቦላ ዎርዶታዳሳፐ አትሽን፥ አሳ ቦላ ዎርዶታባካ” ያግስ።<verse eid="ACT 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5"/>ሀናን ሄ ቃላ ስእዳ መላ ኩንድድ ሀይቅስ፤ ሄሳ ስእዳ ኡባይ ዳሮ ያይስ። <verse eid="ACT 5:5"/><verse number="6" style="v" sid="ACT 5:6"/>ናአተ አሳት ሶ ገልድ እያ አሀ ፃፅድ ኤፍድ ሞግዶሶና።<verse eid="ACT 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7"/>ሄ ሳተፐ ጉየ ሀናንያ ማችያ ሄሳ ኤሮና ደአሸ ጰፅሮስ ደእያሱዋ ገላሱ። <verse eid="ACT 5:7"/><verse number="8" style="v" sid="ACT 5:8"/>ጰፅሮስ ኢኮ፥ “ህንተ ጋድያ ሀይሳ መላ ሚሸስ ባይዝደቲ? አነ ታዉ ኦዳ” ያግስ።</para>
  <para style="p" vid="ACT 5:8">እያካ፥ “ኤ፥ ሀይሳ መላ ሚሸስ ባይዝዳ” ያጋሱ።<verse eid="ACT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9"/>ጰፅሮስ ማጫስዉ፥ “ኔራነ ነ አዝናራ ጎዳ አያና ፓጫናዉ አይስ ዞረትደቲ? ሄኮ፥ ነ አዝና ሞግዳ አሳት ካረን ደኦሶና፤ ነናካ ኤንቲ ካረ ከሳና” ያግስ።<verse eid="ACT 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10"/>ማጫስያ ኢራካ ጰፅሮሳ ቶሁዋ ማታን ኩንዳዳ ሀይቃ አጋሱ፤ ናአተት ገልያ ዎደ ሀይቅዳሮ ደምድ ካረ ከስድ፥ እ አዝና ማታን ሞግዶሶና። <verse eid="ACT 5:10"/><verse number="11" style="v" sid="ACT 5:11"/>ኩመ ዎሳ ኬይነ ሄሳ ስእዳ ሀራ አሳ ኡባይ ዳሮ ያይዶሶና።<verse eid="ACT 5:11"/></para>
  <para style="s1">ማላልስያባታነ ማላታታ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12"/>ሀዋረት ዳሮ ማላታታነ ኦራባታ አሳ ግዶን ኦሶና። አማንያ ኡባይ ሶሎሞነ ባራንዳን እስፈ ሺቆሶና። <verse eid="ACT 5:12"/><verse number="13" style="v" sid="ACT 5:13"/>ሀራ አሳፐ ኤንታራ ጋሄታናዉ እስ አስካ ምንቤና፥ ሽን አሳይ ኤንታ ቦንቼስ። <verse eid="ACT 5:13"/><verse number="14" style="v" sid="ACT 5:14"/>አማንያ አደታነ ማጫሳታ ታይቦይ ካሰይሳፈ ዳርሸ ብስ። <verse eid="ACT 5:14"/><verse number="15" style="v" sid="ACT 5:15"/>ሄሳ ግሾ፥ አሳይ ሀርጋንቾታ ሀላንነ አልጋን ቶክድ ጰፅሮስ አያ ዎደ እያ ኩያይ ኤንታፈ እሶታ እሶታ ቦላ ሸምፓና መላ ኦገ ዶናን ከስድ ዎሶና። <verse eid="ACT 5:15"/><verse number="16" style="v" sid="ACT 5:16"/>ቃስ ዳሮ አሳይ የሩሳላመ ማታን ደእያ ካታማታፐ ሀርጋንቾታነ ቱና አያን ዋይስያ አሳታ ኤክድ ዮሶና፤ ኡባይካ ፓፅዶሶና።<verse eid="ACT 5:16"/></para>
  <para style="s1">ሀዋረታ ቦላ ጎድ ደንድስ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17"/>ካህነ ሀላቃይነ እያራ ደእያ ሳዱቃወት ኡባይ ቃናተን ኩምድ ሀዋረታ ቦላ ደንድዶሶና። <verse eid="ACT 5:17"/><verse number="18" style="v" sid="ACT 5:18"/>ሀዋረታ ኦይክድ ደርያ ቃሾ ኬን የግዶሶና። <verse eid="ACT 5:18"/><verse number="19" style="v" sid="ACT 5:19"/>ሽን ጎዳ ኪታንቾይ ቃማ ቃሾ ኬ ፐንግያ ዶይድ ሀዋረታ ካረ ከስድ፥ <verse eid="ACT 5:19"/><verse number="20" style="v" sid="ACT 5:20"/>“ብድ፥ ፆሳ ኬን ኤቅድ ሀ ኦራ ደኦ ቃላ አሳ ኡባስ ኦድተ” ያግስ። <verse eid="ACT 5:20"/><verse number="21" style="v" sid="ACT 5:21"/>ሀዋረት ሄሳ ስእዳ ዎደ ዎንታ ጉራ ፆሳ ኬ ገልድ ታማርሶ ዶምዶሶና።</para>
  <para style="p" vid="ACT 5:21">ካህነታ ሀላቃይነ እያራ ደኤይሳት ይድ፥ እስራኤለ ጭማታ ኡባ ፄግ ሺሽድ ሀዋረታ ባንታ ስን ኤሀና መላ ዎታዳረታ ቃሾ ኬ ኪትዶሶና። <verse eid="ACT 5:21"/><verse number="22" style="v" sid="ACT 5:22"/>ሽን ዎታዳረት ቃሾ ኬ ብድ ሀዋረታ ደምቦኮና። ጉየ ስም ይድ ደርያስ፥ <verse eid="ACT 5:22"/><verse number="23" style="v" sid="ACT 5:23"/>“ኑኒ ብያ ዎደ ቃሾ ኬ ፐንገይ ምን ጎርደትን፥ ናገይሳት ፐንገን ኤቅዳይሳታ ደምዳ። ሽን ኑኒ ካርያ ዶይያ ዎደ ግዶን ሀር አቶሽን እስ አስካ ባዋ” ያግዶሶና። <verse eid="ACT 5:23"/><verse number="24" style="v" sid="ACT 5:24"/>ሄሳ ግሾ፥ ፆሳ ኬ ዎታዳረታ ኪተይስነ ካህነ ሀላቃት ሄሳ ስእዳ ዎደ፥ “ሀዋረታ ቦላ አይብ ሀንዴ?” ያግድ ህርግዶሶና።<verse eid="ACT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 5:25"/>ሄ ዎደ እስ አደይ ኤንታኮ ይድ፥ “ሄኮ፥ ቃሾ ኬ ህንተ ገልስዳ አሳት ፆሳ ኬን ኤቅድ አሳ ታማርሶሶና” ያግድ ኤንታዉ ኦድስ። <verse eid="ACT 5:25"/><verse number="26" style="v" sid="ACT 5:26"/>ፆሳ ኬ ዎታዳረታ ኪተይስ ባ ዎታዳረታራ ብድ ሀዋረታ ኤህስ። ሽን ኤንቲ ባንታና አሳይ ሹቻን ጫዳና ግድ ያይዳ ግሾ ኤንታ አዳሽድ ኤህዶሶና።<verse eid="ACT 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27"/>ኤንቲ ሀዋረታ ኤህድ፥ ሺቅዳ ሻንጉዋ ስንን ኤስን ካህነ ሀላቃይ ኤንታኮ፥ <verse eid="ACT 5:27"/><verse number="28" style="v" sid="ACT 5:28"/>“ህንተና ኑኒ ሄ ኡራ ሱንን ታማርሶና መላ ምንድ ኪትቦኮ? ሄኮ፥ ህንተ ትምርትያ የሩሳላመ ካታማ ኡባ ጋደታ። ሄ ኡራ ሸምፑዋስ ኑና ኦይናዉ ቆፔቲ?” ያግድ ኦይችስ።<note caller="-" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">ማቶ 27:25</ref>.</char></note><verse eid="ACT 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29"/>ጰፅሮሳራነ ሀንኮ ሀዋረታራ ኤንታዉ ዛርሸ፥ “ኑኒ አሳስ ኪተታናፐ ፆሳስ ኪተታናዉ በሴስ። <verse eid="ACT 5:29"/><verse number="30" style="v" sid="ACT 5:30"/>ማስቃልያ ቦላ ህንተ ካቅድ ዎዳ የሱሳ፥ ኑ አዋታ ፆሳይ ሀይቆፐ ደንስ። <verse eid="ACT 5:30"/><verse number="31" style="v" sid="ACT 5:31"/>እስራኤለት ናጋራፐ ስማና መላነ ኤንታ ናጋራይ አቶ ጌተታና መላ ፆሳይ የሱሳ ሃረይሳነ አሸይሳ ኦድ ቦንቾን ባፐ ኡሻቻ ባጋን ኡትስስ። <verse eid="ACT 5:31"/><verse number="32" style="v" sid="ACT 5:32"/>ሄሳስ ኑኒ ማርካ፤ ቃስ ፆሳይ ባና አማነይሳታስ እምዳ ጌሻ አያናይካ ማርካ” ያግዶሶና።<verse eid="ACT 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33"/>ሺቅዳ አሳይ ሄሳ ስእዳ ዎደ ዳሮ ይሎትድ፥ ሀዋረታ ዎናዉ ቆፕዶሶና። <verse eid="ACT 5:33"/><verse number="34" style="v" sid="ACT 5:34"/>ሽን አሳ ኡባን ዳሮ ቦንቸትዳ ጋማልያለ ጌተተይስ፥ እስ ህገ አስታማረይነ ፋርሳወይ ደንድ ኤቅድ ሀዋረታ ጉ ዎደስ ካረ ከሳና መላ ኪትስ። <verse eid="ACT 5:34"/><verse number="35" style="v" sid="ACT 5:35"/>ሄሳፈ ጉየ፥ ሺቅዳ አሳኮ፥ “እስራኤለ አሳዉ፥ ሀ አሳታ ቦላ ህንተ ኦናዉ ቆፕያባፐ ናገትተ። <verse eid="ACT 5:35"/><verse number="36" style="v" sid="ACT 5:36"/>አይስ ጊኮ፥ ሀይሳፈ ካሰ ተዎዳስ ባና፥ ‘ታኒ ግታ’ ግድ ደንድን፥ ኦይዱ ፄቱ ግድያ አሳት እያራ እስፍዶሶና። ሽን እያ ዎን እያ ካልዳ ኡባይ ላለትን ፓና አስ ግድድ አትዶሶና። <verse eid="ACT 5:36"/><verse number="37" style="v" sid="ACT 5:37"/>ሄሳፈ ጉየ፥ አሳይ ታይበትያ ዎደ ጋልላ ይሁድ ደንድድ ዳሮ አሳ ፓንጋይድ ካለስ፥ ሽን እያካ ዎን እያ ካልዳ አሳ ኡባይ ላለትስ። <verse eid="ACT 5:37"/><verse number="38" style="v" sid="ACT 5:38"/>ሀእካ ታ ህንተዉ ኦዳይስ፤ ሀ አሳታፐ ሻከትተ፤ ኤንታ ቦቾፍተ። አይስ ጊኮ፥ ሀ ቆፋነ ሀ ኦሱዋ አስ ኦያባ ግድኮ ያና። <verse eid="ACT 5:38"/><verse number="39" style="v" sid="ACT 5:39"/>ሽን ሀ ቆፋይነ ሀ ኦሶይ ፆሳፈ ይዳባ ግድኮ፥ ህንተ ኤንታ ይሳናዉ ዳንዳኤከታ። ሄሳዳ ሀንሸ ህንተ ፆሳራ ካጨታና” ያግድ ኦድስ። ሄሳ ግሾ፥ ሺቅዳ አሳይ ጋማልያለ ዞርያ ኤክዶሶና።<verse eid="ACT 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40"/>ሀዋረታ ሶ ፄግድ ልሶን ጋራፍስስ። ሄሳፈ ጉየ፥ ኤንታኮ፥ “የሱሳ ሱን ናምአን ደንፍተ” ግድ ብርሽድ የድዶሶና። <verse eid="ACT 5:40"/><verse number="41" style="v" sid="ACT 5:41"/>የሱሳ ሱን ግሾ፥ ኤንቲ ካዉያናይስ በሲያባ ግደይሳ ኤርዳ ግሾ ሻንጉዋ ስንፈ ኡፋይትሸ ከይዶሶና። <verse eid="ACT 5:41"/><verse number="42" style="v" sid="ACT 5:42"/>ኤንቲ ኡባ ጋላስ ፆሳ ኬንነ አሳ ሶን የሱሲ እ ክርስቶሳ ግደይሳ ታማርሶነ ሳባኮ አግቦኮና።<verse eid="ACT 5:42"/></para>
  <chapter eid="ACT 5"/>
  <chapter number="6" style="c" sid="ACT 6"/>
  <para style="s1">ላፑን አሳታ ዶረተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1"/>ሄ ዎደ ካለይሳታ ታይቦይ ዳር ዳርድ ብሽን፥ ግርከ ዶና ኦደትያ አይሁደት ይሁዳን የለትድ ደእያ አይሁደታ ቦላ ዙዙምዶሶና። አይስ ጊኮ፥ ግርከ ዶና ኦደትያ አይሁደት፥ “ጋላስ ጋላስ እመትያ ካን ኑ አምኤት ናቀቶሶና” ያግዶሶና። <verse eid="ACT 6:1"/><verse number="2" style="v" sid="ACT 6:2"/>ታማነ ናምኡ ሀዋረት ዎሳ ኬ አሳ ኡባ ፄግድ፥ “ኑኒ ፆሳ ቃላ ኦደይሳ አግድ ካ ግሻናዉ በሰና። <verse eid="ACT 6:2"/><verse number="3" style="v" sid="ACT 6:3"/>ህዛ፥ እሻቶ፥ ሎኦ አሳታ፥ ጌሻ አያናንነ ጭንጫተን ኩምዳ ላፑን አሳታ ህንተ ግዶፈ ዶርተ፤ ኑኒ ኤንታ ሀ ኦሱዋስ ሹማና። <verse eid="ACT 6:3"/><verse number="4" style="v" sid="ACT 6:4"/>ሽን ኑኒ፥ ኑ ኩመ ዎድያ ዎሳንነ ቃላ ታማርሶን ፔሻና” ያግዶሶና።<verse eid="ACT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5"/>ሀዋረት ኦድዳ ኦዳይ አሳ ኡባ ኡፋይስስ። ሄሳ ግሾ፥ አማኖይነ ጌሻ አያን ኩምዳ እስፅፋኖሰ፥ ፍልጶሳ፥ ጵሮኮሮሳ፥ ንቃሮና፥ ፅሞና፥ ጳርመናነ አይሁደ አማኖ ገል ስምዳ አንፆከ አድያ ንቆላዎሳ ዶርዶሶና። <verse eid="ACT 6:5"/><verse number="6" style="v" sid="ACT 6:6"/>ኤንታ ሀዋረታ ስንን ኤስን፥ ሀዋረት ኤንታ ቦላ ኩሸ ዎድ ዎስዶሶና።<verse eid="ACT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7"/>ፆሳ ቃላይ ዳልግ ዳልግ ብስ። የሩሳላመን ደእያ አማነይሳታ ታይቦይ ዳር ዳርድ ብስ፤ ዳሮ ካህነትካ አማንዶሶና።<verse eid="ACT 6:7"/></para>
  <para style="s1">እስፅፋኖሰይ ኦይከትስ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8"/>እስፅፋኖሰይ አ ኬሀተንነ ዎልቃን ኩምድ አሳ ግዶን ኦራባታነ ማላታታ ኦስ። <verse eid="ACT 6:8"/><verse number="9" style="v" sid="ACT 6:9"/>አይለተፈ ከይዳ አይሁደ ዎሳ ኬ አሳይ ቀሬናፐነ እስክንድረፐ ክልቀፈነ ኢሰፐ ይዳ እስ እስ አሳት ደንድድ እስፅፋኖሰራ ፓላምዶሶና። <verse eid="ACT 6:9"/><verse number="10" style="v" sid="ACT 6:10"/>ሽን እስፅፋኖሰይ አያና ዎልቃን ኦደትያ ጭንጫተ ኤንቲ ኤቀታናዉ ዳንዳእቦኮና።<verse eid="ACT 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11"/>ሄ ዎደ ኤንቲ፥ “ሙሰነ ፆሳ እ ጫይሽን ስእዳ” ግያ ዎርዶ አሳታ ሻምዶሶና። <verse eid="ACT 6:11"/><verse number="12" style="v" sid="ACT 6:12"/>ሄሳዳ ኦድ ቢታ ጭማታነ ህገ አስታማረታ እያ ቦላ ደንዶሶና። እስፅፋኖሰ ኦይክድ ሻንጉዋ ስን ኤፍዶሶና። <verse eid="ACT 6:12"/><verse number="13" style="v" sid="ACT 6:13"/>እያ ቦላ ፓይድዳ ዎርዶ ማርካት፥ “ሀ ኡራይ ሀ ፆሳ ኬነ ሙሰ ህግያ ዛር ዛር ጫዬስ። <verse eid="ACT 6:13"/><verse number="14" style="v" sid="ACT 6:14"/>እ፥ ‘ሀይስ ናዝረተ የሱሲ፥ ሀ ፆሳ ኬ ላላና፤ ቃስ ሙሰይ ኑስ እምዳ ህግያ ላማና’ ያግሽን ኑኒ ስእዳ” ያግዶሶና።<verse eid="ACT 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15"/>ሻንጎ ሺቆን ኡትዳ አሳ ኡባይ እስፅፋኖሰ ሎይድ ፄልያ ዎደ እያ ሶምኦይ ኪታንቾ ሶምኦ ዳኔስ።<verse eid="ACT 6:15"/></para>
  <chapter eid="ACT 6"/>
  <chapter number="7" style="c" sid="ACT 7"/>
  <para style="s1">እስፅፋኖሰ ሃሳያ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1"/>ካህነታ ሀላቃይ እስፅፋኖሰኮ፥ “ሀይስ ቱሜ?” ያግድ ኦይችስ።<verse eid="ACT 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2"/>እስፅፋኖሰይ፥ “ታ እሻቶ፥ ታ አዋቶ፥ ስእተ! ኑ አዋ አብራሃመይ ካራነን ዳናዉ ባናፐ ስን ማሰጰፆመን ደእሽን፥ ቦንቾ ፆሳይ እያዉ ቆንጭድ፥<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="GEN 12:1">መ 12:1</ref>.</char></note> <verse eid="ACT 7:2"/><verse number="3" style="v" sid="ACT 7:3"/>‘ነ ቢታፈነ ነ ዳቦታፐ ሻከታዳ ታኒ ነና በሲያ ቢታ ባ’ ያግስ። <verse eid="ACT 7:3"/><verse number="4" style="v" sid="ACT 7:4"/>ሄ ዎደ አብራሃመይ ካልዳወታ ቢታፈ ከይድ ካራነን ዳናዉ ብስ። እያ አዋይ ሀይቅዳፐ ጉየ ፆሳይ እያ ሀ ቢታ ሀእ ህንተ ደእያ በሳ ኤህስ።<note caller="-" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="GEN 11:31">መ 11:31</ref>፤ <ref loc="GEN 12:4">12:4</ref>.</char></note> <verse eid="ACT 7:4"/><verse number="5" style="v" sid="ACT 7:5"/>እ ሀ ቢታፈ ሀር አቶሽን ቶሆይ የያ በስካ አብራሃመስ እምቤና። ሽን ናእ እያዉ ባይና ዎደ ፆሳይ ሀ ቢታ እያዉነ እያ ሼሻስ ላታ ኦድ እማናይሳ ቃላ ገልስ።<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="GEN 12:7">መ 12:7</ref>፤ <ref loc="GEN 13:15">13:15</ref>፤ <ref loc="GEN 15:18">15:18</ref>፤ <ref loc="GEN 17:8">17:8</ref>.</char></note> <verse eid="ACT 7:5"/><verse number="6" style="v" sid="ACT 7:6"/>ፆሳይ አብራሃመኮ፥ ‘ነ ሼሻይ ሀራ ቢታን እማተን ዳና፤ ያን ኦይዱ ፄቱ ላይ ኤንቲ አይለተን ሃረታና።<note caller="-" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="GEN 15:13-14">መ 15:13-14</ref>.</char></note> <verse eid="ACT 7:6"/><verse number="7" style="v" sid="ACT 7:7"/>ሽን ታኒ ነ ሼሻ ሃርያ ካዎተታ ፕርዳና። ሄሳፈ ጉየ፥ ኤንቲ ሄ ቢታፈ ከይድ ሀይሳን ታዉ ጎይናና’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="EXO 3:12">ከሳ 3:12</ref>.</char></note> <verse eid="ACT 7:7"/><verse number="8" style="v" sid="ACT 7:8"/>ፆሳይ አብራሃመ ሼሻይ ቃፃረታና መላ እያራ ጫቅን፥ ይሳቅ የለትዳ ሆስፑን ጋላሳን ቃፃርስ። ይሳቅ ያይቆባ ቃፃርስ፤ ቃስ ያይቆብ ታማነ ናምኡ ባ ናይታ፥ ኑ አዋታ ማይዛታ ቃፃርስ።<note caller="-" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="GEN 17:10-14">መ 17:10-14</ref>፤ <ref loc="GEN 21:2-4">21:2-4</ref>፤ <ref loc="GEN 25:26">25:26</ref>፤ <ref loc="GEN 29:31-35">29:31-35</ref>.</char></note><verse eid="ACT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9"/>“ያይቆባ ናይት ዮሰፋ ቃናትድ ግብፀ ቢታን አይለተስ ባይዝዶሶና፥ ሽን ፆሳይ እያራ ደኤስ።<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="GEN 37:11">መ 37:11</ref>፥ <ref loc="GEN 37:28">28</ref>፤ <ref loc="GEN 39:2">39:2</ref>፥ <ref loc="GEN 39:21">21</ref>.</char></note> <verse eid="ACT 7:9"/><verse number="10" style="v" sid="ACT 7:10"/>እያ፥ እያ ዋየ ኡባፈ ከስስ። ግብፀ ካዋ ስንን ሳባነ ጭንጫተ እያዉ እሚስ። ግብፀ ካዎይ ዮሰፋስ ግብፀ ቢታነ ባ ጋዋ ኡባ አይሳናዳ አዋተ እሚስ።<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="GEN 41:39-41">መ 41:39-41</ref>.</char></note><verse eid="ACT 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11"/>“ግብፀ ቢታንነ ካናነ ቢታን ኡባን ኮሽ ገልድ ዳሮ አሳ ኡንኤስ። ሄ ዎደ ኑ ማይዛት ካ ደማናዉ ዳንዳእቦኮና።<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="GEN 42:1-2">መ 42:1-2</ref>.</char></note> <verse eid="ACT 7:11"/><verse number="12" style="v" sid="ACT 7:12"/>ያይቆብ ግብፀ ቢታን ካ ደኤይሳ ስእድ ኑ አዋታ ኮይሮ ያ የድስ። <verse eid="ACT 7:12"/><verse number="13" style="v" sid="ACT 7:13"/>ናምአን ቡሳን ዮሰፍ ባ እሻታስ ባናተ ኤርስስ። ግብፀ ካዎይካ ዮሰፋ ሶ አሳ ኤርስ።<note caller="-" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="GEN 45:1">መ 45:1</ref>፥ <ref loc="GEN 45:16">16</ref>.</char></note> <verse eid="ACT 7:13"/><verse number="14" style="v" sid="ACT 7:14"/>ዮሰፍ ባ አዋ ያይቆባነ ባ ሶ አሳ ኡባ፥ ላፑን ታማነ እቻሹ አሳ ባኮ ያና መላ ኪትድ ኤህስስ።<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="GEN 45:9-10">መ 45:9-10</ref>፥ <ref loc="GEN 45:17-18">17-18</ref>፤ <ref loc="GEN 46:27">46:27</ref>.</char></note> <verse eid="ACT 7:14"/><verse number="15" style="v" sid="ACT 7:15"/>ያይቆብ ግብፀ ቢታ ዎስ፤ እነ እያ ናይት ያን ሀይቅዶሶና።<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GEN 46:1-7">መ 46:1-7</ref>፤ <ref loc="GEN 49:33">49:33</ref>.</char></note> <verse eid="ACT 7:15"/><verse number="16" style="v" sid="ACT 7:16"/>ኤንታ አሀይ ሄ በሳፈ ሴከማ ቢታ ቶከትድ ብድ፥ ያን አብራሃመይ ሀሞረ ናይታፐ ዳሮ ብራን ሻምዳ ዱፎን ሞገትስ።<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="GEN 23:3-16">መ 23:3-16</ref>፤ <ref loc="GEN 33:19">33:19</ref>፤ <ref loc="GEN 50:7-13">50:7-13</ref>.</char></note><verse eid="ACT 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17"/>“ሽን ፆሳይ አብራሃመስ እማና ግዳይሳ ፖልያ ዎደይ ጋካናዉ ማትዳ ዎደ ግብፀ ቢታን ደእያ ኑ አሳይ ዳር ዳር ብስ።<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="EXO 1:7-8">ከሳ 1:7-8</ref>.</char></note> <verse eid="ACT 7:17"/><verse number="18" style="v" sid="ACT 7:18"/>ሄሳፈ ጉየ፥ ዮሰፋ ኤሮና ሀራ ካዎይ ግብፀ ቢታን ካዎትስ። <verse eid="ACT 7:18"/><verse number="19" style="v" sid="ACT 7:19"/>ሄ ካዎይ ኑ ኮቻ ገንድ ጉ ናይት ሀይቃና መላ ኤንታ ካረ ከስ የጋና መላ ኑ አዋታ ኡንኤስ።<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="EXO 1:10-11">ከሳ 1:10-11</ref>፥ <ref loc="EXO 1:22">22</ref>.</char></note><verse eid="ACT 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20"/>“ሄ ዎደ ሙሰይ የለትስ፤ እ ፆሳ ስንን ዳሮ ሎኦ ናአ። ባ አዋ ኬን ሄ አጌና ጋካናዉ ድጭስ።<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="EXO 2:2">ከሳ 2:2</ref>.</char></note> <verse eid="ACT 7:20"/><verse number="21" style="v" sid="ACT 7:21"/>ሙሰይ ዎራ ሆለትዳ ዎደ ግብፀ ካዋ ናእያ ደማ ኤካዳ ባ ናአ ኦዳ እያ ድቻሱ።<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="EXO 2:3-10">ከሳ 2:3-10</ref>.</char></note> <verse eid="ACT 7:21"/><verse number="22" style="v" sid="ACT 7:22"/>ሙሰይ ግብፀታ ጭንጫተ ኡባ ታማርድ ኦዳንነ ኦሶን ምኖ አስ ግድስ።<verse eid="ACT 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23"/>“ሙሰስ ላይ ኦይታማ ኩምዳ ዎደ ባ እሻታ፥ እስራኤለታ በአናዉ ባ ዎዛናን ቆፕስ።<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="EXO 2:11-15">ከሳ 2:11-15</ref>.</char></note> <verse eid="ACT 7:23"/><verse number="24" style="v" sid="ACT 7:24"/>እስራኤለታፐ እሱዋ ግብፀ እሶይ ቆህሽን በእድ ሄ እስራኤለ ኡራ ማድድ፥ ሄ ቆህዳ ግብፀ ኡራ ዎድ ኩሸ ዛርስ። <verse eid="ACT 7:24"/><verse number="25" style="v" sid="ACT 7:25"/>ሙሰይ ባ እሻታ ባ ባጋራ ፆሳይ አሻናዉ ሀነይሳ ኤንቲ አኬካና ግድ ቆፕስ፥ ሽን ኤንቲ አኬክቦኮና።<verse eid="ACT 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 7:26"/>“ዎንተ ጋላስ ናምኡ እስራኤለ አሳት እሶይ እሱዋራ ዋትሽን ደምድ ኤንታ ስገናዉ ኮይድ፥ ‘አሳዉ፥ ህንተ እሻንታ፤ አይስ እሶይ እሱዋ ቆሄቲ?’ ያግስ።<verse eid="ACT 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27"/>“ሽን ባ ላግያ ቆሄይስ ሙሰኮ፥ ‘ነና ኑ ቦላ ሃረይሳነ ዳይና ኦዳይ ኦኔ? <verse eid="ACT 7:27"/><verse number="28" style="v" sid="ACT 7:28"/>ኔኒ ዝነ ግብፀ ኡራ ዎዳይሳዳ ታናካ ዎናዉ ኮያይ?’ ያግድ ሙሰ ሱግ የድስ። <verse eid="ACT 7:28"/><verse number="29" style="v" sid="ACT 7:29"/>ሙሰይ ሄሳ ስእዳ ዎደ ግብፀፈ በትድ ምድያመ ቢታን በተ አስ ግድድ ደእሸ ናምኡ አደ ናይታ የልስ።<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="EXO 18:3-4">ከሳ 18:3-4</ref>.</char></note><verse eid="ACT 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30"/>“ጎዳ ኪታንቾይ ኦይታሙ ላይፈ ጉየ፥ ሲና ዙማ ማታን ደእያ ባዞ ቱሽያ ግዶን ኤፅያ ታማ ላጮ ግዶን ሙሰስ በንትስ።<note caller="-" style="x"><char style="xo" closed="false">7:30 </char><char style="xt" closed="false"><ref loc="EXO 3:1-10">ከሳ 3:1-10</ref>.</char></note> <verse eid="ACT 7:30"/><verse number="31" style="v" sid="ACT 7:31"/>ሙሰይ ባ በእዳይሳን ማላለትድ፥ ሎይ በአናዉ ቱሽያ ማት ሺቅድ ደእሽን፥ ጎዳ ቃላይ፥ <verse eid="ACT 7:31"/><verse number="32" style="v" sid="ACT 7:32"/>‘ታኒ ነ አዋታ፥ አብራሃመ ፆሳ፥ ይሳቃ ፆሳ፥ ያይቆባ ፆሳ’ ያግሸ ሙሰኮ ይስ። ሙሰይ ያሻን ኮኮርድ ፄላናዉ ዳንዳእቤና።<verse eid="ACT 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33"/>“ጎዳይ ሙሰኮ፥ ‘ኔኒ ኤቅዳ ቢታይ ጌሽ ግድያ ግሾ ነ ቶሁዋን ደእያ ጫማ ከሳ። <verse eid="ACT 7:33"/><verse number="34" style="v" sid="ACT 7:34"/>ታኒ ግብፀን ደእያ ታ አሳ ኡንኤተ በአስ። ኤንታ ዋሱዋ ስአዳ ኤንታ አሻናዉ ዎስ። ሀእ ሃያ! ታኒ ነና ግብፀ ኪታና’ ያግስ።<verse eid="ACT 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35"/>“እስራኤለት ሙሰ፥ ‘ነና ኑ ቦላ ሃረይሳነ ዳይና ኦዳይ ኦኔ?’ ያግድ እፅዳይሳ ቱሽያ ግዶን እያዉ በንትዳ ኪታንቹዋ ባጋራ ሃረይሳነ አሸይሳ ኦድ ፆሳይ ኪትስ።<note caller="-" style="x"><char style="xo" closed="false">7:35 </char><char style="xt" closed="false"><ref loc="EXO 2:14">ከሳ 2:14</ref>.</char></note> <verse eid="ACT 7:35"/><verse number="36" style="v" sid="ACT 7:36"/>ሄ ሙሰይ እስራኤለታ ግብፀፈ ከስድ ማላልስያባታነ ኦራባታ ግብፀ ቢታንነ ዞኦ አባን ኦድ ኤንታ ኦይታሙ ላይ መላ ቢታን ካለስ።<note caller="-" style="x"><char style="xo" closed="false">7:36 </char><char style="xt" closed="false"><ref loc="EXO 7:5">ከሳ 7:5</ref>፤ <ref loc="EXO 14:21">14:21</ref>፤ <ref loc="NUM 14:33">ታይቦ 14:33</ref>.</char></note><verse eid="ACT 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37"/>“እስራኤለ አሳኮ፥ ‘ፆሳይ ታና ደንዳይሳዳ ህንተ ሼሻ ግዶፈ ታ መላ ናበ ህንተዉ ደንና’ ያግዳይ ሄ ሙሰ።<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="DEU 18:15">ዛረ 18:15</ref>፥ <ref loc="DEU 18:18">18</ref>.</char></note> <verse eid="ACT 7:37"/><verse number="38" style="v" sid="ACT 7:38"/>መላ ቢታን ሺቅዳ እስራኤለ አሳራ ደእዳይስ፥ ኑ አዋታራነ ሲና ዙማ ቦላ እያዉ ኦድዳ ኪታንቹዋራ ደእዳ ሙሰይ እያ። ያትድ፥ ፆሳ ደኦ ቃላ ኑስ እማናዉ ኤክስ።<note caller="-" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EXO 19:1-20:17">ከሳ 19:1—20:17</ref>፤ <ref loc="DEU 5:1-33">ዛረ 5:1-33</ref>.</char></note><verse eid="ACT 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39"/>“ሽን ኑ ማይዛት ሙሰስ ኪተታናዉ ዶስቦኮና፤ እያ እፅድ ጉየ ግብፀ ስማናዉ አሞትዶሶና። <verse eid="ACT 7:39"/><verse number="40" style="v" sid="ACT 7:40"/>ቃስ አሮናኮ፥ ‘ኑና ካለያ ፆሳታ ኑስ ኦ። አይስ ጊኮ፥ ሀይስ ኑና ግብፀፈ ኤህዳ ሙሰይ፥ ዋንዳኮ ኑኒ ኤሮኮ’ ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="EXO 32:1">ከሳ 32:1</ref>.</char></note> <verse eid="ACT 7:40"/><verse number="41" style="v" sid="ACT 7:41"/>ሄ ዎደ ማር ዳንስድ ኤቃ ኦዶሶና። ሄ ኤቃስ ያርሾ ያርሽድ ባንታ ኩሸን ኦዳ ኦሱዋን ኡፋይትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">7:41 </char><char style="xt" closed="false"><ref loc="EXO 32:2-6">ከሳ 32:2-6</ref>.</char></note> <verse eid="ACT 7:41"/><verse number="42" style="v" sid="ACT 7:42"/>ሽን ፆሳይ ኤንታዉ ዞኮ ዛርስ። ኤንቲ ሳሉዋ ፆልንቶታስ ጎይናና መላ ኤንታ የግ አግስ። ናበታ ማፃፋን፥</para>
  <para style="q1" vid="ACT 7:42">“ ‘እስራኤለ አሳቶ ኦይታሙ ላይ ኩመ</para>
  <para style="q2" vid="ACT 7:42">መላ ቢታን ሹክዳ መህያነ</para>
  <para style="q2" vid="ACT 7:42">ያርሽዳ ያርሹዋ ታዉ ያርሽደቲ?<note caller="-" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="AMO 5:25-27">አሞ 5:25-27</ref>.</char></note><verse eid="ACT 7:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43"/>ህንተ፥ ህንተዉ ጎይናናዉ ከስዳ ኤቃነ ሞሎካ ዱንካንያ</para>
  <para style="q2" vid="ACT 7:43">ራፋና ጌተትያ ህንተ ፆሳ ፆልንቶ ምስልያ ቶክደታ።</para>
  <para style="q1" vid="ACT 7:43">ታኒ ህንተና ባብሎነፐ</para>
  <para style="q2" vid="ACT 7:43">ህን ባጋ የዳና’ ጌተትድ ፃፈትስ።<verse eid="ACT 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44"/>“ኑ አዋታስ መላ ቢታን ማርካ ዱንካነይ ደኤስ። እያካ ፆሳይ ሙሰ ኪትዳይሳዳነ እያ በስዳይሳዳ ኦስ።<note caller="-" style="x"><char style="xo" closed="false">7:44 </char><char style="xt" closed="false"><ref loc="EXO 25:9">ከሳ 25:9</ref>፥ <ref loc="EXO 25:40">40</ref>.</char></note> <verse eid="ACT 7:44"/><verse number="45" style="v" sid="ACT 7:45"/>ቃስ ኑ አዋት ሄ ዱንካንያ ባንታ አዋታፐ ኤክድ ፆሳይ ካሰ ጎድዳ አይሁደ ግዶና አሳ ቢታ ኦይክዳ ዎደ እያሱራ ያ ኤክድ ገልዶሶና። ሄ ዱንካነይ ዳዊታ ዎደ ጋካናዉካ ሄ በሳን ደእስ።<note caller="-" style="x"><char style="xo" closed="false">7:45 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">እያ 3:14-17</ref>.</char></note> <verse eid="ACT 7:45"/><verse number="46" style="v" sid="ACT 7:46"/>ዳዊቲ ፆሳን ሳበትስ። ቃስ ያይቆባ ጎዳይ ደአና ኬ ኬፃናዉ ፆሳ ዎስስ።<note caller="-" style="x"><char style="xo" closed="false">7:46 </char><char style="xt" closed="false"><ref loc="2SA 7:1-16">2 ሳሜ 7:1-16</ref>፤ <ref loc="1CH 17:1-14">1 ታር 17:1-14</ref>.</char></note> <verse eid="ACT 7:46"/><verse number="47" style="v" sid="ACT 7:47"/>ሽን እያዉ ኬ ኬፅዳይ ሶሎሞነ።<note caller="-" style="x"><char style="xo" closed="false">7:47 </char><char style="xt" closed="false"><ref loc="1KI 6:1-38">1 ካዎ 6:1-38</ref>፤ <ref loc="2CH 3:1-17">2 ታር 3:1-17</ref>.</char></note><verse eid="ACT 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48"/>“ሀኖሽን፥ ኡባፈ ቦላ ፆሳይ አስ ኬፅዳ ኬን ዴና። ናበይ ግዳይሳ መላ፥<verse eid="ACT 7:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49"/>“ ‘ሳሎይ ታ አራታ፥</para>
  <para style="q2" vid="ACT 7:49">ሳእካ ታ ቶሆይ የያሶ።</para>
  <para style="q1" vid="ACT 7:49">ያትን፥ ታዉ ህንተ አይ መላ ኬ ኬፃኔ?</para>
  <para style="q2" vid="ACT 7:49">ዎይኮ ታኒ ሸምፕያ በሲ አዉኔ?<note caller="-" style="x"><char style="xo" closed="false">7:49 </char><char style="xt" closed="false"><ref loc="ISA 66:1-2">እሳ 66:1-2</ref>.</char></note> <verse eid="ACT 7:49"/><verse number="50" style="v" sid="ACT 7:50"/>ሀ ኡባ ታ ኩሸን ኦብክና?’ ያጌስ ጎዳይ።<verse eid="ACT 7:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51"/>“ህንተ ዋንዳ ስኦና አሴ? ህንተ ዎዛናይ ፆሳ ቃላ ኤካናዉ አይስ እፅዴ? ህንተ ሀይይ አይስ ቱልዴ? ህንተ፥ ህንተ አዋታ ኡባ ዎደ ጌሻ አያናራ ኤቀተታ።<note caller="-" style="x"><char style="xo" closed="false">7:51 </char><char style="xt" closed="false"><ref loc="ISA 63:10">እሳ 63:10</ref>.</char></note> <verse eid="ACT 7:51"/><verse number="52" style="v" sid="ACT 7:52"/>ናበታ ግዶፈ ህንተ አዋት ጎዶናይ ኦኔ? ፆሳ ናአይ፥ ፅሎይ ያናይሳ ካሰትድ ኦድዳይሳታ ዎዶሶና። ሀእ ህንተ እያ አ እምድ ዎደታ። <verse eid="ACT 7:52"/><verse number="53" style="v" sid="ACT 7:53"/>ህንተ ኪታንቹዋ ኩሸፐ ፆሳ ህግያ ኤክደታ፥ ሽን ኪተትበከታ” ያግስ።<verse eid="ACT 7:53"/></para>
  <para style="s1">እስፅፋኖሰ ሹቻን ጫደተ</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54"/>ኤንቲ ሄሳ ስእዳ ዎደ ባንታ ዎዛናን እስፅፋኖሰ ቦላ ዳሮ ይሎትድ፥ ባንታ መተርሻ ሳፅድ ማንድዶሶና። <verse eid="ACT 7:54"/><verse number="55" style="v" sid="ACT 7:55"/>ሽን እስፅፋኖሰይ ጌሻ አያናን ኩምድ፥ ሳሎ ፑደ ፄልድ፥ ፆሳ ቦንቹዋነ የሱሳ፥ ፆሳ ኡሻቻ ባጋን ኤቅዳይሳ በእስ። <verse eid="ACT 7:55"/><verse number="56" style="v" sid="ACT 7:56"/>“ሄኮ፥ ታኒ ሳሎይ ዶየትን፥ አሳ ናአይ፥ ፆሳ ኡሻቻ ባጋን ኤቅዳይሳ በአይስ” ያግስ።<verse eid="ACT 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57"/>ቃላ ቁ ኦድ ዋስሸ፥ ባንታ ሀይ ኦይክድ እስፈ እያኮ ዎፅዶሶና <verse eid="ACT 7:57"/><verse number="58" style="v" sid="ACT 7:58"/>እያ ካታማፐ ጋፃ ከስድ፥ ሹቻን ጫድዶሶና። ማርካት ባንታ ማኡዋ እስ ሳኦላ ጌተትያ ናአተ ማታን ዎዶሶና።<verse eid="ACT 7:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59"/>እስፅፋኖሰይ፥ “ታ ጎዳ የሱሳ፥ ታ ሸምፑዋ ኤካ” ያግድ ፄግሽን ኤንቲ እያ ሹቻን ጫዶሶና። <verse eid="ACT 7:59"/><verse number="60" style="v" sid="ACT 7:60"/>ጉልባትድ፥ ባ ቃላ ቁ ኦድ፥ “ታ ጎዳዉ፥ ሀ ናጋራ ኤንታዉ አቶ ጋ” ያግስ። ሄሳ ያግድ ስምዳ መላ ሀይቅ አግስ።<verse eid="ACT 7:60"/></para>
  <chapter eid="ACT 7"/>
  <chapter number="8" style="c" sid="ACT 8"/>
  <para style="s1">ሳኦል አማንያ አሳ ጎዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1"/>ሳኦል እስፅፋኖሰ ሀይቁዋን ኡፋይትስ። ሄ ጋላስ የሩሳላመን ደእያ ዎሳ ኬን ግታ ጎድ ደንድስ። ሀዋረት አትሽን፥ አማነይሳት ኡባይ ይሁዳ ቢታንነ ሳማረ ቢታን ላለትዶሶና። <verse eid="ACT 8:1"/><verse number="2" style="v" sid="ACT 8:2"/>እስ እስ ፆሳ አሳት እስፅፋኖሰ ሞግዶሶና፤ ቃስ እያዉ ዳሮ ዬክዶሶና። <verse eid="ACT 8:2"/><verse number="3" style="v" sid="ACT 8:3"/>ሽን ሳኦል ዎሳ ኬ ይሳናዉ ኮዬስ። ሶ ሶ ዩይ ገልድ፥ አማንያ አደታነ ማጫሳታ ጎች ጎች ከስድ ቃሾ ኬ ገልሴስ።<note caller="-" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="ACT 22:4-5">ሀዋ 22:4-5</ref>፤ <ref loc="ACT 26:9-11">26:9-11</ref>.</char></note><verse eid="ACT 8:3"/></para>
  <para style="s1">ዎንገል ሳማረ ገልስ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4"/>ላለትዳ አማነይሳት ብዳ በሳ ኡባን ቃላ ኦድዶሶና። <verse eid="ACT 8:4"/><verse number="5" style="v" sid="ACT 8:5"/>ፍልጶስ ሳማረ ካታማ ብድ ክርስቶሳባ አሳስ ኦድስ። <verse eid="ACT 8:5"/><verse number="6" style="v" sid="ACT 8:6"/>ዳሮ አሳይ ፍልጶስ ኦድዳይሳ ስእዳ ዎደነ እ ኦያ ማላታታ በእዳ ዎደ እያ አኬክድ ስእዶሶና። <verse eid="ACT 8:6"/><verse number="7" style="v" sid="ACT 8:7"/>ቱና አያናት ዋስድ ዳሮ አሳፐ ከይዶሶና፤ ቃስ ዳሮ ጉንዳትነ ዎበት ብለትዶሶና። <verse eid="ACT 8:7"/><verse number="8" style="v" sid="ACT 8:8"/>ሄ ካታማን ደእያ አሳይ ዳሮ ኡፋይትዶሶና።<verse eid="ACT 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9"/>ሽን ስሞና ጌተትያ እስ ኡራይ ሄ ካታማን ደኤስ። እ፥ “ባና ግታ” ግድ ሳማረ አሳ ማሮተን ማላልስሸ ጋምእስ። <verse eid="ACT 8:9"/><verse number="10" style="v" sid="ACT 8:10"/>ጉፈ ግታ ጋካናዉ ደእያ አሳ ኡባይ፥ “ግታ ፆሳ ዎልቃይ ሀይሳ” ግድ እያባ ስኦሶና። <verse eid="ACT 8:10"/><verse number="11" style="v" sid="ACT 8:11"/>ዳሮ ዎደፐ ዶምድ ማሮትሸ ሳማረ አሳ ማላልስዳ ግሾ አሳይ እያባ ስኦሶና። <verse eid="ACT 8:11"/><verse number="12" style="v" sid="ACT 8:12"/>ሽን ፍልጶስ ፆሳ ካዎተባነ የሱስ ክርስቶሳ ሱንባ አደታስነ ማጫታስ ኦድን፥ ኤንቲ እያባ አማንድ ፃማቀትዶሶና። <verse eid="ACT 8:12"/><verse number="13" style="v" sid="ACT 8:13"/>ቃስ ስሞንካ ባ ሁጰን አማንድ ፃማቀትስ። ፍልጶሳራ እስፈ ብዳ በሳ ኡባን ኦሰትያ ግታ ማላታታ በእድ ማላለትስ።<verse eid="ACT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14"/>የሩሳላመን ደእያ ሀዋረት ሳማረ አሳይ ፆሳ ቃላ ኤክዳይሳ ስእዳ ዎደ ጰፅሮሳነ ዮሃንሳ ኤንታኮ የድዶሶና። <verse eid="ACT 8:14"/><verse number="15" style="v" sid="ACT 8:15"/>ጰፅሮስነ ዮሃንስ ብድ፥ አማነይሳት ጌሻ አያና ኤካና መላ ኤንታዉ ፆሳ ዎስዶሶና። <verse eid="ACT 8:15"/><verse number="16" style="v" sid="ACT 8:16"/>አይስ ጊኮ፥ ሳማረ አሳት ጎዳ የሱሳ ሱን ፃላላን ፃማቀትዶሶናፐ አትሽን፥ ኤንታፈ እሱዋ ቦላካ ጌሻ አያናይ ዎቤና። <verse eid="ACT 8:16"/><verse number="17" style="v" sid="ACT 8:17"/>ሄ ዎደ ጰፅሮስነ ዮሃንስ ባንታ ኩሸ ኤንታ ቦላ ዎን፥ ኤንቲ ጌሻ አያና ኤክዶሶና።<verse eid="ACT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18"/>ሀዋረት ባንታ ኩሸ ኤንታ ቦላ ዎን፥ ኤንታዉ ጌሻ አያናይ እመትዳይሳ ስሞን በእዳ ዎደ ጰፅሮሳስነ ዮሃንሳስ ሚሸ ኤህድ፥ <verse eid="ACT 8:18"/><verse number="19" style="v" sid="ACT 8:19"/>“ታንካ ታ ኩሸ ዎያ ኡባይ ጌሻ አያና ኤካና መላ ሀ ማታ ታዉ እመርከት” ያግስ።<verse eid="ACT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20"/>ሽን ጰፅሮስ እያኮ፥ “ኔኒ ፆሳ እሞታ ሚሸን ሻማናዉ ቆፕዳ ግሾ ነ ሚሸይ ኔራ ዮ። <verse eid="ACT 8:20"/><verse number="21" style="v" sid="ACT 8:21"/>ነ ዎዛናይ ፆሳ ስንን ሱረ ግዶና ግሾ፥ ነዉ ሀይሳን ግሾይ ዎይኮ ቃድ ባዋ። <verse eid="ACT 8:21"/><verse number="22" style="v" sid="ACT 8:22"/>ህዛ፥ ሀ ነ ዎዛና ኢታተ ግሾ ናጋራፐ ስማ። ነ ዎዛናን ደእያ ኢታ ቆፋ ፆሳይ አቶ ጋና መላ ፆሳ ዎሳ። <verse eid="ACT 8:22"/><verse number="23" style="v" sid="ACT 8:23"/>ጋሶይካ፥ ኔኒ ኢታ ቃናተንነ ናጋራ ቃሾን ደኤይሳ ታኒ በአይስ” ያግስ።<verse eid="ACT 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24"/>ስሞን ዛሪድ፥ “ህንተ ግዳይሳፈ እሶይካ ታና ጋኮና መላ ታዉ ፆሳ ዎስተ” ያግስ።<verse eid="ACT 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25"/>ጰፅሮስነ ዮሃንስ ማርካትዳፐነ ጎዳ ቃላ ኦድዳፐ ጉየ የሩሳላመ ስምዶሶና። ሳማረን ደእያ ዳሮ ጉታታን ዎንገላ ኦድዶሶና።<verse eid="ACT 8:25"/></para>
  <para style="s1">ፍልጶሳነ ቶጰ ሞርና</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26"/>ጎዳ ኪታንቾይ ፍልጶሳኮ፥ “ደንዳዳ የሩሳላመፐ ጋዛ ኤፍያ መላ ቢታ ኦግያኮ ባ። ሄ ኦገይ ዱገሀ ባጋራ ደኤስ” ያግስ። <verse eid="ACT 8:26"/><verse number="27" style="v" sid="ACT 8:27"/>ፍልጶስ ደንድድ ብስ። ህንደከ ጌተትያ ቶጰ ካዌስ እ ሚሸ ኡባ ናግያ ቶጰ አስ ደኤስ። እካ ጎይናናዉ የሩሳላመ ብስ። <verse eid="ACT 8:27"/><verse number="28" style="v" sid="ACT 8:28"/>ፓራ ጋረን ኡትድ፥ የሩሳላመፐ ባ ቢታ ስምሸ ናብያ እሳያሳ ማፃፋ ናባቤስ።<verse eid="ACT 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 8:29"/>ጌሻ አያናይ ፍልጶሳኮ፥ “ሄ ጋርያኮ ባዳ እያ ማት ሺቃ” ያግስ።<verse eid="ACT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30"/>ያትን ፍልጶስ ዎፅ ብድ ጋክያ ዎደ ሞርናይ ናብያ እሳያሳ ማፃፋፐ ናባብሽን ስእድ፥ “ነ ናባበይስ ነዉ ገሊ?” ያግስ።<verse eid="ACT 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31"/>ሞርናይ፥ “ታዉ ኦድ ገልስያ አስ ባይና ዋንድ ገላኔ?” ያግስ። ባራ ጋርያን ከይድ ኡታና መላ ፍልጶሳ ዎስስ። <verse eid="ACT 8:31"/><verse number="32" style="v" sid="ACT 8:32"/>ሞርናይ ናባብያ ማፃፋ ክፍለይ፥<note caller="-" style="x"><char style="xo" closed="false">8:32 </char><char style="xt" closed="false"><ref loc="ISA 53:7-8">እሳ 53:7-8</ref>.</char></note></para>
  <para style="q1" vid="ACT 8:32">“እ ዶርሳዳ ሹከታናዉ ላገትስ፤</para>
  <para style="q2" vid="ACT 8:32">ዶርሳ ማር ባ እክስያ ሜደይሳታ ስንን ስእ ገይሳዳ፥</para>
  <para style="q2" vid="ACT 8:32">እካ ባ ዶና ዶይቤና።<verse eid="ACT 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33"/>እ ካዉይስ፤ እያዉ ፅሎ ፕርድ ይስ፤</para>
  <para style="q2" vid="ACT 8:33">እያ ደኦይ ሀ ሳአፐ ቃንፀትዳ ግሾ፥</para>
  <para style="q2" vid="ACT 8:33">እያ ሼሻባ ኦነ ኦዳናይ?” ያጌስ።<verse eid="ACT 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34"/>ሞርናይ ዛሪድ ፍልጶሳኮ፥ “ናበይ ኦደባ ኦዲ? ባባ ኦድየ ዎይኮ ሀራ አሳባ ኦዲ? ታዉ ኦዳርኪ” ያግስ። <verse eid="ACT 8:34"/><verse number="35" style="v" sid="ACT 8:35"/>ፍልጶስ፥ ፆሳ ቃላ ሄ በሳፈ ዶምድ፥ የሱሳባ ኦድያ ዎንገላ እያዉ ኦድስ።<verse eid="ACT 8:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36"/>ኤንቲ ብሸ ሃ ደእያሶ ጋክዶሶና። ሞርናይ፥ “ሃ ሀይሳ በአ፤ ታ ፃማቀቶና መላ አይበ ድገይ?” ያግስ።<verse eid="ACT 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 8:37"/>ፍልጶስ እያኮ፥ “ኔኒ ነ ኩመ ዎዛናፐ አማንኮ ዳንዳኣሳ” ያግስ።</para>
  <para style="p" vid="ACT 8:37">እ ዛሪድ፥ “የሱስ ክርስቶሲ ፆሳ ናኣ ግደይሳ ታኒ አማናይስ” ያግስ።<verse eid="ACT 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38"/>ጋረይ ኤቃና መላ ሞርናይ ኪትን፥ ናምአይ ዎድ ሃን ገልዶሶና፤ ፍልጶስ እያ ፃማቅስ። <verse eid="ACT 8:38"/><verse number="39" style="v" sid="ACT 8:39"/>ኤንቲ ሃፈ ጋፃ ከይዳ ዎደ ጎዳ አያናይ ፍልጶሳ ቆፖና ኤክስ። ናምአን ሞርናይ ፍልጶሳ በእቤና፥ ሽን ባ ኦግያ ኡፋይትሸ ብስ። <verse eid="ACT 8:39"/><verse number="40" style="v" sid="ACT 8:40"/>ፍልጶስ አዛፆናን ባና ደምስ። ቃስ ቅሳረ ያና ጋካናዉ ካታማታን ዩይድ ዎንገላ ማርካትስ።<verse eid="ACT 8:40"/></para>
  <chapter eid="ACT 8"/>
  <chapter number="9" style="c" sid="ACT 9"/>
  <para style="s1">ሳኦል ክርስቶሳ አማንስ</para>
  <para style="r">(<ref loc="ACT 22:6-16">ሀዋ 22:6-16</ref>፤ <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1"/>ሄ ዎደ ሳኦል ጎዳ ካለይሳታ ዎናዉ ማንድድ ካህነ ሀላቃኮ ብስ። <verse eid="ACT 9:1"/><verse number="2" style="v" sid="ACT 9:2"/>ጎዳ ኦግያ ካልያ አደነ ማጫ ደምኮ፥ ቃችሸ የሩሳላመ ኤሀናዉ፥ ዳማስቆን ደእያ አይሁደ ዎሳ ኬታስ ዳብዳበ ባዉ ፃፋና መላ ዎስስ።<verse eid="ACT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3"/>እ ብድ፥ ዳማስቆ ካታማ ጋካናዉ ማትሽን፥ ቆፖና ሳሎፐ ዎልቃማ ፖኦይ እያ ዩሾን ፖእስ። <verse eid="ACT 9:3"/><verse number="4" style="v" sid="ACT 9:4"/>እ ሳአን ኩንድዳሽን፥ “ሳኦላ፥ ሳኦላ፥ አይስ ታና ጎዳይ?” ግያ ቃላ ስእስ።<verse eid="ACT 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5"/>ሳኦል፥ “ጎዳዉ፥ ኔኒ ኦኔ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="ACT 9:5">“ታኒ፥ ኔኒ ጎድያ የሱሳ” ያግስ።<verse eid="ACT 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 9:6"/>ሽን ሳኦል ኮኮርሸነ ማላለትሸ፥ “ጎዳዉ፥ ታኒ አይ ኦና መላ ኮያይ?” ያግስ።</para>
  <para style="p" vid="ACT 9:6">ጎዳይ እያኮ፥ “ደንዳዳ ካታማ ገላ፤ ኔኒ ኦናዉ በሲያባይ ያን ነዉ ኦደታና” ያግስ።<verse eid="ACT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7"/>ሳኦላራ ኦገ ብያ አሳት አይኮካ ኦደቶና ኤቅ አትዶሶና። ቃላ ስኦሶና፥ ሽን ኦናካ በእቦኮና። <verse eid="ACT 9:7"/><verse number="8" style="v" sid="ACT 9:8"/>ሳኦል ኩንድዳ በሳፈ ደንድድ ፄልያ ዎደ እያ አይፈይ ደሞና እፅስ። ሄሳ ግሾ፥ ኤንቲ እያ ኩሽያ ኦይክድ ካለድ ዳማስቆ ገልስዶሶና። <verse eid="ACT 9:8"/><verse number="9" style="v" sid="ACT 9:9"/>ሄ ጋላስ ጋካናዉ እ ፄላናዉ ዳንዳእቤና፤ አይኮካ ምቤና፤ ኡይቤና።<verse eid="ACT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10"/>ዳማስቆን እስ ሀናንያ ጌተትያ የሱሳ ታማረይ ደኤስ። ጎዳይ ቆንጨን፥ “ሀናንያ” ያግድ ፄግስ።</para>
  <para style="p" vid="ACT 9:10">ሀናን ዛሪድ፥ “ታ ጎዳዉ፥ ሀይሳን ደአይስ” ያግስ።<verse eid="ACT 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11"/>ጎዳይ እያኮ፥ “ደንዳዳ ሱረ ጌተትያ ኦግያ ባዳ፥ ይሁዳ ሶን ሳኦላ ጌተትያ ታርሰሳፐ ይዳ ኡራ ኮያ፤ ሳኦል ዎሴስ። <verse eid="ACT 9:11"/><verse number="12" style="v" sid="ACT 9:12"/>ቃስ ሀናንያ ጌተትያ አደይ ገልድ፥ ሳኦል ናምአን ፄላና መላ ባ ኩሽያ እያ ቦላ ዎሽን ቆንጨን በእስ” ያግስ።<verse eid="ACT 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13"/>ሀናን ዛሪድ፥ “ጎዳዉ፥ የሩሳላመን ነ ጌሻ አሳ ቦላ ሄ ኡራይ አይ መላ ኢታባ ኦዳኮ ታኒ ዳሮ አሳፐ ስአስ። <verse eid="ACT 9:13"/><verse number="14" style="v" sid="ACT 9:14"/>ቃስ ዳማስቆን ነ ሱን ፄገይሳታ ኡባ ቃቻናዉ፥ ካህነ ሀላቃት እያዉ ማታ እምዶሶና” ያግስ።<verse eid="ACT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15"/>ሽን ጎዳይ እያኮ፥ “ሳኦል አይሁደ ግዶና አሳ ስንን፥ ካዎታ ስንንነ እስራኤለ አሳ ስንን፥ ታ ሱን ኤርሳናዉነ ታዉ ኦናዉ ዶረትዳ ሚሸ ግድያ ግሾ ኔኒ እያኮ ባ። <verse eid="ACT 9:15"/><verse number="16" style="v" sid="ACT 9:16"/>አይስ ጊኮ፥ ታ ሱን ግሾ፥ እ አይ መላ ዋየ ኤካናዉ በሲያኮ ታኒ እያ በሳና” ያግስ።<verse eid="ACT 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17"/>ሀናን ብድ፥ ሶ ገልድ፥ ባ ኩሽያ ሳኦላ ቦላ ዎድ፥ “ታ እሻ ሳኦላ፥ ኔኒ ያ ኦግያን ነዉ በንትዳ የሱሲ፥ ኔኒ ፄላና መላነ ጌሻ አያናን ኩማና መላ ጎዳይ ታና ኪትስ” ያግስ። <verse eid="ACT 9:17"/><verse number="18" style="v" sid="ACT 9:18"/>ኤለስድ፥ ሳኦላ አይፈፐ እስ ፖቆ መላባይ ዎን፥ ሳኦል ናምአን ፄልስ። ቃስ ደንድድ ፃማቀትስ። <verse eid="ACT 9:18"/><verse number="19" style="v" sid="ACT 9:19"/>ካ ምድ ፃልድ፥ ዳማስቆን ደእያ አማነይሳታራ ጉ ጋላስ ጋምእስ።<verse eid="ACT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20"/>ኤለስድ ሳኦል፥ “የሱሲ ፆሳ ናአ” ያግድ ዳማስቆን ደእያ አይሁደ ዎሳ ኬታን ቃላ ታማርስስ።<verse eid="ACT 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21"/>ሄሳ ስእዳ ኡባይ ማላለትድ፥ “ሀይስ የሩሳላመን የሱሳ ሱን ፄገይሳታ ቃቸይሳ ግደነዬ? ቃስ ሃ ይዳይ ኤንታ ቃችድ፥ ካህነ ሀላቃታ ስን ኤፋናሳ ግደኔ?” ያግዶሶና።<verse eid="ACT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22"/>ሽን ሳኦል ቃላ ኦዶን ምን ምንድ ብስ። የሱሲ፥ እ ክርስቶሳ ግደይሳ ቆንጭስድ ኦድዳ ግሾ ዳማስቆን ደእያ አይሁደት እያዉ ዛርያባ ይዶሶና።<verse eid="ACT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23"/>ዳሮ ጋላሳፐ ጉየ፥ አይሁደት ሺቅድ፥ ሳኦላ ዎናዉ ዞረትዶሶና።<note caller="-" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="2CO 11:32-33">2 ቆሮ 11:32-33</ref>.</char></note> <verse eid="ACT 9:23"/><verse number="24" style="v" sid="ACT 9:24"/>ሽን አይሁደት ባና ዎናዉ ቆፕዳይሳ ሳኦል ስእስ። ኤንቲ እያ ዎናዉ ቃማነ ጋላስ ካታማ ፐንገን ናጎሶና። <verse eid="ACT 9:24"/><verse number="25" style="v" sid="ACT 9:25"/>ሽን እያ ታማረት እያ ቃማ ኤፍድ፥ ግምበ ድርሳ ማስኮተራ ዳቾራ ዎስዶሶና።<verse eid="ACT 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26"/>ሳኦል የሩሳላመ ጋክዳ ዎደ አማነይሳታራ ጋሄታናዉ ኮይስ። ሽን እ ክርስቶሳ አማንዳይስ ኤንታዉ ቱማ ዳኖና እፅን እያዉ ያይዶሶና። <verse eid="ACT 9:26"/><verse number="27" style="v" sid="ACT 9:27"/>ሽን ባርናባስ ሳኦላ ሀዋረታኮ ኤፍስ። ኦገን ጎዳይ ዋንድ ቆንጭዳኮነ ኦድስዳኮ፥ ቃስ ሳኦል ዳማስቆን የሱሳ ሱንን ያዮና ዋትድ ቃላ ኦድዳኮ ኤንታዉ ጌሽድ ኦድስ። <verse eid="ACT 9:27"/><verse number="28" style="v" sid="ACT 9:28"/>ሳኦል የሩሳላመን ዩይድ ጎዳ ሱንን ያዮና ቃላ ኦድሸ፥ ሀዋረታራ እስፈ ደእስ። <verse eid="ACT 9:28"/><verse number="29" style="v" sid="ACT 9:29"/>ቃስ ሳኦል ግርከ ዶናን ሃሳያ አይሁደታራ ኦደትሸ ፓላሜስ። ሽን ኤንቲ እያ ዎናዉ ኮይዶሶና። <verse eid="ACT 9:29"/><verse number="30" style="v" sid="ACT 9:30"/>አማንያ አሳት ሄሳ ስእድ፥ ሳኦል ቅሳረ ኤፍድ ታርሰሳ የድዶሶና።<verse eid="ACT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31"/>ይሁዳን፥ ጋልላንነ ሳማረ ኡባን ደእያ ዎሳ ኬት ሳሮተን ደእዶሶና። ቃስ ምንዶሶና፤ ጎዳስ ያይሸ ጌሻ አያና ምንን ዳር ዳርድ ብዶሶና።<verse eid="ACT 9:31"/></para>
  <para style="s1">ጰፅሮስ ሊደንነ ዮጰን</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32"/>ጰፅሮስ ቢታ ኡባ ዩይሸ ሊዳን ደእያ አማንያ አሳታኮ ጋክስ። <verse eid="ACT 9:32"/><verse number="33" style="v" sid="ACT 9:33"/>ያን ሆስፑን ላይ ኩመ ጉንድድ አርሳን ዝንእድ ደእያ ኤንያ ጌተትያ አድያ ደምስ። <verse eid="ACT 9:33"/><verse number="34" style="v" sid="ACT 9:34"/>ጰፅሮስ፥ “ኤንያ፥ የሱስ ክርስቶሲ ነና ፓና፤ ደንዳዳ ነ ሂፃ ደን” ያግስ። እካ ኤለስድ ደንድ ኤቅስ። <verse eid="ACT 9:34"/><verse number="35" style="v" sid="ACT 9:35"/>ሊዳንነ ሳሮናን ደእያ አሳ ኡባይ ኤንያ በእድ፥ ጎዳኮ ስምዶሶና።<verse eid="ACT 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36"/>ዮጰ ካታማን እስ ፃብቶ ጌተትያ አማንያራ ደአዉሱ። እ ሱንይ አራምከ ዶናን፥ “ፃብቶ”፤ ግርከ ዶናን፥ “ዶርቃ”፤ ሄ ናምኡ ሱን ብርሸይ “ገንኤ” ጉሱ። እያ ባ ደእዳ ዎደ ኡባን ሎኦባ ኦሸነ ማንቆታ ማዳሸ ደአሱ። <verse eid="ACT 9:36"/><verse number="37" style="v" sid="ACT 9:37"/>ሄ ዎደ እያ ሀርጋዳ ሀይቅን፥ አሳይ እ አሀ ሜጭድ፥ ፖቀ ቦላ ከስድ ዝንእስዶሶና። <verse eid="ACT 9:37"/><verse number="38" style="v" sid="ACT 9:38"/>ሊደይ ዮጰስ ማታ። አማነይሳት ጰፅሮስ ሊዳን ደኤይሳ ስእድ፥ “ሀያና ኑኮ ኤለሳዳ ያ” ያግድ ናምኡ አሳታ እያኮ ኪትዶሶና።<verse eid="ACT 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39"/>ሄሳ ግሾ፥ ጰፅሮስ ደንድድ፥ ኤንታራ ብስ። ያ ጋክን፥ ፖቀ ቦላ ደእያ ክፍለ እያ ገልስዶሶና። አምኤት ጰፅሮሳ ዩሾን ኤቅድ ዬክሸ ዶርቃ ኤንታራ ፓፃ ደአሸ ኦዳ ቃምሰታነ አፍላታ ኡባ ጰፅሮሳ በስዶሶና። <verse eid="ACT 9:39"/><verse number="40" style="v" sid="ACT 9:40"/>ጰፅሮስ ኤንታ ኡባ ካረ ከስድ፥ ጉልባትድ ዎስስ። ቃስ አሃኮ ስሚድ፥ “ፃብተ፥ ደንዳ” ያግስ። ፃብታ ባ አይፍያ ዶያዳ ጰፅሮሳ በአዳ፥ ደንዳ ኡታሱ። <verse eid="ACT 9:40"/><verse number="41" style="v" sid="ACT 9:41"/>ጰፅሮስ እዮ ባ ኩሸን ማድድ ደንድ ኤስስ። ሄሳፈ ጉየ፥ አማነይሳታነ አምኤታ ፄግድ፥ ደንድዳሮ ኤንታ ስን ሺሽስ።<verse eid="ACT 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 9:42"/>ሀ ኦዳይ፥ ዮጰ ካታማ ኡባ ጋክስ፤ ዳሮ አሳይ ጎዳ አማንዶሶና። <verse eid="ACT 9:42"/><verse number="43" style="v" sid="ACT 9:43"/>ጰፅሮስ ዮጰን ስሞና ጌተትያ ጋልባ ሃሸይሳ ሶን ዳሮ ጋላስ ጋምእስ።<verse eid="ACT 9:43"/></para>
  <chapter eid="ACT 9"/>
  <chapter number="10" style="c" sid="ACT 10"/>
  <para style="s1">ጰፅሮሳነ ቆርነልዮሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1"/>ቅሳረን፥ “ፃለ ኦላ አሳታ” ጌተትያ ኦላንቾታ ግዶን እስ ቆርነልዮሳ ጌተትያ ማቶ ሀላቃይ ደኤስ። <verse eid="ACT 10:1"/><verse number="2" style="v" sid="ACT 10:2"/>ቆርነልዮስ ባ ሶ አሳራ ፆሳ ምን አማንያ አስነ ፆሳ ጎይንያ አስ። አይሁደ ማንቆታካ ዳሮ ማዴስ፥ ቃስ ፆሳ ኡባ ዎደ ዎሴስ። <verse eid="ACT 10:2"/><verse number="3" style="v" sid="ACT 10:3"/>እስ ጋላስ ኡዱፉን ሳተ ሄራን ፆሳ ኪታንቾይ እያኮ ይድ፥ “ቆርነልዮሳ” ግድ ፄግሽን እ ቆንጨን ጌሽድ በእስ።<verse eid="ACT 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4"/>ቆርነልዮስ ዳጋምድ ኪታንቹዋ ትሽ ኦ ፄልድ፥ “ጎዳዉ፥ እ አይቤ?” ያግስ።</para>
  <para style="p" vid="ACT 10:4">ኪታንቾይ ዛሪድ፥ “ነ ዎሳይነ ማንቆታ ነ ማደይስ ፆሳ ስንን ሀሳየትስ። <verse eid="ACT 10:4"/><verse number="5" style="v" sid="ACT 10:5"/>ሀእ ዮጰ አሰ ኪታዳ፥ ጰፅሮሳ ጌተትያ ስሞና ኤህሳ። <verse eid="ACT 10:5"/><verse number="6" style="v" sid="ACT 10:6"/>ጰፅሮስ አባ ዶናን ጋልባ ሃሽያ ስሞና ሶን እማተ ሲራትስ” ያግስ።<verse eid="ACT 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7"/>ቆርነልዮስ ባዉ ኦድዳ ኪታንቾይ ብን፥ ባ አይለታፐ ናምአታነ ፆሳ ጎይንያ ባ ማታ ዎታዳረታፐ እሱዋ ፄግድ፥ <verse eid="ACT 10:7"/><verse number="8" style="v" sid="ACT 10:8"/>ኤንታዉ ኡባባ ኦድድ ዮጰ ኪትስ።<verse eid="ACT 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9"/>ዎንተ ጋላስ ኤንቲ ብድ፥ ዮጰ ካታማ ማትሽን ኡሱፑን ሳተ ሄራን ፆሳ ዎሳናዉ ጰፅሮስ ፖቀ ቦላ ከይስ። <verse eid="ACT 10:9"/><verse number="10" style="v" sid="ACT 10:10"/>እ ኮሻትድ ካ ማናዉ ኮይስ፥ ሽን ካ ካፅሽን እ ቆንጨ በእስ። <verse eid="ACT 10:10"/><verse number="11" style="v" sid="ACT 10:11"/>ሳሎይ ዶየትን፥ ግታ አፍላ ዳንያባይ ኦይዱ ባጋራ ኦይከትድ ዎሽን እ በእስ። <verse eid="ACT 10:11"/><verse number="12" style="v" sid="ACT 10:12"/>እያን ኦይዱ ቶሆራ ደእያ መሄት፥ ዎራ ዶአት፥ ኡሎራ ጎሸትያ መተትነ ሳሎ ካፎት ኡባይ ደኤስ። <verse eid="ACT 10:12"/><verse number="13" style="v" sid="ACT 10:13"/>ሄ ዎደ፥ “ጰፅሮሳ፥ ደንዳ ኤቃዳ ሹካዳ ማ” ግያ ቃላይ እያኮ ይስ።<verse eid="ACT 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14"/>ሽን ጰፅሮስ፥ “ጎዳዉ፥ አካይ! ታ ቱናባ ኡባራካ ማ ኤርከ” ያግስ።<verse eid="ACT 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15"/>ቃስ፥ “ፆሳይ ጌሽዳይሳ ኔኒ ቱና ጎፓ” ግያ ቃላይ ናምአን እያኮ ይስ። <verse eid="ACT 10:15"/><verse number="16" style="v" sid="ACT 10:16"/>ሄስካ፥ ሄ ቶሆ ሀንዳፐ ጉየ ሄ ግታ አፍላ ዳነይስ ኤለስድ ፑደ ሳሎ ኤከትስ።<verse eid="ACT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17"/>ጰፅሮስ ባ በእዳ ቆንጨ ብርሸይ፥ “አይ ግዳንደሻ?” ግድ ባ ዎዛናን ቆፕሽን፥ ቆርነልዮስ ኪትዳ አሳት ስሞና ሶ ኦይች ደምድ ካረን ኤቅዶሶና። <verse eid="ACT 10:17"/><verse number="18" style="v" sid="ACT 10:18"/>ባንታ ቃላ ቁ ኦድ፥ “ጰፅሮሳ ጌተትያ ስሞና ጌተትያ እማይ ሀይሳን ደኢ?” ያግድ ኦይችዶሶና።<verse eid="ACT 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19"/>ጰፅሮስ ቆንጨን በእዳባ ቆፋ ቦላ ደእሽን፥ ጌሻ አያናይ እያኮ፥ “ሄኮ፥ ሄ አሳት ነና ኮዮሶና። <verse eid="ACT 10:19"/><verse number="20" style="v" sid="ACT 10:20"/>ደንዳዳ ዎ፥ ታኒ ኤንታ ኪትዳ ግሾ ስና ኤንታራ ባ” ያግስ።<verse eid="ACT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21"/>ጰፅሮስ አሳታኮ ዎድ፥ “ህንተ ኮየይ ታና፤ አይስ ይደቲ?” ያግስ።<verse eid="ACT 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22"/>ኤንቲ ዛሪድ፥ “ኑና ማቶ ሀላቃይ ቆርነልዮስ ኪትስ። እ ፅሎ፥ ፆሳ ጎይንያ አስነ አይሁደ አሳ ኡባን ዳሮ ቦንቸትዳ አስ። ቆርነልዮስ፥ ነና ባ ሶ ኤህስድ ቃላ ኔፐ ስአና መላ ጌሻ ኪታንቾይ እያዉ ኦድስ” ያግዶሶና። <verse eid="ACT 10:22"/><verse number="23" style="v" sid="ACT 10:23"/>ጰፅሮስ አሳታ ሶ ገልስድ ሞክስ።</para>
  <para style="p" vid="ACT 10:23">ዎንተ ጋላስ፥ ደንድድ ኤንታራ ብስ። ዮጰ ካታማን ደእያ አማነይሳታፐ እሶት እሶት እያራ እስፈ ብዶሶና። <verse eid="ACT 10:23"/><verse number="24" style="v" sid="ACT 10:24"/>ዎንተ ጋላስ፥ ቅሳረ ጋክዶሶና። ቆርነልዮስ ባ ዳቦታነ ባ ማታ ላገታ እስፈ ፄግ ሺሽድ፥ ጰፅሮሳ ናጌስ። <verse eid="ACT 10:24"/><verse number="25" style="v" sid="ACT 10:25"/>ጰፅሮስ ሶ ገላና ሀንሽን፥ ቆርነልዮስ እያራ ጋሄትድ እያ ስንን ኩንድድ እያዉ ጎይናናዉ ኮይስ። <verse eid="ACT 10:25"/><verse number="26" style="v" sid="ACT 10:26"/>ሽን ጰፅሮስ፥ “ደንዳ፥ ታካ ታ ሁጰን ነ መላ አሰ” ያግድ እያ ደንስ።<verse eid="ACT 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27"/>ጰፅሮስ ቆርነልዮሳራ ኦደትሸ ሶ ገልያ ዎደ ዳሮ አሳይ ሺቅዳይሳ ደምስ። <verse eid="ACT 10:27"/><verse number="28" style="v" sid="ACT 10:28"/>እ አሳኮ፥ “አይሁደ አስ ሀራ ደረራ እስፋናዉ ዎይኮ ጋሄታናዉ ዎጋ ግዶናይሳ ህንተ ኤሬታ። ሽን ታኒ ኦናካ ቱና ዎይኮ ጌሽ ግደና ጎና መላ ፆሳይ ታና በስስ። <verse eid="ACT 10:28"/><verse number="29" style="v" sid="ACT 10:29"/>ሄሳ ግሾ፥ ህንተ ታኮ ኪትን እፆይ ባይና ያስ። ሀእ ታና አይስ ፄግስዳኮ ታዉ ኦድተ” ያግስ።<verse eid="ACT 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30"/>ቆርነልዮስ፥ “ታኒ ሀች ኦይዱ ጋላሳፐ ካሰ ሀኖደ ኡዱፉን ሳተ ዎሳ ዎስሽን፥ ጶልያ ማኦ ማእዳ አስ ታ ስንን ኤቅስ። <verse eid="ACT 10:30"/><verse number="31" style="v" sid="ACT 10:31"/>እ ታኮ፥ ‘ቆርነልዮሳ፥ ፆሳይ ነ ዎሳ ስእስ፥ ኔኒ ማንቆታ ማድዳይሳካ ሀሳይስ። <verse eid="ACT 10:31"/><verse number="32" style="v" sid="ACT 10:32"/>ህዛ፥ አሰ ዮጰ ኪታዳ፥ ስሞን ጰፅሮሳ ገይሳ ፄግሳ። ስሞን ጰፅሮስ ስሞና ጌተትያ ጋልባ ሃሽያ ኡራ ሶን አባ ዶናን ሲራትስ’ ያግስ። <verse eid="ACT 10:32"/><verse number="33" style="v" sid="ACT 10:33"/>ሄሳ ግሾ፥ ታኒ ኔኮ ኤለሳዳ ኪታስ፤ ነ ሎኦ ያዳሳ። ህዛ፥ ፆሳይ ነና ኪትዳባ ኡባ ስአናዉ ሀእ ኑኒ ኡባይ ሀይሳን ጎዳ ስንን ደኦስ” ያግስ።<verse eid="ACT 10:33"/></para>
  <para style="s1">ጰፅሮሳ ሃሳያ</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34"/>ካልድካ፥ ጰፅሮስ፥ “ፆሳይ አሳ ሶምኦ በእድ አሰ አሳፐ ሻከና።<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ዛረ 10:17</ref>.</char></note> <verse eid="ACT 10:34"/><verse number="35" style="v" sid="ACT 10:35"/>ሽን አሰ ኡባ ኦና ግድኮካ ባዉ ያየይሳነ ፅሎ ኦሶ ኦይሳን ፆሳይ ኡፋይተይሳ ታኒ ቱማ አኬካስ። <verse eid="ACT 10:35"/><verse number="36" style="v" sid="ACT 10:36"/>ፆሳይ፥ ኡባ ጎዳ ግድዳ የሱስ ክርስቶሳ ባጋራ ሳሮተ ኦድሸ ሀ ዎንገላ እስራኤለ አሳስ ኪትዳይሳ ህንተ ኤሬታ። <verse eid="ACT 10:36"/><verse number="37" style="v" sid="ACT 10:37"/>ዮሃንስ ፅንቃተባ ጋልላን ሳባክዳ ዎድያፐ ዶምድ ይሁዳ ቢታ ኡባ ጋካናዉ ሀንዳባ ህንተ ኤሬታ። <verse eid="ACT 10:37"/><verse number="38" style="v" sid="ACT 10:38"/>ፆሳይ ናዝረተ የሱሳስ ጌሻ አያናነ ዎልቃ እሚስ። ፆሳይ እያራ ደእያ ግሾ ሎኦባ እ ኦሸ ፃላሄ ኩሸን ሃረትዳ ኡባ ፓሸ ዩይስ።<verse eid="ACT 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39"/>“አይሁደ ቢታንነ የሩሳላመን እ ኦዳ ኡባባስ ኑኒ ማርካታ። ኤንቲ ማስቃልያ ቦላ ካቅድ እያ ዎዶሶና። <verse eid="ACT 10:39"/><verse number="40" style="v" sid="ACT 10:40"/>ሽን ፆሳይ ሄን ጋላሳን ሀይቆፐ እያ ደንድ አሳስ ቆንጫና መላ ኦስ። <verse eid="ACT 10:40"/><verse number="41" style="v" sid="ACT 10:41"/>ሄ ቆንጨይ ፆሳይ ኮይሮ ዶርዳ ማርካታሳፈ አትሽን፥ አሳ ኡባሳ ግደና። እ ሀይቆፐ ደንድዳፐ ጉየ እያራ ምዳነ ኡይዳ። <verse eid="ACT 10:41"/><verse number="42" style="v" sid="ACT 10:42"/>ፆሳይ ዎንገላ አሳስ ኑኒ ኦዳና መላነ ፓፃ ደኤይሳታ ቦላነ ሀይቅዳይሳታ ቦላ ፕርዳናዉ ሹመትዳይ የሱሳ ግደይሳ ማርካታና መላ ኑና ኪትስ። <verse eid="ACT 10:42"/><verse number="43" style="v" sid="ACT 10:43"/>ፆሳይ እያ አማንያ ኡባ ናጋራይ፥ እያ ሱንን አቶ ጌተተይሳ ናበት ማርካቶሶና” ያግስ።<verse eid="ACT 10:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44"/>ጰፅሮስ ቡሮ ሄ ኦዳ ኦንጎናሽን ቃላ ስእያ ኡባ ቦላ ጌሻ አያናይ ዎስ። <verse eid="ACT 10:44"/><verse number="45" style="v" sid="ACT 10:45"/>ጰፅሮሳራ ዮጰፈ ይዳ አማንያ ቃፃረትዳ አይሁደ ኡባይ፥ አይሁደ ግዶናይሳት ቦላ ጌሻ አያናይ ጉክዳ ግሾ ማላለትዶሶና። <verse eid="ACT 10:45"/><verse number="46" style="v" sid="ACT 10:46"/>ጋሶይካ፥ ኤንቲ ዱማ ዱማ ዶናን ኦደትሽንነ ፆሳ ግታተ ሳቢሽን ስእዶሶና።</para>
  <para style="p" vid="ACT 10:46">ሄ ዎደ ጰፅሮስ ዛሪድ፥ <verse eid="ACT 10:46"/><verse number="47" style="v" sid="ACT 10:47"/>“ሀይሳቲ ቃስ ኑ መላ ጌሻ አያና ኤክዳይሳት ፃማቀቶና መላ ሃ ድጋናይ ኦኔ?” ያግስ። <verse eid="ACT 10:47"/><verse number="48" style="v" sid="ACT 10:48"/>ኤንቲ የሱስ ክርስቶሳ ሱንን ፃማቀታና መላ ኤንታ ኪትስ። ሄሳፈ ጉየ፥ ኤንቲ ባንታራ ጉ ጋላስ ኡታና መላ ጰፅሮሳ ዎስዶሶና።<verse eid="ACT 10:48"/></para>
  <chapter eid="ACT 10"/>
  <chapter number="11" style="c" sid="ACT 11"/>
  <para style="s1">ጰፅሮስ ባ ኦዳ ኦሱዋ ኦድስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1"/>ሀዋረትነ ይሁዳ ኡባን ደእያ አማነይሳት፥ አይሁደ ግዶናይሳትካ ፆሳ ቃላ ኤክዳይሳ ስእዶሶና። <verse eid="ACT 11:1"/><verse number="2" style="v" sid="ACT 11:2"/>ጰፅሮስ የሩሳላመ ብዳ ዎደ ቃፃረትዳ አማነይሳት፥ <verse eid="ACT 11:2"/><verse number="3" style="v" sid="ACT 11:3"/>እያኮ፥ “ኔኒ ቃፃረትቦናይሳታኮ ገላዳ ኤንታራ ካ አይስ ማዲ?” ያግዶሶና።<verse eid="ACT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4"/>ሽን ጰፅሮስ ሀንዳባ ኮይሮፐ ዶምድ ማራን ማራን ኦድስ፦ <verse eid="ACT 11:4"/><verse number="5" style="v" sid="ACT 11:5"/>“ታኒ ዮጰ ካታማን ፆሳ ዎሳሸ ቆንጨ በአስ። ግታ አፍላ ዳንያባይ ኦይዱ ባጋራ ኦይከትድ ሳሎፐ ዎሸ ታኮ ይስ። <verse eid="ACT 11:5"/><verse number="6" style="v" sid="ACT 11:6"/>ታኒ ትሽ ኦ እያ ግዶ ፄልያ ዎደ ኦይዱ ቶሆራ ደእያ መሄታ፥ ዎራ ዶአታ፥ ኡሎራ ጎሸትያ መተታነ ሳሎ ካፎታ በአስ። <verse eid="ACT 11:6"/><verse number="7" style="v" sid="ACT 11:7"/>‘ጰፅሮሳ፥ ደንዳ፥ ሹካዳ ማ’ ግያ ቃላ ስአስ።<verse eid="ACT 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8"/>“ሽን ታኒ፥ ‘ጎዳዉ፥ አካይ፥ ቱናባይ ዎይኮ ጌዮናባይ ኡባካ ታ ዶናኮ ሺቅ ኤረና’ ያጋስ።<verse eid="ACT 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9"/>“ ‘ፆሳይ ጌሽዳይሳ ኔኒ ቱና ጎፓ’ ግያ ቃላይ ናምአን ሳሎፐ ይስ።<verse eid="ACT 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 11:10"/>“ሄስ ሄ ቶሆ ሀንን፥ ዉርሰን ኡባባይ ሳሎ ፑደ ኤከትስ። <verse eid="ACT 11:10"/><verse number="11" style="v" sid="ACT 11:11"/>ሄ ሳተንካ ሄ አሳት ቅሳረፐ ታኮ ኪተትድ ታኒ ደእያ ኬ ጋክ አግዶሶና። <verse eid="ACT 11:11"/><verse number="12" style="v" sid="ACT 11:12"/>ስና ኤንታራ ባና መላ አያናይ ታዉ ኦድስ። ቃስ ሀ ኡሱፑን እሻት ዮጰፈ ታራ ቅሳረ ብዳይሳታራ ቆርነልዮሳ ሶ ገልዳ። <verse eid="ACT 11:12"/><verse number="13" style="v" sid="ACT 11:13"/>ኪታንቾይ እያ ሶን ኤቅድ፥ ‘ዮጰ ኪታዳ ጰፅሮሳ ጌተትያ ስሞና ፄግሳ። <verse eid="ACT 11:13"/><verse number="14" style="v" sid="ACT 11:14"/>ነናነ ነ ሶ አሳ ኡባ አሽያ ቃላ እ ነዉ ኦዳና’ ግዳይሳ ቆርነልዮስ ኑስ ኦድስ።<verse eid="ACT 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15"/>“ታኒ ሃሳያ ዶምያ ዎደ ጌሻ አያናይ ኮይሮ ኑ ቦላ ዎዳይሳዳ ኤንታ ቦላካ ዎ አግስ። <verse eid="ACT 11:15"/><verse number="16" style="v" sid="ACT 11:16"/>ሄ ዎደ፥ ‘ዮሃንስ ሃን ፃማቅስ፥ ሽን ህንተ ጌሻ አያናን ፃማቀታና’ ያግዳ ጎዳ ቃላይ ታዉ ቆፈትስ።<note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="ACT 1:5">ሀዋ 1:5</ref>.</char></note> <verse eid="ACT 11:16"/><verse number="17" style="v" sid="ACT 11:17"/>ፆሳይ ኑስ ጎዳ የሱስ ክርስቶሳ አማንዳይሳታስ እምዳ እሞታ አይሁደ ግዶናይሳታስካ እምኮ፥ ያትን ፆሳ ድጋናዉ ታኒ ኦኔ?” ያግስ።<verse eid="ACT 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18"/>ኤንቲ ሄሳ ስእዳ ዎደ ባንታ ፓላማ አግድ፥ “ያትን፥ ፆሳይ አይሁደ ግዶናይሳትካ ናጋራፐ ስሚድ ደኦን ዳናዳ ቃዳ እሚስ” ያግድ ፆሳ ጋላትዶሶና።<verse eid="ACT 11:18"/></para>
  <para style="s1">አንፆከ ዎሳ ኬ</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19"/>እስፅፋኖሰ ሀይቆስ ጋዳ ጎዳ ጋሶን ላለትዳ አማነይሳት ቃላ አይሁደታ ፃላላስ ኦድሸ ስሮፍንቀ፥ ቆጵሮሳነ አንፆከ ጋካናዉ ዩይዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="ACT 8:1-4">ሀዋ 8:1-4</ref>.</char></note> <verse eid="ACT 11:19"/><verse number="20" style="v" sid="ACT 11:20"/>ሽን ቆጵሮሳፐነ ቀሬናፐ ይዳ እስ እስ አማንያ አሳት አንፆከ ብድ፥ ጎዳ የሱሳ ዎንገላ ግርከ አሳስካ ኦድዶሶና። <verse eid="ACT 11:20"/><verse number="21" style="v" sid="ACT 11:21"/>ጎዳ ዎልቃይ ኤንታራ ደኤስ፤ ቃስ ዳሮ አሳይ አማንድ ጎዳኮ ስምዶሶና።<verse eid="ACT 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22"/>ሄ ኦዳ የሩሳላመን ደእያ ዎሳ ኬይ ስእዳ ግሾ ባርናባሳ አንፆከ ኪትስ። <verse eid="ACT 11:22"/><verse number="23" style="v" sid="ACT 11:23"/>ባርናባስ አንፆከ ብዳ ዎደ ፆሳ አ ኬሀተ ኦሱዋ በእድ ኡፋይትስ። ኤንቲ ኡባይ ባንታ ኩመ ዎዛናን ጎዳን ምንድ ዳና መላ ኤንታ ዞርስ። <verse eid="ACT 11:23"/><verse number="24" style="v" sid="ACT 11:24"/>ባርናባስ ጌሻ አያናይነ አማኖይ ኩምዳ ሎኦ አስ ግድያ ግሾ ዳሮ አሳይ ጎዳ አማንዶሶና።<verse eid="ACT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25"/>ሄሳፈ ጉየ፥ ባርናባስ ሳኦላ ኮያናዉ ታርሰሳ ብስ። <verse eid="ACT 11:25"/><verse number="26" style="v" sid="ACT 11:26"/>ያን ሳኦላ ደምዳ ዎደ አንፆከ ኤክድ ይስ። ባርናባስነ ሳኦል ዎሳ ኬ አሳራ ላይ ኩመ ኡትድ ዳሮ አሳ ታማርስዶሶና። አማነይሳት አንፆከን “ክርስታነ” ጌተትድ ኮይሮ ፄገትዶሶና።<verse eid="ACT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27"/>ሄ ዎደ እስ እስ ናበት የሩሳላመፐ አንፆከ ዎዶሶና። <verse eid="ACT 11:27"/><verse number="28" style="v" sid="ACT 11:28"/>ኤንታ ግዶፈ አጋቦሳ ገይስ ደንድድ ቢታ ኡባን ግታ ኮሽ ከያናይሳ አያና ዎልቃን ትንብተ ኦድስ። ሄስ ሀንዳይ ሮመ ካዋ ቃላዉድዮሳ ዎደና።<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="ACT 21:10">ሀዋ 21:10</ref>.</char></note> <verse eid="ACT 11:28"/><verse number="29" style="v" sid="ACT 11:29"/>አማነይሳት ሁጰን ሁጰን ባንታ ዎልቃ መላ ሚሸ ከስድ ይሁዳን ደእያ አማነይሳታስ ማደ የዳናዉ ቆፋ ቃችዶሶና። <verse eid="ACT 11:29"/><verse number="30" style="v" sid="ACT 11:30"/>ኤንቲ ሄሳዳ ኦድ፥ ሚሽያ ባርናባሳ ቦላነ ሳኦላ ቦላ ዎሳ ኬ ጭማታስ የድዶሶና።<verse eid="ACT 11:30"/></para>
  <chapter eid="ACT 11"/>
  <chapter number="12" style="c" sid="ACT 12"/>
  <para style="s1">ጰፅሮስ ቃሾ ኬፈ ከስ ኤክስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1"/>ሄ ዎደ ካዎይ ሄሮዲስ<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="fq" closed="false">ካዎይ ሄሮዲስ፦ </char><char style="ft" closed="false">ሀይስ ካዎይ ሄሮዲስ፥ ሄሮዲሳ አግርጳ ጌተትያ ኮይሩዋ። እ፥ 37-44 ማሮተ ላይ ጋካናዉ ሃርስ። እ ካዋ ሄሮዲሳስ ናአ ናአ</char></note> ዎሳ ኬ አሳፐ ባጋ ጎዳ ዶምስ። <verse eid="ACT 12:1"/><verse number="2" style="v" sid="ACT 12:2"/>ዮሃንሳ እሻ ያይቆባ ማሻን ዎስስ። <verse eid="ACT 12:2"/><verse number="3" style="v" sid="ACT 12:3"/>ሄስ አይሁደታ ኡፋይስዳይሳ በእድ፥ ጉጅድ ጰፅሮሳካ ኦይስ። ሄስ ሀንዳይ ፓስካ ባኣለ ቦንችያ ጋላሳታና። <verse eid="ACT 12:3"/><verse number="4" style="v" sid="ACT 12:4"/>ጰፅሮሳ ኦይክድ ቃችስ። ፓስካ ቦንችያ ጋላሳታፐ ጉየ ደርያ ስን አናዉ ቆፕድ፥ ኦይዱ ኦይዱ ዎታዳረት እያ ናጋና መላ ታማነ ኡሱፑን ዎታዳረታስ አድ እሚስ።<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ከሳ 12:1-27</ref>.</char></note> <verse eid="ACT 12:4"/><verse number="5" style="v" sid="ACT 12:5"/>ሄሳ ግሾ፥ ጰፅሮስ ቃሾ ኬን ናገቴስ። ሽን ዎሳ ኬ አሳይ እያዉ ምንድ ፆሳ ዎሶሶና።<verse eid="ACT 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6"/>ሄሮዲስ ጰፅሮሳ አሳ ስን ሺሻናፐ ካሰ ቃማ ጰፅሮስ ናምኡ ባጋራ ናምኡ ዎታዳረታራ ሳንላታን ቃሸትድ ኤንታ ግዶን ስክስ። ናገይሳት ቃሾ ኬ ፐንገታን ኤቅድ ናጎሶና። <verse eid="ACT 12:6"/><verse number="7" style="v" sid="ACT 12:7"/>አኬኮና ደእሽን ጎዳ ኪታንቾይ ቆንጭስ። ቃሾ ኬን ፖኦይ ፖእስ። ኪታንቾይ ጰፅሮሳ ምያ ቦች ባርክስድ፥ “ኤለ ደንዳ” ያግስ። ኢራካ ሳንላታይ እያ ኩሽያፐ ዎ አግስ። <verse eid="ACT 12:7"/><verse number="8" style="v" sid="ACT 12:8"/>ኪታንቾይ እያኮ፥ “ነ ማኡዋ ማአ፥ ነ ጫማካ አ” ያግስ። ጰፅሮስ ሄሳዳ ኦስ፤ ኪታንቾይ፥ “ነ ላፃና ማአዳ ታና ካላ” ያግስ።<verse eid="ACT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 12:9"/>ጰፅሮስ ቃሾ ኬፈ ከይድ ኪታንቹዋ ካልስ። እያዉ ቆንጨ በእያባ ዳንስፐ አትሽን፥ ኪታንቾይ ኦያባይ ቱማ ዳንቤና። <verse eid="ACT 12:9"/><verse number="10" style="v" sid="ACT 12:10"/>ኪታንቾይነ ጰፅሮስ ኮይሩዋነ ናምአን ዎታዳርያ አድ ካታማ ኤፍያ ብራታ ፐንግያኮ ጋክዶሶና። ፐንገይ ኤንታዉ ባርካ ዶየት አግስ። ኤንቲ ከይድ እስ ኦግያራ ብሽን ኪታንቾይ አኬኮና ጰፅሮሳፐ ሻከት አግስ።<verse eid="ACT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11"/>ጰፅሮሳስ ዎዛን ስምን፥ “ታና ጎዳይ ባ ኪታንቹዋ ኪትድ፥ ሄሮዲሳ ኩሸፐነ ናግድ ኡትዳ አይሁደ አሳ ኡባፈ አሽዳይሳ ሀእ ቱማ ኤራስ” ያግስ።<verse eid="ACT 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12"/>እ ሄሳ አኬክዳ ዎደ ዳሮ አሳይ እስፈ ሺቅድ ፆሳ ዎስያ በሳ፥ ማርቆሳ ጌተትያ ዮሃንሳ አየ ማይራም ሶ ብስ። <verse eid="ACT 12:12"/><verse number="13" style="v" sid="ACT 12:13"/>ያን ካረን ኤቅድ ፄግስ። እስ ሮዳ ጌተትያ ኦሳንችያ ፐንግያ ዶያናዉ ያሱ። <verse eid="ACT 12:13"/><verse number="14" style="v" sid="ACT 12:14"/>ሮዳ ጰፅሮሳ ቃላ ግድዳይሳ ኤርዳ ዎደ ኡፋይሳን ኩማዳ ካርያ ዶየና ጉየ ዎፃ ባዳ፥ “ጰፅሮስ ካረን ኤቅስ” ያጋዳ አሳስ ኦዳሱ።<verse eid="ACT 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15"/>አሳይ ኢኮ፥ “ኔኒ ጎያይ!” ያግዶሶና። ሮዳ ጰፅሮሳ ግድዳይሳ ጌሻዳ ኦዳሱ። ኤንቲ፥ “ሄስ እያ ናግያ ኪታንቹዋ” ያግዶሶና።<verse eid="ACT 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16"/>ሽን ጰፅሮስ ካረን ኤቅድ ፄግድ አጎና እፅን አሳይ ካርያ ዶይድ እያ በእድ ማላለትዶሶና። <verse eid="ACT 12:16"/><verse number="17" style="v" sid="ACT 12:17"/>ሽን ኤንቲ ስእ ጋና መላ ጰፅሮስ ባ ኩሽያን ማልድ ጎዳይ ቃሾ ኬፈ እያ ዋት ከስዳኮ ኤንታዉ ቆንጭስ ኦድድ፥ “ሀይሳ ያይቆባስነ አማንያ አሳታስ ኦድተ” ግድ ያፐ ከይድ ሀራሶ ብስ።<verse eid="ACT 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18"/>ሳአይ ዎንትያ ዎደ፥ “ጰፅሮስ አዉ ብደ” ግድ ዎታዳረት ዎል ግዶን ዳሮ ካጭዶሶና። <verse eid="ACT 12:18"/><verse number="19" style="v" sid="ACT 12:19"/>ሄሮዲስ ጰፅሮሳ ኮይስን፥ እ ይዳ ዎደ ናገይሳታ ቆርድ፥ ኤንታ ዎና መላ ኪትስ። ሄሳፈ ጉየ፥ ሄሮዲስ ይሁዳፐ ቅሳረ ዎድ ያን ጉ ዎደ ኡትስ።<verse eid="ACT 12:19"/></para>
  <para style="s1">ሄሮዲሳ ሀይቁዋ</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20"/>ሄሮዲስ ፅሮሳ አሳ ቦላነ ስዶና አሳ ቦላ ዳሮ ሀንቀትስ። ኤንታ ቢታይ ካ ሄሮዲሳ ቢታፈ ደምያ ግሾ ኤንቲ እስፈ ግድድ እያ ሞርና ብላስፆሳ ባንታዉ ጭማ ኦድ ጊጋናዉ ሄሮዲሳኮ ብዶሶና።<verse eid="ACT 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21"/>ሄሮዲስ ባርዳ ጋላሳን ባ ካዎተ አፍላ ማእድ፥ አራታ ቦላ ኡትድ አሳስ ኦድስ። <verse eid="ACT 12:21"/><verse number="22" style="v" sid="ACT 12:22"/>አሳይ፥ “ሄስ ፆሳ ቃላ፥ አሳ ቃላ ግደና” ያግድ ዋስዶሶና። <verse eid="ACT 12:22"/><verse number="23" style="v" sid="ACT 12:23"/>ሄሮዲስ ፆሳ ቦንችቦና ግሾ ኢራካ ጎዳ ኪታንቾይ እያ ደችን ጉፁነን ሜተትድ ሀይቅስ።<verse eid="ACT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24"/>ሽን ፆሳ ቃላይ ድጭሸነ ዳልግሸ ቤስ።<verse eid="ACT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25"/>ባርናባስነ ሳኦል ባንታ ኦሱዋ ፖልድ ማርቆሳ ጌተትያ ዮሃንሳ ባንታራ ኤክድ የሩሳላመፐ ስምዶሶና።<verse eid="ACT 12:25"/></para>
  <chapter eid="ACT 12"/>
  <chapter number="13" style="c" sid="ACT 13"/>
  <para style="s1">ባርናባሳነ ሳኦላ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1"/>አንፆከን ደእያ ዎሳ ኬን ናበትነ አስታማረት ደኦሶና። ኤንቲ ባርናባሳ፥ ካሬ ጌተትያ ስሞና፥ ቀሬናፐ ይዳ ሉክዮሳ፥ ካዋ ሄሮዲሳራ ድጭዳ ምናሄነ ሳኦላ። <verse eid="ACT 13:1"/><verse number="2" style="v" sid="ACT 13:2"/>ኤንቲ ጎዳ ጎይንሽንነ ፆምሽን ጌሻ አያናይ፥ “ታኒ ፄግዳ ኦሱዋስ ባርናባሳነ ሳኦላ ታዉ ዱማይተ” ያግስ።<verse eid="ACT 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3"/>ሄሳ ግሾ፥ ኤንቲ ፆምዳፐነ ዎስዳፐ ጉየ ባንታ ኩሽያ ኤንታ ቦላ ዎድ የድዶሶና።<verse eid="ACT 13:3"/></para>
  <para style="s1">ባርናባስነ ሳኦል ቆጵሮሳን</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4"/>ሄሳ ግሾ፥ ጌሻ አያናይ ኤንታ ኪትስ። ሰለዉቀ ብዶሶና፤ ያፐ ማርካበን ገልድ ቆጵሮሳ ሃን ተቀትዳ ቢታ ብዶሶና። <verse eid="ACT 13:4"/><verse number="5" style="v" sid="ACT 13:5"/>ኤንቲ ስልማና ጋክድ አይሁደ ዎሳ ኬታን ፆሳ ቃላ ኦድዶሶና። ዮሃንስ<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="fq" closed="false">ዮሃንስ፦ </char><char style="ft" closed="false">ሀ በሳን ፃፈትዳ ዮሃንስ፥ ሀዋርያ ዮሃንሳ ግዶናሽን ዮሃንስ ማርቆሳ ጌተትያ ማርቆሳ ዎንገላ ፃፍዳይሳ።</char></note> ማድሸ ኤንታራ ደኤስ።<verse eid="ACT 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6"/>ኤንቲ ዩሾይ አባን ተቀትዳ ቢታ፥ ቆጵሮሳ ካንድ ጳፉ ጋክያ ዎደ፥ እስ ዎርዳንቾ ናብያ፥ ባር-የሱሳ ጌተትያ አይሁደ ማሩዋ ደምዶሶና። <verse eid="ACT 13:6"/><verse number="7" style="v" sid="ACT 13:7"/>ሄ ማሮይ ደርያ አይስያ ሳርግዮስ ጳዉሎሳ ጌተትያ አኬካንቾ አድያራ ደኤስ። ሳርግዮስ ጳዉሎስ ባርናባሳነ ሳኦላ ባኮ ፄግድ ፆሳ ቃላ ስአናዉ ኮይስ። <verse eid="ACT 13:7"/><verse number="8" style="v" sid="ACT 13:8"/>ሽን ግርከ ዶናን ማሩዋ ሱንይ “ኤልማሳ” ጌተቴስ። እ ደርያ ሃረይስ አማኖና መላ ድጋናዉ ኮይድ ባርናባሳራነ ጳዉሎሳራ ኤቀትስ።<verse eid="ACT 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 13:9"/>ሽን ጳዉሎሳ ጌተትያ ሳኦል ጌሻ አያናን ኩምድ ማሩዋ ጫድ ፄልድ፥ <verse eid="ACT 13:9"/><verse number="10" style="v" sid="ACT 13:10"/>“ላ፥ ፃላሄ ናአዉ፥ ኢታተ ኡባይ ኩምዳይሶ፥ ፅሎተ ኡባስ ሞርክያዉ፥ ሱረ ጎዳ ኦግያ ምርቀይሳ አግኪ? <verse eid="ACT 13:10"/><verse number="11" style="v" sid="ACT 13:11"/>ሄኮ፥ ሀእ ጎዳ ኩሸይ ነ ቦላ ደኤስ። ኔኒ ቆቀ ግዳና፤ ጉ ዎደስ አዋ ፖኦ በአካ” ያግስ።</para>
  <para style="p" vid="ACT 13:11">ኢራ ጫጋንነ ሚ እያ አይፍያ ጎዝን፥ ባ ኩሽያ ኦይክድ ካለያ አስ ኮይሸ ዩይስ። <verse eid="ACT 13:11"/><verse number="12" style="v" sid="ACT 13:12"/>ደርያ አይሰይስ ሄሳ በእዳ ዎደ ጎዳባ ታማርስያ ትምርትያን ማላለትድ አማንስ።<verse eid="ACT 13:12"/></para>
  <para style="s1">ባርናባስነ ጳዉሎስ ጵስደ አንፆከን</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13"/>ጳዉሎስነ እያራ ደኤይሳት ጳፉፐ ደንድድ፥ ጵንፍለን ደእያ ጳርገ ማርካበራ ብዶሶና። ዮሃንስ ኤንታፈ ሻከትድ የሩሳላመ ስምስ። <verse eid="ACT 13:13"/><verse number="14" style="v" sid="ACT 13:14"/>ሽን ኤንቲ ጳርገፈ አድ ጵስደን ደእያ አንፆከ ጋክዶሶና። ሳምባታ ጋላስ አይሁደ ዎሳ ኬ ገልድ ኡትዶሶና። <verse eid="ACT 13:14"/><verse number="15" style="v" sid="ACT 13:15"/>ሙሰ ህገይነ ናበታ ማፃፋይ ናባበትዳፐ ጉየ አይሁደ ዎሳ ኬ ሀላቃት፥ “ኑ እሻቶ፥ አሳ ምንያ ቃል ህንተዉ ደእያኮ አሳስ ኦደርከት” ያግድ ኤንታኮ ኪትዶሶና።<verse eid="ACT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16"/>ጳዉሎስ ደንድ ኤቅድ ባ ኩሸ ማልድ፥ “እስራኤለ አሳቶነ፥ ፆሳ ጎይንያ አይሁደ ግዶና አሳዉ፥ ስእተ። <verse eid="ACT 13:16"/><verse number="17" style="v" sid="ACT 13:17"/>ሀ እስራኤለ አሳ ፆሳይ ኑ ማይዛታ ዶርስ። ግብፀ ቢታን እማተን ኤንቲ ደእሽን፥ ኤንታ ዳርስድ ባ ግታ ዎልቃን ግብፀ ቢታፈ ኤንታ ከስስ።<note caller="-" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="EXO 1:7">ከሳ 1:7</ref>፤ <ref loc="EXO 12:51">ከሳ 12:51</ref>.</char></note> <verse eid="ACT 13:17"/><verse number="18" style="v" sid="ACT 13:18"/>መላ ቢታን ኦይታሙ ላይ መላ ኤንታ ዳንዳእስ።<note caller="-" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="NUM 14:34">ታይቦ 14:34</ref>፤ <ref loc="DEU 1:31">ዛረ 1:31</ref>.</char></note> <verse eid="ACT 13:18"/><verse number="19" style="v" sid="ACT 13:19"/>ካናነ ቢታን አይሁደ ግዶና ላፑን ካዎተታ ድግድ ኤንታ ቢታ ባ አሳ ላትስስ።<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 7:1">ዛረ 7:1</ref>.</char></note><verse eid="ACT 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 13:20"/>“ሄሳፈ ጉየ፥ ናብያ ሳሜላ ዎደ ጋካናዉ ኦይዱ ፄታነ እሻታሙ ላይ መላ አይስያ ዳይናታ ኤንታዉ እሚስ።<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="DEU 2:16">ዛረ 2:16</ref>፤ <ref loc="1SA 3:20">1 ሳሜ 3:20</ref>.</char></note> <verse eid="ACT 13:20"/><verse number="21" style="v" sid="ACT 13:21"/>ሄሳፈ ጉየ፥ ኤንቲ ባንታዉ ካዎ እማና መላ ዎስን፥ ፆሳይ ብንያመ ሼሻፐ ቂሳ ናኣ፥ ሳኦላ ኦይታሙ ላይ ካዎታና መላ ኤንታዉ እሚስ።<note caller="-" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="1SA 8:5">1 ሳሜ 8:5</ref>፤ <ref loc="1SA 10:21">10:21</ref>.</char></note> <verse eid="ACT 13:21"/><verse number="22" style="v" sid="ACT 13:22"/>ፆሳይ ሳኦላ ሻርዳፐ ጉየ ኤንታ ቦላ ዳዊታ ካዎስ። ፆሳይ ዳዊታባ ማርካትሸ፥ ‘ታኒ ኮይያ ኡባ ታ ዎዛና መላ ኦያ እሰየ ናኣ ዳዊታ ደማስ’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1 ሳሜ 13:14</ref>፤ <ref loc="1SA 16:12">16:12</ref>፤ <ref loc="PSA 89:20">ማዝ 89:20</ref>.</char></note><verse eid="ACT 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23"/>“ፆሳይ፥ ‘ታኒ ዳዊታ ሼሻፐ እስራኤለ ደርያ አሸይሳ ኤሀና’ ግዳይሳ መላ የሱሳ ኤህስ። <verse eid="ACT 13:23"/><verse number="24" style="v" sid="ACT 13:24"/>የሱሲ ያናፐ ስን እስራኤለ አሳ ኡባይ ባንታ ናጋራፐ ስሚድ ፃማቀታና መላ ዮሃንስ ቃላ ኦድስ።<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="MRK 1:4">ማር 1:4</ref>፤ <ref loc="LUK 3:3">ሉቃ 3:3</ref>.</char></note> <verse eid="ACT 13:24"/><verse number="25" style="v" sid="ACT 13:25"/>ቃስ ዮሃንስ ባ ኦሱዋ ዉርሳና ሀንሸ አሳኮ፥ ‘ታና ኦና ግድ ቆፔቲ? ታኒ ህንተ ናግያ ክርስቶሳ ግድከ፥ ሽን ታኒ እያ ጫማ ብርሻናዉ ታዉ በሶናይስ ታፐ ጉየራ ዬስ’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቶ 3:11</ref>፤ <ref loc="MRK 1:7">ማር 1:7</ref>፤ <ref loc="LUK 3:16">ሉቃ 3:16</ref>፤ <ref loc="JHN 1:20">ዮሀ 1:20</ref>፥ <ref loc="JHN 1:27">27</ref>.</char></note><verse eid="ACT 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26"/>“ታ እሻቶ፥ አብራሃመ ሼሻቶ፥ ቃስ ሀይሳን አይሁደ ግዶናሽን ፆሳስ ያየይሳቶ፥ ሀ አቶተ ቃላይ ኑስ ኪተትስ። <verse eid="ACT 13:26"/><verse number="27" style="v" sid="ACT 13:27"/>አይስ ጊኮ፥ የሩሳላመን ደእያ አሳይነ ኤንታ ሀላቃት የሱሳ ኤርቦኮና። ሳምባታ ኡባን ናባበትያ ናበታ ቃላ አኬክቦና ግሾ እያ ቦላ ፕርድድ ናበት ኦድዳ ቃላ ፖልዶሶና። <verse eid="ACT 13:27"/><verse number="28" style="v" sid="ACT 13:28"/>የሱሳ ዎሳናዉ እስ ጋሶይካ ኤንታዉ ይን ጵላፆስ እያ ዎና መላ ዎስዶሶና።<note caller="-" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 27:22-23">ማቶ 27:22-23</ref>፤ <ref loc="MRK 15:13-14">ማር 15:13-14</ref>፤ <ref loc="LUK 23:21-23">ሉቃ 23:21-23</ref>፤ <ref loc="JHN 19:15">ዮሀ 19:15</ref>.</char></note> <verse eid="ACT 13:28"/><verse number="29" style="v" sid="ACT 13:29"/>ኤንቲ የሱሳባይ ጌሻ ማፃፋን ፃፈትዳባ ኡባ ፖልዳ ዎደ ማስቃልያፐ እያ ዎስድ ሞግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">13:29 </char><char style="xt" closed="false"><ref loc="MAT 27:57-61">ማቶ 27:57-61</ref>፤ <ref loc="MRK 15:42-47">ማር 15:42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ 23:50-56</ref>፤ <ref loc="JHN 19:38-42">ዮሀ 19:38-42</ref>.</char></note> <verse eid="ACT 13:29"/><verse number="30" style="v" sid="ACT 13:30"/>ሽን ፆሳይ ሀይቆፐ የሱሳ ደንስ። <verse eid="ACT 13:30"/><verse number="31" style="v" sid="ACT 13:31"/>ሄሳፈ ጉየ፥ እ ባራ ጋልላፐ የሩሳላመ ይዳይሳታስ ዳሮ ቶሆ በንትስ። ኤንቲ ሀእ እያባ አሳስ ማርካቶሶና።<note caller="-" style="x"><char style="xo" closed="false">13:31 </char><char style="xt" closed="false"><ref loc="ACT 1:3">ሀዋ 1:3</ref>.</char></note><verse eid="ACT 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32"/>“ፆሳይ ኑ አዋታስ እማና ግዳ ዎንገላ ኑኒ ህንተዉ ኦዶስ። <verse eid="ACT 13:32"/><verse number="33" style="v" sid="ACT 13:33"/>ዳዊቲ ባ ማዝሙረ ማፃፋን ናምአን ሸምፑዋን፥</para>
  <para style="q1" vid="ACT 13:33">“ኔኒ፥ ታ ናአ፥</para>
  <para style="q2" vid="ACT 13:33">ታኒ ሀች ነና የላስ”</para>
  <para style="m" vid="ACT 13:33">ጌተትድ ፃፈትዳይሳ የሱሳ፥ ፆሳይ ሀይቆፐ ደንድ ኑ ማይዛታስ እማና ግዳይሳ ኑስ ኤንታ ናይታስ ፖልስ።<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ማዝ 2:7</ref>.</char></note> <verse eid="ACT 13:33"/><verse number="34" style="v" sid="ACT 13:34"/>እ ዎቆና መላ ፆሳይ ሀይቆፐ እያ ደንን ኤርሳናዉ፥</para>
  <para style="q1" vid="ACT 13:34">“ ‘ታኒ ዳዊታስ እማና ግዳ</para>
  <para style="q2" vid="ACT 13:34">አማነትዳ ጌሻ አንጁዋ ህንተዉ እማና’ ያግድ ኦድስ።<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="ISA 55:3">እሳ 55:3</ref>.</char></note><verse eid="ACT 13:34"/></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35"/>ሄሳ ግሾ፥ ማዝሙረ ማፃፋን ሀራ በሳን፥</para>
  <para style="q1" vid="ACT 13:35">“ ‘ነ ጌሻ ናኣ አሀ ዎቅሳካ’ ያጌስ።<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 16:10">ማዝ 16:10</ref>.</char></note><verse eid="ACT 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36"/>“ዳዊቲ ባ ዎደ ፆሳ ቆፋ ፖልዳፐ ጉየ ሀይቅድ ባ አዋታራ ሞገትድ ዎቅስ። <verse eid="ACT 13:36"/><verse number="37" style="v" sid="ACT 13:37"/>ሽን ፆሳይ ሀይቆፐ ደንዳይስ ዎቅቤና።<verse eid="ACT 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38"/>“ሄሳ ግሾ፥ ታ እሻቶ፥ ናጋራ አቶተይ የሱሳ ባጋራ ካሰትድ ህንተዉ ኦደትዳይሳ ኤርተ። ሙሰ ህገይ ናጋራፐ ፅልሳናዉ ዳንዳኤና። <verse eid="ACT 13:38"/><verse number="39" style="v" sid="ACT 13:39"/>ሽን የሱሳ አማንያ ኡባይ ናጋራፐ ፅሌስ። <verse eid="ACT 13:39"/><verse number="40" style="v" sid="ACT 13:40"/>ሄሳ ግሾ፥ ናበት ግዳይስ ህንተ ቦላ ጋኮና መላ ናገትተ።<verse eid="ACT 13:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41"/>“ ‘ፆሳይ ግዳባ ለቅሰይሳቶ!</para>
  <para style="q2" vid="ACT 13:41">በእተ! ማላለትተ! ይተ!</para>
  <para style="q2" vid="ACT 13:41">ኦንካ ኦድን፥ ህንተ አማኖና ኦሱዋ</para>
  <para style="q2" vid="ACT 13:41">ታኒ ህንተ ዎድያን ኦና’ ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">13:41 </char><char style="xt" closed="false"><ref loc="HEB 1:5">እብራ 1:5</ref>.</char></note><verse eid="ACT 13:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42"/>ጳዉሎስነ ባርናባስ አይሁደ ዎሳ ኬፈ ከይሽን፥ ካልያ ሳምባታን ሄሳ ጉጅድ ኦዳና መላ አሳይ ኤንታና ዎስዶሶና። <verse eid="ACT 13:42"/><verse number="43" style="v" sid="ACT 13:43"/>ሺቆይ ላለትዳፐ ጉየ፥ ዳሮ አይሁደትነ አይሁደታ አማኑዋን ገልድ ፆሳ ጎይንያ ዳሮት ጳዉሎሳነ ባርናባሳ ካልዶሶና። አማንዳይሳት ፆሳ አ ኬሀተን ምንድ ዳና መላ ኤንታ ዞርዶሶና። <verse eid="ACT 13:43"/><verse number="44" style="v" sid="ACT 13:44"/>ካልያ ሳምባታን ካታማን ደእያ አሳፐ ዳሮት ፆሳ ቃላ ስአናዉ ሺቅዶሶና። <verse eid="ACT 13:44"/><verse number="45" style="v" sid="ACT 13:45"/>ሽን አይሁደት ዳሮ አሳ በእዳ ዎደ ጳዉሎሳ ቃናትድ እያ ሃሳያ እፅድ እያ ጫይዶሶና።<verse eid="ACT 13:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46"/>ጳዉሎስነ ባርናባስ ያዮና፥ “ፆሳ ቃላይ ኮይሮትድ ህንተዉ ኦደታናዉ ኮሼስ። ሽን ህንተ ቃላ እፅድ መርና ደኡዋ ኤካናዉ ኑስ በሰና ግድ ህንተ፥ ህንተ ሁጰን ፕርድዳ ግሾ ህዛ ኑኒ አይሁደ ግዶናይሳታኮ ስሞስ። <verse eid="ACT 13:46"/><verse number="47" style="v" sid="ACT 13:47"/>ጋሶይካ ጎዳይ፥</para>
  <para style="q1" vid="ACT 13:47">“ ‘አላመ ኩመይ ነ ባጋራ አታና መላ፥</para>
  <para style="q2" vid="ACT 13:47">ታኒ ነና አይሁደ ግዶና ደርያስ ፖኦ ኦስ’ ያግድ ኑና ኪትስ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">13:47 </char><char style="xt" closed="false"><ref loc="ISA 42:6">እሳ 42:6</ref>፤ <ref loc="ISA 49:6">49:6</ref>.</char></note><verse eid="ACT 13:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48"/>አይሁደ ግዶናይሳት ሄሳ ስእዳ ዎደ ኡፋይትድ ፆሳ ቃላ ቦንችዶሶና። ቃስ መርና ደኡዋስ ዶረትዳ ኡባይ አማንዶሶና።<verse eid="ACT 13:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49"/>ጎዳ ቃላይ ሄ ቢታ ኡባ ጋክስ። <verse eid="ACT 13:49"/><verse number="50" style="v" sid="ACT 13:50"/>ሽን አይሁደት፥ አይሁደ ግዶና ፆሰ ጎይንያ ዱረ ማጫሳታነ ካታማን ደእያ ግታ አሳታ ጳዉሎሳ ቦላነ ባርናባሳ ቦላ ደንዶሶና። ሄ አሳት ኤንታ ጎዳ ዶምድ ባንታ ቢታፈ ከስዶሶና። <verse eid="ACT 13:50"/><verse number="51" style="v" sid="ACT 13:51"/>ሽን ጳዉሎሳራነ ባርናባሳራ እፀይሳታስ ማላ ግዳና መላ ባንታ ቶሁዋፐ ባና ፕትድ እቆንዮነ ካታማ ብዶሶና።<note caller="-" style="x"><char style="xo" closed="false">13:51 </char><char style="xt" closed="false"><ref loc="MAT 10:14">ማቶ 10:14</ref>፤ <ref loc="MRK 6:11">ማር 6:11</ref>፤ <ref loc="LUK 9:5">ሉቃ 9:5</ref>፤ <ref loc="LUK 10:11">10:11</ref>.</char></note> <verse eid="ACT 13:51"/><verse number="52" style="v" sid="ACT 13:52"/>ቃስ አንፆከን ደእያ አማነይሳት ጌሻ አያናንነ ኡፋይሳን ኩምዶሶና። <figure style="fig" alt="Paul's 1st Journey" file="Paul1-BW.tif" size="span" loc="ACT 13:1—14:28" ref="13:1—14:28">ጳዉሎስ ዎንገላ ሳባካናዉ ብዳ ኮይሮ ኦግያ</figure><verse eid="ACT 13:52"/></para>
  <chapter eid="ACT 13"/>
  <chapter number="14" style="c" sid="ACT 14"/>
  <para style="s1">ጳዉሎስነ ባርናባስ እቆንዮነን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1"/>ካሰይሳዳካ፥ ጳዉሎስነ ባርናባስ እቆንዮነን አይሁደታ ዎሳ ኬ ገልድ ዳሮ አይሁደትነ አይሁደ ግዶናይሳት አማናና ጋካናዉ ቃላ ኦድዶሶና። <verse eid="ACT 14:1"/><verse number="2" style="v" sid="ACT 14:2"/>ሽን አማንቦና አይሁደት፥ አይሁደ ግዶናይሳታ ዎዛና ላምድ እሻታ ቦላ ደንዶሶና። <verse eid="ACT 14:2"/><verse number="3" style="v" sid="ACT 14:3"/>ሀዋረት ያን ዳሮ ዎደ ጋምእዶሶና። ኤንቲ ያዮና ጎዳባ ኦድዶሶና። ጎዳይ ማላታታነ ኦራባ ኤንቲ ኦና መላ ኤንታዉ ማታ እምድ፥ እ ባ አ ኬሀተ ቃላይ ቱማ ግደይሳ ቆንጭስስ። <verse eid="ACT 14:3"/><verse number="4" style="v" sid="ACT 14:4"/>ሽን ሄ ካታማ አሳይ ሻከትድ፥ ባጋይ አይሁደታራ ባጋይ ቃስ ሀዋረታራ ግድስ።<verse eid="ACT 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5"/>አይሁደ ግዶናይሳትነ አይሁደት ባንታ ሀላቃታራ እስፈ ግድድ ሀዋረታ ቆሀናዉነ ሹቻን ጫዳናዉ ኮይዶሶና። <verse eid="ACT 14:5"/><verse number="6" style="v" sid="ACT 14:6"/>ሀዋረት ሄሳ ኤርድ፥ ልስፅራነ ዳርበ ጌተትያ ልቃኦና ካታማታነ ኤንታ ሄራን ደእያ ቢታ ባቃትዶሶና። <verse eid="ACT 14:6"/><verse number="7" style="v" sid="ACT 14:7"/>ያን ዎንገላ ኦድዶሶና።<verse eid="ACT 14:7"/></para>
  <para style="s1">ጳዉሎስነ ባርናባስ ልስፅራንነ ዳርበን</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8"/>የለቶሳፐ ዶምድ ናምኡ ቶሆይ ዎቢን ሄመት ኤሮና እስ አደይ ልስፅራን ደኤስ። <verse eid="ACT 14:8"/><verse number="9" style="v" sid="ACT 14:9"/>ሄ አደይ ጳዉሎስ ኦድሽን ኡትድ ስኤስ። ጳዉሎስ እያ ትሽ ኦ ፄልያ ዎደ ፓፃናዉ እያዉ አማኖይ ደኤይሳ በእድ፥ <verse eid="ACT 14:9"/><verse number="10" style="v" sid="ACT 14:10"/>ባ ቃላ ቁ ኦድ፥ “ስት ጋዳ ነ ቶሁዋን ኤቃ” ያግስ። ያትን፥ ጉፕ ደንድ ኤቅድ ሄመ ዶምስ።<verse eid="ACT 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11"/>ጳዉሎስ ኦዳይሳ አሳይ በእድ ባንታ ቃላ ቁ ኦድ ልቃኦና ዶናን፥ “ፆሳት አሰ ዳንድ ኑኮ ዎዶሶና” ያግዶሶና። <verse eid="ACT 14:11"/><verse number="12" style="v" sid="ACT 14:12"/>ባርናባሳ፥ “ድያ” ግድ፥ ጳዉሎስ ኦዳን ዋናትያ ግሾ፥ እያ፥ “ሄርመና” ግድ ሱንዶሶና። <verse eid="ACT 14:12"/><verse number="13" style="v" sid="ACT 14:13"/>ካታማፐ ጋፃን ደእያ ኤቃ ድያ ኬ ካህነይነ አሳይ ኮርማታነ አሌቆ ጪሻታ ሀዋረታስ ያርሻናዉ ኮይድ ካታማ ፐንገ ኤህዶሶና።<verse eid="ACT 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14"/>ሽን ባርናባስነ ጳዉሎስ ሄሳ ስእዳ ዎደ ኤንቲ ኦናዉ ቆፕዳይሳ እፅድ፥ ባንታ ማኡዋ ፔዶሶና። አሳ ግዶ ዎፅ ገልድ፥ <verse eid="ACT 14:14"/><verse number="15" style="v" sid="ACT 14:15"/>ባንታ ቃላ ቁ ኦድ፥ “አሳዉ፥ ሀይሳ አይስ ኦቲ? ኑካ ህንተ መላ አሰ። ሀ ፓናባፐ ሳሎነ ሳአ፥ አባነ ኤንታ ግዶን ደእያ ኡባባ መዳ ደኦ ፆሳኮ ህንተ ስማና መላ ህንተዉ ኑኒ ዎንገላ ኦዶስ።<note caller="-" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ከሳ 20:11</ref>፤ <ref loc="PSA 146:6">ማዝ 146:6</ref>.</char></note> <verse eid="ACT 14:15"/><verse number="16" style="v" sid="ACT 14:16"/>እ፥ በን አሳይ ባንታ ኦገ ባና መላ የድ አግስ። <verse eid="ACT 14:16"/><verse number="17" style="v" sid="ACT 14:17"/>ሽን እራ ሳሉዋፐ ቡክስስ፥ ካካ ዎድያን ዎድያን እሚስ፥ ካ እምድ ህንተና ዳሮ ኡፋይስስ፥ ያትድ ህንተዉ ሎኦባ ኦድ ባዉ ማርካ ይስቤና” ያግዶሶና። <verse eid="ACT 14:17"/><verse number="18" style="v" sid="ACT 14:18"/>ሀዋረት ሄሳ ግድ፥ ባንታዉ አሳይ ያርሾና መላ ዋይድ ድግዶሶና።<verse eid="ACT 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19"/>አንፆከፐነ እቆንዮነፐ ይዳ አይሁደት፥ አሳ ባንታ ባጋ ዛሪድ ሹቻን ጳዉሎሳ ጫድዶሶና። እ ሀይቅዳባ ዳንን ካታማፐ ጋፃ ጎች ኤፍድ የግዶሶና። <verse eid="ACT 14:19"/><verse number="20" style="v" sid="ACT 14:20"/>ሽን አማነይሳት ይድ፥ እያ ዩሾን ኤቅዳሽን እ ደንድድ ካታማ ገልስ። ዎንተ ጋላስ ባርናባሳራ እስፈ ዳርበ ብስ።<verse eid="ACT 14:20"/></para>
  <para style="s1">ጳዉሎስነ ባርናባስ ሶረ አንፆከ ስሙዋ</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21"/>ኤንቲ ዳርበ ካታማን ዎንገላ ኦድድ ዳሮታ አማንዳፐ ጉየ ልስፅራ፥ እቆንዮነነ ጵስደን ደእያ አንፆከ ስምዶሶና። <verse eid="ACT 14:21"/><verse number="22" style="v" sid="ACT 14:22"/>ያን አማነይሳታ ምንሸነ ኤንቲ አማኖን ምንድ ደአና መላ ዞርሸ፥ “ፆሳ ካዎተ ገላናዉ ኑኒ ዳሮ ዋየ ኤካናዉ በሴስ” ያግድ ታማርስዶሶና። <verse eid="ACT 14:22"/><verse number="23" style="v" sid="ACT 14:23"/>ቃስ ዎሳ ኬታስ ሁጰን ሁጰን ጭማታ ዶርዶሶና። ፆምዳፐነ ዎስዳፐ ጉየ ኤንቲ አማንዳ ጎዳስ ኤንታ ሀዳራ እምዶሶና።<verse eid="ACT 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24"/>ጵስደ ቢታ ካን አድ ጵንፍለ ብዶሶና። <verse eid="ACT 14:24"/><verse number="25" style="v" sid="ACT 14:25"/>ጰርገን ቃላ ኦድዳፐ ጉየ አፃለ ብዶሶና። <verse eid="ACT 14:25"/><verse number="26" style="v" sid="ACT 14:26"/>ባንታ ኦሱዋ ፖልዳፐ ጉየ፥ አፃለፕ ፆሳ አ ኬሀተስ ኤንታ ሀዳራ እምዳ አንፆከ ማርካበራ ጉየ ስምዶሶና።<verse eid="ACT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27"/>አንፆከ ጋክዳ ዎደ ዎሳ ኬ አሳ ሺሽድ ፆሳይ ኤንታራ ኦዳ ኦሱዋ ኡባነ አይሁደ ግዶና አሳይ አማናና መላ ኤንታዉ ዋት ፐንገ ዶይዳኮ ኦድዶሶና። <verse eid="ACT 14:27"/><verse number="28" style="v" sid="ACT 14:28"/>ሄሳን አማነይሳታራ ዳሮ ዎደ ጋምእዶሶና።<verse eid="ACT 14:28"/></para>
  <chapter eid="ACT 14"/>
  <chapter number="15" style="c" sid="ACT 15"/>
  <para style="s1">የሩሳላመ ሺቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1"/>እስ እስ አሳት ይሁዳፐ አንፆከ ብድ፥ “ሙሰ ዎጋ ህንተ ቃፃረቶና እፅኮ አታናዉ ዳንዳኤከታ” ግድ አማነይሳታ ታማርሶ ዶምዶሶና።<note caller="-" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ሌወ 12:3</ref>.</char></note> <verse eid="ACT 15:1"/><verse number="2" style="v" sid="ACT 15:2"/>ሄስ ጳዉሎሳነ ባርናባሳ ኤንታራ ዳሮ ፓላማናዳነ ካጫናዳ ኦስ። ሄሳ ግሾ፥ አንፆከን ደእያ እስ እስ አሳት ጳዉሎሳራነ ባርናባሳራ የሩሳላመ ብድ ሀዋረታራነ ጭማታራ ጋሄትድ ሄ ኦዳ ብላናዉ ቆፋይ ቃሸትስ።<verse eid="ACT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3"/>ዎሳ ኬይ ኤንታ ኪትን ብዶሶና። ኤንቲ ስሮፍንቀ ሳማረራ አሸ አይሁደ ግዶናይሳት ፆሳኮ ዋንድ ስምዳኮ ኦድዶሶና። ሄስ አማነይሳታ ኡባ ዳሮ ኡፋይስስ። <verse eid="ACT 15:3"/><verse number="4" style="v" sid="ACT 15:4"/>ኤንቲ የሩሳላመ ጋክዳ ዎደ ዎሳ ኬይ፥ ሀዋረትነ ጭማት ኤንታ ሞክዶሶና። ፆሳይ ባንታራ ኦዳባ ኡባ ኦድዶሶና። <verse eid="ACT 15:4"/><verse number="5" style="v" sid="ACT 15:5"/>ሽን ፋርሳወታ ባጋፈ አማንዳ እስ እስ አሳት ደንድ ኤቅድ፥ “አይሁደ ግዶናሽን አማንዳ አሳት ቃፃረታናዉነ ሙሰ ህገ ናጋናዉ በሴስ” ያግዶሶና።<verse eid="ACT 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6"/>ሀዋረትነ ጭማት ሄሳ ዞረታናዉ ሺቅዶሶና። <verse eid="ACT 15:6"/><verse number="7" style="v" sid="ACT 15:7"/>ዳሮ ዞረትዳፐ ጉየ፥ ጰፅሮስ ደንድ ኤቅድ፥ “ታ እሻቶ፥ አይሁደ ግዶናይሳት ዎንገላ ቃላ ታ ዶናፐ ስእድ አማናና መላ ካሰትድ ታና ፆሳይ ህንተ ግዶፈ ዶርዳይሳ ህንተ ኤሬታ።<note caller="-" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ACT 10:1-43">ሀዋ 10:1-43</ref>.</char></note> <verse eid="ACT 15:7"/><verse number="8" style="v" sid="ACT 15:8"/>አሳ ዎዛና ኤርያ ፆሳይ ጌሻ አያና ኑስ እምዳይሳዳ ኤንታዉካ እምድ ቱማይስ።<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 2:4">ሀዋ 2:4</ref>፤ <ref loc="ACT 10:44">10:44</ref>.</char></note> <verse eid="ACT 15:8"/><verse number="9" style="v" sid="ACT 15:9"/>አማኖን ኤንታ ዎዛና ጌሽዳ ግሾ ኑ ግዶንነ ኤንታ ግዶን ዱማተ ዎቤና። <verse eid="ACT 15:9"/><verse number="10" style="v" sid="ACT 15:10"/>ሄሳ ግሾ፥ ኑ አዋትነ ኑኒ ቶካናዉ ዳንዳእቦና ቃምባራ አማነይሳታ ሞርገን ዎድ ሀእ አይስ ህንተ ፆሳ ፓጨቲ? <verse eid="ACT 15:10"/><verse number="11" style="v" sid="ACT 15:11"/>ጎዳ የሱስ ክርስቶሳ አ ኬሀተን ኤንቲ አትዳይሳዳ ኑካ አትዳይሳ አማኖስ” ያግስ።<verse eid="ACT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12"/>አሳይ ስእ ግድ፥ ባርናባስነ ጳዉሎስ አይሁደ ግዶና አሳ ግዶን ባንታ ባጋራ ፆሳይ ኦዳ ማላታታነ ኦራባ ኡባ ኦድሽን ስኦሶና።<verse eid="ACT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 15:13"/>ኤንቲ ሃሳያ ኦንግዳፐ ጉየ ያይቆብ፥ “እሻቶ፥ ታ ገይሳ ስእተ። <verse eid="ACT 15:13"/><verse number="14" style="v" sid="ACT 15:14"/>ፆሳይ አይሁደ ግዶናይሳታ ግዶፈ ባ አሰ ዶራናዉ ኮይድ ኤንታና ኮይሮ ዋትድ ቆፕዳኮ ስሞን ኦድስ። <verse eid="ACT 15:14"/><verse number="15" style="v" sid="ACT 15:15"/>ናበታ ቃላይ ሀይሳራ እስኖ። ጌሻ ማፃፋን፥<verse eid="ACT 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16"/>“ ‘ሀይሳፈ ጉየ፥ ታኒ ስማና፥</para>
  <para style="q2" vid="ACT 15:16">ኩንድዳ ዳዊታ ካዎተ ደንና።<note caller="-" style="x"><char style="xo" closed="false">15:16 </char><char style="xt" closed="false"><ref loc="AMO 9:11-12">አሞ 9:11-12</ref>.</char></note></para>
  <para style="q2" vid="ACT 15:16">ላለትዳ ኬካ ዛራ ኤሳና።<verse eid="ACT 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17"/>አትዳ አሳ ኡባይ ታኮ ያና፥</para>
  <para style="q2" vid="ACT 15:17">ታኒ ፄግዳ አይሁደ ግዶና አሳ ኡባይ ታና ኮያና።<verse eid="ACT 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18"/>በንፐ ዶማዳ ሄስ ኤረታና መላ ኦዳ</para>
  <para style="q2" vid="ACT 15:18">ፆሳይ፥ ታኒ ያጋይስ’ ያጌስ።<verse eid="ACT 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19"/>“ሄሳ ግሾ፥ ታ ቆፋይ ፆሳኮ ስምያ አይሁደ ግዶናይሳታ ኑኒ ዋይሶናኮ ሎኦ። <verse eid="ACT 15:19"/><verse number="20" style="v" sid="ACT 15:20"/>ሽን ኤንቲ ኤቃስ ያርሸትድ ቱንዳባ ሞና መላ፥ ላይማቶና መላ፥ ባዉታ ሞና መላነ ሱ ኡዮና መላ ኤንታዉ ኑኒ ዳብዳበ ፃፋናዉ ኮሼስ።<note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="EXO 34:15-17">ከሳ 34:15-17</ref>፤ <ref loc="LEV 17:10-16">ሌወ 17:10-16</ref>፤ <ref loc="LEV 18:6-23">18:6-23</ref>.</char></note> <verse eid="ACT 15:20"/><verse number="21" style="v" sid="ACT 15:21"/>ሙሰ ህገይ በንፐ ዶምድ ሳምባታን ሳምባታን አይሁደ ዎሳ ኬታን ናባበትሸ ካታማ ኡባን ሳባከቴስ” ያግስ።<verse eid="ACT 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22"/>ሄሳፈ ጉየ፥ ሀዋረትነ ጭማት ዎሳ ኬ አሳ ኡባራ እስፈ ባንታ ግዶፈ ጉ አሳታ ዶርድ ጳዉሎሳራነ ባርናባሳራ አንፆከ የዳናዉ ቆፋ ቃችዶሶና። ኤንቲ ዳሮ ቦንቸትዳ ናምኡ አሳታ ባርሳባሳ ጌተትያ ይሁዳነ ስላሰ ዶርዶሶና። <verse eid="ACT 15:22"/><verse number="23" style="v" sid="ACT 15:23"/>ሀይሳዳ ጌተትድ ፃፈትዳ ዳብዳበ ኤንታ ቦላ የድዶሶና፦ “ኑኒ ሀዋረትነ ጭማት ህንተ እሻት፥ አንፆከን፥ ሶረንነ ክልቀን ደእያ አይሁደ ግዶና እሻታስ ኑ ሳሮዋ ኪቶስ።<verse eid="ACT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 15:24"/>“ኑኒ ኪቶና አሳት ኑ ግዶፈ ብድ፥ ‘ህንተ ቃፃረታናዉነ ህግያ ናጋናዉ በሴስ’ ግድ፥ ህንተና ዋይስዳይሳነ ይሎይዳይሳ ስእዳ። <verse eid="ACT 15:24"/><verse number="25" style="v" sid="ACT 15:25"/>ኑኒ ዶስያ ባርናባሳነ ጳዉሎሳ ዶረትዳ አሳታራ እስፈ ህንተኮ ኪታናዉ እስ ዎዛናን ኑ ቆፋ ቃችዳ። <verse eid="ACT 15:25"/><verse number="26" style="v" sid="ACT 15:26"/>ኤንቲ ኑ ጎዳ የሱስ ክርስቶሳ ግሾ ባንታ ደኡዋ አድ እምዶሶና። <verse eid="ACT 15:26"/><verse number="27" style="v" sid="ACT 15:27"/>ሄሳ ግሾ፥ ኑኒ ፃፍዳይሳ ኤንቲ ባንታ ዶናን ጉጅድ ህንተዉ ኦዳና መላ ይሁዳነ ስላሰ ኪትዳ።<verse eid="ACT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 15:28"/>“ሀ ኮሸይሳታፐ አትሽን፥ ሀራ ቶሆ ህንተና ቶሶና መላ ኑነ ጌሻ አያናይ ኦዳ ቃችዳ። <verse eid="ACT 15:28"/><verse number="29" style="v" sid="ACT 15:29"/>ኤቃስ ያርሸትድ ቱንዳባ ሞፕተ፥ ሱ ኡዮፕተ፥ ባዉታ ሞፕተ፥ ላይማቶፕተ። ሀ ኡባፈ ህንተ ሁጵያ ናግኮ ህንተ ሎኦባ ኦታ። ህዛ፥ ሳሮ ደእተ” ያግዶሶና።<verse eid="ACT 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30"/>ሄሳ ግሾ፥ ኪተትዳይሳት ሞይዘትድ አንፆከ ብድ አማንያ አሳ ሺሽድ፥ ዳብዳበ እምዶሶና። <verse eid="ACT 15:30"/><verse number="31" style="v" sid="ACT 15:31"/>ኤንቲ ሄ ምንያ ዳብዳብያ ናባብዳ ዎደ ኡፋይትዶሶና። <verse eid="ACT 15:31"/><verse number="32" style="v" sid="ACT 15:32"/>ቃስ ይሁድነ ስላሰይ ባንታ ሁጰን ናበ ግድያ ግሾ አማነይሳታ ሎይ ዞርድ ምንዶሶና። <verse eid="ACT 15:32"/><verse number="33" style="v" sid="ACT 15:33"/>ኤንቲ አንፆከን ጉ ጋላስ ኡትዳፐ ጉየ እሻት ሎኦራ ሞይዝን ባንታና ኪትዳይሳታኮ ስምዶሶና። <verse eid="ACT 15:33"/><verse number="34" style="v" sid="ACT 15:34"/><note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">እስ እስ ማፃፋታን ፓይዶ 34 ባዋ።</char></note> [ሽን ስላሰይ ያን አታናዉ ኮይስ]።<verse eid="ACT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35"/>ቃስ ጳዉሎስነ ባርናባስ ሀራ ዳሮ አሳታራ እስፈ ጎዳ ቃላ ታማርስሸነ ዎንገላ ኦድሸ አንፆከን ጋምእዶሶና።<verse eid="ACT 15:35"/></para>
  <para style="s1">ጳዉሎሳነ ባርናባሳ ሻከተ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36"/>ጉ ጋላሳፐ ጉየ ጳዉሎስ ባርናባሳኮ፥ “ኑኒ ጎዳ ቃላ ኦድዳ ካታማ ኡባን አማነይሳት ዋንድ ደእያኮ ጉየ ስምሸ ፆሞስ በኦስ” ያግስ። <verse eid="ACT 15:36"/><verse number="37" style="v" sid="ACT 15:37"/>ባርናባስ ማርቆሳ ጌተትያ ዮሃንሳ ባንታራ ኤፋናዉ ኮይስ። <verse eid="ACT 15:37"/><verse number="38" style="v" sid="ACT 15:38"/>ሽን ጳዉሎስ ማርቆሳ ባንታራ ኤፋናዉ ኮይቤና። ጋሶይካ፥ እ ጵንፍለን ሻከትድ ኤንታራ ኦናዉ ብቤና።<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="ACT 13:13">ሀዋ 13:13</ref>.</char></note> <verse eid="ACT 15:38"/><verse number="39" style="v" sid="ACT 15:39"/>ኤንታ ግዶን ኢታ ኦሽ ከይን እሶይ እሱዋፈ ሻከትዶሶና። ባርናባስ ማርቆሳ ኤክድ ማርካበራ ቆጵሮሳ ብስ። <verse eid="ACT 15:39"/><verse number="40" style="v" sid="ACT 15:40"/>ሽን ጳዉሎስ ስላሰ ዶርስ፤ አማነይሳት ጳዉሎሳ ፆሳ አ ኬሀተስ ሀዳራ እምዳፐ ጉየ፥ እ ከይድ ብስ። <verse eid="ACT 15:40"/><verse number="41" style="v" sid="ACT 15:41"/>ያትድ፥ ዎሳ ኬታ ምንሸ ሶረራነ ክልቅያራ አስ። <figure style="fig" alt="Paul's 2nd Journey" file="Paul2-BW.tif" size="span" loc="ACT 15:36—18:22" ref="15:36—18:22">ጳዉሎስ ዎንገላ ሳባካናዉ ብዳ ናምአን ኦግያ</figure><verse eid="ACT 15:41"/></para>
  <chapter eid="ACT 15"/>
  <chapter number="16" style="c" sid="ACT 16"/>
  <para style="s1">ፅሞትዮስ ጳዉሎሳራነ ስላሰራ ጋሄትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1"/>ጳዉሎስ ዳርበነ ልስፅራ ብስ። ያን ፅሞትዮሳ ጌተትያ አማንያ አስ ደኤስ። እያ አይያ አማንያ አይሁደ ማጫስ፥ እያ አዋይ ግርከ አስ። <verse eid="ACT 16:1"/><verse number="2" style="v" sid="ACT 16:2"/>ልስፅራንነ እቆንዮነን ደእያ አማነይሳት ፅሞትዮሳባ ሎይድ ማርካትዶሶና። <verse eid="ACT 16:2"/><verse number="3" style="v" sid="ACT 16:3"/>ጳዉሎስ ፅሞትዮሳ ባራ ኤፋናዉ ኮይድ፥ እያ አዋይ ግርከ አስ ግድዳይሳ ሄ በሳን ደእያ አይሁደ ኡባይ ኤርያ ግሾ እያ ቃፃርስ። <verse eid="ACT 16:3"/><verse number="4" style="v" sid="ACT 16:4"/>ኤንቲ ካታማታራ ብሸ የሩሳላመን ደእያ ሀዋረትነ ጭማት ዎዳ ህግያ አማነይሳት ናጋና መላ ኤንታዉ ኦድሸ አዶሶና። <verse eid="ACT 16:4"/><verse number="5" style="v" sid="ACT 16:5"/>ሄሳ ግሾ፥ ዎሳ ኬት አማኖን ምንሸ፥ ታይቦንካ ጋላስ ጋላስ ዳር ዳር ብዶሶና።<verse eid="ACT 16:5"/></para>
  <para style="s1">ጳዉሎስ ማቀዶነ ባናዉ ፄገትስ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6"/>ኢሰን ቃላ ኦዶና መላ ጌሻ አያናይ ኤንታ ድግዳ ግሾ፥ ፕርገራነ ጋላትያ ቢታራ አዶሶና። <verse eid="ACT 16:6"/><verse number="7" style="v" sid="ACT 16:7"/>ኤንቲ ሚሰ ዛዋ ጋክዳ ዎደ ብታነ ባናዉ ኮይዶሶና። ሽን የሱሳ አያናይ ኤንታ ድግስ። <verse eid="ACT 16:7"/><verse number="8" style="v" sid="ACT 16:8"/>ሄሳ ግሾ፥ ኤንቲ ሚሰ ማታራ አሸ ፅሮኣዳ ዎዶሶና። <verse eid="ACT 16:8"/><verse number="9" style="v" sid="ACT 16:9"/>ጳዉሎስ ቃማ ቆንጨን እስ ማቀዶነ አስ ባኮ፥ “ማቀዶነ ፕናዳ ኑና ማዳርክ” ያግሸ ኤቅድ ዎስሽን በእስ። <verse eid="ACT 16:9"/><verse number="10" style="v" sid="ACT 16:10"/>ቆንጨ እ በእዳፐ ጉየ ኤለስድ ኑኒ ማቀዶነ ባናዉ ኮይዳ። አይስ ጊኮ፥ ዎንገላ ያን ደእያ አሳስ ኦዳናዉ ፆሳይ ኑና ፄግዳይሳ ኤርዳ።<verse eid="ACT 16:10"/></para>
  <para style="s1">ሊድያ ክርስቶሳ አማናሱ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11"/>ፅሮኣዳፐ ደንድድ ማርካበን ገልድ ሳሞትራቀ ብዳ፥ ዎንተ ጋላስ ናጱለ ብዳ። <verse eid="ACT 16:11"/><verse number="12" style="v" sid="ACT 16:12"/>ያፐ ደንድድ ማቀዶነ ቢታን ደእያ ፍልጵስዩሳ ካታማ ብዳ። ፍልጵስዩስ ሮመ አሳይ ደእያ ካታማ። ኑኒ ሄ ካታማን ጉ ጋላስ ኡትዳ።<verse eid="ACT 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13"/>ሳምባታ ጋላስ ካታማፐ ጋፃን ሻፋ ዶናን አይሁደት ፆሳ ዎስያ በሲ ደኤይሳ ኤርድ ያ ብዳ። ሄ በሳን ሺቅዳ ማጫሳስ ቃላ ኦድዳ።<verse eid="ACT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 16:14"/>ኑና ስእያ አሳፐ እስ ሊድያ ጌተትያ ትያትሮና ካታማፐ ይዳ፥ ፆሳ አማንዳ ዞኦ አፍላ ዛልእያ፥ ማጫስያ ደአዉሱ። ጳዉሎስ ኦደይሳ እያ ስአና መላ ፆሳይ እ ዎዛና ዶይስ። <verse eid="ACT 16:14"/><verse number="15" style="v" sid="ACT 16:15"/>ሊድያ ባ ሶ አሳራ እስፈ ፃማቀትዳፐ ጉየ ኑኮ፥ “ህንተ ታና ጎዳ ቱማ አማናሱ ጊኮ ታ ሶ የተ” ጋዳ ምንዳ ዎሳሱ።<verse eid="ACT 16:15"/></para>
  <para style="s1">ጳዉሎስነ ስላሰይ ቃሸትዶሶና</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16"/>ኑኒ ፆሳ ዎስያ በሳ ብሽን ኢታ አያናይ እ ቦላ ደእድ ማሮያ እስ ጌላኦ ጋንዶይ ኑራ ጋሄታሱ። እያ ካያዳ ዳሮ ሚሸ ባ ጎዳታስ ኤሀዉሱ። <verse eid="ACT 16:16"/><verse number="17" style="v" sid="ACT 16:17"/>ጳዉሎሳነ ኑና ካላዳ፥ “ሀይሳቲ ኡባፈ ቦላ ፆሳ አይለታ! ኤንቲ ህንተ አታና ኦገ ኦደይሳታ” ጋዳ ዋሳሱ።<verse eid="ACT 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 16:18"/>ኡባ ጋላስ ሄሳዳ ጋዉሱ። ሽን ጳዉሎስ ይሎትድ ጉየ ስሚድ፥ ሄ አያና፥ “የሱስ ክርስቶሳ ሱንን ኔኒ ኢፐ ከያ” ግድ ኪትስ። ኢራካ ኢታ አያናይ ኢፐ ከይ አግስ።<verse eid="ACT 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19"/>ሽን እ ጎዳት ባንታዉ ሚሸ ደምያ ኦገይ ይዳይሳ በእድ፥ ጳዉሎሳነ ስላሰ ኦይክድ፥ ዳባባ ዳይናታ ስን ጎች ኤፍዶሶና። <verse eid="ACT 16:19"/><verse number="20" style="v" sid="ACT 16:20"/>ዳይናታ ስን ኤንታ ኤፍድ፥ “ሀይሳቲ አይሁደ አስ ግድሸ ኑ ካታማ አሳ ዳሮ ዋይሶሶና። <verse eid="ACT 16:20"/><verse number="21" style="v" sid="ACT 16:21"/>ኑኒ ሮመ ቢታ አስ ግድሸ ኤካናዉነ ኦናዉ ዎጋ ግዶናባ ታማርሶሶና” ያግዶሶና።<verse eid="ACT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22"/>አሳይ እስ ባጋ ግድድ፥ ጳዉሎሳ ቦላነ ስላሰ ቦላ ደንድዶሶና። ዳይናት ኤንታ ማኡዋ ቃርድ ፃምአን ሾጫና መላ ኪትዶሶና። <verse eid="ACT 16:22"/><verse number="23" style="v" sid="ACT 16:23"/>ኤንታ ዳሮ ዋዳፐ ጉየ፥ ቃሾ ኬ ገልስዶሶና። ቃሾ ኬ ናገይስካ ኤንታ ምን ናጋና መላ ኪትዶሶና። <verse eid="ACT 16:23"/><verse number="24" style="v" sid="ACT 16:24"/>ቃሾ ኬ ናገይስ ሄ ኪታ ኤክድ፥ ጳዉሎሳነ ስላሰ ቃሾ ኬስ ቆልአ ገልስስ። ኤንታ ቶሁዋ ዱፅስ።<verse eid="ACT 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25"/>ሽን ግድ ብላሄ ግድያ ዎደ ጳዉሎሳራነ ስላሰራ ዎስሸነ ማዝሙረ የፅሸ ፆሳ ጋላቶሶና። ቃሾ ኬን ደእያ ሀራ አሳትካ ኤንቲ ግያባ ስኦሶና።<figure style="fig" alt="Paul and Silas in stocks" file="LB00337B.tif" size="span" ref="16:25">ጳዉሎስነ ስላሰይ ዱፀትድ ደእሽን</figure> <verse eid="ACT 16:25"/><verse number="26" style="v" sid="ACT 16:26"/>ቆፖና ቃሾ ኬ ባሶይ ቃፃና ጋካናዉ ቢታ ቃፆይ ሀንስ። ሄ ሳተንካ ፐንገ ኡባይ ዶየትስ፤ ቃሸትዳ አሳ ኡባ ሳንላታይ ብርሸት ዎስ። <verse eid="ACT 16:26"/><verse number="27" style="v" sid="ACT 16:27"/>ቃሾ ኬ ናገይስ ስኮፈ ባርክዳ ዎደ ቃሾ ኬ ፐንገ ኡባይ ዶየትዳይሳ በእድ ቃሾ አሳይ ከስ ኤክ ብዳባ ዳንን ባና ዎናዉ ማሸ ኤክስ። <verse eid="ACT 16:27"/><verse number="28" style="v" sid="ACT 16:28"/>ሽን ጳዉሎስ ቃላ ቁ ኦድ “ኑ ኡባይ ሀይሳን ደእያ ግሾ ኔኒ ነና ቆሆፓ” ያግስ።<verse eid="ACT 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29"/>ቃሾ ኬ ናገይስ ፆምፐ ዎስ ኤክድ ኤለስድ ጋ ዎፅስ። ኮኮርሸ ጳዉሎሳ ስንንነ ስላሰ ስንን ጉፋንስ። <verse eid="ACT 16:29"/><verse number="30" style="v" sid="ACT 16:30"/>ኤንታ ካረ ከስድ፥ “ታ ጎዳቶ፥ ታኒ አታናዉ አይ ኦናዉ በሲ?” ያግስ።<verse eid="ACT 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31"/>ጳዉሎሳራነ ስላሰራ እያኮ፥ “ጎዳ የሱስ ክርስቶሳ አማና፤ ኔራነ ነ ሶ አሳራ አታና” ያግዶሶና። <verse eid="ACT 16:31"/><verse number="32" style="v" sid="ACT 16:32"/>ኤንቲ እያስነ እያ ሶን ደእያ ኡባስ ጎዳ ቃላ ኦድዶሶና። <verse eid="ACT 16:32"/><verse number="33" style="v" sid="ACT 16:33"/>ቃማ ሄ ሳተንካ ቃሾ ኬ ናገይስ ኤንታ ኤፍድ ኤንታ ማዱን ሜጭስ። ኤለስድ ባ ሶ አሳ ኡባራ ፃማቀትስ። <verse eid="ACT 16:33"/><verse number="34" style="v" sid="ACT 16:34"/>ጳዉሎሳነ ስላሰ ባ ሶ ኤፍድ ኤንታዉ ካ አስ። እ ባ ሶ አሳ ኡባራ ፆሳ አማንዳ ግሾ ኡፋይትስ።<verse eid="ACT 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35"/>ሳእ ዎንትን ዳይናት፥ “ሄ አሳታ ብላ” ያግድ ዎታዳረታ ሀላቃታ እያኮ ኪትዶሶና። <verse eid="ACT 16:35"/><verse number="36" style="v" sid="ACT 16:36"/>ቃሾ ኬ ናገይስ፥ “ህንተ ብለታና መላ ዳይናት ኪትዶሶና። ህዛ፥ ከይድ ሳሮ ቢተ” ያግድ ሄ ኪታ ጳዉሎሳስ ኦድስ።<verse eid="ACT 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37"/>ሽን ጳዉሎስ፥ “ኑኒ ሮመ አስ<note caller="+" style="f"><char style="fr" closed="false">16:37 </char><char style="fq" closed="false">ሮመ አስ፦ </char><char style="ft" closed="false">ጳዉሎስ ሮመ አስ ያግድ ባና ፄግዳይ ሄ ዎደ አይሁደ ቢታ ሃረይ ሮመ ካዎተ ግድዳ ግሾሳ። ሄ ዎደ ሮመ ቢታን ደእያ አሳይ ፕርድ ባይና ጋራፈቶኮና።</char></note> ግድሽን ኤንቲ ኑና ፕርድ ባይና አሳ ስንን ዋድ፥ ቃሾ ኬን የግዶሶና። ሀእ ኑና ጌማን ከይድ ቦ ጎና? ሀነና፥ ኤንቲ ባንታ ሁጰን ይድ ኑና ከሶ” ያግስ።<verse eid="ACT 16:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38"/>ዎታዳረ ሀላቃት ዳይናታስ ሄሳ ኦድን፥ ጳዉሎሳራነ ስላሰራ ሮመ ቢታ አሰ ግድዳይሳ ስእዳ ዎደ ያይዶሶና። <verse eid="ACT 16:38"/><verse number="39" style="v" sid="ACT 16:39"/>ሄሳ ግሾ፥ ዳይናት ይድ ኤንታኮ፥ “ኑኒ ህንተና ቆህዳ” ግዶሶና። ቃሾ ኬፈ ካረ ኤንታ ከስድ፥ ካታማፐ ከይድ ባና መላ ዎስዶሶና። <verse eid="ACT 16:39"/><verse number="40" style="v" sid="ACT 16:40"/>ጳዉሎሳራነ ስላሰራ ቃሾ ኬፈ ከይድ ሊድያ ሶ ብዶሶና። ያን አማነይሳታራ ጋከትድ ኤንታ ምንድ ከይድ ብዶሶና።<verse eid="ACT 16:40"/></para>
  <chapter eid="ACT 16"/>
  <chapter number="17" style="c" sid="ACT 17"/>
  <para style="s1">ጳዉሎስ ተሰሎንቀን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1"/>ጳዉሎሳራነ ስላሰራ አምፍጶልሳራነ አጶሎናራ አድ ተሰሎንቀ ብዶሶና። ያን አይሁደ ዎሳ ኬ ደኤስ። <verse eid="ACT 17:1"/><verse number="2" style="v" sid="ACT 17:2"/>ጳዉሎስ ካሰይሳዳ ያ ገልስ። ሄሳን ሄ ሳምንታ ፆሳ ቃላፐ አሳስ ኦድስ። <verse eid="ACT 17:2"/><verse number="3" style="v" sid="ACT 17:3"/>ክርስቶስ ዋየ ኤካናዉነ ሀይቆፐ ደንዳናዉ በሰይሳ ኤንታዉ ቆንጭስድ ኦድሸ፥ “የሱሲ ሀ ታኒ ህንተዉ ኦደይስ ክርስቶሳ” ያግስ። <verse eid="ACT 17:3"/><verse number="4" style="v" sid="ACT 17:4"/>ኤንታፈ እሶት እሶት ኦዳይ ቱማ ግደይሳ ማእድ ጳዉሎሳራነ ስላሰራ እስፍዶሶና። ሄሳዳካ፥ ፆሳ ጎይንያ ዳሮ ግርከ አሳይነ ዳሮ ቦንቸትዳ ማጫሳትካ ኤንታራ እስፍዶሶና።<verse eid="ACT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5"/>ሽን አይሁደት ቃናትድ እስ እስ ኦሶይ ባይና ኢታ አሳታ ኦገፐ ሺሽዶሶና። ካታማን ቡቀ ከስዶሶና፤ ጳዉሎሳነ ስላሰ አሳስ አድ እማናዉ ኮይድ ያሶና ኬ ተቅዶሶና። <verse eid="ACT 17:5"/><verse number="6" style="v" sid="ACT 17:6"/>ጳዉሎስነ ስላ ኤንታዉ በንቶና እፅን፥ ያሶናነ እስ እስ አማነይሳታ ካታማ ሀላቃታኮ ጎች ኤፍድ፥ “ሀይሳቲ ቢታ ኡባ ቡቀይሳት ሀእ ኑኮ ይዶሶና። <verse eid="ACT 17:6"/><verse number="7" style="v" sid="ACT 17:7"/>ያሶን ኤንታ ባ ሶን ዎስ። ሀይሳቲ፥ ‘የሱሳ ጌተትያ ሀራ ካዎይ ደኤስ’ ግድ ቄሳረ ኪታ መንሶና” ያግድ ቁ ግዳ ቃላን ኦድዶሶና።<verse eid="ACT 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 17:8"/>ሺቅዳ አሳይነ ካታማ ሀላቃት ሄሳ ስእድ ሀናናባ ይዶሶና። <verse eid="ACT 17:8"/><verse number="9" style="v" sid="ACT 17:9"/>ሀላቃት ያሶናነ ሀራታ ዋሰራ ብልዶሶና።<verse eid="ACT 17:9"/></para>
  <para style="s1">ጳዉሎስ ቤርያን</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10"/>አማነይሳት ጳዉሎሳነ ስላሰ ቃማራ ቤርያ የድዶሶና። ቤርያ ጋክድ፥ አይሁደ ዎሳ ኬ ገልዶሶና። <verse eid="ACT 17:10"/><verse number="11" style="v" sid="ACT 17:11"/>ቤርያ አሳይ ተሰሎንቀ አሳፐ አዳ ሱረታ። ኤንቲ ቃላ ኩመ ዎዛናፐ ኤክዶሶና፤ ጳዉሎስ ግዳይስ ቱማ ግደይሳ ሻክ ኤራናዉ ጋላስ ጋላስ ጌሻ ማፃፋታ ፕልጎሶና። <verse eid="ACT 17:11"/><verse number="12" style="v" sid="ACT 17:12"/>ሄሳ ግሾ፥ ኤንታፈ ዳሮት፥ ግርከታፐካ ቦንቸትዳ ዳሮ ማጫሳትነ ዳሮ አደት አማንዶሶና።<verse eid="ACT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13"/>ሽን ተሰሎንቀን ደእያ አይሁደት ጳዉሎስ ፆሳ ቃላ ቤርያንካ ኦድዳይሳ ስእዳ ዎደ ቤርያ ይድ አሳ ቡቅዶሶና። <verse eid="ACT 17:13"/><verse number="14" style="v" sid="ACT 17:14"/>ሄሳፈ ጉየ፥ አማነይሳት ኤለስድ ጳዉሎሳ አባ ማት የድዶሶና። ሽን ስላሰይነ ፅሞትዮስ ቤርያን አትዶሶና። <verse eid="ACT 17:14"/><verse number="15" style="v" sid="ACT 17:15"/>ጳዉሎሳ ሞይዝዳ አሳት አቴና ጋዶሶና። ሄ አሳት ስላሰይነ ፅሞትዮስ ባንታዉ ዳንዳኤትዳ መላ ኤለስድ ባኮ ያና መላ ጳዉሎስ ኪትዳ ኪታ ኤክድ ቤርያ ስምዶሶና።<verse eid="ACT 17:15"/></para>
  <para style="s1">ጳዉሎስ አቴናን</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16"/>ጳዉሎስ አቴናን ስላሰነ ፅሞትዮሳ ናግሸ፥ ካታማን ኤቅ ኩምዳይሳ በእድ ይሎትስ። <verse eid="ACT 17:16"/><verse number="17" style="v" sid="ACT 17:17"/>ሄሳ ግሾ፥ አይሁደ ዎሳ ኬን አይሁደታራነ ፆሳ ጎይንያ አይሁደ ግዶና አሳራ ቃስ ባራ ጋሄትያ አሳራ ኡባ ጋላስ ፓላሜስ። <verse eid="ACT 17:17"/><verse number="18" style="v" sid="ACT 17:18"/>ኤፕቆሮሰነ እስቶይከ ጌተትያ ጩጋታፐ እስ እስ ኤራንቾት ጳዉሎሳራ ፓላምዶሶና። ኤንታፈ እሶት እሶት፥ “ሀ ዮያማይ አይ ኦዳናዉ ኮዪ?” ያግዶሶና።</para>
  <para style="p" vid="ACT 17:18">ሀራት ጳዉሎስ የሱሳባነ ሀይቆፐ እ ደንድዳይሳ ባንታዉ ኦድዳ ግሾ፥ “ኦራ ፆሳታባ ኦድያ ዳኔስ” ያግዶሶና።<verse eid="ACT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 17:19"/>ጳዉሎሳ ኦይክድ አርዮስፓጎሳ ጌተትያ ሺቆ በሳ ኤፍድ፥ “ሀ ኔኒ ታማርስያ ኦራባይ አይበኮ ኑና ኤርስኪ? <verse eid="ACT 17:19"/><verse number="20" style="v" sid="ACT 17:20"/>አይስ ጊኮ፥ ኔኒ ኑስ ኦራባ ኦዳሳ፤ ህዛ ሄስ አይበኮ ኑኒ ኤራናዉ ኮዮስ” ያግዶሶና። <verse eid="ACT 17:20"/><verse number="21" style="v" sid="ACT 17:21"/>አቴና አሳ ኡባይነ ያን ደእያ እማ አሳይ ኦራባ ኦደቶናነ ስኦና ፔኦኮና።<verse eid="ACT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22"/>ጳዉሎስ አርዮስፓጎሳ ስንን ኤቅድ፥ “አቴና አሳቶ፥ ፆሳታስ ኡባባን ህንተ ዳሮ ያየይሳ ታኒ በአይስ። <verse eid="ACT 17:22"/><verse number="23" style="v" sid="ACT 17:23"/>ታኒ ህንተ ካታማራ ዩያሸ ህንተ ጎይንያ በሳታ በእያ ዎደ፥ ‘ኤረቶና ፆሳስ’ ጌተትድ ፃፈትዳ ያርሾ በሳ ደማስ። ሀ ህንተ ኤሮናሽን ጎይነይሳ ታኒ ህንተዉ ኦዳይስ። <verse eid="ACT 17:23"/><verse number="24" style="v" sid="ACT 17:24"/>ሳአነ ሳአን ደእያ ኡባባ መዳ ፆሳይ፥ ሳሎነ ሳአ ጎዳይ፥ አስ ኬፅዳ ኬን ዴና።<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="1KI 8:27">1 ካዎ 8:27</ref>፤ <ref loc="ISA 42:5">እሳ 42:5</ref>፤ <ref loc="ACT 7:48">ሀዋ 7:48</ref>.</char></note> <verse eid="ACT 17:24"/><verse number="25" style="v" sid="ACT 17:25"/>እ ደኦ፥ ሸምፖነ ኡባባ አሳ ኡባስ እምያ ግሾ ፓጭ ደእያ አሳዳ አሳ ማደ ኮየና። <verse eid="ACT 17:25"/><verse number="26" style="v" sid="ACT 17:26"/>ፆሳይ አሳ ኮቸ ኡባ እስ አድያፈ መድ ቢታ ኡባን ዎስ። ያትድ ኤንቲ ዳና ዎድያስነ በሳስ ዛዋ እሚስ። <verse eid="ACT 17:26"/><verse number="27" style="v" sid="ACT 17:27"/>እ ሄሳ ኦዳይ አስ እያ ኮያና መላነ ፕልግድ ደማና መላሳ። ሀንኮካ እ ኑፐ ጌምቤና። <verse eid="ACT 17:27"/><verse number="28" style="v" sid="ACT 17:28"/>ህንተፈ እስ እስ የፀይሳት፥ ‘ኑኒ እያ ናይታ’ ግዳይሳዳ፥ ‘ኑኒ እያን ፓፃ ደኦስ፥ ቃፆስ።’ <verse eid="ACT 17:28"/><verse number="29" style="v" sid="ACT 17:29"/>ህዛ፥ ኑኒ ፆሳ ናይታ ግድያ ግሾ፥ ‘ፆሳይ አሳ ሂላተንነ ቆፋን ዎርቃፈ ዎይኮ ብራፐ ዎይኮ ሹቻፈ ኦሰትዳባ ዳኔስ’ ያግድ ቆፓናዉ በሰና። <verse eid="ACT 17:29"/><verse number="30" style="v" sid="ACT 17:30"/>ሄሳ ግሾ፥ ፆሳይ በን ዎደ አሳይ ኤሮና ኦዳይሳ አግድ አስ። ሽን ሀእ ኡባ በሳን ደእያ አሳይ ናጋራፐ ስማና መላ ኪቴስ። <verse eid="ACT 17:30"/><verse number="31" style="v" sid="ACT 17:31"/>አይስ ጊኮ፥ ፆሳይ ባ ዶርዳ አድያን ሳአን ደእያ አሳ ኡባ ቦላ ፅሎ ፕርዳ ፕርዳናዉ ቃማ ጊግስ ዎስ። እያ ሀይቆፐ ደንድ ሄሳ አሳ ኡባስ ቱማይስ” ያግስ።<verse eid="ACT 17:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32"/>ኤንታፈ እስ እስ አሳት ሀይቆፐ ደንዶባ ጳዉሎሳፐ ስእድ፥ እያ ቦላ ቀልቅስዶሶና። ሽን ሀራት፥ “ኑኒ ሄሳ ኔፐ ጉጅድ ስአናዉ ኮዮስ” ያግዶሶና። <verse eid="ACT 17:32"/><verse number="33" style="v" sid="ACT 17:33"/>ሄሳ ግሾ፥ ጳዉሎስ ኤንታ ግዶፈ ከይስ። <verse eid="ACT 17:33"/><verse number="34" style="v" sid="ACT 17:34"/>ሽን እስ እስ አደት ጳዉሎሳራ ጋከትድ አማንዶሶና። ኤንታ ግዶፈ አርዮስፓጎሳን ሺቁዋን ደእያ ድዮናስዮሳ ጌተትያ አደይ፥ ዳማርሶ ጌተትያ እስ ማጫስያነ ሀራት ደኦሶና።<verse eid="ACT 17:34"/></para>
  <chapter eid="ACT 17"/>
  <chapter number="18" style="c" sid="ACT 18"/>
  <para style="s1">ጳዉሎስ ቆሮንቶሳን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1"/>ሄሳፈ ጉየ፥ ጳዉሎስ አቴናፐ ከይድ፥ ቆሮንቶሳ ብስ። <verse eid="ACT 18:1"/><verse number="2" style="v" sid="ACT 18:2"/>ያን ጳንፆሳን የለትዳ እስ አይሁደ አድያ አቅላ ደምስ። አይሁደ አሳ ኡባይ ሮመፐ ከያና መላ ካዎይ ቃላዉድዮስ ኪትዳ ግሾ ጉ ዎደፐ ካሰ እ ባ ማቸ ጵርስቅላራ ፃለፐ ይስ። ጳዉሎስ ኤንታራ ጋሄታናዉ ብስ። <verse eid="ACT 18:2"/><verse number="3" style="v" sid="ACT 18:3"/>እያ ኦሶይ ኤንታይሳዳ ዱንካነ ስኮ ግድያ ግሾ፥ ኤንታራ ኡትድ እስፈ ኦስ። <verse eid="ACT 18:3"/><verse number="4" style="v" sid="ACT 18:4"/>ጳዉሎስ ሳምባታ ኡባን አይሁደታነ ግርከታ አማንናዉ አይሁደ ዎሳ ኬን ፓላሜስ።<verse eid="ACT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5"/>ስላሰይነ ፅሞትዮስ ማቀዶነፐ ይዳ ዎደ ጳዉሎስ ባ ኩመ ዎድያ እምድ አይሁደታስ የሱሲ እ፥ ክርስቶሳ ግድ ቃላ ኦድስ። <verse eid="ACT 18:5"/><verse number="6" style="v" sid="ACT 18:6"/>ሽን ኤንቲ ጳዉሎሳ እፅድ እያ ጫይን ጳዉሎስ ባ ማኡዋፐ ባና ቆቆፍሸ፥ “ህንተ ጎመይ ህንተና ኦይኮ፤ ታኒ ሄሳን ደእከ። ህዛፐ ጉየ፥ ታኒ አይሁደ ግዶና አሳኮ ባይስ” ያግስ።<verse eid="ACT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7"/>ያፐ ከይድ ፆሳ ጎይንያ ትቶስ ዮስፆሳ ጌተትያ ኡራ ሶ ብስ። ዮስፆሳ ኬይ አይሁደ ዎሳ ኬ ማታን ደኤስ። <verse eid="ACT 18:7"/><verse number="8" style="v" sid="ACT 18:8"/>አይሁደ ዎሳ ኬ ሀላቃይ ቃርስጶስ ባ ሶ አሳ ኡባራ ጎዳ አማንስ። ቆሮንቶሳ አሳታፐካ ዳሮት ፆሳ ቃላ ስእዳ ዎደ አማንድ ፃማቀትዶሶና።<verse eid="ACT 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9"/>ጎዳይ እስ ቃማ ጳዉሎሳስ ቆንጭድ፥ “ያዮፋ፤ ኦዳ፥ ስእ ጎፓ። <verse eid="ACT 18:9"/><verse number="10" style="v" sid="ACT 18:10"/>ታኒ ኔራ ደአይስ። ታዉ ሀ ካታማን ዳሮ አስ ደእያ ግሾ ነና ቆህድ ኢታባን የጋና አስ ኦንካ ባዋ” ያግስ። <verse eid="ACT 18:10"/><verse number="11" style="v" sid="ACT 18:11"/>ሄሳ ግሾ፥ ጳዉሎስ ፆሳ ቃላ አሳ ታማርስሸ እስ ላይነ ኡሱፑን አጌና ኤንታራ ኡትስ።<verse eid="ACT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12"/>ጋልዮስ አካያ ቢታ አይስያ ዎደ አይሁደት እስፈ ጳዉሎሳ ቦላ ደንድድ ፕርዳ ኬ እያ ኤፍድ፥ <verse eid="ACT 18:12"/><verse number="13" style="v" sid="ACT 18:13"/>“ሀ አደይ ህግያ እፅድ፥ አሳይ ፆሳ ጎይናና መላ ኦስ” ያግዶሶና።<verse eid="ACT 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14"/>ጳዉሎስ ኦደታና ሀንሽን፥ ጋልዮስ አይሁደታኮ፥ “አይሁደቶ፥ ሄስ ኢታ ኦሶ ዎይኮ ናቆ ግድያኮ ታኒ ህንተባ ዳንዳአዳ ስአናዉ በሴስ። <verse eid="ACT 18:14"/><verse number="15" style="v" sid="ACT 18:15"/>ሽን ቃላስ፥ ሱንስነ ህንተ ህግያስ ህንተ ፓላምያባ ግድኮ ህንተ፥ ህንተዉ ብልተ፤ ሄሳ ታኒ ፕርድከ” ያግስ። <verse eid="ACT 18:15"/><verse number="16" style="v" sid="ACT 18:16"/>ያትድ፥ ኤንታ ፕርዳ ኬፈ ካረ ከስስ። <verse eid="ACT 18:16"/><verse number="17" style="v" sid="ACT 18:17"/>ሄሳፈ ጉየ፥ ግርከ አሳ ኡባይ አይሁደ ዎሳ ኬ ሀላቃ ሶስተኔሳ ኦይክድ ፕርዳ ኬ ስንን ዋዶሶና። ሽን ጋልዮስ ሄሳ ፓፃባ ግቤና።<verse eid="ACT 18:17"/></para>
  <para style="s1">ጵርስቅላ፥ አቅላነ አጵሎሳ</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18"/>ጳዉሎስ ዳሮ ጋላስ ቆሮንቶሳን ኡትዳፐ ጉየ አማንያ አሳ ሳሮድ፥ ጵርስቅልራነ አቅላራ ማርካበን ሶረ ብስ። ሽን እ ባናፐ ስን ባዉ ጋሶይ ደእያ ግሾ ክንክራ ካታማን ባ ሁጵያ ቡሉሰትስ።<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="NUM 6:18">ታይቦ 6:18</ref>.</char></note> <verse eid="ACT 18:18"/><verse number="19" style="v" sid="ACT 18:19"/>ኤንቲ ኤፈሶና ጋክዳ ዎደ ጳዉሎስ ጵርስቅሎነ አቅላ ያን አግስ። ሽን ባዉ አይሁደ ዎሳ ኬ ገልድ አይሁደታራ ኦደትስ። <verse eid="ACT 18:19"/><verse number="20" style="v" sid="ACT 18:20"/>ኤንቲ ባንታራ ዳሮ ዎደ ኡታና መላ ጳዉሎሳ ዎስዶሶና ሽን እ እፅስ። <verse eid="ACT 18:20"/><verse number="21" style="v" sid="ACT 18:21"/>ኤንታፈ ሻከትሸ፥ “ታኒ ያ ባልያ የሩሳላመን ቦንቻናዉ በሴስ። ሽን ፆሲ ጊኮ ህንተኮ ስማ ያና” ያግድ ኤፈሶናፐ ማርካብያን ብስ። <verse eid="ACT 18:21"/><verse number="22" style="v" sid="ACT 18:22"/>ቅሳረ ጋክዳ ዎደ የሩሳላመ ብድ ዎሳ ኬ አሳ ሳሮዳፐ ጉየ አንፆከ ብስ።<verse eid="ACT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23"/>ያን ጉ ዎደ ጋምእዳፐ ጉየ አማንያ አሳታ ኡባ ምንሸ ጋላትያራነ ፕርገራ አስ።<verse eid="ACT 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24"/>እስክንድረን የለትዳ እስ አጵሎሳ ጌተትያ አይሁደ አስ ኤፈሶና ብስ። እ ኦዳ ኤርያ አስነ ፆሳ ቃላ ዳሮ ኤርያ አስ። <verse eid="ACT 18:24"/><verse number="25" style="v" sid="ACT 18:25"/>ጎዳ ኦግያካ ታማርስ፥ አያናን ፁገትድ የሱሳባ ሱረ ታማርሴስ። ግዶሽን፥ ዮሃንሳ ፅንቃትያ ፃላላ ኤሬስ። <verse eid="ACT 18:25"/><verse number="26" style="v" sid="ACT 18:26"/>እ አይሁደ ዎሳ ኬን ያዮና ታማርሴስ። ጵርስቅላነ አቅል እ ኦደይሳ ስእዳ ዎደ ባንታራ ሶ እያ ኤፍድ ፆሳ ኦግያ ካሰይሳፈ ጌሽድ እያዉ ኦድዶሶና።<verse eid="ACT 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27"/>አጵሎስ አካያ ባናዉ ኮይን ኤፈሶናን ደእያ አማንያ አሳይ እያ ቆፋ ኤክድ አካያን ደእያ አማነይሳት እያ ሞካና መላ ኤንታዉ ዳብዳበ ፃፍዶሶና። እ ያ ጋክዳ ዎደ ፆሳ አ ኬሀተ ባጋራ የሱስ ክርስቶሳ አማንዳይሳታ ዳሮ ማድስ። <verse eid="ACT 18:27"/><verse number="28" style="v" sid="ACT 18:28"/>አይስ ጊኮ፥ የሱሲ፥ እ፥ ክርስቶሳ ግደይሳ አይሁደታስ ፆሳ ቃላፐ ቆንጭስድ ደርያ ስንን ምን ኦድድ ኤንታ ላስ። <figure style="fig" alt="Paul's 3rd Journey" file="Paul3-BW.tif" size="span" loc="ACT 18:23—21:17" ref="18:23—21:17">ጳዉሎስ ዎንገላ ሳባካናዉ ብዳ ሄን ኦግያ</figure><verse eid="ACT 18:28"/></para>
  <chapter eid="ACT 18"/>
  <chapter number="19" style="c" sid="ACT 19"/>
  <para style="s1">ጳዉሎስ ኤፈሶናን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1"/>አጵሎስ ቆሮንቶሳን ደእሽን፥ ጳዉሎስ ቆሞ ባጋራ አድ ኤፈሶና ብስ። ያን እስ እስ አማንያ አሳታ ደምስ። <verse eid="ACT 19:1"/><verse number="2" style="v" sid="ACT 19:2"/>ኤንታኮ፥ “ህንተ አማንዳ ዎደ ጌሻ አያና ኤክደቲ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="ACT 19:2">ኤንቲ፥ “አካይ፥ ኤክቦኮ፤ ሀር አቶሽን፥ ጌሻ አያን ደእያባካ ስእቦኮ” ያግዶሶና።<verse eid="ACT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3"/>ጳዉሎስ ኤንታኮ፥ “ያትን፥ አይብን ፃማቀትደቲ?” ያግስ።</para>
  <para style="p" vid="ACT 19:3">ኤንቲ፥ “ኑኒ ዮሃንሳ ፅንቃተን ፃማቀትዳ” ያግድ ዛርዶሶና።<verse eid="ACT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4"/>ጳዉሎስ፥ “ዮሃንስ ባፐ ጉየራ ያ የሱስ ክርስቶሳን አሳይ አማናና መላ አሳስ ኦድሸ፥ ናጋራፐ ስሞ በሲያ ፅንቃተን ፃማቅስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቶ 3:11</ref>፤ <ref loc="MRK 1:4">ማር 1:4</ref>፥ <ref loc="MRK 1:7-8">7-8</ref>፤ <ref loc="LUK 3:4">ሉቃ 3:4</ref>፥ <ref loc="LUK 3:16">16</ref>፤ <ref loc="JHN 1:26-27">ዮሀ 1:26-27</ref>.</char></note><verse eid="ACT 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5"/>ኤንቲ ሄሳ ስእዳ ዎደ ጎዳ የሱስ ክርስቶሳ ታማረ ግዳናዉ ፃማቀትዶሶና። <verse eid="ACT 19:5"/><verse number="6" style="v" sid="ACT 19:6"/>ጳዉሎስ ባ ኩሽያ ኤንታ ቦላ ዎዳ ዎደ ጌሻ አያናይ ኤንታ ቦላ ዎን፥ ዱማ ዱማ ዶናን ኦደትዶሶና፤ ቃስ ትንብተ ኦድዶሶና። <verse eid="ACT 19:6"/><verse number="7" style="v" sid="ACT 19:7"/>ሄ በሳን ታማነ ናምአ ግድያ አሳት ደኦሶና።<verse eid="ACT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8"/>ጳዉሎስ አይሁደ ዎሳ ኬ ገልድ፥ ፆሳ ካዎተባ ያዮና ፓላምሸነ ሎይ ቆንጭስሸ ኤንታራ ሄ አጌና ጋካናዉ ጋምእስ። <verse eid="ACT 19:8"/><verse number="9" style="v" sid="ACT 19:9"/>ሽን ኤንታፈ እሶት እሶት በ ግድድ ዳሮ አሳ ስንን ጎዳ ኦግያ ጫይድ አማኖና እፅዶሶና። ጳዉሎስ አማነይሳታ ኤንታፈ ሻክ ኤክድ ፅራኖሳ ጌተትያ ትምርተ ኬን ኡባ ጋላስ ኤንታ ታማርስስ። <verse eid="ACT 19:9"/><verse number="10" style="v" sid="ACT 19:10"/>ጳዉሎስ ናምኡ ላይ ጋካናዉ ቃላ ኦድስ። ሄሳ ግሾ፥ ኢሰን ደእያ አሳ ኡባይ፥ አይሁደትነ አይሁደ ግዶናይሳት ጎዳ ቃላ ስእዶሶና።<verse eid="ACT 19:10"/></para>
  <para style="s1">አስቀዋ ናይታ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11"/>ፆሳይ ጳዉሎሳ ኩሸን ዎልቃማ ማላታታ ኦስ። <verse eid="ACT 19:11"/><verse number="12" style="v" sid="ACT 19:12"/>ሄሳ ግሾ፥ አሳይ እያ አሳተ ቦችዳ ማራበ ዎይኮ ማኦ ሀርጋንቾታስ ኤፎሶና። ኤንትካ ፓፆሶና፤ ቱና አያናት ኤንታፈ ከዮሶና።<verse eid="ACT 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13"/>ቱና አያናታ ከስሸ ዩይያ አይሁደታፐ እሶት እሶት፥ “ጳዉሎስ ሳባክያ የሱሳ ሱንን ከይተ ግድ ህንተና ኪቶስ” ያግድ፥ ቱና አያናት ኦይክዳ አሳታ ቦላ ጎዳ የሱሳ ሱን ፄግዶሶና። <verse eid="ACT 19:13"/><verse number="14" style="v" sid="ACT 19:14"/>ካህነ ሀላቃ አስቀዋ ጌተትያ እስ አይሁደ አድያስ ሄሳ ኦያ ላፑን ናይት ደኦሶና።<verse eid="ACT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15"/>ሽን ቱና አያናይ ኤንታኮ፥ “ታኒ የሱሳካ ጳዉሎሳካ ኤራይስ፥ ሽን ህንተ ኦናንቴ?” ያግስ።<verse eid="ACT 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16"/>ቱና አያን ኦይክዳ አደይ ኤንታ ቦላ ጉፕ ዎድ፥ ኤንታ ማዱንፅስድ፥ ሄ ኬፈ ካሎ ባቃታና ጋካናዉ ዎልቃምስ። <verse eid="ACT 19:16"/><verse number="17" style="v" sid="ACT 19:17"/>ኤፈሶናን ደእያ አይሁደትነ አይሁደ ግዶናይሳት ኡባይ ሄሳ ስእድ ዳሮ ያይዶሶና። ጎዳ የሱሳ ሱንይ ዳሮ ቦንቸትስ። <verse eid="ACT 19:17"/><verse number="18" style="v" sid="ACT 19:18"/>አማነይሳታፐ ዳሮት ባንታ ኦዳ ኢታ ኦሱዋ ፓፅሸነ ቆንጨን ኦድሸ ዮሶና። <verse eid="ACT 19:18"/><verse number="19" style="v" sid="ACT 19:19"/>ማሮታፐ ዳሮት ባንታ ማፃፋታ ሺሽድ አሳ ኡባ ስንን ፁግዶሶና። ሄ ማፃፋታ ጋትያ ታይቦይ እሻታሙ ሙኩሉ ብራ ሳንትመ<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="fq" closed="false">ብራ ሳንትመ፦ </char><char style="ft" closed="false">ማቶሳ 26:15 ፄልተ።</char></note> ግድስ። <verse eid="ACT 19:19"/><verse number="20" style="v" sid="ACT 19:20"/>ሄሳዳ ሀንድ ፆሳ ቃላይ ድጭሸነ ዳልግሸ ብስ።<verse eid="ACT 19:20"/></para>
  <para style="s1">ኤፈሶናን ኦሽ ከይስ</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21"/>ሄስ ሀንዳፐ ጉየ ጳዉሎስ፥ “ታኒ የሩሳላመ ባ ስማዳ ሮመ ባናዉ በሴስ” ያግድ ማቀዶነራነ አካያራ አድ የሩሳላመ ባናዉ ቆፋ ቃችስ። <verse eid="ACT 19:21"/><verse number="22" style="v" sid="ACT 19:22"/>ቃስ ባና ማደይሳታፐ ናምአታ ፅሞትዮሳነ ኤራስፆሳ ማቀዶነ ኪትድ፥ ባዉ ኢሰን ጉ ዎደ ጋምእስ።<verse eid="ACT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23"/>ሄ ዎደ ጎዳ ኦግያ ግሾ ኤፈሶናን ዎልቃማ ካች ከይስ። <verse eid="ACT 19:23"/><verse number="24" style="v" sid="ACT 19:24"/>እስ ብራ ኦያ ድመፅሮሳ ጌተትያ ኡራይ አርፀምስ ኤቃ ኬ ምስልያ ብራፐ ኦድ ዳሮ ዎ ደሜስ። <verse eid="ACT 19:24"/><verse number="25" style="v" sid="ACT 19:25"/>ሄሳ ግሾ፥ ሄሳ መላ ኦሶ ኦይሳታ እስፈ ሺሽድ፥ “አሳዉ፥ ኑ ዱረተይ ሀ ኦሱዋን ግደይሳ ህንተ ኤሬታ። <verse eid="ACT 19:25"/><verse number="26" style="v" sid="ACT 19:26"/>ሀይስ ጳዉሎስ፥ ‘አሳ ኩሸን ኦሰትዳይሳት ፆሳታ ግዶኮና’ ያግድ፥ ኤፈሶናንነ ጉ ቢታታፐ አትሽን፥ ኩመ ኢሰ ኡባን ደእያ ዳሮ አሳ ኦድ አማንዳይሳነ ባለዳይሳ ህንተ በእደታነ ስእደታ። <verse eid="ACT 19:26"/><verse number="27" style="v" sid="ACT 19:27"/>መቶ ግድዳይ፥ ኑ ኦሶይ ካተይሳ ፃላላ ግዶናሽን፥ ኢሰነ ቢታ ኡባን ደእያ አስ ጎይንያ ግታ ፆሰ አርፀምስ ኬይ ቦንቸቶና አተይሳነ እ ግታተይ ኩንዳናይሳ” ያግስ።<verse eid="ACT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28"/>አሳይ ሄሳ ስእዳ ዎደ ሸነን ፁገትድ፥ “ኤፈሶና አርፀምሳ ግታ” ያግድ ዋስዶሶና። <verse eid="ACT 19:28"/><verse number="29" style="v" sid="ACT 19:29"/>ሄ ዋሶይ ካታማ ኡባ ጋክስ። ጳዉሎሳራ ሄመትያ ማቀዶነ አሳታ፥ ጋዮሳነ አርስፅሮኮሳ ኦይክድ ጎችሸ ካሳ በሳ ዎፅዶሶና። <verse eid="ACT 19:29"/><verse number="30" style="v" sid="ACT 19:30"/>ጳዉሎስ አሳይ ሺቅዳ በሳ ገላናዉ ኮይስ፥ ሽን አማነይሳት እያ ድግዶሶና። <verse eid="ACT 19:30"/><verse number="31" style="v" sid="ACT 19:31"/>ኢሰ ቢታ ሀላቃታፐ ጳዉሎሳ ላገ ግድዳ እሶት እሶት ጳዉሎሳኮ ኪትድ፥ “ካሳ በሳ ቆንጨን ከያዳ በንቶፋ” ግድ እያ ዎስዶሶና።<verse eid="ACT 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32"/>ሺቅዳ አሳስ ሀናናባይ ይስ፤ ዳርያ ባጋ አሳይ ሀር አቶሽን አይስ ሺቅዳኮ ኤሮና ግሾ፥ እሶይ እስባስ ዋስያ ዎደ ሀንኮይ ሀራባስ ዋሴስ። <verse eid="ACT 19:32"/><verse number="33" style="v" sid="ACT 19:33"/>አይሁደት እስክንድረ ጌተትያ አድያ አድ በስን፥ እስ እስ አሳይ እ ጋናባ ኦድድ እያ ስን አዶሶና። እ አሳይ ስእ ጋና መላ ባ ኩሸን ማል በስድ፥ አሳስ ሞተታናዉ ኤቅስ። <verse eid="ACT 19:33"/><verse number="34" style="v" sid="ACT 19:34"/>ሽን እስክንድረይ አይሁደ አስ ግድዳይሳ አሳይ ኤርዳ ዎደ ናምኡ ሳተ ግዳናይሳ መላ ኡባይ እስ ቃላን፥ “ኤፈሶና አርፀምሳ ግታ” ያግድ ዋስዶሶና።<verse eid="ACT 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35"/>ዉርሰን፥ ካታማ ፃፈይ አሳ ስእ ኦድ፥ “ኤፈሶና አሳዉ፥ ኤፈሶና ካታማይ ግታ አርፀምስ ኤቃ ኬነ ሳሎፐ ዎዳ እ ሹቻ ምስልያ ናገይ ኤፈሶና አሳ ግደይሳ ኤሮናይ ኦኔ? <verse eid="ACT 19:35"/><verse number="36" style="v" sid="ACT 19:36"/>ሀይሳ ካሽ ግያ አስ ባይና ግሾ፥ ህንተ ስእ ጋናዉነ ድርግድ አይኮ ኦና አጋናዉ በሴስ። <verse eid="ACT 19:36"/><verse number="37" style="v" sid="ACT 19:37"/>ህንተ፥ ሀ አሳታ ኤቃ ኬ ሚሸ ካይሶቶናሽን ዎይኮ ኑ ፆሳታ ጫይቦናሽን ጮ ሀ አሳታ ኦይክድ ኤህደታ። <verse eid="ACT 19:37"/><verse number="38" style="v" sid="ACT 19:38"/>ሄሳ ግሾ፥ ድመፅሮስነ እያራ ደእያ ኦሳንቾት አሳ ሞታናዉ ኮይኮ፥ ፕርዳ ኬይ ዶያ ደኤስ፤ ዳይናትካ ደኦሶና፤ ኤንቲ ሞታናዉ ዳንዳኦሶና። <verse eid="ACT 19:38"/><verse number="39" style="v" sid="ACT 19:39"/>ሽን ህንተ ሀራ ኦዳ ኮይኮ፥ ሻንጎ ሺቆን ኦዳይ በኤቶ። <verse eid="ACT 19:39"/><verse number="40" style="v" sid="ACT 19:40"/>ሄሳ ግዶና እፅኮ ሀች ሀንዳባስ ሮመ ካዎተይ ኑና ኦይቻና። ሀ ቡቀስ ጋሶይ ባይና ግሾ፥ ኑኒ ጋሶ ኦዳናዉ ዳንዳኦኮ” <verse eid="ACT 19:40"/><verse number="41" style="v" sid="ACT 19:41"/>ያግድ ሺቁዋ ላልስ።<verse eid="ACT 19:41"/></para>
  <chapter eid="ACT 19"/>
  <chapter number="20" style="c" sid="ACT 20"/>
  <para style="s1">ጳዉሎስ ማቀዶነንነ ግርከን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1"/>ዋሶይ ዶችዳፐ ጉየ፥ ጳዉሎስ አማንያ አሳታ ፄግስድ ኤንታ ዞርዳፐ ጉየ፥ ሳሮድ ማቀዶነ ባናዉ ከይስ። <verse eid="ACT 20:1"/><verse number="2" style="v" sid="ACT 20:2"/>ሄ ቢታራ አሸ ቃላ ኦድሸ አሳ ዳሮ ምንዳፐ ጉየ ግርከ ቢታ ብስ። <verse eid="ACT 20:2"/><verse number="3" style="v" sid="ACT 20:3"/>እ ያን ሄ አጌና ኡትድ፥ ማርካበራ ሶረ ባናዉ ቆፕድ ደእሽን፥ አይሁደት ባና ዎናዉ ኮየይሳ ኤርድ ማቀዶነራ ጉየ ስማናዉ ኮይስ።<verse eid="ACT 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 20:4"/>ጳዉሎሳ ሞይዝዳይሳት ቤርያፐ ጳርሁሳ ናኣ ሶጳፅሮሳ፥ ተሰሎንቀፈ አርስፅሮኮሳነ ስኮንዱሳ፥ ዳርበፈ ጋዮሳ፥ ኢሰፐ ትክቆሳ፥ ፅሮፍሞሳነ ፅሞትዮሳ። <verse eid="ACT 20:4"/><verse number="5" style="v" sid="ACT 20:5"/>ሄሳት ስን ብድ ኑና ፅሮኣዳን ናጎሶና። <verse eid="ACT 20:5"/><verse number="6" style="v" sid="ACT 20:6"/>ኑኒ ኡይ ባልያ ቦንችዳፐ ጉየ፥ ፍልጵስዩሳፐ ማርካበራ ደንድድ፥ እቻሻን ጋላሳን ኤንታ ፅሮኣዳን ጋክድ ያን ላፑን ጋላስ ጋምእዳ።<verse eid="ACT 20:6"/></para>
  <para style="s1">ጳዉሎስ ፅሮኣዳን</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7"/>ሳምንታፈ ኮይሮ ጋላሳን ኑኒ ኡይ መንናዉ ሺቅድ ደእሽን፥ ጳዉሎስ ዎንተ ባናዉ ቆፕዳ ግሾ፥ ኤንታዉ ቃላ ኦድሸ ግድ ብላሄ ጋካናዉ ኦዳ አዱስስ። <verse eid="ACT 20:7"/><verse number="8" style="v" sid="ACT 20:8"/>ኑኒ ሺቅድ ኡትዳ ፖቅያን ዳሮ ፖኦይ ደኤስ። <verse eid="ACT 20:8"/><verse number="9" style="v" sid="ACT 20:9"/>ኤዉፅኮሳ ጌተትያ እስ ናአተይ ማስኮተ ቦላ ኡትድ፥ ባና ዶግድ ስክስ። ጳዉሎስ ኦዳ አዱስዳ ዎደ ኤዉፅኮስ ስኮ ኤይድ ሄን ፖቅያፐ ኩንድድ ሀይቅዳይሳ አሳይ ደንስ። <verse eid="ACT 20:9"/><verse number="10" style="v" sid="ACT 20:10"/>ሽን ጳዉሎስ ዎድ፥ እያ ቦላ ጉፋንስ። እያ እድምድ፥ “እ ሀይቅቤና፥ ህርጎፍተ” ያግስ። <verse eid="ACT 20:10"/><verse number="11" style="v" sid="ACT 20:11"/>ሄሳፈ ጉየ፥ ፑደ ፖቅያ ቦላ ከይድ ኡይ መንድ ምስ። ሳአይ ዎንታና ጋካናዉ አሳስ ኦድዳፐ ጉየ ደንድድ ብስ። <verse eid="ACT 20:11"/><verse number="12" style="v" sid="ACT 20:12"/>ሄ ፓፅዳ ናአተ ሶ ኤፍድ ዳሮ ኡፋይትዶሶና።<verse eid="ACT 20:12"/></para>
  <para style="s1">ጳዉሎስ ኤፈሶናፐ ሞይዘትስ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13"/>ሽን ጳዉሎስ ባና ያፐ ሞካና መላ ኑስ ኦድዳ ግሾ፥ ካሰትድ ማርካብያኮ ብድ፥ አሶሳ ባናዉ ደንድዳ። አይስ ጊኮ፥ እ ቶሆን ባናዉ ቆፕዳ ግሾ ኑና ሄሳ ኪትስ። <verse eid="ACT 20:13"/><verse number="14" style="v" sid="ACT 20:14"/>እ ኑራ አሶሳን ጋሄትን ማርካብያን እያ ኤክድ ምፅልነ ብዳ። <verse eid="ACT 20:14"/><verse number="15" style="v" sid="ACT 20:15"/>ዎንተ ጋላስ ያፐ ደንድድ ማርካበን ክዮሳ ስንን ደእያ በሳ ጋክዳ፤ ቃስ ዎንተ ጋላስ ሳሞሳ ፕንድ ካልያ ጋላስ ምልፀ ጋክዳ። <verse eid="ACT 20:15"/><verse number="16" style="v" sid="ACT 20:16"/>ጳዉሎስ ኢሰን ዳሮ ጋምኦና ኤፈሶና ማታራ አናዉ ቆፕስ። ባዉ ዳንዳኤትኮ ጳንፀቆስፀ ባልያ ጋላስ የሩሳላመ ጋካናዉ ኤሶቴስ።<verse eid="ACT 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17"/>ጳዉሎስ ምልፀፐ ኤፈሶና ኪትድ ዎሳ ኬ ጭማታ ፄግስስ። <verse eid="ACT 20:17"/><verse number="18" style="v" sid="ACT 20:18"/>ዎሳ ኬ ጭማት እያኮ ይን፥ ኤንታኮ ሀይሳዳ ያግስ፦ “ታኒ ኢሰ ገልዳ ኮይሮ ጋላሳፐ ዶምዳ ህንተራ ደእዳ ዎደ ኡባን ዋና ደእዳኮ ህንተ ኤሬታ። <verse eid="ACT 20:18"/><verse number="19" style="v" sid="ACT 20:19"/>አይሁደት ዱላትድ ታ ቦላ መቶ ጋኮካ ታኒ አሽከተንነ ዳሮ አፉን ጎዳስ ኦስ። <verse eid="ACT 20:19"/><verse number="20" style="v" sid="ACT 20:20"/>ዳባባንካ ህንተ ኬን ኬን ህንተና ታማርስሸ ህንተና ማድያባፐ እስባካ ፓጭሳብከ። <verse eid="ACT 20:20"/><verse number="21" style="v" sid="ACT 20:21"/>ታኒ አይሁደታስነ አይሁደ ግዶናይሳታስ ናጋራፐ ፆሳኮ ስማና መላነ ኑ ጎዳ የሱሳ አማናና መላ ማርካታስ።<verse eid="ACT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22"/>“ያን ታና አይብ ጋካኔኮ ኤርከ፥ ሽን ሀእ ታኒ ጌሻ አያናስ ኪተታዳ የሩሳላመ ባይስ። <verse eid="ACT 20:22"/><verse number="23" style="v" sid="ACT 20:23"/>ጌሻ አያናይ ቃሾይነ ዋየይ ታና ናገይሳ ካታማ ኡባን ታዉ ማርካትስ። <verse eid="ACT 20:23"/><verse number="24" style="v" sid="ACT 20:24"/>ሽን ታ ዎ ፖላናዉነ ጎዳ የሱስ ክርስቶሳፐ ኤክዳ ኦሱዋ፥ ፆሳ አ ኬሀተ ዎንገላ ማርካተይሳ ፖላናዉ ታ ሸምፕዉ ፓናባዳ ታይባስ።<note caller="-" style="x"><char style="xo" closed="false">20:24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">2 ፅሞ 4:7</ref>.</char></note><verse eid="ACT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25"/>“ታኒ ሀእካ ፆሳ ካዎተ ማርካታሸ ህንተ ኡባ ግዶን ዩያስ። ህዛፐ ጉየ፥ ህንተፈ ኦንካ ታና በኦናይሳ ኤራይስ። <verse eid="ACT 20:25"/><verse number="26" style="v" sid="ACT 20:26"/>ሄሳ ግሾ፥ ህንተፈ እስ ኡራይ ይኮካ ታ ኦይሸቶናይሳ ሀች ህንተዉ ጌሻዳ ኦዳይስ። <verse eid="ACT 20:26"/><verse number="27" style="v" sid="ACT 20:27"/>አይስ ጊኮ፥ ፆሳይ ኦናዉ ቆፕዳባ ኡባ ህንተዉ አይብባካ አሾና ኦዳስ።<verse eid="ACT 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 20:28"/>“ባ ናኣ ሱን ዎዝዳ ፆሳ ዎሳ ኬ ናግተ። ጌሻ አያናይ ህንተና ሀላቃ ኦድ ዶርዳ ዉድያስነ ህንተ ሁጵያስ ናገትተ። <verse eid="ACT 20:28"/><verse number="29" style="v" sid="ACT 20:29"/>ታኒ ብዳፐ ጉየ፥ ዉድያስ ቃቶና ዎዛና ምኖ ሱመት ህንተ ግዶ ገላናይሳ ታኒ ኤራይስ። <verse eid="ACT 20:29"/><verse number="30" style="v" sid="ACT 20:30"/>አማነይሳታ ባንታ ጌዶ ካለናዉ ዎርዶ ታማርስያ አሳት ህንተ ግዶፈ ደንዳና። <verse eid="ACT 20:30"/><verse number="31" style="v" sid="ACT 20:31"/>ሄሳ ግሾ፥ ታኒ ሄ ላይ ቃማነ ጋላስ አፉን ህንተና ሁጰን ሁጰን ምንዳይሳ ቆፕሸ ናገትተ።<verse eid="ACT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32"/>“ሀእካ ህንተና ምንናዉነ ጌሻ አሳራ ላትሳናዉ ዳንዳእያ ፆሳስነ እያ አ ኬሀተ ቃላስ ህንተና ሀዳራ እማይስ።<verse eid="ACT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 20:33"/>“ታኒ ኦደ ብራ ዎይኮ ዎርቃ ዎይኮ አፍላ አሞታብከ። <verse eid="ACT 20:33"/><verse number="34" style="v" sid="ACT 20:34"/>ታኒ ታ ኩሸን ኦዳ ታናነ ታራ ደኤይሳታ ኮሽዳባ ማድዳይሳ ህንተ፥ ህንተ ሁጰን ኤሬታ። <verse eid="ACT 20:34"/><verse number="35" style="v" sid="ACT 20:35"/>ህንተ ሀይሳዳ ዳቡርድ ኦሸ ዳቡራንቾታ ማዳናይሳነ ጎዳ የሱሲ፥ ‘ኤከይሳፈ እመይስ አንጀትዳይሳ’ ግዳ ቃላ ህንተ ቆፓናዉ በሰይሳ ታኒ ህንተና ኡባባን በሳስ” ያግስ።<verse eid="ACT 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36"/>ጳዉሎስ ሄሳ ኦድ ኦንግድ ኤንታ ኡባራ ጉልባትድ ፆሳ ዎስስ። <verse eid="ACT 20:36"/><verse number="37" style="v" sid="ACT 20:37"/>ኤንቲ ኡባይካ ጳዉሎሳ እድምድ ዬክድ ዬርዶሶና። <verse eid="ACT 20:37"/><verse number="38" style="v" sid="ACT 20:38"/>እ ዛሪድ፥ “ታና በኤከታ” ያግዳ ቃላይ ኤንታ ዳሮ አዛንስ። ኤንቲ ማርካብያ ጋካናዉ እያ ሞይዝዶሶና።<verse eid="ACT 20:38"/></para>
  <chapter eid="ACT 20"/>
  <chapter number="21" style="c" sid="ACT 21"/>
  <para style="s1">ጳዉሎስ የሩሳላመ ቡሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1"/>ኑኒ ኤፈሶና ጭማታፐ ሻከትዳ መላ ቆሳ ብዳ። ዎንተ ጋላስ ሮዳ ጋክድ ያፐ ጳፃራ ብዳ። <verse eid="ACT 21:1"/><verse number="2" style="v" sid="ACT 21:2"/>ስሮፍንቀ ፕንያ ማርካበ ደምድ እያን ገልድ ባናዉ ደንድዳ። <verse eid="ACT 21:2"/><verse number="3" style="v" sid="ACT 21:3"/>ኑኒ ቆጵሮሳ በአናዉ ዳንዳእያ ሶ ይድ፥ ቆጵሮሳ ሀድርሳ ባጋ አግድ ሶረ ብዳ። ማርካበይ ባ ጫና ያን ዎናዉ ኮይዳ ግሾ ፅሮሳ ብዳ። <verse eid="ACT 21:3"/><verse number="4" style="v" sid="ACT 21:4"/>ያን አማንያ አሳታ ደምድ ኤንታራ ላፑን ጋላስ ኡትዳ። ጳዉሎስ የሩሳላመ ቦና መላ ኤንቲ እያዉ አያናን ኦድዶሶና። <verse eid="ACT 21:4"/><verse number="5" style="v" sid="ACT 21:5"/>ኑኒ ኤንታራ ኡትያ ዎደይ ዉርን ከይድ ብዳ። ኤንቲ ኡባይ ባንታ ማጫሳታራነ ባንታ ናይታራ እስፈ ካታማፐ ካረ ከስድ ኑና ሞይዝዶሶና። ኑኒ አባ ዶናን ጉልባትድ ፆሳ ዎስዳ። <verse eid="ACT 21:5"/><verse number="6" style="v" sid="ACT 21:6"/>ሄሳፈ ጉየ፥ ዎል ሳሮድ ኑ ማርካብያን ገልዳ፤ ኤንቲ ባንታ ሶ ስምዶሶና።<verse eid="ACT 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7"/>ኑኒ አባ ኦግያ ኦንግድ፥ ፅሮሳፐ ጳፀለማሳ ጋክዳ። ያን አማንያ አሳታ ሳሮድ፥ ኤንታ ማታን እስ ጋላስ ፔእዳ። <verse eid="ACT 21:7"/><verse number="8" style="v" sid="ACT 21:8"/>ዎንተ ጋላስ ከይድ፥ ቅሳረ ብዳ። ሳባክያ ፍልጶሳ ሶ ጋክድ እያ ማታን ኡትዳ። እ የሩሳላመን ካሰ ዶረትዳ ላፑናታፐ እሱዋ።<note caller="-" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="ACT 6:5">ሀዋ 6:5</ref>፤ <ref loc="ACT 8:5">8:5</ref>.</char></note> <verse eid="ACT 21:8"/><verse number="9" style="v" sid="ACT 21:9"/>ፍልጶሳስ ናበ ግድዳ ኦይዱ ጌላኦ ናይት ደኦሶና።<verse eid="ACT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10"/>ኑኒ ኡንደና ጋላስ ያን ኡትድ ደእሽን ትንብተ ኦድያ እስ አጋቦሳ ጌተትያ አደይ ይሁዳፐ ቅሳረ ይስ።<note caller="-" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="ACT 11:28">ሀዋ 11:28</ref>.</char></note> <verse eid="ACT 21:10"/><verse number="11" style="v" sid="ACT 21:11"/>ኑኮ ይድ ጳዉሎሳ ሳቅያ ኤክድ ባ ኩሽያነ ባ ቶሁዋ ቃችድ፥ “ጌሻ አያናይ ሀ ሳቅያ ጎዳ፥ የሩሳላመን አይሁደት ሀይሳዳ ቃችድ፥ አይሁደ ግዶና አሳስ አድ እማና ያጌስ” ያግስ።<verse eid="ACT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12"/>ኑኒ ሄሳ ስእዳ ዎደ ኑነ ያን ደእያ አሳት ጳዉሎስ የሩሳላመ ቦና መላ ዎስዳ። <verse eid="ACT 21:12"/><verse number="13" style="v" sid="ACT 21:13"/>ሽን ጳዉሎስ ዛሪድ፥ “ህንተ ሀይሳዳ ዬክሸ አይስ ታ ዎዛና ሹግሴቲ? ታኒ፥ ጎዳ የሱሳ ሱን ግሾ ቃሸተ ፃላላ ግዶናሽን የሩሳላመን ሀይቃናዉካ ጊገታስ” ያግስ።<verse eid="ACT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14"/>ኑ ዞርያ እ ኤኮና እፅን፥ “ጎዳ ሸነይ ሀኖ” ያግድ ስእ ግዳ።<verse eid="ACT 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15"/>ያን ጉ ዎደ ጋምእዳፐ ጉየ ጊገትድ የሩሳላመ ባናዉ ከይዳ። <verse eid="ACT 21:15"/><verse number="16" style="v" sid="ACT 21:16"/>ቅሳረን ደእያ አማንያ አሳታፐ ጉት ኑራ ብዶሶና። ኤንቲ ኑኒ ሸምፓና በሲ ምናሶና ጌተትያ ቆጵሮሳ አድያ ሶ ኤፍዶሶና። ምናሶን ኮይሮ አማንዳ አሳፐ እሱዋ።<verse eid="ACT 21:16"/></para>
  <para style="s1">ጳዉሎስ የሩሳላመ ጋክስ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17"/>ኑኒ የሩሳላመ ጋክዳ ዎደ አማንያ አሳት ኑና ኡፋይሳን ሞክዶሶና። <verse eid="ACT 21:17"/><verse number="18" style="v" sid="ACT 21:18"/>ዎንተ ጋላስ ጳዉሎስነ ኑኒ ያይቆባራ ጋሄታናዉ ብዳ። ዎሳ ኬ ጭማት ኡባትካ ያን ደኦሶና። <verse eid="ACT 21:18"/><verse number="19" style="v" sid="ACT 21:19"/>ጳዉሎስ ኤንታ ሳሮዳፐ ጉየ አይሁደ ግዶና አሳ ግዶን ባ ባጋራ ፆሳይ ኦዳባ ኡባ ኤንታዉ ኦድስ።<verse eid="ACT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20"/>ኤንቲ ሄሳ ስእዳ ዎደ ፆሳ ጋላትድ ጳዉሎሳኮ ሀይሳዳ ያግዶሶና፦ “ኑ እሻዉ፥ አይሁደታ ግዶን አፑን ሙኩላት ፆሳ አማንዳኮ ነ በኣሳ፤ ኤንቲ ኡባይካ ህግያ ምን ናጎሶና። <verse eid="ACT 21:20"/><verse number="21" style="v" sid="ACT 21:21"/>ኔኒ አይሁደ ግዶናይሳታ ቢታን ደእያ አይሁደ ኡባይ ባንታ ናይታ ቃፃሮና መላ፥ አይሁደታ ዎጋ ካሎና መላነ ሙሰ ህግያ እፃና መላ ኔኒ ታማርሰይሳ የሩሳላመን ደእያ አይሁደት ስእዶሶና። <verse eid="ACT 21:21"/><verse number="22" style="v" sid="ACT 21:22"/>ያትን አይብ ሎኦ? ኔኒ ይዳይሳ ዳሮት ስአና።<verse eid="ACT 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 21:23"/>“ሄሳ ግሾ፥ ኑኒ ነዉ ኦደይሳ ስአ፤ ጋሶይ ደእያ ኦይዱ አሳት ኑ ማታን ደኦሶና።<note caller="-" style="x"><char style="xo" closed="false">21:23 </char><char style="xt" closed="false"><ref loc="NUM 6:13-21">ታይቦ 6:13-21</ref>.</char></note> <verse eid="ACT 21:23"/><verse number="24" style="v" sid="ACT 21:24"/>ኤንታ ኤካዳ ኤንታራ ጌያ፤ ቃስ ኤንቲ ባንታ ሁጵያ ሜደታና መላ ኤንታዉ ሚሸ እማ። ኤንቲ ካሰ ነባ ስእዳይስ ቱማ ግዶናይሳነ ኔኒ ነ ሁጰንካ ህገ ናግያ አስ ግደይሳ ኡባይ ኤራና።<verse eid="ACT 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 21:25"/>“ሽን አማንዳ አይሁደ ግዶና አሳታ ግድኮ፥ ኤንቲ ኤቃስ ያርሸትዳባ ሞና መላ፥ ሱ ኡዮና መላ፥ ባዉታ ሞና መላነ ላይማቶና መላ፥ ኑኒ ኦዳ ቃችድ፥ ኤንታዉ ዳብዳበ ፃፍዳ” ያግዶሶና።<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ACT 15:29">ሀዋ 15:29</ref>.</char></note><verse eid="ACT 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26"/>ሄሳፈ ጉየ፥ ጳዉሎስ ዎንተ ጋላስ አሳታ ኤክድ፥ ኤንታራ ጌይስ። እ ባንታ ጌይያ ጋላሳይ አዉደ ፖለትያኮ ኤርሳናዉነ ባንታ ያርሹዋ አዉደ ያርሻነኮ ኤርሳናዉ ፆሳ ኬ ገልስ።<verse eid="ACT 21:26"/></para>
  <para style="s1">ጳዉሎስ ኦይከትስ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27"/>ላፑን ጋላሳይ ዉራና ሀንሽን፥ ኢሰፐ ይዳ አይሁደት ፆሳ ኬን ጳዉሎሳ በእድ፥ አሳ ኡባ ደንድ ጳዉሎሳ ኦይክዶሶና። <verse eid="ACT 21:27"/><verse number="28" style="v" sid="ACT 21:28"/>“እስራኤለ አሳዉ፥ ኑና ማድተ፤ ሀ ኡራይ፥ ኑ ደርያ፥ ኑ ህግያነ ሀ ፆሳ ኬ እፃና መላ አሳ ኡባ ታማርሴስ። ሄስካ ግዶና እፅን አይሁደ ግዶናይሳታ ፆሳ ኬ ገልስድ፥ ሀ ጌሻ በሳ ቱንስስ” ያግድ ዋስዶሶና። <verse eid="ACT 21:28"/><verse number="29" style="v" sid="ACT 21:29"/>ኤንቲ ሄሳ ግዳይ ካሰ ኤፈሶና ፅሮፍሞሳ ጳዉሎሳራ ካታማን በእዳ ግሾ ሀእ ጳዉሎስ ፆሳ ኬ እያ ኤክ ገልዳባ ኤንታዉ ዳንስ።<note caller="-" style="x"><char style="xo" closed="false">21:29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሀዋ 20:4</ref>.</char></note><verse eid="ACT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30"/>ካታማ ኡባይ ቡቀትስ፤ አሳ ኡባይ ሺቅድ ጳዉሎሳ ኦይክድ ፆሳ ኬፈ ካረ ጎችዶሶና። ፆሳ ኬ ፐንገት ኤለስድ ጎርደትዶሶና። <verse eid="ACT 21:30"/><verse number="31" style="v" sid="ACT 21:31"/>አሳይ ጳዉሎሳ ዎና ሀንሽን፥ “የሩሳላመ ካታማይ ኩመ ቡቀትስ” ግያ ኦዳይ ሮመ ሻላቃኮ ጋክስ። <verse eid="ACT 21:31"/><verse number="32" style="v" sid="ACT 21:32"/>ሻላቃይ ዎታዳረታነ ማቶ ሀላቃታ ኤክድ ዎፅሸ ይስ። አሳይ ሻላቃነ ዎታዳረታ በእዳ ዎደ ጳዉሎሳ ዋይሳ አጋግዶሶና።<verse eid="ACT 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33"/>ሄ ዎደ ሻላቃይ ሺቅድ፥ ጳዉሎሳ ኦይክድ፥ ናምኡ ሳንላታን ቃሸታና መላ ኪትስ። ያትድ፥ እ ኦነኮነ አይ ኦዳኮ አሳ ኦይችስ። <verse eid="ACT 21:33"/><verse number="34" style="v" sid="ACT 21:34"/>አሳፐ ባጋይ እስባ ግድ ዋስያ ዎደ፥ ሀራት ሀራባ ግድ ዋሴስ። ዋሶይ ዳርዳ ግሾ፥ ሻላቃይ ቱማ ሻካናዉ ዳንዳኤቶና እፅን፥ ዎታዳረት ጳዉሎሳ ባንታ ደእያሶ ኤፋና መላ ኪትስ። <verse eid="ACT 21:34"/><verse number="35" style="v" sid="ACT 21:35"/>ጳዉሎስ የ ከይያ ደ ጋክያ ዎደ አሳ ሱገ ግሾ ዎታዳረት እያ ቶክዶሶና። <verse eid="ACT 21:35"/><verse number="36" style="v" sid="ACT 21:36"/>ዳሮ አሳይ፥ “እ ሀይቆ!” ያግድ ዋስሸ ካሎሶና።<verse eid="ACT 21:36"/></para>
  <para style="s1">ጳዉሎስ አሳስ ዛሮ እሚስ</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37"/>ዎታዳረት ጳዉሎሳ ባንታ ደእያሱዋ ገልሳና ሀንሽን፥ ጳዉሎስ ሻላቃኮ፥ “ታኒ ነዉ እስባ ኦዶ?” ያግስ።</para>
  <para style="p" vid="ACT 21:37">እ ጳዉሎሳኮ፥ “ኔኒ ግርከ ዶና ኤራይ? <verse eid="ACT 21:37"/><verse number="38" style="v" sid="ACT 21:38"/>ኔኒ ሀይሳፈ ስን ቡቀ መድ ሸምፖ ዎዳ ኦይዱ ሙኩሉ አሳታ ኤክድ ባዞ ገልዳ ግብፀ ኡራ ግድኪ?” ያግስ።<verse eid="ACT 21:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39"/>ሽን ጳዉሎስ፥ “ታኒ፥ ክልቅያን ደእያ ኤረትዳ ተርሰሴ ካታማን የለትዳ አይሁደ አስ። ሀያና ታና ኦድሳርኪ?” ያግስ።<verse eid="ACT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40"/>ሻላቃይ እያኮ፥ “ኦዳ” ያግን ጳዉሎስ ደ ቦላ ኤቅድ፥ አሳይ ስእ ጋና መላ ባ ኩሽያን ማልስ። አሳይ ስእ ግን እብራወ ዶናን ሀይሳዳ ያግስ፦<verse eid="ACT 21:40"/></para>
  <para style="b"/>
  <chapter eid="ACT 21"/>
  <chapter number="22" style="c" sid="ACT 22"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1"/>“ታ እሻቶ፥ ታ አዋቶ፥ ታኒ ሀእ ህንተዉ እምያ ዛሩዋ ስእተ።” <verse eid="ACT 22:1"/><verse number="2" style="v" sid="ACT 22:2"/>ጳዉሎስ ኤንታዉ እብራወ ዶናን ኦደይሳ ስእድ ካሰይሳፈ አድ ስእ ግዶሶና። እ ካልድ፥<verse eid="ACT 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3"/>“ታኒ ክልቅያን ደእያ ተርሰሴ የለታዳ ሀ ካታማን ድጫስ። ታ አስታማረይካ ጋማልያለ፤ ታኒ ኑ አዋታ ህግያ ምን ታማርዳ፥ ሀች ህንተ ኡባይ ሀነይሳዳ ፆሳስ ምሸትያ አይሁደ አስ።<note caller="-" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="ACT 5:34-39">ሀዋ 5:34-39</ref>.</char></note> <verse eid="ACT 22:3"/><verse number="4" style="v" sid="ACT 22:4"/>ታኒ ሀ ኦግያ ካልያ ማጫታነ አደታ ኦይካዳ ቃሾ ኬን የጋሸነ ኤንታ ዎሳና ጋካናዉ ዋየ በስዳ አስ።<note caller="-" style="x"><char style="xo" closed="false">22:4 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሀዋ 8:3</ref>፤ <ref loc="ACT 26:9-11">26:9-11</ref>.</char></note> <verse eid="ACT 22:4"/><verse number="5" style="v" sid="ACT 22:5"/>ሄሳዳካ፥ ካህነ ሀላቃይነ ሻንጎ ኡባይ ታባ ማርካታናዉ ዳንዳኤስ። ታኒ ዳማስቆን ደእያ ኤንታ እሻታስ ኤንታፈ ዳብዳበ ኤካዳ ያን ደእያ አሳት ቃሸትድ ሴረታና መላ የሩሳላመ ኤንታ ኤሀናዉ ያ ባስ።<verse eid="ACT 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6"/>“ታኒ ባዳ ዳማስቆ ማትዳ ዎደ ሴታ ጋላስ ቆፖና ሳሎፐ ግታ ፖኦይ ታ ዩሹዋን ፖእስ። <verse eid="ACT 22:6"/><verse number="7" style="v" sid="ACT 22:7"/>ታኒ ሳአን ኩንዳ ደእሽን፥ ‘ሳኦላ፥ ሳኦላ፥ ታና አይስ የደይ?’ ግያ ቃላ ስአስ። <verse eid="ACT 22:7"/><verse number="8" style="v" sid="ACT 22:8"/>ታኒ ዛራዳ፥ ‘ጎዳዉ፥ ኔኒ ኦኔ?’ ያጋስ። እ ዛሪድ፥ ‘ታኒ፥ ኔኒ ጎድያ ናዝረተ የሱሳ’ ያግስ። <verse eid="ACT 22:8"/><verse number="9" style="v" sid="ACT 22:9"/>ታራ ደኤይሳት ፖኡዋ በእዶሶናፐ አትሽን፥ ታዉ ኦደይሳ ቃላ አኬክቦኮና።<verse eid="ACT 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10"/>“ታኒ፥ ‘ጎዳዉ፥ ታ አይ ኦ?’ ያጋስ።</para>
  <para style="p" vid="ACT 22:10">“ጎዳይ ታኮ፥ ‘ደንዳዳ ዳማስቆ ባ። ኔኒ ኦና መላ ፆሳይ ኦናዉ ቆፕዳባ ኡባይ ያን ነዉ ኦደታና’ ያግስ። <verse eid="ACT 22:10"/><verse number="11" style="v" sid="ACT 22:11"/>ሄ ዎልቃማ ፖኡዋ ጋሶን ታ አይፈይ ቆቅን፥ ታራ ደእያ አሳት ታ ኩሽያ ኦይክድ፥ ታና ጎችን ዳማስቆ ጋካስ።<verse eid="ACT 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12"/>“ዳማስቆን ደእያ አይሁደ ኡባይ ዳሮ ቦንችያ እስ ሀናንያ ጌተትያ አደይ፥ ኑ ህግያ ቦንቸይስነ ፆሳ ምን ዎሰይስ ደኤስ። <verse eid="ACT 22:12"/><verse number="13" style="v" sid="ACT 22:13"/>ሀናን ታኮ ይድ፥ ታ ማታን ኤቅድ፥ ‘ታ እሻዉ ሳኦላ፥ ፄላ’ ያግስ። ኤለሳዳ ታኒ እያ ፄላ አጋስ።<verse eid="ACT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14"/>“እ ታኮ፥ ‘ኑ አዋታ ፆሳይ ኔኒ እያ ሸንያ ኤራና መላ፥ እያ ፅሎ ናኣ በአና መላነ እያ ዶናፐ ቃላ ስአና መላ ካሰትድ ነና ዶርስ። <verse eid="ACT 22:14"/><verse number="15" style="v" sid="ACT 22:15"/>ኔኒ በእዳባነ ስእዳባ አሳ ኡባ ስንን እያዉ ማርካታና። <verse eid="ACT 22:15"/><verse number="16" style="v" sid="ACT 22:16"/>ሀእ አይስ ጋምአይ? ደንዳዳ ፃማቀታ፤ እያ ሱን ፄጋዳ ነ ናጋራፐ ሜጨታ’ ያግስ።<verse eid="ACT 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17"/>“ታኒ ጉየ የሩሳላመ ስማዳ ፆሳ ኬን ዎስሽን፥ ታዉ ቆንጨ በንትስ። <verse eid="ACT 22:17"/><verse number="18" style="v" sid="ACT 22:18"/>ቆንጨን ጎዳይ ታኮ፥ ‘ነ ታዉ ማርካትያ ማርካተ አሳይ ኤኮና ግሾ ኤለሳዳ የሩሳላመፐ ከያ’ ያግሽን ታኒ በአስ።<verse eid="ACT 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19"/>“ታኒ፥ ‘ጎዳዉ፥ አይሁደ ዎሳ ኬ ኡባን ነና አማነይሳታ ኦይካዳ ዋዳይሳነ ቃሾ ኬን የግዳይሳ ኤንቲ ኤሮሶና። <verse eid="ACT 22:19"/><verse number="20" style="v" sid="ACT 22:20"/>ኤንቲ ነ ማርካ እስፅፋኖሰ ዎያ ዎደ ታኒ ሄ ኦዳን እስፋስ። ቃስ ኤንታ ማታን ኤቃዳ እያ ዎይሳታ ማኡዋ ናጋይስ’ ያግስ።<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="ACT 7:58">ሀዋ 7:58</ref>.</char></note><verse eid="ACT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21"/>“ጎዳይ ታኮ፥ ‘ታኒ ነና አይሁደ ግዶና አሳኮ ሃሆሶ ኪትያ ግሾ ደንዳዳ ባ’ ” ያግስ።<verse eid="ACT 22:21"/></para>
  <para style="s1">ጳዉሎስ ሮመ አስ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22"/>ጳዉሎስ ሄ ቃላ ኦድድ ኦንጋና ጋካናዉ አሳይ እ ገይሳ ስኦሶና። ሄሳፈ ጉየ፥ ባንታ ቃላ ቁ ኦድ፥ “ሀይሳ ቢታፈ ይሳ! እ ዳናዉ በሰና” ያግዶሶና።<verse eid="ACT 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 22:23"/>ኤንቲ ዎጫምሽን፥ ባንታ ማኡዋ ቦላ ሆልሽንነ ባና ቦላ ላልሽን፤ <verse eid="ACT 22:23"/><verse number="24" style="v" sid="ACT 22:24"/>ሻላቃይ በእድ ዎታዳረት ጳዉሎሳ ባንታ ደእያሱዋ ኤፋና መላ ኪትስ። ቃስ አሳይ አይስ ሄሳዳ ዎጫምዳኮ ኤራናዉ ኮይድ ጳዉሎሳ ልሶን ጋራፍድ ፕልጋና መላ ኤንታ ኪትስ። <verse eid="ACT 22:24"/><verse number="25" style="v" sid="ACT 22:25"/>ሽን ዎታዳረት ጳዉሎሳ ዳፎን ምን ቃችድ ጋራፋና ሀንያ ዎደ ጳዉሎስ ባ ማታን ኤቅዳ ማቶ ሀላቃኮ፥ “ሮመ አስ ፕርድ ባይና ጋራፈይስ ህንተዉ ዎጌ?” ያግስ።<verse eid="ACT 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26"/>ማቶ ሀላቃይ ሄሳ ስእዳ ዎደ ሻላቃኮ ብድ፥ “ሀ አደይ ሮመ አስ። ኔኒ አይ ኦናዉ ቆፓይ?” ያግድ ኦይችስ።<verse eid="ACT 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27"/>ሻላቃይ ጳዉሎሳኮ ሺቅድ፥ “ኔኒ ሮመ አሴ? አነ ታዉ ኦዳ” ያግስ።</para>
  <para style="p" vid="ACT 22:27">ጳዉሎስ፥ “ኤ” ያግስ።<verse eid="ACT 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28"/>ሻላቃይ ዛሪድ፥ “ታኒ ሀ ጋደተ ዳሮ ሚሸን ሻማስ” ያግስ።</para>
  <para style="p" vid="ACT 22:28">ሽን ጳዉሎስ፥ “ታ ሀ ጋደተ የለተን ደማ ኤካስ” ያግስ።<verse eid="ACT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29"/>ሄሳ ግሾ፥ ጳዉሎሳ ፕልጋናዉ ቆፕዳይሳት ኢራ እያፐ ሻከትዶሶና። ሻላቃይ ሮመ አስ ሳንላታን ቃችዳይሳ ኤርዳ ዎደ ያይስ።<verse eid="ACT 22:29"/></para>
  <para style="s1">ጳዉሎስ አይሁደ ሻንጎ ስንን</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30"/>ዎንተ ጋላስ ሻላቃይ፥ አይሁደት ጳዉሎሳ አይስ ሞትዳኮ ጌሽ ኤራናዉ ኮይስ። ካህነ ሀላቃትነ ሻንጎይ ኡባይ ሺቃና መላ ኪትስ፤ ቃስ ጳዉሎሳ ቃሾፐ ብልስድ ኤንታ ስንን ኤስስ።<verse eid="ACT 22:30"/></para>
  <para style="b"/>
  <chapter eid="ACT 22"/>
  <chapter number="23" style="c" sid="ACT 23"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1"/>ጳዉሎስ ሺቁዋ ጫድ ፄልድ፥ “ታ እሻቶ፥ ታኒ ሀች ጋካናዉ ፆሳ ስንን ታ ደኦ ኡባን ሎኦ ዎዛናን ደአስ” ያግስ። <verse eid="ACT 23:1"/><verse number="2" style="v" sid="ACT 23:2"/>ካህነ ሀላቃይ ሀናን፥ ጳዉሎሳ ዶናን ባቃና መላ እያ ማታን ኤቅዳይሳታ ኪትስ። <verse eid="ACT 23:2"/><verse number="3" style="v" sid="ACT 23:3"/>ሄ ዎደ ጳዉሎስ እያኮ፥ “ላ ሀ ቦቅንተ ትይዳ ጎዳ ዳነይሶ፥ ፆሳይ ነና ባቃና። ኔኒ ታ ቦላ ህግያ ፕርዳናዉ ኡታዳ ደአሸ ህገይ ባይና ታና ባቃና መላ ኪታይ?” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="MAT 23:27-28">ማቶ 23:27-28</ref>.</char></note><verse eid="ACT 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4"/>ጳዉሎሳ ማታን ኤቅዳይሳት እያኮ፥ “ነ ፆሳ ካህነ ሀላቃ ጫያይ?” ያግዶሶና።<verse eid="ACT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5"/>ጳዉሎስ፥ “ታ እሻቶ፥ እ ካህነ ሀላቃ ግድዳይሳ ታኒ ኤራብከ፤ አይስ ጊኮ ፆሳ ቃላን፥ ‘ነ ደርያ አይሰይሳ ቦላ ኢታ ቃላ ሃሳዮፓ’ ጌተትድ ፃፈትስ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 22:28">ከሳ 22:28</ref>.</char></note><verse eid="ACT 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6"/>ሽን ጳዉሎስ ሄ በሳን ደእያ አሳፐ ባጋት ሳዱቃወታ፥ ባጋት ፋርሳወታ ግደይሳ በእድ፥ “ታ እሻቶ፥ ታኒ ፋርሳወነ ፋርሳወ ናአ፤ ‘ሀይቅዳይሳት ሀይቆፐ ደንዳና’ ጋዳ ታኒ ኡፋይሳን ናግያ ግሾ ኤንቲ ታ ቦላ ፕርዶሶና” ያግድ ኦድስ።<note caller="-" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="ACT 26:5">ሀዋ 26:5</ref>፤ <ref loc="PHP 3:5">ፍልጵ 3:5</ref>.</char></note><verse eid="ACT 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7"/>ጳዉሎስ ሄሳ ግዳ ዎደ ፋርሳወታ ግዶንነ ሳዱቃወታ ግዶን ኦሽ ከይን ሻከትዶሶና። <verse eid="ACT 23:7"/><verse number="8" style="v" sid="ACT 23:8"/>አይስ ጊኮ፥ ሳዱቃወት፥ “ሀይቅዳ አስ ደንደና፤ ኪታንቾይካ አያንካ ባዋ” ያጎሶና። ሽን ፋርሳወት ናምአይካ ደኤይሳ አማኖሶና።<note caller="-" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">ማቶ 22:23</ref>፤ <ref loc="MRK 12:18">ማር 12:18</ref>፤ <ref loc="LUK 20:27">ሉቃ 20:27</ref>.</char></note> <verse eid="ACT 23:8"/><verse number="9" style="v" sid="ACT 23:9"/>ግታ ካች ከይስ፤ ፋርሳወታ ባጋ ግድዳ ህገ አስታማረት ደንድ ኤቅድ፥ “ሀ ኡራ ቦላ አይብ ባላካ ደምቦኮ፤ እያዉ አያን ዎይኮ ኪታንቾይ ሃሳዮና አገና” ያግድ ፓላምዶሶና።<verse eid="ACT 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10"/>ኦሻይ ዳርን አሳይ ጳዉሎሳ ሻቀረና መላ ግድ፥ ሻላቃይ ባ ዎታዳረት ዎድ ኤንታ ግዶፈ እያ ኤለስ ከስድ ባንታ ደእያሱዋ ኤፋና መላ ኪትስ።<verse eid="ACT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11"/>ሄ ቃማ ጎዳይ ጳዉሎሳ ማታን ኤቅድ፥ “ጳዉሎሳ፥ ኔኒ ታዉ የሩሳላመን ማርካትዳይሳዳ ሮመንካ ማርካታናዉ በሴስ፤ ምና፤ አይኮይ ባዋ” ያግስ።<verse eid="ACT 23:11"/></para>
  <para style="s1">ጳዉሎሳ ዎናዉ ማቀትዶሶና</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12"/>ዎንተ ጋላስ አይሁደት፥ “ጳዉሎሳ ዎና ደእሸ ሞኮ ኡዮኮ” ግድ ጫቅዶሶና። <verse eid="ACT 23:12"/><verse number="13" style="v" sid="ACT 23:13"/>ጳዉሎሳ ቦላ ሄሳ ማቀትዳ አሳት ኦይታማፐ ዳሮሶና። <verse eid="ACT 23:13"/><verse number="14" style="v" sid="ACT 23:14"/>ኤንቲ ካህነ ሀላቃታኮነ ደርያ ጭማታኮ ብድ፥ “ኑኒ ጳዉሎሳ ዎና ደእሸ ካ ግያባ ሞኮ ግድ ጫቀትዳ። <verse eid="ACT 23:14"/><verse number="15" style="v" sid="ACT 23:15"/>ህዛ፥ ህንተነ ሻንጎይ እያባ ጌሽድ ፕልግያባይ ደእያ ዳንስድ፥ ጳዉሎሳ ህንተኮ ኤሀና መላ ሻላቃ ኦይችተ። ኑኒ እ ሀ ሺቁዋ ጋካናፐ ስን እያ ዎናዉ ጊግድ ኡትዳ” ያግዶሶና።<verse eid="ACT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16"/>ሽን ጳዉሎሳ ምቸ ናአይ ሄ ማቁዋ ስእዳ ዎደ፥ ብድ ዎታዳረት ደእያሱዋ ገልድ፥ ጳዉሎሳስ ኦድስ። <verse eid="ACT 23:16"/><verse number="17" style="v" sid="ACT 23:17"/>ጳዉሎስ ማቶ ሀላቃታፐ እሱዋ ፄግድ፥ “ሀ ናአይ ሻላቃስ ኦድያባይ ደእያ ግሾ እያ ሻላቃኮ ኤፋ” ያግስ።<verse eid="ACT 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 23:18"/>ማቶ ሀላቃይ ናኣ ሻላቃኮ ኤፍድ፥ “ቃሾ ኬን ደእያ ጳዉሎስ ታና ባኮ ፄግድ፥ ሀ ናአይ ነዉ ኦድያባይ ደእያ ግሾ፥ እያ ኔኮ ኤሀና መላ ታና ዎስስ” ያግስ።<verse eid="ACT 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19"/>ሻላቃይ ናኣ ኩሽያ ኦይክድ፥ ዱማ ካረ ከስድ፥ “ኔኒ ታዉ ኦዳናባይ አይቤ?” ያግድ ኦይችስ።<verse eid="ACT 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20"/>ናአይ ሻላቃኮ፥ “አይሁደት ጳዉሎሳባ ካሰፐ ምን ፕልጋናዉ ኮይዳባ ዳንስድ ኔኒ ዎንቶ እያ ሺቁዋ ኤሀና መላ ነና ዎሳናዉ ዞረታ ቃችዶሶና። <verse eid="ACT 23:20"/><verse number="21" style="v" sid="ACT 23:21"/>ሽን ኔኒ ኤንቲ ግያባ ስኦፓ። አይስ ጊኮ፥ ኦይታማፐ ዳርያ አሳት ጳዉሎሳ ዎና ደእሸ ‘ካ ሞኮ፥ ሃ ኡዮኮ’ ግድ ጫቀትድ፥ ቆሰትድ እያ ናጎሶና። ሀእ ነ ግያባ ፃላላ ስአናዉ ናጎሶና” ያግስ።<verse eid="ACT 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22"/>ሻላቃይ ዛሪድ፥ “ሀ ኦዳ ነ ታዉ ኦድዳይሳ ሀራ ኦደስካ ኦዶፓ” ያግድ ኪትድ ናኣ ጉየ የድስ።<verse eid="ACT 23:22"/></para>
  <para style="s1">ጳዉሎስ ፍልክሳ ስንን</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23"/>ሻላቃይ ማቶ ሀላቃታፐ ናምአታ ፄግድ፥ “ቃማፈ ሄ ሳተን ቅሳረ ባናዉ፥ ናምኡ ፄቱ ዎታዳረታ፥ ላፑን ታሙ ፓራ አሳታነ ናምኡ ፄቱ ቶራንቾታ ጊግስተ። <verse eid="ACT 23:23"/><verse number="24" style="v" sid="ACT 23:24"/>ደርያ አይስያ ፍልክሳኮ ጳዉሎሳ ሳሮ ጋናዉ ቶጋ መሄ ጊግስተ” ያግድ ኤንታ ኪትስ። <verse eid="ACT 23:24"/><verse number="25" style="v" sid="ACT 23:25"/>ሻላቃይ ፍልክሳስ ሀይሳዳ ግያ ዳብዳበ ፃፍስ፦<verse eid="ACT 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26"/>“ቃላዉድዮሳ ሉስዮሳፐ ደርያ አይስያ ቦንቾ ፍልክሳስ፥ ሳሮይ ነዉ ግዶ። <verse eid="ACT 23:26"/><verse number="27" style="v" sid="ACT 23:27"/>አይሁደት ሀ ኡራ ኦይክድ ዎና ሀንሽን፥ እ ሮመ ቢታ አስ ግዶይሳ ኤራዳ ዎታዳረታራ ጋካዳ እያ አሻስ። <verse eid="ACT 23:27"/><verse number="28" style="v" sid="ACT 23:28"/>ኤንቲ እያ አይስ ሞትያኮ ኤራናዉ ኮያዳ ኤንታ ሺቁዋን እያ ሺሻስ። <verse eid="ACT 23:28"/><verse number="29" style="v" sid="ACT 23:29"/>ኤንቲ ባንታ ህግያስ እያ ሞትዳይሳፈ አትሽን፥ እያ ዎስያባ ዎይኮ ቃሽስያባ ግዶናይሳ ታ ደማስ። <verse eid="ACT 23:29"/><verse number="30" style="v" sid="ACT 23:30"/>ኤንቲ ሀ ኡራ ቦላ ማቀትዳ ዝግርሳይ ታና ጋክን፥ ታኒ ኤለሳዳ እያ ኔኮ የዳስ። እያ ሞተይሳት ነ ስንን ብድ ሞታና መላ ኪታስ” ያግስ።<verse eid="ACT 23:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31"/>ሄሳ ግሾ፥ ዎታዳረት ኪተትዳይሳዳ ጳዉሎሳ ኤክድ፥ ቃማ አንትጳፅርሳ ጋዶሶና። <verse eid="ACT 23:31"/><verse number="32" style="v" sid="ACT 23:32"/>ዎንተ ጋላስ ፓራ አሳት እያራ ባና መላ ኦድ ቶሆ አሳት ጉየ ስምዶሶና። <verse eid="ACT 23:32"/><verse number="33" style="v" sid="ACT 23:33"/>ቶጋይ ቅሳረ ጋክድ ዳብዳብያ ደርያ አይሰይሳስ እምድ፥ ጳዉሎሳ እያ ስን አዶሶና። <verse eid="ACT 23:33"/><verse number="34" style="v" sid="ACT 23:34"/>ደርያ አይሰይስ ዳብዳብያ ናባብዳፐ ጉየ፥ “ጳዉሎሳ፥ ነ አዉ አዉራጃ አሴ?” ግድ እያ ኦይችስ። እ ክልቅያ አስ ግዶይሳ ኤርዳ ዎደ፥ <verse eid="ACT 23:34"/><verse number="35" style="v" sid="ACT 23:35"/>“ታኒ ነባ ነና ሞተይሳት ያ ዎደ ስአና” ያግስ። ዎታዳረት ጳዉሎሳ ሄሮዲሳ ጋን ናጋና መላ ኪትስ።<verse eid="ACT 23:35"/></para>
  <chapter eid="ACT 23"/>
  <chapter number="24" style="c" sid="ACT 24"/>
  <para style="s1">አይሁደት ጳዉሎሳ ሞትዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1"/>እቻሹ ጋላሳፐ ጉየ ካህነ ሀላቃይ፥ ሀናን፥ ጭማታራነ ፀርፀሉሳ ጌተትያ እስ ፃባቃራ ቅሳረ ብስ። ኤንቲ ደርያ አይሰይሳ ቦላ ጳዉሎሳ ሞትዶሶና። <verse eid="ACT 24:1"/><verse number="2" style="v" sid="ACT 24:2"/>ጳዉሎስ ፄገትድ ገልዳ ዎደ፥ ፀርፀሉስ እያ ሀይሳዳ ያግድ ሞትስ፦</para>
  <para style="p" vid="ACT 24:2">“ቦንቾ ፍልክሳ፥ ኑኒ ነ ባጋራ ዳሮ ሳሮተ ደምዳ፥ ነ ሎኦ አይሱዋን ኑ ቢታይ ዳሮ ላመትስ። <verse eid="ACT 24:2"/><verse number="3" style="v" sid="ACT 24:3"/>ቦንቾ ፍልክሳ፥ ኑኒ አዉንካ አዉደ ግድን ዳሮ ጋላታን ሄሳ ኤኮስ። <verse eid="ACT 24:3"/><verse number="4" style="v" sid="ACT 24:4"/>ታኒ ነና ጋምእሶናሽን ኔኒ ነ ኬሀተን ኑባ ቃንን ስአና መላ ነና ዎሳይስ። <verse eid="ACT 24:4"/><verse number="5" style="v" sid="ACT 24:5"/>ሀ ኡራይ በ ግድድ ቢታ ኡባን ደእያ አይሁደታ ግዶን ቡቀ መድ ናዝራወታ ባጋ አሳ ካለይሳ ግዶይሳ ኤርዳ። <verse eid="ACT 24:5"/><verse number="6" style="v" sid="ACT 24:6"/>ሀር አቶሽን፥ ፆሳ ኬ ቱንሳና ሀንሽን ኑኒ እያ ኦይክዳ፤ ኑ ህግያዳ እያ ቦላ ፕርዳናዉ ቆፕዳ። <verse eid="ACT 24:6"/><verse number="7" style="v" sid="ACT 24:7"/>ሽን ሻላቃ ሉስዮስ ይድ፥ ዎልቃን ኑ ኩሸፐ እያ ዎ ኤክስ። <verse eid="ACT 24:7"/><verse number="8" style="v" sid="ACT 24:8"/>እያ ሞተይሳት ኔኮ ያና መላ ኪትስ። ኔኒ ነ ሁጰን ሀ ኡራ ፕልጋዳ ኑኒ እያ ሞትያ ሞቱዋ ኡባ ኤራናዉ ዳንዳኣሳ” ያግስ።<verse eid="ACT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9"/>አይሁደትካ፥ “ሀ ኦዳይ ቱማ” ግድ እያ ቆፋ ማእዶሶና።<verse eid="ACT 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10"/>ደርያ አይሰይስ ጳዉሎሳ ኦዳ ግድ ማልስ። ጳዉሎስ ሀይሳዳ ግድ ዛርስ፦ “ኔኒ ዳሮ ዎደፐ ዶማዳ፥ ሀ አሳስ ፕርዳሸ ደኤይሳ ኤራዳ ታ ኦዳስ ኡፋይሳን ዛሮ እማይስ። <verse eid="ACT 24:10"/><verse number="11" style="v" sid="ACT 24:11"/>ታኒ የሩሳላመ ጎይናናዉ ከይን ታማነ ናምኡ ጋላሳፐ አናይሳ ኔኒ ነ ሁጰን ኤራናዉ ዳንዳኣሳ። <verse eid="ACT 24:11"/><verse number="12" style="v" sid="ACT 24:12"/>አይሁደት ታና ፆሳ ኬን ግድን አይሁደ ዎሳ ኬን ግድን ካታማን ግድን ኦደራካ ፓላምሽን ዎይኮ አሳ ሺሻዳ ማቅሽን እስ አስካ ደምቤና። <verse eid="ACT 24:12"/><verse number="13" style="v" sid="ACT 24:13"/>ሀእካ ኤንቲ ታና ሞትያባስ ማርካ ደማናዉ ዳንዳኦኮና።<verse eid="ACT 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 24:14"/>“ሽን ታኒ ሀይሳ እስባ አማናይስ፤ ታኒ ህገን ደእያባነ ናበት ፃፍዳ ኡባባ አማናዳ፥ ኑ አዋታ ፆሳ፥ ኤንቲ ዎርዶ ግያ ኦግያን ጎይናይስ። <verse eid="ACT 24:14"/><verse number="15" style="v" sid="ACT 24:15"/>ኤንቲ ባንታ ሁጰን አማነይሳ መላ ፅሎትነ ናጋራንቾት ሀይቆፐ ደንዳናይሳ ታካ አማናይስ። <verse eid="ACT 24:15"/><verse number="16" style="v" sid="ACT 24:16"/>ሄሳ ግሾ፥ ታኒ ፆሳ ስንንነ አሳ ስንን ኡባ ዎደ ሎኦ ካህ ታዉ ዳና መላ ምናይስ።<verse eid="ACT 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17"/>“ታኒ የሩሳላመፐ ከዮሳፐ ዳሮ ላይፈ ጉየ ታ ቢታ ማንቆታስ ማደ እማናዉነ ያርሾ ያርሻናዉ የሩሳላመ ባስ።<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="ACT 21:17-28">ሀዋ 21:17-28</ref>.</char></note> <verse eid="ACT 24:17"/><verse number="18" style="v" sid="ACT 24:18"/>ታኒ ፆሳ ኬን ሄሳ ኦዳ ጌሻ ዎጋ ፖላ ስምን ታና ደምዶሶና። ሄ ዎደ ታራ አስ ባዋ፥ ኦሽካ ከይቤና። <verse eid="ACT 24:18"/><verse number="19" style="v" sid="ACT 24:19"/>ሽን ኢሰፐ ይዳ እስ እስ አይሁደት ሄሳን ደኦሶና፤ ኤንቲ ታ ቦላ ኦዳ ኮይኮ ይድ ታና ነ ቦላ ሞታናዉ ዳንዳኦሶና። <verse eid="ACT 24:19"/><verse number="20" style="v" sid="ACT 24:20"/>ዎይኮ ታኒ ሻንጉዋ ስን ሺቅዳ ዎደ ኦዳ ባል ደእኮ ሀይሳቲ ነ ስንን ደኤይሳት ኦዶና። <verse eid="ACT 24:20"/><verse number="21" style="v" sid="ACT 24:21"/>ታኒ ኤንታ ግዶን ኤቃዳ፥ ‘ሀይቅዳይሳት ደንዳና ጋዳ ዋሳዳ ኦድዳ ግሾ ሀች ህንተ ስንን ታ ቦላ ፕርዶሶና’ ጋስ፤ ሄሳፈ ሀራባ ኦብከ” ያግስ።<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">ሀዋ 23:6</ref>.</char></note><verse eid="ACT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22"/>ሽን ፍልክስ ፆሳ ኦግያባ ጌሽ ኤርዳ ግሾ፥ “ታኒ ህንተ ኦዳ ሻላቃ ሉስዮስ ያ ዎደ ፕርዳና” ያግድ ሞይዝስ። <verse eid="ACT 24:22"/><verse number="23" style="v" sid="ACT 24:23"/>ፍልክስ ቃስ ጳዉሎሳ ቃቾና ናጋና መላነ እያ ዳቦታፐ ኦንካ እያ ኦይቻናዉ ይሽን ድጎና መላ ማቶ ሀላቃ ኪትስ።<verse eid="ACT 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24"/>ጉ ጋላሳፐ ጉየ፥ ፍልክስ አይሁደ ባጋ ግድዳ ባ ማቸ ድሩስላራ ይድ ጳዉሎሳ ኪት ኤህስድ የሱስ ክርስቶሳን አማኖባ እያፐ ስእስ። <verse eid="ACT 24:24"/><verse number="25" style="v" sid="ACT 24:25"/>ጳዉሎስ ፅሎተባ፥ ባ ሁጰ ሃሮባነ ያናዉ ደእያ ፕርዳባ ኦድሽን፥ ፍልክስ ያይድ፥ “ኔኒ ሀእስ ባ፤ ታዉ እንጀትዳ ዎደ ነና ፄግሳና” ያግስ። <verse eid="ACT 24:25"/><verse number="26" style="v" sid="ACT 24:26"/>ሄ ዎደ ጳዉሎሳፐ ዎፈ ኤካናዉ ቆፕድ፥ እያ ዛር ዛር ፄግስድ እያራ ኦደቴስ።<verse eid="ACT 24:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27"/>ናምኡ ላይፈ ጉየ፥ ፍልክሳ በሳ ጶርቅዮስ ፍስፆስ ኤክስ። ፍልክስ አይሁደታ ኡፋይሳናዉ ኮይድ ጳዉሎሳ ብሎና አጋግስ።<verse eid="ACT 24:27"/></para>
  <chapter eid="ACT 24"/>
  <chapter number="25" style="c" sid="ACT 25"/>
  <para style="s1">ጳዉሎስ ፍስፆሳ ስንን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1"/>ፍስፆስ ካዎትዳ ሄ ጋላሳፐ ጉየ ቅሳረፐ የሩሳላመ ብስ። <verse eid="ACT 25:1"/><verse number="2" style="v" sid="ACT 25:2"/>ያን ካህነ ሀላቃትነ አይሁደታ ካለይሳት ጳዉሎሳ ሞትዶሶና። <verse eid="ACT 25:2"/><verse number="3" style="v" sid="ACT 25:3"/>ጳዉሎሳ የሩሳላመ ኤህሽን ኦገን ቆሰትድ እያ ዎናዉ ኤንታዉ እንጀታና መላ ባንታና ማዶ ግድ ፍስፆሳ ዎስዶሶና። <verse eid="ACT 25:3"/><verse number="4" style="v" sid="ACT 25:4"/>ፍስፆስ ኤንታኮ፥ “ጳዉሎስ፥ ቅሳረን ቃሾ ኬን ደኤስ፤ ታኒ ታ ሁጰንካ ኤለሳዳ ጉየ ስማና ሀናይስ። <verse eid="ACT 25:4"/><verse number="5" style="v" sid="ACT 25:5"/>እ ባልዳባይ ደእኮ ህንተ ግዶን አዋተይሳት ታራ ቅሳረ ብድ እያ ሞቶና” ያግድ ዛርስ።<verse eid="ACT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6"/>ፍስፆስ ኤንታ ማታን ሆስፑን ዎይኮ ታሙ ጋላሳ መላ ጋምእዳፐ ጉየ ቅሳረ ብስ። ዎንተ ጋላስ ፕርዳ ኦይደን ኡትድ ጳዉሎሳ ኤሀና መላ ኪትስ። <verse eid="ACT 25:6"/><verse number="7" style="v" sid="ACT 25:7"/>እ ይን የሩሳላመፐ ይዳ አይሁደት እያ ዩሹዋን ኤቅድ ኤንቲ ላናዉ ዳንዳኦና ዳሮ ዴፆ ሞቶ እያ ቦላ ሺሽዶሶና። <verse eid="ACT 25:7"/><verse number="8" style="v" sid="ACT 25:8"/>ጳዉሎስ ዛሪድ፥ “ታኒ አይሁደ ህግያ ግድን ፆሳ ኬ ዎይኮ ሮመ ካዋ ቄሳረ ናቃብከ” ያግስ።<verse eid="ACT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9"/>ሽን ፍስፆስ አይሁደታ ኡፋይሳናዉ ኮይድ ጳዉሎሳኮ፥ “የሩሳላመ ባዳ ሀ ሞቱዋባ ያን ታ ስንን ፕርደታናዉ ኮያይ?” ያግድ ኦይችስ።<verse eid="ACT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10"/>ሽን ጳዉሎስ፥ “ታኒ ፕርደታናዉ በሲያ ቄሳረ ፕርዳ ኬን ኤቃ ክቻስ። ኔኒ ሎይ ኤረይሳዳ ታኒ አይሁደታ አይብንካ ናቃብከ። <verse eid="ACT 25:10"/><verse number="11" style="v" sid="ACT 25:11"/>ህዛ፥ ታኒ ናቅዳባይ ዎይኮ ሀይቆስ ጋያባ ኦዳባ ግድኮ ሀይቆፐ ታና አሻ ጊከ። ሽን ኤንቲ ታና ሞትያ ሞቶይ መላ ግድዳፐ ጉየ ኦንካ ታና ኤንታዉ አድ እማናዉ ዳንዳኤና። ቄሳረይ ታባ ፕርዶ ጋዳ ኦይቻይስ” ያግስ።<verse eid="ACT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12"/>ሄ ዎደ ፍስፆስ ባ ዞራንቾታራ ዞረትድ፥ “ኔኒ ቄሳረይ ታባ ፕርዶ ጋዳ ኦይቻዳሳ፤ ቄሳረኮ ባሳ” ያግድ ዛርስ።<verse eid="ACT 25:12"/></para>
  <para style="s1">ጳዉሎስ አግርጳነ ባርንቀ ስንን</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13"/>ጉ ጋላሳፐ ጉየ ካዎይ አግርጵነ ባርንቀይ ፍስፆሳ ሳሮናዉ ቅሳረ ብዶሶና። <verse eid="ACT 25:13"/><verse number="14" style="v" sid="ACT 25:14"/>ያን ኤንቲ ዳሮ ጋላስ ጋምእን፥ ፍስፆስ ካዋስ ጳዉሎሳባ ሀይሳዳ ያግድ ኦድስ፤ “ፍልክስ ብሎና አግድ ብዳ እስ አደይ ሀይሳን ደኤስ። <verse eid="ACT 25:14"/><verse number="15" style="v" sid="ACT 25:15"/>ታኒ የሩሳላመ ብዳ ዎደ ካህነ ሀላቃትነ አይሁደ ጭማት እያ ቦላ ፕርዳና መላ ታና ዎስድ እያባ ታዉ ኦድዶሶና። <verse eid="ACT 25:15"/><verse number="16" style="v" sid="ACT 25:16"/>ታኒ፥ ‘ሞተትዳ ኡራይ ባና ሞተይሳታ ስንን ኤቅድ ባ ሞትዳባስ ዛሮ እሞናሽን፥ ኦና ግድኮካ አድ እመተይስ ሮመ ህገ ግደና’ ያጋዳ ኤንታዉ ዛራስ።<verse eid="ACT 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 25:17"/>“ሄሳ ግሾ፥ ኤንቲ ሀይሳን ሺቅዳ ዎደ ታኒ ጋምኦና ዎንተ ጋላስ ፕርዳ ኬ ገላዳ ጳዉሎሳ ኤሀና መላ ኪታስ። <verse eid="ACT 25:17"/><verse number="18" style="v" sid="ACT 25:18"/>እያ ሞተይሳት እያ ማታን ኤቅድ፥ ኢታባን እያ ሞቶና አጎኮና ጋዳ ታኒ ቆፕዳይሳ መላ እያ ሞትቦኮና። <verse eid="ACT 25:18"/><verse number="19" style="v" sid="ACT 25:19"/>ሽን ኤንቲ ባንታ ሀይማኖተባነ ጳዉሎስ፥ ‘ፓፃ ደኤስ’ ግያ እስ ሀይቅዳ የሱሳ ጌተትያ አድያባ እያራ ፓላሞሶና። <verse eid="ACT 25:19"/><verse number="20" style="v" sid="ACT 25:20"/>ሀ ኦዳይ ታና ሻካናዉ መትዳ ግሾ፥ ጳዉሎስ የሩሳላመ ብድ፥ ያን ፕርደታናዉ ኮያኮ ጋዳ እያ ኦይቻስ። <verse eid="ACT 25:20"/><verse number="21" style="v" sid="ACT 25:21"/>ሽን ጳዉሎስ ባ ኦዳ ቄሳረይ እያባ በአና ጋካናዉ ቃሾ ኬን ጋምአናዉ ኦይችስ። ታኒ እያ ቄሳረኮ የዳና ጋካናዉ እ ቃሸታና መላ ኪታስ” ያግስ።<verse eid="ACT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22"/>ሄሳ ግሾ፥ አግርጵ ፍስፆሳኮ፥ “ታኒ ታ ሁጰንካ ሄ ኡራይ ግያባ ስአናዉ ኮያይስ” ያግስ።</para>
  <para style="p" vid="ACT 25:22">ፍስፆስ እያኮ፥ “ኔኒ ዎንቶ እ ግያባ ስአና” ያግስ።<verse eid="ACT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23"/>ዎንተ ጋላስ አግርጵነ ባርንቀይ ግታ ቦንቾን ሻላቃታራነ ካታማን ደእያ ግታ አሳታራ ይድ ፕርዳ ኬ ገልዶሶና። ፍስፆስ ጳዉሎሳ ፄግስድ ኤህስ። <verse eid="ACT 25:23"/><verse number="24" style="v" sid="ACT 25:24"/>ፍስፆስ፥ “ካዋዉ አግርጳ፥ ሀይሳን ኑራ ደእያ አሳዉ፥ አይሁደት የሩሳላመንካ ሀይሳንካ ዋስድ፥ ‘እ ህዛፐ ጉየ ፓፃ ዳናዉ በሰና’ ያግድ፥ ታና ዎስዳ ኡራ ሀይሳ በኤታ። <verse eid="ACT 25:24"/><verse number="25" style="v" sid="ACT 25:25"/>ሽን እያ ሀይቆስ ጋያባ አይብባካ ታኒ ደማብከ። እ ባ ሁጰን፥ ‘ቄሳረይ ታባ ፕርዶ ያጋዳ ኦይቻይስ’ ግዳ ግሾ፥ ቄሳረኮ እያ የዳናዉ ቆፋ ቃቻስ። <verse eid="ACT 25:25"/><verse number="26" style="v" sid="ACT 25:26"/>ታኒ እያባ ታ ጎዳ ቄሳረስ ፃፋናዉ ግድያ ጋሶይ አይብካ ባዋ። ሄሳ ግሾ፥ እያባ ህንተ በእኮ ታ ፃፍያባይ በንታነኮ ጋዳ ህንተ ስን ኡባራካ ካዋዉ፥ አግርጳ፥ ነ ስን እያ ኤሀስ። <verse eid="ACT 25:26"/><verse number="27" style="v" sid="ACT 25:27"/>አይስ ጊኮ፥ ቃሸትዳ አስ ቦላ ዳይናስ አያ ዎደ እ አይስ ሞተትዳኮ ቆንጭሶና አገይስ ታዉ ኤያተ ዳኔስ” ያግስ።<verse eid="ACT 25:27"/></para>
  <chapter eid="ACT 25"/>
  <chapter number="26" style="c" sid="ACT 26"/>
  <para style="s1">ጳዉሎሳ ዛሩዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1"/>አግርጵ ጳዉሎሳኮ፥ “ኔኒ ነባ ኦዳናዉ ዳንዳኣሳ” ያግስ። ሄ ዎደ ጳዉሎስ ባ ኩሽያ ደንድ ሀይሳዳ ያግስ፦<verse eid="ACT 26:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2"/>“ካዋዉ፥ አግርጳ፥ አይሁደት ታና ሞትዳባስ ዛሮ እማናዉ ሀች ነ ስንን ኤቃሸ ታ ቃዳይ ሎኦ ጋዳ ቆፓይስ። <verse eid="ACT 26:2"/><verse number="3" style="v" sid="ACT 26:3"/>ኔኒ አይሁደ ዎጋነ ፓላማ ሎይዳ ኤርያ ግሾ ታና ሳለቶና ስአና መላ ነና ዎሳይስ።<verse eid="ACT 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4"/>“ታኒ ናአተፈ ዶማዳ ታ አሳ ግዶንነ የሩሳላመን ደእዳ ታ ደኡዋ አይሁደ ኡባይ ኤሮሶና። <verse eid="ACT 26:4"/><verse number="5" style="v" sid="ACT 26:5"/>ታኒ ኮይሮፐ ዶማዳ፥ ኑ ሀይማኖተ ህግያ ምንድ ናግያ ፋርሳወታ ያራፐ ግደይሳ ኤንቲ ማርካታናዉ ኮይኮ ኤሮሶና።<note caller="-" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">ሀዋ 23:6</ref>፤ <ref loc="PHP 3:5">ፍልጵ 3:5</ref>.</char></note> <verse eid="ACT 26:5"/><verse number="6" style="v" sid="ACT 26:6"/>ሀእካ ታኒ ፆሳይ ኑ አዋታስ እማና ግዳ ኡፋይሳ ናግያ ግሾ ሞተታዳ ሀይሳን ኤቃስ። <verse eid="ACT 26:6"/><verse number="7" style="v" sid="ACT 26:7"/>ቃስ ታማነ ናምኡ ኑ አዋታ ሼሻይ ፆሳ ቃማነ ጋላስ ምንድ ጎይንሸ ፆሳይ እማና ግዳይሳ ኤካናዉ ኡፋይሳን ናጎሶና። ካዋዉ አግርጳ፥ አይሁደት ታና ሞተይ ታኒ ኡፋይሳን ሄሳ ናግያ ግሾሳ። <verse eid="ACT 26:7"/><verse number="8" style="v" sid="ACT 26:8"/>አይሁደቶ፥ ፆሳይ ሀይቅዳይሳታ ደንይሳ አይስ አማነከቲ?<verse eid="ACT 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9"/>“ካሰ ታኒ ታ ሁጰንካ ናዝረተ የሱሳ ሱን ተቃናዉ ዳንዳኤትዳባ ኡባ ኦናዉ በሴስ ጋዳ ቆፓስ።<note caller="-" style="x"><char style="xo" closed="false">26:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሀዋ 8:3</ref>፤ <ref loc="ACT 22:4-5">22:4-5</ref>.</char></note> <verse eid="ACT 26:9"/><verse number="10" style="v" sid="ACT 26:10"/>ታኒ የሩሳላመን ኦዳይ ሀይሳ። ካህነ ሀላቃታፐ ማታ ኤካዳ ፆሳ አሳታፐ ዳሮታ ቃሽሳስ። ኤንታ ዎያ ዎደካ ኤንታ ሀይቁዋ ዶሳስ። <verse eid="ACT 26:10"/><verse number="11" style="v" sid="ACT 26:11"/>ዳሮ ዎደ አይሁደ ዎሳ ኬ ኡባን ኤንቲ ሴረታና መላነ የሱሳ ጫይድ ካዳና መላ ኡንኤስ። ታኒ ዎግ ባይና ኤንታ ሀንቀታዳ ሀር አቶሽን፥ ሀራ ቢታ ካታማታ ጋካናዉ ኤንታ ጎዳስ።<verse eid="ACT 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12"/>“ታኒ ሀ ኦዳስ ካህነ ሀላቃታፐ ማታነ ኪታ ኤካዳ ዳማስቆ ባይስ። <verse eid="ACT 26:12"/><verse number="13" style="v" sid="ACT 26:13"/>ካዋዉ፥ ታኒ ሴታ ጋላስ ኦገን ደእሽን አዋ ፖኦፐ ዳሮ አያ ፖኦይ ታ ዩሹዋንነ ታራ በይሳታ ዩሹዋን ሳሎፐ ፖእስ። <verse eid="ACT 26:13"/><verse number="14" style="v" sid="ACT 26:14"/>ኑኒ ኡባይካ ሳአን ኩንድዳ ዎደ እብራወ ዶናን፥ ‘ሳኦላ፥ ሳኦላ፥ ታና አይስ ጎዳይ? ኔኒ፥ ነና ጫድያ ብራታ ፃምአ ቃክኮ ነና ቆሃሳ’ ያግድ ታዉ ኦድሽን ስአስ።<verse eid="ACT 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15"/>“ታኒ፥ ‘ጎዳዉ፥ ኔኒ ኦኔ?’ ያጋስ።</para>
  <para style="p" vid="ACT 26:15">“ጎዳይ፥ ‘ታኒ፥ ኔኒ ጎድያ የሱሳ፤ <verse eid="ACT 26:15"/><verse number="16" style="v" sid="ACT 26:16"/>ሽን ደንዳ ኤቃ። ሀች ኔኒ ታና በእዳይሳንነ ስንፈ ታ ነዉ በሳናይሳ ሀራታስ ማርካታና መላ ታ ኦሳንቾ ኦዳ ነና ሹማናዉ ነዉ በንታስ። <verse eid="ACT 26:16"/><verse number="17" style="v" sid="ACT 26:17"/>እስራኤለ አሳታፐነ ታኒ ነና ኤንታኮ ኪትያ አይሁደ ግዶናይሳታፐ ነና አሻና። <verse eid="ACT 26:17"/><verse number="18" style="v" sid="ACT 26:18"/>ኔኒ ኤንታ አይፍያ ዶያና፥ ማፐ ፖኦኮ፥ ፃላሄ ኩሸፐ ፆሳኮ ኤንታ ዛራና። ኤንቲ ታናን አማንድ ናጋራ አቶተ ኤካና። ፆሳይ ዶርዳ አሳ ግዶን ባንታ ላታ ደማና’ ያግስ።<verse eid="ACT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19"/>“ካዋዉ አግርጳ፥ ሄሳ ግሾ፥ ታዉ ሳሎፐ በንትዳ ቆንጨስ ኪተታናይሳ እፃብከ። <verse eid="ACT 26:19"/><verse number="20" style="v" sid="ACT 26:20"/>ሽን ታኒ ኮይሮታዳ ዳማስቆን ሄሳፈ ጉየ የሩሳላመንነ ይሁዳ ቢታ ኡባን ደኤይሳትነ አይሁደ ግዶናይሳት ባንታ ናጋራፐ ፆሳኮ ስማና መላነ ናጋራፐ ስሙዋ በሲያ ኦሶ ኦና መላ ቃላ ኦዳስ።<note caller="-" style="x"><char style="xo" closed="false">26:20 </char><char style="xt" closed="false"><ref loc="ACT 9:20">ሀዋ 9:20</ref>፥ <ref loc="ACT 9:28-29">28-29</ref>.</char></note> <verse eid="ACT 26:20"/><verse number="21" style="v" sid="ACT 26:21"/>ሄሳ ግሾ፥ አይሁደት ታና ፆሳ ኬን ኦይክድ ዎናዉ ኮይዶሶና። <verse eid="ACT 26:21"/><verse number="22" style="v" sid="ACT 26:22"/>ሀች ጋካናዉ ፆሳ ማደይ ታፐ ሻከትቤና፤ ያንያ ግሾ፥ ጉስነ ግታስ ማርካታሸ ሀይሳን ኤቃስ። ናበትነ ሙሰይ ሀናና ግድ ኦድዳይሳፈ ሀራ እስባካ ታኒ ኦድዳባይ ባዋ። <verse eid="ACT 26:22"/><verse number="23" style="v" sid="ACT 26:23"/>ሄስካ፥ ‘ክርስቶስ ዋየ ኤካናዉ በሴስ፤ ቃስ ሀይቆፐ ኮይሮ ደንድድ አይሁደታስነ አይሁደ ግዶናይሳታስ አቶተ ፖኦ ኦዳናዉ በሴስ’ ግዳይሳ” ያግስ።<verse eid="ACT 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24"/>ጳዉሎስ ሄሳ ያግድ ዛርሽን፥ ፍስፆስ ባ ቃላ ቁ ኦድ፥ “ጳዉሎሳ፥ ነ ጎያዳሳ፤ ነ ዳሮ ትምርተይ ነና ጎሻተስ ጋስ” ያግስ።<verse eid="ACT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25"/>ሽን ጳዉሎስ፥ “ቦንቾ ፍስፆሳ፥ ታኒ ቱማባነ በሲያባ ኦዳይስፐ አትሽን፥ ጎያብከ። <verse eid="ACT 26:25"/><verse number="26" style="v" sid="ACT 26:26"/>ታኒ ቆንጨን ኦድያ ኦዳ ካዎይ ኤሬስ። ሀ ኦዳይ ጌማን ኦሰትቦና ግሾ እሶይካ እያፐ ጌሞናይሳ ታኒ ጌሻዳ ኤራይስ።<verse eid="ACT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 26:27"/>“ካዋዉ አግርጳ፥ ኔኒ ናበታ አማናሳ ግድኪ? ኔኒ አማነይሳ ታኒ ኤራይስ” ያግስ።<verse eid="ACT 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28"/>ካዎይ አግርጵ፥ ጳዉሎሳኮ፥ “ሀ ጉ ሳተን ታና ክርስታነ ኦናዉ ኮያይ?” ያግስ።<verse eid="ACT 26:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29"/>ጳዉሎስ፥ “ዳሮ ዎደ ግድን ጉ ዎደ ነ ፃላላ ግዶናሽን ሀች ታና ስእያ ኡባይ ሀ ቃሹዋፐ አትሽን፥ ታ መላ ግዳና መላ ፆሳ ዎሳይስ” ያግስ።<verse eid="ACT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30"/>ሄሳፈ ጉየ፥ ካዎይ ፍስፆስ፥ ባርንቀይነ ኤንታራ ኡትዳ ኡባይካ ደንድዶሶና። <verse eid="ACT 26:30"/><verse number="31" style="v" sid="ACT 26:31"/>ያፐ ከይድ ብሸ እሶይ እሱዋራ፥ “ሀ ኡራይ ሀይቆስ ዎይኮ ቃሾስ ጋያባ አይኮካ ኦቤና” ያግድ ኦደትዶሶና። <verse eid="ACT 26:31"/><verse number="32" style="v" sid="ACT 26:32"/>አግርጵ ፍስፆሳኮ፥ “ሀ ኡራይ ‘ቄሳረይ ታባ ፕርዶ’ ጎናኮ ብለታናዉ ዳንዳኤስ ሽን” ያግስ።<verse eid="ACT 26:32"/></para>
  <chapter eid="ACT 26"/>
  <chapter number="27" style="c" sid="ACT 27"/>
  <para style="s1">ጳዉሎስ ሮመ ብስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1"/>ኑኒ ማርካበን ፃለ ባናዉ ቆፋ ቃችዳ ዎደ አዉግስፆሳ ዎታዳረታ ጌተተይሳታፐ እስ ዩልዮሳ ጌተትያ ማቶ ሀላቃስ ጳዉሎሳነ ሀራ ጉ ቃሾ አሳታ አድ እያዉ እምዶሶና። <verse eid="ACT 27:1"/><verse number="2" style="v" sid="ACT 27:2"/>ኢሰ ጋፃን ደእያ ቢታታ ብያ አድራምፅዮነ ማርካበን ገልድ ደንድዳ። ማቀዶነ አስ ግድዳ ተሰሎንቀ አርስፅሮኮስ ኑራ ደኤስ።<verse eid="ACT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3"/>ዎንተ ጋላስ ኑኒ ስዶና ጋክሽን፥ ዩልዮስ ጳዉሎሳስ ኬህድ ባ ላገታኮ ብድ ኮሽያባን ማዳና መላ ኤንታኮ እያ የድስ። <verse eid="ACT 27:3"/><verse number="4" style="v" sid="ACT 27:4"/>ያፐ ደንድድ ስንራ ኑ ቦላ ጫርክያ ግሾ ሃን ተቀትዳ ቢታ፥ ቆጵሮሳን ዘምፕድ አዳ። <verse eid="ACT 27:4"/><verse number="5" style="v" sid="ACT 27:5"/>ክልቅያነ ጵንፍለ ማታን ደእያ አባ ፕንድ ሊቀን ደእያ ሙራ ጋክዳ። <verse eid="ACT 27:5"/><verse number="6" style="v" sid="ACT 27:6"/>ያን ማቶ ሀላቃይ ፃለ ብያ እስክንድረ ማርካበ ደምድ፥ እያን ኑና ገልስስ።<verse eid="ACT 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7"/>ኑኒ ዳሮ ጋላስ ሎዳራ ብድ፥ ዳሮ መቶን ቃንዶሳ ካታማ ማት ጋክዳ። ያራ ባናዉ ኑና ጫርኮይ ድግን ሳልሞናራ አድ ሃን ተቀትዳ ቢታ፥ ቃርፄሳን ዘምፕድ አዳ። <verse eid="ACT 27:7"/><verse number="8" style="v" sid="ACT 27:8"/>ዳሮ መቶን ጋፃ ጋፃ ኦይክድ ላሳ ካታማ ማታን ደእያ አባ ዶናን “ማርካበይ ዎፑ ግድ ሸምፕያ በሲ” ጌተትያ በሳ ጋክዳ።<verse eid="ACT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9"/>ኑኒ ያን ዳሮ ዎደ ጋምእዳፐ ጉየ ፆም ብለትዳ ግሾ ህዛፐ ማርካበን ቡስ መትያ ግሾ ጳዉሎስ ኤንታ ዞርስ። <verse eid="ACT 27:9"/><verse number="10" style="v" sid="ACT 27:10"/>“አሳዉ፥ ኑ ቡሳን ግታ ቦሽነ ዳሮ ቆሆይ ደኤይስ ታዉ በንቴስ፤ ቆሆይ ጫና ቦላነ ማርካብያ ቦላ ፃላላ ግዶናሽን ኑ ደኡዋ ቦላካ ጋካና” ያግስ። <verse eid="ACT 27:10"/><verse number="11" style="v" sid="ACT 27:11"/>ሽን ማቶ ሀላቃይ ጳዉሎስ ግዳይሳፈ አድ ማርካብያ ላገይስነ ማርካብያ ጎዳይ ገይሳን አማንስ። <verse eid="ACT 27:11"/><verse number="12" style="v" sid="ACT 27:12"/>ሄ አባ ዶናን ደእያ ካታማይ ባልጎ አጌና አናዉ ኤንታዉ እንጀቶና ግሾ፥ ዳርያ አሳት ባንታዉ ዳንዳኤትኮ ፍንቀ ካታማ ጋክድ ባልጎ አጌና ያን አናዉ ዞረትዶሶና። ፍንቀይ ፑደሀ-ዉሎሀፐነ ዱገሀ-ዉሎሀፐ ግዶን አባ ዶናን ደእያ ካታማ።<verse eid="ACT 27:12"/></para>
  <para style="s1">አባ ቦላ ጎተይ ደንድስ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13"/>ካዉሻ ዱገሀ ጫርኮይ ሎዳራ ጫርክዳ ዎደ ባንታ ቆፕዳይሳዳ ሀንዳባ ኤንታዉ ዳንን ደንድድ፥ ማርካበይ ቃፆና መላ ኦይክያ ብራታ ፑደ ኤክድ ቃርፄሳ ማታራ አዶሶና። <verse eid="ACT 27:13"/><verse number="14" style="v" sid="ACT 27:14"/>ሽን ዳሮ ጋምኦና “አዉራቅስ” ጌተትያ ዎልቃማ ጎተይ ሃን ተቀትዳ ቢታፈ ዱገ ኤንታ ቦላ ደንድስ። <verse eid="ACT 27:14"/><verse number="15" style="v" sid="ACT 27:15"/>ሄ ጎተይ ማርካብያ ሱግድ ኤፎና ድግዳ ግሾ ጫርኮይ ማርካብያ ባ ዶስዳ ሶ ኤፍስ።<verse eid="ACT 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 27:16"/>ኑኒ ዩሾይ አባን ተቀትዳ ቢታ፥ ቄዳን ዘምፕድ ብሸ ዳሮ መቶተትድ ማርካብያ ዎጎሉዋ አሻናዉ ዳንዳእዳ። <verse eid="ACT 27:16"/><verse number="17" style="v" sid="ACT 27:17"/>ኤንቲ ዎጎሉዋ ፑደ ከስዳፐ ጉየ ዎዶሩዋን ማርካብያ ቦላ ፃፅድ፥ ምን ቃችዶሶና። ሱርትሳ ጌተትያ ሻፍያን ባንታና ዶምኤና ግድ ህርግድ፥ ማርካብያ ሻራ ዎስድ ማርካብያ ጮ የድ አግዶሶና።<verse eid="ACT 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 27:18"/>ጎተይ ዎልቃምሸ ብን ዎንተ ጋላስ ጫናፐ ባጋ አባን ሆሎ ኦይክዶሶና። <verse eid="ACT 27:18"/><verse number="19" style="v" sid="ACT 27:19"/>ሄን ጋላስ ማርካብያ ሚሽያ ኤክድ ባንታ ኩሸን ሆልዶሶና። <verse eid="ACT 27:19"/><verse number="20" style="v" sid="ACT 27:20"/>ኑኒ ዳሮ ጋላስ አዋ አይፈነ ፆልንቶ በኦና ግሾነ ዎልቃማ ኡሾይ ኑ ቦላ ኡሽዳ ግሾ ስንፈ ኑኒ ሸምፖራ አታና ግድ ቆፕቦኮ።<verse eid="ACT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21"/>ሄ ዎደ ኤንቲ ዳሮ ጋላስ ካ ሞና ጋምእዳ ግሾ ጳዉሎስ ኤንታ ግዶን ደንድ ኤቅድ፥ “አሳዉ፥ ህንተ ታ ዞርያ ኤክድ ቃርፄሳፐ ደንዶና አግዳኮ ሀ መቶይነ ቆሆይ ኑና ጋከና። <verse eid="ACT 27:21"/><verse number="22" style="v" sid="ACT 27:22"/>ሽን ታኒ ህንተና ያዮፍተ ጋዳ ዞራይስ፤ አይስ ጊኮ፥ ሀ ማርካበይ ያናፐ አትሽን፥ ህንተፈ እስ አሳ ሸምፖይካ የና። <verse eid="ACT 27:22"/><verse number="23" style="v" sid="ACT 27:23"/>ዝነ ቃማ ታ እያባ ግድዳይስነ ታ ጎይንያ ፆሳይ ኪትዳ ኪታንቾይ ታ ማታን ኤቅድ፥ <verse eid="ACT 27:23"/><verse number="24" style="v" sid="ACT 27:24"/>‘ጳዉሎሳ፥ ያዮፋ፤ ኔኒ ሮመ ቢታ ካዋ ቄሳረ ስንን ኤቃናዉ በሴስ። ሄኮ ፆሳይ ነ ግሾ ኔራ ብያ አሳ ኡባ ሸምፑዋ አሽስ’ ያግስ። <verse eid="ACT 27:24"/><verse number="25" style="v" sid="ACT 27:25"/>ሄሳ ግሾ፥ አሳዉ፥ ያዮፍተ። ሄ ኪታንቾይ ታዉ ኦድዳይስ ሀናናይሳ ታኒ አማናይስ። <verse eid="ACT 27:25"/><verse number="26" style="v" sid="ACT 27:26"/>ሽን ጫርኮይ ኑና ኤፍድ እስ ዩሾይ አባን ተቀትዳ ቢታ ጋፃን ሆላና” ያግስ።<verse eid="ACT 27:26"/></para>
  <para style="s1">ማርካበይ መቅስ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27"/>ታማነ ኦይዳን ቃማን አድረ አባን ኑና ጫርኮይ ገደነ ሃ ሱግሽን፥ ግድ ብላሄ ግድያ ዎደ ማርካብያን ኦይሳታስ ቢታኮ ማትዳባ ዳንስ። <verse eid="ACT 27:27"/><verse number="28" style="v" sid="ACT 27:28"/>ኤንቲ ጪሞተ ኤራናዉ ኮይድ ዎዶሮ ፄራን ዴፅያባ ቃችድ አባን የግን፥ አባይ ሆስፑን ታሙ ዋ ግድስ። ጉ ጋምእድ፥ ዛር የግን ኡሱፑን ታሙ ዋ ግድስ። <verse eid="ACT 27:28"/><verse number="29" style="v" sid="ACT 27:29"/>ኤንቲ አባ ጋፃን ደእያ ሹቻን ዶምኤቶና መላ ያይድ፥ ማርካበይ ቦና መላ ኦይክያ ኦይዱ ብራታታ ማርካብያፐ ጉየራ አባን የግድ፥ ሳእ ዎንታና መላ ፆሳ ዎሶሶና። <verse eid="ACT 27:29"/><verse number="30" style="v" sid="ACT 27:30"/>ማርካብያን ኦይሳት ማርካብያፐ ባቃታናዉ ኮይድ፥ ማርካበይ ቦና መላ ኦይክያ ብራታታ ማርካብያፐ ስን ባጋራ አባን የግያ ዳንን ዎጎሉዋ አባን የግዶሶና። <verse eid="ACT 27:30"/><verse number="31" style="v" sid="ACT 27:31"/>ጳዉሎስ ማቶ ሀላቃኮነ ዎታዳረታኮ፥ “ሀይሳቲ ማርካብያን ሸምፕ ኡቶና እፅኮ ህንተ አታናዉ ዳንዳኤከታ” ያግስ። <verse eid="ACT 27:31"/><verse number="32" style="v" sid="ACT 27:32"/>ሄሳ ግሾ፥ ዎታዳረት ዎጎሎይ ቃሸትዳ ዎዶሩዋ ቃንፅድ የድ አግዶሶና።<verse eid="ACT 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33"/>ሳአይ ዎንታና ሀንሽን ኡባይ ካ ማና መላ ጳዉሎስ አሳኮ፥ “ህንተ ካ ሞና ናግሸ ሀችራ ታማነ ኦይዱ ጋላስ ጋምእደታ። <verse eid="ACT 27:33"/><verse number="34" style="v" sid="ACT 27:34"/>ሄሳ ግሾ፥ ጉ ካ ህንተ ማና መላ ታኒ ህንተና ዎሳይስ። ህንተ ጋሽትሳና መላ ጉ ካ ማናዉ ኮሼስ፤ ሀር አቶሽን ህንተ ሁጰ ብናናፐ እሶይካ የና” ያግስ። <verse eid="ACT 27:34"/><verse number="35" style="v" sid="ACT 27:35"/>ጳዉሎስ ሄሳ ግድ ኡይ ኤክድ ኡባ ስንን ፆሳ ጋላትስ፤ ኡይ መንድ ሙሱ ዶምስ። <verse eid="ACT 27:35"/><verse number="36" style="v" sid="ACT 27:36"/>ኡባይ ምነትድ ባንታዉ ካ ኤክድ ምዶሶና። <verse eid="ACT 27:36"/><verse number="37" style="v" sid="ACT 27:37"/>ኑኒ ማርካብያን ደኤይሳት ናምኡ ፄታነ ላፑን ታማነ ኡሱፑና። <verse eid="ACT 27:37"/><verse number="38" style="v" sid="ACT 27:38"/>ኤንቲ ምድ ካልዳ ዎደ ጫና ግስትያ አባን የግድ ማርካብያ ዴፁዋ ካዉሽዶሶና። <verse eid="ACT 27:38"/><verse number="39" style="v" sid="ACT 27:39"/>ሳአይ ዎንትዳ ዎደ ማርካብያ ኦሳንቾት አዉ ቢታ ጋክዳኮ ኤሮናሽን፥ አባ ጋፃን ደእያ ሻፈነ ስልሞ በእዶሶና። ባንታዉ ዳንዳኤትኮ ማርካብያ ሄ ሻፍያኮ ሺሻናዉ ቆፕዶሶና። <verse eid="ACT 27:39"/><verse number="40" style="v" sid="ACT 27:40"/>ያትድ፥ ማርካበይ ቦና መላ ኦይክያ ብራታታ ብርሽድ አባን የግዶሶና። ሄ ዎደ ላግያ ም ቃችያ ዎዶሩዋ ብርሽዶሶና። ሄሳፈ ጉየ፥ ጫርኮይ ማርካብያ ስን ሱጋና መላ ማርካብያ ኤፍያ ሻራ ስን ባጋራ ቁ ኦድ ቡሱ ዶምዶሶና። <verse eid="ACT 27:40"/><verse number="41" style="v" sid="ACT 27:41"/>ሽን ማርካበይ ሻፈ ዶረን ዶምኤትድ ምተትስ። ማርካብያስ ስን ባጋይ ፁጉንድ ሻፍያ ጫድ ኦይክድ ቃፆና እፅን፥ ጉየ ባጋይ ዙልያ ሱገን መቀረተ ኦይክስ።<verse eid="ACT 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42"/>ዎታዳረት ቃሾ አሳፐ እሶይካ ሃ ዋድ ከስ ኤኮና መላ ኤንታ ዎናዉ ዞረትዶሶና። <verse eid="ACT 27:42"/><verse number="43" style="v" sid="ACT 27:43"/>ሽን ማቶ ሀላቃይ ጳዉሎሳ አሻናዉ ኮይድ ዎታዳረታ ዞረታ እፅስ። ሃ ዋ ኤርያ ኡባይ ማርካብያፐ ሃን ጉፕ ጉፕ ዎድ ካሰትድ ጋፃ ከያና መላ ኪትስ። <verse eid="ACT 27:43"/><verse number="44" style="v" sid="ACT 27:44"/>አትዳይሳት ሳንቃ ቦላነ፥ ማርካብያ መኡዋ ቦላ ከያና መላ ኪትስ። ሄሳዳ ሀንድ ኡባይ ጋፃ ሳሮራ ከይዶሶና። <figure style="fig" alt="Paul's Journey to Rome" file="Paul4-BW.tif" size="span" loc="ACT 27:1—28:14" ref="27:1—28:14">ሮመ ቡሳ</figure><verse eid="ACT 27:44"/></para>
  <chapter eid="ACT 27"/>
  <chapter number="28" style="c" sid="ACT 28"/>
  <para style="s1">ጳዉሎስ ዩሾይ አባን ተቀትዳ ቢታ ማልታን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1"/>ኑኒ ጋፃ ሳሮ ከይዳ ዎደ ጋክዳ በሳይ ዩሾይ አባን ተቀትዳ ቢታ፥ ማልታ ግደይሳ ኤርዳ። <verse eid="ACT 28:1"/><verse number="2" style="v" sid="ACT 28:2"/>ማልታ አሳይ ኑስ ዳሮ ኬሀ ኬህዶሶና። እር ቡክያ ግሾነ ሜግያ ግሾ ታማ ኤድ ኑና ኡባ ሞክዶሶና። <verse eid="ACT 28:2"/><verse number="3" style="v" sid="ACT 28:3"/>ጳዉሎስ ዳሮ አፍራ ሺሽድ ታማን ዎሽን፥ ሾሽ ሴላ ግሾ ከይድ እያ ኩሽያ ቦላ ፃፀትድ እያ ዱክስ። <verse eid="ACT 28:3"/><verse number="4" style="v" sid="ACT 28:4"/>ማልታ አሳይ ሾሽ ጳዉሎሳ ኩሸን ፃፀትዳይሳ በእዳ ዎደ እሶይ እሱዋኮ፥ “ቱማ ሀ ኡራይ ሸምፖ ዎዳ አስ፤ ሀር አቶሽን አባፈ እ አትንካ ፆሳ ፕርዳፈ<note caller="+" style="f"><char style="fr" closed="false">28:4 </char><char style="fq" closed="false">ፆሳ ፕርዳፈ፦ </char><char style="ft" closed="false">ሄ ዎደ ሄ ቢታን ዱማ ዱማ ማጫ ፆሳት ደኦሶና። ኤንታፈ እስንያ ኢታ ኦያ አሳ ፕርድያሮ። እያ ፕርዳ ፆሲ ጌተታ ፄገታሱ።</char></note> አትድ ፓፃ ዳናዉ ዳንዳእቤና” ያግዶሶና። <verse eid="ACT 28:4"/><verse number="5" style="v" sid="ACT 28:5"/>ሽን ጳዉሎስ ባ ኩሽያፐ ሾሻ ዉፃርክድ፥ ታማን የግስ፤ እያ አይኮካ ቆህቤና። <verse eid="ACT 28:5"/><verse number="6" style="v" sid="ACT 28:6"/>ኤንቲ፥ “እያ አሳተይ ክፄስ፥ ዎይኮ አኬኮና ኩንድድ ሀይቄስ” ግድ እያ ናጎሶና። ሽን ዳሮ ዎደ ናግድ እያ አሳተን አይብካ ዱማትዳባይ ይን፥ “ሄስ ፆሰ” ያግድ ባንታ ቆፋ ላምዶሶና። <verse eid="ACT 28:6"/><verse number="7" style="v" sid="ACT 28:7"/>ሄ ሄራን ዩሾይ አባን ተቀትዳ ቢታ ሀላቃ፥ ፑፕልዮሳ ጌተተይሳስ ጋደይ ደኤስ፤ ሄ ጋላስ ጋካናዉ እ ኑና ሲቆን ሞክስ። <verse eid="ACT 28:7"/><verse number="8" style="v" sid="ACT 28:8"/>ፑፕልዮሳ አዋይ ቆፆ፥ ምሻነ ኡሎ ኡትሶን ሀርገትድ ዝንእድ ደኤስ። ጳዉሎስ እያ ሶ ገልድ እያዉ ፆሳ ዎስስ፤ ባ ኩሽያ እያ ቦላ ዎድ ፓስ። <verse eid="ACT 28:8"/><verse number="9" style="v" sid="ACT 28:9"/>ሄሳፈ ጉየ፥ ዩሾይ አባን ተቀትዳ ቢታ፥ ማልታን ደእያ ሀርግያ ሀራ አሳትካ ይድ ፓፅዶሶና። <verse eid="ACT 28:9"/><verse number="10" style="v" sid="ACT 28:10"/>ኤንቲ ኑና ዳሮ ቦንቾ ቦንችዶሶና፤ ኑኒ ማርካበን ባናዉ ደንድዳ ዎደ ኦገስ ኮሽያባ ኑስ እምዶሶና።<verse eid="ACT 28:10"/></para>
  <para style="s1">ጳዉሎስ ሮመ ጋክስ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11"/>ሄ አጌናፐ ጉየ፥ ማልታን ባልጎ አድ ማርካበን ገልድ እስክንድረ ባናዉ ደንድዳ። ሄ ማርካብያ ቦላ ድዮስቆሮሳ ጌተትያ መንተ ኤቃታ ምስለይ ደኤስ። <verse eid="ACT 28:11"/><verse number="12" style="v" sid="ACT 28:12"/>ስራኩሰ ካታማ ገልድ ያን ሄ ጋላስ ኡትዳ። <verse eid="ACT 28:12"/><verse number="13" style="v" sid="ACT 28:13"/>ያፐ ደንድድ ረግዩመ ካታማ ጋክዳ። እስ ጋላሳፐ ጉየ፥ ዱገሀ ባጋ ጫርኮይ ጫርክን፥ ዎንተ ጋላስ ፑትዮላ ካታማ ጋክዳ። <verse eid="ACT 28:13"/><verse number="14" style="v" sid="ACT 28:14"/>ያን ኑኒ እስ እስ አማንያ አሳታ ደምን፥ ባንታራ ሳምንታ ጋምአና መላ ኑና ዎስዶሶና። ሄሳፈ ጉየ፥ ሮመ ብዳ።<verse eid="ACT 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 28:15"/>ሮመን ደእያ አማንያ አሳት ኑባ ስእድ፥ አፍዮሳ ግያን፥ ሄ እማ ኬ ጋካናዉ ኑና ሞካናዉ ይዶሶና። ጳዉሎስ ኤንታ በእዳ ዎደ ፆሳ ጋላትድ ምነትስ።<verse eid="ACT 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16"/>ኑኒ ሮመ ገልዳ ዎደ ጳዉሎስ ባና ናግያ ዎታዳርያራ ባርካ ደኦ ጌተትስ።<verse eid="ACT 28:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17"/>ሄ ጋላሳፐ ጉየ፥ ጳዉሎስ አይሁደታ ሀላቃታ ባኮ ፄግስስ። ኤንቲ ሺቅዳ ዎደ ኤንታኮ፥ “ታ እሻቶ፥ ታኒ ኑ አሳ ዎይኮ ኑ አዋታ ዎጋ ቦላ አይብ ቆሆካ ኦብከ፥ ሽን ታና የሩሳላመን ቃችድ ሮመ አሳስ አድ እምዶሶና። <verse eid="ACT 28:17"/><verse number="18" style="v" sid="ACT 28:18"/>ኤንቲ ታ ሞቱዋ በእድ ሀይቆስ ጋያባ ታ ቦላ አይብባካ ደምቦና ግሾ ታና ብላናዉ ቆፕዶሶና። <verse eid="ACT 28:18"/><verse number="19" style="v" sid="ACT 28:19"/>ሽን አይሁደት ሄሳ እፅዳ ዎደ፥ ‘ታባ ቄሳረይ ፕርዶ’ ያጋስፐ አትሽን፥ ታኒ ታ ደርያ ሞትያባይ ደእን ግደና።<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 25:11">ሀዋ 25:11</ref>.</char></note> <verse eid="ACT 28:19"/><verse number="20" style="v" sid="ACT 28:20"/>ታኒ ህንተና ፄግስዳይ ህንተና በአናዉነ ህንተዉ ሀይሳ ኦዳናሳ። ታኒ ሀ ሳንላታን ቃሸትዳይ እስራኤለ አሳይ ናግያ ኡፋይሳ ግሾሳ” ያግስ።<verse eid="ACT 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21"/>አይሁደ ሀላቃት ጳዉሎሳኮ፥ “ኑስ ይሁዳፐ ነባ ፃፈትዳ ዳብዳበይ ጋክቤና። ያፐ ይዳ አሳታፐ እሶይካ ነባ ኢታ ኦድዳይ ባዋ። <verse eid="ACT 28:21"/><verse number="22" style="v" sid="ACT 28:22"/>ሽን ሀ ነ ካልያ አማኑዋ ዱማ ዱማ በሳን አሳይ እፀይሳ ኑኒ ኤርያ ግሾ ነ ቆፋ ስአናዉ ኮዮስ” ያግዶሶና።<verse eid="ACT 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23"/>ኤንቲ ባንታ ያና ጋላስ ጳዉሎሳስ ቃፃርድ፥ ሄ ጋላስ ዳርድ እ ደእያሱዋ ይዶሶና። እ ዎንታፈ ኦማርስ ጋካናዉ ፆሳ ካዎተባ ኤንታዉ ማርካትስ። ቃስ ኤንቲ የሱሳባ አማናና መላ ሙሰ ህግያፈነ ናበታ ማፃፋፐ ቆንጭስድ ኤንታ ታማርስስ። <verse eid="ACT 28:23"/><verse number="24" style="v" sid="ACT 28:24"/>እሶት እሶት ጳዉሎስ ግዳይሳ አማንዶሶና፥ ሽን ሀራት አማንቦኮና። <verse eid="ACT 28:24"/><verse number="25" style="v" sid="ACT 28:25"/>ኤንቲ ባንታ ግዶን ኦዳ ማኦና እፅዳ ዎደ ጳዉሎስ እስባ ግዳፐ ጉየ ብዶሶና። እ ሀይሳዳ ያግስ፦ “ጌሻ አያናይ ኑ አዋታስ ናብያ እሳያሳ ዶናን ኦድዳይስ ቱማ።<verse eid="ACT 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26"/>“ ‘ኔኒ ሄ አሳኮ ባዳ፥</para>
  <para style="q2" vid="ACT 28:26">ህንተ ስስ ስኤታ፥ ሽን ህንተዉ ገለና፤</para>
  <para style="q2" vid="ACT 28:26">ህንተ በኦ በኤታ፥ ሽን ደመከታ።<note caller="-" style="x"><char style="xo" closed="false">28:26 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">እሳ 6:9-10</ref>.</char></note><verse eid="ACT 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27"/>አይስ ጊኮ፥ ሀ ደርያ ዎዛናይ ሙምስ፤</para>
  <para style="q2" vid="ACT 28:27">ኤንታ ሀይይ ቱልስ፤</para>
  <para style="q2" vid="ACT 28:27">ኤንታ አይፈይካ ጎዘትስ።</para>
  <para style="q1" vid="ACT 28:27">ሄስ ባይነኮ፥ ኤንቲ ባንታ አይፍያን በእድ፥</para>
  <para style="q2" vid="ACT 28:27">ባንታ ሀይን ስእድ፥ ባንታ ዎዛናን አኬክድ፥</para>
  <para style="q2" vid="ACT 28:27">ታኮ ስማናሽን፤</para>
  <para style="q2" vid="ACT 28:27">ታካ ኤንታ ፓናሽን’ ያጋ” ያግስ።<verse eid="ACT 28:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28"/>“ህዛ፥ ሀይስ ፆሳ አቶተ ኪታይ አይሁደ ግዶናይሳታስ ግደይሳ ኤሬታ። ኤንትካ ስአና” ያግስ።<verse eid="ACT 28:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29"/>ጳዉሎስ ሄሳ ግዳፐ ጉየ፥ አይሁደት ባንታ ግዶን ዳሮ ፓላምሸ ከይድ ብዶሶና።<verse eid="ACT 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30"/>ጳዉሎስ ከራ ኬን ናምኡ ላይ ኩመ ደእስ፤ ያን ደእሸ ባኮ ያ ኡባ ሞኬስ። <verse eid="ACT 28:30"/><verse number="31" style="v" sid="ACT 28:31"/>ያሽ ባይናነ ኦንካ ድጎናሽን ፆሳ ካዎተባ ሳባክስ፤ ጎዳ የሱስ ክርስቶሳባ ቆንጭስድ ታማርሴስ።<verse eid="ACT 28:31"/></para>
  <chapter eid="ACT 28"/>
</usx>
