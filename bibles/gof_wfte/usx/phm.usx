<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ፍልሞና ኪታ</para>
  <para style="toc1">ፍልሞና ኪታ</para>
  <para style="toc3">ፍልሞ</para>
  <para style="toc2">ፍልሞና</para>
  <para style="mt1">ጳዉሎስ ፍልሞናስ</para>
  <para style="mt2">ፃፍዳ ኪታ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ፍልሞን ኤረትዳ አማንያ አስ። እ ቆላስያሳ ዎሳ ኬ አስ ግዶና አተና። ፍልሞናስ አናስሞሳ ጌተትያ አይለይ ደኤስ። ሄ አይለይ ባ ጎዳፐ በትድ ብዳ ዎደ ቃሾ ኬን ደእያ ጳዉሎሳራ ጋሄትስ። አናስሞስ የሱሳ አማናና መላ ኦዳይ ጳዉሎሳ። ጳዉሎስ፥ ፍልሞናስ ፃፍዳ ዳብዳበይ፥ ፍልሞን ጉየ ስሚድ፥ እያኮ ብያ ባ አይልያራ ስገታና መላ አኬክሴስ። ጉጅድካ ሀእ አናስሞስ አማንያ አስ ግድዳ ግሾ፥ ህዛፐ ጉየ፥ አማንያ እሻዳ እያ ሞክድ ኤካና መላፐ አትሽን፥ አይለዳ እያ ታይቦና መላ እያዉ ኦዴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሳሮ (1-3)</para>
  <para style="io1">አናስሞሳ ግሾ ጳዉሎስ ፍልሞና ዎሰይሳ (4-22)</para>
  <para style="io1">ሳሮነ አንጆ (22-25)</para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>ታኒ ጳዉሎስ፥ የሱስ ክርስቶሳ ግሾ ቃሾን ደኤይስነ ኑ እሻ ፅሞትዮስ፥ ኑራ ኦያ ኑኒ ዶስያ ፍልሞናስ፥ <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>ነ ሶን ሺቅያ ዎሳ ኬታስ፥ ኑ ምቸ አፍብያስነ ኑራ እስፈ ደእያ ዎታዳረ አርክጳሳስ ፃፍዳ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">2 </char><char style="xt" closed="false"><ref loc="COL 4:17">ቆላ 4:17</ref>.</char></note><verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>ፆሳ ኑ አዋፐነ ኑ ጎዳ የሱስ ክርስቶሳፐ አ ኬሀተይነ ሳሮተይ ህንተዉ ግዶ።<verse eid="PHM 1:3"/></para>
  <para style="s1">ፍልሞና ሲቁዋነ አማኑዋ</para>
  <para style="p">
    <verse number="4-5" style="v" sid="PHM 1:4-5"/>ኔኒ ጌሻታ ዶሰይሳነ ጎዳ የሱሳ አማነይሳ ታኒ ስእያ ግሾ፥ ፆሳ ዎሳሸ ነና ቆፕያ ዎደ ኡባን ታ ፆሳ ጋላታይስ። <verse eid="PHM 1:4-5"/><verse number="6" style="v" sid="PHM 1:6"/>ኔኒ ነ አማኑዋ ሀራታስ ሻከይስ ኑስ ክርስቶስ የሱሳ ባጋራ ያ ሎኦባ ኡባ ኤርሳና መላ ታኒ ፆሳ ዎሳይስ። <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>ጌሻታ ዎዛናይ ነ ኦሱዋን ምንዳ ግሾ፥ ታ እሻዉ፥ ታኒ ነ ሲቁዋን ዳሮ ኡፋይስነ ምን ደማስ።<verse eid="PHM 1:7"/></para>
  <para style="s1">ጳዉሎስ ፍልሞና ዎሴስ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ሄሳ ግሾ፥ ኔኒ ኦናዉ በሲያባ ኦና መላ ነና ኪታናዉ ክርስቶሳ ባጋራ ታዉ ምኖተይ ደኤስ። <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>ታኒ፥ ጭማይ ጳዉሎስ፥ ክርስቶስ የሱሳስ ሀእካ ቃሾን ደኤይስ፥ ሲቆን ነና ዎሳይስ። <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>ታኒ ቃሾን ደአሸ እያዉ ዞርያ አዋ ግዳዳ ታ ናኣ አናስሞሳ ግሾ ነና ዎሳይስ።<note caller="-" style="x"><char style="xo" closed="false">10 </char><char style="xt" closed="false"><ref loc="COL 4:9">ቆላ 4:9</ref>.</char></note> <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>እ ካሰ ነና ማደና፥ ሽን ሀእ ነናካ ታናካ ቱማ ማድያ አስ።<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12-13" style="v" sid="PHM 1:12-13"/>ታኒ ዎዛናፐ ዶስያ አናስሞሳ ኔኮ የዳይስ። ታኒ ዎንገላ ግሾ ቃሸትዳሽን፥ ነ ግሾ ታዉ ኦድ ታና ማዳና መላ ታ ማታን እያ አሻናዉ ኮያስ። <verse eid="PHM 1:12-13"/><verse number="14" style="v" sid="PHM 1:14"/>ሽን ነ ሸነዳ ኦናዉ ኮያስፐ አትሽን፥ ኔራ ዞረቶና ዎልቃን አይኮካ ኦናዉ ኮይከ።<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>አናስሞስ ጉ ዎደ ኔፐ ሻከትዳይስ፥ ኦን ኤር ስሚድ ኡባ ዎደ ኔራ ደኦና አገና። <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>ህዛ፥ ሀይሳፈ ጉየ አናስሞስ አይለ ግዶናሽን፥ አይለፈ እ ዳሮ አስ። እ ታዉ አይ መላ ሲቆ እሸ! ቃስ እ ነዉ አሳ ባጋራካ ጎዳ ባጋራካ አዳ እሻ።<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>ህዛ፥ ኔኒ ታና ነ ላገ ግያባ ግድኮ ታና ሞከይሳዳ እያ ሞካ። <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>እ ነና ቆህዳባይ ዎይኮ እ አጮትዳባይ ደእኮ ታፐ ኤካ። <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>ሄ አጩዋ ታ ቃንፃና ጋዳ ታኒ ጳዉሎስ፥ ታ ኩሸን ፃፋይስ። ኔኒ ታዉ ነ ሸምፑዋ አጮታ ኡትዳይሳ ታኒ ነና አኬክሳናዉ ኮሸና።<verse eid="PHM 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PHM 1:20"/>ታ እሻዉ፥ ጎዳ ባጋራ ኔፐ ማደ ደማናዉ ኮያይስ። ክርስቶሳ ባጋራ ታና ምን። <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>ታኒ ግዳይሳፈ ዳሮ ኔኒ ኦናይሳ ኤራዳ ቃስ ነ ታዉ ኪተታናይሳ አማናዳ ሀይሳ ፃፋይስ።<verse eid="PHM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>ፆሳይ ህንተ ዎሳ ስእድ ታና ህንተኮ ጉየ ዛራና ጋዳ ቆፕያ ግሾ፥ ታዉ እማ ሸምፕያ ኬ ጊግሳ።<verse eid="PHM 1:22"/></para>
  <para style="s1">ሳሮ</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>ክርስቶስ የሱሳ ግሾ ታራ ቃሾን ደእያ ኤጳፍር ነና ሳሮ ሳሮ ጌስ።<note caller="-" style="x"><char style="xo" closed="false">23 </char><char style="xt" closed="false"><ref loc="COL 1:7">ቆላ 1:7</ref>፤ <ref loc="COL 4:12">4:12</ref>.</char></note> <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>ቃስ ታራ እስፈ ኦያ ማርቆስ፥ አርስፅሮኮስ፥ ዴማስነ ሉቃስ ነና ሳሮ ጎሶና።<note caller="-" style="x"><char style="xo" closed="false">24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">ሀዋ 12:12</ref>፥ <ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13:13</ref>፤ <ref loc="ACT 15:37-39">15:37-39</ref>፤ <ref loc="ACT 19:29">19:29</ref>፤ <ref loc="ACT 27:2">27:2</ref>፤ <ref loc="COL 4:10">ቆላ 4:10</ref>፥ <ref loc="COL 4:14">14</ref>፤ <ref loc="2TI 4:10-11">2 ፅሞ 4:10-11</ref>.</char></note><verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>ጎዳ የሱስ ክርስቶሳ አ ኬሀተይ ህንተ አያናራ ግዶ።<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
