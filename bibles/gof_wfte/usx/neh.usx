<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NEH" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ናህመ ማፃፋ</para>
  <para style="toc1">ናህመ ማፃፋ</para>
  <para style="toc3">ናህ</para>
  <para style="toc2">ናህመ</para>
  <para style="mt">ናህመ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ናህመ ማፃፋ፥ ሄ በሳን ሻክድ በአናዉ ዳንዳኤቴስ።</para>
  <para style="ipi">1. ይሁዳ ቢታ አይሳና መላ፥ ፋርሰ ካዎይ ኪትዳ ናህመይ፥ ካለን፥ የሩሳላመ ድርሳ ግምበይ ኦራፅዳይሳ ኦድያ ታርከ።</para>
  <para style="ipi">2. እዝር፥ ህገ ማፃፋ ናባብዳይሳነ አሳይ ባንታ ናጋራ ፓፅድይሳ ኦድያ ማፃፋ።</para>
  <para style="ipi">3. ናህመይ ይሁዳ ቢታ አይስሸ ኦዳ ሀራ ኦሶታ ኦዴስ።</para>
  <para style="ip">ሀ ማፃፋን ዳሮ ቆንጭድ በንተይ ናህመይ ፆሳን አማነትዳይሳነ እ ዎስዳ ዎሳታ።</para>
  <para style="ip">እዝራነ ናህመ ማፃፋን ደእያ ዋና ቆፋት፥</para>
  <para style="ipi">1. ይሁዳ ማዳናዉ ፆሳይ አላጋ ካዎታ ጎኤትስ</para>
  <para style="ipi">2. ይሁዳ አሳይ አላጋ ቢታ አሳን ሱገትዶሶና</para>
  <para style="ipi">3. ይሁድ ጌይድ ፆሳኮ ስማናዉ በሴስ።</para>
  <para style="ip">እዝራ ማፃፋይ ፆሳ ኬነ ያርሾ በሳ ቦላ ዱማይድ ኦዴስ፤ ናህመ ማፃፋይ የሩሳላመ ካታማ ግምበ ድርሳ ኬፆ ቦላ ጫድድ ኦዴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">የሩሳላመ ካታማ ግምበ ድርሳ ኦሰተ (<char style="ior"><ref loc="NEH 1:1-7:73">1:1—7:73</ref></char>)</para>
  <para style="io2">ናህመይ የሩሳላመስ ዎስዳ ዎሳ (<char style="ior"><ref loc="NEH 1:1-2:8">1:1—2:8</ref></char>)</para>
  <para style="io2">ናህመይ አይሶ ኦሶስ የሩሳላመ ቡሳ (<char style="ior"><ref loc="NEH 2:9-20">2:9-20</ref></char>)</para>
  <para style="io2">ግምበ ድርሳ ኦሱዋ (<char style="ior"><ref loc="NEH 3:1-7:4">3:1—7:4</ref></char>)</para>
  <para style="io2">ናህመይ ድኦፐ ስምዳ አሳ ማዝጋብስ (<char style="ior"><ref loc="NEH 7:5-53">7:5-53</ref></char>)</para>
  <para style="io1">እዝራ ጋሶን አሳ አያና ደኦይ ላመትስ (<char style="ior"><ref loc="NEH 8:1-10:39">8:1—10:39</ref></char>)</para>
  <para style="io1">ናህመ ጋሶን ቢታ ቦላ ይዳ ላምያ (<char style="ior"><ref loc="NEH 11:1-12:47">11:1—12:47</ref></char>)</para>
  <chapter number="1" style="c" sid="NEH 1"/>
  <para style="s1">ናህመ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 1:1"/>ሀካልያ ናኣ ናህመ ቃላይ ሀይሳ። አርፀክስስ ፋርሰ ቢታን ካዎትን ላታማን ላይን፥ ክስለ ጌተትያ አጌናን፥ ታኒ ናህመይ ዋና ካታማ ግድያ ሱሳን ደአይስ። <verse eid="NEH 1:1"/><verse number="2" style="v" sid="NEH 1:2"/>ታ እሻታፐ እሶይ፥ ሀናን፥ ሀራ አሳታራ እስፈ ይሁዳፐ ታኮ ይን፥ ታኒ የሩሳላመባነ ባብሎነ ድኤቶና አትዳ አይሁደታባ ኤንታ ኦይቻስ።<verse eid="NEH 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 1:3"/>ኤንቲ ዛሪድ፥ “ባብሎነ ድኤቶና አትዳ አሳይነ ድኤትድ ስምዳ አይሁደት ግታ መቶንነ ካዉሻን ደኦሶና። የሩሳላመ ግምበ ድርሳይ ላለትስ ቃስ ግምብያ ፐንገት ታማን ፁገትዶሶና” ያግዶሶና።<verse eid="NEH 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 1:4"/>ታ ሀይሳ ኡባ ስእዳ ዎደ ኡታዳ ዬካስ። ዳሮ ጋላስ አዛኖንነ ፆማን ሳሎ ፆሳ ሀይሳዳ ያጋዳ ዎሳስ።<verse eid="NEH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 1:5"/>“አቤት ጎዳዉ፥ ሳሎ ፆሳዉ፥ ግታዉ፥ ቦንቸትዳይሶ፥ ነና ዶሰይሳታስነ ነ ኪታ ናገይሳታስ ነ መርና ሲቆ ጫቁዋ ናጋሳ። <verse eid="NEH 1:5"/><verse number="6" style="v" sid="NEH 1:6"/>ታኒ ነ አይለይ፥ ነ አይለ ግድዳ እስራኤለ አሳ ግሾ ቃማነ ጋላስ ዎስያ ዎሳ ስአናዉ ነ ሀይይ ሀይዞ፤ ነ አይፈይ ታና ፄሎ። ኑ እስራኤለ አሳይ ኦዳ ናጋራ ኡባ ነዉ ፓፃይስ፤ ቱማ ታንነ ታ ማይዛት ነና ናቅዳ። <verse eid="NEH 1:6"/><verse number="7" style="v" sid="NEH 1:7"/>ኑኒ ነ ቦላ ዳሮ ኢታ ናጋራ ኦዳ፤ ኔኒ ነ አይልያ ሙሰ ባጋራ ኑስ እምዳ ኪታ፥ ዎጋነ ህግያ ናግቦኮ። <verse eid="NEH 1:7"/><verse number="8" style="v" sid="NEH 1:8"/>ነ አይልያ ሙሰስ ነ ኦድዳ ቃላ ሀያና ቆፓ፤ ኔኒ፥ ‘ህንተ ታዉ አማነቶና እፅኮ፥ ታኒ ህንተና አይሁደ ግዶና ቢታታን ላላና። <verse eid="NEH 1:8"/><verse number="9" style="v" sid="NEH 1:9"/>ሽን ህንተ ታኮ ስሚድ፥ ታ ኪታ ናግኮ፥ ህንተ ሀር አቶሽን ሳኣ ጋፃ ጋካናዉ ላለትኮካ፥ ታ ሱንይ ፄገታና መላ ዶርዳ በሳ ዛራዳ ኤሀና’ ግዳይሳ ቆፓ።<verse eid="NEH 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 1:10"/>“ኔኒ ነ ግታ ዎልቃንነ ነ ምኖ ቀስያን ዎዛ ኤክዳ ነ አይለታነ ነ አሳታ። <verse eid="NEH 1:10"/><verse number="11" style="v" sid="NEH 1:11"/>አቤት ጎዳዉ፥ ታኒ ነ አይለይ ዎስያ ዎሳነ ነና ቦንቻናዉ ዶስያ፥ ነ አይለታ ዎሳ ነ ሀይይ ስኦ። ታ ነ አይለይ ሀች ኦናዉ ኮይዳባይ ታዉ ኡሻጫናዳ፥ ካዋ ስንን ታዉ ሳባ እማ” ያጋስ።</para>
  <para style="p" vid="NEH 1:11">ታኒ ሄ ዎደ ካዋስ ዎይነ ኡሻ ትግያ አስ።<verse eid="NEH 1:11"/></para>
  <chapter eid="NEH 1"/>
  <chapter number="2" style="c" sid="NEH 2"/>
  <para style="s1">ናህመይ የሩሳላመ ቡሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 2:1"/>አርፀክስስ ካዎትዳ ላታማን ላይን፥ ንሳነ ጌተትያ አጌናን፥ እስ ጋላስ ካዋ ስንን ዎይነ ኡሻ ሺሻስ። ሄ ጋላሰፐ አትሽን፥ ካሰ ካዋ ስንን አዛና ኤርከ። <verse eid="NEH 2:1"/><verse number="2" style="v" sid="NEH 2:2"/>ሄሳ ግሾ፥ ካዎይ፥ “ነና ሳክያባይ ባዋ፥ ሽን ሀይሳ መላ አይስ አዛናዲ? ሄስ ነ ዎዛናይ እስባን አዛንዳይሳ በሴስ” ያግስ።</para>
  <para style="p" vid="NEH 2:2">ያግን፥ ታኒ ዳሮ ያያዳ፥ ካዋኮ፥ <verse eid="NEH 2:2"/><verse number="3" style="v" sid="NEH 2:3"/>“ካዎይ መርናዉ ካዎቶ! ታ ማይዛት ሞገትዳ ካታማይ ላለትድ ይን፥ ቃስ ሄ ካታማ ድርሳ ፐንገት ታማን ፁገትን አይስ አዛንክና?” ያጋስ።<verse eid="NEH 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 2:4"/>ካዎይ ዛሪድ፥ “ያትን፥ ሀእ ታ ነዉ አይ ኦና መላ ኮያይ?” ያግስ።</para>
  <para style="p" vid="NEH 2:4">ታኒ ሳሎ ፆሳ ዎሳ ስማዳ፥ <verse eid="NEH 2:4"/><verse number="5" style="v" sid="NEH 2:5"/>ካዋኮ፥ “ካዋዉ፥ ታ ነ ስንን ሳባ ደምዳባ ግድኮነ ታ ኦይሻይ ኡፋይስያባ ግድኮ፥ ይሁዳ ቢታ፥ ታ ማይዛት ሞገትዳ ካታማ ባዳ ዛራ ኬፃና መላ ታና የዳርክ” ያጋስ።<verse eid="NEH 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 2:6"/>ሄ ዎደ ካውያ፥ ካዋ አርፀክስሳ ማታን ኡትዳ ደእሽን፥ ካዎይ ዛሪድ፥ “ነ ኦገይ አይ መላ ዎደ ኤካኔ? ነ አዉደ ስማኔ?” ያግድ ታና ኦይችስ። ታኒ ታ ስማና ዎድያ እያዉ ኦድን፥ ካዎይ ኡፋይትድ ታና የድስ።<verse eid="NEH 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 2:7"/>ቃስ፥ “ካዋ፥ ነና ኡፋይስያባ ግድኮ፥ ታ ይሁዳ ጋካናዉ ሄ ቢታራ ካንዳ አና መላ ኤፍራፂሳ ሻፋፐ ዉሎሀ ባጋራ ደእያ ቢታ ሃረይሳታስ ዳብዳበይ ፃፈቶ” ያጋዳ ካዋ ዎሳስ። <verse eid="NEH 2:7"/><verse number="8" style="v" sid="NEH 2:8"/>ሄሳዳካ፥ “ፆሳ ኬ ፐንግያ ጊግሳናዉ፥ ካታማ ግምበ ድርሳ ድራናዉነ ታ ዳና ኬ ኬፃናዉ ታዉ ም እማና መላ ካዎ ዎራ ናግያ አሳፋስ ዳብዳበይ ፃፈቶ” ያጋዳ ኦይቻስ። ፆሳ ሎኦ ኩሸይ ታራ ደእያ ግሾ ካዎይ ታኒ ኦይችዳባ ኡባ እሚስ።<verse eid="NEH 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 2:9"/>ካዎይ ታራ ጉ ቶራ ሞጮናታነ ፓራ ቶገይሳታ የድስ። ታኒ ኤንታራ እስፈ ኤፍራፂሳ ሻፋፐ ዉሎሀ ባጋ ቢታ ጋካዳ ካዎይ የድዳ ዳብዳብያ ሄ ቢታ ሃረይሳታስ እማስ። <verse eid="NEH 2:9"/><verse number="10" style="v" sid="NEH 2:10"/>ሽን ሆሮና ካታማ አስ ግድዳ ሳንባላፅነ አሞነ ቢታ ሀላቃ ግድዳ ፆበይ፥ “እስራኤለ አሳስ ሎኦባ ኦያ አስ ይስ” ጌተትዳይሳ ስእዳ ዎደ ዳሮ ይሎትዶሶና።<verse eid="NEH 2:10"/></para>
  <para style="s1">ናህመይ የሩሳላመ ግምበ ድርሳ በእስ</para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 2:11"/>ታኒ የሩሳላመ ጋካዳ ሄ ጋላስ ያን ጋምአስ። <verse eid="NEH 2:11"/><verse number="12" style="v" sid="NEH 2:12"/>የሩሳላመስ ታኒ ኦና መላ ፆሳይ ታ ዎዛናን ዎዳ ቆፋ ኦደስካ ኦዳብከ። ሄሳፈ ጉየ፥ ታራ ደእያ አሳፐ ጉታ ኤካዳ ቃማ ደንዳዳ ባስ። ሄ ዎደ ታኒ ቶግዳ መህያፐ ሀራ ቶጋ መሄይ ኑስ ባዋ። <verse eid="NEH 2:12"/><verse number="13" style="v" sid="NEH 2:13"/>ታኒ ብላሄ ደንዳዳ ዛንጋራ ፐንግያራ ካንዳ፥ ዳወ ፑልቶ ጌተትያ በሳራ አዳ፥ ፕቶ ፐንገ<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fq" closed="false">ፕቶ ፐንገ፦ </char><char style="ft" closed="false">የሩሳላመ ካታማ ቡረን ኬ ፕቶ ኡባ የግያ በሲ ጉሱ።</char></note> ጌተትያ በሳ ጋካናዉ ባስ። ያራ አሸ ላለትዳ የሩሳላመ ግምብያነ ታማን ፁገትዳ ግምበ ፐንገታ በአስ። <verse eid="NEH 2:13"/><verse number="14" style="v" sid="NEH 2:14"/>ሄሳፈ ስማዳ ፑልቶ ፐንግያኮነ ካዋ ተቀ ሃይ ደእያ በሳ ባስ። ግዶሽን፥ ታ ቶግዳ መሄይ አያ ኦገ ደማብከ። <verse eid="NEH 2:14"/><verse number="15" style="v" sid="NEH 2:15"/>ሄሳ ግሾ፥ ቃማ ቀድሮና ዛንጋራ ግዶራ አዳ ግምብያ በአስ። ዉርሰን፥ ጉየ ስማዳ ዛንጋራ ፐንግያራ ካታማ ገላስ።<verse eid="NEH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 2:16"/>ያን ደእያ ሀላቃታፐ ኦንካ ታኒ አዉ ብዳኮ፥ ዎይኮ አይ ኦዳኮ ኤርቤና። አይስ ጊኮ፥ ታኒ አይሁደታስ፥ ካህነታስ፥ ቦንቸትዳ አሳታስ፥ ሀላቃታስነ ኦሱዋ ኦናዉ ደእያ አሳፐ ኦደስካ ታ ቆፋ ኦዳብከ። <verse eid="NEH 2:16"/><verse number="17" style="v" sid="NEH 2:17"/>ሄሰፈ ጉየ፥ ኤንታኮ፥ “ኑኒ አይ መላ መቶን ደእያኮ በኤታ፤ የሩሳላመ ካታማይ ላለትስ፤ ግምበ ፐንገት ታማን ፁገትዶሶና። ሀ ዪተ፥ የሩሳላመ ግምብያ ዛሪድ ግምቦስ፤ ኑና ጋክዳ ዬላ አነ ድጎስ” ያጋስ። <verse eid="NEH 2:17"/><verse number="18" style="v" sid="NEH 2:18"/>ቃስ ፆሳ ሎኦ ኩሸይ ታራ ደኤይሳነ ካዎይ ታዉ ኦድዳባ ኡባ ኤንታዉ ኦዳስ።</para>
  <para style="p" vid="NEH 2:18">ኤንቲ ዛሪድ፥ “አነ ደንዶስ፤ ዛሪድ ግምቦስ” ያግድ ባንታ ኩሽያ ሎኦ ኦሶስ ምንዶሶና።<verse eid="NEH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 2:19"/>ሽን ሆሮና ካታማ አስ ግድዳ ሳንባላፅ፥ አሞነ ቢታ አስ ግድዳ ፆበይነ አራባ ቢታ አስ ግድዳ ጌሳመይ ሄሳ ስእዳ ዎደ፥ ኑ ቦላ ቀልቅስድ ሚጭዶሶና። “ሀይስ ህንተ ኦያባይ አይቤ? ዎይኮ ካዋ ቦላ ማካላናዉ ኮዬቲ?” ያግድ ኦይችዶሶና።<verse eid="NEH 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 2:20"/>ታኒ ዛራዳ፥ “ሳሎ ፆሳይ ኑና ፖልሳና፤ ኑኒ እያ አይለት ደንድድ ኦና። ሽን የሩሳላመን ህንተዉ ግሾይ ዎይኮ ህንተና ጋያባይ ዎይኮ ህንተና ቆፍስያባይ ባዋ” ያጋስ።<verse eid="NEH 2:20"/></para>
  <chapter eid="NEH 2"/>
  <chapter number="3" style="c" sid="NEH 3"/>
  <para style="s1">ግምበ ድርሳ ኦሳንቾታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 3:1"/>ካህነ ሀላቃይ ኤልያሴብነ ሀራ ካህነት ዶርሳ ፐንግያ ዛር ግምብድ ፆሳስ ዱማይዶሶና፤ ሳንቃ አዶሶና። ኤንቲ ፄታ ጌተትያ ግምበ ሻኩዋፈ ብድ ሀናንኤላ ጌተትያ ግምበ ሻኩዋ ጋካናዉ ግምብድ ፆሳስ ዱማይዶሶና።<verse eid="NEH 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NEH 3:2"/>ኤንታ ላንቀን ደእያ በሳ እያርኮ አሳይ ግምብን፥ ካልድ ደኤይሳ እምራ ናአይ ዛኩር ግምብስ።<verse eid="NEH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 3:3"/>ሀስናአ ናይት ሞሎ ፐንግያ ግምብዶሶና። ኤንቲ ጎባነ ኤስድ፥ ሳንቃ አዶሶና፤ ሳንቃ ጎርድያ ካሱዋነ ካሱዋ ገልስያ ሳጋዩዋ ጊግስዶሶና።<verse eid="NEH 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 3:4"/>ኤንታ ካልድ ደእያ በሳ ሀቆፃ ናአ ግድዳ ኡራያ ናአይ ማረሞት ግምብስ።</para>
  <para style="p" vid="NEH 3:4">እያፐ ካልድ ደእያ በሳ ማሰዛቤላ ናአ ባራካ ናአይ ማሱላም ግምብስ።</para>
  <para style="p" vid="NEH 3:4">እያፐ ካልድ ደእያ በሳ ባአና ናአይ ሳዶቅ ግምብስ።<verse eid="NEH 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 3:5"/>እያ ማታን ደእያ በሳ ታቆሀ ካታማ አሳት ግምብዶሶና። ሽን ሄ ካታማ ሀላቃት ባንታዉ እመትዳ ኦሱዋ ኦና እፅዶሶና።<verse eid="NEH 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 3:6"/>ፓሰሀ ናአይ ዮዳሄይነ ባሶድያ ናአይ ማሱላም ጋልአ ፐንግያ ግምብዶሶና። ኤንቲ ጎባነ ኤስድ፥ ሳንቃ አዶሶና፤ ሳንቃ ጎርድያ ካሱዋነ ካሱዋ ገልስያ ሳጋዩዋ ጊግስዶሶና።<verse eid="NEH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 3:7"/>ኤንታ ላንቀን ደእያ በሳ ጋባኦና ካታማ አስ ግድዳ ማላፅነ መሮኖታ ካታማ አስ ግድዳ ያዶን ግምብዶሶና። ጋባኦናነ ምፅጳ ካታማ አሳይ ኤንታራ እስፈ ግድድ፥ ኤፍራፂሳ ሻፋፐ ዉሎሀ ባጋ ቢታ ሃረይስ ደእያ ኬ ጋካናዉ ደእያ በሳ ግምብዶሶና።<verse eid="NEH 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 3:8"/>ዎርቃ ሼሽያ ሀርሀያ ናአይ ኡዝኤል ኤንታ ማታን ደእያ በሳ ግምብስ። ቃስ እያ ማታን ደእያ በሳ ሽቶ ኦያ ሀናን ግምብስ። ኤንቲ ናምአይ እስፈ የሩሳላመ ዳልጋ ግምብያ ጌተትያ በሳ ጋካናዉ ደእያ በሳ ግምብዶሶና።<verse eid="NEH 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 3:9"/>ኤንታ ማታን ደእያ በሳ ሁራ ናአይ፥ የሩሳላመ ዎራዳስ ባጋ ሃርያ ራፋይ ግምብስ።<verse eid="NEH 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 3:10"/>ሀሩማ ናአይ ያዳይ ባ ኬፈ ስን ባጋራ ደእያ በሳ ግምብስ።</para>
  <para style="p" vid="NEH 3:10">እያ ማታን ደእያ በሳ አሰባና ናአይ ሀቱሽ ግምብስ።<verse eid="NEH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 3:11"/>ሀርማ ናአይ ማልከይነ ፓሀት-ሞአባ ናአይ ሀሹብ እያ ማታን ደእያ በሳነ እቶነ ሻኮ ግምብያ ግምብዶሶና።<verse eid="NEH 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 3:12"/>ኤንታ ማታን ደእያ በሳ ሀሎሄሳ ናአይ፥ የሩሳላመ ዎራዳስ ናምአን ባጋ ሃርያ ሳሉምነ እያ ማጫ ናይት ግምብዶሶና።<verse eid="NEH 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 3:13"/>ሀኑንነ ዛኖሀ ካታማን ደእያ አሳይ እስፈ ዛንጋራ ፐንግያ ግምብዶሶና። ኤንቲ ጎባነ ኤስድ፥ ሳንቃ አዶሶና፤ ሳንቃ ጎርድያ ምነ ም ገልስያ ሳጋዩዋ ጊግስዶሶና። ፕቶ ፐንግያ ጋካናዉ እስ ሙኩሉ ዋ አዱሳ ግምብያ ጉጅድ ግምብዶሶና።<verse eid="NEH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 3:14"/>ራካባ ናአይ፥ ቤት-ሀካሬማ ዎራዳ ሃርያ ማልከይ ፕቶ ፐንግያ ግምብስ። ኤንቲ ጎባነ ኤስድ፥ ሳንቃ አዶሶና፤ ሳንቃ ጎርድያ ካሱዋነ ካሱዋ ገልስያ ሳጋዩዋ ጊግስዶሶና።<verse eid="NEH 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 3:15"/>ኮልሃዛ ናአይ፥ ምፅጳ ዎራዳ ሃርያ ሳሉም ፑልቶ ፐንግያ ዛሪድ ግምብስ። እ ፐንግያስ ካማ ጊግስድ ሳንቃ አስ፤ ሳንቃ ጎርድያ ካሱዋነ ካሱዋ ገልስያ ሳጋዩዋ ጊግስስ። ቃስ፥ ሰላሀ ተቀ ሃይ ደእያ ባጋራ ካዋ አታክልተ በሳፈ ዶምድ፥ ዳዊታ ካታማፐ ዱገ ዎስያ ደ ጋካናዉ ደእያ ግምብያ ግምብስ። <verse eid="NEH 3:15"/><verse number="16" style="v" sid="NEH 3:16"/>ቤት-ፁራ ዎራዳስ ባጋ ሃርያ አዝቡቀ ናአይ ናህመይ ግምብስ። እ ዳዊታ ዱፉዋፐ ስን ባጋራ ደእያ በሳ ጋካናዉ፥ አስ ኦዳ ተቀ ሃይ ደእያ በሳ ጋካናዉ፥ ኦላንቾታ ኬ ጋካናዉ ደእያ በሳ ግምብስ።<verse eid="NEH 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 3:17"/>ሀይሳፈ ካለይሳ ባና ናኣ ረሁማ አዋተ ጋርሳን ደእያ ሌወት ግምብዶሶና።</para>
  <para style="p" vid="NEH 3:17">ኤንታ ማታን ደእያ በሳ ቅኣላ ዎራዳስ ባጋ ሃርያ ሀሻብ ባ ዎራዳ ሱንን ግምብስ። <verse eid="NEH 3:17"/><verse number="18" style="v" sid="NEH 3:18"/>እያፐ ካልድ ሄናዳዳ ናአይ፥ ቅኣላ ዎራዳስ ናምአን ባጋ ሃርያ ባው ግምብዶሶና። <verse eid="NEH 3:18"/><verse number="19" style="v" sid="NEH 3:19"/>ኤንታ ማታን ደእያ በሳ እያሱ ናአይ፥ ምፅጳ ዎራዳ ሃርያ ኤዘር ግምብስ። እ ኦላ ሚሸ ዎያ ኬፈ ስን ባጋራ ግምብያ ማዛንያ ጋካናዉ ደእያ በሳ ግምብስ። <verse eid="NEH 3:19"/><verse number="20" style="v" sid="NEH 3:20"/>እያፐ ካለይሳ ዛባያ ናአይ ባሮክ፥ ግምብያ ማዛንያፐ ብድ፥ ካህነ ሀላቃ ኤልያሴባ ኬ ፐንግያ ጋካናዉ ደእያ በሳ ግምብስ። <verse eid="NEH 3:20"/><verse number="21" style="v" sid="NEH 3:21"/>እያፐ ካለይሳ ሀቆፃ ናኣ ግድዳ ኡራያ ናአይ ማረሞት ኤልያሴባ ኬ ፐንግያፈ ዶምድ፥ ዉርሰ ጋካናዉ ደእያ በሳ ግምብስ።<verse eid="NEH 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 3:22"/>እያፐ ካልድ ደኤይሳ ሄራን ደእያ ካህነት ግምብዶሶና። <verse eid="NEH 3:22"/><verse number="23" style="v" sid="NEH 3:23"/>ኤንታፈ ካልድ ብንያመይነ ሀሹብ ባንታ ኬ ስንን ደእያ በሳ ግምብዶሶና።</para>
  <para style="p" vid="NEH 3:23">ኤንታፈ ካልድ አናንያ ናአ ግድዳ ማእሰያ ናአይ አዛር ባ ኬ ስንን ደእያ በሳ ግምብስ። <verse eid="NEH 3:23"/><verse number="24" style="v" sid="NEH 3:24"/>እያፐ ካልድ አዛራ ኬፈ ብድ፥ ግምብያ ማዛንያ ጋካናዉ ደእያ በሳ ሄናዳዳ ናአይ በኑይ ግምብስ። <verse eid="NEH 3:24"/><verse number="25" style="v" sid="NEH 3:25"/>ኡዛያ ናአይ ፓላል ግምብያ ማዛንያፐ ዶምድ፥ እ ናገይሳታ ዳባባ ማታን ደእያ ቆሞ ባጋ ካዎ ጋ ናጎ ግምብያ ጋካናዉ ደእያ በሳ ግምብስ።</para>
  <para style="p" vid="NEH 3:25">እያፐ ካልድ ደኤይሳ ፓኖሰ ናአይ ፓዳይነ <verse eid="NEH 3:25"/><verse number="26" style="v" sid="NEH 3:26"/>ኦፌላ ደርያ ቦላ ደእያ ፆሳ ኬ አይለት ግምብዶሶና። ኤንቲ ሃ ፐንግያ ማታን ዶሎሀ ባጋን ደእያ በሳነ ናጎ ግምብያ ጋካናዉ ደእያ በሳ ግምብዶሶና። <verse eid="NEH 3:26"/><verse number="27" style="v" sid="NEH 3:27"/>ኤንታፈ ካልድ ታቆሀ ካታማ አሳይ ግምብያ ስንን ደእያ በሳፈ ብድ፥ ኦፌላ ማታን ደእያ ግምብያ ጋካናዉ ደእያ በሳ ግምብዶሶና።<verse eid="NEH 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 3:28"/>ፓራ ፐንግያፈ ቆሞ ባጋን፥ ባንታ ኬ ስንን ደእያ በሳ ካህነት ግምብዶሶና። <verse eid="NEH 3:28"/><verse number="29" style="v" sid="NEH 3:29"/>ኤንታፈ ካልድ እመራ ናአይ ሳዶቅ ባ ኬ ስንን ደእያ በሳ ግምብስ።</para>
  <para style="p" vid="NEH 3:29">እያፐ ካልድ ዶሎሀ ፐንግያ ናግያ ሳካና ናአይ ሻማየይ ግምብስ። <verse eid="NEH 3:29"/><verse number="30" style="v" sid="NEH 3:30"/>እያፐ ካልድ ሳላማ ናአይ ሀናንነ ዛላፋ ኡሱፑን ናአ ግድዳ ሀኑኒራ ግምብዶሶና።</para>
  <para style="p" vid="NEH 3:30">ኤንታፈ ካልድ ባራካ ናአይ ማሱላም ባ ክፍልያፐ ስንን ደእያ በሳ ግምብስ። <verse eid="NEH 3:30"/><verse number="31" style="v" sid="NEH 3:31"/>እያፐ ካልድ ፆሞሶ ፐንግያ ስንን ደእያ ፆሳ ኬ ኦሳንቾታነ ዛልአንቾታ ኬ ጋካናዉ ደእያ በሳ ዎርቃ ሼሽያ ማልከይ ግምብስ። ቃስ እ ግምበ ማዛንያስ ቦላ ባጋራ ደእያ በሳካ ግምብስ። <verse eid="NEH 3:31"/><verse number="32" style="v" sid="NEH 3:32"/>ማዛንያስ ቆሞ ባጋ ክፍልያፐነ ዶርሳ ፐንግያፈ ግዶን ደእያ በሳ ዎርቃ ሼሸይሳትነ ዛልአንቾት ግምብዶሶና።<verse eid="NEH 3:32"/></para>
  <chapter eid="NEH 3"/>
  <chapter number="4" style="c" sid="NEH 4"/>
  <para style="s1">ሞርከይ መዳ ኤቀተ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 4:1"/>ኑኒ ድርሳ ግምበ ኦሱዋ ዶምዳይሳ ሳንባላፅ ስእዳ ዎደ ይሎ ኤፅድ ኑና ለቅስ። <verse eid="NEH 4:1"/><verse number="2" style="v" sid="NEH 4:2"/>ባ ላገታነ ሳማረ ኦላንቾታ ስንን፥ “ሀ ፓና አይሁደት አይ ኦናዉ ቆፖና? ድርሳ ግምብያ ዛር ግምባናዉ ኮዮናዬ? ያርሾ ያርሻናዉ ኮዮናዬ? ኤንቲ እስ ጋላሳን ኦሱዋ ኦድ ዉርሳና ዳኒ? ኤንቲ ግምቤስ ሀንያ ሹቻታ ፁገትድ ዶረትዳይሳ ግዶፈ ከሳናዉ ዳንዳኦና?” ያግስ።<verse eid="NEH 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 4:3"/>እያ ማታን ኤቅዳ አሞነ ቢታ አስ ግድዳ ፆበይ፥ “ኤንቲ ዋንዳ ግምበ ግምባናዉ ዳንዳኦና? ኤንቲ ግምብያ ቦላ ዎርካን ከያኮ ላለታና” ያግድ ለቅስ።<verse eid="NEH 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 4:4"/>ታኒ ሀይሳዳ ያጋዳ ዎሳስ፤ “ኑ ፆሳዉ፥ ኤንቲ ኑና ዋት ለቅስያኮ፥ ሀይሳ በአ! ኤንቲ ኑና ጫይያ ጫሻይ ኤንታዉ ግዶ። ባንታ አቁዋ ቦንቀትድ አላጋ ቢታን ድኤትዳ አስ ግዶ። <verse eid="NEH 4:4"/><verse number="5" style="v" sid="NEH 4:5"/>ኤንቲ ግምበይሳታ ጫሻን ካዉሽዳ ግሾ፥ ኤንታ ናቆይ ጌሞፎ፤ ኤንታ ናጋራ ነ ስንፈ ቁቾፋ” ያጋስ።<verse eid="NEH 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 4:6"/>ኑኒ ግምብያ ኦሱዋ ቃንፆና ኦዳ። አሳይ ኦሱዋ ምን ኦዳ ግሾ ግምብያ ኦሶይ ኤለስድ ባጋ ጋክስ።<verse eid="NEH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 4:7"/>ሳንባላፅ፥ ፆበይ፥ አራበ አሳይ፥ አሞነ አሳይነ አሽዶዳ አሳይ የሩሳላመ ግምበ ኦሶይ ሎኦ ኦሰትሸ ደኤይሳነ ዶያ በሳት ጎርደትዳይሳ ስእዳ ዎደ ዳሮ ይሎትዶሶና። <verse eid="NEH 4:7"/><verse number="8" style="v" sid="NEH 4:8"/>ሄሳ ግሾ ኤንቲ እስፈ የሩሳላመ ይድ ኑና ኦላናዉነ መቶ መናዉ ማቀትዶሶና። <verse eid="NEH 4:8"/><verse number="9" style="v" sid="NEH 4:9"/>ሽን ኑኒ ኑ ፆሳ ዎስዳ፤ ኤንታ ተቃናዉ ቃማነ ጋላስ ናገይሳታ ዎዳ።<verse eid="NEH 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 4:10"/>ሄ ዎደ ይሁዳ አሳይ፥ “ቶሆይ ኑና ዳቡርስስ፤ ቡሮ ደንዳናዉ ኮሽያ ዶረትዳ ዳሮ ሹች ደኤስ፤ ያንያ ግሾ፥ ኑኒ ግምብያ ግምባናዉ ዳንዳኦኮ” ያግዶሶና።<verse eid="NEH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 4:11"/>ኑ ሞርከት፥ “ኤንቲ ኑ ኦያባ ኤራናፐነ በአናፐ ስን ኑ ኤንታ ግዶ ገልድ ኤንታ ዎና፤ ኤንታ ኦሱዋካ ኤሳና” ያግዶሶና።<verse eid="NEH 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 4:12"/>ኑ ሞርከታ ሄራን ደእያ አይሁደት ታማ ስሚድ ኑ ሞርከት ኑና ኡባ ባጋራ ኦላናዉ ጊገቶይሳ ኑስ ኦድዶሶና።<verse eid="NEH 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 4:13"/>ሄሳ ግሾ፥ ኑ አሳፐ ማሸ፥ ቶራነ ዶንገ ኦይክዳ አሳ ኤንታ ሶ አሳን አሳን ጊግሳዳ ኦሶይ ዉርቦና ሄራን ግምብያስ ጉየራ ጋርሳ ባጋን ናጋና መላ ኦስ። <verse eid="NEH 4:13"/><verse number="14" style="v" sid="NEH 4:14"/>አሳይ ዳጋምዳይሳ ታኒ በእዳ ዎደ ደንዳ ኤቃዳ፥ አሳኮ፥ ኤንታ ካለይሳታኮነ ሀላቃታኮ፥ “ኑ ሞርከታ ያዮፍተ! ግታነ ያሽያ ፆሳ ቆፕተ። ህንተ እሻታስ፥ ህንተ አደ ናይታስነ ማጫ ናይታስ፥ ህንተ ማቸታስነ ህንተ ኬስ ኦለትተ” ያጋስ።<verse eid="NEH 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 4:15"/>ኑ ሞርከት ኑና ቆሀናዉ ማቀትዳይሳ ኑኒ ኤርዳይሳ ኤንቲ ስእዶሶና። ቃስ ፆሳይ ኤንታ ማቁዋ ሀዳ ከስዳይሳ አኬክዶሶና። ሄሳፈ ጉየ፥ ኑ ኡባይ ስሚድ፥ ግምበ ኦሱዋ ዶምዳ። <verse eid="NEH 4:15"/><verse number="16" style="v" sid="NEH 4:16"/>ሄ ዎደፐ ዶምድ ታ አሳፐ ባጋይ ኦሱዋ ኦያ ዎደ፥ ባጋይ ፁሩረ ማእድ፥ ቶራ፥ ጎንዳለነ ዶንገ ኦይክድ ናጋና መላ ኦስ። ቃስ ሀላቃት ይሁዳ አሳ ኡባፈ ጉየራ ኤቅድ ምንሶና፤ <verse eid="NEH 4:16"/><verse number="17" style="v" sid="NEH 4:17"/>ግምብያ ግምበይሳትነ ኮሽያባ ቶከይሳት እስ ኩሸን ኦላ ሚሸ ኦይክድ፥ እስ ኩሸን ኦሶ ኦሶና። <verse eid="NEH 4:17"/><verse number="18" style="v" sid="NEH 4:18"/>ግምብያ ኦያ እሶይ እሶይ ማሸ ባ ፄሳን ዳንጭድ ደኤስ። ሞይዘ ፑነይስ ኡባ ዎደ ታፐ ሻከትድ ኤረና።<verse eid="NEH 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 4:19"/>ካለይሳታኮ፥ ሀላቃታኮነ አሳ ኡባኮ፥ “ግምብያ ኦሶይ ግታነ ዳልጋ ግድያ ግሾ ኑኒ እሶይ እሱዋፈ ሃክድ ደኦስ። <verse eid="NEH 4:19"/><verse number="20" style="v" sid="NEH 4:20"/>ሄሳ ግሾ፥ ህንተ ሞይዘ ፑኖ ስእያ ዎደ ሄ በሳ ታኮ ሃ ሺቅተ። ኑ ፆሳይ ኑ ግሾ ኦለታና” ያጋስ። <verse eid="NEH 4:20"/><verse number="21" style="v" sid="NEH 4:21"/>ሄሳ ግሾ፥ ዎንታ ጎንተይ ዞኦ ዋያ ዎደፐ ዶምድ ኦማርስ ፆልንቶይ ከያና ጋካናዉ ባጋይ ኦያ ዎደ ባጋይ ቶራ ኦይክድ ናጌስ።<verse eid="NEH 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 4:22"/>ሄ ዎደ ታኒ አሳኮ፥ “ቃማ ኑና ናጋናዉነ ጋላስ ኦሱዋ ኦናዉ ህንተ ኡባይ ህንተና ማደይሳታራ የሩሳላመን አቅተ” ያጋስ። <verse eid="NEH 4:22"/><verse number="23" style="v" sid="NEH 4:23"/>ታና ግድን፥ ታ እሻታ ግድን፥ ታ አሳ ግድን፥ ዎይኮ ታና ናገይሳታ ግድን፥ ኑ ኡባይ ኑ ማኡዋ ከሶና አቆስ፤ ኑ ኦላ ሚሸይ ኑፐ ሻከተና።<verse eid="NEH 4:23"/></para>
  <chapter eid="NEH 4"/>
  <chapter number="5" style="c" sid="NEH 5"/>
  <para style="s1">ናህመይ ማንቆታ ማድስ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 5:1"/>እስ ዎደ አደትነ ኤንታ ማቸት ባንታ ኮቸ ግድዳ አይሁደታ ቦላ ዋስዶሶና። <verse eid="NEH 5:1"/><verse number="2" style="v" sid="NEH 5:2"/>ኤንታፈ እሶት እሶት፥ “ኑስ፥ ዳሮ አደ ናይትነ ማጫ ናይት ደእያ ግሾ ኑ ሸምፑዋ አሻናዉ ኑስ ካ ኮሼስ” ያግዶሶና።<verse eid="NEH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 5:3"/>ሀራት ቃስ፥ “ኑና ጋክዳ ኢታ ኮሻፐ ደንዶይሳን ካ ደማና ግድ፥ ኑ ጎሻ ጋድያ፥ ኑ ዎይነ ጋድያነ ኑ ኬ ኦይዳ” ያግዶሶና።<verse eid="NEH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 5:4"/>ቃስ አትዳይሳት፥ “ካዎ ጊራ ጊራናዉ ሚሸ ይድ ኑ ጎሻ ጋድያነ ኑ ዎይነ በሳ ኦይድ ሚሸ ታልእዳ። <verse eid="NEH 5:4"/><verse number="5" style="v" sid="NEH 5:5"/>አይሁደ ኮቻታራ ኑኒ እስ አሾነ እስ ሱ፤ ኑ ናይት ኤንታ ናይታ መላ። ሽን ኑኒ ኑ የልዳ ናይታ አይለተስ አድ እማናዉ ኡንኤትዳ፤ ኑ ማጫ ናይታፐ እሶት እሶት አይለተስ ባይዘትዶሶና። ኑ ጎሻነ ኑ ዎይነ ጋድያ ኑፐ ኤከትዳ ግሾ ኑ ዎልቃ ይዳ” ያግዶሶና።<verse eid="NEH 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 5:6"/>ታኒ ኤንታ ዋሱዋነ ኦይሻ ስእዳ ዎደ ዳሮ ይሎታስ። <verse eid="NEH 5:6"/><verse number="7" style="v" sid="NEH 5:7"/>ታ ዎዛናን ኦናባ ቆፕዳፐ ጉየ፥ ካለይሳታነ ሀላቃታ ፄጋዳ፥ “ህንተ፥ ህንተ እሻታስ የሎራ ታልእሸ ኡንኤታ” ያጋዳ ኤንታ ካጫስ።</para>
  <para style="p" vid="NEH 5:7">ሄ መቱዋባ ኤንታራ ኦደታናዉ ደርያ ሺሻዳ፥ <verse eid="NEH 5:7"/><verse number="8" style="v" sid="NEH 5:8"/>“አይሁደ ግዶናይሳታስ ባይዘትዳ አይሁደ ኮቸ ግድዳ ኑ እሻታ ዎዛናዉ ኑስ ዳንዳኤትዳባ ኡባ ኦዳ። ሽን ህንተ እሻ ግድዳ አይሁደት ባንታ ኮቸ ግድዳ ህንተዉ፥ ባንታና ባይዛና መላ ኦታ፤ ኑ ኤንታ ዛር ዎዛናዉ ኮሼስ” ያጋስ። ካለይሳት ዛራናባ ይድ ስእ ግዶሶና።<verse eid="NEH 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 5:9"/>ታኒ ካላዳ፥ “ህንተ ኦያባይ ዎጋ ግደና፤ አይሁደ ግዶና ኑ ሞርከት ኑና ቀልቅሶና መላ ህንተ ኑ ፆሳስ ያያናዉነ ሱረባ ኦናዉ በሰኔ? <verse eid="NEH 5:9"/><verse number="10" style="v" sid="NEH 5:10"/>ታኒ፥ ታ እሻትነ ታ ኦሳንቾት አሳስ ሚሸነ ካ ታልእዳ፤ ግዶሽን፥ ኤንታፈ የሎ ኤከይስ አቶ። <verse eid="NEH 5:10"/><verse number="11" style="v" sid="NEH 5:11"/>ኤንታ ጎሻ፥ ዎይነነ ሻማሆ ዛይተ ጋድያነ ኬ ኡባ ኤንታዉ ዛርተ። ቃስ ሚሸፐ፥ ካፈ፥ ዎይነፐነ ዛይተፐ ህንተ ኤንታፈ ኤክዳ ፄታፐ እስ ኩሸ የሎ ኤክዳይሳ ኤለ ዛርተ” ያጋስ።<verse eid="NEH 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 5:12"/>ኤንቲ ዛሪድ፥ “ኑኒ ኤክዳባ ኡባ ኤንታዉ ጉየ ዛራና፤ ኤንቲ ኑፐ ታልእዳይሳ ዛሮ ግድ አቾኮ፤ ነ ኑና ኪትዳይሳዳ ኦና” ያግዶሶና።</para>
  <para style="p" vid="NEH 5:12">ታኒ ካህነታ ታኮ ፄጋዳ ካለይሳት ባንታ ግዳ ቃላ ፖላና መላ ጫቅሳናዳ ኦስ። <verse eid="NEH 5:12"/><verse number="13" style="v" sid="NEH 5:13"/>ታኒ ታ ማኡዋ ቃራዳ ቆቆፋሸ፥ “ህንተፈ ኦንካ ባ ግዳ ቃላ ፖሎና እፅኮ፥ ፆሳይ እያ፥ እያ ኬፈነ እያ አቁዋፐ ሀይሳዳ ቆቆፍድ መላ ኩሸ አሾ” ያጋስ።</para>
  <para style="p" vid="NEH 5:13">ሺቅዳ አሳ ኡባይ እስ ቃላን፥ “አምንእ” ያግድ ጎዳ ጋላትዶሶና። አሳ ኡባይ ጫቅዳይሳዳ ኦዶሶና።<verse eid="NEH 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 5:14"/>አርፀክስስ ካዎትዳ ላታማን ላይፈ ዶምድ ሀስታማነ ናምአን ላይ ጋካናዉ ታኒ ይሁዳ ቢታ ሃራስ። ሄ ታማነ ናምኡ ላይ ግዶን ታና ግድን ዎይኮ ታ እሻት ሹማስ በሲያ ካ ዳሞዘ ኤክቦኮ። <verse eid="NEH 5:14"/><verse number="15" style="v" sid="NEH 5:15"/>ሽን ታፐ ካሰ ሹመትዳይሳት አሳስ ዴፆ ቶሆ ግድድ፥ ጋላስ ጋላስ ካስነ ዎይነ ኡሻስ ኦይታሙ ብራ ቃንፅስዶሶና። ሀር አቶሽን ሹማታ አይለት አሳ ቦላ ጎዳ ግድድ ኡንኤድ ጋምእዶሶና። ሽን ታኒ ፆሳስ ያይዳ ግሾ፥ ሄሳዳ ኦብከ። <verse eid="NEH 5:15"/><verse number="16" style="v" sid="NEH 5:16"/>ታዉ ደእያ ዎልቃ ኡባ የሩሳላመ ግምበ ኦሱዋስ እማስ፤ ታ ኦሳንቾትካ ታራ እስፈ ሄ ኦሱዋ ቦላ ጋምእዶሶና፤ ኑ አይብ ቢታካ ሻምቦኮ። <verse eid="NEH 5:16"/><verse number="17" style="v" sid="NEH 5:17"/>ኑ ሄራን ደእያ ካዎተታፐ ይዳ አሳይ አትሽን፥ ጋላስ ጋላስ ታራ ምያ አይሁደትነ ካለይሳት ፄታነ እሻታማ። <verse eid="NEH 5:17"/><verse number="18" style="v" sid="NEH 5:18"/>ጋላስ ጋላስ እስ ቦር፥ ኡሱፑን ሞ ዶርሳታነ ዳሮ ኩቶታ ሹክድ አሳስ ሺሾሶና፤ ቃስ ታሙ ጋላሳፐ እስ ቶሆ ዳሮ ባ ዎይነ ኡሻ አጎሶና። ሽን አሳ ቦላ ደእያ ዴፆ ቶሁዋ ታ ኤርያ ግሾ ቢታ ሹማስ በሲያ ካ ዳሞዘ ኦይቻብከ።<verse eid="NEH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 5:19"/>ታ ፆሳዉ፥ ታ ሀ አሳስ ኦዳ ኬሀተ ኡባ ቆፓዳ ታዉ ኬሀ።<verse eid="NEH 5:19"/></para>
  <chapter eid="NEH 5"/>
  <chapter number="6" style="c" sid="NEH 6"/>
  <para style="s1">ናህመ ቦላ መትዳ እፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 6:1"/>ሳንባላፅ፥ ፆበይ፥ አራበ ቢታ አስ ግድዳ ጌሳመይነ ሀንኮ ኑ ሞርከት ኑኒ ግምብያ ኦድ ፖልዳይሳነ ዶያ በሲ ባይናይሳ ስእዶሶና። ግዶሽን፥ ታ ግምበ ፐንገታስ ሳንቃ አብከ። <verse eid="NEH 6:1"/><verse number="2" style="v" sid="NEH 6:2"/>ሳንባላፅነ ጌሳመይ፥ “ኦኖ ደምባን ደእያ ጉታታፐ እሱዋን ያዳ ኑራ ጋሄታ” ያግድ ኪታ የድዶሶና። ሄስ ኤንቲ ታና ቆሀናዉ ማቅዳ ማቆ።<verse eid="NEH 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 6:3"/>ታኒ ኤንታዉ፥ “ታዉ ግታ ኦሶይ ደእያ ግሾ ሄሳ አጋዳ ህንተ ግዳ በሳ ባናዉ ዳንዳእከ። ታኒ ያ ብን፥ ኦሶይ አይስ በቲ?” ያጋዳ ዛራስ። <verse eid="NEH 6:3"/><verse number="4" style="v" sid="NEH 6:4"/>ሄ ኪታ ዛር ዛር ኦይዱ ቶሆ ኪትዶሶና፤ ሽን ታኒ እስ ቆሞ ዛሮ ኤንታዉ እማስ።<verse eid="NEH 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 6:5"/>እቻሻን ሳንባላፅ ባ አይለታፐ እሱዋ ዶያ ደእያ ዳብዳበ ኦይድ ታኮ ኪትስ። ዳብዳበይ ሀይሳዳ ያግድ ፃፈትስ፤ <verse eid="NEH 6:5"/><verse number="6" style="v" sid="NEH 6:6"/>“ኔንነ ነ ኮቸ ግድዳ አይሁደት ማካላናዉ ቆፕዳይሳነ ሄሳ ጋሶን ግምብያ ግምበይሳ ሾሮ ቢታን ደእያ አሳ ኡባይ ኦደተይሳ ጌሳመይ ታዉ ኦድስ። ቃስ ኔኒ ነና ካዎ ከሳናዉ ኮየይሳነ <verse eid="NEH 6:6"/><verse number="7" style="v" sid="NEH 6:7"/>ኔኒ ይሁዳ ካዎ ግደይሳ የሩሳላመን አዋጃና መላ ናበ ዎዳይሳ ታዉ ኦድስ። ሀ ዎርያ ካዎይ ስአናይስ አተና። ሄሳ ግሾ፥ ታራ ጋሄታዳ ዞረታናዉ ሃያ” ያጌስ።<verse eid="NEH 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 6:8"/>ታኒ፥ “ሀ ኔኒ ግያ ኦዳ ኡባይ ቱማ ግዶናባነ ነ ኔፐ መዳባ” ያጋዳ ዛራስ።<verse eid="NEH 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 6:9"/>ኑ ኦያ ኦሶይ ፖለቶና መላ፥ “ኤንታ ኩሸይ አርጋጫና፤ ኦሶይካ ፖለቶና ኤቅ አታና” ያግድ ኑና ያሽሳናዉ ቆፕዶሶና።</para>
  <para style="p" vid="NEH 6:9">ሽን ታኒ፥ “ፆሳዉ፥ ሀእ ታ ኩሽያ ምን” ያጋዳ ዎሳስ።<verse eid="NEH 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 6:10"/>ታኒ እስ ጋላስ ሶፐ ከዮና መላ ጎርድ ዎዳ ማሄፃቤላ ናኣ ናኣ ዳላያ ናኣ ሻማያኮ ባስ። እ ታኮ፥ “ቃማ ይድ ኤንቲ ነና ዎናዉ ዳንዳእያ ግሾ ኔራ ታራ ፆሳ ኬ ገልድ፥ ፐንግያ ጎርድድ ቆሰታና” ያግስ።<verse eid="NEH 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 6:11"/>ሽን ታኒ፥ “ታ መላ አስ ያይድ ቆሰቲ? ዎይኮ ታና ዳንያ አስ ባ ሸምፑዋ አሻናዉ ፆሳ ኬ ገሊ? ታ ሄሳ ሀንከ” ያጋስ። <verse eid="NEH 6:11"/><verse number="12" style="v" sid="NEH 6:12"/>ታ ቆፓ በእያ ዎደ ሻማየይ ፆሳይ ኪትዳ ናበ ግዶናሽን ፆበይነ ሳንባላፅ እያ ሚሸን ሻምድ የድን ታ ቦላ ዎርዶ ትንብተ ኦደይሳ አኬካስ። <verse eid="NEH 6:12"/><verse number="13" style="v" sid="NEH 6:13"/>እ ሚሸን ሻመትዳ ጋሶይ ታና ያሽሳናሳ፤ ታ ሄሳ ኦዳ ናጋራን ገላና መላነ ታና ቦርስያባ ደምድ ታና ካዉሻናሳ።<verse eid="NEH 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 6:14"/>ታኒ፥ “ታ ፆሳዉ፥ ፆበይነ ሳንባላፅ ኦዳባ ኡባ በአ። ኖኣዶ ጌተትያ ማጫ ናብያነ ሀራ ዎርዶ ናበት ታና ያሽሳናዉ ኦዳባ ኡባ በአ” ያጋዳ ዎሳስ።<verse eid="NEH 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 6:15"/>ግምበ ኦሶይ ዶመትን እሻታማነ ናምኡ ጋላሳፐ ጉየ ኤሉለ ጌተትያ አጌናን ላታማነ እቻሻን ጋላሳን ኦሶይ ፖለትስ። <verse eid="NEH 6:15"/><verse number="16" style="v" sid="NEH 6:16"/>ኑ ዩሹዋን ደእያ ካዎተታን ደእያ ኑ ሞርከት ሄሳ ስእዳ ዎደ ያይዶሶናነ ዬላትዶሶና። አይስ ጊኮ፥ ኦሶይ ኑ ፆሳ ማደን ፖለትዳይሳ አኬክዶሶና።<verse eid="NEH 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 6:17"/>ሄ ዎደ ይሁዳ ሹማት ፆቢያስ ዳብዳበ ፃፍሸ ጋምእዶሶና፤ እካ ኤንታዉ ዛርሸ ጋምእስ። <verse eid="NEH 6:17"/><verse number="18" style="v" sid="NEH 6:18"/>ኤራ ናአይ ሳካን፥ ፆቢያ ቦሎ ግድያ ግሾነ እያ ናአይ ዮሃናን ባራካ ናኣ ማሱላማ ናእዉ ኤክዳ ግሾ፥ አይሁደታፐ ዳሮት እያራ ጫቅድ ደኦሶና። <verse eid="NEH 6:18"/><verse number="19" style="v" sid="NEH 6:19"/>ሄ አሳት ፆበይ ኦዳ ሎኦባ ኡባ ታ ስንን ናሽድ ሃሳዮሶና፤ ታኒ ግያባ እያዉ ኦዶሶና። ሄሳ ግሾ፥ ፆበይ ኡባ ዎደ ታና ያሽሳናዉ ዳብዳበ ፃፎ አግቤና።<verse eid="NEH 6:19"/></para>
  <chapter eid="NEH 6"/>
  <chapter number="7" style="c" sid="NEH 7"/>
  <para style="p">
    <verse number="1" style="v" sid="NEH 7:1"/>ግምብያ ኦሶይ ዉርን፥ ሳንቃይካ ገልስ፤ ፐንግያ ናገይሳት፥ ዛማረትነ ሌወት ባንታ ኦሱዋ ኦይክዶሶና። <verse eid="NEH 7:1"/><verse number="2" style="v" sid="NEH 7:2"/>ታኒ የሩሳላመ ካታማ አይስያ ማታ ታ እሻ ሀናነስነ ሚፃ ናገይሳታ ሀላቃ አናናስ እማስ። ሀናን ሀራታፐ አዳ ቱማንቾነ ፆሰ ያይያ አስ። <verse eid="NEH 7:2"/><verse number="3" style="v" sid="NEH 7:3"/>ታኒ ኤንታኮ፥ “ዎንታ አዋይ ከይድ ሆአና ጋካናዉ የሩሳላመ ግምበ ፐንገታ ዶዮፕተ። ቃስ ኦማርስ ናገይሳት ባንታ ኦሱዋ ኦንግድ ባናፐ ስን ፐንገታ ምን ጎርዳናዳ ኦተ። ሄሳዳካ፥ የሩሳላመን ደእያ አሳፐ ዶርድ ባጋት ባንታ ኦሶ በሳን፥ ሀራት ቃስ ባንታ ኬ ሄራን ናጋና መላ ኦተ” ያጋስ።<verse eid="NEH 7:3"/></para>
  <para style="s1">ድኦፐ ስምዳ አሳ ሱን</para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 7:4"/>ሄ ዎደ የሩሳላመ ካታማይ ዳሮ ዳልጋነ ግታ፤ ሽን እያ ግዶን ደእያ አሳ ታይቦይ ዳሮ ጉ፤ ቃስ ዳሮ ኬት ቡሮ ኬፀትቤና። <verse eid="NEH 7:4"/><verse number="5" style="v" sid="NEH 7:5"/>ሄሳፈ ጉየ፥ አሳ ካለይሳታ፥ ሀላቃታነ አሳ ኡባ ሺሻዳ ኤንታ ሶ አሳን አሳን ማዝጋባና መላ ፆሳይ ታና ቆፍስስ። ድኤተፈ ስን ስምዳ አሳ ኤንታ ሶ አሳን አሳን ፃፈትዳ ማፃፋካ ደማስ፤ ሄ ማፃፋን ፃፈትዳይ ሀይሳ።<verse eid="NEH 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 7:6"/>ባብሎነ ካዎይ ናቡካዳናፆር ድእድ፥ ባ ቢታ ኤፍዳ አሳፐ ጉየ ባንታ ካታማ የሩሳላመነ ይሁዳን ደእያ ባንታ ካታማታ ስምዳ አሳይ ሀይሳፈ ካልድ ደኤይሳታ። <verse eid="NEH 7:6"/><verse number="7" style="v" sid="NEH 7:7"/>ኤንታ ሀላቃት ዛሩባበላ፥ እያሱ፥ ናህመ፥ አዛራ፥ ራማ፥ ናሀማነ፥ ማርድክዮሳ፥ ብልሻና፥ ምስፐረታ፥ ብግዋያ፥ ናሁማነ ባና።</para>
  <para style="p" vid="NEH 7:7">ድኦፐ ስምዳ እስራኤለ አሳ ታይቦይ ሀይሳ፤<verse eid="NEH 7:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NEH 7:8"/>ፓሮሳ ያራት 2,172፤<verse eid="NEH 7:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NEH 7:9"/>ሳፋፃ ያራት 372፤<verse eid="NEH 7:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NEH 7:10"/>ኤራ ያራት 652፤<verse eid="NEH 7:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NEH 7:11"/>እያሱነ እዮኣባ ኮቸ ግድዳ ፓሀት-ሞአባ ያራት 2,818፤<verse eid="NEH 7:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NEH 7:12"/>ኤላማ ያራት 1,254፤<verse eid="NEH 7:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NEH 7:13"/>ዛቱ ያራት 845፤<verse eid="NEH 7:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NEH 7:14"/>ዛካያ ያራት 760፤<verse eid="NEH 7:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NEH 7:15"/>ብኑያ ያራት 648፤<verse eid="NEH 7:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="NEH 7:16"/>በባያ ያራት 628፤<verse eid="NEH 7:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="NEH 7:17"/>አዝጋዳ ያራት 2,322፤<verse eid="NEH 7:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="NEH 7:18"/>አዶንቃማ ያራት 667፤<verse eid="NEH 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="NEH 7:19"/>ብግዋያ ያራት 2,067<verse eid="NEH 7:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NEH 7:20"/>አድና ያራት 655፤<verse eid="NEH 7:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="NEH 7:21"/>ህዝቅያሳ ያራ ግድዳ አፄራ ያራት 98፤<verse eid="NEH 7:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NEH 7:22"/>ሀሹማ ያራት 328፤<verse eid="NEH 7:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NEH 7:23"/>በሳያ ያራት 324፤<verse eid="NEH 7:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NEH 7:24"/>ሀርፋ ያራት 112፤<verse eid="NEH 7:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NEH 7:25"/>ጋባኦና ያራት 95፤<verse eid="NEH 7:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="NEH 7:26"/>ቤተለመንነ ናፆፋን ደእያ አሳይ 188፤<verse eid="NEH 7:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NEH 7:27"/>አናቶታ ካታማ አሳይ 128፤<verse eid="NEH 7:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NEH 7:28"/>ቤት-አዝሞታን ደእያ አሳይ 42፤<verse eid="NEH 7:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NEH 7:29"/>ቅርያት-አርማን፥ ካፍራንነ ባኤሮታን ደእያ አሳይ 743፤<verse eid="NEH 7:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="NEH 7:30"/>ራማነ ግብአን ደእያ አሳይ 621፤<verse eid="NEH 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="NEH 7:31"/>ምክማሳን ደእያ አሳይ 122፤<verse eid="NEH 7:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="NEH 7:32"/>ቤተለንነ ጋየን ደእያ አሳይ 123፤<verse eid="NEH 7:32"/></para>
  <para style="m">
    <verse number="33" style="v" sid="NEH 7:33"/>ናምአን ናቦን ደእያ አሳይ 52፤<verse eid="NEH 7:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NEH 7:34"/>ናምአን ኤላማ ያራት 1,254፤<verse eid="NEH 7:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="NEH 7:35"/>ሀርማን ደእያ አሳይ 320፤<verse eid="NEH 7:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="NEH 7:36"/>እያርኮን ደእያ አሳይ 345፤<verse eid="NEH 7:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="NEH 7:37"/>ሎዳን፥ ሀድዳንነ ኦኖን ደእያ አሳይ 721፤<verse eid="NEH 7:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="NEH 7:38"/>ሳናአን ደእያ አሳይ 3,930።<verse eid="NEH 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NEH 7:39"/>ሀይሳፈ ካልድ ደኤይሳት ድኤተፈ ስምዳ ካህነታ።</para>
  <para style="p" vid="NEH 7:39">እያሱ ያራ ግድዳ ያዳያ ያራት 973፤<verse eid="NEH 7:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="NEH 7:40"/>እመራ ያራት 1,052፤<verse eid="NEH 7:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="NEH 7:41"/>ፓስኮራ ያራት 1,247፤<verse eid="NEH 7:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="NEH 7:42"/>ሀርማ ያራት 1,017.<verse eid="NEH 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="NEH 7:43"/>ሀይሳፈ ካልድ ደኤይሳት ድኤተፈ ስምዳ ሌወታ፤</para>
  <para style="li1" vid="NEH 7:43">ሆዳዋ ያራ ግድያ እያሱነ ቃድምኤላ ያራት 74፤<verse eid="NEH 7:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="NEH 7:44"/>አሳፋ ያራ ግድዳ ዛማረት 148።<verse eid="NEH 7:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="NEH 7:45"/>ፐንግያ ናግያ</para>
  <para style="q2" vid="NEH 7:45">ሳሉማ፥ አፄራ፥ ታልሞና፥ አቁባ፥ ሀትታነ ሾባያ ያራት 138፤<verse eid="NEH 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NEH 7:46"/>ሀይሳፈ ካልድ ደኤይሳት ፆሳ ኬን ኦያ ኦሳንቾታ ያራታ፤</para>
  <para style="m" vid="NEH 7:46">ፅሀ ያራታ፥ ሀሱፋ ያራታ፥ ፃባኦታ ያራታ፥ <verse eid="NEH 7:46"/><verse number="47" style="v" sid="NEH 7:47"/>ከሮሳ ያራታ፥ ሲአ ያራታ፥ ፓዶና ያራታ፥ <verse eid="NEH 7:47"/><verse number="48" style="v" sid="NEH 7:48"/>ልባና ያራታ፥ ሀጋባ ያራታ፥ ሳማላ ያራታ፥ <verse eid="NEH 7:48"/><verse number="49" style="v" sid="NEH 7:49"/>ሀናና ያራታ፥ ግደላ ያራታ፥ ጋሃራ ያራታ፥ <verse eid="NEH 7:49"/><verse number="50" style="v" sid="NEH 7:50"/>ራያ ያራታ፥ ራፅና ያራታ፥ ናቆዳ ያራታ፥ <verse eid="NEH 7:50"/><verse number="51" style="v" sid="NEH 7:51"/>ጋዛማ ያራታ፥ ኦዛ ያራታ፥ ፓሳ ያራታ፥ <verse eid="NEH 7:51"/><verse number="52" style="v" sid="NEH 7:52"/>በሳያ ያራታ፥ ማኡንማ ያራታ፥ ናፉሰስማ ያራታ፥ <verse eid="NEH 7:52"/><verse number="53" style="v" sid="NEH 7:53"/>ባቅቡቃ ያራታ፥ ሀቁፋ ያራታ፥ ሀርሁራ ያራታ፥ <verse eid="NEH 7:53"/><verse number="54" style="v" sid="NEH 7:54"/>ባስሎታ ያራታ፥ ማህዳ ያራታ፥ ሀርሻ ያራታ፥ <verse eid="NEH 7:54"/><verse number="55" style="v" sid="NEH 7:55"/>ባርቆሳ ያራታ፥ ስሳራ ያራታ፥ ቴማ ያራታ፥ <verse eid="NEH 7:55"/><verse number="56" style="v" sid="NEH 7:56"/>ናስያ ያራታነ ሀፅፋ ያራታ።<verse eid="NEH 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="NEH 7:57"/>ሀይሳፈ ካልድ ደኤይሳት ሶሎሞነ አይለታ ያራታ፤</para>
  <para style="m" vid="NEH 7:57">ሶፃያ ያራታ፥ ሶፌረታ ያራታ፥ ፓርዳ ያራታ፥ <verse eid="NEH 7:57"/><verse number="58" style="v" sid="NEH 7:58"/>ያእላ ያራታ፥ ዳርቆና ያራታ፥ ግደላ ያራታ፥ <verse eid="NEH 7:58"/><verse number="59" style="v" sid="NEH 7:59"/>ሳፋፃ ያራታ፥ ሀፅላ ያራታ፥ ፖከሬት-ሀፃባይማ ያራታነ አሞነ ያራታ።<verse eid="NEH 7:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="NEH 7:60"/>ድኤተፈ ስምዳ ፆሳ ኬን ኦይሳትነ ሶሎሞነ አይለታ ታይቦይ 392.<verse eid="NEH 7:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="NEH 7:61"/>ታልመላ፥ ተልሀርሻ፥ ካሩባ፥ አዳናነ እመራ ካታማታፐ የሩሳላመ ስምዶሶና። ሽን ኤንቲ ዎይኮ ኤንታ አዋት እስራኤለ ሼሽ ግደይሳ ኤርሳናዉ ዳንዳእቦኮና። <verse eid="NEH 7:61"/><verse number="62" style="v" sid="NEH 7:62"/>ኤንቲ ዳላያ፥ ፆቢያነ ናቆዳ ያራታ፤ ኤንታ ታይቦይ 642.<verse eid="NEH 7:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="NEH 7:63"/>ካህነታፐ ሆባያ ያራት፥ ሀቆፃ ያራትነ ባርዝለ ያራት የሩሳላመ ስምዶሶና። ባርዝለ ገይስ ጋላዳ ቢታ አስ ግድዳ ባርዝለ ናእዉ ኤክድ፥ ባ ቦሉዋ ሱን ኤክስ። <verse eid="NEH 7:63"/><verse number="64" style="v" sid="NEH 7:64"/>ኤንቲ ባንታ የለታ ሱሳ ኤራናዉ የለታ ማፃፋን ኮይዶሶና፥ ሽን ደምቦኮና። ሄሳ ግሾ፥ ኤንቲ ቱናዳ ታይበትድ ካህነተን ኦና መላ ድገትዶሶና። <verse eid="NEH 7:64"/><verse number="65" style="v" sid="NEH 7:65"/>ኡሪመንነ ቱሚመን ሻክድ ፕርድያ ካህነይ ደንዳና ጋካናዉ ኤንቲ ጌሻ ካፈ ማናዉ ዳንዳኦናይሳ ይሁዳ ሃረይስ ኤንታዉ ኦድስ።<verse eid="NEH 7:65"/></para>
  <para style="p">
    <verse number="66-67" style="v" sid="NEH 7:66-67"/>ድኤተፈ ይሁዳ ቢታ ስምዳ 7,337 አደነ ማጫ አይለታ ጉጆና ደእሽን፥ ኩመ አሳ ታይቦይ 42,360. ቃስ ኤንታራ 245 አደነ ማጫ ዛማረት ስምዶሶና። <verse eid="NEH 7:66-67"/><verse number="68" style="v" sid="NEH 7:68"/>ፓራታ ታይቦይ 736፤ ባቁሎታ ታይቦይ 245፤ <verse eid="NEH 7:68"/><verse number="69" style="v" sid="NEH 7:69"/>ግማለታ ታይቦይ 435፤ ሀረታ ታይቦይ 6,720.<verse eid="NEH 7:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="NEH 7:70"/>ያራታ ሀላቃታፐ ጉት ኦሱዋስ እሞታ እምዶሶና። ቢታ ሃረይስ 8 ክሎ ግራመ ዎርቃ፥ 50 ድስተነ 530 ካህነ ማኦታ እሚስ። <verse eid="NEH 7:70"/><verse number="71" style="v" sid="NEH 7:71"/>ያራታ ሀላቃት 168 ክሎ ግራመ ዎርቃነ 1,250 ክሎ ግራመ ብራ እምዶሶና። <verse eid="NEH 7:71"/><verse number="72" style="v" sid="NEH 7:72"/>አትዳ አሳይ 168 ክሎ ግራመ ዎርቃ፥ 140 ክሎ ግራመ ብራነ 67 ካህነ ማኦታ እምዶሶና።<verse eid="NEH 7:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="NEH 7:73"/>ሄሳፈ ጉየ ካህነት፥ ሌወት፥ ናገይሳት፥ ዛማረት፥ አሳፐ እሶት እሶት፥ ፆሳ ኬ ኦሳንቾትነ ሀራ እስራኤለ አሳይ ባንታ ካታማን ካታማን ኡትዶሶና።<verse eid="NEH 7:73"/></para>
  <chapter eid="NEH 7"/>
  <chapter number="8" style="c" sid="NEH 8"/>
  <para style="s1">እዝር ህገ ማፃፋ ናባብስ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 8:1"/>ላፑን አጌናይ ገልያ ዎደ እስራኤለ አሳይ ባንታ ካታማን ካታማን ኡትዶሶና። ሄ አጌናን ኤንቲ ኡባይ እስፈ ሃ ፐንገ ስንን ደእያ ዳባባን ሺቅዶሶና። ኤንቲ ጎዳይ ሙሰ ባጋራ እስራኤለ አሳስ እምዳ ህገ ማፃፋ ኤሀና መላ ፃፍያ እዝራ ኦይችዶሶና። <verse eid="NEH 8:1"/><verse number="2" style="v" sid="NEH 8:2"/>ያትን፥ ካህነይ እዝር፥ ላፑን አጌናን ኮይሮ ጋላሳን፥ አደይ፥ ማጭነ አኬካናዉ ዳንዳእያ አስ ኡባይ ሺቅዳ በሳ ህገ ማፃፋ ኤህስ። <verse eid="NEH 8:2"/><verse number="3" style="v" sid="NEH 8:3"/>ሃ ፐንገ ስንን ደእያ ዳባባን ኤቅድ፥ አደስ፥ ማጫስነ አኬካናዉ ዳንዳእያ አሰ ኡባስ ህገ ማፃፋ ዎንታፈ ጋላስ ጋካናዉ ናባብስ። አሳይካ ሀይዝድ ስእዶሶና።<verse eid="NEH 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 8:4"/>ፃፈይ እዝር፥ ናባባናዉ ምፈ ኦሰትዳ ቃ በሳን ከይድ ኤቅስ። እያፐ ኡሻቻ ባጋራ ማትታ፥ ሻማያ፥ አናያ፥ ኡራያ፥ ካልቀነ ማእሰያ ጌተትያ አሳት ኤቅዶሶና። ሀድርሳ ባጋራ ፓዳያ፥ ምሳኤላ፥ ማልክያ፥ ሀሱማ፥ ሀሽባዳ፥ ዛካርያሳነ ማሱላማ ጌተትያ አሳት ኤቅዶሶና።<verse eid="NEH 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 8:5"/>እዝር አሳ ኡባፈ ቅያ በሳን ኤቅያ ዎደ ኡባይ እያ ሎይድ ፄልሽን፥ ኤንታ ስንን ህገ ማፃፋ ዶይስ። እ ዶይያ ዎደ ኤንቲ ኡባይ ኡትዳ በሳፈ ደንድ ኤቅዶሶና። <verse eid="NEH 8:5"/><verse number="6" style="v" sid="NEH 8:6"/>እዝር ጎዳ፥ ግታ ፆሳ ጋላትስ። አሳ ኡባይ ባንታ ኩሽያ ደንድ፥ “አምንእ! አምንእ!” ያግዶሶና። ኤንታ ሶምኦይ ሳአ ቦቻና ጋካናዉ ጉፋንድ ጎዳ ጎይንዶሶና።<verse eid="NEH 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 8:7"/>ኤንቲ ባንታ ኤቅዳ በሳን ደእሽን፥ ሌወት፥ እያሱይ፥ ባን፥ ሳራባ፥ ያምና፥ አቁባ፥ ሳባታ፥ ሆዳ፥ ማሰያ፥ ቃልፃ፥ አዛራ፥ ዮዛባታ፥ ሀናንነ ፓላህ ህግያ አሳይ አኬካናዳ ብርሸ ቆንጭስዶሶና። <verse eid="NEH 8:7"/><verse number="8" style="v" sid="NEH 8:8"/>ኤንቲ ፆሳ ህገ ማፃፋ ናባብዶሶና፤ ቃስ ናባበተይስ ዎይግያኮ አሳይ ኤራና መላ ብርሸ ቆንጭስዶሶና።<verse eid="NEH 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 8:9"/>አሳይ ህገ ቃላ ስእዳ ዎደ ዬክዳ ግሾ፥ ቢታ ሃርያ ናህመይ፥ ካህነነ ፃፈ ግድዳ እዝርነ አሳስ ማፃፋ ብርሽያ ሌወት፥ “ሀ ጋላሳይ ጎዳስ፥ ህንተ ፆሳስ ጌሻ ጋላስ ግድያ ግሾ፥ ዬኮፍተ ዎይኮ አፉፆፍተ” ያግዶሶና።<verse eid="NEH 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 8:10"/>ናህመይ፥ “ብድ ዶረትዳ ካ ሚተ፤ ማልእያ ኡሽ ኡይተ፤ ቃስ አይኮይ ባይናይሳታስ ህንተይሳፈ ሻክድ እምተ። ሀች ጋላሳይ ኑ ጎዳስ ጌሻ ጋላስ። ጎዳ ኡፋይሳይ ህንተዉ ዎልቃ ግድያ ግሾ አዛኖፕተ” ያግስ።<verse eid="NEH 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 8:11"/>ሌወት፥ “ሀች ጋላሳይ ጌሻ ጋላስ ግድያ ግሾ፥ አዛኖፕተ፤ ስእ ጊተ” ያግድ አሳ ስእ ኦዶሶና። <verse eid="NEH 8:11"/><verse number="12" style="v" sid="NEH 8:12"/>ናበበትዳ ቃላ ብርሸይ ኤንታዉ ገልዳ ግሾ፥ አሳይ ኡፋይሳን ማናዉ፥ ኡያናዉነ አይኮይ ባይናይሳታስ ሻክድ እማናዉ ሶ ብዶሶና።<verse eid="NEH 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 8:13"/>ሄ አጌና ናምአን ጋላሳን ኮቻታ ሀላቃት፥ ካህነትነ ሌወት ህገ ቃላ ኤንታዉ ብርሻና መላ እዝራኮ ይዶሶና። <verse eid="NEH 8:13"/><verse number="14" style="v" sid="NEH 8:14"/>ኤንቲ ታማርያ ዎደ ላፑን አጌናን ሻቃራ ባኣለ ቦንችያ ዎደ እስራኤለ አሳይ ሻቃራ ጋርሳን ኡትድ ቦንቻና መላ ፆሳይ ሙሰ ባጋራ ኪትዳይሳ ደምዶሶና። <verse eid="NEH 8:14"/><verse number="15" style="v" sid="NEH 8:15"/>ሻቃራ ባኣለ ቦንቻናዉ ካታማታንነ የሩሳላመን ሀይሳዳ ያግድ አዋጅዶሶና፤ “ሻቃራ ሻቃራናዉ ደረ ቦላ ከይድ ዛይተ ሻማሆ፥ ዎራ ሻማሆ፥ ባርሰኔተ ም፥ ዛምባ ሀይነ ም ኡባፈ ህገን ፃፈትዳይሳዳ ታሸ ኤህተ” ያግዶሶና።<verse eid="NEH 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 8:16"/>ሄሳ ግሾ፥ አሳይ ብድ ም ታሸ ኤህድ ባንታ ፖቀ ኬ ቦላ ደእያ ደንባን፥ ባንታ ዛባን፥ ፆሳ ኬ ዳባባን፥ ሃ ፐንግያ ዳባባንነ ኤፍሬማ ፐንግያ ዳባባን ሻቃራ ሻቃርዶሶና። <verse eid="NEH 8:16"/><verse number="17" style="v" sid="NEH 8:17"/>ድኤተፈ ስምዳ አሳ ኡባይ ሻቃራ ሻቃርድ እያ ጋርሳን ኡትዶሶና። ናወ ናኣ እያሱ ዎደፐ ሃ ስምን ኤንቲ ሀይሳ መላ ባኣለ ቦንች ኤሮኮና። ሄሳ ግሾ፥ ኤንቲ ኡባይ ዳሮ ኡፋይትዶሶና። <verse eid="NEH 8:17"/><verse number="18" style="v" sid="NEH 8:18"/>ባለይ ዶመትድ ዉራና ጋካናዉ ጋላስ ጋላስ እዝር ፆሳ ህገ ማፃፋፐ አሳስ ናባቤስ። ባልያ ላፑን ጋላስ ቦንችዳፐ ጉየ ሆስፑን ጋላሳን ህገይ ኪተይሳዳ ጌሻ ዱላታ ኦዶሶና።<verse eid="NEH 8:18"/></para>
  <chapter eid="NEH 8"/>
  <chapter number="9" style="c" sid="NEH 9"/>
  <para style="s1">አሳይ ባንታ ናጋራ ፓፅዶሶና</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 9:1"/>ሄ አጌናን ላታማነ ኦይዳን ጋላሳን እስራኤለ አሳይ እስፈ ሺቅድ፥ ካዮ ማኦ ማእድ፥ ባንታ ሁጰን ባና ቆልድ ፆምዶሶና። <verse eid="NEH 9:1"/><verse number="2" style="v" sid="NEH 9:2"/>ባንታና አላጋ ደረ አሳፐ ሻክዶሶና። ሄሰፈ ጉየ ደንድ ኤቅድ ኤንትነ ኤንታ አዋት ኦዳ ናጋራ ኡባ ፓፅዶሶና። <verse eid="NEH 9:2"/><verse number="3" style="v" sid="NEH 9:3"/>ኤንቲ ያን ኤቅድ ደእሽን ሄ ሳተ ኩመ ጎዳ ኤንታ ፆሳ ህገ ማፃፋይ ኤንታዉ ናባበትስ። ቃስ ሀራ ሄ ሳተ ባንታ ናጋራ ፓፅሸ ጎዳ ባንታ ፆሳ ጎይንዶሶና።<verse eid="NEH 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 9:4"/>ሌወት፥ እያሱይ፥ ባን፥ ቃድምኤል፥ ሳባና፥ ቡን፥ ሳራባ፥ ባናን፥ ከናን ማድራከ ቦላ ከይድ ባንታ ቃላ ቁ ኦድ ጎዳ፥ ባንታ ፆሳ ዎስዶሶና። <verse eid="NEH 9:4"/><verse number="5" style="v" sid="NEH 9:5"/>ሌወት፥ እያሱይ፥ ቃድምኤል፥ ባን፥ አሳባን፥ ሳራብ ሆድ፥ ሳባንነ ፓታህ፥ “ደንድ ኤቅድ፥ መርናፐ መርና ጋካናዉ ደእያ ጎዳ ህንተ ፆሳ ጋላትተ!”</para>
  <para style="b" vid="NEH 9:5"/>
  <para style="pi" vid="NEH 9:5">“እያ ቦንቾ ሱን አንጅተ፤ ጋላታፐነ አንጆፈ አያ እያ ሱን ሳቢተ።” <verse eid="NEH 9:5"/><verse number="6" style="v" sid="NEH 9:6"/>ፆሳዉ፥ ነ ፃላል ጎዳ! ኔኒ ሳሎታነ ቃ ሳሎታን ደእያ መተታ፥ ሳኣነ እያ ቦላ ደእያ መተታ፥ አባታነ ኤንታ ግዶን ደእያ መተታ ኡባ መዳሳ። ኡባስ ደኦ እማዳሳ፤ ሳሎ መተት ነዉ ጎይኖሶና።<verse eid="NEH 9:6"/></para>
  <para style="pi">
    <verse number="7" style="v" sid="NEH 9:7"/>ጎዳዉ፥ ኔኒ ፆሰ! ኔኒ ካልዳወታ ቢታ ኡረፐ አብራመ ዶራዳ ከሳዳሳ። እያ ሱን ላማዳ አብራሃመ ጋዳ ሱንዳሳ። <verse eid="NEH 9:7"/><verse number="8" style="v" sid="NEH 9:8"/>እ ነዉ አማንያ አስ ግደይሳ በአዳ፥ ካናነታ፥ ህተታ፥ አሞረታ፥ ፓርዘታ፥ ያቡሰታነ ገርገሰታ ቢታ እያ ኮቻስ ላታ ቢታ ኦዳ እማናዉ እያዉ ጫቃዳሳ። ኔኒ ፅሎ ግድያ ግሾ ነ ግዳ ቃላ ፖላዳሳ።<verse eid="NEH 9:8"/></para>
  <para style="pi">
    <verse number="9" style="v" sid="NEH 9:9"/>ኔኒ ኑ ማይዛታ ግብፀ ቢታን ጋክዳ ኡንኣ በአዳሳ፤ ቃስ ዞኦ አባ ማታን ደእሸ ኤንቲ ዋስዳ ዋሱዋ ስአዳሳ። <verse eid="NEH 9:9"/><verse number="10" style="v" sid="NEH 9:10"/>ግብፀ ካዎይ፥ እያ ሹማትነ ሄ ቢታ አሳ ኡባይ እስራኤለ አሳ ቦላ ኦቶርትዳ ግሾ ኤንታ ቦላ ማላታነ ማላልስያባታ ኦዳሳ። ሄሳ ኦዳ ሀች ጋካናዉ ነ ሱንይ ቦንቾን ፄገታናዳ ኦዳሳ። <verse eid="NEH 9:10"/><verse number="11" style="v" sid="NEH 9:11"/>አባ ሻካዳ ነ አሳ መላ ቢታራ ፕንዳሳ። ሽን ሹች ጪሞ ሃን ሆልን፥ ምተተይሳዳ ኤንታ ጎድያ ሞርከታ አባን ምትሳዳ ይሳዳሳ። <verse eid="NEH 9:11"/><verse number="12" style="v" sid="NEH 9:12"/>እስራኤለ አሳ ጋላስ ሻራ ቱሳን፥ ቃማ ታማ ቱሳን ኤንታ ኦግያ ፖእሳዳ ካለዳሳ።<verse eid="NEH 9:12"/></para>
  <para style="pi">
    <verse number="13" style="v" sid="NEH 9:13"/>ኔኒ ሳሎፐ ዎዳ ነ አሳ ሲና ዙማ ቦላ ኦድሳዳሳ። ሱረ ፕርዳነ ቱማ ግድዳ ህግያ፥ ሎኦ ዎጋነ ኪታ ኤንታዉ እማዳሳ። <verse eid="NEH 9:13"/><verse number="14" style="v" sid="NEH 9:14"/>ጌሻ ነ ሳምባታ ኤንቲ ቦንቻና መላ ኤንታ ታማርሳዳሳ። ነ አይልያ ሙሰ ባጋራ ኤንታዉ ኪታ፥ ዎጋነ ህገ እማዳሳ። <verse eid="NEH 9:14"/><verse number="15" style="v" sid="NEH 9:15"/>ኤንቲ ኮሻትዳ ዎደ ሳሎፐ ካ እማዳሳ፤ ቃስ ኤንቲ ሳሞትዳ ዎደ ዛላፈ ሃ ፑልትሳዳሳ። ኔኒ ኤንታዉ እማና ጋዳ ጫቅዳ ቢታ ኤንቲ ገልድ ላታና መላ ኪታዳሳ።<verse eid="NEH 9:15"/></para>
  <para style="pi">
    <verse number="16" style="v" sid="NEH 9:16"/>ሽን ኑ ማይዛት ኦቶርትዶሶና፤ ስኦና እፅድ ነዉ ኪተትቦኮና። <verse eid="NEH 9:16"/><verse number="17" style="v" sid="NEH 9:17"/>ኪተቶና እፅዶሶና፤ ኔኒ ኤንታዉ ኦዳ ማላልስያባ ኡባ ሀሳይቦኮና። ኤንቲ ስኦና አስ ግድዶሶና፤ ባንታ ጌላተን አይለተስ ግብፀ ቢታ ጉየ ካለና መላ ሀላቃ ባንታዉ ዶርዶሶና። ግዶሽን፥ ኔኒ አቶ ግያ ፆሲ፥ ኬሀነ ማርያ ፆሲ፤ ሲቆን ኩምዳይሳነ ሀንቆስ ኤለሶና ፆሲ ግድያ ግሾ ኤንታ አጋባካ።<verse eid="NEH 9:17"/></para>
  <para style="pi">
    <verse number="18" style="v" sid="NEH 9:18"/>ኤንቲ ማራ ማላን ኤቃ መድ፥ “ህንተና ግብፀ ቢታፈ ከስዳ ህንተ ፆሳይ ሀይሳ” ያግድ ነና ግታ ጫሸ ጫይዶሶና። <verse eid="NEH 9:18"/><verse number="19" style="v" sid="NEH 9:19"/>ነ ዳሮ ማሮተን ኔኒ ኤንታ መላ ቢታን አጋባካ። ኤንቲ ብያ ኦግያ ፖእሳና መላ ጋላስ ሻራ ቱሳን፥ ቃማ ታማ ቱሳን ኤንታ ካለዳሳ። <verse eid="NEH 9:19"/><verse number="20" style="v" sid="NEH 9:20"/>ኤንታ ታማርሳና መላ ነ ሎኦ አያና ኤንታዉ እማዳሳ። ማናዉ ማና፥ ኡያናዉ ሃ ኤንታዉ እማዳሳ። <verse eid="NEH 9:20"/><verse number="21" style="v" sid="NEH 9:21"/>ኦይታሙ ላይ ኩመ መላ ቢታን ሄመትያ ዎደ ኤንታዉ ኮሽያባፐ እስባካ ፓጭሳባካ። ኤንታ ማኦይ ዉርቤና፤ ኤንታ ቶሆይ ክፅቤና።<verse eid="NEH 9:21"/></para>
  <para style="pi">
    <verse number="22" style="v" sid="NEH 9:22"/>ነ ኤንታ ካዎተታነ ደረታ ሀር አቶሽን ሃሆን ደእያ ቢታታ ፆንድ ኦይካና መላ ኦዳሳ። ካዎይ ስሆነይ ሃርያ ሀሰቦና ቢታነ ካዎይ ኦገይ ሃርያ ባሳነ ቢታ ኤንታና ላትሳዳሳ። <verse eid="NEH 9:22"/><verse number="23" style="v" sid="NEH 9:23"/>ኤንታ ኮቻ ታይቡዋ ሳሎ ፆልንቶዳ ዳርሳዳሳ። ኤንታ ማይዛታስ እማና ጋዳ ጫቅዳ ቢታ ኤንታ ላትሳዳሳ። <verse eid="NEH 9:23"/><verse number="24" style="v" sid="NEH 9:24"/>ኤንታ ናይት ካናነ ቢታ ላትዶሶና። ሄ ቢታን ደእያ ካናነ አሳ ኤንታ ስንን ኔኒ ካዉሻዳሳ። ኤንቲ ካናነ አሳ ቦላ፥ ኤንታ ካዎታ ቦላነ ቢታን ደእያ አሳ ቦላ ዶስዳባ ኦና መላ ኤንታ ኩሸን አ እማዳሳ። <verse eid="NEH 9:24"/><verse number="25" style="v" sid="NEH 9:25"/>ኤንቲ ዩሾይ ግምበትዳ ካታማታነ አራዳ ቢታ ፆንድ ኤክዶሶና። ሎኦባ ኡባይ ኩምዳ ኬታ፥ ቦከትዳ ሃ ኦላታ፥ ዎይነ በሳታ፥ ሻማሆነ ሀራ አይፈ አይፍያ ዳሮ ምታ ላትዶሶና። እያፐ ምድ ካልድ ኦርድዶሶና፤ ነ ግታ ኬሀተን ኡፋይትዶሶና።<verse eid="NEH 9:25"/></para>
  <para style="pi">
    <verse number="26" style="v" sid="NEH 9:26"/>ግዶሽን፥ ኤንቲ ኪተቶና እፅድ፥ ነ ቦላ ማካልዶሶና፤ ነ ህግያ ቦላ ዞኮ ዛርዶሶና። ኔኮ ስማናዳ ኤንታዉ ምንድ ኦድዳ ነ ናበታ ዎዶሶና። ዳሮ ኢታ ጫሽ ነና ጫይዶሶና። <verse eid="NEH 9:26"/><verse number="27" style="v" sid="NEH 9:27"/>ሄሳ ግሾ፥ ኤንታ ኡንኤያ ሞርከታ ኩሸን አ እምን፥ ሞርከት ኤንታ ኡንኤዳ ዎደ ኔኮ ዋስዶሶና። ኤንታ ዋሱዋ ሳሎን ግዳዳ ስአዳሳ፤ ነ ማሮተ ዳሩዋን ኤንታ፥ ኤንታ ሞርከታ ኩሸፐ አሽያ አሳታ ኪታዳሳ።<verse eid="NEH 9:27"/></para>
  <para style="pi">
    <verse number="28" style="v" sid="NEH 9:28"/>ሽን ኤንቲ ሸምፖ ደም ስሚድ ዛሪድ ነ ስንን ናጋራ ኦዶሶና። ነ ዛራዳ ኤንታ ሞርከታ ኩሸን አዳ እምን፥ ኤንታ ሞርከት ኤንታ ሃርዶሶና። ሽን ሀእካ ኤንቲ ኔኮ ዋስን፥ ኤንታ ዋሱዋ ሳሎን ግዳዳ ስአዳሳ። ነ ማሮተን ኤንታ ዛራ ዛራዳካ አሻ ኤካዳሳ።<verse eid="NEH 9:28"/></para>
  <para style="pi">
    <verse number="29" style="v" sid="NEH 9:29"/>ነ ህግያኮ ኤንቲ ስማና መላ ኤንታዉ ምንዳ ኦዳዳሳ፥ ሽን ኤንቲ ኦቶርትዶሶና፤ ነዉ ኪተቶና እፅዶሶና። አስ ኪተትድ ደኦ ደምያ ነ ህግያ መንዶሶና። ነዉ ዞኮ ዛሪድ ስኦና እፅዶሶና፤ ኪተቶና እፅዶሶና። <verse eid="NEH 9:29"/><verse number="30" style="v" sid="NEH 9:30"/>ግድኮካ ነ ኤንታ ዳሮ ላይ ዳንዳአዳሳ፤ ነ አያናን ናበታ ባጋራ ኤንታዉ ኦዳዳሳ፥ ሽን ኤንቲ ስእቦኮና። ሄሳ ግሾ፥ ሾሮ ካዎተት ኤንታ ሃራና መላ አ እማዳሳ። <verse eid="NEH 9:30"/><verse number="31" style="v" sid="NEH 9:31"/>ሽን ኔኒ ኬሀነ ማርያ ፆሲ ግድያ ግሾ፥ ነ ግታ ማሮተን ኤንታ አጋባካ፤ ቡርፆራ ይሳባካ።<verse eid="NEH 9:31"/></para>
  <para style="pi">
    <verse number="32" style="v" sid="NEH 9:32"/>ህዛ ኑ ፆሳዉ፥ ግታዉ፥ ዎልቃማነ ያየትዳ ፆሳዉ፥ ነ መርና ሲቆ ጫቁዋ ናገይሶ፥ በን አሶረ ካዎተፈ ሀች ጋካናዉ ኑ ቦላ፥ ኑ ካዎታ ቦላ፥ ኑ ሀላቃታ ቦላ፥ ኑ ካህነታ ቦላ፥ ኑ ናበታ ቦላ፥ ኑ ማይዛታ ቦላነ ነ አሳ ኡባ ቦላ ጋክዳ መቶይ ነ ስንን ላፋባ ዳኖፖ። <verse eid="NEH 9:32"/><verse number="33" style="v" sid="NEH 9:33"/>ኑና ጋክዳባ ኡባን ኔኒ ፅሎ። ኑኒ ነና ናቅኮካ ነ አማነተ አጋባካ። <verse eid="NEH 9:33"/><verse number="34" style="v" sid="NEH 9:34"/>ኑ ካዎት፥ ኑ ሀላቃት፥ ኑ ካህነትነ ኑ ማይዛት ነ ህግያ ናግቦኮና። ቃስ ነ ኤንታዉ እምዳ ኪታነ ናግሱዋ ስእቦኮና። <verse eid="NEH 9:34"/><verse number="35" style="v" sid="NEH 9:35"/>ነ ኤንታ ካዎተን ኤንታዉ ግታ አንጁዋ እማዳሳ፤ ዳልጋነ አራዳ ቢታ ኤንታዉ እማዳሳ። ሽን ኤንቲ ነና ጎይንቦኮና፤ ባንታ ኢታ ኦሱዋፐ ስምቦኮና።<verse eid="NEH 9:35"/></para>
  <para style="pi">
    <verse number="36" style="v" sid="NEH 9:36"/>“ህዛ፥ ሀች ኑኒ አይለ ግደይሳ በአ። ኑ ማይዛት ሄ ቢተ አይፍያነ እያ እምያ አንጁዋ ኡባ ማና መላ ነ እምዳ ቢታን ኑ ሀች አይለ ግድዳ። <verse eid="NEH 9:36"/><verse number="37" style="v" sid="NEH 9:37"/>ኑ ናጋራ ግሾ፥ ነ ኑ ቦላ ደንዳ ካዎት ቢታይ እምያ አይፍያ ኡባ ጎኤቶሶና። ኑ ቦላነ ኑ መህያ ቦላ ባንታ ኮይዳባ ኦሶና፤ ኑኒ ግታ መቶ ግዶን ደኦስ” ያግዶሶና።<verse eid="NEH 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 9:38"/>ሀንዳባ ኡባ ግሾ፥ ኑኒ ሃሳይድ፥ ሄ ሃሳያ ፃፍድ ቆንጭሳናዉ ቆፋ ቃችዳ። ፃፈትዳ ፁፍያ ቦላ ኑ ሀላቃት፥ ኑ ሌወትነ ኑ ካህነት ባንታ ማታመ ዎዶሶና።<verse eid="NEH 9:38"/></para>
  <chapter eid="NEH 9"/>
  <chapter number="10" style="c" sid="NEH 10"/>
  <para style="p">
    <verse number="1" style="v" sid="NEH 10:1"/>ማታመ ዎዳ አሳ ሱንይ፥ ቢታ አይስያ ናህመይ፥ ሀካልያ ናአይ፥</para>
  <para style="p" vid="NEH 10:1">ካህነታፐ፥ ሰደቅያሳ፥ <verse eid="NEH 10:1"/><verse number="2" style="v" sid="NEH 10:2"/>ሳራያ፥ አዛራ፥ ኤርምያሳ፥ <verse eid="NEH 10:2"/><verse number="3" style="v" sid="NEH 10:3"/>ፓስኮራ፥ አማረ፥ ማልካ፥ <verse eid="NEH 10:3"/><verse number="4" style="v" sid="NEH 10:4"/>ሀፁሳ፥ ሳባና፥ ማሉካ፥ <verse eid="NEH 10:4"/><verse number="5" style="v" sid="NEH 10:5"/>ሀርማ፥ ማረሞታ፥ ኦባዳ፥ <verse eid="NEH 10:5"/><verse number="6" style="v" sid="NEH 10:6"/>ዳነላ፥ ግነቶና፥ ባሮካ፥ <verse eid="NEH 10:6"/><verse number="7" style="v" sid="NEH 10:7"/>ማሱላማ፥ አብያ፥ ምያምና፥ <verse eid="NEH 10:7"/><verse number="8" style="v" sid="NEH 10:8"/>ማኣዛ፥ በልጋያነ ሻማያ።<verse eid="NEH 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 10:9"/>ሌወታፐ፥ አዝናታ ናኣ እያሱ፥ ሄናዳዳ ኮች ግድዳ ብኑያ፥ ቃድምኤላነ <verse eid="NEH 10:9"/><verse number="10" style="v" sid="NEH 10:10"/>ኤንታራ ኦያ ሳባና፥ ሆድያ፥ ቃልፃ፥ ፓላያ፥ ሀናና፥ <verse eid="NEH 10:10"/><verse number="11" style="v" sid="NEH 10:11"/>ምካ፥ ራሆባ፥ ሀሳባያ፥ <verse eid="NEH 10:11"/><verse number="12" style="v" sid="NEH 10:12"/>ዛኩራ፥ ሳራባ፥ ሳባና፥ <verse eid="NEH 10:12"/><verse number="13" style="v" sid="NEH 10:13"/>ሆድያ፥ ባናነ ባንና።<verse eid="NEH 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 10:14"/>ሀላቃታፐ፥ ፓሮሳ፥ ፓሀት-ሞአባ፥ ኤላማ፥ ዛታ፥ ባና፥ <verse eid="NEH 10:14"/><verse number="15" style="v" sid="NEH 10:15"/>ቡና፥ አዝጋዳ፥ በባያ፥ <verse eid="NEH 10:15"/><verse number="16" style="v" sid="NEH 10:16"/>አዶና፥ ብግዋያ፥ አድና፥ <verse eid="NEH 10:16"/><verse number="17" style="v" sid="NEH 10:17"/>አፄራ፥ ህዝቅያሳ፥ አዙራ፥ <verse eid="NEH 10:17"/><verse number="18" style="v" sid="NEH 10:18"/>ሆድያ፥ ሀሱማ፥ በሳያ፥ <verse eid="NEH 10:18"/><verse number="19" style="v" sid="NEH 10:19"/>ሀርፋ፥ አናቶታ፥ ነባያ፥ <verse eid="NEH 10:19"/><verse number="20" style="v" sid="NEH 10:20"/>ማግጳሳ፥ ማሱላማ፥ ኤዝራ፥ <verse eid="NEH 10:20"/><verse number="21" style="v" sid="NEH 10:21"/>ማሰዛቤላ፥ ሳዶቃ፥ ያዱአ፥ <verse eid="NEH 10:21"/><verse number="22" style="v" sid="NEH 10:22"/>ፓላፃ፥ ሀናና፥ አናያ፥ <verse eid="NEH 10:22"/><verse number="23" style="v" sid="NEH 10:23"/>ሆሰ፥ ሀናና፥ ሀሱባ፥ <verse eid="NEH 10:23"/><verse number="24" style="v" sid="NEH 10:24"/>ሀሎሄሳ፥ ፕልሀ፥ ሶበቃ፥ <verse eid="NEH 10:24"/><verse number="25" style="v" sid="NEH 10:25"/>ረሁማ፥ ሀሳብና፥ ማሰያ፥ <verse eid="NEH 10:25"/><verse number="26" style="v" sid="NEH 10:26"/>አክያ፥ ሀናና፥ አናና፥ <verse eid="NEH 10:26"/><verse number="27" style="v" sid="NEH 10:27"/>ማሉካ፥ ሀርማነ ባአና።<verse eid="NEH 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 10:28"/>አትዳ አሳይ፥ ካህነት፥ ሌወት፥ ፐንግያ ናገይሳት፥ ዛማረት፥ ፆሳ ኬ ኦሳንቾት፥ ፆሳ ህግያስ ኪተታናዉ ባንታና አይሁደ ግዶና ደረታፐ ሻክዳ ኡባይ፥ ኤንታ ማቸት፥ አኬካናዉ ዳንዳእያ ኤንታ አደ ናይትነ ማጫ ናይት፥ <verse eid="NEH 10:28"/><verse number="29" style="v" sid="NEH 10:29"/>ባንታና ካለይሳታራ እስፈ ጫቅዶሶና። ኤንቲ ፆሳ አይልያ ሙሰ ባጋራ ፆሳይ እምዳ ኑ ጎዳ፥ ፆሳ ኪታ፥ ህግያነ ዎጋ ናጋናዉ ቃንገንነ ጫቆን ቃላ ገልዶሶና።<verse eid="NEH 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NEH 10:30"/>ኤንቲ ሀይሳዳ ያግድ ጫቅዶሶና፤ “ኑ ማጫ ናይታ አይሁደ ግዶና አደ ናይታስ እሞኮ፤ ኤንታ ማጫ ናይታ ኑ አደ ናይታስ ማቾ ኦድ ኤኮኮ።<verse eid="NEH 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 10:31"/>“አይሁደ ግዶና አሳት ካ ግድን ዎይኮ ሀራባ ሳምባታ ጋላስ ዎይኮ ሀራ ባኣለ ጋላስ ባይዛናዉ ኤህኮ ኤንታፈ ሻሞኮ። ላፑን ላይ ጋክያ ዎደ ዎደ ኑ ቢታ ጎዮኮ፤ ኑኒ ታልእዳ አጩዋ አቾኮ።<verse eid="NEH 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NEH 10:32"/>“ፆሳ ኬ ኦሱዋስ ኦይዱ ግራመ ብራ ላይን ላይን ቃንፆና እማና። <verse eid="NEH 10:32"/><verse number="33" style="v" sid="NEH 10:33"/>ሄስካ፥ ጎዳ ስንን ዎያ ኡይስ፥ ጋላስ ጋላስ ያርሸትያ ካ ያርሹዋስ፥ ፁሳ ያርሹዋስ፥ ሳምባታ ጋላሳን፥ አጌና ፄሮን፥ ላይን ደእያ ሀራ ባለታን፥ ጌሻ ያርሾታስ፥ እስራኤለ አሳ ናጋራ አቶተስ ያርሸትያ ያርሹዋስነ ኑ ፆሳ ኬ ኦሱዋስ ኮሽያ ኡባ ኩንናሳ።<verse eid="NEH 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NEH 10:34"/>“ኑ፥ ካህነት፥ ሌወትነ ሀራ አሳ ኡባይ፥ ላይን ላይን ኦሰትያ ጋላሳን፥ ህግያን ፃፈትዳይሳዳ ጎዳ፥ ኑ ፆሳ ያርሾ በሳን ኤፅያ ም እስ እስ ኮቻይ አዉደ ኤሀናዉ በሲያኮ ኤራናዉ ሳማ የግዳ።<verse eid="NEH 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NEH 10:35"/>“ካ ኑ ሺሽያ ዎደነ ዱማ ዱማ ም አይፍያ ኑ ማፅያ ዎደ ባይራ ፆሳ ኬ ኤሀና።<verse eid="NEH 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NEH 10:36"/>“ህግያን ፃፈትዳይሳዳ ኑኒ ኮይሮ የለትያ ኑ አደ ናይታ፥ ቃስ ኑ ሚዛት፥ ኑ ዶርሳትነ ኑ ዴሻት የልያ ኮይሮ ማራታ ፆሳ ኬን ኦያ ካህነታኮ ኤህድ ፆሳስ ዱማያና።<verse eid="NEH 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="NEH 10:37"/>“ኑኒ ኑ ቢታን ካፅዳ ካፈ ኮይሩዋ፥ ኑ ም ኡባ አይፍያ፥ ዎይንያነ ዛይትያ እሞታ ኦድ፥ ፆሳ ኬን ኦያ ካህነታኮ ኤሀና። ሌወት ኑ ደእያ ካታማታ ጎሻን አይፍያባፐ አስራታ ኤክያ ግሾ፥ ኑ ቢታይ አይፍያባፐ አስራታ ኤሀና። <verse eid="NEH 10:37"/><verse number="38" style="v" sid="NEH 10:38"/>ሌወት አስራታ ሺሽያ ዎደ፥ አሮና ያራ ግድዳ ካህነት ኤንታራ እስፈ ግዳናዉ በሴስ። ሌወት አስራታ ሺሽዳፐ ጉየ፥ አስራታፐ አስራታ ከስድ ኑ ፆሳ ኬ ኤህድ፥ ሚሸ ዎያ ክፍልያን ዎ። <verse eid="NEH 10:38"/><verse number="39" style="v" sid="NEH 10:39"/>እስራኤለ አሳይነ ሌወት ካ፥ ዎይንያነ ሻማሆ ዛይተ እሞታ ጌሻ ሚሸት ኡትያ በሳነ ካህነት፥ ፐንግያ ናገይሳትነ ዛማረት ሸምፕያ ክፍልያ ኤሆ።</para>
  <para style="p" vid="NEH 10:39">“ኑኒ ፆሳ ኬ ኡባካ አጎኮ” ያግድ ጫቅዶሶና።<verse eid="NEH 10:39"/></para>
  <chapter eid="NEH 10"/>
  <chapter number="11" style="c" sid="NEH 11"/>
  <para style="s1">የሩሳላመን ደእያ አሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 11:1"/>አሳ ካለይሳት የሩሳላመን ደእዶሶና። ሀንኮ አሳይ ታማፈ እሶይ ጌሻ ካታማን የሩሳላመን ደአና መላ ሳማ የግድ ዶርዶሶና። ሽን ሀራ ኡዱፉን ኩሸ አሳይ ባንታ ካታማን ካታማን ደእዶሶና። <verse eid="NEH 11:1"/><verse number="2" style="v" sid="NEH 11:2"/>ባ ሸነን የሩሳላመን ደአናዉ ዶስዳ አሳ ኡባ አሳይ አንጅዶሶና።<verse eid="NEH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 11:3"/>ሀራ ካታማታን ደእያ እስራኤለ አሳይ፥ ካህነት፥ ሌወት፥ ፆሳ ኬ ኦሳንቾት፥ ሶሎሞነ አይለታ ሼሻት ኡባይ ባንታ ካታማን ካታማን ደእያ ጋድያ ኦይክድ ደእዶሶና።<note caller="-" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="NEH 7:73">ናህ 7:73</ref>.</char></note> ሀይሳፈ ካልድ ፃፈትዳይሳት፥ የሩሳላመን ደአናዉ ይዳ ቢታ ሹማታ፤ <verse eid="NEH 11:3"/><verse number="4" style="v" sid="NEH 11:4"/>ይሁዳ ኮቻፈ ይዳ አሳይ ፓረሳ ያራ ግድዳ አታያነ ሴላ ያራ ግድዳ ማእሰያ። አታይ ኦዝያና ናአ፤ ኦዝያን ዛካርያሳ ናአ፤ ዛካርያስ አማረ ናአ፤ አማረይ ሳፋፃ ናአ፤ ሳፋፅ ማላልኤላ ናአ። <verse eid="NEH 11:4"/><verse number="5" style="v" sid="NEH 11:5"/>ማእሰይ ባሮካ ናአ፤ ባሮክ ኮልሆዛ ናአ፤ ኮልሆዝ ኦዛ ናአ፤ ኦዝ አዳያ ናአ፤ አዳይ ዮያርባ ናአ፤ ዮያርብ ዛካርያሳ ናአ። ሀይሳቲ ሴላ ኮቻታ። <verse eid="NEH 11:5"/><verse number="6" style="v" sid="NEH 11:6"/>ፓረሳ ያራፐ ዎልቃማ ግድዳ 468 አሳት የሩሳላመን ደእዶሶና።<verse eid="NEH 11:6"/></para>
  <para style="p">
    <verse number="7-8" style="v" sid="NEH 11:7-8"/>ብንያመ ኮቻፈ ይዳ አሳይ ሳላ፥ ጋባያነ ሳላያ። ሳሉ ማሱላማ ናአ፤ ማሱላም ዮኤዳ ናአ፤ ዮኤድ ፓዳያ ናአ፤ ፓዳየይ ቆላያ ናአ፤ ቆላይ ማእሰያ ናአ፤ ማእሰይ እትኤላ ናአ፤ እትኤል የሻያ ናአ። ብንያመ ዛርያፐ 928 አሳይ የሩሳላመን ደእዶሶና። <verse eid="NEH 11:7-8"/><verse number="9" style="v" sid="NEH 11:9"/>ዝክራ ናአይ እዩኤል ኤንታ ሀላቃ፤ ቃስ ሀሳኑአ ናአይ ይሁድ ካታማን ናምአን ሀላቃ።<verse eid="NEH 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 11:10"/>ካህነታፐ ይዳ አሳይ ዮያርባ ናኣ ያዳያ፥ ያክና ናኣ፤ <verse eid="NEH 11:10"/><verse number="11" style="v" sid="NEH 11:11"/>ሳራያ፤ ሳራይ ክልቅያ ናአ፤ ክልቀይ ማሱላማ ናአ፤ ማሱላም ሳዶቃ ናአ፤ ሳዶቅ ማራዮታ ናአ፤ ማራዮት ፆሳ ኬ ሀላቃ ግድዳ አህፁባ ናአ። <verse eid="NEH 11:11"/><verse number="12" style="v" sid="NEH 11:12"/>ኤንታራ እስፈ ፆሳ ኬን ኦያ ኦሳንቾት ኩመ 822. አዳይ ይሮሃማ ናአ፤ ይሮሃም ፓላላ ናአ፥ ፓላል አሞፀ ናአ፤ አሞፀይ ዛካርያሳ ናአ፤ ዛካርያስ ፓስኮራ ናአ፤ ፓስኮራ ማልክያ ናአ። <verse eid="NEH 11:12"/><verse number="13" style="v" sid="NEH 11:13"/>አዳያራ እስፈ ደእያ አሳይነ ኤንታ ሶ አሳ ሀላቃት ኩመ 242. አማሳሳይ አዛርኤላ ናአ፤ አዛርኤል አህዛያ ናአ፤ አህዛይ ማሽልሞታ ናአ፤ ማሽልሞት እመራ ናአ። <verse eid="NEH 11:13"/><verse number="14" style="v" sid="NEH 11:14"/>አማሳያራ እስፈ ደእያ ኦላንቾት ኩም 128. ሀግዶልማ ናአይ ዛብድኤል ካህነታ አይሰይሳ።<verse eid="NEH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 11:15"/>ሌወታፐ ይዳ አሳይ ሻማያ፤ ሻማየይ ሀሹባ ናአ፤ ሀሹብ አዝርቃማ ናአ፤ አዝርቃም ሀሳባያ ናአ፤ ሀሻበይ ቡና ናአ። <verse eid="NEH 11:15"/><verse number="16" style="v" sid="NEH 11:16"/>ሌወት ሳባትነ ዮዛባታ ፆሳ ኬፈ ካረራ ኦሰትያ ኦሱዋስ ሀላቃ። <verse eid="NEH 11:16"/><verse number="17" style="v" sid="NEH 11:17"/>ማታን ምካ ናአ፤ ምክ ዛብዳ ናአ፤ ዛብድ ጋላታ ዎሳ ካለያ አሳፋ ናአ፤ አሳፍ እያ ናምአን ሀላቃ ግድዳ ባቅቡቃ ናአ፤ ባቅቡቅ ሳሙሳ ናአ፤ ሳሙስ ጋላላ ናአ፤ ጋላል የዱቱና ናአ። <verse eid="NEH 11:17"/><verse number="18" style="v" sid="NEH 11:18"/>ሌወታፐ 284 አሳይ ጌሻ ካታማን የሩሳላመን ደእዶሶና።<verse eid="NEH 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 11:19"/>ፐንግያ ናገይሳታፐ፥ አቁባ፥ ታልሞናነ ኤንታራ እስፈ ኦያ ኦሳንቾታ ታይቦይ 172.<verse eid="NEH 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 11:20"/>አትዳ ካህነት፥ ሌወትነ እስራኤለ አሳ ኡባይ ባንታ ላታ ቢታን ይሁዳ ካታማታን ደእዶሶና። <verse eid="NEH 11:20"/><verse number="21" style="v" sid="NEH 11:21"/>ሽን ፆሳ ኬ ኦሳንቾት የሩሳላመ ካታማን ደእያ ኦፌላ ደርያ ቦላ ደእዶሶና። ስሀነ ግሽፓ ጌተትያ ናምኡ አሳት ኤንታ ሀላቃታ።<verse eid="NEH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 11:22"/>የሩሳላመን ደእያ ሌወታ ሀላቃይ ኦዛ። ኦዝ ባና ናአ፤ ባን ሀሳባያ ናአ፤ ሀሻበይ ማታና ናአ፤ ማታን ምካ ናአ። ኦዝ ፆሳ ኬ ዛማረታ ሀላቃ ግድዳ አሳፋ ናአ። <verse eid="NEH 11:22"/><verse number="23" style="v" sid="NEH 11:23"/>ዛማረት ጋላስ ጋላስ የፃና ማዝሙርያ ካዎይ ኤንታ ኪቴስ።<verse eid="NEH 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 11:24"/>ይሁዳ ናኣ ዛራሀ ያራፐ የለትዳ ማሰዛቤላ ናኣ ፓታሀ እስራኤለ አሳስ ዶና ግድድ፥ ካዋ ማታን ደኤስ። <verse eid="NEH 11:24"/><verse number="25" style="v" sid="NEH 11:25"/>ይሁዳ አሳፐ ጉት ጎሻ ጋደታንነ ጉታታን፥ ቅርያት-አርባንነ እያ ጉታታን፥ ድቦናንነ እያ ጉታታን፥ ያቃብፅኤላንነ እያ ጉታታን ደእዶሶና። <verse eid="NEH 11:25"/><verse number="26" style="v" sid="NEH 11:26"/>ቃስ እያሱን፥ ሞላዳን፥ ቤት-ጳለፃን፥ <verse eid="NEH 11:26"/><verse number="27" style="v" sid="NEH 11:27"/>ሀፃር-ሹኣላንነ እያ ጉታታን፥ በርሳበንነ እያ ጉታታን፥ <verse eid="NEH 11:27"/><verse number="28" style="v" sid="NEH 11:28"/>ፅቅላጋን፥ ማኮናንነ ኤንታ ጉታታን፥ <verse eid="NEH 11:28"/><verse number="29" style="v" sid="NEH 11:29"/>ኤንርሞናን፥ ፆርአንነ ያርሙታን፥ <verse eid="NEH 11:29"/><verse number="30" style="v" sid="NEH 11:30"/>ዛኖሀን፥ አዱላማንነ ኤንታ ጉታታን፥ ላክሶንነ እያ ሄራን ደእያ ጎሻ ጋድያን፥ አዜቃንነ እያ ጉታታን ደእዶሶና። ሄሳዳ ሀንድ ይሁዳ አሳይ በርሳበፐ ብድ ህኖማ ዛንጋራ ጋካናዉ ደእያ በሳን ደእዶሶና።<verse eid="NEH 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 11:31"/>ብንያመ ኮቻት ግብአን፥ ምክማሳን፥ አያን፥ ቤተለንነ ኤንታ ጉታታን፥ <verse eid="NEH 11:31"/><verse number="32" style="v" sid="NEH 11:32"/>አናቶታን፥ ኖባን፥ አናንያን፥ <verse eid="NEH 11:32"/><verse number="33" style="v" sid="NEH 11:33"/>ሀፆራን፥ ራማን፥ ግታማን፥ <verse eid="NEH 11:33"/><verse number="34" style="v" sid="NEH 11:34"/>ሀድዳን፥ ፃቦእማን፥ ናባላፃን <verse eid="NEH 11:34"/><verse number="35" style="v" sid="NEH 11:35"/>ሎዳን፥ ኦኖንነ ኩሸ ሂላታ ዛንጋራ ጌተትያ በሳን ደእዶሶና። <verse eid="NEH 11:35"/><verse number="36" style="v" sid="NEH 11:36"/>ይሁዳን ደእዳ ሌወታፐ ባጋት ብንያመ አሳራ ዳናዳ ኦሰትዶሶና።<verse eid="NEH 11:36"/></para>
  <chapter eid="NEH 11"/>
  <chapter number="12" style="c" sid="NEH 12"/>
  <para style="s1">ካህነታነ ሌወታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 12:1"/>ሳላትያላ ናኣ ዛሩባበላራነ ካህነ ሀላቃ እያሱራ ድኦፔ ስምዳ ካህነትነ ሌወት ሀይሳታ፦</para>
  <para style="p" vid="NEH 12:1">ሳራያ፥ ኤርምያሳ፥ እዝራ፥ <verse eid="NEH 12:1"/><verse number="2" style="v" sid="NEH 12:2"/>አማረ፥ ማሉካ፥ ሀፁሳ፥ <verse eid="NEH 12:2"/><verse number="3" style="v" sid="NEH 12:3"/>ሳካና፥ ረሁማ፥ ማረሞታ፥ <verse eid="NEH 12:3"/><verse number="4" style="v" sid="NEH 12:4"/>እዳ፥ ግነቶና፥ አብያ፥ <verse eid="NEH 12:4"/><verse number="5" style="v" sid="NEH 12:5"/>ምያምና፥ ማአዳ፥ በልጋ፥ <verse eid="NEH 12:5"/><verse number="6" style="v" sid="NEH 12:6"/>ሻማአ፥ ዮያርባ፥ ያዳያ፥ <verse eid="NEH 12:6"/><verse number="7" style="v" sid="NEH 12:7"/>ሳላ፥ አሞካ፥ ህልቅያነ ያዳያ። ሀይሳቲ እያሱ ላይን ካህነታስነ ያራታስ ሀላቃ ግድዳይሳታ።<verse eid="NEH 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 12:8"/>ኤንታራ እስፈ ስምዳ ሌወት እያሱ፥ ብኑያ፥ ቃድምኤላ፥ ሳራባ፥ ይሁዳነ ጋላታ ማዝሙረ ዛማረይሳታ ሀላቃ ግድዳ ማታና። <verse eid="NEH 12:8"/><verse number="9" style="v" sid="NEH 12:9"/>ኤንታራ እስፈ ዛማርያ ባቅቡቀይነ ኡኖይ ኤንታፈ ስንራ ሃ ስም ኤቅድ የፆሶና።<verse eid="NEH 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 12:10"/>እያሱይ ዮያቅማ የልስ፤ ዮያቅም ኤልያሴባ የልስ፤ ኤልያሴብ ዮያዳ የልስ፤ <verse eid="NEH 12:10"/><verse number="11" style="v" sid="NEH 12:11"/>ዮያድ ዮናታና የልስ፤ ዮናታን ያዱአ የልስ። <verse eid="NEH 12:11"/><verse number="12" style="v" sid="NEH 12:12"/>ዮያቅም ካህነ ሀላቃ ግድድ ደእያ ላይ፥ ሀይሳፈ ካልድ ፃፈትዳይሳት ካህነታ ያራታ ሀላቃታ።</para>
  <para style="p" vid="NEH 12:12">ሳራያ ያራ ሀላቃይ ማራያ።</para>
  <para style="p" vid="NEH 12:12">ኤርምያሳ ያራ ሀላቃይ ሀናንያ።<verse eid="NEH 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 12:13"/>እዝራ ያራ ሀላቃይ ማሱላማ።</para>
  <para style="p" vid="NEH 12:13">አማረ ያራ ሀላቃይ የሆሀናና።<verse eid="NEH 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 12:14"/>ማሉካ ያራ ሀላቃይ ዮናታና።</para>
  <para style="p" vid="NEH 12:14">ሳባና ያራ ሀላቃይ ዮሰፋ።<verse eid="NEH 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 12:15"/>ሀርማ ያራ ሀላቃይ አድና።</para>
  <para style="p" vid="NEH 12:15">ማራዮታ ያራ ሀላቃይ ህልቃያ።<verse eid="NEH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 12:16"/>እዶ ያራ ሀላቃይ ዛካርያሳ።</para>
  <para style="p" vid="NEH 12:16">ግነቶና ያራ ሀላቃይ ማሱላማ።<verse eid="NEH 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 12:17"/>አብያ ያራ ሀላቃይ ዝክራ።</para>
  <para style="p" vid="NEH 12:17">ምንያምናነ ማአዳ ያራ ሀላቃይ ፕልፃያ።<verse eid="NEH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NEH 12:18"/>ብልጋ ያራ ሀላቃይ ሳሙአ።</para>
  <para style="p" vid="NEH 12:18">ሻማያ ያራ ሀላቃይ ዮናታና።<verse eid="NEH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 12:19"/>ዮያርባ ያራ ሀላቃይ ማታናያ።</para>
  <para style="p" vid="NEH 12:19">ያዳያ ያራ ሀላቃይ ኦዛ።<verse eid="NEH 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 12:20"/>ሳላያ ያራ ሀላቃይ ቃላያ።</para>
  <para style="p" vid="NEH 12:20">አሞካ ያራ ሀላቃይ ኤቤራ።<verse eid="NEH 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NEH 12:21"/>ከልቀ ያራ ሀላቃይ ሀሳባያ።</para>
  <para style="p" vid="NEH 12:21">ያዳያ ያራ ሀላቃይ ናትናኤላ።<verse eid="NEH 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 12:22"/>ሌወታ ሀላቃት ኤልያሴብ፥ ዮያዳ፥ ዮሃንነ ያዱእ ካህነ ሀላቃ ግድዳ ዱማ ዱማ ላይን ኤንቲ ፃፈትዶሶና። ሄ ማዝጋበይ ጊግዳይ ፋርሰ ቢታ ካዋ ዳርዮሳ ላይና። <verse eid="NEH 12:22"/><verse number="23" style="v" sid="NEH 12:23"/>ግዶሽን፥ ሌወታ ያራታ ሀላቃት ማዝጋበን ፃፈትዳይ ኤልያሴባ ናኣ ናአ ግድዳ ዮሃን ሀይቃና ጋካናዉ ደእያ ዎደ ፃላላና።<verse eid="NEH 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 12:24"/>ሌወታ ሀላቃት ሀሳባያ፥ ሳራባነ ቃድምኤላ ናኣ እያሱ። ኤንቲ ፆሳ አስ ግድዳ ካዎይ ዳዊቲ ኪትዳይሳዳ፥ ናምአን ሻከት ኤቅድ፥ ታራን ታራን ፆሳ ቦንቾሶናነ ጋላታ ማዝሙረ የፆሶና።<verse eid="NEH 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 12:25"/>ፆሳ ኬ ግምበ ድርሳ ፐንግያ ማታን ኬፀትዳ ዱማ ዱማ ሚሸ ዎያ ኬ ናገይሳት ማታና፥ ባቅቡቃ፥ አብድዩ፥ ማሱላማ፥ ፃልሞናነ አቁባ። <verse eid="NEH 12:25"/><verse number="26" style="v" sid="NEH 12:26"/>ሀይሳቲ ዮፀደቃ ናኣ ናኣ ግዳዳ እያሱ ናኣ ዮያቅመይ፥ ቢታ አይስያ ናህመይነ ካህነነ ፃፈ ግድዳ እዝር ደእዳ ላይን ኦዶሶና።<verse eid="NEH 12:26"/></para>
  <para style="s1">የሩሳላመ ግምበ ድርሳ አንጅሶ ባኣለ</para>
  <para style="p">
    <verse number="27" style="v" sid="NEH 12:27"/>የሩሳላመ ግምበ ድርሳይ ግምበትድ ዉርዳ ባኣለ ቦንችያ ዎደ ሌወት ባንታ ደእያ በሳፈ ኮየትድ፥ ዳላን፥ ዲን፥ ማስንቆን፥ ጋላታ ማዝሙረ የፅሸ ኡፋይሳን ባኣለ ቦንቻናዉ የሩሳላመ ይዶሶና። <verse eid="NEH 12:27"/><verse number="28" style="v" sid="NEH 12:28"/>ሀ ባልያ ቦንቻናዉ ዛማረት የሩሳላመ ሄራን ደእያ ናፆፋታ ጉታታፐ፥ <verse eid="NEH 12:28"/><verse number="29" style="v" sid="NEH 12:29"/>ቤት-ገልጋላፐ፥ ግብአፐነ አዝማወታፐ ሺቅዶሶና። ኤንቲ የሩሳላመ ሄራን ባንታዉ ጉታታ ኬፅዶሶና። <verse eid="NEH 12:29"/><verse number="30" style="v" sid="NEH 12:30"/>ካህነትነ ሌወት ባንታና ዎጋዳ ጌሽዳፐ ጉየ አሳ፥ ፐንገታነ ግምበ ድርሳ ጌሽዶሶና።<verse eid="NEH 12:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 12:31"/>ታኒ ይሁዳ ሀላቃታ ግምበ ድርሳ ቦላ ከሳስ። ናምኡ ግታ ማዝሙረ ኮይረታ ጋላታ ማዝሙረ የፃና መላ ኦስ። እስ ኮይረይ ግምብያ ሁጰሶራ ኡሻች ስሚድ፥ ፕቶ ፐንገ ባጋ ብስ። <verse eid="NEH 12:31"/><verse number="32" style="v" sid="NEH 12:32"/>ሆሻያነ ይሁዳ ሀላቃታፐ ባጋት ኤንታና ካልዶሶና። <verse eid="NEH 12:32"/><verse number="33" style="v" sid="NEH 12:33"/>ኤንታራ ደእያ ሀራት አዛራ፥ እዝራ፥ ማሱላማ፥ <verse eid="NEH 12:33"/><verse number="34" style="v" sid="NEH 12:34"/>ይሁዳ፥ ብንያመ፥ ሻማእያ፥ ኤርምያስነ <verse eid="NEH 12:34"/><verse number="35" style="v" sid="NEH 12:35"/>ሞይዘ ፑንያ ጉ ካህነት ካልዶሶና። ኤንታና ካልድ ይዳይ ዛካርያሳ፤ ዛካርያስ ዮናታና ናአ፤ ዮናታን ሻማአ ናአ፤ ሻማእ ማታና ናአ፤ ማታን ምካያ ናአ፤ ምካየይ ዛኩራ ናአ፤ ዛኩር አሳፋ ናአ። <verse eid="NEH 12:35"/><verse number="36" style="v" sid="NEH 12:36"/>ዛካርያሳ ያራ ግድዳ ሻማኤይ፥ አዛርኤል፥ ምላላ፥ ግላላይ፥ ማአየይ፥ ናትናኤል፥ ይሁድነ ሀናን ፆሳ አስ ግድዳ ዳዊቲ ዛማርያ ዎደ ጎኤትያ ማዝሙረ ሚሽያ ኡባ ኤክድ፥ ዛካርያሳ ካልዶሶና። ኤንታ ካለይ ፃፍያ እዝራ። <verse eid="NEH 12:36"/><verse number="37" style="v" sid="NEH 12:37"/>ፑልቶ ፐንግያ ጋክዳፐ ጉየ ዳዊታ ካታማኮ ስሚድ፥ ግምብያ ቦላ ከይድ፥ ዳዊታ ኬፈ ፑደ ባጋራ አድ፥ ዶሎሀ ባጋራ ደእያ ሃ ፐንግያኮ ብዶሶና።<verse eid="NEH 12:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 12:38"/>ናምአን ኮይረይ ግምብያ ሁጵያ ኦይክድ ሀድርስ ስሚድ ብስ። ታኒ አሳፐ ባጋራ ግዳዳ ኤንታፈ ጉየራ ካላስ። እቶነ አዱሳ ግምብያ አድ፥ ዳልጋ ግምብያ በሳ ጋክዳ። <verse eid="NEH 12:38"/><verse number="39" style="v" sid="NEH 12:39"/>ያፐ ስሚድ፥ ኤፍሬማ ፐንግያ፥ የሻና ፐንግያ፥ ሞሎ ፐንግያ፥ ሀናንኤላ አዱሳ ግምብያነ ፄታታ አዱሳ ግምብያ ጋካናዉ ብዳ። ዉርሰን ዶርሳ ፐንግያ ማታራ አድ ናገይሳታ ፐንግያ ጋክድ ኤቅዳ።<verse eid="NEH 12:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NEH 12:40"/>ጋላታ ማዝሙረ የፅያ ናምኡ ኮይረት ፆሳ ኬን ባንታ በሰ በሰ ኦይክዶሶና። ቃስ ታካ ታራ ደእያ ሀላቃታራ ያ ጋካስ። <verse eid="NEH 12:40"/><verse number="41" style="v" sid="NEH 12:41"/>ሄሳዳካ፥ ካህነት ኤልያቄም፥ ማእሰይ፥ ምንያምን፥ ምካየይ፥ ኤልዮአን፥ ዛካርያስነ ሀናን ባንታ ሞይዝያ ኦይክድ፥ <verse eid="NEH 12:41"/><verse number="42" style="v" sid="NEH 12:42"/>ማእሰይ፥ ሻማየይ፥ አላዛር፥ ኡዝ፥ የሆሀናን፥ ማልክየይ፥ ኤላምነ ኤፀር ባንታ በሳ በሳ ኦይክዶሶና። ይዝራ ኤንታ ካለን ባንታ ቃላ ቁ ኦድ ማዝሙረ የፅዶሶና።<verse eid="NEH 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="NEH 12:43"/>ሄ ጋላስ ዳሮ ያርሾ ያርሽዶሶና። ፆሳይ ኤንታዉ ግታ ኡፋይስ እምዳ ግሾ ዳሮ ኡፋይትዶሶና። ማጫሳይ ናይት ኡባይ ኡፋይትዶሶና። የሩሳላመን አሳይ ኡፋይትያ ኡፋይሳ ኮሽንቻይ ሃሆን ስኤቴስ።<verse eid="NEH 12:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NEH 12:44"/>ሄ ጋላስ አሳይ እምያ እሞታታ፥ አስራታነ ላይን ካፅያ ካ አይፍያፐ ኮይሩዋ ሺሽድ ዎያ ኬ ናግያ ሀላቃታ ዶርዶሶና። ሀ ዶረትዳ አሳት ዱማ ዱማ ካታማታን ደእያ ጎሻታፐ ህገይ ኪተይሳዳ ካህነታስነ ሌወታስ በሲያ ካ ሺሾሶና። አይስ ጊኮ፥ ይሁዳ አሳይ ካህነትነ ሌወት ኦያ ኦሱዋን ዳሮ ኡፋይትዶሶና። <verse eid="NEH 12:44"/><verse number="45" style="v" sid="NEH 12:45"/>ኤንቲ ፆሳይ ኪትዳይሳ ኦዶሶና፤ ጌሾ ዎጋ ፖልዶሶና። ኤንታ ፃላላ ግዶናሽን ዛማረትነ ናገይሳት ዳዊቲነ እያ ናኣ ሶሎሞነይ ኪትዳ ኦሱዋ ፖልዶሶና። <verse eid="NEH 12:45"/><verse number="46" style="v" sid="NEH 12:46"/>በን ዳዊታ ዎደነ አሳፋ ዎደ ዛማረትነ ፆሳስ ሺቅያ ጋላታ ማዝሙረታ ካለያ ሀላቃት ደኦሶና። <verse eid="NEH 12:46"/><verse number="47" style="v" sid="NEH 12:47"/>ዛሩባበላ ላይንነ ናህመ ላይን እስራኤለ አሳ ኡባይ ዛማረታስነ ናገይሳታስ በሲያ ካ ጋላስ ጋላስ እሞሶና። ሌወታስካ በሲያ ካ እሞሶና። ሌወት ቃስ አሮና ያራ ግድዳ ካህነታስ በሲያ ካ እሞሶና።<verse eid="NEH 12:47"/></para>
  <chapter eid="NEH 12"/>
  <chapter number="13" style="c" sid="NEH 13"/>
  <para style="s1">ናህመይ ኤህዳ ላመ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 13:1"/>ሄ ጋላስ አሳ ኡባይ ስእሽን፥ ሙሰ ማፃፋይ ናባበትስ፤ ሄ ዎደ ኤንቲ፥ “ሞአበ አሳይነ አሞነ አሳይ ፆሳ አሳራ መርናዉ ጋሄታናዉ በሰና” ግያ በሳ ማፃፋን ደምዶሶና። <verse eid="NEH 13:1"/><verse number="2" style="v" sid="NEH 13:2"/>አይስ ጊኮ፥ እስራኤለ አሳይ ግብፀፈ ከይድ፥ ካናነ ብያ ዎደ ሞአበነ አሞነ ቢታ አሳይ ኤንታዉ ካነ ሃ እምድ ሞካናይሳ አግድ፥ እስራኤለ አሳ ባዳና መላ ባላማስ ሚሸ እምድ ሻምዶሶና። ግዶሽን፥ ኑ ፆሳይ ባደ አንጆን ላምስ። <verse eid="NEH 13:2"/><verse number="3" style="v" sid="NEH 13:3"/>ሄ ህግያ እስራኤለ አሳይ ስእዳ ዎደ አላጋ አሳ ባንታ ግዶፈ ሻክዶሶና።<verse eid="NEH 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 13:4"/>ሄሳፈ ካሰ ፆሳ ኬ ሚሸታ ዎያ ኬስ ሀላቃ ግድዳ ካህነይ፥ ኤልያሴብ ፆባራ ዳቦተ መስ። <verse eid="NEH 13:4"/><verse number="5" style="v" sid="NEH 13:5"/>ሄሳፈ ጋሶን ኤልያሴብ፥ ካ እሞታታ፥ እፃነ፥ ፆሳ ኬ ጌሻ ሚሸታ፥ ካ ዎይንያነ ዛይትያ፥ ሌወታስ፥ ዛማረታስነ ናገይሳታስ እምያ አስራታነ ካህነታስ እምያ ካ ዎያ ዎጋ ክፍልያን ፆበይ ዳና መላ እሚስ።<verse eid="NEH 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 13:6"/>ሀ ኡባይ ሀንያ ዎደ ታ የሩሳላመን ደእከ። አርፀክስሰይ ባብሎነ ቢታን ካዎትዳ ሀስታማነ ናምአን ላይን ታኒ ስማዳ ባብሎነ ቢታ ካዋኮ ባስ። ግዶሽን፥ ጉ ዎደፐ ጉየ ካዋ ኦይቻዳ፥ <verse eid="NEH 13:6"/><verse number="7" style="v" sid="NEH 13:7"/>የሩሳላመ ስማዳ ያስ። ፆሳ ኬ ዛባን ኤልያሴብ ፆቢያስ ዳና ክፍለ ጊግስድ ዎዳ ኢታባ ስአስ። <verse eid="NEH 13:7"/><verse number="8" style="v" sid="NEH 13:8"/>ዳሮ ይሎታዳ፥ ፆቢያ ሶ ሚሸ ኡባ ክፍልያፐ ከሳዳ ካረ ሆላስ። <verse eid="NEH 13:8"/><verse number="9" style="v" sid="NEH 13:9"/>ክፍልያ ዎጋዳ ጌሻና መላ ኪታስ። ፆሳ ኬ ሚሸታ፥ ካ፥ እሞታታነ እፃንያ ዛራዳ ኬ ገልሳስ።<verse eid="NEH 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 13:10"/>ቃስ አሳይ ሌወታስ በሲያ ካ እምቦና ግሾ ሌወትነ ዛማረት ባንታ ፆሳ ኬ ኦሱዋ አግድ ጎሻስ ጉየ ብዳይሳ በአስ። <verse eid="NEH 13:10"/><verse number="11" style="v" sid="NEH 13:11"/>ሄሳ ግሾ፥ ታኒ ሀላቃታኮ፥ “ፆሳ ኬ ኦሱዋ አይስ የግ አግደቲ?” ያጋዳ ሀንቀታስ። ሄሳፈ ጉየ፥ ሌወታ ፄጋዳ ኡባ ኤንታ ኦሱዋን ኦሱዋን ዛራስ። <verse eid="NEH 13:11"/><verse number="12" style="v" sid="NEH 13:12"/>ያትን ይሁዳ አሳይ ካፈ፥ ዎይንያፐ፥ ዛይትያፐ እምያ አስራታ ዎያ ኬ ዛሪድ ኤሆ ዶምስ። <verse eid="NEH 13:12"/><verse number="13" style="v" sid="NEH 13:13"/>ታኒ ካህንያ ሳላማ፥ ፃፍያ ሳዶቃነ ሌውያ ፓዳያ ሚሸ ዎያ ኬስ ሀላቃ ኦዳ ሹማስ። ቃስ ማታና ናኣ ናኣ ዛኩራ ናአይ ሀናን ኤንታ ማደይሳ። ሀይሳቲ ኡባይ ኮሽያባ ኡባ ባንታ እሻታስ ሻክ ሻክ እሞን አማነትዳይሳታ ግድዶሶና።<verse eid="NEH 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 13:14"/>“ታ ፆሳዉ ታና ቆፓ፤ ቃስ ነ ኬ ኦሶይ ጊጋና መላ ታኒ ኦዳ ሎኦ ኦሱዋ ዶጎፓ” ያጋስ።<verse eid="NEH 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 13:15"/>ሄ ዎደ ታኒ ይሁዳን ደእያ አሳይ ሳምባታ ጋላስ ዎይነ ጉምእሽን በአስ፤ ሀራት ካ፥ ዎይነ ኡሻ፥ ዎይነ አይፍያ፥ ባላሰ አይፍያነ ሀራባታ ባንታ ሀረን ጫንድ፥ ሳምባታ ጋላስ የሩሳላመ ኤህሽን በአስ። ሄሳ ግሾ፥ ኤንቲ ሳምባታ ጋላሳ ዛልኦናዳ ታኒ ኤንታዉ ምንዳ ኦዳስ። <verse eid="NEH 13:15"/><verse number="16" style="v" sid="NEH 13:16"/>ሄሳ ቦላ ቃስ የሩሳላመን ደእያ ፅሮሳ አሳይ ሞሎነ ሀራ እስ እስ ዛልኤ ሚሸታ ኤህድ ሳምባታ ጋላስ ይሁዳ አሳስነ የሩሳላመን ባይዞሶና። <verse eid="NEH 13:16"/><verse number="17" style="v" sid="NEH 13:17"/>ታኒ ይሁዳ ሀላቃታ፥ “ሀይሳ መላ ኢታ ኦሶ ኦድ ሳምባታ አይስ ቱንሴቲ? <verse eid="NEH 13:17"/><verse number="18" style="v" sid="NEH 13:18"/>ፆሳይ ኑ ቦላነ ኑ ካታማ ቦላ ሀይሳ መላ መቶ ኤህዳይ፥ ካሰ ህንተ አዋት ሄሳ መላ ኢታባ ኦዳ ግሾ ግደኔ? ሀእ ህንተ ሳምባታ ቱንስድ፥ እስራኤለ አሳ ቦላ ሀራ ሀንቆ ኤሀናዉ ሀኔታ” ያጋዳ ሀንቀታስ።<verse eid="NEH 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 13:19"/>ሄሳፈ ጉየ፥ ሳምባት ገላናፐ ስን የሩሳላመ ግምብያ ፐንገት ጎርደታናዳነ ሳምባት አናሽን ዶየቶና መላ ኪታስ። ቃስ ሳምባታ ጋላሳን አይባ ቶሆይካ ገሎናዳ ናጋና መላ ታ ኦሳንቾታፐ እሶታ እሶታ ግምበ ፐንግያ ቦላ ኤሳስ። <verse eid="NEH 13:19"/><verse number="20" style="v" sid="NEH 13:20"/>ሄሳ ግሾ፥ ዱማ ዱማ ዛልኤ ሚሸታ ኤህያ ዛልአንቾት እስ ቶሆ ዎይኮ ናምኡ ቶሆ የሩሳላመ ግምብያፈ ካረ ባጋራ አቅዶሶና። <verse eid="NEH 13:20"/><verse number="21" style="v" sid="NEH 13:21"/>ሽን ታኒ ኤንታኮ፥ “ግምብያፈ ካረራ ዋናናዉ አቄቲ? ህንተ ናምአን ሀይሳዳ ኦኮ ታኒ ዎልቃን ህንተና ተቃና” ያጋዳ ሀንቀታስ። ሄ ጋላሳፐ ስምን ናምአን ሳምባታ ጋላስ ይቦኮና። <verse eid="NEH 13:21"/><verse number="22" style="v" sid="NEH 13:22"/>ታኒ ሌወት ባንታ ሁጵያ ጌሻና መላ፥ ፐንገታ ናጋና መላነ ሳምባታ ጋላሳ ጌሽ ኦና መላ ኪታስ።</para>
  <para style="p" vid="NEH 13:22">“ታ ፆሳዉ፥ ሀ ኡባ ግሾ ታና ቆፓ፤ ነ መርና ሲቁዋ ግሾ ታዉ ቃታ” ያጋዳ ዎሳስ።<verse eid="NEH 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NEH 13:23"/>ሄ ዎደ ታኒ ይሁዳ አደ አሳፐ እሶት እሶት አሽዶዳ፥ አሞነነ ሞአበ ቢታፈ ማቾ ኤክዳይሳ በአስ። <verse eid="NEH 13:23"/><verse number="24" style="v" sid="NEH 13:24"/>ኤንታ ናይታፐ ባጋይ አሽዶዳ ቢታ ዎይኮ ሀራ ቢታ ዶና ሃሳዮሶና፤ ባንታ ቢታ፥ ይሁዳ ዶና ኦደታናዉ ዳንዳኦኮና። <verse eid="NEH 13:24"/><verse number="25" style="v" sid="NEH 13:25"/>ታኒ ኤንታራ ኦየታስ፤ ኤንታ ባዳስ፤ ኤንታፈ እሶታ እሶታ ደቻዳ፥ ኤንታ ሁጵያ ብናና ሾዳስ። ሄሳ ፃላላ ግዶናሽን፥ ኤንቲ ባንታ ማጫ ናይታ ኤንታ አደ ናይታስ እሞናዳ፥ ኤንታ ማጫ ናይታ ባንታዉነ ባንታ አደ ናይታስ ኤኮናዳ ፆሳ ሱንን ጫቅሳስ። <verse eid="NEH 13:25"/><verse number="26" style="v" sid="NEH 13:26"/>ቃስ ኤንታኮ፥ “ካዎይ ሶሎሞነይ ናጋራ ኦዳይ አላጋ ቢታ ማጫሳታ ኤኮይሳና ግደኔ? ሶሎሞነ መላ ካዎይ ሀራ ቢታ ካዎታ ግዶን ባዋ፤ ፆሳይ እያ ዶስዳ ግሾ፥ እስራኤለ አሳ ኡባ ቦላ ካዎይስ። ሽን፥ ሀራ አቶሽን እያካ አላጋ ቢታ ማጫሳት ሀይሳ መላ ናጋራ ኦስስዶሶና። <verse eid="NEH 13:26"/><verse number="27" style="v" sid="NEH 13:27"/>ያትን፥ ኑካ ህንተና ስእድ፥ አላጋ ማጫሳ ኤክድ ሄሳ መላ ኢታባ ኦድ ፆሳ ናቃነዬ?” ያጋስ።<verse eid="NEH 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 13:28"/>ካህነ ሀላቃ ኤልያሴባ ናይታፐ እሶይ ዮያዳ። ሽን እያ ናይታፐ እሶይ ቤት-ሆሮና ካታማ አስ ግድዳ ሳንባላፃ ናእዉ ማቾ ኤክስ። ያትን፥ ታኒ ዮያዳ የሩሳላመ ካታማፐ ጎዳስ።<verse eid="NEH 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NEH 13:29"/>“ታ ፆሳዉ፥ ሀይሳቲ ካህነተ ዎጋነ ካህነታራነ ሌወታራ ጫቅዳ ጫቁዋ ዋት ቱንስዳኮ በአ” ያጋዳ ዎሳስ።<verse eid="NEH 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NEH 13:30"/>ኤንታ አላጋ ቢታ ቱናተፈ ጌሽዳፐ ጉየ ካህነታስነ ሌወታስ ኤንታ ኦሱዋ ኦሱዋ እማስ። <verse eid="NEH 13:30"/><verse number="31" style="v" sid="NEH 13:31"/>ያርሾስ ኤያ ምይ ዎደን ዎደን ያና መላነ አሳይ ባዉ አይፍዳባፐ ኮይሮ አይፍያ እሞታ ኦድ ኤሀና መላ ዎጋ ዎስ።</para>
  <para style="p" vid="NEH 13:31">“ታ ፆሳዉ፥ ነ ኬሀተን ታና ቆፓ” ያጋዳ ዎሳስ።<verse eid="NEH 13:31"/></para>
  <chapter eid="NEH 13"/>
</usx>
