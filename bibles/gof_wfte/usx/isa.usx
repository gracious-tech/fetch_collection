<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">እሳያሳ ማፃፋ</para>
  <para style="toc1">እሳያሳ ማፃፋ</para>
  <para style="toc3">እሳ</para>
  <para style="toc2">እሳያሳ</para>
  <para style="mt">እሳያሳ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሀ ማፃፋይ ክ.የ.ስ. 800 ፄቱ ላይ ሄራን የሩሳላመን ደእዳ፥ ባይራ ናበ ግድዳ እሳያሳ ሱንን ፄገቴስ። ሀ ማፃፋ፥ ሄ ግታ በሳን ሻክድ በአናዉ ዳንዳኤቴስ።</para>
  <para style="ipi">1. ሸምፖ 1—39 ጋካናዉ ደእያ ክፍለይ፥ ዎልቃማ ግድዳ አሶረይ፥ ይሁዳ ካዎተ ዋትድ ቆህዳኮ ኦዴስ። ይሁዳ ሄሳ መላ መቶን የግዳይ፥ አሶረ ካዎተ ምኖተ ግዶናሽን፥ አሳ ናጋራነ ፆሰ ኪተቶና እፁዋ። አሳይነ ኤንታ አይሰይሳት፥ ፅሎተነ ሱረ ፕርድ ኩምዳ ደኦኮ ስማና መላ ናበይ ቆንጨን ቆፍሴስ። ፆሰ ኪተተ እፆይ ጋማ ይስድ፥ ዮኮ ካለይሳ ኤራና መላ አኬክሴስ። እሳያስ ያና ላይን፥ አላምያ ፖሎ ሳሮተን አይስያ ዳዊታ ኮቸ ግድዳ ካዎይ ያናይሳ ስንትድ ኦድስ።</para>
  <para style="ipi">2. ሸምፖ 40-55 ጋካናዉ ደእያ ክፍለይ፥ ይሁዳ አሳይ ድኤትድ ባብሎነ ብዳ ዎደ፥ ኤንታ ዱሳይ ኩንድዳይሳነ ኤንቲ ኡፋይስ ቃንፅዳ ዎደታባ ኦዴስ። ናበይ፥ ፆሳይ ባ አሳ ላአ ከሳናይሳነ ኤንቲ ኦራ ዱስ ዶማና መላ ኤንታ የሩሳላመ ዛርያ ዎደይ ማትዳይሳ ኦድስ። ሀ ሸምፖታ ግዶን ዳሮ ከይድ በንትያ ካራ ቆፋይ፥ ፆሳይ ታርከ ጎዳ ግደይሳነ ካዎተታ ኡባስ ሀልችዳ ሀልቹዋ፥ እስራኤለ ባጋራ ፖላናዉ ደኤይሳ አኬክሴስ። ሀ ክፍልያን ናበይ ኦድዳ ሀራባይ፥ ኦይዱ ፆሳ አይልያ ማዝሙረታ (እሳ 42:1-4፤ 49:1-6፤ 50:4-9፤ 52:13—53:12)።</para>
  <para style="ipi">3. ሸምፖ 56-66 ጋካናዉ ደእያ ክፍለይ፥ ድኦፐ የሩሳላመ ስምዳ አሳይነ ፆሳይ እስራኤለ አሳስ ገልዳ ቃላይ ፖለታነኮ ጌሽድ ኤራናዉ ማላ ኮያ ደርያባ ኦይክስ። ኤንቲ ባይራይድ ኦና መላ ኮየትዳ ኦሶት ፅሎተ፥ ሱረ ፕርዳ፥ ሳምባታ ቦንቾ፥ ያርሾ ሺሾነ ቃንፆና ዎሳ።</para>
  <para style="ip">ሀ ክፍልያን ኤረትዳ ንባበይ ሸምፖ 61:1-2 ቦላ ደእያ ቃላ። እካ፥ “ኡባ ሃርያ ጎዳ አያናይ ታ ቦላ ደኤስ፤ ማንቆታስ ሎኦባ ኦዳና መላ ጎዳይ ታና ትይስ። ዎዛን መቅዳይሳታ ኮላና መላ፥ ድኤትዳይሳታ ላአ ከሳና መላነ ቃሸትዳይሳታ ብላና መላ ጎዳይ ታና ኪትስ” ያጌስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ፕርዳነ ሀንቆ ትንብተታ (<char style="ior"><ref loc="ISA 1:1-35:10">1:1—35:10</ref></char>)</para>
  <para style="io2">ይሁዳስነ እስራኤለስ ኦደትዳ ኪታታ (<char style="ior"><ref loc="ISA 1:1-5:30">1:1—5:30</ref></char>)</para>
  <para style="io2">እሳያሳ ኪቴተ (<char style="ior"><ref loc="ISA 6:1-13">6:1-13</ref></char>)</para>
  <para style="io2">ያና ክርስቶሳባ ኦደትዳ ትንብተታ (<char style="ior"><ref loc="ISA 7:1-12:6">7:1—12:6</ref></char>)</para>
  <para style="io2">አላጋ ካዎተታ ቦላ ኦደትዳ ትንብተታ (<char style="ior"><ref loc="ISA 13:1-23:18">13:1—23:18</ref></char>)</para>
  <para style="io2">መቶ ግዶን ደእያ አሳስ ኡፋይስ ደኤስ (<char style="ior"><ref loc="ISA 24:1-27:13">24:1—27:13</ref></char>)</para>
  <para style="io2">ማካላንቾት ፕርደታና (<char style="ior"><ref loc="ISA 28:1-35:10">28:1—35:10</ref></char>)</para>
  <para style="io1">ህዝቅያሳራ ጋሄትዳ ታርከ (<char style="ior"><ref loc="ISA 36:1-39:8">36:1—39:8</ref></char>)</para>
  <para style="io1">ፆሳይ ባ አሳ አሻናነ ዛራና (<char style="ior"><ref loc="ISA 40:1-48:22">40:1—48:22</ref></char>)</para>
  <para style="io1">ዋየ ኤካናዉ ደእያ አይልያ (<char style="ior"><ref loc="ISA 49:1-53:12">49:1—53:12</ref></char>)</para>
  <para style="io1">ፆሳይ ባ ጫቁዋ ናጌስ (<char style="ior"><ref loc="ISA 54:1-59:21">54:1—59:21</ref></char>)</para>
  <para style="io1">ስንፈ ያና የሩሳላመ ቦንቹዋ (<char style="ior"><ref loc="ISA 60:1-66:24">60:1—66:24</ref></char>)</para>
  <chapter number="1" style="c" sid="ISA 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1"/>ኦዝያን፥ እዮአታም፥ አካዝነ ህዝቅያስ ይሁዳን ካል ካልድ ካዎትዳ ዎደ አሞፀ ናአይ እሳያስ ይሁዳባነ የሩሳላመባ በእዳ ቆንጨይ ሀይሳ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 15:1-7">2 ካዎ 15:1-7</ref>፤ <ref loc="2KI 15:32-16:20">15:32—16:20</ref>፤ <ref loc="2KI 18:1-20">18:1-20</ref>፤ <ref loc="2CH 26:1-32:33">2 ታር 26:1—32:33</ref>.</char></note><verse eid="ISA 1:1"/></para>
  <para style="s1">ስኦና ደረ</para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 1:2"/>ሳሎቶ ስእተ፤ ሳአዉ ሀይዛ ስአ፤</para>
  <para style="q2" vid="ISA 1:2">ጎዳይ ሀይሳዳ ያጌስ፤</para>
  <para style="q1" vid="ISA 1:2">“ታ ናይታ የላዳ ድቻስ፤</para>
  <para style="q2" vid="ISA 1:2">ሽን ኤንቲ ታዉ ማካልዶሶና።<verse eid="ISA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 1:3"/>ቦር ባ ጎዳ ኤሬስ፤</para>
  <para style="q2" vid="ISA 1:3">ሀረይካ ባና ሃርዳይሳ ዛዳሉዋ ኤሬስ።</para>
  <para style="q1" vid="ISA 1:3">ሽን እስራኤለይ ኤረና፤</para>
  <para style="q2" vid="ISA 1:3">ታ አሳይ አኬከና።<verse eid="ISA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 1:4"/>ህንተኖ፥ ናጋራንቾ ካዎተቶ፥</para>
  <para style="q2" vid="ISA 1:4">ባላ ኦሶን ዴፅዳይሳቶ፥</para>
  <para style="q2" vid="ISA 1:4">ኢታ ኦያ የለተቶ፥</para>
  <para style="q2" vid="ISA 1:4">ቱና ኦሶስ እመትዳ ናይቶ፥</para>
  <para style="q1" vid="ISA 1:4">ጎዳ አግዳይሳቶ፥</para>
  <para style="q2" vid="ISA 1:4">ህንተና አየ!</para>
  <para style="q1" vid="ISA 1:4">እስራኤለ ጌሻ ካደታ፤</para>
  <para style="q2" vid="ISA 1:4">እያዉ ዞኮ ዛርደታ።<verse eid="ISA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 1:5"/>ማካላ ቦላ ማካላ አይስ ጉጄቲ?</para>
  <para style="q2" vid="ISA 1:5">አይስ ዛር ዛር ሾጨቴቲ?</para>
  <para style="q1" vid="ISA 1:5">ህንተ ሁጰይ ሀርገትስ፤</para>
  <para style="q2" vid="ISA 1:5">ህንተ ዎዛናይ ዳቡርስ።<verse eid="ISA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 1:6"/>ሁጰ ብናናፐ ቶሆ ፁጉን ጋካናዉ ፓያተ ባዋ፤</para>
  <para style="q2" vid="ISA 1:6">ማዱን፥ ክፅነ ስ ማእስ።</para>
  <para style="q1" vid="ISA 1:6">ኤንቲ ጊይቦኮና፥ ዎይኮ ሜጨትድ ቃሸትቦኮና</para>
  <para style="q2" vid="ISA 1:6">ዎይኮ ዛይተን ትየትድ ሎፅክቦኮና።<verse eid="ISA 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 1:7"/>“ህንተ ቢታይ ኦፅስ፤</para>
  <para style="q2" vid="ISA 1:7">ህንተ ካታማት ታማን ፁገትዶሶና።</para>
  <para style="q1" vid="ISA 1:7">ህንተ በእሽን ህንተ ጎሻ አላጋት ኤካና፤</para>
  <para style="q2" vid="ISA 1:7">እማ አሳት ህንተ ቢታ ቁኤ ከሳና።<verse eid="ISA 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 1:8"/>የሩሳላመይ ዎይነ ጋደን ደእያ ሻቃራዳ፥</para>
  <para style="q2" vid="ISA 1:8">ሌሄ ግዶን ደእያ ጋባዳነ</para>
  <para style="q2" vid="ISA 1:8">ሞርከን ተቀትዳ ካታማዳ ሀናዳ አታና።<verse eid="ISA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 1:9"/>ኡባፈ ዎልቃማ ጎዳይ ኑስ ጉ ኮቸ አሾናኮ</para>
  <para style="q2" vid="ISA 1:9">ኑኒ ሶዶመነ ጋሞራ ካታማዳ ሀናናሽን”<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="GEN 19:24">መ 19:24</ref>፤ <ref loc="ROM 9:29">ሮመ 9:29</ref>.</char></note> ያግስ።<verse eid="ISA 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 1:10"/>ህንተኖ፥ ሶዶመ ሀላቃቶ፥ ጎዳ ቃላ ስእተ!</para>
  <para style="q2" vid="ISA 1:10">ህንተኖ፥ ጋሞራ አሳዉ፥ ኑ ፆሳ ህግያ ስእተ!<verse eid="ISA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 1:11"/>“ህንተ ያርሾ ዳሮይ ታዉ አይ ኦ?</para>
  <para style="q2" vid="ISA 1:11">ሀኖ ጋካናዉ ህንተ ታዉ ሺሽዳ ኡርገ ዶርሳነ</para>
  <para style="q2" vid="ISA 1:11">ሞ መሄ ፁሳ ያርሾይ ታዉ ግዳና።</para>
  <para style="q1" vid="ISA 1:11">ታኒ ኮርማታ፥ ዶርሳ ኡርገታነ</para>
  <para style="q2" vid="ISA 1:11">ዴሻታ ሱን ኡፋይትከ።<verse eid="ISA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 1:12"/>ህንተ ታ ስንን በንታናዉ ያ ዎደ</para>
  <para style="q2" vid="ISA 1:12">ታ ኬ ዳባባ ህንተ የና መላ ኦነ ኦይችዳይ?<verse eid="ISA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 1:13"/>ሀዳ ያርሹዋ ኤሄይሳ አግተ!</para>
  <para style="q2" vid="ISA 1:13">ህንተ ጩይስያ እፃነይ ታና ሻቴስ።</para>
  <para style="q1" vid="ISA 1:13">አጌና ፄሮን ህንተ ቦንችያ ጋላሳ፥</para>
  <para style="q2" vid="ISA 1:13">ሳምባታነ ኢታተን ህንተ ሺቅያ ሺቁዋ ታኒ እፃይስ።<verse eid="ISA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 1:14"/>አጌና ፄሮን ህንተ ቦንችያ ጋላሳነ</para>
  <para style="q2" vid="ISA 1:14">ህንተ ባኣለ ጋላሳታ ታኒ እፃስ፤</para>
  <para style="q2" vid="ISA 1:14">ኤንቲ ታዉ ቶሆ ግድዶሶና፤</para>
  <para style="q2" vid="ISA 1:14">ታኒ ኤንታ ቶካናዉ ዳንዳእከ።<verse eid="ISA 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 1:15"/>ህንተ ኩሸ ምጭድ ታና ዎስያ ዎደ</para>
  <para style="q2" vid="ISA 1:15">ታኒ ታ አይፍያ ህንተፈ ገንና።</para>
  <para style="q1" vid="ISA 1:15">ህንተ ኩሸይ ሱን ኩምዳ ግሾ</para>
  <para style="q2" vid="ISA 1:15">ህንተ ዳርስ ዎስኮካ ታኒ ስእከ።<verse eid="ISA 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 1:16"/>ሜጨትተ፤ ህንተና ጌሽተ፤</para>
  <para style="q2" vid="ISA 1:16">ህንተ ኢታ ኦሱዋ ታ ስንፈ ድግተ፤</para>
  <para style="q2" vid="ISA 1:16">ገነ ሀኑዋ አግተ።<verse eid="ISA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 1:17"/>ሎኦባ ኦሶ ታማርተ፤</para>
  <para style="q2" vid="ISA 1:17">ፅሎ ፕርዳ ኮይተ።</para>
  <para style="q1" vid="ISA 1:17">ኡንኤትዳይሳታ አሽተ፤ ይኦታስ ኤቅተ፤</para>
  <para style="q2" vid="ISA 1:17">አምኤታስ ሞተትተ”</para>
  <para style="m" vid="ISA 1:17">ያጌስ ጎዳይ።<verse eid="ISA 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 1:18"/>“ሃይተ፤ አነ ዎል አማንስ። ህንተ ናጋራይ ባራ ቢታዳ ዞእኮካ፥ ሻቻዳ ቦፃና፤ ሱዳ ዞእኮካ ፑቶዳ ቦፃና። <verse eid="ISA 1:18"/><verse number="19" style="v" sid="ISA 1:19"/>ህንተ ኤሮ ግድ ታዉ ኪተትኮ ቢታ አንጁዋ ማና። <verse eid="ISA 1:19"/><verse number="20" style="v" sid="ISA 1:20"/>ሽን ህንተ እፃስ ግድ ማካልኮ፥ ማሻን ሜተታና” ያጌስ ጎዳይ ባ ዶናን።<verse eid="ISA 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 1:21"/>አማነትዳ ካታምያ ዋናዳ ላይማ ግዳዴ? ካሰ ሱረተነ ፅሎተ እ ግዶን ኩምስ፥ ሽን ሀእ ሸምፖ ዎይሳት እ ግዶን ደኤስ። <verse eid="ISA 1:21"/><verse number="22" style="v" sid="ISA 1:22"/>ነ ብራይ ባልትስ፤ ነ ማልኦ ዎይነይ ሃን የለትስ። <verse eid="ISA 1:22"/><verse number="23" style="v" sid="ISA 1:23"/>ህንተ ሀላቃት ማካላንቾታነ ካይሶ ላገ ግድዶሶና፤ ኤንቲ ኡባይ ዎፈ ዶሰይሳታነ ኩሸ ፄለይሳታ። ይኦታስ ሱረ ፕርዶኮና፤ አምኤታ ዋሱዋ ስኦኮና።<verse eid="ISA 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 1:24"/>ሄሳ ግሾ፥ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ እስራኤለ ዎልቃማይ፥ ሀይሳዳ ያጌስ፤ “ሀእ ታኒ ታ ሞርከታ ቦላ ታ ሀንቁዋ ጉሳና፤ ታራ ኤቀተይሳታ ሀሎ ከያና። <verse eid="ISA 1:24"/><verse number="25" style="v" sid="ISA 1:25"/>ታኒ ታ ኩሽያ ነ ቦላ ዛራና፤ ነ ባልተ ጌሻና፤ ነ ቱናተ ኡባ ኔፐ ድጋና። <verse eid="ISA 1:25"/><verse number="26" style="v" sid="ISA 1:26"/>ታኒ በንይሳዳ ነ ሀላቃታ፥ ኮይሮይሳዳ ነ ዞራንቾታ ደንና። ሄሳፈ ጉየ፥ ኔኒ አማነትዳ ቢታ፤ ፅሎተ ካታማ ጌተታና” ያጌስ።<verse eid="ISA 1:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ISA 1:27"/>ፅዮነይ ሱረ ፕርዳን፥ ባንታ ናጋራ ፓፀይሳትካ ፅሎተን ዎዘታና። <verse eid="ISA 1:27"/><verse number="28" style="v" sid="ISA 1:28"/>ሽን ማካላንቾትነ ናጋራንቾት እስፈ መቃና፤ ጎዳ አገይሳት ያና። <verse eid="ISA 1:28"/><verse number="29" style="v" sid="ISA 1:29"/>ህንተ ኡፋይትዳ ያርሾ ዎላን ዬላታና፤ ህንተ ዶርዳ ኮራን ካዉያና። <verse eid="ISA 1:29"/><verse number="30" style="v" sid="ISA 1:30"/>ህንተ ሀይ ቆቆፈትድ ዉርዳ ዎላዳነ ሃ ይዳ አታክልተ በሳዳ ግዳና። <verse eid="ISA 1:30"/><verse number="31" style="v" sid="ISA 1:31"/>ባና ምኖ ገይ ቡፃ ግዳና፤ እያ ኦሶይካ ፖልኡ ግድ ቶእያ ታማ ግዳና፤ ኤንቲ እስፈ ፁገታና፤ ሄ ታማ ቶይሳና አስ ባዋ።<verse eid="ISA 1:31"/></para>
  <chapter eid="ISA 1"/>
  <chapter number="2" style="c" sid="ISA 2"/>
  <para style="s1">ጎዳ ዙማ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1"/>አሞፀ ናአይ እሳያስ ይሁዳባነ የሩሳላመባ በእዳይስ ሀይሳ።<verse eid="ISA 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 2:2"/>ዉርሰ ጋላሳታን ጎዳ ኬይ ኬፀትዳ ዙማይ፥ ዙማታ ኡባፈ ቁ ግድ በንታና፤ ዙማ ኡባፈ ቦላራ ቁ ጋና። ካዎተት ኡባይ እያኮ ባና። <verse eid="ISA 2:2"/><verse number="3" style="v" sid="ISA 2:3"/>ህገይ ፅዮነፐ፥ ጎዳ ቃላይ የሩሳላመፐ ከይያ ግሾ፥ ዳሮ አሳይ ይድ፥ “አነ ሃይተ! ጎዳ ዙማኮ፥ ያይቆባ ፆሳ ኬኮ ከዮስ። ኑኒ እያ ኦግያን ባና መላ እ ኑና ባ ኦግያ ታማርሳና” ያጋና። <verse eid="ISA 2:3"/><verse number="4" style="v" sid="ISA 2:4"/>እ ካዎተታ ግዶን ፕርዳና፤ ዳሮ አሳታ ፓላማ ሻካና። ኤንቲ ባንታ ማሻ ማራሻ፥ ባንታ ቶራ ባጫ ከሳና። ካዎተት ካዎተታ ቦላ ማሻ ደንኮና፤ ህዛፐ ኤንቲ ኦላ ትምርተ ታማሮኮና።<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="JOL 3:10">እዩ 3:10</ref>.</char></note><verse eid="ISA 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 2:5"/>ህንተኖ፥ ያይቆባ ኮቻቶ፥ ሃይተ! አነ ጎዳ ፖኡዋን ሄመቶስ።<verse eid="ISA 2:5"/></para>
  <para style="s1">ጎዳ ጋላሳ</para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 2:6"/>ጎዳዉ፥ ነ አሳ፥ ያይቆባ ኮቻታ አጋዳሳ። ኤንቲ ዶሎሀ ባጋ አሳ ብታንነ ፍልስፄመ አሳ ሙሩኑዋን ኩምዶሶና፤ አላጋ አሳራ እስፍዶሶና። <verse eid="ISA 2:6"/><verse number="7" style="v" sid="ISA 2:7"/>ኤንታ ቢታን ብርነ ዎርቀይ ኩምስ፤ ኤንታ ሚሽያስ ዛው ባዋ። ኤንታ ቢታን ፓር ኩምስ፤ ኤንታ ፓራ ጋርያስ ዛው ባዋ። <verse eid="ISA 2:7"/><verse number="8" style="v" sid="ISA 2:8"/>ኤንታ ቢታን ኤቅ ኩምዶሶና፤ ኤንቲ ባንታ ኩሸ ኦሱዋ ጎይኖሶና።<verse eid="ISA 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 2:9"/>ሄሳ ግሾ፥ አሳ ኡባይ ቶሸታናነ ካዉያና። ኤንታ ናጋራ አቶ ጎፓ።<verse eid="ISA 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 2:10"/>ጎዳ ዳጋንዋፈነ ያሽያ ቦንቹዋፈ አታናዉ ዛላኮ ቢተ፤ ቢታ ግዶን ቆሰትተ! <verse eid="ISA 2:10"/><verse number="11" style="v" sid="ISA 2:11"/>ኦቶራንቾት ካዉያና፤ ጬቀተይሳት ጉፃና፤ ሄ ጋላስ ጎዳ ፃላል ቁ ቁ ጋና። <verse eid="ISA 2:11"/><verse number="12" style="v" sid="ISA 2:12"/>ኡባፈ ዎልቃማ ጎዳይ፥ እስ ጋላስ ኦቶራንቾታ፥ ጬቀተይሳታነ ባንታና ቁ ቁ ኦይሳታ ካዉሻና። <verse eid="ISA 2:12"/><verse number="13" style="v" sid="ISA 2:13"/>አዱሳ ልባኖሰ ዝጋታነ ባሳና ዎላ ኡባ ይሳና፤ <verse eid="ISA 2:13"/><verse number="14" style="v" sid="ISA 2:14"/>ቃ ደረታነ ዙማታ ደምባያና። <verse eid="ISA 2:14"/><verse number="15" style="v" sid="ISA 2:15"/>ካታማ ናግያ አዱሳ ሻኮታነ ምኖ ድርሳ ግምበታ ዝቅ ኦና። <verse eid="ISA 2:15"/><verse number="16" style="v" sid="ISA 2:16"/>ጎዳይ ግታነ ሎኦ ማርካበታ ሃን ምትሳና። <verse eid="ISA 2:16"/><verse number="17" style="v" sid="ISA 2:17"/>አሳ ኦቶሮይ ዝቅ ጋና፤ እያ ጬቀተይ ያና። ሄ ጋላስ ጎዳ ፃላል ቁ ቁ ጋና። <verse eid="ISA 2:17"/><verse number="18" style="v" sid="ISA 2:18"/>ኤቃ ኡባይ ፖሎ ያና።<verse eid="ISA 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 2:19"/>ጎዳይ ቢታ ቃናዉ ደንድያ ዎደ እያ ዳጋንዋፈነ እያ ያሽያ ቦንቹዋፈ አታናዉ አሳይ ሹቻ ጎንጎሎንነ ቢታ ኦላን ቆሰታና። <verse eid="ISA 2:19"/><verse number="20" style="v" sid="ISA 2:20"/>ሄ ጋላሳይ አሳይ ጎይናናዉ መዳ ባንታ ብራ ምስለታነ ባንታ ዎርቃ ምስለታ ግሮታስነ ሽርሽቆታስ የጋና። <verse eid="ISA 2:20"/><verse number="21" style="v" sid="ISA 2:21"/>ጎዳይ ቢታ ቃናዉ ደንድያ ዎደ እያ ዳጋንዋፈነ እያ ያሽያ ቦንቹዋፈ አታናዉ ኤንቲ ጎንጎሎ ግዶነ ሹቻ ዛኦ ግዶ ባቃታና።<verse eid="ISA 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 2:22"/>ህዛ ሸምፖይ ሲን ደእያ፥ ሀ ሀይቅያ አሳን አማነቶፍተ። አስ አይ ማዲ?<verse eid="ISA 2:22"/></para>
  <chapter eid="ISA 2"/>
  <chapter number="3" style="c" sid="ISA 3"/>
  <para style="s1">የሩሳላመነ ይሁዳ ፕርደተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 3:1"/>ሄኮ፥ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ ምንጃነ ማዶ ኡባ፥ ካ ምንጃነ ሃ ምንጃ ኡባ የሩሳላመፐነ ይሁዳፐ ድጋና። <verse eid="ISA 3:1"/><verse number="2" style="v" sid="ISA 3:2"/>ምኖታነ ኦላንቾታ፥ ዳይናነ ናብያ፥ ብተይሳነ ጭማ፥ <verse eid="ISA 3:2"/><verse number="3" style="v" sid="ISA 3:3"/>ቶራ ሞጮናነ ደርያ አይሰይሳ፥ ዞረይሳ፥ ሂላንቹዋነ ቃራ ማሮታ ኡባ ድጋና።<verse eid="ISA 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 3:4"/>ታኒ ዮጋ ናይታ ኤንታ ሀላቃ ኦና፤ ጉ ናይት ኤንታ ሃራና። <verse eid="ISA 3:4"/><verse number="5" style="v" sid="ISA 3:5"/>አሳይ አሳ ቦላ፥ ሾሮይ ሾሩዋ ቦላ ደንድድ፥ እሶይ እሱዋ ሱጋና። ናአተይ ጭማ ቦላ፥ ካትዳይስ ቦንቸትዳይሳ ቦላ ደንዳና።<verse eid="ISA 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 3:6"/>እስ አስ ባ አዋ ኬን ደእያ ባ እሻታፐ እሱዋ ኦይክድ፥ “ነዉ ማኦይ ደኤስ፤ ኔኒ ኑስ ሀላቃ ግዳ፤ ሀ ላለትዳ በሳ አዋተን ኤካ” ያጋና።<verse eid="ISA 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 3:7"/>ሄ ጋላስ፥ እ ባ ቃላ ቁ ኦድ፥ “ታኒ ማድከ፤ ታ ሶን ካ ዎይኮ ማኦይ ባዋ፤ ህንተ ቦላ ታና ሹሞፕተ” ያጋና።<verse eid="ISA 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 3:8"/>የሩሳላመይ ጋንድጋራሱ፤ ይሁድ ኩንዳናዉ ማታሱ፤ ኤንቲ ባንታ ኦዳንነ ባንታ ኦሱዋን ጎዳ ቦላ ደንድድ፥ እያ ቦንቹዋ ቶችዶሶና። <verse eid="ISA 3:8"/><verse number="9" style="v" sid="ISA 3:9"/>ኤንታ ሶምኦይ ኤንታ ቦላ ማርካቴስ፤ ኤንቲ ባንታ ናጋራ ሶዶመ አሳ መላ አዋጆሶና፤ ባንታ ናጋራ ቆቶኮና። ኤንቲ ባንታ ቦላ ዮ ኤህዳ ግሾ ኤንታ አየ!<verse eid="ISA 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 3:10"/>ኤንቲ ባንታ ኦሱዋ አይፍያ ማና ግሾ፥ ፅሎታስ ሎኦ ግዳና ጋዳ ኦዳ። <verse eid="ISA 3:10"/><verse number="11" style="v" sid="ISA 3:11"/>ኤንቲ ባንታ ኩሸ ኦሱዋ ጋትያ ኤካና ግሾነ ዮይ ኤንታ ቦላ ይዳ ግሾ ኢታታ አየ! <verse eid="ISA 3:11"/><verse number="12" style="v" sid="ISA 3:12"/>ናአተት ታ አሳ ኡንኤሶና፤ ማጫሳት ኤንታ ሃሮሶና። ታ አሳዉ፥ ህንተና ካለይሳት ባለሶና፤ ህንተ ብያ ኦግያፐ ካረ ከሶሶና።<verse eid="ISA 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 3:13"/>ጎዳይ ባ አራታን ኡትስ፤ አሳ ቦላ ፕርዳናዉ ጊገትስ። <verse eid="ISA 3:13"/><verse number="14" style="v" sid="ISA 3:14"/>ጎዳይ ደርያ ጭማታነ ካለይሳታ ፕርዳናዉ ሺሽድ፥ “ታ ዎይነ ጋድያ ይስዳይ ህንተና፤ ማንቆታፐ ቦንቅዳይስ ህንተ ሶን ደኤስ። <verse eid="ISA 3:14"/><verse number="15" style="v" sid="ISA 3:15"/>ህንተ ታ አሳ አይስ ትንቸረቲ? ማንቆታ ሶምኡዋ አይስ ካሬቲ?” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ISA 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 3:16"/>ጎዳይ፥ “ፅዮነ ማጫሳት ኦቶርትዶሶና፤ ባንታ ቆያ አዱስድ፥ ባንታ አይፍያን ቃምኦቶሶና፤ ባንታ ሄመ ላምድ፥ ባንታ ቶሆ አልቡዋ ጊርስሸ ሄመቶሶና። <verse eid="ISA 3:16"/><verse number="17" style="v" sid="ISA 3:17"/>ሄሳ ግሾ፥ ጎዳይ ፅዮነ ማጫሳ ሁጵያ ሳን ኩንና፤ ጎዳይ ኤንታ ሁጵያ ቦአያና” ያጌስ።<verse eid="ISA 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18"/>ሄ ጋላስ ጎዳይ ፅዮነ ማጫሳ አሌቆታ፥ ሄስካ፥ ቶሆ አልቡዋ፥ ሻሽያ፥ ቆ ዎርቃ፥ <verse eid="ISA 3:18"/><verse number="19" style="v" sid="ISA 3:19"/>ሀይ ዎርቃ፥ ኩሸ አምባረ፥ ሶምኦ ካማ፥ <verse eid="ISA 3:19"/><verse number="20" style="v" sid="ISA 3:20"/>ሁጰ ካማ፥ ቀሰ ሳንላታ፥ ዳንጩዋ፥ ሽቱዋ፥ ጎዝዳ፥ <verse eid="ISA 3:20"/><verse number="21" style="v" sid="ISA 3:21"/>ሲ ዎርቃ፥ ብራ ምግዱዋ፥ <verse eid="ISA 3:21"/><verse number="22" style="v" sid="ISA 3:22"/>ኮይሰ ማኡዋ፥ አዱሳ ማኡዋ፥ ካባ፥ ቦርሳ፥ <verse eid="ISA 3:22"/><verse number="23" style="v" sid="ISA 3:23"/>ማስቶትያ፥ ሊኑዋ፥ ሁጰ አሌቆታ፥ ሻርብያ ኡባ ኤንታፈ ኤካና።<verse eid="ISA 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 3:24"/>ሽቶ ግሾ ፅንቆ፥ ዳንጮ ግሾ ዎዶሮ፥ ጎፋረ ግሾ ቦአ፥ ኮይሰ ማኦ ግሾ ካዮ ማኦ፥ ሎኦተ ግሾ ቤታ ግዳና።<verse eid="ISA 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 3:25"/>ነ አሳት ማሻን፥ ነ ኦላንቾት ኦላን ሀይቃና። <verse eid="ISA 3:25"/><verse number="26" style="v" sid="ISA 3:26"/>ፅዮነ ፐንገት ዬካናነ ዘሌላና፤ ካዮታዳ ሳአን ኡትዳ ማጫሳዳ ሀናና።<verse eid="ISA 3:26"/></para>
  <chapter eid="ISA 3"/>
  <chapter number="4" style="c" sid="ISA 4"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 4:1"/>ሄ ጋላስ ላፑን ማጫሳት እስ አደ ኦይክድ፥ “ኑኒ ኑ ካ ማና፤ ኑ ማኦ ማአና። ነ ሱንን ፄገታና መላ ኦዳ ኑ ካዉሻ ኑፐ ድጋርኪ?” ያግድ ዎሳና።<verse eid="ISA 4:1"/></para>
  <para style="s1">ፆሳ ም ታሸ</para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2"/>ሄ ዎደ ጎዳ ታሸይ፥ ሎአናነ ቦንቸታና፤ አትዳ እስራኤለ አሳስ ቢታ ካይ ጬቆነ ቦንቾ ግዳና። <verse eid="ISA 4:2"/><verse number="3" style="v" sid="ISA 4:3"/>ፅዮነን አትዳይሳት፥ የሩሳላመን ዮፐ ከስ ኤክዳይሳትነ ደኦስ ፃፈትዳይሳት ጌሻታ ጌተታና። <verse eid="ISA 4:3"/><verse number="4" style="v" sid="ISA 4:4"/>ጎዳይ ፅዮነ ማጫሳ ቅታ ሜጫና፤ ባ ፕርዳንነ ባ አያና ታማን ሱ ጉሶ የሩሳላመፐ ድጋና። <verse eid="ISA 4:4"/><verse number="5" style="v" sid="ISA 4:5"/>ጎዳይ ፅዮነ ዙማ ቦላነ ያን ሺቅያ ኡባ ቦላ ጋላስ ሻራ ጩያነ ቃማ ታማ ላጮ መና፤ እያ ቦንቾ ኡባ ቦላ ካማ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="EXO 13:21">ከሳ 13:21</ref>፤ <ref loc="EXO 24:16">24:16</ref>.</char></note> <verse eid="ISA 4:5"/><verse number="6" style="v" sid="ISA 4:6"/>እ፥ ጋላሳ ምሻፐ አሽያ ኩያነ ኡሾፐነ እራፐ ቆሰትያ በሰ ግዳና።<verse eid="ISA 4:6"/></para>
  <chapter eid="ISA 4"/>
  <chapter number="5" style="c" sid="ISA 5"/>
  <para style="s1">ዎይነ ጋደ ሌምሶ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 5:1"/>ታ ዶስያ አድያ ዎይነ ጋድያባ፥</para>
  <para style="q2" vid="ISA 5:1">ሲቆ የ የፃና።</para>
  <para style="q1" vid="ISA 5:1">ታኒ ዶስያ አድያስ፥</para>
  <para style="q2" vid="ISA 5:1">አራዳ ዙማ ቦላ እያዉ ዎይነ ጋደይ ደኤስ።<verse eid="ISA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2"/>ቢታ ቦክድ፥ ሹቻ ቆር ከስድ፥</para>
  <para style="q2" vid="ISA 5:2">ሎኦ ዎይነ ቶክስ።</para>
  <para style="q1" vid="ISA 5:2">ናጎ ሻኮ እያ ግዶን ሻክስ፤</para>
  <para style="q2" vid="ISA 5:2">ዎይንያ ጉምእያ በሳ ጊግስስ።</para>
  <para style="q1" vid="ISA 5:2">ሄሳፈ ጉየ፥ ሎኦ አይፈ አይፋና ግድ ናግስ፤</para>
  <para style="q2" vid="ISA 5:2">ሽን ጫላ አይፈ አይፍስ።<verse eid="ISA 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3"/>“ህንተኖ፥ የሩሳላመን ደኤይሳቶ፥</para>
  <para style="q2" vid="ISA 5:3">ህንተኖ ይሁዳ አሳዉ፥</para>
  <para style="q2" vid="ISA 5:3">ታፐነ ታ ዎይነ ጋድያ ግዶን</para>
  <para style="q2" vid="ISA 5:3">ደእያ ኦዳ አነ ፕርድተ።<verse eid="ISA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4"/>ታኒ ታ ዎይነ ጋድያስ ኦዳይሳፈ</para>
  <para style="q2" vid="ISA 5:4">ሀራ አይ ኦናባይ አትዴ?</para>
  <para style="q1" vid="ISA 5:4">ሎኦ አይፈ አይፋና ጋዳ ናጋስ፥</para>
  <para style="q2" vid="ISA 5:4">ሽን አይስ ጫላ አይፈ አይፍዴ?<verse eid="ISA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5"/>ሀእ ታኒ ታ ዎይነ ጋድያ ቦላ</para>
  <para style="q2" vid="ISA 5:5">ኦናባ ህንተዉ ኦዳና።</para>
  <para style="q1" vid="ISA 5:5">ታኒ እያ ድርሳ ድጋና፤</para>
  <para style="q2" vid="ISA 5:5">ዎይነይ ያናዳ ኦና።</para>
  <para style="q1" vid="ISA 5:5">ታኒ ግምብያ ላላና፤</para>
  <para style="q2" vid="ISA 5:5">ዎይነ ጋደይ የታና።<verse eid="ISA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6"/>ታኒ ሄ ጋድያ ቁኤ ኦና፤</para>
  <para style="q2" vid="ISA 5:6">ዎይነይ ፅንተተና፥ ሀርመተና።</para>
  <para style="q1" vid="ISA 5:6">ሄ በሳን ክንቾተይነ አጉን ዶላና፤</para>
  <para style="q2" vid="ISA 5:6">እር እያ ቦላ ቡኮና መላ</para>
  <para style="q2" vid="ISA 5:6">ታኒ ሻራ ኪታና” ያግስ።<verse eid="ISA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7"/>ኡባፈ ዎልቃማ ጎዳ</para>
  <para style="q2" vid="ISA 5:7">ዎይነ ጋደይ እስራኤለ አሳ።</para>
  <para style="q2" vid="ISA 5:7">እ፥ ኡፋይትያ አታክልተ በሳይ ይሁዳ አሳ።</para>
  <para style="q1" vid="ISA 5:7">ኤንታ ሱረ ፕርዶሶና ግድ ናግስ፤</para>
  <para style="q2" vid="ISA 5:7">ሽን ሱ ጉስዶሶና።</para>
  <para style="q1" vid="ISA 5:7">ፅሎተ ኦሶና ግድ ናግስ፤</para>
  <para style="q2" vid="ISA 5:7">ሽን ኡንአ ዋሶይ ዳራና መላ ኦዶሶና።<verse eid="ISA 5:7"/></para>
  <para style="s1">ኢታታ አየ!</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 5:8"/>በሲ ይን፥ ህንተ ፃላላ ቢታ ቦላ ዳና ጋካናዉ፥</para>
  <para style="q2" vid="ISA 5:8">ኬ ኬ ቦላ፥ ጋደ ጋደ ቦላ፥</para>
  <para style="q2" vid="ISA 5:8">ጉጀይሳቶ ህንተና አየ!<verse eid="ISA 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 5:9"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ግድ ጫቅሽን ታ ስአስ።</para>
  <para style="q1" vid="ISA 5:9">“ሄ ግታ ኬት ካይሳታና፤</para>
  <para style="q2" vid="ISA 5:9">ሄ ሎኦ ኬታን ዳናዉ አስ ያና።<verse eid="ISA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 5:10"/>ታሙ ዋፃን ቶክዳ ዎይንያፐ፥</para>
  <para style="q2" vid="ISA 5:10">እስ ኦቶ ጉምኤ ዎይነ ፃላላ ኤካና።</para>
  <para style="q1" vid="ISA 5:10">ሆስፑን ታሙ ክሎ ግራመ ዘርዳ ጋደፐ፥</para>
  <para style="q2" vid="ISA 5:10">ታማነ ሆስፑን ክሎ ግራመ ፃላላ ኤካና” ያግስ።<verse eid="ISA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 5:11"/>ማያ ኡሻ ኮያናዉ</para>
  <para style="q2" vid="ISA 5:11">ዎንታ ጉራ ደንደይሳታነ</para>
  <para style="q2" vid="ISA 5:11">ዎይነ ኡሻይ ፁጋና ጋካናዉ፥</para>
  <para style="q2" vid="ISA 5:11">ያን ቃምስያ አሳ አየ!<verse eid="ISA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 5:12"/>ኤንታ እማቱዋን ማስንቆይ፥</para>
  <para style="q2" vid="ISA 5:12">ዲ፥ ካራቦይ፥ ሱሱልኤይነ</para>
  <para style="q2" vid="ISA 5:12">ዎይነ ኡሽ ደኤስ።</para>
  <para style="q1" vid="ISA 5:12">ሽን ኤንቲ ጎዳ ኦሱዋ በእቦኮና፤</para>
  <para style="q2" vid="ISA 5:12">እያ ኩሸ ኦሱዋ አኬኮኮና።<verse eid="ISA 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 5:13"/>ህዛ ታ አሳይ አኬካ ይዳ ግሾ፥ ድኤታና፤</para>
  <para style="q2" vid="ISA 5:13">አይሰይሳት ኮሻን ሀይቃና፤ አሳይ ሳሞን ፁገታና።<verse eid="ISA 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 5:14"/>ዱፎይ ባ ጎምፓ ዳልግስስ፤</para>
  <para style="q2" vid="ISA 5:14">ባ ዶና ዛው ባይና ዶይስ።</para>
  <para style="q1" vid="ISA 5:14">የሩሳላመን ደእያ ግታ አሳ፥ ዳሮ አሳ፥</para>
  <para style="q2" vid="ISA 5:14">ዎጫመይሳታነ ኡፋይተይሳታ ምታና።<verse eid="ISA 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 5:15"/>አስ ቶሸታና፤ አሳ ኮቸ ኡባይ ካዉያና፤ ኦቶርትያ ኡባይ ጉፃና። <verse eid="ISA 5:15"/><verse number="16" style="v" sid="ISA 5:16"/>ሽን ኡባፈ ዎልቃማ ጎዳይ፥ ባ ሱረ ፕርዳን ቁ ቁ ጋና፤ ፆሳ ጌሻተይ እያ ፅሎተን ቆንጫና። <verse eid="ISA 5:16"/><verse number="17" style="v" sid="ISA 5:17"/>ሄ ዎደ ዶርሳት ሄ በሳን ሄመታና፤ ዶርሳ ኡርገት ላለትዳ ኬ በሳታን ማና።<verse eid="ISA 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 5:18"/>ጭሞ ዎዶሮን ናጋራ፥ ጋረ ዎዶሮን ኢታተ ጎቸይሳታ አየ! <verse eid="ISA 5:18"/><verse number="19" style="v" sid="ISA 5:19"/>“አነ ፆሳይ ኤለሶ! ኑኒ በአና መላ ባ ኦሱዋ ኤሶዮ! ኑኒ ኤራና መላ እስራኤለ ጌሻይ ቆፕዳ ቆፋ ፖሎ” ያገይሳታ አየ!<verse eid="ISA 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 5:20"/>ኢታ ሎኦ፥ ሎኡዋ ኢታ፤ ማ ፖኦ፥ ፖኡዋ ማ፤ ጫሙዋ ማልኦ፥ ማልኡዋ ጫሞ ገይሳታ አየ!<verse eid="ISA 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 5:21"/>ባንታና ጭንጫነ ቃራ ገይሳታ አየ!<verse eid="ISA 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 5:22"/>ዎይነ ኡሻን ኤረትዳ አሳነ ማይያ ኡሹ ዋላካናዉ ዎዛን ምኖ ግድዳ አሳ አየ! <verse eid="ISA 5:22"/><verse number="23" style="v" sid="ISA 5:23"/>ቆህዳ ኡራ ፅልሳናዉ ዎፈ ኤክድ፥ ፅሎ አሳ ሱረ ፕርዳ ጌላየይሳታ አየ! <verse eid="ISA 5:23"/><verse number="24" style="v" sid="ISA 5:24"/>ኤንቲ ኡባፈ ዎልቃማ ጎዳ ህግያ እፅዳ ግሾነ እስራኤለ ጌሻ ቃላ ካዳ ግሾ ታማ ላጮይ ካለ ኦይከይሳዳነ ቡረይ ታማን ሜተትድ የይሳዳ ኤንታ ፃጶይ ዎቃና። ኤንታ ጪሻይ ባናዳ ላለትድ ያና። <verse eid="ISA 5:24"/><verse number="25" style="v" sid="ISA 5:25"/>ሄሳ ግሾ፥ ጎዳ ሀንቆይ እያ አሳ ቦላ ኤፅስ፤ እያ ኩሸይ ደንድድ፥ ኤንታ ይስስ። ደረት ቃፅዶሶና፤ ሀይቅዳ አሳ አሀይ ኦገ ቦላ ቡረዳ ሀንስ። ሄ ኡባንካ እያ ሀንቆይ ስምቤና፤ እያ ኩሸይ ሀእካ ደንድዳ በሳን ደኤስ።<verse eid="ISA 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ISA 5:26"/>ጎዳይ ሃሆ ሶን ደእያ ካዎተታስ ማላ ቃን ኤስስ፤ ሳኣ ጋፃን ደእያ አሳ ሱይቅድ ፄግስ፤ ኤንቲ ድርግሸ ፑቱ ጎሶና። <verse eid="ISA 5:26"/><verse number="27" style="v" sid="ISA 5:27"/>ኤንታ ግዶን ዳቡረይነ በተይ ባዋ፤ ኤንታፈ እሶይካ ስከና ዎይኮ ዝንኤና። ፄሳን ዳንጭዳ ሳቀይ ብርሸተና፤ ኤንታ ጫማ ዎዶሮይ ዱፀና። <verse eid="ISA 5:27"/><verse number="28" style="v" sid="ISA 5:28"/>ኤንታ ቶራይ ቃራ፤ ኤንታ ዶንገይካ ዋፀትድ ደኤስ። ኤንታ ፓራታ ቶሆይ ቃራ ሹቻ መላ፤ ኤንታ ፓራ ጋረታ ገርቶይ ጎተ መላ። <verse eid="ISA 5:28"/><verse number="29" style="v" sid="ISA 5:29"/>ኤንቲ ጋሞ መላ ጉሞሶና፤ ዎዳላ ጋሞ መላ ጉዶሶና። ኤንቲ ሳርቡቅሸ ምያባ ኦይክድ፥ ቶክ ኤክድ ቦሶና፤ ኤንታፈ ዎድ ኤከይ ኦንካ ባዋ።<verse eid="ISA 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 5:30"/>ሄ ዎደ ኤንቲ ግታ አባ ጉንዳ እስራኤለ ቦላ ጉማና። እስ አስ ሄ ቢታ ፄልያ ዎደ ምነ ዋየይ በአና፤ ፖኦይ ሻራን ምተታና።<verse eid="ISA 5:30"/></para>
  <chapter eid="ISA 5"/>
  <chapter number="6" style="c" sid="ISA 6"/>
  <para style="s1">እሳያሳ ፄገተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1"/>ካዎይ ኦዝያን ሀይቅዳ ላይ ጎዳይ ቃ አራታንነ ቦንቾ በሳን ኡትዳይሳ በአስ፤ እያ ማኦይ ፆሳ ኬ ኩምስ።<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="2KI 15:7">2 ካዎ 15:7</ref>፤ <ref loc="2CH 26:23">2 ታር 26:23</ref>.</char></note> <verse eid="ISA 6:1"/><verse number="2" style="v" sid="ISA 6:2"/>ሱራፌላ ጌተትያ ኪታንቾት እያፐ ቦላራ ደኦሶና፤ እስ እስ ኪታንቹዋስ ኡሱፑን ቀፈት ደኦሶና፤ ናምኡ ቀፈታን ባ ሶምኡዋ ካሜስ፤ ናምኡ ቀፈታን ባ ቶሁዋ ካሜስ፤ ናምኡ ቀፈታን ፕራስ። <verse eid="ISA 6:2"/><verse number="3" style="v" sid="ISA 6:3"/>ኤንቲ እሶይ እሱዋኮ፥ “ጌሻይ፥ ጌሻይ፥ ጌሻይ፥ ኡባፈ ዎልቃማ ጎዳ! ሳአ ኡባይ እያ ቦንቹዋን ኩምስ”<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="REV 4:8">ቆን 4:8</ref>.</char></note> ያጎሶና። <verse eid="ISA 6:3"/><verse number="4" style="v" sid="ISA 6:4"/>ኤንታ ግርሳ ዋሱዋ ጋሶን ፆሳ ኬ ባሶይ ቃፅስ፤ ፆሳ ኬይ ጩያን ኩምስ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="REV 15:8">ቆን 15:8</ref>.</char></note><verse eid="ISA 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 6:5"/>ያትን፥ “ታኒ መተርሻይ ቱንዳ አሳ ግዶን ደአይስ፤ ታ መተርሻይካ ቱና። ታኒ ካዋ፥ ኡባፈ ዎልቃማ ጎዳ ታ አይፈን በእዳ ግሾ፥ ታና አየ! ታ ያስ!” ያጋስ።<verse eid="ISA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6"/>ሄ ኪታንቾታፐ እሶይ ያርሾ በሳፈ ቦንቆ ታማ ቃጰራ ኤክድ ፕራሸ ታኮ ይስ። <verse eid="ISA 6:6"/><verse number="7" style="v" sid="ISA 6:7"/>ቦንቆ ታማን ታ መተርሻ ቦችድ፥ “ሄኮ፤ ሀ ቦንቆ ታማይ ነ መተርሻይ ቦችዳ ግሾ ነ ናቆይ ኔፐ ክችስ፤ ነ ናጋራይ አቶ ጌተትስ” ያግስ።<verse eid="ISA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8"/>ሄሳፈ ጉየ ጎዳይ፥ “ኦና ኪቶ? ኑስ ኦነ ባናይ?” ያግሽን ስአስ። ታኒ፥ “ሄኮ፥ ታና ኪታ፥ ታኒ ባና” ያጋስ።<verse eid="ISA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9"/>ጎዳይ ታኮ፥ “ባዳ ሀ አሳ፥ ‘ህንተ ስስ ስኤታ፥ ሽን አኬከከታ፤ ህንተ ፄለታ፥ ሽን ደመከታ’ ” ያጋዳ ኦዳ። <verse eid="ISA 6:9"/><verse number="10" style="v" sid="ISA 6:10"/>ካልድካ፥ “ሀ አሳ ዎዛና ሙምሳ፤ ኤንታ ሀይ ቱልሳ፤ ኤንታ አይፍያ ጎዛ። ሄስ ሀኖና እፅኮ፥ ኤንቲ ባንታ አይፍያን በእድ፥ ባንታ ሀይን ስእድ፥ ባንታ ዎዛናን አኬክድ፥ ታኮ ስማና፤ ዛሪድ ፓፃና”<note caller="-" style="x"><char style="xo" closed="false">6:10 </char><char style="xt" closed="false"><ref loc="MAT 13:14-15">ማቶ 13:14-15</ref>፤ <ref loc="MRK 4:12">ማር 4:12</ref>፤ <ref loc="LUK 8:10">ሉቃ 8:10</ref>፤ <ref loc="JHN 12:40">ዮሀ 12:40</ref>፤ <ref loc="ACT 28:26-27">ሀዋ 28:26-27</ref>.</char></note> ያግስ።<verse eid="ISA 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11"/>ታኒ፥ “አቤት ጎዳዉ፥ ሄስ ሀናናይ አዉደ ጋካናሴ?” ያጋስ።</para>
  <para style="p" vid="ISA 6:11">እ ዛሪድ፥ “ካታማት ላለታና ጋካናዉ፥ ኬት ካይሳ ግዳና ጋካናዉ፥ ቢታይ ፖሎ ዶገታና ጋካናዉ፤ <verse eid="ISA 6:11"/><verse number="12" style="v" sid="ISA 6:12"/>አሳ ሃሆ በሲ የዳና ጋካናዉነ ቢታይ አስ ባይና መላ ቢታ ግዳና ጋካናሳ። <verse eid="ISA 6:12"/><verse number="13" style="v" sid="ISA 6:13"/>ታሙ አሳፐ እስ አስ ቢታ ቦላ አትኮ፥ እካ ያና። ቃንፅን አትዳ ዎላነ ጫጫ ዱሩማ መላ ግዳና፤ ሄ ዱሩማይ ጌሻ ኮቸ ግዳና” ያግስ።<verse eid="ISA 6:13"/></para>
  <chapter eid="ISA 6"/>
  <chapter number="7" style="c" sid="ISA 7"/>
  <para style="s1">አማኑኤላ ማላ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1"/>ኦዝያና ናአይ እዮአታማ ናአይ አካዝ፥ ይሁዳን ካዎትዳ ዎደ አራመ ካዎይ ራዝንነ እስራኤለ ካዎይ ራማላ ናአይ ፋቁሄይ የሩሳላመ ኦላናዉ ይዶሶና፤ ሽን ፆናናዉ ዳንዳእቦኮና።<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="2KI 16:5">2 ካዎ 16:5</ref>፤ <ref loc="2CH 28:5-6">2 ታር 28:5-6</ref>.</char></note><verse eid="ISA 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2"/>አራመ ቢታይ ኤፍሬማ ቢታራ እስፈ ኦላስ ጫቅዳይሳ ይሁዳ ካዎይ ስእዳ ዎደ፥ ዎራን ደእያ ም ጫርኮይ ቃይሳዳ፥ አካዛ ዎዛናይነ አሳ ዎዛናይ ዳጋማን ቃፅስ።<verse eid="ISA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3"/>ጎዳይ እሳያሳኮ፥ “ኔራነ ነ ናኣ ሼር-ያሱባራ<note caller="+" style="f"><char style="fr" closed="false">7:3 </char><char style="fq" closed="false">ሼር-ያሱባ፦ </char><char style="ft" closed="false">ሀ ሱን ብርሸይ “ጉት ስማና” ጉሱ (እሳ 10:20-22)።</char></note> አካዛራ ጋሄታናዉ ቢተ፤ ህንተ እያ ማኦ ሜጭያ ጎሻኮ ኤፍያ ኦግያ ማታን ቆሞ ባጋን ደእያ ሃ ኦላ ዉርሰን ህንተ እያ ደማና። <verse eid="ISA 7:3"/><verse number="4" style="v" sid="ISA 7:4"/>እያዉ ሀይሳዳ ያጋዳ ኦዳ፤ ‘ናገታ፤ ዎፑ ጋ፤ ያዮፋ። ሀ ናምኡ ካዎት ታማፐ አትድ ጩያ ዱሩማ መላ ግድያ ግሾ፥ አራመ ካዋ ራዝናነ ራማላ ናኣ ሀንቁዋስ ያዮፋ፤ ነ ዎዛናይ ዳጋሞፎ።’ <verse eid="ISA 7:4"/><verse number="5" style="v" sid="ISA 7:5"/>አራመ ቢታይ፥ ኤፍሬማ አሳራነ ራማላ ናኣራ ነ ቦላ ኢታባ ማቀትዶሶና።” <verse eid="ISA 7:5"/><verse number="6" style="v" sid="ISA 7:6"/>ኤንቲ “አነ ይሁዳ ኦልድ ኦይኮስ፤ እያ መንረድ ኑ ግዶን ሻክ ኤክድ፥ ፃቤላ ናኣ ካዎና ያጎሶና” ያጋ።<verse eid="ISA 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 7:7"/>ግዶሽን፥ ኡባ ሃርያ ጎዳይ፥ “ሀ ኤንታ ማቆይ ምነና፤ ኤንታ ዞረታይ ፖለተና። <verse eid="ISA 7:7"/><verse number="8" style="v" sid="ISA 7:8"/>ዳማስቆይ አራመ ሁጰ፤ ካዎይ ራዝን ዳማስቆ ሁጰ። ኡሱፑን ታማነ እቻሹ ላይ ግዶን ኤፍሬም ላለትድ ካዎተ ግዶና አታና። <verse eid="ISA 7:8"/><verse number="9" style="v" sid="ISA 7:9"/>ኤፍሬማ ሁጰይ ሳማርያ፤ ራማላ ናአይ፥ ፋቁሄይ ሳማርያ ሁጰ። ህንተ፥ ህንተ አማኑዋን ምኖና እፅኮ፥ ኤቃናዉ ዳንዳኤከታ” ያጌስ።<verse eid="ISA 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10"/>ቃስካ ጎዳይ አካዛኮ፥ <verse eid="ISA 7:10"/><verse number="11" style="v" sid="ISA 7:11"/>“ቦላ ሳሉዋፐ ዎይኮ ጋርሳ ሳኣፐ ጎዳይ፥ ነ ፆሳይ ነዉ እስ ማላ እማና መላ ኦይቻ” ያግስ። <verse eid="ISA 7:11"/><verse number="12" style="v" sid="ISA 7:12"/>ሽን አካዝ፥ “ኦይችከ፤ ኦይቻዳ ጎዳ ፓጭከ” ያግስ።<verse eid="ISA 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13"/>ያትን፥ እሳያስ፥ “ህንተኖ፥ ዳዊታ ሶ አሳዉ፥ ስእተ! ህንተ አሳ ዳንዳአ ፓጨይስ አይ ጉፅን፥ ቃስ ታ ፆሳ ዳንዳአ ፓጨቲ? <verse eid="ISA 7:13"/><verse number="14" style="v" sid="ISA 7:14"/>ሄሳ ግሾ፥ ጎዳይ ባ ሁጰን ህንተዉ ማላ እማና፤ ጌላእያ ቃንታዳ አደ ናአ የላና፤ እያ ሱንካ አማኑኤላ<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="fq" closed="false">አማኑኤላ፦ </char><char style="ft" closed="false">ሀ ሱን ብርሸይ “ፆሳይ ኑራ ደኤስ” ጉሱ።</char></note> ጋዳ ፄጋና።<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="MAT 1:23">ማቶ 1:23</ref>.</char></note> <verse eid="ISA 7:14"/><verse number="15" style="v" sid="ISA 7:15"/>እ፥ ኢታ እፆነ ሎኦ ዶሮ ኤርያ ዎደ መቃ ማነ ኦይስ ማና። <verse eid="ISA 7:15"/><verse number="16" style="v" sid="ISA 7:16"/>ሽን ናአይ ኢታ እፆነ ሎኡዋ ዶሮ ኤራናፐ ስን፥ ኔኒ ያይያ ናምኡ ካዎታ ቢታት ባይሳታና። <verse eid="ISA 7:16"/><verse number="17" style="v" sid="ISA 7:17"/>ኤፍሬም ይሁዳፐ ሻከቶሳፐ ዶምን ሀንቦና መቶ ዎደ ጎዳይ ነ ቦላ፥ ነ አሳ ቦላነ ነ አዋ ሶ አሳ ቦላ ኤሀና፤ እ ኤሀናይካ አሶረ ካዋ” ያግስ።<verse eid="ISA 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18"/>ሄ ጋላስ ጎዳይ፥ ሃሆ ሻፋ ጋፃን ደእያ ግብፀ ኡዱንፀታነ አሶረ ማታ ሱይቅድ ፄጋና። <verse eid="ISA 7:18"/><verse number="19" style="v" sid="ISA 7:19"/>ያትን፥ ኤንቲ ኡባይ ይድ፥ መላ ቢታ ዛንጋራን፥ ሹቻ ጎንጎሎን፥ አጉን ደእያ ቡረንነ ሃ ኦላታን ኡታና።<verse eid="ISA 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 7:20"/>ሄ ጋላስ ጎዳይ ኤፍራፂሳ ሻፋ ሄፍን ባጋፈ ጋርፅዳ ሽግርያን፥ አሶረ ካዋን፥ ህንተ ሁጵያ ቡሉሳና፤ ህንተ እክስያነ ህንተ ቡቻ ሜዳና።<verse eid="ISA 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 7:21"/>ሄ ጋላስ እስ አሳስ እስ ሚዝነ ናምኡ ዴሻ ፃላል አታና። <verse eid="ISA 7:21"/><verse number="22" style="v" sid="ISA 7:22"/>ግዶሽን፥ ኤንታ ማይ ዳሮ ግድያ ግሾ እ መቃ ማ ኡስታና፤ ሄ ቢታን አትዳ አሳ ኡባይ መቃ ማነ ኤስ ማና።<verse eid="ISA 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 7:23"/>ሄ ጋላስ እስ ሙኩሉ ብራን ዋሸትያ ሙኩሉ ዎይነ ቶሆት ደእያ በሳ ኡባን ክንቾተይነ አጉን ዶላና። <verse eid="ISA 7:23"/><verse number="24" style="v" sid="ISA 7:24"/>ቢታ ኡባን ክንቾተይነ አጉን ኩምዳ ግሾ፥ አሳይ ያ ብያ ዎደ ዶንገ ኦይክድ ባና። <verse eid="ISA 7:24"/><verse number="25" style="v" sid="ISA 7:25"/>ካሰ ኮንተን ኦዳ ዙማታን ሀእ ክንቾተይነ አጉን ኩምዳ ግሾ ያይድ፥ እስ አስካ ያ ቤና። ሽን መሄይነ ዶርስ ሄመትያ በሲ ግዳና።<verse eid="ISA 7:25"/></para>
  <chapter eid="ISA 7"/>
  <chapter number="8" style="c" sid="ISA 8"/>
  <para style="s1">አሶረ ካዋ ዩሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1"/>ጎዳይ ታኮ፥ “ግታ ሳሌዳ ኤካዳ፥ ‘ድአናዉ ኤለሳ! ቦንቃናዉ ድርጋ!’ ያጋዳ ናባበትያ ፕዳለን ፃፋ። <verse eid="ISA 8:1"/><verse number="2" style="v" sid="ISA 8:2"/>ካህንያ ኡራያነ ባራካ ናኣ ዛካርያሳ አማነትያ ማርካ ኦዳ ታኒ ፄጋና” ያግስ።<verse eid="ISA 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 8:3"/>ሄሳፈ ጉየ፥ ታኒ ናበ ግድዳ ታ ማቸራ አቃስ፤ እያ ቃንታዳ አደ ናአ የላሱ። ጎዳይ ታኮ፥ “እያ ሱን፥ ‘ማሃር-ሻላል-ሀሽ-ባዝ’ ያጋዳ ፄጋ። <verse eid="ISA 8:3"/><verse number="4" style="v" sid="ISA 8:4"/>ናአይ፥ ‘አቦ፥ እሞ’ ግድ ፄስ ኤራናፐ ስን አሶረ ካዎይ፥ ዳማስቆ ዱረተነ ሳማርያ ሻሉዋ ኤክድ ባና” ያግስ።<verse eid="ISA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5"/>ቃስካ ጎዳይ ታኮ ሀይሳዳ ያግስ። <verse eid="ISA 8:5"/><verse number="6" style="v" sid="ISA 8:6"/>“ሀ አሳይ ሎዳራ ጎግያ ሳልሆመ ሃ እፅድ፥ ራዝናነ ራማላ ናኣ ኡፋይትድ ኤክዶሶና። <verse eid="ISA 8:6"/><verse number="7" style="v" sid="ISA 8:7"/>ሄሳ ግሾ፥ ጎዳይ ምኖነ ዳሮ ግድዳ ኤፍራፂሳ ሃ፥ አሶረ ካዋ፥ እያ ኦላንቾታራ ኤሀና ሀኔስ። እ ሃ ክፅድ ኩመይሳዳ ጋፃ ኡባ ማእድ ጎጋና። <verse eid="ISA 8:7"/><verse number="8" style="v" sid="ISA 8:8"/>ድእሸ ይሁዳ ገላና፤ ክፃይ ቆ ጋካናዉ ኩምድ ያራ ካንና።” አቤት አማኑኤላ፥ እያ ቀፍያ ምጨይ ነ ቢታ ኡባ ማእስ።<verse eid="ISA 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 8:9"/>ህንተኖ ካዎተቶ፥ እስፈ ኦላስ ሺቅተ፥ ሽን ህንተ ያና። ሃሆ ቢታን ደእያ አሳቶ፥ ስእተ፤ ኦላስ ጊግተ፤ ሽን ህንተ ሊቃና! ኤ፥ ኦላስ ጊግተ፤ ህንተ ዉራና። <verse eid="ISA 8:9"/><verse number="10" style="v" sid="ISA 8:10"/>ፆሳይ ኑራ ደእያ ግሾ፥ ኦላስ ማቀትተ፥ ሽን ህንተ ማቆይ ካንና፤ ሀልችተ፥ ሽን ህንተ ሀልቾይ ሀላና።<verse eid="ISA 8:10"/></para>
  <para style="s1">ፆሳ ያያ</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11"/>“ጎዳይ ባ ምኖ ኩሽያ ታ ቦላ ዎድ፥ ታ ሀ አሳ ኦግያን ቦና መላ ታዉ ምንድ ኦድስ። <verse eid="ISA 8:11"/><verse number="12" style="v" sid="ISA 8:12"/>ሀ አሳ ማቆ ኡባ ማቆ ጎፕተ፤ ኤንቲ ያይያባ ያዮፍተ፤ ዳጋሞፕተ። <verse eid="ISA 8:12"/><verse number="13" style="v" sid="ISA 8:13"/>ህንተ ጌሽ ጋናዉ በሰይ ኡባፈ ዎልቃማ ጎዳ፤ እያዉ ያያናዉነ ዳጋማናዉ በሴስ። <verse eid="ISA 8:13"/><verse number="14" style="v" sid="ISA 8:14"/>እ፥ ጌሻ በሲ ግዳና፤ ሽን ይሁዳስነ እስራኤለስ እ፥ በ ሹችነ ኩንድስያ ዛላ ግዳና። የሩሳላመን ደእያ አሳስ እ ግተነ ፅሄ ግዳና። <verse eid="ISA 8:14"/><verse number="15" style="v" sid="ISA 8:15"/>ኤንታፈ ዳሮት በታና፤ ኩንድድ መአና፤ ፅሄን ኦይከትድ ድኤታና” ያግስ።<verse eid="ISA 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 8:16"/>ታ ኦደይሳ ናጋ፤ ታ ታማረታ ግዶን ህግያ አታማ። <verse eid="ISA 8:16"/><verse number="17" style="v" sid="ISA 8:17"/>ታኒ ባ ሶምኡዋ ያይቆባ ዘረፈ ገንያ ጎዳ ናጋና፤ እያን አማነታና።<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="HEB 2:13">እብራ 2:13</ref>.</char></note><verse eid="ISA 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 8:18"/>ታናነ ታዉ ጎዳይ እምዳ ናይታ በእተ። ኑኒ ፅዮነ ደርያን ደእያ ኡባፈ ዎልቃማ ጎዳፐ እስራኤለ አሳስ ማላነ ማላታ።<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="HEB 2:13">እብራ 2:13</ref>.</char></note><verse eid="ISA 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19"/>“ሱይቅሸነ ካልካሽሸ ኦድያ ማሮታነ ሞይትለታ ኦይችተ” ያግድ ህንተና ዞርያ አሳይ ደኦሶና። ደኦን ደኤይሳታስ ሀይቅዳይሳታ ኦይቸይሳፈ አሳይ ባንታ ፆሳ ኦይቻናዉ በሰኔ? <verse eid="ISA 8:19"/><verse number="20" style="v" sid="ISA 8:20"/>ህግያነ ጎዳ ማርካ ስእተ! ሄ አሳት ሀ ቃላዳ ሃሳዮና እፅኮ ኤንታዉ ሳእ ዎንተና።<verse eid="ISA 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 8:21"/>አሳይ ዋየትሸነ ኮሻትሸ ቢታ ቦላ ቶይላታና። ኤንቲ ኮሻትዳ ዎደ ይሎትድ፥ ፑደ ሳሎ ፄልድ ባንታ ካዋነ ባንታ ፆሳ ባዳና። <verse eid="ISA 8:21"/><verse number="22" style="v" sid="ISA 8:22"/>ሳኣ ዱገ ፄልያ ዎደ ዋየ፥ ማነ ያሽያ ጫጋና በአና፤ ኤንቲ ሳካና ማን ሆለታና።<verse eid="ISA 8:22"/></para>
  <chapter eid="ISA 8"/>
  <chapter number="9" style="c" sid="ISA 9"/>
  <para style="s1">ናእ የለትስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1"/>ግዶሽን፥ ዋየትዳይሳታስ ህዛፐ ጉየ መና። በን ዎደ ጎዳይ ዛብሎና ቢታነ ንፍታለመ ቢታ ካዉሽስ። ሽን ስንፈ መደትራነ አባ ኦግያን ደእያ ቢታነ ዮርዳኖሰ ሻፋፐ ሄፍንን ደእያ አይሁደ ግዶና አሳይ ደእያ ጋልላ ቢታ እ ቦንቻና።<verse eid="ISA 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 9:2"/>ማን ሄመትያ አሳይ ዎልቃማ ፖኦ በእስ፤ ቃስ ሀይቆ ማን ደኤይሳታስ ፖኦይ ፖእስ።<verse eid="ISA 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 9:3"/>ኔኒ ካዎተ ዳርሳዳሳ፤ ኤንታ ኡፋይሳ ጉጃዳሳ። አስ ካ ሺሽያ ዎደ ኡፋይተይሳዳ ዎይኮ ድኡዋ ሻክድ ኤክያ ዎደ ኡፋይተይሳዳ ነ ስንን ኡፋይታና። <verse eid="ISA 9:3"/><verse number="4" style="v" sid="ISA 9:4"/>ኔኒ ምድያመ ቢታ ፆንዳይሳዳ ኤንታ ዴፆ ቃምባራ፥ ኤንታ ጋናስ ጊግዳ ፃምአነ ኤንታ ኡንኤይሳታ ጉምባ መንዳሳ። <verse eid="ISA 9:4"/><verse number="5" style="v" sid="ISA 9:5"/>ኦላንቾታ ጫማይነ ሱን ሙኑቀትዳ ማኦ ኡባይ ታማን ፁገታና፤ ታማስ ኦይሰ ግዳና። <verse eid="ISA 9:5"/><verse number="6" style="v" sid="ISA 9:6"/>ኑስ ናእ የለትስ! አደ ናእ ኑስ እመትስ! ካዎተ ማት እያ ሀሽያን ግዳና፤ እያ ሱንይ፥ “ማላልስያ ዞራንቾ፥ ዎልቃማ ፆሳ፥ መርና አዋ፥ ሳሮተ ሀላቃ” ጌተታና። <verse eid="ISA 9:6"/><verse number="7" style="v" sid="ISA 9:7"/>እያ ካዎተ ዳልጋተስነ እያ ሳሮተስ ዛው ባዋ። ሀችፈ ዶምድ፥ መርና ጋካናዉ ሱረ ፕርዳንነ ፅሎተን ምንናዉነ ኤሳናዉ ዳዊታ አራታንነ እያ ካዎተን እ ካዎታና። ኡባፈ ዎልቃማ ጎዳ ቃናተይ ሀይሳ ኦና።<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="LUK 1:32-33">ሉቃ 1:32-33</ref>.</char></note><verse eid="ISA 9:7"/></para>
  <para style="s1">እስራኤለ ቦላ ጎዳ ሀንቁዋ</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 9:8"/>ጎዳይ ያይቆባ ዘረ ቦላ ፕርዳ ቃላ ኪትን፥ እስራኤለ ካዎተ ቦላ ዎስ። <verse eid="ISA 9:8"/><verse number="9" style="v" sid="ISA 9:9"/>ኤፍሬማ አሳይነ ሳማረ ካታማ አሳይ ሀይሳ ኦዳይ ጎዳ ግደይሳ ኤርሸ፥ ኦቶሮንነ ጬቆን፥ <verse eid="ISA 9:9"/><verse number="10" style="v" sid="ISA 9:10"/>“ፁበፐ ኬፀትዳ ኬት ላለትዶሶና፤ ሽን ኑ ዛሪድ ማሰትዳ ሹቻን ኬፃና፤ ቦባ ምት ቃንፀትዶሶና፤ ሽን ኑ ኤንታ በሳን ዝጋታ ላማና” ያግዶሶና።<verse eid="ISA 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 9:11"/>ሽን፥ ፆሳይ ራሶና ሞርከታ ምንና፤ ኤንታ ቦላ ኤሀና፤ ኤንታራ ኤቀትያ ሞርከታ ኤንታ ቦላ ደንስ። <verse eid="ISA 9:11"/><verse number="12" style="v" sid="ISA 9:12"/>ዶሎሀፐ አራመታ፥ ዉሎሀፐ ፍልስፄመታ ደንን፥ ኤንቲ ባንታ ዶና ዶይድ፥ እስራኤለ ምትዶሶና። ሄ ኡባን ጎዳ ሀንቆይ ስምቤና፤ እያ ኩሸይ ደንድዳ በሳን ደኤስ።<verse eid="ISA 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 9:13"/>ግዶሽን፥ አሳይ ባንታና ሾጭዳይሳኮ ስምቦኮና፤ ኡባፈ ዎልቃማ ጎዳ ኮይቦኮና። <verse eid="ISA 9:13"/><verse number="14" style="v" sid="ISA 9:14"/>ሄሳ ግሾ፥ እስ ጋላስ ጎዳይ እስራኤለፐ ሁጰነ ጎይና፥ ዛምባ ዳሻነ ማቃ ቃንፃና። <verse eid="ISA 9:14"/><verse number="15" style="v" sid="ISA 9:15"/>ጭማትነ ቦንቸትዳይሳት ሁጰ፤ ዎርዶ ታማርስያ ናበት ጎይና። <verse eid="ISA 9:15"/><verse number="16" style="v" sid="ISA 9:16"/>ሀ አሳ ካለይሳት ባለሶና፤ ኤንታ ካለይሳትካ ባሎሶና። <verse eid="ISA 9:16"/><verse number="17" style="v" sid="ISA 9:17"/>ሄሳ ግሾ፥ ጎዳይ ኤንታ ናአተታን ኡፋይተና፤ ይኦ ናይታስነ አምኤታስ ቃተና። አስ ኡባይ ኢታነ ፆሰ ኤሮናይሳ ግዳና፤ ኡባይ ባ ዶናን ኢታባ ኦደቴስ። ሄ ኡባን ጎዳ ሀንቆይ ስምቤና፤ እያ ኩሸይ ደንድዳ በሳን ደኤስ።<verse eid="ISA 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 9:18"/>ታም ክንቾተነ አጉን መይሳዳ ኢታተ ፁጌስ፤ ስከትዳ ዎር ፁገትን፥ ጩያይ ቱሳዳ ከየይሳዳ ከዬስ። <verse eid="ISA 9:18"/><verse number="19" style="v" sid="ISA 9:19"/>ኡባፈ ዎልቃማ ጎዳ ሀንቁዋን ቢታይ ፁገታና፤ አስካ ታማ ኦይሰያባ ግዳና፤ ኦንካ ባ እሻ አሻናዉ ቆፐና። <verse eid="ISA 9:19"/><verse number="20" style="v" sid="ISA 9:20"/>ኤንቲ ኡሻቻ ባጋራ ቦንቃና፥ ሽን ኮሻታና፤ ኤንቲ ሀድርሳ ባጋራ ማና፥ ሽን ካሎኮና፤ ኤንቲ ባንታ የልዳ ናይታ ማና። <verse eid="ISA 9:20"/><verse number="21" style="v" sid="ISA 9:21"/>ምናሰይ ኤፍሬማ፥ ኤፍሬምካ ምናሰ ማና፤ ኤንቲ እስፈ ግድድ ይሁዳ ቢታ ሞርካና። ሄ ኡባን ጎዳ ሀንቆይ ስምቤና፤ እያ ኩሸይ ደንድዳ በሳን ደኤስ።<verse eid="ISA 9:21"/></para>
  <chapter eid="ISA 9"/>
  <chapter number="10" style="c" sid="ISA 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 10:1"/>ኢታ ህገነ ኡንኤያ አዋጆ ከሰይሳታ አየ! <verse eid="ISA 10:1"/><verse number="2" style="v" sid="ISA 10:2"/>ሄሳን ኤንቲ ማንቆታ፥ አምኤታነ ይኦታ ፕርዳ ጌላዮሶና፤ አምኤታነ ይኦታ አቁዋ ቦንቆሶና። <verse eid="ISA 10:2"/><verse number="3" style="v" sid="ISA 10:3"/>እ፥ ሃሆ ቢታፈ ያ መቱዋን ሴርያ ዎደ ህንተ ዋናኔ? ማዶ ደማናዉ ኦደኮ ባቃታኔ? ህንተ ሻሉዋ አዉን ቆታኔ? <verse eid="ISA 10:3"/><verse number="4" style="v" sid="ISA 10:4"/>ህንተ ድኤትዳ አሳራ ጎሸታና፤ ሀይቅዳ አሳ ግዶን ዝንአና። ሄ ኡባን ጎዳ ሀንቆይ ስምቤና፤ እያ ኩሸይ ደንድዳ በሳን ደኤስ።<verse eid="ISA 10:4"/></para>
  <para style="s1">አሶረይ ፕርደታና</para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 10:5"/>ጎዳይ ሀይሳዳ ያጌስ፤ “ታ ይሉዋስ ፕርጮነ ታ ሀንቁዋስ ፃምአ ግድዳ አሶረ ቢታ አየ!<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="ISA 14:24-27">እሳ 14:24-27</ref>፤ <ref loc="NAM 1:1-3">ናሆ 1:1-3</ref>፤ <ref loc="ZEP 2:13-15">ሶፎ 2:13-15</ref>.</char></note> <verse eid="ISA 10:5"/><verse number="6" style="v" sid="ISA 10:6"/>ኤንታ ሻሉዋ ድአናዳነ ቦንቃናዳ፤ ኦገ ኡርቃዳ ኤንታ የናዳ ፆሰ ኤሮና ካዎተ ቦላ ታኒ አሶረ ኪታና፤ ታና ሀንቀዳ አሳ ቦላ እያ የዳና። <verse eid="ISA 10:6"/><verse number="7" style="v" sid="ISA 10:7"/>ሽን አሶረ ካዎይ ሀይሳ ሀልችቤና፤ እያ ዎዛናይ ሀይሳ ቆፕቤና። እ ቆፕዳይ ዳሮ ካዎተታ ይሳናሳ። <verse eid="ISA 10:7"/><verse number="8" style="v" sid="ISA 10:8"/>ሄሳ ግሾ እ ያግድ ጬቀቴስ፤ ‘ታ ቶራ ሞጮናት ኡባይ ካዎታ ግዶኮናዬ?’ <verse eid="ISA 10:8"/><verse number="9" style="v" sid="ISA 10:9"/>ካልኖይ ካርካምሻ ካታማ መላ ግደነዬ? ሀማት አርፋዳ ካታማ መላ ግደነዬ? ሳማረይ ዳማስቆ ካታማ መላ ግደነዬ? <verse eid="ISA 10:9"/><verse number="10" style="v" sid="ISA 10:10"/>የሩሳላመንነ ሳማረን ደእያ ኤቃታፐ ዳርያ ኤቃታ ጎይንያ ካዎተታ ሴራናዉ ታኒ ታ ኩሽያ የዳስ። <verse eid="ISA 10:10"/><verse number="11" style="v" sid="ISA 10:11"/>ታኒ ሳማረ ካታማ ቦላነ እያ ኤቃ ምስለታ ቦላ ኦዳይሳዳ የሩሳላመ ካታማ ቦላነ እያ ኤቃ ምስለታ ቦላ ኦክናዬ?” ያግስ።<verse eid="ISA 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12"/>ጎዳይ ፅዮነ ደርያ ቦላነ የሩሳላመ ቦላ ባ ኦሱዋ ኡባ ፖልዳፐ ጉየ፥ አሶረ ካዋ እያ ኦቶሩዋስነ ጬቁዋስ እያ ሴራና።<verse eid="ISA 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 10:13"/>አሶረ ካዎይ ሀይሳዳ ያጌስ፦ “ታ ኩሸ ምኖተን፥ ታ ጭንጫተንነ ታ አኬካን ሀይሳ ኦስ። ታኒ ካዎተታ ግዶን ደእያ ዛዋታ ሾዳስ፤ ኤንታ ሻሉዋ ቦንቃስ፤ ታ ዎልቃን ካዎተታ አራታፐ ዎሳስ። <verse eid="ISA 10:13"/><verse number="14" style="v" sid="ISA 10:14"/>አስ ካፎ ኬን ኩሸ የደይሳዳ ታኒ ካዎተ ሻሉዋን ታ ኩሽያ የዳስ። ቃስ ዶገትዳ ጱጱለታ ሺሸይሳዳ ታኒ ቢታ ኡባ ሺሻስ። ባ ቀፍያ ቃዳይ ዎይኮ ዶና ጱቅዳይ ዎይኮ ዋስዳይ እሶይካ ባዋ” ያግስ።<verse eid="ISA 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 10:15"/>ካልት ባራ ቃንፅያ አድያ ቦላ ደንዳናዉ ዳንዳኢ? ዎይኮ ማጋዘይ ባናን ጎኤትያ አድያ ቦላ ኦቶራናዉ ዳንዳኢ? ኩሸይ ደንና ፃምእ ባና ባዉ ደን? ጉፈይ ኦይክያ አስ ባይና ባዉ ሄመቲ? <verse eid="ISA 10:15"/><verse number="16" style="v" sid="ISA 10:16"/>ሄሳ ግሾ፥ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ እያ ምኖ ኦላንቾታ ቦላ ግልቅስያ ሀርገ የዳና። እያ ቦንቹዋ ላፆ ታም ማና። <verse eid="ISA 10:16"/><verse number="17" style="v" sid="ISA 10:17"/>እስራኤለ ፖኦይ ታማ ግዳና፤ ኤንታ ጌሻይ ላጮ ግዳና። እያ አጉንነ እያ ክንቾትያ እስ ጋላስ ፁጋናነ ማና። <verse eid="ISA 10:17"/><verse number="18" style="v" sid="ISA 10:18"/>ሀርገይ አሰ ግልቅሰይሳዳ ጎዳይ ባ ዎራ ም ቦንቹዋነ ባ አራዳ ቢታ ቦንቹዋ ይሳና። <verse eid="ISA 10:18"/><verse number="19" style="v" sid="ISA 10:19"/>ዎራን አትያ ምይ ዳሮ ጉ ግድያ ግሾ፥ ሀር አቶሽን ጉ ናእካ ታይብድ ዉርሳና።<verse eid="ISA 10:19"/></para>
  <para style="s1">አትዳ ጉት ስማና</para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 10:20"/>ሄ ዎደ እስራኤለፐነ ይሁዳፐ አትዳ ጉት ባንታና ሾጭዳይሳን ግዶናሽን፥ ቱማ ጎዳን፥ እስራኤለ ጌሻን ዘምፓና። <verse eid="ISA 10:20"/><verse number="21" style="v" sid="ISA 10:21"/>አትዳ ይሁዳ አሳይ ዎልቃማ ፆሳኮ ስማና። <verse eid="ISA 10:21"/><verse number="22" style="v" sid="ISA 10:22"/>ነኖ እስራኤለ፥ ኔኒ አባ ጋፃን ደእያ ሻፍያ መላ ዳርኮካ፥ አትዳ ጉታ ፃላል ስማና። ፅሎተ ኩምዳ ዮይ እያ አሳስ አዋጀትስ። <verse eid="ISA 10:22"/><verse number="23" style="v" sid="ISA 10:23"/>ኤ፥ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ ሳአ ኡባ ቦላ ኤሀናዉ ቆፕዳ ዩዋ ኤሀና።<verse eid="ISA 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24"/>ሄሳ ግሾ፥ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ ሀይሳዳ ያጌስ፦ “ፅዮነን ደእያ ታ አሳዉ፥ ግብፀት ኦዳይሳዳ አሶረት ህንተና ፃምአን ሾጭያ ዎደነ ባንታ ጉምባ ህንተ ቦላ ደንያ ዎደ ያዮፍተ። <verse eid="ISA 10:24"/><verse number="25" style="v" sid="ISA 10:25"/>ጉ ዎደፐ ጉየ፥ ታኒ ህንተ ቦላ ሀንቀትዳይሳ አጋና፤ ሄሳፈ ጉየ፥ ታ ሀንቆይ ኤንታ ይሳናዉ ደንዳና” ያጌስ።<verse eid="ISA 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ISA 10:26"/>ኡባፈ ዎልቃማ ጎዳይ ኦሬባ ሹቻ ማታን ምድያመታ ሾጭዳይሳዳ ኤንታ ልሶን ሾጫና። እ ግብፀን ኦዳይሳዳ ባ ፃምአ አባ ቦላ ደንና። <verse eid="ISA 10:26"/><verse number="27" style="v" sid="ISA 10:27"/>ሄ ጋላስ፥ እያ ቶሆይ ህንተ ሀሽያፐ ዎና፤ እያ ቃምባራይ ህንተ ሞርገፈ ክቻና። ህንተ ኦርድዳ ግሾ ቃምባራይ መቃና።<verse eid="ISA 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 10:28"/>ሞርክያ ዎታዳራት ጋየ ካታማ ገልዶሶና፤ ምግሮናራ ካንዶሶና፤ ባንታ ኦላ ሚሽያ ምክማሳ ዎዶሶና። <verse eid="ISA 10:28"/><verse number="29" style="v" sid="ISA 10:29"/>ኤንቲ ኦግያራ ካን አድ፥ ጌባን አቅዶሶና። ራማን ደእያ አሳይ ኮኮርዶሶና፤ ግብአን፥ ካዋ ሳኦላ ካታማን ደእያ አሳይ ባቃትዶሶና። <verse eid="ISA 10:29"/><verse number="30" style="v" sid="ISA 10:30"/>ጋልማ አሳዉ፥ ዋሶ ጎችተ! ላይሻ አሳዉ፥ ስእተ! አናቶታ አሳዉ፥ ኦይሻ ዛርተ! <verse eid="ISA 10:30"/><verse number="31" style="v" sid="ISA 10:31"/>ማድማና አሳይ ባቃትዶሶና፤ ገብማ አሳይ ባንታ ሸምፑዋስ ቆሰትዶሶና። <verse eid="ISA 10:31"/><verse number="32" style="v" sid="ISA 10:32"/>ሞርክያ ዎታዳራት ሀች ኖባን ደኦሶና፤ ኤንቲ ፅዮነ ዙማ ቦላ ኤቅድ፥ ባንታ ኩሽያ ቃድ፥ የሩሳላመ ካታማ ባብሶሶና።<verse eid="ISA 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 10:33"/>ሄኮ፥ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ ታሸታ ግታ ዎልቃን ሻቃና፤ አዱቅዳ ምት ቃንፀታና፤ ቃ ግዳይሳት ካዉያና። <verse eid="ISA 10:33"/><verse number="34" style="v" sid="ISA 10:34"/>ጎዳይ ስከትዳ ዎራ ካሎታና ጋካናዉ ቃንፃና፤ ልባኖሰይ ዎልቃማ ስንን ኩንዳና።<verse eid="ISA 10:34"/></para>
  <chapter eid="ISA 10"/>
  <chapter number="11" style="c" sid="ISA 11"/>
  <para style="s1">እሰየፐ ከይዳ አጫ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 11:1"/>እሰየ ዱሩማይ አጫና፤ እያ ፃጱዋፐ አይፍያ ታሸይ ከያና።<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="REV 5:5">ቆን 5:5</ref>፤ <ref loc="REV 22:6">22:6</ref>.</char></note><verse eid="ISA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 11:2"/>ጎዳ አያናይ እያ ቦላ ሸምፓና፤</para>
  <para style="q2" vid="ISA 11:2">ጭንጫተነ አኬካ አያናይ፥</para>
  <para style="q2" vid="ISA 11:2">ዞርያነ ዎልቃ አያናይ፥</para>
  <para style="q2" vid="ISA 11:2">ኤራተነ ጎዳስ ያይያ አያናይ፥ እያ ቦላ ሸምፓና።<verse eid="ISA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 11:3"/>ጎዳስ ያይድ ኡፋይቴስ፤</para>
  <para style="q2" vid="ISA 11:3">ባ አይፈይ በእዳባን ጮ ፕርደና፤</para>
  <para style="q2" vid="ISA 11:3">ዎይኮ ባ ሀይይ ስእዳባን ጮ ኩየና።<verse eid="ISA 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 11:4"/>ሽን እ፥ ማንቆታስ ፅሎተን ፕርዳና፤</para>
  <para style="q2" vid="ISA 11:4">ሳአን ደእያ መቶታንቾታስ ሱረተን ኩያና።</para>
  <para style="q1" vid="ISA 11:4">እ ባ እንፃርሳ ፃምአን ሳኣ ሾጫና፤</para>
  <para style="q2" vid="ISA 11:4">ባ ዶና ሸምፑዋን ኢታታ ዎና።<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="2TH 2:8">2 ታሰ 2:8</ref>.</char></note><verse eid="ISA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 11:5"/>ፅሎተ እያ ፄሳ ዳንጮ ግዳና፤</para>
  <para style="q2" vid="ISA 11:5">አማነተ እያ ምያስ ሳቀ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="EPH 6:14">ኤፈ 6:14</ref>.</char></note><verse eid="ISA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 11:6"/>ሱመይ ዶርሳ ማራራ እስፈ ዳና፤</para>
  <para style="q2" vid="ISA 11:6">ማሄይ ዴሻ ማራራ እስፈ ዝንአና።</para>
  <para style="q1" vid="ISA 11:6">ማር ጋሞ ቡታለራ እስፈ ሄመታና፤</para>
  <para style="q2" vid="ISA 11:6">ጉ ናእ ኤንታ ሄማና።<note caller="-" style="x"><char style="xo" closed="false">11:6 </char><char style="xt" closed="false"><ref loc="ISA 65:25">እሳ 65:25</ref>.</char></note><verse eid="ISA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 11:7"/>ሚዝነ ባባን እስፈ ሄመታና፤</para>
  <para style="q2" vid="ISA 11:7">ኤንታ ማራት እስፈ ዝንአና፤</para>
  <para style="q2" vid="ISA 11:7">ጋሞይ ቦራዳ ካለ ማና።<verse eid="ISA 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 11:8"/>ምያ ናእ ሾሻ ኦላን ካአና፤</para>
  <para style="q2" vid="ISA 11:8">ን ዱፅዳ ናእ ዎያ ሾሻ ኦላን ባ ኩሽያ የዳና።<verse eid="ISA 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 11:9"/>ታ ጌሻ ዙማ ቦላ</para>
  <para style="q2" vid="ISA 11:9">ኦንካ ቆሄተና ዎይኮ የና።</para>
  <para style="q1" vid="ISA 11:9">አቢ ሃን ኩመይሳዳ</para>
  <para style="q2" vid="ISA 11:9">ሳእ ጎዳ ኤሮን ኩማና።<verse eid="ISA 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10"/>ሄ ዎደ እሰየ ፃጶይ አሳስ ማላ ግዳና፤</para>
  <para style="q2" vid="ISA 11:10">ካዎተ ኡባይ እያ ኮያና፤</para>
  <para style="q2" vid="ISA 11:10">እ ደእያ በሳይ ቦንቸታና።<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="ROM 15:12">ሮመ 15:12</ref>.</char></note><verse eid="ISA 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 11:11"/>ሄ ጋላስ ጎዳይ አትዳ ባ አሳ፥ አሶረፐ፥ ግብፀፈ፥ ጳትሮሳፐ፥ ቶጰፈ፥ ኤላማፐ፥ ሳናኦረፐ፥ ሀማታፐነ ዩሾይ አባን ተቀትዳ ቢታፈ ናምአን ኤሀናዉ ባ ኩሽያ ዛሪድ የዳና። <verse eid="ISA 11:11"/><verse number="12" style="v" sid="ISA 11:12"/>እ ካዎተታስ ማላ ቁ ኦድ ደንና፤ እስራኤለፐ ላለትዳይሳታ እስፈ ጋና፤ ይሁዳፐ ሳኣ ኦይዱ ባጋን ዘረትዳይሳታ ሺሻና።<verse eid="ISA 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 11:13"/>ሄሳፈ ጉየ፥ ኤፍሬማ ቃናተይ እያፐ ክቻና፤ ይሁዳ ሞርከተይ እያፐ ቃንፀታና። ኤፍሬም ይሁዳ ቃናተና፤ ይሁድ ኤፍሬማ ሞርከና። <verse eid="ISA 11:13"/><verse number="14" style="v" sid="ISA 11:14"/>ኤንቲ ዉሎሀ ባጋን ደእያ ፍልስፄመ ቢታ ቦላ ጉፕ ዎና፤ ኤንቲ ዶሎሀ ባጋን ደእያ አሳ ቦንቃና። ኤንቲ ኤዶመ ቦላነ ሞአበ ቦላ ባንታ ኩሽያ ዎና፤ አሞነት ኤንታዉ ሃረታና። <verse eid="ISA 11:14"/><verse number="15" style="v" sid="ISA 11:15"/>ጎዳይ ግብፀ ማታን ደእያ ዞኦ አባ መልሳና፤ ባ መልስያ ጫርኩዋራ ባ ኩሽያ ኤፍራፂሳ ሻፋ ቦላ ቃና። ያትድ አሳይ መላ በሳራ ፕናና መላ ላፑን ጉ ሻፋ ከስድ ሻካና።<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="REV 16:12">ቆን 16:12</ref>.</char></note> <verse eid="ISA 11:15"/><verse number="16" style="v" sid="ISA 11:16"/>እስራኤለ አሳይ ግብፀ ቢታፈ ከይያ ዎደ ኦገይ ከይዳይሳዳ፥ አትዳ እያ አሳይ፥ አሶረ ቢታፈ ስምያ ኦገይ ከያና።<verse eid="ISA 11:16"/></para>
  <chapter eid="ISA 11"/>
  <chapter number="12" style="c" sid="ISA 12"/>
  <para style="s1">ጋላታ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1"/>ሄ ዎደ ህንተ ሀይሳዳ ያግድ የፃና።</para>
  <para style="q1" vid="ISA 12:1">“ጎዳዉ፥ ኔኒ ታ ቦላ ሀንቀታዳሳ፤</para>
  <para style="q2" vid="ISA 12:1">ሽን ሀእ ነ ሀንቁዋፈ ስማዳሳ።</para>
  <para style="q1" vid="ISA 12:1">ታና ምንዳሳ፤</para>
  <para style="q2" vid="ISA 12:1">ሄሳ ግሾ፥ ታኒ ነና ጋላታይስ።<verse eid="ISA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 12:2"/>ፆሳይ ታ አቶተ፤</para>
  <para style="q2" vid="ISA 12:2">ታኒ እያን አማነታይስ፥ ያይከ።</para>
  <para style="q1" vid="ISA 12:2">ጎዳይ ፆሳይ፥ ታ ዎልቃነ የ፤</para>
  <para style="q2" vid="ISA 12:2">እ ታ አቶተ”<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="EXO 15:2">ከሳ 15:2</ref>፤ <ref loc="PSA 118:14">ማዝ 118:14</ref>.</char></note> ያጋና።<verse eid="ISA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 12:3"/>አቶተ ፑልቱዋፈ</para>
  <para style="q2" vid="ISA 12:3">ህንተ ሃ ኡፋይሳን ዱቃና።<verse eid="ISA 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 12:4"/>ሄ ጋላስ ህንተ ያግድ የፃና፦</para>
  <para style="q1" vid="ISA 12:4">“ጎዳ ጋላትተ!</para>
  <para style="q2" vid="ISA 12:4">እያ ሱን ፄግተ።</para>
  <para style="q1" vid="ISA 12:4">እያ ኦሶታ ካዎተታ ኡባስ ኦድተ፤</para>
  <para style="q2" vid="ISA 12:4">እ ግታ ግደይሳ አዋጅተ።<verse eid="ISA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 12:5"/>ጎዳይ ግታ ኦሶ ኦዳ ግሾ፥ እያዉ የፅተ፤</para>
  <para style="q2" vid="ISA 12:5">ሀይስ ሳአ ኡባን ኤረቶ።<verse eid="ISA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 12:6"/>እስራኤለ ጌሻይ ህንተ ግዶን ግታ ግድያ ግሾ፥</para>
  <para style="q2" vid="ISA 12:6">ፅዮነ አሳዉ፥ እልልተ፥ ኡፋይሳን የፅተ!” ያጋና።<verse eid="ISA 12:6"/></para>
  <chapter eid="ISA 12"/>
  <chapter number="13" style="c" sid="ISA 13"/>
  <para style="s1">ፆሳይ ባብሎነ ሴራና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1"/>አሞፀ ናአይ፥ እሳያስ ጎዳይ ባብሎነባ ቆንጭስን በእዳይስ ሀይሳ።<verse eid="ISA 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 13:2"/>አይኮይ ባይና ደርያ ቦላ ማላ ኤስድ፥ ህንተ ቃላ ቁ ኦድ ዋስተ፤ ኤንቲ ሀላቃታ ፐንግያራ ገላና መላ ዉትተ። <verse eid="ISA 13:2"/><verse number="3" style="v" sid="ISA 13:3"/>ታኒ ሀንቀትዳይሳታ ሴራና መላ ታ ጌሻታ ኪታስ፤ ታ ፆኖይ ኡፋይስያ ታ ዎልቃማታ ፄጋስ።<verse eid="ISA 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 13:4"/>ዳሮ አሳይ ዎጫመይሳዳ ደርያ ሁጵያን ደእያ ዎጫማ ስእተ! ቃስ ካዎተት እስፈ ሺቅድ ፓላምያ ፓላማ ስእተ! ኡባፈ ዎልቃማ ጎዳይ ኦላንቾታ ኦላስ ጊግስስ። <verse eid="ISA 13:4"/><verse number="5" style="v" sid="ISA 13:5"/>ጎዳይነ እያ ሀንቆ ኦላ ሚሸይ ቢታ ኡባ ይሳናዉ ሃሆ ቢታፈ፥ ሳሎ ጋፃፐ ዮሶና።<verse eid="ISA 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 13:6"/>ጎዳ ጋላሳይ ማትዳ ግሾ ዬክተ! ሄ ጋላሳይ ኡባፈ ዎልቃማ ፆሳ ማታፐ ይሳናዉ ያና።<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="JOL 1:15">እዩ 1:15</ref>.</char></note> <verse eid="ISA 13:6"/><verse number="7" style="v" sid="ISA 13:7"/>ሄሳ ግሾ፥ ያሻን ኤንታ ኩሸይ ዶጫና፤ አሳ ኡባ ዎዛናይ ትልአና። <verse eid="ISA 13:7"/><verse number="8" style="v" sid="ISA 13:8"/>ኤንቲ ዳጋማና፤ እቀነ ኡንኤተ ኤንታ ኦይካና። የሎ ከይዳ ማጫሳዳ ኤንቲ እንፃፃና። ኤንቲ ዳጋምድ እሶይ እሱዋ ፄላና፤ ኤንታ ሶምኦይ ብዶ ግድስ። <verse eid="ISA 13:8"/><verse number="9" style="v" sid="ISA 13:9"/>ሄኮ ቢታ ባይሳ ከሳናዉነ እያን ደእያ ናጋራንቾታ ይሳናዉ ይሎንነ ሱልዳ ሀንቆን ጎዳ ጋላሳይ ያና። <verse eid="ISA 13:9"/><verse number="10" style="v" sid="ISA 13:10"/>ሳሎ ፆልንቶትነ ፆልንቶ ኮጨት ባንታ ፖኡዋ ድጋና፤ ዶልያ አዋይ ማና፤ አጌናይካ ባ ፖኡዋ እመና።<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="EZK 32:7">ህዝ 32:7</ref>፤ <ref loc="MAT 24:29">ማቶ 24:29</ref>፤ <ref loc="MRK 13:24-25">ማር 13:24-25</ref>፤ <ref loc="LUK 21:25">ሉቃ 21:25</ref>፤ <ref loc="REV 6:12-13">ቆን 6:12-13</ref>.</char></note><verse eid="ISA 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 13:11"/>ጎዳይ፥ “ታኒ ሀ ሳኣ እያ ኢታተ ግሾ፥ ኢታታካ ኤንታ ናጋራ ግሾ ሴራና። ታኒ ኦቶራንቾታ ኦቶሩዋ ሻራና፤ ኢታታ ጬቁዋ ካዉሻና። <verse eid="ISA 13:11"/><verse number="12" style="v" sid="ISA 13:12"/>አትዳይሳት ዋላህ ባይና ዎርቃፈ አልኦ ግዳና፤ አሳ ናእ ኦፍራ ዎርቃፈ አድ ቦንቾ ግዳና። <verse eid="ISA 13:12"/><verse number="13" style="v" sid="ISA 13:13"/>ሄሳ ግሾ፥ ኡባፈ ዎልቃማ ጎዳ ሀንቁዋን፥ እያ ሀንቁዋ ሱላ ጋላስ፥ ታኒ ሳሎታ ኮኮርሳና፤ ሳኣካ እያ በሳፈ ቃና” ያጌስ።<verse eid="ISA 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 13:14"/>ሻንካፈ ባቃትያ ጋራዳ ዎይኮ ሄምያ አስ ባይና ዶርሳ ዉደዳ አስ ኡባይ ባ አሳኮ ስማና፤ ኡባይ ባ ቢታ ባቃታና። <verse eid="ISA 13:14"/><verse number="15" style="v" sid="ISA 13:15"/>በንትዳ ኦንካ ጫደታና፤ ኦይከትዳ ኦንካ ማሻን ሀይቃና። <verse eid="ISA 13:15"/><verse number="16" style="v" sid="ISA 13:16"/>ኤንታ ጉ ናይት ኤንታ ስንን ቡሰታና፤ ኤንታ ኬይ ቦንቀታና፤ ኤንታ ማቸታ ሀራ አስ ኢሳና።<verse eid="ISA 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 13:17"/>ብራ ኮዮናነ ዎርቃን ኡፋይቶና ሜዶና አሳ ታኒ ኤንታ ቦላ ደንና። <verse eid="ISA 13:17"/><verse number="18" style="v" sid="ISA 13:18"/>ኤንታ ዶንገይ ናአተታ ዎና፤ ዮጋ ናይታካ ማሮኮና፤ ኤንታ አይፈይ ናይታስ ቃተና። <verse eid="ISA 13:18"/><verse number="19" style="v" sid="ISA 13:19"/>ካዎተታስ ቦንቾ፥ ባ አሳስ አሌቆ ግድዳ ባብሎነ ቢታ፥ ጎዳይ ሶዶመዳነ ጋሞራዳ ሽር የጋና።<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="GEN 19:24">መ 19:24</ref>.</char></note> <verse eid="ISA 13:19"/><verse number="20" style="v" sid="ISA 13:20"/>ሄ ቢታን አስ ኡተና፤ ዎይኮ የለታፐ የለታ ጋካናዉ ያን አስ ዴና። አራበ አሳይ ያን ባንታ ዱንካንያ ቶሎኮና፤ ዶርሰ ሄመይሳትካ ያን ባንታ ዉድያ ሄሞኮና። <verse eid="ISA 13:20"/><verse number="21" style="v" sid="ISA 13:21"/>ሽን ባዞ ዶአት ያን አቃና፤ ዎርካናት ኤንታ ኬ ኩማና፤ ጉቶት ያን ዳና፤ ያንቾት ያን ኬፃና፤ ባዞ ዴሻት ያን ጉፓና።<note caller="-" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="ISA 34:14">እሳ 34:14</ref>፤ <ref loc="ZEP 2:14">ሶፎ 2:14</ref>፤ <ref loc="REV 18:2">ቆን 18:2</ref>.</char></note> <verse eid="ISA 13:21"/><verse number="22" style="v" sid="ISA 13:22"/>ኤንታ ኬታን ጎዳረይ ዋሳና፤ ኤንታ ካዎ ጋን ዎርካናት ቦጫና። እያ ዎደይ ማትስ፤ እያ ጋላሳይካ ጋምኤና።<verse eid="ISA 13:22"/></para>
  <chapter eid="ISA 13"/>
  <chapter number="14" style="c" sid="ISA 14"/>
  <para style="s1">ድኦፐ ስሞ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 14:1"/>ጎዳይ ያይቆባስ ቃታና፤ እስራኤለ ዛሪድ ዶራና፤ ኤንታ፥ ኤንታ ቡዞ ቢታን ዎና። በታንቾት ኤንታራ እስፋና፥ ያይቆባ ሶ አሳራ ኦይከታና። <verse eid="ISA 14:1"/><verse number="2" style="v" sid="ISA 14:2"/>ካዎተት ኤንታ፥ ኤንታ ቢታ ኤሀና። እስራኤለ አሳይ ኤንታና ማጫነ አደ አይለ ኦድ ጎዳ ቢታን ሃራና። ኤንቲ ባንታና ድእዳይሳታ ድአና፤ ባንታና ሃርዳይሳታ ሃራና።<verse eid="ISA 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3"/>ጎዳይ ህንተና፥ ህንተ ኡንኣፈ፥ መቱዋፐነ ህንተ ሃረትዳ ኢታ አይለተፈ ሸምፕስያ ዎደ፥ <verse eid="ISA 14:3"/><verse number="4" style="v" sid="ISA 14:4"/>ህንተ ባብሎነ ካዋ ቦላ ሀይሳዳ ያግድ ቀልቅሳና። ኡንኤይስ ዋንድ አግዴ? እያ ሀንቁዋ ሱላይ ዋንድ አትዴ? <verse eid="ISA 14:4"/><verse number="5" style="v" sid="ISA 14:5"/>ጎዳይ ካዎተታ ፃምኣነ ሃረይሳታ ጉምባ መንስ። <verse eid="ISA 14:5"/><verse number="6" style="v" sid="ISA 14:6"/>ኤንቲ አሳ ዛው ባይና ሀንቁዋን ሾጭዶሶና፤ ባንታና ፆንዳይሳታ ቃንፆና ኡንኤሸ ደእዶሶና። <verse eid="ISA 14:6"/><verse number="7" style="v" sid="ISA 14:7"/>ሽን ቢታ ኡባይ ሸምፕድ ደእስ፤ ኡፋይሳን የፅስ። <verse eid="ISA 14:7"/><verse number="8" style="v" sid="ISA 14:8"/>ሀር አቶሽን፥ ልባኖሰ ዝጋትነ ፂዳት ካዋ ኩንደን ኡፋይትድ፥ “ኔኒ ካዉያዳ ኩንድዳፐ ጉየ፥ ኑና ቃንፃናዉ የይ ባዋ” ያጎሶና። <verse eid="ISA 14:8"/><verse number="9" style="v" sid="ISA 14:9"/>ኔኒ ያ ዎደ፥ ስኦለይ ነና ሞካናዉ ጊግስ፤ እ ካሰ ቢታ ካለዳ አሳ ሞይትለታ፥ ነና ሳሮና መላ ደንስ፤ ቃስ ካሰ ካዎ ግድዳ ኡባ ኤንታ አራታፐ ደንድ ኤሴስ። <verse eid="ISA 14:9"/><verse number="10" style="v" sid="ISA 14:10"/>ኤንቲ ኡባይ ሀይሳዳ ያጋና። “ሄኮ ነካ ኑዳ ዎልቃ ያዳሳ፤ ኑ መላ ግዳዳሳ።” <verse eid="ISA 14:10"/><verse number="11" style="v" sid="ISA 14:11"/>ካሰ ዲ ዲፅን ሳበትያ ነ ቦንቾይ ሀእ ስኦለ ገልስ። ኦላ ኔኒ ዝንእያ ሂፃ፤ ጉፁነይ ኔኒ ማእያ አፍላ ግዳና ያጋና።<verse eid="ISA 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 14:12"/>ነኖ ዎንታ ናአዉ፥ ጉራ ባካላዉ፥ ሳሎፐ ዋና ኩንዳዲ? ነኖ ካዎተታ ካዉሽዳይሶ ዋና ቃንፀታዳ ሳአን ዎዲ?<note caller="-" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="REV 8:10">ቆን 8:10</ref>፤ <ref loc="REV 9:1">9:1</ref>.</char></note> <verse eid="ISA 14:12"/><verse number="13" style="v" sid="ISA 14:13"/>ኔኒ ነ ዎዛናን፥ “ታኒ ሳሎ ከያና፤ ታ ካዎተ አራታ ፆሳ ፆልንቶታፐ ቦላራ ዎና፤ ታኒ ፑደሀ ባጋ ጋፃን ሺቆ ደርያ ሁጰን ኡታና<note caller="-" style="x"><char style="xo" closed="false">14:13 </char><char style="xt" closed="false"><ref loc="MAT 11:23">ማቶ 11:23</ref>፤ <ref loc="LUK 10:15">ሉቃ 10:15</ref>.</char></note>። <verse eid="ISA 14:13"/><verse number="14" style="v" sid="ISA 14:14"/>ታኒ ሻራት ደእያ ቃ በሳፈ ቦላ አና፤ ታኒ፥ ታና ኡባፈ ቃ ፆሳ ዳንሳና” ያጋዳሳ። <verse eid="ISA 14:14"/><verse number="15" style="v" sid="ISA 14:15"/>ሽን ኔኒ ስኦለን፥ ህርክ ጪሞ ኦላን ዱገ የገታዳሳ።<verse eid="ISA 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 14:16"/>ነና በእዳይሳት፥ “ቢታ ቃዳይስ፥ ካዎተታ ኮኮርስዳይስ፥ <verse eid="ISA 14:16"/><verse number="17" style="v" sid="ISA 14:17"/>ሳኣ ቢታ ባዞ ከስዳይስ፥ ሳአን ደእያ ካታማታ ሽር የግዳይስ፥ ባ ቃሾ አሳታ የዶና እፅዳይስ ሀይሴ?” ያግድ ትሽ ኦድ ፄላና።<verse eid="ISA 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 14:18"/>ካዎተታ ካዎት ኡባይ ባ ዱፎን ዱፎን ቦንቾን ዝንአና። <verse eid="ISA 14:18"/><verse number="19" style="v" sid="ISA 14:19"/>ሽን ኔኒ እፀትዳ ታሸዳ ነ ዱፉዋፐ ጋፃ ሆለታዳሳ። ነ አሀይ ማሻን ሀይቅዳ አሀንነ ኦላን ደእያ ሹቻታኮ ዱገ ዎዳይሳታ አሀን ካመትስ። ኔኒ ቶሆን የትዳ አሀ መላ ግዳዳሳ። <verse eid="ISA 14:19"/><verse number="20" style="v" sid="ISA 14:20"/>ኔኒ ነ ቢታ ይስዳ ግሾነ ነ አሳ ዎዳ ግሾ ኤንታራ ሞገታካ። ኢታ ሱንይ ኮቻይ መርናዉ ፄገቶፎ። <verse eid="ISA 14:20"/><verse number="21" style="v" sid="ISA 14:21"/>ኤንቲ ደንድድ ቢታ ላቶና፤ ሳአ ኡባ ካታማ ፃላላ ኦና መላ ኤንታ አዋታ ናጋራ ግሾ፥ እያ ናይታ ዎናዉ ጊግስተ። <verse eid="ISA 14:21"/><verse number="22" style="v" sid="ISA 14:22"/>ታኒ “ኤንታ ቦላ ደንዳና፤ ኤንታ ሱን፥ ኤንታ ኮቻነ ኤንታ የለታ ባብሎነፐ ይሳና። <verse eid="ISA 14:22"/><verse number="23" style="v" sid="ISA 14:23"/>ታኒ ባብሎነ ቁፃረይ ደእያ በስነ ሃ ኤልያ በሲ ኦና፤ ታኒ ጋዶ ፕቶን እያ ፕታና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ISA 14:23"/></para>
  <para style="s1">አሶረይ ያና</para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያግድ ጫቅስ፦ “ታኒ ሀልችዳይሳዳ ሀናና፤ ታኒ ቆፕዳይሳዳ ፖለታና። <verse eid="ISA 14:24"/><verse number="25" style="v" sid="ISA 14:25"/>ታኒ አሶረ አሳ ታ ቢታን መንረና፤ ታ ደርያ ቦላ እያ የና። እያ ቃምባራይ ኤንታ ቦላፈ፥ እያ ቶሆይ ኤንታ ሀሽያፐ ክቻና” ያግስ። <verse eid="ISA 14:25"/><verse number="26" style="v" sid="ISA 14:26"/>ሳአ ኡባስ ቆፈትዳ ቆፋይ ሀይሳ፤ ካዎተታ ኡባ ቦላ ምጨትዳ ኩሸይካ ሀይሳ። <verse eid="ISA 14:26"/><verse number="27" style="v" sid="ISA 14:27"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳ ቆፕዳ ግሾ እያ ድጋናዉ ዳንዳኤይ ኦኔ? እያ ኩሸይ ምጨትስ፤ ሄሳ ጉየ ዛራናዉ ዳንዳኤይ ኦኔ?<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">እሳ 10:5-34</ref>፤ <ref loc="NEH 1:1-3">ናህ 1:1-3</ref>፤ <ref loc="ZEP 2:13-15">ሶፎ 2:13-15</ref>.</char></note><verse eid="ISA 14:27"/></para>
  <para style="s1">ፍልስፄመይ ያና</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28"/>ካዎይ አካዝ ሀይቅዳ ላይ ኦደትዳ ቃላይ ሀይሳ:<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="2KI 16:20">2 ካዎ 16:20</ref>፤ <ref loc="2CH 28:27">2 ታር 28:27</ref>.</char></note> <verse eid="ISA 14:28"/><verse number="29" style="v" sid="ISA 14:29"/>ህንተኖ ፍልስፄመ አሳዉ፥ ህንተና ሾጭዳ ፃምአይ መእዳ ግሾ ኡፋይቶፍተ። ሄ ሾሻ ኮቻፈ ሀሶይ ከያና፤ እያ ኮቻይ ቃስ ፆንገትያ ሾሽ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">14:29 </char><char style="xt" closed="false"><ref loc="JER 47:1-7">ኤርም 47:1-7</ref>፤ <ref loc="EZK 25:15-17">ህዝ 25:15-17</ref>፤ <ref loc="JOL 3:4-8">እዩ 3:4-8</ref>፤ <ref loc="AMO 1:6-8">አሞ 1:6-8</ref>፤ <ref loc="ZEP 2:4-7">ሶፎ 2:4-7</ref>፤ <ref loc="ZEC 9:5-7">ዛካ 9:5-7</ref>.</char></note> <verse eid="ISA 14:29"/><verse number="30" style="v" sid="ISA 14:30"/>ማንቆፈ ማንቆት ታ ቆሩዋን ሄመታና፤ መቶታንቾት ዎፑ ግድ ዝንአና። ሽን ታኒ ነ ኮቻ ኮሻን ዉርሳና፤ ኔፐ አትዳ ጉታ ዎና።<verse eid="ISA 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ISA 14:31"/>ነኖ ፐንግያዉ፥ ዬካ! ነኖ ካታማዉ፥ ዋሳ! ህንተኖ ፍልስፄመ አሳዉ፥ ህንተ ኡባይ ህርጋን ትልእተ! ፑደሀ ባጋፈ ጩይ ከይድ ዬስ፤ ሄ ጩጋፐ ዱፅድ ጉየ አተይ ባዋ። <verse eid="ISA 14:31"/><verse number="32" style="v" sid="ISA 14:32"/>ሄ ካዎተይ ኪትዳ አሳታስ ዎይግድ ዛራኔ? ጎዳይ ፅዮነ ኬፅን፥ ቆሄትዳ አሳይ እ ግዶን ቆሰትድ አትያ በሲ ደምስ።<verse eid="ISA 14:32"/></para>
  <chapter eid="ISA 14"/>
  <chapter number="15" style="c" sid="ISA 15"/>
  <para style="s1">ሞአበይ ያና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1"/>ሞአበ ቢታባ ጎዳይ ኦድዳ ቃላይ ሀይሳ:<note caller="-" style="x"><char style="xo" closed="false">15:1—16:14 </char><char style="xt" closed="false"><ref loc="ISA 25:10-12">እሳ 25:10-12</ref>፤ <ref loc="JER 48:1-47">ኤርም 48:1-47</ref>፤ <ref loc="EZK 25:8-11">ህዝ 25:8-11</ref>፤ <ref loc="AMO 2:1-3">አሞ 2:1-3</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ 2:8-11</ref>.</char></note> ሞአበን ደእያ ኤራ ካታማይነ ቂራ ካታማይ እስ ቃማ ላለትድ ይዶሶና። <verse eid="ISA 15:1"/><verse number="2" style="v" sid="ISA 15:2"/>ድቦናን ደእያ አሳይ ባንታ ኤቃ ኬን ዬካናዉ ቃ በሲ ከይዶሶና። ሞአበ አሳይ ነቦስነ መደባስ ዬኬስ። ሁጰ ኡባይ ቡሉሰትስ፤ ቡች ኡባይ ሜደትስ። <verse eid="ISA 15:2"/><verse number="3" style="v" sid="ISA 15:3"/>ኦገ ቦላ ካዮ ማኦ ማኦሶና፤ ፖቀ ቦላነ ዳባባ ኡባን ዬኮሶናነ አፉ ርጮሶና። <verse eid="ISA 15:3"/><verse number="4" style="v" sid="ISA 15:4"/>ሀሰቦና አሳይነ ኤላላ አሳይ ዋሶሶና፤ ኤንታ ዋሶይ ያሃፃ ጋካናዉ ስኤቴስ። ሄሳ ግሾ፥ ኦላስ ዳንጭዳ ሞአበ ዎታዳረት ባንታ ቃላ ቁ ኦድ ዋስዶሶና፤ ኤንታ ሸምፖይ ኮኮርስ። <verse eid="ISA 15:4"/><verse number="5" style="v" sid="ISA 15:5"/>ታኒ ሞአበስ ዎዛናፐ ዬካስ፤ እያን ደእያ አሳይ ዞኣረነ ኤግላት-ሸልሻ ካታማ ባቃትስ። ኤንቲ ሉህታ ኦግያን ዬክሸ ቦሶና፤ ባጋት ቃስ ሆሮናይማ ብያ ኦግያን፥ ባንታ ዩዋ ግሾ ዋሶ ጎችዶሶና። <verse eid="ISA 15:5"/><verse number="6" style="v" sid="ISA 15:6"/>ናምርማ ሃት መልዶሶና፤ ማታይ ምጭስ፤ አጫይ ሹልስ፤ ጭልኦባይ አይብካ ባዋ። <verse eid="ISA 15:6"/><verse number="7" style="v" sid="ISA 15:7"/>ሄሳ ግሾ፥ ኤንቲ ባንታ ሺሽዳ ሻሉዋነ ምንጃ ቶክ ኤክድ፥ አሀያ ምይ ደእያ ዛንጋራፐ ሄፍን ኤፎሶና። <verse eid="ISA 15:7"/><verse number="8" style="v" sid="ISA 15:8"/>ሞአበ ሄራ ኡባይ ዋሶ ፃላላ ግድስ፤ ኤንታ ዋሶይ ኤግላማነ ብኤር-ኤልመ ጋካናዉ ስኤቴስ። <verse eid="ISA 15:8"/><verse number="9" style="v" sid="ISA 15:9"/>ድሞና ሃት ሱ ግድዶሶና፤ ሽን፥ ሀእካ ታኒ ድሞና ካታማ ቦላ ካሰይሳፈ አያ መቶ ኤሀና። ሞአበፐ ከስ ኤክድ ባቃተይሳታ ቦላነ ሄ ቢታን አትዳይሳታ ቦላ ጋሞ የዳዳ ዉርሳና።<verse eid="ISA 15:9"/></para>
  <chapter eid="ISA 15"/>
  <chapter number="16" style="c" sid="ISA 16"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 16:1"/>ሞአበ አሳዉ፥ ባዞ ብያ ኦግያን ደእያ ሴላፐ ኡርገ ዶርሳታ እሞታ ኦድ፥ የሩሳላመን ደእያ ቢታ ሃረይሳስ የድተ። <verse eid="ISA 16:1"/><verse number="2" style="v" sid="ISA 16:2"/>ሞአበ ማጫሳይ ባንታ ኬፈ ጎደትዳ ካፎታዳ አርኖና ሻፋ ፕንያ በሳን ላለታና። <verse eid="ISA 16:2"/><verse number="3" style="v" sid="ISA 16:3"/>ሞአበ አሳይ ይሁዳ አሳኮ፥ “ኑና ዞርተ፤ ኑና ኑ ሞርከታፐ አሽተ፤ ሴታ ጋላሳን ም ኩያዳ ህንተ ኩያ ኑ ቦላ ኩያይተ። ጎደተይሳታ ቆስተ፤ ቆሰትዳይሳታ አድ እሞፕተ። <verse eid="ISA 16:3"/><verse number="4" style="v" sid="ISA 16:4"/>ሞአበፐ ጎደተይሳት ህንተ ግዶን ደኦ፤ ኤንታ ይሳናዉ ኮየይሳታፐ ቆሰትድ አትያ በሰ ግድተ። ኤንታ ኡንኤይሳት ዉርዶሶና፤ ኤንታ ዮይ አትስ፤ ኦቶራንቾት ቢታፈ ይዶሶና። <verse eid="ISA 16:4"/><verse number="5" style="v" sid="ISA 16:5"/>ሄሳፈ ጉየ፥ ሲቆን እስ ካዎተ አራታይ ኤቃና፤ ሄ አራታን፥ ዳዊታ ኮቻፈ እስ አማነትያ ካዎይ ኡታና። እ ሱረተ ኮያና፤ ፅሎተ ኦናዉ ኤለሳና” ያጋና።<verse eid="ISA 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 16:6"/>ይሁዳ አሳይ፥ “ሞአበ አሳይ አይ መላ ኦቶርያኮ ኑ ኤንታ ኦቶሩዋ ስእዳ፤ ኤንታ ጬቁዋነ ኤንታ ጫሻ ስእዳ፤ ሽን ኤንታ ኦቶሮይ ሀዳ” ያጋና።<verse eid="ISA 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 16:7"/>ሄሳ ግሾ፥ ሞአበይ ባዉ ዬኮ፤ አስ ኡባይካ ሞአበስ ዬኮ። ቅር-ሄሬሳን ህንተ ደእያ ዎደ ምዳ ሎኦ ካ ሀሳይሸ ዬክተ። <verse eid="ISA 16:7"/><verse number="8" style="v" sid="ISA 16:8"/>ሀሰቦና ጎሻይነ ሰባማ ዎይነ ጋደይ ይስ። ካዎተታ ሀላቃት የረዳ ታሸት መላ ቢታ ካንድ ያእዜራ ጋክዶሶና፤ ኤንታ አጫይ ዳይድ፥ አባ ፕንስ። <verse eid="ISA 16:8"/><verse number="9" style="v" sid="ISA 16:9"/>ታኒ ያእዜራ ካታማስ ዬክዳይሳዳ ሰባማ ካታማ ዎይነታስ ዬካይስ። ሀሰቦና ካታማስነ ኤልኣላ ካታማስ፥ ታኒ ታ አፉ ጉሳይስ። ህንተ ም አይፍያነ ህንተ ቦትዳ ካ ቦላ ኦል ደንድስ። <verse eid="ISA 16:9"/><verse number="10" style="v" sid="ISA 16:10"/>ጎሻ ጋድያፐ ኡፋይስነ ሀሹ ጉስ ኤከትስ። ዎይነ ጋድያን ማዝሙረይ የፀተና። ኡፋይሳን ዎይነ ጉምእያ በሳን ጉምእያ አስ ባዋ፤ ታኒ ጉምኤይሳታ እልልሳ ይሳስ። <verse eid="ISA 16:10"/><verse number="11" style="v" sid="ISA 16:11"/>ሄሳ ግሾ፥ ታ ዎዛናይ ሞአበስ፥ ታ ጋርሳ አሳተይካ ቅር-ሄሬሳስ ዬኬስ። <verse eid="ISA 16:11"/><verse number="12" style="v" sid="ISA 16:12"/>ሞአበይ ባ ዙማ ቦላ ከይኮካ፥ ባና ጮ ዳቡርሴስ፤ እ ዎሳናዉ ባ ኤቃ ኬ ገልኮካ ባና አይኮካ ማደና።<verse eid="ISA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13"/>ጎዳይ ካሰትድ ሞአበባ ኦድዳ ቃላይ ሀይሳ። <verse eid="ISA 16:13"/><verse number="14" style="v" sid="ISA 16:14"/>ሽን ሀእ ጎዳይ፥ “ኡነ ኦሳንቾ ዎደይ ጉ ግደይሳ መላ ሞአበ ቦንቾይነ እያ ዳሮተይ ሄ ላይ ግዶን ዉራና። እያን አትያ አሳይ ፓናይሳታነ ዎልቅ ባይናይሳታ ግዳና” ያጌስ።<verse eid="ISA 16:14"/></para>
  <chapter eid="ISA 16"/>
  <chapter number="17" style="c" sid="ISA 17"/>
  <para style="s1">ዳማስቆይ ያና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1"/>ዳማስቆባ ጎዳይ ሀይሳዳ ያጌስ፦ “ሄኮ፥ ህዛፐ ጉየ ዳማስቆይ ካታማ ግዶኖሽን፥ ላለ ዶረ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="JER 49:23-27">ኤርም 49:23-27</ref>፤ <ref loc="AMO 1:3-5">አሞ 1:3-5</ref>፤ <ref loc="ZEC 9:1">ዛካ 9:1</ref>.</char></note> <verse eid="ISA 17:1"/><verse number="2" style="v" sid="ISA 17:2"/>አሮራ ካታማት አስ ባይና ባይሳ ቢታ ግዳና፤ ያን መሄይ ሄመታና፤ ኤንታ ያሽያባይ ዴና። <verse eid="ISA 17:2"/><verse number="3" style="v" sid="ISA 17:3"/>ኤፍሬማፐ ሚፃት፥ ዳማስቆፈ ካዎተይ ያና፤ ሶረፐ አትዳ ጉት እስራኤለ አሳ ቦንቹዋ መላ ግዳና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ISA 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 17:4"/>“ሄ ዎደ እስራኤለ ቦንቾይ ቃረታና፤ እያ ኦርደተይ ግልቃና። <verse eid="ISA 17:4"/><verse number="5" style="v" sid="ISA 17:5"/>እስራኤለይ፥ ካ ጫክ ኤክድ ከይዳ ጎሻ ጋደ መላ ግዳና፤ ዎይኮ ካ ጫክ ስምን ካሎትዳ ራፋይመ ዛንጋራ መላ ግዳና። <verse eid="ISA 17:5"/><verse number="6" style="v" sid="ISA 17:6"/>ሻማሆ ቆቆፍ ስምን፥ ፄራን ናምኡ ዎይኮ ሄ አይፈት አተይሳዳ ዎይኮ እስ ያንግያ ቦላ ኦይዱ ዎይኮ እቻሹ አይፈት አተይሳዳ እስራኤለፐ ጉት አታና” ያጌስ ጎዳይ እስራኤለ ፆሳይ።<verse eid="ISA 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 17:7"/>ሄ ጋላስ አሳይ ባንታና መዳይሳኮ፥ ባንታ አይፍያካ እስራኤለ ጌሻኮ ዛራና። <verse eid="ISA 17:7"/><verse number="8" style="v" sid="ISA 17:8"/>ኤንቲ ባንታ ኩሸን ጊግስዳ ያርሾ በሳኮ ፄሎኮና፤ አሼራ ኤቃ ምስልያስ ግድን፥ እፃነ ጩይሳናዉ ኤንቲ ባንታ ኩሸን መዳ ያርሾ በሳ ቦንቾኮና።<verse eid="ISA 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9"/>ሄ ዎደ እስራኤለ አሳ ጋሶን ህወነ አሞረ ካታማት ላለትዳይሳዳ ኤንታ ምኖ ካታማት ላለታና፤ ባይሳ ግዳና። <verse eid="ISA 17:9"/><verse number="10" style="v" sid="ISA 17:10"/>ህንተ ህንተና አሽያ ፆሳ ዶግደታ፤ ህንተ ቆሰት አትያ ዛላ ቆፕበከታ። ሄሳ ግሾ፥ ኔኒ ሎኦ ምነ ካረ ቢታፈ ይዳ ሎኦ አታክልትያ ቶክኮካ፥ <verse eid="ISA 17:10"/><verse number="11" style="v" sid="ISA 17:11"/>ሄ ጋላስ ኤንቲ ድጭድ ጋካና መላ ኦኮካ፥ ቃስ ኔኒ ዘርዳ ዎንተ ኤንቲ ጪያኮካ ኔኒ አይፈ ደማካ። እያ በሳን ፓፆና ሀርገነ መቶ ጫካና።<verse eid="ISA 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 17:12"/>ሄኮ፥ አባ ቤታዳ ጉምያ ዳሮ አሳ፥ ቃስ ዎልቃማ ሃዳ ዋስያ ካዎተታ አየ! <verse eid="ISA 17:12"/><verse number="13" style="v" sid="ISA 17:13"/>ካዎተት ዳሮ ሃዳ ጉሞሶና፤ ሽን ጎዳይ ኤንታ ሴራና። ኤንቲ ዙማ ሁጰን ደእያ ቡረ ጫርኮይ ደንይሳዳነ ጎተይ ባና ደንይሳዳ ኤንታ ደንድ ሃሆ በሲ ላላና። <verse eid="ISA 17:13"/><verse number="14" style="v" sid="ISA 17:14"/>ሳእ ቃምያ ዎደ ኤንቲ ዳጋማና፤ ሳእ ዎንታናፐ ስን ኤንቲ ያና። ኑና ዎልቃን ኤከይሳታነ ቦንቀይሳታ ቃዳይ ሀይሳ።<verse eid="ISA 17:14"/></para>
  <chapter eid="ISA 17"/>
  <chapter number="18" style="c" sid="ISA 18"/>
  <para style="s1">ቶጰ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 18:1"/>ቶጰ ሻፋታፐ ሄፍንን ጊርያ ቀፈት ደእያ ቢታ አየ! <verse eid="ISA 18:1"/><verse number="2" style="v" sid="ISA 18:2"/>ሄ ቢታይ፥ ኪተትያ አሳታ ማይረ ዎጎሎን ዎድ ናይለ ሻፋ ቦላራ ኪቴስ። ህንተኖ፥ ኤሶን ኪተተይሳቶ፥ አዱሰነ ሊቆ አሳኮ፥ ማታንነ ሃሆን ያሽያ አሳኮ፥ ዎልቃማነ ፆንያ ካዎተኮ፥ ሻፋን ኤንታ ዛዋይ ሻከትዳ ቢታኮ ቢተ።<verse eid="ISA 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 18:3"/>ህንተኖ፥ ሳአን ደእያ ኡባቶ፥ ህንተኖ፥ ቢታን ደኤይሳቶ፥ ዙማ ቦላ ማል ኤቅያ ዎደ ህንተ በአና፤ ሞይዘይ ፑነትያ ዎደ ህንተ ስአና። <verse eid="ISA 18:3"/><verse number="4" style="v" sid="ISA 18:4"/>ጎዳይ ታኮ፥ “ሴታ ጋላስ ስእ ግድ ፖእያ አዋዳ፥ ቃስ ካ ጫክያ አጌናን፥ ሆምብያ ቃማን በንትያ አካ መላ ታኒ ስእ ጋዳ፥ ታ ደእያ በሳፈ ዱገ ፄላና” ያግስ። <verse eid="ISA 18:4"/><verse number="5" style="v" sid="ISA 18:5"/>ካ ጫክያ ዎድያፐ ካሰ፥ ጪሻይ ቆለትድ ስምን፥ ዎይነ ቴርያ ዎደ ኦጮ ባጫን ፄራ ቃንፀይሳዳ እ ሄ ቢታ አሳ ይሳና። <verse eid="ISA 18:5"/><verse number="6" style="v" sid="ISA 18:6"/>ኤንቲ ኡባይ ደርያ ሁጵያን ደእያ፥ ምያባ ዎችያ ካፎታስነ ዶአታስ አታና። ካፎት ባልጎን፥ ዶአት ቦነን ኤንታ ምድ ሻጫና።<verse eid="ISA 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 18:7"/>ሄ ዎደ አዱሰነ ሊቆ አሳፐ፥ ማታንነ ሃሆን ያሽያ አሳፐ፥ ዎልቃማነ ፆንያ ካዎተፈ፥ ዛዋይ ሻፋን ሻከትዳ ቢታፈ፥ ኡባፈ ዎልቃማ ጎዳስ እሞት ፅዮነ ዙማ፥ እያ ሱንይ ደእያ በሳ ያና።<verse eid="ISA 18:7"/></para>
  <chapter eid="ISA 18"/>
  <chapter number="19" style="c" sid="ISA 19"/>
  <para style="s1">ግብፀስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1"/>ግብፀ ቦላ ጎዳይ ሀይሳዳ ያግድ ኦድስ:<note caller="-" style="x"><char style="xo" closed="false">19:1 </char><char style="xt" closed="false"><ref loc="JER 46:2-26">ኤርም 46:2-26</ref>፤ <ref loc="EZK 29:1-32:32">ህዝ 29:1—32:32</ref>.</char></note> “ሄኮ፥ ጎዳይ ኤሶትያ ሻራ ቶግድ፥ ግብፀ ዬስ። ግብፀ ኤቃት እያ ስንን ኮኮራና፤ ግብፀ አሳ ዎዛናይ ያሻን ትልአና። <verse eid="ISA 19:1"/><verse number="2" style="v" sid="ISA 19:2"/>ግብፀ አሳ እሱዋ እሱዋ ቦላ ደንና። እሻይ እሻ ቦላ፥ ሾሮይ ሾሩዋ ቦላ፥ ካታማይ ካታማ ቦላ፥ ካዎተይ ካዎተ ቦላ ደንዳና። <verse eid="ISA 19:2"/><verse number="3" style="v" sid="ISA 19:3"/>ግብፀ አሳይ ኤሾ ያና፤ ታኒ ኤንታ ሀልቹዋ ሀዳ ኦና። ኤንቲ ባንታ ኤቃታ፥ ሞይትለራ ኦደተይሳታ፥ ብታንቾታነ ማሮታ ዞረ ኦይቻና። <verse eid="ISA 19:3"/><verse number="4" style="v" sid="ISA 19:4"/>ታኒ ዎዛና ምኖ ግድዳ ግብፀ ካዋ ኩሸን አዳ እማና፤ እ ኤንታ ሃራና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ISA 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 19:5"/>ናይለ ሻፋ ጉፅ ጉፅ ባና፤ ሃይካ መላና። <verse eid="ISA 19:5"/><verse number="6" style="v" sid="ISA 19:6"/>ዋይ ፅንቃና፤ ግብፀ ሃት ጉፃናነ መላና፤ ማይረይነ ማቃይ ሹላና፤ <verse eid="ISA 19:6"/><verse number="7" style="v" sid="ISA 19:7"/>ናይለ ሻፋ ጋፃን ደእያ ጭልኦባይ መላና፤ እያ ሄራን ዘረትዳ ካ ኡባይ መላናነ ያና። <verse eid="ISA 19:7"/><verse number="8" style="v" sid="ISA 19:8"/>ሞሎ ኦይከይሳት ካዮታና፤ ናይለ ሻፋን ግተነ ሞሎ ማንፃቆ የግያ ኡባይ ዬካናነ ዶጫና። <verse eid="ISA 19:8"/><verse number="9" style="v" sid="ISA 19:9"/>ፓደትዳ ታልባፈ ሊኖ ማኦ ኦይሳት፥ ቦ ማኦ ዳድያ ዶርዘት ኡፋይስ ቃንፃና። <verse eid="ISA 19:9"/><verse number="10" style="v" sid="ISA 19:10"/>ፒቀይሳትነ ኡነ ኦያ ኡባይ ካዮታና።<verse eid="ISA 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 19:11"/>ፆኣነ ሃረይሳት ኤያ፤ ግብፀ ካዋ ዞርያ ጭንጫት ፓና ዞረ ዞሮሶና። ያትን፥ ህንተ ግብፀ ካዋኮ፥ “ኑኒ ጭንጫታ ናይታ፤ ኑኒ በን ካዎታ ናይታ” ጋናዉ ዋንድ ዳንዳኤቲ? <verse eid="ISA 19:11"/><verse number="12" style="v" sid="ISA 19:12"/>ያትን፥ ነ ጭንጫ አሳት ሀእ አዉን ደኦና? ኡባፈ ዎልቃማ ጎዳይ ግብፀ ቦላ ኦናዉ ሀልችዳባ አነ ኤንቲ ነዉ ኦዶነ ነና ኤርሶና። <verse eid="ISA 19:12"/><verse number="13" style="v" sid="ISA 19:13"/>ፆኣነ ሃረይሳት ኤይዶሶና፤ መምፕሳ ሃረይሳት ጭመትዶሶና። ግብፀ ዞርያ ግታ አሳት እያ ባለዶሶና። <verse eid="ISA 19:13"/><verse number="14" style="v" sid="ISA 19:14"/>ጎዳይ ኤንታ ግዶን ኤይስያ አያና የድስ፤ ኤንቲ ማትዳ አስ ባ ጮሻን ጎንዶረተይሳዳ ግብፀይ ባ ኦሶ ኡባን ጎንዶረታና መላ ኦዶሶና። <verse eid="ISA 19:14"/><verse number="15" style="v" sid="ISA 19:15"/>ዛምቦይ ዎይኮ ቦዝ፥ ዛምባ ታሸይ ዎይኮ ማይረይ ግብፀን ኦናባይ አይብካ ባዋ።<verse eid="ISA 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16"/>ሄ ጋላስ ግብፀ አሳይ ማጫሳ መላ ግዳና። ኤንቲ ኡባፈ ዎልቃማ ጎዳይ ኤንታ ቦላ ቃያ እያ ኩሽያ በእድ ያሻን ኮኮራና። <verse eid="ISA 19:16"/><verse number="17" style="v" sid="ISA 19:17"/>ይሁድ ግብፀ ያሽሳና፤ ኡባፈ ዎልቃማ ጎዳይ ኤንታ ቦላ ኦናዉ ቆፕዳ ቆፋ ግሾ ይሁዳባ ስእያ ኡባይ ያያና።<verse eid="ISA 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18"/>ሄ ጋላስ ግብፀ ቢታን ደእያ እቻሹ ካታማት ካናነ ቃላን ኦደተይሳታነ ኡባፈ ዎልቃማ ጎዳስ አማነታናዉ ጫቀይሳታ ግዳና። ሄ ካታማታፐ እሶይ፥ “አዋ ካታማ” ጌተትድ ፄገታና።<verse eid="ISA 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19"/>ሄ ዎደ ግብፀ ቢታስ ግዱዋን፥ ጎዳስ ያርሾ በሳይ ጊጋና፤ ቃስ ግብፀ ቢታ ዛዋን ጎዳስ ቱስ ኤቃና። <verse eid="ISA 19:19"/><verse number="20" style="v" sid="ISA 19:20"/>ሄስ ኡባፈ ዎልቃማ ጎዳስ ግብፀ ቢታን ማላነ ማርካ ግዳና። ኤንቲ ባንታና ኡንኤይሳታ ግሾ ጎዳኮ ዋስያ ዎደ ኤንታዉ አሸይሳ ኪትድ ኤንታ አሻና። <verse eid="ISA 19:20"/><verse number="21" style="v" sid="ISA 19:21"/>ሄ ዎደ ጎዳይ ግብፀ ቢታን ኤረትዳይሳ ግዳና፤ ግብፀ አሳይ ሄ ጋላስ ጎዳ ኤራና። ያርሾነ ካ ያርሾ ኤክ ይድ እያ ጎይናና። ኤንቲ ጎዳስ ቃንጋናነ ባንታ ቃንገ ጋና። <verse eid="ISA 19:21"/><verse number="22" style="v" sid="ISA 19:22"/>ጎዳይ ግብፀ ቢታ ሾጫና፤ እዮ ዛሪድ ፓና። ኤንቲ ጎዳኮ ስማና፤ እ ኤንታ ዎሳ ስእድ ፓና።<verse eid="ISA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23"/>ሄ ጋላስ ግብፀፈ አሶረ ጋካናዉ ዳልጋ ኦገይ ከያና፤ አሶረ አሳይ ግብፀ፥ ግብፀ አሳይ አሶረ ስመረታና፤ ግብፀ አሳይ አሶረ አሳራ እስፈ ጎይናና። <verse eid="ISA 19:23"/><verse number="24" style="v" sid="ISA 19:24"/>ሄ ጋላስ እስራኤለይ ግብፀራነ አሶረራ ሄን ቢታ ግድድ፥ ሳኣስ አንጆ ግዳና። <verse eid="ISA 19:24"/><verse number="25" style="v" sid="ISA 19:25"/>ኡባፈ ዎልቃማ ጎዳይ ኤንታ ሀይሳዳ ያግድ አንጃና፦ “ታ አሰ ግድዳ ግብፀይ አንጀቶ፤ ታ ኩሸ ኦሶ ግድዳ አሶረይ አንጀቶ፤ ታ ላታ ግድዳ እስራኤለይ አንጀቶ” ያጋና።<verse eid="ISA 19:25"/></para>
  <chapter eid="ISA 19"/>
  <chapter number="20" style="c" sid="ISA 20"/>
  <para style="s1">ግብፀነ ቶጰ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1"/>አሶረ ካዎይ ሳርጎን ኪትዳ ቶራ ሞጮናት ይድ፥ ፍልስፄመ ካታማ ግድዳ አሽዶዳ ኦልድ ኦይክዳ ላይ፥ <verse eid="ISA 20:1"/><verse number="2" style="v" sid="ISA 20:2"/>ጎዳይ አሞፀ ናኣ እሳያሳ ሀይሳዳ ያግስ፦ “ነ ካዮ ማኡዋ ቃራ፤ ነ ቶሁዋፐ ጫማ ከሳ” ያግስ። እሳያስ ጎዳይ ግዳይሳዳ ኦድ ካሎነ መላ ቶሆን ሄመትስ።<verse eid="ISA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3"/>ያትን ጎዳይ ሀይሳዳ ያግስ፦ “ታ አይለይ እሳያስ ግብፀነ ቶጰ ቦላ ጋካና መቱዋስ ማላ ግዳና መላ ሄ ላይ ካሎነ መላ ቶሆን ሄመትስ። <verse eid="ISA 20:3"/><verse number="4" style="v" sid="ISA 20:4"/>ሄሳ ግሾ አሶረ ካዎይ፥ ግብፀታስ ዬላ ግዳና መላ ግብፀፈነ ቶጰፈ ድኤትዳ ናአተታነ ጭማታ ካሎነ መላ ቶሆ ላግድ ኤፋና። <verse eid="ISA 20:4"/><verse number="5" style="v" sid="ISA 20:5"/>ቶጰን አማነተይሳትነ ግብፀን ጬቀተይሳት ያያና፤ ዬላታና። <verse eid="ISA 20:5"/><verse number="6" style="v" sid="ISA 20:6"/>ሄ ጋላስ አባ ጋፃን ደእያ አሳይ ሀይሳዳ ያጋና፦ ‘ኑና አሶረ ካዉዋፐ አሻና ግድ ኡፋይስ ኦድ ኤንታኮ ባቃትዳ አሳ ቦላ ሀይስ ጋክኮ፥ ያትን፥ ኑኒ ዋንድ ከስ ኤካኔ?’ ያጋና” ያግስ።<verse eid="ISA 20:6"/></para>
  <chapter eid="ISA 20"/>
  <chapter number="21" style="c" sid="ISA 21"/>
  <para style="s1">ባብሎነ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1"/>አባ ማታን ደእያ ባዙዋስ ኦደትዳ ቃላ።</para>
  <para style="p" vid="ISA 21:1">ናገበ ጎተይ መንረሸ የይሳዳ ኦላንቾይ ባዞፈ፥ ዮ ቢታፈ ዬስ።<verse eid="ISA 21:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 21:2"/>ታኒ እስ ያሽያ ቆንጨ በአስ፤ አድ እመይስ አድ እሜስ፤ ድኤይስ ድኤስ። ኤላማ ከያ! ሜዶና ካታማ ኦይካ! ባብሎነይ ጋዳ ዋይያ ታኒ ድጋና።<verse eid="ISA 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 21:3"/>ሄሳ ግሾ ታ አሳተይ ሳከትስ፤ ማጫስ ኤቀተይሳዳ ታኒ ኡንኤታስ። ታኒ ስእያባይ ታና ኮኮርስስ፤ ታኒ በእያባይ ታና ዳጋንስ። <verse eid="ISA 21:3"/><verse number="4" style="v" sid="ISA 21:4"/>ታና ቢጮዬስ፤ ያሻን ኮኮራስ፤ ታኒ ኡፋይስ ዎዳ ኦማርሳይ ኡንአን ላመትስ።<verse eid="ISA 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 21:5"/>ግብራ ጊግስዶሶና፤ ኡትያ ሶ ጊግስዶሶና፤ ማናዉነ ኡያናዉ ኡትዶሶና። ህንተኖ ሀላቃቶ፥ ደንድተ! ህንተ ጎንዳልያ ቁችተ!<verse eid="ISA 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 21:6"/>ጎዳይ ታኮ ሀይሳዳ ያግስ፦ “ባዳ ሀንያባ ዎችድ ነዉ ኦድያ አስ ዎ። <verse eid="ISA 21:6"/><verse number="7" style="v" sid="ISA 21:7"/>ፓራት ጋረ ጎችያ ዎደ፥ ሀረነ ግማለ ቶገይሳታ በእያ ዎደ፥ ሎይድ ፄሎ፤ አኬክድ በኦ” ያግስ።<verse eid="ISA 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 21:8"/>ዎቸይስ፥ “ጎዳዉ፥ ጋላስነ ቃማ ፓጭ ባይና ታ ሻኩዋ ቦላ ኡታዳ ናጋይስ። <verse eid="ISA 21:8"/><verse number="9" style="v" sid="ISA 21:9"/>ሄኮ፥ ናምአ ናምአ ግድድ ፓራ ጋረ ቶግዳ አሳት ዮሶና” ያግስ። እ ቃስካ፥ “ባብሎነይ ኩንድስ፤ እያ ፆሳታ ምስለት ሳአን ኩንድድ ጋጨትዶሶና” ያግድ ዋስስ። <verse eid="ISA 21:9"/><verse number="10" style="v" sid="ISA 21:10"/>ህንተኖ፥ ዉዱማን ጋጨትዳ ታ አሳዉ፥ ኡባፈ ዎልቃማ ጎዳፐ፥ እስራኤለ ፆሳፈ ስእዳባ ታኒ ህንተዉ ኦዳይስ።<verse eid="ISA 21:10"/></para>
  <para style="s1">ኤዶመ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11"/>ኤዶመባ ጎዳይ ሀይሳዳ ያግስ፦ “እስ አስ ሳይረፐ ታና ፄግድ፥ ናገይሶ፥ ሳእ ዎንታናዉ አይ ማል አትዴ? ናገይሶ፥ ሳእ ጌያናዉ አይ ማል አትዴ?” ያጌስ። <verse eid="ISA 21:11"/><verse number="12" style="v" sid="ISA 21:12"/>ናገይስ ዛሪድ፥ “ሳእ ዎንታና ሀኔስ፤ ሽን ዛር ቃማና። ህንተ ኦይቻናዉ ኮይኮ ኦይችተ፤ ስም ይድ ኦይችተ” ያግስ።<verse eid="ISA 21:12"/></para>
  <para style="s1">አራበ ቦላ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13"/>አራበ ባ ጎዳይ ሀይሳዳ ያጌስ፦ “ህንተኖ ዳዳና ዛልአንቾቶ፥ ህንተ፥ ህንተ ጫና ግማለታራ አራበ መላ ቢታን አቃና። <verse eid="ISA 21:13"/><verse number="14" style="v" sid="ISA 21:14"/>ህንተኖ፥ ቴማን ቢታን ደእያ አሳዉ፥ ሳሞትዳይሳታስ ሃ ኤህተ፤ ኮሻትዳይሳታስ ካ እምተ። <verse eid="ISA 21:14"/><verse number="15" style="v" sid="ISA 21:15"/>ኤንቲ ማሻፈ፥ ሾሆፔ ሾደትዳ ማሻፈ፥ ዳፈትዳ ዶንገፈነ ምኖ ኦላፐ ባቃቶሶና” ያጌስ።<verse eid="ISA 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16"/>ጎዳይ ታኮ ሀይሳዳ ያግስ፦ “ኡነ ኦሳንቾ ዎደይ ዉረይሳዳ፥ እስ ላይ ግዶን ቀዳረ ቦንቾ ኡባይ ዉራና። <verse eid="ISA 21:16"/><verse number="17" style="v" sid="ISA 21:17"/>ቀዳረን ደእያ ዶንገን ዱክያ ዎልቃማ ኦላንቾታፐ ጉት አታና፤ ጎዳይ እስራኤለ ፆሳይ ሄሳ ኦድስ” ያግስ።<verse eid="ISA 21:17"/></para>
  <chapter eid="ISA 21"/>
  <chapter number="22" style="c" sid="ISA 22"/>
  <para style="s1">የሩሳላመስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1"/>“ቆንጨ ዛንጋራ” ጌተትያ በሳባ ጎዳይ ኦድዳ ቃላ። ህንተና ኡባ አይብ ኡንኤን ፖቀ ኬ ቦላ ከይደቲ? <verse eid="ISA 22:1"/><verse number="2" style="v" sid="ISA 22:2"/>ነኖ ዋሶይ፥ ድርጎይነ ዎጫም ኩምዳ ካታማዉ፥ ነ ግዶን ሀይቅዳ አሳት ማሻን ዎይኮ ኦላን ሀይቅቦኮና። <verse eid="ISA 22:2"/><verse number="3" style="v" sid="ISA 22:3"/>ህንተ ሀላቃት ኡባይ እስፈ ባቃትዶሶና፤ ኤንቲ ዶንገይ ባይና ጮ ድኤትዶሶና። ኤንቲ ሃክድ ባቃትኮካ በትዳ ኡባይ ኦይከትዶሶና። <verse eid="ISA 22:3"/><verse number="4" style="v" sid="ISA 22:4"/>ሄሳ ግሾ፥ “ታና አጋግተ፤ ታ አሳስ ምሻ ዬሆ አፉፃዳ ዬካና፤ ታ አሳ ዩዋስ ታና ምንፕተ” ያጋስ። <verse eid="ISA 22:4"/><verse number="5" style="v" sid="ISA 22:5"/>ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ ቆንጨ ዛንጋራን ዳጋማ፥ የተነ ኡንአ ጋላስ ኦስ፤ ቃስ ግምበት ዎድያ ጋላስነ ደረታኮ ማዴስ ዋስያ ጋላስ ኦስ።<verse eid="ISA 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 22:6"/>ኤላም ባ ፓራ ጋረታራነ ፓራ አሳታራ ባ ዶንግያ ኦይክድ ይስ፤ ቂራ ዎታዳረት ባንታ ጎንዳለታ ጊግስዶሶና። <verse eid="ISA 22:6"/><verse number="7" style="v" sid="ISA 22:7"/>ህንተ ሎኦ ዛንጋራት ፓራ ጋረታን ኩምዶሶና፤ ፓራ አሳት የሩሳላመ ፐንግያ ስንን ኤቅዶሶና። <verse eid="ISA 22:7"/><verse number="8" style="v" sid="ISA 22:8"/>እ ይሁዳ ሚፃታ ቃርስ። ሄ ጋላስ ዎራ ኬን ደእያ ካዋ ኦላ ሚሸታ በእደታ። <verse eid="ISA 22:8"/><verse number="9" style="v" sid="ISA 22:9"/>ዳዊታ ካታማ ግዶን ላለ ዶርያ በእደታ፤ ጋርሳ ባጋን ደእያ ኦላን ሃ ኩንደታ። <verse eid="ISA 22:9"/><verse number="10" style="v" sid="ISA 22:10"/>የሩሳላመን ደእያ ኬታ ታይብደታ፤ ድርሳ ዛሪድ ግምባናዉ ኬታ ላልደታ። <verse eid="ISA 22:10"/><verse number="11" style="v" sid="ISA 22:11"/>ካሰ ጋልአ ዜሩዋን ደእያ ሃ ዛሪድ፥ ናምኡ ግምበታፐ ግዱዋን ኦላ ጊግስደታ። ሽን ህንተ ሄሳ መዳ ፆሳ አኬክበከታ፤ ዎይኮ ዳሮ ዎደፐ ስን ሄሳ ሀልችዳይሳ ሀሳይበከታ።<verse eid="ISA 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 22:12"/>ሄ ጋላስ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ ህንተና ዬሆስነ ዘለልሳስ፥ ሁጰ ቡሉሳናዉነ ካዮ ማኦ ማአናዉ ፄግስ። <verse eid="ISA 22:12"/><verse number="13" style="v" sid="ISA 22:13"/>ሽን ህንተ ሄሳ አግድ ኡፋይተታነ የፄታ፤ ቦሩነ ዶርሰ ሹኬታ፤ አሹዋ ሜታ፤ ዎይነ ኡዬታ። ኑኒ “ዎንቶ ሀይቃናዉ ደእያ ግሾ፥ ሀች ማናነ ኡያና” ያጌታ።<verse eid="ISA 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 22:14"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳ ታዉ ቆንጭስስ፤ “ህንተ ሀይቃና ጋካናዉ ሀ ናጋራይ ህንተዉ አቶ ጌተተና። ታኒ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ ሀይሳ ኦዳይስ” ያግስ።<verse eid="ISA 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15"/>ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ “ባዳ ካዎ ጋን ሹመትዳ ሳምናሳኮ ሀይሳዳ ያጋ፤ <verse eid="ISA 22:15"/><verse number="16" style="v" sid="ISA 22:16"/>ኔኒ ሀይሳን አይ ኦይ? ኔኒ ሀይሳን፥ ዛላ ዎጫዳ ዱፎ ጊግሳና መላ፥ ቃ በሳን ነዉ ዱፎ ቦካና መላነ ዛላ ዎጫዳ ነዉ ሸምፖ በሲ ኦና መላ ኦና ኦይቻዲ? <verse eid="ISA 22:16"/><verse number="17" style="v" sid="ISA 22:17"/>ነኖ ምኖ አድያዉ፥ ነና ጎዳይ ምንድ ኦይካና፤ ጩጩምድ ዎራ ሆላና። <verse eid="ISA 22:17"/><verse number="18" style="v" sid="ISA 22:18"/>ኮሰዳ ነና ዩሽድ ዳልጋ ቢታን ሆላና። ነኖ ነ ጎዳ ኬስ ዬላ ግድዳ አድያዉ ኔኒ ያን ሀይቃና፤ ነ ቦንቾ ፓራ ጋረት ያን አታና። <verse eid="ISA 22:18"/><verse number="19" style="v" sid="ISA 22:19"/>ታኒ ነና ነ ኦሱዋፐ ከሳና፤ ነ ሹማተፈ ሻራና። <verse eid="ISA 22:19"/><verse number="20" style="v" sid="ISA 22:20"/>ሄ ጋላስ ታኒ ካልቀ ናኣ፥ ታ አይልያ ኤልያቄመ ፄጋና። <verse eid="ISA 22:20"/><verse number="21" style="v" sid="ISA 22:21"/>ታኒ ነ ማኡዋ እያ ማይዛና፤ ነ ዳንጩዋ እያ ዳንጭሳና፤ ነ ሹማተ እያዉ እማና። እ፥ የሩሳላመንነ ይሁዳን ደእያ አሳስ አዋ ግዳና። <verse eid="ISA 22:21"/><verse number="22" style="v" sid="ISA 22:22"/>ታኒ ዳዊተ ኬ ቁልፕያ እያዉ እማና፤ እ ዶይን ኦንካ ጎርደና፤ እ ጎርድን ኦንካ ዶየና። <verse eid="ISA 22:22"/><verse number="23" style="v" sid="ISA 22:23"/>ታኒ እያ አማንያ በሳን ሸዳ ቶላና፤ እ ባ አዋ ኬስ ቦንቾ አራታ ግዳና። <verse eid="ISA 22:23"/><verse number="24" style="v" sid="ISA 22:24"/>ቃንዳፈ ኦቶ ጋካናዉ ደእያ ሶ ሚሸታ፥ ኮጫን ካቀይሳዳ፥ እያ አዋ ኬ ቦንቹዋ፥ ናይታነ፥ ናይታ ናይታ ኡባ እያ ቦላ ካቃና” ያግስ።<verse eid="ISA 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 22:25"/>ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፦ “ሄ ጋላስ አማንያ በሳን ሽዳ ቶለይ ክቻና፤ ቃንፀታናነ ኩንዳና። እያ ቦላ ካቀትዳ ቶሆ ኡባይ ዱፅድ ዎና” ያጌስ። ጎዳይ ሀይሳ ኦድስ።<verse eid="ISA 22:25"/></para>
  <chapter eid="ISA 22"/>
  <chapter number="23" style="c" sid="ISA 23"/>
  <para style="s1">ፅሮሳስ ኦደትዳ ትንብተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1"/>ፅሮሳ ካታማስ ኦደትዳ ጎዳ ቃላይ ሀይሳ።</para>
  <para style="p" vid="ISA 23:1">ፅሮሳ ካታማን ኬ ዎይኮ ሸምፕያ ሶይ ባይና ግሾ ህንተኖ ታርሰሳ ማርካብያ ላገይሳቶ ዬክተ! ቆጵሮሳ ቢታፈ ሀ ዎረይ ህንተኮ ይስ።<note caller="-" style="x"><char style="xo" closed="false">23:1 </char><char style="xt" closed="false"><ref loc="EZK 26:1-28:19">ህዝ 26:1—28:19</ref>፤ <ref loc="JOL 3:4-8">እዩ 3:4-8</ref>፤ <ref loc="AMO 1:9-10">አሞ 1:9-10</ref>፤ <ref loc="ZEC 9:1-4">ዛካ 9:1-4</ref>፤ <ref loc="MAT 11:21-22">ማቶ 11:21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃ 10:13-14</ref>.</char></note> <verse eid="ISA 23:1"/><verse number="2" style="v" sid="ISA 23:2"/>ህንተኖ፥ አባ ማታን ደእያ አሳዉ፥ ህንተኖ አባ ቦላራ ሄመትያ ዱረትዳ፥ ስዶና ዛልአንቾቶ፥ ስእ ጊተ! <verse eid="ISA 23:2"/><verse number="3" style="v" sid="ISA 23:3"/>ህንተዉ ያ ካይ፥ ናይለ ሻፋፐ ጫከትዳ ሽሆራ ቢታ ካ፤ ህንተ ካዎተታስ ዛልኤ በሲ።<verse eid="ISA 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 23:4"/>ነኖ ስዶና ካታማዉ፥ አባ ማታን ደእያ ሚፃዉ፥ አባይ፥ “ታኒ እቀታብከ፤ የላብከ፤ አደነ ማጫ ናአ ድቻብከ” ያግድ ኦድዳ ግሾ ዬላታ። <verse eid="ISA 23:4"/><verse number="5" style="v" sid="ISA 23:5"/>ሄ ዎረይ ግብፀ ቢታ ጋክያ ዎደ ኤንቲ ፅሮሳባ ስእድ ዳጋማና።<verse eid="ISA 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 23:6"/>ህንተኖ አባ ማታን ደእያ አሳዉ፥ ዘሌልሸ ታርሰሳ ፕንተ። <verse eid="ISA 23:6"/><verse number="7" style="v" sid="ISA 23:7"/>በን ዎደ ኬፀትዳ ካታማይ፥ እያ ቶሆይ እያ ሃሆ ቢታ ኤፍዳይነ ህንተ እያን ኡፋይትያ ፅሮሳ ካታማይ ሀይሴ? <verse eid="ISA 23:7"/><verse number="8" style="v" sid="ISA 23:8"/>ካላቻ ዎስስያ ካታማ፥ እያ ዛልአንቾት ሀላቃታ ግድዳነ እያ ግዶን ባይዘይሳትነ ላመይሳት ቦንቸትዳይሳታ ግድዳ ፅሮሳ ካታማ ቦላ ሀይሳ ሀልችዳይ ኦኔ? <verse eid="ISA 23:8"/><verse number="9" style="v" sid="ISA 23:9"/>ኦቶራንቾታ ቦንቾ ኡባ ጉናዉነ ቢታ ቦላ ቦንቸትዳ ኡባ ካዉሻናዉ ኡባፈ ዎልቃማ ጎዳይ ሀይሳ ሀልችስ።<verse eid="ISA 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 23:10"/>ህንተኖ፥ ታርሰሳ አሳዉ፥ ህንተና ተቅያባይ ባይና ግሾ፥ ናይለ ሻፋዳ ቢታ ቦላ ኩምድ ጎግተ። <verse eid="ISA 23:10"/><verse number="11" style="v" sid="ISA 23:11"/>ጎዳይ አባ ቦላ ባ ኩሽያ ምጭስ፤ እያ ካዎተ ቃስ። ካናነ ሚፃ ላላና መላ ጎዳይ ኪትስ። <verse eid="ISA 23:11"/><verse number="12" style="v" sid="ISA 23:12"/>ጉጅድካ፥ “ህንተኖ፥ ኡንኤትዳ ስዶና አሳዉ፥ ህንተ ኡፋይሳን የፅያ ዎደይ ዉርስ። ደንድድ ቆጵሮሳ ፕንተ፤ ያንካ ህንተ ሳሮ ደመከታ” ያግስ።<verse eid="ISA 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 23:13"/>ባብሎነ ቢታ በእተ፤ ሄ ቢታይ ሀእ ፓናባ ግድስ። አሶረ አሳይ ሄ ቢታን ዶእ አቃናዳ ኦስ። ኤንቲ ያን ደእያ ዎጋ ኬታ ላልድ ባንታዉ ሚፃ ግምብዶሶና፤ ቢታ ባይሳ ኦዶሶና።<verse eid="ISA 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 23:14"/>ህንተኖ፥ ታርሰሳ ማርካበቶ፥ ህንተ ሚፃይ ላለትዳ ግሾ፥ ዘሌልተ።<verse eid="ISA 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15"/>ፅሮሳ ካታማይ እስ ካዎስ ደኦ ላይ ግድያ ላፑን ታሙ ላይ ዶገትድ ዳና ዎደይ ያና። ላፑን ታሙ ላይ ዉርያ ዎደ ላይማ ማጫሳስ የፀትያ የ መላ ፅሮሳ ካታማስ የፀታና። <verse eid="ISA 23:15"/><verse number="16" style="v" sid="ISA 23:16"/>ኤንቲ፥ “ነኖ ዶገትዳ ላይማ ካታማዉ፥ ነ ዲ ኤካዳ ካታማራ ዩያ። ነና አሳይ ሀሳያና መላ ማልኦ ቃላን ዳሮ የ የፃ” ያጋና።<verse eid="ISA 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17"/>ላፑን ታሙ ላይይ ፖለትያ ዎደ፥ ጎዳይ ፅሮሳ ፆሞሳና። ሽን ሄሳፈ ጉየ፥ እ በን ባ ላይማተ ኦሱዋኮ ስማና፤ ሳአን ደእያ ካዎተታ ኡባራ ላይማታና። <verse eid="ISA 23:17"/><verse number="18" style="v" sid="ISA 23:18"/>ግዶሽን፥ እያ ዛልእያ ዎይነ እያ ዳሞዘይ ጎዳስ ዱማትዳይሳ ግዳና፤ እያ ዛልእያ ዎይነ ካነ ሎኦ ማኦ ሻማናዉ፥ ጎዳስ ኦያ አሳስ እመታናፐ አትሽን፥ ሚሸ ኬን ዎይኮ ምንጃ ኬን ኡተና።<verse eid="ISA 23:18"/></para>
  <chapter eid="ISA 23"/>
  <chapter number="24" style="c" sid="ISA 24"/>
  <para style="s1">ቢታ ኡባይ ሴረታና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 24:1"/>ሄኮ፥ ጎዳይ ቢታ ላላናነ ባይሳ ከሳና፤ እ፥ ቢታ ይስድ እያን ደእያ አሳ ላላና። <verse eid="ISA 24:1"/><verse number="2" style="v" sid="ISA 24:2"/>አስ ኡባይ እስኖ ግዳና፤ ካህነይ አሳራ እስኖ ግዳና፤ አይለይ ጎዳራ እስኖ ግዳና፤ ጋንድያ ጎዳተራ እስኖ ግዳና፤ ሻመይስ ባይዘይሳራ እስኖ ግዳና፤ ታልኤ እመይስ ታልኤ ኤከይሳራ እስኖ ግዳና፤ አጮ አቸይስ አጮ ጭገይሳራ እስኖ ግዳና። <verse eid="ISA 24:2"/><verse number="3" style="v" sid="ISA 24:3"/>ቢታ ኡባይ ቦንቀትድ ባይሳ ግዳና፤ ጎዳይ ሀ ቃላ ኦድስ።<verse eid="ISA 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 24:4"/>ቢታይ መላና፥ እያ አጫይ ሹላና፤ አላመይ አርጋጫና፥ ዳቡራና፤ ቢታን ደእያ ዎልቃማ አሳይ ዳቡራና። <verse eid="ISA 24:4"/><verse number="5" style="v" sid="ISA 24:5"/>ቢታይ ባናን ደእያ አሳ ጋሶን ቱንስ። ኤንቲ ህግያስ ኪተትቦኮና፤ ዎጋ ናግቦኮና፤ መርና ጫቁዋ መንዶሶና። <verse eid="ISA 24:5"/><verse number="6" style="v" sid="ISA 24:6"/>ሄሳ ግሾ፥ ባደይ ቢታ ሜስ፤ አሳይ ባንታ ናጋራ ጋሶን ፕርደታናዉ በሴስ። ሳአን ደእያ አሳይ ፁገትዶሶና፤ ጉ አስ አትስ። <verse eid="ISA 24:6"/><verse number="7" style="v" sid="ISA 24:7"/>ዎይነይ ፃጶራ መልስ፥ ማልአንቶ ዎይነይ ዉርስ፤ ካሰ ኡፋይትያ ኡባይ አዛንስ። <verse eid="ISA 24:7"/><verse number="8" style="v" sid="ISA 24:8"/>ካራቦ ባቆይ አትስ፤ የ ዋሶይ ስእ ግስ፤ ኡፋይስያ ዲ ዱርሳይ ኤቅስ። <verse eid="ISA 24:8"/><verse number="9" style="v" sid="ISA 24:9"/>ህዛፐ የፅሸ ዎይነ ኡሻ ኡዮኮና፤ ኡሻይካ ኤንታዉ ጫሞ ግዳና። <verse eid="ISA 24:9"/><verse number="10" style="v" sid="ISA 24:10"/>ላለትዳ ካታማይ ባይሳ ግዳና፤ ኦንካ ገሎናዳ ኬ ኡባይ ጎርደትስ። <verse eid="ISA 24:10"/><verse number="11" style="v" sid="ISA 24:11"/>ዎይነ ኡሽ ይዳ ግሾ አሳይ ዳባባን ዋሴስ፤ ኡፋይስ አዛኖን ላመትስ፤ ኡፋይስያባይ ሳአፐ ይስ። <verse eid="ISA 24:11"/><verse number="12" style="v" sid="ISA 24:12"/>ካታማይ ላለትስ፤ ካታማ ፐንገት መቀረትዶሶና። <verse eid="ISA 24:12"/><verse number="13" style="v" sid="ISA 24:13"/>ሻማሆ ቴራ ቆቆፈይሳዳ፥ ዎይነ ማፅ ስምን፥ ፖሽለይ አተይሳዳ፥ ቢታ ቦላ ደእያ ካዎተታ ቦላ ሄሳዳ ሀናና።<verse eid="ISA 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 24:14"/>ኤንቲ ባንታ ቃላ ቁ ኦድ፥ ኡፋይሳን የፆሶና፤ ዉሎሀ ባጋራ ደእያ ኡባይ ጎዳ ግታተ ኦዳና። <verse eid="ISA 24:14"/><verse number="15" style="v" sid="ISA 24:15"/>ሄሳ ግሾ፥ ዶሎሀ ባጋራ ደኤይሳት፥ ጎዳስ ቦንቾ እማና፤ ዩሾይ አባን ተቀትዳ ቢታት ጎዳስ፥ እስራኤለ ፆሳስ ቦንቾ እማና። <verse eid="ISA 24:15"/><verse number="16" style="v" sid="ISA 24:16"/>ኑኒ፥ “ፅሉዋስ ቦንቾይ ግዶ” ግያ ማዝሙረ ቢታ ጋፃፐ ስእዳ።</para>
  <para style="p" vid="ISA 24:16">ሽን፥ “ታኒ ግልቃስ! ታኒ ላፋስ! ታና አየ! አ እመይስ አድ እሜስ፤ ካደይሳት ጉጅድ አድ እሞሶና” ያጋስ። <verse eid="ISA 24:16"/><verse number="17" style="v" sid="ISA 24:17"/>ህንተኖ፥ ሳአን ደእያ አሳዉ፥ ዳጋም አፎይነ ፅሄይ ህንተና ናጌስ። <verse eid="ISA 24:17"/><verse number="18" style="v" sid="ISA 24:18"/>ዳጋንያ ግርሳፈ ባቃተይስ ኦላን ኩንዳና፤ ኦላፈ ከየይሳ ፅሄይ ኦይካና፤ ሳሎ ማስኮተት ዶየትዶሶና፤ ቢታ ባሶት ቃፅዶሶና። <verse eid="ISA 24:18"/><verse number="19" style="v" sid="ISA 24:19"/>ቢት ዛእስ፤ ቢት ሻከትስ፤ ቢት ቃፅስ። <verse eid="ISA 24:19"/><verse number="20" style="v" sid="ISA 24:20"/>ቢት ማ አሳዳ ጋንድጋሬስ፤ ጫርኮይ ሱግያ ጋባዳ ዩዬስ። ጌላታ ባላይ ዳሮ ዴፅዳ ግሾ ዛር ደንዶና መላ ኩንድስስ።<verse eid="ISA 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 24:21"/>ሄ ጋላስ ጎዳይ ሳሎ ዎልቃታ ሳሎን፥ ሳኣ ካዎታ ሳአን ፕርዳና። <verse eid="ISA 24:21"/><verse number="22" style="v" sid="ISA 24:22"/>ኦላን ደእያ ቃሾ አሳዳ ኤንታ እስፈ ሺሻና፤ ቃሾ ኬን ኤንቲ ጎርደትድ ኡታና። ዳሮ ጋላሳፐ ጉየ ኤንቲ ሴረታና። <verse eid="ISA 24:22"/><verse number="23" style="v" sid="ISA 24:23"/>ኡባፈ ዎልቃማ ጎዳይ ፅዮነ ዙማንነ የሩሳላመን ካዎታና፤ የሩሳላመ ጭማታ ስንን ባ ቦንቹዋ ቆንጭሳና። ሄ ዎደ አጌናይ ማና፥ አዋይ ዬላታና።<verse eid="ISA 24:23"/></para>
  <chapter eid="ISA 24"/>
  <chapter number="25" style="c" sid="ISA 25"/>
  <para style="s1">ፆሳይ ጋላተቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 25:1"/>አቤት ጎዳዉ፥ ኔኒ ታ ፆሳ። ታኒ ነና ቁ ቁ ኦና፤ ነ ሱን ጋላታና። ኔኒ ነ ፖሎ አማነተን በንፐ ቆፈትድ ደእያ ማላልስያ ኦሶታ ኦዳሳ። <verse eid="ISA 25:1"/><verse number="2" style="v" sid="ISA 25:2"/>ኔኒ ካታማ ላለ ዶረ ኦዳሳ፤ ምኖ ግምበ ድርሳይ ደእያ ካታማ ላላዳሳ። አላጋታ ካዎ ኬይ ዛሪድ ካታማ ግዶና መላ ኦዳሳ፤ ዛሪድ ፖሎ ኬፀተና። <verse eid="ISA 25:2"/><verse number="3" style="v" sid="ISA 25:3"/>ሄሳ ግሾ፥ ምኖ አሳት ነና ቦንቻና፤ ዎዛና ምኖ ካዎተታ ካታማት ነዉ ያያና። <verse eid="ISA 25:3"/><verse number="4" style="v" sid="ISA 25:4"/>ኔኒ ማንቆይ ባቃትድ አትያ በሲ፥ መቶታንቾይ ቆሰትያ በሲ፥ ኡሾፐ አትያ ገሸነ አዋ ሴላፐ አትያ ኩያ ግዳዳሳ። ዎዛና ምኖ አሳ ሀንቆይ ግምበራ ዶምኤያ ኡሾ መላነ <verse eid="ISA 25:4"/><verse number="5" style="v" sid="ISA 25:5"/>መላ ቢታን ሆንገ መላ። ሻራ ኩያይ አዋ ሴላ እርፅስያ መላ ኔኒ አላጋታ የ ስእ ኦዳሳ፤ ያትን ዎዛና ምኖ አሳ ዋሶይ ስእ ግስ።<verse eid="ISA 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 25:6"/>ኡባፈ ዎልቃማ ጎዳይ አሳ ኡባስ ሀ ዙማ ቦላ ግታ ግብራ ጊግሳና። ሄ ግብራ ቦላ ሞ አሹዋ፥ ሎኦ ካነ ጫልዳ ዎይነ ኡሻ ጊግስስ። <verse eid="ISA 25:6"/><verse number="7" style="v" sid="ISA 25:7"/>እ ሀ ዙማ ቦላ አሳ ኡባ ካምዳ ማጋራጁዋነ ካዎተ ኡባ ቦላ ምጨትዳ ካማ ይሳና። <verse eid="ISA 25:7"/><verse number="8" style="v" sid="ISA 25:8"/>እ መርናዉ ሀይቆ ምታና፤ ኡባ ሃርያ ጎዳይ አይፈ ኡባፈ አፉ ቁቻና፤ ባ አሳ ካዉሻ ቢታ ኡባፈ ድጋና። ጎዳይ ሀይሳ ኦድስ።<note caller="-" style="x"><char style="xo" closed="false">25:8 </char><char style="xt" closed="false"><ref loc="ISA 5:14">እሳ 5:14</ref>፤ <ref loc="1CO 15:54">1 ቆሮ 15:54</ref>፤ <ref loc="REV 7:17">ቆን 7:17</ref>፤ <ref loc="REV 21:4">21:4</ref>.</char></note><verse eid="ISA 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9"/>ሄ ጋላስ ኤንቲ፥ “ቱማ ሀይስ ኑ ፆሳ፤ ኑኒ እያን አማነትዳ ግሾ እ ኑና አሽስ። ኑ ጎዳይ ሀይሳ፤ ኑኒ እያን አማነትዳ፤ አነ እያ አቶተን ኡፋይቶስ፤ ሀሹ ጎስ” ያጋና።<verse eid="ISA 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 25:10"/>ጎዳ ኩሸይ አሻናዉ ሀ ዙማ ቦላ ሸምፓና። ሽን ኡቱል ኡርቃራ ኦላን የተይሳዳ ሞአበይ የታና።<note caller="-" style="x"><char style="xo" closed="false">25:10 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">እሳ 15:1—16:14</ref>፤ <ref loc="JER 48:1-47">ኤርም 48:1-47</ref>፤ <ref loc="AMO 2:1-3">አሞ 2:1-3</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ 2:8-11</ref>.</char></note> <verse eid="ISA 25:10"/><verse number="11" style="v" sid="ISA 25:11"/>ሃ ዋይስ ባ ኩሽያ የደይሳዳ ኤንቲ ባንታ ኩሽያ የዳና። ሽን ጎዳይ እያ ገነ ኩሸ ኦሱዋን ጭመቶና፥ እያ ኦቶሩዋ ካዉሻና። <verse eid="ISA 25:11"/><verse number="12" style="v" sid="ISA 25:12"/>ኤንቲ ቅስድ ግምብዳ ምኖ ድርሳ ግምብያ እ ዎድሳናነ ካዉሻና፤ እ ዱገ ሳአን፥ ኡባ ህርክ ባናን ሆላና።<verse eid="ISA 25:12"/></para>
  <chapter eid="ISA 25"/>
  <chapter number="26" style="c" sid="ISA 26"/>
  <para style="s1">ፆኖ ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1"/>ሄ ጋላስ ይሁዳ ቢታን ሀ ማዝሙረይ የፀታና።</para>
  <para style="q1" vid="ISA 26:1">ኑስ ምኖ ካታም ደኤስ፤</para>
  <para style="q2" vid="ISA 26:1">ፆሳይ አቶተ</para>
  <para style="q2" vid="ISA 26:1">እያ ዩሹዋን ግምበነ ሚፃ ኦስ።<verse eid="ISA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2"/>ባ አማኑዋ ናግያ ፅሎ ደረይ፥</para>
  <para style="q2" vid="ISA 26:2">ገላና መላ ካረታ ዶይተ።<verse eid="ISA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3"/>እ ነናን አማነትዳ ግሾ፥</para>
  <para style="q2" vid="ISA 26:3">ባ ዎዛና ነናን ዎዳ ኡራ፥</para>
  <para style="q2" vid="ISA 26:3">ኔኒ ፖሎ ሳሮተን ናጋሳ።<verse eid="ISA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4"/>ጎዳይ መርና ዛላ ግድያ ግሾ፥</para>
  <para style="q2" vid="ISA 26:4">ጎዳን መርናዉ አማነታ።<verse eid="ISA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5"/>ቃን ደኤይሳታ ዝቅ ኦስ፤</para>
  <para style="q2" vid="ISA 26:5">ቁ ግዳ ካታማ ካዉሽስ።</para>
  <para style="q1" vid="ISA 26:5">እያ ሳአን ዱገ የግስ፤</para>
  <para style="q2" vid="ISA 26:5">ቢታ ባናን ሆልስ።<verse eid="ISA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6"/>ማንቆት እያ የና</para>
  <para style="q2" vid="ISA 26:6">ኡንኤትዳይሳት እያ ቦላራ ሄመታና።<verse eid="ISA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7"/>ፅሎታ ኦገይ ሱረ፤</para>
  <para style="q2" vid="ISA 26:7">አቤት ፅሉዋዉ፥ ኔኒ ፅሎታ ኦግያ ጊግሳሳ።<verse eid="ISA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8"/>አቤት ጎዳዉ፥ ኑኒ ነ ህግያ ናጋናዉ አሞቶስ፤</para>
  <para style="q2" vid="ISA 26:8">ነ ሱን ቦንቾይነ ነ ቴማይ ኑ ዎዛና አሞ።<verse eid="ISA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9"/>ቃማ ታኒ ነና ላሞታስ፤</para>
  <para style="q2" vid="ISA 26:9">ዎንታ ታ አያናይ ነና ምንድ ኮዬስ።</para>
  <para style="q1" vid="ISA 26:9">ነ ቢታ ፕርዳናዉ ያ ዎደ፥</para>
  <para style="q2" vid="ISA 26:9">ሳአን ደእያ አሳይ ፅሎተ ታማሬስ።<verse eid="ISA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10"/>ኢታ አሳስ ኬሀተ ኦሰትኮካ፥</para>
  <para style="q2" vid="ISA 26:10">እ ፅሎተ ታማረና።</para>
  <para style="q1" vid="ISA 26:10">ሱረ ቢታን ኢታባ ኦስ፤</para>
  <para style="q2" vid="ISA 26:10">ጎዳ ግታተ ኤረና።<verse eid="ISA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11"/>አቤት ጎዳዉ፥ ነ ኩሸይ ቁ ግስ፤</para>
  <para style="q2" vid="ISA 26:11">ሽን ኤንቲ በኦኮና።</para>
  <para style="q1" vid="ISA 26:11">ነ አሳስ ኔኒ ምሸትያ ምሻ</para>
  <para style="q2" vid="ISA 26:11">በእድ ዬላቶ።</para>
  <para style="q1" vid="ISA 26:11">ኔኒ ነ ሞርከታስ ጊግስዳ ታማይ</para>
  <para style="q2" vid="ISA 26:11">ኤንታ ምድ ይሶ።<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="HEB 10:27">እብራ 10:27</ref>.</char></note><verse eid="ISA 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12"/>አቤት ጎዳዉ፥ ኑስ ሳሮተ እማዳሳ፤</para>
  <para style="q2" vid="ISA 26:12">ኑ ኦሶ ኡባ ነ ኦዳሳ።<verse eid="ISA 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13"/>አቤት ጎዳዉ፥ ኑ ፆሳዉ፥</para>
  <para style="q2" vid="ISA 26:13">ሀራ ጎዳት ኑና ሃርዶሶና፤</para>
  <para style="q2" vid="ISA 26:13">ሽን ኑኒ ነ ሱን ፃላላ ቦንቾስ።<verse eid="ISA 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14"/>ኤንቲ ሀይቅዶሶና፤ ስሚድ ደኦን ዶኮና።</para>
  <para style="q2" vid="ISA 26:14">ነ ሴርን ይዳ ግሾ፥ ዛሪድ ደንዶኮና።</para>
  <para style="q2" vid="ISA 26:14">ኤንታ ቆፍሱዋ ኡባ ቁቻዳ ይሳዳሳ።<verse eid="ISA 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15"/>አቤት ጎዳዉ፥ ኔኒ ካዎተ ዳርሳዳሳ፤</para>
  <para style="q2" vid="ISA 26:15">ካዎተ ዳርሳዳ ኔኒ ቦንቸታዳሳ፤</para>
  <para style="q2" vid="ISA 26:15">ቢታ ዛዋ ኡባ ዳልግሳዳሳ።<verse eid="ISA 26:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16"/>አቤት ጎዳዉ፥ መቶ ዎደ ኤንቲ ነና ኮይዶሶና።</para>
  <para style="q2" vid="ISA 26:16">ነ ኤንታ ሴርዳ ዎደ ነና ካልካሽድ ዎስዶሶና።<verse eid="ISA 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17"/>አቤት ጎዳዉ፥ ቃንትዳ ማጫስ፥</para>
  <para style="q2" vid="ISA 26:17">የሎ ዎደይ ጋክን ኡንኤታዳ ዋሰይሳዳ፥</para>
  <para style="q2" vid="ISA 26:17">ኑኒ ነ ስንን ሄሳዳ ሀንዳ።<verse eid="ISA 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18"/>ኑኒ ቃንትዳ፤ እቀትዳ፤</para>
  <para style="q2" vid="ISA 26:18">ሽን ጫርኮ የልዳ።</para>
  <para style="q1" vid="ISA 26:18">ኑኒ ሳኣስ አቶተ ኤህቦኮ፤</para>
  <para style="q2" vid="ISA 26:18">ቢታን ደእያ አሳ የልቦኮ።<verse eid="ISA 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19"/>ሀይቅዳ ነ አሳይ ፓፃና፤</para>
  <para style="q2" vid="ISA 26:19">ኤንታ አሀይ ደንዳና።</para>
  <para style="q1" vid="ISA 26:19">ህንተኖ፥ ቢታ ጋርሳን ደኤይሳቶ፥</para>
  <para style="q2" vid="ISA 26:19">ደንድድ ኡፋይሳ ማዝሙረ የፅተ።</para>
  <para style="q1" vid="ISA 26:19">ህንተ አካይ ዎንታ አካ መላ፤</para>
  <para style="q2" vid="ISA 26:19">ቢትያ ሀይቅዳይሳታ ዛራዳ እማና።<note caller="-" style="x"><char style="xo" closed="false">26:19 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳነ 12:2</ref>.</char></note><verse eid="ISA 26:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 26:20"/>ታ አሳዉ፥ ብድ ህንተ ሶ ገልድ፥</para>
  <para style="q2" vid="ISA 26:20">ካርያ ህንተ ቦላ ጎርድተ።</para>
  <para style="q1" vid="ISA 26:20">ጎዳ ሀንቆይ አና ጋካናዉ፥</para>
  <para style="q2" vid="ISA 26:20">ጉ ዎደስ ህንተና ቆስተ።<verse eid="ISA 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 26:21"/>ቢታ ቦላ ደእያ አሳ፥</para>
  <para style="q2" vid="ISA 26:21">ኤንታ ናጋራ ግሾ ሴራናዉ፥</para>
  <para style="q2" vid="ISA 26:21">ጎዳይ ባ ደእያ በሳፈ ከይድ ዬስ።</para>
  <para style="q1" vid="ISA 26:21">ቢትያ ባ ቦላ ጉክዳ ሱ ቆንጭሳና፤</para>
  <para style="q2" vid="ISA 26:21">ሀይቅዳይሳታ ዛራዳ ገንኩ።<verse eid="ISA 26:21"/></para>
  <chapter eid="ISA 26"/>
  <chapter number="27" style="c" sid="ISA 27"/>
  <para style="s1">እስራኤለይ ላአ ከያና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1"/>ሄ ጋላስ ጎዳይ ባ ምኖ፥ ግታነ ዎልቃማ ማሻን ሌዋታነ ጌተትያ ፆንገትያነ ፃፀትያ ሾሻ ሴራና፤ አባን ደእያ ዶኣካ ዎና።<note caller="-" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="JOB 41:1">እዮ 41:1</ref>፤ <ref loc="PSA 74:14">ማዝ 74:14</ref>፤ <ref loc="PSA 104:26">104:26</ref>.</char></note> <verse eid="ISA 27:1"/><verse number="2" style="v" sid="ISA 27:2"/>ሄ ጋላስ ሀይሳዳ ጌተታና፦ “ሎኦ ዎይነ ጋድያስ የፅተ፤ <verse eid="ISA 27:2"/><verse number="3" style="v" sid="ISA 27:3"/>ታኒ፥ ጎዳይ እያ ናጋይስ፤ ታኒ ቃንፆና ሃ ኡሻይስ፤ ኦንካ እያ ቆሆናዳ ቃማ ጋላስ ናጋይስ። <verse eid="ISA 27:3"/><verse number="4" style="v" sid="ISA 27:4"/>ታኒ ሀንቀትከ፤ ታራ ኦለታናዉ አጉንነ ጎምኦረይ አነ ደንዶ! ታኒ ኤንታ ቦላ ከያዳ ኤንታ ፁጋ ዉርሳናሽን። <verse eid="ISA 27:4"/><verse number="5" style="v" sid="ISA 27:5"/>ዎይኮ ቆሰትድ አታናዉ ታኮ ዮ፤ ታራ ስገቶ፤ ኤ፥ ታራ ስገቶ” ያገታና።<verse eid="ISA 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 27:6"/>ያና ዎድያን ያይቆብ ፃጶ የዳና፤ እስራኤለይ አጫናነ ጪያና፤ እያ አይፈይ ቢታ ኡባ ኩማና።<verse eid="ISA 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 27:7"/>ኤንታ ሾጭዳይሳታ ሾጭዳይሳዳ ጎዳይ እስራኤለ አሳ ሾጭደዬ? ዎይኮ ኤንታ ዎዳይሳታ ዎዳይሳዳ ኤንቲ ሀይቅዶናዬ? <verse eid="ISA 27:7"/><verse number="8" style="v" sid="ISA 27:8"/>ጎዳይ ባ አሳ ድኤታና መላ ኦድ ሴርስ፤ ዎልቃማ ዶሎሀ ባጋ ጎትያን ኤንታ ጎድድ ከስስ። <verse eid="ISA 27:8"/><verse number="9" style="v" sid="ISA 27:9"/>ያይቆባ ናቆይ አቶ ጌተታናይነ እያ ናጋራይ ፖሎ ቁሸታናይ፥ ያርሾ ሹቻ ኡባ እ መንረድ ቦቅንተ ሹቻዳ ኦያ ዎደነ አሼራ ኤቃ ምስልያ ዎይኮ እፃነ ጩይስያ በሳ ላልያ ዎደ።<verse eid="ISA 27:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 27:10"/>ድረትዳ ካታማይ ባይሳትስ፤ ካሰ አስ ደእያ በሳይ ሀእ ባዞ መላ ዶገትድ አትስ። መሄይ ሄመትያ በሲ ግድዳ ግሾ፥ ማታነ ም ሀይ ምድ ማራት ያን አላቶሶና። <verse eid="ISA 27:10"/><verse number="11" style="v" sid="ISA 27:11"/>ም ታሸት መልያ ዎደ መቀረቶሶና፤ ማጫሳይ ምፅድ ኤናዉ ኤፎሶና። ሀ አሳይ አኬክ ባይና አስ ግድያ ግሾ፥ ኤንታ መዳይስ ኤንታዉ ቃተና፤ ኤንታ ማረና።<verse eid="ISA 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12"/>ሄ ጋላስ ኤፍራፂሳ ሻፋፐ ግብፀ ሻፋ ጋካናዉ ጎዳይ ካ ቆፃና። ህንተ፥ እስራኤለ አሳይ እሶይ እሶይ ሺቃና።<verse eid="ISA 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 27:13"/>ሄ ጋላስ ግታ ሞይዘይ ፑነታና፤ አሶረ ቢታን ይዳይሳትነ ግብፀ ቢታ ድኤትዳይሳት ይድ፥ የሩሳላመን ጌሻ ዙማ ቦላ ጎዳ ጎይናና።<verse eid="ISA 27:13"/></para>
  <chapter eid="ISA 27"/>
  <chapter number="28" style="c" sid="ISA 28"/>
  <para style="s1">ኤፍሬማ አየ!</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 28:1"/>ኤፍሬማን ማተይሳታስ ቆፍሶ ካላቻ ግድዳይሳ፥ አራዳ ዛንጋራ ሁጵያን ኡትዳይሳ፥ እያ ቦንቹዋስ አሌቆ ግድዳ ሹልዳ ጪሻነ ማይያ ኡሻይ ኤንታዉ ናሸተስ ግድዳ ካታማ አየ! <verse eid="ISA 28:1"/><verse number="2" style="v" sid="ISA 28:2"/>ሄኮ፥ ጎዳስ ዎልቃማነ ምኖ ግድዳ እሶይ ደኤስ። ጎዳይ እያ ሻቻ ኡሾዳ፥ ይስያ ጎተዳነ ክፅዳ ዎልቃማ ሃዳ ምኖ ኩሽያን ዱገ ሳአን ሆላና። <verse eid="ISA 28:2"/><verse number="3" style="v" sid="ISA 28:3"/>ሄ ማትያ ኤፍሬማ አሳ ኦቶሩዋ ካላቻይ ቶሆን የና። <verse eid="ISA 28:3"/><verse number="4" style="v" sid="ISA 28:4"/>አራዳ ዛንጋራ ሁጰን ደእያ ሹልዳ ጪሻይ፥ እያ ቦንቾ አሌቆይ ዎደይ ጋካናፐ ስን ቴርዳ ባላሰ አይፈ መላ ግዳና። እስ አስ ሄ ባላስያ በእያ ዎደ ባ ኩሸን ኦይክዳ መላ ም አጌስ።<verse eid="ISA 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 28:5"/>ሄ ጋላስ ኡባፈ ዎልቃማ ጎዳይ አትዳ ባ አሳስ ቦንቾ ካላቻነ አሌቆ ግዳና። <verse eid="ISA 28:5"/><verse number="6" style="v" sid="ISA 28:6"/>እ ዳይናታስ ሱረ ፕርድያ አያና፥ ካታማ ፐንግያፈ ኦላ ዛረይሳታስ ዎልቃ ግዳና።<verse eid="ISA 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 28:7"/>ኤንቲ ዎይነ ኡሻን ቢጮቶሶና፤ ማይያ ኡሻን ጋንድጋሮሶና። ካህነይነ ናበይ ማይያ ኡሻን ቢጮቴስ፤ ኤንቲ ዎይነ ኡሻን ያርኮሶና፤ ማይያ ኡሻን ጋንድጋሮሶና። ቆንጨ በእሸ ባለቶሶና፤ ፕርድሸ በቶሶና። <verse eid="ISA 28:7"/><verse number="8" style="v" sid="ISA 28:8"/>ኤንቲ ምያ ጋይታ ኡባይ ጮሻ ፃላላ ግድያ ግሾ፥ ኢትቦና በሲ ባዋ።<verse eid="ISA 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 28:9"/>ኤንቲ ሀይሳዳ ጋና፦ “እ ኤራተ ኦና ታማርሳኔ? ኪታ ኦደስ ቆንጭሳኔ? ቡሮ ማ ፓሄቲያ ዎይኮ ን ዱፅዳ ናይታሰዬ? <verse eid="ISA 28:9"/><verse number="10" style="v" sid="ISA 28:10"/>እ፥ ኪታ ቦላ ኪታ፥ ኪታ ቦላ ኪታ፤ ዎጋ ቦላ ዎጋ፥ ዎጋ ቦላ ዎጋ፤ ያን ጉ ሀን ጉ” ያጋና።<verse eid="ISA 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 28:11"/>ሽን ጎዳይ አላጋ ቃላንነ እማ ዶናን ሀ አሳስ ኦዳና።<note caller="-" style="x"><char style="xo" closed="false">28:11 </char><char style="xt" closed="false"><ref loc="1CO 14:21">1 ቆሮ 14:21</ref>.</char></note> <verse eid="ISA 28:11"/><verse number="12" style="v" sid="ISA 28:12"/>እ ኤንታኮ፥ “ሀይስ ሸምፖ በሲ፤ ዳቡርዳይሳ ሸምፕስተ። ሀይስ ሸምፕ ኤክያ በሲ” ያግስ። ሽን ኤንቲ ስኦና እፅዶሶና። <verse eid="ISA 28:12"/><verse number="13" style="v" sid="ISA 28:13"/>ሄሳ ግሾ፥ ኤንቲ ብድ ኩንዳና መላ፥ መአና መላነ ፅሄን ኦይከትድ ባና መላ ጎዳ ቃላይ ኤንታዉ ኪታ ቦላ ኪታ፥ ኪታ ቦላ ኪታ፤ ዎጋ ቦላ ዎጋ፥ ዎጋ ቦላ ዎጋ፤ ያን ጉ ሀን ጉ ግዳና።<verse eid="ISA 28:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 28:14"/>ህንተኖ፥ የሩሳላመን ደእያ አሳ ሃርያ ቀልቅሰይሳቶ ጎዳ ቃላ ስእተ። <verse eid="ISA 28:14"/><verse number="15" style="v" sid="ISA 28:15"/>ህንተ፥ “ኑኒ ሀይቆራ ጫቅዳ፤ ስኦለራ ጊግዳ፤ ኑኒ ዎርዶ ኑስ ቆታ ኦዳ ግሾነ ማልተ ካተ ኦዳ ግሾ፥ ጋዶይ ኑና ቦቾና አና” ያግድ ጬቀተታ።<verse eid="ISA 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 28:16"/>ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ፥ “ሄኮ፥ ታኒ አልኦነ ዶረትዳ ባሶ ሹቻ ፅዮነን ዎስ፤ እያን አማንያ ኦንካ ዬላተና።”<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">ማዝ 118:22-23</ref>፤ <ref loc="ROM 9:33">ሮመ 9:33</ref>፤ <ref loc="ROM 10:11">10:11</ref>፤ <ref loc="1PE 2:6">1 ጰፅ 2:6</ref>.</char></note> <verse eid="ISA 28:16"/><verse number="17" style="v" sid="ISA 28:17"/>ታኒ ሱረ ፕርዳ ዋ ዎዶሮ፥ ፅሎተ ቱምበ ኦና። ህንተ፥ “ኑስ ቆታ ግዳ ዎርዶ ሻቻይ ሾጫና፤ ህንተ ኑስ ካተ ግዳ በሳ ድኦይ ይሳና” ያጌስ። <verse eid="ISA 28:17"/><verse number="18" style="v" sid="ISA 28:18"/>ህንተ ሀይቆራ ጫቅዳ ጫቆይ ላለታና፤ ስኦለራ ጊግዳ ጊጎይ ምነና። ጋዶይ ያ ዎደ ህንተ እያን ሾጨታና። <verse eid="ISA 28:18"/><verse number="19" style="v" sid="ISA 28:19"/>ሄ ጋዶይ ያ ዎደ ህንተና ኤክድ ባና፤ ዎንታ ዎንታ፥ ቃምነ ጋላስ ያራ አና፤ ሄ አያ ዎደ ኡባን ህንተና አገና።</para>
  <para style="p" vid="ISA 28:19">ሀ ኪታ አኬኮይ ህንተዉ ዳጋማ ፃላላ እማና። <verse eid="ISA 28:19"/><verse number="20" style="v" sid="ISA 28:20"/>ህንተ ቆሰትያ በሲ ህንተዉ ባዋ፤ ህንተ ዝንእያ አርሳይ ህንተዉ ግደና፤ ህንተ ማእያ አፍላይ ህንተና ጋከና። <verse eid="ISA 28:20"/><verse number="21" style="v" sid="ISA 28:21"/>ፓራዚማ ዙማ ቦላ ጎዳይ ኦዳይሳዳ ባ ኦሱዋ፥ ባ እማ ኦሱዋ፥ ሄስካ ባ ኦራ ኦሱዋ ኦናዉ ደንዳና። ጋባኦና ዛንጋራን ኦዳይሳዳ ሀንቃና።<note caller="-" style="x"><char style="xo" closed="false">28:21 </char><char style="xt" closed="false"><ref loc="JOS 10:10-12">እያ 10:10-12</ref>፤ <ref loc="2SA 5:20">2 ሳሜ 5:20</ref>፤ <ref loc="1CH 14:11">1 ታር 14:11</ref>.</char></note> <verse eid="ISA 28:21"/><verse number="22" style="v" sid="ISA 28:22"/>ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ ቢታ ኡባ ቦላ ዮ ኤሀናዉ አዋጅዳይሳ ታ ስእዳ ግሾ ህንተ ቃሾይ ምኖና መላ ቀልቅሰይሳ አግተ።<verse eid="ISA 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 28:23"/>ህንተ ሀይ ሃ የግድ፥ ታ ኦደይሳ ስእተ፤ ታ ኦዳ አኬክተ። <verse eid="ISA 28:23"/><verse number="24" style="v" sid="ISA 28:24"/>ካ ዘራናዉ ጎይያ ጎሻንቾይ ኡባ ዎደ ጎይሸ ደእዬ? ቃስ ኡባ ዎደ ጋጋህያ ዎሸነ ሊቅስሸ ደኢ? <verse eid="ISA 28:24"/><verse number="25" style="v" sid="ISA 28:25"/>ጋድያ ሊቅስድ፥ ካሬ ሳዋነ ኦካሸ፥ ባንጋነ ግስተ፥ ባንጋ እያ ዶኡዋን፥ እያ በሳን በሳን ዘሬስ ግደኔ? <verse eid="ISA 28:25"/><verse number="26" style="v" sid="ISA 28:26"/>ሀ ሂላ እያ ፆሳይ እያ ኤርሰስነ ታማርሴስ። <verse eid="ISA 28:26"/><verse number="27" style="v" sid="ISA 28:27"/>ካሬ ሳዎነ ኦካሸ ሾጩ ዎን ቆፀና፤ ሽን ጉ ፃምአን ሾጨቴስ። <verse eid="ISA 28:27"/><verse number="28" style="v" sid="ISA 28:28"/>ካ አይፈይ ቡከቴስፐ አትሽን፥ ሊቀና፤ ቃስ ካ ቡክያ ፓራ ጋረት እያ ቦላራ ላገትኮካ ካይ ጋጨተና። <verse eid="ISA 28:28"/><verse number="29" style="v" sid="ISA 28:29"/>ሀ ጭንጫተ ኡባይ ባ ዞርያንነ ባ ጭንጫተን ማላልስያ ኡባፈ ዎልቃማ ጎዳፐ ዬስ።<verse eid="ISA 28:29"/></para>
  <chapter eid="ISA 28"/>
  <chapter number="29" style="c" sid="ISA 29"/>
  <para style="s1">የሩሳላመ አየ!</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 29:1"/>ዳዊቲ ደእዳ አርኤላ ካታማዉ ነና አየ! ላይ ቦላ ላይ ጉጃ፤ ነ ባለታ ዛራ ዛራ ቦንቻ። <verse eid="ISA 29:1"/><verse number="2" style="v" sid="ISA 29:2"/>ታኒ አርኤላ ካታማ ቡሮ ኡንኤና፤ እ ዘሌልድ ዬካና። ሄ ካታማይ ሱ ካምዳ ያርሾ በሳ መላ ግዳና። <verse eid="ISA 29:2"/><verse number="3" style="v" sid="ISA 29:3"/>ታኒ ነ ዩሹዋ ተቃና፤ አዱሳ ግምብያን ነና ድራና፤ ነ ቦላ ኦላ ሻኮ ኤሳና። <verse eid="ISA 29:3"/><verse number="4" style="v" sid="ISA 29:4"/>ኔኒ ገልዳ ኦላን ግዳዳ ኦደታና፤ ጋርሳ ባናፐ ነ ግርሳይ ያና። ነ ግርሳይ ሞይትለ ግርሳዳ ቢታ ግዶፈ ከያና፤ ባና ግዶፈ ነ ካልካሻና።<verse eid="ISA 29:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 29:5"/>ሽን ነ ሞርከት ባና መላ ዳሮ፤ ዎዛና ምኖ አሳታ ታይቦይ ጫርኮይ ኤፍያ ፑኖ መላ። <verse eid="ISA 29:5"/><verse number="6" style="v" sid="ISA 29:6"/>ቆፖና ደእሽን፥ ኡባፈ ዎልቃማ ጎዳይ ዳዳን፥ ቢታ ቃፆን፥ ግታ ግርሳን፥ ጎተን፥ ጫርኮንነ ታማ ላጮን ህንተና ዎቻና።<note caller="-" style="x"><char style="xo" closed="false">29:6 </char><char style="xt" closed="false"><ref loc="1KI 19:11-12">1 ካዎ 19:11-12</ref>.</char></note> <verse eid="ISA 29:6"/><verse number="7" style="v" sid="ISA 29:7"/>አርኤላ ካታማ ኦልያ ዳሮ ካዎተ ኡባይ፥ ሄ ካታማነ እያ ሚፃ ኦልያ ኡባይ፥ እያ ኡንኤያ ኡባይ ስኮ አሙሆዳነ ኤልሞዳ ሀናና። <verse eid="ISA 29:7"/><verse number="8" style="v" sid="ISA 29:8"/>ኮሻትዳ አስ አሙሆን ካ ምድ፥ ባርክያ ዎደ እያ ኮሻይ አጎናይሳዳ ዎይኮ ሳሞትዳ አስ አሙሆን ኡይድ፥ ባርክያ ዎደ ሳሙዋ አሎናይሳዳ፥ ፅዮነ ደርያ ኦልያ ካዎተት ኡባይ ሄሳዳ ሀናና።<verse eid="ISA 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 29:9"/>ማላለትተ፤ ዳጋምተ፤ ቅልምእተ፤ ቆቅተ። ማትተ፥ ሽን ዎይነ ኡሻን ግዶፖ። ጋንድጋርተ፥ ሽን ማይያ ኡሻን ግዶፖ። <verse eid="ISA 29:9"/><verse number="10" style="v" sid="ISA 29:10"/>ጎዳይ ስኮ አያና ህንተ ቦላ ጉስስ። ናበቶ፥ ህንተ አይፈይ ጎዘትስ፤ ቆንጨ በኤይሳቶ፥ ህንተ ሁጰይ ካመትስ።<note caller="-" style="x"><char style="xo" closed="false">29:10 </char><char style="xt" closed="false"><ref loc="ROM 11:8">ሮመ 11:8</ref>.</char></note><verse eid="ISA 29:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11"/>ሀ ኡባ ቆንጨይ ነዉ አታመትዳ ማፃፋ መላ ግድስ። እስ አስ፥ “ሄኤ፥ ሀይሳ ናባባ” ያግድ፥ እስ ናባቦ ኤርያ አሳስ እምያ ዎደ፥ እ፥ “ማፃፋይ አታመትዳ ግሾ፥ ታ ናባባናዉ ዳንዳእከ” ያጋና። <verse eid="ISA 29:11"/><verse number="12" style="v" sid="ISA 29:12"/>ማፃፋ ናባብ ኤሮና አሳኮ፥ “ሄኤ፥ ሀይሳ ናባባ” ያግድ እምያ ዎደ፥ እ፥ “ታኒ ናባባ ኤርከ” ያጋና።<verse eid="ISA 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13"/>ጎዳይ ያጌስ፦ “ሀ አሳይ ታና ባንታ ዶናን ቦንቼስ፤ ሽን ኤንታ ዎዛናይ ታፐ ሃሆን ደኤስ። ኤንቲ አስ መዳ ዎጋ ታማርስሸ ታና ጮ ጎይኖሶና።<note caller="-" style="x"><char style="xo" closed="false">29:13 </char><char style="xt" closed="false"><ref loc="MAT 15:8-9">ማቶ 15:8-9</ref>፤ <ref loc="MRK 7:6-7">ማር 7:6-7</ref>.</char></note> <verse eid="ISA 29:13"/><verse number="14" style="v" sid="ISA 29:14"/>ሄሳ ግሾ፥ ታኒ ሀ አሳ ቦላ ዛራ ዛራ ማላልስያባ ኦና። ጭንጫታ ጭንጫተ ኤያ ከሳና፤ ኤራንቾታ ኤራ ዶግሳና”<note caller="-" style="x"><char style="xo" closed="false">29:14 </char><char style="xt" closed="false"><ref loc="2CO 1:19">2 ቆሮ 1:19</ref>.</char></note> ያግስ።<verse eid="ISA 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 29:15"/>ባንታ ሀልቹዋ ጎዳፐ ቆሳናዉ ጪሞየይሳታ፥ ባንታ ኦሱዋ ማን ኦሸ፥ “ኑና ኦን በኢ? ኑና ኦን ኤሪ?” ያገይሳታ አየ! <verse eid="ISA 29:15"/><verse number="16" style="v" sid="ISA 29:16"/>ህንተ ኡባባ ሽር የጌታ። ኦቶ መይስ ኡርቃ መላ ግድ ቆፔታ! መትዳይስ መዳይሳ፥ “እ ታና መቤና” ግዬ? ኦቶይ ባና መዳይሳ፥ “እ አይኮካ ኤረና” ጋናዉ ዳንዳኢ?<note caller="-" style="x"><char style="xo" closed="false">29:16 </char><char style="xt" closed="false"><ref loc="ISA 45:9">እሳ 45:9</ref>.</char></note><verse eid="ISA 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 29:17"/>ልባኖሰ ዎራይ አራዳ ጋደ ግዳናዉ፤ ቃስ አራዳ ጋደይ ዎራ ግዳናዉ ጉ ዎደይ አትስ ግደኔ?<verse eid="ISA 29:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 29:18"/>ሄ ጋላስ ቱለት ማፃፋ ቃላ ስአና፤ ማን ደእያ ቆቀታ አይፈይ ፄላና። <verse eid="ISA 29:18"/><verse number="19" style="v" sid="ISA 29:19"/>አሽከት ጎዳን ኡፋይታና፤ ማንቆት እስራኤለ ጌሻን ሀሹ ጋና። <verse eid="ISA 29:19"/><verse number="20" style="v" sid="ISA 29:20"/>ኡሎ ኢታት ዉራና፤ ቀልቅሰይሳት ትምእ ጋና፤ ኢታባ ኦናዉ ዎችያ ኡባይ ያና። <verse eid="ISA 29:20"/><verse number="21" style="v" sid="ISA 29:21"/>አሰ ኦዳን ባላ ኦይሳት፥ ሞተትዳይሳ ፕርዳ ኬን ፅሄን የገይሳትነ ዎርዶ ማርካተን ፅሎ አሳ ፕርዳ ጌላየይሳት ያና።<verse eid="ISA 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22"/>ሄሳ ግሾ፥ አብራሃመ ዎዝዳ ጎዳይ ያይቆባ ኮቻኮ ሀይሳዳ ያጌስ፦ “ያይቆባ ኮቻይ ህዛፐ ጉየ ዬላተና፤ እያ ሶምኦይ ዬላትድ ሳአ ፄለና። <verse eid="ISA 29:22"/><verse number="23" style="v" sid="ISA 29:23"/>ሽን ኤንቲ ታ ኩሸ ኦሶ ግድዳ ባንታ ናይታ ባንታ ግዶን በእያ ዎደ ታ ሱን ጌሻና፤ ኤንቲ ያይቆባ ጌሻ፥ ጌሻተ ናጋና፤ እስራኤለ ፆሳ ያሻተን ቦንቻና። <verse eid="ISA 29:23"/><verse number="24" style="v" sid="ISA 29:24"/>አያናን ባለይሳት አኬካ ደማና፤ ዙዙመይሳት ትምርተ ኤካና” ያጌስ።<verse eid="ISA 29:24"/></para>
  <chapter eid="ISA 29"/>
  <chapter number="30" style="c" sid="ISA 30"/>
  <para style="s1">እፃስ ግያ ደርያ አየ!</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 30:1"/>ጎዳይ፥ “ጌላ ናይታ አየ! ታኒ ሀልቻቦና ኦሶና፤ ታ አያናን ግዶናሽን ባንታ ሸነን ጫቅድ ናጋራ ቦላ ናጋራ ጉጀይሳታ አየ! <verse eid="ISA 30:1"/><verse number="2" style="v" sid="ISA 30:2"/>ታና ዞረ ኦይቾና ግብፀ ዎኦሶና። ፓሮና ሚፃ ባንታዉ ተቀ፥ ግብፀ ባንታዉ ሸምፕያ ኩያ ኦሶና። <verse eid="ISA 30:2"/><verse number="3" style="v" sid="ISA 30:3"/>ሽን ፓሮና ሚፃይ ህንተዉ ዬላ፥ ግብፀ ኩያይ ህንተዉ ካዉሻተ ግዳና። <verse eid="ISA 30:3"/><verse number="4" style="v" sid="ISA 30:4"/>ኤንታ ሀላቃት ፃነሳን ደእኮካ፥ ኤንቲ ኪትዳይሳት ሀኔሳ ካታማ ጋክኮካ፥ <verse eid="ISA 30:4"/><verse number="5" style="v" sid="ISA 30:5"/>ዬላፈ አትሽን፥ ሀራ ማደይነ ጎእ ባይና ግሾ እያን አማነትያ ኡባይ ካዉያናነ ዬላታን” ያጌስ።<verse eid="ISA 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6"/>ነገባን ደእያ ዶአታባ ጎዳይ ኦድዳይ ሀይሳ፦ ኪተትዳይሳት መቶይነ ኡንእ ደእያ ቢታራ፥ አደ ጋሞይነ ማጫ ጋሞይ ዎራራ፥ ኢታነ ፆንገትያ ሾሻት ደእያ ባዙዋራ ካንድ ባና። ሀረታነ ግማለታ ዞኮን ባንታ ዱረተ ጫንድ ኤንታ አይኮካ ማዶና ቢታ ባና። <verse eid="ISA 30:6"/><verse number="7" style="v" sid="ISA 30:7"/>ግብፀይ አይኮካ ማደና፤ ሄሳ ግሾ፥ ታኒ እያ፥ “ፓና ራኣባ” ያጋዳ ፄጋና።<verse eid="ISA 30:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 30:8"/>ሀእ ባዳ ስንራ ያና ዎድያስ መርና ማላ ግዳና መላ ኤንታ ስንን ሹቻ ዎጫዳ ፃፋ፤ ማዝጋበንካ ፃፋ። <verse eid="ISA 30:8"/><verse number="9" style="v" sid="ISA 30:9"/>ኤንቲ ጌላነ ዎርዳንቾ ናይታ፤ ኤንቲ ጎዳይ ኦድያባ ስአናዉ ኮዮና ናይታ። <verse eid="ISA 30:9"/><verse number="10" style="v" sid="ISA 30:10"/>ኤንቲ ቆንጨ በኤይሳታ፥ “ቆንጨ በኦፕተ” ያጎሶና። ናበታ፥ “ኡፋይስያባነ ጭምያባ ኦድተፐ አትሽን፥ ሱረባ ኦዶፕተ። <verse eid="ISA 30:10"/><verse number="11" style="v" sid="ISA 30:11"/>ኦግያፐ ክችተ፤ ሆሮጋፐ ሃክተ፤ እስራኤለ ጌሻራ ኑና ሶምኦን ጋፍተ” ያጎሶና።<verse eid="ISA 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 30:12"/>ሄሳ ግሾ፥ እስራኤለ ጌሻይ ሀይሳዳ ያጌስ፦ “ህንተ ሀ ቃላ እፅድ፥ ገነንነ ጭሞን አማነትዳ ግሾ፥ <verse eid="ISA 30:12"/><verse number="13" style="v" sid="ISA 30:13"/>ሀ ናጋራይ ህንተዉ ዛእድ ዎድያ፥ አኬኮና ኤለስድ ኩንድያ አዱሳ ግምበ መላ ግዳና። <verse eid="ISA 30:13"/><verse number="14" style="v" sid="ISA 30:14"/>እያ መቆይ ኡርቃፈ መዳ ኦቶ መላ ድፕ ግድ መቃና። ሄ መቁዋ ግዶፈ ታማ ካሽያ ዎይኮ ሃ ዱቅያ ኩንእ በንተና” ያጌስ።<verse eid="ISA 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 30:15"/>እስራኤለ ጌሻይ፥ ኡባ ሃርያ ጎዳይ፥ ሀይሳዳ ያጌስ። “ስሞንነ ሸምፖን ህንተ አታና፤ ስእ ጉሳንነ አማነተን ህንተዉ ዎልቃ ግዳና፤ ሽን ህንተ እፅደታ። <verse eid="ISA 30:15"/><verse number="16" style="v" sid="ISA 30:16"/>ህንተ፥ ‘አካይ፥ ኑኒ ፓራ ቦላ ኡትድ ባቃታና’ ያግደታ፤ ሄሳ ግሾ፥ ህንተ ባቃታና። ቃስ ህንተ፥ ‘ኤሶትያ ፓራ ቶግድ ባና’ ” ያግደታ፤ ሽን ህንተና የደይሳት ህንተፈ አ ኤሶታና። <verse eid="ISA 30:16"/><verse number="17" style="v" sid="ISA 30:17"/>እስ ቶራንቹዋ በእድ ህንተፈ ሙኩሉ አሳይ ባቃታና፤ እቻሹ ቶራንቾት ህንተና ኡባ የደና። ዙማ ሁጰን ኤቅዳ ባንድራ ምዳ ዎይኮ ዙማ ቦላ ደእያ ማላዳ ህንተ ሀናና ጋካናዉ ህንተና የደና።<verse eid="ISA 30:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 30:18"/>ሽን ጎዳይ ህንተዉ ኬሀናዉ ናጌስ፤ ጎዳይ ፅሎ ፕርድያ ፆሲ ግድያ ግሾ ህንተዉ ቃታናዉ ደንዳና። እያ አማነትድ ናግያ ኡባይ አንጀትዳይሳታ።<verse eid="ISA 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19"/>ህንተኖ፥ የሩሳላመን ደእያ ፅዮነ አሳዉ፥ ህዛፐ ጉየ ዬከከታ። ፆሳይ ቃን ኩምዳ ፆሲ ግድያ ግሾ፥ ህንተ ማደ ኮይድ እያኮ ዋስያ ዎደ ህንተዉ ዛሮ እማና። <verse eid="ISA 30:19"/><verse number="20" style="v" sid="ISA 30:20"/>ጎዳይ ህንተዉ መቶ ካነ ኡንአ ሃ እምኮካ፥ ህንተ አስታማረይ ህዛፐ ባና ቆሰና። ሽን ህንተ አይፈይ ህንተ አስታማርያ በአና። <verse eid="ISA 30:20"/><verse number="21" style="v" sid="ISA 30:21"/>ህንተ ኡሻች ዎይኮ ሀድርስ ስምያ ዎደ፥ ጉየራ ህንተና፥ “ኦገይ ሀይሳ፤ እያራ ቢተ” ግያ ቃላ ህንተ ስአና። <verse eid="ISA 30:21"/><verse number="22" style="v" sid="ISA 30:22"/>ብራንነ ዎርቃን አሌቀትዳ ኤቃ ምስለታ ህንተ ቱንሳና። ቱና ጩርቃዳ ህንተ ኤንታ፥ “ኑፐ ሃክተ” ያግድ ዎራ ሆላና።<verse eid="ISA 30:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23"/>ሄ ዎደ እ፥ ህንተ ቢታን ዘርዳ ካስ እራ ቡክሳና፤ ቢታፈ ዶልያ ካይ ዳሮነ ሙሩታ ግዳና። ሄ ጋላስ ህንተ መሄይ ዳልጋ ደንባን ሄመታና። <verse eid="ISA 30:23"/><verse number="24" style="v" sid="ISA 30:24"/>ጎሻ ቦራትነ ሀረት ግላን ፑነትዳ ጌሻ ሀርቁዋ ማና። <verse eid="ISA 30:24"/><verse number="25" style="v" sid="ISA 30:25"/>አስ ዉርያ ዎደ ሚፃት ላለትያ ጋላስ ደረታነ ዙማታ ቦላፈ ፑልቶ ሃ ጎጋና። <verse eid="ISA 30:25"/><verse number="26" style="v" sid="ISA 30:26"/>ሄ ጋላስ አጌና ፖኦይ አዋ ፖኦዳ ሀናና፤ አዋ ፖኦይ ካሰይሳፈ ላፑን ኩሸ ዳራና፤ ላፑን ጋላስ ፖኡዋ መላ ግዳና። ሄ ኡባይ ሀናናይ ጎዳይ መቅዳ ባ አሳ ኮልያ ዎደነ እ ደችን ማዱንፅዳ አሳ ፓያ ዎደ።<verse eid="ISA 30:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ISA 30:27"/>ሄኮ፥ ጎዳ ሱንይ ሱልያ ሀንቁዋራ፥ ምዳ ጩያ ሻራራ ሃሆ በሳፈ ያና። እያ ዶናን ሀንቆይ ኩምስ፤ እያ እንፃርሳን ምያ ታም ደኤስ። <verse eid="ISA 30:27"/><verse number="28" style="v" sid="ISA 30:28"/>እያ ፔኖይ፥ ቆ ጋካናዉ ክፅድ፥ ኡባባ ፕትድ ኤፍያ ሃ ክፃ መላ። እ፥ ካዎተታ ዮ ዛርዛረን ሀርቃና፤ አሳ ጋፓታ ብፃልድ ኦገ ባለና። <verse eid="ISA 30:28"/><verse number="29" style="v" sid="ISA 30:29"/>ጌሻ ባለይ ቦንቸትያ ጋላስ የፀይሳዳ፥ ህንተ የፃና። ጎዳ ዙማኮ፥ እስራኤለ ዛላኮ ብያ ዎደ ሱሱልኤ ፑንሸ የፅያ አሳይ ኡፋይተይሳዳ ህንተ ኡፋይታና።<verse eid="ISA 30:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 30:30"/>ጎዳይ ባ ያሽያ ቃላ ስሳና፤ ባ ሱልያ ሀንቁዋን፥ ታማ ላጩዋን፥ ጎትያን፥ ኡሹዋንነ ሻቻን ባ ቀስያ ቆንጭሳና። <verse eid="ISA 30:30"/><verse number="31" style="v" sid="ISA 30:31"/>ጎዳይ ባ ግርሳን አሶረ ዳጋንና፤ እያ ፃምአይ ኤንታ ሾጫና። <verse eid="ISA 30:31"/><verse number="32" style="v" sid="ISA 30:32"/>ጎዳይ ኤንታ ባ ሴርያ ፃምአን ኤንታ ሾጭያ ዎደ እያ አሳይ ካራቦራነ ዲራ የፃና። ባ ቀስያ ደንድ ኤንታ ሾጫና። <verse eid="ISA 30:32"/><verse number="33" style="v" sid="ISA 30:33"/>በንፐ ዶምድ አሶረ ካዎይ ፁሳ ቶፈታ ጌተትያ በሲ ጊግስ። ሄ በሳይ ኦላነ ዳልጋ፤ ቃስ ዳሮ ም ዶረትድ ደእያ በሲ። ጎዳ ፔኖይ ዲነ ሻፋዳ ጎግድ፥ ሄ ታማ ኤና።<verse eid="ISA 30:33"/></para>
  <chapter eid="ISA 30"/>
  <chapter number="31" style="c" sid="ISA 31"/>
  <para style="s1">ግብፀ ቦላ ዘምፐይሳታ አየ!</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 31:1"/>ማዶ ደማናዉ ግብፀ ዎይሳታነ ፓራን አማነተይሳታ አየ! ፓራ ጋረታ ዳሮተንነ ፓራ አሳታ ምኖተን አማነተይሳታ አየ! ኤንቲ እስራኤለ ጌሻ ፄሎኮና ዎይኮ ጎዳፐ ማዶ ኮዮኮና። <verse eid="ISA 31:1"/><verse number="2" style="v" sid="ISA 31:2"/>ሽን ጎዳይ ጭንጫ ግድያ ግሾ ጋዶ የዳና፤ እ ኦድዳይሳ አገና። ኢታ አሳ ቦላነ ኢታባ ኦያ አሳ ማደይሳታ ቦላ ደንዳና። <verse eid="ISA 31:2"/><verse number="3" style="v" sid="ISA 31:3"/>ግብፀት አሰፐ አትሽን፥ ፆሰ ግዶኮና፤ ኤንታ ፓራትካ አሾፐ አትሽን፥ አያና ግዶኮና። ጎዳይ ሀንቆን ባ ቀስያ ደንያ ዎደ ማደይስ በታና፤ ማደተይስ ኩንዳና፤ ኤንቲ ኡባይ እስፈ ያና።<verse eid="ISA 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 31:4"/>ጎዳይ ታኮ ሀይሳዳ ያግስ፦ “ጋሞይ ዎይኮ ዎዳላ ጋሞይ መሄ ኦይክድ ዳርያ ዎደ ሄንንቾት ፄገትድ ሺቅኮካ፥ እ ኤንታ ዋሱዋስ ዳጋመና፤ ኤንታ ቃላስ ያየና። ሄሳዳካ፥ ኡባፈ ዎልቃማ ጎዳይ ፅዮነ ዙማነ እያ ዙማታ ኦላናዉ ዎና። <verse eid="ISA 31:4"/><verse number="5" style="v" sid="ISA 31:5"/>ካፎይ አለይሳዳ ኡባፈ ዎልቃማ ጎዳይ የሩሳላመ ገቻና፥ አሻና፥ ናጋና፤ እያ ቦላራ አልድ ሄማና።<verse eid="ISA 31:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6"/>“ህንተኖ እስራኤለ አሳዉ፥ ህንተ ማካልድ እፅዳ፥ እያኮ ስምተ። <verse eid="ISA 31:6"/><verse number="7" style="v" sid="ISA 31:7"/>ሄ ጋላስ ናጋር ኩምዳ ህንተ ኩሽያን ብራፐነ ዎርቃፈ ኦዳ ኤቃታ ዎራ ሆላና። <verse eid="ISA 31:7"/><verse number="8" style="v" sid="ISA 31:8"/>አሶረይ አሳባ ግዶና ማሻን ኩንዳና፤ አሳባ ግዶና ማሽ ኤንታ ማና። ኤንቲ ማሻ ስንፈ ባቃታና፤ ኤንታ ናአተት ዎልቃን አሳስ ኦና። <verse eid="ISA 31:8"/><verse number="9" style="v" sid="ISA 31:9"/>ዳጋማ ጋሶን ኤንታ ምኖ ሚፃይ ላለታና፤ ኤንታ ቶራ ሞጮናት ዳጋምድ የግ ያና” ያጌስ፥ እያ ታማይ ፅዮነን፥ እያ ጮጨይ የሩሳላመን ደእያ ጎዳይ።<verse eid="ISA 31:9"/></para>
  <chapter eid="ISA 31"/>
  <chapter number="32" style="c" sid="ISA 32"/>
  <para style="s1">ፅሎተ ኩምዳ ካዎተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 32:1"/>ሄኮ፥ ካዎይ ፅሎተን ካዎታና፤ ሃረይሳት ሱረተን ሃራና። <verse eid="ISA 32:1"/><verse number="2" style="v" sid="ISA 32:2"/>እስ እስ አስ ባ ሁጰን ጫርኮፈ ጌምያ በሲ፥ ጎተፐ ቆሰትድ አትያ በሲ ግዳና። መላ ቢታን ጎግያ ሃ መላነ ሳሞ ቢታን ግታ ዛላ ኩያ መላ ግዳና። <verse eid="ISA 32:2"/><verse number="3" style="v" sid="ISA 32:3"/>ፄልያ አሳታ አይፈይ ቅልምኤና፤ ስእያ አሳታ ሀይይ ሀይዝድ ስአና። <verse eid="ISA 32:3"/><verse number="4" style="v" sid="ISA 32:4"/>ኤሶትያ አሳ ዎዛናይ ኤራናነ አኬካና። ደዶትያ አሳ እንፃርሳይ ብለታና፤ ጌሽድ ኦደታና። <verse eid="ISA 32:4"/><verse number="5" style="v" sid="ISA 32:5"/>ህዛፐ ጉየ ኤይ አስ ኤራንቾ ጌተተና፤ ኢታ አስ ቦንቸተና። <verse eid="ISA 32:5"/><verse number="6" style="v" sid="ISA 32:6"/>ኤያይ ኤያተ ኦደቴስ፤ እያ ዎዛናይ ናጋራ ቆፔስ። ጎዳ ቦላ ምኖባ ኦደቴስ፤ እያ ቦላ ኢታባ ማቀቴስ፦ ኮሻትዳይሳስ ካ እመና፤ ሳሞትዳይሳ ሃ ድጌስ። <verse eid="ISA 32:6"/><verse number="7" style="v" sid="ISA 32:7"/>ገነ አሳ ቆፋይ ኢታ፤ ማንቆት ሱረባ ኦደትኮካ ኤንታ ይሳናዉ ዎርዶን ኢታ ቆፋ ቆፔስ። <verse eid="ISA 32:7"/><verse number="8" style="v" sid="ISA 32:8"/>ሎኦ አስ ሎኦባ ሀልቼስ፤ ሄ ሎኦ ሀልቹዋን ምንድ ደኤስ።<verse eid="ISA 32:8"/></para>
  <para style="s1">የሩሳላመ ማጫሳ</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 32:9"/>ህንተኖ ቆፍ ባይና ደእያ ማጫሳዉ፥ ደንድተ፤ ታ ኦደይሳ ስእተ፤ ህንተኖ አማነትድ ደእያ ማጫ ናይቶ፥ ታ ህንተዉ ኦደይሳ ስእተ። <verse eid="ISA 32:9"/><verse number="10" style="v" sid="ISA 32:10"/>ላይ ኩሞና ህንተ አማነትድ ደኤይሳት ኮኮራና፤ ዎይነ እያ ዎድያን ማፀከታ፤ ቶክዳባፐ አይፈ ሺሸከታ። <verse eid="ISA 32:10"/><verse number="11" style="v" sid="ISA 32:11"/>ህንተኖ እንጀትን ደእያ ማጫሳዉ ኮኮርተ። ህንተኖ አማነትድ ደእያ ማጫ ናይቶ ያይተ። ህንተ ማኡዋ ቃርድ ካዮ ማኦ ህንተ ፄሳን ዳንጭተ። <verse eid="ISA 32:11"/><verse number="12" style="v" sid="ISA 32:12"/>ሎኦ ጋደን አይፍያ ዎይነይ ይዳ ግሾ፥ አዛንድ ህንተ ትራ ቆፅተ። <verse eid="ISA 32:12"/><verse number="13" style="v" sid="ISA 32:13"/>አጉንነ ክንቾተይ ታ አሳ ጋድያን ዶልስ። አሳይ ኡፋይትድ ደእዳ ኬታስነ ካታማስ ዬክተ። <verse eid="ISA 32:13"/><verse number="14" style="v" sid="ISA 32:14"/>ካዎ ኬይነ ዳሮ አሳይ ደእያ ካታማይ ባይሳታና፤ ሚፃትነ ግምበ ሻኮት መርናዉ ላለታና፤ ዎራ ሀረት ኡፋይትያ በስነ ዶርሳ ዉደይ ሄመትያ በሲ ግዳና።<verse eid="ISA 32:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 32:15"/>ሄስ ሀናናይ፥ አያናይ ኑ ቦላ ጉካና ጋካናዉ፥ መላ ቢታይ አራዳና ጋካናዉነ አራዳ ቢታይ ዎራ ግዳና ጋካናሳ። <verse eid="ISA 32:15"/><verse number="16" style="v" sid="ISA 32:16"/>ሄሳፈ ጉየ፥ መላ ቢታን ሱረ ፕርድ፥ አራዳ ቢታን ፅሎተ ዳና። <verse eid="ISA 32:16"/><verse number="17" style="v" sid="ISA 32:17"/>ፅሎተ ሳሮተ ኤሀና፥ ዎፓተነ አማነተ መርናዉ ቢታ ኩማና። <verse eid="ISA 32:17"/><verse number="18" style="v" sid="ISA 32:18"/>ታ አሳይ ሳሮይ ኩምዳ ኬን፥ አማንያ በሳንነ ዎፑ ግዳ ሶን ሸምፕድ ዳና። <verse eid="ISA 32:18"/><verse number="19" style="v" sid="ISA 32:19"/>ሻች ቡክድ ዎራ ይስያኮካ፥ ቃስ ካታማይ ኩም ላለትያኮካ፥ <verse eid="ISA 32:19"/><verse number="20" style="v" sid="ISA 32:20"/>ሻፋታ ጋፃን ህንተ ካ ዘርድ፥ ህንተ መህያስነ ህንተ ሀረታስ ሄን በሲ ደመይሳት ህንተ አንጀታና።<verse eid="ISA 32:20"/></para>
  <chapter eid="ISA 32"/>
  <chapter number="33" style="c" sid="ISA 33"/>
  <para style="s1">ኡንአነ ማዶ ኮሽ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 33:1"/>ነና ይሶና ደእሽን ሀራ ይሰይሶ፥ ነና አድ እሞና ደእሽን ሀራ አ እመይሶ፥ ነና አየ! ነ ይሶ አግዳ ዎደ ነና ይሳና፤ ነ አ እሞ አግዳ ዎደ ነና አድ እማና።<verse eid="ISA 33:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 33:2"/>አቤት ጎዳዉ፥ ኑና ማራ፤ ኑኒ ነና ኡፋይሳን ናጎስ፤ ዎንታ ዎንታ ኑስ ዎልቃ ግዳ፤ መቶ ዎደ ኑና አሻ። <verse eid="ISA 33:2"/><verse number="3" style="v" sid="ISA 33:3"/>ነ ግርሳ ደሹዋን ደረይ ባቃቴስ፤ ኔኒ ኑና ማዳናዉ ደንድያ ዎደ ካዎተት ላለቶሶና። <verse eid="ISA 33:3"/><verse number="4" style="v" sid="ISA 33:4"/>ጎንዶይ ሺቀይሳዳ ህንተ ድኦይ ሺቃና፤ ቦለይ ድርገይሳዳ አሳይ እያ ቦላ ድርጋና።<verse eid="ISA 33:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 33:5"/>ጎዳይ ቦላ ደእያ ግሾ፥ ቁ ቁ ግስ፤ ፅዮነ ሱረ ፕርዳንነ ፅሎተን ኩንና። <verse eid="ISA 33:5"/><verse number="6" style="v" sid="ISA 33:6"/>እ ህንተ ዎድያስ አማንያ ባሶ ግዳና፤ ህንተዉ አቶተ፥ ጭንጫተነ ኤራተ ግዳና፤ ጎዳስ ያሽ ሀ ኡባ ሻሉዋስ ቁልፐ ግዳና።<verse eid="ISA 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 33:7"/>ሄኮ፥ ጎባት ኦገ ቦላ ዋሶሶና፤ ስገናዉ ኪተትዳይሳት ጫመትድ ዬኮሶና። <verse eid="ISA 33:7"/><verse number="8" style="v" sid="ISA 33:8"/>ዎጋ ኦገት ካይሳትዶሶና፤ ኦግያራ ካንያ አስ ባዋ። ጫቆይ ላለትስ፤ ካታማት ካትዶሶና፤ ቦንቾ አሳት ቦረትዶሶና። <verse eid="ISA 33:8"/><verse number="9" style="v" sid="ISA 33:9"/>ቢታይ አዛንስ፤ ዳቡርስ፤ ልባኖሰይ ዬላትድ መልስ፤ ሳሮና ዛንጋራይ መላ ቢታ ግድስ። ባሳነ ደርያንነ ቃርመሎሳ ደርያን ደእያ ም ሀይይ ቆቆፈትስ።<verse eid="ISA 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 33:10"/>ጎዳይ ሀይሳዳ ያጌስ፦ “ሀእ ታኒ ደንዳና፤ ሀእ ታኒ ቦንቸታና፤ ሀእ ታኒ ቁ ቁ ጋና። <verse eid="ISA 33:10"/><verse number="11" style="v" sid="ISA 33:11"/>ህንተ ኡቱላ ቃንትድ ፑኖ የልደታ፤ ህንተ ሸምፖይ ህንተና ታማዳ ማና። <verse eid="ISA 33:11"/><verse number="12" style="v" sid="ISA 33:12"/>አሳይ ቦቅንተ ሹቻዳ ታማን ፁገታና፤ ቃስ አጉንዳ ታማን ኤፃና። <verse eid="ISA 33:12"/><verse number="13" style="v" sid="ISA 33:13"/>ህንተኖ፥ ሃሆን ደኤይሳቶ፥ ታ ኦዳይሳ ስእተ፤ ማታን ደኤይሳቶ ታ ዎልቃ አኬክተ” ያጌስ።<verse eid="ISA 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 33:14"/>ፅዮነን ደእያ ናጋራንቾት ዳጋምዶሶና፤ ፆሳ ኤሮናይሳት ኮኮርዶሶና። ኤንቲ፥ “ኑ ግዶፈ ምያ ታማራነ መርናዉ ኤፅያ ላጩዋራ ዳናዉ ዳንዳኤይ ኦኔ?” <verse eid="ISA 33:14"/><verse number="15" style="v" sid="ISA 33:15"/>ፅሎተን ሄመተይ፥ ሱረ ኦደተይ፥ በሶና ኦገራ በንትያ ጎአ እፀይ፥ ባ ኩሽያ ዎፈ ኤኮና መላ ድገይ፥ ሸምፖ ዎባ ስኦና መላ ባ ሀይ ቱጨይ፥ ኢታባ ፄሎና መላ ባ አይፍያ ካመይ፥ <verse eid="ISA 33:15"/><verse number="16" style="v" sid="ISA 33:16"/>ሄ ኡራይ ቃ በሳን ዳና። እ፥ ቆሰትድ አትያ በሳይ ምኖ ዛላ ግዳና፤ እያ ካይ እያዉ እመታና፤ እ፥ ኡያ ሃይ ፓጨና።<verse eid="ISA 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 33:17"/>ህንተ አይፈይ ካዋ፥ እያ የገልሳራ በአና፤ ሃሆን ደእያ ቢታ ደማና። <verse eid="ISA 33:17"/><verse number="18" style="v" sid="ISA 33:18"/>ህንተ፥ “ሀላቃይ አዉን ደኢ? ጊራ ኤከይስ አዉን ደኢ? ግምበ ሻኮታ ሀላቃይ አዉን ደኢ?” ያግድ ህንተ ዎዛናን በን ያሽያ ዎድያ ቆፓና። <verse eid="ISA 33:18"/><verse number="19" style="v" sid="ISA 33:19"/>ዎዛና ምኖ አሳ፥ ህንተዉ ገሎና ዶናን ኦደትያ አሳነ እንፃርሳይ ደዶትያ አሳ ህዛፐ ጉየ ህንተ በኤከታ።<verse eid="ISA 33:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 33:20"/>ኑኒ ኑ ባኣለ ቦንችያ ፅዮነ ካታማ በእተ! ዎፑ ግድ ደእያ፥ እያ ሸይ ሾደቶና፥ እያ ዎዶሮይ ዱፆናነ እያ ሸይ ቃፆና ዱንካነ መላ ሀንዳ የሩሳላመ ካታማ ህንተ፥ ህንተ አይፈን በአና። <verse eid="ISA 33:20"/><verse number="21" style="v" sid="ISA 33:21"/>ሄ በሳን ጎዳይ ኑስ ዎልቃ ግዳና። ሄ በሳይ ዳልጋ ሳፋነ ጎግያ ሃ መላ ግዳና። ዎጎሎይ እያ ቦላራ ባናዉ ዳንዳኤና፤ ግታ ማርካበት ያራ ካንናዉ ዳንዳኦኮና። <verse eid="ISA 33:21"/><verse number="22" style="v" sid="ISA 33:22"/>ጎዳይ ኑስ ፕርደይሳ፤ ጎዳይ ኑስ ህገ እመይሳ፤ ጎዳይ ኑ ካዋ፤ እ ኑና አሻና።<verse eid="ISA 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 33:23"/>ነ ቃሾ ዎዶሮይ ዶልአና፤ ማርካብያ ቱሳይ ሹጋና፤ እያ ሻራይካ ቶለትቤና። ሄ ዎደ ዳሮ ድኦ ሻከታና፤ ሀር አቶሽን ዎበትካ ድኦ ኤካና። <verse eid="ISA 33:23"/><verse number="24" style="v" sid="ISA 33:24"/>ፅዮነን ደእያ ኦንካ “ታና ሳኬስ” ያገና፤ ያን ደእያ አሳ ናጋራይ አቶ ጌተታና።<verse eid="ISA 33:24"/></para>
  <chapter eid="ISA 33"/>
  <chapter number="34" style="c" sid="ISA 34"/>
  <para style="s1">ካዎተት ፕርደታና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 34:1"/>ህንተኖ፥ ካዎተቶ፥ ሺቅድ ስእተ! ህንተኖ፥ አሳዉ አኬክተ! ቢታይነ ቢታን ደእያባ ኡባይ፥ ሳእነ ሳአፐ ከያባ ኡባይ ስኦ። <verse eid="ISA 34:1"/><verse number="2" style="v" sid="ISA 34:2"/>ጎዳይ ካዎተታ ኡባ ቦላ ሀንቀትስ፤ ኤንታ ቶራንቾታ ኡባ ቦላ ይሎትስ። እ፥ ኤንታ ኡባ ይሳና፤ ኤንታ ሹከይሳታስ አድ እማና። <verse eid="ISA 34:2"/><verse number="3" style="v" sid="ISA 34:3"/>ኤንታ አሀይ ሆለትድ፥ አትድ ፅንቃና፤ ደረት ኤንታ ሱን ካመታና። <verse eid="ISA 34:3"/><verse number="4" style="v" sid="ISA 34:4"/>ሳሎ ፆልንቶት ኡባይ ሴራና፤ ሳሎት ሳሌናዳ ፃፀታና። ዎይነ ሀይነ ባላሰ አይፈይ ቆቆፈተይሳዳ ፆልንቶት ኡባይ ቆቆፈታና።<note caller="-" style="x"><char style="xo" closed="false">34:4 </char><char style="xt" closed="false"><ref loc="MAT 24:29">ማቶ 24:29</ref>፤ <ref loc="MRK 13:25">ማር 13:25</ref>፤ <ref loc="LUK 21:26">ሉቃ 21:26</ref>፤ <ref loc="REV 6:13-14">ቆን 6:13-14</ref>.</char></note> <figure style="fig" alt="Scrole" file="HK00150B.tif" size="col" ref="34:4">ፃ ማፃፋ</figure><verse eid="ISA 34:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 34:5"/>ታ ማሻይ ሳሎታን አላና ጋካናዉ ኡይስ፤ ሄኮ ኤዶመ ቦላ፥ ታኒ ይስዳ አሳ ቦላ ፕርዳናዉ ዎና።<note caller="-" style="x"><char style="xo" closed="false">34:5 </char><char style="xt" closed="false"><ref loc="ISA 63:1-6">እሳ 63:1-6</ref>፤ <ref loc="JER 49:7-22">ኤርም 49:7-22</ref>፤ <ref loc="EZK 25:12-14">ህዝ 25:12-14</ref>፤ <ref loc="EZK 35:1-15">35:1-15</ref>፤ <ref loc="AMO 1:11-12">አሞ 1:11-12</ref>፤ <ref loc="OBA 1:1-14">አብድ 1-14</ref>፤ <ref loc="MAL 1:2-5">ምልክ 1:2-5</ref>.</char></note> <verse eid="ISA 34:5"/><verse number="6" style="v" sid="ISA 34:6"/>ጎዳ ማሻይ ሱን ሙከትስ። ያርሾስ ሹከትያ ዶርሳታነ ዴሻታ ሱን ማሽ ሙከተይሳዳነ ኤንታ ክላሆ ሞዋን ካመተይሳዳ ጎዳ ማሻይ ሱን ሙከትስ፤ ሞዋን ካመትስ። ጎዳይ ባሶራ ካታማን ያርሾ፥ ኤዶመ ቢታን ግታ ሹካ ጊግስስ። <verse eid="ISA 34:6"/><verse number="7" style="v" sid="ISA 34:7"/>መንት፥ ዎፋኖትነ ቦራት ኤንታራ ኩንዳና። ኤንታ ጋደይ ሱ ፃላላ ግዳና፤ ኤንታ ቢታይ ሞን ሙኑቀታና። <verse eid="ISA 34:7"/><verse number="8" style="v" sid="ISA 34:8"/>ጎዳይ ሀሎ ከያና ጋላስነ ፅዮነ ኦልዳ ሞርከታ ቦላ ኩሸ ዛርያ ላይ ጊግስስ።<verse eid="ISA 34:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 34:9"/>ኤዶመ ሻፋት መልድ ማደ ግድስ፤ እያ ባናይ ዲነ ላመታና፤ እያ ቢታይ ኤፅያ ማደ ግዳና። <verse eid="ISA 34:9"/><verse number="10" style="v" sid="ISA 34:10"/>ቃማነ ጋላስ ታማይ ቶኤና፤ እያ ጩያይ መርናዉ ጩያና። ኤዶመ ቢታይ የለተፈ የለተ ጋካናዉ ባይሳ ግዳና፤ ኦንካ መርናዉ ያራ ካንና።<note caller="-" style="x"><char style="xo" closed="false">34:10 </char><char style="xt" closed="false"><ref loc="REV 14:11">ቆን 14:11</ref>፤ <ref loc="REV 19:3">19:3</ref>.</char></note> <verse eid="ISA 34:10"/><verse number="11" style="v" sid="ISA 34:11"/>ሽን ፅሎይነ ቁፃረይ እያ ላታና፤ ጉቶይነ ቁሮይ ያን ዳና። ፆሳይ ኤዶመ ቦላ ላለ ዋ ዎዶሮነ ባይሳተ ቱምበ የዳና። <verse eid="ISA 34:11"/><verse number="12" style="v" sid="ISA 34:12"/>ሄ ቢታ አይስያ ካዎይ ዴና፤ ሀላቃት ያፐ ክቻና። <verse eid="ISA 34:12"/><verse number="13" style="v" sid="ISA 34:13"/>ካዎ ኬታ አጉን፥ ሚፃታ ኦህ ማአና፤ ዎርካናት አላትያ በስነ ያንቾት ደእያ ሶ ግዳና። <verse eid="ISA 34:13"/><verse number="14" style="v" sid="ISA 34:14"/>ባዞ ዶአት ጎዳረታራ ጋሄታና፤ ቱና አያናት እሶይ እሱዋራ ፄገታና፤ ቃማ ቆለት ዎድ ያን ዳና። <verse eid="ISA 34:14"/><verse number="15" style="v" sid="ISA 34:15"/>ጉቶት ያን ኬ ኬፅድ፥ ጱጱልድ ቆፃና። ባንታ ናይታ ባንታ ቀፈታ ጋርሳን ሀጳና፤ ጵርጮት ባንታ ላገታራ ያን ሺቃና።<verse eid="ISA 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 34:16"/>ጎዳ ማፃፋን ኮይድ ናባብተ። ጎዳ ዶናይ ኦድዳ ግሾነ እያ አያናይ ሺሽዳ ግሾ፥ ሀይሳታፐ እሶይካ ፓጨና፤ ቃስ እሶይካ ባ ላገይ ባይና ዴና። <verse eid="ISA 34:16"/><verse number="17" style="v" sid="ISA 34:17"/>እ፥ ኤንታዉ ሳማ ከስስ፤ እያ ኩሸይ ቢታ ኤንታዉ ዎዶሮን ሻክስ፤ ኤንቲ እያ መርናዉ ላታና፤ የለተፈ የለተ ጋካናዉ ኤንቲ ያን ዳና።<verse eid="ISA 34:17"/></para>
  <chapter eid="ISA 34"/>
  <chapter number="35" style="c" sid="ISA 35"/>
  <para style="s1">ዎዘትዳ ደርያ ኡፋይሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 35:1"/>ባይሳ ቢታይነ መላ ቢታይ ኡፋይታና፤ አይኮይ ባይና መላ ቢታይ ኡፋይታናነ ጪያና። <verse eid="ISA 35:1"/><verse number="2" style="v" sid="ISA 35:2"/>መላ ቢታይ ጪሸ ማአና፤ ኡፋይሳ ማዝሙረ የፃና። ልባኖሰ ቦንቹዋ ማአና፤ ቃርመሎሳነ ሳሮና ግታተይ እመታና፤ ኤንቲ ጎዳ ቦንቹዋነ ኑ ፆሳ ግታተ በአና።<verse eid="ISA 35:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 35:3"/>ዳቡርዳ ኩሸታነ አርጋጭዳ ጉልባታታ ምንተ። <verse eid="ISA 35:3"/><verse number="4" style="v" sid="ISA 35:4"/>ያሻ ዎዛን ደኤይሳታኮ፥ “ምንተ! ያዮፍተ! ሄኮ፥ ህንተ ፆሳይ ሀሎ ከያናዉነ ባ ፆሳተን ኩሸ ዛራናዉ ይድ ህንተና አሻና” ያግተ።<verse eid="ISA 35:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 35:5"/>ሄ ዎደ፥ ቆቀታ አይፈይ ዶየታና፤ ቱለታ ሀይይ ስአና። <verse eid="ISA 35:5"/><verse number="6" style="v" sid="ISA 35:6"/>ዎበት ገንኤዳ ጉፓና፤ ደዶት ኡፋይሳን የፃና፤ መላ ቢታን ሃ ጎጋና፤ መላ በሳን ፑልቶይ ቃና። <verse eid="ISA 35:6"/><verse number="7" style="v" sid="ISA 35:7"/>ፁግያ ሻፈይ ኤለ ሃ ግዳና፤ መላ ቢታይ ሃ ፑልታና፤ ዎርካናት አላትያ በሳን ማትነ ማይረይነ ማቅ ዶላና።<verse eid="ISA 35:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 35:8"/>ያራ ዎጋ ኦገይ ከያና፤ እካ “ጌሻተ ኦገ” ጌተታና። ቱናት ሄ ኦግያራ ቦኮና፤ ኤያት ያን ስመረቶኮና፤ ሽን ጌሻታስ ግዳና። <verse eid="ISA 35:8"/><verse number="9" style="v" sid="ISA 35:9"/>ጋሞይ ዎይኮ ያሽያ ዶአት ያራ ካንኮና፤ ያን በንቶኮና፤ ሽን ዎዘትዳይሳታ ፃላል ሄመታና። <verse eid="ISA 35:9"/><verse number="10" style="v" sid="ISA 35:10"/>ጎዳይ ዎዝዳይሳት ስማና፤ የፅሽ፥ ፅዮነ ገላና፤ መርና ኡፋይሳይ ኤንታ ሁጵያን ኡታና። ኤንቲ ኡፋይታናነ ሀሹ ጋና፤ አዛኖይነ ኦለይ ኤንታፈ ሃካና።<verse eid="ISA 35:10"/></para>
  <chapter eid="ISA 35"/>
  <chapter number="36" style="c" sid="ISA 36"/>
  <para style="s1">ሳናክሬማ ማንደ</para>
  <para style="r">(<ref loc="2KI 18:13-27">2 ካዎ 18:13-27</ref>፤ <ref loc="2CH 32:1-19">2 ታር 32:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1"/>ህዝቅያስ ካዎትዳ ታማነ ኦይዳን ላይን፥ አሶረ ካዎይ ሳናክሬም ዩሾይ ግምበትዳ ይሁዳ ካታማታ ኦልድ ኦይክስ። <verse eid="ISA 36:1"/><verse number="2" style="v" sid="ISA 36:2"/>ሄሳፈ ጉየ፥ አሶረ ካዎይ ላክሶ ካታማፐ እስ ቶራ ሞጮና ዳሮ ኦላንቾታራ ካዋ ህዝቅያሳኮ የሩሳላመ የድስ። እ፥ ብድ ማኦ ሜጭያ ጋድያኮ ኤፍያ ኦግያፐ ቆሞ ባጋራ ደእያ ኤልዳ ሃይ ጎግያ ዋ ማታን ኤቅስ። <verse eid="ISA 36:2"/><verse number="3" style="v" sid="ISA 36:3"/>ካዎ ጋ አይስያ አልቃ ናአይ ኤልያቄም፥ ፃፈይ ሼብነ፥ ታርከ ፃፈይ፥ አሳፋ ናአይ፥ ዮኣስ እያኮ ካረ ከይዶሶና።<verse eid="ISA 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4"/>አሶረ ቶራ ሞጮናይ ኤንታኮ፥ “ህዝቅያሳስ ሀይሳዳ ያግድ ኦድተ፦ ‘ዎልቃማ አሶረ ካዎይ፥ ኔኮ ሀይሳዳ’ ያጌስ፦ ኔኒ ሀይሳ መላ ምናናዉ አይብን አማነታዲ? <verse eid="ISA 36:4"/><verse number="5" style="v" sid="ISA 36:5"/>ኔኒ ጮ ቃላን፥ ኦላ ኦለታናዉ ታዉ ጭንጫተነ ዎልቅ ደኤስ ያጋሳ። ሽን ኔኒ ኦናን አማነታዳ ታ ቦላ ሀይሳዳ ማካላይ? <verse eid="ISA 36:5"/><verse number="6" style="v" sid="ISA 36:6"/>ኔኒ ‘ግብፀ ካዎይ ታና ማዳና’ ጋዳ ቆፕዳባ ግድኮ መቅዳ ማይረ ፃምአ ጉፈትያ አሳ መላ። ፃምአይ መቅን ፕንጮይ ኩሽያ ጫደስነ ማዱንፅሴስ። ግብፀ ካዎይ ባናን አማነትያ አሳ ኡባስ ሄሳ መላ።<note caller="-" style="x"><char style="xo" closed="false">36:6 </char><char style="xt" closed="false"><ref loc="EZK 29:6-7">ህዝ 29:6-7</ref>.</char></note> <verse eid="ISA 36:6"/><verse number="7" style="v" sid="ISA 36:7"/>ሽን ኔኒ፥ ‘ኑኒ ጎዳን፥ ኑ ፆሳን፥ አማነቶስ’ ያግኮ፥ ህዝቅያስ ይሁዳነ የሩሳላመ አሳ፥ ‘ህንተ የሩሳላመን ደእያ ያርሾ በሳን ጎይናናዉ ኮሼስ’ ግድ፥ ፆሳ ጎይንያ ቃ በሳታነ ያርሾ በሳታ ድግዳይ እያ ግደኔ?<verse eid="ISA 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 36:8"/>“አነ ሀእ ሃያ! ታ ጎዳ አሶረ ካዉዋራ ጌዳረታ። ቶጋናዉ ዳንዳእያ አስ ነ ደምኮ፥ ናምኡ ሙኩሉ ፓራታ ታ ነዉ እማና። <verse eid="ISA 36:8"/><verse number="9" style="v" sid="ISA 36:9"/>ኔኒ፥ ‘ግብፀት ፓራ አሳታነ ፓራ ጋረታ ታዉ የዳና’ ጋዳ አማንኮ፥ ታ ጎዳ ቶራ ሞጮናታፐ እስ ላፋካ ዛራናዉ ዳንዳአካ። <verse eid="ISA 36:9"/><verse number="10" style="v" sid="ISA 36:10"/>ሄሳ ቦላካ፥ ታኒ ሀ ቢታ ይሳናዉ ቱማ ጎዳ ሸነይ ባይና ከያድና? ጎዳይ ባ ሁጰን ታና ‘ባዳ ሀ ቢታ ኦላዳ ይሳ’ ያግድ ኪትስ” ያግስ።<verse eid="ISA 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11"/>ሄሳፈ ጉየ ኤልያቄም፥ ሼብነ ዮኣስ አሶረ ሀላቃኮ፥ “ኑኒ ኤርያ አራምከ ዶናራ ኑስ ነ አይለታስ ኦዳፐ አትሽን፥ ግምበ ድርሳ ቦላ ደእያ አሳይ ስአና መላ እብራወ ዶናን ኦዶፓ” ያግዶሶና።<verse eid="ISA 36:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12"/>ሽን ሀላቃይ ዛሪድ፥ “ሀ ኪታ ታኒ ህንተዉነ ህንተ ጎዳ ፃላላስ ኦዳና መላ ታና ታ ጎዳይ ኪትቤና። ህንተራ እስፈ ባንታ ሽአ ማናዉነ ባንታ ሼሻ ኡያናዉ ደእያ፥ ሀ ግምበ ድርሳ ቦላ ደእያ አሳ ኡባስ ኦዳና መላ ኪትስ” ያግስ።<verse eid="ISA 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13"/>አሶረ ሀላቃይ ደንድ ኤቅድ፥ ባ ቃላ ቁ ኦድ፥ እብራወ ዶናን ሀይሳዳ ያግስ፦ “ዎልቃማ ግድዳ አሶረ ካዎይ ግያባ ስእተ! <verse eid="ISA 36:13"/><verse number="14" style="v" sid="ISA 36:14"/>ካዎይ ህንተኮ ሀይሳዳ ያጌስ፤ ‘ህዝቅያስ ህንተና ጭሞፎ’ እ ህንተና ታ ኩሸፐ አሻናዉ ዳንዳኤና። <verse eid="ISA 36:14"/><verse number="15" style="v" sid="ISA 36:15"/>ህዝቅያስ ህንተና፥ ‘ቱማ ጎዳይ ኑና አሻና፤ ሀ ካታማይካ አሶረ ካዋ ኩሸን ገለና’ ያግድ፥ ህንተ ጎዳን አማነታና መላ ኦፎ።<verse eid="ISA 36:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 36:16"/>“ህንተ ህዝቅያስ ኦድያባ ስኦፕተ። አሶረ ካዎይ ህንተና፥ ‘ታራ ስገትተ፤ ሃ ታኮ ዪተ። ሄሳ ህንተ ኦኮ፥ ህንተ ኡባይ ህንተ ዎይነፐነ ህንተ ባላሰፐ ማና፤ ህንተ ቦክዳ ኦላፈካ ሃ ኡያና። <verse eid="ISA 36:16"/><verse number="17" style="v" sid="ISA 36:17"/>ታኒ ያዳ፥ ህንተና ህንተ ቢታ ዳንያ ቢታ ኤካዳ ኤፋና። ሄ ቢታይ ካነ ዎይነይ ኩምዳ ቢታ’ ” ያግስ።<verse eid="ISA 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 36:18"/>“ህዝቅያስ፥ ‘ጎዳይ ህንተና አሻና’ ያግድ ጭሞናዳ ናገትተ። ሀራ ካዎተታ ፆሳታፐ ባ ቢታ አሶረ ካዋ ኩሸፐ አሽዳ ፆሲ ደእዬ? <verse eid="ISA 36:18"/><verse number="19" style="v" sid="ISA 36:19"/>ሀማታ ፆሳትነ አርፋዳ ፆሳት አዉን ደኦና? ሳፋርዋይማ ፆሳት አዉ ብዶና? ኤንቲ ሳማርያ ታ ኩሸፐ ዎ ኤክዶና? <verse eid="ISA 36:19"/><verse number="20" style="v" sid="ISA 36:20"/>ሀ ቢታታ ፆሳታፐ ባ ቢታ ታ ኩሸፐ አሽድ ኤክዳይ ደኢ? ያትን ህንተ፥ ‘ጎዳይ የሩሳላመ ታ ኩሸፐ አሻና’ ያግድ ቆፔቲ?” ያግስ።<verse eid="ISA 36:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21"/>ሽን ካዎይ ኤንታኮ፥ “እያዉ አይ ዛሮካ እሞፕተ” ያግድ ዞርዳ ግሾ፥ አሳይ እስ ቃላካ እያዉ ዛሮና ስእ ግዶሶና። <verse eid="ISA 36:21"/><verse number="22" style="v" sid="ISA 36:22"/>ሄሳፈ ጉየ ካዎ ጋ አይስያ ካልቀ ናአይ ኤልያቄም፥ ፃፈይ ሼብነ ታርከ ፃፈይ አሳፋ ናአይ ዮኣስ ባንታ ማኡዋ ፔዶሶና። ህዝቅያሳኮ ብድ አሶረ ሀላቃይ ግዳባ ኡባ እያዉ ኦድዶሶና።<verse eid="ISA 36:22"/></para>
  <chapter eid="ISA 36"/>
  <chapter number="37" style="c" sid="ISA 37"/>
  <para style="s1">ህዝቅያስ እሳያሳ ዞረ ኦይችስ</para>
  <para style="r">(<ref loc="2KI 19:1-7">2 ካዎ 19:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1"/>ካዎይ ህዝቅያስ ሄሳ ስእዳ ዎደ ባ ማኡዋ ፔድ፥ ካዮ ማኦ ማእድ፥ ጎዳ ኬ ገልስ። <verse eid="ISA 37:1"/><verse number="2" style="v" sid="ISA 37:2"/>ካዎ ጋ አይስያ ኤልያቄም፥ ፃፈይ ሼብነ ካለያ ካህነት ካዮ ማኦ ማእድ፥ አሞፀ ናኣ ናብያ እሳያሳኮ ባና መላ ኪትስ። <verse eid="ISA 37:2"/><verse number="3" style="v" sid="ISA 37:3"/>ኤንቲ እሳያሳኮ ብድ፥ ህዝቅያስ ሀይሳዳ ያጌስ፦ “ሀ ጋላሳይ መቶ ጋላስ፥ ሴራ ጋላስነ ዬላ ጋላስ። ሄስካ ናእ የለታናዉ ዎደይ ጋክን፥ ባናካዳ የላናዉ ዎልቅ ይዳ ማጫሳ መላ ግድዳ። <verse eid="ISA 37:3"/><verse number="4" style="v" sid="ISA 37:4"/>ደኦ ፆሳ ጫያናዳ እያ ጎዳይ፥ አሶረ ካዎይ፥ ኪትዳ ሀላቃ ቃላ ጎዳይ ነ ፆሳይ ስኦና አገና። ቃስ ጎዳይ ነ ፆሳይ ሄ ቃላ ጋሶን እያ ሴሮና አገና። ሄሳ ግሾ፥ አሳ ግዶፈ አታናይሳታስ ዎሳ” ያግዶሶና።<verse eid="ISA 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5"/>ካዎይ ህዝቅያስ ኪትዳይሳ እሳያስ ስእዳ ዎደ፥ <verse eid="ISA 37:5"/><verse number="6" style="v" sid="ISA 37:6"/>ኤንታኮ፥ “ህንተ ጎዳስ ሀይሳዳ ያግድ ኦድተ፦ ጎዳይ፥ ‘አሶረ ካዋ አይለት ታና ጫይሽን፥ ኔኒ ስእዳ ጫሻ ቃላስ ያዮፋ። <verse eid="ISA 37:6"/><verse number="7" style="v" sid="ISA 37:7"/>ሄኮ፥ እ ኦዳ ስእድ፥ ባ ቢታ ስማና መላ፥ ታኒ እያ ግዶን እስ አያና የዳና። ያታዳ እ ባ ቢታ ብድ ያን ማሻን ሀይቃናዳ ኦና’ ያጌስ” ያግድ ኪትስ።<verse eid="ISA 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8"/>አሶረ ካዎይ ላክሶ ካታማፐ ደንድድ ብዳይሳ አሶረ ሀላቃይ ስእድ፥ ጉየ ስሚድ ካዎይ ልብና ካታማን ኦለተይሳ ደምስ።<verse eid="ISA 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9"/>ካዎይ ሳናክሬም፥ “ቶጰ ካዎይ ትርሃቅ ነና ኦላናዉ ይስ” ግያ ኦዳ ስእድ፥ ህዝቅያሳስ ሀይሳዳ ያግድ ኪትስ። <verse eid="ISA 37:9"/><verse number="10" style="v" sid="ISA 37:10"/>“ይሁዳ ካዋ ህዝቅያሳ፥ ኔኒ አማነትያ ፆሳይ፥ ‘የሩሳላመ አሶረ ካዋ ኩሸን የገና’ ያግድ ጭሞፎ። <verse eid="ISA 37:10"/><verse number="11" style="v" sid="ISA 37:11"/>አሶረ ካዎት ቢታታ ኡባ ዋት ይስዳኮ ኔኒ ስአዳሳ። ያትን፥ ኔኒ አታኔ? <verse eid="ISA 37:11"/><verse number="12" style="v" sid="ISA 37:12"/>በን ታ ማይዛት ይስዳ ጎዛና፥ ካራነነ ራፌሳ ቢታ ፆሳትነ ታላሳራን ደእያ ኤደነ ቢታ ፆሳት ሄ ቢታታ ዮፐ አሽዶና? <verse eid="ISA 37:12"/><verse number="13" style="v" sid="ISA 37:13"/>ሀማታ ካዎይ፥ አርፋዳ ካዎይ፥ ሳፋርዋይማ ካዎይ፥ ሄና ካዎይነ እዋ ካዎይ አዉን ደኦና?” ያግድ ኪትስ።<verse eid="ISA 37:13"/></para>
  <para style="s1">ህዝቅያሳ ዎሳ</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14"/>ህዝቅያስ ዳብዳብያ ኪተትዳ አሳፐ ኤክድ ናባብስ። ዳብዳብያ ጎዳ ኬ ኤፍድ ጎዳ ስንን ምጭስ። <verse eid="ISA 37:14"/><verse number="15" style="v" sid="ISA 37:15"/>ጎዳ ሀይሳዳ ያግድ ዎስስ፦ <verse eid="ISA 37:15"/><verse number="16" style="v" sid="ISA 37:16"/>“አቤት ኡባፈ ዎልቃማ ጎዳዉ፥ ክሩበታፐ ግዱዋን ኡትዳ እስራኤለ ፆሳዉ፥ ሳአ ካዎተታ ኡባ ቦላ ነ ፃላል ፆሰ። ሳሉዋነ ሳኣ ኔኒ መዳሳ።<note caller="-" style="x"><char style="xo" closed="false">37:16 </char><char style="xt" closed="false"><ref loc="EXO 25:22">ከሳ 25:22</ref>.</char></note> <verse eid="ISA 37:16"/><verse number="17" style="v" sid="ISA 37:17"/>አቤት ጎዳዉ፥ ነ ሀይ የጋዳ ሃ ስአ። አቤት ጎዳዉ፥ ነ አይፍያ ዶያዳ ሃ ፄላ። ነና፥ ደኦ ፆሳ፥ ሳናክሬም ጫይዳ ጫሻ ስአ።<verse eid="ISA 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 37:18"/>“አቤት ጎዳዉ፥ አሶረ ካዎት ካዎተታነ ኤንታ ቢታ ይስዳይስ ኤ ቱማ። <verse eid="ISA 37:18"/><verse number="19" style="v" sid="ISA 37:19"/>ኤንታ ፆሳታ ታማን ፁግድ ይስዶሶና፤ ኤንታ ፆሳት ካሰካ አሳ ኩሸይ ማስድ ከስዳ ምነ ሹች ግድያ ግሾ፥ ፆሳታ ግዶኮና። <verse eid="ISA 37:19"/><verse number="20" style="v" sid="ISA 37:20"/>ህዛ አቤት ጎዳዉ፥ ኑ ፆሳዉ፥ ነ ፃላል ጎዳ ግደይሳ ሳኣ ካዎተት ኡባይ ኤራና መላ ኔኒ ኑና እያ ኩሸፐ አሻ” ያግድ ዎስስ።<verse eid="ISA 37:20"/></para>
  <para style="s1">ሳናክሬማ ኩንደ</para>
  <para style="r">(<ref loc="2KI 19:2-37">2 ካዎ 19:2-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21"/>ሄሳፈ ጉየ፥ አሞፀ ናአይ እሳያስ ህዝቅያሳስ ሀይሳዳ ያግድ ኪትስ፦ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ፦ “ኔኒ አሶረ ካዋ ሳናክሬማ ጋሶን ታና ዎስዳ ዎሳ ታኒ ስአስ” ያጌስ።<verse eid="ISA 37:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 37:22"/>“ጎዳይ ሳናክሬማ ሀይሳዳ ያግስ።</para>
  <para style="q2" vid="ISA 37:22">ፅዮነ ጌላእያ ነና ካሱ፤ ለቃሱ፤</para>
  <para style="q2" vid="ISA 37:22">የሩሳላመ ናእያ ባ ሁጵያ ቃዳ ነና ቦራሱ።<verse eid="ISA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 37:23"/>ኔኒ ጫይዳይነ ቶችዳይ ኦኔ?</para>
  <para style="q2" vid="ISA 37:23">ነ ኦደ ቦላ ነ ቃላ ቁ ኦዳ ኦደታዲ?</para>
  <para style="q1" vid="ISA 37:23">ነ ኦቶሮን ኦና ቁ ጋዳ ፄላዲ?</para>
  <para style="q2" vid="ISA 37:23">ሄሳ ነ ኦዳይ እስራኤለ ጌሻ ቦላና ግደኔ?<verse eid="ISA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 37:24"/>ኔኒ ኪትዳ አሳ ባጋራ ጎዳ ጫያዳሳ።</para>
  <para style="q2" vid="ISA 37:24">ሀይሳዳ ያጋዳሳ፦</para>
  <para style="q1" vid="ISA 37:24">‘ታ ዳሮ ፓራ ጋረታራ</para>
  <para style="q2" vid="ISA 37:24">ቃ ዙማ ሁጵያ፥</para>
  <para style="q2" vid="ISA 37:24">ልባኖሰ ዙማ ፄራ ከያስ።</para>
  <para style="q1" vid="ISA 37:24">ኡባፈ አዱሳ ዝጋታነ</para>
  <para style="q2" vid="ISA 37:24">ኡባፈ ሎኦ ፂዳታ ቃንፃስ።</para>
  <para style="q1" vid="ISA 37:24">ቃ በሳን ደእያ</para>
  <para style="q2" vid="ISA 37:24">ፅትዳ ዎራ ጋካስ።<verse eid="ISA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 37:25"/>ታኒ አላጋ ቢታታን</para>
  <para style="q2" vid="ISA 37:25">ሃ ኦላ ቦካዳ ሃ እያፐ ኡያስ።</para>
  <para style="q1" vid="ISA 37:25">ግብፀ ቢታን ጎግያ ሃ ኡባ</para>
  <para style="q2" vid="ISA 37:25">ታኒ ታ ቶሁዋን የዳ መልሳስ’ ”</para>
  <para style="m" vid="ISA 37:25">ያጋዳሳ።<verse eid="ISA 37:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 37:26"/>“ዳሮ ዎደፐ ስን</para>
  <para style="q2" vid="ISA 37:26">ኔኒ ግምበትዳ ካታማታ ላላዳ፥</para>
  <para style="q2" vid="ISA 37:26">ሹቻ ኬላ ከሳና መላ፥</para>
  <para style="q2" vid="ISA 37:26">ታ ቆፋ ቃቻ ዎዳይሳ ነ ኤራብኪ?</para>
  <para style="q1" vid="ISA 37:26">ታኒ ሀእ ኦያ ኦሶታ</para>
  <para style="q2" vid="ISA 37:26">በን ሀልቻ ዎስ።<verse eid="ISA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 37:27"/>ሄሳ ግሾ፥ ኤንታ አሳስ ዎልቃይ እፅን፥</para>
  <para style="q2" vid="ISA 37:27">ኤንቲ ካዉይዶሶናነ ዬላትዶሶና።</para>
  <para style="q1" vid="ISA 37:27">ኤንቲ ማታ መላነ</para>
  <para style="q2" vid="ISA 37:27">ዮጋ ጪሻ መላ።</para>
  <para style="q1" vid="ISA 37:27">ኤንቲ ኬ ሁጰን ዶልያ ማታ መላነ</para>
  <para style="q2" vid="ISA 37:27">ሌገይ ኩንድስያ ካ መላ ሀንዶሶና።<verse eid="ISA 37:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 37:28"/>“ሽን ኔኒ ኡትያ፥ ከይያ፥ ገልያ በሳነ</para>
  <para style="q2" vid="ISA 37:28">ታ ቦላ ነ ሀንቀትዳ ሀንቁዋ ኤራይስ።<verse eid="ISA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 37:29"/>ነ ታ ቦላ ሀንቀትዳ ግሾነ፥</para>
  <para style="q2" vid="ISA 37:29">ነ ኦቶሩዋ ታኒ ስእዳ ግሾ፥</para>
  <para style="q2" vid="ISA 37:29">ታኒ ነ ሲያን ዳፎ አና፤</para>
  <para style="q2" vid="ISA 37:29">ነ ዶናን ብፃላ ባርሳና።</para>
  <para style="q1" vid="ISA 37:29">ያታዳ ኔኒ ይዳ ኦግያራ</para>
  <para style="q2" vid="ISA 37:29">ነና ጉየ ዛራና።”<verse eid="ISA 37:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30"/>እሳያስ ካዋ ህዝቅያሳኮ ሀይሳዳ ያግስ። “ሄስ ፖለታናይሳስ ማላይ ሀይሳ፤ ሀ ላይነ ዎንቶ ላይ ህንተ አሰቦ ካፅዳ ካ ማና። ሽን ሄን ላይን ህንተ፥ ህንተ ሁጰን ዘርተነ ጫክተ፤ ዎይነ ቶክተነ እያ አይፍያ ሚተ። <verse eid="ISA 37:30"/><verse number="31" style="v" sid="ISA 37:31"/>ይሁዳ አሳፐ አትዳይሳት ፃጶ የዳና፤ አይፈ አይፋና። <verse eid="ISA 37:31"/><verse number="32" style="v" sid="ISA 37:32"/>አትዳ ጉት የሩሳላመፐነ ፅዮነ ደርያፐ ያና። ኡባፈ ዎልቃማ ጎዳ ቃናተይ ሄሳ ኦና።<verse eid="ISA 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33"/>“ሄሳ ግሾ፥ አሶረ ካዉዋባ ጎዳይ ሀይሳዳ ያጌስ። አሶረ ካዎይ ሀ ካታማ ገለና፤ ዎይኮ ሀይሳን ባ ዶንግያ ዱከና፤ ዎይኮ ባ ጎንዳልያ ኦይክድ፥ ሀ ካታማ ስን አና፤ ዎይኮ ካታማ ዩሹዋ ተቀና። <verse eid="ISA 37:33"/><verse number="34" style="v" sid="ISA 37:34"/>አሶረ ካዎይ ባ ይዳ ኦግያራ ጉየ ስማና፤ ሀ ካታማ ገለና።” ታኒ ጎዳይ ሀይሳ ኦዳይስ።<verse eid="ISA 37:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ISA 37:35"/>“ታኒ ታ ቦንቹዋ ግሾነ ታ አይልያ ዳዊታ ግሾ፥ ሀ ካታማ አሻና” ያግስ።<verse eid="ISA 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36"/>ሄ ቃማ ጎዳ ኪታንቾይ ከይድ፥ አሶረ አሳይ ዱንካንዳ ጉታ ብድ፥ 185,000 አደታ ዎስ። ዎንተ ጋላስ አሳይ ደንድድ አህ አሀ ቦላ ዶረትዳይሳ በእዶሶና። <verse eid="ISA 37:36"/><verse number="37" style="v" sid="ISA 37:37"/>ሄሳ ግሾ፥ አሶረ ካዎይ ሳናክሬማ ደንድድ፥ ጉየ ስም ብድ ናናወ ካታማን ኡትስ።<verse eid="ISA 37:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ISA 37:38"/>እስ ጋላስ ሳናክሬማ ባ ፆሳ ንስሮካ ኬን ጎይንሽን፥ እያ ናይት አድራመለክነ ሳርፃር ማሻን እያ ዎድ አራራተ ቢታ ባቃትዶሶና። እያ ናአይ አስራዶን እያ በሳን ካዎትስ።<verse eid="ISA 37:38"/></para>
  <chapter eid="ISA 37"/>
  <chapter number="38" style="c" sid="ISA 38"/>
  <para style="s1">ህዝቅያሳ ሀርግያ</para>
  <para style="r">(<ref loc="2KI 20:1-11">2 ካዎ 20:1-11</ref>፤ <ref loc="2CH 32:24-26">2 ታር 32:24-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1"/>ሄ ዎደ ካዎይ ህዝቅያስ ሀርግድ፥ ሀይቃናዉ ማትስ። አሞፀ ናአይ ናበይ እሳያስ እያኮ ብድ፥ ጎዳይ፥ “ነ ሀይቃና ሀንያ ግሾ ነ ኬ ጊግሳ” ያግስ።<verse eid="ISA 38:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2"/>ህዝቅያስ ጎዳኮ ስም ዝንእድ፥ ጎዳ ዎስስ። <verse eid="ISA 38:2"/><verse number="3" style="v" sid="ISA 38:3"/>“አቤት ጎዳዉ፥ ታኒ ነ ስንን ቱማተንነ ኩመ ዎዛናን ሄመትዳይሳነ ነና ኡፋይስያባ ኦዳይሳ ሀሳያ” ያግድ ጫመትድ ዬክስ።<verse eid="ISA 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4"/>ሄሳፈ ጉየ፥ ጎዳ ቃላይ እሳያሳኮ፥ <verse eid="ISA 38:4"/><verse number="5" style="v" sid="ISA 38:5"/>ባዳ ህዝቅያሳኮ፥ ጎዳይ ነ ማይዛ ዳዊታ ፆሳይ፥ “ታኒ ነ ዎሳ ስአስ፤ ነ አፉ በአስ። ነ ላይ ቦላ ታኒ ታማነ እቻሹ ላይ ጉጃና። <verse eid="ISA 38:5"/><verse number="6" style="v" sid="ISA 38:6"/>ነናነ ሀ ካታማ አሶረ ካዋ ኩሸፐ አሻና፤ ታኒ ሀ ካታማስ ኦለታና” ያጋ።<verse eid="ISA 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7"/>“ጎዳይ ባ ግዳ ቃላ ፖላናዉ እምዳ ማላይ ሀይሳ ያግስ፦ <verse eid="ISA 38:7"/><verse number="8" style="v" sid="ISA 38:8"/>አካዝ ከያናዉ ጊግስዳ ደን ደእያ ኩያይ ታሙ ታንጎ ጉየ ስሚድ ባና መላ ታኒ ኦና” ያግስ። ኩያይ ታሙ ታንጎ ጉየ ስሚድ ብስ።<verse eid="ISA 38:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9"/>ይሁዳ ካዎይ ህዝቅያስ ሀርግያፈ ፓፅድ ፃፍዳ ማዝሙረይ ሀይሳ፦<verse eid="ISA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 38:10"/>ታኒ፥ “ታ ደኦ ላይይ ባጋ ጋኮና ደእሽን፥</para>
  <para style="q2" vid="ISA 38:10">ሀይቆ ፐንገራ ገላና ሀንያና?</para>
  <para style="q2" vid="ISA 38:10">አትዳ ላይ ቦንቀታና ሀንያና?” ያጋስ።<verse eid="ISA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 38:11"/>“ታኒ ደኦን ደኤይሳታ ቢታን ጎዳ በእከ፤</para>
  <para style="q2" vid="ISA 38:11">ሀ ሳአን አሰ በእከ፤</para>
  <para style="q2" vid="ISA 38:11">ሀ አላምያን ደኤይሳታራ ዛራዳ ደእከ።<verse eid="ISA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 38:12"/>ዶርሰ ሄመይሳታ ዱንካንያዳ፥</para>
  <para style="q2" vid="ISA 38:12">ታ ደኦይ ሾደትስ።</para>
  <para style="q1" vid="ISA 38:12">ዶርዘይ አፍላ ዋንዳራሸን ፃፀይሳዳ፥</para>
  <para style="q2" vid="ISA 38:12">ታ ደኦይ ፃፀትስ።</para>
  <para style="q1" vid="ISA 38:12">ዶርዘይ አፍላ ዱያዳ፥</para>
  <para style="q2" vid="ISA 38:12">ታ ደኡዋ ዱስ።</para>
  <para style="q1" vid="ISA 38:12">ዎንታፈ ኦማርስ ጋካናዉ</para>
  <para style="q2" vid="ISA 38:12">ታና ይሳሳ” ያጋስ።<verse eid="ISA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 38:13"/>“ቃማ ኩመ ዳንዳአን ናጋስ፤</para>
  <para style="q2" vid="ISA 38:13">ጋሞዳ ታ መቀ ኡባ መንዳሳ፤</para>
  <para style="q2" vid="ISA 38:13">ዎንታፈ ኦማርስ ጋካናዉ ታና ይሳዳሳ።<verse eid="ISA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 38:14"/>ታኒ ካሮዳነ ጭላሾዳ ዋሳስ፤</para>
  <para style="q2" vid="ISA 38:14">ሆለዳ ዙዙማስ።</para>
  <para style="q1" vid="ISA 38:14">ታ አይፈይ ሳሎ ፄልሸ ዳቡርስ፤</para>
  <para style="q2" vid="ISA 38:14">ጎዳዉ፥ ታኒ ኡንኤታስ፤</para>
  <para style="q2" vid="ISA 38:14">ኔኒ ታና ሀ ኡንኣፈ ከሳ” ያጋስ።<verse eid="ISA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 38:15"/>ሀይሳ ኡባ ኦዳይ ጎዳ፤</para>
  <para style="q2" vid="ISA 38:15">ታኒ አይ ጋናዉ ዳንዳእያና?</para>
  <para style="q1" vid="ISA 38:15">ታ ሸምፖይ ኡንኤትዳ ግሾ፥</para>
  <para style="q2" vid="ISA 38:15">ታ ላይ ኡባ አሽከተን ዳና።<verse eid="ISA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 38:16"/>ጎዳዉ፥ ሀይሳ መላ ሴራን</para>
  <para style="q2" vid="ISA 38:16">አሳይ ደኦን ደኤስ።</para>
  <para style="q1" vid="ISA 38:16">ሀእ ታ ፓያተ ዛራዳ፥</para>
  <para style="q2" vid="ISA 38:16">ታና ደኦን ዎ!<verse eid="ISA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 38:17"/>ታ ኡንኤተይ ታዉ ሎኦ ግድስ፤</para>
  <para style="q2" vid="ISA 38:17">ኔኒ ታ ሸምፑዋ ዮ ኦላፈ አሻዳሳ፤</para>
  <para style="q2" vid="ISA 38:17">ታ ናጋራ ኡባ ኔኒ ጉየ የጋዳሳ።<verse eid="ISA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 38:18"/>ዱፎይ ነና ጋላተና፤</para>
  <para style="q2" vid="ISA 38:18">ሀይቆይ ነና ሳበና።</para>
  <para style="q1" vid="ISA 38:18">ኦላን ዎዳይሳት፥</para>
  <para style="q2" vid="ISA 38:18">ነ አማነተ ኡፋይስ ኦኮና።<verse eid="ISA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 38:19"/>ታኒ ሀች ነና ጋላተይሳዳ፥</para>
  <para style="q2" vid="ISA 38:19">ደኦን ደኤይሳት ነና ጋላቶሶና።</para>
  <para style="q1" vid="ISA 38:19">ነ አማነተ</para>
  <para style="q2" vid="ISA 38:19">አዋት ባንታ ናይታስ ኦዶሶና።<verse eid="ISA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 38:20"/>ጎዳይ ታና አሻና፤</para>
  <para style="q2" vid="ISA 38:20">ሄሳ ግሾ፥ ኑኒ ኑ ደኦ ላይ ኡባን፥</para>
  <para style="q2" vid="ISA 38:20">ጎዳ ኬን ዲን የፃና።<verse eid="ISA 38:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21"/>እሳያስ ካሰ፥ “ባላሰ ዳፅድ፥</para>
  <para style="q2" vid="ISA 38:21">እያ ክፃ ቦላ ዎተ፤</para>
  <para style="q2" vid="ISA 38:21">እ ፓፃና” ያግስ።<verse eid="ISA 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22"/>ህዝቅያስ ካሰ፥ “ታኒ ፓፃዳ ጎዳ ኬ ባናይሳስ ማላይ አይበ” ያግድ እሳያሳ ኦይችስ።<verse eid="ISA 38:22"/></para>
  <chapter eid="ISA 38"/>
  <chapter number="39" style="c" sid="ISA 39"/>
  <para style="s1">ባብሎነፐ ይዳ አሳታ</para>
  <para style="r">(<ref loc="2KI 20:12-19">2 ካዎ 20:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1"/>ሄ ዎደ፥ ባልዳና ናአይ፥ ባብሎነ ካዎይ ማርዶክ-ባልዳን፥ ህዝቅያስ ሀርግድ ፓፅዳይሳ ስእዳ ግሾ፥ ዳብዳበነ እሞታ ህዝቅያሳስ የድስ። <verse eid="ISA 39:1"/><verse number="2" style="v" sid="ISA 39:2"/>ህዝቅያስ ኪተትድ ይዳ አሳታ ሞክስ። ባ ሻሉዋ ምንጅያ ኬን ደእያ ብራ፥ ዎርቃ፥ ሳዉዋ፥ ሎኦ ዛይተ፥ ባ ኦላ ሚሸታነ ባ ሻሉዋ ምንጅያ ኬን ደእያባ ኡባ ኤንታ በስስ። ባ ሶን ዎይኮ ባ ጋዋን ደእያባ ኡባፈ ህዝቅያስ ኤንታ በሶና አግዳባይ ባዋ።<verse eid="ISA 39:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3"/>ናበይ እሳያስ ካዋ ህዝቅያሳኮ ብድ፥ “ሀ አሳት ዎይግዶና? አዉፐ ይዶና?” ያግድ ኦይችስ።</para>
  <para style="p" vid="ISA 39:3">ህዝቅያስ፥ “ኤንቲ ታኮ፥ ሃሆ ቢታ ባብሎነፐ ይዶሶና” ያግስ።<verse eid="ISA 39:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4"/>እሳያስ ዛሪድ፥ “ኤንቲ ነ ሶን አይ አይ በእዶና?” ያግድ ኦይችስ።</para>
  <para style="p" vid="ISA 39:4">ህዝቅያስ፥ “ኤንቲ ታ ጋን ደእያ ኡባባ በእዶሶና፤ ታ ሻሉዋ ምንጃ ኬን ደእያባፐ ታኒ ኤንታ በሶናባይ ባዋ” ያግስ።<verse eid="ISA 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5"/>ያትን፥ እሳያስ ህዝቅያሳኮ፥ “ኡባፈ ዎልቃማ ጎዳይ ግያባ ስአ። <verse eid="ISA 39:5"/><verse number="6" style="v" sid="ISA 39:6"/>‘ኔኒ፥ ካዎ ጋን ደእያባ ኡባይነ ነ ማይዛት ሀች ጋካናዉ ሺሽዳባ ኡባይ ኩም ድኤትድ፥ ባብሎነ ቢታ ባና ዎደይ ያና፤ አይብካ አተና። <verse eid="ISA 39:6"/><verse number="7" style="v" sid="ISA 39:7"/>ቃስ ኔፐ የለትዳ ነ አሾነ ነ ሱ ግድዳ ነ ኮቻት ድኤትድ ባና፤ ባብሎነን ካዎ ጋን ሹፋ ግድድ ኦና’ ያጌስ”<note caller="-" style="x"><char style="xo" closed="false">39:7 </char><char style="xt" closed="false"><ref loc="DAN 1:1-7">ዳነ 1:1-7</ref>፤ <ref loc="2KI 24:10-16">2 ካዎ 24:10-16</ref>፤ <ref loc="2CH 36:10">2 ታር 36:10</ref>.</char></note> ያግስ።<verse eid="ISA 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8"/>ህዝቅያስ ዛሪድ፥ “ኔኒ ኦድዳ ጎዳ ቃላይ ሎኦ። ሽን ታ ላይን ሳሮነ ዎፓ ግዶ” ያግድ ቆፕስ።<verse eid="ISA 39:8"/></para>
  <chapter eid="ISA 39"/>
  <chapter number="40" style="c" sid="ISA 40"/>
  <para style="s1">ምን ቃላ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 40:1"/>ህንተ ፆሳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q2" vid="ISA 40:1">“ታ ደርያ ምንተ! ምንተ!<verse eid="ISA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 40:2"/>እ አይለተን ደእዳ ዎደይ ፖለትስ፤</para>
  <para style="q2" vid="ISA 40:2">እያ ናጋራይ አቶ ጌተትስ፤</para>
  <para style="q2" vid="ISA 40:2">ባ ናጋራ ግሾ፥ ጎዳይ እያ ዳኮ ሴርዳይሳ፥</para>
  <para style="q2" vid="ISA 40:2">የሩሳላመስ ሊቆ ቃላን ኦድተ፤ አዋጅተ” ያጌስ።<verse eid="ISA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 40:3"/>ሀይሳዳ ግያ ግርሳይ ስኤቴስ፤</para>
  <para style="q2" vid="ISA 40:3">“መላ ቢታን ጎዳ ኦግያ ጊግስተ፤</para>
  <para style="q2" vid="ISA 40:3">ኑ ፆሳስ አራባ መላ ቢታን<note caller="+" style="f"><char style="fr" closed="false">40:3 </char><char style="ft" closed="false">አይኮይካ ባይና ማንቆ ቢታ ዎይኮ መላ ቢታ ዎይኮ ፁገትዳ ቢታ ጉሱ</char></note> ሆሮጋ ስት ኦተ።<note caller="-" style="x"><char style="xo" closed="false">40:3 </char><char style="xt" closed="false"><ref loc="MAT 3:3">ማቶ 3:3</ref>፤ <ref loc="MRK 1:3">ማር 1:3</ref>፤ <ref loc="JHN 1:23">ዮሀ 1:23</ref>.</char></note><verse eid="ISA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 40:4"/>ዛንጋራ ኡባይ ቁ ጋና፤</para>
  <para style="q2" vid="ISA 40:4">ደረይነ ዙማይ ዝቅ ጋና፤</para>
  <para style="q2" vid="ISA 40:4">ኢታ ኦገትነ ገላ ከሳት ደምባታና።<verse eid="ISA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 40:5"/>ሄ ዎደ ጎዳ ቦንቾይ ቆንጫና፤</para>
  <para style="q2" vid="ISA 40:5">አሾ ማእዳ ኡባይ ሄሳ እስፈ በአና።</para>
  <para style="q2" vid="ISA 40:5">ጎዳ ዶናይ ሀይሳ ኦድስ” ያጌስ።<verse eid="ISA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 40:6"/>እስ ግርስ፥ “ዋሳ” ያግሽን ስአስ፤</para>
  <para style="q2" vid="ISA 40:6">ታኒ፥ “ዎይጋዳ ዋሶ?” ያጋስ።</para>
  <para style="b" vid="ISA 40:6"/>
  <para style="q1" vid="ISA 40:6">“አስ ኡባይ ማታ መላ፤</para>
  <para style="q2" vid="ISA 40:6">እያ ቦንቾ ኡባይ ጪሻ መላ።<note caller="-" style="x"><char style="xo" closed="false">40:6 </char><char style="xt" closed="false"><ref loc="JAS 1:10-11">ያይ 1:10-11</ref>፤ <ref loc="1PE 1:24-25">1 ጰፅ 1:24-25</ref>.</char></note><verse eid="ISA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 40:7"/>ጎዳ እያ ቦላ ሸምፕያ ዎደ፥</para>
  <para style="q2" vid="ISA 40:7">ማታይ መሌስ፤ ጪሻይ ቆቆፈቴስ፤</para>
  <para style="q2" vid="ISA 40:7">አስ ቱማ ማታ መላ።<verse eid="ISA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 40:8"/>ማት መሌስ፤ ጪሽ ቆቆፈቴስ፤</para>
  <para style="q2" vid="ISA 40:8">ሽን ኑ ፆሳ ቃላይ</para>
  <para style="q2" vid="ISA 40:8">መርናዉ ኤቅድ ደኤስ” ያጋዳ ዋሳ።<verse eid="ISA 40:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 40:9"/>ነኖ ፅዮነስ ሎኦባ ኦደይሶ፤</para>
  <para style="q2" vid="ISA 40:9">ዙማ ቦላ ከያ።</para>
  <para style="q1" vid="ISA 40:9">ነኖ የሩሳላመስ ሎኦባ ኦደተይሶ፤</para>
  <para style="q2" vid="ISA 40:9">ነ ቃላ ቁ ኦዳ ዋሳ።</para>
  <para style="q1" vid="ISA 40:9">ያዮፋ፤ ቁ ኦ፤</para>
  <para style="q2" vid="ISA 40:9">ይሁዳ ካታማታስ፥ “ህንተ ፆሳይ ሀይስሽ” ያጋ።<verse eid="ISA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 40:10"/>ሄኮ፥ ኡባ ሃርያ ጎዳይ ዎልቃራ ዬስ፤</para>
  <para style="q2" vid="ISA 40:10">እያ ቀሰይ እያዉ ሃራና።</para>
  <para style="q1" vid="ISA 40:10">እያ ዎይቶይ እያራ ደኤስ፤</para>
  <para style="q2" vid="ISA 40:10">ጭግያ ጋተይ እያ ስንና።<verse eid="ISA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 40:11"/>እ ባ ዉድያ ሄንንቾዳ ሄማና፤<note caller="-" style="x"><char style="xo" closed="false">40:11 </char><char style="xt" closed="false"><ref loc="EZK 34:15">ህዝ 34:15</ref>፤ <ref loc="JHN 10:11">ዮሀ 10:11</ref>.</char></note></para>
  <para style="q2" vid="ISA 40:11">ባ ዶርሳ ማራታ ባ ቀስያን ሺሻና፤</para>
  <para style="q2" vid="ISA 40:11">ኤንታ ባ ክኦን እድማና፤</para>
  <para style="q2" vid="ISA 40:11">ንይሳታ ሎዳራ ካለና።<verse eid="ISA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 40:12"/>ሃታ ባ ኩሸ ቃቃን፥</para>
  <para style="q2" vid="ISA 40:12">ሳሎታ ታካን ልክዳይ፥</para>
  <para style="q2" vid="ISA 40:12">ቢታ ባና ዳቾን ማክዳይ፥</para>
  <para style="q2" vid="ISA 40:12">ደረታነ ዙማታ ምዛነን ልክዳይ ኦኔ?<verse eid="ISA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 40:13"/>ጎዳ አያና ኤርዳይ፥</para>
  <para style="q2" vid="ISA 40:13">እያ ዞርድ ታማርስዳይ ኦኔ?<note caller="-" style="x"><char style="xo" closed="false">40:13 </char><char style="xt" closed="false"><ref loc="ROM 11:34">ሮመ 11:34</ref>፤ <ref loc="2CO 2:16">2 ቆሮ 2:16</ref>.</char></note><verse eid="ISA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 40:14"/>እያዉ ቆንጭሳና መላ ኦና ዞረ ኦይችዴ?</para>
  <para style="q2" vid="ISA 40:14">ሱረ ፕርዳ እያ ታማርስዳይ ኦኔ?</para>
  <para style="q1" vid="ISA 40:14">እያ ጭንጫተ ታማርስዳይ፥</para>
  <para style="q2" vid="ISA 40:14">እያ አኬካ በስዳይ ኦኔ?<verse eid="ISA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 40:15"/>ሄኮ፥ ካዎተት ፁጋን ደእያ እስ ፆኮ መላ፤</para>
  <para style="q2" vid="ISA 40:15">ኤንቲ ምዛነ ቦላ ደእያ ባና መላ፤</para>
  <para style="q2" vid="ISA 40:15">እ ዩሾይ አባን ተቀትዳ ቢታታ ባናዳ ልከስ።<verse eid="ISA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 40:16"/>ልባኖሰ ምይ ያርሾ በሳን ኤፃናዉ ግደና፤</para>
  <para style="q2" vid="ISA 40:16">እያን ደእያ ዶአት ፁሳ ያርሾስ ግዶኮና።<verse eid="ISA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 40:17"/>ካዎተት ኡባይ እያ ስንን ባይናባ መላ፤</para>
  <para style="q2" vid="ISA 40:17">ኤንቲ እያ ስንን ኡባ አይኮካ ግዶኮና፤</para>
  <para style="q2" vid="ISA 40:17">ባይናባፐካ ላፋ።<verse eid="ISA 40:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 40:18"/>ያትን፥ ፆሳ ህንተ ኦደራ ግናየቲ?</para>
  <para style="q2" vid="ISA 40:18">አይባ ምስለራ ጋድ ፄለቲ?<verse eid="ISA 40:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 40:19"/>ኩሸ ሂላንቾይ ኤቃ ምስለ ጊግሴስ፤</para>
  <para style="q2" vid="ISA 40:19">ዎርቃ ሼሸይስ ዎርቃን ላንፄስ፤</para>
  <para style="q2" vid="ISA 40:19">ብራ ሼሸይስ እያ ቦላ</para>
  <para style="q2" vid="ISA 40:19">ብራ ሳንላታ መስ።<verse eid="ISA 40:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 40:20"/>ሚሸይ ባይና ማንቆይ፥</para>
  <para style="q2" vid="ISA 40:20">ያርሾስ ፆና ም ዶሬስ።</para>
  <para style="q1" vid="ISA 40:20">ምስለይ ቃፆና መላ ኤሳናዉ</para>
  <para style="q2" vid="ISA 40:20">ኩሸ ሂላንቾ ኮዬስ።<verse eid="ISA 40:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 40:21"/>ኤርቤከቲ? ዎይኮ ስእቤከቲ?</para>
  <para style="q2" vid="ISA 40:21">ሀይስ ህንተዉ ኮይሮፐ ኦደትቤኔ?</para>
  <para style="q1" vid="ISA 40:21">ዎይኮ ሳእ መቶሳፐ</para>
  <para style="q2" vid="ISA 40:21">ሀይሳ ህንተ አኬክበከቲ?<verse eid="ISA 40:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 40:22"/>እ ቢታ ገርቱዋፈ ቦላ ባጋን</para>
  <para style="q2" vid="ISA 40:22">ባ አራታን ኡቴስ፤</para>
  <para style="q2" vid="ISA 40:22">ቢታን ደእያ አሳት ፃቆ መላ።</para>
  <para style="q1" vid="ISA 40:22">ሳሎታ ገሸዳ ምጬስ፤</para>
  <para style="q2" vid="ISA 40:22">ዱንካነዳ ደእያ በሲ ኦድ ቶሌስ።<verse eid="ISA 40:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 40:23"/>እ፥ ሀላቃታ ባይናባዳ ኦስ፤</para>
  <para style="q2" vid="ISA 40:23">ሀ አላምያ ሃረይሳታ ሀዳ ከሴስ።<verse eid="ISA 40:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 40:24"/>ኤንቲ ቶከትድ ቡሮ ጋምኦናሽን፥</para>
  <para style="q2" vid="ISA 40:24">ዘረትድ ቡሮ ፃጶ የዶናሽን፥</para>
  <para style="q1" vid="ISA 40:24">ጎዳይ ኤንታ ቦላ ጫርኮ የድስ፤</para>
  <para style="q2" vid="ISA 40:24">ኤንቲ መልን ጎተይ ኤንታ ፑኖዳ ኤፍስ።<verse eid="ISA 40:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 40:25"/>ያትን፥ ታና ኦደራ ልከየቲ?</para>
  <para style="q2" vid="ISA 40:25">ታና ኦደራ ግናየቲ? ያጌስ ጌሻይ።<verse eid="ISA 40:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 40:26"/>ህንተ አይፍያ ቁ ኦድ ሳሎ ፄልተ፤</para>
  <para style="q2" vid="ISA 40:26">ሀ ፆልንቶታ መዳይ ኦኔ?</para>
  <para style="q1" vid="ISA 40:26">እ ኤንታ ኦላንቾዳ ካለስ፤</para>
  <para style="q2" vid="ISA 40:26">ኤንታ ታይቡዋ ኤሬስ።</para>
  <para style="q1" vid="ISA 40:26">እ ኤንታ ኡባ ኤንታ ሱንን ሱንን ፄጌስ፤</para>
  <para style="q2" vid="ISA 40:26">እያ ዎልቃ ግታተፈነ ምኖተፈ ደንዶይሳን፥</para>
  <para style="q2" vid="ISA 40:26">ኤንታፈ እሶይካ የና።<verse eid="ISA 40:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 40:27"/>ነኖ ያይቆባ፥ ነኖ እስራኤለ፥</para>
  <para style="q2" vid="ISA 40:27">ታ ኦገይ ጎዳፐ ጌምስ፤</para>
  <para style="q2" vid="ISA 40:27">ታ ፕርዳይ ፆሳፈ ቆሰትስ፤</para>
  <para style="m" vid="ISA 40:27">ያጋዳ አይስ ኦደታይ?<verse eid="ISA 40:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 40:28"/>ኤራብኪ? ስአብኪ?</para>
  <para style="q2" vid="ISA 40:28">ጎዳይ መርና ፆሳ፤</para>
  <para style="q2" vid="ISA 40:28">ቢታ ኡባ መዳይ እያ።</para>
  <para style="q1" vid="ISA 40:28">እ ዳቡረና፤ ዎይኮ አርጋጨና፤</para>
  <para style="q2" vid="ISA 40:28">ኦንካ እያ ቆፋ ኤራናዉ ዳንዳኤና።<verse eid="ISA 40:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 40:29"/>እ ዳቡርዳይሳታስ ዎልቃ እሜስ፤</para>
  <para style="q2" vid="ISA 40:29">ምኖተ ባይናይሳስ ምኖተ ጉጄስ።<verse eid="ISA 40:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 40:30"/>ሀር አቶሽን ያላጋ ናይት</para>
  <para style="q2" vid="ISA 40:30">ዳቡሮሶና፤ አርጋጮሶና፤</para>
  <para style="q2" vid="ISA 40:30">ናአተት ዳቡርድ ኩንዶሶና።<verse eid="ISA 40:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 40:31"/>ሽን ጎዳ አማነትድ ናገይሳት፥</para>
  <para style="q2" vid="ISA 40:31">ባንታ ዎልቃ ኦራና።</para>
  <para style="q1" vid="ISA 40:31">ኤንቲ አርጋንዳ ቀፈን ፓላና፤</para>
  <para style="q2" vid="ISA 40:31">ዎፃና፥ ሽን ዳቡሮኮና፤</para>
  <para style="q2" vid="ISA 40:31">ሄመታና፥ ሽን አርጋጮኮና።<verse eid="ISA 40:31"/></para>
  <chapter eid="ISA 40"/>
  <chapter number="41" style="c" sid="ISA 41"/>
  <para style="s1">እስራኤለ ማዱዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 41:1"/>ህንተኖ፥ ዩሾይ አባን ተቀትዳ ቢታቶ፥</para>
  <para style="q2" vid="ISA 41:1">ስእ ግድ፥ ታኒ ኦደይሳ ስእተ!</para>
  <para style="q1" vid="ISA 41:1">ደረይ ባንታ ዎልቃ ኦራ፤</para>
  <para style="q2" vid="ISA 41:1">ኤንቲ ሃ ሺቅድ፥ ኦደቶ፤</para>
  <para style="q2" vid="ISA 41:1">አነ ኑኒ ፕርደታናዉ እስፈ ሺቆስ።<verse eid="ISA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 41:2"/>“ዶሎሀ ባጋፈ እሱዋ ደንድ ብያ በሳ ኡባን ፆኖ እመይ ኦኔ?</para>
  <para style="q2" vid="ISA 41:2">እ ካዎተታ እያ ኩሸን አድ እሜስ፤</para>
  <para style="q2" vid="ISA 41:2">ካዎታ እያዉ ሃርስስ።</para>
  <para style="q1" vid="ISA 41:2">እ ኤንታ ባ ማሻን ብዶ ከሴስ፤</para>
  <para style="q2" vid="ISA 41:2">ባ ዶንግያን ኤንታ ፑኖ ኦስ።<verse eid="ISA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 41:3"/>እ ኤንታ የደሸ፥ እያ ቶሆይ ካሰ የቦና</para>
  <para style="q2" vid="ISA 41:3">ኦግያራ ሳሮ ካንስ።<verse eid="ISA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 41:4"/>ሀይሳ ኦዳይነ ፖልዳይ</para>
  <para style="q2" vid="ISA 41:4">የለተካ ኮይሮፐ ፄግዳይ ኦኔ?</para>
  <para style="q1" vid="ISA 41:4">ታኒ ጎዳይ፥ ኮይሩዋራ ደአይስ</para>
  <para style="q2" vid="ISA 41:4">ዉርሰራካ ደኤይ ታና” ያጌስ።<verse eid="ISA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 41:5"/>ዩሾይ አባን ተቀትዳ ቢታት፥</para>
  <para style="q2" vid="ISA 41:5">ሄሳ በእድ ያይዶሶና፤</para>
  <para style="q2" vid="ISA 41:5">ሳኣ ጋፃን ደኤይሳት ኮኮርዶሶና።</para>
  <para style="q1" vid="ISA 41:5">ኤንቲ እስፈ ሺቅድ ታኮ ይዶሶና።<verse eid="ISA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 41:6"/>እሶይ እሱዋ ማዴስ፤</para>
  <para style="q2" vid="ISA 41:6">ባ እሻ፥ “ምና” ያጌስ።<verse eid="ISA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 41:7"/>ኩሸ ሂላንቾይ ዎርቃ ሼሸይሳ ምንስ፤</para>
  <para style="q2" vid="ISA 41:7">ናርቃን ቆፅድ ሌእሰይስ</para>
  <para style="q2" vid="ISA 41:7">ባቻን ብራታ ሴርሰይሳ፥ “ምና” ጌስ።</para>
  <para style="q1" vid="ISA 41:7">እ ብራታ ንይሳ፥ “ሎኦ ኦሳ” ያጌስ፤</para>
  <para style="q2" vid="ISA 41:7">ኤቃይ ቃፆና መላ ምስማረን ሼስ።<verse eid="ISA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 41:8"/>“ሽን ነኖ እስራኤለ፥ ታ አይልያዉ፥</para>
  <para style="q2" vid="ISA 41:8">ታ ዶርዳ ያይቆባ፥</para>
  <para style="q2" vid="ISA 41:8">ታ ላግያ አብራሃመ ኮቻዉ፥<note caller="-" style="x"><char style="xo" closed="false">41:8 </char><char style="xt" closed="false"><ref loc="2CH 20:7">2 ታር 20:7</ref>፤ <ref loc="JAS 2:23">ያይ 2:23</ref>.</char></note><verse eid="ISA 41:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="ISA 41:9"/>ታኒ ነና ቢታ ጋፃፐ ኤሀስ፤</para>
  <para style="q2" vid="ISA 41:9">ሃሆሶፐ ፄጋዳ፥ ‘ኔኒ ታ አይለ’</para>
  <para style="q2" vid="ISA 41:9">ታኒ ነና ዶራስ፤ ታኒ ነና የግከ።<verse eid="ISA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 41:10"/>ያዮፋ፥ ታኒ ኔራ ደአይስ፤</para>
  <para style="q2" vid="ISA 41:10">ዳጋሞፋ፥ ታኒ ነ ፆሳ።</para>
  <para style="q1" vid="ISA 41:10">ታኒ ነና ምንና፤ ነና ማዳና፤</para>
  <para style="q2" vid="ISA 41:10">ታኒ ነና ፆንያ ታ ኡሻቻ ኩሽያን ካትሳና።<verse eid="ISA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 41:11"/>ነ ቦላ ሀንቀትያ ኡባይ ዬላትድ ካዉያና፤</para>
  <para style="q2" vid="ISA 41:11">ኔራ ኤቀተይሳት ባይናባ ግዳና።<verse eid="ISA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 41:12"/>ነ ሞርከታ ኔኒ ኮያና፤</para>
  <para style="q2" vid="ISA 41:12">ሽን ኤንታ ደማካ፤</para>
  <para style="q2" vid="ISA 41:12">ነና ኦለይሳት ባይናባ ግዳና።<verse eid="ISA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 41:13"/>ታኒ ጎዳይ፥ ነ ፆሳይ፥</para>
  <para style="q2" vid="ISA 41:13">ነ ኡሻቻ ኩሽያ ኦይካና፤</para>
  <para style="q2" vid="ISA 41:13">ያዮፋ፥ ታኒ ነና ማዳና።<verse eid="ISA 41:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 41:14"/>ነኖ ጉፁንያዉ፥ ያይቆባ፥ ህንተኖ እስራኤለ አሳዉ፥</para>
  <para style="q2" vid="ISA 41:14">ያዮፍተ፤ ታኒ ህንተና ማዳና፤</para>
  <para style="q2" vid="ISA 41:14">ህንተና ዎዝያ እስራኤለ ጌሻይ ታና።<verse eid="ISA 41:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 41:15"/>ሄኮ፥ ታኒ ነና ኦራ፥</para>
  <para style="q2" vid="ISA 41:15">ቃራነ አቻራ ደእያ፥</para>
  <para style="q2" vid="ISA 41:15">ካ ቆፅያ ሚሸ ኦስ።</para>
  <para style="q1" vid="ISA 41:15">ኔኒ ደረታ ቆፃዳ ሊቅሳና፤</para>
  <para style="q2" vid="ISA 41:15">ዙማታካ ፑኖ ኦና።<verse eid="ISA 41:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 41:16"/>ኔኒ ኤንታ ፑናና፤ ጫርኮይ ኤንታ ኤፋና፤</para>
  <para style="q2" vid="ISA 41:16">ሽን ኔኒ ጎዳን ኡፋይታና፤</para>
  <para style="q2" vid="ISA 41:16">እስራኤለ ጌሻን ቦንቸታና።”<verse eid="ISA 41:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 41:17"/>“ማንቆትነ መቶታንቾት ሃ ኮያና፥</para>
  <para style="q2" vid="ISA 41:17">ሽን ደሞኮና፤ ኤንታ ቆይ ሳሞን መላና።</para>
  <para style="q1" vid="ISA 41:17">ግዶሽን፥ ታኒ ጎዳይ ኤንታ ስአና፤</para>
  <para style="q2" vid="ISA 41:17">ታኒ፥ እስራኤለ ፆሳይ፥ ኤንታ አግከ።<verse eid="ISA 41:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 41:18"/>ታኒ መላ ዙማታ ቦላ ሻፋ፥</para>
  <para style="q2" vid="ISA 41:18">ዛንጋራታን ፑልቶ ሳና።</para>
  <para style="q1" vid="ISA 41:18">ባዙዋ ሃ ኤልያ በሲ፥</para>
  <para style="q2" vid="ISA 41:18">መላ ቢታ ፑልቶይ ከያሶ ኦና።<verse eid="ISA 41:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 41:19"/>ታኒ መላ ቢታን፥ ዝጋ፥ ሶቃላ ም፥</para>
  <para style="q2" vid="ISA 41:19">ባርሰኔተ ምነ ሻማሆ ዶልሳና።</para>
  <para style="q1" vid="ISA 41:19">መላ ቢታ ፂድ፥ ማሮይነ</para>
  <para style="q2" vid="ISA 41:19">ጫጭ ኩምዳ ቢታ ኦና።<verse eid="ISA 41:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 41:20"/>እስራኤለ ጌሻይ ሄሳ መዳይሳነ</para>
  <para style="q2" vid="ISA 41:20">ጎዳ ኩሸይ ሄሳ ኦዳይሳ</para>
  <para style="q2" vid="ISA 41:20">አሳይ በአና፥ ኤራና፥ ቆፓናነ</para>
  <para style="q2" vid="ISA 41:20">አኬካና መላ ታኒ ሄሳ ኦስ።”<verse eid="ISA 41:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 41:21"/>“አነ ህንተ ሞቱዋ ሺሽተ” ያጌስ ጎዳይ፤</para>
  <para style="q2" vid="ISA 41:21">“አነ ህንተ ማርካ ሃ ኤህተ” ያጌስ ያይቆባ ካዎይ።<verse eid="ISA 41:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 41:22"/>አነ ኤንቲ ባንታ ኤቃታ ሃ ኤሆ፥</para>
  <para style="q2" vid="ISA 41:22">አይብ ሀናኔኮ ኤንታ ኤቃት ኑስ ኦዶ።</para>
  <para style="q1" vid="ISA 41:22">ኑኒ አኬካና መላነ ኤንታ ዉርሰ ኤራና መላ</para>
  <para style="q2" vid="ISA 41:22">ካሰ ሀንዳባይ አይበኮ ኑስ ኦዶ፤</para>
  <para style="q2" vid="ISA 41:22">ዎይኮ ስንፈ ሀናናባ ኑስ ቆንጭሶ።<verse eid="ISA 41:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 41:23"/>ህንተ ፆሳታ ግደይሳ ኑኒ ኤራና መላ</para>
  <para style="q2" vid="ISA 41:23">ስንፈ ያናዉ ደእያባ ኑስ ኦድተ።</para>
  <para style="q1" vid="ISA 41:23">ኑኒ ዳጋማና መላነ ያያና መላ፥</para>
  <para style="q2" vid="ISA 41:23">ሎኦ ግድን ኢታ ግድን አነ እስባ ኦተ።<verse eid="ISA 41:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 41:24"/>ሽን ህንተ ባይናባ መላ፤</para>
  <para style="q2" vid="ISA 41:24">ህንተ ኦሶይካ ሀዳ፤</para>
  <para style="q2" vid="ISA 41:24">ህንተና ዶርያ አሳይካ እፀትዳይሳታ።<verse eid="ISA 41:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 41:25"/>ታኒ ፑደሀ ባጋፈ እሱዋ ደንን፥</para>
  <para style="q2" vid="ISA 41:25">እ ዬስ።</para>
  <para style="q1" vid="ISA 41:25">ታ ሱን ፄግያ እሶይ ዶሎሀፐ ያና፤</para>
  <para style="q2" vid="ISA 41:25">ኦቶ መይስ ኡርቃ የይሳዳ፥</para>
  <para style="q2" vid="ISA 41:25">እ ካለይሳታ የና።<verse eid="ISA 41:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 41:26"/>ኑኒ ኤራና መላነ እ ልከ ጋና መላ</para>
  <para style="q2" vid="ISA 41:26">ካሰትድ ኑስ ሀይሳ ኦድዳይ ኦኔ?</para>
  <para style="q1" vid="ISA 41:26">ህንተፈ ኦንካ ካሰትድ ሀይሳ ቆንጭስዳይ፥</para>
  <para style="q2" vid="ISA 41:26">ዎይኮ አዋጅዳይ ዎይኮ ባ ቃላ ስስዳይ ባዋ።<verse eid="ISA 41:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 41:27"/>ታኒ ሀይሳ ካሰታዳ ፅዮነስ ኦዳስ፤</para>
  <para style="q2" vid="ISA 41:27">ታኒ የሩሳላመስ ምሽራቾ ኦደይሳ እማስ።<verse eid="ISA 41:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 41:28"/>ሽን ታኒ ፄልያ ዎደ እሶይካ ባዋ፤</para>
  <para style="q2" vid="ISA 41:28">ታኒ ዞረ ኦይችያ ዎደ ኤንታ ኤቃታ ግዶፈ</para>
  <para style="q2" vid="ISA 41:28">ዛሮ እምያ እሶይካ ባዋ።<verse eid="ISA 41:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 41:29"/>ሄኮ፥ ኤንቲ ኡባይ ሀዳ፤ ኤንታ ኦሶይካ ፓና፤</para>
  <para style="q2" vid="ISA 41:29">ሼሽድ መዳ ኤንታ ምስለትካ ጫርኮ።<verse eid="ISA 41:29"/></para>
  <chapter eid="ISA 41"/>
  <chapter number="42" style="c" sid="ISA 42"/>
  <para style="s1">ፆሳ አይለ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 42:1"/>“ታኒ ካትሳዳ ኦይክዳ ታ አይለይ፥</para>
  <para style="q2" vid="ISA 42:1">ታ እያን ኡፋይተይስ፥</para>
  <para style="q2" vid="ISA 42:1">ታኒ ዶርዳይስ ሀይሳ።</para>
  <para style="q1" vid="ISA 42:1">ታኒ ታ አያና እያ ቦላ ዎስ፤</para>
  <para style="q2" vid="ISA 42:1">እ ካዎተታስ ሱረ ፕርዳ ኤሀና።<note caller="-" style="x"><char style="xo" closed="false">42:1 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቶ 3:17</ref>፤ <ref loc="MAT 17:5">17:5</ref>፤ <ref loc="MRK 1:11">ማር 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃ 3:22</ref>፤ <ref loc="LUK 9:35">9:35</ref>.</char></note><verse eid="ISA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 42:2"/>እ ዋሰና፤</para>
  <para style="q2" vid="ISA 42:2">ባ ቃላ ቁ ኦና</para>
  <para style="q2" vid="ISA 42:2">ባ ቃላ ኦገን ስሰና።<verse eid="ISA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 42:3"/>ድንጨትዳ ማይርያ እ መንና፤</para>
  <para style="q2" vid="ISA 42:3">ሊእ ሊእድ ኤፅያ ሙቃዳ እ ቶይሰና፤</para>
  <para style="q2" vid="ISA 42:3">አማነተን እ ሱረ ፕርዳ ኤሀና።<verse eid="ISA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 42:4"/>እ ቢታን ሱረ ፕርዳ ኤሰና ጋካናዉ</para>
  <para style="q2" vid="ISA 42:4">አርጋጨና ዎይኮ ጉየ ጌና።</para>
  <para style="q1" vid="ISA 42:4">ዩሾይ አባን ተቀትዳ ቢታን ደእያ አሳይ</para>
  <para style="q2" vid="ISA 42:4">እያ ህግያ ስአናዉ ናጌስ።<verse eid="ISA 42:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 42:5"/>ሳሎታ መዳይነ ኤንታ ምጭዳይ፥</para>
  <para style="q2" vid="ISA 42:5">ሳኣነ ሳአ ቦላ ደእያባ መዳይ፥</para>
  <para style="q2" vid="ISA 42:5">ሳአን ደእያ አሳስ ሸምፖ እምዳይ፥</para>
  <para style="q2" vid="ISA 42:5">እያን ሄመትያ ኡባስ ደኦ እምዳይ፥</para>
  <para style="q1" vid="ISA 42:5">ጎዳ ፆሳይ ሀይሳዳ ያጌስ።<verse eid="ISA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 42:6"/>ታኒ ጎዳይ ነና ፅሎተን ፄጋስ፤</para>
  <para style="q2" vid="ISA 42:6">ነ ኩሽያ ኦይካዳ ነና ናጋና።</para>
  <para style="q1" vid="ISA 42:6">ታኒ ነና አሳስ ጫቆ ኦና፤</para>
  <para style="q2" vid="ISA 42:6">ካዎተታስ ፖኦ ኦዳ እማና።<note caller="-" style="x"><char style="xo" closed="false">42:6 </char><char style="xt" closed="false"><ref loc="ISA 49:6">እሳ 49:6</ref>፤ <ref loc="LUK 2:32">ሉቃ 2:32</ref>፤ <ref loc="ACT 13:47">ሀዋ 13:47</ref>፤ <ref loc="ACT 26:23">26:23</ref>.</char></note><verse eid="ISA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 42:7"/>ኔኒ ቆቀ አይፈታ ዶያና፤</para>
  <para style="q2" vid="ISA 42:7">ማ ኦላን፥ ቃሾ ኬን ደኤይሳታ ከሳና።<verse eid="ISA 42:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 42:8"/>ታኒ ጎዳ፤ ሄስ ታ ሱን፤</para>
  <para style="q2" vid="ISA 42:8">ታ ቦንቹዋ ታኒ ሀራስ እምከ፤</para>
  <para style="q2" vid="ISA 42:8">ታ ጋላታ ኤቃታስ እምከ።<verse eid="ISA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 42:9"/>ሄኮ ታኒ ካሰ ኦድዳባ ኡባይ ፖለትዶሶና፤</para>
  <para style="q2" vid="ISA 42:9">ሀእ ታኒ ኦራባ አዋጃይስ፤</para>
  <para style="q2" vid="ISA 42:9">ኤንቲ ሀናናፐ ስን ታኒ ህንተዉ ኦዳይስ” ያጌስ።<verse eid="ISA 42:9"/></para>
  <para style="s1">ፆሳይ ጋላተቶ</para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10"/>ጎዳስ ኦራ ማዝሙረ የፅተ፤</para>
  <para style="q2" vid="ISA 42:10">ቢታ ጋፃፐ ጋፃ ጋካናዉ እያ ጋላታ የፅተ።</para>
  <para style="q1" vid="ISA 42:10">አባ ግዶራ በይሳትነ እያን ደኤይሳት፥</para>
  <para style="q2" vid="ISA 42:10">ዩሾይ አባን ተቀትዳ ቢታትነ እያን ደእያ ኡባይ የፆ።<verse eid="ISA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11"/>መላ ቢታን ደእያ ካታማት፥</para>
  <para style="q2" vid="ISA 42:11">ቀዳረ አሳይ ደእያ ጉታት</para>
  <para style="q2" vid="ISA 42:11">ባንታ ቃላ ቁ ኦና።</para>
  <para style="q1" vid="ISA 42:11">ሰላአ ካታማን ደኤይሳት ኡፋይሳን የፆ፤</para>
  <para style="q2" vid="ISA 42:11">ደርያ ሁጰን ባንታ እልልሳ ስሶ።<verse eid="ISA 42:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12"/>ኤንቲ ቦንቾ ጎዳስ እሞ፤</para>
  <para style="q2" vid="ISA 42:12">እያ ጋላታ ዩሾይ አባን ተቀትዳ ቢታታን ኦዶ።<verse eid="ISA 42:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13"/>ጎዳይ ምኖ አሳዳ ከያና፤</para>
  <para style="q2" vid="ISA 42:13">ባ ቃላ ቁ ኦድ ኦላ አዋጃና።</para>
  <para style="q1" vid="ISA 42:13">ባ ቃላ ቁ ኦድ ገሬራና፤</para>
  <para style="q2" vid="ISA 42:13">ባ ሞርከታ ፆናና።<verse eid="ISA 42:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14"/>ዳሮ ዎደ ስእ ጋዳ ጋምአስ፤</para>
  <para style="q2" vid="ISA 42:14">ስእ ጋዳ ዳንዳአስ።</para>
  <para style="q1" vid="ISA 42:14">ሽን ሀእ እቀ ኦይክዳ ማጫሳዳ ታ ዋሳና፤</para>
  <para style="q2" vid="ISA 42:14">ቶካ ሸምፓናነ ፔኑቃና።<verse eid="ISA 42:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15"/>ደረታነ ዙማታ ላላና፤</para>
  <para style="q2" vid="ISA 42:15">ኤንታ ቦላ ዶልዳባ ኡባ መልሳና።</para>
  <para style="q1" vid="ISA 42:15">ሻፋታ ዩሾይ አባን ተቀትዳ ቢታ ከሳና፤</para>
  <para style="q2" vid="ISA 42:15">ኤለ ሃታ መልሳና።<verse eid="ISA 42:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16"/>ታኒ ቆቀታ ኤንቲ ኤሮና ኦግያራ ካለና፤</para>
  <para style="q2" vid="ISA 42:16">ኤንቲ ኤሮና ሆሮጋራ ኤፋና።</para>
  <para style="q1" vid="ISA 42:16">ኤንታ ስንን ማ ፖኦ ከሳና፤</para>
  <para style="q2" vid="ISA 42:16">ኤንታ ስንን ደእያ ኦግያ ባሳና።</para>
  <para style="q1" vid="ISA 42:16">ሀ ኡባ ታኒ ኤንታዉ ኦና፤</para>
  <para style="q2" vid="ISA 42:16">ታኒ ኤንታ ኦና አግከ።<verse eid="ISA 42:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17"/>“ሽን ኤቃ ምስለታን አማነተይሳት፥</para>
  <para style="q2" vid="ISA 42:17">ምስለታ፥ ‘ህንተ ኑ ፆሳታ’ ያገይሳት፥</para>
  <para style="q2" vid="ISA 42:17">ዬላን ጉየ ስማና።<verse eid="ISA 42:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 42:18"/>ህንተ ቱለት፥ ስእተ፤</para>
  <para style="q2" vid="ISA 42:18">ህንተ ቆቀት፥ ፄልተ፥</para>
  <para style="q2" vid="ISA 42:18">ሎይድ በእተ።<verse eid="ISA 42:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 42:19"/>ታ አይልያፈ ሀር ቆቀይ ኦኔ?</para>
  <para style="q2" vid="ISA 42:19">ታ ኪትዳይሳፈ ሀር ቱለይ ኦኔ?</para>
  <para style="q1" vid="ISA 42:19">ባና ጎዳስ አድ እምዳ ኡራፐ</para>
  <para style="q2" vid="ISA 42:19">ጎዳ አይልያፈ ሀር ቆቀይ ኦኔ?<verse eid="ISA 42:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 42:20"/>ዳሮባ በአዳሳ፥ ሽን አኬካካ፤</para>
  <para style="q2" vid="ISA 42:20">ነ ሀይይ ዶያ፥ ሽን ስአካ” ያጌስ።<verse eid="ISA 42:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 42:21"/>ጎዳይ ባ ፅሎተ ግሾ፥</para>
  <para style="q2" vid="ISA 42:21">ባ ህግያ ግታያናዉነ ቦንቻናዉ ዶስስ።<verse eid="ISA 42:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 42:22"/>ሽን ሀ አሳይ ቦንቀትስ፤</para>
  <para style="q2" vid="ISA 42:22">ደእያባ ኤከትስ።</para>
  <para style="q1" vid="ISA 42:22">ኦላ ግዶን ፅሄን ኦይከትስ፥</para>
  <para style="q2" vid="ISA 42:22">ቃሾ ኬን ኤንታ ቦላ ጎርደትስ።</para>
  <para style="q1" vid="ISA 42:22">ኤንቲ ቦንቀትዶሶና፥ ሽን ኤንታ አሸይ ባዋ፤</para>
  <para style="q2" vid="ISA 42:22">ድኤትዶሶና፥ ሽን ኦንካ “ኤንታ ጉየ ዛራ”</para>
  <para style="m" vid="ISA 42:22">ግያ አስ ባዋ።<verse eid="ISA 42:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 42:23"/>ህንተ ግዶፈ ሀይሳ ስኤይ ኦኔ?</para>
  <para style="q2" vid="ISA 42:23">ስንፈ ያና ዎድያባ ቆፐይ ኦኔ?<verse eid="ISA 42:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 42:24"/>ያይቆባ ድኤተስ፥</para>
  <para style="q2" vid="ISA 42:24">እስራኤለ ቦንቄስ አድ እምዳይ ኦኔ?</para>
  <para style="q1" vid="ISA 42:24">ናጋራ ኦድ ኑ ቆህዳ፥</para>
  <para style="q2" vid="ISA 42:24">እያ ኦግያ ካላናዉነ፥ እያ ህግያ ኪተታናዉ</para>
  <para style="q2" vid="ISA 42:24">ኑኒ እፅዳ ጎዳ ግደነዬ?<verse eid="ISA 42:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 42:25"/>ሄሳ ግሾ፥ እ ኤንታ ቦላ ባ ኤፅያ ሀንቁዋ ጉስስ፤</para>
  <para style="q2" vid="ISA 42:25">ኤንታ ዩሹዋ ታማ ላጮን ተቅስ፥</para>
  <para style="q2" vid="ISA 42:25">ሽን ኤንቲ ኤርቦኮና፤</para>
  <para style="q1" vid="ISA 42:25">እ ኤንታ ፁግስ፥</para>
  <para style="q2" vid="ISA 42:25">ሽን ኤንቲ አኬክቦኮና።<verse eid="ISA 42:25"/></para>
  <chapter eid="ISA 42"/>
  <chapter number="43" style="c" sid="ISA 43"/>
  <para style="s1">እስራኤለ አሽያ እሱዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 43:1"/>ሽን ነኖ ያይቆባ ነና መዳይ፥</para>
  <para style="q2" vid="ISA 43:1">ነኖ እስራኤለ፥ ነና ጊግስዳይ፥</para>
  <para style="q1" vid="ISA 43:1">ጎዳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q1" vid="ISA 43:1">“ታኒ ነና ዎዝዳ ግሾ ያዮፋ፤</para>
  <para style="q2" vid="ISA 43:1">ታኒ ነና ነ ሱንን ፄጋስ፤ ኔኒ ታባ።<verse eid="ISA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 43:2"/>ኔኒ ሃ ግዶራ ፕንያ ዎደ</para>
  <para style="q2" vid="ISA 43:2">ታኒ ኔራ ግዳና።</para>
  <para style="q1" vid="ISA 43:2">ኔኒ ሻፋታ ግዶራ ፕንያ ዎደ</para>
  <para style="q2" vid="ISA 43:2">ኤንቲ ነና ምቶኮና።</para>
  <para style="q1" vid="ISA 43:2">ኔኒ ታማ ግዶራ አያ ዎደ</para>
  <para style="q2" vid="ISA 43:2">ፁገታካ፤ ላጮይካ ነና ሜና።<verse eid="ISA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 43:3"/>ታኒ ነና አሽይሳ፥ እስራኤለ ጌሻ፥</para>
  <para style="q2" vid="ISA 43:3">ጎዳ ነ ፆሳ።</para>
  <para style="q1" vid="ISA 43:3">ግብፀ ነዉ ዎዞ ኦዳ፥</para>
  <para style="q2" vid="ISA 43:3">ቶጰነ ሳባ</para>
  <para style="q2" vid="ISA 43:3">ነዉ ላመ ኦዳ እማና።<verse eid="ISA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 43:4"/>ኔኒ ታ ስንን አልኦነ ቦንቾ ግድያ ግሾ፥</para>
  <para style="q2" vid="ISA 43:4">ታኒ ነና ዶስያ ግሾ፥</para>
  <para style="q2" vid="ISA 43:4">አሳ ነ ግሾ፥ ካዎተታ ነ ሸምፑዋ ግሾ</para>
  <para style="q2" vid="ISA 43:4">ላመ ኦዳ እማና።<verse eid="ISA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 43:5"/>ታኒ ኔራ ደእያ ግሾ ያዮፋ፤</para>
  <para style="q2" vid="ISA 43:5">ታኒ ነ ናይታ ዶሎሀፐ</para>
  <para style="q2" vid="ISA 43:5">ነና ዉሎሀፐ ሺሻና።<verse eid="ISA 43:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 43:6"/>ታኒ ፑደሀ ባጋ፥ ‘ኤንታ ዛራዳ ኤሀ!’</para>
  <para style="q2" vid="ISA 43:6">ዱገሀ ባጋ፥ ‘ኤንታ ተቆፋ’ ያጋና።</para>
  <para style="q1" vid="ISA 43:6">ታ አደ ናይታ ሃሆሶፐ፥</para>
  <para style="q2" vid="ISA 43:6">ታ ማጫ ናይታ ሳኣ ጋፃፐ ኤሀና።<verse eid="ISA 43:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 43:7"/>ኤንቲ ታ ሱንን ፄገትዳይሳታ፥</para>
  <para style="q2" vid="ISA 43:7">ታኒ ታ ቦንቹዋስ መዳይሳታ፥</para>
  <para style="q2" vid="ISA 43:7">ታኒ ጊግስዳይሳታነ ኦዳይሳታ ሀምተ።”<verse eid="ISA 43:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 43:8"/>አይፈይ ደእሽን ቆቅዳ አሳታ፥</para>
  <para style="q2" vid="ISA 43:8">ሀይ ደእሽን ቱልዳ አሳታ ከሳ።<verse eid="ISA 43:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="ISA 43:9"/>ካዎተት ኡባይ እስፈ ሺቆ፤</para>
  <para style="q2" vid="ISA 43:9">አሳይ ዱላታ ኡቶ።</para>
  <para style="q1" vid="ISA 43:9">ኤንታ ኤቃታ ግዶፈ ሀይሳ ኦዳናዉ፥</para>
  <para style="q2" vid="ISA 43:9">ካሰ አዳባታ ኑስ ቆንጭሳናዉ</para>
  <para style="q2" vid="ISA 43:9">ዳንዳኤይ ኦኔ?</para>
  <para style="q1" vid="ISA 43:9">ሀራ አሳይ ስእድ፥ “ሀይስ ቱማ” ጋና መላ፥</para>
  <para style="q2" vid="ISA 43:9">ኤንቲ ልከ ግደይሳ በሳናዉ ባንታ ማርካታ ኤሆ።<verse eid="ISA 43:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 43:10"/>ጎዳይ ሀይሳዳ ያጌስ፦ “ህንተ ታ ማርካታ፤</para>
  <para style="q2" vid="ISA 43:10">ህንተ ታና ኤራና መላነ አማናና መላ</para>
  <para style="q2" vid="ISA 43:10">ታኒ ፆሰ ግደይሳ አኬካና መላ</para>
  <para style="q2" vid="ISA 43:10">ታኒ ዶርዳ ታ አይለት ህንተና።</para>
  <para style="q1" vid="ISA 43:10">ታፐ ካሰ ሀራ ፆሲ መትቤና፤</para>
  <para style="q2" vid="ISA 43:10">ታፐ ጉየ ሀራ ፆሲ ዴና።<verse eid="ISA 43:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 43:11"/>ታኒ ጎዳ፤</para>
  <para style="q2" vid="ISA 43:11">ታፐ አትሽን፥ ሀር አሸይ ባዋ።<verse eid="ISA 43:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 43:12"/>ታ ካሰታዳ ኦዳስ፥</para>
  <para style="q2" vid="ISA 43:12">ታ ኦናባ አዋጃስ፥ ታ አሻስ።</para>
  <para style="q1" vid="ISA 43:12">ህንተ ግዶን ደእያ አላጋ ፆሳታፐ</para>
  <para style="q2" vid="ISA 43:12">ሄሳ ኦዳይ ባዋ።</para>
  <para style="q1" vid="ISA 43:12">ታኒ ፆሰ ግደይሳስ ህንተ ታዉ ማርካታ።<verse eid="ISA 43:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 43:13"/>መርናፐ መርናዉ ታኒ ፆሰ፤</para>
  <para style="q2" vid="ISA 43:13">ታ ኩሸፐ ኦንካ አሸና፤</para>
  <para style="q2" vid="ISA 43:13">ታ ኦዳባ ላማናዉ ዳንዳኤይ ባዋ”</para>
  <para style="m" vid="ISA 43:13">ያጌስ ጎዳይ።<verse eid="ISA 43:13"/></para>
  <para style="s1">ፆሳ ማሮታነ አማነቶና እስራኤለ</para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 43:14"/>ጎዳይ፥ ህንተና ዎዝያ፥</para>
  <para style="q2" vid="ISA 43:14">እስራኤለ ጌሻይ፥ ሀይሳዳ ያጌስ፦</para>
  <para style="q1" vid="ISA 43:14">“ህንተ ግሾ፥ ታኒ ባብሎነ ቦላ</para>
  <para style="q2" vid="ISA 43:14">ኦላንቾታ ኪታና።</para>
  <para style="q1" vid="ISA 43:14">ባብሎነታ ኡባ ኤንቲ ጬቀትያ</para>
  <para style="q2" vid="ISA 43:14">ማርካበታራ በታና መላ ኦና።<verse eid="ISA 43:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 43:15"/>ታኒ ጎዳ፥ ህንተ ጌሻ፥</para>
  <para style="q2" vid="ISA 43:15">እስራኤለ መዳ ህንተ ካዋ” ያጌስ።<verse eid="ISA 43:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 43:16"/>አባ ግዶን ኦገ፥</para>
  <para style="q2" vid="ISA 43:16">ዎልቃማ ሃታ ግዶራ ሆሮጋ</para>
  <para style="q2" vid="ISA 43:16">ከስዳ ጎዳይ ሀይሳዳ ያጌስ።<verse eid="ISA 43:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 43:17"/>ፓራ ጋረታነ ፓራታ፥</para>
  <para style="q2" vid="ISA 43:17">ኦላንቾታነ ምኖ አሳታ አባን ኤህድ፥</para>
  <para style="q2" vid="ISA 43:17">ኤንቲ ደንዶና መላ የግዳይ፥</para>
  <para style="q2" vid="ISA 43:17">ኤንታ ሙቃዳ ታማዳ ቶይስዳ።<verse eid="ISA 43:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 43:18"/>ጎዳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q2" vid="ISA 43:18">“ካሰባታ ሃሳዮፕተ፤</para>
  <para style="q2" vid="ISA 43:18">በንባታ ቆፖፍተ።<verse eid="ISA 43:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 43:19"/>ሄኮ፥ ሀእ ታኒ ኦራባ ኦይስ፤</para>
  <para style="q2" vid="ISA 43:19">እካ ሀእ ዶላና።</para>
  <para style="q1" vid="ISA 43:19">ሄስ ህንተዉ በንተኔ?</para>
  <para style="q2" vid="ISA 43:19">ታኒ መላ ቢታን ኦገ፥</para>
  <para style="q2" vid="ISA 43:19">መላ ቢታን ሻፋታ ከሳና።<verse eid="ISA 43:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 43:20"/>ታኒ ዶርዳ፥ ታ አሳስ መላ ቢታን ሃ፥</para>
  <para style="q2" vid="ISA 43:20">መላ ቢታን ሃ ሻፋታ እማስ።</para>
  <para style="q1" vid="ISA 43:20">ዎራ ዶአት፥ ዎርካናትነ ያንቾት</para>
  <para style="q2" vid="ISA 43:20">ታና ቦንቻና።<verse eid="ISA 43:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 43:21"/>ታኒ ታዉ መዳ ደረ ግድያ ግሾ፥</para>
  <para style="q2" vid="ISA 43:21">ታ ጋላታ አዋጃና ማላ ታ ሀይሳ ኦስ።<verse eid="ISA 43:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 43:22"/>ሽን ነኖ ያይቆባ፥</para>
  <para style="q2" vid="ISA 43:22">ኔኒ ታ ሱን ፄጋባካ፤</para>
  <para style="q2" vid="ISA 43:22">ነኖ እስራኤለ፥ ኔኒ ታና ሳለታዳሳ።<verse eid="ISA 43:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 43:23"/>ኔኒ ታዉ ፁሳ ያርሾስ ዶርሰ ኤሀባካ፤</para>
  <para style="q2" vid="ISA 43:23">ሀራ ያርሾንካ ታና ቦንቻባካ።</para>
  <para style="q1" vid="ISA 43:23">ታኒ ነና ካ ያርሾ ኤሀ ጋዳ ዋይሳብከ፤</para>
  <para style="q2" vid="ISA 43:23">እፃነ ታዉ ጩይሶ ጋዳ ዳቡርሳብከ።<verse eid="ISA 43:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 43:24"/>ኔኒ ታዉ ሳውያ እፃነ ሻማባካ፤</para>
  <para style="q2" vid="ISA 43:24">ነ ሞ ያርሾን ታና ኡፋይሳባካ።</para>
  <para style="q1" vid="ISA 43:24">ሽን ኔኒ ነ ናጋራን ታና ዋይሳዳሳ፤</para>
  <para style="q2" vid="ISA 43:24">ነ ናቁዋን ታና ዳቡርሳዳሳ።<verse eid="ISA 43:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 43:25"/>“ታ ግሾ ጋዳ ነ ናጋራ ቁቸይ ታና፤</para>
  <para style="q2" vid="ISA 43:25">ነ ናጋራ ዛራዳ ቆፕከ።<verse eid="ISA 43:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 43:26"/>አነ ታና ሀሳይሳ፤</para>
  <para style="q2" vid="ISA 43:26">ኔኒ ፅሎ ግደይሳ ኤርሳናዉ</para>
  <para style="q2" vid="ISA 43:26">እስፈ ሺቅድ ሞተቶስ።<verse eid="ISA 43:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 43:27"/>ነ ኮይሮ አዋይ ናጋራ ኦስ፤</para>
  <para style="q2" vid="ISA 43:27">ነ አስታማረት ታና ቆህዶሶና።<verse eid="ISA 43:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 43:28"/>ሄሳ ግሾ፥ ታኒ ታ ኬ ሀላቃታ ካዉሻስ፤</para>
  <para style="q2" vid="ISA 43:28">ያይቆባ ጋዶስ፥ እስራኤለ ጫሻስ</para>
  <para style="q2" vid="ISA 43:28">አዳ እማስ።”<verse eid="ISA 43:28"/></para>
  <chapter eid="ISA 43"/>
  <chapter number="44" style="c" sid="ISA 44"/>
  <para style="s1">ዶረትዳ እስራኤለ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 44:1"/>ሽን ታ አይልያ ያይቆባ፥ ታ ዶርዳ እስራኤለ፥</para>
  <para style="q2" vid="ISA 44:1">ሀእካ ስአ።<verse eid="ISA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 44:2"/>ነና መዳ፥ ነ አየ ኡሎን ነና ጊግስዳ</para>
  <para style="q2" vid="ISA 44:2">ጎዳይ ሀይሳዳ ያጌስ።</para>
  <para style="q1" vid="ISA 44:2">ታ አይልያ ያይቆባ፥</para>
  <para style="q2" vid="ISA 44:2">ታኒ ዶርዳ ይሹሩና፥ ያዮፋ።<verse eid="ISA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 44:3"/>ታኒ ሳሞትዳ ቢታን ሃ ጉሳና፤</para>
  <para style="q2" vid="ISA 44:3">መላ ቢታ ቦላ ሻፋ ጎግሳና።</para>
  <para style="q1" vid="ISA 44:3">ታ አያና ነ ናይታ ቦላ፥</para>
  <para style="q2" vid="ISA 44:3">ታ አንጁዋ ነ ኮቻ ቦላ ጉሳና።<verse eid="ISA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 44:4"/>ኤንቲ ሃ ዶናን ዶልዳ ማታዳ፥</para>
  <para style="q2" vid="ISA 44:4">ሻፋ ላንቀን ደእያ ምዳ አጫና።<verse eid="ISA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 44:5"/>እሶይ ባና፥ ታኒ ጎዳባ ያጋና፤</para>
  <para style="q2" vid="ISA 44:5">ሀንኮይ ባና ያይቆባ ሱንን ፄጋና፤</para>
  <para style="q2" vid="ISA 44:5">ሀራይ ባ ኩሽያ ቦላ፥ “ታኒ ጎዳባ” ያግድ ጫዳና፤</para>
  <para style="q2" vid="ISA 44:5">እ እስራኤለ እያ ሱንን ፄገታና።<verse eid="ISA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 44:6"/>ጎዳይ፥ እስራኤለ ካዎይነ እያ ዎዝዳይ፥</para>
  <para style="q2" vid="ISA 44:6">ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q1" vid="ISA 44:6">“ኮይሮይ ታና፤ ዉርሰይ ታና፤</para>
  <para style="q2" vid="ISA 44:6">ታፐ ሀራ ፆሲ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">44:6 </char><char style="xt" closed="false"><ref loc="ISA 48:12">እሳ 48:12</ref>፤ <ref loc="REV 1:17">ቆን 1:17</ref>፤ <ref loc="REV 22:13">22:13</ref>.</char></note><verse eid="ISA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 44:7"/>ታ መል ኦኔ? ደእኮ አነ አዋጆ፤</para>
  <para style="q2" vid="ISA 44:7">አነ ታ ስንን ኤቅድ ኦዶ።</para>
  <para style="q1" vid="ISA 44:7">በንፐ ዶምድ፥ ሀንዳባ ኦዶ፤</para>
  <para style="q2" vid="ISA 44:7">ስንፈ ሀናናባ ቆንጭሶ።<verse eid="ISA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 44:8"/>ያዮፍተ፤ ዳጋሞፕተ፤</para>
  <para style="q2" vid="ISA 44:8">ታኒ ሀይሳ በንፐ ዶማዳ ኦዳብክና?</para>
  <para style="q1" vid="ISA 44:8">ካሰታዳ ኤርሳብክና?</para>
  <para style="q2" vid="ISA 44:8">ሄሳስ ህንተ ታዉ ማርካ።</para>
  <para style="q1" vid="ISA 44:8">ታፐ አትሽን፥ ሀራ ፆሲ ደኢ?</para>
  <para style="q2" vid="ISA 44:8">ሀራ ዛል ባዋ፤</para>
  <para style="q2" vid="ISA 44:8">ኦንካ ባይናይሳ ታ ኤራይስ” ያጌስ።<verse eid="ISA 44:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 44:9"/>ኤቃ ምስለታ መያ ኡባይ ሀዳ፤</para>
  <para style="q2" vid="ISA 44:9">እያን ኡፋይትያባት ኤንታ ጎኦኮና።</para>
  <para style="q1" vid="ISA 44:9">ኤንታ ማርካት ቆቀታ ኤንታዉ ኤር ባዋ፤</para>
  <para style="q2" vid="ISA 44:9">ኤንቲ ዬላታና።<verse eid="ISA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 44:10"/>ባና ጎኦና ኤቃ</para>
  <para style="q2" vid="ISA 44:10">ፆሳ ኦድ ጊግስዳይ ኦኔ?<verse eid="ISA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 44:11"/>ኤቃ መይ አሰፐ አትሽን፥ ሀራ ግደና፤</para>
  <para style="q2" vid="ISA 44:11">እነ እያ ላገት ዬላታና፤</para>
  <para style="q2" vid="ISA 44:11">ኡባት እስፈ ሺቅድ ኤቆ፥ ያዮ፥ ዬላቶ።<verse eid="ISA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 44:12"/>ብራታ ቆፀይስ ኤቃ ኦናዉ</para>
  <para style="q2" vid="ISA 44:12">ባ ብራታ ታማን ሴርስድ ማላ እማናዉ</para>
  <para style="q2" vid="ISA 44:12">ባ ምኖ ኩሽያን ናርቃን ቆፄስ።</para>
  <para style="q1" vid="ISA 44:12">ሄሳ ጊግስሸ ኮሻቴስ፤</para>
  <para style="q2" vid="ISA 44:12">እያ ዎልቃይ ዉሬስ፤</para>
  <para style="q2" vid="ISA 44:12">ሳሞተስነ ላባኔስ።<verse eid="ISA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 44:13"/>አናፀይ ዎዶሮን ልክድ</para>
  <para style="q2" vid="ISA 44:13">እርሳሰን እያ ቦላ ማላ ዎስ፤</para>
  <para style="q2" vid="ISA 44:13">ሊቅስያ ሚሸን ሊቅሴስ።</para>
  <para style="q1" vid="ISA 44:13">ሎኦ አሳ ማላን መድ</para>
  <para style="q2" vid="ISA 44:13">ባ ኤቃ ኬን ዎስ።<verse eid="ISA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 44:14"/>እ ሄሳ ኦናዉ ዝጋ ቃንፄስ፤</para>
  <para style="q2" vid="ISA 44:14">ዎላ ዎይኮ ፂዳ ዎራ ግዶፈ ዶርድ</para>
  <para style="q2" vid="ISA 44:14">ድጫና መላ ኦስ።</para>
  <para style="q1" vid="ISA 44:14">ዎይኮ ዝጋ ቶክድ</para>
  <para style="q2" vid="ISA 44:14">እራን ድጫና መላ ናጌስ።<verse eid="ISA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 44:15"/>እያፐ ባጋ ኤናዉ ጎኤቴስ፤</para>
  <para style="q2" vid="ISA 44:15">እያፐ ባጋ ኤክድ፥ ኤድ ካዬስ፤</para>
  <para style="q2" vid="ISA 44:15">ባጋ ኤድ ካ ካስ።</para>
  <para style="q1" vid="ISA 44:15">አትዳይሳ ኤክድ ፆሰ ኦድ እያዉ ጎይኔስ፤</para>
  <para style="q2" vid="ISA 44:15">ኤቃ መድ እያ ስንን ጉፋኔስ።<verse eid="ISA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 44:16"/>እያፐ ባጋ ኤድ ካ ካስ፤</para>
  <para style="q2" vid="ISA 44:16">ባጋን አሾ ጫጭድ ካልድ ሜስ።</para>
  <para style="q1" vid="ISA 44:16">ቃስ ታማ ካይሸ፥ “ኤሮሾ፥ ታማ ጎፓ፤</para>
  <para style="q2" vid="ISA 44:16">ዋን ሆእ” ያጌስ።<verse eid="ISA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 44:17"/>ቃስ አትዳ ም ማስድ፥</para>
  <para style="q2" vid="ISA 44:17">ጎይንያ ፆሳ ምስለ ከሴስ።</para>
  <para style="q1" vid="ISA 44:17">ሄ ምስልያ ስንን ጉፋንድ፥ እያዉ ጎይኔስ፤</para>
  <para style="q2" vid="ISA 44:17">“ኔኒ ታዉ ፆሰ ግድያ ግሾ፥</para>
  <para style="q2" vid="ISA 44:17">ታና አሻ” ያግድ ዎሴስ።<verse eid="ISA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 44:18"/>ኤንቲ አይኮካ ኤሮኮና፤ አይኮካ አኬኮኮና፤</para>
  <para style="q2" vid="ISA 44:18">ኤንቲ በኦና መላ ኤንታ አይፈይ ጎዘትስ፤</para>
  <para style="q2" vid="ISA 44:18">አኬኮና መላ ኤንታ ዎዛናይ ጎርደትስ።<verse eid="ISA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 44:19"/>ኤቃ ኦያ አሳ ግዶፈ ባ ዎዛናን፥</para>
  <para style="q2" vid="ISA 44:19">“እያፐ ባጋ ታማን ኤስ፤</para>
  <para style="q2" vid="ISA 44:19">እያ ቦንቁዋን ካ ካስ፤</para>
  <para style="q2" vid="ISA 44:19">እያን አሾ ጫጫዳ ማስ።</para>
  <para style="q1" vid="ISA 44:19">እያፐ አትዳይሳ እፀትዳ ኤቃ ኦዳ መ?</para>
  <para style="q2" vid="ISA 44:19">አትዳ ጩገ ምስ ጉፋናዳ ጎይኖ?”</para>
  <para style="q2" vid="ISA 44:19">ያግድ ቆፕያ ዎይኮ አኬክያ አስ ባዋ።<verse eid="ISA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 44:20"/>እ ብዶ ሜስ፤ እያ ጭመትዳ ዎዛናይ</para>
  <para style="q2" vid="ISA 44:20">እያ ሀራ ሶ ካለስ።</para>
  <para style="q1" vid="ISA 44:20">እ ባ ሸምፑዋ አሻናዉ ዳንዳኤና፤</para>
  <para style="q2" vid="ISA 44:20">“ሀይስ ታ ኡሻቻ ኩሸን ደኤይ ዎርዶ ግደና”</para>
  <para style="q2" vid="ISA 44:20">ጋናዉ ዳንዳኤና።<verse eid="ISA 44:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 44:21"/>ጎዳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q1" vid="ISA 44:21">“ያይቆባ፥ ሀይሳ አኬካ፤</para>
  <para style="q2" vid="ISA 44:21">እስራኤለ፥ ኔኒ ታ አይለ ግድያ ግሾ ሀይሳ ሀሳያ።</para>
  <para style="q1" vid="ISA 44:21">ታኒ ነና መስ፤ ኔኒ ታ አይለ፤</para>
  <para style="q2" vid="ISA 44:21">ነኖ እስራኤለ፥ ታኒ ነና ዶግከ።<verse eid="ISA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 44:22"/>ታኒ ነ ናጋራ ፕታዳ ድጋስ፥</para>
  <para style="q2" vid="ISA 44:22">ነ ናቁዋ ጫጋናዳ ቁቻስ።</para>
  <para style="q1" vid="ISA 44:22">ታኒ ነና ዎዝዳ ግሾ፥</para>
  <para style="q2" vid="ISA 44:22">ታኮ ስማ” ያጌስ።<verse eid="ISA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 44:23"/>“ህንተኖ ሳሎቶ፥ ጎዳይ ሀይሳ ኦዳ ግሾ፥</para>
  <para style="q2" vid="ISA 44:23">ኡፋይሳን የፅተ፤ ነኖ ቢታዉ፥ እልላ።</para>
  <para style="q1" vid="ISA 44:23">ህንተኖ ደረቶ፥ ዎራዉነ</para>
  <para style="q2" vid="ISA 44:23">እያ ግዶን ደእያ ም ኡባይ ማዝሙረ የፅተ።</para>
  <para style="q1" vid="ISA 44:23">ጎዳይ ያይቆባ ዎዝስ፤</para>
  <para style="q2" vid="ISA 44:23">እስራኤለ ግዶን ቦንቸትስ።<verse eid="ISA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 44:24"/>ነ አየ ኡሎን ነና መዳይስ፥</para>
  <para style="q2" vid="ISA 44:24">ነና ዎዝዳይስ ጎዳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q1" vid="ISA 44:24">ኡባባ መዳይ፥ ሳሎታ ታርካ ምጭዳይ፤</para>
  <para style="q2" vid="ISA 44:24">ሳኣካ ታርካ ሂፅዳይ፥ ታኒ ጎዳ።<verse eid="ISA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 44:25"/>ታኒ ዎርዶ ናበታ ትንብትያ ሀዳ ኦስ፤</para>
  <para style="q2" vid="ISA 44:25">ማሮታ ካዮዋ ኤያተ ከሳስ።</para>
  <para style="q1" vid="ISA 44:25">ታኒ ጭንጫታ ጭንጫተ ሽራ የጋስ፤</para>
  <para style="q2" vid="ISA 44:25">ኤንታ ኤራ ኤያ ኦስ።<verse eid="ISA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 44:26"/>ታኒ ታ አይለታ ቃላ ምንና፤</para>
  <para style="q2" vid="ISA 44:26">ታ ናበታ ትንብትያ ፖላና።</para>
  <para style="q1" vid="ISA 44:26">ታኒ የሩሳላመ ካታማ፥</para>
  <para style="q2" vid="ISA 44:26">‘ኔኒ አሳይ ደእያ በሲ ግዳና’ ያጋስ፤</para>
  <para style="q1" vid="ISA 44:26">ይሁዳ ካታማታ፥</para>
  <para style="q2" vid="ISA 44:26">‘ህንተ ስሚድ ኬፀታና፤ ህንተ ግምበይ ኦራፃና’ ያጋስ።<verse eid="ISA 44:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 44:27"/>ታኒ ጎግያ ሃታ መልሳና ግሾ</para>
  <para style="q2" vid="ISA 44:27">ጪሞ ሃ፥ ‘ነ መላ’ ያጋና።<verse eid="ISA 44:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 44:28"/>ቅሮሳኮ፥ ‘ኔኒ ታ አሳ ሄመይሳ፤</para>
  <para style="q2" vid="ISA 44:28">ኔኒ ታ ሀልቹዋ ፖለይሳ’ ያጋና።</para>
  <para style="q1" vid="ISA 44:28">እ፥ የሩሳላመ ካታማ፥ ‘ኔኒ ስማዳ ኬፀታና’፤</para>
  <para style="q2" vid="ISA 44:28">ፆሳ ኬ፥ ‘ነ ባሶይ የገታና’ ” ያጋና።<verse eid="ISA 44:28"/></para>
  <chapter eid="ISA 44"/>
  <chapter number="45" style="c" sid="ISA 45"/>
  <para style="s1">ቅሮሳ ዶረተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 45:1"/>ጎዳይ ትይዳይሳስ፥</para>
  <para style="q2" vid="ISA 45:1">ካዎታ ዳንጮ ብልሳና መላ፥</para>
  <para style="q2" vid="ISA 45:1">ደርያ እያዉ ሃርሳና መላ፥</para>
  <para style="q2" vid="ISA 45:1">ፐንገት እያ ስንን ዶየታና መላ</para>
  <para style="q2" vid="ISA 45:1">እያ ኡሻቻ ኩሽያ ኦይክዳ ቅሮሳ</para>
  <para style="q2" vid="ISA 45:1">ጎዳይ ሀይሳዳ ያጌስ፦<verse eid="ISA 45:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 45:2"/>ታኒ ነ ስንራ ባና፤ ደረታ ደምባያና፤</para>
  <para style="q2" vid="ISA 45:2">ናሰ ብራታ ሳንቃታ መንና፤</para>
  <para style="q2" vid="ISA 45:2">ብራታ ኮበታ ቃንፃና።<verse eid="ISA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 45:3"/>ነና ነ ሱንን ፄገይ ታና ጎዳ፥</para>
  <para style="q2" vid="ISA 45:3">እስራኤለ ፆሳ ግደይሳ ኔኒ ኤራና መላ</para>
  <para style="q2" vid="ISA 45:3">ታኒ ነዉ ማን ደእያ ሻሉዋ፥</para>
  <para style="q2" vid="ISA 45:3">ጌማን ቆሰትዳ ዱረተ እማና።<verse eid="ISA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 45:4"/>ታ አይልያ ያይቆባ ግሾ፥</para>
  <para style="q2" vid="ISA 45:4">ታኒ ዶርዳ እስራኤለ ግሾ፥</para>
  <para style="q2" vid="ISA 45:4">ታኒ ነና ነ ሱንን ፄጋስ።</para>
  <para style="q1" vid="ISA 45:4">ኔኒ ታና ኤሮና እፅኮካ፥</para>
  <para style="q2" vid="ISA 45:4">ታኒ ነና ቦንቾ ሱንን ፄጋስ።<verse eid="ISA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 45:5"/>ታኒ ጎዳ፤ ታፐ ሀራ ፆሰ ባዋ፤</para>
  <para style="q2" vid="ISA 45:5">ኔኒ ታና ኤሮና እፅኮካ</para>
  <para style="q2" vid="ISA 45:5">ታኒ ነዉ ዎልቃ እማና።<verse eid="ISA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 45:6"/>ሄስካ አው ዶልያሶፐ ዉልያሶ ጋካናዉ</para>
  <para style="q2" vid="ISA 45:6">ታፐ ሀር ባይናይሳ አሳይ ኤራና መላሳ፤</para>
  <para style="q2" vid="ISA 45:6">ታኒ ጎዳ፤ ታፐ ሀራ ፆሲ ባዋ።<verse eid="ISA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 45:7"/>ታኒ ፖኦነ ማ መስ፤</para>
  <para style="q2" vid="ISA 45:7">ሳሮተነ ዮ ኤሀይስ፤</para>
  <para style="q2" vid="ISA 45:7">ሀ ኡባ ታኒ ጎዳይ ኦይስ።<verse eid="ISA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 45:8"/>ህንተኖ ሳሎቶ፥ ቦላፈ ፅሎተ ትግተ፤</para>
  <para style="q2" vid="ISA 45:8">ሻራት ቡክሶ።</para>
  <para style="q1" vid="ISA 45:8">ቢታይ ዶየቶ፥ አቶተ ፅሎተይ እስፈ ዶሎ፤</para>
  <para style="q2" vid="ISA 45:8">ታኒ ጎዳይ ሀይሳ መስ።<verse eid="ISA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 45:9"/>ባና መዳይሳራ ፓላምያ ኡራ አየ!</para>
  <para style="q2" vid="ISA 45:9">እ ሳአን መቅድ ዎዳ</para>
  <para style="q2" vid="ISA 45:9">ኦቶፐ እሱዋ መላ።</para>
  <para style="q1" vid="ISA 45:9">ኦቶይ ባና መይሳኮ፥</para>
  <para style="q2" vid="ISA 45:9">ኔኒ፥ “አይ ኦይ?”</para>
  <para style="q2" vid="ISA 45:9">“ነዉ ኩሸይ ባዋ” ያግዬ?<note caller="-" style="x"><char style="xo" closed="false">45:9 </char><char style="xt" closed="false"><ref loc="ROM 9:20">ሮመ 9:20</ref>.</char></note><verse eid="ISA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 45:10"/>ባ አዋ፥ “ታና አይስ የላዲ?” ግያ፥</para>
  <para style="q2" vid="ISA 45:10">ባ አይዉ፥ “ታና ሀይሳዳ አይስ ኢቀታዳ የላዲ?”</para>
  <para style="q2" vid="ISA 45:10">ግያ ኡራ አየ!<verse eid="ISA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 45:11"/>ጎዳይ፥ እስራኤለ ጌሻይ፥</para>
  <para style="q2" vid="ISA 45:11">እያ መዳይስ ሀይሳዳ ያጌስ፦</para>
  <para style="q1" vid="ISA 45:11">“ስንፈ ሀናናባ፥</para>
  <para style="q2" vid="ISA 45:11">ህንተ ታና ታ ናይታባ ኦይቻናዉ፥</para>
  <para style="q2" vid="ISA 45:11">ታ ኩሸ ኦሶታባ ታና ኪታናዉ በሰቲ?<verse eid="ISA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 45:12"/>ታኒ ሳኣ ኦስ፤</para>
  <para style="q2" vid="ISA 45:12">አሰካ እያ ቦላ መስ።</para>
  <para style="q1" vid="ISA 45:12">ሳሎታ ታኒ ታ ኩሸን ምጫስ፤</para>
  <para style="q2" vid="ISA 45:12">ኤንታ ቦላ ፆልንቶታ ኡባ ዎስ።<verse eid="ISA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 45:13"/>ታኒ ቅሮሳ ፅሎተን ደንስ፤</para>
  <para style="q2" vid="ISA 45:13">እያ ኦግያ ኡባ ሱረ ኦና።</para>
  <para style="q1" vid="ISA 45:13">ሚሸ ቃንፆና ዎይኮ ዎይቶ እሞና</para>
  <para style="q2" vid="ISA 45:13">እ ታ ካታማ ኬፃና፤ ታ አሳ ድኦፐ ዛራና”</para>
  <para style="m" vid="ISA 45:13">ያጌስ ኡባፈ ዎልቃማ ጎዳይ።<verse eid="ISA 45:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 45:14"/>“ጎዳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q2" vid="ISA 45:14">ግብፀ ዱረተይነ ቶጰ ዛልኤይ፥</para>
  <para style="q2" vid="ISA 45:14">ጌሳይ አዱሳ ግድዳ ሳባ አሳት</para>
  <para style="q2" vid="ISA 45:14">ኔኮ ይድ፥ ነባ ግዳና፤</para>
  <para style="q2" vid="ISA 45:14">ኤንቲ ሳንላታን ቃሸትድ፥ ነና ካላና።</para>
  <para style="q1" vid="ISA 45:14">ኤንቲ ነዉ ጎይንሸ፥ ‘ፆሲ ኔራ ደኤስ፤</para>
  <para style="q2" vid="ISA 45:14">እያፐ አትሽን፥ ሀራ ፆሲ ባዋ’ ” ያጋና።<verse eid="ISA 45:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 45:15"/>“እስራኤለ አሽያ ጎዳ ፆሳዉ፥</para>
  <para style="q2" vid="ISA 45:15">ቱማ ኔኒ ነና ገንያ ፆሰ።<verse eid="ISA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 45:16"/>ኤቃ መይሳት ኡባይ ዬላታናነ ካዉያና፤</para>
  <para style="q2" vid="ISA 45:16">ኤንቲ እስፈ ዬላ ማአና።<verse eid="ISA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 45:17"/>ሽን ጎዳይ እስራኤለ መርና አቶተን አሻና፤</para>
  <para style="q2" vid="ISA 45:17">ህንተ መርናዉ ዬላተከታ ካዉየከታ።<verse eid="ISA 45:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 45:18"/>ሳሎታ መዳ ጎዳይ፥ ቢታ ጊግስድ ኦዳይ፥</para>
  <para style="q2" vid="ISA 45:18">አስ ዳና መላፐ አትሽን፥ ቢታ ጮ መቦና</para>
  <para style="q1" vid="ISA 45:18">ፆሳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q2" vid="ISA 45:18">ታኒ ጎዳ፤ ታፐ ሀር ባዋ።<verse eid="ISA 45:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 45:19"/>ታኒ ጌማን፥</para>
  <para style="q2" vid="ISA 45:19">ዎይኮ ማ ቢታን ኡታዳ ኦዳብከ።</para>
  <para style="q1" vid="ISA 45:19">ያይቆባ ዘረኮ፥ ‘ታና ጮ በሳን ኮይተ’ ጋብከ፤</para>
  <para style="q2" vid="ISA 45:19">ታኒ ጎዳይ ቱማ ሃሳይስ፤ ልከ ግድዳባ ቆንጭሳይስ።<verse eid="ISA 45:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 45:20"/>ህንተኖ ካዎተታ ግዶፈ አትዳይሳቶ፥</para>
  <para style="q2" vid="ISA 45:20">እስፈ ሃ ማታ ሺቅተ።</para>
  <para style="q1" vid="ISA 45:20">ምፈ ኦሰትዳ ኤቃ ምስልያ ቶክ ዩየይሳታስ፥</para>
  <para style="q2" vid="ISA 45:20">አሻናዉ ዳንዳኦና ፆሳታ ዎሰይሳታስ ኤር ባዋ።<verse eid="ISA 45:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 45:21"/>አነ ፓላምት፤ ህንተ ሞቱዋስ ጋሶ ሺሽተ፤</para>
  <para style="q2" vid="ISA 45:21">እስፈ ዞረትተ።</para>
  <para style="q1" vid="ISA 45:21">ዳሮ ዎደፐ ካሰ ሀይሳ ኦድዳይ ኦኔ?</para>
  <para style="q2" vid="ISA 45:21">በንፐ ሀይሳ አዋጅዳይ ኦኔ?</para>
  <para style="q1" vid="ISA 45:21">ታና ጎዳ ግድክናዬ?</para>
  <para style="q2" vid="ISA 45:21">ታፐ አትሽን፥ ሀራ ፆሲ ባዋ።</para>
  <para style="q2" vid="ISA 45:21">ታፐ አትሽን፥ ሀር ፅሎይነ አሽያ ፆሲ ባዋ።<verse eid="ISA 45:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 45:22"/>ህንተኖ ቢታ ጋፃፐ ጋፃ ጋካናዉ ደኤይሳቶ፥</para>
  <para style="q2" vid="ISA 45:22">ታኮ ስሚድ አትተ፤ ታፐ አትሽን፥ ሀራ ፆሲ ባዋ።<verse eid="ISA 45:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 45:23"/>ታኒ ታናን ጫቃስ፤</para>
  <para style="q2" vid="ISA 45:23">ጉየ ስሞና ቃል</para>
  <para style="q2" vid="ISA 45:23">ታ ዶናፐ ፅሎተን ከይስ።</para>
  <para style="q1" vid="ISA 45:23">ጉልባት ኡባይ ታዉ ጉልባታና፤</para>
  <para style="q2" vid="ISA 45:23">እንፃርስ ኡባይ ታናን ጫቃና።<note caller="-" style="x"><char style="xo" closed="false">45:23 </char><char style="xt" closed="false"><ref loc="ROM 14:11">ሮመ 14:11</ref>፤ <ref loc="PHP 2:10-11">ፍልጵ 2:10-11</ref>.</char></note><verse eid="ISA 45:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 45:24"/>ኤንቲ ታባ ሃሳይሸ፥</para>
  <para style="q2" vid="ISA 45:24">‘ፅሎተነ ምኖተ</para>
  <para style="q2" vid="ISA 45:24">ጎዳ ፃላላን ደኤስ’ ያጋና።</para>
  <para style="q1" vid="ISA 45:24">እያ እፅያ ኡባይ እያኮ ይድ ዬላታና።<verse eid="ISA 45:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 45:25"/>ሽን እስራኤለ ዘረ ኡባይ፥</para>
  <para style="q2" vid="ISA 45:25">ጎዳን፥ ፆኖነ ቦንቾ ደማና።<verse eid="ISA 45:25"/></para>
  <chapter eid="ISA 45"/>
  <chapter number="46" style="c" sid="ISA 46"/>
  <para style="s1">ባብሎነ ፆሳታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 46:1"/>ቤላ ጌተትያ ባብሎነ ኤቃይ ሆክስ፤</para>
  <para style="q2" vid="ISA 46:1">ነቦ ጌተትያ ኤቃይ ጉፋንስ።</para>
  <para style="q1" vid="ISA 46:1">ኤንታ ምስለት ጫና መሄ ቦላ ጫነትዶሶና፤</para>
  <para style="q2" vid="ISA 46:1">ዳቡርዳ መሄታስ ዴፆ ቶሆ ግድዶሶና።<verse eid="ISA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 46:2"/>ዴፁዋፐ ደንድዳይሳን ጫና መሄት፥</para>
  <para style="q2" vid="ISA 46:2">ጫናራ እስፈ ኩንድዶሶና።</para>
  <para style="q1" vid="ISA 46:2">ኤቃት ባንታና አሻናዉ ዳንዳኦና ግሾ</para>
  <para style="q2" vid="ISA 46:2">ባንታዉ ድኤትድ ብዶሶና።<verse eid="ISA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 46:3"/>ህንተኖ፥ እስራኤለፐ አትዳይሳቶ፥ ያይቆባ ኮቻቶ፥</para>
  <para style="q2" vid="ISA 46:3">ህንተ ቃንትዳ ዎደፐ ዶማዳ ናግዳይ፥</para>
  <para style="q2" vid="ISA 46:3">ህንተ የለትዳ ዎደፐ ዶማዳ ቶክዳይ፥</para>
  <para style="q2" vid="ISA 46:3">ታኒ ኦደይሳ ስእተ።<verse eid="ISA 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 46:4"/>ህንተ ጭማና ጋካናዉ፥</para>
  <para style="q2" vid="ISA 46:4">ፑሉማና ጋካናዉ ታኒ ታና፤</para>
  <para style="q2" vid="ISA 46:4">ታ ህንተና ማዳና።</para>
  <para style="q1" vid="ISA 46:4">ታኒ ህንተና መስ፤ ታ ህንተና ናጋና፤</para>
  <para style="q2" vid="ISA 46:4">ታ ህንተና ቶካናነ አሻና።<verse eid="ISA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 46:5"/>ታና ኦደራ ጋደዬቲ?</para>
  <para style="q2" vid="ISA 46:5">ዎይኮ ኦደራ ልክሴቲ?</para>
  <para style="q1" vid="ISA 46:5">ኤንቲ ዎል ዳኔስ ጋናዉ</para>
  <para style="q2" vid="ISA 46:5">ታና ኦደራ ግናየቲ?<verse eid="ISA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 46:6"/>አሳይ ዎርቃነ ብራ ባንታ ቃርፂታፐ ቆልድ፥</para>
  <para style="q2" vid="ISA 46:6">ፆሰ ኦድ መና መላ ዎርቃ ሼሸይሳስ እሞሶና።</para>
  <para style="q1" vid="ISA 46:6">እ ኦድ ስምን</para>
  <para style="q2" vid="ISA 46:6">ኤንቲ ኤቃ ስንን ጉፋንድ ጎይኖሶና።<verse eid="ISA 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 46:7"/>ኤንቲ እያ ደንድ፥ ባንታ ሀሽያን ቶክድ፥</para>
  <para style="q2" vid="ISA 46:7">እያ በሳን እያ ዎን፥ እ ሄ በሳን ኤቅ አጌስ።</para>
  <para style="q1" vid="ISA 46:7">ባ ደእያ በሳፈ ቃፀና፤</para>
  <para style="q2" vid="ISA 46:7">አስ እያኮ ዋስኮ እያዉ ዛሮ እመና፤</para>
  <para style="q2" vid="ISA 46:7">እያ መቱዋፐ እያ አሸና።<verse eid="ISA 46:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 46:8"/>ህንተኖ ናጋራንቾቶ፥</para>
  <para style="q2" vid="ISA 46:8">ሀይሳ ሀሳይተ፤ ቆፕተ፤</para>
  <para style="q2" vid="ISA 46:8">ህንተ ዎዛናን ዎተ።<verse eid="ISA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 46:9"/>በን ዎደ ሀንዳባታ ሀሳይተ፤</para>
  <para style="q2" vid="ISA 46:9">ታፐ አትሽን፥ ሀራ ፆሲ ባዋ፤ ታኒ ፆሰ፤</para>
  <para style="q2" vid="ISA 46:9">ታ መል ኦንካ ባዋ።<verse eid="ISA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 46:10"/>ታ ቆፋይ ምናና፤</para>
  <para style="q2" vid="ISA 46:10">ታኒ ታ ሀልቹዋ ኡባ ፖላና።</para>
  <para style="q1" vid="ISA 46:10">ዉርሰን ሀናናባ ዶመን፥</para>
  <para style="q2" vid="ISA 46:10">ስንፈ ሀናናባ ኮይሮታዳ ኤርሳይስ።<verse eid="ISA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 46:11"/>ዶሎሀ ባጋፈ ቦንቅያ ካፎ፥</para>
  <para style="q2" vid="ISA 46:11">ሃሆ ቢታፈ ታ ቆፋ ፖልያ አስ ፄጋና።</para>
  <para style="q2" vid="ISA 46:11">ታኒ ቆፕዳባ ፖላና፤</para>
  <para style="q2" vid="ISA 46:11">ታኒ ሀልችዳባ ኦና።<verse eid="ISA 46:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 46:12"/>ህንተኖ ዎዛን ሙምዳይሳቶ፥</para>
  <para style="q2" vid="ISA 46:12">ፅሎተፈ ሃክዳይሳቶ ታና ስእተ።<verse eid="ISA 46:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 46:13"/>ታኒ ታ ፅሎተ ማታያና፤</para>
  <para style="q2" vid="ISA 46:13">እካ ሃሆና ግደና።</para>
  <para style="q1" vid="ISA 46:13">ታ አቶተይ ጋምኤና፤ ታ አቶተ ፅዮነስ፥</para>
  <para style="q2" vid="ISA 46:13">ታ ቦንቹዋ እስራኤለስ እማና” ያጌስ።<verse eid="ISA 46:13"/></para>
  <chapter eid="ISA 46"/>
  <chapter number="47" style="c" sid="ISA 47"/>
  <para style="s1">ባብሎነ ኩንደ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 47:1"/>“ባብሎነ ጌላኤ፥</para>
  <para style="q2" vid="ISA 47:1">ዱገ ዎዳ ባና ቦላ ኡታ።</para>
  <para style="q1" vid="ISA 47:1">ባብሎነ ናተ፥</para>
  <para style="q2" vid="ISA 47:1">ነ አራታ አጋዳ ሳአን ኡታ።</para>
  <para style="q1" vid="ISA 47:1">ህዛፐ ጉየ ኔኒ ሳጶትያሮነ</para>
  <para style="q2" vid="ISA 47:1">ባሎትያሮ ጌተታካ።<verse eid="ISA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 47:2"/>ዎፃ ተቃዳ ካ ጋጫ፤</para>
  <para style="q2" vid="ISA 47:2">ነ ጉሉን ቃራ፤</para>
  <para style="q2" vid="ISA 47:2">ነ አዱሳ ማኡዋ ከሳ፤</para>
  <para style="q2" vid="ISA 47:2">ነ ዎድርያ ቃራዳ ሻፋ ፕና።<verse eid="ISA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 47:3"/>ነ ካሎይ ቃረታና፤</para>
  <para style="q2" vid="ISA 47:3">ነ ፖኮይ በንታና።</para>
  <para style="q1" vid="ISA 47:3">ታኒ ሀሎ ከያና፤</para>
  <para style="q2" vid="ISA 47:3">ኦደስካ ቃትከ” ያጌስ ጎዳይ።<verse eid="ISA 47:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 47:4"/>ኑና ዎዝያ እስራኤለ ጌሻ ሱንይ</para>
  <para style="q2" vid="ISA 47:4">ኡባፈ ዎልቃማ ጎዳ።<verse eid="ISA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 47:5"/>“ባብሎነ ናተ፥</para>
  <para style="q2" vid="ISA 47:5">ባዳ ማን ስእ ጋዳ ኡታ፤</para>
  <para style="q2" vid="ISA 47:5">ህዛፐ ጉየ ኔኒ ካዎተታ ካውዉ ጌተታካ።<verse eid="ISA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 47:6"/>ታኒ ታ አሳ ሀንቀታስ፤ ታ ላታ ቱንሳስ፤</para>
  <para style="q2" vid="ISA 47:6">ታኒ ኤንታ ነ ኩሸን አዳ እማስ።</para>
  <para style="q1" vid="ISA 47:6">ኔኒ ኤንታዉ ቃታባካ፤</para>
  <para style="q2" vid="ISA 47:6">ጭምዳይሳታ ቦላ ነ ዴፆ ቃምባራ ዎዳሳ።<verse eid="ISA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 47:7"/>ኔኒ፥ ‘ታኒ መርናዉ ካዎ ግዳና’ ያጋዳሳ፤</para>
  <para style="q2" vid="ISA 47:7">ሽን ነ ኦዳ ኦሱዋነ</para>
  <para style="q2" vid="ISA 47:7">እያ ዉርሰይ ዋናነኮ ቆፓባካ።<verse eid="ISA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 47:8"/>“ነኖ ዎፑ ጋዳ ኡትዳረነ ናገታዳ ደእዳረ ስአ።<note caller="-" style="x"><char style="xo" closed="false">47:8 </char><char style="xt" closed="false"><ref loc="REV 18:7-8">ቆን 18:7-8</ref>.</char></note> ነ ዎዛናን፥ ‘ታፐ አትሽን፥ ሀር ባዋ፤ ታኒ አምኦ ግድከ፤ ዎይኮ የላዳ ናእ ባይና አስ ግድከ’ ያጋዳሳ። <verse eid="ISA 47:8"/><verse number="9" style="v" sid="ISA 47:9"/>ሀ ናምኡባት ቆፖና እስ ጋላስ ነ ቦላ ያና። ነ ብታይ አይ ዳርኮካ፥ ነ ሙሩኖይ አይ ዎልቃምኮካ ኔኒ ነ ናይታፐ መላ አተይስነ አምኤተይ አተና።<verse eid="ISA 47:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 47:10"/>“ኔኒ ነ ኢታተን አማነታዳ፥ ‘ኦንካ ታና በኤና’ ያጋዳሳ። ነ ኤራተይነ ጭንጫተይ ነና ባለን፥ ኔኒ ነ ዎዛናን፥ ‘ታፐ አትሽን፥ ሀር ባዋ’ ያጋዳሳ። <verse eid="ISA 47:10"/><verse number="11" style="v" sid="ISA 47:11"/>ሽን ኔኒ ዋታዳ ነ ብታን ሃሳኔኮ ኤሮና ኢታይ ነ ቦላ ያና። ኔኒ ጋተ ቃንፃናዉ ዳንዳኦና ዮይ ነ ቦላ ዎና፤ ቃስ ኔኒ አይኮካ ቆፖና ጋዶይ ነ ቦላ ያና።<verse eid="ISA 47:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 47:12"/>“አነ ኔኒ ነ ናአተፈ ዶማዳ ኦሸ ደእዳ ነ ብታነ ነ ሙሩኑዋ ሀእካ ኦ። ኦን ኤር ነ ቆፕዳይሳ መላ ሀናኔኮ ዎይኮ ኔኒ እያራ ዳጋንኔኮ። <verse eid="ISA 47:12"/><verse number="13" style="v" sid="ISA 47:13"/>ኔኒ ኤክዳ ዞረይ ኡባይ ዳቡርሳፈ አትሽን፥ ነና አይኮካ ማድቤና። ሳሎ ፆልንቶ ታይበይሳትነ እያ ፄልድ አጌናን አጌናን ሀናናባ ኦደይሳት አነ ነና አሾ። <verse eid="ISA 47:13"/><verse number="14" style="v" sid="ISA 47:14"/>ኤንቲ ቡረ መላ፤ ታም ኤንታ ማና። ኤንቲ ታማ ላጩዋፐ ባንታና አሻናዉ ዳንዳኦኮና። አስ ካያ ቦንቆይ ዎይኮ አስ እያ ስንን ኡትድ ሆእያ ታማ ግደና። <verse eid="ISA 47:14"/><verse number="15" style="v" sid="ISA 47:15"/>ኔኒ ኤንታራ ዳቡርዳይሳት፥ ናአተፈ ዶምድ ኔራ ዛልእዳይሳት ነዉ ሄሳ መላ። ኤንቲ እሶይ እሶይ ባ ባላን ባላን ኦይከታና፤ ነና አሽያ ኦንካ ባዋ።”<verse eid="ISA 47:15"/></para>
  <chapter eid="ISA 47"/>
  <chapter number="48" style="c" sid="ISA 48"/>
  <para style="s1">ስሞና እፅዳ እስራኤለ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 48:1"/>“ህንተኖ፥ ያይቆባ ሶ አሳዉ፥</para>
  <para style="q2" vid="ISA 48:1">እስራኤለ ሱንን ፄገትዳይሳቶ፥</para>
  <para style="q2" vid="ISA 48:1">ይሁዳ ኮቻፈ ይዳይሳቶ፥ ሀይሳ ስእተ።</para>
  <para style="q1" vid="ISA 48:1">ህንተ ጎዳ ሱንን ጫቀታ፤</para>
  <para style="q2" vid="ISA 48:1">እስራኤለ ፆሳ ፄገታ፤</para>
  <para style="q2" vid="ISA 48:1">ሽን ቱማተንነ ፅሎተን ግደና።<verse eid="ISA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 48:2"/>ህንተ፥ ‘ኑኒ ጌሻ ካታማን ደኦስ፤</para>
  <para style="q2" vid="ISA 48:2">እስራኤለ ፆሳን ዘምፖስ፤</para>
  <para style="q2" vid="ISA 48:2">እያ ሱንይ ኡባፈ ዎልቃማ ጎዳ’ ”</para>
  <para style="m" vid="ISA 48:2">ያግድ ጬቀተታ።<verse eid="ISA 48:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 48:3"/>ታኒ ስንፈ ሀናናባታ ዳሮ ዎደፐ ካሰ ኦዳስ።</para>
  <para style="q2" vid="ISA 48:3">ታ ዶናፐ ኤንቲ ከይን፥</para>
  <para style="q2" vid="ISA 48:3">ኤንቲ ኤሶን ፖለታና መላ ኦስ።<verse eid="ISA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 48:4"/>ኔኒ ኦድን ስኦናይሳ፥</para>
  <para style="q2" vid="ISA 48:4">ነ ሞርገይ ብራታ መላ ግደይሳ</para>
  <para style="q2" vid="ISA 48:4">ነ ሶምኦይ ናሰ ብራታዳ</para>
  <para style="q2" vid="ISA 48:4">ሌቃሞናይሳ ታኒ ኤራይስ።<verse eid="ISA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 48:5"/>ሄሳ ግሾ፥ ኔኒ፥ “ሀይሳ ታ ኤቃይ ኦስ፤</para>
  <para style="q2" vid="ISA 48:5">ታ ማሰትዳ ምስለት፥ ታ ሼሻዳ ኦዳ ምስለት ኦዶሶና” ጎናዳ፥</para>
  <para style="q1" vid="ISA 48:5">ታኒ ሄሳ ነዉ በንፐ ዶማዳ ኦዳስ።</para>
  <para style="q2" vid="ISA 48:5">ኤንቲ ሀናናፐ ስን ታኒ ኤንታ ነዉ ኤርሳስ።<verse eid="ISA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 48:6"/>“ታ ካሰ ኦድዳይሳ ነ ስአዳሳ፤</para>
  <para style="q2" vid="ISA 48:6">እ ፖለትዳይሳ በአዳሳ፥</para>
  <para style="q2" vid="ISA 48:6">ያትን እያ ቱማተ ኤክኪ?</para>
  <para style="q2" vid="ISA 48:6">ህዛፐ ነ ኤሮና ኦራባታ ታ ነዉ ኦዳና።<verse eid="ISA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 48:7"/>ኤንቲ በን መትዳባ ግዶናሽን</para>
  <para style="q2" vid="ISA 48:7">ሀእ መትዶሶና።</para>
  <para style="q1" vid="ISA 48:7">ኔኒ፥ ‘ታኒ ኤንታ ኤራይስ’ ጎናዳ</para>
  <para style="q2" vid="ISA 48:7">ሀይሳፈ ካሰ ኔኒ ኤንታባ ስአባካ።<verse eid="ISA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 48:8"/>ኔኒ ስአባካ፤ ኤራባካ፤</para>
  <para style="q2" vid="ISA 48:8">ነ ሀይይ በንፐካ ዶየትቤና።</para>
  <para style="q1" vid="ISA 48:8">ኔኒ አይ ጭምያ አሴኮ ታኒ ኤራይስ፤</para>
  <para style="q2" vid="ISA 48:8">ኔኒ የለቶሳፐ ጌላ ጌተታዳ ፄገተይሳ ኤራይስ።<verse eid="ISA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 48:9"/>ታ ሱን ግሾ፥ ታኒ ታ ሀንቁዋ ዛራና፤</para>
  <para style="q2" vid="ISA 48:9">ታ ቦንቹዋ ግሾ ነና ይሶና መላ</para>
  <para style="q2" vid="ISA 48:9">ታ ሀንቁዋ ተቃና።<verse eid="ISA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 48:10"/>ታኒ ነና ፓጫስ፤</para>
  <para style="q2" vid="ISA 48:10">ብራዳ ግዶናሽን</para>
  <para style="q2" vid="ISA 48:10">ታኒ ነና መቶ ታማን ፓጫስ።<verse eid="ISA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 48:11"/>ታኒ ታ ግሾ፥ ሀይሳ ኦና፤</para>
  <para style="q2" vid="ISA 48:11">ታ ሱንይ ቶሸታና መላ ኮይከ፤</para>
  <para style="q2" vid="ISA 48:11">ታኒ ታ ቦንቹዋ ሀራስ እምከ።”<verse eid="ISA 48:11"/></para>
  <para style="s1">ባብሎነፐ ከስ</para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 48:12"/>“ነኖ ያይቆባ፥ ታኒ ፄግዳ እስራኤለ፥</para>
  <para style="q2" vid="ISA 48:12">ታኒ ኦድያባ ስአ፤</para>
  <para style="q2" vid="ISA 48:12">ታኒ እያ፤ ኮይሮይካ ታና፤ ዉርሰይካ ታና።<note caller="-" style="x"><char style="xo" closed="false">48:12 </char><char style="xt" closed="false"><ref loc="ISA 44:6">እሳ 44:6</ref>፤ <ref loc="REV 1:17">ቆን 1:17</ref>፤ <ref loc="REV 22:13">22:13</ref>.</char></note><verse eid="ISA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 48:13"/>ታ ኩሸይ ቢታ ባሱዋ መስ፤</para>
  <para style="q2" vid="ISA 48:13">ታ ኡሻቻ ኩሸይ ሳሎታ ምጭስ።</para>
  <para style="q1" vid="ISA 48:13">ታኒ ኤንታ ፄግያ ዎደ</para>
  <para style="q2" vid="ISA 48:13">ኤንቲ እስፈ ኤቆሶና።<verse eid="ISA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 48:14"/>“ህንተ ኡባይ እስፈ ሺቅድ ስእተ፤</para>
  <para style="q2" vid="ISA 48:14">ኤቃታፐ ሀይስ ሀናናይሳ ስንትድ ኦድዳይ ኦኔ?</para>
  <para style="q1" vid="ISA 48:14">ጎዳይ ዶርዳይስ እያ ቆፋ ባብሎነ ቦላ ፖላና፤</para>
  <para style="q2" vid="ISA 48:14">እያ ቀሰይካ ባብሎነ ቢታ ቦላ ግዳና።<verse eid="ISA 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 48:15"/>ታኒ፥ ታ ሁጰን እያዉ ኦዳስ፤ እያ ፄጋስ፤</para>
  <para style="q2" vid="ISA 48:15">ታ እያ ኤሀና፤ እ ኦያባ ኡባይ እያዉ ፖለታና።<verse eid="ISA 48:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 48:16"/>“ታኮ ሃ ሺቅድ ሀይሳ ስእተ፤</para>
  <para style="q1" vid="ISA 48:16">“ታኒ ኮይሮፐ ዶማዳ ጌማን ኦዳብከ፤</para>
  <para style="q2" vid="ISA 48:16">ሄስ ሀንዳ ዎደፐ ዶማዳ ታኒ ያን ደአይስ” ያጌስ።</para>
  <para style="q1" vid="ISA 48:16">ሀእካ ኡባ ሃርያ ጎዳይነ</para>
  <para style="q2" vid="ISA 48:16">እያ አያናይ ታና ኪትዶሶና።<verse eid="ISA 48:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 48:17"/>ነና ዎዝያ ጎዳይ፥</para>
  <para style="q2" vid="ISA 48:17">እስራኤለ ጌሻይ ሀይሳዳ ያጌስ፦</para>
  <para style="q1" vid="ISA 48:17">“ነና ማድያባ ታማርሰይ</para>
  <para style="q2" vid="ISA 48:17">ነ ባናዉ በሲያ ኦግያ ነ ካለይ፥</para>
  <para style="q2" vid="ISA 48:17">ታና ነ ጎዳ፥ ነ ፆሳ።<verse eid="ISA 48:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 48:18"/>ኔኒ ታ ኪታ ስእዳባ ግድያኮ፥</para>
  <para style="q2" vid="ISA 48:18">ነ ሳሮተይ ሻፋ ሃዳ ጎጋናሽን፤</para>
  <para style="q2" vid="ISA 48:18">ነ ፅሎተይ አባ ቤታዳ ሀናናሽን።<verse eid="ISA 48:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 48:19"/>ነ ኮቻይ አባ ሻፈዳ፥</para>
  <para style="q2" vid="ISA 48:19">ነ ናይት ታይበቶና ባና መላ ዳራናሽን፤</para>
  <para style="q2" vid="ISA 48:19">ኤንታ ሱንይ ታ ስንፈ የና፤ ክቸናሽን” ያጌስ።<verse eid="ISA 48:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 48:20"/>ባብሎነ ቢታፈ ከይተ፤<note caller="-" style="x"><char style="xo" closed="false">48:20 </char><char style="xt" closed="false"><ref loc="REV 18:4">ቆን 18:4</ref>.</char></note></para>
  <para style="q2" vid="ISA 48:20">ባብሎነፐ ባቃትተ!</para>
  <para style="q1" vid="ISA 48:20">ቃላ ቁ ኦድ፥</para>
  <para style="q2" vid="ISA 48:20">ኡፋይሳን ሀይሳዳ ያግድ ዋስተ።</para>
  <para style="q1" vid="ISA 48:20">ሳኣ ጋፃፐ ጋፃ ጋካናዉ ሀይሳ ኪትተ፤</para>
  <para style="q2" vid="ISA 48:20">“ጎዳይ ባ አይልያ ያይቆባ ዎዝስ” ያግድ ኦድተ።<verse eid="ISA 48:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 48:21"/>እ ኤንታ መላ ቢታራ ካለዳ ዎደ</para>
  <para style="q2" vid="ISA 48:21">ሳሞትቦኮና።</para>
  <para style="q1" vid="ISA 48:21">ዛላፈ ሃ ኤንታዉ ፑልትስ፤</para>
  <para style="q2" vid="ISA 48:21">እ ዛላ ጳልቅን ሃ ቅስ። <verse eid="ISA 48:21"/><verse number="22" style="v" sid="ISA 48:22"/>“ኢታታስ ሳሮይ ባዋ” ያጌስ ጎዳይ።<note caller="-" style="x"><char style="xo" closed="false">48:22 </char><char style="xt" closed="false"><ref loc="ISA 57:21">እሳ 57:21</ref>.</char></note><verse eid="ISA 48:22"/></para>
  <chapter eid="ISA 48"/>
  <chapter number="49" style="c" sid="ISA 49"/>
  <para style="s1">ጎዳ አይለ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 49:1"/>ህንተኖ፥ ዩሾይ አባን ተቀትዳ ቢታቶ፥</para>
  <para style="q2" vid="ISA 49:1">ታኒ ኦደይሳ ስእተ።</para>
  <para style="q1" vid="ISA 49:1">ህንተኖ፥ ሃሆሶን ደእያ ካዎተቶ አኬክተ፤</para>
  <para style="q2" vid="ISA 49:1">ታኒ የለታናፐ ካሰ ጎዳይ ታና ፄግስ፤</para>
  <para style="q2" vid="ISA 49:1">ታ አየ ኡሎን ደእሽን፥ ታ ሱን ሱንስ።<verse eid="ISA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 49:2"/>ታ እንፃርሳ ቃራ ማሽ ኦስ፤</para>
  <para style="q2" vid="ISA 49:2">ባ ኩሽያ ኩያን ታና ገንስ።</para>
  <para style="q1" vid="ISA 49:2">እ ታና ፖሸትዳ ዶንገ ዪሽ ኦድ</para>
  <para style="q2" vid="ISA 49:2">ባ ሾሁዋን ታና ቆትስ።<verse eid="ISA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 49:3"/>እ ታኮ፥ “እስራኤለ፥ ኔኒ ታ አይለ፤</para>
  <para style="q2" vid="ISA 49:3">ታኒ ታ ቦንቹዋ ነናን ቆንጭሳና” ያግስ።<verse eid="ISA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 49:4"/>ሽን ታኒ፥ “ታኒ ጮ ዳቡራስ፤</para>
  <para style="q2" vid="ISA 49:4">ታ ዎልቃ ጎእ ባይናባንነ ሀዳባን ዉርሳስ።</para>
  <para style="q1" vid="ISA 49:4">ግዶሽን፥ ታ ፕርዳይ ጎዳ ማታና፤</para>
  <para style="q2" vid="ISA 49:4">ታ ጋተይ ታ ፆሳ ማታና” ያጋስ።<verse eid="ISA 49:4"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="5" style="v" sid="ISA 49:5"/>ታኒ ጎዳ አይፈ ስንን ቦንቸትዳ ግሾ፥</para>
  <para style="q2" vid="ISA 49:5">ታ ፆሳይ ታዉ ዎልቃ ግድዳ ግሾ፥</para>
  <para style="q1" vid="ISA 49:5">ያይቆባ እያኮ ዛራናዉ</para>
  <para style="q2" vid="ISA 49:5">እስራኤለ እያኮ ሺሻናዉ፥</para>
  <para style="q2" vid="ISA 49:5">ታኒ እያ አይለ ግዳና መላ</para>
  <para style="q2" vid="ISA 49:5">ታና ታ አየ ኡሎን ዶርዳ<verse eid="ISA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 49:6"/>ጎዳይ ታኮ ሀይሳዳ ያጌስ፤</para>
  <para style="q2" vid="ISA 49:6">ኔኒ ያይቆባ ኮቻ ደንናዉ</para>
  <para style="q2" vid="ISA 49:6">እስራኤለፐ አትዳ ጉታ ዛራዳ ኤሀናዉ</para>
  <para style="q2" vid="ISA 49:6">ኔኒ ታዉ አይለ ግደይስ ዳሮ ጉባ።</para>
  <para style="q1" vid="ISA 49:6">ሄሳፈ አዳ፥ ታ አቶተይ ቢታ ጋፃ ጋካና መላ</para>
  <para style="q2" vid="ISA 49:6">ታኒ ነና ካዎተታስ ፖኦ ኦና።<verse eid="ISA 49:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 49:7"/>ካትዳይሳስነ እፀትዳይሳስ</para>
  <para style="q2" vid="ISA 49:7">ቃስ ካዎተታ ሃርያ አይልያስ፥</para>
  <para style="q1" vid="ISA 49:7">እስራኤለ ዎዝያ ጎዳይ፥</para>
  <para style="q2" vid="ISA 49:7">እስራኤለ ጌሻይ ሀይሳዳ ያጌስ፤</para>
  <para style="q1" vid="ISA 49:7">አማንያ ጎዳ ግሾ፥</para>
  <para style="q2" vid="ISA 49:7">ነና ዶርዳ እስራኤለ ጌሻ ግሾ</para>
  <para style="q2" vid="ISA 49:7">ካዎት በእድ ደንድ ኤቃና፤</para>
  <para style="q2" vid="ISA 49:7">ደርያ ሃረይሳት በእድ ጎይናና።<verse eid="ISA 49:7"/></para>
  <para style="s1">የሩሳላመይ ኦራፃና</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8"/>ጎዳይ ያጌስ፤</para>
  <para style="q1" vid="ISA 49:8">“ታኒ ዶርዳ ዎደን ነ ኦይሻ ዛራና፤</para>
  <para style="q2" vid="ISA 49:8">አቶተ ጋላስ ታኒ ነና ማዳና።</para>
  <para style="q1" vid="ISA 49:8">ታኒ ነና ናጋና፤</para>
  <para style="q2" vid="ISA 49:8">ኔኒ ቢታ ዛራዳ ኤሳና መላ፤</para>
  <para style="q2" vid="ISA 49:8">አስ ዶና ቢታ ኔኒ ላትሳና መላ</para>
  <para style="q2" vid="ISA 49:8">ታኒ ነና አሳስ ጫቆ ኦዳ እማስ።<verse eid="ISA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 49:9"/>ድኤትዳይሳታ፥ ‘ከይተ!’</para>
  <para style="q2" vid="ISA 49:9">ማ ቃሾን ደኤይሳታ፥ ‘ብርሸትተ!’</para>
  <para style="q2" vid="ISA 49:9">ጋና መላ ታኒ ነና ኦና።</para>
  <para style="q1" vid="ISA 49:9">ኤንቲ ኦገ ማታን ሄመታና፤</para>
  <para style="q2" vid="ISA 49:9">መላ ደረ ቦላ ሄመትያ በሲ ደማና።<verse eid="ISA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 49:10"/>ኤንቲ ኮሻቶኮና ዎይኮ ሳሞቶኮና፤</para>
  <para style="q2" vid="ISA 49:10">ኤንታ መላ ቢታ ምሻይ ፁገና፤</para>
  <para style="q2" vid="ISA 49:10">አዋይ ኤንታ ሜና።</para>
  <para style="q1" vid="ISA 49:10">ኤንታዉ ቃተይስ ኤንታ ካለና፤</para>
  <para style="q2" vid="ISA 49:10">ፑልቶ ሃኮ ኤንታ ላጋና።<verse eid="ISA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 49:11"/>ታኒ ታ ደረታ ኡባ ኦገ ከሳና፤</para>
  <para style="q2" vid="ISA 49:11">ታ ዎጋ ኦገታ ቁ ኦና።<verse eid="ISA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 49:12"/>ሄኮ፥ ታ አሳይ ሃሆሶፐ ያና፦</para>
  <para style="q2" vid="ISA 49:12">ፑደሀ ባጋፈነ ዉሎሀ ባጋፈ፥</para>
  <para style="q2" vid="ISA 49:12">ቃስ አስዋና ቢታፈ ያና” ያጌስ።<verse eid="ISA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 49:13"/>ህንተኖ ሳሎቶ፥ ኡፋይሳን የፅተ፤</para>
  <para style="q2" vid="ISA 49:13">ነኖ ቢታዉ ኡፋይታ።</para>
  <para style="q1" vid="ISA 49:13">ህንተኖ ደረቶ፥ እልልተ!</para>
  <para style="q2" vid="ISA 49:13">ጎዳይ ባ አሳ ምንስ፤</para>
  <para style="q2" vid="ISA 49:13">ባ መቶተትዳ ባ አሳስ ቃትስ።<verse eid="ISA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 49:14"/>ሽን ፅዮነይ፥ “ጎዳይ ታና አግስ፤</para>
  <para style="q2" vid="ISA 49:14">ፆሳይ ታና ዶግስ” ያጋሱ።<verse eid="ISA 49:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 49:15"/>አይያ ባ ንያ ናኣ ዶጋናዉ ዳንዳአይ?</para>
  <para style="q2" vid="ISA 49:15">ባ ኡሎፐ ከይዳ ናአስ ቃተኬ?</para>
  <para style="q2" vid="ISA 49:15">እያ ዶግኮካ፥ ታኒ ነና ዶግከ!<verse eid="ISA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 49:16"/>ሄኮ፥ ታኒ ነና ታ ኩሸ ቃቃን ፃፋ ዎስ፤</para>
  <para style="q2" vid="ISA 49:16">ነ ድርሳ ግምበት ኡባ ዎደ ታ ስንን ደኦሶና።<verse eid="ISA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 49:17"/>ነና ዛሪድ ኬፀይሳት ኤለስድ ያና፤</para>
  <para style="q2" vid="ISA 49:17">ነና ላልዳይሳት ኔፐ ሃካና።<verse eid="ISA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 49:18"/>አነ ቁ ጋዳ ነ ዩሹዋ ፄላ፤</para>
  <para style="q2" vid="ISA 49:18">ነ ናይት ኡባይ እስፈ ሺቅድ ኔኮ ያና።</para>
  <para style="q1" vid="ISA 49:18">ታኒ ጎዳይ፥ ታናን ጫቃስ፦</para>
  <para style="q2" vid="ISA 49:18">ኔኒ ኤንታ ኡባ አሌቆዳ ማአና፤</para>
  <para style="q2" vid="ISA 49:18">ገላናዉ ሀንያ ማጫስ አሌቀተይሳዳ</para>
  <para style="q2" vid="ISA 49:18">ኔኒ ኤንታን አሌቀታና።<verse eid="ISA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 49:19"/>ኔኒ ላለታዳ ባይሳ ግድኮካ፥</para>
  <para style="q2" vid="ISA 49:19">ነ ቢታይ ይኮካ፥</para>
  <para style="q2" vid="ISA 49:19">ሀእ ነናን ደእያ አሳስ ዳሮ ፁማና፤</para>
  <para style="q2" vid="ISA 49:19">ነና ላልዳይሳት ኔፐ ሃካና።<verse eid="ISA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 49:20"/>ኔኒ ካዮትያ ላይን</para>
  <para style="q2" vid="ISA 49:20">ነዉ የለትዳ ናይት ነ ሀይን፥</para>
  <para style="q1" vid="ISA 49:20">“ሀይስ በሳይ ኑስ ዳሮ ፁን ግድያ ግሾ፥</para>
  <para style="q2" vid="ISA 49:20">ኑ ዳና ዳልጋ በሲ እማ” ያጋና።<verse eid="ISA 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 49:21"/>ኔኒ ነ ዎዛናን፥ “ሀ ናይታ ኡባ ታዉ ኦነ የልዳይ?</para>
  <para style="q2" vid="ISA 49:21">ታኒ የላዳ ን ግዳስ፤ ታኒ ድኤታስ፥ እፀታስ።</para>
  <para style="q1" vid="ISA 49:21">ያትን፥ ሀይሳታ ኦነ ድችዳይ?</para>
  <para style="q1" vid="ISA 49:21">ታኒ ታርካ አታስ፤</para>
  <para style="q2" vid="ISA 49:21">ያትን ሀ ናይት ኡባይ አዉፐ ይዶና? ያጋና።”<verse eid="ISA 49:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 49:22"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q2" vid="ISA 49:22">“ሄኮ፥ ታኒ ካዎተታ ማላታ በሳና፤</para>
  <para style="q2" vid="ISA 49:22">አሳስ ታ ባንድራ ኤሳና።</para>
  <para style="q1" vid="ISA 49:22">ኤንቲ ነ አደ ናይታ እድምድ፥</para>
  <para style="q2" vid="ISA 49:22">ነ ማጫ ናይታ ባንታ ሀሽያን ቶክድ ኤሀና።<verse eid="ISA 49:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 49:23"/>ካዎት ነና ድችያ አዋታ ግዳና፤</para>
  <para style="q2" vid="ISA 49:23">ኤንታ ማጫ ካዎት ነና ንያ አዮ ግዳና።</para>
  <para style="q1" vid="ISA 49:23">ኤንቲ ጉፋንድ ነዉ ጎይናና፤</para>
  <para style="q2" vid="ISA 49:23">ነ ቶሆ ባና ላጫና።</para>
  <para style="q1" vid="ISA 49:23">ታኒ ጎዳ ግደይሳ ኔኒ ሄሳን ኤራና፤</para>
  <para style="q2" vid="ISA 49:23">ታናን አማነትድ ናገይሳት ዬላቶኮና” ያጌስ።<verse eid="ISA 49:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 49:24"/>ኦላንቹዋፈ ድኦ የግሳናዉ፥</para>
  <para style="q2" vid="ISA 49:24">ዎዛን ኢታ አሳ ኩሸፐ ድኤትዳ አስ</para>
  <para style="q2" vid="ISA 49:24">ከስ ኤካናዉ ዳንዳኤትዬ?<verse eid="ISA 49:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 49:25"/>ሽን ጎዳይ ያጌስ፦</para>
  <para style="q2" vid="ISA 49:25">ኦላንቾ ኩሸፐ ድኤትዳ አስ ከስ ኤካናዉ፥</para>
  <para style="q2" vid="ISA 49:25">ዎዛና ምኖ አሳፐ ድኦ የግሳናዉ ዳንዳኤቴስ።</para>
  <para style="q1" vid="ISA 49:25">ኔራ ኦለተይሳታራ ታኒ ኦለታና፤</para>
  <para style="q2" vid="ISA 49:25">ነ ናይታካ አሻና።<verse eid="ISA 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 49:26"/>ነና ኡንኤይሳት ባንታ አሹዋ ማና መላ ኦና፤</para>
  <para style="q2" vid="ISA 49:26">ዎይነ ኡይድ ማተይሳዳ</para>
  <para style="q2" vid="ISA 49:26">ኤንቲ ባንታ ሱ ኡይድ ማታና።</para>
  <para style="q1" vid="ISA 49:26">ሄ ዎደ አሳ ኡባይ ታኒ ጎዳ፥</para>
  <para style="q2" vid="ISA 49:26">ነና አሽያ፥ ዎዝያነ ያይቆባ ዎልቃማ</para>
  <para style="q2" vid="ISA 49:26">ግደይሳ ኤራና።<verse eid="ISA 49:26"/></para>
  <chapter eid="ISA 49"/>
  <chapter number="50" style="c" sid="ISA 50"/>
  <para style="s1">እስራኤለ ናጋራነ አይልያ ኪተተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1"/>ጎዳይ ያጌስ፤</para>
  <para style="q2" vid="ISA 50:1">“ታኒ ህንተ አይዉ የድዳ ፕርማ ዎርቃተይ አዉን ደኢ?</para>
  <para style="q2" vid="ISA 50:1">ታኒ ኦደስ ህንተና ባይዛድና?</para>
  <para style="q1" vid="ISA 50:1">ሄኮ፥ ህንተ ናጋራ ግሾ ህንተ ባይዘትደታ፤</para>
  <para style="q2" vid="ISA 50:1">ህንተ ናቁዋ ግሾ ህንተ አይያ የደታሱ።<verse eid="ISA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 50:2"/>ታኒ ይዳ ዎደ፥ ሀይሳን አስ አይስ ይዴ?</para>
  <para style="q2" vid="ISA 50:2">ታኒ ፄግዳ ዎደ፥ ‘ዬ!’ ጋናዉ አይስ አስ ይዴ?</para>
  <para style="q1" vid="ISA 50:2">ታኒ ህንተና ዎዛናዉ ታ ኩሸይ ቃንዬ?</para>
  <para style="q2" vid="ISA 50:2">ህንተና አሻናዉ ታዉ ዎልቅ ባወዬ?</para>
  <para style="q1" vid="ISA 50:2">ታኒ አባ ሴራዳ መልሳይስ፤</para>
  <para style="q2" vid="ISA 50:2">ሻፋታ መላ ቢታ ኦይስ።</para>
  <para style="q1" vid="ISA 50:2">ሃ ይን ኤንታን ደእያ ሞሎት ዎቆሶና፤</para>
  <para style="q2" vid="ISA 50:2">ሳሞይ ዎን ሀይቆሶና።<verse eid="ISA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 50:3"/>ታኒ ሳሎታ ማ ማይዛይስ፤</para>
  <para style="q2" vid="ISA 50:3">ኤንታ ካማይ ካዮ ማኦ ዳኔስ” ያግስ።<verse eid="ISA 50:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 50:4"/>ዳቡርዳይሳ ታኒ ቃላን ምን ኤራና መላ፥</para>
  <para style="q2" vid="ISA 50:4">ኡባ ሃርያ ጎዳይ ታዉ ታማርዳ እንፃርስ እሚስ።</para>
  <para style="q1" vid="ISA 50:4">እ ታና ዎንታ ዎንታ ባርክስድ፥</para>
  <para style="q2" vid="ISA 50:4">ታኒ ታማረዳ ስአናዳ ታ ሀይ ዶዬስ።<verse eid="ISA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 50:5"/>ኡባ ሃርያ ጎዳይ ታ ሀይ ዶይስ፤</para>
  <para style="q2" vid="ISA 50:5">ታኒ ጌላ ግዳብከ፤ ጉየ ስማብከ።<verse eid="ISA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 50:6"/>ታኒ ታ ዞኩዋ ሾጨይሳታስ፥</para>
  <para style="q2" vid="ISA 50:6">ታ ቡቻ ሾደይሳታስ</para>
  <para style="q2" vid="ISA 50:6">ታ ጋጩዋ አዳ እማስ።</para>
  <para style="q1" vid="ISA 50:6">ታ ቦላ ጩተይሳታፐነ ታና ካዉሸይሳታፐ</para>
  <para style="q2" vid="ISA 50:6">ታ ሶምኡዋ ገንብከ።<verse eid="ISA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 50:7"/>ኡባ ሃርያ ጎዳይ ታና ማድያ ግሾ፥</para>
  <para style="q2" vid="ISA 50:7">ታኒ ዬላትከ።</para>
  <para style="q1" vid="ISA 50:7">ታኒ ታ ሶምኡዋ ሳሎ ሹቹ ኦስ፤</para>
  <para style="q2" vid="ISA 50:7">ታኒ ዬላቶናይሳ ኤራይስ።<verse eid="ISA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 50:8"/>ታዉ ፕርደይስ ማታን ደኤስ፤</para>
  <para style="q2" vid="ISA 50:8">ያትን፥ ታና ሞተይ ኦኔ?</para>
  <para style="q2" vid="ISA 50:8">አነ ታራ ሞተታናዉ ኤቆ!<verse eid="ISA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 50:9"/>ኡባ ሃርያ ጎዳይ ታና ማዴስ፤</para>
  <para style="q2" vid="ISA 50:9">ያትን፥ ታ ቦላ ፕርደይ ኦኔ?</para>
  <para style="q1" vid="ISA 50:9">ኤንቲ ኡባይ ማኦዳ ጭማና፤</para>
  <para style="q2" vid="ISA 50:9">ኤንታ ብል ማና።<verse eid="ISA 50:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 50:10"/>ህንተ ግዶፈ ጎዳ ያየይ፥</para>
  <para style="q2" vid="ISA 50:10">እያ አይልያ ቃላስ ኪተተይ ኦኔ?</para>
  <para style="q1" vid="ISA 50:10">ማን ሄመተይነ ፖኦይ ባይናይ እ ኦኔ?</para>
  <para style="q2" vid="ISA 50:10">ሄ ኡራይ ጎዳ ሱንን አማነቶ፤ ባ ፆሳን ዘምፖ።<verse eid="ISA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 50:11"/>ህንተኖ ታማ ኤያ ኡባቶ፥</para>
  <para style="q2" vid="ISA 50:11">ላጮ ፆምፐ ህንተዉ ሺሸይሳቶ፥</para>
  <para style="q2" vid="ISA 50:11">ህንተ ኤዳ ታማ ፖኡዋን ሄመትተ።</para>
  <para style="q1" vid="ISA 50:11">ላጮ ፆምፕያን ስመረትተ፤</para>
  <para style="q2" vid="ISA 50:11">ህንተ ታ ኩሸፐ ኤካናዉ ደኤይ ሀይሳ፤</para>
  <para style="q2" vid="ISA 50:11">ህንተ ዎልቃማ መቶ ሴላን ዝንአና።<verse eid="ISA 50:11"/></para>
  <chapter eid="ISA 50"/>
  <chapter number="51" style="c" sid="ISA 51"/>
  <para style="s1">መርና አቶተ ፅዮነስ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 51:1"/>ህንተኖ ፅሎተ ካለይሳቶ፥</para>
  <para style="q2" vid="ISA 51:1">ህንተኖ ጎዳ ኮየይሳቶ ስእተ።</para>
  <para style="q1" vid="ISA 51:1">ህንተ ጳልቀትድ ኤከትዳ ሹቻ</para>
  <para style="q2" vid="ISA 51:1">ህንተ ቦከትድ ከይዳ ኦላ ፄልተ።<verse eid="ISA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 51:2"/>ህንተ አዋ አብራሃመነ</para>
  <para style="q2" vid="ISA 51:2">ህንተና የልዳ ሳሮ ፄልተ።</para>
  <para style="q1" vid="ISA 51:2">እ ባርካ ደእሽን፥ ታኒ እያ ፄጋዳ</para>
  <para style="q2" vid="ISA 51:2">አንጃስነ ታይቦን ዳርሳስ።<verse eid="ISA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 51:3"/>“ጎዳይ ፅዮነነ</para>
  <para style="q2" vid="ISA 51:3">ላለትዳ በሳን ደእያ አሳ ኡባ ምንና።</para>
  <para style="q1" vid="ISA 51:3">እ መላ ቢታ ኤደነ፥</para>
  <para style="q2" vid="ISA 51:3">ካሎትዳ ቢታ ጎዳ አታክልተ ጋደዳ ኦና።</para>
  <para style="q1" vid="ISA 51:3">ያን ኡፋይስነ ሀሹ ጉስ ዳና፤</para>
  <para style="q2" vid="ISA 51:3">ጋላትነ ማዝሙረይ ስኤታና።<verse eid="ISA 51:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 51:4"/>“ታ አሳዉ፤ ታ ኦድያባ ስእተ፤</para>
  <para style="q2" vid="ISA 51:4">ታ ደርያዉ፥ ህንተ ሀይ ታኮ ዛርተ።</para>
  <para style="q1" vid="ISA 51:4">ህገይ ታፐ ከዬስ፤</para>
  <para style="q2" vid="ISA 51:4">ታ ሱረ ፕርዳይ ካዎተታስ ፖኦ ግዳና።<verse eid="ISA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 51:5"/>ታ ፅሎተይ ኤለስድ ሺቃና፤ ታ አቶተይ ማትስ፤</para>
  <para style="q2" vid="ISA 51:5">ታ ቀሰይ ካዎተታስ ሱረ ፕርዳ ኤሀና።</para>
  <para style="q1" vid="ISA 51:5">ዩሾይ አባን ተቀትዳ ቢታት ኡባይ</para>
  <para style="q2" vid="ISA 51:5">ታናን አማነትድ ናጋና፤</para>
  <para style="q2" vid="ISA 51:5">ታኒ ኤንታ ታ ዎልቃን አሻናይሳ ኡፋይሳን ናጋና።<verse eid="ISA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 51:6"/>ፑደ ቁ ግድ ሳሎታ ፄልተ፤</para>
  <para style="q2" vid="ISA 51:6">ዱገ ሳኣካ ፄልተ።</para>
  <para style="q1" vid="ISA 51:6">ሳሎት ጩያዳ ላለትድ ያና፤</para>
  <para style="q2" vid="ISA 51:6">ሳእ አፍላዳ ዉራና፤</para>
  <para style="q2" vid="ISA 51:6">እያን ደእያ አሳ ኡባይ ኡዱንፀዳ ሀይቃና።</para>
  <para style="q1" vid="ISA 51:6">ሽን ታ አቶተይ መርናዉ ዳና፤</para>
  <para style="q2" vid="ISA 51:6">ታ ፅሎተይ ዉረና።<verse eid="ISA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 51:7"/>“ህንተኖ ፅሎተ ኤረይሳቶ፥</para>
  <para style="q2" vid="ISA 51:7">ታ ህገይ ህንተ ዎዛናን ደኤይሳቶ፥ ስእተ።</para>
  <para style="q1" vid="ISA 51:7">አሳ ቦረ ያዮፍተ፤</para>
  <para style="q2" vid="ISA 51:7">ኤንታ ጫሻስ ዳጋሞፕተ።<verse eid="ISA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 51:8"/>ብል ማኦ፥ ዶርሳ እክሰ ጉፁነይ መይሳዳ፥</para>
  <para style="q2" vid="ISA 51:8">ኤንቲ ሜተታና።</para>
  <para style="q1" vid="ISA 51:8">ሽን ታ ፅሎተይ መርናዉ ዳና፤</para>
  <para style="q2" vid="ISA 51:8">ታ አቶተይ የለተ ኡባስ ግዳና” ያጌስ።<verse eid="ISA 51:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 51:9"/>አቤት ጎዳዉ፥ ደንዳ! ደንዳ!</para>
  <para style="q2" vid="ISA 51:9">ጎዳ ቀስያዉ፥ ዎልቃ ማአ።</para>
  <para style="q1" vid="ISA 51:9">በን ዎደታንነ የለተን ሀንዳይሳዳ ደንዳ፤</para>
  <para style="q2" vid="ISA 51:9">ራኣባ ጌተትያ ዳውያ ቃንፀረዳይነ</para>
  <para style="q2" vid="ISA 51:9">ጫድዳይ ነና ግድክዬ?<verse eid="ISA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 51:10"/>አባነ ግታ ጪሞ ሃ</para>
  <para style="q2" vid="ISA 51:10">መልስዳይ ነና ግድክዬ?</para>
  <para style="q1" vid="ISA 51:10">ነ ዎዝዳይሳት ፕናና መላ</para>
  <para style="q2" vid="ISA 51:10">ጪሞ አባ ኦገ ኦዳይ ነና ግድክዬ?<verse eid="ISA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 51:11"/>ጎዳይ ዎዝዳይሳት የፅሸ ስሚድ ፅዮነ ያና፤</para>
  <para style="q2" vid="ISA 51:11">መርና ኡፋይሳይ ካላቻ መላ ኤንታ ቦላ ኡታና።</para>
  <para style="q1" vid="ISA 51:11">ኤንቲ ኡፋይስነ ሀሹ ግያባ ደማና፤</para>
  <para style="q2" vid="ISA 51:11">አዛኖይነ ዬሆይ ኤንታፈ ሃካና።<verse eid="ISA 51:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 51:12"/>ጎዳይ፥ “ታኒ፥ ህንተና ምንይ ታና፤</para>
  <para style="q2" vid="ISA 51:12">ያትን፥ ሀይቅያ አሰነ ማታዳ ሹልያ</para>
  <para style="q2" vid="ISA 51:12">አሳ ናአ ያያናዉ ህንተ ኦኔ?<verse eid="ISA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 51:13"/>ሳሎታ ምጭዳነ ሳአ ባሱዋ ኤስዳ ጎዳ፥</para>
  <para style="q2" vid="ISA 51:13">ህንተና መዳ ፆሳ ዶግደታ።</para>
  <para style="q1" vid="ISA 51:13">ኤንቲ ህንተና ይሳናዉ ኡንኤያ</para>
  <para style="q2" vid="ISA 51:13">አሳ ሀንቁዋ ጋሶን ኡባ ጋላስ ያሻን ደኤታ።</para>
  <para style="q1" vid="ISA 51:13">ሽን ህንተና ኡንኤይሳታ ሀንቆይ አዉን ደኢ?<verse eid="ISA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 51:14"/>ድኤትዳይሳት ኤሶን ብርሸታና፤</para>
  <para style="q2" vid="ISA 51:14">ቃሸትዳ ኦላን ሀይቆኮና፤ ኮሻቶኮና።”<verse eid="ISA 51:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 51:15"/>“ታኒ ጎዳ፥ ነ ፆሳ፤</para>
  <para style="q2" vid="ISA 51:15">ጉማና መላ አባ ቃይ ታና፤</para>
  <para style="q2" vid="ISA 51:15">ታ ሱንይ ኡባፈ ዎልቃማ ጎዳ።<verse eid="ISA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 51:16"/>ታ ቃላ ነ ዶናን ዎዳይ፥</para>
  <para style="q2" vid="ISA 51:16">ታ ኩሸ ኩያን ነና ገንዳይ፥</para>
  <para style="q2" vid="ISA 51:16">ሳሎታ ምጭዳይ፥ ሳኣ ባሱዋ ኤስዳይ፥</para>
  <para style="q2" vid="ISA 51:16">ፅዮነኮ፥ ‘ኔኒ ታ አሰ’ ” ያግዳይ ታና።<verse eid="ISA 51:16"/></para>
  <para style="s1">ፆሳ ሀንቆ ፁአ</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 51:17"/>ነኖ፥ ጎዳ ኩሸፐ ጋንድጋርስያ</para>
  <para style="q2" vid="ISA 51:17">ሀንቆ ፁኣ አሾና ኡይዳ የሩሳላመ፥</para>
  <para style="q2" vid="ISA 51:17">ባርካ! ደንዳ! ደንዳ።<note caller="-" style="x"><char style="xo" closed="false">51:17 </char><char style="xt" closed="false"><ref loc="REV 14:10">ቆን 14:10</ref>፤ <ref loc="REV 16:19">16:19</ref>.</char></note><verse eid="ISA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 51:18"/>እያ የልዳ ናይታፐ እዮ ካለያ እሶይካ ባዋ፤</para>
  <para style="q2" vid="ISA 51:18">እያ ድችዳ ናይታፐ እ ኩሽያ ኦይክድ</para>
  <para style="q2" vid="ISA 51:18">ኤፍዳ እሶይካ ባዋ።<verse eid="ISA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 51:19"/>ሀ ናምኡባት ነ ቃዳ ግድዶሶና፤</para>
  <para style="q2" vid="ISA 51:19">ሄሳት ላለተነ ዮ፤</para>
  <para style="q2" vid="ISA 51:19">ኮሽነ ማሽ ነ ቦላ ያና፤</para>
  <para style="q2" vid="ISA 51:19">ያትን፥ ነና ኦን ምንኔ?<verse eid="ISA 51:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 51:20"/>ነ ናይት ግተን ገልዳ ገንኤዳ</para>
  <para style="q2" vid="ISA 51:20">ኦገ ጋፃን ኩንድድ ላባንዶሶና።</para>
  <para style="q1" vid="ISA 51:20">ኤንቲ ጎዳ ሀንቁዋንነ</para>
  <para style="q2" vid="ISA 51:20">ነ ፆሳ ሴራን ኩምዶሶና።<verse eid="ISA 51:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 51:21"/>ሄሳ ግሾ፥ ዎይነ ኡሻን ግዶናሽን</para>
  <para style="q2" vid="ISA 51:21">መቶን ማትዳይሳቶ፥ ህንተ ሀይሳ ስእተ።<verse eid="ISA 51:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 51:22"/>“ባ አሳስ ሞተትያ ነ ጎዳይ፥</para>
  <para style="q2" vid="ISA 51:22">ነ ፆሳይ ያጌስ፤</para>
  <para style="q1" vid="ISA 51:22">ሄኮ፥ ነና ጋንድጋርስያ፥</para>
  <para style="q2" vid="ISA 51:22">ታ ሀንቆ ፁኣ ታኒ ነ ኩሸፐ ኤካስ፤</para>
  <para style="q2" vid="ISA 51:22">ኔኒ ዛራዳ ሄ ማይያ ኡሻ ኡያካ።<verse eid="ISA 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 51:23"/>ታኒ ሄሳ ነና ኡንኤያ</para>
  <para style="q2" vid="ISA 51:23">አሳ ኩሸን ዎና፤</para>
  <para style="q1" vid="ISA 51:23">ኤንቲ ኔኮ፥ ‘ኑኒ ነ ቦላራ ሄመትድ</para>
  <para style="q2" vid="ISA 51:23">አና መላ ዛቁላ’ ” ያግዶሶና።</para>
  <para style="q1" vid="ISA 51:23">ኔኒ ኤንቲ አና ጋካናዉ</para>
  <para style="q2" vid="ISA 51:23">ነ ዞኩዋ ኤንታዉ ቢታዳነ ኦገዳ ኦዳሳ።<verse eid="ISA 51:23"/></para>
  <chapter eid="ISA 51"/>
  <chapter number="52" style="c" sid="ISA 52"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 52:1"/>ነኖ ፅዮነ፥ ባርካ፤ ባርካ፥</para>
  <para style="q2" vid="ISA 52:1">ምኖተ አፍላዳ ማአ።</para>
  <para style="q1" vid="ISA 52:1">ነኖ ጌሻ ካታመ፥ የሩሳላመ፥</para>
  <para style="q2" vid="ISA 52:1">ነ ቦንቾ ማኡዋ ማአ።<note caller="-" style="x"><char style="xo" closed="false">52:1 </char><char style="xt" closed="false"><ref loc="REV 21:2">ቆን 21:2</ref>፥ <ref loc="REV 21:27">27</ref>.</char></note></para>
  <para style="q1" vid="ISA 52:1">ህዛፐ ጉየ ቃፃረቶናይነ</para>
  <para style="q2" vid="ISA 52:1">ቱን ነ ግዶ ገለና።<verse eid="ISA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 52:2"/>ነኖ፥ ድኤትዳ የሩሳላመ፥ ነ ባና ቆቆፋ፤</para>
  <para style="q2" vid="ISA 52:2">ደንዳዳ ነ አራታ ቦላ ኡታ።</para>
  <para style="q1" vid="ISA 52:2">ነኖ ፅዮነ አሳዉ፥</para>
  <para style="q2" vid="ISA 52:2">ነ ቆን ቃሸትዳ ሳንላታ ብርሻ።<verse eid="ISA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 52:3"/>ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q1" vid="ISA 52:3">“ህንተ ካሰ ጋተይ ባይና ባይዘትደታ፤</para>
  <para style="q2" vid="ISA 52:3">ሀእ ቃስ ሚሸ እሞና ጮ ዎዘታና።<verse eid="ISA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 52:4"/>ጎዳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q1" vid="ISA 52:4">ታ አሳይ ኮይሮ በተ አስ ግድድ ግብፀ ብስ፤</para>
  <para style="q2" vid="ISA 52:4">ጉየፐ አሶረት ታ አሳ ጮ ኡንኤዶሶና።<verse eid="ISA 52:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 52:5"/>ፆሳይ ሀይሳዳ ያግድ ኦዴስ፦</para>
  <para style="q1" vid="ISA 52:5">ታ አሳይ ጋተይ ባይና ጮ ድኤትድ ብን፥</para>
  <para style="q2" vid="ISA 52:5">ታዉ ሀይሳን አይበ ደኤይ?</para>
  <para style="q1" vid="ISA 52:5">ኤንታ ሃረይሳት ቶቾሶና፤</para>
  <para style="q2" vid="ISA 52:5">ታ ሱንይ ኡባ ዎደ ጫየቴስ።<note caller="-" style="x"><char style="xo" closed="false">52:5 </char><char style="xt" closed="false"><ref loc="ROM 2:24">ሮመ 2:24</ref>.</char></note><verse eid="ISA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 52:6"/>ሄሳ ግሾ፥ ታ አሳይ ታ ሱን ኤራና፤</para>
  <para style="q2" vid="ISA 52:6">ሄ ጋላስ ሀይሳ ኦደይ ታና ግደይሳ ኤንቲ ኤራና፤</para>
  <para style="q2" vid="ISA 52:6">ኤ፥ እ ታና” ያጌስ ኡባ ሃርያ ጎዳይ።<verse eid="ISA 52:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 52:7"/>ሎኦ ምሽራቾ ኤህያ፥</para>
  <para style="q2" vid="ISA 52:7">ሳሮተ አዋጅያ፥ አቶተ ኦድያ፥</para>
  <para style="q1" vid="ISA 52:7">ፅዮነኮ፥ “ነ ፆሳይ ካዎትስ” ያግሸ</para>
  <para style="q2" vid="ISA 52:7">ደርያ ቦላራ ያ ቶሆት ዋን ሎኦና።<verse eid="ISA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 52:8"/>ነ ካታማ ናገይሳት ባንታ ቃላ ቁ ኦድ፥</para>
  <para style="q2" vid="ISA 52:8">ኡፋይሳን እስፈ የፆሶና።</para>
  <para style="q1" vid="ISA 52:8">ጎዳይ ፅዮነ ስምያ ዎደ</para>
  <para style="q2" vid="ISA 52:8">ኤንቲ ባንታ አይፈን በአና።<verse eid="ISA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 52:9"/>ህንተኖ የሩሳላመን ላለትዳ በሳቶ፥</para>
  <para style="q2" vid="ISA 52:9">እስፈ ኡፋይሳን የፅተ፤</para>
  <para style="q1" vid="ISA 52:9">ጎዳይ ባ አሳ ምንስ፤</para>
  <para style="q2" vid="ISA 52:9">የሩሳላመ ዎዝስ።<verse eid="ISA 52:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 52:10"/>ጎዳይ ባ ጌሻ ቀስያ</para>
  <para style="q2" vid="ISA 52:10">ካዎተታ ኡባ ስንን ቆንጭስስ።</para>
  <para style="q1" vid="ISA 52:10">ቢታ ጋፃ ጋካናዉ ደእያ</para>
  <para style="q2" vid="ISA 52:10">አሳ ኡባይ ኑ ፆሳ አቶተ በአና።<verse eid="ISA 52:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 52:11"/>ህንተኖ ጎዳ ሚሽያ ቶከይሳቶ፥ ሻከትተ፥</para>
  <para style="q2" vid="ISA 52:11">ሻከትተ፥ ያፐ ከይተ።</para>
  <para style="q1" vid="ISA 52:11">ቱናባ ቦቾፍተ፤ እያ ግዶፈ ከይተ፤</para>
  <para style="q2" vid="ISA 52:11">ህንተና ጌሽተ።<verse eid="ISA 52:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 52:12"/>ሽን ህንተ ከይሸ ኤሶን ከየከታ፤</para>
  <para style="q2" vid="ISA 52:12">ዎይኮ ጎደትድ ቤከታ።</para>
  <para style="q1" vid="ISA 52:12">ጎዳይ ህንተፈ ስን አድ ካለና፤</para>
  <para style="q2" vid="ISA 52:12">እስራኤለ ፆሳይ ጉየራ ግድድ ህንተና ናጋና።<verse eid="ISA 52:12"/></para>
  <para style="s1">ዋየ ኤክያ አይለ</para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 52:13"/>“ሄኮ፥ ታ አይለይ አኬካን ኦና፤</para>
  <para style="q2" vid="ISA 52:13">እ ቦንቸትድ፥ ቁ ቁ ጋና፤ ዳሮ ግታታና።<verse eid="ISA 52:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 52:14"/>እያ ሶምኦይ አሳ ኡባፈ፥</para>
  <para style="q2" vid="ISA 52:14">እያ መይ አሳ ናይታፐ አድ ቆሄትስ፤</para>
  <para style="q2" vid="ISA 52:14">እያ በእድ ዳሮ አሳይ ዳጋምዶሶና።<verse eid="ISA 52:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 52:15"/>ሽን ሀእ ዳሮ ካዎተት ኡባይ</para>
  <para style="q2" vid="ISA 52:15">እያባን ማላለታና፤</para>
  <para style="q2" vid="ISA 52:15">እያ ጋሶን፥ ዳሮ ካዎት ባንታ ዶና ኦይካና።</para>
  <para style="q1" vid="ISA 52:15">ኤንቲ ባንታዉ ኦደትቦናባ በአና፤</para>
  <para style="q2" vid="ISA 52:15">ስእቦናባ አኬካና” ያጌስ።<verse eid="ISA 52:15"/></para>
  <chapter eid="ISA 52"/>
  <chapter number="53" style="c" sid="ISA 53"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 53:1"/>ኑኒ ኦድዳባ ኦን አማንዴ?</para>
  <para style="q2" vid="ISA 53:1">ጎዳ ቀሰይ ኦደስ ቆንጭዴ?<note caller="-" style="x"><char style="xo" closed="false">53:1 </char><char style="xt" closed="false"><ref loc="JHN 12:38">ዮሀ 12:38</ref>፤ <ref loc="ROM 10:16">ሮመ 10:16</ref>.</char></note><verse eid="ISA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 53:2"/>እ እያ ስንን መላ ቢታን አጭዳ ዱሩማ መላ፤</para>
  <para style="q2" vid="ISA 53:2">ፃጶ የድዳ ዶላ መላ ድጭስ።</para>
  <para style="q1" vid="ISA 53:2">ኑኒ እያ ሎይ ፄሎና መላ</para>
  <para style="q2" vid="ISA 53:2">ማል ዎይኮ ቴም ባዋ።</para>
  <para style="q1" vid="ISA 53:2">ኑኒ እያኮ ሺቆና መላ</para>
  <para style="q2" vid="ISA 53:2">ጩቹ ማልኦ ግደና።<verse eid="ISA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 53:3"/>እ አሳን ካትስ፥ እፀትስ፤</para>
  <para style="q2" vid="ISA 53:3">እ መቶፐነ አዛኖፐ</para>
  <para style="q2" vid="ISA 53:3">ሻከት ኤሮና አስ ግድስ።</para>
  <para style="q1" vid="ISA 53:3">አስ እያ በአናፐ ግድ</para>
  <para style="q2" vid="ISA 53:3">ባ ሶምኡዋ ዎራ ዛርያ አሳዳ ካትስ፤</para>
  <para style="q2" vid="ISA 53:3">ኑኒ እያ ቦንችቦኮ።<verse eid="ISA 53:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 53:4"/>እ ቱማ ኑ ዋይያ ባዉ ኤክስ፤</para>
  <para style="q2" vid="ISA 53:4">ቃስ ኑ ዳቡራ ቶክስ።<note caller="-" style="x"><char style="xo" closed="false">53:4 </char><char style="xt" closed="false"><ref loc="MAT 8:17">ማቶ 8:17</ref>.</char></note></para>
  <para style="q1" vid="ISA 53:4">ሽን ኑኒ፥ እ ፆሳን ደሸትድ ኩንድዳዳነ</para>
  <para style="q2" vid="ISA 53:4">ማዱንፅዳዳ ቆፕዳ።<verse eid="ISA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 53:5"/>ሽን እ ኑ ናጋራ ግሾ፥</para>
  <para style="q2" vid="ISA 53:5">ጫደትድ ማዱንፅስ፤</para>
  <para style="q2" vid="ISA 53:5">ኑ ቆሁዋ ግሾ ሾጨትድ ሊቅስ።<note caller="-" style="x"><char style="xo" closed="false">53:5 </char><char style="xt" closed="false"><ref loc="1PE 2:24">1 ጰፅ 2:24</ref>.</char></note></para>
  <para style="q1" vid="ISA 53:5">እያ ሴራን ኑኒ ሳሮ ደምዳ፤</para>
  <para style="q2" vid="ISA 53:5">እያ ማዱንን ኑኒ ፓፅዳ።<verse eid="ISA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 53:6"/>ኑኒ ኡባይ ኦገ ባልዳ ዶርሳዳ ዎራ ብዳ፤<note caller="-" style="x"><char style="xo" closed="false">53:6 </char><char style="xt" closed="false"><ref loc="1PE 2:25">1 ጰፅ 2:25</ref>.</char></note></para>
  <para style="q2" vid="ISA 53:6">ኑ ኡባይ ኑ ኦግያ ኦግያ ብዳ።</para>
  <para style="q1" vid="ISA 53:6">ሽን ጎዳይ ኑ ኡባ ናቁዋ</para>
  <para style="q2" vid="ISA 53:6">እያ ቦላ ዎስ።<verse eid="ISA 53:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 53:7"/>እ ኡንኤትስ፤ ቆሄትስ፤<note caller="-" style="x"><char style="xo" closed="false">53:7 </char><char style="xt" closed="false"><ref loc="REV 5:6">ቆን 5:6</ref>.</char></note></para>
  <para style="q2" vid="ISA 53:7">ሽን ባ ዶና ዶይቤና።</para>
  <para style="q1" vid="ISA 53:7">ሹካናዉ ኤፍያ ኡርገ ዶርሳዳ ላገትስ፤</para>
  <para style="q2" vid="ISA 53:7">ባ እክስያ ሜድያ ኡራ ስንን</para>
  <para style="q2" vid="ISA 53:7">ስእ ግያ ዶርሳ መላ አይኮካ ፖግቤና።<verse eid="ISA 53:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 53:8"/>ኤንቲ እያ ኡንኤንነ ጌላ ፕርዳን ኤፍዶሶና፤</para>
  <para style="q2" vid="ISA 53:8">እ ታ አሳ ናጋራ ግሾ ሾጨትድ፥</para>
  <para style="q2" vid="ISA 53:8">ደኦን ደኤይሳታ ቢታፈ ክችዳይሳ</para>
  <para style="q2" vid="ISA 53:8">እያ ኮቻፈ ኦን አኬክዴ?<verse eid="ISA 53:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 53:9"/>እያ ዶናን ባል ባይና፥ እ፥ ኢታባ ኦና፥</para>
  <para style="q2" vid="ISA 53:9">ባ ሀይቁዋን ኢታ አሳታራ ታይበትስ፤</para>
  <para style="q2" vid="ISA 53:9">እያ ዱፎይ ዱረ አሳታራ ግድስ።<note caller="-" style="x"><char style="xo" closed="false">53:9 </char><char style="xt" closed="false"><ref loc="1PE 2:22">1 ጰፅ 2:22</ref>.</char></note><verse eid="ISA 53:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 53:10"/>ሽን እያ ቆሄተይነ እያ ኡንኤተይ</para>
  <para style="q2" vid="ISA 53:10">ጎዳ ሸነ ግድስ።</para>
  <para style="q1" vid="ISA 53:10">እ ባና ናጋራ ያርሾ ኦያ ዎደ</para>
  <para style="q2" vid="ISA 53:10">ባ ኮቻ በአና።</para>
  <para style="q1" vid="ISA 53:10">እያ ላይይ አዱቃና፤</para>
  <para style="q2" vid="ISA 53:10">ጎዳ ሸነይ እያ ኩሸን ፖለታና።<verse eid="ISA 53:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 53:11"/>ባ ሸምፑዋ ዋያፐ ጉየ፥</para>
  <para style="q2" vid="ISA 53:11">እ ደኦ ፖኦ በአና፤ ኡፋይታና።</para>
  <para style="q1" vid="ISA 53:11">ታ ፅሎ አይለይ ባ ኤራተን ዳሮታ ፅልሳና፤</para>
  <para style="q2" vid="ISA 53:11">ኤንታ ቆሁዋካ ቶካና።<verse eid="ISA 53:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 53:12"/>ሄሳ ግሾ፥ ታኒ እያ ግሹዋ</para>
  <para style="q2" vid="ISA 53:12">ግታ አሳታ ግዶን እማና፤<note caller="-" style="x"><char style="xo" closed="false">53:12 </char><char style="xt" closed="false"><ref loc="MRK 15:28">ማር 15:28</ref>፤ <ref loc="LUK 22:37">ሉቃ 22:37</ref>.</char></note></para>
  <para style="q2" vid="ISA 53:12">ምኖታራ እ ድኡዋ ሻከታና።</para>
  <para style="q1" vid="ISA 53:12">እ ባ ሸምፑዋ ሀይቆስ አድ እምድ፥</para>
  <para style="q2" vid="ISA 53:12">ኢታታራ ፓይደትስ።</para>
  <para style="q1" vid="ISA 53:12">እ ዳሮ አሳ ናጋራ ቶክስ፤</para>
  <para style="q2" vid="ISA 53:12">ጌላታስ ጋናትስ።<verse eid="ISA 53:12"/></para>
  <chapter eid="ISA 53"/>
  <chapter number="54" style="c" sid="ISA 54"/>
  <para style="s1">ፅዮነ ስን ቦንቹዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 54:1"/>ናተ፥ የሎና ማይን፥ የፃ!</para>
  <para style="q2" vid="ISA 54:1">ናተ፥ እቀታ ኤሮናረ፥ ኡፋይሳን እልላ!</para>
  <para style="q1" vid="ISA 54:1">አዝናራ ደእያ ማጫሰ ናይታፐ</para>
  <para style="q2" vid="ISA 54:1">ባርካ ደእያ ማጫሰ ናይት ዳራና።<verse eid="ISA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 54:2"/>ነ ዱንካንያ በሳ ዳልግሳ፤</para>
  <para style="q2" vid="ISA 54:2">ዱንካንያ ገሸታ ፕድ ኦዳ ምጫ፤</para>
  <para style="q2" vid="ISA 54:2">ፁምሶፓ፤ ዎዶሩዋ አዱሳ፤ ሽያ ምን።<verse eid="ISA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 54:3"/>ኔኒ ኡሻችነ ሀድርስ ዳልጋና፤</para>
  <para style="q2" vid="ISA 54:3">ነ ኮቻት ካዎተታ ላታና፤</para>
  <para style="q2" vid="ISA 54:3">ባይሳትዳ ኤንታ ካታማታን ኬፅድ ዳና።<verse eid="ISA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 54:4"/>“ያዮፋ፤ ኔኒ ዬላታካ፤</para>
  <para style="q2" vid="ISA 54:4">ዳጋሞፋ፤ ኔኒ ካዉያካ።</para>
  <para style="q1" vid="ISA 54:4">ነ ያላጋተ ዬላ ኔኒ ዶጋና፤</para>
  <para style="q2" vid="ISA 54:4">ነ አምኤተ ቦርያ ህዛፐ ጉየ ሀሳያካ።<verse eid="ISA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 54:5"/>ነ አዝናይ ነና መዳይሳ፤</para>
  <para style="q2" vid="ISA 54:5">እያ ሱንይ ኡባፈ ዎልቃማ ጎዳ።</para>
  <para style="q1" vid="ISA 54:5">እስራኤለ ጌሻይ ነና ዎዝዳይሳ፤</para>
  <para style="q2" vid="ISA 54:5">እ ቢታ ኡባ ፆሳ ጌተታና።<verse eid="ISA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 54:6"/>አዝን አግን፥ ዶገታዳ አዛንያ ማጫሳዳ፥</para>
  <para style="q2" vid="ISA 54:6">ያላጋተን አዝና ሶፐ ከይዳ፥</para>
  <para style="q2" vid="ISA 54:6">ማጫሳዳ ኔኒ ሀናዳ ደእሽን፥</para>
  <para style="q2" vid="ISA 54:6">ታኒ ጎዳይ ነና ዛራዳ ፄጋስ።<verse eid="ISA 54:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 54:7"/>“ጉ ዎደ ታኒ ነና አጋስ፥</para>
  <para style="q2" vid="ISA 54:7">ሽን ግታ ቃን ታኒ ነና ዛራዳ ኤሀና።<verse eid="ISA 54:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 54:8"/>ሱልያ ሀንቆን ታኒ ታ ሶምኡዋ</para>
  <para style="q2" vid="ISA 54:8">ኔፐ ጉ ዎደስ ገንስ።</para>
  <para style="q1" vid="ISA 54:8">ሽን መርና ማሮተን ታኒ ነዉ ቃታና”</para>
  <para style="q2" vid="ISA 54:8">ያጌስ ነና ዎዝያ ጎዳይ።<verse eid="ISA 54:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 54:9"/>“ሀይስ ታዉ ኖሄ ዎድያ መላ፤</para>
  <para style="q2" vid="ISA 54:9">ሄ ዎደ ታኒ ዮ ሃን</para>
  <para style="q2" vid="ISA 54:9">ዛራዳ ሳኣ ይስከ ጋዳ ጫቅዳይሳዳ፥</para>
  <para style="q2" vid="ISA 54:9">ዛራዳ ነ ቦላ ሀንቀቶና መላነ</para>
  <para style="q2" vid="ISA 54:9">ሴሮና መላ ታኒ ጫቃስ።<verse eid="ISA 54:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 54:10"/>ደረት ቃፃናዉ፥ ዙማት ባንታ በሳፈ ክቻናዉ ዳንዳኦሶና፤</para>
  <para style="q2" vid="ISA 54:10">ሽን ታ መርና ሲቆይ ኔፐ ሻከተና፤</para>
  <para style="q2" vid="ISA 54:10">ታ ሳሮተ ጫቆይ ኔፐ ክቸና”</para>
  <para style="m" vid="ISA 54:10">ያጌስ ነዉ ቃትያ ጎዳይ።<verse eid="ISA 54:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 54:11"/>“ነኖ፥ መቶትዳ ካታመ፥ ጎተይ ያነ ሃነ ሾጭዳረ፥</para>
  <para style="q2" vid="ISA 54:11">ምንያባይ ይዳረ፥</para>
  <para style="q2" vid="ISA 54:11">ሄኮ፥ ታኒ ነና ቦንቾ ሹቻን አሌቅሳዳ ኬፃና፤</para>
  <para style="q2" vid="ISA 54:11">ነ ባሱዋ ሳንፓረ ሹቻን ሂፃና።<verse eid="ISA 54:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 54:12"/>ነ ሹቻ ግምብያ ቁስትያ ዞኦ እንቆ ሹቻን፥</para>
  <para style="q2" vid="ISA 54:12">ነ ፐንግያ ጶልያ አልኦ ሹቻን፥</para>
  <para style="q2" vid="ISA 54:12">ነ ድርሳ ቦንቾ ሹቻን ግምባና።<verse eid="ISA 54:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 54:13"/>ነ ናይት ኡባይ ጎዳፐ ታማራና፤</para>
  <para style="q2" vid="ISA 54:13">ነ ናይታ ሳሮተይ ዳራና።<verse eid="ISA 54:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 54:14"/>ኔኒ ፅሎተን ምናዳ ኤቃና፤</para>
  <para style="q2" vid="ISA 54:14">ገነይነ ኡንኤይ ኔፐ ሃካና።</para>
  <para style="q1" vid="ISA 54:14">ነና ያሽስያባ ዴና፤</para>
  <para style="q2" vid="ISA 54:14">ዳጋም ኔኮ ሺቀና።<verse eid="ISA 54:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 54:15"/>ነና ኦላናዉ ደንደይ ደእኮ፥ ሄስ ታፐ ግደና፤</para>
  <para style="q2" vid="ISA 54:15">ነና ቆሀናዉ ኮየይ ደእኮ፥ እ ኩንዳና።<verse eid="ISA 54:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 54:16"/>“ሄኮ፥ ሁበን ታማ ሁብድ፥</para>
  <para style="q2" vid="ISA 54:16">ባ ቆፕዳ ኦላ ሚሽያ ቆፅያ ኡራ ታኒ መስ፤</para>
  <para style="q2" vid="ISA 54:16">ይሳና መላ ይሰይሳ መዳይ ታና።<verse eid="ISA 54:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 54:17"/>ነና ቆሀናዉ ኦሰትዳ አይ ሚሸይካ ነ ቦላ ኦና፤</para>
  <para style="q2" vid="ISA 54:17">ነና ሞትያ እንፃርሳ ኡባስ ነ ዛሮ እማና።</para>
  <para style="q1" vid="ISA 54:17">ጎዳ አይለታ ላታይ ሀይሳ፤</para>
  <para style="q2" vid="ISA 54:17">ታፐ ኤንቲ ኤክያ ፅሎ ሀይሳ” ያጌስ ጎዳይ።<verse eid="ISA 54:17"/></para>
  <chapter eid="ISA 54"/>
  <chapter number="55" style="c" sid="ISA 55"/>
  <para style="s1">ሳሞትዳ ኡባይ ዮ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 55:1"/>ህንተኖ፥ ሳሞትዳይሳቶ፥ ኡባይ ታኮ ሃ ዪተ፤</para>
  <para style="q2" vid="ISA 55:1">ሚሸይ ባይናይሳቶ፥ ሃ ዪተ።</para>
  <para style="q1" vid="ISA 55:1">ሻምድ ሚተ፤</para>
  <para style="q2" vid="ISA 55:1">ሃ ይድ፥ ሚሸ ቃንፆና</para>
  <para style="q2" vid="ISA 55:1">ጮ ዎይነ ኡሽነ ማ ሻምተ።<note caller="-" style="x"><char style="xo" closed="false">55:1 </char><char style="xt" closed="false"><ref loc="REV 21:6">ቆን 21:6</ref>፤ <ref loc="REV 22:7">22:7</ref>.</char></note><verse eid="ISA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 55:2"/>ካ ግዶናባስ ህንተ ሚሽያ አይስ ከሴቲ?</para>
  <para style="q2" vid="ISA 55:2">ካልሶናባን ህንተ ዎልቃ አይስ ዉርሴቲ?</para>
  <para style="q1" vid="ISA 55:2">አነ ታና ስእተ፥ ታኒ ኦደይሳ ሀይዝተ፤</para>
  <para style="q2" vid="ISA 55:2">ሎኦ ካ ሚተ፤</para>
  <para style="q2" vid="ISA 55:2">ሎኦ ካን ህንተ አሳተ ኡፋይስተ።<verse eid="ISA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 55:3"/>“ህንተ ሀይ ታኮ ዛሪድ ታና ስእተ፤</para>
  <para style="q2" vid="ISA 55:3">ደኦን ዳናዉ ታ ኦደይሳ ስእተ፤<note caller="-" style="x"><char style="xo" closed="false">55:3 </char><char style="xt" closed="false"><ref loc="ACT 13:34">ሀዋ 13:34</ref>.</char></note></para>
  <para style="q2" vid="ISA 55:3">ታኒ ዳዊታስ ገልዳ ኡፋይሳ ቃላን ህንተና አንጃና።<verse eid="ISA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 55:4"/>ሄኮ፥ ታኒ እያ ካዎተታስ ማርካ፥</para>
  <para style="q2" vid="ISA 55:4">ካለይሳነ ሀላቃ ኦስ።<verse eid="ISA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 55:5"/>ጎዳይ፥ ነ ፆሳይ፥ እስራኤለ ጌሻይ</para>
  <para style="q2" vid="ISA 55:5">ነና ቦንችዳ ግሾ፥</para>
  <para style="q2" vid="ISA 55:5">ኔኒ ኤሮና ካዎተታ ፄጋና፤</para>
  <para style="q2" vid="ISA 55:5">ነና ኤሮና ካዎተት ኤለስድ ኔኮ ያና።”<verse eid="ISA 55:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 55:6"/>“ጎዳይ በንትያ ዎደ እያ ኮይተ፤</para>
  <para style="q2" vid="ISA 55:6">ማታን ደእያ ዎደ እያ ፄግተ።<verse eid="ISA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 55:7"/>ኢታ አስ ባ ኦግያፐ ስሞ፤</para>
  <para style="q2" vid="ISA 55:7">ናጋራንቾይ ባ ቆፋ አጎ።</para>
  <para style="q1" vid="ISA 55:7">ጎዳኮ ስሞ፥ እካ እያ ማራና፤</para>
  <para style="q2" vid="ISA 55:7">እ ኑ ፆሳኮ ስሞ፥ እያዉ አቶ ጋና።<verse eid="ISA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 55:8"/>ታ ቆፋይ ህንተ ቆፋ መላ፥</para>
  <para style="q2" vid="ISA 55:8">ታ ኦገይ ህንተ ኦግያ መላ ግደና”</para>
  <para style="m" vid="ISA 55:8">ያጌስ ጎዳይ።<verse eid="ISA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 55:9"/>ሳሎት ሳኣፐ ቀይሳዳ፥</para>
  <para style="q2" vid="ISA 55:9">ታ ኦገይ ህንተ ኦግያፐ፥</para>
  <para style="q2" vid="ISA 55:9">ታ ቆፋይ ህንተ ቆፋፐ ቄስ።<verse eid="ISA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 55:10"/>እርነ ሻች ሳሎፐ ዎድ፥<note caller="-" style="x"><char style="xo" closed="false">55:10 </char><char style="xt" closed="false"><ref loc="2CO 9:10">2 ቆሮ 9:10</ref>.</char></note></para>
  <para style="q2" vid="ISA 55:10">ቢታ ላክስድ፥ ካ ዶላና መላነ</para>
  <para style="q2" vid="ISA 55:10">አይፋና መላ ኦይሳዳ፥ ዘረይሳስ ዘረ፥</para>
  <para style="q2" vid="ISA 55:10">መይሳስ ካ እሞና ጉየ ሳሎ ስመና።<verse eid="ISA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 55:11"/>ታ ዶናፐ ከይያ ቃላይ ሄሳ ማላ፤</para>
  <para style="q2" vid="ISA 55:11">እ ታኒ ሀልችዳይሳ ፖሎናነ</para>
  <para style="q2" vid="ISA 55:11">ታ ኪትዳይሳ ኦና ታኮ ጮ ስመና።<verse eid="ISA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 55:12"/>“ህንተ ኡፋይሳን ከያና፤ ሳሮን ሞይዘታና፤</para>
  <para style="q2" vid="ISA 55:12">ደረትነ ዙማት ህንተ ስንን ኡፋይትድ የፃና፤</para>
  <para style="q2" vid="ISA 55:12">ባዞ ምት ኡባይ ባንታ ኩሽያ ባቃና።<verse eid="ISA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 55:13"/>አጉን ግሾ ፂዳ፥</para>
  <para style="q2" vid="ISA 55:13">ጎምኦረ ግሾ ፃይ ዶላና።</para>
  <para style="q1" vid="ISA 55:13">ሄስ ጎዳ ቆፍስያባነ</para>
  <para style="q2" vid="ISA 55:13">መርናዉ ዮና ማላ ግዳና”</para>
  <para style="m" vid="ISA 55:13">ያጌስ ጎዳይ።<verse eid="ISA 55:13"/></para>
  <chapter eid="ISA 55"/>
  <chapter number="56" style="c" sid="ISA 56"/>
  <para style="s1">አቶተ ሀራታስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1"/>“ሱረ ፕርዳ ናግተ፤ ፅሎ ኦተ፤</para>
  <para style="q2" vid="ISA 56:1">ታ አቶተይ ኤለስድ ያና፤</para>
  <para style="q2" vid="ISA 56:1">ታ ፅሎተይ ማታን ቆንጫና።<verse eid="ISA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 56:2"/>ሀይሳ ኦያ ኡራይ፥</para>
  <para style="q2" vid="ISA 56:2">ሳምባታ ቱንሶና ቦንችያ ኡራይነ</para>
  <para style="q2" vid="ISA 56:2">ባ ኩሸይ ኢታባ ኦና መላ ተቅያ ኡራይ አንጀትዳይሳ”</para>
  <para style="m" vid="ISA 56:2">ያጌስ ጎዳይ።<verse eid="ISA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 56:3"/>ጎዳኮ ሺቅዳ በተ አስ፥</para>
  <para style="q2" vid="ISA 56:3">“ጎዳይ ታና ባ አሳፐ ሻካና” ጎፖ፤</para>
  <para style="q2" vid="ISA 56:3">ሹፋይ፥ “ታኒ መልዳ ም” ጎፖ።<verse eid="ISA 56:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 56:4"/>“ታ ሳምባታ ቦንችያ፥</para>
  <para style="q2" vid="ISA 56:4">ታና ኡፋይስያባ ዶረይነ</para>
  <para style="q2" vid="ISA 56:4">ታ ጫቁዋ ምንድ ናግያ ሹፋታስ፥<verse eid="ISA 56:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ISA 56:5"/>ኤንታዉ ታኒ ታ ኬንነ ታ ድርሳ ግምብያ ግዶን</para>
  <para style="q2" vid="ISA 56:5">ኤንቲ ሀሳየትያባ እማና።</para>
  <para style="q1" vid="ISA 56:5">ኤንቲ ማጫ ናአነ አደ ናአ የልድ፥</para>
  <para style="q2" vid="ISA 56:5">ደምያ ቦንቹዋፈ አያ</para>
  <para style="q2" vid="ISA 56:5">ሱን ታኒ ኤንታዉ እማና፤</para>
  <para style="q2" vid="ISA 56:5">ታኒ መርናዉ ዮና ሱን ኤንታዉ እማና።<verse eid="ISA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 56:6"/>ጎዳ ሀጋዛናዉ፥ ጎዳ ዶሳናዉነ</para>
  <para style="q2" vid="ISA 56:6">እያ አይለ ግዳናዉ ባንታና እያኮ ሺሽያ፥</para>
  <para style="q2" vid="ISA 56:6">ሳምባታ ቱንሶና ቦንችያነ</para>
  <para style="q2" vid="ISA 56:6">ታ ጫቆ ቃላ ምንድ ናግያ በተ አሳታ፥<verse eid="ISA 56:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 56:7"/>ታኒ ታ ጌሻ ዙማ ቦላ ኤሀዳ</para>
  <para style="q2" vid="ISA 56:7">ታ ዎሳ ኬን ኤንታ ኡፋይሳና።</para>
  <para style="q1" vid="ISA 56:7">ኤንቲ ታ ያርሾ በሳን ሺሽያ ፁሳ ያርሾይነ</para>
  <para style="q2" vid="ISA 56:7">ሀራ ያርሾይ ኤከታና፤</para>
  <para style="q2" vid="ISA 56:7">ታ ኬይ አሳ ኡባይ ፆሳ ዎስያ ኬ ጌተታና”<note caller="-" style="x"><char style="xo" closed="false">56:7 </char><char style="xt" closed="false"><ref loc="MAT 21:13">ማቶ 21:13</ref>፤ <ref loc="MRK 11:17">ማር 11:17</ref>፤ <ref loc="LUK 19:46">ሉቃ 19:46</ref>.</char></note></para>
  <para style="m" vid="ISA 56:7">ያጌስ።<verse eid="ISA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 56:8"/>“ሽቅዳይሳታ ቦላ ጉጃዳ ሀራታካ ታኒ ሺሻና”</para>
  <para style="q2" vid="ISA 56:8">ያጌስ እስራኤለፐ ላለትዳይሳታ ሺሽያ፥ ኡባ ሃርያ ጎዳይ።<verse eid="ISA 56:8"/></para>
  <para style="s1">ፆሳይ ኢታታ ሞቴስ</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 56:9"/>ህንተኖ ባዞ ዶአቶ፥</para>
  <para style="q2" vid="ISA 56:9">ህንተኖ ዎራ ዶአቶ፥</para>
  <para style="q2" vid="ISA 56:9">ኡባይ ሃ ይድ ሚተ።<verse eid="ISA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 56:10"/>እስራኤለ አሳ ናገይሳት ቆቀ፤ ኤንታዉ ኤር ባዋ፤</para>
  <para style="q2" vid="ISA 56:10">ኤንቲ ኡባይ ቦጫናዉ ዳንዳኦና ቡታለ ካናታ፤</para>
  <para style="q2" vid="ISA 56:10">ኤንቲ ዝንእድ ኤልሞቶሶና፤ ስኮ ዶሶሶና።<verse eid="ISA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 56:11"/>ኤንቲ ምድ ካሎና ያራምባ ካና መላ፤</para>
  <para style="q2" vid="ISA 56:11">ኤንቲ አኬክ ፓጭዳ ሄንንቾ።</para>
  <para style="q1" vid="ISA 56:11">ኤንቲ ኡባይ ባንታ ኦገ ብዶሶና፤</para>
  <para style="q2" vid="ISA 56:11">ኡባይ ባንታ ጎአ ፃላላ ኮዮሶና።<verse eid="ISA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 56:12"/>ኤንቲ፥ “ሃ ዪተ፤ ዎይነ ኡሻ አነ ኡዮስ፤</para>
  <para style="q2" vid="ISA 56:12">ማይያ ኡሻ አነ ጋኖስ!</para>
  <para style="q1" vid="ISA 56:12">ዎንቶይ ሀች መላ ግዳና፤</para>
  <para style="q2" vid="ISA 56:12">ሀችፈካ አድ ሎአና” ያጎሶና።<verse eid="ISA 56:12"/></para>
  <chapter eid="ISA 56"/>
  <chapter number="57" style="c" sid="ISA 57"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 57:1"/>ፅሎ አስ ሀይቄስ፤</para>
  <para style="q2" vid="ISA 57:1">ሽን ሄሳ ቆፐይ ባዋ።</para>
  <para style="q1" vid="ISA 57:1">ባንታና ፆሳስ እምዳ አሳይ ቢታፈ ኤከቶሶና፥</para>
  <para style="q2" vid="ISA 57:1">ሽን ፅሎ አስ ኢት ያናፐ ስንትድ፥</para>
  <para style="q2" vid="ISA 57:1">ኤከተይሳ ኦንካ አኬከና።<verse eid="ISA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 57:2"/>እ፥ ብድ ሳሮተ ደእያ በሲ ገሌስ፤</para>
  <para style="q2" vid="ISA 57:2">ሱረተን ሄመተይሳት ሀይቅድ፥</para>
  <para style="q2" vid="ISA 57:2">ሸምፖ ደሞሶና።<verse eid="ISA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 57:3"/>“ህንተኖ፥ ማሮ ናይቶ፥ ህንተኖ ላምያነ</para>
  <para style="q2" vid="ISA 57:3">ላይማትያ ዛረቶ፥ ሃ ዪተ።<verse eid="ISA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 57:4"/>ህንተ ኦና ቀልቅሴቲ?</para>
  <para style="q2" vid="ISA 57:4">ህንተ ኦና ቦሬቲእ?</para>
  <para style="q1" vid="ISA 57:4">ህንተ እንፃርሳ ኦደ ቦላ ከሴቲ?</para>
  <para style="q2" vid="ISA 57:4">ህንተ ጌላታነ ዎርዳንቾ ናይታ ግደከቲ?<verse eid="ISA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 57:5"/>ህንተ ዎላ ጋርሳንነ</para>
  <para style="q2" vid="ISA 57:5">ዳሻ ም ጋርሳን አሞን ፁገቴታ።</para>
  <para style="q1" vid="ISA 57:5">ህንተ ናይታ ዛንጋራንነ</para>
  <para style="q2" vid="ISA 57:5">ዛላ ቆጶን ሹክድ ያርሼታ።<verse eid="ISA 57:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 57:6"/>ዛንጋራን ደእያ ሊቆ ሹቻት ህንተ ፆሳታ፤</para>
  <para style="q2" vid="ISA 57:6">ህንተ ኤንታዉ ኡሻ ያርሾ ትግደታ።</para>
  <para style="q1" vid="ISA 57:6">ካ ያርሾካ እምደታ</para>
  <para style="q2" vid="ISA 57:6">ያትን፥ ታኒ ሀይሳን ሀንቀትክና?<verse eid="ISA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 57:7"/>ዙማ ሁጰን ሂፃ የግደታ፤</para>
  <para style="q2" vid="ISA 57:7">ያን ያርሻናዉ ከይደታ።<verse eid="ISA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 57:8"/>ህንተ ፐንግያፈነ ጎባነታፐ</para>
  <para style="q2" vid="ISA 57:8">ሶ ባጋራ ኤቃ ምስለታ ኤስደታ።</para>
  <para style="q1" vid="ISA 57:8">ታና አግድ ህንተ አርሳ ዳልግስድ፥ ያ ከይደታ፤</para>
  <para style="q2" vid="ISA 57:8">ኤንታራ ጫቅደታ፤ ያትድ ኤንታ አርሳ ዶስደታ፤</para>
  <para style="q2" vid="ISA 57:8">ኤንታ ካሉዋ በእደታ።<verse eid="ISA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 57:9"/>ዛይተነ ሽቶ ኤክድ ሞሎካ ጌተትያ ኤቃኮ ብደታ፤</para>
  <para style="q2" vid="ISA 57:9">ህንተ ኪታንቾታ ሃሆ ሶ ኪትደታ፤</para>
  <para style="q2" vid="ISA 57:9">ሀር አቶሽን ስኦለ ጋካናዉ ዎደታ።<verse eid="ISA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 57:10"/>ህንተ ሀራ ፆሳታ ኮይሸ ዳቡርደታ፤</para>
  <para style="q2" vid="ISA 57:10">ሽን፥ ‘ኡፋይስ ባዋ’ ግቤከታ።</para>
  <para style="q1" vid="ISA 57:10">ህንተ ዎልቃይ ሃ ኦራፅስ፤</para>
  <para style="q2" vid="ISA 57:10">ሄሳ ግሾ፥ ላባንድ ኩንድቤከታ።<verse eid="ISA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 57:11"/>“ህንተ ኦና ያይድ፥ ታዉ ዎርዶትደቲ?</para>
  <para style="q2" vid="ISA 57:11">ህንተ ታና ቆፕበከታ፤</para>
  <para style="q2" vid="ISA 57:11">ህንተ ዎዛናን ቆፕበከታ።</para>
  <para style="q1" vid="ISA 57:11">ህንተ ታዉ ያዮና እፅዳይ</para>
  <para style="q2" vid="ISA 57:11">ታኒ ዳሮ ዎደ ስእ ግዳ ግሾ ግደኔ?<verse eid="ISA 57:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 57:12"/>ታኒ ህንተ ፅሎተነ ህንተ ኦሶታ አዋጃና፤</para>
  <para style="q2" vid="ISA 57:12">ሽን ህንተና አይኮካ ጎኦኮና።<verse eid="ISA 57:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 57:13"/>ህንተ ማዶ ደማናዉ ዋስያ ዎደ</para>
  <para style="q2" vid="ISA 57:13">ህንተ ሺሽዳ ኤቃት ህንተና አሸና!</para>
  <para style="q1" vid="ISA 57:13">ኤንታ ኡባ ጫርኮይ ኤፋና፤</para>
  <para style="q2" vid="ISA 57:13">እስ ቶሆ ጫርክያ ጫርኮይ ኤንታ ፑንድ ይሳና።</para>
  <para style="q1" vid="ISA 57:13">ሽን ታና ባዉ ባቃትድ አትያ በሰ ኦያ</para>
  <para style="q2" vid="ISA 57:13">ኡራይ ቢታ ላታና፤</para>
  <para style="q2" vid="ISA 57:13">ታ ጌሻ ዙማ ኤካና”</para>
  <para style="m" vid="ISA 57:13">ያጌስ።<verse eid="ISA 57:13"/></para>
  <para style="s1">ዎዛን መቅዳ አሳስ ምን</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 57:14"/>“ባስተ፥ ባስተ! ኦገ ጊግስተ፤</para>
  <para style="q2" vid="ISA 57:14">ታ አሳ ኦግያፐ ብያባ ኡባ ድግተ”</para>
  <para style="m" vid="ISA 57:14">ያጌስ ጎዳይ።<verse eid="ISA 57:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 57:15"/>መርናዉ ደኤይስ፥ ግታይ፥ ቃ በሳን ደኤይስ፥</para>
  <para style="q2" vid="ISA 57:15">እያ ሱንይ ጌሻ ጌተተይስ፥ ያጌስ፦</para>
  <para style="q1" vid="ISA 57:15">“ካዉይዳ አሳ አያና ደንናዉ፥</para>
  <para style="q2" vid="ISA 57:15">መቅዳ ዎዛን ደኤይሳታ ኮላናዉ፥</para>
  <para style="q2" vid="ISA 57:15">ካዉይዳነ መቅዳ አያን ደኤይሳራ ዳና።<verse eid="ISA 57:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 57:16"/>ታ መዳ አሳ አያናይነ ሸምፖይ፥</para>
  <para style="q2" vid="ISA 57:16">ታ ስንን ዶጮና መላ ታኒ መርናዉ ሞትከ፤</para>
  <para style="q2" vid="ISA 57:16">ኡባ ዎደ ሀንቀትከ።<verse eid="ISA 57:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 57:17"/>ኤንታ ናጋራ ጋሶን ታኒ ኤንታ ሀንቀታዳ ሴራስ፤</para>
  <para style="q2" vid="ISA 57:17">ታ ሶምኡዋ ኤንታፈ ገንስ፤</para>
  <para style="q2" vid="ISA 57:17">ሽን ኤንቲ ሀእካ ባንታ ዎዛና ቆፋን ብዶሶና።<verse eid="ISA 57:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 57:18"/>ታኒ ኤንታ ኦግያ በአስ፤</para>
  <para style="q2" vid="ISA 57:18">ሽን ታኒ ኤንታ ፓና፥ ካለና፤</para>
  <para style="q2" vid="ISA 57:18">እያዉነ እያ ግሾ ዬከይሳታ ምንና።<verse eid="ISA 57:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 57:19"/>እስራኤለ ቢታን ዬከይሳታ፥</para>
  <para style="q2" vid="ISA 57:19">መተርሻን ጋላታ ኩንና።</para>
  <para style="q1" vid="ISA 57:19">ሃሆንነ ማታን ደኤይሳታስ፥</para>
  <para style="q2" vid="ISA 57:19">ሳሮይ ግዶ፤ ታኒ ኤንታ ፓና”</para>
  <para style="m" vid="ISA 57:19">ያጌስ ጎዳይ።<verse eid="ISA 57:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 57:20"/>ሽን ኢታት ኡርቃነ ስልሞ ከስያ፥</para>
  <para style="q2" vid="ISA 57:20">ዎፑ ጋናዉ ዳንዳኦና አባ ቤታ መላ።<verse eid="ISA 57:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 57:21"/>“ኢታታስ ሳሮይ ባዋ”</para>
  <para style="m" vid="ISA 57:21">ያጌስ ታ ፆሳይ።<verse eid="ISA 57:21"/></para>
  <chapter eid="ISA 57"/>
  <chapter number="58" style="c" sid="ISA 58"/>
  <para style="s1">ቱማ ፆማ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 58:1"/>ጎዳይ ሀይሳዳ ያጌስ፦</para>
  <para style="q2" vid="ISA 58:1">“ነ ቃላ ቁ ኦዳ ዋሳ፤ ጉየ ጎፓ፤</para>
  <para style="q2" vid="ISA 58:1">ነ ቃላ ሞይዘዳ ቁ ኦ።</para>
  <para style="q1" vid="ISA 58:1">ታ አሳስ ኤንታ ጌላተ፥</para>
  <para style="q2" vid="ISA 58:1">ያይቆባ ኬስ ኤንታ ናጋራ ኦዳ።<verse eid="ISA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 58:2"/>ሽን ኤንቲ ታና ጋላስ ጋላስ ኮዮሶና፤</para>
  <para style="q2" vid="ISA 58:2">ታ ኦግያ ካላናዉ ዶስያ ዳኖሶና።</para>
  <para style="q1" vid="ISA 58:2">ፅሎ ኦዳነ ፆሳ ኪታ አግቦና አሳዳ</para>
  <para style="q2" vid="ISA 58:2">ኤንቲ ታና ሱረ ፕርዳ ኦይቾሶና፤</para>
  <para style="q2" vid="ISA 58:2">ታኮ ፆሳኮ ሺቃናዉ ዶስያ ዳኖሶና።<verse eid="ISA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 58:3"/>ኤንቲ ጎዳኮ፥</para>
  <para style="q2" vid="ISA 58:3">‘ኑኒ ፆሞስ፥ ሽን ኔኒ አይስ ኑና ፄልኪ?</para>
  <para style="q2" vid="ISA 58:3">ኑኒ ኑናተ ካዉሽዳ፥</para>
  <para style="q2" vid="ISA 58:3">ሽን ኔኒ አይስ ኤሮናዳ ሀናድ’ ያጎሶና።</para>
  <para style="q1" vid="ISA 58:3">ጎዳይ ዛሪድ፥ ‘ሄኮ፥ ህንተ ፆምያ ዎደ</para>
  <para style="q2" vid="ISA 58:3">ህንተና ኡፋይስያባ ኦታ፤</para>
  <para style="q2" vid="ISA 58:3">ህንተ ኦሳንቾታ ኡንኤታ።’<verse eid="ISA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 58:4"/>ህንተ ኦሻንነ ፓላማን ፆሜታ፤</para>
  <para style="q2" vid="ISA 58:4">ቃይ ባይና ኢታ ደሸ ደቻናዉ ፆሜታ።</para>
  <para style="q1" vid="ISA 58:4">ሄሳ መላ ፆምያ ህንተ ዎሳይ ቦላ ሳሉዋን</para>
  <para style="q2" vid="ISA 58:4">ስኤቶና መላ ኦስ።<verse eid="ISA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 58:5"/>ታኒ ዶርዳ ፆማይ ሀይሳ መላ ፆሜ?</para>
  <para style="q2" vid="ISA 58:5">እስ አስ ባናተ ካዉሸይ ሀይሳ መላ ጋላሳ ፃላላኔ?</para>
  <para style="q1" vid="ISA 58:5">ታኒ ኮይያ ፆማይ አስ ባ ሁጵያ</para>
  <para style="q2" vid="ISA 58:5">ካፅዳ ጋሸዳ ሆክሳና መላነ</para>
  <para style="q2" vid="ISA 58:5">ብዶ ትየትድ ካዮ ማኦ ማእድ ኡተዬ?</para>
  <para style="q1" vid="ISA 58:5">ህንተ ሄሳ ፆማ ግድ ፄገትዬ?</para>
  <para style="q2" vid="ISA 58:5">ሄ ፆማ ጋላሳይ ጎዳ ስንን ኤከትዬ?<verse eid="ISA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 58:6"/>“ታኒ ዶርያ ፆማይ ሀይሳ፤</para>
  <para style="q2" vid="ISA 58:6">ሱረ ፕርዳ ዮ ሳንላታ ብላና መላነ</para>
  <para style="q2" vid="ISA 58:6">ቃምባራ መንድ ኡንኤትዳይሳታ</para>
  <para style="q2" vid="ISA 58:6">ላአ ከሳና መላ ግደነዬ?<verse eid="ISA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 58:7"/>ታኒ ዶርያ ፆማይ ኮሻትዳይሳ ሙዛና መላ፥</para>
  <para style="q2" vid="ISA 58:7">ኬ ባይና ማንቆታ ሶ ኤካና መላ፥</para>
  <para style="q2" vid="ISA 58:7">ካሎትዳይሳ በአዳ ማይዛና መላነ</para>
  <para style="q2" vid="ISA 58:7">ማዶ ኮይያ ህንተ ዳቡዋፈ</para>
  <para style="q2" vid="ISA 58:7">ህንተና ገንና መላሳ ግደኔ?<verse eid="ISA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 58:8"/>ያትኮ፥ ህንተ ፖኦይ ዎንታ ፃልቀዳ ፖአና፤</para>
  <para style="q2" vid="ISA 58:8">ህንተ ፓፆተይ ኤሶን ያና።</para>
  <para style="q1" vid="ISA 58:8">ህንተ ፅሎተይ ህንተፈ ስንራ ባና፤</para>
  <para style="q2" vid="ISA 58:8">ጎዳ ቦንቾይ ህንተፈ ጉየራ ግድድ፥</para>
  <para style="q2" vid="ISA 58:8">ህንተና ናጋና።<verse eid="ISA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 58:9"/>ሄ ዎደ ህንተ ፄጋና፤</para>
  <para style="q2" vid="ISA 58:9">ጎዳይ ህንተዉ ኮያና።</para>
  <para style="q1" vid="ISA 58:9">ህንተ ማዶ ኮይድ ዋሳና፤</para>
  <para style="q2" vid="ISA 58:9">እ፥ ‘ሄኮ፥ ታኒ ሀይሳን ደአይስ!’ ያጋና።</para>
  <para style="b" vid="ISA 58:9"/>
  <para style="q1" vid="ISA 58:9">“ህንተ ግዶፈ ኡንኤያ ቃምባራ ድግኮ፥</para>
  <para style="q2" vid="ISA 58:9">ብራን ማለይሳነ ኢታባ ኦደተይሳ አግኮ፥<verse eid="ISA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 58:10"/>ኮሻትዳይሳ ሙዝኮ፥</para>
  <para style="q2" vid="ISA 58:10">መቶትዳይሳታ ኮሽያባን ማድኮ፥</para>
  <para style="q2" vid="ISA 58:10">ሄ ዎደ ህንተ ፖኦይ ማን ፖአና፤</para>
  <para style="q2" vid="ISA 58:10">ህንተ ቃማይ ሴታ ጋላስ ግዳና።<verse eid="ISA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 58:11"/>ጎዳይ ህንተና ኡባ ዎደ ካለና፤</para>
  <para style="q2" vid="ISA 58:11">ህንተና መላ ቢታን ኮሽያባን ካልሳና፤</para>
  <para style="q2" vid="ISA 58:11">ህንተ ፃጱዋ ፃልሳና።</para>
  <para style="q1" vid="ISA 58:11">ህንተ ሃ ኡያ ጋናተ መላነ</para>
  <para style="q2" vid="ISA 58:11">መል ኤሮና ሃ ፑልቶ መላ ግዳና።<verse eid="ISA 58:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 58:12"/>ነ አሳይ በን ላለትዳ በሳታ ዛሪድ ኬፃና፤</para>
  <para style="q2" vid="ISA 58:12">ዳሮ ዎደፐ ካሰ ባሰትዳ ባሶታ ኬፅድ ቁ ኦና።</para>
  <para style="q1" vid="ISA 58:12">ህንተ ‘ላለትዳ ግምበታ ግምበይሳታነ</para>
  <para style="q2" vid="ISA 58:12">አሳይ ደእያ በሳነ ዎጋ ኦገይ</para>
  <para style="q2" vid="ISA 58:12">ደእያ ካታማታ ኤሰይሳታ ጌተታና።’<verse eid="ISA 58:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 58:13"/>“ሳምባታ ጋላሳ ቦንቾ አጎና እፅኮ፥</para>
  <para style="q2" vid="ISA 58:13">ታ ጌሻ ጋላስ ህንተ ጎአ የደይሳ አግኮ፥</para>
  <para style="q2" vid="ISA 58:13">ሳምባታ ኡፋይስነ ቦንቸትዳ፥</para>
  <para style="q2" vid="ISA 58:13">ጎዳ ጋላሳ ቦንቾ ጋዳ ፄግኮ፥</para>
  <para style="q2" vid="ISA 58:13">ህንተ ህንተ ኦግያ ቦና አግድ ሄ ጋላሳ ቦንችኮ፥</para>
  <para style="q2" vid="ISA 58:13">ህንተና ኡፋይስያባ ኦናነ ሀዳባ ኦደቶና አግኮ፥<verse eid="ISA 58:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 58:14"/>ሄ ዎደ ህንተ ጎዳን ኡፋይታና፤</para>
  <para style="q2" vid="ISA 58:14">ታኒ ህንተና ዳሮ ቦንቸትዳይሳታ ኦና፤</para>
  <para style="q2" vid="ISA 58:14">ህንተ አዋ ያይቆባ ላታ ህንተ ማና መላ ኦና።</para>
  <para style="m" vid="ISA 58:14">ታኒ ጎዳይ ሀይሳ ኦዳስ” ያጌስ።<verse eid="ISA 58:14"/></para>
  <chapter eid="ISA 58"/>
  <chapter number="59" style="c" sid="ISA 59"/>
  <para style="s1">ናጋራነ ፕርዳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 59:1"/>ሄኮ፥ ጎዳ ኩሸይ</para>
  <para style="q2" vid="ISA 59:1">ህንተና አሻናዉ ቃምቤና፤</para>
  <para style="q2" vid="ISA 59:1">እያ ሀይይ ስአናዉ ቱልቤና።<verse eid="ISA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 59:2"/>ሽን ህንተ ናጋራይ ህንተፈነ</para>
  <para style="q2" vid="ISA 59:2">ህንተ ፆሳፈ ግዶን ሻሄተ መስ።</para>
  <para style="q1" vid="ISA 59:2">እ ስኦና መላ ህንተ ናጋራይ</para>
  <para style="q2" vid="ISA 59:2">እያ ሶምኡዋ ህንተፈ ገንስ።<verse eid="ISA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 59:3"/>ህንተ ኩሸይ ሱን፥</para>
  <para style="q2" vid="ISA 59:3">ህንተ ብራይ ናቆን ቱንስ፤</para>
  <para style="q2" vid="ISA 59:3">ህንተ ዶናይ ዎርዶ ኦደቴስ፤</para>
  <para style="q2" vid="ISA 59:3">ህንተ እንፃርሳይ ኢታባ ዙዙሜስ።<verse eid="ISA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 59:4"/>ፅሎተን ሞተይ ባዋ፤</para>
  <para style="q2" vid="ISA 59:4">ሱረተን ፕርደይካ ባዋ።</para>
  <para style="q1" vid="ISA 59:4">ኤንቲ ጮ ፓላማን ጬቀቶሶና፤</para>
  <para style="q2" vid="ISA 59:4">ዎርዶ ኦደቶሶና፤</para>
  <para style="q2" vid="ISA 59:4">ጭሞ ቃንትድ ኢታተ የሎሶና።<verse eid="ISA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 59:5"/>ኤንቲ ሾሻ ጱጱለ ሀጶሶና፤</para>
  <para style="q2" vid="ISA 59:5">ሻንጎ ሃዳ ዳዶሶና።</para>
  <para style="q1" vid="ISA 59:5">ሄ ጱጱለታ ምያ አስ ሀይቄስ፤</para>
  <para style="q2" vid="ISA 59:5">ጱጱልያፈ እሶይ መቅኮ፥</para>
  <para style="q2" vid="ISA 59:5">እያፐ ሾሽ ከዬስ።<verse eid="ISA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 59:6"/>ኤንቲ ዳድዳ ሻንጎ ሃዳይ ማኦስ ሀነና፤</para>
  <para style="q2" vid="ISA 59:6">እያራ ባንታ አሳተ ካማናዉ ዳንዳኦኮና።</para>
  <para style="q1" vid="ISA 59:6">ኤንታ ኦሶይ ኢታ፤</para>
  <para style="q2" vid="ISA 59:6">ጌላ ኦሶይ ኤንታ ኩሸን ኩምስ።<verse eid="ISA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 59:7"/>ኤንታ ቶሆት ኢታባ ኦናዉ ዎፆሶና፤</para>
  <para style="q2" vid="ISA 59:7">ፅሎ ሱ ጉሳናዉ ኤሶቶሶና።</para>
  <para style="q1" vid="ISA 59:7">ኤንታ ቆፋይ ኢታ፤ ኤንቲ ብዳ በሳ ኡባን</para>
  <para style="q2" vid="ISA 59:7">ቆሆይነ ቦሽ ደኤስ።<verse eid="ISA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 59:8"/>ኤንቲ ሳሮተ ኦገ ኤሮኮና፤</para>
  <para style="q2" vid="ISA 59:8">ኤንታ ኦግያን ሱረ ፕርድ ባዋ።</para>
  <para style="q1" vid="ISA 59:8">ኤንቲ ባንታ ኦግያ ጌላይዶሶና፤</para>
  <para style="q2" vid="ISA 59:8">ሄ ኦግያራ ሄመትያ ኦንካ ሳሮ ደመና።<verse eid="ISA 59:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 59:9"/>ሄሳ ግሾ፥ ሱረ ፕርድ ኑፐ ሃክስ፤</para>
  <para style="q2" vid="ISA 59:9">ፅሎተ ኑኮ ሺቀና።</para>
  <para style="q1" vid="ISA 59:9">ኑኒ ፖኦ ኮዮስ፥ ሽን ማ ግድስ፤</para>
  <para style="q2" vid="ISA 59:9">ዋጋጋ ፖኦ ኮዮስ፥</para>
  <para style="q2" vid="ISA 59:9">ሽን ሳካና ማን ሄመቶስ።<verse eid="ISA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 59:10"/>ኑኒ ቆቀዳ ድርሳ ግምብያ ቦላ ታታፎስ፤</para>
  <para style="q2" vid="ISA 59:10">ሴታ ጋላስ፥ ሳእ ለምእን ሄመትያዳ በቶስ፤</para>
  <para style="q2" vid="ISA 59:10">ዎልቃራ ደእያ አሳ ግዶን</para>
  <para style="q2" vid="ISA 59:10">ኑኒ ሀይቅዳ አሳ መላ ግድዳ።<verse eid="ISA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 59:11"/>ኑኒ ኡባይ ባባንዳ ዋሶስ፤</para>
  <para style="q2" vid="ISA 59:11">ሆለዳ ካዮትድ ኦሎስ።</para>
  <para style="q1" vid="ISA 59:11">ኑኒ ሱረ ፕርዳ ኮይዳ፥</para>
  <para style="q2" vid="ISA 59:11">ሽን ደምቦኮ፤</para>
  <para style="q2" vid="ISA 59:11">አቶተ ኮይዳ፥ ሽን እ ኑፐ ሃክስ።<verse eid="ISA 59:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 59:12"/>ኑ ባላይ ነ ስንን ዳርስ፤</para>
  <para style="q2" vid="ISA 59:12">ኑ ናጋራይ ኑ ቦላ ማርካቴስ።</para>
  <para style="q1" vid="ISA 59:12">ኑ ናቆይ ኑራ ደኤስ፤</para>
  <para style="q2" vid="ISA 59:12">ኑ ቆሁዋ ኑ ኤሮስ።<verse eid="ISA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 59:13"/>ኑኒ ማካልድ፥ ጎዳ ካዳ፤</para>
  <para style="q2" vid="ISA 59:13">ኑ ፆሳ አግድ ጉየ ስምዳ።</para>
  <para style="q1" vid="ISA 59:13">ጌላተነ ገነ ኦደትዳ፤</para>
  <para style="q2" vid="ISA 59:13">ኑኒ ዎርዶ ቃንትድ ዎርዶ የልዳ።<verse eid="ISA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 59:14"/>ሱረ ፕርድ ጉየ ሱገትስ፤</para>
  <para style="q2" vid="ISA 59:14">ፅሎተ ኑፐ ሃክስ።</para>
  <para style="q1" vid="ISA 59:14">ቱማተ ዳባባን በቴስ፤</para>
  <para style="q2" vid="ISA 59:14">አማነተ ገላናዉ በሰ ይስ።<verse eid="ISA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 59:15"/>ቱማተ አዉንካ በንተና፤</para>
  <para style="q2" vid="ISA 59:15">ኢታተፈ ሃክያ አስ ቆሆስ አድ እመቴስ፤</para>
  <para style="q2" vid="ISA 59:15">ጎዳይ ሱረ ፕርድ ባይናይሳ በእድ አዛንስ።<verse eid="ISA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 59:16"/>ኡንኤተይሳታ ማድያ አስነ</para>
  <para style="q2" vid="ISA 59:16">ኤንታዉ ጋናትያ አስ ባይናይሳ</para>
  <para style="q2" vid="ISA 59:16">ጎዳይ በእድ ማላለትስ።</para>
  <para style="q1" vid="ISA 59:16">ሄሳ ግሾ፥ እያ ቀሰይ እያዉ አቶተ ኤህስ፤</para>
  <para style="q2" vid="ISA 59:16">እያ ፅሎተይ እያ ካትስድ ኦይክስ።<note caller="-" style="x"><char style="xo" closed="false">59:16 </char><char style="xt" closed="false"><ref loc="ISA 63:5">እሳ 63:5</ref>.</char></note><verse eid="ISA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 59:17"/>እ፥ ፅሎተ ትራን ዎያ ኦላ ሚሸዳ ማእስ፤</para>
  <para style="q2" vid="ISA 59:17">ባ ሁጵያን አቶተ ባርኔፃ ዎስ፤</para>
  <para style="q2" vid="ISA 59:17">ሀሎ ከስ ማኦዳ፥ ሀንቆ አፍላዳ ማእስ።<verse eid="ISA 59:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 59:18"/>እ ኤንታዉ ኤንታ ኦሱዋዳ ኦሱዋዳ ዛራና፤</para>
  <para style="q2" vid="ISA 59:18">ሀንቁዋ ባ ሞርከታስ፥</para>
  <para style="q2" vid="ISA 59:18">ሴራ ባራ ኤቀተይሳታስ ጭጋና፤</para>
  <para style="q2" vid="ISA 59:18">ዩሾይ አባን ተቀትዳ ቢታታስ ኤንታ ኦሱዋዳ እማና።<verse eid="ISA 59:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 59:19"/>ጎዳ ፔኖይ ዎልቃማ ጎተዳ ድእሸ ያና ግሾ፥</para>
  <para style="q2" vid="ISA 59:19">ዉሎሀ ባጋን ደኤይሳት ጎዳ ሱንስ ያያና፤</para>
  <para style="q2" vid="ISA 59:19">ዶሎሀ ባጋን ደኤይሳት እያ ቦንቻና።<verse eid="ISA 59:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 59:20"/>“ፅዮነስነ ያይቆባ ዘረ ግዶን</para>
  <para style="q2" vid="ISA 59:20">ባንታ ናጋራፐ ስመይሳታ ዎዘይስ ያና።<verse eid="ISA 59:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 59:21"/>ታዉ ኤንታራ ደእያ ጫቆይ ሀይሳ፦</para>
  <para style="q2" vid="ISA 59:21">ህንተ ቦላ ደእያ ታ አያናይነ</para>
  <para style="q2" vid="ISA 59:21">ታኒ ህንተ ዶናን ዎዳ ታ ቃላይ፥</para>
  <para style="q2" vid="ISA 59:21">ሀችፈ ዶምድ፥ መርና ጋካናዉ፥</para>
  <para style="q2" vid="ISA 59:21">ህንተ ዶናፐ፥ ህንተ ናይታ ዶናፐነ</para>
  <para style="q2" vid="ISA 59:21">ህንተ ናይታ ናይታ ዶናፐ ሻከተና”</para>
  <para style="m" vid="ISA 59:21">ያጌስ ጎዳይ።<verse eid="ISA 59:21"/></para>
  <chapter eid="ISA 59"/>
  <chapter number="60" style="c" sid="ISA 60"/>
  <para style="s1">ፅዮነ ቦንቹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 60:1"/>ነ ፖኦይ ይዳ ግሾ፥ ደንዳዳ ፖእሳ፤</para>
  <para style="q2" vid="ISA 60:1">ጎዳ ቦንቾይ ነ ቦላ ፖአና።<verse eid="ISA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 60:2"/>ሄኮ፥ ም ሳኣ፥ ሳካና ም አሳ ካማና፤</para>
  <para style="q2" vid="ISA 60:2">ሽን ጎዳይ ነ ቦላ ደንዳና፤</para>
  <para style="q2" vid="ISA 60:2">እያ ቦንቾይ ነ ቦላ ፖአና።<verse eid="ISA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 60:3"/>ካዎተት ነ ፖኡዋኮ፥</para>
  <para style="q2" vid="ISA 60:3">ካዎትካ ነ ዎንታ ፆልቀኮ ያና።<verse eid="ISA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 60:4"/>ቁ ጋዳ ነ ዩሹዋ ፄላ፤</para>
  <para style="q2" vid="ISA 60:4">ኡባይ እስፈ ኔኮ ያና።</para>
  <para style="q1" vid="ISA 60:4">ነ አደ ናይት ሃሆፐ ያና፤</para>
  <para style="q2" vid="ISA 60:4">ነ ማጫ ናይት ባኤትድ ኔኮ ያና።<verse eid="ISA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 60:5"/>ሄ ዎደ ኔኒ በአዳ ኡፋይታና፤</para>
  <para style="q2" vid="ISA 60:5">ነ ዎዛናይ ኡፋይሳን ኖጩ ጋና።</para>
  <para style="q1" vid="ISA 60:5">አባ ቦላ ደእያ ሻሎይ ኔኮ ያና፤</para>
  <para style="q2" vid="ISA 60:5">ካዎተታ ዱረተይ ነባ ግዳና።<verse eid="ISA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 60:6"/>ምድያመፐነ ኤፋ ቢታፈ ይዳ፥</para>
  <para style="q2" vid="ISA 60:6">ግማለ ዉደይ ነ ቢታ ካማና።</para>
  <para style="q2" vid="ISA 60:6">ዎርቃነ እፃነ ኤሄይሳት</para>
  <para style="q2" vid="ISA 60:6">ጎዳ ጋላታ አዋጅሸ ሳባፐ ያና።<verse eid="ISA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 60:7"/>ቀዳረነ ነባዮታ ዶርሳ ዉደ ኡባይ፥</para>
  <para style="q2" vid="ISA 60:7">ታ ያርሾ በሳ ኔኮ ያና፤</para>
  <para style="q2" vid="ISA 60:7">ታኒ ታ ቦንቾ ኬ ቦንቻና።<verse eid="ISA 60:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 60:8"/>“ሀይሳቲ ሻራዳ ዎይኮ ሆለዳ</para>
  <para style="q2" vid="ISA 60:8">ባንታ ኬኮ ፓለይሳት ኦኔ?<verse eid="ISA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 60:9"/>ቱማ ዩሾይ አባን ተቀትዳ ቢታት፥</para>
  <para style="q2" vid="ISA 60:9">ታናን ኡፋይስ ዎና፤</para>
  <para style="q1" vid="ISA 60:9">እስራኤለ ጌሻይ፥ ጎዳይ ህንተ ፆሳይ፥</para>
  <para style="q2" vid="ISA 60:9">ህንተና ቦንችዳ ግሾ፥</para>
  <para style="q1" vid="ISA 60:9">ታርሰሳ ማርካበት ስንት ከይድ፥</para>
  <para style="q2" vid="ISA 60:9">ነ ናይታ ሃሆ ቢታፈ ኤንታ ብራራነ ዎርቃራ</para>
  <para style="q2" vid="ISA 60:9">ፆሳ ቦንቹዋስ ኤሀና።<verse eid="ISA 60:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 60:10"/>“አላጋ ቢታት ነ ድርሳ ግምባና፤</para>
  <para style="q2" vid="ISA 60:10">ኤንታ ካዎት ነዉ ኦና።</para>
  <para style="q1" vid="ISA 60:10">ነና ታኒ ታ ሀንቁዋን ካሰ ሾጫስ፥</para>
  <para style="q2" vid="ISA 60:10">ሽን ሀእ ታ ቃያን ነና ማራስ።<verse eid="ISA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 60:11"/>ነ ፐንገት ኡባ ዎደ ዶያ ዳና፤</para>
  <para style="q2" vid="ISA 60:11">ካዎተታ ዱረተይነ</para>
  <para style="q2" vid="ISA 60:11">ኤንታ ካዎት ድኤትድ ኔኮ ያና መላ</para>
  <para style="q2" vid="ISA 60:11">ጋላስነ ቃማ ጎርደቶኮና።<verse eid="ISA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 60:12"/>ነዉ ኦና አስ</para>
  <para style="q2" vid="ISA 60:12">ዎይኮ ካዎተ ኡባይ ያና።<verse eid="ISA 60:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 60:13"/>ታ ኬ በሳ ሎይና መላ</para>
  <para style="q2" vid="ISA 60:13">ልባኖሰ ቦንቾ ግድዳ ዝጋይ፥</para>
  <para style="q2" vid="ISA 60:13">ፂዳይነ ፃይይ ኔኮ ያና፤</para>
  <para style="q2" vid="ISA 60:13">ታኒ ታ ቶሁዋ ዎያ በሳ ቦንቻና።<verse eid="ISA 60:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 60:14"/>ነና ኡንኤዳ አሳ ናይት ይድ ነዉ ሆካና፤</para>
  <para style="q2" vid="ISA 60:14">ነና ካዳ ኡባይ ነ ስንን ጎይናና።</para>
  <para style="q1" vid="ISA 60:14">ኤንቲ ነና፥ ‘ጎዳ ካታመ፥ ፅዮነ፥</para>
  <para style="q2" vid="ISA 60:14">እስራኤለ፥ ጌሻ ካታመ’ ያግድ ፄጋና።<verse eid="ISA 60:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 60:15"/>“ሀይሳፈ ካሰ ኦንካ ነ ግዶራ ካንና መላ</para>
  <para style="q2" vid="ISA 60:15">የገታዳሳነ እፀታዳሳ።</para>
  <para style="q1" vid="ISA 60:15">ሽን ሀእ ታኒ ነና መርናዉ ግታ ኦና፤</para>
  <para style="q2" vid="ISA 60:15">የለተ ኡባይ ነናን ኡፋይታና።<verse eid="ISA 60:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 60:16"/>ኔኒ ካዎተታ ማ ኡያና፤</para>
  <para style="q2" vid="ISA 60:16">ካዎታ ን ማና።</para>
  <para style="q1" vid="ISA 60:16">ጎዳይ፥ ነና አሸይሳ፥ ዎዘይሳነ</para>
  <para style="q2" vid="ISA 60:16">ያይቆባ ዎልቃማ ግደይሳ ኔኒ ኤራና።<verse eid="ISA 60:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 60:17"/>ናሰ ብራታ ግሾ ዎርቃ፥</para>
  <para style="q2" vid="ISA 60:17">ብራታ ግሾ ብራ፥ ም ግሾ ናሰ ብራታ፥</para>
  <para style="q2" vid="ISA 60:17">ሹቻ ግሾ ብራታ ታኒ ነዉ ኤሀና።</para>
  <para style="q1" vid="ISA 60:17">ታኒ፥ ሳሮተ ነና አይሰይሳ፥</para>
  <para style="q2" vid="ISA 60:17">ፅሎተ ነዉ ሀላቃ ኦና።<verse eid="ISA 60:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 60:18"/>ጌላተ ነ ቢታን፥ ዮይ ዎይኮ ቦሽ</para>
  <para style="q2" vid="ISA 60:18">ነ ዛዋን ስኤተና።</para>
  <para style="q1" vid="ISA 60:18">ኔኒ ነ ድርሳ ግምብያ፥ ‘አቶተ’፥</para>
  <para style="q2" vid="ISA 60:18">ነ ፐንግያ፥ ‘ጋላታ’ ያጋዳ ፄጋና።<verse eid="ISA 60:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 60:19"/>ጋላስ አዋ ፖኦ፥ ቃማ አጌና ፖኦ ነዉ ኮሸና፤</para>
  <para style="q2" vid="ISA 60:19">ጎዳይ ነዉ መርና ፖኦ፥</para>
  <para style="q2" vid="ISA 60:19">ነ ፆሳይ ነዉ ቦንቾ ግዳና።<verse eid="ISA 60:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 60:20"/>አው ናምአን ዉለና፤</para>
  <para style="q2" vid="ISA 60:20">ነ አጌናይ ፖኦ አገና።</para>
  <para style="q1" vid="ISA 60:20">ጎዳይ ነዉ መርና ፖኦ ግዳና፤</para>
  <para style="q2" vid="ISA 60:20">ኔኒ ዬክዳ ጋላሳት ነዉ ግዳና።<verse eid="ISA 60:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 60:21"/>ነ አሳ ኡባይ ፅሎ ግዳና፤</para>
  <para style="q2" vid="ISA 60:21">ኤንቲ ቢታ መርናዉ ላታና።</para>
  <para style="q1" vid="ISA 60:21">ኤንቲ ታኒ ታ ቦንቹዋ ቆንጭሳናዉ ቶክዳ ፑቶታ፤</para>
  <para style="q2" vid="ISA 60:21">ታ ኩሸ ኦሶታ።<verse eid="ISA 60:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 60:22"/>ህንተ ግዶን እስ ኬን ደእያ ጉ አሳታ ዳርሳና፤</para>
  <para style="q2" vid="ISA 60:22">ኡባፈ ጉ ግታ ካዎተ ኦና።</para>
  <para style="q1" vid="ISA 60:22">ታኒ ጎዳ፤ ዎደይ ጋክያ ዎደ፥</para>
  <para style="q2" vid="ISA 60:22">ታኒ ሄሳ ኤሶን ፖላና” ያጌስ።<verse eid="ISA 60:22"/></para>
  <chapter eid="ISA 60"/>
  <chapter number="61" style="c" sid="ISA 61"/>
  <para style="s1">አቶተ ምሽራቾ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 61:1"/>ኡባ ሃርያ ጎዳ አያናይ ታ ቦላ ደኤስ፤</para>
  <para style="q2" vid="ISA 61:1">ማንቆታስ ሎኦባ ኦዳና መላ ጎዳይ ታና ትይስ።</para>
  <para style="q1" vid="ISA 61:1">ዎዛን መቅዳይሳታ ኮላና መላ፥</para>
  <para style="q2" vid="ISA 61:1">ድኤትዳይሳታ ላአ ከሳና መላነ</para>
  <para style="q2" vid="ISA 61:1">ቃሸትዳይሳታ ብላና መላ ጎዳይ ታና ኪትስ።<verse eid="ISA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 61:2"/>ዶሰትዳ ጎዳ ላይ ኦዳና መላ፥</para>
  <para style="q2" vid="ISA 61:2">ኑ ፆሳይ ሀሎ ከያና ጋላሳ አዋጃና መላ፥</para>
  <para style="q2" vid="ISA 61:2">አዛነይሳታ ኡባ ምንና መላ ታና ኪትስ።<verse eid="ISA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 61:3"/>ፅዮነን ካዮተይሳታስ፥ ብዶ ግሾ ካላቻ፥</para>
  <para style="q2" vid="ISA 61:3">ዬሆ ግሾ ኡፋይሳ ዛይተ፥</para>
  <para style="q2" vid="ISA 61:3">አዛኖ ግሾ ጋላታ ማኦ እማና መላ ታና ኪትስ።</para>
  <para style="q1" vid="ISA 61:3">ኤንቲ ጎዳይ ባ ቦንቹዋስ</para>
  <para style="q2" vid="ISA 61:3">ቶክዳ ፅሎ ም ጌተትድ ፄገታና።<verse eid="ISA 61:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 61:4"/>ኤንቲ በን ላለትዳ በሳታ ዛሪድ ኬፃና፤</para>
  <para style="q2" vid="ISA 61:4">በን ኩንድዳ በሳታ ዛሪድ ኤሳና።</para>
  <para style="q1" vid="ISA 61:4">ኤንቲ ዳሮ የለተፈ ካሰ ላለትድ</para>
  <para style="q2" vid="ISA 61:4">ኦንዳ ካታማታ ዛሪድ ኬፃና።<verse eid="ISA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 61:5"/>አላጋ አሳት ህንተ ዶርሳ ዉድያ ሄማና፤</para>
  <para style="q2" vid="ISA 61:5">እማት ህንተ ጋድያ ጎያና</para>
  <para style="q2" vid="ISA 61:5">ኤንቲ ህንተ ዎይነ ጋድያ ናጋና።<verse eid="ISA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 61:6"/>አሳይ ህንተና፥ “ጎዳ ካህነታነ</para>
  <para style="q2" vid="ISA 61:6">ኑ ፆሳ ኦሳንቾታ” ያግድ ፄጋና።</para>
  <para style="q1" vid="ISA 61:6">ህንተ ካዎተታ ዱረተ ማና፤</para>
  <para style="q2" vid="ISA 61:6">ኤንታ ሻሉዋን ህንተ ናሸታና።<verse eid="ISA 61:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 61:7"/>ታ አሳይ ባንታ ዬላ ግሾ ናምኡ ኩሸ ኤካና፤</para>
  <para style="q2" vid="ISA 61:7">ባንታ ካዉሻ ግሾ ላታን ኡፋይታና።</para>
  <para style="q1" vid="ISA 61:7">ሄሳ ግሾ፥ ህንተ ኤንታ ቢታን ዳኮ ላታና፤</para>
  <para style="q2" vid="ISA 61:7">ህንተ ኡፋይሳይ መርና ኡፋይስ ግዳና።<verse eid="ISA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 61:8"/>“ታኒ፥ ጎዳይ ሱረ ፕርዳ ዶሳይስ፤</para>
  <para style="q2" vid="ISA 61:8">ቦንቀነ ኢታ ኦሶ እፃይስ።</para>
  <para style="q1" vid="ISA 61:8">ታኒ ቱማ ኤንታ ኦሱዋ ጋትያ ቃንፃና፤</para>
  <para style="q2" vid="ISA 61:8">ታኒ ኤንታራ መርናዉ ጫቃና።<verse eid="ISA 61:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 61:9"/>ኤንታ ኮቻት ካዎተታ ግዶን፥</para>
  <para style="q2" vid="ISA 61:9">ኤንታ ናይት ደረታ ግዶን ኤረታና፤</para>
  <para style="q2" vid="ISA 61:9">ኤንታ በእዳ ኡባይ ታኒ፥ ጎዳይ፥</para>
  <para style="q2" vid="ISA 61:9">ኤንታ አንጅዳ አስ ግደይሳ ኤራና።”<verse eid="ISA 61:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 61:10"/>ታኒ ጎዳን ዳሮ ኡፋይታይስ፤</para>
  <para style="q2" vid="ISA 61:10">ታ ሸምፕያ ታ ፆሳን ሀሹ ጋዉሱ።</para>
  <para style="q1" vid="ISA 61:10">ኤከይስ ባ ሁጰን ካላቻ ዎይሳዳ፥</para>
  <para style="q2" vid="ISA 61:10">ገልያራ ባና አሌቅሰይሳዳ፥</para>
  <para style="q1" vid="ISA 61:10">እ ታና አቶተ ማኦ ማይዝስ፤</para>
  <para style="q2" vid="ISA 61:10">ፅሎተ አፍላ ቦላራ ጉጅስ።<verse eid="ISA 61:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 61:11"/>ቢታፈ ም ማት ዶለይሳዳ፥</para>
  <para style="q2" vid="ISA 61:11">ጋደይ ቶክዳባ ድቸይሳዳ፥</para>
  <para style="q1" vid="ISA 61:11">ኡባ ሃርያ ጎዳይ ፅሎተነ</para>
  <para style="q2" vid="ISA 61:11">ጋላታ ካዎተ ኡባ ስንን ፑርጭሳና።<verse eid="ISA 61:11"/></para>
  <chapter eid="ISA 61"/>
  <chapter number="62" style="c" sid="ISA 62"/>
  <para style="s1">ፅዮነ ኦራ ሱን</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 62:1"/>ፅዮነ ግሾ፥ ታኒ ስእ ጊከ፤</para>
  <para style="q2" vid="ISA 62:1">የሩሳላመ ፅሎተይ ፖኦዳ፥</para>
  <para style="q1" vid="ISA 62:1">እ አቶተይ ዎንታ ፃልቀዳ ከያና ጋካናዉ</para>
  <para style="q2" vid="ISA 62:1">ታኒ ስእ ጊከ።<verse eid="ISA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 62:2"/>ካዎተት ነ ፅሎተ፥</para>
  <para style="q2" vid="ISA 62:2">ካዎት ኡባይ ነ ቦንቹዋ በአና።</para>
  <para style="q1" vid="ISA 62:2">ጎዳይ ሱንያ ኦራ ሱንን</para>
  <para style="q2" vid="ISA 62:2">ኔኒ ፄገታና።<verse eid="ISA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 62:3"/>ኔኒ ጎዳ ኩሸን ሎእዳ</para>
  <para style="q2" vid="ISA 62:3">ካዎተ ካላቻ ግዳና።<verse eid="ISA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 62:4"/>ኔኒ፥ “ዶገትዳሮ” ጌተታካ፤</para>
  <para style="q2" vid="ISA 62:4">ነ ቢትያ፥ “ን” ጌተቱኩ።</para>
  <para style="q1" vid="ISA 62:4">ሽን ኔኒ፥ “ታ ኡፋይሳይ እን ደእያሮ”፥</para>
  <para style="q2" vid="ISA 62:4">ነ ቢትያ፥ “አዝና ገልዳሮ” ጌተታና።</para>
  <para style="q1" vid="ISA 62:4">ጎዳይ ነናን ኡፋይታና፤</para>
  <para style="q2" vid="ISA 62:4">ነ ቢትያካ አዝን ደእያሮ ግዳና።<verse eid="ISA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 62:5"/>ፓን ጌላኦ ኤከይሳዳ፥</para>
  <para style="q2" vid="ISA 62:5">ነ ናይት ነና ማቻና።</para>
  <para style="q1" vid="ISA 62:5">ኤከይስ ገልያርን ኡፋይተይሳዳ፥</para>
  <para style="q2" vid="ISA 62:5">ነ ፆሳይ ነናን ኡፋይታና።<verse eid="ISA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 62:6"/>ነኖ የሩሳላመ፥ ነ ድርሳ ግምብያ ቦላ</para>
  <para style="q2" vid="ISA 62:6">ዎቸይሳታ ታኒ ዎስ፤</para>
  <para style="q2" vid="ISA 62:6">ኤንቲ ጋላስነ ቃማ ስእ ጎኮና።<verse eid="ISA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 62:7"/>ህንተኖ፥ ጎዳ ቆፍሰይሳቶ፥</para>
  <para style="q2" vid="ISA 62:7">እ፥ የሩሳላመ ኬፃና ጋካናዉነ</para>
  <para style="q2" vid="ISA 62:7">ቢታ ኡባን ናሸትዳ ካታማ ኦና ጋካናዉ</para>
  <para style="q2" vid="ISA 62:7">ህንተካ ሸምፖፕተ፤ እያካ ሸምፕሶፕተ።<verse eid="ISA 62:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 62:8"/>ጎዳይ ባ ኡሻቻ ኩሽያንነ</para>
  <para style="q2" vid="ISA 62:8">ባ ዎልቃማ ቀስያን ሀይሳዳ ያግድ ጫቅስ፦</para>
  <para style="q1" vid="ISA 62:8">“ታኒ ናምአን ህንተ ካ</para>
  <para style="q2" vid="ISA 62:8">ህንተ ሞርከት ማና መላ ኦከ።</para>
  <para style="q1" vid="ISA 62:8">ህንተ ዳቡርዳ ህንተ ዎይነ ኡሻ</para>
  <para style="q2" vid="ISA 62:8">አላጋት ኡዮኮና።<verse eid="ISA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 62:9"/>ሽን ባንታ ካ ጫክዳይሳት</para>
  <para style="q2" vid="ISA 62:9">ምድ ጎዳ ጋላታና፤</para>
  <para style="q2" vid="ISA 62:9">ዎይነ ማፀይሳት ታ ኬ ዳባባን ኡያና።<verse eid="ISA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 62:10"/>አተ! ፐንገራ ከይድ ቢተ!</para>
  <para style="q2" vid="ISA 62:10">አሳስ ኦገ ጊግስተ! ዎጋ ኦገ ከስተ።</para>
  <para style="q1" vid="ISA 62:10">ሹቻ ድግተ፤</para>
  <para style="q2" vid="ISA 62:10">ካዎተት ኦግያ ደማና መላ ማላ ኤስተ።<verse eid="ISA 62:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 62:11"/>ጎዳይ ሳአ ጋፃስ</para>
  <para style="q2" vid="ISA 62:11">ሀይሳዳ ያግድ አዋጅስ:<note caller="-" style="x"><char style="xo" closed="false">62:11 </char><char style="xt" closed="false"><ref loc="ISA 40:10">እሳ 40:10</ref>፤ <ref loc="REV 22:12">ቆን 22:12</ref>.</char></note></para>
  <para style="q1" vid="ISA 62:11">‘ፅዮነ አሳስ ሀይሳዳ ያግተ፤</para>
  <para style="q2" vid="ISA 62:11">ሄኮ፥ ህንተና አሸይስ ጋክስ!</para>
  <para style="q1" vid="ISA 62:11">እያ ጋተይ እያራ ደኤስ፤</para>
  <para style="q2" vid="ISA 62:11">እ እምያ ዎይቶይ እያ ስንን ደኤስ’</para>
  <para style="m" vid="ISA 62:11">ያግተ።<verse eid="ISA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 62:12"/>ህንተ፥ ‘ጎዳይ ዎዝዳ ጌሻ አሳታ’</para>
  <para style="q2" vid="ISA 62:12">ጌተትድ ፄገታና።</para>
  <para style="q1" vid="ISA 62:12">የሩሳላመይ፥ ‘ኮየትያሮነ</para>
  <para style="q2" vid="ISA 62:12">የገታ አታቦና ካታምዉ’ ” ጌተታና።<verse eid="ISA 62:12"/></para>
  <chapter eid="ISA 62"/>
  <chapter number="63" style="c" sid="ISA 63"/>
  <para style="s1">ፆሳ ፕርዳ ጋላስ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 63:1"/>ኤዶመ ቢታን፥ ባሶራ ካታማፐ</para>
  <para style="q2" vid="ISA 63:1">ዞኦ ማኦ ማእድ የይ ሀይስ ኦኔ?</para>
  <para style="q1" vid="ISA 63:1">ቦንቾ ማኦ ማእድ</para>
  <para style="q2" vid="ISA 63:1">ባ ዎልቃ ምኖተን ስን ሆርዶፈይ ኦኔ?</para>
  <para style="q1" vid="ISA 63:1">“ፅሎ ኦደተይነ</para>
  <para style="q2" vid="ISA 63:1">አሽያ ዎልቅ ደኤይ ታና”</para>
  <para style="m" vid="ISA 63:1">ያጌስ ጎዳይ።<verse eid="ISA 63:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 63:2"/>ዎይነ ጉምእያሶን ዎይነ የያ አሳ ማኦዳ</para>
  <para style="q2" vid="ISA 63:2">ነ ማኦይ አይስ ዞእዴ?<verse eid="ISA 63:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 63:3"/>“ታኒ ዎይነ ጉምእያሶን ዎይንያ ታርካ የስ፤</para>
  <para style="q2" vid="ISA 63:3">ካዎተታፐ እስ አስካ ታራ ባዋ።</para>
  <para style="q1" vid="ISA 63:3">ታኒ ኤንታ ታ ሀንቁዋን የስ፤</para>
  <para style="q2" vid="ISA 63:3">ታ ይሉዋን ኤንታ ድርፀረስ።</para>
  <para style="q1" vid="ISA 63:3">ኤንታ ሱይ ታ ማኡዋ ቦላ ርጨትን፥</para>
  <para style="q2" vid="ISA 63:3">ታ ማኦ ኡባይ ኢትስ።<verse eid="ISA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 63:4"/>ታኒ ታ አሳ ዎዝያ ጋላሳይነ</para>
  <para style="q2" vid="ISA 63:4">ኤንታ ሞርከታ ሀሎ ከይያ ላይይ ጋክስ።<verse eid="ISA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 63:5"/>ታኒ በአስ፥</para>
  <para style="q2" vid="ISA 63:5">ሽን ታና ማድያ እስ አስካ ደማብከ፤</para>
  <para style="q2" vid="ISA 63:5">ማደይ ይዳ ግሾ፥ ታኒ ማላለታስ።</para>
  <para style="q1" vid="ISA 63:5">ሄሳ ግሾ፥ ታ ቀሰይ ታዉ አቶተ ኤህስ፤</para>
  <para style="q2" vid="ISA 63:5">ታ ሀንቆይ ታና ማድስ።<verse eid="ISA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 63:6"/>ታኒ ታ ሀንቁዋን ካዎተታ የስ፤</para>
  <para style="q2" vid="ISA 63:6">ታ ይሉዋን ኤንታ ድርፀረስ፤</para>
  <para style="q2" vid="ISA 63:6">ኤንታ ሱ ቢታን ጉሳስ” ያጌስ ጎዳይ።<verse eid="ISA 63:6"/></para>
  <para style="s1">ዎሳነ ጋላታ</para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 63:7"/>ጎዳይ ኑስ ኦዳ ኦሶ ኡባ፥</para>
  <para style="q2" vid="ISA 63:7">ጎዳይ ባ ማሮተንነ ባ ቃያን</para>
  <para style="q1" vid="ISA 63:7">እስራኤለ አሳስ ኦዳ ሎኦ ኦሶ ኡባነ</para>
  <para style="q2" vid="ISA 63:7">እያ ሱንይ ጋላተታና መላ</para>
  <para style="q2" vid="ISA 63:7">በስዳ ኬሀተ ኡባ ታኒ ኦዳና።<verse eid="ISA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 63:8"/>እ፥ “ኤንቲ ቱማ ታ አሰነ ታ ናአ ግድያ ግሾ፥</para>
  <para style="q2" vid="ISA 63:8">ታዉ ዎርዶቶኮና” ያግስ።</para>
  <para style="q2" vid="ISA 63:8">ሄሳ ግሾ፥ እ ኤንታ አሸይሳ ግድስ።<verse eid="ISA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 63:9"/>ኤንታ ዋየ ኡባ እ ዋየትስ፤</para>
  <para style="q2" vid="ISA 63:9">እያ ስን ኪታንቾይ ኤንታ አሽስ።</para>
  <para style="q1" vid="ISA 63:9">እ ኤንታ ባ ሲቁዋንነ ባ ማሮታን ዎዝስ፤</para>
  <para style="q2" vid="ISA 63:9">ካሰ አዳ ዎደታ ኡባን እ ኤንታ ቶክስ።<verse eid="ISA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 63:10"/>ሽን ኤንቲ ማካልዶሶና፤</para>
  <para style="q2" vid="ISA 63:10">እያ ጌሻ አያና አዛንዶሶና።</para>
  <para style="q1" vid="ISA 63:10">ሄሳ ግሾ፥ እ ስሚድ፥</para>
  <para style="q2" vid="ISA 63:10">ኤንታዉ ሞርከ ግድስ፤ ኤንታ ኦልስ።<verse eid="ISA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 63:11"/>ሄሳፈ ጉየ አሳይ በንባነ</para>
  <para style="q2" vid="ISA 63:11">ባ አይልያ ሙሰ ዎደ ኦዳባ ቆፕድ፥</para>
  <para style="q2" vid="ISA 63:11">ሀይሳዳ ያግዶሶና፦</para>
  <para style="q1" vid="ISA 63:11">“ባ ዉድያ ሄንንቾታራ እስፈ</para>
  <para style="q2" vid="ISA 63:11">አባ ግዶራ ካንስዳ ፆሳይ አዉን ደኢ?</para>
  <para style="q1" vid="ISA 63:11">ሄ ዎደ ባ ጌሻ አያና ኤንታ ግዶን፥</para>
  <para style="q2" vid="ISA 63:11">ዎዳ ፆሳይ ሀእ አዉን ደኢ?<verse eid="ISA 63:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 63:12"/>ባዉ መርና ሱን ግዳና መላ</para>
  <para style="q2" vid="ISA 63:12">ኤንታ ስንን ሃ ሻክድ፥ ባ ቦንቾ ዎልቃማ ቀሰይ</para>
  <para style="q2" vid="ISA 63:12">ሙሰስ ኡሻቻ ኩሸ ግዳና መላ ኪትዳይስ አዉን ደኢ?<verse eid="ISA 63:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 63:13"/>ቢታ ቦላራ ፓር ብያዳ ኤንቲ በቶና</para>
  <para style="q2" vid="ISA 63:13">ጪሞ ሃ ግዶራ ፕንዳይስ አዉን ደኢ?”</para>
  <para style="m" vid="ISA 63:13">ያግዶሶና። <verse eid="ISA 63:13"/><verse number="14" style="v" sid="ISA 63:14"/>ዛንጋራ ዎያ መሄዳ፥</para>
  <para style="q2" vid="ISA 63:14">ጎዳ አያናይ ኤንታዉ ሸምፖ እሚስ።</para>
  <para style="q1" vid="ISA 63:14">ነ ሱንይ ቦንቸታና መላ</para>
  <para style="q2" vid="ISA 63:14">ሄሳዳ ኦዳ ነ አሳ ካለዳሳ።<verse eid="ISA 63:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 63:15"/>አቤት ጎዳዉ፥ ሳሎራ ዱገ ፄላ፤</para>
  <para style="q2" vid="ISA 63:15">ኔኒ ደእያ ጌሽነ</para>
  <para style="q2" vid="ISA 63:15">ቦንቾ ግድዳ አራታፐ በአ።</para>
  <para style="q1" vid="ISA 63:15">ነ ቅናተይነ ነ ዎልቃይ አኔ?</para>
  <para style="q2" vid="ISA 63:15">ነ ማሮታይነ ነ ቃይ ኑፐ ሃክስ።<verse eid="ISA 63:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 63:16"/>አብራሃመይ ኑና ኤሮና እፅኮካ፥</para>
  <para style="q2" vid="ISA 63:16">ያይቆብ ኑና አኬኮና እፅኮካ፥</para>
  <para style="q2" vid="ISA 63:16">አቤት ጎዳዉ፥ ኔኒ ኑ አዋ፤</para>
  <para style="q2" vid="ISA 63:16">በንፐ ዶምድ፥ ነ ሱንይ ኑና ዎዘይሳ።<verse eid="ISA 63:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 63:17"/>አቤት ጎዳዉ፥ ኑኒ ነ ኦግያፐ</para>
  <para style="q2" vid="ISA 63:17">ያናዳነ ነዉ ያዮናዳ</para>
  <para style="q2" vid="ISA 63:17">ኑ ዎዛና አይስ ሙምሳዲ?</para>
  <para style="q1" vid="ISA 63:17">ጎዳዉ፥ ነ አይለታ ግሾ፥</para>
  <para style="q2" vid="ISA 63:17">ነ ላታ ግድዳ ኮቻታ ግሾ፥</para>
  <para style="q2" vid="ISA 63:17">ኑኮ ስማ።<verse eid="ISA 63:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 63:18"/>ነ ጌሻ አሳይ</para>
  <para style="q2" vid="ISA 63:18">ነ ኬ ጉ ዎደስ ላትዶሶና፤</para>
  <para style="q2" vid="ISA 63:18">ሽን ሀእ ኑ ሞርከት እያ የዶሶና።<verse eid="ISA 63:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 63:19"/>ኑኒ በንፐ ነባ፤</para>
  <para style="q2" vid="ISA 63:19">ሽን ኤንታ ኔኒ ሃራባካ፤</para>
  <para style="q2" vid="ISA 63:19">ነ ሱንንካ ኤንቲ ፄገትቦኮና።<verse eid="ISA 63:19"/></para>
  <chapter eid="ISA 63"/>
  <chapter number="64" style="c" sid="ISA 64"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 64:1"/>አቤት ጎዳዉ፥ ሳሎታ ዳካዳ ዱገ ዎ፤</para>
  <para style="q2" vid="ISA 64:1">ደረት ነ ስንን ኮኮሮ።<verse eid="ISA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 64:2"/>ታም ኤፅድ ሃ ፐንትሰይሳዳ ዱገ ዎዳ፥</para>
  <para style="q2" vid="ISA 64:2">ነ ሱን ነ ሞርከታ ኤርሳ፤</para>
  <para style="q2" vid="ISA 64:2">ካዎተታካ ነ ስንን ኮኮርሳ።<verse eid="ISA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 64:3"/>ካሰ ኑኒ ናግቦና ማላታታ</para>
  <para style="q2" vid="ISA 64:3">ኔኒ ኦዳ ዎደ ዎዳሳ፤</para>
  <para style="q2" vid="ISA 64:3">ደረት ነ ስንን ኮኮርዶሶና።<verse eid="ISA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 64:4"/>በንፐ ዶምድ፥ ነና አማነትድ፥</para>
  <para style="q2" vid="ISA 64:4">ናገይሳታስ ማላታታ ኦዳይ ኔፐ አትሽን፥</para>
  <para style="q2" vid="ISA 64:4">ሀራ ፆሲ፥ አሳ ሀይ ስእቤና፤</para>
  <para style="q2" vid="ISA 64:4">አሳ አይፈይ በእቤና።<verse eid="ISA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 64:5"/>ኡፋይትድ ፅሎተ ኦይሳታነ</para>
  <para style="q2" vid="ISA 64:5">ነ ኦግያ ቆፐይሳታ ኔኒ ማዳዳሳ።</para>
  <para style="q1" vid="ISA 64:5">ሽን ኑኒ ናጋራ ኦሶ አጎና እፅዳ ዎደ</para>
  <para style="q2" vid="ISA 64:5">ኔኒ ሀንቀታዳሳ፤ ኑኒ ዋንድ አታኔ?<verse eid="ISA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 64:6"/>ኑኒ ኡባይ ቱና አስ ግድዳ፤</para>
  <para style="q2" vid="ISA 64:6">ኑ ፅሎተ ኦሶ ኡባይ ቱና ጩርቃ መላ።</para>
  <para style="q1" vid="ISA 64:6">ኑ ኡባይ ቦንጮዳ ቆለትዳ፤</para>
  <para style="q2" vid="ISA 64:6">ኑ ናጋራይ ኑና ጫርኮዳ ፕትድ ኤፍስ።<verse eid="ISA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 64:7"/>ኔኒ ነ ስን ኑፐ ገንዳሳ፤</para>
  <para style="q2" vid="ISA 64:7">ኑ ናጋራይ ኑና ይሳና መላ አጋዳሳ።</para>
  <para style="q1" vid="ISA 64:7">ነ ሱን ፄገይ ዴና፤</para>
  <para style="q2" vid="ISA 64:7">ነና ምንድ ኦይካናዉ ኮየይ ባዋ።<verse eid="ISA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 64:8"/>ግዶሽን፥ አቤት ጎዳዉ፥ ኔኒ ኑ አዋ፤</para>
  <para style="q2" vid="ISA 64:8">ኑኒ ኡርቃ፤ ነ ኡርቃ መዳሳ፤</para>
  <para style="q2" vid="ISA 64:8">ኑኒ ኡባይ ነ ኩሸን መትዳ።<verse eid="ISA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 64:9"/>አቤት ጎዳዉ፥ ዳሮ ሀንቀቶፋ፤</para>
  <para style="q2" vid="ISA 64:9">ኑ ናጋራ መርናዉ ቆፖፋ።</para>
  <para style="q1" vid="ISA 64:9">ኑኒ ኡባይ ነ አሰ ግድያ ግሾ፥</para>
  <para style="q2" vid="ISA 64:9">ኑና በአ።<verse eid="ISA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 64:10"/>ነ ጌሻ ካታማት መላ ቢታ ግድዶሶና፤</para>
  <para style="q2" vid="ISA 64:10">ፅዮነ ካታማይ መላ ቢታ፥</para>
  <para style="q2" vid="ISA 64:10">የሩሳላመይ ባይሳ ግድስ።<verse eid="ISA 64:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 64:11"/>ኑ አዋት እያን ነና ጋላትዳ ጌሽነ</para>
  <para style="q2" vid="ISA 64:11">ሎኦ ግድዳ ኑ ፆሳ ኬይ ታማን ፁገትስ፤</para>
  <para style="q2" vid="ISA 64:11">ኑ ሎኦ በሳ ኡባይ ላለትስ።<verse eid="ISA 64:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 64:12"/>አቤት ጎዳዉ፥ ኔኒ ሀይሳ ኡባ በአሸ ስእ ጋኔ?</para>
  <para style="q2" vid="ISA 64:12">ሀ ኡባይ ሀንን፥ ኑኮ ስምኪ?</para>
  <para style="q2" vid="ISA 64:12">ኔኒ ስእ ጋዳ ዛው ባይና ሴራኔ?<verse eid="ISA 64:12"/></para>
  <chapter eid="ISA 64"/>
  <chapter number="65" style="c" sid="ISA 65"/>
  <para style="s1">ፕርዳነ አቶተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 65:1"/>“ታና ኦይችቦናይሳታስ ቆንጫስ፤</para>
  <para style="q2" vid="ISA 65:1">ታና ኮይቦናይሳታስ በንታስ።</para>
  <para style="q1" vid="ISA 65:1">ታ ሱን ፄግቦና ካዎተስ፥</para>
  <para style="q2" vid="ISA 65:1">‘ዬ! ዬ!’ ያጋዳ ኮያስ።<note caller="-" style="x"><char style="xo" closed="false">65:1 </char><char style="xt" closed="false"><ref loc="ROM 10:20">ሮመ 10:20</ref>.</char></note><verse eid="ISA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 65:2"/>ባንታ ቆፋ ካልድ፥</para>
  <para style="q2" vid="ISA 65:2">ሎኦ ግዶና ኦግያን ሄመትያ ጌላ አሳስ</para>
  <para style="q2" vid="ISA 65:2">ጋላስ ኩመ ታ ኩሽያ ምጫስ።<verse eid="ISA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 65:3"/>ሀ አሳይ፥ ታ ስንን አታክልተ ጋደን ያርሽሸነ</para>
  <para style="q2" vid="ISA 65:3">ፁበ ያርሾ በሳን እፃነ ጩይስሸ</para>
  <para style="q2" vid="ISA 65:3">ታና ኡባ ዎደ ሀንቀሶና።<verse eid="ISA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 65:4"/>ኤንቲ ዱፎን ኡተይሳታ፥ ጌማ በሳን አቀይሳታ፥</para>
  <para style="q2" vid="ISA 65:4">ጉዱን አሾ መይሳታ፤ ኤንታ ፃሩዋን፥</para>
  <para style="q2" vid="ISA 65:4">ቱና አሾ ጫምብ ደኤይሳታ።<verse eid="ISA 65:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 65:5"/>“ኤንቲ፥ ‘ነዉ ያን ደአ፤</para>
  <para style="q2" vid="ISA 65:5">ታኒ ኔፐ ጌሽ ግድያ ግሾ</para>
  <para style="q2" vid="ISA 65:5">ታኮ ሺቆፓ!’ ያጎሶና።</para>
  <para style="q1" vid="ISA 65:5">ሄሳ መላ አሳት ሲ ቱጭያ ጩያ መላ፤</para>
  <para style="q2" vid="ISA 65:5">ጋላስ ኩመ ኤፅያ ታማ መላ።<verse eid="ISA 65:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 65:6"/>“ሄኮ፥ ታ ስንን ፃፈት ኡትስ፤</para>
  <para style="q2" vid="ISA 65:6">ታኒ ኤንታዉ ዛራና ስእ ጊከ፤</para>
  <para style="q2" vid="ISA 65:6">ኤንታ ሴራናዉ ደንዳስ።<verse eid="ISA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 65:7"/>ታኒ ኤንታ ናጋራነ ኤንታ አዋታ ናጋራ</para>
  <para style="q2" vid="ISA 65:7">አጩዋ እስፈ ኤንታዉ ቃንፃና።</para>
  <para style="q1" vid="ISA 65:7">ኤንቲ ደርያ ቦላ እፃነ ጩይስዶሶና፤</para>
  <para style="q2" vid="ISA 65:7">ዙማታ ቦላ ታና ጫይዶሶና።</para>
  <para style="q1" vid="ISA 65:7">ኤንቲ ካሰ ኦዳ ኦሱዋ አጩዋ</para>
  <para style="q2" vid="ISA 65:7">ታኒ ኤንታዉ ቃንፃና” ያጌስ ጎዳይ።<verse eid="ISA 65:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 65:8"/>ጎዳይ ያጌስ፦</para>
  <para style="q1" vid="ISA 65:8">“ኢታ ዎይነ ሱሳ ግዶን</para>
  <para style="q2" vid="ISA 65:8">ሎኦ ዎይነ አይፈይ ደኤይሳዳ፥</para>
  <para style="q2" vid="ISA 65:8">አሳይ፥ ‘እያ ግዶን ሎኦ ዎይነ አይፈይ ደእያ ግሾ</para>
  <para style="q2" vid="ISA 65:8">ኡባ ዎራ ሆሎፕተ’ ገይሳ መላ፥</para>
  <para style="q1" vid="ISA 65:8">ታኒ ታ አይለታ ሀይሳዳ ኦና፤</para>
  <para style="q2" vid="ISA 65:8">ታኒ ኤንታ ኡባ ይስከ።<verse eid="ISA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 65:9"/>ታኒ ያይቆባፐ ኮቸ፥</para>
  <para style="q1" vid="ISA 65:9">ይሁዳፐ ታ ደርያ ላተይሳታ ከሳና፤</para>
  <para style="q2" vid="ISA 65:9">ታ ዶርዳይሳት እያ ላታና፤ ታ አይለት ያን ዳና።<verse eid="ISA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 65:10"/>ታና ምንድ ኮይያ ታ አሳስ፥</para>
  <para style="q2" vid="ISA 65:10">ሳሮን ዶርሳ ዉደይ ሄመትያ በሲ ግዳና፤</para>
  <para style="q2" vid="ISA 65:10">አኮራ ዛንጋራይ ሚዛ ዉደይ አላትያ በሲ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">65:10 </char><char style="xt" closed="false"><ref loc="JOS 7:24-25">እያ 7:24-25</ref>.</char></note><verse eid="ISA 65:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 65:11"/>“ሽን ህንተኖ፥ ጎዳ አግድ፥</para>
  <para style="q2" vid="ISA 65:11">ታ ጌሻ ዙማ ዶግዳይሳቶ፥</para>
  <para style="q2" vid="ISA 65:11">‘ቃዳ’ ጌተትያ ኤቃስ ግብራ ጊግሰይሳቶ፥</para>
  <para style="q2" vid="ISA 65:11">ህንተ ዉርሰ ኤራናዉ</para>
  <para style="q2" vid="ISA 65:11">‘ሳማ’ ጌተትያ ኤቃስ ዋላሀ ዎይነ</para>
  <para style="q2" vid="ISA 65:11">ኡሻ ዋንጫን ኩንይሳቶ፥<verse eid="ISA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 65:12"/>ታኒ ህንተ ዉርሰ ማሻስ አዳ እማና፤</para>
  <para style="q2" vid="ISA 65:12">ህንተ ኡባይ ጎይረታናዉ ሆካና።</para>
  <para style="q1" vid="ISA 65:12">ታኒ ህንተና ፄግን ኮይበከታ፤</para>
  <para style="q2" vid="ISA 65:12">ኦድስን ስእቤከታ።</para>
  <para style="q1" vid="ISA 65:12">ህንተ ታ ስንን ኢታባ ኦደታ፤</para>
  <para style="q2" vid="ISA 65:12">ታኒ ዶሶናባ ዶርደታ።”<verse eid="ISA 65:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 65:13"/>ኡባ ሃርያ ጎዳይ ያጌስ፦</para>
  <para style="q2" vid="ISA 65:13">“ታ አይለት ማና፥ ሽን ህንተ ኮሻታና፤</para>
  <para style="q2" vid="ISA 65:13">ታ አይለት ኡያና፥ ሽን ህንተ ሳሞታና፤</para>
  <para style="q2" vid="ISA 65:13">ታ አይለት ኡፋይታና፥ ሽን ህንተ ዬላታና።<verse eid="ISA 65:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 65:14"/>ታ አይለት ዎዛናፐ ኡፋይትድ የፃና፥</para>
  <para style="q2" vid="ISA 65:14">ሽን ህንተ ዎዛናፐ ካዮታና፤</para>
  <para style="q2" vid="ISA 65:14">ህንተ አያናይ መቅዳ ግሾ፥</para>
  <para style="q2" vid="ISA 65:14">ህንተ ዘሌልድ ዬካና።<verse eid="ISA 65:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 65:15"/>ህንተ፥ ህንተ ሱን ታ ዶረትዳ ደርያስ</para>
  <para style="q2" vid="ISA 65:15">ቃንገ ኦድ እማና።</para>
  <para style="q1" vid="ISA 65:15">ኡባ ሃርያ ጎዳይ ህንተና ዎና፤</para>
  <para style="q2" vid="ISA 65:15">ሽን እ ባ አይለታ ዱማ ሱንን ፄጋና።<verse eid="ISA 65:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 65:16"/>ካሰ መቶት ዶገትዳ ግሾነ</para>
  <para style="q2" vid="ISA 65:16">ታ አይፍያ ስንፈ ጌምዳ ግሾ</para>
  <para style="q2" vid="ISA 65:16">ሄ ቢታን አንጆ ኮይያ ኡባይ</para>
  <para style="q2" vid="ISA 65:16">ቱማ ፆሳ ሱንን ዎሳና።</para>
  <para style="q1" vid="ISA 65:16">ሄ ቢታን ጫቆ ጫቅያ ኡባይ</para>
  <para style="q2" vid="ISA 65:16">ቱማ ፆሳ ሱንን ጫቃና።<verse eid="ISA 65:16"/></para>
  <para style="s1">ኦራ ሳሎነ ሳአ</para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 65:17"/>“ሄኮ፥ ታኒ ኦራ ሳሎታነ</para>
  <para style="q2" vid="ISA 65:17">ኦራ ሳአ መና፤</para>
  <para style="q2" vid="ISA 65:17">ካሰባ ኡባይ ሀሳየተና፤ ቆፈተና።<verse eid="ISA 65:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 65:18"/>ሽን ታኒ መያባን</para>
  <para style="q2" vid="ISA 65:18">መርናዉ ኡፋይትተነ ሀሹ ጊተ።</para>
  <para style="q1" vid="ISA 65:18">ታኒ የሩሳላመ ኡፋይሳስነ</para>
  <para style="q2" vid="ISA 65:18">እ አሳካ ጋላታን ኩምዳይሳታ ኦዳ መና።<verse eid="ISA 65:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 65:19"/>ታኒ የሩሳላመን ኡፋይታና፤</para>
  <para style="q2" vid="ISA 65:19">ታ አሳን ሀሹ ጋና።</para>
  <para style="q1" vid="ISA 65:19">ህዛፐ ጉየ ዬሆይነ</para>
  <para style="q2" vid="ISA 65:19">ኡንአ ዋሶይ ያን ስኤተና።<verse eid="ISA 65:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 65:20"/>“የሩሳላመን ህዛፐ ጉየ፥</para>
  <para style="q2" vid="ISA 65:20">ጉ ዎደ ደእድ ሀይቅያ ናእ፥</para>
  <para style="q2" vid="ISA 65:20">ባ ላይ ዉርሶና ሀይቅያ ጭማ አስ ዴና።</para>
  <para style="q1" vid="ISA 65:20">ፄቱ ላይራ ሀይቅያ ኡራይ፥</para>
  <para style="q2" vid="ISA 65:20">ናአተን ሀይቅስ ጌተታና፤</para>
  <para style="q2" vid="ISA 65:20">ፄቱ ላይ ጋና ሀይቀይ፥</para>
  <para style="q2" vid="ISA 65:20">ባደትዳ አሳዳ ታይበታና።<verse eid="ISA 65:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 65:21"/>ሄ ዎደ አሳይ ኬ ኬፅድ ዳና፤</para>
  <para style="q2" vid="ISA 65:21">ዎይነ ቶክድ እያ አይፍያ ማና።<verse eid="ISA 65:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 65:22"/>ኤንቲ ኬፅን ሀር ዴና፤</para>
  <para style="q2" vid="ISA 65:22">ኤንቲ ቶክን ሀር ሜና።</para>
  <para style="q1" vid="ISA 65:22">ታ አሳ ላይይ ም ላይዳ አዱቃና፤</para>
  <para style="q2" vid="ISA 65:22">ታኒ ዶርዳይሳት አዱሳ ዎደ</para>
  <para style="q2" vid="ISA 65:22">ባንታ ኩሸ ኦሱዋን ኡፋይታና።<verse eid="ISA 65:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 65:23"/>ኤንቲ ጮ ዳቡሮኮና</para>
  <para style="q2" vid="ISA 65:23">ቃድ ባይና ናአ የሎኮና።</para>
  <para style="q1" vid="ISA 65:23">ኤንቲ ባንታ ናይታራ</para>
  <para style="q2" vid="ISA 65:23">ጎዳን አንጀትዳ ኮቻታ ግዳና።<verse eid="ISA 65:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 65:24"/>ኤንቲ ታና ፄጋናፐ ስን፥</para>
  <para style="q2" vid="ISA 65:24">ታኒ ኤንታዉ ኮያና፤</para>
  <para style="q2" vid="ISA 65:24">ኤንቲ ቡሮ ሃሳዮና ደእሽን</para>
  <para style="q2" vid="ISA 65:24">ታኒ ኤንታ ስአና።<verse eid="ISA 65:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 65:25"/>ሱመይነ ዶርሳ ኡርገይ እስፈ ሄመታና፤</para>
  <para style="q2" vid="ISA 65:25">ጋሞይ ቦራዳ ካለ ማና፤</para>
  <para style="q2" vid="ISA 65:25">ባን ሾሻስ ካ ግዳና።</para>
  <para style="q1" vid="ISA 65:25">ሄ ዎደ ታ ጌሻ ዙማ ቦላ</para>
  <para style="q2" vid="ISA 65:25">ኤንቲ ቆሄቶኮናነ ዮኮና”<note caller="-" style="x"><char style="xo" closed="false">65:25 </char><char style="xt" closed="false"><ref loc="ISA 11:6-9">እሳ 11:6-9</ref>.</char></note></para>
  <para style="m" vid="ISA 65:25">ያጌስ ጎዳ ፆሳይ።<verse eid="ISA 65:25"/></para>
  <chapter eid="ISA 65"/>
  <chapter number="66" style="c" sid="ISA 66"/>
  <para style="s1">ፕርዳነ ኡፋይስ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 66:1"/>ጎዳይ ያጌስ፤</para>
  <para style="q2" vid="ISA 66:1">ሳሎይ ታ አራታ፥</para>
  <para style="q2" vid="ISA 66:1">ሳእ ታ ቶሆይ የያ በሰ።</para>
  <para style="q1" vid="ISA 66:1">ያትን ህንተ ታዉ ኬፅያ ኬይ፥</para>
  <para style="q2" vid="ISA 66:1">አይ መላ ኬ?</para>
  <para style="q2" vid="ISA 66:1">ታ ሸምፓና በሳይ አዉሴ?<note caller="-" style="x"><char style="xo" closed="false">66:1 </char><char style="xt" closed="false"><ref loc="MAT 5:34">ማቶ 5:34</ref>፤ <ref loc="MAT 23:22">23:22</ref>.</char></note><verse eid="ISA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 66:2"/>ሀይሳ ኡባ ታ ኩሸይ ኦስ፤</para>
  <para style="q2" vid="ISA 66:2">ኤንትካ ሀንዶሶና።</para>
  <para style="q1" vid="ISA 66:2">ሽን ታኒ ባና ዝቅ ኦያ ኡራ፥</para>
  <para style="q2" vid="ISA 66:2">ባ አያናን መቅዳ ኡራነ</para>
  <para style="q2" vid="ISA 66:2">ታ ቃላን ኮኮርያ ኡራ ፄላና።<verse eid="ISA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 66:3"/>ኮርማ ያርሸይ አሰ ዎያ አሳ መላ፤</para>
  <para style="q2" vid="ISA 66:3">ኡርገ ዶርስ ያርሸይ ካና ያርሽያ አሳ መላ፤</para>
  <para style="q2" vid="ISA 66:3">ካ ያርሾ ያርሸይ፥</para>
  <para style="q2" vid="ISA 66:3">ጉዱን ሱ ያርሽያ አሳ መላ፤</para>
  <para style="q2" vid="ISA 66:3">ቆፍሶ እፃነ ጩይሰይ ኤቃ ጎይንያ አሳ መላ።</para>
  <para style="q1" vid="ISA 66:3">አሳ ኡባይ ባዉ እንጀትያ ኦገ ዶርዶሶና፤</para>
  <para style="q2" vid="ISA 66:3">ኤንታ ሸምፖይ ኤንታ ቱናተን ኡፋይቴስ።<verse eid="ISA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 66:4"/>ሄሳ ግሾ፥ ታኒ ኤንታ መቶስ አ እማና፤</para>
  <para style="q2" vid="ISA 66:4">ኤንቲ ያይዳባ ኤንታ ቦላ ኤሀና።</para>
  <para style="q1" vid="ISA 66:4">ታኒ ፄግዳ ዎደ ኦንካ ኮይቤና፤</para>
  <para style="q2" vid="ISA 66:4">ታኒ ኦድያ ዎደ ኦንካ ስእቤና።</para>
  <para style="q1" vid="ISA 66:4">ኤንቲ ታ ስንን ኢታባ ኦዶሶና፤</para>
  <para style="q2" vid="ISA 66:4">ታና ኡፋይሶናባ ዶርዶሶና።<verse eid="ISA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 66:5"/>ህንተኖ፥ ጎዳ ቃላስ ኮኮረይሳቶ</para>
  <para style="q2" vid="ISA 66:5">እያ ቃላ ስእተ፦</para>
  <para style="q1" vid="ISA 66:5">“ህንተና እፅያ ህንተ እሻት፥ ታ ሱን ግሾ፥</para>
  <para style="q2" vid="ISA 66:5">ህንተና ኩረይሳት፥ ‘ህንተ ኡፋይትን ኑኒ በአና መላ</para>
  <para style="q2" vid="ISA 66:5">አነ ጎዳይ ቦንቸቶ’ ” ያግዶሶና፤</para>
  <para style="q2" vid="ISA 66:5">ሽን ኤንቲ ዬላታና።<verse eid="ISA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 66:6"/>ካታማፐ ያ ዋሱዋ ስእተ፤</para>
  <para style="q2" vid="ISA 66:6">ፆሳ ኬፈ ከይያ ግርሳ ስእተ።</para>
  <para style="q1" vid="ISA 66:6">ሄ ግርሳይ ባ ሞርከታስ ኤንታ ኦሱዋዳ</para>
  <para style="q2" vid="ISA 66:6">ኩሸ ዛርያ ጎዳ ግርሳ።<verse eid="ISA 66:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 66:7"/>“እቀቶና ናአ የልያ ማጫስ ደኢ?</para>
  <para style="q2" vid="ISA 66:7">ባናኮና አደ ናአ የልያ ማጫስ ደኢ?<note caller="-" style="x"><char style="xo" closed="false">66:7 </char><char style="xt" closed="false"><ref loc="REV 12:5">ቆን 12:5</ref>.</char></note><verse eid="ISA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 66:8"/>ሀይሳ መላባ ኦነ ስእዳይ?</para>
  <para style="q2" vid="ISA 66:8">ሄሳ መላባ ኦነ በእዳይ?</para>
  <para style="q1" vid="ISA 66:8">እስ ደረይ እስ ጋላስ የለታናዉ ዳንዳእዬ?</para>
  <para style="q2" vid="ISA 66:8">እስ ካዎተ ቅጵ ዛሮን መትዬ?</para>
  <para style="q1" vid="ISA 66:8">ፅዮነይ ቡሮ እቀ ኦይኮና፥</para>
  <para style="q2" vid="ISA 66:8">ኤለሳዳ ባ ናይታ የላሱ።<verse eid="ISA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 66:9"/>የላና ዎደ ጋያ ታኒ</para>
  <para style="q2" vid="ISA 66:9">ኤንቲ የላናዳ ኦክናዬ?</para>
  <para style="q1" vid="ISA 66:9">የላናዳ ኦያ ታኒ</para>
  <para style="q2" vid="ISA 66:9">የልያ ኡሎ ጎርዳይናዬ?</para>
  <para style="q2" vid="ISA 66:9">ሀይሳ ግዳይ ታና፥ ጎዳ፥ ነ ፆሳ።<verse eid="ISA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 66:10"/>ህንተኖ የሩሳላሞ ዶስያ ኡባዉ፥ ኢራ ኡፋይትተ፤</para>
  <para style="q2" vid="ISA 66:10">እ ግሾ ኡፋይሳን ኖጩ ጊተ።</para>
  <para style="q1" vid="ISA 66:10">ህንተኖ እዉ ዬክያ ኡባዉ፥</para>
  <para style="q2" vid="ISA 66:10">ኢራ ኡፋይትተ።<verse eid="ISA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 66:11"/>ህንተ፥ እያ ምንያ ን ምድ ካላና፤</para>
  <para style="q2" vid="ISA 66:11">እ ዳሮ ቦንቹዋፈ ሎይ ኡይድ፥ ኡፋይታና።”<verse eid="ISA 66:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 66:12"/>ጎዳይ ያጌስ፤</para>
  <para style="q1" vid="ISA 66:12">“ታኒ እዉ ሳሮተ ሻፋዳ ዳርሳና፤</para>
  <para style="q2" vid="ISA 66:12">እዉ ካዎተታ ዱረተ ክፃ ሻፋዳ ኤሀና።</para>
  <para style="q1" vid="ISA 66:12">ህንተ ሄሳ ማና፤ እ ሀሽያን ቶከታና፤</para>
  <para style="q2" vid="ISA 66:12">እ ክኦን ኡትድ ባሎታና።<verse eid="ISA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 66:13"/>አይያ ባ ናአ ምንይሳዳ</para>
  <para style="q2" vid="ISA 66:13">ታኒ ህንተና ምንና፤</para>
  <para style="q2" vid="ISA 66:13">ህንተ የሩሳላመን ምነታና።<verse eid="ISA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 66:14"/>ሄሳ ህንተ በእያ ዎደ ህንተ ዎዛናይ ኡፋይታና፤</para>
  <para style="q2" vid="ISA 66:14">ህንተ መቀይ ማታ መላ አጫና።</para>
  <para style="q1" vid="ISA 66:14">ጎዳ ኩሸይ እያ አይለታ ቦላ ደኤይስን</para>
  <para style="q2" vid="ISA 66:14">እያ ሀንቆይ እያ ሞርከታ ቦላ ደኤይስ ኤረታና።<verse eid="ISA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 66:15"/>ሄኮ፥ ጎዳይ ታማራ ያና፤</para>
  <para style="q2" vid="ISA 66:15">እያ ፓራ ጋረት ጎተ መላ።</para>
  <para style="q1" vid="ISA 66:15">ባ ሸንያ ሀንቆን፤</para>
  <para style="q2" vid="ISA 66:15">ባ ሴራካ ታማ ላጮን ቆንጭሴስ።<verse eid="ISA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 66:16"/>ጎዳይ አሾ ማእዳ ኡባ</para>
  <para style="q2" vid="ISA 66:16">ታማንነ ማሻን ፕርዳና፤</para>
  <para style="q2" vid="ISA 66:16">ዳሮት ጎዳ ማሻን ሀይቃና።<verse eid="ISA 66:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 66:17"/>“ባንታ ኤቃ ጎይናናዉ አታክልተ ጋደ ባናዉ፥</para>
  <para style="q2" vid="ISA 66:17">ባንታና ዱማየይሳትነ ጌሸይሳት፤</para>
  <para style="q2" vid="ISA 66:17">ጉዱን፥ ኤጨረነ ሀራ ቱናባታ መይሳታ ግዶፈ</para>
  <para style="q2" vid="ISA 66:17">እሱዋ ካልድ በይሳት ኡባይ ያና።<verse eid="ISA 66:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18"/>“ታኒ ኤንታ ኦሱዋነ ኤንታ ቆፋ ኤርያ ግሾ፥</para>
  <para style="q2" vid="ISA 66:18">ካዎተታነ ዱማ ዱማ ዶናን ኦደተይሳታ፥</para>
  <para style="q2" vid="ISA 66:18">እስፈ ሺሻና፤ ኤንቲ ሺቅድ፥ ታ ቦንቹዋ በአና።<verse eid="ISA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 66:19"/>ታኒ ኤንታ ግዶን ማላታ ኦና፤</para>
  <para style="q2" vid="ISA 66:19">ኤንታፈ አትዳይሳታ ግዶፈ</para>
  <para style="q2" vid="ISA 66:19">ታ ግታተ ስእቦናነ</para>
  <para style="q2" vid="ISA 66:19">ታ ቦንቹዋ በእቦና ካዎተታኮ፥</para>
  <para style="q1" vid="ISA 66:19">ታርሰሳኮ፥ ሊበኮ፥ ሊደኮ፥ ቱባላኮ፥</para>
  <para style="q2" vid="ISA 66:19">ያዋናኮነ ዩሾይ አባን ተቀትድ ሃሆ ቢታታኮ ኪታና፤</para>
  <para style="q2" vid="ISA 66:19">ኤንቲ ታ ቦንቹዋ ካዎተታ ግዶን አዋጃና።<verse eid="ISA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 66:20"/>እስራኤለ አሳይ ካ ያርሹዋ</para>
  <para style="q2" vid="ISA 66:20">ጌሻ ሚሸን ዎድ ፆሳ ኬ ኤሄይሳዳ፥</para>
  <para style="q2" vid="ISA 66:20">ኤንቲ ህንተ እሻታ ኡባ ካዎተታ ግዶፈ፥</para>
  <para style="q2" vid="ISA 66:20">ፓራታን፥ ፓራ ጋረታን፥ ግማለታን፥ ባቁሎታንነ</para>
  <para style="q2" vid="ISA 66:20">ጫነ ጋረታን ኡትስድ፥ ጎዳስ እሞ ኦድ</para>
  <para style="q2" vid="ISA 66:20">ታ ጌሻ ዙማ ቦላ የሩሳላመ ኤሀና።<verse eid="ISA 66:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 66:21"/>ኤንታፈ እሶታ እሶታ ካህነነ ሌወ ኦና”</para>
  <para style="m" vid="ISA 66:21">ያጌስ ጎዳይ።<verse eid="ISA 66:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 66:22"/>“ታኒ መዳ ኦራ ሳሎትነ</para>
  <para style="q2" vid="ISA 66:22">ኦራ ሳእ ታ ስንን ምንድ ደኤይሳዳ፥</para>
  <para style="q2" vid="ISA 66:22">ህንተ ኮቻይነ ህንተ ሱንይ ምንድ ዳና።<note caller="-" style="x"><char style="xo" closed="false">66:22 </char><char style="xt" closed="false"><ref loc="ISA 65:17">እሳ 65:17</ref>፤ <ref loc="2PE 3:13">2 ጰፅ 3:13</ref>፤ <ref loc="REV 21:1">ቆን 21:1</ref>.</char></note><verse eid="ISA 66:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 66:23"/>አጌና ፄሮፐ ብድ አጌና ፄሮ ጋካናዉ፥</para>
  <para style="q2" vid="ISA 66:23">ሳምባታፐ ብድ ሳምባታ ጋካናዉ</para>
  <para style="q2" vid="ISA 66:23">አሳ ኡባይ ታ ስንን ጎይናናዉ ያና።<verse eid="ISA 66:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 66:24"/>ኤንቲ ከይድ ብሸ፥</para>
  <para style="q2" vid="ISA 66:24">ታ ቦላ ማካልዳ አሳ አሀ በአና።</para>
  <para style="q1" vid="ISA 66:24">ኤንታ ምያ ጉፁነይ ሀይቀና፤</para>
  <para style="q2" vid="ISA 66:24">ኤንታ ፁግያ ታማይ ቶኤና፤</para>
  <para style="q2" vid="ISA 66:24">ኤንቲ አሳ ኡባስ ሻትያባ ግዳና”<note caller="-" style="x"><char style="xo" closed="false">66:24 </char><char style="xt" closed="false"><ref loc="MRK 9:48">ማር 9:48</ref>.</char></note></para>
  <para style="m" vid="ISA 66:24">ያጌስ ጎዳይ።<verse eid="ISA 66:24"/></para>
  <chapter eid="ISA 66"/>
</usx>
