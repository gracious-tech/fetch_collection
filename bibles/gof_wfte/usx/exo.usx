<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EXO" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ከሳ ማፃፋ</para>
  <para style="toc1">ከሳ ማፃፋ</para>
  <para style="toc3">ከሳ</para>
  <para style="toc2">ከሳ</para>
  <para style="mt">ከሳ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሀ ማፃፋ ሱን ብርሸይ “ከይድ ቡሱ” ዎይኮ “ከስ” ጉሱ። ሀ ማፃፋይ፥ እስራኤለ አሳይ ግብፀ ቢታ አይለተ ዱሳፈ ዋንድ ከይዳኮ ቆንጭሴስ። ሀ ማፃፋይ ኦይዱ ግታ ቆፋታን ሻከቴስ።</para>
  <para style="ipi">1. እስራኤለ አሳይ አይለተፈ ላአ ከስ</para>
  <para style="ipi">2. እስራኤለ አሳይ ሲና ዙማ ጋካናዉ ብዳ ቡሳ</para>
  <para style="ipi">3. ፆሳይ ባ አሳራ ጫቅዳ ጫቁዋነ እምዳ ዱማ ዱማ ህገታ</para>
  <para style="ipi">4. ጌሻ ዱንካንያ ኬፆ፥ እያ ግዶን ጎኤትያ ሚሸታነ ካህነታ ማኦ።</para>
  <para style="ip">ሀ ማፃፋይ፥ ፆሳይ ባ አሳ አይለተፈ ከስያ ዎደ አይ ኦዳኮ፥ ቃስ ኡፋይሳ ቃላ እምዳ ደረ ዋትድ ኦዳኮ ቆንጭስድ በሴስ።</para>
  <para style="ip">ፆሳይ ያይቆባ ሼሽ ግድዳ እስራኤለ አሳ ግብፀ ቢታፈ ከስያ ዎደ ኤንታ ካለና መላ ፆሳይ ፄግዳ አደይ ሙሰ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">እስራኤለ አሳ አይለተ ዱሳ (<char style="ior"><ref loc="EXO 1:1-22">1:1-22</ref></char>)</para>
  <para style="io1">ሙሰ የለተነ ናአተ ዎድያ (<char style="ior"><ref loc="EXO 2:1-25">2:1-25</ref></char>)</para>
  <para style="io1">ሙሰይነ አሮን ግብፀ ካዉዋ ስንን (<char style="ior"><ref loc="EXO 3:1-6:30">3:1—6:30</ref></char>)</para>
  <para style="io1">ታሙ ጋዶታነ ፓስካ ባኣለ (<char style="ior"><ref loc="EXO 7:1-13:22">7:1—13:22</ref></char>)</para>
  <para style="io1">እስራኤለ አሳይ ዞኦ አባ ፕነ (<char style="ior"><ref loc="EXO 14:1-15:21">14:1—15:21</ref></char>)</para>
  <para style="io1">ዞኦ አባፈ ሲና ዙማ ጋካናዉ (<char style="ior"><ref loc="EXO 15:22-18:27">15:22—18:27</ref></char>)</para>
  <para style="io1">ታሙ ኪታታነ ሀራ ህገታ (<char style="ior"><ref loc="EXO 19:1-24:18">19:1—24:18</ref></char>)</para>
  <para style="io1">ጌሻ ዱንካንያነ እያ ግዶን ጎኤትያ ሚሸታ (<char style="ior"><ref loc="EXO 25:1-27:21">25:1—27:21</ref></char>)</para>
  <para style="io1">ካህነታስ እመትዳ ኪታ፥ ያርሾነ ሳምባታ (<char style="ior"><ref loc="EXO 28:1-31:18">28:1—31:18</ref></char>)</para>
  <para style="io1">እስራኤለ አሳይ ባንታዉ ኤቃ መዶሶና (<char style="ior"><ref loc="EXO 32:1-35">32:1-35</ref></char>)</para>
  <para style="io1">ፆሳይ ባ ጫቁዋ ኦራድ ሀራ ህገታ እሚስ (<char style="ior"><ref loc="EXO 33:1-35:3">33:1—35:3</ref></char>)</para>
  <para style="io1">ጌሻ ዱንካንያስ እመትዳ እሞታነ ካህነታ ማኦ (<char style="ior"><ref loc="EXO 35:4-36:7">35:4—36:7</ref></char>)</para>
  <para style="io1">ጌሻ ዱንካንያ ኬፅዳ ሂላንቾታ (<char style="ior"><ref loc="EXO 36:8-38:31">36:8—38:31</ref></char>)</para>
  <para style="io1">ካህነታ ማኦነ ጌሻ ዱንካንያ ኤሶ (<char style="ior"><ref loc="EXO 39:1-40:30">39:1—40:30</ref></char>)</para>
  <chapter number="1" style="c" sid="EXO 1"/>
  <para style="s1">እስራኤለ አሳ ኡንኤተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1"/>ባንታ ሶ አሳ ኡባ ኤክድ፥ ያይቆባራ ግብፀ ብዳ እስራኤለ አደ ናይታ ሱንይ ሀይሳፈ ካልድ ፃፈትዳይሳ፤ <verse eid="EXO 1:1"/><verse number="2" style="v" sid="EXO 1:2"/>ኤንትካ ሮቤላ፥ ስሞና፥ ሌወ፥ ይሁዳ፥ <verse eid="EXO 1:2"/><verse number="3" style="v" sid="EXO 1:3"/>ይሳኮራ፥ ዛብሎና፥ ብንያመ፥ <verse eid="EXO 1:3"/><verse number="4" style="v" sid="EXO 1:4"/>ዳነ፥ ንፍታለመ፥ ጋደነ አሴራ። <verse eid="EXO 1:4"/><verse number="5" style="v" sid="EXO 1:5"/>ያይቆባ ሼሻት ኡባይ ላፑን ታማ። ዮሰፍ ካሰካ ግብፀን ደኤስ። <verse eid="EXO 1:5"/><verse number="6" style="v" sid="EXO 1:6"/>ዎደፐ ጉየን ዮሰፍ፥ እያ እሻትነ ሄ የለተ ኡባይ ሀይቅዶሶና። <verse eid="EXO 1:6"/><verse number="7" style="v" sid="EXO 1:7"/>ሽን እስራኤለ ሼሻይ የለትድ ግብፀ ቢታ ኩማና ጋካናዉ ታይቦን ዳርዶሶናነ ምንዶሶና።<verse eid="EXO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8"/>ሄሳፈ ጉየ፥ ዮሰፋ ኤሮና ሀራ ካዎይ ግብፀ ቢታን ካዎትስ። <verse eid="EXO 1:8"/><verse number="9" style="v" sid="EXO 1:9"/>ሄ ካዎይ ባ አሳ፥ “ሄኮ፥ ሀ እስራኤለት ኑፐ አድ የለተንነ ዎልቃን ዳርዶሶና። <verse eid="EXO 1:9"/><verse number="10" style="v" sid="EXO 1:10"/>ኑኒ ሂላቶና እፅኮ ኤንቲ ታይቦን ካሰይሳፈ ሃ ዳራና። ቆፖና ኦል ደንድኮ ኤንቲ ኑ ሞርከታራ እስፍድ ኑና ኦልድ፥ ቢታ የግድ ባናዉ ዳንዳኦሶና” ያግስ። <verse eid="EXO 1:10"/><verse number="11" style="v" sid="EXO 1:11"/>ሄሳ ግሾ ዴፆ ኦሶን ኤንታ ኡንኤና መላ ኤንታ ቦላ ኢታ ካፖታ ዎዶሶና። ኤንቲ ፕቶማነ ራምሰ ጌተትያ ሻሎ ዎያ ካታማታ ካዋስ ኬፅዶሶና። <verse eid="EXO 1:11"/><verse number="12" style="v" sid="EXO 1:12"/>ሽን ግብፀት ኤንታ ዳርስ ኡንኤንካ ኤንቲ ሃ ዳርድ የለትዶሶናነ ቢታ ጋክዶሶና። ግብፀት እስራኤለታ እፅዳ ግሾ ያይዶሶና። <verse eid="EXO 1:12"/><verse number="13" style="v" sid="EXO 1:13"/>ኤንታና ኢታ ኦሶ ኦስስዶሶና። <verse eid="EXO 1:13"/><verse number="14" style="v" sid="EXO 1:14"/>ኡርቃ የሶን፥ ስምንቶን ፁበ መን ቃስ ጋደ ኦስሶን ኤንታ ደኡዋ ጫምስዶሶና። ቃይ ባይና ዴፆ ኦሶ ኡባ ኤንታ ኦስስዶሶና።<verse eid="EXO 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15"/>ግብፀ ካዎይ ቃን እብራወ ማጫሳታ ኡሎ ፕትያ ስፖሮነ ፑሆ ጌተትያ ናምኡ ማጫሳታኮ ሀይሳዳ ያግስ፤ <verse eid="EXO 1:15"/><verse number="16" style="v" sid="EXO 1:16"/>“እብራወ ማጫሳት የልያ ዎደ የለትዳ ናአይ አደ ግድኮ ዎተ፥ ሽን ማጫ ግድኮ ፓፃ አግተ” ያግስ። <verse eid="EXO 1:16"/><verse number="17" style="v" sid="EXO 1:17"/>ሽን ኡሎ ፕተይሳት ፆሰ ባቢድ፥ ግብፀ ካዎይ ኪትዳይሳዳ ኦቦኮና። ኤንቲ አደ ናይታ ፓፃ አግዶሶና። <verse eid="EXO 1:17"/><verse number="18" style="v" sid="EXO 1:18"/>ሄሳፈ ጉየ፥ ግብፀ ካዎይ ሄ ኡሎ ፕተይሳታ ፄግድ፥ “ህንተ አይስ ሀይሳ ኦደቲ? አደ ናይታ አይስ ፓፃ አገቲ?” ያግድ ኤንታ ኦይችስ።<verse eid="EXO 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 1:19"/>ኡሎ ፕተይሳት ዛሪድ፥ “እብራወ ማጫሳት ግብፀ ማጫሳታ መላ ግዶኮና። ኤንቲ ምኖ ግድያ ግሾ ኡሎ ፕተይሳት ጋካናፐ ስንትድ የሎሶና” ያግዶሶና።<verse eid="EXO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 1:20"/>ሄሳ ግሾ ፆሳይ ኡሎ ፕተይሳታስ ኬህስ። እስራኤለ አሳይ ካሰይሳፈ ሃ ዳርሸነ ምንሸ ብዶሶና። <verse eid="EXO 1:20"/><verse number="21" style="v" sid="EXO 1:21"/>ቃስ ኡሎ ፕተይሳት ፆሳስ ያይዳ ግሾ ፆሳይ ኤንታዉ ኤንታ ሶ አስ እሚስ። <verse eid="EXO 1:21"/><verse number="22" style="v" sid="EXO 1:22"/>ሄሳፈ ጉየ ካዎይ ባ አሳ ኡባኮ፥ “እብራወታፐ የለትያ አደ ኡባ ናይለ ሻፋን የግተ፤ ሽን ማጫ ናእ የለትኮ ፓፃ አግተ” ያግድ ኪትስ።<verse eid="EXO 1:22"/></para>
  <chapter eid="EXO 1"/>
  <chapter number="2" style="c" sid="EXO 2"/>
  <para style="s1">ሙሰ የለተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1"/>ሄ ዎደ ሌወ ቆሞ ግድዳ እስ ኡራይ ሌወ ማጫስ እስዉ ኤክስ። <verse eid="EXO 2:1"/><verse number="2" style="v" sid="EXO 2:2"/>ሄ ማጫስያ አደ ናአ የላሱ። ናአይ ማላ ሎኦ ግደይሳ በአዳ ሄ አጌና ቆሳሱ። <verse eid="EXO 2:2"/><verse number="3" style="v" sid="EXO 2:3"/>ሽን እያ ሄሳፈ ዳሮ ቆሳናዉ ዳንዳኦናይሳ ኤራዳ፥ ማቃፈ ዳቾ ዳዳዳ፥ ማደ መላባ ትያዳ ናኣ እያን ዎሱ። ያታዳ ናይለ ሻፋ ጋፃን ማይጫ ግዶን ዎሱ። <verse eid="EXO 2:3"/><verse number="4" style="v" sid="EXO 2:4"/>እያ ምችያ እያ ጋክያባ በአናዉ ሃሆን ኤቃሱ።<verse eid="EXO 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5"/>ግብፀ ካዉዋ ናእያ ቦላ ሜጨታናዉ ናይለ ሻፋ ዎሱ። እ ማጫ አይለት ሃ ዶናን ይያ ሃ ስመረቶሶና። እያ ዳቾ ማይጫ ግዶን ደማዳ፥ ባ አይልዉ ባዳ ኤሀና መላ ኪታሱ። <verse eid="EXO 2:5"/><verse number="6" style="v" sid="EXO 2:6"/>ዳቾ ዶያዳ ሄ ጉ ናኣ በአሱ። እ ዬከይሳ በአዳ ቃታዳ፥ “ሀይስ እብራወታ ጉ ናይታፐ እሱዋ” ያጋሱ።<verse eid="EXO 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7"/>ሄ ዎደ እያ ምችያ ካዉዋ ናኤኮ፥ “ሀ ናኣ ንና መላ እብራወ ማጫስ ነዉ ኤሆ?” ያጋዳ ኦይቻሱ።<verse eid="EXO 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 2:8"/>እያ፥ “ኤ፥ ኤሀ” ያጋሱ። ናእያ ባዳ ናኣ አይዉ ኤሀሱ። <verse eid="EXO 2:8"/><verse number="9" style="v" sid="EXO 2:9"/>ካዉዋ ናእያ ማጫስዉ፥ “ሀ ናኣ ኤፋዳ፥ ታዉ ን፤ ድቻ፤ ታኒ ነዉ ዳሞዘ ቃንፃና” ያጋሱ። ማጫስያ ናኣ ኤፋዳ ንሱ። <verse eid="EXO 2:9"/><verse number="10" style="v" sid="EXO 2:10"/>ናአይ ድጭን፥ ካዉዋ ናኤኮ ኤሀሱ፤ እ እዉ ናአ ግድስ። “ታኒ ሃፈ እያ ከሳ ኤካስ” ጋዳ፥ እያ ሙሰ<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="fq" closed="false">ሙሰ: </char><char style="ft" closed="false">እብራወ ዶናን ሙሰ ጉሳይ “ከሶ” ጉሱ</char></note> ጋዳ ሱንሱ።<verse eid="EXO 2:10"/></para>
  <para style="s1">ሙሰይ ምድያመ ቢታን</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11"/>ሙሰይ ድጭዳፐ ጉየ እስ ጋላስ ባ አሳ በአናዉ ብድ፥ ኤንቲ ዴፆ ኦሶ ኦሽን ኤንታ በእስ። ግብፀ አስ እሶይ እብራወታፐ እሱዋ ባ ያራ ዋሽን በእስ። <verse eid="EXO 2:11"/><verse number="12" style="v" sid="EXO 2:12"/>እ ይያ ሃ ፄልን፥ ኦንካ ባይናይሳ በእድ፥ ሄ ግብፀ ኡራ ዎድ ሻፈን ቆስስ። <verse eid="EXO 2:12"/><verse number="13" style="v" sid="EXO 2:13"/>ዎንተ ጋላስ ከይድ፥ ናምኡ እብራወት ዋትሽን በእስ። ቆሄይሳኮ፥ “ኔኒ ነ ዳቡዋ አይስ ሾጫይ?” ያግድ ኦይችስ።<verse eid="EXO 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 2:14"/>ሄ ኡራይ፥ “ነና ኑ ቦላ ሃረይሳነ ዳይና ኦዳይ ኦኔ? ኔኒ ዝነ ግብፀ ኡራ ዎዳይሳዳ፥ ታናካ ዎናዉ ኮያይ?” ያግስ። ሙሰይ ሄ ዎደ፥ “ታኒ ኦዳባይ አሳን ኤረትስ” ያግ ቆፕድ ያይስ።<verse eid="EXO 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 2:15"/>ካዎይ ሄሳ ስእዳ ዎደ፥ ሙሰ ዎሳናዉ ኮይስ። ሽን ሙሰይ በትድ፥ ምድያመ ቢታን ደአናዉ ብስ።</para>
  <para style="p" vid="EXO 2:15">እስ ጋላስ እ ሃ ኦላ ዶናን ኡትስ።<verse eid="EXO 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 2:16"/>ሄ ዎደ ምድያመ ካህነ እሱዋስ ላፑን ማጫ ናይት ደኦሶና። ኤንቲ ባንታ አዋ ዶርሳታ ጎንገን ሃ ዱቅ ኡሻናዉ ይዶሶና። <verse eid="EXO 2:16"/><verse number="17" style="v" sid="EXO 2:17"/>ሄንንቾት ይድ ማጫ ናይታ ጎድዶሶና። ሽን ሙሰይ ኤንታ ማድድ ኤንታ ዶርሳታ ሃ ኡሽስ።<verse eid="EXO 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 2:18"/>ኤንቲ ባንታ አዋ የቶራኮ ይዳ ዎደ፥ “ሀች ዋን ኤለስ ይደቲ?” ያግድ ኦይችስ።<verse eid="EXO 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 2:19"/>ኤንቲ ዛሪድ፥ “ግብፀ አስ እሶይ ኑና ሄንንቾታፐ አሽስ። ሃ ዱቅድ ዶርሳታ ኡሽስ” ያግዶሶና።<verse eid="EXO 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 2:20"/>እ ባ ማጫ ናይታ፥ “ያትን እ አዉን ደኢ? ህንተ ሄ ኡራ አይስ አግድ ይደቲ? ኑራ ካ ማና መላ አነ እያ ፄግተ” ያግስ።<verse eid="EXO 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 2:21"/>ሙሰይ ሄ አድያራ ያን ደአናዉ ቆፋ ቃችስ። ዮቶር ባ ናእዉ ስፖሮ ሙሰስ ማቾ ኦድ እሚስ። <verse eid="EXO 2:21"/><verse number="22" style="v" sid="EXO 2:22"/>ስፖራ አደ ናአ የልን፥ ሙሰይ እያ፥ “ታኒ ሀ ቢታን በተ አስ” ግድ ገርሳማ ግድ ሱንስ።<verse eid="EXO 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23"/>ዳሮ ላይፈ ጉየ ግብፀ ካዎይ ሀይቅስ። ሽን እስራኤለት ባንታ አይለተን ኡንኤትድ ዋስዶሶና። ባንታ አይለተን ኤንቲ ዋስዳ ዋሶይ ፆሳኮ ጋክስ። <verse eid="EXO 2:23"/><verse number="24" style="v" sid="EXO 2:24"/>ፆሳይ ኤንታ ዋሱዋ ስእድ፥ እ አብራሃመራ፥ ይሳቃራነ ያይቆባራ ጫቅዳ ጫቁዋ ሀሳይስ። <verse eid="EXO 2:24"/><verse number="25" style="v" sid="EXO 2:25"/>ፆሳይ እስራኤለታ አይለተ ኡንኣ በእድ ኤንታና ቆፕስ።<verse eid="EXO 2:25"/></para>
  <chapter eid="EXO 2"/>
  <chapter number="3" style="c" sid="EXO 3"/>
  <para style="s1">ሙሰ ፄገተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1"/>እስ ዎደ ሙሰይ ምድያመ ቢታ ካህንያ፥ ባ ቦሉዋ ዮቶራ ዶርሳነ ዴሻ ሄሜስ። እ ሄ ዉድያ ላግ ኤክድ መላ ቢታ ጋፃን ፆሳ ዙማ ጌተትድ ፄገትያ ኮሬባ<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="fq" closed="false">ኮሬባ: </char><char style="ft" closed="false">ኮሬባ ዙማስ ሀራ ሱንይ ሲና ዙማ።</char></note> ዙማ ቦላ ኤፍስ። <verse eid="EXO 3:1"/><verse number="2" style="v" sid="EXO 3:2"/>ሄ በሳን ጎዳ ኪታንቾይ <note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">ጎዳ ኪታንቾይ: </char><char style="ft" closed="false">ሀ በሳን ጎዳ ኪታንቾ ጌተትዳይ አሳስ ቆንጭያ ጎዳ ዎይኮ ፆሳ ጉሱ።</char></note> ቱሽያን ኤፅያ ታማ ላጩዋ ግዶን እያዉ በንትስ። ሙሰይ ቱሸይ ታማን ኦይከትንካ ታማይ ቱሽያ ሞናይሳ በእድ፥ <verse eid="EXO 3:2"/><verse number="3" style="v" sid="EXO 3:3"/>“ታኒ ይያ ባዳ፥ ቱሸይ አይስ ታማን ሜተቶናኮ ሄ ኦራባ ሺቃዳ በአና” ግድ ቆፕስ።<verse eid="EXO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4"/>እ በአናዉ ሺቅዳይሳ ጎዳይ በእድ፥ ቱሽያ ግዶፈ፥ “ሙሰ! ሙሰ!” ግድ ፄግስ።</para>
  <para style="p" vid="EXO 3:4">ሙሰይ፥ “ሄኮ፥ አበ ጎዳዉ” ግድ ኮይስ።<verse eid="EXO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 3:5"/>ፆሳይ እያኮ፥ “ሃ ሺቆፓ። ኔኒ ኤቅዳ ቢታይ ጌሽ ግድያ ግሾ፥ ነ ቶሁዋን ደእያ ጫማ ከሳ” ያግስ። <verse eid="EXO 3:5"/><verse number="6" style="v" sid="EXO 3:6"/>ጎዳይ እያኮ፥ “ታኒ ነ አዋታ፥ አብራሃመ፥ ይሳቃነ ያይቆባ ፆሳ” ያግስ። ሙሰይ ፆሳ ባአናዉ ያይዳ ግሾ፥ ባ ሶምኡዋ ካምስ።<verse eid="EXO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7"/>ጎዳይ ቃስካ ሀይሳዳ ያግስ፤ “ታኒ ግብፀን ደእያ ታ አሳይ አይ መላ ዋያኮ በአስ። ኤንቲ ባንታና ኡንኤድ ሃረይሳታፐ አሻና መላ ታኮ ዋስያ ዋሱዋ ስአስ። ኤንታ ዋያካ ኤራይስ። <verse eid="EXO 3:7"/><verse number="8" style="v" sid="EXO 3:8"/>ሄሳ ግሾ፥ ታኒ ኤንታ ግብፀ አሳ ኩሸፐ አሻናዉነ ሄ ቢታፈ ኤንታ ከሳዳ፥ ሀእ ካናነት፥ ህተት፥ አሞረት፥ ፓርዘት፥ ህወትነ ያቡሰት ደእያ ቢታ፥ ማነ ኤስ ኩምዳ ሎኦ ቢታ ኤሀናዉ ዎስ። <verse eid="EXO 3:8"/><verse number="9" style="v" sid="EXO 3:9"/>ታ ደርያ ዋሶይ ሀእ ታና ጋክስ። ግብፀ አሳት ኤንታ ቆህዳ ቆሁዋ ታኒ በአስ። <verse eid="EXO 3:9"/><verse number="10" style="v" sid="EXO 3:10"/>ሄሳ ግሾ ሀእ ኔኒ ታ አሳ እያ ቢታፈ ከሳና መላ ግብፀ ካዋኮ ታኒ ነና ኪታይስ” ያግስ።<verse eid="EXO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11"/>ሽን ሙሰይ፥ “ካዋኮ ባናዉነ እስራኤለታ ግብፀፈ ከሳናዉ ታኒ ኦኔ?” ያግስ።<verse eid="EXO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 3:12"/>ፆሳይ ዛሪድ፥ “ታኒ ኔራ ግዳና። ቃስ ታኒ ነና ኪትዳይሳስ ማላይ ሀይሳ፤ ኔኒ ታ አሳ ግብፀፈ ከስያ ዎደ ሀ ዙማ ቦላ ህንተ ታና ጎይናና” ያግስ።<verse eid="EXO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13"/>ሙሰይ ፆሳኮ፥ “ግዶሽን፥ ታኒ እስራኤለታኮ ባዳ ኤንታኮ፥ ‘ህንተ አዋታ ፆሳይ ታና ህንተኮ ኪትስ’ ያግኮ፥ ኤንቲ ታና፥ ‘እያ ሱንይ ኦኔ?’ ያግድ ኦይችኮ፥ ታኒ ኤንታዉ ዎይጋዳ ዛሮ” ያግስ።<verse eid="EXO 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 3:14"/>“ፆሳይ ሙሰኮ፥ ‘ደኤይስነ ዳናይስ፥ ታና’ ኔኒ እስራኤለታኮ፥ ‘ታን ታና ግድዳይስ’ ታና ህንተኮ ክትስ ያጋ” ያግስ።<verse eid="EXO 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 3:15"/>ፆሳይ ዛሪድ፥ “ኔኒ እስራኤለታ ጎዳይ ህንተ አዋታ፥ አብራሃመ፥ ይሳቃነ ያይቆባ ፆሳይ፥ ታና ህንተኮ ኪትስ። ሀይስ ታ መርና ሱን፤ ያና የለተ ኡባይ ሀ ሱንን ታና ፄጋና።<verse eid="EXO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 3:16"/>“ባዳ እስራኤለ ጭማታ ሺሻዳ፥ ጎዳይ ህንተ አዋታ ፆሳይ፥ አብራሃመ፥ ይሳቃነ ያይቆባ ፆሳይ ነዉ ቆንጭዳይሳ ኦዳ። ግብፀን ኤንቲ ዋየትያ ዋይያ ታኒ ፆሞሳዳ በእዳይሳ ኤንታዉ ኦዳ። <verse eid="EXO 3:16"/><verse number="17" style="v" sid="EXO 3:17"/>ታኒ ኤንታና ግብፀ ዋያፐ ከሳዳ ማነ ኤስ ኩምዳ፥ ካናነታ፥ ህተታ፥ አሞረታ፥ ፓርዘታ፥ ህወታነ ያቡሰታ ቢታ ኤፋናዉ ቃላ ገላስ።<verse eid="EXO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 3:18"/>“እስራኤለ ጭማት ነ ግያባ ስአና። ሄሳፈ ጉየ ኔንነ እስራኤለ ጭማት ግብፀ ካዋኮ ብድ፥ ‘ጎዳይ፥ እብራወታ ፆሳይ፥ ኑስ ቆንጭስ። ሀእ ኑኒ ሄ ጋላሳ ኦገ መላ ቢታ ብድ፥ ጎዳስ፥ ኑ ፆሳስ ያርሾ ያርሻና መላ ኑና የዳ’ ያግተ። <verse eid="EXO 3:18"/><verse number="19" style="v" sid="EXO 3:19"/>ሽን ዎልቃን ግዶና እፅኮ፥ ግብፀ ካዎይ ህንተና የዶናይሳ ታኒ ኤራይስ። <verse eid="EXO 3:19"/><verse number="20" style="v" sid="EXO 3:20"/>ሄሳ ግሾ ታኒ ታ ዎልቃን ዱማ ዱማ ማላታታ ኦዳ ግብፀታ ሾጫና። ሄሳፈ ጉየ እ ህንተና የዳና።<verse eid="EXO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 3:21"/>“ቃስ ታኒ ግብፀ አሳ ስንን ቴሞ ህንተዉ እማና። ያንያ ግሾ ህንተ ከይያ ዎደ መላ ኩሸ ከየከታ። <verse eid="EXO 3:21"/><verse number="22" style="v" sid="EXO 3:22"/>እብራወ ማጫስ ኡባይ ባ ሾሮን ደእያ ግብፀ ማጫሳኮነ ባ ሶን ደእያ ግብፀ ማጫሳኮ ብድ፥ ብራ አሌቆ፥ ዎርቃነ ማኦ እምተ ግድ ኦይቻና። ህንተ ሄሳ ኤክድ ህንተ ናይታ ማይዛና። ሄሳዳ ኦድ ህንተ ግብፀ ሻሎ ኡባ ኤክድ ባና” ያግስ።<verse eid="EXO 3:22"/></para>
  <chapter eid="EXO 3"/>
  <chapter number="4" style="c" sid="EXO 4"/>
  <para style="s1">ፆሳይ ሙሰስ እምዳ ዎልቃ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1"/>ሙሰይ፥ “ኤንቲ ታና አማኖና እፅድ፥ ዎይኮ ታኒ ግያባ ስኦና እፅድ፥ ‘ጎዳይ ነዉ ቆንጭቤና’ ጊኮ ዎይጎ?” ያግድ ኦይችስ።<verse eid="EXO 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 4:2"/>ጎዳይ ሙሰኮ፥ “ነ ኩሽያን ደኤይስ አይቤ?” ያግድ ኦይችስ።</para>
  <para style="p" vid="EXO 4:2">“ፃምአ” ያግስ።<verse eid="EXO 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 4:3"/>ጎዳይ እያኮ፥ “አነ ሳአን የጋ” ያግስ። ሙሰይ ሄ ፃምኣ ሳአን የግን፥ ሾሽ ግድን፥ ሙሰይ እያፐ ዎፅስ። <verse eid="EXO 4:3"/><verse number="4" style="v" sid="EXO 4:4"/>ሄሳፈ ጉየ ጎዳይ፥ “ነ ኩሽያ የዳዳ እያ ጎይና ኦይካ” ያግስ። ሙሰይ ባ ኩሽያ የድድ ሾሻ ኦይክ ደንን ሾሻይ እያ ኩሸን ስሚድ፥ ፃምአ ግድስ። <verse eid="EXO 4:4"/><verse number="5" style="v" sid="EXO 4:5"/>ጎዳይ፥ “ነ አዋታ ፆሳይ፥ አብራሃመ፥ ይሳቃነ ያይቆባ ፆሳይ ነዉ ቆንጭዳይሳ ኤንቲ አማናና መላ ሀይሳ ኦ” ያግስ።<verse eid="EXO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6"/>ካልድ ጎዳይ ሙሰኮ፥ “ነ ኩሽያ ነ ሾጰን ናቃ” ያግስ። ሙሰይ ባ ኩሽያ ሾጰን ናቅስ። እ ከስያ ዎደ እያ ኩሸይ ባሮ ሀርገን ኦይከትዳዳ ቦፅስ። <verse eid="EXO 4:6"/><verse number="7" style="v" sid="EXO 4:7"/>ጎዳይ እያኮ፥ “ነ ኩሽያ ነ ሾጰን ዛራዳ ናቃ” ያግስ። ሙሰይ ባ ኩሽያ ባ ሾጰን ዛር ናቅድ ከስያ ዎደ እያ ኩሸይ ስሚድ ሀንኮ አሳተ መላ ግድስ።<verse eid="EXO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 4:8"/>ጎዳይ፥ “ኤንቲ ነና ዎይኮ ኮይሮ ማላታ አማኖና እፅኮ፥ ናምአን ማላታ አማናና። <verse eid="EXO 4:8"/><verse number="9" style="v" sid="EXO 4:9"/>ሽን ኤንቲ ሀ ናምኡ ማላታታ አማኖና እፅኮ፥ ዎይኮ ኔኒ ግያባ ስኦና እፅኮ፥ ናይለ ሻፋፐ ሃ ኤካዳ፥ መላ ቢታ ቦላ ጉሳ። ሄ ሃይ ቢታ ቦላ ሱን ላመታና” ያግስ።<verse eid="EXO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10"/>ሙሰይ ጎዳኮ፥ “አቤት ጎዳዉ፥ ካሰካ ዎይኮ ሀእ ነ ታና ኦድሶ ኦይክዳይሳፈ ዶምን ኦድድ አማንይ ታዉ ሀነና። ታ ጌሻዳ ኦደታናዉ ዳንዳእከ፤ ታ እንፃርሳይ ሉፋ” ያግስ።<verse eid="EXO 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 4:11"/>ጎዳይ እያኮ፥ “አሳስ ዶና እምዳይ ኦኔ? ሙመ ዎይኮ ቱለ ኦይ ኦኔ? ፄልሰይነ ቆቅሰይ ኦኔ? ታና ጎዳ ግድክናዬ? <verse eid="EXO 4:11"/><verse number="12" style="v" sid="EXO 4:12"/>ሀእ ኔኒ ባ፤ ኔኒ ኦደታና መላ ታ ነና ማዳና። ነ ጋናባ ታ ነዉ እማና” ያግስ።<verse eid="EXO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 4:13"/>ሽን ሙሰይ፥ “ጎዳዉ፥ ሀያና፥ ሀራ አስ ኪታ” ያግስ።<verse eid="EXO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 4:14"/>ሄሳፈ ጉየ ጎዳይ ሙሰ ቦላ ዳሮ ሀንቀትድ እያኮ፥ “ሌወ ግድዳ ነ እሻ አሮን ባዌ? እ ኦዳ ሎይድ ኤረይሳ ታ ኤራይስ። ሀእ እ ኔራ ጋሄታናዉ ይሸ ኦገ ቦላ ደኤስ፤ እ ነና በእያ ዎደ ዎዛናፐ ኡፋይታና። <verse eid="EXO 4:14"/><verse number="15" style="v" sid="EXO 4:15"/>ኔኒ፥ ‘ያጋ’፥ ጋዳ እያዉ ኦዳና። ታኒ ህንተ ናምአይካ ዎይግ ኦዳነኮነ ዋትድ ኦነኮ ህንተና ታማርሳና። <verse eid="EXO 4:15"/><verse number="16" style="v" sid="EXO 4:16"/>እ ነ ዶና ግድድ አሳስ ነ ግሾ ኦዳና። ኔኒ ፆሳ በሳን ግዳዳ እ ጋናባ እያዉ ኦዳና። <verse eid="EXO 4:16"/><verse number="17" style="v" sid="EXO 4:17"/>ሀ ፃምአ ኤካ ባዳ እያራ ማላታ ኦዳ በሳ” ያግስ።<verse eid="EXO 4:17"/></para>
  <para style="s1">ሙሰይ ግብፀ ስሙዋ</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18"/>ሄሳፈ ጉየ ሙሰይ ባ ቦሉዋ ዮታራኮ ስም ብድ፥ “ሀኖ ጋካናዉ አሳይ ፓፃ ደእያኮ በአናዉ፥ ታኒ ጉየ ግብፀ ታ አሳኮ ቦ?” ያግስ። ዮቶር ሙሰኮ፥ “ኤ ባ፤ ሳሮ ጋካ” ያግስ።<verse eid="EXO 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 4:19"/>ሙሰይ ምድያመ ቢታን ደእሽን ጎዳይ እያኮ፥ “ነና ዎናዉ ኮይዳ አሳት ኡባይ ሀይቅዳ ግሾ ጉየ ግብፀ ስማዳ ባ” ያግስ። <verse eid="EXO 4:19"/><verse number="20" style="v" sid="EXO 4:20"/>ሙሰይ ባ ማችዉነ ባ አደ ናይታ ሀረ ቶግስድ ጉየ ግብፀ ስምስ። ሙሰይ ፆሳ ፃምአ ባ ኩሸን ኦይክድ ብስ።<verse eid="EXO 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21"/>ጎዳይ ሙሰ፥ “ኔኒ ግብፀ ስማዳ ብያ ዎደ፥ ታኒ ነዉ እምዳ ዎልቃን ግብፀ ካዉዋ ስንን ማላታታ ኦናይሳ ባሎፓ። ሽን ሄሳንካ እ አሳ የዶና መላ ታኒ እያ ዎዛና ሙምሳና። <verse eid="EXO 4:21"/><verse number="22" style="v" sid="EXO 4:22"/>ሄ ዎደ ታኒ ጎዳይ ግያባ ካዋስ ሀሳዳ ያጋዳ ኦዳ። ‘እስራኤል ታ ባይራ ናአ። <verse eid="EXO 4:22"/><verse number="23" style="v" sid="EXO 4:23"/>እ ታዉ ጎይናና መላ እያ የዳ ጋዳ ታኒ ነዉ ኦዳስ። ሽን ኔኒ የዶና እፃዳሳ። ሄሳ ግሾ፥ ታኒ ነ ባይራ አደ ናኣ ዎና’ ያጌስ ጋዳ ኦዳ” ያግስ።<verse eid="EXO 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24"/>ኦገን ሸምፖ በሳን ጎዳይ ሙሰራ ጋሄትድ እያ ዎናዉ ኮይስ። <verse eid="EXO 4:24"/><verse number="25" style="v" sid="EXO 4:25"/>እያ ማችያ ስፖራ ቃራ ሹቹ ኤካዳ፥ ባ ናኣ ቃፃራሱ። ቃፃራ ሾሁዋራ ሙሰ ቶሁዋ ቦቻሱ። እያ ሙሰኮ፥ “ኔኒ ታዉ ቱማ ሱ መዳ” ያጋሱ። <verse eid="EXO 4:25"/><verse number="26" style="v" sid="EXO 4:26"/>ሄሳ ግሾ፥ ጎዳይ እያ ዎና አግስ። ሄ ዎደ እያ ሙሰኮ፥ “ሀ ቃፃሩዋ ጋሶን ኔኒ አታዳሳ” ያጋሱ።<verse eid="EXO 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27"/>ሄ ዎደ ጎዳይ አሮናኮ፥ “ሙሰራ ጋሄታናዉ መላ ቢታ ባ” ያግስ። እ ብድ፥ ፆሳ ዙማ ቦላ ሙሰራ ጋሄትድ እያ ዬርስ። <verse eid="EXO 4:27"/><verse number="28" style="v" sid="EXO 4:28"/>ሙሰይ ግብፀ ብድ ጋናባነ ኦና ማላታታ ኡባ ጎዳይ እያ ኪትዳይሳ አሮናስ ኦድስ። <verse eid="EXO 4:28"/><verse number="29" style="v" sid="EXO 4:29"/>ሙሰራነ አሮናራ ግብፀ ብድ፥ እስራኤለ ጭማታ ኡባ ሺሽዶሶና። <verse eid="EXO 4:29"/><verse number="30" style="v" sid="EXO 4:30"/>አሮን ጎዳይ ሙሰስ ኦድዳ ቃላ ኡባ ኤንታዉ ኦድስ። ቃስ ሙሰይ ማላታታ ሄ አሳ ስንን ኦስ። <verse eid="EXO 4:30"/><verse number="31" style="v" sid="EXO 4:31"/>ኤንትካ አማንዶሶና። ጎዳይ ኤንታዉ ቆፕዳይሳነ ኤንታ ዋይያ በእዳይሳ ስእዳ ዎደ ጉፋንድ ጎይንዶሶና።<verse eid="EXO 4:31"/></para>
  <chapter eid="EXO 4"/>
  <chapter number="5" style="c" sid="EXO 5"/>
  <para style="s1">ሙሰይነ አሮን ግብፀ ካዉዋ ስንን</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1"/>ሄሳፈ ጉየ ሙሰይነ አሮን ግብፀ ካዋኮ ብድ፥ “ጎዳይ፥ እስራኤለ ፆሳይ፥ ‘ታ አሳይ ታና ቦንቻናዉ መላ ቢታን፥ ባኣለ ኦና መላ ኤንታ የዳ’ ያጌስ” ያግዶሶና።<verse eid="EXO 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 5:2"/>ካዎይ፥ “ታኒ እያዉ ኪተታዳ እስራኤለ የዳናዉ እ፥ ጎዳይ ኦኔ? ታኒ ጎዳ ኤርከ፤ እስራኤላካ የድከ” ያግስ።<verse eid="EXO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 5:3"/>ኤንቲ ዛሪድ፥ “እብራወታ ፆሳይ ኑስ ቆንጭስ። ሀእ ኑኒ ጎዳስ፥ ኑ ፆሳስ፥ ያርሾ ያርሻናዉ ሄ ጋላሳ ኦገ መላ ቢታ ባና መላ ኑና የዳርክ። ሄሳ ኑ ኦና እፅኮ እ ኑና ሀርገን ዎይኮ ኦላን ይሳና” ያግዶሶና።<verse eid="EXO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 5:4"/>ሽን ግብፀ ካዎይ፥ “ሙሰ፥ አሮና፥ አሳ አይስ ኦሶ ድገቲ? ጉየ ብድ ህንተ ኦሱዋ ኦተ። <verse eid="EXO 5:4"/><verse number="5" style="v" sid="EXO 5:5"/>ሄኮ፥ ሀ ቢታን ህንተ ዳርደታ፤ ቃስ ህንተ አሳ ኦሶ ድገታ” ያግስ።<verse eid="EXO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 5:6"/>ካዎይ ሄ ጋላስ ግብፀ ካፖታነ እስራኤለታ ኦስሰይሳታ ሀይሳዳ ያግድ ኪትስ፤ <verse eid="EXO 5:6"/><verse number="7" style="v" sid="EXO 5:7"/>“ካሰይሳዳ ፁበ ኦናው አሳስ ኡቱላ እሞፍተ። ኤንቲ ኡቱላ ባንታዉ ኮይድ ሺሾ። <verse eid="EXO 5:7"/><verse number="8" style="v" sid="EXO 5:8"/>ሽን ካሰይሳፈ ታይቡዋ ጉና ኤንቲ ፁበ መድ ሺሻና መላ ኪትተ፤ እስኖካ ፓጭሶፕተ። ኤንቲ፥ ‘ኑኒ ኑ ፆሳስ ያርሾ ያርሻና መላ ኑና የዳ’ ያግድ ታና ኦይቸይ ኤንታዉ ኦሶይ ጉፅዳ ግሾሳ። <verse eid="EXO 5:8"/><verse number="9" style="v" sid="EXO 5:9"/>ኤንቲ ኦሶን ጉንዳና መላነ ዎርዶ ኦዳ ስኦናዉ ኤንታዉ ዎደይ ዶና መላ ኦሶ ዴፅስተ” ያግድ ኪትስ።<verse eid="EXO 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10"/>ግብፀ ካፖትነ እስራኤለታ ኦስሰይሳት ከይድ፥ አሳኮ፥ “ካዎይ፥ ‘ታኒ ህንተዉ ኡቱላ እምከ። <verse eid="EXO 5:10"/><verse number="11" style="v" sid="EXO 5:11"/>ህንተ ብድ አዉፐካ ኮይድ ደምተ። ሽን ህንተ ኦያ ፁበ ታይቡዋፐ እሶይካ ፓጨና’ ያግስ” ያግዶሶና። <verse eid="EXO 5:11"/><verse number="12" style="v" sid="EXO 5:12"/>ሄሳ ግሾ አሳይ ኡቱላ ኮያናዉ ግብፀ ቢታ ኡባን ላለትዶሶና። <verse eid="EXO 5:12"/><verse number="13" style="v" sid="EXO 5:13"/>ግብፀ ካፖት ኤንታዉ ኡቱል እመትን ኤንቲ ኦያ ፁበ ታይቡዋ ኬና ኦድ ሺሻና መላ ኤንታ ኡንኤዶሶና። <verse eid="EXO 5:13"/><verse number="14" style="v" sid="EXO 5:14"/>ግብፀ ካፖት ባንታፈ ጋርሳራ ደእያ እስራኤለ ካፖታ፥ “ህንተ ካሰ ኦያ ፁበ ኬና አይስ ኦ ሺሽበከቲ?” ያግድ ዋዶሶና።<verse eid="EXO 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15"/>ሄሳፈ ጉየ እስራኤለ ካፖት ካዋኮ ብድ፥ “አቤት ጎዳዉ፥ ኔኒ ነ አይለታ ሀይሳዳ አይስ ኦይ? ያግድ ማጋንዶሶና። <verse eid="EXO 5:15"/><verse number="16" style="v" sid="EXO 5:16"/>ነ አይለታስ ኡቱል እመተና፥ ሽን ፁበ ኦና መላ ኪተትዳ። ሄሳ ቦላ ኑና ዋሶና፤ ሽን ባላይ ነ አሳ ቦላና” ያግዶሶና።<verse eid="EXO 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 5:17"/>ሽን ካዎይ፥ “ህንተ ኦሶ ዶሶና አዛላታ፤ ህንተ ዎራ ዎዳ አዛላታ። ህንተ፥ ‘ኑኒ ጎዳስ ያርሻናዉ ባና፤ ኑና የዳ’ ያግድ ዛር ዛር ታና ኦይቸይ ሄሳ ግሾሳ። <verse eid="EXO 5:17"/><verse number="18" style="v" sid="EXO 5:18"/>ሀእ ጉየ ብድ ኦተ። ህንተዉ አይባ ኡቱልካ እመተና፥ ሽን ህንተ ካሰይሳ ኬና ፁበ ኦናዉ በሴስ” ያግስ።<verse eid="EXO 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 5:19"/>እስራኤለ ካፖት፥ ኤንቲ ካሰይሳ ኬና ፁበ ኦና መላ ኪተትዳ ዎደ ኤንቲ መቶን ገልዳይሳ ኤርዶሶና።<verse eid="EXO 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 5:20"/>ኤንቲ ካዉዋ ማታፐ ከይድ፥ ባንታና ካረን ናግያ ሙሰኮነ አሮናኮ ብዶሶና። <verse eid="EXO 5:20"/><verse number="21" style="v" sid="EXO 5:21"/>ኤንቲ ሙሰኮነ አሮናኮ፥ “ህንተ ኑና ካዎይነ እያ ሞርናት እፃና መላነ ዎና መላ ህንተ ኦዳይሳ ፆሳይ ፄሎ፤ እ ፕርዶ” ያግዶሶና።<verse eid="EXO 5:21"/></para>
  <para style="s1">ሙሰ ዎሳ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22"/>ሙሰይ ጎዳኮ ስሚድ፥ “ጎዳዉ፥ ኔኒ ሀ አሳ ቦላ መቶ አይስ ኤሀዲ? ኔኒ ታና ኪትዳይ ሄሳሴ? <verse eid="EXO 5:22"/><verse number="23" style="v" sid="EXO 5:23"/>ታኒ ነ ሱንን ካዋስ ኦዳናዉ ብዳ ዎደፐ ዶምን እ ሀ አሳ ቦላ መቶ ሀ ዳርስስ። ቃስ ነካ ነ አሳ አሻባካ” ያግስ።<verse eid="EXO 5:23"/></para>
  <chapter eid="EXO 5"/>
  <chapter number="6" style="c" sid="EXO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1"/>ሄሳፈ ጉየ ጎዳይ ሙሰኮ፥ “ታኒ ግብፀ ካዉዋ ቦላ ኦናባ ሀእ ኔኒ በአና። እ ታ ደርያ የዳና መላ ታኒ ታ ዎልቃ እያ በሳና። እ ኤንታ ባ ቢታፈ ጎድድ ከሳና” ያግስ።<verse eid="EXO 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2"/>ፆሳይ ሙሰ፥ “ታኒ ጎዳ። <verse eid="EXO 6:2"/><verse number="3" style="v" sid="EXO 6:3"/>ታኒ አብራሃመስ፥ ይሳቃስነ ያይቆባስ ኡባ ዳንዳእያ ፆሳ ግዳዳ ቆንጫስ። ሽን ታኒ፥ ‘ጎዳ’ ጌተትያ ታ ሱንን ታናተ ኤንታ ኤርሳብከ። <verse eid="EXO 6:3"/><verse number="4" style="v" sid="EXO 6:4"/>ቃስ ታኒ ኤንቲ በተተን ደእዳ ካናነ ቢታ እማና ጋዳ ኤንታራ ጫቃስ። <verse eid="EXO 6:4"/><verse number="5" style="v" sid="EXO 6:5"/>ቃስካ ግብፀ አሳት አይለይያ እስራኤለታ ዋሱዋ ታኒ ስአስ፤ ታ ጫቁዋካ ቆፓስ።<verse eid="EXO 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 6:6"/>“ሄሳ ግሾ ኔኒ እስራኤለታኮ፥ ‘ታኒ ጎዳ። ታኒ ህንተና ግብፀ አይለተፈ አሻዳ ከሳና። ታኒ ኤንታ ታ ምኖ አፃን ኢታ ፕርዳ ፕርዳዳ ህንተና ዎዛና። <verse eid="EXO 6:6"/><verse number="7" style="v" sid="EXO 6:7"/>ታኒ ህንተና ታ ደረ ኦና፤ ታኒ ህንተ ፆሳ ግዳና። ግብፀ አይለተፈ ታኒ ህንተና ከስዳ ዎደ፥ ታኒ ጎዳ ህንተ ፆሳ ግደይሳ ህንተ ኤራና። <verse eid="EXO 6:7"/><verse number="8" style="v" sid="EXO 6:8"/>ታኒ አብራሃመስ፥ ይሳቃስነ ያይቆባስ እማና ጋዳ ጫቅዳ ቢታ ህንተና ኤሀና። ሄ ቢታ ታኒ ህንተዉ ላታ ቢታ ኦዳ እማና። ታኒ ጎዳ’ ያጋ” ያግስ።<verse eid="EXO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 6:9"/>ሙሰይ ሄሳ እስራኤለታስ ኦድስ፥ ሽን ኤንቲ አይለተ ኡንአፈ ደንዶይሳን ኡፋይስ ቃንፅዳ ግሾ እ ግያባ ስእቦኮና።<verse eid="EXO 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 6:10"/>ሄሳፈ ጉየ ጎዳይ ሙሰ፥ <verse eid="EXO 6:10"/><verse number="11" style="v" sid="EXO 6:11"/>“ባዳ ግብፀ ካዋስ፥ ‘እስራኤለታ ነ ቢታፈ የዳ’ ያጋዳ ኦዳ” ያግስ።<verse eid="EXO 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 6:12"/>ሽን ሙሰይ፥ “ታ እንፃርሳይ ሉፋ። እስራኤለት ታና ስእቦኮና፥ ሽን ግብፀ ካዎይ ታና ዋንድ ስአኔ?” ያግስ።<verse eid="EXO 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 6:13"/>ጎዳይ ሙሰነ አሮና፥ “ብድ፥ እስራኤላ አሳ ግብፀፈ ከሳና መላ፥ ታኒ ህንተና ኪትዳይሳ እስራኤለታስነ ግብፀ ካዋስ ኦድተ” ያግስ።<verse eid="EXO 6:13"/></para>
  <para style="s1">ሙሰነ አሮና የለታ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 6:14"/>ሀይሳፈ ካልድ ፃፈትዳይሳት ኤንታ ማይዛታ፤ ያይቆባ ባይራ ናኣ ሮቤላ አደ ናይት፥ ሄኖከ፥ ፋሉ፥ ኤስሮመነ ካርማ። ሀይሳቲ ሮቤላ ሶ አሳስ ማይዛታ።<verse eid="EXO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 6:15"/>ስሞና አደ ናይት፥ ያሙኤላ፥ ያምና፥ ኦሀዳ፥ ያክና፥ ዞሃራነ ካናነ ቢታ ማጫሴፐ የለትዳ ሳኡላ። ሀይሳቲ ስሞና ሶ አሳስ ማይዛታ።<verse eid="EXO 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 6:16"/>ሌወ አደ ናይት ገድሶና፥ ቃሃታነ ማራራ። ሌወይ ፄታነ ሀስታማነ ላፑን ላይ ደእስ።<verse eid="EXO 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 6:17"/>ገድሶና አደ ናይት ልብናነ ሳመአ ጌተቶሶና። ሀይሳቲ ባንታ ሶ አሳስ ማይዛታ።<verse eid="EXO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 6:18"/>ቃሃታ አደ ናይት አምራማ፥ እዛራ፥ ከብሮናነ ኡዝኤላ። ቃሃት ፄታነ ሀስታማነ ሄ ላይ ደእስ።<verse eid="EXO 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 6:19"/>ማራራ አደ ናይት ማህላነ ሙሰ።</para>
  <para style="p" vid="EXO 6:19">ባንታ የለተ ማራን ሀይሳፈ ቆሞን ፃፈትዳይሳት ሌወ ሼሻታ።<verse eid="EXO 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 6:20"/>አምራም ባ አዋ ምችዉ ዮከቤዶ ማችስ። እያ አሮናነ ሙሰ እያዉ የላሱ። አምራም ፄታነ ሀስታማነ ላፑን ላይ ደእስ።<verse eid="EXO 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 6:21"/>እዛራዳ ናይት፥ ቆረ፥ ነፈጋነ ዝክራ።<verse eid="EXO 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 6:22"/>ኡዝኤላ አደ ናይት፥ ምሳኤላ፥ ኤልዛፋናነ ስትራ።<verse eid="EXO 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 6:23"/>አሮን አምናዳበ ናእዉ፥ ናአሶና ምችዉ ኤልሰቦ ማችስ። እያ እያዉ ናዳበ፥ አብዮዳ፥ አላዛራነ እታማራ የላሱ።<verse eid="EXO 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 6:24"/>ቆረ አደ ናይት፥ አስራ፥ ኤልቃናነ አብያሳፋ።<verse eid="EXO 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 6:25"/>አሮና ናአይ አላዛር ፑትኤላ ናይታፐ እስንዉ ማችስ። እያ እያዉ ፕንሃሳ የላሱ።</para>
  <para style="p" vid="EXO 6:25">ሀይሳቲ ሌወ ሼሻታነ ኤንታ ማይዛታ።<verse eid="EXO 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26"/>ጎዳይ፥ ሙሰነ አሮና እስራኤለ አሳ ያራን ያራን ኤንታ ሶ አሳራ ግብፀፈ ካለድ ከሳና መላ ኪትስ። <verse eid="EXO 6:26"/><verse number="27" style="v" sid="EXO 6:27"/>እስራኤለታ ግብፀፈ ከስ የዳና መላ ግብፀ ካዋስ ኦድዳይ ኤንታ። <verse eid="EXO 6:27"/><verse number="28" style="v" sid="EXO 6:28"/>ጎዳይ ግብፀን ሙሰስ ኦድዳ ዎደ፥ <verse eid="EXO 6:28"/><verse number="29" style="v" sid="EXO 6:29"/>“ታኒ ጎዳ፤ ታኒ ነዉ ኦድያባ ኡባ ግብፀ ካዋስ ኦዳ” ያግስ።<verse eid="EXO 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 6:30"/>ሽን ሙሰይ፥ “ታ ዶናይ ሉፋ ግደይሳ ነ ኤራሳ፥ ያትን ካዎይ ታኒ ኦድያባ ዋን ስአኔ?” ያግስ።<verse eid="EXO 6:30"/></para>
  <chapter eid="EXO 6"/>
  <chapter number="7" style="c" sid="EXO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1"/>ጎዳይ ሙሰኮ፥ “ሄኮ ታኒ ነና ግብፀ ካዋስ ፆሳ መላ ኦስ። ነ እሻ አሮን ነ ናበ ግድድ እያዉ ኦዳና። <verse eid="EXO 7:1"/><verse number="2" style="v" sid="EXO 7:2"/>ታኒ ነና ኪትዳ ኪታ ኡባ አሮናስ ኦዳ። እ፥ እስራኤለታ ባ ቢታፈ ከስ የዳና መላ ካዋስ ኦዳና። <verse eid="EXO 7:2"/><verse number="3" style="v" sid="EXO 7:3"/>ሽን ታኒ ካዉዋ ዎዛና ሙምሳና። ታኒ ግብፀ ቢታን ማላታታነ ማላልስያባታ ኦኮካ፥ <verse eid="EXO 7:3"/><verse number="4" style="v" sid="EXO 7:4"/>እ ህንተ ኦድያባ ስኤና። ሄ ዎደ ታኒ ግብፀታ ፕርዳና፤ ታ ደርያ እስራኤለ ግብፀፈ ከሳና። <verse eid="EXO 7:4"/><verse number="5" style="v" sid="EXO 7:5"/>ሄስ ሀንያ ዎደ ታኒ ጎዳ ግድዳይሳ ግብፀት ኤራና” ያግስ።<verse eid="EXO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 7:6"/>ሙሰይነ አሮን ጎዳይ ኪትዳይሳዳ ኦዶሶና። <verse eid="EXO 7:6"/><verse number="7" style="v" sid="EXO 7:7"/>ኤንቲ ካዋስ ኦድያ ዎደ፥ ሙሰስ ሆስፑን ታሙ ላይ፤ አሮናስ ቃስ ሆስፑን ታማነ ሄ ላይ።<verse eid="EXO 7:7"/></para>
  <para style="s1">አሮና ፃምአ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8"/>ጎዳይ ሙሰነ አሮና፥ <verse eid="EXO 7:8"/><verse number="9" style="v" sid="EXO 7:9"/>“ካዎይ ህንተና፥ ማላታ ኦድ ታና በስተ ጊኮ፥ አሮን ባ ፃምአ ኤክድ ካዉዋ ስንን የጋና መላ እያዉ ኦዳ፤ ሄ ፃምአይ ሾሽ ግዳና” ያግስ። <verse eid="EXO 7:9"/><verse number="10" style="v" sid="EXO 7:10"/>ሙሰይነ አሮን ካዋኮ ብድ ጎዳይ ኤንታ ኪትዳይሳዳ ኦዶሶና። አሮን ባ ፃምኣ ካዉዋ ስንንነ እያ ሞርናታ ስንን የግን ፃምአይ ሾሹ ግድስ። <verse eid="EXO 7:10"/><verse number="11" style="v" sid="EXO 7:11"/>ሄሳፈ ጉየ ካዎይ ማሮታነ ብታንቾታ ፄግስስ። ኤንትካ ባንታ ብታን ሄሳዳ ኦዶሶና። <verse eid="EXO 7:11"/><verse number="12" style="v" sid="EXO 7:12"/>ኤንቲ ኡባይ ባንታ ፃምኣ ሳአን የግዳ ዎደ ፃምአት ሾሽ ግድዶሶና። ሽን አሮና ፃምአይ ኤንታ ፃምአታ ምትስ <verse eid="EXO 7:12"/><verse number="13" style="v" sid="EXO 7:13"/>ግዶሽን ጎዳይ ግዳይሳ መላ ካዋ ዎዛናይ ሙምስ። እ ኤንቲ ገይሳ ስኦና እፅስ።<verse eid="EXO 7:13"/></para>
  <para style="s1">ሃ ሱ ላመተ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14"/>ጎዳይ ሙሰ፥ “ካዋ ዎዛናይ ሙምስ፤ እ አሳ የዶና እፅስ። <verse eid="EXO 7:14"/><verse number="15" style="v" sid="EXO 7:15"/>ዎንቶ ዎንታ ጉራ ሾሽ ላመትዳ ፃምኣ ኤካዳ፥ ናይለ ሻፋ ማታን ኤቃዳ፥ ካዉዋራ ጋሄታናዉ ናጋ። <verse eid="EXO 7:15"/><verse number="16" style="v" sid="EXO 7:16"/>እያኮ፥ ‘ጎዳይ፥ እብራወታ ፆሳይ ታ አሳይ መላ ቢታን ታዉ ጎይናና መላ የዳ’ ያግድ ታና ኔኮ ኪትስ። ሽን ኔኒ ሀኖ ጋካናዉ እፃዳሳ። <verse eid="EXO 7:16"/><verse number="17" style="v" sid="EXO 7:17"/>ጎዳይ፥ እ፥ ጎዳ ግደይሳ እ ኦያባን ኔኒ ኤራና። ታኒ ናይለ ሻፋ ሃ ታ ኩሸን ደእያ ፃምአን ሾጭኮ ሃይ ሱ ላመታና። <verse eid="EXO 7:17"/><verse number="18" style="v" sid="EXO 7:18"/>ናይለ ሻፋን ደእያ ሞሎይ ሀይቃና፤ ሻፋይካ ፅንቃና። ግብፀት ሄ ሻፋ ሃ ኡያናዉ ዳንዳኦኮና” ያጋዳ ኦዳ።<verse eid="EXO 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 7:19"/>ጎዳይ ሙሰኮ፥ “አሮን ግብፀን ደእያ ሃታ ቦላ፥ ሻፋታ ቦላ፥ ዛራ ሃታ ቦላ፥ ተቀ ሃ ቦላነ ዱቀትዳ ሃ ኡባ ቦላ ባ ፃምኣ ደንና መላ ኦዳ። ሄ ዎደ ሃ ኡባይ ሱ ላመታና። ሀር አቶሽን ግብፀ ቢታን ምፈነ ሹቻፈ ኦሰትዳ ሃ ትክያ ሚሸታን ደእያ ሃይ ኡባይ ሱ ላመታና ያጋ” ያግስ።<verse eid="EXO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20"/>ሙሰይነ አሮን ጎዳይ ኪትዳይሳዳ ኦዶሶና። ካዉዋ ስንንነ እያ ሞርናታ ስንን ባ ፃምኣ ደንድ፥ ናይለ ሻፋ ሃ ሾጭስ። ሃ ኡባይ ሱ ላመትስ። <verse eid="EXO 7:20"/><verse number="21" style="v" sid="EXO 7:21"/>ሄ ሻፋ ሃን ደእያ ሞሎት ሀይቅዶሶና። ሻፋ ሃይ ኢታ ፅንቅዳ ግሾ፥ ግብፀ አሳይ ኡያናዉ ዳንዳእቦኮና። ግብፀ ቢታ ኡባን ሱ ኩምስ። <verse eid="EXO 7:21"/><verse number="22" style="v" sid="EXO 7:22"/>ሽን ግብፀ ብታንቾት ባንታ ብታን ሄሳዳ ኦዶሶና። ጎዳይ ግዳይሳዳ ካዉዋ ዎዛናይ ሙምን፥ ሙሰይነ አሮን ኦድዳይሳ ስኦና እፅስ። <verse eid="EXO 7:22"/><verse number="23" style="v" sid="EXO 7:23"/>ካዎይ ሄ ሀንዳባ አይብንካ ታይቦና የግ አግድ ባ ጋ ስሚድ ብስ። <verse eid="EXO 7:23"/><verse number="24" style="v" sid="EXO 7:24"/>ግብፀ አሳይ ናይለ ሻፋ ሃ ኡያናዉ ዳንዳእቦና ግሾ፥ ኡይያ ሃ ደማናዉ ሻፋ ጋፃን ኦላ ቦክዶሶና።<verse eid="EXO 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 7:25"/>ጎዳይ ሃ ሾጭ ስምን ላፑን ጋላስ ግድስ።<verse eid="EXO 7:25"/></para>
  <chapter eid="EXO 7"/>
  <chapter number="8" style="c" sid="EXO 8"/>
  <para style="s1">ሾ ጋዶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1"/>ሄሳፈ ጉየ ጎዳይ ሙሰኮ፥ “ግብፀ ካዋኮ ባዳ፥ ‘ጎዳይ፥ ታዉ ጎይናና መላ ታ አሳ የዳ። <verse eid="EXO 8:1"/><verse number="2" style="v" sid="EXO 8:2"/>ኔኒ ኤንታ የዶና እፅኮ፥ ነ ቢታ ኡባን ሾ ጋዶ የዳና። <verse eid="EXO 8:2"/><verse number="3" style="v" sid="EXO 8:3"/>ናይለ ሻፋን ሾይ ኩማና። ኤንቲ ያፐ ከይድ ነ ካዎተ፥ ነ ዝንእያ ክፍልያ፥ ነ ሂፃ፥ ነ ሞርናታ ኬነ ነ ደርያ ኬ ኡባን ገላና። ሄሳዳካ ነ ጮጨንነ ሙኑቃ ሚሸ ኡባን ገላና። <verse eid="EXO 8:3"/><verse number="4" style="v" sid="EXO 8:4"/>ሾት ነ ቦላ፥ ነ አሳ ቦላነ ነ ሹማታ ኡባ ቦላ ጉፓና ያጌስ’ ያጋዳ ኦዳ” ያግስ።<verse eid="EXO 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5"/>ጎዳይ ሙሰኮ፥ “አሮን ግብፀን ደእያ ሃታ ቦላ፥ ዛራ ሃታ ቦላነ ተቀ ሃ ኡባ ቦላ ባ ፃምኣ ደንና መላ ኦዳ” ያግስ።<verse eid="EXO 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 8:6"/>አሮን ግብፀ ሃታ ቦላ ባ ፃምኣ ደንዳ ዎደ ሾት ከይድ፥ ግብፀ ቢታ ማእዶሶና። <verse eid="EXO 8:6"/><verse number="7" style="v" sid="EXO 8:7"/>ሽን ማሮትካ ባንታ ብታን ሄሳዳ ኦድ ግብፀ ቢታን ሾ ከስዶሶና።<verse eid="EXO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8"/>ካዎይ ሙሰነ አሮና ፄግስድ፥ “ሀ ሾታ ታፐነ ታ አሳፐ ድጋና መላ ጎዳ ህንተ ዎስኮ ታ ህንተ አሳ ጎዳስ ያርሾ ያርሻና መላ የዳና” ያግስ።<verse eid="EXO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 8:9"/>ሙሰይ ካዋኮ፥ “ሾት ኔፐ፥ ነ ሞርናታፐነ ነ አሳፐ ክቻና መላ ታ ዎሳናዉ ቃፃሮ እማ። ሄሳፈ ጉየ ሻፋ ሾት ኔፐነ ነ ኬፈ ክችድ ናይለ ፃላላን ደአና” ያግስ።<verse eid="EXO 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 8:10"/>ካዎይ ዛሪድ፥ “ዎንቶ ግዶ” ያግስ።</para>
  <para style="p" vid="EXO 8:10">ሙሰይ፥ “ኑ ጎዳ ፆሳ መል ሀር ኦንካ ባይናይሳ ኔኒ ኤራና መላ ነ ግዳይሳዳ ኦና። <verse eid="EXO 8:10"/><verse number="11" style="v" sid="EXO 8:11"/>ሾት ኔፐ፥ ነ ኬፈነ፥ ነ ሞርናታፐ ክችድ ናይለ ሻፋ ፃላላን አታና” ያግስ።<verse eid="EXO 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 8:12"/>ሙሰይነ አሮን ካዉዋ ማታፐ ከይድ፥ ካዉዋ ቦላ ጎዳይ ኤህዳ ሾታ ድጋና መላ ሙሰይ ጎዳ ዎስስ። <verse eid="EXO 8:12"/><verse number="13" style="v" sid="EXO 8:13"/>ጎዳይ ሙሰይ ኦይችዳይሳዳ ኦን ሶን፥ ካረንነ ጌሻን ደእያ ሾት ሀይቅዶሶና። <verse eid="EXO 8:13"/><verse number="14" style="v" sid="EXO 8:14"/>ግብፀ አሳይ ሀይቅዳ ሾታ ሺሽድ ዶርዶሶና፤ ቢታ ኡባይ ፅንቅስ። <verse eid="EXO 8:14"/><verse number="15" style="v" sid="EXO 8:15"/>ሽን ሾት ሀይቅዳይሳ ካዎይ በእዳ ዎደ እያ ዎዛናይ ዛር ሙምስ። ጎዳይ ግዳይሳ መላ እ ሙሰነ አሮና ስኦና እፅስ።<verse eid="EXO 8:15"/></para>
  <para style="s1">ቦፀ ጋዶ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16"/>ሄሳፈ ጉየ፥ ጎዳይ ሙሰኮ “አሮን ባ ፃምአ ደንድ ቢታ ባና ሾጫና መላ ኦዳ። ግብፀ ቢታ ኡባን ደእያ ባናይ ቦፀ ግዳና” ያግስ። <verse eid="EXO 8:16"/><verse number="17" style="v" sid="EXO 8:17"/>ኤንቲ ኪተትዳይሳዳ ኦዶሶና። አሮን ፃምአራ ቢታ ባና ሾጭስ። ግብፀን ደእያ ባና ኡባይ ቦፀ ላመትድ መህያነ አሳ ማእስ። <verse eid="EXO 8:17"/><verse number="18" style="v" sid="EXO 8:18"/>ማሮትካ ባንታ ብታን ሄሳዳ ኦናዉ ፓጭዶሶና፥ ሽን ፆነትዶሶና። ቦፀይ አሳ ቦላነ መህያ ቦላ ላለትስ። <verse eid="EXO 8:18"/><verse number="19" style="v" sid="EXO 8:19"/>ማሮት ካዋኮ፥ “ሀይስ ፆሳ ኦሶ” ያግዶሶና። ሽን ካዋ ዎዛናይ ሙምስ። ጎዳይ ግዳይሳ መላ እ ኤንታና ስኦና እፅስ።<verse eid="EXO 8:19"/></para>
  <para style="s1">ኡዱንፀ ጋዶ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20"/>ጎዳይ ሙሰ፥ “ጉራ ደንዳዳ፥ ካዎይ ሻፋ ብሽን እያራ ጋሄታዳ፥ ‘ጎዳይ፥ ታና ጎይናና መላ ታ አሳ የዳ። <verse eid="EXO 8:20"/><verse number="21" style="v" sid="EXO 8:21"/>ኔኒ ታ አሳ የዶና እፅኮ፥ ታኒ፥ ነ ቦላ፥ ነ ሞርናታ ቦላነ፥ ነ አሳ ቦላ ኡዱንፀ ጋዶ የዳና። ግብፀታ ኬነ ኤንቲ ደእያ ቢታ ኡባን ኡዱንፀይ ኩማና። <verse eid="EXO 8:21"/><verse number="22" style="v" sid="EXO 8:22"/>ሽን ሄ ጋላስ ታ አሳይ ደእያ ጌሳመ ቢታን ኡዱንፀይ ዶናዳ ኤንታ ተቃዳ አሻና። ታኒ ጎዳይ፥ ሄ ዎደ ሀ ቢታን ታኒ ጎዳይ ኦይሳ ኔኒ ኤራና። <verse eid="EXO 8:22"/><verse number="23" style="v" sid="EXO 8:23"/>ታኒ፥ ታ አሳነ ነ አሳ ሻካና፤ ሄ ግታ ማላታይ ዎንቶ ሀናና’ ያጌስ ጋዳ ኦዳ” ያግስ።<verse eid="EXO 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 8:24"/>ሄሳፈ ጉየ፥ ጎዳይ ግዳይሳዳ ኦስ። ካዉዋ ጋነ እያ ሞርናታ ሶ ዳሮ ኡዱንፀ ጋዶ የድስ። ኩመ ግብፀ ቢታይ ኡዱንፀ ጋዶን ቆሄትስ።<verse eid="EXO 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 8:25"/>ሄ ዎደ ካዎይ ሙሰነ አሮና ፄግስድ፥ “ብድ፥ ሀ ቢታን ህንተ ፆሳስ ያርሾ ያርሽተ” ያግስ።<verse eid="EXO 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 8:26"/>ሽን ሙሰ ዛሪድ፥ “ሄስ ሀኖናባ። ኑኒ ጎዳስ፥ ኑ ፆሳስ ያርሽያ ያርሾይ ግብፀታ ማታን እፀትያ ግሾ፥ ሄሳ ኦኮ። ኑ ያርሽሽን ኤንቲ በእኮ ኑና ሹቻን ጫዳና። <verse eid="EXO 8:26"/><verse number="27" style="v" sid="EXO 8:27"/>ኑና ኪትዳይሳ መላ፥ ኑኒ ጎዳስ፥ ኑ ፆሳስ ያርሾ ያርሻናዉ ሄ ጋላስ ኦገ መላ ቢታ ባናዉ በሴስ” ያግስ።<verse eid="EXO 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 8:28"/>ካዎይ ዛሪድ፥ “ጎዳስ፥ ህንተ ፆሳስ መላ ቢታ ብድ ያርሻና መላ ታኒ ህንተና የዳና። ሽን ህንተ ሃክድ ቦፕተ፤ ታዉ ዎስተ” ያግስ።<verse eid="EXO 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 8:29"/>ሙሰይ ዛሪድ፥ “ታኒ ነ ማታፐ ከይዳ መላ ጎዳ ዎሳና። ሀ ኡዱንፀይ ዎንቶ ካዉዋፐ፥ እያ ሞርናታፐነ እያ አሳፐ ክቻና። ሽን ካዎይ አሳይ ጎዳስ ጎይናናይሳ ድግድ ዛር ኑና ጭሞፎ” ያግስ።<verse eid="EXO 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 8:30"/>ሄሳፈ ጉየ ሙሰይ ካዉዋ ማታፐ ከይድ፥ ጎዳ ዎስስ። <verse eid="EXO 8:30"/><verse number="31" style="v" sid="EXO 8:31"/>ጎዳይ ሙሰይ ኦይችዳይሳዳ ኦስ። ኡዱንፀይ ካዉዋፐ፥ እያ ሞርናታፐነ እያ አሳፐ እሶይካ አቶና ክችስ። <verse eid="EXO 8:31"/><verse number="32" style="v" sid="EXO 8:32"/>ሽን ሀእካ ካዉዋ ዎዛናይ ሙምን አሳ የዶና እፅስ።<verse eid="EXO 8:32"/></para>
  <chapter eid="EXO 8"/>
  <chapter number="9" style="c" sid="EXO 9"/>
  <para style="s1">መሄ ቦላ ይዳ ጋዶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1"/>ጎዳይ ሙሰኮ፥ “ግብፀ ካዋኮ ባዳ፥ ጎዳይ፥ እብራወታ ፆሳይ ኔኮ፥ ‘ኤንቲ ታዉ ጎይናና መላ ታ አሳ የዳ። <verse eid="EXO 9:1"/><verse number="2" style="v" sid="EXO 9:2"/>ኔኒ የዶና ኤንታ እፅኮ፥ <verse eid="EXO 9:2"/><verse number="3" style="v" sid="EXO 9:3"/>ታኒ ነ ፓራታ ቦላ፥ ነ ሀረታ ቦላ፥ ነ ግማለታ ቦላ፥ ነ መህያ ቦላ፥ ነ ዶርሳታ ቦላነ ነ ዴሻታ ቦላ ኢታ ጋዶ የጋና። <verse eid="EXO 9:3"/><verse number="4" style="v" sid="EXO 9:4"/>ሽን ታኒ ጎዳይ እስራኤለ አሳ መህያ ግዶንነ ግብፀ አሳ መህያ ግዶን ዱማተ መና። እስራኤለ አሳ መህያፐ እሶይካ ሀይቀና። <verse eid="EXO 9:4"/><verse number="5" style="v" sid="EXO 9:5"/>ዎንቶ ታኒ ሄሳ ኦና ግድ ጎዳይ ዎደ ቃንፅስ’ ያጋ” ያግስ።<verse eid="EXO 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 9:6"/>ዎንተ ጋላስ ጎዳይ ግዳይሳዳ ኦስ። ግብፀ አሳ መሄ ኡባይ ሀይቅስ፥ ሽን እስራኤለ አሳ መህያፐ እሶይካ ሀይቅቤና። <verse eid="EXO 9:6"/><verse number="7" style="v" sid="EXO 9:7"/>ካዎይ ሀንዳባነ እስራኤለታ መህያፐ ሀር አቶሽን እሶይካ ሀይቆናይሳ አሰ ኪትድ፥ ኦይችድ ኤርስ። ሽን ሀእካ እያ ዎዛናይ ሙምዳ ግሾ አሳ የዶና እፅስ።<verse eid="EXO 9:7"/></para>
  <para style="s1">ክፃ ጋዶ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8"/>ሄሳፈ ጉየ፥ ጎዳይ ሙሰነ አሮና፥ “ጮጨፐ ብዶ ኩጭ ኤክድ፥ ካዎይ በእሽን ቦላ ርጭተ። <verse eid="EXO 9:8"/><verse number="9" style="v" sid="EXO 9:9"/>ሄስ ግብፀ ቢታ ኡባ ቦላ ባና ግድድ ላለታና። ግብፀ ቢታን ደእያ አሳ ቦላነ መሄይ ቦላ ክፃ ጋዶ ኤሀና” ያግስ። <verse eid="EXO 9:9"/><verse number="10" style="v" sid="EXO 9:10"/>ኤንቲ ጮጨፐ ጉ ብዶ ኤክድ ካዉዋ ስንን ኤቅዶሶና። ሙሰይ ሄሳ ቦላ ላልን፥ አሳ ቦላነ መህያ ቦላ ክፃ ጋዶይ ዎ አግስ። <verse eid="EXO 9:10"/><verse number="11" style="v" sid="EXO 9:11"/>ግብፀ አሳ ቦላ ዎዳ ክፃይ ማሮታ ቦላካ ዎዳ ግሾ ሙሰ ስንን ኤቃናዉ ዳንዳእቦኮና። <verse eid="EXO 9:11"/><verse number="12" style="v" sid="EXO 9:12"/>ሽን ጎዳይ ሙሰስ ግዳይሳ መላ፥ ካዎይ ባ ዎዛና ሙምስዳ ግሾ፥ ሙሰነ አሮና ስኦና እፅስ።<verse eid="EXO 9:12"/></para>
  <para style="s1">ሻቻ ጋዶ</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13"/>ሄሳፈ ጉየ፥ ጎዳይ ሙሰኮ፥ “ካዋኮ ጉራ ደንዳ ባዳ፥ ‘ጎዳይ፥ እብራወታ ፆሳይ፥ ታዉ ጎይናና መላ ታ አሳ የዳ። <verse eid="EXO 9:13"/><verse number="14" style="v" sid="EXO 9:14"/>ሀእ ነ እፃስ ጊኮ፥ ነ ሞርናታነ ነ አሳ ፃላላ ግዶናሽን ነ ቦላካ ኢታ ጋዶ ኤሀና። ሄ ዎደ አላመ ኡባን ጎድ ታ ፃላላ ግደይሳ ኔኒ ኤራና። <verse eid="EXO 9:14"/><verse number="15" style="v" sid="EXO 9:15"/>ታኒ ታ ኩሽያ ደንዳ ነናነ ነ አሳ ጋዶን ሾጭዳባ ግድያኮ ሀእ ጋካናስ ህንተ ቢታ ቦላ ደኤከታሽን። <verse eid="EXO 9:15"/><verse number="16" style="v" sid="EXO 9:16"/>ሽን ታ ሱንይ ቢታ ኡባን ኤረታና መላ ታኒ ታ ዎልቃ በሳናዉ ነና ደኦን ዎስ። <verse eid="EXO 9:16"/><verse number="17" style="v" sid="EXO 9:17"/>ኔኒ ሀእካ ኦቶርታዳ ታ አሳ የዶና እፃዳሳ። <verse eid="EXO 9:17"/><verse number="18" style="v" sid="EXO 9:18"/>ታኒ ዎንቶ ሀኖደ ግብፀ ቢታይ መቶሳፐ ሀች ጋካናዉ ቡክ ኤሮና ዎልቃማ ሻች ቡክሳና። <verse eid="EXO 9:18"/><verse number="19" style="v" sid="EXO 9:19"/>ሀእ ኔኒ ነ መህያነ ካረን ደእያባ ኡባ ኤለ ሶ ገልሳና መላ ኪታ። ሶ ገሎና አሳ ቦላነ መህያ ኡባ ቦላ ሻች ቡክድ፥ ኤንታ ዎና ያጌስ’ ያጋ” ያግስ። <verse eid="EXO 9:19"/><verse number="20" style="v" sid="EXO 9:20"/>ካዉዋ ሞርናታፐ እሶት እሶት ጎዳይ ግዳይሳ ስእድ ያይዳ ግሾ፥ ባንታ አይለታነ ባንታ መሄታ ሶ ገልስዶሶና። <verse eid="EXO 9:20"/><verse number="21" style="v" sid="EXO 9:21"/>ሽን ሀራት ጎዳይ ግዳይሳ ስኦና እፅድ ባንታ አይለታነ ባንታ መህያ ካረን አጋግዶሶና።<verse eid="EXO 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 9:22"/>ሄሳፈ ጉየ፥ ጎዳይ ሙሰ፥ “ግብፀ ቢታ ኡባ ቦላ፥ አሳ ቦላ፥ መህያ ቦላነ ጋደን ደእያ ካ ቦላ ሻች ቡካና መላ ነ ኩሽያ ሳሎ ደን” ያግስ። <verse eid="EXO 9:22"/><verse number="23" style="v" sid="EXO 9:23"/>ሙሰይ ባ ፃምኣ ሳሎ ደንዳ ዎደ፥ ጎዳይ ዎልቃማ ደሾነ ዎልአን የድስ። ሄሳዳ ኦድ ጎዳይ ግብፀን ሻች ቡክስስ። <verse eid="EXO 9:23"/><verse number="24" style="v" sid="EXO 9:24"/>ጎዳይ ገደራ ሃራ ዎልቃማ ዎልአን የድስ። ሄሳ መላባይ ግብፀ ቢታን አስ ዱሱ ኦይኮደፐ ሀን ኤረና። <verse eid="EXO 9:24"/><verse number="25" style="v" sid="EXO 9:25"/>ሄ ሻቻይ ግብፀን ደእያ አሳነ መህያ ሾጭስ። ጋደን ደእያባ፥ ምነ ማታ ኡባ ይስስ። <verse eid="EXO 9:25"/><verse number="26" style="v" sid="EXO 9:26"/>እስራኤለት ደእያ ጌሳመ ቢታ ፃላላን ሻች ቡክቤና።<verse eid="EXO 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 9:27"/>ካዎይ ሙሰነ አሮና ፄግስድ፥ “ታኒ ሀእ ናጋራ ኦስ። ጎዳይ ቱማንቾ፤ ታንነ ታ አሳይ ባላ። <verse eid="EXO 9:27"/><verse number="28" style="v" sid="EXO 9:28"/>ደሾይነ ሻቻይ ኑ ቦላ ዳርድ ኡንኤዳ ግሾ ኑስ ጎዳ ዎስተ። ታኒ ህንተና የዳና፤ ህዛፐ ህንተ ሀይሳን ጋምኤከታ” ያግስ።<verse eid="EXO 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 9:29"/>ሙሰይ እያኮ፥ “ታኒ ሀ ካታማፐ ከይዳ ዎደ ታ ኩሽያ ደንዳ ጎዳ ዎሳና። ደሾይነ ሻቻይ ኤቅያ ዎደ ሳአይ ጎዳባ ግደይሳ ኔኒ ሄሳን ኤራና። <verse eid="EXO 9:29"/><verse number="30" style="v" sid="EXO 9:30"/>ሽን ነነ ነ ሞርናት ሀእካ ጎዳ ፆሳ ያዮናይሳ ታኒ ኤራይስ” ያግስ።<verse eid="EXO 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 9:31"/>ታልባይ ጪሸ፥ ባንጋይ ቆርፃ ግድያ ግሾ ኡባይ ሻቻን ይስ። <verse eid="EXO 9:31"/><verse number="32" style="v" sid="EXO 9:32"/>ሽን ግስተይነ ሙርቃይ ጋክቦና ግሾ ሻቻን ይቤና።<verse eid="EXO 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 9:33"/>ሙሰይ ካዉዋ ማታፐ ከይድ፥ ካታማፐ ጋፃ ብድ ባ ኩሽያ ደንድ ጎዳ ዎስስ። ያትን ደሾይ፥ ሻቻይነ እራይ ኤለስድ ኤቅ አግስ። <verse eid="EXO 9:33"/><verse number="34" style="v" sid="EXO 9:34"/>ሽን ካዎይ ሄ ኡባይ ኤቅዳይሳ በእዳ ዎደ ዛሪድ ናጋራ ኦስ። እያራነ እያ ሞርናታራ ባንታ ዎዛና ጉጅድ ምንዶሶና። <verse eid="EXO 9:34"/><verse number="35" style="v" sid="EXO 9:35"/>ጎዳይ ሙሰ ባጋራ ኦድዳይሳ መላ ካዉዋ ዎዛናይ ሙምን፥ እስራኤለታ የዶና እፅስ።<verse eid="EXO 9:35"/></para>
  <chapter eid="EXO 9"/>
  <chapter number="10" style="c" sid="EXO 10"/>
  <para style="s1">ቦለ ጋዶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1"/>ሄሳፈ ጉየ፥ ጎዳይ ሙሰኮ፥ “ግብፀ ካዋኮ ባ። ታኒ ሀ ማላታታ ኤንታ ግዶን ኦናዉ ኮያዳ ካዉዋ ዎዛናነ እያ ሞርናታ ዎዛና ሙምሳስ። <verse eid="EXO 10:1"/><verse number="2" style="v" sid="EXO 10:2"/>ታኒ ሄሳ ኦዳይ ታ ማላታታን ዋታዳ ግብፀታ ሴርዳኮ ህንተ ህንተ ናይታስነ ህንተ ናይታ ናይታስ ኦዳና መላ ኮይዳ ግሾሳ። ሄ ዎደ ታኒ ጎዳ ግደይሳ ህንተ ኤራና” ያግስ።<verse eid="EXO 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 10:3"/>ሙሰይነ አሮን ካዋኮ ብድ፥ “ጎዳይ፥ እብራወታ ፆሳይ ኔኮ፥ ‘ኔኒ ታዉ ኪተተ እፀይ አዉደ ጋካናሴ? ታዉ ጎይናና መላ ታ አሳ የዳ። <verse eid="EXO 10:3"/><verse number="4" style="v" sid="EXO 10:4"/>ኔኒ ኤንታ የዶ እፅኮ፥ ዎንቶ ነ ቢታ ቦላ ታኒ ቦለ የዳና። <verse eid="EXO 10:4"/><verse number="5" style="v" sid="EXO 10:5"/>ቦለይ ዳሮተፈ ደንዶይሳን ቢታ ኡባ ካማና። ኤንቲ ሻቻ ጋዱዋፐ አትዳ ጉባነ ም ሀይ ኡባ ማና። <verse eid="EXO 10:5"/><verse number="6" style="v" sid="EXO 10:6"/>ነ ኬ፥ ነ ሞርናታ ኬነ ግብፀ አሳ ኡባ ኬ ኤንቲ ኩማና። ሄስ ነ ማይዛት ሀ ቢታን ደኦሳፐ ሀኖ ጋካናዉ በእዳ ኢታባፐ አያባ ግዳና’ ያጌስ” ያግዶሶና።</para>
  <para style="p" vid="EXO 10:6">ሄሳፈ ጉየ፥ ሙሰይ ካዉዋ ስንፈ ከይድ ብስ።<verse eid="EXO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 10:7"/>ካዋ ሞርናት ካዋኮ፥ “ሀ ኡራይ አዉደ ጋካናዉ ኑስ ፅሄ ግዳኔ? አሳይ ጎዳ፥ ባንታ ፆሳ ጎይናና መላ ኤንታ የዳ። ግብፀ ቢታይ የይሳ ኔኒ አኬክኪ?” ያግዶሶና።<verse eid="EXO 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 10:8"/>ካዎይ ሙሰነ አሮና ጉየ ፄግስድ፥ “ብድ ጎዳ፥ ህንተ ፆሳ ጎይንተ፥ ሽን በይሳት ኦናንቴ?” ያግስ።<verse eid="EXO 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 10:9"/>ሙሰይ፥ “ኑኒ ብያ በሳን ጎዳ ቦንቻናዉ ባኣለ ኦና ግሾ፥ ኑኒ ኑ ጉ ናይታ፥ ኑ ጭማታ፥ ኑ አደ ናይታ፥ ኑ ማጫ ናይታ፥ ኑ ዶርሳታነ ኑ ሚዛታ ኤክድ እስፈ ባና” ያግስ።<verse eid="EXO 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 10:10"/>ካዎይ፥ “ህንተ ህንተ ናይታነ ህንተ ማጫሳታ ኤክ ቦና መላ ታኒ ጎዳን ጫቅሳይስ። ህንተ ህንተ ዎዛናን ኢታባ ቆፕዳይስ ኤረቴስ። <verse eid="EXO 10:10"/><verse number="11" style="v" sid="EXO 10:11"/>ህንተ፥ ብድ ጎዳ ጎይናናዉ ኮያባ ግድኮ አደታ ፃላላ ኤክ ቢተ” ያግስ። ሄሳፈ ጉየ፥ ሙሰነ አሮና ካዉዋ ስንፈ ጎደትድ ከይዶሶና።<verse eid="EXO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 10:12"/>ጎዳይ ሙሰኮ፥ “ቦለይ ይድ ሻቻ ጋዱዋፐ አትዳ ኡባ ማና መላ ነ ኩሽያ ግብፀ ቢታ ቦላ ደን” ያግስ።<verse eid="EXO 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 10:13"/>ሙሰይ ባ ፃምኣ ግብፀ ቢታ ቦላ ደንዳ ዎደ፥ ጎዳይ ዶሎሀ ባጋ ጫርኮ ሄ ቃማነ ጋላስ ኩመ ቢታ ቦላ ጫርክስስ። ዎንትያ ዎደ ሄ ጫርኮይ ቦለ ኤህስ። <verse eid="EXO 10:13"/><verse number="14" style="v" sid="EXO 10:14"/>ቦለይ ግብፀ ቢታ ኡባ ጋክድ ማእስ። ሄሳ መላ ቦለ ጋዶይ ሄ ቢታን ካሰካ ሀንቤና፤ ስንፈካ ሀነና። <verse eid="EXO 10:14"/><verse number="15" style="v" sid="EXO 10:15"/>ቢት ማና ጋካናዉ ቦለይ ቢታ ኡባ ማእስ። ሄ ቦለይ ሻቻፈ አትድ ጋደን ድጭያባ ኡባነ ም አይፈ ኡባ ምዶሶና። ግብፀ ቢታን ደእያ ም ሀይነ ጭልኦባ ኡባ ምድግስ።<verse eid="EXO 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 10:16"/>ካዎይ ሙሰነ አሮና ኤለስ ፄግስድ፥ “ታኒ ጎዳ ህንተ ፆሳነ ህንተና ናቃስ። <verse eid="EXO 10:16"/><verse number="17" style="v" sid="EXO 10:17"/>ህዛ ታ ናጋራ ታዉ እስ ቶሆ አቶ ጊተ። ሀ ይስያ ጋዱዋ ታፐ ድጋና መላ ጎዳ ህንተ ፆሳ ዎስተ” ያግስ።<verse eid="EXO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 10:18"/>ሙሰይ ካዉዋ ማታፐ ከይድ ጎዳ ዎስስ። <verse eid="EXO 10:18"/><verse number="19" style="v" sid="EXO 10:19"/>ጎዳይ ዉሎሀ ዎልቃማ ጫርኩዋ ኪትድ ቦልያ ቢታፈ ደንድ፥ ዞኦ አባ የድስ። ግብፀ ቢታ ኡባን እስ ቦለይካ ሀይቅቤና። <verse eid="EXO 10:19"/><verse number="20" style="v" sid="EXO 10:20"/>ሽን ጎዳይ ካዉዋ ዎዛና ሙምስዳ ግሾ እስራኤለታ የዶና እፅስ።<verse eid="EXO 10:20"/></para>
  <para style="s1">ሳካና ማ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21"/>ጎዳይ ሙሰ፥ “ግብፀ ቢታን አስ ኦይክ በእያ ም ማና መላ ነ ኩሽያ ሳሎ ደን” ያግስ። <verse eid="EXO 10:21"/><verse number="22" style="v" sid="EXO 10:22"/>ሙሰይ ባ ኩሽያ ሳሎ ደንስ። ግብፀ ቢታ ኡባን ሄ ጋላስ ኩመ ሳካና ማይ ምስ። <verse eid="EXO 10:22"/><verse number="23" style="v" sid="EXO 10:23"/>ሄ ሄ ጋላሳታን ግብፀት እሶይ እሱዋ በእቦኮና ዎይኮ ኦንካ ባ ሶፐ ከይቤና። ሽን እስራኤለት ደእያ ጌሳመን ፖኦይ ደኤስ።<verse eid="EXO 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 10:24"/>ካዎይ ሙሰ ፄግስድ፥ “ብድ ህንተ ጎዳ ጎይንተ። ህንተ ማጫሳይነ ህንተ ናይት ህንተራ ባናዉ ዳንዳኦሶና። ህንተ ዶርሳ ዉድያነ ህንተ ሚዛ ዉድያ ፃላላ አግድ ቢተ” ያግስ።<verse eid="EXO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 10:25"/>ሽን ሙሰይ፥ “ኑኒ ፁሳ ያርሾነ ሀራ ያርሾ ጎዳ ፆሳስ ያርሻና መላ መሄ ኔኒ ኑስ እማናዉ ኮሼስ። <verse eid="EXO 10:25"/><verse number="26" style="v" sid="EXO 10:26"/>እሶይካ ጉየ አቶና ኑ መሄይ ኑራ ባናዉ ኮሼስ። ጎዳ፥ ኑ ፆሳ ጎይናናዉ መህያፐ ዶራናዉ በሰይ ኑና። ኑኒ ያ ጋኮና ደእሸ አይ መሄ ያርሻነኮ ኤራናዉ ዳንዳኦኮ” ያግስ።<verse eid="EXO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 10:27"/>ሽን ጎዳይ ካዉዋ ዎዛና ሙምስዳ ግሾ፥ እ ኤንታ የዳናዉ ኮይቤና። <verse eid="EXO 10:27"/><verse number="28" style="v" sid="EXO 10:28"/>ሄሳፈ ጉየ፥ ካዎይ ሙሰኮ፥ “ታ ስንፈ ክቻ፤ ታ ስንን ዛራ በንታዳ ነና ኤራ። ታ አይፍያ ነ በእዳ ጋላስ ሀይቃና” ያግስ። <verse eid="EXO 10:28"/><verse number="29" style="v" sid="EXO 10:29"/>ሙሰይ እያኮ፥ “ቱማካ ነ ግዳይሳዳ ኔኒ ታ አይፍያ ዛራዳ በአካ” ያግስ።<verse eid="EXO 10:29"/></para>
  <chapter eid="EXO 10"/>
  <chapter number="11" style="c" sid="EXO 11"/>
  <para style="s1">ባይራ ቦላ ይዳ ጋዶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1"/>ጎዳይ ሙሰኮ፥ “ታኒ ግብፀ ካዉዋ ቦላነ እያ አሳ ቦላ እስ ሀራ ጋዶ የዳና። ሄሳፈ ጉየ፥ እ ህንተና ከስ የዳና። እ ህንተና ኡባ ጎድድ ከሳና። <verse eid="EXO 11:1"/><verse number="2" style="v" sid="EXO 11:2"/>እስራኤለ አሳይ፥ አደይነ ማጫስ ባንታ ሾሮታፐ ብራነ ዎርቃ አሌቆ ኦይቻና መላ ኤንታዉ ኦዳ” ያግስ። <verse eid="EXO 11:2"/><verse number="3" style="v" sid="EXO 11:3"/>ጎዳይ እስራኤለ አሳስ ግብፀታ ስንን ቴሞ እሚስ። ግብፀ ካዉዋ ሞርናትነ አሳይ ሙሰ ዳሮ ቦንቸትዳ አሳዳ ፄልዶሶና።<verse eid="EXO 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 11:4"/>ሙሰይ ካዋኮ፥ “ጎዳይ ሀይሳዳ ያጌስ፤ ‘ቃማ ብላሄ ታኒ ግብፀ ቢታ ግዶራ ካንና። <verse eid="EXO 11:4"/><verse number="5" style="v" sid="EXO 11:5"/>ግብፀ ቢታን ደእያ ባይራ አደ ናእ ኡባይ፥ ካዋ አራታ ላታናዉ ደእያ ባይራ ናኣፐ ዶምድ፥ ዎፃን ጋጭያ ማጫ አይለ ባይራ ናአ ጋካናዉ፥ ባይራ የለትዳ መሄ ኡባይ ሀይቃና። <verse eid="EXO 11:5"/><verse number="6" style="v" sid="EXO 11:6"/>ግብፀ ቢታ ኡባን ሄሳፈ ካሰካ ስንፈካ ሀኖና ግታ ዬሆይ ዬኬታና። <verse eid="EXO 11:6"/><verse number="7" style="v" sid="EXO 11:7"/>ሽን እስራኤለ አሳ ቦላ ዎይኮ ኤንታ መህያ ቦላ ካንካ ቦጨና።’ ሄ ዎደ ታኒ ጎዳይ ግብፀታ ግዶንነ እስራኤለ ግዶን ዱማተ መይሳ ኔኒ ኤራና። <verse eid="EXO 11:7"/><verse number="8" style="v" sid="EXO 11:8"/>ነ ሞርናት ኡባይ ይድ ታ ስንን ጉፋናና። ታ አሳ ኤካዳ ሀ ቢታፈ ከያና መላ ኤንቲ ታና ዎሳና። ሄሳፈ ጉየ፥ ታኒ ባና” ያግስ። ሙሰይ ሸነን ፁገትድ ካዋ ስንፈ ከይድ ብስ።<verse eid="EXO 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 11:9"/>ጎዳይ ሙሰስ ካሰ፥ “ግብፀ ቢታን ታኒ ማላልስያባ ዳርሳዳ ኦና ጋሶ ካዎይ ህንተና ስኤና” ያግድ ኦድ ዎስ። <verse eid="EXO 11:9"/><verse number="10" style="v" sid="EXO 11:10"/>ሙሰይነ አሮን ማላልስያባ ኡባ ካዋ ስንን ኦዶሶና። ሽን ጎዳይ ካዉዋ ዎዛና ሙምስዳ ግሾ፥ እስራኤለታ ባ ቢታፈ የዶና እፅስ።<verse eid="EXO 11:10"/></para>
  <chapter eid="EXO 11"/>
  <chapter number="12" style="c" sid="EXO 12"/>
  <para style="s1">ፓስካ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1"/>ጎዳይ ግብፀ ቢታን ሙሰነ አሮና ሀይሳዳ ያግስ፤ <verse eid="EXO 12:1"/><verse number="2" style="v" sid="EXO 12:2"/>“ሀ አጌናይ ህንተዉ ላይስ ኮይሮ አጌና ግዶ። <verse eid="EXO 12:2"/><verse number="3" style="v" sid="EXO 12:3"/>እስራኤለ አሳ ኡባስ ሀ ዎጋ ኦድተ። ሀ አጌናይ ገልዳ ታማን ጋላሳን፥ እስ አስ ባ ሶ አሳስ እስ ማራዘ ዎይኮ እስ ኮለ ኤኮ። <verse eid="EXO 12:3"/><verse number="4" style="v" sid="EXO 12:4"/>ሄ ኬ አሳ ታይቦይ ሄ መህያ ዉርስድ ማናዉ ዳንዳኦና እፅኮ፥ እያራነ እያ ማታ ሾሩዋራ ባንታ ሶ አሳ ታይቡዋ መላነ እስ እስ አስ ምድ ዉርሳናዉ ዳንዳእያ ኬና ኤክድ ሄ መህያ ሹክድ እስፈ ሞና። <verse eid="EXO 12:4"/><verse number="5" style="v" sid="EXO 12:5"/>ህንተ ዶርያ መሄይ ዶርሰ ዎይኮ ዴሸ ግዳናዉ ዳንዳኤስ፥ ሽን እስ ላይ ኩምዳይሳነ እያ ቦላ ቦረይ ባይና አደ ግዶ። <verse eid="EXO 12:5"/><verse number="6" style="v" sid="EXO 12:6"/>ሀ አጌናስ ታማነ ኦይዳን ጋላስ ጋካናዉ ኤንታ ሄምተ። ሄ ጋላስ ኦማርስ ላድያ ዎደ እስራኤለ አሳ ማባራ ኡባይ ኤንታ ሹካናዉ በሴስ። <verse eid="EXO 12:6"/><verse number="7" style="v" sid="EXO 12:7"/>አሳይ ሄ ሱፈ ኤክድ ኤንቲ ምያ ኬ ዉላ ጋርሳ፥ ቆሙዋነ ቦኮሉዋ ትዮ። <verse eid="EXO 12:7"/><verse number="8" style="v" sid="EXO 12:8"/>አሹዋ ሄ ጋላስ ቃማ ታማን ጫጭድ ጫምያ ቦንጮራነ ኡይራ ሚተ። <verse eid="EXO 12:8"/><verse number="9" style="v" sid="EXO 12:9"/>አሹዋ ቃየ ዎይኮ ካድ ሞፕተ። ሁጵያ፥ ገዳታነ ኡሎ አሾታ ኡባ ጫጭድ ሚተ። <verse eid="EXO 12:9"/><verse number="10" style="v" sid="EXO 12:10"/>ሄ አሹዋፐ ዎንታና ጋካናዉ አይኮካ አሾፍተ። ዎንታና ጋካናዉ አትኮ ሄሳ ፁግተ። <verse eid="EXO 12:10"/><verse number="11" style="v" sid="EXO 12:11"/>ኦገስ ጊግያ ማኦ ማእድ፥ ህንተ ጫማ አድ፥ ህንተ ፃምኣ ኦይክድ ኤሶን ሚተ። ሄስ ታና ጎዳ ቦንችያ ፓስካ ባኣለ ህንተዉ ግዶ።<verse eid="EXO 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 12:12"/>“ታኒ ሄ ቃማ ግብፀራ ካንዳ ባይራ የለትዳ ኡባ፥ አሳነ መህያ ዎና። ግብፀ ኤቃታ ኡባ ፕርዳና፤ ታኒ ጎዳ። <verse eid="EXO 12:12"/><verse number="13" style="v" sid="EXO 12:13"/>ሄ ሱይ ህንተ ደእያ ኬ ኤርስያ ማላ ግዳና። ታኒ ግብፀታ ፕርድያ ዎደ ሄ ሱ በአዳ ህንተና ቆሆና አጋ አና።<verse eid="EXO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 12:14"/>“ሀ ጋላሳይ ታኒ ጎዳይ ህንተዉ ኦዳይሳ ላይን ላይን ቆፍስያ ጎዳ ቦንችያ ባኣለ ግዶ” ያግስ።<verse eid="EXO 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15"/>“ላፑን ጋላስ ጋካናዉ እርሾይ ገሎና ኡይ ሚተ። ኮይሮ ጋላስ እርሾ ህንተ ሶፐ ድግተ። ሄ ላፑን ጋላሳታን እርሾይ ደእያ ኡይ ምያ አስ እስራኤለ አሳ ግዶፈ ዱፅድ ኩረቶ። <verse eid="EXO 12:15"/><verse number="16" style="v" sid="EXO 12:16"/>ኮይሮ ጋላሳንነ ላፑን ጋላሳን ጎይናናዉ ሺቅተ። ሄ ጋላሳታን አይብ ኦሶካ ኦፍተ፥ ሽን ካ ካናዉ ዳንዳኤታ።<verse eid="EXO 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 12:17"/>“ታኒ እስራኤለ ደርያ ግብፀፈ ከስዳይ ሄ ጋላስ ግድያ ግሾ ሀ ኡይ ባልያ ላይን ላይን ቦንችተ። ሄስ ህንተዉ መርና ዎጋ ግዶ። <verse eid="EXO 12:17"/><verse number="18" style="v" sid="EXO 12:18"/>ኮይሮ አጌናን፥ ታማነ ኦይዳን ጋላስ ኦማርሳፈ ዶምድ፥ ላታማነ እስን ጋላስ ኦማርስ ጋካናዉ እርሾይ ገልቦና ኡይ ሚተ። <verse eid="EXO 12:18"/><verse number="19" style="v" sid="EXO 12:19"/>ላፑን ጋላስ ጋካናዉ እርሾይ ህንተ ሶን በንቶፎ። እርሾይ ገልዳባ ምያ ቢታ አዉ ናአ ግድን ዎይኮ አሳ ጋደ አስ ግድን፥ ሄ ኬ አዋይ እስራኤለ ማባራ ግዶፈ ኩረቶ። <verse eid="EXO 12:19"/><verse number="20" style="v" sid="EXO 12:20"/>እርሾይ ገልዳባ አይኮካ ሞፕተ። ህንተ ደእያሶን አዉንካ እርሾይ ገልቦና ኡይ ሚተፐ አትሽን፥ እርሾይ ገልዳ ኡይ ሞፕተ” ያግስ።<verse eid="EXO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21"/>ሙሰይ እስራኤለ ጭማታ ኡባ ፄግስድ ሀይሳዳ ያግስ፤ “ህንተ እሶይ እሶይ ሶ ብድ ፓስካ ባኣለ ቦንቻናዉ ማራዘ ዎይኮ ኮለ ሹክተ። <verse eid="EXO 12:21"/><verse number="22" style="v" sid="EXO 12:22"/>ህሶጰ ም ሀይፈ ዳንክ ኤክድ፥ ከረን ደእያ ሱን የድ ኤክድ ዉላ ጋርሳ፥ ቆሙዋነ ቦኮሉዋ ትይተ። ዎንታና ጋካናዉ ህንተፈ እሶይካ ባ ኬፈ ካረ ከዮፖ። <verse eid="EXO 12:22"/><verse number="23" style="v" sid="EXO 12:23"/>ጎዳይ ግብፀ ባይራታ ዎናዉ ሄ ቢታራ ካንያ ዎደ፥ ሄ ሱ ዉላ ጋርሳ፥ ቆሙዋንነ ቦኮሉዋ ቦላ በእድ አግድ አና። ሀይቆ ኤህያ ኪታንቾይ ህንተ ሶ ገልድ ህንተና ዎና መላ ድጋና። <figure style="fig" alt="Hyssop" file="HK00114B.tif" size="col" ref="12:23">ህሶጰ ጌተትያ ም </figure><verse eid="EXO 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 12:24"/>“ህንተነ ህንተ ናይት ሀ ኪታ መርናዉ ናግተ። <verse eid="EXO 12:24"/><verse number="25" style="v" sid="EXO 12:25"/>ጎዳይ ካሰ እማና ግድ ቃላ ገልዳ ቢታ ህንተ ገልያ ዎደ ሀ ዎጋ ኦተ። <verse eid="EXO 12:25"/><verse number="26" style="v" sid="EXO 12:26"/>ህንተ ናይት ህንተና፥ ‘ሀ ባልያ ኑ አይስ ቦንችዉ?’ ግድ ኦይችያ ዎደ፥ <verse eid="EXO 12:26"/><verse number="27" style="v" sid="EXO 12:27"/>ህንተ ኤንታኮ፥ ‘ሀይስ ጎዳ ቦንችያ ፓስካ ያርሾ። ሄስካ ጎዳይ ግብፀ ቢታን እስራኤለ አሳ ኬ አግድ፥ አድ፥ ግብፀ ባይራታ ዎድ፥ ኑና አሽዳ ግሾሳ’ ያግተ” ያግስ።</para>
  <para style="p" vid="EXO 12:27">ሄሳፈ ጉየ፥ እስራኤለት ጉልባትድ ጎይንዶሶና። <verse eid="EXO 12:27"/><verse number="28" style="v" sid="EXO 12:28"/>እስራኤለት፥ ጎዳይ ሙሰነ አሮና ኪትዳይሳዳ ኦዶሶና።<verse eid="EXO 12:28"/></para>
  <para style="s1">ግብፀን ባይራታ ሀይቁዋ</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29"/>ግድ ብላሄ ጎዳይ ግብፀን ባይራ የለትዳ ኡባ፥ ካዉዋ አራታ ላታናዉ ደእያ ባይራ ናኣፐ ዶምድ፥ ቃሾ ኬን ደእያ አሳታ ባይራ ናይታ ጋካናዉነ ባይራ የለትዳ መሄ ኡባይ ሀይቅዶሶና። <verse eid="EXO 12:29"/><verse number="30" style="v" sid="EXO 12:30"/>ካዎይ፥ እያ ሞርናትነ ግብፀ ቢታ አሳ ኡባይ ቃማ ደንድዶሶና። ግብፀ ቢታን አስ ሀይቅቦና እስ ኬካ ባይና ግሾ፥ አሳይ ባንታ ቃላ ቁ ኦድ ግታ ዬሆ ዬክዶሶና። <verse eid="EXO 12:30"/><verse number="31" style="v" sid="EXO 12:31"/>ሄ ቃማ ካዎይ ሙሰነ አሮና ፄግስድ፥ “ህንተነ ህንተ እስራኤለት ታ ቢታፈ ከይድ ቢተ። ህንተ ታና ኦይችዳይሳዳ ብድ ህንተ ጎዳ ጎይንተ። <verse eid="EXO 12:31"/><verse number="32" style="v" sid="EXO 12:32"/>ህንተ ግዳይሳ መላ ህንተ ዶርሳነ መህያ ዉድያ ኤክድ ቢተ። ቃስ ህንተ ፆሳይ ታና አንጃና መላ ዎስተ” ያግስ።<verse eid="EXO 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 12:33"/>ግብፀ አሳይ፥ “እስራኤለት ባንታ ቢታፈ ኤለስድ ከያና መላ ድርግስዶሶና። ህንተ ከዮና እፅኮ ኑ ኡባይ ዉሮስ” ያግዶሶና። <verse eid="EXO 12:33"/><verse number="34" style="v" sid="EXO 12:34"/>ሄሳ ግሾ፥ እስራኤለ አሳይ እርሾይ ገልቦና ሙናቃ ከረን ኩንድ፥ ባንታ ማኡዋን ካምድ፥ ባንታ ሀሸን ቶክዶሶና። <verse eid="EXO 12:34"/><verse number="35" style="v" sid="EXO 12:35"/>እስራኤለት ሙሰይ ኤንታ ኪትዳይሳዳ ግብፀታ፥ ብራ አሌቆ፥ ዎርቃ አሌቆነ ማኦ እማና መላ ኦይችዶሶና። <verse eid="EXO 12:35"/><verse number="36" style="v" sid="EXO 12:36"/>ጎዳይ፥ እስራኤለት ግብፀታ ስንን ሳበታናዳ ኦን፥ ግብፀት ኤንቲ ኦይችዳባ ኡባ እምዶሶና። ሄሳዳ ያትድ ኤንቲ ግብፀታ ሻሉዋ ቦንቅ ኤክድ ብዶሶና።<verse eid="EXO 12:36"/></para>
  <para style="s1">እስራኤለ አሳይ ግብፀፈ ከሳ</para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37"/>እስራኤለት ራምሰ ካታማፐ ደንድድ ሱኮታ ጌተትያ በሲ ቶሆን ብዶሶና። አሳ ታይቦይ ናይታነ ማጫሳ ጉጆና ኡሱፑን ፄቱ ሙኩላ። <verse eid="EXO 12:37"/><verse number="38" style="v" sid="EXO 12:38"/>ቃስ ኤንታራ ሀራ ዳሮ ዋላካ አሳይ፥ መሄይነ ዶርሳ ዴሻ ዉደይ ላገትድ ብስ። <verse eid="EXO 12:38"/><verse number="39" style="v" sid="EXO 12:39"/>ግብፀፈ ኤንቲ ድርጎን ከይዳ ግሾ ካ ካናዉ ዎደ ይዶሶና። ኤንቲ ከይሸ ኤክ ከይዳ እርሾይ ገልቦና ሙኑቃፐ ኤክድ ኡይ ኡክዶሶና።<verse eid="EXO 12:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 12:40"/>እስራኤለት ግብፀ ቢታን ደእዳ ላይይ ኦይዱ ፄታነ ሀስታማ። <verse eid="EXO 12:40"/><verse number="41" style="v" sid="EXO 12:41"/>ኦይዱ ፄታነ ሀስታሙ ላይይ ዉርያ ሄ ዉርሰ ጋላስ ጎዳ አሳ ኡባይ ግብፀ ቢታፈ ከይዶሶና። <verse eid="EXO 12:41"/><verse number="42" style="v" sid="EXO 12:42"/>ጎዳይ ባ አሳ ናግድ፥ ግብፀፈ ከስዳ ዎደ ሳእ ቃማ። ሄ ቃማይ የለተፈ የለተ ጋካናዉ እስራኤለ አሳይ ባርክድ ናግሸ አቅያ፥ ጎዳስ ዱማትዳ ቃማ።<verse eid="EXO 12:42"/></para>
  <para style="s1">ፓስካ ባኣለ ቦንቾ ዎጋ</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43"/>ጎዳይ ሙሰነ አሮና፥ “ፓስካ ጋላሳ ቦንችያ ዎጋይ ሀይሳ ያግስ፤ አሳ ጋደ አስ ፓስካ ካፈ ሞፖ። <verse eid="EXO 12:43"/><verse number="44" style="v" sid="EXO 12:44"/>ህንተ ህንተ ሚሸን ሻምዳ አይለይ ቃፃረትዳፐ ጉየ ሞ። <verse eid="EXO 12:44"/><verse number="45" style="v" sid="EXO 12:45"/>ሽን ህንተራ ጋምእያ እማነ ኡነ ኦያ አስ እያፐ ሞፖ።<verse eid="EXO 12:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="EXO 12:46"/>“ሄ ፓስካ ካይ ካፅዳ ኬን ያን ሚተ። ሄ አሹዋፐ አይኮካ ካረ ከሶፍተ። መቀታፐ እሱዋካ መንፍተ። <verse eid="EXO 12:46"/><verse number="47" style="v" sid="EXO 12:47"/>እስራኤለ ማባራ ኡባይ ፓስካ ባኣለ ቦንቻናዉ ኮሼስ።<verse eid="EXO 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="EXO 12:48"/>“አሳ ጋደ አስ ግድድ ህንተ ግዶን ደእያ አስ ጎዳ ፓስካ ባኣለ ቦንቻናዉ ኮይኮ፥ እያራነ እያ ሶን ደእያ አደ ኡባይ ቃፃረቶ። ሄሳፈ ጉየ፥ እ ቢታ አዉ ናአዳ ታይበትድ ፓስካ ባኣለ ቦንቻናዉ ዳንዳኤስ። ሽን ቃፃረትቦና አስ እያፐ ሞፖ። <verse eid="EXO 12:48"/><verse number="49" style="v" sid="EXO 12:49"/>ሀ ዎጋይ ቢታ አዉ ናይታስነ ሀራ ቢታ አስ ግድድ ህንተ ግዶን ደእያ አሳስ እስኖ” ያግስ።<verse eid="EXO 12:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="EXO 12:50"/>እስራኤለ ኡባይ፥ ጎዳይ ሙሰነ አሮና ኪትዳይሳዳ ኦዶሶና። <verse eid="EXO 12:50"/><verse number="51" style="v" sid="EXO 12:51"/>ሄ ጋላስ ጎዳይ እስራኤለታ ጩጋን ጩጋን ግብፀ ቢታፈ ከስስ።<verse eid="EXO 12:51"/></para>
  <chapter eid="EXO 12"/>
  <chapter number="13" style="c" sid="EXO 13"/>
  <para style="s1">ባይር ኡባይ ጎዳስ ዱማ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1"/>ጎዳይ ሙሰኮ፥ <verse eid="EXO 13:1"/><verse number="2" style="v" sid="EXO 13:2"/>“ባይራ የለትዳ አደ ኡባ ታዉ ዱማያ። እስራኤለ አሳ ግዶን ባይራ የለትዳ ኡባይ፥ አሰ ዎይኮ መሄ ግድን ኡባይ ታባ” ያግስ።<verse eid="EXO 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3"/>ሄሳፈ ጉየ፥ ሙሰይ አሳኮ፥ “ሀ ጋላሳይ፥ ህንተ ግብፀ አይለተፈ ከይዳ ጋላስ ግድያ ግሾ እያ ቆፕተ። ጎዳይ ባ ግታ ዎልቃን ህንተና ከስዳይ ሄ ጋላሳና ግድያ ግሾ፥ እርሾይ ገልዳባ አይኮካ ሞፕተ። <verse eid="EXO 13:3"/><verse number="4" style="v" sid="EXO 13:4"/>አቢባ አጌናን፥ ሀች ጋላሳን ህንተ ግብፀፈ ከይደታ። <verse eid="EXO 13:4"/><verse number="5" style="v" sid="EXO 13:5"/>ጎዳይ ካናነታ፥ ህተታ፥ አሞረታ፥ ህወታነ ያቡሰታ ቢታ ህንተና ላትሳናዉ ህንተ ማይዛታስ ጫቅስ። ጎዳይ ህንተና ማነ ኤስ ኩምዳ ሄ ቢታ ጋያ ዎደ ላይን ላይን ሀ ኮይሮ አጌናን ሀ ጋላሳ ቦንችተ። <verse eid="EXO 13:5"/><verse number="6" style="v" sid="EXO 13:6"/>ላፑን ጋላስ ኩመ እርሾይ ገልቦና ኡይ ሚተ። ላፑን ጋላሳይ ጎዳ ቦንችያ ባኣለ ግዳና። <verse eid="EXO 13:6"/><verse number="7" style="v" sid="EXO 13:7"/>ሄ ላፑን ጋላሳታን እርሾይ ገልቦና ኡይ ሚተ። እርሾይ ዎይኮ እርሾይ ደእያባይ ህንተ ግዶንነ ህንተ ዛዋን በንቶፎ። <verse eid="EXO 13:7"/><verse number="8" style="v" sid="EXO 13:8"/>ሄ ጋላስ ኔኒ፥ ‘ታኒ ሀይሳ ኦይ ታኒ ግብፀፈ ከይያ ዎደ ጎዳይ ታዉ ኦዳይሳ ቆፓናሳ’ ያጋዳ ነ ናይታስ ኦዳ። <verse eid="EXO 13:8"/><verse number="9" style="v" sid="EXO 13:9"/>ሀ ባለይ ህንተ ኩሸን ዎይኮ ህንተ ሶምኦን ቃሸትዳ ማላ ግድድ ህንተና ቆፍስያባ ግዳና። ጎዳይ ህንተና ባ ግታ ዎልቃን ግብፀፈ ከስዳ ግሾ፥ ጎዳ ዎጋይ ህንተ ዶናፐ ዎና መላነ ሀራታስ ህንተ ኦዳና መላ ህንተና ቆፍሳና። <verse eid="EXO 13:9"/><verse number="10" style="v" sid="EXO 13:10"/>ሄሳ ግሾ፥ ህንተ ሀ ባልያ ላይን ላይን ባ ዎድያን ቦንችተ።<verse eid="EXO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11"/>“ጎዳይ ህንተዉነ ህንተ ማይዛታስ እማና ግድ ጫቅዳ ካናነታ ቢታ ገልስድ፥ ሄ ቢታ ህንተዉ እምያ ዎደ፥ <verse eid="EXO 13:11"/><verse number="12" style="v" sid="EXO 13:12"/>ባይራ የለትዳ ኡባ ጎዳስ እማ። ነ መሄታን ባይራ የለትያ አደ ኡባይ ጎዳሳ። <verse eid="EXO 13:12"/><verse number="13" style="v" sid="EXO 13:13"/>ባይራ የለትያ ሀረ ማር ኡባ ዶርሳ ማራን ዎዛ። ዎዞና እፅኮ እያ ሞርግያ መን። ነ አደ ናይታ ግዶን ባይራ የለትዳ ኡባ ዎዛ። <verse eid="EXO 13:13"/><verse number="14" style="v" sid="EXO 13:14"/>ስንራ ያና ላይታን ነ ናይት ነና፥ ‘ሀይስ አይቤ?’ ግድ ኦይችኮ ኔኒ፥ ‘ጎዳይ ኑና ባ ግታ ዎልቃን ግብፀ አይለተፈ ከስስ። <verse eid="EXO 13:14"/><verse number="15" style="v" sid="EXO 13:15"/>ግብፀ ካዎይ ባ ዎዛና ሙምስድ ኑና የዶና እፅን፥ ጎዳይ ግብፀ ቢታን ደእያ አሳፐ ዶምድ መሄ ጋካናዉ ባይራ ኡባ ዎስ። ኑኒ ባይራ የለትዳ መሄ አደ ጎዳስ ያርሸይነ ባይራ አደ ናይታ ኑኒ ዎዘይ ሄሳሳ ያጋ። <verse eid="EXO 13:15"/><verse number="16" style="v" sid="EXO 13:16"/>ጎዳይ ኑና ባ ግታ ዎልቃን ግብፀፈ ከስዳ ግሾ፥ ሀ ባለይ ኑ ኩሸን ዎይኮ ኑ ሶምኦን ቃሸትዳ ማላ ግድድ ኑና ቆፍስያባ ግዳና’ ያጋ” ያግስ።<verse eid="EXO 13:16"/></para>
  <para style="s1">ሻራነ ታማ ቱኡሱ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17"/>ካዎይ አሳ የድዳ ዎደ፥ ፆሳይ ኤንታ ማታ ግድዳ ፍልስፄመ ቢታራ ካንስያ ኦግያራ ካለቤና። ፆሳይ ሄሳ ኦዳይ፥ “አሳ ኦል ጋክኮ፥ ባንታ ቆፋ ላምድ ጉየ ግብፀ ስማና” ያግድ ቆፕዳ ግሾሳ። <verse eid="EXO 13:17"/><verse number="18" style="v" sid="EXO 13:18"/>ሄሳ ግሾ፥ ፆሳይ አሳ መላ ቢታ ኦግያራ ዩሽድ፥ ዞኦ አባኮ<note caller="+" style="f"><char style="fr" closed="false">13:18 </char><char style="fk" closed="false">ዞኦ አባ </char><char style="ft" closed="false">እብራወ ዶናን ሀ ቃላይ ማይረ አባ ጌተቴስ።</char></note> ካለስ። እስራኤለት ኦላስ ጊግድ ግብፀ ቢታፈ ከይዶሶና።<verse eid="EXO 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 13:19"/>ዮሰፍ፥ “ፆሳይ ቱማ ህንተና አሻናዉ ያና። ሄ ዎደ ህንተ ታ መቀ ሀ ቢታፈ ኤክድ ቢተ” ያግድ እስራኤለታ ጫቅስድ ዎዳ ግሾ ሙሰይ እያ መቀ ባራ ኤክድ ብስ።<verse eid="EXO 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 13:20"/>ኤንቲ ሱኮታፐ ደንድድ መላ ቢታ ጋፃን ደእያ ኤታማን ኡትዶሶና። <verse eid="EXO 13:20"/><verse number="21" style="v" sid="EXO 13:21"/>ኤንቲ ጋላስነ ቃማ ሄመታና መላ ጋላስ ኤንታና ካለናዉ ሻራ ቱሳን፥ ቃማ ፖእስድ ኤንታ ካለናዉ ታማ ቱሳን ኤንታ ስንን ብስ። <verse eid="EXO 13:21"/><verse number="22" style="v" sid="EXO 13:22"/>ጋላስ ሻራ ቱሳይ፥ ቃማ ታማ ቱሳይ አሳ ስንፈ ክችቤና።<verse eid="EXO 13:22"/></para>
  <chapter eid="EXO 13"/>
  <chapter number="14" style="c" sid="EXO 14"/>
  <para style="s1">ዞኦ አባ ፕነ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1"/>ሄሳፈ ጉየ፥ ጎዳይ ሙሰኮ፥ <verse eid="EXO 14:1"/><verse number="2" style="v" sid="EXO 14:2"/>“ኤንቲ ጉየ ስሚድ ምግዶላፐነ ዞኦ አባፈ ግዶን፥ ፕሀህሮታ ስንን፥ ባኣል-ዛፎና ማታን ኡታና መላ ኦዳ። <verse eid="EXO 14:2"/><verse number="3" style="v" sid="EXO 14:3"/>ካዎይ፥ ‘እስራኤለት መላ ቢታ ከያናዉ ኦገ ይድ ጮ ቶይላቶሶና’ ያግድ ቆፓና። <verse eid="EXO 14:3"/><verse number="4" style="v" sid="EXO 14:4"/>ታኒ ካዉዋ ዎዛና ሙምሳና፤ እ ኤንታ ጎዳና። ታኒ ካዋነ እያ ኦላንቾታ ኡባ ፆናዳ ቦንቸታና። ሄ ዎደ ግብፀት ታኒ ጎዳ ግደይሳ ኤራና” ያግስ። ሄሳ ግሾ እስራኤለት እ ኦድዳይሳዳ ኦዶሶና።<verse eid="EXO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5"/>አሳይ ከስ ኤክዳይሳ ግብፀ ካዎይ ስእድ፥ እያራነ እያ ሞርናታራ ባንታ ቆፋ ላምድ፥ “ኑኒ አይስ ሄሳ ኦዶ? ኑኒ እስራኤለታ የድድ፥ ኑና ሀጋዝያ አስ አይስ ያነ” ያግዶሶና። <verse eid="EXO 14:5"/><verse number="6" style="v" sid="EXO 14:6"/>ሄሳ ግሾ እ ባ ፓራ ጋርያ ኮርድ፥ ባ ኦላንቾታ ኤክድ ደንድስ። <verse eid="EXO 14:6"/><verse number="7" style="v" sid="EXO 14:7"/>እ ኡሱፑን ፄቱ ዶረትዳ ፓራ ጋረታነ ግብፀ ቢታን ደእያ ሀራ ጋረታ ኡባ ኤንታ ሀላቃታራ ኤክድ ብስ። <verse eid="EXO 14:7"/><verse number="8" style="v" sid="EXO 14:8"/>ጎዳይ ግብፀ ቢታ ካዉዋ ዎዛና ሙምስዳ ግሾ ያሽ ባይና ከሳ ቦላ ደእያ እስራኤለ አሳ የደስ። <verse eid="EXO 14:8"/><verse number="9" style="v" sid="EXO 14:9"/>ግብፀ ካዉዋ ፓራት፥ ፓራ ጋረትነ ኦላንቾት እስራኤለታ ካልድ ብድ፥ አባ ዶናን ባኣል-ዛፎናነ ፕሀህሮታ ማታን ኤንቲ ኡትዳሽን ደምዶሶና።<verse eid="EXO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 14:10"/>ካዎይ ባ ኦላንቾታራ ይሽን እስራኤለት ደምድ ያይዶሶና፤ ባንታና ማዳና መላ ጎዳኮ ዋስዶሶና። <verse eid="EXO 14:10"/><verse number="11" style="v" sid="EXO 14:11"/>ኤንቲ ሙሰኮ፥ “ግብፀ ቢታን ኑስ ዱፎይ ይዴ? ኑኒ መላ ቢታ ሀይቃና መላ ኑና ከስዳይ ሄሳሴ? ኑና ግብፀፈ አይስ ኤሀዲ? <verse eid="EXO 14:11"/><verse number="12" style="v" sid="EXO 14:12"/>ግብፀን ደእሸ ሀይስ ሀናናይሳ ኤርድ፥ ‘ኑና አጋ ኑኒ ግብፀታስ ሃረታና’ ያግድ ነዉ ኦድቦኮ? መላ ቢታን ሀይቃናፐ ኤንታዉ ሃረተይስ ኑስ ሎኦሽን” ያግዶሶና።<verse eid="EXO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 14:13"/>ሽን ሙሰይ ዛሪድ፥ “ያዮፍተ፤ ምንድ ኤቅተ። ጎዳይ ሀች ህንተና አሽያ አሹዋ ህንተ በአና። ሀች ህንተ በእያ ግብፀታ ዛር በኤከታ። <verse eid="EXO 14:13"/><verse number="14" style="v" sid="EXO 14:14"/>ህንተ ስእ ጊተ፤ ጎዳይ ህንተ ግሾ ኦለታና” ያግስ።<verse eid="EXO 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15"/>ጎዳይ ሙሰኮ፥ “ኔኒ አይስ ታኮ ዋሳይ? እስራኤለት ስን ሄመታና መላ ኦዳ። <verse eid="EXO 14:15"/><verse number="16" style="v" sid="EXO 14:16"/>ነ ፃምአ አባ ቦላ ደን፤ ሃይ ሻከታና። እስራኤለት መላ ቢታራ አባ ፕንድ ባና። <verse eid="EXO 14:16"/><verse number="17" style="v" sid="EXO 14:17"/>ታኒ ግብፀታ ዎዛና ሙምሳና፤ ኤንቲ ህንተ ጌዶ ካልድ አባን ገላና። ታኒ ካዉዋ፥ እያ ኦላንቾታ፥ እያ ፓራ ጋርያነ እያ ፓራ ጋርያ ላገይሳታ ፆናዳ ቦንቸታና። <verse eid="EXO 14:17"/><verse number="18" style="v" sid="EXO 14:18"/>ታ ኤንታ ፆንዳ ዎደ፥ ታኒ ጎዳ ግደይሳ ግብፀት ኤራና” ያግስ።<verse eid="EXO 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19"/>ፆሳ ኪታንቾይ፥ እስራኤለ ኦላንቾታፐ ስንራ ሄመተይስ ኤንታፈ ጉየ አድ ሄመትስ። ሻራ ቱሳይ ኤንታ ስንፈ ጉየ ባጋ አድ፥ <verse eid="EXO 14:19"/><verse number="20" style="v" sid="EXO 14:20"/>ግብፀታስነ እስራኤለታስ ግዶን ኤቅስ። ሄ ሻራይ ግብፀታስ ምስድ፥ እስራኤለታስ ፖእስስ። ያትን ቃማ ኩመ ግብፀት እስራኤለታኮ ሺቅቦኮና።<verse eid="EXO 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21"/>ሙሰይ አባ ቦላ ባ ኩሽያ ምጭስ። ጎዳይ ሄ ቃማ ዎልቃማ ዶሎሀ ጫርኮ የድድ መላ ቢት በንታና ጋሶ አባ ሾጭስ። ሃይ ሻከትስ። <verse eid="EXO 14:21"/><verse number="22" style="v" sid="EXO 14:22"/>ሃይ ሻከትድ ናምኡ ባጋን ጎዳዳ ኤቅን፥ እስራኤለት መላ ቢታራ ሄመትድ ፕንዶሶና። <verse eid="EXO 14:22"/><verse number="23" style="v" sid="EXO 14:23"/>ግብፀ ካዉዋ ፓራት፥ እያ ፓራ ጋረትነ እያ ፓራ ጋርያ ላገይሳት ኤንታና ካልድ፥ አባን ገልዶሶና። <verse eid="EXO 14:23"/><verse number="24" style="v" sid="EXO 14:24"/>ሳእ ዎንታና ሀንሽን ጎዳይ ታማነ ሻራ ቱሳን ግድድ ግብፀ ኦላንቾታ ዱገ ፄልድ፥ ኤንታዉ ሀናናባ ይስስ። <verse eid="EXO 14:24"/><verse number="25" style="v" sid="EXO 14:25"/>ፓራ ጋረታ ገርቶይ ገንደረቶና መላ ጎዳይ ኤንታ ፓራ ጋረታ ገርቱዋ ሳአራ ኦይስ። ግብፀት፥ “ጎዳይ እስራኤለታ ማድድ ኑና ኦልያ ግሾ፥ ኑኒ ኤንታ አግድ ባቃቶስ” ያግዶሶና።<verse eid="EXO 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 14:26"/>ጎዳይ ሙሰኮ፥ “ሃይ ግብፀታ ቦላ፥ ኤንታ ፓራ ጋረታ ቦላነ ኤንታ ፓራ ጋርያ ላገይሳታ ቦላ ጉየ ስማና መላ ነ ኩሽያ አባ ቦላ ምጫ” ያግስ። <figure style="fig" alt="Horses and chariots in battle" file="HK00191B.tif" size="span" ref="14:6">ፓራነ ፓራ ጋረ</figure> <verse eid="EXO 14:26"/><verse number="27" style="v" sid="EXO 14:27"/>ሙሰይ ባ ኩሽያ አባ ቦላ ምጭን፥ ሳእ ዎንትያ ዎደ አባይ ባ ካሰ በሳ ጉየ ስምስ። ግብፀት ባቃታናዉ ኮይዶሶና፥ ሽን ጎዳይ ኤንታ አባን የግስ። <verse eid="EXO 14:27"/><verse number="28" style="v" sid="EXO 14:28"/>ሃይ ጉየ ስሚድ፥ እስራኤለታ ካልድ አባን ገልዳ ፓራ ጋረታ፥ ፓራ ጋረታ ላገይሳታነ ግብፀ ኦላንቾታ ምትስ። ኤንታፈ እሶይካ አትቤና። <verse eid="EXO 14:28"/><verse number="29" style="v" sid="EXO 14:29"/>ሽን እስራኤለት አባ ግዶራ መላ ቢታራ ሄመትድ፥ ሃይ ሻከትድ ጎዳዳ ኤቅዳሽን ፕንዶሶና። <verse eid="EXO 14:29"/><verse number="30" style="v" sid="EXO 14:30"/>ጎዳይ ሄ ጋላስ እስራኤለ አሳ ግብፀታ ኩሸፐ አሽስ። እስራኤለት ሀይቅድ ዝንእዳ ግብፀታ አባ ዶናን በእዶሶና። <verse eid="EXO 14:30"/><verse number="31" style="v" sid="EXO 14:31"/>እስራኤለት ጎዳይ ግብፀታ ቦላ በስዳ ግታ ዎልቃ በእዳ ዎደ ጎዳ ያይዶሶና። ጎዳነ እያ አይልያ ሙሰ አማንዶሶና።<verse eid="EXO 14:31"/></para>
  <chapter eid="EXO 14"/>
  <chapter number="15" style="c" sid="EXO 15"/>
  <para style="s1">ሙሰነ ማይራም ማዝሙረ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1"/>ሄ ዎደ ሙሰይነ እስራኤለ አሳይ ሀ ማዝሙርያ ጎዳስ የፅዶሶና።</para>
  <para style="b" vid="EXO 15:1"/>
  <para style="q1" vid="EXO 15:1">እ ባ ግታ ፆኑዋን ቦንቸትዳ ግሾ፥</para>
  <para style="q2" vid="EXO 15:1">ታኒ ታ ጎዳስ ጋላታ ማዝሙርያ የፃና።</para>
  <para style="q2" vid="EXO 15:1">ፓራነ ፓራ ቶገይሳ አባን የግስ።<verse eid="EXO 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 15:2"/>ጎዳይ ታ ምኖተነ ታ ማዝሙርያ ጋሱዋ፥</para>
  <para style="q2" vid="EXO 15:2">እ ታና አሸይሳ።</para>
  <para style="q1" vid="EXO 15:2">እ ታ ፆሳ፤ ታኒ እያ ሳባና።</para>
  <para style="q2" vid="EXO 15:2">እ ታ አዋታ ፆሳ፤ ታኒ እያ ቦንቻና፤ ጋላታና።<verse eid="EXO 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 15:3"/>ጎዳይ ኦላንቾ፤</para>
  <para style="q2" vid="EXO 15:3">እያ ሱንይካ ጎዳ።<verse eid="EXO 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EXO 15:4"/>ግብፀ ካዉዋ ፓራ ጋረታነ እያ ኦላንቾታ አባን የግስ።</para>
  <para style="q2" vid="EXO 15:4">ግብፀ ካዉዋ፥ ኡባፈ አ ግድዳ ቶራ ሞጮናታ፥ ዞኦ አባን ምትስስ።<verse eid="EXO 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EXO 15:5"/>ኤንታና ጪሞ ሃይ ምትስ፤</para>
  <para style="q2" vid="EXO 15:5">ኤንቲ ሹቻዳ ጪሞን ምተትዶሶና።<verse eid="EXO 15:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="EXO 15:6"/>“አቤት ጎዳዉ፥ ነ ኡሻቻ ኩሸይ ዎልቃን ጎባ፤</para>
  <para style="q2" vid="EXO 15:6">ነ ኩሸይ ሞርክያ መንረስ።<verse eid="EXO 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EXO 15:7"/>ነ ግታ ፆኑዋን፥</para>
  <para style="q2" vid="EXO 15:7">ኔራ ኤቀተይሳታ ኦላዳሳ።</para>
  <para style="q1" vid="EXO 15:7">ነ ሸነይ ታማዳ ኤፅድ፥</para>
  <para style="q2" vid="EXO 15:7">ኤንታ ካፍለዳ ምስ።<verse eid="EXO 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EXO 15:8"/>ነ ሀንቁዋን ነ አባ ፑንን፥</para>
  <para style="q2" vid="EXO 15:8">ሃይ ጎዳዳ ኤቅስ።</para>
  <para style="q2" vid="EXO 15:8">አባ ጪሞት ጋርሳን ሹቻዳ ምንዶሶና።<verse eid="EXO 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="EXO 15:9"/>“ሞርከይ፥ ‘ታኒ ኤንታ የደዳ ኦይካና፤</para>
  <para style="q2" vid="EXO 15:9">ታኒ ኤንታ ሻሉዋ ሻካዳ፥</para>
  <para style="q2" vid="EXO 15:9">ታ ኮይዳባ ኡባ ኤካና።</para>
  <para style="q2" vid="EXO 15:9">ታኒ ታ ማሻ ሾዳዳ ኤንታ ይሳና’ ያግድ ጬቀትስ።<verse eid="EXO 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EXO 15:10"/>ሽን ኔኒ ኤንታ ፑንን፥ አባይ ኤንታ ምትስ።</para>
  <para style="q2" vid="EXO 15:10">ኤንቲ አባ ጪሙዋን ብራታዳ ምተትዶሶና።<verse eid="EXO 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EXO 15:11"/>አቤት ጎዳዉ፥ ፆሳታ ግዶን ነ ማል ኦኔ?</para>
  <para style="q2" vid="EXO 15:11">ጌሻተን ያሸይ ነ ማል ኦኔ?</para>
  <para style="q2" vid="EXO 15:11">ቦንቾይ ዳጋንይነ ማላልስያባ ኦይ ነ ማል ኦኔ?<verse eid="EXO 15:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EXO 15:12"/>ኔኒ ነ ኡሻቻ ኩሽያ ምጭዳ ዎደ፥</para>
  <para style="q2" vid="EXO 15:12">ቢታይ ኤንታ ምትስ።<verse eid="EXO 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="EXO 15:13"/>“ኔኒ ዎዝዳ አሳ ነ መርና ሲቁዋን ካለዳሳ።</para>
  <para style="q2" vid="EXO 15:13">ኔኒ ነ ዎልቃን ኤንታ ነ ጌሻ ቢታ ገልሳዳሳ።<verse eid="EXO 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EXO 15:14"/>ካዎተት ሄሳ ስእድ ያሻን ኮኮርዶሶና።</para>
  <para style="q2" vid="EXO 15:14">ፍልስፄመ ቢታ አሳትካ ኡንኤትዶሶና።<verse eid="EXO 15:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EXO 15:15"/>ሄ ዎደ ኤዶመ ቢታ ሀላቃት ዳጋምዶሶና፤</para>
  <para style="q2" vid="EXO 15:15">ሞአበ ቢታ ሃረይሳት ያሻን ኮኮርዶሶና፤</para>
  <para style="q1" vid="EXO 15:15">ካናነ አሳት ዳጋማን ዳቡርዶሶና።<verse eid="EXO 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EXO 15:16"/>ዳጋምነ ያሽ ኤንታ ኦይክስ።</para>
  <para style="q1" vid="EXO 15:16">አቤት ጎዳዉ፥ ኤንቲ ነ ዎልቃ ግታተ በእድ፥</para>
  <para style="q2" vid="EXO 15:16">ነ አሳይ አና ጋካናዉ፥</para>
  <para style="q2" vid="EXO 15:16">ኔኒ ዎዝዳ አሳይ አና ጋካናዉ፥</para>
  <para style="q2" vid="EXO 15:16">ሹቻዳ ቶለትድ ኤቅዶሶና።<verse eid="EXO 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EXO 15:17"/>ኔኒ ኤንታ ኤሀዳ፥ ነ ዙማ ሁጰን ቶካና።</para>
  <para style="q2" vid="EXO 15:17">አቤት ጎዳዉ፥ ሄ በሳይ ኔኒ ነዉ ዳናዉ ዶርዳ በሲ፥</para>
  <para style="q2" vid="EXO 15:17">ኔኒ ነ ኩሽያን ምንዳ ኬፅዳ ነ ኬ።<verse eid="EXO 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 15:18"/>ጎዳይ መርና ጋካናዉ ካዎታና”</para>
  <para style="q2" vid="EXO 15:18">ያግድ የፅዶሶና።<verse eid="EXO 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19"/>እስራኤለት አባ ግዶራ መላ ቢታራ ፕንን፥ ግብፀ ካዉዋ ፓራት፥ እያ ፓራ ጋረትነ እያ ፓራ ቶገይሳት አባን ገልዳ ዎደ ጎዳይ ኤንታ ቦላ አባ ሃ ዛርን ሃይ ኤንታ ምትስ። <verse eid="EXO 15:19"/><verse number="20" style="v" sid="EXO 15:20"/>አሮና ምችያ፥ ናብያ ማይራማ ካራቦ ኤካሱ። ሀራ ማጫሳት ኡባይ ባንታ ካራቦ ኤክድ ባቅሸነ የፅሸ እዮ ካልዶሶና። <verse eid="EXO 15:20"/><verse number="21" style="v" sid="EXO 15:21"/>ማይራማ፥</para>
  <para style="q1" vid="EXO 15:21">“እ ባ ግታ ፆኑዋን ቦንቸትዳ ግሾ፥</para>
  <para style="q2" vid="EXO 15:21">ፓራነ ፓራ ቶገይሳታ እ አባን የግዳ ግሾ፥</para>
  <para style="q2" vid="EXO 15:21">እያዉ ማዝሙርያ የፅተ” ያጋዳ ኤንታዉ የፃሱ።<verse eid="EXO 15:21"/></para>
  <para style="s1">ጫሞ ሃ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22"/>ሄሳፈ ጉየ፥ ሙሰይ ዞኦ አባ ማታፐ እስራኤለታ ደንድ ሹራ መላ ቢታ ጋካናዉ ካለስ። ሄ መላ ቢታን ኤንቲ ሄ ጋላስ ሄመትዶሶና ሽን ሃ ደምቦኮና። <verse eid="EXO 15:22"/><verse number="23" style="v" sid="EXO 15:23"/>ኤንቲ ማራ ጌተትያ በሲ ጋክድ ሃ ደምዶሶና፥ ሽን ሃይ ጫሞ ግድያ ግሾ ኡያናዉ ዳንዳእቦኮና። ሄሳ ግሾ ሄ በሳይ ማራ<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="fq" closed="false">ማራ: </char><char style="ft" closed="false">ማራ ጉሳይ “ጫሞ” ጉሱ።</char></note> ጌተትስ። <verse eid="EXO 15:23"/><verse number="24" style="v" sid="EXO 15:24"/>አሳይ፥ “ኑኒ አይ ኡያኔ?” ግድ ሙሰ ቦላ ዙዙምዶሶና።<verse eid="EXO 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 15:25"/>ያንን፥ ሙሰይ ጎዳኮ ዋስስ፤ ጎዳይ እያ እስ ም በስስ። ሙሰይ ሄ ም ሃን የግን ሃይ ማልእስ።</para>
  <para style="p" vid="EXO 15:25">ያን ጎዳይ ኤንታዉ ህገ እሚስ፤ ያን ጎዳይ ኤንታ ፓጭስ። <verse eid="EXO 15:25"/><verse number="26" style="v" sid="EXO 15:26"/>ሙሰይ ኤንታኮ፥ “ህንተ ህንተ ጎዳ ፆሳስ ኪተትተ፤ እ ኮያባ ኦተ። ህንተ ታዉ ፖሎ ኪተትኮነ ታ ግያባ ስእኮ ግብፀታ ቦላ ታ የድዳ ሀርግያን ህንተና ፕርድከ። ታኒ ህንተና ፓያ ጎዳ” ያግስ።<verse eid="EXO 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 15:27"/>ሄሳፈ ጉየ ኤንቲ ኤልማ ብዶሶና። ያን ታማነ ናምኡ ሃ ፑልቶትነ ላፑን ታሙ ዛምባ ምት ደኦሶና። ኤንቲ ያን ሃ ዶናን ኡትዶሶና።<verse eid="EXO 15:27"/></para>
  <chapter eid="EXO 15"/>
  <chapter number="16" style="c" sid="EXO 16"/>
  <para style="s1">ማናነ ኩራቾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1"/>ግብፀፈ ከይዳ ናምአን አጌናን፥ ታማነ እቻሻን ጋላስ እስራኤለ አሳ ኡባይ ኤልማፐ ደንድድ፥ ኤልማፐነ ሲናፐ ግዶን ደእያ ሲነ ጌተትያ መላ ቢታ ይዶሶና። <verse eid="EXO 16:1"/><verse number="2" style="v" sid="EXO 16:2"/>እስራኤለ አሳ ኡባይ መላ ቢታን ሙሰ ቦላነ አሮና ቦላ ዙዙምዶሶና። <verse eid="EXO 16:2"/><verse number="3" style="v" sid="EXO 16:3"/>እስራኤለት ኤንታኮ፥ “ኑኒ ግብፀ ቢታን ጎዳ ኩሸን ሀይቅዳ ግዶርኮሽን። ሀር አቶ ኑኒ ያን ዎ ኡትድ አሹዋነ ሀራ ካ ኡባ ኑ ኮይዳ መላ ሞስ። ሽን ህንተ ኑና ኡባ ከስድ ሀ መላ ቢታ ኮሻን ዎሴታ” ያግዶሶና።<verse eid="EXO 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 16:4"/>ጎዳይ ሙሰኮ፥ “ታኒ ህንተዉ ሳሎፐ ካ ቡክሳና። አሳይ ጋላስ ጋላስ ከይድ፥ ሀችስ ግድያባ ማፃናዉ ኮሼስ። አሳይ ታው ኪተትያኮነ ኪተቶናኮ ታኒ ኤንታ ሄሳን ፓጫና። <verse eid="EXO 16:4"/><verse number="5" style="v" sid="EXO 16:5"/>ሳምንታን ሳምንታን ኡሱፑን ጋላስ ኤንቲ ካሰ ማፀይሳስ ናምኡ ኩሸ ማፅድ ካ” ያግስ።<verse eid="EXO 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 16:6"/>ሄሳ ግሾ ሙሰይነ አሮን እስራኤለ አሳኮ፥ “ህንተና ግብፀ ቢታፈ ከስዳይ ጎዳ ግደይሳ ኦማርስ ህንተ ኤራና። <verse eid="EXO 16:6"/><verse number="7" style="v" sid="EXO 16:7"/>ህንተ ጎዳ ቦላ ዙዙምዳይሳ እ ስእዳ ግሾ፥ ዎንታ ጎዳ ቦንቹዋ ህንተ በአና። ህንተ ኑ ቦላ ዙዙማናዉ ኑኒ ኦኔ?” ያግዶሶና። <verse eid="EXO 16:7"/><verse number="8" style="v" sid="EXO 16:8"/>ሄሳፈ ጉየ ሙሰይ፥ “ህንተ ጎዳ ቦላ ዙዙምዳይሳ እ ስእዳ ግሾ፥ እ ህንተዉ ኦማርስ ማናዉ አሾ እመይነ ዎንታ ማናዉ ህንተ ኮይያ መላ ኡይ እመይ ጎዳ ግደይሳ ህንተ ኤራና። ህንተ ኑ ቦላ ግዶናሽን ጎዳ ቦላ ዙዙመታ” ያግስ።<verse eid="EXO 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 16:9"/>ሙሰይ አሮናኮ፥ “ኔኒ እስራኤለ አሳ ኡባ፥ ‘ጎዳይ ህንተ ዙዙን ስእዳ ግሾ፥ ይድ ጎዳ ስንን ኤቅተ’ ያጋ” ያግስ። <verse eid="EXO 16:9"/><verse number="10" style="v" sid="EXO 16:10"/>አሮን እስራኤለ አሳ ኡባስ ኦድዳ ዎደ ኤንቲ መላ ቢታ ስሚድ፥ ሻራ ግዶራ ቆንጭዳ ጎዳ ቦንቹዋ በእዶሶና። <verse eid="EXO 16:10"/><verse number="11-12" style="v" sid="EXO 16:11-12"/>ጎዳይ ሙሰኮ፥ “ታኒ እስራኤለታ ዙዙን ስአስ። ኔኒ ኤንታዉ ‘ኦማርስ አሾ ህንተ ማና፤ ዎንታ ህንተ ኮይዳ መላ ኡይ ኤካና። ሄ ዎደ ህንተ ታኒ ጎዳ ህንተ ፆሳ ግደይሳ ኤራና’ ያጋዳ ኦዳ” ያግስ።<verse eid="EXO 16:11-12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 16:13"/>ሄ ጋላስ ኦማርስ ኩራቾት ይድ፥ እስራኤለ አሳይ ደእያ በሳ ማእዶሶና። ዎንታ ኤንታ ሄራን አክ ቢታ ማእስ።<figure style="fig" alt="Israelites gathering quail" file="CO00854B.tif" size="span" ref="16:13">እስራኤለት ኩራቾማፅሽን</figure> <verse eid="EXO 16:13"/><verse number="14" style="v" sid="EXO 16:14"/>አካይ፥ ፅዝእዳ ዎደ ሌኦነ ላፋባይ መላ ቢታ ቦላ በንትስ። እካ ሻቻዳ ቦ። <verse eid="EXO 16:14"/><verse number="15" style="v" sid="EXO 16:15"/>እስራኤለት ሄሳ በእዳ ዎደ እያ ኤሮና ግሾ፥ እሶይ እሱዋኮ፥ “ሀይስ አይቤ?” ያግዶሶና።</para>
  <para style="p" vid="EXO 16:15">ያትን ሙሰይ ኤንታኮ፥ “ህንተ ማና መላ ጎዳይ እምዳ ካይ ሀይሳ። <verse eid="EXO 16:15"/><verse number="16" style="v" sid="EXO 16:16"/>ጎዳይ፥ ‘አሳይ እሶይ እሶይ ባዉ ኮሸይሳ መላ ሺሾ፤ ሶን ደእያ እስ እስ አስ ባ ሁጰን ናምኡ ልትሮ ኤኮ’ ያጋ” ያግድ ኪትስ።<verse eid="EXO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17"/>እስራኤለት ኪተትዳይሳዳ ኦዶሶና፤ ባጋይ ዳርስድ፥ ባጋይ ጉድ ሺሽዶሶና። <verse eid="EXO 16:17"/><verse number="18" style="v" sid="EXO 16:18"/>ኤንቲ ሺሽድ ልትሮን ማክያ ዎደ ዳርስ ሺሽዳይሳስ ፓላህቤና፤ ጉ ሺሽዳይሳስካ ፓጭቤና። እሶይ እሶይ ባዉ ኮሸይሳ መላ ሺሽስ። <verse eid="EXO 16:18"/><verse number="19" style="v" sid="EXO 16:19"/>ሙሰይ ኤንታኮ፥ “ኦንካ እያፐ ዎንታስ አሾፎ” ያግድ ኪትስ። <verse eid="EXO 16:19"/><verse number="20" style="v" sid="EXO 16:20"/>ሽን ኤንታፈ እሶት እሶት ሙሰይ ኦድዳይሳ ስኦና እፅድ ዎንታስ ምንጅዶሶና። ኤንቲ ምንጅዳይስ ጉፁንትድ ፅንቅስ። ሄሳ ግሾ ሙሰይ ኤንታ ቦላ ሀንቀትስ። <verse eid="EXO 16:20"/><verse number="21" style="v" sid="EXO 16:21"/>ዎንታ ዎንታ አሳ ኡባይ ባንታዉ ኮሸይሳ መላ ሺሼስ። አዋይ ምችያ ዎደ ሳአን አትዳይስ ትልኤስ።<verse eid="EXO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 16:22"/>ኡሱፑን ጋላስ ኤንቲ ካሰ ሺሽያ ናምኡ ልትሩዋ ቦላ እያ መላ ጉጅድ እስ እስ አሳስ ኦይዱ ልትሮ ሺሾ። ያትን እስራኤለ ሀላቃት ብድ ሄሳ ሙሰስ ኦድዶሶና። <verse eid="EXO 16:22"/><verse number="23" style="v" sid="EXO 16:23"/>ሙሰይ ዛሪድ፥ “ዎንቶይ ሸምፖ ጋላስ ግድድ ጎዳ ቦንችያ ጌሻ ሳምባታ። ሄሳ ግሾ፥ ህንተ ኡክያባ ኡክተ፤ ዶይስያባ ዶይስተ። ዎንቶስ ዎተ” ያግስ። <verse eid="EXO 16:23"/><verse number="24" style="v" sid="EXO 16:24"/>ኤንቲ ሙሰይ ኪትዳይሳዳ ዎንቶስ ዎን፥ ፅንቅቤና ዎይኮ ጉፁንትቤና። <verse eid="EXO 16:24"/><verse number="25" style="v" sid="EXO 16:25"/>ሙሰይ ኤንታኮ፥ “ሀይሳ ሀች ሚተ፤ ሀች ጎዳ ቦንችያ ሸምፖ ሳምባታ ግድያ ግሾ፥ ህንተ ሀች ደንባን ደመከታ። <verse eid="EXO 16:25"/><verse number="26" style="v" sid="EXO 16:26"/>ህንተ ካ ኡሱፑን ጋላሳታን ሺሻናዉ ዳንዳኤታ፥ ሽን ላፑን ጋላሳይ ሸምፖ ጋላስ ግድያ ግሾ አይብ ካካ ሄ ዎደ ዴና” ያግስ።<verse eid="EXO 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 16:27"/>ላፑን ጋላሳን እስ እስ አሳይ ሺሻናዉ ከይዶሶና፥ ሽን አይኮካ ደምቦኮና። <verse eid="EXO 16:27"/><verse number="28" style="v" sid="EXO 16:28"/>ያትን፥ ጎዳይ ሙሰኮ፥ “ታ ኪታነ ታ ህግያ ህንተ ናጎና እፀይ አዉደ ጋካናሴ? <verse eid="EXO 16:28"/><verse number="29" style="v" sid="EXO 16:29"/>ታኒ ህንተዉ ሳምባታ እምዳይሳ አኬክተ። ኡሱፑን ጋላሳን እ ህንተዉ ናምኡ ጋላሳ ካ እመይ ሄሳ ግሾሳ። ላፑን ጋላሳን ኦንካ ካረ ከዮና ባ ሶን ባ ሶን ጋምኦ” ያግስ። <verse eid="EXO 16:29"/><verse number="30" style="v" sid="EXO 16:30"/>ሄሳ ግሾ፥ አሳይ ላፑን ጋላሳን ሸምፕስ።<verse eid="EXO 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31"/>እስራኤለ አሳይ ሄ ካ ማና<note caller="+" style="f"><char style="fr" closed="false">16:31</char><char style="fq" closed="false">ማና: </char><char style="ft" closed="false">እብራወ ዶናን ማና ጉሳይ “ሀይስ አይበ” ጉሱ።</char></note> ግድ ፄግዶሶና። ማናይ ዴቦ አይፈ መላ ግድድ ቦ። እ ኤሳራ ኡክዳ ኡይዳ ማልኤስ።<verse eid="EXO 16:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 16:32"/>“ታኒ ህንተና ግብፀ ቢታፈ ከስዳ ዎደ መላ ቢታን ሙዝዳይ ማና ግደይሳ ያና የለተይ በአና መላ እያፐ ናምኡ ክሎ ግራመ ዎተ” ያግድ ጎዳይ ኪትዳይሳ ሙሰይ እስራኤለ አሳስ ኦድስ።<verse eid="EXO 16:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 16:33"/>ሙሰይ አሮናኮ፥ “ናምኡ ክሎ ግራመ ማና ኤካዳ ፃሮን ቆላዳ ያና የለተስ ጎዳይ ጎይነትያ በሳን ዎ” ያግስ።<verse eid="EXO 16:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 16:34"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ አሮን ማና ጎዳ ስንን ታቦትያ ግዶን ዎስ። <verse eid="EXO 16:34"/><verse number="35" style="v" sid="EXO 16:35"/>እስራኤለት ባንታ ደእያ ካናነ ቢታ ዛዋ ይድ ጋካናዉ ኦይታሙ ላይ ማና ምዶሶና። <verse eid="EXO 16:35"/><verse number="36" style="v" sid="EXO 16:36"/>ሄ ዎደ አሳይ ማክያ ሚሸይ ላታማነ ናምኡ ልትሮ ኦይኬስ።<verse eid="EXO 16:36"/></para>
  <chapter eid="EXO 16"/>
  <chapter number="17" style="c" sid="EXO 17"/>
  <para style="s1">ዛላፈ ፑልትዳ ሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1"/>እስራኤለ አሳ ኡባይ ጎዳይ ኪትዳይሳዳ እስ በሳፈ ሀራ በሲ ዩይሸ፥ ሲን መላ ቢታፈ ደንድድ ራፍድማ ጌተትያ በሳን ኡትዶሶና። ሽን ኤንቲ ኡያናዉ ሃ ሄ በሳን ይስ። <verse eid="EXO 17:1"/><verse number="2" style="v" sid="EXO 17:2"/>ኤንቲ፥ “ኑስ ኡያናዉ ሃ እማ” ያግድ ሙሰራ ካጨትዶሶና።</para>
  <para style="p" vid="EXO 17:2">ሙሰይ ዛሪድ፥ “ህንተ ታራ አይስ ካጨቴቲ? ጎዳ አይስ ፓጨቲ?” ያግስ።<verse eid="EXO 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 17:3"/>ሽን አሳይ ያን ሃ ሳሞትድ፥ “ኔኒ ኑና፥ ኑ ናይታነ ኑ መህያ ሳሞን ዎናዉ ግብፀፈ ከሳዳ ሀይሳ አይስ ኤሀዲ?” ያግድ ሙሰ ቦላ ዛር ዛር ዙዙምዶሶና።<verse eid="EXO 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 17:4"/>ያትን ሙሰይ፥ “ታኒ ሀ አሳ ዋቶ? ኤንቲ ታና ሹቻን ጫዳና ሀኖሶና” ያግድ ጎዳ ዎስስ።<verse eid="EXO 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5"/>ጎዳይ ሙሰኮ፥ “ኔኒ እስራኤለ አሳፐ ጭማታ ኔራ ኤካዳ አሳፐ ስን አዳ ሄመታ። ቃስ ናይለ ሻፋ ሾጭዳ ፃምኣ ነ ኩሸን ኦይካዳ ባ። <verse eid="EXO 17:5"/><verse number="6" style="v" sid="EXO 17:6"/>ታኒ ኮሬባ ዙማን ዛላ ቦላ ነ ስንን ኤቃና። ሄ ዛላ ሾጫ፤ አሳይ ኡያና ሃይ እያፐ ከያና” ያግስ። ሙሰይ እስራኤለ ጭማታ ስንን ሄሳ ኦስ።<verse eid="EXO 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 17:7"/>እስራኤለት፥ “ቱማ ጎዳይ ኑራ ደኢ?” ያግድ ዙዙምዳ ግሾነ ጎዳ ፓጭዳ ግሾ ሄ በሳ ማሳሀነ ማርባ<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">ማሳሀነ ማርባ: </char><char style="ft" closed="false">እብራወ ዶናን ማሳሀ ጉሳይ “ፓጮ” ጉሱ፥ ቃስ ማርባ ጉሳይ “ዙዙን” ጉሱ።</char></note> ግድ ሱንስ።<verse eid="EXO 17:7"/></para>
  <para style="s1">እስራኤለነ አማለቃ ኦላ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8"/>አማለቃት ይድ ራፍድማን እስራኤለታ ኦልዶሶና። <verse eid="EXO 17:8"/><verse number="9" style="v" sid="EXO 17:9"/>ሙሰ እያሱኮ፥ “ኔኒ ዎንቶ አማለቃታ ኦላናዉ ጉ አስ ዶራ። ታኒ ፆሳ ፃምኣ ኦይካዳ ዙማ ሁጰን ኤቃና” ያግስ።<verse eid="EXO 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 17:10"/>ሙሰይ ኪትዳይሳዳ እያሱይ አማለቃታ ኦልስ። ሙሰይ፥ አሮንነ ሆር ዙማ ሁጰ ከይዶሶና። <verse eid="EXO 17:10"/><verse number="11" style="v" sid="EXO 17:11"/>ሙሰይ ባ ኩሽያ ደንድ ጋምእያ ዎደ እስራኤለት ፆኖሶና፥ ሽን እ ባ ኩሽያ ዎያ ዎደ አማለቃት ፆኖሶና። <verse eid="EXO 17:11"/><verse number="12" style="v" sid="EXO 17:12"/>ሙሰ ኩሸይ አርጋጭዳ ዎደ አሮናራነ ሁራራ ሹች ኤህድ ሙሰ እያ ቦላ ኡትስዶሶና። አሮንነ ሁር ኡሻቻራነ ሀድርሳራ ኤቅድ አዋይ ዉላና ጋካናዉ እያ ኩሽያ ካትስ ኦይክዶሶና። <verse eid="EXO 17:12"/><verse number="13" style="v" sid="EXO 17:13"/>ሄሳዳ ኦድ እያሱይ አማለቃታ ማሻን ኦልድ ይስስ።<verse eid="EXO 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14"/>ሄሳፈ ጉየ ጎዳይ ሙሰኮ፥ “ሀይስ ኡባ ዎደ ሀሳየታና መላ ሀ ፆኑዋ ታርክያ ፃፋ። ታኒ አማለቃታ ቡርፆራ ይሳናይሳነ ኤንቲ ዶገታናይሳ እያሱስ ኦዳ” ያግስ። <verse eid="EXO 17:14"/><verse number="15" style="v" sid="EXO 17:15"/>ሙሰይ ያርሾ በሲ ጊግስድ፥ “ጎዳይ ታ ፆኑዋ ባንድራ” ግድ ሱንስ። <verse eid="EXO 17:15"/><verse number="16" style="v" sid="EXO 17:16"/>እ፥ “ጎዳ ፆኖ ባንድራ ቁ ኦድ ኦይክተ። ጎዳይ አማለቃታ መርናዉ ኦላና” ያግስ።<verse eid="EXO 17:16"/></para>
  <chapter eid="EXO 17"/>
  <chapter number="18" style="c" sid="EXO 18"/>
  <para style="s1">ዮቶር ሙሰ ፆሞሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1"/>ምድያመ ቢታ ካህነይ፥ ሙሰ ቦሎይ ዮቶር፥ ጎዳይ ሙሰስነ ባ አሳ እስራኤለታስ ኦዳባነ ኤንታና ግብፀፈ ከስዳባ ስእስ።<verse eid="EXO 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 18:2"/>ሄ ዎደ ሙሰ ቦሎይ ዮቶር፥ እያ ማታን ሙሰይ አግድ ብዳ እያ ማችዉ ስፖሮነ፥ <verse eid="EXO 18:2"/><verse number="3" style="v" sid="EXO 18:3"/>እ ናምኡ ናይታ ኤክድ ይስ። ሙሰይ፥ “ታኒ አላጋ ቢታን በተ አስ ግዳስ” ግድ ባይራ ናኣ ገርሳማ ግድ ሱንስ። <verse eid="EXO 18:3"/><verse number="4" style="v" sid="EXO 18:4"/>ካሉዋ ቃስ፥ “ታ አዋ ፆሳይ፥ ታና ግብፀ ካዉዋ ማሻፈ አሽስ” ግድ አላዛራ ግድ ሱንስ።<verse eid="EXO 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 18:5"/>ሙሰ ቦሎይ ዮቶር፥ እያ ማችዉነ እ አደ ናይታ ባራ ኤክድ፥ መላ ቢታን፥ ፆሳ ዙማ ማታን ደእያ ሙሰኮ ይስ። <verse eid="EXO 18:5"/><verse number="6" style="v" sid="EXO 18:6"/>እ ባንታ ዩሳ ኤርሳናዉ ሙሰኮ ኪትስ።<verse eid="EXO 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 18:7"/>ሄሳ ግሾ፥ ሙሰይ ባ ቦሉዋ ሞካናዉ ከይድ፥ እያ ዝግ ሳሮድ እያ ዬርስ። ኤንቲ እሶይ እሱዋ ሳሮ ስሚድ ሙሰ ዱንካንያ ግዶ ገልዶሶና። <verse eid="EXO 18:7"/><verse number="8" style="v" sid="EXO 18:8"/>ጎዳይ እስራኤለታ አሻናዉ ግብፀ አሳ ቦላነ ኤንታ ካዉዋ ቦላ ኦዳባ ኡባነ ኦገን ኤንታ ጋክዳ መቱዋ ኡባን ጎዳይ ዋት ማድዳኮ ሙሰይ ባ ቦሉዋስ ኦድስ።<verse eid="EXO 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 18:9"/>ዮቶር ጎዳይ እስራኤለ አሳ ግብፀታ ኩሸፐ አሻናዉ ኦዳ ሎኦ ኦሶታባ ስእድ ኡፋይትስ። <verse eid="EXO 18:9"/><verse number="10" style="v" sid="EXO 18:10"/>እ፥ “ህንተና ግብፀታፐ ኤንታ ካዉዋ ኩሽያፐ አሽድ፥ ግብፀ አይለተፈ ከስዳ ጎዳይ፥ እ ጋላተቶ። <verse eid="EXO 18:10"/><verse number="11" style="v" sid="EXO 18:11"/>ኦቶሮን ኤንታ ቦላ ኢታባ ኦዳ ግብፀታፐ እስራኤለታ አሻናዉ ሄሳ ኦዳ ግሾ፥ ጎዳይ ፆሳታ ኡባፈ ግታ ግደይሳ ታኒ ሀእ ኤራስ” ያግስ። <verse eid="EXO 18:11"/><verse number="12" style="v" sid="EXO 18:12"/>ሄሳፈ ጉየ ዮቶር፥ ሙሰ ቦሎይ፥ ፁሳ ያርሾነ ሀራ ያርሾ ፆሳስ ያርሽስ። አሮንነ እስራኤለ ጭማት ኡባይ ፆሳ ስንን እያራ ጌሻ ካ ማናዉ ይዶሶና።<verse eid="EXO 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13"/>ዎንተ ጋላስ ሙሰይ አሳስ ፕርዳናዉ ኡትስ። አሳይ ሙሰ ዩሹዋን ዎንታፈ ኦማርስ ጋካናዉ ኤቅድ ደኤስ። <verse eid="EXO 18:13"/><verse number="14" style="v" sid="EXO 18:14"/>ሙሰ ቦሎይ ሙሰይ አሳስ ኦይሳ ኡባ በእድ፥ “ኔኒ ነ ፃላላ ሀይሳ አይስ ኦይ? አሳይ ዎንታፈ ኦማርስ ጋካናዉ ነ ዩሹዋን ኤሳዳ አይስ ነርካ ኦይ?” ያግስ።<verse eid="EXO 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 18:15"/>ሙሰይ ባ ቦሉዋኮ፥ “አሳይ ፆሳ ሸንያ ኦይቻናዉ ኮይድ ታኮ ይያ ግሾሳ። <verse eid="EXO 18:15"/><verse number="16" style="v" sid="EXO 18:16"/>ኤንታ ግዶን ኦድ ደእኮ ታኮ ዮሶና። ታ ኤንታ ግዶን ባልነ ቱም ኦነኮ ሻካይስ፤ ፆሳ ኪታነ ህግያ ኤንታዉ ኦዳይስ” ያግስ።<verse eid="EXO 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 18:17"/>ሙሰ ቦሎይ፥ “ሀይስ ነ ኦይስ ሎኦ ግደና። <verse eid="EXO 18:17"/><verse number="18" style="v" sid="EXO 18:18"/>ነካ ኔኮ ይያ አሳ ኡባይ ዳቡረታ። ሀ ኦሶይ እስ አሳፐ ዳሮ ግድያ ግሾ፥ ኔኒ ነርካ ኦናዉ ዳንዳአካ። <verse eid="EXO 18:18"/><verse number="19" style="v" sid="EXO 18:19"/>ሀእ ታኒ ነና ዞረይሳ ስአ፤ ፆሳይ ኔራ ግዳና። ኔኒ ሀ አሳ በሳን ግዳዳ ኤንታባ ፆሳስ ኦዳ። <verse eid="EXO 18:19"/><verse number="20" style="v" sid="EXO 18:20"/>ፆሳ ኪታነ ህግያ ኤንታ ታማርሳ። ኤንቲ ዋን ዳነኮነ አይ ኦነኮ ኤንታ በሳ። <verse eid="EXO 18:20"/><verse number="21" style="v" sid="EXO 18:21"/>ቃስ አሳ ግዶን ኦዳ ሻክድ ኤርያ አሳታ፥ ፆሳ ያየይሳታ፥ አማንይሳታነ ዎፈ ኤኮናይሳት ዶራ። ኤንታና አሳ ቦላ ሻላቃታ፥ ማቶ ሀላቃታ፥ ሀምሳላቃታነ አስራላቃታ ኦዳ ሹማ። <verse eid="EXO 18:21"/><verse number="22" style="v" sid="EXO 18:22"/>ኤንቲ ኡባ ዎደ ካዉሻ ኦዳታ ባንታዉ ፕርዶ፥ ሽን ዴፆ ኦዳታ ኔኮ ኤሆ። ሄሳዳ ነ ኦኮ ቶሆይ ነዉ ካዉያና። <verse eid="EXO 18:22"/><verse number="23" style="v" sid="EXO 18:23"/>ነ ኦና መላ ፆሲ ኮየይ ሄሳ። ቃስ ነ ዳቡራካ ሀ አሳ ኡባይ ባ አላለይ ፖለትን ባ ሶ ባ ሶ ስማና” ያግስ።<verse eid="EXO 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24"/>ሙሰይ ዮቶራ ዞርያ ስእስ፤ እ ግዳባ ኡባ ኦስ። <verse eid="EXO 18:24"/><verse number="25" style="v" sid="EXO 18:25"/>ሙሰይ እስራኤለታ ግዶፈ ኦዳ ሻክ ኤርያ አሳታ ዶርስ። ኤንታና አሳ ቦላ ሻላቃታ፥ ማቶ ሀላቃታ፥ ሀምሳላቃታነ አስራላቃታ ኦድ ሹምስ። <verse eid="EXO 18:25"/><verse number="26" style="v" sid="EXO 18:26"/>ሹማት ካዉሻ ኦዳታ ባንታዉ ፕርድዶሶና፥ ሽን ዴፆ ኦዳታ ሙሰኮ ኤሆሶና።<verse eid="EXO 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 18:27"/>ሄሳፈ ጉየ ሙሰይ ባ ቦሉዋ ሞይዝን፥ እ ባ ቢታ ስምስ።<verse eid="EXO 18:27"/></para>
  <chapter eid="EXO 18"/>
  <chapter number="19" style="c" sid="EXO 19"/>
  <para style="s1">ጎዳይ ሲና ዙማ ቦላ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1"/>እስራኤለ አሳይ ግብፀፈ ከይዳ ሄን አጌናስ ኮይሮ ጋላሳን ሲና መላ ቢታ ጋክዶሶና። <verse eid="EXO 19:1"/><verse number="2" style="v" sid="EXO 19:2"/>ኤንቲ ራፍድማፐ ደንድድ ብድ፥ ሲና ዙማ ስንን ደእያ መላ ቢታን ኡትዶሶና።<verse eid="EXO 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 19:3"/>ሙሰይ ፆሳራ ጋሄታናዉ ዙማ ቦላ ከይስ። ጎዳይ ዙማ ሁጰፐ እያ ፄግድ፥ “ያይቆባ ሼሽ ግድዳ እስራኤለታስ ሀይሳዳ ያጋ፤ <verse eid="EXO 19:3"/><verse number="4" style="v" sid="EXO 19:4"/>‘ታኒ ግብፀታ ቦላ ኦዳባነ አርጋን ባ ናአ ባ ቀፍያን ቶከይስዳ ታ ህንተና ዋታ ቶካዳ ታኮ ኤህዳኮ ህንተ ህንተ ሁጰን በእደታ። <verse eid="EXO 19:4"/><verse number="5" style="v" sid="EXO 19:5"/>ሀእ ህንተ ታዉ ኪተትኮነ ታ ጫቁዋ ናግኮ፥ ቢታ ኩመይ ታባ ግድኮካ ህንተ ታዉ ዶረትዳ ደረ ግዳና። <verse eid="EXO 19:5"/><verse number="6" style="v" sid="EXO 19:6"/>ህንተ ታዉ ጌሻ ደረ ግዳና፤ ህንተ ካዎተን ካህነ ግድድ ታና ሀጋዛና።’ ኔኒ እስራኤለታስ ኦዳና ቃላይ ሀይሳ” ያግስ።<verse eid="EXO 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 19:7"/>ሙሰይ ጉየ ብድ፥ ዙማኮ ጭማታ ፄግ ሺሽድ፥ ጎዳይ ኦድዳ ቃላ ኡባ ኤንታዉ ኦድስ። <verse eid="EXO 19:7"/><verse number="8" style="v" sid="EXO 19:8"/>ኤንቲ፥ “ጎዳይ ግዳባ ኡባ ኑኒ ኦና” ያግዶሶና። ሙሰይ ኤንቲ ግዳይሳ ጎዳስ ኦድስ።<verse eid="EXO 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 19:9"/>ጎዳይ ሙሰኮ “ታኒ ኔራ ሃሳይሽን አሳይ ስአናዳነ ኤንቲ ነና ኡባ ዎደ አማናናዳ ታኒ ሙምዳ ሻራራ ኔኮ ያና” ያግስ። ሄሳፈ ጉየ ሙሰይ አሳይ ግዳይሳ ጎዳስ ኦድስ።<verse eid="EXO 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 19:10"/>ጎዳይ ሙሰኮ “ኔኒ አሳኮ ባዳ ሀችነ ዎንቶ ታራ ጋሄታናዉ ባንታና ጌሻና መላ ኤንታዉ ኦዳ። ኤንቲ ባንታ ማኡዋ ሜጭድ፥ <verse eid="EXO 19:10"/><verse number="11" style="v" sid="EXO 19:11"/>ሄን ጋላሳስ ጊገቶ። ሄ ጋላስ አሳ ኡባይ ታና በእሽን ታኒ ሲና ዙማ ቦላ ዎና። <verse eid="EXO 19:11"/><verse number="12" style="v" sid="EXO 19:12"/>ኔኒ ሀ ዙማ ዩሹዋን ዛዋ ዎ። አሳይ ዙማ ከዮና ቦላ መላ ዎይኮ ዙማ ፃጱዋ ቦቾና መላ ኤንታዉ ኦዳ። ዙማ ቦችዳ ኦንካ ሀይቃና። <verse eid="EXO 19:12"/><verse number="13" style="v" sid="EXO 19:13"/>ሄ ኡራይ ሹቻን ጫደትድ ዎይኮ ዶንገን ዱከትድ ሀይቆ፤ እያ ኩሸን ኦንካ ቦቾፎ። መሄይ ዎይኮ አስ ሄሳዳ ሀይቆ። ሞይዘይ ፑነትያ ዎደ ኤንቲ ዙማ ቦላ ከያናዉ ዳንዳኦሶና” ያግስ።<verse eid="EXO 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14"/>ሙሰይ ዙማ ቦላፈ ዎድ፥ አሳይ ፆሳ ጎይናናዉ ባንታና ጊግሳና መላ ኦድስ። ኤንትካ ባንታ ማኡዋ ሜጭዶሶና። <verse eid="EXO 19:14"/><verse number="15" style="v" sid="EXO 19:15"/>ሙሰይ አሳኮ፥ “ሄን ጋላሳስ ጊገትተ፤ ህንተ ማቸታራ አቆፕተ” ያግስ።<verse eid="EXO 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16"/>ሄን ጋላስ ዎንታ ጉራ ደሾይ ደችስ። ዎልአንነ ሳካና ሻር ዙማ ማእድ በንትስ። ዎልቃማ ሞይዘ ዋሶይ ስኤትስ። አሳይ ዱንካንዳ በሳ ኡባን ያሻን ኮኮርዶሶና። <verse eid="EXO 19:16"/><verse number="17" style="v" sid="EXO 19:17"/>ሄሳፈ ጉየ፥ ሙሰይ አሳ ፆሳራ ጋናዉ ኤንታና ዱንካንያፐ ከስድ ኤፍስ፤ ኤንቲ ዙማ ፃጶን ኤቅዶሶና። <verse eid="EXO 19:17"/><verse number="18" style="v" sid="EXO 19:18"/>ጎዳይ ሲና ዙማ ቦላ ታማ ላጮራ ዎዳ ግሾ ሲና ደረይ ጩያን ካመትስ። ግታ ጮጨፐ ጩይ ከየይሳዳ እያፐ ጩይያ ዙለይ ሱረ ከይስ። አሳ ኡባይ ዳሮ ኮኮርዶሶና። <verse eid="EXO 19:18"/><verse number="19" style="v" sid="EXO 19:19"/>ሞይዝያ ዋሶይ ዳር ዳር ብዳ ዎደ ሙሰይ ኦድን፥ ፆሳይ ደሾን እያዉ ዛርስ። <verse eid="EXO 19:19"/><verse number="20" style="v" sid="EXO 19:20"/>ጎዳይ ሲና ዙማ ሁጰ ቦላ ዎድ፥ ሙሰ ፑደ ዙማ ቦላ ፄግስ። ሙሰይ ዙማ ቦላ ከይስ። <verse eid="EXO 19:20"/><verse number="21" style="v" sid="EXO 19:21"/>ጎዳይ እያኮ፥ “ኔኒ ዱገ ባዳ አሳይ ታና በአና ግድ፥ ዛዋ አና መላነ ኤንታፈ ዳሮይ ሀይቆና መላ ኤንታዉ ኦዳ። <verse eid="EXO 19:21"/><verse number="22" style="v" sid="EXO 19:22"/>ሀር አቶ ጎዳ ማት ሺቅያ ካህነትካ ባንታና ጌሾ። ኤንቲ ሄሳ ኦና እኮ ታ ኤንታ ሀንቃና” ያግስ።<verse eid="EXO 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23"/>ሙሰይ ጎዳኮ፥ “ኔኒ ዙማ ዱማይዳ ግሾነ ዛዋ እምዳ ግሾ አሳይ ዙማ ሁጰ ከያናዉ ዳንዳኦኮና” ያግስ።<verse eid="EXO 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 19:24"/>ጎዳይ እያኮ፥ “ኔኒ ዱገ ባዳ አሮና ኔራ ኤካዳ ያ። ካህነትነ አሳይ ዛዋ ካንድ ታኮ ይሸ ዮና መላ ኤንታዉ ኦዳ” ያግስ። <verse eid="EXO 19:24"/><verse number="25" style="v" sid="EXO 19:25"/>ሄሳ ግሾ ሙሰይ አሳኮ ዎድ ጎዳይ ግዳይሳ ኤንታዉ ኦድስ።<verse eid="EXO 19:25"/></para>
  <chapter eid="EXO 19"/>
  <chapter number="20" style="c" sid="EXO 20"/>
  <para style="s1">ታሙ ኪታታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1"/>ፆሳይ እስራኤለ አሳኮ ሀይሳዳ ያግስ፤ <verse eid="EXO 20:1"/><verse number="2" style="v" sid="EXO 20:2"/>“ነና ግብፀፈ አይለተፈ ከስዳ ጎዳይ ነ ፆሳይ ታና።<verse eid="EXO 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 20:3"/>“ታፐ አትሽን፥ ሀራ ፆሰ ጎይኖፋ።<verse eid="EXO 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 20:4"/>“ቦላ ሳሉዋን ደእያባ፥ ዎይኮ ጋርሳ ሳአን ደእያባ፥ ዎይኮ ሳአፐ ጋርሳን ሃ ግዶን ደእያባ አይባካ ነዉ ጎይንያ ኤቃ ዳንሳዳ ኦፋ። <verse eid="EXO 20:4"/><verse number="5" style="v" sid="EXO 20:5"/>ኤንታዉ ሆኮፋ ዎይኮ ኤንታ ጎይኖፋ። አይስ ጊኮ፥ ታኒ፥ ጎዳይ ነ ፆሳይ፥ ታ ቦንቹዋ ሀራ ፆሳታራ ኮፆና ፆሰ። ታና እፅያ አዋታ ናጋራ ግሾ ናይታ ሄን ዎይኮ ኦይዳን የለተ ጋካናዉ ሀንቃና። <verse eid="EXO 20:5"/><verse number="6" style="v" sid="EXO 20:6"/>ሽን ታና ሲቀይሳታነ ታ ኪታ ናገይሳታ ሼሻ ሙኩሉ የለተ ጋካናዉ ኬሀና።<verse eid="EXO 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 20:7"/>“ፆሳ ነ ጎዳ ሱን ሀዳን ደንፋ። ጎዳይ ባ ሱን ሀዳን ደንይሳታ ሴሮና አገና።<verse eid="EXO 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 20:8"/>“ሳምባታ ጌሻ ጋላስ ኦዳ ናጋ። <verse eid="EXO 20:8"/><verse number="9" style="v" sid="EXO 20:9"/>ኔኒ ኦሶ ኦናዉ በሲያ ኡሱፑን ጋላሳት ደኦሶና። <verse eid="EXO 20:9"/><verse number="10" style="v" sid="EXO 20:10"/>ሽን ላፑን ጋላሳይ ኔኒ ጎዳ ቦንችያ ሸምፖ ጋላስ። ሄ ጋላሳን አይባ ኦሶካ ኦፋ። ኔኒ፥ ዎይኮ ነ ናይት፥ ዎይኮ ነ አይለት፥ ዎይኮ ነ መሄይ፥ ዎይኮ ነ ቢታን ደእያ አሳ ጋደ አሳት ሄ ጋላሳን ኦሶ ኦፍተ። <verse eid="EXO 20:10"/><verse number="11" style="v" sid="EXO 20:11"/>ኡሱፑን ጋላሳ ግዶን ጎዳይ ሳሎታ፥ ሳኣ፥ አባነ ኤንታ ግዶን ደእያ ኡባ መስ፥ ሽን ላፑን ጋላሳን ሸምፕስ። ሄሳ ግሾ ጎዳይ ሳምባታ ጋላሳ አንጅስነ ዱማይስ።<verse eid="EXO 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 20:12"/>“ጎዳይ ነ ፆሳይ ነዉ እምያ ቢታን ነ ላይይ አዱቃና መላ ነ አዋነ ነ አይዉ ቦንቻ።<verse eid="EXO 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 20:13"/>“አሳ ዎፓ።<verse eid="EXO 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 20:14"/>“ላሞፋ።<verse eid="EXO 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 20:15"/>“ካይሶቶፓ።<verse eid="EXO 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 20:16"/>“ነ ላግያ ቦላ ዎርዶ ማርካቶፋ።<verse eid="EXO 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 20:17"/>“ነ ላግያ ኬ አሞቶፋ። ነ ላግያ ማችዉ፥ ዎይኮ እያ አይለታ፥ ዎይኮ እያ መህያ፥ ዎይኮ እያ ሀርያ፥ ዎይኮ እያዉ ደእያባ አይባካ አሞቶፋ” ያግስ።<verse eid="EXO 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18"/>አሳ ኡባይ ደሾይ ደቸይሳነ ሞይዘይ ፑነተይሳ ስእድ፥ ዎልአንይ ዎልአመይሳነ ደረይ ጩየይሳ በእድ ያሻን ኮኮርሸ ሃሆን ኤቅዶሶና። <verse eid="EXO 20:18"/><verse number="19" style="v" sid="EXO 20:19"/>ኤንቲ ሙሰኮ፥ “ኔኒ ኑስ ኦዳ፤ ኑኒ ስአና። ሽን ኑኒ ሀይቆና መላ ፆሳይ ኑስ ኦዶፖ” ያግዶሶና። <verse eid="EXO 20:19"/><verse number="20" style="v" sid="EXO 20:20"/>ሙሰይ አሳኮ፥ “ያዮፍተ፤ ፆሳይ ህንተና ፓጫናዉነ ህንተ እያዉ ኪተትድ ናጋራ ኦና መላ እ ይስ” ያግስ። <verse eid="EXO 20:20"/><verse number="21" style="v" sid="EXO 20:21"/>አሳይ ባንታ ደእያሱዋን ሃክድ ኤቅዳሽን፥ ፆሳይ ደእያሱዋ ሙምዳ ሻራኮ ሙሰይ ሺቅስ።<verse eid="EXO 20:21"/></para>
  <para style="s1">ያርሾ በሳታነ ኤቃታ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22"/>ሄሳፈ ጉየ፥ ጎዳይ ሙሰኮ “እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ ‘ሳሎፐ ታኒ ህንተዉ ኦድሽን ህንተ ታና ህንተ ሁጰን በእደታ። <verse eid="EXO 20:22"/><verse number="23" style="v" sid="EXO 20:23"/>ያንያ ግሾ፥ ብራ ኤቃ ዎይኮ ዎርቃ ኤቃ ህንተዉ ኦድ ታ ቦላ ጉጅድ ጎይኖፍተ። <verse eid="EXO 20:23"/><verse number="24" style="v" sid="EXO 20:24"/>ነን ታዉ ያርሾ በሲ ኡርቃፈ ጊግሳ። ነ ዶርሳታፐነ ነ ቦራታፐ ኤካዳ ፁሳ ያርሾነ እስፈተ ያርሾ እያ ቦላ ያርሻ። ህንተ ታና ጎይናና መላ ታኒ ዶርዳ በሳ ኡባን ህንተኮ ያዳ ህንተና አንጃና። <verse eid="EXO 20:24"/><verse number="25" style="v" sid="EXO 20:25"/>ህንተ ታዉ ያርሾ በሲ ሹቻፈ ኬፅያባ ግድኮ ማሰትዳ ሹቻፈ ኬፆፋ። ኔኒ ማስያ ሚሸን እያ ቦችኮ ቱንሳሳ። <verse eid="EXO 20:25"/><verse number="26" style="v" sid="EXO 20:26"/>ህንተ ከይሸ ካሎቶና መላ ታዉ ያርሾ በሲ ኮዶራ ከይያ በሳን ኬፆፋ’ ” ያግስ።<verse eid="EXO 20:26"/></para>
  <chapter eid="EXO 20"/>
  <chapter number="21" style="c" sid="EXO 21"/>
  <para style="s1">አይለ አይሶ ዎጋ</para>
  <para style="r">(<ref loc="NUM 15:12-18">ታይቦ 15:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1"/>ጎዳይ ሙሰ ባጋራ ባ ደርያስ እምዳ ዎጋይ ሀይሳ፤ <verse eid="EXO 21:1"/><verse number="2" style="v" sid="EXO 21:2"/>“ነ እብራወ አይለ ሻምኮ፥ እ ነዉ ኡሱፑን ላይ ኦ፥ ሽን ላፑን ላይን አይኮካ ቃንፆና፥ አይለተፈ ጮ የደቶ። <verse eid="EXO 21:2"/><verse number="3" style="v" sid="EXO 21:3"/>እ ማቾ ኤኮና ሻመትዳባ ግድኮ፥ ባርካ የደቶ። እ ማችድ፥ ሻመትዳባ ግድኮ፥ እያ ማችያካ እያራ የደቶ። <verse eid="EXO 21:3"/><verse number="4" style="v" sid="EXO 21:4"/>እያ ጎዳይ እያዉ ማቾ እምዳባ ግድኮነ ማችያ እያዉ አደ ናይታ ዎይኮ ማጫ ናይታ የልዳባ ግድኮ፥ እያ ማችያነ እ ናይት እያ ጎዳባ ግዶ፤ አደይ ባርካ የደቶ። <verse eid="EXO 21:4"/><verse number="5" style="v" sid="EXO 21:5"/>ሽን አይለይ፥ ‘ታኒ ታ ጎዳ፥ ታ ማችዉነ ታ ናይታ ዶሳይስ’ ግድ አይለተፈ ከያናዉ ኮዮና እፅኮ፥ <verse eid="EXO 21:5"/><verse number="6" style="v" sid="EXO 21:6"/>እያ ጎዳይ፥ ጎዳ ስን እያ አ። ያትድ፥ ፐንገ ዎይኮ ፐንገ ዝዝግያ ማታን እያ ኤስድ፥ እያ ሀይ ጎን ሉኮ። ሄሳፈ ጉየ፥ እ ባ ደኦ ላይ ኡባን እያዉ አይለ ግዶ።<verse eid="EXO 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7"/>“እስ አስ ባ ማጫ ናእዉ አይለተስ ባይዝኮ፥ አደ አይለታ አይለተፈ ከዮፖ። <verse eid="EXO 21:7"/><verse number="8" style="v" sid="EXO 21:8"/>እዮ ሻምድ ማቻናዉ ኤፍዳ ጎዳይ እዮ ዶሶና እፅኮ፥ እ ጎዳይ እዮ ደርያን ዎዝሶ። እ ጎዳይ እ ቦላ ኢታባ ኦዳ ግሾ፥ እዮ አላጋስ ባይዛናዉ ዳንዳኤና። <verse eid="EXO 21:8"/><verse number="9" style="v" sid="EXO 21:9"/>እ እዮ ባ ናኣስ እማናዉ ኮይኮ፥ ባ ማጫ ናአ ኦድ ኤኮ። <verse eid="EXO 21:9"/><verse number="10" style="v" sid="EXO 21:10"/>እ ሀራ ማቾ እ ቦላ ኤክኮ፥ ኮይሮ ማቼስ ካ፥ ማኦነ እንዳስ በሲያ ዎጋ እዉ ፓጭሶፖ። <verse eid="EXO 21:10"/><verse number="11" style="v" sid="EXO 21:11"/>እ ሀ ሄባታ እዉ ኦና እፅኮ፥ አይብ ሚሸካ ቃንፆና አይለተፈ ከያዳ ቦ።”<verse eid="EXO 21:11"/></para>
  <para style="s1">ኢታ አስ ሴሮ ዎጋ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12"/>“አሰ ሾጭድ ዎያ ኦንካ ሀይቃናዉ በሴስ። <verse eid="EXO 21:12"/><verse number="13" style="v" sid="EXO 21:13"/>እ ዎናዉ ቆፖና እያፐ ሀይቅያባ ግድኮ፥ እ ባቃትድ አታና በሲ ታኒ እያዉ ጊግሳና። <verse eid="EXO 21:13"/><verse number="14" style="v" sid="EXO 21:14"/>ሽን አስ ቆፕድ ሀራ አስ ዎኮ፥ ሄ ኡራይ ታ ያርሾ በሲ ቢኮ ያፐ ድጋዳ ሀራ በሳን ዎ።<verse eid="EXO 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 21:15"/>“ባ አዋ ዎይኮ ባ አይዉ ደችያ ኦንካ ሀይቆ።<verse eid="EXO 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 21:16"/>“አሰ ባይዛናዉ ዎይኮ ሃራናዉ ዎልቃን ኦይክያ አስ ሀይቃናዉ በሴስ።<verse eid="EXO 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 21:17"/>“ባ አዋ ዎይኮ ባ አይዉ ጫየይ ሀይቆ።<verse eid="EXO 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 21:18"/>“ናምኡ አሳት ኦየትድ፥ እሶይ እሱዋ ሹቻን ጫድድ ቆእኮ፥ ዎይኮ ዡልትኮ፥ ሄ ደሸትዳይስ ሀይቆና አትድ ሀርግድ ሂፃን ፔእኮ፥ <verse eid="EXO 21:18"/><verse number="19" style="v" sid="EXO 21:19"/>ደንድድ ጉፈትድ ካረ ሄራን ሄመትኮ፥ ሄ ደችዳይስ ሀይቆፐ አቴስ። ግድኮካ እ እያ ኦሶፐ አሽዳ ግሾ፥ አጫናዉነ ፓፃና ጋካናዉ ሀርግሳናዉ ኮሼስ።<verse eid="EXO 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 21:20"/>“እስ አስ ባ አደ አይልያ ዎይኮ ማጫ አይልዉ ፃምአን ሾጭድ ዎኮ ሴረታናዉ በሴስ። <verse eid="EXO 21:20"/><verse number="21" style="v" sid="EXO 21:21"/>ሽን ሄ አይለይ እስ ዎይኮ ናምኡ ጋላሳ ግዶን ሀይቆና እፅኮ፥ እያ ጎዳይ ሴረቶፎ። ሄ አይለይ እያ ሻሎ ግድያ ግሾ እያ ሀይቆይ ባዉ ሴራ።<verse eid="EXO 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 21:22"/>“ናምኡ አሳት እሶይ እሱዋራ ዋትድ ቃንፃትዳ ማጫስዉ ደችድ፥ እያ ቦሸታና መላ ኦኮ፥ ሀራ ኢታ ቆሆ ጋና እፅኮ፥ ሄ ደችዳ ኡራይ፥ ሄ ማቸ አዝናይ ኦይችያ አጫ ዳይናት ፕርድኮ ጭጎ። <verse eid="EXO 21:22"/><verse number="23" style="v" sid="EXO 21:23"/>ሽን ሄ ማጫሰ ደሸይ ዳርኮ፥ ሸምፖ ግሾ ሸምፖ፥ <verse eid="EXO 21:23"/><verse number="24" style="v" sid="EXO 21:24"/>አይፈ ግሾ አይፈ፥ አቻ ግሾ አቸ፥ ኩሸ ግሾ ኩሸ፥ ቶሆ ግሾ ቶሆ፥ <verse eid="EXO 21:24"/><verse number="25" style="v" sid="EXO 21:25"/>ፁሳ ግሾ ፁስ፥ ማዱን ግሾ ማዱን፥ ቆኦ ግሾ ቆኦ ኤካናዉ ኮሼስ።<verse eid="EXO 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 21:26"/>“እስ አስ ባ አደ አይልያስ ዎይኮ ማጫ አይሌስ አይፈ ባቅድ ቶይስኮ፥ ሄ አይፍያ ግሾ አይለተፈ ከስ የዶ። <verse eid="EXO 21:26"/><verse number="27" style="v" sid="EXO 21:27"/>ሄሳዳካ፥ ባ አይልያ አቸ ዎይኮ ባ አይለ አቸ መንኮ፥ ሄ አቻ ግሾ አይለተፈ ከስ የዶ።<verse eid="EXO 21:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28"/>“ቦር አሰ ቃይጭድ ዎኮ፥ ሄ ቦራይ ሹቻን ጫደት ሀይቆ። እያ አሾይ ሜተቶፎ፥ ሽን ቦራ ጎዳይ ሴረቶፎ። <verse eid="EXO 21:28"/><verse number="29" style="v" sid="EXO 21:29"/>ሽን ቦራይ ካሰካ ቃይጭያባ ግድኮነ ኮይሮትድ ቦራ ጎዳስ ኦደትን፥ እ ቃቾና እፅዳባ ግድኮ፥ ሄ ቦራይ አሰ ዎኮ፥ ቦራይነ ቦራ ጎዳይ እስፈ ሹቻን ጫደትድ ሀይቆ። <verse eid="EXO 21:29"/><verse number="30" style="v" sid="EXO 21:30"/>ሽን ቦራ ጎዳይ አጫ ቃንፃና መላ ኦይሸትኮ፥ ኤንቲ ኦይችዳባ ቃንፅድ ባ ሸምፑዋ ዎዞ። <verse eid="EXO 21:30"/><verse number="31" style="v" sid="EXO 21:31"/>ቦራይ አደ ናአ ዎይኮ ማጫ ናአ ቃይጭድ ዎኮ ፕርዳይ እያ መላ ግዶ። <verse eid="EXO 21:31"/><verse number="32" style="v" sid="EXO 21:32"/>ቦራይ አደ አይለ ዎይኮ ማጫ አይለ ቃይጭድ ዎኮ፥ ቦራ ጎዳይ አይልያ ጎዳስ ሀስታሙ ብራ ሳንትመ ቃንፆ፤ ቦራይ ሹቻን ጫደትድ ሀይቆ።<verse eid="EXO 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 21:33"/>“እስ አስ ኦላ ቦክድ ካሞና አግኮ ዎይኮ ካማ ደንን ቦር ዎይኮ ሀረይ ሄ ኦላን ዉልኮ፥ <verse eid="EXO 21:33"/><verse number="34" style="v" sid="EXO 21:34"/>ሄ ኦላ ጎዳይ መህያ ጋትያ ቃንፆ። እ እያ ጎዳስ ጋትያ ቃንፅድ፥ ሀይቅዳ መህያ ባዉ ኤኮ።<verse eid="EXO 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 21:35"/>“እስ አሳ ቦር ሀራ አሳ ቦር ጫድድ ዎኮ፥ ፓፃ ቦራ ባይዝድ፥ እያ ሚሽያነ ሀይቅዳ ቦራ አሹዋ ናምአይ ሻክ ኤኮ። <verse eid="EXO 21:35"/><verse number="36" style="v" sid="EXO 21:36"/>ሽን ሄ ቦራይ ካሰካ ቃይጭያባ ግደይሳ ኤርሸ፥ እያ ጎዳይ ቃቾና አግዳባ ግድኮ፥ ሄ ኡራይ እያዉ ቦር ቃንፆ። ያትድ፥ ሄ ሀይቅዳይሳ ባዉ ኤኮ።”<verse eid="EXO 21:36"/></para>
  <chapter eid="EXO 21"/>
  <chapter number="22" style="c" sid="EXO 22"/>
  <para style="s1">ሻሎ ናጎ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1"/>“እስ አስ ቦር ዎይኮ ዶርሰ ካይስድ ሹክኮ፥ ዎይኮ ባይዝኮ፥ ቦራ ግሾ እቻሹ ቦራታ፥ ዶርሳ ግሾ ኦይዱ ዶርሳታ ጭጎ።<verse eid="EXO 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 22:2"/>“ካይሶይ ኬ ቦክሸ ኦይከትድ ሾጨትድ ሀይቅኮ፥ ሾጭ ዎዳይስ ኦይሸተና። <verse eid="EXO 22:2"/><verse number="3" style="v" sid="EXO 22:3"/>ሽን ሄስ ሀንዳይ ጋላስ ግድኮ፥ እ ሄ ጉስዳ ሱ አጩዋን ኦይሸቴስ። ካይሶይ ባ ካይስዳይሳ ዛሮ፥ ሽን እያዉ ዛራናባይ ይኮ ባ ሁጰን አይለተስ ባይዘቶ። <verse eid="EXO 22:3"/><verse number="4" style="v" sid="EXO 22:4"/>እ ካይስዳ መሄይ ፓፃ ደእሸ እያ ኩሸን በንትኮ፥ ቦር ዎይኮ ሀረ ዎይኮ ዶርሰ ግድኮ፥ እ ካይስዳይሳስ ናምኡ ኩሸ ጭጎ።<verse eid="EXO 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 22:5"/>“እስ አስ ባ መህያ ደንባን ዎይኮ ዎይነ ጋደን ሄምሽን፥ መሄይ ሀራ አሳ ካ ሚኮ፥ እ ባ ካፈ ዎይኮ ባ ዎይንያፐ ሎኡዋ አጫ ቃንፆ።<verse eid="EXO 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 22:6"/>“እስ አስ ባ ጋደን ታማ ፁግሽን ታማይ ቡርያ ካንድ ሀራ አሳ ጋደን ድጭያ ካነ ዶርያ ሚኮ፥ ታማ ኦይዳ ኡራይ አጮ ቃንፆ።<verse eid="EXO 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 22:7"/>“እስ አስ ብራ ዎይኮ ሀራ አልኦ ሚሸ ባ ሾሩዋስ ሀዳራ እምን፥ ሄ ሾሩዋ ሶፐ ካይሶይ ሄ ሚሽያ ኤክኮነ ሄ ካይሶይ ኦይከትኮ፥ ሄ ካይሶይ ሚሽያ ናምኡ ኩሸ ጭጎ። <verse eid="EXO 22:7"/><verse number="8" style="v" sid="EXO 22:8"/>ሽን ካይሶይ በንቶና እፅኮ፥ ኡራይ ፆሳ ስን ሺቅድ፥ ባ ሾሩዋ ሚሽያ፥ እ ኤኮናይሳ ኤርሳናዉ ጫቆ።<verse eid="EXO 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 22:9"/>“ናምኡ አሳት ቦራ ጋሶን ዎይኮ ሀረ ጋሶን ዎይኮ ዶርሳ ጋሶን ዎይኮ ማኦ ጋሶን ዎይኮ ሀራ ይዳባ ጋሶን ሞተትድ፥ ፆሳ ስን ሺቅኮ፥ ፆሳይ እያ ቦላ ፕርድዳይስ ናምኡ ኩሸ ጭጎ።<verse eid="EXO 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 22:10"/>“እስ አስ ሀረ ዎይኮ ቦር ዎይኮ ዶርሰ ዎይኮ ሀራ መሄ ሀዳራ እምዳሱዋን ሀይቅኮ ዎይኮ መእኮ ዎይኮ ኦንካ በኦና ካይሶተትኮ፥ <verse eid="EXO 22:10"/><verse number="11" style="v" sid="EXO 22:11"/>ሀዳራ ኤክዳይስ ባ ላግያ መህያ ካይሶቶናይሳ ጎዳ ስንን ጫቆ። ሄ መህያ ጎዳይ ጫቁዋ ኤኮ፤ መሄይ እያፐ ይዳ ኡራይ ጭጋናዉ ኮሸና። <verse eid="EXO 22:11"/><verse number="12" style="v" sid="EXO 22:12"/>ሽን መሄይ ካይሶተትዳባ ግድኮ፥ መህያ ጎዳስ ጭጎ። <verse eid="EXO 22:12"/><verse number="13" style="v" sid="EXO 22:13"/>ሄ መህያ ዶእ ምዳባ ግድኮ፥ ማርካ ግዳናዳ ጋዉፃ ኤሆ፤ ዶእ ምዳባ ግድኮ እያዉ ጭጎፎ።<verse eid="EXO 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 22:14"/>“አስ ባ ሾሩዋፐ መሄ ዎስ ኤክኮ እያ ጎዳይ ባይና በሳን ሄ መሄይ ደሸትኮ ዎይኮ ሀይቅኮ፥ ሄ መህያስ ጭጋ እሞ። <verse eid="EXO 22:14"/><verse number="15" style="v" sid="EXO 22:15"/>ሽን እያ ጎዳይ እያራ ደእሽን ሄስ ሀንዳባ ግድኮ አጫ ቃንፆፎ። ሀሸ ኤክዳባ ግድኮ፥ ሄ ሀሸ ሚሸይ አጮ ጋተ ግዶ።<verse eid="EXO 22:15"/></para>
  <para style="s1">ዱሳ ዎጋታ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16"/>“እስ አስ እስ ጌላእዉ ጭምድ፥ ኢራ ዝንኤትያባ ግድኮ፥ እዉ አጫ እምድ፥ ባዉ ማቾ ኦ። <verse eid="EXO 22:16"/><verse number="17" style="v" sid="EXO 22:17"/>እ አዋይ እዮ እያዉ እማናዉ ኮዮና እፅኮ፥ ጌላኦ ኤክያ ኡራይ አጫ እምያ ሚሸ መላ እ አዋስ እምድ አጮ።<verse eid="EXO 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 22:18"/>“ብታ ብትያ ማጫስ ሀይቆ።<note caller="-" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="DEU 18:10-11">ዛረ 18:10-11</ref>.</char></note><verse eid="EXO 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 22:19"/>“መሄራ ቱንያ ኦንካ ሀይቆ።<note caller="-" style="x"><char style="xo" closed="false">22:19 </char><char style="xt" closed="false"><ref loc="LEV 18:23">ሌወ 18:23</ref>፤ <ref loc="LEV 20:15">20:15</ref>.</char></note><verse eid="EXO 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 22:20"/>“ፆሳፈ ሀራ ጎዳታስ ያርሽያ ኦንካ ሀይቆ። <verse eid="EXO 22:20"/><verse number="21" style="v" sid="EXO 22:21"/>ህንተ ግብፀ ቢታን በተ አስ ግድድ፥ ደእዳ ግሾ፥ በተ አስ ቆሆፕተ ዎይኮ ኡንኤፍተ። <verse eid="EXO 22:21"/><verse number="22" style="v" sid="EXO 22:22"/>አምኤታነ ይኦታ ኡንኤፍተ። <verse eid="EXO 22:22"/><verse number="23" style="v" sid="EXO 22:23"/>ህንተ ኤንታ ኡንኤኮ፥ ኤንቲ ታኮ ዋሳና፤ <verse eid="EXO 22:23"/><verse number="24" style="v" sid="EXO 22:24"/>ታኒ ኤንታ ዋሱዋ ስአና። ሄ ዎደ ታ ህንተ ቦላ ሀንቀታዳ ህንተና ኦላን ዉርሳና። ህንተ ማቸት አምኦ፥ ህንተ ናይትካ አዉ ባይናይሳታ ግዳና።<verse eid="EXO 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 22:25"/>“ህንተ ግዶን ደእያ ማንቆ ግድዳ ታ አሳፐ ኦደስካ ሚሸ ታልእኮ፥ የሎን ታልእያ አሳዳ የሎ ኦይቾፍተ። <verse eid="EXO 22:25"/><verse number="26" style="v" sid="EXO 22:26"/>ኔኒ እስባ ግሾ፥ እያ ማኡዋ ኦይክዳ አስ ደእኮ፥ አው ዉሎና ደእሽን እያ ማኡዋ ዛራ። <verse eid="EXO 22:26"/><verse number="27" style="v" sid="EXO 22:27"/>እ ማእድ አቀይ እ ፃላላ። እ ሀራ አይ ማእድ አቃናዉ ዳንዳኢ? ታኒ ቃትያ ፆሲ ግድያ ግሾ፥ እ ታኮ ዋስያ ዎደ ስአና።<verse eid="EXO 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 22:28"/>“ፆሳ ቦላ<note caller="+" style="f"><char style="fr" closed="false">22:28 </char><char style="fq" closed="false">ፆሳ ቦላ: </char><char style="ft" closed="false">“ዳይናታ ቦላ”</char></note> ጫሻ ቃላ ሃሳዮፓ፥ ዎይኮ ነ ደርያ አይሰይሳ ባዶፋ። <verse eid="EXO 22:28"/><verse number="29" style="v" sid="EXO 22:29"/>ነ ካፈ፥ ነ ዎይነ ኡሻፈነ ነ ሻማሆ ዛይትያፐ ታዉ ያርሾ ያርሻ።</para>
  <para style="p" vid="EXO 22:29">“ባይራ ግድድ የለትዳ አደ ናኣ ታዉ እማ። <verse eid="EXO 22:29"/><verse number="30" style="v" sid="EXO 22:30"/>ነ ሚዛፐነ ነ ዶርሳፈ ባይራ የለትዳይሳ ታዉ እማ። ኤንቲ ላፑን ጋላስ ጋካናዉ፥ ባንታ አየታራ ጋምኦ፤ ሆስፑን ጋላሳን ኤንታ ታዉ እማ።<verse eid="EXO 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 22:31"/>“ህንተ ታዉ ጌሻ አስ ግዳናዉ ኮሼስ። ሄሳ ግሾ፥ ዶእ መንድ ዎዳ መሄ አሾ ሞፕተ፤ ሄሳ ካናስ የግተ።”<verse eid="EXO 22:31"/></para>
  <chapter eid="EXO 22"/>
  <chapter number="23" style="c" sid="EXO 23"/>
  <para style="s1">ሱረ ፕርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1"/>“ዎርዶ ኦዳ ጋሰፋ፤ ዎርዶ ማርካታዳ ባላ አስ ማዶፋ። <verse eid="EXO 23:1"/><verse number="2" style="v" sid="EXO 23:2"/>ኢታባ ኦናዉ ዳሮ አሳ ካሎፋ። ፕርዳ ዎብሳናዉ ዳሮ አሳራ እስፋዳ ማርካቶፋ። <verse eid="EXO 23:2"/><verse number="3" style="v" sid="EXO 23:3"/>ማንቆይ ፕርዳስ ሺቅያ ዎደ እያ ማንቆተ በአዳ ማዶፋ።<verse eid="EXO 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4"/>“ነ ሞርክያ ቦራይ ዎይኮ ሀረይ ይን ደምኮ፥ ዛራዳ እያዉ ኤፋ። <verse eid="EXO 23:4"/><verse number="5" style="v" sid="EXO 23:5"/>ነና እፅያ ኡራ ሀረይ ጫናራ ኩንድን በአዳ፥ ኡራ ማዳዳ ደንና አጋዳ አፋ።<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="DEU 22:1-4">ዛረ 22:1-4</ref>.</char></note><verse eid="EXO 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 23:6"/>“ፕርዳ ዳባባን ማንቆይ ፕርዳስ ሺቅያ ዎደ እያ ፕርዳ ዎቢሶፓ። <verse eid="EXO 23:6"/><verse number="7" style="v" sid="EXO 23:7"/>ኦናካ ማልተን ሞቶፓ፤ ፅሉዋ ዎፓ። ሄሳ መላባ ኦዳይሳ ታኒ ፕርዶና አግከ። <verse eid="EXO 23:7"/><verse number="8" style="v" sid="EXO 23:8"/>ዎፈ ኤኮፋ፤ ዎፈይ ሱረ ፄልያ አሳ አይፈ ቆቅሴስ፥ ፅሎታ ፕርዳ ምርቄስ።<verse eid="EXO 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 23:9"/>“በታንቹዋ ናቆፋ። ህንተ ግብፀ ቢታን በተ አስ ግድድ ደእዳ ግሾ፥ አሳ ጋደ አስ ግዶይ አይ መላ ስኤትያኮ ኤሬታ።<verse eid="EXO 23:9"/></para>
  <para style="s1">ላፑን ላይነ ላፑን ጋላስ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10"/>“ኔኒ ነ ጋድያ ኡሱፑን ላይ ጎያዳ ማ። <verse eid="EXO 23:10"/><verse number="11" style="v" sid="EXO 23:11"/>ላፑን ላይን ጋድያ ጎዮና ሻቻ፤ እያን ዶልድ ካፅያባ ሺሾፓ። ነ አሳ ግዶን ደእያ ማንቆት እያፐ ሞ፤ ቃስ ኤንታፈ አትዳይሳ ዶአት ሞ። ነ ዎይነ ጋድያነ ነ ሻማሆ ጋድያ ሄሳዳ ኦ።<verse eid="EXO 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12"/>“ኔኒ ኡሱፑን ጋላስ ኦሶ ኦ። ነ ቦራይነ ነ ሀረይ ሸምፓና መላነ ነ ሶን የለትዳ አይለይነ በተ አስ ሸምፓና መላ ላፑን ጋላሳን ኦሶ ኦፋ። <verse eid="EXO 23:12"/><verse number="13" style="v" sid="EXO 23:13"/>ታኒ ህንተዉ ኦድዳባ ኡባ ምንድ ኦተ። ሀራ ፆሳታ ሱን ፄግድ ዎሶፍተ፤ ኤንታ ሱን ደንፍተ።<verse eid="EXO 23:13"/></para>
  <para style="s1">ግታ ባኣለ ጋላሳታ</para>
  <para style="r">(<ref loc="EXO 34:18-26">ከሳ 34:18-26</ref>፤ <ref loc="DEU 16:1-17">ዛረ 16:1-17</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14"/>“ታና ቦንቻናዉ ላይን ሄ ባኣለ ጋላሳት ህንተዉ ደኦ። <verse eid="EXO 23:14"/><verse number="15" style="v" sid="EXO 23:15"/>ህንተ ግብፀፈ ከይዳ አቢባ ጌተትያ አጌናን፥ ታኒ ህንተና ኪትዳይሳዳ ኡይ ባኣለ ቦንችተ። ላፑን ጋላስ እርሾ የግድ ኡክዳ ኡይ ሞፕተ። ታና ጎይናናዉ ይሸ መላ ኩሸ ዮፕተ።<verse eid="EXO 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 23:16"/>“ቃስ ህንተ፥ ህንተ ጋደን ዘርን፥ ኮይሮ ጋክዳ ካ ጫክያ ዎደ ካ ጫኮ ባኣለ ቦንችተ።</para>
  <para style="p" vid="EXO 23:16">“ላይ ዉርሰን፥ ዎይንያነ ሄሳ መላ ምታ አይፍያ ህንተ ጋደፐ ማፅያ ዎደ ሻቃራ ባኣለ ቦንችተ። <verse eid="EXO 23:16"/><verse number="17" style="v" sid="EXO 23:17"/>ላይን ላይን ቦንቸትያ ሀ ሄ ባለታን አደ ኡባይ ታና፥ ህንተ ጎዳ ጎይናናዉ ዮ።<verse eid="EXO 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 23:18"/>“ኔኒ ታዉ መሄ ያርሽያ ዎደ እርሾ የግድ ኡክዳ ኡይራ ታዉ ያርሾፋ። ባኣለ ቦንችያ ጋላስ ያርሸትዳ ሞዋፈ ዎንታስ አይብካ አቶፎ። <verse eid="EXO 23:18"/><verse number="19" style="v" sid="EXO 23:19"/>ህንተ ጋደን ባይራ ካፅዳ ካ ኡባፈ ሎኡዋ ጎዳ፥ ህንተ ፆሳ ሶ ኤህተ። ዴሻ ማር ዎይኮ ዶርሳ ማር እያ አየ ማን ዶይሶፓ።<verse eid="EXO 23:19"/></para>
  <para style="s1">ኡፋይሳ ቃላታነ ዎጋታ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20"/>“ነ ኦግያን ነና ናጋና ማላነ ታኒ ነዉ ጊግስዳ በሳ ነና ኤፋና መላ ታኒ ኪታንቾ ነ ስንን ኪታና። <verse eid="EXO 23:20"/><verse number="21" style="v" sid="EXO 23:21"/>እ ኦድያባ ስአዳ እያዉ ኪተታ፤ እያ ቦላ ማካሎፋ። ታ እያዉ ማታ እምዳ ግሾ፥ ህንተ ናጋራ ኦያባ ግድኮ፥ ህንተ ናጋራ ማረና። <verse eid="EXO 23:21"/><verse number="22" style="v" sid="EXO 23:22"/>ህንተ እያዉ ኪተትኮነ ታ ኪታ ኡባ ፖልኮ፥ ህንተ ሞርከታ ኡባ ሞርካና፤ ህንተራ ኤቀተይሳታ ታኒ ኦላና። <verse eid="EXO 23:22"/><verse number="23" style="v" sid="EXO 23:23"/>ታ ኪታንቾይ ህንተ ስንን ብድ፥ ህንተና አሞረታ፥ ህተታ፥ ፓርዘታ፥ ካናነታ፥ ህወታነ ያቡሰታ ቢታ ኤሀና። ታኒ ኤንታ ይሳና። <verse eid="EXO 23:23"/><verse number="24" style="v" sid="EXO 23:24"/>ኤንታ ፆሳታስ ዝጎፍተ ዎይኮ ጎይኖፍተ፥ ዎይኮ ኤንታ አማኖ ዎጋ ካሎፍተ። ኤንታ ፆሳታ ይስተ፥ ኤንታ ኤቃ ሹቻታ መንረተ። <verse eid="EXO 23:24"/><verse number="25" style="v" sid="EXO 23:25"/>ጎዳ፥ ህንተ ፆሳ ታና፥ ጎይንተ። ሄሳዳ ህንተ ኦኮ፥ ታኒ ህንተ ካነ ህንተ ሃ አንጃና፤ ሀርግያካ ህንተ ግዶፈ ድጋና። <verse eid="EXO 23:25"/><verse number="26" style="v" sid="EXO 23:26"/>ህንተ ቢታን ማጫሳይ ቦሸተና፤ ማይነና። ታኒ ህንተ ላይ አዱሳና።<verse eid="EXO 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27"/>“ታኒ ነ ሞርከታ ቦላ ታ ያሻ የዳና። ህንተራ ኤቀትያ ካዎተታ ኡባ ዳጋንና። ህንተ ሞርከት ኡባይ ህንተዉ ዞኮ ዛሪድ ባቃታና መላ ኦና። <verse eid="EXO 23:27"/><verse number="28" style="v" sid="EXO 23:28"/>ታኒ ህንተ ሞርከታ ቦላ ካዠ የዳዳ ህወታ፥ ካናነታነ ህተታ ህንተ ስንፈ ጎዳ ከሳና። <verse eid="EXO 23:28"/><verse number="29" style="v" sid="EXO 23:29"/>ሽን ቢታይ መላ አቶናዳነ ባዞ ዶእ ህንተና ዋይሶናዳ እስ ላይን ኤንታ ጎድከ። <verse eid="EXO 23:29"/><verse number="30" style="v" sid="EXO 23:30"/>ሽን ህንተ ታይቦን ዳርድ፥ ምንድ፥ ሄ ቢታ ላታና ጋካናዉ ኤንታ ጉራ ጉራ ጎዳ ከሳና። <verse eid="EXO 23:30"/><verse number="31" style="v" sid="EXO 23:31"/>ታኒ ህንተ ዛዋ ዞኦ አባፈ ፍልስፄመ አባ፥ መላ ቢታፈ ብድ ኤፍራፂሳ ሻፋ ጋካናዉ ዳልግሳና። ሄ ቢታን ደእያ ኡባ ታኒ ህንተ ኩሸን አዳ እማና፤ ህንተካ ኤንታ ጎድድ ከሳና። <verse eid="EXO 23:31"/><verse number="32" style="v" sid="EXO 23:32"/>ኤንታራ ዎይኮ ኤንታ ፆሳታራ ጫቆ ኦፍተ። <verse eid="EXO 23:32"/><verse number="33" style="v" sid="EXO 23:33"/>ኤንታ ህንተ ቢታን ዎፍተ። ሀንኮደ ኤንቲ ህንተና ታ ቦላ ናጋራ ኦስሳና። ኤንታ ፆሳታ ህንተ ጎይንኮ ህንተዉ ፅሄ ግዳና” ያግስ።<verse eid="EXO 23:33"/></para>
  <chapter eid="EXO 23"/>
  <chapter number="24" style="c" sid="EXO 24"/>
  <para style="s1">ፆሳይ ባ ጫቁዋ ምንስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1"/>ጎዳይ ሙሰኮ፥ “ኔኒ፥ አሮን፥ ናዳብ አብዮዳነ እስራኤለ ጭማታፐ ላፑን ታሙ አሳት ታኮ ዙማ ቦላ ከይድ፥ ሃሆን ኤቅድ፥ ጉፋንድ፥ ታዉ ጎይንተ። <verse eid="EXO 24:1"/><verse number="2" style="v" sid="EXO 24:2"/>ሽን ኔኒ ነርካ ታኮ ሺቃ፤ ሀራት ታ ማት ሺቆፖ። ቃስ አሳይካ ኔራ ዙማ ቦላ ከዮፖ” ያግስ።<verse eid="EXO 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3"/>ሙሰይ ብድ፥ ጎዳ ቃላነ ዎጋ ኡባ አሳስ ኦድን፥ አሳ ኡባይ እስ ቃላን፥ “ጎዳይ ግዳባ ኡባ ኑኒ ኦና” ያግዶሶና። <verse eid="EXO 24:3"/><verse number="4" style="v" sid="EXO 24:4"/>ሙሰይ ጎዳይ ኦድዳባ ኡባ ፃፍስ።</para>
  <para style="p" vid="EXO 24:4">ዎንተ ጋላስ ጉራ ደንድድ፥ ዙማ ጋርሳን ያርሾ በሰ ጊግስስ። ታማነ ናምኡ እስራኤለ ሼሻታ ሱንን፥ ታማነ ናምኡ ሹቻ ቱስ ኤስስ። <verse eid="EXO 24:4"/><verse number="5" style="v" sid="EXO 24:5"/>እስራኤለ ፓንታ እ ኪትን፥ ኤንቲ ብድ ፁሳ ያርሹዋነ እስፈተ ያርሹዋስ ኮርማታ ሹክድ፥ ጎዳስ ያርሽዶሶና። <verse eid="EXO 24:5"/><verse number="6" style="v" sid="EXO 24:6"/>ሙሰይ መህያ ሱፈ ባጋ ኤክድ ከርያን ትግስ፤ አትዳ ባጋ ሱ ያርሾ በሳን ርጭስ። <verse eid="EXO 24:6"/><verse number="7" style="v" sid="EXO 24:7"/>ሄሳፈ ጉየ ጫቆ ማፃፋ ኤክድ፥ አሳስ ናባብን፥ ኤንቲ፥ “ጎዳይ ግዳባ ኡባ ኑኒ ኦና፤ ኑኒ እያ ኪታ ፖላና” ያግዶሶና።<verse eid="EXO 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 24:8"/>ሄሳፈ ጉየ፥ ሙሰይ ሄ ሱ ኤክድ፥ አሳ ቦላ ርጭድ፥ ኤንታ፥ “ጎዳይ ህንተዉ ሀ ኪታታ እምያ ዎደ ህንተራ ገልዳ ጫቁዋ ምንያ ሱይ ሀይሳ” ያግስ።<verse eid="EXO 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 24:9"/>ሙሰይ፥ አሮን፥ ናዳብ፥ አብዮዳነ እስራኤለ ጭማታፐ ላፑን ታማይ ዙማ ቦላ ከይድ፥ <verse eid="EXO 24:9"/><verse number="10" style="v" sid="EXO 24:10"/>እስራኤለ ፆሳ በእዶሶና። እያ ቶሁዋፐ ጋርሳን ሳሎዳ ጌይዳ፥ ሳንፓረ ጌተትያ ሹቻፈ ኦሰትዳባ ዳንያ ደምባ በሲ ደኤስ። <verse eid="EXO 24:10"/><verse number="11" style="v" sid="EXO 24:11"/>ሽን ፆሳይ እስራኤለ አሳ ሀላቃታ ዎቤና። ኤንቲ ፆሳ በእዶሶና፤ እያ ስንን ምዶሶናነ ኡይዶሶና።<verse eid="EXO 24:11"/></para>
  <para style="s1">ሙሰይ ሲና ዙማ ቦላ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12"/>ጎዳይ ሙሰኮ፥ “ኔኒ ታኮ ዙማ ቦላ ሃ ከያዳ፥ ሀይሳን ጋምአ። ታ አሳይ ታዉ ኪተታና መላ ናምኡ ሎቸ ሹቻታ ቦላ ታ ኩሸን ታ ፃፍዳ ህገታ ነዉ እማና” ያግስ።<verse eid="EXO 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 24:13"/>ሙሰይነ እያዉ ኪተትያ እያሱይ ባናዉ ደንድዶሶና፤ ሙሰይ ፆሳራ ጋሄታናዉ ዙማ ቦላ ከይስ። <verse eid="EXO 24:13"/><verse number="14" style="v" sid="EXO 24:14"/>ሙሰይ እስራኤለ ጭማታኮ፥ “ኑኒ ህንተኮ ስማና ጋካናዉ ሀይሳን ጋምእተ። አሮንነ ሁር ሀይሳን ህንተራ ደኦሶና፤ ኦድ ደእያ ኦንካ ኤንታኮ ቦ” ያግስ።<verse eid="EXO 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 24:15"/>ሙሰይ ዙማ ቦላ ከይዳ ዎደ ሻራይ ዙማ ማእስ። <verse eid="EXO 24:15"/><verse number="16" style="v" sid="EXO 24:16"/>ጎዳ ቦንቾይ ሲና ዙማ ቦላ ኡትስ። ሄ ሻራይ ኡሱፑን ጋላስ ዙማ ቦላ ማእስ፤ ላፑን ጋላስ ጎዳይ ሻራ ግዶን ግድድ ሙሰ ፄግስ። <verse eid="EXO 24:16"/><verse number="17" style="v" sid="EXO 24:17"/>ዙማ ቦላ ቆንጭዳ ጎዳ ቦንቾይ እስራኤለታስ ታማ ላጮ ዳንድ በንትስ። <verse eid="EXO 24:17"/><verse number="18" style="v" sid="EXO 24:18"/>ሄሳፈ ጉየ፥ ሙሰይ ዙማ ሁጵያ ከይድ ሻራ ግዶ ገልስ፤ ያን ኦይታሙ ጋላስነ ኦይታሙ ቃማ ጋምእስ።<verse eid="EXO 24:18"/></para>
  <chapter eid="EXO 24"/>
  <chapter number="25" style="c" sid="EXO 25"/>
  <para style="s1">ፆሳ ኬስ እመትዳ እሙዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="EXO 25:1"/><verse number="2" style="v" sid="EXO 25:2"/>“ታዉ እሞታ ኤሀና መላ እስራኤለታስ ኦዳ። እያ ዎዛን እያ እማ እማ ግዳባ እምያ እሞታ አሳ ኡባፈ ታዉ ኤካ። <verse eid="EXO 25:2"/><verse number="3" style="v" sid="EXO 25:3"/>ህንተ ኤንታፈ ኤካና እሞታይ፥ ዎርቃ፥ ብራ፥ ናሰ ብራታ፥ <verse eid="EXO 25:3"/><verse number="4" style="v" sid="EXO 25:4"/>ካሎሰ ቃጭና፥ ኦቻ ቴራ ዳንያ ቃጭና፥ ዞኦ ቃጭናነ አልኦ ሊኖ፥ ዴሻ እክሰ፥ <verse eid="EXO 25:4"/><verse number="5" style="v" sid="EXO 25:5"/>ሃሸትድ ዞኦ ቃላመን ትየትዳ ዶርሳ እተ፥ ሎኦ ዶአ እተ፥ ሶቃላ ም፥ <verse eid="EXO 25:5"/><verse number="6" style="v" sid="EXO 25:6"/>ፆምፐስ ማድያ ሻማሆ ዛይተ፥ ሹማተ ዛይትያንነ እፃንያን ጉዠትያ ሳዎታ፥ <verse eid="EXO 25:6"/><verse number="7" style="v" sid="EXO 25:7"/>ካህነ ሀላቃይ ማእያ ኤፉደ ጌተትያ ማኡዋ ቦላነ እያ ትራን ዎሰትያ ማርግደ ጌተትያ አልኦ ሹቻነ ሀራ አሌቆ ሹቻታ ኤሆ። <verse eid="EXO 25:7"/><verse number="8" style="v" sid="EXO 25:8"/>ታኒ ኤንታ ግዶን ዳና መላ ኤንቲ ታና ጎይንያ በሲ ጊግሶ።” <verse eid="EXO 25:8"/><verse number="9" style="v" sid="EXO 25:9"/>ዱንካንያነ እያ ግዶን ደእያ ሚሸታ ኡባ ታ ነና በሲያ ማራን ኦ።<verse eid="EXO 25:9"/></para>
  <para style="s1">ጫቆ ታቦተ</para>
  <para style="r">(<ref loc="EXO 37:1-9">ከሳ 37:1-9</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10"/>“ሶቃላ ምፈ፥ አዱሳተይ ናምኡ ዋነ ታካ፥ ጎምፓይ እስ ዋነ ታካ፥ ጌሳይ እስ ዋነ ታካ ግድያ ሳፅነ ኦተ። <verse eid="EXO 25:10"/><verse number="11" style="v" sid="EXO 25:11"/>ጋነ ካርያ ዋላህ ባይና ዎርቃን ካማ፤ እያ ዩሹዋካ ዎርቃን ላንፃ። <verse eid="EXO 25:11"/><verse number="12" style="v" sid="EXO 25:12"/>ሄ ታቦትያስ ኦይዱ ዎርቃ ሳጋዮታ ኦዳ፤ ኦይዱ ገዳታ ቦላ እስ ባጋራ ናምኡ ሳጋዮታ፥ ቃስ ሀንኮ ባጋራ ናምኡ ሳጋዮታ አዳ ጋሰ። <verse eid="EXO 25:12"/><verse number="13" style="v" sid="EXO 25:13"/>ታቦትያ ቶክያ ካሶ ምታ ሶቃላ ምፈ ከሳዳ ዎርቃን ላንፃ። <verse eid="EXO 25:13"/><verse number="14" style="v" sid="EXO 25:14"/>ታቦትያ ቶካናዉ እያ ምየን ደእያ ሳጋዮታን ካሶ ምታ አ። <verse eid="EXO 25:14"/><verse number="15" style="v" sid="EXO 25:15"/>ቶክያ ካሶ ምት ታቦትያ ሳጋዮታ ግዶን ደኦ፤ ኤንቲ ያፐ ከዮፖ። <verse eid="EXO 25:15"/><verse number="16" style="v" sid="EXO 25:16"/>ታቦትያ ግዶን ታኒ ነዉ እምያ፥ ታሙ ኪታት ፃፈትዳ ናምኡ ሎቸ ሹቻታ ዎ።<verse eid="EXO 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 25:17"/>“ዋላህ ባይና ዎርቃፈ አዱሳተይ ናምኡ ዋነ ታካ፥ ጎምፓይ እስ ዋነ ታካ ግድያ ናጋራ አቶተ ካማ ኦ። <verse eid="EXO 25:17"/><verse number="18" style="v" sid="EXO 25:18"/>ቀፈራ ደእያ ናምኡ ክሩበታ ዎርቃፈ ቆፃዳ ኦ። <verse eid="EXO 25:18"/><verse number="19" style="v" sid="EXO 25:19"/>እስ ክሩብያ እስ ባጋ ጋፃን፥ ናምአን ክሩብያ ሀንኮ ባጋ ጋፃን ዎዳ ናምኣ ታቦትያ ጉጵያራ ኦይዳ ኦ። <verse eid="EXO 25:19"/><verse number="20" style="v" sid="EXO 25:20"/>ክሩበት ዎልኮ ስም ኡትድ፥ ባንታ ቀፍያ ደንድ፥ አቶተ ካማ ካሞ። <verse eid="EXO 25:20"/><verse number="21" style="v" sid="EXO 25:21"/>ታኒ ነዉ እምያ ሎቸ ሹቻ ቦላ ፃፈትዳ ታሙ ኪታታ ታቦትያ ግዶን ዎ። ያታዳ፥ ጉጵያ ታቦትያ ቦላ ዎ። <verse eid="EXO 25:21"/><verse number="22" style="v" sid="EXO 25:22"/>ታቦትያ ጉጵያ ቦላ ደእያ ናምኡ ክሩበታፐ ግዶን ግዳዳ ታኒ ኔራ ጋሄታና። እስራኤለ አሳስ እምያ ኪታ ኡባ ታኒ ያን ነዉ እማና።”<verse eid="EXO 25:22"/></para>
  <para style="s1">ኡይ ፃርጴዛ</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23"/>“ሶቃላ ምፈ አዱሳተይ ናምኡ ዋ፥ ጎምፓይ እስ ዋ፥ ጌሳይ እስ ዋነ ታካ ግድያ እስ ፃርጴዛ ኦ። <verse eid="EXO 25:23"/><verse number="24" style="v" sid="EXO 25:24"/>ያታዳ፥ ዋላህ ባይና ዎርቃን ላንፃ፤ እያ ዩሹዋካ ዎርቃን ላንፃ። <verse eid="EXO 25:24"/><verse number="25" style="v" sid="EXO 25:25"/>ሄሳዳካ፥ ጎምፓይ ታካ ግድያ ጎሳ እያ ቦላ ዩሻ አ። ያታዳ፥ እያ ዩሹዋ ዎርቃን ላንፃ። <verse eid="EXO 25:25"/><verse number="26" style="v" sid="EXO 25:26"/>ሄ ፃርጴዛስ ኦይዱ ዎርቃ ሳጋዮታ ኦዳ፥ ፃርጴዛ ኦይዱ ቶሆታራ ኦይ። <verse eid="EXO 25:26"/><verse number="27" style="v" sid="EXO 25:27"/>ፃርጴዛ ቶካናዉ ካሶ ምታ አያ ሳጋዮት ፃርጴዛ ጎሳ ማታን ሺቅድ ደኦ። <verse eid="EXO 25:27"/><verse number="28" style="v" sid="EXO 25:28"/>ሄ ቶክያ ካሶታ ሶቃላ ምፈ ከሳዳ፥ ዎርቃን ላንፃ። <verse eid="EXO 25:28"/><verse number="29" style="v" sid="EXO 25:29"/>ሄሳዳካ፥ ሻተታነ ጭልፓታ፥ ዎይነ ያርሹዋ ዱቅያ ሚሸታነ ፁአታ ዋላህ ባይና ዎርቃፈ ኦ። <verse eid="EXO 25:29"/><verse number="30" style="v" sid="EXO 25:30"/>ፃርጴዛይ ታቦትያስ ስን ባጋራ ኡቶ። ታ ስንን ኡትያ ጌሻ ኡይይ ኡባ ዎደ ፃርጴዛ ቦላፈ ዮፖ።”<verse eid="EXO 25:30"/></para>
  <para style="s1">ፆምፐ ዎያ ኮጫ</para>
  <para style="r">(<ref loc="EXO 37:17-24">ከሳ 37:17-24</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31"/>“ፆምፐ ዎያ ኮጫ ዋላህ ባይና ዎርቃፈ ኦ። ሄ ኮጫይ ኤቅያ ቶሁዋነ ቶማ ዎርቃፈ ቆፃዳ ኦ። አሌቆስ ኦሰትያ ዋላፃት፥ ጋምቡትነ ጪሻት ኡባይ እስኖ ግድድ ኦሰታናዉ በሴስ።<figure style="fig" alt="Seven-branched candlestick or lampstand" file="HK00264B.tif" size="col" ref="25:31">ፆምፐ ዎያ ኮጫ</figure> <verse eid="EXO 25:31"/><verse number="32" style="v" sid="EXO 25:32"/>ናምኡ ባጋራ፥ ሄ ሄ ታሸታ እያዉ ከሳ። <verse eid="EXO 25:32"/><verse number="33" style="v" sid="EXO 25:33"/>ኡሱፑን ታሸታስ ፄራን ፄራን ሄ ሄ አሌቆ ጋምቡትነ ጪሻት ደእያ ላውዘ ም ጪሸ ዳንያባይ ደኦ። <verse eid="EXO 25:33"/><verse number="34" style="v" sid="EXO 25:34"/>ፆምፕያ ዎያ ኮጫ ግዶን ደእያ ቶማ ፄራን ኦይዱ አሌቆ ጋምቡትነ ጪሻት ደእያ ላዉዘ ም ጪሸ ዳንያባይ ደኦ። <verse eid="EXO 25:34"/><verse number="35" style="v" sid="EXO 25:35"/>ታሸታፐ ጋርሳን፥ ናምኡ ታሸት ጋሄትያ በሳን እስ እስ ጋምቡ ደኦ። <verse eid="EXO 25:35"/><verse number="36" style="v" sid="EXO 25:36"/>ጋምቡይ፥ ታሸይነ ፆምፕያ ዎያ ኮጫይ እስኖ ግድድ፥ ዋላህ ባይና ዎርቃፈ ቆፀትድ ኦሰቶ።<verse eid="EXO 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 25:37"/>“ፆምፐ ዎያ ኮጫ ቦላ ላፑን ፆምፐታ ጊግሳዳ፥ ኤንቲ ስን ፖአና መላ ቁ ኦዳ ዎ። <verse eid="EXO 25:37"/><verse number="38" style="v" sid="EXO 25:38"/>ፆምፕያ ናጋናዉ ማድያ ቃጰታነ ኤንታ ዎያባታ ዋላህ ባይና ዎርቃፈ ኦ። <verse eid="EXO 25:38"/><verse number="39" style="v" sid="EXO 25:39"/>ፆምፐ ዎያ ኮጫይነ እያ ሚሸት ኡባይ ሀስታማነ እቻሹ ክሎ ግራመ ግድያ ዋላህ ባይና ዎርቃፈ ኦሰቶ። <verse eid="EXO 25:39"/><verse number="40" style="v" sid="EXO 25:40"/>ታኒ ነና ዙማ ቦላ በስዳ ሌምሱዋ ካላዳ፥ አኬካዳ ኦ።”<verse eid="EXO 25:40"/></para>
  <chapter eid="EXO 25"/>
  <chapter number="26" style="c" sid="EXO 26"/>
  <para style="s1">ጌሻ ዱንካነ</para>
  <para style="r">(<ref loc="EXO 36:8-38">ከሳ 36:8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1"/>“ዱንካንያ ጋ ባጋስ አልኦ ሊኖፐ ኦሰትዳ፥ ታሙ ገሸ ጊግሳ። ኤንታ ካሎሰ፥ ኦቻ ቴራ ዳነይሳንነ ዞኦ ቃጭናን ዳዳዳ ክሩበታ ምስልያራ አሌቅሳ። <verse eid="EXO 26:1"/><verse number="2" style="v" sid="EXO 26:2"/>ገሸት ኡባይ እስ ልከ ግዶ፤ አዱሳተይ ላታማነ ኦይዳ፥ ጎምፓይ ቃስ ኦይዱ ዋ ግዶ። <verse eid="EXO 26:2"/><verse number="3" style="v" sid="EXO 26:3"/>እቻሹ ገሸታ እስፈ ጋዳ ስካ፤ ሀንኮ አትዳ እቻሻታ ሄሳዳ ኦ። <verse eid="EXO 26:3"/><verse number="4" style="v" sid="EXO 26:4"/>እስፈ ጋሄትድ ስከትዳ ናምኡ ገሸታስ እሱዋ እሱዋ ጋፃን ካሎሰ አፍላፐ ኦሰትዳ ሳጋዮታ ኦ። <verse eid="EXO 26:4"/><verse number="5" style="v" sid="EXO 26:5"/>እስፈ ስከትዳ ኮይሮ ማጋራጁዋ ቦላ ኮይሮ ማራን ካሎሰ አፍላፐ ኦሰትዳ እሻታሙ ሳጋዮታ ኦ፤ ሄሳዳካ ናምአን ማጋራጁዋ ቦላ ዉርሰ ጋፃን እሻታሙ ሳጋዮታ ኦ። <verse eid="EXO 26:5"/><verse number="6" style="v" sid="EXO 26:6"/>ጌሻ ዱንካነይ እስኖ ግዳና መላ ናምኡን ሻከት ስከትዳ ገሸታ ዎል ጋድ ኦይሰናዉ፥ እሻታሙ ዎርቃፈ ኦሰትዳ ኦይክያባታ ኦ።<verse eid="EXO 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7"/>“ጌሻ ዱንካንያ ቦላራ ካማና መላ ታማነ እስ ገሸታ ዴሻ እክሰፐ ኦ። <verse eid="EXO 26:7"/><verse number="8" style="v" sid="EXO 26:8"/>ታማነ እስ ገሸት እስ ግና ግዶ፤ እስ እስ ማጋራጁዋ አዱሳተይ ሀስታሙ ዋ፥ ጎምፓይ ኦይዱ ዋ ግዶ። <verse eid="EXO 26:8"/><verse number="9" style="v" sid="EXO 26:9"/>እቻሹ ገሸታ እስ ባጋራ፥ ኡሱፑን ገሸታ ሀንኮ ባጋራ ጋዳ ስካ። ኡሱፑን ማጋራጆይ ዳኮየትድ፥ ዱንካንያስ ስን ባጋራ ዳቡለቶ። <verse eid="EXO 26:9"/><verse number="10" style="v" sid="EXO 26:10"/>ዎል ጋ ስክዳ ገሸታፐ እስ ማጋራጁዋስ ማጫራ ቦላ እሻታሙ ሳጋዮታ ኦ፤ ቃስ ሀንኮ ማጋራጁዋስ ማጫራ ቦላ እሻታሙ ሳጋዮታ ኦ። <verse eid="EXO 26:10"/><verse number="11" style="v" sid="EXO 26:11"/>ናምኡን ሻከት ስከትዳ ገሸት እስ ካማ ግዳና መላ እሻታሙ ናሰ ብራታፐ ኦሰትዳ ኦይክያባታ ኦ። <verse eid="EXO 26:11"/><verse number="12" style="v" sid="EXO 26:12"/>ሄ ዱንካንያ ገሸታፐ ፓላህዳ ባጋ ኤካዳ ጌሻ ዱንካንያስ ጉየ ባጋራ ካቃ። <verse eid="EXO 26:12"/><verse number="13" style="v" sid="EXO 26:13"/>ዱንካንያ ገሸታፐ አዱሳተ ባጋራ ፓላህዳ ጎምፓይ እስ እስ ዋ ግድዳ ገሸታ ጌሻ ዱንካንያስ ናምኡ ባጋራ ካቃ።<verse eid="EXO 26:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 26:14"/>“ዱንካንያስ ቦላ ባጋራ ዳቡልድ ካማናዉ ዞኦ ቃላመን ትየትዳ ማራዘ እተነ ሎኦ ዶአ እተ ኦ። <verse eid="EXO 26:14"/><verse number="15" style="v" sid="EXO 26:15"/>ጌሻ ዱንካንያ ቱቀታ ሶቃላ ምፈ ኦ። <verse eid="EXO 26:15"/><verse number="16" style="v" sid="EXO 26:16"/>እስ እስ ቱቅያ አዱሳተይ ታሙ ዋ፥ ጎምፓይ እስ ዋነ ባጋ ግዶ። <verse eid="EXO 26:16"/><verse number="17" style="v" sid="EXO 26:17"/>ናምኡ ቱቀት እስፈ ኦይከታና መላ እስ እስ ቱቅያስ ኦይሰያባይ ደኦ። ጌሻ ዱንካንያ ቱቀታ ኡባ ሄሳዳ ኦ። <verse eid="EXO 26:17"/><verse number="18" style="v" sid="EXO 26:18"/>ጌሻ ዱንካንያ ዉሎሀ ባጋራ ላታሙ ቱቀታ ኦ። <verse eid="EXO 26:18"/><verse number="19" style="v" sid="EXO 26:19"/>ኤንታና ኤሳናዉ ኤንታ ጋርሳን ብራ ብራታፐ ኦሰትዳ ኦይታሙ ሉሆይ ደእያ ቶሆታ ኦ። እስ እስ ቱቅያስ ናምኡ ናምኡ ቶሆ ከሳ። <verse eid="EXO 26:19"/><verse number="20" style="v" sid="EXO 26:20"/>ጌሻ ዱንካንያ ፑደሀ ባጋራ ላታሙ ቱቀታ ኦ። <verse eid="EXO 26:20"/><verse number="21" style="v" sid="EXO 26:21"/>ኤንታና ኤሳናዉ ኤንታ ጋርሳን ብራ ብራታፐ ኦሰትዳ ኦይታሙ ሉሆይ ደእያ ቶሆታ ኦ። እስ እስ ቱቅያስ ናምኡ ናምኡ ቶሆ ከሳ። <verse eid="EXO 26:21"/><verse number="22" style="v" sid="EXO 26:22"/>ጌሻ ዱንካንያስ ጉየራ ዉሎሀ ባጋራ ኡሱፑን ቱቀታ ኦ። <verse eid="EXO 26:22"/><verse number="23" style="v" sid="EXO 26:23"/>ጉየ ባጋራ ደእያ ማዛነታስ ናምኡ ቱቀታ ኦ። <verse eid="EXO 26:23"/><verse number="24" style="v" sid="EXO 26:24"/>ሄ ማዛንያን ደእያ ቱቀት ቶሆፐ ሁጰ ጋካናዉ ኦይከቶ። ናምኡ ማዛነታ መያ ናምኡ ቱቀታ ሄሳ ኦሰታናዉ በሴስ። <verse eid="EXO 26:24"/><verse number="25" style="v" sid="EXO 26:25"/>ሄሳዳካ ናምኡ ናምኡ ቶሆይ ደእያ ሆስፑን ቱቀታ ኦዳ፥ ኤንታዉ ብራ ብራታፐ ኦሰትዳ ታማነ ኡሱፑን ሉሆይ ደእያ ቶሆታ ኦ።<verse eid="EXO 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 26:26"/>“ቱኡቀታ ሳድ ኦይያ ሶቃላ ምፈ ኦሰትዳ ታማነ እቻሹ ልዮታ ከሳ። ኤንታፈ እቻሻታ ጌሻ ዱንካንያስ እስ ባጋ ምየን ደእያ ቱቀታስ፥ <verse eid="EXO 26:26"/><verse number="27" style="v" sid="EXO 26:27"/>ቃስ እቻሻታ ሀንኮ ባጋ ምየን ደእያ ቱቀታስ፥ ሄሳዳካ አትዳ እቻሻታ ዉሎሀ ባጋን ደእያ ቱቀታስ ኦ። <verse eid="EXO 26:27"/><verse number="28" style="v" sid="EXO 26:28"/>ሀ ጋፃ ቱቅያፐነ ያ ጋፃ ቱቅያፐ ይያ ልዮት ግዶ ቱቅያራ ኦይከቶ። <verse eid="EXO 26:28"/><verse number="29" style="v" sid="EXO 26:29"/>ቱኡቀታ ዎርቃን ላንፃ፤ ልዮታ ኦይካናዉ ማድያ ሳጋዮታ ዎርቃፈ ኦ፤ ቃስ ልዮታ ዎርቃን ላንፃ። <verse eid="EXO 26:29"/><verse number="30" style="v" sid="EXO 26:30"/>ጌሻ ዱንካንያ ዙማ ቦላ ታ ነና በስዳይሳዳ ኦ።<verse eid="EXO 26:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31"/>“አልኦ ሊኖፐ እስ ማጋራጆ ኦዳ፥ እያ ካሎሰ፥ ኦቻ ቴራ ዳነይሳንነ ዞኦ ቃጭናን ዳዳዳ ክሩበታ ምስለን አሌቅሳ። <verse eid="EXO 26:31"/><verse number="32" style="v" sid="EXO 26:32"/>እያ ሶቃላ ምፈ ኦዳ፥ ዎርቃን ሜሸትዳ ኮጫታንነ ብራ ብራታፐ ኦሰትዳ ኦይዱ ቶሆይ ደእያ ቱሳታ ቦላ ካቃ። <verse eid="EXO 26:32"/><verse number="33" style="v" sid="EXO 26:33"/>ሄ ማጋራጁዋ ጌሻ ዱንካንያስ ካራን ደእያ ቃጰታፐ ጋርሳን ካቃ። ያታዳ ህገይ ፃፈትዳ ናምኡ ሎቸ ሹቻታ ኦይክዳ ጫቆ ታቦትያ ማጋራጁዋስ ጉየ ባጋን ዎ። ሄ ገሸይ፥ ጌሻ በሳነ ኡባፈ ጌሻ በሳፈ ሻኬስ። <verse eid="EXO 26:33"/><verse number="34" style="v" sid="EXO 26:34"/>ናጋራ አቶተ ካማን ጫቆ ታቦትያ ካማ። <verse eid="EXO 26:34"/><verse number="35" style="v" sid="EXO 26:35"/>ፃርጴዛ፥ ኡባፈ ጌሻ በሳፈ ካረራ፥ ጌሻ ዱንካንያፐ ፑደሀ ባጋን ዎ፤ ፆምፐ ዎያ ኮጫ ዱገሀ ባጋራ ዎ።<verse eid="EXO 26:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36"/>“ዱንካንያ ፐንገ ማጋራጁዋ፥ አልኦ ሊኖፐ ጊግሳዳ፥ ካሎሰ፥ ኦቻ ቴራ ዳነይሳንነ ዞኦ ቃጭናን ዳዳዳ አሌቅሳ። <verse eid="EXO 26:36"/><verse number="37" style="v" sid="EXO 26:37"/>ማጋራጁዋስ እቻሹ ቱሳታ ሶቃላ ምፈ ኦዳ ዎርቃን ላንፃ፤ ኮጫትካ ዎርቃፈ ኦሰትዳይሳታ ግዶ። ቱሳታስ ናሰ ብራታፐ እቻሹ ቶሆታ ጊግሳ።”<verse eid="EXO 26:37"/></para>
  <chapter eid="EXO 26"/>
  <chapter number="27" style="c" sid="EXO 27"/>
  <para style="s1">ያርሾ በሲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1"/>“ሶቃላ ምፈ ያርሾ በሲ ኦ። አዱሳተይነ ጎምፓይ ኦይዱ ዋነ ታካ፥ ጌሳይ ሄ ዋ ግድዳ ኦይዱ ማዛነራ ደእያ ያርሾ በሲ ኦ። <verse eid="EXO 27:1"/><verse number="2" style="v" sid="EXO 27:2"/>ኦይዱ ማዛነታ ቦላ ካጨ ዳንያባ ከሳ፤ ካጨት ያርሾ በሳራ እስኖ ግድድ ኦሰቶ። ያታዳ፥ ያርሾ በሳ ኡባ ናሰ ብራታን ላፃ። <verse eid="EXO 27:2"/><verse number="3" style="v" sid="EXO 27:3"/>እያዉ ጎኤትያ ሚሸታ፤ ብዶ ከስያ ከረታ፥ አካፋታ፥ ባልደታ፥ አሾ ቃጰታነ ጮጨታ ኡባ ናሰ ብራታፐ ኦ። <verse eid="EXO 27:3"/><verse number="4" style="v" sid="EXO 27:4"/>ያታዳ፥ ናሰ ብራታፐ ዛርዛረ ዳንያባ ኦዳ፥ እያዉ ኦይዱ ማዛነታ ቦላ ኦይዱ ሳጋዮታ ጊግሳ። <verse eid="EXO 27:4"/><verse number="5" style="v" sid="EXO 27:5"/>ሄ ዛርዛርያ ያርሾ በሳ ጎሳፈ ጋርሳን ያርሾ በሳስ ባጋ ዛዋ ጋዳ ዎ። <verse eid="EXO 27:5"/><verse number="6" style="v" sid="EXO 27:6"/>ሶቃላ ምፈ ያርሾ በሳ ቶክያ ካሶ ምታ ከሳዳ፥ ናሰ ብራታን ላንፃ። <verse eid="EXO 27:6"/><verse number="7" style="v" sid="EXO 27:7"/>ያርሾ በሳ ቶክያ ዎደ ማዳና መላ ሄ ካሶ ምታ ናምኡ ምየራ ደእያ ሳጋዮታን አ። <verse eid="EXO 27:7"/><verse number="8" style="v" sid="EXO 27:8"/>ታኒ ነና ዙማ ቦላ በስዳይሳዳ ያርሾ በሲ ፃዉላፐ ኦዳ፥ ግዱዋ ካይስ ኦ።”<verse eid="EXO 27:8"/></para>
  <para style="s1">ጌሻ ዱንካነ ዳባባ</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9"/>“ጌሻ ዱንካንያ ዳባባ ገቻናዉ አልኦ ሊኖፐ ማጋራጆ ጊግሳ። ገሸታስ አዱሳተይ ዱገሀ ባጋራ ፄቱ ዋ ግዶ። <verse eid="EXO 27:9"/><verse number="10" style="v" sid="EXO 27:10"/>እያዉ ካተ ግዳና መላ ናሰ ብራታፐ ኦሰትዳ ላታሙ ቱሳታነ ላታሙ ቶሆታ ኦ። ኤንታ ቦላ ብራ ብራታፐ ኦሰትዳ ፃምአታነ ካጨታ ኦ። <verse eid="EXO 27:10"/><verse number="11" style="v" sid="EXO 27:11"/>ዳባባስ ፑደሀ ባጋራካ ሄሳዳ ኦ።<verse eid="EXO 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 27:12"/>“ዳባባስ ዉሎሀ ባጋ አዱሳተይ እሻታሙ ዋ ግድዳ ገሸት ኦሰትድ፥ ኤንታዉ ታሙ ቶሆይ ደእያ ቱሳት ደኦ። <verse eid="EXO 27:12"/><verse number="13" style="v" sid="EXO 27:13"/>ገልያ ዉላይ ደእያ፥ ዶሎሀ ባጋ ዳባባ ጎምፓይ እሻታሙ ዋ ግዶ። <verse eid="EXO 27:13"/><verse number="14" style="v" sid="EXO 27:14"/>ዳባባ ፐንግያፈ እስ ባጋራ አዱሳተይ ታማነ እቻሹ ዋ ግድያ ገሸት ደኦ፤ ኤንታዉ ሄ ቶሆይ ደእያ ሄ ቱሳት ደኦ። <verse eid="EXO 27:14"/><verse number="15" style="v" sid="EXO 27:15"/>ሀንኮ ባጋራ ደእያ ገሸትካ ሄሳዳ ኦሰቶ።<verse eid="EXO 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 27:16"/>“ዳባባ ገልያ ዉላስ አዱሳተይ ላታሙ ዋ ግድያ፥ አልኦ ሊኖፐ ማጋራጆ ጊግሳዳ፥ ካሎሰ፥ ኦቻ ቴራ ዳነይሳንነ ዞኦ ቃጭናን ዳዳዳ አሌቅሳ። ኤንቲ እያን ዘምፓና መላ ኦይዱ ቶሆራ ደእያ ኦይዱ ቱሳታ ጊግሳ። <verse eid="EXO 27:16"/><verse number="17" style="v" sid="EXO 27:17"/>ዳባባ ዩሹዋን ደእያ ቱሳት ኡባይ ብራ ብራታፐ ኦሰትዳ ፃምአታን ኦይከቶ፤ ኤንታ ካጨት ብራ ብራታፐ፥ ኤንታ ቶሆት ናሰ ብራታፐ ኦሰቶ። <verse eid="EXO 27:17"/><verse number="18" style="v" sid="EXO 27:18"/>ዳባባ አዱሳተይ ፄቱ ዋ፥ ጎምፓይ ኦይታሙ ዋ፥ ጌሳይ እቻሹ ዋ ግዶ። ማጋራጆት አልኦ ሊኖፐ፥ ኤንታ ቶሆትካ ናሰ ብራታፐ ኦሰቶ።<verse eid="EXO 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 27:19"/>“ጌሻ ዱንካንያን ጎኤትያ ሚሸ ኡባይ፥ ዱንካንያነ ዳባባ ሸት ኡባይ ናሰ ብራታፐ ኦሰቶ።<verse eid="EXO 27:19"/></para>
  <para style="s1">ፆምፐ ዛይተ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20"/>“ፆምፐይ ቃማ ፖእሸ አቃና መላ ጉምእ ፅልስዳ ሻማሆ ዛይተ ነዉ ኤሀና መላ እስራኤለ አሳ ኪታ። <verse eid="EXO 27:20"/><verse number="21" style="v" sid="EXO 27:21"/>አሮንነ እያ ናይት፥ ፖኦይ፥ ጎዳ ስንን ኦማርሳፈ ዎንታ ጋካናዉ ፖአና መላ ጌሻ ዱንካንያ ግዶን፥ ማርካ ታቦትያ ስንን ደእያ ማጋራጁዋፈ ካረ ባጋራ ኤ። ሄስ እስራኤለ አሳስ መርና ዎጋ ግድድ ደኦ።<verse eid="EXO 27:21"/></para>
  <chapter eid="EXO 27"/>
  <chapter number="28" style="c" sid="EXO 28"/>
  <para style="s1">ካህነታ ማኦ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1"/>“ነ እሻ አሮናነ እያ ናይታ ናዳባ፥ አብዮዳ፥ አላዛራነ እታማራ ኔኮ ፄጋ። ኤንቲ ካህነ ግድድ ታዉ ሀጋዛና መላ እስራኤለ አሳ ግዶፈ ኤንታ ዱማያ። <verse eid="EXO 28:1"/><verse number="2" style="v" sid="EXO 28:2"/>እያዉ ቦንቾነ ቴማ እማና መላ ነ እሻ አሮናስ ቦንቾ ማኦታ ጊግሳ። <verse eid="EXO 28:2"/><verse number="3" style="v" sid="EXO 28:3"/>አሮን ካህነተን ዱማትድ ታዉ ሀጋዛናዳ፥ ታኒ ሂላተ እምዳ ኦሳንቾታ ኡባ ፄጋዳ፥ አሮናስ ማኦታ ጊግሳና መላ ኦዳ። <verse eid="EXO 28:3"/><verse number="4" style="v" sid="EXO 28:4"/>ኤንቲ ጊግሳና ማኦትካ ሀይሳታ፤ ትራን ማኤትያ ማኦ፥ ኤፉደ፥ አዱሳ ቃምሰ፥ አሌቀትድ ዳደትዳ ሻምዘ፥ ቃጨነ ዳንጮ። ነ እሻይ አሮንነ እያ ናይት ካህነ ግድድ ታዉ ሀጋዝሸ ማአና መላ ጌሻ ማኦታ ኤንታዉ ጊግሶ። <verse eid="EXO 28:4"/><verse number="5" style="v" sid="EXO 28:5"/>ኩሸ ሂላንቾት ሄ ማኦታ ዎርቃ ጫቻፈ፥ ካሎሰፐ፥ ኦቻ ቴራ ዳነይሳፈ ዞኦ ቃጭናፐነ አልኦ ሊኖፐ ጊግሶ።<verse eid="EXO 28:5"/></para>
  <para style="s1">ኤፉደ</para>
  <para style="r">(<ref loc="EXO 39:2-7">ከሳ 39:2-7</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6"/>“ኤፉደ ጌተትያ ማኡዋ ዎርቃ ጫቻ ቃጭናፐ፥ ካሎሰፐ፥ ኦቻ ቴራ ዳነይሳፈ፥ ዞኦ ቃጭናፐነ አልኦ ሊኖፐ ኩሸ ሂላንቾት አሌቅስድ ጊግሶ። <verse eid="EXO 28:6"/><verse number="7" style="v" sid="EXO 28:7"/>ናምኡ ሀሽያራ ዎድ፥ ናምኡ ባጋ ዎል ጋድ ቃቻናዉ ማድያ ቃንጎት ደኦ። <verse eid="EXO 28:7"/><verse number="8" style="v" sid="EXO 28:8"/>ኤፉደይ ኦሰትዳባፐ ሂላን ኦሰትዳ ዳንጮይ ኤፉድያራ ዎላ ኦሰትዳባ ግድድ እስፈ ኦይከቶ። <verse eid="EXO 28:8"/><verse number="9" style="v" sid="EXO 28:9"/>ማርግደ ጌተትያ ናምኡ ሹቻታ ኤካዳ፥ ታማነ ናምኡ ያይቆባ ናይታ ሱን ኤንታ ቦላ ዎጫዳ ፃፋ። <verse eid="EXO 28:9"/><verse number="10" style="v" sid="EXO 28:10"/>ኤንታ የለታ ማራዳ እስ ሹቻ ቦላ ኡሱፑን ሱንታ፥ ሀንኮ ሹቻ ቦላ አትዳ ኡሱፑን ሱንታ ዎጫዳ ፃፋ። <verse eid="EXO 28:10"/><verse number="11" style="v" sid="EXO 28:11"/>ሀ ናምኡ ሹቻታ ቦላ ታማነ ናምኡ ያይቆባ ናይታ ሱን ዎጫድ ፃፋናዉ ሂላንቾ ደማ፤ ሄ ፃፈትዳ ሹቻታ ኤፉድያ ቦላ ኦይናዉ እያ ዩሹዋ ዎርቃን ላንፃ። <verse eid="EXO 28:11"/><verse number="12" style="v" sid="EXO 28:12"/>ያታዳ ታማነ ናምኡ እስራኤለ ሼሻ ቆፍስያባ ግዳና መላ ሀ ናምኡ ሹቻታ ኤፉድያራ ኦይዳ ሀሽያራ አያ ቃንጉዋ ቦላ ዎ። ታኒ፥ ጎዳይ፥ ታ አሳ ኡባ ዎደ ሀሳያና መላ አሮን ኤንታ ሱን ባ ሀሽያን ቶኮ። <verse eid="EXO 28:12"/><verse number="13" style="v" sid="EXO 28:13"/>ሄ ሹቻታ ኦይከይሳ ዎርቃፈ ኦ። <verse eid="EXO 28:13"/><verse number="14" style="v" sid="EXO 28:14"/>ቃስ ዋላህ ባይና ዎርቃፈ ዎዶሮዳ ዶቀትዳ ናምኡ ሳንላታ ሀሽያራ አያ ቃንጉዋራ ኦይከታና መላ ኦ።<verse eid="EXO 28:14"/></para>
  <para style="s1">ትራን ማኤትያ ማኦ</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15"/>“ጎዳ ሸንያ ኦይችድ ኤራናዉ፥ ትራን ማኤትያ ማኡዋ ኩሸ ሂላንቾን ኦስሳ። ሄ ትራን ማኤትያ ማኡዋ ዎርቃ ጫቻ ቃጭናፐ፥ ካሎሰፐ፥ ኦቻ ቴራ ዳነይሳፈ፥ ዞኦ ቃጭናፐነ አልኦ ሊኖፐ ኤፉድያዳ አሌቅስድ ጊግሶ። ካሎሰፐ ኦሰትዳባፐ ኦዳ አሌቅሳ። <verse eid="EXO 28:15"/><verse number="16" style="v" sid="EXO 28:16"/>እያዉ ጌሳይነ ጎምፓይ እስ እስ ታካ ግድድ ኦይዱ ማዛነይ ደኦ። <verse eid="EXO 28:16"/><verse number="17" style="v" sid="EXO 28:17"/>እያዉ ኦይዱ ማራን አልኦ ሹቻታ ዎ። ኮይሮ ማራን ሳርድዮነ፥ ቶጳዘነ ጶልያ አልኦ ሹቻታ ዎ። <verse eid="EXO 28:17"/><verse number="18" style="v" sid="EXO 28:18"/>ናምአን ማራን ባሉረ፥ ሳንፐረነ አልማዘ ጌተትያ አልኦ ሹቻታ ዎ።<figure style="fig" alt="Turban and breastpiece" file="HK00261B.tif" size="col" ref="28:15">ሁጰቃጨነ ትራን ማኤትያ ማኦ</figure> <verse eid="EXO 28:18"/><verse number="19" style="v" sid="EXO 28:19"/>ሄን ማራን ያክንተ፥ ከልቀዶነነ አመተስፅኖሳ ጌተትያ አልኦ ሹቻታ ዎ። <verse eid="EXO 28:19"/><verse number="20" style="v" sid="EXO 28:20"/>ኦይዳን ማራን ብረለ፥ ማርግደ፥ ያስጵደ ጌተትያ አልኦ ሹቻታ ዎ። ሀይሳቲ ኡባይ ዎርቃ ካቁዋ ቦላ ዎሰቶ። <verse eid="EXO 28:20"/><verse number="21" style="v" sid="EXO 28:21"/>እስራኤለ ናይታስ ቆፍሶ ግዳና መላ ሀ ታማነ ናምኡ አልኦ ሹቻታ፥ እስ እስ ያይቆባ ናይታ ሱንይ፥ እስ እስ ሹቻ ቦላ ዎጨትድ ፃፈቶ።<verse eid="EXO 28:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 28:22"/>“ትራን ማኤትያ ማኡዋስ ዋላህ ባይና ዎርቃፈ ዎዶሮዳ ዶቃዳ ሳንላታ ኦ። <verse eid="EXO 28:22"/><verse number="23" style="v" sid="EXO 28:23"/>ናምኡ ዎርቃ ምግዶታ ኦዳ፥ ትራን ማኤትያ ማኡዋስ ቆሞ ጋፃ ማዛንያን ጋዳ ኦይ። <verse eid="EXO 28:23"/><verse number="24" style="v" sid="EXO 28:24"/>ሄ ናምኡ ዎርቃ ሳንላታታ ምግዶታራ ጋዳ ኦይ። <verse eid="EXO 28:24"/><verse number="25" style="v" sid="EXO 28:25"/>ሀንኮ ባጋን ደእያ ናምኡ ሳንላታ ጋፃ ናምኡ ቃንጎታራ ጋሰ። ሄሳዳ ኦዳ ስን ባጋራ፥ ሀሽያራ ዎያ ኤፉድያ ቃንጉዋራ ጋሰ። <verse eid="EXO 28:25"/><verse number="26" style="v" sid="EXO 28:26"/>ቃስ ናምኡ ዎርቃ ሳጋዮታ ኦዳ፥ ኤፉድያፐ ጋ ባጋራ ካልድ ደእያ ትራን ማኤትያ ማኡዋስ ናምኡ ማዛነታ ፄራን አ። <verse eid="EXO 28:26"/><verse number="27" style="v" sid="EXO 28:27"/>ሄሳዳካ፥ ዎርቃፈ ሀራ ናምኡ ምግዶታ ኦዳ፥ ኤፉድያስ ስን ባጋ ሀሽያራ ዎያ ቃንጉዋስ ጋርሳ ባጋራ ጋሰ። ኤፉድያ ስኩዋ ማታን ዳንጩዋፈ ቆሞ ባጋራ ኤንታ ጋሰናዉ በሴስ። <verse eid="EXO 28:27"/><verse number="28" style="v" sid="EXO 28:28"/>ትራን ማኤትያ ማኡዋን ደእያ ምግዶታ ኤፉድያን ደእያ ምግዶታራ ጋዳ ካሎሰ ቃጭናን ቃቻ። ሄሳዳ ኦኮ፥ ትራን ማኤትያ ማኦይ ፄሳፈ ቆሞን ደእያ ግሾ፥ ቃሾይ ዶልኤና።<verse eid="EXO 28:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29"/>“አሮን ጌሻ በሳ ገልያ ዎደ እስራኤለ ማይዛታ ሱን ኦይክዳ፥ ትራን ማኤትያ ማኡዋ ማኦ። ያንያ ግሾ፥ ታኒ፥ ጎዳይ ኡባ ዎደ ታ አሳ ቆፓና። <verse eid="EXO 28:29"/><verse number="30" style="v" sid="EXO 28:30"/>ቃስ ሳማ የግያ ናምኡ ጌሻ ሹቻታ ትራን ማኤትያ ማኡዋን የጋ።<note caller="-" style="x"><char style="xo" closed="false">28:30 </char><char style="xt" closed="false"><ref loc="NUM 27:21">ታይቦ 27:21</ref>፤ <ref loc="DEU 33:8">ዛረ 33:8</ref>፤ <ref loc="EZR 2:63">እዝ 2:63</ref>፤ <ref loc="NEH 7:65">ናህ 7:65</ref>.</char></note> አሮን ጌሻ ዱንካንያ ገልያ ዎደ ባ ትራን ኤንታ ቶክድ ገሎ። ታ ሸንያ እስራኤለ አሳ ኤርሳናዉ ታ ስን ገልያ ዎደ ኡባን ትራ ኪስያፐ ይሶፎ።<verse eid="EXO 28:30"/></para>
  <para style="s1">ሀራ ካህነ ማኦታ</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31"/>“ኤፉድያፐ ቦላራ ማእያ አዱሳ ማኡዋ ኩመ ካሎሰ አፍላፐ ጊግሳ። <verse eid="EXO 28:31"/><verse number="32" style="v" sid="EXO 28:32"/>ሄ አዱሰ ማኡዋስ ሁጰ አያ ሉሆ መ። ሄ ሉሆይ ፔቶና መላ ጉየ ቃላምአዳ ዩሻ አዳ ስካ። <verse eid="EXO 28:32"/><verse number="33" style="v" sid="EXO 28:33"/>አዱሳ ማኡዋስ ዱገ ባጋ ማጫራ ዩሹዋን ካሎሰ፥ ኦቻ ቴራ ዳነይሳንነ ዞኦ ቃጭናፐ፥ ኦሮማነ ቴራ ምስለ መ። ያታዳ ኤንታ ግዶን አ አ ዎርቃፈ ኦሰትዳ ዳላታ ኦ። <verse eid="EXO 28:33"/><verse number="34" style="v" sid="EXO 28:34"/>ዎርቃ ዳላትነ ኦሮማነ ቴራ ምስለት ሄ አዱሰ ማኡዋስ ዱገ ባጋ ማጫራ ዩሹዋን አ። <verse eid="EXO 28:34"/><verse number="35" style="v" sid="EXO 28:35"/>አሮን ካህነተን ኦያ ዎደ ሀ አዱሳ ማኡዋ ማኦ። ጎዳ ስን፥ ጌሻ በሳ ገልያ ዎደነ ከይያ ዎደ፥ ዳላይ ጊራና፤ እካ ሀይቀና። <verse eid="EXO 28:35"/><verse number="36" style="v" sid="EXO 28:36"/>ዋላህ ባይና ዎርቃፈ እስ አሌቆ ኦዳ፥ እያ ቦላ ‘ጎዳስ ዱማትስ’ ያጋዳ ዎጫዳ ፃፋ። <verse eid="EXO 28:36"/><verse number="37" style="v" sid="EXO 28:37"/>ያታዳ ሁጵያ ቃጭያ ቦላ ካሎሰ ቃጭናራ ቃቻ። <verse eid="EXO 28:37"/><verse number="38" style="v" sid="EXO 28:38"/>አሮን እያ ባ ሶምኡዋን ዎ። ሄሳን እስራኤለ አሳይ ጎዳስ እሞታ እምሸ ባልዳባይ ደእኮ፥ ሄ ባላ አሮን ቶኬስ። አሳይ ኤህያባ ጎዳይ ኤካና መላ እ ሄሳ ኡባ ዎደ ባ ሶምኡዋን ዎናዉ ኮሼስ።<verse eid="EXO 28:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39"/>“አሮና ሻምዝያነ ቃጭያ አልኦ ሊኖፐ ዳዳ። ቃስ ዳንጩዋካ አልኦ ሊኖፐ ዳዳዳ አሌቅሳ። <verse eid="EXO 28:39"/><verse number="40" style="v" sid="EXO 28:40"/>አሮና ናይታስ ቦንቾነ ፑላ እማና መላ ሻምዘታ፥ ዳንጮታነ ሁጰን ዎያ ቆበታ ጊግሳ። <verse eid="EXO 28:40"/><verse number="41" style="v" sid="EXO 28:41"/>ኔኒ ሀ ማኦታ ነ እሻ አሮናነ እያ ናይታ ማይዛ። ኤንቲ ካህነተን ታዉ ሀጋዛና መላ ኤንታ ሻማሆ ዛይተን ትያዳ ታዉ ዱማያ። <verse eid="EXO 28:41"/><verse number="42" style="v" sid="EXO 28:42"/>ኤንታ ካሎይ ካመታና መላ ጋርሳን ማእያ ማኡዋ ፄሳፈ ብድ ዎድረ ጋካናዉ ካምያባ አልኦ ሊኖፐ ጫርቀፈ ሱረ ጊግሳ። <verse eid="EXO 28:42"/><verse number="43" style="v" sid="EXO 28:43"/>አሮንነ እያ ናይት ጌሻ ዱንካንያ ገልያ ዎደ ዎይኮ ጌሻ በሳን ካህነተን ሀጋዛናዉ ያርሾ በሲ ሺቅያ ዎደ ሀ ማኦታ ማኦ። ሄሳዳ ሀንኮ፥ ኤንቲ ባንታ ቦላ ሀይቆ ኤሆኮና። ሄስ አሮናስነ እያ ሼሻታስ መርና ዎጋ ግዶ።<verse eid="EXO 28:43"/></para>
  <chapter eid="EXO 28"/>
  <chapter number="29" style="c" sid="EXO 29"/>
  <para style="s1">ካህነታ ሹሞ ዎጋ</para>
  <para style="r">(<ref loc="LEV 8:1-36">ሌወ 8:1-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1"/>“አሮንነ እያ ናይት ካህነተን ታዉ ሀጋዛና መላ ኔኒ ኤንታ ዱማያናዉ ሀይሳዳ ኦ፤ ቦረይ ባይና ዎፋኖነ ናምኡ ማራዘ ኤካ። <verse eid="EXO 29:1"/><verse number="2" style="v" sid="EXO 29:2"/>ጌሻ ግስተ ለ ኤካዳ፥ እርሾ የጎና ሻማሆ ዛይተራ ግንዳዳ ኡይ ኡካ። ቃስ ዛይተይ ገሎና ሀራ ኡይ ኡካ፤ ሄሳዳካ፥ ሌኦ ኡይ ኡካዳ ዛይተን ትያ። <verse eid="EXO 29:2"/><verse number="3" style="v" sid="EXO 29:3"/>ዎፋኑዋነ ናምኡ ማራዘታ ያርሽያ ዎደ ሄ ኡይ ኡባ ጋይታን ዎዳ ታዉ ሺሻ።<verse eid="EXO 29:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 29:4"/>“ያታዳ አሮናነ እያ ናይታ ጌሻ ዱንካንያ ፐንገ ኤሀዳ ሃን ኤንቲ ሜጨታና መላ ኦዳ። <verse eid="EXO 29:4"/><verse number="5" style="v" sid="EXO 29:5"/>ሄሳፈ ጉየ፥ ካህነተ ማኦታ፥ ሻምዝያ፥ ኤፉድያ፥ ኤፉድያ ቦላራ ማእያ አዱሳ ማኡዋነ ትራን ማኤትያ ማኡዋ አሮና ማይዛ፤ ዳንጩዋካ ዳንጭሳ። <verse eid="EXO 29:5"/><verse number="6" style="v" sid="EXO 29:6"/>ቃጭያ ቃጭሳ፤ እያ ቦላ፥ ‘ጎዳስ ዱማትስ’ ጌተትድ ፃፈትዳ ዎርቃ አሌቁዋ ዎ። <verse eid="EXO 29:6"/><verse number="7" style="v" sid="EXO 29:7"/>ትሻ ዛይትያ ኤካዳ እያ ሁጵያን ትጋዳ ትያ። <verse eid="EXO 29:7"/><verse number="8" style="v" sid="EXO 29:8"/>እያ ናይታ ኤሀዳ ሻምዝያ ማይዛ። <verse eid="EXO 29:8"/><verse number="9" style="v" sid="EXO 29:9"/>ኤንታ ፄሳ ዳንጭሳ፤ ኤንታ ሁጵያንካ ቆበ ዎ። አሮናነ እያ ናይታ ያታዳ ካህነተን ሹማ። ሄስካ፥ ኤንታዉ መርና ዎጋ ግዶ።<verse eid="EXO 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10"/>“ዎፋኑዋ ጌሻ ዱንካንያ ስን ኤሀዳ፥ አሮንነ እያ ናይት እያ ሁጵያን ባንታ ኩሽያ ዎና መላ ኦ። <verse eid="EXO 29:10"/><verse number="11" style="v" sid="EXO 29:11"/>ዎፋኑዋ ጌሻ ዱንካንያ ፐንግያን ጎዳ ስንን ሹካ። <verse eid="EXO 29:11"/><verse number="12" style="v" sid="EXO 29:12"/>ዎፋኑዋ ሱፈ ጉ ኤካዳ ነ ብራያን፥ ያርሾ በሳ ቦላ ደእያ ካጨታ ትያ። አትዳይሳ ያርሾ በሳፈ ጋርሳን ጉሳ። <verse eid="EXO 29:12"/><verse number="13" style="v" sid="EXO 29:13"/>ሄሳፈ ጉየ፥ ኡሎ አሹዋ ካምዳ ሞዋ ኡባ፥ ትርያስ ሎኦ ባጋ፥ ናምኡ ክላሆታነ ኤንታ ካምዳ ሞዋ ኤካዳ፥ ያርሾ በሳ ቦላ ዎዳ ፁጋ። <verse eid="EXO 29:13"/><verse number="14" style="v" sid="EXO 29:14"/>ሽን ዎፋኑዋ ኡሎ አሹዋ፥ እያ ጋልባነ ማራጭያ ጉታፐ ጋፃ ከሳዳ ፁጋ። ሄስ ካህነታ ናጋራ ቁችያ ያርሾ።<verse eid="EXO 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15"/>“ናምኡ ማራዘታፐ እሱዋ ኤካዳ፥ አሮንነ እያ ናይት ባንታ ኩሽያ እያ ሁጰን ዎና መላ ኦ። <verse eid="EXO 29:15"/><verse number="16" style="v" sid="EXO 29:16"/>ሄ ማራዝያ ሹካዳ፥ ሱ ያርሾ በሳን ኦይዱ ማዛነታን ዉርፃ። <verse eid="EXO 29:16"/><verse number="17" style="v" sid="EXO 29:17"/>እያ አሹዋ ቃንፀረዳ፥ ኡሎ አሹዋነ ገዳ ሜጫዳ፥ ሁጵያ ሀራ ቆሞ አሾታራ እስፈ ያርሾ በሳን ዎ። <verse eid="EXO 29:17"/><verse number="18" style="v" sid="EXO 29:18"/>ሄሳፈ ጉየ፥ ኩመ አሹዋ ያርሾ በሳን ፁጋ። ሄስካ ጎዳስ ፁሳ ያርሾ። ሄ ያርሹዋ ሳዎይ ጎዳ ኡፋይሴስ።<verse eid="EXO 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19"/>“ቃስ ካህነተ ዎጋስ ኤከትዳ ሀንኮ ማራዝያ ኤካዳ አሮንነ እያ ናይት ባንታ ኩሽያ እያ ሁጰን ዎና መላ ኦዳ። <verse eid="EXO 29:19"/><verse number="20" style="v" sid="EXO 29:20"/>እያ ሹካዳ፥ ሱፈ ጉ ኤካዳ፥ አሮናስነ እያ ናይታስ ኡሻቻ ሀይታስ ጋፃ፥ ኤንታ ኡሻቻ ኩሽያስነ ቶሁዋስ ዎጋ ብራታ ትያ። አትዳ ሱ ያርሾ በሳ ኦይዱ ማዛነታን ዉርፃ። <verse eid="EXO 29:20"/><verse number="21" style="v" sid="EXO 29:21"/>ያርሾ በሳን ደእያ ሱፈነ ትይያ ዛይትያፐ ጉ ኤካዳ፥ አሮና ቦላነ እያ ማኡዋ ቦላ፥ ቃስካ እያ ናይታ ቦላነ ኤንታ ማኡዋ ቦላ ዉርፃ። ሄሳን አሮንነ እያ ናይት ባንታ ማኡዋራ ታዉ ዱማትዳይሳታ ግዳና።<verse eid="EXO 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22"/>“ሄ ማራዘይ ካህነታ ሹማ ዎጋስ ኤከትያ ግሾ፥ ጎይና ሞዋ፥ ኡሎ አሹዋ ካምዳ ሞዋ፥ ትርያ ካምዳ ሞያ፥ ናምኡ ክላሆታ፥ ኤንታ ካምዳ ሞያነ ኡሻቻ ጉየ ገዳ ቃንፃዳ ሻካ። <verse eid="EXO 29:22"/><verse number="23" style="v" sid="EXO 29:23"/>ጎዳ ስንን ዎዳ ኡይታፐ፥ ዛይተይ ገልቦና ኡይ፥ ዛይተራ ኡክዳ ኡይነ ሌኦ ኡይፈ እሱዋ ኤካ። <verse eid="EXO 29:23"/><verse number="24" style="v" sid="EXO 29:24"/>ኔኒ ሀ ካ ኡባ አሮና ኩሽያንነ እያ ናይታ ኩሽያን ዎ። ኤንቲ እያ ዩሾ ያርሾ ኦድ ጎዳስ እምያ ያርሾ ኦድ ጎዳ ስንን ሺሾ። <verse eid="EXO 29:24"/><verse number="25" style="v" sid="EXO 29:25"/>ሄሳፈ ጉየ፥ ኤንታ ኩሸፐ ኤካዳ ያርሾ በሳ ቦላ ዎ፤ ፁሳ ያርሹዋራ ጋዳ፥ ጎዳ ሳዋና መላ ያርሾ በሳ ቦላ ታማን ፁጋ። <verse eid="EXO 29:25"/><verse number="26" style="v" sid="EXO 29:26"/>አሮን ካህነ ግድድ ሹመትያ ዎደ ሹክዳ ማራዝያ አንጋሱዋ ኤካዳ፥ ጎዳ ስንን ዩሾ ያርሾ ኦ። ሄስ ህንተና ጋክያ ግሾ ግዳና።<verse eid="EXO 29:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 29:27"/>“ካህነይ ሹመትያ ዎደ፥ አሮናነ እያ ናይታ ካህነተን ሹማናዉ ኤከትዳ አንጋሱዋነ ቶሆ አሹዋ ታዉ ዱማያ። ሄስካ፥ ካህነታ ጋክያ ግሾ ግዶ። <verse eid="EXO 29:27"/><verse number="28" style="v" sid="EXO 29:28"/>እስራኤለት ኡባይ ካህነ ሹማናዉ ዎይኮ አንጀታናዉ ጎዳስ አንጋሶነ ጉየ ቶሆ ያርሾ እምያ ዎደ አሾይ ታዉ ዱማትዳይሳ ግዶ። ሽን ግሾይ አሮናስነ እያ ናይታስ ጋኮ፤ ሄ ዎጋይ ላመቶፎ።<verse eid="EXO 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29"/>“አሮን ሀይቅዳ ዎደ እያ ናይት እያ ካህነተ ማኡዋ ላቶ። ኤንቲ ካህነተን ሹመትዳፐ ጉየ ሄ ማኡዋ ማኦ። <verse eid="EXO 29:29"/><verse number="30" style="v" sid="EXO 29:30"/>እያ ናይታፐ እያ በሳን ካህነ ግድድ፥ ጌሻ በሳን ሀጋዛናዉ ጌሻ ዱንካንያ ይያ ናእ ሄ ማኡዋ ላፑን ጋላስ ማኦ።<verse eid="EXO 29:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31"/>“አሮንነ እያ ናይት ካህነ ግድድ ሹመትያ ዎደ ሹከትዳ ማራዝያ አሹዋ ኤካዳ፥ ጌሻ በሳን ካ። <verse eid="EXO 29:31"/><verse number="32" style="v" sid="EXO 29:32"/>አሮንነ እያ ናይት ማራዝያ አሹዋ ጋይታን አትዳ ኡይራ ጌሻ ዱንካንያ ፐንገን ሞ። <verse eid="EXO 29:32"/><verse number="33" style="v" sid="EXO 29:33"/>ኤንቲ ካህነ ግድድ ሹመትያ ዎደ ናጋራ አቶተስ ያርሸትዳ ሄ አሹዋ ሞና። ሽን ሄ ካይ ጌሽ ግድዳ ግሾ፥ ካህነታ ፃላል ሞ፤ ሀራ አስ ኦንካ ሞፖ። <verse eid="EXO 29:33"/><verse number="34" style="v" sid="EXO 29:34"/>አሹዋፐነ ካፈ ምሽን አትድ አቅኮ፥ ታማን ፁገቶ፤ ጌሽ ግድዳ ግሾ ሜተቶፎ።<verse eid="EXO 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 29:35"/>“አሮንነ እያ ናይት ካህነ ግድድ ሹመትያ ዎደ፥ ታ ነና ኪትዳ ኡባ ኦ፤ ባለይ ላፑን ጋላሳን ፖለቶ። <verse eid="EXO 29:35"/><verse number="36" style="v" sid="EXO 29:36"/>ናጋራ አቶተስ እስ እስ ጋላሳን እስ ዎፋኖ ሹካዳ ያርሻ። ሄስ ያርሾ በሳ ጌሼስ። ያታዳ ያርሾ በሳ ፖሎ ጌሻናዉ ሻማሆ ዛይተ ትያ። <verse eid="EXO 29:36"/><verse number="37" style="v" sid="EXO 29:37"/>ሄሳ ላፑን ጋላስ ጋካናዉ ጋላስ ጋላስ ኦ። ያትኮ ያርሾ በሳይ ፖሎ ጌሽ ግዳና። እ ፖሎ ጌሽ ግድዳ ግሾ፥ እያ ቦችያ አስ ዎይኮ ሀራባ ኡባይ ጌያና።<verse eid="EXO 29:37"/></para>
  <para style="s1">ጋላሳ ያርሾ</para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38"/>“ላይን ላይን ያርሾ በሳን ጋላስ ጋላስ እስ ላይ ግድዳ ናምኡ ማራዘታ ያርሻ። <verse eid="EXO 29:38"/><verse number="39" style="v" sid="EXO 29:39"/>ማራዘታፐ እሱዋ ዎንታ፥ ቃስ ሀንኩዋ ኦማርስ ያርሻ። <verse eid="EXO 29:39"/><verse number="40" style="v" sid="EXO 29:40"/>ኮይሮ ማራዝያራ እስ ክሎ ግራመ ግድያ ጌሻ ሎኦ ግስተ ለ፥ እስ ልትሮ ሻማሆ ዛይተራ ግንዳዳ ያርሻ። እስ ልትሮ ዎይነ ኡሻ ያርሾ ኦዳ ጉሳ። <verse eid="EXO 29:40"/><verse number="41" style="v" sid="EXO 29:41"/>ሀንኮ ማራዝያ ኦማርስ ያርሻሸ ዎንታ ያርሾይሳ መላ ለ፥ ዛይተነ ዎይነ ኡሻ ሺሻ። ሄስ ታዉ ያርሸትያ ካ ያርሾ፤ እያ ሳዎይ ታና ኡፋይሰይሳ ግዳና።<verse eid="EXO 29:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 29:42"/>“ላይን ላይን ሄ ፁሳ ያርሾይ ጌሻ ዱንካንያ ፐንገን፥ ጎዳ ስንን ፓጭ ባይና ያሸታናዉ በሴስ። ሄ በሳን ታኒ ታ ደርያራ ጋሄታና፤ ኔራካ ያን ኦደታና። <verse eid="EXO 29:42"/><verse number="43" style="v" sid="EXO 29:43"/>ያን ታኒ እስራኤለታራ ጋሄታና፤ ታ ቦንቾይ ሄ በሳ ዱማያና። <verse eid="EXO 29:43"/><verse number="44" style="v" sid="EXO 29:44"/>ታኒ ጌሻ ዱንካንያነ ያርሾ በሳ ዱማያና፤ ኤንቲ ታዉ ካህነ ግድድ ሀጋዛና መላ አሮናነ እያ ናይታ ዱማያና። <verse eid="EXO 29:44"/><verse number="45" style="v" sid="EXO 29:45"/>ያታዳ፥ ታኒ እስራኤለታ ግዶን ዳና፤ ኤንታ ፆሳ ግዳና። <verse eid="EXO 29:45"/><verse number="46" style="v" sid="EXO 29:46"/>ኤንታ ግዶን ዳናዉ ግብፀፈ ኤንታ ከስዳ ጎዳይ፥ ኤንታ ፆሳይ ታና ግደይሳ ኤንቲ ኤራና። ታኒ ጎዳ፥ ኤንታ ፆሳ።<verse eid="EXO 29:46"/></para>
  <chapter eid="EXO 29"/>
  <chapter number="30" style="c" sid="EXO 30"/>
  <para style="s1">እፃነ ያርሽያ በሲ</para>
  <para style="r">(<ref loc="EXO 37:25-28">ከሳ 37:25-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1"/>“እፃነ ጩይስያ በሳ ሶቃላ ምፈ መ። <verse eid="EXO 30:1"/><verse number="2" style="v" sid="EXO 30:2"/>እያዉ ኦይዱ ማዛነይ ደኦ። አዱሳተይነ ጎምፓይ እስ እስ ዋ፥ ጌሳይ ናምኡ ዋ ግዶ። ኦይዱ ማዛንያን ደእያ ካጨት እያራ ኦይከትድ ኦሰቶና። <verse eid="EXO 30:2"/><verse number="3" style="v" sid="EXO 30:3"/>እያዉ ቦላ ባጋ፥ እያ ኦይዱ ማዛነታነ እያ ካጨታ ዋላህ ባይና ዎርቃን ላንፃ። እያ ዩሹዋካ ዎርቃን ላንፃ። <verse eid="EXO 30:3"/><verse number="4" style="v" sid="EXO 30:4"/>ናምኡ ዎርቃ ሳጋዮታ ኦዳ፥ ፃርጴዛ ቶካናዉ ማድያ ካሶ ምታ አናዉ ጎሳስ ናምኡ ባጋራ ኦይ። <verse eid="EXO 30:4"/><verse number="5" style="v" sid="EXO 30:5"/>ካሶ ምታ ሶቃላ ምፈ ከሳዳ፥ ኤንታ ዎርቃን ላንፃ። <verse eid="EXO 30:5"/><verse number="6" style="v" sid="EXO 30:6"/>ሄ እፃነ ያርሾ ፃርጴዛ፥ ጫቆ ታቦትያ ስንን ካቀትዳ ማጋራጁዋፈ ካረ ባጋራ ዎ። ያን ታኒ ኔራ ጋሄታና።<verse eid="EXO 30:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 30:7"/>“አሮን ዎንታ ዎንታ ፆምፐታ ጊግሳናዉ ይያ ዎደ፥ ሳውያ እፃነ ያርሽያ በሳን ጩይሶ። <verse eid="EXO 30:7"/><verse number="8" style="v" sid="EXO 30:8"/>ሄሳዳ፥ አሮን ኦማርስ ፆምፐታ ፆምፕያ ዎደካ እፃነ ጩይሶ። ሄ እፃንያ ያርሾይ ያና ላይ ኡባን ጎዳ ስንን ጩዮ። <verse eid="EXO 30:8"/><verse number="9" style="v" sid="EXO 30:9"/>ሀ ያርሾ በሳን ሀራ ድገትዳ እፃነ፥ ካ ያርሾ፥ መሄ ያርሾነ ዎይነ ያርሾ ያርሾፋ። <verse eid="EXO 30:9"/><verse number="10" style="v" sid="EXO 30:10"/>አሮን፥ ናጋራ አቶተስ ላይፈ እስ ቶሆ ሹከትያ መህያ ሱፈ ኤክድ፥ ሄ ያርሾ በሳ ማዛነታ ቦላ ደእያ ካጨታ ዎድ ጌሾ ዎጋ ፖሎ። ሀ ዎጋይ ስንራ ያና ዎደ ኡባን ላይን ላይን ፖለቶ። ሄ ያርሾ በሳይ ጌሽ ግድያ ግሾ ጎዳስ ዱማትስ” ያግስ።<verse eid="EXO 30:10"/></para>
  <para style="s1">ናጋራ አቶተ ሚሸ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11"/>ሄሳፈ ጉየ፥ ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="EXO 30:11"/><verse number="12" style="v" sid="EXO 30:12"/>“ኔኒ እስራኤለ አሳ ታይብያ ዎደ፥ እስ እስ አስ ባ ሸምፑዋ ዎዛናዉ ጎዳስ ሚሸ ቃንፆ። ያትኮ ኔኒ ኤንታ ታይብያ ዎደ ጋዶይ ኤንታ ቦላ ዬና። <verse eid="EXO 30:12"/><verse number="13" style="v" sid="EXO 30:13"/>ታይቦን ገልያ አስ ኦንካ ሁጰን ሁጰን ጌሻ ዱንካነን ኤረትዳ ምዛነ ግናን ብራ ጭጎ። እስ እስ አስ ሄሳ ታዉ ያርሾ ኦድ እሞ። <verse eid="EXO 30:13"/><verse number="14" style="v" sid="EXO 30:14"/>ታይቦን ገልያ አስ ኦንካ ላይ ላታማነ እያፐ ቦላ ግድዳ ኡባይ ጎዳስ ሄሳ ኤሆ። <verse eid="EXO 30:14"/><verse number="15" style="v" sid="EXO 30:15"/>ኤንቲ ባንታ ሸምፑዋ ዎዛናዉ ጎዳስ እሞታ እምያ ዎደ፥ ዱረይካ ማንቆይካ እስ ግና እሞፈ አትሽን፥ ዱረይ ዳርስድ ዎይኮ ማንቆይ ጉድ እሞፎ። <verse eid="EXO 30:15"/><verse number="16" style="v" sid="EXO 30:16"/>ሄ ሚሽያ እስራኤለ አሳፐ ኤካዳ፥ ጌሻ ዱንካንያ ናጋናዉ ፔሻ። ሄ ሚሸይ ኤንታ ሸምፑዋ ዎዛናዉነ ታ ኤንታ ናጋና መላ ቆፍስያባ ግዳና” ያግስ።<verse eid="EXO 30:16"/></para>
  <para style="s1">ሜቻ ከረ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="EXO 30:17"/><verse number="18" style="v" sid="EXO 30:18"/>“ሜቻ ከርያነ እያ ቶሁዋ ናሰ ብራታፐ መ። እያን ሃ ትጋዳ ጌሻ ዱንካንያፐነ ያርሾ በሳፈ ግዶን ዎ።<note caller="-" style="x"><char style="xo" closed="false">30:18 </char><char style="xt" closed="false"><ref loc="EXO 38:8">ከሳ 38:8</ref>.</char></note> <verse eid="EXO 30:18"/><verse number="19" style="v" sid="EXO 30:19"/>አሮንነ እያ ናይት ባንታ ኩሽያነ ባንታ ቶሁዋ ያን ሜጨቶ። <verse eid="EXO 30:19"/><verse number="20" style="v" sid="EXO 30:20"/>ኤንቲ ጌሻ ዱንካንያ ገላናፐነ ያርሾ ያርሻናፐ ስን ሄሳ ኦናዉ በሴስ። ሄሳ ኤንቲ ኦኮ ሀይቆፐ አቶሶና። <verse eid="EXO 30:20"/><verse number="21" style="v" sid="EXO 30:21"/>ኤንቲ ሀይቆና መላ፥ ባንታ ኩሽያነ ባንታ ቶሁዋ ሜጨታናዉ በሴስ። ሄስ አሮናስነ እያ ሼሻታስ፥ ይያ የለተ ኡባስ መርና ዎጋ ግዳና” ያግስ።<verse eid="EXO 30:21"/></para>
  <para style="s1">ሹማተ ዛይተ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="EXO 30:22"/><verse number="23" style="v" sid="EXO 30:23"/>“ጌሻ ሳዎታ፥ ሄሳትካ፤ ኡሱፑን ክሎ ግራመ ጉክያ ካርበ፥ ሄ ክሎ ግራመ ሳውያ ቃራፋ፥ ሄ ክሎ ግራመ ሳውያ ማታ፥ <verse eid="EXO 30:23"/><verse number="24" style="v" sid="EXO 30:24"/>ኡሱፑን ክሎ ግራመ ቡርጉደ ኤካ። ሄ ኡባይካ ጌሻ ዱንካነን ኤረትዳ ምዛንያ ግና ግዶ። ሄሳታ ቦላ ኦይዱ ልትሮ ዛይተ ጉጃ። <verse eid="EXO 30:24"/><verse number="25" style="v" sid="EXO 30:25"/>ሄሳታ ሽቶዳ ዋላካዳ፥ ሳውያ ጌሻ ዛይተ ኦዳ፥ <verse eid="EXO 30:25"/><verse number="26" style="v" sid="EXO 30:26"/>ጌሻ ዱንካንያነ ጫቆ ታቦትያ ትያ። <verse eid="EXO 30:26"/><verse number="27" style="v" sid="EXO 30:27"/>ፃርጴዛነ እያ ሚሸታ፥ ፆምፐ ዎያ ኮጫነ እያ ሚሸታ፥ እፃነ ጩይስያ ፃርጴዛ፥ <verse eid="EXO 30:27"/><verse number="28" style="v" sid="EXO 30:28"/>ፁሳ ያርሾ በስነ እያን ቦላ ደእያ ሚሸታ ኡባ፥ ሜቻ ከርያነ እያ ቶሁዋ ትያ። <verse eid="EXO 30:28"/><verse number="29" style="v" sid="EXO 30:29"/>ኤንቲ ፖሎ ጌሽ ግዳና መላ ኤንታ ዱማያ። ኤንታ ቦችያ ኦንካ ጌሽ ግዳና።<verse eid="EXO 30:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 30:30"/>“ሄሳፈ ጉየ፥ አሮንነ እያ ናይት ካህነ ግድድ ታዉ ሀጋዛና መላ ኤንታ ትያዳ ዱማያ። <verse eid="EXO 30:30"/><verse number="31" style="v" sid="EXO 30:31"/>እስራኤለ አሳስ፥ ‘ሀይስ ጌሻ ሹማተ ዛይተይ ይያ የለተስ ታና ሀጋዛናዉ ማድያ ዛይተ ግዶ። <verse eid="EXO 30:31"/><verse number="32" style="v" sid="EXO 30:32"/>ሄ ዛይትያ ጮ አሳ ቦላ ጉሶፋ፤ ቃስ አይ ዛይተካ እያ ኦዳ ኦግያን ኦፋ። ዛይተይ ጌሽ ግድዳ ግሾ፥ ህንተካ እያ ጌሻተ ኤርተ። <verse eid="EXO 30:32"/><verse number="33" style="v" sid="EXO 30:33"/>ሄ ሽቱዋ ጊግስያ አስ፥ ዎይኮ ካህነ ግዶና ሀራ አስ ትይያ ኦንካ ታ አሳ ግዶፈ ህለቶ’ ያጋ” ያግስ።<verse eid="EXO 30:33"/></para>
  <para style="s1">እፃነ</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ “ጌሻ ሳዎታ፥ ፆክያ ም ማደ፥  ኬን ደእያ ሽቶ፥ ሳውያ ማደነ ሳውያ እፃነ ኤካ፤ ኤንታ ኡባ ምዛነይ እስ ግና ግዶ። <verse eid="EXO 30:34"/><verse number="35" style="v" sid="EXO 30:35"/>ሽቶዳ ዋላሄትዳ እፃነ ኦዳ ኤንታ ጎኤታ። ዋላህ ባይናነ ጌሽ ግዳና መላ እያን ማፅነ የጋ። <verse eid="EXO 30:35"/><verse number="36" style="v" sid="EXO 30:36"/>እያፐ ጉራ ኤካዳ ሊቅሳ ጫዳዳ፥ ታኒ ኔራ ጋሄትያ ጌሻ ዱንካንያ ግዶን፥ ጫቆ ታቦትያ ስንን ዉርፃ። ሄ እፃነይ ነዉ ፖሎ ጌሽ ግዶ። <verse eid="EXO 30:36"/><verse number="37" style="v" sid="EXO 30:37"/>ህንተዉ ጎኤታናዉ ሄ እፃንያ አይ ኦገንካ ጊግሶፕተ። ሄስ ታዉ ዱማትዳይሳ ግደይሳ ኤርተ። <verse eid="EXO 30:37"/><verse number="38" style="v" sid="EXO 30:38"/>ሄሳ ኦድ፥ እያ ሳዉዋ ስንግድ ኡፋይታናዉ ኮይያ ኦንካ፥ ታ አሳ ግዶፈ ያና” ያግስ።<verse eid="EXO 30:38"/></para>
  <chapter eid="EXO 30"/>
  <chapter number="31" style="c" sid="EXO 31"/>
  <para style="s1">ባስልኤላነ ኤልያባ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="EXO 31:1"/><verse number="2" style="v" sid="EXO 31:2"/>“ታኒ ይሁዳ ሼሻፐ ግድዳ ሁራ ናኣ ናኣ፥ ኡረ ናኣ፥ ባስልኤላ ዶራስ። <verse eid="EXO 31:2"/><verse number="3" style="v" sid="EXO 31:3"/>ታኒ እያ ታ አያናን ኩንስ፤ ታኒ ሂላ፥ አኬካነ ኦሶ ኡባ ኦያ ኤራ እያዉ እማስ። <verse eid="EXO 31:3"/><verse number="4" style="v" sid="EXO 31:4"/>ሄስካ፥ ሂላን ኦና ኦሶታ ሀልችድ ዎርቃፈ፥ ብራፐነ ናሰ ብራታፐ ዱማ ዱማባ ከስድ ኦናሳ። <verse eid="EXO 31:4"/><verse number="5" style="v" sid="EXO 31:5"/>ሄሳዳካ፥ አልኦ ሹቹ ማስድ ጊግሰይሳ፥ ም ማሰይሳነ ሀራ ኦሶ ኡባ ኦና መላ ጭንጫተ እማስ። <verse eid="EXO 31:5"/><verse number="6" style="v" sid="EXO 31:6"/>ቃስ እያ ማዳና መላ ዳነ ሼሽ ግድዳ አህሳማካ ናኣ ኤልያባ ዶራስ። ታኒ ነና ኪትዳባ ኡባ ኤንቲ ኦና መላ ኩሸ ሂላ ኤርያ ሀራታ ኡባስ ግታ ኤራተ እማስ። <verse eid="EXO 31:6"/><verse number="7" style="v" sid="EXO 31:7"/>ኤንቲ ኦናባት፥ ጌሻ ዱንካንያ፥ ጫቆ ታቦትያ፥ እያ ቦላ ዎያ ናጋራ አቶተ ካማ፥ ዱንካንያ ግዶን ጎኤትያ ሚሸ ኡባ፥ <verse eid="EXO 31:7"/><verse number="8" style="v" sid="EXO 31:8"/>ፃርጴዛነ እያ ሚሸታ፥ ዋላህ ባይና ዎርቃፈ ኦሰትዳ ፆምፐ ዎያ ኮጫነ እያ ሚሸ ኡባ፥ እፃነ ጩይስያ ፃርጴዛ፥ <verse eid="EXO 31:8"/><verse number="9" style="v" sid="EXO 31:9"/>ፁሳ ያርሾ በስነ እያ ሚሸ ኡባ፥ ሜቻ ከርያነ እያ ቶሁዋ፥ <verse eid="EXO 31:9"/><verse number="10" style="v" sid="EXO 31:10"/>አሮንነ እያ ናይት ካህነተን ሀጋዝሸ ማእያ ካህነተ ማኡዋ፥ <verse eid="EXO 31:10"/><verse number="11" style="v" sid="EXO 31:11"/>ሹማተ ዛይትያነ ጌሻ በሳስ ሀንያ ሳውያ እፃንያ፥ ታኒ ነና ኪትዳይሳዳ ኤንቲ ኦና” ያግስ።<verse eid="EXO 31:11"/></para>
  <para style="s1">ሳምባታ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12"/>ጎዳይ ሙሰ ሀይሳዳ ያግድ ኪትስ፤ <verse eid="EXO 31:12"/><verse number="13" style="v" sid="EXO 31:13"/>“እስራኤለ አሳ፥ ‘ታ ሳምባታ ናግተ። ሄስ ታኒ፥ ጎዳይ፥ ህንተና ታዉ ጌሻ ደረ ኦዳ ዶርዳይሳ በሲያ ማላ ግድድ፥ ያና የለተ ኡባስ ታፐነ ህንተፈ ግዶን ደኦ። <verse eid="EXO 31:13"/><verse number="14" style="v" sid="EXO 31:14"/>ሄ ጋላሳይ ጌሽ ግድያ ግሾ፥ እያ ቦንችተ። ሳምባታ ቦንቾናይነ ሄ ጋላሳን ኦሶ ኦያ ኦንካ ታ አሳ ግዶፈ ዮ ዎይኮ ሀይቆ። <verse eid="EXO 31:14"/><verse number="15" style="v" sid="EXO 31:15"/>ህንተ ኦሶ ኦናዉ በሲያ ኡሱፑን ጋላሳት ደኦሶና። ሽን ላፑን ጋላሳይ ጎዳስ ዱማትዳ፥ ሸምፖ ጋላስ። ሳምባታ ጋላሳን ኦሶ ኦያ ኦንካ ሀይቆ። <verse eid="EXO 31:15"/><verse number="16" style="v" sid="EXO 31:16"/>እስራኤለ የለተ ኡባይ ሀ ሳምባታ ጋላሳ መርና ጫቆ ማላ ኦድ ቦንቾ። <verse eid="EXO 31:16"/><verse number="17" style="v" sid="EXO 31:17"/>ታኒ ኡሱፑን ጋላሳን ሳሉዋነ ሳኣ መዳ ግሾነ ላፑን ጋላሳን ኦሶ አጋዳ ሸምፕዳ ግሾ፥ ታ ግዶንነ እስራኤለታ ግዶን ሄስ መርናዉ ኤቅድ ደእያ ማላ ግዳና’ ያጋ” ያግስ።<verse eid="EXO 31:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 31:18"/>ጎዳይ ሙሰ ሲና ዙማ ቦላ ኦድሰይሳ ኦንግዳ ዎደ፥ እ ባ ብራን ፃፍዳ ታሙ ኪታታ ኦይክዳ ናምኡ ሎቸ ሹቻታ ሙሰስ እሚስ።<verse eid="EXO 31:18"/></para>
  <chapter eid="EXO 31"/>
  <chapter number="32" style="c" sid="EXO 32"/>
  <para style="s1">ዎርቃ ማራ ምስለ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1"/>አሳይ፥ ሙሰይ ዙማ ቦላፈ ዎናዉ ጋምእዳይሳ በእዳ ዎደ አሮናኮ ይድ፥ “ኑና ካለሸ ናጋና ፆሳታ ኑስ ኦ። ግብፀ ቢታፈ ኑና ከስዳ ሙሰይ ዋንዳኮ ኤሮኮ” ያግዶሶና። <verse eid="EXO 32:1"/><verse number="2" style="v" sid="EXO 32:2"/>አሮን ኤንታኮ፥ “ህንተ ማቸታ፥ ህንተ አደ ናይታነ ህንተ ማጫ ናይታ ሀይን ደእያ ዎርቃ ከስድ፥ ታዉ ሃ ኤክድ ዪተ” ያግስ። <verse eid="EXO 32:2"/><verse number="3" style="v" sid="EXO 32:3"/>አሳ ኡባይ ባንታ ሀይ ዎርቃ ከስድ፥ አሮናስ ኤህዶሶና። <verse eid="EXO 32:3"/><verse number="4" style="v" sid="EXO 32:4"/>እ ሄሳ ኤንታፈ ኤክድ፥ ታማን ሼሽዳፐ ጉየ፥ ቆፅድ፥ ዎርቃ ማራ ምስለ ኦድ መስ።</para>
  <para style="p" vid="EXO 32:4">ኤንቲ፥ “እስራኤለቶ፥ ኑና ግብፀ ቢታፈ ካለድ ከስዳ ኑ ፆሳት ሀይሳታ” ያግዶሶና። <verse eid="EXO 32:4"/><verse number="5" style="v" sid="EXO 32:5"/>አሮን ሄሳ በእዳ ዎደ፥ ሄ ማራ ስንን ያርሾ በሰ ጊግስድ፥ “ዎንቶ ጎዳ ቦንችያ ባኣለ ጋላስ ግዳና” ያግድ ኤርስስ። <verse eid="EXO 32:5"/><verse number="6" style="v" sid="EXO 32:6"/>ዎንተ ጋላስ ጉራ አሳይ ደንድድ፥ ፁሳ ያርሾነ እስፈተ ያርሾ ያርሽዶሶና። ያትድ፥ አሳይ ማናዉነ ኡያናዉ ኡትዶሶና። ም ኡይ ስሚድ፥ ዱራናዉነ ፖኮባ ሀናናዉ ደንድዶሶና።<verse eid="EXO 32:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7"/>ጎዳይ ሙሰኮ፥ “ኔኒ ግብፀፈ ከሳዳ፥ ኤህዳ ነ አሳይ ናጋራ ኦድ፥ ባንታና ቱንስዳ ግሾ ኤለሳዳ ዱገ ዎ። <verse eid="EXO 32:7"/><verse number="8" style="v" sid="EXO 32:8"/>ታኒ ኤንታ ኪትዳ ኦግያፐ ኤንቲ ኤለስድ ሽረትዶሶና። ዎርቃ ሼሽድ ማራ ምስለ ኦድ፥ ባንታዉ ኤቃ መድ እያ ጎይንዶሶና። እያዉ ያርሽድ፥ ‘ኑና ግብፀ ቢታፈ ከስዳ ኑ ፆሳይ ሀይሳ’ ያግዶሶና። <verse eid="EXO 32:8"/><verse number="9" style="v" sid="EXO 32:9"/>ጎዳይ ሙሰኮ፥ ሀ አሳይ አይ መላ ዎዛና ሙመኮ ታ በአስ። <verse eid="EXO 32:9"/><verse number="10" style="v" sid="EXO 32:10"/>ሀእ ታ ሀንቆይ ኤንታ ቦላ ኤፅን፥ ታኒ ኤንታ ይሳናዉ ጊገትዳ ግሾ፥ ኔኒ ታና ድጎፋ። ያታዳ፥ ታኒ ነና ግታ ደረ ኦና” ያግስ።<verse eid="EXO 32:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11"/>ሽን ሙሰይ ባ ጎዳ፥ ፆሳ ሀይሳዳ ያግድ ዎስስ፤ “አቤት ጎዳዉ፥ ኔኒ ነ ግታ ዎልቃንነ ነ ምኖ ኩሽያን ግብፀፈ ከሳዳ ኤህዳ ነ አሳ ቦላ ነ ሀንቆይ አይስ ኤፂ?<note caller="-" style="x"><char style="xo" closed="false">32:11 </char><char style="xt" closed="false"><ref loc="NUM 14:13-19">ታይቦ 14:13-19</ref>.</char></note> <verse eid="EXO 32:11"/><verse number="12" style="v" sid="EXO 32:12"/>ነ ሄሳ ኦያባ ግድኮ፥ ግብፀት፥ ‘ጎዳይ ኤንታና ደረታ ቦላ ዎናዉነ ቢታፈ ፕትድ ይሳናዉ ከስስ’ አይስ ጋኔ? ነ ያሽያ ሀንቁዋፈ ስማ። ነ አሳ ይሳናዉ ቆፕዳይሳ አጋ። <verse eid="EXO 32:12"/><verse number="13" style="v" sid="EXO 32:13"/>ነ አይለታ አብራሃመ፥ ይሳቃነ ያይቆባ ሀሳያ። ኔኒ ኤንታዉ፥ ‘ታኒ ህንተ ሼሻ ሳሎ ፆልንቶዳ ዳርሳና፤ ታኒ ህንተዉ እማና ግዳ ሀ ቢታ ኡባ ህንተ ሼሻታስ እማና፤ ኤንቲ ሄ ቢታ መርናዉ ላታና’ ጋዳ ነ ሁጰን ነ ጫቅዳ ጫቁዋ ቆፓ” ያግስ። <verse eid="EXO 32:13"/><verse number="14" style="v" sid="EXO 32:14"/>ሄሳ ግሾ፥ ጎዳይ ባ ደርያ ቦላ ኢታባ ኤሀናዉ ቆፕዳይሳ አግድ፥ ኤንታ ማርስ።<verse eid="EXO 32:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15"/>ሙሰይ ናምኡ ባጋራ ፃፈትዳ፥ ታሙ ኪታት ደእያ ናምኡ ሎቸ ሹቻታ ባ ኩሸን ኦይክድ፥ ዙማፐ ዱገ ዎስ። <verse eid="EXO 32:15"/><verse number="16" style="v" sid="EXO 32:16"/>ሄ ማሰትዳ ሹቻታ ጊግስዳይ ፆሳ፤ ሹቻታ ቦላ ዎጭድ ፃፍዳይካ ፆሳ።<verse eid="EXO 32:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17"/>እያሱይ አሳ ኮሽንቻ ስእዳ ዎደ፥ ሙሰኮ፥ “አሳይ ሲራትዳ በሳን ኦላ ዋሶይ ስኤቴስ” ያግስ።<verse eid="EXO 32:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18"/>ሙሰይ ዛሪድ፥ “ሀይስ ፆንዳ አሳ ጬቆ ዎይኮ ፆነትዳ አሳ ዬሆ ግዶናሽን፥ የ ዋሶ” ያግስ።<verse eid="EXO 32:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 32:19"/>ሙሰይ ጉታኮ ማትዳ ዎደ ማራነ ዱርሳ በእድ ዳሮ ሀንቀትስ። ሄ ዎደ ባ ኩሸን ኦይክድ ይዳ፥ ማሰትዳ ሹቻታ ዙማ ፃጶን ሆልድ መንረስ። <verse eid="EXO 32:19"/><verse number="20" style="v" sid="EXO 32:20"/>ኤንቲ መዳ ማራ ኤክድ፥ ታማን ፁግስ። ሄሳፈ ጉየ፥ ሊቃና ጋካናዉ ጋጭድ ሃራ ማድ፥ እስራኤለ አሳይ ኡያናዳ ኦስ።<verse eid="EXO 32:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 32:21"/>ሙሰይ አሮናኮ፥ “ሀ አሳይ ነዉ አይ ኦን፥ ኤንታ ሀይሳ መላ ኢታ ናጋራ ባንታ ቦላ ኦና መላ ኦዲ?” ያግስ።<verse eid="EXO 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 32:22"/>አሮን ዛሪድ፥ “ታ ጎዳዉ፥ ታና ሀንቀቶፋ። ሀ አሳይ ኢታባ ኦናዉ አይ መላ ኮያኮ ነ ኤራሳ። <verse eid="EXO 32:22"/><verse number="23" style="v" sid="EXO 32:23"/>ኤንቲ፥ ‘ኑና ግብፀፈ ከስድ ኤህዳ፥ ሙሰይ ዋንዳኮ ኑ ኤሮኮ። ሄሳ ግሾ፥ ካለያ ፆሳታ ኑስ ኦ’ ያግዶሶና። <verse eid="EXO 32:23"/><verse number="24" style="v" sid="EXO 32:24"/>ታኒ ኤንታኮ፥ ‘ህንተ ሀይን ደእያ ዎርቃ ከስድ፥ ሀምተ’ ያጋስ። ኤንቲ ታዉ እምዳ ዎርቃ ታኒ ታማን የግን፥ ሀ ማራ ምስለይ ከይስ” ያግስ።<verse eid="EXO 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25"/>አሮን አሳ ጮ የድ አግን፥ አሳይ ባ ሞርከታ ስንን ካዉይድ፥ ካትዳይሳ ሙሰይ በእስ። <verse eid="EXO 32:25"/><verse number="26" style="v" sid="EXO 32:26"/>ሄሳ ግሾ፥ ሙሰይ ጉታ ገልያ ፐንግያን ኤቅድ፥ “ጎዳ ባጋ ግድያ አስ ኦንካ ታኮ ዮ” ያግስ። ሄ ዎደ ሌወት ኡባይ እያኮ ሺቅዶሶና።<verse eid="EXO 32:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 32:27"/>እ፥ ኤንታኮ፥ “ጎዳይ፥ እስራኤለ ፆሳይ፥ ህንተ እሶይ እሶይ ህንተ ማሻ ሾድድ፥ ጉታስ ሀ ፐንገፈ ህን ፐንገ ጋካናዉ ብድ፥ ህንተ እሻታ፥ ህንተ ላገታነ ህንተ ሾሮታ ዎተ” ያግስ። <verse eid="EXO 32:27"/><verse number="28" style="v" sid="EXO 32:28"/>ሌወት ሙሰይ ኪትዳይሳዳ ኦድ፥ ሄ ጋላስ ሄ ሙኩሉ ግድያ አሳ ዎዶሶና። <verse eid="EXO 32:28"/><verse number="29" style="v" sid="EXO 32:29"/>ሙሰይ ሌወታኮ፥ “ሀች ህንተ፥ ህንተ ናይታነ ህንተ እሻታ ዎናዉ ኪተትድ ህንተና ጎዳስ ዱማይደታ። ጎዳይ ህንተና አንጅስ” ያግስ።<verse eid="EXO 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30"/>ዎንተ ጋላስ ሙሰይ አሳኮ፥ “ህንተ ኢታ ናጋራ ኦደታ፤ ሽን ሀእ ታኒ ጎዳኮ ዙማ ቦላ ከያዳ፥ ኦን ኤር ህንተ ናጋራስ አቶተ ደሞና አግከ” ያግስ። <verse eid="EXO 32:30"/><verse number="31" style="v" sid="EXO 32:31"/>ያትን ሙሰይ ጎዳኮ ስሚድ ብድ፥ “ሀ አሳይ ኢታ ናጋራ ኦዶሶና፤ ኤንቲ ባንታዉ ዎርቃፈ ፆሰ መዶሶና። <verse eid="EXO 32:31"/><verse number="32" style="v" sid="EXO 32:32"/>ሽን ሀያና፥ ሀእ ኤንታ ናጋራ አቶ ያጋ። ሄስ ሀኖናባ ጊኮ፥ ነ አሳ ነ ፃፍዳ ማዝጋብያፐ ታ ሱን ቁቻ” ያግስ።<verse eid="EXO 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 32:33"/>ጎዳይ ዛሪድ ሙሰኮ፥ “ታኒ ታ ማዝጋብያፐ ቁቻና አሳ ሱንይ፥ ታ ቦላ ናጋራ ኦዳይሳታ ሱን። <verse eid="EXO 32:33"/><verse number="34" style="v" sid="EXO 32:34"/>ሀእ ባዳ፥ ሀ አሳ ታኒ ነዉ ኦድዳ በሳ ካለ። ታ ኪታንቾይካ ነና ካለናይሳ አኬካ፥ ሽን ታኒ ሀ አሳ ኤንታ ናጋራ ግሾ ሴራና ዎደይ ያናይስ አተና” ያግስ።<verse eid="EXO 32:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35"/>አሮን ዎርቃፈ ማራ ምስልያ መናዳ ኦዳይ አሳ ግድያ ግሾ፥ ጎዳይ አሳ ቦላ ዎልቃማ ጋዶ የድስ።<verse eid="EXO 32:35"/></para>
  <chapter eid="EXO 32"/>
  <chapter number="33" style="c" sid="EXO 33"/>
  <para style="s1">እስራኤለ አሳይ ሲና ዙማፐ ደንዱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1"/>ሄሳፈ ጉየ፥ ጎዳይ ሙሰኮ፥ “ኔንነ ነ ግብፀፈ ከስዳ አሳይ ሀ በሳፈ ደንድድ፥ ታኒ አብራሃመስ፥ ይሳቃስ፥ ያይቆባስነ ኤንታ ሼሻታስ እማና ያጋዳ ጫቅዳ ቢታ ቢተ። <verse eid="EXO 33:1"/><verse number="2" style="v" sid="EXO 33:2"/>ታኒ ህንተ ስንን ኪታንቹዋ ኪታና። ካናነታ፥ አሞረታ፥ ህተታ፥ ፓርዘታ፥ ህወታነ ያቡሰታ ታኒ ጎዳዳ ከሳና። <verse eid="EXO 33:2"/><verse number="3" style="v" sid="EXO 33:3"/>ማነ ኤስ ጎግያ ሄ ቢታ ቢተ። ሽን ህንተ፥ ዎዛን ሙምዳ አስ ግድያ ግሾ ታ ህንተና ኦገን ይሶና መላ ህንተራ ቢከ” ያግስ።<verse eid="EXO 33:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4"/>አሳይ ሄ ያሽያ ኦዳ ስእድ ዬክዶሶና። ሄ ዎደፐ ዶምድ ኡባይ ባንታ አሌቁዋ አቦኮና። <verse eid="EXO 33:4"/><verse number="5" style="v" sid="EXO 33:5"/>ጎዳይ ሙሰኮ፥ እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ ያግስ፤ “ህንተ ዎዛና ሙመ አስ። ታኒ ህንተራ ሀር አቶሽን ጉ ዎደስካ ቢኮ፥ ህንተ ታፐ ያና። ሀእ ህንተ፥ ህንተ አሌቆታ ከስተ፤ ታኒ ህንተ ቦላ ኦናባ በሳና ያጋ” ያግስ። <verse eid="EXO 33:5"/><verse number="6" style="v" sid="EXO 33:6"/>ሄ ዎደ እስራኤለት ኮሬባ ዙማ አግድ ብዳፐ ጉየ፥ ባንታ አሌቆታ አቦኮና።<verse eid="EXO 33:6"/></para>
  <para style="s1">ጋሄተ ዱንካነ</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7"/>እስራኤለ አሳይ ብሸ ሲራትያ ጉታ ኡባን ሙሰይ ዱንካንያ ጉታፐ ሃስድ ቶኬስ። ሄ ዱንካነይ፥ “ጎዳራ ጋሄትያ ዱንካነ” ጌተትድ ፄገትስ። ጎዳ ኦይቻናዉ ኮይያ ኡባይ ይያ ቤስ። <verse eid="EXO 33:7"/><verse number="8" style="v" sid="EXO 33:8"/>ሙሰይ ዱንካንያኮ ብያ ዎደ አሳ ኡባይ ባ ዱንካንያ ፐንገን ፐንገን ኤቅድ፥ ሙሰይ ይያ ገላና ጋካናዉ እያ በኦሶና። <verse eid="EXO 33:8"/><verse number="9" style="v" sid="EXO 33:9"/>ሙሰይ ይያ ገልዳፐ ጉየ፥ ሻራ ቱሳይ ዎድ ዱንካንያ ፐንገን ኤቄስ። ጎዳይ ሻራ ግዶን ግድድ ሙሰራ ኦደቴስ። <verse eid="EXO 33:9"/><verse number="10" style="v" sid="EXO 33:10"/>አሳይ ሻራ ቱሳ ዱንካንያ ፐንግያን በእዳ ዎደ ኡባን፥ ባ ፐንገን ፐንገን ጉልባትድ ጎዳስ ጎይኖሶና። <verse eid="EXO 33:10"/><verse number="11" style="v" sid="EXO 33:11"/>አስ ባ ላገራ ኦደተይሳዳ ጎዳይ ሙሰራ ሶምኦን ኦደቴስ። ሄሳፈ ጉየ፥ ሙሰይ ጉታ ስሜስ። ሽን እያ ማድያ ናአተይ፥ ናወ ናኣ እያሱይ፥ ጎዳራ ጋሄትያ ዱንካንያፐ ሻከተና።<verse eid="EXO 33:11"/></para>
  <para style="s1">ጎዳይ ባ አሳስ ገልዳ ቃላ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12"/>ሙሰይ ጎዳኮ፥ “ኔኒ ታና፥ ሀ አሳ ታ ግዳ ቢታ ካለ ያጋዳሳ። ሽን ታራ ባና መላ ኔኒ ኪተይ ኦነኮ፥ ታና ኤርሳባካ። ኔኒ፥ ታና ኤረይሳነ ታናን ኡፋይተይሳ ታዉ ቆንጭሳዳሳ። <verse eid="EXO 33:12"/><verse number="13" style="v" sid="EXO 33:13"/>ሄስ ቱማ ግድኮ፥ ታ ነና ሀጋዛና መላነ ጉጃ ኡፋይሳና መላ ነ ኦግያ ታና ታማርሳ። ሀ አሳይ ነ ደረ ግደይሳ በአ” ያግስ።<verse eid="EXO 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14"/>ጎዳይ ዛሪድ፥ “ታኒ፥ ኔራ ባና መላነ ነዉ ሳሮ እማና መላ ኮያይ?” ያግስ።<verse eid="EXO 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 33:15"/>ሙሰይ ዛሪድ፥ “ኔኒ ኑራ ቦናባ ግድኮ፥ ሀይሳፈ ኑና ከሶፋ። <verse eid="EXO 33:15"/><verse number="16" style="v" sid="EXO 33:16"/>ኔኒ ኑራ ቦናባ ግድኮ፥ ታናንነ ነ አሳን ነ ኡፋይትዳይሳ አሳ ኡባይ ዋትድ ኤራኔ? ቢታ ኡባን ደእያ ሀራ አሳ ኡባፈ ታንነ ነ አሳይ ዱማተይ ነ ኑራ ደኤይሳን ግደነዬ?” ያግስ።<verse eid="EXO 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17"/>ጎዳይ ሙሰኮ፥ “ታኒ ነና ኤርያ ግሾነ ነናን ኡፋይትዳ ግሾ፥ ነ ታና ኦይችዳይሳ ኡባ ኦና” ያግስ።<verse eid="EXO 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18"/>ሙሰይ ጎዳኮ፥ “ሀያና ነ ኩመ ቦንቹዋ ታና በሳ?” ያግስ።<verse eid="EXO 33:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19"/>ጎዳይ ዛሪድ፥ “ታኒ ታ ማሮታነ ታ ሎኦተ ኡባ ነ ስንራ አና። ታ ጌሻ ሱን ነ ማታን አዋጃና። ታኒ ጎዳ፤ ታ ዶርዳይሳታ ማራናነ ኤንታዉ ቃታና። <verse eid="EXO 33:19"/><verse number="20" style="v" sid="EXO 33:20"/>ሽን ኦንካ ታ ሶምኡዋ በእድ ፓፃ ዶና ግሾ፥ ኔኒ ታ ሶምኡዋ በአካ” ያግስ።<verse eid="EXO 33:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 33:21"/>ሽን፥ “ኔኒ ዛላ ቦላ ኤቃናዉ ሀይሳን ታ ማታን በሲ ደኤስ። <verse eid="EXO 33:21"/><verse number="22" style="v" sid="EXO 33:22"/>ታ ቦንቾይ አያ ዎደ ታኒ ዛእዳ ዛላ ግዶን ነና ዎና። ታ አና ጋካናዉ ታ ኩሽያን ነና ካማና። <verse eid="EXO 33:22"/><verse number="23" style="v" sid="EXO 33:23"/>ሄሳፈ ጉየ፥ ታኒ ታ ኩሽያ ደንና፤ ኔኒ ታ ዞኩዋ በአና፥ ሽን ታ ሶምኡዋ በአካ” ያግስ።<verse eid="EXO 33:23"/></para>
  <chapter eid="EXO 33"/>
  <chapter number="34" style="c" sid="EXO 34"/>
  <para style="s1">ዛሪድ ኦሰትዳ ሎቸ ሹቻታ</para>
  <para style="r">(<ref loc="DEU 10:1-5">ዛረ 10:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1"/>ጎዳይ ሙሰኮ፥ “ኮይሮይሳታ ዳንያ ናምኡ ሎቸ ሹቻታ ማሳዳ ጊግሳ። ታኒ ሄ ሹቻታ ቦላ ካሰ ኔኒ መንዳ ሹቻታ ቦላ ደእያ ቃላታ ፃፋና። <verse eid="EXO 34:1"/><verse number="2" style="v" sid="EXO 34:2"/>ዎንቶ ዎንታ ጉራ ታራ ጋሄታናዉ ሲና ዙማ ሁጵያ ከያ። <verse eid="EXO 34:2"/><verse number="3" style="v" sid="EXO 34:3"/>ኔራ ኦንካ ከዮፖ ዎይኮ ዙማ ቦላ አዉንካ በንቶፎ። ሀር አቶሽን ዶርሳ ዎይኮ መሄ ዉደይ ዙማ ፃጶን ሄመቶፎ ዎይኮ ሞፖ” ያግስ።<verse eid="EXO 34:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 34:4"/>ሄሳ ግሾ፥ ሙሰይ ኮይሮ ሹቻታ ዳንያ ናምኡ ሹቻታ ማስድ፥ ጎዳይ ኪትዳይሳዳ፥ ሹቻታ ኦይክድ ዎንታ ጉራ ሲና ዙማ ቦላ ከይስ። <verse eid="EXO 34:4"/><verse number="5" style="v" sid="EXO 34:5"/>ጎዳይ ሻራራ ዎድ፥ እያራ ያን ኤቅድ፥ “ታኒ ጎዳ” ያግድ ባ ጌሻ ሱን አዋጅስ። <verse eid="EXO 34:5"/><verse number="6" style="v" sid="EXO 34:6"/>ጎዳይ ሙሰ ስንራ አሸ ሀይሳዳ ያግድ አዋጅስ፤ “ታኒ ፆሳ፥ ታ ሱንይ ጎዳ። ታኒ፥ ቃይነ ማሮታይ ኩምዳ ፆሳ። ታኒ ዳንዳአንነ መርና ሲቆን ኩምዳይሳነ ዳሮ አማንይሳ። <verse eid="EXO 34:6"/><verse number="7" style="v" sid="EXO 34:7"/>ታኒ፥ ታ አሳስ ገልያ ቃላ ሙኩሉ የለተ ጋካናዉ ናገይሳነ ኢታተ፥ ማካላነ ናጋራ አቶ ገይሳ። ሽን ሄንነ ኦይዳን የለተ ጋካናዉ አዋታ ናጋራ ግሾ ናይታ ሴሮና አግከ” ያግስ።<verse eid="EXO 34:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8"/>ሙሰይ ኤለስድ ቢታን ጉፋንድ ጎይንስ። <verse eid="EXO 34:8"/><verse number="9" style="v" sid="EXO 34:9"/>እ ዛሪድ፥ “አቤት ጎዳዉ፥ ኔኒ ታናን ኡፋይትያባ ግድኮ፥ ኑራ እስፈ የ። ሀይስ አሳይ ስኦና አስ፤ ኑ ኢታተነ ኑ ናጋራ አቶ ያጋዳ፥ ኑና ነ አሰ ኦ” ያግስ።<verse eid="EXO 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10"/>ጎዳይ ሙሰኮ፥ “ታኒ እስራኤለ አሳራ ጫቃና። ሀይሳፈ ካሰ ቢታ ቦላ አዉንካ ሀን ኤሮና ማላልስያባ ነ አሳ ስንን ኦና። ታኒ ጎዳይ፥ አይ መላ ማላልስያባ ኦያኮ፥ ኔኒ ኤንታ ግዶን ደእያ አሳይ በአና። <verse eid="EXO 34:10"/><verse number="11" style="v" sid="EXO 34:11"/>ሀች ታኒ ህንተና ኪትያ ኪታ ናግተ። ህንተ ስንፈ አሞረታ፥ ካናነታ፥ ህተታ፥ ፓርዘታ፥ ህወታነ ያቡሰታ ታኒ ጎዳና። <verse eid="EXO 34:11"/><verse number="12" style="v" sid="EXO 34:12"/>ኤንቲ ህንተዉ ፅሄ ግዶና መላ ህንተ ገልያ ቢታን ደእያ አሳራ ጫቆፍተ። <verse eid="EXO 34:12"/><verse number="13" style="v" sid="EXO 34:13"/>ኤንታ ያርሾ በሳታ ላልተ፤ ጎይኖ ቱሳታ መንረተ። አሼራ ጌተትያ ማጫ ፆሰ ምስለ ቱሳታ ቃንፀረተ። <verse eid="EXO 34:13"/><verse number="14" style="v" sid="EXO 34:14"/>ታኒ ጎዳይ፥ ታ ቦንቹዋ ሀራ ፆሳታራ ኮፆና ፆሰ ግድያ ግሾ፥ ታፐ ሀራ ፆሳታስ ጎይኖፍተ። <verse eid="EXO 34:14"/><verse number="15" style="v" sid="EXO 34:15"/>ሄ ቢታን ደእያ አሳታራ አይባ ጫቆካ ጫቆፍተ። ኤንቲ ባንታ ፆሳታ ጎይንያ ዎደነ ኤንታዉ ያርሽያ ዎደ፥ ኤንቲ ህንተና ባንታራ እስፋና መላ ኦይችኮ፥ ህንተ ኤንቲ ባንታ ፆሳታስ ያርሽያ ካ ማናዉ ፓጨትድ፥ ታዉ አማነቶና እፃና። <verse eid="EXO 34:15"/><verse number="16" style="v" sid="EXO 34:16"/>ቃስ ህንተ ኤንታ ማጫ ናይታፐ ህንተ አደ ናይታስ እምኮ፥ ሄ ዎደ ሄ ማጫ ናይት ባንታ ፆሳታ ጎይንድ፥ ህንተ አደ ናይትካ ታዉ አማነቶና እፅድ፥ ባንታ ፆሳታ ጎይናና መላ ኦና።<verse eid="EXO 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 34:17"/>“ብራታፐ ቆፀትድ፥ መትዳ ፆሳታ ጎይኖፍተ።<verse eid="EXO 34:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 34:18"/>“ኡይ ባኣለ ቦንችተ። ህንተ ግብፀፈ ከይዳይ፥ አቢባ አጌናን ግድያ ግሾ፥ ታኒ ህንተና ኪትዳይሳዳ፥ ሄ አጌናን፥ ላፑን ጋላስ ጋካናዉ ኡይ ሚተ።<verse eid="EXO 34:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 34:19"/>“ባይራ የለትያ አደ ናእ ኡባይነ ባይራ የለትያ መሄ አደ ኡባይ ታባ። <verse eid="EXO 34:19"/><verse number="20" style="v" sid="EXO 34:20"/>ኮይሮ የለትዳ ሀረ ማር ዶርሳ ማራራ ላማዳ ዎዛ። ዎዞና እፅኮ፥ እያ ሞርግያ መን። ባይራ የለትዳ አደ ናአ ኡባ ዎዛ።</para>
  <para style="p" vid="EXO 34:20">“ኦንካ እምያባ ኦይኮና መላ ኩሸ ታ ስንን ሺቆፖ።<verse eid="EXO 34:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21"/>“ኡሱፑን ጋላስ ኦተ፥ ሽን ላፑን ጋላሳን ሸምፕተ። ዘርያ ዎደ ግድን ዎይኮ ካ ጫክያ ዎደ ላፑን ጋላሳን ሸምፕተ።<verse eid="EXO 34:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 34:22"/>“ኮይሮ ህንተ ግስትያ ጫኮ ዶምያ ዎደ፥ ካ ሺሾ ባኣለ ቦንችተ። ቃስ ላይ ዉርሰ ካ ሺሽያ ዎደ፥ ሻቃራ ባኣለ ቦንችተ። <verse eid="EXO 34:22"/><verse number="23" style="v" sid="EXO 34:23"/>ላይን ሄ ቶሆ እስራኤለ አደ ኡባይ መተ ጎዳ፥ እስራኤለ ፆሳ ጎይናናዉ ዮ። <verse eid="EXO 34:23"/><verse number="24" style="v" sid="EXO 34:24"/>ካዎተታ ታኒ ህንተ ስንፈ የደ ከሳዳ ህንተ ዛዋ አሳና። ህንተ ታና ጎይናናዉ ላይን ሄ ቶሆ ይያ ዎደ፥ ኦንካ ህንተ ቢታ ኦልድ ኤካናዉ አሞተና።<verse eid="EXO 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25"/>“ህንተ ታዉ መሄ ያርሽያ ዎደ፥ እርሾ የግድ ኡክዳ ኡይራ ሽሾፕተ። ፓስካ ቦንችያ ጋላሳስ ያርሽዳ ያርሹዋፈ ዎንታስ አይባካ አሾፍተ።<verse eid="EXO 34:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 34:26"/>“ህንተ ጋደን ባይራ ካፅዳ ካፈ ኮይሮ አይፍያ ጎዳ ህንተ ፆሳ ኬ ኤህተ።</para>
  <para style="p" vid="EXO 34:26">“ዴሻ ማር እያ አየ ማን ዶይሶፕተ” ያግስ።<verse eid="EXO 34:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 34:27"/>ጎዳይ ሙሰኮ፥ “ታኒ ኔራነ እስራኤለ አሳራ ጫቆ ገለይ ሀ ቃላታን ግድያ ግሾ፥ ሀ ቃላታ ፃፋ” ያግስ። <verse eid="EXO 34:27"/><verse number="28" style="v" sid="EXO 34:28"/>ሙሰይ ሞናነ ኡዮና፥ ኦይታሙ ጋላስነ ኦይታሙ ቃማ ጎዳራ ዙማ ቦላ ጋምእስ። እ፥ ጫቆ ቃላ ገልዳ ታሙ ኪታታ ሎቸ ሹቻታን ፃፍስ።<verse eid="EXO 34:28"/></para>
  <para style="s1">ሙሰይ ሲና ዙማፐ ዎ</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29"/>ሙሰይ ጎዳራ ኦደትሸ ጋምእድ፥ ታሙ ኪታታ ኦይክዳ ናምኡ ሎቸ ሹቻታ ኤክድ ሲና ዙማፐ ዎያ ዎደ እያ ሶምኦይ ጶሌስ፥ ሽን እ ሄሳ ኤርቤና። <verse eid="EXO 34:29"/><verse number="30" style="v" sid="EXO 34:30"/>አሮንነ እስራኤለ አሳ ኡባይ ሙሰ ፄልድ፥ እያ ሶምኦይ ጶለይሳ በእድ፥ እያኮ ሺቃናዉ ያይዶሶና። <verse eid="EXO 34:30"/><verse number="31" style="v" sid="EXO 34:31"/>ሽን ሙሰይ ኤንታ ፄግስ። አሮንነ እስራኤለ ሀላቃት ኡባይ እያኮ ሺቅን፥ እ ኤንታ ኦድስስ። <verse eid="EXO 34:31"/><verse number="32" style="v" sid="EXO 34:32"/>ሄሳፈ ጉየ፥ እስራኤለ አሳ ኡባይ እያኮ ሺቅን፥ ጎዳይ እያዉ ሲና ዙማ ቦላ እምዳ ኪታ ኡባ እ ኤንታዉ እሚስ።<verse eid="EXO 34:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 34:33"/>ሙሰይ ኤንታራ ኦደተይሳ ዉርስዳ ዎደ ባ ሶምኡዋ ላፃናን ካምስ። <verse eid="EXO 34:33"/><verse number="34" style="v" sid="EXO 34:34"/>ሽን ሙሰይ ጎዳ ስን፥ እያራ ኦደታናዉ ገልያ ዎደ ላፃና ባ ሶምኡዋፈ ቃሬስ። ያፐ ከይያ ዎደ፥ ጎዳይ እያ ኪትዳባ ኡባ እስራኤለ አሳስ ኦዴስ። <verse eid="EXO 34:34"/><verse number="35" style="v" sid="EXO 34:35"/>ሄ ኡባን ኤንቲ እያ ሶምኦይ ጶለይሳ በኦሶና። ሄሳ ግሾ፥ ሙሰይ ጎዳራ ኦደታናዉ ባና ጋካናዉ፥ ባ ሶምኡዋ ላፃናን ካሜስ።<verse eid="EXO 34:35"/></para>
  <chapter eid="EXO 34"/>
  <chapter number="35" style="c" sid="EXO 35"/>
  <para style="s1">ሳምባታ ቦንቾ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1"/>ሙሰይ እስራኤለ አሳ ኡባ ፄግድ፥ “ህንተ ኦና መላ ጎዳይ ኪትዳባይ ሀይሳ፤ <verse eid="EXO 35:1"/><verse number="2" style="v" sid="EXO 35:2"/>ሳምንታ ግዶን ኡሱፑን ጋላሳ ፃላላን ኦሶ ኦተ፤ ሽን ላፑን ጋላሳይ ህንተዉ ጌሻ ጋላስ፤ ጎዳስካ ዱማትዳ ሸምፖ ሳምባታ። ሄ ጋላሳን ኦሶ ኦያ ኦንካ ሀይቃናዉ በሴስ። <verse eid="EXO 35:2"/><verse number="3" style="v" sid="EXO 35:3"/>ሳምባታ ጋላስ ህንተ ሶን ታማ ኤፍተ” ያግስ።<verse eid="EXO 35:3"/></para>
  <para style="s1">ጌሻ ዱንካንያስ እመትዳ እሙዋ</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4"/>ሙሰይ እስራኤለ አሳኮ፥ “ጎዳይ ሀይሳዳ ያግድ ህንተና ኪትስ፤ <verse eid="EXO 35:4"/><verse number="5" style="v" sid="EXO 35:5"/>ጎዳስ ህንተ ዎዛናይ እሞ ግያባ እማናዉ ኤህተ። ህንተ እማናዉ ኤህያባት ዎርቃ፥ ብራ፥ ናሰ ብራታ፥ <verse eid="EXO 35:5"/><verse number="6" style="v" sid="EXO 35:6"/>ካሎሰ ቃጭና፥ ኦቻ ቴራ ዳንያ ቃጭና፥ ዞኦ ቃጭናነ አልኦ ሊኖ፥ ዴሻ እክሰ፥ <verse eid="EXO 35:6"/><verse number="7" style="v" sid="EXO 35:7"/>ዞኦ ቃላመን የግ ከስዳ ዶርሳ እተ፥ ሎኦ ዶአ እተ፥ ሶቃላ ም፥ <verse eid="EXO 35:7"/><verse number="8" style="v" sid="EXO 35:8"/>ፆምፐስ ሻማሆ ዛይተ፥ ሹማተ ዛይተ፥ እያን የገትያ ሳዋነ እፃነ ሳዎ፥ <verse eid="EXO 35:8"/><verse number="9" style="v" sid="EXO 35:9"/>ኤፉድያስነ ትራን ማኤትያ ማኡዋስ ሀንያ ማርግደ ጌተትያ ሹቻነ ሀራ አሌቆታ ኤሆ።<verse eid="EXO 35:9"/></para>
  <para style="s1">ጌሻ ዱንካነን ጎኤትያ ሚሸታ</para>
  <para style="r">(<ref loc="EXO 39:32-43">ከሳ 39:32-43</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10"/>“ህንተ ግዶን ደእያ ኩሸ ሂላንቾ ኡባይ ይድ፥ ጎዳይ ኪትዳይሳ ኡባ ኦ። <verse eid="EXO 35:10"/><verse number="11" style="v" sid="EXO 35:11"/>ጌሻ ዱንካንያ፥ እያ ጋ ካማነ ካረ ካማ፥ ካቆታ፥ ቱቀታ፥ ልዮታ፥ ቱሳታነ ኤንቲ ኤቅያ ቶሆታ፤ <verse eid="EXO 35:11"/><verse number="12" style="v" sid="EXO 35:12"/>ታቦትያነ እያ ቶክያ ካሶ ምታ፥ ናጋራ አቶተ ካማነ ታቦትያ ገንያ ማጋራጁዋ፤ <verse eid="EXO 35:12"/><verse number="13" style="v" sid="EXO 35:13"/>ፃርጴዛ፥ እያ ቶክያ ካሶ ምታነ፥ እያ ሚሸታ ኡባነ ጎዳ ስንን ዎያ ጌሻ ኡይ፤ <verse eid="EXO 35:13"/><verse number="14" style="v" sid="EXO 35:14"/>ፆምፐ ዎያ ኮጫ፥ እያ ሚሸታ፥ ፆምፕያነ ፆምፐ ዛይትያ፤ <verse eid="EXO 35:14"/><verse number="15" style="v" sid="EXO 35:15"/>እፃነ ጩይስያ ፃርጴዛነ እያ ቶክያ ካሶታ፥ ሹማተ ዛይትያነ ሳውያ እፃነ፥ ጌሻ ዱንካንያ ፐንገ ማጋራጁዋ፤ <verse eid="EXO 35:15"/><verse number="16" style="v" sid="EXO 35:16"/>ፁሳ ያርሾ በስነ እያ ናሰ ብራታ ዛርዛርያ፥ እያ ቶክያ ካሶታነ እያ ሚሸታ ኡባ፥ ናሰ ብራታፐ ኦሰትዳ ሜቻ ከርያነ እያ ቶሁዋ፤ <verse eid="EXO 35:16"/><verse number="17" style="v" sid="EXO 35:17"/>ዳባባ ጎዳ ገሸታ፥ ቱሳታነ ኤንታ ቶሆታ፥ ዳባባ ፐንገ ማጋራጁዋ፥ <verse eid="EXO 35:17"/><verse number="18" style="v" sid="EXO 35:18"/>ጌሻ ዱንካንያነ ዳባባ ዱንካንያ ቶለ ሸታነ ኤንታ ዎዶሮታ፤ <verse eid="EXO 35:18"/><verse number="19" style="v" sid="EXO 35:19"/>አሮንነ እያ ናይት ጌሻ በሳን ሀጋዝሸ ማአናዉ አሌቀትድ ኦሰትዳ ቦንቾ ማኦታ ኦ” ያግስ።<verse eid="EXO 35:19"/></para>
  <para style="s1">አሳይ ኤህዳ እሙዋ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20"/>ሄሳፈ ጉየ፥ እስራኤለ አሳ ኡባይ ሙሰ ስንፈ ከይዶሶና። <verse eid="EXO 35:20"/><verse number="21" style="v" sid="EXO 35:21"/>አሳ ኡባይ ባ ዎዛናን እሞ እሞ ግዳባ ጌሻ ዱንካንያስ፥ እያ ግዶን ኦሰትያ ኦሶ ኡባስነ ቦንቾ ካህነ ማኦታስ ኮሽያባ ኡባ ኤህዶሶና። <verse eid="EXO 35:21"/><verse number="22" style="v" sid="EXO 35:22"/>እማናዉ ኮይዳ ማጭ አደ ኡባይ ዎርቃ አሌቆታ፥ ሲ ዎርቃታ፥ ምግዶታ፥ ቆ ዎርቃ ኤህድ፥ ጎዳስ እሞ ኦድ እምዶሶና። <verse eid="EXO 35:22"/><verse number="23" style="v" sid="EXO 35:23"/>ካሎሰ ቃጭና፥ ኦቻ ቴራ ዳንያ ቃጭና፥ ዞኦ ቃጭና፥ አልኦ ሊኖ፥ ዎይኮ ዴሻ እክሰ፥ ዎይኮ ዞኦ ቃላመን የግ ከስዳ ዶርሳ እተ ዎይኮ፥ ሎኦ ዶአ እተይ ደእያ አስ ኡባይ ኤህስ። <verse eid="EXO 35:23"/><verse number="24" style="v" sid="EXO 35:24"/>ብራ ዎይኮ ናሰ ብራታ እማናዉ ዳንዳእያ ኡባይ ባንታ እሞታ ጎዳስ እምዶሶና። ቃስ ሶቃላ ም ደእያ አስ ኡባይ ዱማ ዱማ ኦሱዋስ ኤህስ።<verse eid="EXO 35:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 35:25"/>ኩሸ ሂላ ማጫሳ ኡባይ ባንታ ኩሸን ሱቅዳ ካሎሰ ቃጭና፥ ኦቻ ቴራ ዳንያ ቃጭና፥ ዞኦ ቃጭናነ አልኦ ሊኖ ኤህዶሶና። <verse eid="EXO 35:25"/><verse number="26" style="v" sid="EXO 35:26"/>ቃስካ እሞታ እማናዉ ኮይዳ ማጫሳ ኡባይ ዴሻ እተፐ ዶቀትዳ ዎዶሮ ኤህዶሶና። <verse eid="EXO 35:26"/><verse number="27" style="v" sid="EXO 35:27"/>ሀላቃት ኤፉድያስነ ትራን ማኤትያ ማኡዋስ ሀንያ ማርግደነ ሀራ ሎኦ ሹቻታ፥ <verse eid="EXO 35:27"/><verse number="28" style="v" sid="EXO 35:28"/>ቃስካ ኤንቲ እፃነን፥ ሹማተስነ ፆምፐስ ማድያ ሻማሆ ዛይተን የገትያ ሳዎ ኤህዶሶና። <verse eid="EXO 35:28"/><verse number="29" style="v" sid="EXO 35:29"/>እስራኤለ አሳ ኡባይ፥ ኦና መላ ጎዳይ ሙሰ ባጋራ ኪትዳ ኦሱዋስ ሀንያ እሞታታ ኡባ ባንታ ዶሳን ጎዳስ ኤህዶሶና።<verse eid="EXO 35:29"/></para>
  <para style="s1">ኩሸ ሂላንቾታ</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30"/>ሙሰይ እስራኤለ አሳኮ ሀይሳዳ ያግስ፤ “ጎዳይ ይሁዳ ሼሻፐ ግድዳ ሁራ ናኣ ናኣ፥ ኡረ ናኣ፥ ባስልኤላ ዶርስ። <verse eid="EXO 35:30"/><verse number="31" style="v" sid="EXO 35:31"/>ጎዳይ እያ ባ አያናን፥ ሂላን፥ አኬካንነ ኦሶ ኡባ ኦያ ኤራን ኩንስ። <verse eid="EXO 35:31"/><verse number="32" style="v" sid="EXO 35:32"/>ሄስካ፥ ሂላን ኦና ኦሶታ ሀልችድ ዎርቃፈ፥ ብራፐነ ናሰ ብራታፐ ዱማ ዱማባ ከስድ ኦናሳ። <verse eid="EXO 35:32"/><verse number="33" style="v" sid="EXO 35:33"/>ሄሳዳካ፥ አልኦ ሹቹ ማስድ ጊግሶ፥ ም ማሰነ ሀራ ኦሶ ኡባ ኦና መላ ጭንጫተ እሚስ። <verse eid="EXO 35:33"/><verse number="34" style="v" sid="EXO 35:34"/>ቃስ እያስነ ዳነ ሼሽ ግድዳ አህሳማካ ናኣ ኤልያባስ፥ ባንታ ሂላ ሀራታ ታማርሳና መላ ኤራተ እሚስ <verse eid="EXO 35:34"/><verse number="35" style="v" sid="EXO 35:35"/>ኤንቲ ዱማ ዱማ ኦሶ ኦና መላ ኦሶ ሀልቾ ከሳና መላ፥ ካሎሰን፥ ኦቻ ቴራ ዳነይሳንነ ዞኦ ሱፈ ቃጭናን አልኦ ሊኖ አሌቅስድ፥ ዳድያ ሂላተ እሚስ። ጎዳይ ኤንታ፥ ኤራተን ኩንስ። ኤንቲ ኡባይ ዱማ ዱማ ኦሶን ሉፅዳ ሂላንቾ ግድዶሶና።<verse eid="EXO 35:35"/></para>
  <chapter eid="EXO 35"/>
  <chapter number="36" style="c" sid="EXO 36"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1"/>“ሄሳ ግሾ፥ ባስልኤል፥ ኤልያብነ ጌሻ ዱንካንያ ኬፃና መላ ጎዳይ ሂላነ ኤራተ እምዳ አሳ ኡባይ፥ ጎዳይ ኪትዳይሳዳ ኡባባ ኦና” ያግስ።<verse eid="EXO 36:1"/></para>
  <para style="s1">እሙዋ ዳሮተ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2"/>ሙሰይ ባስልኤላ፥ ኤልያባ፥ ጎዳይ ዱማ ኤራተ እምዳይሳታነ ኦሶ ኦናዉ ኮይያ ኡባ ፄግድ፥ ኦሱዋ ዶማና መላ ኪትስ። <verse eid="EXO 36:2"/><verse number="3" style="v" sid="EXO 36:3"/>ኤንቲ፥ እስራኤለ አሳይ ጌሻ ዱንካንያ ኦናዉ ኤህዳ እሞ ኡባ ሙሰ ኩሸፐ ኤክዶሶና። ቃስ አሳይ ባ ዶሳን እምያ እሞታ ዎንታ ዎንታ ኤሁዋ አግቦኮና። <verse eid="EXO 36:3"/><verse number="4" style="v" sid="EXO 36:4"/>ያትን፥ ጌሻ ዱንካንያ ኦያ ሂላንቾት ባንታ ኦሱዋ ኤስድ፥ ሙሰኮ ብድ፥ <verse eid="EXO 36:4"/><verse number="5" style="v" sid="EXO 36:5"/>“አሳይ፥ ጎዳይ ኪትዳ ኦሱዋስ ኮሸይሳፈ አድ ኤሆ ቦላ ደኦሶና” ያግዶሶና።<verse eid="EXO 36:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6"/>ሙሰይ፥ “ጌሻ ዱንካንያ ኬፃናዉ ኦንካ እምያባ ኤሆፖ” ያግድ ኪትን፥ አሳይ ኤሄይሳ አጋግዶሶና። <verse eid="EXO 36:6"/><verse number="7" style="v" sid="EXO 36:7"/>ኤንቲ ኤህዳ እሞታይ ኦሶ ኡባ ኦ ፖላናዉ ግድድ ፓላሄስ።<verse eid="EXO 36:7"/></para>
  <para style="s1">ጌሻ ዱንካነ ኦሱዋ</para>
  <para style="r">(<ref loc="EXO 26:1-37">ከሳ 26:1-37</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8"/>ኦሱዋ ኦይሳታፐ ሂላን አይሳት ጌሻ ዱንካንያ ኦዶሶና። ኤንቲ እያ አልኦ ሊኖፐ፥ ካሎሰን ኦቻ ቴራ ዳነይሳንነ ዞኦ ቃጭናን አሌቅስድ ዳድዳ ታሙ ገሸታ ጊግስድ፥ እያ ቦላ ክሩበታ ምስልያ ስክዶሶና። <verse eid="EXO 36:8"/><verse number="9" style="v" sid="EXO 36:9"/>ማጋራጆት ኡባይ እስ ግና ግድድ፥ አዱሳተይ ላታማነ ኦይዱ ዋ፥ ጎምፓይ ኦይዱ ዋ። <verse eid="EXO 36:9"/><verse number="10" style="v" sid="EXO 36:10"/>እቻሹ ገሸታ እስፈ ጋድ ስክዶሶና፤ ቃስ ሀንኮ አትዳ እቻሹ ገሸታካ ሄሳዳ ኦዶሶና። <verse eid="EXO 36:10"/><verse number="11" style="v" sid="EXO 36:11"/>እስፈ ጋድ ስክዳ ገሸታፐ እስ ማጋራጁዋስ ዉርሰ ጋፃን ካሎሰ አፍላፐ ኦሰትዳ ሳጋዮታ መዶሶና። ቃስ እስፈ ጋድ ስክዳ ሀንኮ ገሸታፐ እሱዋ ጋፃንካ ሄሳዳ ኦዶሶና። <verse eid="EXO 36:11"/><verse number="12" style="v" sid="EXO 36:12"/>ኤንቲ እስፈ ስከትዳ ኮይሮ ማጋራጁዋ ቦላ ኮይሮ ማራን ካሎሰ አፍላፐ ኦሰትዳ እሻታሙ ሳጋዮታ፥ ሄሳዳካ ናምአን ማጋራጁዋ ቦላ ዉርሰ ማራን፥ ሀንኮ ሳጋዮታ ግናን፥ እሻታሙ ሳጋዮታ ኦዶሶና። <verse eid="EXO 36:12"/><verse number="13" style="v" sid="EXO 36:13"/>ኤንቲ ናምኡ ባጋን ደእያ ገሸታ ጋሰድ እስኖ ኦናዉ ዎርቃፈ እሻታሙ ኦይክያ በሳታ መዶሶና።<verse eid="EXO 36:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14"/>ጌሻ ዱንካንያ ቦላራ ካማናዉ ታማነ እስ ገሸታ ዴሻ እክሰፐ ዳድዶሶና። <verse eid="EXO 36:14"/><verse number="15" style="v" sid="EXO 36:15"/>ታማነ እስ ገሸታ አዱሳተ ላታማነ ኡሱፑን ዋ፥ ጎምፓ ኦይዱ ዋ ኦድ መዶሶና። <verse eid="EXO 36:15"/><verse number="16" style="v" sid="EXO 36:16"/>እቻሹ ገሸታ እስ ባጋራ፥ ቃስ ኡሱፑን ገሸታ ሀንኮ ባጋራ ጋድ ስክዶሶና። <verse eid="EXO 36:16"/><verse number="17" style="v" sid="EXO 36:17"/>ዎል ጋድ ስክዳ ገሸታፐ ዉርሰ ማጋራጁዋ ማጫራን እሻታሙ ሳጋዮታ፥ ቃስ ዎል ጋድ ስክዳ ሀንኮ ገሸታፐ ዉርሰ ማጋራጁዋ ማጫራን እሻታሙ ሳጋዮታ መዶሶና። <verse eid="EXO 36:17"/><verse number="18" style="v" sid="EXO 36:18"/>ናምኡ ባጋራ ደእያ ገሸታ ጋሰድ እስ ካማ ኦናዉ ናሰ ብራታፐ እሻታሙ ኦይክያ በሳታ መዶሶና። <verse eid="EXO 36:18"/><verse number="19" style="v" sid="EXO 36:19"/>ዱንካንያ ካማናዉ ዞኦ ቃላመን የግ ከስዳ ዶርሳ እተ፥ ቃስ እያ ቦላራ ካማናዉ ሎኦ ዶአ እተ ጊግስዶሶና።<verse eid="EXO 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 36:20"/>ጌሻ ዱንካንያ ቱቀታ ሶቃላ ምፈ ከስዶሶና። <verse eid="EXO 36:20"/><verse number="21" style="v" sid="EXO 36:21"/>እስ እስ ቱቅያ አዱሳተይ ታሙ ዋ፥ ጎምፓይ እስ ዋነ ታካ። <verse eid="EXO 36:21"/><verse number="22" style="v" sid="EXO 36:22"/>እስ ቱቅያ እሱዋራ ጋሰናዉ ናምኡ ሉሆት ደኦሶና። ጌሻ ዱንካንያ ቱቀታ ኡባ ሄሳዳ ኦዶሶና። <verse eid="EXO 36:22"/><verse number="23" style="v" sid="EXO 36:23"/>ጌሻ ዱንካንያስ ዱገሀ ባጋራ ላታሙ ቱቀታ መዶሶና። <verse eid="EXO 36:23"/><verse number="24" style="v" sid="EXO 36:24"/>እስ እስ ቱቀታስ ናምኡ ቶሆ መድ፥ ሄ ቶሆታ ኦይናዉ ኦይታሙ ሉሆታ ብራታፐ ጊግስዶሶና። <verse eid="EXO 36:24"/><verse number="25" style="v" sid="EXO 36:25"/>ጌሻ ዱንካንያስ ፑደሀ ባጋራ ላታሙ ቱቀታ መዶሶና። <verse eid="EXO 36:25"/><verse number="26" style="v" sid="EXO 36:26"/>እስ እስ ቱቀታስ ናምኡ ቶሆ መድ፥ ሄ ቶሆታ ኦይናዉ ኦይታሙ ሉሆታ ብራታፐ ጊግስዶሶና። <verse eid="EXO 36:26"/><verse number="27" style="v" sid="EXO 36:27"/>ጌሻ ዱንካንያስ ጉየ ባጋን፥ ዉሎሀ ባጋራ ኡሱፑን ቱቀታ መዶሶና። <verse eid="EXO 36:27"/><verse number="28" style="v" sid="EXO 36:28"/>ጌሻ ዱንካንያ ጉየ ባጋን ደእያ ማዛነታስ ናምኡ ቱቀታ ጊግስዶሶና። <verse eid="EXO 36:28"/><verse number="29" style="v" sid="EXO 36:29"/>ሄ ናምኡ ማዛነ ቱቀት ፃጶፐ ፄራ ጋካናዉ ኦይከት ብዶሶና። ናምኡ ማዛንያን ደእያ ናምኡ ቱቀት ሄሳዳ ሀንድ ኦሰትዶሶና። <verse eid="EXO 36:29"/><verse number="30" style="v" sid="EXO 36:30"/>ሄሳ ግሾ፥ እስ እስ ቱቅያስ ጋርሳን ናምኡ ናምኡ ቶሆት ደኦሶና። ሆስፑን ቱቀታስ ብራታፐ ኦሰትዳ ታማነ ኡሱፑን ቶሆት ደኦሶና።<verse eid="EXO 36:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 36:31"/>ቃስ ኤንቲ ሶቃላ ምፈ ታማነ እቻሹ ልዮታ ከስዶሶና። እቻሹ ልዮት ጌሻ ዱንካንያ እስ ባጋ ምየን፥ <verse eid="EXO 36:31"/><verse number="32" style="v" sid="EXO 36:32"/>ቃስ እቻሹ ልዮታ ሀንኮ ባጋ ምየን፥ ሄሳዳካ እቻሹ ልዮታ ጉየ ባጋራ ዉሎሀ ባጋን ዎዶሶና። <verse eid="EXO 36:32"/><verse number="33" style="v" sid="EXO 36:33"/>ቱኡቀታስ ምየ ባጋራ ግዶን ደእያ ልዮይ፥ ሀ ጋፃፐ ያ ጋፃ ጋካናዉ ካን ከያና መላ ኦዶሶና። <verse eid="EXO 36:33"/><verse number="34" style="v" sid="EXO 36:34"/>ቱኡቀታነ ልዮታ ዎርቃን ላንፅዶሶና። ልዮት ኤንታ ግዶራ ካን አና መላ ዎርቃ ሳጋዮታ ቱቀታራ ኦይሰዶሶና።<verse eid="EXO 36:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35"/>ማጋራጁዋ አልኦ ሊኖፐ ካሎሰን፥ ኦቻ ቴራ ዳነይሳንነ፥ ዞኦ ቃጭናን አሌቅስድ ኦዶሶና። ሄ ማጋራጁዋ ቦላ ክሩበ ምስለታ ስክዶሶና። <verse eid="EXO 36:35"/><verse number="36" style="v" sid="EXO 36:36"/>ማጋራጁዋ ካቃናዉ ኦይዱ ቱሳታ ሶቃላ ምፈ ጊግስድ፥ ዎርቃን ላንፅዶሶና። ያትድ ዎርቃ ሳጋዮታ ኤንታስ ጊግስዶሶና። ቃስ ቱሳታ ኤስያ ኦይዱ ቶሆታ ብራ ብራታፐ መዶሶና። <verse eid="EXO 36:36"/><verse number="37" style="v" sid="EXO 36:37"/>ጌሻ ዱንካንያ ፐንግያስ አልኦ ሊኖፐ ካሎሰን፥ ኦቻ ቴራ ዳነይሳፈነ ዞኦ ቃጭናን አሌቅስድ ማጋራጆ ጊግስዶሶና። <verse eid="EXO 36:37"/><verse number="38" style="v" sid="EXO 36:38"/>ቃስ እያዉ ኮጫት ደእያ እቻሹ ቱሳታ መድ፥ ኤንታዉ ፄራነ ቶሁዋ ዎርቃን ላንፅዶሶና። ቱሳታስ ናሰ ብራታፐ ኦሰትዳ እቻሹ ቶሆታ ጊግስዶሶና።<verse eid="EXO 36:38"/></para>
  <chapter eid="EXO 36"/>
  <chapter number="37" style="c" sid="EXO 37"/>
  <para style="s1">ታቦተ</para>
  <para style="r">(<ref loc="EXO 25:10-22">ከሳ 25:10-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1"/>ባስልኤል ታቦትያ ሶቃላ ምፈ ጊግስስ። ታቦትያ አዱሳተይ ናምኡ ዋነ ባጋ፥ ጎምፓይነ ጌሳይ እስ ዋነ ባጋ። <verse eid="EXO 37:1"/><verse number="2" style="v" sid="EXO 37:2"/>ታቦትያ ጊግስድ፥ ጋነ ካርያ ዋላህ ባይና ዎርቃን ላንፅስ። እያ ዩሹዋ ቦላካ ዎርቃን ላንፅስ። <verse eid="EXO 37:2"/><verse number="3" style="v" sid="EXO 37:3"/>ኦይዱ ዎርቃ ሳጋዮታ ታቦትያስ ኦይዱ ገዳታ ቦላ፥ እስ ባጋራ ናምኡ ሳጋዮታ፥ ቃስ ሀንኮ ባጋራ ናምኡ ሳጋዮታ አስ። <verse eid="EXO 37:3"/><verse number="4" style="v" sid="EXO 37:4"/>ያትድ ሶቃላ ምፈ ኦሰትዳ ካሶታ ከስድ ኤንታ ዎርቃን ላንፅስ። <verse eid="EXO 37:4"/><verse number="5" style="v" sid="EXO 37:5"/>ታቦትያ ቶካናዉ፥ ታቦትያስ ምይያን ደእያ ሳጋዮታን ካሶታ አስ።<verse eid="EXO 37:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 37:6"/>ዋላህ ባይና ዎርቃፈ፥ አዱሳተይ ናምኡ ዋነ ባጋ፥ ጎምፓይ እስ ዋነ ባጋ ግድዳ ናጋራ አቶተ ካማ ኦስ። <verse eid="EXO 37:6"/><verse number="7" style="v" sid="EXO 37:7"/>ቀፈይ ደእያ ናምኡ ክሩበታ ቆፀትዳ ዎርቃፈ ኦድ፥ <verse eid="EXO 37:7"/><verse number="8" style="v" sid="EXO 37:8"/>እስ ክሩብያ እስ ባጋን፥ ሀንኮ ክሩብያ ሀንኮ ባጋን ዎድ፥ አቶተ ካሙዋራ እስኖ ኦድ መስ። <verse eid="EXO 37:8"/><verse number="9" style="v" sid="EXO 37:9"/>ክሩበት ባንታ ቀፍያ ምጭድ፥ አቶተ ካሙዋ ካምድ፥ እሶይ እሱዋ ፄሎሶና።<verse eid="EXO 37:9"/></para>
  <para style="s1">ዳቦ ፃርጴዛ</para>
  <para style="r">(<ref loc="EXO 25:23-30">ከሳ 25:23-30</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10"/>አዱሳተይ ናምኡ ዋ፥ ጎምፓይ እስ ዋ፥ ጌሳይ እስ ዋነ ባጋ ግድዳ ፃርጴዛ ሶቃላ ምፈ መስ። <verse eid="EXO 37:10"/><verse number="11" style="v" sid="EXO 37:11"/>ዋላህ ባይና ዎርቃን እያ ላንፅድ፥ ዩሹዋካ ዎርቃን ላንፅስ። <verse eid="EXO 37:11"/><verse number="12" style="v" sid="EXO 37:12"/>ሄሳዳካ፥ ጎምፓይ ታካ ግድያ ጎሰ ኦድ፥ እያ ዎርቃን ዩሽ አድ ላንፅስ። <verse eid="EXO 37:12"/><verse number="13" style="v" sid="EXO 37:13"/>ታቦትያ ቶካናዉ ማድያ ኦይዱ ዎርቃ ሳጋዮታ መድ፥ ኦይዱ ገዳታ ኦይዱ ማዛነታ ቦላ ዎስ። <verse eid="EXO 37:13"/><verse number="14" style="v" sid="EXO 37:14"/>ፃርጴዛ ቶካናዉ ካሶታ አያ ሳጋዮት ፃርጴዛ ጎሳ ማታን ኦሰትዶሶና። <verse eid="EXO 37:14"/><verse number="15" style="v" sid="EXO 37:15"/>ፃርጴዛ ቶክያ ካሶ ምታ ሶቃላ ምፈ ከስድ፥ ዎርቃን ላንፅስ። <verse eid="EXO 37:15"/><verse number="16" style="v" sid="EXO 37:16"/>ሄሳዳካ፥ ፃርጴዛ ቦላ ዎያ ዱማ ዱማ ሚሸታ ዋላህ ባይና ዎርቃፈ መስ። ሄሳትካ ሳነታ፥ ጭልፓታ፥ ከረታ፥ ዎይነ ያርሾ ትግያ ፁአታ።<verse eid="EXO 37:16"/></para>
  <para style="s1">ፆምፐ ዎያ ኮጫ</para>
  <para style="r">(<ref loc="EXO 25:1-40">ከሳ 25:1-40</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17"/>ሄሳፈ ጉየ፥ ባስልኤል ፆምፐ ዎያ ኮጫ ዋላህ ባይና ዎርቃፈ ኦስ። ኮጫ ኤስያ ቶሁዋነ ቶማ ቆፀትዳ ዎርቃፈ ጊግስስ። አሌቆስ ኦሰትያ፥ እያ ጋምቡታ፥ እያ ዋላፃታነ እያ ጪሻታ ኡባ እያራ እስፈ ኦይድ መስ። <verse eid="EXO 37:17"/><verse number="18" style="v" sid="EXO 37:18"/>እስ ባጋራ ሄ ታሸት፥ ቃስ ሀንኮ ባጋራ ሄ ታሸት ደእያ ኡሱፑን ታሸታ እያ ምይያን መስ። <verse eid="EXO 37:18"/><verse number="19" style="v" sid="EXO 37:19"/>ኡሱፑን ታሸታስ ፄራን ፄራን ሄ ሄ አሌቆ ጋምቡትነ ጪሻት ደእያ ላዉዘ ም ጪሸ ዳንያባ መስ። <verse eid="EXO 37:19"/><verse number="20" style="v" sid="EXO 37:20"/>ፆምፐ ዎያ ኮጫ ግዶን ደእያ ቶማ ፄራን ኦይዱ አሌቆ ጋምቡትነ ጪሻት ደእያ ላዉዘ ም ጪሸ ዳንያባ መስ። <verse eid="EXO 37:20"/><verse number="21" style="v" sid="EXO 37:21"/>ዋን ደእያ ሄ ሄ ታሸታፐ ጋርሳን እስ እስ ጋምቡ ኦሰትስ። <verse eid="EXO 37:21"/><verse number="22" style="v" sid="EXO 37:22"/>ጋምቡት፥ ታሸትነ ፆምፐ ዎያ ኮጫይ እስኖ ግድድ፥ ዋላህ ባይና ዎርቃፈ ቆፀትድ ኦሰትዶሶና።<verse eid="EXO 37:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 37:23"/>ፆምፐ ዎያ ኮጫስ ላፑን ፆምፐታ፥ ፆምፐ ቶይስያ ቃጰታነ ኤንታ ዎያባታ ዋላህ ባይና ዎርቃፈ ኦስ። <verse eid="EXO 37:23"/><verse number="24" style="v" sid="EXO 37:24"/>ፆምፐ ዎያ ኮጫነ እያዉ ጎኤትያ ሚሸ ኡባ ኦናዉ ሀስታማነ እቻሹ ክሎ ግራመ ግድያ፥ ዋላህ ባይና ዎርቃ ኦንግስ።<verse eid="EXO 37:24"/></para>
  <para style="s1">እፃነ ፃርጴዛ</para>
  <para style="r">(<ref loc="EXO 30:1-5">ከሳ 30:1-5</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25"/>ባስልኤል እፃነ ጩይስያ ፃርጴዛ ሶቃላ ምፈ ጊግስስ። እያዉ ኦይዱ ማዛነይ ደኤስ። ሄ ፃርጴዛስ አዱሳተይነ ጎምፓይ እስ ዋ፤ ቃስ ጌሳይ ናምኡ ዋ። ኦይዱ ማዛንያን ደእያ ካጨት እያራ እስኖ ግድ ኦይከትድ ኦሰትዶሶና። <verse eid="EXO 37:25"/><verse number="26" style="v" sid="EXO 37:26"/>እያዉ ቦላ ባጋ፥ ኦይዱ ምያነ ካጨታ ዋላህ ባይና ዎርቃን ላንፅስ፥ እያ ዩሹዋካ ዎርቃን ላንፅድ ዩሽ አስ። <verse eid="EXO 37:26"/><verse number="27" style="v" sid="EXO 37:27"/>እያዉ ጋፃ ቦላ ቶካናዉ ማድያ ናምኡ ዎርቃ ሳጋዮታ መድ፥ ናምኡ ባጋ ምይያን ዎስ። ኤንቲ እፃነ ፃርጴዛ ቶክያ ዎደ ካሶ ምታ አናዉ ማደይሳታ። <verse eid="EXO 37:27"/><verse number="28" style="v" sid="EXO 37:28"/>ካሶ ምታ ሶቃላ ምፈ ከስድ፥ ዎርቃን ላንፅስ።<verse eid="EXO 37:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29"/>ጌሻ ሹማተ ዛይትያነ ሳውያ ሎኦ እፃነ ሽቶዳ ዋላክድ ኦስ።<verse eid="EXO 37:29"/></para>
  <chapter eid="EXO 37"/>
  <chapter number="38" style="c" sid="EXO 38"/>
  <para style="s1">ፁሳ ያርሾ በሲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1"/>ሶቃላ ምፈ ፁሳ ያርሾ በሲ ኦስ። ሄ ያርሾ በሳ አዱሳተይነ ጎምፓይ፥ እቻሹ እቻሹ ዋ፥ ቃስ ጌሳይ ናምኡ ዋነ ታካ። እያዉ ኦይዱ ማዛነይ ደኤስ። <verse eid="EXO 38:1"/><verse number="2" style="v" sid="EXO 38:2"/>ኦይዱ ማዛነታራ ኦይከትድ ኦሰትዳ ካጨታ መስ። ያትድ፥ ሄ ያርሾ በሳ ናሰ ብራታን ላንፅስ። <verse eid="EXO 38:2"/><verse number="3" style="v" sid="EXO 38:3"/>ሄ ያርሾ በሳን ጎኤትያ ሚሸታ፥ ድስተታ፥ ባልደታ፥ አካፋታ፥ አሹዋ ቃጵያ ቃጰታነ ታማ ጮጨታ ኡባ ናሰ ብራታፐ መስ። <verse eid="EXO 38:3"/><verse number="4" style="v" sid="EXO 38:4"/>ናሰ ብራታፐ ግተ ዳንያ ተቀ ያርሾ በሳስ ጊግስድ፥ ያርሾ በሳስ ግዶ ዛዋ ዩሽ አድ ዎስ። <verse eid="EXO 38:4"/><verse number="5" style="v" sid="EXO 38:5"/>ቶካናዉ ማድያ ካሶታ አናዉ፥ ኦይዱ ሳጋዮታ መድ፥ ኦይዱ ማዛነታ ቦላ ዎስ። <verse eid="EXO 38:5"/><verse number="6" style="v" sid="EXO 38:6"/>ሶቃላ ምፈ ያርሾ በሳ ቶክያ ካሶ ምታ ከስድ፥ ናሰ ብራታን ላንፅስ። <verse eid="EXO 38:6"/><verse number="7" style="v" sid="EXO 38:7"/>ሀ ካሶታ ናምኡ ምየን ደእያ ሳጋዮታን አስ። ያርሾ በሳ ፃዉላፐ ጊግስድ፥ ግዱዋ ካይስ ኦስ።<verse eid="EXO 38:7"/></para>
  <para style="s1">ሜቻ ከረ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8"/>ናሰ ብራታፐ ሜቻ ከረነ እያ ዎያ ቶሆ መስ። ሄ ናሰ ብራታይ፥ ጌሻ ዱንካንያ ፐንገን ኦያ ማጫሳት ኤህዳ ማስቶትያፐ ኤከትስ።<verse eid="EXO 38:8"/></para>
  <para style="s1">ጌሻ ዱንካነ ዳባባ</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9"/>ጌሻ ዱንካንያስ ዳባባ ባጋ ገቻናዉ አልኦ ሊኖፐ ማጋራጆ ኦስ። ዱገሀ ባጋ ገሸታስ አዱሳተይ ፄቱ ዋ። <verse eid="EXO 38:9"/><verse number="10" style="v" sid="EXO 38:10"/>ገሸታስ ካተ ግዳና መላ ላታሙ ቱሳታነ ኤንቲ ኤቅያ ቶሆታ ናሰ ብራታፐ ኦስ። ኤንታ ፃምአታነ ካጨታ ብራ ብራታፐ ኦስ። <verse eid="EXO 38:10"/><verse number="11" style="v" sid="EXO 38:11"/>ፑደሀ ባጋ ዳባባይካ ሄሳዳ ሀንድ ኦሰትስ። <verse eid="EXO 38:11"/><verse number="12" style="v" sid="EXO 38:12"/>ዉሎሀ ባጋ ገሸታ አዱሳተይ እሻታሙ ዋ። ኤንታዉ ታሙ ቱሳትነ ቱሳት ኤቅያ ታሙ ቶሆት ደኦሶና። ቱሳታስ ብራ ብራታፐ ኦሰትዳ ፃምአትነ ካጨት ደኦሶና። <verse eid="EXO 38:12"/><verse number="13" style="v" sid="EXO 38:13"/>ዳባባ ገልያ ፐንገይ ደእያ፥ ዶሎሀ ባጋ ማጋራጁዋ ጎምፓይ እሻታሙ ዋ። <verse eid="EXO 38:13"/><verse number="14" style="v" sid="EXO 38:14"/>እስ ባጋራ ደእያ ማጋራጁዋ አዱሳተይ ታማነ እቻሹ ዋ። እያዉ ሄ ቱሳትነ ቱሳት ኤቅያ ቶሆት ደኦሶና። <verse eid="EXO 38:14"/><verse number="15" style="v" sid="EXO 38:15"/>ሀንኮ ባጋራ ደእያ ማጋራጁዋ አዱሳተይ ታማነ እቻሹ ዋ። እያዉ ሄ ቱሳትነ ቱሳት ኤቅያ ቶሆት ደኦሶና። <verse eid="EXO 38:15"/><verse number="16" style="v" sid="EXO 38:16"/>ዳባባ ዩሹዋን ደእያ ገሸት ኡባይ አልኦ ሊኖፐ ኦሰትዶሶና። <verse eid="EXO 38:16"/><verse number="17" style="v" sid="EXO 38:17"/>ቱኡሳት ኤቅያ ቶሆት ናሰ ብራታፐ ኦሰትዶሶና። ፃምአት፥ ካጨትነ ቱሳታ ፄራ ጎሳት ብራ ብራታፐ ኦሰትዶሶና። ዳባባ ዩሹዋን ደእያ ቱሳት ኡባይ ብራ ፃምአታን ኦይከትዶሶና። <verse eid="EXO 38:17"/><verse number="18" style="v" sid="EXO 38:18"/>ዳባባ ፐንግያን ደእያ ማጋራጁዋ አልኦ ሊኖፐ ኦድ፥ ካሎሰን ኦቻ ቴራ ዳነይሳንነ ዞኦ ቃጭናን ዳድድ አሌቅስስ። እያዉ ሀንኮ ዳባባ ገሸታዳ አዱሳተይ ላታሙ ዋ፤ ቃስ ጌሳይ እቻሹ ዋ። <verse eid="EXO 38:18"/><verse number="19" style="v" sid="EXO 38:19"/>እያ፥ ኦይዱ ቶሆት ደእያ ኦይዱ ቱሳታ ቦላ ካቅስ። ካጨት፥ ፃራ ካመይሳትነ ፃምአት ብራ ብራታፐ ኦሰትዶሶና። <verse eid="EXO 38:19"/><verse number="20" style="v" sid="EXO 38:20"/>ጌሻ ዱንካንያ ሸትነ እያ ዩሹዋን ደእያ ገሸታ ሸት ኡባይ ናሰ ብራታፐ ኦሰትዶሶና።<verse eid="EXO 38:20"/></para>
  <para style="s1">ጌሻ ዱንካነን ጎኤትያ ብራታ ሚሸታ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21"/>ታሙ ኪታታ ኦይክዳ ናምኡ ሎቸ ሹቻት ደእያ በሳን፥ ጌሻ ዱንካንያን፥ ጎኤትያ ሚሸታ ማዝጋበይ ሀይሳ። ሄ ሚሸታ ማዝጋባና መላ ካህንያ አሮና ናአ እታማራ አዋተ ጋርሳን ደእያ ሌወታ ሙሰይ ኪትስ።<verse eid="EXO 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 38:22"/>ይሁዳ ሼሻፐ ግድዳ ሁራ ናኣ ናኣ፥ ኡረ ናኣ፥ ባስልኤል፥ ጎዳይ ኪትዳይሳዳ ኡባባ ኦስ። <verse eid="EXO 38:22"/><verse number="23" style="v" sid="EXO 38:23"/>ዳነ ሼሻፐ ግድዳ አህሳማካ ናኣ ኤልያብ፥ ኩሸ ሂላንቾይ፥ ኦያባስ ኮይሮ ሀልቾ ከስያ አስ፤ እ፥ ካሎሰ፥ ኦቻ ቴራ ዳነይሳነ ዞኦ ቃጭናን አልኦ ሊኖ ዳድድ አሌቅስያ አስ። <verse eid="EXO 38:23"/><verse number="24" style="v" sid="EXO 38:24"/>ጌሻ ዱንካንያ ኦሱዋስ ሀናና መላ ጎዳስ እመትዳ ዎርቃይ ጌሻ ዱንካነን ኤረትዳ ምዛነን እስ ሙኩሉ ክሎ ግራመ ግድስ። <verse eid="EXO 38:24"/><verse number="25" style="v" sid="EXO 38:25"/>ታይቦን ደእያ አሳፐ ኤከትዳ ብራይ ጌሻ ዱንካነን ኤረትዳ ምዛነን፥ ሄ ሙኩሉነ ኦይዱ ፄታነ ሀስታሙ ክሎ ግራመ ግድስ። <verse eid="EXO 38:25"/><verse number="26" style="v" sid="EXO 38:26"/>ሄስካ፥ ታይቦን ገልዳ አደ አሳይ፥ እሶይ እሶይ ጌሻ ዱንካነን ኤረትዳ ምዛንያ ልከን ኮየትያ ኡባ እምዶሶና። ላታሙ ላይነ እያፐ ቦላ ግድዳ፥ ማዝጋበን ገልዳ፥ አደ አሳ ታይቦይ ኡሱፑን ፄታነ ሄ ሙኩሉነ እቻሹ ፄታነ እሻታማ። <verse eid="EXO 38:26"/><verse number="27" style="v" sid="EXO 38:27"/>ጌሻ ዱንካንያነ ማጋራጆታ ኤሳናዉ ማድያ ፄቱ ቶሆታ ኦናዉ 3,400 ክሎ ግራመ ብራ ብራታ ኤክዶሶና። ሄስካ፥ እስ እስ ቶሆይ ሀስታማነ ኦይዱ ክሎ ግራመ ብራ ብራታ ኤክስ። <verse eid="EXO 38:27"/><verse number="28" style="v" sid="EXO 38:28"/>ባስልኤል፥ አትዳ ሀስታሙ ክሎ ግራመ ብራ ብራታን ፃምአታ፥ ካጨታነ ቱሳታስ ፄራ ጎሳታ ኦስ። <verse eid="EXO 38:28"/><verse number="29" style="v" sid="EXO 38:29"/>አሳይ ጎዳስ እምዳ ናሰ ብራታይ 2,425 ክሎ ግራመ። <verse eid="EXO 38:29"/><verse number="30" style="v" sid="EXO 38:30"/>ሄ ናሰ ብራታን ጌሻ ዱንካንያ ፐንግያ ኤስያ ቶሆታ፥ ግተ ዳንያባራ ናሰ ብራታ ያርሾ በሳነ እያ ግዶን ጎኤትያ ዱማ ዱማ ሚሸታ መስ። <verse eid="EXO 38:30"/><verse number="31" style="v" sid="EXO 38:31"/>ቃስ ዳባባ ዩሹዋን ደእያ ድርሳ ቶሆትነ ፐንግያ ቦላ ኤቅዳ ቶሆት፥ ጌሻ ዱንካነይነ እያ ዩሹዋን ደእያ ዳባባ ድርሳ ሸት ኡባይ ሄ ናሰ ብራታፐ ኦሰትዶሶና።<verse eid="EXO 38:31"/></para>
  <chapter eid="EXO 38"/>
  <chapter number="39" style="c" sid="EXO 39"/>
  <para style="s1">ካህነታ ማኦ</para>
  <para style="r">(<ref loc="EXO 28:1-14">ከሳ 28:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1"/>ካህነት ጌሻ ዱንካንያን ኦያ ዎደ ማአና ቦንቾ ማኦታ፥ ካሎሰን፥ ኦቻ ቴራ ዳንያ ቃጭናፐነ ዞኦ ቃጭናን ዳድዶሶና። አሮን ማእያ ካህነተ ማኡዋ ጎዳይ ሙሰ ኪትዳይሳዳ ኦዶሶና።<verse eid="EXO 39:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 39:2"/>ቃስ ኤፉድያ፥ ዎርቃፈ፥ ካሎሰፐ፥ ኦቻ ቴራ ዳንያ ቃጭናፐ፥ ዞኦ ቃጭናፐነ አልኦ ሊኖፐ ዳድዶሶና። <verse eid="EXO 39:2"/><verse number="3" style="v" sid="EXO 39:3"/>ኤንቲ ዎርቃ ቆፅድ፥ ሌእስድ፥ እያ ቃራርድ፥ ቃጭናዳ ከስዶሶና። ያትድ ካሎሰን፥ ኦቻ ቴራ ዳነይሳን፥ ዞኦ ቃጭናንነ አልኦ ሊኖን አሌቅስድ ዳድዶሶና። <verse eid="EXO 39:3"/><verse number="4" style="v" sid="EXO 39:4"/>ኤንቲ ናምኡ ሀሽያራ ዎድ፥ ናምኡ ባጋ ዎል ጋድ ኦይሰናዉ ማድያ ቃንጎታ ኤፉድያስ ኦዶሶና። <verse eid="EXO 39:4"/><verse number="5" style="v" sid="EXO 39:5"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ ሂላንቾይ አሌቅስዳ ዳንጮይካ ኤፉደይ ኦሰትዳይሳታፐ ኦሰትድ፥ ዎርቃን፥ ካሎሰን፥ ኦቻ ቴራ ዳነይሳን፥ ዞኦ ቃጭናንነ አልኦ ሊኖን ዳደትስ። <verse eid="EXO 39:5"/><verse number="6" style="v" sid="EXO 39:6"/>ኤንቲ ማርግደ ጌተትያ ሹቻታ ጊግስድ፥ ዎርቃፈ ኦሰትዳ ካቁዋ ቦላ ዎዶሶና። ማታመ ቦላ ዎጭድ ፃፈይሳዳ፥ ሄ ሹቻታ ቦላ እስራኤለ ናይታ ሱን ዎጭድ ፃፍዶሶና። <verse eid="EXO 39:6"/><verse number="7" style="v" sid="EXO 39:7"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ ታማነ ናምኡ እስራኤለ ናይታ ቆፍስያባ ግዳና መላ ኤንታ፥ ኤፉድያ ቃንጎታን ዎዶሶና።<verse eid="EXO 39:7"/></para>
  <para style="s1">ትራን ማኤትያ ማኦ</para>
  <para style="r">(<ref loc="EXO 28:15-30">ከሳ 28:15-30</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8"/>ኤንቲ፥ ትራን ማኤትያ ማኡዋ ኤፉደይ ኦሰትዳይሳታፐ ኦድ፥ ኤፉድያዳ አሌቅስዶሶና። <verse eid="EXO 39:8"/><verse number="9" style="v" sid="EXO 39:9"/>እያዉ ኦይዱ ማዛነት ደኦሶና፤ ጌሳይነ ጎምፓይ እስ እስ ታካ ግድድ፥ ዳኮየቴስ። <verse eid="EXO 39:9"/><verse number="10" style="v" sid="EXO 39:10"/>እያ ቦላ ኦይዱ ማራን እንቆ ጌተትያ አልኦ ሹቻታ ዎዶሶና። ኮይሮ ማራን ሳርድዮነ፥ ቶጳዘነ ጶልያ አልኦ ሹቻታ፤ <verse eid="EXO 39:10"/><verse number="11" style="v" sid="EXO 39:11"/>ናምአን ማራን ባሉረ፥ ሳንፓረነ አልማዘ ጌተትያ አልኦ ሹቻታ፤ <verse eid="EXO 39:11"/><verse number="12" style="v" sid="EXO 39:12"/>ሄን ማራን ያክንተ፥ ከልቀዶነነ አመተስፅኖሳ ጌተትያ አልኦ ሹቻታ፤ <verse eid="EXO 39:12"/><verse number="13" style="v" sid="EXO 39:13"/>ኦይዳን ማራን ብርለ፥ ማርግደነ ያስጵደ ጌተትያ አልኦ ሹቻታ ዎዶሶና። ሄሳታ ኡባ ዎርቃፈ ኦሰትዳ ካቁዋ ቦላ ዎዶሶና። <verse eid="EXO 39:13"/><verse number="14" style="v" sid="EXO 39:14"/>ታማነ ናምኡ ሹቻታ ቦላ እስ እስ እስራኤለ ናይታ ሱንይ ዎጨትድ ፃፈትስ።<verse eid="EXO 39:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 39:15"/>ትራን ማኤትያ ማኡዋስ ዋላህ ባይና ዎርቃፈ ዎዶሮዳ ዶቃዳ ሳንላታ ኦ። <verse eid="EXO 39:15"/><verse number="16" style="v" sid="EXO 39:16"/>ናምኡ ዎርቃ ካቆታነ ናምኡ ዎርቃ ሳጋዮታ መድ፥ ናምኡ ዎርቃ ሳጋዮታ ትራን ማኤትያ ማኡዋስ ቆሞ ባጋን ደእያ ማዛነታራ ጋድ ኦይሰዶሶና። <verse eid="EXO 39:16"/><verse number="17" style="v" sid="EXO 39:17"/>ሄ ናምኡ ዎርቃ ሳንላታታ ናምኡ ዎርቃ ሳጋዮታራ ጋድ ኦይሰዶሶና። <verse eid="EXO 39:17"/><verse number="18" style="v" sid="EXO 39:18"/>ሄ ሳንላታታ፥ ሀንኮ ባጋ ፄራ፥ ናምኡ ካቆታራ ጋሰዶሶና። ያትድ፥ ኤፉድያስ ስን ባጋራ፥ ሀሽያራ ዎያ ቃንጎታራ ጋድ ቃችዶሶና። <verse eid="EXO 39:18"/><verse number="19" style="v" sid="EXO 39:19"/>ቃስ ናምኡ ዎርቃ ሳጋዮታ መድ፥ ኤፉድያስ ስን ባጋራ ደእያ ትራን ማኤትያ ማኡዋስ፥ ጋ ባጋራ ደእያ ናምኡ ማዛነታ ፄራን አዶሶና። <verse eid="EXO 39:19"/><verse number="20" style="v" sid="EXO 39:20"/>ሄሳዳካ፥ ዎርቃፈ ሀራ ናምኡ ምግዶታ ኦዳ፥ ኤፉድያስ ስን ባጋ ሀሽያራ ዎያ ቃንጉዋስ ጋርሳ ባጋራ፥ ስኩዋ ማታን ዳንጩዋፈ ቆሞ ባጋራ ኦይሰዶሶና። <verse eid="EXO 39:20"/><verse number="21" style="v" sid="EXO 39:21"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ ትራን ማኤትያ ማኡዋ ቦላ ደእያ ምግዶታ ኤፉድያን ደእያ ምግዶታራ ጋድ፥ ካሎሰ ቃጭና ቃችዶሶና። ትራን ማኤትያ ማኦይ ፄሳፈ ቆሞን ፔእያ ግሾ ቃሾይ ዶልኤና።<verse eid="EXO 39:21"/></para>
  <para style="s1">ሀራ ካህነ ማኦታ</para>
  <para style="r">(<ref loc="EXO 28:31-43">ከሳ 28:31-43</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22"/>ኤፉድያፐ ቦላራ ማኤትያ አዱሳ ማኦይ ኩመ ካሎሰ አፍላፐ ጊግስዶሶና። <verse eid="EXO 39:22"/><verse number="23" style="v" sid="EXO 39:23"/>ሄ አዱሳ ማኡዋስ ሁጰ አያ ሉሆ መድ፥ ፔቶና መላ ጉየ ቃላምእድ፥ ዩሽ አድ ስክዶሶና። <verse eid="EXO 39:23"/><verse number="24" style="v" sid="EXO 39:24"/>አዱሳ ማኡዋስ ዱገ ባጋ ማጫራ ዩሹዋን ካሎሰን፥ ኦቻ ቴራ ዳንያ ዞኦ ቃጭናንነ አልኦ ሊኖን፥ ኦሮማነ ቴራ ምስለታ መዶሶና። <verse eid="EXO 39:24"/><verse number="25" style="v" sid="EXO 39:25"/>ኤንቲ ዋላህ ባይና ዎርቃፈ ዳላታ መድ፥ አዱሳ ማኡዋስ ዱገ ባጋ ጋፃን፥ ኦሮማነ ምስለታ ግዶን ዎዶሶና። <verse eid="EXO 39:25"/><verse number="26" style="v" sid="EXO 39:26"/>ጎዳይ ሙሰ ኪትዳይሳዳ፥ ኦሮማነ ቴራ ምስለታ፥ አዱሳ ማኡዋስ ዱገ ባጋ ማጫራ ዩሹዋን አዶሶና።<verse eid="EXO 39:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 39:27"/>ኤንቲ፥ ጎዳይ ሙሰ ኪትዳይሳዳ፥ አሮናስነ እያ ናይታስ፥ ሻምዘታ፥ <verse eid="EXO 39:27"/><verse number="28" style="v" sid="EXO 39:28"/>ሁጰ ቃጨታ፥ ኡከታነ ጋ ሱረታ አልኦ ሊኖፐ ዳድድ ጊግስዶሶና። <verse eid="EXO 39:28"/><verse number="29" style="v" sid="EXO 39:29"/>ቃስ ዳንጩዋ ካሎሰን፥ ኦቻ ቴራ ዳንያ ቃጭናን፥ ዞኦ ቃጭናንነ አልኦ ሊኖን አሌቅስድ፥ ጊግስዶሶና።<verse eid="EXO 39:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 39:30"/>ኤንቲ፥ ጌሻ ካላቻ ምስልያ ዋላህ ባይና ዎርቃፈ መድ፥ እያ ቦላ፥ “ጎዳስ ዱማትስ” ግያ ቃላ ዎጭድ ፃፍዶሶና። <verse eid="EXO 39:30"/><verse number="31" style="v" sid="EXO 39:31"/>ያትድ፥ ጎዳይ ሙሰ ኪትዳይሳዳ፥ ሁጰ ቃጭያ ቦላ ካሎሰ ቃጭናራ ቃችዶሶና።<verse eid="EXO 39:31"/></para>
  <para style="s1">ኦሶይ ጋፃ ጋከ</para>
  <para style="r">(<ref loc="EXO 35:10-19">ከሳ 35:10-19</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32"/>ጌሻ ዱንካንያ ኦሶ ኡባይ ኩመ ፖለትስ። እስራኤለ አሳይ፥ ጎዳይ ሙሰ ኪትዳይሳዳ ኦዶሶና። <verse eid="EXO 39:32"/><verse number="33" style="v" sid="EXO 39:33"/>ሄሳፈ ጉየ፥ ኤንቲ ጌሻ ዱንካንያነ እያ ሚሸታ ሙሰኮ ኤህዶሶና። ሄሳትካ፥ ካጨታ፥ ቱሳታ፥ ልዮታ፥ ቱቀታነ ኤንቲ ኤቅያ ቶሆታ። <verse eid="EXO 39:33"/><verse number="34" style="v" sid="EXO 39:34"/>ቦላ ካማስ፥ ዞኦ ቃላመን የግድ ከስዳ ዶርሳ እተ፥ ሃሸትዳ ዶአ እተ፥ ማጋራጁዋ፥ <verse eid="EXO 39:34"/><verse number="35" style="v" sid="EXO 39:35"/>ታሙ ኪታታ ኦይክዳ ታቦትያ፥ እያ ቶክያ ካሶ ምታነ ናጋራ አቶተ ካማ፥ <verse eid="EXO 39:35"/><verse number="36" style="v" sid="EXO 39:36"/>ፃርጴዛነ እያ ሚሸታ ኡባ፥ ጎዳ ስንን ደእያ ጌሻ ዳቡዋ፥ <verse eid="EXO 39:36"/><verse number="37" style="v" sid="EXO 39:37"/>ዋላህ ባይና ዎርቃፈ ኦሰትዳ ፆምፐ ዎያ ኮጫ፥ እያ ቦላ ደእያ ፆምፐታ፥ እያ ሚሸታ ኡባነ ፆምፐ ዛይተ፥ <verse eid="EXO 39:37"/><verse number="38" style="v" sid="EXO 39:38"/>ዎርቃፈ ኦሰትዳ ያርሾ በሲ፥ ሹማተ ዛይተ፥ ሳውያ እፃነ፥ ጌሻ ዱንካንያ ፐንገ ማጋራጁዋ፥ <verse eid="EXO 39:38"/><verse number="39" style="v" sid="EXO 39:39"/>ናሰ ብራታፐ ኦሰትዳ ያርሾ በሲ፥ ናሰ ብራታ ተቅያ፥ ቶሆ ካሶ ምታነ እያ ሚሸታ ኡባ፥ ሜቻ ከረነ እያ ዎይሳ፥ <verse eid="EXO 39:39"/><verse number="40" style="v" sid="EXO 39:40"/>ዳባባ ገልያ ፐንገ ማጋራጁዋ፥ ቱሳታነ፥ ኤንቲ ኤቅያ ቶሆታ፥ ዳባባ ማጋራጁዋ፥ ቶለ ዎዶሮታ፥ ሸታ፥ ጌሻ ዱንካንያን ጎኤትያ ሚሸታ ኡባ፥ <verse eid="EXO 39:40"/><verse number="41" style="v" sid="EXO 39:41"/>ካህነት ጌሻ በሳን ማእያ ቦንቾ ማኦታ፥ አሮንነ እያ ናይት ማእያ ካህነተ ማኦታ።<verse eid="EXO 39:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 39:42"/>እስራኤለ አሳይ ኦሶ ኡባ፥ ጎዳይ ሙሰ ኪትዳይሳዳ ኦዶሶና። <verse eid="EXO 39:42"/><verse number="43" style="v" sid="EXO 39:43"/>አሳይ፥ ኦሶ ኡባ፥ ጎዳይ ኪትዳይሳዳ ኦዳይሳ ሙሰይ በእስ። ሄሳ ግሾ፥ ሙሰይ ኤንታ አንጅስ።<verse eid="EXO 39:43"/></para>
  <chapter eid="EXO 39"/>
  <chapter number="40" style="c" sid="EXO 40"/>
  <para style="s1">ጌሻ ዱንካነ ቶከ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1"/>ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤ <verse eid="EXO 40:1"/><verse number="2" style="v" sid="EXO 40:2"/>“ኮይሮ አጌናን፥ ኮይሮ ጋላሳን፥ ጌሻ ዱንካንያ ቶካ። <verse eid="EXO 40:2"/><verse number="3" style="v" sid="EXO 40:3"/>ታሙ ኪታታ ኦይክዳ ጫቆ ታቦትያ እያ ግዶን ዎዳ፥ እያ ስንን ማጋራጁዋ ካቃ። <verse eid="EXO 40:3"/><verse number="4" style="v" sid="EXO 40:4"/>ፃርጴዛ ጋ ገልሳዳ፥ ኮሽያ ሚሸታ ኡባ እያ ቦላ ዎ። ፆምፐ ዎያ ኮጫ ገልሳዳ እያ ቦላ ፆምፐታ ዎ። <verse eid="EXO 40:4"/><verse number="5" style="v" sid="EXO 40:5"/>እፃነ ጩይስያ ዎርቃ ፃርጴዛ ጫቆ ታቦትያ ስንን ዎ። ጌሻ ዱንካንያ ፐንገ ማጋራጁዋ ካቃ። <verse eid="EXO 40:5"/><verse number="6" style="v" sid="EXO 40:6"/>ፁሳ ያርሾ በሲ ጌሻ ዱንካንያ ስንን ዎ። <verse eid="EXO 40:6"/><verse number="7" style="v" sid="EXO 40:7"/>ሜቻ ከርያ ጌሻ ዱንካንያፐነ ያርሾ በሳፈ ግዶን ዎዳ፥ እያን ሃ ኩን። <verse eid="EXO 40:7"/><verse number="8" style="v" sid="EXO 40:8"/>ጌሻ ዱንካንያፐ ካረራ ዳባባ ዩሻ አ ጊግሳዳ፥ ማጋራጁዋ ዱንካንያ ፐንገ ቦላ ካቃ።<verse eid="EXO 40:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9"/>“ያታዳ፥ ጌሻ ዛይትያ ኤካዳ፥ ጌሻ ዱንካንያነ እያ ግዶን ደእያ ኡባባ ትያዳ፥ ዱማያ፤ እ ጌሽ ግዳና። <verse eid="EXO 40:9"/><verse number="10" style="v" sid="EXO 40:10"/>ካላዳ፥ ፁሳ ያርሾ በስነ እያን ጎኤትያ ሚሸ ኡባ ትያዳ፥ ዱማያ፤ እ ፖሎ ጌሽ ግዳና። <verse eid="EXO 40:10"/><verse number="11" style="v" sid="EXO 40:11"/>ሜቻ ከርያነ እያ ዎያ ሚሸታ ትያዳ፥ ዱማያ።<verse eid="EXO 40:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12"/>“አሮናነ እያ ናይታ ጌሻ ዱንካንያ ፐንገ ኤሀዳ ሃን ኤንታ ሜጫ። <verse eid="EXO 40:12"/><verse number="13" style="v" sid="EXO 40:13"/>ካህነ ማኡዋ አሮና ማይዛዳ፥ እ ታዉ ካህነተን ኦና መላ እያ ትያዳ፥ ዱማያ። <verse eid="EXO 40:13"/><verse number="14" style="v" sid="EXO 40:14"/>እያ አደ ናይታካ ኤሀዳ ሻምዘ ማይዛ። <verse eid="EXO 40:14"/><verse number="15" style="v" sid="EXO 40:15"/>ኤንቲ ታዉ ካህነተን ኦና መላ፥ ኤንታ አዋይ ትየትዳይሳዳ፥ ኤንታካ ትያ። ሄ ትሻ ጋሶን፥ ያና ላይ ኡባን፥ ኤንቲ ታዉ ካህነ ግድድ ኦና” ያግስ።<verse eid="EXO 40:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 40:16"/>ሙሰይ፥ ኡባባ ጎዳይ ኪትዳይሳዳ ኦስ።<verse eid="EXO 40:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 40:17"/>ሄሳ ግሾ፥ ኤንቲ ግብፀፈ ከይዳ ናምአን ላይን፥ ኮይሮ አጌናን፥ ኮይሮ ጋላሳን ጌሻ ዱንካንያ ቶክስ። <verse eid="EXO 40:17"/><verse number="18" style="v" sid="EXO 40:18"/>ሙሰይ፥ ዱንካንያ ቶሆታ ኤስስ፥ ቱቀታ፥ ልዮታነ ቱሳታ አስ። <verse eid="EXO 40:18"/><verse number="19" style="v" sid="EXO 40:19"/>ጎዳይ ኪትዳይሳዳ፥ ሙሰይ፥ ጋርሳ ካማነ ቦላ ካማ ዱንካንያ ቦላ ካምስ።<verse eid="EXO 40:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 40:20"/>ያትድ፥ ታሙ ኪታታ ኦይክዳ ናምኡ ሎቸ ሹቻታ፥ ታቦትያ ግዶን ዎስ። ቶሆ ካሶ ምታ ታቦትያ ሳጋዮታን አስ፤ ናጋራ አቶተ ካማካ ታቦትያ ቦላ ዎስ። <verse eid="EXO 40:20"/><verse number="21" style="v" sid="EXO 40:21"/>ታቦትያ ጌሻ ዱንካንያ ግዶ ገልስድ፥ ገሸ ማጋራጁዋ ካቅስ። ያትድ፥ ጎዳይ ኪትዳይሳዳ፥ ጫቆ ታቦትያ ካምስ።<verse eid="EXO 40:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 40:22"/>ሙሰይ፥ ፃርጴዛ ጌሻ ዱንካንያ ግዶ ገልስድ፥ ማጋራጁዋፈ ካረራ፥ ፑደሀ ባጋን ዎስ። <verse eid="EXO 40:22"/><verse number="23" style="v" sid="EXO 40:23"/>ጎዳይ ኪትዳይሳዳ፥ ጎዳ ስንን ዎያ ጌሻ ዳቡዋ እያ ቦላ ዎስ።<verse eid="EXO 40:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 40:24"/>ፆምፐ ዎያ ኮጫ፥ ጌሻ ዱንካንያ ግዶ ገልስድ፥ ፃርጴዛፐ ስን ባጋራ ጌሻ ዱንካንያስ ዱገሀ ባጋን ዎስ። <verse eid="EXO 40:24"/><verse number="25" style="v" sid="EXO 40:25"/>ጎዳይ ኪትዳይሳዳ፥ ሙሰይ፥ ጎዳ ስንን ፆምፐታ ኦይስ። <verse eid="EXO 40:25"/><verse number="26" style="v" sid="EXO 40:26"/>ሙሰይ፥ ዎርቃ ያርሾ በሳ ጌሻ ዱንካንያ ግዶ ገልስድ፥ ማጋራጁዋፈ ስን ባጋራ ዎስ። <verse eid="EXO 40:26"/><verse number="27" style="v" sid="EXO 40:27"/>ጎዳይ ኪትዳይሳዳ፥ ሳውያ እፃነ እያ ቦላ ጩይስስ። <verse eid="EXO 40:27"/><verse number="28" style="v" sid="EXO 40:28"/>ጌሻ ዱንካንያ ፐንገን ማጋራጁዋ ካቅስ።<verse eid="EXO 40:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 40:29"/>ፁሳ ያርሾ በሲ፥ ጌሻ ዱንካንያ ፐንገ ስንን ዎስ። ጎዳይ ኪትዳይሳዳ፥ እያ ቦላ ፁሳ ያርሾነ ካ ያርሾ ያርሽስ።<verse eid="EXO 40:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 40:30"/>ሜቻ ከርያ ጌሻ ዱንካንያፐነ ያርሾ በሳፈ ግዶን ዎድ፥ እያን ሃ ኩንስ። <verse eid="EXO 40:30"/><verse number="31" style="v" sid="EXO 40:31"/>ሙሰይ፥ አሮንነ እያ ናይት ባንታ ኩሽያነ ቶሁዋ እያን ሜጨትዶሶና። <verse eid="EXO 40:31"/><verse number="32" style="v" sid="EXO 40:32"/>ጎዳይ ኪትዳይሳዳ፥ ኤንቲ ጌሻ ዱንካንያ ገልያ ዎደ ዎይኮ ያርሾ በሲ ሺቅያ ዎደ ሄሳ ኦሶና።<verse eid="EXO 40:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 40:33"/>ጌሻ ዱንካንያነ ያርሾ በሳ ዩሽ አድ ዳባባ ጊግስድ፥ ሄ ዳባባ ፐንገን ማጋራጆ ካቅስ። ሄሳዳ ኦድ፥ ሙሰይ ኦሱዋ ፖልስ።<verse eid="EXO 40:33"/></para>
  <para style="s1">ጎዳ ቦንቹዋ</para>
  <para style="r">(<ref loc="NUM 9:15-23">ታይቦ 9:15-23</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34"/>ሄሳፈ ጉየ፥ ሻራይ ጌሻ ዱንካንያ ካምስ፤ ጎዳ ቦንቾይካ እያ ኩምስ።<note caller="-" style="x"><char style="xo" closed="false">40:34 </char><char style="xt" closed="false"><ref loc="1KI 8:10-11">1 ካዎ 8:10-11</ref>፤ <ref loc="ISA 6:4">እሳ 6:4</ref>፤ <ref loc="EZK 43:4-5">ህዝ 43:4-5</ref>፤ <ref loc="REV 15:8">ቆን 15:8</ref>.</char></note> <verse eid="EXO 40:34"/><verse number="35" style="v" sid="EXO 40:35"/>ሻራይ ጌሻ ዱንካንያ ካምዳ ግሾነ ጎዳ ቦንቾይ እያን ኩምዳ ግሾ፥ ሙሰይ እያ ግዶ ገላናዉ ዳንዳእቤና።<verse eid="EXO 40:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 40:36"/>እስራኤለት ባንታ ደእያ በሳ የድድ፥ ባናዉ ደንደይ፥ ሄ ሻራይ ዱንካንያፐ ደንድያ ዎደና። <verse eid="EXO 40:36"/><verse number="37" style="v" sid="EXO 40:37"/>ሽን ሻራይ ደንዶና እፅኮ፥ ኤንቲ ባንታ ደእያ በሳ የድድ ቦኮና። <verse eid="EXO 40:37"/><verse number="38" style="v" sid="EXO 40:38"/>ጎዳ ሻራይ ጋላስ ጋላስ ጌሻ ዱንካንያ ካሜስ፥ ቃማ ቃማ ቃስ ሻራ ግዶን ታማይ ኤፄስ። እስራኤለ አሳይ ብያ ዎደ ኡባን ሄ ሻራ በኦሶና።<verse eid="EXO 40:38"/></para>
  <chapter eid="EXO 40"/>
</usx>
