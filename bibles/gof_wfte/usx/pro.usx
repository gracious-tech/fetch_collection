<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- GOOFA FULL BIBLE</book>
  <para style="h">ሌምሶ ማፃፋ</para>
  <para style="toc1">ሌምሶ ማፃፋ</para>
  <para style="toc3">ሌም</para>
  <para style="toc2">ሌምሶ</para>
  <para style="mt">ሌምሶ ማፃፋ</para>
  <para style="imt">ጋ ቆፋ</para>
  <para style="ip">ሌምሶ ማፃፋይ ሀይሰነ ሌምሶ ኦዳን ጊግዳ፥ ዱሳ ዎጋነ አማኖ ትምርተ። ሀ ማፃፋፐ ዳሮ ባጋይ ጋላስ ጋላስ አሰ ጋክያ ሀኖታታ ኦዴስ። ማፃፋይ ኮይሮ ዶምሸ፥ “ፆሳስ ያሻተ ጭንጫተስ ኮይሮ” (1:7) ያግስ። ሀ ማፃፋይ ታማርሰይ፥ አማኖ ዎጋን አስ ኦናባ ፃላላ ግዶናሽን፥ አስ ባ ጋላሳ ዱሳን ሀናናዉ በሲያ ሎኦ ካንዱዋነ ኦናዉ በሲያ ሎኦ ኦሶ ጉጅድ ታማርሴስ።</para>
  <para style="ip">ሌምሶ ማፃፋታፐ ባጋይ አሳ ቡዞ ደኦባ ኦዴስ፤ ባጋይ እስ ሶ አሳ ዱሳባ ኦዴስ፤ ባጋይ ኦሶባነ ዛልኤባ ኦዴስ። ሌምሶ ማፃፋይ ፆሰ ቦንችያ አስ “ጭንጫ” ግድ፥ ፆሰ ኤሮና አስ “ኤያ” ጌስ። ሌምሶ ማፃፋይ አሽከተባ፥ ጭንጫተባ፥ ዳንዳአባ ቃባነ አማነተባ ዳሮ ትምርተ ታማርሴስ።</para>
  <para style="iot">ማፃፋ አይፈ ቆፋታ</para>
  <para style="io1">ሌምሶታ ጎአ (<char style="ior"><ref loc="PRO 1:1-9:18">1:1—9:18</ref></char>)</para>
  <para style="io1">ሶሎሞነ ሌምሶታ (<char style="ior"><ref loc="PRO 10:1-24:34">10:1—24:34</ref></char>)</para>
  <para style="io1">ዱማ ዱማ ሌምሶታ (<char style="ior"><ref loc="PRO 25:1-29:27">25:1—29:27</ref></char>)</para>
  <para style="io1">አጉራ ሌምሶታ (<char style="ior"><ref loc="PRO 30:1-33">30:1-33</ref></char>)</para>
  <para style="io1">ልሙኤላ አየ ትምርተ (<char style="ior"><ref loc="PRO 31:1-31">31:1-31</ref></char>)</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="s1">ሌምሶ ጎአ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>ሀይሳቲ እስራኤለ ካዋ ዳዊታ ናኣ ሶሎሞነ ሌምሶታ። <verse eid="PRO 1:1"/><verse number="2" style="v" sid="PRO 1:2"/>ሌምሶት አሳይ ጭንጫተ፥ ሴራነ ኤራ ሃሳያ አኬካናዉ ማዶሶና። <verse eid="PRO 1:2"/><verse number="3" style="v" sid="PRO 1:3"/>ኤንቲ ጭንጫተ፥ ፅሎተ፥ ሱረ ፕርድነ ሱረ ዎዛን ዳና መላ ታማርሶሶና። <verse eid="PRO 1:3"/><verse number="4" style="v" sid="PRO 1:4"/>ኤያታስ አኬካ እሜስ፤ ናአተታስ ኤራተነ ካሃማተ እሜስ። <verse eid="PRO 1:4"/><verse number="5" style="v" sid="PRO 1:5"/>ጭንጫት ሀ ሌምሶታ ስእድ፥ ኤራ ጉጆሶና፤ አኬካንቾት ሎኦ ዞረ ኤኮሶና። <verse eid="PRO 1:5"/><verse number="6" style="v" sid="PRO 1:6"/>ሄሳን ሌምሶታነ ኤንታ ብርሸ፥ ጭንጫተ ኦዳነ ኤንታ ቃንእሸታ አኬካናዉ ዳንዳኤቴስ።<verse eid="PRO 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 1:7"/>ጎዳስ ያሽ ጭንጫተስ ዶመ፤ ሽን ኤያት ጭንጫተነ ሴራ ካኦሶና።<verse eid="PRO 1:7"/></para>
  <para style="s1">ጭንጫተ ነዉ ሚሸ ኦ</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>ታ ናአዉ፥ ነ አዋ ዞርያ ስአ፤</para>
  <para style="q2" vid="PRO 1:8">ነ አየ ትምርትያ ካፓ።<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>ሄስ ነ ሁጵያስ ቦንቾ ካላቻ፤</para>
  <para style="q2" vid="PRO 1:9">ነ ቆያስ ጎዝዳ ግዳና።<verse eid="PRO 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 1:10"/>ታ ናአዉ፥ ነና ናጋራንቾት</para>
  <para style="q2" vid="PRO 1:10">ጭምኮ ኤሮ ጎፓ።<verse eid="PRO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>ኤንቲ፥ “ኑራ የ፤</para>
  <para style="q2" vid="PRO 1:11">አሰ ዎናዉ ሆክድ ናጎስ፤</para>
  <para style="q2" vid="PRO 1:11">ፅሎታ ዎናዉ ቆሰቶስ።<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>ስኦለይ ምተይሳዳ ኑካ ኤንታ ፓፃ ምቶስ፤</para>
  <para style="q2" vid="PRO 1:12">ኑ ኤንታ ኦላን የገትያ አሳዳ ኦና።<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>ኑኒ አልኦ ሚሸ ኡባ ደማና፤</para>
  <para style="q2" vid="PRO 1:13">ኑ ኬ ቦንቀ ሚሸን ኩንና።<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>ኑራ ላገታ፤</para>
  <para style="q2" vid="PRO 1:14">ኑ ደምዳባ እስፈ ሻከታና” ያጋና።<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>ታ ናአዉ፥ ኤንታራ ሄመቶፋ፤</para>
  <para style="q2" vid="PRO 1:15">ኤንታ ኦግያራ ባናዉ ነ ቶሁዋ ደንፋ።<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>ኤንቲ ኢታባ ኦናዉ ዎፆሶና፤</para>
  <para style="q2" vid="PRO 1:16">አሳ ሱ ጉሳናዉ ያ ሃ ጎሶና።<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>ካፎይ ፄልሽን፥</para>
  <para style="q2" vid="PRO 1:17">እያ ኦይካናዉ ግተ የገ ማደና።<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>ሽን ኤንቲ ባንታ ሱ ጉሳናዉ ሆኮሶና፤</para>
  <para style="q2" vid="PRO 1:18">ባንታ ሸምፑዋ ዎናዉ ቆሰቶሶና።<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>ገነን ጎአ ደምያ አሳ ዉርሰ ሄሳ መላ፤</para>
  <para style="q2" vid="PRO 1:19">ኤንቲ ሺሽዳ ሻሎይ ኤንታ ሸምፑዋ ኤኬስ።<verse eid="PRO 1:19"/></para>
  <para style="s1">ጭንጫተ ፄጌስ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>ጭንጫተ ዳጋላ ቦላ ኤቃዳ ፄጋዉሱ፤</para>
  <para style="q2" vid="PRO 1:20">ዳባባን ባ ቃላ ቁ ኦዳ ስሳዉሱ። <verse eid="PRO 1:20"/><verse number="21" style="v" sid="PRO 1:21"/>ጭንጫተ አስ ሺቅያ በሳን ኤቃዳ ፄጋዉሱ፤</para>
  <para style="q2" vid="PRO 1:21">ካታማ ገልያ ፐንገን ኤቃዳ ሀይሳዳ ያጋዉሱ።<verse eid="PRO 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>“ህንተኖ፥ አኬክ ፓጭዳይሳቶ፥</para>
  <para style="q2" vid="PRO 1:22">ህንተ አዉደ ጋካናዉ ኤያ ግድድ ዳኔ?</para>
  <para style="q1" vid="PRO 1:22">ቀልቅሰይሳቶ፥ አዉደ ጋካናዉ ኡፋይታኔ?</para>
  <para style="q2" vid="PRO 1:22">ኤያቶ፥ አዉደ ጋካናዉ ኤራተ እፃኔ?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>ታ ሴራ ህንተ ስእዳባ ግድያኮ፥</para>
  <para style="q2" vid="PRO 1:23">ታኒ ታ ኤራ ህንተ ቦላ ጉሳና፤</para>
  <para style="q2" vid="PRO 1:23">ታ ቃላካ ህንተና ታማርሳና።<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>ሽን ታ ፄግዳ ዎደ ህንተ ኮዮና እፅዳ ግሾ፤</para>
  <para style="q2" vid="PRO 1:24">ታኒ ኩሸ ምጭን ኦንካ አኬክቦና ግሾ፤<verse eid="PRO 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25"/>ታ ዞርያ ህንተ ካዳ ግሾ፤</para>
  <para style="q2" vid="PRO 1:25">ታ ሴራካ ኤክቦና ግሾ፤<verse eid="PRO 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26"/>ህንተና መቶይ ጋክያ ዎደ ታ ሚጫና፤</para>
  <para style="q2" vid="PRO 1:26">ህንተ ዳጋማን ኮኮርያ ዎደ ታ ቀልቅሳና። <verse eid="PRO 1:26"/><verse number="27" style="v" sid="PRO 1:27"/>ጋዶይ ኡሾዳ ህንተ ቦላ ያ ዎደ፥</para>
  <para style="q2" vid="PRO 1:27">መቶይ ጎተዳ ህንተ ቦላ ኤቅያ ዎደ፥</para>
  <para style="q2" vid="PRO 1:27">ኡንእነ ዋየይ ህንተ ቦላ ጋክያ ዎደ፥</para>
  <para style="q2" vid="PRO 1:27">ታኒ ህንተና ቀልቅሳና።<verse eid="PRO 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 1:28"/>“ሄ ዎደ ኤንቲ ታና ፄጋና፤ ሽን ታ ኮይከ፤</para>
  <para style="q2" vid="PRO 1:28">ኤንቲ ታና ምንድ ኮያና፤ ሽን ደሞኮና። <verse eid="PRO 1:28"/><verse number="29" style="v" sid="PRO 1:29"/>ኤንቲ ኤራተ እፅዳ ግሾ፤</para>
  <para style="q2" vid="PRO 1:29">ጎዳ ያሽ ዶርቦና ግሾ፥ <verse eid="PRO 1:29"/><verse number="30" style="v" sid="PRO 1:30"/>ታ ዞርያ ኤክቦና ግሾ፤</para>
  <para style="q2" vid="PRO 1:30">ታ ሴራ ካዳ ግሾ፤ <verse eid="PRO 1:30"/><verse number="31" style="v" sid="PRO 1:31"/>ኤንቲ ባንታ ኦሱዋ አይፍያ ማና፤</para>
  <para style="q2" vid="PRO 1:31">ባንታ ቆፋ አይፍያ ካላና። <verse eid="PRO 1:31"/><verse number="32" style="v" sid="PRO 1:32"/>አኬክ ፓጭዳይሳታ ጭንጫተፈ ሃከይስ ዎስ፤</para>
  <para style="q2" vid="PRO 1:32">ኤያታ ቀል ጉስ ይሴስ። <verse eid="PRO 1:32"/><verse number="33" style="v" sid="PRO 1:33"/>ሽን ታ ኦድያባ ስእያ ኡባይ ሳሮ ዳና፤</para>
  <para style="q2" vid="PRO 1:33">መቶ ህርጋፈካ ሸምፓና።”<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">ጭንጫተ ጎአ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 2:1"/>ታ ናአዉ፥ ታ ትምርትያ ነ ኤክኮ፤</para>
  <para style="q2" vid="PRO 2:1">ታ ኪታ ነ ዎዛናን ዎኮ፤ <verse eid="PRO 2:1"/><verse number="2" style="v" sid="PRO 2:2"/>ነ ሀይ ጭንጫተኮ ዛርኮ፤</para>
  <para style="q2" vid="PRO 2:2">ነ ዎዛና አኬካኮ ዛርኮ፤<verse eid="PRO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3"/>ኤራተ ፄግኮ፤</para>
  <para style="q2" vid="PRO 2:3">አኬካ ቁ ኦዳ ፄግኮ፤<verse eid="PRO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4"/>ብራ ዎይኮ ጌምዳ ሚሸ ኮየይሳዳ፥</para>
  <para style="q2" vid="PRO 2:4">ኔኒ ኤራተ ኮይኮ፥<verse eid="PRO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5"/>ሄ ዎደ ኔኒ ጎዳስ ያሽ ጉስ አይበኮ ኤራና፤</para>
  <para style="q2" vid="PRO 2:5">ፆሳ ሎይዳ ኤራና።<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>ጎዳይ ጭንጫተ እሜስ፤</para>
  <para style="q2" vid="PRO 2:6">እያፐ ኤራተነ አኬክ በንቴስ።<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>እ ሱረታስ ማድያ ዞረ ምንጄስ፤</para>
  <para style="q2" vid="PRO 2:7">ቦረይ ባይናይሳታስ ጎንዳለ ግዴስ።<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>ሱረ ፕርዳ ኦግያ ናጌስ፤</para>
  <para style="q2" vid="PRO 2:8">እያዉ አማነተይሳታ ኦግያ ምንስ።<verse eid="PRO 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>ሄ ዎደ ኔኒ ፅሎተ፥ ሱረ ፕርዳ፥</para>
  <para style="q2" vid="PRO 2:9">ሱረ ኦገነ ሎኦ ኦሶይ አይበኮ አኬካና።<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>ጭንጫተ ነ ዎዛና ግዶ ገላና፤</para>
  <para style="q2" vid="PRO 2:10">ኤራተ ነዉ ኡፋይስ ግዳና።<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>ሻክድ ኤሮይ ነና ናጋና፤</para>
  <para style="q2" vid="PRO 2:11">አኬክ ነና ካማና።<verse eid="PRO 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>ጭንጫተ ነና ኢታ አሳታ ኦግያፐ ናጋና፤</para>
  <para style="q2" vid="PRO 2:12">ጌላ ኦዳፐ ነና አሻና።<verse eid="PRO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13"/>ኤንቲ ናጋራ ማን ዳናዉ፥</para>
  <para style="q2" vid="PRO 2:13">ፅሎተ ኦግያ አግዶሶና።<verse eid="PRO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14"/>ኢታ ኦሶን ኡፋይቶሶና፤</para>
  <para style="q2" vid="PRO 2:14">ጌላተን ሀሹ ጎሶና።<verse eid="PRO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15"/>ኤንታ ኦሶይ ምርቀ፤</para>
  <para style="q2" vid="PRO 2:15">ኤንታ ደኦይ ጌላ።<verse eid="PRO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>ጭንጫተ ላይማ ማጫሳፐ፥</para>
  <para style="q2" vid="PRO 2:16">ቃላን ጭምያ ላገፈ ነና አሻና።<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>እያ ባ ናአተ አዝና አጋጋሱ፤</para>
  <para style="q2" vid="PRO 2:17">ፆሳ ስንን ጫቅዳ ጫቁዋ ዶጋሱ።<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>እ ሶ ኦገይ ሀይቆኮ ጋስ፤</para>
  <para style="q2" vid="PRO 2:18">ኢኮ ቡስ ሞይትለታኮ ጋስ።<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>ኢኮ ብያ ኦንካ ጉየ ስመና፤</para>
  <para style="q2" vid="PRO 2:19">ደኦ ኦገ ደመና።<verse eid="PRO 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>ሄሳ አጋዳ፥ ሎኦ አሳታ ሌምሱዋ ካላ፤</para>
  <para style="q2" vid="PRO 2:20">ፅሎ አሳታ ሄመ ናጋ።<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>ሱረ አሳትነ ቦረይ ባይናይሳት፥</para>
  <para style="q2" vid="PRO 2:21">ቢታን አዱሳ ላይ ዳና።<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>ሽን ኢታት ቢታፈ ሾደታና፤</para>
  <para style="q2" vid="PRO 2:22">አማነቶናይሳት ያና።<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">ጎዳን አማነታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>ታ ናአዉ፥ ታ ትምርትያ ዶጎፓ፤</para>
  <para style="q2" vid="PRO 3:1">ታ ኪታ ነ ዎዛናን ዎ።<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>ኤንቲ ነ ላይ አዱሳና፤</para>
  <para style="q2" vid="PRO 3:2">እንጀነ ሳሮተ ነዉ ጉጃና።<verse eid="PRO 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>ሲቆይነ ቱማተ ኔፐ ሃኮፎ፤</para>
  <para style="q2" vid="PRO 3:3">ኤንታ ነ ቆን ቃቻ፤ ነ ዎዛናን ፃፋ።<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>ሄሳ ኦኮ ነ ፆሳነ አሳ ስንን</para>
  <para style="q2" vid="PRO 3:4">ሳበታናነ ናሸታና።<verse eid="PRO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>ነ ኩመ ዎዛናን ጎዳ አማነታ፤</para>
  <para style="q2" vid="PRO 3:5">ነ አኬካን ዘምፖፋ።<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>ነ ኦሶ ኡባን እያ ስንያ፤</para>
  <para style="q2" vid="PRO 3:6">እ ነና ሱረ ኦገ ካለና።<verse eid="PRO 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>ነና ነ ሁጰን ጭንጫ ኦፋ፤</para>
  <para style="q2" vid="PRO 3:7">ጎዳ ያያ፤ ኢታፐ ሃካ።<verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>ሄስ ነ አሳተስ ፓያተ ኤሀና፤</para>
  <para style="q2" vid="PRO 3:8">ነ መቀካ ፃልሳና።<verse eid="PRO 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>ነ ሻሉዋን ጎዳ ቦንቻ፤</para>
  <para style="q2" vid="PRO 3:9">ኮይሮ አይፍዳ ካፈ</para>
  <para style="q2" vid="PRO 3:9">ባይራ እማዳ እያ ቦንቻ።<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>ሄሳ ነ ኦኮ፥ ነ ሻልያን ካ ኩማና፤</para>
  <para style="q2" vid="PRO 3:10">ነ ዳሎይ ዎይነ ኡሻን ኩምድ ፓላሀና።<verse eid="PRO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 3:11"/>ታ ናአዉ፥ ጎዳ ሴራ ካፓ፤</para>
  <para style="q2" vid="PRO 3:11">እ ነና ሴርያ ዎደ ላንጮፋ።<verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>አዋይ ባ ዶስያ ናአ ሴረይሳዳ፥</para>
  <para style="q2" vid="PRO 3:12">ጎዳይ ባ ዶስያ ኡራ ሴሬስ።<verse eid="PRO 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>ጭንጫተ ደመይነ፥</para>
  <para style="q2" vid="PRO 3:13">አኬካ ባዉ ሚሸ ኦያ ኡራይ አንጀትዳይሳ።<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>ጭንጫተ ብራፐ አድ ጎኤስ፤</para>
  <para style="q2" vid="PRO 3:14">ዎርቃፈ አድ ማዴስ።<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>ጭንጫተ ዎርቃፈ አድ አልኦ፤</para>
  <para style="q2" vid="PRO 3:15">ነ ደማናዉ አሞትያ ኡባይ ጭንጫተራ ግነና።<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>ጭንጫተ ኡሻቻ ኩሸን አዱሳ ላይ፥</para>
  <para style="q2" vid="PRO 3:16">ሀድርሳ ኩሸን ዱረተነ ቦንቾ ኦይካሱ።<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>እ ኦገት ኡፋይስያ ኦገታ፤</para>
  <para style="q2" vid="PRO 3:17">እ ሆሮጋይ ሳሮ ሆሮጋ።<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>እያ ባና ኦይከይሳታስ ደኦ ም፤</para>
  <para style="q2" vid="PRO 3:18">እዮ ምንድ ኦይክያ ኡባይ አንጀትዳይሳታ።<verse eid="PRO 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>ጎዳይ ባ ጭንጫተን ሳኣ መስ፤</para>
  <para style="q2" vid="PRO 3:19">ባ አኬካን ሳሎታ ምንስ።<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>እያ ኤራተን ሻፋት ጎጎሶና፤</para>
  <para style="q2" vid="PRO 3:20">ሻራታፐ እር ቡኬስ።<verse eid="PRO 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21"/>ታ ናአዉ፥ ሱረ ፕርዳነ</para>
  <para style="q2" vid="PRO 3:21">ሻክድ ኤሮ ምንዳ ኦይካ</para>
  <para style="q2" vid="PRO 3:21">ኤንቲ ኔፐ ሻከቶፎ።<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>ኤንቲ ነዉ ደኦ ግዳና፤</para>
  <para style="q2" vid="PRO 3:22">እንጀነ ኡፋይስ እማና።<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>ሄ ዎደ ነ ህርግ ባይና ሄመታና፤</para>
  <para style="q2" vid="PRO 3:23">ነ ቶሆይ በተና።<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>ኔኒ ዝንእያ ዎደ ያያካ፤</para>
  <para style="q2" vid="PRO 3:24">ቃማ ኩመ ማልኦ ስኮ ስካና።<verse eid="PRO 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>አኬኮና ጋክያ ጋዶስ ያያካ፤</para>
  <para style="q2" vid="PRO 3:25">ኢታት ይያ ዩዋን ዳጋማካ።<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>ጎዳይ ነዉ ዘምፖ ግዳና፤</para>
  <para style="q2" vid="PRO 3:26">ነ ቶሆይ ፅሄን ኦይከቶናዳ እ ናጋና።<verse eid="PRO 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>ነዉ ዎልቅ ደእሽን፥</para>
  <para style="q2" vid="PRO 3:27">መቶትዳ ኡራስ ሎኦባ ኦሶ አጎፋ።<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>ሀእ ማዳናዉ ዳንዳአሸ ነ ሾሩዋ፥</para>
  <para style="q2" vid="PRO 3:28">“ስማዳ ያ፤ ታ ነዉ ዎንቶ እማና” ያጎፓ። <verse eid="PRO 3:28"/><verse number="29" style="v" sid="PRO 3:29"/>ነና አማነትድ፥ ነ ማታን ደእያ፥</para>
  <para style="q2" vid="PRO 3:29">ነ ሾሩዋ ቦላ ገነ ኦፋ።<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>ነና ቆሆና ደእሽን፥</para>
  <para style="q2" vid="PRO 3:30">አሰ ጮ ሞቶፓ።<verse eid="PRO 3:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>ገነ ኦያ አሳታ ቃናቶፓ፤</para>
  <para style="q2" vid="PRO 3:31">ኤንታ ኢታ ኦሱዋ ካሎፋ።<verse eid="PRO 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>ጎዳይ ኢታ ኦያ አሳታ እፄስ፤</para>
  <para style="q2" vid="PRO 3:32">ሽን ሱረታ ዶሴስ።<verse eid="PRO 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>ጎዳይ ኢታ ኦያ አሳ ኬ ባዴስ፤</para>
  <para style="q2" vid="PRO 3:33">ሽን ሱረባ ኦያ አሳ ኬ አንጄስ።<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>ኦቶሮን ቀልቅሰይሳታ ጎዳይ ቀልቅሴስ፤</para>
  <para style="q2" vid="PRO 3:34">ሽን ባንታና ካዉሸይሳታ ሳቤስ።<verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>ጭንጫት ቦንቾ ደማና፤</para>
  <para style="q2" vid="PRO 3:35">ሽን ኤያት ካዉያና።<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">ጭንጫተ ኡባፈ ቦላ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>ታ ናይቶ፥ ህንተ አዋ ዞርያ ስእተ፤</para>
  <para style="q2" vid="PRO 4:1">ሎይ ስእተ፤ ህንተ አኬካ ደማና።<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>ታ ህንተዉ ሎኦ ትምርተ እምያ ግሾ፥</para>
  <para style="q2" vid="PRO 4:2">ታ ትምርትያ ካፕተ።<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>ታካ ታ አዋስ ናአ፤</para>
  <para style="q2" vid="PRO 4:3">ታ አየስ እያ ዶስያ እስ ናአ።<verse eid="PRO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4"/>ታ አዋይ ታና ሀይሳዳ ያግድ ታማርስስ፤</para>
  <para style="q2" vid="PRO 4:4">“ታ ኦዳይ ነዉ ገሎ፤ ታ ኪታ ናጋ፤</para>
  <para style="q2" vid="PRO 4:4">ኔኒ ሄሳ ኦኮ ደኦን ዳና።<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>ጭንጫተነ አኬካ ደማናዉ ምና፤</para>
  <para style="q2" vid="PRO 4:5">ታ ነዉ ኦድያባ ዶጎፓ፤ እያፐ ካረ ከዮፓ።<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>ጭንጫተስ ዞኮ ዛሮፓ፤ እያ ነና አሻና፤</para>
  <para style="q2" vid="PRO 4:6">እዮ ዶሳ፤ እያ ነና ናጋና።<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>ጭንጫተ አያ ግሾ እዮ ደማ፤</para>
  <para style="q2" vid="PRO 4:7">ነዉ ደእያባ ዉርስድ ኤክኮካ አኬካ ደማ።<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>ነ እዮ ቦንቻ፤</para>
  <para style="q2" vid="PRO 4:8">እያ ነና ቁ ቁ ኦና፤</para>
  <para style="q2" vid="PRO 4:8">ነ እዮ ኦይክኮ፥ እያ ነና ቦንቻና።<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>እያ ነ ሁጵያስ ሳባ ግዳና፤</para>
  <para style="q2" vid="PRO 4:9">ቦንቾ ካላቻ እማና” ያግስ።<verse eid="PRO 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>ታ ናአዉ፥ ስአ፤ ታ ኦደይሳ ኤካ፤</para>
  <para style="q2" vid="PRO 4:10">ነ ላይይ አዱቃና።<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>ታኒ ነና ጭንጫተ ኦገ ካለና፤</para>
  <para style="q2" vid="PRO 4:11">ሱረ ሆሮጋ በሳና።<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>ነ ሄመትያ ዎደ ብያባይ ዴና፤</para>
  <para style="q2" vid="PRO 4:12">ዎፅያኮካ በታካ።<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>ታ ትምርትያ ሎይ ናጋ፤ የዶፋ፤</para>
  <para style="q2" vid="PRO 4:13">ትምርተይ ነዉ ደኦ እምያ ግሾ ሎይ ናጋ።<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>ናጋራንቾታ ኦግያራ ቦፓ፤</para>
  <para style="q2" vid="PRO 4:14">ኢታ አሳታ ኦግያን ሄመቶፋ።<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>እያፐ ሃካ፤ እያን ሄመቶፋ፤</para>
  <para style="q2" vid="PRO 4:15">ጉየ ስማ፤ ነ ኦግያን ባ።<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>ኤንቲ ኢታባ ኦና ደእሽን ስኮይ ኤከና፤</para>
  <para style="q2" vid="PRO 4:16">ኤንቲ አሰ ቦና ደእሽን ስኮይ ኤፈና።<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>ኤንቲ ናጋራ ካዳ ሞሶና፤</para>
  <para style="q2" vid="PRO 4:17">ጌላተ ኡሻዳ ኡዮሶና።<verse eid="PRO 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>ፅሎታ ኦገይ ሴታ ጋላስ ጋካናዉ፥</para>
  <para style="q2" vid="PRO 4:18">ጉጅ ጉጅ ፖእያ ዎንታ ፃልቀ መላ።<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>ሽን ጌላታ ኦገይ ሳካና ማ መላ፤</para>
  <para style="q2" vid="PRO 4:19">ኤንቲ አይብን በትያኮካ ኤሮኮና።<verse eid="PRO 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>ታ ናአዉ፥ ታ ኦደይሳ ስአ፤</para>
  <para style="q2" vid="PRO 4:20">ነ ሀይ ታኮ ዛራ።<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>ነ አይፍያ ስንፈ ሃሶፋ፤</para>
  <para style="q2" vid="PRO 4:21">ነ ዎዛናን ናጋ።<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>ኤንታ ደምያ ኡባስ ኤንቲ ደኦ፤</para>
  <para style="q2" vid="PRO 4:22">ኤንቲ አሳተስ ፓያተ እሞሶና።<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>ደኦይ እያፐ ፑልትያ ግሾ፥</para>
  <para style="q2" vid="PRO 4:23">ኡባፈ አዳ ነ ዎዛና ምንዳ ናጋ።<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>ነ ዶናፐ ኢታ ሃሳያ ድጋ፤</para>
  <para style="q2" vid="PRO 4:24">ዎርዶ ሃሳያ ነ ማታፐ ሃሳ።<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>ስት ጋዳ ስን ፄላ፤</para>
  <para style="q2" vid="PRO 4:25">ነ አይፈይ ነ ስንን ደእያባ</para>
  <para style="q2" vid="PRO 4:25">ትሽ ኦድ ፄሎ።<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>ነ ቶሁዋ ኦግያ ጊግሳ፤</para>
  <para style="q2" vid="PRO 4:26">ሱረ ኦገ ፃላላን ሄመታ።<verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>ሱረ ኦገፐ ኡሻች ሀድርስ ጎፓ፤</para>
  <para style="q2" vid="PRO 4:27">ነ ቶሆይ ኢታ ኦገ ቦናዳ ናጋ።<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">ላይማተፈ ሃካ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>ታ ናአዉ፥ ታ ጭንጫተ ሀይዛ ስአ፤</para>
  <para style="q2" vid="PRO 5:1">ነ ሀይ ታ ትምርትያኮ ዛራ።<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>ሄስ ነና ዎዛናማ ኦና፤</para>
  <para style="q2" vid="PRO 5:2">ነ ኦዳይ ነ ኤራተ ቆንጭሳና።<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>ላይማ ማጫሳ እንፃርሳፈ እልሎ ኤስ ፆኬስ፤</para>
  <para style="q2" vid="PRO 5:3">እ ኦዳይ ኦይሳፐ አድ ሎፅኬስ።<verse eid="PRO 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4"/>ሽን ዉርሰን እያ ጎዳረ ኡዳ ጫማዉሱ፤</para>
  <para style="q2" vid="PRO 5:4">ናምኡ ባጋራ ቃንፅያ ማሻዳ ቃራ።<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>እ ቶሆይ ሀይቆኮ ቤስ፤</para>
  <para style="q2" vid="PRO 5:5">እ ታንጎይ ዱፎ ጋስ።<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>እያ ደኦ ኦገ ቆፑኩ፤ እ ኦገይ ጌላ፤</para>
  <para style="q2" vid="PRO 5:6">ሽን ጌላ ግደይሳ እያ ኤሩኩ።<verse eid="PRO 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>ታ ናአዉ፥ ታና ስአ፤</para>
  <para style="q2" vid="PRO 5:7">ታ ኦደይሳፈ ከዮፓ።<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>ላይማ ማጫሳ ሄራ ቦፕተ፤</para>
  <para style="q2" vid="PRO 5:8">እ ኬ ፐንግያኮ ሺቆፕተ።<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>ሄስ ሀኖና እፅኮ ህንተ ቦንቹዋ ሀራት ኤካና፤</para>
  <para style="q2" vid="PRO 5:9">ናአተን ዎዛና ምኖ አሳ ኩሸን ህንተ ሀይቃና።<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>ህንተ አቁዋ አላጋት ኤካና፤</para>
  <para style="q2" vid="PRO 5:10">ህንተ ዳቡራድ ሺሽዳባይ ሀራ አሳስ ግዳና።<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>ዉርሰን ህንተ አሾይነ</para>
  <para style="q2" vid="PRO 5:11">ህንተ አሳተይ ዉርን ህንተ ዬካና።<verse eid="PRO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12"/>ህንተ ያጋና፤ “ታ አይስ ትምርተ እፃድና?</para>
  <para style="q2" vid="PRO 5:12">ታ ዎዛናይ ሴራ አይስ ካዴ?<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>ታኒ ታ አስታማረታ ስአብከ፤</para>
  <para style="q2" vid="PRO 5:13">ታና ዞረይሳታ ዞርያ ኤካብከ።<verse eid="PRO 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>ሄሳ ግሾ፥ ታ አሳይ ሺቅዳ ሺቁዋን፥</para>
  <para style="q2" vid="PRO 5:14">ካዉያናዉ ማታስ” ያጋና።<verse eid="PRO 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>ኔኒ ነ ፑልቱዋፈ ሃ ኡያ፤</para>
  <para style="q2" vid="PRO 5:15">ነ ማቸ ፃላላ ሲቃ።<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>ነ ፑልቱዋ ዳባባን፥</para>
  <para style="q2" vid="PRO 5:16">ነ ኦላ ሃ ደንባን አይስ ጉሳይ?<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>ኤንታ ነዉ ቡዞ ኦ፤</para>
  <para style="q2" vid="PRO 5:17">ሀራ አላጋ ኡራራ ኮፆፋ።<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>ነ ፑልቶይ ነዉ አንጀቶ፤</para>
  <para style="q2" vid="PRO 5:18">ነ ናአተ ማቸራ ኡፋይታ።<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>ሎእያ ጋረዳንነ ኡፋይስያ ገንኤዳ</para>
  <para style="q2" vid="PRO 5:19">እ ንይ ኡባ ዎደ ነና አሎ፤</para>
  <para style="q2" vid="PRO 5:19">ኡባ ዎደ እ ሲቆይ ነና ድኦ።<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>ታ ናአዉ፥ ላይማ ማጫሳን አይስ ድኤታይ?</para>
  <para style="q2" vid="PRO 5:20">ሀራ አሳ ማቾ አይስ ቆማይ?<verse eid="PRO 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>አስ ኦያባ ኡባ ጎዳይ በኤስ፤</para>
  <para style="q2" vid="PRO 5:21">እ ሄመትያ ሆሮጋ ኡባ ፄሌስ።<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>ናጋራንቹዋ እ ኦዳ ናጋራይ ኦይኬስ፤</para>
  <para style="q2" vid="PRO 5:22">እያ ናጋራ ግተይ እያ ቃቼስ።<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>እ ባ ኤያተን ይስ፤</para>
  <para style="q2" vid="PRO 5:23">ባና ናግቦና ግሾ ሀይቅስ።<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">ኤያተፈ ሃካ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 6:1"/>ታ ናአዉ፥ ሚሸ ታልእዳ ነ ሾሩዋስ ዋሰ ገልዳባ ግድኮ፥</para>
  <para style="q2" vid="PRO 6:1">ሀራ አሳስ ኩሸ ባቃዳ ጫቅዳባ ግድኮ፥<verse eid="PRO 6:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PRO 6:2"/>ነ ጫቅዳ ነ ጫቁዋን ፅሄን ገልዳባ ግድኮ፥</para>
  <para style="q2" vid="PRO 6:2">ነ ዶናፐ ከይዳ ቃላን ኦይከትዳባ ግድኮ፥<verse eid="PRO 6:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 6:3"/>ህዛ ነ ሾሩዋ ኩሸን ገላዳሳ።</para>
  <para style="q1" vid="PRO 6:3">ሄሳ ግሾ፥ ታ ናአዉ፥ እያፐ ከያናዉ ኮይኮ፥</para>
  <para style="q2" vid="PRO 6:3">ነ ሾሩዋ ሶ ባዳ ዋሰተ</para>
  <para style="q2" vid="PRO 6:3">ነ ቦላፈ ዎና መላ አዳሻዳ እያ ዎሳ።<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>ሄሳ ኦና ደአሸ ዝንኦፋ፤</para>
  <para style="q2" vid="PRO 6:4">ስኮይካ ነና ኤኮፎ።<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>ሻንካፈ ገንኤይ ከስ ኤክያዳ፥</para>
  <para style="q2" vid="PRO 6:5">ግተፐ ካፎይ አትያዳ ነና አሻ።<verse eid="PRO 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>ነኖ አዛላዉ፥ ዝማዶኮ ባ፤</para>
  <para style="q2" vid="PRO 6:6">እያፐ ጭንጫተ ታማራ።<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>ዝማዶታ ኪተይ ባዋ፥</para>
  <para style="q2" vid="PRO 6:7">ሀላቅ ዎይኮ ኤንታ ሃረይ ባዋ።<verse eid="PRO 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8"/>ሽን ባንታዉ ማናባ ቦነ ምንጆሶና፤</para>
  <para style="q2" vid="PRO 6:8">ካ ጫክያ ዎደ ባንታዉ ኮሽያ ካ ሺሾሶና።<verse eid="PRO 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>ነኖ አዛላዉ፥ ነ አዉደ ጋካናዉ ስካይ?</para>
  <para style="q2" vid="PRO 6:9">ነ ስኮፈ አዉደ ባርካኔ?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>ኔኒ “ጉ ዝንአና፤ ጉ ስካና፤</para>
  <para style="q2" vid="PRO 6:10">ኩሸ ሺሻ ኤካዳ ጉ ሸምፓና” ያጋሳ።<verse eid="PRO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11"/>ሄ ዎደ ማንቆተ ፓንጋዳ፥</para>
  <para style="q2" vid="PRO 6:11">ፓጭ ኦላ ሚሸ ኦይክዳ አሳዳ ነ ቦላ ያና።<verse eid="PRO 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>ላፋነ ኢታ አስ ዩይድ ኦዳ ምርቄስ፤<verse eid="PRO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13"/>እ ባ አይፈን ቃምኦቴስ፤</para>
  <para style="q2" vid="PRO 6:13">ባ ቶሆን በሴስ፤ ባ ብራን ማሌስ።<verse eid="PRO 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14"/>እያ ኡሎን ጌላተ ደኤስ፤ ኢታባ ቆፔስ፤</para>
  <para style="q2" vid="PRO 6:14">ኡባ ዎደ ኦሹ መስ።<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>ሄሳ ግሾ ዮይ አኬኮና እያ ቦላ ያና፤</para>
  <para style="q2" vid="PRO 6:15">እ ሀሳዮና መቃና፤ ዛሪድ ፓፀና።<verse eid="PRO 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16"/>ጎዳይ እፅያ ኡሱፑን ቆሞት ደኦሶና፤</para>
  <para style="q2" vid="PRO 6:16">እ ሻተትያ ቆሞት ላፑና፤<verse eid="PRO 6:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 6:17"/>ካድ ፄልያ አይፈ፥</para>
  <para style="q2" vid="PRO 6:17">ዎርዶትያ እንፃርስ፥</para>
  <para style="q2" vid="PRO 6:17">ፅሎ አሳታ ዎያ ኩሸ፥<verse eid="PRO 6:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="PRO 6:18"/>ኢታባ ማቅያ ዎዛና፥</para>
  <para style="q2" vid="PRO 6:18">ኢታባኮ ዎፃናዉ ኤሶትያ ቶሆ፥<verse eid="PRO 6:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19"/>ዎርዶ ቦላ ዎርዶ ጉጅያ ዎርዶ ማርካ፥</para>
  <para style="q2" vid="PRO 6:19">እሻታ ግዶን ኦሽ መያ አስ።<verse eid="PRO 6:19"/></para>
  <para style="s1">ላይማተፈ ናገታ</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 6:20"/>ታ ናአዉ፥ ነ አዋ ኪታ ፖላ፤</para>
  <para style="q2" vid="PRO 6:20">ነ አየ ትምርትያ አጎፋ።<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>ኤንታ ኡባ ዎደ ነ ዎዛናን ኦይካ፤</para>
  <para style="q2" vid="PRO 6:21">ነ ቆያን ቃቻ።<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>ነ ሄመትያ ዎደ ኤንቲ ነና ካለና፤</para>
  <para style="q2" vid="PRO 6:22">ነ ዝንእያ ዎደ፥ ኤንቲ ነና ናጋና፤</para>
  <para style="q2" vid="PRO 6:22">ነ ባርክያ ዎደ ኤንቲ ነና ዞራና።<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>ጎዳ ኪታይ ፆምፐ፤ እያ ትምርተይ ፖኦ፤</para>
  <para style="q2" vid="PRO 6:23">እያ ሴራይ ደኦኮ ኤፍያ ኦገ።<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>ሀ ትምርተት ኢታ ማጫፈነ</para>
  <para style="q2" vid="PRO 6:24">ሀራ ጭምያ ማጫሳ እንፃርሳፈ ነና ናጋና።<verse eid="PRO 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>እ ማላ ሎኦተይ ነና ቃፎ፤</para>
  <para style="q2" vid="PRO 6:25">እ ቃምኦቶይ ነና ድኦፎ።<verse eid="PRO 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>እስ አደይ ጉ ሚሸን ላይማ ማጫስ ደማናዉ ዳንዳኤስ፤</para>
  <para style="q2" vid="PRO 6:26">ሽን ሀራ አሳ ማቾ ላገይ ሸምፖ ኤኬስ።<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>ታማ እድምን</para>
  <para style="q2" vid="PRO 6:27">እያ ማኦይ ሜተቶና አተይ ደኢ?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>ታማ ቦንቆ የን፥</para>
  <para style="q2" vid="PRO 6:28">እያ ቶሆይ ፁገቶና አተይ ደኢ?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>አሳ ማቾ ላገያ ኡራይ ሄሳ መላ፤</para>
  <para style="q2" vid="PRO 6:29">እዮ ቦችያ ኡባይ ሴረቶና አተና።<verse eid="PRO 6:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>ካይሶይ ኮሻትድ ማናዉ ካይስኮ፥</para>
  <para style="q2" vid="PRO 6:30">አስ እያ ቦረና።<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>ሽን እ ኦይከትያባ ግድኮ፥</para>
  <para style="q2" vid="PRO 6:31">ላፑን ኩሸ ቃንፃና፤</para>
  <para style="q2" vid="PRO 6:31">ባ ሶን ደእያ ሚሸ ኡባ እማና።<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>ሽን ማጫሳራ ላይማትያ አስ ዎዛን ባይና አስ፤</para>
  <para style="q2" vid="PRO 6:32">ሄ ኡራይ ባ ሸምፑዋ ይሴስ።<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>ደሸነ ካዉሽ እያ ቃዳ፤</para>
  <para style="q2" vid="PRO 6:33">ዬል እያፐ ቁሸተና።<verse eid="PRO 6:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>ቃናተይ አዝናስ ይሎ ደንስ፤</para>
  <para style="q2" vid="PRO 6:34">ሀሎ ከስያ ዎደ እዉ ቃተና።<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>እ አይ አጫካ ኤከና፤</para>
  <para style="q2" vid="PRO 6:35">አይ መላ እሞትካ እያ ሀንቁዋ ዶሽሰና።<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s1">ላይማ ማጫሳፐ ናገታ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 7:1"/>ታ ናአዉ፥ ታ ቃላ ናጋ፤</para>
  <para style="q2" vid="PRO 7:1">ታ ኪታ ነ ዎዛናን ዎ።<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>ደኦን ዳናዉ ታ ኪታ ኦ፤</para>
  <para style="q2" vid="PRO 7:2">ታ ትምርትያ ነ አይፈ ናኤዳ ናጋ።<verse eid="PRO 7:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 7:3"/>ነ ኩሸን ኤንታ ቃቻ፤</para>
  <para style="q2" vid="PRO 7:3">ነ ዎዛናን ኤንታ ፃፋ።<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>ጭንጫተ ነ ምችዳ፥</para>
  <para style="q2" vid="PRO 7:4">አኬካ ነ ማታ ዳቦዳ ፄላ።<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>ኤንቲ ነና ላይማ ማጫሳፐነ</para>
  <para style="q2" vid="PRO 7:5">ባ ቃላን ጭምያ ሀራ ማጫሳፐ ናጋና።<verse eid="PRO 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>እስ ጋላስ ታ ማስኮተራ ካረ ፄላስ።<verse eid="PRO 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7"/>ኤራተ ፓጭዳ ናአተታ በአስ፤</para>
  <para style="q2" vid="PRO 7:7">ኤንታ ግዶፈ እሶይ ዳሮ ኤያ።<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>ሄ ናአተይ ኦገራ ብሸ፥</para>
  <para style="q2" vid="PRO 7:8">እስ ላይማ ማጫሰ ኬ ማታራ አስ፤</para>
  <para style="q2" vid="PRO 7:8">እ ሶ ኤፍያ ኦግያ ስሚድ እ ሶኮ ብስ።<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>ሄ ዎደ ሳእ ላዴስ።<verse eid="PRO 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10"/>ማጫስያ እያ ደማሱ፤</para>
  <para style="q2" vid="PRO 7:10">እያ ላይማ ግደይሳ እ ማኦይ ኤርሴስ፤</para>
  <para style="q2" vid="PRO 7:10">እያ አሳ ጭማናዉ ሀልቻዳ ከያሱ።<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>እያ ፃልታማነ ዬል ባይና ማጫስ፤</para>
  <para style="q2" vid="PRO 7:11">ሶን ዎፑ ጋዳ ኡቱኩ።<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>እያ እስ ቶሆ ኦገን፥ እስ ቶሆ ግያን፥</para>
  <para style="q2" vid="PRO 7:12">እስ ቶሆ ዳባባን ኤቃዳ ናጋዉሱ።<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>እያ ሄ ናአተ ቆማዳ ዬራሱ፤</para>
  <para style="q2" vid="PRO 7:13">እያ ትሽ ኦዳ ፄላሸ ሀይሳዳ ያጋሱ፤<verse eid="PRO 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14"/>“ታኒ ታ ያርሹዋ ያርሻዳ፥</para>
  <para style="q2" vid="PRO 7:14">ታ ቃንገ ሀች ጋስ።<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>ያታዳ ነና ሞካናዉ ከያስ፤</para>
  <para style="q2" vid="PRO 7:15">ነና ዳሮ ኮያስ፤ ህዛ ነና ደማስ።<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>ታኒ ግብፀፈ ይዳ፥</para>
  <para style="q2" vid="PRO 7:16">አሌቀትዳ አፍላ ሂፃስ።<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>ታኒ ታ ሂፃ፥</para>
  <para style="q2" vid="PRO 7:17">ካርበፈ፥ አልሙነፐነ ቃራፋፐ፥</para>
  <para style="q2" vid="PRO 7:17">ኦሰትዳ ሽቱዋ ፑካስ።<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>ሃያ፤ ዎንታና ጋካናዉ ሲቆ አሎስ፤</para>
  <para style="q2" vid="PRO 7:18">ቆመትድ ኡፋይቶስ።<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>ታ አዝናይ ሶን ዴና፤</para>
  <para style="q2" vid="PRO 7:19">ሃሆ ቢታ ብስ።<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>ሚሸ ካርፂታ ኩንድ ብዳ ግሾ፥</para>
  <para style="q2" vid="PRO 7:20">አጌና ኩሞና ሶ ስመና” ያጋሱ።<verse eid="PRO 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 7:21"/>ባ ማልኦ ኦዳን እያ ባለሱ፤</para>
  <para style="q2" vid="PRO 7:21">ባ ሊቆ እንፃርሳን እያ ጭማሱ።<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>ቦር ሹከታናዉ በይሳዳ፥</para>
  <para style="q2" vid="PRO 7:22">ጋር ኤሶትድ ፅሄን ገለይሳዳ፥</para>
  <para style="q2" vid="PRO 7:22">እ እዮ ካልድ ብስ።<verse eid="PRO 7:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23"/>ቶር እያ ዎዛና ጫድዳዳ ሀንስ፤</para>
  <para style="q2" vid="PRO 7:23">ግተ ግዶ ገልዳ ካፎ ዳንስ፤</para>
  <para style="q2" vid="PRO 7:23">ሄስ ኡባይ እያ ሸምፑዋ ይሳናዉ ሀነይሳ ኤርቤና።<verse eid="PRO 7:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24"/>ህዛ ታ ናአዉ፥ ታና ስአ፤</para>
  <para style="q2" vid="PRO 7:24">ታ ዶናፐ ከይያ ቃላ ሀይዛ።<verse eid="PRO 7:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="PRO 7:25"/>ነ ዎዛናይ ማጫሳ ጌዶ ቦፖ፤</para>
  <para style="q2" vid="PRO 7:25">እ ኦግያን ገላዳ ዮፓ።<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>እያ ጫዳ የግዳይሳት ዳሮ፤</para>
  <para style="q2" vid="PRO 7:26">እያ ዎዳይሳት ጉ ግዶኮና።<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>እ ሶይ ዱፎኮ ኤፍያ ኦገ፤</para>
  <para style="q2" vid="PRO 7:27">ሀይቆኮ ካለያ ሆሮጋ።<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">ጭንጫተ ኦገ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>ጭንጫተ ፄጋዉሱ፤ ስእተ፤</para>
  <para style="q2" vid="PRO 8:1">አኬክ ባ ቃላ ቁ ኦዳ ስሳዉሱ።<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>ኦገ ዶናን ደእያ ዙማታ ቦላነ</para>
  <para style="q2" vid="PRO 8:2">ዳጋላ ኦግያን እያ ኤቃዉሱ።<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>ድርሳ ፐንገ ማታን፥ ካታማ ገልያ ፐንገን ኤቃዳ፥</para>
  <para style="q2" vid="PRO 8:3">ባ ቃላ ቁ ኦዳ ሀይሳዳ ያጋዉሱ።<verse eid="PRO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4"/>አሳዉ፥ ታ ህንተና ፄጋይስ፤</para>
  <para style="q2" vid="PRO 8:4">አሳ ኮቸ ኡባ ፄጋይስ።<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>ህንተኖ ኤራተህ ባይናይሳቶ ኤራተ ታማርተ፤</para>
  <para style="q2" vid="PRO 8:5">ህንተኖ ኤያቶ፥ አኬካ ደምተ።<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>ታኒ ሎኦባ ኦድያ ግሾ ስእተ፤</para>
  <para style="q2" vid="PRO 8:6">ታ ዶናፐ ሱረባይ ከዬስ።<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>ታኒ ቱማ ኦደታይስ፤</para>
  <para style="q2" vid="PRO 8:7">ዎርዶይ ታ ማታን እፀትዳባ።<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>ታ ኦዳይ ቱማ፤</para>
  <para style="q2" vid="PRO 8:8">ጌላ ዎይኮ ምርቀ ግደና።<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>አኬክ ደእያ ኡራስ ታ ኦዳይ ልከ፤</para>
  <para style="q2" vid="PRO 8:9">ኤር ደእያ ኡራስ ታ ኦዳይ ቆንጨ።<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>ብራፐ አድ ታ ዞርያ ዶርተ፤</para>
  <para style="q2" vid="PRO 8:10">ጌሻ ዎርቃፈ አድ ኤራተ ዶርተ።<verse eid="PRO 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>ጭንጫተ ዞኦ አልኦ ሹቻፈ አስ፤</para>
  <para style="q2" vid="PRO 8:11">ነ አሞትያ ኡባይ ኢራ ልከተና።<verse eid="PRO 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>ታዉ፥ ጭንጫተስ አኬክ ደኤስ፤</para>
  <para style="q2" vid="PRO 8:12">ኤራተነ ሻክድ ኤሮይ ታባ።<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>ጎዳስ ያሽ ኢታተ እፆ፤</para>
  <para style="q2" vid="PRO 8:13">ታኒ ኦቶሮነ ጬቀተ እፃይስ፤</para>
  <para style="q2" vid="PRO 8:13">ኢታ ኦገነ ዎርዶ ኦዳ ዶስከ።<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>ዞረይነ ሎኦ ኤራይ ታባ፤</para>
  <para style="q2" vid="PRO 8:14">አኬክነ ዎልቅ ታዉ ደኤስ።<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>ካዎት ታ ባጋራ ካዎቶሶና፤</para>
  <para style="q2" vid="PRO 8:15">ሃረይሳት ሱረ ህገ ታ ባጋራ ከሶሶና።<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>ሀላቃት ታ ማድን ደርያ ሃሮሶና፤</para>
  <para style="q2" vid="PRO 8:16">ቢታ አይስያ ግታ አሳታ ታ ማዳይስ።<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>ታና ዶሰይሳታ ታ ዶሳይስ፤</para>
  <para style="q2" vid="PRO 8:17">ታና ምንድ ኮየይሳት ደማና።<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>ዱረተነ ቦንቾይ ታራ ደኦሶና፤</para>
  <para style="q2" vid="PRO 8:18">ዉሮና ሻሎይነ እንጀይ ታ ማታና።<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>ህንተ ታፐ ደምያ ጎአይ፥</para>
  <para style="q2" vid="PRO 8:19">ጌሻ ዎርቃፈነ ብራፐ አስ።<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>ታ ፅሎተ ኦገን ሄመታይስ፤</para>
  <para style="q2" vid="PRO 8:20">ሱረ ፕርዳ ኦግያራ ካንይስ።<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>ታና ዶሰይሳታስ ታ ሻሎ እማና፤</para>
  <para style="q2" vid="PRO 8:21">ኤንታ ኬ ዱረተን ኩንና።<verse eid="PRO 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 8:22"/>“ጎዳይ ታና ኡባፈ ኮይሮ መስ፤</para>
  <para style="q2" vid="PRO 8:22">በንፐካ እያ ኦሱዋስ ዶመይ ታና።<verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>አላመይ መታናፐ ካሰ</para>
  <para style="q2" vid="PRO 8:23">ታኒ ሹመታስ።<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>አባይ ባይና ዎደ፥ ፑልቶት ቆና</para>
  <para style="q2" vid="PRO 8:24">ደእሽን ታ የለታስ።<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>ደረትነ ዙማት መታናፐ</para>
  <para style="q2" vid="PRO 8:25">ስን ታ የለታስ። <verse eid="PRO 8:25"/><verse number="26" style="v" sid="PRO 8:26"/>ጎዳይ ሳኣነ ሳአን ደእያ ኡባ መናፐ ስን</para>
  <para style="q2" vid="PRO 8:26">ዎይኮ ኮይሮ ኮጰ ቢታይ ኦሰታናፐ ስን ታ የለታስ።<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>ጎዳይ ሳሎታ ምጭዳ ዎደ፥</para>
  <para style="q2" vid="PRO 8:27">አባታፐ ቦላራ ሳሎ ጉፋን ጊግስዳ ዎደ፥</para>
  <para style="q2" vid="PRO 8:27">ታኒ ያን ደአይስ።<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>ጎዳይ ሻራታ ቦላራ ዎዳ ዎደ፥</para>
  <para style="q2" vid="PRO 8:28">አባ ፑልቶታ ስዳ ዎደ፥<verse eid="PRO 8:28"/></para>
  <para style="q2">
    <verse number="29" style="v" sid="PRO 8:29"/>አባ ሃት እመትዳ ዛዋፐ ፕንድ፥ ቦላ አናዳ፥</para>
  <para style="q2" vid="PRO 8:29">እ ኤንታ ኪትዳ ዎደ ሳኣ ባሱዋ ምንዳ ዎደ፥</para>
  <para style="q2" vid="PRO 8:29">ታኒ ያን ደአይስ።<verse eid="PRO 8:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30"/>ሄ ዎደ ታ እያ ማታን ዋና ኦሳንቾ፤</para>
  <para style="q2" vid="PRO 8:30">ኡባ ዎደ ታ እያ ኡፋይሳይስ፤</para>
  <para style="q2" vid="PRO 8:30">ታዉካ እያ ስንን ኡፋይታይስ።<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>እ መዳ አላምያን ኡፋይታይስ፤</para>
  <para style="q2" vid="PRO 8:31">አሳ ናይትካ ታና ኡፋይሶሶና።<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>“ህዛ ታ ናይቶ፥ ስእተ፤</para>
  <para style="q2" vid="PRO 8:32">ታ ኦደይሳዳ ኦይሳት አንጀትዳይሳታ።<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>ታ ትምርትያ ስእተ፤ ጭንጫ ግድተ፤</para>
  <para style="q2" vid="PRO 8:33">ስእዳባ ዶጎፕተ።<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>ታኒ ኦድዳባ ስእያ ኡራይ፥</para>
  <para style="q2" vid="PRO 8:34">ጋላስ ጋላስ ታ ፐንግያን በንትያ ኡራይ፥</para>
  <para style="q2" vid="PRO 8:34">ታ ፐንግያን ናግያ ኡራይ አንጀትዳይሳ።<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>ታና ደምዳይ ደኦ ደሜስ፤</para>
  <para style="q2" vid="PRO 8:35">ጎዳፐ ሳባ ኤኬስ።<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>ሽን ታና ደሞና ኡራይ ባና ቆሄስ፤</para>
  <para style="q2" vid="PRO 8:36">ታና እፅያ ኡባይ ሀይቆ ዶሴስ።”<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">ጭንጫተ፥ ኤራተነ ኤያተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1"/>ጭንጫተ ባ ኬ ኬፃሱ፤</para>
  <para style="q2" vid="PRO 9:1">ላፑን ቱሳታ ባ ኬስ ኤሳሱ።<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>እያ ባ ጊግስያ ግብራስ ሞ መሄ ሹካሱ፤</para>
  <para style="q2" vid="PRO 9:2">ዎይነ አጋሱ፤ ጋይታ አሳ ስን አሱ።<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>አሳ ፄጋናዉ ባ አይለታ ኪታሱ፤</para>
  <para style="q2" vid="PRO 9:3">ኦሳንቾት ካታማ ቃ በሳን ኤቅድ፥ <verse eid="PRO 9:3"/><verse number="4" style="v" sid="PRO 9:4"/>ህንተኖ፥ ኤር ፓጭዳይሳቶ ሃ ገልተ! ኤያታኮ ሀይሳዳ ያጋሱ። <verse eid="PRO 9:4"/><verse number="5" style="v" sid="PRO 9:5"/>“ሃ ዪተ፤ ታ ካ ሚተ፤</para>
  <para style="q2" vid="PRO 9:5">ታ አግዳ ዎይንያ ኡይተ። <verse eid="PRO 9:5"/><verse number="6" style="v" sid="PRO 9:6"/>ህንተ ኤያተ አግድ ደኦን ደእተ፤</para>
  <para style="q2" vid="PRO 9:6">አኬክድ ሄመትተ” ያጋሱ።<verse eid="PRO 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 9:7"/>ቀልቅስያ ኡራ ሴርያ አስ ጫሸ ኤኬስ፤</para>
  <para style="q2" vid="PRO 9:7">ኢታ ኡራ ዞርያ አስ ባዉ ቆሄቴስ።<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>ቀልቅስያ ኡራ ዞሮፓ፤ እ ነና እፃና፤</para>
  <para style="q2" vid="PRO 9:8">ጭንጫ ኡራ ዞራ፤ እ ነና ዶሳና። <verse eid="PRO 9:8"/><verse number="9" style="v" sid="PRO 9:9"/>ጭንጫተ ኡራ ታማርሳ፤ እ ጭንጫ ግዳና፤</para>
  <para style="q2" vid="PRO 9:9">ፅሎ ኡራ ታማርሳ፤ እ ኤራ ጉጃና።<verse eid="PRO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 9:10"/>ጎዳስ ያሽ ጭንጫተስ ዶመ፥ ጌሻ ጎዳ ኤሮይ አኬካ።<verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>ታ ጋሶን ነ ላይይ ዳራና፤</para>
  <para style="q2" vid="PRO 9:11">ነ ደኦ ላይይ አዱቃና።<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>ነ ጭንጫ ግድኮ፥ ጎኤተይ ነና፤</para>
  <para style="q2" vid="PRO 9:12">ነ ቀልቅስያ አስ ግድኮ ነና ቆሃሳ።<verse eid="PRO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 9:13"/>ኤያ ማጫስ ዋሶ ዳራዉሱ፤</para>
  <para style="q2" vid="PRO 9:13">እዉ ዬል ባዋ፤ እያ አይኮካ ኤሩኩ።<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>እያ ባ ካረን ዎይኮ ካታማ ቃ በሳን ኡታዉሱ። <verse eid="PRO 9:14"/><verse number="15" style="v" sid="PRO 9:15"/>ባንታ ኦግያ ብያ አሳ ፄጋዳ፥ <verse eid="PRO 9:15"/><verse number="16" style="v" sid="PRO 9:16"/>“ህንተኖ፥ ኤር ፓጭዳይሳቶ</para>
  <para style="q2" vid="PRO 9:16">ታኮ ሃ ዪተ” ያጋሱ። ኤር ባይናይሳታኮ፥ <verse eid="PRO 9:16"/><verse number="17" style="v" sid="PRO 9:17"/>“ካይስድ ኡያ ሃ ማልኤስ፤</para>
  <para style="q2" vid="PRO 9:17">ጌማን ምያ ካ ሎኤስ” ያጋሱ።<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>ሽን ሀይቅዳ አሳይ ያን ደኤይሳ፥</para>
  <para style="q2" vid="PRO 9:18">እ እማትካ ዱፎን ደኤይሳ እ ኤረና።<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s1">ሶሎሞነ ሌምሶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1"/>ሀይሳቲ ሶሎሞነ ሌምሶታ።</para>
  <para style="q1" vid="PRO 10:1">ጭንጫ ናእ ባ አዋ ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 10:1">ሽን ኤያ ናእ ባ አይዉ አዛንስ።<verse eid="PRO 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>ናጋራን ደምዳ ሚሸይ ጎኤና፤</para>
  <para style="q2" vid="PRO 10:2">ሽን ፅሎተ ሀይቆፐ አሼስ።<verse eid="PRO 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3"/>ጎዳይ ፅሎታ ኮሻይሰና፤</para>
  <para style="q2" vid="PRO 10:3">ሽን ናጋራንቾታ አሙዋ ፖልሰና።<verse eid="PRO 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>አዛላተ ማንቅሴስ፤</para>
  <para style="q2" vid="PRO 10:4">ሽን ምንድ ኦሶይ ዱረዬስ።<verse eid="PRO 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>ጭንጫ አስ ባ ካ ቦነ ሺሼስ፤</para>
  <para style="q2" vid="PRO 10:5">ሽን ካ ጫክያ ዎደ ስክያ አስ ካዉዬስ።<verse eid="PRO 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6"/>ፅሎ አስ አንጀቴስ፤</para>
  <para style="q2" vid="PRO 10:6">ሽን ናጋራንቾ አስ</para>
  <para style="q2" vid="PRO 10:6">ባ ማካላተ ዶናን ገንስ።<verse eid="PRO 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>ፅሉዋ ሱንይ አንጆን ፄገትሸ ደኤስ፤</para>
  <para style="q2" vid="PRO 10:7">ሽን ናጋራንቾታ ሱንይ ኤለ ዶገቴስ።<verse eid="PRO 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 10:8"/>ጭንጫ አስ ኪትዳባ ኦስ፤</para>
  <para style="q2" vid="PRO 10:8">ሽን ኤያ አስ ዮኮ ቤስ።<verse eid="PRO 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>ሱረ አስ ሳሮ ደኤስ፤</para>
  <para style="q2" vid="PRO 10:9">ሽን ጌላ አስ ባ ጎመን ኦይከቴስ።<verse eid="PRO 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>ገነ አይፈን ቃምኦትያ አስ መቶ ኤሄስ፤</para>
  <para style="q2" vid="PRO 10:10">ሽን ያዮና ሴርያ አስ ሳሮተ መስ።<verse eid="PRO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 10:11"/>ፅሎ አሳ ኦድ ደኦ ፑልቶ፤</para>
  <para style="q2" vid="PRO 10:11">ሽን ናጋራንቾ አሳ ኦድ ማካላ ገንስ።<verse eid="PRO 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>እፆይ ፓላማ ደንስ፤</para>
  <para style="q2" vid="PRO 10:12">ሽን ሲቆይ ባላ ኡባ ካሜስ።<verse eid="PRO 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>ዎዛናማ አስ ጭንጫተን ኦዴስ፤</para>
  <para style="q2" vid="PRO 10:13">ሽን ኤያ አሳ ዞኮይ ፃምአስ አቴስ።<verse eid="PRO 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14"/>ጭንጫት ኤራተ ዳጋዮሶና፤</para>
  <para style="q2" vid="PRO 10:14">ሽን ኤያታ ዶናይ ዮ ዳፌስ።<verse eid="PRO 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>ዱረ አሳ ሚሸይ ድረትዳ ካታማዳ ናጌስ፤</para>
  <para style="q2" vid="PRO 10:15">ሽን ማንቆተ ማንቆታ ይሴስ።<verse eid="PRO 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>ፅሎ አሳ ኦሶይ እያ ደኦ፤</para>
  <para style="q2" vid="PRO 10:16">ሽን ኢታ አሳ ዉርሰይ ዮ።<verse eid="PRO 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>ሴርን ስምያ አስ ደኦ ኦገን ሄመቴስ፤</para>
  <para style="q2" vid="PRO 10:17">ሽን ሴርን እፅያ አስ ባሌስ።<verse eid="PRO 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>እፆ ካምያ አስ ዎርዳንቾ፤</para>
  <para style="q2" vid="PRO 10:18">ዝግርስ ላልያ አስ ኤያ።<verse eid="PRO 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>ዳሮ ሃሳያ ግዶን ናጋር የና፤</para>
  <para style="q2" vid="PRO 10:19">ሽን ባ ዶና ሺሽያ አስ ጭንጫ።<verse eid="PRO 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>ፅሎ አሳ እንፃርስ ጌሻ ብራ መላ፤</para>
  <para style="q2" vid="PRO 10:20">ሽን ኢታ አሳ ዎዛን ኢታባን ኩምስ።<verse eid="PRO 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>ፅሎ አሳ ኦድ ዳሮ አሳ ጎኤስ፤</para>
  <para style="q2" vid="PRO 10:21">ሽን ኤያት ባንታ ፓጫ ዎዛናን ሀይቆሶና።<verse eid="PRO 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>ጎዳ አንጆይ ዱረ ከሴስ፤</para>
  <para style="q2" vid="PRO 10:22">ሄ ዱረተ ቦላ መቶ ጉጀና።<verse eid="PRO 10:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>ኤያ ኡራስ ኢታባ ኦሶይ ካሳ መላ፤</para>
  <para style="q2" vid="PRO 10:23">ሽን ዎዛናማ አስ ጭንጫተን ኡፋይቴስ።<verse eid="PRO 10:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>ኢታ አስ ህርግዳባይ እያ ቦላ ጋካና፤</para>
  <para style="q2" vid="PRO 10:24">ሽን ፅሎይ አሞትዳባይ እመታና።<verse eid="PRO 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>ጎተይ አያ ዎደ ናጋራንቾይ በንተና፤</para>
  <para style="q2" vid="PRO 10:25">ሽን ፅሎት መርናዉ ምንድ ዳና።<verse eid="PRO 10:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>ጫላባይ አቸ፥ ጩይ አይፈ ቆሄይሳዳ፥</para>
  <para style="q2" vid="PRO 10:26">አዛላ አስ ኪትዳይሳ ይሎዬስ። <verse eid="PRO 10:26"/><verse number="27" style="v" sid="PRO 10:27"/>ጎዳስ ያሽ ላይ አዱሴስ፤</para>
  <para style="q2" vid="PRO 10:27">ሽን ናጋራንቾታ ላይይ ቃሜስ።<verse eid="PRO 10:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>ፅሎ አስ ኡፋይስ ያና ግድ ናጌስ፤</para>
  <para style="q2" vid="PRO 10:28">ሽን ናጋራንቾታ ኡፋይሳይ ያና።<verse eid="PRO 10:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>ጎዳ ኦገይ ፅሎታስ ባቃትድ አትያ በሰ፤</para>
  <para style="q2" vid="PRO 10:29">ሽን ኢታ ኦያ አሳስ ዮ።<verse eid="PRO 10:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>ፅሎት ኡባ ዎደ ቃፆኮና፤</para>
  <para style="q2" vid="PRO 10:30">ሽን ኢታት ቢታ ቦላ ዶኮና።<verse eid="PRO 10:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>ፅሎ አስ ጭንጫተን ኦዴስ፤</para>
  <para style="q2" vid="PRO 10:31">ሽን ጌላባ ኦደትያ እንፃርስ ቃንፀታና<verse eid="PRO 10:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>ፅሎ አሳ እንፃርስ በሲያ ሃሳያ ኤሬስ፤</para>
  <para style="q2" vid="PRO 10:32">ሽን ኢታ አሳ ኦዳይ ዎበ።<verse eid="PRO 10:32"/></para>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>ጎዳይ ዎርዶ ምዛነ እፄስ፤</para>
  <para style="q2" vid="PRO 11:1">ሽን ልከ ምዛነን ኡፋይቴስ።<verse eid="PRO 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>ኦቶሮይ ያ ዎደ ካዉሻተ ዬስ፤</para>
  <para style="q2" vid="PRO 11:2">ሽን አሽከተን ጭንጫተ ዬስ።<verse eid="PRO 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>ፅሎታ ኤንታ ሱረተይ ካለስ፤</para>
  <para style="q2" vid="PRO 11:3">ሽን ኢታ አሳታ ኤንታ ጌላተይ ይስስ።<verse eid="PRO 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>ሀንቆ ጋላስ ዱረተ ጎኤና፤</para>
  <para style="q2" vid="PRO 11:4">ሽን ፅሎተ ሀይቆፐ አሼስ።<verse eid="PRO 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>ቦረይ ባይና ኡራ ኦግያ ፅሎተይ ሱርሴስ፤</para>
  <para style="q2" vid="PRO 11:5">ሽን ኢታ ኡራይ ባ ኢታተን ኩንዴስ።<verse eid="PRO 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 11:6"/>ሱረታ ኤንታ ፅሎተይ አሼስ፤ ሽን አማነቶናይሳታ ኤንታ አሞይ ፅሄ ግድድ ኦይካና።<verse eid="PRO 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 11:7"/>ኢታ አስ ሀይቅያ ዎደ፥ እ ናግያ ኡፋይሳይ እያራ እስፈ ሀይቄስ፤ እ ባ ዎልቃን ጬቀትያባይ ኡባይካ ዬስ።<verse eid="PRO 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 11:8"/>ፅሎይ መቶፐ አቴስ፤ እያ ግሾ ኢታ ቦላ መቶይ ዬስ።<verse eid="PRO 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 11:9"/>ፆሳ ካድዳ አስ ባ ዶናን አሳ ይስስ፤ ሽን ፅሎት ኤራን ከስ ኤኮሶና።<verse eid="PRO 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 11:10"/>ፅሎት ቦንቸትያ ዎደ፥ ካታማይ ኡፋይቴስ፤ ቃስ ኢታት ሀይቅያ ዎደ፥ ሀሹ ጌስ።<verse eid="PRO 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 11:11"/>ፅሎታ አንጁዋ ጋሶን ካታማይ ድጬስ፤ ሽን ኢታ ኡራ ኦድ ካታማ ይስስ።<verse eid="PRO 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 11:12"/>ባ ሾሩዋ ካያ ኡራስ ዎዛን ባዋ፤ ሽን አኬካንቾ ኡራይ ስእ ጌስ።<verse eid="PRO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 11:13"/>ዝግርያ አስ ፁራ ላሌስ፤ ሽን አማነትያ አስ ፁራ ገንስ።<verse eid="PRO 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 11:14"/>ካለያባይ ይኮ፥ ካዎተይ ኩንዴስ፤ ሽን ዳሮ ዞረይሳት ደእኮ፥ ሳሮይ ደኤስ።<verse eid="PRO 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 11:15"/>ኤረና ኡራስ ዋሰ ግድያ አስ ቱማፐ መቶታና፤ ሄሳፈ ዋሰ ግዶና እፀይስ ሎኦ።<verse eid="PRO 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 11:16"/>ኡሎ ኬሀ ማጫስ ቦንቸታዉሱ፤ ሽን ኢታ አስ ዱረተ ፃላላ ዱረቴስ።<verse eid="PRO 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 11:17"/>ኬሀ አስ ባዉ ሎኦባ ኦስ፤ ሽን ዎዛና ምኖ አስ ባና ቆሄስ።<verse eid="PRO 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 11:18"/>ኢታ አስ ደምያ ሚሸይ ጭሞ፤ ሽን ፅሎተ ዘርያ ኡራይ ቱማ ዎይቶ ጫካና።<verse eid="PRO 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 11:19"/>ፅሎተን ምንድ ደእያ ኡራይ ፓፃ ደአና፤ ሽን ኢታተ ካልያ ኡራይ ሀይቃና።<verse eid="PRO 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 11:20"/>ጎዳይ ኢታ ቆፋይ ደእያ አሳታ እፄስ፤ ሽን ሱረ ሄመተይሳታን ኡፋይቴስ።<verse eid="PRO 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 11:21"/>ኢታ አስ ሴረቶና አተና፤ ሽን ፅሎታ ኮቻይ አታና።<verse eid="PRO 11:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>ቆፍ ባይና ማላ ሎኦ ማጫ ፑላተይ</para>
  <para style="q2" vid="PRO 11:22">ጉዱን ስን አዳ ዎርቃ መላ።<verse eid="PRO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 11:23"/>ፅሎታ አሙዋስ ፖሎይ ሎኦ ፃላላ፤ ሽን ኢታታ አሙዋስ ፖሎይ ሀንቆ ፃላላ።<verse eid="PRO 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 11:24"/>እስ እስ አሳት ባንታ ሚሸ አሳስ ጮ ኬሆሶና፤ ሽን ኤንታ አቆይ ሃ ዳሬስ። ሀራ አሳት ቃስ ባንታ ሚሻስ ፓላ ኡዘቶሶና፤ ሽን ኤንታ አቆይ ያ ፓጬስ።<verse eid="PRO 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 11:25"/>ኬሀ አስ ዱረታና፤ ሀራታ ማድያ አስ ማደታና።<verse eid="PRO 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 11:26"/>ካ አልእን ባይዛናዉ ምንጅያ ኡራ አሳይ ባዴስ። ሽን ባ ካ አሳይ ኮይያ ዎደ ባይዝያ ኡራ አንጄስ።<verse eid="PRO 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 11:27"/>ሎኦባ ምንድ ኮይያ ኡራይ ኡፋይሳ ደሜስ፤ ሽን ኢታባ ኮይያ ኡራ ኢታባይ ደሜስ።<verse eid="PRO 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 11:28"/>ባ ዱረተ አማነትያ አስ ኩንዳና፤ ሽን ፅሎት ባልጎ ምዳ።<verse eid="PRO 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 11:29"/>ባ ሶ አሳ ቦላ ቡቀ ደንያ ኡራይ ጎኤትያባይ አይብካ ባዋ። ኤያትካ ጭንጫታስ አይለ ግዳና።<verse eid="PRO 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 11:30"/>ፅሎ አስ ደኦ አይፈ አይፍያ ም መላ፤ ሸምፖ አሸይሳት ጭንጫታ።<verse eid="PRO 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 11:31"/>ፅሎት ሳአን ባንታ ኦሶ ጋተ ኤክያባ ግድኮ፥ ኢታትነ ናጋራንቻት ባንታ ኦሱዋስ ኤካና ጋተይ ዋንድ ዳራንዴሻ!<verse eid="PRO 11:31"/></para>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 12:1"/>ሴራ ዶስያ ኡራይ ኤራተ ዶሴስ፤ ሽን ሴራ እፅያ ኡራይ ኤያ።<verse eid="PRO 12:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 12:2"/>ሎኦ አስ ጎዳፐ ሳባ ደሜስ፤ ሽን ጎዳይ ገናንቾታ ፕርዴስ።<verse eid="PRO 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 12:3"/>አስ ኢታተን ምንድ ኤቀና፤</para>
  <para style="q2" vid="PRO 12:3">ሽን ፅሎታ ፃጶይ ቃፀና።<verse eid="PRO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 12:4"/>ዎዛናማ ማችያ ባ አዝናስ ካላቻ መላ፤</para>
  <para style="p" vid="PRO 12:4">ሽን ባ አዝና ካዉሽያ ማችያ መቀ ምያ አጃጀ መላ።<verse eid="PRO 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 12:5"/>ፅሉዋ ቆፋይ ሱረ፤ ሽን ኢታታ ዞረይ ጭሞ።<verse eid="PRO 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 12:6"/>ኢታታ ዞረታይ አሳ ቆሀናሳ፤ ሽን ፅሎታ ዞረታይ ኤንታ አሻናሳ።<verse eid="PRO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 12:7"/>ኢታ አሳት ኩንዳና፤ ኤንታዉ ዘረካ አተና፤ ሽን ፅሎታ ኮቻይ ምንድ ደአና።<verse eid="PRO 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 12:8"/>አስ ባ ጭንጫተ መላ ጋላተቴስ፤ ሽን ጌላ ቆፋይ ደእያ አስ ካቴስ።<verse eid="PRO 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 12:9"/>ዱረ አስ ዳንድ፥ መቶን ደእያ አሳፐ ጮ አሳ ዳንድ፥ ኦድ ባ ደኦ ሱግያ አስ ኬሀ።<verse eid="PRO 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 12:10"/>ፅሎ አስ ባ መሄስ ቃቴስ፥ ሽን ዎዛና ምኖ አሳስ ቃይ ባዋ።<verse eid="PRO 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 12:11"/>ባ ቢታ ምን ኦያ ኡራይ ካ ካሌስ፤ ሽን ፓናባ የደያ ኡራይ አኬክ ፓጭዳይሳ።<verse eid="PRO 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 12:12"/>ኢታት ናጋራንቾ አሳታ ድአናዉ አሞቶሶና፤ ሽን ፅሎታ ፃጶይ ዳይድ ደአና።<verse eid="PRO 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 12:13"/>ኢታ አሳ እያ ዶናፐ ከይዳ ኦድ ፅሄ ግድድ ኦይኬስ፤ ሽን ፅሎይ መቶፐ ከስ ኤኬስ።<verse eid="PRO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 12:14"/>አስ ባ ዶናፐ ከይያ ቃላን ሎኦባ ካሌስ፤ ባ ኦዳ ኦሶ ጋትያ ኤኬስ።<verse eid="PRO 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 12:15"/>ኤያ አስ ብያ ቡሳይ አዉ እያ ሁጰን ልከ ዳኔስ፤ ሽን ጭንጫ አስ ዞረ ስኤስ።<verse eid="PRO 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 12:16"/>ኤያ ኡራ ሀንቆይ ኤለስድ ኤረቴስ፤ ሽን ጭንጫ አስ ጫሸ ዉዳ ጌና።<verse eid="PRO 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 12:17"/>ቱማ ሃሳይያ አስ ሱረባ ኦዴስ፤ ሽን ዎርዶ ማርካይ ዎርዶ ኦዴስ።<verse eid="PRO 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 12:18"/>አኬኮና ኦደትያ ኦድ ማሻዳ ጫዴስ፤</para>
  <para style="q2" vid="PRO 12:18">ሽን ጭንጫ እንፃርሳይ ፓስ።<verse eid="PRO 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 12:19"/>ዎርዶ ኦድ ጉ ዎደሳ፤ ሽን ቱማ ኦድ መርናዉ ደአና።<verse eid="PRO 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 12:20"/>ኢታ ቆፕያ አሳ ዎዛናን ጭሞይ ደኤስ፤</para>
  <para style="q2" vid="PRO 12:20">ሽን ሳሮባ ዞረተይሳታ ዎዛናን ኡፋይሳይ ኩሜስ።<verse eid="PRO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 12:21"/>ፅሎታ መቶይ ጋከና፤ ሽን ኢታታስ መቶይ ዳራና።<verse eid="PRO 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 12:22"/>ጎዳይ ዎርዳንቾታ እፄስ፤ ሽን ቱማንቾ አሳታን እ ኡፋይቴስ።<verse eid="PRO 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 12:23"/>ጭንጫ አስ ባ ኤራ ቆቴስ፤ ሽን ኤያት ባንታ ኤያተ ኦዶሶና።<verse eid="PRO 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 12:24"/>ምንድ ኦያ ኡራይ ደረ ሃሬስ፤ ሽን አዛላ አስ ሃረቴስ።<verse eid="PRO 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 12:25"/>ኡንአን ኩምዳ ዎዛን አዛኖ ኤሄስ፤ ሽን ኬሀ ኦድ እያ ኡፋይሴስ።<verse eid="PRO 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 12:26"/>ፅሎ አስ ባ ሾሩዋ ዞርድ፥ ሱረ ኦገ ካለስ፤ ሽን ኢታት ኦገ ቱማፐ ሃሴስ።<verse eid="PRO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 12:27"/>አዛላ አስ ሻንካትድ ኤህዳ አሾ ካና፤</para>
  <para style="q2" vid="PRO 12:27">ሽን ምንድ ኦያ ኡራይ ባ ሚሽያስ ምሸቴስ።<verse eid="PRO 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 12:28"/>ፅሎተ ኦገን ደኦይ ደኤስ፤ ሄ ኦገን ሀይቆይ ባዋ።<verse eid="PRO 12:28"/></para>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 13:1"/>ኤራንቾ ናአይ ባ አዋ ሴራ ስኤስ፤ ሽን ቀልቅሰይስ ሴራ ኤከና።<verse eid="PRO 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 13:2"/>አስ ባ ዶናፐ ከይያ ቃላን ሎኦባ ኤኬስ፤ ሽን አማነቶናይሳት ማካላባ አሞቶሶና።<verse eid="PRO 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 13:3"/>ባ ዶና ናግያ ኡራይ ባ ሸምፑዋ ናጌስ፤</para>
  <para style="q2" vid="PRO 13:3">ሽን ኤሶን ሃሳያ ኡራይ ባና ይሴስ።<verse eid="PRO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 13:4"/>አዛላይ አሞቴስ፤ አሞትኮነ አይባካ ደመና፤ ሽን ምንድ ኦይሳት ካላና።<verse eid="PRO 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 13:5"/>ፅሎ አሳት ዎርዶ ኦዳ እፆሶና። ሽን ኢታ አሳታ ኦድ ዬላዬስነ ካዉሼስ።<verse eid="PRO 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 13:6"/>ሱረ ደኡዋ ደእያ ኡራ እያ ፅሎተይ ናጌስ፤ ሽን ናጋራንቾ እያ ናጋራይ ኦንጌስ።<verse eid="PRO 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 13:7"/>ባና ዱረ ዳንስያ አስ ደኤስ፤ ሽን እያዉ አይብነ ባዋ፤ ቃስ ባና ማንቆ ዳንስያ አስ ደኤስ፤ ሽን እያዉ ዳሮ አቆይ ደኤስ።<verse eid="PRO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 13:8"/>አስ ባ ሚሸን ባ ሸምፖ ዎዛናዉ ዳንዳኤስ፤ ሽን ማንቁዋ ያሽስያባይ ባዋ።<verse eid="PRO 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 13:9"/>ፅሎታ ፖኦይ ጶሌስ፤</para>
  <para style="q2" vid="PRO 13:9">ሽን ኢታታ ፆምፐይ ቶአና።<verse eid="PRO 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 13:10"/>ኦቶሮይ ኦሽ የሌስ፤ ሽን ዞረ ኤከይሳት ጭንጫታ።<verse eid="PRO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 13:11"/>ዳቡር ባይና ደምዳ ሚሸይ ኤሶን ዬስ፤ ሽን ምን ኦድ ደምዳ አቆይ፥ ዳር ዳርድ ቤስ።<verse eid="PRO 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 13:12"/>ኮይያባይ ፖለቶና ጋምኤይስ አዛንስ፤ ሽን አሞትዳባይ ፖለተይስ ኡፋይሴስ።<verse eid="PRO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 13:13"/>ዞረ ካያ ኡራይ መቶን ገሌስ፤ ሽን ኪታ ቦንችያ ኡራይ ሳሮ ደአና።<verse eid="PRO 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 13:14"/>ጭንጫተ እምያ ትምርተይ ደኦ ፑልቶ፤ ህገይ አሰ ሀይቆ ፅሄፐ ከስ ኤካናዉ ማዴስ።<verse eid="PRO 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 13:15"/>አኬክ ደእያ ኡራይ ቦንቸቴስ፤ ሽን አማነቶና እፆይ ቆሆስ ጋስ።<verse eid="PRO 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 13:16"/>ጭንጫ አስ ኡባይ ኤራን ኦስ፤ ሽን ኤይ ባ ኤያተ ቆንጭሴስ።<verse eid="PRO 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 13:17"/>ኢታ አሳት ኪተትድ፥ መቶን ገሎሶና፤ ሽን አማንያ አሳት ኪተትድ፥ ሳሮተ ኤሆሶና።<verse eid="PRO 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 13:18"/>ሴራ እፅያ አስ ማንቄስነ ዬላቴስ፤</para>
  <para style="q2" vid="PRO 13:18">ሽን ሴራ ኤክያ ኡራይ ቦንቸቴስ።<verse eid="PRO 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 13:19"/>አሞትዳባይ ፖለተይስ ዳሮ ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 13:19">ሽን ኢታት ኢታባፐ ሃካናዉ ኮዮኮና።<verse eid="PRO 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 13:20"/>ጭንጫ አሳራ ሄመትያ አስ ጭንጫ ግዴስ፤</para>
  <para style="q2" vid="PRO 13:20">ሽን ኤያ አሳራ ሄመትያ አስ መቶን ገሌስ።<verse eid="PRO 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 13:21"/>ናጋራንቾታ ኢታ ቃዳይ ካሌስ፤</para>
  <para style="q2" vid="PRO 13:21">ሽን ዱረተ ፅሎታ ዎይቶ።<verse eid="PRO 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 13:22"/>ሎኦ አስ ባ ናይታ ናይታ ላትሴስ፤</para>
  <para style="q2" vid="PRO 13:22">ሽን ናጋራንቹዋ አቆይ ፅሉዋስ ዳጋየቴስ።<verse eid="PRO 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 13:23"/>ማንቁዋ ጎሻይ ዳሮ ካ አይፈናዉ ዳንዳኤስ፤</para>
  <para style="q2" vid="PRO 13:23">ሽን ሱረ ፕርዳ ፓጫን ዬስ።<verse eid="PRO 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 13:24"/>ፕርጮን ሴራናዉ ዶሶና አስ ባ ናኣ እፄስ፤</para>
  <para style="q2" vid="PRO 13:24">ሽን ባ ናኣ ሲቅያ ኡራይ ምንድ ሴሬስ።<verse eid="PRO 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 13:25"/>ፅሎይ፥ ኡሎይ ካላና ጋካናዉ ሜስ፤</para>
  <para style="q2" vid="PRO 13:25">ሽን ናጋራንቾይ ኡባ ዎደ ኮሻታና።<verse eid="PRO 13:25"/></para>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 14:1"/>ጭንጫ ማጫስ ባ ኬ ኬፃዉሱ፤</para>
  <para style="q2" vid="PRO 14:1">ሽን ኤያ ማጫስያ ባ ኬ ባ ኩሸን ላላዉሱ።<verse eid="PRO 14:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 14:2"/>ሱረ ሄመትያ አስ ጎዳ ያዬስ፤</para>
  <para style="q2" vid="PRO 14:2">ሽን ባ ኦገ ጌላይያ አስ ጎዳ ካስ።<verse eid="PRO 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 14:3"/>ኤያ ኦድ እያ ዞኩዋስ ፃምአ ኤሄስ፤</para>
  <para style="q2" vid="PRO 14:3">ሽን ጭንጫታ እንፃርሳይ ኤንታ ናጌስ።<verse eid="PRO 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 14:4"/>ቦር ባይና እፅኮ ሻለይ ካይስ ግዴስ፤</para>
  <para style="q2" vid="PRO 14:4">ሽን ጎሻ ቦር ደእኮ፥ ነ ሻለይ ካን ኩሜስ።<verse eid="PRO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 14:5"/>አማነትያ ማርክ ኡባ ዎደ ቱማ ኦዴስ፤</para>
  <para style="q2" vid="PRO 14:5">ሽን ዎርዶ ማርክ ዎርዶ ፃላላ ኦደቴስ።<verse eid="PRO 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 14:6"/>ቀልቅስያ አስ ጭንጫተ ኮዬስ፥ ሽን ደመና፤</para>
  <para style="q2" vid="PRO 14:6">አኬክ ደእያ አስ ኤራተ ደሞይ ዋይሰና።<verse eid="PRO 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 14:7"/>ኤያ አሳፐ ሃካ፤</para>
  <para style="q2" vid="PRO 14:7">ኔኒ እያ ኦዳፐ ኤራተ ደማካ።<verse eid="PRO 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 14:8"/>ጭንጫ አስ ጭንጫ ግድያ ባ ኦያባ ኤሬስ፤</para>
  <para style="q2" vid="PRO 14:8">ሽን ኤያ አሳ ኤያተይ እያ ባለስ።<verse eid="PRO 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 14:9"/>ኤያት ናጋራ ኦሸ፥ ቂሮታናይሳ አግድ ቀልቅሶሶና፤</para>
  <para style="q2" vid="PRO 14:9">ሽን ሱረት ባንታ ናጋራይ አቶ ጌተታናዉ ኮዮሶና።<verse eid="PRO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 14:10"/>እስ እስ ዎዛን ባ አዛኑዋ ኤሬስ፤</para>
  <para style="q2" vid="PRO 14:10">እያ ኡፋይሳ ኦንካ እያራ ኮፀና።<verse eid="PRO 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 14:11"/>ኢታታ ኬይ ላለታና፤</para>
  <para style="q2" vid="PRO 14:11">ሽን ሱረታ ኬይ ምንድ ዳና።<verse eid="PRO 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 14:12"/>አሳስ ልከ ዳንያ ኦገይ ደኤስ፤</para>
  <para style="q2" vid="PRO 14:12">ሽን እያ ዉርሰይ ሀይቆኮ ጋስ።<verse eid="PRO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 14:13"/>ሚቻ ዎደካ ዎዛናን አዛኖይ ደኤስ፤</para>
  <para style="q2" vid="PRO 14:13">ኡፋይሳ ዉርሰይ አዛኖ ግዳናዉ ዳንዳኤስ።<verse eid="PRO 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 14:14"/>ኢታ አስ ባ ኢታ ኦሱዋ ጋተ ኤካና፤</para>
  <para style="q2" vid="PRO 14:14">ሎኦ አስካ ባ ሎኦ ኦሱዋ ጋተ ኤካና።<verse eid="PRO 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 14:15"/>ኤያ አስ ኡባባ አማኔስ፤</para>
  <para style="q2" vid="PRO 14:15">ሽን ጭንጫ አስ አኬክድ ታንጌስ።<verse eid="PRO 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 14:16"/>ጭንጫ አስ ጎዳ ያዬስ፤ ኢታፐ ሃኬስ፤</para>
  <para style="q2" vid="PRO 14:16">ሽን ኤያ አስ ኤሶተስነ ኢታፐ ናገተና።<verse eid="PRO 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 14:17"/>ኤለ ሀንቀትያ አስ ኤያ ኦሶ ኦስ፤</para>
  <para style="q2" vid="PRO 14:17">ሽን ጭንጫ አስ ዳንዳአንቾ።<verse eid="PRO 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 14:18"/>አኬክ ባይና አስ ባ ኤያተ ጋትያ ኤኮሶና፤</para>
  <para style="q2" vid="PRO 14:18">ሽን ጭንጫ አስ ኤራተ ካላቻዳ ጎፆሶና።<verse eid="PRO 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 14:19"/>ኢታት ሎኦታ ስንን ጉልባታና፤</para>
  <para style="q2" vid="PRO 14:19">ናጋራንቻት ፅሎታ ፐንገን ሆካና።<verse eid="PRO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 14:20"/>ማንቆይ ባ ሾሩዋን እፀቴስ፤</para>
  <para style="q2" vid="PRO 14:20">ሽን ዱረታስ ዳሮ ላገት ደኦሶና።<verse eid="PRO 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 14:21"/>ባ ሾሩዋ ካያ አስ ናጋራ ኦስ፤</para>
  <para style="q2" vid="PRO 14:21">ሽን ማንቁዋ ማድያ አስ አንጀትዳይሳ።<verse eid="PRO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 14:22"/>ኢታባ ማቀተይሳት ባሎሶና ግዶኮና?</para>
  <para style="q2" vid="PRO 14:22">ሽን ሎኦባ ኦናዉ ሀልቸይሳት</para>
  <para style="q2" vid="PRO 14:22">አማነተነ ሲቆ ደሞሶና።<verse eid="PRO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 14:23"/>ምንድ ኦያ ኦሶ ኡባን ዎይ ደኤስ፤</para>
  <para style="q2" vid="PRO 14:23">ሽን ጮ ኦድ ማንቆተ ኤሄስ።<verse eid="PRO 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 14:24"/>ጭንጫታስ ኤንታ ዱረተይ ኤንታዉ ካላቻ፤</para>
  <para style="q2" vid="PRO 14:24">ሽን ኤያት ጉጅ ጉጅ ኤዮሶና።<verse eid="PRO 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 14:25"/>ቱማ ማርክ ሸምፖ አሼስ፤</para>
  <para style="q2" vid="PRO 14:25">ሽን ዎርዶ ማርክ ባለስ።<verse eid="PRO 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 14:26"/>ጎዳ ያይያ አሳስ ምኖ ሚፃይ ደኤስ፤</para>
  <para style="q2" vid="PRO 14:26">እያ ናይታስ ባቃትድ አትያ በሲ ደኤስ።<verse eid="PRO 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 14:27"/>ጎዳ ያሽ ደኦ ፑልቶ፤</para>
  <para style="q2" vid="PRO 14:27">ሀይቆ ፅሄፐ አሰ አሼስ።<verse eid="PRO 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 14:28"/>ካዎ ግታተ እ ሃርያ አሳ ዳሮተና፤</para>
  <para style="q2" vid="PRO 14:28">ሽን ሃረትያ አስ ይኮ እካ ፓና።<verse eid="PRO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 14:29"/>ዳንዳአንቾ አሳስ ግታ አኬክ ደኤስ፤</para>
  <para style="q2" vid="PRO 14:29">ሽን ኤለ ሀንቀትያ አስ ባ ኤያተ ቆንጭሴስ።<verse eid="PRO 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 14:30"/>ሳሮ ዎዛን አሳተስ ፓያተ እሜስ፤</para>
  <para style="q2" vid="PRO 14:30">ሽን ቃናተይ አሳተስ አጃጀ ሀርገ መላ።<verse eid="PRO 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 14:31"/>ማንቆታ ናቅያ አስ ኤንታ መዳይሳ ጫዬስ፤</para>
  <para style="q2" vid="PRO 14:31">ሽን መቶታንቾታስ ኬህያ አስ ፆሳ ቦንቼስ።<verse eid="PRO 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 14:32"/>ኢታት ባንታ ኢታ ኦሶን ኩንዳና፤</para>
  <para style="q2" vid="PRO 14:32">ሽን ፅሎታስ ሀይቆፐ አትያ ሚፅ ደኤስ።<verse eid="PRO 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 14:33"/>አኬካንቾ አሳ ዎዛናን ጭንጫተ ኩምስ፤</para>
  <para style="q2" vid="PRO 14:33">ሽን ኤያት ጭንጫተ አይበኮ ኤሮኮና።<verse eid="PRO 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="PRO 14:34"/>ፅሎተ እስ ካዎተ ቁ ቁ ኦስ፤</para>
  <para style="q2" vid="PRO 14:34">ሽን ናጋር አይ አስካ ካዉሼስ።<verse eid="PRO 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="PRO 14:35"/>ኤራንቾ አይለታን ካዎይ ኡፋይቴስ፤</para>
  <para style="q2" vid="PRO 14:35">ሽን ዬላያ አይለይ ካዋ ሀንቀስ።<verse eid="PRO 14:35"/></para>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 15:1"/>ሊቆ እንፃርስ ሀንቆ ዛርብሴስ፤</para>
  <para style="q2" vid="PRO 15:1">ሽን ዶምኤያ ቃል ሀንቆ ደንስ።<verse eid="PRO 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>ጭንጫታ እንፃርሳይ ኤራ ፑላዬስ፤</para>
  <para style="q2" vid="PRO 15:2">ሽን ኤያታ ዶናይ ኤያተ ፑልትሴስ።<verse eid="PRO 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>ጎዳ አይፈት ኡባ በሲ ፄሎሶና፤</para>
  <para style="q2" vid="PRO 15:3">ኢታታነ ሎኦታ ሻክድ በኦሶና።<verse eid="PRO 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>ሎኦ ኦድ ደኦ ም መላ፤</para>
  <para style="q2" vid="PRO 15:4">ሽን ጌላ ኦድ አያና መንስ።<verse eid="PRO 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 15:5"/>ኤይ ባ አዋ ሴራ ካስ፤</para>
  <para style="q2" vid="PRO 15:5">ሽን ባ አዋ ሴራ ኤክያ አስ ጭንጫ።<verse eid="PRO 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>ፅሎ ኡራ ኬን ዳሮ ሚሸይ ደኤስ፤</para>
  <para style="q2" vid="PRO 15:6">ሽን ኢታታ ሶ ገልያ ሚሸይ መቶ ኤሄስ።<verse eid="PRO 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>ጭንጫታ ዶናይ ኤራ ዘሬስ፤</para>
  <para style="q2" vid="PRO 15:7">ሽን ኤያታ ዎዛናይ ሄሳ መላ ግደና።<verse eid="PRO 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>ጎዳይ ኢታታ ያርሹዋ እፄስ፤</para>
  <para style="q2" vid="PRO 15:8">ሽን ሱረታ ዎሳን እ ኡፋይቴስ።<verse eid="PRO 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>ጎዳይ ኢታ አሳታ ኦግያ እፄስ፤</para>
  <para style="q2" vid="PRO 15:9">ሽን ፅሎተ ካለይሳታ እ ዶሴስ።<verse eid="PRO 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>ልከ ኦግያ አግዳ አስ ፕርድ ናጌስ፤</para>
  <para style="q2" vid="PRO 15:10">ሴራ እፅያ አስ ሀይቄስ።<verse eid="PRO 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 15:11"/>ዱፎይነ ዮይ ጎዳ ስንን ቆንጨ፤</para>
  <para style="q2" vid="PRO 15:11">ያትን፥ አሳ ዎዛና ቆፋይ ዋን እያፐ ጌማኔ?<verse eid="PRO 15:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>ቀልቅስያ አስ ሴራ ዶሰና፤</para>
  <para style="q2" vid="PRO 15:12">ጭንጫታፐ ዞረ ኦይቸና።<verse eid="PRO 15:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>ዎዛን ኡፋይትን፥ ሶምኦይ ፖኤስ፤</para>
  <para style="q2" vid="PRO 15:13">ሽን ዎዛን አዛንኮ፥ አያን መቄስ።<verse eid="PRO 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>አኬካ ዎዛን ደእያ አስ ኤራተ ኮዬስ፤</para>
  <para style="q2" vid="PRO 15:14">ሽን ኤያት ባንታ ኤያተን ኡፋይቶሶና።<verse eid="PRO 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 15:15"/>ማንቆታ ደኦይ ኡባ ዎደ ባፀ፤</para>
  <para style="q2" vid="PRO 15:15">ሽን ኡፋይትያ አስ ኡባ ዎደ አለስ።<verse eid="PRO 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>ኦሻራ ደእያ ግታ አቆፐ</para>
  <para style="q2" vid="PRO 15:16">ጎዳ ያሻራ ደእያ ጉባይ ኬሀ።<verse eid="PRO 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>ኦሽ ደእያ በሳን ሞ አሾ ማናፐ</para>
  <para style="q2" vid="PRO 15:17">ሲቆይ ደእያ በሳን ሳን ኬሀ።<verse eid="PRO 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>ሀንቆይ ኦሽ ከሴስ፤</para>
  <para style="q2" vid="PRO 15:18">ሽን ዳንዳእ ኦሽ እርፅሴስ።<verse eid="PRO 15:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>አዛላ አሳ ኦገይ አጉንን ድረትስ፤</para>
  <para style="q2" vid="PRO 15:19">ሽን ሱረ አሳ ኦገይ ጊጋ።<verse eid="PRO 15:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>ጭንጫ ናእ ባ አዋ ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 15:20">ሽን ኤያ ናእ ባ አይዉ ካስ።<verse eid="PRO 15:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>ዎዛን ባይና አስ ባ ኤያተን ኡፋይቴስ፤</para>
  <para style="q2" vid="PRO 15:21">ሽን ዎዛናማ አስ በሲያ ባ ኦስ።<verse eid="PRO 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 15:22"/>ዞረይ ይኮ፥ ቆፕዳባይ ሀድሬስ፤</para>
  <para style="q2" vid="PRO 15:22">ዳሮ ዞረይ ደእያ በሳን ቆፕዳባይ ፖለቴስ።<verse eid="PRO 15:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>ኦይሻስ በሲያ ዛሮ እሞይ ሄ ኡራ ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 15:23">ባ ዎደን ኦደትያ ኦድ አይ መላ ኡፋይስ!<verse eid="PRO 15:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>ጋርሳን ደእያ ስኦለፐ አታና መላ</para>
  <para style="q2" vid="PRO 15:24">ደኦ ኦገይ አኬካ ኡራ ፑደ ካለስ።<verse eid="PRO 15:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>ጎዳይ ኦቶራንቾታ ኬ ላላና፤</para>
  <para style="q2" vid="PRO 15:25">ሽን አምኤ ዛዋ ናጌስ።<verse eid="PRO 15:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26"/>ጎዳይ ኢታታ ቆፋ እፄስ፤</para>
  <para style="q2" vid="PRO 15:26">ሽን ጌሻ ቃላን እ ኡፋይቴስ።<verse eid="PRO 15:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>ዎርዶን ዎ ደማናዉ አልያ አስ</para>
  <para style="q2" vid="PRO 15:27">ባ ሶ አሳ ቦላ መቶ ኤሄስ፤</para>
  <para style="q2" vid="PRO 15:27">ሽን ዎፈ እፅያ አስ ደኦን ዳና።<verse eid="PRO 15:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>ፅሎ አስ ኦደታናፔ ስንትድ ቆፔስ፤</para>
  <para style="q2" vid="PRO 15:28">ሽን ኢታታ እንፃርሳፐ ኢታባይ ፑልቴስ።<verse eid="PRO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 15:29"/>ጎዳይ ኢታታፐ ሃኬስ፤</para>
  <para style="q2" vid="PRO 15:29">ሽን ፅሎታ ዎሳ ስኤስ።<verse eid="PRO 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 15:30"/>ሶምኦይ ፓሽክን ዎዛን ኡፋይቴስ፤</para>
  <para style="q2" vid="PRO 15:30">ምሽራቾይ መቀ ምንስ።<verse eid="PRO 15:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>ደኦ እምያ ዞረ ስእያ አስ</para>
  <para style="q2" vid="PRO 15:31">ጭንጫተራ እስፈ ዳና።<verse eid="PRO 15:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>ሴራ እፅያ አስ ባና ቆሄስ፤</para>
  <para style="q2" vid="PRO 15:32">ሽን ሴራ ኤክያ አስ አኬካ ደሜስ።<verse eid="PRO 15:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>ጎዳስ ያሽ ጭንጫተ ታማርሴስ፤</para>
  <para style="q2" vid="PRO 15:33">አሽከተ ቦንቾፈ ስንቴስ።<verse eid="PRO 15:33"/></para>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 16:1"/>አስ ባ ዎዛናን ሀልቼስ፤</para>
  <para style="q2" vid="PRO 16:1">ሽን ልከ ዛሮይ ጎዳፐ በንቴስ።<verse eid="PRO 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>አስ ኦያ ኦሶ ኡባይ እያዉ ልከ ዳኔስ፤</para>
  <para style="q2" vid="PRO 16:2">ሽን ጎዳይ ደንዶ ቆፋ በኤስ።<verse eid="PRO 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>ነ ኦሶ ኡባ ጎዳስ ሀዳራ እማ፤</para>
  <para style="q2" vid="PRO 16:3">ኔኒ ቆፕዳባይ ፖለታና።<verse eid="PRO 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>ጎዳይ ኡባባይ ቆፕዳይሳ ባና መላ ኦስ፤</para>
  <para style="q2" vid="PRO 16:4">ሀንኮካ፥ ማካላንቾታ ዉርሰይ ዮ።<verse eid="PRO 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>ጎዳይ ኦቶራንቾታ እፄስ፤</para>
  <para style="q2" vid="PRO 16:5">ኤንቲ ሴረቶና አቶኮና።<verse eid="PRO 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>ሲቆንነ አማነተን ናጋር አቶ ጌተቴስ፤</para>
  <para style="q2" vid="PRO 16:6">ጎዳስ ያይድ አስ ኢታባፐ አቴስ።<verse eid="PRO 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>አሳ ሄመ ጎዳ ኡፋይስያባ ግድኮ፥</para>
  <para style="q2" vid="PRO 16:7">እ ባ ሞርከታራ ሳሮ ዳናዳ ኦስ።<verse eid="PRO 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>ፅሎተን በንትያ ጉባይ፥</para>
  <para style="q2" vid="PRO 16:8">ዎርዶን ደምያ ዳሮ ዎፐ ሎኦ።<verse eid="PRO 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>አስ ዎዛናን ባ ኦናባ ሀልቼስ፤</para>
  <para style="q2" vid="PRO 16:9">ሽን ሀልቾይ ጎዳ ማደን ፖለቴስ።<verse eid="PRO 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>ካዎይ ፆሳፈ ኤክዳ ማታን ፕርዴስ፤</para>
  <para style="q2" vid="PRO 16:10">እያ እንፃርሳይ ሱረ ፕርዴስ።<verse eid="PRO 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>ግና ምዛነትነ ማካ ሚሸት ጎዳባ፤</para>
  <para style="q2" vid="PRO 16:11">ባይዝያባ ኡባን ገነይ ዶና መላ ጎዳይ ኮዬስ።<verse eid="PRO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 16:12"/>ካዎት ኢታ ኦሶ እፆሶና፤</para>
  <para style="q2" vid="PRO 16:12">ኤንታ አራታይ ፅሎተን ኤቄስ።<verse eid="PRO 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>ካዎት ፅሎ እንፃርሳን ኡፋይቶሶና፤</para>
  <para style="q2" vid="PRO 16:13">ቱማ ሃሳያ ኡራ ዶሶሶና።<verse eid="PRO 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>ካዋ ሀንቆይ ሀይቆ ኪታንቾ መላ፤</para>
  <para style="q2" vid="PRO 16:14">ሽን ጭንጫ አስ ሀንቁዋ እርፅሴስ።<verse eid="PRO 16:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>ካዋ ሶምኦይ ፖእኮ ደኦይ ደኤስ፤</para>
  <para style="q2" vid="PRO 16:15">እያ ሎኦተይ እራ ኤህያ ሻራ መላ።<verse eid="PRO 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>ጭንጫተ ደሞይ ዎርቃ ደሞፐ አስ፤</para>
  <para style="q2" vid="PRO 16:16">አኬካ ደሞይ ብራ ደሞፐ ሎኦ።<verse eid="PRO 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>ሱረታ ኦገይ ኢታፐ ሃኮ፤</para>
  <para style="q2" vid="PRO 16:17">ባ ሄመ ናግያ ኡራይ ባ ሸምፑዋ ናጌስ።<verse eid="PRO 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>ኦቶሮይ ዮ ካለስ፤</para>
  <para style="q2" vid="PRO 16:18">ጬቀተ ኩንደ ኤሄስ።<verse eid="PRO 16:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>ኦቶራንቾታራ ድኦ ሻከታናፐ፥</para>
  <para style="q2" vid="PRO 16:19">አሽከ ግድድ ማንቅድ ደኤይስ ሎኦ።<verse eid="PRO 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>ዞረ ስእያ ኡራስ እ ኦያባ ኡባይ እንጀታና፤</para>
  <para style="q2" vid="PRO 16:20">ጎዳን አማነትያ ኡራይ አንጀታና።<verse eid="PRO 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>ባ ቆፋን ጭንጫ ግድዳ አስ አኬካንቾ ጌተቴስ፤</para>
  <para style="q2" vid="PRO 16:21">ሎኦ ቃል ኤራተ ጉጄስ።<verse eid="PRO 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>ጭንጫ አሳስ ኤራተ ደኦ ፑልቶ መላ፤</para>
  <para style="q2" vid="PRO 16:22">ሽን ኤያታ ሴሮይ ጮ ዎደ ዉርሴስ።<verse eid="PRO 16:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>ጭንጫ አስ ኦደታናፐ ስን ቆፔስ፤</para>
  <para style="q2" vid="PRO 16:23">እያ መተርሻይ ኤራተ ጉጄስ።<verse eid="PRO 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>ሎኦ ቃል ኤሳ እልሎዳ ማልኤስ፤</para>
  <para style="q2" vid="PRO 16:24">ሸምፖስ ማልኦ፤ መቀስ ፓፆ ግዴስ።<verse eid="PRO 16:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>አሳስ ሱረ ዳንያ ኦገይ ደኤስ፤</para>
  <para style="q2" vid="PRO 16:25">ሽን ዉርሰን ሀይቆኮ ጋስ።<verse eid="PRO 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26"/>አስ ምንድ ኦና መላ ኦይ ካ አሞ፤</para>
  <para style="q2" vid="PRO 16:26">ኮሽ ምንድ ኦና መላ ደንስ።<verse eid="PRO 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>ካዉሻ አስ ኢታባ ሀልቼስ፤</para>
  <para style="q2" vid="PRO 16:27">እያ ኦዳይ ታማዳ ፁጌስ።<verse eid="PRO 16:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>ዎበ አስ ኦሽ ደንስ፤</para>
  <para style="q2" vid="PRO 16:28">ዝግርስ አማነትያ ላገታ ሻኬስ።<verse eid="PRO 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>ገነ አስ ባ ሾሩዋ ጭሜስ፤</para>
  <para style="q2" vid="PRO 16:29">ሎኦ ግዶና ኦገ ካለስ።<verse eid="PRO 16:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>ባ አይፈን ቃምኦትያ አስ ጌላባ ቆፔስ፤</para>
  <para style="q2" vid="PRO 16:30">ባ መተርሻ ሳፅድ ማንድያ አስ ኢታባ ኦስ።<verse eid="PRO 16:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>ፑሉምዳ ሁጰይ ቦንቾ ካላቻ፤</para>
  <para style="q2" vid="PRO 16:31">ሄስካ በንተይ ፅሎ ደኦ ደእና።<verse eid="PRO 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>ዎልቃማ አስ ግዳናፐ ዳንዳአ አስ ግዶይ ሎኦ፥</para>
  <para style="q2" vid="PRO 16:32">ዳሮ ካታማታ ኦልድ ኦይካናፐ ባና ሃሮይ አስ።<verse eid="PRO 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>አስ ሳማ የጌስ፤</para>
  <para style="q2" vid="PRO 16:33">ሽን ዉርሰ ዛሮይ ጎዳፐ በንቴስ።<verse eid="PRO 16:33"/></para>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 17:1"/>ኦሽ ደእያ በሳን ደእያ ግታ ግብራፐ</para>
  <para style="q2" vid="PRO 17:1">ሳሮይነ ዎፕ ደእያ በሳን ኡይ ፖቆይ ሎኦ።<verse eid="PRO 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>ጭንጫ አይለይ ፓና ባ ጎዳ ናኣ ሃሬስ፤</para>
  <para style="q2" vid="PRO 17:2">እያ እሻታራ እስፈ ላታ ሻከቴስ።<verse eid="PRO 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>ዎርቅነ ብር ታማን ፓጨተይሳዳ፤</para>
  <para style="q2" vid="PRO 17:3">ጎዳይ አሳ ዎዛና ፓጬስ።<verse eid="PRO 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>ኢታ አስ ኢታ ሃሳያ ስኤስ፤</para>
  <para style="q2" vid="PRO 17:4">ዎርዳንቾይ ዎርዶ ሃሳያ ሀይዜስ።<verse eid="PRO 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>ማንቆታ ቦላ ቀልቅስያ አስ ኤንታ መዳ ፆሳ ጫዬስ፤</para>
  <para style="q2" vid="PRO 17:5">ሀራ አስ ጋክያ መቶን ኡፋይትያ አስ ሴረቶና አተና።<verse eid="PRO 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>ናአ ናእ ጭማ አሳስ ካላቻ፤</para>
  <para style="q2" vid="PRO 17:6">አዋት ባንታ ናይታስ ቦንቾ።<verse eid="PRO 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>ሎኦ ኦድ ኤያ አሳስ ጊገና፤</para>
  <para style="q2" vid="PRO 17:7">ሄሳዳካ ዎርዶ ኦድ አይሰይሳስ ጊገና።<verse eid="PRO 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>ዎፈ እመይሳስ ዎፈይ ብታ መላ፤</para>
  <para style="q2" vid="PRO 17:8">እ ብያ በሳ ኡባይ እያዉ እንጀቴስ።<verse eid="PRO 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>ቆሆ ገንያ ኡራይ ሲቆ ኮዬስ፤</para>
  <para style="q2" vid="PRO 17:9">ሽን ኦዳ ዛሪድ ዛሪድ ዎጭያ ኡራይ፥</para>
  <para style="q2" vid="PRO 17:9">አማነትያ ላገታ ሻኬስ።<verse eid="PRO 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>ኤያይ ፄቱ ቶሆ ልሶን ሾጭን ኤረይሳፈ፤</para>
  <para style="q2" vid="PRO 17:10">አኬክ ደእያ አሳስ ጮ ሀንቆይ ኤራ እሜስ።<verse eid="PRO 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>ኢታ አስ ኡባ ዎደ ጌላ፤</para>
  <para style="q2" vid="PRO 17:11">ቃይ ባይና አስ እያ ቦላ ኪተታና።<verse eid="PRO 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>ኤያራ እያ ኤያተን ጋሄታናፐ</para>
  <para style="q2" vid="PRO 17:12">ማራት ኤከትዳ ማሄራ ጋሄተ ሎኦ።<verse eid="PRO 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>ሎኦ ኦዳይሳስ ኢታ ኩሸ ዛርያ</para>
  <para style="q2" vid="PRO 17:13">ኡራ ሶፐ ኢታባይ ክቸና።<verse eid="PRO 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>ኦሽ ዶምሸ ሃ ዋ መንይሳ መላ፤</para>
  <para style="q2" vid="PRO 17:14">ሄሳ ግሾ ኦሽ ዶማናፐ ኮይሮታዳ ፓላማ አጋ።<verse eid="PRO 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>ናጋራንቹዋ ፅልሶይነ</para>
  <para style="q2" vid="PRO 17:15">ፅሉዋ ቦላ ፕርዶይ፥</para>
  <para style="q2" vid="PRO 17:15">ናምአይካ ጎዳይ እፅያ ኦሶ።<verse eid="PRO 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>ጭንጫተ ደማናዉ አሞይ ባይና ደእሽን፥</para>
  <para style="q2" vid="PRO 17:16">ኤያ ኩሸን ደእያ ሚሸይ አይ እያ ማዲ?<verse eid="PRO 17:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>ላገይ ኡባ ዎደካ ላገ፤</para>
  <para style="q2" vid="PRO 17:17">እሽ መቶ ዎደ ማዳናዉ የለቴስ።<verse eid="PRO 17:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>አኬክ ባይና አስ ኤሮና ኡራ</para>
  <para style="q2" vid="PRO 17:18">አጩዋ ቃንፃናዉ ዋሰ ግዴስ።<verse eid="PRO 17:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>ኦሹ ዶስያ አስ ናጋራ ዶሴስ፤</para>
  <para style="q2" vid="PRO 17:19">ኡባ ዎደ ጬቀትያ አስ ባ ቦላ ዮ ፄጌስ።<verse eid="PRO 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 17:20"/>ዎበ ቆፍ ደእያ አስ ሎኦባ ደመና፤</para>
  <para style="q2" vid="PRO 17:20">ባ እንፃርሳን ጭምያ አስ መቶን ገሌስ።<verse eid="PRO 17:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>ኤያ ናአ የልዳ አው አዛኔስ፤</para>
  <para style="q2" vid="PRO 17:21">ኤያ ናአ አዋስ ኡፋይስ ዴና።<verse eid="PRO 17:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>ኡፋይትያ ዎዛን አሳስ ሎኦ ለ፤</para>
  <para style="q2" vid="PRO 17:22">ሽን መቅዳ ዎዛን አሳስ ዎልቃ ይሴስ።<verse eid="PRO 17:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>ኢታ አስ ፕርዳ ጌላያናዉ</para>
  <para style="q2" vid="PRO 17:23">ጌማን ዎፈ ኤኬስ።<verse eid="PRO 17:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>አኬካ አስ ጭንጫተ ባ ስንፈ ሃሰና፤</para>
  <para style="q2" vid="PRO 17:24">ሽን ኤያ አሳ አይፈይ ሳአ ጋፃ ዩዬስ።<verse eid="PRO 17:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>ኤያ ናእ ባ አዋ አዛንስ፤</para>
  <para style="q2" vid="PRO 17:25">ባ አይዉካ ጫምሴስ።<verse eid="PRO 17:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>ፅሎ አስ ሴሮይ በሰና፤</para>
  <para style="q2" vid="PRO 17:26">ሱረ አስ ሾጮይ ሎኦ ግደና።<verse eid="PRO 17:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>ጉ ቃላ ሃሳያ አስ ኤራንቾ፤</para>
  <para style="q2" vid="PRO 17:27">ዎፓ አያን ደእያ አስ አኬካንቾ።<verse eid="PRO 17:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>ኤያ አስ ስእ ጊኮ ጭንጫ ዳኔስ፤</para>
  <para style="q2" vid="PRO 17:28">ባ ዶና ዶዮና እፅኮ ኤራንቾ ዳኔስ።<verse eid="PRO 17:28"/></para>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 18:1"/>ሻሄተ ኮይያ አስ ባ አሙዋ ካሌስ፤</para>
  <para style="q2" vid="PRO 18:1">ሱረ ቆፋ ኡባ እፄስ።<verse eid="PRO 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>ኤያ አስ ባ ቆፋ ፃላላ ቆንጭሳናዉ ዶሴስ፤</para>
  <para style="q2" vid="PRO 18:2">ሀራ አሳፐ ኤራ ኤካናዉ ዶሰና።<verse eid="PRO 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>ኢታተ ያ ዎደ ካይ ዬስ፤</para>
  <para style="q2" vid="PRO 18:3">ካዉሻተ ያ ዎደ ዬል ዬስ።<verse eid="PRO 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>አሳ ዶናፐ ከያ ኦድ፥</para>
  <para style="q2" vid="PRO 18:4">ጪሞ ሃ መላ፤</para>
  <para style="q2" vid="PRO 18:4">ጭንጫተ ጎግያ ፑልቶ መላ።<verse eid="PRO 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>ናቅዳ ኡራ ማድድ፥ ፅሉዋ ፕርዳ</para>
  <para style="q2" vid="PRO 18:5">ጌላየይስ ሎኦ ግደና።<verse eid="PRO 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>ኤያ አሳ ኦድ ኦሹ ደንስ፤</para>
  <para style="q2" vid="PRO 18:6">እያ ዶናይ ዋ ፄጌስ።<verse eid="PRO 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>ኤያ አሳ ኦድ ባና ቆሄስ፤</para>
  <para style="q2" vid="PRO 18:7">እያ ኦዳይ ፅሄ ግድድ እያ ኦይኬስ።<verse eid="PRO 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>ዝግርስ ማልኦ ካ መላ፤</para>
  <para style="q2" vid="PRO 18:8">ኡፋይስሸ ዱገ ጋንጀ ጋኬስ።<verse eid="PRO 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>አዛላ አስ</para>
  <para style="q2" vid="PRO 18:9">ይስያ አሳፐ አይባካ ዱማተና።<verse eid="PRO 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>ጎዳ ሱንይ ምኖ ግምበ መላ፤</para>
  <para style="q2" vid="PRO 18:10">ፅሎ አስ ያ ዎፅድ ሳሮ አቴስ።<verse eid="PRO 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 18:11"/>ዱረ አሳታ ዱረተይ ግምበትዳ ካታማ መላ፤</para>
  <para style="q2" vid="PRO 18:11">ኤንታ ቆፋን ኤንታ ዱረተይ</para>
  <para style="q2" vid="PRO 18:11">ምኖ ድርሳዳ ኤንታ ናግያባ ዳኔስ።<verse eid="PRO 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>ኦቶሮይ ኩንደፈ ስንቴስ፤</para>
  <para style="q2" vid="PRO 18:12">አሽከተ ቦንቾ ኤሄስ።<verse eid="PRO 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>ስኦና ደእሸ ዛሮ እሞይ፥</para>
  <para style="q2" vid="PRO 18:13">ሄ ኡራስ ኤያተነ ዬላ።<verse eid="PRO 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>ዳና ግድ ቆፕኮ፥ እያ አያናይ ሀርገ ዳንዳእሴስ፤</para>
  <para style="q2" vid="PRO 18:14">ሽን ኡፋይስ ቃንፅኮ እያ ማደይ ባዋ።<verse eid="PRO 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>አኬካ አስ ኤራተ ኮዬስ፤</para>
  <para style="q2" vid="PRO 18:15">ጭንጫ አሳ ሀይ ጭንጫተ ስኤስ።<verse eid="PRO 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>እሞት እመይሳስ ኦገ ዶዬስ፤</para>
  <para style="q2" vid="PRO 18:16">ግታ አሳታራ ኤርሴስ።<verse eid="PRO 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>ዳይና ስንን ኮይሮ ሺቅድ ሞትያ ኡራይ፥</para>
  <para style="q2" vid="PRO 18:17">እያ ሞርከይ ይን፥ እያ ኦይቻና ጋካናዉ፥</para>
  <para style="q2" vid="PRO 18:17">ኡባ ዎደ ባና ፅሎ ግድ ቆፔስ።<verse eid="PRO 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>ሳማ የገ ፓላማ ተቄስ፤</para>
  <para style="q2" vid="PRO 18:18">ናምኡ ፓላምያ አሳታ ሻኬስ።<verse eid="PRO 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>ቆሄትዳ እሻይ ግምበትዳ</para>
  <para style="q2" vid="PRO 18:19">ካታማፐ አድ ምኔስ፤</para>
  <para style="q2" vid="PRO 18:19">እያ ፓላማይ ብራታ ጎርደ መላ።<verse eid="PRO 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>አስ ባ ዶና ኦዳን ባ ኡሎ ኩንስ፤</para>
  <para style="q2" vid="PRO 18:20">ባ እንፃርሳ አይፈን ካሌስ።<verse eid="PRO 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>ሀይቆይነ ደኦይ እንፃርሳና፤</para>
  <para style="q2" vid="PRO 18:21">ኔኒ ነ እንፃርሳ አይፍያ ማና።<verse eid="PRO 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>ማቾ ደምዳይ ሎኦባ ደምስ፤</para>
  <para style="q2" vid="PRO 18:22">እ፥ ጎዳፐ ቴማ ደሜስ።<verse eid="PRO 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>ማንቆ አስ አዳሽድ ኦደቴስ፤</para>
  <para style="q2" vid="PRO 18:23">ሽን ዱረ አስ ኦቶሮን ዛሬስ።<verse eid="PRO 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>ዳሮ ላገይ ደእያ አስ ባ ቦላ መቶ ኤሄስ፤</para>
  <para style="q2" vid="PRO 18:24">ሽን እሻፐ አድ ማታትያ ላገይ ደኤስ።<verse eid="PRO 18:24"/></para>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 19:1"/>ባ ዶናን ዎርዶትያ ኤያ አሳፐ</para>
  <para style="q2" vid="PRO 19:1">ባ ደኡዋን ቦረይ ባይና ማንቆይ ሎኦ።<verse eid="PRO 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>ኤር ባይና ዳፈተ ሎኦ ግደና፤</para>
  <para style="q2" vid="PRO 19:2">ኤሶ ዳሮይ ኦገ ባለስ።<verse eid="PRO 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>አስ ባ ኤያተን ባ ደኡዋ ኢሴስ፤</para>
  <para style="q2" vid="PRO 19:3">ያትድ ጎዳ ቦላ ይሎቴስ።<verse eid="PRO 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>ዱረተ ዳሮ ላገ ሺሼስ፤</para>
  <para style="q2" vid="PRO 19:4">ሽን ማንቆተ ደእያ ላገታ ዱስ።<verse eid="PRO 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>ዎርዶ ማርክ ሴረቶና አተና፤</para>
  <para style="q2" vid="PRO 19:5">ዎርዶ ኦደተይ ከስ ኤከና።<verse eid="PRO 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>ዳሮ አሳይ ሹማ ሶምኦ ኮዮሶና፤</para>
  <para style="q2" vid="PRO 19:6">እሞታ እምያ አሳራ አስ ኡባይ ዳቦቴስ።<verse eid="PRO 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>ማንቆ አስ ሀር አቶሽን እያ እሻት እፆሶና፤</para>
  <para style="q2" vid="PRO 19:7">እያ ላገት እያፐ ሃኮሶና፤</para>
  <para style="q2" vid="PRO 19:7">እ ኤንታ አዳሽንካ ኤንቲ እያ ኮዮኮና።<verse eid="PRO 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>ጭንጫተ ደምያ አስ ባ ሸምፑዋ ዶሴስ፤</para>
  <para style="q2" vid="PRO 19:8">ኤራተ ምንድ ኦይክያ ኡራስ እንጀቴስ።<verse eid="PRO 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>ዎርዶ ማርክ ሴረቶና አተና፤</para>
  <para style="q2" vid="PRO 19:9">ዎርዶ ኦደተይ ያና።<verse eid="PRO 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>ኤያ አሳስ እንጀ ደኦይ በሰና፤</para>
  <para style="q2" vid="PRO 19:10">አይለይ ሀላቃታ ሃሮይ ዳሮ ኢታ።<verse eid="PRO 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>ጭንጫተ አሰ ዳንዳአ ታማርሴስ፤</para>
  <para style="q2" vid="PRO 19:11">ቆሆ ካድ አ ቦንችሴስ።<verse eid="PRO 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>ካዋ ሀንቆይ ጋሞ ጉደ መላ፤</para>
  <para style="q2" vid="PRO 19:12">ሽን እያ ናሾይ ማታ አጭስያ አካ መላ።<verse eid="PRO 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>ኤያ ናእ ባ አዋ ይሴስ፤</para>
  <para style="q2" vid="PRO 19:13">ዶናማ ማቻ ፆክያ ኬ መላ።<verse eid="PRO 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>አስ ኬነ ሻሎ አዉፐ ላቴስ፤</para>
  <para style="q2" vid="PRO 19:14">ሽን አኬካ ማቾ ጎዳይ እሜስ።<verse eid="PRO 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>አዛላተ ስኮ ኤሄስ፤</para>
  <para style="q2" vid="PRO 19:15">ኦሶ ኦና አስ ኮሻቴስ።<verse eid="PRO 19:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>ኪታ ናግያ አስ ባ ሸምፑዋ ናጌስ፤</para>
  <para style="q2" vid="PRO 19:16">ሽን ቀል ግያ አስ ሀይቄስ።<verse eid="PRO 19:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>ማንቆስ ኬህያ አስ ጎዳስ ታልኤስ፤</para>
  <para style="q2" vid="PRO 19:17">ጎዳይ ሄ ሎኦ ኦሱዋ ግሾ ዎይቴስ።<verse eid="PRO 19:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>ስሞ ኡፋይስ ደእሽን ነ ናይታ ሴራ፤</para>
  <para style="q2" vid="PRO 19:18">ሴሮና እፅኮ፥ ነ ኤንታ ይሳሳ።<verse eid="PRO 19:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>ኤለ ሸነትያ አስ ባ ጋትያ ኤካናዉ በሴስ፤</para>
  <para style="q2" vid="PRO 19:19">ኔኒ እያ እስ ቶሆ አሽያባ ግድኮ፥</para>
  <para style="q2" vid="PRO 19:19">ሀራ ዎደካ ነ እያ ሄሳዳ አሻናይስ አተና።<verse eid="PRO 19:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>ዞረ ስአ፤ ታማራናዉ ኮያ፤</para>
  <para style="q2" vid="PRO 19:20">ኔኒ ዉርሰ ጋካናዉ ጭንጫ ግዳና።<verse eid="PRO 19:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>አስ ዳሮባ ሀልቼስ፤</para>
  <para style="q2" vid="PRO 19:21">ሽን ጎዳይ ግዳባይ ፖለቴስ።<verse eid="PRO 19:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>አሳፐ ኮየተይ አማነተ፤</para>
  <para style="q2" vid="PRO 19:22">ዎርዶ ግዳናፐ ማንቆ ግደይስ ሎኦ።<verse eid="PRO 19:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>ጎዳስ ያሽ ደኦኮ ካለስ፤</para>
  <para style="q2" vid="PRO 19:23">እያ ያይያ አስ ካልድ ደኤስ፤ ኢት እያ ቦቸና።<verse eid="PRO 19:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>እስ እስ አስ ዳሮ አዛላ፤</para>
  <para style="q2" vid="PRO 19:24">ሀር አቶሽን ዎፀን ቱሽክዳ</para>
  <para style="q2" vid="PRO 19:24">ኡይ ፑደ ባራናዉ ዋየቴስ።<verse eid="PRO 19:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>ኔኒ ቀልቅስያ አስ ሾጭኮ፥</para>
  <para style="q2" vid="PRO 19:25">አኬክ ፓጭዳይስ ጭንጫተ ታማራና፤</para>
  <para style="q2" vid="PRO 19:25">አኬካ አስ ነ ሀንቀትኮ፥ እ ኤራተ ደማና።<verse eid="PRO 19:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>ባ አዋ ቦንቅያ ናአይ፥</para>
  <para style="q2" vid="PRO 19:26">ባ አይዉ የደያ ናአይ፥</para>
  <para style="q2" vid="PRO 19:26">ዬላነ ካዉሻተ ኤህያ ናአ።<verse eid="PRO 19:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>ታ ናአዉ፥ ነ ዞረ ስኦና እፅኮ፥</para>
  <para style="q2" vid="PRO 19:27">ኤራ ኦግያፐ ሃካሳ።<verse eid="PRO 19:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>ዎርዶ ማርክ ሱረ ፕርዳ ቦላ ቀልቅሴስ፤</para>
  <para style="q2" vid="PRO 19:28">ኢታ አሳ ዶን ኢታተ ምቴስ።<verse eid="PRO 19:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>ቀልቅስያ አሳስ ፕርዳ</para>
  <para style="q2" vid="PRO 19:29">ኤያታስ ዋ ኮሼስ።<verse eid="PRO 19:29"/></para>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 20:1"/>ማያ ኡሽ ኤያነ ኦሻንቾ ኦስ፤</para>
  <para style="q2" vid="PRO 20:1">ኡሻን ባለትያ አስ ጭንጫ ግዳናዉ ዳንዳኤና።<verse eid="PRO 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 20:2"/>ካዎ ሀንቆይ ጋሞ ጉደ መላ፤</para>
  <para style="q2" vid="PRO 20:2">እያ ይሎይያ አስ ባ ሸምፑዋ ቦላ ፕርዴስ።<verse eid="PRO 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>ፓላማፐ ሃከይስ ቦንቾ፤</para>
  <para style="q2" vid="PRO 20:3">ሽን ኤያ አስ ኦየታናዉ ኤለሴስ።<verse eid="PRO 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>አዛላ ጎሻንቾይ ዎደ ናግድ ጎየና፤</para>
  <para style="q2" vid="PRO 20:4">ካ ጫክያ ዎደ እ ዎሳናዉ ኮዬስ፤</para>
  <para style="q2" vid="PRO 20:4">ሽን አይባካ ደመና።<verse eid="PRO 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 20:5"/>አሳ ዎዛና ሀልቾይ ጪሞ ሃ መላ፤</para>
  <para style="q2" vid="PRO 20:5">ሽን ዎዛናማ አስ ዱቅድ ከሴስ።<verse eid="PRO 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>ዳሮ አሳት ባንታ ሎኦተ ኦዶሶና፤</para>
  <para style="q2" vid="PRO 20:6">ሽን ቱማ አማነትያ አስ ደማናይ ኦኔ?<verse eid="PRO 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>ፅሎ አስ ቦረይ ባይና ደኦ ደኤስ፤</para>
  <para style="q2" vid="PRO 20:7">እያ ካልያ እያ ናይት አንጀትዳይሳታ።<verse eid="PRO 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>ካዎይ ፕርዳናዉ ባ አራታን ኡትያ ዎደ፥</para>
  <para style="q2" vid="PRO 20:8">ኢታ ኡባ ባ አይፈን ሀርቅድ ከሴስ።<verse eid="PRO 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>“ታ ዎዛናይ ጌሽ፤ ታናን ናጋር ባዋ”</para>
  <para style="q2" vid="PRO 20:9">ጋናዉ ዳንዳእያ አስ ዳነሻ?<verse eid="PRO 20:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>ጎዳይ ዎርዶ ምዛነነ</para>
  <para style="q2" vid="PRO 20:10">ግና ግዶና ማካ ሚሸን ጎኤተይሳታ እፄስ።<verse eid="PRO 20:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>ናእ ጌሽነ ሱረ ግደይስ</para>
  <para style="q2" vid="PRO 20:11">እ ኦያ ኦሶን ኤረቴስ።<verse eid="PRO 20:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>ስእያ ሀይነ ፄልያ አይፈ፥</para>
  <para style="q2" vid="PRO 20:12">ጎዳይ መስ።<verse eid="PRO 20:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>ስኮን ነ ዎደ ዉርስኮ ነ ማንቃና፤</para>
  <para style="q2" vid="PRO 20:13">ምናዳ ኦኮ ነ ካ ካላና።<verse eid="PRO 20:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>ሻምያ አስ፥ “ቆሄስ! ቆሄስ!” ያጌስ፤</para>
  <para style="q2" vid="PRO 20:14">ሽን ብዳፐ ጉየ፥ “ገላን ሻማስ” ያግድ ጬቀቴስ።<verse eid="PRO 20:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>ዎርቀይ ኩምስ፤ አልኦ ሹችካ በንቴስ፤</para>
  <para style="q2" vid="PRO 20:15">ሽን ኤር ኩምዳ እንፃርስ ኡባፈ አዳ አሌቆ።<verse eid="PRO 20:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>ኤሮና አሳስ ዋሰ ገልያ ኡራ ማኡዋ ቃር ኤክተ፤</para>
  <para style="q2" vid="PRO 20:16">እማ አሳስ ዋሰ ገልያ ኡራ ማኦ ኦይክተ።<verse eid="PRO 20:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>ዎርዶን ደምዳ ካ ማልኤስ፤</para>
  <para style="q2" vid="PRO 20:17">ሽን አቅድ ፔእሸ ዶናን አጨዳ ሀኔስ።<verse eid="PRO 20:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>ዞረ ኤካዳ ነ ቆፋ ቃቻ፤</para>
  <para style="q2" vid="PRO 20:18">ዞረ ኤኮና ደአሸ ኦላ ቦፓ።<verse eid="PRO 20:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>ዝግርያ አስ ፁራ ገንና፤</para>
  <para style="q2" vid="PRO 20:19">ሄሳ ግሾ ጮ ሃሳያ አሳፐ ሃካ።<verse eid="PRO 20:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>ባ አዋ ዎይኮ ባ አይዉ ባድያ አሳ፥</para>
  <para style="q2" vid="PRO 20:20">ደኦ ፆምፐይ ሳካና ማን ቶአና።<verse eid="PRO 20:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>ኮይሮራ ኤሶን ሺቅዳ ሻሎይ</para>
  <para style="q2" vid="PRO 20:21">ዉርሰን አንጀተና።<verse eid="PRO 20:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>ነና ቆህዳ ኡራ ቆሀዳ ዛራና ጎፓ፤</para>
  <para style="q2" vid="PRO 20:22">ጎዳን አማነታ፤ እ ነና አሻና።<verse eid="PRO 20:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>ጎዳይ ናምኡ ቆሞ ምዛነ እፄስ፤</para>
  <para style="q2" vid="PRO 20:23">ዎርዶ ምዛነይ እያ ኡፋይሰና።<verse eid="PRO 20:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>አሳይ ባና ኦግያ ጎዳይ ካለስ፤</para>
  <para style="q2" vid="PRO 20:24">ያትን፥ አስ ባ ደኦን ባና ኦግያ</para>
  <para style="q2" vid="PRO 20:24">ዋትድ አኬካናዉ ዳንዳኢ?<verse eid="PRO 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 20:25"/>ኤሶን፥ “ሀይሳ ታኒ ፆሳስ እማስ” ጉስነ</para>
  <para style="q2" vid="PRO 20:25">ጉየፐ ቂሮተ አሳስ ፅሄ።<verse eid="PRO 20:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>ጭንጫ ካዎይ ጌላታ ሻክድ ኤሬስ፤</para>
  <para style="q2" vid="PRO 20:26">እ ኤንታ ቃቶና ሴሬስ።<verse eid="PRO 20:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>አሳ አያን ጎዳስ ፆምፐ፤</para>
  <para style="q2" vid="PRO 20:27">እያ ጋ አሳተ ኡባ ፕልግድ ፄሌስ።<verse eid="PRO 20:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>ሲቆይነ አማነተ ካዋ ናጎሶና፤</para>
  <para style="q2" vid="PRO 20:28">እያ አራታይ ቱማ ፕርዳን ምኔስ።<verse eid="PRO 20:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>ያላጋታ ቦንቾይ ኤንታ ዎልቃ፤</para>
  <para style="q2" vid="PRO 20:29">ጭማታ ቦንቾይ ኤንታ ፑሉን።<verse eid="PRO 20:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>ምኖ ሴር ኢታተ ሾዴስ፤</para>
  <para style="q2" vid="PRO 20:30">ዋይ ኢታ ዎዛና ላሜስ።<verse eid="PRO 20:30"/></para>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 21:1"/>ካዎ ዎዛን ጎዳ ኩሸና፤</para>
  <para style="q2" vid="PRO 21:1">እያ ዎዛና ዋ ሃዳ</para>
  <para style="q2" vid="PRO 21:1">ባ ኮይዳ ሶ ዛሬስ።<verse eid="PRO 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>አስ ኦያባ ኡባይ እያዉ ልከ ዳኔስ፤</para>
  <para style="q2" vid="PRO 21:2">ሽን ጎዳይ እያ ዎዛና ቆፋ ፓጬስ።<verse eid="PRO 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>ያርሾ ያርሻናፐ አድ፥</para>
  <para style="q2" vid="PRO 21:3">ፅሎነ ሱረ ኦይሳ ጎዳይ ዶሴስ።<verse eid="PRO 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>ኢታት ኦቶሮንነ ጬቀተን ኤረቶሶና፤</para>
  <para style="q2" vid="PRO 21:4">ሄስ ቃስ ናጋራ።<verse eid="PRO 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>ምኖ ኦያ አሳ ሀልቾይ ዱረዬስ፤</para>
  <para style="q2" vid="PRO 21:5">ሽን ኤሶትያ ኡባይ ማንቄስ።<verse eid="PRO 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>ዎርዶን ዳጋይዳ ሻሎይ ፐንቶዳ ዬስ፤</para>
  <para style="q2" vid="PRO 21:6">ሄሳ ኮየይሳት ሀይቆ ኮዮሶና።<verse eid="PRO 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>ኢታት ሱረባ ኦናዉ ኮዮና ግሾ፥</para>
  <para style="q2" vid="PRO 21:7">ኤንታ ጌላ ኦሶይ ኤንታ ኤክድ ቤስ።<verse eid="PRO 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>ናጋራንቾት ጌላ ኦገን ሄመቶሶና፤</para>
  <para style="q2" vid="PRO 21:8">ሽን ጌሻት ሱረባ ኦሶና።<verse eid="PRO 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>ዶናትያ ማችራ እስ ኬን ዳናፐ</para>
  <para style="q2" vid="PRO 21:9">ካረ ዳርማቻን ዱስ ሎኦ።<verse eid="PRO 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>ኢታት ኢታባ ኦናዉ አሞቶሶና፤</para>
  <para style="q2" vid="PRO 21:10">ባንታ ሾሮታስ ቃቶኮና።<verse eid="PRO 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>ቀልቅስያ አስ ሴረትያ ዎደ</para>
  <para style="q2" vid="PRO 21:11">ዎዛን ባይና ኡራይ ጭንጫተ ታማሬስ፤</para>
  <para style="q2" vid="PRO 21:11">ዎዛናማ ኡራይ ኤራ ደሜስ።<verse eid="PRO 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>ፅሎ ፆሳይ ኢታታ ሶን ኦሰትያባ ኡባ በኤስ፤</para>
  <para style="q2" vid="PRO 21:12">ኤንታ ሽር የግድ ይሴስ።<verse eid="PRO 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>ማንቆታ ዋሱዋ ስአናፐ ግድ፥</para>
  <para style="q2" vid="PRO 21:13">ባ ሀይ ቱጭያ ኡራይ፥ እካ ዋሳና፤</para>
  <para style="q2" vid="PRO 21:13">እ ዋስን አልያ አስ ያና።<verse eid="PRO 21:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>ጌማን እምያ እሞይ ሀንቆ ዶሽሴስ፤</para>
  <para style="q2" vid="PRO 21:14">ቆሳን እምዳ ዎፈይ ሀንቆ እርፅሴስ።<verse eid="PRO 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>ሱረ ፕርድ ፕርደትያ ዎደ፥</para>
  <para style="q2" vid="PRO 21:15">ፅሎት ኡፋይቶሶና፤</para>
  <para style="q2" vid="PRO 21:15">ሽን ኢታ ኦይሳታ ዳጋንስ።<verse eid="PRO 21:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>አኬካ ኦግያ ሃክያ ኡራ</para>
  <para style="q2" vid="PRO 21:16">ሀይቆይ ናጌስ።<verse eid="PRO 21:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>እንጀትን ዳና ግያ ኡራይ ማንቄስ፤</para>
  <para style="q2" vid="PRO 21:17">ዎይነነ ዛይተ ዶስያ ኡራይ ዱረተና።<verse eid="PRO 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>ፆሳ አሳታ አሻናዉ ኢታ አሳት ሴረቶሶና፤</para>
  <para style="q2" vid="PRO 21:18">አማነቶና አሳት ሱረ አሳታ ግሾ ሴረቶሶና።<verse eid="PRO 21:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 21:19"/>ዶናትያነ ይሎትያ ማችራ ዳናፐ</para>
  <para style="q2" vid="PRO 21:19">ባዞን ደኦይ ሎኦ።<verse eid="PRO 21:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>ዎዛናማ ኡራ ሶን ማልኦ ቁምነ ኦይስ ምንጀቴስ፤</para>
  <para style="q2" vid="PRO 21:20">ሽን ኤያ አስ ደእያባ ኡባ ምድጌስ።<verse eid="PRO 21:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>ፅሎተነ ሲቆ ኮይያ ኡራ ላይይ አዱቄስ፤</para>
  <para style="q2" vid="PRO 21:21">ሄ ኡራይ ፅሎተነ ቦንቾ ደሜስ።<verse eid="PRO 21:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>ዎዛናማ አስ ዎልቃማ ኦላንቾታ ካታማ ኦልድ ኦይኬስ፤</para>
  <para style="q2" vid="PRO 21:22">ኤንቲ አማነትያ ምኖ ሚፃ ላሌስ።<verse eid="PRO 21:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>ባ ዶናነ ባ እንፃርሳ</para>
  <para style="q2" vid="PRO 21:23">ናግያ አስ ባና መቶፐ ናጌስ።<verse eid="PRO 21:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>ኦቶረይነ ጬቀተይ ቀልቅስያ አስ፤</para>
  <para style="q2" vid="PRO 21:24">እ ኦቶራንቾ ግድዳ ግሾ አሳስ ቆፐና።<verse eid="PRO 21:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>ኦናዉ ኮዮና ግሾ</para>
  <para style="q2" vid="PRO 21:25">አዛላ አሞይ ዎስ።<verse eid="PRO 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>አዛላ አስ ኡባ ዎደ ዳሮባ ደማናዉ አሞቴስ፤</para>
  <para style="q2" vid="PRO 21:26">ሽን ፅሎይ ባዉ አሾና እሜስ።<verse eid="PRO 21:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>ጎዳይ ኢታታ ያርሹዋ እፄስ፤</para>
  <para style="q2" vid="PRO 21:27">ኤንቲ እያዉ ኢታ ቆፋን ሺሽያ ያርሹዋ አድ እፄስ።<verse eid="PRO 21:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>ዎርዶ ማርክ ያና፤</para>
  <para style="q2" vid="PRO 21:28">ሽን ቱማ ማርክ ኤቅድ ዳና።<verse eid="PRO 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>ኢታ አስ በሶና ፃላ ፃሌስ፤</para>
  <para style="q2" vid="PRO 21:29">ሽን ሱረ አስ ዩሽ ቆፔስ።<verse eid="PRO 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>አስ ባ ጭንጫተን፥ አኬካንነ ዞረን</para>
  <para style="q2" vid="PRO 21:30">ጎዳራ ኤቀታናዉ ዳንዳኤና።<verse eid="PRO 21:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>ኦላስ ፓራ ኮራናዉ ዳንዳኤቴስ፤</para>
  <para style="q2" vid="PRO 21:31">ሽን ፆኖይ ጎዳባ።<verse eid="PRO 21:31"/></para>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 22:1"/>ሎኦ ሱን ዳሮ ዱረተፈ አስ፤</para>
  <para style="q2" vid="PRO 22:1">ቦንቾይ ብራፐነ ዎርቃፈ አስ።<verse eid="PRO 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>ዱረነ ማንቆ ጎዳይ መስ፤</para>
  <para style="q2" vid="PRO 22:2">ሄሳን ኤንቲ ናምአይ እስኖ።<verse eid="PRO 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>ጭንጫ አስ ኢታ በእድ ቆሰትድ አቴስ፤</para>
  <para style="q2" vid="PRO 22:3">ሽን አኬክ ባይና አስ መቶን ገልድ ቆሄቴስ።<verse eid="PRO 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>አሽከተነ ጎዳ ያሽ፥</para>
  <para style="q2" vid="PRO 22:4">ዱረተ፥ ቦንቾነ ደኦ እሜስ።<verse eid="PRO 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>ኢታታ ኦገን አጉንነ ፅሄይ ደኤስ፤</para>
  <para style="q2" vid="PRO 22:5">ሽን ባና ናግያ አስ ኤንታፈ ሃኬስ።<verse eid="PRO 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>ናእ ዋንድ ዳናዉ በሲያኮ ታማርሳ፤</para>
  <para style="q2" vid="PRO 22:6">እ ጭምያ ዎደካ እያፐ ሃከና።<verse eid="PRO 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>ዱረይ ማንቁዋ ሃሬስ፤</para>
  <para style="q2" vid="PRO 22:7">ታልኤ ኤክዳይ ታልኤ እምዳይሳስ አይለ ግዴስ።<verse eid="PRO 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>ናጋራ ዘርያ ኡራይ ዋየ ጫኬስ፤</para>
  <para style="q2" vid="PRO 22:8">እያ ሀንቆ ፃምአይ መቃና።<verse eid="PRO 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>ባ ካ ማንቆታስ ሻክያ ግሾ</para>
  <para style="q2" vid="PRO 22:9">ኬሀ አስ አንጀታና።<verse eid="PRO 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>ቀልቅስያ አስ ድግኮ፥</para>
  <para style="q2" vid="PRO 22:10">ፓላም፥ ኦሽነ ጫሽ አታና።<verse eid="PRO 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>ዎዛን ጌሽ ግድዳ አስነ</para>
  <para style="q2" vid="PRO 22:11">ሎኦ ኦዳ ዶስያ አስ ካዎራ ዳቦቴስ።<verse eid="PRO 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>ጎዳ አይፈይ ኤራተ ናጌስ፤</para>
  <para style="q2" vid="PRO 22:12">ሽን ዎርዳንቾታ ቃላ ሽር የጌስ።<verse eid="PRO 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>አዛላ አስ፥ “ካረን ጋሞይ ደኤስ፤</para>
  <para style="q2" vid="PRO 22:13">ታና ኦገን ማና” ያጌስ።<verse eid="PRO 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>ላይማ ማጫሳ ዶን ዎልቃማ ኦላ መላ፤</para>
  <para style="q2" vid="PRO 22:14">ጎዳይ ሀንቀትዳይሳት እያን ኩንዶሶና።<verse eid="PRO 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>ኤያተ ናአ ዎዛናን ደኤስ፤</para>
  <para style="q2" vid="PRO 22:15">ሽን ፕርጮይ እያፐ ሃሴስ።<verse eid="PRO 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>ሻሎ ሺሻናዉ ማንቁዋ ናቀይነ</para>
  <para style="q2" vid="PRO 22:16">ዱረ አሳስ እሞታ እምያ ናምአይ ማንቃና።<verse eid="PRO 22:16"/></para>
  <para style="s1">ሀስታሙ ጭንጫ ዞረታ</para>
  <para style="r">(<ref loc="PRO 22:17-24:22">22:17—24:22</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 22:17"/>ነ ሀይ ዛራዳ ጭንጫታ ቃላ ስአ፤</para>
  <para style="q2" vid="PRO 22:17">ነ ዎዛና ታ ትምርትያኮ ዛራ።<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>ኤንታ ነ ዎዛናን ዎኮነ</para>
  <para style="q2" vid="PRO 22:18">ነ ዶናን ኤንታ ሃሳይኮ፥ ነ ኡፋይታና።<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>ነ አማኖይ ጎዳን ግዳና መላ፥</para>
  <para style="q2" vid="PRO 22:19">ታኒ ነና ሀች ታማርሳይስ።<verse eid="PRO 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20"/>ታኒ ነዉ ዞረነ ኤራተ ኩምዳ</para>
  <para style="q2" vid="PRO 22:20">ሀስታሙ ሌምሶታ ፃፋስ።<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>ነና ኪትዳይሳስ ልከ ዛሮ ዛራና መላ፥</para>
  <para style="q2" vid="PRO 22:21">ታኒ ነና ቱማተ ታማርሳስ።<verse eid="PRO 22:21"/></para>
  <para style="s2">1</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>ማንቆታስ አይብካ ባይና ግሾ፥ ኤንታ ቦንቆፋ፤</para>
  <para style="q2" vid="PRO 22:22">ፕርዳን ኤንታ ማታ ይሶፋ።<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>ጎዳይ ኤንታ ግሾ ሞተታና፤</para>
  <para style="q2" vid="PRO 22:23">ኤንታ ቦንቅዳይሳታ እ ቦንቃና።<verse eid="PRO 22:23"/></para>
  <para style="s2">2</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>ይሎትያ ኡራራ ላገቶፓ፤</para>
  <para style="q2" vid="PRO 22:24">ኤለ ሸነትያ ኡራራ ሄመቶፋ።<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>ኔኒ እያ ይሉዋራ ሜዘትኮ፥</para>
  <para style="q2" vid="PRO 22:25">ጉየፐ አጋናዉ ዳንዳአካ።<verse eid="PRO 22:25"/></para>
  <para style="s2">3</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>አሳ አጮ ታ ቃንፃና ጋዳ</para>
  <para style="q2" vid="PRO 22:26">ዋሰ ግዶፓ።<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>ነ ቃንፅያባ ይኮ፥</para>
  <para style="q2" vid="PRO 22:27">ነ ዝንእያ ሂፃይ አቶና፥</para>
  <para style="q2" vid="PRO 22:27">ነዉ ደእያባ ኡባይ ኤከታና።<verse eid="PRO 22:27"/></para>
  <para style="s2">4</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>ነ ማይዛት ቶክዳ</para>
  <para style="q2" vid="PRO 22:28">በን ዛዋ ሾዶፋ።<verse eid="PRO 22:28"/></para>
  <para style="s2">5</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>ባ ኦሱዋን ሎህዳ አስ በአዲ?</para>
  <para style="q2" vid="PRO 22:29">እ ጮ አሳታስ ግዶናሽን ካዎታስ ኦስ።<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="s2">6</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 23:1"/>ሀላቃራ ካ ማናዉ ኡትያ ዎደ፥</para>
  <para style="q2" vid="PRO 23:1">ኔራ ደኤይሳ አኬካ።<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>ኔኒ ዳሮ ያራምባ አስ ግድኮ ናገታ።<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>እ ነና ፓጫናዉ ዳንዳእያ ግሾ፥</para>
  <para style="q2" vid="PRO 23:3">ማልኦ ካስ ያረቶፓ።<verse eid="PRO 23:3"/></para>
  <para style="s2">7</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>ዱረታና ጋዳ ዳቡሮፓ፤</para>
  <para style="q2" vid="PRO 23:4">ነ ቆፋ ሃራናዉ ጭንጫ ግዳ።<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>ሄሳ መላ ዱረተ ነ ፄልሽን ያና፤</para>
  <para style="q2" vid="PRO 23:5">ቀፈ ከስድ አርጋንዳ ሳሎ ፓላና።<verse eid="PRO 23:5"/></para>
  <para style="s2">8</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>ኡዘ አሳ ካ ሞፓ፤</para>
  <para style="q2" vid="PRO 23:6">እያ ማልኦ ካይ ነና አሞዮፖ።<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>ቆፐ ቆሞን “ማ፤ ኡያ” ጌስ፤</para>
  <para style="q2" vid="PRO 23:7">ሽን እያ ዎዛናይ ኔራ ግደና።<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>ነ ምዳ ጉ ካካ ጮያና፤</para>
  <para style="q2" vid="PRO 23:8">ነ ጋላታይ መላ ግዳና።<verse eid="PRO 23:8"/></para>
  <para style="s2">9</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>ነ ጭንጫተ ሃሳያ ካያ ግሾ፥</para>
  <para style="q2" vid="PRO 23:9">ኤያ አሳስ ፓፃባ ሃሳዮፓ።<verse eid="PRO 23:9"/></para>
  <para style="s2">10</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>በን ዛዋ ሾዶፋ፤</para>
  <para style="q2" vid="PRO 23:10">ይኦ ናይታ ዛዋ ሱጎፓ።<verse eid="PRO 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11"/>ኤንታ አሽያ ጎዳይ ምኖ ግድያ ግሾ፤</para>
  <para style="q2" vid="PRO 23:11">እ፥ ኤንታ ግሾ ኔራ ሞተታና።<verse eid="PRO 23:11"/></para>
  <para style="s2">11</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>ነ ዎዛና ዞረ ቃላኮ፥</para>
  <para style="q2" vid="PRO 23:12">ነ ሀይ ትምርተኮ ዛራ።<verse eid="PRO 23:12"/></para>
  <para style="s2">12</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>ናአ ሴሮና አጎፋ፤</para>
  <para style="q2" vid="PRO 23:13">ነ እያ ፕርጮን ሾጭኮ እ ሀይቀና።<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>ነ እያ ፕርጮን ሾጭኮ፥</para>
  <para style="q2" vid="PRO 23:14">እያ ሸምፑዋ ሀይቆፐ አሻሳ።<verse eid="PRO 23:14"/></para>
  <para style="s2">13</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>ታ ናአዉ፥ ነ ዎዛናይ ጭንጫ ግድኮ፥</para>
  <para style="q2" vid="PRO 23:15">ታ ዎዛናይ ኡፋይታና።<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>ነ እንፃርሳይ ሱረባ ሃሳያ ዎደ፥</para>
  <para style="q2" vid="PRO 23:16">ታ ጋ አሳተይ ኡፋይቴስ።<verse eid="PRO 23:16"/></para>
  <para style="s2">14</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>ናጋራንቾታ ቃናቶፓ፤</para>
  <para style="q2" vid="PRO 23:17">ሽን ኡባ ዎደ ጎዳ ያያ።<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>ያትኮ ነዉ ስን ደኦይ ሱራና፤</para>
  <para style="q2" vid="PRO 23:18">ነ ኡፋይሳይ የና።<verse eid="PRO 23:18"/></para>
  <para style="s2">15</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>ታ ናአዉ፥ ስአ፤ ጭንጫ ግዳ፤</para>
  <para style="q2" vid="PRO 23:19">ነ ዎዛና ሱረ ኦግያን ናጋ።<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>ዳሮ ዎይነ ኡሹ ኡየይሳታራነ</para>
  <para style="q2" vid="PRO 23:20">አሾ ማናዉ ያረተይሳታራ ሄመቶፋ።<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>ማተይሳትነ ያራምባት ማንቃና፤</para>
  <para style="q2" vid="PRO 23:21">ስኮ ዳሮይ ጩርቃ ማይዜስ።<verse eid="PRO 23:21"/></para>
  <para style="s2">16</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>ነና የልዳ ነ አዋይ ኦድያባ ስአ፤</para>
  <para style="q2" vid="PRO 23:22">ነ አይያ ጭምዳ ዎደ ካፓ።<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>ቱማ፥ ጭንጫ፥ ሴራነ</para>
  <para style="q2" vid="PRO 23:23">አኬካ ሻማፈ አትሽን፥ ባይዞፓ።<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>ፅሎ ናአ አው ዳሮ ኡፋይቴስ፤</para>
  <para style="q2" vid="PRO 23:24">ዎዛናማ ናአ የልዳ አስ እያን ጬቀቴስ።<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>ነ አዋይነ ነ አይያ ነናን ኡፋይቶ፤</para>
  <para style="q2" vid="PRO 23:25">ነና የልዳራ ሀሹ ጎ።<verse eid="PRO 23:25"/></para>
  <para style="s2">17</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>ታ ናአዉ፥ ነ ዎዛና ታዉ እማ፤</para>
  <para style="q2" vid="PRO 23:26">ነ አይፈት ታ ኦግያ ካሎ።<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>ላይማ ማጫስ ጪሞ ሃ መላ፤</para>
  <para style="q2" vid="PRO 23:27">ላገ ማጫስ ፁን ኦላ መላ።<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>እያ ፓኖዳ ዙጋዳ ናጋዉሱ፤</para>
  <para style="q2" vid="PRO 23:28">አማነቶና አደታ ዳርሳዉሱ።<verse eid="PRO 23:28"/></para>
  <para style="s2">18</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>ዋሶይ ኦሴ? አዛኖይ ኦሴ?</para>
  <para style="q2" vid="PRO 23:29">ኦሽ ኦሴ? ዙዙን ኦሴ?</para>
  <para style="q1" vid="PRO 23:29">ጋሶይ ባይና ማዱንፀ ኦሴ?</para>
  <para style="q2" vid="PRO 23:29">አይፈ ዞኦይ ኦሴ?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>ዎይነ ኡሹ ኡይሸ ዎደ ኦንገይሳታሳ ግደኔ?</para>
  <para style="q2" vid="PRO 23:30">ዋላሄትዳ ዎይነ ኡሻ</para>
  <para style="q2" vid="PRO 23:30">ጋንፅድ በኤይሳታሳ ግደኔ?<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>ዎይነ ኡሽ ዞእዳ ዎደ፥</para>
  <para style="q2" vid="PRO 23:31">እያ ማላይ ብርለ ግዶን ጶልያ ዎደ፥</para>
  <para style="q2" vid="PRO 23:31">ኡይን ማልእሸ ገልያ ዎደ እያ ፄሎፋ።<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>ዉርሰን ሾሻዳ እ ዱኬስ፤</para>
  <para style="q2" vid="PRO 23:32">ኢታ ሾሻዳ ባ ማርዝያ ፑኬስ።<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>ነ አይፈይ በእ ኤሮናባ በአና፤</para>
  <para style="q2" vid="PRO 23:33">ነ ዎዛናይ ሱረ ቆፓናዉ ዳንዳኤና።<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>ኔኒ አባ ግዶን ዝንእዳ፥</para>
  <para style="q2" vid="PRO 23:34">ማርካብያ ቱሳ ቦላ ካትዳ አሰ ዳናሳ።<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>ኔኒ፥ “ኤንቲ ታና ደችዶሶና፤</para>
  <para style="q2" vid="PRO 23:35">ሽን ታ ቆሄታብከ።</para>
  <para style="q1" vid="PRO 23:35">ኤንቲ ታና ዋዶሶና፤</para>
  <para style="q2" vid="PRO 23:35">ሽን ታዉ ኤረትቤና።</para>
  <para style="q1" vid="PRO 23:35">ሀራ ኡሹ ኡያናዉ</para>
  <para style="q2" vid="PRO 23:35">ታኒ አዉደ ደንዳኔ?” ያጋና።<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="s2">19</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>ታ ናአዉ፥ ኢታ አሳታ ቃናቶፓ፤</para>
  <para style="q2" vid="PRO 24:1">ኤንታራ ላገታናዉ አሞቶፋ።<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>ኤንቲ ኡባ ዎደ ኢታባ ማቀቶሶና፤</para>
  <para style="q2" vid="PRO 24:2">ባንታ እንፃርሳን ገነ ሃሳዮሶና።<verse eid="PRO 24:2"/></para>
  <para style="s2">20</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>ኬ ጭንጫተን ኬፀቴስ፤</para>
  <para style="q2" vid="PRO 24:3">አኬካን ምኔስ።<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>ኤር ደእኮ፥ ቆልእ</para>
  <para style="q2" vid="PRO 24:4">አልኦባንነ ሎኦባን ኩሜስ።<verse eid="PRO 24:4"/></para>
  <para style="s2">21</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>ጭንጫ አስ ዎልቃማ አሳፐ አስ፤</para>
  <para style="q2" vid="PRO 24:5">ኤራ አስ ምኖ አሳፐ ሎኦ።<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>ኦላስ ከያናፐ ኮይሮ ሀልቻናዉ ኮሼስ፤</para>
  <para style="q2" vid="PRO 24:6">ዳሮ ዞረ ዞርያ አሳታን ፆኖይ በንቴስ።<verse eid="PRO 24:6"/></para>
  <para style="s2">22</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>ኤያ አስ ጭንጫተ አኬካናዉ ዳንዳኤና፤</para>
  <para style="q2" vid="PRO 24:7">ሺቆ በሳን እ ኦድያባይ አይብካ ባዋ።<verse eid="PRO 24:7"/></para>
  <para style="s2">23</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>ኢታ ኦናዉ ቆፕያ አስ</para>
  <para style="q2" vid="PRO 24:8">ገነ አስ ጌተቴስ።<verse eid="PRO 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>ኤያ አሳ ቆፍ ናጋራ፤</para>
  <para style="q2" vid="PRO 24:9">ቀልቅስያ አስ እፀቴስ።<verse eid="PRO 24:9"/></para>
  <para style="s2">24</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>መቶ ዎደ ነ ዶልእኮ፥</para>
  <para style="q2" vid="PRO 24:10">ነ ዎልቃይ ጉ።<verse eid="PRO 24:10"/></para>
  <para style="s2">25</para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>ፕርድ ባይና ሀይቆስ በይሳታ አሻ፤</para>
  <para style="q2" vid="PRO 24:11">ሹከታናዉ ብያ ዎደ ስእ ጋዳ ፄሎፋ።<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>ነ፥ “ታ ሄሳ ኤርከ” ግኮ፥</para>
  <para style="q2" vid="PRO 24:12">ዎዛና ኤርያ እ፥ በኤኔ?</para>
  <para style="q1" vid="PRO 24:12">ነ ደኡዋ ናገይስ ኤረኔ?</para>
  <para style="q2" vid="PRO 24:12">አሳ ኡባስ እያ ኦሱዋዳ ኦሱዋዳ ዛረኔ?<verse eid="PRO 24:12"/></para>
  <para style="s2">26</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>ታ ናአዉ፥ ኤስ ሎኦ ግድያ ግሾ፥</para>
  <para style="q2" vid="PRO 24:13">ኤስ ማ፤ እልሎ ኤስ ማልኤስ።<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>ጭንጫተካ ሄሳዳ</para>
  <para style="q2" vid="PRO 24:14">ነ ሸምፑዋስ ማልኦ ግደይሳ ኤራ።</para>
  <para style="q1" vid="PRO 24:14">ኔኒ እያ ደምያባ ግድኮ፥</para>
  <para style="q2" vid="PRO 24:14">ስንራ ያና ኬሀይ ነባ፤</para>
  <para style="q2" vid="PRO 24:14">ነ ኡፋይሳይ የና።<verse eid="PRO 24:14"/></para>
  <para style="s2">27</para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 24:15"/>ፅሎ አሳ ኬ ቦንቃናዉ ናጎፓ፤</para>
  <para style="q2" vid="PRO 24:15">እያ አቁዋ ይሳናዉ ደንዶፋ።<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>ፅሎ አስ ላፑን ቶሆ ኩንድኮካ ደንዴስ፤</para>
  <para style="q2" vid="PRO 24:16">ሽን ኢታት ጋዶን ያና።<verse eid="PRO 24:16"/></para>
  <para style="s2">28</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>ነ ሞርከይ ኩንድያ ዎደ ኡፋይቶፋ፤</para>
  <para style="q2" vid="PRO 24:17">እ በትያ ዎደ ሀሹ ጎፓ።<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>ጎዳይ ሄሳ በእድ ኡፋይተና፤</para>
  <para style="q2" vid="PRO 24:18">እያ ሀንቀቶና አጋጋና።<verse eid="PRO 24:18"/></para>
  <para style="s2">29</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>ኢታ ኦይሳታ ጋሶን ህርጎፋ፤</para>
  <para style="q2" vid="PRO 24:19">ኤንታ መላ ግዳርክና ጋዳ ቆፖፋ።<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>ኢታ አሳስ ስንራ ያና ኬህ ባዋ፤</para>
  <para style="q2" vid="PRO 24:20">ኢታታ ፆምፐይ ቶአና።<verse eid="PRO 24:20"/></para>
  <para style="s2">30</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>ታ ናአዉ፥ ጎዳነ ካዋ ያያ፤</para>
  <para style="q2" vid="PRO 24:21">ኤንታ ቦላ ማካለይሳታራ ሄመቶፋ።<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>ሄሳ መላ አሳታ ቆፖና መቶይ ጋኬስ፤</para>
  <para style="q2" vid="PRO 24:22">ካዋፐነ ጎዳፐ ያና መቶ ኦነ ኤረይ?<verse eid="PRO 24:22"/></para>
  <para style="s1">ሀራ ጭንጫ ዞረታ</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23"/>ጭንጫት ጉጅድ ሀይሳዳ ያግዶሶና፤</para>
  <para style="q1" vid="PRO 24:23">ሶምኦ በእድ ፕርዶይ ሎኦ ግደና።<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>ቆህዳይሳ ሎኦ ኦዳሳ</para>
  <para style="q2" vid="PRO 24:24">ግያ ዳይና፥ አስ ባዳና፤</para>
  <para style="q2" vid="PRO 24:24">ካዎተት እያ እፃና።<verse eid="PRO 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>ቆህዳይሳ ነ ባላ</para>
  <para style="q2" vid="PRO 24:25">ግያ ዳይናት ሎኦባ ኤካና</para>
  <para style="q2" vid="PRO 24:25">ዳሮ አንጆ ደማና።<verse eid="PRO 24:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>ቱማ ዛሮ ዛርያ አስ፥</para>
  <para style="q2" vid="PRO 24:26">ቱማ ላገ መላ።<verse eid="PRO 24:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>ካሰታዳ ነ ጋድያ ጎያ፤ ካ ዘራ፤</para>
  <para style="q2" vid="PRO 24:27">ሄሳፈ ጉየ፥ ነ ኬ ኬፃ።<verse eid="PRO 24:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>ነ ሾሩዋ ቦላ ጋሶይ ባይና ማርካቶፋ፤</para>
  <para style="q2" vid="PRO 24:28">ነ ዶናን ጭሞፋ።<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>“እ ታዉ ኦዳይሳዳ ታ እያዉ ኦና፤</para>
  <para style="q2" vid="PRO 24:29">ታ እያዉ ኩሸ ዛራና” ያጎፓ።<verse eid="PRO 24:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>ታኒ ቦዛ አሳ ጎሻራ አስ፤</para>
  <para style="q2" vid="PRO 24:30">አዛላ አድያ ዎይነ ጋደራ ካንስ።<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>አጉንነ ሻራፍ ጎዝ ዎስ፤</para>
  <para style="q2" vid="PRO 24:31">ዩሾን ደእያ ድርሳይካ ላለትስ።<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>ታኒ እያ በእዳ ዎደ ቆፓስ፤</para>
  <para style="q2" vid="PRO 24:32">እያፐ ትምርተ ኤካስ።<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>ኔኒ ጉ ሊጳ፤ ጉ ስካ፤</para>
  <para style="q2" vid="PRO 24:33">ነ ኩሽያ ሺሻዳ ጉ ሸምፓ።<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>ሽን ማንቆተ ፓኖዳ ያና፤</para>
  <para style="q2" vid="PRO 24:34">ዱሳ ዋየይ ኦላ ሚሸ ኦይክዳ አሳዳ ፑቱ ጋና።<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s1">ሀራ ሶሎሞነ ሌምሶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>ሀይሳቲ ይሁዳ ካዋ ህዝቅያሳ አሳት ዱቅድ ፃፍዳ ሶሎሞነ ሌምሶታ።<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>ፁራ ገንይ ፆሳስ ቦንቾ፤</para>
  <para style="q2" vid="PRO 25:2">ፁራ ፕልግድ ከሶይ ካዎታስ ቦንቾ።<verse eid="PRO 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>ሳሎይ ቁ ግዳይሳዳነ</para>
  <para style="q2" vid="PRO 25:3">ሳእ ዝቃ ግድዳይሳዳ</para>
  <para style="q2" vid="PRO 25:3">ካዎታ ቆፋ አስ ኤራናዉ ዳንዳኤና።<verse eid="PRO 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>ብራፐ ቅታ ድጋ፤</para>
  <para style="q2" vid="PRO 25:4">ሄሳፈ ጉየ፥ ሂላንቾይ ሎይና።<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>ካዎ ስንፈ ኢታ አሳታ ድጋ፤</para>
  <para style="q2" vid="PRO 25:5">እያ አራታይ ፅሎተን ምንድ ኤቃና።<verse eid="PRO 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>ካዎ ስንን ኤቅያ ዎደ ጬቀቶፋ፤</para>
  <para style="q2" vid="PRO 25:6">ግታ አሳታ ግዶን ነዉ በሰ ኮዮፓ።<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>ኔፐ ግታትያ አሳስ በሰ እማናዉ</para>
  <para style="q2" vid="PRO 25:7">ሀላቃይ ነና ደንን፥ ካዉየይሳፈ፥</para>
  <para style="q2" vid="PRO 25:7">እ ነና፥ “ሀ ቃ በሳን ኡታ” ገይስ ሎኦ።<verse eid="PRO 25:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8"/>ነ አይፈን በእዳባ ማርካታናዉ</para>
  <para style="q2" vid="PRO 25:8">ዳይና ስን ባናዉ ኤለሶፓ።</para>
  <para style="q1" vid="PRO 25:8">ነ ማርካታ ስምን ሀራ አስ</para>
  <para style="q2" vid="PRO 25:8">ነ ማርካተይ ባላ ግደይሳ ቆንጭስኮ፥ ነ ዬላታና።<verse eid="PRO 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>ነ ግዶንነ ነ ሾሩዋ ግዶን ፓላም መትኮ፥</para>
  <para style="q2" vid="PRO 25:9">እያራ ኦደታዳ ነ ፓላማ ዉርሳ፤</para>
  <para style="q2" vid="PRO 25:9">ሀራ አሳ ፁራ ቆንጭሶፓ።<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>ሄስ ሀኖና እፅኮ ነ ኦደይሳ ስእዳ አስ</para>
  <para style="q2" vid="PRO 25:10">ነና ካዉሻና፤</para>
  <para style="q2" vid="PRO 25:10">ነ ሱንይ ዛሪድ ስሞናዳ ኢታና።<verse eid="PRO 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>በሲያ ዎደ ኦደትዳ ልከ ቃል፥</para>
  <para style="q2" vid="PRO 25:11">ብራ ሚሸ ቦላ ትገትዳ ዎርቃ አሌቆ መላ።<verse eid="PRO 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>ኤራ አስ ዞርያ ዞረ ስእያ ሀይስ፥</para>
  <para style="q2" vid="PRO 25:12">ሄስ ዎርቃፈ ዎይኮ ጌሻ ዎርቃፈ</para>
  <para style="q2" vid="PRO 25:12">ኦሰትዳ አሌቆ መላ።<verse eid="PRO 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>ካ ጫክያ ዎደ እርፃ ሃ ኡይን አለይሳዳ፥</para>
  <para style="q2" vid="PRO 25:13">አማንያ ኪታንቾይ ባና ኪቶይሳ ኡፋይሴስ።<verse eid="PRO 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>እሞናባ እማና ግድ ጬቀትያ አስ</para>
  <para style="q2" vid="PRO 25:14">እር ባይና ሻራነ ጫርኮ መላ።<verse eid="PRO 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>ዳንዳአ አስ ሀላቃ ኦድድ ማይዜስ፤</para>
  <para style="q2" vid="PRO 25:15">ሊቆ ቃል መቀ ካን ገሌስ።<verse eid="PRO 25:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>ኤስ ደምኮ ካላና ጋካናዉ ማ፤</para>
  <para style="q2" vid="PRO 25:16">ሽን ዳርስኮ ነና ጮሻና።<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>ነና ኡፍሸ እፆናዳ፥</para>
  <para style="q2" vid="PRO 25:17">ነ ሾሩዋ ሶ ኡባ ዎደ ቦፓ።<verse eid="PRO 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>ባ ሾሩዋ ቦላ ዎርዶን ማርካትያ አስ፥</para>
  <para style="q2" vid="PRO 25:18">ፃምእ፥ ማሽነ ቶር ቆሄይሳዳ ቆሄስ።<verse eid="PRO 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 25:19"/>መቶ ዎደ አማነቶና አሳን ዘምፖይ፥</para>
  <para style="q2" vid="PRO 25:19">ቃፅያ አቻን ጮምያነ</para>
  <para style="q2" vid="PRO 25:19">ስልዳ ቶሆን ሄመተይሳ መላ።<verse eid="PRO 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>አዛንዳ አሳስ የ የፅያ አስ፥</para>
  <para style="q2" vid="PRO 25:20">ሜጎ ዎደ ማኦ ቃርያነ</para>
  <para style="q2" vid="PRO 25:20">ማዱን ቦላ ጫላባ ትግያ አሳ መላ።<verse eid="PRO 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>ነ ሞርከይ ኮሻትኮ ሙዛ፤</para>
  <para style="q2" vid="PRO 25:21">ሳሞትኮ ኡሻ።<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>ነ ሄሳ ኦኮ እያ ሁጰን ታማ ቦንቆ</para>
  <para style="q2" vid="PRO 25:22">ካሽድ ቆለይሳ መላ፤</para>
  <para style="q2" vid="PRO 25:22">ጎዳይ ነና ዎይታና።<verse eid="PRO 25:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>ዶሎሀ ባጋ ጫርኮይ እራ ኤሄይሳዳ፥</para>
  <para style="q2" vid="PRO 25:23">ዝግርስ ሀንቆ ኤሄስ።<verse eid="PRO 25:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>ዶናትያ ማችራ እስ ኬን ዳናፐ</para>
  <para style="q2" vid="PRO 25:24">ካረ ባራንዳን ዱስ ሎኦ።<verse eid="PRO 25:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>ዳቡርዳ አስ እርፃ ሃ ኡይድ አለይሳዳ፥</para>
  <para style="q2" vid="PRO 25:25">ሃሆ ቢታፈ ያ ሎኦ ኦድ ኡፋይሴስ።<verse eid="PRO 25:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>ኢታ አሳ ስንን ጉልባትያ ፅሎ አስ፥</para>
  <para style="q2" vid="PRO 25:26">ቡሎትዳ ፑልቶነ ኢትዳ ኦላ ሃ መላ።<verse eid="PRO 25:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>ዳሮ ኤስ ሙስ ሎኦ ግደና፤</para>
  <para style="q2" vid="PRO 25:27">ሄሳዳካ፥ ባ ቦንቾ ኮሽ ቦንችሰና።<verse eid="PRO 25:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>ባና ሃሮና አስ</para>
  <para style="q2" vid="PRO 25:28">ድርስ ላለትዳ ካታማ መላ።<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 26:1"/>ቦነ ሻች፥ ካ ጫክያ ዎደ እር ኮሾናይሳዳ፥</para>
  <para style="q2" vid="PRO 26:1">ኤያስ ቦንቾ ኮሸና።<verse eid="PRO 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>ካፎት ያነ ሃነ ፕራሸ አሰ ቆሆናይሳዳ፥</para>
  <para style="q2" vid="PRO 26:2">ጋሶይ ባይና ባድያ ባደ አሰ ጋከና።<verse eid="PRO 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>ፓራስ ልሶ፥ ሀረስ ብፃላ ኮሸይሳዳ</para>
  <para style="q2" vid="PRO 26:3">ኤያ አሳ ዞኮስ ፃምአ ኮሼስ።<verse eid="PRO 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>ኤያ አሳስ እያ ኤያተዳ ዛሮፓ፤</para>
  <para style="q2" vid="PRO 26:4">ዛርኮ ነ እያ መላ ግዳና።<verse eid="PRO 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>ኤያ አሳስ እያ ኤያተ ቆንጭሳዳ ዛራ፤</para>
  <para style="q2" vid="PRO 26:5">ሄስ ሀኖና እፅኮ እ ባና ጭንጫ ግድ ቆፓና።<verse eid="PRO 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>ኤያ አሳ ቦላ ኪታ የዶይ፥</para>
  <para style="q2" vid="PRO 26:6">ባ ቶሆ ቃንፅ የገይሳ መላ</para>
  <para style="q2" vid="PRO 26:6">ዎይኮ ዎያባ ኡየይሳ መላ።<verse eid="PRO 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>ኤያ አሳ ሌምሶይ፥</para>
  <para style="q2" vid="PRO 26:7">ስልዳ ቶሆ መላ ማደና።<verse eid="PRO 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>ኤያ አሳስ ቦንቾ እሞይ፥</para>
  <para style="q2" vid="PRO 26:8">ሹቹ ያምባርሻን ቃች ዎድ</para>
  <para style="q2" vid="PRO 26:8">ያምባራናዉ ፓጭያ አሳ መላ።<verse eid="PRO 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 26:9"/>ኤያ አሳ ሌምሶይ</para>
  <para style="q2" vid="PRO 26:9">ማትዳ አስ ባ ኩሸ ጫድዳ አጉን</para>
  <para style="q2" vid="PRO 26:9">ከሳናዉ ባፀተይሳ መላ።<verse eid="PRO 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 26:10"/>ኤያ አሳ ዎይኮ ባ ኦገ ብያ አስ</para>
  <para style="q2" vid="PRO 26:10">ኡነ ኦስሳናዉ ቃፃርያ አስ</para>
  <para style="q2" vid="PRO 26:10">ባ ቶራ ሻራን ፆንግያ አሳ መላ።<verse eid="PRO 26:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 26:11"/>ካን ባ ጮሻኮ ጉየ ስሚድ ላጨይሳዳ፥</para>
  <para style="q2" vid="PRO 26:11">ኤያ አስ ባ ኤያተ ዛር ዛር ቆንጭሴስ።<verse eid="PRO 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 26:12"/>ባና ጭንጫ ኦድ ፄልያ አሳፐ</para>
  <para style="q2" vid="PRO 26:12">ኤያ አሳስ ሎኦ ቃድ ደኤስ።<verse eid="PRO 26:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 26:13"/>“አዛላ አስ ኦገን ጋሞይ ደኤስ፤</para>
  <para style="q2" vid="PRO 26:13">ያሽያ ጋሞይ ኦገን ዩዬስ” ያጌስ።<verse eid="PRO 26:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 26:14"/>ሳንቅ ማፃፈ ቦላ ያነ ሃነ ቃፀይሳዳ፥</para>
  <para style="q2" vid="PRO 26:14">አዛላ አስ ባ ሂፃን ያነ ሃነ ሽረቴስ።<verse eid="PRO 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 26:15"/>እስ እስ አዛላ አስ ሀር አቶሽን፥</para>
  <para style="q2" vid="PRO 26:15">ዎፀን ቱሽድ ባራናዉ ዋየቴስ።<verse eid="PRO 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 26:16"/>አዛላ አስ ማርካራ ኦድያ ላፑን ጭንጫታፐ</para>
  <para style="q2" vid="PRO 26:16">ባና አዳ ጭንጫ ግድ ቆፔስ።<verse eid="PRO 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 26:17"/>ባና ጋያባይ ባይናባን ፓላምያ አስ</para>
  <para style="q2" vid="PRO 26:17">ኦገራ ብያ ካና ሀይ ኦይክያ አሳ መላ።<verse eid="PRO 26:17"/></para>
  <para style="p">
    <verse number="18-19" style="v" sid="PRO 26:18-19"/>ባ ሾሩዋ፥ “ታኒ ካሰ ጋይስ”</para>
  <para style="q2" vid="PRO 26:18-19">ያግድ ጭምያ አስ፥</para>
  <para style="q2" vid="PRO 26:18-19">ጎይድ ቦንቆ ታማ ሆልያ፥</para>
  <para style="q2" vid="PRO 26:18-19">ዎይኮ ዎያ ዶንገ ቶራ ዱክያ አሳ መላ።<verse eid="PRO 26:18-19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 26:20"/>ም ዉርኮ ታም ቶኤስ፤</para>
  <para style="q2" vid="PRO 26:20">ዝግርስ ይኮ ኦሽ አቴስ።<verse eid="PRO 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 26:21"/>ፂፍ ቦንቆ ዳርሰይሳዳነ</para>
  <para style="q2" vid="PRO 26:21">ም ታማ ዳርሰይሳዳ</para>
  <para style="q2" vid="PRO 26:21">ፓላማ ዳርስያ አስ ኦሹ ዳርሴስ።<verse eid="PRO 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 26:22"/>ዝግርሳ ቃል ማልኦ ካ መላ</para>
  <para style="q2" vid="PRO 26:22">ኡፋይስሸ ዱገ ጋንጀ ቤስ።<verse eid="PRO 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 26:23"/>ዎዛናን ኢታባይ ደእሽን፥</para>
  <para style="q2" vid="PRO 26:23">ባ እንፃርሳን ጭሞ ቃላ ሃሳያ አስ</para>
  <para style="q2" vid="PRO 26:23">ብራን ላንፀትዳ ኡርቃ ሚሸ መላ።<verse eid="PRO 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 26:24"/>ገነ አስ ባ ዎዛናን ደእያ ኢታተ</para>
  <para style="q2" vid="PRO 26:24">ባ እንፃርሳን ገንስ።<verse eid="PRO 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 26:25"/>እያ ዎዛናን ላፑን ቱናት ኩምዳ ግሾ፥</para>
  <para style="q2" vid="PRO 26:25">እ ሎኦ ቃላ ሃሳይኮካ እያ አማኖፓ።<verse eid="PRO 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 26:26"/>ባ ሞርከተ እ ገንኮካ፥</para>
  <para style="q2" vid="PRO 26:26">እ ኦያ ኢታይ ዳባባን ቆንጫና።<verse eid="PRO 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 26:27"/>ሀራታስ ኦላ ቦክያ አስ ሄ ኦላን ባዉ ኩንዳና፤</para>
  <para style="q2" vid="PRO 26:27">ሀራታ ቦላ ሹቹ ጎንዶርስያ አሳ ቦላ</para>
  <para style="q2" vid="PRO 26:27">ሄ ሹቻይ ስሚድ ጎንዶረታና።<verse eid="PRO 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 26:28"/>ዎርዶትያ እንፃርስ ባ ቆህዳ አሳታ እፄስ፤</para>
  <para style="q2" vid="PRO 26:28">ጭሞ ኦድ ኩንደ ካለስ።<verse eid="PRO 26:28"/></para>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 27:1"/>ዎንቶይ ኤሀናባ ነ ኤሮና ግሾ</para>
  <para style="q2" vid="PRO 27:1">ዎንቶባን ጬቀቶፋ።<verse eid="PRO 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>ሀራ አስ ነና ጋላቶፐ አትሽን ኔኒ ነና ጋላቶፓ፤</para>
  <para style="q2" vid="PRO 27:2">አስ ነ ግሾ ማርካቶፈ አትሽን፥ ኔኒ ነ ኬሀተባ ኦዶፓ።<verse eid="PRO 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>ሹች ግታ ቶሆ፤ ሻፈይ ዴፆ፤</para>
  <para style="q2" vid="PRO 27:3">ሽን ኤያ አስ መያ ኦሽ</para>
  <para style="q2" vid="PRO 27:3">ናምኣፈካ ዴፄስ።<verse eid="PRO 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>ሀንቆስ ቃይ ባዋ፤</para>
  <para style="q2" vid="PRO 27:4">ይሎይ ይስያ ድኦ መላ፤</para>
  <para style="q2" vid="PRO 27:4">ሽን ቃናተይ ኡባፈ ኢታ።<verse eid="PRO 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>ጌምዳ ሲቆፐ</para>
  <para style="q2" vid="PRO 27:5">ባልያ ዎደ ቆንጨን ሀንቀተ ሎኦ።<verse eid="PRO 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 27:6"/>ሞርከይ ነና ታሙ ቶሆ ዬራናፐ</para>
  <para style="q2" vid="PRO 27:6">ሲቆይ ነና ማዱንፅሰይስ ሎኦ።<verse eid="PRO 27:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>ካልዳ አስ እልሎ ኤስ ሻቴስ፤</para>
  <para style="q2" vid="PRO 27:7">ሽን ኮሻትዳ ኡራ ጫምያባይ ማልኤስ።<verse eid="PRO 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>ባ ሶ አግድ ዩይያ አስ፥</para>
  <para style="q2" vid="PRO 27:8">ባ ኬ አጋዳ ፓልያ ካፎ መላ።<verse eid="PRO 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>ሽቶይነ ሳውያ እፃነይ አሰ ኡፋይሰይሳዳ</para>
  <para style="q2" vid="PRO 27:9">ሲቆ ላገ ዞረይ ሄሳዳ ኡፋይሴስ።<verse eid="PRO 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>ነ ላገታነ ነ አዋ ላገታ አጎፋ፤</para>
  <para style="q2" vid="PRO 27:10">ነ መቶትዳ ዎደ ነ እሻ ሶ ቦፓ፤</para>
  <para style="q2" vid="PRO 27:10">ሃሆን ደእያ እሻፐ ማታን ደእያ ሾሮይ ሎኦ።<verse eid="PRO 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>ታ ናአዉ፥ ጭንጫ ግዳ፤ ታና ኡፋይሳ፤</para>
  <para style="q2" vid="PRO 27:11">ታና ካያ አሳስ ታ ዛሮ እማና።<verse eid="PRO 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>ጭንጫ አስ መቶይ ያ ዎደ በእድ ቆሰቴስ፤</para>
  <para style="q2" vid="PRO 27:12">ሽን አኬክ ባይና አስ ብድ መቶን ገሌስ፤</para>
  <para style="q2" vid="PRO 27:12">ያትድ ጉየፐ ቂሮቴስ።<verse eid="PRO 27:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>ኤሮና አሳስ ዋሰ ገልያ ኡራ ማኡዋ ቃር ኤክተ፤</para>
  <para style="q2" vid="PRO 27:13">እማ አሳስ ዋሰ ገልዳ ኡራ ማኡዋ ኦይክተ።<verse eid="PRO 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>ዎንታ ጉራ ባ ቃላ ቁ ኦድ፥</para>
  <para style="q2" vid="PRO 27:14">ባ ሾሩዋ ሳሮተይ እያ ባድያ አሳ መላ።<verse eid="PRO 27:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>ዶናትያ ማቻነ</para>
  <para style="q2" vid="PRO 27:15">አያ ኬ እስኖ።<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>ጫርኮ ተቃናዉ፥ ዛይተ ኩጭድ ኦይካናዉ ዳንዳኤቶናይሳዳ፥</para>
  <para style="q2" vid="PRO 27:16">እዮ ስእ ኦናዉ ዳንዳኤተና።<verse eid="PRO 27:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>ብራት ብራታ ፖሸይሳዳ፥</para>
  <para style="q2" vid="PRO 27:17">አስ እሶይ እሱዋፈ ታማሬስ።<verse eid="PRO 27:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>ባላሰ ም ሎይድ ናግያ አስ እያ አይፈ ማና፤</para>
  <para style="q2" vid="PRO 27:18">ባ ሀላቃ ካቦያ ኦሳንቾይ ቦንቸታና።<verse eid="PRO 27:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>ሃ ማስቶተዳ ሶምኦ በሰይሳዳ፥</para>
  <para style="q2" vid="PRO 27:19">አሳ ዎዛን እያ ኦናተ በሴስ።<verse eid="PRO 27:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>ሀይቆይነ ዱፎይ ካል ኤሮናይሳዳ፥</para>
  <para style="q2" vid="PRO 27:20">አሳ አይፈይ ካልድ ኤረና።<verse eid="PRO 27:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>ብርነ ዎርቀይ ታማን ፓጨትድ ጌየይሳዳ፥</para>
  <para style="q2" vid="PRO 27:21">አስ ባ ኤክያ ጋላታን ፓጨቴስ።<verse eid="PRO 27:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>ካ ኡዱላን ጫደይሳዳ፥</para>
  <para style="q2" vid="PRO 27:22">ኤያ አስ ኡዱላን ጫድያኮካ</para>
  <para style="q2" vid="PRO 27:22">እያፐ ኤያተይ ክቸና።<verse eid="PRO 27:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>ነ ዶርሳታ ሀኖታ ሎይዳ ኤራ፤</para>
  <para style="q2" vid="PRO 27:23">ነ ዉድያካ አኬካዳ ሄማ።<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>አይስ ጊኮ፥ ዱረተ መርናዉ ዴና፤</para>
  <para style="q2" vid="PRO 27:24">ካላችካ የለተፈ የለተስ አና።<verse eid="PRO 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 27:25"/>መላ ማታይ ቡጨትን፥ አጫ ማት ከያ ዎደ፥</para>
  <para style="q2" vid="PRO 27:25">ደርያ ቦላ ደእያ ማታይ ሺቅዳፐ ጉየ፥<verse eid="PRO 27:25"/></para>
  <para style="q2">
    <verse number="26" style="v" sid="PRO 27:26"/>ዶርሳታ እክሰፐ ነ ነዉ ማኦ ከሳና፤</para>
  <para style="q2" vid="PRO 27:26">ዴሻታ ባይዛዳ ጋደ ሻማና።<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>አትዳ ዴሻታ ማይ ነዉ፥</para>
  <para style="q2" vid="PRO 27:27">ነ ሶ አሳስነ ነ ማጫ አይለታስ ካ ግዳና።<verse eid="PRO 27:27"/></para>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 28:1"/>ኢታት ኦንካ የደና ባቃቶሶና፤</para>
  <para style="q2" vid="PRO 28:1">ሽን ፅሎት ጋሞ መላ ያዮና ደኦሶና።<verse eid="PRO 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>እስ ካዎተይ ማካልኮ፥ ሃረይሳት ዳሮሶና፤</para>
  <para style="q2" vid="PRO 28:2">ሽን ካለይስ ጭንጫነ አኬካንቾ ግድኮ፥</para>
  <para style="q2" vid="PRO 28:2">ሳሮተነ ዎፕ ደኤስ።<verse eid="PRO 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>ማንቆታ ኡንኤያ ካዎይ</para>
  <para style="q2" vid="PRO 28:3">ካ ይስያ ዎልቃማ እራ መላ።<verse eid="PRO 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>ህገ ቦንቾና አስ ኢታ አሳ ሳቤስ፤</para>
  <para style="q2" vid="PRO 28:4">ሽን ህገ ቦንችያ አስ ኢታ አሳ እፄስ።<verse eid="PRO 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>ኢታ አሳታስ ሱረ ፕርድ ገለና፤</para>
  <para style="q2" vid="PRO 28:5">ሽን ጎዳ ጎይንያ አስ ኡባ አኬከስ።<verse eid="PRO 28:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 28:6"/>ዱረ ግድድ ጭምያ አስ ግዳናፐ፥</para>
  <para style="q2" vid="PRO 28:6">ማንቆ ግድድ ሱረ ግደይስ ሎኦ።<verse eid="PRO 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 28:7"/>ህገ ናግያ ናአይ አኬካ ናአ፤</para>
  <para style="q2" vid="PRO 28:7">ሽን ፓና አሳራ ሄመተይ ባ አዋ ዬላዬስ።<verse eid="PRO 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 28:8"/>ምሸ የሎን ታልኤይነ አሰ ቦንቅድ ዱረትያ አስ</para>
  <para style="q2" vid="PRO 28:8">ሄ አቁዋ ማንቆታስ ኬህያ አሳስ ሺሼስ።<verse eid="PRO 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>ህገ ስአናፐ ግድ ባ ሀይ ቱጭያ፥</para>
  <para style="q2" vid="PRO 28:9">ኡራ ዎሳይ ጎዳ ስንን እፀትዳባ።<verse eid="PRO 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>ሱረታ ኢታ ኦገን ካለያ ኡራይ</para>
  <para style="q2" vid="PRO 28:10">ባ ቦክዳ ኦላን ኩንዳና፤</para>
  <para style="q2" vid="PRO 28:10">ሽን ጌሻት ሎኦባ ላታና።<verse eid="PRO 28:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>ዱረ አስ ባና ጭንጫ ግድ ቆፔስ፤</para>
  <para style="q2" vid="PRO 28:11">ሽን አኬክ ደእያ ማንቆይ እያ ፓጬስ።<verse eid="PRO 28:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>ፅሎት ፆንያ ዎደ አሳ ኡባይ ኡፋይቴስ፤</para>
  <para style="q2" vid="PRO 28:12">ሽን ኢታት ማታ ኦይክያ ዎደ አሳይ ቆሰቴስ።<verse eid="PRO 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>ባ ናጋራ ገንያ አስ አጨና፤</para>
  <para style="q2" vid="PRO 28:13">ሽን ፓፀይነ ናጋራ አገይ ማሮታ ኤካና።<verse eid="PRO 28:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>ጎዳ ኡባ ዎደ ያይያ አስ አንጀትዳይሳ፤</para>
  <para style="q2" vid="PRO 28:14">ሽን ባ ዎዛና ምንያ አስ መቶን ገላና።<verse eid="PRO 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>ማንቆ አሳ ሃርያ ኢታ ሀላቃይ፥</para>
  <para style="q2" vid="PRO 28:15">ጉድያ ጋሞነ ኮሻትዳ ባባን መላ።<verse eid="PRO 28:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>አኬክ ባይና ካዎይ ባ ደርያ ቆሄስ፤</para>
  <para style="q2" vid="PRO 28:16">ሽን አሰ ቆሆና ሀላቅ ዳሮ ላይ ሃራና።<verse eid="PRO 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>አሰ ዎያ አስ ሀይቃና ጋካናዉ ባቃትሸ ደኤስ፤</para>
  <para style="q2" vid="PRO 28:17">እያ ኦንካ ማደና።<verse eid="PRO 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>ቦረይ ባይና ሄመትያ አስ ቆሄተና፤</para>
  <para style="q2" vid="PRO 28:18">ሽን ጌላ አስ አኬኮና ኩንዳና።<verse eid="PRO 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>ምንድ ኦያ አስ ካ ካሌስ፤</para>
  <para style="q2" vid="PRO 28:19">ሽን ፓና አሞ ካልያ አስ ማንቆተ ላታና።<verse eid="PRO 28:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>አማነትያ ኡራይ ዳሮ አንጀታና፤</para>
  <para style="q2" vid="PRO 28:20">ሽን ዱረታናዉ ዎፅያ አስ መቶ በአና።<verse eid="PRO 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>ሶምኦ በእድ ፕርዶይ ሎኦ ግደና፤</para>
  <para style="q2" vid="PRO 28:21">ሽን አስ ባሶ ኡይ ግሾ ግድ ቆሄስ።<verse eid="PRO 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>ያረ አስ ዱረታናዉ ባቀቴስ፤</para>
  <para style="q2" vid="PRO 28:22">ማንቆተ አኬኮና ኦይካናይሳ ኤረና።<verse eid="PRO 28:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>አሰ ጮ ሳቢያ አሳፐ</para>
  <para style="q2" vid="PRO 28:23">ሀንቀትያ አስ ጉየፐ ጋላተቴስ።<verse eid="PRO 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>ባ አዋነ ባ አይዉ ካይሶትድ፥ “ናጋራ ኦብከ”</para>
  <para style="q2" vid="PRO 28:24">ግያ አስነ ደምዳባ ይስያ አስ እስኖ።<verse eid="PRO 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>ኡዘ አስ ኦሽ ደንስ፤</para>
  <para style="q2" vid="PRO 28:25">ሽን ጎዳን አማነትያ አስ ካሌስ።<verse eid="PRO 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>ባናን አማነትያ አስ ኤያ፤</para>
  <para style="q2" vid="PRO 28:26">ሽን ጭንጫተን ሄመተያ አስ ሳሮ ደኤስ።<verse eid="PRO 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>ማንቆስ እምያ አስ መቶተና፤</para>
  <para style="q2" vid="PRO 28:27">ሽን ኤንታ በአናፐ ግድ ቅልምኤይ ባደታና።<verse eid="PRO 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>ኢታ አሳት ሹመትያ ዎደ አሳይ ቆሰቴስ፤</para>
  <para style="q2" vid="PRO 28:28">ሽን ኤንቲ ይያ ዎደ ፅሎት ዳሮሶና።<verse eid="PRO 28:28"/></para>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 29:1"/>ዳሮ ዎደ ሴረትድ ስሞና አስ</para>
  <para style="q2" vid="PRO 29:1">ሀሳዮና መቃና፤</para>
  <para style="q2" vid="PRO 29:1">ሄ ኡራስ ፓፆይ ባዋ።<verse eid="PRO 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>ፅሎ አሳት ሹመትያ ዎደ አሳይ ኡፋይቴስ፤</para>
  <para style="q2" vid="PRO 29:2">ሽን ኢታት ቢታ ሃርያ ዎደ አሳይ ኡንኤቴስ።<verse eid="PRO 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>ጭንጫተ ዶስያ አስ ባ አዋ ኡፋይሴስ፤</para>
  <para style="q2" vid="PRO 29:3">ሽን ላይማ ማጫሳ ሄራን ዩይያ አስ ባ ሚሽያ ዉርሴስ።<verse eid="PRO 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>ቱማ ፕርዳን ካዎይ ባ ካዎተ ዎፑ ኦስ፤</para>
  <para style="q2" vid="PRO 29:4">ሽን ዎፈ ኤክያ ካዎይ ባ ካዎተ ይሴስ።<verse eid="PRO 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>ባ ሾሩዋ ጭሞን ሳቢያ አስ፥</para>
  <para style="q2" vid="PRO 29:5">ባ ቶሆስ ፅሄ የጌስ።<verse eid="PRO 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>ኢታ አስ ባ ናጋራን ኦይከቴስ፤</para>
  <para style="q2" vid="PRO 29:6">ሽን ፅሎ አስ ኡፋይቴስ፥ የፄስ።<verse eid="PRO 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>ፅሎ አስ ማንቆታስ ሱረ ፕርዴስ፤</para>
  <para style="q2" vid="PRO 29:7">ሽን ኢታ አሳት ሄሳ ኤሮኮና።<verse eid="PRO 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>ጫይያ አሳት ካታማን ኦሹ ደንሶና፤</para>
  <para style="q2" vid="PRO 29:8">ሽን ጭንጫ አሳት ሀንቆ እርፅሶሶና።<verse eid="PRO 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>ጭንጫ አስ ኤያ አሳ ፕርደ ኬ ኤፍኮ፥</para>
  <para style="q2" vid="PRO 29:9">ኤያይ ሀንቀቴስ፤ ቅስ፤ እያዉ ሳሮይ ባዋ።<verse eid="PRO 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>ሱ ጉሳናዉ ሳሞትያ አሳት ሱረ አስ እፆሶና፤</para>
  <para style="q2" vid="PRO 29:10">ፅሎ አሳ ዎናዉ ኮዮሶና።<verse eid="PRO 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>ኤያ አስ ባ ሀንቁዋ የድ በሴስ፤</para>
  <para style="q2" vid="PRO 29:11">ሽን ጭንጫ አስ ባና ሃሬስ።<verse eid="PRO 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>ሹማይ ዎርዶ ኦዳ ስእያባ ግድኮ፥</para>
  <para style="q2" vid="PRO 29:12">እያ ሞርናት ኡባይ ኢታ ግዶሶና።<verse eid="PRO 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>ማንቆይነ አሰ ናቅያ አስ እስባ ኮፆሶና፤</para>
  <para style="q2" vid="PRO 29:13">ኤንታ ናምኣስ አይፈ እምዳይ ጎዳ።<verse eid="PRO 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>ካዎይ ማንቆታስ ሱረ ፕርድኮ፥</para>
  <para style="q2" vid="PRO 29:14">እ ባ አራታን ጋምአና።<verse eid="PRO 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>ፕርጮን ሴር ናይታስ ጭንጫተ እሜስ፤</para>
  <para style="q2" vid="PRO 29:15">ሽን የዳን ድጭዳ ናእ ባ አይዉ ካዉሼስ።<verse eid="PRO 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>ኢታ አሳት ዳርያ ዎደ ናጋር ዳሬስ፤</para>
  <para style="q2" vid="PRO 29:16">ሽን ፅሎት ኤንታ ኩንደ በአና።<verse eid="PRO 29:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>ነ ናኣ ሴራ፤</para>
  <para style="q2" vid="PRO 29:17">እ ነዉ ሳሮ እማና፤</para>
  <para style="q2" vid="PRO 29:17">እ ነና ኡፋይሳና።<verse eid="PRO 29:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>ቆንጨ ባይና እፅኮ ደረይ የዳ ግዴስ፤</para>
  <para style="q2" vid="PRO 29:18">ሽን ህገ ናግያ አስ አንጀትዳይሳ።<verse eid="PRO 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>አይለይ ጮ ኦዳ ፃላላን ሴረተና፤</para>
  <para style="q2" vid="PRO 29:19">እያዉ ገልያኮካ እ ኪተተና።<verse eid="PRO 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>ኤሶን ሃሳያ አስ በአ ኤራይ?</para>
  <para style="q2" vid="PRO 29:20">እያፐ ኤያ አሳስ ኡፋይስ ደኤስ።<verse eid="PRO 29:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>ነ አይልያ ናአ የዳ ድችኮ፥</para>
  <para style="q2" vid="PRO 29:21">እያ ዉርሰይ አዛኖ ግዳና።<verse eid="PRO 29:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>ሀንቀትያ አስ ኦሹ ደንስ፤</para>
  <para style="q2" vid="PRO 29:22">ኤለ ይሎትያ አስ ዳሮ ናጋራ ኦስ።<verse eid="PRO 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>ኦቶሮይ አሰ ካዉሼስ፤</para>
  <para style="q2" vid="PRO 29:23">ሽን አሽከ አያን ደእያ አስ ቦንቸቴስ።<verse eid="PRO 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>ካይሶራ ላገትያ አስ ባና እፅያ አስ፤</para>
  <para style="q2" vid="PRO 29:24">እ ዳባባን ቱማ ኦድኮ ሴረቴስ፤</para>
  <para style="q2" vid="PRO 29:24">እ ቱማ ኦዶና እፅኮ ጎዳን ባደታና።<verse eid="PRO 29:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>አሳስ ያሽ ሄ ኡራስ ፅሄ ግዴስ፤</para>
  <para style="q2" vid="PRO 29:25">ሽን ጎዳን አማነትያ አስ ሳሮ ደኤስ።<verse eid="PRO 29:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>ዳሮት ማት ደእያ አሳፐ ማደ ኮዮሶና፤</para>
  <para style="q2" vid="PRO 29:26">ሽን ሱረ ፕርድ ጎዳፐ በንቴስ።<verse eid="PRO 29:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>ፅሎት ናጋራንቾታ ሻተቶሶና፤</para>
  <para style="q2" vid="PRO 29:27">ኢታት ሱረ አሳ እፆሶና።<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s1">አጉራ ሌምሶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>ያቀ ናኣ አጉራ ሌምሶት ሀይሳፈ ካልድ ፃፈትዳይሳታ። አጉር እትኤላስነ ኡካላስ ሀይሳ ሃሳይስ። <verse eid="PRO 30:1"/><verse number="2" style="v" sid="PRO 30:2"/>ታኒ አሳ ኡባፈ አዳ ኤያ፤</para>
  <para style="q2" vid="PRO 30:2">አሳስ ደእያ አኬክ ታዉ ዴና።<verse eid="PRO 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3"/>ታኒ ጭንጫተ ታማራብከ፤</para>
  <para style="q2" vid="PRO 30:3">ጌሻ ፆሳባካ ኤርከ።<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>ሳሎ ፑደ ከይድ ዱገ ዎዳይ ኦኔ?</para>
  <para style="q2" vid="PRO 30:4">ጫርኮ ባ ኩሸን ኦይክዳይ፥</para>
  <para style="q2" vid="PRO 30:4">ሃ ባ አፍላን ዪጭዳይ፥</para>
  <para style="q2" vid="PRO 30:4">ሳኣ ጋፃ ምንድ ኤስዳይ ኦኔ?</para>
  <para style="q1" vid="PRO 30:4">እያ ሱንይ ኦኔ?</para>
  <para style="q2" vid="PRO 30:4">እያ ናኣ ሱንይ ኦኔ?</para>
  <para style="q2" vid="PRO 30:4">እያ ኤርያ ግድኮ አነ ታዉ ኦዳ?<verse eid="PRO 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>ፆሳ ቃላን ቦረይ ባዋ፤ ኡባይ ቱማ</para>
  <para style="q2" vid="PRO 30:5">እያን አማነትያ ኡባስ እ ጎንዳለ።<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>እያ ቃላ ቦላ አይባካ ጉጆፋ፤</para>
  <para style="q2" vid="PRO 30:6">ጉጅኮ እ ነና ሴራና፤</para>
  <para style="q2" vid="PRO 30:6">ነ ዎርዳንቾ ግደይሳ እ ቆንጭሳና።<verse eid="PRO 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>ጎዳዉ፥ ታ ነና ናምኡባ ኦይቻይስ፤</para>
  <para style="q2" vid="PRO 30:7">ታ ሀይቃና ጋካናዉ ኤንታ ታና ድጎፋ።<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>ታ አሰ ጭሞና መላነ ዎርዶ ሃሳዮና መላ ታና ናጋ፤</para>
  <para style="q2" vid="PRO 30:8">ታዉ ኮሽያ ካ እማፈ አትሽን፥ ታና ዱረ ዎይኮ ማንቆ ኦፋ።<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>ዱረ ግዳዳ፥ “ጎዳይ ኦኔ?” ጋዳ ነና ካዳና፤</para>
  <para style="q2" vid="PRO 30:9">ማንቆ ግዳዳ፥ ካይሳዳ ታ ፆሳ ሱን ጫይሳና።<verse eid="PRO 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>ነና ባዶና መላነ</para>
  <para style="q2" vid="PRO 30:10">እያ ባደይ ነዉ ጎመ ግዶና መላ፥</para>
  <para style="q2" vid="PRO 30:10">አይልያ እያ ጎዳራ ዝግሮፓ።<verse eid="PRO 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>ባ አዋ ባድያነ ባ አይዉ አንጆና የለተ ደኤስ።<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>ዳሮ ቱና ግድ ኡትድ</para>
  <para style="q2" vid="PRO 30:12">ባንታና ጌሽ ኦያ አሳት ደኦሶና።<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>ኦቶሮን ኩምዳ አሳትነ</para>
  <para style="q2" vid="PRO 30:13">አሰ ካድ ፄልያ አሳት ደኦሶና።<verse eid="PRO 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14"/>ኤንታ አቻይ ማሸ ግድን፥</para>
  <para style="q2" vid="PRO 30:14">ኤንታ ጋጮይ ቶራ ግድን፥</para>
  <para style="q2" vid="PRO 30:14">ማንቆታነ መቶታንቾታ ናቅድ፥</para>
  <para style="q2" vid="PRO 30:14">ኤንታባ ቦንቅያ አሳት ደኦሶና።<verse eid="PRO 30:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>ኡላስ ናምኡ ማጫ ናይት ደኦሶና፤</para>
  <para style="q2" vid="PRO 30:15">ኤንቲ፥ “ሀማ! ሀማ!” ያግድ ዋሶሶና።</para>
  <para style="q1" vid="PRO 30:15">ካልድ ኤሮና ሄባት ደኦሶና፤</para>
  <para style="q2" vid="PRO 30:15">ኦይዳንይ ቃስ “ግዳና” ግድ ኤረና።<verse eid="PRO 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16"/>ሄሳት፥</para>
  <para style="q2" vid="PRO 30:16">ዱፎ፥</para>
  <para style="q2" vid="PRO 30:16">ማይንዳ ማጫስ፥</para>
  <para style="q2" vid="PRO 30:16">ሃ ካልድ ኤሮና መላ ቢታነ፥</para>
  <para style="q2" vid="PRO 30:16">“ግዳና!” ግድ ኤሮና ታማ።<verse eid="PRO 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>ባ አዋ ለቅያ ናኣ አይፍያ፥</para>
  <para style="q2" vid="PRO 30:17">ባ አይያ ጭምን ካያ ናኣ አይፍያ፥</para>
  <para style="q2" vid="PRO 30:17">ዛንጋራን ደእያ ቁሮት ዎጫና፤</para>
  <para style="q2" vid="PRO 30:17">እያ አሹዋ አንኮት ማና።<verse eid="PRO 30:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18"/>ታና ሄባት ማላልሶሶና፤</para>
  <para style="q2" vid="PRO 30:18">ኦይዳንይ ኡባ ታዉ ገለና።<verse eid="PRO 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19"/>ሄሳት፥</para>
  <para style="q2" vid="PRO 30:19">ሳሎራ ፓልያ አርጋን፥</para>
  <para style="q2" vid="PRO 30:19">ዛላ ቦላራ ኮልፅያ ሾሽ</para>
  <para style="q2" vid="PRO 30:19">አባ ቦላራ ብያ ማርካበነ</para>
  <para style="q2" vid="PRO 30:19">ጌላኦራ ስቆ ኦይከትዳ አደ።<verse eid="PRO 30:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>ላይማ ማጫስ ሀንያ ሀኖይካ ሄሳ መላ፤</para>
  <para style="q2" vid="PRO 30:20">እያ ማሱ፤ ሽን ባ ዶና ቁቻዳ፥</para>
  <para style="q2" vid="PRO 30:20">“ታኒ አይኮካ ባላቢከ” ያጋዉሱ።<verse eid="PRO 30:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21"/>ሄባን ቢት ቃፄስ፤</para>
  <para style="q2" vid="PRO 30:21">ኦይዳንዋ ኡባ ቶካናዉ ዳንዳኤተና።<verse eid="PRO 30:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22"/>ሄሳትካ፥</para>
  <para style="q2" vid="PRO 30:22">አይለይ ካዎትዳ ዎደ፥</para>
  <para style="q2" vid="PRO 30:22">ኤያ አስ ካ ካልዳ ዎደ፥<verse eid="PRO 30:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 30:23"/>አስ እፅዳ ማጫስ አዝና ገልዳ ዎደነ</para>
  <para style="q2" vid="PRO 30:23">ማጫ አይልያ ባ ጎዳትዉ ላትዳ ዎደ መትያ ሀኖታ።<verse eid="PRO 30:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24"/>ሳአ ቦላ ኦይዱ ጉ መተት ደኦሶና፤</para>
  <para style="q2" vid="PRO 30:24">ሽን ኤንቲ አዳ ጭንጫ።<verse eid="PRO 30:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25"/>ሄሳትካ፥</para>
  <para style="q1" vid="PRO 30:25">ጩንጫለይ ዎልቅ ባይና መተ፤</para>
  <para style="q2" vid="PRO 30:25">ሽን ባንታዉ ምያባ ቦነ ሺሽድ፥ ምንጆሶና።<verse eid="PRO 30:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26"/>ጉፓለት ዎልቅ ባይናይሳታ፤</para>
  <para style="q2" vid="PRO 30:26">ሽን ባንታ ኬ ዛላ ቆጶን ኬፆሶና።<verse eid="PRO 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27"/>ቦለታስ ካዎይ ባዋ፤</para>
  <para style="q2" vid="PRO 30:27">ሽን ኤንቲ ኡባይ ማራን ዛቶሶና።<verse eid="PRO 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28"/>ዛረት ኩሸን ኦይከቶሶና፤</para>
  <para style="q2" vid="PRO 30:28">ሽን ካዎ ጋን ደኦሶና።<verse eid="PRO 30:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29"/>ባንታ ማታ በስሸ ሄመትያ ሄ መተት ደኦሶና፤</para>
  <para style="q2" vid="PRO 30:29">ኦይዳንይ ሎኦ ሄመ ሄመቴስ።<verse eid="PRO 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30"/>ሄስካ፥</para>
  <para style="q2" vid="PRO 30:30">ዶአ ኡባፈ ምኖነ ያሽ ኤሮና ጋሞ።<verse eid="PRO 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31"/>ማጫ ኩቶታ ግዶን ሄመትያ አደ ኩቶ፥</para>
  <para style="q2" vid="PRO 30:31">ዉደ ካለያ ዴሻ ኮለ፤</para>
  <para style="q2" vid="PRO 30:31">ባ ኦላንቾታ ግዶን ቆንጨን ኤቅያ ካዋ።<verse eid="PRO 30:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>ኔኒ ኤያዳ ኦቶርትዳባ ግድኮካ፥</para>
  <para style="q2" vid="PRO 30:32">ኢታ ኦናዉ ሀልችዳባ ግድኮ፥</para>
  <para style="q2" vid="PRO 30:32">አነ ታክ ጋዳ ቆፓ።<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>ማ ቡከይ ኦይሱ ከሰይሳዳ፥</para>
  <para style="q2" vid="PRO 30:33">ሲ ድችን ሱ የይሳዳ፥</para>
  <para style="q2" vid="PRO 30:33">ሀንቆ ደንይ ኦሹ ኤሄስ።<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s1">ካዋ ልሙኤላ ሌምሶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>ሀይሳፈ ካልድ ፃፈትዳ ሌምሶይ፥ ካዋ ልሙኤላ አይያ ካዋ ልሙኤላ ታማርስዳይሳ።<verse eid="PRO 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>ታ ናአዉ፥ ታ ኡሎፐ ዎዳይሶ፥</para>
  <para style="q2" vid="PRO 31:2">ታኒ ቃንገታዳ የልዳይሶ፥<verse eid="PRO 31:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 31:3"/>ማጫሳን ነ ዎልቃ ዉርሶፋ፤</para>
  <para style="q2" vid="PRO 31:3">ካዎታ ይስያ ማጫሳታን ነ ምኖተ ይሶፋ።<verse eid="PRO 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>“ልሙኤላ፥ ዎይነ ኡሽ ካዎታስ በሰና፤</para>
  <para style="q2" vid="PRO 31:4">ማይያ ኡሽ ሹማታስ በሰና።<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>ኤንቲ ኡያ ዎደ ህገ ባሎሶና፤</para>
  <para style="q2" vid="PRO 31:5">ናቀትዳ አሳ ማታ ቀል ጎሶና።<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>ማያ ኡሹ ሀይቃና ሀንያ ኡራስነ</para>
  <para style="q2" vid="PRO 31:6">ሳእ ኢትዳ ኡራስ እምተ።<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>ኤንቲ ባንታ ማንቆተነ</para>
  <para style="q2" vid="PRO 31:7">ባንታ ዋይያ ዶጋናዉ ኡዮ።<verse eid="PRO 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>ባንታ ግሾ ኦደታናዉ ዳንዳኦና አሳ ግሾ ነ ኦዴታ፤</para>
  <para style="q2" vid="PRO 31:8">ማድያ አስ ባይናይሳታ ግሾ ነ ኤቃ።<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>ኤንታ ምየን ኤቃዳ ኤንታዉ ሱረ ፕርዳ፤</para>
  <para style="q2" vid="PRO 31:9">ማንቆታነ መቶታንቾታ ማታ ናጋ” ያጋዳ ታማርሳሱ።<verse eid="PRO 31:9"/></para>
  <para style="s1">ዎዛናማ ማቾ</para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 31:10"/>“ዎዛናማ ማቾ ኦን ደማናዉ ዳንዳኢ?</para>
  <para style="q2" vid="PRO 31:10">እ ጋተይ ዞኦ አልኦ ሹቻፈ አስ።<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>እ አዝናይ እዮ አማነቴስ፤</para>
  <para style="q2" vid="PRO 31:11">እያዉ ኮሽያባፐ አይብካ ፓጨና።<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>እያ ባ ደኦ ላይ ኡባን፥</para>
  <para style="q2" vid="PRO 31:12">እያዉ ሎኦባፐ አትሽን፥ ኢታባ ኦኩ።<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>ሱፈነ ሊኖ ኮያዳ፥</para>
  <para style="q2" vid="PRO 31:13">ኡፋይታሸ ባ ኩሸን ኦዉሱ።<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>እያ ዛልአንቾታ ማርካበ መላ፤</para>
  <para style="q2" vid="PRO 31:14">ባ ካ ሃሆ ቢታፈ ሺሻዉሱ።<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>እያ ባ ሶ አሳስ ካ ጊግሳናዉነ</para>
  <para style="q2" vid="PRO 31:15">ባ ማጫ አይለታስ ኦሶ እማናዉ፥</para>
  <para style="q2" vid="PRO 31:15">ሳእ ዎንቶና ደእሽን ደንዳዉሱ።<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>ሎኦ ጋደ ኮያዳ ሻማዉሱ፤</para>
  <para style="q2" vid="PRO 31:16">ባ ኩሸን ኦዳ ደምዳ</para>
  <para style="q2" vid="PRO 31:16">ሚሸን ዎይነ ቶካዉሱ።<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>እያ ባ ፄሳ ምንዳ ዳንጫዉሱ፤</para>
  <para style="q2" vid="PRO 31:17">ባ ቀስያ ኦሶስ ምንዉሱ።<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>እያ ዎ ደማናዉ ምናዳ ዛልአዉሱ፤</para>
  <para style="q2" vid="PRO 31:18">እያ ኦሸ ቃምስያ ግሾ እ ፆምፐይ ቶኤና።<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>እያ ባ ህንርትያ ኦይካዉሱ፤</para>
  <para style="q2" vid="PRO 31:19">ባ ብራን ሎይዳ ሱቃዉሱ።<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>እያ ማንቆታስነ መቶታንቾታስ እማዉሱ።<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>እ ሶ አሳ ኡባይ ሆእያ ማኦ ማእያ ግሾ፥</para>
  <para style="q2" vid="PRO 31:21">ሻች ቡክኮካ እያ ህርጉኩ።<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>አልጋ ቦላ ሂፅያ ማኦ ስካዉሱ፤</para>
  <para style="q2" vid="PRO 31:22">ሊኖፐ ኦሰትዳ ኦቻ ቴራ ዳንያ ማኦ ማአዉሱ።<verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>ቢታ ጭማት ሺቅያ ዱቡሻን</para>
  <para style="q2" vid="PRO 31:23">እ አዝናይ ቦንቸትዳ አስ።<verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>ሊኖፐ ማኦነ ዳንጮ ኦዳ፥</para>
  <para style="q2" vid="PRO 31:24">ዛልአንቾታስ ባይዛዉሱ።<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>እያ ምኖነ ቦንቾ አስ፤</para>
  <para style="q2" vid="PRO 31:25">ያና ላይ ኡባን ኡፋይታዳ ደአዉሱ።<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>ጭንጫተን ባ ዶና ዶያዉሱ፤</para>
  <para style="q2" vid="PRO 31:26">አማንያ ዞረይ እ እንፃርሳን ደኤስ።<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>እያ ባ ሶ አሳ ደኡዋ እንጀያናዉ ኡባ ዎደ ኦዉሱ፤</para>
  <para style="q2" vid="PRO 31:27">አዛላተ እ ቦላ በንትድ ኤረና።<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>እ ናይት ደንድድ፥ እዮ ናሾሶና፤</para>
  <para style="q2" vid="PRO 31:28">እ አዝናይ እዮ ያግድ ጋላቴስ፤<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>ሎኦባ ኦያ ዳሮ ማጫሳት ደኦሶና፤</para>
  <para style="q2" vid="PRO 31:29">ሽን ነ ኤንታ ኡባፈ አሳ” ያጌስ።<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>ማል ጭሜስ፤</para>
  <para style="q2" vid="PRO 31:30">የገልሳተ ያና።</para>
  <para style="q1" vid="PRO 31:30">ሽን ጎዳ ያይያ ማጫስያ፥</para>
  <para style="q2" vid="PRO 31:30">እያ አንጀትዳሮ።<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>እያ ኦዳባ ኡባስ እዮ ዎይትተ፤</para>
  <para style="q2" vid="PRO 31:31">እ ኦሶ ኡባይ ዳባባን እዮ ጋላትሶ።<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
