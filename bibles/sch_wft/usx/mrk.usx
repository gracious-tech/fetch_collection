<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">Sakachep: Bible Translation 1st Edition</book>
  <para style="ide">Unicode (UTF8)</para>
  <para style="h">Mark</para>
  <para style="toc1">Thurchisa MARK Miziek dungjûiin</para>
  <para style="toc2">Mark</para>
  <para style="toc3">Mk</para>
  <para style="mt2">Thurchisa</para>
  <para style="mt1">MARK</para>
  <para style="mt2">Miziek dungjûiin</para>
  <para style="imt1">Chongmaruoi</para>
  <para style="ip">
    <char style="bk">Thurchisa Mark miziek hih,</char> “Ma hih Pathien Nâipasal Jisua Khrista Thurchi Sa ani,” tiin chong aphut ani. Jisua chu sinthotheitak le rachamneitak ani ti minlangin aoma. Jisua rachamneina chu a minchuna ngeia, ramkhoringei chunga sinthotheina ngeia, le mingei an sietnangei a ngâidamna ngeia, hin ânlang ani. Jisua'n amananâkin Miriem Nâipasal ki ni ânti anghan, a ringna pêkin sietna renga mingei mojôk ranga juong ani tiin chong a ril ani.</para>
  <para style="ip">
    <char style="bk">Mark</char> hin Jisua chongbâingei le a minchunangei nêkin a sintho lunghâng tho uolin Jisua thurchi atûnpatin, arât rang lamtakin aminlang ani. Baptispu John thurchi le Jisua Baptisma a changna roi le huongna a tongna roi a ril viet suole chu amiziekpu hin Jisua'n mi a mindamna le mi a minchuna a misîr kelen ani. Zora ahong se bang anghan, a nûkjûingeiin Jisua an hong rietthei uola, aniatachu ama doi ngei chu an hong rât uol ani. Bung khârna tieng ngei hin chu pilchung ringnuna Jisua hapta nûktak mang tie ngei, aliekin ama an jêmdelna le inthoinôkna thurchi ngei a misîr ani.</para>
  <para style="ip">Thurchisa inik ngei amongna ranga, kuolkhuma omngei ha, chu mi tamtakin <char style="bk">Mark</char> miziek niloiin midang tumini amiziek ni rangin an mindon ani.</para>
  <para style="is1">Asûnga chongtângpuingei</para>
  <para style="io1">Thurchisa aphutna <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref> </char></para>
  <para style="io1">Galilee rama mipui ranga Jisua sintho <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref> </char></para>
  <para style="io1">Galilee renga Jerusalem <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref></char></para>
  <para style="io1">Jerusalem le akôl kienga hapta nûktak <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref></char></para>
  <para style="io1">Jisua inthoinôkna <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref> </char></para>
  <para style="io1">Jisua inlârna le invâna a kal <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref></char></para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s">Baptispu John thurchi misîr</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>; <ref loc="JHN 1:19-28">Joh 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Pathien Nâipasal<note caller="+" style="f"><char style="fr" closed="false">1:1: </char><char style="ft" closed="false">Miziek senkhatngei chu </char><char style="fq" closed="false">Pathien nâipasal </char><char style="ft" closed="false">ti hi don mak ngei.</char></note> Jisua Khrista Thurchi Sa chungroi chu mahi ani. <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>Dêipu Isaiah Lekhabua:</para>
  <para style="q1" vid="MRK 1:2">“Pathien'n, ‘Na lampui sinsiem rangin</para>
  <para style="q2" vid="MRK 1:2">ka thangtheipu no motona tîr ka ta.’<note caller="-" style="x"><char style="xo" closed="false">1:2: </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3:1</ref></char></note><verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>Ramchâra mi inkhat tânghâi han,</para>
  <para style="q2" vid="MRK 1:3">‘Pumapa lamlien sin ungla;</para>
  <para style="q2" vid="MRK 1:3">a lôna rang lampui mintûn roi!’” tia ânziek anghan ânphut ani.<note caller="-" style="x"><char style="xo" closed="false">1:3: </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isa 40:3</ref> (LXX)</char></note><verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>Masikin John hah Baptis tho le thurchi misîrin ramchâra han a juong ani<note caller="+" style="f"><char style="fr" closed="false">1:4: </char><char style="fq" closed="false">John hah Baptis tho le thurchi misîrin ramchâra han a juong ani; </char><char style="ft" closed="false">Miziek senkhatngei an dôn chu </char><char style="fqa" closed="false">Baptispu John hah ramchâra thurchi misîrin, ânlanga.</char></note>. Mingei kôm han, “Nin sietnangei renga insîr ungla, baptisma chang roi,” hanchu, “Pathien'n nin sietnangei nangni ngâidam atih” tiin a misîr ngâia. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>Judea ram le Jerusalem khopui renga mi tam tak John thurchi misîr rangâi rangin an sea. An sietnangei an phuonga, male ama'n Jordan dunga a Baptis ngei zoi.<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>John'n ûtmul puonngei ânsila, savun kongkhit a khita, a sâk chu khâimimsie, le rama khuoilutui ani.<note caller="-" style="x"><char style="xo" closed="false">1:6: </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 Rêng 1:8</ref></char></note> <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Mingei kôm han, “Ku nûka juong rangpu hi chu keima nêka roiinpui uol ok ania, kei chu inkûna a kekokrûi sût rang luo inhoi mu-ung. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Keima chu tui leh nangni ka Baptis ngâia, ama'n chu Ratha Inthiengin nangni Baptis atih,” a tia.<verse eid="MRK 1:8"/></para>
  <para style="s">Jisua baptisma chang le methêmna tongna</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">Mat 3:13—4:11</ref>; <ref loc="LUK 3:21-4:1">Luk 3:21,22—4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Galilee ramhuola Nazareth khuo renga Jisua hongna la sôt bâkloiin, Jordan dunga John'n Baptis a thoa. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>Jisua hah tui renga a hong jôk harenghan, invân ân-onga male Ratha Inthieng pharvali angati a chunga juong chum a mua. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>Male invân renga rôlin, “Nangma ka Nâipasal moroitak ni ni, nu chunga ka râiasântatak ani” ti chong ajuong tunga.<note caller="-" style="x"><char style="xo" closed="false">1:11: </char><char style="xt" closed="false"><ref loc="GEN 22:2">Aph 22:2</ref>; <ref loc="PSA 2:7">Lap 2:7</ref>; <ref loc="ISA 42:1">Isa 42:1</ref>; <ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">Mk 9:7</ref>; <ref loc="LUK 3:22">Luk 3:22</ref></char></note><verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>Voikhatrengin Ratha'n ramchâra a min se zoia, <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>mahan Soitan methêmin sûn sômminli a oma. Mahan ram sângei khom an oma, aniatachu vântîrtonngei han an juong san ngâi.<verse eid="MRK 1:13"/></para>
  <para style="s">Jisua'n ngasûrpungei minli a koina</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mat 4:12-22</ref>; <ref loc="LUK 4:14">Luk 4:14</ref>,<ref loc="LUK 4:15">15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>John hah intâng ina an khum suole chu, Jisua hah Pathien renga Thurchi Sa misîr rangin Galilee rama a sea. <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>“Azora diktak hah ahongtung zoi,” male, “Pathien Rêngram khom anâi zoi! Nin sietnangei renga insîr ungla male Thurchi Sa hi iem ta roi!” tiin a misîra.<note caller="-" style="x"><char style="xo" closed="false">1:15: </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat 3:2</ref></char></note><verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>Jisua'n Galilee dîl panga a lôn lâiin ngasûrpu inik Simon le a nâipa Andrew lên lei vôr hah a mua. <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>Jisua'n an kôm, “Ni jûi ungla, miriem sûr rangin nangni minchu ki tih” a tipe ngeia. <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Marenghan an lênngei an mâkraka male an jûi kelen zoi.<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>A se nôk uol vietin chu lâibungsa dang Zebedee nâipasalngei, Jacob le a nâipa John a mu nôka. An lênngei sinsiemin rukuong chunga an lei oma. <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>Jisua'n anni ngei hah a mu ngei lehan, a koi ngeia; an pa Zebedee hah inlo mingei kôm rukuonga an mâka, male Jisua leh an se kelen zoi.<verse eid="MRK 1:20"/></para>
  <para style="s">Miriem inkhat ramkhori sûr</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luk 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>Jisua le a ruoisingei hah Capernaum khopuia an honga, Sabbathni sûn anîn chu Jisua Synagog taka a lûta, male mi a minchu kelen zoia. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>A minchu lam ariet mingei han kamâm aom sabak an tia, Balam minchupungei angin niloiin; manêkin, rachamneitakin anni ngei ha a minchu sikin.<verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>Masuole han, ramkhori sûr mi inkhat synagog han a honga an iek raka, <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>ha mi han, “Nazareth Jisua, keini renga imo na nuom aom? Mi minmang ranga hong mo ni ni? Nang ki riet Pathien thangtheipu inthieng ni ni!” a tia.<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>Jisua'n ratha kôm han, “Dâirek inla, male ha miriem sûng renga hah hong jôk pai roh!” tiin chong a pêka.<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>Ratha saloi han amapa hah anîkbit suole chu inringtakin ân ieka, male a sûng renga a hong jôk pai zoia. <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>Mingei han kamâm aom sabak an tia, “Ma hih imo ani hi? Mahi minchuna thar mo ani? Ratha saloingei khom rachamneitakin chong a pêk ngeia, male a chong an jôm kelen hi?” Inkhat le inkhat anin rekel inlôma.<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>Masikin Galilee ramhuol pumpuia Jisua thurchi ânthang zit zoi.<verse eid="MRK 1:28"/></para>
  <para style="s">Jisua'n mi tamtak ngei a mindam</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8:14-17</ref>; <ref loc="LUK 4:38-41">Luk 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Jisua le a ruoisingei, Jacob le John telsân Synagog renga an jôka, male Simon le Andrew ina rangin an thengpata. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>Simon tarpi hah ritun damloiin jâlmuna a lei oma; Jisua ava tungin chu harenghan, amanu damloi roi hah an lei rila. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>Amanu kôm han a sea, a kuta a mutua, sanin a kaithoia. Amanu mintun hah a dama, male amanu han an sin a tho pe ngei zoi.<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Masuole chu kholoi ahong nia male nisa ahong tâkin chu, mingeiin Jisua kôm damloi murdi le ramkhori sûr ngei an hong tuonga. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Khopui sûnga mingei nâm inkot kôla an hong intûpa. <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>Jisua'n ri jât tamtak ngei a mindama male ramkhori tamtak a rujûlpaia. Ramkhoringei han ama an riet sikin, ite an ti rangin phal ngei mak.<verse eid="MRK 1:34"/></para>
  <para style="s">Jisua'n Galilee rama thurchi a misîr</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luk 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Anangtûk jînga chu avâr mân rengin Jisua ânthoia, in renga hah a jôka. Khopui renga mun inthimna a sea, mahan chubaithona ava manga. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>Hannirese Simon le a champuingei han ama an hong roka, <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>male an va mu lehan, a kôm, “Mitinin nang an rok,” an tipea.<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>Hannirese Jisua'n an kôm, “Hi revêla khuo dangngeia khom hin ei se ngêt rang ani. Hi ngei hin khom thurchi ki misîr rang anâng ani, maha ku juongna abi ani sikin,” tiin a thuona.<verse eid="MRK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39"/>Masikin synagogngeia thurchi misîrin le ramkhoringei rujûlpaiin Galilee ram pumpuia a chai zoia.<note caller="-" style="x"><char style="xo" closed="false">1:39: </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref>; <ref loc="MAT 9:35">9:35</ref></char></note><verse eid="MRK 1:39"/></para>
  <para style="s">Jisua'n mi a mindam</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8:1-4</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Jisua kôm mi inkhat vun ri dôn a honga, khûkinbilin, male san rang a ngêna, “Nu nuomin chu mi ni minthieng thei,”<note caller="+" style="f"><char style="fr" closed="false">1:40: </char><char style="fk" closed="false">mi ni minthieng thei: </char><char style="ft" closed="false">Hi ri hih balamin mi inthiengloiin bê ani.</char></note> a tia.<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>Jisua'n inriengmunân<note caller="+" style="f"><char style="fr" closed="false">1:41: </char><char style="fq" closed="false">inriengmu; </char><char style="ft" closed="false">miziek senkhat ngei an dôn chu </char><char style="fqa" closed="false">taksina.</char></note> asipa, male a kut ahong sôna, male a tôna, “Ka nuom,” hong, “Inthieng ta roh!” tiin a thuona. <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>Voikhatrengin a pangphâr hah ahong boi kelena, male ânthieng zoi. <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>Jisua'n chongnazatin a tipea, a tîr kelena, <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>a kôm a ti suole, “Rangâi roh, hi roi hih tute ril tet no roh duo. Hannirese ochai kôm thengpat inla va min mu roh; masuole chu mitinin nên thieng nôk zoi ti an riet minthârna rangin Moses chongpêka inbôlna pêk ranga ati hah pêk roh” a tipea.<note caller="-" style="x"><char style="xo" closed="false">1:44: </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Och 14:1-32</ref></char></note><verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>Hannirese amapa hah a jôka, ma thurchi hah muntina a phuong minzara. Adikin, a ril minlum rai sikin Jisua chu ânlangin khopuia lût thei khâi maka, mun inthim ngeia a va oma, male muntin renga a kôm mingei an hong ngâi ani.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s">Jisua'n phalkhatthi a mindam</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9:1-8</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Sûn tômte suole chu Jisua Capernaum taka a se nôka, male ina a om ti roi ânthanga. <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>Masikin mi tamtak an hong intûpa, inkhâr pêntieng luo mun tong khâi maka. Jisua'n an kôm thurchi a misîr lâitakin <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>phalkhatthi inkhat mi minlîn a kôm an hong rojôna. <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Nikhomrese loko an tam rai sikin a kôma hong tungpui thei mak ngeia, masikin Jisua omna ridîn taka inchung an phêna. An phên zoiin chu phalkhatthipu hah a jâmpher leh an juong musuma. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>Jisua'n an taksôn tie hah a mua, phalkhatthipa kôm han, “Ka nâipasal, ni sietnangei ngâidam ani zoi,” a tia.<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>Balam minchupungei senkhat ma muna insung ngei han an mindonna, <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>“Hi mi hin ithomo hi anga a chong ngam hi? Pathien a rilminsiet ani! Pathien vai ke sietnangei ngâidam thei!” an tia.<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>Harenghan Jisua'n an mindon hah a rieta, an kôm, “Ithomo ma anghan nin mindonna? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>Phalkhatthi kôm han, ‘Ni sietnangei ngâidam ani zoi,’ ti le ‘Inthoi inla, na jâmpher luok inla lôn ta roh,’ ti hih kho hi mo a ti abai uol? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>Hanchu, philchung hin Miriem Nâipasal'n sietnangei ngâidam theina racham a dôn ti nangni lei min mu rong” a tia. Masikin phalkhatthi kôm han, <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>“Inthoi inla, na jâmpher luok inla, ni ina se ta roh!” tiin nang ki ril a tia.<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>An rêngin an enchungchakin ama hah ânthoia, a jâmpher a luoka, a se kelen zoia. An rêngin an kamâm sabaka, Pathien an minpâka, “Hima anga neinun hih chu la mu tet ngâi mak me!” an tia.<verse eid="MRK 2:12"/></para>
  <para style="s">Jisua'n Levi a koina</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9:9-13</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>Jisua Galilee dîl panga a se nôka. Loko ngei a kôm an sea, male a minchu ngei phut zoia. <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>A sena sumrusuongpa Levi Alphaeus nâipasal, a office taka ânsung a mua. Jisua'n a kôm, “Ni hong jûi roh,” a tipea. Levi ânthoia, male ama a jûi zoi.<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>Chomolte suole chu Levi ina<note caller="+" style="f"><char style="fr" closed="false">2:15: </char><char style="fq" closed="false">Levi ina; </char><char style="ft" closed="false">aninônchu </char><char style="fq" closed="false">ama ina </char><char style="ft" closed="false">(ma hah Jisua) in.</char></note> bukhalâi an ota. Sumrusuong ngâi mi tamtak le mitelloingei Jisua an jûia, male mi tamtakin Jisua le a ruoisingei bukhalâi otna dosânga an inchela. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Phariseengei le Balam minchupungei senkhatin, Jisua chu mitelloingei le sumrusuongpungei leh bu a nêk an mûn chu a ruoisingei kôm, “Khoitho mo ma anga mingei lâia bu a nêk?” tiin an rekela.<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>Jisua'n an chong hah a lei rieta, an kôm, “Adamngeiin doctor nâng ngâi mak ngeia, aniatachu adamloi ngei chu doctor an nâng ngâi. Midikngei ralam ranga juong ni ma-unga, mitelloingei ralam ranga juong ke ki ni,” tiin a thuona.<verse eid="MRK 2:17"/></para>
  <para style="s">Bungêi chungroia chongrekel</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9:14-17</ref>; <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Zora khat chu Baptispu John nûkjûingei le Phariseengei han bu an ngêia. Mingei senkhatin Jisua kôm an honga, a kôm, “Ithomo John nûkjûingei le Pharisee ruoisingei hi bu an ngêi ngena, aniatachu nu ruoisingei hi an ngêi ngâi loi?” tiin an rekela.<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>Jisua'n an kôm, “Inneina khuolmingei ha bungêi rangin nin lei sabei mini?” Ni thei no ni! Mâkpa hah an kôma aom kâr chu bungêi no ni ngei. <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>Hannirese an kôm renga mâkpa ha an tuong pai nikhuo la tung a ta, ma tika chu la ngêi an tih.<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>“Tutên puon muruo chitphonân puon thar relek mang ngâi mak ngei, mang ngân khom senla athar han amuruo hah minchîrup a ta chet uol atih. <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>Tutên uain thar khom savun ûm muruo taka thun ngâi mak ngei, thun ngân khom senla, uain thar han savun ûm hah mût khoi a ta, uain le savun ûm le mangmunboi chang atih. Manêkin, uain thar chu savun ûm thara ngêt thun nîng atih” tiin a thuona.<verse eid="MRK 2:22"/></para>
  <para style="s">Sabbathni chungroia chongrekel</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12:1-8</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">2:23: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 23:25">Bal 23:25</ref>
      </char>
    </note> Sabbathnin Jisua bubilngei senkhata a lôna. A ruoisingeiin ama leh an lôn pumin buvûingei ha an china <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Masikin Phariseengeiin Jisua kôm, “En ta, nu ruoisingeiin Sabbathnia an tho hi! Mahi ei Balamin akhap ani,” an tia.<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">2:25,26: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 21:1-6">1 Sam 21:1-6</ref>
      </char>
    </note> Jisua'n an kôm, “David'n sâk rang ânsam lâihan a tho hah nin la pore tet ngâi loi mini? Ama le a miriemngei an vonchâm sabaka, <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/><note caller="-" style="x"><char style="xo" closed="false">2:26: </char><char style="xt" closed="false"><ref loc="LEV 24:9">Och 24:9</ref></char></note> masikin David han Pathien ina a lûta, Pathien kôma pêksai vâipôl hah a sâka. Mahi Abiathar Ochai Inlaltak a chang lâihan ani. Ei Balam dungjûiin chu ha vâipôl hah Ochaingei vai ke an sâk thei ngâi ani, aniatachu David'n a sâka male a miriemngei khom a sem ngei sa.”<verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>Male Jisua'n, “Sabbathni chu miriemngei sana ranga sin ania, miriem chu Sabbathni ranga sin nimak. <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>Masikin Miriem Nâipasal hih Sabbathni a Pumapa khom ani” tiin chong a khâr zoi.<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s">Jisua'n kut phalkhatthi a mindam</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12:9-14</ref>; <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>Hanchu Jisua ha Synagog a se nôka, mahan mi inkhat a kut phalkhatthi a lei oma. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Sabbathni ani sikin Jisua râlngeiin a tho minchâia an nôn theina rangin; Sabbathni mi a mindam pupui mo tiin mi senkhat ngeiin an en richika. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>Jisua'n kut phalkhatthi kôm han, “Moton tieng hong inding roh,” a tipea. <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>Hanchu Jisua'n mingei kôm han, “Ei Balamin Sabbathnin imo ei tho rangin mi phal? San rang mo, aninônchu minna rang mo? Mi ringna mojôk rang mo, aninônchu mi minmang mo?” tiin a rekel ngeia.</para>
  <para style="p" vid="MRK 3:4">Hannirese ite ti mak ngeia. <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>Jisua'n an tieng a en ngeia a taksi oka, aniatachu an mulungngar raina le an dikloi raina hah a riet sikin asân a jâm a manzala. Hanchu amapa kôm han, “Nu kut lâng roh” a tipea. A kut a lânga male a dam nôk zoia. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Masikin Phariseengei hah synagog renga an jôka, Herod pâla mi senkhatngei leh an intonga, Jisua an that rang lam mintuonangei an sin zoia.<verse eid="MRK 3:6"/></para>
  <para style="s">Dîl panga lokongei</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>Jisua le a ruoisingei ha Galilee dîl tieng an se kelena, male loko tamtakin ama an jûi sa. Anni ngei ha Galilee ram renga, Judea ram renga, <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>Jerusalem renga, Idumea ram renga, Jordan râl nisuo tieng renga, male Tyre le Sidon khopuilienngei kôlrevêla hong ngei an ni. Hi mingei murdi hih Jisua neinun tho ngei an lei riet sika hong an ni. <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>Lokongei an tam rai sika han ama an neng loina rangin Jisua'n a ruoisingei kôm, ama rang rukuong inkhat lei dar rangin chong a be ngeia.<note caller="-" style="x"><char style="xo" closed="false">3:9,10: </char><char style="xt" closed="false"><ref loc="MRK 4:1">Mk 4:1</ref>; <ref loc="LUK 5:1-3">Luk 5:1-3</ref></char></note> <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>Mi tamtak a mindama, male ana ngei murdi ama an tôn theina rangin an inbûmlula. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Male an sûnga ramkhori dôn ngei khomin ama an mu racham inbokin, “Nangma ha Pathien Nâipasal ni ni!” tiin an iniek ngâi.<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>Jisua'n ramkhoringei kôm han, tumo ani ha tute kôm an misîr loina rangin chongnazatin, chong a pêk ngei zoi.<verse eid="MRK 3:12"/></para>
  <para style="s">Jisua'n Tîrton sômleinik ngei a thangna</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10:1-4</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>Hanchu Jisua muol chunga a kala, ama'n a nuom ngei kai a koia. Anni ngei ha an jûia, <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>male sômleinik ngei a thanga, “Mangei ha tîrtonngei tiin riming a phuoa, an kôm, ko kôma om rangin nangni ka thang zoi ani,” male, “Thurchi misîr rang khomin nangni tîr suok ka ta, <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>male ramkhoringei rujûlpai theina rachamneina khom dôn nin tih,” tiin a ril ngeia.<verse eid="MRK 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>Sômleinik a thang ngei ha hi ngei hih an ni: Simon (Jisua'n, Peter tia riming a phuo pe ha); <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>Zebedee nâipasal Jacob le a nâipa John (Jisua'n, Boanerges tia riming a phuo pe ngei ha, maha aomtie chu “Khuonri Miriemngei tina ani”); <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>Andrew, Philip, Bartholomew, Matthew, Thomas, Alphaeus nâipasal Jacob, Thaddeaus, Canan mi Simon (an ram lungkham le inpâkpui ngâipu,) <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>male a minsûrpu Judas Iscariot.<verse eid="MRK 3:19"/></para>
  <para style="s">Jisua le Beelzebul</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mat 12:22-32</ref>; <ref loc="LUK 11:14-12:10">Luk 11:14-23—12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>Hanchu Jisua ha in tieng a kîr sir zoia. Lokongei hah an juong intûp nôka, Jisua le a ruoisingei ha sâknêk zora luo man mak ngeia. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>Mingeiin, “Achâng ke ani zoi!” an ti roi ha a insungmingei an riet lehan, ama tuong rangin an inthoka.<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>Balam minchupu senkhat Jerusalem renga juong ngei han, “A sûnga Beelzebul a dôn ani! Ramkhoringei ulientak kêng, ramkhori rujûlpai theina rangin sinthotheina a kôma pêk ngâi” an tia.<note caller="-" style="x"><char style="xo" closed="false">3:22: </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>Masikin Jisua'n anni hah a koia, chongmintêkin a chongpui ngeia; “Kho angin mo Soitan'n Soitan a rujûl thei ranga? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>Rambung khom athenin apâlin insenin inkhat le inkhat an indoi inlômin chu, ma rambung hah inlet atih. <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>Insûngkuo khom athenin apâlin insenin inkhat le inkhat an indoi inlômin chu, ma insûngkuo hah inlet atih. <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>Masikin Soitan rêngram khom athenin apâlin an insenin chu, ma hah asôt dier no nia, inlet a ta male ânmang rang ani.<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>“Tutên mi rât ina lûtin a neinunngei lâk pe thei ngâi mak ngei, mi rât hah an khitbel masa vaiin ke; a neinunngei an muruk thei ngâi.<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>“Adiktakin nangni ki ril mingei hih an sietnangei murdi le asaloi neinunngei an ti ngei<note caller="+" style="f"><char style="fr" closed="false">3:28: </char><char style="fq" closed="false">asaloi neinunngei an ti ngei; </char><char style="ft" closed="false">aninônchu </char><char style="fq" closed="false">Pathien doia asaloi neinunngei an ti ngei.</char></note> murdi chu la ngâidam thei nîng a ta. <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>Aniatachu tukhom Ratha Inthieng doia asaloi neinunngei a ti ngei hah chu ngâidamin om tet no ni, kumtuonga sietna a sin ani sikin” a tia.<note caller="-" style="x"><char style="xo" closed="false">3:29: </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luk 12:10</ref></char></note> <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>(Mahi Jisua'n mingei senkhatin, “Ratha saloi a dôn” an ti sika a ti ani.)<verse eid="MRK 3:30"/></para>
  <para style="s">Jisua nû le lâibungngei</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12:46-50</ref>; <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>Hanchu Jisua nû le lâibungngei an hongtunga. Khalâia an indinga, ama koi rangin mi an tîra. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>Jisua rihîlin lokongei an insunga, male ha ngei han a kôm, “En roh, Nu nû le na lâibungngei le na sarnungeiin nang an roka, khalâia son an oma, nang intongpui rang an nuom,” an tipea.<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>Jisua'n an kôm, “Tu mo ku nû? Tu ngei mo ka lâibungngei?” Tiin a thuona. <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>A rihîla an sung ngei hah a en ngeia, an kôm, “En ngei roi! Hi ngei hih ku nû le ka lâibungngei an ni! <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>Tukhom Pathien nuom lama sintho ngei kai chu ka lâibungngei, ka sarnungei, le ku nûngei an ni” a tia.<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s">Sachirethêpa chongmintêk</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13:1-9</ref>; <ref loc="LUK 8:4-8">Luk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>Galilee dîl kôla Jisua'n a minchu nôka, mipuingei a kôma juong intûp ngei hah an tam rai sikin rukuonga a chuonga, ânsunga, mipuingei hah chu tui rakham asortea tânga han an indinga.<note caller="-" style="x"><char style="xo" closed="false">4:1: </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">Luk 5:1-3</ref></char></note> <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>Anni ngei minchuna rangin chongmintêkngei mangin neinun tamtak ngei a misîr pe ngeia, an kôm han:<verse eid="MRK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3"/>“Rangâi roi! voikhat chu mi inkhatin burît rangin a sea. <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>Loia han sachi a rethea, senkhat lampui kôla achula, vângei an honga male an sâk ripa. <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>Senkhat lungpherpha pil ânphâna chunga achula, pil ânphân sikin ahong mông kelena, <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>Hanchu, nisa ahong insângin chu akung innoinar ngei ha a em minjuota, aruzung amathâk hah ânthûk loi sikin akângrip kelena. <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>Senkhat chu riling kâra achula, riling han akungngei ha adîpa, male inra thei khâi mak ngei. <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>Aniatachu senkhat chu pil sana achula, akungngei ahong kêia, ahong insôna, avûia: senkhat sômthumin, senkhat sômrukin, male senkhat raza khatin ahong pung zoi” a tia.<verse eid="MRK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9"/>Male Jisua'n a chongkharnân an kôm “Kuor nin dônin chu rangâi roi!” a tipe ngeia.<verse eid="MRK 4:9"/></para>
  <para style="s">Chongmintêkngei neinunkhîn</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat 13:10-17</ref>; <ref loc="LUK 8:9-10">Luk 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>Jisua athenin aom lehan, a ruoisingei sômleinik le midang senkhat ngei ma chong riet ngei han a kôm an honga male ha chongmintêkngei hah rilminthâr pe ngei rangin an ngêna. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>Jisua'n an kôm, “Pathien Rêngram chonginthup riettheina nin kôm pêk ani zoi.” Hannirese, “Midangngei pêntienga omngei rangin chu, neinunngei murdi chongmintêkngei vaiin misîr pe an nia,<verse eid="MRK 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MRK 4:12"/>‘Masikin an en, an en khomin an mu</para>
  <para style="q2" vid="MRK 4:12">loina rangin le;</para>
  <para style="q1" vid="MRK 4:12">an rangâi an rangâi khomin,</para>
  <para style="q2" vid="MRK 4:12">an rietthei loina rangin.</para>
  <para style="q1" vid="MRK 4:12">Ma anghan an thôn chu, Pathien tieng inhei nôk an ta,</para>
  <para style="q2" vid="MRK 4:12">male ama'n lei ngâidam ngei thei atih’” a tia.<note caller="-" style="x"><char style="xo" closed="false">4:12: </char><char style="xt" closed="false"><ref loc="ISA 6:9">Isa 6:9</ref>,<ref loc="ISA 6:10">10</ref> (LXX)</char></note><verse eid="MRK 4:12"/></para>
  <para style="s">Jisua'n sachirethêpa chongmintêk a rilminthârna</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat 13:18-23</ref>; <ref loc="LUK 8:11-15">Luk 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>Hanchu Jisua'n an kôm, “Hi chongmintêk hih nin rietthei loi mo? Hanchu, kho angin mo chongmintêk dangngei ngân khom nin rietthei ranga? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>Sachirethêpa han Pathien chong a rethe ngâi. <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>Mi senkhat ngei chu, sachi lampui kôla chul angin an nia; chong hah an riet harenghan, Soitan a honga an mulungrîla om hah a lâk pe ngei ngâi. <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>Midang senkhat ngei chu sachi lungpherpha chunga chul angin an ni. Thurchi hah an riet harenghan, râisântakin an pom kelen ngâia. <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>Hannirese, ruzung inthûk an mathâk loi sikin om sôt ngâi maka. Thurchi sika intakna mini nuomlona mini, ahong om lehan chu anin let nôk kelen ngâi. <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>Mi senkhat ngei chu sachi riling kâra achul angin an ni. Ma ngei hah chu thurchi rangâipu ngei hah an nia, <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>aniatachu an ringnuna kângdoinangei, rammuol hoina le neinangei le jât dadang an ôinangei ahong lûta chong hah adîpa, amara musuo ngâi mak. <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>Hannirese mi senkhat ngei chu pil asana achul ngei angin an ni. Chong hah an rieta, an poma, male ânra ngâi: senkhat sômthumin, senkhat sômrukin, senkhat raza khatin an hong pung zoi, a tia.”<verse eid="MRK 4:20"/></para>
  <para style="s">Bêl nuoia châti</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luk 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>Jisua'n a chong a la zombanga, “Tumo châti hongchôia adarna muna dar loiin, bêl nuoia mo, aninônchu jâlmun nuoia mini a dar ngâia? adarna munna ke an va dar ngâi nimak mo?<note caller="-" style="x"><char style="xo" closed="false">4:21: </char><char style="xt" closed="false"><ref loc="MAT 5:15">Mat 5:15</ref>; <ref loc="LUK 11:33">Luk 11:33</ref></char></note> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>Ânthup murdi tâng la musuo nîng a ta, hîpa om ngei murdi lîkpai la nîng atih.<note caller="-" style="x"><char style="xo" closed="false">4:22: </char><char style="xt" closed="false"><ref loc="MAT 10:26">Mat 10:26</ref>; <ref loc="LUK 12:2">Luk 12:2</ref></char></note> <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>Hanchu, kuor nin dônin chu rangâi roi!” a tia.<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>Hanchu Jisua nanâkin an kôm, “Nin chong rangâi hih asadimin mindon roi! Midangngei nin jêkna balamngei nanâk hah Pathien'n nangni jêkna rangin mang a tih, manêkin nangni min rik pe uol a tih.<note caller="-" style="x"><char style="xo" closed="false">4:24: </char><char style="xt" closed="false"><ref loc="MAT 7:2">Mat 7:2</ref>; <ref loc="LUK 6:38">Luk 6:38</ref></char></note> <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>Tu tukhom imini dônpu ngei chu bôk pêk sa nîng a ta, male tukhom ite dôn loi ngei chu an dôn viette khom ha lâk pe rip nîng atih,” a tia.<note caller="-" style="x"><char style="xo" closed="false">4:25: </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">Luk 19:26</ref></char></note><verse eid="MRK 4:25"/></para>
  <para style="s">Chimu ânsôn chongmintêk</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>Jisua'n thurchi a la misîr banga, an kôm, “Pathien Rêngram chu hi anghin ani.” Mi inkhatin a loia chimu a rethea. <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>Hanchu a sea, a van ngama jânna a inna, ânthoia sûn ngei ha a va manga, a riet loi kârin chimu hah ahong kêia, ahong insôn zoia. <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>Pil ha athenin akungngei hah aminsôna, amara amin dôna; amotona akung ahong inlang ngâi, hanchu avûia, male anûktaka aramala sip buvûi ahong oma. <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>Bu hah amin tena chu, ha mi han ât zora ahong tung zoi sikin a kôite lâkin bu ât aphut ngâi anghan ani, a tia.<note caller="-" style="x"><char style="xo" closed="false">4:29: </char><char style="xt" closed="false"><ref loc="JOL 3:13">Joel 3:13</ref></char></note><verse eid="MRK 4:29"/></para>
  <para style="s">Ancham ru chongmintêk</para>
  <para style="r">(<ref loc="MAT 13:31-32">Mat 13:31-32</ref>; <ref loc="LUK 8:11-15">Luk 8:11-15</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>Jisua'n an kôm, “Pathien Rêngram hih imo a-ang ei ti rang ân zoi? Khoi chongmintêk mangin mo ei rilminthâr rang ani zoi? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>Mi inkhatin ancham ru rammuola chimu murdi lâia achîntak ramal khat a lâka, pila a tua. <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>Chomolte suole chu ahong mônga, chimu murdi lâia alientak ahongni ngâi. Machang lientak ngei ahong dôna, male vângei an honga male adâilîm han rubungei an phana mahan an riek thei ang ha ani” a tia.<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>Ma anghin Jisua'n mingei kôm han chongmintêk tamtak mangin, an rietthei rang do-dôrin a thurchi a misîr pe ngei ngâia. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>Chongmintêk niloiin chu an kôm, thurchi misîr ngâi maka; hannirese, a ruoisingei leh vai an om zorân chu jâttin a rilminthâr pe ngei ngâi ani.<verse eid="MRK 4:34"/></para>
  <para style="s">Jisua'n phâivuopui a mindâingang</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8:23-27</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>Mani nanâka han kholoi ahongnin chu Jisua'n a ruoisingei kôm, “Dîl râl tieng son vân kân ei ti u” a tia. <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>Masikin lokongei ha an mâka; Jisua a lei insungna rukuonga han ruoisingei hah an lûta, ama khom an tuonga. Mahan rukuong dangngei khom an om sa. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>Inningloi rengin phâivuopui râttak ahong thoa, tuidârinsok khom hah rukuonga a lûta asip vâng zoia. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>Jisua chu lukham khamin rukuong remei tienga han a lei ina. Ruoisingei han an kaithoia male a kôm, “Minchupu kin thi rang ani zoi, itên ni mindon loi mini?” an tia.<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>Jisua ânthoia, phâivuopui hah a ngoa, “Mong roh!” male tuidârinsok kôm han, “Omchien roh!” a tia. Phâivuopui hah amonga, male adâingang zoi. <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>Hanchu Jisua'n a ruoisingei kôm “Ithomo ma angtaka nin chi hi? Taksônna reng nin la dônloi mo?” a tia.<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>Aniatachu an chi sabaka, male inkhat le inkhat kôm, “Hi mi hih tumo ani hi? Phâivuopui le tuidârinsok tena khomin a chong an don hi?” anin ti inlôma.<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s">Jisua'n ratha saloingei dôn mi a mindam</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8:28-34</ref>; <ref loc="LUK 8:26-39">Luk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>Jisua le a ruoisingei hah Galilee dîl râl kângkhat tieng, Gerasa ram an hong tunga. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>Jisua hah rukuong renga a hong jôk harenghan, mahan thânngei renga hong suok mi inkhatin ântôngpuia. Ha mi hah a sûnga ratha saloi dôn ania <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>male thânngeia om ngâi ani. Tutên Zingjirûi lienpa leh luo khit thei mak ngeia; <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>Vêl tamtak a kutngei le a kengei an lei khita, aniatachu a kengei an khitna Zingjirûingei le thîrkolngei hah a pot sata, a khiek chit ngâia. A rât rai sikin tutên an mene theiloi ani. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>Sûna le jâna, thânngeia le tângngeia han ân ieka, amananâkin lungngei leh an ât ngâi.<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>Alazan renga Jisua a hong mua; masikin a hong tânna, amakunga ânboka, <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>male rôl inringtakin ân ieka, “Jisua, Pathien Ânchung Tak Nâipasal, khoimo mi lo rang ni ti? Dûk mi tho tet loi rangin, Pathien rimingin nang ke ngên!” a tia. <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>(Mahi a tina abi chu Jisua'n, a kôm, “Ratha saloi amapa sûng renga hih hong jôk roh!” a lei ti zoi sika ani.)<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>Masikin Jisua'n a kôm, “Imo ni riming!” tiin arkela.</para>
  <para style="p" vid="MRK 5:9">A kôm han, “Ki riming chu ‘Mob’ kin tam sabak ani” tiin a thuona. <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>Male ha ram renga hah ratha saloingei a rujûlpai loina rangin Jisua kôm han a ngênrîta.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>Ma mun kôla muol panga han vok pâl tamtak sâk rok an oma. <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>Masikin ratha saloingei han, “Vokngei kôm son mi tîr inla, male an sûnga mi min lût roh” tiin Jisua kôm an ngêna. <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>A min se ngeia, male ratha saloingei hah amapa sûng renga an jôk paia, vokngei sûnga han an va lûta. Vokpâlngei hah anrêngin isângnik dôr an nia, anrêngin rôlsora an tânna, dîla an inchôma, an thi let zoi.<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>Vok donsûipungei hah an tânna, khopui le vokvâinamun ngeia han ma thurchi hah an va misîra. Mingei han neinun ahongtung ha en rangin an se zoia, <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>male Jisua kôm an tung lehan, ramkhoringei an sûrpu hah puon silin mulungbôk sing vanga insungin an va mua; male anrêngin an chi zoi. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Amupu ngei han ramkhori sûrpa chunga neinun ahongtung le vokngei chungroi ha mingei an lei rila.<verse eid="MRK 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17"/>Masikin anni ngei han Jisua hah an ram mâk rangin an ngên zoia.<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>Jisua rukuonga a chuong rangtôn ramkhoringei sûrpa han Jisua kôm, “No kôm hong rong ba!” tiin a ngêna.<verse eid="MRK 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19"/>Hannirese Jisua'n phal maka. Manêkin, “Ni insûngmingei kôm senla, Pumapa'n sin nang a tho pe tie le idôrmo nang lungkham tie hih va ril ngei roh” a tipea.<verse eid="MRK 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20"/>Masikin amapa hah a sea, Khopui Sôm ngei han a chaia, Jisua'n ata ranga sin a tho pe ngei hah a misîra, ha a misîr a riet ngei murdi'n kamâmruoi sabak an tia.<verse eid="MRK 5:20"/></para>
  <para style="s">Jairus nâinupang le Jisua puonmor tôn nuvengtenu</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9:18-26</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>Jisua'n rukuong leh dîl râl kângkhat tieng rakânin a se nôka, dîl panga loko tamtak a kôm an hong intûpa. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Synagog taka ulienpu a riming Jairus a hongtunga, male Jisua a mu lehan, Jisua ke kunga ânboka, a kôm, <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>male “Ka nâinupangte hih ana sabaka. Masikin rangâihoitakin juong inla, a hong dam nôka a ring theina rangin a chunga nu kutngei ni juong minngam pe roh!” tiin a ngênrîta.<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>Hanchu Jisua hah ama lehan an sea. Loko tamtakin an jûia, an ep rai sikin an innengin an innenga.<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>Mahan nuvengte inkhat kum sômleinik thisuoka damloi a oma, <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>doctorngei tamtakin an donsûi suonûk khomin la dam thei maka. A sum dôn murdi a heklet zoia, hannirese dam nêkin inrikin ânrik pe uola. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>Hanu han Jisua chungroi a rieta, masikin lokongei kâra Jisua nûka a honga, <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>a mulungrîlin, “A puonngei luo khom tôn inlang, dam kelen ki tih” a tia.<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>Amanu han a puonmor a tôna, male a thisuok ha harenghan among pita; a natna hah mindam ani zoi tiin, ânriet kelen zoia. <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>Jisua'n a sûng renga sinthotheina ajôk ti a riet kelena, masikin lokongei tieng a hônheia, an kôm, “Tumo ku puonngei a tôn?” Tiin a rekel ngeia.<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>A ruoisingeiin a kôm, “Lokongeiin madôr nang an neng hih nu mu nimak mo; itho mo tumo ku puon a tôn ni ti hih?” an tipea.<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>Hannirese Jisua'n chu a puon tônpu mu rangin a en titira. <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>nuvengtenu han a chunga neinun ahongtung hah ânrietin chu, chi leh innîk pumin a honga, a ke kunga khûkinbilin, male a thurchi hah adiktakin a ril leta. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>Jisua'n a kôm, “Ka nâinupang, na taksônnân nang amindam zoi, rathânngamtakin senla, na natna renga hong damriem ta roh,” a tipea.<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>Jisua ala chonglâitakin, thangtheipungei senkhat Jairus in renga an honga, Jairus kôm, “Na nâinupang chu athi suo zoi, ithomo Minchupu na la minjêl banga?” an tia.<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>Jisua'n chu an chong hah lunghâng<note caller="+" style="f"><char style="fr" closed="false">5:36: </char><char style="fq" closed="false">lunghâng tho loi; </char><char style="ft" closed="false">aninônchu </char><char style="fq" closed="false">kuor inkhat vaia riet niloi.</char></note> tho maka, Jairus kôm han, “Chi nônla, iem ngit roh” a tipea. <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>Hanchu Peter, Jacob le a nâipa John telloin chu tute ama jûi rangin phal maka. <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>Jairus ina an va tungin chu, Jisua'n rahang râttaka chap ngei le an ieka, ânrum ngei hah a va mu ngeia. <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>In sûnga a lûta, an kôm, “Itho mo nin chapa? Ithomo nin inngûia? Hi nupangte hi athi nimaka a in kêng ani!” a tia.<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>Anni han ama an munuisana, masikin an rêngin a nottuor ngei leta, nupangte a nû le a pa male a ruoisi inthum ngei leh nupangte jâlna khâltana han an lûta. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>Nupangte kut hah a sûra male a kôm, <char style="tl">“Talitha koum”</char> a tia, maha, “Nupangte, inthoi roh nang ki ti!” tina ani.<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>Hanchu, ha nupangte hah harenghan a hong inthoia, a lôn thei kelen zoia. (Amanu hah kum sômleinik nupangte ani.) Ha anghan ahongni lehan, an kamâm sabaka. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>Aniatachu Jisua'n tute ril tet loi rangin chongpêk inngartak a pêk ngeia, male “An kôm han a sâk rang imakhat pêk roi,” a tia.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s">Jisua hih Nazareth taka hengpaiin aom</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat 13:53-58</ref>; <ref loc="LUK 4:16-30">Luk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>Jisua'n ha mun hah a mâka, a omna ngâi khopui tieng a se nôka, a ruoisingei khomin an jûi tita. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Sabbathnin chu Synagog taka mi a minchua. Mahan mi tamtak an oma; male a chongril hah an riet lehan anrêngin kamâm aom tatak an tia, “Hi mi hin hi ngei nâm hih kho renga mo a man hi?” an tia. “A kôm, khoi vârna mo pêkin aom hih? Kho angin mo sininkhêlngei a sin thei hi? <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Mary nâipasal, mistri sin ngâi, a lâibungngei khom Jacob, Joseph, Juda le Simon ngei nimak mo? A sarnungei khom ei kôma an om ngâi nimak ngei mo?” an tia. Male chu ama hah an hengpai zoia.<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>Jisua'n an kôm, “Dêipungei chu an omna ngâi khopui le a sûngsuokngei le a insûngmingei lâia tiloiin chu muntina an jâ ngei ngâi a tia.” <note caller="-" style="x"><char style="xo" closed="false">6:4: </char><char style="xt" closed="false"><ref loc="JHN 4:44">Joh 4:44</ref></char></note><verse eid="MRK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5"/>Ha muna han chu mi damloi ngei tômte chunga a kutngei minngamin a mindam tiloiin chu ite sininkhêlngei sin thei khâi mak. <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>Mingei han taksônna an dôn loi sikin a jâmminzal sabaka.</para>
  <para style="s" vid="MRK 6:6">Jisua'n ruoisi sômleinik ngei a tîrsuokna</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Mat 10:5-15</ref>; <ref loc="LUK 9:1-6">Luk 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Hanchu Jisua'n ha revêla khuongei han a chai titira, mingei ha a minchu tira. <verse eid="MRK 6:6"/><verse number="7" style="v" sid="MRK 6:7"/>Ruoisi sômleinik ngei hah a koi mintûp ngeia inik, inikin a tîrsuoka. Ratha saloingei chunga rachamneina a pêk ngeia, <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/><note caller="-" style="x"><char style="xo" closed="false">6:8-11: </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luk 10:4-11</ref></char></note> male an kôm, “Nin khuolchaina khiengrol tiloiin chu ite vâipôl khom, kutdo choli khom, nin pepngeia sum khom chôi no roi. <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>Kebunngei chu bun ungla, hannirese, kâncholi inshak chu chôi no roi” tiin chong a pêk ngeia. <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>Amananâkin an kôm, “Nangni an lei modômna ina han om ungla ma mun hah nin mâk, mâka chu madên han om tit roi. <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/><note caller="-" style="x"><char style="xo" closed="false">6:11: </char><char style="xt" closed="false"><ref loc="ACT 13:51">Sin 13:51</ref></char></note> Hanchu tu khopui khom mingeiin nangni an modôm noa, nin chong an rangâi nônchu mâkrak ungla, nin ke rabab akop ngei hah không liei roi. Maha anni rangin inning roi tina nîng atih.”<verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>Masikin an sea, male mingeiin an sietnangei renga an insîr theina rangin thurchi an misîra. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>Ramkhoringei tamtak an rujûl pâia, male damloi tamtak ngei olive sariek an pola an mindam ngei zoi.<note caller="-" style="x"><char style="xo" closed="false">6:13: </char><char style="xt" closed="false"><ref loc="JAS 5:14">Jak 5:14</ref></char></note><verse eid="MRK 6:13"/></para>
  <para style="s">Baptispu John thina roi</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14:1-12</ref>; <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:14,15: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:14">Mat 16:14</ref>; <ref loc="MRK 8:28">Mk 8:28</ref>; <ref loc="LUK 9:19">Luk 9:19</ref></char>
    </note>Hanchu Jisua riming muntina ânthang zit zoi sikin Rêng Herod'n<note caller="+" style="f"><char style="fr" closed="false">6:14: </char><char style="fk" closed="false">Rêng Herod: </char><char style="ft" closed="false">Herod Antipas, Galilee rama roijêkpu.</char></note> a lei rieta. Mingei senkhatin chu, “Baptispu John hah a hong ring nôk zoi! Masika han hi sininkhêlngei sin theina ranak hi a dôn ani,” an tia.<verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>Nikhomrese, adangngeiin chu, “Ama hih Elijah ani” an tia.</para>
  <para style="p" vid="MRK 6:15">Midangngei an ti nôk chu “Tiena dêipungei angin, ama hih dêipu inkhat ani” an tia.<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>Mahah a lei rieta, Herod'n chu, Baptispu John ani! “A lu ka tana nikhomrese, a hong ring nôk ani!” a tia. <verse eid="MRK 6:16"/><verse number="17" style="v" sid="MRK 6:17"/>Herod lelên John hah a minsûra, khitbelin jêl ina a lei khum ani. Herod'n ma anga a thona chu, Herodias hi a nâipa Philip lômnu nikhomsenla a lômnu a minchang sika ani.<note caller="-" style="x"><char style="xo" closed="false">6:17,18: </char><char style="xt" closed="false"><ref loc="LUK 3:19">Luk 3:19</ref>,<ref loc="LUK 3:20">20</ref></char></note> <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>John'n Herod kôm, “Na nâipa lômnu in ne neipui nôk hih Balam nimak!” tiin a lei ril tit ngâia.<verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>Masikin Herodias han John a mumâka that ngêt rang a bôka hannirese, Herod sikin that thei maka. <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>Herod'n John hah mi sa le mi inthieng ani ti a riet sikin a chia, masikin a mojôk ngâi ani. John chongril a riet racham asân injêlpui ngâi khomsenla, a chongril rangâi rang a nuom ngâi ani.<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>Azoinataka chu Herod suokni ahong tungin chu, sorkar ulienngei, râlmi ulienngei le Galilee rama mi lienngei rangin bukhalâi otna a minsûka, ha ni han chu Herodias'n chuminrên a mana. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>Herodias nâinupang<note caller="+" style="f"><char style="fr" closed="false">6:22: </char><char style="fq" closed="false">Herodias nâinupang; </char><char style="ft" closed="false">Miziek senkhat ngei an dôn chu </char><char style="fq" closed="false">A nâinupang Herodias.</char></note> a hong lûta, a lâma, Herod le a khuolmingei râiaminsân pe ngei oka. Masikin rêngpa han nupangte kôm han, “Imo dôn rang nu nuom? Nu nuom tak nang pêk ki tih” a tia. <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Chonginkhâm tamtak dônin a kôm, “Kho khoi khom mi ni zong kai chu ke rêngram phalkhat tena khom nang pêk rangin chong kên khâm!” a tia.<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>Masikin nupangte hah a jôka, a nû kôm, “Imo mo ko zong rang?” tiin a va rekela.</para>
  <para style="p" vid="MRK 6:24">A nu'n, “Baptispu John lu” tiin a thuona.<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>Nupangte hah innottakin a kîra, rêngpa kôm han, “Atûn Baptispu John a lu mâirânga mi ni pêk rangin ku nuom” tiin a zonga.<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>Masikin rêngpa hah ân ngûikhak zoia, aniatachu a khuolmingei makunga inkhâmnangei a lei tho sika han mângti thei khâi maka. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>Masikin rêngpa han a rungpu inkhat a tîr kelena, John lu hong lâk rangin chong a pêka. Rungpu han ânphêt kelena, male jêl ina a sea. John lu ava tana; <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>hanchu mâirânga a hong chôia, nupangte kôm a pêka, nupangte han a nû kôm ava pêk zoia. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>Ma roi hah a ruoisingeiin an riet lehan an honga, John ruok hah an chôia, male an phûm zoi.<verse eid="MRK 6:29"/></para>
  <para style="s">Jisua'n mi isâng rangnga a vâina roi</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="JHN 6:1-14">Joh 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Tîrtonngei hah an kîr nôka male Jisua an intongpuia, male an sintho murdi le an minchu sai murdi Jisua kôm an rila. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Mingei ha ase le ahong an tam rai sikin Jisua le a ruoisingei chu bunêk zora luo man mak ngeia. Masikin an kôm, “Tho ei theivaia ei om theina rangin mun senkhata chomola nin inngam theina rang muna se rei u” a tia. <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>Masikin mun inthimngangna panin an theiviekin rukuonga an se zoia.<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>Nikhomrese, mingei tamtakin an selâi an mua, anni ngei ti an riet kelena; masikin khopuingei murdi renga mingei hah tâng tieng renga an tânna, Jisua le a ruoisingei hah an lei chomtan ngeia. <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>Jisua hah rukuong renga a juong chum lehan, loko tamtak a mu ngeia, male belri a hôlpu boi angin an ni sikin, anni ngei rangin a mulungrîla inriengmuna leh asipa.<note caller="-" style="x"><char style="xo" closed="false">6:34: </char><char style="xt" closed="false"><ref loc="NUM 27:17">Tel 27:17</ref>; <ref loc="1KI 22:17">1 Rêng 22:17</ref>; <ref loc="2CH 18:16">2 Rich 18:16</ref>; <ref loc="EZK 34:5">Ezek 34:5</ref>; <ref loc="MAT 9:36">Mat 9:36</ref></char></note> Masikin neinun tamtak ngei a minchu ngei phut zoi. <verse eid="MRK 6:34"/><verse number="35" style="v" sid="MRK 6:35"/>Kholoi ahongni lehan, a ruoisingei hah Jisua kôm an honga, male a kôm, “Mahi mun inthimngang ke ania, nisa khom ase ok zoia. <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>Mingei hih tîr pai ngei inla, male akôl kienga loingeia mo, khuongeia mo, anninanâkin an sâkruo imakhat an rochôk theina rangin” an tia.<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>Jisua'n an kôm, “Nangnin sâkruo imakhat pêk ngei roi,” tiin a thuon ngeia.</para>
  <para style="p" vid="MRK 6:37">Annin a kôm, “Anni ngei vâi theina rangin vâipôl chunga duli<note caller="+" style="f"><char style="fr" closed="false">6:37: </char><char style="ft" closed="false">duli inkhat ha tângrama om chuonsinpu sûnkhat rathaman ani (Mat 20:2 en roh.)</char></note> razannik kin va thâm rangin nu nuom mo?” tiin an rekela.<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>Masikin Jisua'n an kôm, “Vâipôl kho dôr mo nin dôn? Se ungla, va en roi” tiin a rekel ngeia.</para>
  <para style="p" vid="MRK 6:38">An dôn dôr hah an riet lehan, “Vâipôl rangnga le nga inik” tiin an rila.<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>Hanchu Jisua'n mingei nâm hah apâl apâlin sensâi ungla, durba chunga min sung ngei rangin ruoisingei a ril ngeia. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Masikin mingei hah apâl apâlin, raza khat pâlin le sômrangnga pâlin an min sung ngeia. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>Hanchu Jisua'n vâipôl rangnga ngei le nga inik hah a lâka, invân tieng tangin Pathien kôm râisânchong a rila. Vâipôl hah a khoia, mingei hah sem pe ngei rangin a ruoisingei kuta a pêk ngeia. Nga khom hah anrêngin sem ngei rangin a pêk ngei sa zoi. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>Mitinin an sâka male an khop chita. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Hanchu an sâk minieng vâipôl hâr le nga ronôi hah tabong sômleinik ruoisingeiin an rût min sipa. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>A vâi ngei mijôn hah mi ulien kai isâng rangnga an ni.<verse eid="MRK 6:44"/></para>
  <para style="s">Jisua tui chunga a lôn</para>
  <para style="r">(<ref loc="MAT 14:22-23">Mat 14:22-23</ref>; <ref loc="JHN 6:15-21">Joh 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>Lokongei a minchîn suole harenghan varâl tienga Bethsaida khuoa, a motona lei se rangin a ruoisingei rukuonga a min chuong ngeia. <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Mingei hah chonghoiin a mathân suole chu chubaitho rangin muol chunga a se zoia. <verse eid="MRK 6:46"/><verse number="47" style="v" sid="MRK 6:47"/>Kholoi ahongni lehan, rukuong hah dîl ânlâina taka aoma, Jisua chu atheivaiin tânga han aoma. <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>Phâivuo hah anôk tieng asêm sikin, a ruoisingeiin an rukuong jâp hah an mulungjîng okin a mua; masikin jîng kôlinsaluom rangtôn dîl chunga lônin an tieng a hong pana, anni ngei khêlpai<note caller="+" style="f"><char style="fr" closed="false">6:48: </char><char style="fq" closed="false">anni ngei khêlin; </char><char style="ft" closed="false">aninônchu </char><char style="fq" closed="false">an kôm kopsa.</char></note> rang angin aoma, <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>hannirese anni han tui chunga a lôn an mua. “Mirluoi kêng ani!” tiin an mindonna, male an iniek raka. <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>Ama an mu lehan an rêngin an rathatâka.</para>
  <para style="p" vid="MRK 6:50">Harenghan Jisua'n an kôm, “Hâitakin om roi!” ama'n, “Keima ke ki ni, chi no roi!” a tipe ngeia. <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>Hanchu an kôm rukuonga han a chuong sa zoia, male phâivuo hah amonga. Ruoisingei chu an kamâm sabaka, <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>mi isâng rangnga a vâina roi aomtie diktak hah an rietthei loi sikin; an mulungbôkngei han amanphâk loi ani.<verse eid="MRK 6:52"/></para>
  <para style="s">Jisua'n Genesaret taka damloingei a mindam</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Dîl râl an inkânna, Genesaret rama an tunga, mahan an rukuong an thunga. <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>Rukuong renga an chuma, mingeiin harenghan Jisua ani ti an riet kelena. <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>Ha ram pumpuia mingei hah an hong tân leta; a omna an rietna tena a kôm damloingei an jâmphera jâl pumin an hong rojôna. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>Male Jisua a sena muntina, khuongeia mo, khopuingeia mo, loingeia mo, bazar munngeia khom damloingei an hong tuonga, a puonmor luo tôn thei rangin phalna an ngênna. Male a tôn ngei murdi chu an dam pak ani.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s">Pipungei chongmâk</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mat 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Jerusalem renga hong phariseengei le Balam minchupungei senkhat ngeiin Jisua kôla an hong intûpa. <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>Ha ngei han a ruoisingei senkhatin kut innima sâk an sâk an mua, maha, Phariseengeiin mingei an tho ranga an tipe lamtaka an rusûk loi sika ani.<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>(Phariseengei le Judangei murdi'n chu an pipungei renga an man chongmâk hah an jûia: an kutngei, balam takin an rusûk noa anin chu ite sâk ngâi mak ngeia; <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>bazar renga neinun an hong chôi ngei murdi khom an rusûk masa<note caller="+" style="f"><char style="fr" closed="false">7:4: </char><char style="fq" closed="false">bazar renga neinun an hong chôi ngei murdi khom an rusûk masa nônchu sâk ngâi mak ngei; </char><char style="ft" closed="false">aninônchu </char><char style="fq" closed="false">i-ih neinuna khom bazar renga an honga tui an inbuol masa nônchu.</char></note> nônchu sâk ngâi mak ngei. Male balam adang tamtak an man ngei hah an sûr mindet tit khom aom sa; ma ngei hah kilâtngei, bêlngei, sumsen khuriâingei, male jâlmunngei<note caller="+" style="f"><char style="fr" closed="false">7:4: </char><char style="ft" closed="false">Male jâlmunngei </char><char style="fq" closed="false">ti hih miziek senkhat ngei chu dôn mak ngei.</char></note> rusûk min sâi rang ti ngei ha ani.)<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>Masikin phariseengei le Balam minchupungei han Jisua kôm, “Ithomo nu ruoisingeiin pipungei chongmâk jôm loiin kutngei innim pumin sâk an sâk hi?” tiin an rekela.<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>Jisua'n an kôm, “Isaiah'n nin chungroi a leiphuong hah adik ani!” A miziek anghan, asarotholngei nin ni:<note caller="-" style="x"><char style="xo" closed="false">7:6,7: </char><char style="xt" closed="false"><ref loc="ISA 29:13">Isa 29:13</ref> (LXX)</char></note></para>
  <para style="q1" vid="MRK 7:6">“Hi mingei hin an chongbâingei leh min minpâka,</para>
  <para style="q2" vid="MRK 7:6">aniatachu an mulungrîlngei chu keima renga alazan ani.<verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>Miriem minchuna balamngei hah ka balamngei anghan an mindon sikin</para>
  <para style="q2" vid="MRK 7:7">chubai min mûkna hih anni rangin kâmnângloi kêng ani,</para>
  <para style="q2" vid="MRK 7:7">Pathien'n a ti, tia lei inziek anghan!”<verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>“Pathien chongpêk nin henga, miriem minchunangei nin jôm ani hi” a tia.<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>Male a la zombanga an kôm, “Nin minchuna nin jôm theina ranga Pathien chongpêkngei nin heng hi chu vârna lampui nin dôn ani hi. <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>Moses'n, ‘Nu nû le na pa jâ roh,’ male ‘Tukhom a nû mo a pa mo khomâksâm chu that ning atih,’ tiin chong a lei pêka.<note caller="-" style="x"><char style="xo" closed="false">7:10: </char><char style="xt" closed="false"><ref loc="EXO 20:12">Jôk 20:12</ref>; <ref loc="DEU 5:16">Bal 5:16</ref>; </char><char style="xt" closed="false"><ref loc="EXO 21:17">Jôk 21:17</ref>; <ref loc="LEV 20:9">Och 20:9</ref></char></note> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>Aniatachu nangni rêkin chu, mîn a nû mo, a pa mo imini san rang anângin chu ‘Ma hih Korban ani’ tiin nin minchu ngâi, (maha aomtie chu, Pathien ta ani zoi tina ani), <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>an nû mo an pa ngei rangin mo khoite sintho rangin jôt khâi ngâi mak choia. <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>Ma angdên han balam muruo nin minchu banga hin Pathien chong amin mang ngâia. Hi anga sin nin tho adang khom tamtak ala om sa” a tia.<verse eid="MRK 7:13"/></para>
  <para style="s">Miriem minnim ngâi neinunngei</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mat 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>Hanchu Jisua'n lokongei hah vêlkhat a koi nôk ngeia, an kôm, “Nin rêngin ko chong rangâi ungla, male rietthei roi. <verse eid="MRK 7:14"/><verse number="15-16" style="v" sid="MRK 7:15-16"/><note caller="+" style="f"><char style="fr" closed="false">7:15-16: </char><char style="ft" closed="false">Miziek senkhat ngeia chu, “Kuorngei nin dônin chu rangâi roi!” a tia. (4:23 en roh). </char></note> Pêntieng renga miriem sûnga lûta ama minnim thei ite omak. Manêkin miriem sûng renga hong suok ngei hi ke miriem minnim ngâi ani.”<verse eid="MRK 7:15-16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>Lokongei hah mâkin insûnga a lût lehan, ha chong hah rilminthâr rangin a ruoisingeiin an ngênna. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>Jisua'n an kôm, “Midangngei nêkin la vâr uol mak chei.” “Ite pêntieng renga nin sûnga lûtin nangni aminnim thei om mak, ti hih nin la rietthei loi mo? a tipe ngeia, <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>asikchu nin mulungrîla lût loiin, nin phûngpuia a lûta, male nin nôm sena tieng ajôk ngâi” a tia. (Ma hih Jisua'n sâkruo murdi chu ânthieng let tia minthârnân a ti ani.)<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>Male a la ti banga, “Nin sûng renga hong suok ha ke nangni minnim ngâi. <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>Asûng tieng renga, nin mulungrîl renga kêng, mindonna saloi ahong suoka nunchan saloi neinunngei tho rangin nangni ruoi ngâia, inruna, mi thatna, <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>inrêna, inruokna, saloi murdi tho nuomna; huongna, hurna, narsana, êrona, inpâkna, le inmôlna ngei aminsuok ngâi, <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>ma saloi neinunngei murdi hah nin sûng tieng renga ahong suoka, male nangni aminnim ngâi ani” a tia.<verse eid="MRK 7:23"/></para>
  <para style="s">Nuvengtenu taksônna</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>Hanchu Jisua'n Galilee ramhuol mâkin Tyre khopuilien kôla a sea. In inkhata a lûta, tutên an riet rang khom jôt maka, aniatachu ama hah inthupin om thei maka. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Nuvengte inkhat, a nâinupang a sûnga ratha saloi dôn han, Jisua thurchi a riet lehan harenghan a honga a kebula ânboka. <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>Ma nuvengtenu hah Jentail mi ania, Syria rama Phoenikia ramhuol sûnga suok ania. Amanu han a nâinupang sûnga ramkhori rujûlpai pe rangin Jisua kôm a ngênna. <verse eid="MRK 7:26"/><verse number="27" style="v" sid="MRK 7:27"/>Hannirese, Jisua'n a kôm, “Nâingei khop bak rese ngei. Nâingei bu lâk pea male uingei kôma vôr chu dik mak,” tiin a thuona.<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>Nuvengtenu han a kôm, “Pu” ani chu ani, hannirese, “nâingeiin dosâng nuoia bu ramal an mathâk hah uingeiin an sâk ngâi nimak mo!” tiin a thuona.<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>Masikin Jisua'n amanu kôm han, “Ma thuona chongbâi sikin, ni ina se nôk inla, na nâinupang chu ramkhori mâkin va mu ni ti zoi!” a tipea.<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>Amanu hah a ina a sea, a nâinupang chu ramkhori mâkin jâlmuna jâlin ava mu zoi.<verse eid="MRK 7:30"/></para>
  <para style="s">Kuorsêt chongloi Jisua'n a mindam</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>Hanchu Tyre ram renga Jisua a jôk nôka, Sidon khopui sirin Khopui sôm ngei ramhuol hah palin Galilee dîl a tunga.<verse eid="MRK 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 7:32"/>Mi senkhatin kuorsêt le chongloi a kôm an hong tuonga. Amapa chunga han a kutngei minngam rangin Jisua an ngênna. <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>Masikin amapa hah Jisua'n lokongei lâi renga atheivaiin a tuonga, a kutruolngei leh a kuor sûng ngei hah a tôn pea, a michil pea, a melei khom a tôn pea. <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>Hanchu Jisua'n invân tieng enin phûkasâna ânhûmma, a kôm, <char style="tl">“Ephatha”</char><note caller="+" style="f"><char style="fr" closed="false">7:34: </char><char style="ft" closed="false">Ephatha, ti hih Greek chong ani. In-ong roh tina ani.</char></note> a tia, mahah “In-ong roh!” tina ani.<verse eid="MRK 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35"/>Harenghan, a kuorngei a hongvâra, a melei inkhitna ngei ahong insûta, ânthar vangin a chong thei zoi. <verse eid="MRK 7:35"/><verse number="36" style="v" sid="MRK 7:36"/>Hanchu Jisua'n mingei kôm han tute ril tet loi rangin chong a pêk ngeia; hannirese misîr loi ranga a khap ngei dôr hah an ril minlum uola. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Male ariet ngei murdi'n kamâmruoi sabak an tia, “Neinuntin a sin murdi hih idôra asa mo ani zoi!” anni han, “Kuorsêt khom a minvâr pea, chongloi khom a min chong thei hi, kamâm aom bah!” an tia.<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s">Jisua'n mi isâng minli a vâina roi</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>Chomolte suole chu loko dang tamtak an hong intûp nôka. Ite an sâk rang an dônloi sikin Jisua'n a ruoisingei a koia, an kôm, <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>“Hi mingei hih ko kôm sûnthum an om zoia, male atûn hin ite sâk rang an dôn khâiloi sikin lungkham ku mu ngei tataka. <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>Bungêiin an ina ki min se ngei lakin lamlâia chamsôlinvei an ta, senkhat vâng chu an hongna alazan ani sikin” a tia.<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>A ruoisingeiin a kôm, “Hi ramchâra hin hi mingei vâina rangin tumo sâk an hun rang dôr aman zoi ranga?” an tipea.<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>Jisua'n, “Vâipôl kho dôr mo nin dôn?” tiin a rekel ngeia.</para>
  <para style="p" vid="MRK 8:5">Anni han “Vâipôl tâp sari” tiin an thuona.<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>Ama han lokongei hah pila insung rangin chong a pêk ngeia. Hanchu vâipôl tâp sari hah a lâka Pathien kôm râisânchong a rila, a khoia, lokongei sem pe rangin a ruoisingei kôm a pêk ngeia; male a ruoisingeiin an sema. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>Nga chînte atômte khom an dôn sa. Jisua'n ma chunga han khom râisânchong a ril nôka, male sem pe ngei rangin a ruoisingei kôm a pêk sa zoi. <verse eid="MRK 8:7"/><verse number="8-9" style="v" sid="MRK 8:8-9"/>Mitinin an khop dodôrin an sâka, asâk ngei ha mi isâng minli dôr an ni. Hanchu an sâk minieng arnôingei hah tabong sari an la rût min sipa. Jisua'n mingei ha a tîr pai ngeia <verse eid="MRK 8:8-9"/><verse number="10" style="v" sid="MRK 8:10"/>male a ruoisingei leh rukuonga an chuong kelena Dalmanutha ramhuola an se zoi.<verse eid="MRK 8:10"/></para>
  <para style="s">Phariseengei sininkhêl sin rangin an ngên</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mat 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>Pharisee senkhat ngei Jisua kôm an honga, an inkhalpuia. Ama min ôk rang an nuoma, masikin Pathien'n ama a pom ti minlangna rangin sininkhêl min mu ngei rangin an ngêna.<note caller="-" style="x"><char style="xo" closed="false">8:11: </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mat 12:38</ref>; <ref loc="LUK 11:16">Luk 11:16</ref></char></note> <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>Hannirese Jisua'n a mulungrîl sûnga a chapa, “Ithomo atûnlai mingei hin sininkhêl an ngên hi? Nimak, nangni ki ril! Atûnlai mingei kôm hin ma anga riet theina reng hi pêk ni no nih!” a tia.<note caller="-" style="x"><char style="xo" closed="false">8:12: </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat 12:39</ref>; <ref loc="LUK 11:29">Luk 11:29</ref></char></note><verse eid="MRK 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13"/>Anni hah a mâka, rukuonga a chuong nôka, male dîl varâl tieng ân kân zoi.<verse eid="MRK 8:13"/></para>
  <para style="s">Phariseengei le Herod chol</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>Ruoisingei han vâipôl an hun rang dôr chôi rangin an mingila male rukuonga han vâipôl tâp khat vai an dôna. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>Jisua'n, “Singthei roi,” male “Phariseengei le Herod chol renga indîn roi” tiin inningna a pêk ngeia.<note caller="-" style="x"><char style="xo" closed="false">8:15: </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luk 12:1</ref></char></note><verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>Anninanâk han, “Vâipôl ei dôn loi sika, mahi a ti kêng ani rang,” tiin an lâia an injêk khôm phut zoia.<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>Jisua'n an ti hah a lei rieta, an kôm, “Ithomo vâipôl nin dônloi roi nin injêk khôma? Nin la rietthei tet loi mini? Nin mulungbôkngei ânmôl sabak zoi mini? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>Mitngei nin dôn chakin nin mu thei loi mini? Kuorngei nin dôn chakin nin riet thei loi mini? Nin riettit khâiloi mini<note caller="-" style="x"><char style="xo" closed="false">8:18: </char><char style="xt" closed="false"><ref loc="JER 5:21">Jer 5:21</ref>; <ref loc="EZK 12:2">Ezek 12:2</ref>; <ref loc="MRK 4:12">Mk 4:12</ref></char></note> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>mipui isâng rangnga ngei ta rangin vâipôl tâp rangnga ko khoi lâi ha? An sâk minieng vâipôl ronôingei tabong izet mo nin rût minsip ha?” tiin a rekel ngeia.</para>
  <para style="p" vid="MRK 8:19">“Tabong sômleinik” tiin an thuona.<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>Male Jisua'n an kôm, “Mipui isâng minli ngei ta rangin vâipôl tâp sari ko khoi lâihan,” an sâk “minieng vâipôl ronôingei hah tabong izet mo nin rût minsip ha?” tiin a rekel ngei nôka.</para>
  <para style="p" vid="MRK 8:20">“Tabong sari” tiin an thuon nôka.<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>Male ama'n “Atûn ten nin la rietthei loi mo?” tiin a rekel ngeia.<verse eid="MRK 8:21"/></para>
  <para style="s">Jisua'n Bethsaida taka mi mitcho a minvâr</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>Bethsaida taka an hong tunga, mahan mingei senkhatin Jisua kôm mi mitcho an hong tuonga, male a tôn pe ngei rangin an ngênna. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>Jisua'n mitchopa kut hah a sûra, khuo pêntieng a se puia. A mitngei a michil pe suole chu, Jisua'n a chunga a kutngei a minngama male a kôm, “Nu mu thei mo ni zoi?” tiin a rekela.<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>Ha mi hah a tanga, “O, miriemngei chu ku mua, hannirese, thingkungngei an lôn titir anghan ke ku mu” a tia.<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>Jisua'n mitchopa mitngei han a kutngei a minngam nôka. Ma zora han chu mitchopa han a en ngita, a mitngei ahong vâr zoia, male jâttin a mu minthâr thei let zoi. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>Hanchu Jisua'n, “Khuo sûnga hin lût khâi no roh” tiin chong a bêa, in tieng a tîr zoi.<verse eid="MRK 8:26"/></para>
  <para style="s">Peter'n Jisua chungroi a phuongna</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat 16:13-20</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>Hanchu Jisua le a ruoisingei hah an jôka, Caesarea Philipi kôla khuongeia han an sea. Lampuia han an kôm, “Mi ril roi, mingeiin tumo ani min ti?” tiin a rekel ngeia.<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>Anni han, “Senkhatin chu Baptispu John ani,” male “midangngei chu Elijah ani, senkhatngei nôkin chu dêipu inkhatlam ani” nang an ti, tiin an thuona.<note caller="-" style="x"><char style="xo" closed="false">8:28: </char><char style="xt" closed="false"><ref loc="MRK 6:14">Mk 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">Luk 9:7</ref>,<ref loc="LUK 9:8">8</ref></char></note><verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>Hanchu, an kôm han, “Nangni rêkte tumo ani mi nin ti?” tiin a rekel ngeia.<note caller="-" style="x"><char style="xo" closed="false">8:29: </char><char style="xt" closed="false"><ref loc="JHN 6:68">Joh 6:68</ref>,<ref loc="JHN 6:69">69</ref></char></note></para>
  <para style="p" vid="MRK 8:29">Peter'n a kôm, “Messiah ni ni” tiin a thuona.<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>Hanchu Jisua'n an kôm han, “Ku chungroi hih tute kôm ril no roi” tiin chong a pêk ngei zoi.<verse eid="MRK 8:30"/></para>
  <para style="s">Jisua'n a tuong rang le a thi rang roi a misîr</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat 16:21-28</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Hanchu Jisua'n a ruoisingei a minchu ngeia, an kôm, “Miriem Nâipasal hi la tuong sabak ngêt a ta, upangei, ochaisingei le Balam minchupungeiin hengpai an tih. That an ta, aniatachu sûnthum suole chu aringin inthoinôk atih,” a tia. <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>Ma roi hih ânthârvangin a ril ngeia. Masikin Peter'n ama hah athenin a tuonga, a ngoa. <verse eid="MRK 8:32"/><verse number="33" style="v" sid="MRK 8:33"/>Hannirese Jisua'n ânheia, a ruoisingei tieng a ena, male “Soitan, keima renga rotpai roh,” ama'n, “Ni mindonngei hih Pathien renga niloiin miriem nina renga ke ani,” tiin Peter a ngoa.<verse eid="MRK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>Hanchu Jisua'n lokongei le a ruoisingei a koia, an kôm, “Tutu khom mi jûi a nuomin chu ama le ama inmingil ngêtin a khros ruputin mi jûi rese.<note caller="-" style="x"><char style="xo" closed="false">8:34: </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat 10:38</ref>; <ref loc="LUK 14:27">Luk 14:27</ref></char></note> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>Tukhom a ringna mojôk a nuomin chu machân a ta; hannirese, tukhom keima sika le thurchisa sika a ringna machân ngei chu mojôk nîng an tih.<note caller="-" style="x"><char style="xo" closed="false">8:35: </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10:39</ref>; <ref loc="LUK 17:33">Luk 17:33</ref>; <ref loc="JHN 12:25">Joh 12:25</ref></char></note> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>Mîn rammuol hih apumin dôn senla, a ringna chu machân senla, ata rangin imo an lâpna aom ranga? Mangmunboi ani! <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>Mîn a ringna a man nôkna rangin ite a pêk thei rang om mak. <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>Tukhomin atûnlâi nikhuo saloi le pathienboi mingei kôma keima le ki minchuna chong inzakpui chu, Miriem Nâipasal a Pa roiinpuina insila a vântîrton inthieng ngei leh an juong tika chu ha mi hah inzakpui atih” a tia.<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>Male a la ti banga an kôm han, “Nangni ki ril, hi taka om senkhat ngei hih chu Pathien Rêngram hah a sinthotheina leh a juong tung an mu mâka chu thi no ni ngei” a tia.<verse eid="MRK 9:1"/></para>
  <para style="s">Mêl inthûlna</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat 17:1-13</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>Sûnruk suole chu Jisua'n Peter, Jacob le John a tuong ngeia, an theivaiin an omna muol insânga han a ruoi ngeia. An mitmu chungchakin Jisua mêl ahong inthûla,<note caller="-" style="x"><char style="xo" closed="false">9:2-7: </char><char style="xt" closed="false"><ref loc="2PE 1:17">2 Pet 1:17</ref>,<ref loc="2PE 1:18">18</ref></char></note> <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>male a puonsilngei khom achekin ântêrdapa rammuola mîn tutên madôr ha rusûk minsâi thei no ni ngei. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>Hanchu ruoisi inthum ngei han Elijah le Moses'n Jisua an chongpuilâitak an mua. <verse eid="MRK 9:4"/><verse number="5" style="v" sid="MRK 9:5"/>Peter'n Jisua kôm, “Minchupu, hi taka om hi ei ta rangin idôra asa mo ni zoi! Puon in inthum sin kin ta nangma rang inkhat, Moses rang inkhat, Elijah rang inkhat sin kin tih” a tia. <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Ama le adangngei ha an chi rai sikin a ti rang tak khom riet mak ngeia.<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>Hanchu sûmphâi ajuong oma anni ngei hah sûmphâiin ajuong mukhu ngeia, sûmphâi renga hah chong ajuong inringa, “Ama hih ka Nâipasal moroitak ani, a chong rangâi roi!” a tia.<note caller="-" style="x"><char style="xo" closed="false">9:7: </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MRK 1:11">Mk 1:11</ref>; <ref loc="LUK 3:22">Luk 3:22</ref></char></note> <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>Inrangin an en titira hannirese tute an kôla adang mu khâi mak ngeia; Jisua vai ke an kôm aom zoi.<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Muol chung renga an juong chuma Jisua'n an kôm, “Miriem Nâipasal hi thina renga ânthoinôk mâka chu nin neinun mu hi tute kôm ril no roi duo” tiin chong a bê ngeia.<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>A chongbe ha an jôma, aniatachu ma roi ha an lâia, “‘Thina renga inthoinôk’ ti hih khoi tina mi hi?” tiin an injêk khôm phut zoi. <verse eid="MRK 9:10"/><verse number="11" style="v" sid="MRK 9:11"/>Male anni han Jisua kôm, “Ithomo Balam minchupungeiin, Elijah a juong bak rang an ti?” tiin an rekela.<note caller="-" style="x"><char style="xo" closed="false">9:11: </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mal 4:5</ref>; <ref loc="MAT 11:14">Mat 11:14</ref></char></note><verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>Ama'n an kôm, “Neinun murdi cherêl rangin Elijah chu a juong bak ngêt rang ani. Hankhoma, ithomo Pathien Lekhabu'n, Miriem Nâipasalin la tuong ok a ta, hengpaiin la om atih, a tia? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>Nikhomrese, nangni ki ril Elijah chu a juong suo kêng ani zoi, male a chungroi Pathien Lekhabu'n ati anghan mingeiin a chunga an nuom lamtakin an lo zoi,” a tia.<verse eid="MRK 9:13"/></para>
  <para style="s">Jisua'n pasalte ratha saloi dôn a mindam</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mat 17:14-21</ref>; <ref loc="LUK 9:37-43">Luk 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Ruoisingei kôm an juong tungin chu an kôla loko tamtak ngei le Balam minchupungei senkhatin an lei inkhalpui lâitak an juong mua. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>Mingei han Jisua an mu lehan an kamâm sabaka, male ama tieng an tânna chibai an va pêka. <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>Jisua'n a ruoisingei kôm, “Anni ngei lehan khoi thurchi mo nin lei inkhal ha?” tiin a rekel ngeia.<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>Lokongei lâia mi inkhatin a kôm, “Minchupu, ka nâipasal ratha saloi a dôna male a chongloi sikin no kôm ko hong tuong tiin a thuona. <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>Ratha saloi ahong tôn racham nuoia ânlet kelen ngâia, a cherhuon a suoka, a hâ a riela, angarjêt ngâi. Ratha saloi ha rujûlpai rangin nu ruoisingei ke ngênna, aniatachu thei mak ngei,” a tia.<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>Jisua'n an kôm, “Kho anga mi iemnaboi mo nin ni! Idôrsôt mo nin kôm omin nangni ko donsûi thei ranga? Pasalte hah ko kôm hong tuong roi!” a tia. <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>Ama ha Jisua kôm an hong tuonga.</para>
  <para style="p" vid="MRK 9:20">Ratha saloi han Jisua a hong mûn chu pasalte hah a nunuom alo bita, masikin nuoia ân leta, a vânluoi ahônluoia, a cherhuon a suoka. <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>Jisua'n a pa kôm, “Hi anga a om phutna hih khotik renga mo ani zoi?” tiin a rekela.</para>
  <para style="p" vid="MRK 9:21">“Nâipang a chang renga” tiin chong a melea. <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>“Ratha saloi hin ama that rang pûtin vêl tamtak meia le tuia a meleta. Ne thei ngâiin chu inrieng mi mu inla, mi san roh!” tiin a rila.<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>Jisua'n a kôm, “Ani,” “nangmananâkin ni ni theiin chu! Taksônna dôn mingei ta rangin chu neinuntin anithei let,” a tia.<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>A pa han harenghan, ân ieka, “Taksônna ko dôn, hannirese hun zoi mak. Taksônna ko dôn uol theina rangin mi san roh!” a tia.<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>Jisua'n lokongei ama tieng an hong nâi titir a mua, masikin ratha saloi kôm han, “Ratha kuorsêt le chongloi,” ama han, “Pasalte sûng renga hong jôk roh, male a sûnga lût nôk tet khâiloi rangin chong nang ke pêk!” a tia.<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>Ratha saloi hah ân ieka, pasalte hah a vôrra a nunuom a lo bita, male a hong jôk paia. Pasalte hah athi angin angarzata, male mitinin, “Ama hih athi zoi!” an tia. <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>Hannirese Jisua'n a kuta a sûra, a kaithoia, male ânding zoi.<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>Masuole Jisua in sûnga a lûta, a ruoisingeiin inrûkten an rekela, “Ithomo keinin ratha saloi ha kin rujûlpai theiloi?” an tia.<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>Jisua'n an kôm, “Ma jât hi chu chubaithona niloiin chu, itên rujûl thei nimak,” tiin a thuon ngeia.<verse eid="MRK 9:29"/></para>
  <para style="s">Jisua a thi rang roi a misîr nôkna</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat 17:22-23</ref>; <ref loc="LUK 9:43-45">Luk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>Jisua le a ruoisingeiin ha mun hah an mâka male Galilee ram palin an sea. Jisua'n a omna tutên an riet rangin nuom maka, <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>“Miriem Nâipasal hih a that rangpu ngei kuta bangin om atih. Nikhomrese, sûnthum suole chu aringin inthoinôk atih” ti chong hih a ruoisingei a minchu ngei sikin.<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>Aniatachu hi minchuna aomtie hih rietthei mak ngeia, male ama rekel rang khom an chia.<verse eid="MRK 9:32"/></para>
  <para style="s">Tu hih mo alientak?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18:1-5</ref>; <ref loc="LUK 9:45-48">Luk 9:45-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>Hanchu Capernaum an hong tunga, insûnga an lût suole chu a ruoisingei kôm, “Lampuia han khoi roi mo nin rila nin inkhal hah?” tiin a rekel ngeia.<verse eid="MRK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34"/>Hannirese anni han thuon mak ngeia, lampuia an hong inkhalna hah ei lâia hin tumo alientak rang? ti roi hah ani sikin.<note caller="-" style="x"><char style="xo" closed="false">9:34: </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luk 22:24</ref></char></note> <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>Jisua ânsunga, ruoisi sômleinik ngei hah a koia, male an kôm, “Tukhom alientak ani nuomin chu achîntak changin mi murdi tîrlâm ani masa ngêt rang ani” a tia.<note caller="-" style="x"><char style="xo" closed="false">9:35: </char><char style="xt" closed="false"><ref loc="MAT 20:26">Mat 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MAT 23:11">23:11</ref>; <ref loc="MRK 10:43">Mk 10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">Luk 22:26</ref></char></note> <verse eid="MRK 9:35"/><verse number="36" style="v" sid="MRK 9:36"/>Hanchu nâipangte a koia, an motona a minding pe ngeia, a kuo ira, an kôm, <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>“Tukhom ki riming sika hi anga nâipangte inkhat khom a modômpu chu, keima mi modôm ania; male tukhom keima mi modômpu chu, keima mi modôm vai niloiin ni tîrpu khom a modôm sa ani” a tia.<note caller="-" style="x"><char style="xo" closed="false">9:37: </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat 10:40</ref>; <ref loc="LUK 10:16">Luk 10:16</ref>; <ref loc="JHN 13:20">Joh 13:20</ref></char></note><verse eid="MRK 9:37"/></para>
  <para style="s">Tukhom mi chakal loi chu ei tienga kop ani</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luk 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>John'n a kôm, “Minchupu, mi inkhat ni riminga ramkhoringei rujûl kin mua, male ei pâla mi ani loi sikin kin hong khap” a tia.<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>Jisua'n an kôm, “Ama ha khap rang pût no roi,” tute ki riminga sininkhêl a sina harenghan ku chungroia neinun saloi ngei ti thei kelen rang reng omak ngei, tiin a ril ngeia. <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>Tukhom mi chakal loi chu ei tienga kop ani.<note caller="-" style="x"><char style="xo" closed="false">9:40: </char><char style="xt" closed="false"><ref loc="MAT 12:30">Mat 12:30</ref>; <ref loc="LUK 11:23">Luk 11:23</ref></char></note> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>Adiktakin nangni ki ril, tukhom ki mi nin ni sika tuidâi kilât khat khom nangni a min nêkin chu râisânman a man ngêt rang ani.<note caller="-" style="x"><char style="xo" closed="false">9:41: </char><char style="xt" closed="false"><ref loc="MAT 10:42">Mat 10:42</ref></char></note><verse eid="MRK 9:41"/></para>
  <para style="s">Sietna ranga methêmnangei</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mat 18:6-9</ref>; <ref loc="LUK 17:1-2">Luk 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>“Tukhom keima taka taksônna dôn mi achînte ngei lâia inkhat khom a taksônna minmang pe chu a ringa bunôinalung lienpa orrin tuikhangliena inchôm senla ata rangin sa uol atih.” <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/><note caller="-" style="x"><char style="xo" closed="false">9:43: </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mat 5:30</ref></char></note> Masikin nu kutin na taksônna aminmangin chu tan pai roh! Kutngei inik dôna dûkmun meidîla, mei thi tet ngâiloia<note caller="+" style="f"><char style="fr" closed="false">9:43: </char><char style="ft" closed="false">Miziek senkhat ngeiin chu arachang 44 na hi an bôksa; </char><char style="fq" closed="false">Ha muna han chu an “rulungngei thi tet ngâi maka, male mei khom thi tet ngâi mak,” </char><char style="ft" closed="false">(Arachang 48 na en roh).</char></note> se nêkin chu kut boia ringna taka lût nata rangin asa uol. <verse eid="MRK 9:43"/><verse number="45-46" style="v" sid="MRK 9:45-46"/>Male ne kengei han na taksônna aminmangin chu, tan pai kelen roh! Kengei inik dôna dûkmuna paia om nêkin chu ke boia ringna taka lût chu nata rangin asa uol.<note caller="+" style="f"><char style="fr" closed="false">9:45-46: </char><char style="ft" closed="false">Miziek senkhat ngeiin arachang 46 na hi an bôksa: </char><char style="fq" closed="false">Ha muna han chu an “rulungngei thi tet ngâi maka, male mei khom thi tet ngâi mak,” </char><char style="ft" closed="false">(Arachang 48 na en roh.) </char></note> <verse eid="MRK 9:45-46"/><verse number="47" style="v" sid="MRK 9:47"/>Male ni mitin na taksônna aminmangin chu kêl pai roh! Mitngei inik dôna dûkmuna paia om nêkin chu mit inkhat dôna Pathien Rêngrama lût nata rangin asa uol.<note caller="-" style="x"><char style="xo" closed="false">9:47: </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat 5:29</ref></char></note> <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>Ha muna han chu anni ngei sâk ngâi, “rulungngei ha khom thi tet ngâi mak ngeia, mei khom thi tet ngâi mak.”<note caller="-" style="x"><char style="xo" closed="false">9:48: </char><char style="xt" closed="false"><ref loc="ISA 66:24">Isa 66:24</ref></char></note><verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>“Inbôlna michi alin aminthieng ngâi anghan mi murdi meiin la minthieng nîng an tih.”<verse eid="MRK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50"/>“Michi hih a ala; aniatachu a alna hah adongin chu ile mo nin min al nôk ranga?<note caller="-" style="x"><char style="xo" closed="false">9:50: </char><char style="xt" closed="false"><ref loc="MAT 5:13">Mat 5:13</ref>; <ref loc="LUK 14:34">Luk 14:34</ref>,<ref loc="LUK 14:35">35</ref></char></note></para>
  <para style="p" vid="MRK 9:50">“Nin lâia malinchangna michi dôn ungla, male insûk irrin om roi” a tia.<verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s">Jisua'n inmâkna chungroia a minchuna</para>
  <para style="r">(<ref loc="MAT 19:1-2">Mat 19:1-2</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>Hanchu Jisua'n ha mun hah a mâka, Judea ramhuola a sea, male Jordan Tuidung râl ânkânna lokongei apâlpa a kôm an hong intûp nôka, a tho tit ngâi anghan anni ngei ha a lei minchu ngeia.<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>Phariseengei senkhat an honga, ama min ôkna rangin, “Mîn a lômnu mâk rangin ei Balamin aphal mo?” mi ril roh, tiin an rekela.<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>Jisua'n an kôm, “Moses'n inmo Balam nangni a pêk?” tiin chongrekel leh a thuon ngeia.<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>Anni han, “Moses'n chu pasalin inmâkna lekha a mizieka male a lômnu tîr pai rangin inmâk hih a phal ngâi ani” ti hih an thuona chu ani.<note caller="-" style="x"><char style="xo" closed="false">10:4: </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Bal 24:1-4</ref>; <ref loc="MAT 5:31">Mat 5:31</ref></char></note><verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>Jisua'n an kôm, “Minchu nin intak rai sika Moses'n hi Balam hih nangni rangin a miziek, a tipe ngeia. <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>Aniatachu rammuol insieng phut renga Pathien Lekhabu'n ati anghan, ‘Pathien'n pasal le nupang’ a sin ngei ani.<note caller="-" style="x"><char style="xo" closed="false">10:6: </char><char style="xt" closed="false"><ref loc="GEN 1:27">Aph 1:27</ref>; <ref loc="GEN 5:2">5:2</ref></char></note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>‘Masika han pasalin a nû le a pa mâk a ta, male a lômnu leh inlop<note caller="+" style="f"><char style="fr" closed="false">10:7: </char><char style="ft" closed="false">Miziek senkhat ngei chu </char><char style="fq" closed="false">male a lômnu leh inlop ti hi dôn mak ngei.</char></note> an ta, <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>male inik hah takpum inkhat hongni an ti zoi.’ Masikin inik ni khâi mak ngeia, inkhat an hongni zoi ani. <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>Hanchu Pathien'n munkhata a minzom sai chu miriemin an minsen rang nimak,” a tia. <verse eid="MRK 10:9"/><verse number="10" style="v" sid="MRK 10:10"/>In sûng an lût lehan a ruoisingeiin ma roi hah Jisua an rekela. <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>Ama han an kôm, “Tukhom a lômnu a mâka, male nupang dang inneipui chu a lômnu doiin a inrê ani.<note caller="-" style="x"><char style="xo" closed="false">10:11,12: </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat 5:32</ref>; <ref loc="1CO 7:10">1 Kor 7:10</ref>,<ref loc="1CO 7:11">11</ref></char></note> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>Ma angdênin, nupang khomin a pasal mâkin pasal dang inneipui chu a inrê ani,” a tia.<verse eid="MRK 10:12"/></para>
  <para style="s">Jisua'n nâipangtengei satavur</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19:13-15</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Jisua'n an chunga kutngei a minngama satavur theina rangin mi senkhatin a kôm nâipangtengei an hong tuonga, aniatachu ruoisingeiin mingei hah an lei ngokhuma. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>Jisua'n maha a mu lehan a ningathika, a ruoisingei kôm, “Nâipangtengei ko kôm min hong ungla, khap no roi, Pathien Rêngram chu hi anga mingei ta ani sikin. <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>Adiktakin nangni ki ril tukhom nâipangte angin Pathien ram a modôm nônchu Pathien Rêngram lût tet no ni,” a tia.<note caller="-" style="x"><char style="xo" closed="false">10:15: </char><char style="xt" closed="false"><ref loc="MAT 18:3">Mat 18:3</ref></char></note> <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Hanchu nâipangtengei a kuoa, an chung chita a kutngei minngamin, male satavur ngei zoi.<verse eid="MRK 10:16"/></para>
  <para style="s">Ruotharte mineipa thurchi</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19:16-30</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>Jisua'n se nôk ranga kalchôichakin, mi inkhat a hong tânna, amakunga khûkinbilin, a kôm, “Minchupu Sa, ringinlon ka chang theina rangin imo ki sin rang?” tiin a rekela.<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>Jisua'n a kôm, “Ithomo asa mi ni tia?” “Pathien pêna chu tute mi sa om mak ngei. <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/><note caller="-" style="x"><char style="xo" closed="false">10:19: </char><char style="xt" closed="false"><ref loc="EXO 20:13">Jôk 20:13</ref>; <ref loc="DEU 5:17">Bal 5:17</ref>; </char><char style="xt" closed="false"><ref loc="EXO 20:14">Jôk 20:14</ref>; <ref loc="DEU 5:18">Bal 5:18</ref>; </char><char style="xt" closed="false"><ref loc="EXO 20:15">Jôk 20:15</ref>; <ref loc="DEU 5:19">Bal 5:19</ref>; </char><char style="xt" closed="false"><ref loc="EXO 20:16">Jôk 20:16</ref>; <ref loc="DEU 5:20">Bal 5:20</ref>; </char><char style="xt" closed="false"><ref loc="EXO 20:12">Jôk 20:12</ref>; <ref loc="DEU 5:16">Bal 5:16</ref></char></note> Balam chongpêkngei ha chu ni riet duo: ‘Mi that no roh; inrê no roh; inru no roh; adikloitakin tute bâtu tho no roh; mi huong no roh; nu nû le na pa jâ roh ti ngei hih’” a tia.<verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>Hapa han a kôm, “Minchupu ma Balam chongpêkngei nâm ha chu ka nâipangte renga ke lei jôm sai kêng” a tia.<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>Jisua'n amapa hah a en ngita, lungkhamna tak dônin a kôm, “Inkhat mamang na lân sam. Senla no dôn murdi zuor inla, male a sum hah inrieng ngei pêk inla, male invâna rochon dôn ni tih; hanchu hong inla, mi hong jûi roh” a tipea. <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>Amapa han ha chong hah a riet lehan, a mâimôk pe oka, mineipa ani sikin, innguikhakin a rot zoi.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>Jisua'n a ruoisingei a vêng ngeia male an kôm “Anei ngei Pathien Rêngrama lûtna rangin khodôra ântak mo ani zoi!” a tia.<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>Ruoisingei han a chongril hah jâmzal aom sabak an tia, hannirese Jisua'n a la tibanga an kôm, “Ka nâingei, Pathien Rêngrama lût rang hi idôra ântak mo ani zoi! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>Minei ngei Pathien Rêngrama lût nêkin chu simphuoi kuora ût lût rang bai uol ok atih” a tia.<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>Haten hanchu ruoisingeiin an jâmânzal phar zoia, male inkhat le inkhat annin rekel inlôma, “Hanchu, tumo sanminjôkin aom thei rang?” an tia.<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>Jisua'n anni ngei hah a en ngita, an kôm, “Maha miriem rangin chu nitheimaka, aniatachu Pathien rangin chu anithei ani; Pathien rangin chu neinuntin hih anithei let ani” tiin a thuona.<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>Hanchu Peter'n a kôm, “En ta, keini chu neinuntin kin mâka, male nang kin jûi ani hi” a tia.<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>Jisua'n an kôm, “Ani,” nangni ki ril tukhom keima sika le thurchisa sika, in mo, lâibungngei mo, sarnungei mo, nû mo, pa mo, nâingei mo, loingei mo amâk ngei chu, <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>hi damsûng renga hin inngei mo, lâibungngei mo, sarnungei mo, nûngei mo, pangei mo, nâingei mo, loingei mo, abâk razan man a ta, male mi nuomlonangei khom tuong sa a ta; male zora la hong tung ranga ringinlon khom man sa atih. <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>“Aniatachu atûna amotontaka om mi tam ngei chu anûktaka la om an ta, male anûktaka om mi tam ngei chu amotontaka la om an tih,” a tia.<note caller="-" style="x"><char style="xo" closed="false">10:31: </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mat 20:16</ref>; <ref loc="LUK 13:30">Luk 13:30</ref></char></note><verse eid="MRK 10:31"/></para>
  <para style="s">Jisua'n a thi rang roi a misîr voithumna</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20:17-19</ref>; <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>Jisua le a ruoisingei Jerusalem tena se rangin lampuia an oma, Jisua moton ânsa, ruoisingei hah kamâmnân an sipa; a nûkjûi mingei han an chia. Jisua'n, ruoisingei hah an theiviekin a tuong ngei nôka, male a chunga neinun ahongtung rang ngei hah a misîr pe ngei nôka. <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>“Rangâi roi, Jerusalem tena ei se rang ania, mahan Miriem Nâipasal hi ochaisingei le Balam minchupungei kuta bangin om atih. Thi rangin theiloimintum an ta masuole chu Jentailngei kuta bang an ta, <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>anni ngei han innuinân mang an ta, michil an ta, jêm an ta, that an tih; hannirese sûnthum suole chu aringin inthoinôk a tih” a tia.<verse eid="MRK 10:34"/></para>
  <para style="s">Jacob le John ngênna</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>Hanchu Zebedee nâipasalngei Jacob le John, Jisua kôm an honga, “Minchupu, imini sin mi ni tho pe rangin kin nuom aom,” an tia.<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>Jisua'n an kôm, “Maha imo ani?” tiin a rekel ngeia.<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>Anni han, a kôm, “Ne Rêngram roiinpuitaka ne rêngsukmuna nên sung tika na changtieng inkhat voitieng inkhat mi ni min sung rangin kin nuom ani” tiin an thuona.<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>Jisua'n an kôm, “Nin ngên hi nin riet loi ani. Dûktuongna kilât ke nêk ngêt rang hi nin nêk thei rang mo? Ka baptisma chang rang khom nin chang thei rang mo?” a tipe ngeia.<note caller="-" style="x"><char style="xo" closed="false">10:38: </char><char style="xt" closed="false"><ref loc="LUK 12:50">Luk 12:50</ref></char></note><verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>Anni han, “Thei kin tih” tiin an thuona.</para>
  <para style="p" vid="MRK 10:39">Jisua'n an kôm, “Ki kilât nêk rang chu nêk nin ta, ka baptisma chang rang khom chang thei nin tih. <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>Aniatachu ka changtieng mo, ko voitieng mo tumo an sung rang thang rangin chu rachamnei mu-ung. Ha munngei hah chu Pathien'n tu ngei rang mo a minsûk pe ngei kôm han pêk ngei atih,” tiin a tipe ngeia.<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Ma roi hah ruoisi dang sôm ngeiin an lei rieta Jacob le John chunga an lei nuor zoia. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>Masikin Jisua'n anrêngin munkhatin a koi ngeia, an kôm, “Jentailngei chunga roijêkpu an phun ngei chu an chunga an inlal sabak ngâia, male an ruoipungei khom an chunga racham an nei tatak ngâi ti khom nin riet.<note caller="-" style="x"><char style="xo" closed="false">10:42,43: </char><char style="xt" closed="false"><ref loc="LUK 22:25">Luk 22:25</ref>,<ref loc="LUK 22:26">26</ref></char></note> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>Nikhomrese, nin lâia chu ma anghin ani rang nimak. Nin lâia tukhomin alien rang a nuomin chu nin tîrlâm ani bak ngêt rang ani;<note caller="-" style="x"><char style="xo" closed="false">10:43,44: </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mat 23:11</ref>; <ref loc="MRK 9:35">Mk 9:35</ref>; <ref loc="LUK 22:26">Luk 22:26</ref></char></note> <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>male nin lâia tukhomin amotontak ani nuomin chu mi murdi suok ani bak ngêt rang ani. <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>Miriem Nâipasal luo mana mîn a sin an tho pe rangin juong maka; mi sin tho pe rangin le mi tamtak ngei ratan ranga a ringna pêk rangin ke a juong ani” a tia.<verse eid="MRK 10:45"/></para>
  <para style="s">Jisua'n Bartimaeus mitcho a mindam</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20:29-34</ref>; <ref loc="LUK 18:35-43">Luk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Jericho an hong tunga, Jericho renga Jisua le a ruoisingei leh loko tamtak ngei mâkin an se lâiin kutdo Timaius nâipasal Bartimaeus lampui kôla a lei insunga. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Nazareth Jisua ani ti a riet lehan ân ieka, “Jisua! David Nâipasal, inrieng mi mu roh ba!” a tia.<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>Mi tamtakin dâirek rangin an ngokhuma, aniatachu ama'n, “David Nâipasal, inrieng mi mu roh!” tiin ânring uolin ân ieka.<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>Jisua ânngama male, “Ama hah hong koi roi” a tia.</para>
  <para style="p" vid="MRK 10:49">Masikin mitchopa hah an va koia, a kôm, “Tâihieiin om roh!” anni han, “Inthoi roh, nang a koi!” an tipea.<verse eid="MRK 10:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50"/>Masikin a puon a vôr paia, inrangtakin ân chôma, male Jisua kôm a hong zoi.<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>Jisua'n a kôm, “Khoimo nang ko tho pe rangin nu nuom?” tiin a rekela.</para>
  <para style="p" vid="MRK 10:51">Mitchopa han a kôm, “Minchupu, mu nôk thei rangin ku nuom” tiin a thuona.<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>Jisua'n a kôm, “Se ta roh, na taksônnân nang amindam zoi ani” tiin a rila.</para>
  <para style="p" vid="MRK 10:52">Voikhatrengin a mu thei kelena, male lampuia han Jisua a jûi zoi.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s">Jisua'n inlaltakin Jerusalema a lût</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Joh 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>Jerusalem an hong tung rangtôn Bethphage le Bethany khopuingei kôla Olive Muol an hong tungin chu Jisua'n a ruoisingei lâia mi inik an motona a tîr ngeia, <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>hi rilnangei leh an kôm, “Nin motona khuo son se ungla, nin tung harenghan, sakuordingte inthung, tute la chuongna ngâiloi mu nin tih. Sût ungla, mahin hong kai roi. <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>Male tukhomin itho mo ma anghin nin thoa, tiin nangni an rekel khomin, Pumapa'n<note caller="+" style="f"><char style="fr" closed="false">11:3: </char><char style="fq" closed="false">Pumapa; </char><char style="ft" closed="false">aninônchu </char><char style="fq" closed="false">a pumapa.</char></note> a min nâng kêng, hong thak nôk kelen a tih ti roi” a tia.<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>Masikin an sea lamliena inkhâr pêntienga sakuordingte inthung an va mua. Maha an sût lehan, <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>hataka ânding senkhat ngeiin, “Ithomo sakuordingte hah nin sûta?” tiin an rekel ngeia.<verse eid="MRK 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6"/>Jisua'n a ril ngei anghan an thuona, male lokongei han an min se ngei zoi. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>Sakuordingte hah Jisua kôm an hong kaia, a chunga an puonngei an dâpa male Jisua a chuonga. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Mi tamtakin an puonngei lampuia an dâpa, adangin loilâija sasôl an va tuka an dâp sa zoi. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>Amoton tienga se ngei le a nûk tienga a jûi mingeiin,<note caller="-" style="x"><char style="xo" closed="false">11:9: </char><char style="xt" closed="false"><ref loc="PSA 118:25">Lap 118:25</ref>,<ref loc="PSA 118:26">26</ref> </char></note></para>
  <para style="q1" vid="MRK 11:9">“Hosanna!</para>
  <para style="q2" vid="MRK 11:9">Pumapa riminga juongpu chu Pathien'n</para>
  <para style="q2" vid="MRK 11:9">satvur rese!<verse eid="MRK 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10"/>Rêng David Rêngram juong tung rang ha,</para>
  <para style="q2" vid="MRK 11:10">ei pa'n satvur rese!</para>
  <para style="q2" vid="MRK 11:10">Pathien minpâkin om rese!</para>
  <para style="q1" vid="MRK 11:10">Ânchungtaka khin</para>
  <para style="q2" vid="MRK 11:10">Hosanna!” tiin an inieka.<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>Jisua'n Jerusalem a tungin chu Biekin sûnga a lûta, male neinun nâm a ena. Aniatachu kholoi ahongni zoi sikin ruoisi sômleinik ngei leh Bethany taka an se zoi.<verse eid="MRK 11:11"/></para>
  <para style="s">Jisua'n theichang kung khomâk a sâm</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mat 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Anangtûka chu Bethany renga an hong kîr nôka, Jisua a von ahong cham pea. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>“Alazana renga theichang kung abuongei hah ava mua, masikin amara tete mo ka man” tiin ava pana. Hannirese ava tungin chu, theichang ânra zora ani loi sikin abuongei tiloiin chu ite adang mu maka. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>Jisua'n theichang kung kôm han, “Tutên na mara sâk man khâi no rese ngei!” a tia.</para>
  <para style="p" vid="MRK 11:14">Male a ruoisingei khomin a chong ha an rieta.<verse eid="MRK 11:14"/></para>
  <para style="s">Jisua Biekina a se</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21:12-17</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:12-22">Joh 2:12-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>Jerusalem an tung lehan, Jisua Biekina ava lûta, Biekina neinun juorngei le rochôkngei hah a rujûlpai ngeia. Sum thûlngei dosângngei le pharvali juorngei sukmunngei khom a nammelet pe ngeia, <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>male Biekin khalâidung han tutên neinun chôi rangin phal khâi maka. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>Hanchu mingei kôm han Pathien Lekhabua, “‘Ki Biekin chu namtinngei ta ranga chubaithona in ani,’ tiin ânziek nimak mo? Aniatachu nangni ngei rêkin chu inrungei inthupna in ke nin minchang hi!” tiin a minchu ngeia.<note caller="-" style="x"><char style="xo" closed="false">11:17: </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56:7</ref>; </char><char style="xt" closed="false"><ref loc="JER 7:11">Jer 7:11</ref></char></note><verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>Mahi ochaisingei le Balam minchupungeiin an rieta, masikin Jisua thatna rang lampui an rok zoia. Lokongei ha a minchuna hah kamâm aom sabak an ti sikin ama hah an chia.<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>Hanchu, kholoi ahongni lehan, Jisua le a ruoisingei hah khopuilien an mâk zoia.<verse eid="MRK 11:19"/></para>
  <para style="s">Theichang kung renga inchuna</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mat 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Anangtûk jînga chu ha lampuia an lôn chungin theichang kung hah aruzungngei dênin athîn an mua. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>Peter'n neinun ahongtung ha a riet nôka male a kôm, “Minchupu, en ta theichang kung khomâk na sâm hah athi phar zoi!” a tia.<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>Jisua'n an kôm, “Pathien taksôn roi,” tiin a thuon ngeia. <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>Adiktakin nangni ki ril; tukhomin hi tâng hih, “Inthon inla tuikhangliena van pai roh” ti senla, mulunglâiinlakna boiin iemtakin a tiin chu, a ti anghan hongtung atih, ama rangin sinin om atih.<note caller="-" style="x"><char style="xo" closed="false">11:23: </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat 17:20</ref>; <ref loc="1CO 13:2">1 Kor 13:2</ref> </char></note> <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>Masika han nangni ki ril: i-ih khom chubaithoa nin ngên ngei murdi chu maha nin man sai angin iem ungla, male nin zong ngei murdi chu pêkin om nin tih. <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>Male chubaitho ranga nin inding tika, “Tu chunga khom nourna nin dôn khomin ngâidam roi, masika han invâna nin Pa khomin nin minchâinangei hah nangni a ngâidam rang ani.”<note caller="+" style="f"><char style="fr" closed="false">11:25: </char><char style="ft" closed="false">“Mi nin ngâidam nônchu invâna nin Pa khomin nangni ngâidam no ni” a tia. Miziek senkhat ngeia chu mahi om mak </char><char style="ft" closed="false">(Mat 6:15 en roh.)</char></note><note caller="-" style="x"><char style="xo" closed="false">11:25: </char><char style="xt" closed="false"><ref loc="MAT 6:14">Mat 6:14</ref>,<ref loc="MAT 6:15">15</ref></char></note><verse eid="MRK 11:25"/></para>
  <para style="s">Jisua rachamneina roia chongrekel</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21:23-27</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>Jerusalema an tung nôka. Biekina a lônlâitakin ochaisingei, Balam minchupungei le upangei Jisua kôm an honga <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>a kôm, “Tu rachamin mo hi neinunngei hih ni sin? Ma anga rachamneina hi tumo nang pêk?” tiin an rekela.<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>Jisua'n an kôm, “Kei khomin chongbâi khat nangni rekel ka ta, male mi nin thuonin chu, tu rachamin mo hi neinunngei hih ki sin nangni ril ki tih, tiin a thuon ngeia. <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>Ni ril roi, John Baptisma tho theina racham hah kho renga mo: Pathien renga mo miriem renga mo?”<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>An lâia anninanâkin an inkhal phut zoia: “Imo ei ti rang? ‘Pathien renga,’ tiin ei thuon lakin, ama'n ‘Itho mo, John hah nin iem loi?’ Mi tîng a ta. <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>Aniatachu, ‘Miriem renga, ei tiin chu’ ” (Mitinin John hah dêipu tatakin an lei bê sikin, mipuingei laka an chia.) <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>Masikin Jisua an thuona chu, “Riet mak meh,” an tia.</para>
  <para style="p" vid="MRK 11:33">Jisua'n an kôm, hanchu, “Kei khomin tu rachamin mo hi neinunngei hih ki sin nangni ril uol no ning,” a tipe ngeia.<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s">Grapebila inlo mingei chongmintêk</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21:33-46</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>Hanchu Jisua'n chongmintêkin an kôm a misîra, “Voikhat chu mi inkhatin grapebil a thoa, bêr a minkula, grape epna rang khur a choia, male angâkna rang in insâng a sina. Hanchu inlo mingei kôm a chuon inlo rangin a pêk ngeia, ram danga khuolchai a se zoia.<note caller="-" style="x"><char style="xo" closed="false">12:1: </char><char style="xt"><ref loc="ISA 5:1">Isa 5:1</ref>,<ref loc="ISA 5:2">2</ref></char></note> <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>Grape pot zora ahongnin chu a chang rangtum lâk rangin inlo mingei kôm a suok inkhat a tîra. <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>Inlo mingeiin a suok hah an lei sûra, an jêma, kut korongin an min se zoi. <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>Hanchu a pumapa'n suok dang a tîr nôka; inlo mingei han a lu an lei mophop pea mâimôk an lei shak bita. <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>A pumapa han suok dang a tîr nôk rêka, amapa hah chu an lei thata; male ma angdênin adang tamtak ngei khom senkhat an lei jêma, senkhat an lei thata. <verse eid="MRK 12:5"/><verse number="6" style="v" sid="MRK 12:6"/>Ha mi han tîr ranga a dôn chu a nâpasal lelê a moroitak vai ha ani zoia; ‘Ka nâipasal hi chu lei jâ ngêt an tih’ tiin a nâipasal hah anûktaka a tîra. <verse eid="MRK 12:6"/><verse number="7" style="v" sid="MRK 12:7"/>Hannirese ha inlo mingei han inkhat le inkhat kôm, ‘Hipa hih a pumapa nâipasal ani hi. Hong roi, ama hih that rei u, male a rochon hih ei ta ani rang!’ an tia. <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>Masikin a nâipasal hah an sûra, an thata a ruok khom grapebil pêntieng an paia.<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>“Hanchu, kho angin mo grapebil pumapa han a lo ngei rang ni zoi?” tiin Jisua'n a rekela. “Hong a ta, ha mingei hah that a ta, grapebil hah donsûi rangin midangngei kut chunga pêk ngei atih.” <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/>Adiktakin hi Pathien lekhabu hih nin pore loi mini?<note caller="-" style="x"><char style="xo" closed="false">12:10,11: </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Lap 118:22-23</ref> </char></note></para>
  <para style="q1" vid="MRK 12:10">“‘In sinpungeiin lung mangmunboi anga an hengpai hah</para>
  <para style="q2" vid="MRK 12:10">akila lung kâmnâng tak achang zoi.<verse eid="MRK 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11"/>Maha Pumapa tho ania;</para>
  <para style="q2" vid="MRK 12:11">ma hih ei mitmua kamâmaruoi sabak na!’” ti hih a tia.<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>Ma chongmintêk hah anni ngei demnân a misîr ani ti an riet sikin; Juda ruoipungeiin Jisua sûr rangin an pûta. Hannirese lokongei hah an chia, masikin ama an mâka, male an rot zoi.<verse eid="MRK 12:12"/></para>
  <para style="s">Chôiruol pêk roia chongrekel</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22:15-22</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>Chongrekelngei leh min ôk rangin phariseengei senkhat le Herod pâla mi senkhat ngei a kôm an tîra. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>Anni ngei hah a kôm an honga, “Minchupu, chongtak ni misîr ngâi ti kin rieta, mingeiin imo an mindon rang kângdoi loiin, tute dingmun lunghâng tho loiin, hannirese mingei rangin Pathien lungdo ni minchu ngâia, Rom Rêng Caesar kôma chôiruol pêk rangin ei Balamin ânkalpui mo? Kin pêk ngei rang mo, kin pêk ngei loi rang mo?” mi ril roh, an tia.<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>Aniatachu Jisua'n an huongvâr tho hah a riet chiena, male an kôm, “Ithomo ni min ôk rang nin tho hi? Duli sumthîr inkhat hah hong chôi ngân hi roi, lei en rong,” tiin a thuon ngeia.<verse eid="MRK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16"/>Inkhat an hongchôi pea, an kôm han, “Tu mâisuo le tu riming mo ani hi?” tiin a rekel ngeia.</para>
  <para style="p" vid="MRK 12:16">Anni ngei han, “Caesar” tiin an thuona.<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>Masikin Jisua'n an kôm, “Asa, hanchu Ceasar ta chu Caesar pêk ungla, male Pathien ta chu Pathien pêk roi,” a tipe ngeia.</para>
  <para style="p" vid="MRK 12:17">Male Jisua chunga han an kamâm sabak zoi.<verse eid="MRK 12:17"/></para>
  <para style="s">Thina renga inthoinôkna chongrekel</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22:23-33</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Hanchu mingei inthoinôkna omak ti ngâi Sadduceengei Jisua kôm an honga, male<note caller="-" style="x"><char style="xo" closed="false">12:18: </char><char style="xt"><ref loc="ACT 23:8">Sin 23:8</ref></char></note> <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>“Minchupu, Moses balam hih kin ta rangin a mizieka: ‘Mîn nâingei nei loiin a lômnu a thisanin chu, a nâipa han ha meithâi hah a luo ngêt rang ani, nâingei an neia athipu ulienpa nâingeia bê ani theina rangin.’<note caller="-" style="x"><char style="xo" closed="false">12:19: </char><char style="xt"><ref loc="DEU 25:5">Bal 25:5</ref></char></note> <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Voikhat chu lâibung sari an oma; ulientakin in a neia male nâingei nei loiin a thia. <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Hanchu inikna han ma nupang ha a luo nôka, male nâingei nei loi dênin a thi nôka. Lâibung inthumna khom ma angdên ania, <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>male anrêngin: ma lâibung sari ngei han ma nupang hah an luo paka, tutên nâingei nei pui loiin an thisan rieia. Anûktaka chu nupangnu khom hah a thia. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Atûn, mithi ngei nâm aringin an inthoinôk nikhuo tikin tu lômnu tak mo ani rang ani zoi? Ma sari ngei laka han amanu hah anrêngin an luo paka” an tia.<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>Jisua'n an kôm, “Idôra dikloi mo nin zoi! Male itho sika mo nin riet mo?” Ma ha Pathien lekhabu le Pathien sinthotheina nin riet loi sika ani. <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Athi ngei aringin an inthoinôk tika chu, invâna vântîrtonngei angin om an ta, innei no ni ngei. <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>Atûn mithi ngei kaithoia an om rang roi chu, Moses lekhabua chîmbuka meichuong chungroia han Pathien'n Moses kôm, “‘Keima Abraham Pathien, Isaac Pathien, Jacob Pathien ki ni,’ tia ânziek hah nin la pore tet ngâi loi mini?<note caller="-" style="x"><char style="xo" closed="false">12:26: </char><char style="xt"><ref loc="EXO 3:6">Jôk 3:6</ref></char></note> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>‘Ama chu aring ngei Pathien ke ani, mithi ngei Pathien nimak. Nin minchâi phar zoi!’” tiin a thuon ngeia.<verse eid="MRK 12:27"/></para>
  <para style="s">Chongpêk roiinpuitak</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat 22:34-40</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:28-34: </char>
      <char style="xt">
        <ref loc="LUK 10:25-28">Luk 10:25-28</ref>
      </char>
    </note>Balam minchupu inkhatin an injêkhômna hah a rieta. Jisua'n Sadduceengei hah thuonna satak a pêk ngei hah a mûn chu a honga, masikin Jisua kôm, “Chongpêkngei murdi lâia khotak hi mo akâmomtak?” tiin arkela.<verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:29,30: </char>
      <char style="xt">
        <ref loc="DEU 6:4">Bal 6:4</ref>,<ref loc="DEU 6:5">5</ref></char>
    </note> Jisua'n a kôm, “Akâmomtak chu ma hih ani: ‘Israelngei rangâi roi! Pumapa<note caller="+" style="f"><char style="fr" closed="false">12:29; </char><char style="fq" closed="false">Pumapa ei Pathien vai hih Pumapa ani; </char><char style="ft" closed="false">aninônchu </char><char style="fq">Pumapa hih ei Pathien ani, Pumapa vai ke.</char></note> ei Pathien vai hih Pumapa ani. <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>Pumapa na Pathien chu nu mulungrîl murdi leh, na ratha murdi leh, nu mulungbôk murdi leh, na râtna murdi leh lungkham roh.’ <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>Inikna chongpêk akâmom nôk chu ma hih ani: ‘Nangma nên lungkham anghan nu bungmingei lungkham roh’ ti hi. Hi Chongpêk inik ngei nêka roiinpui uol reng omak” tiin Jisua'n a thuona.<note caller="-" style="x"><char style="xo" closed="false">12:31: </char><char style="xt"><ref loc="LEV 19:18">Och 19:18</ref></char></note><verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>Balam minchupu han Jisua kôm, “Ani ai duo, Minchupu! Mahi adik, ni ti anghan, Pumapa vai hih Pathien ania male ama pêna chu pathien dang reng omak.<note caller="-" style="x"><char style="xo" closed="false">12:32: </char><char style="xt"><ref loc="DEU 4:35">Bal 4:35</ref></char></note> <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>Male Pathien chu nu mulungrîl murdi leh, nu mulungbôk murdi leh, na râtna murdi leh nu lungkham ngêt rang ania; male nangma nên lungkham anghan nu bungmingei hah nu lungkham ngêt rang ani. Pathien kôma mâichâma sâ pumhâl inbôlnangei le inbôlna adangngei nêkin khom ma chongpêk inik ngei jôm hih akâmom uol ani” a tia.<note caller="-" style="x"><char style="xo" closed="false">12:33: </char><char style="xt"><ref loc="HOS 6:6">Hos 6:6</ref></char></note><verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>Jisua'n inthârtakin a thuon ti a rieta, male a kôm, “Pathien Rêngram renga la mak che,” a tipea.</para>
  <para style="p" vid="MRK 12:34">Masuole chu tutên Jisua kôm chongrekel rangin ngam khâi mak ngei.<verse eid="MRK 12:34"/></para>
  <para style="s">Messiah roia chongrekel</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22:41-46</ref>; <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>Jisua'n Biekina a minchu ngei lâihan an kôm, “Kho angin mo Balam minchupungeiin Messiah chu David richisuonpâr ani rang an ti thei?” <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>David ha Ratha Inthieng mangin:<note caller="-" style="x"><char style="xo" closed="false">12:36: </char><char style="xt"><ref loc="PSA 110:1">Lap 110:1</ref></char></note></para>
  <para style="q1" vid="MRK 12:36">“Pumapa'n ku Pumapa kôm:</para>
  <para style="q2" vid="MRK 12:36">Ka changtieng insung tit roh</para>
  <para style="q2" vid="MRK 12:36">na râlngei ne kepha nuoia ka dar mâka chu” a ti ani.<verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>David han ama hah “‘Pumapa’ a tia; masikin kho angin mo Messiah hih David richisuonpâr ani thei ranga?” a tia.</para>
  <para style="s" vid="MRK 12:37">Jisua'n Balam minchupungei renga inning ranga a rilna</para>
  <para style="r" vid="MRK 12:37">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="LUK 20:45-47">Luk 20:45-47</ref>)</para>
  <para style="p" vid="MRK 12:37">Loko tamtakin Jisua chongril hah râisântakin an rangâia. <verse eid="MRK 12:37"/><verse number="38" style="v" sid="MRK 12:38"/>A minchu ngei anghan, an kôm, “Balam minchupungei renga indîn roi, anni chu kâncholiinchuol hâka lêng an nuom ngâia, bazar muna mîn an jâ ngeia chibai an pêk ngei rangin an nuoma, <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>Synagogngeia sukmun asatak ngei, le khohoithona munngeia, mun hoitak ngei an thang ngâi. <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>Meithâingei sum an sâka an inngei an muruka, male mi huongna rangin asôt tatakin chubai an tho ngâia. Masika han an dûktuongna hah intak uol ok atih” a tia.<verse eid="MRK 12:40"/></para>
  <para style="s">Meithâinu tholôm</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luk 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>Jisua Biekina sumsiena kôla ânsunga, mingeiin asûnga an tholôm thâk ngei hah a ena. Minei tamtakin sum tam tatak an thâka; <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>hanchu meithâi inriengte a honga male damali inik a thâka, maha poisa khat dôr ani. <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>A ruoisingei a koitupa male an kôm, “Nangni ki ril; tholôm dôngna tholôm thâk ngei murdi nêkin hi meithâi inriengte hih a thâk min tam uol tak ani. <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>Midangngeiin chu an nei minieng, an mang minieng ngei an thâka; aniatachu amanu hih chu, ânrieng anghan, a dôn nâm a thâkripa—a ringna ranga a dôn nâm te hah a pêkrip zoi,” a tia.<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s">Jisua'n Biekin sietminmang rang A misîrna</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat 24:1-2</ref>; <ref loc="LUK 21:5-6">Luk 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>Jisua Biekin renga a hong jôk lâihan a ruoisingei lâia mi inkhatin a kôm, “Minchupu, en ta! Lungngei le inngei kamâm aom tie hi!” a tia.<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>Jisua'n a kôm, “Hi in roiinpui ngei hi nu mu na? Lung inkhat luo amuna hin mâkin om no nia; anrêngin misim zit la nîng atih,” a tia.<verse eid="MRK 13:2"/></para>
  <para style="s">Intaknangei le nuomlonangei</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat 24:3-14</ref>; <ref loc="LUK 21:7-9">Luk 21:7-9</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>Jisua chu Biekin mâi tienga Olive Muola ânsung lâihan a kôm, Peter, Jacob, John le Andrew inrûkin a kôm an honga. <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>“Mahi khotika mo ahong om rang? Male ma neinunngei ha ahongtungna rangin imo minsina aom rang? Mi ril roh,” an tia.<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>Jisua'n an kôm, “Tutên nangni an huong loina rangin inning roi,” a tipe ngeia. <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>Mi tamtakin, “Khrista ki ni!” tiin ki rimingin hong an ta, mi tamtak huong an tih. <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>Male anâina mo, alazana mo râl ruhu thurchi ngei nin riet khomin nin jâmminzal no roi. Ma anga neinunngei hah chu aom ngêt rang ani, hannirese amongna chu la ni tak no ni. <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>Jâtngei le Jâtngei lân doi an ta, ramngei le ramngei lân doi an tih, rêngramngei le rêngramngei lân doi an tih. Muntina ningnungei hong a ta, mâitâmngei la chul atih. Ma neinunngei ha nâiha aphutna ngei angin ani rang.<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>“Nangninanâkin nin inning ngêt rang ani. Sûrin la om nin ta, male roijêknamuna tuongin la om nin tih. Synagogngeia jêmpol la ni nin ta; keima jârin rêngngei le roijêkpungei makunga Thurchi Sa misîr pe ngei rangin lân ding nin tih.”<note caller="-" style="x"><char style="xo" closed="false">13:9-11: </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">Mat 10:17-20</ref>; <ref loc="LUK 12:11">Luk 12:11</ref>,<ref loc="LUK 12:12">12</ref></char></note> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>Aniatachu amongna ahong tung mân, Thurchisa hih mi murdi kôm misîrin aom bak ngêt rang ani. <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>Male sûrin nin oma, male roijêknamuna tuongin nin om tikin, nin ti rang lei mindonin azora aphâk mân nin jâmminzal no roi; azora taka, i-ih khom nangni pêka aom tak hah ti roi. Chong nin ti rang ngei hah nangni nin chong ni no nia; anni ngei hah Ratha Inthieng renga ajuong rang ani. <verse eid="MRK 13:11"/><verse number="12" style="v" sid="MRK 13:12"/>Mîn a lâibungngei nanâk khom that rangin la minsûr a ta, male pa khomin ma angdênin a nâingei la minsûr sa a ta, nâingei khomin an nulepangei doi an ta, male that an tih. <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>Keima sikin mitinin nangni la mumâk an tih. Aniatachu tukhom among dêna tuongdierpu chu sanminringin om atih.<verse eid="MRK 13:13"/></para>
  <para style="s">Intakna ichi omtak</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mat 24:15-28</ref>; <ref loc="LUK 21:20-24">Luk 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>“‘Intakna Ichi Omtak’ ha ânding loina rang muna ânding la mu nin tih.” (aporepungei ranga minrietna: mahi aomtie rietthei rese ngei!) “Hanchu Judea rama om ngei hah tângngei chunga han rot ngêt rese ngei.” <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>In chunga ompu khomin chumin a chôi rang a in sûnga neinun juong lâk rangin azora minhek tet no rese. <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>Loia ompu khomin a puon va lâk rangin in sûnga kîr tet no rese. <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>Nupang nâivong ngei le nâitesen pomlâi nûngei rangin chu ma nikhuongei hah khodôra ichiruoi mo ani rang! <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>Ma zora hah phalbia atung loina rangin Pathien kôm chubaitho roi. <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>Ma nikhuongeia intaknangei ha chu Pathien'n rammuol a sinphut renga avien sûn tena rammuolin a lei riet ngâi murdi nêkin ânchungtak ani rang sikin. Ma anga neinun ha chu khotiklâi khomin om nôk tet khâi no ni.<note caller="-" style="x"><char style="xo" closed="false">13:19: </char><char style="xt" closed="false"><ref loc="DAN 12:1">Dan 12:1</ref>; <ref loc="REV 7:14">Chph 7:14</ref></char></note> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>Aniatachu ma nikhuongei hah Pumapa'n a minbong ania; ninorese chu tute ring thei no ni ngei. Nikhomrese, a thangsai a mingei sikin ma nikhuongei hah a minbong ani.<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>“Hanchu, tukhomin nin kôm, ‘En ta, hin Messiah aom!’ aninônchu, ‘En ta, son aom!’ an ti khomin maha iem no roi. <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>Messiah rotholngei le dêipu dikloingei an inlang rang sikin. Pathien'n a thangsai a mingei tena khom anitheiin chu an huong theina rangin sininkhêlngei le kamâmruoi neinunngei tho an tih. <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>Nangni chu inningchienin om roi! Azora ahong tung mân khokhoi khom nangni ke lei ril let zoi ani.<verse eid="MRK 13:23"/></para>
  <para style="s">Miriem Nâipasal juong rang roi</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24:29-31</ref>; <ref loc="LUK 21:25-28">Luk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>“Ma intakna nikhuongei le azora avun suo nûkin chu nisa hah hong jîng a ta, tha khom vâr khâi no nia,<note caller="-" style="x"><char style="xo" closed="false">13:24: </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="JOL 2:10">Joel 2:10</ref>,<ref loc="JOL 2:31">31</ref>; <ref loc="JOL 3:15">3:15</ref>; <ref loc="REV 6:12">Chph 6:12</ref>; </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="EZK 32:7">Ezek 32:7</ref></char></note> <verse eid="MRK 13:24"/><verse number="25" style="v" sid="MRK 13:25"/>ârsingei khom invân renga joungtâk an ta, male munronga sinthotheinangei khom an omnangei renga inthîn pai atih.<note caller="-" style="x"><char style="xo" closed="false">13:25: </char><char style="xt" closed="false"><ref loc="ISA 34:4">Isa 34:4</ref>; <ref loc="REV 6:13">Chph 6:13</ref>; </char><char style="xt" closed="false"><ref loc="JOL 2:10">Joel 2:10</ref></char></note> <verse eid="MRK 13:25"/><verse number="26" style="v" sid="MRK 13:26"/>Hanchu Miriem Nâipasal hih sinthotheina inlaltak le roiinpuitak leh sumngei lâia khin juong inlang atih.<note caller="-" style="x"><char style="xo" closed="false">13:26: </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7:13</ref>; <ref loc="REV 1:7">Chph 1:7</ref></char></note> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>Ama'n philchung kôlkil minlia, kôlmong kângkhat renga kôlmong kângkhat dênin rammuol pumpuia, Pathien'n a thangsai a mingei mintûp rangin a vântîrtonngei tîr atih.<verse eid="MRK 13:27"/></para>
  <para style="s">Theichang kung renga inchuna</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat 24:32-35</ref>; <ref loc="LUK 21:29-33">Luk 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>“Theichang kungin nangni minchu rese. Amachangngei ahong ema, ahong innoia male abuongei ahong incherin chu kholum hih anâi zoi ti nin riet ngâi. <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>Ma angdênin, nangni khomin ma neinunngei hah ahongtung nin mu tika chu azora<note caller="+" style="f"><char style="fr" closed="false">13:29: </char><char style="fq" closed="false">azora ahong nâi zoi, ânphut rang ani zoi; </char><char style="ft" closed="false">aninônchu </char><char style="fq" closed="false">ama hih anâi zoi, juong rangin ânzoi sai kêng ani zoi.</char></note> ahong nâi zoi, ânphut rang ani zoi tiin nin riet rang ani. <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>Ma neinunngei murdi hah atûnlâia mingei hih an thi riei mân ahongtung rang tiin riettit roi. <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>Pilchung le invân inmang pai a ta, hannirese ko chongbâingei chu inmang pai tet no ni.<verse eid="MRK 13:31"/></para>
  <para style="s">Tutên anikhuo aninônchu azora riet mak ngei</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mat 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>“Nikhomrese, anikhuo aninônchu azora chu khotika mo ahongtung rang, invâna vântîrtonngei khomin, Nâipasal khomin, tutên riet mak ngei; Pa vai kêng a riet ani.<note caller="-" style="x"><char style="xo" closed="false">13:32: </char><char style="xt" closed="false"><ref loc="MAT 24:36">Mat 24:36</ref></char></note> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>Azora hah khotika mo ahongtung rang nin riet loi sikin, inningchien ungla, intûngchienin om roi. <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>Maha chu mîn a in a mâka, a tîrlâmngei rachamneina a pêk ngeia, an sintho rang a pêk ngei chita, inkhârôtpu khom inningchiena om ranga chong a mâk pea, ram lataka khuolse angin ani.<note caller="-" style="x"><char style="xo" closed="false">13:34: </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">Luk 12:36-38</ref></char></note> <verse eid="MRK 13:34"/><verse number="35" style="v" sid="MRK 13:35"/>Masikin inningchienin om roi, in pumapa hong rang zora hah kholoia mo, jânchima mo, ârkhuona mo, jînga mo, ahongtung rang nin riet loi sikin. <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>Inningloiin a hong duoi khomin, a inin nangni hong mu tet no rese. <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>Hanchu, nin kôma ki ti hih mi murdi kôm ki ti ani: inningchienin om roi!” a tia.<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s">Jisua that rangtie an mintuo</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>; <ref loc="JHN 11:45-53">Joh 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>Kalkân kût le Cholboi Vâipôl Kût rang sûnnik motona ochaisingei le Balam minchupungeiin Jisua inrûktea sûra male that rang lampui an rok banga.<note caller="-" style="x"><char style="xo" closed="false">14:1: </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Jôk 12:1-27</ref></char></note> <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>“Khohoi sûngin chu ei tho tet rang nimak,” aninônchu “mingei lâia injêlna om duoi ni,” an tia.<verse eid="MRK 14:2"/></para>
  <para style="s">Bethany taka Jisua sariek polin aom</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26:6-13</ref>; <ref loc="JHN 12:1-8">Joh 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>Jisua chu Bethany taka Simon phârpa ina a oma, Jisua bunêk lâitakin, nuvengte inkhat nard sariek mirimhoi man luttak alabaster bilôr sipmat a hongchôia. Amanu han bilôr hah a khoia male a lu chunga a buoka.<note caller="-" style="x"><char style="xo" closed="false">14:3: </char><char style="xt" closed="false"><ref loc="LUK 7:37">Luk 7:37</ref>,<ref loc="LUK 7:38">38</ref></char></note> <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>Ha muna om mingei senkhatin chu an ningathika, “Khoitho mo hi sariek mirimhoi hih an minpâmchien hi? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Duli<note caller="+" style="f"><char style="fr" closed="false">14:5: </char><char style="fk" closed="false">Duli ngei: </char><char style="ft" closed="false">6:37 en roh.</char></note> razan thum nêka tama juora asum hah inrieng ngei pêk thei ke ani duo!” an tia. Male amanu hah asân an chierkhum zoi.<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>Hannirese, Jisua'n an kôm, “Amanu hah atheiin mâk roi! Khoitho mo nin jêl hi? Ka ta rangin neinun satak le enhoitak a tho ani. <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>Mi inrieng ngei chu nin kôma an omtit rang an nia, male nin nuom titika nin san thei. Aniatachu keima chu nin kôm hin omtit no ning.<note caller="-" style="x"><char style="xo" closed="false">14:7: </char><char style="xt" closed="false"><ref loc="DEU 15:11">Bal 15:11</ref></char></note> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>Amanu hih a theidôrin a tho ania; ka takpum hih phûm ranga lei cherêla mirimhoi a lei buok ani. <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>Atûn hin, adiktakin nangni ki ril, rammuol pumpuia Thurchisa an misîrna muntina hinu sintho khom hi an riettitna rangin misîr sa ngâi an tih,” a tia.<verse eid="MRK 14:9"/></para>
  <para style="s">Judas'n Jisua minsûr rang a jôtna</para>
  <para style="r">(<ref loc="MAT 6:14-16">Mat 6:14-16</ref>; <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>Hanchu ruoisi sômleinik ngei lâia mi inkhat, Judas Iscariot han Jisua a minsûr theina rangin ochaisingei kôm ava sea. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>A ti rang an lei rieta an râiasân sabaka, male sum pêk rangin an inkhâma. Masikin Judas han Jisua ha an kuta a bâng theina rangin chuminrên a rok zoi.<verse eid="MRK 14:11"/></para>
  <para style="s">Jisua'n a Ruoisingei leh Kalkân Kût bukhalâi an ot</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26:17-25</ref>; <ref loc="LUK 22:7-14">Luk 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Joh 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Khohoia Cholboi Vâipôl bukhalâi otni sûn masatak han, Kalkân Kût bukhalâi otna ranga belritengei an that ngâi ni han a ruoisingeiin a kôm, “Nangma rangin Kalkân Kût bukhalâi hih khonmo nang va minsûk pe unglang nu nuom?” tiin an rekela.<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>Hanchu a ruoisingei mi inik hi rilnangei lehin a tîr ngeia: an kôm, “Khopuiliena se ungla, male pasal tui-ûm rokot nangni intongpui atih. Ama hah jûi ungla <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>a lûtna taka in pumapa kôm han: ‘Minchupu'n, khonmo ku ruoisingei le Kalkân Kût kin sâkna rang khâltan hih?’ a ti, va ti roi. <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>Hanchu ama rengin khâltan chunginchuon inzar lienpa, neinun aom sai, mintuodir sai nangni min mûng a ta, mahan eini rangin va minsûk roi,” a tia.<verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>Ruoisingei ha an inphêta, khopuilien han an sea, Jisua'n a ril ngei anghan neinun murdi ha an va mua; Kalkân Kût bukhalâi hah an va minsûk zoi.<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>Kholoi ahongni lehan, Jisua hah ruoisi sômleinik ngei leh an se zoia. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>Dosânga bukhalâi an ot lâitakin Jisua'n, “Nangni ki ril; nin lâia mi inkhat, ko kôma sâk mi sâkpuipu lelê hin ni minsûr atih” a tipe ngeia.<note caller="-" style="x"><char style="xo" closed="false">14:18: </char><char style="xt" closed="false"><ref loc="PSA 41:9">Lap 41:9</ref></char></note><verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>Ruoisingei an mulungdûk atông pe ngeia, male inkhat suole inkhat adônin, “Adiktakin keima mo mi ni tina?” tiin an rekel paka.<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>Jisua'n an kôm, “Nangni sômleinik ngei lâia inkhat, mâirânga a vâipôl mi michie puipu hi ani. <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>Pathien Lekhabu'n, Miriem Nâipasal hih a thi ranga a lei ti anghan a thi rang ania; hannirese Miriem Nâipasal minsûrpu chungroi chu ântak sabak rang! Ma miriem rangin chu ânzir loi nisenla chu ama rangin asa uol rang ani!” tiin a thuon ngeia.<verse eid="MRK 14:21"/></para>
  <para style="s">Pumapa jânbu</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat 26:26-30</ref>; <ref loc="LUK 22:14-20">Luk 22:14-20</ref>; <ref loc="1CO 11:23-25">1 Kor 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>An sâk lâitakin, Jisua'n vâipôl hâr a lâka, chubaithôn râisânchong a rila, maha a khoia, male a ruoisingei kôm maha a pêk ngeia. “Lâk ungla sâk roi,” ama'n, “ma hih ka taksa ani,” a tia.<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>Hanchu kilât a lâka, Pathien kôm râisânchong a rila, male maha a pêk ngeia; male anrêngin an nêk pak zoi. <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>Jisua'n an kôm, “Ma hih ki thisen mi tamtak ranga asuok, Pathien chonginkhitna athar mindetna ani.<note caller="-" style="x"><char style="xo" closed="false">14:24: </char><char style="xt" closed="false"><ref loc="EXO 24:8">Jôk 24:8</ref>; </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Jer 31:31-34</ref></char></note> <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>Nangni ki ril, Pathien Rêngrama uain thar ke nêk ni atung mâka chu hi uain hih nêk nôk khâi noning” a tia.<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>Hanchu minpâkna lâ inkhat an thoa, Olive Muola an se zoi.<verse eid="MRK 14:26"/></para>
  <para style="s">Jisua'n Peter a ipdel rang a leiphuong</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Joh 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>Jisua'n an kôm, “Nin rêngin rot riei nin ta, ni mâk riei nin tih, Pathien lekhabu'n, ‘Pathien'n belrihôlpu hah that a ta, belringei ha chekinchâi chit an tih’ ati sikin.<note caller="-" style="x"><char style="xo" closed="false">14:27: </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zak 13:7</ref></char></note> <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>Aninâkachu aringin kên thoinôk suole chu Galilee rama nin motona lei se ki tih,” a tia.<note caller="-" style="x"><char style="xo" closed="false">14:28: </char><char style="xt" closed="false"><ref loc="MAT 28:16">Mat 28:16</ref></char></note><verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>Peter'n a kôm, “Adangngei nâmin nang mâksan riei khomsenla ngeia, keiman chu nang mâksan tet no ning!” tiin a thuona.<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>Jisua'n Peter kôm, “Nang ki ril avien jân voinik ârkhuong mân nangman voithum mi ipdel ni tih,” a tipea.<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>Peter'n chong angar uolin a thuona, a kôm, “Ni thina thisa rang khom ni ronga nang ipdel tet noning!” a tia.</para>
  <para style="p" vid="MRK 14:31">Male ruoisi adangngei nâm khomin ma angdênin an ti paka.<verse eid="MRK 14:31"/></para>
  <para style="s">Gethsemania Jisua chubaitho</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat 26:36-46</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>Gethsemani an ti mun hah an hong tunga, male Jisua'n a ruoisingei kôm, “Chubai ko tho sûngkâr chu mahin lei insung roi,” a tipe ngeia. <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>Peter, Jacob le John ngei hah a kôm a tuong ngeia, asân rathânvaiin a mulungdûk atong tataka, <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>male an kôm, “Ku mulungdûk ana rai sikin thi rang angin ke ko om zoi. Mahin om ungla male inningchienin om roi” a tipe ngeia.<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>Amoton tieng ava se uol vieta, pila ânboka, male ha tuongna rang zora ha anitheiin chu a lôi theina rangin chubai a thoa. <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>“Pa,” “O ka Pa! Nangma rangin chu neinunngei murdi anithei let. Hi tuongna kilât hih ko kôm renga mi khâi pai pe roh. Aniatachu keima ka racham niloiin nangma na racham tak nirse,” tiin chubai a thoa.<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>Hanchu a hongkîra, male ruoisi inthum ngei hah an innin a hong mu ngeia, Peter kôm han “Simon, na la in tit mo? Konta khat luo amengin nin om thei loi mo?” <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>Male an kôm, “Huongna nin lût loina rangin inningchienin om ungla, male chubaitho roi. Ratha'n chu a nuoma, hannirese taksân chu phâri mak” a tipe ngeia.<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>Vêlkhat a va se nôka, male chongbâingei a ti dên hah va tiin chubai ava tho nôka. <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Hanchu a ruoisingei tieng a hongkîr nôka, male an lei in dênin a hong mu ngei nôka; an mitngei reng meng thei khâi maka. Male a kôm ti rang khom riet khâi mak ngei.<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>Avoithumna a hongkîr nôkin chu an kôm, “Atûn ten khom sôlinngamin nin la in dêna? Ahun zoi! Azora ahong tung zoi! En ta u, atûn Miriem Nâipasal hih mi nunsiengei sinthotheina kuta bangin aom rang ani. <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>Inthoi ungla, se ei tih u zoi. En ta u, mahin mi minsûr rangpu hih a hong nâi zoi!” a tipe ngeia.<verse eid="MRK 14:42"/></para>
  <para style="s">Jisua an sûr</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>; <ref loc="JHN 18:3-12">Joh 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Jisua a la chong lâitakin, a ruoisi sômleinik ngei lâia Judas hah a hongtung kelena. Ama leh ochaisingei, Balam minchupungei le upangei leh lokongei an hongtîr ngeia, khandaingei le molbongngei chôiin an hongtunga. <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>A minsûr rangpu han, “A bieng ku tum tak hah nin rokpu hah ani, sûr ungla male tuong kelen roi, enkol roi” tiin minsinna a lei ril ngei sai ani.<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>Judas a hongtung harenghan, Jisua kôm ava se kelena, “Minchupu!” tiin a bieng a tum pea. <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>Masikin Jisua hah an sûra male an khitbel zoi. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>Hataka inding ngei lâia mi inkhatin a khandai a kêlsuoa male Ochai Inlaltak suok, a kuor a tukthâk pe zoi. <verse eid="MRK 14:47"/><verse number="48" style="v" sid="MRK 14:48"/>Hanchu Jisua'n anni ha a rokôka, an kôm “khandaingei le molbongngei chôiin balampalpu sûr rang angin mi sûr rangin nin hong mo hi? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>Anîngtin Biekina nangni minchu rangin nin kôm ko om ngâia, hannirese mi sûr mak choia. Aniatachu Pathien Lekhabungei ahongtung adik ngêtna ranga ani hi,” a tia.<note caller="-" style="x"><char style="xo" closed="false">14:49: </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luk 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char></note><verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>Hanchu a ruoisingei han ama an mâk raka, male an tân khip zoi.<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>Ruotharte inkhat, rosompuon leh vai invôn Jisua a jûia. Ama khom sûr sa rang an pûta, <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>hannirese a puon hah mâkrakin a korongin a tânpat zoi.<verse eid="MRK 14:52"/></para>
  <para style="s">Jisua roijêkna makunga ânding</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mat 26:57-68</ref>; <ref loc="LUK 22:54-55">Luk 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Joh 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Hanchu Jisua hah Ochai Inlaltak ina an tuonga, mahan ochaisingei nâm le Balam minchupungei le upangei khom an hong intûp sa kelena. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>Peter'n alazanna renga a jûia, Ochai Inlaltak khalâidung dênin a sea. Mahan a rungpungei lâia mei ava uota. <verse eid="MRK 14:54"/><verse number="55" style="v" sid="MRK 14:55"/>Ochaisingei le roijêkpungei murdi han Jisua an that theina rangin a minchâina an man theina rang abi an mazama, aniatachu ite man mak ngei. <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>Rietpuipungei tamtakin Jisua doiin milakin an nônna, hannirese, an nônna thurchingei hah intok thei mak.<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57"/>Mi senkhat an indinga male Jisua doiin milakin an nônna: <verse eid="MRK 14:57"/><verse number="58" style="v" sid="MRK 14:58"/>“Hi mi hin, miriemin an lei sin ‘Biekin hih set ka ta, male sûnthumin adang inkhat kuta sin niloi in minding ki tih’ a ti kin riet” an tia.<note caller="-" style="x"><char style="xo" closed="false">14:58: </char><char style="xt" closed="false"><ref loc="JHN 2:19">Joh 2:19</ref></char></note> <verse eid="MRK 14:58"/><verse number="59" style="v" sid="MRK 14:59"/>Nikhomrese, ma an nônna thurchingei hah khom intok uol maka.<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>Ochai Inlaltak hah an renga an moton han a vândinga, male Jisua kôm chong a rekela, “Nang an nônna roia hin ite thuonna no dôn loi rang mo?” a tia.<verse eid="MRK 14:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61"/>Aniatachu Jisua chu a dâireka, male chongbâi khat luo ti maka. Avêlin Ochai Inlaltak han a kôm, “Nangma ha Satvura om Pathien Nâipasal, Messiah hah ni ni mo?” tiin a rekel nôka.<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>Jisua'n a kôm, “Ki ni,” male, “Miriem Nâipasal hih Râtinchung chang tieng insungin, invâna sûmngei lâia juong nin rêngin la mûng nin tih!” tiin a thuona.<note caller="-" style="x"><char style="xo" closed="false">14:62: </char><char style="xt" closed="false"><ref loc="DEU 7:13">Bal 7:13</ref></char></note><verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>Ochai Inlaltak han a puonsilngei a potkhêra, male “Rietpuipu adang reng nâng khâi mak meh! <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>Pathien ânti le a rilsiet ti chu nin riet zoia. Imo nin roimasat?” a tia.<note caller="-" style="x"><char style="xo" closed="false">14:64: </char><char style="xt" closed="false"><ref loc="LEV 24:16">Och 24:16</ref></char></note></para>
  <para style="p" vid="MRK 14:64">An rêngin ama an doia: ama hih theiloina a dôna male that rang piel ani an ti paka.<verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>Senkhat ngeiin a mâi an michil phuta, a mâi an hîp pea, male an jêma. A kôm, “Mi ril roh tumo nang a jêm!” an tia. Male rungpungei han an tuonga male ama an bên zoi.<verse eid="MRK 14:65"/></para>
  <para style="s">Peter'n Jisua a ipdel</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mat 26:69-75</ref>; <ref loc="LUK 22:56-62">Luk 22:56-62</ref>; <ref loc="JHN 18:15-18">Joh 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>Peter hah thangtienga khalâidunga a la om lâihan Ochai Inlaltak tîrlâm dôngmate inkhat a honga. <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>Peter mei lei uot hah a mu lehan a enririna, a kôm, “Nangma, khom Nazareth Jisua leh munkhata om ngâi ni ni nah” a tipea.<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>Hannirese Peter'n a ipdela, “Riet mu-ung Khoimo ni ti reng rietthei mu-ung,” tiin a thuona, male mokot pêntieng ava jôka. Masuole han âr akhuong<note caller="+" style="f"><char style="fr" closed="false">14:68: </char><char style="ft" closed="false">Miziek senkhat ngei chu </char><char style="fq" closed="false">Masuole han âr akhuong kelen zoi, ti hih dôn mak ngei.</char></note> kelen zoi.<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>Tîrlâm dôngmate han a va mu nôka, a kôla inding ngei kôm han, “Hipa hih khom an lâia mi inkhat ani sa!” a ti nôka. <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>Aniatachu Peter'n a ipdel nôk rêka.</para>
  <para style="p" vid="MRK 14:70">Chomolte suole chu a kôla inding ngeiin Peter kôm, “Galilee rama mi ni ni sa sikin nang khom an lâia mi ni ni khet,” tiin an deia.<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>Hanchu Peter'n an kôm, “Chongtak rilin khomâk kên sâm ani! Adik nônchu Pathien'n dûk ni tho rese! Ma miriem nin ti chungroi hah riet reng riet tatak ngâi mu-ung!” a tia.<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>Masuole han âr voinikna ahong khuong nôk zoia, male Jisua'n Peter kôm han, “Âr voinik akhuong mân nangman voithum keima hi riet ngâi mu-ung ni ti rang,” a tipe chong hah a hong rietsuok nôka. Male a mulungakoi pea, a chap ngu-ngûi zoi.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s">Jisua Pilat makunga ânding</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luk 23:1-5</ref>; <ref loc="JHN 18:28-38">Joh 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Jînga inmânin innottakin, ochaisingei ha upangei le Balam minchupungei, le Roijêkpungei murdi leh an intônga male mintuonangei an sina. Jisua ha zingjirûi leh an khita an tuong paia, male Pilat kuta an bânga. <verse eid="MRK 15:1"/><verse number="2" style="v" sid="MRK 15:2"/>Pilat'n chong a rekela, a kôm, “Judangei rêngpa ni ni mo?” a tia.</para>
  <para style="p" vid="MRK 15:2">Jisua'n, “Nangman ke mi ni ti duo” tiin a thuona.<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>Ochaisingei han abi tamtakin Jisua an nônna, <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>masikin Pilat'n Jisua kôm chong a rekel nôka, “Nangman nu thuonloi rang mo? nang an nônnangei nâm hih rangâi roh!” a tia.<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>Avêlin Jisua'n chongbâi khat luo ti rang nuom maka, male Pilat'n a kamâm sabak zoia.<verse eid="MRK 15:5"/></para>
  <para style="s">Jisua hih thi rangin a roijêkmasat ani</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat 27:15-26</ref>; <ref loc="LUK 23:13-25">Luk 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Joh 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Pilat'n chu Kalkân Kût zora zeta mi intâng ina aom inkhat mingeiin an ngên tak ha a mojôk pe ngei ngâi a baisi ani. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>Ma zora han mi inkhat a riming Barabbas hah, mi ânhelngei pâla mi, le loko injêlna kâra mi that sika intâng ina a oma. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Lokongei an intûpa male anni ranga a lei tho pe ngei ngâi anghan tho rangin an ngên lâihan, <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>Pilat'n an kôm, “Judangei rêngpa hih nangni mojôk pe inlang nin jôt mo?” tiin a rekel ngeia. <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Ochaisingei han an narsa sika Jisua hah a kut chunga an hong bâng ani ti a riet minthâra.<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>Aninâkachu Ochaisingei han mipuingei hah Barabbas a mojôk pe ngei ranga ngên rangin an misiet ngeia. <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>Hanchu Pilat'n an kôm, “Aninte, Judangei rêngpa nin tipu hih imo ko lo rang ani zoi?” tiin a rekel ngei nôka.<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>Anni han, “Khrosa jêmdel roh!” tiin an iniek nôka.<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>Hannirese Pilat'n an kôm, “Imo a tho minchâi?” tiin a rekel ngei nôka.</para>
  <para style="p" vid="MRK 15:14">Anni ngei han, “Khrosa jêmdel roh!” tiin ânring uolin an inieka.<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>Pilat'n lokongei râiminsân a nuoma, masikin Barabbas hah a mojôk pe ngeia. Hanchu Jisua hah a vîka male Khrosa jêmdel rangin an kuta a bâng zoia.<verse eid="MRK 15:15"/></para>
  <para style="s">Râlmingeiin Jisua an phengsan</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mat 27:27-31</ref>; <ref loc="JHN 19:2-3">Joh 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Râlmingei han Jisua hah râiôt inmâi khalâidunga an tuong lûta, an champui ngei murdi an koi mintûpa. <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>Jisua hah puon senduk an minsila, riling amachangngei hah tapor an phana, male a lua an minkhuma. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Hanchu ama chibai an pêka: “Judangei Rêngpa, ringsôt roh!” an tia. <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>A lua tôkmol leh an jêma, an michila, khûkinbilin chibai an mûka. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>Munuiinjanân an sin suole chu puon senduk hah an lîka, male a puonngei nanâk hah an minsil nôka. Hanchu khrosa jêmdel rangin an tuong zoi.<verse eid="MRK 15:20"/></para>
  <para style="s">Jisua hih khrosa jêmdelin aom</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27:32-44</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>; <ref loc="JHN 19:17-27">Joh 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>Hanchu lampuia mi inkhat ram renga khopuilien hongpan a riming Simon an intôngpuia, male râlmingeiin Jisua khros ruput rangin an dânderita. (Simon hah Cyrene Kurini mi, Alexander le Rufus ngei an pa ani.)<note caller="-" style="x"><char style="xo" closed="false">15:21: </char><char style="xt" closed="false"><ref loc="ROM 16:13">Rom 16:13</ref></char></note> <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Jisua hah Golgotha an ti muna han an tuonga maha aomtie chu “Luru Mun” tina ani. <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Ha muna han a pang ânhipna rangin uain murra loi leh ânpol pêk rangin an pûta, aninâkachu Jisua'n nêk jôt mâka. <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>Hanchu khrosa an jêmdela, male a puonsilngei hah an insema, kho ahâr ha mo an chang rang chit rietna rangin taruo an sânna.<note caller="-" style="x"><char style="xo" closed="false">15:24: </char><char style="xt" closed="false"><ref loc="PSA 22:18">Lap 22:18</ref></char></note> <verse eid="MRK 15:24"/><verse number="25" style="v" sid="MRK 15:25"/>Jisua an jêmdel zora hah jîng dâr kuo inringa ani. <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>Ama doia an nônna minrietna chong hah “Judangei Rêngpa” tiin a lu chunga an târra. <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>Jisua leh munkhatin mi inru inik a changtieng inkhat, male a voitieng inkhat an jêmdel sa.<note caller="+" style="f"><char style="fr" closed="false">15:27: </char><char style="ft" closed="false">Miziek senkhat ngei chu arachang 28 dôn mak ngei: </char><char style="fqa" closed="false">Ma angdên han, Pathien lekhabu'n, “Ama khom mi puoloingei lâia telsân aom zoi” ati hah ahong tung zoi ani </char><char style="ft" closed="false">(Luk 22:37 en roh).</char></note> <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>Ma angdên han, Pathien lekhabu'n, “Ama khom mi puoloingei lâia telsân aom zoi” ati hah ahong tung zoi ani.<note caller="-" style="x"><char style="xo" closed="false">15:28: </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa 53:12</ref></char></note><verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>Hataka mingei ânloi murdi'n an lu an thuka Jisua an êroa, “Ohoi! Biekin set na ta, sûnthumin ni minding nôk rang na!<note caller="-" style="x"><char style="xo" closed="false">15:29: </char><char style="xt" closed="false"><ref loc="PSA 22:7">Lap 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>; </char><char style="xt" closed="false"><ref loc="MRK 14:58">Mk 14:58</ref>; <ref loc="JHN 2:19">Joh 2:19</ref></char></note> <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>Atûn khros renga juong chum inla, nethenin insan mojôk roh ba!” an tia.<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>Ha angdênin ochaisingei le Balam minchupungei khomin Jisua an phengsana, “Midangngei chu a mojôk thei ngâia, hannirese ama le ama chu insan mojôk thei mak! <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>Tho atûn chu Messiah, Israelngei rêngpa hih khros lêr renga a juong chum lei en rei u, male ama ei iem rang ani!” an tia.</para>
  <para style="p" vid="MRK 15:32">Ama leh an jêmdel sa mi inik ngei khomin Jisua an êro sa zoi.<verse eid="MRK 15:32"/></para>
  <para style="s">Jisua thina roi</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>; <ref loc="JHN 19:28-30">Joh 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Sûnchima konta inthum sûng chu rammuol ajîng khapa. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>Chonûk dâr inthum inring han chu Jisua rôl inringtakin ân-ieka, <char style="tl">“Eloi, Eloi, lama sabakthani?” </char> a tia, maha, “Ka Pathien, ka Pathien, Ithomo mi ni mâksana?” tina ani.<note caller="-" style="x"><char style="xo" closed="false">15:34: </char><char style="xt" closed="false"><ref loc="PSA 22:1">Lap 22:1</ref></char></note><verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>Ha muna omngei senkhatin a he an rieta, male “Rangâi ta u, Elijah a koi ke!” an tia. <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>An lâia mi inkhat a tânna, patjôn, uain thûra a michiejûta, tôkmol monga a târra. Hanchu Jisua ner a hong min tônna, male “La ôt rei u! Khros renga ama musum rangin Elijah mo a juong pe lei en rei u!” a tia.<note caller="-" style="x"><char style="xo" closed="false">15:36: </char><char style="xt" closed="false"><ref loc="PSA 69:21">Lap 69:21</ref></char></note><verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>Jisua'n rôl inringtakin ân-ieka, a rangachat zoi.<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>Hanchu, Biekina puondal dûnga om hah inikin achung renga among dênin akêr phata.<note caller="-" style="x"><char style="xo" closed="false">15:38: </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Jôk 26:31-33</ref></char></note> <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Râlmi ulien khros motona ândingpu hah Jisua a rangachat<note caller="+" style="f"><char style="fr" closed="false">15:39: </char><char style="fq" closed="false">a thi zoi; </char><char style="ft" closed="false">miziek senkhat ngei an dôn chu ân ieka male a thi zoi.</char></note> tie hah a mua “Hi mi hih Pathien Nâipasal ani khet!” a tia.<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">15:40,41: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:2">Luk 8:2</ref>,<ref loc="LUK 8:3">3</ref></char>
    </note>Ha muna, nupang senkhat ngei khom alazanna renga thîrin an oma; ma ngei hah Mary Magdalene, Mary Jacob nâipang le Joseph ngei an nû, le Salome ngei an ni. <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>Ma ngei hah Jisua Galilee rama a om lâihan an jûi ngâia, male an san ngâi ani. Nupang tamtak Jerusalema ama leh a se ngei khom hah an om sa.<verse eid="MRK 15:41"/></para>
  <para style="s">Jisua an phûm</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>; <ref loc="JHN 19:38-42">Joh 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43"/>Kholoi ahongnin chu Arimathea mi Joseph a hongtunga. Ama hah Roijêkpungei lâia jâ omtak ania, Pathien Rêngram juong tung rang lei ngâkpu ani. Maha Incherêlni (maha, Sabbathni motona sûn hah ani), masikin Joseph'n hâitakin Pilat kôm a va sea Jisua ruok ha ava zonga. <verse eid="MRK 15:42-43"/><verse number="44" style="v" sid="MRK 15:44"/>Pilat'n Jisua chu a thi zoi tiin a riet lehan a kamâm tataka, râlmi ulien inkhat a koia, Jisua thina asôt zoi mo? tiin a rekela. <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>Râlmi ulien bâi renga chong ânthârin a riet suole chu a ruok hah Joseph chôi rangin a phal pe zoia. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>Joseph'n rosompuon a rochôka, ruok hah a musuma, rosompuon lehan a tuoma, lungpuia hel thânkhura han a min jâla. Hanchu thân kotbâi hah lung lienpa muluoiin a hîpa. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>Mary Magdalene le Joseph nû Mary han Jisua ruok an min jâlna hah an ena, an mu chien zoi ani.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s">Jisua inthoinôkna</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat 28:1-8</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>; <ref loc="JHN 20:1-10">Joh 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Sabbathni avun suole chu Mary Magdalene, Jacob nû Mary, le Salome ngei han Jisua ruok sariek va pol rangin mirimhoi an rochôka. <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>Pathienni jînga nisa suok chakin thâna an va sea. <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>Lampuia han, “Thân kotbâia lung hah tumo mi muluoi pai pe rang hi?” tiin annin kereng inlôma. <verse eid="MRK 16:3"/><verse number="4" style="v" sid="MRK 16:4"/>Maha lung lienpa ani sikin. Hanchu an hong ena, lung hah lei muluoi saiin an mua. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>Masikin thân sûnga han an lûta, ruotharte inkhat puonchek insilin chang tienga insungin an mua, male an inlâiraka.<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>Ama'n an kôm, “Inlâirak no roi,” Nazareth Jisua an jêmdelpu hah nin rok ani ti ki riet. Ama hah mahin om khâi maka, ânthoinôk zoi! En ta u, an min jâlna hi. <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Atûn, se ungla, hi thurchi hih a ruoisingei le Peter kôm han: “Galilee rama nin motona se a ta; ‘nangni a lei ril sai anghan mason mu nin tih’ tiin va ril ngei roi” a tipe ngeia.<note caller="-" style="x"><char style="xo" closed="false">16:7: </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mat 26:32</ref>; <ref loc="MRK 14:28">Mk 14:28</ref></char></note><verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>Masikin an jôk paia, beidong le rathatâk pumin thân renga an tânna. An chi rai sikin, tute kôm ite ti mak ngei.</para>
  <para style="s" vid="MRK 16:8">THURCHISA AMONGNA AMURUO<note caller="+" style="f"><char style="fr" closed="false">16:8: </char><char style="ft" closed="false">Miziek senkhat ngei le tiena chongmetngeiin chu hi (arachangngei 9-20) Thurchisa amongna hih dôn mak ngei.</char></note></para>
  <para style="s" vid="MRK 16:8">Mary Magdalene kôm Jisua ânlâr</para>
  <para style="r" vid="MRK 16:8">(<ref loc="MAT 28:9-10">Mat 28:9-10</ref>; <ref loc="JHN 20:11-18">Joh 20:11-18</ref>)</para>
  <para style="p" vid="MRK 16:8">[<verse eid="MRK 16:8"/><verse number="9" style="v" sid="MRK 16:9"/>Masuole chu Pathienni jînga thina renga ânthoinôka Mary Magdalene, a sûng renga ramkhoringei sari a rujûlpai pe nu kôm han amotontaka Jisua ânlâra. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Amanu hah a sea, a champuingei ava ril ngeia. Anni ngei hah ngâisie le chapin an lei oma; <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>male amanu han Jisua chu aring nôk zoia, male mu khom ku mu khet, a tipe ngei lâihan anni ngei han amanu hah iem mak ngei.<verse eid="MRK 16:11"/></para>
  <para style="s">Nûkjûingei inik kôm Jisua ânlâr</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luk 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>Masuole han an lâia mi inik ram tieng panin an sea, lampuia mêl dang uolin an kôm ânlâra. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>Anni hah an hongkîra, ruoisi dangngei an hong rila, aniatachu maha khom anni ngei han iem uol mak ngei.<verse eid="MRK 16:13"/></para>
  <para style="s">Sômleikhat ngei kôma Jisua ânlâr</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="LUK 24:36-40">Luk 24:36-40</ref>; <ref loc="JHN 20:19-23">Joh 20:19-23</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>Anûktaka chu, Jisua'n ruoisi sômleikhat ngei bu an nêk lâitakin an kôm ânlâr nôka. Ânthoinôk suole amu ngei chong taksôn loiin an mulung angar sabak sika le iemna reng an dôn loi sikin a ngo ngeia. <verse eid="MRK 16:14"/><verse number="15" style="v" sid="MRK 16:15"/>Ama'n an kôm, “Rammuol pumpuia se ungla, mi murdi kôm Thurchisa hih va misîr roi a tipe ngeia.<note caller="-" style="x"><char style="xo" closed="false">16:15: </char><char style="xt" closed="false"><ref loc="ACT 1:8">Sin 1:8</ref></char></note> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>Tukhom ama iema Baptisma chang ngei chu sanminjôkin om an ta; tukhom a iem loi ngei chu theiloi intumin om an tih. <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>Iempungei chu sininkhêlngei sintheina ranak pêk nîng an ta: ki rimingin ramkhoringei rujûlpai an ta; chong tharin chong an tih; <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>an kutngei leh murûlngei an sûr khomin, aninônchu tûr an nêk khomin itên minna ngei thei no nia; mi damloi ngei chunga an kutngei minngam an ta, male dam kelen an tih” a tia.<verse eid="MRK 16:18"/></para>
  <para style="s">Jisua invâna a kal</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luk 24:50-53</ref>; <ref loc="ACT 1:9-11">Sin 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>Pumapa Jisua'n a chongpui ngei suole chu, invâna khin lâkpaiin aoma, Pathien chang tieng a hong insung zoia.<note caller="-" style="x"><char style="xo" closed="false">16:19: </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">Sin 1:9-11</ref></char></note> <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>Ruoisingei hah an sea male muntina thurchi an va misîr zoia, male Pumapa khomin anni ngei lehan sin a thopui ngeia, an thurchi misîr hah adik ti rietnân sininkhêlngeiin a mindet tir zoi.]<verse eid="MRK 16:20"/></para>
  <para style="s">AMONGNA MURUO ADANG<note caller="+" style="f"><char style="fr" closed="false">16:20: </char><char style="ft" closed="false">Miziek senkhat ngei le tiena chongmeletngeiin chu hi (arachangngei 9-20) Thurchisa amongna abong uol hih an dôna, male amongna sei uol abôk sa khom an om ngâi.</char></note></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="9" sid="MRK 16:21"/> [Nuvengtengei hah Peter le a malngei kôm an sea, male rila an om murdi hah abongkikin an misîr pe ngeia. <verse eid="MRK 16:21"/><verse number="22" style="v" pubnumber="10" sid="MRK 16:22"/> Masuole han, Jisua nanâkin a ruoisingei ha kumtuong Sanminringna aringtit chongbe inthieng hah nisuo renga nitâk dênin misîr rangin a tîr ngei zoi.]<verse eid="MRK 16:22"/></para>
  <chapter eid="MRK 16"/>
</usx>
