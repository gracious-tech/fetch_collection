<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="PHM" style="id">Sanskrit Bible (NT) in Bengali Script (সত্যৱেদঃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Philemon</para>
  <para style="toc1">ফিলোমোনং পত্রং</para>
  <para style="toc2">ফিলোমোনঃ</para>
  <para style="toc3">ফিলোমোনঃ</para>
  <para style="mt1">ফিলোমোনং পত্রং</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>খ্রীষ্টস্য যীশো র্বন্দিদাসঃ পৌলস্তীথিযনামা ভ্রাতা চ প্রিযং সহকারিণং ফিলীমোনং</para>
  <para style="p">
    <verse number="2" style="v"/>প্রিযাম্ আপ্পিযাং সহসেনাম্ আর্খিপ্পং ফিলীমোনস্য গৃহে স্থিতাং সমিতিঞ্চ প্রতি পত্রং লিখতঃ|</para>
  <para style="p">
    <verse number="3" style="v"/>অস্মাকং তাত ঈশ্ৱরঃ প্রভু র্যীশুখ্রীষ্টশ্চ যুষ্মান্ প্রতি শান্তিম্ অনুগ্রহঞ্চ ক্রিযাস্তাং|</para>
  <para style="p">
    <verse number="4" style="v"/>প্রভুং যীশুং প্রতি সর্ৱ্ৱান্ পৱিত্রলোকান্ প্রতি চ তৱ প্রেমৱিশ্ৱাসযো র্ৱৃত্তান্তং নিশম্যাহং</para>
  <para style="p">
    <verse number="5" style="v"/>প্রার্থনাসমযে তৱ নামোচ্চারযন্ নিরন্তরং মমেশ্ৱরং ধন্যং ৱদামি|</para>
  <para style="p">
    <verse number="6" style="v"/>অস্মাসু যদ্যৎ সৌজন্যং ৱিদ্যতে তৎ সর্ৱ্ৱং খ্রীষ্টং যীশুং যৎ প্রতি ভৱতীতি জ্ঞানায তৱ ৱিশ্ৱাসমূলিকা দানশীলতা যৎ সফলা ভৱেৎ তদহম্ ইচ্ছামি|</para>
  <para style="p">
    <verse number="7" style="v"/>হে ভ্রাতঃ, ৎৱযা পৱিত্রলোকানাং প্রাণ আপ্যাযিতা অভৱন্ এতস্মাৎ তৱ প্রেম্নাস্মাকং মহান্ আনন্দঃ সান্ত্ৱনা চ জাতঃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ৎৱযা যৎ কর্ত্তৱ্যং তৎ ৎৱাম্ আজ্ঞাপযিতুং যদ্যপ্যহং খ্রীষ্টেনাতীৱোৎসুকো ভৱেযং তথাপি ৱৃদ্ধ</para>
  <para style="p">
    <verse number="9" style="v"/>ইদানীং যীশুখ্রীষ্টস্য বন্দিদাসশ্চৈৱম্ভূতো যঃ পৌলঃ সোঽহং ৎৱাং ৱিনেতুং ৱরং মন্যে|</para>
  <para style="p">
    <verse number="10" style="v"/>অতঃ শৃঙ্খলবদ্ধোঽহং যমজনযং তং মদীযতনযম্ ওনীষিমম্ অধি ৎৱাং ৱিনযে|</para>
  <para style="p">
    <verse number="11" style="v"/>স পূর্ৱ্ৱং তৱানুপকারক আসীৎ কিন্ত্ৱিদানীং তৱ মম চোপকারী ভৱতি|</para>
  <para style="p">
    <verse number="12" style="v"/>তমেৱাহং তৱ সমীপং প্রেষযামি, অতো মদীযপ্রাণস্ৱরূপঃ স ৎৱযানুগৃহ্যতাং|</para>
  <para style="p">
    <verse number="13" style="v"/>সুসংৱাদস্য কৃতে শৃঙ্খলবদ্ধোঽহং পরিচারকমিৱ তং স্ৱসন্নিধৌ ৱর্ত্তযিতুম্ ঐচ্ছং|</para>
  <para style="p">
    <verse number="14" style="v"/>কিন্তু তৱ সৌজন্যং যদ্ বলেন ন ভূৎৱা স্ৱেচ্ছাযাঃ ফলং ভৱেৎ তদর্থং তৱ সম্মতিং ৱিনা কিমপি কর্ত্তৱ্যং নামন্যে|</para>
  <para style="p">
    <verse number="15" style="v"/>কো জানাতি ক্ষণকালার্থং ৎৱত্তস্তস্য ৱিচ্ছেদোঽভৱদ্ এতস্যাযম্ অভিপ্রাযো যৎ ৎৱম্ অনন্তকালার্থং তং লপ্স্যসে</para>
  <para style="p">
    <verse number="16" style="v"/>পুন র্দাসমিৱ লপ্স্যসে তন্নহি কিন্তু দাসাৎ শ্রেষ্ঠং মম প্রিযং তৱ চ শারীরিকসম্বন্ধাৎ প্রভুসম্বন্ধাচ্চ ততোঽধিকং প্রিযং ভ্রাতরমিৱ|</para>
  <para style="p">
    <verse number="17" style="v"/>অতো হেতো র্যদি মাং সহভাগিনং জানাসি তর্হি মামিৱ তমনুগৃহাণ|</para>
  <para style="p">
    <verse number="18" style="v"/>তেন যদি তৱ কিমপ্যপরাদ্ধং তুভ্যং কিমপি ধার্য্যতে ৱা তর্হি তৎ মমেতি ৱিদিৎৱা গণয|</para>
  <para style="p">
    <verse number="19" style="v"/>অহং তৎ পরিশোৎস্যামি, এতৎ পৌলোঽহং স্ৱহস্তেন লিখামি, যতস্ত্ৱং স্ৱপ্রাণান্ অপি মহ্যং ধারযসি তদ্ ৱক্তুং নেচ্ছামি|</para>
  <para style="p">
    <verse number="20" style="v"/>ভো ভ্রাতঃ, প্রভোঃ কৃতে মম ৱাঞ্ছাং পূরয খ্রীষ্টস্য কৃতে মম প্রাণান্ আপ্যাযয|</para>
  <para style="p">
    <verse number="21" style="v"/>তৱাজ্ঞাগ্রাহিৎৱে ৱিশ্ৱস্য মযা এতৎ লিখ্যতে মযা যদুচ্যতে ততোঽধিকং ৎৱযা কারিষ্যত ইতি জানামি|</para>
  <para style="p">
    <verse number="22" style="v"/>তৎকরণসমযে মদর্থমপি ৱাসগৃহং ৎৱযা সজ্জীক্রিযতাং যতো যুষ্মাকং প্রার্থনানাং ফলরূপো ৱর ইৱাহং যুষ্মভ্যং দাযিষ্যে মমেতি প্রত্যাশা জাযতে|</para>
  <para style="p">
    <verse number="23" style="v"/>খ্রীষ্টস্য যীশাঃ কৃতে মযা সহ বন্দিরিপাফ্রা</para>
  <para style="p">
    <verse number="24" style="v"/>মম সহকারিণো মার্ক আরিষ্টার্খো দীমা লূকশ্চ ৎৱাং নমস্কারং ৱেদযন্তি|</para>
  <para style="p">
    <verse number="25" style="v"/>অস্মাকং প্রভো র্যীশুখ্রীষ্টস্যানুগ্রহো যুষ্মাকম্ আত্মনা সহ ভূযাৎ| আমেন্|</para>
</usx>
