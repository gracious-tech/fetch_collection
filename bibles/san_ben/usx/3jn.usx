<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="3JN" style="id">Sanskrit Bible (NT) in Bengali Script (সত্যৱেদঃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">3 John</para>
  <para style="toc1">৩ যোহনঃ পত্রং</para>
  <para style="toc2">৩ যোহনঃ</para>
  <para style="toc3">৩ যোহনঃ</para>
  <para style="mt1">৩ যোহনঃ পত্রং</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>প্রাচীনো ঽহং সত্যমতাদ্ যস্মিন্ প্রীযে তং প্রিযতমং গাযং প্রতি পত্রং লিখামি|</para>
  <para style="p">
    <verse number="2" style="v"/>হে প্রিয, তৱাত্মা যাদৃক্ শুভান্ৱিতস্তাদৃক্ সর্ৱ্ৱৱিষযে তৱ শুভং স্ৱাস্থ্যঞ্চ ভূযাৎ|</para>
  <para style="p">
    <verse number="3" style="v"/>ভ্রাতৃভিরাগত্য তৱ সত্যমতস্যার্থতস্ত্ৱং কীদৃক্ সত্যমতমাচরস্যেতস্য সাক্ষ্যে দত্তে মম মহানন্দো জাতঃ|</para>
  <para style="p">
    <verse number="4" style="v"/>মম সন্তানাঃ সত্যমতমাচরন্তীতিৱার্ত্তাতো মম য আনন্দো জাযতে ততো মহত্তরো নাস্তি|</para>
  <para style="p">
    <verse number="5" style="v"/>হে প্রিয, ভ্রাতৃন্ প্রতি ৱিশেষতস্তান্ ৱিদেশিনো ভৃाতৃন্ প্রতি ৎৱযা যদ্যৎ কৃতং তৎ সর্ৱ্ৱং ৱিশ্ৱাসিনো যোগ্যং|</para>
  <para style="p">
    <verse number="6" style="v"/>তে চ সমিতেঃ সাক্ষাৎ তৱ প্রম্নঃ প্রমাণং দত্তৱন্তঃ, অপরম্ ঈশ্ৱরযোগ্যরূপেণ তান্ প্রস্থাপযতা ৎৱযা সৎকর্ম্ম কারিষ্যতে|</para>
  <para style="p">
    <verse number="7" style="v"/>যতস্তে তস্য নাম্না যাত্রাং ৱিধায ভিন্নজাতীযেভ্যঃ কিমপি ন গৃহীতৱন্তঃ|</para>
  <para style="p">
    <verse number="8" style="v"/>তস্মাদ্ ৱযং যৎ সত্যমতস্য সহাযা ভৱেম তদর্থমেতাদৃশা লোকা অস্মাভিরনুগ্রহীতৱ্যাঃ|</para>
  <para style="p">
    <verse number="9" style="v"/>সমিতিং প্রত্যহং পত্রং লিখিতৱান্ কিন্তু তেষাং মধ্যে যো দিযত্রিফিঃ প্রধানাযতে সো ঽস্মান্ ন গৃহ্লাতি|</para>
  <para style="p">
    <verse number="10" style="v"/>অতো ঽহং যদোপস্থাস্যামি তদা তেন যদ্যৎ ক্রিযতে তৎ সর্ৱ্ৱং তং স্মারযিষ্যামি, যতঃ স দুর্ৱ্ৱাক্যৈরস্মান্ অপৱদতি, তেনাপি তৃপ্তিং ন গৎৱা স্ৱযমপি ভ্রাতৃন্ নানুগৃহ্লাতি যে চানুগ্রহীতুমিচ্ছন্তি তান্ সমিতিতো ঽপি বহিষ্করোতি|</para>
  <para style="p">
    <verse number="11" style="v"/>হে প্রিয, ৎৱযা দুষ্কর্ম্ম নানুক্রিযতাং কিন্তু সৎকর্ম্মৈৱ| যঃ সৎকর্ম্মাচারী স ঈশ্ৱরাৎ জাতঃ, যো দুষ্কর্ম্মাচারী স ঈশ্ৱরং ন দৃষ্টৱান্|</para>
  <para style="p">
    <verse number="12" style="v"/>দীমীত্রিযস্য পক্ষে সর্ৱ্ৱৈঃ সাক্ষ্যম্ অদাযি ৱিশেষতঃ সত্যমতেনাপি, ৱযমপি তৎপক্ষে সাক্ষ্যং দদ্মঃ, অস্মাকঞ্চ সাক্ষ্যং সত্যমেৱেতি যূযং জানীথ|</para>
  <para style="p">
    <verse number="13" style="v"/>ৎৱাং প্রতি মযা বহূনি লেখিতৱ্যানি কিন্তু মসীলেখনীভ্যাং লেখিতুং নেচ্ছামি|</para>
  <para style="p">
    <verse number="14" style="v"/>অচিরেণ ৎৱাং দ্রক্ষ্যামীতি মম প্রত্যাশাস্তে তদাৱাং সম্মুখীভূয পরস্পরং সম্ভাষিষ্যাৱহে|</para>
  <para style="p">
    <verse number="15" style="v"/>তৱ শান্তি র্ভূযাৎ| অস্মাকং মিত্রাণি ৎৱাং নমস্কারং জ্ঞাপযন্তি ৎৱমপ্যেকৈকস্য নাম প্রোচ্য মিত্রেভ্যো নমস্কুরু| ইতি|</para>
</usx>
