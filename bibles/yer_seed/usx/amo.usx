<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Tarok</book>
  <para style="h">Nlir aAmos</para>
  <para style="toc3">aAm</para>
  <para style="toc2">aAmos</para>
  <para style="toc1">Nlir aAmos</para>
  <para style="mt2">Nlir</para>
  <para style="mt1">AAmot</para>
  <para style="mt2">Unəm uga nlà ìchu Inan</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="s">Alár AAmot</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />Nnap nlà va ta̱ uAmot uzəngtəng ka̱ ashe onəm oga nkpak iya̱m nkang kà̱ ìtong aTeka̱wa ka̱m ka̱ atak Inan ka̱ ashe alár, ìzun pa̱ ìparəm kang mbin wong yənggət, ka̱ ashe nra va̱ ta te, uUza̱ya uwa uponzhi uga aYahudi, uYerobwam uya aYowash nnyi te ka̱ yà uponzhi uga aIsa̱rila. <verse eid="AMO 1:1" /><verse number="2" style="v" sid="AMO 1:2" />Uza̱ là pa̱,</para>
  <para style="q1" vid="AMO 1:2">&lt;&lt;UYawe ɗum wa ìlir ka̱ ashe aSiyona,</para>
  <para style="q2" vid="AMO 1:2">ichəchu wa ìgbarman ka̱ aUrushelima ,</para>
  <para style="q1" vid="AMO 1:2">á nak te atak nkpak iya̱m nkang wom, onəm oga nkpak iya̱m nkang yə́ng,</para>
  <para style="q2" vid="AMO 1:2">Ipəpà ka̱ apal Aɓam aKarmel lwai.&gt;&gt;<verse eid="AMO 1:2" /></para>
  <para style="s1">Nnyám ntàn Inan ka̱ apal onəm <optbreak /> va ra kà̱ ngba̱k oIsa̱rila</para>
  <para style="s2">ASiriya</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />UYawe là pa̱,</para>
  <para style="q1" vid="AMO 1:3">&lt;&lt;Onəm oga aDimaska nəm nnap mɓá̱ngɓa̱ng chit dədan,</para>
  <para style="q2" vid="AMO 1:3">Mi yà ka̱ ǹre oza̱ pa ka̱t, nkpak pa̱ ń nyám ntàn óza̱,</para>
  <para style="q1" vid="AMO 1:3">Ka̱kul oza̱ nə́m onəm mi ka̱ aGileyat</para>
  <para style="q2" vid="AMO 1:3">ká̱ nkumbək wa nva mí pək ikur á.<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />Ka̱kul nva̱ ta te, mi re ǹre ká̱ apər kà̱ nzhi iponzhi aHazayel,</para>
  <para style="q2" vid="AMO 1:4">a va i zhì akamsəlang aBenhadad.<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />Mi chwan anung asa̱l ìtong aDimaska,</para>
  <para style="q2" vid="AMO 1:5">mi dərkən onənəm kà̱ mba̱nda̱m aAva̱n.</para>
  <para style="q1" vid="AMO 1:5">Mi zhì uponzhi uga aBet-Eden,</para>
  <para style="q2" vid="AMO 1:5">onəm oga aAram te mí ga izwal ká̱ oza̱ ka̱ aKir,&gt;&gt;</para>
  <para style="q1" vid="AMO 1:5">uYawe à là. <figure style="fig" alt="Break the gate" file="cho01239c.TIF" size="chol" ref="1.5">Chwan anung asa̱l</figure><verse eid="AMO 1:5" /></para>
  <para style="s2">OFilisti</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />UYawe là pa̱,</para>
  <para style="q1" vid="AMO 1:6">&lt;&lt;Onəm oga aGaza nəm nnap mɓá̱ngɓa̱ng chit dədan,</para>
  <para style="q2" vid="AMO 1:6">nkpak pa̱ ń nyám ntàn óza̱.</para>
  <para style="q1" vid="AMO 1:6">Ka̱kul oza̱ wur nkpaktak onəm ga ká̱ kà̱ mbin nkak.</para>
  <para style="q2" vid="AMO 1:6">Oza̱ yáp ká̱ oza̱ wa ozwal oga aEdom.<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />Ka̱kul nva̱ ta te, mi re ǹre ká̱ apər ka̱ apal anyán va̱ gang aGaza,</para>
  <para style="q2" vid="AMO 1:7">i pwák akamsəlang va̱ ta.<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />Mi dərkən onəm oga aAshdod,</para>
  <para style="q2" vid="AMO 1:8">ká̱ uponzhi uga aAshəkelon.</para>
  <para style="q1" vid="AMO 1:8">Te mi nak awo ka̱ aEkron kpa,</para>
  <para style="q2" vid="AMO 1:8">aɓo oFilisti va̱ re te mi zhì,&gt;&gt;</para>
  <para style="q1" vid="AMO 1:8">uPonzhinan uYawe à là.<verse eid="AMO 1:8" /></para>
  <para style="s2">ATaya</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />UYawe là pa̱,</para>
  <para style="q1" vid="AMO 1:9">&lt;&lt;Onəm oga aTaya nəm nnap mɓá̱ngɓa̱ng chit dədan,</para>
  <para style="q2" vid="AMO 1:9">nkpak pa̱ ń nyám ntàn óza̱.</para>
  <para style="q1" vid="AMO 1:9">Ka̱kul oza̱ ɓəkchi nsar nnap-nlà igənang oza̱,</para>
  <para style="q2" vid="AMO 1:9">oza̱ yáp ká̱ nkpaktak ìtong oga aEdom.<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />Ka̱kul nva̱ ta te, mi re ǹre ká̱ apər i ri anyán aTaya,</para>
  <para style="q2" vid="AMO 1:10">i zhì akamsəlankamsəlang.&gt;&gt;<verse eid="AMO 1:10" /></para>
  <para style="s2">AEdom</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />UYawe là pa̱,</para>
  <para style="q1" vid="AMO 1:11">&lt;&lt;Onəm oga aEdom nəm nnap mɓá̱ngɓa̱ng chit dədan,</para>
  <para style="q2" vid="AMO 1:11">nkpak pa̱ ń nyám ntàn óza̱.</para>
  <para style="q1" vid="AMO 1:11">Ka̱kul uza̱ wà ogənnang wò ká̱ ndokchi,</para>
  <para style="q2" vid="AMO 1:11">uza̱ nyám nrwa ìgwak óza̱ ka̱t,</para>
  <para style="q1" vid="AMO 1:11">uza̱ re nlak ìgwak ká̱ oza̱ ka̱t,</para>
  <para style="q2" vid="AMO 1:11">kang uza̱ kpán mmən ìkum ká̱ oza̱ mbyet mbyet.<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />Ka̱kul nva̱ ta te, mi re ǹre ká̱ apər ka̱ aTeman,</para>
  <para style="q2" vid="AMO 1:12">i zhì akamsəlang aBozrah.&gt;&gt;<verse eid="AMO 1:12" /></para>
  <para style="s2">AAmmon</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />UYawe là pa̱,</para>
  <para style="q1" vid="AMO 1:13">&lt;&lt;Onəm oga aAmmon nəm nnap mɓá̱ngɓa̱ng chit dədan,</para>
  <para style="q2" vid="AMO 1:13">nkpak pa̱ ń nyám ntàn óza̱.</para>
  <para style="q1" vid="AMO 1:13">Ka̱kul oza̱ cha afu ochar oga anyám ka̱ aGileyat</para>
  <para style="q2" vid="AMO 1:13">ká̱ ndokchi pa̱ na ó bol mbin oza̱.<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />Ka̱kul nva̱ ta te, mi re ǹre ká̱ apər i ri anyán aRabba,</para>
  <para style="q2" vid="AMO 1:14">i zhì akamsəlankamsəlang.</para>
  <para style="q1" vid="AMO 1:14">Mí bà achu kà̱ ìlum ìkum va̱ ta,</para>
  <para style="q2" vid="AMO 1:14">i kandar wa ǹyə̀r nvàngváng nkánkám.<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />UPonzhi oza̱ i ga izwal,</para>
  <para style="q2" vid="AMO 1:15">ká̱ oponzhi oga avəvəng nzəng ká̱ na.&gt;&gt;</para>
  <para style="q1" vid="AMO 1:15">UYawe à là.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s2">aMowap</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />UYawe là pa̱,</para>
  <para style="q1" vid="AMO 2:1">&lt;&lt;aMowap nəm nnap mɓá̱ngɓa̱ng chit dədan,</para>
  <para style="q2" vid="AMO 2:1">nkpak pa̱ ń nyám ntàn á na.</para>
  <para style="q1" vid="AMO 2:1">Ka̱kul uza̱ shì akúp áponzhi uga aEdom nyáng nchwang<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />Mi re apər ka̱ aMowap,</para>
  <para style="q2" vid="AMO 2:2">i pwák akamsəlang aKeriyot.</para>
  <para style="q1" vid="AMO 2:2">Onəm oga aMowap i kú ka̱ ashe nzwar nnap nnəm,</para>
  <para style="q2" vid="AMO 2:2">kà̱ ìlum va̱ onəm oga nlung ìkum i bà ká̱ mɓúr agbəshi.<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />Mi dərkən uponzhi oza̱,</para>
  <para style="q2" vid="AMO 2:3">kang mi gbá̱ng nkpaktak ovan oponzhi nzəng ká̱ na.&gt;&gt;</para>
  <para style="q1" vid="AMO 2:3">UYawe à là.<verse eid="AMO 2:3" /></para>
  <para style="s2">AYahudi</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />Iya̱m va ta̱ uYawe là,</para>
  <para style="q1" vid="AMO 2:4">&lt;&lt;Onəm oga aYahudi nəm nnap mɓá̱ngɓa̱ng chit dədan.</para>
  <para style="q2" vid="AMO 2:4">Ka̱kul oza̱ yang nnap mpakpak mi, oza̱ kpak nnap nla mi ka̱t,</para>
  <para style="q1" vid="AMO 2:4">oza̱ wop ichər va okəka oza̱ ká̱ wop,</para>
  <para style="q2" vid="AMO 2:4">kang à nak oza̱ re asa̱l aga nnandər.<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />Mi re ǹre ká̱ apər áYahudi,</para>
  <para style="q2" vid="AMO 2:5">na á pwák oga akamsəlang aUrushelima pa̱ chatchat.&gt;&gt;<verse eid="AMO 2:5" /></para>
  <para style="s2">AKwali Inan ka̱ apal OIsa̱rila</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />UYawe là pa̱,</para>
  <para style="q1" vid="AMO 2:6">&lt;&lt;Onəm oga aIsa̱rila nəm nnap mɓá̱ngɓa̱ng chit dədan,</para>
  <para style="q2" vid="AMO 2:6">mi re oza̱ pa ka̱t, nkpak pa̱ ń nyám ntàn óza̱.</para>
  <para style="q1" vid="AMO 2:6">Ka̱kul oza̱ yáp mbwai ká̱ onəm onəna̱n.</para>
  <para style="q2" vid="AMO 2:6">Onəm oga nkun nnyi te, oza̱ yáp ká̱ oza̱ á kúr mbwai akwàp ka̱t.<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />Oza̱ tòng ishi onəm oga nkun</para>
  <para style="q2" vid="AMO 2:7">wa mɓwang mbin</para>
  <para style="q2" vid="AMO 2:7">Oza̱ bwam nnandər onəm va mmá kà̱r.</para>
  <para style="q1" vid="AMO 2:7">UYen ká̱ upo wò i ga atak nra kà̱ uyen ɓyen uzəngtəng,</para>
  <para style="q2" vid="AMO 2:7">wa nnà ta oza̱ vyap aɗin mi ayə́ryər.<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />Ka̱ atak awop oza̱ te oza̱ i ra ka̱ apal ìlukwan</para>
  <para style="q2" vid="AMO 2:8">va oza̱ ka̱m ndatdat ka̱ anung akat va̱ oza̱ ná.</para>
  <para style="q1" vid="AMO 2:8">Ka̱ ashe nzhi inan oza̱ te,</para>
  <para style="q2" vid="AMO 2:8">oza̱ wa ndəng ìba̱ngba̱ng ǹsámsàm va mmá mwa nkpán ká̱.<verse eid="AMO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />Ká̱ nnà te, n zhì oAmori ka̱ mpyal oza̱,</para>
  <para style="q2" vid="AMO 2:9">káp ka̱ nva̱ pa̱ oza̱ rup wa ichir,</para>
  <para style="q2" vid="AMO 2:9">kang oza̱ kam wa akún asida,</para>
  <para style="q1" vid="AMO 2:9">n zhì awar oza̱ ka̱ apal</para>
  <para style="q2" vid="AMO 2:9">ká̱ alə̀ng oza̱ ka̱ akum le.<verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />Mmami na kpa n fa ká̱ wo ka̱ ashe mbin aMasar,</para>
  <para style="q2" vid="AMO 2:10">kang n lə́p mpyal a wo ka̱ ashe ǹzam izun ìsəm pa̱ ineɗing</para>
  <para style="q2" vid="AMO 2:10">na o wur iya̱m akúp ká̱ mbin aAmori.<verse eid="AMO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />N yak ovan wo oro tong onəm oga nlà ìchu Inan,</para>
  <para style="q2" vid="AMO 2:11">oro te oNaziri.</para>
  <para style="q1" vid="AMO 2:11">Mwote pa ka̱t ɗak ɓo oga aIsa̱rila?&gt;&gt;</para>
  <para style="q1" vid="AMO 2:11">UYawe à ɓəp.<verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />&lt;&lt;Te o nak oNaziri wa ncè kang</para>
  <para style="q2" vid="AMO 2:12">o dáng onəm oga nlà ìchu Inan kà̱ nləlà.<verse eid="AMO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />Dər, ǹyangmata̱ mi ga nkà̱r wo</para>
  <para style="q2" vid="AMO 2:13">wa nva̱ mí byachi akeke ipəri ká̱ nsar ikur.<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />Onəm oga nchəng ashar ka̱ ashe wo i zhì.</para>
  <para style="q2" vid="AMO 2:14">Onəm okankam ka̱ ashe wo i tong nku.</para>
  <para style="q2" vid="AMO 2:14">Onəm oga nlung ìkum i nyi nka̱mshi ishi oza̱ ka̱t.<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />Ovan oga ijang i yà ká̱ ntong ka̱t.</para>
  <para style="q2" vid="AMO 2:15">Onəm oga nchəng ashar ka̱ ashe oza̱ i yà ká̱ mbar ka̱t,</para>
  <para style="q2" vid="AMO 2:15">kang onəm oga ipəri ìkum i ka̱mshi ishi oza̱ ka̱t kpa.<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />Kà̱ ìlum va̱ ta onəm oga nkam ìgwak</para>
  <para style="q2" vid="AMO 2:16">i chəng ká̱ ìjili ìbwat ka̱kul irirì oza̱,&gt;&gt;</para>
  <para style="q1" vid="AMO 2:16">uYawe à là.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s1">INok ánəm uga nlà icù Inan</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />O gwong achwang kà̱ nnap-nlà va̱ ta̱ uYawe là ka̱ apal wo, ónəm oga aIsa̱rila ká̱ nkpaktak akum va̱ n fa ká̱ oza̱ ka̱ aMasar.<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />&lt;&lt;Ka̱ ashe akum va̱ ka̱ apambin pa̱ kpaktak te,</para>
  <para style="q2" vid="AMO 3:2">n yak mmawó na byet n nak ishi ká̱ wo.</para>
  <para style="q1" vid="AMO 3:2">Ka̱kul nva̱ ta te, nkpak pa̱ ń nyám ntàn a wo,</para>
  <para style="q2" vid="AMO 3:2">ka̱kul nnap mɓá̱ngɓa̱ng wo.&gt;&gt;<verse eid="AMO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />I məma pa̱ onəm pa̱ oparəm i ga achen nzəng</para>
  <para style="q2" vid="AMO 3:3">kang anung oza̱ i gwàr kà̱ ka̱t ɗò?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />Ìlir i ɗuɗum ka̱ ashe ikún</para>
  <para style="q2" vid="AMO 3:4">u wa ya ìzhe chit ka̱t ɗò?</para>
  <para style="q1" vid="AMO 3:4">Ìyen nza̱m ìlir i gbək izər gbək ka̱ ashe agba̱k</para>
  <para style="q2" vid="AMO 3:4">ì yà kpán iya̱m iro chit ka̱t ɗò?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />Ajə̀p i kpán ìnyil kpán</para>
  <para style="q2" vid="AMO 3:5">ka̱ atak va̱ mmá lwak kà̱ ka̱t ɗò?</para>
  <para style="q1" vid="AMO 3:5">Ajə̀p i tətat ya nna kpán</para>
  <para style="q2" vid="AMO 3:5">iya̱m iro chit ka̱t ɗò?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />A yà pa̱ mma ɓur agbəshi ìkum ka̱ ashe mbin te</para>
  <para style="q2" vid="AMO 3:6">ayər i nəm onəm ka̱t ɗò?</para>
  <para style="q1" vid="AMO 3:6">Nɗaktak i fəfa kà̱ mbin</para>
  <para style="q2" vid="AMO 3:6">nva uYawe à nəm ka̱t ɗò?<verse eid="AMO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />Nnandər, uPonzhinan uYawe i ya ká̱ nnəm iya̱m iro</para>
  <para style="q2" vid="AMO 3:7">nzəng ká̱ nnyám iya̱m va̱ ta</para>
  <para style="q2" vid="AMO 3:7">ozwal wò onəm oga nlà ìchu Inan ka̱t ɗò ka̱t.<verse eid="AMO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />Ìlir ɗum te uda</para>
  <para style="q2" vid="AMO 3:8">i nəm ayər ka̱t yà?</para>
  <para style="q1" vid="AMO 3:8">UPonzhinan uYawe là nnàp chit,</para>
  <para style="q2" vid="AMO 3:8">te uda i yang ka̱ nlà ichəchu va̱ ta yà?<verse eid="AMO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />Là nnap ká̱ oga akamsəlang aga aAshdod</para>
  <para style="q2" vid="AMO 3:9">ká̱ oga akamsəlang kà̱ mbin aMasar pa̱,</para>
  <para style="q1" vid="AMO 3:9">&lt;&lt;O ɓut ishi wo ka̱ aɓam aSamariya</para>
  <para style="q2" vid="AMO 3:9">na o dər nzwar va̱ ka̱ ashishe</para>
  <para style="q2" vid="AMO 3:9">ká̱ nkà̱r nnandər va̱ ka̱ ashe onənəm&gt;&gt;<verse eid="AMO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />&lt;&lt;Onəm mi nyi nnəm iya̱m inəna̱n ka̱t,&gt;&gt; uYawe à là.</para>
  <para style="q2" vid="AMO 3:10">&lt;&lt;Oza̱ va ɓut iya̱m ka̱ akamsəlang oza̱ ka̱ atak nvyat onəm ká̱ nnəm ayi.&gt;&gt;<verse eid="AMO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11" />Ka̱kul nva̱ ta te, uPonzhinan uYawe là pa̱,</para>
  <para style="q1" vid="AMO 3:11">&lt;&lt;Ukpa ìkum i gáng mbin,</para>
  <para style="q2" vid="AMO 3:11">i kap wo ká̱ ìkam wo</para>
  <para style="q2" vid="AMO 3:11">kang i lyangshin akamsəlang wo.&gt;&gt;<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />UYawe là pa̱,</para>
  <para style="q1" vid="AMO 3:12">&lt;&lt;Wa nva unəm uga nkpak iya̱m nkang i vyat ka̱ anung ìlir</para>
  <para style="q2" vid="AMO 3:12">ashar pa̱ aparəm ka̱t te achwang pa̱ azəng,</para>
  <para style="q1" vid="AMO 3:12">te wa nnà ta mí ka̱mshi oIsa̱rila,</para>
  <para style="q2" vid="AMO 3:12">va̱ təm ka̱ ashe aSamariya</para>
  <para style="q2" vid="AMO 3:12">ka̱ aranchwang ìgban ká̱ ìtok.&gt;&gt;<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />&lt;&lt;O gwong achwang na o là nnàp ákum áYakup,&gt;&gt;</para>
  <para style="q2" vid="AMO 3:13">uPonzhinan uYawe, Inan iga nggatək à là.<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />&lt;&lt;ÌLum va̱ mi nyám ntàn óIsa̱rila ka̱kul nnap mɓá̱ngɓa̱ng oza̱ te,</para>
  <para style="q2" vid="AMO 3:14">mi shin atak nshì iya̱m awop aga aBetel.</para>
  <para style="q1" vid="AMO 3:14">Mi ɓun oga nggùnggúng atak</para>
  <para style="q2" vid="AMO 3:14">awop i tàk kà̱ mbin.<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />Mi shin nzhi oza̱</para>
  <para style="q2" vid="AMO 3:15">ká̱ aghal oza̱,</para>
  <para style="q1" vid="AMO 3:15">nzhi oza̱ va̱ mmá zà̱m ká̱ oga inyin nlàlap,</para>
  <para style="q2" vid="AMO 3:15">nza̱ nzhi nchumchum nggo mí shin.&gt;&gt;</para>
  <para style="q1" vid="AMO 3:15">UYawe à là.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s1">OIsa̱rila le atak Inan ka̱t</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />O gwong achwang na o fe nva̱ ta̱ óchar oga Samariya.</para>
  <para style="q2" vid="AMO 4:1">Mmawo va wa ina imwalmwal iga aBashan va ka̱ aɓam aSamariya.</para>
  <para style="q1" vid="AMO 4:1">Ó nyán ká̱ onəm oga nlàng kang o kà̱r onəm oga nkun,</para>
  <para style="q2" vid="AMO 4:1">o là ónəm oga nzhi wo pa̱ &lt;&lt;Ɓa ká̱ iya̱m iwàwà á yi.&gt;&gt;<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />UPonzhinan uYawe sóng anung chit ká̱ ishi wò, uza̱ là pa̱,</para>
  <para style="q2" vid="AMO 4:2">&lt;&lt;Nra nna kà̱ mɓa ka̱ apal wo</para>
  <para style="q1" vid="AMO 4:2">nva mí wur wo ká̱ aKugaya,</para>
  <para style="q2" vid="AMO 4:2">wa ìgwali va mmá kpán ká̱ aKugaya.<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />Mí wur wo mi fa ká̱</para>
  <para style="q2" vid="AMO 4:3">ka̱ atak va akamsəlang kàkchi kà̱,</para>
  <para style="q2" vid="AMO 4:3">mí swang wo te, udanggo i ru asa̱l mbin aHamon.&gt;&gt;</para>
  <para style="q1" vid="AMO 4:3">UYawe à là.<verse eid="AMO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />&lt;&lt;O ga aBetel kang ô fa iya̱mkak ,</para>
  <para style="q2" vid="AMO 4:4">o ga aGilgal na o ga mpyal ká̱ nnəm inga.</para>
  <para style="q1" vid="AMO 4:4">O ná iya̱m ipápà wo nza̱ ipin nggo,</para>
  <para style="q2" vid="AMO 4:4">ká̱ iya̱m pa̱ izəng ka̱ ashe agba̱pchi nza̱ nra pa̱ nshatɗing nggo.<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />O ná nzənkəng ngga anyer ka̱kul nná aɗəngchi</para>
  <para style="q2" vid="AMO 4:5">ká̱ iya̱m inana wo iga nɗom ìgwak.</para>
  <para style="q1" vid="AMO 4:5">O ghok ka̱kul apir iya̱m</para>
  <para style="q2" vid="AMO 4:5">va ta̱ o fe nchang nnənəm, óIsa̱rila.&gt;&gt;</para>
  <para style="qr" vid="AMO 4:5">UPonzhinan uYawe à là.<verse eid="AMO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />&lt;&lt;M ɓa ká̱ ayang kà̱ ìtong wo,</para>
  <para style="q2" vid="AMO 4:6">o lang iya̱m-nrì kà̱ oga mbin wo,</para>
  <para style="q2" vid="AMO 4:6">káp ká̱ nnà te, o ga̱ɓa̱n o ɓa atak mi ka̱t.&gt;&gt;</para>
  <para style="q1" vid="AMO 4:6">UYawe à là.<verse eid="AMO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />Kà̱ɗi te, n dàng wo ká̱ ìva̱r</para>
  <para style="q2" vid="AMO 4:7">ya nna ɓur apye pa̱ shatɗing kang mí ɓən iya̱m.</para>
  <para style="q1" vid="AMO 4:7">N nak mmá pəng ìva̱r kà̱ mbin nro,</para>
  <para style="q2" vid="AMO 4:7">kà̱ mbin nro nnyi te n dàng ìva̱r.</para>
  <para style="q1" vid="AMO 4:7">Ìram iro ká̱ azham</para>
  <para style="q2" vid="AMO 4:7">ìram iro te azham ya kà̱ ka̱t, a wom.<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />Iìtong pa̱ iparəm ka̱t te pa̱ ishatɗing i pin kà̱ nram ndəng ngwa,</para>
  <para style="q2" vid="AMO 4:8">kà̱ mbín va kà̱ ngba̱k oza̱,</para>
  <para style="q1" vid="AMO 4:8">ka̱ ta te oza̱ ya ndəng kúr oza̱ ka̱t.</para>
  <para style="q2" vid="AMO 4:8">Káp ká̱ nnà te, o le atak mi ka̱t,</para>
  <para style="q1" vid="AMO 4:8">uYawe à là.<verse eid="AMO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />&lt;&lt;N lə̀p iya̱m nsuk wo ká̱ arwa ká̱ atak sur,</para>
  <para style="q2" vid="AMO 4:9">Mbankum ri oga ìram ìkáka wo ká̱ iga iɓá̱ngɓa̱ng,</para>
  <para style="q1" vid="AMO 4:9">ká̱ iga ikún mpyet wo ká̱ iga ikún ìpipyan,</para>
  <para style="q2" vid="AMO 4:9">káp ká̱ nnà te, o le atak mi ka̱t,&gt;&gt;</para>
  <para style="q1" vid="AMO 4:9">uYawe à là.<verse eid="AMO 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />&lt;&lt;N re ǹre a wo ká̱ nɗaktak</para>
  <para style="q2" vid="AMO 4:10">wa nva̱ ka̱ n nəm ká̱ aMasar,</para>
  <para style="q1" vid="AMO 4:10">n gbá̱ng ovan nza̱m wo ká̱ ndokchi, nzəng ká̱ ipəri wo va mmá vyat.</para>
  <para style="q2" vid="AMO 4:10">N nak nnəng oga akúm va̱ ta táng a wo ka̱ alúr.</para>
  <para style="q1" vid="AMO 4:10">Káp ká̱ nnà te, o le atak mi ka̱t,&gt;&gt;</para>
  <para style="q2" vid="AMO 4:10">uYawe à là.<verse eid="AMO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />&lt;&lt;N zhì mbín wo</para>
  <para style="q2" vid="AMO 4:11">wa nva̱ Inan ka̱ zhì aSodom ká̱ aGomora,</para>
  <para style="q1" vid="AMO 4:11">o tong wa akún va mmá tur ka̱ anung apər á.</para>
  <para style="q2" vid="AMO 4:11">Káp ká̱ nnà te, o le atak mi ka̱t,&gt;&gt;</para>
  <para style="q1" vid="AMO 4:11">uYawe à là.<verse eid="AMO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />&lt;&lt;Ka̱kul nva̱ ta te, iya̱m va ta̱ mi ga nnənəm a wo, óIsa̱rila.</para>
  <para style="q2" vid="AMO 4:12">Ka̱kul mi ga nnəm iya̱m ata̱ a wo te,</para>
  <para style="q2" vid="AMO 4:12">o gbar izər o gwan Inan wo, óIsa̱rila.&gt;&gt;<verse eid="AMO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />Dər, uza̱ uwa ta̱,</para>
  <para style="q2" vid="AMO 4:13">uwa nəm aɓam kang à fa ká̱ ayə́r,</para>
  <para style="q2" vid="AMO 4:13">uwa kà̱ nnyám iya̱m va̱ uza̱ rəng ka̱ ashe ìgwak wò ûnəmləbər,</para>
  <para style="q1" vid="AMO 4:13">uwa fa ká̱ atak atántàn aga anung ipin ka̱ ashe ìzwam,</para>
  <para style="q2" vid="AMO 4:13">uza̱ nak oga aɓam aruprup ka̱ avəng ashar wò.</para>
  <para style="q2" vid="AMO 4:13">Aɗiɗin pa̱ uYawe, Inan iga nggatək.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">ÌPyang ìga aɗor</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />O gwong achwang ónəm oga aIsa̱rila, kà̱ ìpyang ìga aɗor va̱ mmami kà̱ nshìshi ka̱ apal ishi wo á.<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />Uza̱ ru chit, i yà ká̱ ngwong lap ka̱t,</para>
  <para style="q2" vid="AMO 5:2">uyen ɓyen ugəkgək uIsa̱rila ru chit.</para>
  <para style="q1" vid="AMO 5:2">Mmá yang ká̱ na kà̱ mbibin,</para>
  <para style="q2" vid="AMO 5:2">unəm uro yà pa̱ á gha̱p na a wong ka̱t.<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />UPonzhinan uYawe là onəm oga aIsa̱rila pa̱,</para>
  <para style="q1" vid="AMO 5:3">&lt;&lt;Ììtong va̱ i re ǹre ká̱ onəm ìkalong pa̱ ìzəng fa agbai te,</para>
  <para style="q2" vid="AMO 5:3">onəm ìgba̱l pa̱ ìzəng i ga i le,</para>
  <para style="q1" vid="AMO 5:3">ìro va̱ nnyi i re ǹre ká̱ onəm ìgba̱l pa̱ ìzəng fa agbai te,</para>
  <para style="q2" vid="AMO 5:3">pa̱ ogba̱pchi i ga i le.&gt;&gt;<verse eid="AMO 5:3" /></para>
  <para style="s1">O ɓa atak Inan na o lár</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />Iya̱m va ta̱ uYawe là ónəm oga aIsa̱rila,</para>
  <para style="q1" vid="AMO 5:4">&lt;&lt;O ram mi na o lár,<verse eid="AMO 5:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5" />kang o ram aBetel ka̱t,</para>
  <para style="q1" vid="AMO 5:5">kang o ga aGilgal,</para>
  <para style="q2" vid="AMO 5:5">ka̱t te o pa̱l aBəyersheba ka̱t.</para>
  <para style="q1" vid="AMO 5:5">Ka̱kul mi ga ngwur onəm oga aGilgal i ga izwal</para>
  <para style="q2" vid="AMO 5:5">kang aBetel nnyi te i təm atak alakchi.&gt;&gt;<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />O ram uYawe na o lár,</para>
  <para style="q2" vid="AMO 5:6">ka̱t te uza̱ i fa wa apər</para>
  <para style="q1" vid="AMO 5:6">kà̱ nzhi aYusufu, i ri,</para>
  <para style="q2" vid="AMO 5:6">unəm uga njəjip ka̱ aBetel yà ka̱t.<verse eid="AMO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />Mmawo va o ga̱ɓa̱n akwali a nandər wal ìɗángɗáng</para>
  <para style="q2" vid="AMO 5:7">kang o kà̱r nnandər kà̱ mbin á yà iya̱m ilakchi ka̱ atak wo.<verse eid="AMO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />Uza̱ uwa fa ká̱ izhan ivanɓyen ká̱ nɗukkəri,</para>
  <para style="q2" vid="AMO 5:8">uza̱ uwa ga̱ɓa̱n atak akpá̱rkpà̱r ɓa anung ipin</para>
  <para style="q2" vid="AMO 5:8">alum nyáng ìzwam,</para>
  <para style="q1" vid="AMO 5:8">uza̱ wór ndəng ìwá</para>
  <para style="q2" vid="AMO 5:8">tar ka̱ apambin,</para>
  <para style="q2" vid="AMO 5:8">aɗiɗin pa̱ uYawe.<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />Wa aməlam, uza̱ i zhì onəm okankam,</para>
  <para style="q2" vid="AMO 5:9">kang i shin oga akamsəlang.<verse eid="AMO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />Oza̱ yang unəm unandər kà̱ nkəlang,</para>
  <para style="q2" vid="AMO 5:10">kang unəm va̱ i là nnandər te, oza̱ jan na.<verse eid="AMO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />Ka̱kul o tòng onəm oga nkun,</para>
  <para style="q2" vid="AMO 5:11">kang o nak amwa ìpirkur oza̱ ká̱ ìfan,</para>
  <para style="q1" vid="AMO 5:11">nzhi wo ngga ipáng nnəna̱n va̱ o me te,</para>
  <para style="q2" vid="AMO 5:11">ó yà ka̱ nra ka̱ ashishe ka̱t.</para>
  <para style="q1" vid="AMO 5:11">O yà ka̱ ngwa ndəng ìba̱ngba̱ng</para>
  <para style="q2" vid="AMO 5:11">iga ashe ìram wo inəna̱n ka̱t.<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />N nyi mmak nnap mɓá̱ngɓa̱ng wo nyi,</para>
  <para style="q2" vid="AMO 5:12">ká̱ iya̱m inga iga nnəm ayər va̱ mmawó kà̱ nnənəm.</para>
  <para style="q1" vid="AMO 5:12">Mmawo kà̱ nyán ká̱ onəm onəna̱n kang o ka̱m iya̱m ka̱kul nkà̱r nnandər,</para>
  <para style="q2" vid="AMO 5:12">te o nak pa̱ mmá náp akwali aga nnandər onəm oga nkun kà̱ nkəlang ka̱t.<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />Ka̱kul nva̱ ta te, unəm va̱ tətàn te uza̱ á ma̱r pa̱ kwak,</para>
  <para style="q2" vid="AMO 5:13">ka̱kul nra va̱ ta̱ nra mɓá̱ngɓa̱ng.<verse eid="AMO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />Ram inəna̱n iɓá̱ngɓa̱ng ka̱t,</para>
  <para style="q2" vid="AMO 5:14">ka̱kul na o lár,</para>
  <para style="q1" vid="AMO 5:14">nna chit te uYawe, Inan uga nggatək i yà nzəng ká̱ wo</para>
  <para style="q2" vid="AMO 5:14">dakdak wa nva̱ o là.<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />O yang inga,</para>
  <para style="q2" vid="AMO 5:15">o ma̱n inəna̱n.</para>
  <para style="q1" vid="AMO 5:15">O náp akwali aga nnandər kà̱ nkəlang wo,</para>
  <para style="q2" vid="AMO 5:15">mwote uYawe, Inan iga nggatək i nyám nnap nnəna̱n á ɓo akum aYusufu.<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />Ka̱kul uPonzhinan uYawe, Inan iga nggatək là pa̱,</para>
  <para style="q1" vid="AMO 5:16">&lt;&lt;Mí ga ǹyə́ng ayə́ng ká̱ aɗor ka̱ agəntəng,</para>
  <para style="q2" vid="AMO 5:16">mí nə́m ìwar ka̱ apal asa̱l.</para>
  <para style="q1" vid="AMO 5:16">Mí wór onəm ka̱ ashe ìram</para>
  <para style="q2" vid="AMO 5:16">ka̱ onəm oga nnyi nshì ìpyang pa̱ oza̱ á ɓa á yə́ng ikú.<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />Mí yə́ng ikú nza̱ atak nggo ka̱ ashe iram wo,</para>
  <para style="q2" vid="AMO 5:17">ka̱kul mi watar ka̱ ashe wo,<note caller="+" style="f"><char style="fr" closed="false">5.17 </char><char style="ft" closed="false">Ngwatar ka̱ ashe wo kà̱ nnyám akwali áYawe wa nva ka̱ ashe </char><char style="xt"><ref loc="EXO 12:12">Nfa 12.12</ref></char>.</note>&gt;&gt;</para>
  <para style="q1" vid="AMO 5:17">uYawe à là.<verse eid="AMO 5:17" /></para>
  <para style="s1">ÌLum àYawe</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />Álak ká̱ wo chit,</para>
  <para style="q2" vid="AMO 5:18">mmawó va̱ ká̱ ìgwak kà̱ ìlum àYawe á.</para>
  <para style="q1" vid="AMO 5:18">Iza̱ ìlum àYawe i nəm a wo yà?</para>
  <para style="q2" vid="AMO 5:18">Ìlum va̱ ta ìlum ìkpá̱rkpà̱r, ìghanghan ka̱t.<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />I yà wa ánəm va chər ìlir</para>
  <para style="q2" vid="AMO 5:19">te á ga pa ìwu kà̱ ìdəshìli.</para>
  <para style="q1" vid="AMO 5:19">Ka̱t te wa ánəm va chər ɓa</para>
  <para style="q2" vid="AMO 5:19">da̱r awo ka̱ izər nzhi</para>
  <para style="q2" vid="AMO 5:19">te ìpwang kà̱p na.<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />Nnandər ìlum àYawe ìkpá̱rkpà̱r ìghanghan ka̱t,</para>
  <para style="q2" vid="AMO 5:20">ìlum va̱ ta pa̱ zhiwuli pa̱ haa ka̱t.<verse eid="AMO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />&lt;&lt;N yang, n ɗom awop wo aga nnəm nchang izər ka̱t,</para>
  <para style="q2" vid="AMO 5:21">mɓut awop wo nəng ká̱ mi paɗi.<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />A yà pa̱ o ná iya̱m inana iga nshì pa̱ ɗwot ká̱ iya̱m inana iga ìpirkur te,</para>
  <para style="q2" vid="AMO 5:22">mi yà ká̱ nkəka̱m ka̱t.</para>
  <para style="q1" vid="AMO 5:22">Mi yà ká̱ nnak ishi ká̱ iya̱m nkang wo imwalmwal</para>
  <para style="q2" vid="AMO 5:22">ka̱kul iya̱m inana iga ntəm ikángkáng ka̱t.<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />Ga ká̱ ngghám achu ɓu ka̱ cho,</para>
  <para style="q2" vid="AMO 5:23">iya̱m inə́mnə́m ɓu a chàng sang nggo te,</para>
  <para style="q2" vid="AMO 5:23">n ɗom nfife ka̱t.<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />Ka̱ aɗor nva̱ ta te, re akwali aga nnandər á nang wa ndəng awang,</para>
  <para style="q2" vid="AMO 5:24">kang inəna̱n wa awangsang va i fu ka̱t á.<verse eid="AMO 5:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25" />O ɓa ká̱ nləfər iya̱m ipápà iga iya̱m nkang, ká̱ iya̱m inana iga ìram wo ɓa á mi,</para>
  <para style="q2" vid="AMO 5:25">nva̱ mmawó ka̱ ashe anyin ìzun ìsəm pa̱ ineɗing ɗò, óIsa̱rila?<verse eid="AMO 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26" />Iya̱m va̱ o nəm te, o wur ìchər wo</para>
  <para style="q2" vid="AMO 5:26">va mí wór pa̱ aSakut ûponzhi wo,</para>
  <para style="q1" vid="AMO 5:26">ká̱ aKaiwan inan wo iga izhan,</para>
  <para style="q2" vid="AMO 5:26">iva o nəm ká̱ awo wo á.<verse eid="AMO 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27" />Ka̱kul nva̱ ta te, mi ga ká̱ wo ka̱ ashe mbin nro kà̱ mpyal aDimaska.&gt;&gt;</para>
  <para style="q2" vid="AMO 5:27">UYawe, aɗiɗin pa̱ Inan iga nggatək, à là.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s1">ONəm va re izər chit pa̱ yàk ká̱ aSiyona</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />Álak ká̱ wo chit, mmawó va̱ o təm pa̱ shat ka̱ aSiyona á.</para>
  <para style="q2" vid="AMO 6:1">Ká̱ mmawó va̱ o rəng pa̱ o təm chit ká̱ ikángkáng ka̱ aɓam aSamariya.</para>
  <para style="q1" vid="AMO 6:1">Mmawo onəm oga ala̱ka̱n va mmá nyi wo nyi kà̱ mbin nchumchum,</para>
  <para style="q2" vid="AMO 6:1">ka̱ atak áda oIsa̱rila ga yà?<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />O ga aKalne na o dər,</para>
  <para style="q2" vid="AMO 6:2">o ga aHamat,</para>
  <para style="q1" vid="AMO 6:2">o watar o ga aGat ajo oFilisti,</para>
  <para style="q2" vid="AMO 6:2">o dər mbin oza̱ rup kam ji aIsa̱rila ji ɗò?<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />Mmawo kà̱ nnyám pa̱ ìlum ìɓá̱ngɓa̱ng va̱ ta ì ya nggbəgbà̱ng ka̱ cho,</para>
  <para style="q2" vid="AMO 6:3">kang iya̱m va̱ mmawó kà̱ nnənəm te kà̱ ndap ìtok iponzhi iga idumdùm va̱ ta dat ká̱ wo.<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />Mmawo va kà̱ nra ka̱ apal</para>
  <para style="q2" vid="AMO 6:4">alyer aga inyin nlàlap,</para>
  <para style="q1" vid="AMO 6:4">kang o dal izər ka̱ apal ìtok ngbat wo,</para>
  <para style="q2" vid="AMO 6:4">o ri izhé itam iyákyàk ka̱ ashe iya̱m nkang,</para>
  <para style="q2" vid="AMO 6:4">ká̱ ina imwalmwal ka̱ ashe nggatək ina.<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />O mar oga nnap-nshì va̱ yà ká̱ ìpir ka̱t ká̱ aɓwa,</para>
  <para style="q2" vid="AMO 6:5">kang o mar aghan oga iya̱m ǹza̱m wa nva̱ uDawuda nəm.<figure style="fig" alt="musichal instruments" file="WA04017b.tif" size="chol" ref="6.5">Iya̱m ǹza̱m</figure><verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />O wá ndəng ìba̱ngba̱ng ǹsámsàm ká̱ ìnang ìkpáng.</para>
  <para style="q2" vid="AMO 6:6">O ɓəl mmì nnəna̱n.</para>
  <para style="q2" vid="AMO 6:6">Kang o yə́ng ká̱ nvyap ovan aYusufu ka̱t.<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />Ka̱kul nva̱ ta te, mmawó na oga nggəshi va̱ o ga izwal.</para>
  <para style="q2" vid="AMO 6:7">Ndal izər wo ká̱ nri izhé wo i ga nkùr.<verse eid="AMO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />UPonzhinan uYawe sóng anung ka̱ ishi wò, uYawe, Inan iga nggatək là pa̱,</para>
  <para style="q1" vid="AMO 6:8">&lt;&lt;N jan ǹrup ishi áYakup, n yang akamsəlankamsəlang.</para>
  <para style="q2" vid="AMO 6:8">Mi ga nná mbin oza̱ ká̱ iya̱m va̱ ka̱ ashishe.&gt;&gt;<verse eid="AMO 6:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="AMO 6:9" />A yà pa̱ onəm pa̱ ogba̱pchi à re ka̱ ashe nzhi pa̱ nzəng te oza̱ i kú. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />Kà̱ nva̱ngva̱ onal onəm va̱ kú ɓa táng ashe nzhi pa̱ na o fa ká̱ akúm o shì, te uro i wór awór pa̱, &lt;&lt;Unəm uro uwa yà ka̱ ashe nzhi va̱ ta̱ ɗak ɓo?&gt;&gt; Te mí ma̱n pa̱ &lt;&lt;Pa ka̱t.&gt;&gt; Te uza̱ i là pa̱, &lt;&lt;Gbat, kang mmá wór aɗin áYawe.&gt;&gt;<verse eid="AMO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />Ka̱kul uYawe à là,</para>
  <para style="q2" vid="AMO 6:11">nzhi nchumchum mí chwan pa̱ rukutrukut,</para>
  <para style="q2" vid="AMO 6:11">nzhi mɓwakan mí shin.<verse eid="AMO 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />Mí kwak ipəri kwak ka̱ apal ipáng ɗò?</para>
  <para style="q2" vid="AMO 6:12">Mí shàng ipáng shàng ká̱ ina ɗò?</para>
  <para style="q1" vid="AMO 6:12">Káp ká̱ nnà te o nak nnandər sat akàl,</para>
  <para style="q2" vid="AMO 6:12">kang nnap nnəm nnəna̱n sat ìɗángɗáng. <figure style="fig" alt="Cow plowing" file="cho01456b.TIF" size="chol" ref="6.12">Ngshàng ìram ina</figure><verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />Mmawo va̱ o lan ká̱ igwan wo ka̱ apal aLodeba o là pa̱,</para>
  <para style="q2" vid="AMO 6:13">&lt;&lt;Ká̱ nkàm yi kang í ri aKarnayim ka̱t ɗò?&gt;&gt;<verse eid="AMO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />&lt;&lt;Ónəm oga aIsa̱rila, mmami kà̱ ngga mɓa ká̱ onəm ìkum wo,</para>
  <para style="q2" vid="AMO 6:14">va i ga nnyán ká̱ wo i ɓàn ka̱ aHamat</para>
  <para style="q1" vid="AMO 6:14">ka̱ asa̱l mpal i ga i chu aba̱nda̱m Ìwá Mman.&gt;&gt;</para>
  <para style="q2" vid="AMO 6:14">UYawe, Inan iga nggatək à là.<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s1">Oga iwon ka̱ ashe alár pa̱ shatɗing</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />Alár va ta̱ uPonzhinan uYawe nyám á mi. N ya uza̱ kà̱ nfa ká̱ mbankum ka̱ ashe mbin, kà̱ nva̱ngva̱ mmá kpam nrì aponzhi chit, kang oza̱ ɓàn ntə́p kà̱ɗi . <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />Kà̱ nva̱ngva̱ mbankum gba̱l ká̱ nri iya̱m va tə́p kà̱ mbin te, n là pa̱, &lt;&lt;Áponzhi Inan, uYawe, kusuk yar mpat ûYakup, uza̱ i nəm sang kang i sat yà? Uza̱ makmak ka̱t.&gt;&gt;<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />UYawe re iya̱m va̱ uza̱ yar pa̱ ô nəm.</para>
  <para style="p" vid="AMO 7:3">UYawe là pa̱, &lt;&lt;I nəm ka̱t.&gt;&gt;<verse eid="AMO 7:3" /></para>
  <para style="s">ALár apər</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />UPonzhinan uYawe nyám alár á mi. N ya uPonzhinan uYawe kà̱ mpə̀ng apər. Apər va̱ ta shì ìnang ìwá ga akpán ká̱ nri apambin kpa. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />Te n là pa̱, &lt;&lt;ÁPonzhinan, uYawe, wa ma̱n te wa re nnap va̱ ta, uYakup i nəm sang kang i sat yà? Uza̱ makmak ka̱t.&gt;&gt;<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />Te uYawe re iya̱m va̱ uza̱ yar pa̱ ô nəm, &lt;&lt;Iva̱ ta̱ i nəm ka̱t na kpa&gt;&gt; uPonzhinan , uYawe à là.<verse eid="AMO 7:6" /></para>
  <para style="s">ALár iya̱m iga mmàl iya̱m</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />Uza̱ nyám alár á mi. N ya uPonzhinan sat ka̱ izər akamsəlang va mmá me ká̱ iya̱m iga mmàl nsat nzwàng nzhi. Uza̱ kpán iya̱m iga mmàl nzhi ka̱ awo. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />UYawe ɓəp mi pa̱, &lt;&lt;ÁAmot, iza̱ u ya yà?&gt;&gt;</para>
  <para style="p" vid="AMO 7:8">Te n là pa̱ &lt;&lt;Iya̱m iga mmàl nsat nzwàng nzhi.&gt;&gt;</para>
  <para style="p" vid="AMO 7:8">Te uPonzhinan là pa̱,</para>
  <para style="q1" vid="AMO 7:8">&lt;&lt;Mmami kà̱ nnak iya̱m iga màl nsat nzwàng nzhi,</para>
  <para style="q2" vid="AMO 7:8">ka̱ ishimshe onəm mi oIsa̱rila.</para>
  <para style="q2" vid="AMO 7:8">Mi watar ka̱ ashe oza̱.<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />Atak awop akum ìjili àIshaku ká̱ aɓam i shin,</para>
  <para style="q2" vid="AMO 7:9">kang atak awop ayə́ryər oga aIsa̱rila i ra agúng,</para>
  <para style="q2" vid="AMO 7:9">mi ru akum ìjili àYerobwam ká̱ ndokchi.&gt;&gt;<verse eid="AMO 7:9" /></para>
  <para style="s">UAmot ká̱ uAmaziya</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />Te uAmaziya unəm uga mpyal awop ka̱ aBetel re ǹre ûYerobwam uponzhi uga aIsa̱rila pa̱, &lt;&lt;UAmot uwa suk iya̱m ro ka̱ ashe onəm oga aIsa̱rila. Mbin ka̱m nnap va̱ ta̱ ka̱t. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />UAmot là pa̱,</para>
  <para style="q1" vid="AMO 7:11">&lt;&lt;Mí ga ngba̱l uYerobwam ka̱ atak ìkum,</para>
  <para style="q2" vid="AMO 7:11">te mí wur oga aIsa̱rila i re mbin oza̱ i ga izwal. I mai ka̱t oza̱ i ga izwal.&gt;&gt;<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />Te uAmaziya là ûAmot pa̱, &lt;&lt;Re atak va̱ ta̱ ánəm uga iva̱k, le ga mbin oga aYahudi, là ìchu Inan ɓu va̱ ka̱ ta kang ɓu ri ká̱. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />Kang wa ɗak yi ka̱ ta̱ ka̱ aBetel ká̱ nlà ìchu Inan ɓu va̱ ta ka̱t. Atak a va̱ ta̱ atak awop áponzhi, kang nnà atak awop achumchum.&gt;&gt;<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />Te uAmot ná ama̱n ûAmaziya pa̱, &lt;&lt;Mmami unəm uga nlà ìchu Inan ka̱t, kang mmami uya ànəm uga nlà ìchu Inan ka̱t kpa. Mmami unəm uga nkpak iya̱m nkang ká̱ nnak ishi ká̱ oga ipipyan. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />Te uYawe kap mi ká̱ nkpak iya̱m nkang,&gt;&gt; uYawe là á mi pa̱, &lt;&lt;Ga là ìchu Inan ónəm mi oIsa̱rila.&gt;&gt; <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />Ǹyangmata̱ te, gwong achwang kà̱ nnap-nlà àYawe. U là pa̱,</para>
  <para style="q1" vid="AMO 7:16">&lt;&lt;Kang ń là ìchu Inan ka̱ apal ishi oIsa̱rila ka̱t,</para>
  <para style="q2" vid="AMO 7:16">kang ń là nnap-nlà ka̱ apal ishi nzhi àIshaku ka̱t.&gt;&gt;<verse eid="AMO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />Ka̱kul nva̱ ta te, uYawe là pa̱,</para>
  <para style="q1" vid="AMO 7:17">&lt;&lt;UChar ɓu i nyáng uga nnəm mmai ka̱ ashe ìtong.</para>
  <para style="q2" vid="AMO 7:17">Ovan ɓu onunggwan ká̱ ovan ochar mí gbá̱ng ká̱ ndokchi.</para>
  <para style="q1" vid="AMO 7:17">Mí màl mbin ɓu ká̱ asang aga mmàl atak mí kap,</para>
  <para style="q2" vid="AMO 7:17">mmaɓu ká̱ ishi ɓu te ɓu kú ka̱ ashe mbin nvyapvyap.</para>
  <para style="q1" vid="AMO 7:17">Mí wur oga aIsa̱rila i re mbin oza̱ i ga izwal</para>
  <para style="q2" vid="AMO 7:17">i mai ka̱t oza̱ i ga izwal.&gt;&gt;<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s1">Nkatəp awar ìpipyan</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />UPonzhinan uYawe nyám alár á mi. N ya awar ìpipyan ìyályál ka̱ ashe nkatəp. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />UYawe ɓəp pa̱, &lt;&lt;Iza̱ u ya yà áAmot?&gt;&gt;</para>
  <para style="p" vid="AMO 8:2">Te n ma̱n pa̱, &lt;&lt;Nkatəp yə́l ká̱ awar ìpipyan ìyályál.&gt;&gt;</para>
  <para style="p" vid="AMO 8:2">Te uYawe là á mi pa̱,</para>
  <para style="q1" vid="AMO 8:2">&lt;&lt;Onəm mi oIsa̱rila yál chit,</para>
  <para style="q2" vid="AMO 8:2">mi watar ka̱ ashe oza̱.&gt;&gt;<verse eid="AMO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 8:3" />&lt;&lt;Oga nnap-nshì va̱ mí shì kà̱ nzhi iponzhi te, i wal ìpyang ikú ká̱ nda va̱ ta,&gt;&gt;</para>
  <para style="q2" vid="AMO 8:3">uPonzhinan uYawe à là.</para>
  <para style="q1" vid="AMO 8:3">Akúm ka̱ atak pa̱ kpaa,</para>
  <para style="q1" vid="AMO 8:3">mí swang ǹdúndùn.<verse eid="AMO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />O fe, mmawó va̱ o tòng onəm oga nlang</para>
  <para style="q2" vid="AMO 8:4">kang o nak onəm oga nkun pa̱ iya̱m ro ka̱ ashe mbin ka̱t.<verse eid="AMO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5" />O là pa̱,</para>
  <para style="q1" vid="AMO 8:5">&lt;&lt;Azəmwo nra ngga Nfa Apye apipye i watar</para>
  <para style="q2" vid="AMO 8:5">na í ya asa̱l ǹyáp ká̱ ìpirkur yi,</para>
  <para style="q1" vid="AMO 8:5">kang azəmwo Ìlum iga Njul i kùr</para>
  <para style="q2" vid="AMO 8:5">na í yáp ká̱ iya̱m mma yi yà?</para>
  <para style="q2" vid="AMO 8:5">Í tək ikpáng iga mma iya̱m kang í ran asikel,</para>
  <para style="q1" vid="AMO 8:5">í ma iya̱m ónəm ká̱ ka̱ apal mbwai mmakmak.<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />Í yáp ká̱ ikur va mmá lyang ká̱ adùng.</para>
  <para style="q2" vid="AMO 8:6">Í yáp unəm uga nkun ká̱ aazurfa.</para>
  <para style="q2" vid="AMO 8:6">Í yáp unəm uga nlàng ka̱ anung mbwai akwàp.&gt;&gt;<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />UYawe, Inan ovan oga aIsa̱rila sóng anung chit ka̱ apal ǹrup ká̱ ishi áYakup pa̱, &lt;&lt;Mi yà ká̱ nka̱ng ká̱ inga va̱ oza̱ nəm ka̱t.<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />Ka̱kul nva̱ ta te mbin i tán,</para>
  <para style="q2" vid="AMO 8:8">kang nkpaktak onəm oga ashishe i təm ká̱ aɗor ka̱t ɗò?</para>
  <para style="q1" vid="AMO 8:8">Mbin i wong wa ndəng awang aNilu,</para>
  <para style="q2" vid="AMO 8:8">i wong kang i fər wa aNilu aga aMasar.&gt;&gt;<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />UPonzhinan uYawe là pa̱, kà̱ ilum va̱ ta te,</para>
  <para style="q1" vid="AMO 8:9">&lt;&lt;Mi nak alum ka̱ apal ndəng i tar,</para>
  <para style="q2" vid="AMO 8:9">kang mbin i kpà̱r ká̱ alum.<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />Mi ga̱ɓa̱n nchang izər wo i yà ntəm aɗor,</para>
  <para style="q2" vid="AMO 8:10">kang nkpaktak nnap-nshì wo i nyáng ìpyang iga aɗor.</para>
  <para style="q1" vid="AMO 8:10">Mi nak o mwak ìlukwan iga ǹyə́ng ikú,</para>
  <para style="q2" vid="AMO 8:10">kang o kà̱p ishi.</para>
  <para style="q1" vid="AMO 8:10">Mi nak o yə́ng wa ánəm va uyiyen pa̱ uzəng kang à kú.</para>
  <para style="q2" vid="AMO 8:10">Ìlum va̱ ta nkukur i ɗul byet.&gt;&gt;<verse eid="AMO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />&lt;&lt;Fye, nra nna kà̱ mɓa.&gt;&gt; UPonzhinan uYawe là pa̱,</para>
  <para style="q2" vid="AMO 8:11">&lt;&lt;Mi ga re ǹre ká̱ ayáng kà̱ mbin.</para>
  <para style="q1" vid="AMO 8:11">Ayáng i ji oza̱ aga iya̱m-nrì ka̱t,</para>
  <para style="q2" vid="AMO 8:11">ndəng i gba̱l oza̱ ngga ndəng ngwà ka̱t kpa.</para>
  <para style="q1" vid="AMO 8:11">Ayáng ká̱ ndəng ngbà̱l</para>
  <para style="q2" vid="AMO 8:11">ka̱kul nɗom nfe nnap nla mi, uYawe.<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />Oza̱ i pin kà̱ ìwá ìva̱ ta̱ i ga ìva̱ cho,</para>
  <para style="q2" vid="AMO 8:12">oza̱ i ga mpal i ga asa̱l awu alum.</para>
  <para style="q1" vid="AMO 8:12">Ka̱kul oza̱ i ram pa̱ na o fe nnap-nlà àYawe,</para>
  <para style="q2" vid="AMO 8:12">kang oza̱ i ya ka̱t.<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />&lt;&lt;Ka̱ ashe nra va̱ ta ovan ochar ogəkgək oɓyenɓyen ká̱ ovan nza̱m okankam i tàk ká̱ ndəng ngbà̱l.&gt;&gt;<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />Oza̱ va̱ i sóng anung ká̱ mpat oga aSamariya,</para>
  <para style="q2" vid="AMO 8:14">oza̱ i là pa̱, &lt;&lt;Nnandər, wa nva inan ɓu ì ya yà, áDan&gt;&gt;</para>
  <para style="q2" vid="AMO 8:14">ka̱t te &lt;&lt;Á yà wa nji ɓu lap ka̱t á ìchər oga aBəyersheba&gt;&gt;</para>
  <para style="q1" vid="AMO 8:14">oza̱ i tàk, i yà ká̱</para>
  <para style="q2" vid="AMO 8:14">ngwong lap ka̱t mbyet mbyet.<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s1">NTàn nro yà nva unəm i <optbreak />nəm ká̱ akwali Inan ka̱t</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />N ya uPonzhinan sat ka̱ atak nshì iya̱m awop. Uza̱ là pa̱,</para>
  <para style="q1" vid="AMO 9:1">&lt;&lt;Lə̀p nggwan nzhi awop pa̱ gənggəng na mbang nzhi á yənggət.</para>
  <para style="q2" vid="AMO 9:1">Chwan oza̱ á tàk ka̱ apal ishi nkpaktak onəm.</para>
  <para style="q1" vid="AMO 9:1">Aɓo onəm te, mi gbá̱ng ká̱ ndokchi.</para>
  <para style="q2" vid="AMO 9:1">UNəm pa̱ uzəng i pətər ka̱t,</para>
  <para style="q2" vid="AMO 9:1">uro ya i lár ka̱t.<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />A yà pa̱ oza̱ atáng aShəwol te,</para>
  <para style="q2" vid="AMO 9:2">awo mi i fa ká̱ oza̱ ka̱ ta.</para>
  <para style="q1" vid="AMO 9:2">A yà pa̱ oza̱ a kyen ka̱ ashe apaɓur te,</para>
  <para style="q2" vid="AMO 9:2">mi fəng ká̱ oza̱ ka̱ ta.<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />A yà pa̱ oza̱ a bwam kà̱ ìtə́ngtə́ng aɓam aKarmel te,</para>
  <para style="q2" vid="AMO 9:3">mi ram oza̱ mi fəng ká̱ ka̱ ta.</para>
  <para style="q1" vid="AMO 9:3">A yà pa̱ oza̱ a bwam ka̱ avəng ìwá te,</para>
  <para style="q2" vid="AMO 9:3">mi nak awù aga ashe ndəng i kyen oza̱.<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />A yà pa̱ okpa ìkum oza̱ a wur izwal ká̱ oza̱ te,</para>
  <para style="q2" vid="AMO 9:4">mi nak mí gbá̱ng oza̱ ká̱ ndokchi.</para>
  <para style="q1" vid="AMO 9:4">Mi pá ìwu óza̱,</para>
  <para style="q2" vid="AMO 9:4">ka̱kul inga, inəna̱n ka̱t.&gt;&gt;<verse eid="AMO 9:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 9:5" />UPonzhinan uYawe uga nggatək</para>
  <para style="q2" vid="AMO 9:5">dok apambin te apambin sərak,</para>
  <para style="q2" vid="AMO 9:5">nkpaktak onəm oga ashishe təm ká̱ aɗor.</para>
  <para style="q1" vid="AMO 9:5">Nkpaktak mbin i wong kang i fər,</para>
  <para style="q2" vid="AMO 9:5">wa ìgum ndəng awang aNilu aga aMasar.<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />Uza̱ va me nzhi iponzhi wò ka̱ ashe apaɓur,</para>
  <para style="q2" vid="AMO 9:6">kang uza̱ bang akukum ka̱ apambin.</para>
  <para style="q1" vid="AMO 9:6">Uza̱ wór ndəng ìwá</para>
  <para style="q2" vid="AMO 9:6">tar ka̱ apambin.</para>
  <para style="q2" vid="AMO 9:6">Aɗiɗin pa̱ uYawe.<verse eid="AMO 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />UYawe ɓəp pa̱, &lt;&lt;Ónəm oIsa̱rila, o rəng pa̱ o ji</para>
  <para style="q2" vid="AMO 9:7">onəm oKush ji ka̱ atak mi ɗò?</para>
  <para style="q1" vid="AMO 9:7">Mmami na n fa ká̱ oga aIsa̱rila kà̱ mbin aMasar,</para>
  <para style="q2" vid="AMO 9:7">ká̱ oFilisti ka̱ aKafto.</para>
  <para style="q2" vid="AMO 9:7">Kang onəm oga aAram te, ka̱ aKir ka̱t ɗò?&gt;&gt;<verse eid="AMO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />&lt;&lt;Dər, uPonzhinan uYawe</para>
  <para style="q2" vid="AMO 9:8">kà̱ ndər iponzhi iɓá̱ngɓa̱ng oga aIsa̱rila va̱ ta̱,</para>
  <para style="q1" vid="AMO 9:8">mi zhì na i le</para>
  <para style="q2" vid="AMO 9:8">ka̱ apambin.</para>
  <para style="q1" vid="AMO 9:8">Káp ká̱ nnà te, mi nzhì nkpaktak</para>
  <para style="q2" vid="AMO 9:8">nzhi àYakup ka̱t,&gt;&gt; uYawe à là.<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />&lt;&lt;Mi nak mí yənggət oga aIsa̱rila</para>
  <para style="q2" vid="AMO 9:9">ka̱ ashe nkpaktak oga mbin,</para>
  <para style="q1" vid="AMO 9:9">wa nva mí yeka̱n ikur ká̱ ìkpáng ìga atum,</para>
  <para style="q2" vid="AMO 9:9">apir pa̱ zəng i yà ká̱ nlar ka̱t&gt;&gt;<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />Onəm oga nnap mɓá̱ngɓa̱ng pa̱ kpaktak te mí zhì oza̱ ká̱ ndokchi.</para>
  <para style="q2" vid="AMO 9:10">Onəm va kà̱ nlà pa̱, &lt;&lt;Iya̱m ro i yà ká̱ ǹya yi ka̱t.&gt;&gt;<verse eid="AMO 9:10" /></para>
  <para style="s1">Ngwong ká̱ oga aIsa̱rila</para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 9:11" />&lt;&lt;Kà̱ ìlum va̱ ta te,</para>
  <para style="q2" vid="AMO 9:11">mi me nzhi aDawuda kà̱ɗi .</para>
  <para style="q1" vid="AMO 9:11">Mi ɗa̱mshi oga mɓol akamsəlang,</para>
  <para style="q2" vid="AMO 9:11">mi wong ká̱ oga agúng va̱ shin</para>
  <para style="q2" vid="AMO 9:11">kang mi me oza̱ wa nva ka̱ yà,<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />ka̱kul na oza̱ à ka̱m aɓo oga aEdom va̱ re,</para>
  <para style="q2" vid="AMO 9:12">ka̱ nkpaktak oga mbin va̱ ka̱ yà mí wór oza̱ pa̱ ojem á.&gt;&gt;</para>
  <para style="q2" vid="AMO 9:12">UYawe va i ga nnənəm à là.<verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />&lt;&lt;Fye, nra na kà̱ mɓa.&gt;&gt; UYawe là pa̱,</para>
  <para style="q1" vid="AMO 9:13">&lt;&lt;Iya̱m i yál nna mmá gba̱l nshàng ìram chit ka̱t,</para>
  <para style="q2" vid="AMO 9:13">kang nkáng ndəng ìba̱ngba̱ng ǹsámsàm nna i ga mpyal mɓəɓal.</para>
  <para style="q1" vid="AMO 9:13">Aɓam i na ndeng ìba̱ngba̱ng ichángchàng</para>
  <para style="q2" vid="AMO 9:13">va i ɓəl ka̱ apal oga aɗuktum.<verse eid="AMO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14" />Mi le ká̱ onəm mi oIsa̱rila ka̱ atak izwal,</para>
  <para style="q2" vid="AMO 9:14">oza̱ i me oga ìtong oza̱ va̱ ra agúng i təm kà̱.</para>
  <para style="q1" vid="AMO 9:14">Oza̱ i ɓál ìba̱ngba̱ng oza̱ i wá ndədəng,</para>
  <para style="q2" vid="AMO 9:14">oza̱ i wap ìram ìkáká, i ri iyəya̱m.<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />Mi ɓál oza̱ ka̱ ashe mbin oza̱,</para>
  <para style="q2" vid="AMO 9:15">mí yà ká̱ ntur oza̱ lap kà̱ mbin va̱ nná óza̱ ka̱t.&gt;&gt;</para>
  <para style="q2" vid="AMO 9:15">UYawe, Inan wo à là.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>