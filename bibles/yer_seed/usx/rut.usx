<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="RUT" style="id">- Tarok</book>
  <para style="h">Nlir aRut</para>
  <para style="toc3">aRut</para>
  <para style="toc2">aRut</para>
  <para style="toc1">Nlir aRut</para>
  <para style="mt1">aRut</para>
  <para style="imt2">ARut UElimelek Ká̱ Onəm wo Ka̱ aMowap</para>
  <chapter number="1" style="c" sid="RUT 1" />
  <para style="s">UElimelek ká̱ onəm wo ka̱ aMowap</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 1:1" />Ka̱ ashe nra va̱ onəm oga nnáp akwali kà̱ nnəm iponzhi te, ayang fa ka̱ ashe mbin, te unəm uga aBet-Lehem ka̱ aYahudi wong ga təm kà̱ mbin aMowap ká̱ uchar wò ká̱ ovan wò onunggwan pa̱ oparəm. <verse eid="RUT 1:1" /><verse number="2" style="v" sid="RUT 1:2" />Aɗin anəm va̱ ta pa̱ uElimelek, aɗin achəchar pa̱ uNa'omi, kang aɗin ovəvan oga oparəm pa̱ uMalon ká̱ uKiliyon. Oza̱ onəm oga aEfraita kà̱ aBet-Lehem ka̱ mbin aYahudi. Oza̱ ga təm ka̱ mbin aMowap.<verse eid="RUT 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="RUT 1:3" />Te uElimelek uɓar aNa'omi kú, re na ká̱ ovəvan oga oparəm.<verse eid="RUT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="RUT 1:4" />Te oza̱ ka̱m ichar ká̱ ovan oMowap. Aɗin aro pa̱ uOrfa kang a ji á ro pa̱ uRut. Oza̱ təm ka̱ ta ìzun pa̱ igba̱pchi.<verse eid="RUT 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 1:5" />UMalon ká̱ uKiliyon mparəm oza̱ kú kpa, kang a re uNa'omi ovan yà ka̱t ubar yà ka̱t.<verse eid="RUT 1:5" /></para>
  <para style="s">UNa'omi ká̱ uRut le aBet-Lehem</para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 1:6" />UNa'omi fe pa̱ uYawe song onəm wò chit, na iya̱m-nrì ôza̱ kà̱ mbin aYahudi. Te uza̱ ká̱ oká wò yar pa̱ ó re mbin aMowap. <verse eid="RUT 1:6" /><verse number="7" style="v" sid="RUT 1:7" />Oza̱ re atak va̱ uza̱ ka̱ yà kà̱ ká̱ oká wò pa̱ oparəm, oza̱ kpán asa̱l nle mbin aYahudi. <verse eid="RUT 1:7" /><verse number="8" style="v" sid="RUT 1:8" />Te uNa'omi là oká wò oga oparəm va̱ ta̱ pa̱, &lt;&lt;Nza̱ uzəngtəng wó nggo a le aga nzhi ka̱ atak anang wò. UYawe a nəm ikin a wó wa nva ó nəm á mi ká̱ ôbar wó va̱ kú. <verse eid="RUT 1:8" /><verse number="9" style="v" sid="RUT 1:9" />UYawe á nak nza̱ uzəngtəng wó nggo á vang ka̱ɗi na a ya njul ka̱ nzhi aɓar wo.&gt;&gt; Te uza̱ bur oza̱ kang oza̱ yə́ng pa̱ gbá̱ngbá̱ng, <verse eid="RUT 1:9" /><verse number="10" style="v" sid="RUT 1:10" />te oza̱ là á na pa̱, &lt;&lt; Í le nzəng ká̱ ɓu ka̱ atak onəm ɓu.&gt;&gt; <verse eid="RUT 1:10" /><verse number="11" style="v" sid="RUT 1:11" />UNa'omi là oza̱ pa̱, &lt;&lt;Ó le, ovan mi, ka̱kul iza̱ kang ó ga nzəng ká̱ mi yà? Ǹ na ǹyà ka̱ ovan onunggwan oro ka̱ ashe afu mi ova i ga nnyang oɓar wo ɗò? <verse eid="RUT 1:11" /><verse number="12" style="v" sid="RUT 1:12" />Ó le ó ga ovan mi, ka̱kul igbák mi watar nva̱ chit pa̱ n yà ká̱ uɓar. A yà pa̱ nna n yà ká̱ nnak ìgwak kà̱ uɓar ká̱ ìzwam iga nda kang n mar ovan onunggwan, <verse eid="RUT 1:12" /><verse number="13" style="v" sid="RUT 1:13" />te ó lòk oza̱ i nyang ɗò? Ó váng ka̱t ka̱kul oza̱ ɗò? Pa ka̱t ovan mi, ó nyi pa̱ i nəm kat, ka̱kul nlak ìgwak mi mak ji nji wó byet, ka̱kul uYawe wa ɓa ka̱ mɓək anung va̱ ta̱ á mi.&gt;&gt; <verse eid="RUT 1:13" /><verse number="14" style="v" sid="RUT 1:14" />Te oza̱ yə́ng pa̱ gbá̱ngbá̱ng kà̱ɗi. UOrfa bur ukà wò là nlyang á na, kang uRut yang á na ka̱ izər. <verse eid="RUT 1:14" /><verse number="15" style="v" sid="RUT 1:15" />&lt;&lt;Dər&gt;&gt; UNa'omi là uRut pa̱, &lt;&lt;Ukpàt ɓu le chit ga atak onal wò ká̱ ínan wò. Le, ga nvəva̱ng.&gt;&gt; <verse eid="RUT 1:15" /><verse number="16" style="v" sid="RUT 1:16" />URut là á na pa̱ &lt;&lt;Kang wa chál mi pa̱ n le kà̱ nvang ɓu ka̱t, atak va ɓu ga te mi ga nna, kang atak va̱ ɓu təm kà̱ te, mi təm ka̱ ta nà, onəm ɓu i yà onəm mi kang Inan ɓu i yà Inan mi. <verse eid="RUT 1:16" /><verse number="17" style="v" sid="RUT 1:17" />Atak va̱ ɓu kú kà̱ te, ka̱ tá na mi kú, kang ka̱ ta na kpa mí li mi. Inan a pyát á mi a yà pa̱ ikú à kap mi ka̱ ɓu ka̱t á.&gt;&gt; <verse eid="RUT 1:17" /><verse number="18" style="v" sid="RUT 1:18" />Nva̱ngva̱ uNa'omi ya uRut yar chit pa̱ ò ga nzəng ká̱ wò te, uza̱ re nchál na. <verse eid="RUT 1:18" /><verse number="19" style="v" sid="RUT 1:19" />Mparəm oza̱ chen oza̱ ɓa aBet-Lehem. Nva̱ngva̱ oza̱ ɓa chu aBet-Lehem te, nkpaktak ìtong lan ka̱kul oza̱, kang ochar là pa̱, &lt;&lt;uNa'omi wa ta̱ ɗó?&gt;&gt; <verse eid="RUT 1:19" /><verse number="20" style="v" sid="RUT 1:20" />Te uza̱ là oza̱ pa̱, &lt;&lt;Kang ó wór mi pa̱ uNa'omi ka̱t, ó wór mi pa̱ uLakgwak, ka̱kul Uga iChumchum nak irirì mi ka̱ ashe nlak ìgwak pa̱ makmak. <verse eid="RUT 1:20" /><verse number="21" style="v" sid="RUT 1:21" />N ga ká̱ iya̱m pa̱ kyák kang uYawe le ká̱ mi ulakchi. Sang kang ó wór mi pa̱ uNa'omi yà, nna uYawe nəm avyal ká̱ mi kang Uga iChumchum nak mi ka̱ ashe nɗaktak.&gt;&gt;<verse eid="RUT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="RUT 1:22" />Wa nna ta̱ uNa'omi le ká̱ ukà wò uRut uyen oMowap, uva fa nzəng ka̱ na ka̱ ashe mbin aMowap oza̱ ɓa aBet-Lehem kà̱ mɓan nkpám ibəshi.<verse eid="RUT 1:22" /></para>
  <chapter eid="RUT 1" />
  <chapter number="2" style="c" sid="RUT 2" />
  <para style="s">URut nəm inok ka̱ ashe ìram aBowaz</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 2:1" />UNa'omi uwa yà ká̱ unal aɓar wò unəm uga ndur ka̱ akum aElimelek, aɗiɗin pa̱ uBowaz. <verse eid="RUT 2:1" /><verse number="2" style="v" sid="RUT 2:2" />URut uyen oMowap là ûNa'omi pa̱, &lt;&lt;Re ń ga ashe ìram ń chak nva̱ng ìbəshi kà̱ nva̱ng ànəm va kpaktak nyám ikin á mi.&gt;&gt; Te uza̱ ma̱n á na pa̱, &lt;&lt;Ga, ayen mi.&gt;&gt; <verse eid="RUT 2:2" /><verse number="3" style="v" sid="RUT 2:3" />Te uza̱ ga chu ashe ìram ìro kang à ɓàn nchák nva̱ng ìbəshi kà̱ nva̱ng onəm oga nkpám iya̱m. Ìram va̱ ta iji aBowaz unəm uga akum aElimelek. <verse eid="RUT 2:3" /><verse number="4" style="v" sid="RUT 2:4" />Ta byet te, uBowaz vàng ka̱ aBet-Lehem kang uza̱ re anung ônəm oga nkpám iya̱m pa̱, &lt;&lt;UYawe á təm nzəng ká̱ wó.&gt;&gt; Oza̱ là á na pa̱, &lt;&lt;UYawe á nak nnap nnəna̱n á ɓu.&gt;&gt;<verse eid="RUT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 2:5" />Te uBowaz ɓəp ukpari wò uga ndər ishi onəm oga nkpám iya̱m pa̱, &lt;&lt;Uyen ɓyen à da ta̱ yà?&gt;&gt; <verse eid="RUT 2:5" /><verse number="6" style="v" sid="RUT 2:6" />Te unəm uga ndər ishi onəm oga nkpám iya̱m va̱ ta na á ma̱n á na pa̱, &lt;&lt;Uyen ɓyen uga mbin aMowap va ɓa nzəng ká̱ uNa'omi. <verse eid="RUT 2:6" /><verse number="7" style="v" sid="RUT 2:7" />Uza̱ chál pa̱ mmá ma̱n á wò na ô chák nva̱ng ìbəshi kà̱ nva̱ng onəm oga nkpám iya̱m. Uza̱ ɓàn nchə́chak ká̱ ìpin á jul kà̱ ka̱t, nna ta̱ kang uza̱ kà̱ njul pa̱ ɗa̱p.&gt;&gt;<verse eid="RUT 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="RUT 2:8" />Te uBowaz là ûRut pa̱, &lt;&lt;Fe ayen mi, kang wa re ashe ìram iva̱ ta̱ wa ga nchák nva̱ng ìbəshi ka̱ ashe ìram ikak ka̱t, chen nzəng ká̱ ovan ɓyen oga nnəm inok á mi. <verse eid="RUT 2:8" /><verse number="9" style="v" sid="RUT 2:9" />Ìwu ɓu á yà ka̱ apal ìram va oza̱ kà̱ nkpə́kpam, kang ɓù chen kà̱ nva̱ng oza̱. N ɗa̱t ovan nza̱m va̱ta chit pa̱ kang oza̱ á dok ɓu ka̱t, kang ndəng á gba̱l ɓu te, ga ɓù tók ka̱ ashe oga aba̱ng va̱ ovan nza̱m ɗyang kang ɓù wá.&gt;&gt;<verse eid="RUT 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="RUT 2:10" />Te uRut ɓəram kà̱ mbin kwangtal ishi là á na pa̱, &lt;&lt;Sang kang n ya nnap nnəna̱n ka̱ atak ɓu, u nak ishi ká̱ mi, nnà mmami uɗyanəm yà?&gt;&gt; <verse eid="RUT 2:10" /><verse number="11" style="v" sid="RUT 2:11" />Te uBowaz na ama̱n á na pa̱, &lt;&lt;Mmá shàl á mi chit, nkpaktak iya̱m va̱ u nəm ûkà ɓu nva̱ngva̱ uɓar ɓu kú, ká̱ nva̱ u re upon ɓu ká̱ unang ɓu ká̱ mbin onəm ɓu kang u ɓa atak onəm va̱ u nyi chit ká̱ nlám ka̱t. <verse eid="RUT 2:11" /><verse number="12" style="v" sid="RUT 2:12" />UYawe á mwa iya̱m va̱ u nəm. Re amwa ɓu á yà pa̱ súr ka̱ atak aYawe Inan oga aIsa̱rila, uva̱ u ɓa nram mbwam ka̱ ashe abasəmbasəm.&gt;&gt; <verse eid="RUT 2:12" /><verse number="13" style="v" sid="RUT 2:13" />Te uRut là pa̱, &lt;&lt;Re ń ga mpyal ká̱ ǹya nnap nnəna̱n ka̱ atak ɓu anəm uga nzhi mi, ka̱kul u sak mi chit kang u là nnap îgwak àzwal ɓu káp ká̱ ǹva̱ pa̱ n yà uzəngtəng ka̱ ashe onəm oga nnəm inok á ɓu ka̱t.&gt;&gt;<verse eid="RUT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 2:14" />Awalang aga nrí iya̱m-nrì nəm te, uBowaz là ûRut pa̱, &lt;&lt;Ɓa ta̱ na ú ka̱m iya̱m-nrì, kang ɓù zwap ka̱ ashe ndəng ìba̱ngba̱ng nsámsám.&gt;&gt;</para>
  <para style="p" vid="RUT 2:14">Te uza̱ təm dat ká̱ onəm oga nkpám iya̱m kang uBowaz yichi nzəngkəng á na. Uza̱ ri afu yə́l na aɓuɓo le. <verse eid="RUT 2:14" /><verse number="15" style="v" sid="RUT 2:15" />Nva̱ngva̱ uRut wóng pa̱ ô chák nva̱ng ibəshi te, uBowaz na nnap-nlà ônəm wò pa̱, &lt;&lt;Re uza̱ á chák ka̱ atak va̱ mma nak isarsar kà̱ kpa, kang ó na ìwuswa á na ka̱t. <verse eid="RUT 2:15" /><verse number="16" style="v" sid="RUT 2:16" />Ó zə̀p isanglang ka̱ ashe isarsar kpa ó re na uza̱ á wur, kang ó ra̱n ká̱ na ka̱t. <verse eid="RUT 2:16" /><verse number="17" style="v" sid="RUT 2:17" />Wa nnà ta uza̱ chák nva̱ng ibəshi á ga chu anung arurong, kang uza̱ pək iya̱m va̱ uza̱ chák te, ibəshi chu ikpáng pa̱ iparəm. <verse eid="RUT 2:17" /><verse number="18" style="v" sid="RUT 2:18" />Uza̱ yar tar ashe ìtong ká̱, kang uza̱ nyám ûkà wò iya̱m va̱ uza̱ chák. Uza̱ fa ká̱ aɓo iya̱m-nrì va̱ uza̱ ri na á na. <verse eid="RUT 2:18" /><verse number="19" style="v" sid="RUT 2:19" />Ukə̀ka ɓəp na pa̱, u chák nva̱ng ibəshi va̱ ka̱ chè n̂da yà? U nəm inok ka̱ chè yà? Nnap nnəna̱n á təm nji ànəm va̱ nak ishi ká̱ ɓu.&gt;&gt;</para>
  <para style="p" vid="RUT 2:19">Te uRut là ûkà wò unəm va̱ uza̱ nəm inok ka̱ na nda. Uza̱ là pa̱, &lt;&lt;Aɗiɗin pa̱ uBowaz.&gt;&gt;<verse eid="RUT 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="RUT 2:20" />UNa'omi là ûRut pa̱, &lt;&lt;UYawe va̱ kap ká̱ nnəm ikin ônəm oga irirì ká̱ onəm okúkú ka̱t, te á nak nnap nnəna̱n á na.&gt;&gt; Kang uNa'omi ga mpyal ká̱ nlà á na pa̱, &lt;&lt;Unəm va̱ ta unàl yi uga ndatkulung, uza̱ uzəngtəng ka̱ ashe onəm yi oga akup.&gt;&gt; <verse eid="RUT 2:20" /><verse number="21" style="v" sid="RUT 2:21" />Te uRut uyen oMowap á là pa̱, &lt;&lt;Nnà ká̱ nkukwa ka̱t, uza̱ là á mi kpa pa̱, &lt;Chen ká̱ onəm oga inok mi oza̱ á gba̱l ká̱ nkpám nkpaktak iya̱m mi kang.&gt; &gt;&gt; <verse eid="RUT 2:21" /><verse number="22" style="v" sid="RUT 2:22" />UNa'omi là ûRut ukà wò pa̱, &lt;&lt;Aɓiɓyen, á yen mi, pa̱ ú chen nzəng ká̱ ovan ɓyen oga nnəm inunok, le kang mmá a zul ɓu ka̱ ashe ìram ikak ka̱t.&gt;&gt; <verse eid="RUT 2:22" /><verse number="23" style="v" sid="RUT 2:23" />Wa nnà ta uza̱ ɓa dát ká̱ ovan ɓyen oga nnəm inok ûBowaz, kà̱ nəm inok nchák nva̱ng iya̱m nkpam, ìbəshi ká̱ ìzangzəng kùr kang uza̱ təm ká̱ ukà wò.<verse eid="RUT 2:23" /></para>
  <chapter eid="RUT 2" />
  <chapter number="3" style="c" sid="RUT 3" />
  <para style="s">UBowaz ka̱ uRut ka̱ atak mpək iya̱m</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 3:1" />Ka̱ alum sur ro te, uNa'omi ukà aRut là á na pa̱, &lt;&lt;Ayen mi, nkpak pa̱ ń nram uɓar á ɓu na u ya nzhi njul, kang ɓu fe nchang kà̱. <verse eid="RUT 3:1" /><verse number="2" style="v" sid="RUT 3:2" />Ǹyangmata̱ te, uBowaz unàl yi va̱ u nəm inok ká̱ ochar oga nnəm inok á na. Dər, uza̱ kà̱ ngwol ibəshi ka̱ atak mpək iya̱m ká̱ ìzwam va̱ ta̱. <verse eid="RUT 3:2" /><verse number="3" style="v" sid="RUT 3:3" />Wor izər, sháng nturari, na u mwak iya̱m ìsham ɓu iɓyenɓyen, te ga atak mpək iya̱m va̱ ta. Kang wa ma̱n uza̱ á nyi mɓa ɓu ka̱t, ya uza̱ á gba̱l ká̱ nrí iya̱m-nrì ká̱ ngwá ndəng kang. <verse eid="RUT 3:3" /><verse number="4" style="v" sid="RUT 3:4" />Nva̱ngva̱ uza̱ a ra te, wa nak ishi ka̱ atak va̱ uza̱ i ra kà̱. Te ga ná ú gha̱l iya̱m iga ndàng izəzər ka̱ asa̱l ashəshar wa ra. Uza̱ i là iya̱m va̱ á ɓu pa̱ ú nəm.&gt;&gt; <verse eid="RUT 3:4" /><verse number="5" style="v" sid="RUT 3:5" />Te uRut là ûkà wò pa̱, &lt;&lt;Nkpaktak iya̱m va̱ u là á mi te, mi nənəm.&gt;&gt; <verse eid="RUT 3:5" /><verse number="6" style="v" sid="RUT 3:6" />Te uza̱ ga atak mpək iya̱m va̱ kang uza̱ nəm nkpaktak iya̱m wa nva ukəka là á na pa̱ uza̱ á nəm. <verse eid="RUT 3:6" /><verse number="7" style="v" sid="RUT 3:7" />Ka̱ nva̱ngva̱ uBowaz ri iya̱m uza̱ wá ndəng kang ìgugwak ra chit te, uza̱ ga ra ka̱ nkùr aɓák, te uRut ɓa gha̱l atak ashəshar te ra. <verse eid="RUT 3:7" /><verse number="8" style="v" sid="RUT 3:8" />Ká̱ ishimshe ìzwam te, uBowaz ga̱m kang à ga̱ɓa̱n te, uza̱ ya uchar ra kà̱ ngba̱k ashar wò. <verse eid="RUT 3:8" /><verse number="9" style="v" sid="RUT 3:9" />Uza̱ ɓəp pa̱, &lt;&lt;Mmaɓu uda yà?&gt;&gt; Te uza̱ ma̱n pa̱, &lt;&lt;Mmami uRut, uzwal ɓu. Bol iya̱m iga ndàng izər ɓu ka̱ apal azwal ɓu, ka̱kul mmaɓu ùnal aɓar mi uga akup.&gt;&gt; <verse eid="RUT 3:9" /><verse number="10" style="v" sid="RUT 3:10" />Uza̱ là pa̱, &lt;&lt;UYawe á nak nnap nnəna̱n á ɓu áyen mi. Ikin iva̱ ta̱ u nyám á mi te, á ji iga nggəshi ji. U yar nva̱ng onəm oga ndur, ka̱t te oga nkun ɗò ka̱t. <verse eid="RUT 3:10" /><verse number="11" style="v" sid="RUT 3:11" />Ǹyangmata̱ ayen mi kang ayər á nəm ɓu ka̱t. Iya̱m va̱ uchál pa̱ kpaktak te, mi nəm á ɓu, ka̱kul onəm oga ìtong nyinyi pa̱ mmaɓu uchar ukin. <verse eid="RUT 3:11" /><verse number="12" style="v" sid="RUT 3:12" />Nnandər pa̱ mmami ùnal uga akup, ká̱ nnà te ùnal uga akup va̱ datkulung ji mi ji uwa yà. <verse eid="RUT 3:12" /><verse number="13" style="v" sid="RUT 3:13" />Ra atak atàn, ìpin kang uza̱ ama̱n nka̱m akup ká̱ ɓu te, ya a ɓyen, uza̱ i ka̱m ɓu. Kang a yà pa̱ uza̱ ama̱n pa̱ ô ka̱m akup ká̱ ɓu ka̱t te, n sóng anung ká̱ uYawe mi ka̱m akup ká̱ ɓu. Ra atak atàn kang.&gt;&gt; <verse eid="RUT 3:13" /><verse number="14" style="v" sid="RUT 3:14" />Te uza̱ ra kà̱ ngba̱k ashəshar atak ka̱ ntàn pa̱ kpəla̱m te uza̱ mor wóng kang unəm ì nyi uwanwò. UBowaz là pa̱ &lt;&lt;Kang unəm uro á nyi pa̱ uchar ɓa ka̱ atak mpək iya̱m ka̱t.&gt;&gt; <verse eid="RUT 3:14" /><verse number="15" style="v" sid="RUT 3:15" />UBowaz là á na pa̱, &lt;&lt;Fən ashawulu ɓu nàr ka̱ mbin.&gt;&gt; Uza̱ nàr te uBowaz ma ibəshi á na ikpáng iga mma iya̱m pa̱ ìkpa̱ɗing te uza̱ yar na ká̱. Uza̱ tar ashe ìtong. <verse eid="RUT 3:15" /><verse number="16" style="v" sid="RUT 3:16" />URut ɓa atak akà wò te, uza̱ ɓəp na pa̱, &lt;&lt;U ya sang yà ayen mi?&gt;&gt; Te uza̱ shal iya̱m va̱ unəm va̱ ta nəm á na pa̱ kpaktak. <verse eid="RUT 3:16" /><verse number="17" style="v" sid="RUT 3:17" />Uza̱ là pa̱, &lt;&lt;Uza̱ wa na ibəshi va̱ ta̱ á mi ìkpáng iga mma iya̱m pa̱ ìkpa̱ɗing, uza̱ là kà̱ pa̱, &lt;Kang wa le ká̱ awo alakchi ka̱ atak akà ɓu ka̱t.&gt; &gt;&gt; <verse eid="RUT 3:17" /><verse number="18" style="v" sid="RUT 3:18" />UNa'omi là pa̱, &lt;&lt;Lòk ayen mi, kang ɓù dər asa̱l awu nnap va̱ ta̱, ka̱kul ìgwak ànəm va̱ ta i ya ká̱ nra ka̱t, uza̱ i gba̱l nnap va̱ ta̱ nda va ta̱.&gt;&gt;<verse eid="RUT 3:18" /></para>
  <chapter eid="RUT 3" />
  <chapter number="4" style="c" sid="RUT 4" />
  <para style="s">UBowaz ka̱m uRut</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 4:1" />UBowaz fa ga təm ka̱ anung asa̱l ìtong. Te uza̱ ya unəm uga nka̱m akup va̱ uza̱ ka̱ là kà̱ nwatar. Te uBowaz wór na pa̱, &lt;&lt;Ɓa ta̱ anəm va̱ ta̱, təm ká̱ ìjili.&gt;&gt; Te unəm va̱ ta le ga təm.<verse eid="RUT 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="RUT 4:2" />Te uza̱ wór onəmgbak oga ìtong pa̱ ogba̱pchi là óza̱ pa̱, &lt;&lt;Ó təm ka̱ ta̱.&gt;&gt; Te oza̱ təm ká̱ ìjili. <verse eid="RUT 4:2" /><verse number="3" style="v" sid="RUT 4:3" />Uza̱ là unəm uga nka̱m akup va̱ ta pa̱, &lt;&lt;UNa'omi va̱ le kà̱ mbin oMowap te, uza̱ ɗom nyap ká̱ ìram agənang yi uElimelek. <verse eid="RUT 4:3" /><verse number="4" style="v" sid="RUT 4:4" />Te n ya màl pa̱ n nyám ka̱ á ɓu. Yap kà̱ mpyal onəm va̱ təm ta̱, ká̱ mpyal onəmgbak onəm mi. A yà pa̱ ɓu yəyap te, yap, kang a yà pa̱ ɓu le ɓu yap ka̱t te, là á mi na n nyi, ka̱kul unəm uga yəyap ya ka̱t mmaɓu na, te mmami kà̱ nva̱ng ɓu.&gt;&gt; Uza̱ là pa̱, &lt;&lt;Mi ka̱m ishishi ka̱m.&gt;&gt;<verse eid="RUT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 4:5" />Na chit te uBowaz là pa̱, &lt;&lt;Awalang va̱ ɓu yáp iram va̱ ta ká̱ ka̱ awo aNa'omi te, wa ka̱m ka̱ uRut kpa, uyen oMowap uchar ànəm va̱ kú, ka̱kul na aɗiɗin á təm ka̱ apal iya̱m akúkup.&gt;&gt;<verse eid="RUT 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 4:6" />Unəm uga nka̱m akup uga ndatkulung va̱ ta là pa̱, &lt;&lt;Mi yà ká̱ nka̱m ishishi ka̱t, le kang ma vyap nnap iya̱m akup mi ka̱t. Ka̱m iya̱m akup mi va̱ ta á təm iji ɓu, mi ka̱m ka̱t.&gt;&gt;<verse eid="RUT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="RUT 4:7" />Nnap nnəm va ta̱ ka̱ yà ka̱ ashe oIsa̱rila ka̱ apal nnap nnəm ngga nka̱mshi ká̱ mpəl iya̱m akum, nna pa̱ unəm i tur akwap wo i na ûwanwò. Nna ta̱ mí nəm ka̱ aIsa̱rila.<verse eid="RUT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="RUT 4:8" />Nva̱ ùnal uga nka̱m akup uga ndatkulung va̱ ta là uBowaz pa̱, &lt;&lt;Ka̱m a təm iji ɓu te,&gt;&gt; uza̱ tur akwap wò uza̱ na ûBowaz.<verse eid="RUT 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="RUT 4:9" />Te uBowaz là ônəm gbák ká̱ nkpaktak onəm va̱ ta pa̱, &lt;&lt;N̂da va̱ ta̱ kà̱ iwu wó n yap nkpaktak iya̱m aElimelek chit iva̱ iji aKiliyon ká̱ uMalon ka̱ awó aNa'omi. <verse eid="RUT 4:9" /><verse number="10" style="v" sid="RUT 4:10" />Ká̱ uRut kpa, uchar aMalon ukpələng, uyen oMowap á yà uchar mi, na n re nva̱ng unəm kukú va̱ ká̱ iya̱m kukup pa̱ kpaktak. Ka̱kul kang aɗiɗin á lar ka̱ ashe ogənanggənang ká̱ ìtutong ka̱t. Mmawo na onəm oga nyar anung mi nda ta̱.&gt;&gt;<verse eid="RUT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 4:11" />Nkpaktak onəm va̱ ka̱ anung asa̱l ìtong ká̱ onəmgbak là pa̱, &lt;&lt;Mmayi na í yar anung ɓu kà̱ nnap va̱ ta̱. UYawe á nak uchar va̱ kà̱ mɓa ashe nzhi ɓu á yà wa aRahila ká̱ uLaitu, omà pa̱ oparəm me nzhi àIsa̱rila á. Re ú yà unəm uga ìdur ka̱ aEfraita, aɗin ɓu á dam ka̱ ashe aBet-Lehem. <verse eid="RUT 4:11" /><verse number="12" style="v" sid="RUT 4:12" />Re nzhi ɓu á yà wa nzhi aPerez, uva̱ uTamar mar ûYahuda, ka̱ atak apir va̱ uYawe i na ɓu ka̱ atak achar uɓwakan va̱ ta̱.&gt;&gt;<verse eid="RUT 4:12" /></para>
  <para style="s">UBowaz ká̱ akum ìjili wò</para>
  <para style="p">
    <verse number="13" style="v" sid="RUT 4:13" />Te uBowaz ka̱m uRut yà uchəchar. Nva̱ngva̱ uza̱ ga atak nra ka̱ na te, uYawe nak uza̱ yar anyám, kang à mar uyen ununggwan. <verse eid="RUT 4:13" /><verse number="14" style="v" sid="RUT 4:14" />Te ochar là ûNa'omi pa̱, &lt;&lt;Ashep á təm a ji aYawe, uva̱ re u lang unàl uga nka̱m akup uga ndatkulung ka̱t. Re aɗin áyen va̱ ta á dam ka̱ ashe aIsa̱rila. <verse eid="RUT 4:14" /><verse number="15" style="v" sid="RUT 4:15" />Uza̱ i yà uyen uga nna nra ìgwak á ɓu ka̱ ashe igbák ɓu, ka̱kul amar á kà ɓu va̱ ma̱n ɓu byet. Ka̱ atak ɓu te, uza̱ ji ovan onunggwan ji pa̱ ofangshat.&gt;&gt;<verse eid="RUT 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="RUT 4:16" />Te uNa'omi yar uyen va̱ ta fəkchi uza̱ yà unəm uga nkpán na. <verse eid="RUT 4:16" /><verse number="17" style="v" sid="RUT 4:17" />Ochar va̱ ka̱ yà nzəng ka̱ aNa'omi là pa̱, &lt;&lt;Mma mar ukà ununggwan ûNa'omi chit.&gt;&gt; Oza̱ sòk adin á na pa̱ uObet. Uwa upon aJese, upon aDawuda.<verse eid="RUT 4:17" /></para>
  <para style="s">Akum aDawuda</para>
  <para style="p">
    <verse number="18" style="v" sid="RUT 4:18" />Òma ta̱ akum aPerez,</para>
  <para style="li1" vid="RUT 4:18">UPerez mar uHezron,<verse eid="RUT 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="RUT 4:19" />uHezron mar uRam,</para>
  <para style="li1" vid="RUT 4:19">uRam mar uAminadap,<verse eid="RUT 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="RUT 4:20" />uAminadap mar uNashon,</para>
  <para style="li1" vid="RUT 4:20">uNashon mar uSalmon,<verse eid="RUT 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="RUT 4:21" />uSalmon mar uBowaz,</para>
  <para style="li1" vid="RUT 4:21">uBowaz mar uObet,<verse eid="RUT 4:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="RUT 4:22" />uObet mar uJesi,</para>
  <para style="li1" vid="RUT 4:22">kang uJesi mar uDawuda.<verse eid="RUT 4:22" /></para>
  <chapter eid="RUT 4" />
</usx>