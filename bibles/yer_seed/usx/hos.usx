<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Tarok</book>
  <para style="h">Nlir aHoziya</para>
  <para style="toc3">aHoz</para>
  <para style="toc2">aHoziya</para>
  <para style="toc1">Nlir aHoziya</para>
  <para style="mt2">Nlir</para>
  <para style="mt1">AHosheya</para>
  <para style="mt2">Unəm uga nlà ìchu Inan</para>
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="s">ALár áHosheya</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />Nnap nlà àYawe ɓa atak áHosheya uya àBeri ka̱ ashe nra iponzhi áUza̱ya, áYotam, áAzariya, áAhaz ká̱ ija áHizekiya, oponzhi oga aYahudi, kang ka̱ ashe nra iponzhi áYerobwam uponzhi oga aIsa̱rila, uya àYowash.<verse eid="HOS 1:1" /></para>
  <para style="s1">UChar àHosheya ká̱ ovan wò</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />Nva̱ uYawe là nnàp ûHosheya nggəshi te, uza̱ là á na pa̱, &lt;&lt;Ga ɓu ka̱m uchar uga nnəm mmai na u mar ovan ka̱ ashe mmai, ka̱kul mbin nəm mmai chit ka̱ atak ǹyang ká̱ uYawe.&gt;&gt; <verse eid="HOS 1:2" /><verse number="3" style="v" sid="HOS 1:3" />Te uza̱ ga ka̱m uGoma uya àDiblayim. UGoma yar anyám mar uyennunggwan á na.<verse eid="HOS 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4" />Te uYawe là á na pa̱, &lt;&lt;Wor aɗiɗin pa̱ &lt;UYizərel&gt; ka̱kul i gbà̱ng nva̱ng ka̱t te, mi tar nzhi àYehu ká̱ mpyát iya̱m iɓá̱ngɓa̱ng ka̱kul nchə̀r va uza̱ tar ka̱ aYizərel. Te mi nak iponzhi iga nzhi àIsa̱rila i kùr. <verse eid="HOS 1:4" /><verse number="5" style="v" sid="HOS 1:5" />Kà̱ ilum va̱ ta te, mi ɓəkchi ìjang oIsa̱rila kà̱ mba̱nda̱m aYizərel.&gt;&gt;<verse eid="HOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />Uza̱ yar anyám kà̱ɗi mar uyenchar. Te uYawe là ûHosheya pa̱, &lt;&lt;Wor aɗiɗin pa̱ &lt;UƊorka̱t,&gt; ka̱kul mi yà ká̱ aɗor ka̱ apal nzhi àIsa̱rila ka̱t. Mi yar mpat óza̱ ka̱t, nkpak pa̱ ń fa ká̱ oza̱ a ga izwal. <verse eid="HOS 1:6" /><verse number="7" style="v" sid="HOS 1:7" />Te mi yà ka̱ aɗor ka̱ apal nzhi àYahudi. Mi ka̱mshi óza̱ ka̱ atak áYawe Inan oza̱. Mi fa ká̱ oza̱ ka̱ atak ìjang ká̱ ndokchi ka̱t. Ka̱ atak ìkum ká̱ ipəri, ka̱t te onəm oga ipəri ka̱t.<verse eid="HOS 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />&lt;&lt;Nva̱ngva̱ uchar va̱ ta pətar uƊorka̱t kà̱ mbyal te, uza̱ yar anyám mar uyennunggwan. <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />Te uYawe là pa̱, wór aɗiɗin pa̱, &lt;ONəmmika̱t,&gt; ka̱kul pa̱ oIsa̱rila onəm mi ka̱t, kang mmami uYawe oza̱ ka̱t.&gt;&gt;<verse eid="HOS 1:9" /></para>
  <para style="s">NSar nnap-nlà Inan óvan oga aIsa̱rila</para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10" />Káp ká̱ nnà te, ìyə̀l oIsa̱rila i ga ǹyà wa ashishiri aga ìwá va mí məma ka̱t te mí kukung ka̱t. Kang ka̱ atak va̱ mmá là óza̱ pa̱, &lt;&lt;Mmawo onəm mi ka̱t,&gt;&gt; te mí là óza̱ pa̱, &lt;&lt;Ovan Inan iga irirì.&gt;&gt; <verse eid="HOS 1:10" /><verse number="11" style="v" sid="HOS 1:11" />Te onəm oYahudi ká̱ onəm oIsa̱rila oza̱ i gwang ka̱ anung azəngtəng. Oza̱ i kyer unəm uga mpyal íshi oza̱ pa̱ uzəng. Oza̱ i fa i re mbin va̱ ta kang i myak i ga mpyal kà̱ mbin oza̱. ILum aYizərel va̱ ta i yà ìchumchum.<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1" />Wor ogənnang wo onunggwan pa̱, &lt;&lt;Onəm mi.&gt;&gt; Kang ogənnang wo ovan ochar pa̱, &lt;&lt;UYaɗor.&gt;&gt;<verse eid="HOS 2:1" /></para>
  <para style="s">NNyám ntàn ká̱ nka̱mshi aIsa̱rila</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2" />O ra̱n ká̱ unang wo, o ra̱n ká̱ na</para>
  <para style="q2" vid="HOS 2:2">ka̱kul uza̱ uchar mi lap ka̱t,</para>
  <para style="q2" vid="HOS 2:2">kang mmami uɓəɓar lap ka̱t kpa.</para>
  <para style="q1" vid="HOS 2:2">Re uza̱ á tur ndər atak aga mmai ka̱ asa̱l awu wò,</para>
  <para style="q2" vid="HOS 2:2">kang ì kap ká̱ onəm oga nfəkchi mbibyal.<verse eid="HOS 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3" />A yà pa ka̱t te, mi zəp na mi re ugunggur</para>
  <para style="q2" vid="HOS 2:3">kang mi re na umaləng wa nva mmá mar na.</para>
  <para style="q1" vid="HOS 2:3">Mi nak na uza̱ i kú ká̱ ndəng ngbà̱l,</para>
  <para style="q2" vid="HOS 2:3">wa ánəm va ka̱ ashe anyin,</para>
  <para style="q2" vid="HOS 2:3">kang mi ga̱ɓa̱n na i yà wa ǹzam nkpələng.<verse eid="HOS 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4" />Mi nəm aɗor ovəvan ka̱t,</para>
  <para style="q2" vid="HOS 2:4">ka̱kul oza̱ ovan ova mmá mar ka̱ ashe mmai.<verse eid="HOS 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5" />Ka̱kul unang oza̱ nəm mmai chit.</para>
  <para style="q2" vid="HOS 2:5">Uza̱ va̱ yar anyám oza̱ te á yà ká̱ ìwuswa ka̱t.</para>
  <para style="q1" vid="HOS 2:5">Ka̱kul uza̱ là pa̱, &lt;&lt;Mi yar nva̱ng ama̱nma̱n mi ovəngva̱ kà̱</para>
  <para style="q2" vid="HOS 2:5">nná iya̱m-nrì á mi ká̱ ndəng, ká̱ awulu ká̱ ìlukwan alinin,</para>
  <para style="q2" vid="HOS 2:5">ká̱ mmì ká̱ iya̱m ngwà.&gt;&gt;<verse eid="HOS 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6" />Ka̱kul nva̱ ta te, mi ga nká asəsa̱l ká̱ izú, kang mi gún na ká̱ akamsəlang</para>
  <para style="q2" vid="HOS 2:6">uza̱ i ya asa̱l nfa ka̱t.<verse eid="HOS 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7" />Uza̱ i wà nva̱ng oma̱nma̱n wò,</para>
  <para style="q2" vid="HOS 2:7">kang uza̱ i kpán oza̱ ka̱t.</para>
  <para style="q1" vid="HOS 2:7">Uza̱ i mwo oza̱, uza̱ i ya oza̱ ka̱t. Te uza̱ i là pa̱,</para>
  <para style="q2" vid="HOS 2:7">&lt;&lt;Mi le atak á ɓar mi ugəshi</para>
  <para style="q2" vid="HOS 2:7">ka̱kul á kàpkàp ntəm mmatmat á mi,</para>
  <para style="q2" vid="HOS 2:7">ká̱ ǹyangmata̱.&gt;&gt;<verse eid="HOS 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8" />Te uza̱ nyi pa̱ mmami na kà̱ nná ìpirkur</para>
  <para style="q2" vid="HOS 2:8">ká̱ ndəng ìba̱ngba̱ng ǹsámsàm ká̱ mmì mpipye á na ka̱t.</para>
  <para style="q1" vid="HOS 2:8">Kang n tá aazurfa ká̱ azənariya á na</para>
  <para style="q2" vid="HOS 2:8">avəngva̱ oza̱ i nəm aBaal ká̱ ka̱t.<verse eid="HOS 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9" />Ka̱kul nva̱ ta te, mi le mi yar ìpirkur</para>
  <para style="q2" vid="HOS 2:9">ká̱ ndəng ìba̱ngba̱ng mi ka̱ awalangwalang.</para>
  <para style="q1" vid="HOS 2:9">Te mi yar awulu ká̱ ìlukwan alinin,</para>
  <para style="q2" vid="HOS 2:9">va̱ pa̱ ká̱ ń gún imaləng á na ká̱ a.<verse eid="HOS 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10" />Ǹyangmata̱ te, mi bol imaləngmaləng kà̱ ìwu oma̱nma̱nma̱nma̱n,</para>
  <para style="q2" vid="HOS 2:10">kang unəm uro yà i fa ká̱ na ka̱ awo mi ka̱t.<verse eid="HOS 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11" />Mi nak nkpaktak nnəm nchang izər áIsa̱rila i kùr,</para>
  <para style="q2" vid="HOS 2:11">nchang izəzər ngga nfa apye apipye, ká̱ ìlum njul,</para>
  <para style="q2" vid="HOS 2:11">ká̱ nkpaktak oga nra nnaknak.<verse eid="HOS 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12" />Mi lak ìba̱ngba̱ngba̱ngba̱ng ká̱ oga ikun ìpipyanpipyan</para>
  <para style="q2" vid="HOS 2:12">ivəngva uza̱ kà̱ nlà pa̱ oma ta amwa wò</para>
  <para style="q1" vid="HOS 2:12">va̱ oma̱nma̱n wò na wò.</para>
  <para style="q2" vid="HOS 2:12">Mi nak i təm ikun ikpá̱rkpà̱r,</para>
  <para style="q1" vid="HOS 2:12">izhé iga anyin i ri oza̱ pa̱ kpaktak.<verse eid="HOS 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13" />Mi pyát á na ka̱kul oga nra ngga nnəm mɓut ngga nnəm nchang izər ìchər aBaal va̱ ta.</para>
  <para style="q2" vid="HOS 2:13">Ka̱ ashe oga nra va̱ ta te, uza̱ i shì oza̱,</para>
  <para style="q1" vid="HOS 2:13">uza̱ i mwak iya̱m ìsham, uza̱ i fa i yar nva̱ng oma̱nma̱n wò ká̱.</para>
  <para style="q2" vid="HOS 2:13">Mmami te uza̱ ka̱ng ká̱ mi. UYawe à là.<verse eid="HOS 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14" />Ka̱kul nva̱ ta te, mi ga ntàng na mi ga ká̱ na ka̱ ashe ǹzam nkpələng.</para>
  <para style="q2" vid="HOS 2:14">Mi là nnàp á na ka̱ ashe nrwa ìgwak.<verse eid="HOS 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15" />Ka̱ cho te, mi le ká̱ ìram ìba̱ngba̱ngba̱ngba̱ng á na,</para>
  <para style="q2" vid="HOS 2:15">mi nak mba̱nda̱m ndaktak i sat anung asa̱l aga nnak ìgwak.</para>
  <para style="q1" vid="HOS 2:15">Ka̱ cho nà uza̱ i ná ishi wò á mi wa nva̱ uza̱ ka̱ nəm ka̱ ashe nza̱m wò,</para>
  <para style="q2" vid="HOS 2:15">nnà ka̱ ashe nra va̱ uza̱ fa ka̱ ashe mbin aMasar á.<verse eid="HOS 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16" />UYawe là pa̱, &lt;&lt;Ka̱ ashe nra va̱ ta te,</para>
  <para style="q2" vid="HOS 2:16">ɓu wór mi pa̱ &lt;Áɓar mi,&gt; ɓu yà ká̱ ngwór mi lap</para>
  <para style="q2" vid="HOS 2:16">pa̱, &lt;ÁBaal mi&gt; ka̱t.&gt;&gt;<verse eid="HOS 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17" />Mi zəp oga aɗin aBaal ka̱ anunung,</para>
  <para style="q2" vid="HOS 2:17">mí wór oza̱ ká̱ aɗin oza̱ lap ka̱t.<verse eid="HOS 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18" />Ka̱ ashe nra va̱ ta te, mi yar nsar nnap-nlà óza̱</para>
  <para style="q2" vid="HOS 2:18">ká̱ izhé iga anyin, ká̱ inyil,</para>
  <para style="q1" vid="HOS 2:18">ká̱ oga iya̱m iga nkpàng kà̱ mbin.</para>
  <para style="q2" vid="HOS 2:18">Kang mi chwan ìjang ká̱ ndokchi,</para>
  <para style="q1" vid="HOS 2:18">te ìkum i kùr kà̱ mbin,</para>
  <para style="q2" vid="HOS 2:18">te mi nak oza̱ i təm ká̱ ikángkáng.<verse eid="HOS 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19" />Mi ka̱m ɓu, ɓu yà uchar mi mbyet mbyet,</para>
  <para style="q2" vid="HOS 2:19">mi ka̱m ɓu, ɓu yà uchar mi ka̱ ashe inəna̱n ká̱ nnandər,</para>
  <para style="q2" vid="HOS 2:19">ka̱ ashe mma̱n ngga nnandər ká̱ aɗor.<verse eid="HOS 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20" />Mi ka̱m ɓu, ɓu yà uchar mi ka̱ ashe nnandər,</para>
  <para style="q2" vid="HOS 2:20">te ɓu nyi mi pa̱ uYawe.<verse eid="HOS 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21" />UYawe là pa̱, &lt;&lt;Ka̱ ashe nra va̱ ta te,</para>
  <para style="q2" vid="HOS 2:21">mi ma̱n ápal aɓuɓur i nak ìva̱r i pəng ka̱ apambin.<verse eid="HOS 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22" />Apal mbin i ná ìpirkur ká̱ ndəng ìba̱ngba̱ng,</para>
  <para style="q2" vid="HOS 2:22">ká̱ mmì, i yà kà̱ mbin aYizərel.<verse eid="HOS 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23" />Te mi suk na kà̱ mbin va̱ ta ka̱kul ishi mi,</para>
  <para style="q2" vid="HOS 2:23">kang mi yà ká̱ aɗor ka̱ apal &lt;AƊorka̱t.&gt;</para>
  <para style="q1" vid="HOS 2:23">Mi là ónəm va̱ ka̱ n wór pa̱, &lt;ONəmmika̱t&gt; pa̱, &lt;ONəmmi.&gt;</para>
  <para style="q2" vid="HOS 2:23">Te oza̱ i là pa̱, &lt;Mmaɓu Inan yi.&gt; &gt;&gt;<verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="s1">UHosheya le ká̱ uchar wò uga nnəm mmai.</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />UYawe là á mi pa̱, &lt;&lt;Ga kà̱ɗi nyám mma̱n uchar ɓu va̱ unəm uro ma̱n na chit, uchar uva̱ umaimai. Ma̱n na wa nva̱ uYawe ma̱n oga aIsa̱rila káp ká̱ nva̱ oza̱ le ga atak inan iro kang oza̱ ɗom nzənkəng awar ìba̱ngba̱ng nva̱ mmá ná ìchər chit a.&gt;&gt;<verse eid="HOS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2" />Te n yáp na ká̱ aazurfa pa̱ gba̱pchi ama̱n pa̱ tukun ká̱ ijiga pa̱ ìparəm iga ìbəshi. <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />Te n là á na pa̱, &lt;&lt;Nkpak ɓu təm ká̱ mi nra pa̱ makmak. Kang wa nəm mmai, ka̱t te wa ga atak ánəm uro lap ka̱t, te mi nəm a ɓu wa nnà ta kpa.&gt;&gt;<figure style="fig" alt="Barley" file="lb00102c.tif" size="chol" ref="3.2">Ìbəshi</figure><verse eid="HOS 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4" />Ka̱kul oIsa̱rila i təm nra pa̱ makmak i yà ká̱ uponzhi , ka̱t te unəm uchumchum ka̱t, i yà ká̱ nləfər iya̱m ipápà ka̱t te ìpang iyə́ryər ka̱t, i yà ká̱ ìlukwan ìkwoksok, ka̱t te ìchər iga ashe nzhi ka̱t. <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />Kà̱ nva̱ng nva̱ ta te, onəm oIsa̱rila i le i mwo uYawe Inan oza̱ ká̱ uDawuda uponzhi oza̱. Oza̱ i ɓa ká̱ ntán izər ka̱ atak áYawe ka̱ ashe oga nra ngga nkùr anung ka̱kul nnap nnəna̱nnəna̱n.<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="s1">UYawe ya oIsa̱rila ká̱ mpat</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1" />O fe nnap-nlà àYawe, ónəm oga aIsa̱rila,</para>
  <para style="q2" vid="HOS 4:1">ka̱kul uYawe uwa yà ká̱ nnap-nlà ka̱ apal onəm oga mbin va̱ ta̱.</para>
  <para style="q1" vid="HOS 4:1">Ka̱kul nnandər, ká̱ mma̱n ngga nnandər yà ka̱t,</para>
  <para style="q2" vid="HOS 4:1">kang ǹnyi Inan á yà kà̱ mbin ta̱ ka̱t.<verse eid="HOS 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2" />Nsóng anung, akwam, ngba̱l unəm,</para>
  <para style="q2" vid="HOS 4:2">ayi ká̱ mmai gang atak,</para>
  <para style="q2" vid="HOS 4:2">kang ntar nchə̀r ka̱ anung ka̱ anung.<verse eid="HOS 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3" />Ka̱kul nva̱ ta te mbin vyap,</para>
  <para style="q2" vid="HOS 4:3">nkpaktak onəm va̱ ka̱ ashishe i kwarman.</para>
  <para style="q1" vid="HOS 4:3">Izhé iga anyin ká̱ oga inyil iga apaɓur,</para>
  <para style="q2" vid="HOS 4:3">ká̱ oga igwali ka̱ ashe ìwá i kú.<verse eid="HOS 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4" />Káp ká̱ nnà te, kang unəm uro á ná mpat ûwanwò ka̱t,</para>
  <para style="q2" vid="HOS 4:4">kang uza̱ a pyen ka̱t.</para>
  <para style="q1" vid="HOS 4:4">Ka̱kul nnap-nlà va̱ ta̱ ka̱ apal ɓu,</para>
  <para style="q2" vid="HOS 4:4">ánəm uga mpyal awop.<verse eid="HOS 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5" />Ó lə̀p ìfang ìzwam ká̱ alum,</para>
  <para style="q2" vid="HOS 4:5">unəm uga nlà ìchu Inan i lə̀p ìfang kpa nzəng ká̱ wo.</para>
  <para style="q1" vid="HOS 4:5">Kang mi zhì unang wo.<verse eid="HOS 4:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 4:6" />Onəm mi zhì chit ka̱ atak nlàng ǹnyi.</para>
  <para style="q1" vid="HOS 4:6">Ka̱kul pa̱ o yang ká̱ ǹnyi,</para>
  <para style="q2" vid="HOS 4:6">te n yang ká̱ wo kà̱ ǹyà onəm oga mpyal awop mi.</para>
  <para style="q1" vid="HOS 4:6">Ka̱kul o kong ká̱ nnap mpakpak Inan wo chit,</para>
  <para style="q2" vid="HOS 4:6">te mi kong ká̱ ovan wo kpa.<verse eid="HOS 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7" />Wa nva̱ onəm oga mpyal awop kà̱ ǹyə́l te,</para>
  <para style="q2" vid="HOS 4:7">wa nnà ta nnap mɓá̱ngɓa̱ng kà̱ ngga mpyal.</para>
  <para style="q2" vid="HOS 4:7">Mi ga̱ɓa̱n ìzhàn oza̱ i təm iya̱m ìwuswa.<verse eid="HOS 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8" />Oza̱ kà̱ nrì ká̱ ishi oza̱ ka̱ atak</para>
  <para style="q2" vid="HOS 4:8">nnap mɓá̱ngɓa̱ng onəm mi,</para>
  <para style="q1" vid="HOS 4:8">kang oza̱ i ná nkam irəng óza̱ pa̱</para>
  <para style="q2" vid="HOS 4:8">a ga mpyal ká̱ nnəm mpat.<verse eid="HOS 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9" />Wa nva onəm kà̱ nnəm te, wa nnà ta kpa onəm oga mpyal awop,</para>
  <para style="q2" vid="HOS 4:9">mi ga nnyám ntàn oza̱, kang mi pyát nnap nnəm óza̱.<verse eid="HOS 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10" />Oza̱ i ri iya̱m-nrì, ká̱ nnà te afu i yə́l oza̱ ka̱t.</para>
  <para style="q2" vid="HOS 4:10">Oza̱ nəm mmai, ká̱ nnà te oza̱ myak ka̱t.</para>
  <para style="q2" vid="HOS 4:10">Oza̱ kap ká̱ uYawe<verse eid="HOS 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 4:11" />ka̱kul ngwop ichər.</para>
  <para style="q1" vid="HOS 4:11">Ncè ká̱ ndəng ìba̱ngba̱ng ǹsámsàm,</para>
  <para style="q2" vid="HOS 4:11">yar nnap nnəm oza̱.<verse eid="HOS 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12" />Onəm mí ram ichən ka̱ atak ìchər ìva̱ mmá nəm ká̱ akún,</para>
  <para style="q2" vid="HOS 4:12">kang idari iva̱k oza̱ i là iya̱m iva̱ óza̱ kà̱ ngga nfa.</para>
  <para style="q1" vid="HOS 4:12">ARuhu aga mmai á nak oza̱ kà̱ nlar,</para>
  <para style="q2" vid="HOS 4:12">oza̱ kap ká̱ Inan oza̱ chit ka̱kul mmai.<verse eid="HOS 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13" />Oza̱ i ná nləfər ka̱ apal ìtə́ngtə́ng aɓam,</para>
  <para style="q2" vid="HOS 4:13">kang oza̱ i dung nggù ka̱ apal aɗuktum,</para>
  <para style="q1" vid="HOS 4:13">ká̱ akum ìkun ichir, ká̱ agwakchi, ká̱ iswáng va̱ ayì oza̱ chəchàng.</para>
  <para style="q2" vid="HOS 4:13">Ka̱kul nva̱ ta te, ovan wo ochar kà̱ nnəm mmai, kang oka wo i ram onunggwan.<verse eid="HOS 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14" />Mi yà ká̱ nnyám ntàn ovan ochar wo,</para>
  <para style="q2" vid="HOS 4:14">nva̱ oza̱ nəm mmai ka̱t,</para>
  <para style="q2" vid="HOS 4:14">ka̱t te oka wo nva̱ oza̱ i ram onunggwan ka̱t.</para>
  <para style="q1" vid="HOS 4:14">Ka̱kul onunggwan ká̱ ishi oza̱ táng mmai,</para>
  <para style="q2" vid="HOS 4:14">kang i ná nləfər nzəng ká̱ ochar oga nnəm mmai kà̱ nzhi ìchər.</para>
  <para style="q1" vid="HOS 4:14">Onəm oga nlàng nkpán ìpir nnàp , i zhì.<verse eid="HOS 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15" />áIsa̱rila, káp ká̱ mmai ɓu,</para>
  <para style="q2" vid="HOS 4:15">kang wa nak uYahudi a pat ka̱t.</para>
  <para style="q1" vid="HOS 4:15">Kang o ga aGilgal, ka̱t te aBet-avən ka̱t.</para>
  <para style="q2" vid="HOS 4:15">Kang o sóng anung ká̱ uYawe uga irirì ka̱t.<verse eid="HOS 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16" />Ka̱kul oIsa̱rila kák ishi wa nkak ishi ìya ìna,</para>
  <para style="q2" vid="HOS 4:16">Te ǹyangmata̱, uYawe i kpak oza̱ kpak</para>
  <para style="q2" vid="HOS 4:16">wa ivan itam ka̱ atak nrì nnəna̱n ɗò?<verse eid="HOS 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17" />UEfərayim gwang ishi ká̱ ìchər,</para>
  <para style="q2" vid="HOS 4:17">re na pa.<verse eid="HOS 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18" />Nva̱ngva̱ oza̱ i gba̱l ká̱ ngwa iya̱m iwawa te,</para>
  <para style="q2" vid="HOS 4:18">oza̱ i ga mpyal ká̱ nnəm mmai.</para>
  <para style="q2" vid="HOS 4:18">Oza̱ ma̱n nnap nnəm ngga ìwuswa na ji.<verse eid="HOS 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19" />Ǹyə̀r i wur oza̱ ka̱ ashe abasəm wò,</para>
  <para style="q2" vid="HOS 4:19">te oza̱ i yar ìwuswa ka̱ atak nná nləfər iya̱m ipápà oza̱.<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="s1">AKwali ka̱ apal oIsa̱rila.</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1" />O fe nva̱ ta̱ ónəm oga mpyal awop,</para>
  <para style="q2" vid="HOS 5:1">o gwong achwang á nzhi àIsa̱rila, ká̱ nzhi iponzhi .</para>
  <para style="q1" vid="HOS 5:1">Akwali nna yà ka̱ apal wo,</para>
  <para style="q2" vid="HOS 5:1">ka̱kul o təm ajəp chit ka̱ aMizpa,</para>
  <para style="q2" vid="HOS 5:1">o tong wa ìcha ìva mmá rwak ka̱ apal aɓam aTabor.<verse eid="HOS 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2" />O fa iya̱mkak , kang o gbà̱ng chit ka̱ ashe ngbá̱ng onəm,</para>
  <para style="q2" vid="HOS 5:2">mi ga nnyám ntàn nkpaktak wo.<verse eid="HOS 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3" />N nyi uEfərayim nyi, kang uIsa̱rila bwam á mi ka̱t,</para>
  <para style="q2" vid="HOS 5:3">ǹyangmata̱, aEfrayim, u mai byet,</para>
  <para style="q2" vid="HOS 5:3">uIsa̱rila vyap chit.<verse eid="HOS 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4" />Nnap nnəm oza̱ re oza̱ pa̱ oza̱ a le atak Inan oza̱ ka̱t,</para>
  <para style="q2" vid="HOS 5:4">ka̱kul aruhu mmai nna yà ka̱ ashe oza̱,</para>
  <para style="q2" vid="HOS 5:4">oza̱ nyi uYawe oza̱ ka̱t.<verse eid="HOS 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5" />Ǹrup ká̱ ishi oIsa̱rila kà̱ nnyám nnàp ka̱ apal ishi oza̱,</para>
  <para style="q2" vid="HOS 5:5">uIsa̱rila ká̱ uEfərayim lə̀p ìfang ka̱kul mpat oza̱,</para>
  <para style="q2" vid="HOS 5:5">kang uYahudi kpa, i ru nzəng ká̱ oza̱.<verse eid="HOS 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6" />Oza̱ i ga ká̱ iya̱m nkang ká̱ ina na ó mwo uYawe,</para>
  <para style="q2" vid="HOS 5:6">ká̱ nnà te, oza̱ i ya na ka̱t.</para>
  <para style="q2" vid="HOS 5:6">Ka̱kul uza̱ kap ká̱ oza̱ chit.<verse eid="HOS 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7" />Oza̱ nəm nnandər ûYawe ka̱t,</para>
  <para style="q2" vid="HOS 5:7">oza̱ mar ovan mmai.</para>
  <para style="q1" vid="HOS 5:7">Ǹyangmata̱, ngwop apye apipye oza̱, i zhì oza̱ ká̱ ìram oza̱.<verse eid="HOS 5:7" /></para>
  <para style="s">IKùm kà̱ ishimshe oIsa̱rila ká̱ oYahudi</para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8" />O ɓur agbəshi ka̱ ashe aGibiyà, o ɓur nggapak ka̱ ashe aRama,</para>
  <para style="q2" vid="HOS 5:8">o wór awór ìkum ka̱ ashe aBet Ava̱n</para>
  <para style="q2" vid="HOS 5:8">ləp mpyal aBenjamin.<verse eid="HOS 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9" />UEfərayim i təm agún kà̱ ìlum ìga nnyám ntàn.</para>
  <para style="q2" vid="HOS 5:9">N shet ká̱ iya̱m va̱ inandər ka̱ ashe akum ìjili àIsa̱rila.<verse eid="HOS 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10" />Onəm oga mpyal oYahudi təm wa onəm oga ǹsəng aswari mbin.</para>
  <para style="q2" vid="HOS 5:10">Mi zuk mmən ìkum mi ka̱ apal oza̱ wa ndəng nnángnáng.<verse eid="HOS 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11" />Mmá kà̱r uEfərayim, akwali dungshi na chit.</para>
  <para style="q2" vid="HOS 5:11">Ka̱kul uza̱ nak ìgwak kəkam kà̱ ngwop ìchər.<verse eid="HOS 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12" />Ka̱kul nva̱ ta te, n təm wa ìgəmək ûEfərayim,</para>
  <para style="q2" vid="HOS 5:12">wa iya̱m imwanmwan n̂zhi aYahudi.<verse eid="HOS 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13" />Kà̱ nva̱ngva̱ uEfərayim ya arwa wò,</para>
  <para style="q2" vid="HOS 5:13">kang uYahudi ya aɓang wò te,</para>
  <para style="q1" vid="HOS 5:13">uEfərayim ga aAshur kang a re ǹre ka̱ atak aponzhi uchumchum oga aAshur,</para>
  <para style="q2" vid="HOS 5:13">ká̱ nnà te, uza̱ i yà ká̱ mbyáp kang i tàn aɓəɓang ka̱t.<verse eid="HOS 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14" />Ka̱kul mmami wa ìlir ka̱ atak aEfrayim,</para>
  <para style="q2" vid="HOS 5:14">kang wa ìyen nza̱m ìlir kà̱ nzhi àYahudi.</para>
  <para style="q1" vid="HOS 5:14">Mmami na ká̱ ishi mi, mi kan oza̱ te mi ga,</para>
  <para style="q2" vid="HOS 5:14">Mi yar oza̱ mi fa ká̱, unəm uro yà i vyat oza̱ ka̱t.<verse eid="HOS 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15" />Mi le mi ga atak mi,</para>
  <para style="q2" vid="HOS 5:15">ya oza̱ i ma̱n ká̱ mpat oza̱ kang.</para>
  <para style="q1" vid="HOS 5:15">Te oza̱ i ram mi ka̱ ashe mɓək anung,</para>
  <para style="q2" vid="HOS 5:15">oza̱ i mwo mi ká̱ mɓa̱ng ìwu.<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s">IYa̱m va̱ onəm là</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1" />&lt;&lt;Ɓa, re í le atak áYawe,</para>
  <para style="q1" vid="HOS 6:1">ka̱kul uza̱ kan yi pa̱ nyimənnyimən,</para>
  <para style="q2" vid="HOS 6:1">kang uwa i tàn yi.</para>
  <para style="q1" vid="HOS 6:1">Uwa nak aɓang á yi,</para>
  <para style="q2" vid="HOS 6:1">kang uwa i sar á yi.<verse eid="HOS 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2" />Kà̱ nva̱ng nra pa̱ mparəm te, uza̱ i fələk yi</para>
  <para style="q2" vid="HOS 6:2">ka̱ apal nra ngga nshatɗing te, uza̱ i wong ká̱ yi,</para>
  <para style="q2" vid="HOS 6:2">kang í təm kà̱ mpipyal.<verse eid="HOS 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3" />Re í zhat na í nyi uYawe,</para>
  <para style="q2" vid="HOS 6:3">ka̱kul mɓəɓa nnandər wa ntàn atak.</para>
  <para style="q1" vid="HOS 6:3">Uza̱ i ɓa atak yi wa ìva̱r,</para>
  <para style="q2" vid="HOS 6:3">wa ìva̱r ìga amə́ng va i shim mbin.&gt;&gt;<verse eid="HOS 6:3" /></para>
  <para style="s">IYa̱m va̱ Inan là</para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4" />Iza̱ mi nəm ká̱ ɓu yà aEfrayim?</para>
  <para style="q2" vid="HOS 6:4">Iza̱ mi nəm ká̱ ɓu yà áYahudi?</para>
  <para style="q1" vid="HOS 6:4">Mma̱n nva̱ o ma̱n mi te, wa ìnanəng,</para>
  <para style="q2" vid="HOS 6:4">ká̱ ìmimyang ìva i lyangshin pa̱ kəlak.<verse eid="HOS 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5" />Ka̱kul nva̱ ta te, mi kan wo ka̱ atak onəm oga nlà ìchu Inan,</para>
  <para style="q2" vid="HOS 6:5">te mi gbá̱ng wo ka̱ atak nnap-nlà ngga anung mi,</para>
  <para style="q2" vid="HOS 6:5">kang akwali wo i watar pa̱ vələm wa aməlam.<verse eid="HOS 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6" />Ka̱kul n ɗom mma̱n, nná nləfər iya̱m ipápà ka̱t,</para>
  <para style="q2" vid="HOS 6:6">kang ǹnyi Inan ji iya̱m inana iga nshì ji.<verse eid="HOS 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7" />Oza̱ ɓəkchi nsar nnap-nlà wa aAdamu,</para>
  <para style="q2" vid="HOS 6:7">kang oza̱ nəm nnandər á mi ka̱t.<verse eid="HOS 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8" />AGileyat ìtong onəm onga,</para>
  <para style="q2" vid="HOS 6:8">awuwo ká̱ nchə̀r onəm va uza̱ gbá̱ng.<verse eid="HOS 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9" />Wa nva onəm oga ayi ra anyimnyal onəm te,</para>
  <para style="q2" vid="HOS 6:9">wa nnà ta idonka̱ng onəm oga mpyal awop.</para>
  <para style="q1" vid="HOS 6:9">Oza̱ gbá̱ng onəm ka̱ asa̱l aShekem,</para>
  <para style="q2" vid="HOS 6:9">oza̱ i nəm inga iva ɓyen nlà ka̱t.<verse eid="HOS 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10" />N ya iya̱m iga nnəm ajan</para>
  <para style="q2" vid="HOS 6:10">ka̱ ashe nzhi àIsa̱rila.</para>
  <para style="q1" vid="HOS 6:10">UEfərayim ná ishi wò kà̱ ngwop ìchər,</para>
  <para style="q2" vid="HOS 6:10">uIsa̱rila vyap ishi wò chit.<verse eid="HOS 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11" />Mmawo kpa áYahudi, n nak ìlum mɓən iya̱m chit ka̱kul ɓu,</para>
  <para style="q2" vid="HOS 6:11">nva̱ngva̱ mi le ká̱ onəm mi ka̱ atak izwal.<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 7:1" />Awalang va kpaktak mmá ɗom ntàn arwa áIsa̱rila te,</para>
  <para style="q2" vid="HOS 7:1">mpat aEfrayim ká̱ nnap mɓá̱ngɓa̱ng oga aSamariya i pwa,</para>
  <para style="q1" vid="HOS 7:1">Ka̱kul nnandər oza̱ yə́l awo ka̱t,</para>
  <para style="q2" vid="HOS 7:1">unəm uga ayi i chwan atak,</para>
  <para style="q2" vid="HOS 7:1">kang onəm oga nra anyimnyal i vyat onəm ka̱ asa̱l.<verse eid="HOS 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2" />Ká̱ nnà te, oza̱ nak ishi ká̱ pa̱,</para>
  <para style="q2" vid="HOS 7:2">mi rəng nkpaktak nnap mɓá̱ngɓa̱ng oza̱ rəng ka̱t.</para>
  <para style="q1" vid="HOS 7:2">Ǹyangmata̱ te, nnap nnəm oza̱ gáng oza̱</para>
  <para style="q2" vid="HOS 7:2">mmami kà̱ ǹyəya.<verse eid="HOS 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3" />Oza̱ i nak ìgwak i chàng uponzhi ká̱ nnap mɓá̱ngɓa̱ng oza̱,</para>
  <para style="q2" vid="HOS 7:3">kang onəm oga mpyal ká̱ akwam oza̱.<verse eid="HOS 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4" />Nkpaktak oza̱ onəm oga nnəm mmai,</para>
  <para style="q2" vid="HOS 7:4">Nɗom mmai oza̱ wa ìgəng iga ngwàng iya̱m ìva á sur pa̱ gənggəng,</para>
  <para style="q1" vid="HOS 7:4">ìva onəm oga ngwàng iya̱m re nɗa̱mshi apəpər,</para>
  <para style="q2" vid="HOS 7:4">kà̱ mɓan nkal mma̱k á ga chu nfifyil.<verse eid="HOS 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5" />Kà̱ ìlum àponzhi te,</para>
  <para style="q2" vid="HOS 7:5">ncè gbá̱ng onəm oga mpyal,</para>
  <para style="q2" vid="HOS 7:5">uza̱ gwang awo ká̱ onəm lákchilàkchi.<verse eid="HOS 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6" />Ka̱kul ìgwak oza̱ sur wa ìgəng ìga ngwàng iya̱m,</para>
  <para style="q2" vid="HOS 7:6">oza̱ i ra anyimnyal ka̱ ashe ìgwak.</para>
  <para style="q1" vid="HOS 7:6">Nlak ìgwak oza̱ i ri pa̱ shìriri nkpaktak ìzwam,</para>
  <para style="q2" vid="HOS 7:6">ká̱ anung ìpin te, i ri wa aməlam apər.<verse eid="HOS 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7" />Nkpaktak oza̱ sur wa ìgəng ìga ngwàng iya̱m,</para>
  <para style="q2" vid="HOS 7:7">Oza̱ i zhì onəm ochumchum oza̱.</para>
  <para style="q1" vid="HOS 7:7">Nkpaktak oponzhi oza̱ tàk chit,</para>
  <para style="q2" vid="HOS 7:7">unəm uro yə́ng á mi ka̱t.<verse eid="HOS 7:7" /></para>
  <para style="s">AIsa̱rila gwang ishi ká̱ oɗyanəm</para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8" />UEfərayim gwang ishi wò ká̱ onəm,</para>
  <para style="q2" vid="HOS 7:8">uza̱ yà chit wa nzənkəng nva mmá ga̱ɓa̱n ka̱t.<verse eid="HOS 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9" />Oɗyanəm ri nkəkam chit uza̱ nyi ka̱t,</para>
  <para style="q2" vid="HOS 7:9">kang izwál fa á na kpa uza̱ nyi ka̱t.<verse eid="HOS 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10" />Ǹrup ká̱ ishi oIsa̱rila nyám nnàp ka̱ apal ishi oza̱,</para>
  <para style="q2" vid="HOS 7:10">káp ká̱ nnà te oza̱ yang ká̱ nle atak áYawe, Inan oza̱,</para>
  <para style="q2" vid="HOS 7:10">kang ka̱ ashe nkpaktak iya̱m va̱ ta̱ te, oza̱ mwo na ka̱t kpa.<verse eid="HOS 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11" />Te uEfərayim wa ìləkpar ìpərəkpərək, i rəng nnap ka̱t,</para>
  <para style="q2" vid="HOS 7:11">oza̱ wór aMasar, kang oza̱ ga aAshur.<verse eid="HOS 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12" />Nva̱ oza̱ i yà kà̱ ngga te, mi màng ìcha mi ka̱ apal oza̱,</para>
  <para style="q2" vid="HOS 7:12">mi dapchi oza̱ i vàng wa ìnyil ìga apaɓur,</para>
  <para style="q2" vid="HOS 7:12">Mi nyám ntàn oza̱ ka̱kul iya̱m iɓá̱ngɓa̱ng iva̱ oza̱ nəm.<verse eid="HOS 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13" />Álak ká̱ oza̱ chit, ka̱kul oza̱ chəng atak mi,</para>
  <para style="q2" vid="HOS 7:13">nzhì nà nji oza̱ ka̱kul oza̱ fa iya̱mkak ká̱ mi.</para>
  <para style="q1" vid="HOS 7:13">N ɗom pa̱ ń fa ká̱ oza̱, ká̱ nnà te oza̱ náp akwam ka̱ apal mi.<verse eid="HOS 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14" />Oza̱ yə́ng á mi ká̱ ìgwak pa̱ ìzəng ka̱t,</para>
  <para style="q2" vid="HOS 7:14">nva̱ oza̱ i yə́ng ka̱ apal alyer oza̱ á.</para>
  <para style="q1" vid="HOS 7:14">Oza̱ i chal ìchər oza̱, ka̱kul ìpirkur ká̱ ndəng ìba̱ngba̱ng ǹsámsàm ,</para>
  <para style="q2" vid="HOS 7:14">oza̱ ɓut ishi oza̱ le re atak mi.<verse eid="HOS 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15" />Mmami nà n ɗyang iya̱m óza̱ kang n kam ìgwal óza̱,</para>
  <para style="q2" vid="HOS 7:15">ká̱ nnà te, oza̱ ran iya̱m iɓá̱ngɓa̱ng ka̱ apal ishi mi.<verse eid="HOS 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16" />Oza̱ ga̱ɓa̱n asəm á mi,</para>
  <para style="q2" vid="HOS 7:16">oza̱ yà chit wa ìjang ìga nlàm atak.</para>
  <para style="q1" vid="HOS 7:16">Onəm oga mpyal oza̱ i tàk ka̱ atak ndokchi,</para>
  <para style="q2" vid="HOS 7:16">ka̱kul nvyap ngga aɓələm oza̱.</para>
  <para style="q1" vid="HOS 7:16">Oza̱ i təm iya̱m iga nnáp avyal,</para>
  <para style="q2" vid="HOS 7:16">kà̱ mbin aMasar.<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s1">MMa ra̱n ká̱ oIsa̱rila ka̱kul iya̱m ngwop</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1" />Ɓur agbəshi na u won onəm ká̱,</para>
  <para style="q2" vid="HOS 8:1">okpa ìkum kà̱ nvàng ka̱ apal nzhi àYawe wa nkumà ngga̱p .</para>
  <para style="q1" vid="HOS 8:1">Ka̱kul oza̱ fən nsar nnap nla mi,</para>
  <para style="q2" vid="HOS 8:1">kang oza̱ fa iya̱mkak ká̱ nnap mpakpak mi.<verse eid="HOS 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2" />AIsa̱rila yə́ng á mi pa̱,</para>
  <para style="q2" vid="HOS 8:2">&lt;&lt;Á Inan, í nyi ɓu nyi.&gt;&gt;<verse eid="HOS 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3" />uIsa̱rila yang ká̱ iya̱m inəna̱n á nak te,</para>
  <para style="q2" vid="HOS 8:3">ukpa ìkum i ɓàk na.<verse eid="HOS 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4" />Oza̱ kyep oponzhi nzəng ká̱ nram ichən ka̱ atak mi ka̱t,</para>
  <para style="q2" vid="HOS 8:4">oza̱ kyep onəm oga mpyal ká̱ ǹnyi mi ka̱t.</para>
  <para style="q1" vid="HOS 8:4">Oza̱ la ìchər ká̱ aazurfa ká̱ azənariya,</para>
  <para style="q2" vid="HOS 8:4">ka̱kul nva̱ ta te oza̱ i ga nzhì.<verse eid="HOS 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5" />Ónəm oga aSamariya, n yang ká̱ ìya ìna wo chit.</para>
  <para style="q2" vid="HOS 8:5">Mmami ká̱ nlak ìgwak pa̱ makmak ka̱ apal wo.</para>
  <para style="q2" vid="HOS 8:5">Te azəmwo ó yà ká̱ mpat ka̱t yà?<verse eid="HOS 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 8:6" />Ka̱kul ìchər va̱ ta̱ fa ka̱ atak áIsa̱rila,</para>
  <para style="q2" vid="HOS 8:6">unəm uga inok awo à nəm, Inan ka̱t.</para>
  <para style="q1" vid="HOS 8:6">Iya ìna oga aSamariya va̱ ta,</para>
  <para style="q2" vid="HOS 8:6">mí chwan pa̱ nyimənnyimən.<verse eid="HOS 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7" />Ka̱kul oza̱ suk ayə́r,</para>
  <para style="q2" vid="HOS 8:7">kang oza̱ i ɓən ǹvivyil.</para>
  <para style="q1" vid="HOS 8:7">Azang ikur mar ishi ka̱t,</para>
  <para style="q2" vid="HOS 8:7">ivəngva̱ fa ká̱ ishi te, nəm apir ka̱t,</para>
  <para style="q2" vid="HOS 8:7">kang oza̱ a məmar te, oɗyanəm i ri.<verse eid="HOS 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8" />Mma ma̱ka̱n uIsa̱rila chit,</para>
  <para style="q2" vid="HOS 8:8">ǹyangmata̱ oza̱ kà̱ ishimshe oga mbin</para>
  <para style="q2" vid="HOS 8:8">wa iya̱m mme iswangswang,<verse eid="HOS 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9" />ka̱kul oza̱ ɓa ga aAshur chit,</para>
  <para style="q2" vid="HOS 8:9">wa ìɗongya ìva ká̱ nkùkwa,</para>
  <para style="q2" vid="HOS 8:9">uEfərayim ná ishi wò oga mbin ka̱kul nram nka̱mshi.<verse eid="HOS 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10" />Káp ka̱ nva̱ oza̱ yáp ká̱ ishi oza̱ ka̱ ashe oga mbin te,</para>
  <para style="q2" vid="HOS 8:10">ǹyangmata̱ mi ga mɓut oza̱ ka̱kul akwali.</para>
  <para style="q1" vid="HOS 8:10">Mɓək anung oza̱ i yen ká̱ ìyə̀l oza̱</para>
  <para style="q2" vid="HOS 8:10">ka̱ avəng áponzhi uchumchum uga aAshur.<verse eid="HOS 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11" />Nva̱ uEfərayim nak atak nshì iya̱m awop yə́l te,</para>
  <para style="q2" vid="HOS 8:11">oga atak va̱ ta ga̱ɓa̱n yà atak nnəm nnap mɓá̱ngɓa̱ng.<verse eid="HOS 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12" />N lir nnap mpakpak mi óza̱ pa̱ nkyak,</para>
  <para style="q2" vid="HOS 8:12">te oza̱ yar pa̱ nnap nro nggafak.<verse eid="HOS 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13" />Oza̱ ná nləfər iya̱m ipápà á mi ka̱kul nrì izhìzhe,</para>
  <para style="q2" vid="HOS 8:13">uYawe fe nchang oza̱ ka̱t.</para>
  <para style="q1" vid="HOS 8:13">Ǹyangmata̱ uza̱ i rəng nnap mɓá̱ngɓa̱ng oza̱,</para>
  <para style="q2" vid="HOS 8:13">kang i nyám ntàn óza̱ ka̱kukul,</para>
  <para style="q2" vid="HOS 8:13">oza̱ i le aMasar.<verse eid="HOS 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14" />uIsa̱rila ka̱ng ká̱ unəm uga nnəm wò chit,</para>
  <para style="q2" vid="HOS 8:14">kang à me oga n̂zhi nchumchum.</para>
  <para style="q1" vid="HOS 8:14">UYahudi te, á me ìtong iga akamsəlang yə́l.</para>
  <para style="q2" vid="HOS 8:14">Te mi re ǹre ká̱ apər ka̱ apal ìtong oza̱,</para>
  <para style="q2" vid="HOS 8:14">i zhì oga akamsəlang oza̱ kpa.<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s1">MPyát nva mí nəm oIsa̱rila ka̱kul nnandər oza̱ yə́l awo ka̱t</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1" />óIsa̱rila, kang o lan wa nva̱ mbín nro i lan ka̱t,</para>
  <para style="q2" vid="HOS 9:1">ka̱kul o nəm mmai chit o kap ká̱ Inan wo.</para>
  <para style="q2" vid="HOS 9:1">O ma̱n nnap amwa achar umaimai kà̱ nza̱ atak mpək ìpirkur nggo.<verse eid="HOS 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2" />Atak mpək ìpirkur ká̱ atak nkáng ndəng ìba̱ngba̱ng ǹsámsàm i ri ká̱ oza̱ ka̱t,</para>
  <para style="q2" vid="HOS 9:2">kang ndəng ìba̱ngba̱ng ncángchàng i yen oza̱.<verse eid="HOS 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3" />Oza̱ i təm kà̱ mbin àYawe ka̱t.</para>
  <para style="q2" vid="HOS 9:3">Ka̱ɗor nva̱ ta te, uEfərayim i le aMasar,</para>
  <para style="q2" vid="HOS 9:3">kang oza̱ i ri iya̱m-nrì ivyapvyap ka̱ aAshur.<verse eid="HOS 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4" />Oza̱ i ná imwa ndəng ìba̱ngba̱ng ǹsámsàm ûYawe ka̱t,</para>
  <para style="q2" vid="HOS 9:4">kang nləfər iya̱m ipápà oza̱ i ná nchang ìgwak á na ka̱t.</para>
  <para style="q1" vid="HOS 9:4">Nləfər oza̱ i yà wa nzənkəng onəm oga ǹyə́ng ikú,</para>
  <para style="q2" vid="HOS 9:4">nkpaktak onəm va̱ i ri te, i nak oza̱ i vyap.</para>
  <para style="q1" vid="HOS 9:4">Nzənkəng oza̱ i yà ka̱kul ayang afu oza̱,</para>
  <para style="q2" vid="HOS 9:4">i tar ashe nzhi àYawe ka̱t.<verse eid="HOS 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5" />Iza̱ o nəm kà̱ ìlum ìnaknak ìga nnəm nchang izər,</para>
  <para style="q2" vid="HOS 9:5">kà̱ ìlum ìga nri ká̱ ngwa àYawe yà?<verse eid="HOS 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6" />Kang a yà pa̱ oza̱ a chəng ka̱ atak nzhì te,</para>
  <para style="q2" vid="HOS 9:6">aMasar i ɓut oza̱, kang aMop<note caller="+" style="f"><char style="fr" closed="false">9.6 </char><char style="ft" closed="false">ìtong va̱ ka̱ atak nli awap achumchum.</char></note> i li oza̱.</para>
  <para style="q1" vid="HOS 9:6">Mí wur iya̱m akúp ká̱ aazurfa oza̱,</para>
  <para style="q2" vid="HOS 9:6">izú i fa ka̱ ashe aghal oza̱.<verse eid="HOS 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7" />Ìlum iga nnyám ntàn ɓa chit,</para>
  <para style="q2" vid="HOS 9:7">ìlum ìga mmumwa ɓa chit. Re oIsa̱rila a nyi.</para>
  <para style="q1" vid="HOS 9:7">O là pa̱, &lt;&lt;Unəm uga nlà ìchu Inan mpərək,</para>
  <para style="q2" vid="HOS 9:7">kang unəm uga aruhu á swa nggatswa nggat,&gt;&gt;</para>
  <para style="q2" vid="HOS 9:7">ka̱kul mmák mpat ká̱ ǹyang nva̱ o yang mi.<verse eid="HOS 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8" />Unəm uga nlà ìchu Inan ka̱ atak nka̱mshi Inan,</para>
  <para style="q2" vid="HOS 9:8">uwa unəm uga mpángchí uEfərayim,</para>
  <para style="q1" vid="HOS 9:8">káp ká̱ nnà te ajəp ánəm uga ngba̱l ìzhe gáng na,</para>
  <para style="q2" vid="HOS 9:8">mí yang na kpa ka̱ ashe nzhi ìNənan.<verse eid="HOS 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9" />Oza̱ gbà̱ng chit ka̱ ashe nlàng nnəm nnandər</para>
  <para style="q2" vid="HOS 9:9">wa nva ka̱ ashe nra aGibiyà.<note caller="+" style="f"><char style="fr" closed="false">9.9 </char><char style="ft" closed="false">Nnap onəm oga akwali 19.</char></note></para>
  <para style="q1" vid="HOS 9:9">UYawe i rəng nnap mɓá̱ngɓa̱ng oza̱,</para>
  <para style="q2" vid="HOS 9:9">kang i nyám ntàn óza̱.<verse eid="HOS 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10" />Nva̱ ka̱ n yak uIsa̱rila te, uza̱ wa awar ìba̱ngba̱ng ka̱ ashe anyin.</para>
  <para style="q1" vid="HOS 9:10">N ya okəka wo wa awar aga nggəshi ka̱ izər ìpipyan ka̱ ashe nrəra.</para>
  <para style="q1" vid="HOS 9:10">Oza̱ ɓa aBaal Piyo te,</para>
  <para style="q2" vid="HOS 9:10">oza̱ gar ishi oza̱ îchə̀r.</para>
  <para style="q1" vid="HOS 9:10">Kang oza̱ təm iya̱m iga nnəm ajan wa ìchər va oza̱ ma̱n.<verse eid="HOS 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11" />Ìzhàn aEfrayim i wong i ga wa ìnyil,</para>
  <para style="q2" vid="HOS 9:11">amar, ntəm ká̱ anyám, ká̱ ǹyar anyám i yà ka̱t.<verse eid="HOS 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12" />Kang a yà pa̱ oza̱ a kang ovan oza̱ te,</para>
  <para style="q2" vid="HOS 9:12">mi nak oza̱ i lang nza̱ uzəngtəng nggo.</para>
  <para style="q1" vid="HOS 9:12">Álak ká̱ oza̱ chit, nva̱ngva̱ mi re oza̱ ká̱ nkùkwa á.<verse eid="HOS 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13" />N ya uEfərayim wa aTaya,</para>
  <para style="q2" vid="HOS 9:13">mmá suk ka̱ ashe atak anəna̱n.</para>
  <para style="q1" vid="HOS 9:13">Te uEfərayim i fa ká̱ ovan wò ka̱kul nzhì.<verse eid="HOS 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14" />Ná óza̱ áYawe, iza̱ màl pa̱ ú ná yà?</para>
  <para style="q2" vid="HOS 9:14">Ná afu aga ǹwak ká̱ mbyal ngga ǹyà ká̱ ndəng ka̱t.<verse eid="HOS 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15" />Nkpaktak inga oza̱ nyám ka̱ aGilgal,</para>
  <para style="q2" vid="HOS 9:15">n yang oza̱ ka̱ ta ka̱kul nnap nnəm oza̱ ǹngha.</para>
  <para style="q1" vid="HOS 9:15">Mi ɓàk oza̱ i fa ka̱ ashe nzhi mi,</para>
  <para style="q2" vid="HOS 9:15">mi ma̱n oza̱ lap ka̱t.</para>
  <para style="q1" vid="HOS 9:15">Nkpaktak onəm oga mpyal oza̱,</para>
  <para style="q2" vid="HOS 9:15">onəm oga nfa iya̱mkak .<verse eid="HOS 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16" />Mmá tul uEfərayim chit, alə̀ng oza̱ wom,</para>
  <para style="q2" vid="HOS 9:16">oza̱ i mar ovan lap ka̱t.</para>
  <para style="q1" vid="HOS 9:16">Kang a yà pa̱ oza̱ a mar te mi gbá̱ng,</para>
  <para style="q2" vid="HOS 9:16">iya̱m inəna̱n iga afu oza̱ áta.<verse eid="HOS 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17" />Inan mi yang oza̱,</para>
  <para style="q2" vid="HOS 9:17">ka̱kul oza̱ gwong achwang kà̱ na ka̱t,</para>
  <para style="q2" vid="HOS 9:17">te oza̱ i yà onəm rá nggangra nggang ka̱ ashe oga mbin.<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="s">Inan i nyám ntàn ûIsa̱rila</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1" />uIsa̱rila ìba̱ngba̱ng va á ɓyen pa̱ shat,</para>
  <para style="q2" vid="HOS 10:1">uza̱ i ná awar ishi wò pa̱ makmak.</para>
  <para style="q1" vid="HOS 10:1">Ka̱kul mmak awuwar te,</para>
  <para style="q2" vid="HOS 10:1">uza̱ myak atak nshì iya̱m awop.</para>
  <para style="q1" vid="HOS 10:1">Ka̱kul mɓyen iya̱m iga mbibin te,</para>
  <para style="q2" vid="HOS 10:1">uza̱ sham ìsham oga ala̱ka̱n ayə́ryər wò.<verse eid="HOS 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2" />Ìgwak oza̱ i lam atak ǹyangmata̱,</para>
  <para style="q2" vid="HOS 10:2">nkpak pa̱ oza̱ á yar mpəpat.</para>
  <para style="q1" vid="HOS 10:2">UYawe i chwan atak nshì iya̱m ngwop</para>
  <para style="q2" vid="HOS 10:2">kang uza̱ i shin oga ala̱ka̱n oza̱ ayə́ryər.<verse eid="HOS 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3" />Oza̱ kà̱ nlà pa̱, &lt;&lt;Í yà ká̱ uponzhi ka̱t,</para>
  <para style="q2" vid="HOS 10:3">ka̱kul i nəm ayər áYawe ka̱t.</para>
  <para style="q1" vid="HOS 10:3">Ká̱ í yà ká̱ uponzhi te,</para>
  <para style="q2" vid="HOS 10:3">iza̱ uza̱ ká̱ nəm á yi yà?&gt;&gt;<verse eid="HOS 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4" />Oza̱ là oga nnap-nlà na pa mwang.</para>
  <para style="q2" vid="HOS 10:4">Oza̱ sóng anung ká̱ ǹyar nsar nnap-nlà ngga akwam,</para>
  <para style="q1" vid="HOS 10:4">te akwali fa wa ipəpà ìga akàl</para>
  <para style="q2" vid="HOS 10:4">ka̱ ashe ìram ìwapwap.<verse eid="HOS 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5" />Ayər i nəm onəm oga ntəm ka̱ ashe aSamariya,</para>
  <para style="q2" vid="HOS 10:5">ka̱kul ìchər ivan ina iga aBet Ava̱n.</para>
  <para style="q1" vid="HOS 10:5">Onənəm ká̱ onəm oga mpyal awop i təm ká̱ aɗor ka̱kukul,</para>
  <para style="q2" vid="HOS 10:5">oza̱ i tán ka̱kul ìzhəzhan kap ká̱ oza̱ chit.<verse eid="HOS 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6" />Mí yar mí ná imwa,</para>
  <para style="q2" vid="HOS 10:6">ûponzhi uchumchum uga aAshur ká̱.</para>
  <para style="q1" vid="HOS 10:6">Ìwuswa i yar uEfərayim,</para>
  <para style="q2" vid="HOS 10:6">ìwuswa i nəm uIsa̱rila ka̱kul ichəchen.<verse eid="HOS 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7" />IPonzhi oga aSamariya i zhì,</para>
  <para style="q2" vid="HOS 10:7">wa akún ka̱ apal ndəng.<verse eid="HOS 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8" />Mi zhì atak awop aga apal oga aɗuktum va̱ ka̱ aAva̱n,</para>
  <para style="q2" vid="HOS 10:8">atak va oIsa̱rila i nəm inga ka̱ á,</para>
  <para style="q1" vid="HOS 10:8">izú ká̱ nkpakshi, i rup ka̱ atak nshì iya̱m awop oza̱,</para>
  <para style="q2" vid="HOS 10:8">oza̱ i là ipáng ichumchum pa̱, &lt;&lt;Gún yi.&gt;&gt;</para>
  <para style="q1" vid="HOS 10:8">Oza̱ i là oga aɗuktum pa̱ &lt;&lt;Ó tàk ka̱ apal ishi yi.&gt;&gt;<verse eid="HOS 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9" />&lt;&lt;óIsa̱rila, á ɓan ka̱ ashe oga nra aGibiyà</para>
  <para style="q2" vid="HOS 10:9">nnà o nəm nnap mɓá̱ngɓa̱ng.</para>
  <para style="q1" vid="HOS 10:9">Á ɓàn matmat kang mmawó kà̱ ngga mpyal ka̱ ashishe,</para>
  <para style="q2" vid="HOS 10:9">te ìkum mul oza̱ ka̱ aGibiyà ka̱t ɗò?<verse eid="HOS 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10" />ÌLum i rwam te, mi nyám ntàn óza̱,</para>
  <para style="q2" vid="HOS 10:10">oga mbin i gwang ishi i lung oza̱,</para>
  <para style="q2" vid="HOS 10:10">ka̱kul mpyát oga nnap mɓá̱ngɓa̱ng oza̱.<verse eid="HOS 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11" />UEfərayim wa ìya ìna ìva mmá ɗyang ntàn á na,</para>
  <para style="q2" vid="HOS 10:11">ìva fe nchang mpək ìpirkur,</para>
  <para style="q2" vid="HOS 10:11">kang n ná nfe nchang á na.</para>
  <para style="q1" vid="HOS 10:11">Te mi nak ayok aɗəkɗək kà̱ ishishak,</para>
  <para style="q2" vid="HOS 10:11">mi nak uYahudi pa̱ a dap ashan,</para>
  <para style="q2" vid="HOS 10:11">uYakup nnyi te, i dap ashan aga mbəbək.<verse eid="HOS 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12" />Ó suk nnap nnəna̱n íshi wo</para>
  <para style="q2" vid="HOS 10:12">te ó ɓən mma̱n nva i kùr ka̱t.</para>
  <para style="q1" vid="HOS 10:12">O kà̱p oga mpom wo,</para>
  <para style="q2" vid="HOS 10:12">ka̱kul awalang aga nram uYawe nəm chit.</para>
  <para style="q1" vid="HOS 10:12">Na uza̱ a pəng,</para>
  <para style="q2" vid="HOS 10:12">nnap nnəna̱n ka̱ apal wo.<verse eid="HOS 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13" />O shàng iya̱m inga</para>
  <para style="q2" vid="HOS 10:13">o ɓən mɓək anung.</para>
  <para style="q2" vid="HOS 10:13">O ri imwa nnáp akwam.&gt;&gt;</para>
  <para style="q1" vid="HOS 10:13">Ka̱kul o təp asəm kà̱ nkàm wo,</para>
  <para style="q2" vid="HOS 10:13">ká̱ ìyə̀l onəm ìkum ova̱ mmawó ká̱.<verse eid="HOS 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14" />Ka̱kul nva̱ ta te, achu ìkum i ga ngwong</para>
  <para style="q2" vid="HOS 10:14">kà̱ ishimshe onəm wo.</para>
  <para style="q1" vid="HOS 10:14">Mí shin nkpaktak akamsəlang wo,</para>
  <para style="q2" vid="HOS 10:14">wa nva uShalman zhì aBet Arbel ka̱ alum ìkum,</para>
  <para style="q2" vid="HOS 10:14">kang onang ká̱ ovan tàk kà̱ mbin kú á.<verse eid="HOS 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15" />Wa nnà ta mí nəm awo ónəm oga aBetel,</para>
  <para style="q2" vid="HOS 10:15">ka̱kul mmak inga wo.</para>
  <para style="q1" vid="HOS 10:15">Ká̱ iɓotak na byet te,</para>
  <para style="q1" vid="HOS 10:15">mí gba̱l uponzhi oga aIsa̱rila.<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s">MMa̱n Inan ka̱kul áIsa̱rila</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1" />Kà̱ ìlum va̱ uIsa̱rila ka̱ yà uyen te, m ma̱n na,</para>
  <para style="q2" vid="HOS 11:1">kang ka̱ ashe mbin aMasar nà n wór uyen mi fa.<verse eid="HOS 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2" />Mi yà kà̱ ngwór oza̱ te,</para>
  <para style="q2" vid="HOS 11:2">i dong oza̱ kà̱ nchəng atak mi.</para>
  <para style="q1" vid="HOS 11:2">Oza̱ ga mpyal ká̱ nná nləfər oga ìchər aBaal,</para>
  <para style="q2" vid="HOS 11:2">kang oza̱ i dung oga îchə̀r.<verse eid="HOS 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3" />Mmami na kà̱ nɗyang achen uEfərayim</para>
  <para style="q2" vid="HOS 11:3">n kpán oza̱ ká̱ awo mi.</para>
  <para style="q1" vid="HOS 11:3">Ká̱ nnà te, oza̱ nyi pa̱</para>
  <para style="q2" vid="HOS 11:3">mmami na n tàn oza̱ ka̱t.<verse eid="HOS 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4" />N kpak oza̱ ká̱ nrwa ìgwak</para>
  <para style="q2" vid="HOS 11:4">ká̱ asang aga mma̱n.</para>
  <para style="q1" vid="HOS 11:4">Mmami wa ánəm ùva̱ yar ayok kà̱ ishak oza̱,</para>
  <para style="q2" vid="HOS 11:4">kang n kúchi n ná iya̱m-nrì óza̱.<verse eid="HOS 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5" />Oza̱ i le mbin aMasar,</para>
  <para style="q2" vid="HOS 11:5">kang aAshur i təm uponzhi oza̱,</para>
  <para style="q2" vid="HOS 11:5">ka̱kul oza̱ yang ká̱ ngga̱ɓa̱n asəm n̂nap mɓá̱ngɓa̱ng.<verse eid="HOS 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6" />Ǹdokchi i kandar kà̱ ìtong oza̱,</para>
  <para style="q2" vid="HOS 11:6">i chwan oga anung asa̱l ìtong oza̱,</para>
  <para style="q2" vid="HOS 11:6">kang i ri oza̱ ka̱kul ichən oza̱ inga.<verse eid="HOS 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7" />Onəm mi yar pa̱ o ga̱ɓa̱n o re mi.</para>
  <para style="q2" vid="HOS 11:7">Oza̱ kà̱ ngwór atak achumchum,</para>
  <para style="q2" vid="HOS 11:7">kang i yà ká̱ ǹrup ká̱ oza̱ ka̱t.<verse eid="HOS 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8" />Wa ǹsang mi kap ká̱ ɓu yà, aEfrayim?</para>
  <para style="q2" vid="HOS 11:8">Wa ǹsang mi na ɓu ka̱ atak ro yà, áIsa̱rila?</para>
  <para style="q1" vid="HOS 11:8">Wa ǹsang mi na ɓu wa aAdima yà?</para>
  <para style="q2" vid="HOS 11:8">Wa ǹsang mi nak ɓu wa aZeboyim yà?</para>
  <para style="q1" vid="HOS 11:8">Ìgwak mi ga̱ɓa̱n chit,</para>
  <para style="q2" vid="HOS 11:8">kang ǹrusok afu mi chi izər.<verse eid="HOS 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9" />Mi yà ká̱ nnəm inok ká̱ nlak ìgwak mi ka̱t,</para>
  <para style="q2" vid="HOS 11:9">mi zhì uEfərayim lap ka̱t,</para>
  <para style="q1" vid="HOS 11:9">Ka̱kul mmami Inan, unəm ka̱t,</para>
  <para style="q2" vid="HOS 11:9">uNəna̱n, kà̱ ishimshe wo</para>
  <para style="q2" vid="HOS 11:9">mi ɓa ka̱ ashe ǹfə́l ìgwak ka̱t.<verse eid="HOS 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10" />Oza̱ i yar nva̱ng àYawe,</para>
  <para style="q2" vid="HOS 11:10">uza̱ i ɗum wa ìlir.</para>
  <para style="q1" vid="HOS 11:10">Kà̱ nva̱ngva̱ uza̱ i ɗum te,</para>
  <para style="q2" vid="HOS 11:10">ovəvan i ɓa ká̱ nchəng ka̱ asa̱l ntar alum.<verse eid="HOS 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11" />Ká̱ ngha̱n oza̱ i ɓa wa ìnyil ka̱ aMasar,</para>
  <para style="q2" vid="HOS 11:11">kang wa ìləkpar kà̱ mbin aAshur.</para>
  <para style="q1" vid="HOS 11:11">Te mi nak oza̱ i təm kà̱ nzhi oza̱,</para>
  <para style="q2" vid="HOS 11:11">uYawe à là.<verse eid="HOS 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12" />UEfərayim gáng mi ká̱ akwam,</para>
  <para style="q2" vid="HOS 11:12">kang nzhi àIsa̱rila ká̱ nlàm atak.</para>
  <para style="q1" vid="HOS 11:12">UYahudi te, kà̱ nránggang ká̱ Inan,</para>
  <para style="q2" vid="HOS 11:12">kang uza̱ ká̱ nnandər ûNəna̱n.<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1" />UEfərayim i kpak ayə́r,</para>
  <para style="q2" vid="HOS 12:1">uza̱ i wà ayə́r nvàngváng nza̱ nra nggo</para>
  <para style="q2" vid="HOS 12:1">kang i ga mpyal ká̱ mmar akwam ká̱ ìfan.</para>
  <para style="q1" vid="HOS 12:1">Uza̱ yar nsar nnap-nlà ká̱ aAshur,</para>
  <para style="q2" vid="HOS 12:1">kang i ga ká̱ mmì ka̱ aMasar.<verse eid="HOS 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2" />UYawe uwa yà ká̱ nnap-nlà ka̱ apal áYahudi,</para>
  <para style="q2" vid="HOS 12:2">uza̱ i nyám ntàn ûYakup ka̱ apal achəchən,</para>
  <para style="q2" vid="HOS 12:2">kang uza̱ i mwa na i ma ká̱ nnap nnənəm.<verse eid="HOS 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3" />Ka̱ ashe afu uza̱ kpán ndong ashar á gənang wò,</para>
  <para style="q2" vid="HOS 12:3">kang uza̱ chu unəm te, á ma nggwak ká̱ Inan.<verse eid="HOS 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4" />Uza̱ ma nggwak ká̱ uma̱leka, á ga nəm igwan,</para>
  <para style="q2" vid="HOS 12:4">uza̱ yə́ng kang à chal nnap nnəna̱nnəna̱n.</para>
  <para style="q1" vid="HOS 12:4">Uza̱ gwang ká̱ Inan ka̱ aBetel,</para>
  <para style="q2" vid="HOS 12:4">kang Inan là nnàp ká̱ na.<verse eid="HOS 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5" />UYawe, Inan uga nggatək,</para>
  <para style="q2" vid="HOS 12:5">aɗiɗin uYawe, a va mí rəng na ká̱.<verse eid="HOS 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6" />Te o le atak Inan wo,</para>
  <para style="q2" vid="HOS 12:6">o nyám mma̱n ká̱ nnandər,</para>
  <para style="q2" vid="HOS 12:6">o təm ká̱ nlok Inan pa̱ ɗəkər.<verse eid="HOS 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7" />Uza̱ ɗom nnap mmwar atak ká̱ asikel</para>
  <para style="q2" vid="HOS 12:7">aga mmwap onəm wa oga aKanana.<verse eid="HOS 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8" />UEfərayim là pa̱, &lt;&lt;N təm unəm uga ndur chit,</para>
  <para style="q2" vid="HOS 12:8">m ɓut ìdur chit ka̱kul ishi mi</para>
  <para style="q2" vid="HOS 12:8">ka̱ ashe nkpaktak nlə̀m mi, mmá ya mpat kà̱ mi ka̱t.&gt;&gt;<verse eid="HOS 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9" />Mmami uYawe, Inan wo,</para>
  <para style="q2" vid="HOS 12:9">uva̱ fa ká̱ wo kà̱ mbin aMasar.</para>
  <para style="q1" vid="HOS 12:9">Mi nak o təm ka̱ ashe aghal kà̱ɗi ,</para>
  <para style="q2" vid="HOS 12:9">wa kà̱ ìlum ìnaknak ìga nchang izər.<verse eid="HOS 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10" />N là nnàp ká̱ onəm oga nlà ìchu Inan,</para>
  <para style="q2" vid="HOS 12:10">te n nyám oga alár pa̱ makmak</para>
  <para style="q2" vid="HOS 12:10">kang n gba oga nnàp ka̱ atak oza̱.<verse eid="HOS 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11" />A yà pa̱ inga nna yà ka̱ aGileyat te,</para>
  <para style="q2" vid="HOS 12:11">nnandər uza̱ i yà iya̱m ro ka̱t.</para>
  <para style="q1" vid="HOS 12:11">Oza̱ ná nləfər ká̱ ina ka̱ aGilgal,</para>
  <para style="q2" vid="HOS 12:11">ká̱ nnà te, atak nshì iya̱m awop oza̱</para>
  <para style="q2" vid="HOS 12:11">i yà wa ipáng iɓutɓut ka̱ anung ìram.<verse eid="HOS 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12" />UYakup chər ga mbin aAram,</para>
  <para style="q2" vid="HOS 12:12">ka̱ ta na uIsa̱rila nəm inok ka̱kul achar,</para>
  <para style="q2" vid="HOS 12:12">ka̱kul achar uza̱ kpak iya̱m nkang.<verse eid="HOS 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13" />Ka̱ atak ánəm uga nlà ìchu Inan, uYawe fa ká̱ uIsa̱rila ka̱ ashe aMasar,</para>
  <para style="q2" vid="HOS 12:13">kang ka̱ atak ánəm uga nlà ìchu Inan mmá kpak na.<verse eid="HOS 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14" />UEfərayim bəshi nlak ìgwak,</para>
  <para style="q2" vid="HOS 12:14">te uPonzhinənan i re nchəchər ka̱ apal ishishi,</para>
  <para style="q2" vid="HOS 12:14">kang i mwa nnap nnəm ngga ìwuswawuswa á na.<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="s1">Mí ga nzhì onəm aEfrayim.</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1" />Kà̱ nva̱ngva̱ uEfərayim là nnap te, izər tán ká̱ onəm,</para>
  <para style="q2" vid="HOS 13:1">mmá shep na ka̱ ashe aIsa̱rila,</para>
  <para style="q2" vid="HOS 13:1">ka̱kul uza̱ nəm mpat kà̱ ngwop aBaal, te nkpak uza̱ i kú.<verse eid="HOS 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2" />Ǹyangmata̱, oza̱ ga mpyal ká̱ nnəm nnap mɓá̱ngɓa̱ng,</para>
  <para style="q2" vid="HOS 13:2">oza̱ nəm ìchər ka̱ atak aghan oza̱ ká̱ aazurfa îshi oza̱.</para>
  <para style="q1" vid="HOS 13:2">Nkpaktak oga ìchər va̱ ta te, iya̱m nnəm onəm oga inok awo,</para>
  <para style="q2" vid="HOS 13:2">onəm oga aIsa̱rila i là pa̱,</para>
  <para style="q2" vid="HOS 13:2">&lt;&lt;Onəm va̱ i ná nləfər te, oza̱ i má njàng ala̱ka̱n ìna.&gt;&gt;<verse eid="HOS 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3" />Ka̱kul nva̱ ta te, oza̱ i yà wa ìnanəng iga ìpin,</para>
  <para style="q2" vid="HOS 13:3">kang wa ìmimyang ìva̱ i lyangshin ká̱ iɓotak.</para>
  <para style="q1" vid="HOS 13:3">I ga wa adùng va ayə́r i dà̱n ka̱ atak mpək ìpirkur,</para>
  <para style="q2" vid="HOS 13:3">kang wa nggù nva i fa kà̱ mɓol ayə́r nzhi.<verse eid="HOS 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4" />Mmami uYawe, Inan wo,</para>
  <para style="q2" vid="HOS 13:4">ùva̱ fa ká̱ wo kà̱ mbin aMasar,</para>
  <para style="q1" vid="HOS 13:4">Inan iro yà o nyi ka̱t mmami,</para>
  <para style="q2" vid="HOS 13:4">unəm uga nka̱mshi uro yà ka̱t mmami na byet.<verse eid="HOS 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5" />N ɗak ká̱ wo ka̱ ashe ǹzam nkpələng,</para>
  <para style="q2" vid="HOS 13:5">kà̱ mbin nva ìva̱r i pəng kà̱ ka̱t á.<verse eid="HOS 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6" />Kà̱ nva̱ngva̱ n ri ká̱ oza̱ te afu yə́l oza̱,</para>
  <para style="q2" vid="HOS 13:6">afu yə́l oza̱ te, oza̱ nəm nkak ishi,</para>
  <para style="q2" vid="HOS 13:6">oza̱ ka̱ng ká̱ mi.<verse eid="HOS 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7" />Te mi ru oza̱ wa ìlir,</para>
  <para style="q2" vid="HOS 13:7">wa ìdaməng mi ra anyimnyal oza̱ ka̱ asa̱l.<verse eid="HOS 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8" />Mi fa óza̱ wa ìdəshìli ìva mmá wur ivəvan,</para>
  <para style="q2" vid="HOS 13:8">mi kan ìkwoksok oza̱.</para>
  <para style="q1" vid="HOS 13:8">Mi zhì oza̱ ka̱ ta wa ìlir,</para>
  <para style="q2" vid="HOS 13:8">mi kan oza̱ wa ìzhe ìga anyin.<verse eid="HOS 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9" />Mi zhì ɓu, áIsa̱rila,</para>
  <para style="q2" vid="HOS 13:9">uda i ka̱mshi ɓu yà?<verse eid="HOS 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10" />UPonzhi ɓu ka̱ chè ǹyangmata̱ pa̱ á ka̱mshi ɓu yà?</para>
  <para style="q2" vid="HOS 13:10">Onəm oga mpyal ɓu ka̱ chè ka̱ ashe nkpaktak itong ɓu,</para>
  <para style="q2" vid="HOS 13:10">ova̱ u là pa̱, &lt;&lt;Ná uponzhi ká̱ onəm oga mpyal á mi yà?&gt;&gt;<verse eid="HOS 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11" />N ná uponzhi a ɓu ka̱ ashe nlak ìgwak mi,</para>
  <para style="q2" vid="HOS 13:11">kang n tur na le ka̱ ashe ǹfə́l ìgwak mi.<verse eid="HOS 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12" />Mmá lur mpat aEfrayim chit,</para>
  <para style="q2" vid="HOS 13:12">nnap mɓá̱ngɓa̱ngɓa̱ngɓa̱ng ɓut chit ra.<verse eid="HOS 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13" />Nrwa afu amar ɓàn na chit,</para>
  <para style="q2" vid="HOS 13:13">kang uza̱ uyen upərəkpərək.</para>
  <para style="q1" vid="HOS 13:13">Ka̱ awalang amar te,</para>
  <para style="q2" vid="HOS 13:13">uza̱ ma̱n pa̱ ó fa ka̱ ashe atak amar ka̱t.<verse eid="HOS 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14" />Mi mwa ishi oza̱ ka̱ ashe awo aShəwol ɗò?</para>
  <para style="q2" vid="HOS 13:14">Mi fa ká̱ oza̱ ka̱ atak ikú ɗò?</para>
  <para style="q1" vid="HOS 13:14">Á ikú, arwa ɓu ka̱ chè yà?</para>
  <para style="q2" vid="HOS 13:14">Á aShəwol, nzhì ɓu ka̱ chè yà?</para>
  <para style="q1" vid="HOS 13:14">Ǹrusok afu i bubwam kà̱ ìwu mi.<verse eid="HOS 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 13:15" />Káp ka̱ nva̱ uza̱ i myak i ji ka̱ ashe ogənnang wò,</para>
  <para style="q2" vid="HOS 13:15">ayə́r nvàngváng ka̱ atak áYawe, kà̱ mɓa ka̱ ashe ǹzam nkpələng.</para>
  <para style="q1" vid="HOS 13:15">Atak mɓəl ndədəng ká̱ ìwu ndədəng mɓokɓok i wom,</para>
  <para style="q2" vid="HOS 13:15">i lak nza̱ atak nnak iya̱m inəna̱n nggo,</para>
  <para style="q2" vid="HOS 13:15">kang ìwuswa i nəm na.<verse eid="HOS 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16" />Nkpak pa̱ aSamariya á yar iɗək mpat wò,</para>
  <para style="q2" vid="HOS 13:16">ka̱kul uza̱ fa iya̱mkak ká̱ Inan wò.</para>
  <para style="q1" vid="HOS 13:16">Mí gbá̱ng oza̱ ká̱ ndokchi, mí kyen ovan oza̱,</para>
  <para style="q2" vid="HOS 13:16">kang ochəchar oga anyám mí cha afu oza̱.<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="s1">Mmá kà̱ nchal oIsa̱rila pa̱ <optbreak /> oza̱ a le atak áYawe</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1" />áIsa̱rila, le atak áYawe, Inan ɓu,</para>
  <para style="q2" vid="HOS 14:1">ka̱kul mpat ɓu nak chit u lə̀p ìfang.<verse eid="HOS 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2" />Le atak áYawe ká̱ nnap-nlà,</para>
  <para style="q2" vid="HOS 14:2">là á na pa̱,</para>
  <para style="q1" vid="HOS 14:2">&lt;&lt;Yar nkpaktak mpat á yi,</para>
  <para style="q2" vid="HOS 14:2">ka̱m yi ká̱ nrwa ìgwak,</para>
  <para style="q2" vid="HOS 14:2">na í shep ɓu ka̱ anung ina yi.<verse eid="HOS 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3" />AAshur i ka̱mshi yi ka̱t,</para>
  <para style="q2" vid="HOS 14:3">í kwak ipəri ìkum ka̱t.</para>
  <para style="q1" vid="HOS 14:3">Í yà ká̱ nlà iya̱m nnəm awo yi pa̱,</para>
  <para style="q2" vid="HOS 14:3">&lt;Inan yi&gt; ka̱t.</para>
  <para style="q2" vid="HOS 14:3">Ka̱ atak ɓu uyenkpələng i ya nrwa ìgwak.&gt;&gt;<verse eid="HOS 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4" />&lt;&lt;Mi tàn ngga̱ɓa̱n nre nna nnandər oza̱,</para>
  <para style="q2" vid="HOS 14:4">kang mi ma̱n oza̱ wa nva̱ n ɗom,</para>
  <para style="q2" vid="HOS 14:4">ka̱kul á ga̱ɓa̱n nlak ìgwak mi chit ka̱ atak oza̱.<verse eid="HOS 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5" />Mi yà wa ìmimyang ûIsa̱rila,</para>
  <para style="q2" vid="HOS 14:5">uza̱ i bà̱l wa nggwanggwang ìzhəpndəng,</para>
  <para style="q1" vid="HOS 14:5">kang i rwak alə̀ng wa aLebanon.<verse eid="HOS 14:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 14:6" />Ntə́təp i bol, kang iɓiɓyen i yà wa ikún mpyet,</para>
  <para style="q1" vid="HOS 14:6">te mməmməm wa ikún asida iga aLebanon.<verse eid="HOS 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7" />Onəm i təm ka̱ avəng ayiyi kà̱ɗi ,</para>
  <para style="q2" vid="HOS 14:7">oza̱ i myak wa ìpirkur.</para>
  <para style="q1" vid="HOS 14:7">Oza̱ i tə́p wa ikún ìba̱ngba̱ng,</para>
  <para style="q2" vid="HOS 14:7">ìdaɓardaɓar i yà wa ndəng ìba̱ngba̱ng ǹsámsàm iga aLebanon.<verse eid="HOS 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8" />aEfrayim, iza̱ mi nəm ká̱ oga ìchər yà?</para>
  <para style="q2" vid="HOS 14:8">Mmami na mi ná ama̱n a ɓu kang mi nak ishi ká̱ ɓu.</para>
  <para style="q1" vid="HOS 14:8">Mmami wa ìkun ìsa̱l,</para>
  <para style="q2" vid="HOS 14:8">ka̱ atak mi na ó ya awar anəna̱n.&gt;&gt;<verse eid="HOS 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9" />Unəm va̱ ká̱ aghan te, re uza̱ á kpán ìpir oga iya̱m va̱ ta̱,</para>
  <para style="q2" vid="HOS 14:9">unəm va̱ ká̱ nkpán ìpir nnap te,</para>
  <para style="q2" vid="HOS 14:9">re uza̱ á nyi ìpipir.</para>
  <para style="q1" vid="HOS 14:9">Ka̱kul asa̱l áYawe anəna̱n,</para>
  <para style="q2" vid="HOS 14:9">onəm onəna̱n i chen ka̱ ashishe,</para>
  <para style="q2" vid="HOS 14:9">onəm oga nfa iya̱mkak i lə̀p ìfang ka̱ apəpal.<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>