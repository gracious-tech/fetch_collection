<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴓𐴟𐴑𐴝𐴥𐴏𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴓𐴟𐴑𐴝𐴥𐴏𐴢</para>
  <para style="toc2">𐴓𐴟𐴑𐴝𐴥𐴏𐴢</para>
  <para style="toc3">𐴓𐴟𐴑</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴓𐴟𐴑𐴝𐴥𐴏𐴢</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴓𐴟𐴑𐴝𐴥𐴏𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴓𐴟𐴑𐴝𐴥𐴏𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴞𐴥𐴘𐴝𐴌𐴝, 𐴎𐴞𐴁𐴝𐴤𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞, 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴉𐴡𐴀𐴘𐴓𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌𐴠 ”𐴀𐴞𐴕𐴅𐴞𐴓𐴢“ 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 ”𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌“ 𐴘𐴝𐴥𐴕𐴞 ”𐴒𐴡𐴔 𐴈𐴡𐴥𐴁𐴡𐴌.“ 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴀𐴞𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴞 𐴁𐴝𐴦𐴊𐴠 𐴔𐴡𐴃𐴞, 𐴔𐴝𐴌𐴑𐴟𐴏𐴢, 𐴓𐴟𐴑𐴝𐴥𐴏𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴓𐴟𐴑𐴝𐴥𐴏𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴑𐴝𐴇𐴝𐴥𐴕𐴞 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴞 𐴀𐴝𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴝𐴔𐴡𐴥𐴓𐴢 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴀. 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴓𐴟𐴑𐴝𐴥𐴏𐴢 𐴘𐴞𐴁𐴝𐴤 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴍𐴠𐴥 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴓𐴠𐴑𐴞𐴕 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴟𐴓𐴠𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴁𐴝𐴤 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴞 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴇𐴡𐴥𐴙𐴃𐴧𐴡𐴌 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.</para>
  <para style="ip">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴁𐴝𐴤𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴓𐴟𐴑𐴝𐴥𐴏𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴊𐴝𐴁𐴝𐴙𐴌 𐴋𐴝𐴑𐴄𐴡𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴓𐴠𐴑𐴝𐴥𐴌 𐴃𐴡𐴌𐴞𐴑𐴝𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴎𐴟𐴁𐴝𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴠𐴓𐴡𐴥𐴔𐴊𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴓𐴟𐴑𐴝𐴥𐴏𐴡𐴃𐴧𐴟 𐴀𐴞𐴏𐴝𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴞𐴀𐴕 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴓𐴠𐴑𐴞𐴥𐴃𐴡 𐴔𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴉𐴡𐴌𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴡𐴌𐴞𐴥 𐴉𐴝𐴥𐴘𐴊𐴝 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 <char style="ior">(<ref loc="LUK 1:1-3">1‏:1‏-3</ref>)</char>. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 (<char style="xt"><ref loc="COL 4:10-14">𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴀𐴡𐴥𐴓𐴢 4‏:10‏-14</ref></char>), 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴟𐴎𐴠𐴥 𐴊𐴠 𐴃𐴡𐴌𐴞𐴑𐴝 𐴓𐴡𐴘 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴌𐴡𐴏𐴡𐴥𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴟𐴎𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴈𐴠𐴥𐴕𐴃𐴟 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞 <char style="ior">(<ref loc="LUK 1:8">1‏:8</ref>)</char>.</para>
  <para style="ip">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴓𐴟𐴑𐴝𐴥𐴏𐴢 𐴘𐴞𐴁𐴝𐴤 𐴁𐴠𐴦𐴐𐴁𐴝𐴥𐴑 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴡𐴃𐴞 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴌𐴑𐴟𐴏𐴢 𐴓𐴡𐴘 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴝𐴌𐴝𐴥 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴏𐴞𐴎𐴡𐴌𐴠 𐴀𐴠𐴑 𐴃𐴡𐴌𐴞𐴑𐴝 𐴓𐴡𐴘 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴃𐴞𐴕𐴞𐴥 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠, 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴓𐴟𐴑𐴝𐴥𐴏𐴡𐴃𐴢 𐴓𐴟𐴑𐴝𐴥𐴏𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴎𐴡𐴌𐴔𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴉𐴏𐴞𐴓𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥 𐴃𐴟𐴓𐴞𐴤 𐴊𐴡𐴙𐴅𐴧𐴠 <char style="ior">(<ref loc="LUK 3:3">3‏:3</ref>; <ref loc="LUK 11:4">11‏:4</ref>; <ref loc="LUK 17:3-4">17‏:3‏-4</ref>; <ref loc="LUK 23:34">23‏:34</ref>; <ref loc="LUK 24:47">24‏:47</ref>)</char>, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥 𐴃𐴟𐴓𐴞𐴤 𐴊𐴡𐴙𐴅𐴧𐴠 <char style="ior">(<ref loc="LUK 3:21">3‏:21</ref>; <ref loc="LUK 5:16">5‏:16</ref>; <ref loc="LUK 6:12">6‏:12</ref>; <ref loc="LUK 11:1-12">11‏:1‏-12</ref>; <ref loc="LUK 22:32">22‏:32</ref>)</char>.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢, 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴎𐴡𐴌𐴔𐴡 <char style="ior">(<ref loc="LUK 1:1-2:52">1‏:1‏—2‏:52</ref>)</char></para>
  <para style="io1">2. 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴔𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴃𐴡𐴘𐴧𐴝𐴌𐴞 <char style="ior">(<ref loc="LUK 3:1-4:13">3‏:1‏—4‏:13</ref>)</char></para>
  <para style="io1">3. 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 <char style="ior">(<ref loc="LUK 4:14-9:50">4‏:14‏—9‏:50</ref>)</char></para>
  <para style="io1">4. 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴌 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 <char style="ior">(<ref loc="LUK 9:51-19:27">9‏:51‏—19‏:27</ref>)</char></para>
  <para style="io1">5. 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 <char style="ior">(<ref loc="LUK 19:28-21:38">19‏:28‏—21‏:38</ref>)</char></para>
  <para style="io1">6. 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴑-𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴦𐴃𐴢 <char style="ior">(<ref loc="LUK 22-23">22‏—23</ref>)</char></para>
  <para style="io1">7. 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝 <char style="ior">(<ref loc="LUK 24">24</ref>)</char></para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s1">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴓𐴠𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴠𐴤 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴀𐴞𐴎𐴧𐴡𐴃𐴊𐴝𐴥𐴌 𐴃𐴞𐴘𐴡𐴉𐴞𐴥𐴓𐴝𐴏𐴢, 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴐𐴟𐴥𐴌𐴟𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴒𐴡𐴌𐴞 𐴃𐴝𐴇𐴝𐴥𐴑𐴞𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕-𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴡𐴥𐴌𐴞 𐴓𐴠𐴑𐴡𐴥𐴕 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴁𐴝𐴥𐴙𐴂𐴧𐴞, <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴀𐴛 𐴎𐴠 𐴈𐴡𐴃𐴝𐴤 𐴒𐴟𐴥𐴕𐴡𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴉𐴝𐴘𐴧𐴡𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴎𐴝𐴕𐴡.<verse eid="LUK 1:4" /></para>
  <para style="s1">𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴎𐴡𐴌𐴔𐴡𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴇𐴝𐴓𐴠, 𐴀𐴝𐴁𐴞𐴘𐴝𐴤 𐴊𐴡𐴓𐴡𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴞𐴔𐴝𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴡𐴖𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴌𐴡𐴕𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝, 𐴇𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴀𐴠𐴓𐴞𐴥𐴎𐴝𐴁𐴠𐴃𐴢. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴘𐴡𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴡𐴎𐴞𐴕 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴙𐴓𐴃𐴡. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴀𐴝𐴙𐴕 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴓𐴞𐴥𐴎𐴝𐴁𐴠𐴃𐴢 𐴁𐴝𐴥𐴎𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴁𐴞𐴐𐴞𐴤 𐴁𐴟𐴌𐴝𐴤 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴡𐴓𐴡𐴌 𐴇𐴝𐴥𐴙𐴕 𐴔𐴡𐴎𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴔𐴝𐴔𐴞 𐴈𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />𐴀𐴞𐴔𐴝𐴔𐴞 𐴈𐴝𐴔𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴔𐴡𐴎𐴞𐴕 𐴓𐴡𐴄𐴝𐴥𐴌𐴞 𐴔𐴝𐴌𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴖𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴀𐴝𐴒𐴡𐴥𐴌𐴁𐴝𐴃𐴧𐴞 𐴎𐴡𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴒𐴡𐴥𐴌𐴁𐴝𐴃𐴧𐴞 𐴎𐴡𐴓𐴝𐴘𐴁𐴝𐴥𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴝𐴀𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴀𐴠𐴑 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴝𐴒𐴡𐴥𐴌𐴁𐴝𐴃𐴧𐴞𐴌-𐴒𐴝𐴥𐴣𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴃𐴞𐴥𐴘𐴝𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝 𐴏𐴡𐴚𐴑𐴞 𐴀𐴟𐴙𐴄𐴧𐴞𐴥𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝, 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥; 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴟𐴖𐴝 𐴉𐴟𐴥𐴙𐴕𐴧𐴠. 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴡𐴖𐴢 𐴀𐴠𐴓𐴞𐴥𐴎𐴝𐴁𐴠𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴌𐴝𐴑𐴞𐴥𐴁𐴝. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴑𐴟𐴥𐴐𐴞𐴌 𐴖𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴌𐴔𐴡𐴘𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴔𐴟𐴈𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴁𐴡; 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴡 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴡𐴌 𐴐𐴡𐴥𐴌𐴝𐴁𐴢 𐴈𐴝𐴥𐴘𐴁𐴡 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴕𐴞𐴐𐴝𐴥 𐴈𐴝𐴥𐴘𐴁𐴡, 𐴀𐴞𐴥𐴁𐴝 𐴔𐴝𐴦𐴌 𐴉𐴠𐴍𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴡𐴥𐴃𐴞 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴓𐴡𐴥𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴁𐴟𐴊𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴞𐴥𐴌𐴝𐴘 𐴀𐴝𐴕𐴞𐴤𐴁𐴡. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴡𐴌 𐴌𐴟𐴀 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴑𐴡𐴃𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴀𐴝𐴒𐴠-𐴀𐴝𐴒𐴠 𐴎𐴝𐴘𐴁𐴡; 𐴎𐴝𐴘 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴞𐴓𐴢 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴀𐴝𐴦𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴡𐴌 𐴊𐴠𐴔𐴝𐴑𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴉𐴞𐴥𐴌𐴝𐴘𐴁𐴡; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴔𐴝𐴁𐴟𐴊𐴡𐴓𐴧𐴝 𐴕𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴑𐴡𐴗𐴔 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.“<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝𐴘𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟ 𐴀𐴝𐴀𐴛 𐴊𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴁𐴟𐴌𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴖𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴁𐴞𐴐𐴞𐴤 𐴁𐴡𐴐𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.“<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴅𐴞𐴁𐴌𐴝𐴙𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴑𐴞; 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴘𐴢 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴒𐴝𐴥𐴕 𐴉𐴡𐴀𐴣𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />𐴀𐴝𐴦𐴌 𐴏𐴡𐴀, 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴀𐴕 𐴉𐴟𐴌𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴇𐴠𐴥𐴃𐴡𐴊𐴞𐴕 𐴃𐴟𐴀𐴛 𐴁𐴟𐴑 𐴃𐴝𐴥𐴑𐴞𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴃𐴞 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴒𐴟𐴥𐴕 𐴀𐴠𐴑𐴞𐴕 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴞𐴀𐴕 𐴄𐴞𐴥𐴑 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴓𐴠𐴤 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.“<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴧𐴟 𐴀𐴝𐴘𐴃𐴠𐴤 𐴊𐴠𐴌𐴞 𐴀𐴡𐴥𐴌 𐴁𐴡𐴥𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴥𐴉𐴝𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴝𐴀𐴌𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴝𐴃𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠. 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴊𐴡𐴌𐴐𐴡𐴥𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴀𐴞𐴐𐴝𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴁𐴟𐴑 𐴃𐴝𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴞𐴔𐴝𐴔𐴞 𐴈𐴝𐴔𐴡𐴌 𐴊𐴞𐴕 𐴉𐴟𐴥𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />𐴉𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴡𐴖𐴢 𐴀𐴠𐴓𐴞𐴥𐴎𐴝𐴁𐴠𐴃𐴢 𐴇𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴉𐴝𐴣𐴏𐴢 𐴔𐴝𐴐𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴠 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢, <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />”𐴎𐴠 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴔𐴝𐴁𐴟𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴐𐴡𐴥𐴌𐴡𐴔𐴡𐴌𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴎𐴟 𐴕𐴡𐴎𐴡𐴌 𐴊𐴞𐴘𐴠𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴘𐴝𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.“<verse eid="LUK 1:25" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴡𐴌𐴔𐴡𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />𐴏𐴡𐴥 𐴔𐴝𐴐𐴢 𐴏𐴡𐴓𐴠𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴅𐴞𐴁𐴌𐴝𐴙𐴓𐴢 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴢 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴌 𐴀𐴡𐴃𐴢 <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴑𐴟𐴖𐴝𐴥𐴌𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴎𐴟𐴌𐴝𐴒𐴝𐴃𐴝𐴤 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴌 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴥𐴘 𐴀𐴡𐴥𐴀𐴙𐴓𐴢. 𐴇𐴠𐴥 𐴑𐴟𐴖𐴝𐴥𐴌𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴕𐴝𐴔 𐴔𐴡𐴌𐴞𐴘𐴝𐴔. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝 𐴇𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔, 𐴃𐴟𐴀𐴛 𐴎𐴞𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠. 𐴔𐴝𐴁𐴟𐴊𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤.“<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴇𐴞𐴥𐴁𐴝 𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴓𐴝𐴁𐴟𐴥𐴓𐴝𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴘𐴞𐴁𐴝𐴤 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴥𐴓𐴝𐴔 𐴇𐴡𐴘 𐴁𐴝𐴥𐴉𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴡𐴌𐴞𐴘𐴝𐴔, 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />𐴉𐴟𐴥𐴕𐴡, 𐴃𐴟𐴀𐴛 𐴇𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴡𐴥𐴘𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴀𐴞𐴏𐴝𐴤 𐴌𐴝𐴑𐴞𐴥𐴁𐴝.<note caller="+" style="f"><char style="fr" closed="false">1‏:31 </char><char style="fq">𐴀𐴞𐴏𐴝𐴤</char> 𐴕𐴝𐴔𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 ”𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝“ 𐴘𐴝𐴥 ”𐴁𐴝𐴏𐴝𐴘𐴓𐴡𐴘𐴝“ </note> <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />𐴀𐴞𐴥𐴁𐴝 𐴔𐴟𐴈𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝<note caller="+" style="f"><char style="fr" closed="false">1‏:32 </char><char style="ft" closed="false">𐴀𐴝𐴓𐴧𐴝 𐴃𐴝𐴥𐴓𐴝 𐴔𐴝𐴀𐴕𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴃𐴡𐴑𐴧𐴝𐴌 𐴀𐴝𐴓𐴧𐴝 </char></note> 𐴃𐴝𐴥𐴓𐴝𐴌 𐴉𐴟𐴖𐴝 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴁𐴡. 𐴔𐴝𐴁𐴟𐴊𐴢 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴉𐴢 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴃𐴡𐴑𐴃𐴡𐴥 𐴊𐴞𐴦𐴁𐴡. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴇𐴡𐴥𐴃𐴡𐴔 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡.“<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴠𐴀𐴕𐴠 𐴀𐴡𐴥𐴘𐴁𐴡؟ 𐴀𐴝𐴀𐴛 𐴊𐴠 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴑𐴟𐴖𐴝𐴥𐴌𐴞.“<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴂𐴝𐴑-𐴌𐴟𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝 𐴃𐴝𐴥𐴓𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴡𐴌 𐴏𐴝𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴖𐴡𐴌𐴠 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴇𐴠𐴥 𐴂𐴝𐴑 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴁𐴡. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />𐴏𐴡𐴀, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴠𐴒𐴝𐴕𐴝 𐴀𐴠𐴓𐴞𐴥𐴎𐴝𐴁𐴠𐴃𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴇𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴌𐴝𐴤 𐴁𐴡𐴐𐴡𐴥𐴃𐴢 𐴉𐴟𐴖𐴝 𐴉𐴠𐴍𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴇𐴞𐴥𐴁𐴝 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴕𐴞𐴑𐴞 𐴁𐴝𐴥𐴎𐴢 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴃𐴡 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴘𐴝𐴓𐴝 𐴏𐴡𐴥 𐴔𐴝𐴐𐴢 𐴏𐴡𐴓𐴠𐴌. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴡 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴃𐴡 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘.“<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />𐴃𐴡𐴥𐴘 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴁𐴝𐴣𐴊𐴞; 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴃𐴟𐴀𐴛 𐴎𐴠𐴀𐴕 𐴈𐴡𐴘𐴧𐴡𐴥 𐴇𐴠𐴥𐴀𐴕 𐴀𐴡𐴥𐴑.“ 𐴁𐴝𐴦𐴊𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝 𐴇𐴞𐴥𐴁𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="LUK 1:38" /></para>
  <para style="s1">𐴀𐴠𐴓𐴞𐴥𐴎𐴝𐴁𐴠𐴃𐴢 𐴓𐴡𐴥𐴘 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴞𐴓𐴃𐴡 𐴒𐴞𐴦𐴘𐴠𐴥</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴕𐴝𐴓𐴢 𐴀𐴡𐴥𐴘 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴉𐴝𐴀𐴌𐴞 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />𐴀𐴝𐴦𐴌 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴀𐴠𐴓𐴞𐴥𐴎𐴝𐴁𐴠𐴃𐴡𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴠. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴠𐴓𐴞𐴥𐴎𐴝𐴁𐴠𐴃𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴠𐴍𐴡𐴃𐴢 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴉𐴝𐴥𐴓𐴊𐴞 𐴀𐴟𐴙𐴄𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴓𐴞𐴥𐴎𐴝𐴁𐴠𐴃𐴢 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴓𐴡𐴥𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴟𐴀𐴛 𐴁𐴠 𐴔𐴟𐴁𐴝𐴌𐴠𐴑, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴠𐴍𐴡𐴌 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴘𐴡𐴥 𐴔𐴟𐴁𐴝𐴌𐴠𐴑! <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴀𐴕 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴑𐴞𐴘𐴝𐴥 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴔𐴝𐴦 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥؟ <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴟𐴥𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴔𐴡𐴃𐴧𐴡𐴌, 𐴀𐴝𐴣𐴀𐴌 𐴉𐴠𐴍𐴡𐴃𐴢 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴉𐴝𐴥𐴓𐴊𐴞 𐴀𐴟𐴙𐴄𐴧𐴠𐴥. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />𐴀𐴟𐴁𐴝𐴤 𐴇𐴡𐴃𐴡𐴥 𐴔𐴟𐴁𐴝𐴌𐴠𐴑, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴔𐴝𐴁𐴟𐴊𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴞𐴀𐴕 𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴡!“<verse eid="LUK 1:45" /></para>
  <para style="s1">𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴡𐴌 𐴒𐴡𐴎𐴡𐴥𐴓𐴢</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠:</para>
  <para style="q1" vid="LUK 1:46">”𐴀𐴝𐴣𐴀𐴌 𐴑𐴡𐴓𐴧𐴡𐴥𐴉𐴠 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴠𐴥𐴌,<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌 𐴌𐴟𐴀 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴣𐴊𐴞𐴌 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴃𐴡𐴑𐴧𐴝𐴌 𐴀𐴟𐴎𐴟 𐴕𐴡𐴎𐴡𐴌 𐴊𐴞𐴘𐴠𐴥,</para>
  <para style="q1" vid="LUK 1:48">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴏𐴡𐴀, 𐴘𐴝𐴓𐴝 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴈𐴡𐴘𐴁𐴡𐴤 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠.<verse eid="LUK 1:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴞𐴁𐴝𐴤 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴔,</para>
  <para style="q2" vid="LUK 1:49">𐴂𐴝𐴑 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔.<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />𐴋𐴡𐴦𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝 𐴌𐴠,</para>
  <para style="q2" vid="LUK 1:50">𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴠-𐴕𐴡𐴏𐴡𐴥𐴓𐴠.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />𐴕𐴞𐴎𐴡𐴌 𐴋𐴟𐴖𐴝𐴥𐴣 𐴓𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥,</para>
  <para style="q2" vid="LUK 1:51">𐴀𐴝𐴦𐴌 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴋𐴡𐴣𐴀𐴌 𐴁𐴝𐴥𐴉𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴐𐴞𐴥𐴣𐴍𐴝𐴐𐴞𐴄𐴧𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡𐴑𐴃𐴡𐴥𐴃𐴧𐴟 𐴓𐴝𐴔𐴝𐴘𐴊𐴞𐴘𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠,</para>
  <para style="q2" vid="LUK 1:52">𐴔𐴡𐴕𐴃𐴡𐴌 𐴖𐴡𐴌𐴡𐴌 𐴃𐴡𐴑𐴧𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴕𐴞𐴌𐴡𐴥𐴐𐴧𐴟𐴥𐴕 𐴀𐴡𐴌𐴠.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />𐴁𐴟𐴥𐴑𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴡𐴔 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴓𐴡𐴥𐴘 𐴁𐴡𐴥𐴌𐴝𐴘𐴊𐴞𐴘𐴠;</para>
  <para style="q2" vid="LUK 1:53">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴝𐴥𐴓𐴞 𐴀𐴝𐴥𐴃𐴠 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞𐴘𐴠𐴥.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥,</para>
  <para style="q2" vid="LUK 1:54">𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴡 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥𐴘𐴡𐴌𐴠,<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴝𐴥𐴑𐴞𐴁𐴡 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠,</para>
  <para style="q2" vid="LUK 1:55">𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠.“<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴃𐴞𐴕 𐴔𐴝𐴐𐴢 𐴇𐴝𐴣𐴏𐴝𐴥𐴇𐴝𐴣𐴏𐴞 𐴀𐴠𐴓𐴞𐴥𐴎𐴝𐴁𐴠𐴃𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞 𐴁𐴝𐴦𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="LUK 1:56" /></para>
  <para style="s1">𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴎𐴡𐴌𐴔𐴡</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴠𐴓𐴞𐴥𐴎𐴝𐴁𐴠𐴃𐴡𐴃𐴧𐴟 𐴉𐴟𐴖𐴝 𐴎𐴡𐴌𐴔𐴡 𐴊𐴞𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />𐴔𐴝𐴁𐴟𐴊𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴒𐴝𐴕𐴝-𐴒𐴟𐴙𐴐𐴧𐴞𐴥𐴘𐴠 𐴉𐴟𐴥𐴕𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴐𐴄𐴡 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴝𐴥𐴘𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴕𐴝𐴔 𐴁𐴝𐴉𐴡𐴌 𐴕𐴝𐴔𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝 𐴌𐴝𐴑𐴞𐴥𐴃𐴡 𐴏𐴝𐴀𐴙𐴓𐴢. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴕𐴡, 𐴀𐴞𐴃𐴝𐴌 𐴕𐴝𐴔 𐴌𐴝𐴑𐴝𐴤 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝.“<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴠𐴒𐴝𐴕𐴝-𐴒𐴟𐴙𐴐𐴧𐴞𐴥𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴕𐴝𐴔 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴕𐴝𐴥𐴘.“<verse eid="LUK 1:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 1:62" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴉𐴡𐴌𐴠 𐴀𐴞𐴐𐴝𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥, 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴕𐴝𐴔 𐴑𐴞𐴦 𐴌𐴝𐴑𐴞𐴥𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴊𐴠 𐴏𐴝𐴀𐴙𐴓𐴢. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴓𐴠𐴑𐴞𐴥𐴁𐴝𐴌 𐴏𐴞𐴎𐴢 𐴔𐴝𐴒𐴝𐴘𐴧𐴡𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, ”𐴃𐴝𐴌 𐴕𐴝𐴔 𐴘𐴝𐴇𐴝𐴥𐴘𐴝.“ 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />𐴀𐴝𐴦𐴌 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴟𐴦 𐴑𐴟𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴌 𐴀𐴠𐴌𐴞𐴊𐴞𐴘𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴔𐴝𐴃𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴌 𐴉𐴝𐴀𐴌𐴞 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝𐴃𐴢 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴖𐴝𐴤𐴇𐴡𐴘 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥 𐴈𐴡𐴃𐴝𐴤 𐴒𐴟𐴥𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴌𐴝𐴑𐴞𐴥 𐴁𐴝𐴥𐴉𐴠𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡؟“ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 1:66" /></para>
  <para style="s1">𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴉𐴢 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝𐴘𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴓𐴡𐴥𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠:<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />”𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴔𐴝𐴁𐴟𐴊𐴢 𐴀𐴝𐴓𐴧𐴝𐴌,</para>
  <para style="q2" vid="LUK 1:68">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴎𐴠 𐴁𐴡𐴕𐴊𐴝 𐴀𐴞𐴥𐴁𐴝𐴌.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴀𐴡𐴃𐴧𐴟</para>
  <para style="q2" vid="LUK 1:69">𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴃𐴟𐴙𐴓𐴧𐴠𐴥,<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴈𐴡𐴀𐴙𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴂𐴝𐴑 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴑𐴠𐴥;<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴝𐴏𐴝 𐴎𐴝𐴘𐴁𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴃𐴧𐴟</para>
  <para style="q2" vid="LUK 1:71">𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴀𐴡𐴃𐴧𐴟;<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝</para>
  <para style="q2" vid="LUK 1:72">𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴂𐴝𐴑 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴌𐴠 𐴘𐴝𐴦𐴊𐴢 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝,<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />𐴘𐴝𐴥𐴕𐴞 𐴏𐴡𐴥𐴀𐴕 𐴖𐴝𐴀𐴕𐴡𐴌𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔 𐴓𐴡𐴥𐴘,<verse eid="LUK 1:73" /></para>
  <para style="q2">
    <verse number="74" style="v" sid="LUK 1:74" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘 𐴇𐴡𐴕𐴡𐴤</para>
  <para style="q2" vid="LUK 1:74">𐴋𐴡𐴦𐴌 𐴏𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴁𐴝𐴘𐴃𐴡𐴥,<verse eid="LUK 1:74" /></para>
  <para style="q2">
    <verse number="75" style="v" sid="LUK 1:75" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴂𐴝𐴑𐴞 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴁𐴡𐴥𐴌.<verse eid="LUK 1:75" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />”𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝, 𐴃𐴡𐴌𐴠𐴥 𐴋𐴝𐴈𐴝 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝 𐴃𐴝𐴥𐴓𐴝𐴌 𐴕𐴡𐴁𐴞,</para>
  <para style="q2" vid="LUK 1:76">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴘 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴌𐴝𐴏𐴃𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠-𐴀𐴝𐴒𐴠 𐴎𐴝𐴘𐴁𐴞,<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />𐴎𐴝𐴘 𐴃𐴟𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴉𐴝𐴘𐴧𐴡𐴌𐴠</para>
  <para style="q2" vid="LUK 1:77">𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴝𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴊𐴞𐴁𐴞,<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴠</para>
  <para style="q2" vid="LUK 1:78">𐴖𐴡𐴃𐴧𐴟𐴥 𐴁𐴠𐴙𐴓𐴡𐴌 𐴉𐴡𐴀𐴌 𐴀𐴝𐴘𐴁𐴡𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠,<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />𐴉𐴡𐴀𐴌 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴌𐴠</para>
  <para style="q2" vid="LUK 1:79">𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴦𐴃𐴡𐴌 𐴏𐴝𐴥𐴁𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤<note caller="+" style="f"><char style="fr" closed="false">1‏:79 </char><char style="ft" closed="false">𐴔𐴝𐴀𐴕𐴞 𐴔𐴡𐴌𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤</char></note>,</para>
  <para style="q2" vid="LUK 1:79">𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴌𐴝𐴏𐴃𐴝𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴉𐴝𐴃𐴝 𐴌𐴠.“<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />𐴁𐴝𐴦𐴊𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴠𐴊𐴧𐴠 𐴌𐴟𐴀𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴊𐴝𐴈𐴝𐴤 𐴕𐴡𐴥 𐴊𐴠𐴥 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴘𐴊𐴝𐴕 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴡𐴌𐴔𐴡</para>
  <para style="r">(<ref loc="MAT 1:18-25">𐴔𐴡𐴃𐴢 1‏:18‏-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴌𐴡𐴔𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴝𐴒𐴝𐴥𐴏𐴃𐴝𐴏𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴇𐴡𐴥𐴑𐴟𐴔 𐴎𐴝𐴌𐴞 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴟𐴌𐴝 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴏𐴠𐴌𐴝𐴥𐴚 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />𐴘𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴡𐴀𐴘𐴓𐴝𐴁𐴝𐴌𐴡𐴌 𐴏𐴠𐴌𐴝𐴥𐴚, 𐴎𐴞𐴁𐴝𐴤 𐴑𐴟𐴌𐴞𐴕𐴞𐴀𐴝𐴏𐴢 𐴏𐴞𐴀𐴌𐴞𐴘𐴝 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴌 𐴇𐴝𐴥𐴑𐴞𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />𐴃𐴡𐴥𐴘 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴕𐴝𐴔 𐴓𐴠𐴑𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴎𐴝𐴌-𐴎𐴝𐴌 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴠𐴦-𐴃𐴠𐴦 𐴎𐴝𐴦𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴞𐴓𐴢.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴀𐴡𐴥 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴐𐴡𐴥𐴀𐴌 𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞, 𐴖𐴡𐴌𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴐𐴡𐴥𐴀𐴌 𐴁𐴠𐴃𐴠𐴥𐴓𐴈𐴠𐴔 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴀𐴡𐴃𐴧𐴟. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />𐴇𐴠𐴥𐴍𐴠 𐴒𐴞𐴦𐴘𐴠𐴥 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴎𐴟𐴙𐴅𐴧𐴝 𐴁𐴡𐴖𐴢 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴝𐴔 𐴓𐴠𐴑𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝; 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴇𐴞𐴥𐴁𐴝 𐴇𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴠, 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴖𐴝 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴊𐴞𐴕 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />𐴃𐴡𐴥𐴘 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴀𐴘𐴓𐴝-𐴉𐴟𐴖𐴝 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝 𐴎𐴡𐴌𐴔𐴡 𐴊𐴞𐴘𐴠𐴥. 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴇𐴡𐴦𐴌 𐴁𐴠𐴌𐴝𐴤𐴘 𐴇𐴝𐴥𐴕𐴋𐴝𐴙𐴓𐴡𐴃𐴢<note caller="+" style="f"><char style="fr" closed="false">2‏:7 </char><char style="fqa">𐴇𐴝𐴥𐴕𐴋𐴝𐴙𐴓𐴢</char> <char style="ft" closed="false">𐴔𐴝𐴀𐴕𐴞 𐴒𐴡𐴌𐴟-𐴔𐴟𐴐𐴡𐴌𐴠 𐴀𐴝𐴊𐴝𐴤𐴌 𐴊𐴠𐴦 𐴊𐴠 𐴃𐴝𐴥𐴌𐴝</char></note> 𐴕𐴠𐴍𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴔𐴟𐴏𐴝𐴥𐴉𐴠𐴌-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴎𐴝𐴒𐴝 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 2:7" /></para>
  <para style="s1">𐴏𐴡𐴥𐴀𐴓𐴢-𐴏𐴡𐴌𐴡𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />𐴇𐴠𐴥 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴇𐴡𐴊𐴟𐴥𐴕 𐴏𐴡𐴥𐴀𐴓𐴢-𐴏𐴡𐴌𐴡𐴘𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴌𐴝𐴙𐴃𐴧𐴝 𐴑𐴞𐴥𐴓𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴎𐴝𐴥𐴑 𐴏𐴡𐴦𐴛 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />𐴀𐴝𐴏𐴞𐴔𐴁𐴞𐴃𐴢 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴀𐴠𐴑 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴏𐴡𐴙𐴔𐴑𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘, <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴝𐴙𐴕𐴧𐴞𐴤, 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />𐴀𐴝𐴙𐴅𐴧𐴝 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴧𐴠; 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴇𐴠𐴥 𐴔𐴝𐴓𐴞𐴑. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠 𐴕𐴞𐴐𐴝𐴥𐴕𐴠 𐴏𐴞𐴕𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥: 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴊𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴇𐴡𐴦𐴌 𐴁𐴠𐴌𐴝𐴤𐴘𐴧𐴝, 𐴀𐴟𐴌𐴝𐴌 𐴇𐴝𐴥𐴕𐴋𐴝𐴙𐴓𐴡𐴃𐴢 𐴕𐴠𐴍𐴝𐴘𐴧𐴝 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴁𐴝.“<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴠𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴞𐴔𐴁𐴞𐴃𐴢 𐴀𐴠𐴑 𐴎𐴝𐴥𐴑 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴉𐴡𐴥𐴗𐴏𐴢 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠, 𐴎𐴞𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠,<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />”𐴀𐴠𐴁𐴧𐴠 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑,</para>
  <para style="q2" vid="LUK 2:14">𐴀𐴝𐴦𐴌 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴑𐴟𐴥𐴐𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴡𐴥𐴑.“<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴒𐴟𐴥𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴡𐴥𐴘 𐴌𐴝𐴥𐴌, 𐴏𐴡𐴥𐴀𐴓𐴢-𐴏𐴡𐴌𐴡𐴘𐴝 𐴒𐴟𐴥𐴕𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴃𐴠𐴥𐴓𐴈𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴘, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴁𐴡𐴥𐴓𐴞 𐴔𐴝𐴁𐴟𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴝𐴀𐴘𐴒𐴡𐴘.“<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴀𐴝𐴀𐴘𐴢 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴇𐴝𐴥𐴕𐴋𐴝𐴙𐴓𐴡𐴃𐴢 𐴕𐴠𐴍𐴝𐴘𐴧𐴝 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴞𐴀𐴕 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴠𐴥. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴀𐴓𐴢-𐴏𐴡𐴌𐴡𐴘𐴝 𐴒𐴟𐴥𐴕𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴎𐴠𐴊𐴟𐴥𐴕𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴊𐴞𐴓𐴡𐴃𐴢 𐴒𐴝𐴣𐴃𐴞𐴥 𐴌𐴝𐴑𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴥𐴉𐴞-𐴁𐴝𐴥𐴉𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />𐴏𐴡𐴥𐴀𐴓𐴢-𐴏𐴡𐴌𐴡𐴘𐴝 𐴒𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴔𐴟𐴃𐴝𐴉𐴠𐴑 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="LUK 2:20" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴕𐴝𐴔 𐴌𐴝𐴙𐴑𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />𐴀𐴝𐴣𐴐𐴄𐴡 𐴊𐴞𐴕 𐴉𐴟𐴌𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴝𐴥𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴀𐴞𐴏𐴝𐴤 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴠 𐴕𐴝𐴔 𐴔𐴝𐴥𐴕 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝 𐴉𐴠𐴍𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴊𐴞𐴀𐴓𐴢.<verse eid="LUK 2:21" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴀𐴝𐴙𐴕𐴧𐴠𐴤</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴟𐴀𐴏𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴊𐴞𐴕 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴖𐴡𐴌𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, ”𐴉𐴡𐴀𐴘𐴓𐴝 𐴉𐴟𐴖𐴝 𐴎𐴡𐴊𐴞 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴁𐴟𐴊𐴡𐴓𐴧𐴝 𐴂𐴝𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.“<note caller="+" style="f"><char style="fr" closed="false">2‏:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 13:2">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 13‏:2</ref>‏,<ref loc="EXO 13:12">12</ref></char></char></note> <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴡 𐴔𐴡𐴎𐴞𐴕 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴀𐴠𐴑 𐴎𐴟𐴌 𐴈𐴡𐴀𐴣𐴓𐴢 𐴘𐴝𐴥 𐴊𐴟𐴖𐴝𐴥 𐴈𐴡𐴘𐴃𐴡𐴌𐴡𐴌 𐴁𐴝𐴏𐴝.“<note caller="+" style="f"><char style="fr" closed="false">2‏:24 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 12:8">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 12‏:8</ref></char></char></note><verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴇𐴠𐴥𐴍𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴏𐴞𐴥𐴔𐴞𐴘𐴡𐴕 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴞𐴕𐴊𐴝𐴥𐴌, 𐴎𐴞𐴁𐴝𐴤 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴊𐴠𐴑𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴡𐴦𐴃𐴢 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴁𐴝𐴉𐴔𐴝𐴦𐴘𐴠 𐴒𐴟𐴌𐴝 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴔𐴡𐴎𐴞𐴕 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />𐴏𐴞𐴥𐴔𐴞𐴘𐴡𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴉𐴝𐴃𐴝𐴥𐴙𐴅𐴧𐴝 𐴑𐴟𐴓𐴡𐴃𐴢 𐴓𐴡𐴦𐴘𐴢 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥:<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴟𐴃𐴝𐴉𐴠𐴑<note caller="+" style="f"><char style="fr" closed="false">2‏:29 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴖𐴝𐴦𐴊𐴝 𐴔𐴡𐴎𐴞𐴕</char></note></para>
  <para style="q2" vid="LUK 2:29">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴟𐴓𐴝𐴔𐴡𐴌𐴠 𐴘𐴝𐴓𐴝 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴝𐴘𐴃𐴡 𐴊𐴡𐴌,<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴏𐴟𐴑𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴠𐴅𐴝𐴃𐴢 𐴊𐴠𐴑𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴀𐴛 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴟𐴌,</para>
  <para style="q2" vid="LUK 2:32">𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴡𐴗𐴔 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴀𐴞𐴎𐴧𐴡𐴃𐴢.“<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴞𐴀𐴕 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />𐴁𐴝𐴦𐴊𐴠 𐴏𐴞𐴥𐴔𐴞𐴘𐴡𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴟𐴖𐴝 𐴊𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴖𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴓𐴞𐴤 𐴁𐴡𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡, <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />𐴎𐴠𐴀𐴕𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴊𐴞𐴓𐴡𐴌 𐴑𐴡𐴓𐴉𐴡𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴡𐴓𐴧𐴡𐴥𐴉𐴢 𐴀𐴡𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴌𐴞 𐴓𐴡𐴥𐴘 𐴒𐴝𐴣𐴃𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.“<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴐𐴠𐴌𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴌 𐴀𐴝𐴕𐴧𐴝 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴔𐴁𐴞𐴘𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴉𐴝𐴕𐴟𐴀𐴠𐴓𐴡𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝. 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴁𐴡𐴐𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘, 𐴇𐴞𐴥𐴁𐴝 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴝𐴥𐴣𐴃𐴢 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴠 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢, <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />𐴁𐴝𐴦𐴊𐴠 𐴓𐴡𐴥𐴃𐴞 𐴌𐴝𐴌𐴞𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴃𐴠𐴥-𐴈𐴝𐴍𐴝𐴘𐴃𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴐𐴢 𐴀𐴝𐴐𐴞𐴤-𐴏𐴝𐴙𐴌 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠. 𐴇𐴞𐴥𐴁𐴝 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴔𐴞𐴑𐴧𐴝𐴥 𐴕𐴡 𐴎𐴝𐴘𐴃𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴘𐴃𐴠 𐴊𐴞𐴕𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴡. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴞𐴥𐴁𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴀𐴝𐴎𐴝𐴊𐴞𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 2:38" /></para>
  <para style="s1">𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴞</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴔𐴟𐴃𐴝𐴉𐴠𐴑 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴕𐴞𐴎𐴡𐴌 𐴐𐴡𐴥𐴀𐴌 𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />𐴁𐴝𐴦𐴊𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴒𐴞𐴘𐴝𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 2:40" /></para>
  <para style="s1">𐴁𐴝𐴌𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌𐴅𐴝 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴀𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴉𐴔𐴝𐴦 𐴉𐴡𐴃𐴧𐴞𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴓𐴧𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴘𐴃𐴡. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴁𐴝𐴌𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥 𐴕𐴞𐴘𐴡𐴔 𐴔𐴡𐴎𐴞𐴕 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴊𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />𐴀𐴞𐴊𐴢 𐴉𐴟𐴥𐴌𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴌𐴒𐴡𐴘 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴃𐴝𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴘𐴠 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴑 𐴊𐴞𐴕𐴡𐴌 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴀𐴠𐴒𐴝𐴕𐴝-𐴒𐴟𐴙𐴐𐴧𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴕𐴉𐴡𐴌𐴞𐴏𐴡 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴖𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴖𐴝𐴘 𐴕𐴡𐴥 𐴉𐴝𐴦, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴖𐴝𐴘-𐴃𐴟𐴖𐴝𐴘 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />𐴃𐴞𐴕 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴝𐴎𐴠𐴥 𐴁𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴠𐴌 𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴝-𐴏𐴟𐴥𐴖𐴝𐴓𐴞 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴎𐴝𐴥𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴔𐴝𐴦𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡 𐴉𐴟𐴃𐴢, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴞𐴘𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴡𐴥؟ 𐴏𐴡𐴀𐴏𐴝𐴘, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴉𐴢 𐴓𐴡𐴘 𐴀𐴝𐴀𐴛 𐴓𐴡𐴘 𐴏𐴞𐴕𐴃𐴝 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴃𐴟𐴖𐴝𐴃𐴢 𐴀𐴝𐴏𐴞𐴤.“<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴖𐴡𐴀𐴌 𐴑𐴞𐴘𐴝𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 𐴊𐴠𐴥؟“</char> <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡𐴥 𐴁𐴟𐴎𐴠𐴥.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴝𐴐𐴝𐴥 𐴓𐴡𐴥𐴘 𐴕𐴞𐴏𐴠 𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴝𐴕𐴞 𐴏𐴡𐴙𐴓𐴧𐴞𐴥𐴓𐴢. 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦𐴘𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴒𐴝𐴣𐴃𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 2:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 2:52" />𐴀𐴞𐴏𐴝𐴤 𐴒𐴞𐴘𐴝𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴒𐴝𐴦𐴉𐴞𐴍𐴠𐴥, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s1">𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑</para>
  <para style="r">(<ref loc="MAT 3:1-12">𐴔𐴡𐴃𐴢 3‏:1‏-12</ref>; <ref loc="MRK 1:1-8">𐴔𐴝𐴑 1‏:1‏-8</ref>; <ref loc="JHN 1:19-28">𐴘𐴡 1‏:19‏-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />𐴃𐴞𐴁𐴞𐴌𐴞𐴘𐴟𐴏𐴢 𐴑𐴝𐴥𐴘𐴏𐴝𐴌𐴡𐴌<note caller="+" style="f"><char style="fr" closed="false">3‏:1 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑𐴡𐴃𐴢 𐴑𐴝𐴥𐴘𐴏𐴝𐴌 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴝𐴔 𐴕𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴡𐴔 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴡𐴑𐴡𐴥𐴁𐴢. </char></note> 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴉𐴟𐴕𐴊𐴡𐴥𐴌𐴡 𐴁𐴡𐴏𐴡𐴥𐴌 𐴏𐴡𐴓𐴠𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴂𐴡𐴕𐴃𐴞𐴘𐴟𐴏𐴢 𐴉𐴞𐴓𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴌 𐴇𐴝𐴥𐴑𐴞𐴔, 𐴀𐴝𐴦𐴌 𐴈𐴠𐴥𐴌𐴟𐴊𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴥𐴘 𐴉𐴞𐴓𐴞𐴥𐴂𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴃𐴟𐴥𐴌𐴞𐴘𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴌𐴝𐴑𐴡𐴕𐴞𐴃𐴞𐴏𐴢 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, 𐴓𐴝𐴘𐴏𐴠𐴥𐴕𐴞𐴘𐴝𐴏𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴝𐴁𐴞𐴓𐴠𐴕𐴞𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴝𐴥𐴕𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴑𐴝𐴥𐴘𐴧𐴝𐴉𐴝𐴏𐴢, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴔𐴡𐴘𐴊𐴝𐴕 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝𐴌 𐴉𐴟𐴖𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴢 𐴎𐴝𐴘 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, 𐴒𐴟𐴕𐴝𐴤𐴌 𐴔𐴝𐴉𐴢 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴃𐴡. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴌 𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤:</para>
  <para style="q1" vid="LUK 3:4">”𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌,</para>
  <para style="q1" vid="LUK 3:4">’𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴉𐴡𐴣𐴃𐴢 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴡𐴤,</para>
  <para style="q2" vid="LUK 3:4">𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴏𐴃𐴝 𐴀𐴟𐴎𐴟 𐴒𐴡𐴌𐴡𐴤.<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />𐴉𐴡𐴃𐴧𐴞𐴥 𐴒𐴟𐴥𐴕𐴝 𐴁𐴡𐴥𐴌𐴝 𐴎𐴝𐴘𐴁𐴡,</para>
  <para style="q2" vid="LUK 3:5">𐴉𐴡𐴃𐴧𐴞𐴥 𐴉𐴝𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴝𐴤 𐴉𐴟𐴥𐴖𐴝𐴕 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.</para>
  <para style="q1" vid="LUK 3:5">𐴁𐴠𐴈𐴝𐴣𐴏𐴟𐴥𐴌𐴝 𐴉𐴡𐴣𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴟𐴎𐴟 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡,</para>
  <para style="q2" vid="LUK 3:5">𐴄𐴠𐴀𐴘𐴓𐴝𐴔𐴠𐴘𐴓𐴝 𐴌𐴝𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴥𐴖𐴝𐴕 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡,<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />𐴀𐴝𐴦𐴌 𐴉𐴟𐴌𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴎𐴝𐴃𐴞𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴠𐴅𐴝𐴃𐴢 𐴊𐴠𐴑𐴞𐴥𐴁𐴡.‘ “<note caller="+" style="f"><char style="fr" closed="false">3‏:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3-5">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 40‏:3‏-5</ref></char></char></note><verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴇𐴝𐴥𐴉𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢! 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴃𐴧𐴟 𐴊𐴝𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘 𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴞𐴥𐴘𐴠؟ <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />𐴃𐴡𐴖𐴝𐴥 𐴓𐴡𐴥𐴘 𐴔𐴞𐴓𐴢 𐴇𐴝𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴡𐴥𐴌𐴡, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴕𐴡 𐴊𐴡𐴙𐴅𐴧𐴡 𐴊𐴠 𐴑𐴞, ’𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴃𐴡 𐴁𐴝𐴉𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔 𐴀𐴝𐴏𐴠𐴤.‘ 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴏𐴝𐴘𐴓𐴠𐴥 𐴀𐴠 𐴐𐴞𐴥𐴓𐴢 𐴓𐴟𐴕𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴓𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />𐴀𐴝𐴦𐴌 𐴀𐴠𐴇𐴡𐴥𐴕 𐴃𐴡 𐴒𐴝𐴏𐴡𐴌 𐴒𐴟𐴌𐴝𐴃𐴢 𐴑𐴟𐴌𐴡𐴥𐴙𐴓𐴢 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴘𐴠. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠 𐴒𐴝𐴏𐴡𐴃𐴢 𐴒𐴡𐴔 𐴒𐴟𐴓𐴝 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠, 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴝𐴍𐴞 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.“<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴑𐴞𐴦 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌؟“<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴝𐴃𐴧𐴟 𐴊𐴟𐴖𐴝𐴥 𐴑𐴟𐴌𐴟𐴃𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴊𐴡𐴦, 𐴀𐴝𐴦𐴌 𐴎𐴝𐴃𐴧𐴟 𐴈𐴝𐴥𐴕𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤.“<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴥𐴎𐴟𐴌, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴑𐴞𐴦 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌؟“<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴙𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴝𐴌𐴝𐴤𐴘 𐴕𐴡 𐴓𐴡𐴘𐴧𐴡.“<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴝𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴑𐴞𐴦 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌؟“</para>
  <para style="p" vid="LUK 3:14">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴑𐴞𐴘𐴡𐴥𐴃𐴧𐴟 𐴊𐴡𐴥𐴔𐴑𐴞 𐴊𐴞𐴥 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴓𐴡𐴘𐴧𐴡, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴖𐴡𐴌𐴠 𐴔𐴞𐴏𐴝𐴥 𐴀𐴠𐴓𐴎𐴝𐴔 𐴕𐴡 𐴓𐴝𐴒𐴝𐴘𐴧𐴡𐴥, 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴓𐴡𐴘 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴡.“<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕 𐴀𐴝𐴐𐴝𐴤𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴥𐴉𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴘 𐴕𐴠𐴥 𐴕𐴡, <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴀𐴠𐴥𐴕𐴝 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴞𐴁𐴝𐴤𐴌 𐴃𐴡𐴑𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴘𐴧𐴠𐴤𐴌; 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴠𐴕𐴄𐴝𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴃𐴝 𐴑𐴟𐴥𐴓𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴦𐴙𐴕 𐴓𐴡𐴘 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴁𐴡. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴓𐴝 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴣𐴓𐴝𐴌𐴠 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴒𐴡𐴌𐴞 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴞𐴣𐴘𐴟 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴡𐴓𐴝𐴒𐴡𐴌𐴞𐴥 𐴒𐴟𐴊𐴝𐴔𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴟𐴖𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴕𐴞𐴉𐴠𐴥 𐴊𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴟𐴌𐴝𐴃𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡.“<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" />𐴓𐴠𐴑𐴞𐴕 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌 𐴁𐴡𐴖𐴢 𐴈𐴠𐴥𐴌𐴟𐴊𐴞𐴀𐴝𐴏𐴡𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴠 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴡𐴥𐴄𐴁𐴡𐴍𐴝𐴥𐴘𐴧𐴠, <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴠𐴥 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴝𐴌𐴝𐴤𐴘𐴧𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥.<verse eid="LUK 3:20" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝</para>
  <para style="r">(<ref loc="MAT 3:13-17">𐴔𐴡𐴃𐴢 3‏:13‏-17</ref>; <ref loc="MRK 1:9-11">𐴔𐴝𐴑 1‏:9‏-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴧𐴠𐴥, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴧𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴏𐴔𐴝𐴕 𐴑𐴟𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />𐴀𐴝𐴦𐴌 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴈𐴡𐴘𐴃𐴡𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴓𐴝𐴔𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴀𐴝𐴦𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴓𐴡𐴥𐴘 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞.“<verse eid="LUK 3:22" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴞𐴏𐴧𐴝𐴥𐴕</para>
  <para style="r">(<ref loc="MAT 1:1-17">𐴔𐴡𐴃𐴢 1‏:1‏-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴔 𐴒𐴡𐴌𐴝𐴥 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴐𐴢 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴃𐴞𐴌𐴞𐴥𐴐𐴢 𐴁𐴡𐴏𐴡𐴥𐴌; 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴄𐴝𐴥𐴀𐴙𐴃𐴧𐴡 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌 𐴉𐴟𐴖𐴝.</para>
  <para style="li1" vid="LUK 3:23">𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴠𐴥𐴓𐴞𐴌 𐴉𐴟𐴖𐴝. <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />𐴇𐴠𐴥𐴓𐴞 𐴔𐴝𐴃𐴧𐴝𐴥𐴃𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:24">𐴔𐴝𐴃𐴧𐴝𐴥𐴃𐴢 𐴓𐴠𐴀𐴜𐴞𐴌 𐴉𐴟𐴖𐴝, 𐴓𐴠𐴀𐴜𐴞 𐴔𐴠𐴓𐴑𐴞𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:24">𐴔𐴠𐴓𐴑𐴞 𐴅𐴝𐴕𐴧𐴝𐴙𐴌 𐴉𐴟𐴖𐴝, 𐴅𐴝𐴕𐴧𐴝𐴘 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌 𐴉𐴟𐴖𐴝,<verse eid="LUK 3:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="LUK 3:25" />𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴔𐴝𐴃𐴧𐴝𐴃𐴞𐴥𐴘𐴝𐴏𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴔𐴝𐴃𐴧𐴝𐴃𐴞𐴥𐴘𐴝𐴏𐴢 𐴀𐴝𐴥𐴔𐴡𐴏𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:25">𐴀𐴝𐴥𐴔𐴡𐴏𐴢 𐴕𐴝𐴇𐴟𐴔𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴕𐴝𐴇𐴟𐴔 𐴀𐴠𐴏𐴝𐴥𐴓𐴞𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:25">𐴀𐴠𐴏𐴝𐴥𐴓𐴞 𐴕𐴝𐴒𐴧𐴝𐴙𐴌 𐴉𐴟𐴖𐴝, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />𐴕𐴝𐴒𐴧𐴝𐴘 𐴔𐴝𐴀𐴃𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:26">𐴔𐴝𐴀𐴃𐴢 𐴔𐴝𐴃𐴧𐴝𐴃𐴞𐴥𐴘𐴝𐴏𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴔𐴝𐴃𐴧𐴝𐴃𐴞𐴥𐴘𐴝𐴏𐴢 𐴏𐴠𐴥𐴔𐴞𐴘𐴞𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:26">𐴏𐴠𐴥𐴔𐴞𐴘𐴞 𐴅𐴡𐴏𐴠𐴥𐴑𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴅𐴡𐴏𐴠𐴥𐴑 𐴅𐴡𐴊𐴝𐴌 𐴉𐴟𐴖𐴝,<verse eid="LUK 3:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="LUK 3:27" />𐴅𐴡𐴊𐴝 𐴅𐴡𐴀𐴝𐴕𐴧𐴝𐴌 𐴉𐴟𐴖𐴝, 𐴅𐴡𐴀𐴝𐴕𐴧𐴝 𐴌𐴠𐴏𐴝𐴥𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:27">𐴌𐴠𐴏𐴝𐴥 𐴎𐴠𐴌𐴟𐴁𐴝𐴁𐴠𐴓𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴎𐴠𐴌𐴟𐴁𐴝𐴁𐴠𐴓𐴢 𐴐𐴝𐴥𐴓𐴃𐴞𐴘𐴠𐴓𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:27">𐴐𐴝𐴥𐴓𐴃𐴞𐴘𐴠𐴓𐴢 𐴕𐴠𐴌𐴞𐴌 𐴉𐴟𐴖𐴝, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />𐴕𐴠𐴌𐴞 𐴔𐴠𐴓𐴑𐴞𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:28">𐴔𐴠𐴓𐴑𐴞 𐴀𐴝𐴊𐴧𐴞𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴊𐴧𐴞 𐴑𐴡𐴏𐴝𐴥𐴔𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:28">𐴑𐴡𐴏𐴝𐴥𐴔 𐴀𐴠𐴓𐴔𐴝𐴊𐴡𐴔𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴠𐴓𐴔𐴝𐴊𐴡𐴔 𐴀𐴠𐴌𐴡𐴌 𐴉𐴟𐴖𐴝,<verse eid="LUK 3:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="LUK 3:29" />𐴀𐴠𐴌 𐴘𐴠𐴈𐴡𐴥𐴐𐴟𐴖𐴝𐴌 𐴉𐴟𐴖𐴝, 𐴘𐴠𐴈𐴡𐴥𐴐𐴟𐴖𐴝 𐴀𐴠𐴓𐴞𐴘𐴝𐴎𐴝𐴌𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:29">𐴀𐴠𐴓𐴞𐴘𐴝𐴎𐴝𐴌 𐴅𐴡𐴌𐴞𐴔𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴅𐴡𐴌𐴞𐴔 𐴔𐴝𐴃𐴧𐴝𐴥𐴃𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:29">𐴔𐴝𐴃𐴧𐴝𐴥𐴃𐴢 𐴓𐴠𐴀𐴜𐴞𐴌 𐴉𐴟𐴖𐴝, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />𐴓𐴠𐴀𐴜𐴞 𐴏𐴞𐴥𐴔𐴞𐴘𐴡𐴕𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:30">𐴏𐴞𐴥𐴔𐴞𐴘𐴡𐴕 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌 𐴉𐴟𐴖𐴝, 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:30">𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴅𐴡𐴕𐴝𐴔𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴅𐴡𐴕𐴝𐴔 𐴀𐴠𐴓𐴞𐴘𐴝𐴑𐴞𐴥𐴔𐴡𐴌 𐴉𐴟𐴖𐴝,<verse eid="LUK 3:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="LUK 3:31" />𐴀𐴠𐴓𐴞𐴘𐴝𐴑𐴞𐴥𐴔 𐴔𐴝𐴓𐴠𐴘𐴝𐴌 𐴉𐴟𐴖𐴝, 𐴔𐴝𐴓𐴠𐴘𐴝 𐴔𐴞𐴕𐴧𐴝𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:31">𐴔𐴞𐴕𐴧𐴝 𐴔𐴝𐴃𐴧𐴝𐴥𐴃𐴝𐴌 𐴉𐴟𐴖𐴝, 𐴔𐴝𐴃𐴧𐴝𐴥𐴃𐴝 𐴕𐴝𐴃𐴝𐴕𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:31">𐴕𐴝𐴃𐴝𐴕 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />𐴊𐴝𐴖𐴟𐴊𐴢 𐴅𐴠𐴏𐴞𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:32">𐴅𐴠𐴏𐴞 𐴀𐴡𐴁𐴠𐴊𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴡𐴁𐴠𐴊𐴢 𐴁𐴡𐴀𐴝𐴎𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:32">𐴁𐴡𐴀𐴝𐴎𐴢 𐴏𐴝𐴥𐴓𐴔𐴡𐴕𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴏𐴝𐴥𐴓𐴔𐴡𐴕 𐴕𐴝𐴐𐴡𐴕𐴡𐴌 𐴉𐴟𐴖𐴝,<verse eid="LUK 3:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="LUK 3:33" />𐴕𐴝𐴐𐴡𐴕 𐴀𐴝𐴔𐴧𐴞𐴕𐴝𐴊𐴝𐴁𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴔𐴧𐴞𐴕𐴝𐴊𐴝𐴁𐴢 𐴀𐴝𐴊𐴔𐴞𐴕𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:33">𐴀𐴝𐴊𐴔𐴞𐴕 𐴀𐴝𐴌𐴕𐴞𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴌𐴕𐴞 𐴇𐴞𐴏𐴌𐴡𐴕𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:33">𐴇𐴞𐴏𐴌𐴡𐴕 𐴉𐴝𐴌𐴠𐴏𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴉𐴝𐴌𐴠𐴏𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌 𐴉𐴟𐴖𐴝,<verse eid="LUK 3:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="LUK 3:34" />𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:34">𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔 𐴃𐴠𐴥𐴌𐴝𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:34">𐴃𐴠𐴥𐴌𐴝 𐴕𐴝𐴇𐴡𐴌𐴡𐴌 𐴉𐴟𐴖𐴝, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />𐴕𐴝𐴇𐴡𐴌 𐴏𐴠𐴥𐴌𐴟𐴚𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:35">𐴏𐴠𐴥𐴌𐴟𐴚 𐴌𐴝𐴀𐴟𐴌 𐴉𐴟𐴖𐴝, 𐴌𐴝𐴀𐴟 𐴉𐴝𐴓𐴠𐴑𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:35">𐴉𐴝𐴓𐴠𐴑 𐴀𐴠𐴁𐴠𐴌𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴠𐴁𐴠𐴌 𐴐𐴞𐴥𐴓𐴝𐴌 𐴉𐴟𐴖𐴝,<verse eid="LUK 3:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="LUK 3:36" />𐴐𐴞𐴥𐴓𐴝 𐴑𐴠𐴥𐴘𐴕𐴝𐴕𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴑𐴠𐴥𐴘𐴕𐴝𐴕 𐴀𐴝𐴌𐴉𐴝𐴑𐴐𐴝𐴥𐴊𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:36">𐴀𐴝𐴌𐴉𐴝𐴑𐴐𐴝𐴥𐴊𐴢 𐴐𐴠𐴀𐴔𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴐𐴠𐴀𐴔 𐴕𐴟𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:36">𐴕𐴟 𐴓𐴝𐴔𐴝𐴑𐴡𐴌 𐴉𐴟𐴖𐴝, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />𐴓𐴝𐴔𐴝𐴑 𐴔𐴝𐴃𐴟𐴥𐴐𐴞𐴓𐴝𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:37">𐴔𐴝𐴃𐴟𐴥𐴐𐴞𐴓𐴝 𐴀𐴞𐴊𐴞𐴌𐴞𐴏𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴞𐴊𐴞𐴌𐴞𐴏𐴢 𐴅𐴝𐴌𐴠𐴊𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:37">𐴅𐴝𐴌𐴠𐴊𐴢 𐴔𐴝𐴇𐴝𐴥𐴓𐴝𐴓𐴠𐴓𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴔𐴝𐴇𐴝𐴥𐴓𐴝𐴓𐴠𐴓𐴢 𐴑𐴠𐴥𐴘𐴕𐴝𐴕𐴡𐴌 𐴉𐴟𐴖𐴝,<verse eid="LUK 3:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="LUK 3:38" />𐴑𐴠𐴥𐴘𐴕𐴝𐴕 𐴀𐴠𐴕𐴡𐴐𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴠𐴕𐴡𐴐𐴢 𐴏𐴠𐴥𐴃𐴡𐴌 𐴉𐴟𐴖𐴝,</para>
  <para style="li1" vid="LUK 3:38">𐴏𐴠𐴥𐴃𐴢 𐴀𐴝𐴊𐴡𐴔𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴊𐴡𐴔 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 4:1-11">𐴔𐴡𐴃𐴢 4‏:1‏-11</ref>; <ref loc="MRK 1:12-13">𐴔𐴝𐴑 1‏:12‏-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />𐴀𐴞𐴏𐴝𐴤, 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴓𐴡𐴥𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴃𐴧𐴟 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴠 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴒𐴟𐴥𐴌𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴝𐴓𐴞𐴐𐴢 𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥 𐴈𐴝𐴥𐴀; 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴌𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴁𐴟𐴥𐴑 𐴓𐴝𐴙𐴒𐴧𐴠𐴥.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴠 𐴐𐴞𐴥𐴓𐴢 𐴓𐴗𐴝𐴥𐴌𐴠 𐴌𐴟𐴄𐴞 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴡𐴥.“<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ’𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴌𐴟𐴄𐴞 𐴓𐴡𐴘 𐴁𐴝𐴏𐴠 𐴊𐴠 𐴕𐴡.‘“</char><note caller="+" style="f"><char style="fr" closed="false">4‏:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 8:3">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 8‏:3</ref></char></char></note><verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴎𐴝𐴒𐴝𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴠. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴘𐴝𐴀𐴕𐴡𐴌 𐴉𐴟𐴌𐴝 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴀𐴕 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴟𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴝𐴀𐴕 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴝𐴌𐴠𐴥 𐴊𐴞𐴦𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴃𐴝𐴌𐴠𐴥 𐴊𐴞𐴦 𐴉𐴝𐴌𐴞. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ’𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴝𐴁𐴟𐴊𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴁𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘“</char><note caller="+" style="f"><char style="fr" closed="false">4‏:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:13">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 6‏:13</ref></char></char></note><verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴃𐴟𐴓𐴧𐴞𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴒𐴝𐴌𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴠𐴕𐴃𐴟𐴥 𐴕𐴞𐴏𐴠 𐴎𐴝𐴥𐴂𐴢 𐴔𐴝𐴌𐴡, <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="LUK 4:10">’𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴁𐴡,</para>
  <para style="q2" vid="LUK 4:10">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝.<verse eid="LUK 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴁𐴡,</para>
  <para style="q2" vid="LUK 4:11">𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴄𐴠𐴥𐴚𐴠 𐴇𐴡𐴕𐴡𐴤 𐴐𐴞𐴥𐴓𐴡𐴃𐴢 𐴊𐴟𐴑 𐴕𐴡 𐴉𐴝𐴦.‘ “<note caller="+" style="f"><char style="fr" closed="false">4‏:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 91:11">𐴎𐴡𐴁𐴟𐴌 91‏:11</ref>‏,<ref loc="PSA 91:12">12</ref></char></char></note><verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ’𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴝𐴁𐴟𐴊𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘“</char><note caller="+" style="f"><char style="fr" closed="false">4‏:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:16">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 6‏:16</ref></char></char></note><verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴌𐴀𐴠𐴑 𐴔𐴡𐴑𐴝 𐴕𐴡𐴥 𐴉𐴝𐴦 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="LUK 4:13" /></para>
  <para style="s1">𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴈𐴝𐴔𐴡𐴌 𐴐𐴟𐴥𐴌𐴟</para>
  <para style="r">(<ref loc="MAT 4:12-17">𐴔𐴡𐴃𐴢 4‏:12‏-17</ref>; <ref loc="MRK 1:14-15">𐴔𐴝𐴑 1‏:14‏-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴇𐴠𐴥𐴍𐴞𐴘𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴉𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 4:15" /></para>
  <para style="s1">𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌</para>
  <para style="r">(<ref loc="MAT 13:53-58">𐴔𐴡𐴃𐴢 13‏:53‏-58</ref>; <ref loc="MRK 6:1-6">𐴔𐴝𐴑 6‏:1‏-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴠𐴍𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴀𐴙𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴔𐴟𐴃𐴝𐴉𐴠𐴑 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴠𐴓𐴝𐴖𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴌 𐴑𐴞𐴃𐴝𐴁𐴢 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴁𐴡𐴙𐴄𐴧𐴝 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴔𐴠𐴓𐴞𐴥, 𐴀𐴠 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕 𐴃𐴟𐴖𐴝𐴘 𐴓𐴡𐴘𐴧𐴠𐴥 𐴎𐴠𐴍𐴠𐴥 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠,<verse eid="LUK 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LUK 4:18" />
    <char style="wj">”𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴌𐴟𐴀 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤,</char></para>
  <para style="q2" vid="LUK 4:18">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠.</char></para>
  <para style="q" vid="LUK 4:18">
    <char style="wj">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴁𐴡𐴕𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴟𐴥𐴌𐴞𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤,</char></para>
  <para style="q2" vid="LUK 4:18">
    <char style="wj">𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴠𐴑𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴓𐴝𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥;</char></para>
  <para style="q" vid="LUK 4:18">
    <char style="wj">𐴀𐴝𐴌𐴡𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴎𐴟𐴓𐴟𐴥𐴔 𐴉𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥,</char><verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />
    <char style="wj">𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞𐴌 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴀𐴠𐴓𐴝𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.“</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4‏:19 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 61:1">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 61‏:1</ref>‏,<ref loc="ISA 61:2">2</ref>; <ref loc="ISA 58:6">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 58‏:6</ref></char>
      </char>
    </note><verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴁𐴝𐴣𐴊𐴞𐴥 𐴈𐴝𐴥𐴀𐴊𐴠𐴔𐴧𐴗𐴝𐴌𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. 𐴀𐴝𐴦𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴎𐴟 𐴏𐴟𐴑 𐴓𐴝𐴒𐴝𐴘𐴊𐴞 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠, <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥, <char style="wj">”𐴀𐴝𐴙𐴅𐴧𐴝 𐴀𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴟𐴥𐴕𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴧𐴠.“</char><verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴎𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴞 𐴈𐴡𐴃𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴑𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌 𐴉𐴟𐴖𐴝 𐴕𐴡 𐴕𐴞𐴥𐴑𐴞؟“<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠 𐴑𐴞, ’𐴋𐴝𐴑𐴄𐴡𐴌, 𐴀𐴝𐴒𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴒𐴡𐴔 𐴒𐴡𐴌𐴡𐴤. 𐴃𐴟𐴀𐴛 𐴎𐴠 𐴈𐴝𐴔 𐴔𐴟𐴥𐴕 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴍𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴌𐴝𐴃𐴢 𐴀𐴡𐴥 𐴒𐴡𐴌𐴞𐴥 𐴊𐴝𐴈𐴡𐴥.‘“</char><verse eid="LUK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 4:24" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴁𐴞𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴃𐴡𐴥𐴕𐴡𐴃𐴢 𐴒𐴡𐴏𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘.</char> <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" /><char style="wj">𐴘𐴝𐴀𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴑𐴞, 𐴕𐴡𐴁𐴞 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴐𐴝𐴥𐴌𐴡 𐴃𐴞𐴕 𐴁𐴡𐴏𐴡𐴥𐴌 𐴉𐴝𐴥𐴕 𐴎𐴡𐴥𐴌 𐴕𐴡𐴥 𐴊𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴣𐴍𐴝 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴌𐴝𐴄𐴢 𐴀𐴡𐴥𐴀𐴙𐴓𐴢, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢;</char> <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" /><char style="wj">𐴃𐴡𐴀 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴏𐴞𐴥𐴊𐴡𐴕 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴎𐴝𐴥𐴌𐴠𐴉𐴝𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴌𐴝𐴌𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴁𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢.</char> <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴕𐴡𐴁𐴞 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴝𐴥𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴏𐴞𐴀𐴌𐴞𐴘𐴝 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴌 𐴕𐴝𐴔𐴝𐴕𐴡𐴌𐴠 𐴁𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢.“</char><verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴞, 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴒𐴟𐴐𐴧𐴝𐴤𐴘𐴠 𐴁𐴡𐴥𐴌𐴞𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴕𐴠𐴦𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴙𐴕𐴊𐴝𐴤𐴃𐴧𐴟 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴝𐴀𐴌𐴡𐴌 𐴃𐴟𐴓𐴧𐴞𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴎𐴠𐴍𐴠𐴥 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴐𐴡𐴥𐴀𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴝𐴎𐴡𐴥𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴈𐴠𐴥𐴕𐴃𐴟 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="LUK 4:30" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢</para>
  <para style="r">(<ref loc="MRK 1:21-28">𐴔𐴝𐴑 1‏:21‏-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴏𐴠 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴐𐴡𐴥𐴀𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴠 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴃𐴡𐴤 𐴊𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠.<verse eid="LUK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33" />𐴇𐴠𐴥𐴍𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴕𐴝𐴉𐴝𐴑 𐴁𐴟𐴥𐴃𐴡𐴌 𐴅𐴞𐴕𐴠 𐴉𐴝𐴘𐴧𐴝. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />”𐴀𐴡𐴥 𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴏𐴝𐴥𐴌𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴞𐴦 𐴈𐴝𐴔 𐴀𐴝𐴏𐴠𐴤؟ 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴡𐴥 𐴊𐴠 𐴕𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴃𐴟𐴀𐴛 𐴇𐴡𐴕, 𐴃𐴟𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑𐴎𐴡𐴕 𐴕𐴗𐴝𐴥.“<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥𐴌𐴠 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴞𐴎𐴝𐴥𐴔 𐴀𐴡𐴥, 𐴘𐴡𐴒𐴧𐴗𐴝𐴥𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴎𐴝𐴒𐴡𐴥𐴘.“</char> 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴠𐴥 𐴅𐴞𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴝𐴎𐴠𐴥 𐴀𐴝𐴣𐴏𐴝𐴥𐴌 𐴔𐴝𐴥𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴕𐴡𐴤 𐴎𐴡𐴈𐴡𐴥𐴔 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴀𐴕 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴃𐴝𐴤؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴑𐴡𐴃𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴠𐴥 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴕𐴠𐴦𐴓𐴞𐴎𐴝𐴒𐴡𐴥𐴘!“ <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴇𐴠𐴥 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴥𐴑𐴡𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴉𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘.<verse eid="LUK 4:37" /></para>
  <para style="s1">𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 8:14-17">𐴔𐴡𐴃𐴢 8‏:14‏-17</ref>; <ref loc="MRK 1:29-34">𐴔𐴝𐴑 1‏:29‏-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞, 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌 𐴇𐴡𐴥𐴖𐴌𐴞𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴒𐴝𐴦𐴃𐴎𐴡𐴌 𐴀𐴟𐴙𐴄𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />𐴀𐴞𐴥𐴁𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴡𐴌𐴠 𐴒𐴝𐴦𐴃𐴎𐴡𐴌 𐴎𐴝𐴘𐴁𐴡𐴥𐴘 𐴓𐴧𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴌𐴝𐴥𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴒𐴝𐴦𐴃𐴎𐴡𐴌 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴠𐴀𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴁𐴠𐴙𐴓𐴢 𐴒𐴡𐴥𐴓𐴞𐴎𐴝𐴌𐴒𐴡𐴘, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴡𐴓𐴝 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴎𐴡𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴥𐴃𐴢 𐴊𐴞𐴥𐴊𐴞 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴃𐴧𐴟 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴒𐴟𐴎𐴡𐴌𐴞 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, ”𐴃𐴟𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝!“ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴠 𐴏𐴞𐴕𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴊𐴡𐴥𐴔𐴑𐴞 𐴊𐴞𐴥 𐴔𐴝𐴃𐴞𐴃𐴡𐴥 𐴕𐴡 𐴊𐴞𐴃𐴡.<verse eid="LUK 4:41" /></para>
  <para style="s1">𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴓𐴧𐴝</para>
  <para style="r">(<ref loc="MRK 1:35-39">𐴔𐴝𐴑 1‏:35‏-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />𐴁𐴝𐴦𐴊𐴠 𐴊𐴞𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴏𐴝𐴤 𐴕𐴠𐴦𐴓𐴞 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴡𐴐𐴡𐴥𐴃𐴞-𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴒𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴖𐴝𐴘-𐴃𐴟𐴖𐴝𐴘 𐴊𐴡𐴥𐴙𐴅𐴧𐴠𐴒𐴝𐴘. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴎𐴝𐴘𐴃𐴡𐴒𐴡𐴥𐴘 𐴕𐴡 𐴊𐴞𐴃𐴡 𐴏𐴝𐴀𐴙𐴓𐴢; <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴌 𐴐𐴡𐴥𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴡𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.“</char><verse eid="LUK 4:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s1">𐴐𐴟𐴥𐴌𐴟𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 4:18-22">𐴔𐴡𐴃𐴢 4‏:18‏-22</ref>; <ref loc="MRK 1:16-20">𐴔𐴝𐴑 1‏:16‏-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴒𐴠𐴕𐴠𐴏𐴝𐴥𐴌𐴠𐴃𐴢 𐴋𐴞𐴀𐴌<note caller="+" style="f"><char style="fr" closed="false">5‏:1 </char><char style="ft" closed="false">𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴝𐴓𐴞𐴓𐴢 𐴋𐴞𐴀</char></note> 𐴑𐴟𐴓𐴡𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴑𐴡𐴃𐴧𐴟 𐴄𐴠𐴥𐴓𐴝𐴄𐴠𐴓𐴞 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴋𐴞𐴀𐴌 𐴇𐴝𐴣𐴏𐴝 𐴓𐴡𐴘 𐴊𐴟𐴘𐴧𐴝𐴥𐴕 𐴕𐴡𐴦 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴎𐴞𐴀𐴕𐴡𐴃𐴧𐴟 𐴎𐴝𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴓𐴝𐴔𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴝𐴓𐴢 𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />𐴀𐴞𐴥𐴁𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴡𐴘, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴀𐴡𐴌, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡𐴦 𐴒𐴝𐴥𐴕 𐴑𐴟𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴒𐴡𐴌𐴞 𐴊𐴟𐴌𐴠𐴥 𐴓𐴡𐴘𐴎𐴝𐴘𐴃𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥. 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝 𐴁𐴡𐴀𐴘𐴢 𐴕𐴡𐴦𐴃𐴧𐴟 𐴃𐴝𐴥𐴘 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴡𐴦 𐴒𐴝𐴥𐴕 𐴔𐴟𐴌 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘 𐴀𐴠𐴑𐴧𐴟𐴥𐴉𐴢 𐴔𐴝𐴏𐴢 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴎𐴝𐴓𐴢 𐴉𐴠𐴥𐴓𐴡.“</char><verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴥𐴎𐴟𐴌, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴝𐴙𐴃𐴁𐴡𐴥𐴌 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴥 𐴉𐴝𐴘. 𐴃𐴡𐴀 𐴃𐴟𐴀𐴛 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴈𐴡𐴀𐴌, 𐴀𐴝𐴀𐴛 𐴎𐴝𐴓𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴟𐴔.“<verse eid="LUK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴓𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴀𐴠𐴊𐴟𐴥𐴕 𐴔𐴝𐴏𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴝𐴓𐴢 𐴉𐴝𐴥𐴍𐴞 𐴎𐴝𐴌𐴒𐴡𐴘. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴠 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴙𐴕𐴧𐴡 𐴕𐴡𐴦𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴐𐴝𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥. 𐴃𐴡𐴥𐴘 𐴃𐴝𐴌𐴝𐴥 𐴀𐴝𐴀𐴘𐴢 𐴊𐴟𐴕𐴞𐴥 𐴕𐴡𐴦 𐴀𐴠𐴊𐴧𐴟𐴥𐴌 𐴁𐴡𐴥𐴙𐴅𐴧𐴠, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴇𐴞𐴥𐴀𐴕 𐴋𐴟𐴉𐴡𐴥𐴔-𐴋𐴟𐴉𐴡𐴥𐴔 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="LUK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴡𐴦𐴃𐴢 𐴉𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴎𐴡𐴦𐴒𐴡𐴥𐴘; 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢.“ <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥𐴊𐴟𐴕 𐴔𐴝𐴏𐴢 𐴉𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴑𐴟𐴥𐴁𐴢 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴘𐴡𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞.</para>
  <para style="p" vid="LUK 5:10">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴐𐴢, 𐴀𐴠𐴇𐴡𐴥𐴕𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴃𐴟𐴘 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴡𐴥𐴌𐴞𐴁𐴞.“</char> <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴡𐴦 𐴒𐴟𐴥𐴕 𐴑𐴟𐴓𐴡𐴃𐴢 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴠𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="LUK 5:11" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 8:1-4">𐴔𐴡𐴃𐴢 8‏:1‏-4</ref>; <ref loc="MRK 1:40-45">𐴔𐴝𐴑 1‏:40‏-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />𐴀𐴠𐴑𐴁𐴝𐴌 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴍𐴠 𐴑𐴟𐴌𐴟𐴏𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴏𐴝𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.“<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴁𐴝𐴌𐴝𐴤𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢; 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴡𐴘.“</char> 𐴃𐴡𐴥𐴘 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="LUK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴕𐴞𐴐𐴡𐴥𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴘𐴝𐴀𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴝𐴘 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴝𐴈𐴡𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴧𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴁𐴝𐴤 𐴀𐴡𐴥 𐴉𐴝𐴕, 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴡𐴒𐴡𐴥𐴘.“</char><verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴉𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴥𐴕𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴡. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴀𐴠𐴒𐴝𐴎𐴝𐴥-𐴀𐴠𐴒𐴝𐴎𐴝𐴥 𐴁𐴡𐴐𐴡𐴥𐴃𐴞-𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴒𐴝𐴃𐴢 𐴎𐴝𐴘 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.<verse eid="LUK 5:16" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴣𐴃𐴟𐴌𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 9:1-8">𐴔𐴡𐴃𐴢 9‏:1‏-8</ref>; <ref loc="MRK 2:1-12">𐴔𐴝𐴑 2‏:1‏-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴠𐴌, 𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴉𐴝𐴌𐴝 𐴃𐴧𐴟, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴃𐴧𐴟, 𐴀𐴠𐴊𐴧𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴀𐴡𐴃𐴧𐴟. 𐴀𐴝𐴦𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴠𐴑 𐴀𐴝𐴣𐴃𐴟𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴁𐴞𐴏𐴝𐴥𐴕𐴝𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴁𐴡𐴀𐴘𐴢 𐴀𐴝𐴙𐴕𐴧𐴠𐴤; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴒𐴡𐴥𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴝𐴘 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴠𐴌𐴞 𐴁𐴡𐴓𐴧𐴝. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴎𐴝𐴔𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘𐴁𐴝𐴥𐴌 𐴌𐴝𐴏𐴃𐴝 𐴕𐴡𐴥 𐴉𐴝𐴦, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴊𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴏𐴝𐴥𐴕𐴞 𐴁𐴝𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴐𐴡𐴥𐴀 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴝𐴎𐴠𐴥𐴇𐴝𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴓𐴝𐴔𐴝𐴘𐴊𐴞𐴘𐴠𐴥.<verse eid="LUK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠 <char style="wj">”𐴊𐴟𐴏𐴃𐴡𐴥, 𐴃𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠.“</char><verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴝𐴥𐴉𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴇𐴡𐴕, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴠𐴥𐴌؟ 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴊𐴠 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴝𐴌𐴡𐴘𐴝 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟“<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴌𐴠 𐴎𐴝𐴕𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴞𐴘𐴝𐴥 𐴁𐴝𐴥𐴉𐴡𐴌؟</char> <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" /><char style="wj">𐴈𐴡𐴘𐴃𐴠𐴤 𐴇𐴡𐴕 𐴕𐴝𐴥𐴕 𐴀𐴝𐴏𐴝𐴤𐴕, 𐴑𐴞 ’𐴃𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠,‘ 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞, ’𐴀𐴟𐴍𐴞𐴤 𐴀𐴝𐴥𐴣𐴄𐴢‘؟</char> <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤.“</char> 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴃𐴟𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴟𐴄𐴢, 𐴃𐴡𐴌 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴦𐴒𐴡𐴥𐴘.“</char> <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴟𐴙𐴄𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴠 𐴕𐴠𐴍𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴖𐴝 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴥𐴁𐴢 𐴋𐴡𐴦𐴌𐴝𐴘𐴎𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴙𐴅𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴌𐴇𐴝𐴥𐴕𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥!“<verse eid="LUK 5:26" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴓𐴠𐴀𐴜𐴞𐴌𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 9:9-13">𐴔𐴡𐴃𐴢 9‏:9‏-13</ref>; <ref loc="MRK 2:13-17">𐴔𐴝𐴑 2‏:13‏-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴎𐴝𐴘 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴓𐴠𐴀𐴜𐴞 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴃𐴟𐴓𐴠𐴥 𐴊𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌𐴡.“</char> <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴠𐴌𐴞 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />𐴁𐴝𐴦𐴊𐴠 𐴓𐴠𐴀𐴜𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴥𐴕𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴍𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 5:30" />𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴐𐴠𐴥𐴑𐴝𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴞𐴘𐴝𐴥 𐴈𐴝𐴥𐴕𐴝-𐴉𐴞𐴕𐴝 𐴈𐴡𐴥𐴀؟“ <verse eid="LUK 5:30" /><verse number="31" style="v" sid="LUK 5:31" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴃𐴡 𐴋𐴝𐴑𐴄𐴡𐴌 𐴕𐴡 𐴓𐴝𐴒𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴠 𐴓𐴝𐴒𐴠.</char> <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴡𐴖𐴝𐴥𐴌 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠.“</char><verse eid="LUK 5:32" /></para>
  <para style="s1">𐴌𐴟𐴎𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 9:14-17">𐴔𐴡𐴃𐴢 9‏:14‏-17</ref>; <ref loc="MRK 2:18-22">𐴔𐴝𐴑 2‏:18‏-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴡 𐴀𐴠𐴒𐴝𐴎𐴝𐴥-𐴀𐴠𐴒𐴝𐴎𐴝𐴥 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴠𐴥𐴌𐴡𐴐𐴞𐴌 𐴒𐴟𐴥𐴕𐴠 𐴘𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴟𐴥𐴕𐴠 𐴃𐴡 𐴈𐴝𐴥𐴕𐴝-𐴉𐴞𐴕𐴝 𐴁𐴝𐴊𐴢 𐴊𐴠𐴊𐴠 𐴕𐴝𐴥𐴘.“<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴊𐴟𐴓𐴝𐴤 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴡𐴘𐴌𐴝𐴙𐴃𐴧𐴝𐴌𐴠 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴝𐴤𐴘 𐴉𐴝𐴌𐴞𐴁𐴝𐴥؟</char> <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴀𐴕 𐴊𐴞𐴕 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴟𐴓𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴞𐴕 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴞𐴥𐴁𐴡.“</char><verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴀𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥, <char style="wj">”𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴡 𐴕𐴡𐴘𐴝 𐴉𐴟𐴐𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴒𐴡𐴌𐴞 𐴉𐴝𐴥𐴍𐴞 𐴓𐴡𐴦𐴘𐴢 𐴉𐴟𐴌𐴝𐴕 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴃𐴢 𐴃𐴝𐴓𐴞 𐴊𐴠𐴊𐴠 𐴕𐴝𐴥𐴘; 𐴎𐴡𐴊𐴞 𐴊𐴞𐴓𐴠𐴥 𐴃𐴡 𐴕𐴡𐴘𐴝 𐴖𐴝 𐴘𐴡𐴥 𐴉𐴝𐴥𐴍𐴞 𐴎𐴝𐴘𐴁𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴕𐴡𐴘𐴝 𐴖𐴝𐴃𐴧𐴟 𐴓𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴃𐴝𐴓𐴞 𐴒𐴝𐴥𐴕 𐴀𐴡𐴥 𐴉𐴟𐴌𐴝𐴕 𐴕𐴗𐴝𐴥𐴃𐴢 𐴕𐴡 𐴇𐴝𐴥𐴍𐴞𐴁𐴡.</char> <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡𐴘𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴕 𐴏𐴝𐴔𐴝𐴌𐴝𐴌 𐴇𐴡𐴥𐴙𐴓𐴧𐴝𐴃𐴢 𐴌𐴝𐴑𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘; 𐴎𐴡𐴊𐴞 𐴌𐴝𐴑𐴞𐴥𐴓𐴠 𐴃𐴡 𐴕𐴡𐴘𐴝 𐴌𐴡𐴐𐴧𐴟𐴥𐴕𐴠 𐴇𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴟𐴥𐴕 𐴉𐴝𐴥𐴍𐴞𐴉𐴠𐴓𐴝𐴘 𐴒𐴡𐴓𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴟𐴥𐴕 𐴀𐴡𐴥 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴎𐴝𐴘𐴁𐴡𐴘.</char> <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴕𐴡𐴘𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴡𐴌𐴠 𐴕𐴡𐴘𐴝 𐴏𐴝𐴔𐴝𐴌𐴝𐴌 𐴇𐴡𐴥𐴙𐴓𐴧𐴝𐴃𐴢 𐴌𐴝𐴑𐴝𐴤 𐴉𐴡𐴌𐴠.</char> <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" /><char style="wj">𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴡 𐴉𐴟𐴌𐴝𐴕 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴇𐴝𐴥𐴘 𐴁𐴝𐴦𐴊𐴠 𐴕𐴡𐴘𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴈𐴝𐴥𐴘𐴃𐴡 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴠𐴦 𐴈𐴡𐴀 𐴊𐴠, ’𐴉𐴟𐴌𐴝𐴕 𐴕𐴟𐴥𐴕 𐴁𐴠 𐴁𐴠𐴀𐴃𐴡𐴌.‘ “</char><verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s1">𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴒𐴞𐴣𐴘𐴟𐴌 𐴃𐴟𐴥𐴌 𐴃𐴟𐴓𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 12:1-8">𐴔𐴡𐴃𐴢 12‏:1‏-8</ref>; <ref loc="MRK 2:23-28">𐴔𐴝𐴑 2‏:23‏-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />𐴀𐴠𐴑𐴁𐴝𐴌 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴀𐴞𐴏𐴝𐴤 𐴒𐴞𐴣𐴘𐴟𐴌 𐴑𐴟𐴣𐴍𐴝𐴤 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴒𐴞𐴣𐴘𐴟𐴌 𐴃𐴟𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴓𐴞𐴤 𐴀𐴝𐴥𐴃𐴠 𐴋𐴡𐴓𐴞-𐴋𐴡𐴓𐴞 𐴈𐴝𐴥𐴀𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴕𐴝𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴡𐴤𐴌؟“<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴘𐴝𐴀𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡𐴥 𐴉𐴡𐴌𐴡𐴥, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴝𐴖𐴟𐴊𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴟𐴥𐴑 𐴓𐴝𐴙𐴒𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴦 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠𐴥؟</char> <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" /><char style="wj">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴌𐴟𐴄𐴞 𐴓𐴡𐴦𐴘𐴢 𐴈𐴝𐴥𐴀𐴙𐴓𐴢, 𐴎𐴞𐴀𐴕 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴕𐴝𐴥𐴘. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴡𐴥 𐴊𐴞𐴀𐴓𐴢.“</char> <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕𐴡𐴌 𐴔𐴝𐴓𐴞𐴑.“</char><verse eid="LUK 6:5" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴉𐴟𐴥𐴖𐴝𐴕𐴝 𐴀𐴝𐴥𐴃𐴢 𐴀𐴡𐴓𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢</para>
  <para style="r">(<ref loc="MAT 12:9-14">𐴔𐴡𐴃𐴢 12‏:9‏-14</ref>; <ref loc="MRK 3:1-6">𐴔𐴝𐴑 3‏:1‏-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴀𐴞𐴏𐴝𐴤 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠; 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴝𐴌 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴧𐴝𐴕 𐴉𐴟𐴥𐴖𐴝𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴒𐴡𐴔 𐴒𐴡𐴌𐴠𐴥 𐴕𐴠𐴥 𐴈𐴝𐴥𐴀𐴏𐴢 𐴕𐴡𐴎𐴡𐴌 𐴊𐴞 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴓𐴎𐴝𐴔 𐴓𐴝𐴒𐴝𐴘𐴁𐴝𐴥𐴌 𐴔𐴡𐴑𐴝 𐴉𐴝𐴦. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴌𐴠 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴥𐴃𐴢 𐴉𐴟𐴥𐴖𐴝𐴕𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴟𐴍𐴡𐴥, 𐴀𐴠𐴍𐴠𐴥 𐴔𐴝𐴎𐴠𐴥 𐴃𐴞𐴥𐴘𐴡𐴒𐴝𐴘.“</char> 𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴟𐴍𐴞𐴤 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠.<verse eid="LUK 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴝𐴘𐴠𐴏𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌؟ 𐴉𐴡𐴌𐴝𐴕 𐴁𐴝𐴏𐴝𐴘𐴁𐴝𐴥𐴌 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴇𐴝𐴥𐴓𐴝𐴑 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌؟“</char><verse eid="LUK 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴝𐴘𐴌𐴡𐴥𐴔𐴞𐴑𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴥𐴃𐴧𐴝𐴕 𐴁𐴝𐴌𐴡𐴥.“</char> 𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴥𐴃𐴧𐴝𐴕 𐴀𐴝𐴒𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴒𐴟𐴐𐴧𐴝𐴤 𐴀𐴟𐴍𐴞𐴤𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴡𐴘 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴁𐴞𐴘𐴝𐴏𐴝𐴕𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠𐴒𐴡𐴘 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴞𐴦 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.<verse eid="LUK 6:11" /></para>
  <para style="s1">𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 10:1-4">𐴔𐴡𐴃𐴢 10‏:1‏-4</ref>; <ref loc="MRK 3:13-19">𐴔𐴝𐴑 3‏:13‏-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴠𐴑 𐴊𐴞𐴕، 𐴀𐴞𐴏𐴝𐴤 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴌𐴝 𐴌𐴝𐴙𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴈𐴝𐴍𐴝𐴘𐴧𐴠𐴥. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴇𐴡𐴘 𐴓𐴡𐴑𐴡𐴥𐴁𐴢 𐴊𐴞𐴘𐴠𐴥. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠: 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴎𐴝𐴌𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴃𐴡𐴌 𐴕𐴝𐴔 𐴊𐴞𐴘𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴥𐴘 𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴢; 𐴀𐴝𐴦𐴌 𐴘𐴝𐴑𐴟𐴁𐴢, 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 𐴉𐴞𐴓𐴞𐴥𐴂𐴢, 𐴁𐴝𐴌𐴃𐴡𐴥𐴓𐴡𐴔𐴞𐴘𐴡, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />𐴔𐴡𐴃𐴞, 𐴃𐴡𐴥𐴔𐴝𐴏𐴢, 𐴀𐴝𐴓𐴉𐴝𐴥𐴘𐴧𐴝𐴏𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴝𐴑𐴟𐴁𐴢, 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴎𐴠𐴥𐴓𐴡𐴃𐴢 𐴈𐴡𐴀, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴞𐴏𐴑𐴝𐴥𐴌𐴞𐴘𐴠𐴃𐴢 𐴎𐴞𐴁𐴝𐴤 𐴊𐴡𐴥𐴌𐴞𐴊𐴡𐴘𐴝 𐴀𐴡𐴥𐴀𐴙𐴓𐴢.<verse eid="LUK 6:16" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴡𐴔 𐴒𐴡𐴌𐴝𐴥</para>
  <para style="r">(<ref loc="MAT 4:23-25">𐴔𐴡𐴃𐴢 4‏:23‏-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />𐴀𐴞𐴏𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴝𐴔𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴟𐴥𐴀𐴝𐴙𐴕𐴧𐴝 𐴎𐴝𐴒𐴝𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠; 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴌𐴡𐴤 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴌, 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴀𐴡𐴌, 𐴄𐴝𐴘𐴝𐴥𐴌 𐴀𐴡𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴥𐴊𐴡𐴕𐴡𐴌 𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴝𐴌, <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴔𐴡𐴃𐴧𐴟 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴠 𐴊𐴟𐴑 𐴊𐴠𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴥𐴘𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴕𐴠𐴦𐴓𐴞 𐴎𐴝𐴘 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="LUK 6:19" /></para>
  <para style="s1">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢</para>
  <para style="r">(<ref loc="MAT 5:1-12">𐴔𐴡𐴃𐴢 5‏:1‏-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠:</para>
  <para style="q1" vid="LUK 6:20">
    <char style="wj">”𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴡𐴌𐴞𐴉𐴢,</char></para>
  <para style="q2" vid="LUK 6:20">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌.</char><verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />
    <char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠𐴇𐴡𐴥𐴕 𐴁𐴟𐴥𐴑𐴝,</char></para>
  <para style="q2" vid="LUK 6:21">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char></para>
  <para style="q1" vid="LUK 6:21">
    <char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠𐴇𐴡𐴥𐴕 𐴈𐴝𐴣𐴊𐴡𐴀𐴌,</char></para>
  <para style="q2" vid="LUK 6:21">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴥𐴣𐴐𐴞𐴁𐴝.</char><verse eid="LUK 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22" />
    <char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴌𐴠</char></para>
  <para style="q2" vid="LUK 6:22">
    <char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥,</char></para>
  <para style="q3" vid="LUK 6:22">
    <char style="wj">𐴔𐴝𐴀𐴌𐴟𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴕𐴐𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴊𐴕𐴝𐴔 𐴒𐴡𐴌𐴠𐴥.</char><verse eid="LUK 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23" />
    <char style="wj">”𐴇𐴠𐴥 𐴊𐴞𐴕 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴉𐴝𐴥𐴓𐴢 𐴔𐴝𐴙𐴅𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴟𐴥𐴕𐴡, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴋𐴡𐴣𐴀𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴀𐴝𐴏𐴠𐴤. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴡𐴥 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.</char><verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />
    <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌,</char></para>
  <para style="q2" vid="LUK 6:24">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴟𐴥𐴑 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴍𐴠𐴥 𐴉𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴡.</char><verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />
    <char style="wj">𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴝𐴓𐴝 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴝𐴘 𐴉𐴝𐴌𐴡𐴀𐴌,</char></para>
  <para style="q2" vid="LUK 6:25">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴟𐴥𐴑𐴝 𐴀𐴡𐴥𐴘𐴁𐴝.</char></para>
  <para style="q1" vid="LUK 6:25">
    <char style="wj">𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴝𐴓𐴝 𐴀𐴝𐴥𐴣𐴐𐴡𐴌,</char></para>
  <para style="q2" vid="LUK 6:25">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴀𐴡𐴥𐴘𐴁𐴝 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.</char><verse eid="LUK 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26" />
    <char style="wj">𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴕𐴝𐴔 𐴒𐴡𐴌𐴠𐴥,</char></para>
  <para style="q2" vid="LUK 6:26">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴡𐴥 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.</char><verse eid="LUK 6:26" /></para>
  <para style="s1">𐴊𐴟𐴐𐴧𐴡𐴕𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤</para>
  <para style="r">(<ref loc="MAT 5:38-48">𐴔𐴡𐴃𐴢 5‏:38‏-48</ref>; <ref loc="MAT 7:12">7‏:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴟𐴥𐴕𐴡𐴌, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌: 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴐𐴧𐴡𐴕𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴙𐴅𐴧𐴡𐴥;</char> <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" /><char style="wj">𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴊𐴞𐴘𐴡; 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴡𐴊𐴏𐴡𐴥𐴓𐴧𐴟𐴑 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char> <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴠𐴑 𐴒𐴝𐴓𐴏𐴝𐴁𐴝 𐴏𐴝𐴥𐴘 𐴏𐴟𐴖𐴝𐴌 𐴔𐴝𐴌𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴡 𐴋𐴝𐴥𐴑 𐴀𐴡𐴥 𐴉𐴞𐴥𐴌𐴝𐴘𐴊𐴞𐴘𐴡; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴝𐴊𐴧𐴡𐴌 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴟𐴌𐴟𐴃𐴝 𐴘𐴡𐴥 𐴓𐴡𐴘𐴎𐴝𐴘𐴃𐴡𐴥 𐴔𐴝𐴕𐴝𐴥 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char> <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴔𐴝𐴒𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴉𐴞𐴥𐴌𐴝𐴘 𐴕𐴡 𐴔𐴝𐴒𐴞𐴘𐴡𐴥.</char> <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" /><char style="wj">𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴡𐴀 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴡𐴌𐴡𐴥𐴗𐴑.</char><verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />
    <char style="wj">”𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴟𐴥𐴊𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴏𐴟𐴥𐴖𐴝𐴁𐴢 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴉𐴝𐴘𐴁𐴝؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴟𐴥𐴊𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴏𐴟𐴥𐴖𐴝𐴁𐴢 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴉𐴝𐴘𐴁𐴝؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴃𐴡 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" /><char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴞𐴥𐴌𐴝𐴘 𐴉𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴠 𐴀𐴟𐴊𐴝𐴥𐴌 𐴊𐴡𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴏𐴟𐴥𐴖𐴝𐴁𐴢 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴉𐴝𐴘𐴁𐴝؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴃𐴡 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴟𐴊𐴝𐴥𐴌 𐴊𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴞𐴥𐴌𐴝𐴘 𐴉𐴝𐴦.</char> <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴐𐴧𐴡𐴕𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴞𐴥𐴌𐴝𐴘 𐴉𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴀𐴟𐴊𐴝𐴥𐴌 𐴊𐴡𐴥; 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴋𐴡𐴣𐴀𐴌 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝 𐴃𐴝𐴥𐴓𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴄𐴡𐴥𐴀𐴌𐴞𐴁𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴃𐴡 𐴕𐴝𐴐𐴟𐴥𐴑𐴟𐴌 𐴀𐴠𐴊𐴧𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" /><char style="wj">𐴌𐴝𐴇𐴝𐴥𐴔 𐴊𐴞𐴓𐴢 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥 𐴌𐴝𐴇𐴝𐴥𐴔 𐴊𐴞𐴓𐴢 𐴀𐴡𐴓𐴝.</char><verse eid="LUK 6:36" /></para>
  <para style="s1">𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥</para>
  <para style="r">(<ref loc="MAT 7:1-5">𐴔𐴡𐴃𐴢 7‏:1‏-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />
    <char style="wj">”𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡 𐴊𐴡𐴙𐴅𐴧𐴡, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴘𐴡𐴥 𐴊𐴡𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡. 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴕𐴡 𐴄𐴡𐴥𐴀𐴌𐴝𐴘𐴧𐴡, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡. 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴡, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" /><char style="wj">𐴊𐴞𐴦𐴘𐴡, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡. 𐴏𐴞𐴁𐴞-𐴏𐴞𐴁𐴞 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴌𐴞-𐴓𐴝𐴌𐴞 𐴁𐴝𐴀𐴘𐴢 𐴉𐴡𐴌𐴠 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴒𐴡𐴔 𐴔𐴝𐴉𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴟𐴏𐴧𐴝𐴥𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴔𐴝𐴉𐴠 𐴊𐴡𐴦, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥 𐴔𐴝𐴉𐴠 𐴁𐴠 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴀𐴡𐴥 𐴊𐴞𐴘𐴠𐴥, <char style="wj">”𐴀𐴠𐴑 𐴀𐴝𐴣𐴊𐴝𐴤𐴘𐴠 𐴑𐴞𐴥 𐴀𐴝𐴌𐴀𐴠𐴑 𐴀𐴝𐴣𐴊𐴝𐴤𐴌𐴠 𐴉𐴡𐴣𐴃𐴢 𐴊𐴝𐴈𐴝𐴤𐴘 𐴉𐴝𐴌𐴠؟ 𐴃𐴝𐴌𐴝𐴥 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴑𐴞𐴥 𐴒𐴝𐴣𐴃𐴡𐴃𐴢 𐴕𐴡 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴕𐴠𐴥؟</char> <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" /><char style="wj">𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴏𐴃𐴝𐴃𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴕𐴡, 𐴓𐴠𐴑𐴞𐴕 𐴎𐴝𐴃𐴧𐴟 𐴕𐴞𐴑𐴞 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴐𐴞𐴥𐴑𐴧𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴏𐴃𐴝𐴃𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡.</char><verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />
    <char style="wj">”𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴡𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴝𐴥𐴓𐴢 𐴓𐴝𐴕 𐴑𐴞𐴘𐴝𐴥 𐴊𐴠𐴑𐴡𐴥𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴡𐴊𐴧𐴝 𐴒𐴝𐴥𐴕 𐴃𐴡 𐴀𐴡𐴥𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤𐴌؟</char> <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" /><char style="wj">𐴃𐴟𐴀𐴛 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴡𐴊𐴧𐴝 𐴒𐴝𐴥𐴕 𐴕𐴡 𐴊𐴠𐴑𐴡𐴥𐴌, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴁𐴝𐴥𐴘, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴟𐴑𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴓𐴢 𐴓𐴝𐴕 𐴕𐴠𐴦𐴓𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘؟‘ 𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑! 𐴀𐴝𐴒𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴡𐴃𐴧𐴟 𐴇𐴡𐴊𐴧𐴝 𐴒𐴝𐴥𐴕 𐴕𐴠𐴦𐴓𐴝𐴘𐴉𐴠𐴥𐴓𐴡, 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴡𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴝𐴥𐴓𐴢 𐴓𐴝𐴕 𐴕𐴠𐴦𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴊𐴠𐴑𐴞𐴥𐴁𐴝.</char><verse eid="LUK 6:42" /></para>
  <para style="s1">𐴒𐴝𐴏𐴢 𐴏𐴞𐴕𐴝𐴥 𐴎𐴝 𐴊𐴠 𐴒𐴟𐴓𐴝𐴘𐴠</para>
  <para style="r">(<ref loc="MAT 7:17-20">𐴔𐴡𐴃𐴢 7‏:17‏-20</ref>; <ref loc="MAT 12:34-35">12‏:34‏-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />
    <char style="wj">”𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴡𐴔 𐴒𐴝𐴏𐴡𐴃𐴢 𐴃𐴡 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴠 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴒𐴝𐴏𐴡𐴃𐴢 𐴒𐴡𐴔 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴠 𐴊𐴠 𐴕𐴝𐴥𐴘.</char> <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" /><char style="wj">𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴒𐴝𐴏𐴡𐴌𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴒𐴟𐴓𐴝𐴘𐴠 𐴁𐴠 𐴏𐴞𐴕𐴝𐴥 𐴎𐴝. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴡 𐴑𐴠𐴣𐴍𐴝𐴁𐴡𐴕𐴡𐴃𐴧𐴟 𐴋𐴟𐴣𐴙𐴌 𐴒𐴟𐴓𐴝 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴘𐴝𐴥 𐴑𐴠𐴣𐴍𐴝𐴌 𐴎𐴝𐴥𐴓𐴞𐴃𐴧𐴟 𐴀𐴝𐴚𐴒𐴟𐴌 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" /><char style="wj">𐴒𐴡𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴌 𐴒𐴡𐴔 𐴎𐴡𐴔𐴝𐴘𐴧𐴝𐴃𐴧𐴟 𐴒𐴡𐴔 𐴔𐴟𐴥𐴕 𐴕𐴠𐴦𐴓𐴝; 𐴀𐴝𐴦𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴎𐴡𐴔𐴝𐴘𐴧𐴝𐴃𐴧𐴟 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴉𐴟𐴕 𐴕𐴠𐴦𐴓𐴝. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴝𐴌 𐴊𐴞𐴓𐴢 𐴎𐴞𐴀𐴕𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝, 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴑𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠 𐴈𐴡𐴀.</char><verse eid="LUK 6:45" /></para>
  <para style="s1">𐴊𐴟𐴘 𐴎𐴡𐴕 𐴒𐴡𐴥𐴌 𐴁𐴝𐴕𐴡𐴘𐴝</para>
  <para style="r">(<ref loc="MAT 7:24-27">𐴔𐴡𐴃𐴢 7‏:24‏-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴀𐴛 𐴎𐴞𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝, ’𐴔𐴝𐴓𐴞𐴑, 𐴔𐴝𐴓𐴞𐴑‘ 𐴋𐴝𐴑𐴡؟</char> <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴧𐴠𐴤 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴙𐴌:</char> <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" /><char style="wj">𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴡𐴥𐴌 𐴁𐴝𐴕𐴝𐴘𐴁𐴝𐴥𐴐𐴧𐴡𐴃𐴢 𐴔𐴟𐴌 𐴒𐴡𐴌𐴞 𐴔𐴠𐴍𐴞 𐴑𐴟𐴌𐴞𐴥 𐴐𐴞𐴥𐴓𐴡𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞 𐴋𐴝𐴥𐴙𐴓𐴧𐴠. 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴝𐴕𐴞𐴥𐴁𐴝𐴕 𐴀𐴝𐴀𐴘𐴢 𐴇𐴠𐴥 𐴒𐴡𐴥𐴌 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴊𐴡𐴥𐴏𐴝𐴊𐴞𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴓𐴝𐴌𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴁𐴝𐴕𐴝 𐴒𐴞𐴘𐴠𐴥.</char> <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴡𐴕𐴡𐴤 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞 𐴕𐴡 𐴋𐴝𐴥𐴓𐴞 𐴔𐴠𐴍𐴞𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴡𐴥𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥. 𐴃𐴡𐴥𐴘 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴝𐴕𐴞𐴥𐴁𐴝𐴕 𐴀𐴝𐴀𐴘𐴢 𐴇𐴠𐴥 𐴒𐴡𐴥𐴌 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴊𐴡𐴥𐴏𐴝𐴊𐴞𐴘𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴡𐴌𐴞 𐴀𐴠𐴁𐴧𐴠 𐴕𐴝𐴐𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.“</char><verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s1">𐴀𐴠𐴑 𐴌𐴡𐴔𐴞 𐴐𐴝𐴥𐴀𐴂𐴡𐴌 𐴒𐴟𐴓𐴝𐴔𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 8:5-13">𐴔𐴡𐴃𐴢 8‏:5‏-13</ref>; <ref loc="JHN 4:43-54">𐴘𐴡 4‏:43‏-54</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥.<verse eid="LUK 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 7:2" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴉𐴡𐴥𐴗𐴏𐴡𐴌 𐴐𐴝𐴥𐴀𐴂𐴡𐴌 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴒𐴟𐴓𐴝𐴔 𐴁𐴞𐴘𐴝𐴌𐴝𐴔𐴠 𐴔𐴡𐴌𐴡𐴕-𐴔𐴡𐴌𐴡𐴕 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />𐴇𐴠𐴥 𐴐𐴝𐴥𐴀𐴂𐴢 𐴂𐴗𐴝𐴥𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴔𐴟𐴌𐴟𐴁𐴧𐴞𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴀𐴘𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴟𐴓𐴝𐴔𐴧𐴗𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢, ”𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴃𐴝𐴥𐴕𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑; <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴡𐴗𐴔𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴒𐴝𐴥𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴠 𐴁𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴠𐴥.“<verse eid="LUK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴦𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴁𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴒𐴡𐴥𐴌𐴡𐴌 𐴇𐴝𐴣𐴏𐴝𐴥𐴇𐴝𐴣𐴏𐴞 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴐𐴝𐴥𐴀𐴂𐴢 𐴂𐴗𐴝𐴥𐴘𐴠 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴊𐴟𐴏𐴃𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴝𐴌 𐴊𐴟𐴑 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴓𐴡𐴌 𐴕𐴞𐴏𐴠 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴀𐴛 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡; <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴁𐴡𐴓𐴞 𐴕𐴡𐴥 𐴁𐴝𐴥𐴉𐴞. 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴔𐴟𐴑𐴠𐴥 𐴈𐴡𐴀, 𐴃𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴓𐴝𐴔 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴞𐴤, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴣𐴀𐴌 𐴕𐴞𐴏𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴝𐴀𐴛 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴡𐴌𐴠, ’𐴎𐴝𐴦‘ 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴎𐴝𐴦, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴡𐴌𐴠, ’𐴀𐴝𐴘‘ 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴌𐴠, ’𐴘𐴝𐴀𐴕 𐴒𐴡𐴌‘ 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴠𐴥.“<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴌𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴉𐴞𐴥𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴀𐴛 𐴀𐴠𐴃𐴧𐴡𐴥𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡𐴥 𐴉𐴝𐴘.“</char> <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴀𐴘𐴢, 𐴒𐴟𐴓𐴝𐴔𐴧𐴗𐴝𐴌𐴠 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴝 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥.<verse eid="LUK 7:10" /></para>
  <para style="s1">𐴀𐴠𐴑 𐴌𐴝𐴌𐴞𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴙𐴕 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴝𐴌𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥 𐴒𐴞𐴀𐴓𐴢. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />𐴀𐴞𐴥𐴁𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴒𐴠𐴘𐴍𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴟𐴌𐴟𐴊𐴝 𐴁𐴝𐴀𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴌, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴔𐴝𐴦𐴌 𐴓𐴠𐴇𐴝𐴥𐴌 𐴀𐴠𐴑 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴦 𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴌𐴝𐴌𐴞. 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />𐴔𐴝𐴓𐴞𐴑𐴡𐴃𐴧𐴟 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴇𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴉𐴠𐴄𐴉𐴟𐴙𐴅𐴧𐴠𐴥, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴡 𐴈𐴝𐴣𐴊𐴞𐴘𐴡𐴥.“</char><verse eid="LUK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴢 𐴃𐴝𐴁𐴟𐴃𐴧𐴗𐴝 𐴏𐴟𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴔𐴟𐴌𐴟𐴊𐴝 𐴁𐴡𐴀𐴘𐴢 𐴓𐴡𐴘𐴎𐴝𐴌 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴞𐴥𐴘𐴝𐴘𐴒𐴞𐴘𐴡𐴘. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠 <char style="wj">”𐴀𐴡𐴥 𐴕𐴡𐴅𐴟𐴖𐴝𐴕, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴟𐴄𐴢!“</char> <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴔𐴟𐴌𐴟𐴊𐴝 𐴖𐴝 𐴀𐴟𐴍𐴞𐴤 𐴁𐴡𐴙𐴐𐴧𐴠𐴥 𐴀𐴝𐴦𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴔𐴝𐴦𐴌 𐴇𐴝𐴣𐴏𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴋𐴡𐴦𐴌 𐴒𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴕𐴡𐴁𐴞 𐴀𐴟𐴙𐴄𐴧𐴠𐴥. 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.“ <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥 𐴈𐴡𐴥𐴁𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘.<verse eid="LUK 7:17" /></para>
  <para style="s1">𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴈𐴡𐴥𐴁𐴡𐴌𐴒𐴗𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 11:2-19">𐴔𐴡𐴃𐴢 11‏:2‏-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥. <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />𐴃𐴡𐴥𐴘 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴖𐴝𐴥 𐴀𐴟𐴔𐴧𐴡𐴃𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴕𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟“<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴘𐴝𐴀𐴕 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, ’𐴃𐴟𐴀𐴛 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴕𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟‘ “<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴔, 𐴀𐴝𐴉𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘𐴧𐴠𐴥; 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴀𐴝𐴣𐴊𐴝𐴤𐴌𐴠 𐴘𐴡𐴥 𐴊𐴠𐴑𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴦, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴡 𐴇𐴞𐴥𐴀𐴕 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌𐴠 𐴎𐴝𐴕𐴡𐴒𐴡𐴥𐴘, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴊𐴝𐴤𐴘𐴠 𐴊𐴠𐴑𐴠𐴥𐴌, 𐴓𐴠𐴚𐴠 𐴀𐴝𐴥𐴣𐴍𐴠𐴌, 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴌, 𐴕𐴝𐴥𐴉𐴝𐴚𐴠 𐴉𐴟𐴥𐴕𐴠𐴌, 𐴔𐴟𐴌𐴟𐴊𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴌.</char> <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" /><char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴁𐴝𐴤, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴕𐴊𐴝𐴐𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥.“</char><verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴈𐴡𐴥𐴁𐴡𐴌𐴒𐴗𐴝 𐴒𐴟𐴥𐴕 𐴁𐴝𐴐𐴝𐴥 𐴓𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴑𐴞𐴦 𐴏𐴝𐴘𐴃𐴡𐴥 𐴒𐴞𐴀𐴓𐴝 𐴊𐴠𐴥؟ 𐴁𐴡𐴘𐴧𐴝𐴌𐴠 𐴓𐴡𐴌𐴠 𐴊𐴠 𐴇𐴡𐴥𐴙𐴌 𐴕𐴠𐴥؟</char> <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" /><char style="wj">𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴏𐴝𐴘𐴃𐴡𐴥 𐴒𐴞𐴀𐴓𐴝 𐴊𐴠𐴥؟ 𐴁𐴝𐴌𐴞𐴥𐴑 𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴕𐴠𐴥؟ 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴝𐴔𐴞-𐴊𐴝𐴔𐴞 𐴇𐴡𐴦𐴌 𐴉𐴞𐴣𐴊𐴞𐴥 𐴌𐴡𐴚𐴎𐴟𐴙𐴚𐴒𐴝 𐴒𐴡𐴌𐴞𐴥 𐴏𐴡𐴓𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴌𐴝𐴎𐴔𐴡𐴇𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴠𐴥𐴕𐴝.</char> <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" /><char style="wj">𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴏𐴝𐴘𐴃𐴡𐴥 𐴒𐴞𐴀𐴓𐴝 𐴊𐴠𐴥؟ 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴁𐴞 𐴕𐴠𐴥؟ 𐴀𐴡𐴥𐴘, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴕𐴡𐴁𐴞𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴡𐴌𐴠.</char> <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</char></para>
  <para style="q1" vid="LUK 7:27">
    <char style="wj">’𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴥𐴁𐴡𐴌𐴒𐴗𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴒𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌,</char></para>
  <para style="q2" vid="LUK 7:27">
    <char style="wj">𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴒𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴡𐴣𐴃𐴢 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">7‏:27 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="MAL 3:1">𐴔𐴝𐴓𐴝𐴑𐴞𐴥 3‏:1</ref>
        </char>
      </char>
    </note><verse eid="LUK 7:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="LUK 7:28" />
    <char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴝𐴥𐴘; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠𐴁𐴧𐴠 𐴐𐴡𐴥𐴣𐴍𐴡, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌.“</char><verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘, 𐴀𐴝𐴓𐴧𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴖𐴝𐴓𐴝 𐴊𐴠 𐴔𐴝𐴕𐴞𐴓𐴡𐴘𐴧𐴠𐴥. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴕𐴡 𐴓𐴡𐴘, 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴑𐴞𐴦 𐴓𐴡𐴘 𐴉𐴟𐴥𐴖𐴝𐴕 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟ 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴞𐴘𐴡𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝؟</char> <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴝𐴎𐴝𐴌𐴡𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀 𐴊𐴠,</char></para>
  <para style="q1" vid="LUK 7:32">
    <char style="wj">’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴝𐴐𐴞𐴤 𐴁𐴝𐴎𐴝𐴘𐴧𐴞𐴥,</char></para>
  <para style="q2" vid="LUK 7:32">
    <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡𐴥 𐴕𐴝𐴏𐴡;</char></para>
  <para style="q1" vid="LUK 7:32">
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴞𐴓𐴝𐴑𐴡𐴌 𐴎𐴝𐴌𐴞 𐴒𐴝𐴘𐴧𐴞𐴥,</char></para>
  <para style="q2" vid="LUK 7:32">
    <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡𐴥 𐴈𐴝𐴣𐴊𐴡.‘</char><verse eid="LUK 7:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="LUK 7:33" />
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴀𐴝𐴀𐴘𐴢 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴌𐴟𐴄𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴕𐴝𐴥 𐴈𐴝𐴥𐴀, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴀 𐴊𐴠, ’𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴟𐴥𐴃𐴠 𐴉𐴝𐴘𐴧𐴠𐴥.‘</char> <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" /><char style="wj">𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴀𐴘𐴢 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴏𐴡𐴀, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴉𐴞𐴃𐴝𐴥𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴥𐴌𐴝𐴁𐴑𐴟𐴌, 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴟𐴏𐴃𐴡𐴥.‘</char> <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴒𐴞𐴘𐴝𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴞𐴘𐴝𐴕𐴠 𐴏𐴡𐴓𐴡𐴘𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.“</char><verse eid="LUK 7:35" /></para>
  <para style="s1">𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥, 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴇𐴠𐴥 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴖𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴘 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />𐴇𐴠𐴥 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴀𐴞𐴏𐴝𐴤 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴖𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴇𐴝𐴥𐴣𐴌𐴞𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴣𐴃𐴡𐴌 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴡𐴃𐴧𐴟 𐴄𐴠𐴥𐴚𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴃𐴞𐴥𐴘𐴝𐴘, 𐴈𐴝𐴣𐴊𐴞-𐴈𐴝𐴣𐴊𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴡𐴌 𐴉𐴝𐴕𐴞𐴥 𐴓𐴡𐴥𐴘 𐴁𐴞𐴥𐴎𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴏𐴟𐴓𐴢 𐴓𐴡𐴘 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴣𐴏𐴞𐴥𐴊𐴞𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴃𐴢 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥 𐴀𐴝𐴣𐴃𐴡𐴌 𐴒𐴟𐴥𐴕 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠.<verse eid="LUK 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39" />𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴖𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴎𐴝𐴙𐴕𐴃𐴡, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴇𐴡𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴊𐴡𐴥𐴌𐴠𐴌 𐴊𐴠; 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴃𐴡 𐴈𐴡𐴥𐴌𐴝𐴉𐴢.“<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴀𐴝𐴏𐴠𐴤.“</char></para>
  <para style="p" vid="LUK 7:40">𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ” 𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴈𐴡𐴀𐴘𐴢 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.“<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />
    <char style="wj">”𐴀𐴠𐴎𐴧𐴡𐴕 𐴇𐴡𐴎𐴧𐴡-𐴊𐴡𐴦𐴘𐴝𐴃𐴧𐴟 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴇𐴡𐴎𐴧𐴡𐴊𐴝𐴥𐴌 𐴀𐴝𐴏𐴠𐴤: 𐴀𐴠𐴑𐴎𐴡𐴕𐴠 𐴓𐴡𐴘𐴧𐴠𐴥 𐴉𐴝𐴣𐴏𐴢 𐴐𐴡𐴥𐴃𐴢 𐴊𐴞𐴕𐴝𐴥𐴌,</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">7‏:41 </char>
      <char style="ft" closed="false">𐴀𐴠𐴑𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴀𐴠𐴑 𐴊𐴞𐴕𐴡𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌 (𐴏𐴡𐴀 <char style="xt"><ref loc="MAT 20:2">𐴔𐴡𐴃𐴞 20‏:2</ref></char>).</char>
    </note> <char style="wj">𐴀𐴝𐴌 𐴀𐴠𐴑𐴎𐴡𐴕𐴠 𐴓𐴡𐴘𐴧𐴠𐴥 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢 𐴊𐴞𐴕𐴝𐴥𐴌.</char> <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴣𐴎𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕𐴡𐴌 𐴇𐴡𐴎𐴧𐴡 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠. 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴡𐴕𐴠 𐴁𐴞𐴐𐴞𐴤 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡؟“</char><verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴔𐴡𐴎𐴞𐴕، 𐴎𐴝𐴌 𐴕𐴞𐴑𐴞 𐴁𐴞𐴐𐴞𐴤 𐴇𐴡𐴎𐴧𐴡 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠 𐴀𐴞𐴥𐴃𐴠.“</para>
  <para style="p" vid="LUK 7:43">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠 <char style="wj">”𐴃𐴟𐴀𐴛 𐴏𐴡𐴥𐴘𐴧𐴞 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.“</char><verse eid="LUK 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44" />𐴁𐴝𐴦𐴊𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴉𐴞𐴥𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴀𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴊𐴠𐴑𐴡𐴥𐴌 𐴕𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴘𐴓𐴝𐴤𐴔; 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴡𐴦 𐴊𐴟𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴉𐴝𐴕𐴞𐴥 𐴕𐴡𐴥 𐴊𐴡𐴦, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴡𐴌 𐴉𐴝𐴕𐴞𐴥 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌 𐴉𐴡𐴦 𐴁𐴞𐴥𐴎𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴓𐴢 𐴓𐴡𐴘 𐴉𐴟𐴣𐴏𐴞𐴥𐴊𐴞𐴘𐴠.</char> <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" /><char style="wj">𐴃𐴟𐴀𐴛 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴂𐴧𐴝𐴤 𐴕𐴡𐴥 𐴊𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴧𐴞 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴡𐴦𐴃𐴢 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥𐴘𐴝 𐴁𐴡𐴕 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" /><char style="wj">𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴃𐴠𐴓𐴢 𐴕𐴡𐴥 𐴊𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴡𐴦𐴃𐴢 𐴀𐴝𐴣𐴃𐴡𐴌 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠.</char> <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴒𐴟𐴕𐴝𐴤 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴘𐴡, 𐴀𐴞𐴁𐴝𐴤𐴌 𐴇𐴠𐴥 𐴒𐴟𐴕𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴞𐴐𐴞𐴤 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴝𐴌𐴠𐴥 𐴈𐴡𐴔 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴔 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥.“</char><verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠.“</char><verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴈𐴡𐴖𐴝𐴤𐴇𐴡𐴘 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴇𐴡𐴕, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴒𐴟𐴕𐴝𐴤 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴠𐴥؟“<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴞𐴔𐴝𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴝𐴏𐴝𐴘𐴧𐴠𐴥; 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴡𐴦𐴒𐴡𐴥𐴘.“</char><verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s1">𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴊𐴞𐴘𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴐𐴡𐴥𐴀𐴌𐴠-𐴐𐴡𐴥𐴀𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴌𐴝-𐴉𐴝𐴌𐴝 𐴎𐴝𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴕𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴀𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴐𐴟𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴒𐴡𐴔 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢; 𐴃𐴝𐴌𐴝𐴥 𐴀𐴡𐴥𐴙𐴓𐴊𐴠: 𐴔𐴡𐴌𐴞𐴘𐴝𐴔, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞 𐴋𐴝𐴑𐴠, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴁𐴟𐴥𐴃𐴢 𐴕𐴠𐴦𐴙𐴓𐴧𐴞𐴥𐴓𐴢; <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />𐴅𐴡𐴀𐴝𐴕𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴀𐴟𐴎𐴞𐴌 𐴑𐴟𐴎𐴝𐴌𐴡𐴌 𐴁𐴡𐴖𐴢; 𐴏𐴡𐴏𐴝𐴥𐴕𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢. 𐴃𐴝𐴌𐴝𐴥 𐴕𐴞𐴎𐴡𐴌 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴓𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌<note caller="+" style="f"><char style="fr" closed="false">8‏:3 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa">𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 </char> </note> 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.<verse eid="LUK 8:3" /></para>
  <para style="s1">𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴍𐴡𐴘𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 13:1-9">𐴔𐴡𐴃𐴢 13‏:1‏-9</ref>; <ref loc="MRK 4:1-9">𐴔𐴝𐴑 4‏:1‏-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴡𐴃𐴧𐴞𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴈𐴡𐴘𐴧𐴠𐴥: <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" /><char style="wj">”𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴍𐴡𐴘𐴝 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴄𐴧𐴡 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴐𐴞𐴥𐴣𐴍𐴠𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴌𐴝𐴏𐴃𐴝𐴌</char><note caller="+" style="f"><char style="fr" closed="false">8‏:5 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa">𐴀𐴝𐴙𐴓𐴡𐴌 </char> </note> <char style="wj">𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢; 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴟𐴥𐴣𐴌𐴝𐴕 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠.</char> <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" /><char style="wj">𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴡𐴐𐴝𐴤 𐴕𐴡𐴥 𐴉𐴝𐴦 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴝𐴥𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴉𐴟𐴥𐴖𐴝𐴘𐴒𐴞𐴘𐴡𐴘.</char> <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" /><char style="wj">𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴑𐴠𐴣𐴍𐴝𐴁𐴡𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴠𐴣𐴍𐴝𐴁𐴡𐴕 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴞𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴏𐴞𐴁𐴞 𐴌𐴝𐴙𐴑𐴧𐴠𐴥.</char> <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴒𐴡𐴔 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢; 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴙𐴄𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴒𐴟𐴕 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴊𐴡𐴥𐴙𐴅𐴧𐴠.“</char></para>
  <para style="p" vid="LUK 8:8">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴥𐴕𐴡.“</char><verse eid="LUK 8:8" /></para>
  <para style="s1">𐴔𐴠𐴀𐴏𐴝𐴓𐴡𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢</para>
  <para style="r">(<ref loc="MAT 13:10-17">𐴔𐴡𐴃𐴢 13‏:10‏-17</ref>; <ref loc="MRK 4:10-12">𐴔𐴝𐴑 4‏:10‏-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴑𐴞𐴦؟“ <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴒𐴟𐴉𐴡𐴕𐴞𐴌𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴠 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝, 𐴎𐴠𐴀𐴕𐴠</char></para>
  <para style="q1" vid="LUK 8:10">
    <char style="wj">’𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴘𐴓𐴠𐴥 𐴘𐴡 𐴕𐴡 𐴊𐴠𐴑𐴠𐴥,</char></para>
  <para style="q2" vid="LUK 8:10">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴉𐴟𐴥𐴕𐴞𐴓𐴠 𐴘𐴡 𐴕𐴡 𐴁𐴟𐴎𐴠𐴥.‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">8‏:10 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 6:9">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 6‏:9</ref>
        </char>
      </char>
    </note><verse eid="LUK 8:10" /></para>
  <para style="s1">𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴍𐴡𐴘𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴁𐴟𐴎𐴝𐴥𐴘𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MAT 13:18-23">𐴔𐴡𐴃𐴢 13‏:18‏-23</ref>; <ref loc="MRK 4:13-20">𐴔𐴝𐴑 4‏:13‏-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />
    <char style="wj">”𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴝𐴀𐴕: 𐴁𐴞𐴏𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔.</char> <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" /><char style="wj">𐴌𐴝𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴟𐴥𐴕𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴧𐴟 𐴑𐴝𐴓𐴝𐴔 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟 𐴀𐴝𐴕𐴠𐴤 𐴀𐴝𐴦𐴌 𐴕𐴠𐴅𐴝𐴃𐴢 𐴕𐴡 𐴉𐴝𐴦.</char> <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" /><char style="wj">𐴐𐴞𐴥𐴓𐴢 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴞𐴓𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴐𐴞𐴥𐴛𐴡𐴌 𐴕𐴡𐴥 𐴒𐴝𐴏𐴝𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴡𐴑𐴃𐴡𐴥 𐴓𐴧𐴝 𐴁𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴑𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴌𐴠 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴉𐴞𐴏𐴧𐴝𐴥 𐴔𐴝𐴌𐴠.</char> <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" /><char style="wj">𐴎𐴠 𐴁𐴞𐴏𐴢 𐴑𐴠𐴣𐴍𐴝𐴁𐴡𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴃𐴠𐴥-𐴈𐴝𐴍𐴝𐴘𐴃𐴠𐴥 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴘𐴠, 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴀𐴝𐴘𐴝𐴐𐴞-𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴞𐴁𐴞 𐴌𐴝𐴑𐴠𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴓𐴝 𐴉𐴝𐴒𐴞 𐴕𐴡 𐴃𐴡𐴦𐴣𐴌𐴠.</char> <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴎𐴠 𐴁𐴞𐴏𐴢 𐴒𐴡𐴔 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴒𐴡𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴔 𐴊𐴞𐴓𐴠 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴠, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴊𐴡𐴥𐴌𐴞 𐴌𐴝𐴑𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴝.</char><verse eid="LUK 8:15" /></para>
  <para style="s1">𐴏𐴠𐴌𐴝𐴑𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 4:21-25">𐴔𐴝𐴑 4‏:21‏-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />
    <char style="wj">”𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴡 𐴏𐴠𐴌𐴝𐴑 𐴊𐴡𐴥𐴌𐴝𐴘 𐴃𐴝𐴥𐴌𐴝 𐴓𐴡𐴥𐴘 𐴎𐴝𐴥𐴉𐴝𐴘 𐴕𐴡 𐴌𐴝𐴑𐴠𐴥, 𐴘𐴝𐴥 𐴉𐴝𐴓𐴡𐴚𐴡𐴌 𐴃𐴡𐴓𐴠 𐴘𐴡𐴥 𐴕𐴡 𐴌𐴝𐴑𐴠𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴥𐴕𐴝 𐴌𐴝𐴑𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴀𐴌 𐴊𐴠𐴑𐴠𐴥.</char> <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴟𐴌𐴇𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘 𐴎𐴞𐴀𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴘𐴡𐴥 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘 𐴎𐴞𐴀𐴕 𐴎𐴝𐴕𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡 𐴀𐴝𐴦𐴌 𐴑𐴟𐴥𐴓𐴝𐴇𐴝𐴓𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴉𐴟𐴥𐴕𐴡𐴌 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴝𐴃𐴧𐴟 𐴕𐴞𐴑𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴝𐴃𐴧𐴟 𐴕𐴞𐴑𐴞 𐴕𐴝𐴥𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴁𐴡𐴥𐴓𐴞 𐴁𐴝𐴥𐴉𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="LUK 8:18" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕</para>
  <para style="r">(<ref loc="MAT 12:46-50">𐴔𐴡𐴃𐴢 12‏:46‏-50</ref>; <ref loc="MRK 3:31-35">𐴔𐴝𐴑 3‏:31‏-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴎𐴝𐴔𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠𐴌. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴁𐴝𐴀𐴌𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴃𐴡 𐴏𐴝𐴌.“<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.“</char><verse eid="LUK 8:21" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴟𐴖𐴝𐴥𐴕 𐴃𐴝𐴥𐴔𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 8:23-27">𐴔𐴡𐴃𐴢 8‏:23‏-27</ref>; <ref loc="MRK 4:35-41">𐴔𐴝𐴑 4‏:35‏-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥, 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴋𐴞𐴀𐴌 𐴀𐴡 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴉𐴝𐴌𐴝𐴤𐴘.“</char> 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴐𐴝𐴥 𐴓𐴡𐴥𐴘𐴧𐴠. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴀𐴞𐴏𐴝𐴤 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. 𐴀𐴝𐴦𐴌 𐴋𐴞𐴀𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴃𐴟𐴖𐴝𐴥𐴕 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴕𐴡𐴦 𐴒𐴝𐴥𐴕 𐴉𐴝𐴕𐴞𐴥 𐴓𐴡𐴥𐴘 𐴁𐴡𐴥𐴌𐴞𐴎𐴝𐴌𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴊𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴡𐴥 𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴌𐴞𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘!“</para>
  <para style="p" vid="LUK 8:24">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴀𐴟𐴍𐴞𐴤 𐴁𐴡𐴘𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥𐴌 𐴒𐴡𐴙𐴌𐴡𐴌𐴠 𐴊𐴡𐴥𐴀𐴣𐴑 𐴊𐴞𐴘𐴠𐴥, 𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴡𐴕 𐴀𐴡𐴥𐴘 𐴃𐴝𐴥𐴔𐴝𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴇𐴡𐴍𐴠𐴥؟“</char></para>
  <para style="p" vid="LUK 8:25">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘 𐴀𐴝𐴦𐴌 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴇𐴡𐴕؟ 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴊𐴠 𐴁𐴡𐴘𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴓𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴝𐴕𐴠!“<verse eid="LUK 8:25" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 8:28-34">𐴔𐴡𐴃𐴢 8‏:28‏-34</ref>; <ref loc="MRK 5:1-20">𐴔𐴝𐴑 5‏:1‏-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴠𐴌𐴝𐴏𐴠𐴥𐴕𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴝𐴓𐴞𐴓𐴢 𐴋𐴞𐴀𐴌 𐴔𐴟𐴀𐴕𐴃𐴟. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴑𐴟𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴓𐴝𐴙𐴔𐴧𐴠𐴥, 𐴇𐴠𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴊𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌 𐴕𐴡 𐴉𐴞𐴣𐴊𐴠𐴤𐴌 𐴊𐴠 𐴁𐴞𐴐𐴞𐴤 𐴊𐴠𐴌𐴞 𐴓𐴡𐴥𐴃𐴞, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞 𐴈𐴡𐴁𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴡. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴀𐴞𐴏𐴝𐴤, 𐴀𐴝𐴓𐴧𐴝 𐴃𐴝𐴥𐴓𐴝𐴌 𐴉𐴟𐴖𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴑𐴞𐴦 𐴈𐴝𐴔 𐴀𐴝𐴏𐴠𐴤؟ 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴡𐴎𐴞𐴘𐴝 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥.“ <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴠𐴥 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠. 𐴇𐴠𐴥 𐴅𐴞𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴉𐴝𐴘𐴃𐴡; 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴏𐴞𐴥𐴘𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴌𐴞𐴥 𐴓𐴡𐴥𐴘 𐴁𐴝𐴣𐴊𐴞𐴥 𐴉𐴝𐴀𐴌𐴝 𐴊𐴞𐴥 𐴌𐴝𐴑𐴝𐴤 𐴎𐴝𐴘𐴃𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴏𐴞𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴃𐴡, 𐴀𐴝𐴦𐴌 𐴁𐴟𐴥𐴃𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴃𐴡𐴥𐴘.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴌 𐴕𐴝𐴔 𐴑𐴞𐴦؟“</char></para>
  <para style="p" vid="LUK 8:30">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴝𐴥𐴑“ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴡𐴗𐴀𐴃𐴧𐴗𐴝 𐴁𐴟𐴥𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴊𐴠, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴡𐴄𐴝𐴥𐴘 𐴒𐴝𐴣𐴃𐴡𐴃𐴢 𐴎𐴝𐴘𐴃𐴡 𐴇𐴡𐴥𐴑𐴟𐴔 𐴕𐴡 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝.<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />𐴇𐴠𐴥𐴍𐴠 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴎𐴝𐴥𐴑 𐴐𐴟𐴥𐴖𐴡𐴌 𐴏𐴡𐴌𐴠𐴌 𐴊𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴁𐴟𐴥𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴇𐴠𐴥 𐴐𐴟𐴥𐴖𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴃𐴡𐴘 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝. 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴠𐴥 𐴁𐴟𐴥𐴃𐴧𐴟𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴢 𐴐𐴟𐴥𐴖𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴧𐴠𐴒𐴡𐴘, 𐴃𐴡𐴥𐴘 𐴐𐴟𐴥𐴖𐴡𐴌𐴡𐴌 𐴎𐴝𐴥𐴑𐴧𐴗𐴝 𐴉𐴝𐴀𐴌𐴡𐴌 𐴇𐴝𐴙𐴕𐴊𐴝𐴤 𐴁𐴝𐴥𐴘 𐴎𐴟𐴌𐴠 𐴋𐴞𐴀𐴃𐴢 𐴊𐴟𐴣𐴌𐴊𐴞𐴘𐴠𐴥 𐴀𐴝𐴦𐴌 𐴋𐴟𐴉𐴞𐴥 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />𐴐𐴟𐴥𐴖𐴡𐴌 𐴏𐴡𐴌𐴡𐴘𐴝 𐴒𐴟𐴥𐴕𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴣𐴌𐴊𐴞𐴘𐴠𐴥 𐴀𐴝𐴦𐴌 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴒𐴝𐴚 𐴎𐴝𐴒𐴝𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴥𐴁𐴡𐴌 𐴊𐴞𐴥𐴘𐴠. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />𐴁𐴝𐴦𐴊𐴠 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴘𐴢 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴃𐴧𐴟 𐴁𐴟𐴥𐴃𐴢 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴟𐴥𐴣𐴐𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤; 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥 𐴔𐴝𐴦𐴔𐴠𐴓𐴝 𐴒𐴝𐴥𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴀𐴙𐴓𐴢 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴒𐴠𐴌𐴝𐴏𐴠𐴥𐴕𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴥𐴑𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴎𐴝𐴘𐴃𐴡𐴒𐴡𐴥𐴘 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴦𐴌 𐴓𐴝𐴙𐴒𐴧𐴠𐴥; 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="LUK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38" />𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴃𐴧𐴟 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴠𐴦𐴙𐴓𐴧𐴞𐴥𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞𐴘𐴠𐴥, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" /><char style="wj">”𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴎𐴡𐴦𐴒𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴎𐴠 𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴡𐴤𐴒𐴡𐴘.“</char> 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴓𐴧𐴝 𐴎𐴠 𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="LUK 8:39" /></para>
  <para style="s1">𐴎𐴝𐴥𐴘𐴌𐴝𐴏𐴡𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴡𐴦𐴌 𐴏𐴟𐴥𐴘𐴧𐴠 𐴊𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝</para>
  <para style="r">(<ref loc="MAT 9:18-26">𐴔𐴡𐴃𐴢 9‏:18‏-26</ref>; <ref loc="MRK 5:21-43">𐴔𐴝𐴑 5‏:21‏-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴏𐴃𐴠𐴑𐴁𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴏𐴡𐴦𐴛 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴎𐴝𐴥𐴘𐴌𐴝𐴏𐴢 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴏𐴡𐴥𐴊𐴧𐴝𐴌; 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴡𐴦𐴃𐴢 𐴉𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝; <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴝𐴌𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌𐴅𐴝 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝 𐴔𐴡𐴌𐴞𐴎𐴝𐴌𐴒𐴡𐴥𐴘.</para>
  <para style="p" vid="LUK 8:42">𐴀𐴞𐴥𐴁𐴝 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴄𐴠𐴥𐴓𐴝𐴄𐴠𐴓𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴑𐴟𐴥𐴕𐴎𐴝𐴌𐴞 𐴎𐴝𐴥𐴌 𐴊𐴠 𐴁𐴝𐴌𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴋𐴝𐴑𐴄𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴡𐴥𐴏𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠; <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />𐴇𐴞𐴥𐴁𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴞𐴏𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌𐴡𐴌 𐴇𐴝𐴣𐴌𐴝 𐴏𐴟𐴥𐴘𐴧𐴠, 𐴃𐴡𐴥𐴘 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴑𐴟𐴥𐴕𐴎𐴝𐴌𐴞 𐴁𐴡𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="LUK 8:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴡𐴕𐴠 𐴏𐴟𐴥𐴘𐴧𐴠؟“</char></para>
  <para style="p" vid="LUK 8:45">𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴥𐴎𐴟𐴌, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴊𐴠 𐴎𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴄𐴠𐴥𐴓𐴝𐴄𐴠𐴓𐴞 𐴒𐴡𐴌𐴠𐴥𐴌.“<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴡𐴕𐴧𐴗𐴝𐴤𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴟𐴥𐴘𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴕𐴠𐴦𐴓𐴞 𐴒𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴀𐴝𐴀𐴛 𐴇𐴡𐴘 𐴉𐴝𐴙𐴅𐴧𐴞𐴥.“</char><verse eid="LUK 8:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47" />𐴇𐴠𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴘𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴇𐴞𐴥𐴁𐴝 𐴇𐴝𐴥𐴌𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴇𐴞𐴥𐴁𐴝 𐴇𐴝𐴉𐴞-𐴇𐴝𐴉𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴥𐴘𐴧𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴁𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴇𐴞𐴥𐴀𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡 𐴎𐴞𐴥𐴀, 𐴃𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴠 𐴃𐴡𐴌𐴠𐴥 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴝𐴦𐴒𐴡𐴥𐴘.“</char><verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />𐴀𐴞𐴥𐴁𐴝 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴒𐴗𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴎𐴞𐴥𐴀 𐴎𐴟𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘; 𐴀𐴟𐴏𐴃𐴝𐴃𐴡𐴌𐴠 𐴀𐴝𐴌 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.“<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴇𐴞𐴥𐴁𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“</char><verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />𐴀𐴞𐴥𐴁𐴝 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴞, 𐴉𐴞𐴃𐴡𐴌, 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 𐴘𐴝𐴑𐴟𐴁𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴌𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴃𐴡 𐴕𐴡𐴥 𐴊𐴠. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴇𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴑 𐴑𐴞𐴓𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴡 𐴈𐴝𐴣𐴊𐴞𐴘𐴡𐴥, 𐴀𐴞𐴁𐴝𐴤 𐴔𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴟𐴥𐴔 𐴎𐴝𐴌 𐴊𐴠.“</char><verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴥𐴣𐴐𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴘 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴑𐴞 𐴇𐴞𐴥𐴁𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴢 𐴊𐴡𐴥𐴌𐴞 𐴋𐴝𐴑 𐴔𐴝𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡 𐴎𐴞𐴥𐴀, 𐴀𐴟𐴄𐴢.“</char> <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴌𐴝𐴕 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝 𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴟𐴍𐴞𐴤 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠. 𐴁𐴝𐴦𐴊𐴠 𐴈𐴝𐴥𐴘𐴃𐴡 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴊𐴞𐴦 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />𐴇𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡 𐴇𐴡𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴞𐴐𐴡𐴥𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s1">𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴕𐴟𐴥𐴕𐴡𐴌𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴡𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 10:5-15">𐴔𐴡𐴃𐴢 10‏:5‏-15</ref>; <ref loc="MRK 6:7-13">𐴔𐴝𐴑 6‏:7‏-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴝𐴃𐴝𐴘, 𐴉𐴡𐴃𐴧𐴞𐴥 𐴋𐴡𐴙𐴓𐴧𐴝 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴠𐴦𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴉𐴡𐴣𐴃𐴡𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴓𐴡𐴘𐴎𐴝𐴘𐴧𐴡𐴥: 𐴕𐴡 𐴓𐴝𐴍𐴞𐴥, 𐴕𐴡 𐴇𐴡𐴥𐴙𐴓𐴧𐴝, 𐴕𐴡 𐴈𐴝𐴥𐴕𐴝, 𐴕𐴡 𐴄𐴞𐴛𐴝, 𐴕𐴡 𐴁𐴝𐴃𐴧𐴞𐴥 𐴇𐴡𐴦𐴌.</char> <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴁𐴝 𐴇𐴠𐴥 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴐𐴡𐴥𐴀𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴕𐴡𐴥 𐴎𐴡𐴦𐴒𐴡𐴥𐴘 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴝𐴥𐴑𐴞𐴘𐴡.</char> <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" /><char style="wj">𐴎𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴠𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴎𐴝𐴘𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴃𐴡𐴓𐴧𐴝𐴌 𐴊𐴟𐴥𐴙𐴓𐴢 𐴎𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥.“</char> <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴡𐴖𐴝𐴕𐴝 𐴓𐴡𐴘 𐴉𐴝𐴌𐴝-𐴉𐴝𐴌𐴝 𐴎𐴝𐴘, 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="LUK 9:6" /></para>
  <para style="s1">𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴀𐴡𐴓𐴎𐴡𐴥𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 14:1-12">𐴔𐴡𐴃𐴢 14‏:1‏-12</ref>; <ref loc="MRK 6:14-29">𐴔𐴝𐴑 6‏:14‏-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴈𐴠𐴥𐴌𐴟𐴊𐴠, 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴓𐴎𐴡𐴥𐴓𐴡𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠, <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, 𐴀𐴝𐴒𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴕𐴡𐴁𐴞 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴈𐴡𐴓𐴧𐴝 𐴊𐴠 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴝 𐴁𐴝𐴥𐴘𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴁𐴝𐴤 𐴇𐴡𐴕 𐴎𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴥𐴕𐴞𐴌؟“ 𐴇𐴞𐴥𐴘𐴝 𐴓𐴡𐴥𐴃𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 9:9" /></para>
  <para style="s1">𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴁𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 14:13-21">𐴔𐴡𐴃𐴢 14‏:13‏-21</ref>; <ref loc="MRK 6:30-44">𐴔𐴝𐴑 6‏:30‏-44</ref>; <ref loc="JHN 6:1-14">𐴘𐴡 6‏:1‏-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴀𐴘𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥. 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢, 𐴁𐴠𐴃𐴏𐴝𐴥𐴘𐴊𐴝 𐴈𐴡𐴀 𐴊𐴠 𐴉𐴝𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴎𐴟𐴘𐴃𐴠𐴥𐴒𐴡𐴌𐴞 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴘 𐴉𐴝𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴞𐴓𐴢. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴁𐴠𐴙𐴓𐴢 𐴒𐴡𐴥𐴓𐴞𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴇𐴠𐴥 𐴁𐴝𐴌𐴡𐴥 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴝𐴌𐴝𐴥 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴉𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴒𐴝𐴚 𐴎𐴝𐴒𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴎𐴝𐴘 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴝𐴌 𐴎𐴝𐴒𐴝 𐴃𐴟𐴖𐴝𐴘 𐴉𐴝𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴏𐴞𐴤 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴃𐴡 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴡𐴐𐴡𐴥𐴃𐴞-𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴒𐴝.“<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴡𐴦.“</char></para>
  <para style="p" vid="LUK 9:13">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴊𐴠 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴌𐴟𐴄𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝𐴥 𐴔𐴝𐴏𐴢 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴘 𐴃𐴝𐴌𐴝𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴈𐴝𐴥𐴕𐴝 𐴑𐴞𐴕𐴞 𐴀𐴝𐴙𐴕𐴃𐴝𐴤𐴔𐴁𐴡𐴘 𐴕𐴠𐴥؟“ <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴍𐴠 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴁𐴠𐴍𐴝𐴀𐴙𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.</para>
  <para style="p" vid="LUK 9:14">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴀𐴠𐴑 𐴋𐴝𐴀𐴘𐴡𐴃𐴢 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢 𐴎𐴡𐴕 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢 𐴎𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴡.“</char> <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴝𐴘𐴧𐴠. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴠𐴥 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴌𐴟𐴄𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝𐴥 𐴔𐴝𐴏𐴢 𐴏𐴟𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴝𐴥𐴚𐴒𐴞-𐴁𐴝𐴥𐴚𐴒𐴞 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴍𐴞𐴊𐴞 𐴁𐴡𐴓𐴧𐴝. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />𐴃𐴝𐴌𐴝𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴞 𐴈𐴝𐴥𐴘𐴧𐴠. 𐴁𐴝𐴦𐴊𐴠 𐴎𐴠 𐴃𐴟𐴑𐴟𐴍𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴏𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴉𐴠𐴣𐴍𐴝𐴘 𐴓𐴡𐴦𐴘𐴢 𐴉𐴟𐴌𐴝 𐴁𐴝𐴌𐴡𐴥 𐴁𐴝𐴥𐴙𐴌 𐴁𐴡𐴥𐴙𐴅𐴧𐴠.<verse eid="LUK 9:17" /></para>
  <para style="s1">𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 16:13-19">𐴔𐴡𐴃𐴢 16‏:13‏-19</ref>; <ref loc="MRK 8:27-29">𐴔𐴝𐴑 8‏:27‏-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />𐴀𐴠𐴑𐴁𐴝𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴇𐴝𐴥𐴓𐴞𐴒𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴀𐴝𐴦𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀؟“</char><verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴁𐴡𐴥𐴓𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝; 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀 𐴊𐴠, 𐴕𐴡𐴁𐴞 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢; 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀 𐴊𐴠, 𐴀𐴝𐴒𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴕𐴡𐴁𐴞 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠.“<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴈𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕؟“</char> 𐴉𐴞𐴃𐴡𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴀𐴏𐴞𐴤.“<verse eid="LUK 9:20" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴦𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 16:21-28">𐴔𐴡𐴃𐴢 16‏:21‏-28</ref>; <ref loc="MRK 8:30">𐴔𐴝𐴑 8‏:30</ref>; <ref loc="MRK 9:1">9‏:1</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴃𐴡𐴤 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴟𐴑 𐴉𐴝𐴦 𐴉𐴡𐴌𐴞𐴁𐴡𐴥; 𐴀𐴝𐴦𐴌 𐴔𐴟𐴌𐴟𐴁𐴧𐴞, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔𐴡𐴃𐴧𐴟 𐴀𐴞𐴕𐴑𐴝𐴌 𐴇𐴝𐴥𐴘𐴁𐴡; 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴝𐴘𐴃𐴡𐴤 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴊𐴞𐴕 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴢 𐴁𐴡𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥 𐴏𐴝𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴏𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" /><char style="wj">𐴑𐴞𐴦 𐴓𐴝𐴉𐴢, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴉𐴝𐴦, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴠 𐴘𐴝𐴥𐴃𐴡 𐴓𐴟𐴏𐴧𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠؟</char> <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" /><char style="wj">𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴓𐴡𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤𐴌𐴠 𐴓𐴡𐴥𐴘 𐴐𐴡𐴥𐴌𐴔𐴝, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴘𐴠 𐴘𐴡𐴥 𐴐𐴡𐴥𐴌𐴔𐴝𐴘𐴁𐴡 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴡𐴌, 𐴁𐴝𐴉𐴢 𐴀𐴡𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴘𐴠 𐴀𐴝𐴘𐴁𐴡𐴤.</char><verse eid="LUK 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 9:27" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠𐴍𐴠𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴕𐴡𐴥 𐴊𐴠𐴑𐴞𐴥𐴃𐴠 𐴕𐴡 𐴔𐴡𐴌𐴞𐴁𐴡𐴥.“</char><verse eid="LUK 9:27" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴁𐴡𐴊𐴡𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘</para>
  <para style="r">(<ref loc="MAT 17:1-8">𐴔𐴡𐴃𐴢 17‏:1‏-8</ref>; <ref loc="MRK 9:2-8">𐴔𐴝𐴑 9‏:2‏-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴝𐴣𐴐𐴄𐴡 𐴊𐴞𐴕 𐴀𐴝𐴥𐴕𐴞𐴑 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴞𐴃𐴡𐴌 𐴀𐴡𐴌𐴠, 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌𐴠 𐴓𐴡𐴦𐴘𐴢 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴡𐴘. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴁𐴡𐴊𐴡𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌 𐴊𐴡𐴥𐴓𐴝 𐴀𐴡𐴥𐴘 𐴏𐴡𐴏𐴧𐴡𐴇𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />𐴀𐴝𐴏𐴞𐴔𐴁𐴞𐴃𐴢 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴟𐴀𐴏𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢. <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />𐴃𐴝𐴌𐴝𐴥 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴕𐴃𐴠𐴇𐴝𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴀𐴙𐴓𐴢, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />𐴉𐴞𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴟𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴥𐴔𐴉𐴝𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕𐴡𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴎𐴝𐴦𐴌𐴒𐴡𐴥𐴘 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴥𐴎𐴟𐴌, 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴏𐴞𐴤. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴍𐴠𐴥 𐴃𐴞𐴕 𐴕𐴝𐴥𐴕 𐴄𐴝𐴔𐴁𐴟 𐴄𐴝𐴑𐴞: 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝, 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴟𐴀𐴏𐴝𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴡𐴓𐴧𐴝.“ 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴕𐴞𐴎𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠.<verse eid="LUK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴞𐴘𐴟𐴥𐴓𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴞𐴘𐴟𐴥𐴓𐴝 𐴓𐴡𐴥𐴘 𐴏𐴝𐴥𐴘𐴎𐴝𐴌𐴒𐴡𐴘 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴋𐴡𐴦𐴌𐴝𐴀𐴙𐴓𐴢. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴀𐴛 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴞; 𐴀𐴞𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴡!“ <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />𐴀𐴝𐴁𐴝𐴏𐴢 𐴏𐴗𐴝𐴥 𐴀𐴝𐴙𐴐𐴧𐴝𐴤 𐴀𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴒𐴝𐴦𐴒𐴝 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴠 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡𐴥 𐴎𐴝𐴕𐴝.<verse eid="LUK 9:36" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴠-𐴉𐴝𐴘𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴟𐴖𐴝 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 17:14-18">𐴔𐴡𐴃𐴢 17‏:14‏-18</ref>; <ref loc="MRK 9:14-27">𐴔𐴝𐴑 9‏:14‏-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />𐴃𐴝𐴌𐴉𐴡𐴌 𐴊𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴝𐴀𐴌𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴊𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />𐴊𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥 𐴏𐴡𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴓𐴠𐴇𐴝𐴥𐴌 𐴀𐴠𐴑 𐴉𐴟𐴖𐴝. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴅𐴞𐴕𐴠 𐴊𐴡𐴥𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴥𐴇𐴡𐴕 𐴒𐴟𐴎𐴡𐴌𐴝𐴕 𐴔𐴝𐴌𐴠; 𐴘𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴉𐴡𐴌𐴝𐴁𐴝𐴘 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴉𐴠𐴥𐴕𐴝 𐴀𐴝𐴕𐴠𐴤. 𐴘𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴊𐴟𐴑 𐴊𐴞 𐴔𐴡𐴐𐴑𐴞𐴓𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴁𐴠 𐴀𐴠𐴌𐴞𐴊𐴠. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴇𐴠𐴥 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥 𐴕𐴠𐴦𐴓𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠.“<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴀𐴞𐴔𐴝𐴕 𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴀𐴣𐴌𐴝 𐴕𐴡𐴏𐴡𐴥𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴝𐴔؟ 𐴇𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴕𐴡𐴤.“</char><verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />𐴉𐴟𐴖𐴝 𐴖𐴝 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴁𐴟𐴥𐴃𐴧𐴗𐴝𐴘𐴠 𐴔𐴠𐴍𐴞𐴃𐴢 𐴀𐴝𐴣𐴏𐴝𐴥𐴌𐴞 𐴊𐴡𐴥𐴌𐴉𐴡𐴌𐴝𐴁𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴠𐴥 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥𐴌𐴠 𐴊𐴡𐴥𐴀𐴣𐴑 𐴊𐴞𐴥, 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴁𐴝𐴉𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴊𐴠𐴑𐴞𐴥 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.</para>
  <para style="s1" vid="LUK 9:43">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴘𐴧𐴠𐴥</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22-23">𐴔𐴡𐴃𐴢 17‏:22‏-23</ref>; <ref loc="MRK 9:30-32">𐴔𐴝𐴑 9‏:30‏-32</ref>)</para>
  <para style="p" vid="LUK 9:43">𐴎𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" /><char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴞𐴀𐴕 𐴈𐴝𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴘 𐴓𐴡𐴦, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.“</char> <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡 𐴁𐴟𐴎𐴞𐴥𐴃𐴡. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴟𐴑𐴝𐴘𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴎𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴇𐴠𐴥 𐴈𐴡𐴃𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴘𐴡𐴥 𐴋𐴡𐴦𐴌𐴝𐴘𐴃𐴡𐴥.<verse eid="LUK 9:45" /></para>
  <para style="s1">𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴕𐴧𐴗𐴝𐴤؟</para>
  <para style="r">(<ref loc="MAT 18:1-5">𐴔𐴡𐴃𐴢 18‏:1‏-5</ref>; <ref loc="MRK 9:33-37">𐴔𐴝𐴑 9‏:33‏-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞 𐴐𐴟𐴥𐴌𐴟 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴕𐴧𐴗𐴝𐴤 𐴈𐴡𐴀𐴘𐴢. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴌𐴠 𐴎𐴝𐴕𐴞, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴌𐴝 𐴉𐴟𐴖𐴝 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴒𐴡𐴥𐴌𐴞 𐴃𐴞𐴥𐴘𐴝𐴒𐴝𐴌𐴝𐴘𐴧𐴠, <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴀𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠𐴁𐴧𐴠 𐴐𐴡𐴥𐴣𐴍𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌.“</char><verse eid="LUK 9:48" /></para>
  <para style="s1">𐴎𐴠𐴦 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴕𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="MRK 9:38-40">𐴔𐴝𐴑 9‏:38‏-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴥𐴎𐴟𐴌, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔𐴠 𐴁𐴟𐴥𐴃𐴢 𐴕𐴠𐴦𐴓𐴝𐴌; 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴕𐴡𐴥 𐴊𐴡𐴥𐴌𐴠 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥.“<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴕𐴝𐴥 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴕𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝.“</char><verse eid="LUK 9:50" /></para>
  <para style="s1">𐴏𐴝𐴔𐴝𐴥𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴎𐴝𐴘𐴁𐴝𐴌 𐴊𐴞𐴕 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴓𐴡𐴘𐴧𐴠𐴥. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴒𐴠 𐴈𐴡𐴥𐴁𐴡𐴌𐴒𐴗𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴘 𐴏𐴝𐴔𐴝𐴥𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴝𐴌𐴝𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />𐴓𐴠𐴑𐴞𐴕 𐴇𐴠𐴥𐴍𐴞𐴘𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴡𐴉𐴡𐴥𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴀𐴟𐴎𐴟. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴡𐴦𐴙𐴕 𐴕𐴝𐴎𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴉𐴟𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴃𐴝𐴔 𐴕𐴠𐴥؟“ <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴉𐴞𐴥𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴌𐴟𐴀𐴌 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡;</char> <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴎𐴝𐴕 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠.“</char> 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴝𐴌𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴡𐴥𐴘.<verse eid="LUK 9:56" /></para>
  <para style="s1">𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="MAT 8:18-22">𐴔𐴡𐴃𐴢 8‏:18‏-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴝𐴏𐴃𐴝 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦𐴌, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴠𐴥𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴘𐴁𐴝, 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴎𐴝𐴘𐴧𐴟𐴔.“<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴐𐴞𐴥𐴘𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴒𐴝𐴣𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴝𐴇𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴇𐴡𐴕𐴡𐴤 𐴔𐴞𐴑𐴧𐴝𐴥 𐴎𐴝𐴒𐴝 𐴕𐴝𐴥𐴘.“</char><verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴝𐴘𐴧𐴡𐴤.“</char> 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴒𐴠 𐴀𐴝𐴀𐴛 𐴎𐴝𐴘 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴘𐴧𐴞𐴤.“<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴟𐴌𐴟𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴌𐴟𐴊𐴝𐴌𐴠 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴡𐴥𐴗𐴑𐴒𐴡𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴀𐴛 𐴎𐴝𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴡𐴤𐴒𐴡𐴘.“</char><verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />𐴀𐴝𐴌 𐴀𐴠𐴑𐴎𐴡𐴕𐴠 𐴘𐴡𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴒𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴁𐴞𐴊𐴝𐴘 𐴓𐴡𐴘 𐴀𐴝𐴘𐴧𐴞𐴤.“<verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴕𐴝𐴈𐴡𐴓𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴉𐴞𐴏𐴧𐴝𐴥 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡.“</char><verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s1">𐴇𐴡𐴥𐴙𐴃𐴧𐴡𐴌-𐴊𐴟𐴘 𐴎𐴡𐴕𐴡𐴌𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠, 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴇𐴡𐴥𐴙𐴃𐴧𐴡𐴌-𐴊𐴟𐴘 𐴎𐴡𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴒𐴠 𐴀𐴡 𐴐𐴡𐴥𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴎𐴝𐴒𐴝 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴎𐴠𐴍𐴠𐴥-𐴎𐴠𐴍𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴎𐴝𐴘𐴁𐴡. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴊𐴠 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴡𐴦𐴘𐴝 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴔; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴉𐴡𐴥𐴏𐴡𐴓𐴡𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴊𐴝𐴘𐴃𐴡 𐴊𐴡𐴦𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝.</char> <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" /><char style="wj">𐴎𐴡𐴦; 𐴉𐴟𐴥𐴕𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴌𐴝𐴚𐴑𐴟𐴣𐴙𐴌𐴡𐴌 𐴔𐴝𐴎𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌 𐴊𐴠.</char> <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" /><char style="wj">𐴇𐴡𐴕𐴡𐴤 𐴄𐴞𐴛𐴝𐴌 𐴎𐴝𐴓𐴞, 𐴇𐴡𐴥𐴙𐴓𐴧𐴝, 𐴘𐴝𐴥 𐴐𐴠𐴕𐴄𐴝𐴥𐴌 𐴕𐴡 𐴓𐴡𐴘𐴎𐴝𐴘𐴧𐴡𐴥; 𐴀𐴝𐴦𐴌 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥.</char><verse eid="LUK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴁𐴝, 𐴀𐴝𐴒𐴠 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ’𐴀𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴡𐴥𐴑.‘</char> <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" /><char style="wj">𐴎𐴡𐴊𐴞 𐴇𐴠𐴥𐴍𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴝𐴥𐴕𐴃𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴉𐴞𐴥𐴌𐴞 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴘𐴁𐴡𐴘.</char> <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" /><char style="wj">𐴇𐴠𐴥 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴘𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴊𐴠𐴦 𐴇𐴞𐴥𐴀𐴕 𐴈𐴝𐴥𐴘𐴧𐴡 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴀𐴘𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴟𐴎𐴟𐴌 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴉𐴝𐴘𐴁𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑. 𐴒𐴡𐴥𐴌𐴠-𐴒𐴡𐴥𐴌𐴠 𐴕𐴡 𐴒𐴟𐴥𐴌𐴞𐴘𐴡.</char><verse eid="LUK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴁𐴝, 𐴎𐴡𐴊𐴞 𐴇𐴠𐴥𐴍𐴞𐴘𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴞𐴀𐴕 𐴊𐴠𐴦 𐴇𐴞𐴥𐴀𐴕 𐴈𐴝𐴥𐴘𐴧𐴡.</char> <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" /><char style="wj">𐴇𐴠𐴥𐴍𐴞𐴘𐴝𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ’𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘.‘</char> <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴁𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴒𐴡𐴓𐴊𐴞-𐴒𐴡𐴓𐴊𐴞 𐴎𐴝𐴘 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠,</char> <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" /><char style="wj">’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴊𐴟𐴥𐴙𐴓𐴢 𐴎𐴞𐴀𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴃𐴡𐴓𐴧𐴝𐴃𐴢 𐴁𐴝𐴎𐴞𐴥 𐴃𐴝𐴥𐴙𐴑𐴧𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴎𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴙𐴌; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴙𐴑𐴧𐴡𐴥 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘.‘</char> <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴡 𐴊𐴞𐴕</char> <note caller="+" style="f"><char style="fr" closed="false">10‏:12 </char><char style="ft" closed="false">𐴀𐴡 𐴊𐴞𐴕 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴥𐴌 𐴊𐴠 𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴀𐴡𐴌𐴠</char></note> <char style="wj">𐴏𐴡𐴥𐴊𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴇𐴠𐴥 𐴐𐴡𐴥𐴀𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char><verse eid="LUK 10:12" /></para>
  <para style="s1">𐴃𐴡𐴖𐴝𐴥 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢</para>
  <para style="r">(<ref loc="MAT 11:20-24">𐴔𐴡𐴃𐴢 11‏:20‏-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />
    <char style="wj">”𐴀𐴡𐴥 𐴑𐴡𐴌𐴝𐴎𐴞𐴕، 𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴀𐴡𐴥 𐴁𐴠𐴃𐴏𐴝𐴥𐴘𐴊𐴝, 𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴞 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴎𐴡𐴊𐴞 𐴄𐴝𐴘𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴥𐴊𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴃𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴥𐴓𐴝𐴌𐴐𐴡𐴄𐴢 𐴉𐴞𐴣𐴊𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴥𐴘𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴀𐴘𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴃𐴡.</char> <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴄𐴝𐴘𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴥𐴊𐴡𐴕𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴔 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" /><char style="wj">𐴀𐴝𐴦𐴌 𐴃𐴟𐴘, 𐴀𐴡𐴥 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔, 𐴃𐴡𐴌𐴠𐴥 𐴑𐴞𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴁𐴝𐴎𐴠𐴥 𐴉𐴝𐴥𐴕 𐴖𐴡𐴌𐴠 𐴃𐴟𐴓𐴝𐴤 𐴎𐴝𐴘𐴁𐴡؟ 𐴃𐴡𐴌𐴠𐴥 𐴃𐴡 𐴕𐴞𐴏𐴠 𐴉𐴝𐴃𐴝𐴓𐴉𐴟𐴌𐴡𐴃𐴢 𐴀𐴠𐴥𐴕𐴝 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴠 𐴊𐴠; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠.“</char><verse eid="LUK 10:16" /></para>
  <para style="s1">𐴇𐴡𐴥𐴙𐴃𐴧𐴡𐴌-𐴊𐴟𐴘 𐴎𐴡𐴕 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴡𐴥𐴙𐴃𐴧𐴡𐴌-𐴊𐴟𐴘 𐴎𐴡𐴕 𐴕𐴟𐴥𐴕 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔𐴠 𐴃𐴡 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴝𐴕𐴠!“<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴁𐴞𐴅𐴞𐴓𐴞 𐴏𐴡𐴔𐴑𐴠 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴉𐴡𐴌𐴠𐴌 𐴊𐴠 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥.</char> <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" /><char style="wj">𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴏𐴧𐴟𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴥𐴣𐴍𐴞𐴁𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴐𐴧𐴡𐴕𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴞𐴥; 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴃𐴞 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴁𐴟𐴥𐴃𐴢-𐴉𐴠𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴝𐴕𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴑𐴟𐴥𐴐𐴞 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴕𐴝𐴔 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤.“</char><verse eid="LUK 10:20" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴑𐴟𐴥𐴐𐴞</para>
  <para style="r">(<ref loc="MAT 11:25-27">𐴔𐴡𐴃𐴢 11‏:25‏-27</ref>; <ref loc="MAT 13:16-17">13‏:16‏-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴀𐴝𐴏𐴔𐴝𐴕 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴀𐴞𐴀𐴕 𐴒𐴞𐴘𐴝𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴊𐴧𐴞𐴥𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴑𐴞𐴥 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. 𐴀𐴡𐴥𐴘, 𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴞𐴐𐴞𐴤 𐴉𐴡𐴏𐴡𐴥𐴕 𐴓𐴝𐴙𐴒𐴧𐴠𐴥.</char><verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />
    <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. 𐴉𐴟𐴖𐴝 𐴇𐴡𐴕 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴉𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴉𐴢 𐴇𐴡𐴕 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴖𐴝𐴘𐴠 𐴎𐴝𐴌𐴠𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴝𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠.“</char><verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴉𐴞𐴥𐴌𐴞, 𐴎𐴟𐴘𐴃𐴠𐴥𐴒𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴏𐴟𐴑 𐴀𐴟𐴀𐴙𐴕 𐴎𐴞𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠𐴑𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠𐴑𐴠𐴥.</char> <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴁𐴡𐴀𐴗𐴃𐴢 𐴕𐴡𐴁𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴊𐴠𐴑𐴡𐴥𐴌 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡𐴥 𐴊𐴠𐴑𐴠𐴥; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴉𐴟𐴥𐴕𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴥 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡𐴥 𐴉𐴟𐴥𐴕𐴠.“</char><verse eid="LUK 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />𐴀𐴠𐴑𐴁𐴝𐴌, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴝𐴓𐴠𐴔𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴘𐴃𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴞𐴦 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥؟“<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴑𐴞𐴦 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤؟ 𐴃𐴟𐴀𐴛 𐴇𐴠𐴥𐴍𐴠 𐴑𐴞𐴦 𐴉𐴡𐴙𐴅𐴧𐴡𐴥؟“</char><verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴁𐴟𐴊𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴌𐴝 𐴊𐴞𐴓𐴠, 𐴉𐴟𐴌𐴝 𐴎𐴝𐴕𐴠, 𐴉𐴟𐴌𐴝 𐴁𐴡𐴓𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴌𐴝 𐴊𐴠𐴔𐴝𐴑𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝,<note caller="+" style="f"><char style="fr" closed="false">10‏:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:5">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 6‏:5</ref></char></char></note> 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.<note caller="+" style="f"><char style="fr" closed="false">10‏:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 19‏:18</ref></char></char></note>“ <verse eid="LUK 10:27" /><verse number="28" style="v" sid="LUK 10:28" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴏𐴡𐴥𐴘𐴧𐴞 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴡𐴥; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤𐴒𐴡𐴘, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴀𐴛 𐴁𐴝𐴏𐴞𐴁𐴝𐴥.“</char><verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴡𐴕؟“<verse eid="LUK 10:29" /></para>
  <para style="s1">𐴒𐴡𐴔 𐴏𐴝𐴔𐴝𐴥𐴌𐴞</para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴑𐴁𐴝𐴌, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴧𐴟 𐴕𐴞𐴏𐴠 𐴅𐴠𐴌𐴞𐴑𐴡𐴥𐴃𐴢 𐴎𐴝𐴦𐴌, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌 𐴑𐴟𐴥𐴓𐴞𐴉𐴠𐴓𐴝𐴘 𐴔𐴝𐴌𐴝-𐴊𐴡𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴝𐴊𐴝𐴤 𐴔𐴡𐴌𐴝 𐴉𐴠𐴥𐴓𐴝𐴘 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.</char> <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" /><char style="wj">𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴞𐴔𐴝𐴔 𐴇𐴠𐴥 𐴉𐴡𐴣𐴃𐴢 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴐𐴈𐴝𐴍𐴞 𐴒𐴞𐴦𐴘𐴡𐴥𐴘.</char> <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴠𐴀𐴜𐴞 𐴘𐴡𐴥 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴉𐴝𐴐𐴈𐴝𐴍𐴞 𐴒𐴞𐴦𐴘𐴡𐴥𐴘.</char> <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴠𐴎𐴧𐴡𐴕 𐴏𐴝𐴔𐴝𐴥𐴌𐴞 𐴏𐴡𐴉𐴡𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴠𐴤-𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴉𐴠𐴄𐴉𐴟𐴙𐴅𐴧𐴠𐴥𐴥.</char> <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" /><char style="wj">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴎𐴡𐴈𐴡𐴥𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴃𐴠𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞 𐴉𐴝𐴄𐴧𐴞 𐴁𐴝𐴣𐴊𐴞𐴥𐴊𐴞𐴘𐴠; 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴊𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢, 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴟𐴏𐴝𐴥𐴉𐴠𐴌-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘 𐴑𐴠𐴥𐴌𐴔𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" /><char style="wj">𐴃𐴝𐴌𐴉𐴡𐴌 𐴊𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴟𐴘 𐴊𐴞𐴕𐴝𐴥𐴌</char><note caller="+" style="f"><char style="fr" closed="false">10‏:35 </char><char style="ft" closed="false">𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴀𐴠𐴑 𐴊𐴞𐴕𐴡𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌 (𐴏𐴡𐴀 <char style="xt"><ref loc="MAT 20:2">𐴔𐴡𐴃𐴞 20‏:2</ref></char>).</char></note> <char style="wj">𐴄𐴞𐴛𐴝 𐴕𐴠𐴦𐴓𐴝𐴘 𐴔𐴟𐴏𐴝𐴥𐴉𐴠𐴌-𐴈𐴝𐴥𐴕𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌𐴠 𐴊𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴘𐴡𐴒𐴧𐴗𐴝𐴥𐴌𐴠 𐴑𐴠𐴥𐴌𐴔𐴡𐴏𐴢 𐴒𐴡𐴌𐴡𐴤; 𐴎𐴡𐴊𐴞 𐴀𐴞𐴀𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴇𐴡𐴥𐴏𐴧𐴝 𐴀𐴡𐴥, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴘𐴓𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴉𐴟𐴥𐴣𐴎𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴟𐴔.‘</char><verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />
    <char style="wj">”𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴇𐴠𐴥 𐴃𐴞𐴕𐴞𐴥 𐴎𐴡𐴕 𐴀𐴡𐴃𐴧𐴟, 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴡𐴕𐴧𐴗𐴝𐴤 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴡؟“</char><verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />𐴀𐴝𐴓𐴠𐴔𐴧𐴗𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝.“</para>
  <para style="p" vid="LUK 10:37">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴦, 𐴃𐴟𐴀𐴛 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤𐴒𐴡𐴘.“</char><verse eid="LUK 10:37" /></para>
  <para style="s1">𐴔𐴡𐴌𐴡𐴃𐴝 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴓𐴡𐴘 𐴀𐴞𐴏𐴝𐴤 𐴊𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴧𐴠</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴝𐴌𐴝𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠; 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴔𐴡𐴌𐴡𐴃𐴝 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴠𐴏𐴃𐴠𐴑𐴁𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴡𐴥𐴙𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴒𐴟𐴌𐴝𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />𐴓𐴠𐴑𐴞𐴕 𐴔𐴡𐴌𐴡𐴃𐴝 𐴔𐴠𐴀𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴖𐴝𐴀𐴕-𐴘𐴝𐴀𐴕 𐴕𐴝𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴠𐴤-𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴕𐴡 𐴊𐴠𐴑𐴡𐴥𐴌 𐴕𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴥𐴘𐴕𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴡𐴌 𐴈𐴝𐴔 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴀𐴛 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴓𐴝𐴒𐴝𐴘𐴊𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴠 𐴊𐴠𐴥؟ 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴈𐴡𐴀𐴕𐴝.“<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />𐴔𐴝𐴓𐴞𐴑𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴡𐴌𐴡𐴃𐴝, 𐴔𐴡𐴌𐴡𐴃𐴝, 𐴃𐴟𐴘 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴡𐴥𐴘 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢 𐴀𐴝𐴏𐴡𐴤𐴏𐴢,</char> <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴞𐴎𐴢 𐴁𐴠 𐴎𐴡𐴌𐴟𐴌𐴞; 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴇𐴠𐴥 𐴒𐴡𐴔 𐴇𐴞𐴥𐴏𐴧𐴝 𐴒𐴝𐴥𐴕 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s1">𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="MAT 6:9-15">𐴔𐴡𐴃𐴢 6‏:9‏-15</ref>; <ref loc="MAT 7:7-11">7‏:7‏-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />𐴀𐴠𐴑𐴁𐴝𐴌 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥𐴌; 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥 𐴐𐴞𐴥𐴑𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴐𐴞𐴥𐴑𐴝𐴘𐴧𐴠.“ <verse eid="LUK 11:1" /><verse number="2" style="v" sid="LUK 11:2" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠:</char></para>
  <para style="q1" vid="LUK 11:2">
    <char style="wj">’𐴀𐴡𐴥 𐴁𐴝𐴉𐴢,</char></para>
  <para style="q1" vid="LUK 11:2">
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔 𐴂𐴝𐴑 𐴔𐴝𐴕𐴝 𐴎𐴡𐴑.</char></para>
  <para style="q1" vid="LUK 11:2">
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴝𐴘𐴧𐴡𐴤𐴑.</char><verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />
    <char style="wj">𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴕𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴊𐴞𐴕𐴠 𐴊𐴡𐴦.</char><verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />
    <char style="wj">𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴡𐴤,</char></para>
  <para style="q2" vid="LUK 11:4">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴊𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥.</char></para>
  <para style="q1" vid="LUK 11:4">
    <char style="wj">𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴃𐴧𐴡 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥.‘ “</char><verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴊𐴡𐴥𐴌𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴊𐴟𐴏𐴃𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴌𐴝𐴙𐴃𐴕𐴞𐴐𐴞𐴥𐴃𐴢 𐴎𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴊𐴟𐴏𐴃𐴡𐴥, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴌𐴟𐴄𐴞 𐴀𐴟𐴊𐴝𐴥𐴌 𐴊𐴡𐴥;</char> <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴝𐴥𐴁𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘.‘</char> <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" /><char style="wj">𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴃𐴝𐴥𐴘 𐴊𐴟𐴏𐴃𐴡𐴥𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴀𐴠𐴇𐴡𐴥𐴕 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴣𐴊𐴝𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴀𐴛 𐴁𐴞𐴏𐴝𐴥𐴕𐴝𐴃𐴢. 𐴀𐴝𐴀𐴛 𐴀𐴟𐴍𐴞𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴊𐴞𐴦 𐴕𐴡 𐴉𐴝𐴙𐴅𐴧𐴟𐴔.‘</char> <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴏𐴃𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴟𐴍𐴞𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴊𐴞𐴦𐴓𐴠𐴥 𐴘𐴡, 𐴃𐴡𐴀 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴝𐴌𐴝𐴖𐴡𐴌𐴞 𐴔𐴝𐴒𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴞𐴥𐴃𐴠 𐴀𐴟𐴍𐴞𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴎𐴠𐴊𐴟𐴥𐴕 𐴓𐴝𐴒𐴠𐴌 𐴇𐴠𐴥𐴊𐴟𐴕 𐴊𐴞𐴦𐴁𐴡.</char><verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴔𐴝𐴒𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴃𐴟𐴖𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴝𐴘𐴁𐴝; 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴙𐴅𐴧𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝𐴌 𐴑𐴟𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴝𐴒𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴉𐴝𐴦; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴖𐴝, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴖𐴝𐴘 𐴉𐴝𐴦; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴙𐴅𐴧𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴝 𐴑𐴟𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="LUK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴝𐴉𐴢 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴘𐴠 𐴔𐴝𐴏𐴢 𐴔𐴝𐴒𐴞𐴓𐴠𐴥, 𐴔𐴝𐴏𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴇𐴝𐴥𐴉𐴢 𐴊𐴞𐴦𐴁𐴡 𐴊𐴠𐴥؟</char> <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" /><char style="wj">𐴘𐴝𐴥𐴃𐴡 𐴀𐴝𐴕𐴋𐴝 𐴔𐴝𐴒𐴞𐴓𐴠𐴥, 𐴁𐴞𐴏𐴧𐴟𐴥 𐴊𐴞𐴦𐴁𐴡 𐴊𐴠𐴥؟</char> <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" /><char style="wj">𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴒𐴡𐴔-𐴒𐴡𐴔 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴦 𐴎𐴝𐴕𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴠 𐴑𐴞𐴘𐴝𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴔𐴝𐴒𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴕𐴡 𐴊𐴞𐴦𐴃𐴡؟“</char><verse eid="LUK 11:13" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 12:22-30">𐴔𐴡𐴃𐴢 12‏:22‏-30</ref>; <ref loc="MRK 3:20-27">𐴔𐴝𐴑 3‏:20‏-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴟𐴑 𐴁𐴟𐴥𐴃𐴢 𐴊𐴝𐴥𐴉𐴝𐴌; 𐴁𐴟𐴥𐴃𐴧𐴗𐴝 𐴕𐴠𐴦𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴌𐴝𐴥𐴌, 𐴁𐴟𐴑 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴔𐴝𐴃𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴥𐴉𐴝 𐴊𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴡𐴌<note caller="+" style="f"><char style="fr" closed="false">11‏:15 </char><char style="fqa">𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴢</char> <char style="ft" closed="false">𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴀𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴝𐴔 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴞 𐴋𐴝𐴑𐴠.</char></note> 𐴃𐴝𐴦𐴑𐴡𐴃𐴠.“ <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴝𐴥𐴌 𐴕𐴞𐴘𐴡𐴃𐴠, 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴁𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="LUK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴌𐴠 𐴎𐴝𐴕𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴎𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴃𐴡 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.</char> <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴎𐴡𐴊𐴞 𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴕𐴞𐴎𐴠 𐴀𐴡𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴄𐴞𐴑𐴞𐴁𐴡𐴥؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴁𐴟𐴥𐴃𐴢 𐴊𐴝𐴥𐴉𐴝𐴘 𐴊𐴠 𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴡𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴠.</char> <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" /><char style="wj">𐴃𐴡𐴀 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴁𐴟𐴥𐴃𐴢 𐴊𐴝𐴥𐴉𐴝𐴘 𐴊𐴠 𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴡𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴇𐴝𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴠 𐴊𐴝𐴥𐴉𐴝 𐴊𐴠𐴥؟ 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝.</char> <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴁𐴟𐴥𐴃𐴢 𐴊𐴝𐴥𐴉𐴝𐴘 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. </char><verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />
    <char style="wj">”𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴁𐴡𐴓𐴟𐴖𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴀𐴝𐴥𐴃𐴞𐴘𐴝𐴌 𐴉𐴞𐴣𐴊𐴞𐴥 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴌𐴠 𐴉𐴝𐴀𐴌𐴝𐴊𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴏𐴝𐴥𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠.</char> <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴡𐴓𐴟𐴖𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴀𐴘𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴝𐴥𐴔𐴓𐴝 𐴒𐴡𐴌𐴞𐴥 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴠, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴠𐴥 𐴀𐴝𐴥𐴃𐴞𐴘𐴝𐴌 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘 𐴎𐴞𐴀𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴃𐴞 𐴎𐴞𐴀𐴕 𐴓𐴟𐴄𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴍𐴞𐴊𐴞𐴉𐴠𐴥𐴓𐴠.</char><verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴕𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴓𐴋𐴝; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴊𐴡𐴓𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴐𐴞𐴥𐴣𐴍𐴝𐴐𐴞𐴄𐴧𐴝𐴤 𐴒𐴡𐴌𐴠𐴥.</char><verse eid="LUK 11:23" /></para>
  <para style="s1">𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴡𐴌 𐴖𐴝𐴦𐴉𐴠𐴏𐴞</para>
  <para style="r">(<ref loc="MAT 12:43-45">𐴔𐴡𐴃𐴢 12‏:43‏-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />
    <char style="wj">”𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴕𐴠𐴦𐴓𐴠, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴇𐴠𐴥 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥 𐴉𐴟𐴥𐴖𐴝𐴕𐴝 𐴎𐴝𐴒𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴎𐴝𐴘 𐴀𐴝𐴌𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴎𐴝𐴒𐴝 𐴃𐴟𐴖𐴝. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴉𐴝𐴘𐴓𐴠, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴈𐴡𐴀 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴎𐴝𐴘𐴧𐴟𐴔𐴁𐴡𐴥𐴘, 𐴎𐴠𐴕𐴃𐴟𐴥 𐴀𐴝𐴀𐴛 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴞𐴥.‘</char> <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" /><char style="wj">𐴘𐴞𐴥𐴁𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴄𐴞𐴥𐴑 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴓𐴡𐴦𐴃𐴉𐴝.</char> <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" /><char style="wj">𐴁𐴝𐴦𐴊𐴠 𐴘𐴞𐴥𐴁𐴝 𐴎𐴝𐴘 𐴀𐴝𐴌𐴡𐴤 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴕𐴞𐴎𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴥𐴓𐴞 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴑𐴠. 𐴃𐴡𐴥𐴘 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴉𐴞𐴏𐴡𐴥𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴒𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.“</char><verse eid="LUK 11:26" /></para>
  <para style="s1">𐴏𐴡𐴥𐴘𐴧𐴞 𐴔𐴟𐴁𐴝𐴌𐴠𐴑</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴡 𐴉𐴠𐴄𐴢 𐴎𐴞𐴁𐴝𐴤𐴃𐴢 𐴃𐴟𐴀𐴛 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡 𐴊𐴟𐴊𐴢 𐴎𐴞𐴀𐴕 𐴃𐴟𐴀𐴛 𐴈𐴝𐴥𐴀𐴘𐴓𐴝.“<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴔𐴟𐴁𐴝𐴌𐴠𐴑, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.“</char><verse eid="LUK 11:28" /></para>
  <para style="s1">𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴝𐴌 𐴊𐴝𐴁𐴞</para>
  <para style="r">(<ref loc="MAT 12:38-42">𐴔𐴡𐴃𐴢 12‏:38‏-42</ref>; <ref loc="MRK 8:12">𐴔𐴝𐴑 8‏:12</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴌, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴐𐴟𐴥𐴌𐴟 𐴊𐴡𐴙𐴅𐴧𐴠 𐴊𐴠, <char style="wj">”𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡𐴥𐴌𐴝𐴉𐴢; 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴕𐴡𐴁𐴞 𐴘𐴟𐴕𐴟𐴏𐴡𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴞𐴘𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴟𐴕𐴟𐴏𐴢 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴕𐴞𐴜𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴓𐴧𐴝 𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴡𐴥𐴀𐴙𐴓𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴡𐴥 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴓𐴧𐴝 𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" /><char style="wj">𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴐𐴞𐴁𐴝𐴤 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴌 𐴌𐴝𐴕𐴞 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴀𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴟𐴍𐴞𐴤𐴁𐴡, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥𐴁𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴏𐴡𐴥𐴓𐴡𐴔𐴝𐴕𐴡𐴌 𐴁𐴟𐴊𐴧𐴞𐴥𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴁𐴡𐴓𐴧𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴐𐴠𐴥𐴐𐴢 𐴔𐴝𐴃𐴝𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴏𐴡𐴀, 𐴏𐴡𐴥𐴓𐴡𐴔𐴝𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.</char> <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" /><char style="wj">𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴕𐴞𐴕𐴞𐴜𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴀𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴞𐴥𐴘𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥𐴁𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴘𐴟𐴕𐴟𐴏𐴡𐴌 𐴀𐴠𐴓𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴏𐴡𐴀, 𐴘𐴟𐴕𐴟𐴏𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.</char><verse eid="LUK 11:32" /></para>
  <para style="s1">𐴒𐴝𐴦𐴌 𐴉𐴡𐴀𐴌</para>
  <para style="r">(<ref loc="MAT 5:15">𐴔𐴡𐴃𐴢 5‏:15</ref>; <ref loc="MAT 6:22-23">6‏:22‏-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />
    <char style="wj">”𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴡 𐴏𐴠𐴌𐴝𐴑 𐴊𐴡𐴥𐴌𐴝𐴘 𐴓𐴟𐴑𐴝𐴘 𐴘𐴝𐴥 𐴁𐴝𐴥𐴙𐴌𐴡𐴌 𐴃𐴡𐴓𐴠 𐴌𐴝𐴑𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞𐴌 𐴖𐴡𐴌𐴠 𐴁𐴠 𐴌𐴝𐴑𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴘𐴧𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴀𐴌 𐴊𐴠𐴑𐴠𐴥.</char> <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴝𐴦𐴌 𐴏𐴠𐴌𐴝𐴑 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴟𐴑; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴟𐴑 𐴒𐴡𐴔 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴟𐴣𐴍𐴝 𐴒𐴝𐴦 𐴉𐴡𐴀𐴌𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴝𐴦 𐴘𐴡𐴥 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴠 𐴉𐴡𐴀𐴌 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴕𐴡.</char> <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" /><char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴟𐴣𐴍𐴝 𐴒𐴝𐴦 𐴉𐴡𐴀𐴌𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴃𐴝𐴥𐴑𐴠 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴡𐴀𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴠𐴌𐴝𐴑 𐴊𐴡𐴥𐴌𐴝𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴉𐴡𐴀𐴌 𐴊𐴠.“</char><verse eid="LUK 11:36" /></para>
  <para style="s1">𐴉𐴠𐴥𐴌𐴡𐴐𐴞𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴀𐴝𐴓𐴠𐴔𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢</para>
  <para style="r">(<ref loc="MAT 23:1-36">𐴔𐴡𐴃𐴢 23‏:1‏-36</ref>; <ref loc="MRK 12:38-40">𐴔𐴝𐴑 12‏:38‏-40</ref>; <ref loc="LUK 20:45-47">𐴓𐴟𐴑 20‏:45‏-47</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥; 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴘 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴀𐴝𐴥𐴃𐴢 𐴕𐴡𐴥 𐴊𐴟𐴥𐴖𐴠 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴖𐴝 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="LUK 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39" />𐴔𐴝𐴓𐴞𐴑𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴞𐴘𐴝𐴓𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴥𐴓𐴢-𐴁𐴝𐴏𐴡𐴥𐴕𐴡𐴌 𐴁𐴝𐴀𐴌𐴋𐴝𐴥𐴑 𐴁𐴠 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴡 𐴓𐴝𐴓𐴡𐴥𐴏𐴠 𐴀𐴠𐴊𐴧𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴞𐴘𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝.</char> <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" /><char style="wj">𐴀𐴡𐴥 𐴉𐴡𐴦𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴁𐴝𐴀𐴌𐴋𐴝𐴥𐴑 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴑𐴞 𐴁𐴟𐴥𐴃𐴡𐴌𐴡𐴌 𐴋𐴝𐴥𐴑 𐴀𐴡𐴥 𐴕𐴡𐴥 𐴁𐴝𐴕𐴝 𐴕𐴠𐴥؟</char> <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.</char><verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />
    <char style="wj">”𐴀𐴡𐴥 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴉𐴟𐴊𐴞𐴕𐴝𐴌, 𐴃𐴠𐴏𐴉𐴝𐴃𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴥𐴃𐴞𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴇𐴝𐴥𐴑𐴡𐴌 𐴊𐴡𐴐𐴢 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴊𐴡𐴦, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴀𐴕 𐴀𐴡𐴥 𐴒𐴡𐴌𐴡𐴤𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴀𐴟𐴀𐴙𐴕 𐴀𐴡𐴥 𐴁𐴝𐴊𐴢 𐴕𐴡 𐴊𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.</char><verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />
    <char style="wj">”𐴀𐴡𐴥 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴃𐴡𐴑𐴧𐴝𐴌 𐴇𐴝𐴊𐴞𐴌𐴝𐴤𐴃𐴢 𐴁𐴡𐴘𐴃𐴡𐴥 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴎𐴝𐴌𐴠-𐴁𐴝𐴎𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴉𐴝𐴘𐴃𐴡 𐴏𐴡𐴀.</char><verse eid="LUK 11:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴡𐴥𐴃𐴢 𐴕𐴡 𐴉𐴝𐴦 𐴊𐴠 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕𐴡𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞 𐴀𐴝𐴥𐴣𐴍𐴠.“</char><verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴃𐴟𐴀𐴛 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴡𐴤𐴌.“<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴘𐴡𐴥 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴣𐴎𐴝𐴤 𐴃𐴟𐴓𐴞𐴤𐴊𐴡, 𐴎𐴞𐴀𐴕 𐴁𐴡𐴘𐴃𐴠𐴥 𐴊𐴟𐴑, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴃𐴡 𐴉𐴟𐴣𐴎𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴡𐴦𐴣𐴓𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡 𐴓𐴝𐴒𐴡.</char><verse eid="LUK 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴡𐴁𐴡𐴌𐴡𐴌𐴠 𐴁𐴝𐴕𐴝𐴘𐴃𐴟𐴓𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴙𐴓𐴢 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠.</char> <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" /><char style="wj">𐴇𐴠𐴥𐴀𐴕𐴒𐴡𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴡𐴁𐴝𐴤 𐴊𐴡𐴥 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴈𐴝𐴔𐴡𐴃𐴢 𐴌𐴝𐴎𐴞 𐴀𐴝𐴏𐴡𐴤; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠 𐴊𐴠 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴁𐴡𐴌𐴡𐴌𐴠 𐴁𐴝𐴕𐴝𐴘𐴃𐴟𐴓𐴡𐴥 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝.</char> <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴘𐴝𐴕𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥, ’𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴡𐴁𐴞 𐴀𐴠𐴊𐴧𐴠 𐴌𐴡𐴏𐴟𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴟𐴔, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char> <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴎𐴠𐴊𐴟𐴥𐴕 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴡𐴖𐴢 𐴁𐴝𐴥𐴐𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢,</char> <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" /><char style="wj">𐴀𐴝𐴁𐴠𐴓𐴡𐴌 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴡 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝𐴌 𐴓𐴡𐴖𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑 𐴎𐴝𐴒𐴝𐴌 𐴔𐴝𐴎𐴠𐴥𐴔𐴝𐴙𐴅𐴧𐴝 𐴑𐴟𐴥𐴕 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴀𐴡𐴥𐴘, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢.‘</char><verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />
    <char style="wj">”𐴀𐴡𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴁𐴟𐴊𐴧𐴞𐴥𐴌 𐴏𐴝𐴁𐴞𐴤 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴡; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴕𐴡𐴥 𐴒𐴡𐴥𐴓𐴡, 𐴀𐴝𐴦𐴌 𐴒𐴡𐴥𐴓𐴠𐴌 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴀𐴡𐴀𐴣𐴏𐴞 𐴌𐴝𐴙𐴑𐴧𐴡𐴥.“</char><verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />𐴀𐴞𐴏𐴝𐴤 𐴈𐴠𐴥𐴕𐴃𐴟 𐴕𐴠𐴦𐴓𐴞 𐴎𐴝𐴦𐴌𐴒𐴡𐴥𐴘 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴝𐴓𐴠𐴔 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴌𐴝𐴑 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴥𐴘 𐴈𐴡𐴓𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴏𐴡𐴦𐴛 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s1">𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞</para>
  <para style="r">(<ref loc="MAT 10:26-27">𐴔𐴡𐴃𐴢 10‏:26‏-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴠𐴊𐴟𐴥𐴕 𐴀𐴝𐴥𐴎𐴝𐴌-𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴉𐴡𐴌𐴠𐴌, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴒𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴖𐴝𐴤 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴑𐴞, <char style="wj">”𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴟𐴥𐴄𐴝𐴌𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑𐴞 𐴃𐴧𐴟.</char> <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴒𐴟𐴥𐴙𐴅𐴧𐴝 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴎𐴝𐴕𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴕𐴝𐴥𐴘. </char> <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" /><char style="wj">𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴉𐴡𐴀𐴌𐴡𐴃𐴢 𐴉𐴟𐴥𐴕𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴁𐴟𐴥𐴃𐴡𐴌𐴡𐴌 𐴑𐴝𐴔𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴉𐴟𐴥𐴐𐴉𐴟𐴐𐴝𐴘𐴧𐴡, 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴊𐴡𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴠𐴓𐴝𐴕 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="LUK 12:3" /></para>
  <para style="s1">𐴇𐴝𐴌𐴠𐴤 𐴋𐴡𐴦𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥</para>
  <para style="r">(<ref loc="MAT 10:28-31">𐴔𐴡𐴃𐴢 10‏:28‏-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />
    <char style="wj">”𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴝𐴘𐴧𐴝𐴌𐴠 𐴑𐴡𐴃𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠.</char> <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴊𐴝𐴈𐴝𐴤𐴘𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴝𐴌𐴠𐴤 𐴋𐴡𐴦𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥: 𐴀𐴟𐴁𐴝𐴤𐴌𐴠 𐴋𐴡𐴦𐴌𐴡 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴘𐴧𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴎𐴟𐴎𐴟𐴑𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴡𐴥𐴘, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴠 𐴋𐴡𐴦𐴌𐴡.</char> <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" /><char style="wj">𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴉𐴞𐴛𐴝𐴙𐴅𐴧𐴝 𐴑𐴞 𐴈𐴡𐴔 𐴄𐴞𐴛𐴝 𐴓𐴡𐴘 𐴕𐴡 𐴁𐴠𐴏𐴠 𐴕𐴠𐴥؟ 𐴃𐴡𐴀 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤𐴌𐴠 𐴘𐴡𐴥 𐴕𐴡 𐴉𐴡𐴀𐴌𐴝.</char> <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" /><char style="wj">𐴁𐴠𐴐𐴡𐴥𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴏𐴟𐴓𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴒𐴡𐴕𐴝 𐴀𐴝𐴏𐴠𐴤. 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴞𐴔𐴡𐴃𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴉𐴞𐴛𐴝𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤.</char><verse eid="LUK 12:7" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴐𐴞𐴥𐴑𐴝𐴌 𐴀𐴝𐴦𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴝𐴥</para>
  <para style="r">(<ref loc="MAT 10:32-33">𐴔𐴡𐴃𐴢 10‏:32‏-33</ref>; <ref loc="MAT 12:32">12‏:32</ref>; <ref loc="MAT 10:19-20">10‏:19‏-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴘𐴠 𐴘𐴡𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char> <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" /><char style="wj">𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴃𐴡 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />
    <char style="wj">”𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴑𐴞𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴊𐴞𐴑𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴡𐴘𐴎𐴝, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴝𐴥 𐴑𐴞𐴦 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴁𐴝 𐴘𐴝𐴥𐴃𐴡 𐴑𐴞𐴦 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥;</char> <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴈𐴡𐴖𐴝𐴤 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴐𐴞𐴥𐴑𐴝𐴘𐴊𐴞𐴁𐴡.“</char><verse eid="LUK 12:12" /></para>
  <para style="s1">𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴉𐴡𐴦𐴓𐴢 𐴊𐴡𐴥𐴕𐴞𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴓𐴗𐴝𐴥𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴥𐴘 𐴔𐴞𐴌𐴝𐴏𐴢 𐴁𐴝𐴥𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴃𐴡 𐴈𐴡𐴀.“<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡 𐴔𐴞𐴛𐴝, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌 𐴘𐴝𐴥 𐴁𐴝𐴥𐴑 𐴒𐴡𐴌𐴞𐴥𐴊𐴡𐴘𐴝 𐴇𐴡𐴕𐴠 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥؟“</char> <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴡𐴥𐴁𐴡𐴌𐴡𐴊𐴧𐴝𐴌, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴓𐴝𐴓𐴏𐴞𐴥𐴃𐴧𐴟 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴕𐴞𐴎𐴡𐴌 𐴄𐴝𐴓𐴢-𐴄𐴝𐴓𐴢 𐴊𐴡𐴥𐴕-𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞𐴌 𐴖𐴡𐴌𐴠 𐴕𐴡.“</char><verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, <char style="wj">”𐴀𐴠𐴎𐴧𐴡𐴕 𐴊𐴡𐴥𐴕𐴞𐴌 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴊𐴡𐴥𐴙𐴅𐴧𐴠.</char> <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴁𐴝𐴥𐴉𐴠𐴌 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴑𐴞𐴦 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴠 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴎𐴡𐴔𐴝 𐴌𐴝𐴑𐴞𐴥𐴁𐴝𐴌 𐴎𐴝𐴒𐴝 𐴕𐴝𐴥𐴘؟‘</char><verse eid="LUK 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18" />
    <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔: 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴊𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴝𐴘 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴞 𐴁𐴝𐴕𐴝𐴘𐴧𐴟𐴥𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴢-𐴏𐴝𐴥𐴔𐴝𐴕𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴇𐴠𐴥𐴍𐴠 𐴌𐴝𐴑𐴞𐴥𐴘𐴟𐴔.</char> <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" /><char style="wj">𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴌𐴟𐴀𐴌𐴠 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴊𐴠, 𐴀𐴡𐴥 𐴌𐴟𐴀, 𐴃𐴡𐴌𐴃𐴧𐴟 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴌𐴝𐴉𐴢 𐴀𐴝𐴏𐴠𐴤. 𐴘𐴝𐴓𐴝 𐴐𐴟𐴥𐴑 𐴒𐴡𐴥𐴌, 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴑.‘</char><verse eid="LUK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴡𐴥 𐴉𐴡𐴦𐴓𐴢, 𐴀𐴝𐴙𐴅𐴧𐴝 𐴌𐴝𐴙𐴃𐴧𐴝 𐴊𐴠 𐴃𐴡𐴌 𐴎𐴝𐴕 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴃𐴡𐴥𐴘 𐴃𐴟𐴘 𐴎𐴞𐴀𐴕 𐴎𐴡𐴔𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥𐴏𐴢 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴌 𐴀𐴡𐴥𐴘𐴁𐴡؟‘</char><verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />
    <char style="wj">”𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴁𐴝𐴤, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴊𐴡𐴥𐴕 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴕𐴡.“</char><verse eid="LUK 12:21" /></para>
  <para style="s1">𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥</para>
  <para style="r">(<ref loc="MAT 6:25-34">𐴔𐴡𐴃𐴢 6‏:25‏-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴑𐴞𐴦 𐴈𐴝𐴥𐴘𐴧𐴟𐴔 𐴈𐴡𐴀𐴘𐴢 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴓𐴧𐴝 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴑𐴞𐴦 𐴉𐴞𐴣𐴊𐴞𐴥𐴘𐴟𐴔 𐴈𐴡𐴀𐴘𐴢 𐴒𐴝𐴦 𐴓𐴧𐴝 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char> <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴃𐴡 𐴈𐴝𐴥𐴕𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴑𐴞𐴔𐴡𐴃𐴞, 𐴀𐴝𐴦𐴌 𐴒𐴝𐴦 𐴃𐴡 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴑𐴞𐴔𐴡𐴃𐴞.</char> <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" /><char style="wj">𐴈𐴝𐴖𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴥𐴉𐴞𐴏𐴡; 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴡 𐴕𐴡 𐴐𐴞𐴥𐴣𐴍𐴠, 𐴕𐴡 𐴊𐴝𐴦, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴒𐴟𐴊𐴝𐴔 𐴘𐴝𐴥 𐴇𐴝𐴣𐴅𐴧𐴝 𐴀𐴝𐴏𐴠𐴤; 𐴃𐴡𐴀 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴈𐴝𐴥𐴀𐴁𐴝. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴑𐴞𐴔𐴡𐴃𐴞.</char> <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴠 𐴏𐴞𐴕𐴃𐴝 𐴒𐴡𐴌𐴞𐴥 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴘𐴧𐴝𐴃𐴡𐴌𐴠 𐴀𐴠𐴑 𐴒𐴡𐴥𐴕𐴋𐴝 𐴁𐴝𐴌𐴝𐴤𐴘 𐴉𐴝𐴌𐴞𐴁𐴝𐴥 𐴊𐴠 𐴀𐴝𐴏𐴡𐴤؟ </char> <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴠𐴥𐴃𐴧𐴞𐴌𐴞𐴕 𐴈𐴝𐴔 𐴔𐴝𐴥𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴙𐴓𐴧𐴠, 𐴀𐴡𐴙𐴕𐴧𐴡 𐴏𐴞𐴏𐴡𐴓𐴧𐴝 𐴑𐴞𐴘𐴝𐴥 𐴏𐴞𐴕𐴃𐴝 𐴒𐴡𐴌𐴡𐴤؟</char><verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />
    <char style="wj">”𐴉𐴟𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴥𐴉𐴞𐴏𐴡, 𐴇𐴞𐴥𐴀𐴕 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴠𐴤 𐴊𐴠; 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴡 𐴕𐴡 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴉𐴟𐴥𐴣𐴃𐴝 𐴈𐴝𐴍𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴏𐴡𐴥𐴓𐴡𐴔𐴝𐴕𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴢 𐴓𐴡𐴘 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴇𐴝𐴥𐴣𐴎𐴝𐴘 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘. </char> <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴔𐴡𐴘𐴊𐴝𐴕𐴡𐴌 𐴑𐴠𐴥𐴌𐴡𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴇𐴝𐴥𐴣𐴎𐴝, 𐴎𐴞𐴀𐴕 𐴀𐴝𐴙𐴅𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴇𐴝𐴙𐴓𐴧𐴝 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝; 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴡𐴥 𐴈𐴡𐴔 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴃𐴡𐴥 𐴇𐴝𐴥𐴣𐴎𐴝𐴘𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌؟</char> <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" /><char style="wj">𐴑𐴞𐴦 𐴈𐴝𐴥𐴘𐴁𐴝 𐴘𐴝𐴥 𐴑𐴞𐴦 𐴉𐴞𐴀𐴁𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴡𐴃𐴢 𐴉𐴡𐴌𐴞 𐴕𐴡 𐴃𐴝𐴥𐴙𐴑𐴧𐴡; 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char> <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴥𐴕𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴞𐴏𐴠𐴤 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴀𐴕 𐴓𐴝𐴒𐴠𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴠 𐴎𐴝𐴕𐴠.</char> <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" /><char style="wj">𐴘𐴝𐴥𐴌𐴁𐴡𐴊𐴡𐴓𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴡, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴥 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="LUK 12:31" /></para>
  <para style="s1">𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴊𐴡𐴥𐴕 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴝𐴥</para>
  <para style="r">(<ref loc="MAT 6:19-21">𐴔𐴡𐴃𐴢 6‏:19‏-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />
    <char style="wj">”𐴀𐴡𐴥 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴒𐴟𐴌𐴝 𐴎𐴝𐴥𐴑, 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴌𐴝𐴙𐴅𐴧𐴡 𐴊𐴞𐴦𐴘𐴝 𐴉𐴡𐴏𐴡𐴥𐴕 𐴓𐴝𐴙𐴒𐴧𐴠𐴥.</char> <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴠𐴏𐴞 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴄𐴞𐴛𐴝𐴌 𐴎𐴝𐴓𐴞 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴡𐴤 𐴎𐴞𐴁𐴝𐴤 𐴉𐴟𐴌𐴝𐴕 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴝𐴒𐴡𐴥𐴘, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴡𐴥𐴕-𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴞𐴀𐴕 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴉𐴟𐴥𐴌𐴝, 𐴎𐴠𐴍𐴠𐴥 𐴏𐴟𐴌 𐴋𐴝𐴥𐴑𐴠 𐴕𐴟 𐴀𐴝𐴘𐴧𐴠𐴤 𐴀𐴝𐴦𐴌 𐴉𐴟𐴑𐴠 𐴕𐴝𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴡𐴥𐴕-𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴎𐴠𐴍𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡 𐴊𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥𐴍𐴠. </char><verse eid="LUK 12:34" /></para>
  <para style="s1">𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴒𐴡𐴗𐴀𐴌</para>
  <para style="r">(<ref loc="MAT 24:45-51">𐴔𐴡𐴃𐴢 24‏:45‏-51</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴟𐴄𐴢 𐴊𐴡 𐴀𐴠𐴊𐴧𐴠 𐴏𐴠𐴌𐴝𐴑 𐴊𐴡𐴥𐴌𐴝𐴘 𐴌𐴝𐴑𐴡𐴥.</char> <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴁𐴡𐴘𐴌𐴝𐴃𐴡𐴃𐴧𐴟 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴀𐴘𐴢 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴙𐴅𐴧𐴝𐴘𐴓𐴠 𐴔𐴡𐴃𐴧𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴟𐴖𐴝𐴌 𐴑𐴟𐴥𐴓𐴞𐴊𐴞 𐴉𐴝𐴌𐴠.</char> <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" /><char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴒𐴡𐴗𐴀𐴌 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴝𐴘𐴓𐴠𐴤 𐴏𐴡𐴦𐴛 𐴃𐴝𐴥𐴙𐴑𐴧𐴝 𐴓𐴡𐴦𐴃𐴉𐴝. 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴑𐴠𐴣𐴙𐴓𐴢 𐴁𐴝𐴣𐴊𐴞𐴥 𐴇𐴠𐴥 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴁𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" /><char style="wj">𐴎𐴡𐴊𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴊𐴝𐴤 𐴌𐴝𐴙𐴃𐴧𐴝 𐴘𐴝𐴥 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴘𐴓𐴠𐴤 𐴘𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴡𐴘𐴧𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴝 𐴓𐴡𐴦𐴃𐴉𐴝, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴠𐴥 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡 𐴔𐴟𐴁𐴝𐴌𐴠𐴑.</char><verse eid="LUK 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 12:39" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴞 𐴌𐴝𐴑𐴡𐴥 𐴊𐴠 𐴑𐴞, 𐴎𐴡𐴊𐴞 𐴒𐴡𐴥𐴌𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴏𐴟𐴌 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴎𐴝𐴙𐴕𐴃𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴌𐴠 𐴁𐴝𐴥𐴚𐴒𐴞𐴃𐴡 𐴕𐴡 𐴊𐴞𐴃𐴡.</char> <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴃𐴡𐴘𐴧𐴝𐴌 𐴃𐴝𐴥𐴑𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴄𐴝𐴥𐴀𐴌𐴡 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴠 𐴀𐴝𐴘𐴁𐴡𐴤.“</char><verse eid="LUK 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴌𐴠؟“<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />𐴔𐴝𐴓𐴞𐴑𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴠𐴀𐴕 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌</char><note caller="+" style="f"><char style="fr" closed="false">12‏:42 </char><char style="ft" closed="false">𐴖𐴝𐴉𐴝𐴊𐴝𐴥𐴌</char></note> <char style="wj">𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴊𐴧𐴞𐴥𐴔𐴝𐴕 𐴔𐴝𐴎𐴞𐴥 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴝𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴁𐴡𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴄𐴝𐴙𐴔𐴡𐴌 𐴖𐴡𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴁𐴝𐴍𐴞𐴊𐴞 𐴁𐴡𐴓𐴧𐴝؟</char> <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" /><char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴒𐴡𐴗𐴀𐴌 𐴀𐴟𐴁𐴝𐴤 𐴎𐴝𐴌𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴘𐴓𐴠𐴤 𐴈𐴝𐴔 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴓𐴡𐴦𐴃𐴉𐴝.</char> <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴁𐴡𐴥.</char> <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴎𐴡𐴊𐴞 𐴇𐴠𐴥 𐴒𐴡𐴗𐴀𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀, ’𐴀𐴝𐴣𐴀𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴝𐴘𐴃𐴠𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴊𐴠𐴌𐴞 𐴀𐴝𐴏𐴠𐴤,‘ 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴒𐴡𐴗𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴣𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴌𐴝𐴃𐴢 𐴊𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥 𐴄𐴟𐴀𐴓𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘;</char> <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" /><char style="wj">𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴠𐴥 𐴒𐴡𐴗𐴀𐴌𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴠𐴀𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴎𐴠 𐴊𐴞𐴕 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴕𐴡 𐴄𐴝𐴥𐴀𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴀𐴕 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴎𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴃𐴠 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠. 𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴝𐴍𐴞 𐴇𐴝𐴥𐴕-𐴇𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char><verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />
    <char style="wj">”𐴎𐴠 𐴒𐴡𐴗𐴀𐴌𐴠 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥𐴌𐴠 𐴎𐴝𐴕𐴠 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴘𐴧𐴝𐴌 𐴕𐴡𐴥 𐴘𐴝𐴥𐴃𐴡 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴞𐴐𐴞𐴤 𐴉𐴞𐴍𐴝 𐴇𐴝𐴥𐴘𐴁𐴡;</char> <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴡 𐴎𐴝𐴕𐴞, 𐴉𐴞𐴍𐴝 𐴇𐴝𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴔 𐴉𐴞𐴍𐴝 𐴇𐴝𐴥𐴘𐴁𐴡. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴝𐴌𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴝𐴌𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴒𐴝 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="LUK 12:48" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞</para>
  <para style="r">(<ref loc="MAT 10:34-36">𐴔𐴡𐴃𐴢 10‏:34‏-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴡𐴦𐴙𐴕 𐴎𐴡𐴓𐴝𐴘𐴊𐴞𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴎𐴡𐴓𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴀𐴝𐴀𐴛 𐴑𐴠𐴀𐴕 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴃𐴝𐴔!</char> <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴞𐴥𐴁𐴝 𐴕𐴡𐴥 𐴓𐴡𐴘 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴀𐴛 𐴑𐴠𐴀𐴕 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢 𐴀𐴝𐴏𐴞𐴤!</char> <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" /><char style="wj">𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴐𐴝𐴥𐴕𐴃𐴞 𐴊𐴞𐴦𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴡 𐴕𐴞𐴥𐴑𐴞؟ 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠;</char> <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴇𐴡𐴥𐴕𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴠𐴑 𐴒𐴡𐴥𐴌𐴡𐴌 𐴉𐴝𐴣𐴏𐴢 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴓𐴡𐴑-𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘: 𐴃𐴞𐴕 𐴎𐴡𐴕 𐴊𐴟𐴘 𐴎𐴡𐴕𐴡𐴌 𐴀𐴟𐴓𐴋𐴝, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴃𐴞𐴕 𐴎𐴡𐴕𐴡𐴌 𐴀𐴟𐴓𐴋𐴝.</char> <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘: 𐴉𐴟𐴖𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴁𐴝𐴉𐴢, 𐴁𐴝𐴉𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴉𐴟𐴖𐴝, 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴔𐴝𐴦, 𐴔𐴝𐴦𐴌 𐴀𐴟𐴓𐴋𐴝 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝, 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴀𐴟𐴓𐴋𐴝 𐴇𐴡𐴥𐴖𐴌𐴞, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴥𐴖𐴌𐴞𐴌 𐴀𐴟𐴓𐴋𐴝 𐴁𐴡𐴖𐴢.“ </char><verse eid="LUK 12:53" /></para>
  <para style="s1">𐴀𐴡𐴑𐴃𐴡𐴥 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴝𐴥</para>
  <para style="r">(<ref loc="MAT 16:2-3">𐴔𐴡𐴃𐴢 16‏:2‏-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴡𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴡𐴏𐴞𐴥𐴔𐴡𐴃𐴧𐴟 𐴔𐴞𐴘𐴟𐴥𐴓𐴝 𐴀𐴟𐴍𐴠𐴤𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴈𐴡𐴀 𐴊𐴠, ’𐴎𐴡𐴥𐴌 𐴀𐴝𐴘𐴁𐴡𐴤,‘ 𐴀𐴝𐴦𐴌 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥.</char> <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" /><char style="wj">𐴀𐴝𐴦𐴌 𐴊𐴡𐴀𐴘𐴕𐴝𐴓𐴞 𐴁𐴡𐴘𐴧𐴝𐴌 𐴁𐴝𐴘𐴓𐴠𐴥 𐴈𐴡𐴀 𐴊𐴠, ’𐴒𐴡𐴌𐴡𐴔 𐴉𐴡𐴌𐴞𐴁𐴡𐴥,‘ 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥.</char> <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" /><char style="wj">𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢! 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴏𐴝𐴀𐴘𐴢 𐴔𐴡𐴀𐴏𐴟𐴔 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴎𐴝𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴇𐴡𐴥𐴕𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌𐴠 𐴑𐴞𐴘𐴝𐴥 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴎𐴝𐴕𐴡؟</char><verse eid="LUK 12:56" /></para>
  <para style="s1">𐴊𐴟𐴐𐴧𐴡𐴕 𐴓𐴡𐴘 𐴁𐴡𐴕𐴡𐴕</para>
  <para style="r">(<ref loc="MAT 5:25-26">𐴔𐴡𐴃𐴢 5‏:25‏-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴑𐴞𐴘𐴝𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤؟</char> <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴟𐴐𐴧𐴡𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴡𐴦, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴡𐴥𐴘 𐴔𐴝𐴦𐴔𐴠𐴓𐴝 𐴇𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴉𐴟𐴓𐴞𐴐𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴁𐴡, 𐴁𐴝𐴦𐴊𐴠 𐴉𐴟𐴓𐴞𐴐𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴢 𐴔𐴝𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴉𐴡𐴘𐴐𐴝𐴤 𐴕𐴡𐴥 𐴊𐴡𐴦 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴈𐴠𐴥𐴕𐴃𐴟 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.“</char><verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s1">𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴇𐴝𐴥𐴓𐴝𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴝𐴒𐴡𐴘</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴝𐴥𐴎𐴞𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 𐴊𐴞𐴥𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴉𐴞𐴓𐴝𐴃𐴠 𐴑𐴡𐴃𐴡𐴥𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴠𐴥 𐴊𐴡𐴐𐴝𐴤 𐴒𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴡𐴃𐴢 𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓؟</char> <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴡𐴖𐴝𐴥 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴝𐴥𐴓𐴝𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴝𐴒𐴡𐴘.</char> <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" /><char style="wj">𐴘𐴝𐴥 𐴎𐴠 𐴀𐴝𐴣𐴍𐴝𐴥𐴌𐴡 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴏𐴞𐴥𐴓𐴡𐴔𐴡𐴌 𐴔𐴞𐴕𐴝𐴥𐴌 𐴉𐴡𐴌𐴞 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴡𐴃𐴢 𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓؟ </char> <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴡𐴖𐴝𐴥 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴝𐴥𐴓𐴝𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴝𐴒𐴡𐴘.“</char><verse eid="LUK 13:5" /></para>
  <para style="s1">𐴒𐴟𐴓𐴝 𐴏𐴝𐴥𐴌𐴝 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴈𐴡𐴘𐴧𐴠𐴥: <char style="wj">”𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴒𐴝𐴕𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴓𐴝𐴒𐴝𐴀𐴙𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥𐴃𐴢 𐴒𐴟𐴓𐴝 𐴃𐴟𐴖𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴘𐴡𐴥 𐴕𐴡𐴥 𐴉𐴝𐴦.</char> <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴝𐴒𐴝𐴕 𐴏𐴡𐴥𐴣𐴓𐴡𐴘𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴏𐴝𐴀, 𐴀𐴝𐴀𐴛 𐴃𐴞𐴕 𐴁𐴡𐴏𐴡𐴥𐴌 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴠 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥𐴃𐴢 𐴒𐴟𐴓𐴝 𐴃𐴟𐴖𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴘𐴧𐴞𐴤𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴘𐴡𐴥 𐴕𐴡𐴥 𐴉𐴝𐴘. 𐴘𐴞𐴁𐴝𐴤𐴌𐴠 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴝, 𐴘𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴝𐴥𐴕𐴧𐴝𐴑 𐴔𐴠𐴍𐴞 𐴑𐴞𐴘𐴝𐴥 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥؟‘</char> <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" /><char style="wj">𐴏𐴡𐴥𐴣𐴓𐴡𐴘𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴘𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴠 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴡𐴥 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴊𐴡𐴥, 𐴀𐴝𐴀𐴛 𐴘𐴞𐴁𐴝𐴤𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴑𐴟𐴌𐴞𐴥 𐴉𐴝𐴥𐴣𐴐𐴢 𐴊𐴞𐴥𐴘𐴟𐴔.</char> <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" /><char style="wj">𐴁𐴝𐴦𐴊𐴠 𐴎𐴡𐴊𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴁𐴡𐴏𐴡𐴥𐴌 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴄𐴞𐴥𐴑 𐴀𐴝𐴏𐴠𐴤; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠, 𐴈𐴝𐴍𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴡.‘ “</char><verse eid="LUK 13:9" /></para>
  <para style="s1">𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴀𐴠𐴑 𐴒𐴟𐴎𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />𐴀𐴠𐴑 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴠𐴌. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴁𐴝𐴕𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴣𐴍𐴝𐴥𐴌𐴡 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴒𐴟𐴎𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴀𐴟𐴎𐴟 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴉𐴝𐴙𐴃𐴧𐴡. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴋𐴝𐴥𐴑𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡 𐴇𐴝𐴥𐴓𐴝, 𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴔𐴡𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴀𐴡𐴥𐴘𐴧𐴡.“</char> <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴥𐴃𐴢 𐴊𐴞𐴥𐴘𐴠, 𐴃𐴡𐴥𐴘 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴟𐴎𐴟 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />𐴓𐴠𐴑𐴞𐴕 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴒𐴟𐴐𐴧𐴝𐴤 𐴒𐴡𐴥𐴌𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴈𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴡𐴥 𐴊𐴞𐴕 𐴀𐴝𐴏𐴠𐴤; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴊𐴞𐴕 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴡𐴒𐴝𐴘, 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴕𐴡.“<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴓𐴞𐴑𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴑𐴞𐴥 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴕𐴞𐴎𐴡𐴌 𐴊𐴡𐴀𐴣𐴌𐴝 𐴒𐴡𐴌𐴟𐴌𐴠 𐴘𐴝𐴥 𐴒𐴝𐴊𐴝𐴤𐴌𐴠 𐴀𐴟𐴌𐴝𐴃𐴧𐴟 𐴑𐴟𐴥𐴓𐴞 𐴉𐴝𐴕𐴞𐴥 𐴈𐴝𐴥𐴁𐴝𐴘𐴃𐴡 𐴕𐴡 𐴓𐴡𐴘𐴎𐴡 𐴕𐴠𐴥؟</char> <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" /><char style="wj">𐴃𐴡𐴥𐴘 𐴀𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴠 𐴀𐴝𐴣𐴍𐴝𐴥𐴌𐴡 𐴁𐴡𐴏𐴡𐴥𐴌 𐴉𐴝𐴥𐴕 𐴁𐴝𐴣𐴊𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴘𐴡𐴒𐴧𐴗𐴝𐴥𐴌𐴠 𐴑𐴞𐴥 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴇𐴠𐴥 𐴁𐴝𐴣𐴊𐴝𐴤𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴕𐴡 𐴎𐴝 𐴕𐴠𐴥؟“</char><verse eid="LUK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴐𐴡𐴥𐴌𐴡𐴔 𐴉𐴝𐴘𐴧𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝 𐴈𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴝𐴖𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="LUK 13:17" /></para>
  <para style="s1">𐴇𐴡𐴥𐴌𐴡𐴙𐴌 𐴊𐴝𐴕𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 13:31-32">𐴔𐴡𐴃𐴢 13‏:31‏-32</ref>; <ref loc="MRK 4:30-32">𐴔𐴝𐴑 4‏:30‏-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴑𐴞𐴘𐴡𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝؟ 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴑𐴞𐴦 𐴓𐴡𐴘 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟</char> <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" /><char style="wj">𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴇𐴡𐴥𐴌𐴡𐴙𐴌 𐴊𐴝𐴕𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴓𐴡𐴦𐴘𐴢 𐴕𐴞𐴎𐴡𐴌 𐴑𐴠𐴥𐴃𐴞𐴃𐴢 𐴓𐴝𐴒𐴝𐴘𐴠𐴥𐴒𐴡𐴘; 𐴘𐴞𐴥𐴁𐴝 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴞𐴤 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴝𐴏𐴢 𐴁𐴡𐴙𐴕𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴁𐴝𐴇𐴝𐴤 𐴁𐴝𐴙𐴕𐴊𐴠𐴤.“</char><verse eid="LUK 13:19" /></para>
  <para style="s1">𐴐𐴟𐴥𐴄𐴝𐴌𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 13:33">𐴔𐴡𐴃𐴢 13‏:33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌𐴠 𐴑𐴞𐴦 𐴓𐴡𐴘 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟</char> <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" /><char style="wj">𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴐𐴟𐴥𐴄𐴝𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴓𐴡𐴦𐴘𐴢 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴀𐴠𐴑𐴧𐴟𐴌𐴞 𐴃𐴞𐴕 𐴐𐴠𐴥𐴌 𐴀𐴝𐴄𐴝𐴃𐴢 𐴔𐴞𐴘𐴝𐴥𐴘𐴧𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴒𐴟𐴣𐴍𐴝 𐴈𐴝𐴛𐴡𐴌 𐴊𐴡𐴓𐴝 𐴉𐴟𐴥𐴓𐴞 𐴀𐴟𐴙𐴄𐴧𐴠𐴥.“</char><verse eid="LUK 13:21" /></para>
  <para style="s1">𐴏𐴞𐴘𐴡𐴕 𐴊𐴡𐴌𐴡𐴎𐴝</para>
  <para style="r">(<ref loc="MAT 7:13-14">𐴔𐴡𐴃𐴢 7‏:13‏-14</ref>‏,<ref loc="MAT 7:21-23">21‏-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />𐴀𐴞𐴏𐴝𐴤 𐴐𐴡𐴥𐴀𐴌𐴠-𐴐𐴡𐴥𐴀𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴌𐴝-𐴉𐴝𐴌𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞-𐴊𐴞, 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴀𐴟𐴎𐴟 𐴎𐴝𐴦𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴡𐴘𐴝 𐴈𐴡𐴔 𐴕𐴞𐴥𐴑𐴞؟“</para>
  <para style="p" vid="LUK 13:23">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" /><char style="wj">”𐴏𐴞𐴘𐴡𐴕 𐴊𐴡𐴌𐴡𐴎𐴝 𐴁𐴝𐴥𐴘 𐴒𐴡𐴥𐴓𐴞 𐴁𐴡𐴓𐴧𐴝 𐴎𐴝𐴕-𐴉𐴡𐴌𐴝𐴕𐴠 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴒𐴡𐴥𐴙𐴓𐴃𐴡 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴒𐴡𐴥𐴌𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴀𐴟𐴍𐴞𐴤 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴣𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴀𐴌𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴅𐴧𐴝𐴘-𐴁𐴝𐴅𐴧𐴝𐴘 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴌𐴞𐴁𐴝, ’𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝𐴌 𐴒𐴝𐴥𐴕 𐴑𐴟𐴥𐴓𐴡.‘</char></para>
  <para style="p" vid="LUK 13:25">
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴕𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴍𐴞𐴥𐴘𐴝𐴌.‘</char><verse eid="LUK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴌𐴞𐴁𐴝 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴌𐴝𐴏𐴃𐴝-𐴌𐴝𐴏𐴃𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴃𐴝.‘</char><verse eid="LUK 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴕𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴍𐴞𐴥𐴘𐴝𐴌. 𐴑𐴟𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴣𐴀𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴊𐴟𐴌 𐴀𐴡𐴥.‘</char><verse eid="LUK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28" />
    <char style="wj">”𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴃𐴠 𐴊𐴝𐴃𐴢 𐴑𐴞𐴌𐴑𐴞𐴌𐴝𐴘𐴁𐴝𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠𐴑𐴞𐴥𐴁𐴝 𐴊𐴠, 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔, 𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑, 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴝𐴀𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠.</char> <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" /><char style="wj">𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴑, 𐴉𐴡𐴏𐴞𐴥𐴔, 𐴀𐴟𐴃𐴧𐴡𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴀𐴙𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴘𐴁𐴡𐴥.</char> <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" /><char style="wj">𐴁𐴠𐴐𐴡𐴥𐴑, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠𐴇𐴡𐴥𐴕 𐴉𐴞𐴏𐴠𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴒𐴠 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴝𐴒𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴞𐴏𐴠𐴤 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“</char><verse eid="LUK 13:30" /></para>
  <para style="s1">𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢</para>
  <para style="r">(<ref loc="MAT 23:37-39">𐴔𐴡𐴃𐴢 23‏:37‏-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴠 𐴎𐴝𐴒𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴔𐴞𐴑𐴧𐴝𐴥 𐴎𐴡𐴦𐴒𐴡𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴙𐴓𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌.“<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴦, 𐴇𐴠𐴥 𐴐𐴞𐴥𐴘𐴝𐴓𐴡𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴀𐴝𐴙𐴅𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴙𐴓𐴧𐴝 𐴁𐴟𐴥𐴃𐴢 𐴊𐴝𐴥𐴉𐴝𐴘𐴧𐴟𐴔 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔, 𐴀𐴝𐴦𐴌 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴀𐴝𐴣𐴀𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.‘</char> <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" /><char style="wj">𐴎𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴡𐴥𐴑, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴙𐴅𐴧𐴝, 𐴇𐴝𐴙𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴀𐴌𐴟𐴌 𐴀𐴟𐴎𐴟 𐴏𐴡𐴉𐴡𐴥𐴌 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴁𐴞𐴌 𐴔𐴡𐴦𐴃𐴢 𐴃𐴡 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.</char><verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />
    <char style="wj">”𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔, 𐴀𐴡𐴥 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔, 𐴃𐴟𐴘 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴡𐴃𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴃𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴐𐴞𐴥𐴓𐴡𐴌 𐴊𐴡𐴓𐴝 𐴔𐴝𐴌𐴡𐴏𐴢. 𐴑𐴟𐴀𐴣𐴌𐴞-𐴑𐴟𐴌𐴝𐴤𐴘𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴏𐴡𐴥𐴀 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴉𐴝𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴇𐴡𐴃𐴡𐴥 𐴁𐴝𐴌 𐴏𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡𐴥 𐴏𐴡𐴀.</char> <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" /><char style="wj">𐴉𐴟𐴥𐴕𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴡𐴥𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴟𐴑𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴏𐴝𐴥𐴌𐴝𐴒𐴡𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴁𐴝 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡𐴥 𐴈𐴡𐴀 𐴊𐴠, ’𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.‘ “</char><note caller="+" style="f"><char style="fr" closed="false">13‏:35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:26">𐴎𐴡𐴁𐴟𐴌 118‏:26</ref></char></char></note><verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s1">𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />𐴀𐴠𐴑𐴁𐴝𐴌 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴠𐴑 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴈𐴝𐴥𐴀𐴏𐴢 𐴕𐴡𐴎𐴡𐴌 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴥𐴓𐴝 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴝𐴏𐴠𐴤. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴝𐴘𐴠𐴏𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥 𐴕𐴝𐴥𐴘؟“</char> <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴝𐴥𐴔 𐴔𐴝𐴥𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴥𐴃𐴠 𐴊𐴡𐴥𐴌𐴞 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴁𐴝𐴦𐴊𐴠 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞𐴘𐴠𐴥.<verse eid="LUK 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕 𐴀𐴝𐴏𐴡𐴤, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴝𐴥 𐴊𐴡𐴀𐴣𐴌𐴝-𐴒𐴡𐴌𐴟 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴑𐴟𐴖𐴝𐴃𐴢 𐴉𐴡𐴌𐴞𐴓𐴠𐴥, 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴃𐴟𐴓𐴞𐴤 𐴕𐴡 𐴓𐴡𐴘𐴁𐴝 𐴊𐴠؟“</char> <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠.<verse eid="LUK 14:6" /></para>
  <para style="s1">𐴕𐴞𐴏𐴡 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴝𐴖𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴔𐴠𐴀𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴀𐴞𐴎𐴧𐴡𐴙𐴃𐴧𐴝 𐴎𐴝𐴒𐴝 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴦𐴌 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴘𐴠𐴥: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" /><char style="wj">”𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴡𐴘𐴌𐴝𐴙𐴃𐴧𐴝 𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴓𐴠𐴥, 𐴎𐴝𐴘𐴧𐴡𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴙𐴃𐴧𐴝 𐴎𐴝𐴒𐴝𐴃𐴢 𐴕𐴡 𐴁𐴡𐴙𐴐𐴧𐴡𐴥𐴒𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴀𐴞𐴎𐴧𐴡𐴃𐴊𐴝𐴥𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥.</char> <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" /><char style="wj">𐴎𐴡𐴊𐴞 𐴁𐴡𐴘𐴧𐴡𐴥, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴊𐴡𐴦.‘ 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴐𐴡𐴥𐴌𐴡𐴔 𐴉𐴝𐴘, 𐴕𐴞𐴏𐴡𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴎𐴝𐴘 𐴁𐴟𐴀𐴝𐴤 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" /><char style="wj">𐴘𐴝𐴥𐴌𐴁𐴡𐴊𐴡𐴓𐴢, 𐴊𐴝𐴖𐴡𐴃𐴢 𐴉𐴝𐴘𐴓𐴠, 𐴎𐴝𐴘𐴧𐴡𐴌𐴠 𐴕𐴞𐴏𐴡𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴁𐴡𐴙𐴐𐴧𐴡𐴥𐴒𐴡𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀 𐴊𐴠, ’𐴊𐴟𐴏𐴃𐴡𐴥, 𐴖𐴡𐴌𐴡𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴎𐴝𐴘 𐴁𐴡𐴘𐴧𐴡𐴥𐴒𐴡𐴘.‘ 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴌 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴉𐴝𐴘𐴁𐴝.</char> <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴥𐴖𐴝𐴓𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴑𐴟𐴥𐴖𐴝𐴓𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴊𐴟𐴀𐴣𐴙𐴅𐴧𐴝𐴌 𐴘𐴝𐴥 𐴁𐴞𐴘𐴝𐴓𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴒𐴡𐴌𐴞𐴥𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠, 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌𐴠, 𐴀𐴠𐴒𐴝𐴕𐴝𐴒𐴟𐴙𐴐𐴧𐴞𐴥 𐴌𐴠, 𐴘𐴝𐴥 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥; 𐴎𐴡𐴊𐴞 𐴊𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞 𐴉𐴟𐴥𐴣𐴎𐴝𐴘𐴊𐴞𐴁𐴡.</char> <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" /><char style="wj">𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴃𐴟𐴀𐴛 𐴈𐴝𐴥𐴕𐴝 𐴒𐴡𐴌𐴞𐴥𐴓𐴠, 𐴓𐴟𐴓𐴝𐴤, 𐴓𐴠𐴚, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴡,</char> <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" /><char style="wj">𐴃𐴡𐴥𐴘 𐴃𐴟𐴀𐴛 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴉𐴝𐴘𐴁𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴉𐴟𐴥𐴣𐴎𐴝𐴘𐴊𐴞 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥; 𐴀𐴝𐴦𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴝𐴥𐴣𐴐𐴡𐴌-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘 𐴀𐴟𐴍𐴞𐴤𐴁𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴃𐴟𐴀𐴛 𐴁𐴡𐴊𐴡𐴓𐴝 𐴉𐴝𐴘𐴁𐴝.“</char><verse eid="LUK 14:14" /></para>
  <para style="s1">𐴋𐴡𐴣𐴀𐴌 𐴔𐴠𐴓𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 22:1-10">𐴔𐴡𐴃𐴢 22‏:1‏-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴁𐴡.“<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴥𐴕𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥.</char> <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" /><char style="wj">𐴈𐴝𐴥𐴕𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴔𐴝𐴃𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, ’𐴀𐴝𐴘𐴧𐴡𐴤, 𐴘𐴝𐴓𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴡𐴥𐴘𐴧𐴠.‘</char><verse eid="LUK 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴡𐴕-𐴎𐴡𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴁𐴝𐴇𐴝𐴤𐴕𐴝 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴉𐴡𐴀𐴘𐴓𐴝𐴌 𐴀𐴞𐴥𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴎𐴝𐴒𐴝 𐴑𐴞𐴕𐴧𐴞𐴥, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴝𐴘𐴃𐴡𐴥 𐴎𐴝𐴦 𐴉𐴡𐴌𐴞𐴁𐴡𐴥; 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴡𐴤.‘</char><verse eid="LUK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19" />
    <char style="wj">”𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴉𐴝𐴣𐴏𐴢 𐴎𐴟𐴌𐴝 𐴊𐴡𐴀𐴣𐴌𐴝-𐴒𐴡𐴌𐴟 𐴑𐴞𐴕𐴧𐴞𐴥, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴥𐴍𐴞𐴁𐴡 𐴕𐴠𐴥 𐴏𐴝𐴘𐴃𐴡𐴥 𐴎𐴝𐴙𐴌; 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴡𐴤.‘</char><verse eid="LUK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20" />
    <char style="wj">”𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴥𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴕𐴡𐴘𐴝-𐴕𐴡𐴘𐴝 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠; 𐴀𐴝𐴀𐴛 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴙𐴅𐴧𐴟𐴔.‘</char><verse eid="LUK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21" />
    <char style="wj">”𐴃𐴡𐴥𐴘 𐴒𐴡𐴗𐴀𐴌𐴒𐴗𐴝𐴥 𐴀𐴝𐴀𐴘𐴢 𐴃𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥. 𐴁𐴝𐴦𐴊𐴠 𐴒𐴡𐴥𐴌𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴒𐴟𐴐𐴧𐴝𐴤 𐴒𐴡𐴥𐴌𐴞 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴗𐴀𐴌𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴌𐴝𐴏𐴃𐴝-𐴌𐴝𐴏𐴃𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴓𐴊𐴞-𐴒𐴡𐴓𐴊𐴞 𐴎𐴝𐴘 𐴒𐴡𐴌𐴞𐴉𐴢, 𐴔𐴝𐴎𐴟𐴌, 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴓𐴠𐴚 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴝𐴕𐴒𐴡𐴥𐴘.‘</char><verse eid="LUK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22" />
    <char style="wj">”𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴒𐴡𐴗𐴀𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴎𐴠𐴀𐴕 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴇𐴠𐴥𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴎𐴝𐴒𐴝 𐴇𐴝𐴥𐴓𐴞 𐴀𐴝𐴏𐴠𐴤.‘</char><verse eid="LUK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23" />
    <char style="wj">”𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴒𐴡𐴗𐴀𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴁𐴝𐴀𐴌𐴠 𐴌𐴝𐴏𐴃𐴝-𐴌𐴝𐴏𐴃𐴝 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴣𐴃𐴠𐴥-𐴉𐴡𐴣𐴃𐴠𐴥 𐴎𐴝𐴦, 𐴎𐴝𐴘 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴅𐴁𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴐𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴥𐴌 𐴁𐴡𐴥𐴌𐴞𐴎𐴝𐴒𐴡𐴘. </char> <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴥𐴕𐴝 𐴇𐴝𐴥𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.‘ “</char><verse eid="LUK 14:24" /></para>
  <para style="s1">𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="MAT 10:37-38">𐴔𐴡𐴃𐴢 10‏:37‏-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />𐴀𐴠𐴑𐴁𐴝𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴥𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" /><char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴧𐴠𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴢, 𐴔𐴝𐴦, 𐴁𐴡𐴖𐴢, 𐴉𐴟𐴀𐴝𐴙𐴕, 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴥𐴘𐴕𐴝𐴙𐴕 𐴀𐴡𐴌𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕𐴡𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴔 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴙𐴓𐴧𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴢 𐴕𐴡 𐴁𐴡𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.</char><verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />
    <char style="wj">”𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴞𐴕𐴝𐴥𐴌 𐴁𐴝𐴕𐴝𐴘𐴃𐴡𐴥 𐴏𐴝𐴘𐴓𐴠𐴥 𐴀𐴝𐴒𐴠 𐴁𐴡𐴀𐴘𐴢 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴁𐴝𐴕𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴟𐴓𐴝 𐴊𐴠 𐴇𐴠𐴥𐴊𐴟𐴕 𐴄𐴞𐴛𐴝-𐴉𐴡𐴘𐴐𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥 𐴕𐴝𐴥𐴘 𐴑𐴞𐴘𐴝𐴏𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴊𐴠𐴥؟</char> <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" /><char style="wj">𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴡 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴒𐴟𐴙𐴅𐴧𐴝 𐴒𐴝𐴥𐴕 𐴃𐴟𐴓𐴞𐴤 𐴁𐴝𐴦𐴊𐴠 𐴒𐴟𐴣𐴍𐴝 𐴃𐴟𐴓𐴞𐴤 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴠𐴑𐴞𐴥𐴁𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴃𐴠𐴥𐴐𐴠𐴌𐴝𐴘𐴁𐴡,</char> <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" /><char style="wj">𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢, ’𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴁𐴝𐴕𐴝 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴒𐴟𐴣𐴍𐴝 𐴃𐴟𐴓𐴞𐴤 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠.‘</char><verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />
    <char style="wj">”𐴘𐴝𐴥𐴃𐴡, 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴌𐴀𐴠𐴑 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴎𐴝𐴘𐴁𐴝𐴌 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴀𐴝𐴒𐴠 𐴁𐴡𐴀𐴘𐴢 𐴕𐴞𐴎𐴡𐴌 𐴊𐴡𐴐𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴉𐴡𐴥𐴗𐴏𐴢 𐴓𐴡𐴥𐴘, 𐴕𐴞𐴎𐴡𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴑𐴟𐴌𐴞 𐴀𐴝𐴥𐴎𐴝𐴌 𐴉𐴡𐴥𐴗𐴏𐴡𐴌 𐴔𐴟𐴑𐴝𐴁𐴠𐴓𐴝 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴕𐴠𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴑𐴞𐴘𐴝𐴏𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴊𐴠𐴥؟</char> <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" /><char style="wj">𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴕𐴡𐴔𐴝𐴙𐴕𐴊𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘, 𐴁𐴡𐴕𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘 𐴓𐴧𐴝 𐴐𐴡𐴌𐴡𐴥𐴃𐴡𐴌 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char> <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" /><char style="wj">𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴠𐴌𐴞 𐴕𐴡 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.</char><verse eid="LUK 14:33" /></para>
  <para style="s1">𐴔𐴡𐴎𐴝 𐴏𐴝𐴥𐴌𐴝 𐴕𐴟𐴕 𐴑𐴞𐴔𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝</para>
  <para style="r">(<ref loc="MAT 5:13">𐴔𐴡𐴃𐴢 5‏:13</ref>; <ref loc="MRK 9:50">𐴔𐴝𐴑 9‏:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />
    <char style="wj">”𐴕𐴟𐴕 𐴃𐴡 𐴒𐴡𐴔 𐴅𐴞𐴕𐴞𐴥𐴐𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴕𐴟𐴕𐴡𐴌 𐴊𐴡𐴑 𐴎𐴝𐴦𐴒𐴡𐴥𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴝𐴁𐴝𐴌 𐴕𐴟𐴕𐴐𐴝𐴥 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡؟</char> <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" /><char style="wj">𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴕𐴡 𐴎𐴡𐴁𐴞𐴕𐴡𐴓𐴧𐴝 𐴈𐴝𐴔 𐴀𐴝𐴘𐴧𐴠𐴤 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴉𐴝𐴥𐴣𐴐𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴈𐴝𐴔 𐴀𐴝𐴘𐴧𐴠𐴤; 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴝𐴀𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴠.</char></para>
  <para style="p" vid="LUK 14:35">
    <char style="wj">”𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴥𐴕𐴡.“</char><verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s1">𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 18:12-14">𐴔𐴡𐴃𐴢 18‏:12‏-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />𐴃𐴝𐴔𐴝𐴥𐴔 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴃𐴡𐴤. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴐𐴠𐴥𐴑𐴝𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴔𐴞𐴛𐴝𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀.“<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴈𐴡𐴘𐴧𐴠𐴥: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" /><char style="wj">”𐴊𐴡𐴥𐴌𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴡𐴊𐴞 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴥𐴣𐴎𐴞𐴎𐴝𐴒𐴡𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴠 𐴑𐴞𐴥 𐴕𐴡𐴁𐴧𐴡𐴘-𐴕𐴡𐴖 𐴖𐴝𐴌𐴠 𐴑𐴞𐴥𐴓𐴝𐴃𐴢 𐴀𐴠𐴌𐴞, 𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴖𐴝𐴘 𐴕𐴡𐴥 𐴉𐴝𐴦 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴕𐴡 𐴃𐴟𐴖𐴝𐴘𐴁𐴡𐴥 𐴕𐴠𐴥؟</char> <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" /><char style="wj">𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴖𐴝𐴘 𐴉𐴝𐴘𐴓𐴠 𐴃𐴡 𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴝𐴣𐴊𐴡𐴥𐴃𐴢 𐴓𐴡𐴘𐴁𐴡,</char> <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" /><char style="wj">𐴀𐴝𐴦𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴙𐴅𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤𐴒𐴝𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴓𐴗𐴝𐴥 𐴃𐴟𐴖𐴝𐴘 𐴉𐴝𐴘𐴧𐴞𐴥.‘</char> <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴄𐴞𐴥𐴑 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡 𐴉𐴡𐴌𐴠 𐴊𐴠 𐴕𐴡𐴁𐴧𐴡𐴘-𐴕𐴡𐴖 𐴎𐴡𐴕 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴀𐴠𐴎𐴧𐴡𐴕 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴁𐴡.“ </char><verse eid="LUK 15:7" /></para>
  <para style="s1">𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴉𐴡𐴘𐴐𐴝𐴤𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />
    <char style="wj">”𐴘𐴝𐴥, 𐴊𐴡𐴥𐴌𐴡 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴌𐴟𐴉𐴝𐴌 𐴉𐴡𐴘𐴐𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴡𐴊𐴞 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴡𐴘𐴐𐴝𐴤 𐴀𐴝𐴥𐴣𐴎𐴞𐴎𐴝𐴒𐴡𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴥 𐴏𐴠𐴌𐴝𐴑 𐴊𐴡𐴥𐴌𐴝𐴘 𐴒𐴡𐴥𐴌 𐴑𐴟𐴦𐴣𐴏𐴝𐴘 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴃𐴟𐴖𐴝𐴘 𐴕𐴡𐴥 𐴉𐴝𐴦 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴒𐴡𐴌𐴞 𐴕𐴡 𐴃𐴟𐴖𐴝𐴘𐴁𐴡𐴥 𐴕𐴠𐴥؟</char> <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" /><char style="wj">𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴖𐴝𐴘 𐴉𐴝𐴘𐴓𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴙𐴅𐴧𐴝𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴁𐴡𐴤, ’𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤𐴒𐴝𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴉𐴡𐴘𐴐𐴝𐴤 𐴒𐴝𐴥𐴕 𐴃𐴟𐴖𐴝𐴘 𐴉𐴝𐴘𐴧𐴞𐴥.‘</char> <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴄𐴞𐴥𐴑 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥.“</char><verse eid="LUK 15:10" /></para>
  <para style="s1">𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴉𐴟𐴖𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴊𐴟𐴖𐴝𐴥 𐴉𐴟𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.</char> <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴐𐴡𐴥𐴣𐴍𐴡 𐴖𐴝𐴘𐴠 𐴁𐴝𐴉𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴁𐴝𐴤, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴌𐴝𐴃𐴡𐴃𐴢 𐴉𐴡𐴌𐴠 𐴊𐴠 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴡.‘ 𐴃𐴡𐴥𐴘 𐴁𐴝𐴉𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴌𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠.</char><verse eid="LUK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13" />
    <char style="wj">”𐴇𐴡𐴦𐴊𐴧𐴞𐴕 𐴁𐴝𐴦𐴊𐴠, 𐴉𐴟𐴖𐴝 𐴐𐴡𐴥𐴣𐴍𐴡 𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴊𐴡𐴓𐴝 𐴒𐴡𐴌𐴞𐴥 𐴓𐴡𐴦𐴘𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴟𐴌𐴡𐴥𐴌 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴠 𐴔𐴡𐴕𐴎𐴝𐴑𐴧𐴝𐴥 𐴏𐴡𐴓𐴞 𐴕𐴞𐴎𐴡𐴌 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴏𐴝𐴥𐴌𐴇𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.</char> <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴇𐴡𐴥𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴇𐴠𐴥 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴌𐴝𐴄𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴔𐴟𐴀𐴃𐴝𐴐𐴡𐴃𐴢 𐴉𐴡𐴌𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.</char> <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" /><char style="wj">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴠 𐴎𐴝𐴘 𐴇𐴠𐴥 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝𐴃𐴧𐴟 𐴈𐴝𐴔 𐴏𐴝𐴘𐴧𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴐𐴟𐴥𐴖𐴡𐴌 𐴏𐴡𐴌𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴑𐴞𐴥𐴓𐴝𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠.</char> <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" /><char style="wj">𐴐𐴟𐴥𐴖𐴡𐴌 𐴒𐴟𐴥𐴕𐴠 𐴎𐴠 𐴒𐴝𐴏𐴡𐴌 𐴏𐴡𐴥𐴛 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴝𐴥𐴘𐴃𐴡, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴥𐴘 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴝𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴃𐴡𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴕𐴡 𐴊𐴞𐴦𐴃𐴡.</char><verse eid="LUK 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17" />
    <char style="wj">”𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴠 𐴁𐴟𐴎𐴡𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴀𐴠𐴊𐴟𐴥𐴕 𐴔𐴟𐴎𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴈𐴝𐴥𐴕𐴝 𐴉𐴝𐴦𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴠𐴍𐴠𐴥 𐴁𐴟𐴥𐴑𐴧𐴠 𐴔𐴡𐴌𐴞𐴌!</char> <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴟𐴍𐴞𐴤 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘𐴧𐴟𐴔𐴁𐴡𐴥𐴘, 𐴎𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴊𐴠: 𐴀𐴝𐴁𐴝𐴤, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴓𐴋𐴝 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴞𐴥.</char> <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" /><char style="wj">𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴖𐴝 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡; 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴟𐴎𐴟𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴌𐴝𐴑𐴡𐴥.‘</char> <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" /><char style="wj">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴠 𐴀𐴟𐴍𐴞𐴤 𐴁𐴝𐴉𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴒𐴞𐴦𐴘𐴠𐴥.</char></para>
  <para style="p" vid="LUK 15:20">
    <char style="wj">”𐴀𐴞𐴥𐴃𐴠 𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴘𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴉𐴠𐴄𐴉𐴟𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴣𐴌𐴞 𐴎𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴝𐴣𐴎𐴝 𐴔𐴝𐴌𐴞 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥𐴘𐴠.</char><verse eid="LUK 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21" />
    <char style="wj">”𐴉𐴟𐴖𐴝𐴘𐴠 𐴁𐴝𐴉𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴁𐴝𐴤, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴓𐴋𐴝 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴖𐴝 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡.‘</char><verse eid="LUK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴝𐴉𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴀𐴠𐴁𐴧𐴠 𐴁𐴝𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴧𐴝 𐴀𐴝𐴕𐴞𐴤 𐴀𐴞𐴃𐴝𐴌𐴠𐴤 𐴉𐴞𐴣𐴊𐴝𐴥𐴘𐴊𐴡; 𐴀𐴞𐴃𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴡𐴀𐴣𐴍𐴞 𐴊𐴞𐴘𐴝𐴘𐴊𐴡 𐴀𐴝𐴦𐴌 𐴄𐴠𐴥𐴚𐴡𐴃𐴢 𐴐𐴠𐴕𐴄𐴝𐴥𐴌 𐴉𐴞𐴣𐴊𐴝𐴥𐴘𐴊𐴡.</char> <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" /><char style="wj">𐴒𐴡𐴌𐴟 𐴁𐴡𐴓𐴞 𐴖𐴝 𐴀𐴝𐴕𐴞𐴤 𐴎𐴡𐴦𐴌𐴡𐴥. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴥𐴘 𐴑𐴟𐴥𐴐𐴞-𐴀𐴝𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥.</char> <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴔𐴡𐴌𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠; 𐴀𐴞𐴃𐴠 𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴓𐴒𐴡𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴉𐴝𐴦 𐴒𐴞𐴘𐴠𐴥.‘ 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.</char><verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />
    <char style="wj">”𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴟𐴖𐴝 𐴋𐴡𐴣𐴀𐴌𐴒𐴗𐴝𐴥 𐴑𐴠𐴥𐴃𐴞𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴀𐴞𐴥𐴃𐴠 𐴒𐴡𐴥𐴌𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴃𐴝𐴓𐴁𐴝𐴎𐴝𐴕𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴕𐴝𐴏𐴡𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴠.</char> <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" /><char style="wj">𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴡𐴗𐴀𐴌𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘, 𐴀𐴠𐴍𐴠𐴥 𐴑𐴞𐴦 𐴀𐴡𐴥𐴌 𐴊𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" /><char style="wj">𐴃𐴠𐴦 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴉𐴠 𐴒𐴡𐴌𐴟 𐴁𐴡𐴓𐴞 𐴖𐴝 𐴎𐴡𐴦𐴌𐴝𐴥𐴘𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴓𐴝𐴔𐴡𐴃𐴠 𐴉𐴞𐴥𐴌𐴝𐴘 𐴉𐴝𐴘𐴧𐴠𐴥.‘</char><verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />
    <char style="wj">”𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴥𐴃𐴠 𐴒𐴟𐴐𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴝𐴦𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴃𐴡 𐴕𐴡 𐴏𐴝𐴌. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴝𐴉𐴢 𐴁𐴝𐴀𐴌𐴠 𐴀𐴝𐴀𐴘𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴔𐴝𐴕𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.</char> <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴠 𐴁𐴝𐴉𐴡𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴏𐴡𐴀, 𐴀𐴠𐴃𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴉𐴝𐴥𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴟𐴓𐴝𐴔𐴞 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴘𐴧𐴞𐴤𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴔𐴝𐴕𐴞 𐴕𐴡𐴥 𐴃𐴝𐴥𐴑𐴞; 𐴃𐴡𐴀 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴐𐴞-𐴀𐴝𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴏𐴡𐴥𐴀 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴊𐴞𐴦𐴘𐴡𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘.</char> <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴃𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴔𐴝𐴒𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴉𐴟𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴝 𐴒𐴡𐴌𐴟 𐴁𐴡𐴓𐴞 𐴖𐴝 𐴎𐴡𐴦𐴌𐴝𐴥𐴘𐴧𐴡.‘</char><verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴝𐴉𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴡 𐴉𐴟𐴃𐴢, 𐴃𐴟𐴘 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴝𐴏𐴡𐴤𐴏𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴊𐴠 𐴃𐴡𐴌.</char> <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴘𐴝𐴓𐴝 𐴑𐴟𐴥𐴐𐴞-𐴀𐴝𐴥𐴐𐴞 𐴀𐴠𐴊𐴧𐴠 𐴔𐴠𐴓𐴝 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴡𐴌 𐴁𐴝𐴥𐴘 𐴀𐴞𐴁𐴝𐴤 𐴔𐴡𐴌𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠; 𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴓𐴒𐴡𐴘, 𐴘𐴝𐴓𐴝 𐴉𐴝𐴦 𐴒𐴞𐴘𐴠𐴥.‘ “</char><verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s1">𐴁𐴠𐴘𐴔𐴝𐴕 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴎𐴧𐴡𐴕 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴊𐴡𐴥𐴕-𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴏𐴝𐴥𐴌𐴇𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠𐴌 𐴈𐴡𐴀𐴘𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠. </char> <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" /><char style="wj">𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴉𐴟𐴥𐴕𐴞𐴌؟ 𐴃𐴡𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞 𐴈𐴝𐴔𐴡𐴌 𐴀𐴞𐴥𐴏𐴝𐴉𐴢 𐴊𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴘 𐴀𐴝𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴃𐴝𐴥𐴑𐴞 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴞𐴥.‘</char><verse eid="LUK 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴘𐴝𐴦 𐴀𐴝𐴀𐴛 𐴑𐴞𐴦 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟ 𐴀𐴝𐴣𐴀𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴊𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞 𐴈𐴝𐴔 𐴓𐴡𐴘𐴉𐴠𐴓𐴠𐴌. 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴠 𐴔𐴠𐴍𐴞 𐴈𐴝𐴍𐴞𐴃𐴡𐴥 𐴁𐴡𐴓𐴢 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴥𐴌𐴝𐴃𐴢 𐴔𐴝𐴒𐴞𐴃𐴠𐴥 𐴘𐴡𐴥 𐴐𐴡𐴥𐴌𐴡𐴔 𐴓𐴝𐴒𐴠.</char> <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" /><char style="wj">𐴀𐴝𐴀𐴛 𐴑𐴞𐴦 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔 𐴊𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞 𐴈𐴝𐴔 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴠, 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴒𐴝 𐴊𐴠𐴦.‘</char><verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />
    <char style="wj">”𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴠 𐴎𐴡𐴕-𐴎𐴡𐴕 𐴒𐴡𐴌𐴞 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴉𐴡𐴦𐴃𐴞𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥, 𐴔𐴝𐴃𐴝𐴘 𐴉𐴡𐴀𐴘𐴓𐴝 𐴖𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴉𐴡𐴦𐴃𐴞 𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴝𐴦𐴌؟‘</char><verse eid="LUK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6" />
    <char style="wj">”𐴃𐴠𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴕𐴡𐴖 𐴐𐴡𐴥𐴃𐴢 𐴒𐴠𐴓𐴡𐴥𐴔</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">16‏:6 </char>
      <char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 3,000 𐴓𐴞𐴄𐴝𐴥𐴌</char>
    </note> <char style="wj">𐴎𐴝𐴘𐴃𐴟𐴕 𐴃𐴠𐴓𐴢.‘</char></para>
  <para style="p" vid="LUK 16:6">
    <char style="wj">”𐴀𐴞𐴥𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴞𐴓𐴢 𐴓𐴝𐴥𐴕 𐴓𐴡𐴦, 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴁𐴡𐴀𐴘𐴢 𐴏𐴝𐴙𐴌-𐴐𐴡𐴥 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢 𐴒𐴠𐴓𐴡𐴥𐴔 𐴓𐴠𐴑𐴞𐴥𐴊𐴡.‘</char><verse eid="LUK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7" />
    <char style="wj">”𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴝𐴦𐴌؟‘</char></para>
  <para style="p" vid="LUK 16:7">
    <char style="wj">”𐴃𐴠𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢 𐴔𐴡𐴕</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">16‏:7 </char>
      <char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 30 𐴄𐴡𐴕</char>
    </note> <char style="wj">𐴒𐴞𐴣𐴘𐴟.‘</char></para>
  <para style="p" vid="LUK 16:7">
    <char style="wj">”𐴀𐴞𐴥𐴃𐴠 𐴃𐴝𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴞𐴓𐴢 𐴓𐴝𐴥𐴕 𐴓𐴡𐴦, 𐴓𐴡𐴦𐴘𐴢 𐴏𐴝𐴓𐴞𐴐𐴢 𐴔𐴡𐴕 𐴓𐴠𐴑𐴞𐴥𐴊𐴡.‘</char><verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />
    <char style="wj">”𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴇𐴠𐴥 𐴁𐴠𐴘𐴔𐴝𐴕 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴡𐴌 𐴏𐴝𐴓𐴝𐴥𐴑𐴞 𐴈𐴝𐴔 𐴊𐴠𐴑𐴞𐴥 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴥𐴘 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢, 𐴕𐴟𐴌𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴏𐴝𐴓𐴝𐴥𐴑.</char> <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴢 𐴓𐴡𐴥𐴘 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴊𐴟𐴏𐴃𐴡𐴥 𐴁𐴝𐴕𐴡; 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴌𐴝𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴞 𐴎𐴝𐴒𐴝𐴃𐴢 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.</char><verse eid="LUK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10" />
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴈𐴡𐴔𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴞𐴐𐴞𐴤𐴃𐴢 𐴀𐴡𐴥 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴈𐴡𐴔𐴡𐴃𐴢 𐴁𐴠𐴘𐴔𐴝𐴕𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴞𐴐𐴞𐴤𐴃𐴢 𐴀𐴡𐴥 𐴁𐴠𐴘𐴔𐴝𐴕𐴞 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" /><char style="wj">𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴊𐴡𐴥𐴕 𐴇𐴡𐴕𐴠 𐴊𐴞𐴦𐴁𐴡؟</char> <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴟𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴠 𐴊𐴞𐴦𐴁𐴡؟</char><verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />
    <char style="wj">”𐴇𐴡𐴕𐴡𐴤 𐴒𐴟𐴓𐴝𐴔𐴠 𐴊𐴟𐴘 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴀𐴝𐴦𐴌 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡; 𐴘𐴝𐴥𐴃𐴡 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴡𐴘 𐴄𐴞𐴥𐴑 𐴃𐴝𐴥𐴑𐴞𐴁𐴡 𐴀𐴝𐴦𐴌 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴑𐴧𐴟 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.“</char><verse eid="LUK 16:13" /></para>
  <para style="s1">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡</para>
  <para style="r">(<ref loc="MAT 11:12-13">𐴔𐴡𐴃𐴢 11‏:12‏-13</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴃𐴠𐴥𐴐𐴠𐴌𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴄𐴞𐴛𐴝𐴌 𐴓𐴝𐴓𐴡𐴥𐴏𐴁𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴑𐴟𐴥𐴖𐴝𐴓𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴎𐴝𐴕𐴠. 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴑𐴞𐴔𐴡𐴃𐴞 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴑𐴞𐴔𐴡𐴃𐴢 𐴕𐴝𐴥𐴘.</char><verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />
    <char style="wj">”𐴃𐴡𐴌𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴞𐴃𐴝𐴁𐴢, 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴏𐴡𐴙𐴓𐴧𐴞𐴥𐴓𐴢; 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴌, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴎𐴟𐴌𐴠𐴏𐴟𐴥𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.</char> <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴃𐴡𐴌𐴝𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴕𐴡𐴑𐴃𐴝𐴤 𐴁𐴟𐴥𐴎𐴞 𐴎𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴀𐴝𐴏𐴔𐴝𐴕 𐴎𐴡𐴁𐴞𐴕 𐴀𐴡𐴉𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴖𐴝 𐴀𐴝𐴌𐴡𐴤 𐴀𐴝𐴏𐴝𐴤𐴕.</char><verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />
    <char style="wj">”𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴎𐴝𐴔𐴝𐴙𐴌 𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠.</char><verse eid="LUK 16:18" /></para>
  <para style="s1">𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴏𐴝𐴥𐴌</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />
    <char style="wj">”𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴝𐴘𐴡𐴙𐴕𐴧𐴝 𐴌𐴡𐴚𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴔𐴞-𐴊𐴝𐴔𐴞 𐴇𐴡𐴦𐴌 𐴉𐴞𐴣𐴊𐴞𐴥𐴃𐴡, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴊𐴞𐴕 𐴀𐴝𐴘𐴝𐴐𐴞-𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴃𐴝𐴥𐴑𐴞𐴃𐴡.</char> <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴠𐴘𐴍𐴡𐴃𐴢 𐴓𐴝𐴏𐴝𐴥𐴌 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴇𐴡𐴥𐴌𐴝𐴃𐴢-𐴔𐴝𐴒𐴡𐴘𐴝𐴌𐴠 𐴌𐴝𐴑𐴝𐴤 𐴎𐴝𐴥𐴘𐴃𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴒𐴝𐴥𐴀𐴘𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.</char> <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴔𐴠𐴏𐴡𐴃𐴧𐴟 𐴉𐴡𐴌𐴞𐴎𐴝𐴘𐴃𐴡𐴥𐴘 𐴊𐴠 𐴈𐴝𐴥𐴕𐴝 𐴓𐴡𐴥𐴘 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴝𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴃𐴡𐴥. 𐴀𐴝𐴦𐴌 𐴑𐴟𐴣𐴙𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴀𐴘𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴝𐴥𐴀 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴠𐴑𐴞𐴥𐴃𐴡.</char><verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />
    <char style="wj">”𐴉𐴡𐴌𐴠 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴇𐴠𐴥 𐴒𐴡𐴌𐴞𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴀𐴝𐴦𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴡𐴥𐴘. 𐴀𐴠𐴑 𐴊𐴞𐴕 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴘𐴡𐴥 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴀𐴝𐴦𐴌 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.</char> <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" /><char style="wj">𐴀𐴞𐴥𐴃𐴠 𐴎𐴟𐴎𐴟𐴑𐴡𐴃𐴢 𐴀𐴝𐴎𐴝𐴁𐴢 𐴉𐴝𐴦𐴌 𐴊𐴠 𐴈𐴠𐴥𐴕𐴃𐴟 𐴖𐴡𐴌𐴔𐴞𐴑𐴧𐴝𐴥 𐴏𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴊𐴟𐴌𐴠𐴥 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴓𐴝𐴏𐴝𐴥𐴌𐴡𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥.</char> <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" /><char style="wj">𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴡𐴥 𐴁𐴝𐴉𐴢 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔, 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴞𐴥 𐴓𐴝𐴏𐴝𐴥𐴌𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴍𐴠 𐴊𐴞𐴉𐴠𐴍𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴀𐴡𐴦𐴣𐴓𐴡𐴌 𐴔𐴝𐴃𐴝𐴥 𐴁𐴟𐴌𐴝𐴘 𐴀𐴝𐴣𐴀𐴌 𐴎𐴞𐴌 𐴄𐴝𐴥𐴕𐴋𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴃𐴡𐴎𐴞𐴘𐴝 𐴉𐴝𐴙𐴌.‘</char><verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴡 𐴉𐴟𐴃𐴢, 𐴄𐴝𐴥𐴀𐴌 𐴒𐴡𐴌𐴞𐴥 𐴏𐴝𐴀, 𐴃𐴟𐴘 𐴃𐴡𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴒𐴡𐴔-𐴒𐴡𐴔 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴇𐴡𐴃𐴡𐴥 𐴐𐴟𐴥𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴞, 𐴀𐴝𐴦𐴌 𐴓𐴝𐴏𐴝𐴥𐴌𐴠 𐴇𐴡𐴃𐴡𐴥 𐴊𐴟𐴑 𐴉𐴝𐴀𐴙𐴓𐴢; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴠𐴍𐴠𐴥 𐴐𐴝𐴥𐴕𐴃𐴞 𐴉𐴝𐴦𐴌, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴘 𐴃𐴡𐴎𐴞𐴘𐴝 𐴉𐴡𐴀𐴌.</char> <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" /><char style="wj">𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴝𐴦𐴊𐴠, 𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴋𐴡𐴣𐴀𐴌 𐴊𐴟𐴔𐴁𐴟𐴌𐴟 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴠𐴕𐴃𐴟𐴥 𐴃𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠 𐴀𐴝𐴦𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴃𐴡𐴤 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴠.‘</char><verse eid="LUK 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴇𐴠𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴓𐴝𐴏𐴝𐴥𐴌𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴡𐴥;</char> <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴁𐴝𐴥𐴘 𐴀𐴝𐴏𐴠𐴤. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴡𐴑, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴀𐴠 𐴀𐴝𐴎𐴝𐴁𐴡𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴞𐴁𐴝𐴘.‘</char><verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴔𐴟𐴀𐴏𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴞𐴃𐴝𐴁𐴢 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴡𐴗𐴑.‘</char><verse eid="LUK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30" />
    <char style="wj">”𐴀𐴞𐴥𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴕𐴡, 𐴕𐴡, 𐴀𐴡𐴥 𐴁𐴝𐴉𐴢 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔, 𐴎𐴡𐴊𐴞 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴑𐴞𐴘𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴦, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.‘</char><verse eid="LUK 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴟𐴀𐴏𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴉𐴟𐴥𐴕𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘 𐴎𐴝𐴘𐴓𐴠𐴥 𐴘𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡 𐴔𐴝𐴕𐴞𐴁𐴡𐴥.‘ “ </char><verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s1">𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴝𐴁𐴝𐴌 𐴀𐴠𐴕𐴃𐴝𐴥𐴕</para>
  <para style="r">(<ref loc="MAT 18:6-7">𐴔𐴡𐴃𐴢 18‏:6‏-7</ref>‏,<ref loc="MAT 18:21-22">21‏-22</ref>; <ref loc="MRK 9:42">𐴔𐴝𐴑 9‏:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴟𐴎𐴟 𐴄𐴝𐴕𐴠 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴕𐴟 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴟𐴘𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢, 𐴎𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴕𐴞𐴑𐴞 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴘𐴧𐴠𐴤.</char> <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴡𐴓𐴝𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴐𐴞𐴥𐴓𐴡𐴌 𐴏𐴝𐴑𐴧𐴞 𐴁𐴝𐴣𐴊𐴞𐴥 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝, 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥𐴁𐴝.</char> <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" /><char style="wj">𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌. 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴧𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴡𐴥𐴄𐴁𐴡𐴍𐴝𐴥𐴘𐴧𐴡; 𐴎𐴡𐴊𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴡.</char><verse eid="LUK 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 17:4" />
    <char style="wj">”𐴎𐴡𐴊𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴠𐴑 𐴊𐴞𐴕𐴠 𐴇𐴝𐴥𐴣𐴃𐴢 𐴁𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴣𐴃𐴢 𐴀𐴡𐴥 𐴁𐴝𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀, ’𐴀𐴝𐴀𐴛 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥,‘ 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴡.“</char><verse eid="LUK 17:4" /></para>
  <para style="s1">𐴀𐴞𐴔𐴝𐴕</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴁𐴝𐴌𐴝𐴤𐴘𐴊𐴡.“<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />𐴔𐴝𐴓𐴞𐴑𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴥𐴌𐴡𐴙𐴌 𐴊𐴝𐴕𐴝𐴌 𐴇𐴠𐴥𐴃𐴧𐴞𐴌𐴞𐴕 𐴀𐴞𐴔𐴝𐴕 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴃𐴟𐴃𐴢-𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴉𐴝𐴌𐴞𐴁𐴝𐴥, ’𐴇𐴝𐴥𐴣𐴌𐴞 𐴎𐴝𐴘 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴉𐴟𐴥𐴄𐴒𐴡𐴘,‘ 𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴝𐴕𐴞𐴁𐴡𐴥.</char><verse eid="LUK 17:6" /></para>
  <para style="s1">𐴒𐴡𐴗𐴀𐴌𐴡𐴌 𐴎𐴞𐴔𐴧𐴝</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />
    <char style="wj">”𐴊𐴡𐴥𐴌𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴀𐴝𐴥𐴓𐴢 𐴏𐴡𐴘𐴁𐴡𐴥 𐴓𐴧𐴝 𐴘𐴝𐴥 𐴏𐴡𐴥𐴀𐴓𐴢 𐴏𐴡𐴌𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴡𐴗𐴀𐴌 𐴀𐴝𐴏𐴠𐴤. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴑𐴞𐴥 𐴒𐴡𐴗𐴀𐴌𐴒𐴗𐴝𐴥 𐴁𐴞𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴘𐴓𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴁𐴡𐴤, ’𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴘𐴢, 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴒𐴝𐴥𐴘؟‘</char> <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" /><char style="wj">𐴁𐴡𐴥𐴓𐴑𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴈𐴡𐴘𐴁𐴡𐴤 𐴕𐴠𐴥, ’𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴈𐴝𐴥𐴕𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴑𐴠𐴣𐴙𐴓𐴢 𐴁𐴝𐴣𐴊𐴞𐴥 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴈𐴝𐴥𐴕𐴝-𐴉𐴞𐴕𐴝 𐴈𐴝𐴥𐴘𐴧𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴥𐴌, 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴘 𐴈𐴝𐴥𐴕𐴝-𐴉𐴞𐴕𐴝 𐴇𐴝𐴥𐴘 𐴉𐴝𐴌𐴞𐴁𐴞𐴥‘؟</char> <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴑𐴞𐴥 𐴒𐴡𐴗𐴀𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. </char> <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥, 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴇𐴝𐴎𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢; 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴝𐴕𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴡𐴥𐴌𐴡𐴏𐴢 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠.‘ “</char><verse eid="LUK 17:10" /></para>
  <para style="s1">𐴊𐴡𐴐𐴢 𐴎𐴡𐴕 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴘𐴃𐴠 𐴏𐴝𐴔𐴝𐴥𐴌𐴞𐴘𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴔𐴝𐴎𐴡𐴃𐴧𐴟 𐴎𐴝𐴦𐴌. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴝𐴌𐴝𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴁𐴝𐴐𐴧𐴡𐴃𐴢, 𐴊𐴡𐴐𐴢 𐴎𐴡𐴕 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴊𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴌𐴠𐴥 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />𐴀𐴝𐴦𐴌 𐴒𐴟𐴎𐴡𐴌𐴝𐴕 𐴔𐴝𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴏𐴝𐴤, 𐴀𐴡𐴥 𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤!“<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴦, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴝𐴈𐴡𐴥𐴒𐴡𐴘.“</char> 𐴀𐴝𐴦𐴌 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="LUK 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴕𐴞𐴎𐴠 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴉𐴞𐴥𐴌𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴡𐴦𐴃𐴢 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴏𐴝𐴔𐴝𐴥𐴌𐴞.<verse eid="LUK 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴊𐴡𐴐𐴢 𐴎𐴡𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟ 𐴀𐴝𐴌 𐴕𐴡𐴖 𐴎𐴡𐴕 𐴇𐴡𐴍𐴠𐴥؟</char> <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" /><char style="wj">𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠 𐴁𐴞𐴊𐴠𐴐𐴡𐴥𐴙𐴃𐴧𐴝 𐴖𐴝 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴉𐴞𐴥𐴌𐴞 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴕𐴞𐴥𐴑𐴞؟“</char> <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴟𐴍𐴡𐴥, 𐴎𐴡𐴦𐴒𐴡𐴥𐴘; 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴞𐴔𐴝𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.“</char><verse eid="LUK 17:19" /></para>
  <para style="s1">𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴝𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="MAT 24:23-28">𐴔𐴡𐴃𐴢 24‏:23‏-28</ref>‏,<ref loc="MAT 24:37-41">37‏-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />𐴀𐴠𐴑𐴁𐴝𐴌, 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴘𐴁𐴡𐴤؟ 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴝𐴘𐴃𐴠𐴤 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴕𐴟 𐴀𐴝𐴘𐴁𐴡𐴤,</char> <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" /><char style="wj">𐴀𐴝𐴦𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴘𐴡𐴥 𐴕𐴡 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠 𐴑𐴞, ’𐴏𐴡𐴀, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴏𐴠𐴤,‘ 𐴘𐴝𐴥𐴃𐴡, ’𐴀𐴟𐴍𐴠𐴤 𐴀𐴝𐴏𐴠𐴤,‘ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴝𐴎𐴠𐴥 𐴀𐴝𐴏𐴠𐴤.“</char><verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴀𐴕 𐴊𐴞𐴕 𐴀𐴝𐴘𐴁𐴡𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴑 𐴊𐴞𐴕 𐴀𐴡𐴥𐴘𐴓𐴠 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴁𐴝.</char> <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" /><char style="wj">𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴠𐴍𐴠𐴥 𐴏𐴡𐴀,‘ 𐴘𐴝𐴥𐴃𐴡 ’𐴀𐴟𐴍𐴠𐴤 𐴏𐴡𐴀.‘ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴎𐴝𐴘𐴧𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴕𐴡 𐴊𐴡𐴥𐴙𐴅𐴧𐴡.</char> <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴠𐴑 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴞𐴅𐴞𐴓𐴞 𐴏𐴡𐴔𐴑𐴞𐴓𐴠𐴥 𐴀𐴝𐴌𐴀𐴠𐴑 𐴋𐴝𐴥𐴑𐴡𐴃𐴢 𐴀𐴡𐴥 𐴉𐴡𐴦𐴌 𐴎𐴝𐴦, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴒𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴊𐴟𐴑 𐴉𐴝𐴦 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴀𐴞𐴕𐴑𐴝𐴌 𐴇𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char><verse eid="LUK 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26" />
    <char style="wj">”𐴕𐴡𐴁𐴞 𐴕𐴟𐴌 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴀𐴙𐴓𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴡𐴥 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" /><char style="wj">𐴎𐴠𐴃𐴡𐴥 𐴊𐴞𐴕 𐴕𐴟 𐴑𐴞𐴐𐴄𐴞𐴃𐴢 𐴕𐴡𐴥 𐴀𐴟𐴍𐴠𐴤 𐴀𐴝𐴦𐴌 𐴃𐴟𐴖𐴝𐴥𐴕 𐴀𐴝𐴀𐴘𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴑 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴠𐴥𐴃𐴡𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢, 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴝𐴥𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴘𐴝𐴥 𐴊𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.</char><verse eid="LUK 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28" />
    <char style="wj">”𐴓𐴟𐴀𐴃𐴡𐴌 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴀𐴙𐴓𐴢; 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝𐴃𐴢, 𐴁𐴠𐴏𐴝 𐴑𐴞𐴕𐴝𐴃𐴢, 𐴑𐴠𐴥𐴃𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴥𐴌 𐴁𐴝𐴕𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢;</char> <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠 𐴊𐴞𐴕 𐴓𐴟𐴀𐴃𐴢 𐴏𐴡𐴥𐴊𐴡𐴔𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴡𐴦𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴥𐴕𐴋𐴡𐴑</char><note caller="+" style="f"><char style="fr" closed="false">17‏:29 </char><char style="ft" closed="false">𐴘𐴞𐴥𐴁𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴃𐴧𐴡𐴥𐴌, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴌𐴡𐴚 𐴀𐴡𐴥𐴓𐴡𐴙𐴊𐴧𐴝, 𐴀𐴞𐴚𐴒𐴞𐴌𐴝𐴎𐴞𐴃𐴢 ”𐴏𐴟𐴓𐴉𐴟𐴌“ 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀</char></note> <char style="wj">𐴎𐴡𐴥𐴌 𐴉𐴡𐴌𐴠 𐴉𐴝𐴥𐴕 𐴉𐴡𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.</char><verse eid="LUK 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30" />
    <char style="wj">”𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" /><char style="wj">𐴇𐴠𐴥 𐴊𐴞𐴕 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴊𐴡𐴌 𐴖𐴡𐴌𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴓𐴢-𐴏𐴝𐴥𐴔𐴝𐴕 𐴒𐴡𐴥𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴦𐴘𐴢 𐴁𐴡𐴓𐴧𐴝 𐴓𐴝𐴔𐴝𐴃𐴢 𐴕𐴡 𐴓𐴝𐴔𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴠𐴥𐴃𐴞𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴕𐴟 𐴀𐴝𐴀 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" /><char style="wj">𐴓𐴟𐴀𐴃𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴘𐴝𐴦𐴊𐴢 𐴌𐴝𐴙𐴑𐴧𐴡𐴥.</char> <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴏𐴝𐴘 𐴌𐴝𐴑𐴞𐴥𐴁𐴡.</char> <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴇𐴠𐴥 𐴌𐴝𐴙𐴃𐴧𐴝 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴠𐴑 𐴁𐴞𐴏𐴝𐴥𐴕𐴝𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴓𐴡𐴘𐴎𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" /><char style="wj">𐴊𐴟𐴖𐴝𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴀𐴠𐴑𐴧𐴟 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴏𐴝𐴑𐴧𐴞 𐴒𐴟𐴥𐴌𐴝𐴘𐴁𐴡 𐴊𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴓𐴡𐴘𐴎𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴌 𐴀𐴠𐴑𐴎𐴡𐴕𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" /><char style="wj">𐴊𐴟𐴘 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴞𐴓𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴓𐴡𐴘𐴎𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.“</char> <verse eid="LUK 17:36" /><verse number="37" style="v" sid="LUK 17:37" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴞𐴀𐴕 𐴇𐴡𐴍𐴠𐴥 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠𐴥؟“</para>
  <para style="p" vid="LUK 17:37">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴡𐴌𐴝 𐴓𐴝𐴐𐴢 𐴎𐴠𐴍𐴠𐴥, 𐴇𐴠𐴥𐴍𐴠 𐴃𐴡 𐴇𐴡𐴥𐴖𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.“</char><verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s1">𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴌𐴝𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴅𐴡𐴐𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴇𐴝𐴥𐴀𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴕𐴡 𐴇𐴝𐴥𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴐𐴞𐴥𐴑𐴝𐴘 𐴁𐴡𐴓𐴧𐴝. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, <char style="wj">”𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴡 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴉𐴡𐴌𐴁𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.</char> <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" /><char style="wj">𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴌𐴝𐴌𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢-𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴘𐴃𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴓𐴡𐴘𐴊𐴡.‘</char><verse eid="LUK 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4" />
    <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴡𐴦𐴊𐴧𐴞𐴕 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴊𐴠 𐴕𐴡 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴉𐴡𐴌𐴁𐴝 𐴒𐴡𐴌𐴞𐴥,</char> <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴠 𐴌𐴝𐴌𐴞 𐴖𐴝𐴘𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴓𐴡𐴘𐴊𐴞𐴘𐴟𐴔, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴝𐴌𐴁𐴝𐴥𐴌 𐴀𐴝𐴀𐴘𐴢-𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴡𐴥𐴌𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡.‘ “</char><verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴔𐴝𐴓𐴞𐴑𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴟𐴥𐴕𐴡, 𐴕𐴝𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴑𐴞𐴦 𐴈𐴡𐴘𐴧𐴠𐴥.</char> <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴓𐴡𐴘 𐴕𐴡 𐴊𐴞𐴁𐴡 𐴕𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴞𐴕𐴠 𐴌𐴝𐴘𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴈𐴝𐴣𐴊𐴠؟ 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴊𐴠𐴌𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴡؟</char> <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴓𐴡𐴘𐴊𐴞𐴁𐴡. 𐴓𐴠𐴑𐴞𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴞𐴔𐴝𐴕 𐴉𐴝𐴘𐴁𐴡؟“ </char><verse eid="LUK 18:8" /></para>
  <para style="s1">𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴝𐴥𐴀𐴌𐴠 𐴀𐴝𐴦𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴈𐴡𐴘𐴧𐴠𐴥, <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" /><char style="wj">”𐴊𐴟𐴘 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴒𐴞𐴦𐴘𐴠𐴥; 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝.</char> <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" /><char style="wj">𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴖𐴝𐴘𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, ’𐴘𐴝 𐴀𐴝𐴓𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴢, 𐴕𐴝𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌 𐴕𐴡; 𐴀𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴖𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡.</char> <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" /><char style="wj">𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴉𐴃𐴝𐴃𐴢 𐴊𐴟𐴘𐴁𐴝𐴌 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴞𐴥; 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴀𐴝𐴔𐴡𐴊𐴡𐴕𐴞𐴃𐴧𐴟 𐴊𐴡𐴐𐴢 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘.‘</char><verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴖𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴒𐴡𐴌𐴞 𐴊𐴟𐴌𐴠𐴥 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴔𐴡𐴕𐴐𐴝𐴥 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴟𐴑 𐴑𐴞𐴓𐴝𐴘-𐴑𐴞𐴓𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴘𐴝 𐴀𐴝𐴓𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤.‘ </char><verse eid="LUK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴁𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴞 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴖𐴝 𐴕𐴡𐴥 𐴄𐴡𐴥𐴀𐴌𐴠; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴥𐴖𐴝𐴓𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴑𐴟𐴥𐴖𐴝𐴓𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="LUK 18:14" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 19:13-15">𐴔𐴡𐴃𐴢 19‏:13‏-15</ref>; <ref loc="MRK 10:13-16">𐴔𐴝𐴑 10‏:13‏-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴘𐴡𐴥 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴕𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴟𐴥𐴖𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴡𐴥𐴄𐴁𐴡𐴍𐴝𐴥𐴘𐴧𐴠. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴃𐴡𐴤𐴊𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴡 𐴀𐴡𐴀𐴛𐴓𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴠𐴥𐴕𐴝 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴌𐴝 𐴉𐴟𐴖𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴒𐴡𐴥𐴓𐴞 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.“</char><verse eid="LUK 18:17" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢</para>
  <para style="r">(<ref loc="MAT 19:16-30">𐴔𐴡𐴃𐴢 19‏:16‏-30</ref>; <ref loc="MRK 10:17-31">𐴔𐴝𐴑 10‏:17‏-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />𐴉𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴒𐴡𐴔 𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴘𐴃𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴞𐴦 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥؟“<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴡𐴔 𐴑𐴞𐴘𐴝𐴥 𐴋𐴝𐴑𐴡𐴀𐴌؟ 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴊𐴠 𐴃𐴡 𐴀𐴝𐴌 𐴑𐴞𐴘𐴠𐴥 𐴒𐴡𐴔 𐴕𐴝𐴥𐴘.</char> <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" /><char style="wj">𐴃𐴟𐴀𐴛 𐴊𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴕𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴑𐴞, ’𐴎𐴠𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝; 𐴑𐴟𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝; 𐴏𐴟𐴌𐴞 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝; 𐴔𐴞𐴏𐴝𐴥 𐴒𐴡𐴁𐴝𐴤 𐴕𐴡 𐴊𐴞𐴁𐴝; 𐴁𐴝𐴉𐴔𐴝𐴦𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘ “</char><note caller="+" style="f"><char style="fr" closed="false">18‏:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12-16">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 20‏:12‏-16</ref></char>; <char style="xt"><ref loc="DEU 5:16-20">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 5‏:16‏-20</ref></char></char></note><verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴒𐴟𐴌𐴝𐴇𐴝𐴓𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴘𐴧𐴞𐴤𐴌.“<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴈𐴝𐴔 𐴁𐴝𐴑𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴠𐴏𐴞 𐴒𐴡𐴌𐴞𐴉𐴡𐴌𐴠 𐴁𐴝𐴍𐴞𐴊𐴡𐴒𐴡𐴥𐴘, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴊𐴡𐴥𐴕 𐴉𐴝𐴘𐴁𐴝; 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴡𐴥𐴘𐴧𐴡𐴒𐴝𐴘.“</char><verse eid="LUK 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 18:23" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴑𐴟𐴥𐴁𐴢 𐴁𐴠𐴎𐴝𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴋𐴡𐴣𐴀𐴌 𐴊𐴡𐴥𐴕𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴢 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴃𐴠 𐴇𐴡𐴃𐴡𐴥 𐴔𐴡𐴐𐴑𐴞𐴓𐴢!</char> <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴟𐴣𐴄𐴢 𐴉𐴟𐴥𐴣𐴐𐴡𐴌 𐴉𐴝𐴀𐴙𐴃𐴧𐴟 𐴒𐴡𐴓𐴞 𐴎𐴝𐴦 𐴀𐴝𐴌𐴡𐴤 𐴀𐴝𐴏𐴝𐴤𐴕.“ </char><verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴡𐴕𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟“<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴞𐴀𐴕 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴠 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴉𐴝𐴌𐴠.“ </char><verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠 𐴒𐴡𐴥𐴌𐴁𐴝𐴌𐴞 𐴀𐴠𐴌𐴞𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴞𐴒𐴡𐴘.“<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴒𐴡𐴥𐴌, 𐴁𐴡𐴖𐴢, 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕, 𐴁𐴝𐴉𐴔𐴝𐴦 𐴘𐴝𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴠𐴌𐴞𐴊𐴞𐴘𐴠𐴥,</char> <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴡𐴀𐴗𐴃𐴢 𐴒𐴟𐴕 𐴁𐴞𐴐𐴞𐴤 𐴉𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘𐴁𐴡.“</char><verse eid="LUK 18:30" /></para>
  <para style="s1">𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴘𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 20:17-19">𐴔𐴡𐴃𐴢 20‏:17‏-19</ref>; <ref loc="MRK 10:32-34">𐴔𐴝𐴑 10‏:32‏-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴞𐴕𐴝𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴡𐴀, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴖𐴡𐴌𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴙𐴌, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴇𐴠𐴥𐴍𐴠 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴡. </char> <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" /><char style="wj">𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴕𐴐𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴠𐴥𐴂𐴢 𐴔𐴝𐴌𐴞𐴁𐴡𐴥;</char> <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴐𐴡𐴀𐴣𐴑 𐴔𐴝𐴌𐴞 𐴁𐴝𐴦𐴊𐴠 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡. 𐴓𐴠𐴑𐴞𐴕 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴀𐴞𐴥𐴁𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“</char><verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴡𐴥 𐴕𐴡𐴥 𐴁𐴟𐴎𐴠𐴥; 𐴇𐴠𐴥 𐴈𐴡𐴃𐴝𐴤𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴓𐴟𐴑𐴝𐴘𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴞𐴀𐴕 𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴎𐴞𐴥 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠 𐴊𐴠.<verse eid="LUK 18:34" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴣𐴊𐴝𐴤 𐴇𐴡𐴥𐴌𐴝𐴃𐴢-𐴔𐴝𐴒𐴡𐴘𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 20:29-34">𐴔𐴡𐴃𐴢 20‏:29‏-34</ref>; <ref loc="MRK 10:46-52">𐴔𐴝𐴑 10‏:46‏-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />𐴀𐴞𐴏𐴝𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴅𐴠𐴌𐴞𐴑𐴡𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴣𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴌𐴝𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴇𐴡𐴥𐴌𐴝𐴃𐴢 𐴔𐴝𐴒𐴠𐴌 𐴊𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴞, 𐴀𐴠𐴍𐴠𐴥 𐴑𐴞𐴦 𐴀𐴡𐴥𐴌 𐴊𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴏𐴝𐴥𐴌𐴞 𐴀𐴠 𐴁𐴡𐴓𐴞 𐴎𐴝𐴦𐴌 𐴊𐴠.“<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤, 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤!“<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴒𐴠-𐴀𐴝𐴒𐴠 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴘 𐴕𐴞𐴎𐴝𐴥𐴔 𐴀𐴡𐴥𐴘𐴃𐴡 𐴈𐴡𐴘𐴧𐴠𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤!“<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴃𐴞𐴥𐴘𐴝𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴝𐴦𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴕𐴝𐴤 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" /><char style="wj">”𐴃𐴟𐴀𐴛 𐴑𐴞𐴦 𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴑𐴞𐴦 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟“</char></para>
  <para style="p" vid="LUK 18:41">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴉𐴝𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌.“<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴓𐴡𐴦; 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴞𐴔𐴝𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.“</char> <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />𐴀𐴠𐴥𐴇𐴡𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴉𐴝𐴘𐴧𐴠𐴥 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴎𐴝𐴑𐴠𐴥𐴘𐴡𐴏𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />𐴀𐴞𐴏𐴝𐴤 𐴅𐴠𐴌𐴞𐴑𐴡𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴑𐴠𐴥𐴘𐴡𐴏𐴢 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴇𐴡𐴕 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴝𐴘𐴃𐴡𐴥 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴏𐴝𐴀𐴘𐴢 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴒𐴝𐴦𐴉𐴞𐴍𐴠𐴥 𐴁𐴝𐴍𐴞𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴔𐴟𐴀𐴔𐴧𐴞𐴑𐴧𐴝 𐴊𐴟𐴣𐴌𐴞 𐴎𐴝𐴘 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴇𐴠𐴥 𐴉𐴡𐴣𐴃𐴢 𐴁𐴝𐴥𐴘 𐴎𐴝𐴘𐴁𐴡.<verse eid="LUK 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴖𐴡𐴌𐴔𐴞𐴑𐴧𐴝𐴥 𐴏𐴝𐴀𐴘𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴝𐴑𐴠𐴥𐴘𐴡𐴏𐴢, 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴓𐴝𐴔𐴡𐴒𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴙𐴅𐴧𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴝𐴌 𐴎𐴡𐴌𐴟𐴌.“</char> <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴓𐴝𐴙𐴔𐴧𐴠𐴥𐴒𐴝𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴠𐴏𐴃𐴠𐴑𐴁𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="LUK 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴐𐴠𐴥𐴑𐴝𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, ”𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌𐴡𐴌 𐴒𐴡𐴌𐴁𐴝 𐴀𐴡𐴥𐴘𐴃𐴡 𐴒𐴞𐴦𐴘𐴠𐴥.“<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />𐴎𐴝𐴑𐴠𐴥𐴘𐴡𐴏𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞𐴃𐴧𐴟 𐴀𐴠𐴑𐴊𐴡𐴥𐴑 𐴀𐴝𐴀𐴛 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴙𐴌, 𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴕𐴝 𐴇𐴡𐴥𐴑𐴧𐴡𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴏𐴝𐴙𐴌 𐴒𐴟𐴕 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴉𐴞𐴥𐴌𐴝𐴘𐴊𐴞𐴘𐴟𐴔.“<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴙𐴅𐴧𐴝 𐴀𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴕𐴠𐴅𐴝𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴒𐴧𐴗𐴝𐴥 𐴘𐴡𐴥 𐴃𐴡 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴉𐴟𐴖𐴝.</char> <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" /><char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴃𐴡 𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴟𐴖𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝.“</char><verse eid="LUK 19:10" /></para>
  <para style="s1">𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴐𐴟𐴥𐴕𐴝𐴌 𐴉𐴡𐴘𐴐𐴝𐴤𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 25:14-30">𐴔𐴡𐴃𐴢 25‏:14‏-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴥𐴕𐴠𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴄𐴝𐴥𐴀𐴙𐴅𐴧𐴞𐴓𐴢 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴥𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴡𐴥𐴊𐴧𐴡𐴌𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴟𐴌𐴡𐴥𐴌 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴁𐴡𐴕𐴞 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝. </char> <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" /><char style="wj">𐴎𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴊𐴡𐴐𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴐𐴟𐴥𐴕𐴝𐴌 𐴉𐴡𐴘𐴐𐴝𐴤</char><note caller="+" style="f"><char style="fr" closed="false">19‏:13 </char><char style="ft" closed="false">𐴉𐴡𐴘𐴐𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴌 𐴑𐴞𐴔𐴡𐴃𐴢 𐴃𐴞𐴕 𐴔𐴝𐴐𐴡𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴓𐴡𐴘 𐴁𐴡𐴌𐴝𐴁𐴡𐴌</char></note> <char style="wj">𐴊𐴞𐴦𐴘𐴠𐴥, 𐴊𐴞𐴦 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴞𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴀𐴕 𐴓𐴡𐴥𐴘 𐴐𐴡𐴥𐴊𐴡𐴌𐴞 𐴒𐴡𐴌𐴡𐴤𐴒𐴡𐴘.‘</char><verse eid="LUK 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴠𐴐𐴡𐴥𐴙𐴃𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴞𐴏𐴠𐴤 𐴕𐴡𐴔𐴝𐴙𐴕𐴊𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡 𐴏𐴝𐴀𐴘𐴢.‘</char><verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />
    <char style="wj">”𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴁𐴡𐴕𐴞 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴄𐴞𐴛𐴝 𐴊𐴞𐴀𐴓𐴢 𐴊𐴠 𐴒𐴡𐴗𐴀𐴌 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴃𐴝 𐴁𐴝𐴘𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴐𐴡𐴥𐴊𐴡𐴌𐴞 𐴒𐴡𐴌𐴞𐴥 𐴇𐴡𐴊𐴟𐴥𐴕 𐴈𐴝𐴔𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴠.</char><verse eid="LUK 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16" />
    <char style="wj">”𐴐𐴟𐴥𐴌𐴟𐴌 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴡𐴘𐴐𐴝𐴤 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌𐴡𐴤 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴉𐴡𐴘𐴐𐴝𐴤 𐴁𐴝𐴌𐴝𐴤𐴘𐴧𐴞.‘</char><verse eid="LUK 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17" />
    <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴐𐴝𐴁𐴝𐴥𐴐𐴢, 𐴒𐴡𐴔 𐴒𐴡𐴗𐴀𐴌! 𐴃𐴟𐴘 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴔𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴡𐴏𐴢, 𐴘𐴝𐴓𐴝 𐴃𐴟𐴘 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴥𐴌.‘</char><verse eid="LUK 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18" />
    <char style="wj">”𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴖𐴝𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴡𐴘𐴐𐴝𐴤 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌𐴡𐴤 𐴉𐴝𐴣𐴏𐴢 𐴏𐴝𐴥𐴕 𐴉𐴡𐴘𐴐𐴝𐴤 𐴁𐴝𐴌𐴝𐴤𐴘𐴧𐴞.‘</char><verse eid="LUK 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19" />
    <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴘𐴡𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴘 𐴘𐴡𐴥 𐴉𐴝𐴣𐴏𐴢 𐴏𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴥𐴌.‘</char><verse eid="LUK 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20" />
    <char style="wj">”𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴀𐴡𐴥𐴃𐴞𐴘𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴡𐴘𐴐𐴝𐴤, 𐴀𐴝𐴀𐴛 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴝𐴑𐴞𐴥𐴃𐴢 𐴁𐴠𐴌𐴝𐴤𐴘 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴝𐴔;</char> <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴞𐴥, 𐴃𐴟𐴀𐴛 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴈𐴡𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢; 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴕𐴞𐴎𐴠 𐴎𐴞𐴀𐴕 𐴕𐴡𐴥 𐴌𐴝𐴑𐴡𐴥 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴡, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴕𐴡𐴥 𐴓𐴝𐴒𐴡 𐴇𐴞𐴥𐴀𐴕 𐴈𐴝𐴍𐴡.‘</char><verse eid="LUK 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22" />
    <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴡𐴥 𐴁𐴠𐴇𐴝𐴌 𐴒𐴡𐴗𐴀𐴌! 𐴃𐴡𐴌 𐴔𐴟𐴑𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴘 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔. 𐴃𐴟𐴘 𐴊𐴠 𐴎𐴝𐴙𐴕𐴃𐴞 𐴀𐴝𐴀𐴛 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴈𐴡𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴎𐴞𐴀𐴕 𐴕𐴡𐴥 𐴌𐴝𐴑𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴕𐴡𐴥 𐴓𐴝𐴒𐴝𐴘 𐴇𐴞𐴥𐴀𐴕 𐴈𐴝𐴍𐴞.</char> <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" /><char style="wj">𐴃𐴡𐴥𐴘 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌 𐴄𐴞𐴛𐴝 𐴒𐴝𐴥𐴕 𐴁𐴠𐴚𐴒𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴘𐴓𐴠 𐴑𐴞𐴘𐴝𐴥 𐴕𐴡𐴥 𐴌𐴝𐴑𐴡𐴥𐴏؟ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴃𐴧𐴞𐴥 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴀𐴛 𐴀𐴝𐴘𐴓𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴠𐴏𐴧𐴟𐴥 𐴐𐴟𐴥𐴄𐴢 𐴉𐴝𐴘𐴃𐴝𐴔.‘</char><verse eid="LUK 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24" />
    <char style="wj">”𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴇𐴝𐴥𐴎𐴞𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴞𐴃𐴝𐴃𐴧𐴟 𐴉𐴡𐴘𐴐𐴝𐴤 𐴒𐴝𐴥𐴕 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘, 𐴎𐴝𐴃𐴧𐴟 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴉𐴡𐴘𐴐𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴡.‘ </char><verse eid="LUK 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25" />
    <char style="wj">”𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴊𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴉𐴡𐴘𐴐𐴝𐴤 𐴀𐴝𐴏𐴠𐴤.‘</char><verse eid="LUK 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26" />
    <char style="wj">”’𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴝𐴃𐴧𐴟 𐴕𐴝𐴥𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴑𐴞 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴕𐴡 𐴏𐴝𐴘𐴃𐴡𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴀𐴝𐴕𐴞𐴤 𐴀𐴝𐴣𐴀𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴡.‘ “ </char><verse eid="LUK 19:27" /></para>
  <para style="s1">𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴒𐴡𐴥𐴙𐴓𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 21:1-11">𐴔𐴡𐴃𐴢 21‏:1‏-11</ref>; <ref loc="MRK 11:1-11">𐴔𐴝𐴑 11‏:1‏-11</ref>; <ref loc="JHN 12:12-19">𐴘𐴡 12‏:12‏-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴒𐴠-𐴀𐴝𐴒𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴀𐴟𐴎𐴟 𐴎𐴝𐴦𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴠𐴃𐴉𐴠𐴥𐴒𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝 𐴉𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴝𐴥𐴇𐴝𐴣𐴏𐴞 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴡𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴟𐴀𐴔𐴡𐴌 𐴉𐴝𐴌𐴝 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴦, 𐴇𐴠𐴥𐴍𐴠 𐴒𐴡𐴥𐴓𐴞 𐴔𐴡𐴃𐴧𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴝𐴊𐴝𐴤𐴌 𐴏𐴡𐴥𐴀 𐴁𐴝𐴙𐴕𐴊𐴝𐴤 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴁𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡𐴥 𐴏𐴡𐴌𐴠𐴤. 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴓𐴞 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴕𐴡𐴤𐴒𐴡𐴘. </char> <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" /><char style="wj">𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴑𐴟𐴥𐴓𐴡𐴌؟‘ 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑𐴡𐴃𐴧𐴟 𐴘𐴞𐴁𐴝𐴤𐴌𐴠 𐴓𐴝𐴒𐴠𐴌.‘ “</char><verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />𐴃𐴡𐴥𐴘 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴡𐴖𐴝𐴕𐴝 𐴓𐴡𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠𐴀𐴕 𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴠𐴥𐴀𐴕 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴝𐴊𐴝𐴤𐴌 𐴏𐴡𐴥𐴀 𐴖𐴝𐴌𐴠 𐴑𐴟𐴥𐴓𐴠𐴌 𐴌𐴝𐴥𐴌, 𐴘𐴞𐴥𐴁𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴝𐴊𐴝𐴤𐴌 𐴏𐴡𐴥𐴀 𐴖𐴝𐴌𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴑𐴟𐴥𐴓𐴡𐴌؟“<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑𐴡𐴃𐴧𐴟 𐴘𐴞𐴁𐴝𐴤𐴌𐴠 𐴓𐴝𐴒𐴠𐴌.“<verse eid="LUK 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴡𐴦𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴞𐴐𐴝𐴥𐴘𐴊𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴖𐴡𐴌𐴠 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴝𐴘𐴧𐴠. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />𐴀𐴞𐴥𐴁𐴝 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴦𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴌𐴝𐴏𐴃𐴝𐴃𐴢 𐴁𐴞𐴐𐴝𐴥𐴘𐴊𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴀𐴞𐴥𐴁𐴝 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌𐴡𐴌 𐴓𐴝𐴔𐴡𐴕𐴞𐴌 𐴇𐴝𐴣𐴏𐴝𐴥𐴇𐴝𐴣𐴏𐴞 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴡𐴓𐴢 𐴄𐴞𐴥𐴘𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠,<verse eid="LUK 19:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38" />𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.</para>
  <para style="q1" vid="LUK 19:38">𐴀𐴠𐴁𐴧𐴠 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴡𐴥𐴗𐴑, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴥𐴑!“<note caller="+" style="f"><char style="fr" closed="false">19‏:38 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:26">𐴎𐴡𐴁𐴟𐴌 118‏:26</ref></char></char></note><verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />𐴊𐴡𐴓𐴡𐴃𐴧𐴟 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴁𐴡𐴥𐴄𐴁𐴡𐴍𐴡.“<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴡𐴊𐴞 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴝𐴥𐴔 𐴀𐴡𐴥𐴘 𐴃𐴝𐴥𐴑𐴠, 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴟𐴍𐴞𐴤𐴁𐴡!“</char><verse eid="LUK 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴇𐴝𐴣𐴏𐴝𐴥𐴇𐴝𐴣𐴏𐴞 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕 𐴊𐴠𐴑𐴞𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴇𐴝𐴙𐴕𐴊𐴠𐴤, <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴤, 𐴃𐴟𐴘 𐴘𐴡𐴥 𐴀𐴝𐴙𐴅𐴧𐴝 𐴎𐴡𐴊𐴞 𐴐𐴝𐴥𐴕𐴃𐴞 𐴑𐴞𐴘𐴠𐴥 𐴀𐴝𐴕𐴠𐴤 𐴊𐴠 𐴎𐴝𐴙𐴕𐴃𐴞𐴘𐴝! 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡𐴌 𐴏𐴟𐴑𐴡𐴌 𐴀𐴝𐴌𐴒𐴗𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.</char> <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴀𐴕 𐴊𐴞𐴕 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴃𐴡𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴋𐴠𐴁𐴝𐴓𐴢 𐴃𐴟𐴓𐴞𐴤 𐴃𐴡𐴌𐴠𐴥 𐴒𐴞𐴥𐴌𐴞𐴊𐴡𐴌𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴡𐴌𐴠𐴥 𐴇𐴝𐴥𐴀𐴌 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴒𐴠𐴥𐴌𐴒𐴗𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡,</char> <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" /><char style="wj">𐴃𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴔𐴠𐴍𐴞𐴃𐴢 𐴀𐴝𐴣𐴏𐴝𐴥𐴌𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴕𐴡 𐴌𐴝𐴑𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴘 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡𐴌𐴠𐴥 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥 𐴕𐴡𐴥 𐴏𐴞𐴕𐴡𐴥𐴏𐴢.“</char><verse eid="LUK 19:44" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 21:12-17">𐴔𐴡𐴃𐴢 21‏:12‏-17</ref>; <ref loc="MRK 11:15-19">𐴔𐴝𐴑 11‏:15‏-19</ref>; <ref loc="JHN 2:13-22">𐴘𐴡 2‏:13‏-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥𐴍𐴠 𐴁𐴠𐴏𐴝 𐴑𐴞𐴕𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴓𐴡𐴌𐴝𐴘𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠; <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ’𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴥𐴌 𐴔𐴟𐴕𐴝𐴎𐴝𐴃𐴡𐴌 𐴒𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡,‘</char><note caller="+" style="f"><char style="fr" closed="false">19‏:46 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 56:7">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 56‏:7</ref></char></char></note> <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴡𐴌 𐴀𐴝𐴋𐴧𐴝-𐴈𐴝𐴥𐴕𐴝 𐴁𐴝𐴕𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴡.“</char><note caller="+" style="f"><char style="fr" closed="false">19‏:46 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 7:11">𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝 7‏:11</ref></char></char></note><verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴉𐴡𐴃𐴧𐴞𐴥 𐴊𐴞𐴕 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴃𐴡. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠, 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴝𐴘𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />𐴓𐴠𐴑𐴞𐴕 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤 𐴔𐴡𐴑𐴝 𐴕𐴡𐴥 𐴉𐴝𐴦, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴀𐴣𐴓𐴒𐴡𐴌𐴞 𐴉𐴟𐴥𐴕𐴞𐴃𐴡.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 21:23-27">𐴔𐴡𐴃𐴢 21‏:23‏-27</ref>; <ref loc="MRK 11:27-33">𐴔𐴝𐴑 11‏:27‏-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴠𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴏𐴝𐴘, 𐴃𐴟𐴀𐴛 𐴈𐴝𐴔 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴠 𐴒𐴡𐴌𐴡𐴤𐴌؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕؟“<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔. 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴏𐴝𐴘,</char> <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" /><char style="wj">𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴉𐴝𐴀𐴙𐴓𐴢 𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴀𐴡𐴃𐴧𐴟؟“</char><verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴁𐴞𐴘𐴝𐴏𐴝𐴕𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴈𐴡𐴀𐴘𐴢 ’𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴡𐴃𐴧𐴟,‘ 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴑𐴞𐴘𐴝𐴥 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤؟‘ <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴈𐴡𐴀𐴘𐴢, ’𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴀𐴡𐴃𐴧𐴟,‘ 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴐𐴞𐴥𐴓𐴡𐴌 𐴊𐴡𐴓𐴝 𐴔𐴝𐴌𐴞𐴁𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴕𐴡𐴁𐴞 𐴊𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥.“<verse eid="LUK 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴞 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴕𐴃𐴟𐴤.“<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴀𐴝𐴀𐴛 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴠 𐴒𐴡𐴌𐴞𐴥𐴌.“</char><verse eid="LUK 20:8" /></para>
  <para style="s1">𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴐𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 21:33-46">𐴔𐴡𐴃𐴢 21‏:33‏-46</ref>; <ref loc="MRK 12:1-12">𐴔𐴝𐴑 12‏:1‏-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴈𐴡𐴖𐴝𐴤 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <char style="wj">”𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝 𐴓𐴝𐴒𐴝𐴘𐴧𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴐𐴝𐴐𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴄𐴠𐴥𐴑𐴝 𐴊𐴞𐴥 𐴓𐴝𐴔𐴁𐴝 𐴄𐴝𐴙𐴔𐴡𐴓𐴧𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴡𐴥𐴘.</char> <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴀𐴝𐴙𐴕𐴊𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴡𐴗𐴀𐴌𐴡𐴌𐴠 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴒𐴟𐴓𐴝𐴌 𐴁𐴝𐴥𐴑 𐴊𐴠𐴦; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴠 𐴃𐴝𐴌𐴠𐴥 𐴔𐴝𐴌𐴝-𐴊𐴡𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴇𐴝𐴥𐴓𐴞 𐴀𐴝𐴥𐴃𐴠 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞𐴘𐴠𐴥.</char> <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴡𐴗𐴀𐴌 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴌𐴠𐴥 𐴘𐴡𐴥 𐴔𐴝𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴞𐴤 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴞𐴥 𐴇𐴝𐴥𐴓𐴞 𐴀𐴝𐴥𐴃𐴠 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞𐴘𐴠𐴥.</char> <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" /><char style="wj">𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴒𐴡𐴗𐴀𐴌 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴌𐴠𐴥 𐴘𐴡𐴥 𐴎𐴡𐴈𐴡𐴥𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴀𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴠.</char><verse eid="LUK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13" />
    <char style="wj">”𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴛 𐴑𐴞𐴦 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟ 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴖𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴟𐴔; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴉𐴝𐴌𐴠.‘</char><verse eid="LUK 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴠 𐴇𐴠𐴥 𐴉𐴟𐴖𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴁𐴞𐴘𐴝𐴏𐴝𐴕𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ’𐴀𐴞𐴃𐴠 𐴃𐴡 𐴔𐴞𐴌𐴝𐴏𐴊𐴝𐴥𐴌; 𐴀𐴝𐴘𐴧𐴡𐴤 𐴀𐴞𐴃𐴝𐴌𐴠𐴤 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴔𐴞𐴌𐴝𐴏𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.‘</char> <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" /><char style="wj">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴁𐴝𐴀𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.</char></para>
  <para style="p" vid="LUK 20:15">
    <char style="wj">”𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴑𐴞𐴦 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌؟</char> <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴇𐴠𐴥 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴌𐴞𐴎𐴝 𐴒𐴝𐴥𐴕 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡.“</char></para>
  <para style="p" vid="LUK 20:16">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴒𐴡𐴌𐴡𐴥𐴗𐴑.“<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤𐴌 𐴔𐴝𐴀𐴕𐴞 𐴑𐴞𐴦,</char></para>
  <para style="q1" vid="LUK 20:17">
    <char style="wj">’𐴎𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴔𐴞𐴏𐴃𐴞𐴥𐴌𐴞𐴘𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠,</char></para>
  <para style="q2" vid="LUK 20:17">
    <char style="wj">𐴘𐴞𐴥𐴁𐴝 𐴐𐴞𐴥𐴓𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴌𐴟𐴌𐴞 𐴖𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">20‏:17 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 118:22">𐴎𐴡𐴁𐴟𐴌 118‏:22</ref>
        </char> </char>
    </note>
    <char style="wj">؟ </char><verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />
    <char style="wj">𐴎𐴠 𐴑𐴞𐴘𐴠𐴥 𐴇𐴠𐴥 𐴐𐴞𐴥𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴀𐴞𐴥𐴃𐴠 𐴁𐴝𐴥𐴚𐴒𐴞 𐴇𐴝𐴥𐴕-𐴇𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴝𐴌 𐴖𐴡𐴌𐴠 𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴐𐴞𐴥𐴓𐴢 𐴘𐴞𐴥𐴁𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴉𐴞𐴐𐴞𐴥 𐴎𐴝𐴘𐴁𐴡𐴘.“</char><verse eid="LUK 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴎𐴞𐴥𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴑𐴞 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴖𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴃𐴡𐴥.<verse eid="LUK 20:19" /></para>
  <para style="s1">𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴊𐴞𐴦𐴘𐴝</para>
  <para style="r">(<ref loc="MAT 22:15-22">𐴔𐴡𐴃𐴢 22‏:15‏-22</ref>; <ref loc="MRK 12:13-17">𐴔𐴝𐴑 12‏:13‏-17</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴈𐴝𐴥𐴀𐴏𐴢 𐴕𐴡𐴎𐴡𐴌 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴒𐴡𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴁𐴠𐴥𐴃𐴢 𐴊𐴡𐴥𐴌𐴝𐴘 𐴒𐴟𐴌𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴈𐴡𐴃𐴝𐴤𐴌 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴝𐴥𐴑𐴞𐴔𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞 𐴉𐴝𐴌𐴠. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />𐴒𐴟𐴌𐴞𐴕𐴊𐴝 𐴒𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴏𐴡𐴥𐴘𐴧𐴞, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴏𐴃𐴝𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴡. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝<note caller="+" style="f"><char style="fr" closed="false">20‏:22 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑𐴡𐴃𐴢 𐴑𐴝𐴥𐴘𐴏𐴝𐴌 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴝𐴔 𐴕𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴡𐴑𐴡𐴥𐴁𐴢. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠.</char></note>𐴌𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴊𐴡𐴦𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴎𐴝𐴘𐴠𐴏𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴕𐴝𐴥𐴘؟“<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴌𐴝𐴥𐴌 𐴏𐴝𐴙𐴓𐴡𐴌𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" /><char style="wj">”𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴞𐴕𐴝𐴥𐴌 𐴊𐴝𐴈𐴡𐴥. 𐴘𐴝𐴀𐴕 𐴇𐴝𐴌 𐴏𐴡𐴥𐴁𐴞 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴌 𐴕𐴝𐴔؟“</char></para>
  <para style="p" vid="LUK 20:24">𐴃𐴝𐴌𐴝𐴥 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌.“<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴎𐴞𐴀𐴕 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴡, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴡.“</char><verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />𐴃𐴝𐴌𐴝𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴈𐴡𐴃𐴝𐴤𐴌 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴟𐴖𐴝𐴁𐴠 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘 𐴕𐴞𐴎𐴝𐴥𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="LUK 20:26" /></para>
  <para style="s1">𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 22:23-33">𐴔𐴡𐴃𐴢 22‏:23‏-33</ref>; <ref loc="MRK 12:18-27">𐴔𐴝𐴑 12‏:18‏-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴝𐴥𐴣𐴐𐴡𐴌 𐴕𐴝𐴥𐴘 𐴇𐴡𐴘 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴁𐴝𐴥𐴘 𐴉𐴟𐴀𐴝𐴙𐴕 𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴌𐴞𐴎𐴝𐴒𐴡𐴥𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴇𐴠𐴥 𐴁𐴝𐴥𐴘𐴡𐴃𐴧𐴟 𐴁𐴡𐴖𐴢 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴓𐴧𐴝 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />𐴊𐴡𐴥𐴌𐴡, 𐴇𐴝𐴥𐴣𐴃𐴢 𐴎𐴡𐴕 𐴁𐴝𐴥𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴉𐴡𐴀𐴘𐴓𐴝 𐴖𐴝𐴘𐴠 𐴁𐴡𐴖𐴢 𐴓𐴡𐴦𐴘𐴢, 𐴉𐴟𐴀𐴝𐴙𐴕 𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴖𐴝𐴘𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘; <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴖𐴝𐴘𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴣𐴃𐴡 𐴁𐴝𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢, 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴘𐴡𐴥 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴇𐴝𐴓𐴠 𐴇𐴞𐴥𐴁𐴝 𐴇𐴝𐴌 𐴁𐴡𐴖𐴢 𐴀𐴡𐴥𐴘𐴁𐴡؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴡 𐴇𐴝𐴥𐴣𐴃𐴡 𐴎𐴡𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴁𐴝𐴕𐴝𐴀𐴙𐴓𐴢.“<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, <char style="wj">”𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴁𐴞𐴘𐴝𐴥-𐴐𐴝𐴥𐴊𐴞 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴘𐴝𐴥-𐴐𐴝𐴥𐴊𐴞 𐴊𐴠.</char> <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴣𐴐𐴡𐴌-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴁𐴡𐴓𐴞 𐴒𐴡𐴕𐴝 𐴎𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴊𐴞𐴥𐴘𐴝 𐴎𐴝𐴘𐴁𐴡;</char> <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌 𐴔𐴡𐴌𐴞 𐴘𐴡𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.</char> <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" /><char style="wj">𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴎𐴝𐴥𐴋𐴧𐴗𐴝𐴌 𐴎𐴞𐴑𐴞𐴥𐴌 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴁𐴟𐴊𐴡𐴌𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑𐴡𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴀𐴝𐴓𐴧𐴝 𐴋𐴝𐴙𐴑𐴧𐴠𐴥.</char><note caller="+" style="f"><char style="fr" closed="false">20‏:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 3‏:6</ref></char></char></note> <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝 𐴃𐴡 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴥𐴕𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴎𐴞𐴕𐴊𐴝.“</char><verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴡𐴊𐴟𐴥𐴕 𐴀𐴝𐴓𐴠𐴔𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴃𐴟𐴀𐴛 𐴒𐴡𐴔 𐴈𐴡𐴘𐴧𐴡𐴥.“ <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴠 𐴕𐴡𐴥 𐴊𐴠.<verse eid="LUK 20:40" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 22:41-46">𐴔𐴡𐴃𐴢 22‏:41‏-46</ref>; <ref loc="MRK 12:35-37">𐴔𐴝𐴑 12‏:35‏-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">” 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴀؟</char> <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴝𐴖𐴟𐴊𐴢 𐴕𐴞𐴎𐴠 𐴃𐴡 𐴎𐴡𐴁𐴟𐴌 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥,</char></para>
  <para style="q1" vid="LUK 20:42">
    <char style="wj">’𐴔𐴝𐴁𐴟𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠,</char></para>
  <para style="q2" vid="LUK 20:42">
    <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴡𐴘𐴧𐴡𐴥,</char><verse eid="LUK 20:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43" />
    <char style="wj">𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠</char></para>
  <para style="q2" vid="LUK 20:43">
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴡𐴦𐴌 𐴃𐴡𐴓𐴠 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴠𐴓𐴝𐴘.“ ‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">20‏:43 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 110:1">𐴎𐴡𐴁𐴟𐴌 110‏:1</ref>
        </char>
      </char>
    </note><verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />
    <char style="wj">𐴊𐴝𐴖𐴟𐴊𐴠 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 ’𐴔𐴝𐴓𐴞𐴑‘ 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠𐴥؟“</char><verse eid="LUK 20:44" /></para>
  <para style="s1">𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴑𐴞𐴁𐴝𐴌 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢</para>
  <para style="r">(<ref loc="MAT 23:1-36">𐴔𐴡𐴃𐴢 23‏:1‏-36</ref>; <ref loc="MRK 12:38-40">𐴔𐴝𐴑 12‏:38‏-40</ref>; <ref loc="LUK 11:37-54">𐴓𐴟𐴑 11‏:37‏-54</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴉𐴟𐴥𐴕𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" /><char style="wj">”𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴓𐴝𐴔𐴁𐴝-𐴓𐴝𐴔𐴁𐴝 𐴑𐴟𐴌𐴟𐴃𐴝 𐴉𐴞𐴣𐴊𐴞𐴥 𐴒𐴟𐴥𐴌𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴝𐴀, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴎𐴝𐴌𐴠-𐴁𐴝𐴎𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴉𐴝𐴘𐴃𐴡, 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴃𐴡𐴑𐴧𐴝𐴌 𐴇𐴝𐴊𐴞𐴌𐴝𐴤𐴃𐴢 𐴁𐴡𐴘𐴃𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴔𐴠𐴓𐴝-𐴐𐴡𐴥𐴁𐴝𐴃𐴢 𐴁𐴝𐴌𐴞𐴥𐴑 𐴎𐴝𐴒𐴝𐴃𐴢 𐴁𐴡𐴘𐴃𐴡𐴥 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" /><char style="wj">𐴀𐴠𐴑 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴡𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴟𐴄𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠, 𐴀𐴝𐴌𐴀𐴠𐴑 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝 𐴓𐴝𐴔𐴁𐴝-𐴓𐴝𐴔𐴁𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴞𐴥𐴀𐴕𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴣𐴀𐴌 𐴉𐴝𐴘𐴁𐴡.“</char><verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s1">𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴌𐴝𐴌𐴞𐴌 𐴏𐴡𐴥𐴃𐴑𐴝</para>
  <para style="r">(<ref loc="MRK 12:41-44">𐴔𐴝𐴑 12‏:41‏-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴏𐴟𐴑 𐴃𐴟𐴓𐴞𐴤 𐴏𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴡𐴥𐴃𐴑𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴊𐴝𐴕-𐴁𐴝𐴐𐴧𐴟𐴤𐴃𐴢 𐴊𐴠𐴦𐴌. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴡𐴌𐴞𐴉𐴢 𐴌𐴝𐴌𐴞𐴘𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥𐴍𐴠 𐴊𐴟𐴘𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴣𐴍𐴡 𐴉𐴡𐴘𐴐𐴝𐴤 𐴊𐴠𐴦𐴌 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠 𐴒𐴡𐴌𐴞𐴉𐴢 𐴌𐴝𐴌𐴞 𐴖𐴝𐴘𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴊𐴞𐴦𐴘𐴠𐴥;</char> <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴄𐴝𐴓𐴞𐴑𐴧𐴝 𐴊𐴡𐴥𐴕𐴡𐴃𐴧𐴟 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴌𐴞𐴉𐴢 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞 𐴁𐴡𐴓𐴧𐴝 𐴎𐴞𐴀𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.“</char><verse eid="LUK 21:4" /></para>
  <para style="s1">𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴖𐴝𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 24:1-2">𐴔𐴡𐴃𐴢 24‏:1‏-2</ref>; <ref loc="MRK 13:1-2">𐴔𐴝𐴑 13‏:1‏-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴖𐴝𐴤𐴇𐴡𐴘 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴑𐴠𐴀𐴕 𐴐𐴟𐴥𐴕𐴊𐴡𐴌-𐴐𐴟𐴥𐴕𐴊𐴡𐴌 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴓𐴡𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴝 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴇𐴝𐴥𐴣𐴎𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" /><char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴍𐴠𐴥 𐴎𐴞𐴀𐴕 𐴊𐴠𐴑𐴡𐴥𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴀𐴕 𐴊𐴞𐴕 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴠𐴍𐴠𐴥 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴇𐴞𐴥𐴀𐴕 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="LUK 21:6" /></para>
  <para style="s1">𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴀𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 24:3-14">𐴔𐴡𐴃𐴢 24‏:3‏-14</ref>; <ref loc="MRK 13:3-13">𐴔𐴝𐴑 13‏:3‏-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴇𐴞𐴥𐴀𐴕 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠𐴥؟ 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴡؟“<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴏𐴝𐴘𐴧𐴡𐴥, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴎𐴠𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴕𐴡 𐴓𐴡𐴘𐴎𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝,‘ 𐴀𐴠𐴊𐴧𐴠 ’𐴀𐴡𐴑𐴃𐴡𐴥 𐴋𐴝𐴥𐴑𐴠.‘ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴕𐴡 𐴊𐴡𐴥𐴙𐴅𐴧𐴡.</char> <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴝𐴌𐴝𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴀𐴟𐴥𐴌𐴟𐴏𐴧𐴟𐴓𐴡𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴥𐴕𐴞𐴁𐴝, 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴒𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴖𐴝𐴌 𐴎𐴡𐴌𐴟𐴌. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴘𐴡𐴥 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴕𐴡.“</char><verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴑 𐴑𐴡𐴗𐴔𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴑𐴡𐴗𐴔𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑 𐴌𐴝𐴙𐴅𐴧𐴡𐴘𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴃𐴞𐴥𐴘𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" /><char style="wj">𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴎𐴝𐴒𐴝-𐴎𐴝𐴒𐴝 𐴌𐴝𐴄𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴁𐴝𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥𐴘𐴁𐴡; 𐴀𐴝𐴌𐴡𐴤, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴇𐴡𐴥𐴃𐴝𐴌𐴝 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="LUK 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠, 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴞𐴥𐴁𐴡. 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴑𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴇𐴝𐴥𐴎𐴞𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴑𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴊𐴞𐴓𐴡𐴃𐴢 𐴒𐴝𐴣𐴃𐴞𐴥 𐴌𐴝𐴑𐴡𐴥 𐴊𐴠 𐴑𐴞, 𐴑𐴞𐴦 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴁𐴝 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴏𐴞𐴕𐴃𐴝 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌 𐴕𐴝𐴥𐴘;</char> <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴎𐴡𐴁𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴒𐴞𐴘𐴝𐴕 𐴊𐴞𐴦𐴘𐴟𐴔, 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴊𐴟𐴐𐴧𐴡𐴕𐴠 𐴔𐴟𐴑𐴝𐴁𐴠𐴓𐴝 𐴘𐴝𐴥 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴔𐴝𐴦 𐴘𐴠, 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴠, 𐴀𐴠𐴒𐴝𐴕𐴝-𐴒𐴟𐴙𐴐𐴧𐴞𐴥𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡 𐴘𐴡𐴥.</char> <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char> <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴓𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴡𐴁𐴡𐴥𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴁𐴝𐴏𐴝𐴘 𐴌𐴝𐴑𐴞𐴥𐴁𐴝.</char><verse eid="LUK 21:19" /></para>
  <para style="s1">𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="r">(<ref loc="MAT 24:15-21">𐴔𐴡𐴃𐴢 24‏:15‏-21</ref>; <ref loc="MRK 13:14-19">𐴔𐴝𐴑 13‏:14‏-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌𐴠 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴁𐴠𐴌𐴝𐴤𐴘 𐴊𐴡𐴥𐴙𐴅𐴧𐴠 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴄𐴝𐴥𐴀𐴌𐴞𐴘𐴡 𐴊𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴡𐴐𐴡𐴥𐴃𐴞 𐴏𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴋𐴝𐴥𐴑𐴠.</char> <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴊𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴞𐴎𐴝𐴒𐴡𐴥𐴘 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴝𐴌𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴥𐴓𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴞𐴕 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴡𐴊𐴡𐴓𐴝 𐴓𐴡𐴘𐴁𐴝𐴌 𐴊𐴞𐴕، 𐴎𐴠𐴀𐴕𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥.</char> <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴇𐴝𐴥𐴔𐴞𐴓𐴢 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴊𐴡𐴌 𐴔𐴝𐴦 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴀𐴝𐴘𐴁𐴡𐴤.</char> <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴓𐴡𐴘 𐴑𐴡𐴃𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴣𐴊𐴞𐴥 𐴉𐴡𐴃𐴧𐴞𐴥 𐴑𐴡𐴗𐴔𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴡𐴘𐴎𐴝 𐴎𐴝𐴘𐴁𐴡. 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌𐴠 𐴀𐴡𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴄𐴠𐴥𐴚𐴠 𐴀𐴟𐴥𐴣𐴌𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴉𐴟𐴌𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡.</char><verse eid="LUK 21:24" /></para>
  <para style="s1">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴀𐴝𐴀</para>
  <para style="r">(<ref loc="MAT 24:29-31">𐴔𐴡𐴃𐴢 24‏:29‏-31</ref>; <ref loc="MRK 13:24-27">𐴔𐴝𐴑 13‏:24‏-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />
    <char style="wj">”𐴀𐴝𐴦𐴌 𐴏𐴝𐴕, 𐴁𐴠𐴙𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝 𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝𐴘𐴁𐴡; 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢 𐴉𐴡𐴌𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴡𐴌𐴞𐴘𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴘𐴌𐴠 𐴏𐴟𐴥𐴇𐴝𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘,</char> <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" /><char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴋𐴡𐴦𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴘𐴠 𐴁𐴠𐴀𐴟𐴥𐴣𐴐𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡𐴥𐴃𐴧𐴡𐴌𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴠𐴑𐴞𐴥𐴁𐴡 𐴊𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.</char> <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴊𐴡𐴌𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴎𐴟 𐴒𐴡𐴌𐴞 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴝𐴃𐴝𐴥 𐴖𐴡𐴌𐴔𐴞𐴑𐴧𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴘𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴌𐴠𐴇𐴝𐴥𐴘 𐴋𐴝𐴥𐴑𐴠.“</char><verse eid="LUK 21:28" /></para>
  <para style="s1">𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴃𐴧𐴟 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 24:32-35">𐴔𐴡𐴃𐴢 24‏:32‏-35</ref>; <ref loc="MRK 13:28-31">𐴔𐴝𐴑 13‏:28‏-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, <char style="wj">”𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴒𐴝𐴏𐴒𐴟𐴏𐴝𐴥𐴓𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴏𐴡𐴀.</char> <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴉𐴝𐴃𐴝 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴏𐴝𐴀𐴘𐴢 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴎𐴝𐴕𐴞𐴎𐴡𐴒𐴡𐴥𐴘 𐴊𐴠, 𐴇𐴡𐴥𐴌𐴝𐴕 𐴋𐴝𐴥𐴑𐴠. </char> <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴀𐴕 𐴀𐴡𐴥𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴝𐴀𐴕 𐴁𐴟𐴎𐴞𐴥𐴁𐴝 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴋𐴝𐴥𐴑𐴠.</char><verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴌𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴠 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡 𐴉𐴟𐴥𐴌𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" /><char style="wj">𐴀𐴝𐴏𐴔𐴝𐴕 𐴎𐴡𐴁𐴞𐴕 𐴃𐴡 𐴎𐴝𐴌𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.</char><verse eid="LUK 21:33" /></para>
  <para style="s1">𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴑𐴞𐴁𐴝𐴌 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴀𐴝𐴘𐴝𐴐𐴞𐴘𐴠, 𐴕𐴞𐴐𐴝𐴥𐴁𐴝𐴎𐴞𐴘𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴘𐴠 𐴁𐴡𐴥𐴌𐴞 𐴕𐴡 𐴎𐴝𐴒𐴡𐴥𐴘, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴊𐴞𐴕 𐴘𐴞𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴉𐴝𐴥𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴘𐴁𐴡𐴘;</char> <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴞𐴕 𐴘𐴞𐴥𐴁𐴝 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴘𐴁𐴡𐴘.</char> <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴡 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴕 𐴔𐴟𐴀𐴕𐴃𐴟 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴞 𐴎𐴝𐴘𐴁𐴡𐴘 𐴓𐴧𐴝 𐴁𐴡𐴓𐴢 𐴃𐴝𐴥𐴑𐴠 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘 𐴉𐴝𐴌𐴡.“</char><verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />𐴊𐴞𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴃𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴝𐴥𐴣𐴎𐴞𐴕𐴧𐴝 𐴕𐴠𐴦𐴓𐴞 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌 𐴈𐴡𐴀 𐴊𐴠 𐴘𐴞𐴥𐴁𐴝𐴃𐴢 𐴎𐴝𐴘 𐴌𐴝𐴙𐴃𐴢 𐴈𐴝𐴍𐴝𐴘𐴃𐴡𐴥; <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />𐴀𐴝𐴦𐴌 𐴁𐴞𐴀𐴕𐴧𐴝 𐴏𐴡𐴥𐴀𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴡𐴓𐴧𐴝 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴀𐴝𐴘𐴃𐴡𐴤.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴏𐴡𐴥𐴓𐴧𐴝</para>
  <para style="r">(<ref loc="MAT 26:1-5">𐴔𐴡𐴃𐴢 26‏:1‏-5</ref>‏,<ref loc="MAT 26:14-16">14‏-16</ref>; <ref loc="MRK 14:1-2">𐴔𐴝𐴑 14‏:1‏-2</ref>‏,<ref loc="MRK 14:10-11">10‏-11</ref>; <ref loc="JHN 11:45-53">𐴘𐴡 11‏:45‏-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴟𐴥𐴄𐴝𐴌-𐴏𐴝𐴥𐴌𐴝 𐴌𐴟𐴄𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴊𐴞𐴕 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴠 𐴀𐴞𐴊𐴡𐴌𐴠 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴢 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />𐴀𐴝𐴦𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴞𐴦 𐴁𐴡𐴃𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴃𐴡𐴥.<verse eid="LUK 22:2" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴌𐴝𐴎𐴞 𐴀𐴡𐴥𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 26:14-16">𐴔𐴡𐴃𐴢 26‏:14‏-16</ref>; <ref loc="MRK 14:10">𐴔𐴝𐴑 14‏:10</ref>‏,<ref loc="MRK 14:11">11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴎𐴝𐴌𐴠𐴥 𐴀𐴞𐴏𐴑𐴝𐴥𐴌𐴞𐴘𐴠𐴃𐴢 𐴋𐴝𐴑𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴎𐴠𐴦 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />𐴀𐴞𐴥𐴃𐴠 𐴎𐴝𐴘 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘, 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴏𐴡𐴥𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥𐴒𐴡𐴘 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴑𐴞𐴦 𐴁𐴡𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴃𐴝𐴌𐴝𐴥𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴡𐴥𐴌𐴞𐴊𐴞 𐴉𐴝𐴌𐴞𐴁𐴡𐴥. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴄𐴞𐴛𐴝 𐴊𐴞𐴦𐴁𐴡 𐴁𐴡𐴓𐴞 𐴈𐴡𐴘𐴧𐴠𐴥. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />𐴀𐴞𐴥𐴃𐴠 𐴌𐴝𐴎𐴞 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴑𐴝𐴌 𐴃𐴝𐴓𐴝𐴐𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 22:6" /></para>
  <para style="s1">𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝</para>
  <para style="r">(<ref loc="MAT 26:17-25">𐴔𐴡𐴃𐴢 26‏:17‏-25</ref>; <ref loc="MRK 14:12-21">𐴔𐴝𐴑 14‏:12‏-21</ref>; <ref loc="JHN 13:21-30">𐴘𐴡 13‏:21‏-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴐𐴟𐴥𐴄𐴝𐴌-𐴏𐴝𐴥𐴌𐴝 𐴌𐴟𐴄𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴊𐴞𐴕 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴠 𐴊𐴞𐴕𐴡𐴃𐴢 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴓𐴧𐴝 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴏𐴡𐴥𐴀 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴥𐴌𐴡𐴏𐴢. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴞𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴦, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴥𐴘 𐴉𐴝𐴌𐴞 𐴉𐴝𐴥𐴕 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴌 𐴃𐴡𐴘𐴧𐴝𐴌𐴞 𐴒𐴡𐴌𐴡𐴤𐴒𐴡𐴘.“</char><verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴍𐴠𐴥 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟“<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴓𐴠 𐴔𐴡𐴃𐴧𐴡𐴌, 𐴎𐴡𐴑𐴡𐴃𐴢 𐴒𐴡𐴌𐴞 𐴉𐴝𐴕𐴞𐴥 𐴓𐴡𐴘𐴎𐴝𐴌 𐴊𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴞𐴁𐴡𐴥; 𐴀𐴞𐴥𐴁𐴝 𐴎𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴁𐴡 𐴇𐴠𐴥 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴎𐴝𐴘𐴧𐴡,</char> <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" /><char style="wj">𐴀𐴝𐴦𐴌 𐴒𐴡𐴥𐴌 𐴒𐴝𐴕𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ’𐴀𐴟𐴏𐴃𐴝𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴠𐴀𐴔𐴝𐴕-𐴈𐴝𐴥𐴕𐴝 𐴇𐴡𐴍𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴇𐴝𐴥𐴘 𐴉𐴝𐴙𐴅𐴧𐴟𐴔؟“ ‘</char> <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" /><char style="wj">𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴣𐴎𐴝𐴘𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴖𐴡𐴌𐴡𐴌 𐴄𐴝𐴓𐴝𐴌 𐴋𐴡𐴣𐴀𐴌 𐴑𐴝𐴔𐴝𐴥𐴌𐴝 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴡; 𐴇𐴠𐴥𐴍𐴠 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.“</char><verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴘, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴝𐴘𐴧𐴠𐴥; 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴌 𐴃𐴡𐴘𐴧𐴝𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="LUK 22:13" /></para>
  <para style="s1">𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴝𐴥𐴕𐴝</para>
  <para style="r">(<ref loc="MAT 26:26-30">𐴔𐴡𐴃𐴢 26‏:26‏-30</ref>; <ref loc="MRK 14:22-26">𐴔𐴝𐴑 14‏:22‏-26</ref>; <ref loc="1CO 11:23-25">1𐴑𐴡𐴥𐴌 11‏:23‏-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴏𐴝𐴤 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕 𐴀𐴡𐴥 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴊𐴟𐴑 𐴉𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴠 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥;</char> <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴘𐴝𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴉𐴟𐴌𐴝 𐴕𐴡, 𐴇𐴠𐴥𐴃𐴡𐴊𐴞𐴕 𐴀𐴞𐴀𐴕 𐴀𐴝𐴀𐴛 𐴀𐴝𐴁𐴝𐴌 𐴕𐴝 𐴈𐴝𐴥𐴘𐴧𐴟𐴔.“</char><verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴘𐴝𐴓𐴝 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴞𐴁𐴝𐴤 𐴓𐴡𐴦𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴡𐴌𐴝𐴃𐴢 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠𐴇𐴡𐴥𐴕𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴀𐴛 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴕𐴝 𐴈𐴝𐴥𐴘𐴧𐴟𐴔.“</char><verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴌𐴟𐴄𐴞 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴥𐴚𐴒𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴝𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴦, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.“</char><verse eid="LUK 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴌𐴟𐴄𐴞 𐴇𐴝𐴥𐴘 𐴁𐴝𐴦𐴊𐴠 𐴉𐴞𐴘𐴝𐴓𐴝 𐴖𐴝 𐴓𐴡𐴦𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴖𐴢 𐴓𐴡𐴘 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴕𐴡𐴘𐴝 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠 𐴉𐴞𐴘𐴝𐴓𐴝, 𐴎𐴠 𐴓𐴡𐴖𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴟𐴔. </char><verse eid="LUK 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴡𐴀, 𐴎𐴠𐴦 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴠𐴏𐴡𐴃𐴢 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴌.</char> <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" /><char style="wj">𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴔𐴡𐴎𐴞𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴔𐴡𐴌𐴞𐴁𐴡𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴀𐴟𐴘𐴃𐴝𐴌 𐴖𐴡𐴌𐴠, 𐴎𐴠𐴦 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴠.“</char> <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞, 𐴃𐴝𐴌𐴝𐴥𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴇𐴠𐴥 𐴈𐴝𐴔 𐴔𐴝𐴥𐴕 𐴇𐴡𐴕𐴠 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴈𐴡𐴀𐴘𐴢 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 22:23" /></para>
  <para style="s1">𐴋𐴡𐴣𐴀𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴇𐴝𐴌𐴠𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴔𐴝𐴕𐴝 𐴎𐴝𐴘𐴁𐴡 𐴈𐴡𐴀𐴘𐴢 𐴘𐴡𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞 𐴀𐴟𐴙𐴄𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴝𐴌𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴝𐴌𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌𐴝𐴤 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴏𐴡𐴓𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 ’𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴟𐴏𐴃𐴡𐴥‘ 𐴁𐴡𐴥𐴓𐴞 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴃𐴠𐴦 𐴀𐴠𐴁𐴧𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴖𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴑; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴃𐴠𐴦 𐴒𐴟𐴓𐴝𐴔𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴑.</char> <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴡𐴕𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌, 𐴑𐴞 𐴔𐴠𐴏𐴡𐴃𐴢 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝؟ 𐴔𐴠𐴏𐴡𐴃𐴢 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴕𐴡 𐴕𐴠𐴥؟ 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝.</char><verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴑𐴧𐴡𐴥𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝.</char> <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴝𐴙𐴅𐴧𐴡 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴝𐴙𐴅𐴧𐴡 𐴊𐴞𐴦𐴌,</char> <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" /><char style="wj">𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴔𐴠𐴏𐴡𐴃𐴢 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴁𐴝𐴌𐴡𐴥 𐴒𐴟𐴙𐴐𐴧𐴞𐴥𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴡𐴤.“</char><verse eid="LUK 22:30" /></para>
  <para style="s1">𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 26:31-35">𐴔𐴡𐴃𐴢 26‏:31‏-35</ref>; <ref loc="MRK 14:27-31">𐴔𐴝𐴑 14‏:27‏-31</ref>; <ref loc="JHN 13:36-38">𐴘𐴡 13‏:36‏-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />
    <char style="wj">”𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴉𐴟𐴥𐴕, 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴞𐴣𐴘𐴟𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴝𐴓𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴔𐴝𐴙𐴒𐴧𐴠𐴥.</char> <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴌 𐴀𐴞𐴔𐴝𐴕 𐴑𐴡𐴔𐴎𐴟𐴌 𐴕𐴡 𐴉𐴝𐴥𐴕 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴍𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴘𐴁𐴞𐴤, 𐴃𐴡𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴐𐴢.“ </char><verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴎𐴝𐴘𐴃𐴡 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴙𐴃𐴧𐴡 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴝𐴏𐴞𐴤.“<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴞𐴃𐴡𐴌, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴙𐴅𐴧𐴝 𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴁𐴝𐴑 𐴊𐴞𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴕𐴡 𐴏𐴞𐴕𐴡𐴥𐴏𐴢 𐴈𐴡𐴀𐴘𐴢 𐴃𐴞𐴕 𐴁𐴝𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴞.“ </char><verse eid="LUK 22:34" /></para>
  <para style="s1">𐴄𐴞𐴛𐴝𐴌 𐴁𐴠𐴑, 𐴇𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴟𐴥𐴌𐴞</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴄𐴞𐴛𐴝𐴌 𐴎𐴝𐴓𐴞, 𐴐𐴠𐴕𐴄𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴝𐴥𐴌𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴓𐴝𐴔, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴈𐴡𐴔𐴞 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢 𐴕𐴠𐴥؟“</char></para>
  <para style="p" vid="LUK 22:35">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴈𐴡𐴔𐴞 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.“<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴇𐴡𐴥𐴕 𐴎𐴝𐴃𐴧𐴟 𐴄𐴞𐴛𐴝𐴌 𐴎𐴝𐴓𐴞 𐴀𐴝𐴏𐴠𐴤 𐴃𐴠𐴦 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴥𐴙𐴓𐴧𐴝 𐴘𐴡𐴥 𐴓𐴡𐴦, 𐴀𐴝𐴦𐴌 𐴎𐴝𐴃𐴧𐴟 𐴏𐴟𐴥𐴌𐴞 𐴕𐴝𐴥𐴘, 𐴃𐴠𐴦 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴊𐴧𐴡𐴌 𐴁𐴠𐴏𐴞 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴑𐴞𐴕𐴞𐴓𐴡.</char> <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" /><char style="wj">𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ’𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴌</char><note caller="+" style="f"><char style="fr" closed="false">22‏:37 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 𐴀𐴡𐴉𐴡𐴥𐴌𐴝𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌</char></note> <char style="wj">𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴒𐴡𐴕𐴝 𐴒𐴞𐴘𐴠𐴥,‘</char><note caller="+" style="f"><char style="fr" closed="false">22‏:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:12">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 53‏:12</ref></char></char></note> <char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴇𐴠𐴥 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴖𐴝 𐴎𐴡𐴌𐴟𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴞𐴀𐴕 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴌.“</char><verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴏𐴡𐴀, 𐴀𐴠𐴍𐴠𐴥 𐴊𐴟𐴘𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴌𐴞 𐴀𐴝𐴏𐴠𐴤.“</para>
  <para style="p" vid="LUK 22:38">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴞𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠 𐴑𐴝𐴉𐴞𐴥.“</char><verse eid="LUK 22:38" /></para>
  <para style="s1">𐴒𐴠𐴃𐴏𐴝𐴥𐴔𐴝𐴕𐴞 𐴁𐴝𐴒𐴝𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴖𐴝</para>
  <para style="r">(<ref loc="MAT 26:36-46">𐴔𐴡𐴃𐴢 26‏:36‏-46</ref>; <ref loc="MRK 14:32-42">𐴔𐴝𐴑 14‏:32‏-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />𐴀𐴞𐴏𐴝𐴤 𐴕𐴠𐴦𐴓𐴞 𐴕𐴞𐴎𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴔𐴡𐴎𐴞𐴕 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥; 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴞 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴕𐴡 𐴉𐴡𐴌𐴡.“</char> <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴃𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴐𐴞𐴥𐴓𐴡𐴌 𐴊𐴡𐴓𐴝 𐴔𐴠𐴓𐴝𐴤 𐴔𐴝𐴥𐴙𐴓𐴧𐴠 𐴎𐴠𐴊𐴧𐴟𐴥𐴌 𐴎𐴝𐴦, 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴀𐴝𐴥𐴕𐴞𐴑 𐴊𐴟𐴌𐴠𐴥 𐴎𐴝𐴘 𐴀𐴝𐴣𐴍𐴟𐴥𐴌 𐴃𐴡𐴥𐴑𐴊𐴞 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" /><char style="wj">”𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴏𐴡𐴀, 𐴀𐴠 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴘𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴝𐴣𐴀𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴀𐴡𐴥𐴑.“</char> <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴊𐴝𐴈𐴝𐴤 𐴊𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴡𐴓𐴢 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴡𐴥𐴘 𐴊𐴞𐴓𐴔𐴡𐴕 𐴊𐴞 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴝𐴥𐴔 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴉𐴟𐴥𐴍𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘 𐴔𐴠𐴍𐴞𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />𐴀𐴞𐴥𐴁𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴟𐴖𐴝𐴃𐴧𐴟 𐴀𐴟𐴍𐴞𐴤 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴠 𐴀𐴡𐴥𐴌𐴝𐴕 𐴀𐴡𐴥𐴘 𐴒𐴟𐴥𐴔 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴟𐴥𐴔 𐴎𐴡𐴀𐴌 𐴑𐴞𐴘𐴝𐴥؟ 𐴀𐴟𐴍𐴡𐴥 𐴀𐴝𐴦𐴌 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴕𐴡 𐴉𐴡𐴌𐴡.“</char><verse eid="LUK 22:46" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌𐴞</para>
  <para style="r">(<ref loc="MAT 26:47-56">𐴔𐴡𐴃𐴢 26‏:47‏-56</ref>; <ref loc="MRK 14:43-52">𐴔𐴝𐴑 14‏:43‏-52</ref>; <ref loc="JHN 18:3-11">𐴘𐴡 18‏:3‏-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴈𐴡𐴀 𐴊𐴠 𐴀𐴞𐴥𐴃𐴠 𐴃𐴝𐴌𐴝𐴥𐴌 𐴀𐴝𐴒𐴠-𐴀𐴝𐴒𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴡𐴇𐴟𐴥𐴊𐴝, 𐴃𐴟𐴘 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥 𐴊𐴡𐴥𐴌𐴞 𐴊𐴡𐴥𐴌 𐴊𐴠𐴥؟“</char><verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴡𐴥𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴏𐴡𐴓𐴝𐴘𐴧𐴟𐴥𐴔 𐴕𐴠𐴥؟“ <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴏𐴡𐴓𐴝𐴘 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴒𐴟𐴓𐴝𐴔𐴡𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴌 𐴈𐴝𐴕 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴁𐴡𐴕 𐴒𐴡𐴌, 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴐𐴢.“</char> 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴌 𐴈𐴝𐴕 𐴊𐴡𐴥𐴌𐴞 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴙𐴃𐴧𐴡 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴢 𐴊𐴡𐴥𐴙𐴃𐴧𐴡 𐴀𐴝𐴙𐴐𐴧𐴡𐴥 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴍𐴞𐴥-𐴐𐴟𐴥𐴍𐴝 𐴓𐴡𐴘 𐴀𐴝𐴙𐴐𐴧𐴡𐴥 𐴊𐴠𐴥؟</char> <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴉𐴡𐴃𐴧𐴞𐴥 𐴊𐴞𐴕 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴥𐴃𐴢 𐴕𐴡𐴥 𐴓𐴝𐴒𐴡; 𐴓𐴠𐴑𐴞𐴕 𐴀𐴠𐴇𐴡𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥, 𐴎𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴊𐴝𐴤𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌.“ </char><verse eid="LUK 22:53" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴀𐴞𐴕𐴑𐴝𐴌</para>
  <para style="r">(<ref loc="MAT 26:57-58">𐴔𐴡𐴃𐴢 26‏:57‏-58</ref>‏,<ref loc="MAT 26:69-75">69‏-75</ref>; <ref loc="MRK 14:53-54">𐴔𐴝𐴑 14‏:53‏-54</ref>‏,<ref loc="MRK 14:66-72">66‏-72</ref>; <ref loc="JHN 18:12-18">𐴘𐴡 18‏:12‏-18</ref>‏,<ref loc="JHN 18:25-27">25‏-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴡𐴥𐴘. 𐴉𐴞𐴃𐴡𐴌 𐴊𐴟𐴌𐴠𐴥-𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴘 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />𐴃𐴝𐴌𐴝𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴎𐴠𐴥 𐴀𐴡𐴦𐴙𐴕 𐴎𐴝𐴓𐴞 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴒𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴙𐴐𐴧𐴠𐴥, 𐴉𐴞𐴃𐴡𐴌 𐴀𐴡𐴥 𐴃𐴝𐴌𐴝𐴥𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴁𐴝𐴣𐴊𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴄𐴝𐴓𐴡𐴃𐴢 𐴁𐴡𐴘𐴍𐴝𐴤 𐴊𐴠𐴑𐴞𐴥, 𐴒𐴟𐴥𐴖𐴝𐴣𐴌𐴝𐴘 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴘𐴡𐴥 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.“<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠, ”𐴇𐴠𐴥𐴘 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥.“<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />𐴇𐴡𐴃𐴟𐴥𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴊𐴠𐴑𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴘𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴎𐴡𐴕.“</para>
  <para style="p" vid="LUK 22:58">𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴕𐴡 𐴁𐴝𐴥𐴘, 𐴀𐴝𐴀𐴛 𐴕𐴡.“<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />𐴀𐴝𐴌𐴀𐴠𐴑 𐴒𐴡𐴥𐴕𐴋𐴝 𐴀𐴝𐴥𐴕𐴞𐴑 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴘𐴡𐴥 𐴀𐴠𐴑𐴞𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴥𐴘𐴧𐴞, 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴁𐴝𐴤 𐴘𐴡𐴥 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢.“<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴁𐴝𐴥𐴘, 𐴃𐴟𐴀𐴛 𐴀𐴞𐴀𐴕 𐴑𐴞𐴘𐴡𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴀𐴌 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴕𐴞.“ 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴁𐴝𐴑 𐴊𐴞𐴘𐴠𐴥. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴔𐴝𐴓𐴞𐴑𐴠 𐴉𐴞𐴥𐴌𐴞 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴘𐴧𐴠𐴥. 𐴀𐴝𐴦𐴌 𐴉𐴞𐴃𐴡𐴌𐴡𐴃𐴧𐴟 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴖𐴝𐴀𐴕 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, <char style="wj">”𐴀𐴝𐴙𐴅𐴧𐴝 𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴁𐴝𐴑 𐴊𐴞𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴞𐴕 𐴁𐴝𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴞.“</char> <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴞𐴒𐴡𐴥𐴘 𐴑𐴟𐴥𐴁𐴢 𐴈𐴝𐴣𐴊𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="LUK 22:62" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴕𐴐𐴝 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴌𐴝-𐴊𐴡𐴥𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 26:67-68">𐴔𐴡𐴃𐴢 26‏:67‏-68</ref>; <ref loc="MRK 14:65">𐴔𐴝𐴑 14‏:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴉𐴝𐴀𐴌𐴝𐴊𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴕𐴐𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴌𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴟𐴑 𐴁𐴝𐴣𐴊𐴞𐴥 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴡𐴌𐴠𐴥 𐴇𐴡𐴕𐴠 𐴔𐴝𐴙𐴅𐴧𐴠𐴥 𐴀𐴝𐴕𐴃𐴝𐴏𐴢 𐴒𐴡𐴌 𐴏𐴝𐴥𐴘؟“ <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 22:65" /></para>
  <para style="s1">𐴉𐴡𐴥𐴃𐴟𐴖𐴝𐴘𐴞-𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴏𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 26:59-66">𐴔𐴡𐴃𐴢 26‏:59‏-66</ref>; <ref loc="MRK 14:55-64">𐴔𐴝𐴑 14‏:55‏-64</ref>; <ref loc="JHN 18:19-24">𐴘𐴡 18‏:19‏-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />𐴁𐴞𐴀𐴕𐴧𐴝 𐴉𐴡𐴀𐴌 𐴉𐴝𐴥𐴙𐴄𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌, 𐴘𐴝𐴥𐴕𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴘𐴧𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴉𐴡𐴥𐴃𐴟𐴖𐴝𐴘𐴞-𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴡𐴃𐴢 𐴀𐴝𐴕𐴞𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />”𐴃𐴟𐴀𐴛 𐴎𐴡𐴊𐴞 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴀.“</para>
  <para style="p" vid="LUK 22:67">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴑𐴞𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝,</char> <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴟𐴖𐴝𐴁𐴢 𐴕𐴡 𐴊𐴞𐴁𐴝𐴤.</char> <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴘𐴝𐴓𐴝 𐴓𐴡𐴥𐴃𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴓𐴧𐴝 𐴃𐴝𐴥𐴓𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.“</char><verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴕𐴞𐴥𐴑𐴞؟“</para>
  <para style="p" vid="LUK 22:70">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴌, 𐴀𐴡𐴥𐴘 𐴀𐴝𐴀𐴛.“</char><verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴌 𐴑𐴞𐴦 𐴒𐴡𐴁𐴝𐴤 𐴓𐴝𐴒𐴠𐴌 𐴊𐴠𐴥؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴁𐴝𐴤𐴌 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴑𐴡𐴃𐴧𐴟 𐴉𐴟𐴥𐴙𐴕𐴧𐴞.“<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s1">𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴏𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 27:1-2">𐴔𐴡𐴃𐴢 27‏:1‏-2</ref>‏,<ref loc="MAT 27:11-14">11‏-14</ref>; <ref loc="MRK 15:1-5">𐴔𐴝𐴑 15‏:1‏-5</ref>; <ref loc="JHN 18:28-38">𐴘𐴡 18‏:28‏-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢 𐴄𐴞𐴥𐴘𐴝 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴓𐴎𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴝𐴒𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴡𐴗𐴔𐴡𐴌𐴠 𐴒𐴟𐴔𐴌𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠𐴌. 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴕𐴡 𐴊𐴞𐴦𐴃𐴡 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴑𐴞 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴔𐴡𐴀𐴏𐴞𐴤, 𐴁𐴝𐴀𐴣𐴐𐴧𐴝.“<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴕𐴞𐴥𐴑𐴞؟“</para>
  <para style="p" vid="LUK 23:3">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥𐴘, 𐴃𐴟𐴀𐴛 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝.“</char><verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />𐴃𐴡𐴥𐴘 𐴉𐴞𐴓𐴝𐴃𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴔𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡 𐴉𐴝𐴙𐴌.“<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴉𐴟𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴟𐴏𐴑𐴝𐴘 𐴊𐴠𐴌. 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴌𐴞𐴥 𐴀𐴠 𐴎𐴝𐴒𐴝𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠.“<verse eid="LUK 23:5" /></para>
  <para style="s1">𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴏𐴝𐴤</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴁𐴝𐴤 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴕𐴞𐴑𐴞 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴞𐴘𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴈𐴠𐴥𐴌𐴟𐴊𐴢 𐴀𐴡𐴥 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴞𐴐𐴞𐴤 𐴊𐴠𐴌𐴞 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴏𐴟𐴥𐴖𐴝𐴓𐴝-𐴏𐴟𐴥𐴖𐴝𐴓𐴞 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴖𐴝𐴁𐴢 𐴕𐴡𐴥 𐴊𐴠. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴔𐴟𐴥𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴔𐴟𐴥𐴕𐴠 𐴇𐴠𐴥𐴍𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴎𐴟𐴌𐴠𐴏𐴟𐴥𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴓𐴎𐴝𐴔 𐴓𐴝𐴒𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴀𐴠𐴊𐴧𐴠 𐴄𐴝𐴥𐴃𐴄𐴝𐴘 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴏𐴡𐴙𐴑𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴎𐴟𐴁𐴧𐴝 𐴉𐴞𐴣𐴊𐴝𐴥𐴘 𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴞𐴘𐴠. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴉𐴞𐴓𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴈𐴠𐴥𐴌𐴟𐴊𐴢 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴒𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴡𐴘 𐴀𐴠𐴎𐴧𐴡𐴕 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 23:12" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔</para>
  <para style="r">(<ref loc="MAT 27:15-26">𐴔𐴡𐴃𐴢 27‏:15‏-26</ref>; <ref loc="MRK 15:6-15">𐴔𐴝𐴑 15‏:6‏-15</ref>; <ref loc="JHN 18:39-19:16">𐴘𐴡 18‏:39‏—19‏:16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠, 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴖𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴎𐴡𐴔𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴡𐴤 𐴊𐴠, 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴁𐴝𐴒𐴞 𐴁𐴡𐴕𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴏𐴑𐴝𐴘 𐴊𐴠𐴌 𐴈𐴡𐴀𐴘𐴢. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴎𐴠𐴌𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴀𐴕 𐴀𐴠𐴓𐴎𐴝𐴔 𐴓𐴝𐴒𐴡𐴀𐴌, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴀𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡 𐴉𐴝𐴙𐴌. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴘𐴡𐴥 𐴕𐴡𐴥 𐴉𐴝𐴦, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴞𐴘𐴠 𐴊𐴠; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠𐴑𐴡𐴥𐴌, 𐴔𐴡𐴦𐴃𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴞𐴥 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴟𐴔.“ <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴊𐴞𐴕 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴑 𐴇𐴡𐴊𐴞𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴉𐴡𐴙𐴃𐴧𐴡.<verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴠𐴑𐴧𐴟 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴡, 𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴡.“ <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝𐴌𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴞𐴥𐴘𐴝 𐴒𐴞𐴀𐴓𐴢 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴁𐴝𐴒𐴞𐴘𐴝𐴘 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴁𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴞𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴙𐴓𐴢. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, ”𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴡, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴡!“<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴑𐴞𐴘𐴝𐴥, 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴑𐴞𐴦 𐴁𐴟𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴔𐴡𐴌𐴝 𐴉𐴡𐴌𐴠 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡𐴥 𐴉𐴝𐴘; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴞𐴥 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴟𐴔.“<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝. 𐴀𐴝𐴦𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴎𐴡𐴌𐴝 𐴑𐴝𐴦𐴔𐴞𐴘𐴝𐴁𐴢 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />𐴃𐴡𐴥𐴘 𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴝𐴁𐴞 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴙𐴒𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴞𐴥𐴘𐴝 𐴒𐴞𐴀𐴓𐴢 𐴊𐴠, 𐴁𐴝𐴒𐴞𐴘𐴝𐴘 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴒𐴡𐴏𐴝𐴥𐴘 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="LUK 23:25" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 27:32-44">𐴔𐴡𐴃𐴢 27‏:32‏-44</ref>; <ref loc="MRK 15:21-32">𐴔𐴝𐴑 15‏:21‏-32</ref>; <ref loc="JHN 19:17-27">𐴘𐴡 19‏:17‏-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴌𐴒𐴡𐴥𐴘 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴌𐴠𐴕𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴒𐴝𐴚 𐴎𐴝𐴒𐴝𐴃𐴧𐴟 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴇𐴠𐴥𐴍𐴠 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴊𐴡𐴥𐴌𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴢 𐴐𐴝𐴕 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴘𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴁𐴡𐴀𐴘𐴢 𐴓𐴡𐴘𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴀𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴁𐴟𐴑 𐴑𐴞𐴓𐴝𐴘-𐴑𐴞𐴓𐴝𐴘 𐴈𐴝𐴣𐴊𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴉𐴞𐴥𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕, 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴕𐴡 𐴈𐴝𐴣𐴊𐴞𐴘𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴓𐴧𐴝 𐴈𐴝𐴣𐴊𐴡.</char> <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴏𐴡𐴀, 𐴀𐴠𐴀𐴕 𐴊𐴞𐴕 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴎𐴠 𐴊𐴞𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴁𐴝𐴥𐴎𐴢 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴉𐴟𐴀𐴝𐴙𐴕 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴁𐴟𐴑𐴡𐴌 𐴊𐴟𐴊𐴢 𐴕𐴡𐴥 𐴈𐴝𐴥𐴀𐴁𐴝.‘</char> <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴔𐴟𐴌𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴉𐴡𐴌,‘ 𐴀𐴝𐴦𐴌 𐴉𐴝𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴝𐴥𐴉𐴝𐴘𐴉𐴠𐴓𐴢.‘</char><note caller="+" style="f"><char style="fr" closed="false">23‏:30 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 10:8">𐴇𐴡𐴥𐴐𐴞𐴘𐴝 10‏:8</ref></char></char></note> <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴊𐴝𐴌𐴒𐴗𐴝𐴤 𐴑𐴠𐴦𐴣𐴏𐴝 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴎𐴡𐴊𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴉𐴟𐴥𐴖𐴝𐴘𐴓𐴠 𐴑𐴞𐴦 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤؟“</char><verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴀𐴝𐴐𐴝𐴥𐴔𐴞𐴌𐴠 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴓𐴡𐴘𐴎𐴝𐴌. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴃𐴝𐴥𐴌 𐴔𐴝𐴓𐴝 𐴈𐴡𐴀 𐴊𐴠 𐴎𐴝𐴒𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥 𐴀𐴝𐴐𐴝𐴥𐴔𐴞 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴘𐴠, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴕 𐴋𐴝𐴥𐴑 𐴀𐴡𐴃𐴧𐴟. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴡𐴤; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴑𐴞𐴦 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴕𐴡 𐴎𐴝𐴕𐴠.“</char></para>
  <para style="p" vid="LUK 23:34">𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴡𐴄𐴝𐴥𐴌𐴞 𐴔𐴝𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌𐴡𐴌𐴠 𐴁𐴝𐴥𐴑 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="LUK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢. 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴄𐴝𐴥𐴃𐴄𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴡 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥; 𐴎𐴡𐴊𐴞 𐴀𐴞𐴁𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴙𐴐𐴧𐴝𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴖𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴘𐴝𐴓𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴁𐴝𐴏𐴡𐴗𐴑 𐴏𐴝𐴥𐴘.“<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴄𐴝𐴥𐴃𐴄𐴝𐴘 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴏𐴞𐴥𐴌𐴑𐴝<note caller="+" style="f"><char style="fr" closed="false">23‏:36 </char><char style="fq">𐴏𐴞𐴥𐴌𐴑𐴝</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴝𐴕𐴞𐴥 𐴔𐴞𐴘𐴝𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴐𐴡𐴥𐴌𐴁𐴡𐴃𐴢, 𐴎𐴞𐴀𐴕 𐴈𐴝𐴥𐴘𐴃𐴠 𐴇𐴡𐴥𐴌𐴡-𐴇𐴡𐴥𐴌𐴡 𐴓𐴝𐴒𐴠.</note> 𐴊𐴞𐴦 <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴃𐴟𐴘 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴘𐴝𐴓𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴁𐴝𐴏𐴝 𐴏𐴝𐴥𐴘!“<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴝𐴥𐴙𐴕𐴁𐴟𐴥𐴄𐴢 𐴀𐴡𐴥 𐴔𐴝𐴌𐴞𐴊𐴞𐴀𐴓𐴢, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, ” <char style="sc">𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝.</char>“<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴀𐴝𐴐𐴝𐴥𐴔𐴞𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴘 𐴑𐴞 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴡؟ 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴝𐴏𐴝 𐴏𐴠𐴕𐴝𐴥.“<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴀𐴝𐴐𐴝𐴥𐴔𐴞 𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴘 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴃𐴟𐴘 𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡 𐴋𐴡𐴦𐴌𐴡𐴏؟ 𐴃𐴟𐴘 𐴘𐴡𐴥 𐴊𐴠 𐴀𐴠𐴑𐴞𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴝𐴥𐴣𐴎𐴝 𐴉𐴡𐴀𐴌. <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴏𐴝𐴥𐴣𐴎𐴝 𐴇𐴡𐴥𐴑𐴧𐴡𐴃𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔𐴡𐴓𐴧𐴝 𐴎𐴞𐴘𐴝𐴥𐴕 𐴓𐴝𐴦𐴘𐴠𐴑 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴝𐴙𐴌 𐴊𐴠, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥.“<verse eid="LUK 23:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴀𐴞𐴏𐴝𐴤, 𐴃𐴟𐴀𐴛 𐴕𐴞𐴎𐴡𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴀𐴝𐴘𐴁𐴝𐴤 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴘𐴝𐴦𐴊𐴢 𐴌𐴝𐴙𐴑𐴧𐴡𐴥.“<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴙𐴅𐴧𐴝 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴅𐴡𐴕𐴧𐴡𐴃𐴟𐴓𐴢-𐴉𐴠𐴥𐴌𐴡𐴊𐴟𐴏𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴝.“</char><verse eid="LUK 23:43" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴡𐴦𐴃𐴢</para>
  <para style="r">(<ref loc="MAT 27:45-56">𐴔𐴡𐴃𐴢 27‏:45‏-56</ref>; <ref loc="MRK 15:33-41">𐴔𐴝𐴑 15‏:33‏-41</ref>; <ref loc="JHN 19:28-30">𐴘𐴡 19‏:28‏-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴊𐴟𐴀𐴣𐴙𐴅𐴧𐴝𐴌 𐴁𐴝𐴌𐴡𐴥 𐴖𐴝 𐴀𐴝𐴥𐴕𐴞𐴑 𐴁𐴝𐴙𐴅𐴧𐴠𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴁𐴝𐴥𐴎𐴠 𐴉𐴝𐴥𐴕 𐴒𐴟𐴣𐴍𐴝 𐴔𐴟𐴓𐴧𐴟𐴑 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴀𐴡𐴥𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴘𐴓𐴠 𐴉𐴡𐴀𐴌 𐴊𐴞𐴥𐴘𐴝 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠; 𐴀𐴝𐴦𐴌 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴉𐴡𐴌𐴡𐴊𐴝 𐴒𐴝𐴥𐴕 𐴉𐴝𐴥𐴍𐴞 𐴊𐴟𐴘 𐴁𐴝𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴌𐴟𐴀 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴞.“</char><note caller="+" style="f"><char style="fr" closed="false">23‏:46 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 31:5">𐴎𐴡𐴁𐴟𐴌 31‏:5</ref></char></char></note> 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴕𐴃𐴠𐴇𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴌𐴡𐴔𐴞 𐴐𐴝𐴥𐴀𐴂𐴠<note caller="+" style="f"><char style="fr" closed="false">23‏:47 </char><char style="ft" closed="false">𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴉𐴡𐴥𐴗𐴏𐴡𐴌 𐴔𐴝𐴎𐴞𐴥</char></note> 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢!“<verse eid="LUK 23:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48" />𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥 𐴃𐴡𐴦𐴣𐴐𐴝𐴤 𐴏𐴝𐴘𐴃𐴡𐴥 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠𐴑𐴞𐴥 𐴁𐴟𐴑 𐴑𐴞𐴓𐴝𐴘-𐴑𐴞𐴓𐴝𐴘 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴞𐴕𐴉𐴡𐴌𐴞𐴏𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴞𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴊𐴟𐴌𐴠𐴥 𐴒𐴡𐴥𐴌𐴞 𐴃𐴞𐴥𐴘𐴝𐴘 𐴇𐴞𐴥𐴀𐴕 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢.<verse eid="LUK 23:49" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴝𐴥𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 27:57-61">𐴔𐴡𐴃𐴢 27‏:57‏-61</ref>; <ref loc="MRK 15:42-47">𐴔𐴝𐴑 15‏:42‏-47</ref>; <ref loc="JHN 19:38-42">𐴘𐴡 19‏:38‏-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴒𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴉𐴡𐴥𐴃𐴟𐴖𐴝𐴘𐴞-𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴔𐴠𐴔𐴁𐴡𐴥𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴡𐴥𐴓𐴧𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴔𐴡𐴃𐴢 𐴌𐴝𐴎𐴞 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴐𐴡𐴥𐴀𐴌 𐴀𐴝𐴌𐴝𐴔𐴝𐴥𐴃𐴞𐴘𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘 𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴝𐴐𐴧𐴗𐴝 𐴔𐴝𐴙𐴒𐴧𐴠𐴥, <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />𐴁𐴝𐴦𐴊𐴠 𐴓𐴝𐴐𐴧𐴗𐴝 𐴓𐴝𐴔𐴝𐴘 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴇𐴡𐴇𐴡𐴥𐴕𐴡𐴌 𐴇𐴡𐴦𐴌𐴡𐴃𐴢 𐴁𐴠𐴌𐴝𐴤𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴐𐴞𐴥𐴓𐴢 𐴑𐴟𐴥𐴣𐴊𐴞 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴌𐴝𐴙𐴑𐴧𐴠𐴥𐴒𐴡𐴘, 𐴎𐴞𐴁𐴝𐴤𐴃𐴢 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴝𐴥𐴙𐴓𐴢 𐴊𐴠 𐴕𐴝𐴥𐴘. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴔-𐴀𐴡𐴌-𐴊𐴞𐴕، 𐴀𐴝𐴦𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴐𐴟𐴥𐴌𐴟 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴧𐴟 𐴎𐴠 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴕𐴟𐴥𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴌𐴞, 𐴈𐴡𐴁𐴡𐴌𐴒𐴗𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴝𐴐𐴧𐴗𐴝𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴌𐴝𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴎𐴝𐴘𐴒𐴡𐴥𐴘, 𐴑𐴟𐴥𐴐𐴁𐴡 𐴔𐴡𐴏𐴡𐴥𐴓𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴃𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. 𐴀𐴝𐴦𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴔𐴡𐴎𐴞𐴕 𐴎𐴞𐴌𐴝𐴀𐴙𐴓𐴢.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘</para>
  <para style="r">(<ref loc="MAT 28:1-10">𐴔𐴡𐴃𐴢 28‏:1‏-10</ref>; <ref loc="MRK 16:1-8">𐴔𐴝𐴑 16‏:1‏-8</ref>; <ref loc="JHN 20:1-10">𐴘𐴡 20‏:1‏-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />𐴇𐴝𐴥𐴉𐴃𐴝𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴊𐴞𐴕 𐴁𐴞𐴀𐴕𐴧𐴝 𐴑𐴟𐴥𐴁𐴢 𐴏𐴡𐴥𐴀𐴌𐴠, 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴕𐴟𐴥𐴕𐴠 𐴑𐴟𐴥𐴐𐴁𐴡 𐴔𐴡𐴏𐴡𐴥𐴓𐴧𐴝 𐴀𐴟𐴀𐴙𐴕 𐴓𐴡𐴦𐴘𐴢 𐴈𐴡𐴁𐴡𐴌 𐴒𐴗𐴝𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴎𐴞𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴔𐴟𐴑𐴡𐴃𐴧𐴟 𐴐𐴞𐴥𐴓𐴢 𐴓𐴝𐴕 𐴓𐴝𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴝 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴀𐴙𐴓𐴢, <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴝𐴐𐴢 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡𐴥 𐴉𐴝𐴦. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴓𐴎𐴡𐴥𐴓𐴡𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴝𐴏𐴞𐴔𐴁𐴞𐴃𐴢 𐴏𐴡𐴏𐴡𐴙𐴑𐴧𐴝 𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴝𐴤 𐴊𐴟𐴖𐴝𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴦𐴌𐴠 𐴔𐴝𐴃𐴝𐴥 𐴇𐴠𐴥𐴔𐴧𐴞𐴑𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴕𐴊𐴝𐴖𐴝𐴤𐴌𐴠 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴑𐴞𐴘𐴝𐴥 𐴃𐴟𐴖𐴡𐴀𐴌؟ <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴍𐴠𐴥 𐴕𐴝𐴥𐴘, 𐴀𐴞𐴥𐴁𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴔𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴙𐴓𐴢. <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴝𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.“ <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴧𐴟 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴒𐴝𐴌𐴡 𐴎𐴡𐴕 𐴕𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴑𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞, 𐴅𐴡𐴀𐴝𐴕𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴔𐴝𐴦 𐴔𐴡𐴌𐴞𐴘𐴝𐴔; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴌𐴡𐴤 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴓𐴄𐴟𐴉𐴝𐴥𐴓𐴄𐴟 𐴈𐴡𐴃𐴝𐴤𐴌 𐴋𐴡𐴥𐴙𐴓𐴢 𐴓𐴝𐴙𐴒𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴕𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />𐴓𐴠𐴑𐴞𐴕 𐴉𐴞𐴃𐴡𐴌 𐴀𐴟𐴍𐴞𐴤 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴢 𐴊𐴟𐴣𐴌𐴊𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴘𐴟𐴥𐴌𐴞 𐴏𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴡𐴇𐴡𐴥𐴕𐴡𐴌 𐴇𐴡𐴦𐴌 𐴒𐴟𐴥𐴕 𐴁𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴠𐴥 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴊𐴠𐴑𐴞𐴥 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘, 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="LUK 24:12" /></para>
  <para style="s1">𐴀𐴠𐴥𐴔𐴝𐴘𐴟𐴏𐴡𐴌 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MRK 16:12-13">𐴔𐴝𐴑 16‏:12‏-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />𐴏𐴡𐴀, 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴠𐴥𐴔𐴝𐴘𐴟𐴏𐴢 𐴕𐴝𐴔𐴡𐴌 𐴉𐴝𐴌𐴝𐴃𐴢 𐴎𐴝𐴦𐴌, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴃𐴢 𐴔𐴝𐴙𐴓𐴢 𐴊𐴟𐴌𐴠𐴥. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴡𐴘 𐴀𐴠𐴎𐴧𐴡𐴕𐴠, 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴉𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴡𐴉𐴠𐴌 𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴏𐴑𐴝𐴌𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤 𐴕𐴞𐴎𐴠 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴥𐴣𐴍𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠 𐴉𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴥𐴣𐴍𐴞-𐴀𐴝𐴥𐴣𐴍𐴞 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴡𐴘 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴀𐴕 𐴑𐴞𐴘𐴡𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴉𐴡𐴀𐴌 𐴊𐴠𐴥؟“</char></para>
  <para style="p" vid="LUK 24:17">𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴝𐴑𐴔𐴟𐴑 𐴇𐴝𐴓𐴝 𐴒𐴡𐴌𐴞𐴥 𐴃𐴞𐴥𐴘𐴝𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴎𐴝𐴌 𐴕𐴝𐴔 𐴕𐴞𐴑𐴞 𐴑𐴝𐴓𐴠𐴀𐴡𐴥𐴂𐴝𐴏𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴉𐴡𐴌𐴁𐴝𐴥𐴐𐴞 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴃𐴟𐴀𐴛 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴕𐴞𐴑𐴞 𐴀𐴠 𐴇𐴡𐴦𐴊𐴧𐴞𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴊𐴠𐴥؟“<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠𐴥؟“</char></para>
  <para style="p" vid="LUK 24:19">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴏𐴝𐴥𐴌𐴞𐴌 𐴖𐴡𐴌𐴠 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕. 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴈𐴝𐴔𐴠 𐴀𐴠𐴊𐴧𐴠 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝 𐴕𐴡𐴁𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴡𐴦𐴃𐴡𐴌 𐴏𐴝𐴥𐴣𐴎𐴝𐴓𐴧𐴝 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴐𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴠 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴝𐴙𐴅𐴧𐴝 𐴃𐴞𐴕 𐴊𐴞𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴀𐴕𐴧𐴝 𐴑𐴟𐴥𐴁𐴢 𐴏𐴡𐴥𐴀𐴌𐴠 𐴈𐴡𐴁𐴡𐴌 𐴒𐴗𐴝𐴃𐴢 𐴒𐴞𐴀𐴓𐴢, <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴓𐴝𐴐𐴢 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡𐴥 𐴉𐴝𐴦. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴘𐴧𐴠𐴥𐴒𐴝𐴘 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴦𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴁𐴡𐴌 𐴒𐴗𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴕𐴟𐴥𐴕𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴔𐴡𐴎𐴞𐴕 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴕𐴡𐴥 𐴊𐴠𐴑𐴠𐴥.“<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴁𐴠𐴑𐴟𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴃𐴡 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴀𐴘𐴒𐴞𐴘𐴠 𐴊𐴠 𐴈𐴡𐴃𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴃𐴠𐴤!</char> <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" /><char style="wj">𐴔𐴡𐴀𐴏𐴞𐴤𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴃𐴠 𐴊𐴟𐴑 𐴇𐴞𐴥𐴀𐴕 𐴉𐴝𐴦𐴌 𐴑𐴞 𐴎𐴡𐴌𐴟𐴌 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓؟“</char> <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴟𐴀𐴏𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴌𐴞𐴥, 𐴉𐴟𐴌𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴟𐴎𐴝𐴥𐴘𐴊𐴞𐴘𐴠.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴉𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴝𐴥𐴇𐴝𐴣𐴏𐴞 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠 𐴌𐴝𐴥𐴌; 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴊𐴟𐴌𐴠𐴥 𐴎𐴝𐴦𐴌 𐴉𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴘𐴎𐴡𐴒𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴌𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴊𐴞𐴕 𐴉𐴟𐴥𐴌𐴝𐴘𐴧𐴠𐴒𐴝𐴘.“ 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞 𐴁𐴡𐴓𐴧𐴝 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴞𐴦𐴘𐴠𐴥.<verse eid="LUK 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30" />𐴀𐴝𐴦𐴌 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴌𐴟𐴄𐴞 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴥𐴚𐴒𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑 𐴑𐴟𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴧𐴠𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴧𐴟 𐴒𐴝𐴙𐴁𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴁𐴟𐴎𐴝𐴥𐴘 𐴊𐴠𐴌, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴎𐴡𐴓𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟“<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴟𐴍𐴞𐴤 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴒𐴝𐴌𐴡 𐴎𐴡𐴕 𐴕𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥, <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑 𐴏𐴡𐴥𐴘𐴧𐴞 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠; 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠.“<verse eid="LUK 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕𐴠 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴌𐴟𐴄𐴞 𐴁𐴝𐴥𐴚𐴒𐴞𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴏𐴞𐴕𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥.<verse eid="LUK 24:35" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MAT 28:16-20">𐴔𐴡𐴃𐴢 28‏:16‏-20</ref>; <ref loc="MRK 16:14-18">𐴔𐴝𐴑 16‏:14‏-18</ref>; <ref loc="JHN 20:19-23">𐴘𐴡 20‏:19‏-23</ref>; <ref loc="ACT 1:6-8">𐴈𐴝𐴔 1‏:6‏-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤 𐴕𐴞𐴎𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴝𐴎𐴠𐴥 𐴀𐴝𐴀𐴘𐴢 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴏𐴧𐴝𐴓𐴝𐴔𐴟 𐴀𐴝𐴓𐴝𐴘𐴑𐴟𐴔.“</char><verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴦𐴌𐴠 𐴃𐴡𐴊𐴧𐴡𐴤 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴄𐴝𐴥𐴀𐴙𐴅𐴧𐴠 𐴊𐴠 𐴁𐴟𐴥𐴃𐴢 𐴊𐴠𐴑𐴠𐴥𐴌 𐴁𐴡𐴥𐴓𐴞. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴋𐴡𐴦𐴌𐴡𐴥𐴌 𐴑𐴞𐴘𐴝𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴐𐴡𐴥𐴀𐴑 𐴑𐴞𐴘𐴝𐴥 𐴀𐴝𐴘𐴧𐴠𐴤𐴌؟</char> <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴢 𐴄𐴠𐴥𐴚 𐴏𐴡𐴀, 𐴀𐴞𐴁𐴝𐴤 𐴀𐴝𐴀𐴛. 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞 𐴏𐴡𐴀, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴃𐴡 𐴒𐴟𐴏𐴧𐴡 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴥𐴣𐴋𐴧𐴞 𐴕𐴝𐴥𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴊𐴠𐴑𐴡𐴥𐴌.“</char><verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴄𐴠𐴥𐴚 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴠. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴍𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥؟“</char> <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑 𐴇𐴝𐴥𐴕𐴋𐴝 𐴏𐴞𐴥𐴛𐴝𐴃𐴢 𐴊𐴞𐴥𐴘𐴝 𐴔𐴝𐴏𐴢 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴈𐴝𐴥𐴘𐴧𐴠.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴞𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴎𐴞𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴈𐴡𐴀𐴘𐴓𐴝𐴔, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴞𐴀𐴕 𐴔𐴟𐴀𐴏𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴡𐴃𐴢, 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴞𐴃𐴝𐴁𐴢 𐴀𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴁𐴟𐴌 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴎𐴡𐴌𐴟𐴌.“</char><verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴠𐴔𐴝𐴑 𐴑𐴟𐴥𐴓𐴞𐴊𐴞𐴘𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴌𐴠. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴊𐴟𐴑 𐴉𐴝𐴘𐴁𐴡 𐴀𐴝𐴦𐴌 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘,</char> <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" /><char style="wj">𐴁𐴝𐴦𐴊𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴌𐴞𐴥 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔𐴠 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴉𐴝𐴘𐴁𐴝𐴌 𐴃𐴡𐴖𐴝𐴥𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴒𐴡𐴁𐴝𐴤.</char> <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" /><char style="wj">𐴏𐴡𐴀, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴖𐴝𐴦𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴖𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴞𐴘𐴟𐴔; 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴃𐴝𐴦𐴑𐴡𐴃𐴠 𐴁𐴡𐴥𐴌𐴞 𐴕𐴡𐴥 𐴎𐴡𐴒𐴡𐴘 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴡.“</char><verse eid="LUK 24:49" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠</para>
  <para style="r">(<ref loc="MRK 16:19-20">𐴔𐴝𐴑 16‏:19‏-20</ref>; <ref loc="ACT 1:9-11">𐴈𐴝𐴔 1‏:9‏-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝𐴌 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴢 𐴃𐴟𐴓𐴞𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴊𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴦𐴊𐴠, 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />𐴀𐴝𐴦𐴌 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴇𐴝𐴥𐴎𐴞𐴌 𐴃𐴝𐴥𐴑𐴞 𐴓𐴝𐴒𐴝𐴃𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>