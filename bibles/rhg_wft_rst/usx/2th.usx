<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">2 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 2 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc2">2 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc3">2𐴃𐴞𐴏𐴢</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">2 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 2 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 <char style="ior">(<ref loc="2TH 1:1">1‏:1</ref>)</char>. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 1 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴑𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴈𐴡𐴔 𐴄𐴝𐴙𐴔𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢-𐴀𐴠𐴑 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴡𐴃𐴢. 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴉𐴡𐴥𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴑𐴡𐴥𐴌𐴞𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴑𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢. 𐴎𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴀𐴡𐴣𐴃𐴧𐴠𐴤 𐴁𐴝𐴕𐴝𐴀𐴙𐴓𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴡𐴌 𐴈𐴝𐴔𐴡𐴃𐴢 𐴒𐴞𐴀𐴓𐴢 (<char style="xt"><ref loc="ACT 17:1-10">𐴈𐴝𐴔𐴡𐴥𐴓𐴢 17‏:1‏-10</ref></char>). 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴈𐴝𐴔𐴡𐴥𐴓𐴡𐴌 𐴎𐴞𐴑𐴞𐴥𐴌 𐴔𐴡𐴎𐴞𐴕، 𐴇𐴠𐴥 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴒𐴞𐴌𐴞𐴥𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴥𐴘 𐴁𐴝𐴕𐴝 𐴒𐴞𐴘𐴠𐴥.</para>
  <para style="ip">𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴝𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴊𐴟𐴕𐴞𐴥 𐴐𐴠𐴣𐴍𐴞𐴥𐴃𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴀𐴠 2 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴀𐴠𐴑𐴊𐴡𐴥𐴑 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠. 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥𐴃𐴢 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴀𐴞𐴏𐴝𐴌𐴁𐴞𐴏𐴝𐴌 𐴏𐴝𐴥𐴌𐴝 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴞𐴥𐴘𐴠 𐴀𐴝𐴦𐴌 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴎𐴡𐴕𐴡𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴌 𐴎𐴟𐴦 𐴕𐴞𐴎𐴠 𐴈𐴝𐴔𐴝𐴘 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 <char style="ior">(<ref loc="2TH 3:6-10">3‏:6‏-10</ref>)</char>.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 <char style="ior">(<ref loc="2TH 1:1-2">1‏:1‏-2</ref>)</char></para>
  <para style="io1">2. 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴑𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴒𐴡𐴥𐴌𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥 <char style="ior">(<ref loc="2TH 1:3-12">1‏:3‏-12</ref>)</char></para>
  <para style="io1">3. 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 <char style="ior">(<ref loc="2TH 2:1-17">2‏:1‏-17</ref>)</char></para>
  <para style="io1">4. 𐴀𐴞𐴏𐴝𐴌𐴁𐴞𐴏𐴝𐴌 𐴏𐴝𐴥𐴌𐴝 𐴒𐴡𐴥𐴌𐴞 𐴕𐴡 𐴏𐴡𐴙𐴓𐴃𐴡 𐴀𐴠𐴊𐴧𐴠 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 <char style="ior">(<ref loc="2TH 3:1-15">3‏:1‏-15</ref>)</char></para>
  <para style="io1">5. 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="2TH 3:16-18">3‏:16‏-18</ref>)</char></para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴏𐴞𐴥𐴓𐴖𐴝𐴕𐴟𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤.</para>
  <para style="p" vid="2TH 1:1">𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴑𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤.<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="2TH 1:2" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴡𐴌 𐴁𐴞𐴏𐴝𐴌</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴁𐴞𐴐𐴞𐴤 𐴁𐴝𐴌𐴠𐴥𐴌 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴎𐴠𐴃𐴡𐴥 𐴀𐴠𐴥𐴃𐴡 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴥𐴌. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴀𐴌 𐴊𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴞𐴎𐴡𐴌 𐴏𐴡𐴁𐴡𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴌𐴠 𐴄𐴞𐴑𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴡𐴥.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴡𐴥𐴑 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴁𐴡𐴓𐴞 𐴒𐴡𐴕𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴑 𐴉𐴡𐴀𐴌. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑 𐴁𐴞𐴏𐴝𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴟𐴑 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴟𐴑 𐴊𐴞𐴁𐴡, <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴟𐴑 𐴉𐴡𐴀𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴀𐴝𐴌𐴝𐴔 𐴊𐴞𐴁𐴡, 𐴀𐴡𐴣𐴃𐴧𐴠𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴕𐴞𐴎𐴡𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴞 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡, <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴡𐴃𐴧𐴟 𐴊𐴟𐴌 𐴀𐴡𐴥𐴘 𐴏𐴝𐴥𐴣𐴎𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴞 𐴊𐴡𐴥𐴚𐴐𐴡 𐴉𐴝𐴘𐴁𐴡, <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />𐴀𐴡𐴣𐴃𐴧𐴠𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴘𐴁𐴡𐴤. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴝𐴏𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴡𐴁𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴡𐴤.<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />𐴇𐴞𐴥𐴀𐴕 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴝𐴑𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴁𐴡𐴓𐴞 𐴒𐴡𐴕𐴡𐴑, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴥𐴀𐴌 𐴀𐴝𐴎𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴕𐴝𐴔𐴡𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s1">𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴙𐴕𐴧𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥: 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴊𐴞𐴕 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘 𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴁𐴟𐴊𐴧𐴞𐴥 𐴇𐴝𐴥𐴌𐴝𐴘𐴧𐴝 𐴘𐴝𐴥 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴝𐴘𐴡𐴒𐴡𐴥𐴘. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤 𐴊𐴡𐴌𐴐𐴡𐴥𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴘𐴝𐴥 𐴖𐴝𐴈𐴞𐴤 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴘𐴝𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴐𐴠𐴣𐴍𐴞𐴥 𐴉𐴝𐴘𐴧𐴠𐴥 𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴊𐴟𐴥𐴑𐴝 𐴕𐴡 𐴊𐴡𐴑. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴞𐴕 𐴘𐴞𐴥𐴁𐴝 𐴃𐴡 𐴀𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴕𐴟 𐴀𐴝𐴘𐴁𐴡𐴤 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴁𐴠𐴦𐴐𐴁𐴝𐴥𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴡𐴥𐴘 𐴕𐴡𐴥 𐴎𐴝𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴙𐴕𐴧𐴝 𐴀𐴟𐴘𐴃𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴁𐴡𐴌𐴁𐴝𐴊𐴞𐴌 𐴉𐴟𐴖𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴕𐴡𐴥. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />𐴀𐴞𐴥𐴃𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴑𐴟𐴥𐴊𐴝 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴀 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴉𐴟𐴣𐴎𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴥𐴖𐴝𐴓𐴝𐴘𐴁𐴡. 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴞 𐴁𐴡𐴀𐴘𐴧𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴘𐴝𐴦𐴊𐴢 𐴕𐴝𐴥𐴘 𐴕𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴓𐴝𐴔 𐴊𐴠𐴥؟ <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴘𐴝𐴓𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴑𐴞𐴘𐴠𐴥 𐴀𐴡𐴀𐴣𐴓𐴞 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴓𐴠𐴤 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴊𐴞𐴕𐴞𐴌 𐴒𐴟𐴉𐴡𐴕 𐴈𐴝𐴔 𐴃𐴡 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴏𐴡𐴓𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴡𐴀𐴣𐴓𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴓𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴕𐴡𐴥 𐴎𐴝. <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴇𐴠𐴥 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴙𐴕𐴧𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴎𐴝𐴌𐴠𐴥 𐴔𐴝𐴓𐴞𐴑𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴓𐴡𐴌 𐴕𐴞𐴘𐴝𐴥𐴐𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴀𐴌 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴓𐴡𐴘 𐴇𐴡𐴥𐴃𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />𐴇𐴠𐴥 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴙𐴕𐴧𐴝 𐴀𐴞𐴥𐴃𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴇𐴝𐴥𐴀𐴌 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴔𐴞𐴏𐴝𐴥 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴡, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />𐴀𐴝𐴦𐴌 𐴁𐴡𐴌𐴁𐴝𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴠𐴘𐴔𐴝𐴕𐴞 𐴓𐴡𐴘 𐴊𐴟𐴥𐴑𐴝 𐴊𐴞𐴥𐴁𐴡. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴟𐴔𐴌𐴝𐴤𐴌 𐴀𐴝𐴏𐴡𐴥𐴌 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴁𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴞𐴏𐴝𐴥 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴁𐴡𐴥𐴓𐴞 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />𐴀𐴝𐴦𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟 𐴀𐴝𐴕𐴞𐴤 𐴁𐴟𐴌𐴝𐴙𐴃𐴢 𐴀𐴝𐴘𐴝𐴐𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴏𐴝𐴥𐴣𐴎𐴝 𐴉𐴝𐴘𐴁𐴡.<verse eid="2TH 2:12" /></para>
  <para style="s1">𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴖𐴝 𐴒𐴞𐴥𐴘𐴠</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />𐴓𐴠𐴑𐴞𐴕، 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴀𐴝𐴊𐴡𐴌𐴁𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴡. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴡.<verse eid="2TH 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TH 2:15" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴟𐴑𐴠𐴥 𐴘𐴝𐴥 𐴐𐴠𐴣𐴍𐴞𐴥𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴞𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴑𐴡, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴌𐴝𐴑𐴡𐴥.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴞𐴎𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴓𐴝 𐴀𐴝𐴐𐴝𐴤 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝 𐴘𐴠, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴞𐴓𐴡𐴃𐴢 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴡𐴑, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴒𐴡𐴔 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴘 𐴁𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴡𐴥𐴗𐴑.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s1">𐴊𐴟𐴖𐴝𐴌 𐴀𐴝𐴌𐴡𐴏𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴊𐴠, 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴑𐴝𐴓𐴝𐴔 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴝𐴥𐴌𐴝 𐴉𐴡𐴥𐴓𐴞𐴎𐴝𐴒𐴡𐴘 𐴉𐴝𐴥𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴉𐴝𐴦 𐴉𐴝𐴥𐴕, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />𐴀𐴝𐴌𐴡𐴤 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞 𐴉𐴝𐴥𐴕, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴕𐴡. <verse eid="2TH 3:2" /><verse number="3" style="v" sid="2TH 3:3" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴓𐴞𐴑 𐴃𐴡 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌; 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥𐴁𐴡. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴡𐴤𐴌 𐴀𐴝𐴦𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴎𐴞𐴀𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />𐴔𐴝𐴓𐴞𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴀𐴟𐴎𐴟 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴡𐴌𐴊𐴝𐴐𐴡𐴌 𐴀𐴟𐴎𐴟 𐴓𐴡𐴘𐴎𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="2TH 3:5" /></para>
  <para style="s1">𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴕𐴞𐴎𐴠 𐴎𐴟𐴦 𐴒𐴡𐴌𐴡𐴤</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴑𐴞𐴘𐴡, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴏𐴝𐴌𐴁𐴞𐴏𐴝𐴌 𐴏𐴝𐴥𐴌𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴝𐴘𐴧𐴡𐴥 𐴊𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡 𐴏𐴡𐴓𐴠. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴡𐴔𐴟𐴕𐴝 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴝𐴌 𐴑𐴠𐴀𐴕 𐴎𐴡𐴌𐴟𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴀𐴞𐴏𐴝𐴌𐴁𐴞𐴏𐴝𐴌 𐴏𐴝𐴥𐴌𐴝 𐴒𐴡𐴥𐴌𐴞 𐴕𐴡𐴥 𐴏𐴡𐴓𐴞, <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴔𐴝𐴦𐴕𐴝 𐴈𐴝𐴥𐴕𐴝 𐴘𐴡𐴥 𐴕𐴝𐴥 𐴇𐴝𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴝𐴘𐴃𐴠 𐴊𐴞𐴕𐴠 𐴊𐴟𐴑-𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴟𐴓𐴝𐴂𐴢 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴝𐴘𐴒𐴡𐴥𐴘. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴊𐴡𐴃𐴢 𐴉𐴝𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴁𐴝𐴥𐴓𐴝 𐴕𐴡𐴔𐴟𐴕𐴝 𐴁𐴡𐴕𐴞 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴠𐴥 𐴕𐴡𐴔𐴟𐴕𐴝 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴡 𐴉𐴝𐴥𐴕. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴑𐴞, ”𐴎𐴝𐴃𐴧𐴟 𐴈𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠 𐴕𐴡 𐴈𐴡𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴈𐴝𐴥𐴕𐴝 𐴕𐴡 𐴇𐴡𐴥𐴑.“<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴟𐴥𐴕𐴞𐴌 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴏𐴝𐴌𐴁𐴞𐴏𐴝𐴌 𐴏𐴝𐴥𐴌𐴝 𐴒𐴡𐴥𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴌. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤 𐴈𐴝𐴔 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴈𐴝𐴔𐴡𐴃𐴢 𐴕𐴝𐴑 𐴒𐴡𐴥𐴓𐴝𐴘𐴊𐴠. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴝𐴔𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴝𐴥𐴔𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴈𐴝𐴔𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴕𐴞𐴎𐴠 𐴎𐴟𐴦 𐴒𐴡𐴌𐴡𐴤.<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴁𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴙𐴃𐴧𐴠𐴤-𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴀𐴡𐴥𐴌𐴝𐴕 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴡𐴥𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴡𐴥𐴘 𐴏𐴝𐴥𐴑𐴁𐴝𐴑 𐴕𐴡 𐴌𐴝𐴙𐴑𐴧𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴠 𐴐𐴡𐴥𐴌𐴡𐴔 𐴉𐴝𐴦. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />𐴃𐴡𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴊𐴟𐴐𐴧𐴡𐴕 𐴁𐴡𐴓𐴞 𐴕𐴡 𐴄𐴝𐴥𐴀𐴙𐴅𐴧𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.<verse eid="2TH 3:15" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />𐴐𐴝𐴥𐴕𐴃𐴞 𐴊𐴡𐴦𐴘𐴝 𐴔𐴝𐴓𐴞𐴑 𐴕𐴞𐴎𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴐𐴝𐴥𐴕𐴃𐴞 𐴊𐴞𐴦𐴘𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴔𐴝𐴓𐴞𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴠 𐴀𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴓𐴠𐴑𐴞𐴥𐴌. 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴐𐴠𐴣𐴍𐴞𐴥𐴌 𐴕𐴞𐴐𐴝𐴥𐴕; 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴁𐴠 𐴓𐴠𐴑𐴞𐴥.<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>