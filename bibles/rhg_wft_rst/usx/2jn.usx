<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc2">2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc3">2𐴘𐴡</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴡𐴃𐴧𐴟 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴁𐴡𐴓𐴞 𐴉𐴡𐴌𐴞𐴏𐴡 𐴕𐴡𐴥 𐴊𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 <char style="ior">(<ref loc="2JN 1:1">1‏:1</ref>)</char>. 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴓𐴠𐴑𐴝𐴥𐴌 𐴔𐴟𐴓𐴢 𐴈𐴡𐴃𐴝𐴤 𐴘𐴡𐴥 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴔𐴟𐴓𐴢 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝. 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴦𐴘𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴟𐴓𐴞𐴤𐴊𐴡𐴙𐴅𐴧𐴠. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴡𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢. <char style="ior">(<ref loc="2JN 1:5-6">1‏:5‏-6</ref>)</char>; 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 <char style="xt"><ref loc="JHN 15:9-10">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 15‏:9‏-10</ref></char>. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 1 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 3 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥.</para>
  <para style="ip">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴇𐴝𐴣𐴏𐴠. 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴑𐴡𐴥𐴕𐴡𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴇𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴠𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="2JN 1:1-3">1‏:1‏-3</ref>)</char></para>
  <para style="io1">2. 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴔𐴝𐴕 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴞𐴘𐴝 <char style="ior">(<ref loc="2JN 1:4-6">1‏:4‏-6</ref>)</char></para>
  <para style="io1">3. 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 <char style="ior">(<ref loc="2JN 1:7-11">1‏:7‏-11</ref>)</char></para>
  <para style="io1">4. 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="2JN 1:12-13">1‏:12‏-13</ref>)</char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />𐴀𐴝𐴀𐴛 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴘𐴠,</para>
  <para style="p" vid="2JN 1:1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴀𐴛 𐴏𐴡𐴥𐴘𐴧𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥. 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴎𐴝𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴘𐴡𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠 𐴀𐴝𐴦𐴌 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥 𐴁𐴝𐴉𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢, 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.<verse eid="2JN 1:3" /></para>
  <para style="s1">𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴢 𐴏𐴡𐴓𐴠𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴞, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴓𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴝𐴉𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴇𐴡𐴥𐴑𐴟𐴔 𐴉𐴝𐴘𐴧𐴞𐴥. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />𐴀𐴡𐴥 𐴀𐴞𐴎𐴧𐴡𐴃𐴊𐴝𐴥𐴌 𐴁𐴡𐴥𐴙𐴕, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴘𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴓𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴖𐴝𐴀𐴕 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴧𐴟 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴡𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴝𐴀𐴕 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴉𐴟𐴥𐴕𐴞-𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴘𐴧𐴡𐴤𐴌, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴉𐴡𐴣𐴃𐴢 𐴁𐴝𐴥𐴘 𐴏𐴡𐴓𐴡.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴃𐴡 𐴁𐴡𐴀𐴗𐴃𐴢 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴁𐴡𐴕𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴢 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴙𐴅𐴧𐴝𐴓𐴢. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴀𐴕𐴡𐴓𐴧𐴝 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴥𐴌𐴝𐴘 𐴕𐴡 𐴉𐴠𐴥𐴓𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴝𐴘𐴎𐴡. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴐𐴞𐴥𐴔𐴝𐴌 𐴁𐴝𐴀𐴌𐴠 𐴎𐴝𐴦𐴒𐴡𐴥𐴘 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝 𐴕𐴝𐴥𐴘. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴉𐴟𐴖𐴝 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴕𐴡 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴒𐴝 𐴕𐴡 𐴊𐴞𐴦𐴘𐴡𐴥 𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 𐴀𐴡𐴥 𐴕𐴡 𐴎𐴝𐴕𐴝𐴘𐴧𐴡𐴥. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔𐴡𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="2JN 1:11" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴁𐴡𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴞𐴥𐴘𐴝𐴘 𐴓𐴡𐴥𐴘 𐴓𐴠𐴑𐴞𐴥𐴃𐴡 𐴕𐴡 𐴏𐴝𐴀𐴙𐴌. 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴐𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴟𐴀𐴝𐴥𐴔𐴟𐴙𐴑𐴧𐴝 𐴀𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴟𐴥𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴟𐴥𐴐𐴞 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴡𐴥𐴙𐴕 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠, 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>