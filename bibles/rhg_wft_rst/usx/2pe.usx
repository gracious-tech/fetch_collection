<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">2 𐴉𐴞𐴃𐴡𐴌</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 2 𐴉𐴞𐴃𐴡𐴌</para>
  <para style="toc2">2 𐴉𐴞𐴃𐴡𐴌</para>
  <para style="toc3">2𐴉𐴞𐴃𐴢</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">2 𐴉𐴞𐴃𐴡𐴌</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 2 𐴉𐴞𐴃𐴡𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴉𐴞𐴃𐴡𐴌 𐴁𐴡𐴥𐴓𐴞 𐴓𐴡𐴖𐴝 𐴎𐴝. 𐴁𐴞𐴐𐴞𐴤 𐴀𐴟𐴓𐴠𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴉𐴞𐴃𐴡𐴌 𐴕𐴞𐴎𐴠 𐴘𐴝𐴀𐴕 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠. 𐴓𐴠𐴑𐴡𐴥𐴘𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴑𐴊𐴝𐴈𐴝𐴤 𐴒𐴡𐴁𐴝𐴤, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 <char style="iqt">𐴀𐴞𐴏𐴝𐴤𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴁𐴡𐴊𐴡𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘</char> 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 <char style="ior">(<ref loc="2PE 1:17-18">1‏:17‏-18</ref>)</char>. 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴎𐴡𐴊𐴞 𐴉𐴞𐴃𐴡𐴌𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴡 𐴔𐴡𐴌𐴞𐴁𐴝𐴥𐴌 𐴀𐴝𐴒𐴠 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴇𐴝𐴥𐴙𐴄𐴢-𐴉𐴝𐴣𐴏𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴙𐴄𐴢-𐴕𐴡𐴖 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕 𐴀𐴡𐴃𐴢. 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴐𐴠𐴣𐴍𐴞𐴥 𐴁𐴡𐴓𐴞 𐴈𐴡𐴘𐴧𐴠𐴥 <char style="ior">(<ref loc="2PE 3:1">3‏:1</ref>)</char> 𐴎𐴞𐴘𐴝𐴥𐴕 𐴓𐴡𐴥𐴘 𐴉𐴡𐴌𐴞𐴏𐴡 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 1 𐴉𐴞𐴃𐴡𐴌 𐴁𐴝𐴦𐴊𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴃𐴝𐴔𐴝𐴥𐴔 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥.</para>
  <para style="ip">𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴥𐴓𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴁𐴝𐴥𐴌 𐴁𐴟𐴎𐴢 𐴊𐴞𐴃𐴡 𐴀𐴠𐴊𐴧𐴠 𐴔𐴞𐴏𐴝𐴥 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴔𐴝𐴕𐴞𐴁𐴝𐴥𐴌 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴞𐴃𐴡 <char style="ior">(<ref loc="2PE 2">2</ref>)</char>. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴘𐴃𐴠𐴤 𐴊𐴠𐴌𐴞 𐴒𐴡𐴌𐴠𐴥𐴌 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴘𐴃𐴠𐴤 𐴊𐴠𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴝𐴌 𐴊𐴠, 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴎𐴠𐴕 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴡𐴗𐴑 <char style="ior">(<ref loc="2PE 3:8-9">3‏:8‏-9</ref>)</char>. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴝𐴥𐴓𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴁𐴝𐴥𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴖𐴝𐴅𐴝𐴤 <char style="ior">(<ref loc="2PE 3:14">3‏:14</ref>)</char>.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 <char style="ior">(<ref loc="2PE 1:1-2">1‏:1‏-2</ref>)</char></para>
  <para style="io1">2. 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴏𐴞𐴕𐴞𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴁𐴝𐴥𐴌 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴞𐴘𐴝 <char style="ior">(<ref loc="2PE 1:3-21">1‏:3‏-21</ref>) </char></para>
  <para style="io1">3. 𐴔𐴞𐴏𐴝𐴥 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴑𐴞𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 <char style="ior">(<ref loc="2PE 2:1-22">2‏:1‏-22</ref>) </char></para>
  <para style="io1">4. 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴊𐴞𐴕𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌𐴞 <char style="ior">(<ref loc="2PE 3:1-18">3‏:1‏-18</ref>) </char></para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />𐴀𐴝𐴀𐴛 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌, 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴒𐴟𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞.</para>
  <para style="b" vid="2PE 1:1" />
  <para style="p" vid="2PE 1:1">𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴝𐴥𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴑𐴞𐴔𐴡𐴃𐴞 𐴀𐴞𐴔𐴝𐴕 𐴉𐴝𐴘𐴧𐴠𐴥:<verse eid="2PE 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴏𐴞𐴕𐴡𐴥𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="2PE 1:2" /></para>
  <para style="s1">𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴋𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴖𐴝</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />𐴀𐴟𐴁𐴝𐴤𐴌 𐴀𐴞𐴓𐴧𐴝𐴘𐴞 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴓𐴡𐴥𐴘 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴊𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴓𐴝𐴘𐴧𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴝𐴥𐴌 𐴎𐴡𐴌𐴞𐴘𐴝. <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴑𐴞𐴔𐴡𐴃𐴞 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴖𐴝𐴦𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴓𐴧𐴝𐴘𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴡𐴌 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴡𐴘, 𐴀𐴡𐴕𐴃𐴟𐴥 𐴇𐴝𐴥𐴌𐴞 𐴎𐴠 𐴁𐴡𐴌𐴁𐴝𐴊𐴞 𐴕𐴞𐴑𐴞 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴝𐴎𐴧𐴟 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="2PE 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 1:5" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴑𐴟𐴐𐴞𐴥𐴐𐴠, 𐴕𐴞𐴎𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴢 𐴁𐴝𐴥𐴓𐴝𐴘, 𐴁𐴝𐴥𐴓𐴝𐴙𐴃𐴢 𐴒𐴞𐴘𐴝𐴕, <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />𐴒𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴢, 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴡𐴃𐴢 𐴏𐴡𐴁𐴡𐴥𐴌, 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴃𐴢 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞, <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞𐴃𐴢 𐴁𐴝𐴥𐴘𐴧𐴝𐴓𐴞 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴓𐴞 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞𐴃𐴢 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴁𐴝𐴌𐴡𐴥. <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴀𐴕 𐴃𐴝𐴥𐴑𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴌𐴠𐴥𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴏𐴞𐴕𐴝𐴥𐴃𐴢 𐴁𐴠𐴇𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴉𐴡𐴥𐴎𐴟𐴓𐴢 𐴀𐴡𐴥𐴘𐴃𐴡 𐴕𐴡 𐴊𐴞𐴁𐴡. <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴀𐴕 𐴕𐴝𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴊𐴟𐴌𐴠𐴥 𐴕𐴡 𐴊𐴠𐴑𐴠𐴥, 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴊𐴝𐴤, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴒𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴡𐴀𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕,<note caller="+" style="f"><char style="fr" closed="false">1‏:10 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴟𐴕𐴞𐴥 𐴒𐴟𐴥𐴕 𐴒𐴡𐴥𐴓𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴃𐴎𐴞𐴥𐴘𐴝𐴙𐴕.</char></note> 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴝𐴑𐴧𐴝𐴒𐴡𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴌𐴡𐴤 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴀𐴟𐴅𐴝𐴥𐴄𐴢 𐴕𐴡 𐴈𐴝𐴥𐴘𐴁𐴝, <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴓𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴠𐴊𐴧𐴠 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴀𐴞𐴎𐴧𐴡𐴃𐴠 𐴒𐴡𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴞𐴘𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴎𐴝𐴙𐴕𐴧𐴝 𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴠 𐴉𐴝𐴘𐴧𐴡𐴥 𐴊𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴄𐴞𐴑𐴞 𐴀𐴝𐴏𐴡𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡. <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />𐴀𐴝𐴀𐴛 𐴘𐴝𐴀𐴕 𐴄𐴞𐴥𐴑 𐴁𐴡𐴥𐴓𐴞 𐴁𐴝𐴥𐴉𐴞 𐴊𐴠 𐴑𐴞, 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴀𐴝𐴀𐴛 𐴀𐴠 𐴄𐴝𐴔𐴁𐴟𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴇𐴝𐴘𐴧𐴝𐴘𐴠 𐴀𐴝𐴏𐴞𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴞 𐴉𐴡𐴄𐴉𐴡𐴙𐴄𐴧𐴝 𐴒𐴡𐴌𐴡𐴤𐴕, <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞, 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠 𐴄𐴝𐴔𐴁𐴟 𐴀𐴠𐴌𐴞 𐴎𐴝𐴦𐴒𐴡𐴥𐴘 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴘𐴡𐴥 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴠𐴥. <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />𐴀𐴝𐴀𐴛 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠𐴕𐴃𐴠𐴇𐴝𐴓𐴡𐴌 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴘𐴝𐴦𐴊𐴢 𐴌𐴝𐴑𐴞𐴥 𐴉𐴝𐴌𐴡.<verse eid="2PE 1:15" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴐𐴝𐴥𐴀𐴕𐴡𐴌 𐴏𐴟𐴑𐴊𐴝𐴈𐴝𐴤 𐴒𐴡𐴁𐴝𐴤</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴞𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴏𐴝𐴓𐴝𐴥𐴑𐴞 𐴒𐴡𐴌𐴞 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴑𐴝𐴇𐴝𐴥𐴕𐴞 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴀𐴕𐴡𐴌 𐴏𐴟𐴑𐴊𐴝𐴈𐴝𐴤 𐴒𐴡𐴁𐴝𐴤. <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴀𐴡𐴣𐴃𐴧𐴠𐴤 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴉𐴝𐴘𐴧𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴠𐴥 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝-𐴖𐴝𐴓𐴝𐴃𐴧𐴟 𐴀𐴠 𐴀𐴝𐴁𐴝𐴏𐴢 𐴏𐴗𐴝𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, ”𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴖𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞.“ <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥 𐴀𐴝𐴁𐴝𐴏𐴢 𐴘𐴞𐴥𐴁𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴠𐴁𐴝𐴎𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴂𐴝𐴑 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠.<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴀𐴘𐴢 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴈𐴡𐴃𐴝𐴤 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴀𐴕𐴠 𐴀𐴝𐴌𐴡𐴤 𐴉𐴝𐴑𐴧𐴝 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴏𐴟𐴑 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴠𐴌𐴝𐴑𐴡𐴌 𐴉𐴡𐴀𐴌𐴡𐴌 𐴀𐴟𐴎𐴟 𐴃𐴝𐴥𐴑𐴠, 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴠𐴃𐴟𐴥𐴕 𐴉𐴡𐴥𐴎𐴡𐴌 𐴕𐴡𐴥 𐴉𐴝𐴥𐴍𐴠 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴏𐴟𐴥𐴃𐴢-𐴃𐴝𐴌𐴝 𐴕𐴡𐴥 𐴀𐴟𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴊𐴞𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴥𐴓𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝. <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴒𐴠 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴞𐴓𐴡 𐴊𐴠 𐴑𐴞, 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴂𐴡𐴘𐴒𐴝𐴔 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴁𐴟𐴎𐴝𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡. <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴂𐴡𐴘𐴒𐴝𐴔 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴏𐴡𐴓𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴔𐴡𐴎𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s1">𐴔𐴞𐴏𐴝𐴥 𐴕𐴡𐴁𐴞 𐴀𐴠𐴊𐴧𐴠 𐴔𐴞𐴏𐴝𐴥 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴑𐴡𐴗𐴔𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴘𐴡𐴥 𐴔𐴞𐴏𐴝𐴥 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴟𐴂𐴧𐴠-𐴏𐴟𐴂𐴧𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴁𐴡 𐴎𐴞𐴀𐴕𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴑𐴞𐴕𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠 𐴊𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴄𐴝𐴃𐴢 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴝𐴕𐴞𐴤𐴁𐴡. <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴠𐴌𐴠𐴙𐴅𐴧𐴝 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴡𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴌𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴡𐴌𐴞𐴑𐴝𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴝𐴓𐴡𐴥𐴏𐴠 𐴁𐴝𐴕𐴝𐴖𐴡𐴃𐴞 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡𐴀𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴓𐴞𐴤𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴀𐴝𐴘𐴃𐴠𐴤 𐴊𐴠𐴌𐴞 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴡𐴌𐴁𐴝𐴊𐴞 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴕𐴡.<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴕𐴡𐴥 𐴊𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴎𐴟𐴎𐴟𐴑𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞 𐴀𐴝𐴣𐴊𐴝𐴤𐴌 𐴒𐴝𐴣𐴃𐴡𐴃𐴢 𐴁𐴝𐴣𐴊𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴁𐴞𐴏𐴝𐴌𐴡𐴌 𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴁𐴡𐴕 𐴃𐴝𐴥𐴑𐴞 𐴁𐴡𐴓𐴧𐴝. <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴟𐴌𐴝𐴕𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴁𐴝𐴊𐴢 𐴕𐴡𐴥 𐴊𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴃𐴟𐴖𐴝𐴥𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴕𐴟𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴇𐴝𐴥𐴣𐴃𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴈𐴠𐴥𐴕𐴃𐴟 𐴁𐴝𐴏𐴝𐴀𐴙𐴓𐴢. <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴡𐴥𐴊𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴔𐴡𐴥𐴌𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌𐴠 𐴉𐴟𐴌𐴞 𐴏𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴁𐴡𐴌𐴁𐴝𐴊𐴞𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴝𐴘𐴧𐴠; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥; <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴓𐴟𐴀𐴃𐴡𐴌𐴠 𐴁𐴝𐴏𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴙𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴕𐴝𐴉𐴝𐴑 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴡𐴌 𐴎𐴝𐴓𐴝𐴕𐴞𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴠𐴐𐴡𐴌𐴝𐴥 𐴈𐴝𐴔 𐴎𐴞𐴀𐴕 𐴊𐴠𐴑𐴞𐴥𐴃𐴡 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴥𐴕𐴞𐴃𐴡 𐴇𐴞𐴥𐴀𐴕𐴠 𐴊𐴞𐴕𐴁𐴡𐴊𐴞𐴕 𐴕𐴞𐴎𐴡𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴌𐴟𐴀𐴃𐴢 𐴃𐴡𐴎𐴞𐴘𐴝 𐴉𐴝𐴘𐴃𐴡. <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴔𐴝𐴁𐴟𐴊𐴠 𐴃𐴡 𐴊𐴞𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘𐴓𐴡𐴘 𐴎𐴝𐴕𐴠 𐴀𐴝𐴦𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴝𐴥𐴣𐴎𐴝𐴓𐴧𐴝 𐴁𐴞𐴏𐴝𐴌𐴡𐴌 𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴌𐴝𐴑𐴞𐴥 𐴎𐴝𐴕𐴠, <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴞 𐴕𐴝𐴉𐴝𐴑 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴌𐴠 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥.</para>
  <para style="p" vid="2PE 2:10">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴒𐴡𐴊𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴣𐴅𐴧𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴞 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴟𐴌𐴝-𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴘𐴃𐴠𐴤 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝. <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴡𐴓𐴟𐴖𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴇𐴞𐴥𐴀𐴕𐴠 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴊𐴞𐴃𐴠 𐴁𐴟𐴌𐴝-𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴈𐴡𐴀. <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />𐴓𐴠𐴑𐴞𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴕𐴡 𐴎𐴝𐴕𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴠 𐴁𐴟𐴌𐴝-𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴀. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴑𐴧𐴡𐴥𐴓𐴢 𐴏𐴝𐴥𐴌𐴝 𐴅𐴝𐴕𐴟𐴖𐴝𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴃𐴠 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴊𐴡𐴥𐴌𐴝 𐴇𐴝𐴥𐴘 𐴔𐴡𐴌𐴞 𐴁𐴡𐴓𐴧𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴅𐴡𐴚𐴒𐴡𐴓𐴞 𐴅𐴝𐴕𐴟𐴖𐴝𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />𐴀𐴝𐴦𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴁𐴟𐴌𐴝𐴙𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴁𐴟𐴌𐴝𐴘 𐴉𐴝𐴘𐴁𐴡. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴊𐴞𐴕𐴡𐴃𐴢 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴘𐴝𐴐𐴞 𐴒𐴡𐴌𐴡𐴤𐴕. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴠 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴘𐴝𐴐𐴞 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴊𐴕𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴥𐴌𐴡𐴔 𐴀𐴝𐴕𐴠𐴤. <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑 𐴎𐴠𐴕𐴝𐴤𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥 𐴇𐴡𐴕𐴡𐴤 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴡𐴕 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴡𐴔𐴎𐴟𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴓𐴝𐴓𐴡𐴥𐴏𐴠 𐴑𐴟𐴖𐴝𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴊𐴞𐴓𐴢 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴓𐴝𐴀𐴕𐴡𐴃𐴞! <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴌𐴝𐴏𐴃𐴝 𐴀𐴠𐴌𐴞𐴊𐴞 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴌𐴝𐴏𐴃𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴡𐴥𐴘; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴘𐴡𐴌𐴡𐴌 𐴉𐴟𐴖𐴝 𐴁𐴝𐴓𐴝𐴔𐴡𐴌 𐴉𐴡𐴣𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴊𐴠, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴝𐴥𐴌𐴝𐴔𐴞 𐴈𐴝𐴔𐴝𐴕𐴞𐴌 𐴀𐴝𐴐𐴞𐴤𐴑 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞𐴓𐴧𐴝 𐴁𐴡𐴥𐴄𐴁𐴡𐴍𐴝𐴥𐴕 𐴈𐴝𐴥𐴀𐴙𐴓𐴢: 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴟𐴒𐴝 𐴒𐴝𐴊𐴝𐴤𐴘𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴘𐴢 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴦𐴓𐴝𐴙𐴃𐴢 𐴁𐴝𐴎𐴝𐴥 𐴊𐴞𐴥𐴓𐴢.<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴟𐴥𐴖𐴝𐴕𐴝 𐴑𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴖𐴝𐴥𐴕𐴠 𐴀𐴟𐴌𐴝𐴘 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘 𐴊𐴠 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴀𐴠𐴁𐴧𐴠 𐴒𐴟𐴄𐴒𐴟𐴙𐴄𐴧𐴝 𐴀𐴝𐴣𐴊𐴝𐴤𐴌 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴘𐴠. <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡 𐴊𐴠 𐴈𐴡𐴃𐴝𐴤𐴌 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴉𐴢 𐴔𐴝𐴌𐴞, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴀𐴝𐴎𐴧𐴟 𐴔𐴡𐴎𐴞𐴕 𐴁𐴡𐴊𐴔𐴝𐴐𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴟𐴏𐴑𐴝𐴘𐴊𐴞 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴏𐴡𐴓𐴠 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴧𐴠𐴥𐴌 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤. <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴀𐴝𐴎𐴝𐴊𐴞𐴌 𐴖𐴝𐴦𐴊𐴝 𐴊𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴠 𐴁𐴡𐴌𐴁𐴝𐴊𐴞𐴌 𐴒𐴟𐴓𐴝𐴔 𐴁𐴡𐴕𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴝𐴌𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴠𐴊𐴧𐴠 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴏𐴞𐴕𐴞𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴝𐴉𐴝𐴑𐴞𐴃𐴧𐴟 𐴁𐴝𐴏𐴞 𐴀𐴝𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴁𐴝𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴞𐴏𐴡𐴥𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴒𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴌𐴝𐴏𐴃𐴝 𐴏𐴞𐴕𐴞𐴥, 𐴀𐴡 𐴂𐴝𐴑 𐴇𐴡𐴥𐴑𐴟𐴔 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴧𐴟 𐴉𐴞𐴏𐴧𐴝𐴥 𐴎𐴝𐴦𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴇𐴠𐴥 𐴌𐴝𐴏𐴃𐴝 𐴕𐴡 𐴏𐴞𐴕𐴝𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴌𐴡𐴤 𐴁𐴠𐴀𐴃𐴡𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴠 𐴀𐴠 𐴁𐴡𐴏𐴡𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴊𐴝𐴈𐴝𐴤, ”𐴑𐴟𐴣𐴘𐴌𐴠 𐴎𐴞𐴀𐴕 𐴀𐴡𐴦𐴓𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴎𐴝𐴦“ 𐴀𐴝𐴦𐴌, ”𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴝 𐴐𐴟𐴥𐴖𐴡𐴌 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴉𐴟𐴥𐴣𐴍𐴡𐴃𐴢 𐴋𐴠𐴌𐴝𐴥𐴉𐴢 𐴉𐴡𐴙𐴃𐴧𐴡 𐴎𐴝𐴦.“<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s1">𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴖𐴝𐴦𐴊𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝𐴌 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴥 𐴐𐴠𐴣𐴍𐴞𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴝𐴥𐴉𐴢 𐴊𐴞𐴓𐴡𐴌𐴠 𐴓𐴝𐴌𐴞𐴊𐴞𐴘𐴞𐴥, <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴂𐴝𐴑 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴈𐴡𐴀𐴘𐴒𐴞𐴘𐴠 𐴀𐴝𐴦𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴠𐴊𐴧𐴠 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝𐴌 𐴎𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴘𐴝𐴦𐴊𐴢 𐴌𐴝𐴑𐴡𐴥.<verse eid="2PE 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 3:3" />𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴒𐴠 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴞𐴓𐴡 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴄𐴝𐴥𐴃𐴄𐴝𐴘𐴁𐴝𐴎𐴞-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴄𐴝𐴥𐴃𐴄𐴝𐴘𐴁𐴝𐴎𐴞 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴝𐴎𐴧𐴟𐴘𐴠 𐴏𐴡𐴓𐴞𐴁𐴡𐴥. <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴖𐴝𐴦𐴊𐴝 𐴇𐴡𐴍𐴠𐴥 𐴒𐴞𐴦𐴘𐴡𐴥𐴘؟ 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴝𐴊𐴝-𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴡𐴦𐴃𐴡𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴌𐴞 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴓𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.“ <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴎𐴞𐴥𐴏𐴞𐴕𐴃𐴞 𐴉𐴡𐴀𐴌𐴝𐴘𐴉𐴠𐴓𐴠 𐴊𐴠 𐴑𐴞, 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴝𐴒𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔𐴠 𐴀𐴝𐴏𐴔𐴝𐴕 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴎𐴡𐴁𐴞𐴕𐴡𐴌𐴠 𐴉𐴝𐴕𐴞𐴥𐴃𐴧𐴟 𐴁𐴝𐴕𐴝𐴘 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴑𐴝𐴦𐴘𐴠𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />𐴎𐴠 𐴉𐴝𐴕𐴞𐴥𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴇𐴠𐴥 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴃𐴟𐴖𐴝𐴥𐴕 𐴀𐴝𐴕𐴞𐴤 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴀𐴓𐴢. <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />𐴇𐴠𐴥 𐴀𐴠𐴑𐴞𐴤 𐴑𐴝𐴓𐴝𐴔𐴠 𐴁𐴠 𐴘𐴝𐴓𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴌𐴠 𐴀𐴡𐴦𐴙𐴕 𐴓𐴡𐴘 𐴎𐴡𐴓𐴝𐴘 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴘𐴠. 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑𐴝𐴤 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠, 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴌𐴁𐴝𐴊𐴞𐴌 𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡.<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴉𐴡𐴀𐴌𐴝𐴘 𐴕𐴡 𐴉𐴠𐴓𐴝𐴘𐴧𐴡 𐴊𐴠 𐴑𐴞, 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴀𐴠𐴑 𐴊𐴞𐴕 𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴕 𐴀𐴝𐴦𐴌 𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴠𐴑 𐴊𐴞𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴕. <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴝𐴦𐴊𐴝 𐴉𐴟𐴌𐴝 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴊𐴠𐴌𐴞 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴞𐴘𐴠𐴥-𐴑𐴞𐴘𐴠𐴥 𐴊𐴠𐴌𐴞 𐴒𐴡𐴌𐴠𐴥 𐴁𐴡𐴓𐴞 𐴁𐴝𐴥𐴉𐴠; 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴁𐴡𐴥𐴌 𐴒𐴡𐴌𐴞𐴥 𐴃𐴝𐴥𐴙𐴑𐴧𐴠 𐴊𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴎𐴧𐴡𐴕 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴡 𐴏𐴝𐴀, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴝𐴀 𐴊𐴠, 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴎𐴠𐴕 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠.<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />𐴓𐴠𐴑𐴞𐴕 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴊𐴞𐴕 𐴏𐴟𐴌 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴁𐴠 𐴀𐴝𐴘𐴁𐴡𐴤. 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴟𐴎𐴡𐴌𐴠 𐴀𐴡𐴉𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴏𐴝𐴕, 𐴁𐴠𐴙𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴠𐴎𐴢 𐴀𐴡𐴦𐴘𐴕𐴠 𐴔𐴞𐴓𐴝𐴘 𐴎𐴝𐴘𐴁𐴡𐴘; 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴓𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘.<verse eid="2PE 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 3:11" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴕𐴝𐴐𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴕 𐴏𐴝𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴂𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴞, <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴞𐴕 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴘𐴞𐴥𐴁𐴝 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴕𐴝𐴤𐴘𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴡𐴃𐴢 𐴀𐴡𐴥𐴕 𐴏𐴝𐴥. 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴃𐴡 𐴀𐴝𐴏𐴔𐴝𐴕 𐴉𐴟𐴌𐴞 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴏𐴝𐴕, 𐴁𐴠𐴙𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴠𐴎𐴢 𐴀𐴡𐴦𐴘𐴕𐴠 𐴔𐴞𐴓𐴝𐴘 𐴎𐴝𐴘𐴁𐴡𐴘. <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴝𐴦𐴊𐴝 𐴔𐴡𐴎𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡𐴘𐴝 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴘𐴝 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴞𐴤, 𐴎𐴠𐴍𐴠𐴥 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠.<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴡𐴤, 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴊𐴝𐴑 𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴓𐴡𐴦𐴃𐴉𐴝. <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />𐴄𐴝𐴥𐴀𐴌𐴞𐴁𐴝 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴏𐴡𐴁𐴡𐴥𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴠𐴅𐴝𐴃𐴡𐴌 𐴔𐴡𐴑𐴝; 𐴎𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴁𐴝𐴥𐴘 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴘𐴡𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴝𐴕 𐴔𐴡𐴎𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴠𐴣𐴍𐴞𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴢 𐴀𐴡𐴥 𐴀𐴞𐴀𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, 𐴎𐴞𐴀𐴕𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴀𐴕 𐴁𐴟𐴎𐴞𐴥𐴃𐴠 𐴔𐴡𐴐𐴑𐴞𐴓𐴢. 𐴃𐴝𐴦𐴓𐴞𐴔 𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴑𐴞 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴊𐴡𐴓𐴠 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴁𐴡𐴊𐴡𐴓𐴞𐴉𐴠𐴥𐴓𐴝𐴘, 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴁𐴡𐴌𐴁𐴝𐴊𐴞 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥.<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴎𐴝𐴕𐴡 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴑𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴡𐴓𐴧𐴡𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴌𐴝𐴏𐴃𐴝𐴃𐴢 𐴕𐴡 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴎𐴝𐴒𐴝𐴃𐴧𐴟 𐴓𐴡𐴌𐴞 𐴕𐴡 𐴎𐴡𐴒𐴡𐴥𐴘; <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴠𐴊𐴧𐴠 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴝𐴥𐴃𐴢 𐴎𐴠𐴃𐴡𐴥 𐴀𐴠𐴥𐴃𐴡 𐴁𐴝𐴌𐴡𐴥. 𐴘𐴝𐴓𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>