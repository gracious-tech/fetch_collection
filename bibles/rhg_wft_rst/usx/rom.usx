<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴌𐴡𐴔𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴌𐴡𐴔𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc2">𐴌𐴡𐴔𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc3">𐴌𐴡𐴔</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴌𐴡𐴔𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="imt">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴌𐴡𐴔𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="ip">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴌𐴡𐴔𐴞𐴀𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢. 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢-𐴏𐴝𐴙𐴌𐴡𐴃𐴧𐴟 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢-𐴀𐴝𐴣𐴐𐴄𐴡 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴇𐴠𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴧𐴠. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴑𐴡𐴥𐴌𐴞𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠, 𐴈𐴠𐴥𐴕𐴃𐴟 𐴃𐴝𐴥𐴘 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴖𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴁𐴡𐴕𐴠 <char style="ior">(<ref loc="ROM 16:26">16‏:26</ref>)</char>.</para>
  <para style="ip">𐴀𐴠 𐴌𐴡𐴔𐴞𐴀𐴡𐴥𐴓𐴢 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴇𐴝𐴥𐴀𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴊𐴡𐴌𐴇𐴝𐴌𐴞 𐴏𐴞𐴥𐴘𐴝𐴌𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴞𐴁𐴝𐴤𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴉𐴝𐴦 𐴎𐴝 𐴊𐴠 𐴕𐴠𐴅𐴝𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴁𐴞𐴐𐴞𐴤 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴌𐴟𐴏𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴞 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴓𐴡𐴥𐴘 𐴉𐴟𐴌𐴝𐴕𐴝 𐴕𐴞𐴘𐴡𐴔 𐴓𐴡𐴘 𐴎𐴟𐴌𐴝𐴊𐴞𐴘𐴠𐴥. 𐴁𐴞𐴐𐴞𐴤 𐴀𐴟𐴓𐴠𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴀 𐴊𐴠, 𐴉𐴟𐴌𐴝 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴊𐴡𐴌𐴇𐴝𐴌𐴞 𐴀𐴝𐴘𐴝𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 1:16, 𐴎𐴠𐴍𐴠𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, ”𐴀𐴝𐴀𐴛 𐴃𐴡 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴓𐴡𐴥𐴘 𐴕𐴡 𐴐𐴡𐴥𐴌𐴔𐴝𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴡𐴤𐴘𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢, 𐴀𐴝𐴒𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌𐴠 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴌𐴠.“ 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴇𐴞𐴥𐴏𐴧𐴝 <char style="ior">(<ref loc="ROM 1-12">1‏—12</ref>)</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴞𐴓𐴧𐴝𐴘𐴡𐴃𐴞 𐴀𐴠𐴓𐴡𐴥𐴔 𐴓𐴡𐴥𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝, 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴏𐴧𐴝 <char style="ior">(<ref loc="ROM 13-15">13‏—15</ref>)</char> 𐴀𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴁𐴝𐴥𐴌 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴔𐴡𐴥𐴓𐴞 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴏𐴧𐴝 <char style="ior">(<ref loc="ROM 16">16</ref>)</char> 𐴀𐴡𐴃𐴢 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴠.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 <char style="ior">(<ref loc="ROM 1:1-15">1‏:1‏-15</ref>)</char></para>
  <para style="io1">2. 𐴀𐴞𐴕𐴏𐴝𐴥𐴕-𐴎𐴝𐴃𐴞𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴞𐴘𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴉𐴝𐴦 𐴎𐴝 𐴊𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 <char style="ior">(<ref loc="ROM 1:16-11:36">1‏:16‏—11‏:36</ref>)</char></para>
  <para style="io1">3. 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴁𐴝𐴥𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴞 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 <char style="ior">(<ref loc="ROM 12-15">12‏—15</ref>)</char></para>
  <para style="io1">4. 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴝 <char style="ior">(<ref loc="ROM 16">16</ref>)</char></para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="s1">𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴒𐴟𐴓𐴝𐴔, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴋𐴝𐴑𐴝 𐴒𐴞𐴘𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴡𐴓𐴧𐴝 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴖𐴝 𐴒𐴞𐴥𐴘𐴠, <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />𐴎𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴖𐴝𐴦𐴊𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴕𐴞𐴎𐴡𐴌 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />𐴇𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴇𐴠𐴥 𐴌𐴟𐴥𐴖𐴝𐴃𐴠 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴀𐴙𐴓𐴢, <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />𐴀𐴝𐴦𐴌 𐴂𐴝𐴑𐴞𐴌 𐴌𐴟𐴀𐴌 𐴇𐴠𐴥 𐴌𐴟𐴥𐴖𐴝𐴃𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠 𐴊𐴝𐴈𐴝𐴤 𐴒𐴞𐴥𐴘𐴠. 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑, <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />𐴎𐴞𐴁𐴝𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴒𐴞𐴌𐴞 𐴉𐴝𐴘𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌𐴞𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴕𐴞𐴤; <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴋𐴝𐴑𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴝𐴏𐴡𐴤.<verse eid="ROM 1:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴝𐴊𐴡𐴌𐴁𐴡𐴕 𐴀𐴝𐴏𐴡𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌:</para>
  <para style="b" vid="ROM 1:7" />
  <para style="p" vid="ROM 1:7">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="ROM 1:7" /></para>
  <para style="s1">𐴌𐴡𐴔𐴡𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴌 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴝𐴎𐴧𐴟</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴒𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴌. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />𐴎𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴀𐴛 𐴉𐴟𐴌𐴝 𐴊𐴞𐴓𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴁𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴁𐴝𐴊𐴢 𐴏𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴡𐴌𐴠 <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />𐴊𐴟𐴖𐴝𐴃𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴔𐴝𐴒𐴞 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴏𐴝𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴎𐴠𐴕 𐴀𐴠𐴁𐴝𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴓𐴠 𐴇𐴡𐴕𐴡𐴤 𐴁𐴡𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴌𐴝𐴏𐴃𐴝 𐴉𐴝𐴘. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴃𐴡 𐴑𐴟𐴥𐴁𐴢 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴀𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴊𐴞𐴦 𐴉𐴝𐴌𐴞, 𐴎𐴞𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡; <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />𐴘𐴝𐴥𐴕𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴅𐴡𐴏𐴁𐴝 𐴊𐴞 𐴉𐴝𐴙𐴅𐴧𐴟𐴔.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴙𐴓𐴧𐴝𐴔. 𐴀𐴝𐴀𐴛 𐴀𐴝𐴘𐴃𐴡𐴤 𐴏𐴝𐴀𐴘𐴓𐴝𐴔 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴡𐴥𐴓𐴉𐴡𐴓𐴝 𐴉𐴝𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴉𐴝𐴘𐴧𐴞𐴥.<verse eid="ROM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴞𐴌𐴞𐴥𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴒𐴝𐴛𐴘𐴝 𐴀𐴡𐴥𐴑, 𐴀𐴠𐴓𐴡𐴥𐴔𐴊𐴝𐴌 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴁𐴠-𐴀𐴠𐴓𐴡𐴥𐴔𐴊𐴝𐴌 𐴀𐴡𐴥𐴑. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴌𐴡𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴡𐴤, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴡𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴎𐴧𐴟 𐴀𐴝𐴏𐴠𐴤.<verse eid="ROM 1:15" /></para>
  <para style="s1">𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />𐴀𐴝𐴀𐴛 𐴃𐴡 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴓𐴡𐴘 𐴕𐴡 𐴐𐴡𐴥𐴌𐴔𐴝𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴡𐴤𐴘𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢, 𐴀𐴝𐴒𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌𐴠 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴌𐴠. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴃𐴢 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴡 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴔𐴝𐴕𐴠 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴌𐴞𐴁𐴡𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, ”𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴔𐴝𐴕𐴠 𐴁𐴠 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">1‏:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAB 2:4">𐴇𐴝𐴥𐴁𐴝𐴑𐴧𐴟𐴑 2‏:4</ref></char> </char></note><verse eid="ROM 1:17" /></para>
  <para style="s1">𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴥𐴀𐴌 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴈𐴝𐴔𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴑𐴟𐴈𐴝𐴔 𐴓𐴡𐴥𐴘 𐴎𐴝𐴥𐴉𐴝𐴘 𐴌𐴝𐴑𐴠𐴥, <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴞𐴀𐴕 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴝 𐴎𐴝 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴏𐴝𐴥𐴉𐴢 𐴎𐴝𐴇𐴠𐴥𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴏𐴝𐴥𐴉𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴝 𐴕𐴡 𐴎𐴝 𐴊𐴠 𐴏𐴞𐴉𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝𐴌, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴊𐴝𐴘𐴞 𐴌𐴠; 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴡𐴥𐴃𐴢 𐴉𐴝𐴦 𐴎𐴝, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴁𐴝𐴇𐴝𐴤𐴕𐴝 𐴕𐴝𐴥𐴘. <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴎𐴝𐴕𐴞 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥 𐴀𐴝𐴦𐴌 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴘𐴡𐴥 𐴕𐴡𐴥 𐴎𐴝𐴕𐴝, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞 𐴁𐴠𐴇𐴝𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴡𐴁𐴟𐴎𐴢 𐴊𐴞𐴓𐴢 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴠 𐴁𐴡𐴥𐴌𐴞𐴒𐴞𐴘𐴡𐴘. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴞𐴘𐴝𐴕𐴞 𐴁𐴡𐴓𐴞 𐴊𐴝𐴁𐴞 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴘𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴑𐴟𐴉𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴝𐴥𐴕𐴝 𐴕𐴡 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴁𐴝𐴊𐴢 𐴊𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴟𐴃𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴣𐴎𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴎𐴞𐴀𐴕 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴊𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴀𐴡𐴌, 𐴉𐴝𐴙𐴑 𐴀𐴡𐴌, 𐴏𐴝𐴙𐴌-𐴄𐴠𐴥𐴙𐴚𐴒𐴝 𐴅𐴝𐴕𐴟𐴖𐴝𐴌𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴑𐴠 𐴀𐴝𐴥𐴣𐴍𐴠 𐴊𐴠 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴠 𐴁𐴝𐴕𐴝𐴘𐴧𐴝.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴌 𐴀𐴝𐴎𐴧𐴟𐴌 𐴕𐴝𐴉𐴝𐴑 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴌𐴞𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴓𐴡𐴥𐴘 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴐𐴡𐴥𐴌𐴔𐴡𐴌 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴞𐴏𐴝𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴥𐴣𐴏𐴝𐴌𐴠 𐴁𐴝𐴊𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴘𐴊𐴝-𐴒𐴡𐴌𐴡𐴤𐴘𐴝𐴌𐴠 𐴕𐴡 𐴀𐴡𐴥𐴘 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑𐴡𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴡𐴘𐴊𐴝-𐴒𐴡𐴌𐴡𐴤𐴘𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡! 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴐𐴡𐴥𐴌𐴡𐴔𐴞 𐴈𐴝𐴔𐴡𐴌 𐴀𐴝𐴎𐴧𐴟𐴃𐴢 𐴀𐴠𐴌𐴞𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴊𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴞𐴓𐴔𐴞𐴓𐴝𐴁𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴀𐴟𐴓𐴋𐴝𐴃𐴢 𐴁𐴡𐴊𐴡𐴓𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴁𐴠𐴍𐴝𐴀𐴙𐴕 𐴊𐴠 𐴘𐴡𐴥 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴓𐴡𐴥𐴘 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴞𐴓𐴔𐴞𐴓𐴝𐴁𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴊𐴢 𐴊𐴞, 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕 𐴓𐴡𐴘 𐴐𐴡𐴥𐴌𐴔𐴡𐴌 𐴈𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴉𐴡𐴦𐴓𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴘𐴝𐴥𐴕𐴞 𐴁𐴠𐴍𐴝𐴀𐴙𐴕 𐴊𐴠 𐴁𐴠𐴍𐴝𐴀𐴙𐴕 𐴓𐴡𐴥𐴘 𐴐𐴡𐴥𐴌𐴔𐴡𐴌 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴈𐴝𐴔𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴎𐴡𐴌𐴞𐴁𐴝𐴕𐴝 𐴀𐴝𐴕𐴠𐴤.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />𐴀𐴝𐴌𐴡𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴌𐴝𐴑𐴞𐴥𐴃𐴡 𐴕𐴡𐴥 𐴏𐴝𐴀, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴡𐴕 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴌𐴞𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴝𐴔 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴠𐴥 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴡𐴤𐴕 𐴄𐴞𐴥𐴑 𐴕𐴡; <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴈𐴝𐴔, 𐴁𐴟𐴌𐴝𐴘, 𐴓𐴝𐴓𐴡𐴥𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴏𐴡𐴌𐴡𐴃𐴢, 𐴑𐴟𐴥𐴕, 𐴇𐴡𐴙𐴅𐴧𐴝, 𐴉𐴠𐴥𐴌𐴡𐴑𐴁𐴝𐴎𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴐𐴧𐴡𐴕𐴞𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴠 𐴁𐴡𐴥𐴌𐴝𐴘𐴧𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴞𐴉𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />𐴁𐴡𐴊𐴕𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴘𐴝, 𐴁𐴞𐴘𐴝𐴊𐴡𐴉𐴢, 𐴀𐴝𐴕𐴝𐴍𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴇𐴡𐴥𐴌 𐴀𐴡𐴓𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴈𐴝𐴔𐴡𐴌 𐴌𐴝𐴏𐴃𐴝 𐴑𐴟𐴥𐴓𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢; <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴁𐴟𐴎𐴢, 𐴁𐴠𐴘𐴔𐴝𐴕, 𐴎𐴝𐴦𐴓𐴠𐴔, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴌𐴝𐴇𐴝𐴥𐴔; <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴎𐴝𐴕𐴠, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴔 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴡𐴦𐴃𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴢 𐴀𐴡𐴥 𐴊𐴠.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑 𐴁𐴞𐴏𐴝𐴌</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴔𐴡𐴕𐴞𐴐𐴧𐴡𐴥, 𐴃𐴟𐴘 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴊𐴡𐴥𐴌𐴡𐴏𐴢, 𐴃𐴡𐴌𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴁𐴝𐴇𐴝𐴤𐴕𐴝 𐴕𐴝𐴥𐴘; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴘 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴊𐴡𐴥𐴌𐴡𐴏𐴢, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴃𐴟𐴘 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴊𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴏𐴢. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴞, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴖𐴡𐴌𐴠 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴠𐴥. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />𐴓𐴠𐴑𐴞𐴕، 𐴀𐴡𐴥 𐴔𐴡𐴕𐴞𐴐𐴧𐴡𐴥, 𐴃𐴟𐴘 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠𐴑𐴞𐴤 𐴈𐴝𐴔 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴎𐴞𐴀𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴡𐴥𐴌𐴡𐴏𐴢, 𐴃𐴟𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴝𐴥𐴣𐴎𐴝𐴃𐴧𐴟 𐴇𐴝𐴥𐴌𐴞 𐴎𐴝𐴁𐴞𐴒𐴡𐴘 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴡𐴏𐴢 𐴕𐴞𐴥𐴑𐴞؟ <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴃𐴟𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴃𐴞 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞, 𐴁𐴡𐴌𐴊𐴝𐴐𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌𐴠 𐴀𐴡𐴒𐴧𐴝𐴌𐴝𐴥𐴅𐴧𐴝 𐴒𐴡𐴌𐴡𐴤𐴌 𐴊𐴠𐴥؟ 𐴃𐴟𐴘 𐴎𐴝𐴕𐴡𐴏𐴢 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴡𐴌𐴠𐴥 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴝𐴥𐴌 𐴀𐴟𐴎𐴟 𐴓𐴡𐴘𐴎𐴡𐴕 𐴊𐴠𐴥؟<verse eid="ROM 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴌 𐴊𐴞𐴓𐴢 𐴃𐴡 𐴊𐴡𐴌𐴡𐴤, 𐴃𐴡𐴌𐴃𐴧𐴟 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴊𐴞𐴓𐴢 𐴕𐴝𐴥𐴘; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴃𐴟𐴘 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴡𐴤𐴌, 𐴀𐴡 𐴊𐴞𐴕𐴡𐴓𐴧𐴝 𐴎𐴠 𐴊𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑 𐴁𐴞𐴏𐴝𐴌 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴁𐴡𐴊𐴡𐴓𐴝 𐴊𐴞𐴁𐴡:<note caller="+" style="f"><char style="fr" closed="false">2‏:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 62:12">𐴎𐴡𐴁𐴟𐴌 62‏:12</ref></char>; <char style="xt"><ref loc="PRO 24:12">𐴔𐴠𐴀𐴏𐴝𐴓𐴢 24‏:12</ref></char></char></note> <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴔𐴡𐴈𐴞𐴥𐴔𐴝, 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 <note caller="+" style="f"><char style="fr" closed="false">2‏:7 </char><char style="ft" closed="false">𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 </char></note>𐴉𐴝𐴥𐴕𐴝 𐴕𐴡 𐴀𐴡𐴥 𐴊𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘𐴁𐴝𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴞𐴦𐴁𐴡; <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴖𐴝 𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴕𐴡 𐴔𐴝𐴕𐴠 𐴁𐴡𐴥𐴓𐴑𐴠 𐴑𐴟𐴈𐴝𐴔𐴡𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴌𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴀𐴕𐴡𐴃𐴢 𐴕𐴝𐴎𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />𐴑𐴟𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴝𐴒𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴖𐴡𐴌𐴠 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴖𐴡𐴌𐴠; <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴎𐴡𐴕𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝, 𐴀𐴞𐴎𐴧𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴉𐴝𐴘𐴁𐴡, 𐴀𐴝𐴒𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴠 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴘𐴠. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴠𐴑𐴃𐴡𐴌𐴉𐴞𐴥𐴘𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />𐴎𐴠𐴊𐴟𐴥𐴕𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴕𐴡 𐴉𐴝𐴘 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴘𐴡𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴊𐴟𐴥𐴕𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴉𐴝𐴘 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴓𐴡𐴥𐴘 𐴁𐴠 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡; <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴃𐴡 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴉𐴟𐴥𐴕𐴠 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴠 𐴈𐴝𐴔 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴠𐴥 𐴎𐴞𐴀𐴕 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴘𐴡 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴕𐴞𐴎𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴐𐴡𐴌𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴓𐴡𐴔𐴠 𐴘𐴡𐴥 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴘𐴠 𐴃𐴝𐴥𐴘𐴃𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴠 𐴀𐴝𐴦𐴌 𐴃𐴝𐴥𐴘𐴃𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴡𐴥𐴉𐴝𐴘 𐴊𐴠. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />𐴇𐴞𐴥𐴀𐴕 𐴀𐴡 𐴊𐴞𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴎𐴠 𐴊𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴝𐴥𐴃𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴒𐴟𐴉𐴡𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴇𐴠𐴥 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.<verse eid="ROM 2:16" /></para>
  <para style="s1">𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴃𐴟𐴘 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴈𐴡𐴀𐴏𐴢, 𐴀𐴝𐴦𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴥𐴀𐴏𐴢 𐴁𐴡𐴕𐴊𐴝 𐴁𐴡𐴓𐴞 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴘 𐴒𐴡𐴌𐴡𐴤𐴏𐴢; <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />𐴃𐴟𐴘 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴧𐴟 𐴃𐴝𐴦𐴓𐴞𐴔 𐴉𐴝𐴘𐴧𐴡𐴥𐴏𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴎𐴝𐴕𐴡𐴏𐴢, 𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴁𐴝𐴏𐴞𐴥 𐴎𐴝𐴕𐴡𐴏𐴢; <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />𐴃𐴟𐴘 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴄𐴝𐴥𐴀𐴌𐴡𐴏𐴢 𐴊𐴠, 𐴃𐴟𐴘 𐴀𐴡𐴥𐴘𐴓𐴞𐴊𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴡𐴣𐴃𐴢 𐴊𐴝𐴈𐴡𐴥𐴘𐴝, 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴡𐴀𐴌, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />𐴉𐴡𐴦𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴃𐴡𐴌𐴁𐴞𐴘𐴡𐴃𐴊𐴡𐴘𐴝, 𐴀𐴝𐴦𐴌 𐴕𐴝𐴁𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴟𐴏𐴃𐴝𐴃𐴢; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴡𐴌 𐴁𐴝𐴥𐴉𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴏𐴠𐴤. <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠, 𐴃𐴟𐴘 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴐𐴞𐴥𐴑𐴧𐴝 𐴊𐴡𐴥𐴏𐴢, 𐴃𐴟𐴘 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴐𐴞𐴥𐴑𐴧𐴝 𐴊𐴡𐴥𐴏𐴢 𐴕𐴠𐴥؟ 𐴃𐴟𐴘 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴏𐴟𐴌𐴞 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴈𐴡𐴀𐴘𐴢 𐴖𐴝𐴀𐴎𐴢 𐴒𐴡𐴌𐴡𐴤𐴏𐴢, 𐴃𐴟𐴘 𐴇𐴡𐴥𐴕𐴡 𐴏𐴟𐴌𐴞 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴕𐴠𐴥؟ <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />𐴃𐴟𐴘 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴠𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴈𐴡𐴀𐴏𐴢, 𐴃𐴟𐴘 𐴇𐴡𐴥𐴕𐴡 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴕𐴠𐴥؟ 𐴃𐴟𐴘 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴟𐴃𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴏𐴢, 𐴃𐴟𐴘 𐴇𐴡𐴥𐴕𐴡 𐴔𐴡𐴕𐴊𐴞𐴌𐴡𐴃𐴧𐴟 𐴏𐴟𐴌𐴞 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴕𐴠𐴥؟ <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />𐴃𐴟𐴘 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴓𐴡𐴥𐴘 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴡𐴤𐴏𐴢, 𐴃𐴟𐴘 𐴇𐴡𐴥𐴕𐴡 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴁𐴝𐴥𐴚𐴒𐴞 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴕𐴠𐴥؟ <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴊𐴠𐴑𐴞𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴝𐴔𐴡𐴌 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴠𐴥𐴌.“<note caller="+" style="f"><char style="fr" closed="false">2‏:24 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 52:5">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 52‏:5</ref></char>; <char style="xt"><ref loc="EZK 36:20">𐴘𐴠𐴇𐴠𐴥𐴎𐴑𐴠𐴓𐴢 36‏:20</ref>‏,<ref loc="EZK 36:22">22</ref></char></char></note><verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴁𐴠𐴐𐴡𐴥𐴑 𐴃𐴡𐴌 𐴀𐴝𐴥𐴎𐴡𐴔𐴞𐴌 𐴑𐴞𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴡𐴊𐴞 𐴃𐴟𐴘 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴡𐴤𐴏𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴃𐴟𐴘 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴁𐴝𐴥𐴚𐴒𐴡𐴘𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴃𐴡𐴌 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴝𐴥 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴉𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴊𐴝𐴁𐴞-𐴊𐴝𐴖𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴑𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴁𐴡𐴥𐴓𐴞 𐴕𐴡 𐴒𐴡𐴕𐴞𐴁𐴡𐴥 𐴕𐴠𐴥؟ <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴁𐴝𐴥𐴚𐴒𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴃𐴢 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴃𐴡 𐴀𐴟𐴘𐴃𐴠 𐴕𐴡 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴑𐴟𐴥𐴖𐴝𐴓𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴃𐴡 𐴖𐴝𐴀𐴕 𐴕𐴡 𐴎𐴞𐴘𐴝𐴥𐴕 𐴅𐴞𐴏𐴞𐴥𐴔 𐴈𐴝𐴍𐴞 𐴁𐴝𐴀𐴃𐴧𐴟 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴊𐴞𐴓𐴡𐴃𐴧𐴟 𐴘𐴡𐴇𐴟𐴥𐴊𐴞; 𐴀𐴝𐴦𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴖𐴝𐴀𐴕 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴊𐴞𐴓𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝, 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴕𐴡. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴉𐴝𐴦 𐴊𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="s1">𐴀𐴝𐴓𐴧𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴥𐴑𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />𐴇𐴠𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴑𐴞𐴦 𐴉𐴝𐴥𐴘𐴊𐴝 𐴀𐴝𐴏𐴠𐴤؟ 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴝𐴥𐴌 𐴑𐴞𐴦 𐴑𐴞𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤؟ <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴇𐴝𐴥𐴀𐴌 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴉𐴝𐴥𐴘𐴊𐴝 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴒𐴡𐴌 𐴒𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴕𐴝𐴎𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="ROM 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 3:3" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴁𐴠𐴘𐴔𐴝𐴕𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠؟ 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴘𐴔𐴝𐴕𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴁𐴡𐴥𐴓𐴞 𐴑𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴘𐴡𐴥 𐴁𐴠𐴘𐴔𐴝𐴕𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴕𐴠𐴥؟ <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡! 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴔𐴞𐴏𐴝𐴥 𐴄𐴡𐴥𐴀𐴌𐴞𐴓𐴠 𐴘𐴡, 𐴀𐴝𐴓𐴧𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴄𐴡𐴥𐴀𐴌𐴝𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="ROM 3:4">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴡𐴃𐴝𐴤𐴘𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴃𐴟𐴀𐴛 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴥𐴑𐴡,</para>
  <para style="q2" vid="ROM 3:4">𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴠𐴓𐴎𐴝𐴔 𐴓𐴝𐴒𐴝 𐴎𐴝 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴃𐴟𐴀𐴛 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴧𐴡𐴤.“<note caller="+" style="f"><char style="fr" closed="false">3‏:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 51:4">𐴎𐴡𐴁𐴟𐴌 51‏:4</ref></char></char></note><verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴟𐴈𐴝𐴔𐴠 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑 𐴁𐴞𐴏𐴝𐴌 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴦 𐴈𐴡𐴘𐴃𐴝𐴥𐴔؟ 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴝𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞 𐴕𐴡 𐴀𐴡𐴥𐴌 𐴕𐴠؟ 𐴁𐴠𐴐𐴡𐴥𐴑 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴎𐴡𐴌𐴞𐴘𐴝. <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡! 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴞𐴏𐴝𐴌 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟ <verse eid="ROM 3:6" /><verse number="7" style="v" sid="ROM 3:7" />𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴁𐴡𐴤, ”𐴀𐴝𐴣𐴀𐴌 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤𐴘𐴠 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴧𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴑𐴞𐴘𐴝𐴥 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴠𐴥؟“ <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴥 𐴈𐴡𐴘𐴁𐴡𐴤, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴈𐴡𐴀𐴘𐴢 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴀𐴘𐴢 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴟𐴌𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴒𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴃𐴡𐴥 𐴁𐴟𐴌𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠 𐴇𐴠𐴥𐴃𐴡 𐴒𐴡𐴔.“ 𐴇𐴠𐴥 𐴁𐴡𐴊𐴕𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴏𐴝𐴥𐴣𐴎𐴝 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴉𐴝𐴘 𐴎𐴝𐴘𐴁𐴡.<verse eid="ROM 3:8" /></para>
  <para style="s1">𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴑𐴞𐴘𐴠𐴥 𐴕𐴝𐴥𐴘</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴦 𐴈𐴡𐴘𐴃𐴝𐴥𐴔؟ 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴑𐴞𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴠𐴀𐴃𐴡𐴌؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡; 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴀𐴝𐴒𐴠 𐴘𐴡𐴥 𐴈𐴡𐴀𐴘𐴓𐴝𐴔, 𐴃𐴝𐴔𐴝𐴥𐴔 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴟𐴕𐴝𐴤𐴌 𐴑𐴡𐴁𐴎𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="ROM 3:10">”𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴝𐴥𐴘, 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴝𐴥𐴘;<verse eid="ROM 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11" />𐴁𐴟𐴎𐴢 𐴀𐴡𐴓𐴝 𐴑𐴞𐴘𐴠𐴥 𐴕𐴝𐴥𐴘,</para>
  <para style="q2" vid="ROM 3:11">𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴧𐴟 𐴓𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘,</para>
  <para style="q2" vid="ROM 3:12">𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴑𐴧𐴟 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴞𐴒𐴞𐴍𐴞𐴒𐴞𐴘𐴡𐴘;</para>
  <para style="q1" vid="ROM 3:12">𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴝𐴥𐴘,</para>
  <para style="q2" vid="ROM 3:12">𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴝𐴥𐴘.“<note caller="+" style="f"><char style="fr" closed="false">3‏:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 14:1-3">𐴎𐴡𐴁𐴟𐴌 14‏:1‏-3</ref>; <ref loc="PSA 53:1-3">53‏:1‏-3</ref>; <ref loc="ECC 7:20">𐴒𐴞𐴘𐴝𐴕𐴡𐴌-𐴀𐴟𐴏𐴃𐴝𐴃𐴢 7‏:20</ref></char></char></note><verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />”𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴑 𐴉𐴡𐴦𐴣𐴏𐴝 𐴓𐴝𐴐𐴡𐴌 𐴑𐴟𐴥𐴓𐴝 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝;</para>
  <para style="q2" vid="ROM 3:13">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴞𐴌𐴠 𐴉𐴠𐴥𐴌𐴡𐴑𐴁𐴝𐴎𐴞 𐴒𐴡𐴌𐴠𐴥,“<note caller="+" style="f"><char style="fr" closed="false">3‏:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 5:9">𐴎𐴡𐴁𐴟𐴌 5‏:9</ref></char></char></note></para>
  <para style="q1" vid="ROM 3:13">”𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴟𐴣𐴄𐴡𐴃𐴢 𐴇𐴝𐴥𐴉𐴡𐴌 𐴁𐴞𐴐𐴢 𐴀𐴝𐴏𐴠𐴤.“<note caller="+" style="f"><char style="fr" closed="false">3‏:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 140:3">𐴎𐴡𐴁𐴟𐴌 140‏:3</ref></char></char></note><verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />”𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴑 𐴒𐴡𐴎𐴧𐴡𐴁𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴔𐴞𐴍𐴝𐴤 𐴕𐴝𐴥𐴘.“<note caller="+" style="f"><char style="fr" closed="false">3‏:14 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 10:7">𐴎𐴡𐴁𐴟𐴌 10‏:7</ref></char></char></note><verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />”𐴑𐴟𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴣𐴌𐴞 𐴎𐴝𐴦;<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴦 𐴇𐴠𐴥𐴍𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />𐴐𐴝𐴥𐴕𐴃𐴞 𐴒𐴡𐴥𐴌𐴞 𐴃𐴝𐴥𐴑𐴝𐴌 𐴌𐴝𐴏𐴃𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥.“<note caller="+" style="f"><char style="fr" closed="false">3‏:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 59:7">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 59‏:7</ref>‏,<ref loc="ISA 59:8">8</ref></char></char></note><verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />”𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴋𐴡𐴦𐴌 𐴕𐴝𐴥𐴘.“<note caller="+" style="f"><char style="fr" closed="false">3‏:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 36:1">𐴎𐴡𐴁𐴟𐴌 36‏:1</ref></char></char></note><verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴠 𐴎𐴞𐴀𐴕 𐴈𐴡𐴀 𐴇𐴞𐴥𐴀𐴕 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴁𐴠 𐴈𐴡𐴀 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴠𐴤; 𐴎𐴠𐴀𐴕𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴥𐴏𐴝𐴉𐴑𐴞𐴃𐴝𐴁𐴢 𐴊𐴞𐴘𐴝 𐴉𐴡𐴌𐴠, <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴕𐴡 𐴄𐴡𐴥𐴀𐴌𐴞𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴃𐴡 𐴒𐴟𐴕𐴝𐴤𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴘𐴧𐴠𐴤.<verse eid="ROM 3:20" /></para>
  <para style="s1">𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴌𐴝𐴏𐴃𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴌𐴝𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴀𐴡𐴥 𐴎𐴞𐴑𐴞𐴥𐴌 𐴀𐴝𐴏𐴠𐴤. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />𐴌𐴝𐴏𐴃𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥; 𐴌𐴝𐴏𐴃𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴇𐴡𐴕𐴡𐴤 𐴉𐴡𐴌𐴡𐴥𐴑 𐴕𐴝𐴥𐴘, <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴡 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴃𐴧𐴟 𐴔𐴝𐴀𐴌𐴟𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴝𐴎𐴝𐴊𐴞𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴓𐴡𐴖𐴢 𐴁𐴝𐴥𐴐𐴝 𐴁𐴝𐴥𐴘 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴡𐴉𐴧𐴝𐴌𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴓𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴔𐴝𐴉𐴢 𐴉𐴝𐴦 𐴎𐴝. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴠 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴣𐴃𐴧𐴠𐴤 𐴘𐴡𐴥 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴖𐴝𐴓𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴠 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴏𐴝𐴥𐴣𐴎𐴝 𐴕𐴡 𐴊𐴞 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴐𐴡𐴥𐴀𐴘𐴢-𐴐𐴡𐴥𐴀𐴘𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴖𐴝𐴓𐴝, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴞𐴦 𐴀𐴝𐴏𐴠𐴤؟ 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘. 𐴇𐴡𐴕 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴕𐴝𐴥𐴘 𐴊𐴠؟ 𐴀𐴝𐴔𐴡𐴥𐴓𐴡𐴌 𐴕𐴠𐴥؟ 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴡𐴥𐴌𐴞 𐴊𐴠 𐴑𐴞, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴠 𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴠, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴀𐴝𐴔𐴡𐴥𐴓𐴠 𐴕𐴡. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴓𐴧𐴝 𐴑𐴞 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴓𐴧𐴝؟ 𐴀𐴞𐴥𐴁𐴝 𐴑𐴞𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴡𐴥 𐴀𐴝𐴓𐴧𐴝 𐴕𐴡؟ 𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴞𐴥𐴁𐴝 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴡𐴥 𐴀𐴝𐴓𐴧𐴝, <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝 𐴃𐴡 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴊𐴠 𐴘𐴡𐴥 𐴀𐴞𐴔𐴝𐴕𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴊𐴠 𐴘𐴡𐴥 𐴀𐴞𐴔𐴝𐴕𐴠. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴑𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌𐴠 𐴁𐴝𐴦𐴃𐴠𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴌؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡! 𐴁𐴡𐴥𐴓𐴑𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴎𐴝𐴌𐴞 𐴌𐴝𐴑𐴞𐴥 𐴊𐴠.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s1">𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />𐴇𐴠𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴠 𐴁𐴝𐴉𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴠𐴥 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴞𐴦 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴀𐴙𐴓𐴢 𐴈𐴡𐴘𐴃𐴝𐴥𐴔؟ <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌𐴠 𐴎𐴡𐴊𐴞 𐴀𐴝𐴔𐴡𐴥𐴓𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴕𐴡. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴑𐴞𐴦 𐴀𐴝𐴏𐴠𐴤؟ 𐴘𐴝𐴀𐴕, ”𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴕𐴝 𐴒𐴞𐴀𐴓𐴢.“<note caller="+" style="f"><char style="fr" closed="false">4‏:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:6">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 15‏:6</ref></char>; 𐴀𐴠𐴊𐴧𐴠 22 𐴀𐴝𐴘𐴝𐴃𐴢 </char></note><verse eid="ROM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4" />𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴃𐴡𐴓𐴡𐴉𐴡𐴌𐴠 𐴃𐴡 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴁𐴡𐴥𐴓𐴞 𐴊𐴡𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴡𐴥𐴑 𐴁𐴡𐴥𐴓𐴞 𐴊𐴡𐴥𐴌𐴝 𐴎𐴝. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴔𐴡𐴥𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴀𐴟𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴒𐴡𐴌𐴠𐴥 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴇𐴠𐴥 𐴀𐴞𐴔𐴝𐴕𐴠 𐴁𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴕𐴝 𐴎𐴝, <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴝𐴖𐴟𐴊𐴠 𐴘𐴡𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴁𐴝𐴤 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴁𐴡𐴓𐴞 𐴈𐴡𐴘𐴧𐴠𐴥 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴏𐴝𐴥𐴌𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴕𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠,<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />”𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤</para>
  <para style="q2" vid="ROM 4:7">𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠,</para>
  <para style="q2" vid="ROM 4:7">𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴒𐴟𐴕𐴝𐴤 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠.<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴁𐴝𐴤,</para>
  <para style="q2" vid="ROM 4:8">𐴎𐴞𐴁𐴝𐴤𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴁𐴟𐴊𐴠 𐴇𐴞𐴥𐴏𐴝𐴉𐴢 𐴕𐴡 𐴌𐴝𐴑𐴞𐴥𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">4‏:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 32:1">𐴎𐴡𐴁𐴟𐴌 32‏:1</ref>‏,<ref loc="PSA 32:2">2</ref></char></char></note><verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />𐴀𐴠𐴍𐴠𐴥 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴥 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝؟ 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴀𐴝𐴒𐴡𐴙𐴅𐴧𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴘𐴡𐴥؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴝𐴘𐴧𐴞𐴥, ”𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕𐴠 𐴁𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴕𐴝 𐴒𐴞𐴀𐴓𐴢.“ <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴒𐴡𐴕𐴝 𐴒𐴞𐴀𐴓𐴢 𐴊𐴠𐴥؟ 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠؟ 𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />𐴉𐴡𐴌𐴠𐴎𐴝𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢; 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴠𐴥 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴀𐴝𐴒𐴡𐴙𐴅𐴧𐴝𐴤 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴡𐴥𐴃𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴞𐴔𐴝𐴕𐴠 𐴁𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴕𐴝 𐴒𐴞𐴀𐴓𐴢. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴝𐴉𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴀𐴝𐴒𐴡𐴙𐴅𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴡𐴤𐴕𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴕𐴝 𐴎𐴝. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴀𐴡𐴥 𐴁𐴝𐴉𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴔𐴝𐴕𐴠 𐴘𐴡𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴃𐴧𐴟 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="ROM 4:12" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴝𐴦𐴊𐴝 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴉𐴝𐴦 𐴎𐴝</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌𐴠 𐴎𐴠 𐴖𐴝𐴦𐴊𐴝 𐴊𐴞𐴀𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴠 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴘𐴁𐴡 𐴈𐴡𐴀𐴘𐴢, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴔𐴝𐴕𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴞 𐴁𐴠 𐴉𐴝𐴘𐴧𐴠𐴥. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴔𐴞𐴌𐴝𐴏𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴞𐴔𐴝𐴕 𐴁𐴠𐴉𐴡𐴥𐴎𐴟𐴓𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴖𐴝𐴦𐴊𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴞𐴔𐴡𐴃𐴢 𐴕𐴝𐴥𐴘; <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴠 𐴃𐴡 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴕𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴍𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴕𐴝𐴥𐴘, 𐴇𐴠𐴥𐴍𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴁𐴝𐴥𐴣𐴒𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴘𐴡𐴥 𐴕𐴝𐴥𐴘.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴇𐴠𐴥 𐴔𐴞𐴌𐴝𐴏𐴢 𐴀𐴞𐴔𐴝𐴕𐴠 𐴁𐴠 𐴉𐴝𐴦 𐴎𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴀𐴡𐴥 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴖𐴝𐴦𐴊𐴝 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴕𐴡𐴏𐴡𐴥𐴓𐴠 𐴉𐴝𐴘𐴁𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴝𐴑𐴧𐴝 𐴀𐴡𐴥; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴘𐴡𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴝𐴉𐴢, <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, ”𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴡𐴗𐴔𐴡𐴌 𐴁𐴝𐴉𐴢 𐴁𐴝𐴕𐴝𐴘𐴧𐴞𐴥.“<note caller="+" style="f"><char style="fr" closed="false">4‏:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 17:5">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 17‏:5</ref></char></char></note> 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴎𐴞𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴔𐴡𐴌𐴝𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴠 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥.<verse eid="ROM 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18" />𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴐𐴝𐴤 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴘𐴡 𐴀𐴝𐴐𐴝𐴤𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴞𐴔𐴝𐴕 𐴄𐴞𐴑𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴡𐴗𐴔𐴡𐴌 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴑𐴞, ”𐴃𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴥𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">4‏:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:5">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 15‏:5</ref></char></char></note> <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴁𐴟𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴝𐴦𐴌 𐴏𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴉𐴟𐴖𐴝 𐴎𐴡𐴌𐴔𐴡 𐴊𐴞 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴌 𐴕𐴝𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴑𐴡𐴔𐴎𐴟𐴌 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴝𐴦𐴊𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴐𐴡𐴥𐴑-𐴐𐴟𐴁𐴝𐴤 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴌𐴡𐴤 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴠𐴑𐴞𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴖𐴝𐴦𐴊𐴝 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴥 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴕𐴝 𐴒𐴞𐴀𐴓𐴢. <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />”𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴕𐴝 𐴒𐴞𐴀𐴓𐴢“ 𐴈𐴡𐴀 𐴊𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴓𐴧𐴝 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴕𐴡, <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴘𐴡𐴥. 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴊𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴕𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴀𐴟𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴠 𐴁𐴠 𐴔𐴡𐴦𐴃𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s1">𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴝𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴓𐴧𐴝 𐴓𐴧𐴡𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴐𐴝𐴥𐴕𐴃𐴞𐴃𐴢 𐴀𐴝𐴏𐴞𐴤. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴝𐴓𐴝 𐴎𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴞𐴤 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴠 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴐𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴌. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴘𐴡𐴥 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥, <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />𐴁𐴡𐴌𐴊𐴝𐴐𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴊𐴡𐴃𐴢 𐴁𐴝𐴕𐴝, 𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴊𐴡𐴃𐴠 𐴀𐴝𐴐𐴝𐴤 𐴀𐴝𐴕𐴠𐴤. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />𐴇𐴠𐴥 𐴀𐴝𐴐𐴝𐴤𐴘𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴁𐴝𐴏𐴝𐴘𐴁𐴝𐴥𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴡𐴑𐴃𐴡𐴥 𐴔𐴡𐴎𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴎𐴝𐴕 𐴊𐴞𐴘𐴠𐴥. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />𐴎𐴠𐴦 𐴃𐴠𐴦 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴃𐴡 𐴕𐴡 𐴏𐴝𐴀, 𐴃𐴡𐴀 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴝𐴥𐴓𐴝𐴘-𐴒𐴡𐴌𐴡𐴤𐴘𐴝𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴃𐴡 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴉𐴝𐴌𐴠. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴀𐴕 𐴒𐴡𐴌𐴞𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴎𐴝𐴕 𐴊𐴞𐴘𐴠𐴥.<verse eid="ROM 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴞𐴘𐴟𐴤𐴔. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴀𐴝𐴒𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴖𐴝𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴕𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴕𐴡𐴃𐴢 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴞𐴁𐴡𐴕𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴧𐴟𐴔. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴑𐴟𐴥𐴐𐴞 𐴘𐴡𐴥 𐴒𐴡𐴌𐴞𐴥, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝 𐴓𐴧𐴡𐴘 𐴁𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠.<verse eid="ROM 5:11" /></para>
  <para style="s1">𐴀𐴝𐴊𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴀𐴏𐴞𐴤</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />𐴒𐴟𐴕𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴠𐴑𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴁𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴔𐴡𐴦𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴉𐴟𐴌𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕-𐴎𐴝𐴃𐴞𐴌 𐴖𐴡𐴌𐴠 𐴉𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴊𐴞𐴦𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴒𐴟𐴕𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴍𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴕𐴝𐴥𐴘 𐴇𐴠𐴥𐴍𐴠 𐴒𐴟𐴕𐴝𐴤 𐴁𐴡𐴥𐴓𐴞 𐴊𐴡𐴥𐴌𐴝 𐴘𐴡𐴥 𐴕𐴝𐴥𐴘. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />𐴃𐴡𐴀 𐴔𐴡𐴦𐴃𐴠 𐴀𐴝𐴊𐴡𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴔𐴟𐴀𐴏𐴝 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴝𐴊𐴡𐴔𐴡𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡. 𐴀𐴝𐴊𐴡𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴞𐴐𐴝𐴥𐴌𐴝.<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />𐴓𐴠𐴑𐴞𐴕 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴇𐴠𐴥 𐴈𐴡𐴏𐴟𐴥𐴌𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴑𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴔𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴡 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴣𐴀𐴌, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴌 𐴀𐴠𐴑𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴥𐴊𐴞𐴘𐴝𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴌 𐴕𐴡𐴃𐴞𐴎𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴑 𐴌𐴟𐴖𐴝𐴃𐴠 𐴇𐴠𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴈𐴡𐴏𐴟𐴥𐴌𐴞𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴁𐴡𐴓𐴞 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴎𐴝𐴌𐴞 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴌𐴀𐴠𐴑 𐴌𐴟𐴖𐴝𐴃𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴈𐴡𐴏𐴟𐴥𐴌𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴎𐴠 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴝. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />𐴀𐴠𐴑𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴔𐴡𐴦𐴃𐴠 𐴇𐴠𐴥 𐴀𐴠𐴑𐴎𐴡𐴕𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴃𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴄𐴝𐴓𐴞𐴑𐴧𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴞𐴥 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴙𐴅𐴧𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴔𐴝𐴎𐴠 𐴀𐴟𐴁𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴈𐴡𐴏𐴟𐴥𐴌𐴞𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴉𐴟𐴌𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕-𐴎𐴝𐴃𐴞 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴙𐴅𐴧𐴠, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴟𐴌𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕-𐴎𐴝𐴃𐴞𐴓𐴧𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴙𐴅𐴧𐴠, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑𐴎𐴡𐴕𐴡𐴌 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴇𐴠𐴥 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴁𐴠 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴍𐴠𐴥 𐴒𐴟𐴕𐴝𐴤 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴡 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />𐴎𐴠𐴀𐴕𐴠 𐴒𐴟𐴕𐴝𐴤𐴘𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴦𐴃𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴘𐴡𐴥 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴈𐴝𐴔 𐴓𐴡𐴘 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴦 𐴁𐴝𐴘 𐴁𐴡𐴓𐴧𐴝.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s1">𐴒𐴟𐴕𐴝𐴤𐴃𐴧𐴟 𐴔𐴡𐴌𐴝, 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴦 𐴈𐴡𐴘𐴃𐴝𐴥𐴔؟ 𐴀𐴝𐴣𐴀𐴌𐴝 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴝𐴔 𐴕𐴠𐴥 𐴎𐴠𐴀𐴕𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴥؟ <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴒𐴟𐴕𐴝𐴤𐴃𐴧𐴟 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘, 𐴃𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴀𐴝𐴌 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴧𐴟𐴥𐴔؟ <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴕𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴊𐴟𐴥𐴕𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴀𐴠𐴑 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴧𐴞𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴠𐴥 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘 𐴊𐴠𐴥؟ <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴘𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴕𐴡𐴘𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴡𐴌𐴞𐴘𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴀𐴠𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴞𐴒𐴡𐴘 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝 𐴓𐴡𐴥𐴘 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴀𐴠𐴑 𐴀𐴡𐴥𐴘𐴧𐴟𐴔, <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴌𐴝𐴕𐴝 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴒𐴟𐴕𐴝𐴤𐴘𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴘𐴝𐴀𐴕 𐴕𐴝𐴐𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴒𐴟𐴕𐴝𐴤𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴝𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴒𐴟𐴕𐴝𐴤𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="ROM 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴙𐴅𐴧𐴞𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴞𐴕 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴞𐴕𐴊𐴝 𐴘𐴡𐴥 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔, <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴞, 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴔𐴡𐴌𐴞𐴁𐴡𐴥; 𐴔𐴡𐴦𐴃𐴡𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴕𐴝𐴥𐴘. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴁𐴝 𐴃𐴡 𐴀𐴠𐴑𐴁𐴝𐴌𐴡𐴃𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝𐴓𐴧𐴝 𐴒𐴟𐴕𐴝𐴤𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴃𐴧𐴟 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴌, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴓𐴧𐴝 𐴁𐴠 𐴈𐴝𐴍𐴝𐴌.<verse eid="ROM 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 6:11" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴁𐴝𐴥𐴉𐴞𐴘𐴡 𐴊𐴠, 𐴒𐴟𐴕𐴝𐴤𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴌𐴝, 𐴀𐴝𐴦𐴌 𐴘𐴝𐴓𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴓𐴧𐴝 𐴁𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴡𐴤. <verse eid="ROM 6:11" /><verse number="12" style="v" sid="ROM 6:12" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴒𐴟𐴕𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴠𐴥 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴝 𐴁𐴝𐴘𐴁𐴡𐴥. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴇𐴞𐴥𐴏𐴧𐴝𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴌𐴞𐴊𐴞 𐴕𐴡 𐴌𐴝𐴙𐴑𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴏𐴝𐴥𐴔𐴝𐴕𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴕𐴞𐴎𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠.<verse eid="ROM 6:14" /></para>
  <para style="s1">𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴒𐴟𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠؟ 𐴀𐴝𐴣𐴀𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴞𐴤 𐴁𐴡𐴥𐴓𐴞 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔 𐴕𐴠𐴥؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝 𐴔𐴝𐴕𐴞 𐴁𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴟𐴓𐴝𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴌 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝 𐴔𐴝𐴕𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴊𐴠𐴥؟ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴓𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴒𐴟𐴓𐴝𐴔 𐴁𐴡𐴕𐴞 𐴔𐴡𐴌𐴞𐴁𐴝𐴥, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴁𐴡𐴕𐴞 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴟𐴕𐴝𐴤𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴃𐴢 𐴎𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴉𐴝𐴘𐴧𐴡𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴉𐴟𐴌𐴝 𐴊𐴞𐴓𐴠 𐴔𐴝𐴕𐴝𐴃𐴢 𐴀𐴝𐴏𐴡𐴤. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴡 𐴒𐴟𐴕𐴝𐴤𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘.<verse eid="ROM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴟𐴎𐴞𐴥 𐴑𐴟𐴓𐴢 𐴕𐴡 𐴉𐴝𐴘𐴁𐴝 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴧𐴟 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴈𐴡𐴀𐴙𐴌. 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴌𐴡𐴤 𐴑𐴟𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴀𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴝𐴉𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴈𐴝𐴔𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴠𐴌𐴞𐴊𐴞 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴝, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴀𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴒𐴟𐴓𐴝𐴔𐴞𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡. <verse eid="ROM 6:19" /><verse number="20" style="v" sid="ROM 6:20" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴟𐴕𐴝𐴤𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴡 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴡𐴤𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴘𐴝𐴓𐴝 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝𐴃𐴢 𐴀𐴝𐴏𐴡𐴤, 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴞𐴥𐴘𐴡𐴌𐴠 𐴑𐴞𐴦 𐴉𐴝𐴥𐴘𐴊𐴝 𐴉𐴝𐴀𐴘𐴓𐴝 𐴊𐴠𐴥؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴃𐴡 𐴔𐴡𐴦𐴃𐴢. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />𐴓𐴠𐴑𐴞𐴕 𐴘𐴝𐴓𐴝 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴟𐴕𐴝𐴤𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴉𐴝𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘; 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴝𐴥𐴘𐴊𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴡𐴥 𐴀𐴠𐴥𐴃𐴡 𐴂𐴝𐴑 𐴀𐴡𐴥𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘𐴁𐴝. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴃𐴡 𐴔𐴡𐴦𐴃𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s1">𐴁𐴞𐴘𐴝𐴥-𐴐𐴝𐴥𐴊𐴞𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴖𐴡𐴌𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴀𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴁𐴠 𐴃𐴝𐴥𐴑𐴠 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴠؟ <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />𐴔𐴠𐴀𐴏𐴝𐴓𐴢, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴠 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴓𐴡𐴥𐴘 𐴀𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴁𐴝𐴙𐴕𐴊𐴝𐴤 𐴌𐴝𐴑𐴠𐴥 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴇𐴡𐴥𐴐𐴡𐴔 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴥𐴐𐴡𐴔 𐴔𐴡𐴌𐴞𐴎𐴝𐴒𐴡𐴥𐴘, 𐴇𐴞𐴥𐴁𐴝 𐴇𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴡𐴥𐴐𐴡𐴔 𐴓𐴡𐴥𐴘 𐴁𐴝𐴣𐴊𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴇𐴡𐴥𐴐𐴡𐴔 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴎𐴡𐴊𐴞 𐴇𐴞𐴥𐴁𐴝 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴇𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴁𐴝 𐴇𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴘𐴝𐴓𐴝 𐴇𐴞𐴥𐴁𐴝 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴓𐴠 𐴘𐴡 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌 𐴈𐴡𐴖𐴝𐴤 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.<verse eid="ROM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴁𐴡𐴕𐴞𐴒𐴞𐴘𐴡𐴥𐴒𐴡𐴘 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴒𐴡𐴘. 𐴘𐴝𐴓𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘, 𐴘𐴝𐴥𐴕𐴞 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴓𐴧𐴝 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝 𐴊𐴡𐴥𐴌𐴝𐴘. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴃𐴝𐴥𐴔, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴝𐴎𐴧𐴟 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴈𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝 𐴊𐴡𐴥𐴌𐴝𐴘 𐴎𐴞𐴀𐴕𐴠 𐴔𐴡𐴦𐴃𐴢 𐴀𐴝𐴕𐴠𐴤. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴃𐴢 𐴁𐴡𐴕𐴊𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴧𐴟 𐴔𐴡𐴌𐴞𐴘𐴡𐴌𐴠 𐴘𐴝𐴓𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴉𐴝𐴘𐴧𐴞𐴥. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴌 𐴇𐴠𐴥 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴊𐴞𐴦𐴘𐴝 𐴉𐴟𐴌𐴝𐴕 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴒𐴟𐴓𐴝𐴔 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴊𐴞𐴦𐴘𐴝 𐴕𐴡𐴘𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴒𐴟𐴓𐴝𐴔.<verse eid="ROM 7:6" /></para>
  <para style="s1">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴦 𐴈𐴡𐴘𐴃𐴝𐴥𐴔؟ 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴒𐴟𐴕𐴝𐴤 𐴊𐴠 𐴕𐴠𐴥؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡! 𐴁𐴡𐴥𐴓𐴑𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴛 𐴒𐴟𐴕𐴝𐴤 𐴏𐴞𐴕𐴞𐴥 𐴕𐴡 𐴉𐴝𐴙𐴃𐴧𐴝𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴠 𐴎𐴡𐴊𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴈𐴡𐴘𐴃𐴡𐴤, ”𐴓𐴝𐴓𐴡𐴥𐴏𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝,“<note caller="+" style="f"><char style="fr" closed="false">7‏:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:17">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 20‏:17</ref></char>; <char style="xt"><ref loc="DEU 5:21">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 5‏:21</ref></char></char></note> 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴓𐴝𐴓𐴡𐴥𐴏𐴢 𐴑𐴞𐴦 𐴊𐴠 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴙𐴕𐴃𐴝𐴔. <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴒𐴟𐴕𐴝𐴤𐴘𐴠 𐴇𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴧𐴟 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴓𐴞𐴤 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴓𐴝𐴓𐴡𐴥𐴏𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴒𐴟𐴕𐴝𐴤 𐴃𐴡 𐴔𐴡𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘 𐴃𐴝𐴥𐴑𐴠. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />𐴀𐴠𐴑 𐴇𐴝𐴓𐴠 𐴀𐴝𐴀𐴛 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴌𐴝𐴥𐴌 𐴒𐴟𐴕𐴝𐴤 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘. <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />𐴇𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴝𐴕𐴞𐴤𐴁𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴔𐴡𐴦𐴃𐴢 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴘𐴠 𐴇𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴧𐴟 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴓𐴞𐴤 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴝𐴒𐴝 𐴊𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. <verse eid="ROM 7:11" /><verse number="12" style="v" sid="ROM 7:12" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴂𐴝𐴑, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴂𐴝𐴑, 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴔.<verse eid="ROM 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴑𐴞𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴔𐴡𐴦𐴃𐴢 𐴁𐴡𐴙𐴕𐴧𐴠𐴥 𐴊𐴠𐴥؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡! 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴟𐴕𐴝𐴤𐴌𐴠 𐴒𐴟𐴕𐴝𐴤 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴡𐴥𐴃𐴢 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴒𐴟𐴕𐴝𐴤𐴘𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴔𐴡𐴦𐴃𐴢 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝 𐴊𐴠 𐴑𐴞, 𐴒𐴟𐴕𐴝𐴤 𐴀𐴠𐴁𐴧𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢.<verse eid="ROM 7:13" /></para>
  <para style="s1">𐴒𐴟𐴕𐴝𐴤 𐴓𐴡𐴥𐴘 𐴓𐴡𐴌𐴇𐴡𐴥𐴌𐴝</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴞, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴒𐴝𐴁𐴞; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴊𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴞; 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴌 𐴒𐴟𐴓𐴝𐴔𐴞𐴃𐴢 𐴁𐴠𐴏𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />𐴀𐴝𐴀𐴛 𐴑𐴞𐴦 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡 𐴁𐴟𐴎𐴞𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴓𐴝𐴒𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴠 𐴒𐴡𐴌𐴞𐴥. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />𐴀𐴝𐴀𐴛 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠 𐴕𐴡 𐴈𐴡𐴀 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴔 𐴁𐴡𐴓𐴞 𐴀𐴝𐴀𐴛 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />𐴇𐴠𐴥 𐴏𐴟𐴥𐴌𐴡𐴃𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴝𐴀𐴛 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴒𐴟𐴕𐴝𐴤. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴣𐴀𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴔 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘. 𐴁𐴠𐴐𐴡𐴥𐴑, 𐴒𐴡𐴔 𐴔𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴎𐴧𐴟 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴔𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥; 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴠 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔 𐴔𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠 𐴕𐴡 𐴈𐴡𐴀, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴠 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠 𐴕𐴡 𐴈𐴡𐴀 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴀𐴛 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴝𐴀𐴛 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴒𐴟𐴕𐴝𐴤.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />𐴘𐴝𐴓𐴝 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴘𐴡𐴔 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴙𐴌 𐴊𐴠 𐴑𐴞, 𐴒𐴡𐴔 𐴔𐴝𐴥𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴟𐴌𐴝 𐴒𐴝𐴥𐴕 𐴀𐴝𐴀𐴘𐴢 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴑𐴠. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴞𐴘𐴡𐴔𐴡𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴌𐴞𐴥, <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴊𐴠𐴑𐴞𐴥𐴌 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴘𐴡𐴔 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴊𐴞𐴓𐴡𐴌 𐴇𐴠𐴥 𐴕𐴞𐴘𐴡𐴔 𐴓𐴡𐴘 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴌 𐴕𐴞𐴘𐴡𐴔 𐴖𐴝𐴀𐴕𐴡𐴌 𐴁𐴡𐴕𐴊𐴞 𐴁𐴝𐴕𐴝𐴘 𐴌𐴝𐴑𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴉𐴟𐴐𐴑𐴝𐴌𐴝𐴤! 𐴔𐴡𐴦𐴃𐴢 𐴀𐴝𐴕𐴠𐴤 𐴊𐴠 𐴅𐴞𐴏𐴞𐴥𐴔 𐴘𐴝𐴀𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴡𐴕𐴠 𐴁𐴝𐴏𐴝𐴘𐴁𐴡𐴥؟ <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴁𐴝𐴏𐴝𐴘𐴧𐴠𐴥!</para>
  <para style="p" vid="ROM 7:25">𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴀𐴠𐴑 𐴌𐴟𐴖𐴝𐴃𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴒𐴟𐴓𐴝𐴔𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴌𐴀𐴠𐴑 𐴌𐴟𐴖𐴝𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴌 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴁𐴝𐴕𐴝𐴘 𐴌𐴝𐴑𐴠𐴥.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s1">𐴌𐴟𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴝𐴓𐴝 𐴀𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴊𐴡𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴡 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴡𐴦𐴘𐴝 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴕𐴞𐴘𐴡𐴔𐴠, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝, 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴦𐴃𐴡𐴌 𐴕𐴞𐴘𐴡𐴔𐴡𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴑𐴡𐴔𐴎𐴟𐴌𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥: 𐴒𐴟𐴕𐴝𐴤𐴌 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴓𐴝 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴒𐴟𐴕𐴝𐴤𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴝𐴘𐴧𐴠, <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴊𐴝𐴁𐴞-𐴊𐴝𐴖𐴝𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴉𐴝𐴌𐴞. <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴁𐴠 𐴔𐴡𐴕 𐴊𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴁𐴠 𐴔𐴡𐴕 𐴊𐴠. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴔𐴡𐴕 𐴊𐴞𐴓𐴠𐴥 𐴔𐴡𐴦𐴃𐴢 𐴁𐴠 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴔𐴡𐴕 𐴊𐴞𐴓𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴉𐴝𐴦 𐴎𐴝, <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠 𐴔𐴡𐴕 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴔𐴝𐴙𐴕𐴃𐴡 𐴃𐴡 𐴌𐴝𐴎𐴞 𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴞 𐴘𐴡𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴡𐴌 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴡𐴀𐴌 𐴊𐴠. 𐴓𐴠𐴑𐴞𐴕 𐴎𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴟𐴀 𐴕𐴝𐴥𐴘, 𐴀𐴞𐴥𐴃𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴡. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />𐴎𐴡𐴊𐴞 𐴔𐴡𐴀𐴏𐴞𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴠𐴑 𐴌𐴟𐴖𐴝𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴒𐴟𐴕𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴔𐴡𐴌𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴝𐴌𐴀𐴠𐴑 𐴌𐴟𐴖𐴝𐴃𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴡𐴌𐴝𐴕. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴟𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌𐴠 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴡 𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴎𐴞𐴁𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴡𐴥𐴌𐴡𐴏𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴞𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴁𐴝𐴥𐴌 𐴕𐴡. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴔𐴡𐴌𐴞𐴁𐴝𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴌𐴟𐴀𐴌 𐴁𐴡𐴓𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴞𐴁𐴝.<verse eid="ROM 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 8:14" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴊𐴟𐴥𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴒𐴟𐴓𐴝𐴔𐴞𐴌 𐴌𐴟𐴀 𐴉𐴝𐴘𐴧𐴡𐴥 𐴊𐴠 𐴕𐴡, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴌 𐴋𐴡𐴦𐴌𐴝 𐴉𐴡𐴙𐴃𐴧𐴡; 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴄𐴡𐴥𐴀𐴌𐴝 𐴊𐴠 𐴌𐴟𐴀 𐴀𐴠𐴥𐴕𐴝 𐴉𐴝𐴘𐴧𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 ”𐴀𐴝𐴁𐴧𐴝“ 𐴘𐴝𐴥𐴕𐴞 ”𐴀𐴡𐴥 𐴁𐴝𐴉𐴢“ 𐴈𐴡𐴀𐴘𐴢 𐴔𐴝𐴃𐴝𐴘 𐴉𐴝𐴌𐴞. <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />𐴇𐴠𐴥 𐴌𐴟𐴀 𐴕𐴞𐴎𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴌𐴟𐴀 𐴓𐴡𐴥𐴘 𐴔𐴞𐴓𐴞 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴞𐴌𐴝𐴏𐴊𐴝𐴥𐴌 𐴀𐴡𐴥; 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴡𐴦𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴡𐴦𐴘𐴝; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴃𐴢 𐴀𐴡𐴥 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴘𐴧𐴟𐴔.<verse eid="ROM 8:17" /></para>
  <para style="s1">𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴞</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴥𐴘 𐴉𐴟𐴥𐴖𐴝𐴕 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝𐴘𐴁𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴎𐴧𐴟𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴃𐴡 𐴁𐴠𐴇𐴝𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴘𐴢 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴓𐴡𐴥𐴘 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠. 𐴃𐴡𐴀 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴠 𐴀𐴝𐴐𐴝𐴤 𐴒𐴝𐴥𐴕 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴠𐴑 𐴊𐴞𐴕 𐴇𐴠𐴥 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴁𐴡𐴌𐴁𐴝𐴊𐴞𐴌 𐴒𐴟𐴓𐴝𐴔𐴞𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴉𐴝𐴘𐴧𐴡𐴌𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴀𐴝𐴎𐴝𐴊𐴞𐴌 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴘𐴁𐴡.<verse eid="ROM 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴙𐴅 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴑𐴞𐴣𐴘𐴝𐴌, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴔𐴝𐴦𐴘𐴠 𐴉𐴟𐴖𐴝 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴊𐴟𐴑𐴧𐴠𐴥 𐴑𐴞𐴣𐴘𐴝. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴞𐴥𐴀𐴕𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴉𐴝𐴘𐴧𐴞𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴁𐴟𐴥𐴃𐴡𐴌𐴠-𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴑𐴞𐴣𐴘𐴝𐴘-𐴑𐴞𐴣𐴘𐴝𐴘 𐴀𐴡 𐴊𐴞𐴕𐴡𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴞𐴤, 𐴎𐴠 𐴊𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴁𐴝𐴕𐴝𐴘𐴁𐴡𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴝𐴦𐴌𐴠 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴃𐴡 𐴀𐴝𐴐𐴝𐴤 𐴊𐴞𐴦 𐴀𐴠𐴥𐴕𐴝 𐴕𐴠𐴅𐴝𐴃𐴢 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. 𐴏𐴝𐴘𐴧𐴝𐴤 𐴒𐴝𐴥𐴕 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴏𐴝𐴀𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟ <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴊𐴠𐴙𐴑𐴧𐴝𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴧𐴝 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴡𐴔𐴎𐴟𐴌𐴞𐴃𐴢 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤𐴕 𐴏𐴝𐴥 𐴕𐴡 𐴎𐴝𐴕𐴞, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴕𐴞𐴎𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴣𐴊𐴞-𐴈𐴝𐴣𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴐𐴟𐴥𐴖𐴝𐴌𐴞𐴐𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴎𐴞𐴀𐴕 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴌𐴝𐴀 𐴕𐴝𐴥𐴘. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />𐴀𐴝𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴊𐴞𐴓𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴎𐴝𐴕𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞 𐴘𐴡𐴥 𐴎𐴝𐴕𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴁𐴠 𐴐𐴟𐴥𐴖𐴝𐴌𐴞𐴐𐴢 𐴒𐴡𐴌𐴠𐴥.<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴠𐴌𐴝𐴊𐴝 𐴔𐴡𐴎𐴞𐴕 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴓𐴝𐴘 𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥𐴖𐴝𐴁𐴝. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴁𐴝𐴏𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴖𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴁𐴞𐴐𐴞𐴤 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴠𐴥 𐴉𐴟𐴖𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴎𐴡𐴌𐴔𐴡 𐴖𐴝 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴠. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥 𐴘𐴡𐴥; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴀𐴡𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴖𐴝𐴓𐴝 𐴘𐴡𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="ROM 8:30" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />𐴘𐴝𐴓𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴏𐴝𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴦 𐴈𐴡𐴘𐴃𐴝𐴥𐴔؟ 𐴀𐴝𐴓𐴧𐴝 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴀𐴡𐴥, 𐴇𐴡𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴃𐴞𐴥𐴘𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟ <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴇𐴝𐴥𐴌𐴝𐴘 𐴕𐴡𐴥 𐴌𐴝𐴑𐴠𐴥 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴔𐴡𐴦𐴃𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴃𐴟𐴓𐴞𐴤 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴘𐴡𐴥 𐴑𐴞𐴘𐴝𐴥 𐴊𐴞𐴦 𐴕𐴡 𐴉𐴠𐴓𐴝𐴘𐴃𐴡؟ <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />𐴘𐴝𐴓𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴠𐴓𐴎𐴝𐴔 𐴓𐴝𐴒𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟ 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝 𐴕𐴞𐴎𐴠 𐴀𐴠𐴥𐴕𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴔𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴞𐴕𐴊𐴝 𐴘𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴐𐴟𐴥𐴖𐴝𐴌𐴞𐴐𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴃𐴧𐴟 𐴑𐴞𐴘𐴠𐴥 𐴀𐴝𐴓𐴡𐴑 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟ 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴠 𐴕𐴠𐴥؟ 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴘𐴠 𐴕𐴠𐴥؟ 𐴎𐴟𐴓𐴟𐴥𐴔𐴠 𐴕𐴠𐴥؟ 𐴉𐴠𐴍𐴡𐴌 𐴁𐴟𐴥𐴑𐴧𐴠 𐴕𐴠𐴥؟ 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌𐴡𐴌 𐴈𐴡𐴔𐴞𐴘𐴠 𐴕𐴠𐴥؟ 𐴀𐴝𐴉𐴡𐴃𐴁𐴞𐴉𐴡𐴃𐴠 𐴕𐴠𐴥؟ 𐴊𐴟𐴐𐴧𐴡𐴕𐴡𐴌 𐴃𐴡𐴓𐴟𐴖𐴝𐴌𐴠 𐴕𐴠𐴥؟ <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="ROM 8:36">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴞𐴕𐴁𐴡𐴥𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢 𐴉𐴡𐴌𐴞;</para>
  <para style="q2" vid="ROM 8:36">𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴡𐴦𐴌𐴝𐴥𐴘𐴁𐴡 𐴊𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝.“<note caller="+" style="f"><char style="fr" closed="false">8‏:36 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 44:22">𐴎𐴡𐴁𐴟𐴌 44‏:22</ref></char></char></note><verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴡𐴥𐴃𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴘𐴝𐴀𐴕 𐴀𐴠𐴑𐴞𐴕 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴔𐴡𐴦𐴃𐴠 𐴘𐴝𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴘𐴠, 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴝𐴥 𐴁𐴟𐴥𐴃𐴢-𐴉𐴠𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠, 𐴘𐴝𐴦𐴌 𐴇𐴝𐴓𐴠 𐴘𐴝𐴥 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴇𐴝𐴓𐴠, 𐴇𐴡𐴕𐴡𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴏𐴡𐴥𐴌𐴠, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴘𐴝𐴥 𐴉𐴝𐴃𐴝𐴓𐴉𐴟𐴌𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴘𐴠, 𐴘𐴝𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴇𐴡𐴕𐴡𐴤 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴡 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴡𐴑 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴉𐴝𐴘𐴧𐴞𐴥.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s1">𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴖𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴒𐴡𐴁𐴝𐴤 𐴒𐴡𐴌𐴞𐴥 𐴇𐴝𐴥𐴣𐴏𐴝 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌, 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴓𐴡𐴔𐴠 𐴘𐴡𐴥 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴘𐴝𐴀𐴕 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴌, <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴓𐴝𐴒𐴠𐴌 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴒𐴝𐴃𐴝𐴌 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴓𐴝𐴒𐴠𐴌. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴑𐴡𐴗𐴔, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴏𐴧𐴡 𐴀𐴠𐴊𐴧𐴠 𐴓𐴡𐴖𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴎𐴡𐴊𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴃𐴧𐴟 𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘 𐴁𐴡𐴊𐴧𐴟𐴖𐴝𐴌 𐴃𐴡𐴓𐴠 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴙𐴃𐴧𐴡 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴡𐴥𐴘𐴃𐴝𐴔. <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴇𐴠𐴥 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴡𐴌 𐴃𐴡𐴌𐴞𐴑𐴝 𐴊𐴞𐴦𐴘𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴁𐴡𐴀𐴗𐴃𐴢 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴖𐴝𐴦𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴒𐴟𐴥𐴕𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴔𐴡𐴀𐴏𐴞𐴤 𐴘𐴡𐴥 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴠𐴀𐴕 𐴕𐴡 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴝𐴦𐴃𐴠𐴓𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞 𐴕𐴡; <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴔𐴝𐴀𐴕𐴞 𐴇𐴡𐴥𐴕𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴕𐴡. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴠 𐴃𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴊𐴡𐴥𐴌𐴝 𐴎𐴝𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">9‏:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 21:12">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 21‏:12</ref></char></char></note> <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴔𐴝𐴀𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴁𐴡𐴥𐴓𐴞 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴁𐴠 𐴊𐴡𐴥𐴌𐴝 𐴎𐴝, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴝𐴦𐴊𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />𐴇𐴠𐴥 𐴖𐴝𐴦𐴊𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴝𐴀𐴕, ”𐴀𐴝𐴀𐴛 𐴀𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴏𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴡𐴌𐴡𐴃𐴢 𐴉𐴟𐴖𐴝 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">9‏:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 18:10">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 18‏:10</ref>‏,<ref loc="GEN 18:14">14</ref></char></char></note><verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴌𐴠𐴁𐴠𐴥𐴑𐴝𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝; 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴞𐴥𐴁𐴝 𐴀𐴠𐴑𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴥𐴘, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑 𐴓𐴡𐴥𐴘 𐴇𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴉𐴟𐴀𐴝𐴙𐴕 𐴕𐴟𐴥𐴕 𐴎𐴡𐴌𐴔𐴡 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴃𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴡𐴤 𐴁𐴝𐴥𐴓𐴝-𐴁𐴟𐴌𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴥 𐴒𐴡𐴙𐴃𐴧𐴠𐴤, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴀𐴠𐴌𐴝𐴊𐴝 𐴔𐴡𐴎𐴞𐴕 𐴁𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴔𐴡𐴥𐴓𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴋𐴝𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝. <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴑𐴞, ”𐴉𐴟𐴖𐴝 𐴋𐴡𐴣𐴀𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴖𐴝𐴌 𐴒𐴟𐴓𐴝𐴔𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">9‏:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 25:23">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 25‏:23</ref></char></char></note> <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴘𐴝𐴑𐴟𐴁𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴡𐴥𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥.“<note caller="+" style="f"><char style="fr" closed="false">9‏:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAL 1:2">𐴔𐴝𐴓𐴝𐴑𐴞𐴥 1‏:2</ref>‏,<ref loc="MAL 1:3">3</ref></char></char></note><verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴦 𐴈𐴡𐴘𐴃𐴝𐴥𐴔؟ 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴕𐴠𐴥؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡. <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴔𐴟𐴀𐴏𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴓𐴢,</para>
  <para style="q1" vid="ROM 9:15">”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴝𐴌𐴠𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔;</para>
  <para style="q2" vid="ROM 9:15">𐴀𐴝𐴦𐴌 𐴎𐴝𐴌𐴠𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴃𐴝𐴌𐴠𐴥 𐴉𐴠𐴄𐴉𐴟𐴌𐴝𐴕𐴞 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴟𐴔.“<note caller="+" style="f"><char style="fr" closed="false">9‏:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 33:19">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 33‏:19</ref></char></char></note><verse eid="ROM 9:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="ROM 9:16" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥𐴌 𐴘𐴝𐴥 𐴑𐴟𐴐𐴞𐴥𐴐𐴡𐴌 𐴖𐴡𐴌𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴌 𐴖𐴡𐴌𐴠. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴉𐴠𐴥𐴌𐴟𐴖𐴝𐴕𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, ”𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴃𐴟𐴙𐴓𐴧𐴞𐴥 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴊𐴝𐴈𐴝𐴤𐴘 𐴉𐴝𐴌𐴞, 𐴁𐴝𐴦𐴊𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴡𐴌 𐴈𐴡𐴖𐴝𐴤𐴇𐴡𐴘 𐴀𐴡𐴥𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">9‏:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 9:16">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 9‏:16</ref></char></char></note> <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴝𐴌𐴠𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴎𐴝𐴌𐴠𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴃𐴝𐴌 𐴊𐴞𐴓𐴢 𐴊𐴡𐴌𐴡𐴤 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠.<verse eid="ROM 9:18" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴇𐴝𐴥𐴔</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴁𐴝𐴤, ”𐴃𐴡𐴀 𐴑𐴞𐴘𐴝𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴡𐴥𐴌𐴠؟ 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕𐴡𐴌𐴠 𐴇𐴡𐴕𐴠 𐴁𐴝𐴎𐴝𐴥 𐴊𐴞𐴥 𐴉𐴝𐴌𐴠؟“ <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />𐴀𐴝𐴣𐴀𐴌 𐴎𐴟𐴖𐴝𐴁𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴡𐴥 𐴔𐴡𐴕𐴞𐴐𐴧𐴡𐴥, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴔𐴝𐴃𐴞 𐴁𐴡𐴓𐴧𐴝 𐴃𐴟𐴘 𐴇𐴡𐴕؟ 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴑𐴞𐴥 𐴁𐴝𐴕𐴡𐴘𐴝𐴃𐴧𐴟 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴕𐴠𐴥, ”𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴞𐴘𐴝𐴥 𐴁𐴝𐴕𐴝𐴘𐴓𐴝𐴤؟“<note caller="+" style="f"><char style="fr" closed="false">9‏:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 29:16">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 29‏:16</ref>; <ref loc="ISA 45:9">45‏:9</ref></char></char></note> <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />𐴀𐴠𐴑 𐴔𐴠𐴍𐴞𐴌 𐴊𐴡𐴓𐴝𐴃𐴧𐴟 𐴑𐴞𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴕𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴟𐴀𐴝𐴥𐴣𐴙𐴅𐴧𐴝𐴃𐴧𐴟 𐴇𐴡𐴥𐴑 𐴕𐴝𐴥𐴘 𐴕𐴠𐴥—𐴑𐴠𐴏𐴧𐴟𐴥 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴈𐴝𐴥𐴀𐴏𐴢 𐴈𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴦𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴐𐴝𐴥𐴊𐴝𐴌𐴝𐴕 𐴈𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝؟<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴕𐴝𐴎𐴞𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴃𐴡𐴀 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴉𐴝𐴘𐴁𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴁𐴡𐴌𐴁𐴝𐴊𐴞𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴞𐴐𐴞𐴤 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴐𐴡𐴥𐴀𐴘𐴧𐴠. <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴐𐴡𐴥𐴀𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴃𐴞 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔 𐴉𐴝𐴘𐴁𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴓𐴧𐴝 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴃𐴡𐴘𐴧𐴝𐴌 𐴌𐴝𐴙𐴑𐴧𐴠𐴥. <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />𐴌𐴝𐴇𐴝𐴥𐴔 𐴉𐴝𐴘𐴁𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴋𐴝𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴋𐴝𐴙𐴑𐴧𐴠𐴥. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡𐴁𐴞 𐴇𐴡𐴥𐴐𐴞𐴘𐴝𐴌 𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="ROM 9:25">”𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴕𐴊𐴝 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 ’𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴕𐴊𐴝‘ 𐴋𐴝𐴑𐴞𐴘𐴟𐴥𐴔,</para>
  <para style="q2" vid="ROM 9:25">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴌𐴁𐴡𐴕 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 ’𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴌𐴁𐴡𐴕‘ 𐴋𐴝𐴑𐴞𐴘𐴟𐴥𐴔.<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />𐴎𐴠 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴘𐴠,</para>
  <para style="q2" vid="ROM 9:26">’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴕𐴊𐴝 𐴕𐴡,‘</para>
  <para style="q2" vid="ROM 9:26">𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 ’𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕‘ 𐴋𐴝𐴑𐴝 𐴎𐴝𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">9‏:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 2:23">𐴇𐴡𐴥𐴐𐴞𐴘𐴝 2‏:23</ref>; <ref loc="HOS 1:10">1‏:10</ref></char></char></note><verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴘𐴠 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥,</para>
  <para style="q1" vid="ROM 9:27">”𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴏𐴡𐴌𐴡𐴌 𐴁𐴝𐴓𐴟𐴌 𐴇𐴠𐴥𐴊𐴟𐴕 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡,</para>
  <para style="q2" vid="ROM 9:27">𐴃𐴡𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴔 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴁𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴡.<verse eid="ROM 9:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴁𐴟𐴊𐴠 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴁𐴞𐴐𐴞𐴤 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">9‏:28 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 10:22">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 10‏:22</ref>‏,<ref loc="ISA 10:23">23</ref></char></char></note><verse eid="ROM 9:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ROM 9:29" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴘𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴁𐴝𐴃𐴝𐴓𐴝𐴘 𐴊𐴞𐴀𐴓𐴢, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥,</para>
  <para style="q1" vid="ROM 9:29">”𐴀𐴝𐴓𐴧𐴝 𐴌𐴡𐴁𐴧𐴟𐴓𐴢 𐴀𐴝𐴦𐴓𐴝𐴔𐴞𐴕𐴠</para>
  <para style="q2" vid="ROM 9:29">𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴌𐴝𐴑𐴞𐴥 𐴕𐴡 𐴎𐴝𐴘𐴃𐴡,</para>
  <para style="q1" vid="ROM 9:29">𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴃𐴡 𐴏𐴡𐴥𐴊𐴡𐴔 𐴐𐴡𐴥𐴀𐴌 𐴀𐴡𐴌</para>
  <para style="q2" vid="ROM 9:29">𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴔𐴡𐴥𐴌𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘.“<note caller="+" style="f"><char style="fr" closed="false">9‏:29 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 1:9">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 1‏:9</ref></char></char></note><verse eid="ROM 9:29" /></para>
  <para style="s1">𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴦 𐴈𐴡𐴘𐴃𐴝𐴥𐴔؟ 𐴘𐴝𐴀𐴕𐴝, 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴕𐴡 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴘𐴡 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴀𐴞𐴔𐴝𐴕𐴠 𐴁𐴠 𐴉𐴝𐴦 𐴎𐴝; <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴘𐴡 𐴇𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡𐴥 𐴉𐴝𐴦. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕𐴠 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴔𐴡𐴥𐴓𐴠 𐴉𐴝𐴦 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴟𐴅𐴝𐴥𐴄𐴢 𐴇𐴝𐴥 𐴊𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴟𐴅𐴝𐴥𐴄𐴢 𐴇𐴝𐴥𐴘𐴧𐴠. <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="ROM 9:33">”𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴏𐴞𐴥𐴘𐴡𐴕𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴌𐴝𐴑𐴞𐴥𐴌,</para>
  <para style="q2" vid="ROM 9:33">𐴎𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴀𐴟𐴅𐴝𐴥𐴄𐴢 𐴈𐴝𐴥𐴁𐴝𐴘𐴁𐴡,</para>
  <para style="q1" vid="ROM 9:33">𐴘𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴡 𐴐𐴞𐴥𐴓𐴢,</para>
  <para style="q2" vid="ROM 9:33">𐴎𐴠 𐴐𐴞𐴥𐴓𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴉𐴡𐴌𐴝 𐴁𐴝𐴘𐴁𐴡𐴥,</para>
  <para style="q2" vid="ROM 9:33">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤 𐴀𐴞𐴥𐴃𐴠 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">9‏:33 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:14">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 8‏:14</ref>; <ref loc="ISA 28:16">28‏:16</ref></char></char></note><verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴊𐴞𐴓𐴡𐴌 𐴀𐴝𐴎𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴖𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴡𐴗𐴑. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠 𐴒𐴡𐴁𐴝𐴤 𐴒𐴝𐴥𐴕 𐴊𐴞𐴌 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴓𐴧𐴝 𐴅𐴟𐴏𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴞 𐴕𐴡. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴠 𐴁𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴘𐴃𐴡 𐴏𐴝𐴀; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠 𐴃𐴡𐴌𐴞𐴑𐴝 𐴓𐴡𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴇𐴠𐴥 𐴃𐴡𐴌𐴞𐴑𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴃𐴡 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌𐴠 𐴇𐴡𐴥𐴃𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.<verse eid="ROM 10:4" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴞𐴘𐴝 𐴕𐴠𐴅𐴝𐴃𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴓𐴧𐴝</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴓𐴡𐴥𐴘 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, ”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴝𐴕𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴁𐴠 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">10‏:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 18:5">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 18‏:5</ref></char> </char></note> <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴠 𐴎𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴕𐴡 𐴈𐴡𐴘𐴧𐴡𐴥 𐴊𐴠, ’𐴇𐴡𐴕𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴟𐴍𐴞𐴤𐴁𐴡؟‘“<note caller="+" style="f"><char style="fr" closed="false">10‏:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 30:12">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 30‏:12</ref></char></char></note> 𐴘𐴝𐴥𐴕𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴓𐴝𐴔𐴝𐴘 𐴀𐴝𐴕𐴞𐴤 𐴁𐴡𐴓𐴧𐴝. <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />𐴀𐴝𐴦𐴌 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴥 𐴕𐴡 𐴈𐴡𐴘𐴧𐴡𐴥 𐴊𐴠, ”𐴇𐴡𐴕𐴠 𐴕𐴞𐴏𐴠 𐴉𐴝𐴃𐴝𐴓𐴉𐴟𐴌𐴡𐴃𐴢 𐴓𐴝𐴔𐴞𐴁𐴡𐴥؟“<note caller="+" style="f"><char style="fr" closed="false">10‏:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 30:13">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 30‏:13</ref></char></char></note> 𐴘𐴝𐴥𐴕𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴔𐴟𐴌𐴟𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴓𐴡𐴘𐴀𐴝𐴕𐴞𐴤 𐴁𐴡𐴓𐴧𐴝. <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟ ”𐴑𐴝𐴓𐴝𐴔 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴝𐴥𐴕𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴑𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴀𐴡𐴃𐴢.“<note caller="+" style="f"><char style="fr" closed="false">10‏:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 30:14">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 30‏:14</ref></char></char></note> 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴝𐴓𐴝𐴔 𐴀𐴟𐴀𐴙𐴕 𐴎𐴞𐴀𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴑𐴞, <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴑𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴓𐴞𐴑 𐴊𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴓𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴡𐴤, 𐴃𐴟𐴀𐴛 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴝. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴞𐴓𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴓𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝, 𐴀𐴝𐴦𐴌 𐴔𐴟𐴑𐴠𐴥 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴓𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝 𐴎𐴝. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤 𐴀𐴞𐴥𐴃𐴠 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">10‏:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 28:16">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 28‏:16</ref></char> </char></note> <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴇𐴡𐴕𐴡𐴤 𐴉𐴡𐴌𐴡𐴥𐴑 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴑𐴟𐴥𐴊𐴝 𐴃𐴡 𐴀𐴠𐴑𐴒𐴗𐴝𐴥. 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴃𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴄𐴝𐴓𐴞𐴑𐴧𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴊𐴠𐴦, <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴕𐴝𐴔 𐴓𐴡𐴘𐴁𐴡, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">10‏:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOL 2:32">𐴘𐴡𐴖𐴠𐴥𐴓𐴢 2‏:32</ref></char></char></note><verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴞𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟𐴥 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴔𐴝𐴃𐴝𐴘𐴁𐴡𐴥؟ 𐴀𐴝𐴦𐴌 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡𐴥 𐴉𐴟𐴥𐴕𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴁𐴡؟ 𐴃𐴡𐴁𐴡𐴓𐴞𐴑-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴉𐴟𐴥𐴕𐴞 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟ <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴡 𐴊𐴞𐴉𐴠𐴍𐴝𐴥؟ 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴡𐴔 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴡𐴔 𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴄𐴠𐴥𐴚 𐴇𐴡𐴃𐴡𐴥 𐴔𐴟𐴁𐴝𐴌𐴠𐴑!“<note caller="+" style="f"><char style="fr" closed="false">10‏:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 52:7">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 52‏:7</ref></char></char></note><verse eid="ROM 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴇𐴡𐴥𐴕𐴡 𐴇𐴠𐴥 𐴒𐴡𐴔 𐴈𐴡𐴥𐴁𐴡𐴌 𐴒𐴝𐴥𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴘𐴠 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥, ”𐴀𐴡𐴥 𐴔𐴝𐴁𐴟𐴊𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴂𐴡𐴘𐴒𐴝𐴔 𐴇𐴡𐴕𐴠 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥؟“<note caller="+" style="f"><char style="fr" closed="false">10‏:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:1">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 53‏:1</ref></char></char></note> <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴉𐴟𐴥𐴕𐴞𐴓𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴞𐴓𐴠. <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴌 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴠𐴥 𐴑𐴝𐴓𐴝𐴔 𐴕𐴡𐴥 𐴉𐴟𐴥𐴕𐴠 𐴊𐴠 𐴕𐴠𐴥؟ 𐴁𐴠𐴐𐴡𐴥𐴑 𐴉𐴟𐴥𐴙𐴕𐴧𐴠. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠,</para>
  <para style="q1" vid="ROM 10:18">”𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴝 𐴒𐴞𐴥𐴘𐴠,</para>
  <para style="q2" vid="ROM 10:18">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴐𐴠𐴥𐴐𐴢 𐴔𐴝𐴃𐴝𐴥 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠.“<note caller="+" style="f"><char style="fr" closed="false">10‏:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 19:4">𐴎𐴡𐴁𐴟𐴌 19‏:4</ref></char></char></note><verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴣𐴀𐴌 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴡𐴥 𐴁𐴟𐴎𐴠𐴥 𐴊𐴠 𐴕𐴠𐴥؟ 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴎𐴟𐴖𐴝𐴁𐴢 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴔𐴟𐴀𐴏𐴝𐴌 𐴀𐴝𐴥𐴃𐴝 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠 𐴊𐴠 𐴑𐴞,</para>
  <para style="q1" vid="ROM 10:19">”𐴀𐴠𐴑 𐴁𐴠𐴎𐴝𐴃𐴞𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴟𐴐𐴧𐴝𐴤 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴘𐴟𐴔,</para>
  <para style="q2" vid="ROM 10:19">𐴀𐴝𐴦𐴌 𐴀𐴠𐴑 𐴀𐴡𐴁𐴟𐴎𐴢 𐴎𐴝𐴃𐴞𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴟𐴐𐴧𐴝𐴤 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴘𐴟𐴔.“<note caller="+" style="f"><char style="fr" closed="false">10‏:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:21">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 32‏:21</ref></char></char></note><verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />𐴉𐴡𐴌𐴠𐴎𐴝𐴘 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴌 𐴀𐴝𐴥𐴃𐴝 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥,</para>
  <para style="q1" vid="ROM 10:20">”𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥;</para>
  <para style="q2" vid="ROM 10:20">𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤 𐴉𐴟𐴏𐴝𐴥𐴌 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥.“<note caller="+" style="f"><char style="fr" closed="false">10‏:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 65:1">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 65‏:1</ref></char></char></note><verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />𐴓𐴠𐴑𐴞𐴕 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴃𐴝𐴓𐴠𐴑 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠,</para>
  <para style="q1" vid="ROM 10:21">”𐴀𐴠𐴑 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴣𐴅𐴧𐴝 𐴑𐴡𐴗𐴔𐴡𐴌 𐴀𐴟𐴎𐴟</para>
  <para style="q2" vid="ROM 10:21">𐴀𐴝𐴀𐴛 𐴊𐴞𐴕𐴁𐴡𐴥𐴌 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴕𐴞𐴥 𐴀𐴝𐴥𐴃𐴢 𐴔𐴠𐴓𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴞𐴥.“<note caller="+" style="f"><char style="fr" closed="false">10‏:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 65:2">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 65‏:2</ref></char></char></note><verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s1">𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴏𐴝𐴘 𐴌𐴝𐴑𐴝𐴤</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />𐴃𐴡𐴥𐴘 𐴀𐴝𐴌𐴡𐴤 𐴀𐴝𐴣𐴀𐴌 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠 𐴊𐴠 𐴕𐴠𐴥؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴊𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞; 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴁𐴞𐴕𐴘𐴝𐴔𐴞𐴕𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴕𐴊𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴁𐴝𐴏𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴠𐴓𐴠. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴕𐴡𐴁𐴞 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴞𐴦 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥؟ 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴡 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴞𐴏𐴝𐴌 𐴊𐴞𐴀𐴓𐴢, <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />”𐴀𐴡𐴥 𐴔𐴝𐴁𐴟𐴊𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴠. 𐴀𐴝𐴀𐴛 𐴀𐴠𐴑𐴎𐴡𐴕 𐴁𐴠 𐴁𐴝𐴏𐴞 𐴀𐴝𐴏𐴞𐴤 𐴊𐴠, 𐴘𐴝𐴓𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴎𐴝𐴕 𐴓𐴡𐴘𐴃𐴡 𐴘𐴡𐴥 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴠𐴥𐴌.“<note caller="+" style="f"><char style="fr" closed="false">11‏:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="1KI 19:10">1 𐴁𐴝𐴀𐴣𐴐𐴧𐴝-𐴕𐴝𐴔𐴝 19‏:10</ref>‏,<ref loc="1KI 19:14">14</ref></char></char></note> <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴑𐴞𐴦 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴀𐴓؟ 𐴘𐴝𐴀𐴕𐴝, ”𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴇𐴝𐴥𐴣𐴃𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴌𐴝𐴑𐴞𐴥𐴊𐴞𐴘𐴞, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴝𐴦𐴓𐴢<note caller="+" style="f"><char style="fr" closed="false">11‏:4 </char><char style="ft" closed="false">𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴝𐴑𐴠 𐴎𐴠 𐴑𐴝𐴥𐴕𐴝𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴠𐴁𐴡𐴃𐴝 𐴋𐴡𐴣𐴀𐴌 𐴒𐴗𐴝𐴌 𐴕𐴝𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴝𐴦𐴓𐴢.</char></note> 𐴊𐴠𐴁𐴡𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴍𐴟𐴥 𐴕𐴡𐴥 𐴉𐴠𐴓𐴝.“<note caller="+" style="f"><char style="fr" closed="false">11‏:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="1KI 19:18">1 𐴁𐴝𐴀𐴣𐴐𐴧𐴝-𐴕𐴝𐴔𐴝 19‏:18</ref></char></char></note> <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴠𐴇𐴡𐴥𐴕𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴃𐴝𐴥𐴑𐴞𐴒𐴞𐴘𐴡𐴘, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴁𐴝𐴏𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴔𐴡𐴥𐴓𐴠 𐴕𐴡; 𐴎𐴡𐴊𐴞 𐴀𐴝𐴔𐴡𐴥𐴓𐴠 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴃𐴡.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴕𐴡𐴃𐴞𐴎𐴝 𐴑𐴞𐴦؟ 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴖𐴝 𐴒𐴞𐴥𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴊𐴞𐴓𐴢 𐴊𐴡𐴌𐴡𐴤 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠,</para>
  <para style="q1" vid="ROM 11:8">”𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴏𐴟𐴥𐴇𐴝𐴌𐴝𐴘𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠,</para>
  <para style="q2" vid="ROM 11:8">𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴙𐴅 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴏𐴟𐴑𐴠𐴤 𐴕𐴡 𐴊𐴠𐴑𐴠𐴥𐴌,</para>
  <para style="q2" vid="ROM 11:8">𐴀𐴝𐴦𐴌 𐴈𐴝𐴕𐴠 𐴕𐴡 𐴉𐴟𐴥𐴕𐴠𐴌.“<note caller="+" style="f"><char style="fr" closed="false">11‏:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 29:4">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 29‏:4</ref></char>; <char style="xt"><ref loc="ISA 29:10">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 29‏:10</ref></char></char></note><verse eid="ROM 11:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 11:9" />𐴊𐴝𐴖𐴟𐴊𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠,</para>
  <para style="q1" vid="ROM 11:9">”𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴠𐴓𐴝-𐴐𐴡𐴥𐴁𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝</para>
  <para style="q2" vid="ROM 11:9">𐴐𐴞𐴥𐴘𐴝𐴌𐴞𐴌 𐴎𐴝𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴥𐴕 𐴁𐴡𐴕𐴞𐴎𐴡𐴒𐴧𐴡𐴘;</para>
  <para style="q1" vid="ROM 11:9">𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴝𐴘𐴧𐴡𐴤𐴑,</para>
  <para style="q2" vid="ROM 11:9">𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴈𐴝𐴔𐴡𐴌 𐴏𐴝𐴥𐴣𐴎𐴝 𐴉𐴡𐴗𐴑.<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴧𐴡𐴘,</para>
  <para style="q2" vid="ROM 11:10">𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡 𐴊𐴠𐴑𐴠𐴥;</para>
  <para style="q2" vid="ROM 11:10">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝𐴓𐴧𐴝 𐴒𐴟𐴎𐴝 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴧𐴡𐴘.“<note caller="+" style="f"><char style="fr" closed="false">11‏:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:22">𐴎𐴡𐴁𐴟𐴌 69‏:22</ref>‏,<ref loc="PSA 69:23">23</ref></char></char></note><verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴣𐴀𐴌 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥 𐴀𐴟𐴅𐴝𐴥𐴄𐴢 𐴇𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝𐴓𐴧𐴝 𐴉𐴡𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴕𐴠𐴥؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡. 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴝𐴌 𐴔𐴡𐴦𐴗𐴑𐴝 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴒𐴝𐴘𐴌𐴡𐴃𐴢 𐴓𐴝𐴒𐴠. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />𐴇𐴠𐴥 𐴇𐴝𐴥𐴓𐴡𐴃𐴠 𐴁𐴟𐴎𐴝𐴥 𐴎𐴝 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕𐴞𐴘𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴓𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴉𐴝𐴥𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴓𐴟𐴏𐴧𐴝𐴥𐴕𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴉𐴝𐴥𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴃𐴡𐴥𐴘 𐴁𐴝𐴏𐴝𐴥𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴃𐴡𐴥 𐴉𐴝𐴥𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌!<verse eid="ROM 11:12" /></para>
  <para style="s1">𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴕𐴠𐴅𐴝𐴃𐴢</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />𐴀𐴡𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠. 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴁𐴝𐴕𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥 𐴎𐴞𐴔𐴧𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴊𐴞, <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />𐴎𐴠𐴀𐴕𐴠 𐴇𐴡𐴕𐴡𐴤 𐴁𐴡𐴃𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴑𐴡𐴗𐴔𐴡𐴌𐴠 𐴒𐴝𐴘𐴌𐴡𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴊𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝 𐴁𐴝𐴘 𐴉𐴝𐴌𐴞. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴓𐴧𐴝 𐴓𐴧𐴡𐴘 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴁𐴡𐴕𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌؟ 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴔𐴡𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴌 𐴉𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴁𐴡! <verse eid="ROM 11:15" /><verse number="16" style="v" sid="ROM 11:16" />𐴎𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴌𐴟𐴄𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥 𐴌𐴟𐴄𐴞 𐴂𐴝𐴑 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴌𐴟𐴄𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴂𐴝𐴑. 𐴒𐴝𐴏𐴡𐴌 𐴐𐴞𐴥𐴛𐴡𐴌 𐴂𐴝𐴑 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴂𐴝𐴑.<verse eid="ROM 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17" />𐴊𐴡𐴥𐴌𐴡, 𐴀𐴠𐴑 𐴎𐴝𐴘𐴃𐴟𐴕-𐴒𐴝𐴏𐴡𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴔𐴝𐴎𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴅𐴡𐴚𐴒𐴡𐴓𐴞 𐴎𐴝𐴘𐴃𐴟𐴕-𐴒𐴝𐴏𐴡𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴟𐴌𐴝𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴎𐴝𐴘𐴃𐴟𐴕-𐴒𐴝𐴏𐴡𐴌 𐴐𐴞𐴥𐴛𐴡𐴌𐴡𐴃𐴧𐴟 𐴌𐴡𐴐𐴢 𐴄𐴝𐴕𐴞 𐴓𐴡𐴦𐴌. <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴇𐴠𐴥 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴒𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴝𐴌𐴞𐴥𐴑 𐴁𐴡𐴥𐴓𐴞 𐴕𐴡 𐴄𐴝𐴥𐴀𐴌𐴞𐴘𐴡, 𐴎𐴡𐴊𐴞 𐴄𐴝𐴥𐴀𐴌𐴡, 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥𐴘𐴡 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴞𐴥𐴛𐴡𐴌𐴡𐴌𐴠 𐴄𐴞𐴑𐴝𐴘 𐴌𐴝𐴑𐴡𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴐𐴞𐴥𐴛𐴡𐴌𐴠 𐴄𐴞𐴑𐴝𐴘 𐴌𐴝𐴑𐴠𐴥𐴌 𐴊𐴠. <verse eid="ROM 11:18" /><verse number="19" style="v" sid="ROM 11:19" />𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴁𐴝𐴤, ”𐴇𐴠𐴥 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴒𐴟𐴥𐴕 𐴁𐴝𐴥𐴣𐴒𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴎𐴟𐴌𐴝 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝.“ <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴏𐴡𐴥𐴘𐴧𐴞. 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴃𐴡 𐴀𐴞𐴔𐴝𐴕 𐴎𐴝𐴌𐴞 𐴕𐴡 𐴌𐴝𐴑𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴠𐴥𐴕𐴝 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴀𐴛 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴠 𐴁𐴠 𐴄𐴞𐴑𐴞 𐴀𐴝𐴏𐴡𐴤. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴥𐴘 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴘 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴋𐴡𐴦𐴌 𐴌𐴝𐴑𐴡𐴥; <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴏𐴡𐴥𐴓𐴞 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴏𐴝𐴘 𐴕𐴡𐴥 𐴌𐴝𐴑𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴘𐴡𐴥 𐴁𐴝𐴏𐴝𐴘 𐴕𐴡 𐴌𐴝𐴑𐴞𐴥𐴁𐴡.<verse eid="ROM 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴏𐴡𐴀, 𐴀𐴝𐴓𐴧𐴝 𐴑𐴠𐴀𐴕 𐴔𐴠𐴀𐴌𐴁𐴝𐴕 𐴀𐴝𐴦𐴌 𐴑𐴠𐴀𐴕 𐴈𐴡𐴌𐴝: 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴥𐴁𐴝 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴌𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴥𐴁𐴝 𐴔𐴠𐴀𐴌𐴁𐴝𐴕; 𐴇𐴠𐴥 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞 𐴀𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴃𐴝𐴥𐴑𐴞𐴁𐴡 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞𐴃𐴢 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑𐴡. 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴘𐴡𐴥 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴎𐴡𐴊𐴞 𐴀𐴝𐴁𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴏𐴡𐴃𐴢 𐴀𐴝𐴁𐴝𐴌 𐴎𐴟𐴌𐴝𐴊𐴞𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴁𐴝𐴌 𐴎𐴟𐴌𐴝 𐴊𐴞 𐴉𐴝𐴌𐴠. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴊𐴠 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴅𐴡𐴚𐴒𐴡𐴓𐴞 𐴎𐴝𐴘𐴃𐴟𐴕-𐴒𐴝𐴏𐴡𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴞 𐴋𐴠𐴥𐴀𐴘𐴓𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴈𐴝𐴍𐴞 𐴓𐴡𐴦𐴘𐴢 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴃𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴁𐴝𐴒𐴝𐴕𐴡𐴌 𐴎𐴝𐴘𐴃𐴟𐴕-𐴒𐴝𐴏𐴡𐴃𐴢 𐴎𐴟𐴌𐴝𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. 𐴃𐴡𐴥𐴘 𐴁𐴝𐴥𐴉𐴞𐴏𐴡, 𐴎𐴞𐴀𐴕 𐴇𐴠𐴥 𐴁𐴝𐴒𐴝𐴕 𐴒𐴝𐴏𐴡𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴞 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴏𐴡𐴃𐴢 𐴀𐴝𐴁𐴝𐴌 𐴎𐴟𐴌𐴝 𐴊𐴞𐴃𐴠 𐴇𐴡𐴃𐴡𐴥 𐴀𐴝𐴏𐴝𐴤𐴕 𐴀𐴡𐴥𐴘𐴁𐴡!<verse eid="ROM 11:24" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴓𐴧𐴝</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴊𐴧𐴟𐴥𐴌 𐴕𐴡 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴒𐴞𐴘𐴝𐴕𐴞 𐴁𐴡𐴓𐴞 𐴕𐴡 𐴄𐴝𐴥𐴀𐴌𐴞 𐴁𐴡𐴓𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠 𐴒𐴟𐴉𐴡𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴌, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴞𐴓𐴢 𐴀𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴊𐴡𐴌𐴡𐴤 𐴃𐴝𐴥𐴑𐴞𐴁𐴡 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴁𐴝𐴙𐴐𐴧𐴝𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴕𐴡𐴥 𐴉𐴝𐴦; <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴀𐴕𐴒𐴡𐴌𐴞 𐴃𐴝𐴔𐴝𐴥𐴔 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="ROM 11:26">”𐴏𐴞𐴥𐴘𐴡𐴕𐴡𐴃𐴧𐴟 𐴌𐴠𐴇𐴝𐴥𐴘-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴝𐴘𐴁𐴡𐴤,</para>
  <para style="q2" vid="ROM 11:26">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴃𐴧𐴟 𐴃𐴝𐴔𐴝𐴥𐴔 𐴁𐴠𐴊𐴞𐴕𐴞 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝,</para>
  <para style="q2" vid="ROM 11:27">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔.“<note caller="+" style="f"><char style="fr" closed="false">11‏:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 59:20">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 59‏:20</ref>‏,<ref loc="ISA 59:21">21</ref>; <ref loc="ISA 27:9">27‏:9</ref></char> <char style="xt"><ref loc="JER 31:33">𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝 31‏:33</ref>‏,<ref loc="JER 31:34">34</ref></char></char></note><verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴇𐴠𐴥 𐴌𐴟𐴥𐴖𐴝𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴝𐴥𐴘𐴊𐴝𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴝𐴥𐴌 𐴇𐴠𐴥 𐴌𐴟𐴥𐴖𐴝𐴃𐴠 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴒𐴟𐴥𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴝𐴊𐴡𐴌𐴁𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢; <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴠 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴊𐴠𐴦 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴋𐴝𐴑𐴠, 𐴇𐴞𐴥𐴀𐴕𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕 𐴁𐴡𐴊𐴡𐴓𐴞 𐴕𐴡 𐴎𐴝𐴒𐴡𐴥𐴘. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴠𐴑 𐴇𐴝𐴓𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴘𐴝𐴓𐴝 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴁𐴡𐴕𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴘𐴡𐴥 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴃𐴡 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕𐴞𐴃𐴢 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠.<verse eid="ROM 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴢 𐴇𐴡𐴃𐴡𐴥 𐴁𐴞𐴐𐴞𐴤! 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴞𐴘𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴊𐴧𐴞𐴥 𐴇𐴡𐴃𐴡𐴥 𐴔𐴟𐴌!</para>
  <para style="q2" vid="ROM 11:33">𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝𐴌𐴠 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴌𐴝 𐴕𐴡 𐴎𐴝.</para>
  <para style="q2" vid="ROM 11:33">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴌𐴝𐴀 𐴕𐴝𐴥𐴘.<verse eid="ROM 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴇𐴡𐴕𐴠 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴌𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴠؟</para>
  <para style="q2" vid="ROM 11:34">𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴡𐴐𐴖𐴝𐴌𐴝 𐴊𐴞𐴁𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟“<note caller="+" style="f"><char style="fr" closed="false">11‏:34 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:13">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 40‏:13</ref></char></char></note><verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />”𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴡𐴕𐴠 𐴑𐴞𐴦 𐴊𐴞𐴀𐴓𐴢 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q2" vid="ROM 11:35">𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴉𐴟𐴥𐴣𐴎𐴝𐴘 𐴊𐴞𐴥𐴘𐴝 𐴉𐴡𐴙𐴃𐴧𐴡؟“<note caller="+" style="f"><char style="fr" closed="false">11‏:35 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 41:11">𐴀𐴝𐴘𐴟𐴁𐴢 41‏:11</ref></char></char></note><verse eid="ROM 11:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴥𐴕𐴝 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴄𐴞𐴑𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴓𐴧𐴝.</para>
  <para style="q2" vid="ROM 11:36">𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴡𐴘𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞𐴌𐴠 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴞 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴝𐴦𐴌𐴠 𐴎𐴞𐴕𐴊𐴝, 𐴂𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴑𐴡𐴁𐴟𐴓𐴊𐴝𐴥𐴌 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴌𐴡𐴤; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴑𐴡𐴉𐴞𐴥𐴘𐴡𐴃𐴢 𐴕𐴡 𐴓𐴡𐴘𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴡𐴘𐴝 𐴊𐴠𐴔𐴝𐴑 𐴊𐴞𐴦𐴘𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴡𐴊𐴡𐴙𐴓𐴃𐴡 𐴊𐴡. 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞𐴁𐴝𐴥, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴑𐴞𐴦, 𐴒𐴡𐴔 𐴑𐴞𐴦, 𐴑𐴡𐴁𐴟𐴓𐴊𐴝𐴥𐴌 𐴑𐴞𐴦, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴄𐴞 𐴑𐴞𐴦.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴃𐴡𐴖𐴉𐴞𐴥𐴑𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴎𐴠𐴃𐴧𐴡𐴥𐴌 𐴁𐴝𐴥𐴉𐴡𐴕 𐴏𐴝𐴥, 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴕𐴡 𐴁𐴝𐴥𐴉𐴞𐴘𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴝𐴌𐴠𐴥 𐴎𐴠𐴊𐴧𐴟𐴥𐴌 𐴀𐴞𐴔𐴝𐴕 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴇𐴠𐴥 𐴔𐴡𐴎𐴞𐴕 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴁𐴝𐴥𐴉𐴡. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴝𐴦𐴃𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴈𐴝𐴔 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴕𐴡, <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴑 𐴒𐴝𐴦, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴡𐴘 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴝𐴎𐴝𐴥𐴘𐴧𐴝 𐴀𐴝𐴏𐴞𐴤. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴘𐴧𐴞𐴥. 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴔𐴟𐴃𐴝𐴁𐴠𐴑 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥; <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />𐴎𐴡𐴊𐴞 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴁𐴝𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴡𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴡; <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴅𐴡𐴏𐴁𐴝 𐴊𐴞𐴁𐴝𐴌 𐴉𐴝𐴘𐴧𐴡𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴅𐴡𐴏𐴁𐴝 𐴊𐴡; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴉𐴝𐴘𐴧𐴡𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴊𐴞𐴓𐴑𐴟𐴥𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴌𐴡𐴤; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴉𐴝𐴘𐴧𐴡𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴊𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴞 𐴒𐴡𐴌𐴡𐴤; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴉𐴝𐴘𐴧𐴡𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤.<verse eid="ROM 12:8" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴕𐴞𐴘𐴡𐴔</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑𐴞 𐴏𐴝𐴥𐴌𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. 𐴈𐴡𐴥𐴌𐴝𐴉𐴞𐴌𐴠 𐴒𐴞𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴊𐴡𐴥𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴡. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴓𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴊𐴞𐴘𐴡; <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />𐴀𐴝𐴓𐴐𐴞𐴤 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴅𐴡𐴏𐴁𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />𐴀𐴝𐴐𐴝𐴤𐴘𐴠 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴡, 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴏𐴡𐴁𐴡𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴕𐴞𐴃𐴧𐴞 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴡; <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴡𐴃𐴢 𐴉𐴡𐴙𐴓𐴧𐴠 𐴏𐴝𐴣𐴊𐴝 𐴊𐴞𐴦𐴘𐴡; 𐴔𐴠𐴀𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴔𐴝𐴒𐴞𐴘𐴡𐴥; 𐴀𐴡𐴥𐴘, 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴕𐴡, 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴔𐴝𐴒𐴞𐴘𐴡𐴥. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴘𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴒𐴡𐴌𐴞𐴥𐴘𐴡. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴠𐴑 𐴑𐴞𐴥𐴘𐴝𐴓𐴠 𐴏𐴝𐴘𐴧𐴡𐴥. 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴘 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴔𐴞𐴘𐴝𐴥𐴘-𐴎𐴟𐴖𐴝𐴘 𐴏𐴡𐴓𐴞𐴘𐴡𐴥. 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴁𐴟𐴊𐴧𐴞𐴥𐴔𐴝𐴕 𐴕𐴡 𐴄𐴝𐴥𐴀𐴌𐴞𐴘𐴡.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴁𐴟𐴌𐴝𐴙𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴁𐴟𐴌𐴝𐴘 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴎𐴞𐴘𐴝𐴥𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴥𐴘𐴡. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴓𐴡𐴥𐴘 𐴐𐴝𐴥𐴕𐴃𐴞𐴃𐴢 𐴃𐴝𐴥𐴑𐴞 𐴁𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴎𐴠𐴊𐴧𐴟𐴥𐴌 𐴉𐴝𐴌𐴡 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴕𐴞𐴎𐴠𐴁𐴝𐴎𐴠 𐴁𐴡𐴊𐴡𐴓𐴝 𐴕𐴡 𐴓𐴡𐴘𐴧𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴦𐴗𐴑𐴝 𐴌𐴝𐴙𐴑𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴔𐴝𐴁𐴟𐴊𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴌, ”𐴁𐴡𐴊𐴡𐴓𐴝 𐴓𐴡𐴕 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴔, 𐴀𐴝𐴀𐴛 𐴉𐴟𐴥𐴣𐴎𐴝𐴘𐴧𐴟𐴔.“<note caller="+" style="f"><char style="fr" closed="false">12‏:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:35">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 32‏:35</ref></char> </char></note> <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />𐴘𐴝𐴥𐴌𐴁𐴡𐴊𐴡𐴓𐴢,</para>
  <para style="q1" vid="ROM 12:20">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴟𐴐𐴧𐴡𐴕𐴡𐴃𐴧𐴟 𐴁𐴟𐴥𐴑 𐴓𐴝𐴒𐴞𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴊𐴡𐴦;</para>
  <para style="q2" vid="ROM 12:20">𐴃𐴞𐴌𐴝𐴥𐴐𐴢 𐴓𐴝𐴒𐴞𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴉𐴝𐴕𐴞𐴥 𐴊𐴡𐴦.</para>
  <para style="q1" vid="ROM 12:20">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴓𐴠 𐴃𐴡 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴇𐴡𐴘𐴓𐴝𐴌 𐴄𐴝𐴓𐴢 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴘𐴡 𐴉𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">12‏:20 </char><char style="ft" closed="false">𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴡𐴏𐴡𐴕. 𐴔𐴝𐴃𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴇𐴡𐴘𐴓𐴝𐴌 𐴄𐴝𐴓𐴢 𐴃𐴟𐴓𐴞𐴤 𐴊𐴡𐴦𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴐𐴡𐴥𐴌𐴡𐴔𐴠 𐴉𐴟𐴌𐴝𐴁𐴡𐴕. </char></note><note caller="+" style="f"><char style="fr" closed="false">12‏:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 25:21">𐴔𐴠𐴀𐴏𐴝𐴓𐴢 25‏:21</ref>‏,<ref loc="PRO 25:22">22</ref></char></char></note><verse eid="ROM 12:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21" />𐴁𐴟𐴌𐴝𐴘𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴃𐴡𐴤 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴝𐴥𐴓𐴝𐴘 𐴓𐴡𐴥𐴘 𐴁𐴟𐴌𐴝𐴘𐴌𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴙𐴐𐴧𐴡𐴥.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s1">𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴌 𐴀𐴝𐴙𐴕-𐴑𐴝𐴦𐴕𐴟𐴕 𐴔𐴝𐴕𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />𐴇𐴝𐴥𐴀𐴌 𐴀𐴠𐴑𐴎𐴡𐴕𐴠 𐴊𐴠𐴐𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴕𐴞 𐴏𐴡𐴓𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴕𐴡 𐴊𐴠 𐴇𐴡𐴕𐴡𐴤 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴕𐴝𐴥𐴘. 𐴎𐴠𐴊𐴟𐴥𐴕 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴁𐴠 𐴎𐴝𐴌𐴞 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴌 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴠 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴒𐴡𐴌𐴠𐴥. 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴁𐴞𐴏𐴝𐴌𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴁𐴝𐴕𐴝. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴃𐴡 𐴀𐴝𐴊𐴞𐴑𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴁𐴝𐴥𐴌 𐴕𐴝𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴑𐴟𐴈𐴝𐴔 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴋𐴡𐴦𐴌𐴝𐴘𐴁𐴝𐴥𐴌 𐴀𐴝𐴏𐴠𐴤. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴊𐴞𐴑𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴦𐴌 𐴏𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴕𐴠𐴥؟ 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴡𐴤, 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴉𐴝𐴘𐴁𐴝; <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴥𐴓𐴝𐴘 𐴓𐴧𐴝. 𐴓𐴠𐴑𐴞𐴕 𐴎𐴡𐴊𐴞 𐴑𐴟𐴈𐴝𐴔 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴁𐴝𐴥𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴇𐴝𐴥𐴕𐴧𐴝𐴑 𐴏𐴝𐴥𐴣𐴎𐴝 𐴕𐴡 𐴊𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴡𐴥𐴘 𐴑𐴟𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴠𐴥 𐴊𐴠. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴕𐴞 𐴏𐴡𐴓𐴝𐴌 𐴎𐴡𐴌𐴟𐴌; 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴏𐴝𐴥𐴣𐴎𐴝𐴌 𐴋𐴡𐴦𐴌𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴁𐴟𐴎𐴞𐴥𐴘𐴡𐴌𐴠 𐴘𐴡𐴥.<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴘𐴡𐴥 𐴊𐴡𐴦, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴡𐴥𐴑 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴎𐴝𐴌𐴠𐴥 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴊𐴞𐴦𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴊𐴞𐴦𐴘𐴡; 𐴎𐴝𐴌𐴠𐴥 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴊𐴞𐴦𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴊𐴞𐴦𐴘𐴡; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴎𐴧𐴡𐴃𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴝𐴦𐴌𐴞𐴉𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.<verse eid="ROM 13:7" /></para>
  <para style="s1">𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴙𐴅𐴧𐴝𐴥</para>
  <para style="r">(<ref loc="MRK 12:31">𐴔𐴝𐴑 12‏:31</ref>; <ref loc="JAS 2:8">𐴘𐴝𐴑 2‏:8</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴒𐴟𐴕𐴡𐴌 𐴃𐴡𐴓𐴠 𐴕𐴡 𐴃𐴝𐴥𐴙𐴑𐴧𐴡. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, ”𐴎𐴠𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝; 𐴑𐴟𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝; 𐴏𐴟𐴌𐴞 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝; 𐴓𐴝𐴓𐴡𐴥𐴏𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝,“<note caller="+" style="f"><char style="fr" closed="false">13‏:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:13-15">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 20‏:13‏-15</ref>‏,<ref loc="EXO 20:17">17</ref></char>; <char style="xt"><ref loc="DEU 5:17-19">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 5‏:17‏-19</ref>‏,<ref loc="DEU 5:21">21</ref></char> </char></note> 𐴀𐴞𐴀𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴇𐴡𐴥𐴑𐴟𐴔 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, ”𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤.“<note caller="+" style="f"><char style="fr" closed="false">13‏:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 19‏:18</ref></char></char></note> <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴇𐴡𐴥𐴃𐴞 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴉𐴟𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴙𐴅𐴧𐴝𐴥.<verse eid="ROM 13:10" /></para>
  <para style="s1">𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴊𐴞𐴕 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />𐴀𐴠𐴇𐴡𐴥𐴕𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴁𐴟𐴎𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴡𐴤. 𐴒𐴟𐴥𐴔𐴡𐴃𐴧𐴟 𐴀𐴟𐴍𐴞𐴤𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠𐴒𐴝𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤𐴓𐴝𐴔 𐴇𐴞𐴥𐴘𐴝𐴓𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴠𐴅𐴝𐴃𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴌𐴡𐴤 𐴋𐴝𐴥𐴑𐴠. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />𐴌𐴝𐴙𐴃𐴢 𐴉𐴟𐴥𐴌𐴡𐴕-𐴉𐴟𐴥𐴌𐴡𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴘𐴝𐴓𐴝 𐴉𐴡𐴥𐴎𐴡𐴌 𐴉𐴝𐴥𐴍𐴞𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴡𐴥𐴌𐴒𐴝𐴘. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞 𐴉𐴡𐴀𐴌𐴡𐴌 𐴀𐴝𐴥𐴃𐴞𐴘𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴞𐴕𐴊𐴞𐴥 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴡𐴥𐴘 𐴃𐴝𐴥𐴑𐴞. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴐𐴡𐴥𐴌𐴝𐴁𐴞𐴌 𐴉𐴟𐴥𐴌𐴟𐴃𐴞, 𐴕𐴞𐴐𐴝𐴥𐴁𐴝𐴎𐴞, 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞, 𐴀𐴝𐴘𐴝𐴐𐴞, 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴞𐴚𐴝𐴛 𐴁𐴝𐴊𐴢 𐴊𐴞, 𐴊𐴞𐴕𐴡𐴌 𐴉𐴡𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴞𐴤 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴏𐴡𐴓𐴞. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴉𐴞𐴕𐴊𐴞𐴥𐴉𐴠𐴓𐴡, 𐴀𐴝𐴦𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴁𐴟𐴌𐴝 𐴀𐴝𐴎𐴧𐴟 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴎𐴟 𐴇𐴡𐴕𐴡𐴤 𐴊𐴞𐴥𐴘𐴝𐴕 𐴕𐴡 𐴊𐴞.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s1">𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴕𐴡 𐴊𐴡𐴥𐴙𐴅𐴧𐴡</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴡𐴓𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴋𐴝𐴀𐴘𐴡𐴃𐴢 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴌𐴝𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴃𐴡𐴌𐴑𐴝𐴃𐴡𐴌𐴑𐴞 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴇𐴝𐴥𐴘 𐴉𐴝𐴌𐴠; 𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴔𐴝𐴕 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴞𐴌𐴞𐴐𐴧𐴝𐴤 𐴁𐴠 𐴈𐴝𐴥𐴀. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴡𐴥𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴝 𐴈𐴝𐴥𐴀 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴈𐴡𐴥𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴥𐴀 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴘𐴡𐴥 𐴃𐴡 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴒𐴟𐴓𐴝𐴔𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴃𐴟𐴀𐴛 𐴇𐴡𐴕؟ 𐴀𐴞𐴥𐴃𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴀𐴠𐴥𐴕𐴝 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴓𐴞𐴑 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴊𐴞𐴕 𐴀𐴠𐴒𐴧𐴗𐴝𐴤𐴌𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴊𐴞𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴑𐴞𐴔𐴡𐴃𐴞 𐴁𐴡𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴊𐴞𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴑𐴞𐴔𐴡𐴃𐴢 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴁𐴡𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴠. 𐴇𐴝𐴥𐴀𐴌 𐴀𐴠𐴑𐴎𐴡𐴕𐴡𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴠𐴑𐴞𐴕 𐴃𐴝𐴥𐴑𐴝𐴌 𐴎𐴡𐴌𐴟𐴌. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />𐴎𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴎𐴠 𐴊𐴞𐴕𐴡𐴌𐴠 𐴈𐴝𐴥𐴀𐴏𐴢 𐴁𐴡𐴥𐴓𐴞 𐴔𐴝𐴕𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴠 𐴀𐴠𐴥𐴕𐴝 𐴔𐴝𐴕𐴠. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴝𐴥𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴠 𐴁𐴠 𐴈𐴝𐴥𐴀, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥 𐴈𐴝𐴥𐴀. 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝 𐴈𐴝𐴥𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴠 𐴁𐴠 𐴕𐴝 𐴈𐴝𐴥𐴀, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴎𐴞𐴀𐴕 𐴈𐴝𐴥𐴀 𐴇𐴞𐴥𐴀𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴠𐴥. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞 𐴊𐴠 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴔𐴡𐴌𐴞 𐴊𐴠 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴕𐴡. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴓𐴧𐴝 𐴁𐴠 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴡𐴌𐴞𐴎𐴝𐴘𐴒𐴡𐴥𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴓𐴧𐴝 𐴁𐴠 𐴔𐴡𐴌𐴞𐴎𐴝𐴘𐴒𐴡𐴥𐴘. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞 𐴘𐴝𐴥 𐴔𐴡𐴌𐴞𐴎𐴝𐴘𐴒𐴡𐴥𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴃𐴡 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴠𐴥𐴕𐴝 𐴔𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴌𐴝 𐴎𐴞𐴕𐴊𐴝 𐴊𐴟𐴕𐴞𐴥 𐴒𐴟𐴥𐴕𐴡𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴡𐴥.<verse eid="ROM 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 14:10" />𐴃𐴡𐴥𐴘 𐴃𐴟𐴀𐴛 𐴑𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴡𐴥𐴌𐴡𐴌؟ 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴑𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴡𐴤𐴌؟ 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡 𐴀𐴠𐴑 𐴊𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴝𐴊𐴝𐴓𐴡𐴃𐴞-𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴟𐴔 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="ROM 14:11">”𐴔𐴝𐴁𐴟𐴊𐴠 𐴉𐴡𐴥𐴌𐴔𐴝𐴌 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌 𐴎𐴞𐴕𐴊𐴝𐴒𐴞𐴌𐴞𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘 𐴈𐴡𐴀𐴙𐴌,</para>
  <para style="q2" vid="ROM 14:11">𐴇𐴝𐴥𐴀𐴌 𐴀𐴠𐴑𐴎𐴡𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴣𐴍𐴟𐴥 𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡,</para>
  <para style="q2" vid="ROM 14:11">𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴎𐴡𐴁𐴝𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝 𐴊𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">14‏:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 45:23">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 45‏:23</ref></char></char></note><verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴇𐴞𐴥𐴏𐴝𐴉𐴢 𐴊𐴞𐴥𐴘𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.<verse eid="ROM 14:12" /></para>
  <para style="s1">𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴝𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴝𐴌 𐴕𐴡 𐴊𐴡𐴥𐴌𐴞, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴟𐴀𐴙𐴕 𐴕𐴡 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴎𐴞𐴀𐴕𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴁𐴝𐴥𐴘𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴋𐴝𐴥𐴁𐴧𐴝 𐴊𐴞𐴥𐴁𐴡, 𐴘𐴝𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴝 𐴁𐴝𐴘𐴁𐴡𐴥. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴑𐴞, 𐴇𐴡𐴕𐴡𐴤 𐴈𐴝𐴥𐴕𐴝 𐴕𐴞𐴎𐴠𐴁𐴝𐴎𐴠 𐴇𐴝𐴥𐴌𐴝𐴔 𐴕𐴝𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦 𐴎𐴠 𐴈𐴝𐴥𐴕𐴝𐴌𐴠 𐴇𐴝𐴥𐴌𐴝𐴔 𐴄𐴝𐴥𐴀𐴌𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴝 𐴁𐴠 𐴇𐴝𐴥𐴌𐴝𐴔. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴝𐴥𐴕𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴌𐴀𐴠𐴑 𐴁𐴝𐴥𐴘𐴧𐴠 𐴊𐴞𐴓𐴡𐴃𐴢 𐴊𐴟𐴑 𐴉𐴝𐴦, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴃𐴟𐴀𐴛 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴉𐴡𐴣𐴃𐴢 𐴁𐴝𐴥𐴘 𐴀𐴝𐴌 𐴕𐴡 𐴏𐴡𐴓𐴡𐴀𐴌. 𐴎𐴠 𐴁𐴝𐴥𐴘𐴡𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴔𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴇𐴠𐴥 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴝𐴥𐴕𐴝 𐴓𐴡𐴥𐴘 𐴐𐴡𐴥𐴌𐴁𐴡𐴕𐴝𐴐𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴔 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴕𐴡 𐴎𐴟𐴌𐴝𐴘𐴧𐴡𐴥, <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴈𐴝𐴥𐴕𐴝-𐴉𐴞𐴕𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴊𐴠𐴦 𐴊𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞, 𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴃𐴡𐴌𐴞𐴑𐴝𐴘𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝 𐴘𐴡𐴥 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴑𐴠 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥 𐴌𐴝𐴎𐴞 𐴃𐴝𐴥𐴑𐴠.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴈𐴝𐴔 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴎𐴞𐴀𐴕𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴝𐴕𐴠𐴤 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴁𐴝𐴕𐴝𐴘𐴃𐴟𐴓𐴞𐴤 𐴉𐴝𐴙𐴅𐴧𐴟𐴔. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />𐴇𐴡𐴕𐴡𐴤 𐴈𐴝𐴥𐴕𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴔 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. 𐴁𐴠𐴐𐴡𐴥𐴑, 𐴈𐴝𐴥𐴕𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴇𐴝𐴥𐴓𐴝𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴝𐴁𐴝 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴈𐴝𐴥𐴕𐴝 𐴈𐴡𐴥𐴀𐴕 𐴒𐴡𐴓𐴧𐴡𐴃𐴢. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />𐴁𐴠𐴀𐴃𐴡𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴒𐴟𐴏𐴧𐴡 𐴕𐴡 𐴈𐴡𐴥𐴀𐴕, 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴕𐴡 𐴈𐴡𐴥𐴀𐴕, 𐴘𐴝𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤𐴕, 𐴎𐴡𐴊𐴞 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴡𐴕𐴡𐴤 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴝𐴁𐴝.<verse eid="ROM 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 14:22" />𐴇𐴠𐴥 𐴔𐴡𐴏𐴡𐴥𐴓𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴎𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴌𐴝𐴑𐴡𐴥. 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴠, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴡𐴔 𐴁𐴡𐴓𐴞 𐴁𐴟𐴎𐴞𐴥 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴕𐴝 𐴇𐴝𐴥. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴠𐴥 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴁𐴡𐴥𐴓𐴞 𐴊𐴡𐴥𐴌𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴐𐴡𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴔𐴡𐴎𐴞𐴕 𐴈𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴕𐴡. 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴒𐴟𐴕𐴝𐴤.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s1">𐴀𐴝𐴌𐴀𐴠𐴑 𐴎𐴡𐴕𐴡𐴌 𐴑𐴟𐴥𐴐𐴞 𐴏𐴡𐴀, 𐴕𐴞𐴎𐴡𐴌 𐴕𐴡</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴀𐴞𐴔𐴝𐴕 𐴔𐴡𐴎𐴁𐴟𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴥𐴐𐴞 𐴕𐴡 𐴏𐴝𐴀𐴘𐴢 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴣𐴎𐴝𐴤 𐴁𐴡𐴖𐴝𐴥𐴃𐴢 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴉𐴡𐴥𐴌𐴡𐴏𐴢. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴓𐴝𐴘 𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞 𐴌𐴝𐴑𐴝𐴤𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴝𐴕𐴝𐴘𐴃𐴟𐴓𐴞𐴤 𐴁𐴡𐴓𐴧𐴝. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴞𐴎𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴥𐴐𐴞 𐴕𐴡𐴥 𐴏𐴝𐴀. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.“<note caller="+" style="f"><char style="fr" closed="false">15‏:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:9">𐴎𐴡𐴁𐴟𐴌 69‏:9</ref></char></char></note> <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴐𐴞𐴥𐴑𐴧𐴝 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥𐴍𐴠 𐴎𐴠 𐴏𐴡𐴁𐴡𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴅𐴡𐴏𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴐𐴝𐴤 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥.<verse eid="ROM 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5" />𐴏𐴡𐴁𐴡𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴅𐴡𐴏𐴁𐴝 𐴊𐴡𐴦𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴠𐴑𐴞𐴤 𐴔𐴡𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴃𐴝𐴥𐴑𐴞 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴡𐴑, <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴑 𐴔𐴡𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑 𐴀𐴝𐴁𐴝𐴏𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴒𐴡𐴌𐴡𐴤.<verse eid="ROM 15:6" /></para>
  <para style="s1">𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴥. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />𐴀𐴝𐴀𐴛 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴀𐴘𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌<note caller="+" style="f"><char style="fr" closed="false">15‏:8 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑 𐴔𐴡𐴎𐴞𐴕، </char><char style="fqa" closed="false">𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</char></note> 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴁𐴡𐴙𐴕𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴒𐴟𐴥𐴕 𐴓𐴡𐴥𐴘 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴖𐴝𐴦𐴊𐴝 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠, <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />𐴀𐴝𐴦𐴌 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴠𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔 𐴉𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴠𐴥; 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="ROM 15:9">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔,</para>
  <para style="q2" vid="ROM 15:9">𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔𐴠 𐴏𐴠𐴀𐴌 𐴒𐴝𐴘𐴧𐴟𐴥𐴔.“<note caller="+" style="f"><char style="fr" closed="false">15‏:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="2SA 22:50">2 𐴏𐴠𐴥𐴔𐴟𐴀𐴠𐴓𐴢 22‏:50</ref></char>; <char style="xt"><ref loc="PSA 18:49">𐴎𐴡𐴁𐴟𐴌 18‏:49</ref></char></char></note><verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />𐴇𐴠𐴥𐴍𐴠 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="ROM 15:10">”𐴀𐴡𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤.“<note caller="+" style="f"><char style="fr" closed="false">15‏:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:43">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 32‏:43</ref></char></char></note><verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />𐴀𐴝𐴌𐴡𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞,</para>
  <para style="q1" vid="ROM 15:11">”𐴀𐴡𐴥 𐴃𐴝𐴔𐴝𐴥𐴔 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴡𐴤;</para>
  <para style="q2" vid="ROM 15:11">𐴀𐴡𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴡𐴤.“<note caller="+" style="f"><char style="fr" closed="false">15‏:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 117:1">𐴎𐴡𐴁𐴟𐴌 117‏:1</ref></char></char></note><verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴘𐴠 𐴘𐴡𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥,</para>
  <para style="q1" vid="ROM 15:12">”𐴅𐴠𐴏𐴞𐴌 𐴐𐴞𐴥𐴛𐴡𐴌 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡,</para>
  <para style="q2" vid="ROM 15:12">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴀𐴘𐴢 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</para>
  <para style="q2" vid="ROM 15:12">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴐𐴝𐴤 𐴌𐴝𐴑𐴞𐴥𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">15‏:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 11:10">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 11‏:10</ref></char></char></note><verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />𐴀𐴝𐴐𐴝𐴤 𐴊𐴡𐴦𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴑𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴥𐴐𐴞 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴓𐴡𐴥𐴘 𐴁𐴡𐴥𐴌𐴞 𐴊𐴡𐴑, 𐴎𐴠𐴀𐴕𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴁𐴝𐴀𐴘𐴢 𐴉𐴡𐴌𐴠.<verse eid="ROM 15:13" /></para>
  <para style="s1">𐴁𐴞𐴐𐴞𐴤 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴓𐴠𐴑𐴝𐴥𐴌 𐴖𐴝𐴅𐴝𐴤</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴠𐴑𐴞𐴕 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴁𐴝𐴥𐴓𐴝𐴘𐴞 𐴓𐴡𐴥𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴀𐴡𐴥. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴡𐴗𐴎𐴟𐴥𐴌 𐴖𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴞𐴐𐴞𐴤 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴓𐴡𐴥𐴘, <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />𐴀𐴝𐴀𐴛 𐴃𐴡 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴘𐴧𐴞. 𐴀𐴝𐴀𐴛 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴡𐴁𐴟𐴓𐴊𐴝𐴥𐴌 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴠.<verse eid="ROM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴈𐴝𐴔𐴡𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴖𐴝𐴅𐴝𐴤 𐴉𐴝𐴘𐴧𐴞𐴥. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴟𐴀𐴙𐴕 𐴇𐴡𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔, 𐴎𐴞𐴀𐴕 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥. 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴈𐴝𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴔 𐴓𐴡𐴘, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />𐴀𐴞𐴓𐴧𐴝𐴘𐴞-𐴕𐴞𐴐𐴝𐴥𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴡𐴌 𐴁𐴡𐴓𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴓𐴟𐴌𐴞𐴑𐴟𐴥𐴔 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />𐴀𐴝𐴣𐴀𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴕𐴞𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴟𐴍𐴠𐴤 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴡𐴤𐴕 𐴎𐴠𐴍𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡𐴥 𐴉𐴟𐴥𐴕𐴠, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴥𐴌 𐴁𐴝𐴕𐴝𐴘𐴃𐴟𐴓𐴞𐴤𐴌 𐴉𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="ROM 15:21">”𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴖𐴝𐴤 𐴕𐴡𐴥 𐴎𐴝,</para>
  <para style="q2" vid="ROM 15:21">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴝𐴓𐴝 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥;</para>
  <para style="q1" vid="ROM 15:21">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴕𐴡𐴥 𐴉𐴟𐴥𐴕𐴠,</para>
  <para style="q2" vid="ROM 15:21">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴝𐴓𐴝 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.“<note caller="+" style="f"><char style="fr" closed="false">15‏:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 52:15">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 52‏:15</ref></char> </char></note><verse eid="ROM 15:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="ROM 15:22" />𐴀𐴝𐴀𐴛 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴝𐴥𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴃𐴡𐴤 𐴏𐴝𐴀𐴘𐴢 𐴇𐴠𐴥 𐴖𐴝𐴅𐴝𐴤𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡𐴥 𐴉𐴝𐴌𐴞 𐴊𐴠.<verse eid="ROM 15:22" /></para>
  <para style="s1">𐴌𐴡𐴔𐴡𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴌 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴕𐴞𐴘𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴠𐴍𐴞𐴥𐴘𐴝𐴌 𐴀𐴠𐴓𐴝𐴑𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴝𐴒𐴝 𐴁𐴝𐴑𐴞 𐴕𐴝𐴥𐴘 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴃𐴡𐴤 𐴑𐴟𐴥𐴁𐴢 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴊𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠, <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠, 𐴀𐴠𐴏𐴂𐴠𐴥𐴙𐴕 𐴊𐴠𐴐𐴡𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴞𐴘𐴟𐴥𐴔, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴠𐴏𐴧𐴟𐴥 𐴄𐴝𐴙𐴔 𐴑𐴟𐴥𐴐𐴞-𐴀𐴝𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴈𐴝𐴍𐴝𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴙𐴌. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴑𐴝𐴘𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴏𐴝𐴣𐴊𐴝 𐴃𐴟𐴙𐴓𐴧𐴠𐴥. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴡𐴥𐴌𐴡𐴏𐴢 𐴀𐴡𐴥. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴁𐴝𐴥𐴒𐴢 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴔𐴝𐴓𐴏𐴝𐴥𐴔𐴝𐴕 𐴓𐴡𐴥𐴘 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴉𐴡𐴥𐴌𐴡𐴏𐴢. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />𐴀𐴝𐴀𐴛 𐴇𐴠𐴥 𐴏𐴝𐴣𐴊𐴝 𐴒𐴟𐴥𐴕 𐴉𐴡𐴀𐴣𐴏𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴥𐴃𐴠-𐴀𐴝𐴥𐴃𐴠 𐴉𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴝𐴑𐴧𐴝𐴉𐴝𐴑𐴧𐴞 𐴒𐴡𐴌𐴞 𐴎𐴝𐴙𐴕𐴧𐴟𐴔, 𐴀𐴝𐴀𐴛 𐴀𐴠𐴏𐴂𐴠𐴥𐴙𐴕 𐴊𐴠𐴐𐴡𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴒𐴡𐴥𐴓𐴞𐴘𐴟𐴔. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴓𐴝, 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴧𐴡𐴌𐴠 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴝𐴔𐴠 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴁𐴡𐴥𐴚 𐴀𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴊𐴞𐴓𐴔𐴡𐴕 𐴊𐴞 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞 𐴉𐴝𐴥𐴕, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴓𐴧𐴝 𐴎𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴡𐴏𐴡𐴥𐴕 𐴓𐴝𐴒𐴠 𐴉𐴝𐴥𐴕, <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴏𐴝𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴀𐴘𐴢 𐴉𐴝𐴌𐴞, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞 𐴉𐴡𐴌𐴝𐴕 𐴎𐴟𐴌𐴝𐴘 𐴉𐴝𐴌𐴞. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />𐴐𐴝𐴥𐴕𐴃𐴞 𐴊𐴡𐴦𐴘𐴝 𐴀𐴝𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s1">𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />𐴉𐴡𐴘𐴁𐴞 𐴕𐴝𐴔𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴠 𐴁𐴡𐴥𐴙𐴕 𐴑𐴞𐴕𐴑𐴞𐴥𐴌𐴞𐴘𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔, 𐴇𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴐𐴖𐴝𐴌𐴝 𐴊𐴞𐴌 𐴊𐴠, <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴕𐴝𐴔𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴒𐴡𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴡 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴏𐴞𐴥𐴓𐴡𐴖𐴝𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝 𐴎𐴠 𐴔𐴡𐴊𐴡𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴀𐴃𐴝𐴐𐴢 𐴀𐴡𐴥, 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴦𐴘𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴐𐴡𐴥𐴀 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="ROM 16:2" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="3" style="v" sid="ROM 16:3" />𐴂𐴌𐴞𐴏𐴞𐴥𐴓𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑𐴟𐴥𐴘𐴓𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴀𐴛 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴒𐴡𐴌𐴠𐴥.<verse eid="ROM 16:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="ROM 16:5" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥.</para>
  <para style="li1" vid="ROM 16:5">𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴞𐴂𐴠𐴕𐴞𐴥𐴃𐴟𐴏𐴡𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴠𐴐𐴞𐴥𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴀𐴟𐴔𐴧𐴡𐴃𐴢.<verse eid="ROM 16:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="ROM 16:6" />𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="ROM 16:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="ROM 16:7" />𐴀𐴝𐴕𐴊𐴌𐴟𐴕𐴞𐴑𐴟𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴅𐴟𐴀𐴕𐴞𐴘𐴝𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴑𐴡𐴗𐴔𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴞𐴘𐴡𐴥𐴓𐴢 𐴇𐴝𐴥𐴙𐴄𐴧𐴞𐴓𐴢. 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴕𐴝𐴔𐴊𐴝𐴥𐴌; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴏𐴠𐴤.<verse eid="ROM 16:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="ROM 16:8" />𐴀𐴝𐴔𐴂𐴠𐴓𐴞𐴘𐴝𐴃𐴝𐴏𐴡𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝.<verse eid="ROM 16:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="ROM 16:9" />𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴟𐴌𐴁𐴝𐴕𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴞𐴏𐴃𐴝𐴑𐴟𐴏𐴡𐴌𐴠 𐴘𐴡𐴥 𐴀𐴝𐴀𐴛 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥.<verse eid="ROM 16:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="ROM 16:10" />𐴀𐴝𐴂𐴠𐴓𐴞𐴏𐴡𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴉𐴝𐴦 𐴒𐴞𐴘𐴠𐴥.</para>
  <para style="li1" vid="ROM 16:10">𐴀𐴝𐴌𐴞𐴏𐴃𐴡𐴁𐴟𐴓𐴟𐴏𐴡𐴌 𐴒𐴡𐴥𐴌 𐴄𐴞𐴥𐴘𐴝𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥.<verse eid="ROM 16:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="ROM 16:11" />𐴇𐴠𐴥𐴌𐴡𐴊𐴞𐴘𐴡𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴑𐴡𐴗𐴔𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴕𐴝𐴌𐴑𐴞𐴏𐴧𐴟𐴏𐴡𐴌 𐴒𐴡𐴥𐴌 𐴄𐴞𐴥𐴘𐴝𐴌𐴠 𐴘𐴡𐴥 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤.<verse eid="ROM 16:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="ROM 16:12" />𐴃𐴟𐴌𐴉𐴠𐴥𐴕𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴌𐴉𐴡𐴥𐴏𐴞𐴔𐴝𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝.</para>
  <para style="li1" vid="ROM 16:12">𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴁𐴡𐴥𐴙𐴕 𐴉𐴠𐴌𐴞𐴥𐴏𐴝𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴑𐴟𐴥𐴁𐴢 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="ROM 16:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="ROM 16:13" />𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴌𐴟𐴉𐴟𐴏𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴝𐴦𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴝𐴦 𐴀𐴝𐴣𐴀𐴌 𐴀𐴡𐴥 𐴔𐴝𐴦.<verse eid="ROM 16:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="ROM 16:14" />𐴀𐴝𐴏𐴞𐴕𐴑𐴞𐴌𐴞𐴃𐴟𐴏𐴢, 𐴉𐴠𐴓𐴠𐴒𐴡𐴕, 𐴇𐴝𐴌𐴔𐴞𐴏𐴢, 𐴂𐴝𐴃𐴡𐴌𐴡𐴁𐴝𐴏𐴢, 𐴇𐴠𐴌𐴔𐴝𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴌 𐴎𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥.<verse eid="ROM 16:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="ROM 16:15" />𐴉𐴞𐴓𐴡𐴓𐴡𐴒𐴟𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴅𐴟𐴓𐴞𐴘𐴝 𐴌𐴠, 𐴕𐴠𐴌𐴞𐴘𐴟𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴥𐴙𐴕 𐴀𐴡𐴌𐴠, 𐴀𐴡𐴓𐴞𐴔𐴂𐴝𐴏𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴈𐴡𐴘𐴧𐴡𐴥.<verse eid="ROM 16:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="ROM 16:16" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴂𐴝𐴑 𐴊𐴞𐴓𐴠 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴡.</para>
  <para style="li1" vid="ROM 16:16">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌.<verse eid="ROM 16:16" /></para>
  <para style="b" />
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />𐴘𐴝𐴓𐴝, 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴝𐴘𐴧𐴡𐴥 𐴊𐴠 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴎𐴝𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴕𐴡𐴎𐴡𐴌 𐴌𐴝𐴑𐴞𐴥𐴘𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴑𐴞𐴘𐴡. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴠𐴄𐴢 𐴉𐴝𐴓𐴠𐴌 𐴊𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴞𐴍𐴝𐴤-𐴔𐴞𐴍𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴓𐴝𐴤𐴊𐴞𐴘𐴝 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡𐴀𐴘𐴢 𐴐𐴝𐴥𐴊𐴝-𐴐𐴞𐴥𐴊𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴊𐴝𐴒𐴝 𐴊𐴠. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌𐴞𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴈𐴝𐴕𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴌 𐴁𐴟𐴊𐴧𐴞𐴥𐴔𐴝𐴕 𐴀𐴡𐴥 𐴀𐴝𐴦𐴌 𐴑𐴟𐴈𐴝𐴔𐴡𐴃𐴧𐴟 𐴔𐴝𐴦𐴏𐴟𐴔 𐴃𐴝𐴥𐴑𐴡.<verse eid="ROM 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 16:20" />𐴐𐴝𐴥𐴕𐴃𐴞 𐴊𐴡𐴦𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴡𐴦𐴌 𐴃𐴡𐴓𐴠 𐴊𐴞 𐴉𐴞𐴐𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡.</para>
  <para style="p" vid="ROM 16:20">𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌 𐴑𐴡𐴗𐴔𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴟𐴑𐴞𐴥𐴘𐴝𐴏𐴢, 𐴘𐴝𐴏𐴡𐴕 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴏𐴞𐴂𐴝𐴃𐴠𐴌𐴠 𐴘𐴡𐴥 𐴎𐴝𐴕𐴝𐴌.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />𐴀𐴝𐴀𐴛 𐴃𐴠𐴌𐴃𐴞𐴘𐴟𐴏𐴢, 𐴎𐴝𐴌 𐴀𐴝𐴥𐴃𐴝 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴑𐴠𐴥𐴌, 𐴀𐴝𐴣𐴀𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴕𐴝𐴔𐴠 𐴏𐴡𐴥𐴓𐴝𐴔.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />𐴒𐴝𐴘𐴟𐴏𐴢, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴃𐴝𐴥𐴑𐴞 𐴀𐴝𐴦𐴌 𐴉𐴟𐴌𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌.</para>
  <para style="p" vid="ROM 16:23">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴑𐴠𐴐𐴞𐴥𐴘𐴝𐴌<note caller="+" style="f"><char style="fr" closed="false">16‏:23 </char><char style="ft" closed="false">𐴄𐴞𐴛𐴝-𐴉𐴡𐴘𐴐𐴝𐴤𐴌 𐴀𐴞𐴥𐴏𐴝𐴉𐴢 𐴌𐴝𐴑𐴝𐴤𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌</char></note> 𐴀𐴠𐴌𐴝𐴏𐴃𐴟𐴏𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘 𐴑𐴟𐴖𐴝𐴌𐴃𐴟𐴏𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌.<verse eid="ROM 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 16:24" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="ROM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />𐴀𐴝𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴔𐴡𐴎𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴁𐴝𐴕𐴝 𐴓𐴡𐴥𐴃𐴞 𐴇𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴒𐴟𐴉𐴡𐴕 𐴕𐴞𐴘𐴡𐴃𐴡𐴌𐴠 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢, <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴇𐴠𐴥 𐴕𐴞𐴘𐴡𐴃𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴒𐴡𐴌 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴑𐴞𐴃𐴝𐴁𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴁𐴡𐴕𐴠. <verse eid="ROM 16:26" /><verse number="27" style="v" sid="ROM 16:27" />𐴇𐴠𐴥 𐴓𐴠𐴇𐴝𐴥𐴌 𐴒𐴞𐴘𐴝𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>