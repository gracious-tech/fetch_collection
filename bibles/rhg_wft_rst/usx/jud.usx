<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴘𐴡𐴇𐴟𐴥𐴊𐴝</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝</para>
  <para style="toc2">𐴘𐴡𐴇𐴟𐴥𐴊𐴝</para>
  <para style="toc3">𐴘𐴡𐴊𐴢</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴘𐴡𐴇𐴟𐴥𐴊𐴝</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴝𐴍𐴞𐴥 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴕𐴞𐴎𐴠. 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴘𐴠 𐴕𐴞𐴎𐴠𐴁𐴝𐴎𐴠 𐴉𐴡𐴌𐴞𐴏𐴡 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠 𐴑𐴞, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴘 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴁𐴝𐴥𐴘 <char style="ior">(<ref loc="JUD 1:1">1‏:1</ref>)</char>. 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴁𐴟𐴎𐴝𐴥 𐴎𐴝 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴞𐴎𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴘. 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴇𐴡𐴥𐴕𐴡 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴇𐴡𐴕𐴡𐴤 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴦𐴌 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴟𐴌𐴝𐴕𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴎𐴠 𐴀𐴝𐴘𐴝𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴝𐴥𐴖𐴝𐴓𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠, 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌 𐴈𐴝𐴥𐴀𐴏𐴢 𐴉𐴡𐴌𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, ”𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴡𐴌 𐴀𐴝𐴊𐴡𐴌𐴁𐴡𐴕 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴠𐴤.“ <char style="ior">(<ref loc="JUD 1:1">1‏:1</ref>)</char>. 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴇𐴝𐴥𐴙𐴄𐴢 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠.</para>
  <para style="ip">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴃𐴝𐴔𐴝𐴥𐴔 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴡𐴥𐴕𐴡𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴌𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴌𐴞 𐴕𐴡 𐴎𐴝𐴘𐴃𐴡 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 <char style="ior">(<ref loc="JUD 1:4">1‏:4</ref>)</char>. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴟𐴎𐴝𐴥𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴊𐴡𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴉𐴟𐴌𐴝𐴕𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴑𐴝𐴇𐴝𐴥𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 2 𐴉𐴞𐴃𐴡𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴡𐴥𐴘 𐴔𐴞𐴓𐴢 𐴇𐴝𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴑𐴞 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 (<char style="xt"><ref loc="JUD 1:4">𐴘𐴡𐴇𐴟𐴥𐴊𐴝 1‏:4</ref>; <ref loc="2PE 2:1">2 𐴉𐴞𐴃𐴡𐴌 2‏:1</ref></char>) 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴊𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴔𐴡𐴥𐴌𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴇𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="JUD 1:1-2">1‏:1‏-2</ref>)</char></para>
  <para style="io1">2. 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 <char style="ior">(<ref loc="JUD 1:3-16">1‏:3‏-16</ref>)</char></para>
  <para style="io1">3. 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 <char style="ior">(<ref loc="JUD 1:17-23">1‏:17‏-23</ref>) </char></para>
  <para style="io1">4. 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 <char style="ior">(<ref loc="JUD 1:24-25">1‏:24‏-25</ref>)</char></para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />𐴀𐴝𐴀𐴛 𐴘𐴡𐴇𐴟𐴥𐴊𐴝, 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴒𐴟𐴓𐴝𐴔 𐴀𐴝𐴦𐴌 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴁𐴝𐴥𐴘.</para>
  <para style="p" vid="JUD 1:1">𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴡𐴌 𐴀𐴝𐴊𐴡𐴌𐴁𐴡𐴕 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴠𐴤.<verse eid="JUD 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞, 𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="JUD 1:2" /></para>
  <para style="s1">𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴖𐴝𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴓𐴠𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴌 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴝𐴏𐴞𐴤, 𐴀𐴝𐴀𐴛 𐴀𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴏𐴝𐴥𐴕 𐴓𐴠𐴑𐴡𐴥𐴕 𐴎𐴡𐴌𐴟𐴌 𐴁𐴡𐴓𐴞 𐴁𐴝𐴥𐴙𐴂𐴧𐴞, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴕-𐴉𐴡𐴌𐴝𐴕 𐴊𐴞 𐴀𐴡 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴡𐴤 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴑𐴁𐴝𐴌𐴡𐴃𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝𐴓𐴧𐴝 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠. <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴡𐴥𐴃𐴢 𐴕𐴡 𐴉𐴝𐴘𐴉𐴝𐴥𐴕 𐴒𐴡𐴥𐴌𐴞 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴏𐴟𐴂𐴧𐴠-𐴏𐴟𐴂𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴧𐴠𐴒𐴝𐴘 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴏𐴝𐴥𐴣𐴎𐴝𐴌 𐴎𐴞𐴑𐴞𐴥𐴌 𐴘𐴝𐴦𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌𐴠 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔𐴡𐴌 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 𐴁𐴝𐴕𐴝𐴘𐴉𐴠𐴥𐴓𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴓𐴠𐴇𐴝𐴥𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥.<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴎𐴝𐴕𐴡 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴃𐴡𐴀 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴞𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴊𐴠 𐴑𐴞, 𐴔𐴝𐴓𐴞𐴑𐴠 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴅𐴞𐴤𐴂𐴢 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘 𐴀𐴝𐴕𐴞𐴤 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴙𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟𐴥 𐴀𐴝𐴕𐴠𐴤. <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />𐴀𐴝𐴦𐴌 𐴎𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴌 𐴃𐴡𐴑𐴧𐴝 𐴎𐴝𐴌𐴞 𐴕𐴡𐴥 𐴌𐴝𐴑𐴠𐴥 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴊𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴎𐴝𐴒𐴝 𐴀𐴠𐴌𐴞𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴞 𐴏𐴞𐴥𐴘𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴁𐴝𐴣𐴊𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥; <verse eid="JUD 1:6" /><verse number="7" style="v" sid="JUD 1:7" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴥𐴊𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴔𐴡𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴥𐴀𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴐𐴡𐴥𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴥𐴓𐴒𐴡𐴘 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴎𐴠𐴕𐴝𐴤𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴞𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴏𐴝𐴥𐴣𐴎𐴝 𐴉𐴝𐴘𐴁𐴡.<verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴇𐴠𐴥 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴐𐴡𐴥𐴂𐴧𐴡𐴕𐴡𐴌 𐴁𐴝𐴎𐴝𐴥 𐴊𐴞𐴥𐴊𐴞 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴡𐴕𐴡𐴤 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴌𐴠 𐴕𐴡 𐴔𐴝𐴕𐴠, 𐴀𐴝𐴦𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴒𐴡𐴌𐴠𐴥. <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴃𐴡𐴑𐴧𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴔𐴝𐴘𐴑𐴠𐴓𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴢 𐴓𐴡𐴥𐴘 𐴔𐴟𐴀𐴏𐴝𐴌 𐴓𐴝𐴐𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴌𐴑𐴝𐴃𐴡𐴌𐴑𐴞 𐴊𐴞𐴘𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑𐴠 𐴃𐴡𐴌𐴠𐴥 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴡𐴑!“ <verse eid="JUD 1:9" /><verse number="10" style="v" sid="JUD 1:10" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴕𐴡 𐴁𐴟𐴎𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴊𐴕𐴝𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴑𐴧𐴡𐴥𐴓𐴢 𐴏𐴝𐴥𐴌𐴝 𐴅𐴝𐴕𐴟𐴖𐴝𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴁𐴟𐴎𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠. <verse eid="JUD 1:10" /><verse number="11" style="v" sid="JUD 1:11" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴀𐴙𐴕𐴡𐴌 𐴉𐴡𐴣𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴕𐴡𐴉𐴝𐴤 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴓𐴝𐴔𐴠 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴒𐴡𐴓𐴃𐴞𐴃𐴢 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴡𐴥𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴥𐴔𐴝𐴕𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="JUD 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤 𐴋𐴡𐴦𐴌-𐴐𐴡𐴥𐴌𐴡𐴔 𐴏𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴔𐴠𐴓𐴝-𐴐𐴡𐴥𐴁𐴝𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴡𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴡𐴥𐴃𐴢 𐴕𐴡 𐴉𐴝𐴘𐴧𐴝 𐴒𐴟𐴥𐴙𐴄𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴁𐴠 𐴉𐴝𐴓𐴠 𐴊𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴡𐴘𐴧𐴝𐴌𐴠 𐴀𐴟𐴌𐴝𐴘 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘 𐴊𐴠 𐴎𐴡𐴥𐴌 𐴏𐴝𐴥𐴌𐴝 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴝𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝𐴌 𐴔𐴡𐴀𐴏𐴟𐴔𐴡𐴃𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴔𐴟𐴌𐴞𐴥𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴌𐴞𐴉𐴠𐴓𐴝 𐴎𐴝, 𐴇𐴞𐴥𐴀𐴕 𐴊𐴟𐴘 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴔𐴡𐴌𐴝. <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴃𐴟𐴖𐴝𐴥𐴕𐴞 𐴒𐴡𐴙𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴠𐴥𐴕𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴐𐴡𐴥𐴌𐴡𐴔𐴞 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴥𐴐𐴞 𐴀𐴟𐴍𐴠𐴤. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴥𐴌𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴀𐴠𐴁𐴧𐴠 𐴒𐴟𐴄𐴒𐴟𐴙𐴄𐴧𐴝 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴇𐴝𐴥𐴔𐴞𐴐𐴝𐴓𐴧𐴝 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴘𐴠.<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴊𐴡𐴔 𐴎𐴝𐴘 𐴇𐴝𐴥𐴣𐴃𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴊𐴞𐴌𐴞𐴏𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴏𐴡𐴀, 𐴔𐴝𐴓𐴞𐴑 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴎𐴝𐴌-𐴀𐴝𐴥𐴎𐴝𐴌 𐴂𐴝𐴑 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴊𐴞𐴕𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴠𐴊𐴟𐴥𐴕 𐴁𐴠𐴊𐴞𐴕𐴞 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥 𐴁𐴠𐴊𐴞𐴕𐴞 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴎𐴠𐴊𐴟𐴥𐴕 𐴊𐴡𐴌𐴡𐴤-𐴊𐴡𐴌𐴡𐴤 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴀𐴠𐴓𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.“<verse eid="JUD 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴔𐴡𐴕𐴔𐴡𐴕𐴝 𐴀𐴠𐴊𐴧𐴠 𐴄𐴠𐴥𐴑 𐴉𐴠𐴣𐴍𐴝, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴁𐴟𐴌𐴝 𐴀𐴝𐴎𐴧𐴟 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴡𐴉𐴝𐴤 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴃𐴟𐴓𐴝𐴤 𐴊𐴠𐴥.<verse eid="JUD 1:16" /></para>
  <para style="s1">𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />𐴓𐴠𐴑𐴞𐴕، 𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕𐴠 𐴎𐴞𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴒𐴞𐴥𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴘𐴝𐴦𐴊𐴢 𐴌𐴝𐴙𐴑𐴧𐴡𐴥, <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠, ”𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴃𐴡𐴦𐴣𐴐𐴝𐴤𐴁𐴝𐴎𐴞-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴝𐴎𐴧𐴟 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴞𐴁𐴡𐴥.“ <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴑𐴞𐴥𐴘𐴝𐴓𐴠 𐴁𐴠 𐴏𐴡𐴓𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴕𐴝𐴥𐴘.<verse eid="JUD 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20" />𐴔𐴡𐴕𐴃𐴡𐴌, 𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴠𐴥 𐴀𐴠𐴁𐴧𐴠 𐴂𐴝𐴑 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴁𐴝𐴕𐴝𐴘𐴃𐴟𐴓𐴡𐴥, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴃𐴢 𐴎𐴝𐴌𐴞 𐴌𐴝𐴑𐴡𐴥, 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴡.<verse eid="JUD 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴐𐴡𐴥𐴑-𐴐𐴟𐴁𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴧𐴟 𐴄𐴝𐴕𐴞 𐴁𐴝𐴏𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴇𐴡𐴣𐴏𐴝𐴌𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴝𐴉𐴝𐴑 𐴇𐴡𐴦𐴌𐴡𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.<verse eid="JUD 1:23" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴟𐴅𐴝𐴥𐴄𐴢 𐴇𐴝𐴥𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘 𐴉𐴝𐴌𐴠 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴊𐴝𐴑 𐴏𐴝𐴥𐴌𐴝 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴃𐴞𐴥𐴘𐴝𐴒𐴝𐴌𐴝𐴘 𐴉𐴝𐴌𐴠, <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />𐴇𐴠𐴥 𐴓𐴠𐴇𐴝𐴥𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴏𐴝𐴘𐴓𐴡𐴘𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝, 𐴋𐴡𐴣𐴀𐴌𐴒𐴞𐴌𐴞, 𐴌𐴝𐴦𐴏𐴃𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴀𐴝𐴒𐴠 𐴘𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴀𐴡𐴥 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>