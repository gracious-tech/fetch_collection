<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id" />
  <para style="h">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc2">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc3">𐴘𐴡</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴞𐴥𐴘𐴝𐴌𐴝, 𐴎𐴞𐴁𐴝𐴤𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞, 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴉𐴡𐴀𐴘𐴓𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌𐴠 ”𐴀𐴞𐴕𐴅𐴞𐴓𐴢“ 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 ”𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌“ 𐴘𐴝𐴥𐴕𐴞 ”𐴒𐴡𐴔 𐴈𐴡𐴥𐴁𐴡𐴌.“ 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴀𐴞𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴞 𐴁𐴝𐴦𐴊𐴠 𐴔𐴡𐴃𐴞, 𐴔𐴝𐴌𐴑𐴟𐴏𐴢, 𐴓𐴟𐴑𐴝𐴥𐴏𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴘𐴞𐴁𐴝𐴤 𐴀𐴞𐴏𐴝𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴕𐴡𐴁𐴧𐴡𐴘 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴕𐴡 𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡, 𐴓𐴠𐴑𐴝𐴥 𐴇𐴞𐴥𐴀𐴕 1 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 3 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝. 𐴀𐴝𐴒𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴝𐴀𐴕 𐴁𐴟𐴎𐴝𐴥 𐴎𐴝 𐴊𐴠 𐴑𐴞, 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴁𐴝𐴤 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥.</para>
  <para style="ip">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝 <char style="ior">(<ref loc="JHN 20:31">20‏:31</ref>)</char>. 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥. 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴁𐴝𐴤 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴊𐴟𐴕𐴞𐴥 𐴒𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴓𐴠𐴑𐴝𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴃𐴞𐴕 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴓𐴡𐴥𐴘 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴓𐴡𐴑. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴠𐴦𐴐𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴁𐴠 𐴊𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴡𐴥 𐴓𐴠𐴑𐴠𐴥. 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝, 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴠𐴕𐴃𐴝𐴥𐴕, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴃𐴢 𐴕𐴡𐴥 𐴓𐴠𐴑𐴠𐴥.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴁𐴡𐴙𐴕𐴧𐴠𐴥 <char style="ior">(<ref loc="JHN 1:1-18">1‏:1‏-18</ref>)</char></para>
  <para style="io1">2. 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 <char style="ior">(<ref loc="JHN 1:19-51">1‏:19‏-51</ref>)</char></para>
  <para style="io1">3. 𐴀𐴞𐴏𐴝𐴤𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴞 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 <char style="ior">(<ref loc="JHN 2-12">2‏—12</ref>) </char></para>
  <para style="io1">4. 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴐𐴞𐴥𐴑𐴧𐴝 <char style="ior">(<ref loc="JHN 13-17">13‏—17</ref>)</char></para>
  <para style="io1">5. 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴑-𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴦𐴃𐴢 <char style="ior">(<ref loc="JHN 18-19">18‏—19</ref>)</char></para>
  <para style="io1">6. 𐴀𐴞𐴏𐴝𐴤 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴝 <char style="ior">(<ref loc="JHN 20-21">20‏—21</ref>)</char></para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴁𐴡𐴙𐴕𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴢 𐴑𐴝𐴓𐴝𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴑𐴝𐴓𐴝𐴔 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴑𐴝𐴓𐴝𐴔 𐴕𐴞𐴎𐴠 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />𐴀𐴞𐴥𐴁𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴊𐴟𐴥𐴕 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴝𐴥𐴌𐴝 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴕𐴟𐴌. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />𐴇𐴠𐴥 𐴕𐴟𐴌𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴉𐴡𐴀𐴌 𐴊𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴠 𐴇𐴠𐴥 𐴕𐴟𐴌𐴡𐴌𐴠 𐴎𐴞𐴃𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴓𐴢. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴠𐴥 𐴕𐴟𐴌𐴡𐴌 𐴀𐴠𐴑 𐴒𐴡𐴁𐴝𐴤 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴡𐴁𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴞𐴎𐴠 𐴇𐴡𐴥𐴕𐴡 𐴇𐴠𐴥 𐴕𐴟𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴇𐴠𐴥 𐴕𐴟𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢 𐴊𐴠.<verse eid="JHN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 1:9" />𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴟𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴉𐴡𐴀𐴌 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 1:9" /><verse number="10" style="v" sid="JHN 1:10" />𐴀𐴞𐴥𐴁𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴃𐴡𐴀 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡𐴥 𐴏𐴞𐴕𐴠𐴥. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴃𐴡𐴥 𐴎𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥 𐴎𐴡𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥 𐴎𐴡𐴌𐴔𐴡 𐴕𐴡 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴃𐴧𐴟 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴕𐴡 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥𐴘𐴠 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥𐴘𐴠 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />𐴇𐴠𐴥 𐴑𐴝𐴓𐴝𐴔 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴁𐴡𐴙𐴕𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. 𐴁𐴝𐴉𐴡𐴌 𐴓𐴠𐴇𐴝𐴥𐴌 𐴀𐴠𐴑 𐴉𐴟𐴖𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴝𐴏𐴠𐴤 𐴇𐴠𐴥 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥. 𐴀𐴞𐴥𐴁𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴘𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴓𐴝𐴔, ’𐴀𐴝𐴀𐴛 𐴁𐴝𐴦𐴊𐴠 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴣𐴀𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴏𐴠𐴤.‘ “ <verse eid="JHN 1:15" /><verse number="16" style="v" sid="JHN 1:16" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴌𐴝𐴘𐴧𐴝𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴞𐴥. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴀𐴓𐴢 𐴊𐴠 𐴔𐴟𐴀𐴏𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴓𐴠𐴑𐴞𐴕 𐴁𐴝𐴉𐴡𐴌 𐴁𐴟𐴑𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴓𐴠𐴇𐴝𐴥𐴌 𐴀𐴠𐴑 𐴉𐴟𐴖𐴝𐴘𐴠 𐴁𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="JHN 1:18" /></para>
  <para style="s1">𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴒𐴡𐴁𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 3:1-12">𐴔𐴡𐴃𐴢 3‏:1‏-12</ref>; <ref loc="MRK 1:2-8">𐴔𐴝𐴑 1‏:2‏-8</ref>; <ref loc="LUK 3:15-17">𐴓𐴟𐴑 3‏:15‏-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴒𐴡𐴁𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴘𐴝𐴀𐴕, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴀𐴞𐴔𐴝𐴔𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴓𐴠𐴀𐴜𐴞𐴘𐴡<note caller="+" style="f"><char style="fr" closed="false">1‏:19 </char><char style="ft" closed="false">𐴓𐴠𐴜𐴞𐴥𐴘𐴡 𐴈𐴡𐴀 𐴊𐴠, 𐴓𐴠𐴜𐴞𐴥𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴌𐴠</char></note>𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, ”𐴃𐴟𐴀𐴛 𐴇𐴡𐴕؟“ <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴡.“<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴀𐴛 𐴇𐴡𐴕؟ 𐴃𐴟𐴀𐴛 𐴇𐴡𐴥𐴕𐴡 𐴕𐴡𐴁𐴞 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴕𐴠𐴥؟“</para>
  <para style="p" vid="JHN 1:21">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴕𐴡, 𐴀𐴝𐴀𐴛 𐴕𐴡.“</para>
  <para style="p" vid="JHN 1:21">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴑𐴞𐴥 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴠𐴥 𐴕𐴡𐴁𐴞؟“</para>
  <para style="p" vid="JHN 1:21">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, ”𐴕𐴡.“<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴀𐴛 𐴇𐴡𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞 𐴉𐴝𐴌𐴞. 𐴃𐴟𐴀𐴛 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀؟“<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴥𐴘 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌,</para>
  <para style="q1" vid="JHN 1:23">’𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴌𐴝𐴏𐴃𐴝 𐴀𐴟𐴎𐴟 𐴒𐴡𐴌𐴡𐴤.‘ “<note caller="+" style="f"><char style="fr" closed="false">1‏:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 40‏:3</ref></char></char></note><verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴉𐴞𐴥𐴌𐴑𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴡, 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴕𐴡, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥 𐴕𐴡𐴁𐴞 𐴖𐴝 𐴘𐴡𐴥 𐴕𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴀𐴛 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴑𐴞𐴘𐴝𐴥 𐴊𐴡؟“<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴃𐴡 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴀𐴠𐴥𐴕𐴝 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴀𐴕 𐴀𐴠𐴑𐴎𐴡𐴕 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴏𐴞𐴕𐴡𐴥. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴀𐴛 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌; 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴠𐴕𐴄𐴝𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴃𐴝 𐴑𐴟𐴥𐴓𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡.“<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />𐴀𐴞𐴀𐴕 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴌 𐴉𐴝𐴌𐴑𐴟𐴓𐴠 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴎𐴠𐴍𐴠𐴥 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴃𐴡.<verse eid="JHN 1:28" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />𐴃𐴝𐴌𐴉𐴡𐴌 𐴊𐴞𐴕 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴟𐴎𐴟 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴟𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴒𐴟𐴕𐴝𐴤 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴓𐴝𐴔, ’𐴀𐴝𐴀𐴛 𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴀𐴕 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴃𐴡𐴑𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴏𐴠𐴤.‘ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥𐴃𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥 𐴉𐴝𐴥𐴕, 𐴀𐴝𐴀𐴛 𐴉𐴝𐴕𐴞𐴥𐴌 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠.“<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴘𐴝𐴀𐴕 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴠, ”𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴈𐴡𐴘𐴃𐴡𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥𐴃𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴝𐴕𐴞𐴥𐴌 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴃𐴡 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ’𐴎𐴞𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴓𐴝𐴔𐴞 𐴀𐴝𐴀𐴘𐴢 𐴁𐴡𐴘𐴁𐴡𐴥 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥𐴁𐴞, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴓𐴡𐴥𐴘 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴁𐴡.‘ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴌 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝.“<verse eid="JHN 1:34" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴏𐴝𐴥𐴃𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />𐴃𐴝𐴌𐴉𐴡𐴌 𐴊𐴞𐴕 𐴀𐴝𐴁𐴝𐴌 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴇𐴠𐴥𐴍𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴃𐴟 𐴀𐴝𐴥𐴣𐴍𐴞 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴟𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀!“<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞, 𐴇𐴠𐴥 𐴊𐴟𐴕𐴞𐴥 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴞𐴏𐴧𐴝𐴥 𐴉𐴞𐴥𐴌𐴞 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴀𐴝𐴘𐴧𐴠𐴤𐴌; 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴡𐴤𐴌 𐴊𐴠𐴥؟“</char></para>
  <para style="p" vid="JHN 1:38">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥“ (𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴟𐴏𐴃𐴝𐴃𐴢), ”𐴃𐴟𐴀𐴛 𐴇𐴡𐴍𐴠𐴥 𐴃𐴝𐴥𐴑𐴡 𐴊𐴠𐴥؟“<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴘𐴧𐴡𐴤 𐴏𐴡𐴀𐴒𐴝𐴘.“</char></para>
  <para style="p" vid="JHN 1:39">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴘, 𐴀𐴞𐴏𐴝𐴤 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕 𐴏𐴝𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴇𐴝𐴥𐴣𐴎𐴞𐴕𐴧𐴝 𐴏𐴝𐴙𐴌𐴒𐴗𐴝𐴥 𐴁𐴝𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴎𐴠 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴞𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴁𐴝𐴥𐴘 𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴢. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴒𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌𐴠 𐴃𐴟𐴖𐴝𐴘 𐴓𐴡𐴘 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴠𐴏𐴝𐴥𐴘𐴧𐴝𐴌𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴞𐴥“ (𐴔𐴠𐴏𐴝𐴥𐴘𐴧𐴝 𐴔𐴝𐴀𐴕𐴞, 𐴔𐴡𐴀𐴏𐴞𐴤).<note caller="+" style="f"><char style="fr" closed="false">1‏:41 </char><char style="ft" closed="false">𐴔𐴡𐴀𐴏𐴞𐴤 𐴔𐴝𐴀𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 </char></note><verse eid="JHN 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 1:42" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴘 𐴃𐴡 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴌𐴠𐴥 𐴑𐴠𐴥𐴉𐴝𐴏𐴢 𐴋𐴝𐴈𐴝 𐴎𐴝𐴘𐴁𐴡“</char> (𐴇𐴠𐴥 𐴕𐴝𐴔𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴉𐴞𐴃𐴡𐴌<note caller="+" style="f"><char style="fr" closed="false">1‏:42 </char><char style="ft" closed="false">𐴀𐴝𐴌𐴝𐴤𐴔𐴞𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 (𐴑𐴠𐴥𐴉𐴝𐴏𐴢) 𐴀𐴝𐴦𐴌 𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 (𐴉𐴞𐴃𐴡𐴌) 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌</char></note>).<verse eid="JHN 1:42" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴞𐴓𐴞𐴥𐴂𐴢 𐴀𐴠𐴊𐴧𐴠 𐴕𐴝𐴃𐴝𐴕𐴠𐴓𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />𐴃𐴝𐴌𐴉𐴡𐴌 𐴊𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴒𐴝𐴓𐴞𐴓𐴢 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴎𐴝𐴘𐴃𐴡𐴒𐴡𐴥𐴘 𐴕𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴓𐴞𐴥𐴂𐴡𐴌𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌.“</char><verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />𐴉𐴞𐴓𐴞𐴥𐴂𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴃𐴡𐴌 𐴃𐴝𐴌𐴝𐴥𐴌 𐴐𐴡𐴥𐴀𐴌 𐴁𐴠𐴃𐴏𐴝𐴥𐴘𐴊𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />𐴉𐴞𐴓𐴞𐴥𐴂𐴠 𐴕𐴝𐴃𐴝𐴕𐴠𐴓𐴡𐴌𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴟𐴁𐴝𐴤𐴌𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴞𐴥 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴃𐴡𐴌𐴝𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴓𐴠𐴙𐴑𐴧𐴠𐴥; 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤, 𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴌.“<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />𐴕𐴝𐴃𐴝𐴕𐴠𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴡𐴃𐴧𐴟 𐴑𐴞𐴥 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴔 𐴀𐴝𐴀𐴘𐴢 𐴉𐴝𐴌𐴠؟“</para>
  <para style="p" vid="JHN 1:46">𐴉𐴞𐴓𐴞𐴥𐴂𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴘𐴧𐴡𐴤, 𐴏𐴡𐴀𐴒𐴝𐴘.“<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴝𐴃𐴝𐴕𐴠𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴎𐴟 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴡𐴀, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴞 𐴕𐴝𐴥𐴘.“</char><verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />𐴕𐴝𐴃𐴝𐴕𐴠𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴏𐴞𐴕𐴡𐴥؟“</para>
  <para style="p" vid="JHN 1:48">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴉𐴞𐴓𐴞𐴥𐴂𐴠 𐴋𐴝𐴈𐴝𐴘𐴁𐴝𐴥𐴌 𐴀𐴝𐴒𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴀𐴛 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴃𐴝𐴓𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥.“</char><verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴕𐴝𐴃𐴝𐴕𐴠𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥,<note caller="+" style="f"><char style="fr" closed="false">1‏:49 </char><char style="ft" closed="false">𐴓𐴡𐴉𐴎𐴡𐴥 𐴘𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴞𐴁𐴌𐴟𐴤 𐴓𐴡𐴉𐴎𐴡𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 </char><char style="fqa" closed="false">𐴀𐴟𐴏𐴃𐴝𐴃𐴢</char></note> 𐴃𐴟𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝, 𐴃𐴟𐴀𐴛 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝.“<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴃𐴝𐴓𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴑𐴞𐴥 𐴃𐴟𐴀𐴛 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴡𐴤؟ 𐴃𐴟𐴀𐴛 𐴀𐴞𐴀𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴠𐴑𐴞𐴥𐴁𐴝.“</char> <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴀𐴝𐴏𐴔𐴝𐴕 𐴑𐴟𐴥𐴓𐴝 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴟𐴍𐴝𐴥𐴓𐴝𐴔𐴝 𐴒𐴡𐴌𐴠𐴥𐴌.“</char><verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s1">𐴑𐴝𐴥𐴕𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴔𐴝𐴎𐴠 𐴁𐴡𐴘𐴌𐴝𐴃𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴑𐴝𐴥𐴕𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴡𐴘𐴌𐴝𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠. 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴦 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />𐴇𐴠𐴥 𐴁𐴡𐴘𐴌𐴝𐴃𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴉𐴟𐴥𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴦𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴀𐴝𐴌 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴕𐴝𐴥𐴘.“<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴝𐴦𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴝𐴀, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴀𐴛 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴓𐴡𐴥𐴘 𐴑𐴞𐴦 𐴁𐴝𐴎𐴝𐴥 𐴀𐴝𐴏𐴠𐴤؟ 𐴀𐴝𐴣𐴀𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴊𐴠 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤.“</char><verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴦𐴘𐴠 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴞𐴀𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴈𐴡𐴀, 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.“<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴀𐴟𐴎𐴟 𐴁𐴝𐴕𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴠𐴥𐴍𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴏𐴡𐴥 𐴖𐴝 𐴏𐴞𐴘𐴟𐴤 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴝𐴘𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴑𐴟𐴌𐴞𐴃𐴧𐴟 𐴃𐴞𐴌𐴞𐴥𐴐𐴢 𐴒𐴠𐴓𐴡𐴥𐴔 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴉𐴝𐴕𐴞𐴥 𐴀𐴝𐴣𐴍𐴞𐴃𐴡𐴤.<verse eid="JHN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠 𐴏𐴞𐴘𐴟𐴤 𐴒𐴟𐴥𐴕𐴡𐴃𐴢 𐴉𐴝𐴕𐴞𐴥 𐴁𐴡𐴥𐴌𐴡.“</char> 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴄𐴞𐴂𐴢-𐴄𐴞𐴂𐴢 𐴉𐴝𐴕𐴞𐴥 𐴁𐴡𐴥𐴙𐴅𐴧𐴠.<verse eid="JHN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴝𐴓𐴝 𐴀𐴠𐴕𐴃𐴟𐴥 𐴇𐴡𐴊𐴟𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴁𐴡𐴘𐴌𐴝𐴙𐴃𐴧𐴝 𐴈𐴝𐴥𐴕𐴝𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴡𐴌𐴠 𐴊𐴡𐴦𐴒𐴡𐴥𐴘.“</char></para>
  <para style="p" vid="JHN 2:8">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />𐴎𐴠 𐴉𐴝𐴕𐴞𐴥 𐴒𐴟𐴥𐴕 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴁𐴡𐴕𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴇𐴞𐴥𐴀𐴕 𐴇𐴠𐴥 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴈𐴝𐴥𐴘𐴏𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴊𐴟𐴓𐴝𐴤𐴌𐴠 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴠𐴥 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴧𐴟𐴥𐴕 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴝𐴕𐴞𐴥 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴘 𐴉𐴝𐴌𐴠. <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴊𐴟𐴓𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴉𐴡𐴃𐴧𐴞𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴊𐴠 𐴀𐴝𐴒𐴠 𐴒𐴡𐴔 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴧𐴟𐴥𐴕 𐴈𐴝𐴥𐴁𐴝𐴘𐴉𐴠𐴓𐴝, 𐴀𐴝𐴦𐴌 𐴔𐴠𐴀𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴡𐴕 𐴔𐴡𐴎𐴞𐴕 𐴈𐴝𐴥𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴓𐴠 𐴁𐴝𐴦𐴊𐴠 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴉𐴞𐴕 𐴈𐴝𐴥𐴀𐴁𐴝. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴀𐴛 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴒𐴡𐴔 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴧𐴟𐴥𐴕 𐴌𐴝𐴑𐴞𐴥𐴊𐴞𐴘𐴡.“<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴑𐴝𐴥𐴕𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴀𐴞𐴓𐴧𐴝𐴘𐴞-𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴌 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤, 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴦, 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕, 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴕𐴞𐴏𐴠 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴦𐴊𐴧𐴞𐴕 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢.<verse eid="JHN 2:12" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 21:12-13">𐴔𐴡𐴃𐴢 21‏:12‏-13</ref>; <ref loc="MRK 11:15-17">𐴔𐴝𐴑 11‏:15‏-17</ref>; <ref loc="LUK 19:45-46">𐴓𐴟𐴑 19‏:45‏-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴏𐴝𐴤 𐴖𐴡𐴌𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />𐴀𐴝𐴦𐴌 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴒𐴡𐴌𐴟, 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴈𐴡𐴘𐴃𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴠𐴏𐴠𐴌, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴁𐴡𐴀𐴘𐴢 𐴁𐴝𐴄𐴧𐴝 𐴁𐴝𐴥𐴚𐴒𐴠𐴌. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴌𐴡𐴏𐴞𐴥 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴡𐴀𐴣𐴑 𐴁𐴝𐴕𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴌𐴟 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴓𐴡𐴦𐴌𐴝𐴘𐴊𐴞𐴘𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴝𐴄𐴧𐴝 𐴁𐴝𐴥𐴚𐴒𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴄𐴠𐴁𐴞𐴥𐴓𐴢 𐴕𐴝𐴃𐴋𐴞𐴘𐴝𐴒𐴝𐴌𐴝𐴘𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴄𐴞𐴛𐴝-𐴉𐴡𐴘𐴐𐴝𐴤 𐴐𐴞𐴥𐴣𐴍𐴝𐴐𐴞𐴄𐴧𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴈𐴡𐴘𐴃𐴡𐴌 𐴁𐴠𐴏𐴠𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴕𐴃𐴟𐴥 𐴀𐴞𐴀𐴕 𐴓𐴡𐴘𐴎𐴡𐴒𐴡𐴥𐴘! 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴌𐴠 𐴁𐴝𐴎𐴝𐴌 𐴕𐴡 𐴁𐴝𐴕𐴝𐴘𐴧𐴡𐴥!“</char> <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">2‏:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:9">𐴎𐴡𐴁𐴟𐴌 69‏:9</ref></char></char></note><verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴞𐴀𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴑𐴞𐴦 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴊𐴝𐴈𐴝𐴤𐴘 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥؟“<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴘𐴝𐴀𐴕 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴟𐴔.“</char><verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴘𐴝𐴀𐴕 𐴁𐴝𐴕𐴝𐴘𐴃𐴠𐴥 𐴏𐴝𐴓𐴞𐴐𐴢-𐴏𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴓𐴝𐴙𐴒𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴕𐴝𐴘 𐴊𐴞𐴁𐴝 𐴊𐴠𐴥؟“ <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴁𐴝𐴎𐴝𐴥 𐴊𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴦𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴈𐴡𐴃𐴝𐴤 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥. 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴠𐴥 𐴈𐴡𐴃𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤.<verse eid="JHN 2:22" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴏𐴞𐴕𐴠𐴥</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴎𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠𐴑𐴞𐴥 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴝𐴥𐴓𐴝𐴒𐴡𐴌𐴞 𐴏𐴞𐴕𐴠𐴥, <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤 𐴒𐴡𐴁𐴝𐴤 𐴕𐴡 𐴓𐴝𐴒𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴑𐴞𐴦 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴝𐴕𐴠.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴑𐴡𐴥𐴊𐴠𐴔𐴝𐴏𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴞𐴑𐴡𐴥𐴊𐴠𐴔𐴝𐴏𐴢 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴕𐴠𐴃𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴌𐴝𐴙𐴃𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞, 𐴃𐴟𐴀𐴛 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴎𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴝𐴓𐴧𐴝 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠.“<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴕𐴡𐴘𐴝 𐴒𐴡𐴌𐴞 𐴎𐴡𐴌𐴔𐴡 𐴕𐴡 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴊𐴠𐴑𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠.“</char><verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />𐴕𐴞𐴑𐴡𐴥𐴊𐴠𐴔𐴝𐴏𐴠 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴁𐴟𐴌𐴝𐴤 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴞𐴥𐴃𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴝𐴁𐴝𐴌 𐴎𐴡𐴌𐴔𐴡 𐴓𐴡𐴘𐴁𐴡؟ 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴠 𐴔𐴝𐴦𐴌 𐴉𐴠𐴍𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴀𐴝𐴁𐴝𐴌 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟“<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴉𐴝𐴕𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴌𐴟𐴀𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴕𐴡 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" /><char style="wj">𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴕𐴏𐴝𐴥𐴕, 𐴀𐴝𐴦𐴌 𐴌𐴟𐴀𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥 𐴇𐴞𐴥𐴀𐴕 𐴌𐴟𐴀.</char> <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" /><char style="wj">𐴀𐴝𐴀𐴛 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴕𐴡𐴘𐴝 𐴒𐴡𐴌𐴞 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡.</char> <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" /><char style="wj">𐴁𐴡𐴘𐴧𐴝𐴌 𐴃𐴡 𐴎𐴞𐴑𐴧𐴝𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴇𐴞𐴥𐴑𐴧𐴝 𐴁𐴝𐴀, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴇𐴠𐴥 𐴁𐴡𐴘𐴧𐴝𐴌𐴡𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴀𐴝𐴦𐴌 𐴇𐴡𐴙𐴑𐴧𐴝𐴤 𐴎𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴕𐴡 𐴎𐴝𐴕𐴡. 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴌𐴟𐴀𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝.“</char><verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />𐴕𐴞𐴑𐴡𐴥𐴊𐴠𐴔𐴝𐴏𐴠 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴞𐴀𐴕 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴠؟“<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴊𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴃𐴡𐴀 𐴃𐴟𐴀𐴛 𐴀𐴞𐴀𐴕 𐴕𐴡 𐴁𐴟𐴎𐴡𐴥 𐴊𐴠𐴥؟</char> <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴀𐴕 𐴎𐴝𐴕𐴞 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴡𐴁𐴝𐴤𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴘 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴓𐴠𐴥 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝؟</char> <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" /><char style="wj">𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠 𐴀𐴝𐴦𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴕𐴡𐴥 𐴀𐴟𐴍𐴠𐴤.</char> <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" /><char style="wj">𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴘𐴊𐴝𐴕 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴇𐴝𐴥𐴉𐴡𐴌𐴠 𐴖𐴡𐴌𐴠 𐴃𐴟𐴙𐴓𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴘𐴡𐴥 𐴖𐴡𐴌𐴠 𐴃𐴟𐴓𐴝𐴤 𐴎𐴝𐴘𐴁𐴡,</char> <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" /><char style="wj">𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴦.</char><verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />
    <char style="wj">”𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴀𐴠𐴃𐴡𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴓𐴠𐴇𐴝𐴥𐴌 𐴀𐴠𐴑 𐴉𐴟𐴖𐴝 𐴊𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠; 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴇𐴠𐴥 𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴝𐴐𐴢 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴦.</char> <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" /><char style="wj">𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴊𐴡𐴥𐴙𐴃𐴧𐴡 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴇𐴠𐴥 𐴉𐴟𐴖𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝.</char><verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴡𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴊𐴡𐴥𐴌𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴑 𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟𐴥 𐴀𐴝𐴕𐴠𐴤.</char> <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴁𐴡𐴥𐴓𐴞 𐴊𐴡𐴥𐴌𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴕𐴟𐴌 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴝𐴔 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴟𐴌𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴟𐴌𐴡𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴕𐴟𐴌𐴡𐴃𐴢 𐴕𐴟 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴀𐴝𐴘𐴓𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴞 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝𐴘𐴁𐴡 𐴁𐴡𐴓𐴞 𐴋𐴡𐴦𐴌𐴝.</char> <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴟𐴌𐴡𐴃𐴢 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝.“</char><verse eid="JHN 3:21" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴁𐴝 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴡𐴦𐴊𐴧𐴞𐴕 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴓𐴢.<verse eid="JHN 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 3:23" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴏𐴝𐴥𐴓𐴞𐴔 𐴎𐴝𐴒𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴘𐴕𐴡𐴕 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴑 𐴉𐴝𐴌𐴝𐴃𐴢 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴘𐴡𐴥 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴉𐴝𐴕𐴞𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴖𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌𐴠 𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴞𐴥𐴘𐴝 𐴕𐴡𐴥 𐴎𐴝.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴀𐴟𐴔𐴧𐴡𐴃𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴀𐴟𐴎𐴟 𐴁𐴝𐴕𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴌𐴑𐴝𐴃𐴡𐴌𐴑𐴞 𐴊𐴞𐴘𐴠𐴥. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴌 𐴉𐴝𐴌𐴑𐴟𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴀𐴛 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴓𐴝, 𐴏𐴡𐴀, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴠𐴌, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.“<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴊𐴞𐴦𐴘𐴝 𐴕𐴡 𐴒𐴞𐴓𐴠𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤𐴌 𐴒𐴡𐴁𐴝𐴤 𐴀𐴝𐴏𐴡𐴤, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ’𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.‘ <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />𐴎𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴟𐴓𐴞𐴥𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴟𐴓𐴝𐴤. 𐴊𐴟𐴓𐴝𐴤𐴌 𐴊𐴟𐴏𐴃𐴡𐴥𐴘𐴠 𐴃𐴡 𐴃𐴞𐴥𐴘𐴝𐴘 𐴊𐴟𐴓𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴠, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴓𐴝𐴤𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴞 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥. 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌 𐴑𐴟𐴥𐴐𐴞 𐴘𐴡𐴥 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴐𐴡𐴥𐴣𐴍𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.<verse eid="JHN 3:30" /></para>
  <para style="s1">𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />”𐴎𐴞𐴁𐴝𐴤 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠; 𐴎𐴞𐴁𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴃𐴧𐴟, 𐴀𐴞𐴥𐴁𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴞𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥, 𐴃𐴡𐴀 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴡𐴁𐴝𐴤 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤𐴃𐴢 𐴔𐴡𐴀𐴌 𐴓𐴝𐴒𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴡𐴥𐴘𐴧𐴞. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴔𐴝𐴉𐴞-𐴔𐴝𐴉𐴞 𐴌𐴟𐴀 𐴕𐴡 𐴊𐴠𐴦. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />𐴁𐴝𐴉𐴠 𐴉𐴟𐴖𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴝𐴏𐴠𐴤; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴁𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴀𐴝𐴏𐴠𐴤.“<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴔𐴝𐴥𐴌𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴓𐴞𐴑𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴦𐴌 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴞𐴏𐴝𐴤 𐴕𐴞𐴎𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴕𐴡 𐴊𐴞𐴃𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴊𐴞𐴃𐴡 𐴊𐴠, <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴁𐴝𐴌 𐴒𐴝𐴓𐴞𐴓𐴢 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴎𐴝𐴦𐴌𐴒𐴡𐴥𐴘.<verse eid="JHN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4" />𐴎𐴝𐴘𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴏𐴝𐴔𐴝𐴥𐴌𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦 𐴉𐴡𐴌𐴠𐴌. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴀𐴞𐴥𐴁𐴝 𐴏𐴝𐴔𐴝𐴥𐴌𐴞𐴘𐴝𐴌 𐴏𐴟𐴥𐴑𐴡𐴌 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴝𐴌𐴝𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴘𐴝𐴑𐴟𐴁𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌𐴠 𐴊𐴞𐴀𐴓𐴢 𐴊𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴋𐴝𐴥𐴑𐴠. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />𐴇𐴠𐴥𐴍𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴉𐴝𐴄𐴢-𐴑𐴟𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴥𐴣𐴙𐴄𐴧𐴠-𐴀𐴝𐴥𐴣𐴙𐴄𐴧𐴠 𐴀𐴡𐴥𐴌𐴝𐴕 𐴀𐴡𐴥𐴘 𐴇𐴠𐴥 𐴉𐴝𐴄𐴢-𐴑𐴟𐴖𐴝 𐴖𐴝𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴁𐴠𐴙𐴓𐴢 𐴄𐴞𐴥𐴑 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴏𐴝𐴔𐴝𐴥𐴌𐴞𐴘𐴝𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴇𐴠𐴥𐴍𐴠 𐴉𐴝𐴕𐴞𐴥 𐴃𐴟𐴙𐴓𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴑 𐴃𐴞𐴌𐴝𐴥𐴐𐴢 𐴉𐴝𐴕𐴞𐴥 𐴈𐴝𐴥𐴀𐴁𐴝.“</char> <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴈𐴝𐴥𐴕𐴝 𐴑𐴞𐴕𐴃𐴡 𐴒𐴞𐴦𐴘𐴡𐴥𐴘.<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴠𐴥 𐴏𐴝𐴔𐴝𐴥𐴌𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴊𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴏𐴝𐴔𐴝𐴥𐴌𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝, 𐴃𐴟𐴀𐴛 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴘𐴧𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴉𐴝𐴕𐴞𐴥 𐴔𐴝𐴒𐴡𐴌؟“ 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴏𐴝𐴔𐴝𐴥𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴇𐴡𐴕𐴡𐴤 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴕𐴝𐴥𐴘.<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴘 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴥𐴊𐴞𐴘𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌𐴃𐴧𐴟 𐴇𐴡𐴕𐴠 𐴉𐴝𐴕𐴞𐴥 𐴔𐴝𐴙𐴒𐴧𐴠𐴥 𐴇𐴡𐴘 𐴉𐴝𐴙𐴃𐴧𐴞, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴘 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴝𐴕𐴞𐴥 𐴔𐴝𐴒𐴞𐴃𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡𐴌𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴠𐴦 𐴊𐴠 𐴉𐴝𐴕𐴞𐴥 𐴊𐴞𐴦𐴃𐴡.“</char><verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴊𐴠 𐴉𐴝𐴕𐴞𐴥 𐴃𐴟𐴓𐴞𐴤 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴃𐴝𐴥𐴌𐴝 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴄𐴢-𐴑𐴟𐴖𐴝 𐴃𐴡 𐴔𐴟𐴌. 𐴃𐴡𐴥𐴘 𐴃𐴟𐴀𐴛 𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴉𐴝𐴕𐴞𐴥 𐴇𐴡𐴍𐴠𐴥 𐴉𐴝𐴘𐴧𐴡𐴥؟ <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴕𐴞𐴥𐴑𐴞, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴠 𐴉𐴝𐴄𐴢-𐴑𐴟𐴖𐴝 𐴖𐴝 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴡𐴌𐴟𐴏𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴞𐴁𐴝𐴤𐴌 𐴉𐴝𐴕𐴞𐴥 𐴈𐴝𐴥𐴘𐴧𐴠؟“<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠 𐴉𐴝𐴕𐴞𐴥 𐴈𐴝𐴥𐴀, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴝𐴁𐴝𐴌 𐴃𐴞𐴌𐴝𐴥𐴐𐴢 𐴓𐴝𐴒𐴞𐴁𐴡𐴥,</char> <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴀𐴛 𐴊𐴞𐴦 𐴊𐴠 𐴉𐴝𐴕𐴞𐴥 𐴈𐴝𐴥𐴀 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴃𐴞𐴌𐴝𐴥𐴐𐴢 𐴕𐴡 𐴓𐴝𐴒𐴞𐴁𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴀𐴛 𐴊𐴞𐴦𐴘𐴟𐴔 𐴊𐴠 𐴇𐴠𐴥 𐴉𐴝𐴕𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴎𐴡𐴥𐴕𐴧𐴝𐴃𐴧𐴟 𐴀𐴟𐴍𐴠𐴤 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴀𐴟𐴍𐴞𐴤𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴞𐴦𐴁𐴡.“</char><verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴠𐴥 𐴉𐴝𐴕𐴞𐴥 𐴊𐴡𐴦, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴌 𐴃𐴞𐴌𐴝𐴥𐴐𐴢 𐴕𐴡 𐴓𐴝𐴒𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴍𐴠𐴥 𐴉𐴝𐴕𐴞𐴥 𐴓𐴧𐴝 𐴘𐴡𐴥 𐴀𐴝𐴀 𐴕𐴡 𐴉𐴡𐴌𐴠.“<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠 <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴎𐴝𐴦, 𐴃𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌𐴠 𐴀𐴠𐴍𐴠𐴥 𐴔𐴝𐴃𐴝𐴘 𐴀𐴝𐴕𐴒𐴡𐴥𐴘.“</char><verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴠 𐴇𐴡𐴕𐴡𐴤 𐴇𐴡𐴥𐴐𐴡𐴔 𐴕𐴝𐴥𐴘.“ 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴘 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴘𐴧𐴡𐴥𐴏𐴢, 𐴃𐴡𐴌𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴇𐴡𐴥𐴐𐴡𐴔 𐴕𐴝𐴥𐴘.</char> <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴡𐴌𐴃𐴧𐴟 𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴇𐴡𐴥𐴐𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴇𐴡𐴥𐴕 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴃𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴕𐴡. 𐴃𐴟𐴘 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴘𐴧𐴡𐴥𐴏𐴢.“</char><verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴀𐴛 𐴀𐴠𐴇𐴡𐴥𐴕 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴞𐴥, 𐴃𐴟𐴀𐴛 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴕𐴡𐴁𐴞. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />𐴎𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴡𐴥𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠 𐴉𐴝𐴀𐴌 𐴒𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴀 𐴊𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴉𐴡𐴥𐴌𐴡𐴏𐴢.“<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝, 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴥𐴌, 𐴀𐴠𐴀𐴕 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴉𐴡𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴕𐴡 𐴀𐴠 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.</char> <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴁𐴝𐴤𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴕𐴠𐴅𐴝𐴃𐴡𐴌 𐴔𐴡𐴑𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.</char> <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴠𐴀𐴕 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴒𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴌𐴟𐴀 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴓𐴡𐴥𐴘 𐴁𐴝𐴉𐴡𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴝𐴉𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴒𐴝𐴥𐴌𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴠𐴥𐴌.</char> <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" /><char style="wj">𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴌𐴟𐴀, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴌𐴟𐴀 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴓𐴡𐴥𐴘 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌.“</char><verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴔𐴠𐴏𐴝𐴥𐴘𐴧𐴝 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴘𐴝𐴥𐴕𐴞 𐴔𐴡𐴀𐴏𐴞𐴤. 𐴀𐴞𐴥𐴁𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴁𐴡.“<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴡𐴌 𐴓𐴡𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌.“</char><verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴓𐴧𐴡𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴑𐴞, ”𐴃𐴟𐴀𐴛 𐴑𐴞𐴦 𐴃𐴟𐴖𐴡𐴀𐴌؟“ 𐴘𐴝𐴥, ”𐴃𐴟𐴀𐴛 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴇𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌؟“<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />𐴁𐴝𐴦𐴊𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴕𐴞𐴥𐴌 𐴒𐴡𐴥𐴌𐴝 𐴖𐴝 𐴀𐴠𐴌𐴞, 𐴉𐴝𐴌𐴝𐴃𐴢 𐴎𐴝𐴘 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />”𐴀𐴝𐴘𐴧𐴡𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴏𐴡𐴀𐴒𐴝𐴘, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴘𐴧𐴠𐴥. 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴥𐴕𐴡 𐴇𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴠𐴥؟“ <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />𐴃𐴡𐴥𐴘 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴌𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥, 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴡𐴥𐴀𐴕𐴝.“<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴠𐴀𐴕 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴈𐴝𐴥𐴕𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡.“</char><verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴡𐴥𐴕𐴡 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴀𐴝𐴕𐴞𐴤𐴊𐴞𐴘𐴠 𐴕𐴠𐴥؟“<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴔 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴡𐴤𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴥𐴕𐴝.</char> <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴈𐴡𐴀 𐴕𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ’𐴀𐴝𐴌𐴡𐴤 𐴏𐴝𐴙𐴌 𐴔𐴝𐴐𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴁𐴝𐴦𐴊𐴠 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴈𐴝𐴍𐴞𐴁𐴝𐴥𐴌 𐴀𐴝𐴙𐴕𐴊𐴝 𐴀𐴝𐴘𐴁𐴡𐴤؟‘ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴏𐴟𐴑 𐴃𐴟𐴓𐴞𐴤 𐴁𐴞𐴓𐴡𐴌 𐴀𐴟𐴎𐴟 𐴏𐴡𐴀, 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴝𐴍𐴞 𐴁𐴡𐴓𐴧𐴝 𐴉𐴝𐴒𐴞𐴒𐴞𐴘𐴡𐴥𐴘.</char> <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" /><char style="wj">𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴈𐴝𐴍𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴡𐴥 𐴔𐴟𐴎𐴟𐴌𐴞 𐴉𐴝𐴦𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴓𐴧𐴝 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴠𐴥𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴓𐴝𐴒𐴡𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴍𐴡𐴘𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕𐴠 𐴔𐴞𐴓𐴞 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥.</char> <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" /><char style="wj">𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴑𐴞, ’𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴓𐴝𐴒𐴝, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴈𐴝𐴍𐴠.‘</char> <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴀𐴟𐴀𐴙𐴕 𐴈𐴝𐴍𐴞𐴃𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴓𐴝𐴔 𐴎𐴞𐴀𐴕𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤; 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴡𐴌 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴈𐴝𐴙𐴄𐴧𐴡𐴥.“</char><verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />𐴇𐴠𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴉𐴝𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴞𐴐𐴞𐴤 𐴏𐴝𐴔𐴝𐴥𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴘𐴧𐴠𐴥.“ <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴠𐴥 𐴏𐴝𐴔𐴝𐴥𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴇𐴠𐴥𐴍𐴠 𐴊𐴟𐴘 𐴊𐴞𐴕 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤𐴓𐴢.<verse eid="JHN 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴀𐴠𐴇𐴡𐴥𐴕 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡𐴌 𐴈𐴡𐴃𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝.“<verse eid="JHN 4:42" /></para>
  <para style="s1">𐴀𐴠𐴑 𐴐𐴝𐴥𐴀𐴂𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 8:5-13">𐴔𐴡𐴃𐴢 8‏:5‏-13</ref>; <ref loc="LUK 7:1-10">𐴓𐴟𐴑 7‏:1‏-10</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />𐴊𐴟𐴘 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴈𐴠𐴥𐴕𐴃𐴟 𐴌𐴡𐴖𐴝𐴕𐴝 𐴓𐴡𐴘 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />𐴀𐴞𐴏𐴝𐴤 𐴕𐴞𐴎𐴠 𐴀𐴝𐴒𐴠 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠, ”𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴁𐴞𐴌 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴃𐴡𐴥𐴕𐴡𐴃𐴢 𐴕𐴝𐴥𐴘.“ <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴃𐴢 𐴎𐴠 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥 𐴀𐴞𐴊𐴡𐴃𐴢 𐴒𐴞𐴀𐴓𐴢.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴁𐴝𐴌 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴑𐴝𐴥𐴕𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴎𐴠𐴍𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴝𐴕𐴞𐴥𐴌𐴠 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴁𐴝𐴕𐴝𐴀𐴙𐴓𐴢. 𐴇𐴠𐴥𐴍𐴠 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴠𐴑 𐴐𐴝𐴥𐴀𐴂𐴡𐴌 𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴀𐴡𐴐𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴏𐴝𐴤 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴧𐴟 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴘𐴃𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴔𐴡𐴌𐴡𐴕-𐴔𐴡𐴌𐴡𐴕 𐴀𐴡𐴥𐴀𐴙𐴓𐴢.<verse eid="JHN 4:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴞𐴓𐴧𐴝𐴘𐴞-𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴓𐴠 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟 𐴀𐴝𐴕𐴞𐴤𐴁𐴝.“</char><verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴐𐴝𐴥𐴀𐴂𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴔𐴡𐴌𐴞𐴁𐴝𐴥𐴌 𐴀𐴝𐴒𐴠 𐴀𐴝𐴘𐴧𐴡𐴤!“<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴦𐴒𐴡𐴥𐴘; 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴖𐴝 𐴁𐴝𐴏𐴞𐴁𐴡𐴥.“</char> 𐴁𐴝𐴦𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴌𐴞𐴥 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴘𐴃𐴠, 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴒𐴟𐴓𐴝𐴔𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴖𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘!“ <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴖𐴝 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴈𐴡𐴥𐴁𐴡𐴌 𐴓𐴡𐴥𐴘𐴧𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴒𐴠𐴓𐴢 𐴊𐴠 𐴇𐴝𐴙𐴓𐴧𐴝 𐴊𐴞𐴕𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴝𐴥𐴎𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴎𐴡𐴌 𐴒𐴞𐴦𐴘𐴡𐴥𐴘.“<verse eid="JHN 4:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴝𐴉𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴡𐴣𐴃𐴧𐴠𐴤 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴖𐴝 𐴁𐴝𐴏𐴞𐴁𐴡𐴥.“</char> 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴡𐴥𐴌 𐴄𐴞𐴥𐴘𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴘 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴁𐴝𐴌 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s1">𐴁𐴠𐴃𐴠𐴥𐴏𐴊𐴝𐴃𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴞𐴊𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴖𐴡𐴌𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴒𐴠𐴙𐴄𐴢 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴡𐴀𐴙𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴇𐴞𐴁𐴌𐴟𐴤 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴁𐴠𐴃𐴠𐴥𐴏𐴊𐴝 𐴈𐴡𐴀, 𐴇𐴠𐴥 𐴉𐴡𐴀𐴙𐴌 𐴒𐴗𐴝𐴃𐴢 𐴉𐴝𐴣𐴏𐴢 𐴏𐴝𐴥𐴕 𐴁𐴝𐴦𐴕𐴋𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />𐴁𐴝𐴦𐴕𐴋𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴌𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴑𐴞, 𐴀𐴝𐴣𐴊𐴝𐴤, 𐴓𐴠𐴚, 𐴔𐴝𐴎𐴟𐴌. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴉𐴝𐴕𐴞𐴥𐴌 𐴓𐴡𐴌𐴝𐴏𐴡𐴌𐴝𐴌𐴠 𐴏𐴡𐴦𐴛 𐴒𐴡𐴌𐴞𐴥 𐴃𐴝𐴥𐴑𐴞𐴃𐴡. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴑 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴄𐴝𐴘𐴔𐴠-𐴄𐴝𐴘𐴔𐴠 𐴇𐴠𐴥 𐴉𐴡𐴀𐴙𐴌 𐴒𐴗𐴝𐴃𐴢 𐴓𐴝𐴔𐴞 𐴀𐴝𐴀𐴘𐴢 𐴉𐴝𐴕𐴞𐴥 𐴓𐴝𐴌𐴞𐴃𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴕𐴞𐴥 𐴓𐴝𐴌𐴞 𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴒𐴠 𐴓𐴝𐴔𐴞 𐴉𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴃𐴞𐴌𐴞𐴥𐴐𐴢-𐴀𐴝𐴣𐴐𐴄𐴡 𐴁𐴡𐴏𐴡𐴥𐴌𐴅𐴝 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴠𐴥𐴍𐴠 𐴉𐴡𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴠 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴞𐴐𐴞𐴤 𐴊𐴠𐴌𐴞 𐴓𐴡𐴥𐴃𐴞 𐴇𐴠𐴥 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴕𐴠؟“</char><verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴉𐴝𐴕𐴞𐴥 𐴓𐴝𐴌𐴠 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞 𐴉𐴡𐴀𐴙𐴌𐴡𐴃𐴢 𐴓𐴝𐴔𐴝𐴘𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴝𐴥𐴘. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴉𐴡𐴀𐴣𐴏𐴞𐴃𐴠-𐴉𐴡𐴀𐴣𐴏𐴞𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴒𐴡𐴃𐴧𐴟 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴝𐴔𐴞𐴎𐴝𐴒𐴡𐴥𐴘.“<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴟𐴍𐴡𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴥𐴣𐴍𐴡.“</char> <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴥𐴣𐴍𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.</para>
  <para style="p" vid="JHN 5:9">𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴙𐴅𐴧𐴝 𐴃𐴡 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕; 𐴀𐴝𐴙𐴅𐴧𐴝 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴘𐴎𐴡𐴕 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴔𐴝𐴕𐴝𐴥.“<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">’𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴥𐴣𐴍𐴡.‘ </char>“<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴡𐴌𐴠𐴥 𐴃𐴡𐴌 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴥𐴣𐴍𐴞𐴃𐴡 𐴈𐴡𐴘𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕؟“<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴃𐴟 𐴒𐴝𐴙𐴉𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴡𐴀, 𐴃𐴟𐴀𐴛 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘. 𐴀𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴒𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴕𐴡 𐴀𐴡𐴥.“</char> <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />𐴁𐴝𐴦𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴎𐴝𐴘 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤.<verse eid="JHN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴎𐴝𐴓𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴈𐴝𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴒𐴡𐴌𐴞𐴥𐴌.“</char> <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴠𐴥 𐴈𐴡𐴃𐴝𐴤 𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴁𐴝𐴥𐴚𐴒𐴞𐴃𐴡 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴉𐴢 𐴈𐴡𐴀𐴘𐴢 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴝𐴓𐴧𐴝 𐴓𐴧𐴡𐴘 𐴉𐴟𐴥𐴀𐴝𐴙𐴕𐴧𐴝 𐴘𐴡𐴥 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.<verse eid="JHN 5:18" /></para>
  <para style="s1">𐴉𐴟𐴖𐴝𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴉𐴟𐴖𐴝 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴠𐴥 𐴎𐴞𐴀𐴕 𐴁𐴝𐴉𐴠 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴊𐴠𐴑𐴠𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴝𐴉𐴠 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴠𐴥, 𐴉𐴟𐴖𐴝𐴘𐴠 𐴘𐴡𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴥𐴕𐴝 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" /><char style="wj">𐴁𐴝𐴉𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴠 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴖𐴝𐴌𐴠 𐴊𐴝𐴈𐴝𐴤. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴖𐴝𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥. </char> <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" /><char style="wj">𐴁𐴝𐴉𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴖𐴝𐴘𐴠 𐴘𐴡𐴥 𐴎𐴝𐴌𐴠𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴃𐴝𐴌𐴠𐴥 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" /><char style="wj">𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴁𐴝𐴉𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴞𐴏𐴝𐴌𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴎𐴞𐴔𐴧𐴝 𐴉𐴟𐴖𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠,</char> <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" /><char style="wj">𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴝𐴉𐴡𐴌𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴖𐴝𐴌𐴠 𐴘𐴡𐴥 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴉𐴟𐴖𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴁𐴝𐴉𐴡𐴌𐴠 𐴘𐴡𐴥 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥.</char><verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴠 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴞𐴥𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴏𐴝𐴥𐴣𐴎𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴉𐴝𐴌𐴝𐴤𐴘𐴒𐴞𐴘𐴡𐴘.</char> <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠𐴀𐴕 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴞𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴟𐴥𐴕𐴞𐴁𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴝𐴉𐴢 𐴕𐴞𐴎𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴔𐴝𐴓𐴞𐴑, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴟𐴖𐴝𐴌𐴠 𐴘𐴡𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴔𐴝𐴓𐴞𐴑 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥.</char> <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" /><char style="wj">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴟𐴖𐴝𐴌𐴠 𐴁𐴞𐴏𐴝𐴌𐴡𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝.</char><verse eid="JHN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28" />
    <char style="wj">”𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴀𐴕 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴞𐴁𐴡,</char> <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴁𐴡𐴥; 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴍𐴞𐴤𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴥𐴣𐴎𐴝 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴍𐴞𐴤𐴁𐴡.</char><verse eid="JHN 5:29" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞. 𐴀𐴝𐴀𐴛 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴥𐴕𐴞 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴠 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥; 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴁𐴞𐴏𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴡 𐴏𐴝𐴀𐴘𐴢, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴟𐴁𐴝𐴤𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴝𐴀𐴘𐴢 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠.</char><verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴎𐴡𐴊𐴞 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴕𐴞𐴎𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴁𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴡.</char> <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴊𐴠𐴊𐴠 𐴒𐴡𐴁𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞.</char><verse eid="JHN 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴓𐴝, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴠.</char> <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" /><char style="wj">𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴒𐴡𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴀𐴞𐴀𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴡.</char> <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" /><char style="wj">𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴏𐴠𐴌𐴝𐴑 𐴖𐴝𐴀𐴕, 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴎𐴡𐴓𐴞 𐴉𐴡𐴀𐴌 𐴊𐴠; 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴦𐴊𐴧𐴞𐴕𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴡𐴀𐴌𐴡𐴃𐴢 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴌𐴝𐴎𐴞 𐴀𐴡𐴥𐴘𐴓𐴝.</char><verse eid="JHN 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴒𐴡𐴁𐴝𐴤𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴈𐴝𐴔 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴞𐴥𐴌 𐴎𐴞𐴀𐴕 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴈𐴝𐴔 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴝𐴉𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠.</char> <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" /><char style="wj">𐴇𐴠𐴥 𐴁𐴝𐴉𐴢 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴠. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴡, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝-𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴊𐴠𐴙𐴑𐴧𐴡𐴥.</char> <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟 𐴀𐴝𐴕𐴡𐴤.</char> <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘𐴁𐴝 𐴁𐴡𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴞 𐴊𐴞𐴓𐴔𐴡𐴕 𐴊𐴞 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴃𐴝𐴇𐴝𐴥𐴑𐴞𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴥𐴕𐴝 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥.</char> <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" /><char style="wj">𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴃𐴡𐴤 𐴕𐴡 𐴏𐴡𐴀.</char><verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴉𐴝𐴘𐴃𐴡 𐴕𐴡 𐴏𐴝𐴀𐴘𐴢.</char> <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴞𐴕𐴞𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴝𐴥𐴘.</char> <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤, 𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴞𐴘𐴠𐴥 𐴎𐴡𐴊𐴞 𐴕𐴞𐴎𐴡𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴘𐴓𐴠𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.</char> <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴉𐴝𐴘𐴃𐴡 𐴏𐴡𐴀, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴉𐴝𐴦 𐴎𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴝𐴘𐴃𐴡 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴁𐴝؟ </char><verse eid="JHN 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴄𐴝𐴥𐴀𐴙𐴅𐴧𐴡 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥𐴘𐴟𐴔. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥𐴁𐴡 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴟𐴀𐴏𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴌𐴝𐴙𐴑𐴧𐴡𐴥.</char> <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴡𐴊𐴞 𐴔𐴟𐴀𐴏𐴝𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴘𐴡𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴥𐴕𐴝 𐴓𐴠𐴙𐴑𐴧𐴠𐴥.</char> <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴓𐴠𐴑𐴝𐴥𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝؟“</char><verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s1">𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴁𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 14:13-21">𐴔𐴡𐴃𐴢 14‏:13‏-21</ref>; <ref loc="MRK 6:30-44">𐴔𐴝𐴑 6‏:30‏-44</ref>; <ref loc="LUK 9:10-17">𐴓𐴟𐴑 9‏:10‏-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴒𐴝𐴓𐴞𐴓𐴢 𐴋𐴞𐴀𐴌 𐴀𐴡𐴑𐴟𐴓𐴠 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴎𐴠 𐴋𐴞𐴀𐴌𐴠 𐴃𐴞𐴁𐴞𐴌𐴞𐴘𐴝𐴏𐴢 𐴋𐴞𐴀 𐴘𐴡𐴥 𐴈𐴡𐴀. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴞𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴟𐴍𐴞𐴤, 𐴇𐴠𐴥𐴍𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴢 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.<verse eid="JHN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴏𐴟𐴑 𐴃𐴟𐴓𐴞𐴤 𐴏𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴓𐴞𐴥𐴂𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠 <char style="wj">”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴟𐴄𐴞 𐴇𐴡𐴕𐴃𐴟𐴤 𐴑𐴞𐴕𐴞𐴘𐴟𐴥𐴔؟“</char> <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />𐴉𐴞𐴓𐴞𐴥𐴂𐴡𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴓𐴠𐴑𐴞𐴕 𐴕𐴞𐴎𐴠 𐴑𐴞𐴦 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴎𐴝𐴕𐴠.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />𐴉𐴞𐴓𐴞𐴥𐴂𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, ”𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴔-𐴈𐴡𐴔 𐴒𐴡𐴌𐴞 𐴊𐴞𐴦𐴓𐴠𐴥 𐴘𐴡, 𐴃𐴡𐴀 𐴊𐴟𐴘 𐴐𐴡𐴥𐴃𐴢 𐴊𐴞𐴕𐴝𐴥𐴌𐴡𐴌<note caller="+" style="f"><char style="fr" closed="false">6‏:7 </char><char style="ft" closed="false">𐴊𐴞𐴕𐴝𐴥𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴌𐴡𐴔𐴞 𐴑𐴡𐴖𐴔𐴡𐴌 𐴄𐴞𐴛𐴝𐴌 𐴕𐴝𐴔; 𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌 𐴄𐴞𐴛𐴝 𐴀𐴠𐴑 𐴊𐴞𐴕𐴡𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴓𐴡𐴘 𐴁𐴡𐴌𐴝𐴁𐴡𐴌. </char></note> 𐴌𐴟𐴄𐴞 𐴓𐴡𐴘 𐴕𐴡 𐴑𐴟𐴓𐴝𐴘𐴁𐴡𐴥.“<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴁𐴝𐴥𐴘 𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />”𐴀𐴠𐴍𐴠𐴥 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴁𐴝𐴌𐴓𐴞𐴥𐴌<note caller="+" style="f"><char style="fr" closed="false">6‏:9 </char><char style="fq">𐴁𐴝𐴌𐴓𐴞𐴥</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴞𐴣𐴘𐴟𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴡𐴥𐴏𐴡𐴓𐴢, 𐴎𐴞𐴀𐴕 𐴒𐴞𐴣𐴘𐴟𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴇𐴡𐴥𐴀𐴏𐴧𐴝 𐴁𐴠𐴏𐴞𐴃𐴡𐴥. </note> 𐴌𐴟𐴄𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝𐴥 𐴔𐴝𐴏𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴊𐴟𐴥𐴕 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴀𐴞𐴀𐴕𐴠 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴡؟“<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴡.“</char> 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴑𐴠𐴥𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴃𐴡𐴥𐴘 𐴁𐴠𐴍𐴝𐴀𐴙𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴡𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴌𐴟𐴄𐴞 𐴒𐴟𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴡𐴀𐴘𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴝𐴍𐴞𐴊𐴞𐴘𐴠𐴥; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴏𐴢 𐴀𐴡𐴥 𐴊𐴞𐴦𐴘𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴊𐴟𐴥𐴕 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴠𐴥𐴊𐴟𐴕 𐴇𐴝𐴥𐴘 𐴉𐴝𐴙𐴅𐴧𐴠𐴥.<verse eid="JHN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴞 𐴇𐴝𐴥𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠 𐴃𐴟𐴑𐴟𐴍𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴏𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴇𐴞𐴥𐴀𐴕 𐴊𐴡𐴓𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴕𐴡 𐴎𐴝.“</char> <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />𐴃𐴡𐴥𐴘 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴇𐴝𐴥𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴁𐴝𐴌𐴓𐴞𐴥𐴌 𐴌𐴟𐴄𐴞 𐴉𐴝𐴣𐴏𐴡𐴥 𐴖𐴝𐴃𐴧𐴟 𐴎𐴠𐴊𐴟𐴥𐴕 𐴁𐴝𐴏𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴇𐴞𐴥𐴀𐴕 𐴊𐴡𐴓𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴌𐴡𐴥 𐴁𐴝𐴥𐴙𐴌 𐴁𐴡𐴥𐴙𐴅𐴧𐴠.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴃𐴝𐴥𐴕 𐴊𐴠𐴑𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴡𐴁𐴞 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴏𐴠𐴤.“ <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴡𐴓𐴝𐴎𐴟𐴌𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴁𐴝𐴕𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴊𐴡𐴥𐴙𐴃𐴧𐴡 𐴀𐴝𐴘𐴃𐴡𐴤 𐴏𐴝𐴥𐴌, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘 𐴒𐴝𐴦𐴒𐴝 𐴀𐴝𐴁𐴝𐴌 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴡𐴘.<verse eid="JHN 6:15" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴉𐴝𐴕𐴞𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴥𐴣𐴙𐴄𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 14:22-27">𐴔𐴡𐴃𐴢 14‏:22‏-27</ref>; <ref loc="MRK 6:45-52">𐴔𐴝𐴑 6‏:45‏-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴋𐴞𐴀𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />𐴀𐴝𐴦𐴌 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴞𐴤, 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔𐴡𐴃𐴢 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴋𐴞𐴀 𐴉𐴝𐴌𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴞𐴏𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴃𐴠𐴎𐴢 𐴁𐴡𐴘𐴧𐴝𐴌𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝, 𐴋𐴞𐴀𐴃𐴢 𐴒𐴡𐴙𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴐𐴟𐴥𐴌𐴟 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡𐴦 𐴁𐴝𐴀𐴘𐴢-𐴁𐴝𐴀𐴘𐴢 𐴃𐴞𐴕 𐴏𐴝𐴙𐴌 𐴔𐴝𐴙𐴓𐴢 𐴀𐴝𐴥𐴕𐴞𐴑 𐴎𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴉𐴝𐴕𐴞𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴥𐴣𐴍𐴞-𐴀𐴝𐴥𐴣𐴍𐴞 𐴕𐴡𐴦𐴌 𐴀𐴟𐴎𐴟 𐴀𐴝𐴘𐴧𐴠𐴤𐴌; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴋𐴡𐴦𐴌 𐴓𐴝𐴙𐴒𐴧𐴠𐴥. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴞𐴁𐴝𐴤 𐴀𐴝𐴀𐴛; 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥.“</char> <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡𐴦𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴃𐴡 𐴌𐴝𐴎𐴞 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴦𐴌 𐴕𐴡𐴦 𐴒𐴝𐴥𐴕 𐴀𐴠𐴥𐴇𐴡𐴕 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠𐴒𐴡𐴘.<verse eid="JHN 6:21" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴌𐴟𐴄𐴞</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />𐴋𐴞𐴀𐴌 𐴀𐴡𐴑𐴟𐴓𐴠 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴌𐴉𐴡𐴌 𐴊𐴞𐴕 𐴀𐴡𐴥𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴦 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴦 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴠𐴥 𐴕𐴡𐴦𐴃𐴢 𐴕𐴡𐴥 𐴀𐴟𐴍𐴠𐴤, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴒𐴞𐴦𐴘𐴠𐴥 𐴊𐴠. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴦 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴞𐴁𐴞𐴌𐴞𐴘𐴝𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴎𐴝𐴒𐴝 𐴖𐴝𐴀𐴕𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴃𐴢 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴌𐴟𐴄𐴞 𐴈𐴝𐴥𐴀𐴙𐴓𐴢. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡𐴦 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴃𐴟𐴖𐴝𐴘-𐴃𐴟𐴖𐴝𐴘 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠.<verse eid="JHN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴋𐴞𐴀𐴌 𐴀𐴡𐴑𐴟𐴓𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥, 𐴃𐴟𐴀𐴛 𐴀𐴠𐴍𐴠𐴥 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴙𐴐𐴧𐴡𐴥؟“<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴖𐴡𐴀𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴞 𐴌𐴟𐴄𐴞 𐴇𐴝𐴥𐴘 𐴉𐴝𐴙𐴅𐴧𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴖𐴡𐴀𐴌 𐴊𐴠.</char> <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" /><char style="wj">𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴎𐴝𐴒𐴡𐴥𐴘 𐴊𐴠 𐴈𐴝𐴥𐴕𐴝𐴓𐴧𐴝 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴠 𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴓𐴧𐴝 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴞𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴘𐴠 𐴊𐴞𐴦𐴁𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴀𐴌 𐴓𐴝𐴒𐴝𐴘𐴊𐴞𐴘𐴠.“</char><verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴑𐴞𐴦 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥؟“<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴔.“</char><verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴀𐴛 𐴑𐴞𐴦 𐴀𐴞𐴓𐴧𐴝𐴘𐴞-𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠𐴑𐴞𐴥𐴘𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴉𐴝𐴌𐴞؟ 𐴃𐴟𐴀𐴛 𐴑𐴞𐴦 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝؟ <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴊𐴠 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴔𐴝𐴕𐴧𐴝𐴥 𐴈𐴝𐴥𐴘𐴧𐴠. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ’𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴌𐴟𐴄𐴞 𐴊𐴞𐴦𐴘𐴠𐴥.‘ “<note caller="+" style="f"><char style="fr" closed="false">6‏:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 16:4">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 16‏:4</ref></char>; <char style="xt"><ref loc="NEH 9:15">𐴕𐴠𐴇𐴠𐴔𐴞𐴥𐴘𐴝 9‏:15</ref></char>; <char style="xt"><ref loc="PSA 78:24">𐴎𐴡𐴁𐴟𐴌 78‏:24</ref>‏,<ref loc="PSA 78:25">25</ref></char></char></note><verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴌𐴟𐴄𐴞 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴠 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴏𐴡𐴥𐴘𐴧𐴞 𐴌𐴟𐴄𐴞 𐴊𐴠𐴦.</char> <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴄𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴡 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴞𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴠𐴦.“</char><verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴇𐴠𐴥 𐴌𐴟𐴄𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴊𐴡𐴦.“<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴌𐴟𐴄𐴞 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴀𐴛. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴁𐴟𐴥𐴑 𐴕𐴡 𐴓𐴝𐴒𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴃𐴞𐴌𐴝𐴥𐴐𐴢 𐴕𐴡 𐴓𐴝𐴒𐴞𐴁𐴡𐴥.</char> <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴞, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴠𐴙𐴑𐴧𐴡𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟 𐴀𐴝𐴕𐴡𐴤.</char> <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" /><char style="wj">𐴎𐴠𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴠𐴦, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴊𐴟𐴣𐴌𐴝𐴘 𐴕𐴡 𐴊𐴞𐴘𐴟𐴔.</char> <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴞𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴟𐴁𐴝𐴤𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠.</char> <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" /><char style="wj">𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴎𐴠𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴎𐴠𐴕 𐴈𐴠𐴥𐴕𐴃𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴝 𐴇𐴝𐴥𐴌𐴝𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴊𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴞𐴥.</char> <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴟𐴖𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴞𐴥𐴃𐴠 𐴎𐴠𐴕 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴦. 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴊𐴞𐴕 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔.“</char><verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴍𐴝𐴉𐴟𐴍𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴎𐴠 𐴌𐴟𐴄𐴞 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴞𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴘𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴀𐴛.“</char><verse eid="JHN 6:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 6:42" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤 𐴕𐴡 𐴕𐴞𐴥𐴑𐴞, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴞𐴕𐴞𐴥؟ 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴞𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤؟“<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴉𐴟𐴍𐴝𐴉𐴟𐴍𐴞 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char> <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴢 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴄𐴝𐴕𐴞 𐴕𐴟 𐴀𐴝𐴕𐴞𐴤𐴓𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴠. 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴊𐴞𐴕 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔.</char> <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" /><char style="wj">𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤, ’𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴃𐴝𐴦𐴓𐴞𐴔 𐴉𐴝𐴘𐴁𐴡.‘</char><note caller="+" style="f"><char style="fr" closed="false">6‏:45 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 54:13">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 54‏:13</ref></char></char></note> <char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞 𐴃𐴝𐴦𐴓𐴞𐴔 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴧𐴠𐴤.</char> <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" /><char style="wj">𐴇𐴠𐴥 𐴁𐴝𐴉𐴡𐴌𐴠 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡𐴥 𐴊𐴠𐴑𐴠𐴥. 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠.</char> <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴝𐴏𐴠𐴤.</char><verse eid="JHN 6:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 6:48" />
    <char style="wj">”𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴌𐴟𐴄𐴞 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴀𐴛.</char> <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴊𐴠 𐴔𐴡𐴘𐴊𐴝𐴕 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴔𐴝𐴕𐴧𐴝𐴥 𐴈𐴝𐴥𐴘𐴧𐴠, 𐴃𐴡𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘.</char> <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴞𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴌𐴟𐴄𐴞, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴝𐴥𐴘 𐴕𐴡 𐴔𐴡𐴌𐴠.</char> <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴞𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴌𐴟𐴄𐴞 𐴘𐴞𐴥𐴁𐴝. 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠 𐴌𐴟𐴄𐴞 𐴈𐴝𐴥𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝𐴓𐴧𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡. 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴊𐴞𐴦𐴘𐴟𐴔 𐴊𐴠 𐴇𐴠𐴥 𐴌𐴟𐴄𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴏𐴧𐴡.“</char><verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴔𐴝𐴃𐴝𐴔𐴝𐴃𐴞 𐴊𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴏𐴧𐴡 𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴊𐴞𐴦𐴁𐴡؟“<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴃𐴟𐴥𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴒𐴟𐴏𐴧𐴡 𐴀𐴠𐴊𐴧𐴠 𐴓𐴡𐴖𐴢 𐴕𐴡𐴥 𐴈𐴡𐴥𐴀, 𐴇𐴠𐴥𐴃𐴟𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴕𐴝𐴥𐴘.</char> <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴏𐴧𐴡 𐴀𐴠𐴊𐴧𐴠 𐴓𐴡𐴖𐴢 𐴈𐴝𐴥𐴀, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴊𐴞𐴕 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔.</char> <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴏𐴧𐴡 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴝𐴥𐴕𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴖𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴉𐴞𐴀𐴁𐴝𐴌 𐴅𐴞𐴕𐴞𐴥𐴐𐴢.</char> <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴏𐴧𐴡 𐴀𐴠𐴊𐴧𐴠 𐴓𐴡𐴖𐴢 𐴈𐴝𐴥𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴞.</char> <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" /><char style="wj">𐴎𐴞𐴕𐴊𐴝 𐴁𐴝𐴉𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴞𐴤, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴝𐴥𐴘𐴁𐴡 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.</char> <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" /><char style="wj">𐴘𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴞𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴌𐴟𐴄𐴞. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴝𐴥𐴘 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴌𐴟𐴄𐴞 𐴕𐴡. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠 𐴌𐴟𐴄𐴞 𐴈𐴝𐴥𐴘𐴁𐴡, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝𐴓𐴧𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.“</char><verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔𐴡𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴈𐴡𐴘𐴧𐴠𐴥.<verse eid="JHN 6:59" /></para>
  <para style="s1">𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />𐴇𐴠𐴥 𐴃𐴝𐴦𐴓𐴞𐴔 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴝𐴀𐴕 𐴃𐴡 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴌𐴝 𐴃𐴝𐴦𐴓𐴞𐴔, 𐴇𐴡𐴕𐴠 𐴒𐴡𐴏𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟“ <verse eid="JHN 6:60" /><verse number="61" style="v" sid="JHN 6:61" />𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴟𐴍𐴝𐴉𐴟𐴍𐴞 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠 𐴃𐴝𐴦𐴓𐴞𐴔𐴠 𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴠𐴎𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥؟</char> <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" /><char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴎𐴠𐴍𐴠𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴁𐴝 𐴎𐴡𐴊𐴞 𐴇𐴠𐴥𐴍𐴠 𐴀𐴟𐴍𐴠𐴤𐴌𐴒𐴡𐴘 𐴊𐴠 𐴊𐴠𐴑𐴡𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴁𐴝𐴥𐴉𐴞𐴁𐴝؟</char> <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" /><char style="wj">𐴌𐴟𐴀𐴘𐴠 𐴀𐴠𐴥𐴕𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴠𐴦; 𐴅𐴞𐴏𐴞𐴥𐴔𐴠 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴡 𐴊𐴠𐴦. 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴠 𐴈𐴡𐴃𐴝𐴤 𐴒𐴟𐴥𐴕 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴌𐴟𐴀 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞.</char> <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟𐴥 𐴀𐴝𐴕𐴡𐴤.“</char> 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴎𐴝𐴕𐴠, 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟𐴥 𐴀𐴝𐴕𐴠𐴤 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴓𐴝𐴔, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥, 𐴎𐴠𐴃𐴟𐴥𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴕𐴡 𐴊𐴠𐴦.“</char><verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴞𐴥𐴌𐴞𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴝𐴥 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="JHN 6:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴑𐴞𐴥 𐴎𐴝𐴘𐴃𐴡𐴒𐴡𐴥𐴘 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴕𐴠𐴥؟“</char><verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘𐴃𐴝𐴔؟ 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴈𐴡𐴃𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤 𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴞𐴥 𐴊𐴠, 𐴃𐴟𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑𐴎𐴡𐴕.“<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕𐴡𐴌𐴠 𐴁𐴝𐴏𐴞𐴥 𐴕𐴡𐴥 𐴓𐴡𐴦𐴘𐴢 𐴕𐴠𐴥؟ 𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴢 𐴀𐴝𐴏𐴠𐴤.“</char> <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴞𐴏𐴑𐴝𐴥𐴌𐴞𐴘𐴠𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌 𐴕𐴝𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴠𐴥𐴌; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴢 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠 𐴕𐴡 𐴈𐴡𐴀𐴌. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴣𐴐𐴝𐴤𐴌-𐴀𐴞𐴊𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴠𐴕𐴃𐴟𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴢 𐴎𐴡𐴦𐴒𐴡𐴥𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴀𐴛 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴊𐴠𐴑𐴠𐴥. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴡𐴐𐴟𐴥𐴌 𐴀𐴡𐴥𐴘𐴃𐴡 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴓𐴟𐴑𐴝𐴘 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. 𐴃𐴟𐴀𐴛 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴠 𐴈𐴝𐴔 𐴀𐴞𐴀𐴕 𐴒𐴡𐴌𐴡𐴤𐴌, 𐴃𐴡𐴥𐴘 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴡𐴤.“ <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟𐴥 𐴀𐴝𐴕𐴠𐴤.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴎𐴝𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴎𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.</char> <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" /><char style="wj">𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥.</char> <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴠𐴥 𐴀𐴞𐴊𐴡𐴃𐴢 𐴎𐴡𐴦. 𐴀𐴝𐴀𐴛 𐴀𐴞𐴊𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴠𐴇𐴡𐴥𐴕 𐴕𐴡 𐴎𐴝𐴘𐴧𐴟𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤.“</char> <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴃𐴝𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="JHN 7:9" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴣𐴐𐴝𐴤𐴌-𐴀𐴞𐴊𐴢</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴊𐴡𐴃𐴢 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴒𐴞𐴦𐴘𐴠𐴥; 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴕𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴓𐴟𐴑𐴝𐴘𐴡𐴌𐴠 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />𐴀𐴞𐴊𐴡𐴃𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴍𐴠𐴥؟“<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴝𐴀𐴘𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴂𐴧𐴠-𐴏𐴟𐴂𐴧𐴠 𐴁𐴞𐴐𐴞𐴤 𐴉𐴟𐴍𐴝𐴉𐴟𐴍𐴞 𐴀𐴡𐴥𐴘𐴧𐴠. 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝 𐴒𐴡𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢.“</para>
  <para style="p" vid="JHN 7:12">𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴕𐴡, 𐴕𐴡, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴌𐴒𐴡𐴥𐴘.“<verse eid="JHN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 7:13" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴦𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴕𐴡𐴥 𐴈𐴡𐴀.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />𐴀𐴞𐴊𐴢 𐴀𐴠𐴑𐴊𐴡𐴥𐴑 𐴀𐴝𐴥𐴕𐴞𐴑 𐴀𐴡𐴥𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴏𐴝𐴤 𐴖𐴡𐴌𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴝𐴘 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />𐴀𐴝𐴦𐴌 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴃𐴝𐴦𐴓𐴞𐴔 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴀𐴕 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴎𐴝𐴕𐴠؟“<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴎𐴞𐴀𐴕 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴕𐴞𐴎𐴡𐴌 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌.</char> <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" /><char style="wj">𐴎𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴎𐴝𐴕𐴞𐴁𐴡𐴥, 𐴀𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴞𐴀𐴕 𐴑𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴒𐴝𐴤 𐴀𐴝𐴀𐴛 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠.</char> <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴈𐴡𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴃𐴟𐴖𐴝. 𐴓𐴠𐴑𐴞𐴕 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴊𐴞𐴉𐴠𐴍𐴡𐴥𐴘𐴧𐴝𐴌 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴃𐴟𐴖𐴝, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴡𐴥𐴘𐴧𐴞, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴞 𐴕𐴝𐴥𐴘.</char> <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" /><char style="wj">𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴏𐴡𐴀𐴌؟“</char><verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴟𐴥𐴃𐴠 𐴉𐴝𐴘𐴧𐴠𐴥. 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴇𐴡𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴏𐴝𐴥𐴌 𐴊𐴠𐴥؟“<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘.</char> <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" /><char style="wj">𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴡𐴤. 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴝𐴥 𐴔𐴟𐴀𐴏𐴝 𐴓𐴡𐴥𐴃𐴞 𐴐𐴟𐴥𐴌𐴟 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴒𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞.</char> <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" /><char style="wj">𐴔𐴟𐴀𐴏𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴕𐴡 𐴁𐴝𐴥𐴚𐴒𐴞 𐴁𐴡𐴓𐴧𐴝 𐴎𐴡𐴊𐴞 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤𐴌𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴀𐴝𐴀𐴛 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴑𐴞𐴘𐴝𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴥𐴘 𐴒𐴟𐴐𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴡؟</char> <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" /><char style="wj">𐴖𐴡𐴌𐴃𐴟𐴥 𐴏𐴝𐴀𐴘𐴢 𐴁𐴞𐴏𐴝𐴌 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.“</char><verse eid="JHN 7:24" /></para>
  <para style="s1">𐴀𐴞𐴁𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴠𐴥؟</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴑𐴞𐴥 𐴀𐴟𐴁𐴝𐴤 𐴕𐴡 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴏𐴝𐴥𐴌؟ <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />𐴓𐴠𐴑𐴞𐴕 𐴏𐴡𐴀, 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴡 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌, 𐴃𐴡𐴀 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴈𐴡𐴀𐴌. 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴡𐴥𐴕𐴡 𐴀𐴞𐴁𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴕𐴠𐴥؟ <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />𐴎𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴡𐴥𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴞, 𐴀𐴞𐴁𐴝𐴤 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴞𐴁𐴡𐴥.“<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥𐴘, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴞𐴕𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴘𐴡𐴥 𐴎𐴝𐴕𐴡. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠 𐴕𐴡, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝 𐴏𐴡𐴥𐴘𐴧𐴞. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴡𐴥.</char> <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴞𐴤, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠.“</char><verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴏𐴝𐴘𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴥𐴃𐴢 𐴕𐴡𐴥 𐴓𐴝𐴒𐴝. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />𐴃𐴡𐴀 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴥 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴡؟“<verse eid="JHN 7:31" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴝𐴀𐴘𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴥𐴐𐴉𐴟𐴐𐴝𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴀𐴝𐴙𐴕𐴃𐴡𐴤 𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠.<verse eid="JHN 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴌 𐴁𐴞𐴐𐴞𐴤 𐴊𐴞𐴕 𐴕𐴝𐴥𐴘, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘𐴧𐴟𐴔𐴁𐴡𐴥𐴘.</char> <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡 𐴉𐴝𐴘𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴍𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔, 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.“</char><verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />𐴃𐴡𐴥𐴘 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴖𐴝𐴘 𐴕𐴡 𐴉𐴝𐴘 𐴉𐴝𐴥𐴕 𐴀𐴞𐴁𐴝𐴤 𐴇𐴡𐴍𐴠𐴥 𐴎𐴝𐴘𐴃𐴡 𐴕𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠𐴥؟ 𐴎𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴐𐴞𐴥𐴣𐴍𐴝𐴐𐴞𐴄𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴡𐴥𐴕𐴡 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘 𐴇𐴠𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴁𐴡 𐴊𐴠 𐴕𐴠𐴥؟ <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴥𐴘 𐴑𐴞𐴦 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴥𐴌 𐴊𐴠, <char style="wj">’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡 𐴉𐴝𐴘𐴁𐴝,‘</char> 𐴀𐴝𐴦𐴌 <char style="wj">’𐴎𐴠𐴍𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔, 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥؟‘ “</char><verse eid="JHN 7:36" /></para>
  <para style="s1">𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴠𐴦 𐴊𐴠 𐴉𐴝𐴕𐴞𐴥</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴊𐴡𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴊𐴞𐴕𐴡𐴌 𐴊𐴞𐴕، 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴊𐴡𐴌 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴊𐴞𐴕 𐴀𐴡𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴡𐴌𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴞𐴌𐴝𐴥𐴐𐴞 𐴀𐴝𐴏𐴡𐴤, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴉𐴝𐴕𐴞𐴥 𐴈𐴡𐴥𐴀𐴒𐴝𐴘.</char> <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴔𐴡𐴎𐴞𐴕، ’𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴠𐴦 𐴊𐴠 𐴉𐴝𐴕𐴞𐴥 𐴀𐴟𐴍𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.‘ “</char> <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴝𐴘 𐴎𐴝𐴘𐴁𐴡. 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴇𐴠𐴥𐴃𐴟𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴊𐴞𐴦𐴘𐴝 𐴕𐴡𐴥 𐴎𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴇𐴠𐴥𐴃𐴟𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝.<verse eid="JHN 7:39" /></para>
  <para style="s1">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴀𐴡𐴥𐴘𐴧𐴠</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴝𐴦𐴊𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴠𐴥 𐴕𐴡𐴁𐴞.“<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤.“</para>
  <para style="p" vid="JHN 7:41">𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴡𐴀𐴏𐴞𐴤 𐴑𐴞𐴥 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴘𐴁𐴡𐴤 𐴕𐴠𐴥؟ <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴑𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴝𐴥𐴘, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴖𐴟𐴊𐴢 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴁𐴠𐴃𐴠𐴥𐴓𐴈𐴠𐴔 𐴉𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴘𐴁𐴡𐴤 𐴁𐴡𐴥𐴓𐴞؟“ <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴞𐴏𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴏𐴝𐴘𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴥𐴃𐴢 𐴕𐴡𐴥 𐴓𐴝𐴒𐴝.<verse eid="JHN 7:44" /></para>
  <para style="s1">𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴕𐴝𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴒𐴟𐴥𐴕 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡𐴥 𐴑𐴞𐴘𐴝𐴥 𐴀𐴝𐴕𐴡𐴤؟“<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴒𐴟𐴥𐴕𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘.“<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴒𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴇𐴡𐴥𐴕𐴡 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴡𐴥𐴘 𐴕𐴠𐴥؟ <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />𐴇𐴡𐴕𐴡𐴤 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴠 𐴘𐴝𐴥 𐴉𐴠𐴥𐴌𐴡𐴐𐴞𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥؟ <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴀𐴝𐴖𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴡 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴕𐴡 𐴎𐴝𐴕𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴓𐴝𐴀𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.“<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />𐴇𐴠𐴥 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴞𐴑𐴡𐴥𐴊𐴠𐴔𐴝𐴏𐴢 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴘𐴝𐴥𐴌 𐴀𐴝𐴒𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴞𐴀𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />”𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴔𐴟𐴑𐴡𐴃𐴧𐴟 𐴕𐴡𐴥 𐴉𐴟𐴥𐴙𐴕𐴃𐴠 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴑𐴞𐴦 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡𐴥 𐴎𐴝𐴙𐴕𐴃𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴡𐴥𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴑𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤؟“<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴘𐴡𐴥 𐴑𐴞𐴥 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐؟ 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴃𐴝𐴇𐴝𐴥𐴑𐴞𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴏𐴡𐴀, 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴁𐴞 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤.“<verse eid="JHN 7:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />𐴁𐴝𐴦𐴊𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴎𐴡𐴕 𐴎𐴝𐴌-𐴎𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴠𐴦-𐴃𐴠𐴦 𐴒𐴞𐴦𐴘𐴡𐴥𐴘.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s1">𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴁𐴞𐴏𐴝𐴌</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥.<verse eid="JHN 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 8:2" />𐴃𐴝𐴌𐴉𐴡𐴌 𐴊𐴞𐴕 𐴁𐴞𐴀𐴕𐴧𐴝 𐴏𐴡𐴥𐴀𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴁𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴑 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴥𐴌𐴝 𐴇𐴝𐴥𐴘𐴧𐴠. 𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴝𐴎𐴠𐴥 𐴃𐴞𐴥𐴘𐴝𐴒𐴝𐴌𐴝𐴘𐴧𐴠. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴥𐴎𐴟𐴌, 𐴀𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴥𐴌𐴝 𐴇𐴝𐴥𐴘𐴧𐴠. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴐𐴞𐴥𐴓𐴡𐴌 𐴊𐴡𐴓𐴝 𐴔𐴝𐴌𐴞 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴀𐴛 𐴑𐴞𐴦 𐴈𐴡𐴀؟“<verse eid="JHN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 8:6" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴠𐴥 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴓𐴝𐴕 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴓𐴎𐴝𐴔 𐴊𐴞𐴁𐴝𐴌 𐴔𐴡𐴑𐴝 𐴉𐴝𐴦.</para>
  <para style="p" vid="JHN 8:6">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤 𐴀𐴟𐴣𐴌𐴞 𐴁𐴡𐴀𐴘𐴢 𐴀𐴡𐴦𐴣𐴓𐴠 𐴔𐴠𐴍𐴞𐴃𐴢 𐴓𐴠𐴑𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴖𐴝𐴌𐴝𐴖𐴡𐴌𐴞 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴟𐴕𐴝𐴤 𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴏𐴡𐴤, 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴐𐴞𐴥𐴓𐴡𐴌 𐴊𐴡𐴓𐴝 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴒𐴠 𐴔𐴝𐴌𐴡.“</char> <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴁𐴝𐴌 𐴀𐴟𐴣𐴌𐴞 𐴁𐴡𐴀𐴘𐴢 𐴔𐴠𐴍𐴞𐴃𐴢 𐴓𐴠𐴑𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="JHN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9" />𐴇𐴠𐴥 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴌𐴝𐴤𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴌𐴞𐴥 𐴎𐴡𐴕-𐴎𐴡𐴕 𐴕𐴠𐴦𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴎𐴧𐴡𐴕 𐴃𐴝𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴘𐴡𐴥 𐴔𐴝𐴎𐴠𐴥 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />𐴀𐴞𐴏𐴝𐴤 𐴀𐴟𐴍𐴞𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡𐴥 𐴊𐴠𐴑𐴠𐴥, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝, 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴇𐴡𐴍𐴠𐴥؟ 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡𐴥 𐴊𐴡𐴥𐴌𐴠 𐴕𐴞𐴥𐴑𐴞؟“</char><verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡𐴥 𐴊𐴡𐴥𐴌𐴠.“</para>
  <para style="p" vid="JHN 8:11">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡 𐴊𐴡𐴥𐴌𐴞. 𐴎𐴝𐴦, 𐴒𐴟𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴐𐴢.“</char><verse eid="JHN 8:11" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴟𐴌</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴟𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴌𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴕𐴟 𐴀𐴝𐴥𐴣𐴍𐴞𐴁𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴕𐴟𐴌 𐴉𐴝𐴘𐴁𐴡.“</char><verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴁𐴝𐴤 𐴕𐴞𐴎𐴠 𐴀𐴠𐴥𐴕𐴝 𐴊𐴡𐴌; 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴡𐴁𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴡.“<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴁𐴝𐴤 𐴕𐴞𐴎𐴠 𐴊𐴞𐴓𐴠𐴥 𐴘𐴡, 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴁𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴍𐴠𐴥 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴀𐴝𐴦𐴌 𐴇𐴡𐴍𐴠𐴥 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡.</char> <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴔𐴡𐴎𐴞𐴕 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴡𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥.</char> <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" /><char style="wj">𐴀𐴝𐴀𐴛 𐴎𐴡𐴊𐴞 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴘𐴡, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴞𐴏𐴝𐴌 𐴇𐴡𐴥𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴠𐴑𐴠𐴥𐴓𐴝 𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴁𐴝𐴉𐴢 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤.</char> <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴀𐴡𐴥 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴊𐴟𐴘 𐴎𐴡𐴕𐴠 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴇𐴠𐴥 𐴒𐴡𐴁𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞.</char> <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴁𐴝𐴉𐴠 𐴘𐴡𐴥 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥.“</char><verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴉𐴢 𐴇𐴡𐴍𐴠𐴥؟“</para>
  <para style="p" vid="JHN 8:19">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴞𐴕𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴏𐴞𐴕𐴡𐴥. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴞𐴕𐴞𐴥𐴃𐴝, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴘𐴡𐴥 𐴏𐴞𐴕𐴞𐴥𐴃𐴝.“</char> <verse eid="JHN 8:19" /><verse number="20" style="v" sid="JHN 8:20" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴢 𐴊𐴝𐴕-𐴁𐴝𐴐𐴧𐴟𐴤𐴌 𐴋𐴝𐴥𐴑𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴁𐴠 𐴈𐴡𐴘𐴧𐴠𐴥. 𐴃𐴡𐴀 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤.<verse eid="JHN 8:20" /></para>
  <para style="s1">𐴀𐴝𐴀𐴛 𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴡 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴕𐴞𐴎𐴠 𐴔𐴡𐴌𐴞𐴁𐴝𐴥. 𐴀𐴝𐴀𐴛 𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.“</char><verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴡𐴥𐴕𐴡 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡 𐴕𐴠𐴥؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">’𐴀𐴝𐴀𐴛 𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.‘ “</char><verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴏𐴡𐴌 𐴃𐴧𐴟, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴖𐴡𐴃𐴧𐴟𐴥. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌; 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴡.</char> <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴕𐴞𐴎𐴠 𐴔𐴡𐴌𐴞𐴁𐴝𐴥. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝 𐴊𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴕𐴞𐴎𐴠 𐴔𐴡𐴌𐴞𐴁𐴝𐴥.“</char><verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴇𐴡𐴕؟“</para>
  <para style="p" vid="JHN 8:25">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴢-𐴈𐴡𐴀𐴘𐴢 𐴀𐴝𐴘𐴧𐴞𐴤𐴌.</char> <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴓𐴠𐴑𐴞𐴕 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝 𐴏𐴡𐴥𐴘𐴧𐴞. 𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴟𐴀𐴙𐴕 𐴈𐴡𐴀𐴘𐴢 𐴎𐴞𐴀𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴉𐴟𐴥𐴙𐴕𐴧𐴞.“</char><verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴝𐴉𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡𐴥 𐴁𐴟𐴎𐴠𐴥. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴖𐴡𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴁𐴝, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴎𐴝𐴕𐴞𐴁𐴝𐴥 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴀𐴛 𐴀𐴟𐴀𐴙𐴕 𐴁𐴠 𐴈𐴡𐴀𐴘𐴢 𐴎𐴞𐴀𐴕 𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴐𐴞𐴥𐴑𐴝𐴘𐴧𐴠.</char> <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" /><char style="wj">𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴑𐴠𐴥𐴓𐴝 𐴕𐴡𐴥 𐴀𐴠𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴈𐴝𐴔 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴞𐴥 𐴎𐴞𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥.“</char> <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤.<verse eid="JHN 8:30" /></para>
  <para style="s1">𐴏𐴡𐴥𐴘𐴧𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />𐴎𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤𐴃𐴢 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢,</char> <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" /><char style="wj">𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴎𐴝𐴕𐴞𐴁𐴝𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.“</char><verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴕𐴝𐴥𐴘. 𐴃𐴡𐴥𐴘 𐴃𐴟𐴀𐴛 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴎𐴝𐴊𐴢 𐴉𐴝𐴘𐴁𐴝</char>؟‘“<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴕𐴝𐴤𐴌 𐴒𐴟𐴓𐴝𐴔.</char> <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" /><char style="wj">𐴒𐴟𐴓𐴝𐴔 𐴃𐴡 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴟𐴖𐴝 𐴁𐴠 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴃𐴝𐴥𐴑𐴠.</char> <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴉𐴟𐴖𐴝𐴘𐴠 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴀𐴝𐴎𐴝𐴊𐴢 𐴀𐴡𐴥𐴘𐴁𐴝.</char> <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" /><char style="wj">𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢, 𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴏𐴡𐴀𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴎𐴝𐴒𐴝 𐴕𐴝𐴥𐴘.</char> <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴟𐴀𐴙𐴕 𐴈𐴡𐴀𐴘𐴢 𐴎𐴞𐴀𐴕 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴡𐴤 𐴎𐴞𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴉𐴟𐴥𐴙𐴕𐴧𐴡.“</char><verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔.“</para>
  <para style="p" vid="JHN 8:39">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴘𐴃𐴝 𐴁𐴡𐴥𐴓𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴈𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴝𐴥.</char> <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴎𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴥𐴕𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴏𐴡𐴀𐴌. 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴠 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴡𐴌 𐴒𐴟𐴥𐴕 𐴒𐴡𐴌𐴡𐴤𐴌 𐴊𐴠.“</char></para>
  <para style="p" vid="JHN 8:41">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴡𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴕𐴡; 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴁𐴝𐴉𐴢 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝.“<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴡𐴥𐴘𐴧𐴞 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴙𐴐𐴧𐴞𐴤. 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠.</char> <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴑𐴞𐴘𐴝𐴥 𐴕𐴡 𐴁𐴟𐴎𐴡𐴥𐴌؟ 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤𐴌𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴡𐴀𐴌.</char> <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴢 𐴀𐴡𐴌, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴌𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴡𐴀. 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴑𐴟𐴥𐴕𐴞, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴝𐴥𐴘. 𐴀𐴞𐴥𐴃𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀, 𐴕𐴞𐴎𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴈𐴡𐴀, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴞𐴏𐴝𐴥𐴑𐴟𐴌 𐴀𐴝𐴦𐴌 𐴔𐴞𐴏𐴝𐴥𐴌 𐴁𐴝𐴉𐴢.</char> <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴇𐴡𐴥𐴑 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴘𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴠 𐴀𐴝𐴀𐴛 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥؟ 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴑𐴞𐴘𐴝𐴥 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤؟</char> <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" /><char style="wj">𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴓𐴧𐴝𐴌, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴠. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴕𐴡 𐴉𐴟𐴥𐴕𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡.“</char><verse eid="JHN 8:47" /></para>
  <para style="s1">𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴀𐴛 𐴀𐴝𐴏𐴞𐴤</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴡𐴥 𐴈𐴡𐴀𐴘𐴢 𐴕𐴠𐴥, 𐴃𐴟𐴀𐴛 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴏𐴝𐴔𐴝𐴥𐴌𐴞, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴟𐴥𐴃𐴠 𐴉𐴝𐴘𐴧𐴠𐴥؟“<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴟𐴥𐴃𐴠 𐴕𐴡𐴥 𐴉𐴝𐴦. 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴃𐴟𐴖𐴝𐴙𐴌 𐴊𐴠 𐴕𐴡. 𐴓𐴠𐴑𐴞𐴕 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴞𐴎𐴧𐴡𐴃𐴡𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴌𐴝𐴑𐴠𐴥 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌.</char> <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴔𐴡𐴌𐴞𐴁𐴡𐴥.“</char><verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴝𐴑𐴧𐴝𐴒𐴡𐴌𐴞 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴟𐴥𐴃𐴠 𐴉𐴝𐴘𐴧𐴠𐴥. 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴃𐴡𐴀 𐴃𐴟𐴀𐴛 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">’𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴔𐴡𐴌𐴞𐴁𐴡𐴥.‘</char> <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />𐴃𐴟𐴀𐴛 𐴑𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌؟ 𐴀𐴞𐴥𐴁𐴝 𐴃𐴡 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. 𐴃𐴟𐴀𐴛 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴑𐴞𐴦 𐴁𐴡𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴡؟“<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴕𐴞𐴎𐴠 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴊𐴝𐴔 𐴕𐴝𐴥𐴘. 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴠 𐴀𐴠𐴥𐴕𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴡𐴥, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴞𐴥. 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴈𐴡𐴀𐴘𐴢, ’𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥,‘ 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴞𐴏𐴝𐴥𐴑𐴟𐴌 𐴄𐴡𐴥𐴀𐴌𐴞𐴘𐴟𐴔, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥.</char> <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴠 𐴀𐴝𐴣𐴀𐴌 𐴊𐴞𐴕 𐴊𐴠𐴑𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴐𐴝𐴤𐴘𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴀𐴙𐴓𐴢.“</char><verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />𐴃𐴡𐴥𐴘 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴡𐴐𐴢 𐴃𐴡 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴡𐴥 𐴊𐴠𐴥؟“<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴀𐴛 𐴀𐴝𐴏𐴞𐴤.“</char> <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />𐴇𐴠𐴥 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴐𐴞𐴥𐴓𐴡𐴌 𐴊𐴡𐴓𐴝 𐴉𐴠𐴣𐴍𐴝𐴘 𐴓𐴡𐴘𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴝𐴌𐴒𐴗𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s1">𐴀𐴠𐴑 𐴎𐴡𐴌𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴣𐴊𐴝𐴤𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />𐴀𐴞𐴏𐴝𐴤 𐴌𐴝𐴏𐴃𐴝 𐴁𐴝𐴥𐴘 𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴎𐴡𐴌𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴣𐴊𐴝𐴤. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥, 𐴇𐴝𐴌 𐴒𐴟𐴕𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴎𐴡𐴌𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠𐴥؟ 𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴌؟“<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴒𐴟𐴕𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴘𐴡𐴒𐴧𐴗𐴝𐴥𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴌 𐴒𐴟𐴕𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴘𐴡𐴒𐴧𐴗𐴝𐴥𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴔 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥.</char> <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" /><char style="wj">𐴊𐴞𐴕 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴟𐴁𐴝𐴤𐴌 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠. 𐴌𐴝𐴙𐴃𐴢 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" /><char style="wj">𐴎𐴠𐴃𐴡𐴥 𐴊𐴞𐴕 𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴏𐴞𐴤, 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴟𐴌.“</char><verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴠𐴍𐴞𐴃𐴢 𐴏𐴠𐴥𐴂𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴡𐴌𐴠 𐴉𐴟𐴥𐴣𐴄𐴢 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴉𐴟𐴥𐴣𐴄𐴢 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴣𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴁𐴡𐴥𐴌𐴝𐴘𐴊𐴞𐴘𐴠. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴦, 𐴎𐴝𐴘 𐴏𐴞𐴥𐴓𐴡𐴔 𐴉𐴡𐴀𐴙𐴌𐴒𐴗𐴝𐴥𐴃𐴧𐴟 𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴡𐴒𐴡𐴘“</char> (𐴏𐴞𐴥𐴓𐴡𐴔𐴡𐴌 𐴃𐴡𐴌𐴅𐴟𐴔𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, ”𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠“). 𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴎𐴝𐴘 𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴏𐴟𐴑𐴠𐴤 𐴊𐴠𐴑𐴞𐴥 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴉𐴞𐴥𐴌𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴒𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴡𐴥𐴌𐴝𐴃𐴢 𐴔𐴝𐴒𐴞𐴃𐴡𐴥 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴁𐴝𐴤 𐴀𐴟𐴁𐴝𐴤 𐴕𐴡 𐴕𐴠𐴥 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴡𐴀𐴘𐴢-𐴁𐴡𐴀𐴘𐴢 𐴇𐴡𐴥𐴌𐴝𐴃𐴢 𐴔𐴝𐴒𐴞𐴃𐴡𐴥؟“<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥𐴘, 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝.“</para>
  <para style="p" vid="JHN 9:9">𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴃𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴠.“</para>
  <para style="p" vid="JHN 9:9">𐴓𐴠𐴑𐴞𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴘𐴠, ”𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝,“ 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴟𐴑 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴑𐴟𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘؟“ <verse eid="JHN 9:10" /><verse number="11" style="v" sid="JHN 9:11" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴞𐴏𐴝𐴤 𐴈𐴡𐴀 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴔𐴠𐴍𐴞𐴌𐴠 𐴉𐴟𐴥𐴣𐴄𐴢 𐴁𐴝𐴕𐴝𐴘 𐴀𐴝𐴣𐴀𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴁𐴡𐴥𐴌𐴝𐴘𐴊𐴞𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">’𐴎𐴝𐴘 𐴏𐴞𐴥𐴓𐴡𐴔 𐴉𐴡𐴀𐴙𐴌𐴒𐴗𐴝𐴥𐴃𐴧𐴟 𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴡𐴒𐴡𐴘.‘</char> 𐴀𐴝𐴀𐴛 𐴎𐴝𐴘 𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴞 𐴌𐴝𐴥𐴌 𐴏𐴟𐴑𐴠𐴤 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴞𐴌.“<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴇𐴡𐴍𐴠𐴥؟“ 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞.“<verse eid="JHN 9:12" /></para>
  <para style="s1">𐴀𐴝𐴣𐴊𐴝𐴤 𐴖𐴝𐴌𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴝𐴘𐴊𐴞𐴘𐴠</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />𐴎𐴠 𐴊𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴠𐴍𐴞𐴌𐴠 𐴉𐴟𐴥𐴣𐴄𐴢 𐴁𐴝𐴕𐴝𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴏𐴟𐴑 𐴑𐴟𐴥𐴙𐴓𐴧𐴞𐴓𐴢, 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴏𐴟𐴑 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴝𐴁𐴝𐴌 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴉𐴟𐴥𐴣𐴄𐴢 𐴁𐴡𐴥𐴌𐴝𐴘𐴊𐴞𐴘𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴊𐴟𐴥𐴘𐴧𐴞 𐴌𐴝𐴥𐴌 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴞𐴥.“<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴕𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴕𐴡 𐴔𐴝𐴕𐴠.“</para>
  <para style="p" vid="JHN 9:16">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠𐴎𐴧𐴡𐴕 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠؟“ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡𐴌 𐴏𐴟𐴑 𐴑𐴟𐴥𐴙𐴓𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴃𐴟𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴏؟“</para>
  <para style="p" vid="JHN 9:17">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴕𐴡𐴁𐴞.“<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />𐴓𐴠𐴑𐴞𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴒𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴀𐴠𐴇𐴡𐴥𐴕 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴠𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴉𐴟𐴏𐴝𐴥𐴌 𐴕𐴡𐴥 𐴓𐴡𐴖𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴟𐴁𐴝𐴤 𐴕𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴡𐴌𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴣𐴊𐴝𐴤 𐴈𐴡𐴀𐴘𐴓𐴝؟ 𐴇𐴠𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴝𐴓𐴝 𐴀𐴞𐴃𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴠𐴌؟“<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴀𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴃𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴀𐴙𐴓𐴢; <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴀𐴞𐴃𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴠𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴞; 𐴀𐴞𐴃𐴝𐴌 𐴏𐴟𐴑 𐴇𐴡𐴕𐴠 𐴑𐴟𐴥𐴙𐴓𐴧𐴠 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴞. 𐴀𐴞𐴃𐴝𐴃𐴧𐴟 𐴁𐴡𐴐𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴃𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴡𐴤. 𐴀𐴞𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴁𐴡𐴤.“ <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴘𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴦𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴁𐴡𐴥𐴓𐴞 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴘𐴠 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠, ”𐴀𐴞𐴃𐴝𐴃𐴧𐴟 𐴁𐴡𐴐𐴢 𐴀𐴡𐴥𐴘𐴧𐴠; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴃𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴡𐴤.“<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴒𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴡𐴥𐴑 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌.“<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴘 𐴕𐴠 𐴕𐴡 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴕𐴞. 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴘𐴝𐴀𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴒𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔 𐴀𐴝𐴦𐴌 𐴘𐴝𐴓𐴝 𐴏𐴟𐴑𐴠𐴤 𐴊𐴠𐴑𐴞𐴥𐴌.“<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡𐴌𐴠𐴥 𐴑𐴞𐴦 𐴒𐴡𐴙𐴅𐴧𐴠𐴥؟ 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡𐴌 𐴏𐴟𐴑 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴑𐴟𐴥𐴓𐴞𐴊𐴞𐴘𐴠؟“<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴞, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴕𐴡𐴥 𐴉𐴟𐴥𐴕𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴁𐴝𐴌 𐴑𐴞𐴘𐴝𐴥 𐴉𐴟𐴥𐴙𐴕𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴇𐴡𐴥𐴕𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌؟“<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴝𐴙𐴓𐴢 𐴊𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴘 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠 𐴔𐴟𐴀𐴏𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴔𐴟𐴀𐴏𐴝 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴞.“<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴑𐴞 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝 𐴈𐴡𐴃𐴝𐴤! 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴕𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴡𐴀 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴏𐴟𐴑 𐴑𐴟𐴥𐴓𐴞𐴊𐴞𐴘𐴠. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴉𐴟𐴥𐴕𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴟𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴒𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴌𐴠𐴥. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴎𐴡𐴌𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴏𐴟𐴑 𐴑𐴟𐴥𐴓𐴞𐴊𐴞𐴘𐴠 𐴊𐴠 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴐𐴟𐴥𐴌𐴟 𐴀𐴡𐴥𐴘𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴉𐴟𐴥𐴕𐴝 𐴕𐴡𐴥 𐴎𐴝. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />𐴎𐴡𐴊𐴞 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴕𐴡 𐴊𐴠 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴙𐴃𐴧𐴡.“<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴃𐴟𐴘 𐴃𐴡 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴧𐴡𐴏𐴢, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴐𐴞𐴥𐴑𐴧𐴝 𐴊𐴡𐴌 𐴊𐴠𐴥؟“ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴝𐴘𐴊𐴞𐴘𐴠.<verse eid="JHN 9:34" /></para>
  <para style="s1">𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴀𐴝𐴣𐴊𐴝𐴤</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴕𐴠𐴦𐴓𐴝𐴘𐴊𐴞𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴡𐴤 𐴕𐴠𐴥؟“</char><verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴉𐴝𐴌𐴞.“<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴡𐴥; 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴥𐴁𐴝.“</char><verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤.“ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴡 𐴊𐴠𐴑𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴠𐴑𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.“</char><verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴀𐴝𐴣𐴊𐴝𐴤 𐴕𐴞𐴑𐴞؟“<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴘𐴃𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴒𐴟𐴕𐴝𐴤 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴃𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴈𐴡𐴀𐴌, ’𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠𐴑𐴞𐴥,‘ 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴃𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘.“</char><verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s1">𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴏𐴡𐴌𐴡𐴘𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴀𐴝𐴣𐴌𐴝𐴙𐴓𐴡𐴃𐴢 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴥𐴘 𐴕𐴡 𐴒𐴡𐴥𐴓𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴁𐴡𐴓𐴞 𐴉𐴝𐴌𐴝𐴤𐴘 𐴒𐴡𐴥𐴓𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴏𐴟𐴌 𐴀𐴠𐴊𐴧𐴠 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴢.</char> <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴥𐴘 𐴒𐴡𐴥𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴏𐴡𐴌𐴡𐴘𐴝.</char> <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴟𐴖𐴝𐴌 𐴏𐴡𐴦𐴛𐴊𐴝𐴌𐴠 𐴊𐴟𐴖𐴝𐴌 𐴑𐴟𐴥𐴓𐴞𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴠. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴝𐴔 𐴊𐴡𐴌𐴞-𐴊𐴡𐴌𐴞 𐴔𐴝𐴃𐴝𐴘 𐴁𐴝𐴀𐴌𐴠 𐴀𐴝𐴕𐴠𐴤.</char> <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴝𐴀𐴌𐴠 𐴀𐴝𐴙𐴕𐴧𐴝𐴤 𐴀𐴡𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴝𐴒𐴠-𐴀𐴝𐴒𐴠 𐴎𐴝𐴦, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴇𐴞𐴥𐴀𐴕𐴠 𐴏𐴞𐴕𐴠𐴥.</char> <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴏𐴞𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴊𐴝𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴡𐴏𐴞𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥.“</char> <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴑𐴞𐴦 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡𐴥 𐴁𐴟𐴎𐴠𐴥.<verse eid="JHN 10:6" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴡𐴔 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴏𐴡𐴌𐴡𐴘𐴝</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴓𐴟𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴀𐴛.</char> <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴒𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴏𐴟𐴌 𐴀𐴠𐴊𐴧𐴠 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴓𐴟𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡𐴥 𐴉𐴟𐴥𐴕𐴠.</char> <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴊𐴟𐴖𐴝𐴌. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴊𐴞𐴥 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴡. 𐴀𐴞𐴥𐴃𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴘𐴁𐴡𐴤 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴀𐴌𐴠 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴏𐴡𐴌𐴞𐴁𐴝𐴥𐴌 𐴎𐴝𐴒𐴝 𐴉𐴝𐴘𐴁𐴡.</char> <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" /><char style="wj">𐴏𐴟𐴌 𐴃𐴡 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴏𐴟𐴌𐴞, 𐴑𐴟𐴥𐴕 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴘𐴧𐴠𐴤. 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴦 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴎𐴠𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴒𐴡𐴌𐴞 𐴃𐴝𐴥𐴑𐴠.“</char><verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />
    <char style="wj">𐴒𐴡𐴔 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴏𐴡𐴌𐴡𐴘𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴀𐴛. 𐴒𐴡𐴔 𐴏𐴡𐴌𐴡𐴘𐴝𐴘𐴠 𐴃𐴡 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴠.</char> <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴟𐴎𐴟𐴌, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴏𐴡𐴌𐴡𐴘𐴝 𐴕𐴡, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴡𐴥 𐴕𐴡. 𐴀𐴞𐴥𐴃𐴠 𐴌𐴝𐴚𐴑𐴟𐴣𐴙𐴌 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥𐴓𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴉𐴠𐴥𐴓𐴝𐴘 𐴊𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴃𐴡𐴥𐴘 𐴌𐴝𐴚𐴑𐴟𐴣𐴙𐴌 𐴀𐴝𐴀𐴘𐴢 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴓𐴟𐴕𐴡𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴐𐴞𐴥𐴣𐴍𐴝𐴐𐴞𐴄𐴧𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠.</char> <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" /><char style="wj">𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴊𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴟𐴎𐴟𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴝 𐴕𐴝𐴥𐴘.</char><verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14" />
    <char style="wj">𐴒𐴡𐴔 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴏𐴡𐴌𐴡𐴘𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴀𐴛. 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴞𐴕𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴠 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴞𐴕𐴠𐴥,</char> <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" /><char style="wj">𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴞𐴕𐴠𐴥 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌𐴠 𐴏𐴞𐴕𐴞𐴥. 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞.</char> <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" /><char style="wj">𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴀𐴕 𐴀𐴠 𐴎𐴝𐴥𐴑𐴡𐴃𐴢 𐴕𐴝𐴥𐴘. 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴓𐴡𐴘𐴀𐴝𐴕𐴝𐴤 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴠 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴞𐴁𐴡. 𐴃𐴡𐴥𐴘 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴎𐴝𐴥𐴑 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴡𐴌𐴡𐴘𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.</char><verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />
    <char style="wj">”𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴎𐴝𐴕 𐴊𐴞, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴁𐴝𐴌 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴌𐴞.</char> <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" /><char style="wj">𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴞 𐴊𐴠. 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴁𐴝𐴌 𐴀𐴡𐴥 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴁𐴝𐴌 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴓𐴡𐴘𐴁𐴝𐴌 𐴀𐴡𐴥 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴀𐴛 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟.“</char><verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴁𐴟𐴥𐴃𐴠 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴁𐴝𐴤 𐴉𐴡𐴦𐴓𐴢. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴑𐴞𐴘𐴝𐴥 𐴉𐴟𐴥𐴕𐴡𐴌؟“<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴒𐴟𐴥𐴕 𐴃𐴡 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴈𐴡𐴃𐴝𐴤𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡. 𐴁𐴟𐴥𐴃𐴠 𐴀𐴝𐴣𐴊𐴝𐴤𐴌 𐴏𐴟𐴑 𐴑𐴟𐴥𐴓𐴞𐴊𐴞 𐴉𐴝𐴌𐴠 𐴕𐴞𐴑𐴞𐴥؟“<verse eid="JHN 10:21" /></para>
  <para style="s1">𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴈𐴝𐴕𐴟𐴥𐴑𐴝-𐴀𐴞𐴊𐴢<note caller="+" style="f"><char style="fr" closed="false">10‏:22 </char><char style="ft" closed="false">𐴀𐴞𐴊𐴢 𐴘𐴞𐴁𐴝𐴤𐴃𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴔𐴝𐴑𐴧𐴝𐴁𐴝𐴘𐴟𐴏𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴠𐴥𐴍𐴠 𐴒𐴡𐴥𐴓𐴞 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴙𐴓𐴢.</char></note> 𐴀𐴡𐴥𐴘𐴧𐴠. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴐𐴞𐴥𐴃𐴑𐴝𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴡𐴥𐴓𐴡𐴔𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴕𐴋𐴝𐴃𐴢 𐴄𐴡𐴀𐴓𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴒𐴞𐴥𐴌𐴞𐴊𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴌 𐴇𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴀𐴝𐴕𐴊𐴝𐴐𐴝𐴤𐴃𐴢 𐴌𐴝𐴑𐴞𐴥𐴁𐴝؟ 𐴃𐴟𐴀𐴛 𐴎𐴡𐴊𐴞 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴀.“<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤. 𐴎𐴠 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴕𐴝𐴔𐴠 𐴒𐴡𐴌𐴞𐴥, 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥.</char> <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴓𐴟𐴕𐴡𐴃𐴧𐴟 𐴕𐴡.</char> <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴠, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴏𐴞𐴕𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴀𐴝𐴘𐴧𐴠𐴤.</char> <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" /><char style="wj">𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴞𐴦; 𐴇𐴞𐴥𐴀𐴕 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴊𐴡𐴥𐴚𐴐𐴡 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡; 𐴀𐴝𐴌𐴡𐴤 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴝𐴌𐴞𐴤𐴓𐴡𐴘𐴉𐴠𐴓𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌. 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴇𐴝𐴌𐴞𐴤𐴓𐴡𐴘𐴉𐴠𐴓𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴉𐴢 𐴀𐴠𐴑.“</char><verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴙𐴃𐴧𐴡 𐴀𐴝𐴁𐴝𐴌 𐴐𐴞𐴥𐴓𐴡𐴌 𐴊𐴡𐴓𐴝 𐴉𐴠𐴣𐴍𐴝𐴘 𐴓𐴡𐴘𐴧𐴠𐴥. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴊𐴠 𐴁𐴝𐴉𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴒𐴡𐴔-𐴒𐴡𐴔 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴞. 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴧𐴝𐴥𐴕 𐴀𐴡𐴥𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴐𐴞𐴥𐴓𐴡𐴌 𐴊𐴡𐴓𐴝 𐴔𐴝𐴙𐴃𐴧𐴡 𐴏𐴡𐴀𐴌 𐴊𐴠𐴥؟“</char><verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴐𐴞𐴥𐴓𐴡𐴌 𐴊𐴡𐴓𐴝 𐴔𐴝𐴌𐴞𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝. 𐴃𐴟𐴀𐴛 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴘 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴀𐴝𐴓𐴧𐴝 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴡𐴤𐴌.“<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴑𐴟𐴥𐴊𐴝‘</char><note caller="+" style="f"><char style="fr" closed="false">10‏:34 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 82:6">𐴎𐴡𐴁𐴟𐴌 82‏:6</ref></char></char></note><char style="wj">؟</char> <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" /><char style="wj">𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴑𐴝𐴓𐴝𐴔 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴡 𐴑𐴟𐴥𐴊𐴝 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴘𐴠. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴃𐴡 𐴁𐴝𐴊𐴢 𐴊𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" /><char style="wj">𐴁𐴝𐴉𐴢 𐴕𐴞𐴎𐴠 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠. 𐴀𐴝𐴀𐴛 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴈𐴡𐴘𐴧𐴞𐴥, ’𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝,‘ 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴡𐴥؟‘</char> <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" /><char style="wj">𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥;</char> <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴎𐴡𐴊𐴞 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴘𐴡, 𐴈𐴝𐴔 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴡 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴎𐴡𐴥 𐴊𐴠, 𐴁𐴝𐴉𐴢 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴞𐴤.“</char> <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴌𐴞𐴒𐴞𐴓𐴒𐴡𐴘.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴁𐴝𐴌 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴌 𐴉𐴝𐴌𐴑𐴟𐴓𐴠 𐴎𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠𐴒𐴡𐴘, 𐴎𐴠𐴍𐴠𐴥 𐴀𐴝𐴒𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴃𐴡. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴘𐴃𐴡𐴤 𐴊𐴠, ”𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴈𐴡𐴀𐴙𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴏𐴡𐴥𐴘𐴧𐴞.“ <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />𐴇𐴠𐴥𐴍𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s1">𐴓𐴝𐴏𐴝𐴥𐴌𐴡𐴌 𐴔𐴡𐴦𐴃𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />𐴓𐴝𐴏𐴝𐴥𐴌 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴐𐴟𐴥𐴑 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝 𐴉𐴝𐴌𐴝𐴌, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴡𐴥𐴙𐴕 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴡𐴃𐴝 𐴘𐴡𐴥 𐴃𐴝𐴥𐴑𐴞𐴃𐴡. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />𐴇𐴠𐴥 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴄𐴠𐴥𐴚𐴡𐴃𐴢 𐴀𐴝𐴣𐴃𐴡𐴌 𐴋𐴝𐴥𐴓𐴞𐴊𐴞 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴓𐴢 𐴓𐴡𐴘 𐴉𐴟𐴣𐴏𐴞𐴥𐴊𐴞𐴓𐴢. 𐴎𐴠 𐴓𐴝𐴏𐴝𐴥𐴌 𐴀𐴡𐴐𐴟𐴥𐴑 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴥𐴘. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴡𐴥𐴘𐴕𐴝𐴙𐴕 𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴈𐴡𐴃𐴝𐴤 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴧𐴠 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴎𐴝𐴌𐴠𐴥 𐴀𐴝𐴊𐴡𐴌 𐴒𐴡𐴌𐴡𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴡𐴐𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴧𐴠.“<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴌𐴝𐴥𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴠𐴥 𐴀𐴡𐴐𐴟𐴥𐴑 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴡𐴦𐴃𐴡𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥.“</char> <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴡𐴌𐴡𐴃𐴝 𐴌𐴠, 𐴇𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴥𐴙𐴕 𐴀𐴡𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴏𐴝𐴥𐴌𐴡𐴌𐴠 𐴀𐴝𐴊𐴡𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />𐴃𐴡𐴀 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴐𐴟𐴥𐴑 𐴊𐴠 𐴉𐴟𐴥𐴕𐴞, 𐴀𐴞𐴥𐴁𐴝 𐴎𐴠 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴌𐴡𐴤 𐴊𐴟𐴘 𐴊𐴞𐴕 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴁𐴝𐴌 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴢 𐴎𐴝𐴘.“</char><verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥, 𐴘𐴝𐴦𐴌 𐴇𐴡𐴦𐴊𐴧𐴞𐴕 𐴀𐴝𐴒𐴠 𐴃𐴡 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴐𐴞𐴥𐴓𐴡𐴌 𐴊𐴡𐴓𐴝 𐴔𐴝𐴙𐴃𐴧𐴡 𐴏𐴝𐴀𐴙𐴓𐴢, 𐴃𐴡𐴀 𐴃𐴟𐴀𐴛 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴁𐴝𐴌 𐴎𐴝𐴘𐴃𐴡 𐴏𐴡𐴀𐴌 𐴊𐴠𐴥؟“<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴊𐴞𐴕𐴡𐴃𐴢 𐴑𐴞 𐴁𐴝𐴌𐴡𐴥 𐴒𐴡𐴥𐴕𐴋𐴝 𐴕𐴝𐴥𐴘 𐴕𐴠؟ 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴎𐴡𐴊𐴞 𐴊𐴞𐴕𐴡𐴃𐴢 𐴀𐴝𐴥𐴣𐴍𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴟𐴅𐴝𐴥𐴄𐴢 𐴕𐴝 𐴇𐴝𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴀𐴌 𐴊𐴠𐴑𐴠𐴥.</char> <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴎𐴡𐴊𐴞 𐴌𐴝𐴙𐴃𐴡𐴃𐴢 𐴀𐴝𐴥𐴣𐴍𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴟𐴅𐴝𐴥𐴄𐴢 𐴇𐴝𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴡𐴀𐴌 𐴕𐴝𐴥𐴘.“</char><verse eid="JHN 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11" />𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴟𐴏𐴃𐴡𐴥 𐴓𐴝𐴏𐴝𐴥𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴃𐴡 𐴎𐴝𐴙𐴌.“</char><verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />𐴃𐴡𐴥𐴘 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴄𐴞𐴥𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“ <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴄𐴝𐴥𐴀𐴙𐴅𐴧𐴞𐴓𐴢 𐴊𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴟𐴥𐴔𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥 𐴁𐴡𐴥𐴓𐴞.<verse eid="JHN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠, <char style="wj">”𐴓𐴝𐴏𐴝𐴥𐴌 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘.</char> <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" /><char style="wj">𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴍𐴠 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴑𐴟𐴥𐴐𐴞, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴡. 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘.“</char><verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴃𐴡𐴥𐴔𐴝𐴏𐴢, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴎𐴡𐴦𐴣𐴙𐴑𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴋𐴝𐴑𐴠,<note caller="+" style="f"><char style="fr" closed="false">11‏:16 </char><char style="fq">𐴃𐴡𐴥𐴔𐴝𐴏𐴢</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴌𐴝𐴤𐴔𐴞𐴑 𐴓𐴡𐴉𐴎𐴡𐴥, <char style="fqa">𐴊𐴞𐴊𐴞𐴔𐴟𐴏𐴢 </char>𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴞𐴌𐴞𐴥𐴑 𐴓𐴡𐴉𐴎𐴡𐴥, 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 <char style="fq" closed="false">𐴎𐴡𐴦𐴣𐴙𐴑𐴧𐴝</char></note> 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴥𐴣𐴍𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴎𐴝𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴌𐴞 𐴉𐴝𐴌𐴞.“<verse eid="JHN 11:16" /></para>
  <para style="s1">𐴇𐴝𐴥𐴣𐴐𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴀𐴛</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴠𐴥𐴍𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴓𐴝𐴏𐴝𐴥𐴌𐴡𐴌𐴠 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠 𐴏𐴝𐴙𐴌 𐴊𐴞𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝 𐴒𐴝𐴥𐴕 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴊𐴟𐴘 𐴔𐴝𐴙𐴓𐴢 𐴀𐴝𐴥𐴕𐴞𐴑 𐴊𐴟𐴌𐴠𐴥 𐴊𐴠. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />𐴁𐴞𐴐𐴞𐴤 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴡𐴌𐴡𐴃𐴝 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴘𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴡𐴌𐴡𐴃𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴃𐴡 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘.<verse eid="JHN 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21" />𐴔𐴡𐴌𐴡𐴃𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴎𐴡𐴊𐴞 𐴀𐴠𐴍𐴠𐴥 𐴀𐴡𐴥𐴘𐴃𐴝, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘 𐴕𐴡 𐴔𐴡𐴌𐴞𐴃𐴡𐴥. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴞, 𐴃𐴟𐴀𐴛 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴡𐴥 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴔𐴝𐴒𐴞𐴁𐴝𐴥, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴞𐴦𐴁𐴡.“<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴌 𐴁𐴝𐴥𐴘 𐴀𐴝𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘 𐴀𐴟𐴍𐴞𐴤𐴁𐴡.“</char><verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />𐴔𐴡𐴌𐴡𐴃𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴊𐴞𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘 𐴀𐴟𐴍𐴞𐴤𐴁𐴡.“<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴝𐴥𐴣𐴐𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴀𐴛. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴔𐴡𐴌𐴞𐴓𐴠𐴥 𐴘𐴡 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴞𐴁𐴡,</char> <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡 𐴔𐴡𐴌𐴞𐴁𐴡𐴥. 𐴃𐴟𐴘 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴕𐴠𐴥؟“</char><verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴡𐴥𐴘, 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤 𐴊𐴠, 𐴃𐴟𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴔𐴡𐴀𐴏𐴞𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.“<verse eid="JHN 11:27" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴇𐴝𐴙𐴕𐴊𐴠𐴤</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠, 𐴇𐴞𐴥𐴁𐴝 𐴎𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴥𐴙𐴕 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴎𐴟𐴘𐴃𐴠𐴥𐴒𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴋𐴝𐴑𐴠𐴌.“<verse eid="JHN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 11:29" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴇𐴞𐴥𐴁𐴝 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴏𐴝𐴤 𐴉𐴝𐴌𐴝𐴃𐴢 𐴕𐴡𐴥 𐴉𐴡𐴀𐴣𐴏𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴟𐴍𐴠𐴤 𐴎𐴠𐴍𐴠𐴥 𐴔𐴡𐴌𐴡𐴃𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴊𐴡𐴓𐴝 𐴀𐴡𐴥𐴀𐴙𐴓𐴢. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />𐴎𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴘 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴞𐴥𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴀𐴟𐴍𐴞𐴤 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴎𐴝𐴦𐴌𐴒𐴡𐴥𐴘 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴄𐴝𐴥𐴀𐴙𐴅𐴧𐴠 𐴊𐴠, 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴢 𐴈𐴝𐴣𐴊𐴞𐴃𐴡𐴥 𐴎𐴝𐴦𐴌.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴀𐴟𐴍𐴠𐴤 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠 𐴎𐴠𐴍𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴃𐴢 𐴉𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴎𐴡𐴊𐴞 𐴀𐴠𐴍𐴠𐴥 𐴀𐴡𐴥𐴘𐴃𐴝, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘 𐴕𐴡 𐴔𐴡𐴌𐴞𐴃𐴡𐴥.“<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴝𐴣𐴊𐴝𐴕𐴞 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴓𐴝𐴙𐴒𐴧𐴞𐴥𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴄𐴉𐴟𐴌𐴞 𐴀𐴟𐴙𐴄𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴡𐴍𐴠𐴥 𐴌𐴝𐴙𐴑𐴧𐴡𐴥؟“</char></para>
  <para style="p" vid="JHN 11:34">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴏𐴡𐴀𐴒𐴝𐴘.“<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />𐴀𐴞𐴏𐴝𐴤 𐴈𐴝𐴣𐴊𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="JHN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴊𐴡𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥!“<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴞𐴘𐴠𐴥-𐴑𐴞𐴘𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴊𐴝𐴤𐴌 𐴏𐴟𐴑 𐴑𐴟𐴥𐴓𐴞 𐴊𐴞𐴥𐴓𐴢, 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴏𐴝𐴘𐴃𐴡𐴥 𐴁𐴡𐴥𐴓𐴞 𐴑𐴞𐴥 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴕𐴡 𐴔𐴡𐴌𐴠 𐴉𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴙𐴃𐴧𐴡 𐴕𐴠𐴥؟“<verse eid="JHN 11:37" /></para>
  <para style="s1">𐴓𐴝𐴏𐴝𐴥𐴌𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴁𐴞𐴐𐴞𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴓𐴝𐴒𐴞, 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴒𐴞𐴦𐴘𐴠𐴥. 𐴈𐴡𐴁𐴡𐴌𐴒𐴗𐴝𐴥 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴑𐴟𐴥𐴣𐴊𐴝, 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴑𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴞𐴥𐴓𐴢 𐴀𐴡𐴎𐴝𐴘𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴐𐴞𐴥𐴓𐴢 𐴓𐴝𐴕 𐴓𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴡.“</char></para>
  <para style="p" vid="JHN 11:39">𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴡𐴥𐴙𐴕 𐴔𐴡𐴌𐴡𐴃𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴘𐴝𐴓𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴁𐴝𐴐𐴢 𐴀𐴟𐴍𐴞𐴤𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴏𐴝𐴙𐴌 𐴊𐴞𐴕 𐴀𐴡𐴥𐴘𐴧𐴠.“<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥, 𐴎𐴡𐴊𐴞 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴌𐴡𐴤𐴏𐴢, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴊𐴠𐴑𐴞𐴥𐴁𐴞 𐴁𐴡𐴥𐴓𐴞؟“</char><verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴐𐴞𐴥𐴓𐴢 𐴓𐴝𐴕 𐴓𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴖𐴡𐴌𐴔𐴞𐴑𐴧𐴝𐴥 𐴏𐴟𐴑 𐴃𐴟𐴓𐴞𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴙𐴕𐴧𐴡 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴎𐴝𐴕𐴝𐴙𐴌.</char> <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" /><char style="wj">𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴃𐴟𐴀𐴛 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴝𐴀𐴛 𐴘𐴝𐴀𐴕 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴀𐴛 𐴁𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴡.“</char><verse eid="JHN 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43" />𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴧𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴋𐴝𐴑 𐴔𐴝𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴓𐴝𐴏𐴝𐴥𐴌, 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘!“</char><verse eid="JHN 11:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 11:44" />𐴃𐴡𐴥𐴘 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴥𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴄𐴠𐴥𐴚 𐴒𐴟𐴕 𐴇𐴡𐴇𐴡𐴥𐴕𐴡𐴌 𐴇𐴡𐴦𐴌 𐴓𐴡𐴘 𐴁𐴝𐴙𐴕𐴊𐴝𐴤, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴟𐴑 𐴑𐴝𐴥𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴇𐴡𐴦𐴌 𐴓𐴡𐴘 𐴁𐴠𐴌𐴝𐴤𐴘𐴧𐴝.</para>
  <para style="p" vid="JHN 11:44">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴡𐴒𐴧𐴗𐴝𐴥𐴌𐴠 𐴑𐴟𐴥𐴓𐴞𐴉𐴠𐴓𐴡, 𐴀𐴝𐴦𐴌 𐴎𐴝𐴘𐴃𐴡 𐴊𐴡.“</char><verse eid="JHN 11:44" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴏𐴡𐴥𐴓𐴧𐴝</para>
  <para style="r">(<ref loc="MAT 26:1-5">𐴔𐴡𐴃𐴢 26‏:1‏-5</ref>; <ref loc="MRK 14:1-2">𐴔𐴝𐴑 14‏:1‏-2</ref>; <ref loc="LUK 22:1-2">𐴓𐴟𐴑 22‏:1‏-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴎𐴝𐴘, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴞𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥𐴒𐴡𐴘.<verse eid="JHN 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 11:47" />𐴃𐴡𐴥𐴘 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴡𐴥𐴃𐴟𐴖𐴝𐴘𐴞-𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴡𐴌𐴠 𐴔𐴞𐴥𐴄𐴞𐴚 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴇𐴡𐴥𐴕 𐴑𐴞𐴦 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟ 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴃𐴡 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴠𐴥𐴌. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴌𐴞𐴊𐴞 𐴌𐴝𐴑𐴞𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴉𐴠𐴓𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴌𐴡𐴔𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴂𐴝𐴑 𐴎𐴝𐴒𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴡𐴗𐴔𐴡𐴌𐴠 𐴑𐴡𐴁𐴎𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡.“<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴑𐴝𐴥𐴘𐴧𐴝𐴉𐴝𐴏𐴢 𐴕𐴝𐴔𐴡𐴌 𐴎𐴞𐴁𐴝𐴤 𐴇𐴠𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴎𐴝𐴕𐴡, <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴁𐴝𐴥𐴉𐴞 𐴕𐴡 𐴏𐴡𐴀𐴌 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴟𐴌𐴝 𐴑𐴡𐴗𐴔 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴎𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴑𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴔𐴡𐴌𐴡𐴕.“<verse eid="JHN 11:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴓𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴇𐴠𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴑𐴞, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴑𐴡𐴗𐴔𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴞𐴁𐴡𐴥; <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴠𐴥 𐴑𐴡𐴗𐴔𐴡𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴑𐴧𐴝𐴤-𐴀𐴟𐴙𐴑𐴧𐴝𐴤 𐴊𐴡𐴌𐴁𐴡𐴊𐴡𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴥.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴏𐴡𐴥𐴓𐴧𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴌 𐴀𐴝𐴀-𐴎𐴝𐴦 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴈𐴠𐴥𐴕𐴃𐴟 𐴔𐴡𐴘𐴊𐴝𐴕 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠𐴉𐴠𐴌𐴝𐴙𐴔 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴓𐴡𐴦𐴘𐴢 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴑𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴢 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴊𐴡𐴌 𐴀𐴝𐴒𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴉𐴝𐴌𐴝𐴃𐴧𐴟 𐴖𐴡𐴌𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴄𐴝𐴥𐴀𐴌𐴡؟ 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴊𐴡𐴃𐴢 𐴀𐴠𐴁𐴧𐴠 𐴕𐴟 𐴀𐴝𐴘𐴁𐴡𐴤 𐴕𐴞𐴥𐴑𐴞؟“ <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴎𐴝𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴇𐴡𐴍𐴠𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴝𐴕𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 𐴊𐴞𐴃𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s1">𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴄𐴠𐴥𐴚𐴡𐴃𐴢 𐴀𐴝𐴣𐴃𐴡𐴌 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MAT 26:6-13">𐴔𐴡𐴃𐴢 26‏:6‏-13</ref>; <ref loc="MRK 14:3-9">𐴔𐴝𐴑 14‏:3‏-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴏𐴡𐴥 𐴊𐴞𐴕 𐴀𐴝𐴒𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴠𐴍𐴠𐴥 𐴀𐴡 𐴓𐴝𐴏𐴝𐴥𐴌 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴁𐴞𐴘𐴝𐴓𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴔𐴡𐴌𐴡𐴃𐴝𐴘𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴓𐴝𐴏𐴝𐴥𐴌 𐴀𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴇𐴝𐴥𐴄𐴞 𐴕𐴝𐴌𐴋-𐴒𐴝𐴏𐴡𐴌 𐴁𐴞𐴐𐴞𐴤 𐴔𐴡𐴀𐴚𐴒𐴝 𐴀𐴝𐴎𐴧𐴠𐴥𐴌 𐴀𐴝𐴣𐴃𐴡𐴌 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴡𐴦𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴓𐴢 𐴓𐴡𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴦 𐴉𐴟𐴣𐴏𐴞𐴥𐴊𐴞𐴘𐴠. 𐴇𐴠𐴥 𐴀𐴝𐴣𐴃𐴡𐴌𐴡𐴌 𐴑𐴟𐴥𐴐𐴁𐴡𐴘𐴠 𐴒𐴡𐴥𐴌 𐴒𐴝𐴥𐴕 𐴁𐴡𐴥𐴌𐴞𐴒𐴞𐴓𐴒𐴡𐴘.<verse eid="JHN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴞𐴏𐴑𐴝𐴥𐴌𐴞𐴘𐴠𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />”𐴀𐴠 𐴀𐴝𐴣𐴃𐴡𐴌 𐴒𐴟𐴥𐴕 𐴑𐴞𐴘𐴝𐴥 𐴃𐴞𐴕 𐴐𐴡𐴥𐴃𐴢 𐴊𐴞𐴕𐴝𐴥𐴌 𐴊𐴞𐴥 𐴁𐴠𐴏𐴞 𐴄𐴞𐴛𐴝 𐴒𐴟𐴥𐴕 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴞𐴦 𐴕𐴡𐴥 𐴉𐴠𐴓𐴠؟“ <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />𐴀𐴞𐴥𐴃𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴝 𐴃𐴝𐴥𐴑𐴞 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴏𐴟𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴄𐴞𐴛𐴝𐴌 𐴉𐴠𐴄𐴞 𐴀𐴞𐴥𐴃𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴘𐴞𐴥𐴁𐴝𐴃𐴢 𐴎𐴞𐴀𐴕 𐴀𐴠𐴌𐴝 𐴎𐴝𐴘𐴃𐴡 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴞𐴥𐴃𐴠 𐴏𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴃𐴡.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴡; 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴊𐴡𐴇𐴡𐴥𐴕𐴡𐴌 𐴊𐴞𐴕𐴡𐴓𐴧𐴝 𐴁𐴠 𐴌𐴝𐴙𐴑𐴧𐴠𐴥.</char> <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" /><char style="wj">𐴒𐴡𐴌𐴞𐴁𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴞𐴃𐴧𐴞 𐴀𐴝𐴏𐴠𐴤,</char><note caller="+" style="f"><char style="fr" closed="false">12‏:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 15:11">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 15‏:11</ref></char>.</char></note> <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴃𐴧𐴞 𐴕𐴡 𐴉𐴝𐴘𐴁𐴝.“</char><verse eid="JHN 12:8" /></para>
  <para style="s1">𐴓𐴝𐴏𐴝𐴥𐴌𐴡𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴏𐴡𐴥𐴓𐴧𐴝</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />𐴀𐴞𐴏𐴝𐴤 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴏𐴝𐴤 𐴓𐴧𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴓𐴝𐴏𐴝𐴥𐴌𐴡𐴌𐴠 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />𐴓𐴠𐴑𐴞𐴕 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴓𐴝𐴏𐴝𐴥𐴌𐴡𐴌𐴠 𐴘𐴡𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴏𐴡𐴥𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤𐴌.<verse eid="JHN 12:11" /></para>
  <para style="s1">𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴒𐴡𐴥𐴙𐴓𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 21:1-11">𐴔𐴡𐴃𐴢 21‏:1‏-11</ref>; <ref loc="MRK 11:1-11">𐴔𐴝𐴑 11‏:1‏-11</ref>; <ref loc="LUK 19:28-40">𐴓𐴟𐴑 19‏:28‏-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />𐴃𐴝𐴌𐴉𐴡𐴌 𐴊𐴞𐴕، 𐴎𐴠 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴊𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴎𐴟-𐴒𐴝𐴏𐴡𐴌 𐴋𐴝𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴊𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴃𐴡 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="JHN 12:13">”𐴇𐴡𐴥𐴏𐴝𐴕𐴝!<note caller="+" style="f"><char style="fr" closed="false">12‏:13 </char><char style="ft" closed="false">𐴇𐴞𐴁𐴌𐴟𐴤 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 </char><char style="fq" closed="false">𐴇𐴡𐴥𐴏𐴝𐴕𐴝 </char><char style="ft" closed="false">𐴔𐴝𐴀𐴕𐴞 (𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴝𐴏𐴡). 𐴓𐴡𐴉𐴎𐴡𐴥 𐴘𐴞𐴁𐴝𐴤 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴥 𐴘𐴝𐴀𐴕 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.</char></note></para>
  <para style="q1" vid="JHN 12:13">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌,<note caller="+" style="f"><char style="fr" closed="false">12‏:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:25">𐴎𐴡𐴁𐴟𐴌 118‏:25</ref>‏,<ref loc="PSA 118:26">26</ref></char></char></note></para>
  <para style="q1" vid="JHN 12:13">𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝!“<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴝𐴊𐴝𐴤𐴌 𐴏𐴡𐴥𐴀 𐴉𐴝𐴘 𐴘𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴙𐴐𐴧𐴞𐴥𐴓𐴢; 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />”𐴀𐴡𐴥 𐴏𐴞𐴥𐴘𐴡𐴕𐴡𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝, 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥;</para>
  <para style="q2" vid="JHN 12:15">𐴏𐴡𐴀, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝</para>
  <para style="q2" vid="JHN 12:15">𐴒𐴝𐴊𐴝𐴤𐴌 𐴏𐴡𐴥𐴀𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴀𐴘𐴢 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.“<note caller="+" style="f"><char style="fr" closed="false">12‏:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 9:9">𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝 9‏:9</ref></char></char></note><verse eid="JHN 12:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="JHN 12:16" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴒𐴠 𐴁𐴟𐴎𐴞𐴥 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥 𐴊𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴠𐴥𐴀𐴕-𐴇𐴠𐴥𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴓𐴝𐴏𐴝𐴥𐴌𐴡𐴌𐴠 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴧𐴟 𐴋𐴝𐴑𐴞 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴘𐴡𐴥 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴊𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴃𐴡 𐴒𐴞𐴀𐴓𐴢 𐴊𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴢 𐴊𐴠, 𐴇𐴠𐴥 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴃𐴝𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴊𐴠𐴑𐴡𐴥𐴌, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴡 𐴀𐴡𐴥𐴌. 𐴏𐴡𐴀, 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.“<verse eid="JHN 12:19" /></para>
  <para style="s1">𐴇𐴡𐴊𐴟𐴥𐴕 𐴒𐴞𐴌𐴞𐴥𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />𐴇𐴠𐴥 𐴀𐴞𐴊𐴡𐴃𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴒𐴞𐴌𐴞𐴥𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴞𐴓𐴞𐴥𐴂𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴅𐴡𐴕𐴝𐴥𐴁𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴏𐴝𐴘𐴃𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌.“ 𐴉𐴞𐴓𐴞𐴥𐴂𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴁𐴠𐴃𐴏𐴝𐴥𐴘𐴊𐴝 𐴉𐴝𐴌𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢. <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />𐴉𐴞𐴓𐴞𐴥𐴂𐴠 𐴎𐴝𐴘 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴡𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴓𐴞𐴥𐴂𐴠 𐴎𐴝𐴘 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥𐴒𐴡𐴘.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.</char> <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴒𐴞𐴣𐴘𐴟𐴌 𐴁𐴞𐴏𐴢 𐴎𐴠𐴃𐴟𐴥𐴕 𐴔𐴠𐴍𐴞𐴃𐴢 𐴉𐴡𐴌𐴞 𐴕𐴡𐴥 𐴔𐴡𐴌𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕 𐴒𐴝𐴦𐴒𐴝 𐴃𐴝𐴥𐴑𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴔𐴡𐴌𐴠, 𐴘𐴞𐴥𐴁𐴝𐴃𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴡𐴥𐴌𐴠.</char> <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕𐴡𐴌𐴠 𐴊𐴠𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴓𐴧𐴝 𐴁𐴝𐴏𐴝𐴘 𐴌𐴝𐴑𐴞𐴥𐴁𐴡.</char> <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" /><char style="wj">𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴎𐴠𐴍𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥 𐴇𐴠𐴥𐴍𐴠 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char><verse eid="JHN 12:26" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />
    <char style="wj">”𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌 𐴌𐴟𐴀 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴀𐴝𐴀𐴛 𐴑𐴞𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴃𐴝𐴥𐴔 𐴕𐴠𐴥, ’𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘 𐴌𐴝𐴑𐴡𐴥‘؟ 𐴕𐴡, 𐴀𐴝𐴀𐴛 𐴀𐴠 𐴀𐴡𐴑𐴃𐴡𐴥 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴙𐴐𐴧𐴞𐴤.</char> <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" /><char style="wj">𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴡𐴤.“</char></para>
  <para style="p" vid="JHN 12:28">𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴘𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴁𐴝𐴌 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔 𐴀𐴡𐴥.“ <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴠𐴥𐴍𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥 𐴀𐴝𐴁𐴝𐴏𐴢 𐴏𐴗𐴝𐴥 𐴉𐴟𐴥𐴕𐴞 𐴋𐴠𐴁𐴝 𐴔𐴝𐴙𐴃𐴧𐴠𐴥 𐴊𐴠 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴘𐴧𐴠𐴥. 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴇𐴡𐴕𐴡𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠.“<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴇𐴠𐴥 𐴀𐴝𐴁𐴝𐴏𐴢 𐴏𐴗𐴝𐴥 𐴀𐴝𐴣𐴀𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥.</char> <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" /><char style="wj">𐴘𐴝𐴓𐴝 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴘𐴝𐴓𐴝 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴡𐴌𐴠 𐴕𐴠𐴦𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" /><char style="wj">𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴧𐴟 𐴖𐴡𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴉𐴠𐴓𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴄𐴝𐴕𐴞 𐴃𐴟𐴓𐴞𐴤𐴉𐴠𐴓𐴝𐴘𐴧𐴟𐴔.“</char> <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴐𐴝𐴥𐴌𐴝 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕 𐴔𐴡𐴦𐴃𐴠 𐴔𐴡𐴌𐴞𐴁𐴡𐴥.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴧𐴟 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴊𐴠, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴀𐴛 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">’𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴖𐴡𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴉𐴠𐴓𐴝 𐴎𐴝𐴘𐴁𐴡؟‘</char> 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕؟“<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴟𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴡𐴑𐴃𐴡𐴥 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴁𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴟𐴌 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴀𐴝𐴥𐴣𐴍𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴝𐴥𐴌𐴝𐴘𐴎𐴝𐴘𐴁𐴡𐴘. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴀𐴝𐴥𐴣𐴍𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴇𐴡𐴙𐴑𐴧𐴝𐴤 𐴎𐴝𐴦𐴌 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴟𐴌 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴕𐴟𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴟𐴌𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴁𐴡𐴕𐴞𐴎𐴡𐴒𐴡𐴥𐴘.“</char></para>
  <para style="s1" vid="JHN 12:36">𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴕𐴝𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢</para>
  <para style="p" vid="JHN 12:36">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 12:36" /><verse number="37" style="v" sid="JHN 12:37" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴊𐴟𐴥𐴕 𐴁𐴞𐴐𐴞𐴤 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴒𐴡𐴌𐴞𐴥𐴓𐴠 𐴘𐴡, 𐴃𐴡𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟𐴥 𐴀𐴝𐴕𐴠𐴤. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴘𐴠𐴏𐴝𐴥𐴘𐴝 𐴕𐴡𐴁𐴞𐴘𐴠 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴈𐴡𐴃𐴝𐴤 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥,</para>
  <para style="q1" vid="JHN 12:38">”𐴀𐴡𐴥 𐴔𐴝𐴁𐴟𐴊𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴂𐴡𐴘𐴒𐴝𐴔 𐴇𐴡𐴕𐴠 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥؟</para>
  <para style="q2" vid="JHN 12:38">𐴀𐴝𐴦𐴌 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴋𐴟𐴖𐴝𐴥𐴣𐴌 𐴁𐴡𐴓𐴢 𐴇𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠؟“<note caller="+" style="f"><char style="fr" closed="false">12‏:38 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:1">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 53‏:1</ref></char></char></note><verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴁𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴠𐴥 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥,<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />”𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑 𐴀𐴝𐴣𐴊𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠,</para>
  <para style="q2" vid="JHN 12:40">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴊𐴡𐴌𐴡𐴤 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠,</para>
  <para style="q1" vid="JHN 12:40">𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴟𐴑𐴠𐴤 𐴕𐴡 𐴊𐴠𐴑𐴠𐴥,</para>
  <para style="q2" vid="JHN 12:40">𐴊𐴞𐴓𐴠 𐴕𐴡 𐴁𐴟𐴎𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴞𐴥𐴌𐴞 𐴕𐴟 𐴀𐴝𐴘𐴧𐴠𐴤.“<note caller="+" style="f"><char style="fr" closed="false">12‏:40 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 6:10">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 6‏:10</ref></char></char></note><verse eid="JHN 12:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41" />𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴘𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴁𐴝𐴥𐴐𐴧𐴡𐴃𐴢 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />𐴃𐴡𐴀 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴐𐴡𐴥𐴀 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴝𐴘𐴊𐴞𐴁𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴋𐴡𐴦𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴐𐴞𐴥𐴑𐴝𐴌 𐴕𐴡 𐴒𐴡𐴙𐴃𐴧𐴡𐴥; <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴉𐴝𐴦𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴉𐴝𐴦 𐴁𐴞𐴐𐴞𐴤 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.<verse eid="JHN 12:43" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤𐴘𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴟𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴘𐴡𐴥 𐴀𐴝𐴕𐴠𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠.</char> <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴠𐴑𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴠 𐴊𐴠𐴑𐴠𐴥.</char> <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴕𐴟𐴌 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠.</char><verse eid="JHN 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47" />
    <char style="wj">”𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴠 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠.</char> <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌 𐴀𐴝𐴏𐴠𐴤. 𐴎𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴀𐴛 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴇𐴞𐴥𐴀𐴕𐴠 𐴁𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char> <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴁𐴝𐴉𐴢 𐴕𐴞𐴎𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴞𐴦-𐴑𐴞𐴦 𐴈𐴡𐴖𐴝𐴤 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴀𐴝𐴦𐴌 𐴑𐴞𐴦-𐴑𐴞𐴦 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" /><char style="wj">𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴓𐴡𐴘𐴎𐴝; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴎𐴞𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴠 𐴈𐴡𐴀𐴘𐴢.“</char><verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴄𐴠𐴥𐴚 𐴊𐴟𐴥𐴖𐴝𐴘𐴊𐴞𐴘𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴒𐴡𐴌𐴞 𐴀𐴝𐴒𐴡𐴌 𐴈𐴡𐴃𐴝𐴤. 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴧𐴟 𐴁𐴝𐴉𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴁𐴞𐴘𐴝𐴓𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴞𐴏𐴑𐴝𐴥𐴌𐴞𐴘𐴠𐴃𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴕𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴠. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴊𐴠, 𐴁𐴝𐴉𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴁𐴠 𐴉𐴞𐴥𐴌𐴞 𐴎𐴝𐴦𐴌; <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴝𐴥𐴕𐴝 𐴀𐴠𐴌𐴞 𐴀𐴟𐴙𐴄𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴦𐴌 𐴖𐴡𐴌𐴡𐴌 𐴇𐴡𐴦𐴌 𐴑𐴟𐴥𐴓𐴞 𐴀𐴠𐴔𐴧𐴞𐴑𐴧𐴝𐴤 𐴀𐴠𐴙𐴅𐴧𐴠𐴥, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴝𐴕𐴏𐴝𐴥 𐴓𐴡𐴦𐴘𐴢 𐴑𐴠𐴣𐴙𐴓𐴡𐴃𐴢 𐴁𐴝𐴙𐴕𐴊𐴠𐴤. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴝𐴀𐴓𐴝𐴃𐴢 𐴉𐴝𐴕𐴞𐴥 𐴋𐴝𐴥𐴓𐴞 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴄𐴠𐴥𐴚 𐴊𐴟𐴥𐴖𐴝𐴘 𐴊𐴞𐴥𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴑𐴠𐴣𐴙𐴓𐴡𐴃𐴢 𐴁𐴝𐴙𐴕𐴊𐴞𐴥𐴓𐴢 𐴊𐴠 𐴒𐴝𐴕𐴏𐴝𐴥 𐴒𐴝𐴥𐴕 𐴓𐴡𐴥𐴘 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴣𐴏𐴞𐴥 𐴊𐴞𐴥𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="JHN 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠. 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴄𐴠𐴥𐴚 𐴊𐴟𐴥𐴖𐴝𐴘 𐴊𐴞𐴥𐴁𐴝 𐴊𐴠𐴥؟“<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴑𐴞𐴦 𐴒𐴡𐴌𐴞𐴥𐴌 𐴃𐴟𐴘 𐴀𐴠𐴇𐴡𐴥𐴕 𐴕𐴡 𐴁𐴟𐴎𐴞𐴥𐴁𐴞, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴡𐴌𐴠 𐴁𐴟𐴎𐴞𐴥𐴁𐴞.“</char><verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴀𐴝𐴣𐴀𐴌 𐴄𐴠𐴥𐴚 𐴕𐴡 𐴊𐴟𐴥𐴘𐴧𐴡.“</para>
  <para style="p" vid="JHN 13:8">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴎𐴡𐴊𐴞 𐴃𐴡𐴌 𐴄𐴠𐴥𐴚 𐴕𐴡 𐴊𐴟𐴥𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡𐴌 𐴓𐴧𐴡𐴘 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴇𐴡𐴕𐴡𐴤 𐴇𐴝𐴥𐴃𐴞𐴓𐴢 𐴕𐴝𐴥𐴘.“</char><verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴣𐴀𐴌 𐴄𐴠𐴥𐴚 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴧𐴟𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴃𐴝𐴥 𐴘𐴡𐴥 𐴊𐴟𐴥𐴖𐴝𐴘𐴊𐴡.“<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴝𐴦 𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴄𐴠𐴥𐴚 𐴊𐴟𐴥𐴖𐴝 𐴉𐴡𐴌𐴠 𐴊𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴏𐴝𐴥𐴉𐴏𐴟𐴃𐴝𐴌𐴝. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴝𐴥𐴉𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴕𐴡.“</char> <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴝𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴡𐴕𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡 𐴊𐴠; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴏𐴝𐴥𐴉𐴢 𐴕𐴡.“</char><verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />𐴃𐴡𐴥𐴘 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴄𐴠𐴥𐴚 𐴊𐴟𐴥𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴦𐴌 𐴉𐴞𐴣𐴊𐴞𐴥 𐴀𐴝𐴁𐴝𐴌 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴞𐴦 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴁𐴟𐴙𐴅𐴧𐴡𐴥 𐴕𐴠𐴥؟</char> <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴋𐴝𐴑𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴘.</char> <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" /><char style="wj">𐴃𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴠𐴊𐴧𐴠 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴄𐴠𐴥𐴚 𐴊𐴟𐴥𐴖𐴝𐴘 𐴊𐴞𐴥𐴘𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴄𐴠𐴥𐴚 𐴊𐴟𐴥𐴖𐴝𐴘 𐴊𐴞𐴥𐴘𐴝𐴌 𐴎𐴡𐴌𐴟𐴌.</char> <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" /><char style="wj">𐴀𐴝𐴀𐴛 𐴒𐴡𐴌𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴔𐴟𐴕𐴝 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴞 𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴒𐴟𐴓𐴝𐴔 𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴀𐴞𐴥𐴁𐴝 𐴘𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴡𐴥𐴘𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴕𐴡.</char> <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" /><char style="wj">𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴞𐴀𐴕 𐴎𐴝𐴕𐴡, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴡𐴤 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴟𐴁𐴝𐴌𐴠𐴑.</char><verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴕𐴡; 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴞. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴌 𐴎𐴠𐴀𐴕𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥, ’𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴌𐴟𐴄𐴞 𐴈𐴝𐴥𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴓𐴋𐴝 𐴓𐴝𐴃𐴞𐴥 𐴃𐴟𐴙𐴓𐴧𐴠𐴥.‘ </char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13‏:18 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 41:9">𐴎𐴡𐴁𐴟𐴌 41‏:9</ref>
        </char>
      </char>
    </note><verse eid="JHN 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 13:19" />
    <char style="wj">”𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴀𐴝𐴀𐴛 𐴘𐴝𐴓𐴝 𐴓𐴡𐴥𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝.</char> <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴀𐴛 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠.“</char><verse eid="JHN 13:20" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴡𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 26:20-25">𐴔𐴡𐴃𐴢 26‏:20‏-25</ref>; <ref loc="MRK 14:17-21">𐴔𐴝𐴑 14‏:17‏-21</ref>; <ref loc="LUK 22:21-23">𐴓𐴟𐴑 22‏:21‏-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴘𐴧𐴝𐴤 𐴀𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴊𐴞𐴓𐴡𐴃𐴢 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴓𐴝𐴙𐴒𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠 𐴊𐴠 𐴑𐴞, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞 𐴊𐴞𐴁𐴝.“</char><verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴁𐴟𐴎𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴏𐴝𐴀𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴎𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴝𐴦𐴃𐴢 𐴀𐴠𐴥𐴓𐴝𐴕 𐴊𐴞𐴥 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴠 𐴇𐴠𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝𐴌𐴠 𐴀𐴞𐴐𐴝𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴡𐴤.“<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />𐴃𐴡𐴥𐴘 𐴇𐴠𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴝𐴦𐴃𐴢 𐴀𐴠𐴥𐴓𐴝𐴕 𐴊𐴞𐴥 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴡𐴕؟“<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴌𐴟𐴄𐴞𐴌 𐴄𐴟𐴑𐴟𐴍𐴝 𐴘𐴝𐴀𐴕 𐴁𐴟𐴌𐴝𐴘 𐴀𐴝𐴀𐴛 𐴎𐴝𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴟𐴔, 𐴃𐴠𐴦 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴠.“</char> 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴌𐴟𐴄𐴞𐴌 𐴄𐴟𐴑𐴟𐴍𐴝 𐴒𐴝𐴥𐴕 𐴁𐴟𐴌𐴝𐴘 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴀𐴞𐴏𐴑𐴝𐴥𐴌𐴞𐴘𐴠𐴃𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />𐴌𐴟𐴄𐴞𐴌 𐴄𐴟𐴑𐴟𐴍𐴝 𐴒𐴝𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴁𐴝𐴦𐴊𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘.</para>
  <para style="p" vid="JHN 13:27">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴘 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴞 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴒𐴡𐴌.“</char> <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡𐴥 𐴁𐴟𐴎𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴄𐴝𐴥𐴀𐴙𐴅𐴧𐴞𐴓𐴢 𐴊𐴠, 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴃𐴧𐴟 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴄𐴞𐴛𐴝𐴌 𐴉𐴠𐴄𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴀𐴞𐴊𐴡𐴓𐴧𐴝 𐴎𐴞𐴀𐴕 𐴎𐴡𐴌𐴟𐴌 𐴇𐴞𐴥𐴀𐴕 𐴑𐴞𐴕𐴞 𐴀𐴝𐴕𐴒𐴡𐴥𐴘,“ 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴊𐴠𐴦𐴒𐴡𐴥𐴘. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />𐴀𐴞𐴥𐴃𐴠 𐴌𐴟𐴄𐴞𐴌 𐴄𐴟𐴑𐴟𐴍𐴝 𐴒𐴝𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴕𐴠𐴦𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘. 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴌𐴝𐴙𐴃𐴢.<verse eid="JHN 13:30" /></para>
  <para style="s1">𐴕𐴡𐴘𐴝 𐴇𐴡𐴥𐴑𐴟𐴔</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />𐴀𐴞𐴥𐴃𐴠 𐴁𐴝𐴀𐴌𐴠 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴝𐴓𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴁𐴞𐴐𐴞𐴤 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char><verse eid="JHN 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33" />
    <char style="wj">”𐴀𐴡𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴡𐴑𐴃𐴡𐴥 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴏𐴞𐴤 𐴊𐴠. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴓𐴝𐴔, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴈𐴡𐴀𐴙𐴌, ’𐴀𐴝𐴀𐴛 𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.‘</char><verse eid="JHN 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴘𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴌, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤. 𐴀𐴝𐴀𐴛 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" /><char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴎𐴝𐴕𐴞𐴁𐴡𐴥 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢.“</char><verse eid="JHN 13:35" /></para>
  <para style="s1">𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 26:31-35">𐴔𐴡𐴃𐴢 26‏:31‏-35</ref>; <ref loc="MRK 14:27-31">𐴔𐴝𐴑 14‏:27‏-31</ref>; <ref loc="LUK 22:31-34">𐴓𐴟𐴑 22‏:31‏-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴇𐴡𐴍𐴠𐴥 𐴎𐴡𐴀𐴌𐴒𐴡𐴘 𐴊𐴠𐴥؟“</para>
  <para style="p" vid="JHN 13:36">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘, 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴞𐴥, 𐴓𐴠𐴑𐴞𐴕 𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴘𐴢 𐴉𐴝𐴌𐴞𐴁𐴞𐴥.“</char><verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴘𐴝𐴓𐴝 𐴑𐴞𐴘𐴝𐴥 𐴀𐴝𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴙𐴃𐴧𐴝𐴔؟ 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴟𐴔.“<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴃𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴞 𐴊𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴁𐴝𐴑 𐴊𐴞𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴞𐴕 𐴁𐴝𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴞.</char><verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴌𐴝𐴏𐴃𐴝, 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴕𐴟 𐴀𐴝𐴙𐴕𐴧𐴡𐴤. 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴑𐴡𐴥, 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴘𐴡𐴥 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴑𐴡𐴥.</char> <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴝𐴌 𐴎𐴝𐴒𐴝 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴡𐴊𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴢 𐴊𐴞𐴥𐴃𐴝𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴎𐴝𐴒𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴎𐴝𐴙𐴌.</char> <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" /><char style="wj">𐴀𐴝𐴀𐴛 𐴎𐴝𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴎𐴝𐴒𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘𐴧𐴟𐴥𐴔𐴁𐴡𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴎𐴠𐴍𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥𐴍𐴠 𐴀𐴡𐴥.</char> <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴇𐴡𐴍𐴠𐴥 𐴎𐴝𐴙𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴌𐴝𐴏𐴃𐴝 𐴎𐴝𐴕𐴡.“</char><verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />𐴃𐴡𐴥𐴔𐴝𐴏𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴞 𐴃𐴟𐴀𐴛 𐴇𐴡𐴍𐴠𐴥 𐴎𐴡𐴀𐴌, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴌𐴝𐴏𐴃𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴎𐴝𐴕𐴞𐴘𐴟𐴥𐴔؟“<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴌𐴝𐴏𐴃𐴝, 𐴏𐴡𐴥𐴘𐴧𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞; 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴕𐴡 𐴎𐴝𐴘𐴓𐴠𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴝𐴉𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.</char><verse eid="JHN 14:6" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴉𐴡𐴌𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 14:7" />
    <char style="wj">”𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴞𐴕𐴧𐴡𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴘𐴡𐴥 𐴏𐴞𐴕𐴧𐴡𐴥. 𐴘𐴝𐴓𐴝 𐴓𐴡𐴥𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴊𐴠𐴑𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴡.“</char><verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />𐴉𐴞𐴓𐴞𐴥𐴂𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴁𐴝𐴉𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴝𐴈𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴑𐴝𐴉𐴞𐴥.“<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴞𐴓𐴞𐴥𐴂𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴀𐴝𐴏𐴞𐴤, 𐴃𐴡𐴀 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴕𐴡 𐴏𐴞𐴕𐴡𐴥𐴏𐴢 𐴊𐴠𐴥؟ 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴁𐴝𐴉𐴡𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥. 𐴃𐴟𐴘 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴁𐴝𐴉𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴝𐴈𐴡𐴥؟‘</char> <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" /><char style="wj">𐴃𐴟𐴘 𐴑𐴞 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤𐴏𐴢, 𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴞𐴤 𐴀𐴝𐴦𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠𐴥؟ 𐴈𐴡𐴃𐴝𐴤 𐴎𐴞𐴀𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴢, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴈𐴡𐴀𐴘𐴢 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴝𐴉𐴢 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠.</char> <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" /><char style="wj">𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴞𐴤 𐴀𐴝𐴦𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴈𐴝𐴔 𐴔𐴟𐴥𐴕𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤.</char><verse eid="JHN 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 14:12" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴑𐴠𐴥, 𐴎𐴠 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴀𐴛 𐴒𐴡𐴌𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴡; 𐴀𐴞𐴥𐴃𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴁𐴝𐴉𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘.</char> <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" /><char style="wj">𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴎𐴞𐴀𐴕 𐴏𐴝𐴘𐴁𐴝𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴀𐴛 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴁𐴝𐴉𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴉𐴟𐴖𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥.</char> <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔.</char><verse eid="JHN 14:14" /></para>
  <para style="s1">𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴊𐴞𐴦𐴁𐴝𐴌 𐴖𐴝𐴦𐴊𐴝</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />
    <char style="wj">”𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.</char> <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" /><char style="wj">𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴔𐴝𐴒𐴞𐴘𐴟𐴥𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴡𐴊𐴡𐴃𐴒𐴝𐴥𐴌 𐴊𐴞𐴦𐴁𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴃𐴝𐴥𐴑𐴠.</char> <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" /><char style="wj">𐴇𐴠𐴥 𐴔𐴡𐴊𐴡𐴃𐴒𐴝𐴥𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴌𐴟𐴀; 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴘𐴡 𐴊𐴠𐴑𐴠𐴥 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴘𐴡 𐴎𐴝𐴕𐴠. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴝𐴕𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.</char><verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴃𐴞𐴔 𐴌𐴝𐴑𐴞𐴥 𐴕𐴡 𐴎𐴝𐴘𐴧𐴟𐴔; 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔.</char> <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" /><char style="wj">𐴇𐴡𐴃𐴟𐴥𐴕 𐴀𐴝𐴥𐴕𐴞𐴑 𐴁𐴝𐴦𐴊𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴌 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴞𐴤 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴞𐴁𐴝.</char> <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" /><char style="wj">𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴝𐴘𐴓𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞𐴁𐴝𐴥 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴞𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴞𐴤.</char> <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡; 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔.“</char><verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴑𐴝𐴥𐴌𐴞𐴘𐴠𐴃𐴢 𐴕𐴡 𐴊𐴠 𐴇𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴃𐴟𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴊𐴠𐴥؟“<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴑𐴞𐴘𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤𐴘𐴠 𐴏𐴡𐴓𐴞𐴁𐴡𐴥. 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔.</char> <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤𐴘𐴠 𐴕𐴡 𐴏𐴡𐴓𐴠. 𐴎𐴠 𐴈𐴡𐴃𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴟𐴥𐴕𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴁𐴝𐴉𐴡𐴌.</char><verse eid="JHN 14:24" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴞𐴦𐴘𐴝 𐴐𐴝𐴥𐴕𐴃𐴞</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />
    <char style="wj">”𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴞𐴀𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴈𐴡𐴘𐴧𐴞𐴥.</char> <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴔𐴡𐴊𐴡𐴃𐴒𐴝𐴥𐴌 𐴘𐴝𐴥𐴕𐴞 𐴂𐴝𐴑-𐴌𐴟𐴀, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴁𐴡, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴐𐴞𐴥𐴑𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴎𐴞𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴞𐴁𐴡.</char> <verse eid="JHN 14:26" /><verse number="27" style="v" sid="JHN 14:27" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴐𐴝𐴥𐴕𐴃𐴞 𐴌𐴝𐴑𐴞𐴥 𐴎𐴝𐴙𐴌; 𐴀𐴝𐴣𐴀𐴌 𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴌. 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴊𐴠𐴦 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴊𐴞𐴦. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴕𐴟 𐴀𐴝𐴙𐴕𐴧𐴡𐴤, 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥.</char><verse eid="JHN 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 14:28" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴃𐴡 𐴉𐴟𐴥𐴙𐴕𐴧𐴡, ’𐴀𐴝𐴀𐴛 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔.‘ 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴃𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴢 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌.</char> <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" /><char style="wj">𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴊𐴞𐴘𐴞, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴀𐴝𐴌 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴈𐴡𐴘𐴧𐴟𐴥𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴃𐴡 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴌𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴕𐴝𐴥𐴘.</char> <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴎𐴝𐴕𐴠 𐴉𐴝𐴥𐴕, 𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴠 𐴒𐴡𐴌𐴞𐴥.</char></para>
  <para style="p" vid="JHN 14:31">
    <char style="wj">”𐴀𐴟𐴍𐴡𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴝𐴀𐴕𐴃𐴧𐴟 𐴎𐴝𐴘𐴒𐴡𐴥𐴘.</char><verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴚𐴒𐴟𐴌-𐴒𐴝𐴏𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴚𐴒𐴟𐴌-𐴒𐴝𐴏𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴐𐴝𐴐𐴝𐴤.</char> <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴎𐴠 𐴋𐴠𐴥𐴀𐴘𐴓𐴝𐴃𐴢 𐴒𐴟𐴓𐴝 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠, 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠 𐴋𐴠𐴥𐴀𐴘𐴓𐴝𐴃𐴢 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴠, 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴐𐴝𐴥𐴍𐴞 𐴏𐴝𐴥𐴉𐴢 𐴌𐴝𐴑𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴘𐴞𐴥𐴁𐴝𐴃𐴢 𐴀𐴝𐴌𐴡𐴤 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴠.</char> <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡𐴘𐴧𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘.</char> <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴙𐴒𐴧𐴝 𐴃𐴝𐴥𐴑𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴙𐴒𐴧𐴝 𐴃𐴝𐴥𐴙𐴑𐴧𐴟𐴔. 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴀𐴝𐴚𐴒𐴟𐴌-𐴒𐴝𐴏𐴡𐴃𐴢 𐴓𐴝𐴙𐴒𐴧𐴝 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴙𐴒𐴧𐴝 𐴕𐴡 𐴃𐴝𐴥𐴑𐴡.</char><verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴚𐴒𐴟𐴌-𐴒𐴝𐴏𐴢, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴙𐴒𐴧𐴝 𐴃𐴝𐴥𐴑𐴠 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴙𐴒𐴧𐴝 𐴃𐴝𐴥𐴑𐴞, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴞𐴐𐴞𐴤 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴝𐴘 𐴉𐴝𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴏𐴝𐴥𐴌𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.</char> <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴙𐴒𐴧𐴝 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴋𐴠𐴥𐴀𐴘𐴓𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴝𐴀𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴥𐴖𐴝𐴘𐴎𐴝𐴒𐴡𐴘; 𐴃𐴡𐴥𐴘 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴊𐴡𐴓𐴝𐴒𐴡𐴌𐴞𐴥 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘 𐴊𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴌𐴞𐴎𐴝𐴒𐴡𐴥𐴘</char> <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" /><char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴙𐴒𐴧𐴝 𐴃𐴝𐴥𐴑𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴙𐴒𐴧𐴝 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴝𐴒𐴞𐴘𐴡𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴝𐴘 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴊𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴓𐴠, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥.</char><verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />
    <char style="wj">”𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥. 𐴀𐴝𐴣𐴀𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴝𐴙𐴒𐴧𐴝 𐴃𐴝𐴥𐴑𐴡.</char> <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" /><char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴝, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴞.</char> <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" /><char style="wj">𐴈𐴡𐴃𐴝𐴤 𐴀𐴞𐴀𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴑𐴟𐴥𐴐𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴟𐴥𐴐𐴞 𐴎𐴠𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.</char> <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴝𐴀𐴕, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" /><char style="wj">𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴉𐴠𐴥𐴓𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴃𐴡 𐴀𐴝𐴌 𐴋𐴡𐴣𐴀𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴝𐴥𐴘.</char> <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴞𐴀𐴕 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴞 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴟𐴓𐴝𐴔 𐴁𐴡𐴓𐴞 𐴀𐴝𐴌 𐴕𐴡 𐴈𐴡𐴀𐴙𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴟𐴓𐴝𐴔𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴑𐴞𐴦 𐴒𐴡𐴌𐴠𐴥𐴌 𐴕𐴡 𐴎𐴝𐴕𐴠. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴟𐴏𐴃𐴡𐴥 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴞𐴥.</char> <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴡 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠𐴥𐴕𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴔𐴡𐴃𐴢 𐴓𐴝𐴒𐴝𐴘𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝 𐴊𐴡𐴥𐴌𐴠 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴎𐴞𐴀𐴕 𐴔𐴝𐴒𐴞𐴁𐴝𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴠𐴦.</char> <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴌 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤.</char><verse eid="JHN 15:17" /></para>
  <para style="s1">𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴌 𐴊𐴟𐴐𐴧𐴡𐴕</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />
    <char style="wj">”𐴎𐴡𐴊𐴞 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴙𐴑𐴧𐴡𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" /><char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴡𐴥𐴘𐴃𐴝, 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴡 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴧𐴟 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴞, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴈𐴡𐴃𐴝𐴤 𐴒𐴝𐴥𐴕 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴙𐴑𐴧𐴡𐴥 𐴊𐴠 𐴑𐴞, ’𐴒𐴟𐴓𐴝𐴔 𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴕𐴡.‘</char><note caller="+" style="f"><char style="fr" closed="false">15‏:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="JHN 13:16">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 13‏:16</ref></char></char></note> <char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴡; 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴘𐴡𐴥 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char> <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴁𐴠 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥.</char> <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" /><char style="wj">𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴕𐴟 𐴀𐴝𐴘𐴃𐴝𐴤𐴔 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴡 𐴈𐴡𐴘𐴃𐴝𐴥𐴔, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴕𐴡 𐴄𐴡𐴥𐴀𐴌𐴞𐴃𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴁𐴝𐴇𐴝𐴤𐴕𐴝 𐴕𐴝𐴥𐴘.</char> <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" /><char style="wj">𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴘𐴡𐴥 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" /><char style="wj">𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴈𐴝𐴔 𐴀𐴟𐴀𐴙𐴕 𐴕𐴡 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔 𐴎𐴞𐴀𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴕𐴡 𐴄𐴡𐴥𐴀𐴌𐴞𐴃𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴀𐴝𐴦𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴡𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴈𐴡𐴃𐴝𐴤 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥, ’𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴝𐴥𐴕𐴧𐴝𐴑 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.‘</char><note caller="+" style="f"><char style="fr" closed="false">15‏:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 35:19">𐴎𐴡𐴁𐴟𐴌 35‏:19</ref>; <ref loc="PSA 69:4">69‏:4</ref></char></char></note><verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />
    <char style="wj">”𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴡𐴊𐴡𐴃𐴒𐴝𐴥𐴌 𐴀𐴟𐴁𐴝𐴤 𐴀𐴝𐴘𐴁𐴡𐴤 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴟𐴔, 𐴘𐴝𐴥𐴕𐴞 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴌𐴟𐴀 𐴎𐴞𐴁𐴝𐴤 𐴁𐴝𐴉𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴘𐴧𐴠𐴤 𐴀𐴞𐴥𐴁𐴝 𐴌𐴠, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴁𐴡.</char> <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" /><char style="wj">𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴁𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴏𐴡𐴤.</char><verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴞𐴀𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴡 𐴎𐴡𐴦𐴒𐴡𐴥𐴘.</char> <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" /><char style="wj">𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴝𐴘𐴊𐴞𐴁𐴡; 𐴀𐴡𐴥𐴘, 𐴀𐴠𐴀𐴕 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴠 𐴀𐴞𐴥𐴃𐴠 𐴄𐴝𐴥𐴀𐴌𐴞𐴁𐴡 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴁𐴡𐴥𐴓𐴞.</char> <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡 𐴁𐴝𐴉𐴡𐴌𐴠 𐴏𐴞𐴕𐴧𐴠𐴥 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴞𐴕𐴧𐴠𐴥.</char> <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴓𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴍𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴀𐴘𐴢 𐴌𐴝𐴥𐴙𐴑𐴧𐴞. 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴓𐴡𐴥𐴃𐴞 𐴇𐴞𐴥𐴀𐴕 𐴕𐴡𐴥 𐴈𐴡𐴀𐴘𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔.</char><verse eid="JHN 16:4" /></para>
  <para style="s1">𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴈𐴝𐴔</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴛 𐴀𐴟𐴁𐴝𐴤𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤𐴌 𐴊𐴠, ’𐴃𐴟𐴀𐴛 𐴇𐴡𐴍𐴠𐴥 𐴎𐴡𐴀𐴌𐴒𐴡𐴘 𐴊𐴠𐴥؟‘</char> <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴞𐴀𐴕 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴘𐴠 𐴁𐴡𐴥𐴌𐴞𐴒𐴞𐴘𐴡𐴘.</char> <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴝𐴥𐴘𐴊𐴝𐴓𐴧𐴝 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘 𐴊𐴠; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴘𐴒𐴡𐴥𐴘, 𐴇𐴠𐴥 𐴔𐴡𐴊𐴡𐴃𐴒𐴝𐴥𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴟 𐴀𐴝𐴘𐴁𐴡𐴤; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴎𐴝𐴘𐴓𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴟𐴔.</char> <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌, 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴏𐴝𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴝𐴘𐴁𐴡.</char> <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" /><char style="wj">𐴒𐴟𐴕𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴄𐴡𐴥𐴀𐴌𐴝𐴘𐴁𐴡 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟𐴥 𐴀𐴝𐴕𐴠𐴤;</char> <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" /><char style="wj">𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴄𐴡𐴥𐴀𐴌𐴝𐴘𐴁𐴡 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴌 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴁𐴝;</char> <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" /><char style="wj">𐴁𐴞𐴏𐴝𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴄𐴡𐴥𐴀𐴌𐴝𐴘𐴁𐴡 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.</char><verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />
    <char style="wj">”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.</char> <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴟𐴁𐴝𐴤, 𐴘𐴝𐴥𐴕𐴞 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴌𐴟𐴀 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴟𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴌𐴝𐴏𐴃𐴝 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴞𐴀𐴕 𐴉𐴟𐴥𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠 𐴈𐴡𐴘𐴁𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴁𐴡.</char> <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" /><char style="wj">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴁𐴡; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char> <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" /><char style="wj">𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴁𐴡.“ </char><verse eid="JHN 16:15" /></para>
  <para style="s1">𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞 𐴑𐴟𐴥𐴐𐴞𐴃𐴢 𐴁𐴡𐴊𐴡𐴓𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />
    <char style="wj">”𐴇𐴡𐴃𐴟𐴥𐴕 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴌 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴁𐴝𐴌 𐴇𐴡𐴃𐴟𐴥𐴕 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴠𐴑𐴞𐴥𐴁𐴝.“</char><verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴠 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌, <char style="wj">’𐴇𐴡𐴃𐴟𐴥𐴕 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴌 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴁𐴝𐴌 𐴇𐴡𐴃𐴟𐴥𐴕 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴠𐴑𐴞𐴥𐴁𐴝‘</char>؟ 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">’𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘</char>؟‘“ <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 <char style="wj">’𐴇𐴡𐴃𐴟𐴥𐴕 𐴀𐴡𐴌‘</char> 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴦؟ 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴞 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴑𐴞𐴘𐴡𐴥𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌.“<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴘𐴝𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴖𐴝𐴤𐴇𐴡𐴘 𐴒𐴡𐴌𐴡𐴤𐴌 𐴊𐴠 𐴕𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴀𐴛 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠, ’𐴇𐴡𐴃𐴟𐴥𐴕 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴌 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴁𐴝𐴌 𐴇𐴡𐴃𐴟𐴥𐴕 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴠𐴑𐴞𐴥𐴁𐴝؟‘</char> <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴝𐴣𐴊𐴞𐴁𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴓𐴝𐴑 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴀𐴡𐴥𐴘𐴁𐴝, 𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞 𐴑𐴟𐴥𐴐𐴞𐴃𐴢 𐴁𐴡𐴊𐴡𐴓𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘.</char> <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴉𐴟𐴖𐴝 𐴎𐴡𐴌𐴔𐴡 𐴊𐴠 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴡 𐴊𐴟𐴑 𐴉𐴝𐴦, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴑 𐴉𐴝𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴟𐴖𐴝 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴟𐴖𐴝 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴇𐴠𐴥 𐴊𐴟𐴑𐴡𐴌𐴠 𐴀𐴝𐴌 𐴔𐴡𐴕𐴡𐴃𐴢 𐴕𐴡 𐴌𐴝𐴑𐴠𐴥.</char> <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴘𐴝𐴓𐴝 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢 𐴀𐴝𐴏𐴡𐴤; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴀𐴝𐴁𐴝𐴌 𐴔𐴞𐴓𐴞𐴘𐴟𐴥𐴔, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴟𐴥𐴐𐴞𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴓𐴡𐴦𐴘𐴢 𐴕𐴡 𐴉𐴠𐴓𐴝𐴘𐴁𐴡.</char> <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" /><char style="wj">𐴇𐴠𐴥 𐴊𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴊𐴠 𐴕𐴝𐴥𐴘. 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴒𐴡, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴁𐴡.</char> <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" /><char style="wj">𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴙𐴒𐴧𐴡𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘. 𐴔𐴝𐴒𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴝𐴘𐴁𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴟𐴥𐴐𐴞 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.</char><verse eid="JHN 16:24" /></para>
  <para style="s1">𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴙𐴐𐴧𐴞𐴤</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />
    <char style="wj">”𐴈𐴡𐴃𐴝𐴤 𐴀𐴞𐴀𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴁𐴠 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴠𐴀𐴕 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴀𐴝𐴌 𐴕𐴡 𐴈𐴡𐴘𐴧𐴟𐴥𐴔, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴝𐴉𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴧𐴟𐴥𐴔.</char> <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" /><char style="wj">𐴇𐴠𐴥 𐴊𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴔𐴝𐴒𐴞𐴁𐴝𐴥; 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴕𐴡 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔.</char> <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" /><char style="wj">𐴁𐴝𐴉𐴢 𐴕𐴞𐴎𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴀𐴝𐴦𐴌 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠.</char> <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" /><char style="wj">𐴀𐴝𐴀𐴛 𐴁𐴝𐴉𐴡𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴝𐴀𐴘𐴢 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴞𐴤; 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴀𐴛 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴀𐴠𐴌𐴞 𐴁𐴝𐴉𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘.“</char><verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴘𐴝𐴓𐴝 𐴃𐴟𐴀𐴛 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴀𐴌, 𐴇𐴡𐴕𐴡𐴤 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴕𐴡. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴞𐴥 𐴊𐴠, 𐴃𐴟𐴀𐴛 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 𐴕𐴝𐴥𐴘; 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴡𐴥 𐴊𐴠.“<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴓𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤 𐴕𐴠𐴥؟</char> <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" /><char style="wj">𐴏𐴡𐴀, 𐴀𐴠𐴀𐴕 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴊𐴡𐴌𐴁𐴡𐴊𐴡𐴌 𐴀𐴡𐴥𐴘 𐴎𐴝𐴌-𐴎𐴝𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴃𐴠𐴦-𐴃𐴠𐴦 𐴎𐴝𐴘𐴁𐴝𐴒𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴝𐴥𐴓𐴞𐴒𐴝 𐴀𐴠𐴌𐴞𐴁𐴝𐴥. 𐴃𐴡𐴀 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴓𐴞𐴒𐴝 𐴕𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴝𐴉𐴢 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤.</char><verse eid="JHN 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 16:33" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴞𐴀𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴉𐴡𐴦. 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴝; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴕𐴝 𐴇𐴝𐴥𐴌𐴝𐴘𐴧𐴡, 𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴙𐴐𐴧𐴞𐴤.“</char><verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴖𐴝 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴖𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴉𐴟𐴖𐴝𐴘𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴠𐴥,</char> <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴟𐴌𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕-𐴎𐴝𐴃𐴞𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴊𐴞𐴦𐴘𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴀𐴛 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴡𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴠𐴦.</char> <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴝𐴀𐴕, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴕 𐴃𐴟𐴀𐴛 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴀𐴛 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴡 𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴎𐴝𐴕𐴠.</char> <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" /><char style="wj">𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴠 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴊𐴞𐴦𐴘𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴌𐴝𐴘 𐴀𐴝𐴀𐴛 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥.</char> <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" /><char style="wj">𐴀𐴝𐴦𐴌 𐴘𐴝𐴓𐴝, 𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴃𐴟𐴀𐴛 𐴎𐴠𐴍𐴠𐴥 𐴀𐴝𐴏𐴡𐴤 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴖𐴝𐴓𐴝 𐴁𐴝𐴕𐴝𐴘𐴉𐴠𐴥𐴓𐴡, 𐴀𐴡 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴘𐴠 𐴎𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.</char><verse eid="JHN 17:5" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴖𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝</para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴃𐴟𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴡𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴡𐴥 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" /><char style="wj">𐴘𐴝𐴓𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴙𐴕𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴠𐴊𐴟𐴥𐴕 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴡𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟;</char> <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠 𐴈𐴡𐴃𐴝𐴤 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴘𐴃𐴡𐴤 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴝𐴑𐴧𐴝𐴉𐴝𐴑𐴧𐴞 𐴒𐴡𐴌𐴞 𐴎𐴝𐴙𐴕𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴀𐴛 𐴁𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴡.</char><verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴁𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥𐴌. 𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌.</char> <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" /><char style="wj">𐴎𐴞𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴣𐴀𐴌. 𐴀𐴝𐴣𐴀𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠.</char> <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" /><char style="wj">𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴙𐴌𐴒𐴡𐴘. 𐴀𐴡𐴥 𐴂𐴝𐴑 𐴁𐴝𐴉𐴢, 𐴎𐴠 𐴕𐴝𐴔 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴠𐴥 𐴕𐴝𐴔𐴠 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴑.</char> <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" /><char style="wj">𐴀𐴝𐴀𐴛 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴡 𐴕𐴝𐴔𐴠 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴙𐴑𐴧𐴞𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴡𐴥. 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴉𐴝𐴀𐴌𐴝 𐴊𐴞𐴥 𐴌𐴝𐴥𐴙𐴑𐴧𐴞, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴟𐴘𐴃𐴠 𐴁𐴠 𐴀𐴡𐴥𐴘𐴧𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥.</char><verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴘𐴝𐴓𐴝 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴙𐴌𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴀𐴞𐴀𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴑𐴟𐴥𐴐𐴞 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴒𐴡𐴌𐴞 𐴃𐴝𐴥𐴑𐴠.</char> <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴝𐴓𐴝𐴔 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴧𐴞, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴡, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴡.</char> <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴖𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴧𐴟 𐴓𐴡𐴘𐴎𐴡𐴒𐴡𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴖𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴃𐴧𐴟 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑𐴡𐴥.</char> <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" /><char style="wj">𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴡, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴡.</char> <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴓𐴡𐴥𐴘 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴡𐴤. 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴝𐴓𐴝𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞.</char> <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" /><char style="wj">𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴡, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴞.</char> <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴈𐴝𐴥𐴀𐴏𐴢 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴞𐴥𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴓𐴡𐴥𐴘 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴌𐴝𐴑𐴝𐴤 𐴎𐴝.</char><verse eid="JHN 17:19" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴖𐴝 𐴃𐴝𐴔𐴝𐴥𐴔 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴓𐴧𐴝</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴘𐴡𐴥 𐴒𐴡𐴌𐴞𐴥𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴁𐴡;</char> <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" /><char style="wj">𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴞𐴤, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴎𐴠𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴀𐴛 𐴁𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴡.</char> <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" /><char style="wj">𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴊𐴞𐴦𐴘𐴡𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴊𐴞𐴦𐴘𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴑.</char> <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴞𐴤 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴠𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴎𐴝𐴕𐴠 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴀𐴛 𐴁𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char><verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />
    <char style="wj">”𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴀𐴝𐴀𐴛 𐴏𐴝𐴥𐴘, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴡𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴎𐴠𐴕 𐴀𐴝𐴀𐴛 𐴎𐴠𐴍𐴠𐴥 𐴃𐴝𐴥𐴑𐴞 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴡𐴥 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴠𐴑𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char><verse eid="JHN 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 17:25" />
    <char style="wj">”𐴀𐴡𐴥 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴖𐴝𐴓𐴝 𐴁𐴝𐴉𐴢, 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴞𐴕𐴞𐴥; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴎𐴝𐴙𐴕𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴀𐴛 𐴁𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴡.</char> <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴌𐴡𐴤 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴇𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴞.“</char><verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌𐴞</para>
  <para style="r">(<ref loc="MAT 26:47-56">𐴔𐴡𐴃𐴢 26‏:47‏-56</ref>; <ref loc="MRK 14:43-52">𐴔𐴝𐴑 14‏:43‏-52</ref>; <ref loc="LUK 22:47-53">𐴓𐴟𐴑 22‏:47‏-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠, 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴓𐴡𐴦𐴘𐴢 𐴑𐴞𐴥𐴊𐴌𐴡𐴕 𐴎𐴟𐴥𐴌𐴝 𐴉𐴝𐴌𐴝𐴤𐴘 𐴀𐴡𐴑𐴟𐴓𐴠 𐴒𐴞𐴦𐴘𐴠𐴥. 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴝𐴒𐴝𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴘𐴠 𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴘𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕 𐴎𐴝𐴙𐴕𐴃𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴒𐴝𐴎𐴝𐴥-𐴀𐴠𐴒𐴝𐴎𐴝𐴥 𐴇𐴠𐴥𐴍𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴓𐴡𐴥𐴘 𐴔𐴞𐴓𐴞𐴃𐴡𐴥. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴌𐴡𐴔𐴞 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢 𐴉𐴝𐴥𐴕𐴡𐴐𐴢, 𐴀𐴟𐴎𐴝𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴥𐴃𐴞𐴘𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.<verse eid="JHN 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴎𐴝𐴕𐴠 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴝𐴌𐴠𐴤 𐴃𐴟𐴖𐴡𐴀𐴌 𐴊𐴠𐴥؟“</char><verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴏𐴝𐴥𐴌𐴞 𐴌𐴠.“</para>
  <para style="p" vid="JHN 18:5">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝.“</char> 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴠𐴌 𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴘𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴏𐴠𐴤. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴈𐴡𐴘𐴧𐴠𐴥, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝,“</char> 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴞𐴏𐴧𐴝𐴥 𐴎𐴝𐴘 𐴔𐴠𐴍𐴞𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="JHN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴁𐴝𐴌 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴝𐴌𐴠𐴤 𐴃𐴟𐴖𐴡𐴀𐴌 𐴊𐴠𐴥؟“</char></para>
  <para style="p" vid="JHN 18:7">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴏𐴝𐴥𐴌𐴞 𐴌𐴠.“<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴞. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴖𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴎𐴡𐴒𐴧𐴡𐴥𐴘.“</char> <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥, <char style="wj">”𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴡𐴥, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡𐴥 𐴀𐴝𐴥𐴣𐴎𐴝𐴘.“</char><note caller="+" style="f"><char style="fr" closed="false">18‏:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="JHN 6:39">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 6‏:39</ref></char></char></note><verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴠𐴦𐴓𐴝𐴘 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴒𐴟𐴓𐴝𐴔𐴡𐴌 𐴖𐴡𐴌𐴠 𐴏𐴡𐴓𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴌 𐴈𐴝𐴕 𐴕𐴝𐴥𐴕 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. 𐴇𐴠𐴥 𐴒𐴟𐴓𐴝𐴔𐴧𐴗𐴝𐴌 𐴕𐴝𐴔 𐴔𐴝𐴓𐴑𐴟𐴏𐴢.<verse eid="JHN 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴋𐴝𐴉𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴘 𐴀𐴠𐴌. 𐴎𐴠 𐴉𐴞𐴘𐴝𐴓𐴝 𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥 𐴉𐴞𐴘𐴝𐴓𐴝 𐴕𐴡 𐴉𐴞𐴀𐴃𐴝𐴔 𐴕𐴠𐴥؟“</char><verse eid="JHN 18:11" /></para>
  <para style="s1">𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴏𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 26:57-58">𐴔𐴡𐴃𐴢 26‏:57‏-58</ref>; <ref loc="MRK 14:53-54">𐴔𐴝𐴑 14‏:53‏-54</ref>; <ref loc="LUK 22:54">𐴓𐴟𐴑 22‏:54</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />𐴃𐴡𐴥𐴘 𐴇𐴠𐴥 𐴉𐴡𐴥𐴗𐴏𐴢 𐴏𐴟𐴕𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴡𐴕𐴧𐴝𐴓𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴒𐴟𐴥𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴣𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴒𐴠 𐴇𐴝𐴥𐴕𐴝𐴕𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠 𐴑𐴝𐴥𐴘𐴧𐴝𐴉𐴝𐴏𐴢 𐴇𐴠𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴈𐴡𐴥𐴗𐴀𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴝𐴥𐴕𐴝𐴕. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />𐴇𐴠𐴥 𐴑𐴝𐴥𐴘𐴧𐴝𐴉𐴝𐴏𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴡𐴐𐴖𐴝𐴌𐴝 𐴊𐴞𐴀𐴓𐴢 𐴊𐴠, 𐴁𐴠𐴀𐴃𐴡𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴟𐴌𐴝 𐴑𐴡𐴗𐴔𐴡𐴓𐴧𐴝 𐴀𐴠𐴑𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴔𐴡𐴌𐴡𐴕.<verse eid="JHN 18:14" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴀𐴞𐴕𐴑𐴝𐴌</para>
  <para style="r">(<ref loc="MAT 26:69-70">𐴔𐴡𐴃𐴢 26‏:69‏-70</ref>; <ref loc="MRK 14:66-68">𐴔𐴝𐴑 14‏:66‏-68</ref>; <ref loc="LUK 22:54-57">𐴓𐴟𐴑 22‏:54‏-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴑𐴟𐴌𐴠-𐴑𐴟𐴌𐴠 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴇𐴠𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝𐴌𐴠 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴠 𐴏𐴞𐴕𐴞𐴥𐴃𐴡 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴣𐴊𐴠-𐴉𐴟𐴣𐴊𐴠 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠𐴒𐴡𐴘, <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />𐴓𐴠𐴑𐴞𐴕 𐴉𐴞𐴃𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴊𐴟𐴖𐴝𐴌𐴡𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝𐴌𐴠 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴠 𐴏𐴞𐴕𐴞𐴥𐴃𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴞 𐴊𐴟𐴖𐴝𐴌 𐴏𐴡𐴦𐴛𐴊𐴝𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴘𐴢 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤.<verse eid="JHN 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17" />𐴊𐴟𐴖𐴝𐴌 𐴏𐴡𐴦𐴛𐴊𐴝𐴌 𐴁𐴝𐴣𐴊𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴘𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴘𐴡𐴥 𐴇𐴡𐴥𐴕𐴡 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴥؟“</para>
  <para style="p" vid="JHN 18:17">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴕𐴡.“<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴐𐴞𐴥𐴃𐴑𐴝𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴦𐴣𐴌𐴝 𐴓𐴡𐴘 𐴀𐴡𐴦𐴙𐴕 𐴊𐴡𐴥𐴌𐴝𐴘 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴡𐴦𐴙𐴕 𐴉𐴟𐴖𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴀𐴝𐴦𐴌 𐴉𐴞𐴃𐴡𐴌 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴡𐴦𐴙𐴕 𐴉𐴟𐴖𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="JHN 18:18" /></para>
  <para style="s1">𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴎𐴠𐴌𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 26:59-66">𐴔𐴡𐴃𐴢 26‏:59‏-66</ref>; <ref loc="MRK 14:55-64">𐴔𐴝𐴑 14‏:55‏-64</ref>; <ref loc="LUK 22:66-71">𐴓𐴟𐴑 22‏:66‏-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴠 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥𐴌.<verse eid="JHN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴞𐴥. 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴎𐴠𐴍𐴠𐴥 𐴃𐴝𐴔𐴝𐴥𐴔 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴓𐴟𐴑𐴝𐴘 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘.</char> <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" /><char style="wj">𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴞𐴘𐴝𐴥 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴡𐴤𐴌؟ 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴡𐴤𐴕𐴝 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴑𐴞𐴦 𐴈𐴡𐴘𐴧𐴞𐴥. 𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴝𐴀𐴛 𐴎𐴞𐴀𐴕 𐴈𐴡𐴘𐴧𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴕𐴠.“</char><verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴇𐴠𐴥𐴍𐴠 𐴋𐴝𐴥𐴑𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴖𐴝𐴌 𐴔𐴝𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴊𐴠 𐴕𐴞𐴑𐴞؟“<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴝𐴈𐴝𐴤𐴘𐴊𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴝𐴌𐴡𐴥𐴌 𐴑𐴞𐴘𐴝𐴥؟“</char> <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴝𐴥𐴕𐴝𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴁𐴝𐴙𐴕𐴊𐴝𐴤 𐴇𐴝𐴥𐴓𐴡𐴃𐴠, 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔 𐴑𐴝𐴥𐴘𐴧𐴝𐴉𐴝𐴏𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴞𐴘𐴠.<verse eid="JHN 18:24" /></para>
  <para style="s1">𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 26:71-75">𐴔𐴡𐴃𐴢 26‏:71‏-75</ref>; <ref loc="MRK 14:69-72">𐴔𐴝𐴑 14‏:69‏-72</ref>; <ref loc="LUK 22:58-62">𐴓𐴟𐴑 22‏:58‏-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴡𐴦𐴙𐴕 𐴉𐴟𐴖𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴘𐴡𐴥 𐴇𐴡𐴥𐴕𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴥؟“</para>
  <para style="p" vid="JHN 18:25">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴕𐴡.“<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴒𐴟𐴓𐴝𐴔𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴝𐴕 𐴈𐴝𐴍𐴞𐴉𐴠𐴓𐴝𐴙𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴀𐴠𐴒𐴝𐴕𐴝, 𐴀𐴞𐴥𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴝𐴒𐴝𐴕𐴡𐴃𐴢 𐴕𐴡𐴥 𐴊𐴠𐴑𐴞𐴥 𐴕𐴞𐴑𐴞؟“ <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢; 𐴀𐴝𐴦𐴌 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴁𐴝𐴑 𐴊𐴞𐴘𐴠𐴥.<verse eid="JHN 18:27" /></para>
  <para style="s1">𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴏𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 27:1-2">𐴔𐴡𐴃𐴢 27‏:1‏-2</ref>‏,<ref loc="MAT 27:11-14">11‏-14</ref>; <ref loc="MRK 15:1-5">𐴔𐴝𐴑 15‏:1‏-5</ref>; <ref loc="LUK 23:1-5">𐴓𐴟𐴑 23‏:1‏-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴝𐴥𐴘𐴧𐴝𐴉𐴝𐴏𐴡𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴌𐴡𐴔𐴞 𐴌𐴝𐴎𐴔𐴡𐴇𐴡𐴥𐴓𐴡𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴁𐴞𐴀𐴕𐴧𐴝 𐴏𐴡𐴥𐴀𐴌𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴠 𐴇𐴠𐴥 𐴔𐴡𐴇𐴡𐴥𐴓𐴡𐴃𐴢 𐴕𐴡𐴥 𐴒𐴡𐴥𐴓𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴝𐴉𐴝𐴑 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴝𐴒𐴡𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴇𐴝𐴥𐴘 𐴉𐴝𐴌𐴠. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴉𐴞𐴓𐴝𐴃𐴢 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴑𐴞𐴦 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴀𐴝𐴙𐴕𐴧𐴡𐴤 𐴊𐴠𐴥؟“<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴐𐴝𐴥𐴔𐴞 𐴕𐴡 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘 𐴕𐴡 𐴊𐴞𐴃𐴝𐴔.“<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴡𐴤𐴒𐴡𐴘.“</para>
  <para style="p" vid="JHN 18:31">𐴇𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴒𐴟𐴥𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴕𐴝𐴥𐴘.“ <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴡 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴌𐴝 𐴔𐴡𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴞𐴐𐴝𐴥𐴌𐴝𐴘𐴠 𐴈𐴡𐴀𐴙𐴓𐴢.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴉𐴞𐴓𐴝𐴃𐴢 𐴀𐴝𐴁𐴝𐴌 𐴌𐴝𐴎𐴔𐴡𐴇𐴡𐴥𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴕𐴞𐴑𐴞؟“<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴈𐴡𐴃𐴝𐴤 𐴘𐴝𐴀𐴕 𐴕𐴞𐴎𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴕𐴠𐴥, 𐴕𐴝𐴥𐴑𐴞 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠𐴥؟“</char><verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴕𐴞𐴥𐴑𐴞؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴞𐴎𐴡𐴌 𐴑𐴡𐴗𐴔𐴠 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴔𐴟𐴥𐴕𐴠 𐴀𐴠𐴥𐴕𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠. 𐴃𐴟𐴀𐴛 𐴑𐴞𐴦 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠𐴥؟“<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴡. 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴝𐴌𐴝𐴔𐴝𐴌𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴝 𐴕𐴡 𐴎𐴝. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴀𐴠𐴍𐴞𐴥𐴘𐴝𐴌 𐴕𐴡.“</char><verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴀𐴛 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴕𐴞𐴥𐴑𐴞؟“ 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴌, 𐴀𐴝𐴀𐴛 𐴁𐴝𐴀𐴣𐴐𐴧𐴝. 𐴀𐴝𐴕𐴞𐴤 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴦𐴌 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴞𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥: 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴀𐴟𐴎𐴟 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴏𐴡𐴥𐴘𐴧𐴞𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴠.“</char><verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴥𐴘𐴧𐴞 𐴑𐴞𐴦؟“</para>
  <para style="s1" vid="JHN 18:38">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">𐴔𐴡𐴃𐴢 27‏:15‏-31</ref>; <ref loc="MRK 15:6-20">𐴔𐴝𐴑 15‏:6‏-20</ref>; <ref loc="LUK 23:13-25">𐴓𐴟𐴑 23‏:13‏-25</ref>)</para>
  <para style="p" vid="JHN 18:38">𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴁𐴝𐴌 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡 𐴉𐴝𐴙𐴌.<verse eid="JHN 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />”𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴃𐴡 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴘𐴡𐴔 𐴀𐴝𐴏𐴠𐴤, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴑 𐴇𐴡𐴊𐴞𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝𐴌 𐴎𐴡𐴌𐴟𐴌. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴖𐴝𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴁𐴝𐴘𐴃𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴕𐴠𐴥؟“<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴝𐴁𐴝𐴌 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝 𐴌𐴠!“ 𐴇𐴠𐴥 𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴁𐴝𐴒𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />𐴁𐴝𐴦𐴊𐴠 𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘 𐴏𐴡𐴀𐴣𐴑 𐴔𐴝𐴌𐴝 𐴁𐴝𐴀𐴙𐴓𐴢. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />𐴀𐴝𐴦𐴌 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴑𐴠𐴣𐴍𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴃𐴝𐴏𐴢 𐴁𐴝𐴕𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴊𐴞𐴘𐴝𐴘𐴊𐴞𐴀𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴝𐴘𐴡𐴙𐴕𐴧𐴝 𐴌𐴡𐴚𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴎𐴟𐴁𐴧𐴝 𐴉𐴞𐴣𐴊𐴝𐴥𐴘𐴊𐴞𐴓𐴢. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢-𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝, 𐴔𐴝𐴥𐴌𐴇𐴝𐴁𐴝!“ 𐴇𐴠𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢-𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴖𐴝𐴌 𐴔𐴝𐴙𐴅𐴧𐴠𐴥.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />𐴉𐴞𐴓𐴝𐴃𐴢 𐴀𐴝𐴁𐴝𐴌 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴝𐴀𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴕𐴝𐴤𐴙𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴡 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡 𐴉𐴝𐴙𐴌.“ <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴑𐴠𐴣𐴍𐴝𐴌 𐴃𐴝𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴘𐴡𐴙𐴕𐴧𐴝 𐴌𐴡𐴚𐴡𐴌 𐴎𐴟𐴁𐴧𐴝 𐴉𐴞𐴕𐴊𐴝𐴤 𐴇𐴝𐴥𐴓𐴡𐴃𐴠 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴀𐴌𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴀𐴝𐴦𐴌 𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝!“<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴔𐴟𐴥𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴒𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴡, 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴡!“</para>
  <para style="p" vid="JHN 19:6">𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡 𐴉𐴝𐴙𐴌, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴡𐴘𐴎𐴝𐴘 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴡𐴥𐴒𐴡𐴘.“<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴒𐴟𐴥𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴀𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴔𐴡𐴌𐴝𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴊𐴝𐴁𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.“<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴞𐴓𐴝𐴃𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴌𐴡𐴤 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘, <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />𐴀𐴝𐴦𐴌 𐴌𐴝𐴎𐴔𐴡𐴇𐴡𐴥𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴒𐴡𐴥𐴓𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴇𐴡𐴍𐴞𐴥𐴘𐴝𐴌؟“ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴖𐴝𐴁𐴢 𐴕𐴡𐴥 𐴊𐴠𐴥. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴈𐴡𐴘𐴁𐴝𐴤 𐴕𐴞𐴥𐴑𐴞؟ 𐴃𐴟𐴀𐴛 𐴑𐴞𐴥 𐴕𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴠𐴌𐴞𐴊𐴞𐴁𐴝𐴌 𐴀𐴡𐴥 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴥 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠𐴥؟“<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴖𐴡𐴃𐴧𐴟𐴥 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴝 𐴕𐴡 𐴎𐴝𐴘𐴃𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴃𐴡. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴝𐴌𐴡𐴤 𐴋𐴡𐴣𐴀𐴌.“</char><verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴠𐴌𐴞𐴊𐴞𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴒𐴟𐴥𐴕𐴠 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴎𐴡𐴊𐴞 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴀𐴠𐴌𐴞𐴊𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴀𐴛 𐴑𐴝𐴥𐴘𐴏𐴝𐴌𐴡𐴌<note caller="+" style="f"><char style="fr" closed="false">19‏:12 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑𐴡𐴃𐴢 𐴑𐴝𐴥𐴘𐴏𐴝𐴌 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴝𐴔 𐴕𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴡𐴔 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴡𐴑𐴡𐴥𐴁𐴢. </char></note> 𐴊𐴟𐴏𐴃𐴡𐴥 𐴕𐴡. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴑𐴝𐴥𐴘𐴏𐴝𐴌𐴡𐴌 𐴊𐴟𐴐𐴧𐴡𐴕.“<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴞𐴓𐴝𐴃𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴁𐴝𐴀𐴌𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴁𐴝𐴦𐴊𐴠 𐴎𐴠 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕𐴡𐴌𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌-𐴀𐴡𐴌-𐴀𐴟𐴍𐴝𐴥𐴕 𐴈𐴡𐴀, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴁𐴌𐴟𐴤 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴒𐴝𐴁𐴧𐴝𐴃𐴝 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴁𐴞𐴏𐴝𐴌𐴡𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴕𐴗𐴝𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴃𐴡𐴘𐴧𐴝𐴌𐴞𐴌 𐴊𐴞𐴕، 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴊𐴞𐴕𐴡𐴌 𐴊𐴟𐴀𐴣𐴙𐴅𐴧𐴝 𐴀𐴝𐴥𐴕𐴞𐴑 𐴀𐴡𐴥𐴘𐴧𐴠.</para>
  <para style="p" vid="JHN 19:14">𐴉𐴞𐴓𐴝𐴃𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝!“<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴊𐴟𐴌 𐴒𐴡𐴌𐴡𐴤, 𐴊𐴟𐴌 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴡!“</para>
  <para style="p" vid="JHN 19:15">𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴃𐴝𐴔؟“</para>
  <para style="p" vid="JHN 19:15">𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴑𐴝𐴥𐴘𐴏𐴝𐴌 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴕𐴝𐴥𐴘.“<verse eid="JHN 19:15" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 27:32-44">𐴔𐴡𐴃𐴢 27‏:32‏-44</ref>; <ref loc="MRK 15:21-32">𐴔𐴝𐴑 15‏:21‏-32</ref>; <ref loc="LUK 23:26-43">𐴓𐴟𐴑 23‏:26‏-43</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />𐴃𐴡𐴥𐴘 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠. 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="JHN 19:16" /><verse number="17" style="v" sid="JHN 19:17" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴢 𐴕𐴞𐴎𐴠 𐴈𐴝𐴣𐴊𐴡𐴥𐴃𐴢 𐴓𐴡𐴦𐴘𐴢 𐴁𐴝𐴀𐴌𐴠 𐴔𐴝𐴃𐴝𐴥𐴌-𐴔𐴝𐴓𐴝 𐴈𐴡𐴀 𐴊𐴠 𐴎𐴝𐴒𐴝 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴇𐴞𐴁𐴌𐴟𐴤 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴒𐴡𐴓𐴒𐴡𐴃𐴝 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀. <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴌 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴘𐴠, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴑 𐴑𐴟𐴓𐴃𐴟𐴥 𐴀𐴠𐴑 𐴑𐴟𐴓𐴃𐴟𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴎𐴠𐴥.<verse eid="JHN 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴝𐴥𐴙𐴕𐴁𐴟𐴥𐴄𐴢 𐴀𐴡𐴥 𐴓𐴠𐴑𐴞𐴥 𐴀𐴞𐴏𐴝𐴤𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴔𐴝𐴌𐴞𐴊𐴞𐴀𐴓𐴢. 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠: <char style="sc">𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴏𐴝𐴥𐴌𐴞, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝.</char> <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />𐴁𐴡𐴀𐴗𐴃𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴠𐴥 𐴏𐴝𐴥𐴙𐴕𐴁𐴟𐴥𐴄𐴢 𐴄𐴝𐴥𐴕 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴋𐴝𐴥𐴑𐴠; 𐴀𐴝𐴦𐴌 𐴏𐴝𐴥𐴙𐴕𐴁𐴟𐴥𐴄𐴢 𐴄𐴝𐴥𐴕 𐴇𐴞𐴁𐴌𐴟𐴤, 𐴒𐴞𐴌𐴞𐴥𐴑 𐴀𐴠𐴊𐴧𐴠 𐴓𐴠𐴄𐴞𐴥𐴕 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴔𐴟𐴥𐴕𐴠 𐴉𐴞𐴓𐴝𐴃𐴡𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”’𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝‘ 𐴕𐴡 𐴓𐴠𐴑𐴞𐴥𐴘𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴑𐴡𐴥, ’𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝.‘ “<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴓𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴀𐴛 𐴓𐴠𐴙𐴑𐴧𐴞𐴥.“<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴡𐴌 𐴇𐴡𐴦𐴌 𐴑𐴟𐴥𐴓𐴞 𐴓𐴡𐴦𐴘𐴢 𐴏𐴝𐴙𐴌 𐴁𐴝𐴥𐴑 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴠𐴑 𐴉𐴡𐴥𐴗𐴏𐴡𐴓𐴧𐴝 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑𐴡𐴌 𐴊𐴡𐴥𐴌𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴟𐴁𐴧𐴝 𐴖𐴝 𐴘𐴡𐴥 𐴓𐴡𐴘𐴧𐴠𐴥. 𐴇𐴠𐴥 𐴎𐴟𐴁𐴧𐴝 𐴖𐴝 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴌𐴝𐴊𐴞𐴘𐴝 𐴏𐴝𐴥𐴌𐴝, 𐴀𐴝𐴦𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴓𐴡𐴥𐴃𐴞 𐴕𐴞𐴏𐴠 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴠𐴑 𐴇𐴡𐴦𐴌.<verse eid="JHN 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 19:24" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠 𐴎𐴟𐴁𐴧𐴝 𐴖𐴝 𐴕𐴡 𐴉𐴝𐴥𐴍𐴞, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴓𐴡𐴄𐴝𐴥𐴌𐴞 𐴔𐴝𐴌𐴞 𐴏𐴝𐴀𐴘𐴢 𐴘𐴞𐴁𐴝𐴤 𐴇𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴉𐴡𐴌𐴠.“<note caller="+" style="f"><char style="fr" closed="false">19‏:24 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:18">𐴎𐴡𐴁𐴟𐴌 22‏:18</ref></char></char></note></para>
  <para style="p" vid="JHN 19:24">𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥,</para>
  <para style="q1" vid="JHN 19:24">”𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴡𐴦𐴌𐴡𐴌𐴠 𐴁𐴡𐴌𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥,</para>
  <para style="q2" vid="JHN 19:24">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴇𐴡𐴦𐴌𐴡𐴓𐴧𐴝 𐴓𐴡𐴄𐴝𐴥𐴌𐴞 𐴔𐴝𐴙𐴅𐴧𐴠𐴥.“</para>
  <para style="m" vid="JHN 19:24">𐴉𐴡𐴥𐴗𐴏𐴢 𐴏𐴟𐴥𐴕𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦𐴌 𐴁𐴡𐴥𐴙𐴕, 𐴀𐴝𐴦𐴌 𐴑𐴓𐴡𐴂𐴝𐴏𐴡𐴌 𐴁𐴡𐴖𐴢 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴦𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴠 𐴀𐴝𐴊𐴡𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝𐴌𐴠 𐴋𐴝𐴥𐴑𐴠 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴦𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴔𐴝𐴦, 𐴏𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴁𐴝𐴤.“</char><verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴠𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴡𐴀, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴝𐴦 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴁𐴝𐴤.“</char> 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴇𐴠𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴥𐴓𐴒𐴡𐴘.<verse eid="JHN 19:27" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴡𐴦𐴃𐴢</para>
  <para style="r">(<ref loc="MAT 27:45-56">𐴔𐴡𐴃𐴢 27‏:45‏-56</ref>; <ref loc="MRK 15:33-41">𐴔𐴝𐴑 15‏:33‏-41</ref>; <ref loc="LUK 23:44-49">𐴓𐴟𐴑 23‏:44‏-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴘 𐴉𐴝𐴌𐴞, 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴞𐴌𐴝𐴥𐴐𐴢 𐴓𐴝𐴙𐴒𐴧𐴠𐴥.“</char> <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴞𐴥𐴌𐴑𐴝𐴌<note caller="+" style="f"><char style="fr" closed="false">19‏:29 </char><char style="fq">𐴏𐴞𐴥𐴌𐴑𐴝</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴝𐴕𐴞𐴥 𐴔𐴞𐴘𐴝𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴐𐴡𐴥𐴌𐴁𐴡𐴃𐴢, 𐴎𐴞𐴀𐴕 𐴈𐴝𐴥𐴘𐴃𐴠 𐴇𐴡𐴥𐴌𐴡-𐴇𐴡𐴥𐴌𐴡 𐴓𐴝𐴒𐴠. </note> 𐴃𐴝𐴥𐴌𐴝 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴝𐴘𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴁𐴝𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴠𐴏𐴉𐴡𐴥𐴕𐴅<note caller="+" style="f"><char style="fr" closed="false">19‏:29 </char><char style="fq">𐴀𐴠𐴏𐴉𐴡𐴥𐴕𐴅</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴞𐴚𐴒𐴞𐴌𐴝𐴎𐴞 𐴓𐴡𐴉𐴎𐴡𐴥, 𐴉𐴟𐴀𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴉𐴝𐴕𐴞𐴥 𐴄𐴝𐴕𐴠 𐴊𐴠 𐴏𐴞𐴎𐴢</note> 𐴁𐴟𐴌𐴝𐴘𐴧𐴡𐴌𐴠 𐴇𐴞𐴥𐴏𐴡𐴂𐴢-𐴒𐴝𐴏𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴠𐴥𐴀𐴘𐴓𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴁𐴝𐴎𐴝𐴥𐴘𐴊𐴞 𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴝𐴓𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴇𐴠𐴥 𐴏𐴞𐴥𐴌𐴑𐴝 𐴈𐴝𐴥𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.“</char> 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴥𐴌𐴠 𐴇𐴠𐴥𐴔𐴧𐴞𐴑𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴌𐴝𐴕 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.<verse eid="JHN 19:30" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴝𐴦𐴌 𐴋𐴝𐴥𐴑 𐴁𐴝𐴘 𐴏𐴠𐴥𐴓𐴢 𐴔𐴝𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴕𐴗𐴝𐴥 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕𐴡𐴌 𐴃𐴡𐴘𐴧𐴝𐴌𐴞𐴌 𐴊𐴞𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴓𐴝𐴐𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠 𐴉𐴝𐴥𐴕 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴞𐴓𐴝𐴃𐴡𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴄𐴠𐴥𐴚 𐴒𐴟𐴥𐴕 𐴁𐴝𐴥𐴚𐴒𐴞𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴓𐴝𐴐𐴢 𐴓𐴝𐴔𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴕𐴗𐴝𐴥 𐴈𐴝𐴥𐴀𐴏𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />𐴃𐴡𐴥𐴘 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴀𐴘𐴢, 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴘𐴝 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴄𐴠𐴥𐴚 𐴒𐴟𐴥𐴕 𐴁𐴝𐴥𐴚𐴒𐴞𐴊𐴞𐴓𐴢, 𐴀𐴝𐴒𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴡𐴌, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴄𐴠𐴥𐴚 𐴕𐴡𐴥 𐴁𐴝𐴥𐴚𐴒𐴠. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴡𐴥𐴗𐴏𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴝𐴦𐴌 𐴋𐴝𐴥𐴑 𐴁𐴝𐴘 𐴏𐴠𐴥𐴓𐴢 𐴔𐴝𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴥𐴇𐴡𐴕 𐴈𐴠𐴥𐴕𐴃𐴟 𐴓𐴡𐴖𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴠𐴤 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴡𐴁𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞; 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴝𐴕𐴠 𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴌𐴡𐴤. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥, ”𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴥𐴣𐴋𐴧𐴞 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴁𐴝𐴥𐴣𐴒𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">19‏:36 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 12:46">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 12‏:46</ref></char>; <char style="xt"><ref loc="NUM 9:12">𐴒𐴡𐴕𐴝 9‏:12</ref></char>; <char style="xt"><ref loc="PSA 34:20">𐴎𐴡𐴁𐴟𐴌 34‏:20</ref></char></char></note> <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q" vid="JHN 19:37">”𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴒𐴝𐴣𐴙𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">19‏:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 12:10">𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝 12‏:10</ref></char></char></note><verse eid="JHN 19:37" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴝𐴥𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 27:57-61">𐴔𐴡𐴃𐴢 27‏:57‏-61</ref>; <ref loc="MRK 15:42-47">𐴔𐴝𐴑 15‏:42‏-47</ref>; <ref loc="LUK 23:50-56">𐴓𐴟𐴑 23‏:50‏-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴝𐴌𐴝𐴔𐴝𐴥𐴃𐴞𐴘𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴘𐴟𐴏𐴟𐴥𐴉𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴝𐴐𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴃𐴡𐴥𐴘 𐴉𐴞𐴓𐴝𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴔𐴝𐴙𐴒𐴧𐴞𐴥𐴓𐴢. 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴀𐴟𐴔𐴧𐴡𐴃𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴃𐴡𐴥. 𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴝𐴐𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴞𐴑𐴡𐴥𐴊𐴠𐴔𐴝𐴏𐴢 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴒𐴠 𐴌𐴝𐴙𐴃𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴠𐴥𐴍𐴠 𐴒𐴞𐴀𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴘𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥; 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴔𐴟𐴌 𐴀𐴝𐴣𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴡𐴤-𐴒𐴝𐴏𐴢 𐴔𐴞𐴘𐴝𐴥𐴘 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴃𐴞𐴌𐴞𐴥𐴐𐴢 𐴃𐴞𐴕 𐴐𐴠𐴥𐴌 𐴀𐴝𐴥𐴕𐴞𐴑 𐴑𐴟𐴥𐴐𐴁𐴡𐴌 𐴒𐴟𐴌𐴞 𐴀𐴝𐴙𐴕𐴧𐴞𐴤𐴓𐴢. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴝𐴐𐴧𐴗𐴝 𐴓𐴡𐴘𐴎𐴝𐴘 𐴑𐴟𐴥𐴐𐴁𐴡 𐴒𐴟𐴥𐴕 𐴊𐴞𐴦 𐴉𐴟𐴥𐴣𐴃𐴝𐴌 𐴇𐴡𐴦𐴌 𐴓𐴡𐴥𐴘 𐴇𐴡𐴇𐴡𐴥𐴕 𐴏𐴡𐴓𐴝𐴘𐴧𐴠𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴝𐴥𐴌 𐴕𐴞𐴘𐴡𐴔 𐴀𐴝𐴏𐴠𐴤. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />𐴎𐴠 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴓𐴢 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴝𐴒𐴝𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴁𐴝𐴒𐴝𐴕𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴕𐴡𐴘𐴝 𐴈𐴡𐴁𐴡𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴃𐴢 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴝𐴥𐴙𐴓𐴢 𐴊𐴠 𐴕𐴝𐴥𐴘. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴕𐴗𐴝𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕𐴡𐴌 𐴃𐴡𐴘𐴧𐴝𐴌𐴞𐴌 𐴊𐴞𐴕 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴇𐴠𐴥 𐴈𐴡𐴁𐴡𐴌𐴒𐴗𐴝𐴥 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴋𐴝𐴥𐴑𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴘𐴞𐴥𐴁𐴝𐴃𐴢 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠</para>
  <para style="r">(<ref loc="MAT 28:1-10">𐴔𐴡𐴃𐴢 28‏:1‏-10</ref>; <ref loc="MRK 16:1-8">𐴔𐴝𐴑 16‏:1‏-8</ref>; <ref loc="LUK 24:1-12">𐴓𐴟𐴑 24‏:1‏-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />𐴇𐴝𐴥𐴉𐴃𐴝𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴊𐴞𐴕 𐴉𐴡𐴥𐴎𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴃𐴝𐴥𐴑𐴞𐴃𐴠, 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞 𐴈𐴡𐴁𐴡𐴌 𐴒𐴗𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴔𐴟𐴑𐴡𐴃𐴧𐴟 𐴐𐴞𐴥𐴓𐴢 𐴓𐴝𐴕 𐴓𐴝𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴝. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴞𐴥𐴁𐴝 𐴊𐴟𐴣𐴌𐴞 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴎𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴧𐴟 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥𐴒𐴡𐴘; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴡𐴍𐴠𐴥 𐴀𐴠𐴙𐴅𐴧𐴠𐴥𐴒𐴡𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴞.“<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝 𐴕𐴠𐴦𐴓𐴞 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴢 𐴎𐴝𐴦𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴀𐴠𐴑𐴧𐴟 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴊𐴟𐴣𐴌𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴁𐴝𐴥𐴌𐴝𐴘 𐴎𐴝𐴘 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴢 𐴀𐴝𐴒𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴘𐴟𐴥𐴌𐴞 𐴁𐴟𐴥𐴃𐴡𐴌𐴔𐴞𐴥𐴑𐴧𐴝 𐴏𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴇𐴡𐴇𐴡𐴥𐴕𐴡𐴌 𐴇𐴡𐴦𐴌 𐴒𐴟𐴥𐴕 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴡𐴥 𐴎𐴝. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌 𐴀𐴡𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴀𐴝𐴀𐴘𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴁𐴡𐴌 𐴒𐴗𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴧𐴠; 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴘𐴡𐴥 𐴇𐴡𐴇𐴡𐴥𐴕𐴡𐴌 𐴇𐴡𐴦𐴌 𐴒𐴟𐴥𐴕 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />𐴀𐴝𐴦𐴌 𐴎𐴠 𐴇𐴡𐴦𐴌 𐴒𐴝𐴥𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴁𐴠𐴌𐴝𐴤𐴘𐴊𐴞𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴇𐴡𐴥𐴕𐴡𐴌 𐴇𐴡𐴦𐴌𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴝𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴡𐴑 𐴒𐴡𐴌𐴞 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴁𐴡𐴙𐴄𐴧𐴝. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴎𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴢 𐴀𐴝𐴒𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴞𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴘𐴡𐴥 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴊𐴠𐴑𐴞𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴃𐴟𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 𐴊𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴇𐴠𐴥 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡𐴥 𐴁𐴟𐴎𐴠𐴥. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴇𐴠𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="JHN 20:10" /></para>
  <para style="s1">𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MRK 16:9-11">𐴔𐴝𐴑 16‏:9‏-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />𐴓𐴠𐴑𐴞𐴕 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴈𐴝𐴣𐴊𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴇𐴞𐴥𐴁𐴝 𐴈𐴝𐴣𐴊𐴞-𐴈𐴝𐴣𐴊𐴞 𐴕𐴞𐴘𐴟𐴥𐴌𐴞 𐴈𐴡𐴁𐴡𐴌 𐴒𐴗𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴔𐴞𐴥𐴑𐴧𐴝 𐴏𐴝𐴘𐴧𐴠𐴥, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />𐴀𐴝𐴦𐴌 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴝𐴐𐴢 𐴎𐴞𐴘𐴡𐴥𐴣𐴃𐴢 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴇𐴞𐴥𐴛𐴡𐴃𐴢 𐴊𐴡𐴥𐴓𐴝 𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴝𐴤 𐴊𐴟𐴖𐴝𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴐𐴞𐴥𐴃𐴝𐴕 𐴀𐴡𐴃𐴧𐴟, 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴡𐴘𐴃𐴝𐴥𐴕 𐴀𐴡𐴃𐴧𐴟.<verse eid="JHN 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13" />𐴇𐴞𐴥𐴀𐴕𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝, 𐴃𐴟𐴘 𐴈𐴝𐴣𐴊𐴡𐴀𐴌 𐴑𐴞𐴘𐴝𐴥؟“</para>
  <para style="p" vid="JHN 20:13">𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥𐴒𐴡𐴘; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴡𐴍𐴠𐴥 𐴀𐴠𐴙𐴅𐴧𐴠𐴥𐴒𐴡𐴘 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴕𐴞.“ <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴏𐴧𐴝𐴥 𐴉𐴞𐴥𐴌𐴞 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴏𐴝𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴡𐴥 𐴏𐴞𐴕𐴠𐴥.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝, 𐴃𐴟𐴘 𐴈𐴝𐴣𐴊𐴡𐴀𐴌 𐴑𐴞𐴘𐴝𐴥؟ 𐴃𐴟𐴘 𐴇𐴝𐴌𐴠𐴤 𐴃𐴟𐴖𐴡𐴀𐴌 𐴊𐴠𐴥؟“</char></para>
  <para style="p" vid="JHN 20:15">𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴁𐴝𐴒𐴝𐴕 𐴏𐴡𐴥𐴣𐴓𐴡𐴘𐴝 𐴁𐴡𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴅𐴡𐴕𐴝𐴥𐴁𐴢, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴓𐴡𐴘𐴒𐴞𐴘𐴡𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴡𐴍𐴠𐴥 𐴀𐴠𐴙𐴅𐴧𐴡𐴥𐴒𐴡𐴘 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘𐴧𐴟𐴥𐴔𐴁𐴡𐴘.“<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴡𐴌𐴞𐴘𐴝𐴔!“</char> 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴉𐴞𐴥𐴌𐴞 𐴇𐴞𐴁𐴌𐴟𐴤 𐴎𐴟𐴁𐴝𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴟𐴥𐴕𐴞!“ 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞, 𐴀𐴟𐴏𐴃𐴝𐴃𐴢.<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞 𐴕𐴡 𐴌𐴝𐴑𐴞𐴥𐴐𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴖𐴡𐴌𐴠 𐴁𐴝𐴉𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴕𐴡𐴥 𐴎𐴝𐴘𐴒𐴡𐴥𐴘; 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴕𐴟𐴥𐴕𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘 𐴈𐴡𐴀𐴒𐴡𐴘 𐴊𐴠, ’𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴁𐴠 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘.‘ “</char><verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />𐴃𐴡𐴥𐴘 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞 𐴀𐴝𐴀𐴘𐴢 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠.<verse eid="JHN 20:18" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MAT 28:16-20">𐴔𐴡𐴃𐴢 28‏:16‏-20</ref>; <ref loc="MRK 16:14-18">𐴔𐴝𐴑 16‏:14‏-18</ref>; <ref loc="LUK 24:36-49">𐴓𐴟𐴑 24‏:36‏-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴌, 𐴘𐴝𐴥𐴕𐴞 𐴇𐴝𐴥𐴉𐴃𐴝𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴊𐴞𐴕𐴡𐴌 𐴇𐴝𐴥𐴣𐴎𐴞𐴕𐴧𐴝, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴦𐴌𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴎𐴠𐴍𐴠𐴥 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠 𐴇𐴠𐴥𐴍𐴞𐴘𐴝𐴌 𐴊𐴟𐴖𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴣𐴊𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴝𐴎𐴠𐴥 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴏𐴧𐴝𐴓𐴝𐴔𐴟 𐴀𐴝𐴓𐴝𐴘𐴑𐴟𐴔.“</char> <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴕𐴞𐴥 𐴀𐴝𐴥𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴝𐴦𐴌 𐴋𐴝𐴥𐴑 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴠. 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="JHN 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴏𐴧𐴝𐴓𐴝𐴔𐴟 𐴀𐴝𐴓𐴝𐴘𐴑𐴟𐴔. 𐴁𐴝𐴉𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌.“</char> <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴘𐴢, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴉𐴟𐴥 𐴊𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴂𐴝𐴑-𐴌𐴟𐴀 𐴓𐴡𐴦. </char> <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡.“</char><verse eid="JHN 20:23" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴡𐴥𐴔𐴝𐴏𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴥𐴔𐴝𐴏𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴎𐴡𐴦𐴣𐴙𐴑𐴧𐴝<note caller="+" style="f"><char style="fr" closed="false">20‏:24 </char><char style="fq">𐴃𐴡𐴥𐴔𐴝𐴏𐴢</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴌𐴝𐴤𐴔𐴞𐴑 𐴓𐴡𐴉𐴎𐴡𐴥, <char style="fqa">𐴊𐴞𐴊𐴞𐴔𐴟𐴏𐴢</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴞𐴌𐴞𐴥𐴑 𐴓𐴡𐴉𐴎𐴡𐴥, 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 <char style="fq" closed="false">𐴎𐴡𐴦𐴣𐴙𐴑𐴧𐴝</char></note> 𐴋𐴝𐴑𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥.“</para>
  <para style="p" vid="JHN 20:25">𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴠𐴃𐴟𐴥𐴕 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴕𐴞𐴥 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴎𐴡𐴓𐴡𐴙𐴌 𐴊𐴝𐴑 𐴕𐴡𐴥 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴦𐴌 𐴎𐴡𐴓𐴡𐴙𐴌 𐴎𐴝𐴒𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴀𐴡𐴦𐴣𐴓𐴢 𐴒𐴡𐴥𐴓𐴝𐴘 𐴕𐴡𐴥 𐴊𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴝𐴥𐴑𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴘𐴊𐴞 𐴕𐴡𐴥 𐴏𐴝𐴀𐴘𐴢, 𐴇𐴠𐴥𐴃𐴟𐴕 𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔.“<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />𐴘𐴝𐴥𐴌 𐴀𐴝𐴣𐴐𐴄𐴡 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴝𐴁𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴃𐴡𐴥𐴔𐴝𐴏𐴢 𐴀𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴊𐴟𐴖𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴣𐴊𐴝𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴝𐴎𐴠𐴥 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴏𐴧𐴝𐴓𐴝𐴔𐴟 𐴀𐴝𐴓𐴝𐴘𐴑𐴟𐴔.“</char> <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡𐴥𐴔𐴝𐴏𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴌 𐴀𐴡𐴦𐴣𐴓𐴢 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴕, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴢 𐴏𐴝𐴀; 𐴃𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴋𐴝𐴥𐴑𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴘𐴊𐴠. 𐴕𐴝𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴐𐴢, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴥𐴌.“</char><verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />𐴃𐴡𐴥𐴔𐴝𐴏𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝!“<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴔𐴝𐴏𐴢, 𐴃𐴟𐴘 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴠𐴙𐴑𐴧𐴡𐴥𐴏𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴡𐴤𐴏𐴢. 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴓𐴠 𐴘𐴡 𐴃𐴡𐴀 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤.“</char><verse eid="JHN 20:29" /></para>
  <para style="s1">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝; <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴀𐴕𐴡𐴌𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴡𐴤 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝; 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴡𐴤.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴞𐴁𐴞𐴌𐴞𐴘𐴝𐴏𐴢 𐴋𐴞𐴀𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠, 𐴃𐴞𐴁𐴞𐴌𐴞𐴘𐴝𐴏𐴢 𐴋𐴞𐴀𐴌<note caller="+" style="f"><char style="fr" closed="false">21‏:1 </char><char style="ft" closed="false">𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴋𐴞𐴀</char></note> 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴁𐴝𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠 𐴊𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌, 𐴎𐴡𐴦𐴣𐴙𐴑𐴧𐴝<note caller="+" style="f"><char style="fr" closed="false">21‏:2 </char><char style="fq">𐴃𐴡𐴥𐴔𐴝𐴏𐴢</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴌𐴝𐴤𐴔𐴞𐴑 𐴓𐴡𐴉𐴎𐴡𐴥, <char style="fqa">𐴊𐴞𐴊𐴞𐴔𐴟𐴏𐴢 </char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴞𐴌𐴞𐴥𐴑 𐴓𐴡𐴉𐴎𐴡𐴥, 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 <char style="fq" closed="false">𐴎𐴡𐴦𐴣𐴙𐴑𐴧𐴝</char></note> 𐴋𐴝𐴑𐴠 𐴊𐴠 𐴃𐴡𐴥𐴔𐴝𐴏𐴢, 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴑𐴝𐴥𐴕𐴝 𐴉𐴝𐴌𐴝𐴌 𐴕𐴝𐴃𐴝𐴕𐴠𐴓𐴢, 𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌 𐴉𐴟𐴀𐴝𐴙𐴕, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴌 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴔𐴝𐴏𐴢 𐴏𐴝𐴘𐴃𐴡𐴥 𐴎𐴝𐴙𐴌.“ 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴎𐴝𐴘𐴧𐴟𐴔.“ 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴠𐴦𐴓𐴞 𐴎𐴝𐴘 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴡𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴌𐴝𐴙𐴃𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴏𐴢 𐴕𐴡𐴥 𐴉𐴝𐴦.<verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />𐴁𐴞𐴀𐴕𐴧𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴡𐴥𐴎𐴡𐴌 𐴉𐴝𐴥𐴍𐴠𐴌, 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴀𐴘𐴢 𐴋𐴞𐴀𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴏𐴝𐴤 𐴊𐴠 𐴕𐴡𐴥 𐴏𐴞𐴕𐴠𐴥.<verse eid="JHN 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 21:5" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴟𐴀𐴝𐴙𐴕, 𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴏𐴢 𐴉𐴝𐴘𐴧𐴡𐴥 𐴕𐴠𐴥؟“</char></para>
  <para style="p" vid="JHN 21:5">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴕𐴡𐴥 𐴉𐴝𐴘.“<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴡𐴦𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴎𐴝𐴓𐴢 𐴉𐴠𐴥𐴓𐴡, 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴏𐴢 𐴉𐴝𐴘𐴁𐴝.“</char> 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴓𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴏𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴓𐴢 𐴓𐴝𐴕 𐴀𐴝𐴌 𐴄𐴝𐴕𐴞 𐴃𐴟𐴓𐴞𐴤 𐴕𐴡 𐴉𐴝𐴌𐴠𐴌.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝𐴘𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴃𐴡 𐴔𐴝𐴓𐴞𐴑!“ 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝 𐴔𐴝𐴓𐴞𐴑 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴦𐴌 𐴖𐴡𐴌𐴡𐴌 𐴇𐴡𐴦𐴌 𐴒𐴝𐴥𐴕 𐴁𐴠𐴌𐴝𐴤𐴘 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴎𐴝𐴥𐴂𐴢 𐴔𐴝𐴙𐴅𐴧𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴑𐴟𐴥𐴓𐴞 𐴀𐴠𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴓𐴡𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴊𐴟𐴌𐴠𐴥 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴊𐴟𐴘 𐴐𐴡𐴥𐴃𐴢 𐴀𐴝𐴥𐴃𐴢 𐴀𐴝𐴥𐴕𐴞𐴑 𐴁𐴠 𐴊𐴟𐴌𐴠𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴔𐴝𐴏𐴢 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴎𐴝𐴓𐴢 𐴓𐴝𐴕 𐴄𐴝𐴕𐴞-𐴄𐴝𐴕𐴞 𐴇𐴠𐴥 𐴒𐴟𐴌𐴝 𐴕𐴡𐴦 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴑𐴟𐴓𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴓𐴝𐴙𐴔𐴧𐴠𐴥, 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴇𐴡𐴘𐴓𐴝𐴌 𐴄𐴝𐴓𐴢, 𐴘𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴔𐴝𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴌𐴟𐴄𐴞 𐴀𐴝𐴏𐴠𐴤.<verse eid="JHN 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴇𐴡𐴥𐴕 𐴊𐴡𐴥𐴙𐴅𐴧𐴡 𐴊𐴠 𐴈𐴠𐴥𐴕𐴃𐴟 𐴇𐴡𐴦𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴏𐴢 𐴀𐴝𐴕𐴡𐴤.“</char> <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />𐴃𐴡𐴥𐴘 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴠 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴎𐴝𐴓𐴢 𐴓𐴝𐴕 𐴄𐴝𐴕𐴞 𐴑𐴟𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. 𐴎𐴝𐴓𐴢 𐴓𐴝𐴕 𐴀𐴠𐴑 𐴐𐴡𐴥𐴀 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢 𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴋𐴡𐴣𐴀𐴌 𐴔𐴝𐴏𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥𐴊𐴟𐴕 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴎𐴝𐴓𐴢 𐴓𐴝𐴕 𐴕𐴡𐴥 𐴉𐴝𐴥𐴍𐴠. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴘𐴧𐴡𐴤, 𐴈𐴝𐴥𐴕𐴝 𐴈𐴡𐴥𐴀𐴒𐴝𐴘.“</char> 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴃𐴧𐴟 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴠 𐴕𐴡𐴥 𐴊𐴠𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, ”𐴃𐴟𐴀𐴛 𐴇𐴡𐴕؟“ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝 𐴔𐴝𐴓𐴞𐴑 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴙𐴕𐴃𐴡. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴀𐴘𐴢, 𐴌𐴟𐴄𐴞 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴔𐴝𐴏𐴢 𐴀𐴡𐴥 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥𐴎𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴊𐴝𐴈𐴝𐴤 𐴊𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴠𐴁𐴝𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌.<verse eid="JHN 21:14" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴃𐴡𐴌</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴕𐴠𐴥؟“</char></para>
  <para style="p" vid="JHN 21:15">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥𐴘, 𐴔𐴝𐴓𐴞𐴑; 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴝𐴊𐴡𐴌 𐴒𐴡𐴌𐴞𐴥.“</para>
  <para style="p" vid="JHN 21:15">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴒𐴟𐴥𐴕 𐴏𐴡𐴌𐴝.“</char><verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴕𐴠𐴥؟“</char></para>
  <para style="p" vid="JHN 21:16">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥𐴘, 𐴔𐴝𐴓𐴞𐴑; 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴝𐴊𐴡𐴌 𐴒𐴡𐴌𐴞𐴥.“</para>
  <para style="p" vid="JHN 21:16">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴓𐴟𐴕𐴡𐴌𐴠 𐴏𐴝𐴀𐴏𐴞𐴃𐴝 𐴒𐴡𐴥𐴌.“</char><verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴊𐴡𐴌 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴕𐴠𐴥؟“</char></para>
  <para style="p" vid="JHN 21:17">𐴉𐴞𐴃𐴡𐴌 𐴀𐴠𐴁𐴝𐴌 𐴒𐴟𐴐𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴡𐴥 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴊𐴡𐴌 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴕𐴠𐴥؟“</char> 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴝𐴕𐴡; 𐴃𐴟𐴀𐴛 𐴎𐴝𐴕𐴡 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴝𐴊𐴡𐴌 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠.“</para>
  <para style="p" vid="JHN 21:17">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴓𐴟𐴕 𐴏𐴡𐴌𐴝.</char> <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴘 𐴅𐴟𐴖𐴝𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴞, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴡 𐴃𐴟𐴘 𐴕𐴞𐴎𐴡𐴌 𐴑𐴠𐴣𐴙𐴓𐴢 𐴁𐴝𐴣𐴊𐴞𐴥 𐴎𐴠𐴍𐴠𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘𐴃𐴞; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴘 𐴁𐴟𐴌𐴝𐴤 𐴀𐴡𐴥𐴘𐴁𐴞, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴘 𐴃𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴄𐴝𐴕𐴞 𐴊𐴞𐴁𐴞, 𐴀𐴝𐴦𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴠 𐴃𐴡𐴌 𐴑𐴠𐴣𐴙𐴓𐴢 𐴁𐴝𐴣𐴊𐴞𐴥 𐴃𐴡𐴌𐴃𐴧𐴟 𐴎𐴠𐴍𐴠𐴥 𐴔𐴡𐴕𐴠 𐴕𐴡 𐴈𐴡𐴀 𐴇𐴠𐴥𐴍𐴠 𐴃𐴡𐴌𐴠𐴥 𐴓𐴡𐴘𐴎𐴝𐴘𐴁𐴡𐴥.“</char> <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴉𐴞𐴃𐴡𐴌 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴦𐴃𐴠 𐴔𐴡𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴟𐴎𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴠𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴣𐴊𐴠-𐴉𐴟𐴣𐴊𐴠 𐴀𐴝𐴘.“</char><verse eid="JHN 21:19" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴐𐴝𐴥𐴌𐴞𐴃𐴢</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴉𐴞𐴏𐴧𐴝𐴥 𐴉𐴞𐴥𐴌𐴞 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝 𐴉𐴟𐴣𐴊𐴠-𐴉𐴟𐴣𐴊𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴁𐴝𐴐𐴧𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴝𐴦𐴃𐴢 𐴀𐴠𐴥𐴓𐴝𐴕𐴊𐴞 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕؟“ <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴁𐴝𐴤𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴡؟“<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴞𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴁𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡𐴌 𐴓𐴡𐴘 𐴑𐴞𐴦 𐴁𐴝𐴎𐴝𐴥؟ 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴣𐴊𐴠-𐴉𐴟𐴣𐴊𐴠 𐴀𐴝𐴘.“</char> <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠, 𐴇𐴠𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝 𐴕𐴡 𐴔𐴡𐴌𐴞𐴁𐴡𐴥. 𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴡 𐴔𐴡𐴌𐴞𐴁𐴡𐴥 𐴁𐴡𐴥𐴓𐴞 𐴕𐴡𐴥 𐴈𐴡𐴀, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴞𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴁𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡𐴌 𐴓𐴡𐴘 𐴑𐴞𐴦 𐴁𐴝𐴎𐴝𐴥؟“</char><verse eid="JHN 21:23" /></para>
  <para style="s1">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴒𐴡𐴁𐴝𐴤</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />𐴇𐴠𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴁𐴝𐴤 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠𐴊𐴟𐴥𐴕 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴀𐴕 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴡𐴁𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴡𐴊𐴞 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕-𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴡𐴥𐴌𐴞 𐴓𐴠𐴑𐴝𐴥 𐴎𐴝𐴘𐴃𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴔𐴡𐴎𐴞𐴕، 𐴀𐴡𐴊𐴟𐴥𐴕 𐴑𐴞𐴃𐴝𐴁𐴢 𐴓𐴠𐴑𐴝𐴥 𐴎𐴝𐴘𐴃𐴡, 𐴎𐴞𐴀𐴕 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴟 𐴀𐴝𐴣𐴍𐴞𐴃𐴡𐴤.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>