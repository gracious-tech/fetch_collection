<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴔𐴝𐴌𐴑𐴟𐴏𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴝𐴌𐴑𐴟𐴏𐴢</para>
  <para style="toc2">𐴔𐴝𐴌𐴑𐴟𐴏𐴢</para>
  <para style="toc3">𐴔𐴝𐴑</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴔𐴝𐴌𐴑𐴟𐴏𐴢</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴝𐴌𐴑𐴟𐴏𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴝𐴌𐴑𐴟𐴏𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴞𐴥𐴘𐴝𐴌𐴝, 𐴎𐴞𐴁𐴝𐴤𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞, 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴉𐴡𐴀𐴘𐴓𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌𐴠 ”𐴀𐴞𐴕𐴅𐴞𐴓𐴢“ 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 ”𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌“ 𐴘𐴝𐴥𐴕𐴞 ”𐴒𐴡𐴔 𐴈𐴡𐴥𐴁𐴡𐴌.“ 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴀𐴞𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴞 𐴁𐴝𐴦𐴊𐴠 𐴔𐴡𐴃𐴞, 𐴔𐴝𐴌𐴑𐴟𐴏𐴢, 𐴓𐴟𐴑𐴝𐴥𐴏𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴝𐴌𐴑𐴟𐴏𐴢 𐴘𐴞𐴁𐴝𐴤 𐴀𐴝𐴌 𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴁𐴝𐴍𐴞𐴥 𐴀𐴝𐴦𐴌 𐴘𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴀𐴝𐴒𐴠 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴇𐴝𐴥𐴙𐴄𐴢-𐴉𐴝𐴣𐴏𐴡𐴃𐴧𐴟 𐴇𐴡𐴥𐴙𐴃𐴧𐴡𐴌 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴞 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴁𐴡𐴥𐴓𐴞 𐴔𐴝𐴕𐴞𐴓𐴡𐴘𐴧𐴠𐴥. 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴟𐴓𐴠𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴝𐴌𐴑𐴟𐴏𐴢 𐴘𐴞𐴁𐴝𐴤 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴊𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴓𐴡𐴥𐴘 𐴇𐴠𐴥𐴍𐴠 𐴌𐴡𐴔𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴠𐴥.</para>
  <para style="ip">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴁𐴝𐴤𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴌𐴑𐴟𐴏𐴢, 𐴎𐴝𐴌𐴠𐴥 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴔𐴝𐴌𐴑𐴟𐴏𐴢 𐴕𐴝𐴔𐴠 𐴘𐴡𐴥 𐴎𐴝𐴕𐴝 𐴎𐴝, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴌𐴕𐴝𐴁𐴝𐴏𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴝𐴌𐴝𐴥𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴡𐴌 𐴈𐴝𐴔𐴡𐴌 𐴏𐴡𐴉𐴡𐴥𐴌 𐴀𐴠𐴌𐴞𐴊𐴞𐴘𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴕𐴝𐴔 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 (<char style="xt"><ref loc="ACT 13:13">𐴈𐴝𐴔𐴡𐴥𐴓𐴢 13‏:13</ref></char>). 𐴉𐴞𐴏𐴡𐴥𐴃𐴧𐴟 𐴔𐴝𐴌𐴑𐴟𐴏𐴠 𐴀𐴝𐴁𐴝𐴌 𐴁𐴝𐴥𐴌𐴕𐴝𐴁𐴝𐴏𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥 (<char style="xt"><ref loc="ACT 15:37-39">𐴈𐴝𐴔𐴡𐴥𐴓𐴢 15‏:37‏-39</ref></char>). 𐴔𐴝𐴌𐴑𐴟𐴏𐴢 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴥𐴃𐴞𐴓𐴧𐴝 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴝 𐴎𐴝 (<char style="xt"><ref loc="1PE 5:13">1 𐴉𐴞𐴃𐴡𐴌 5‏:13</ref></char>). 𐴔𐴝𐴌𐴑𐴟𐴏𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴑𐴊𐴝𐴈𐴝𐴤 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠 𐴕𐴡 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴟𐴓𐴠𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴔𐴝𐴌𐴑𐴟𐴏𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴊𐴞𐴘𐴝 𐴒𐴡𐴁𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴞𐴐𐴞𐴤 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴌𐴑𐴟𐴏𐴡𐴌 𐴓𐴠𐴑𐴝𐴥𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴔𐴟𐴓𐴢. 𐴔𐴝𐴌𐴑𐴟𐴏𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴃𐴢 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴁𐴝𐴕𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴡𐴑𐴃𐴡𐴥𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴔𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴃𐴡𐴘𐴧𐴝𐴌𐴞 <char style="ior">(<ref loc="MRK 1:1-13">1‏:1‏-13</ref>)</char></para>
  <para style="io1">2. 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 <char style="ior">(<ref loc="MRK 1:14-7:23">1‏:14‏—7‏:23</ref>)</char></para>
  <para style="io1">3. 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 <char style="ior">(<ref loc="MRK 7:24-10:52">7‏:24‏—10‏:52</ref>)</char></para>
  <para style="io1">4. 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 <char style="ior">(<ref loc="MRK 11-13">11‏—13</ref>)</char></para>
  <para style="io1">5. 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴑-𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴦𐴃𐴢 <char style="ior">(<ref loc="MRK 14-15">14‏—15</ref>)</char></para>
  <para style="io1">6. 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝 <char style="ior">(<ref loc="MRK 16">16</ref>)</char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑</para>
  <para style="r">(<ref loc="MAT 3:1-12">𐴔𐴡𐴃𐴢 3‏:1‏-12</ref>; <ref loc="LUK 3:1-9">𐴓𐴟𐴑 3‏:1‏-9</ref>‏,<ref loc="LUK 3:15-17">15‏-17</ref>; <ref loc="JHN 1:19-28">𐴘𐴡 1‏:19‏-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌<note caller="+" style="f"><char style="fr" closed="false">1‏:1 </char><char style="fq">𐴔𐴡𐴀𐴏𐴞𐴤</char> <char style="ft" closed="false">𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴞𐴌𐴞𐴥𐴑 𐴓𐴡𐴉𐴎𐴡𐴥 𐴀𐴝𐴦𐴌 𐴇𐴞𐴁𐴌𐴟𐴤 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴔𐴠𐴏𐴝𐴥𐴘𐴧𐴝 𐴈𐴡𐴀, 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴖𐴝</char></note> 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌, <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴌 𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤:</para>
  <para style="q1" vid="MRK 1:2">”𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴥𐴁𐴡𐴌𐴒𐴗𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴒𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌,</para>
  <para style="q2" vid="MRK 1:2">𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴡𐴣𐴃𐴢 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">1‏:2 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAL 3:1">𐴔𐴝𐴓𐴝𐴑𐴞𐴥 3‏:1</ref></char></char></note><verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />”𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌,</para>
  <para style="q1" vid="MRK 1:3">’𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴉𐴡𐴣𐴃𐴢 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴡𐴤;</para>
  <para style="q2" vid="MRK 1:3">𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴏𐴃𐴝 𐴀𐴟𐴎𐴟 𐴒𐴡𐴌𐴡𐴤.‘ “<note caller="+" style="f"><char style="fr" closed="false">1‏:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 40‏:3</ref></char></char></note><verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴀𐴝𐴀𐴘𐴢 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴠, 𐴒𐴟𐴕𐴝𐴤𐴌 𐴔𐴝𐴉𐴢 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴃𐴡. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />𐴉𐴟𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴊𐴧𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴠𐴦𐴓𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴧𐴠𐴥. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴀𐴟𐴣𐴄𐴡𐴌 𐴑𐴠𐴣𐴐𐴢 𐴓𐴡𐴘 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴇𐴡𐴦𐴌 𐴉𐴞𐴣𐴊𐴞𐴥𐴃𐴡, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴑𐴠𐴣𐴙𐴓𐴡𐴃𐴢 𐴏𐴝𐴔𐴝𐴌𐴝𐴌 𐴊𐴟𐴖𐴝𐴓𐴞 𐴁𐴝𐴙𐴕𐴊𐴝𐴤 𐴃𐴝𐴥𐴑𐴞𐴃𐴡. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴝𐴥𐴘𐴃𐴡 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴞𐴥𐴌𐴞𐴚 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴦𐴣𐴓𐴡𐴌 𐴔𐴡𐴊𐴟𐴥. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, ”𐴀𐴝𐴀𐴛 𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴀𐴕 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴃𐴡𐴑𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌. 𐴀𐴝𐴀𐴛 𐴕𐴞𐴘𐴟𐴥𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴠𐴕𐴄𐴝𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴃𐴝 𐴑𐴟𐴥𐴓𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />𐴀𐴝𐴀𐴛 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴀𐴠𐴥𐴕𐴝 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴓𐴡𐴥𐴘 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴁𐴡.“<verse eid="MRK 1:8" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝</para>
  <para style="r">(<ref loc="MAT 3:13-17">𐴔𐴡𐴃𐴢 3‏:13‏-17</ref>; <ref loc="LUK 3:21-22">𐴓𐴟𐴑 3‏:21‏-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴉𐴝𐴌𐴝 𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴃𐴧𐴟 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴧𐴠𐴥. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />𐴀𐴞𐴏𐴝𐴤 𐴉𐴝𐴕𐴞𐴥𐴃𐴧𐴟 𐴑𐴟𐴓𐴡𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴝𐴘 𐴔𐴡𐴃𐴧𐴡𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴀𐴝𐴏𐴔𐴝𐴕 𐴑𐴟𐴥𐴓𐴞𐴎𐴝𐴌𐴒𐴡𐴘 𐴀𐴝𐴦𐴌 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴈𐴡𐴘𐴃𐴡𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴓𐴝𐴔𐴠𐴌. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴖𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞.“<verse eid="MRK 1:11" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 4:1-11">𐴔𐴡𐴃𐴢 4‏:1‏-11</ref>; <ref loc="LUK 4:1-13">𐴓𐴟𐴑 4‏:1‏-13</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴞𐴘𐴠. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴠 𐴏𐴝𐴓𐴞𐴐𐴢 𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴁𐴝 𐴅𐴡𐴚𐴒𐴡𐴓𐴞 𐴅𐴝𐴕𐴟𐴖𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴀𐴝𐴦𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.<verse eid="MRK 1:13" /></para>
  <para style="s1">𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴈𐴝𐴔𐴡𐴌 𐴐𐴟𐴥𐴌𐴟</para>
  <para style="r">(<ref loc="MAT 4:12-17">𐴔𐴡𐴃𐴢 4‏:12‏-17</ref>; <ref loc="LUK 4:14-15">𐴓𐴟𐴑 4‏:14‏-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴞𐴥 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢, <char style="wj">”𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴡𐴤 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌𐴠 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴌𐴡𐴤.“</char><verse eid="MRK 1:15" /></para>
  <para style="s1">𐴐𐴟𐴥𐴌𐴟𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 4:18-22">𐴔𐴡𐴃𐴢 4‏:18‏-22</ref>; <ref loc="LUK 5:1-11">𐴓𐴟𐴑 5‏:1‏-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />𐴀𐴞𐴏𐴝𐴤 𐴒𐴝𐴓𐴞𐴓𐴢 𐴋𐴞𐴀𐴌 𐴇𐴝𐴣𐴏𐴝 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴥𐴘 𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴡𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴞𐴀𐴃𐴢 𐴎𐴝𐴓𐴢 𐴔𐴝𐴌𐴠𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴙𐴓𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴡𐴥𐴌𐴠 𐴊𐴠 𐴎𐴝𐴙𐴓𐴧𐴝 𐴁𐴝𐴕𐴝𐴘𐴧𐴟𐴥𐴔.“</char> <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴝𐴓𐴢 𐴓𐴟𐴕 𐴀𐴠𐴌𐴞, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />𐴇𐴞𐴥𐴘𐴝𐴕𐴃𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴒𐴡𐴌𐴞 𐴒𐴞𐴦𐴘𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌 𐴉𐴟𐴖𐴝 𐴘𐴝𐴑𐴟𐴁𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴥𐴘 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴡𐴦𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴓𐴢 𐴄𐴟𐴕𐴠𐴌. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴥𐴇𐴡𐴕 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥, 𐴃𐴡𐴥𐴘 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴢 𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌𐴠 𐴕𐴡𐴦𐴃𐴢 𐴔𐴟𐴎𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴠𐴌𐴞, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 1:20" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢</para>
  <para style="r">(<ref loc="LUK 4:31-37">𐴓𐴟𐴑 4‏:31‏-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴌𐴝𐴥𐴌 𐴀𐴞𐴏𐴝𐴤 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴎𐴝𐴘 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴠 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴃𐴡 𐴊𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴀𐴡𐴓𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞, 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴕𐴡. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴀𐴠𐴎𐴧𐴡𐴕 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />”𐴀𐴡𐴥 𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴏𐴝𐴥𐴌𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴞𐴦 𐴈𐴝𐴔 𐴀𐴝𐴏𐴠𐴤؟ 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴡𐴥 𐴊𐴠 𐴕𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴃𐴟𐴀𐴛 𐴇𐴡𐴕, 𐴃𐴟𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑𐴎𐴡𐴕 𐴕𐴗𐴝𐴥.“<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥𐴌𐴠 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴞𐴎𐴝𐴥𐴔 𐴀𐴡𐴥, 𐴘𐴡𐴒𐴧𐴗𐴝𐴥𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴎𐴝𐴒𐴡𐴥𐴘.“</char> <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />𐴃𐴡𐴥𐴘 𐴇𐴠𐴥 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴟𐴏𐴡𐴌𐴞 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴒𐴟𐴎𐴡𐴌𐴝𐴕 𐴔𐴝𐴌𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴀𐴕 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴝𐴀𐴕 𐴑𐴞𐴦؟ 𐴘𐴝𐴀𐴕 𐴃𐴡 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴘𐴝 𐴃𐴝𐴦𐴓𐴞𐴔! 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴠𐴥 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴝𐴕𐴠!“ <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘.<verse eid="MRK 1:28" /></para>
  <para style="s1">𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 8:14-17">𐴔𐴡𐴃𐴢 8‏:14‏-17</ref>; <ref loc="LUK 4:38-41">𐴓𐴟𐴑 4‏:38‏-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴔𐴡𐴃𐴧𐴡𐴌, 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌 𐴇𐴡𐴥𐴖𐴌𐴞 𐴒𐴝𐴦𐴃𐴎𐴡𐴌𐴠 𐴁𐴞𐴏𐴝𐴥𐴕𐴝𐴃𐴢 𐴉𐴡𐴌𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />𐴀𐴞𐴥𐴁𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴡𐴥𐴌𐴞 𐴃𐴟𐴙𐴓𐴧𐴞𐴥𐴓𐴢, 𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴒𐴝𐴦𐴃𐴎𐴡𐴌 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴠𐴀𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />𐴇𐴝𐴥𐴣𐴎𐴞𐴕𐴧𐴝 𐴁𐴠𐴙𐴓𐴢 𐴒𐴡𐴥𐴓𐴞 𐴁𐴝𐴦𐴊𐴠, 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴝𐴙𐴕𐴧𐴞𐴤𐴓𐴢. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />𐴀𐴝𐴦𐴌 𐴒𐴟𐴣𐴍𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴟𐴖𐴝𐴌𐴡𐴌 𐴒𐴟𐴌𐴝𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴀𐴙𐴓𐴢. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴁𐴞𐴘𐴝𐴌𐴝𐴔𐴠 𐴊𐴟𐴑 𐴉𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴥𐴉𐴝𐴘𐴧𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴃𐴞𐴃𐴡𐴥 𐴕𐴡 𐴊𐴞𐴃𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕 𐴊𐴠 𐴏𐴞𐴕𐴞𐴥𐴃𐴡.<verse eid="MRK 1:34" /></para>
  <para style="s1">𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑</para>
  <para style="r">(<ref loc="LUK 4:42-44">𐴓𐴟𐴑 4‏:42‏-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />𐴁𐴝𐴦𐴊𐴠 𐴁𐴞𐴀𐴕𐴧𐴝 𐴑𐴟𐴥𐴁𐴢 𐴏𐴡𐴥𐴀𐴌𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴃𐴝𐴥𐴑𐴞𐴃𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴀𐴟𐴍𐴞𐴤 𐴒𐴡𐴥𐴌𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴡𐴐𐴡𐴥𐴃𐴞-𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴒𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴖𐴝𐴘𐴃𐴡𐴥 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴖𐴝𐴘 𐴉𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴠𐴥𐴌.“<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴝𐴌𐴝𐴃𐴢 𐴎𐴝𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥𐴍𐴠 𐴘𐴡𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴠 𐴕𐴠𐴦𐴙𐴓𐴧𐴞𐴥.“</char> <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴎𐴝𐴘-𐴎𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴥𐴉𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MRK 1:39" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 8:1-4">𐴔𐴡𐴃𐴢 8‏:1‏-4</ref>; <ref loc="LUK 5:12-16">𐴓𐴟𐴑 5‏:12‏-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />𐴀𐴠𐴎𐴧𐴡𐴕 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴏𐴝𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.“<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴠𐴄𐴉𐴟𐴌𐴞 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴁𐴝𐴌𐴝𐴤𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴡𐴥𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢; 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴡𐴘.“</char> <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />𐴃𐴡𐴥𐴘 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴡𐴌𐴡𐴤𐴒𐴡𐴌𐴞 𐴕𐴞𐴐𐴡𐴥𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞𐴘𐴠𐴥, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴏𐴝𐴘𐴧𐴡𐴥, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴎𐴝𐴕𐴝𐴘𐴧𐴡𐴥; 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴡𐴦, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴝𐴈𐴡𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴧𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴁𐴝𐴤 𐴀𐴡𐴥 𐴉𐴝𐴕, 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴡𐴒𐴡𐴥𐴘.“</char> <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />𐴓𐴠𐴑𐴞𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴝𐴀𐴌𐴠 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴎𐴝𐴕𐴝𐴘-𐴎𐴝𐴕𐴝𐴘 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴇𐴠𐴥 𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴡𐴥𐴓𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴠𐴊𐴧𐴟𐴥𐴌 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴏𐴝𐴤 𐴇𐴡𐴕𐴡𐴤 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴌 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴒𐴡𐴥𐴓𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴡𐴐𐴡𐴥𐴃𐴞-𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴒𐴝𐴃𐴢 𐴎𐴝𐴘 𐴃𐴝𐴥𐴑𐴝 𐴉𐴡𐴙𐴅𐴧𐴠𐴥. 𐴃𐴡𐴀 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝𐴃𐴧𐴟 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴃𐴡𐴤.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴣𐴃𐴟𐴌𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 9:1-8">𐴔𐴡𐴃𐴢 9‏:1‏-8</ref>; <ref loc="LUK 5:17-26">𐴓𐴟𐴑 5‏:17‏-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />𐴇𐴡𐴦𐴊𐴧𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴉𐴟𐴥𐴕𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴒𐴡𐴥𐴌 𐴒𐴝𐴥𐴕 𐴒𐴟𐴣𐴍𐴝 𐴁𐴡𐴥𐴌𐴞 𐴊𐴟𐴖𐴝𐴌𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴝𐴌 𐴎𐴝𐴒𐴝 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴝𐴓𐴝𐴔 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴑 𐴀𐴝𐴣𐴃𐴟𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴏𐴝𐴙𐴌 𐴎𐴡𐴕𐴡𐴌 𐴀𐴝𐴥𐴃𐴝 𐴁𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴎𐴝𐴔𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴎𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠𐴌, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴎𐴟-𐴀𐴟𐴎𐴟 𐴖𐴡𐴃𐴧𐴟𐴥 𐴏𐴝𐴥𐴊𐴡𐴌 𐴄𐴝𐴓𐴞 𐴓𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴈𐴝𐴕𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴝𐴣𐴃𐴟𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴕𐴠𐴙𐴄𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴖𐴝 𐴓𐴝𐴔𐴝𐴘𐴊𐴞𐴘𐴠𐴥. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴣𐴃𐴟𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡 𐴉𐴟𐴃𐴢, 𐴃𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠.“</char><verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴀𐴝𐴓𐴠𐴔 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴁𐴝𐴥𐴉𐴠𐴌 𐴊𐴠, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴃𐴝𐴤 𐴑𐴞𐴘𐴝𐴥 𐴈𐴡𐴀𐴌؟ 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴡 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴠𐴥𐴌! 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴊𐴠 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴝𐴌𐴡𐴘𐴝 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟“<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴌𐴟𐴀𐴃𐴢 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴝𐴥𐴉𐴠𐴌. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴇𐴞𐴥𐴀𐴕 𐴑𐴞𐴘𐴝𐴥 𐴁𐴝𐴥𐴉𐴡𐴌؟</char> <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" /><char style="wj">𐴀𐴠 𐴀𐴝𐴣𐴃𐴟𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴘𐴃𐴠𐴤 𐴇𐴡𐴕 𐴕𐴝𐴥𐴕 𐴀𐴝𐴏𐴝𐴤𐴕, 𐴑𐴞 ’𐴃𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠,‘ 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞, ’𐴀𐴟𐴄𐴢, 𐴃𐴡𐴌 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴥𐴣𐴄𐴢؟‘</char> <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤.“</char> 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴃𐴟𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" /><char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴟𐴄𐴢, 𐴃𐴡𐴌 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴦𐴒𐴡𐴥𐴘.“</char> <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴟𐴙𐴄𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴖𐴝 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴝𐴌𐴁𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡𐴥 𐴊𐴠𐴑𐴞𐴥!“<verse eid="MRK 2:12" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴓𐴠𐴀𐴜𐴞𐴌𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 9:9-13">𐴔𐴡𐴃𐴢 9‏:9‏-13</ref>; <ref loc="LUK 5:27-32">𐴓𐴟𐴑 5‏:27‏-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴁𐴝𐴌 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴞 𐴋𐴞𐴀𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />𐴀𐴞𐴥𐴁𐴝 𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴀𐴝𐴓𐴉𐴝𐴥𐴘𐴧𐴝𐴏𐴡𐴌 𐴉𐴟𐴖𐴝 𐴓𐴠𐴀𐴜𐴞 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴃𐴟𐴓𐴠𐴥 𐴊𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌𐴡.“</char> 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴓𐴠𐴀𐴜𐴞𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴌, 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴌𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />𐴉𐴠𐴥𐴌𐴡𐴐𐴞𐴌 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴞𐴘𐴝𐴥 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀؟“<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴃𐴡 𐴋𐴝𐴑𐴄𐴡𐴌 𐴕𐴡 𐴓𐴝𐴒𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴠 𐴓𐴝𐴒𐴠. 𐴀𐴝𐴀𐴛 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠.“ </char><verse eid="MRK 2:17" /></para>
  <para style="s1">𐴌𐴟𐴎𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 9:14-17">𐴔𐴡𐴃𐴢 9‏:14‏-17</ref>; <ref loc="LUK 5:33-39">𐴓𐴟𐴑 5‏:33‏-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />𐴀𐴠𐴑𐴁𐴝𐴌, 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴌𐴟𐴎𐴝 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴡 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴑𐴞𐴘𐴝𐴥 𐴌𐴟𐴎𐴝 𐴕𐴡 𐴌𐴝𐴑𐴠𐴥؟“<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴊𐴟𐴓𐴝𐴤 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴑𐴞𐴥 𐴁𐴡𐴘𐴌𐴝𐴙𐴃𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴞𐴥 𐴉𐴝𐴌𐴠؟ 𐴎𐴠𐴃𐴡𐴥 𐴊𐴞𐴕 𐴊𐴟𐴓𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴇𐴠𐴥𐴃𐴡𐴊𐴞𐴕 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴀𐴕 𐴊𐴞𐴕 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴟𐴓𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴡𐴕𐴠 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴞𐴥𐴁𐴡.</char><verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />
    <char style="wj">”𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴡 𐴉𐴟𐴌𐴝𐴕 𐴉𐴟𐴐𐴝𐴥𐴑𐴡𐴃𐴢 𐴕𐴡𐴘𐴝 𐴇𐴡𐴦𐴌 𐴃𐴝𐴓𐴞 𐴊𐴠𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴎𐴡𐴊𐴞 𐴊𐴞𐴓𐴠𐴥 𐴃𐴡 𐴈𐴠𐴥𐴕𐴃𐴟 𐴕𐴡𐴘𐴝 𐴒𐴝𐴥𐴕 𐴎𐴡𐴥𐴌𐴞𐴎𐴝𐴘𐴁𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴥𐴍𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴌𐴡𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.</char> <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡𐴘𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴕 𐴏𐴝𐴔𐴝𐴌𐴝𐴌 𐴇𐴡𐴥𐴙𐴓𐴧𐴝𐴃𐴢 𐴌𐴝𐴑𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘; 𐴎𐴡𐴊𐴞 𐴌𐴝𐴑𐴞𐴥𐴓𐴠 𐴃𐴡 𐴕𐴡𐴘𐴝 𐴌𐴡𐴐𐴧𐴟𐴥𐴕𐴠 𐴇𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴟𐴥𐴕 𐴉𐴝𐴥𐴍𐴞𐴉𐴠𐴓𐴝𐴘𐴁𐴡, 𐴃𐴡𐴥𐴘 𐴌𐴡𐴐𐴢 𐴀𐴡𐴥 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴎𐴝𐴘𐴁𐴡𐴘 𐴀𐴝𐴦𐴌 𐴇𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴟𐴥𐴕 𐴀𐴡𐴥 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴎𐴝𐴘𐴁𐴡𐴘. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴕𐴡𐴘𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴡𐴌𐴠 𐴕𐴡𐴘𐴝 𐴏𐴝𐴔𐴝𐴌𐴝𐴌 𐴇𐴡𐴥𐴙𐴓𐴧𐴝𐴃𐴢 𐴌𐴝𐴑𐴝𐴤 𐴉𐴡𐴌𐴠.“</char><verse eid="MRK 2:22" /></para>
  <para style="s1">𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴒𐴞𐴣𐴘𐴟𐴌 𐴃𐴟𐴥𐴌 𐴃𐴟𐴓𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 12:1-8">𐴔𐴡𐴃𐴢 12‏:1‏-8</ref>; <ref loc="LUK 6:1-5">𐴓𐴟𐴑 6‏:1‏-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />𐴀𐴠𐴑𐴁𐴝𐴌 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴀𐴞𐴏𐴝𐴤 𐴒𐴞𐴣𐴘𐴟𐴌 𐴑𐴟𐴣𐴍𐴝𐴤 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦𐴌, 𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴒𐴞𐴣𐴘𐴟𐴌 𐴃𐴟𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴓𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴕𐴝𐴥, 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴠𐴥𐴌؟“<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴘𐴝𐴀𐴕 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡𐴥 𐴉𐴡𐴌𐴡𐴥, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴝𐴖𐴟𐴊𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴥𐴑 𐴓𐴝𐴙𐴒𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴦 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠؟</char> <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" /><char style="wj">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔 𐴀𐴝𐴁𐴞𐴘𐴡𐴥𐴃𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴌𐴟𐴄𐴞 𐴈𐴝𐴥𐴀𐴙𐴓𐴢, 𐴎𐴞𐴀𐴕 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴕𐴝𐴥𐴘. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴡𐴥 𐴊𐴞𐴀𐴓𐴢.“</char><verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕𐴡𐴓𐴧𐴝 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡.</char> <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" /><char style="wj">𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕𐴡𐴌 𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑.“</char><verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴉𐴟𐴥𐴖𐴝𐴕𐴝 𐴀𐴝𐴥𐴃𐴢 𐴀𐴡𐴓𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢</para>
  <para style="r">(<ref loc="MAT 12:9-14">𐴔𐴡𐴃𐴢 12‏:9‏-14</ref>; <ref loc="LUK 6:6-11">𐴓𐴟𐴑 6‏:6‏-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴑𐴁𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠; 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴝𐴌 𐴀𐴝𐴥𐴃𐴢 𐴉𐴟𐴥𐴖𐴝𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴠𐴥 𐴕𐴠𐴥 𐴈𐴝𐴥𐴀𐴏𐴢 𐴕𐴡𐴎𐴡𐴌 𐴊𐴞 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥 𐴉𐴝𐴌𐴠. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴥𐴃𐴢 𐴉𐴟𐴥𐴖𐴝𐴕𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴟𐴍𐴞𐴤 𐴀𐴠𐴍𐴠𐴥 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴘𐴧𐴡𐴤.“</char><verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴝𐴘𐴠𐴏𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌؟ 𐴉𐴡𐴌𐴝𐴕 𐴁𐴝𐴏𐴝𐴘𐴁𐴝𐴥𐴌 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌؟“</char> 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴝𐴥𐴔 𐴔𐴝𐴥𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴝𐴘𐴌𐴡𐴥𐴔𐴞𐴑𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴟𐴎𐴟 𐴒𐴟𐴐𐴧𐴝𐴤𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴏𐴝𐴀𐴘𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴊𐴡𐴌𐴡𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴁𐴞𐴐𐴞𐴤 𐴊𐴟𐴑 𐴓𐴝𐴒𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴥𐴃𐴧𐴝𐴕 𐴁𐴝𐴌𐴡𐴥.“</char> 𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴌𐴝𐴤𐴘𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴥𐴃𐴧𐴝𐴕 𐴀𐴝𐴒𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴀𐴌𐴠 𐴎𐴝𐴘 𐴈𐴠𐴥𐴌𐴟𐴊𐴞𐴀𐴡𐴥𐴓𐴢 𐴓𐴡𐴥𐴘 𐴏𐴡𐴥𐴓𐴧𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠𐴒𐴡𐴘 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴞𐴦 𐴁𐴡𐴃𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.<verse eid="MRK 3:6" /></para>
  <para style="s1">𐴋𐴞𐴀𐴌 𐴋𐴝𐴥𐴑𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢 𐴋𐴞𐴀𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴞𐴓𐴢; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴝𐴓𐴞𐴓𐴢 𐴀𐴡𐴃𐴧𐴟, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴃𐴧𐴟, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴀𐴡𐴃𐴧𐴟, 𐴀𐴞𐴊𐴟𐴔𐴝𐴘𐴝 𐴃𐴧𐴟, 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴌 𐴉𐴝𐴌𐴑𐴟𐴓𐴢 𐴀𐴡𐴃𐴧𐴟, 𐴄𐴝𐴘𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴥𐴊𐴡𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝 𐴃𐴧𐴟. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴟𐴥𐴕𐴞 𐴁𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴓𐴗𐴝𐴥𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴟𐴌𐴝 𐴕𐴡𐴦 𐴎𐴟𐴦 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴞𐴥𐴃𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴁𐴝𐴏𐴞𐴂𐴧𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴄𐴠𐴥𐴓𐴝𐴄𐴠𐴓𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />𐴀𐴝𐴦𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥𐴃𐴡, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴔𐴠𐴍𐴞𐴃𐴢 𐴉𐴡𐴌𐴞 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴘𐴃𐴡𐴤 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝.“ <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴕𐴞𐴐𐴡𐴥𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.<verse eid="MRK 3:12" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 10:1-4">𐴔𐴡𐴃𐴢 10‏:1‏-4</ref>; <ref loc="LUK 6:12-16">𐴓𐴟𐴑 6‏:12‏-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴡𐴘, 𐴁𐴝𐴦𐴊𐴠 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴎𐴝𐴌𐴠𐴥-𐴎𐴝𐴌𐴠𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴧𐴠𐴥 𐴃𐴝𐴌𐴠𐴥-𐴃𐴝𐴌𐴠𐴥 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕𐴡𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴉𐴝𐴌𐴠, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴟𐴥𐴃𐴢 𐴊𐴝𐴥𐴉𐴝𐴘𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴃𐴝𐴥𐴑𐴠. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />𐴇𐴠𐴥 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠: 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴎𐴝𐴌𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴃𐴡𐴌 𐴕𐴝𐴔 𐴊𐴞𐴘𐴠𐴥; <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌 𐴉𐴟𐴖𐴝 𐴘𐴝𐴑𐴟𐴁𐴢, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴥𐴘 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴝𐴔 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠 𐴁𐴡𐴖𐴝𐴕𐴠𐴌𐴒𐴞𐴏𐴢, 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, ”𐴄𐴝𐴥𐴍𐴝𐴓𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕“; <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴢, 𐴉𐴞𐴓𐴞𐴥𐴂𐴢, 𐴁𐴝𐴌𐴃𐴡𐴥𐴓𐴡𐴔𐴞𐴘𐴡, 𐴔𐴡𐴃𐴞, 𐴃𐴡𐴥𐴔𐴝𐴏𐴢, 𐴀𐴝𐴓𐴉𐴝𐴥𐴘𐴧𐴝𐴏𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴝𐴑𐴟𐴁𐴢, 𐴃𐴝𐴥𐴀𐴊𐴞𐴘𐴝𐴏𐴢, 𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴠𐴥𐴓𐴡𐴃𐴢,<note caller="+" style="f"><char style="fr" closed="false">3‏:18 </char><char style="fq" closed="false">𐴎𐴠𐴥𐴓𐴡𐴃𐴢 </char></note> <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴞𐴏𐴑𐴝𐴥𐴌𐴞𐴘𐴠𐴃𐴢, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴓𐴢.<verse eid="MRK 3:19" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 12:22-32">𐴔𐴡𐴃𐴢 12‏:22‏-32</ref>; <ref loc="LUK 11:14-23">𐴓𐴟𐴑 11‏:14‏-23</ref>; <ref loc="LUK 12:10">12‏:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴑 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴁𐴝𐴌 𐴀𐴡𐴥 𐴀𐴠𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴈𐴝𐴥𐴕𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴇𐴝𐴥𐴘 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴓𐴡𐴘𐴀𐴝𐴕𐴞𐴤 𐴁𐴡𐴓𐴧𐴝 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.“<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />𐴎𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴧𐴟 𐴕𐴞𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴠<note caller="+" style="f"><char style="fr" closed="false">3‏:22 </char><char style="fqa">𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴢</char> <char style="ft" closed="false">𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴀𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴝𐴔 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴞 𐴋𐴝𐴑𐴠.</char></note> 𐴉𐴝𐴘𐴧𐴠𐴥. 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴟𐴥𐴃𐴢 𐴊𐴝𐴥𐴉𐴝 𐴊𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴡𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴠.“<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴊𐴝𐴥𐴉𐴝𐴘 𐴉𐴝𐴌𐴠؟</char> <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" /><char style="wj">𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴎𐴡𐴊𐴞 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴕𐴞𐴎𐴠 𐴀𐴡𐴥𐴘 𐴉𐴝𐴀𐴄𐴢-𐴉𐴝𐴀𐴄𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴞 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴕𐴝𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴠 𐴇𐴡𐴥𐴃𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.</char> <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" /><char style="wj">𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴡𐴓𐴟𐴖𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴓𐴟𐴄𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴒𐴠 𐴁𐴡𐴓𐴟𐴖𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴝𐴣𐴊𐴞𐴥 𐴕𐴡 𐴀𐴠𐴌𐴠. 𐴁𐴝𐴣𐴊𐴞𐴥 𐴀𐴠𐴌𐴞𐴓𐴠𐴥 𐴀𐴠𐴥𐴕𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴡𐴥𐴌 𐴓𐴟𐴄𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.</char><verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴊𐴡𐴔𐴎𐴝𐴃𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴒𐴟𐴕𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡, </char> <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴀𐴟𐴓𐴋𐴝 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴔𐴝𐴉𐴢 𐴕𐴡 𐴉𐴝𐴘𐴁𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴞 𐴒𐴟𐴕𐴝𐴤𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴞𐴁𐴡.“</char><verse eid="MRK 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴠 𐴉𐴝𐴘𐴧𐴠𐴥.“<verse eid="MRK 3:30" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕</para>
  <para style="r">(<ref loc="MAT 12:46-50">𐴔𐴡𐴃𐴢 12‏:46‏-50</ref>; <ref loc="LUK 8:19-21">𐴓𐴟𐴑 8‏:19‏-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴀𐴌𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴃𐴝𐴘𐴃𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴁𐴝𐴀𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴠𐴥𐴌.“<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴦 𐴇𐴡𐴕؟ 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤؟“</char><verse eid="MRK 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥𐴃𐴞𐴘𐴝, 𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕.</char> <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘, 𐴁𐴡𐴥𐴙𐴕, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴦.“</char><verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s1">𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴍𐴡𐴘𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 13:1-9">𐴔𐴡𐴃𐴢 13‏:1‏-9</ref>; <ref loc="LUK 8:4-8">𐴓𐴟𐴑 8‏:4‏-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴁𐴝𐴌 𐴋𐴞𐴀𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴀𐴠𐴃𐴧𐴡𐴥𐴌 𐴊𐴡𐴓𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴁𐴝 𐴋𐴞𐴀𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴁𐴡𐴙𐴐𐴧𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴋𐴞𐴀𐴌 𐴑𐴟𐴓𐴡𐴌 𐴖𐴡𐴌𐴠. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴥 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴐𐴞𐴥𐴑𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" /><char style="wj">”𐴉𐴟𐴥𐴕𐴡, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴍𐴡𐴘𐴝 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴄𐴧𐴡 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥.</char> <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴐𐴞𐴥𐴣𐴍𐴠𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴌𐴝𐴏𐴃𐴝𐴌</char><note caller="+" style="f"><char style="fr" closed="false">4‏:4 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa">𐴀𐴝𐴙𐴓𐴡𐴌 </char></note> <char style="wj">𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴀𐴘𐴢 𐴇𐴞𐴥𐴀𐴕 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠.</char> <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" /><char style="wj">𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴓𐴢 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴍𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴔𐴠𐴍𐴞 𐴕𐴝𐴥𐴘. 𐴔𐴟𐴌 𐴔𐴠𐴍𐴞 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴇𐴝𐴥𐴌𐴝 𐴒𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. </char> <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴠𐴙𐴓𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥 𐴌𐴝𐴥𐴌 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴐𐴞𐴥𐴛𐴡𐴌 𐴕𐴡𐴥 𐴒𐴝𐴏𐴝𐴤 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴖𐴝𐴘𐴒𐴞𐴘𐴡𐴘.</char> <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" /><char style="wj">𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴑𐴠𐴣𐴍𐴝𐴁𐴡𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴑𐴠𐴣𐴍𐴝𐴁𐴡𐴕 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴞𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴏𐴞𐴁𐴞 𐴌𐴝𐴙𐴑𐴧𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴕𐴡𐴥 𐴊𐴡𐴥𐴌𐴠.</char> <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴒𐴡𐴔 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴞𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴊𐴡𐴥𐴙𐴅𐴧𐴞𐴓𐴢: 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴃𐴞𐴌𐴞𐴥𐴐𐴢 𐴒𐴟𐴕, 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴇𐴝𐴥𐴙𐴄𐴢 𐴒𐴟𐴕, 𐴀𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴒𐴟𐴕.“</char><verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴥𐴕𐴡.“</char><verse eid="MRK 4:9" /></para>
  <para style="s1">𐴔𐴠𐴀𐴏𐴝𐴓𐴡𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢</para>
  <para style="r">(<ref loc="MAT 13:10-17">𐴔𐴡𐴃𐴢 13‏:10‏-17</ref>; <ref loc="LUK 8:9-10">𐴓𐴟𐴑 8‏:9‏-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴒𐴝𐴦𐴒𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴟𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴒𐴟𐴉𐴡𐴕𐴞𐴌𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴠 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴝𐴀𐴌𐴒𐴗𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝,</char> <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" /><char style="wj">𐴎𐴠𐴀𐴕𐴠,</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">’𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴘𐴃𐴠𐴥 𐴏𐴝𐴘𐴁𐴡𐴥 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴁𐴡,</char></para>
  <para style="q2" vid="MRK 4:12">
    <char style="wj">𐴉𐴟𐴥𐴙𐴕𐴃𐴠 𐴉𐴟𐴥𐴕𐴞𐴁𐴡 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴁𐴟𐴎𐴞𐴥𐴁𐴡,</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴞𐴥𐴌𐴞 𐴀𐴝𐴘𐴃𐴡𐴤 𐴀𐴝𐴦𐴌 𐴔𐴝𐴉𐴢 𐴉𐴝𐴘𐴃𐴡.‘ “</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4‏:12 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 6:9">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 6‏:9</ref>‏,<ref loc="ISA 6:10">10</ref></char>
      </char>
    </note><verse eid="MRK 4:12" /></para>
  <para style="s1">𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴍𐴡𐴘𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴁𐴟𐴎𐴝𐴥𐴘𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MAT 13:18-23">𐴔𐴡𐴃𐴢 13‏:18‏-23</ref>; <ref loc="LUK 8:11-15">𐴓𐴟𐴑 8‏:11‏-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴕𐴡𐴥 𐴁𐴟𐴎𐴡𐴥 𐴕𐴞𐴥𐴑𐴞؟ 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴟𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴁𐴟𐴎𐴞𐴥𐴁𐴝؟</char> <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" /><char style="wj">𐴐𐴞𐴥𐴣𐴍𐴡𐴘𐴝𐴘𐴠 𐴐𐴞𐴥𐴣𐴄𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔.</char> <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" /><char style="wj">𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴌𐴝𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴁𐴞𐴏𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴞𐴓𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴐𐴞𐴥𐴣𐴍𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴑𐴝𐴓𐴝𐴔 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘.</char> <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" /><char style="wj">𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴐𐴞𐴥𐴓𐴢 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴁𐴞𐴏𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴞𐴓𐴠 𐴔𐴡𐴃𐴧𐴡𐴌 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥,</char> <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴐𐴞𐴥𐴛𐴡𐴌 𐴕𐴡𐴥 𐴒𐴝𐴏𐴝𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴡𐴦𐴊𐴧𐴞𐴕 𐴁𐴠 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴠. 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴠𐴥 𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴘𐴝𐴥 𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴥𐴇𐴡𐴕 𐴉𐴞𐴏𐴧𐴝𐴥 𐴔𐴝𐴌𐴠.</char> <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" /><char style="wj">𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴑𐴠𐴣𐴍𐴝𐴁𐴡𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴁𐴞𐴏𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴠,</char> <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴘𐴠, 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴡𐴌 𐴀𐴝𐴊𐴡𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴝𐴓𐴡𐴥𐴏𐴠 𐴇𐴠𐴥 𐴑𐴝𐴓𐴝𐴔𐴡𐴌𐴠 𐴏𐴞𐴁𐴞 𐴌𐴝𐴑𐴠𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴒𐴟𐴓𐴝 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠.</char> <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" /><char style="wj">𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴒𐴡𐴔 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴁𐴞𐴏𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴝: 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴃𐴞𐴌𐴞𐴥𐴐𐴢 𐴒𐴟𐴕, 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴇𐴝𐴥𐴙𐴄𐴢 𐴒𐴟𐴕, 𐴀𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴒𐴟𐴕.“</char><verse eid="MRK 4:20" /></para>
  <para style="s1">𐴏𐴠𐴌𐴝𐴑𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="LUK 8:16-18">𐴓𐴟𐴑 8‏:16‏-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴠𐴌𐴝𐴑 𐴑𐴞 𐴁𐴝𐴥𐴙𐴌 𐴘𐴝𐴥 𐴉𐴝𐴓𐴡𐴚𐴡𐴌 𐴃𐴡𐴓𐴠 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴕𐴠𐴤 𐴊𐴠 𐴕𐴠𐴥؟ 𐴏𐴠𐴌𐴝𐴑 𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴕𐴡 𐴕𐴠𐴥؟</char> <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴟𐴑𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘 𐴎𐴞𐴀𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴟𐴑𐴝𐴘 𐴀𐴠𐴙𐴅𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘 𐴎𐴞𐴀𐴕 𐴑𐴟𐴥𐴓𐴝𐴇𐴝𐴓𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡. </char> <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" /><char style="wj">𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴃𐴝𐴥𐴑𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴥𐴕𐴡.“</char><verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴉𐴟𐴥𐴕𐴡𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴊𐴞𐴥𐴘𐴝𐴕 𐴊𐴡𐴥. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴔𐴝𐴉𐴠 𐴊𐴞𐴦𐴁𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥 𐴔𐴝𐴉𐴠 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴌𐴡𐴤 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴝𐴃𐴧𐴟 𐴕𐴝𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="MRK 4:25" /></para>
  <para style="s1">𐴁𐴞𐴏𐴢 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴝𐴥𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴄𐴧𐴠,</char> <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴌𐴝𐴙𐴃𐴧𐴝 𐴒𐴟𐴥𐴔 𐴎𐴝 𐴀𐴝𐴦𐴌 𐴊𐴞𐴕𐴡𐴃𐴢 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴠, 𐴇𐴠𐴥 𐴁𐴞𐴏𐴡𐴃𐴧𐴟 𐴒𐴠𐴏𐴢 𐴀𐴝𐴀𐴘𐴢 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴞𐴎𐴠 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" /><char style="wj">𐴎𐴡𐴁𐴞𐴕𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴊𐴡𐴥𐴌𐴝: 𐴀𐴝𐴒𐴠 𐴏𐴝𐴌𐴝, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴒𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴒𐴝𐴃𐴢 𐴉𐴡𐴦𐴕𐴝 𐴉𐴡𐴥𐴏𐴡𐴓𐴢.</char> <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴉𐴝𐴒𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴇𐴝𐴣𐴏𐴞 𐴓𐴡𐴘 𐴈𐴝𐴍𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴈𐴝𐴍𐴞𐴁𐴝𐴥𐴌 𐴀𐴝𐴙𐴕𐴊𐴝 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘.“</char><verse eid="MRK 4:29" /></para>
  <para style="s1">𐴇𐴡𐴥𐴌𐴡𐴙𐴌 𐴊𐴝𐴕𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 13:31-32">𐴔𐴡𐴃𐴢 13‏:31‏-32</ref>; <ref loc="LUK 13:18-19">𐴓𐴟𐴑 13‏:18‏-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴑𐴞𐴘𐴡𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴘𐴃𐴝𐴥𐴔؟ 𐴘𐴝𐴥 𐴑𐴞𐴘𐴡𐴥𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴁𐴟𐴎𐴝𐴥𐴘𐴃𐴝𐴔؟</char> <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" /><char style="wj">𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴇𐴡𐴥𐴌𐴡𐴙𐴌 𐴊𐴝𐴕𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝; 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴓𐴝𐴒𐴝𐴘𐴁𐴝𐴥𐴐𐴧𐴡𐴃𐴢 𐴏𐴝𐴘𐴃𐴠𐴥 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴁𐴞𐴏𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴁𐴧𐴠 𐴐𐴡𐴥𐴣𐴍𐴡,</char> <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" /><char style="wj">𐴃𐴡𐴀 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴓𐴝𐴒𐴝𐴘𐴓𐴠𐴥, 𐴘𐴞𐴥𐴁𐴝 𐴁𐴝𐴌𐴞𐴥 𐴑𐴠𐴥𐴃𐴞𐴌 𐴒𐴝𐴏𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴥𐴍𐴝, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴥𐴁𐴝𐴌 𐴕𐴞𐴏𐴠 𐴁𐴝𐴇𐴝𐴤 𐴁𐴝𐴣𐴊𐴞𐴥 𐴉𐴝𐴌𐴠.“</char><verse eid="MRK 4:32" /></para>
  <para style="s1">𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴔𐴡𐴎𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴈𐴡𐴘𐴃𐴡𐴤. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴏𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴈𐴡𐴘𐴃𐴡𐴤; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴟𐴎𐴝𐴥𐴘𐴊𐴞𐴃𐴡.<verse eid="MRK 4:34" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴟𐴖𐴝𐴥𐴕 𐴃𐴝𐴥𐴔𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 8:23-27">𐴔𐴡𐴃𐴢 8‏:23‏-27</ref>; <ref loc="LUK 8:22-25">𐴓𐴟𐴑 8‏:22‏-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴡 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴎𐴝𐴘.“</char> <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴓𐴗𐴝𐴥𐴌𐴠 𐴀𐴠𐴌𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤 𐴎𐴠 𐴕𐴡𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴌𐴡𐴤 𐴕𐴡𐴦 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴒𐴞𐴀𐴓𐴢. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />𐴀𐴝𐴏𐴞𐴔𐴁𐴞𐴃𐴢 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴃𐴟𐴖𐴝𐴥𐴕 𐴐𐴟𐴥𐴌𐴟 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴀𐴕 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴙𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴝𐴌𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴕𐴡𐴦 𐴒𐴝𐴥𐴕 𐴉𐴝𐴕𐴞𐴥 𐴓𐴡𐴥𐴘 𐴁𐴡𐴥𐴌𐴞𐴎𐴝𐴌𐴒𐴡𐴘. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤 𐴕𐴡𐴦𐴡𐴌 𐴉𐴝𐴏𐴞𐴥𐴓𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴝𐴓𐴟𐴥𐴐𐴢 𐴐𐴞𐴥𐴃𐴝𐴕𐴡𐴃𐴢 𐴊𐴞𐴥 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴊𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴌𐴞𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴡𐴕𐴡𐴤 𐴊𐴞𐴥𐴘𐴝𐴕 𐴕𐴝𐴥𐴘؟“<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴀𐴟𐴍𐴞𐴤 𐴁𐴡𐴘𐴧𐴝𐴌𐴡𐴌𐴠 𐴊𐴡𐴥𐴀𐴣𐴑 𐴊𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴕𐴞𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴞𐴎𐴝𐴥𐴔 𐴀𐴡𐴥, 𐴃𐴝𐴥𐴔𐴝.“</char> 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴡𐴘𐴧𐴝𐴌 𐴁𐴡𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴃𐴝𐴥𐴔𐴝𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠 <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴋𐴡𐴦𐴌𐴡𐴥𐴌 𐴑𐴞𐴘𐴝𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴑𐴞𐴥 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴞𐴔𐴝𐴕 𐴕𐴝𐴥𐴘؟“</char><verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘 𐴀𐴝𐴦𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴇𐴡𐴕؟ 𐴁𐴡𐴘𐴧𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥𐴘𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴊𐴠 𐴀𐴞𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴝𐴕𐴠!“<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 8:28-34">𐴔𐴡𐴃𐴢 8‏:28‏-34</ref>; <ref loc="LUK 8:26-39">𐴓𐴟𐴑 8‏:26‏-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴞𐴀𐴌 𐴀𐴡𐴑𐴟𐴓𐴠 𐴒𐴠𐴌𐴝𐴏𐴠𐴥𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴕𐴡𐴦𐴃𐴧𐴟 𐴓𐴝𐴙𐴔𐴧𐴠𐴥, 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴠𐴎𐴧𐴡𐴕 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴊𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴈𐴡𐴁𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴃𐴢; 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴝𐴣𐴊𐴞𐴥 𐴌𐴝𐴑𐴞𐴥 𐴕𐴡 𐴉𐴝𐴙𐴃𐴧𐴡, 𐴏𐴞𐴥𐴘𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡 𐴉𐴝𐴙𐴃𐴧𐴡. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴝𐴌 𐴁𐴠𐴌𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴥𐴘𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴁𐴝𐴣𐴊𐴞𐴥 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴏𐴞𐴥𐴘𐴡𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴏𐴞𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴃𐴡, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴌𐴞𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴝𐴥𐴕-𐴇𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴃𐴡. 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴏𐴡𐴥𐴣𐴓𐴞 𐴌𐴝𐴑𐴞𐴥 𐴕𐴡 𐴉𐴝𐴙𐴃𐴧𐴡. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴌𐴝𐴘𐴃𐴠 𐴊𐴞𐴕𐴠 𐴈𐴡𐴁𐴡𐴌𐴠-𐴈𐴡𐴁𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴀𐴌𐴠-𐴉𐴝𐴀𐴌𐴠 𐴒𐴟𐴎𐴡𐴌𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴓𐴡𐴥𐴘 𐴈𐴝𐴍𐴞𐴃𐴡𐴥.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴟𐴌𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴊𐴟𐴣𐴌𐴞 𐴎𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴀𐴞𐴏𐴝𐴤, 𐴀𐴝𐴓𐴧𐴝 𐴃𐴝𐴥𐴓𐴝𐴌 𐴉𐴟𐴖𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴑𐴞𐴦 𐴈𐴝𐴔 𐴀𐴝𐴏𐴠𐴤؟ 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴡𐴎𐴞𐴘𐴝 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥.“ <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴇𐴠𐴥𐴘 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕، 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘.“</char><verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴌 𐴕𐴝𐴔 𐴑𐴞𐴦؟“</char></para>
  <para style="p" vid="MRK 5:9">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔 𐴎𐴝𐴥𐴑; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴡𐴗𐴀𐴃𐴧𐴗𐴝 𐴀𐴝𐴏𐴞𐴤.“ <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴇𐴠𐴥 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴧𐴟 𐴊𐴟𐴣𐴌𐴝𐴘 𐴕𐴡 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />𐴇𐴠𐴥𐴍𐴠 𐴉𐴝𐴀𐴌𐴡𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴎𐴝𐴥𐴑 𐴐𐴟𐴥𐴖𐴡𐴌 𐴏𐴡𐴌𐴠𐴌 𐴊𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />𐴁𐴟𐴥𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴡 𐴐𐴟𐴥𐴖𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴞 𐴉𐴝𐴌𐴞.“ <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴕𐴟𐴥𐴕 𐴕𐴠𐴦𐴓𐴞 𐴐𐴟𐴥𐴖𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴧𐴠𐴒𐴡𐴘; 𐴃𐴡𐴥𐴘 𐴎𐴝𐴥𐴑𐴧𐴗𐴝 𐴉𐴝𐴀𐴌𐴡𐴌 𐴇𐴝𐴙𐴕𐴊𐴝𐴤 𐴁𐴝𐴥𐴘 𐴎𐴟𐴌𐴠 𐴋𐴞𐴀𐴃𐴢 𐴊𐴟𐴣𐴌𐴊𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴋𐴟𐴉𐴞𐴥 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. 𐴇𐴠𐴥 𐴎𐴝𐴥𐴑𐴧𐴗𐴝𐴃𐴢 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴊𐴟𐴘 𐴀𐴝𐴥𐴎𐴝𐴌 𐴐𐴟𐴥𐴖𐴡𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />𐴐𐴟𐴥𐴖𐴡𐴌 𐴏𐴡𐴌𐴡𐴘𐴝 𐴒𐴟𐴥𐴕 𐴊𐴟𐴣𐴌𐴊𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴒𐴝𐴚 𐴎𐴝𐴒𐴝𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴥𐴁𐴡𐴌 𐴊𐴞𐴥𐴘𐴠. 𐴁𐴝𐴦𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴏𐴝𐴘𐴃𐴡𐴥 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴀𐴙𐴓𐴢 𐴊𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴅𐴞𐴕𐴡𐴌 𐴎𐴝𐴥𐴑 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴁𐴡𐴘𐴍𐴝𐴤, 𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴝𐴤 𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴟𐴥𐴣𐴐𐴠 𐴀𐴝𐴏𐴠𐴤; 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥 𐴔𐴝𐴦𐴔𐴠𐴓𐴝 𐴒𐴝𐴥𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴀𐴙𐴓𐴢 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴐𐴟𐴥𐴖𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />𐴁𐴝𐴦𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴧𐴟 𐴎𐴝𐴘𐴃𐴡𐴒𐴡𐴥𐴘 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />𐴀𐴞𐴥𐴁𐴝 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴠𐴤𐴌𐴒𐴡𐴘 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴀𐴙𐴓𐴢 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴕𐴡𐴥 𐴊𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴡𐴦𐴒𐴡𐴥𐴘 𐴀𐴝𐴦𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴎𐴝𐴕𐴡𐴒𐴡𐴥𐴘 𐴊𐴠, 𐴔𐴝𐴁𐴟𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴇𐴡𐴃𐴧𐴡𐴥𐴌 𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴃𐴡𐴥 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.“</char> <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴓𐴧𐴝 𐴎𐴠 𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠𐴑𐴝𐴂𐴡𐴥𐴓𐴞𐴏𐴢<note caller="+" style="f"><char style="fr" closed="false">5‏:20 </char><char style="fq">𐴊𐴠𐴑𐴝𐴂𐴡𐴥𐴓𐴞𐴏𐴢</char> <char style="ft" closed="false">𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴒𐴞𐴌𐴞𐴥𐴑 𐴓𐴡𐴉𐴎𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴔𐴝𐴀𐴕𐴞 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝 </char></note> 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠; 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴞𐴓𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴃𐴡.<verse eid="MRK 5:20" /></para>
  <para style="s1">𐴎𐴝𐴥𐴘𐴌𐴝𐴏𐴡𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴡𐴦𐴌 𐴏𐴟𐴥𐴘𐴧𐴠 𐴊𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝</para>
  <para style="r">(<ref loc="MAT 9:18-26">𐴔𐴡𐴃𐴢 9‏:18‏-26</ref>; <ref loc="LUK 8:40-56">𐴓𐴟𐴑 8‏:40‏-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴁𐴝𐴌 𐴕𐴡𐴦𐴃𐴢 𐴒𐴡𐴌𐴞 𐴋𐴞𐴀𐴌 𐴀𐴡 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴉𐴝𐴌𐴝𐴤𐴘𐴧𐴠, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴞𐴥𐴌𐴞 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴋𐴞𐴀𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴕𐴝𐴔 𐴎𐴝𐴥𐴘𐴌𐴝𐴏𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴦𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />𐴀𐴝𐴦𐴌 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴌𐴝 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝 𐴔𐴡𐴌𐴡𐴕-𐴔𐴡𐴌𐴡𐴕 𐴀𐴡𐴥𐴘𐴧𐴠; 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴀𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴥𐴃𐴧𐴝𐴕 𐴇𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴊𐴡𐴦𐴒𐴝𐴥𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴁𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴀𐴝𐴦𐴌 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴠.“ <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴌𐴡𐴖𐴝𐴕𐴝 𐴓𐴡𐴘𐴧𐴠𐴥.</para>
  <para style="p" vid="MRK 5:24">𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴠 𐴀𐴝𐴦𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴄𐴠𐴥𐴓𐴝𐴄𐴠𐴓𐴞 𐴒𐴡𐴌𐴠𐴥𐴌. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴑𐴟𐴥𐴕𐴎𐴝𐴌𐴞 𐴎𐴝𐴥𐴌 𐴊𐴠 𐴁𐴝𐴌𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴋𐴝𐴑𐴄𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴃𐴡𐴑𐴡𐴓𐴞𐴉𐴢 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴇𐴡𐴥𐴏𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡 𐴇𐴡𐴕𐴡𐴤 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴝𐴌𐴡𐴤 𐴁𐴝𐴌𐴞𐴥𐴒𐴞𐴓𐴒𐴡𐴘. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴓𐴗𐴝𐴥𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴞 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴞𐴏𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌 𐴏𐴟𐴥𐴘𐴧𐴠, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴝𐴥𐴙𐴂𐴧𐴞𐴓𐴢 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌 𐴏𐴟𐴥𐴘 𐴉𐴝𐴙𐴓𐴧𐴠 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴧𐴟𐴔𐴁𐴡𐴘.“ <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />𐴃𐴡𐴥𐴘 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴑𐴟𐴥𐴕𐴎𐴝𐴌𐴞 𐴁𐴡𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝 𐴁𐴞𐴘𐴝𐴌𐴝𐴔𐴡𐴃𐴧𐴟 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴞𐴎𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴃𐴢 𐴔𐴝𐴀𐴏𐴟𐴏𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴠𐴥.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />𐴀𐴝𐴦𐴌 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴝𐴘𐴌𐴡𐴥𐴔𐴞𐴑𐴧𐴝 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴇𐴡𐴦𐴌 𐴇𐴡𐴕𐴠 𐴏𐴟𐴥𐴘𐴧𐴠؟“</char><verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴃𐴡 𐴊𐴠𐴑𐴡𐴥𐴌, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴄𐴠𐴥𐴓𐴝𐴄𐴠𐴓𐴞 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴡𐴕𐴠 𐴏𐴟𐴥𐴘𐴧𐴠؟‘ “<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />𐴓𐴠𐴑𐴞𐴕 𐴇𐴠𐴥 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤 𐴏𐴝𐴘𐴌𐴡𐴥𐴔𐴞𐴑𐴧𐴝 𐴏𐴝𐴀𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴎𐴝𐴕𐴞, 𐴋𐴡𐴦𐴌𐴠 𐴇𐴝𐴉𐴞-𐴇𐴝𐴉𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴟𐴌𐴝 𐴇𐴝𐴥𐴑𐴞𐴒𐴡𐴃𐴢 𐴎𐴝𐴕𐴝𐴀𐴙𐴓𐴢. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡 𐴎𐴞𐴥𐴀, 𐴃𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴠 𐴃𐴡𐴌𐴠𐴥 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴝𐴦𐴒𐴡𐴥𐴘, 𐴃𐴡𐴌𐴃𐴧𐴟 𐴀𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴝𐴌 𐴕𐴡 𐴀𐴡𐴥𐴑.“</char><verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />𐴀𐴞𐴥𐴁𐴝 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴒𐴗𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴧𐴟 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴎𐴞𐴥𐴀 𐴎𐴟𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘;<note caller="+" style="f"><char style="fr" closed="false">5‏:35 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa" closed="false">𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘</char></note> 𐴀𐴟𐴏𐴃𐴝𐴃𐴡𐴌𐴠 𐴀𐴝𐴌 𐴑𐴞𐴘𐴝𐴥 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴒𐴡𐴌𐴡𐴤𐴌؟“<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤𐴌 𐴀𐴟𐴎𐴟 𐴊𐴞𐴥𐴘𐴝𐴕 𐴕𐴡 𐴊𐴞 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥; 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤.“</char><verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴃𐴡𐴌, 𐴘𐴝𐴑𐴟𐴁𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴁𐴝𐴥𐴘 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴘𐴃𐴡 𐴕𐴡𐴥 𐴊𐴠. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴒𐴗𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴓𐴇𐴡𐴓𐴝𐴌, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴞 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴓𐴝𐴑 𐴒𐴡𐴌𐴠𐴥𐴌. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴎𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴑𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴡𐴤𐴌؟ 𐴀𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴔𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴟𐴥𐴔 𐴎𐴝𐴌 𐴊𐴠.“</char> <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴥𐴣𐴐𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴕𐴠𐴦𐴓𐴝𐴘𐴊𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴓𐴡𐴥𐴘, 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴝𐴔𐴝𐴥𐴌𐴝𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴀𐴝𐴥𐴃𐴢 𐴊𐴡𐴥𐴌𐴞 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴄𐴝𐴓𐴞𐴃𐴝 𐴑𐴟𐴔,“</char> 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴃𐴡𐴌𐴅𐴟𐴔𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, <char style="wj">”𐴒𐴟𐴌𐴝 𐴉𐴟𐴃𐴟𐴥𐴕𐴞, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴟𐴄𐴢.“</char> <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />𐴀𐴠𐴥𐴇𐴡𐴕 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝 𐴀𐴟𐴍𐴞𐴤 𐴀𐴝𐴥𐴣𐴍𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴁𐴝𐴌𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌. 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴁𐴧𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡 𐴎𐴝𐴕𐴝𐴘 𐴁𐴡𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴈𐴝𐴥𐴘𐴃𐴡 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴊𐴞𐴦 𐴁𐴡𐴓𐴧𐴝.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s1">𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 13:53-58">𐴔𐴡𐴃𐴢 13‏:53‏-58</ref>; <ref loc="LUK 4:16-30">𐴓𐴟𐴑 4‏:16‏-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />𐴀𐴞𐴏𐴝𐴤 𐴈𐴠𐴥𐴕𐴃𐴟 𐴕𐴠𐴦𐴓𐴞 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴃𐴡𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴡𐴥 𐴒𐴞𐴀𐴓𐴢. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />𐴀𐴝𐴦𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴀𐴕 𐴇𐴡𐴕𐴃𐴟𐴤 𐴐𐴞𐴥𐴑𐴧𐴠؟ 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴞𐴘𐴝𐴕؟ 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴑𐴞𐴦 𐴑𐴠𐴌𐴝𐴔𐴡𐴃؟ <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />𐴀𐴞𐴁𐴝𐴤 𐴑𐴞𐴥 𐴔𐴞𐴏𐴃𐴞𐴥𐴌𐴞 𐴕𐴡, 𐴎𐴞𐴁𐴝𐴤 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴦𐴌 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴡𐴌, 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴀𐴡𐴌, 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌 𐴁𐴝𐴥𐴘؟ 𐴀𐴞𐴁𐴝𐴤𐴌 𐴁𐴡𐴥𐴘𐴕𐴝𐴙𐴕 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴡𐴥 𐴕𐴠؟“ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴁𐴞𐴌 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴃𐴡𐴥𐴕 𐴀𐴡𐴃𐴢, 𐴀𐴠𐴒𐴝𐴕𐴝-𐴒𐴟𐴐𐴧𐴞𐴥𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴁𐴝𐴊𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤.“</char> <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴥𐴃𐴢 𐴊𐴞𐴥 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴝𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴞𐴃𐴢 𐴀𐴞𐴥𐴁𐴝 𐴁𐴞𐴐𐴞𐴤 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘.</para>
  <para style="s1" vid="MRK 6:6">𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴕𐴟𐴥𐴕𐴡𐴌𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴡𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:1">𐴔𐴡𐴃𐴢 10‏:1</ref>‏,<ref loc="MAT 10:5-15">5‏-15</ref>; <ref loc="LUK 9:1-6">𐴓𐴟𐴑 9‏:1‏-6</ref>)</para>
  <para style="p" vid="MRK 6:6">𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴉𐴝𐴌𐴝-𐴉𐴝𐴌𐴝 𐴎𐴝𐴘 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘, 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴠𐴦𐴓𐴝𐴘𐴁𐴝𐴥𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴀𐴓𐴢.<verse eid="MRK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴉𐴡𐴣𐴃𐴡𐴓𐴧𐴝 𐴓𐴝𐴍𐴞𐴥 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴓𐴡𐴘𐴎𐴝𐴘𐴧𐴡𐴥: 𐴕𐴡 𐴌𐴟𐴄𐴞, 𐴕𐴡 𐴇𐴡𐴥𐴙𐴓𐴧𐴝, 𐴕𐴡 𐴎𐴝𐴓𐴞𐴃𐴢 𐴒𐴡𐴌𐴞 𐴄𐴞𐴛𐴝.</char> <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" /><char style="wj">𐴐𐴠𐴕𐴄𐴝𐴥𐴌 𐴉𐴞𐴣𐴊𐴞𐴥𐴘𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴝𐴃𐴧𐴞𐴥 𐴇𐴡𐴦𐴌 𐴕𐴡 𐴓𐴡𐴘𐴎𐴝𐴘𐴧𐴡𐴥.“</char> <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴁𐴝 𐴇𐴠𐴥 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴐𐴡𐴥𐴀𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴕𐴡𐴥 𐴎𐴡𐴦𐴒𐴡𐴥𐴘 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴝𐴥𐴑𐴞𐴘𐴡. </char> <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" /><char style="wj">𐴎𐴠 𐴎𐴝𐴒𐴝𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴘𐴝𐴥𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴕𐴡 𐴉𐴟𐴥𐴕𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴧𐴟 𐴎𐴝𐴘𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴃𐴡𐴓𐴧𐴝𐴌 𐴊𐴟𐴥𐴙𐴓𐴢 𐴎𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠.“</char><verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴡𐴖𐴝𐴕𐴝 𐴓𐴡𐴘 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴡𐴤. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴠𐴦𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴃𐴠𐴓𐴢<note caller="+" style="f"><char style="fr" closed="false">6‏:13 </char><char style="ft" closed="false">𐴃𐴠𐴓𐴢 𐴀𐴞𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴝𐴘𐴃𐴟𐴕 𐴃𐴠𐴓𐴢</char></note> 𐴊𐴞 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="MRK 6:13" /></para>
  <para style="s1">𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴔𐴡𐴦𐴃𐴢</para>
  <para style="r">(<ref loc="MAT 14:1-12">𐴔𐴡𐴃𐴢 14‏:1‏-12</ref>; <ref loc="LUK 9:7-9">𐴓𐴟𐴑 9‏:7‏-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />𐴀𐴝𐴦𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴔𐴡𐴐𐴟𐴥𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘. 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴞 𐴈𐴝𐴔 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠𐴌.“<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />𐴑𐴞𐴘𐴠𐴥-𐴑𐴞𐴘𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢.“</para>
  <para style="p" vid="MRK 6:15">𐴀𐴝𐴌 𐴑𐴞𐴘𐴠𐴥-𐴑𐴞𐴘𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴕𐴡𐴁𐴞, 𐴀𐴝𐴒𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝.“<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴎𐴞𐴁𐴝𐴤𐴌 𐴈𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴝 𐴁𐴝𐴥𐴘𐴓𐴝𐴔, 𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠.“<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴠𐴥𐴌𐴟𐴊𐴢 𐴕𐴞𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘, 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘 𐴉𐴞𐴓𐴞𐴥𐴂𐴡𐴌 𐴁𐴡𐴖𐴢 𐴈𐴠𐴥𐴌𐴟𐴊𐴞𐴀𐴝𐴏𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴇𐴠𐴥 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴁𐴝𐴣𐴊𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴙𐴓𐴢. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴃𐴡𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴝𐴘𐴠𐴏𐴢 𐴕𐴝𐴥𐴘.“ <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴠𐴥𐴌𐴟𐴊𐴞𐴀𐴝𐴏𐴢 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴓𐴧𐴡𐴥𐴘 𐴌𐴝𐴑 𐴃𐴝𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘, 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴃𐴡𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴃𐴡𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥𐴃𐴡. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞𐴓𐴠 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴓𐴎𐴡𐴥𐴓𐴡𐴃𐴢 𐴉𐴡𐴌𐴞𐴎𐴝𐴘𐴃𐴡𐴥𐴘; 𐴃𐴡𐴀 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴙𐴕𐴃𐴠 𐴒𐴡𐴔 𐴓𐴝𐴒𐴞𐴃𐴡𐴥.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢 𐴈𐴠𐴥𐴌𐴟𐴊𐴞𐴀𐴝𐴏𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴡𐴑𐴝 𐴉𐴝𐴀𐴙𐴓𐴢, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴎𐴡𐴌𐴔𐴡-𐴊𐴞𐴕𐴡𐴌 𐴊𐴞𐴕 𐴐𐴡𐴥𐴌𐴑𐴝𐴌𐴞 𐴋𐴡𐴣𐴀𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴉𐴡𐴥𐴗𐴏𐴡𐴌 𐴎𐴡𐴕𐴧𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴋𐴝𐴘𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴥𐴕𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />𐴈𐴠𐴥𐴌𐴟𐴊𐴞𐴀𐴝𐴏𐴡𐴌 𐴎𐴞𐴥𐴀 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴇𐴠𐴥𐴍𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴀𐴘𐴢, 𐴕𐴝𐴏𐴞𐴘𐴡𐴌𐴠 𐴈𐴠𐴥𐴌𐴟𐴊𐴢 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴠𐴀𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴘𐴠 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴌𐴃𐴧𐴟 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴝𐴒, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴦𐴘𐴟𐴔.“ <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴝𐴒𐴡𐴏𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴦𐴘𐴟𐴔, 𐴀𐴝𐴣𐴀𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴠𐴑𐴊𐴡𐴥𐴑 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴟𐴔.“<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴁𐴝 𐴕𐴠𐴦𐴓𐴞 𐴎𐴝𐴘 𐴔𐴝𐴦𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴑𐴞𐴦 𐴔𐴝𐴒𐴞𐴃𐴝𐴥𐴔؟“</para>
  <para style="p" vid="MRK 6:24">𐴔𐴝𐴦𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴈𐴡𐴓𐴧𐴝 𐴖𐴝.“<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />𐴀𐴠𐴥𐴇𐴡𐴕 𐴇𐴞𐴥𐴁𐴝 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴈𐴡𐴓𐴧𐴝 𐴖𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴃𐴝𐴥𐴓𐴞𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴠𐴇𐴡𐴥𐴕 𐴏𐴝𐴀𐴘𐴢.“<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴓𐴝𐴙𐴒𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴕𐴞𐴎𐴡𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴔𐴠𐴀𐴔𐴝𐴕 𐴕𐴟𐴥𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴡𐴥 𐴏𐴝𐴀. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴘𐴠 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴠𐴎𐴧𐴡𐴕 𐴎𐴡𐴓𐴧𐴝𐴃𐴡𐴌𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴈𐴡𐴓𐴧𐴝 𐴖𐴝 𐴀𐴝𐴙𐴕𐴃𐴡𐴤 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴎𐴝𐴘, 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴓𐴧𐴝 𐴖𐴝 𐴈𐴝𐴍𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴠, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />𐴀𐴝𐴦𐴌 𐴈𐴡𐴓𐴧𐴝 𐴖𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴃𐴝𐴥𐴓𐴞𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴕𐴞𐴤 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥; 𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴓𐴝𐴐𐴧𐴗𐴝 𐴓𐴡𐴘𐴎𐴝𐴘 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴢 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="MRK 6:29" /></para>
  <para style="s1">𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴁𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 14:13-21">𐴔𐴡𐴃𐴢 14‏:13‏-21</ref>; <ref loc="LUK 9:10-17">𐴓𐴟𐴑 9‏:10‏-17</ref>; <ref loc="JHN 6:1-14">𐴘𐴡 6‏:1‏-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴞𐴦-𐴑𐴞𐴦 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴑𐴞𐴦-𐴑𐴞𐴦 𐴐𐴞𐴥𐴑𐴝𐴙𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴀-𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴄𐴝𐴙𐴔 𐴕𐴡𐴥 𐴉𐴝𐴦 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴎𐴝𐴥𐴔 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴀𐴠𐴏𐴧𐴝𐴥𐴃𐴢 𐴎𐴞𐴌𐴡𐴒𐴝𐴥𐴘.“</char><verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡𐴦𐴃𐴢 𐴒𐴡𐴌𐴞 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴡𐴐𐴡𐴥𐴃𐴞-𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴒𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴃𐴝𐴌𐴝𐴥 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴞𐴕𐴞𐴥 𐴉𐴝𐴌𐴞 𐴃𐴝𐴔𐴝𐴥𐴔 𐴐𐴡𐴥𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴊𐴟𐴣𐴌𐴞-𐴊𐴟𐴣𐴌𐴞 𐴇𐴠𐴥𐴍𐴠 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴎𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴒𐴠 𐴇𐴠𐴥𐴍𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴕𐴡𐴦𐴃𐴧𐴟 𐴓𐴝𐴙𐴔𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴉𐴠𐴄𐴉𐴟𐴙𐴅𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴡𐴌𐴡𐴘𐴝 𐴏𐴝𐴥𐴌𐴝 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴝𐴀𐴕 𐴃𐴡 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴡𐴐𐴡𐴥𐴃𐴞-𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴒𐴝 𐴀𐴝𐴦𐴌 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴝𐴌𐴝𐴥 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴒𐴝𐴚 𐴎𐴝𐴒𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴎𐴝𐴘 𐴕𐴞𐴎𐴠 𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴑𐴞𐴕𐴞 𐴉𐴝𐴌𐴠.“<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴡𐴦.“</char></para>
  <para style="p" vid="MRK 6:37">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴘 𐴊𐴟𐴘 𐴐𐴡𐴥𐴃𐴢 𐴊𐴞𐴕𐴝𐴥𐴌𐴡𐴌<note caller="+" style="f"><char style="fr" closed="false">6‏:37 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 𐴀𐴝𐴊𐴝𐴤 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴓𐴡𐴘</char></note> 𐴌𐴟𐴄𐴞 𐴑𐴞𐴕𐴞 𐴀𐴝𐴕𐴞𐴤 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴈𐴝𐴥𐴁𐴝𐴘𐴃𐴝𐴔 𐴕𐴠𐴥؟“<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴌𐴟𐴄𐴞 𐴈𐴡𐴖𐴝𐴤 𐴀𐴝𐴏𐴠𐴤؟ 𐴎𐴝𐴘 𐴏𐴡𐴀𐴒𐴡𐴘.“ </char></para>
  <para style="p" vid="MRK 6:38">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴖𐴝𐴥 𐴔𐴝𐴏𐴢 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤.“<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴝𐴥𐴙𐴓𐴢 𐴑𐴠𐴥𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴋𐴝𐴀𐴘𐴢-𐴋𐴝𐴀𐴘𐴢 𐴒𐴡𐴥𐴌𐴞 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴝𐴘𐴃𐴡 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />𐴃𐴡𐴥𐴘 𐴃𐴝𐴌𐴝𐴥 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴎𐴡𐴙𐴕𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢 𐴎𐴡𐴙𐴕𐴧𐴝 𐴋𐴝𐴀𐴘𐴢 𐴒𐴡𐴥𐴌𐴞-𐴒𐴡𐴥𐴌𐴞 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴠𐴥 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴌𐴟𐴄𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝𐴥 𐴔𐴝𐴏𐴢 𐴏𐴟𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴞𐴦 𐴁𐴡𐴓𐴧𐴝 𐴌𐴟𐴄𐴞 𐴒𐴟𐴥𐴕 𐴁𐴝𐴥𐴚𐴒𐴞-𐴁𐴝𐴥𐴚𐴒𐴞 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴏𐴢 𐴊𐴟𐴕𐴞𐴥 𐴖𐴝 𐴘𐴡𐴥 𐴃𐴝𐴌𐴝𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴝𐴍𐴞𐴊𐴞𐴘𐴠𐴥. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />𐴀𐴝𐴦𐴌 𐴃𐴝𐴌𐴝𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴞 𐴈𐴝𐴥𐴘𐴧𐴠. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />𐴁𐴝𐴦𐴊𐴠 𐴌𐴟𐴄𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴏𐴡𐴌 𐴎𐴠 𐴃𐴟𐴑𐴟𐴍𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴏𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴉𐴠𐴣𐴍𐴝𐴘 𐴓𐴡𐴦𐴘𐴢 𐴉𐴟𐴌𐴝 𐴁𐴝𐴌𐴡𐴥 𐴁𐴝𐴥𐴙𐴌 𐴁𐴡𐴥𐴙𐴅𐴧𐴠. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴌𐴟𐴄𐴞 𐴈𐴝𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴠𐴍𐴝𐴀𐴙𐴕.<verse eid="MRK 6:44" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴉𐴝𐴕𐴞𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴥𐴣𐴙𐴄𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 14:22-23">𐴔𐴡𐴃𐴢 14‏:22‏-23</ref>; <ref loc="JHN 6:15-21">𐴘𐴡 6‏:15‏-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴔𐴡𐴅𐴁𐴟𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴞𐴊𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴊𐴞𐴃𐴠-𐴊𐴞𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴀𐴕𐴠 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴀𐴡𐴑𐴟𐴓𐴠 𐴁𐴠𐴃𐴏𐴝𐴥𐴘𐴊𐴝𐴃𐴢 𐴎𐴝𐴦𐴒𐴡𐴥𐴘. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴞𐴊𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴊𐴞 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴒𐴞𐴦𐴘𐴠𐴥.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴠𐴥𐴣𐴃𐴧𐴠, 𐴕𐴡𐴦 𐴒𐴝𐴥𐴕 𐴋𐴞𐴀𐴌 𐴔𐴝𐴎𐴠𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴇𐴝𐴥𐴓𐴞𐴒𐴝 𐴑𐴟𐴓𐴡𐴌 𐴖𐴡𐴌𐴠. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴔𐴡𐴐𐴑𐴞𐴓𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴝𐴌 𐴁𐴝𐴀𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴡𐴘𐴧𐴝𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴟𐴎𐴝𐴕 𐴁𐴝𐴀𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴉𐴟𐴀𐴝𐴥𐴣𐴙𐴃𐴧𐴝, 𐴀𐴞𐴥𐴁𐴝 𐴉𐴝𐴕𐴞𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴥𐴣𐴍𐴞-𐴀𐴝𐴥𐴣𐴍𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴝𐴥𐴌𐴝𐴘 𐴎𐴝𐴘𐴃𐴡 𐴏𐴝𐴀𐴙𐴓𐴢. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴁𐴝 𐴉𐴝𐴕𐴞𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴥𐴣𐴍𐴠𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴁𐴟𐴥𐴃𐴢 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴞 𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴟𐴙𐴄𐴧𐴞𐴥𐴓𐴢, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴋𐴡𐴦𐴌𐴝𐴀𐴙𐴓𐴢.</para>
  <para style="p" vid="MRK 6:50">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤! 𐴀𐴞𐴁𐴝𐴤 𐴀𐴝𐴀𐴛; 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥.“</char> <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴡𐴘𐴧𐴝𐴌 𐴃𐴝𐴥𐴔𐴝𐴘𐴒𐴞𐴘𐴡𐴘. 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴁𐴧𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴟𐴄𐴞𐴌 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴃𐴝𐴥𐴕 𐴕𐴡𐴥 𐴁𐴟𐴎𐴠𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴊𐴡𐴌𐴡𐴤 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘.<verse eid="MRK 6:52" /></para>
  <para style="s1">𐴒𐴠𐴕𐴠𐴏𐴝𐴥𐴌𐴠𐴃𐴡𐴃𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 14:34-36">𐴔𐴡𐴃𐴢 14‏:34‏-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴞𐴀 𐴉𐴝𐴌𐴝𐴤𐴘, 𐴒𐴠𐴕𐴠𐴏𐴝𐴥𐴌𐴠𐴃𐴢 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴞 𐴕𐴡𐴦 𐴒𐴝𐴥𐴕 𐴁𐴞𐴥𐴌𐴝𐴘𐴧𐴠. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />𐴀𐴝𐴦𐴌 𐴕𐴡𐴦𐴃𐴧𐴟 𐴓𐴝𐴙𐴔𐴧𐴠𐴥 𐴔𐴡𐴃𐴧𐴡𐴌, 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴏𐴞𐴕𐴞𐴥, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />𐴇𐴠𐴥 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝𐴃𐴢 𐴊𐴟𐴣𐴌𐴞 𐴎𐴝𐴘 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴞𐴏𐴝𐴥𐴕𐴝𐴃𐴢 𐴒𐴡𐴥𐴌𐴞, 𐴀𐴞𐴥𐴁𐴝 𐴎𐴠𐴍𐴠𐴥-𐴎𐴠𐴍𐴠𐴥 𐴀𐴝𐴏𐴠𐴤 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴝𐴘𐴧𐴠𐴥 𐴇𐴠𐴥𐴍𐴠-𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴕𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />𐴀𐴞𐴥𐴁𐴝 𐴎𐴠𐴍𐴠𐴥-𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴘𐴃𐴡, 𐴉𐴝𐴌𐴝𐴃𐴢 𐴀𐴡𐴥𐴑, 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑, 𐴘𐴝𐴥 𐴒𐴝𐴚 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴡𐴥𐴑, 𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴕𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴐𐴝𐴥𐴑𐴡𐴌 𐴇𐴝𐴣𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴠 𐴏𐴟𐴥𐴘𐴃𐴡 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴡𐴥 𐴎𐴡𐴕𐴠 𐴏𐴟𐴥𐴘𐴃𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s1">𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴌𐴡𐴏𐴡𐴥𐴔</para>
  <para style="r">(<ref loc="MAT 15:1-20">𐴔𐴡𐴃𐴢 15‏:1‏-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴀𐴝𐴓𐴠𐴔 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴀𐴡𐴃𐴧𐴟. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴀𐴟𐴔𐴧𐴡𐴃𐴠 𐴕𐴝𐴉𐴝𐴑 𐴀𐴝𐴥𐴃𐴠 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴊𐴟𐴥𐴘𐴧𐴝 𐴀𐴝𐴥𐴃𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴌. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴒𐴡𐴌𐴞 𐴀𐴝𐴥𐴃𐴢 𐴕𐴡 𐴊𐴟𐴥𐴘 𐴈𐴝𐴥𐴕𐴝 𐴕𐴝 𐴈𐴝𐴥𐴀, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴒𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴌𐴡𐴏𐴡𐴥𐴔 𐴊𐴡𐴥𐴌𐴞 𐴃𐴝𐴥𐴑𐴠. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />𐴀𐴝𐴦𐴌 𐴁𐴝𐴎𐴝𐴌𐴡𐴃𐴧𐴟 𐴀𐴝𐴘𐴓𐴠𐴤 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴡 𐴊𐴟𐴥𐴘 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝 𐴈𐴝𐴥𐴀. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴋𐴡𐴙𐴓𐴧𐴝 𐴌𐴡𐴏𐴡𐴥𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴇𐴠𐴥 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴑𐴞, 𐴉𐴞𐴘𐴝𐴓𐴝 𐴊𐴟𐴥𐴖𐴝, 𐴎𐴡𐴑 𐴊𐴟𐴥𐴖𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴃𐴟𐴥𐴌𐴞 𐴊𐴟𐴥𐴖𐴝.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />𐴇𐴠𐴥 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴔𐴟𐴥𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴒𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴌𐴡𐴏𐴡𐴥𐴔 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡 𐴑𐴞𐴘𐴝𐴥 𐴏𐴡𐴓𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴝𐴉𐴝𐴑 𐴀𐴝𐴥𐴃𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀؟“<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤,</char></para>
  <para style="q1" vid="MRK 7:6">
    <char style="wj">’𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴑𐴠𐴥 𐴁𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥,</char></para>
  <para style="q2" vid="MRK 7:6">
    <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴝𐴌𐴝𐴥𐴌 𐴊𐴞𐴓𐴢 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥.</char><verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />
    <char style="wj">𐴃𐴝𐴌𐴝𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴊𐴠 𐴁𐴠𐴇𐴝𐴌,</char></para>
  <para style="q2" vid="MRK 7:7">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴝𐴌𐴝𐴥 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴐𐴞𐴥𐴑𐴝 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴕𐴞𐴘𐴡𐴔-𐴑𐴝𐴦𐴕𐴟𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢.‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">7‏:7 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 29:13">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 29‏:13</ref>
        </char>
      </char>
    </note><verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴊𐴞, 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴌𐴡𐴏𐴡𐴥𐴔𐴡𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴃𐴝𐴥𐴑𐴡.“</char><verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴌𐴡𐴏𐴡𐴥𐴔 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴊𐴞𐴘𐴝𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴏𐴝𐴓𐴝𐴥𐴑.</char> <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" /><char style="wj">𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠, ’𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤,‘</char><note caller="+" style="f"><char style="fr" closed="false">7‏:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 20‏:12</ref></char>; <char style="xt"><ref loc="DEU 5:16">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 5‏:16</ref></char></char></note> <char style="wj">𐴀𐴝𐴦𐴌 ’𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴝𐴉𐴡𐴌 𐴘𐴝𐴥 𐴔𐴝𐴦𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.‘ </char><note caller="+" style="f"><char style="fr" closed="false">7‏:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:17">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 21‏:17</ref></char>; <char style="xt"><ref loc="LEV 20:9">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 20‏:9</ref></char></char></note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴀 𐴊𐴠, ’𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴝𐴉𐴡𐴌𐴠 𐴘𐴝𐴥 𐴔𐴝𐴦𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀, 𐴎𐴠 𐴏𐴞𐴎𐴢 𐴓𐴡𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴓𐴝𐴉𐴢 𐴉𐴝𐴘𐴃𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴡𐴌𐴁𐴝𐴕,‘</char> 𐴘𐴝𐴥𐴕𐴞, 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴡𐴓𐴧𐴝 𐴘𐴝𐴥 𐴔𐴝𐴦 𐴓𐴧𐴝 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴡 𐴊𐴡.</char> <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" /><char style="wj">𐴇𐴠𐴥𐴀𐴕 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠 𐴌𐴡𐴏𐴡𐴥𐴔𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔𐴡𐴌𐴠 𐴁𐴝𐴦𐴃𐴠𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤.“</char><verse eid="MRK 7:13" /></para>
  <para style="s1">𐴎𐴞𐴀𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 15:10-20">𐴔𐴡𐴃𐴢 15‏:10‏-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴁𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴝𐴃𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴁𐴟𐴎𐴡𐴥:</char> <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" /><char style="wj">𐴁𐴝𐴀𐴃𐴧𐴟 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘; 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴁𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" /><char style="wj">𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴥𐴕𐴡.“</char><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴀𐴠𐴌𐴞 𐴀𐴠𐴑 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴁𐴟𐴎𐴢 𐴃𐴝𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘 𐴊𐴠𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴕𐴡 𐴁𐴟𐴎𐴡𐴥, 𐴁𐴝𐴀𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴠, 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠 𐴊𐴠𐴥؟</char> <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴎𐴝𐴦 𐴊𐴠 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌 𐴊𐴞𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴠𐴍𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴉𐴠𐴘𐴑𐴝𐴥𐴕𐴝 𐴁𐴝𐴥𐴘 𐴕𐴠𐴦𐴓𐴞𐴎𐴝𐴒𐴡𐴥𐴘.“</char> 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴈𐴝𐴥𐴕𐴝 𐴇𐴝𐴥𐴓𐴝𐴓𐴢 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴘𐴧𐴠𐴥.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴞𐴀𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴧𐴠𐴥, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴁𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟, 𐴘𐴝𐴥𐴕𐴞 𐴊𐴞𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴥𐴕𐴝 𐴑𐴟𐴑𐴞𐴥𐴘𐴝𐴓𐴢, 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞, 𐴏𐴟𐴌𐴞, 𐴑𐴡𐴃𐴡𐴥𐴓𐴝𐴑𐴡𐴃𐴡𐴥𐴓𐴞,</char> <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" /><char style="wj">𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴁𐴡𐴖𐴢 𐴓𐴡𐴘 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞, 𐴓𐴝𐴓𐴏𐴞𐴥, 𐴁𐴟𐴌𐴝𐴘, 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴞, 𐴁𐴡𐴊𐴔𐴝𐴐𐴞, 𐴌𐴞𐴐𐴢, 𐴒𐴞𐴉𐴡𐴃𐴢, 𐴁𐴡𐴌𐴝𐴥𐴘, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴑𐴟𐴉𐴝𐴘 𐴀𐴝𐴘𐴧𐴠𐴤. </char> <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" /><char style="wj">𐴀𐴠 𐴁𐴟𐴌𐴝𐴘 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥.“ </char><verse eid="MRK 7:23" /></para>
  <para style="s1">𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴀𐴞𐴔𐴝𐴕</para>
  <para style="r">(<ref loc="MAT 15:21-28">𐴔𐴡𐴃𐴢 15‏:21‏-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />𐴀𐴞𐴏𐴝𐴤 𐴀𐴟𐴍𐴞𐴤 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴃𐴧𐴟 𐴄𐴝𐴘𐴝𐴥𐴌 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴑 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴊𐴞𐴃𐴡 𐴔𐴡𐴕 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴓𐴟𐴑𐴞 𐴃𐴝𐴥𐴑𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴑 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴠-𐴉𐴝𐴘𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴌𐴝 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴥𐴕𐴞 𐴔𐴡𐴃𐴧𐴡𐴌 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴦𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞, 𐴇𐴞𐴥𐴁𐴝 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴞𐴀𐴌𐴞𐴘𐴝 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴌 𐴂𐴠𐴕𐴞𐴐𐴞𐴥𐴘𐴝𐴌 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢. 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴇𐴠𐴥 𐴁𐴟𐴥𐴃𐴧𐴗𐴝 𐴕𐴠𐴦𐴓𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴒𐴠 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴞 𐴈𐴝𐴥𐴘𐴃𐴡 𐴊𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴓𐴡𐴦𐴘𐴢 𐴑𐴟𐴣𐴙𐴌𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴉𐴠𐴥𐴓𐴝𐴘 𐴊𐴡𐴥𐴕 𐴒𐴡𐴔 𐴕𐴡.“</char><verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥𐴘 𐴔𐴝𐴓𐴞𐴑, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴊𐴠 𐴔𐴠𐴏𐴡𐴌 𐴃𐴡𐴓𐴡𐴌 𐴑𐴟𐴣𐴘𐴌𐴠 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴌 𐴃𐴟𐴑𐴟𐴍𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴝𐴥𐴀.“<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠 𐴎𐴟𐴖𐴝𐴁𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴃𐴟𐴀𐴛 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴉𐴝𐴌𐴞𐴁𐴝𐴥; 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴁𐴟𐴥𐴃𐴢 𐴕𐴠𐴦𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘.“</char><verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />𐴇𐴞𐴥𐴁𐴝 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴎𐴝𐴘 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝 𐴁𐴞𐴏𐴝𐴥𐴕𐴝𐴃𐴢 𐴕𐴠𐴙𐴄𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴁𐴟𐴥𐴃𐴢 𐴕𐴠𐴦𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="MRK 7:30" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴕𐴝𐴥𐴉𐴝𐴚 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴥𐴃𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴄𐴝𐴘𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴥𐴊𐴡𐴕𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴊𐴠𐴑𐴝𐴂𐴡𐴥𐴓𐴞𐴏𐴢 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴔𐴝𐴎𐴡𐴥𐴃𐴧𐴟 𐴒𐴝𐴓𐴞𐴓𐴢 𐴋𐴞𐴀𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴠𐴎𐴧𐴡𐴕 𐴕𐴝𐴥𐴉𐴝𐴚 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴥𐴃𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴢 𐴊𐴞𐴃𐴡.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴑 𐴋𐴝𐴥𐴙𐴑𐴧𐴝 𐴓𐴡𐴘𐴎𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴦𐴣𐴓𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴊𐴟𐴕𐴞𐴥 𐴈𐴝𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴦𐴣𐴓𐴡𐴃𐴢 𐴏𐴠𐴥𐴂𐴢 𐴊𐴞𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴎𐴞𐴌 𐴏𐴟𐴥𐴘𐴧𐴠. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴋𐴡𐴣𐴀𐴌 𐴕𐴞𐴘𐴝𐴥𐴐𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴉𐴧𐴝𐴃𐴝“</char> 𐴘𐴝𐴥𐴕𐴞, <char style="wj">”𐴑𐴟𐴥𐴓𐴞𐴎𐴝𐴒𐴡𐴘.“ </char> <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />𐴃𐴡𐴥𐴘 𐴀𐴠𐴥𐴇𐴡𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴈𐴝𐴕 𐴕𐴟𐴥𐴕 𐴑𐴟𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴌 𐴀𐴠𐴌𐴞𐴊𐴞𐴘𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴃𐴡𐴤 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠𐴃𐴡𐴥 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥𐴃𐴡 𐴉𐴡𐴥𐴓𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴡. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴁𐴧𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴎𐴞𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴡 𐴕𐴝𐴥𐴉𐴝𐴚𐴡𐴌𐴠 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴀𐴝𐴦𐴌 𐴁𐴟𐴑𐴡𐴌𐴠 𐴔𐴝𐴃𐴞𐴁𐴝𐴥𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴠𐴦.“<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s1">𐴏𐴝𐴙𐴌 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴁𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 15:32-39">𐴔𐴡𐴃𐴢 15‏:32‏-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴃𐴢, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴁𐴝𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴈𐴝𐴥𐴘𐴃𐴡 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" /><char style="wj">”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴉𐴠𐴄𐴉𐴟𐴌𐴠𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴃𐴞𐴕 𐴊𐴞𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴝𐴦𐴌 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴈𐴝𐴥𐴘𐴃𐴡 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘.</char> <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" /><char style="wj">𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴖𐴝𐴀𐴐𐴧𐴝 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞, 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴔𐴝𐴃𐴝𐴥 𐴒𐴟𐴥𐴌𐴝𐴘 𐴉𐴡𐴌𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴐𐴞𐴤 𐴊𐴟𐴌𐴡𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤.“</char><verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴞 𐴈𐴝𐴥𐴁𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠 𐴁𐴡𐴐𐴡𐴥𐴃𐴞-𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴇𐴠𐴥𐴊𐴟𐴕 𐴌𐴟𐴄𐴞 𐴇𐴡𐴍𐴠𐴥 𐴉𐴝𐴘𐴁𐴡؟“<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴌𐴟𐴄𐴞 𐴈𐴡𐴖𐴝𐴤 𐴀𐴝𐴏𐴠𐴤؟“</char></para>
  <para style="p" vid="MRK 8:5">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝.“<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴠𐴍𐴞𐴃𐴢 𐴁𐴡𐴘𐴃𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥; 𐴁𐴝𐴦𐴊𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴌𐴟𐴄𐴞 𐴒𐴟𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴞𐴦 𐴁𐴡𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴥𐴚𐴒𐴞 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴝𐴍𐴞𐴊𐴞𐴘𐴠𐴥. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴈𐴡𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴌𐴝 𐴔𐴝𐴏𐴢 𐴀𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴓𐴧𐴝 𐴘𐴡𐴥 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴡𐴌𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴍𐴞𐴊𐴞𐴃𐴡 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴞 𐴈𐴝𐴥𐴘𐴧𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴎𐴠 𐴃𐴟𐴑𐴟𐴍𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴏𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴡𐴥𐴙𐴅𐴧𐴠 𐴌𐴝𐴥𐴌 𐴋𐴡𐴣𐴀𐴌 𐴓𐴝𐴘 𐴓𐴡𐴘 𐴇𐴝𐴥𐴣𐴃𐴢 𐴓𐴝𐴘 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />𐴇𐴠𐴥𐴍𐴠 𐴏𐴝𐴙𐴌 𐴀𐴝𐴥𐴎𐴝𐴌 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴁𐴠𐴍𐴝𐴀𐴙𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴞𐴊𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠, <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />𐴀𐴝𐴦𐴌 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴊𐴝𐴓𐴔𐴝𐴕𐴟𐴃𐴝 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="MRK 8:10" /></para>
  <para style="s1">𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕𐴡𐴌 𐴊𐴝𐴁𐴞</para>
  <para style="r">(<ref loc="MAT 16:1-4">𐴔𐴡𐴃𐴢 16‏:1‏-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />𐴉𐴡𐴌𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴃𐴡𐴌𐴑𐴝𐴃𐴡𐴌𐴑𐴞 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴠, 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴁𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴞 𐴕𐴞𐴘𐴝𐴥𐴐𐴢 𐴉𐴠𐴥𐴓𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴁𐴞 𐴑𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴈𐴝𐴤 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.“</char> <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴌𐴞, 𐴀𐴝𐴁𐴝𐴌 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴋𐴞𐴀𐴌 𐴀𐴡𐴑𐴟𐴓𐴠 𐴒𐴞𐴦𐴘𐴡𐴥𐴘.<verse eid="MRK 8:13" /></para>
  <para style="s1">𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴐𐴟𐴥𐴄𐴝𐴌</para>
  <para style="r">(<ref loc="MAT 16:5-12">𐴔𐴡𐴃𐴢 16‏:5‏-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />𐴀𐴝𐴦𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴌𐴟𐴄𐴞 𐴓𐴡𐴘𐴎𐴝𐴘𐴃𐴠𐴥 𐴉𐴡𐴀𐴌𐴝𐴘𐴒𐴞𐴓𐴒𐴡𐴘; 𐴕𐴡𐴦𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴌𐴟𐴄𐴞 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴞𐴐𐴡𐴥𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴇𐴡𐴥𐴁𐴡𐴌𐴡𐴊𐴧𐴝𐴌, 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴟𐴥𐴄𐴝𐴌𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴐𐴟𐴥𐴄𐴝𐴌𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡.“</char><verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴈𐴡𐴖𐴝𐴤𐴇𐴡𐴘 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴌𐴟𐴄𐴞 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝.“<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴌𐴟𐴄𐴞 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴘𐴝𐴥 𐴈𐴡𐴖𐴝𐴤𐴇𐴡𐴘 𐴒𐴡𐴌𐴡𐴤𐴌؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴡𐴥𐴃𐴢 𐴕𐴡𐴥 𐴉𐴡 𐴘𐴝𐴥 𐴕𐴡𐴥 𐴁𐴟𐴎𐴡𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴊𐴡𐴌𐴡𐴤 𐴊𐴠𐴥؟</char> <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴟𐴑 𐴃𐴝𐴥𐴘 𐴕𐴡 𐴊𐴠𐴑𐴡𐴥𐴌 𐴊𐴠𐴥؟ 𐴀𐴝𐴦𐴌 𐴈𐴝𐴕 𐴃𐴝𐴥𐴘 𐴕𐴡 𐴉𐴟𐴥𐴕𐴡𐴌 𐴊𐴠𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴕𐴡𐴃𐴢 𐴕𐴝𐴥𐴘 𐴕𐴠,</char> <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴓𐴧𐴝 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴌𐴟𐴄𐴞 𐴁𐴝𐴥𐴙𐴚𐴒𐴞𐴓𐴝𐴥𐴔 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴌𐴟𐴄𐴞𐴌 𐴃𐴟𐴑𐴟𐴍𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡 𐴁𐴝𐴥𐴙𐴌 𐴁𐴡𐴥𐴌𐴞 𐴓𐴡𐴀𐴘𐴓𐴝؟“ </char></para>
  <para style="p" vid="MRK 8:19">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴝𐴌𐴡𐴥 𐴁𐴝𐴥𐴙𐴌.“<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />
    <char style="wj">”𐴀𐴝𐴌𐴡𐴤, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴏𐴝𐴙𐴌 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴓𐴧𐴝 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴌𐴟𐴄𐴞 𐴁𐴝𐴥𐴙𐴚𐴒𐴞𐴓𐴝𐴥𐴔 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴌𐴟𐴄𐴞𐴌 𐴃𐴟𐴑𐴟𐴍𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡 𐴓𐴝𐴘 𐴁𐴡𐴥𐴌𐴞 𐴓𐴡𐴀𐴘𐴓𐴝؟“</char></para>
  <para style="p" vid="MRK 8:20">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴝𐴥𐴣𐴃𐴢 𐴓𐴝𐴘.“<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴕𐴡𐴥 𐴁𐴟𐴎𐴡𐴥 𐴊𐴠𐴥؟“</char><verse eid="MRK 8:21" /></para>
  <para style="s1">𐴁𐴠𐴃𐴏𐴝𐴥𐴘𐴊𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴀𐴠𐴑 𐴀𐴝𐴣𐴊𐴝𐴤𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴃𐴏𐴝𐴥𐴘𐴊𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴀𐴝𐴦𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴠𐴑 𐴀𐴝𐴣𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴀𐴝𐴕𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴏𐴟𐴥𐴘𐴃𐴡. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴡𐴥𐴌𐴞 𐴉𐴝𐴌𐴝𐴌 𐴁𐴝𐴀𐴌𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴏𐴠𐴥𐴂𐴢 𐴊𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴕𐴞𐴥 𐴀𐴝𐴥𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴊𐴞𐴥 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴑𐴠𐴏𐴧𐴟𐴥 𐴊𐴠𐴑𐴡𐴥𐴌 𐴕𐴠𐴥؟“</char><verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴖𐴡𐴌𐴔𐴞𐴑𐴧𐴝𐴥 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴠𐴑𐴞𐴥𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴝𐴘𐴃𐴠𐴥 𐴒𐴝𐴏𐴢 𐴀𐴝𐴥𐴣𐴍𐴠𐴌 𐴉𐴝𐴥𐴕 𐴓𐴝𐴒𐴠𐴌.“<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴁𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴠𐴑 𐴊𐴞𐴥𐴘𐴝𐴕𐴠 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴒𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞𐴘𐴠𐴥, <char style="wj">”𐴉𐴝𐴌𐴝𐴃𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡 𐴒𐴡𐴥𐴙𐴓𐴧𐴡.“</char><verse eid="MRK 8:26" /></para>
  <para style="s1">𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 16:13-20">𐴔𐴡𐴃𐴢 16‏:13‏-20</ref>; <ref loc="LUK 9:18-21">𐴓𐴟𐴑 9‏:18‏-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢, 𐴑𐴝𐴘𐴏𐴝𐴥𐴌𐴞𐴘𐴝 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴞 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴉𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴎𐴝𐴦𐴌𐴒𐴡𐴥𐴘; 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀؟“</char><verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴁𐴡𐴥𐴓𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝; 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀 𐴊𐴠, 𐴕𐴡𐴁𐴞 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢; 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀 𐴊𐴠, 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴒𐴧𐴗𐴝𐴤.“<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴈𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕؟“</char></para>
  <para style="p" vid="MRK 8:29">𐴉𐴞𐴃𐴡𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴇𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤.“<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴞𐴐𐴡𐴥𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴃𐴡𐴤.<verse eid="MRK 8:30" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴦𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 16:21-28">𐴔𐴡𐴃𐴢 16‏:21‏-28</ref>; <ref loc="LUK 9:22-27">𐴓𐴟𐴑 9‏:22‏-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴟𐴑 𐴉𐴝𐴦 𐴉𐴡𐴌𐴞𐴁𐴡𐴥; 𐴀𐴝𐴦𐴌 𐴔𐴟𐴌𐴟𐴁𐴧𐴞, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴞𐴕𐴑𐴝𐴌 𐴇𐴝𐴥𐴘𐴁𐴡; 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴞𐴕 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴘𐴧𐴠𐴥. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴞𐴕𐴝𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘 𐴁𐴟𐴎𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤 𐴉𐴞𐴥𐴌𐴞 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴐𐴡𐴥𐴘𐴃𐴝𐴕, 𐴀𐴝𐴣𐴀𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴊𐴟𐴌 𐴀𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴡𐴌 𐴊𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴀𐴟𐴎𐴟.“</char><verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴐𐴡𐴥𐴀 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴝𐴘𐴃𐴡𐴤 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴢 𐴁𐴡𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥 𐴏𐴝𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴏𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡.</char> <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" /><char style="wj">𐴑𐴞𐴦 𐴓𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴉𐴝𐴦, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴕𐴝𐴥𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴠؟</char> <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" /><char style="wj">𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴑𐴞𐴦 𐴊𐴞𐴦 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤؟</char> <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" /><char style="wj">𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴀𐴠 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴓𐴡𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤𐴌𐴠 𐴓𐴡𐴥𐴘 𐴐𐴡𐴥𐴌𐴔𐴝, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴡𐴥 𐴐𐴡𐴥𐴌𐴔𐴝𐴘𐴁𐴡 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴘𐴠 𐴂𐴝𐴑 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴘𐴁𐴡𐴤.“</char><verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠𐴍𐴠𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴝𐴦𐴑𐴡𐴃𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴕𐴡𐴥 𐴊𐴠𐴑𐴞𐴥𐴃𐴠 𐴕𐴡 𐴔𐴡𐴌𐴞𐴁𐴡𐴥.“</char><verse eid="MRK 9:1" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴁𐴡𐴊𐴡𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘</para>
  <para style="r">(<ref loc="MAT 17:1-13">𐴔𐴡𐴃𐴢 17‏:1‏-13</ref>; <ref loc="LUK 9:28-36">𐴓𐴟𐴑 9‏:28‏-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />𐴏𐴡𐴥 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴉𐴞𐴃𐴡𐴌 𐴀𐴡𐴌𐴠, 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴡𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌𐴠 𐴓𐴡𐴦𐴘𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥. 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴁𐴡𐴊𐴡𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌 𐴏𐴡𐴏𐴧𐴡𐴇𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴥𐴀𐴃𐴢 𐴊𐴡𐴥𐴓𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴠𐴀𐴕 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴇𐴡𐴕𐴡𐴤 𐴇𐴡𐴦𐴌 𐴊𐴟𐴥𐴖𐴡𐴘𐴝𐴘𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴡𐴥𐴓𐴝 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴀𐴏𐴝 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥, 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴏𐴞𐴤. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴍𐴠𐴥 𐴃𐴞𐴕 𐴕𐴝𐴥𐴕 𐴄𐴝𐴔𐴁𐴟 𐴄𐴝𐴑𐴞: 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝, 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴟𐴀𐴏𐴝𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴡𐴓𐴧𐴝.“ <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴕𐴞𐴎𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴞𐴘𐴟𐴥𐴓𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴖𐴝, 𐴀𐴞𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴡!“<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴘𐴌𐴡𐴥𐴔𐴞𐴑𐴧𐴝 𐴏𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴡𐴥 𐴊𐴠𐴑𐴠𐴥.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴓𐴝𐴔𐴠𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴃𐴡𐴤. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴘𐴝𐴦𐴊𐴢 𐴌𐴝𐴙𐴑𐴧𐴠𐴥. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴑𐴞𐴦 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴃𐴡𐴏𐴑𐴝𐴌𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴑𐴞𐴘𐴝𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀, 𐴀𐴝𐴒𐴠 𐴕𐴡𐴁𐴞 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴝𐴀𐴌 𐴎𐴡𐴌𐴟𐴌؟“<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴝𐴒𐴠 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴝𐴘𐴁𐴡𐴤 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴙𐴃𐴧𐴡 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴁𐴡. 𐴀𐴝𐴦𐴌 𐴃𐴡𐴀 𐴑𐴞𐴘𐴝𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴊𐴟𐴑 𐴉𐴝𐴦 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡؟ </char> <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴀𐴕 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴠𐴥𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤.“ </char><verse eid="MRK 9:13" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴠-𐴉𐴝𐴘𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴟𐴖𐴝 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 17:14-20">𐴔𐴡𐴃𐴢 17‏:14‏-20</ref>; <ref loc="LUK 9:37-43">𐴓𐴟𐴑 9‏:37‏-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴑𐴞 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴃𐴝𐴌𐴝𐴥𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴀𐴝𐴓𐴠𐴔𐴠 𐴃𐴝𐴌𐴝𐴥 𐴓𐴧𐴡𐴥𐴘 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞 𐴊𐴠𐴥𐴌. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />𐴊𐴡𐴓𐴢 𐴄𐴞𐴥𐴘𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴔𐴡𐴃𐴧𐴡𐴌 𐴁𐴞𐴐𐴞𐴤 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴊𐴟𐴣𐴌𐴞-𐴊𐴟𐴣𐴌𐴞 𐴎𐴝𐴦𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴑𐴞𐴦 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞 𐴊𐴡𐴥𐴌 𐴊𐴠𐴥؟“</char><verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />𐴊𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴞𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴁𐴟𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠 𐴊𐴠 𐴅𐴞𐴕𐴠 𐴉𐴝𐴘𐴧𐴠𐴥. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴇𐴠𐴥 𐴅𐴞𐴕𐴠 𐴊𐴡𐴥𐴌𐴠, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴔𐴠𐴍𐴞𐴃𐴢 𐴀𐴝𐴣𐴏𐴝𐴥𐴌 𐴔𐴝𐴌𐴠. 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴉𐴠𐴥𐴕𐴝 𐴀𐴝𐴘𐴧𐴠𐴤 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴊𐴝𐴃𐴠 𐴊𐴝𐴃𐴢 𐴑𐴞𐴌𐴑𐴞𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴌𐴡𐴤 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴇𐴠𐴥 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥 𐴕𐴠𐴦𐴓𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴈𐴡𐴀𐴘𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠.“<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴀𐴞𐴔𐴝𐴕 𐴏𐴝𐴥𐴌𐴝 𐴕𐴡𐴏𐴡𐴥𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴝𐴔؟ 𐴇𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟ 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴕𐴡𐴤.“</char><verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴊𐴡𐴥𐴌𐴉𐴡𐴌𐴝𐴁𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴃𐴡𐴥𐴘 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴔𐴠𐴍𐴞𐴃𐴢 𐴉𐴡𐴌𐴞 𐴀𐴞𐴑𐴧𐴝𐴤-𐴀𐴟𐴙𐴑𐴧𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴉𐴠𐴥𐴕𐴝 𐴕𐴠𐴦𐴓𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴀𐴞𐴃𐴠 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴓𐴡𐴥𐴃𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠؟“</char></para>
  <para style="p" vid="MRK 9:21">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴒𐴟𐴌𐴝 𐴇𐴝𐴓𐴠 𐴓𐴡𐴥𐴃𐴞. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥𐴘𐴠 𐴀𐴞𐴃𐴝𐴌𐴠𐴤 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴒𐴝𐴎𐴝𐴥 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴉𐴠𐴥𐴓𐴝. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴙𐴓𐴧𐴠, 𐴉𐴠𐴄𐴉𐴟𐴌𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤.“<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">” ’𐴎𐴡𐴊𐴞 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴙𐴓𐴧𐴠,‘ 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴦 𐴈𐴡𐴃𐴝𐴤؟ 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴓𐴧𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴠.“</char><verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />𐴀𐴠𐴥𐴇𐴡𐴕 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴁𐴝𐴉𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴡𐴌 𐴑𐴡𐴔𐴎𐴟𐴌𐴞 𐴄𐴞𐴥𐴑 𐴒𐴡𐴌𐴞𐴥𐴊𐴡.“<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴟𐴣𐴌𐴞-𐴊𐴟𐴣𐴌𐴞 𐴀𐴝𐴀𐴘𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥𐴌𐴠 𐴊𐴡𐴥𐴀𐴣𐴑 𐴊𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴠𐴥𐴘 𐴕𐴝𐴥𐴉𐴝𐴚 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴑 𐴅𐴞𐴕، 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴀𐴞𐴃𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴒𐴡𐴘, 𐴀𐴞𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴕𐴡 𐴒𐴡𐴥𐴓𐴞𐴐𐴢!“</char><verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥 𐴒𐴟𐴎𐴡𐴌𐴝𐴕 𐴔𐴝𐴌𐴞, 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴊𐴡𐴥𐴌𐴉𐴡𐴌𐴝𐴁𐴝𐴘 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴔𐴟𐴌𐴟𐴊𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴃𐴠 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘.“ <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴡𐴥𐴌𐴞 𐴃𐴟𐴙𐴓𐴧𐴠𐴥, 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴠 𐴀𐴟𐴍𐴞𐴤 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴘𐴝𐴥 𐴕𐴠𐴦𐴓𐴝𐴘 𐴕𐴡𐴥 𐴉𐴝𐴌𐴞؟“<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴊𐴟𐴖𐴝 𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴡𐴥𐴘 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴟𐴥𐴕 𐴕𐴠𐴦𐴓𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.“</char><verse eid="MRK 9:29" /></para>
  <para style="s1">𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴦𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴈𐴡𐴘𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 17:22-23">𐴔𐴡𐴃𐴢 17‏:22‏-23</ref>; <ref loc="LUK 9:43-45">𐴓𐴟𐴑 9‏:43‏-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴌𐴡𐴖𐴝𐴕𐴝 𐴓𐴡𐴘 𐴒𐴝𐴓𐴞𐴓𐴢 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦𐴌. 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴊𐴞𐴃𐴡 𐴔𐴡𐴕 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴃𐴡 𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴊𐴠, <char style="wj">”𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴃𐴞𐴕 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“</char> <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡𐴥 𐴁𐴟𐴎𐴞𐴥𐴃𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴘𐴡𐴥 𐴋𐴡𐴦𐴌𐴝𐴘𐴃𐴡𐴥.<verse eid="MRK 9:32" /></para>
  <para style="s1">𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴕𐴧𐴗𐴝𐴤؟</para>
  <para style="r">(<ref loc="MAT 18:1-5">𐴔𐴡𐴃𐴢 18‏:1‏-5</ref>; <ref loc="LUK 9:45-48">𐴓𐴟𐴑 9‏:45‏-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴀𐴞𐴏𐴝𐴤 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴡𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴑𐴞𐴘𐴡𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞 𐴊𐴞𐴥𐴓𐴝 𐴊𐴠𐴥؟“</char> <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴝𐴥𐴔 𐴔𐴝𐴥𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞 𐴊𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴕𐴧𐴗𐴝𐴤 𐴈𐴡𐴀𐴘𐴢.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />𐴁𐴡𐴀𐴘𐴢 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴠𐴥 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴝𐴃𐴧𐴟 𐴀𐴝𐴒𐴠 𐴀𐴡𐴥𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴞𐴏𐴠𐴤 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴁𐴡𐴕𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.“</char><verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴌𐴝 𐴉𐴟𐴖𐴝 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴝𐴎𐴠𐴥 𐴃𐴞𐴥𐴘𐴝𐴒𐴝𐴌𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴈𐴝𐴣𐴊𐴡𐴥𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" /><char style="wj">”𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴌𐴝 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠.“</char><verse eid="MRK 9:37" /></para>
  <para style="s1">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴕𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="LUK 9:49-50">𐴓𐴟𐴑 9‏:49‏-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔𐴠 𐴁𐴟𐴥𐴃𐴢 𐴕𐴠𐴦𐴓𐴝𐴌; 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴋𐴝𐴀𐴘𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴕𐴡 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥.“<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴕𐴝𐴥 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴈𐴡𐴀𐴘𐴢 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴝𐴥𐴘. </char> <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴕𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝.</char> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴑 𐴉𐴞𐴘𐴝𐴓𐴝 𐴉𐴝𐴕𐴞𐴥 𐴊𐴠𐴦, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴉𐴝𐴘 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="MRK 9:41" /></para>
  <para style="s1">𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴝𐴁𐴝𐴌 𐴀𐴠𐴕𐴃𐴝𐴥𐴕</para>
  <para style="r">(<ref loc="MAT 18:6-9">𐴔𐴡𐴃𐴢 18‏:6‏-9</ref>; <ref loc="LUK 17:1-2">𐴓𐴟𐴑 17‏:1‏-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴊𐴠 𐴀𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥𐴁𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴡𐴓𐴝𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴡𐴥𐴌 𐴐𐴞𐴥𐴓𐴡𐴌 𐴏𐴝𐴑𐴧𐴞 𐴁𐴝𐴣𐴊𐴞𐴥 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝.</char> <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" /><char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴟𐴎𐴟 𐴄𐴝𐴕𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴡. 𐴊𐴟𐴘 𐴀𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞 𐴎𐴟𐴎𐴟𐴑 𐴀𐴡𐴃𐴢, 𐴘𐴝𐴥𐴕𐴞 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴕𐴞𐴉𐴠𐴥 𐴊𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴎𐴝𐴦𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴄𐴟𐴥𐴣𐴍𐴝 𐴀𐴡𐴥𐴘 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴒𐴡𐴥𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌,</char> <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" /><char style="wj">𐴇𐴠𐴥 𐴎𐴟𐴎𐴟𐴑 𐴀𐴡𐴃𐴢,</char></para>
  <para style="q1" vid="MRK 9:44">
    <char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴈𐴝𐴥𐴀 𐴊𐴠 𐴓𐴡𐴒𐴢 𐴕𐴡 𐴔𐴡𐴌𐴠</char></para>
  <para style="q2" vid="MRK 9:44">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴡𐴦𐴙𐴕 𐴕𐴡 𐴕𐴞𐴉𐴠𐴥.</char><verse eid="MRK 9:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MRK 9:45" />
    <char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴄𐴠𐴥𐴚𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴟𐴎𐴟 𐴄𐴝𐴕𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴡. 𐴊𐴟𐴘 𐴄𐴠𐴥𐴚 𐴃𐴝𐴥𐴑𐴞 𐴎𐴟𐴎𐴟𐴑𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴓𐴠𐴚 𐴀𐴡𐴥𐴘 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴒𐴡𐴥𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌, </char> <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" /><char style="wj">𐴇𐴠𐴥 𐴎𐴟𐴎𐴟𐴑 𐴀𐴡𐴃𐴢,</char></para>
  <para style="q1" vid="MRK 9:46">
    <char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴈𐴝𐴥𐴀 𐴊𐴠 𐴓𐴡𐴒𐴢 𐴕𐴡 𐴔𐴡𐴌𐴠</char></para>
  <para style="q2" vid="MRK 9:46">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴡𐴦𐴙𐴕 𐴕𐴡 𐴕𐴞𐴉𐴠𐴥.</char><verse eid="MRK 9:46" /></para>
  <para style="m">
    <verse number="47" style="v" sid="MRK 9:47" />
    <char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴟𐴑𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴟𐴎𐴟 𐴄𐴝𐴕𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴘𐴞𐴥𐴁𐴝 𐴕𐴠𐴦𐴓𐴝𐴘𐴉𐴠𐴥𐴓𐴡. 𐴊𐴟𐴘 𐴏𐴟𐴑 𐴃𐴝𐴥𐴑𐴞 𐴎𐴟𐴎𐴟𐴑𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴟𐴑 𐴓𐴡𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌,</char> <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" /><char style="wj">𐴇𐴠𐴥 𐴎𐴟𐴎𐴟𐴑 𐴀𐴡𐴃𐴢,</char></para>
  <para style="q1" vid="MRK 9:48">
    <char style="wj">’𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴈𐴝𐴥𐴀 𐴊𐴠 𐴓𐴡𐴒𐴢 𐴕𐴡 𐴔𐴡𐴌𐴠</char></para>
  <para style="q2" vid="MRK 9:48">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴡𐴦𐴙𐴕 𐴕𐴡 𐴕𐴞𐴉𐴠𐴥.‘ </char>
    <note caller="+" style="f">
      <char style="fr" closed="false">9‏:48 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 66:24">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 66‏:24</ref>
        </char>
      </char>
    </note><verse eid="MRK 9:48" /></para>
  <para style="m">
    <verse number="49" style="v" sid="MRK 9:49" />
    <char style="wj">𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴎𐴡𐴕𐴡𐴌𐴠 𐴀𐴡𐴦𐴙𐴕 𐴓𐴡𐴘 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴟𐴌𐴁𐴝𐴕𐴞𐴌𐴠 𐴕𐴟𐴕 𐴓𐴡𐴘 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝.</char><verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />
    <char style="wj">”𐴕𐴟𐴕 𐴃𐴡 𐴒𐴡𐴔 𐴅𐴞𐴕𐴞𐴥𐴐𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴕𐴟𐴕𐴡𐴌 𐴊𐴡𐴑 𐴎𐴝𐴦𐴒𐴡𐴥𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴝𐴁𐴝𐴌 𐴕𐴟𐴕𐴐𐴝𐴥 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴟𐴕 𐴌𐴝𐴙𐴑𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴡𐴘 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴃𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴡.“</char><verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s1">𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="MAT 19:1-12">𐴔𐴡𐴃𐴢 19‏:1‏-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴃𐴟 𐴀𐴟𐴍𐴞𐴤, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝 𐴉𐴠𐴥𐴓𐴝𐴘 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴌 𐴉𐴝𐴌𐴑𐴟𐴓𐴠 𐴒𐴞𐴦𐴘𐴠𐴥. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴁𐴝𐴌 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴔𐴡𐴎𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴁𐴝𐴌 𐴎𐴝𐴘𐴠𐴏𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥؟“<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴞𐴦 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠؟“</char><verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴝𐴥𐴌𐴇𐴝𐴁𐴡𐴏𐴢 𐴓𐴠𐴑𐴞𐴥 𐴊𐴞𐴥 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥.“<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴊𐴡𐴌𐴡𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠.</char> <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴡𐴌𐴡𐴃𐴢 𐴀𐴝𐴦𐴌 𐴔𐴝𐴘𐴝 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥.</char><note caller="+" style="f"><char style="fr" closed="false">10‏:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 1:27">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 1‏:27</ref></char></char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" /><char style="wj">’𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴃𐴡 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴃𐴧𐴟 𐴎𐴟𐴊𐴝 𐴀𐴡𐴥𐴘 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡,</char> <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴀𐴠𐴑 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.‘</char><note caller="+" style="f"><char style="fr" closed="false">10‏:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 2‏:24</ref></char></char></note> <char style="wj">𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌 𐴊𐴟𐴘 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴑 𐴅𐴞𐴏𐴞𐴥𐴔.</char> <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴎𐴟𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴏𐴞𐴥𐴌𐴝 𐴕𐴡 𐴒𐴡𐴌𐴡𐴥𐴗𐴑.“</char><verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴝𐴁𐴝𐴌 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴀𐴟𐴓𐴋𐴝 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠.</char> <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴔𐴝𐴘𐴌𐴠 𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠.“</char><verse eid="MRK 10:12" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 19:13-15">𐴔𐴡𐴃𐴢 19‏:13‏-15</ref>; <ref loc="LUK 18:15-17">𐴓𐴟𐴑 18‏:15‏-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴕𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴟𐴥𐴖𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴘𐴧𐴠. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴁𐴞𐴐𐴞𐴤 𐴕𐴝𐴌𐴝𐴏𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴃𐴡𐴤𐴊𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴡 𐴀𐴡𐴀𐴛𐴓𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴠𐴥𐴕𐴝 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴌𐴝 𐴉𐴟𐴖𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴒𐴡𐴥𐴓𐴞 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.“</char> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴝𐴣𐴊𐴡𐴥𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘 𐴓𐴡𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥.<verse eid="MRK 10:16" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢</para>
  <para style="r">(<ref loc="MAT 19:16-30">𐴔𐴡𐴃𐴢 19‏:16‏-30</ref>; <ref loc="LUK 18:18-30">𐴓𐴟𐴑 18‏:18‏-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />𐴀𐴞𐴏𐴝𐴤 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴘𐴃𐴡 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴟𐴣𐴌𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴣𐴍𐴟𐴥𐴌 𐴃𐴡𐴥𐴑 𐴊𐴞𐴥 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴒𐴡𐴔 𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴘𐴃𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴞𐴦 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥؟“<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴡𐴔 𐴑𐴞𐴘𐴝𐴥 𐴋𐴝𐴑𐴡𐴀𐴌؟ 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴊𐴠 𐴃𐴡 𐴀𐴝𐴌 𐴑𐴞𐴘𐴠𐴥 𐴒𐴡𐴔 𐴕𐴝𐴥𐴘.</char> <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" /><char style="wj">𐴃𐴟𐴀𐴛 𐴊𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴕𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴑𐴞, ’𐴑𐴟𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴎𐴠𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴏𐴟𐴌𐴞 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴔𐴞𐴏𐴝𐴥 𐴒𐴡𐴁𐴝𐴤 𐴕𐴡 𐴊𐴞𐴁𐴝, 𐴉𐴠𐴥𐴌𐴡𐴑𐴁𐴝𐴎𐴞 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴁𐴝𐴉𐴔𐴝𐴦𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘ “</char> <note caller="+" style="f"><char style="fr" closed="false">10‏:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12-16">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 20‏:12‏-16</ref></char>; <char style="xt"><ref loc="DEU 5:16-20">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 5‏:16‏-20</ref></char></char></note><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴒𐴟𐴌𐴝𐴇𐴝𐴓𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴘𐴧𐴞𐴤𐴌.“<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴊𐴡𐴌 𐴓𐴝𐴒𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴈𐴝𐴔 𐴁𐴝𐴑𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴎𐴡𐴦, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴠𐴏𐴞 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴡𐴒𐴡𐴘, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴊𐴡𐴥𐴕 𐴉𐴝𐴘𐴁𐴝; 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴡𐴥𐴘𐴧𐴡𐴒𐴝𐴘.“</char><verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴠𐴎𐴝𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴊𐴡𐴥𐴕-𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴏𐴝𐴘𐴌𐴡𐴥𐴔𐴞𐴑𐴧𐴝 𐴏𐴝𐴀𐴘𐴢 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴢 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴃𐴠 𐴇𐴡𐴃𐴡𐴥 𐴔𐴡𐴐𐴑𐴞𐴓𐴢!“</char><verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤𐴘𐴠 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴉𐴟𐴀𐴝𐴙𐴕, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴃𐴠 𐴇𐴡𐴃𐴡𐴥 𐴔𐴡𐴐𐴑𐴞𐴓𐴢!</char> <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" /><char style="wj">𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴟𐴣𐴄𐴢 𐴉𐴟𐴥𐴣𐴐𐴡𐴌 𐴉𐴝𐴀𐴙𐴃𐴧𐴟 𐴒𐴡𐴓𐴞 𐴎𐴝𐴦 𐴀𐴝𐴌𐴡𐴤 𐴀𐴝𐴏𐴝𐴤𐴕.“ </char><verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴡𐴕𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟“<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴠 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴉𐴝𐴌𐴠; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠.“</char><verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴠𐴌𐴞𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴡𐴥𐴘𐴧𐴞.“<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴒𐴡𐴥𐴌, 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕, 𐴁𐴝𐴉𐴔𐴝𐴦, 𐴉𐴟𐴀𐴝𐴙𐴕, 𐴘𐴝𐴥 𐴎𐴝𐴒𐴝-𐴎𐴡𐴁𐴞𐴕 𐴀𐴠𐴌𐴞𐴊𐴞𐴘𐴠𐴥,</char> <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴒𐴟𐴕 𐴁𐴞𐴐𐴞𐴤 𐴒𐴡𐴥𐴌, 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕, 𐴔𐴝𐴦, 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴎𐴝𐴒𐴝-𐴎𐴡𐴁𐴞𐴕 𐴉𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴡𐴥 𐴉𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘𐴁𐴡.</char> <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴝𐴓𐴝 𐴀𐴝𐴒𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴞𐴏𐴠𐴤 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴝𐴓𐴝 𐴉𐴞𐴏𐴠𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴒𐴠 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“</char><verse eid="MRK 10:31" /></para>
  <para style="s1">𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴘𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 20:17-19">𐴔𐴡𐴃𐴢 20‏:17‏-19</ref>; <ref loc="LUK 18:31-34">𐴓𐴟𐴑 18‏:31‏-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴖𐴡𐴌𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴒𐴠-𐴀𐴝𐴒𐴠 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴠𐴑𐴧𐴞𐴕𐴝𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴑𐴞𐴦-𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, <char style="wj">”𐴏𐴡𐴀, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴖𐴡𐴌𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴙𐴌, 𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴡𐴦𐴃𐴡𐴌 𐴉𐴡𐴥𐴃𐴟𐴖𐴝 𐴊𐴞𐴥𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴁𐴡.</char> <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴕𐴐𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴏𐴠𐴥𐴂𐴢 𐴔𐴝𐴌𐴞𐴁𐴡𐴥, 𐴐𐴡𐴀𐴣𐴑 𐴔𐴝𐴌𐴞𐴁𐴡𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡. 𐴓𐴠𐴑𐴞𐴕 𐴃𐴞𐴕 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“</char><verse eid="MRK 10:34" /></para>
  <para style="s1">𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴀𐴝𐴌𐴡𐴏𐴢</para>
  <para style="r">(<ref loc="MAT 20:20-28">𐴔𐴡𐴃𐴢 20‏:20‏-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤.“<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴏𐴡𐴀𐴌 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴑𐴞𐴦 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟“</char><verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴁𐴝𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴝𐴘𐴧𐴡.“<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴔𐴝𐴒𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡. 𐴀𐴝𐴀𐴛 𐴉𐴞𐴀𐴘𐴟𐴔 𐴊𐴠 𐴉𐴞𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴞𐴀 𐴉𐴝𐴌𐴞𐴁𐴝𐴥 𐴕𐴠𐴥؟ 𐴘𐴝𐴥𐴃𐴡 𐴀𐴝𐴀𐴛 𐴓𐴡𐴘𐴧𐴟𐴔 𐴊𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴡𐴘 𐴉𐴝𐴌𐴞𐴁𐴝𐴥 𐴕𐴠𐴥؟“</char><verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴝𐴌𐴞𐴘𐴟𐴥𐴔.“</para>
  <para style="p" vid="MRK 10:39">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴁𐴠𐴐𐴡𐴥𐴑, 𐴎𐴠 𐴉𐴞𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴛 𐴉𐴞𐴀𐴘𐴟𐴔, 𐴘𐴞𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴞𐴀𐴁𐴝; 𐴀𐴝𐴦𐴌 𐴎𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴀𐴝𐴀𐴛 𐴓𐴡𐴘𐴧𐴟𐴔, 𐴘𐴞𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴡𐴘𐴁𐴝.</char> <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴘𐴝𐴥 𐴁𐴝𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴡𐴕 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴔 𐴕𐴡. 𐴎𐴝𐴒𐴝 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴘𐴠.“</char><verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />𐴁𐴝𐴑𐴞 𐴊𐴡𐴐𐴢 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞, 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴓𐴧𐴡𐴥𐴘 𐴒𐴟𐴐𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴎𐴝𐴕𐴝 𐴎𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴌𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴦𐴏𐴃𐴌𐴞 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴃𐴝𐴌𐴝𐴥𐴌 𐴋𐴡𐴣𐴀𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴝𐴌𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴏𐴡𐴓𐴝.</char> <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴕 𐴄𐴞𐴥𐴑 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘𐴃𐴡 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴁𐴡𐴕𐴝𐴌 𐴎𐴡𐴌𐴟𐴌;</char> <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" /><char style="wj">𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴒𐴠 𐴀𐴡𐴥𐴘𐴃𐴡 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴁𐴡𐴕𐴝𐴌 𐴎𐴡𐴌𐴟𐴌.</char> <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴡𐴥 𐴃𐴡 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴃𐴡.“</char><verse eid="MRK 10:45" /></para>
  <para style="s1">𐴀𐴝𐴣𐴊𐴝𐴤 𐴁𐴝𐴌𐴃𐴞𐴔𐴝𐴘𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 20:29-34">𐴔𐴡𐴃𐴢 20‏:29‏-34</ref>; <ref loc="LUK 18:35-43">𐴓𐴟𐴑 18‏:35‏-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴅𐴠𐴌𐴞𐴑𐴡𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴓𐴡𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴥𐴘 𐴅𐴠𐴌𐴞𐴑𐴡𐴥𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴠𐴌, 𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴃𐴞𐴔𐴝𐴥𐴘𐴧𐴟𐴏𐴡𐴌 𐴉𐴟𐴖𐴝 𐴁𐴝𐴌𐴃𐴞𐴔𐴝𐴘 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴣𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴌𐴝𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴇𐴡𐴥𐴌𐴝𐴃𐴢 𐴔𐴝𐴒𐴠𐴌 𐴊𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴏𐴝𐴥𐴌𐴞 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴟𐴎𐴡𐴌𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, ”𐴀𐴡𐴥 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤, 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤!“<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴘 𐴕𐴞𐴎𐴝𐴥𐴔 𐴀𐴡𐴥𐴘𐴃𐴡 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴞 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤!“<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴃𐴞𐴥𐴘𐴝𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴘𐴃𐴡𐴤 𐴈𐴡𐴀.“</char></para>
  <para style="p" vid="MRK 10:49">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴋𐴝𐴈𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴟𐴍𐴡𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴔𐴝𐴃𐴝𐴌.“ <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴦𐴌 𐴏𐴝𐴊𐴧𐴡𐴌 𐴀𐴠𐴑𐴧𐴞𐴕𐴝𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘, 𐴉𐴝𐴥𐴓𐴢 𐴊𐴞𐴥 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴑𐴞𐴦 𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴑𐴞𐴦 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟“</char></para>
  <para style="p" vid="MRK 10:51">𐴀𐴝𐴣𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴌𐴝𐴁𐴧𐴞𐴥, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴁𐴝𐴌 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴙𐴃𐴧𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌.“<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴦, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴞𐴔𐴝𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.“</char> 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴠𐴥𐴇𐴡𐴕 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴌𐴝𐴏𐴃𐴝𐴃𐴧𐴟 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s1">𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴒𐴡𐴥𐴙𐴓𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 21:1-11">𐴔𐴡𐴃𐴢 21‏:1‏-11</ref>; <ref loc="LUK 19:28-40">𐴓𐴟𐴑 19‏:28‏-40</ref>; <ref loc="JHN 12:12-19">𐴘𐴡 12‏:12‏-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴠𐴃𐴉𐴠𐴥𐴒𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴡𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴟𐴀𐴔𐴡𐴌 𐴉𐴝𐴌𐴝 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴦, 𐴇𐴠𐴥𐴍𐴠 𐴒𐴡𐴥𐴓𐴞 𐴔𐴡𐴃𐴧𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴝𐴊𐴝𐴤𐴌 𐴏𐴡𐴥𐴀 𐴁𐴝𐴙𐴕𐴊𐴝𐴤 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴁𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡𐴥 𐴏𐴡𐴌𐴠𐴤. 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴓𐴞 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴕𐴡𐴤𐴒𐴡𐴘.</char> <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" /><char style="wj">𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴀𐴕 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤𐴌؟‘ 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑𐴡𐴃𐴧𐴟 𐴘𐴞𐴁𐴝𐴤𐴌𐴠 𐴓𐴝𐴒𐴠𐴌.‘ 𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴠𐴍𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴞𐴁𐴡.“</char><verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴡𐴖𐴝𐴕𐴝 𐴓𐴡𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴒𐴝𐴊𐴝𐴤𐴌 𐴏𐴡𐴥𐴀 𐴖𐴝𐴌𐴠 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴌𐴝𐴏𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴥𐴌𐴡𐴌 𐴊𐴡𐴌𐴡𐴎𐴝𐴃𐴢 𐴁𐴝𐴙𐴕𐴊𐴝𐴤 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴓𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴠. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴃𐴝𐴌𐴝𐴥𐴃𐴧𐴟 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴒𐴡𐴌𐴡𐴤𐴌 𐴊𐴠, 𐴒𐴝𐴊𐴝𐴤𐴌 𐴏𐴡𐴥𐴀 𐴖𐴝𐴌𐴠 𐴑𐴟𐴥𐴓𐴡𐴌 𐴊𐴠 𐴕𐴞𐴥𐴑𐴞؟“ <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴃𐴡𐴤 𐴈𐴡𐴀𐴙𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴃𐴡𐴥𐴘 𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴝𐴊𐴝𐴤𐴌 𐴏𐴡𐴥𐴀 𐴖𐴝𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴦𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴞𐴐𐴝𐴥𐴘𐴊𐴞𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴘𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴦𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴌𐴝𐴏𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴞𐴐𐴝𐴥𐴘𐴊𐴞𐴘𐴠, 𐴀𐴝𐴌𐴒𐴟𐴥𐴕𐴠 𐴁𐴝𐴌𐴞𐴎𐴝𐴃𐴧𐴟 𐴉𐴝𐴃𐴝𐴌 𐴋𐴝𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴝𐴍𐴞 𐴁𐴞𐴐𐴝𐴥𐴘𐴊𐴞𐴘𐴠. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴒𐴠-𐴀𐴝𐴒𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="MRK 11:9">”𐴇𐴡𐴥𐴏𐴝𐴕𐴝!</para>
  <para style="b" vid="MRK 11:9" />
  <para style="q1" vid="MRK 11:9">”𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.<note caller="+" style="f"><char style="fr" closed="false">11‏:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:25">𐴎𐴡𐴁𐴟𐴌 118‏:25</ref>‏,<ref loc="PSA 118:26">26</ref></char></char></note><verse eid="MRK 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />”𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.</para>
  <para style="b" vid="MRK 11:10" />
  <para style="q1" vid="MRK 11:10">”𐴀𐴠𐴁𐴧𐴠 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑!“<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />𐴀𐴞𐴏𐴝𐴤 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴁𐴝𐴦𐴊𐴠, 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴔𐴞𐴑𐴧𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴏𐴝𐴀𐴘𐴧𐴡𐴌𐴠, 𐴇𐴝𐴥𐴣𐴎𐴞𐴕𐴧𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="MRK 11:11" /></para>
  <para style="s1">𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴌𐴠 𐴁𐴡𐴊𐴧𐴟𐴖𐴝</para>
  <para style="r">(<ref loc="MAT 21:18-19">𐴔𐴡𐴃𐴢 21‏:18‏-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />𐴃𐴝𐴌𐴉𐴡𐴌 𐴊𐴞𐴕، 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝𐴃𐴧𐴟 𐴁𐴝𐴐𐴝𐴥 𐴓𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴁𐴟𐴥𐴑 𐴓𐴝𐴙𐴒𐴧𐴠𐴥. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴟𐴌𐴡𐴃𐴧𐴟 𐴃𐴝𐴥𐴘 𐴉𐴝𐴃𐴝 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴊𐴠𐴑𐴞𐴥, 𐴘𐴞𐴥𐴁𐴝𐴃𐴢 𐴒𐴟𐴓𐴝 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥 𐴏𐴝𐴘𐴃𐴡𐴥 𐴒𐴞𐴦𐴘𐴠𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥𐴌 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴉𐴝𐴃𐴝 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡𐴥 𐴉𐴝𐴦, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴋𐴟𐴣𐴙𐴌 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴞𐴁𐴝𐴌 𐴔𐴡𐴀𐴏𐴟𐴔 𐴕𐴡. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴃𐴡𐴌𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴒𐴟𐴓𐴝 𐴇𐴝𐴥𐴘 𐴕𐴡 𐴉𐴝𐴌𐴡𐴗𐴑.“</char> 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴢.<verse eid="MRK 11:14" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 21:12-17">𐴔𐴡𐴃𐴢 21‏:12‏-17</ref>; <ref loc="LUK 19:45-48">𐴓𐴟𐴑 19‏:45‏-48</ref>; <ref loc="JHN 2:13-22">𐴘𐴡 2‏:13‏-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠. 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥𐴍𐴠 𐴁𐴠𐴏𐴝 𐴑𐴞𐴕𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴓𐴡𐴌𐴝𐴘𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴄𐴧𐴝 𐴁𐴝𐴥𐴚𐴒𐴡𐴘𐴝𐴌 𐴄𐴠𐴁𐴞𐴥𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴈𐴡𐴘𐴃𐴡𐴌 𐴁𐴠𐴏𐴡𐴘𐴝𐴌 𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴝𐴃𐴋𐴞𐴘𐴝𐴒𐴝𐴌𐴝𐴘 𐴊𐴞𐴘𐴠𐴥. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕 𐴁𐴝𐴥𐴘 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴔𐴝𐴓𐴏𐴝𐴥𐴔𐴝𐴕 𐴓𐴡𐴘𐴎𐴝𐴘𐴃𐴡𐴥 𐴕𐴡𐴥 𐴊𐴠. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴑𐴞 𐴘𐴝𐴀𐴕 𐴕𐴝𐴥𐴘, ’𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴡𐴌𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴔𐴟𐴕𐴝𐴎𐴝𐴃𐴡𐴌 𐴒𐴡𐴥𐴌 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴁𐴡‘</char><note caller="+" style="f"><char style="fr" closed="false">11‏:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 56:7">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 56‏:7</ref></char></char></note><char style="wj">؟ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴡𐴌 𐴀𐴝𐴋𐴧𐴝-𐴈𐴝𐴥𐴕𐴝 𐴁𐴝𐴕𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴡.“</char><note caller="+" style="f"><char style="fr" closed="false">11‏:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 7:11">𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝 7‏:11</ref></char></char></note><verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴔𐴡𐴑𐴝 𐴃𐴟𐴖𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴃𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴠 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴝𐴥𐴣𐴎𐴞𐴕𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="MRK 11:19" /></para>
  <para style="s1">𐴉𐴟𐴥𐴖𐴝𐴘𐴧𐴝 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴃𐴧𐴟 𐴏𐴠𐴥𐴁𐴡𐴑</para>
  <para style="r">(<ref loc="MAT 21:20-22">𐴔𐴡𐴃𐴢 21‏:20‏-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />𐴁𐴞𐴀𐴕𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥 𐴐𐴞𐴥𐴛𐴡𐴌𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴉𐴟𐴥𐴖𐴝𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />𐴉𐴞𐴃𐴡𐴌𐴡𐴃𐴧𐴟 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥, 𐴏𐴡𐴀, 𐴃𐴟𐴀𐴛 𐴁𐴡𐴊𐴧𐴟𐴖𐴝 𐴊𐴞𐴀𐴓𐴝 𐴊𐴠 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥 𐴉𐴟𐴥𐴖𐴝𐴘𐴒𐴞𐴘𐴡𐴘.“<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴑𐴡𐴥.</char> <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴀𐴠 𐴉𐴝𐴀𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀, ’𐴀𐴟𐴍𐴞𐴤 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴉𐴡𐴌𐴒𐴡𐴥𐴘,‘ 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴐𐴡𐴥𐴑 𐴕𐴡 𐴌𐴝𐴑𐴠𐴥 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴓𐴧𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴖𐴝𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴎𐴞𐴀𐴕 𐴔𐴝𐴒𐴡, 𐴇𐴞𐴥𐴀𐴕 𐴉𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴡 𐴁𐴡𐴥𐴓𐴞 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴞𐴥𐴘𐴝𐴘 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠.</char> <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴔𐴝𐴉𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴔𐴝𐴉𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.“</char><verse eid="MRK 11:26" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 21:23-27">𐴔𐴡𐴃𐴢 21‏:23‏-27</ref>; <ref loc="LUK 20:1-8">𐴓𐴟𐴑 20‏:1‏-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴁𐴝𐴌 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴒𐴟𐴥𐴌𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴈𐴝𐴔 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴠 𐴒𐴡𐴌𐴡𐴤𐴌؟ 𐴀𐴞𐴀𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴇𐴡𐴕𐴠 𐴊𐴞𐴦𐴘𐴠𐴥؟“<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴡, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴀𐴝𐴀𐴛 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴠 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠.</char> <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" /><char style="wj">𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴡 𐴏𐴝𐴥𐴘, 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴉𐴝𐴀𐴙𐴓𐴢 𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴀𐴡𐴃𐴧𐴟؟“</char><verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴁𐴞𐴘𐴝𐴏𐴝𐴕𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴈𐴡𐴀𐴘𐴢, ’𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴡𐴃𐴧𐴟,‘ 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴑𐴞𐴘𐴝𐴥 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤؟‘ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴈𐴡𐴀𐴘𐴢, ’𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴀𐴡𐴃𐴧𐴟‘ 𐴃𐴡𐴥𐴀𐴘𐴓𐴠؟“ 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴃𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴕𐴡𐴁𐴞 𐴊𐴠 𐴔𐴝𐴙𐴕𐴃𐴡.<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴞.“</para>
  <para style="p" vid="MRK 11:33">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴀𐴝𐴀𐴛 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴠 𐴒𐴡𐴌𐴞𐴥𐴌.“</char><verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s1">𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴐𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 21:33-46">𐴔𐴡𐴃𐴢 21‏:33‏-46</ref>; <ref loc="LUK 20:9-19">𐴓𐴟𐴑 20‏:9‏-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, <char style="wj">”𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝 𐴓𐴝𐴒𐴝𐴘𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴒𐴞𐴥𐴌𐴝 𐴊𐴞𐴥𐴘𐴠, 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴕𐴠𐴦𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴝𐴣𐴌𐴝𐴥 𐴑𐴟𐴙𐴅𐴧𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴄𐴡𐴚𐴑𐴞 𐴁𐴝𐴙𐴕𐴊𐴠𐴤. 𐴁𐴝𐴦𐴊𐴠 𐴁𐴝𐴌𐴞𐴎𐴝 𐴒𐴝𐴥𐴕 𐴐𐴝𐴐𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴄𐴠𐴥𐴑𐴝 𐴊𐴞𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴡𐴥𐴘.</char> <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴀𐴝𐴙𐴕𐴊𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴡𐴗𐴀𐴌𐴡𐴌𐴠 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴐𐴝𐴐𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴒𐴟𐴓𐴝𐴌 𐴁𐴝𐴥𐴑 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝.</char> <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞, 𐴔𐴝𐴌𐴝-𐴊𐴡𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴇𐴝𐴥𐴓𐴞 𐴀𐴝𐴥𐴃𐴠 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞𐴘𐴠𐴥.</char> <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴡𐴗𐴀𐴌 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴌𐴠𐴥 𐴔𐴝𐴃𐴝𐴥 𐴏𐴝𐴥𐴘 𐴔𐴝𐴌𐴞 𐴁𐴞𐴐𐴞𐴤 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴌𐴠𐴥 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴗𐴀𐴃𐴧𐴗𐴝𐴌𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴌𐴝-𐴊𐴡𐴥𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.</char><verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />
    <char style="wj">”𐴘𐴝𐴓𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴖𐴝. 𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴒𐴝𐴤 𐴕𐴞𐴎𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, ’𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.‘</char><verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴠 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴞𐴃𐴠 𐴃𐴡 𐴔𐴞𐴌𐴝𐴏𐴊𐴝𐴥𐴌; 𐴀𐴝𐴘𐴧𐴡𐴤 𐴀𐴞𐴃𐴝𐴌𐴠𐴤 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘, 𐴁𐴝𐴦𐴊𐴠 𐴔𐴞𐴌𐴝𐴏𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.‘</char> <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" /><char style="wj">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴁𐴝𐴀𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴠.</char><verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />
    <char style="wj">”𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴑𐴞𐴦 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌؟ 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴇𐴠𐴥 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴌𐴞𐴎𐴝 𐴒𐴝𐴥𐴕 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡.</char> <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴘𐴝𐴀𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡𐴥 𐴉𐴡𐴌𐴡𐴥 𐴕𐴞𐴥𐴑𐴞,</char></para>
  <para style="q1" vid="MRK 12:10">
    <char style="wj">’𐴎𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴔𐴞𐴏𐴃𐴞𐴥𐴌𐴞𐴘𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠,</char></para>
  <para style="q2" vid="MRK 12:10">
    <char style="wj">𐴘𐴞𐴥𐴁𐴝 𐴐𐴞𐴥𐴓𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴌𐴟𐴌𐴞 𐴖𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.</char><verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />
    <char style="wj">𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴡𐴥𐴘𐴀𐴝𐴙𐴐𐴧𐴠,</char></para>
  <para style="q2" vid="MRK 12:11">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12‏:11 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 118:22">𐴎𐴡𐴁𐴟𐴌 118‏:22</ref>‏,<ref loc="PSA 118:23">23</ref></char>
      </char>
    </note> <char style="wj">؟“ </char><verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴎𐴞𐴥𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴑𐴞 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴠𐴥 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴋𐴡𐴦𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴌𐴞 𐴒𐴞𐴀𐴓𐴒𐴡𐴘.<verse eid="MRK 12:12" /></para>
  <para style="s1">𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴊𐴞𐴦𐴘𐴝</para>
  <para style="r">(<ref loc="MAT 22:15-22">𐴔𐴡𐴃𐴢 22‏:15‏-22</ref>; <ref loc="LUK 20:20-26">𐴓𐴟𐴑 20‏:20‏-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴠𐴊𐴧𐴠 𐴈𐴠𐴥𐴌𐴟𐴊𐴞𐴀𐴡𐴥𐴓𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴘 𐴈𐴡𐴓𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴌𐴠. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />𐴃𐴝𐴌𐴝𐴥 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴃𐴟𐴀𐴛 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀. 𐴃𐴟𐴀𐴛 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴉𐴡𐴌𐴁𐴝 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴏𐴃𐴝𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴡. 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴏𐴝𐴘, 𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝<note caller="+" style="f"><char style="fr" closed="false">12‏:14 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑𐴡𐴃𐴢 𐴑𐴝𐴥𐴘𐴏𐴝𐴌 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴝𐴔 𐴕𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴡𐴔 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴡𐴑𐴡𐴥𐴁𐴢. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠.</char></note>𐴌𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴊𐴡𐴦𐴕 𐴎𐴝𐴘𐴠𐴏𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠 𐴕𐴝𐴥𐴘؟ <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴞𐴦𐴃𐴝𐴔 𐴕𐴠 𐴕𐴝𐴥𐴑𐴞 𐴕𐴡 𐴊𐴞𐴦𐴃𐴝𐴔؟“</para>
  <para style="p" vid="MRK 12:15">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴌𐴝𐴥𐴌 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑𐴞𐴌𐴠 𐴎𐴝𐴕𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴡𐴤𐴌 𐴑𐴞𐴘𐴝𐴥؟ 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴞𐴕𐴝𐴥𐴌 𐴀𐴝𐴕𐴡𐴤.“</char> <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />𐴃𐴡𐴥𐴘 𐴃𐴝𐴌𐴝𐴥 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴝𐴀𐴕 𐴇𐴝𐴌 𐴏𐴡𐴥𐴁𐴞 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴌 𐴕𐴝𐴔؟“</char></para>
  <para style="p" vid="MRK 12:16">𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌.“<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴞𐴀𐴕 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴡, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴡.“</char></para>
  <para style="p" vid="MRK 12:17">𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴃𐴝𐴌𐴝𐴥 𐴀𐴠𐴁𐴧𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MRK 12:17" /></para>
  <para style="s1">𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 22:23-33">𐴔𐴡𐴃𐴢 22‏:23‏-33</ref>; <ref loc="LUK 20:27-40">𐴓𐴟𐴑 20‏:27‏-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />𐴁𐴝𐴦𐴊𐴠 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴝𐴥𐴣𐴐𐴡𐴌 𐴕𐴝𐴥𐴘 𐴈𐴡𐴀, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴁𐴝𐴥𐴘 𐴉𐴟𐴀𐴝𐴙𐴕 𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴌𐴞𐴎𐴝𐴒𐴡𐴥𐴘 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴡𐴖𐴢 𐴃𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴇𐴠𐴥 𐴁𐴝𐴥𐴘𐴡𐴃𐴧𐴟 𐴁𐴡𐴖𐴢 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴓𐴧𐴝 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />𐴊𐴡𐴥𐴌𐴡, 𐴇𐴝𐴥𐴣𐴃𐴢 𐴎𐴡𐴕 𐴁𐴝𐴥𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴉𐴡𐴀𐴘𐴓𐴝 𐴖𐴝𐴘𐴠 𐴁𐴡𐴖𐴢 𐴓𐴡𐴦𐴘𐴢, 𐴉𐴟𐴀𐴝𐴙𐴕 𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴖𐴝𐴘𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘; 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴖𐴝𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴇𐴝𐴥𐴣𐴃𐴡 𐴁𐴝𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. 𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢, 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴘𐴡𐴥 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴇𐴝𐴓𐴠 𐴇𐴞𐴥𐴁𐴝 𐴇𐴝𐴌 𐴁𐴡𐴖𐴢 𐴀𐴡𐴥𐴘𐴁𐴡؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴡 𐴇𐴝𐴥𐴣𐴃𐴡 𐴎𐴡𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴁𐴝𐴕𐴝𐴀𐴙𐴓𐴢.“<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴠𐴥𐴕𐴝 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴡𐴤 𐴊𐴠! 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴕𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴎𐴝𐴕𐴡.</char> <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" /><char style="wj">𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴔𐴟𐴀𐴏𐴝𐴌 𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴎𐴠𐴍𐴠𐴥 𐴕𐴞𐴑𐴞 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴎𐴝𐴥𐴋𐴧𐴗𐴝𐴌 𐴎𐴞𐴑𐴞𐴥𐴌 𐴀𐴝𐴏𐴠𐴤 𐴇𐴠𐴥𐴍𐴠 𐴕𐴡𐴥 𐴉𐴡𐴌𐴡𐴥, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴔𐴟𐴀𐴏𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑𐴡𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴀𐴝𐴓𐴧𐴝؟‘</char><note caller="+" style="f"><char style="fr" closed="false">12‏:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 3‏:6</ref></char></char></note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" /><char style="wj">𐴀𐴝𐴓𐴧𐴝 𐴃𐴡 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴥𐴕𐴝. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠.“</char><verse eid="MRK 12:27" /></para>
  <para style="s1">𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔</para>
  <para style="r">(<ref loc="MAT 22:34-40">𐴔𐴡𐴃𐴢 22‏:34‏-40</ref>; <ref loc="LUK 10:25-28">𐴓𐴟𐴑 10‏:25‏-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴝𐴓𐴠𐴔 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞 𐴊𐴠𐴥𐴌 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴄𐴞𐴥𐴑 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠 𐴎𐴝𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴇𐴡𐴥𐴑𐴟𐴔 𐴇𐴡𐴕 𐴕𐴝𐴥𐴕 𐴋𐴡𐴣𐴀𐴌؟“<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, ’𐴉𐴟𐴥𐴕𐴡, 𐴀𐴡𐴥 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢! 𐴔𐴝𐴁𐴟𐴊𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴔𐴝𐴁𐴟𐴊𐴢.</char> <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" /><char style="wj">𐴔𐴝𐴁𐴟𐴊𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴌𐴝 𐴊𐴞𐴓𐴠, 𐴉𐴟𐴌𐴝 𐴎𐴝𐴕𐴠, 𐴉𐴟𐴌𐴝 𐴊𐴠𐴔𐴝𐴑𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴌𐴝 𐴁𐴡𐴓𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘</char><note caller="+" style="f"><char style="fr" closed="false">12‏:30 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:4">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 6‏:4</ref>‏,<ref loc="DEU 6:5">5</ref></char></char></note> <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" /><char style="wj">𐴊𐴟𐴘 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴒𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, ’𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘</char><note caller="+" style="f"><char style="fr" closed="false">12‏:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 19‏:18</ref></char></char></note> <char style="wj">𐴇𐴠𐴥 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴀𐴝𐴌 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴕𐴝𐴥𐴘.“</char><verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />𐴀𐴝𐴓𐴠𐴔𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴐𐴝𐴁𐴝𐴥𐴐𐴢, 𐴀𐴟𐴏𐴃𐴝𐴃𐴢! 𐴃𐴟𐴀𐴛 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴀𐴝𐴓𐴧𐴝 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴁𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴁𐴝 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴝𐴥𐴘. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴟𐴌𐴝 𐴊𐴞𐴓𐴠, 𐴉𐴟𐴌𐴝 𐴁𐴟𐴊𐴧𐴞𐴥𐴘𐴠, 𐴉𐴟𐴌𐴝 𐴁𐴡𐴓𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥. 𐴇𐴡𐴥𐴑𐴟𐴔 𐴇𐴠𐴥 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕, 𐴉𐴟𐴌𐴝 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴎𐴡𐴌𐴟𐴌𐴞.“<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴟𐴊𐴧𐴞𐴥𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴕𐴡.“</char> 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴌 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴠 𐴕𐴡𐴥 𐴊𐴠.<verse eid="MRK 12:34" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 22:41-46">𐴔𐴡𐴃𐴢 22‏:41‏-46</ref>; <ref loc="LUK 20:41-44">𐴓𐴟𐴑 20‏:41‏-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴠𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴀 𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝؟</char> <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴝𐴖𐴟𐴊𐴢 𐴕𐴞𐴎𐴠 𐴃𐴡 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥,</char></para>
  <para style="q1" vid="MRK 12:36">
    <char style="wj">’𐴔𐴝𐴁𐴟𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠,</char></para>
  <para style="q2" vid="MRK 12:36">
    <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴡𐴘𐴧𐴡𐴥,</char></para>
  <para style="q1" vid="MRK 12:36">
    <char style="wj">𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠</char></para>
  <para style="q2" vid="MRK 12:36">
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴡𐴦𐴌 𐴃𐴡𐴓𐴠 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴠𐴓𐴝𐴘.“ ‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12‏:36 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 110:1">𐴎𐴡𐴁𐴟𐴌 110‏:1</ref>
        </char>
      </char>
    </note><verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />
    <char style="wj">𐴊𐴝𐴖𐴟𐴊𐴢 𐴕𐴞𐴎𐴠 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 ’𐴔𐴝𐴓𐴞𐴑‘ 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕 𐴁𐴡𐴃𐴠 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠؟“</char> 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴉𐴟𐴥𐴕𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MRK 12:37" /></para>
  <para style="s1">𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴑𐴞𐴁𐴝𐴌 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢</para>
  <para style="r">(<ref loc="MAT 23:1-36">𐴔𐴡𐴃𐴢 23‏:1‏-36</ref>; <ref loc="LUK 20:45-47">𐴓𐴟𐴑 20‏:45‏-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴃𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴓𐴝𐴔𐴁𐴝-𐴓𐴝𐴔𐴁𐴝 𐴑𐴟𐴌𐴟𐴃𐴝 𐴉𐴞𐴣𐴊𐴞𐴥 𐴒𐴟𐴥𐴌𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴝𐴀, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴎𐴝𐴌𐴠-𐴁𐴝𐴎𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴉𐴝𐴘𐴃𐴡,</char> <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" /><char style="wj">𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴃𐴡𐴑𐴧𐴝𐴌 𐴇𐴝𐴊𐴞𐴌𐴝𐴤𐴃𐴢 𐴁𐴡𐴘𐴃𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴔𐴠𐴓𐴝-𐴐𐴡𐴥𐴁𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴁𐴝𐴌𐴞𐴥𐴑 𐴎𐴝𐴒𐴝𐴃𐴢 𐴁𐴡𐴘𐴃𐴡𐴥 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" /><char style="wj">𐴀𐴠𐴑 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴡𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴟𐴄𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠, 𐴀𐴝𐴌𐴀𐴠𐴑 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝 𐴓𐴝𐴔𐴁𐴝-𐴓𐴝𐴔𐴁𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴞𐴥𐴀𐴕𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴣𐴀𐴌 𐴉𐴝𐴘𐴁𐴡.“</char><verse eid="MRK 12:40" /></para>
  <para style="s1">𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴌𐴝𐴌𐴞𐴌 𐴏𐴡𐴥𐴃𐴑𐴝</para>
  <para style="r">(<ref loc="LUK 21:1-4">𐴓𐴟𐴑 21‏:1‏-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴊𐴝𐴕-𐴁𐴝𐴐𐴧𐴟𐴤𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴁𐴡𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴊𐴝𐴕-𐴁𐴝𐴐𐴧𐴟𐴤𐴃𐴢 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴄𐴞𐴛𐴝-𐴉𐴡𐴘𐴐𐴝𐴤 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴠𐴦𐴌 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. 𐴁𐴡𐴀𐴗𐴃𐴢 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴞𐴐𐴞𐴤-𐴁𐴞𐴐𐴞𐴤 𐴊𐴞𐴦𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴡𐴌𐴞𐴉𐴢 𐴌𐴝𐴌𐴞 𐴀𐴝𐴀𐴘𐴢 𐴊𐴟𐴘𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴣𐴍𐴡 𐴉𐴡𐴘𐴐𐴝𐴤 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴇𐴡𐴀𐴠𐴑 𐴉𐴞𐴘𐴝𐴤.<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴊𐴟𐴥𐴕𐴠 𐴊𐴝𐴕-𐴁𐴝𐴐𐴧𐴟𐴤𐴃𐴢 𐴏𐴡𐴥𐴃𐴑𐴝 𐴊𐴞𐴦𐴘𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴀𐴠 𐴒𐴡𐴌𐴞𐴉𐴢 𐴌𐴝𐴌𐴞 𐴖𐴝𐴘𐴠 𐴁𐴞𐴐𐴞𐴤 𐴊𐴞𐴦𐴘𐴠𐴥;</char> <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴄𐴝𐴓𐴞𐴑𐴧𐴝 𐴊𐴡𐴥𐴕𐴡𐴃𐴧𐴟 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴌𐴞𐴉𐴢 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞 𐴁𐴡𐴓𐴧𐴝 𐴎𐴞𐴀𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.“</char><verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s1">𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴖𐴝𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 24:1-2">𐴔𐴡𐴃𐴢 24‏:1‏-2</ref>; <ref loc="LUK 21:5-6">𐴓𐴟𐴑 21‏:5‏-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴧𐴟 𐴁𐴝𐴀𐴌𐴠 𐴎𐴝𐴦𐴌𐴒𐴡𐴥𐴘 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴏𐴡𐴀, 𐴑𐴠𐴀𐴕 𐴐𐴟𐴥𐴕𐴊𐴡𐴌-𐴐𐴟𐴥𐴕𐴊𐴡𐴌 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴀𐴕 𐴐𐴟𐴥𐴕𐴊𐴡𐴌-𐴐𐴟𐴥𐴕𐴊𐴡𐴌 𐴁𐴞𐴓𐴧𐴞𐴥𐴚!“<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴘 𐴀𐴠 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴁𐴞𐴓𐴧𐴞𐴥𐴚 𐴀𐴞𐴀𐴕 𐴊𐴠𐴑𐴡𐴥𐴌 𐴊𐴠 𐴕𐴠𐴥؟ 𐴀𐴠𐴍𐴠𐴥 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴇𐴞𐴥𐴀𐴕 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="MRK 13:2" /></para>
  <para style="s1">𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴀𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 24:3-14">𐴔𐴡𐴃𐴢 24‏:3‏-14</ref>; <ref loc="LUK 21:7-19">𐴓𐴟𐴑 21‏:7‏-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴔𐴟𐴀𐴔𐴡𐴌 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴉𐴞𐴃𐴡𐴌, 𐴘𐴝𐴑𐴟𐴁𐴢, 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴠 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />”𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴕𐴝, 𐴇𐴞𐴥𐴀𐴕 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠𐴥؟ 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴡؟“<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴊𐴠, <char style="wj">”𐴏𐴝𐴘𐴧𐴡𐴥, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴎𐴠𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴕𐴡 𐴓𐴡𐴘𐴎𐴝.</char> <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" /><char style="wj">𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝,‘ 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴁𐴡𐴥𐴘.</char> <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴝𐴌𐴝𐴥𐴙𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴌𐴝𐴥𐴙𐴌 𐴈𐴡𐴥𐴁𐴡𐴌𐴝-𐴈𐴡𐴥𐴁𐴡𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴥𐴕𐴞𐴁𐴝, 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴖𐴝𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴘𐴡𐴥 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴕𐴡.</char> <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" /><char style="wj">𐴀𐴠𐴑 𐴑𐴡𐴗𐴔𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴑𐴡𐴗𐴔𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑 𐴌𐴝𐴙𐴅𐴧𐴡𐴘𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴃𐴞𐴥𐴘𐴝𐴘𐴁𐴡; 𐴎𐴝𐴒𐴝-𐴎𐴝𐴒𐴝 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴄𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥𐴘𐴁𐴡. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢, 𐴉𐴟𐴖𐴝 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴐𐴟𐴥𐴌𐴟𐴌 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝.</char><verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴊𐴝𐴓𐴡𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴁𐴠𐴃𐴢 𐴔𐴝𐴌𐴝 𐴎𐴝𐴘𐴁𐴡. 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴑𐴞𐴔 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴇𐴝𐴥𐴎𐴞𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥 𐴉𐴝𐴌𐴡.</char> <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" /><char style="wj">𐴀𐴝𐴒𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴌 𐴎𐴡𐴌𐴟𐴌.</char> <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴁𐴞𐴏𐴝𐴌𐴡𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴁𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴑𐴞𐴦 𐴈𐴡𐴘𐴁𐴝𐴤 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴞𐴀𐴕 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴘𐴧𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴡𐴀𐴘𐴧𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴀𐴠𐴥𐴕𐴝.</char><verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />
    <char style="wj">”𐴁𐴝𐴥𐴘𐴧𐴠 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴀𐴝𐴦𐴌 𐴁𐴝𐴉𐴠 𐴉𐴟𐴖𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡. 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴁𐴝𐴥𐴘𐴁𐴡. </char> <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴡.</char><verse eid="MRK 13:13" /></para>
  <para style="s1">𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢</para>
  <para style="r">(<ref loc="MAT 24:15-28">𐴔𐴡𐴃𐴢 24‏:15‏-28</ref>; <ref loc="LUK 21:20-24">𐴓𐴟𐴑 21‏:20‏-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴇𐴡𐴥𐴃𐴝𐴌𐴝 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13‏:14 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="DAN 9:27">𐴋𐴝𐴥𐴕𐴞𐴘𐴠𐴓𐴢 9‏:27</ref>; <ref loc="DAN 11:31">11‏:31</ref>; <ref loc="DAN 12:11">12‏:11</ref></char>
      </char>
    </note> <char style="wj">𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴕𐴡 𐴃𐴝𐴥𐴑𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴎𐴝𐴒𐴝𐴃𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴊𐴠𐴑𐴞𐴥𐴁𐴝—𐴉𐴡𐴌𐴡𐴥𐴘𐴝𐴘𐴠 𐴁𐴟𐴎𐴡𐴥—𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴊𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴊𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴓𐴝𐴔𐴝𐴃𐴢 𐴕𐴡 𐴓𐴝𐴔𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴡𐴦𐴘𐴢 𐴁𐴡𐴓𐴧𐴝 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴡 𐴎𐴝𐴦 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴠𐴥𐴃𐴞𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴊𐴧𐴡𐴌 𐴓𐴡𐴦𐴘𐴢 𐴁𐴡𐴓𐴧𐴝 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴕𐴟 𐴀𐴝𐴀 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. </char> <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴇𐴝𐴥𐴔𐴞𐴓𐴢 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴊𐴡𐴌 𐴔𐴝𐴦 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" /><char style="wj">𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴐𐴞𐴥𐴃𐴑𐴝𐴓𐴠 𐴕𐴡.</char> <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴞𐴕 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴀𐴕 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴁𐴝𐴌 𐴕𐴡 𐴘𐴡𐴥 𐴀𐴡𐴥𐴘𐴁𐴡.</char><verse eid="MRK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 13:20" />
    <char style="wj">”𐴎𐴡𐴊𐴞 𐴔𐴝𐴁𐴟𐴊𐴠 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡𐴔𐴝𐴘 𐴕𐴡 𐴊𐴞𐴃𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴁𐴝𐴏𐴞𐴃𐴡𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴞𐴕 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴔𐴝𐴘𐴊𐴞𐴘𐴠𐴥.</char> <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀, ’𐴏𐴡𐴀, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴏𐴠𐴤!‘ 𐴘𐴝𐴥𐴃𐴡 ’𐴏𐴡𐴀, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴟𐴍𐴠𐴤 𐴀𐴝𐴏𐴠𐴤!‘ 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴑𐴞𐴕 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char> <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴞𐴏𐴝𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴟𐴍𐴞𐴤𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝 𐴇𐴝𐴌𐴇𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴡, 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝, 𐴉𐴝𐴌𐴞𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝.</char> <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡; 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴈𐴡𐴀𐴘𐴊𐴞𐴘𐴞.</char><verse eid="MRK 13:23" /></para>
  <para style="s1">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴀𐴝𐴀</para>
  <para style="r">(<ref loc="MAT 24:29-31">𐴔𐴡𐴃𐴢 24‏:29‏-31</ref>; <ref loc="LUK 21:25-28">𐴓𐴟𐴑 21‏:25‏-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴞𐴕 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴃𐴢, 𐴇𐴠𐴥 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴁𐴝𐴦𐴊𐴠,</char></para>
  <para style="q1" vid="MRK 13:24">
    <char style="wj">𐴁𐴠𐴙𐴓𐴢 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘,</char></para>
  <para style="q2" vid="MRK 13:24">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴏𐴝𐴕𐴠 𐴉𐴡𐴀𐴌 𐴕𐴡 𐴊𐴞𐴁𐴡;</char><verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />
    <char style="wj">𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴌𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘,</char></para>
  <para style="q1" vid="MRK 13:25">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡𐴥𐴃𐴧𐴡𐴌𐴝𐴘𐴁𐴡.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13‏:25 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 13:10">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 13‏:10</ref>; <ref loc="ISA 34:4">34‏:4</ref></char>
      </char>
    </note><verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />
    <char style="wj">”𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴠𐴑𐴞𐴥𐴁𐴡 𐴊𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.</char> <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴠𐴑 𐴔𐴝𐴃𐴝𐴥𐴃𐴧𐴟 𐴀𐴝𐴌𐴀𐴠𐴑 𐴔𐴝𐴃𐴝𐴥 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘, 𐴏𐴝𐴘𐴌𐴡𐴥𐴔𐴞𐴑𐴧𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. </char><verse eid="MRK 13:27" /></para>
  <para style="s1">𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴃𐴧𐴟 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MAT 24:32-35">𐴔𐴡𐴃𐴢 24‏:32‏-35</ref>; <ref loc="LUK 21:29-33">𐴓𐴟𐴑 21‏:29‏-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />
    <char style="wj">”𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴃𐴧𐴟 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴡𐴦: 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴌 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴇𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴘 𐴉𐴝𐴃𐴝 𐴕𐴠𐴦𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴞𐴎𐴡𐴒𐴡𐴥𐴘 𐴊𐴠, 𐴇𐴡𐴥𐴌𐴝𐴕 𐴋𐴝𐴥𐴑𐴠.</char> <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴀𐴕 𐴀𐴡𐴥𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴁𐴟𐴎𐴞𐴥𐴁𐴝 𐴊𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴋𐴝𐴥𐴑𐴠, 𐴀𐴠𐴁𐴧𐴠 𐴊𐴡𐴌𐴡𐴎𐴝𐴃𐴢.</char> <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴌𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴠 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡 𐴉𐴟𐴥𐴌𐴝𐴘𐴁𐴡.</char> <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" /><char style="wj">𐴀𐴝𐴏𐴔𐴝𐴕 𐴎𐴡𐴁𐴞𐴕 𐴃𐴡 𐴎𐴝𐴌𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.</char><verse eid="MRK 13:31" /></para>
  <para style="s1">𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠 𐴊𐴠 𐴊𐴞𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴑𐴃𐴡𐴥</para>
  <para style="r">(<ref loc="MAT 24:36-44">𐴔𐴡𐴃𐴢 24‏:36‏-44</ref>; <ref loc="LUK 21:34-36">𐴓𐴟𐴑 21‏:34‏-36</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴘𐴝𐴥𐴃𐴡 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴖𐴝𐴘𐴠 𐴘𐴡𐴥 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴁𐴝𐴉𐴠 𐴁𐴠 𐴎𐴝𐴕𐴠.</char> <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" /><char style="wj">𐴇𐴡𐴥𐴁𐴡𐴌𐴡𐴊𐴧𐴝𐴌, 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴡 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴘𐴁𐴡𐴤.</char> <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" /><char style="wj">𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥 𐴘𐴞𐴥𐴁𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴊𐴟𐴌𐴠𐴥 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌 𐴀𐴠𐴌𐴞 𐴎𐴝𐴘𐴃𐴠 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴎𐴞𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴦 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴝𐴌-𐴎𐴝𐴌 𐴈𐴝𐴔 𐴃𐴝𐴌𐴠𐴥-𐴃𐴝𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴖𐴝𐴌 𐴏𐴡𐴦𐴛𐴊𐴝𐴌𐴡𐴌𐴠 𐴘𐴡𐴥 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠.</char><verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴕𐴡 𐴎𐴝𐴕𐴡, 𐴒𐴡𐴥𐴌𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴇𐴡𐴃𐴟𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴘𐴁𐴡𐴤—𐴑𐴞 𐴇𐴝𐴥𐴣𐴎𐴞𐴕𐴧𐴝, 𐴑𐴞 𐴀𐴝𐴊𐴝𐴤 𐴌𐴝𐴙𐴃𐴧𐴝, 𐴑𐴞 𐴉𐴟𐴀𐴝𐴥𐴣𐴙𐴃𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴁𐴞𐴀𐴕𐴧𐴝.</char> <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" /><char style="wj">𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴏𐴞𐴔𐴁𐴞𐴃𐴢 𐴀𐴝𐴘𐴓𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴁𐴡.</char> <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴈𐴡𐴀𐴙𐴌, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠, ’𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴡!‘ “</char><verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴏𐴡𐴥𐴓𐴧𐴝</para>
  <para style="r">(<ref loc="MAT 26:1-5">𐴔𐴡𐴃𐴢 26‏:1‏-5</ref>; <ref loc="LUK 22:1-2">𐴓𐴟𐴑 22‏:1‏-2</ref>; <ref loc="JHN 11:45-53">𐴘𐴡 11‏:45‏-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴟𐴥𐴄𐴝𐴌-𐴏𐴝𐴥𐴌𐴝 𐴌𐴟𐴄𐴞𐴌-𐴀𐴞𐴊𐴢 𐴀𐴝𐴘𐴃𐴠𐴤 𐴊𐴟𐴘 𐴊𐴞𐴕 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴝𐴦𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴞𐴦 𐴁𐴡𐴃𐴠 𐴎𐴟𐴘𐴃𐴠𐴥𐴒𐴡𐴌𐴞 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴊𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴕𐴡, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴟𐴥𐴌𐴟𐴏𐴧𐴟𐴓𐴢 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠.“<verse eid="MRK 14:2" /></para>
  <para style="s1">𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴀𐴝𐴣𐴃𐴡𐴌 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MAT 26:6-13">𐴔𐴡𐴃𐴢 26‏:6‏-13</ref>; <ref loc="JHN 12:1-8">𐴘𐴡 12‏:1‏-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />𐴀𐴞𐴏𐴝𐴤 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴌 𐴊𐴠 𐴇𐴠𐴥𐴣𐴃𐴧𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴇𐴝𐴥𐴣𐴌𐴞𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴇𐴝𐴥𐴄𐴞 𐴕𐴝𐴌𐴋-𐴒𐴝𐴏𐴡𐴌 𐴁𐴞𐴐𐴞𐴤 𐴔𐴡𐴀𐴚𐴒𐴝 𐴀𐴝𐴣𐴃𐴡𐴌 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴝𐴥𐴣𐴌𐴞 𐴖𐴝 𐴁𐴝𐴥𐴚𐴒𐴞 𐴀𐴝𐴣𐴃𐴡𐴌 𐴒𐴟𐴥𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠.<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴒𐴡𐴔 𐴕𐴡 𐴓𐴝𐴒𐴞 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴈𐴡𐴖𐴝𐴤𐴇𐴡𐴘 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴠 𐴀𐴝𐴣𐴃𐴡𐴌 𐴒𐴟𐴥𐴕 𐴑𐴞𐴘𐴝𐴥 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠؟ <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />𐴀𐴠 𐴀𐴝𐴣𐴃𐴡𐴌 𐴒𐴟𐴥𐴕 𐴊𐴠 𐴃𐴞𐴕 𐴐𐴡𐴥𐴃𐴢 𐴊𐴞𐴕𐴝𐴥𐴌𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴊𐴞𐴥 𐴁𐴠𐴏𐴞 𐴄𐴞𐴛𐴝 𐴒𐴟𐴥𐴕 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴙𐴃𐴧𐴡.“ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴡𐴥𐴄𐴁𐴡𐴍𐴝𐴥𐴘𐴧𐴠.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴡; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴑𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴡𐴤𐴌؟ 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴓𐴝𐴘 𐴀𐴠𐴥𐴕𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" /><char style="wj">𐴒𐴡𐴌𐴞𐴁𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴞𐴃𐴧𐴞 𐴀𐴝𐴏𐴠𐴤,</char><note caller="+" style="f"><char style="fr" closed="false">14‏:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 15:11">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 15‏:11</ref></char>.</char></note> <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴃𐴟𐴥𐴕𐴡𐴃𐴢 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴃𐴧𐴞 𐴕𐴡 𐴉𐴝𐴘𐴁𐴝.</char> <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" /><char style="wj">𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴥𐴕𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴊𐴡𐴇𐴡𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴦𐴃𐴢 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴣𐴃𐴡𐴌 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠 𐴊𐴠.</char> <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴠𐴍𐴠𐴥-𐴎𐴠𐴍𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴘𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴀𐴞𐴁𐴝𐴤𐴌 𐴘𐴝𐴊𐴒𐴝𐴌𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴠𐴥𐴍𐴠-𐴇𐴠𐴥𐴍𐴠 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="MRK 14:9" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌 𐴌𐴝𐴎𐴞</para>
  <para style="r">(<ref loc="MAT 26:14-16">𐴔𐴡𐴃𐴢 26‏:14‏-16</ref>; <ref loc="LUK 22:3-6">𐴓𐴟𐴑 22‏:3‏-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴞𐴏𐴑𐴝𐴥𐴌𐴞𐴘𐴠𐴃𐴢, 𐴎𐴠𐴦 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕, 𐴀𐴞𐴥𐴃𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴡𐴥𐴌𐴞𐴊𐴞 𐴉𐴝𐴌𐴠 𐴉𐴝𐴥𐴕. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴄𐴞𐴛𐴝 𐴊𐴞𐴦𐴁𐴡 𐴁𐴡𐴓𐴞 𐴖𐴝𐴦𐴊𐴝 𐴊𐴞𐴘𐴠𐴥. 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴑𐴝𐴌 𐴃𐴝𐴓𐴝𐴐𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MRK 14:11" /></para>
  <para style="s1">𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝</para>
  <para style="r">(<ref loc="MAT 26:17-25">𐴔𐴡𐴃𐴢 26‏:17‏-25</ref>; <ref loc="LUK 22:7-14">𐴓𐴟𐴑 22‏:7‏-14</ref>‏,<ref loc="LUK 22:21-23">21‏-23</ref>; <ref loc="JHN 13:21-30">𐴘𐴡 13‏:21‏-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />𐴐𐴟𐴥𐴄𐴝𐴌-𐴏𐴝𐴥𐴌𐴝 𐴌𐴟𐴄𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴊𐴞𐴕 𐴀𐴡𐴃𐴢, 𐴎𐴠 𐴊𐴞𐴕 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴓𐴧𐴝 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴏𐴡𐴥𐴀 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴏𐴝𐴤𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴃𐴟𐴀𐴛 𐴇𐴝𐴥𐴘 𐴉𐴝𐴌𐴡 𐴉𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴍𐴠𐴥 𐴎𐴝𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴌 𐴃𐴡𐴘𐴧𐴝𐴌𐴞 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟“<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴎𐴡𐴦; 𐴎𐴡𐴑𐴡𐴃𐴢 𐴒𐴡𐴌𐴞 𐴉𐴝𐴕𐴞𐴥 𐴓𐴡𐴘𐴎𐴝𐴌 𐴊𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴞𐴁𐴡𐴥; 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴎𐴝𐴘𐴧𐴡.</char> <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" /><char style="wj">𐴀𐴞𐴥𐴁𐴝 𐴎𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴠 𐴇𐴠𐴥 𐴒𐴡𐴥𐴌 𐴒𐴝𐴕𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ’𐴀𐴟𐴏𐴃𐴝𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌 𐴔𐴠𐴀𐴔𐴝𐴕-𐴈𐴝𐴥𐴕𐴝 𐴇𐴡𐴍𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴇𐴝𐴥𐴘 𐴉𐴝𐴙𐴅𐴧𐴟𐴔؟“ ‘</char> <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" /><char style="wj">𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴣𐴎𐴝𐴘𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴖𐴡𐴌𐴡𐴌 𐴄𐴝𐴓𐴝𐴌 𐴋𐴡𐴣𐴀𐴌 𐴑𐴝𐴔𐴝𐴥𐴌𐴝 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴡. 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.“</char><verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />𐴃𐴡𐴥𐴘 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴎𐴝𐴘 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴝𐴘𐴧𐴠𐴥; 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴡𐴀𐴘𐴢 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡; 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴌.“</char><verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴀𐴡𐴥𐴘 𐴎𐴡𐴕𐴉𐴡𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟“<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴞𐴥𐴃𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴕𐴟𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴡𐴊𐴧𐴝𐴤𐴃𐴢 𐴌𐴟𐴄𐴞 𐴁𐴟𐴌𐴝𐴌.</char> <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" /><char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴎𐴝𐴦𐴌; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴝𐴌 𐴖𐴡𐴌𐴠, 𐴎𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴊𐴡𐴥𐴌𐴝 𐴇𐴝𐴥𐴘𐴁𐴡. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴎𐴡𐴌𐴔𐴡 𐴕𐴡 𐴀𐴡𐴥𐴘𐴃𐴡 𐴁𐴡𐴥𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴝 𐴒𐴡𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.“</char><verse eid="MRK 14:21" /></para>
  <para style="s1">𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴝𐴥𐴕𐴝</para>
  <para style="r">(<ref loc="MAT 26:26-30">𐴔𐴡𐴃𐴢 26‏:26‏-30</ref>; <ref loc="LUK 22:15-20">𐴓𐴟𐴑 22‏:15‏-20</ref>; <ref loc="1CO 11:23-25">1𐴑𐴡𐴥𐴌 11‏:23‏-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴌𐴟𐴄𐴞 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴥𐴚𐴒𐴞 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴊𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴓𐴡𐴦, 𐴘𐴝𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴦.“</char><verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴘𐴝𐴓𐴝 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴈𐴠𐴥𐴕𐴃𐴟 𐴈𐴝𐴥𐴘𐴧𐴠.<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴞𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴡𐴘𐴝 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴖𐴢, 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴞𐴘𐴡𐴥𐴌 𐴓𐴧𐴝 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴟𐴔.</char> <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴀𐴛 𐴀𐴠 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴀𐴞𐴀𐴕 𐴀𐴝𐴁𐴝𐴌 𐴕𐴝 𐴈𐴝𐴥𐴘𐴧𐴟𐴔, 𐴀𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴕𐴡𐴘𐴝 𐴒𐴡𐴌𐴞 𐴕𐴝𐴥 𐴇𐴝𐴥𐴘.“</char><verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴠𐴀𐴌 𐴒𐴝𐴀𐴘𐴢, 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥.<verse eid="MRK 14:26" /></para>
  <para style="s1">𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 26:31-35">𐴔𐴡𐴃𐴢 26‏:31‏-35</ref>; <ref loc="LUK 22:31-34">𐴓𐴟𐴑 22‏:31‏-34</ref>; <ref loc="JHN 13:36-38">𐴘𐴡 13‏:36‏-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴐𐴡𐴥𐴀𐴑 𐴀𐴝𐴘𐴁𐴡𐴤 𐴀𐴝𐴦𐴌 𐴊𐴝𐴥𐴘𐴁𐴝𐴒𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</char></para>
  <para style="q1" vid="MRK 14:27">
    <char style="wj">’𐴀𐴝𐴀𐴛 𐴏𐴡𐴥𐴀𐴓𐴢 𐴏𐴡𐴌𐴡𐴘𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴟𐴔,</char></para>
  <para style="q2" vid="MRK 14:27">
    <char style="wj">𐴃𐴡𐴥𐴘 𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴐𐴞𐴥𐴣𐴍𐴝𐴐𐴞𐴄𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">14‏:27 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ZEC 13:7">𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝 13‏:7</ref>
        </char>
      </char>
    </note><verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />
    <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴒𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴎𐴝𐴘𐴧𐴟𐴔.“</char><verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴎𐴝𐴘𐴓𐴠𐴥 𐴘𐴡, 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴘𐴧𐴟𐴔.“<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴙𐴅𐴧𐴝 𐴌𐴝𐴙𐴃𐴧𐴝 𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴊𐴟𐴘𐴁𐴝𐴌 𐴁𐴝𐴑 𐴊𐴞𐴁𐴝𐴌 𐴀𐴝𐴒𐴠, 𐴃𐴟𐴘 𐴕𐴞𐴎𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴞𐴕 𐴁𐴝𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴞.“ </char><verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />𐴓𐴠𐴑𐴞𐴕 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴎𐴟𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴌𐴝 𐴉𐴡𐴌𐴠 𐴘𐴡𐴥, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔.“ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴈𐴡𐴘𐴧𐴠𐴥.<verse eid="MRK 14:31" /></para>
  <para style="s1">𐴒𐴠𐴃𐴏𐴝𐴥𐴔𐴝𐴕𐴞 𐴁𐴝𐴒𐴝𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴖𐴝</para>
  <para style="r">(<ref loc="MAT 26:36-46">𐴔𐴡𐴃𐴢 26‏:36‏-46</ref>; <ref loc="LUK 22:39-46">𐴓𐴟𐴑 22‏:39‏-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴒𐴠𐴃𐴏𐴝𐴥𐴔𐴝𐴕𐴞 𐴈𐴡𐴀. 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴎𐴠𐴃𐴟𐴥𐴕 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔 𐴇𐴠𐴥𐴃𐴟𐴕 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴑𐴡.“</char> <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴉𐴞𐴃𐴡𐴌 𐴀𐴡𐴌𐴠, 𐴘𐴝𐴑𐴟𐴁𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴡𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴞𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞 𐴓𐴝𐴒𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴐𐴝𐴥𐴕𐴃𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴡𐴌𐴝𐴕 𐴕𐴠𐴦𐴓𐴞𐴎𐴝𐴘𐴃𐴡𐴥𐴘 𐴏𐴝𐴥𐴌. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴡.“</char><verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴒𐴡𐴌𐴞 𐴔𐴟𐴀𐴔𐴧𐴞𐴑𐴧𐴝 𐴎𐴝𐴘, 𐴔𐴠𐴍𐴞𐴃𐴢 𐴉𐴡𐴌𐴞 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴊𐴠, 𐴎𐴡𐴊𐴞 𐴉𐴝𐴌𐴞𐴓𐴠𐴥 𐴇𐴠𐴥 𐴊𐴟𐴑𐴧𐴡𐴥𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴃𐴡. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴀𐴝𐴁𐴧𐴝, 𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴃𐴟𐴀𐴛 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴡. 𐴀𐴠 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴘𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴝𐴣𐴀𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴀𐴡𐴥𐴑.“</char><verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴃𐴟𐴘 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴕𐴞𐴥𐴑𐴞؟ 𐴃𐴟𐴘 𐴀𐴠𐴑 𐴒𐴡𐴥𐴕𐴋𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴞 𐴕𐴡 𐴉𐴝𐴌𐴡𐴀𐴌 𐴊𐴠𐴥؟</char> <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" /><char style="wj">𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴡 𐴀𐴝𐴦𐴌 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴕𐴡 𐴉𐴡𐴌𐴡; 𐴁𐴠𐴐𐴡𐴥𐴑 𐴌𐴟𐴀𐴃𐴧𐴟 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴑𐴡𐴔𐴎𐴟𐴌 𐴊𐴠.“</char><verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴁𐴝𐴌 𐴎𐴝𐴘 𐴀𐴠𐴑𐴞𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴘𐴢 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />𐴀𐴞𐴥𐴁𐴝 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴀𐴘𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑 𐴒𐴟𐴥𐴔𐴠 𐴁𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴞𐴦 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴁𐴡 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />𐴀𐴞𐴥𐴁𐴝 𐴃𐴞𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌𐴝𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴡𐴤 𐴊𐴠؟ 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴡𐴑𐴃𐴡𐴥 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠𐴒𐴝𐴘. 𐴏𐴡𐴀, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" /><char style="wj">𐴀𐴟𐴍𐴡𐴥, 𐴎𐴝𐴘𐴒𐴡𐴥𐴘. 𐴏𐴡𐴀, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞𐴊𐴡𐴘𐴝 𐴋𐴝𐴥𐴑𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠𐴒𐴝𐴘.“</char><verse eid="MRK 14:42" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌𐴞</para>
  <para style="r">(<ref loc="MAT 26:47-56">𐴔𐴡𐴃𐴢 26‏:47‏-56</ref>; <ref loc="LUK 22:47-53">𐴓𐴟𐴑 22‏:47‏-53</ref>; <ref loc="JHN 18:3-12">𐴘𐴡 18‏:3‏-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴠𐴥𐴇𐴡𐴕 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠𐴒𐴝𐴘, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴕𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕. 𐴀𐴞𐴥𐴃𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴍𐴞𐴥-𐴐𐴟𐴥𐴍𐴝 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠, 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴠𐴌, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴞𐴀𐴓𐴢, ”𐴀𐴝𐴀𐴛 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴘𐴟𐴔, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝. 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴡 𐴀𐴝𐴦𐴌 𐴏𐴡𐴙𐴑𐴧𐴝𐴓𐴢 𐴊𐴞 𐴓𐴡𐴘𐴎𐴝𐴘𐴧𐴡𐴒𐴡𐴥𐴘.“ <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴝𐴀𐴘𐴢 𐴔𐴡𐴃𐴧𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 ”𐴌𐴝𐴁𐴧𐴞𐴥!“ 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥𐴘𐴠. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴥𐴇𐴡𐴕 𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴕𐴠𐴦𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴡𐴓𐴝𐴘 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴒𐴟𐴓𐴝𐴔𐴡𐴌 𐴈𐴝𐴕 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴢 𐴊𐴡𐴥𐴙𐴃𐴧𐴡 𐴀𐴝𐴙𐴐𐴧𐴡𐴥 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴍𐴞𐴥-𐴐𐴟𐴥𐴍𐴝 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴙𐴃𐴧𐴡 𐴀𐴝𐴙𐴐𐴧𐴡𐴥 𐴊𐴠؟</char> <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴡 𐴉𐴡𐴃𐴧𐴞𐴥 𐴊𐴞𐴕 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴃𐴝𐴔, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴀𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.“</char> <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴌𐴞 𐴊𐴝𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />𐴀𐴠𐴎𐴧𐴡𐴕 𐴅𐴟𐴖𐴝𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴞𐴘𐴡𐴏𐴧𐴡𐴌 𐴒𐴝𐴦𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴥 𐴉𐴞𐴣𐴊𐴠𐴤, 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴝𐴊𐴧𐴡𐴌 𐴁𐴠𐴌𐴝𐴘𐴧𐴠𐴥 𐴊𐴠. 𐴃𐴝𐴌𐴝𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴡𐴥𐴙𐴃𐴧𐴡 𐴏𐴝𐴘𐴧𐴠𐴥, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴏𐴝𐴊𐴧𐴡𐴌 𐴒𐴝𐴥𐴕 𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴞𐴘𐴡𐴏𐴧𐴡𐴌 𐴊𐴟𐴣𐴌𐴊𐴞𐴘𐴠𐴥.<verse eid="MRK 14:52" /></para>
  <para style="s1">𐴉𐴡𐴥𐴃𐴟𐴖𐴝𐴘𐴞-𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴏𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 26:57-68">𐴔𐴡𐴃𐴢 26‏:57‏-68</ref>; <ref loc="LUK 22:54-55">𐴓𐴟𐴑 22‏:54‏-55</ref>‏,<ref loc="LUK 22:63-71">63‏-71</ref>; <ref loc="JHN 18:13-14">𐴘𐴡 18‏:13‏-14</ref>‏,<ref loc="JHN 18:19-24">19‏-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔, 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />𐴉𐴞𐴃𐴡𐴌 𐴊𐴟𐴌𐴠𐴥-𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴡𐴀𐴘𐴢 𐴀𐴡𐴦𐴙𐴕 𐴉𐴟𐴖𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴥𐴃𐴟𐴖𐴝𐴘𐴞-𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢 𐴄𐴞𐴥𐴘𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴟𐴓𐴋𐴝 𐴒𐴡𐴁𐴝𐴤𐴌 𐴃𐴝𐴓𐴝𐴐𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴌𐴠 𐴉𐴝𐴥𐴕; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴒𐴡𐴁𐴝𐴤 𐴕𐴡𐴥 𐴉𐴝𐴦. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴔𐴞𐴏𐴝𐴥 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴡𐴁𐴝𐴤 𐴔𐴞𐴓𐴢 𐴕𐴝𐴥 𐴇𐴝𐴥.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />𐴉𐴡𐴌𐴠 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴞𐴏𐴝𐴥 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴠, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />”𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, ’𐴀𐴝𐴀𐴛 𐴀𐴝𐴥𐴃𐴡𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴘𐴝𐴀𐴕 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴝𐴘, 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴟𐴔, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴥𐴃𐴡𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡.‘ “ <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴠𐴁𐴝𐴌 𐴀𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴡𐴁𐴝𐴤 𐴔𐴞𐴓𐴢 𐴕𐴝𐴥 𐴇𐴝𐴥.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴠 𐴀𐴟𐴍𐴞𐴤 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴖𐴝𐴁𐴢 𐴕𐴡 𐴊𐴞𐴁𐴝؟ 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴌؟“ <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴝𐴥𐴔 𐴔𐴝𐴥𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴖𐴝𐴁𐴢 𐴕𐴡𐴥 𐴊𐴠.</para>
  <para style="p" vid="MRK 14:61">𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴠 𐴀𐴝𐴁𐴝𐴌 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴑𐴞𐴥 𐴃𐴝𐴦𐴌𐴞𐴉𐴊𐴝𐴥𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴔𐴡𐴀𐴏𐴞𐴤؟“<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥𐴘 𐴀𐴝𐴀𐴛. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴓𐴧𐴝 𐴃𐴝𐴥𐴓𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.“</char><verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴙𐴌𐴡𐴌 𐴇𐴡𐴦𐴌 𐴉𐴝𐴥𐴍𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴌 𐴑𐴞𐴦 𐴒𐴡𐴁𐴝𐴤 𐴓𐴝𐴒𐴠𐴌 𐴊𐴠𐴥؟ <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴞𐴁𐴝𐴤𐴌 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴉𐴟𐴥𐴙𐴕𐴧𐴡; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴌𐴝𐴘 𐴑𐴞𐴦؟“</para>
  <para style="p" vid="MRK 14:64">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴦𐴃𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴁𐴡𐴓𐴞 𐴉𐴡𐴥𐴃𐴟𐴖𐴝 𐴊𐴞𐴥𐴘𐴠. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴠𐴥𐴂𐴢 𐴔𐴝𐴌𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴑 𐴁𐴝𐴕𐴊𐴞 𐴒𐴟𐴥𐴐𐴝 𐴔𐴝𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴡𐴕𐴠 𐴔𐴝𐴙𐴅𐴧𐴠𐴥 𐴀𐴝𐴕𐴃𐴝𐴏𐴢 𐴒𐴡𐴌 𐴏𐴝𐴥𐴘!“ 𐴁𐴝𐴦𐴊𐴠 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘 𐴏𐴟𐴖𐴝𐴌 𐴔𐴝𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="MRK 14:65" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴀𐴞𐴕𐴑𐴝𐴌</para>
  <para style="r">(<ref loc="MAT 26:69-75">𐴔𐴡𐴃𐴢 26‏:69‏-75</ref>; <ref loc="LUK 22:56-62">𐴓𐴟𐴑 22‏:56‏-62</ref>; <ref loc="JHN 18:15-18">𐴘𐴡 18‏:15‏-18</ref>‏,<ref loc="JHN 18:25-27">25‏-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />𐴉𐴞𐴃𐴡𐴌 𐴕𐴞𐴏𐴠 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴁𐴝𐴣𐴊𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />𐴀𐴝𐴦𐴌 𐴉𐴞𐴃𐴡𐴌 𐴀𐴡𐴦𐴙𐴕 𐴉𐴟𐴖𐴝𐴥𐴌 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡 𐴕𐴝𐴏𐴝𐴥𐴌𐴞 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝.“<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠, ”𐴃𐴟𐴀𐴛 𐴑𐴞𐴘𐴡𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴀𐴌 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴕𐴞 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴘𐴡𐴥 𐴁𐴟𐴎𐴞𐴥𐴌.“ 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴁𐴝𐴀𐴌𐴠 𐴁𐴝𐴦𐴕𐴋𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴁𐴝𐴑 𐴊𐴞𐴘𐴠𐴥.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />𐴁𐴝𐴣𐴊𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴋𐴝𐴥𐴑𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴃𐴝𐴌𐴝𐴥𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴎𐴡𐴕!“ <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠.</para>
  <para style="p" vid="MRK 14:70">𐴇𐴡𐴃𐴟𐴥𐴕 𐴁𐴝𐴦𐴊𐴠 𐴋𐴝𐴥𐴑𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴟𐴀𐴛 𐴃𐴝𐴌𐴝𐴥𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴎𐴡𐴕, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴘𐴡𐴥 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢.“<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴓𐴝𐴀𐴕𐴡𐴃𐴢 𐴀𐴡𐴥𐴑 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥.“<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴁𐴝𐴑 𐴊𐴞𐴘𐴠𐴥. 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴃𐴡𐴌𐴡𐴃𐴧𐴟 𐴈𐴡𐴃𐴝𐴤 𐴖𐴝𐴀𐴕 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴓𐴢, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, <char style="wj">”𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴊𐴟𐴘𐴁𐴝𐴌 𐴁𐴝𐴑 𐴊𐴞𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴞𐴕 𐴁𐴝𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴞.“</char> 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴈𐴝𐴣𐴊𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s1">𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴏𐴝𐴤</para>
  <para style="r">(<ref loc="MAT 27:1-2">𐴔𐴡𐴃𐴢 27‏:1‏-2</ref>‏,<ref loc="MAT 27:11-14">11‏-14</ref>; <ref loc="LUK 23:1-5">𐴓𐴟𐴑 23‏:1‏-5</ref>; <ref loc="JHN 18:28-38">𐴘𐴡 18‏:28‏-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />𐴁𐴞𐴀𐴕𐴧𐴝 𐴑𐴟𐴥𐴁𐴢 𐴏𐴡𐴥𐴀𐴌𐴠, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴥𐴃𐴟𐴖𐴝𐴘𐴞-𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢 𐴄𐴞𐴥𐴘𐴝 𐴓𐴡𐴥𐴘 𐴏𐴡𐴥𐴓𐴧𐴝-𐴔𐴡𐴐𐴖𐴝𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴁𐴝𐴣𐴊𐴞𐴥 𐴓𐴡𐴘𐴎𐴝𐴘 𐴉𐴞𐴓𐴝𐴃𐴡𐴌𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴕𐴞𐴥𐴑𐴞؟“</para>
  <para style="p" vid="MRK 15:2">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥𐴘, 𐴃𐴟𐴀𐴛 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝.“</char><verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴔𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴓𐴎𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴝𐴒𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴝𐴁𐴝𐴌 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴖𐴝𐴁𐴢 𐴕𐴡 𐴊𐴞𐴁𐴝؟ 𐴏𐴡𐴀, 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴀𐴠𐴓𐴎𐴝𐴔 𐴓𐴝𐴒𐴝𐴌.“<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴡𐴀 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴖𐴝𐴁𐴢 𐴕𐴡𐴥 𐴊𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴉𐴞𐴓𐴝𐴃𐴢 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MRK 15:5" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔</para>
  <para style="r">(<ref loc="MAT 27:15-26">𐴔𐴡𐴃𐴢 27‏:15‏-26</ref>; <ref loc="LUK 23:13-25">𐴓𐴟𐴑 23‏:13‏-25</ref>; <ref loc="JHN 18:39-19:16">𐴘𐴡 18‏:39‏—19‏:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴠 𐴇𐴡𐴊𐴞𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴃𐴡 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴉𐴞𐴓𐴝𐴃𐴠 𐴇𐴠𐴥 𐴇𐴡𐴊𐴞𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴃𐴡. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴁𐴝𐴒𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴝𐴒𐴞𐴘𐴝𐴘 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴑𐴟𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴀𐴝𐴀𐴘𐴢 𐴉𐴞𐴓𐴝𐴃𐴡𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴊𐴠, 𐴕𐴞𐴎𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴔𐴡𐴎𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴘𐴝𐴀𐴕 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴕𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴖𐴝𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕؟“ <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴊𐴠, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴝𐴥𐴏𐴡𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠 𐴊𐴠. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴌𐴠 𐴀𐴟𐴏𐴑𐴝𐴘𐴊𐴞𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴠.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴈𐴡𐴀 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴑𐴞𐴦 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟“<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴁𐴝𐴌 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴡!“<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴑𐴞𐴘𐴝𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴦 𐴁𐴟𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠𐴥؟“</para>
  <para style="p" vid="MRK 15:14">𐴃𐴡𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌𐴡𐴤 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴡!“<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴝𐴥𐴌 𐴀𐴠𐴌𐴝𐴊𐴝𐴘𐴠 𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴐𐴡𐴀𐴣𐴑 𐴔𐴝𐴌𐴝𐴁𐴝𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴒𐴡𐴏𐴝𐴥𐴘 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="MRK 15:15" /></para>
  <para style="s1">𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴃𐴠𐴥𐴐𐴠𐴌𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 27:27-31">𐴔𐴡𐴃𐴢 27‏:27‏-31</ref>; <ref loc="JHN 19:2-3">𐴘𐴡 19‏:2‏-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />𐴁𐴝𐴦𐴊𐴠 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴂𐴌𐴝𐴘𐴄𐴡𐴌𐴞𐴘𐴟𐴔 𐴈𐴡𐴀 𐴊𐴠 𐴌𐴝𐴎𐴔𐴡𐴇𐴡𐴥𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴄𐴠𐴀𐴌𐴝𐴚 𐴄𐴞𐴥𐴘𐴝𐴌𐴠 𐴋𐴝𐴑𐴞 𐴎𐴡𐴔𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴝𐴘𐴡𐴙𐴕𐴧𐴝 𐴌𐴡𐴚𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴎𐴟𐴁𐴧𐴝 𐴉𐴞𐴣𐴊𐴝𐴥𐴘𐴊𐴞𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴑𐴠𐴣𐴍𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴃𐴝𐴏𐴢 𐴁𐴝𐴕𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴊𐴞𐴘𐴝𐴘𐴊𐴞𐴘𐴠𐴥. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴥𐴓𐴝𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, ”𐴇𐴠𐴥𐴘 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝, 𐴃𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴓𐴝𐴔!“ <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴓𐴝𐴍𐴞𐴥 𐴓𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥 𐴏𐴝𐴘 𐴔𐴝𐴌𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴠𐴥𐴂𐴢 𐴔𐴝𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴍𐴟𐴥 𐴉𐴠𐴥𐴓𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴠𐴥𐴐𐴠𐴌𐴝𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴁𐴝𐴘𐴡𐴙𐴕𐴧𐴝 𐴌𐴡𐴚𐴡𐴌 𐴎𐴟𐴁𐴧𐴝 𐴖𐴝 𐴑𐴟𐴥𐴓𐴞𐴉𐴠𐴓𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴞𐴣𐴊𐴝𐴥𐴘𐴊𐴞𐴘𐴠; 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴝𐴀𐴌𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="MRK 15:20" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 27:32-44">𐴔𐴡𐴃𐴢 27‏:32‏-44</ref>; <ref loc="LUK 23:26-43">𐴓𐴟𐴑 23‏:26‏-43</ref>; <ref loc="JHN 19:17-27">𐴘𐴡 19‏:17‏-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />𐴑𐴟𐴌𐴠𐴕𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴒𐴝𐴚 𐴎𐴝𐴒𐴝𐴃𐴧𐴟 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴇𐴠𐴥 𐴉𐴡𐴣𐴃𐴢 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦𐴌. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴓𐴠𐴑𐴏𐴎𐴠𐴕𐴊𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴌𐴟𐴉𐴟𐴏𐴡𐴌 𐴁𐴝𐴉𐴢. 𐴀𐴞𐴏𐴝𐴤𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴢 𐴐𐴝𐴕 𐴁𐴡𐴀𐴘𐴢 𐴓𐴡𐴘𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴉𐴡𐴥𐴗𐴏𐴢 𐴏𐴟𐴕𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴡𐴅𐴁𐴟𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴡𐴓𐴒𐴡𐴃𐴝 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴃𐴡𐴌𐴅𐴟𐴔𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴃𐴝𐴥𐴌 𐴔𐴝𐴓𐴝𐴌 𐴎𐴝𐴒𐴝. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴟𐴌<note caller="+" style="f"><char style="fr" closed="false">15‏:23 </char><char style="fq">𐴔𐴟𐴌 </char> <char style="ft" closed="false">𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴐𐴞𐴤 𐴔𐴡𐴀𐴚𐴒𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴓𐴝 𐴑𐴟𐴥𐴐𐴁𐴡𐴊𐴝𐴌 𐴏𐴞𐴎𐴢. 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴝𐴕𐴝 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴝𐴏𐴡𐴌 𐴀𐴝𐴣𐴍𐴝𐴤 𐴓𐴡𐴥𐴘. 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴀𐴕 𐴊𐴝𐴁𐴝𐴘 𐴓𐴧𐴝 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.</char></note> 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴔𐴞𐴘𐴝𐴥𐴘𐴧𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴕𐴝𐴥 𐴈𐴝𐴥𐴀. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴥𐴑 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴇𐴝𐴌 𐴁𐴝𐴥𐴑𐴡𐴃𐴢 𐴑𐴞𐴦 𐴉𐴡𐴌𐴠 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴡𐴄𐴝𐴥𐴌𐴞 𐴔𐴝𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴁𐴞𐴀𐴕𐴧𐴝 𐴕𐴡𐴖 𐴖𐴝 𐴁𐴠 𐴁𐴝𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴓𐴢. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴏𐴝𐴥𐴙𐴕𐴁𐴟𐴥𐴄𐴢 𐴔𐴝𐴌𐴞𐴊𐴞𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, ” <char style="sc">𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝.</char>“<verse eid="MRK 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 15:27" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴡𐴌𐴠 𐴘𐴡𐴥 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴓𐴢, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴕 𐴋𐴝𐴥𐴑 𐴀𐴡𐴃𐴧𐴟. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴒𐴡𐴕𐴝 𐴒𐴞𐴘𐴠𐴥.“ <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥 𐴉𐴡𐴣𐴃𐴢 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴃𐴝𐴥 𐴓𐴝𐴌𐴞-𐴓𐴝𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴠𐴥𐴐𐴠𐴌𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴝𐴥! 𐴃𐴟𐴘 𐴃𐴡 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴁𐴝𐴥𐴚𐴒𐴞 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴊𐴡𐴘𐴝, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />𐴘𐴝𐴓𐴝 𐴃𐴟𐴘 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴁𐴝𐴏𐴝 𐴏𐴝𐴥𐴘!“ <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴄𐴝𐴥𐴃𐴄𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴡 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴊𐴠 𐴁𐴝𐴏𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠𐴌! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />𐴀𐴠 𐴔𐴡𐴀𐴏𐴞𐴤, 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴘𐴝𐴓𐴝 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴘𐴧𐴡𐴤𐴑, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴉𐴝𐴌𐴞.“ 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴘𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="MRK 15:32" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴡𐴦𐴃𐴢</para>
  <para style="r">(<ref loc="MAT 27:45-56">𐴔𐴡𐴃𐴢 27‏:45‏-56</ref>; <ref loc="LUK 23:44-49">𐴓𐴟𐴑 23‏:44‏-49</ref>; <ref loc="JHN 19:28-30">𐴘𐴡 19‏:28‏-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴟𐴀𐴣𐴙𐴅𐴧𐴝 𐴁𐴝𐴌𐴡𐴥 𐴖𐴝 𐴁𐴝𐴙𐴅𐴧𐴠𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴁𐴝𐴥𐴎𐴠 𐴉𐴝𐴥𐴕 𐴒𐴟𐴣𐴍𐴝 𐴔𐴟𐴓𐴧𐴟𐴑 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴀𐴡𐴥𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴁𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴓𐴡𐴥𐴘, 𐴀𐴠𐴓𐴡𐴥𐴘, 𐴓𐴝𐴔𐴝𐴥 𐴏𐴝𐴁𐴝𐴑𐴇𐴄𐴝𐴥𐴕𐴞؟“ </char>𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴃𐴡𐴌𐴅𐴟𐴔𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴏𐴝𐴥𐴌𐴞𐴊𐴞𐴘𐴡؟“</char> <note caller="+" style="f"><char style="fr" closed="false">15‏:34 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:1">𐴎𐴡𐴁𐴟𐴌 22‏:1</ref></char></char></note><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />𐴋𐴝𐴥𐴑𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴡𐴌𐴠 𐴋𐴝𐴑𐴠𐴌!“<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴠𐴑𐴎𐴡𐴕𐴠 𐴊𐴟𐴣𐴌𐴞 𐴎𐴝𐴘 𐴏𐴞𐴥𐴌𐴑𐴝𐴃𐴢<note caller="+" style="f"><char style="fr" closed="false">15‏:36 </char><char style="fq">𐴏𐴞𐴥𐴌𐴑𐴝</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴝𐴕𐴞𐴥 𐴔𐴞𐴘𐴝𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴐𐴡𐴥𐴌𐴁𐴡𐴃𐴢, 𐴎𐴞𐴀𐴕 𐴈𐴝𐴥𐴘𐴃𐴠 𐴇𐴡𐴥𐴌𐴡-𐴇𐴡𐴥𐴌𐴡 𐴓𐴝𐴒𐴠.</note> 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴠𐴏𐴉𐴡𐴥𐴕𐴅<note caller="+" style="f"><char style="fr" closed="false">15‏:36 </char><char style="fq">𐴀𐴠𐴏𐴉𐴡𐴥𐴕𐴅</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴞𐴚𐴒𐴞𐴌𐴝𐴎𐴞 𐴓𐴡𐴉𐴎𐴡𐴥, 𐴉𐴟𐴀𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴉𐴝𐴕𐴞𐴥 𐴄𐴝𐴕𐴠 𐴊𐴠 𐴏𐴞𐴎𐴢</note> 𐴁𐴟𐴌𐴝𐴘𐴧𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴖𐴝𐴣𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴁𐴝𐴎𐴝𐴥𐴘𐴊𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴞𐴥𐴘𐴡, 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴠 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴕𐴠𐴥 𐴏𐴝𐴀𐴘𐴢.“<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴒𐴟𐴎𐴡𐴌𐴝𐴕 𐴔𐴝𐴌𐴞 𐴀𐴠𐴕𐴃𐴠𐴇𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴉𐴡𐴌𐴡𐴊𐴝 𐴒𐴝𐴥𐴕 𐴖𐴡𐴃𐴧𐴟𐴥 𐴓𐴡𐴥𐴃𐴞 𐴕𐴞𐴏𐴠 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴉𐴝𐴥𐴍𐴞 𐴊𐴟𐴘 𐴁𐴝𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />𐴎𐴠 𐴌𐴡𐴔𐴞 𐴐𐴝𐴥𐴀𐴂𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴀𐴠𐴕𐴃𐴠𐴇𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢!“<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴀𐴡𐴥 𐴊𐴟𐴌𐴡𐴃𐴧𐴟 𐴒𐴡𐴥𐴌𐴞 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠 𐴊𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞, 𐴐𐴡𐴥𐴣𐴍𐴡 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴏𐴠𐴥𐴏𐴡𐴌 𐴔𐴝𐴦 𐴔𐴡𐴌𐴞𐴘𐴝𐴔, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴓𐴡𐴥𐴔𐴞 𐴘𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴡𐴥 𐴀𐴞𐴏𐴝𐴤 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴃𐴝𐴥𐴘𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴀𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴖𐴡𐴌𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.<verse eid="MRK 15:41" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴝𐴥𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MAT 27:57-61">𐴔𐴡𐴃𐴢 27‏:57‏-61</ref>; <ref loc="LUK 23:50-56">𐴓𐴟𐴑 23‏:50‏-56</ref>; <ref loc="JHN 19:38-42">𐴘𐴡 19‏:38‏-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴔-𐴀𐴡𐴌-𐴊𐴞𐴕، 𐴘𐴝𐴥𐴕𐴞 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕𐴡𐴌 𐴀𐴝𐴒𐴡𐴌 𐴊𐴞𐴕. 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴇𐴝𐴥𐴣𐴎𐴞𐴕𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />𐴀𐴝𐴌𐴝𐴔𐴝𐴥𐴃𐴞𐴘𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴘𐴟𐴏𐴟𐴥𐴉𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴉𐴡𐴥𐴃𐴟𐴖𐴝𐴘𐴞-𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴕𐴝𐴔𐴊𐴝𐴥𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘 𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴝𐴐𐴧𐴗𐴝 𐴔𐴝𐴙𐴒𐴧𐴠𐴥. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴉𐴞𐴓𐴝𐴃𐴢 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴐𐴝𐴥𐴀𐴂𐴢 𐴂𐴗𐴝𐴥𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴀𐴡𐴥𐴘 𐴕𐴠𐴥 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴐𐴝𐴥𐴀𐴂𐴢 𐴂𐴗𐴝𐴥𐴃𐴧𐴟 𐴉𐴝𐴑𐴧𐴝𐴒𐴡𐴌𐴞 𐴁𐴝𐴦𐴊𐴠, 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌𐴠 𐴓𐴝𐴐𐴧𐴗𐴝 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />𐴘𐴟𐴏𐴟𐴥𐴉𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴇𐴡𐴇𐴡𐴥𐴕𐴡𐴌 𐴇𐴡𐴦𐴌 𐴑𐴞𐴕𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴓𐴝𐴐𐴧𐴗𐴝 𐴓𐴝𐴔𐴝𐴘 𐴇𐴡𐴦𐴌 𐴒𐴝𐴥𐴕 𐴁𐴠𐴌𐴝𐴤𐴘𐴧𐴡𐴌𐴠, 𐴐𐴞𐴥𐴓𐴢 𐴑𐴟𐴥𐴣𐴊𐴞 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴌𐴝𐴙𐴑𐴧𐴠𐴥. 𐴁𐴝𐴦𐴊𐴠 𐴈𐴡𐴁𐴡𐴌 𐴒𐴗𐴝𐴌 𐴔𐴟𐴑𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴞𐴥𐴓𐴢 𐴀𐴡𐴗𐴎𐴝𐴘𐴊𐴞𐴘𐴠𐴥. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴝𐴐𐴧𐴗𐴝 𐴇𐴡𐴍𐴠𐴥 𐴌𐴝𐴑𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴏𐴠𐴥𐴏𐴡𐴌 𐴔𐴝𐴦 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MAT 28:1-8">𐴔𐴡𐴃𐴢 28‏:1‏-8</ref>; <ref loc="LUK 24:1-12">𐴓𐴟𐴑 24‏:1‏-12</ref>; <ref loc="JHN 20:1-10">𐴘𐴡 20‏:1‏-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴉𐴟𐴥𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴘 𐴌𐴝𐴥𐴌, 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞 𐴘𐴠, 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴔𐴝𐴦 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴓𐴡𐴥𐴔𐴞𐴘𐴠 𐴑𐴟𐴥𐴐𐴁𐴡 𐴔𐴡𐴏𐴡𐴥𐴓𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴑𐴞𐴕𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴝𐴐𐴡𐴃𐴢 𐴊𐴞𐴦 𐴉𐴝𐴌𐴠. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴉𐴃𐴝𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴊𐴞𐴕 𐴁𐴞𐴀𐴕𐴧𐴝 𐴑𐴟𐴥𐴁𐴢 𐴏𐴡𐴥𐴀𐴌𐴠 𐴁𐴠𐴙𐴓𐴢 𐴀𐴟𐴍𐴠𐴤𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴔𐴟𐴑𐴡𐴃𐴧𐴟 𐴐𐴞𐴥𐴓𐴢 𐴓𐴝𐴕 𐴇𐴡𐴕𐴠 𐴓𐴝𐴌𐴞𐴁𐴡𐴥؟“<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴖𐴡𐴌𐴔𐴞𐴑𐴧𐴝𐴥 𐴏𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴐𐴞𐴥𐴓𐴢 𐴓𐴝𐴕 𐴓𐴝𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴝. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴊𐴡𐴥𐴓𐴝 𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴝𐴤 𐴀𐴠𐴑 𐴅𐴟𐴖𐴝𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴡𐴘𐴍𐴝𐴤 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴏𐴝𐴥𐴌𐴞𐴌𐴠 𐴃𐴟𐴖𐴡𐴀𐴌 𐴊𐴠, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴀𐴓𐴢. 𐴀𐴞𐴥𐴁𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴍𐴠𐴥 𐴕𐴝𐴥𐴘. 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕 𐴏𐴡𐴀. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />𐴘𐴝𐴓𐴝 𐴎𐴡𐴦, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴈𐴡𐴀𐴒𐴡𐴘 𐴊𐴠, ’𐴀𐴞𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴒𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴎𐴝𐴦𐴌. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴠𐴥𐴍𐴠 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴓𐴢.‘ “<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴉𐴞-𐴇𐴝𐴉𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴔𐴧𐴟𐴥𐴑𐴠 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴊𐴟𐴣𐴌𐴊𐴞𐴘𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴥 𐴈𐴡𐴀, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴑𐴟𐴥𐴁𐴢 𐴋𐴡𐴦𐴌 𐴓𐴝𐴥𐴙𐴒𐴧𐴠.<verse eid="MRK 16:8" /></para>
  <para style="s1">𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MAT 28:9-10">𐴔𐴡𐴃𐴢 28‏:9‏-10</ref>; <ref loc="JHN 20:11-18">𐴘𐴡 20‏:11‏-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />𐴇𐴝𐴥𐴉𐴃𐴝𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴊𐴞𐴕 𐴁𐴞𐴀𐴕𐴧𐴝 𐴏𐴡𐴥𐴀𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴒𐴡𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴝𐴒𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴁𐴟𐴥𐴃𐴢 𐴕𐴠𐴓𐴝𐴀𐴓𐴢. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴝𐴘, 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 𐴊𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />𐴀𐴞𐴏𐴝𐴤 𐴎𐴞𐴕𐴊𐴝 𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥.<verse eid="MRK 16:11" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴀𐴟𐴔𐴧𐴡𐴃𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="LUK 24:13-35">𐴓𐴟𐴑 24‏:13‏-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴏𐴟𐴥𐴌𐴡𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴊𐴟𐴘 𐴎𐴡𐴕𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴝𐴌𐴝𐴥 𐴀𐴝𐴥𐴣𐴍𐴞-𐴀𐴝𐴥𐴣𐴍𐴞 𐴉𐴝𐴌𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />𐴃𐴝𐴌𐴝𐴥 𐴎𐴝𐴘 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 𐴊𐴞𐴥𐴘𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴘𐴡𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥.<verse eid="MRK 16:13" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴒𐴝𐴌𐴡 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MAT 28:16-20">𐴔𐴡𐴃𐴢 28‏:16‏-20</ref>; <ref loc="LUK 24:36-49">𐴓𐴟𐴑 24‏:36‏-49</ref>; <ref loc="JHN 20:19-23">𐴘𐴡 20‏:19‏-23</ref>; <ref loc="ACT 1:6-8">𐴈𐴝𐴔 1‏:6‏-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴒𐴝𐴌𐴡 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴝𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴊𐴞𐴓𐴢 𐴊𐴡𐴌𐴡𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴘𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴒𐴡𐴘 𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴡𐴦, 𐴎𐴝𐴘 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴡𐴤𐴒𐴡𐴘.</char> <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴖𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟 𐴀𐴝𐴕𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴞𐴁𐴡.</char> <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" /><char style="wj">𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴞𐴀𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡: 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴥𐴉𐴝𐴘𐴁𐴡; 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴁𐴡𐴤;</char> <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴠 𐴇𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴓𐴞𐴤 𐴊𐴡𐴥𐴌𐴞𐴁𐴡; 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴡𐴦𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴇𐴝𐴥𐴕𐴞 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝𐴌 𐴒𐴝𐴦𐴃𐴢 𐴀𐴝𐴥𐴃𐴢 𐴊𐴞𐴓𐴠𐴥, 𐴃𐴝𐴌𐴝𐴥 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“</char><verse eid="MRK 16:18" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠</para>
  <para style="r">(<ref loc="LUK 24:50-53">𐴓𐴟𐴑 24‏:50‏-53</ref>; <ref loc="ACT 1:9-11">𐴈𐴝𐴔 1‏:9‏-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴈𐴡𐴘𐴧𐴝𐴤 𐴀𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴠𐴦𐴓𐴞 𐴎𐴝𐴘 𐴇𐴝𐴥𐴀𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>