<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴝𐴘𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴝𐴘𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc2">𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴝𐴘𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc3">𐴉𐴞𐴓𐴂𐴢</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴝𐴘𐴀𐴡𐴥𐴓𐴢</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴝𐴘𐴀𐴡𐴥𐴓𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴝𐴘𐴀𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴇𐴝𐴥𐴙𐴄𐴢-𐴀𐴠𐴑 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 <char style="ior">(<ref loc="PHP 1:13">1‏:13</ref>)</char>, 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴞𐴘𐴡𐴥𐴓𐴢 𐴀𐴡𐴃𐴢. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠. 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴈𐴝𐴔𐴡𐴥𐴓𐴡𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞. 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴌𐴝𐴏𐴊𐴝𐴥𐴕𐴞. 𐴀𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴉𐴡𐴀𐴘𐴓𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴢. 𐴀𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴥𐴓𐴝𐴏𐴠 𐴁𐴡𐴥𐴚 𐴁𐴝𐴣𐴊𐴞𐴥 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴘𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴑 𐴌𐴝𐴙𐴃𐴡𐴓𐴧𐴝 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴊𐴞𐴘𐴝 𐴒𐴞𐴀𐴓𐴢 (𐴈𐴝𐴔𐴡𐴥𐴓𐴢 16).</para>
  <para style="ip">𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴁𐴡𐴀𐴗𐴃𐴢 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴞𐴘𐴡𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴠 𐴉𐴟𐴥𐴕𐴞 𐴀𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴓𐴧𐴝 𐴎𐴠 𐴔𐴡𐴊𐴡𐴃𐴧𐴟𐴕 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴧𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 <char style="ior">(<ref loc="PHP 4:10-19">4‏:10‏-19</ref>)</char>. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥 𐴕𐴡𐴘𐴝 𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴂𐴝𐴉𐴡𐴌𐴡𐴊𐴞𐴃𐴟𐴏𐴡𐴓𐴧𐴝 𐴃𐴟𐴀𐴝𐴙𐴅𐴧𐴡 𐴊𐴞𐴘𐴠𐴥 <char style="ior">(<ref loc="PHP 2:19-30">2‏:19‏-30</ref>)</char> 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴀𐴠𐴏𐴃𐴠𐴑𐴁𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴝𐴦𐴌 𐴃𐴝𐴌𐴝𐴥𐴌 𐴕𐴠𐴃𐴝𐴈𐴝𐴔𐴡𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴊𐴠.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="PHP 1:1-2">1‏:1‏-2</ref>)</char></para>
  <para style="io1">2. 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴘𐴝 𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴝 <char style="ior">(<ref loc="PHP 1:3-2:30">1‏:3‏—2‏:30</ref>)</char></para>
  <para style="io1">3. 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴔𐴡𐴥𐴓𐴞 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 <char style="ior">(<ref loc="PHP 3:1-4:9">3‏:1‏—4‏:9</ref>)</char></para>
  <para style="io1">4. 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="PHP 4:10-23">4‏:10‏-23</ref>)</char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴟𐴓𐴝𐴔.</para>
  <para style="p" vid="PHP 1:1">𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌; 𐴇𐴠𐴥𐴍𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴒𐴡𐴥𐴓𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤.<verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="PHP 1:2" /></para>
  <para style="s1">𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴝𐴘𐴀𐴡𐴥𐴓𐴡𐴓𐴧𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴊𐴟𐴖𐴝</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴠𐴃𐴡𐴥𐴁𐴝𐴌 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴇𐴠𐴥𐴃𐴡𐴁𐴝𐴌 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴒𐴡𐴌𐴞𐴥, <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴇𐴝𐴥𐴀𐴌 𐴊𐴟𐴖𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴡𐴌𐴞𐴥, <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴉𐴡𐴀𐴘𐴓𐴝 𐴊𐴞𐴕𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴡𐴥𐴓𐴝𐴌 𐴈𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴙𐴅 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴝𐴏𐴡𐴤. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴘𐴝𐴀𐴕 𐴀𐴠𐴑𐴞𐴕 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴏𐴡𐴓𐴝𐴘 𐴓𐴡𐴘𐴎𐴝𐴘 𐴉𐴟𐴌𐴟𐴏𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.<verse eid="PHP 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 1:7" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴌𐴝𐴑𐴡𐴥𐴕 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴄𐴞𐴥𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴝𐴏𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴁𐴡𐴕 𐴃𐴝𐴥𐴑𐴞 𐴘𐴝𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴏𐴡𐴥𐴉𐴝𐴘 𐴊𐴞𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴁𐴝𐴥𐴒𐴞. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴁𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴊𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴇𐴡𐴊𐴧𐴟𐴥𐴌 𐴉𐴟𐴌𐴠𐴌.<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />𐴀𐴝𐴀𐴛 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴞𐴘𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴟𐴊𐴧𐴞𐴥𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴠𐴃𐴡𐴥 𐴀𐴠𐴥𐴃𐴡 𐴁𐴞𐴐𐴞𐴤 𐴁𐴝𐴌𐴝𐴤𐴃𐴢 𐴃𐴝𐴥𐴑𐴠 𐴉𐴝𐴥𐴕; <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴀𐴟𐴃𐴧𐴡𐴔 𐴇𐴞𐴥𐴀𐴕 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴂𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴃𐴝𐴥𐴑𐴡, <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴁𐴡𐴥𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴡𐴌𐴠; 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥.<verse eid="PHP 1:11" /></para>
  <para style="s1">𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴒𐴟𐴎𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴞𐴥𐴀𐴕𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴎𐴠𐴃𐴡𐴥 𐴀𐴠𐴥𐴃𐴡 𐴉𐴡𐴥𐴓𐴝𐴃𐴢 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴁𐴡𐴕 𐴀𐴝𐴏𐴞𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴌𐴝𐴎𐴔𐴡𐴇𐴡𐴥𐴓𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴑𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴕 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴡𐴃𐴧𐴟 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴀𐴠𐴊𐴧𐴟𐴥𐴌 𐴁𐴝𐴌𐴞𐴥𐴒𐴞𐴘𐴡𐴘 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘 𐴑𐴝𐴓𐴝𐴔 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴌𐴞𐴐𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴁𐴧𐴝𐴃𐴡𐴌 𐴕𐴞𐴘𐴡𐴃𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴁𐴝𐴥𐴓𐴝 𐴕𐴞𐴘𐴡𐴃𐴠 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />𐴉𐴞𐴏𐴡𐴥𐴌 𐴒𐴟𐴥𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴁𐴠 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴏𐴡𐴥𐴉𐴝𐴘 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴖𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴕𐴠. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴒𐴡𐴌 𐴒𐴟𐴥𐴕𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴠𐴈𐴠𐴥𐴓𐴝𐴏𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴠; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴄𐴝𐴥𐴀𐴌𐴠 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴁𐴡𐴕 𐴀𐴝𐴏𐴞𐴤 𐴊𐴠 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />𐴃𐴡𐴥𐴘 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠؟ 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴁𐴠𐴥𐴃𐴢 𐴊𐴡𐴥𐴌𐴞 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴞𐴘𐴡𐴃𐴠 𐴀𐴡𐴥𐴑, 𐴉𐴡𐴃𐴧𐴞𐴥 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴀𐴠𐴥𐴕𐴝 𐴀𐴡𐴥𐴌; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴑𐴟𐴥𐴐𐴞.</para>
  <para style="p" vid="PHP 1:18">𐴀𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔 𐴀𐴡𐴥, <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴒𐴟𐴎𐴡𐴌𐴠𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴀𐴡𐴥𐴘𐴧𐴟𐴔. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴟𐴖𐴝𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴟𐴀𐴌 𐴔𐴡𐴊𐴡𐴃𐴠 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴠𐴑𐴞𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴐𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝 𐴕𐴡 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴀𐴕 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴇𐴝𐴥𐴔𐴞𐴐𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴘𐴝𐴓𐴝 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴦𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴝𐴀𐴛 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴞 𐴘𐴝𐴥 𐴔𐴡𐴌𐴞. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞, 𐴀𐴝𐴦𐴌 𐴔𐴡𐴦𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴓𐴝𐴉𐴢. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴇𐴝𐴘𐴧𐴝𐴘𐴠 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴑𐴞𐴔𐴡𐴃𐴞 𐴈𐴝𐴔𐴡𐴌 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴟𐴔. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴡𐴕 𐴕𐴝𐴥𐴕 𐴁𐴝𐴏𐴞𐴥𐴃𐴝𐴔 𐴀𐴝𐴀𐴛 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />𐴀𐴝𐴀𐴛 𐴊𐴟𐴘𐴈𐴝𐴍𐴝𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥: 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴊𐴠, 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴧𐴟 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴠𐴀𐴃𐴡𐴌 𐴀𐴡𐴥𐴘𐴁𐴡; <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴝𐴀𐴛 𐴇𐴝𐴘𐴧𐴝𐴘𐴠 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴝 𐴃𐴡 𐴀𐴝𐴌𐴡𐴤 𐴎𐴡𐴌𐴟𐴌. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴠𐴑𐴞𐴕𐴠 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴟𐴔 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴢 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴑𐴡. <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴘𐴓𐴠𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴀𐴝𐴣𐴀𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴁𐴝𐴌𐴞𐴥𐴎𐴝𐴘𐴁𐴡𐴘.<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴡𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴁𐴝𐴕𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴝𐴀𐴘𐴢 𐴘𐴝𐴥 𐴒𐴝𐴙𐴌𐴇𐴝𐴥𐴎𐴞𐴌 𐴃𐴝𐴥𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴎𐴠𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴥𐴕𐴞 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴑 𐴌𐴟𐴀𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴡𐴤 𐴀𐴝𐴦𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴃𐴧𐴟 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴑 𐴔𐴡𐴕𐴠 𐴔𐴞𐴓𐴞𐴎𐴟𐴥𐴓𐴞 𐴁𐴞𐴐𐴞𐴤 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴌. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴇𐴝𐴥𐴓𐴡𐴃𐴠 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴇𐴝𐴥𐴓𐴝𐴑 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕, 𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴝𐴌, 𐴎𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴁𐴝𐴌 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴊𐴟𐴑 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴥. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴊𐴟𐴑 𐴀𐴟𐴀𐴙𐴕 𐴉𐴡𐴀𐴌 𐴎𐴞𐴀𐴕 𐴀𐴝𐴀𐴛 𐴉𐴝𐴀𐴘𐴓𐴝𐴔 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴝 𐴀𐴝𐴦𐴌 𐴘𐴝𐴓𐴝 𐴘𐴡𐴥 𐴉𐴝𐴙𐴌 𐴊𐴠 𐴉𐴟𐴥𐴕𐴡𐴌.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴞𐴌𐴡𐴥𐴐𐴞 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴣𐴀𐴌𐴒𐴞𐴌𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴅𐴡𐴏𐴁𐴝 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴇𐴡𐴕𐴡𐴤 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴊𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌 𐴑𐴟𐴥𐴐𐴞 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴡𐴤: 𐴀𐴠𐴑 𐴔𐴡𐴕 𐴀𐴡𐴥𐴘𐴧𐴡𐴌𐴠, 𐴀𐴠𐴑𐴞𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥𐴘𐴡𐴌𐴠, 𐴎𐴝𐴕𐴠 𐴀𐴠𐴑 𐴀𐴡𐴥𐴘𐴧𐴡𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑𐴞𐴤 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴌𐴝𐴑𐴞𐴥𐴘𐴡𐴌𐴠. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴠 𐴘𐴝𐴥 𐴁𐴝𐴌𐴞𐴥𐴑 𐴑𐴟𐴥𐴖𐴝𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴀𐴡𐴥𐴘 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴀𐴟𐴃𐴧𐴡𐴔 𐴁𐴝𐴥𐴉𐴞𐴘𐴡. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴡 𐴏𐴝𐴘𐴧𐴡𐴥, 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝 𐴘𐴡𐴥 𐴏𐴝𐴘𐴧𐴡𐴥.<verse eid="PHP 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴌𐴝𐴑𐴡𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢:<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />𐴀𐴞𐴥𐴁𐴝 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡,</para>
  <para style="q2" vid="PHP 2:6">𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴥𐴀𐴝𐴙𐴕𐴧𐴝𐴒𐴞𐴌𐴞𐴌𐴠 𐴏𐴞𐴁𐴞 𐴊𐴡𐴥𐴌𐴞 𐴌𐴝𐴑𐴞𐴥𐴊𐴞𐴃𐴡 𐴕𐴡𐴥 𐴏𐴝𐴀,<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴇𐴝𐴥𐴓𐴞 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴙𐴓𐴢,</para>
  <para style="q2" vid="PHP 2:7">𐴒𐴟𐴓𐴝𐴔 𐴁𐴡𐴕𐴞,</para>
  <para style="q2" vid="PHP 2:7">𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴎𐴡𐴕𐴡𐴔 𐴓𐴡𐴘𐴧𐴡𐴌𐴠.<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴐𐴡𐴑𐴡𐴥𐴓𐴠 𐴃𐴝𐴥𐴑𐴞,</para>
  <para style="q2" vid="PHP 2:8">𐴔𐴡𐴦𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡, 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴌 𐴖𐴡𐴌𐴠 𐴔𐴡𐴌𐴠 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴘𐴧𐴡𐴌𐴠</para>
  <para style="q2" vid="PHP 2:8">𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="PHP 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴃𐴡𐴑𐴧𐴝𐴃𐴢 𐴃𐴟𐴙𐴓𐴧𐴠𐴥,</para>
  <para style="q2" vid="PHP 2:9">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴝𐴔 𐴖𐴝𐴀𐴕 𐴊𐴞𐴦𐴘𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴇𐴝𐴥𐴀𐴌 𐴕𐴝𐴔𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌,<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴔𐴡𐴃𐴢 𐴇𐴝𐴥𐴀𐴌 𐴑𐴞𐴘𐴠𐴥 𐴀𐴝𐴣𐴍𐴟𐴥 𐴉𐴠𐴥𐴓𐴝,</para>
  <para style="q2" vid="PHP 2:10">𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴡𐴥𐴑 𐴘𐴝𐴥 𐴎𐴡𐴁𐴞𐴕 𐴀𐴡𐴃𐴢, 𐴘𐴝𐴥 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴕𐴞𐴏𐴠;<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴎𐴡𐴁𐴝𐴕𐴠 𐴎𐴠𐴕 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠,</para>
  <para style="q2" vid="PHP 2:11">𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴓𐴞𐴑.<verse eid="PHP 2:11" /></para>
  <para style="s1">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴏𐴠𐴌𐴝𐴑𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴡𐴓𐴡𐴀𐴌</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴣𐴀𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴙𐴌𐴇𐴝𐴥𐴎𐴞𐴌𐴞𐴃𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴝𐴌𐴡𐴤 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴓𐴝 𐴋𐴡𐴦𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴉𐴝𐴕𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴕𐴠𐴅𐴝𐴃𐴡𐴌 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥𐴎𐴡, <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴠𐴥𐴕𐴝 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥 𐴊𐴠 𐴀𐴠𐴌𐴝𐴊𐴝 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝.<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴐𐴠𐴥𐴑𐴝𐴘𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌𐴑𐴝𐴃𐴡𐴌𐴑𐴞 𐴏𐴝𐴥𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴦𐴏𐴟𐴔 𐴁𐴡𐴕𐴞, 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴄𐴠𐴍𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴀𐴣𐴌𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴝𐴑 𐴏𐴝𐴥𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴄𐴡𐴥𐴀𐴌𐴡, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴔𐴝𐴎𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴏𐴠𐴌𐴝𐴑𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴡𐴓𐴡𐴀𐴌, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴑𐴝𐴓𐴝𐴔𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴡𐴥𐴌𐴞 𐴀𐴝𐴏𐴡𐴤; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴝𐴦𐴉𐴠𐴏𐴞𐴌 𐴊𐴞𐴕 𐴀𐴝𐴀𐴛 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴟𐴔 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴁𐴠𐴇𐴝𐴌 𐴊𐴟𐴣𐴙𐴅𐴧𐴞𐴥 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴁𐴠𐴇𐴝𐴌 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />𐴉𐴟𐴥𐴕𐴡, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞𐴌 𐴖𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴌𐴡𐴐𐴢 𐴑𐴟𐴌𐴁𐴝𐴕𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴝 𐴉𐴡𐴌𐴠, 𐴃𐴡𐴀 𐴀𐴝𐴀𐴛 𐴑𐴟𐴥𐴐𐴞 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤.<verse eid="PHP 2:18" /></para>
  <para style="s1">𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴂𐴝𐴉𐴡𐴌𐴡𐴊𐴞𐴃𐴟𐴏𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴏𐴝𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴇𐴝𐴥𐴌𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴟𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴉𐴝𐴘. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴌 𐴑𐴞𐴘𐴡𐴥 𐴕𐴝𐴥𐴘, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴠𐴈𐴠𐴥𐴓𐴝𐴏𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴝 𐴒𐴡𐴌𐴠𐴥. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴃𐴢 𐴁𐴠 𐴓𐴝𐴒𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴟𐴥𐴕𐴡𐴃𐴢 𐴕𐴡. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />𐴓𐴠𐴑𐴞𐴕 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌 𐴑𐴞𐴔𐴡𐴃𐴢 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴡, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴉𐴟𐴖𐴝𐴘𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴝𐴉𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴡𐴥𐴓𐴝𐴓𐴧𐴝 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴓𐴧𐴠 𐴔𐴡𐴃𐴧𐴡𐴌 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴟𐴔. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔.<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘 𐴀𐴠𐴂𐴝𐴉𐴡𐴌𐴡𐴊𐴞𐴃𐴟𐴏𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴡𐴕 𐴎𐴡𐴌𐴟𐴌𐴞 𐴁𐴡𐴓𐴞 𐴁𐴝𐴥𐴉𐴞𐴌, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴉𐴡𐴥𐴗𐴏𐴢, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴥𐴁𐴡𐴌𐴒𐴗𐴝 𐴘𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴓𐴝. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴏𐴝𐴘𐴃𐴡𐴥 𐴑𐴟𐴥𐴁𐴢 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴐𐴟𐴥𐴑𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴟𐴥𐴙𐴕𐴧𐴡 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴐𐴟𐴥𐴑𐴠 𐴔𐴡𐴌𐴡𐴕-𐴔𐴡𐴌𐴡𐴕 𐴀𐴡𐴥𐴀𐴙𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴘𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴌 𐴖𐴡𐴌𐴠 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴊𐴠𐴑𐴞𐴥 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴏𐴞𐴕𐴃𐴝 𐴘𐴡𐴥 𐴈𐴡𐴔𐴠. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴈𐴝𐴔𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴔𐴡𐴦𐴃𐴡𐴌 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴀𐴡𐴥𐴀𐴙𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴎𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴈𐴡𐴔𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴡𐴥𐴃𐴝𐴌𐴝𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴙𐴓𐴢.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s1">𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤. 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴠𐴑𐴞𐴤 𐴈𐴡𐴃𐴝𐴤 𐴓𐴠𐴑𐴞𐴥𐴃𐴠 𐴊𐴟𐴑 𐴕𐴡 𐴓𐴝𐴒𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴝. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />𐴑𐴟𐴣𐴙𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡, 𐴘𐴝𐴥𐴕𐴞 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴅𐴞𐴏𐴞𐴥𐴔 𐴈𐴝𐴍𐴞-𐴏𐴞𐴥𐴌𐴞 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴠𐴥. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴓𐴡𐴥𐴘 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥, <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴖𐴝𐴅𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡. 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴖𐴝𐴅𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴡 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴠𐴤: <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴣𐴐𐴄𐴡 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢; 𐴀𐴝𐴀𐴛 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞, 𐴁𐴞𐴕𐴘𐴝𐴔𐴞𐴕𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕 𐴀𐴡𐴃𐴧𐴟, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴁𐴌𐴝𐴕𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴇𐴞𐴁𐴌𐴝𐴕𐴞. 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔; <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />𐴅𐴟𐴏𐴢 𐴃𐴝𐴥𐴑𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔; 𐴀𐴝𐴦𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴕𐴞𐴊𐴝𐴑 𐴉𐴝𐴦 𐴎𐴝𐴘𐴃𐴡.<verse eid="PHP 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴞𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴕𐴡𐴉𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴘𐴝𐴓𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴓𐴟𐴏𐴧𐴝𐴥𐴕 𐴁𐴡𐴓𐴞 𐴒𐴡𐴕𐴞. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴌𐴠 𐴓𐴟𐴏𐴧𐴝𐴥𐴕 𐴁𐴡𐴓𐴞 𐴒𐴡𐴕𐴞 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴎𐴝𐴕𐴝𐴃𐴢 𐴀𐴡𐴥𐴊𐴡𐴌𐴁𐴝𐴀𐴌𐴝 𐴑𐴞𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴕𐴞𐴑𐴞 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴓𐴟𐴏𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴘𐴧𐴞 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴉𐴟𐴥𐴌𐴝𐴌𐴞 𐴁𐴡𐴓𐴞 𐴒𐴡𐴕𐴞, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴉𐴝𐴘, <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴝𐴦 𐴎𐴝, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴉𐴝𐴦 𐴎𐴝 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴡𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴓𐴠 𐴉𐴝𐴦 𐴎𐴝 𐴊𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝, 𐴎𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴁𐴠 𐴀𐴝𐴘𐴧𐴠𐴤. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴌𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴑𐴧𐴡𐴥𐴃𐴢 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴖𐴝𐴌𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴕𐴡𐴔𐴟𐴕𐴝𐴘𐴠 𐴔𐴡𐴌𐴞-𐴔𐴡𐴌𐴞; <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />𐴎𐴠𐴀𐴕𐴠 𐴇𐴡𐴕𐴡𐴤 𐴁𐴡𐴃𐴠 𐴀𐴝𐴀𐴛 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴘𐴡𐴥 𐴉𐴡𐴀𐴣𐴏𐴞.<verse eid="PHP 3:11" /></para>
  <para style="s1">𐴔𐴡𐴕𐴎𐴞𐴓𐴢-𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴡𐴌 𐴀𐴟𐴎𐴟 𐴊𐴟𐴣𐴌𐴝</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴞 𐴘𐴝𐴥 𐴀𐴝𐴀𐴛 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴞𐴒𐴡𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴖𐴝𐴀𐴕 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠 𐴊𐴟𐴣𐴌𐴝𐴃𐴢 𐴀𐴝𐴏𐴞𐴤 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴕𐴞𐴘𐴡𐴃𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴠. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴞 𐴁𐴡𐴓𐴞 𐴕𐴡 𐴄𐴝𐴥𐴀𐴌𐴞, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠: 𐴉𐴞𐴏𐴠𐴤 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴉𐴡𐴀𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘 𐴔𐴟𐴀𐴕𐴃𐴟 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴉𐴡𐴀𐴣𐴏𐴞𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />𐴀𐴝𐴀𐴛 𐴔𐴡𐴕𐴎𐴞𐴓𐴢-𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴡𐴌 𐴀𐴟𐴎𐴟 𐴊𐴟𐴣𐴌𐴝𐴃𐴢 𐴀𐴝𐴏𐴞𐴤 𐴊𐴠, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴋𐴝𐴑 𐴀𐴝𐴏𐴠𐴤, 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴘𐴞𐴥𐴁𐴝 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝.<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴝𐴓𐴡𐴑 𐴀𐴝𐴏𐴞𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴇𐴠𐴥 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴌𐴝𐴑𐴝𐴤𐴌 𐴎𐴡𐴌𐴟𐴌. 𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴡𐴙𐴕𐴧𐴡 𐴋𐴡𐴙𐴓𐴧𐴝 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />𐴎𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴡𐴥𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴊𐴧𐴟𐴥𐴌𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴞𐴒𐴡𐴘 𐴇𐴠𐴥𐴊𐴧𐴟𐴌𐴡𐴌 𐴔𐴟𐴃𐴝𐴉𐴠𐴑 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴊𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴘𐴡 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴕𐴡𐴔𐴟𐴕𐴝 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴠. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴝𐴌 𐴈𐴡𐴀𐴘𐴓𐴝𐴔, 𐴀𐴝𐴦𐴌 𐴘𐴝𐴓𐴝 𐴈𐴝𐴣𐴊𐴞-𐴈𐴝𐴣𐴊𐴞 𐴘𐴡𐴥 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴌 𐴊𐴟𐴐𐴧𐴡𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴠; <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴃𐴡𐴑𐴊𐴞𐴥𐴌𐴡𐴃𐴢 𐴁𐴡𐴌𐴁𐴝𐴊𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴑𐴟𐴥𐴊𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴠𐴄𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴐𐴡𐴥𐴌𐴡𐴔 𐴓𐴝𐴒𐴝 𐴉𐴡𐴙𐴃𐴧𐴡 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴘 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴁𐴠 𐴔𐴡𐴕 𐴊𐴠. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴝𐴒𐴡𐴌𐴞𐴃𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴡𐴃𐴢, 𐴎𐴠𐴕𐴃𐴟𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴘𐴝𐴥𐴕𐴞 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴎𐴧𐴟𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴞𐴤, <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴇𐴝𐴘𐴧𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴓𐴝 𐴒𐴝𐴦𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴊𐴡𐴓𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴎𐴞𐴘𐴝𐴥𐴕 𐴓𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴞𐴎𐴡𐴌 𐴑𐴡𐴁𐴎𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴉𐴝𐴌𐴠.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴏𐴝𐴘𐴃𐴡𐴥 𐴑𐴟𐴥𐴁𐴢 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴑𐴟𐴥𐴐𐴞 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴃𐴝𐴥𐴌 𐴃𐴝𐴏𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴓𐴞 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴃𐴝𐴥𐴑𐴡, 𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢.<verse eid="PHP 4:1" /></para>
  <para style="s1">𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />𐴀𐴝𐴀𐴛 𐴘𐴟𐴖𐴝𐴥𐴊𐴞𐴘𐴝𐴌𐴠 𐴘𐴡𐴥 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌 𐴀𐴝𐴦𐴌 𐴏𐴟𐴕𐴃𐴡𐴑𐴞𐴌𐴠 𐴘𐴡𐴥 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴡𐴕 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />𐴀𐴝𐴦𐴌, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴏𐴝𐴥𐴀𐴣𐴃𐴞, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴘𐴡𐴥 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴇𐴠𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴕𐴟𐴥𐴕𐴡𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴡𐴥𐴓𐴞 𐴁𐴡𐴓𐴧𐴝 𐴑𐴠𐴓𐴠𐴔𐴠𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴐𐴡𐴥𐴀 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴞𐴐𐴞𐴤 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴕𐴝𐴔 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌-𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴑𐴡; 𐴀𐴝𐴀𐴛 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴙𐴌, 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴑𐴡. <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴞𐴥𐴊𐴝𐴘𐴞 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴡𐴤. 𐴔𐴝𐴓𐴞𐴑 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴘𐴧𐴠𐴤𐴌. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴝𐴥𐴀𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴊𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴌𐴡𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴡𐴥. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴝𐴥𐴕𐴃𐴞, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴌𐴝𐴌 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴁𐴝𐴀𐴌𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴑𐴞𐴥𐴘𐴝𐴓𐴡𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥𐴁𐴡.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴞𐴀𐴕 𐴇𐴝𐴥𐴣𐴏𐴝, 𐴎𐴞𐴀𐴕 𐴀𐴞𐴎𐴧𐴡𐴃𐴊𐴝𐴥𐴌, 𐴎𐴞𐴀𐴕 𐴏𐴡𐴥𐴘𐴧𐴞, 𐴎𐴞𐴀𐴕 𐴂𐴝𐴑, 𐴎𐴞𐴀𐴕 𐴐𐴟𐴥𐴕𐴊𐴡𐴌, 𐴎𐴞𐴀𐴕 𐴕𐴝𐴔𐴊𐴝𐴥𐴌, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴞𐴀𐴕 𐴀𐴟𐴃𐴧𐴡𐴔 𐴀𐴝𐴦𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴀𐴝𐴏𐴠𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴁𐴠 𐴌𐴝𐴑𐴡𐴥. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴐𐴞𐴥𐴑𐴧𐴡, 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴉𐴟𐴥𐴙𐴕𐴧𐴡, 𐴀𐴠𐴊𐴧𐴠 𐴊𐴠𐴙𐴑𐴧𐴡𐴥, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴘 𐴐𐴝𐴥𐴕𐴃𐴞 𐴊𐴡𐴦𐴘𐴝 𐴀𐴝𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.<verse eid="PHP 4:9" /></para>
  <para style="s1">𐴔𐴡𐴊𐴡𐴃𐴡𐴓𐴧𐴝 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />𐴀𐴝𐴀𐴛 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴝𐴓𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴞 𐴀𐴝𐴁𐴝𐴌 𐴎𐴝𐴌𐴞 𐴀𐴡𐴥𐴘𐴧𐴠; 𐴁𐴠𐴐𐴡𐴥𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴒𐴠 𐴘𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴝𐴌 𐴔𐴡𐴑𐴝 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴟𐴀𐴃𐴝𐴐𐴡𐴃𐴢 𐴉𐴡𐴌𐴞 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴕𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴑𐴝 𐴐𐴞𐴥𐴑𐴧𐴞. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />𐴀𐴝𐴀𐴛 𐴈𐴡𐴔 𐴃𐴝𐴥𐴑𐴝 𐴑𐴠𐴀𐴕 𐴊𐴠 𐴘𐴡𐴥 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴦𐴐𐴢 𐴃𐴝𐴥𐴑𐴝 𐴑𐴠𐴀𐴕 𐴊𐴠 𐴘𐴡𐴥 𐴎𐴝𐴕𐴞. 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴀𐴌 𐴔𐴞𐴑𐴧𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴑𐴝𐴌 𐴒𐴟𐴉𐴡𐴕𐴞 𐴐𐴞𐴥𐴑𐴧𐴞, 𐴁𐴡𐴥𐴌𐴝 𐴉𐴠𐴍𐴡𐴃𐴢 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴇𐴝𐴥𐴓𐴞 𐴉𐴠𐴍𐴡𐴃𐴢, 𐴁𐴠𐴦𐴐𐴢 𐴃𐴝𐴥𐴑𐴝𐴃𐴢 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴔𐴟𐴀𐴃𐴝𐴐𐴢 𐴀𐴡𐴃𐴢. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴟𐴁𐴝𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴡𐴓𐴢 𐴊𐴠𐴦.<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />𐴃𐴡𐴀 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴡𐴥𐴘𐴧𐴡. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />𐴀𐴡𐴥 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴝𐴘𐴀𐴡𐴥𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴊𐴠 𐴎𐴝𐴕𐴡, 𐴉𐴡𐴀𐴘𐴓𐴝𐴁𐴝𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴃𐴧𐴟 𐴒𐴞𐴀𐴓𐴝𐴔𐴁𐴡𐴘, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴎𐴡𐴔𐴝𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴓𐴠𐴕𐴊𐴠𐴕 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴕𐴡𐴥. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴑𐴝𐴃𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴀𐴠𐴑 𐴁𐴝𐴌 𐴔𐴡𐴊𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴓𐴝. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠 𐴇𐴠𐴥𐴀𐴕 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴡𐴉𐴝𐴤 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠, 𐴎𐴞𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴞𐴥𐴏𐴝𐴉𐴡𐴃𐴢 𐴁𐴝𐴌𐴞𐴥𐴎𐴝𐴌𐴒𐴡𐴘. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴞, 𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴡𐴥𐴊𐴡𐴌𐴁𐴝𐴀𐴌𐴝 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴠𐴂𐴝𐴉𐴡𐴌𐴡𐴊𐴞𐴃𐴟𐴏𐴡𐴌 𐴀𐴝𐴥𐴃𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴓𐴝 𐴇𐴞𐴥𐴀𐴕 𐴉𐴝𐴘𐴧𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴑𐴟𐴥𐴐𐴁𐴡𐴊𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴡𐴁𐴟𐴓𐴊𐴝𐴥𐴌 𐴑𐴟𐴌𐴁𐴝𐴕𐴞, 𐴎𐴞𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴊𐴡𐴥𐴕𐴡𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴥𐴀𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.<verse eid="PHP 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PHP 4:20" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴡𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="PHP 4:20" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴡. 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴑𐴝𐴥𐴘𐴏𐴝𐴌𐴡𐴌<note caller="+" style="f"><char style="fr" closed="false">4‏:22 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴑𐴝𐴥𐴘𐴏𐴝𐴌 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴝𐴔 𐴕𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴡𐴔 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴡𐴑𐴡𐴥𐴁𐴢.</char></note> 𐴒𐴡𐴥𐴌𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴌𐴟𐴀𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>