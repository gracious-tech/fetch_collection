<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴉𐴞𐴓𐴞𐴔𐴡𐴕</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴉𐴞𐴓𐴞𐴔𐴡𐴕</para>
  <para style="toc2">𐴉𐴞𐴓𐴞𐴔𐴡𐴕</para>
  <para style="toc3">𐴉𐴞𐴓𐴔</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴉𐴞𐴓𐴞𐴔𐴡𐴕</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴉𐴞𐴓𐴞𐴔𐴡𐴕𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴉𐴞𐴓𐴞𐴔𐴡𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴝𐴍𐴞𐴥 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 <char style="ior">(<ref loc="PHM 1:1">1‏:1</ref>)</char>. 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴃𐴝𐴥𐴘 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴑𐴠𐴥𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴇𐴠𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴇𐴝𐴥𐴙𐴄𐴢-𐴀𐴠𐴑 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴎𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴀𐴡𐴥𐴓𐴢 𐴀𐴡𐴥 𐴓𐴠𐴙𐴑𐴧𐴠𐴥.</para>
  <para style="ip">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴉𐴞𐴓𐴞𐴔𐴡𐴕 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢. 𐴉𐴞𐴓𐴞𐴔𐴡𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢, 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴕𐴠𐴏𐴞𐴥𐴔𐴡𐴏𐴢, 𐴎𐴠𐴦 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴏𐴟𐴌𐴞 𐴒𐴡𐴌𐴞𐴥 𐴊𐴝𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴕𐴡 𐴊𐴠. 𐴌𐴡𐴔𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴝𐴦𐴕𐴟𐴕 𐴔𐴡𐴎𐴞𐴕، 𐴉𐴞𐴓𐴞𐴔𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴡𐴕𐴠𐴏𐴞𐴥𐴔𐴡𐴏𐴡𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑 𐴀𐴝𐴏𐴠𐴤. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴡𐴌𐴞𐴑𐴝 𐴊𐴝𐴈𐴝𐴤𐴘𐴊𐴞𐴘𐴡𐴌𐴠 𐴉𐴞𐴓𐴞𐴔𐴡𐴕𐴡𐴌𐴠 𐴁𐴟𐴎𐴊𐴞𐴘𐴠𐴥 𐴊𐴠 𐴑𐴞, 𐴀𐴡𐴕𐴠𐴏𐴞𐴥𐴔𐴡𐴏𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴁𐴝𐴥𐴘 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴡𐴕𐴠𐴏𐴞𐴥𐴔𐴡𐴏𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞𐴃𐴡 <char style="ior">(<ref loc="PHM 1:13-14">1‏:13‏-14</ref>)</char>.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴉𐴞𐴓𐴞𐴔𐴡𐴕𐴡𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="PHM 1:1-3">1‏:1‏-3</ref>)</char></para>
  <para style="io1">2. 𐴀𐴡𐴕𐴠𐴏𐴞𐴥𐴔𐴡𐴏𐴡𐴓𐴧𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴝𐴌𐴡𐴏𐴢 <char style="ior">(<ref loc="PHM 1:4-21">1‏:4‏-21</ref>)</char></para>
  <para style="io1">3. 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴁𐴠𐴌𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴀𐴌 𐴕𐴞𐴘𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="PHM 1:22-25">1‏:22‏-25</ref>)</char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴇𐴡𐴊𐴞, 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴥𐴘 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤.</para>
  <para style="b" vid="PHM 1:1" />
  <para style="p" vid="PHM 1:1">𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴉𐴞𐴓𐴞𐴔𐴡𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴥𐴙𐴕 𐴀𐴝𐴉𐴞𐴘𐴝𐴌 𐴇𐴝𐴣𐴏𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴝𐴌𐴑𐴞𐴂𐴟𐴏𐴡𐴌 𐴇𐴝𐴣𐴏𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴓𐴞𐴔𐴡𐴕𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌.<verse eid="PHM 1:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="PHM 1:3" /></para>
  <para style="s1">𐴉𐴞𐴓𐴞𐴔𐴡𐴕𐴡𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴔𐴝𐴕</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />𐴀𐴝𐴀𐴛 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴎𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴎𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴉𐴟𐴥𐴕𐴝𐴃𐴢 𐴀𐴝𐴏𐴞𐴤. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />𐴀𐴝𐴀𐴛 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠, 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠 𐴁𐴝𐴥𐴓𐴝-𐴁𐴝𐴥𐴓𐴝 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴘𐴧𐴞𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴎𐴠𐴕 𐴀𐴝𐴌𐴡𐴤 𐴁𐴝𐴌𐴠𐴥. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴦𐴌 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴉𐴝𐴘𐴧𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴞𐴓𐴡𐴌𐴠 𐴉𐴡𐴄𐴉𐴡𐴙𐴄𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.<verse eid="PHM 1:7" /></para>
  <para style="s1">𐴀𐴡𐴕𐴠𐴏𐴞𐴥𐴔𐴡𐴏𐴡𐴓𐴧𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴝𐴌𐴡𐴏𐴢</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴇𐴡𐴥𐴑 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />𐴃𐴡𐴀 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔. 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴁𐴟𐴌𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢, 𐴀𐴝𐴀𐴛 𐴘𐴝𐴓𐴝 𐴘𐴡𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴇𐴡𐴊𐴞 𐴁𐴡𐴕𐴞 𐴀𐴝𐴏𐴞𐴤. <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝 𐴀𐴡𐴕𐴠𐴏𐴞𐴥𐴔𐴡𐴏𐴢<note caller="+" style="f"><char style="fr" closed="false">1‏:10 </char><char style="fq" closed="false">𐴀𐴡𐴕𐴠𐴏𐴞𐴥𐴔𐴡𐴏𐴢 </char><char style="ft" closed="false">𐴔𐴝𐴀𐴕𐴞 </char><char style="fqa" closed="false">𐴇𐴝𐴎𐴡𐴌.</char></note> 𐴀𐴡𐴓𐴧𐴝 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴠𐴍𐴠𐴥 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴕𐴝𐴘 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴞𐴒𐴡𐴘. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴁𐴠𐴇𐴝𐴎𐴡𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴀𐴡𐴓𐴧𐴝, 𐴘𐴝𐴥𐴕𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴇𐴝𐴎𐴡𐴌 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴡𐴓𐴞𐴎𐴝𐴌 𐴃𐴟𐴑𐴟𐴍𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴏𐴝𐴀𐴘𐴓𐴝𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴝𐴀𐴛 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴁𐴡𐴕 𐴃𐴝𐴥𐴑𐴞, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴠𐴎𐴞𐴕 𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕 𐴕𐴡𐴥 𐴒𐴡𐴌𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴠 𐴁𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴇𐴞𐴥𐴀𐴕 𐴔𐴡𐴅𐴁𐴟𐴌𐴞𐴘𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴡𐴌𐴡𐴤. <verse eid="PHM 1:14" /><verse number="15" style="v" sid="PHM 1:15" />𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴡𐴑𐴃𐴡𐴥 𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝𐴓𐴧𐴝 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴉𐴡𐴦. <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴁𐴝𐴌𐴡𐴃𐴢 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴒𐴟𐴓𐴝𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴉𐴝𐴘𐴁𐴝 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴟𐴓𐴝𐴔𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴁𐴝𐴥𐴘 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴉𐴝𐴘𐴁𐴝. 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴥𐴀𐴏𐴢 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴠 𐴒𐴟𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴥𐴘 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴃𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌!<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴀𐴛 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴁𐴡𐴥𐴓𐴞 𐴁𐴟𐴎𐴡𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴃𐴝𐴔 𐴁𐴡𐴥𐴓𐴞 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴡𐴤. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴡𐴕𐴡𐴤 𐴓𐴟𐴏𐴧𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴘𐴝𐴥 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴓𐴠𐴑𐴞𐴥 𐴌𐴝𐴑𐴞𐴥𐴘𐴡. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴠 𐴓𐴠𐴑𐴞𐴥 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴣𐴎𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴟𐴔. 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴎𐴝𐴕 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴕𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴠𐴤. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘, 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴑𐴞, 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴊𐴞𐴓𐴡𐴌𐴠 𐴉𐴡𐴄𐴉𐴡𐴙𐴄𐴧𐴝 𐴒𐴡𐴌𐴡𐴤. <verse eid="PHM 1:20" /><verse number="21" style="v" sid="PHM 1:21" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌𐴞𐴌𐴠 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴌𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴀𐴕 𐴓𐴠𐴑𐴞𐴥𐴌 𐴊𐴠; 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴎𐴞𐴀𐴕 𐴈𐴡𐴀𐴙𐴌 𐴃𐴟𐴀𐴛 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.<verse eid="PHM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22" />𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴈𐴡𐴃𐴝𐴤, 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴟𐴏𐴝𐴥𐴉𐴠𐴌-𐴈𐴝𐴥𐴕𐴝 𐴘𐴡𐴥 𐴁𐴡𐴕𐴊𐴟𐴁𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴐𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴟𐴖𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.<verse eid="PHM 1:22" /></para>
  <para style="s1">𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠𐴂𐴝𐴉𐴝𐴌𐴝𐴏𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴔𐴝𐴌𐴑𐴟𐴏𐴢, 𐴀𐴝𐴌𐴞𐴏𐴃𐴝𐴌𐴑𐴟𐴏𐴢, 𐴊𐴠𐴥𐴔𐴝𐴏𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴓𐴟𐴑𐴝𐴥𐴏𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴌𐴟𐴀𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>