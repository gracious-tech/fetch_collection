<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">2-𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 2 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc2">2 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc3">2𐴑𐴡𐴥𐴌</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">2 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="ip">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 2 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢-𐴉𐴝𐴣𐴏𐴡𐴃𐴧𐴟 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢-𐴏𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 <char style="ior">(<ref loc="2CO 1:1">1‏:1</ref>)</char>. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴑𐴡𐴥𐴌𐴞𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴎𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴈𐴠𐴥𐴕𐴃𐴟 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴒𐴝𐴥𐴕. 𐴀𐴟𐴓𐴠𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴈𐴡𐴌𐴝 𐴐𐴠𐴣𐴍𐴞𐴥 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢. 𐴓𐴠𐴑𐴞𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 <char style="ior">(<ref loc="2CO 2:3-4">2‏:3‏-4</ref>)</char> 𐴀𐴡𐴃𐴢 𐴎𐴠 𐴐𐴠𐴣𐴍𐴞𐴥𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴡𐴉𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴝𐴥𐴘. 𐴁𐴠𐴦𐴐𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 2 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 <char style="ior">(<ref loc="2CO 2:13">2‏:13</ref>)</char>.</para>
  <para style="ip">𐴀𐴠 2 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴓𐴡𐴑 𐴏𐴞𐴥𐴘𐴝𐴌𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴞𐴁𐴝𐴤𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴅𐴡𐴏𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴑𐴡𐴥𐴌𐴞𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴞𐴃𐴟𐴏𐴡𐴃𐴧𐴟 𐴎𐴠 𐴁𐴝𐴥𐴓𐴝 𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠. 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝𐴃𐴢 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴕𐴡𐴎𐴡𐴌𐴞𐴘𐴝 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴉𐴏𐴞𐴓𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴌𐴟𐴑𐴟𐴥 <char style="ior">(<ref loc="2CO 8-9">8‏—9</ref>)</char> 𐴀𐴡𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴏𐴝𐴣𐴊𐴝 𐴃𐴟𐴓𐴞𐴤𐴁𐴝𐴌 𐴔𐴡𐴐𐴖𐴝𐴌𐴝 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠 𐴓𐴡𐴦𐴃𐴉𐴝 𐴎𐴝. 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠, 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴁𐴝𐴀𐴌𐴡𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴞𐴏𐴝𐴥 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴊𐴟𐴐𐴧𐴡𐴕𐴞 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴕𐴞𐴎𐴠 𐴁𐴝𐴌𐴞𐴥𐴑 𐴑𐴟𐴥𐴖𐴝𐴓𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴒𐴞𐴌𐴞𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴡𐴥𐴑-𐴐𐴟𐴁𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴔𐴡𐴅𐴁𐴟𐴌 𐴀𐴡𐴥𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴎𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴌𐴝𐴕𐴃𐴞𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴝 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴝 <char style="ior">(<ref loc="2CO 1:1-7">1‏:1‏-7</ref>)</char></para>
  <para style="io1">2. 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴌 𐴀𐴠𐴌𐴝𐴊𐴝 𐴁𐴡𐴊𐴡𐴓𐴝𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴝𐴀𐴙𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴒𐴡𐴌 𐴐𐴠𐴣𐴍𐴞𐴥𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 <char style="ior">(<ref loc="2CO 1:8-7:16">1‏:8‏—7‏:16</ref>)</char></para>
  <para style="io1">3. 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴏𐴝𐴣𐴊𐴝 𐴃𐴟𐴓𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴔𐴡𐴐𐴖𐴝𐴌𐴝 <char style="ior">(<ref loc="2CO 8-9">8‏—9</ref>)</char></para>
  <para style="io1">4. 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴒𐴞𐴌𐴞𐴌 𐴏𐴡𐴥𐴉𐴝𐴘, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴌𐴀𐴠𐴑𐴁𐴝𐴌 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴟𐴃𐴝𐴓𐴠𐴑 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 <char style="ior">(<ref loc="2CO 10:1-13:10">10‏:1‏—13‏:10</ref>)</char></para>
  <para style="io1">5. 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴏𐴡𐴥𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝 𐴊𐴞𐴘𐴝 <char style="ior">(<ref loc="2CO 13:11-14">13‏:11‏-14</ref>)</char></para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴏𐴝𐴥𐴇𐴝𐴁𐴞. 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴥𐴘 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤.</para>
  <para style="p" vid="2CO 1:1">𐴑𐴡𐴥𐴌𐴞𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴑𐴝𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌.<verse eid="2CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="2CO 1:2" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴐𐴟𐴥𐴑𐴟𐴌𐴝𐴕𐴝</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴉𐴡𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑, 𐴎𐴞𐴁𐴝𐴤 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴌 𐴁𐴝𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞𐴌 𐴀𐴝𐴓𐴧𐴝. <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴥𐴀𐴌 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴓𐴡𐴥𐴘 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴞𐴥 𐴉𐴝𐴌𐴞 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴑 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴞𐴐𐴞𐴤, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴘𐴡𐴥 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴁𐴞𐴐𐴞𐴤. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴉𐴡𐴌𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴕𐴠𐴅𐴝𐴃𐴡𐴓𐴧𐴝 𐴉𐴡𐴌𐴞 𐴊𐴠. 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴉𐴝𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞𐴓𐴧𐴝 𐴉𐴝𐴘 𐴊𐴠, 𐴎𐴞𐴀𐴕𐴠 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴟𐴑 𐴀𐴟𐴀𐴙𐴕 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴎𐴞𐴀𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴌. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴔𐴡𐴎𐴁𐴟𐴃𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴝𐴏𐴡𐴤, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞𐴃𐴢 𐴀𐴡𐴥 𐴀𐴝𐴏𐴡𐴤.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢,<note caller="+" style="f"><char style="fr" closed="false">1‏:8 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴟𐴕𐴞𐴥 𐴒𐴟𐴥𐴕 𐴒𐴡𐴥𐴓𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴃𐴎𐴞𐴥𐴘𐴝𐴙𐴕; 𐴓𐴡𐴉𐴎𐴡𐴥 𐴘𐴞𐴥𐴁𐴝 𐴀𐴝𐴘𐴝𐴃𐴢 𐴀𐴞𐴀𐴕𐴡𐴃𐴢 𐴀𐴡𐴥 𐴓𐴡𐴦𐴃𐴉𐴝 𐴎𐴝: 8:1; 13:11.</char></note> 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴏𐴝𐴀𐴘𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴐𐴞𐴥𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴡𐴎𐴝𐴕𐴝 𐴃𐴝𐴥𐴑𐴡. 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴃𐴧𐴡𐴥𐴌 𐴋𐴡𐴣𐴀𐴌 𐴏𐴝𐴁𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴎𐴞𐴘𐴝𐴥𐴕 𐴁𐴡𐴌𐴊𐴝𐴐𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴠 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴓𐴝𐴔. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴄𐴝𐴥𐴀𐴙𐴅𐴧𐴞𐴓𐴝𐴔 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴔𐴡𐴦𐴃𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴌𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴡𐴌𐴝𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴌𐴝𐴑𐴞𐴥. <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴠𐴥𐴃𐴧𐴡𐴌 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴦𐴃𐴞 𐴊𐴡𐴐𐴝𐴤𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴏𐴝𐴘𐴁𐴡𐴥 𐴘𐴡𐴥. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴠 𐴀𐴝𐴐𐴝𐴤 𐴌𐴝𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴝𐴏𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡. <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴟𐴖𐴝 𐴓𐴡𐴘 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴀𐴝𐴊𐴝𐴘 𐴀𐴡𐴥.<verse eid="2CO 1:11" /></para>
  <para style="s1">𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴠𐴌𐴝𐴊𐴝 𐴁𐴡𐴊𐴡𐴓𐴝</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴌𐴝𐴥𐴘 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴝𐴀𐴕 𐴎𐴞𐴘𐴝𐴥𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴠𐴥𐴓𐴡𐴔𐴠 𐴘𐴡𐴥 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴂𐴝𐴑𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞𐴌 𐴀𐴠𐴈𐴠𐴥𐴓𐴝𐴏𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴧𐴞𐴥, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕 𐴀𐴡𐴃𐴢. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴇𐴡𐴥𐴕𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴒𐴞𐴘𐴝𐴕𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴉𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴡 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴌𐴡, 𐴘𐴝𐴥𐴌 𐴁𐴝𐴀𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴓𐴠𐴑𐴞𐴥𐴌. 𐴀𐴝𐴀𐴛 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴁𐴟𐴎𐴞𐴥𐴁𐴝, <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />𐴎𐴡𐴊𐴞 𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴕𐴡 𐴁𐴟𐴎𐴞𐴥𐴓𐴠 𐴘𐴡. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴟𐴎𐴞𐴥𐴓𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴊𐴞𐴕𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴡𐴥𐴘𐴧𐴟𐴔 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴡𐴌𐴝𐴥𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴌𐴝𐴥𐴘 𐴀𐴡𐴥𐴘𐴁𐴝.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴠𐴑𐴞𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠𐴌𐴝𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴝𐴒𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴘 𐴒𐴟𐴕 𐴀𐴝𐴘𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴉𐴡𐴦; <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />𐴘𐴝𐴥𐴕𐴞, 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴎𐴝𐴘𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴒𐴡𐴥𐴓𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴦𐴌 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴃𐴧𐴟 𐴀𐴝𐴘𐴃𐴠𐴤 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴒𐴡𐴥𐴓𐴞 𐴁𐴡𐴓𐴧𐴝, 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴌 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴌𐴡𐴖𐴝𐴕𐴝 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴁𐴝. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴌𐴝𐴊𐴝 𐴒𐴡𐴌𐴡𐴤𐴕𐴠 𐴑𐴞𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡𐴦𐴣𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴌 𐴁𐴡𐴓𐴞 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥؟ 𐴀𐴝𐴀𐴛 𐴑𐴞𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴉𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠𐴑𐴁𐴝𐴌 𐴀𐴡𐴥𐴘 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀 𐴀𐴝𐴌𐴀𐴠𐴑𐴁𐴝𐴌 𐴕𐴡 𐴕𐴡 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀؟<verse eid="2CO 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 1:18" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌, 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴑𐴁𐴝𐴌 ”𐴀𐴡𐴥𐴘“ 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌𐴀𐴠𐴑𐴁𐴝𐴌 ”𐴕𐴡“ 𐴓𐴡𐴥𐴘 𐴕𐴡. <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴀𐴛, 𐴏𐴞𐴥𐴓𐴖𐴝𐴕𐴟𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴡 ”𐴀𐴡𐴥𐴘“ 𐴀𐴠𐴊𐴧𐴠 ”𐴕𐴡“ 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 ”𐴀𐴡𐴥𐴘“ 𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴡𐴥𐴘. <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴖𐴝𐴦𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 ”𐴀𐴡𐴥𐴘.“ 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 ”𐴀𐴝𐴦𐴔𐴞𐴕“ 𐴈𐴡𐴀𐴘𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥. <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝. <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴀𐴌 𐴓𐴝𐴒𐴝𐴘𐴊𐴞𐴘𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴦𐴕𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴊𐴞𐴦𐴘𐴠𐴥.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴒𐴡𐴁𐴝𐴤 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴀𐴛 𐴑𐴡𐴥𐴌𐴞𐴕𐴡𐴃𐴢 𐴀𐴝𐴁𐴝𐴌 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴞𐴤 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴝𐴏𐴝𐴘 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴏𐴡𐴓𐴝𐴙𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴟𐴥𐴐𐴞𐴓𐴧𐴝 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴞𐴔𐴝𐴕𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴡𐴤.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴀𐴛 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴊𐴟𐴑 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴌 𐴕𐴟 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴊𐴟𐴑 𐴊𐴞, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴊𐴟𐴑 𐴊𐴞𐴘𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴝𐴌 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟ <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴘𐴓𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴓𐴡𐴃𐴢 𐴊𐴟𐴑 𐴕𐴡 𐴊𐴠; 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴘𐴝𐴀𐴕 𐴀𐴠𐴑𐴞𐴕 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌 𐴑𐴟𐴥𐴐𐴞, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴀𐴡𐴥 𐴑𐴟𐴥𐴐𐴞. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴊𐴞𐴓𐴡𐴌 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴘𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴏𐴟𐴑𐴡𐴌 𐴉𐴝𐴕𐴞𐴥 𐴁𐴝𐴥𐴐𐴝𐴘-𐴁𐴝𐴥𐴐𐴝𐴘; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴊𐴟𐴑 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴎𐴠 𐴈𐴝𐴥𐴀𐴏𐴢 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴡.<verse eid="2CO 2:4" /></para>
  <para style="s1">𐴊𐴞𐴓𐴡𐴃𐴢 𐴊𐴟𐴑𐴊𐴡𐴘𐴝𐴓𐴧𐴝 𐴔𐴝𐴉𐴢</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴊𐴞𐴓𐴡𐴃𐴢 𐴊𐴟𐴑 𐴊𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴞𐴥𐴃𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴣𐴀𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴊𐴟𐴑 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠—𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴕𐴡 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴈𐴡𐴘𐴓𐴠𐴥—𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴝𐴥𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴊𐴞𐴘𐴠𐴥. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴕𐴠 𐴎𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴞𐴥𐴘𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴝 𐴑𐴝𐴉𐴞𐴥. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />𐴘𐴝𐴥𐴌𐴁𐴡𐴊𐴡𐴓𐴢 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴞𐴥𐴘𐴝𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴠 𐴁𐴞𐴐𐴞𐴤 𐴊𐴟𐴑𐴧𐴠𐴥 𐴇𐴡𐴥𐴣𐴍𐴞 𐴕𐴡 𐴎𐴝𐴒𐴡𐴥𐴘. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴝𐴈𐴡𐴥. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴘𐴡𐴥 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴝𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴀𐴝𐴏𐴡𐴤 𐴕𐴠𐴥 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴏𐴝𐴀𐴘𐴢 𐴉𐴝𐴌𐴞. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴌𐴠𐴥 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴡, 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴝𐴀𐴛 𐴎𐴞𐴀𐴕 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴞, 𐴎𐴡𐴊𐴞 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴁𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴔𐴝𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠; <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />𐴎𐴠𐴀𐴕𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴉𐴝𐴥𐴘𐴊𐴝𐴘 𐴃𐴟𐴓𐴞𐴤 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌 𐴏𐴝𐴙𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴡𐴎𐴝𐴕𐴝 𐴕𐴡.<verse eid="2CO 2:11" /></para>
  <para style="s1">𐴃𐴡𐴌𐴝𐴏𐴡𐴃𐴢 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴡𐴐𐴝𐴥𐴕𐴃𐴞</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴃𐴡𐴌𐴝𐴏𐴡𐴃𐴢 𐴒𐴞𐴀𐴓𐴝𐴔, 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴟𐴖𐴝𐴌 𐴑𐴟𐴥𐴙𐴓𐴧𐴞𐴓𐴢. <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />𐴃𐴡𐴀 𐴀𐴝𐴣𐴀𐴌 𐴔𐴡𐴕𐴡𐴃𐴢 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘 𐴃𐴞𐴃𐴟𐴏𐴡𐴌𐴠 𐴇𐴠𐴥𐴍𐴠 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡𐴥 𐴉𐴝𐴘. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴞𐴊𐴝𐴘 𐴓𐴡𐴘 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴒𐴞𐴀𐴓𐴝𐴔𐴁𐴡𐴘.<verse eid="2CO 2:13" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴎𐴞𐴃𐴝</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴀𐴡𐴥𐴑, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴎𐴞𐴃𐴝𐴘 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴓𐴡𐴘𐴎𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴇𐴝𐴥𐴀𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴑𐴟𐴥𐴐𐴁𐴡 𐴉𐴡𐴥𐴓𐴝 𐴉𐴝𐴥𐴕 𐴉𐴡𐴥𐴓𐴝. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴡𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴓𐴝𐴑 𐴀𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴥𐴐𐴁𐴡. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />𐴀𐴠𐴑 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴦𐴃𐴢 𐴀𐴝𐴕𐴠𐴤 𐴊𐴠 𐴑𐴟𐴥𐴐𐴁𐴡, 𐴀𐴝𐴌𐴀𐴠𐴑 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴝𐴕𐴠𐴤 𐴊𐴠 𐴑𐴟𐴥𐴐𐴁𐴡. 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴈𐴝𐴔 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴇𐴡𐴕؟ <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴓𐴡𐴘 𐴐𐴡𐴥𐴊𐴡𐴌𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡; 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴀𐴠𐴈𐴠𐴥𐴓𐴝𐴏𐴠 𐴈𐴡𐴀𐴘𐴢.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s1">𐴕𐴡𐴘𐴝 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴑𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴁𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴕𐴝𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴞 𐴊𐴠𐴥؟ 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴐𐴟𐴥𐴖𐴝𐴌𐴞𐴐𐴕𐴝𐴔𐴝𐴌 𐴐𐴠𐴣𐴍𐴞𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴁𐴝𐴌 𐴘𐴝𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴓𐴡𐴘𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠𐴥؟ <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴐𐴠𐴣𐴍𐴞𐴥 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴎𐴝𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴌𐴠𐴤. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />𐴘𐴝𐴀𐴕 𐴏𐴝𐴥𐴉𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴐𐴠𐴣𐴍𐴞𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴐𐴞𐴥𐴘𐴝𐴘 𐴓𐴡𐴥𐴘 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀 𐴓𐴡𐴥𐴘, 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴉𐴝𐴄𐴡𐴃𐴢 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴉𐴝𐴄𐴢 𐴀𐴡𐴃𐴢, 𐴘𐴝𐴥𐴕𐴞 𐴊𐴞𐴓𐴢 𐴀𐴡𐴃𐴢.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴑𐴞𐴕 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴠𐴥𐴀𐴕 𐴕𐴡, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴠𐴁𐴝𐴎𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴈𐴡𐴀𐴘𐴢 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴟𐴔; 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟, <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴡𐴘𐴝 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴓𐴠𐴑𐴝𐴥𐴌 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴌𐴟𐴀𐴌. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴓𐴠𐴑𐴝𐴥𐴘𐴠 𐴀𐴝𐴕𐴠𐴤 𐴊𐴠 𐴔𐴡𐴦𐴃𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴌𐴟𐴀𐴘𐴠 𐴊𐴠𐴦 𐴊𐴠 𐴎𐴞𐴁𐴡𐴕.<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />𐴔𐴡𐴦𐴃𐴢 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴊𐴠 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴇𐴡𐴥𐴌𐴡𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴃𐴢 𐴑𐴟𐴥𐴣𐴊𐴞𐴘𐴡𐴌𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴊𐴝𐴌𐴞 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴠𐴀𐴕 𐴃𐴡𐴎𐴡𐴓𐴧𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴟𐴀𐴏𐴝𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝𐴌 𐴀𐴟𐴎𐴟 𐴓𐴝𐴒𐴝𐴃𐴝𐴌 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴑𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝𐴃𐴢 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴏𐴃𐴠𐴤-𐴀𐴝𐴏𐴃𐴠𐴤 𐴈𐴡𐴔𐴞 𐴎𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />𐴃𐴡𐴥𐴘 𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴊𐴝𐴌𐴞 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴃𐴡𐴥 𐴃𐴡𐴎𐴡𐴓𐴧𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴡𐴥𐴘𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌! <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴝 𐴊𐴠 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴊𐴝𐴌𐴞𐴃𐴢 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴝 𐴊𐴠 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴊𐴝𐴌𐴞𐴃𐴢 𐴃𐴡 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴃𐴝𐴥𐴑𐴞𐴁𐴡. <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴇𐴠𐴥 𐴏𐴟𐴥𐴌𐴡𐴃𐴠 𐴃𐴡 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴀𐴡𐴓𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴋𐴡𐴣𐴀𐴌 𐴃𐴡𐴎𐴡𐴓𐴧𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴕𐴝𐴥𐴘 𐴉𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴇𐴡𐴥𐴃𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴀𐴡𐴓𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴐𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴡𐴌𐴞𐴥. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴟𐴀𐴏𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴡𐴌𐴡𐴊𐴝 𐴊𐴞𐴃𐴡 𐴊𐴠 𐴎𐴠𐴀𐴕𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴇𐴡𐴥𐴃𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴌𐴒𐴡𐴘 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴟𐴥𐴌𐴝𐴕𐴃𐴞𐴌𐴠 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴊𐴠𐴑𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴊𐴡𐴌𐴡𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴟𐴌𐴝𐴕𐴝 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴌𐴠 𐴃𐴠𐴓𐴝𐴖𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴕𐴠 𐴀𐴝𐴙𐴅 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴇𐴠𐴥 𐴉𐴡𐴌𐴡𐴊𐴝 𐴃𐴝𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴠𐴥𐴕𐴝 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴎𐴝. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />𐴀𐴝𐴙𐴅 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴎𐴠𐴣𐴃𐴧𐴠𐴥-𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴟𐴀𐴏𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴃𐴠𐴓𐴝𐴖𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴌𐴠 𐴉𐴡𐴌𐴡𐴊𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴠 𐴒𐴟𐴥𐴌𐴞 𐴌𐴝𐴑𐴠𐴥. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴀𐴟𐴎𐴟 𐴉𐴞𐴥𐴌𐴠, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴇𐴠𐴥 𐴉𐴡𐴌𐴡𐴊𐴝 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴎𐴝. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />𐴇𐴠𐴥 𐴔𐴝𐴓𐴞𐴑 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴌𐴟𐴀; 𐴎𐴠𐴍𐴠𐴥 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴌𐴟𐴀 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴎𐴝𐴊𐴞 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴁𐴠𐴉𐴡𐴌𐴡𐴊𐴝 𐴏𐴞𐴘𐴝𐴥𐴌𐴝 𐴓𐴡𐴥𐴘 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴃𐴡𐴎𐴡𐴓𐴧𐴞𐴌𐴠 𐴀𐴝𐴘𐴕𐴝𐴃𐴢 𐴊𐴠𐴑𐴞𐴥𐴌 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴊𐴠𐴑𐴞𐴥𐴌, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴠𐴥 𐴔𐴝𐴓𐴞𐴑 𐴎𐴞𐴁𐴝𐴤 𐴌𐴟𐴀 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴎𐴠𐴃𐴡𐴥 𐴀𐴠𐴥𐴃𐴡 𐴃𐴡𐴎𐴡𐴓𐴧𐴞𐴖𐴝𐴓𐴝 𐴁𐴡𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴡𐴃𐴢 𐴁𐴡𐴊𐴡𐴓𐴞𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s1">𐴔𐴠𐴙𐴄𐴧𐴝 𐴉𐴝𐴃𐴞𐴓𐴝𐴃𐴢 𐴊𐴡𐴥𐴕</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴠𐴀𐴕 𐴌𐴝𐴇𐴝𐴥𐴔 𐴀𐴡𐴥𐴘𐴧𐴠 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴊𐴝𐴌𐴞 𐴉𐴝𐴘𐴧𐴞𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴕𐴝 𐴇𐴝𐴥𐴌𐴝𐴘. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴐𐴡𐴥𐴌𐴔𐴡𐴌 𐴈𐴝𐴔 𐴎𐴞𐴀𐴕 𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴞; 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴉𐴠𐴥𐴌𐴡𐴑𐴁𐴝𐴎𐴞 𐴒𐴡𐴌𐴞𐴥 𐴏𐴡𐴓𐴞 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴞𐴒𐴞𐴍𐴞𐴉𐴠𐴥𐴓𐴝𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴉𐴡𐴃𐴧𐴞𐴥 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴠𐴥𐴓𐴡𐴔𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴐𐴟𐴥𐴕𐴝𐴔 𐴎𐴟𐴌𐴝𐴘. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴡𐴌𐴡𐴊𐴝 𐴊𐴞𐴘𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴡𐴌𐴡𐴊𐴝 𐴊𐴞𐴘𐴝 𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴎𐴝𐴌𐴒𐴡𐴘. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />𐴇𐴠𐴥 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴠𐴈𐴠𐴥𐴕𐴡𐴌𐴠 𐴀𐴠 𐴅𐴝𐴥𐴈𐴝𐴕𐴡𐴌 𐴑𐴟𐴥𐴊𐴝𐴘𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴁𐴝𐴕𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴕𐴟𐴌 𐴊𐴠𐴑𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴎𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴥𐴕𐴝 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥; 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴟𐴓𐴝𐴔. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴧𐴟 𐴉𐴡𐴀𐴌 𐴎𐴡𐴓𐴡𐴗𐴑,“<note caller="+" style="f"><char style="fr" closed="false">4‏:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 1:3">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 1‏:3</ref></char></char></note> 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴏𐴡𐴙𐴔𐴑𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴡 𐴃𐴡𐴎𐴡𐴓𐴧𐴞𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴎𐴠 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝𐴃𐴢 𐴏𐴡𐴔𐴑𐴠.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴇𐴠𐴥 𐴊𐴡𐴥𐴕 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴠𐴙𐴄𐴧𐴝 𐴉𐴝𐴃𐴞𐴓𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴉𐴝𐴥𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴏𐴝𐴁𐴢 𐴉𐴡𐴌𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴥𐴣𐴍𐴞 𐴕𐴡 𐴎𐴝𐴘𐴒𐴡𐴥𐴘; 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴟𐴊𐴧𐴞𐴥 𐴇𐴝𐴥𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴐𐴝𐴤 𐴇𐴝𐴥𐴌𐴝𐴘 𐴕𐴡 𐴀𐴡𐴥𐴘; <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴟𐴓𐴟𐴥𐴔 𐴇𐴝𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴠𐴍𐴞𐴃𐴢 𐴀𐴝𐴣𐴏𐴝𐴥𐴌𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴝𐴘𐴒𐴡𐴥𐴘. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴃𐴧𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴡𐴦𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴓𐴡𐴘𐴎𐴝𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴘𐴡𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴝𐴏𐴞 𐴀𐴝𐴏𐴞𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴃𐴡 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴔𐴡𐴦𐴃𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴘𐴝 𐴎𐴝𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴘𐴡𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />𐴇𐴠𐴥 𐴏𐴟𐴥𐴌𐴡𐴃𐴡𐴌 𐴖𐴡𐴌𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴦𐴃𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴘𐴠.<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴀𐴝𐴀𐴛 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠𐴥.“<note caller="+" style="f"><char style="fr" closed="false">4‏:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 116:10">𐴎𐴡𐴁𐴟𐴌 116‏:10</ref></char></char></note> 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴇𐴠𐴥 𐴀𐴠𐴑𐴞𐴤 𐴌𐴟𐴀 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴊𐴠. <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴇𐴝𐴥𐴎𐴞𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴠𐴥𐴕𐴝 𐴀𐴡𐴥𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴁𐴞𐴐𐴞𐴤-𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴡𐴥𐴓𐴠𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴀𐴝𐴊𐴝𐴘 𐴀𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴥.<verse eid="2CO 4:15" /></para>
  <para style="s1">𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴕𐴝 𐴇𐴝𐴥𐴌𐴝𐴘. 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴀𐴌𐴡𐴌 𐴇𐴝𐴘𐴧𐴝 𐴕𐴝𐴐𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴌𐴒𐴡𐴘 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞 𐴊𐴞𐴕𐴁𐴡𐴊𐴞𐴕 𐴕𐴡𐴘𐴝 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴠 𐴇𐴡𐴦𐴊𐴧𐴞𐴕𐴧𐴝 𐴐𐴡𐴥𐴣𐴍𐴡 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴀𐴠𐴃𐴧𐴡𐴥𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴡𐴥𐴘 𐴔𐴝𐴉𐴝 𐴕𐴡 𐴎𐴝. <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴝 𐴎𐴝 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴝 𐴕𐴡 𐴎𐴝 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴁𐴠 𐴕𐴡𐴎𐴡𐴌 𐴊𐴞; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴝 𐴎𐴝 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴃𐴡𐴦𐴙𐴃𐴧𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴝 𐴕𐴡 𐴎𐴝 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴞, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴝𐴥𐴑𐴞 𐴊𐴠 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴄𐴝𐴔𐴁𐴟, 𐴘𐴝𐴥𐴕𐴞 𐴇𐴝𐴘𐴧𐴝 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴞𐴓𐴧𐴞𐴥𐴚 𐴒𐴡𐴥𐴌 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴥𐴃𐴡𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴞. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴠 𐴄𐴝𐴔𐴁𐴟𐴃𐴢 𐴃𐴝𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴋𐴡𐴣𐴀𐴌 𐴕𐴞𐴘𐴝𐴥𐴐𐴢 𐴉𐴠𐴥𐴓𐴝𐴘-𐴉𐴠𐴥𐴓𐴝𐴘 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴒𐴡𐴥𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴇𐴡𐴦𐴌 𐴉𐴞𐴣𐴊𐴠𐴤 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴉𐴞𐴣𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴞𐴥𐴌, <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴉𐴞𐴣𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴟𐴔, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴞𐴘𐴡𐴏𐴧𐴡𐴌 𐴉𐴝𐴦 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠 𐴄𐴝𐴔𐴁𐴟𐴃𐴢 𐴀𐴝𐴏𐴞𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴟𐴣𐴎𐴝𐴤𐴌 𐴁𐴡𐴥𐴌𐴠 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴕𐴞𐴘𐴝𐴥𐴐𐴢 𐴉𐴠𐴥𐴓𐴝𐴙𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴉𐴞𐴕𐴊𐴝𐴤 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴞𐴕𐴊𐴝𐴤 𐴀𐴡𐴥𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴘𐴠 𐴒𐴞𐴓𐴞𐴉𐴠𐴥𐴓𐴠. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴠𐴥 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴡𐴦𐴕𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴌𐴟𐴀 𐴊𐴞𐴦𐴘𐴠𐴥.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴀𐴝𐴦𐴌 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴇𐴝𐴘𐴧𐴝 𐴓𐴡𐴘 𐴀𐴝𐴏𐴞𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴇𐴝𐴥𐴎𐴞𐴌 𐴕𐴝𐴥𐴘; <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠, 𐴏𐴟𐴑𐴠𐴤 𐴊𐴠𐴑𐴞𐴥 𐴕𐴡. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />𐴀𐴡𐴥𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠 𐴇𐴝𐴘𐴧𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴖𐴝 𐴀𐴝𐴌𐴡𐴤 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴌𐴞𐴥. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠 𐴇𐴝𐴘𐴧𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴞𐴤 𐴘𐴝𐴥 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴡𐴕𐴎𐴞𐴓𐴢-𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤𐴕. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴝𐴊𐴝𐴓𐴡𐴃𐴞 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴇𐴝𐴥𐴎𐴞𐴌 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴥𐴁𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴝𐴘𐴧𐴝 𐴓𐴡𐴘 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴎𐴠𐴦 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴇𐴠𐴥 𐴔𐴡𐴎𐴞𐴕 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴁𐴡𐴊𐴡𐴓𐴝 𐴉𐴝𐴘, 𐴈𐴝𐴔 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴔 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴈𐴡𐴥𐴌𐴝𐴉𐴢.<verse eid="2CO 5:10" /></para>
  <para style="s1">𐴁𐴡𐴕𐴡𐴃𐴡𐴌 𐴈𐴝𐴔</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴋𐴡𐴦𐴌 𐴑𐴞𐴦 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴡𐴍𐴝𐴘 𐴀𐴝𐴕𐴞𐴤𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥. 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴏𐴞𐴕𐴠𐴥; 𐴀𐴝𐴀𐴛 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴓𐴡𐴔𐴠 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴏𐴞𐴕𐴠𐴥. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴝𐴔 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴡𐴦𐴗𐴑𐴝 𐴊𐴞𐴦𐴌 𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴎𐴟𐴖𐴝𐴁𐴢 𐴃𐴝𐴥𐴑𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴞𐴓𐴡𐴌 𐴒𐴟𐴥𐴕 𐴓𐴡𐴥𐴘 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴝 𐴎𐴝 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴠𐴥. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴑𐴟𐴉𐴢 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴠𐴥𐴕𐴝; 𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴠𐴔𐴝𐴑 𐴄𐴞𐴥𐴑 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴠𐴥𐴕𐴝. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴔𐴡𐴅𐴁𐴟𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴟𐴙𐴅𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴠𐴑𐴎𐴡𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴔𐴡𐴙𐴅𐴧𐴠𐴥 𐴌𐴝𐴥𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />𐴀𐴞𐴥𐴁𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴔𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴝𐴏𐴞 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴁𐴝𐴏𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴟𐴁𐴝𐴤 𐴓𐴧𐴝 𐴃𐴝𐴥𐴑𐴠 𐴎𐴞𐴁𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴔𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴀𐴝𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴠𐴇𐴡𐴥𐴕𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴁𐴟𐴎𐴝𐴥 𐴓𐴡𐴥𐴘 𐴕𐴡 𐴁𐴟𐴙𐴅𐴧𐴟𐴥𐴔. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴁𐴟𐴎𐴝𐴥 𐴓𐴡𐴥𐴘 𐴁𐴟𐴎𐴞𐴥𐴃𐴝𐴔 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴕𐴡 𐴁𐴟𐴎𐴞𐴥. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴕𐴡𐴘𐴝 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴉𐴟𐴌𐴝𐴕𐴝 𐴒𐴟𐴥𐴕 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴘𐴝 𐴀𐴡𐴥𐴘𐴀𐴝𐴙𐴐𐴧𐴠. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴁𐴠 𐴀𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴓𐴡𐴘 𐴁𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴠𐴥 𐴁𐴡𐴕𐴡𐴃𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴊𐴝𐴌𐴞 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴝𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴡𐴥𐴘 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴓𐴡𐴘 𐴁𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠; 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤-𐴇𐴝𐴥𐴃𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴕𐴡𐴥 𐴊𐴡𐴥𐴌𐴠. 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴠𐴥 𐴁𐴡𐴕𐴡𐴃𐴡𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴎𐴝𐴕𐴝𐴘𐴁𐴝𐴥𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠. <verse eid="2CO 5:19" /><verse number="20" style="v" sid="2CO 5:20" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴡𐴔𐴝𐴙𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴠𐴥𐴌. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴡𐴥𐴘𐴧𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝 𐴓𐴧𐴡𐴘 𐴁𐴡𐴕𐴞𐴎𐴡𐴒𐴡𐴥𐴘. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴀𐴟𐴁𐴝𐴤𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴒𐴝𐴌𐴝𐴘𐴧𐴠 𐴎𐴞𐴁𐴝𐴤 𐴁𐴠𐴒𐴟𐴕𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴒𐴡𐴘.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴁𐴠𐴉𐴡𐴥𐴎𐴟𐴓𐴢 𐴀𐴡𐴥𐴘𐴃𐴡 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴡𐴥𐴌𐴔𐴝𐴌 𐴊𐴠,</para>
  <para style="q1" vid="2CO 6:2">”𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴙𐴕𐴧𐴞,</para>
  <para style="q2" vid="2CO 6:2">𐴀𐴝𐴦𐴌 𐴕𐴠𐴅𐴝𐴃𐴡𐴌 𐴊𐴞𐴕𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥.“<note caller="+" style="f"><char style="fr" closed="false">6‏:2 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 49:8">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 49‏:8</ref></char></char></note></para>
  <para style="m" vid="2CO 6:2">𐴉𐴟𐴥𐴕𐴡, 𐴘𐴝𐴓𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥, 𐴀𐴝𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴠𐴅𐴝𐴃𐴡𐴌 𐴊𐴞𐴕.<verse eid="2CO 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴄𐴡𐴑𐴧𐴡𐴌 𐴕𐴝 𐴈𐴝𐴥𐴁𐴝𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴊𐴝𐴌𐴞𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴕𐴡. <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥, 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴁𐴞𐴐𐴞𐴤 𐴏𐴡𐴁𐴡𐴥𐴌 𐴀𐴡𐴃𐴢, 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴡𐴃𐴢, 𐴔𐴡𐴐𐴑𐴞𐴓𐴢 𐴀𐴡𐴃𐴢, 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢, <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />𐴉𐴞𐴍𐴝 𐴇𐴝𐴥𐴃𐴢, 𐴎𐴞𐴘𐴡𐴥𐴓𐴢 𐴈𐴝𐴍𐴝𐴃𐴢, 𐴇𐴝𐴥𐴚𐴒𐴝𐴔𐴝𐴃𐴢, 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴀𐴡𐴃𐴢, 𐴀𐴟𐴌𐴒𐴟𐴥𐴔𐴝𐴃𐴢, 𐴖𐴝𐴀𐴐𐴧𐴝𐴃𐴢, <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴃𐴢, 𐴒𐴞𐴘𐴝𐴕 𐴀𐴡𐴃𐴢, 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴀𐴡𐴃𐴢, 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞𐴃𐴢, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴃𐴢, 𐴇𐴝𐴥𐴄𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴡𐴃𐴢, <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />𐴏𐴡𐴥𐴘𐴧𐴞 𐴑𐴝𐴓𐴝𐴔 𐴓𐴡𐴘, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴓𐴡𐴘, 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴕 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴀𐴝𐴥𐴃𐴞𐴘𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘, <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴖𐴝 𐴓𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴉𐴝𐴦 𐴓𐴡𐴘. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴢 𐴄𐴝𐴥𐴀𐴌𐴠; <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴏𐴞𐴕𐴞𐴥𐴓𐴠 𐴘𐴡 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥 𐴉𐴝𐴥𐴕 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘 𐴉𐴝𐴥𐴕 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴕𐴊𐴝. 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞 𐴕𐴡𐴥 𐴉𐴠𐴓𐴠. <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢 𐴀𐴝𐴏𐴞𐴤 𐴉𐴝𐴥𐴕 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴑𐴟𐴥𐴐𐴞𐴃𐴢 𐴀𐴝𐴏𐴞𐴤; 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴏𐴝𐴘𐴃𐴠𐴥 𐴒𐴡𐴌𐴞𐴉𐴢, 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴁𐴝𐴕𐴝𐴙𐴌; 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘 𐴉𐴝𐴥𐴕, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴏𐴠𐴤.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />𐴀𐴡𐴥 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴀𐴠𐴁𐴧𐴠 𐴑𐴟𐴥𐴓𐴝𐴇𐴝𐴓𐴝. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴞𐴥 𐴊𐴠 𐴕𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴥𐴕𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴡𐴥. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴁𐴡𐴊𐴡𐴓𐴝𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴑𐴟𐴥𐴓𐴞𐴊𐴡.<verse eid="2CO 6:13" /></para>
  <para style="s1">𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴠𐴑 𐴎𐴟𐴣𐴖𐴝𐴓𐴡𐴃𐴢 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴓𐴡𐴥𐴘 𐴁𐴠𐴊𐴞𐴕𐴞 𐴓𐴡𐴘 𐴑𐴞𐴦 𐴁𐴝𐴎𐴝𐴥 𐴀𐴝𐴏𐴠𐴤؟ 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴓𐴡𐴥𐴘 𐴉𐴡𐴀𐴌 𐴓𐴡𐴥𐴘 𐴑𐴞𐴦 𐴇𐴝𐴥𐴃𐴞𐴓𐴢 𐴀𐴝𐴏𐴠𐴤؟ <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />𐴔𐴡𐴀𐴏𐴞𐴤𐴃𐴧𐴟 𐴁𐴠𐴓𐴞𐴀𐴝𐴓𐴢<note caller="+" style="f"><char style="fr" closed="false">6‏:15 </char><char style="ft" closed="false">𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴝𐴔</char></note> 𐴓𐴡𐴘 𐴑𐴞𐴦 𐴁𐴡𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤؟ 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴃𐴧𐴟 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴓𐴡𐴥𐴘 𐴑𐴞𐴦 𐴁𐴝𐴎𐴝𐴥 𐴀𐴝𐴏𐴠𐴤؟ <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴔𐴟𐴃𐴧𐴞𐴌 𐴑𐴞𐴦 𐴎𐴝𐴒𐴝 𐴀𐴝𐴏𐴠𐴤؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴥𐴕𐴝; 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴉𐴡𐴥𐴌𐴔𐴝𐴘𐴠, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥,</para>
  <para style="q1" vid="2CO 6:16">”𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔</para>
  <para style="q2" vid="2CO 6:16">𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔.</para>
  <para style="q1" vid="2CO 6:16">𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴟𐴔,</para>
  <para style="q2" vid="2CO 6:16">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">6‏:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 26:12">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 26‏:12</ref></char>; <char style="xt"><ref loc="JER 32:38">𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝 32‏:38</ref></char>; <char style="xt"><ref loc="EZK 37:27">𐴘𐴠𐴇𐴠𐴥𐴎𐴑𐴠𐴓𐴢 37‏:27</ref></char></char></note><verse eid="2CO 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 6:17" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴔𐴝𐴁𐴟𐴊𐴠 𐴉𐴡𐴥𐴌𐴔𐴝𐴌 𐴊𐴠,</para>
  <para style="q1" vid="2CO 6:17">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴧𐴡𐴥,</para>
  <para style="q2" vid="2CO 6:17">𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴝𐴊𐴝𐴤 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴡𐴘.</para>
  <para style="q1" vid="2CO 6:17">𐴇𐴡𐴕𐴡𐴤 𐴕𐴝𐴉𐴝𐴑 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴕𐴡 𐴊𐴡𐴥𐴙𐴅𐴧𐴡,</para>
  <para style="q2" vid="2CO 6:17">𐴃𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔.<note caller="+" style="f"><char style="fr" closed="false">6‏:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 52:11">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 52‏:11</ref></char>; <char style="xt"><ref loc="EZK 20:34">𐴘𐴠𐴇𐴠𐴥𐴎𐴑𐴠𐴓𐴢 20‏:34</ref>‏,<ref loc="EZK 20:41">41</ref></char></char></note><verse eid="2CO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴧𐴟𐴔,</para>
  <para style="q2" vid="2CO 6:18">𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴃𐴎𐴞𐴥𐴘𐴝𐴙𐴕 𐴀𐴡𐴥𐴘𐴁𐴝,</para>
  <para style="q2" vid="2CO 6:18">𐴈𐴡𐴀𐴙𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴖𐴝𐴓𐴝 𐴑𐴟𐴥𐴊𐴝 𐴘𐴠.“<note caller="+" style="f"><char style="fr" closed="false">6‏:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="2SA 7:14">2 𐴏𐴠𐴥𐴔𐴟𐴀𐴠𐴓𐴢 7‏:14</ref>; <ref loc="2SA 7:8">7‏:8</ref></char></char></note><verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴇𐴠𐴥 𐴖𐴝𐴦𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴌𐴟𐴀𐴌 𐴇𐴝𐴥𐴀𐴌 𐴕𐴝𐴉𐴝𐴑𐴞𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴋𐴡𐴦𐴌 𐴌𐴝𐴑𐴞𐴥 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴂𐴝𐴑 𐴁𐴡𐴕𐴞.<verse eid="2CO 7:1" /></para>
  <para style="s1">𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴑𐴟𐴥𐴐𐴞</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴎𐴝𐴒𐴝 𐴊𐴡𐴦. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴝𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴁𐴞𐴒𐴞𐴍𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴞, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴙𐴓𐴧𐴞𐴥. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴀𐴕 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴕𐴡. 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴠𐴀𐴕 𐴎𐴝𐴒𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴙𐴓𐴧𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴙𐴅𐴧𐴟𐴔, 𐴁𐴝𐴏𐴞𐴓𐴠𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴟𐴔. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑𐴞𐴕 𐴀𐴝𐴏𐴠𐴤; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞. 𐴀𐴝𐴀𐴛 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞𐴘𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴞; 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴑𐴠.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴝𐴦𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴐𐴟𐴥𐴑 𐴕𐴡𐴥 𐴉𐴝𐴦, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔: 𐴁𐴝𐴀𐴌𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢, 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴋𐴡𐴦𐴌. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴔𐴡𐴕 𐴐𐴡𐴥𐴣𐴍𐴡 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴞𐴃𐴟𐴏𐴡𐴌 𐴀𐴝𐴀 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴞𐴥𐴘𐴠; <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴀 𐴓𐴡𐴥𐴘 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴞𐴥𐴘𐴡 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴘𐴡𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴝𐴘𐴃𐴡𐴥 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴡𐴤𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴞 𐴒𐴡𐴌𐴡𐴤𐴌; 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴞.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴐𐴠𐴣𐴍𐴞𐴥 𐴓𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴞𐴓𐴡𐴃𐴢 𐴊𐴟𐴑 𐴊𐴞𐴘𐴞𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴕𐴝 𐴇𐴝𐴥𐴘 𐴎𐴡𐴊𐴞 𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴇𐴝𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴊𐴠𐴑𐴞𐴥𐴌 𐴊𐴠, 𐴐𐴠𐴣𐴍𐴞𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴟𐴑 𐴊𐴞𐴓𐴠𐴥 𐴘𐴡 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴏𐴧𐴝𐴥𐴃𐴡𐴓𐴧𐴝 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠. <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴛 𐴑𐴟𐴥𐴐𐴞 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴟𐴑 𐴊𐴞𐴘𐴞𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥 𐴊𐴟𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴡𐴖𐴝𐴥𐴌 𐴀𐴟𐴎𐴟 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴟𐴑 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴀𐴠𐴥𐴕𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴇𐴡𐴥𐴃𐴞 𐴕𐴡. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴊𐴟𐴑-𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴡𐴖𐴝𐴥 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴕𐴠𐴅𐴝𐴃𐴡𐴌 𐴀𐴟𐴎𐴟 𐴓𐴡𐴘𐴎𐴝, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴊𐴟𐴑-𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴘𐴠 𐴔𐴡𐴦𐴃𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴏𐴡𐴀, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴞𐴦𐴘𐴝 𐴇𐴠𐴥 𐴊𐴟𐴑-𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴑𐴞𐴦-𐴑𐴞𐴦 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥: 𐴇𐴡𐴃𐴡𐴥 𐴀𐴝𐴎𐴧𐴟, 𐴕𐴞𐴎𐴡𐴌 𐴏𐴡𐴥𐴉𐴝𐴘 𐴊𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴃𐴡𐴥 𐴅𐴡𐴏𐴁𐴝, 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴇𐴡𐴥𐴌𐴑𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴃𐴡𐴥 𐴒𐴟𐴐𐴧𐴝𐴤, 𐴇𐴡𐴃𐴡𐴥 𐴋𐴡𐴦𐴌, 𐴇𐴡𐴃𐴡𐴥 𐴃𐴡𐴔𐴡𐴕𐴧𐴝, 𐴇𐴡𐴃𐴡𐴥 𐴅𐴟𐴏𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴃𐴡𐴥 𐴃𐴡𐴘𐴧𐴝𐴌. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴡 𐴊𐴠, 𐴇𐴠𐴥 𐴔𐴟𐴃𐴝𐴓𐴠𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌.<verse eid="2CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12" />𐴀𐴝𐴀𐴛 𐴐𐴠𐴣𐴍𐴞𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴓𐴠 𐴘𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴎𐴞𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴎𐴠 𐴄𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠.</para>
  <para style="p" vid="2CO 7:13">𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡, 𐴃𐴞𐴃𐴟𐴏𐴡𐴌 𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴌𐴟𐴀 𐴉𐴡𐴄𐴉𐴡𐴙𐴄𐴧𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝 𐴕𐴡𐴥 𐴉𐴡𐴌𐴠. 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴞𐴃𐴟𐴏𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴋𐴡𐴦𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴉𐴞-𐴇𐴝𐴉𐴞 𐴀𐴠𐴏𐴃𐴠𐴑𐴁𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴝𐴙𐴕𐴧𐴞𐴥𐴓𐴝, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴍𐴠𐴤, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴊𐴡𐴌 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴁𐴝𐴌𐴞𐴥𐴎𐴝𐴒𐴡𐴘. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s1">𐴊𐴞𐴓𐴑𐴟𐴥𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴡 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴝𐴙𐴌 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴀𐴕 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴒𐴡𐴌𐴞𐴉𐴢 𐴊𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴊𐴞𐴓𐴑𐴟𐴥𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴥𐴃𐴑𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />𐴀𐴝𐴀𐴛 𐴘𐴝𐴀𐴕 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴟𐴔 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴊𐴟𐴥𐴕 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴇𐴠𐴥𐴊𐴟𐴕 𐴊𐴞𐴀𐴓𐴢, 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴊𐴞𐴀𐴓𐴢, 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴘𐴧𐴡𐴌𐴠. <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴒𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴡𐴥 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠. <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴞𐴃𐴟𐴏𐴡𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴑𐴞, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴡𐴥𐴃𐴑𐴝 𐴃𐴟𐴓𐴝𐴤𐴌 𐴈𐴝𐴔 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴥𐴃𐴡𐴔 𐴀𐴡𐴥 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴔𐴝𐴥𐴎𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴔𐴝𐴕 𐴀𐴡𐴃𐴢, 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝𐴃𐴢, 𐴎𐴝𐴕𐴑𐴝𐴌𐴞𐴃𐴢, 𐴉𐴟𐴌𐴝 𐴅𐴡𐴏𐴁𐴝𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴃𐴢 𐴀𐴟𐴃𐴧𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴏𐴡𐴥𐴃𐴑𐴝 𐴊𐴞𐴦𐴘𐴝𐴌 𐴈𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥 𐴀𐴟𐴃𐴧𐴡𐴔 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴏𐴝𐴘𐴧𐴡𐴥.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />𐴀𐴝𐴀𐴛 𐴘𐴝𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴞𐴘𐴡𐴥𐴌 𐴅𐴡𐴏𐴁𐴝 𐴓𐴡𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴀𐴠𐴈𐴠𐴥𐴓𐴝𐴏𐴞𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴃𐴡𐴥 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴒𐴡𐴌𐴞𐴉𐴢 𐴁𐴡𐴙𐴕𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴡𐴌𐴞𐴉𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴡𐴘.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />𐴇𐴠𐴥 𐴔𐴡𐴏𐴡𐴥𐴓𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴌𐴝𐴘 𐴊𐴞𐴌 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴝𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴒𐴠𐴓𐴊𐴠 𐴁𐴡𐴏𐴡𐴥𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴏𐴡𐴥𐴃𐴑𐴝 𐴊𐴞𐴦𐴘𐴝𐴃𐴢 𐴉𐴡𐴀𐴘𐴓𐴝 𐴒𐴟𐴥𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝 𐴊𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴊𐴞𐴦𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴀𐴡𐴥. <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />𐴘𐴝𐴓𐴝 𐴇𐴠𐴥 𐴈𐴝𐴔 𐴇𐴡𐴥𐴃𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴠𐴥 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴕𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴔𐴡𐴎𐴞𐴕 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴠𐴕 𐴇𐴡𐴥𐴃𐴡𐴔 𐴀𐴡𐴥 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />𐴎𐴡𐴊𐴞 𐴊𐴞𐴦𐴁𐴝𐴌 𐴔𐴡𐴕 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴡𐴥𐴃𐴑𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴠𐴥 𐴔𐴡𐴎𐴞𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴇𐴠𐴥 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡.<verse eid="2CO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13" />𐴀𐴝𐴣𐴀𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴀𐴠𐴀𐴕 𐴕𐴡 𐴊𐴠 𐴑𐴞, 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴞𐴘𐴠𐴥 𐴐𐴟𐴥𐴑 𐴉𐴡𐴗𐴑 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴑 𐴉𐴡𐴦, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴎𐴠𐴕 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴀𐴡𐴥. <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />𐴘𐴝𐴓𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, ”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴔𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴥𐴘 𐴕𐴡𐴥 𐴎𐴝𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴈𐴡𐴔 𐴎𐴡𐴔𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴔𐴞𐴃𐴢 𐴕𐴡𐴥 𐴉𐴡𐴌𐴠.“<note caller="+" style="f"><char style="fr" closed="false">8‏:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 16:18">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 16‏:18</ref></char></char></note><verse eid="2CO 8:15" /></para>
  <para style="s1">𐴃𐴞𐴃𐴟𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴀𐴡𐴥𐴑, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴞𐴃𐴟𐴏𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴡 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴌𐴡𐴏𐴡𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴠𐴁𐴝𐴎𐴠 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴞𐴐𐴞𐴤 𐴅𐴟𐴏𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴝𐴥𐴘 𐴀𐴟𐴁𐴝𐴤𐴌𐴠 𐴘𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴈𐴝𐴔𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴃𐴝𐴔𐴝𐴥𐴔 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴟𐴥𐴕 𐴓𐴡𐴘𐴎𐴝𐴙𐴌 𐴊𐴠 𐴇𐴠𐴥𐴍𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴔 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴔𐴝𐴓𐴞𐴑 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴃𐴡𐴘𐴧𐴝𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥. <verse eid="2CO 8:19" /><verse number="20" style="v" sid="2CO 8:20" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴈𐴝𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴝𐴘 𐴓𐴡𐴘𐴎𐴝𐴙𐴌 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴃𐴝𐴓𐴠𐴑 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥𐴁𐴝𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴢 𐴃𐴡 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴡𐴤𐴕 𐴎𐴞𐴀𐴕 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴀𐴡𐴥 𐴏𐴡𐴥𐴘𐴧𐴞.<verse eid="2CO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴥𐴘 𐴀𐴟𐴁𐴝𐴤𐴌𐴠 𐴘𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴝𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴊𐴝𐴥𐴉𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴞𐴥. 𐴘𐴝𐴓𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴝𐴥𐴉𐴢 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴁𐴝𐴌𐴞𐴥𐴒𐴞𐴘𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />𐴃𐴞𐴃𐴟𐴏𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝. 𐴀𐴝𐴦𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴕𐴟𐴥𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴕𐴡𐴔𐴝𐴙𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴥. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴑𐴟𐴥𐴓𐴝𐴔𐴠𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴡.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="s1">𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴏𐴡𐴥𐴃𐴑𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴏𐴡𐴓𐴠𐴌 𐴊𐴠 𐴇𐴠𐴥 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴊𐴝𐴌𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 𐴕𐴝𐴥𐴘. <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴀𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴑𐴝𐴘𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴊𐴞𐴦 𐴁𐴡𐴓𐴧𐴝 𐴒𐴠𐴓𐴢 𐴊𐴠 𐴁𐴡𐴏𐴡𐴥𐴌 𐴓𐴡𐴥𐴃𐴞 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴡𐴥𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴅𐴡𐴏𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴕𐴡𐴌𐴠 𐴅𐴡𐴏𐴁𐴝 𐴊𐴞𐴘𐴠𐴥. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴕𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴟𐴃𐴝𐴓𐴠𐴑 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡 𐴄𐴡𐴥𐴀𐴌𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴀𐴛 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴡𐴥𐴘 𐴃𐴝𐴥𐴑𐴡. <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴀𐴘𐴢 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴡𐴘𐴧𐴝𐴌 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡 𐴉𐴝𐴦, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴌𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴒𐴡𐴌𐴡𐴤𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴐𐴡𐴥𐴌𐴡𐴔 𐴉𐴝𐴘𐴧𐴟𐴔. <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴁𐴝𐴥𐴙𐴂𐴧𐴞 𐴊𐴠, 𐴇𐴠𐴥 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴕𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴝𐴒𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘𐴃𐴡 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴀𐴝𐴘𐴁𐴡𐴌𐴈𐴡𐴃𐴞 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴊𐴞𐴦𐴁𐴝𐴌 𐴖𐴝𐴦𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴠𐴥. 𐴃𐴡𐴥𐴘 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴡 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴡𐴓𐴝𐴎𐴟𐴌𐴞 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴘𐴢 𐴊𐴞𐴦𐴘𐴡𐴥 𐴊𐴠.<verse eid="2CO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴈𐴡𐴔 𐴓𐴝𐴒𐴝, 𐴀𐴞𐴥𐴃𐴠 𐴈𐴡𐴔 𐴊𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴞𐴐𐴞𐴤 𐴓𐴝𐴒𐴝, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴞𐴐𐴞𐴤 𐴊𐴝𐴘𐴁𐴡. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠 𐴔𐴡𐴎𐴞𐴕 𐴊𐴞𐴦𐴘𐴡, 𐴔𐴡𐴕 𐴁𐴡𐴥𐴌𐴒𐴡𐴌𐴞 𐴘𐴝𐴥 𐴁𐴡𐴓𐴝𐴎𐴟𐴌𐴞 𐴕𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴡𐴦𐴘𐴝𐴌𐴠 𐴀𐴠𐴥𐴕𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />𐴀𐴝𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴄𐴝𐴓𐴞𐴑𐴧𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴑𐴝𐴉𐴞𐴥 𐴃𐴝𐴥𐴑𐴞𐴘𐴡𐴌𐴠, 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴓𐴧𐴝 𐴘𐴡𐴥 𐴀𐴡𐴥𐴊𐴡𐴌𐴁𐴝𐴀𐴌𐴝 𐴃𐴝𐴥𐴑𐴠. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="2CO 9:9">”𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴞𐴓𐴑𐴟𐴥𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥,</para>
  <para style="q2" vid="2CO 9:9">𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">9‏:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 112:9">𐴎𐴡𐴁𐴟𐴌 112‏:9</ref></char></char></note><verse eid="2CO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴐𐴝𐴐𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴞𐴏𐴢 𐴔𐴞𐴓𐴝𐴘𐴊𐴠 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴌𐴟𐴄𐴞 𐴊𐴠𐴦, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴓𐴝𐴒𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴞𐴏𐴢 𐴔𐴞𐴓𐴝𐴘𐴊𐴞𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴊𐴞𐴥𐴁𐴡. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴘𐴁𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴊𐴞𐴓𐴑𐴟𐴥𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴡, 𐴎𐴞𐴀𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴀𐴝𐴊𐴝𐴘 𐴀𐴡𐴥𐴌. <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴊𐴝𐴌𐴞𐴌 𐴈𐴝𐴔𐴠 𐴃𐴡 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴡𐴥𐴊𐴡𐴌𐴁𐴝𐴀𐴌𐴝 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴘𐴡𐴥 𐴀𐴝𐴊𐴝𐴘 𐴀𐴡𐴥𐴌. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴊𐴝𐴌𐴞 𐴓𐴡𐴥𐴘 𐴎𐴞𐴘𐴝𐴥𐴕 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴞𐴓𐴑𐴟𐴥𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴡𐴥𐴊𐴡𐴌𐴁𐴝𐴀𐴌𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴟𐴌𐴝𐴕𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴀𐴡𐴥𐴑, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴝 𐴕𐴡 𐴎𐴝 𐴊𐴠 𐴇𐴝𐴥𐴊𐴞𐴘𐴝𐴓𐴧𐴝.<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s1">𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴊𐴝𐴌𐴞𐴌 𐴏𐴡𐴥𐴉𐴝𐴘</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴟𐴀𐴝𐴥𐴔𐴟𐴙𐴑𐴧𐴝 𐴀𐴡𐴥𐴘𐴓𐴠 𐴉𐴟𐴣𐴊𐴝 𐴔𐴡𐴕𐴃𐴡𐴌 𐴒𐴝𐴙𐴌𐴇𐴝𐴥𐴎𐴞𐴌 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴄𐴡𐴑, 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴐𐴞𐴥𐴊𐴝𐴘𐴞 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴌𐴡𐴔𐴞 𐴓𐴡𐴘 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌. <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴠𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴓𐴠𐴤 𐴀𐴡𐴊𐴧𐴟𐴥𐴌 𐴀𐴝𐴄𐴡𐴑 𐴀𐴡𐴥𐴖𐴝 𐴕𐴡 𐴉𐴡𐴌𐴠 𐴎𐴠𐴊𐴧𐴟𐴥𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴥𐴘 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴁𐴡𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴞𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴕𐴞𐴘𐴡𐴔𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴙𐴌 𐴁𐴡𐴓𐴞 𐴁𐴝𐴥𐴉𐴠. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴓𐴠𐴥 𐴘𐴡 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴓𐴝𐴌𐴝𐴥𐴘 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴕𐴞𐴘𐴡𐴔𐴠 𐴕𐴡. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴓𐴝𐴌𐴝𐴥𐴙𐴌 𐴀𐴝𐴥𐴃𐴞𐴘𐴝𐴌 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴒𐴟𐴥𐴕 𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴟𐴀𐴙𐴕 𐴎𐴞𐴀𐴕𐴡𐴃𐴢 𐴑𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴓𐴧𐴝𐴘𐴞 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠𐴔𐴝𐴙𐴑𐴧𐴝 𐴁𐴟𐴎𐴝𐴥𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴎𐴞𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴏𐴞𐴕𐴝𐴥𐴃𐴢 𐴀𐴡𐴣𐴏𐴝𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴞𐴥𐴘𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴝𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴡𐴌𐴠 𐴑𐴡𐴁𐴎𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴁𐴝𐴕𐴝𐴘. <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴝𐴒𐴡𐴘, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕𐴞𐴌 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴝𐴏𐴞𐴤.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴁𐴝𐴀𐴌𐴡𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴀𐴠𐴥𐴕𐴝 𐴏𐴡𐴀𐴌. 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴀𐴝𐴁𐴝𐴌 𐴁𐴝𐴥𐴉𐴞𐴏𐴡𐴑 𐴊𐴠 𐴑𐴞, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴌𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴘𐴡, 𐴃𐴡𐴀 𐴀𐴝𐴀𐴛 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴟𐴔—𐴎𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴠 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴝𐴕𐴝𐴘𐴃𐴟𐴓𐴞𐴤 𐴁𐴡𐴓𐴧𐴝, 𐴕𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴕𐴡. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴀𐴛 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴐𐴠𐴣𐴍𐴞𐴥 𐴓𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴋𐴡𐴦𐴌 𐴓𐴝𐴒𐴝𐴙𐴌 𐴉𐴝𐴥𐴕 𐴕𐴡. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴠𐴣𐴍𐴞𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴄𐴡𐴑 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴌𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴕𐴞𐴎𐴠 𐴇𐴝𐴥𐴎𐴞𐴌 𐴃𐴝𐴥𐴑𐴠, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴝𐴥𐴘𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴥𐴓𐴠.“ <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴘𐴝𐴀𐴕 𐴁𐴟𐴎𐴞𐴥 𐴓𐴡𐴑 𐴊𐴠 𐴑𐴞, 𐴒𐴝𐴙𐴌𐴇𐴝𐴥𐴎𐴞𐴌𐴞𐴃𐴢 𐴐𐴠𐴣𐴍𐴞𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝, 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴝𐴥𐴎𐴞𐴌𐴞𐴃𐴢 𐴀𐴡𐴥 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴁𐴝𐴌𐴞𐴥𐴑 𐴑𐴟𐴥𐴖𐴝𐴓𐴝𐴘𐴃𐴡 𐴘𐴝𐴥 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴉𐴟𐴥𐴖𐴝𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴡 𐴏𐴝𐴀𐴘𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌 𐴕𐴝𐴔 𐴕𐴞𐴎𐴠 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴔𐴝𐴉𐴠 𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴠 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴡𐴘 𐴉𐴟𐴥𐴖𐴝𐴕 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴀𐴕 𐴀𐴡𐴁𐴟𐴎𐴢. <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴡 𐴐𐴞𐴥𐴔𐴝𐴌 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴁𐴟𐴖𐴝𐴥𐴘𐴧𐴠, 𐴇𐴠𐴥 𐴐𐴞𐴥𐴔𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴒𐴡𐴥𐴓𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴡𐴤. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴕𐴟 𐴀𐴝𐴘𐴃𐴝𐴤𐴔 𐴁𐴡𐴥𐴓𐴞 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴓𐴡𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴒𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴙𐴐𐴧𐴞𐴤. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴓𐴡𐴥𐴘 𐴘𐴡𐴥 𐴁𐴡𐴌𐴝𐴥𐴘 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴃𐴡 𐴐𐴞𐴥𐴔𐴝𐴌 𐴁𐴝𐴀𐴌𐴠 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴁𐴝𐴌𐴠𐴥𐴌, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴈𐴝𐴔𐴡𐴌 𐴎𐴝𐴒𐴝 𐴘𐴡𐴥 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠𐴓𐴝𐴑𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴡𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴐𐴞𐴥𐴔𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴈𐴝𐴔 𐴓𐴡𐴘 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕 𐴕𐴝𐴥𐴘. <verse eid="2CO 10:16" /><verse number="17" style="v" sid="2CO 10:17" />𐴔𐴡𐴕𐴃𐴡𐴌, ”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴔𐴝𐴁𐴟𐴊𐴡𐴌𐴠 𐴓𐴡𐴥𐴘 𐴁𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴡𐴥𐴗𐴑.“<note caller="+" style="f"><char style="fr" closed="false">10‏:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 9:24">𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝 9‏:24</ref></char></char></note> <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴕𐴝𐴔 𐴕𐴞𐴎𐴠 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴃𐴡 𐴏𐴡𐴥𐴘𐴧𐴞 𐴁𐴡𐴥𐴓𐴞 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴝𐴁𐴟𐴊𐴠 𐴕𐴝𐴔 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴀𐴠𐴥𐴕𐴝 𐴀𐴡𐴥.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s1">𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴞𐴏𐴝𐴥 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴠𐴑𐴟𐴉𐴝𐴘𐴌𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝; 𐴁𐴠𐴐𐴡𐴥𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴡𐴤𐴌 𐴀𐴡𐴥. <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴝𐴘𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴇𐴡𐴥𐴐𐴡𐴔 𐴓𐴡𐴥𐴘 𐴎𐴟𐴌𐴝𐴒𐴝𐴃𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴞, 𐴘𐴝𐴥𐴕𐴞 𐴔𐴡𐴀𐴏𐴞𐴤 𐴓𐴧𐴡𐴥𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴂𐴝𐴑 𐴇𐴡𐴙𐴕𐴧𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴟𐴓𐴞𐴤𐴊𐴞 𐴉𐴝𐴌𐴞. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴋𐴡𐴦𐴌𐴝𐴙𐴌 𐴊𐴠 𐴑𐴞, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴝𐴥𐴉𐴠 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴓𐴝𐴥𐴑𐴞 𐴓𐴡𐴥𐴘 𐴇𐴝𐴥𐴖𐴝𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴠𐴔𐴝𐴑𐴡𐴌𐴠 𐴘𐴡𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤 𐴓𐴧𐴡𐴥𐴘 𐴎𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴧𐴟 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴁𐴡𐴥𐴘. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴕𐴡𐴥 𐴒𐴡𐴌𐴞𐴥, 𐴘𐴝𐴥𐴃𐴡 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴌𐴟𐴀 𐴉𐴡𐴦 𐴎𐴞𐴁𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴝𐴘𐴧𐴡𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴀𐴝𐴓𐴡𐴑, 𐴘𐴝𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴡𐴦 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴓𐴡𐴑, 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴡𐴤.<verse eid="2CO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5" />𐴀𐴝𐴀𐴛 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴇𐴠𐴥 ”𐴁𐴝𐴌𐴞𐴥𐴑 𐴏𐴝𐴥𐴇𐴝𐴁𐴞“ 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴔 𐴕𐴡 𐴄𐴝𐴥𐴀𐴌𐴞. <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴒𐴡𐴌𐴞 𐴁𐴡𐴘𐴧𐴝𐴕 𐴊𐴞 𐴕𐴡 𐴎𐴝𐴕𐴞𐴓𐴠𐴥 𐴘𐴡, 𐴀𐴠𐴓𐴡𐴥𐴔𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝𐴃𐴧𐴟 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴞. <verse eid="2CO 11:6" /><verse number="7" style="v" sid="2CO 11:7" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴡𐴑𐴧𐴝 𐴁𐴝𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴀𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴔𐴝𐴦𐴕𐴝 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴥 𐴀𐴝𐴀𐴛 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴕𐴠𐴥؟ <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴀𐴛 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴊𐴝𐴔 𐴒𐴡𐴙𐴐𐴧𐴞𐴥, 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴓𐴟𐴄𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥. <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴔𐴟𐴀𐴃𐴝𐴐𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴓𐴧𐴝 𐴎𐴟𐴓𐴝𐴂𐴢 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢 𐴊𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴕𐴟𐴥𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴟𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴎𐴟𐴓𐴝𐴂𐴢 𐴕𐴡 𐴀𐴡𐴥𐴘 𐴉𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔 𐴀𐴡𐴥. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴑𐴝𐴘𐴝𐴌 𐴀𐴠𐴓𐴝𐴑𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴝𐴥𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌؟ 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴕𐴠𐴥؟ 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴝𐴕𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥.<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴟𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴔𐴡𐴦𐴗𐴑𐴝 𐴉𐴝𐴘𐴃𐴡 𐴕𐴡 𐴊𐴞, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴈𐴡𐴀𐴘𐴢 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴔𐴡𐴦𐴗𐴑𐴝 𐴃𐴟𐴖𐴝𐴌. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴔𐴞𐴏𐴝𐴥 𐴏𐴝𐴥𐴇𐴝𐴁𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴥𐴑𐴧𐴡𐴌𐴝𐴘 𐴒𐴡𐴥𐴌𐴞 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠𐴥𐴃𐴢 𐴊𐴡𐴥𐴌𐴠. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴃𐴡 𐴕𐴟𐴌𐴝𐴕𐴞 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴁𐴠𐴥𐴃𐴢 𐴊𐴡𐴥𐴌𐴠. <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴁𐴠𐴥𐴃𐴢 𐴊𐴡𐴥𐴌𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴋𐴡𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴁𐴠 𐴉𐴝𐴘𐴁𐴡.<verse eid="2CO 11:15" /></para>
  <para style="s1">𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴠𐴑𐴟𐴉𐴢 𐴁𐴡𐴓𐴞 𐴕𐴡 𐴁𐴝𐴥𐴙𐴂𐴧𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴁𐴝𐴥𐴉𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴠𐴑𐴟𐴉𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴒𐴡𐴏𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴀𐴠𐴑𐴧𐴝𐴕𐴝𐴥 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴡𐴌𐴝𐴥𐴙𐴌 𐴀𐴠𐴑𐴞𐴕𐴠 𐴎𐴞𐴀𐴕 𐴈𐴡𐴀𐴙𐴌, 𐴇𐴞𐴥𐴀𐴕 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴠𐴑𐴟𐴉𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴔𐴡𐴎𐴞𐴕 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴒𐴞𐴘𐴝𐴕𐴞 𐴀𐴡𐴥𐴘 𐴁𐴠𐴑𐴟𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴡𐴤. <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴟𐴓𐴝𐴔 𐴁𐴝𐴕𐴝𐴘𐴓𐴠𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴓𐴞𐴤𐴓𐴠, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴁𐴝𐴌𐴞𐴥𐴑 𐴑𐴟𐴥𐴖𐴝𐴓𐴝𐴘𐴓𐴠, 𐴘𐴝𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴝𐴓𐴢 𐴏𐴝𐴥𐴘 𐴏𐴟𐴖𐴝𐴌 𐴔𐴝𐴙𐴓𐴧𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥 𐴃𐴡 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴡𐴤. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />𐴀𐴝𐴀𐴛 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴘𐴝𐴀𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴇𐴝𐴥𐴙𐴌 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴝𐴥𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔.</para>
  <para style="p" vid="2CO 11:21">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴞𐴘𐴡𐴥𐴃𐴧𐴟 𐴎𐴠 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤—𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴠𐴑𐴟𐴉𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴈𐴡𐴘𐴓𐴠𐴥—𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴘𐴡𐴥 𐴇𐴠𐴥 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴁𐴌𐴝𐴕𐴞 𐴊𐴠 𐴕𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞 𐴊𐴠 𐴕𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴊𐴠 𐴕𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴊𐴠 𐴕𐴠𐴥؟—𐴀𐴠𐴎𐴧𐴡𐴕 𐴉𐴡𐴦𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴈𐴡𐴘𐴓𐴠𐴥—𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤: 𐴁𐴞𐴐𐴞𐴤 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴡𐴥, 𐴎𐴞𐴘𐴡𐴥𐴓𐴢 𐴈𐴝𐴍𐴝𐴃𐴢 𐴀𐴡𐴥, 𐴇𐴝𐴥𐴣𐴊𐴝𐴘 𐴉𐴞𐴍𐴝 𐴇𐴝𐴥𐴃𐴢 𐴀𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴌𐴁𐴝𐴥𐴌 𐴔𐴡𐴦𐴃𐴢 𐴓𐴡𐴘 𐴔𐴟𐴑𐴝𐴁𐴠𐴓𐴝 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴀𐴡𐴥. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴀𐴛 𐴀𐴠𐴑 𐴈𐴡𐴔 𐴏𐴝𐴓𐴞𐴐𐴧𐴗𐴝𐴌 𐴊𐴡𐴥𐴌𐴠 𐴉𐴝𐴣𐴏𐴢 𐴁𐴝𐴌 𐴊𐴟𐴌𐴝 𐴇𐴝𐴥𐴘𐴧𐴞. <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />𐴃𐴞𐴕 𐴁𐴝𐴌 𐴀𐴝𐴀𐴛 𐴋𐴝𐴕𐴋𐴝 𐴓𐴡𐴘 𐴉𐴞𐴍𐴝 𐴇𐴝𐴥𐴘𐴧𐴞, 𐴀𐴠𐴑𐴁𐴝𐴌 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴔𐴝𐴌𐴝 𐴇𐴝𐴥𐴘𐴧𐴞; 𐴃𐴞𐴕 𐴁𐴝𐴌 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴀𐴛 𐴎𐴝𐴙𐴌 𐴊𐴠 𐴎𐴝𐴀𐴣𐴏𐴢 𐴁𐴝𐴥𐴚𐴒𐴞 𐴋𐴟𐴉𐴞𐴥𐴒𐴞𐴓𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴀𐴠𐴑 𐴌𐴝𐴙𐴃𐴢 𐴀𐴠𐴑 𐴊𐴞𐴕 𐴈𐴝𐴍𐴝 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />𐴀𐴝𐴣𐴀𐴌 𐴀𐴠𐴒𐴝𐴎𐴝𐴥 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴁𐴡𐴀𐴗𐴃𐴢 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴇𐴡𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔: 𐴇𐴝𐴥𐴓𐴡𐴌 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢, 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴡𐴌 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢, 𐴕𐴞𐴎𐴡𐴌 𐴑𐴡𐴗𐴔𐴞 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢, 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢, 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢, 𐴔𐴡𐴘𐴊𐴝𐴕 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢, 𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴞𐴏𐴝𐴥 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴌𐴝𐴙𐴃𐴢 𐴀𐴟𐴌𐴒𐴟𐴥𐴔𐴝 𐴈𐴝𐴍𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴝𐴀𐴛 𐴁𐴟𐴥𐴑 𐴃𐴞𐴌𐴝𐴥𐴐𐴠 𐴊𐴟𐴑 𐴉𐴝𐴘𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴒𐴝𐴎𐴝𐴥-𐴀𐴠𐴒𐴝𐴎𐴝𐴥 𐴖𐴝𐴀𐴐𐴧𐴝 𐴃𐴝𐴥𐴙𐴑𐴧𐴞 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴝𐴀𐴛 𐴐𐴞𐴥𐴃𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌𐴠 𐴘𐴡𐴥 𐴊𐴟𐴑 𐴉𐴝𐴘𐴧𐴞𐴥. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />𐴀𐴝𐴌𐴒𐴟𐴥𐴕𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴌𐴡, 𐴃𐴝𐴔𐴝𐴥𐴔 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴡𐴃𐴧𐴞𐴥 𐴊𐴞𐴕 𐴊𐴝𐴁𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴠.<verse eid="2CO 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2CO 11:29" />𐴇𐴡𐴕𐴠 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴀𐴛 𐴑𐴡𐴔𐴎𐴟𐴌 𐴕𐴡 𐴀𐴡𐴥𐴘 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤؟ 𐴇𐴝𐴌𐴠𐴤 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴡 𐴉𐴟𐴌𐴠 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤؟ <verse eid="2CO 11:29" /><verse number="30" style="v" sid="2CO 11:30" />𐴎𐴡𐴊𐴞 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 𐴀𐴡𐴥, 𐴀𐴝𐴀𐴛 𐴀𐴟𐴀𐴙𐴕 𐴓𐴡𐴥𐴘 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔 𐴎𐴞𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴑𐴡𐴔𐴎𐴟𐴌𐴞 𐴓𐴡𐴘 𐴁𐴝𐴎𐴝𐴥 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴉𐴢, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴝𐴕𐴠 𐴀𐴝𐴀𐴛 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴕𐴡. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />𐴊𐴝𐴔𐴝𐴥𐴏𐴑𐴝𐴏𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴝𐴌𐴞𐴃𐴝𐴏𐴡𐴌 𐴇𐴝𐴥𐴑𐴞𐴔𐴠 𐴊𐴝𐴔𐴝𐴥𐴏𐴑𐴝𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴌𐴠 𐴉𐴝𐴀𐴌𐴝 𐴊𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢. <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴓𐴝𐴘𐴡𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴋𐴠𐴁𐴝𐴓𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴎𐴝𐴕𐴝𐴥𐴓𐴝 𐴁𐴝𐴥𐴘 𐴕𐴞𐴏𐴠 𐴓𐴝𐴔𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴀𐴓𐴢, 𐴃𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s1">𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴊𐴡𐴌𐴐𐴡𐴥𐴕 𐴀𐴠𐴊𐴧𐴠 𐴎𐴝𐴇𐴠𐴥𐴌𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴘𐴡. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴛 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴊𐴞𐴦𐴘𐴝 𐴊𐴡𐴌𐴐𐴡𐴥𐴕 𐴀𐴠𐴊𐴧𐴠 𐴎𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴧𐴟𐴥𐴔. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴏𐴞𐴕𐴞𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴘𐴝𐴦𐴌 𐴏𐴡𐴙𐴊𐴧𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴝𐴒𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴟𐴓𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴡𐴥𐴘𐴧𐴠 𐴕𐴠 𐴘𐴝𐴥 𐴅𐴞𐴏𐴞𐴥𐴔 𐴏𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴁𐴠 𐴎𐴝𐴕𐴠. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝 𐴌𐴠—𐴇𐴞𐴥𐴘𐴝𐴕 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴡𐴥𐴘𐴧𐴠 𐴕𐴠𐴥 𐴘𐴝𐴥 𐴅𐴞𐴏𐴞𐴥𐴔 𐴏𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴕𐴞, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴝𐴕𐴠— <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />𐴅𐴡𐴕𐴧𐴡𐴃𐴟𐴓𐴢-𐴉𐴠𐴥𐴌𐴡𐴊𐴟𐴏𐴡𐴃𐴢 𐴃𐴟𐴓𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴝 𐴕𐴡 𐴎𐴝 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴢, 𐴎𐴞𐴀𐴕 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴕𐴝𐴥𐴘. <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴓𐴡𐴥𐴘 𐴕𐴡. 𐴀𐴝𐴀𐴛 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴑𐴡𐴔𐴎𐴟𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴘𐴡 𐴀𐴝𐴀𐴛 𐴁𐴠𐴑𐴟𐴉𐴢 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴟𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴁𐴠 𐴈𐴡𐴘𐴧𐴟𐴥𐴔. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴘𐴝𐴥 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴁𐴡𐴥𐴓𐴞 𐴕𐴡 𐴄𐴝𐴥𐴀𐴌𐴠. <verse eid="2CO 12:6" /><verse number="7" style="v" sid="2CO 12:7" />𐴇𐴠𐴥 𐴎𐴝𐴇𐴠𐴥𐴌𐴞 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴡𐴃𐴞 𐴋𐴡𐴣𐴀𐴌𐴒𐴞𐴌𐴞 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴁𐴝𐴌𐴞𐴥𐴑 𐴕𐴡 𐴑𐴟𐴥𐴖𐴝𐴓𐴝𐴘 𐴉𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴦𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴑𐴠𐴣𐴍𐴝 𐴒𐴡𐴥𐴓𐴝𐴘 𐴊𐴞𐴥𐴘𐴝 𐴒𐴞𐴥𐴘𐴠; 𐴘𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴟𐴑 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴟𐴏𐴞𐴥𐴓𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴀𐴛 𐴁𐴝𐴌𐴞𐴥𐴑 𐴕𐴡 𐴑𐴟𐴥𐴖𐴝𐴓𐴝𐴘. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴞𐴕 𐴁𐴝𐴌 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥 𐴑𐴠𐴣𐴍𐴝 𐴖𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴟𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴡𐴌 𐴓𐴧𐴝 𐴑𐴝𐴉𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴡𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴑𐴡𐴔𐴎𐴟𐴌𐴞𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.“</char> 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴑𐴡𐴔𐴎𐴟𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴑𐴡𐴔𐴎𐴟𐴌𐴞𐴃𐴢, 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞𐴃𐴢, 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢, 𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴐𐴑𐴞𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴑𐴟𐴥𐴐𐴞. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴡𐴥𐴘, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴀𐴛 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴒𐴡𐴘.<verse eid="2CO 12:10" /></para>
  <para style="s1">𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴡𐴓𐴧𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴝</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />𐴀𐴝𐴀𐴛 𐴁𐴠𐴑𐴟𐴉𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴞𐴒𐴡𐴘 𐴊𐴠 𐴀𐴡𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴡𐴅𐴁𐴟𐴌 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. 𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴕𐴝𐴔 𐴉𐴡𐴦𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴃𐴡 ”𐴁𐴝𐴌𐴞𐴥𐴑 𐴏𐴝𐴥𐴇𐴝𐴁𐴞“ 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴇𐴡𐴕𐴡𐴤 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴈𐴡𐴔 𐴕𐴡. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴡 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴞𐴓𐴧𐴝𐴘𐴞-𐴕𐴞𐴐𐴝𐴥𐴕, 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝 𐴇𐴝𐴌𐴇𐴝𐴥𐴕𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴉𐴟𐴣𐴎𐴝𐴤 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴌 𐴇𐴡𐴕 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴡 𐴊𐴠𐴥؟ 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴥𐴕 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴡𐴤!<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />𐴀𐴝𐴀𐴛 𐴀𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴝𐴏𐴞𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴉𐴟𐴣𐴎𐴝𐴤 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴟𐴔; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴝𐴉𐴔𐴝𐴦 𐴓𐴧𐴝 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴞𐴔𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴃𐴧𐴟 𐴕𐴝𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴃𐴧𐴟 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴇𐴡𐴥𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴟𐴔, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴟𐴥𐴊𐴧𐴗𐴝. 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴘𐴝𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴔 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤؟ <verse eid="2CO 12:15" /><verse number="16" style="v" sid="2CO 12:16" />𐴎𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴡𐴥𐴑, 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴉𐴟𐴣𐴎𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴁𐴡𐴥𐴓𐴠 𐴏𐴝𐴓𐴝𐴥𐴑𐴞 𐴒𐴡𐴥𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴞. <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />𐴀𐴝𐴀𐴛 𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴞 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴙𐴓𐴧𐴞𐴥 𐴊𐴠 𐴕𐴠𐴥؟ <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />𐴀𐴝𐴀𐴛 𐴃𐴞𐴃𐴟𐴏𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴝𐴥𐴘 𐴖𐴝𐴌𐴠 𐴘𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴓𐴝𐴔. 𐴃𐴞𐴃𐴟𐴏𐴠 𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴙𐴓𐴧𐴠𐴥 𐴊𐴠 𐴕𐴠𐴥؟ 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴑𐴞𐴥 𐴀𐴠𐴑𐴞𐴤 𐴌𐴟𐴀𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑𐴞𐴤 𐴌𐴝𐴏𐴃𐴝𐴃𐴢 𐴕𐴡 𐴏𐴡𐴓𐴞 𐴕𐴠𐴥؟<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴔 𐴑𐴟𐴥𐴖𐴝𐴓𐴝𐴙𐴌 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴡𐴌 𐴕𐴞𐴥𐴑𐴞؟ 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴀𐴕 𐴈𐴡𐴀𐴙𐴌 𐴇𐴞𐴥𐴀𐴕 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴔𐴟𐴀𐴕𐴃𐴟 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠. 𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴝𐴕𐴝𐴘𐴃𐴟𐴓𐴞𐴤 𐴁𐴡𐴓𐴧𐴝. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴋𐴡𐴦𐴌𐴝𐴙𐴌 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴘𐴓𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴝𐴘𐴃𐴡𐴥 𐴏𐴝𐴀𐴙𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡 𐴉𐴝𐴘𐴧𐴟𐴔 𐴁𐴡𐴥𐴓𐴞, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴝𐴘𐴃𐴡𐴥 𐴏𐴡𐴀𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡 𐴉𐴝𐴘𐴁𐴝. 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴀𐴕 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴟𐴔 𐴁𐴡𐴓𐴞 𐴋𐴡𐴦𐴌𐴝𐴙𐴌: 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢, 𐴀𐴝𐴓𐴞𐴚𐴝𐴛, 𐴌𐴝𐴑𐴝𐴌𐴝𐴑𐴞, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴖𐴝, 𐴁𐴡𐴊𐴕𐴝𐴔𐴞, 𐴒𐴞𐴉𐴡𐴃𐴢, 𐴃𐴟𐴑𐴝𐴁𐴧𐴡𐴌𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴓𐴔𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴌𐴡𐴤 𐴋𐴡𐴦𐴌𐴝𐴙𐴌 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴘𐴓𐴠𐴤 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝 𐴁𐴝𐴘𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴠 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴠 𐴕𐴝𐴉𐴝𐴑𐴞, 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴊𐴔𐴝𐴐𐴞𐴃𐴧𐴟 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴠𐴓𐴝.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴧𐴞𐴤𐴌 𐴊𐴠 𐴀𐴠𐴁𐴝𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴦𐴔𐴠𐴓𐴝 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴘𐴝𐴥 𐴃𐴞𐴕 𐴎𐴡𐴕 𐴒𐴡𐴁𐴝𐴤𐴌<note caller="+" style="f"><char style="fr" closed="false">13‏:1 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 19:15">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 19‏:15</ref></char></char></note> 𐴎𐴡𐴁𐴝𐴕𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴁𐴡𐴓𐴞 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡.“ <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴀𐴝𐴒𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴓𐴝𐴔, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴝𐴥𐴌 𐴀𐴝𐴒𐴠 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴑𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴘𐴝𐴓𐴝 𐴒𐴝𐴙𐴌𐴇𐴝𐴥𐴎𐴞𐴌𐴞𐴃𐴢 𐴀𐴡𐴥 𐴀𐴝𐴀𐴛 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴈𐴡𐴀𐴘𐴢 𐴌𐴝𐴑𐴞𐴥𐴌, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴘𐴓𐴠𐴤, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴕𐴡 𐴊𐴞𐴘𐴟𐴔; <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴊𐴡𐴓𐴞𐴓𐴢 𐴏𐴡𐴀𐴌. 𐴀𐴞𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴑𐴡𐴔𐴎𐴟𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴡𐴔𐴎𐴟𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴞𐴥𐴁𐴝 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴠𐴤. 𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴑𐴡𐴔𐴎𐴟𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔.<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴡𐴤 𐴕𐴠𐴥 𐴕𐴝𐴥𐴘 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴏𐴡𐴀; 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴃𐴝𐴇𐴝𐴥𐴑𐴞𐴃𐴢 𐴒𐴡𐴌𐴡𐴤. 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡؟ 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴝𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴄𐴡𐴥𐴀𐴌𐴞𐴒𐴞𐴘𐴡𐴒𐴡𐴘. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴝𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴕𐴡𐴥 𐴄𐴡𐴥𐴀𐴌𐴞 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴞𐴁𐴝𐴥. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴈𐴝𐴔 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴕𐴡 𐴊𐴠 𐴑𐴞 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴝𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝𐴘𐴓𐴠𐴥 𐴘𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴒𐴡𐴌𐴡𐴤. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴃𐴡 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴀𐴟𐴓𐴋𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴕𐴝𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴐𐴟𐴥𐴓𐴋𐴝 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴏𐴠𐴤. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴡𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴟𐴥𐴐𐴞. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕 𐴁𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴡𐴘. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴒𐴝𐴙𐴌𐴇𐴝𐴥𐴎𐴞𐴌𐴞𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴀𐴠𐴊𐴟𐴥𐴕 𐴀𐴞𐴀𐴕 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴝𐴥𐴎𐴞𐴌 𐴃𐴝𐴥𐴑𐴞 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴄𐴡𐴑 𐴀𐴡𐴥𐴖𐴝 𐴕𐴡 𐴉𐴡𐴌𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴝𐴕𐴝𐴘𐴃𐴟𐴓𐴞𐴤 𐴁𐴡𐴓𐴧𐴝, 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴕𐴡.<verse eid="2CO 13:10" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴏𐴡𐴥𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴡𐴣𐴃𐴢 𐴄𐴞𐴥𐴑 𐴒𐴡𐴌𐴡𐴤, 𐴅𐴡𐴏𐴁𐴝 𐴊𐴡, 𐴀𐴠𐴑 𐴔𐴡𐴕 𐴀𐴡𐴥, 𐴐𐴝𐴥𐴕𐴃𐴞𐴃𐴢 𐴃𐴝𐴥𐴑𐴡. 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴀𐴝𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.<verse eid="2CO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12" />𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴂𐴝𐴑 𐴊𐴞𐴓𐴠 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴡. <verse eid="2CO 13:12" /><verse number="13" style="v" sid="2CO 13:13" />𐴃𐴝𐴔𐴝𐴥𐴔 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌.<verse eid="2CO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 13:14" />𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>