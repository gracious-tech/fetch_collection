<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴎𐴝𐴇𐴠𐴥𐴌𐴞</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌𐴞</para>
  <para style="toc2">𐴎𐴝𐴇𐴠𐴥𐴌𐴞</para>
  <para style="toc3">𐴎𐴝</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴎𐴝𐴇𐴠𐴥𐴌𐴞</para>
  <para style="imt">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌𐴞𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴏𐴞𐴥𐴘𐴝𐴌𐴝. 𐴘𐴞𐴁𐴝𐴤𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 <char style="ior">(<ref loc="REV 1:1">1‏:1</ref>)</char>. 𐴘𐴞𐴁𐴝𐴤𐴌𐴠 𐴘𐴡𐴥 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴕𐴡𐴁𐴧𐴡𐴘-𐴉𐴝𐴣𐴏𐴢 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 1 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 3 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴟𐴥𐴕 𐴀𐴡𐴥 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴎𐴝𐴕𐴝 𐴎𐴝 (<char style="xt"><ref loc="JHN 13:23">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 13‏:23</ref></char>). 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌𐴞 𐴖𐴝 𐴂𐴝𐴄𐴔𐴡𐴏𐴢 𐴋𐴞𐴘𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴠𐴥𐴍𐴠 𐴓𐴡𐴘𐴎𐴝𐴘 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 <char style="ior">(<ref loc="REV 1:9">1‏:9</ref>)</char></para>
  <para style="ip">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌𐴞 𐴘𐴞𐴁𐴝𐴤 𐴓𐴠𐴑𐴝𐴥𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴉𐴡𐴌𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴐𐴝𐴤 𐴊𐴞𐴦 𐴁𐴡𐴓𐴧𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴄𐴝𐴙𐴔 𐴋𐴝𐴥𐴑𐴠 <char style="ior">(<ref loc="REV 1:3">1‏:3</ref>; <ref loc="REV 22:7">22‏:7</ref>)</char>. 𐴀𐴠𐴣𐴃𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴎𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴌𐴟𐴑𐴟𐴥 <char style="ior">(<ref loc="REV 2-3">2‏—3</ref>)</char> 𐴀𐴡𐴃𐴢 𐴎𐴞𐴑𐴞𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴠 𐴓𐴠𐴑𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴂𐴡𐴘𐴒𐴝𐴔 𐴁𐴡𐴓𐴞 𐴈𐴡𐴘𐴧𐴠𐴥 <char style="ior">(<ref loc="REV 1:3">1‏:3</ref>)</char> 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴞𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴟𐴎𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴐𐴡𐴑𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝 𐴉𐴟𐴌𐴝𐴕𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴑𐴠𐴏𐴧𐴟𐴥-𐴑𐴠𐴏𐴧𐴟𐴥 𐴇𐴞𐴥𐴏𐴧𐴝 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝 6:1-8 𐴓𐴡𐴘. 𐴎𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴐𐴞𐴥𐴛𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴘𐴝𐴓𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴠 𐴀𐴝𐴉𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴅𐴞𐴤𐴂𐴢 𐴊𐴠𐴐𐴡𐴌 𐴖𐴡𐴌𐴠 𐴕𐴝𐴎𐴞𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴔𐴞𐴑𐴧𐴝𐴥 (𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 7-9). 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴞𐴏𐴝𐴤 𐴎𐴞𐴃𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡. 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴡𐴑 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴝𐴐𐴝𐴤 𐴊𐴡𐴑.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴠 𐴂𐴡𐴘𐴒𐴝𐴔 𐴉𐴝𐴘𐴧𐴠𐴥 <char style="ior">(<ref loc="REV 1:1-20">1‏:1‏-20</ref>)</char></para>
  <para style="io1">2. 𐴀𐴞𐴏𐴝𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 <char style="ior">(<ref loc="REV 2:1-3:22">2‏:1‏—3‏:22</ref>)</char></para>
  <para style="io1">3. 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴔𐴡𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴐𐴞𐴥𐴛𐴝 <char style="ior">(<ref loc="REV 4:1-8:5">4‏:1‏—8‏:5</ref>; <ref loc="REV 8:6-11:19">8‏:6‏—11‏:19</ref>)</char></para>
  <para style="io1">4. 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴔𐴝𐴃𐴝𐴥 𐴀𐴡𐴓𐴝 𐴕𐴝𐴒𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴌 𐴓𐴝𐴌𐴝𐴥𐴘 <char style="ior">(<ref loc="REV 12:1-14:20">12‏:1‏—14‏:20</ref>)</char></para>
  <para style="io1">5. 𐴒𐴡𐴎𐴧𐴡𐴁𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴘𐴝𐴓𐴝 <char style="ior">(<ref loc="REV 15:1-16:18">15‏:1‏—16‏:18</ref>)</char></para>
  <para style="io1">6. 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴇𐴝𐴥𐴌𐴝𐴘𐴧𐴠 <char style="ior">(<ref loc="REV 17:1-20:15">17‏:1‏—20‏:15</ref>)</char></para>
  <para style="io1">7. 𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴕𐴡𐴘𐴝 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴘𐴝 𐴎𐴡𐴁𐴞𐴕 <char style="ior">(<ref loc="REV 21:1-22:21">21‏:1‏—22‏:21</ref>)</char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="s1">𐴉𐴡𐴌𐴞𐴏𐴡 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />𐴀𐴞𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴎𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴞𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴞𐴀𐴕 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴥𐴌𐴝 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴀𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴒𐴡𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴠. <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴁𐴝𐴤 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠 𐴂𐴡𐴘𐴒𐴝𐴔 𐴀𐴞𐴀𐴕 𐴃𐴠𐴓𐴝𐴖𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴘𐴡𐴥 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴀𐴕 𐴉𐴟𐴥𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴍𐴠𐴥 𐴎𐴞𐴀𐴕 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴃𐴡 𐴋𐴝𐴥𐴑𐴠.<verse eid="REV 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴀𐴝𐴀𐴛 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟, 𐴀𐴠𐴐𐴞𐴥𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴎𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌:</para>
  <para style="b" vid="REV 1:4" />
  <para style="p" vid="REV 1:4">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑, 𐴀𐴟𐴁𐴝𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴏𐴠𐴤; 𐴇𐴝𐴥𐴣𐴃𐴢 𐴌𐴟𐴀 𐴀𐴟𐴀𐴙𐴕𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴘𐴡𐴥, 𐴎𐴞𐴀𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴏𐴠𐴤; <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴘𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴒𐴡𐴁𐴝𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴎𐴡𐴕, 𐴎𐴞𐴁𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝.</para>
  <para style="p" vid="REV 1:5">𐴀𐴞𐴥𐴁𐴝 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴓𐴡𐴖𐴢 𐴖𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴝𐴙𐴅𐴧𐴡 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴉𐴡𐴌 𐴈𐴝𐴔𐴡𐴓𐴧𐴝 𐴀𐴞𐴔𐴝𐴔 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴦𐴏𐴃𐴌𐴞 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />𐴏𐴡𐴀, 𐴀𐴞𐴥𐴁𐴝 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌; 𐴇𐴝𐴥𐴀𐴌 𐴏𐴟𐴑𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥𐴁𐴡, 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴝𐴣𐴙𐴃𐴧𐴞𐴥𐴓𐴢. 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />𐴔𐴝𐴁𐴟𐴊𐴢 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴡𐴥𐴌𐴔𐴝𐴌, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴓𐴉𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴔𐴞𐴥𐴒𐴝,“</char> 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴝𐴥𐴕𐴞 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴖𐴝𐴓𐴝 𐴖𐴝.<verse eid="REV 1:8" /></para>
  <para style="s1">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴡𐴌𐴐𐴡𐴥𐴕</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴡𐴃𐴢, 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴘𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴂𐴝𐴄𐴔𐴡𐴏𐴢 𐴈𐴡𐴀 𐴊𐴠 𐴋𐴞𐴘𐴝𐴃𐴢 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴊𐴞𐴕 𐴀𐴠𐴑 𐴌𐴡𐴦𐴘𐴁𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴑𐴡𐴁𐴎𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴡𐴥𐴃𐴧𐴟 𐴐𐴞𐴥𐴛𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴘 𐴎𐴞𐴀𐴕 𐴊𐴠𐴑𐴡𐴥𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴓𐴠𐴑, 𐴁𐴝𐴦𐴊𐴠 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴝𐴥𐴣𐴃𐴡 𐴖𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴢 𐴀𐴡𐴃𐴢, 𐴏𐴠𐴔𐴟𐴥𐴌𐴕𐴝𐴃𐴢, 𐴂𐴞𐴌𐴒𐴝𐴔𐴟𐴕 𐴀𐴡𐴃𐴢, 𐴃𐴟𐴖𐴝𐴃𐴞𐴥𐴌𐴝𐴃𐴢, 𐴏𐴝𐴥𐴌𐴊𐴞𐴏𐴢 𐴀𐴡𐴃𐴢, 𐴉𐴞𐴓𐴝𐴊𐴞𐴥𐴓𐴉𐴞𐴘𐴝𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴀𐴟𐴥𐴊𐴞𐴑𐴞𐴘𐴝𐴃𐴢.“</char><verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴔𐴟𐴦 𐴉𐴞𐴥𐴌𐴝𐴘𐴧𐴞. 𐴀𐴝𐴦𐴌 𐴉𐴞𐴥𐴅𐴧𐴞 𐴌𐴝𐴥𐴌 𐴐𐴟𐴥𐴕𐴝𐴌 𐴇𐴝𐴥𐴣𐴃𐴧𐴝𐴕 𐴏𐴠𐴌𐴝𐴑-𐴀𐴡𐴌-𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞 𐴊𐴠𐴙𐴑𐴧𐴞𐴥; <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />𐴇𐴠𐴥 𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴔𐴝𐴎𐴠𐴥𐴇𐴝𐴓𐴠 𐴔𐴡𐴕𐴞𐴐𐴧𐴡𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴇𐴡𐴕𐴧𐴗𐴝𐴤𐴒𐴧𐴗𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴒𐴟𐴌𐴝𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴓𐴝𐴔𐴁𐴝 𐴎𐴟𐴁𐴧𐴝 𐴉𐴞𐴕𐴊𐴝𐴤 𐴀𐴝𐴦𐴌 𐴏𐴞𐴥𐴕𐴝𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴐𐴟𐴥𐴕𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴝𐴄𐴧𐴞 𐴁𐴝𐴙𐴕𐴊𐴝𐴤. <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴏𐴟𐴓𐴢 𐴓𐴟𐴕 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴑𐴠𐴣𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴡𐴥𐴓𐴝, 𐴘𐴝𐴥𐴕𐴞 𐴁𐴡𐴌𐴡𐴥𐴉𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴉𐴟𐴥𐴀𐴃𐴢 𐴊𐴡𐴥𐴓𐴝; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴟𐴑 𐴑𐴟𐴥𐴕 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴎𐴞𐴓𐴇𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴉𐴝𐴃𐴝 𐴒𐴟𐴥𐴕 𐴒𐴟𐴄𐴒𐴟𐴙𐴄𐴧𐴝 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴉𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴟𐴌𐴝𐴃𐴢 𐴊𐴞 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴏𐴡𐴏𐴡𐴙𐴑𐴧𐴝 𐴉𐴞𐴃𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴁𐴞𐴐𐴞𐴤 𐴉𐴝𐴕𐴞𐴥𐴌 𐴇𐴡𐴓𐴇𐴡𐴓𐴝𐴕𐴞𐴌 𐴀𐴝𐴁𐴝𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴃𐴝𐴌𐴝 𐴊𐴡𐴥𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴟𐴘-𐴊𐴝𐴥𐴌𐴅𐴝 𐴊𐴝𐴥𐴌 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝 𐴉𐴟𐴌𐴝 𐴃𐴠𐴎𐴠 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴁𐴠𐴙𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝.<verse eid="REV 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17" />𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴀𐴛 𐴔𐴡𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴦𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘. 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴊𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴐𐴢! 𐴀𐴝𐴀𐴛 𐴀𐴝𐴖𐴝𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴑𐴠𐴥𐴌. </char> <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴎𐴞𐴕𐴊𐴝𐴖𐴝𐴤; 𐴀𐴝𐴀𐴛 𐴔𐴡𐴌𐴞𐴒𐴞𐴥𐴓𐴝𐴔𐴁𐴡𐴘, 𐴘𐴝𐴓𐴝 𐴏𐴝𐴀, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴞𐴤. 𐴔𐴡𐴦𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴃𐴝𐴓𐴉𐴟𐴌𐴡𐴌 𐴎𐴝𐴒𐴝𐴌 𐴏𐴝𐴁𐴞𐴤 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.</char> <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴞𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴡𐴥𐴏𐴢, 𐴎𐴞𐴀𐴕 𐴘𐴝𐴓𐴝 𐴀𐴡𐴥𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴀𐴕 𐴀𐴞𐴀𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴓𐴠𐴑𐴞𐴥𐴉𐴠𐴓𐴝.</char> <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" /><char style="wj">𐴃𐴟𐴘 𐴎𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴠𐴙𐴑𐴧𐴡𐴥𐴏𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴐𐴟𐴥𐴕𐴝𐴌 𐴇𐴝𐴥𐴣𐴃𐴧𐴝𐴕 𐴏𐴠𐴌𐴝𐴑-𐴀𐴡𐴌-𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴒𐴟𐴉𐴡𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝: 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴒𐴟𐴥𐴕, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴣𐴃𐴧𐴝𐴕 𐴏𐴠𐴌𐴝𐴑-𐴀𐴡𐴌-𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴟𐴕.“</char><verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s1">𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴢 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />
    <char style="wj">”𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴑:</char></para>
  <para style="p" vid="REV 2:1">
    <char style="wj">”𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴃𐴝𐴌𐴝 𐴊𐴡𐴥𐴌𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴐𐴟𐴥𐴕𐴝𐴌 𐴇𐴝𐴥𐴣𐴃𐴧𐴝𐴕 𐴏𐴠𐴌𐴝𐴑-𐴀𐴡𐴌-𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴔𐴝𐴎𐴠𐴥𐴇𐴝𐴓𐴠 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴀𐴕 𐴈𐴡𐴀𐴌: </char> <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴈𐴝𐴔, 𐴃𐴡𐴌 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴞. 𐴀𐴝𐴀𐴛 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴎𐴝𐴕𐴞 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴘 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴡𐴏𐴢 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴁𐴡𐴓𐴞 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴕𐴡, 𐴃𐴟𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴝𐴇𐴝𐴥𐴑𐴞𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥𐴏𐴢 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴞𐴏𐴝𐴥 𐴊𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴡𐴥𐴏𐴢. </char> <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" /><char style="wj">𐴃𐴡𐴌𐴃𐴧𐴟 𐴏𐴡𐴁𐴡𐴥𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴊𐴟𐴑 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴌𐴝𐴕 𐴕𐴡𐴥 𐴀𐴡𐴥𐴏𐴢. </char> <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴘𐴝𐴀𐴕 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴘 𐴃𐴡𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴡𐴏𐴢.</char> <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴁𐴝𐴥𐴉𐴞 𐴏𐴝𐴥 𐴃𐴟𐴘 𐴇𐴡𐴊𐴧𐴟𐴥𐴌𐴡𐴃𐴧𐴟 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴏𐴒𐴡𐴘. 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌, 𐴀𐴝𐴦𐴌 𐴈𐴝𐴔 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌 𐴎𐴞𐴀𐴕 𐴀𐴝𐴒𐴠 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴞; 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴎𐴡𐴊𐴞 𐴃𐴟𐴘 𐴃𐴡𐴖𐴝𐴥 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤𐴏𐴢, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴃𐴡𐴌 𐴏𐴠𐴌𐴝𐴑-𐴀𐴡𐴌-𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞 𐴒𐴝𐴥𐴕 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴎𐴝𐴒𐴝𐴃𐴧𐴟 𐴓𐴝𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴟𐴔. </char> <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴌𐴃𐴧𐴟 𐴘𐴝𐴀𐴕 𐴀𐴝𐴏𐴠𐴤: 𐴃𐴟𐴘 𐴕𐴞𐴑𐴡𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴏𐴢, 𐴎𐴞𐴀𐴕 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥. </char><verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />
    <char style="wj">”𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴠 𐴉𐴟𐴥𐴕𐴡, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠.</char></para>
  <para style="p" vid="REV 2:7">
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴒𐴝𐴏𐴡𐴌 𐴒𐴟𐴓𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴊𐴞𐴥𐴘𐴟𐴔, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴅𐴡𐴕𐴧𐴡𐴃𐴟𐴓𐴢-𐴉𐴠𐴥𐴌𐴡𐴊𐴟𐴏𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.</char><verse eid="REV 2:7" /></para>
  <para style="s1">𐴏𐴠𐴔𐴟𐴥𐴌𐴕𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />
    <char style="wj">”𐴏𐴠𐴔𐴟𐴥𐴌𐴕𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴑:</char></para>
  <para style="p" vid="REV 2:8">
    <char style="wj">”𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴖𐴝𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴑𐴠𐴥𐴌, 𐴎𐴞𐴁𐴝𐴤 𐴔𐴡𐴌𐴞𐴒𐴞𐴥𐴓𐴒𐴡𐴘 𐴀𐴝𐴦𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴀𐴕 𐴈𐴡𐴀𐴌: </char> <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌 𐴒𐴡𐴌𐴞𐴉𐴞 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴌𐴠 𐴎𐴝𐴕𐴞, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴠𐴐𐴡𐴥𐴑 𐴃𐴟𐴘 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌. 𐴀𐴝𐴀𐴛 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴑𐴟𐴉𐴠𐴥𐴌𐴞𐴌𐴠 𐴘𐴡𐴥 𐴎𐴝𐴕𐴞 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴈𐴡𐴀𐴘𐴢 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴊𐴡𐴓𐴢.</char> <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" /><char style="wj">𐴃𐴟𐴘 𐴎𐴠 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴙𐴐𐴢. 𐴉𐴟𐴥𐴕, 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴃𐴡𐴌𐴠𐴥 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴞𐴥𐴁𐴡 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴘 𐴊𐴡𐴐𐴢 𐴊𐴞𐴕 𐴉𐴝𐴥𐴕 𐴊𐴟𐴑 𐴉𐴝𐴘𐴁𐴞. 𐴔𐴡𐴦𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴞𐴐𐴢, 𐴃𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴃𐴝𐴏𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴞𐴦𐴘𐴟𐴔. </char><verse eid="REV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11" />
    <char style="wj">”𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴠 𐴉𐴟𐴥𐴕𐴡, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠. </char></para>
  <para style="p" vid="REV 2:11">
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌𐴡𐴌 𐴔𐴡𐴦𐴃𐴠 𐴇𐴡𐴥𐴃𐴞 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char><verse eid="REV 2:11" /></para>
  <para style="s1">𐴂𐴞𐴌𐴒𐴝𐴔𐴟𐴕 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />
    <char style="wj">”𐴂𐴞𐴌𐴒𐴝𐴔𐴟𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴑:</char></para>
  <para style="p" vid="REV 2:12">
    <char style="wj">”𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴊𐴟𐴘-𐴊𐴝𐴥𐴌𐴅𐴝 𐴊𐴝𐴥𐴌 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴀𐴕 𐴈𐴡𐴀𐴌. </char> <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" /><char style="wj">𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴃𐴟𐴘 𐴇𐴡𐴍𐴠𐴥 𐴃𐴝𐴥𐴑𐴡𐴏𐴢, 𐴃𐴟𐴘 𐴀𐴟𐴍𐴠𐴤 𐴃𐴝𐴥𐴑𐴡𐴏𐴢 𐴎𐴠𐴍𐴠𐴥 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴃𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴏𐴠𐴤; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴡𐴌𐴠 𐴊𐴡𐴌𐴡𐴤𐴒𐴡𐴌𐴞 𐴊𐴡𐴥𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴡𐴏𐴢, 𐴀𐴝𐴦𐴌 𐴎𐴠 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴒𐴡𐴁𐴝𐴤 𐴀𐴠𐴕𐴃𐴞𐴂𐴝𐴏𐴡𐴌𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴎𐴝𐴒𐴝𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴑𐴡𐴃𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴑𐴝𐴤 𐴀𐴠𐴌𐴞 𐴕𐴡𐴥 𐴊𐴡𐴥𐴏𐴢. </char> <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴇𐴡𐴦𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴏𐴠𐴤: 𐴃𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴝𐴓𐴝𐴔𐴡𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴠 𐴏𐴡𐴓𐴠, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴝𐴓𐴝𐴑𐴡𐴌𐴠 𐴐𐴞𐴥𐴑𐴝𐴘 𐴊𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴝𐴁𐴝𐴘 𐴁𐴡𐴓𐴧𐴝, 𐴘𐴝𐴥𐴕𐴞 𐴔𐴟𐴃𐴧𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴘𐴝 𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴝𐴥𐴁𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥 𐴁𐴝𐴘 𐴁𐴡𐴓𐴧𐴝.</char> <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" /><char style="wj">𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴃𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴥 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴑𐴡𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴠 𐴏𐴡𐴓𐴠.</char> <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌; 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴃𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴓𐴡𐴌 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴓𐴡𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔.</char><verse eid="REV 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17" />
    <char style="wj">”𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴠 𐴉𐴟𐴥𐴕𐴡, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠.</char></para>
  <para style="p" vid="REV 2:17">
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴝𐴥 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴕𐴧𐴝𐴥 𐴊𐴞𐴦𐴘𐴟𐴔. 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴊𐴡𐴥𐴓𐴝 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴀𐴡𐴥 𐴊𐴞𐴦𐴘𐴟𐴔, 𐴎𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴒𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴕𐴡𐴘𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴝𐴔 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴘𐴞𐴥𐴁𐴝 𐴉𐴝𐴘𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠.</char><verse eid="REV 2:17" /></para>
  <para style="s1">𐴃𐴟𐴖𐴝𐴃𐴞𐴥𐴌𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />
    <char style="wj">”𐴃𐴟𐴖𐴝𐴃𐴞𐴥𐴌𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴑:</char></para>
  <para style="p" vid="REV 2:18">
    <char style="wj">”𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝, 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴎𐴞𐴓𐴇𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴟𐴑 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴉𐴝𐴃𐴝 𐴏𐴡𐴏𐴡𐴙𐴑𐴧𐴝 𐴉𐴞𐴃𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴀𐴕 𐴈𐴡𐴀𐴌:</char> <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴈𐴝𐴔, 𐴃𐴡𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢, 𐴀𐴞𐴔𐴝𐴕, 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴞. 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌𐴡𐴤 𐴎𐴝𐴕𐴞 𐴊𐴠 𐴑𐴞, 𐴃𐴡𐴌 𐴘𐴝𐴓𐴝𐴌 𐴈𐴝𐴔 𐴀𐴝𐴒𐴠 𐴒𐴡𐴙𐴃𐴧𐴞𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤.</char> <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴘𐴝𐴀𐴕 𐴀𐴝𐴏𐴠𐴤: 𐴃𐴟𐴘 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴅𐴠𐴎𐴝𐴁𐴠𐴓𐴡𐴌𐴠 𐴈𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴡𐴥𐴏𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴔𐴁𐴞𐴘𐴝 𐴈𐴡𐴀, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴓𐴡𐴘 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴥𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴃𐴧𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴘𐴝 𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴝𐴥𐴀.</char> <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" /><char style="wj">𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞𐴃𐴧𐴟 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴑𐴝 𐴊𐴞𐴀𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴡𐴥 𐴏𐴝𐴀.</char> <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" /><char style="wj">𐴏𐴝𐴀, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴔𐴡𐴌 𐴁𐴞𐴏𐴝𐴥𐴕𐴝𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴟𐴔, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴟𐴔, 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥 𐴈𐴝𐴔𐴡𐴃𐴧𐴟 𐴃𐴡𐴖𐴝𐴥 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" /><char style="wj">𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴟𐴔, 𐴁𐴝𐴦𐴊𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴝𐴕𐴞𐴁𐴡𐴥 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴊𐴞𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴝𐴏𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴏𐴝𐴀. 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴁𐴡𐴊𐴡𐴓𐴝 𐴊𐴞𐴦𐴘𐴟𐴔. </char><verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴖𐴝𐴃𐴞𐴥𐴌𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴁𐴝𐴑𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴠 𐴕𐴡 𐴏𐴡𐴓𐴡, ’𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴔𐴟𐴌‘ 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴎𐴝𐴕𐴝 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴇𐴡𐴕𐴡𐴤 𐴉𐴟𐴣𐴎𐴝𐴤 𐴕𐴡 𐴊𐴞𐴦𐴘𐴟𐴔.</char> <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴀𐴛 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴞𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴊𐴡𐴥𐴌𐴞 𐴌𐴝𐴑𐴡𐴥.</char> <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴧𐴠𐴤 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴊𐴞𐴦𐴘𐴟𐴔;</char> <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴓𐴟𐴖𐴝𐴥𐴌 𐴓𐴡𐴍𐴞𐴥 𐴓𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴑𐴟𐴀𐴝𐴥𐴣𐴙𐴅𐴧𐴝𐴌 𐴔𐴠𐴙𐴄𐴧𐴝 𐴉𐴝𐴃𐴞𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴏𐴝𐴥𐴌 𐴔𐴝𐴥𐴌𐴞 𐴒𐴟𐴌𐴞𐴒𐴝𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴉𐴝𐴘𐴧𐴞𐴥;</char> <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴁𐴞𐴀𐴕𐴧𐴝𐴌 𐴏𐴟𐴥𐴃𐴢-𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴊𐴞𐴦𐴘𐴟𐴔.</char><verse eid="REV 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29" />
    <char style="wj">”𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴠 𐴉𐴟𐴥𐴕𐴡, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠!</char><verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s1">𐴏𐴝𐴥𐴌𐴊𐴞𐴏𐴢 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />
    <char style="wj">”𐴏𐴝𐴥𐴌𐴊𐴞𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴑:</char></para>
  <para style="pi1" vid="REV 3:1">
    <char style="wj">𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴌𐴟𐴀 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴃𐴝𐴌𐴝 𐴀𐴟𐴀𐴙𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴀𐴕 𐴈𐴡𐴀𐴌: 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴕𐴞, 𐴃𐴟𐴘 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴡𐴤𐴏𐴢 𐴁𐴡𐴥𐴓𐴞 𐴕𐴝𐴔 𐴀𐴝𐴏𐴠𐴤 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴘 𐴃𐴡 𐴔𐴡𐴌𐴝.</char> <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" /><char style="wj">𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴑, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴔𐴡𐴌𐴡𐴕-𐴔𐴡𐴌𐴡𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴡𐴉𐴟𐴌𐴝 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴞𐴥.</char> <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴘 𐴎𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴉𐴝𐴘𐴧𐴡𐴥𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴡𐴏𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴔𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌; 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴊𐴡𐴥𐴌 𐴀𐴝𐴦𐴌 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴃𐴟𐴘 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴕𐴡 𐴀𐴡𐴥𐴏𐴢, 𐴀𐴝𐴀𐴛 𐴏𐴟𐴌 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴘 𐴕𐴡 𐴎𐴝𐴕𐴞𐴁𐴞𐴥.</char><verse eid="REV 3:3" /></para>
  <para style="pi1">
    <verse number="4" style="v" sid="REV 3:4" />
    <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴝𐴥𐴌𐴊𐴞𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴃𐴡𐴌 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴦𐴌𐴡𐴌𐴠 𐴇𐴡𐴣𐴏𐴝𐴌𐴝 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴡𐴥𐴓𐴝 𐴉𐴟𐴐𐴝𐴥𐴑 𐴉𐴞𐴣𐴊𐴞𐴥 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑.</char> <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴧𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴊𐴡𐴥𐴓𐴝 𐴉𐴟𐴐𐴝𐴥𐴑 𐴉𐴞𐴕𐴊𐴝𐴤 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌 𐴕𐴝𐴔𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌-𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴧𐴟 𐴕𐴡 𐴁𐴟𐴥𐴎𐴝𐴘𐴧𐴟𐴔, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴥𐴃𐴝𐴌 𐴇𐴠𐴥 𐴕𐴝𐴔 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔.</char> <verse eid="REV 3:5" /><verse number="6" style="v" sid="REV 3:6" /><char style="wj">𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴠 𐴉𐴟𐴥𐴕𐴡, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠.</char><verse eid="REV 3:6" /></para>
  <para style="s1">𐴉𐴞𐴓𐴝𐴊𐴞𐴥𐴓𐴉𐴞𐴘𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />
    <char style="wj">”𐴉𐴞𐴓𐴝𐴊𐴞𐴥𐴓𐴉𐴞𐴘𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴑:</char></para>
  <para style="pi1" vid="REV 3:7">
    <char style="wj">𐴎𐴞𐴁𐴝𐴤 𐴂𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞, 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴏𐴝𐴁𐴞𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴑𐴟𐴥𐴓𐴞𐴓𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴕 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴑𐴟𐴥𐴓𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴀𐴕 𐴈𐴡𐴀𐴌:</char> <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴕𐴞. 𐴏𐴝𐴀, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴑𐴟𐴥𐴓𐴝 𐴊𐴡𐴌𐴡𐴎𐴝 𐴌𐴝𐴙𐴑𐴧𐴞𐴥 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠. 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴃𐴡𐴌𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴔 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴃𐴡𐴀 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤𐴏𐴢.</char> <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" /><char style="wj">𐴏𐴝𐴀, 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴊𐴡𐴓𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴈𐴡𐴀𐴘𐴢 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴞𐴏𐴝𐴥𐴑𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴁𐴝𐴥𐴘 𐴃𐴡𐴌 𐴉𐴡𐴦𐴃𐴢 𐴏𐴡𐴥𐴘𐴊𐴝 𐴉𐴡𐴌𐴝 𐴁𐴝𐴘𐴧𐴟𐴥𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴟𐴔 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥.</char> <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴘 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥𐴏𐴢, 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡𐴌𐴠𐴥 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴙𐴑𐴧𐴟𐴥𐴔, 𐴎𐴠 𐴀𐴡𐴑𐴃𐴡𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴏𐴠𐴤.</char><verse eid="REV 3:10" /></para>
  <para style="pi1">
    <verse number="11" style="v" sid="REV 3:11" />
    <char style="wj">𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴘𐴧𐴞𐴤𐴌; 𐴃𐴡𐴌𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴊𐴡𐴥𐴌𐴞 𐴌𐴝𐴑, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴡𐴌 𐴃𐴝𐴏𐴢 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴓𐴡𐴦𐴘𐴢 𐴕𐴡 𐴉𐴠𐴓𐴠.</char> <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴄𐴟𐴥𐴕𐴞 𐴁𐴝𐴕𐴝𐴘𐴧𐴟𐴥𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴁𐴝𐴀𐴌𐴠 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡. 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴓𐴠𐴑𐴞𐴥𐴘𐴟𐴔 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴝𐴔, 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴕𐴝𐴔, 𐴘𐴝𐴥𐴕𐴞 𐴕𐴡𐴘𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴖𐴝𐴀𐴕𐴡𐴌 𐴕𐴝𐴔 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴞𐴏𐴠 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴞𐴥𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴕𐴡𐴘𐴝 𐴕𐴝𐴔 𐴀𐴡𐴥 𐴓𐴠𐴑𐴞𐴥𐴘𐴟𐴔.</char> <verse eid="REV 3:12" /><verse number="13" style="v" sid="REV 3:13" /><char style="wj">𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴠 𐴉𐴟𐴥𐴕𐴡, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠.</char><verse eid="REV 3:13" /></para>
  <para style="s1">𐴓𐴝𐴀𐴟𐴥𐴊𐴞𐴑𐴞𐴘𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />
    <char style="wj">”𐴓𐴝𐴀𐴟𐴥𐴊𐴞𐴑𐴞𐴘𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴑:</char></para>
  <para style="pi1" vid="REV 3:14">
    <char style="wj">𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴦𐴔𐴞𐴕، 𐴎𐴞𐴁𐴝𐴤 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴡𐴁𐴝𐴤𐴊𐴡𐴘𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴒𐴟𐴙𐴅𐴧𐴝, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴀𐴕 𐴈𐴡𐴀𐴌,</char> <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴕𐴞, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴘 𐴕𐴡 𐴄𐴝𐴥𐴕𐴋𐴝 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴒𐴡𐴌𐴡𐴔. 𐴃𐴟𐴘 𐴕𐴡𐴀𐴘𐴓𐴠 𐴄𐴝𐴥𐴕𐴋𐴝 𐴀𐴡𐴥𐴘𐴃𐴞 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴒𐴡𐴌𐴡𐴔 𐴀𐴡𐴥𐴘𐴃𐴞 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴃𐴡.</char> <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" /><char style="wj">𐴃𐴟𐴘 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴔𐴝𐴎𐴠𐴥𐴇𐴝𐴓𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴕𐴡 𐴒𐴡𐴌𐴡𐴔 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴄𐴝𐴥𐴕𐴋𐴝, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴀𐴡𐴦𐴓𐴞 𐴊𐴞𐴘𐴟𐴔.</char> <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" /><char style="wj">𐴃𐴟𐴘 𐴈𐴡𐴀𐴏𐴢 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌, 𐴀𐴝𐴦𐴌 𐴊𐴡𐴥𐴕𐴞 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴞𐴒𐴡𐴘, 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴔𐴟𐴀𐴃𐴝𐴐𐴢 𐴕𐴡.“ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴘 𐴕𐴡 𐴎𐴝𐴕𐴡𐴏𐴢 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴘 𐴁𐴡𐴊𐴕𐴡𐴏𐴞𐴥𐴉𐴢 𐴀𐴡𐴓𐴝, 𐴊𐴟𐴑𐴧𐴞𐴥𐴃𐴝, 𐴒𐴡𐴌𐴞𐴉𐴢, 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴘𐴡𐴏𐴧𐴡𐴌.</char> <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴔𐴡𐴐𐴖𐴝𐴌𐴝 𐴊𐴞𐴌, 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴎𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴇𐴝𐴥𐴄𐴞 𐴐𐴟𐴥𐴕𐴝 𐴑𐴞𐴕، 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴘 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴡𐴏𐴢; 𐴉𐴞𐴣𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴊𐴡𐴥𐴓𐴝 𐴉𐴟𐴐𐴝𐴥𐴑 𐴑𐴞𐴕، 𐴎𐴠𐴀𐴕𐴠 𐴃𐴡𐴌 𐴁𐴞𐴘𐴡𐴏𐴧𐴡𐴌 𐴐𐴡𐴥𐴌𐴡𐴔𐴡𐴌𐴠 𐴒𐴟𐴥𐴌𐴞 𐴌𐴝𐴑𐴞𐴥 𐴉𐴝𐴌𐴡𐴏𐴢; 𐴏𐴟𐴑𐴡𐴃𐴢 𐴓𐴝𐴒𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴐𐴟𐴥𐴌𐴔𐴝 𐴑𐴞𐴕، 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴘 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴡𐴏𐴢.</char><verse eid="REV 3:18" /></para>
  <para style="pi1">
    <verse number="19" style="v" sid="REV 3:19" />
    <char style="wj">𐴀𐴝𐴀𐴛 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴡𐴓𐴃𐴞 𐴊𐴝𐴈𐴝𐴤𐴘 𐴊𐴞𐴥 𐴃𐴡𐴌𐴁𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴅𐴟𐴏𐴡𐴓𐴝 𐴀𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌.</char> <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" /><char style="wj">𐴏𐴝𐴀, 𐴀𐴝𐴀𐴛 𐴊𐴡𐴌𐴡𐴎𐴝𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴘 𐴊𐴡𐴌𐴡𐴎𐴝 𐴁𐴝𐴙𐴅𐴧𐴝𐴙𐴌, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴞 𐴊𐴡𐴌𐴡𐴎𐴝 𐴑𐴟𐴥𐴓𐴞𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴧𐴟𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴁𐴡.</char><verse eid="REV 3:20" /></para>
  <para style="pi1">
    <verse number="21" style="v" sid="REV 3:21" />
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴣𐴀𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴡𐴘𐴁𐴝𐴥𐴌 𐴇𐴡𐴥𐴑 𐴊𐴞𐴦𐴘𐴟𐴔, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴎𐴞𐴃𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴡𐴙𐴐𐴧𐴞𐴥.</char><verse eid="REV 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22" />
    <char style="wj">”𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴠 𐴉𐴟𐴥𐴕𐴡, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠.“</char><verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s1">𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴡𐴌𐴡𐴎𐴝 𐴑𐴟𐴥𐴓𐴝; 𐴀𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴀𐴝𐴀𐴛 𐴐𐴞𐴥𐴛𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴎𐴞𐴁𐴝𐴤𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴝𐴔 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠𐴍𐴠𐴥 𐴖𐴡𐴌𐴠 𐴀𐴝𐴘, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴟𐴔 𐴀𐴞𐴀𐴕 𐴁𐴝𐴦𐴊𐴠 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌.“ <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴑𐴡𐴁𐴎𐴝𐴃𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴞𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴃𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴕𐴧𐴗𐴝𐴤𐴒𐴧𐴗𐴝 𐴁𐴡𐴘𐴍𐴝𐴤. <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />𐴎𐴞𐴁𐴝𐴤 𐴇𐴠𐴥𐴍𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴅𐴝𐴏𐴂𐴝𐴌 𐴅𐴡𐴇𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴌𐴊𐴞𐴘𐴝𐴏𐴢 𐴅𐴡𐴇𐴝𐴥𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴡𐴏𐴡𐴙𐴑𐴧𐴝; 𐴇𐴠𐴥𐴍𐴠 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴡𐴥𐴕𐴟 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴠𐴔𐴠𐴌𐴝𐴓𐴋 𐴅𐴡𐴇𐴝𐴥𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴡𐴏𐴡𐴙𐴑𐴧𐴝. <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />𐴇𐴠𐴥 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴀𐴠𐴑𐴧𐴟𐴌𐴞 𐴏𐴝𐴙𐴌 𐴒𐴝𐴥𐴕 𐴃𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴇𐴠𐴥 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴊𐴡𐴥𐴓𐴝 𐴉𐴟𐴐𐴝𐴥𐴑 𐴉𐴞𐴕𐴊𐴝𐴤 𐴀𐴠𐴑𐴧𐴟𐴌𐴞 𐴏𐴝𐴙𐴌 𐴎𐴡𐴕 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴐𐴟𐴥𐴕𐴝𐴌 𐴃𐴝𐴏𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴁𐴞𐴅𐴞𐴓𐴞𐴌 𐴐𐴡𐴥𐴍𐴡𐴑, 𐴋𐴡𐴦𐴌 𐴓𐴝𐴒𐴠 𐴊𐴠 𐴀𐴝𐴁𐴝𐴏𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴄𐴝𐴥𐴍𐴝𐴓𐴢 𐴉𐴡𐴌𐴞𐴁𐴝𐴤𐴌 𐴔𐴝𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴇𐴝𐴥𐴣𐴃𐴧𐴝𐴕 𐴏𐴠𐴌𐴝𐴑 𐴎𐴡𐴓𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴥𐴣𐴃𐴢 𐴌𐴟𐴀. <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />𐴀𐴝𐴌𐴡𐴤, 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴘𐴕𐴝𐴌 𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴉𐴡𐴥𐴍𐴞𐴑𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴝𐴥𐴉𐴢.</para>
  <para style="p" vid="REV 4:6">𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴎𐴠𐴥𐴇𐴝𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴏𐴝𐴙𐴌𐴒𐴗𐴝𐴥 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴔𐴟𐴀𐴔 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴏𐴢 𐴏𐴟𐴑𐴠𐴤 𐴁𐴡𐴥𐴌𐴝𐴘𐴧𐴝. <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />𐴉𐴡𐴀𐴘𐴓𐴝 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴒𐴗𐴝𐴥 𐴐𐴞𐴥𐴚𐴒𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴒𐴗𐴝𐴥 𐴒𐴡𐴌𐴟𐴌-𐴏𐴡𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴒𐴗𐴝𐴥𐴃𐴧𐴟 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴞𐴘𐴝𐴥𐴌𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴏𐴝𐴙𐴌 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴒𐴗𐴝𐴥 𐴀𐴟𐴌𐴠 𐴊𐴠 𐴏𐴞𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />𐴇𐴠𐴥 𐴏𐴝𐴘𐴌𐴡𐴥 𐴖𐴝 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴃𐴧𐴟 𐴏𐴡𐴥 𐴖𐴝𐴕𐴡𐴌 𐴊𐴡𐴥𐴌𐴠 𐴉𐴝𐴑 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴟𐴑𐴠𐴤 𐴁𐴡𐴥𐴌𐴝𐴘𐴧𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴞𐴕𐴠 𐴌𐴝𐴘𐴃𐴠 𐴕𐴡 𐴎𐴞𐴌𐴝𐴘 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠,</para>
  <para style="b" vid="REV 4:8" />
  <para style="qc" vid="REV 4:8">”𐴂𐴝𐴑, 𐴂𐴝𐴑, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴖𐴝𐴓𐴝 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴓𐴧𐴝 𐴂𐴝𐴑,</para>
  <para style="qc" vid="REV 4:8">𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴏𐴠𐴤.“<verse eid="REV 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥-𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴠𐴥 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴒𐴟𐴥𐴕𐴠 𐴎𐴞𐴁𐴝𐴤 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝, 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴟𐴥𐴑𐴟𐴌 𐴒𐴡𐴌𐴠𐴥, <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴠𐴑𐴧𐴟𐴌𐴞 𐴏𐴝𐴙𐴌 𐴎𐴡𐴕 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴒𐴟𐴥𐴕𐴠 𐴎𐴞𐴁𐴝𐴤 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴏𐴡𐴥𐴘𐴊𐴝 𐴉𐴡𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴃𐴝𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴌𐴝𐴑𐴞𐴥 𐴈𐴡𐴀 𐴊𐴠,<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />”𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝,</para>
  <para style="q2" vid="REV 4:11">𐴃𐴟𐴀𐴛 𐴔𐴡𐴈𐴞𐴥𐴔𐴝, 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑,</para>
  <para style="q1" vid="REV 4:11">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴡 𐴃𐴟𐴀𐴛 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠,</para>
  <para style="q2" vid="REV 4:11">𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴡𐴕𐴐𐴝𐴥𐴘𐴠 𐴁𐴠 𐴄𐴞𐴑𐴞 𐴀𐴝𐴏𐴠𐴤 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴀𐴙𐴓𐴢.“<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s1">𐴑𐴞𐴃𐴝𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />𐴎𐴞𐴁𐴝𐴤 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴑𐴞𐴃𐴝𐴁𐴢 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠-𐴁𐴝𐴀𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴔𐴡𐴀𐴌 𐴓𐴡𐴥𐴘 𐴔𐴡𐴀𐴌 𐴓𐴝𐴒𐴝𐴘𐴧𐴝. <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴀𐴠𐴓𐴝𐴕 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴇𐴠𐴥 𐴔𐴡𐴀𐴌 𐴒𐴟𐴥𐴕 𐴑𐴟𐴥𐴓𐴞𐴉𐴠𐴓𐴝𐴘 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴑𐴟𐴥𐴓𐴞𐴁𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴏𐴡𐴤 𐴕𐴠𐴥؟“ <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴘𐴝𐴥 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴘𐴝𐴥 𐴉𐴝𐴃𐴝𐴓𐴉𐴟𐴌𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴉𐴝𐴦 𐴕𐴡𐴥 𐴎𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴑𐴟𐴥𐴓𐴞𐴁𐴝𐴌 𐴘𐴝𐴥 𐴘𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴝𐴘𐴁𐴝𐴥𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢. <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴈𐴝𐴣𐴊𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴑𐴟𐴥𐴓𐴞𐴁𐴝𐴌 𐴘𐴝𐴥 𐴘𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴝𐴘𐴁𐴝𐴥𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴉𐴝𐴦 𐴕𐴡𐴥 𐴎𐴝. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴒𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴎𐴡𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴕𐴡 𐴈𐴝𐴣𐴊𐴞𐴘𐴡𐴥; 𐴏𐴡𐴀, 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴌 𐴎𐴠 𐴐𐴞𐴥𐴚𐴒𐴡 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴐𐴞𐴥𐴛𐴡𐴌, 𐴀𐴞𐴥𐴁𐴝 𐴎𐴞𐴃𐴞𐴒𐴞𐴘𐴡𐴥𐴘; 𐴀𐴞𐴥𐴁𐴝 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴑𐴟𐴥𐴓𐴞𐴁𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴔𐴡𐴀𐴌 𐴒𐴟𐴥𐴕 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴝𐴘𐴁𐴝𐴥𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢.“<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴖𐴝 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴒𐴟𐴥𐴕𐴡𐴌 𐴔𐴝𐴎𐴠𐴥𐴇𐴝𐴓𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴏𐴝𐴘𐴃𐴠𐴥 𐴎𐴡𐴦𐴌𐴝𐴥𐴘𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠 𐴉𐴝𐴥𐴕. 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴃𐴧𐴝𐴕 𐴐𐴞𐴥𐴚 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴏𐴟𐴑 𐴀𐴝𐴏𐴠𐴤; 𐴏𐴟𐴑 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴌𐴟𐴀 𐴀𐴟𐴀𐴙𐴕 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠, 𐴎𐴞𐴁𐴝𐴤 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴓𐴡𐴘𐴧𐴠𐴥. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴓𐴡𐴦𐴘𐴢 𐴁𐴝𐴦𐴊𐴠, 𐴏𐴝𐴘𐴌𐴡𐴥 𐴖𐴝 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑𐴧𐴟𐴌𐴞 𐴏𐴝𐴙𐴌 𐴎𐴡𐴕 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴒𐴟𐴥𐴕𐴠 𐴇𐴠𐴥 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀𐴌 𐴖𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴏𐴡𐴥𐴘𐴊𐴝 𐴉𐴡𐴙𐴅𐴧𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴠𐴑𐴒𐴗𐴝𐴥-𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴁𐴞𐴕𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴒𐴡𐴥𐴌𐴁𐴝𐴃𐴧𐴞 𐴓𐴡𐴥𐴘 𐴁𐴡𐴥𐴌𐴝𐴘𐴧𐴝 𐴐𐴟𐴥𐴕𐴝𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴟𐴖𐴝. <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴕𐴡𐴘𐴝 𐴏𐴠𐴀𐴌 𐴒𐴝𐴘𐴧𐴠𐴥, 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴓𐴠𐴥,</para>
  <para style="q1" vid="REV 5:9">”𐴃𐴟𐴀𐴛 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴓𐴡𐴘𐴁𐴝𐴌</para>
  <para style="q2" vid="REV 5:9">𐴀𐴠𐴊𐴧𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴀𐴌 𐴒𐴟𐴥𐴕 𐴑𐴟𐴥𐴓𐴞𐴉𐴠𐴓𐴝𐴘𐴁𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑;</para>
  <para style="q1" vid="REV 5:9">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴃𐴡 𐴎𐴡𐴦𐴌𐴝𐴥𐴘𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴀𐴓𐴢,</para>
  <para style="q2" vid="REV 5:9">𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴕𐴞𐴎𐴡𐴌 𐴓𐴡𐴖𐴢 𐴓𐴡𐴘 𐴇𐴝𐴥𐴀𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕 𐴀𐴡𐴃𐴧𐴟, 𐴇𐴝𐴥𐴀𐴌 𐴎𐴟𐴁𐴝𐴕 𐴀𐴡𐴃𐴧𐴟, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴡𐴗𐴔𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴊𐴠𐴐𐴢 𐴀𐴡𐴃𐴧𐴟</para>
  <para style="q2" vid="REV 5:9">𐴀𐴝𐴓𐴧𐴝𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴑𐴞𐴕𐴧𐴡𐴥.<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴝𐴙𐴅𐴧𐴡 𐴁𐴝𐴕𐴝𐴘𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴔𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴔𐴝𐴔 𐴁𐴝𐴕𐴝𐴘𐴧𐴡𐴥;</para>
  <para style="q2" vid="REV 5:10">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.“<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴁𐴝𐴌 𐴏𐴝𐴘𐴧𐴞𐴥 𐴌𐴝𐴥𐴌, 𐴇𐴠𐴥 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕 𐴀𐴡𐴌𐴠, 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴒𐴞𐴥𐴌𐴞𐴊𐴡𐴙𐴅𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴎𐴞𐴀𐴕𐴡𐴌 𐴒𐴡𐴕𐴝 𐴓𐴝𐴑-𐴓𐴝𐴑, 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴄𐴞𐴥-𐴑𐴟𐴄𐴞𐴥; <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠,</para>
  <para style="q1" vid="REV 5:12">”𐴎𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌𐴠 𐴎𐴡𐴦𐴌𐴝𐴥𐴘𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴀𐴓𐴢,</para>
  <para style="q2" vid="REV 5:12">𐴀𐴞𐴥𐴁𐴝 𐴑𐴠𐴥𐴔𐴡𐴃𐴝, 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴢, 𐴒𐴞𐴘𐴝𐴕, 𐴃𐴝𐴦𐴑𐴡𐴃𐴢,</para>
  <para style="q2" vid="REV 5:12">𐴀𐴞𐴎𐴧𐴡𐴃𐴢, 𐴔𐴡𐴈𐴞𐴥𐴔𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴌𐴞𐴉𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑.“<verse eid="REV 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴊𐴠, 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴡𐴃𐴢, 𐴎𐴡𐴁𐴞𐴕 𐴀𐴡𐴃𐴢, 𐴉𐴝𐴃𐴝𐴓𐴉𐴟𐴌 𐴀𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴌𐴞𐴘𐴝𐴃𐴢 𐴎𐴠𐴊𐴟𐴥𐴕 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴝𐴥𐴕𐴞 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌,</para>
  <para style="q1" vid="REV 5:13">”𐴎𐴞𐴁𐴝𐴤 𐴇𐴠𐴥 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌</para>
  <para style="q2" vid="REV 5:13">𐴃𐴝𐴦𐴌𐴞𐴉𐴢, 𐴀𐴞𐴎𐴧𐴡𐴃𐴢, 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴦𐴏𐴃𐴌𐴞 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.“<verse eid="REV 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14" />𐴃𐴡𐴥𐴘 𐴏𐴝𐴘𐴌𐴡𐴥 𐴖𐴝 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴠 ”𐴀𐴝𐴦𐴔𐴞𐴕“ 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴒𐴟𐴥𐴕𐴠 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴌𐴞 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s1">𐴉𐴡𐴀𐴘𐴓𐴝 𐴔𐴡𐴀𐴌</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴘𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴔𐴡𐴀𐴌𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴔𐴡𐴀𐴌 𐴑𐴟𐴥𐴙𐴓𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴏𐴝𐴘𐴌𐴡𐴥 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴘𐴠 𐴄𐴝𐴥𐴍𐴝𐴓𐴡𐴌 𐴔𐴝𐴃𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, ”𐴀𐴝𐴘.“ <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴊𐴡𐴥𐴓𐴝 𐴒𐴟𐴥𐴌𐴝, 𐴘𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴁𐴝𐴤 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴃𐴞𐴌-𐴇𐴝𐴥𐴕𐴋𐴝 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴃𐴝𐴏𐴢 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴉𐴡𐴥𐴃𐴝 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴌𐴡𐴤 𐴉𐴡𐴥𐴃𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴌𐴡𐴖𐴝𐴕𐴝 𐴓𐴡𐴘𐴧𐴠𐴥.<verse eid="REV 6:2" /></para>
  <para style="s1">𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴀𐴌</para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴀𐴌𐴒𐴗𐴝𐴥 𐴑𐴟𐴥𐴙𐴓𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, ”𐴀𐴝𐴘.“ <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />𐴀𐴠𐴁𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴥𐴌𐴝 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴓𐴝𐴓𐴢. 𐴘𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴠𐴦 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴧𐴟 𐴐𐴝𐴥𐴕𐴃𐴞 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝. 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴋𐴡𐴣𐴀𐴌 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴀𐴡𐴥 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥.<verse eid="REV 6:4" /></para>
  <para style="s1">𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴀𐴌</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴀𐴌𐴒𐴗𐴝𐴥 𐴑𐴟𐴥𐴙𐴓𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, ”𐴀𐴝𐴘.“ 𐴃𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴇𐴝𐴓𐴝 𐴒𐴟𐴥𐴌𐴝, 𐴘𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴁𐴝𐴤 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴝𐴓𐴊𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴏𐴝𐴘𐴌𐴡𐴥 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴌 𐴔𐴝𐴎𐴡𐴥𐴃𐴧𐴟 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴞𐴑𐴧𐴝𐴥 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, ”𐴀𐴠𐴑 𐴐𐴠𐴥𐴌 𐴒𐴞𐴣𐴘𐴟𐴌 𐴊𐴝𐴔 𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌,<note caller="+" style="f"><char style="fr" closed="false">6‏:6 </char><char style="ft" closed="false">𐴊𐴞𐴕𐴝𐴥𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴌𐴡𐴔𐴞 𐴑𐴡𐴖𐴔𐴡𐴌 𐴄𐴞𐴛𐴝𐴌 𐴕𐴝𐴔; 𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌 𐴄𐴞𐴛𐴝 𐴀𐴠𐴑 𐴊𐴞𐴕𐴡𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴓𐴡𐴘 𐴁𐴡𐴌𐴝𐴁𐴡𐴌.</char></note> 𐴀𐴝𐴦𐴌 𐴃𐴞𐴕 𐴐𐴠𐴥𐴌 𐴁𐴝𐴌𐴓𐴞𐴥𐴌 𐴊𐴝𐴔 𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴠𐴓𐴢 𐴓𐴟𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴧𐴟𐴥𐴕 𐴓𐴟𐴏𐴧𐴝𐴥𐴕 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.“<verse eid="REV 6:6" /></para>
  <para style="s1">𐴏𐴝𐴙𐴌 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴔𐴡𐴀𐴌</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴏𐴝𐴙𐴌 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴔𐴡𐴀𐴌𐴒𐴗𐴝𐴥 𐴑𐴟𐴥𐴙𐴓𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴏𐴝𐴙𐴌 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, ”𐴀𐴝𐴘.“ <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />𐴃𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴊𐴟𐴥𐴀𐴟𐴐𐴧𐴝 𐴌𐴡𐴙𐴚𐴒𐴝 𐴒𐴟𐴥𐴌𐴝, 𐴘𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴁𐴝𐴤 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴦𐴃𐴢; 𐴉𐴝𐴃𐴝𐴓𐴉𐴟𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴑𐴟𐴌𐴠-𐴑𐴟𐴌𐴠 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴏𐴝𐴙𐴌 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴃𐴡𐴓𐴟𐴖𐴝𐴌, 𐴌𐴝𐴄𐴢, 𐴀𐴝𐴉𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴅𐴡𐴚𐴒𐴡𐴓𐴞 𐴅𐴝𐴕𐴟𐴖𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝.<verse eid="REV 6:8" /></para>
  <para style="s1">𐴉𐴝𐴣𐴏𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴔𐴡𐴀𐴌</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴝𐴣𐴏𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴔𐴡𐴀𐴌𐴒𐴗𐴝𐴥 𐴑𐴟𐴥𐴙𐴓𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴕𐴞𐴏𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴌𐴟𐴀 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠 𐴒𐴡𐴁𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴌𐴞 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴀𐴓𐴢; <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴂𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴔𐴝𐴁𐴟𐴊𐴢, 𐴃𐴟𐴀𐴛 𐴇𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴁𐴡𐴊𐴡𐴓𐴝 𐴕𐴡 𐴓𐴡𐴘𐴁𐴝؟“ <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴀𐴠𐴑𐴒𐴗𐴝𐴥-𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴊𐴡𐴥𐴓𐴝 𐴎𐴟𐴁𐴧𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴊𐴡𐴔𐴧𐴝𐴌𐴞 𐴁𐴡𐴓𐴧𐴝, 𐴎𐴠𐴃𐴟𐴥𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴒𐴟𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴎𐴠𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴕𐴡𐴥 𐴎𐴝.<verse eid="REV 6:11" /></para>
  <para style="s1">𐴏𐴡𐴥 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴔𐴡𐴀𐴌</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴏𐴡𐴥 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴔𐴡𐴀𐴌𐴒𐴗𐴝𐴥 𐴑𐴟𐴥𐴙𐴓𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴙𐴓𐴢 𐴓𐴝𐴕 𐴑𐴠𐴣𐴐𐴢 𐴓𐴡𐴘 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴏𐴝𐴥𐴓𐴝𐴌𐴐𐴡𐴄𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴇𐴝𐴓𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴒𐴟𐴣𐴍𐴝 𐴏𐴝𐴕 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴠𐴎𐴢 𐴁𐴡𐴘𐴧𐴝𐴌 𐴁𐴝𐴘𐴓𐴠𐴥 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴃𐴧𐴟 𐴑𐴠𐴦𐴣𐴏𐴝 𐴋𐴟𐴣𐴙𐴌 𐴒𐴟𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴥𐴌𐴞𐴎𐴝𐴒𐴡𐴘. <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />𐴀𐴝𐴏𐴔𐴝𐴕 𐴁𐴝𐴥𐴑 𐴀𐴡𐴥𐴘 𐴁𐴡𐴙𐴄𐴧𐴝 𐴇𐴝𐴁𐴡𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴁𐴡𐴍𐴞𐴒𐴞𐴘𐴡𐴥𐴘; 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴉𐴝𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴋𐴞𐴘𐴝 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴒𐴝𐴃𐴧𐴟 𐴓𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="REV 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 6:15" />𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝, 𐴋𐴡𐴣𐴀𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢, 𐴎𐴡𐴕𐴧𐴝𐴓𐴢, 𐴊𐴡𐴥𐴕𐴞, 𐴁𐴡𐴓𐴟𐴖𐴝𐴌, 𐴇𐴝𐴥𐴀𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴀𐴌𐴡𐴌 𐴒𐴝𐴣𐴃𐴠-𐴒𐴝𐴣𐴃𐴠 𐴀𐴠𐴊𐴧𐴠 𐴐𐴞𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴌𐴒𐴗𐴝𐴓𐴠-𐴀𐴝𐴌𐴒𐴗𐴝𐴓𐴠 𐴓𐴟𐴑𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴠; <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴝𐴀𐴌 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴐𐴞𐴥𐴓𐴢 𐴓𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴉𐴡𐴌𐴡, 𐴎𐴞𐴁𐴝𐴤 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴓𐴟𐴑𐴝𐴘𐴉𐴠𐴥𐴓𐴡, <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴕𐴝𐴎𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴋𐴡𐴣𐴀𐴌 𐴊𐴞𐴕 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴘𐴝𐴓𐴝 𐴀𐴝𐴌 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴞 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟“<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s1">144,000 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞𐴌𐴠 𐴔𐴡𐴀𐴌 𐴔𐴝𐴌𐴝 𐴒𐴞𐴘𐴠𐴥</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴏𐴝𐴙𐴌 𐴑𐴟𐴕𐴝𐴃𐴢 𐴏𐴝𐴙𐴌𐴒𐴗𐴝𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝, 𐴎𐴞𐴀𐴕𐴠 𐴏𐴝𐴘𐴌𐴡𐴥 𐴑𐴟𐴕𐴝𐴌 𐴁𐴡𐴘𐴧𐴝𐴌𐴡𐴌𐴠 𐴃𐴝𐴥𐴔𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴡𐴁𐴞𐴕 𐴀𐴡𐴃𐴢, 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴘𐴝𐴥 𐴇𐴡𐴕𐴡𐴤 𐴒𐴝𐴏𐴡𐴃𐴢 𐴁𐴡𐴘𐴧𐴝𐴌 𐴕𐴡 𐴁𐴝𐴀. <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴉𐴟𐴑 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴖𐴡𐴌𐴔𐴞𐴑𐴧𐴝𐴥 𐴀𐴟𐴍𐴞𐴤 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴀𐴌 𐴔𐴝𐴌𐴡𐴕𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴎𐴠 𐴏𐴝𐴙𐴌𐴒𐴗𐴝𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌𐴠 𐴎𐴡𐴁𐴞𐴕 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴙𐴅𐴧𐴝𐴌𐴠 𐴇𐴡𐴥𐴃𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴁𐴞𐴕، 𐴊𐴡𐴙𐴅𐴧𐴝 𐴘𐴝𐴥 𐴒𐴝𐴏𐴒𐴟𐴏𐴝𐴥𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴡𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴇𐴡𐴥𐴃𐴞 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴑𐴟𐴖𐴝𐴓𐴡𐴃𐴢 𐴔𐴡𐴀𐴌 𐴕𐴡𐴥 𐴔𐴝𐴌𐴞.“ <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴊𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴔𐴡𐴀𐴌 𐴔𐴝𐴌𐴝 𐴒𐴞𐴘𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴟𐴄𐴔𐴝𐴄𐴢 𐴀𐴠𐴑 𐴓𐴝𐴑 𐴏𐴝𐴓𐴞𐴐𐴢 𐴏𐴝𐴙𐴌 𐴀𐴝𐴥𐴎𐴝𐴌 𐴎𐴡𐴕, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕 𐴀𐴡𐴃𐴧𐴟:<verse eid="REV 7:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="REV 7:5" />𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴔𐴡𐴀𐴌 𐴔𐴝𐴌𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠,</para>
  <para style="li1" vid="REV 7:5">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴌𐴟𐴁𐴠𐴕𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠,</para>
  <para style="li1" vid="REV 7:5">𐴒𐴝𐴊𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠.<verse eid="REV 7:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="REV 7:6" />𐴀𐴝𐴐𐴠𐴌𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠,</para>
  <para style="li1" vid="REV 7:6">𐴕𐴝𐴉𐴄𐴝𐴓𐴞𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠,</para>
  <para style="li1" vid="REV 7:6">𐴔𐴝𐴕𐴝𐴏𐴠𐴥𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠.<verse eid="REV 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="REV 7:7" />𐴏𐴞𐴥𐴔𐴞𐴘𐴡𐴕𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠,</para>
  <para style="li1" vid="REV 7:7">𐴓𐴠𐴀𐴜𐴞𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠,</para>
  <para style="li1" vid="REV 7:7">𐴘𐴞𐴏𐴧𐴝𐴥𐴑𐴝𐴌𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠.<verse eid="REV 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="REV 7:8" />𐴎𐴠𐴁𐴟𐴓𐴟𐴕𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠,</para>
  <para style="li1" vid="REV 7:8">𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠,</para>
  <para style="li1" vid="REV 7:8">𐴁𐴞𐴕𐴘𐴝𐴔𐴞𐴕𐴡𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴡𐴌𐴠, 𐴔𐴡𐴀𐴌 𐴔𐴝𐴌𐴝 𐴒𐴞𐴘𐴠𐴥.<verse eid="REV 7:8" /></para>
  <para style="s1">𐴊𐴡𐴥𐴓𐴝 𐴉𐴟𐴐𐴝𐴥𐴑 𐴉𐴞𐴕𐴊𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴒𐴡𐴕𐴞 𐴑𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠; 𐴘𐴞𐴥𐴁𐴝𐴃𐴢 𐴇𐴝𐴥𐴀𐴌 𐴊𐴠𐴐𐴢 𐴀𐴡𐴌, 𐴇𐴝𐴥𐴀𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕 𐴀𐴡𐴌, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴡𐴗𐴔𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴎𐴟𐴁𐴝𐴕𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴡𐴥𐴓𐴝 𐴎𐴟𐴁𐴧𐴝 𐴉𐴞𐴕𐴊𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴇𐴝𐴥𐴎𐴟 𐴋𐴝𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴦𐴘𐴢 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠; <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="REV 7:10">”𐴕𐴠𐴅𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠</para>
  <para style="q1" vid="REV 7:10">𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴇𐴝𐴣𐴏𐴠.“<verse eid="REV 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 7:11" />𐴃𐴝𐴔𐴝𐴥𐴔 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕 𐴀𐴡𐴌𐴠, 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴒𐴟𐴥𐴕 𐴀𐴡𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴘𐴌𐴡𐴥 𐴎𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴌𐴠 𐴒𐴞𐴥𐴌𐴞 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢,</para>
  <para style="q1" vid="REV 7:12">”𐴀𐴝𐴦𐴔𐴞𐴕.</para>
  <para style="q1" vid="REV 7:12">𐴃𐴝𐴦𐴌𐴞𐴉𐴢, 𐴔𐴡𐴈𐴞𐴥𐴔𐴝,</para>
  <para style="q1" vid="REV 7:12">𐴒𐴞𐴘𐴝𐴕, 𐴐𐴟𐴥𐴑𐴟𐴌𐴝𐴕𐴝, 𐴀𐴞𐴎𐴧𐴡𐴃𐴢,</para>
  <para style="q1" vid="REV 7:12">𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴑𐴡𐴃𐴢</para>
  <para style="q1" vid="REV 7:12">𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.</para>
  <para style="q1" vid="REV 7:12">𐴀𐴝𐴦𐴔𐴞𐴕.“<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />𐴁𐴝𐴦𐴊𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴒𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴎𐴡𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴊𐴡𐴥𐴓𐴝 𐴎𐴟𐴁𐴧𐴝 𐴉𐴞𐴕𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴀𐴕 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤؟ 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠𐴥؟“<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />𐴀𐴝𐴀𐴛 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠, ”𐴅𐴡𐴕𐴝𐴁𐴢, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴃𐴟𐴀𐴛 𐴀𐴠𐴥𐴕𐴝 𐴎𐴝𐴕𐴡.“</para>
  <para style="p" vid="REV 7:14">𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴠𐴥; 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌 𐴎𐴟𐴁𐴧𐴝𐴌𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴓𐴡𐴖𐴢 𐴓𐴡𐴘 𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴝𐴘 𐴊𐴡𐴥𐴓𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="REV 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="REV 7:15" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴏𐴠𐴤;</para>
  <para style="q2" vid="REV 7:15">𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴊𐴞𐴕𐴠 𐴌𐴝𐴘𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥.</para>
  <para style="q1" vid="REV 7:15">𐴎𐴞𐴁𐴝𐴤 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q2" vid="REV 7:15">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴝𐴥𐴎𐴞𐴌𐴞 𐴓𐴡𐴥𐴘 𐴏𐴝𐴥𐴇𐴝𐴌𐴝 𐴊𐴞𐴁𐴡.<verse eid="REV 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 7:16" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴀𐴝𐴌 𐴁𐴟𐴥𐴑 𐴕𐴡 𐴓𐴝𐴒𐴞𐴁𐴡𐴥,</para>
  <para style="q2" vid="REV 7:16">𐴀𐴝𐴌 𐴃𐴞𐴌𐴝𐴥𐴐𐴢 𐴕𐴡 𐴓𐴝𐴒𐴞𐴁𐴡𐴥;</para>
  <para style="q1" vid="REV 7:16">𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌 𐴒𐴝𐴦𐴃𐴢 𐴕𐴡 𐴁𐴠𐴙𐴓𐴡𐴌 𐴃𐴠𐴎𐴢 𐴉𐴡𐴌𐴞𐴁𐴡𐴥,</para>
  <para style="q2" vid="REV 7:16">𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴒𐴡𐴌𐴡𐴔𐴠 𐴉𐴝𐴘𐴁𐴡,<verse eid="REV 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 7:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴎𐴠𐴥𐴇𐴝𐴓𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝</para>
  <para style="q2" vid="REV 7:17">𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌 𐴏𐴡𐴌𐴡𐴘𐴝 𐴀𐴡𐴥𐴘𐴁𐴡,</para>
  <para style="q1" vid="REV 7:17">𐴀𐴝𐴦𐴌 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴠𐴦 𐴊𐴠 𐴉𐴝𐴕𐴞𐴥𐴌 𐴎𐴡𐴥𐴕𐴧𐴝𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴓𐴡𐴘𐴎𐴝𐴘𐴁𐴡𐴥.</para>
  <para style="q1" vid="REV 7:17">𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌 𐴏𐴟𐴑𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴀𐴌 𐴏𐴟𐴑𐴡𐴌 𐴉𐴝𐴕𐴞𐴥 𐴉𐴟𐴣𐴏𐴞𐴥𐴊𐴞𐴁𐴡.“<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s1">𐴇𐴝𐴥𐴣𐴃𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴔𐴡𐴀𐴌</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴝𐴥𐴣𐴃𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴔𐴡𐴀𐴌𐴒𐴗𐴝𐴥 𐴑𐴟𐴥𐴙𐴓𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴀𐴝𐴊𐴝𐴤 𐴒𐴡𐴥𐴕𐴋𐴝 𐴀𐴝𐴥𐴕𐴞𐴑 𐴕𐴞𐴎𐴝𐴥𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="REV 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 8:2" />𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴎𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴑𐴠 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴞𐴥; 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴐𐴞𐴥𐴛𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥.<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴝𐴀𐴘𐴢 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠, 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴐𐴟𐴥𐴕𐴝𐴌 𐴀𐴝𐴒𐴡𐴥𐴌𐴁𐴝𐴃𐴧𐴞𐴌-𐴊𐴝𐴕𐴞 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴒𐴡𐴥𐴌𐴁𐴝𐴃𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴟𐴖𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴐𐴟𐴥𐴕𐴝𐴌 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴖𐴡𐴌𐴠 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠. <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴀𐴝𐴒𐴡𐴥𐴌𐴁𐴝𐴃𐴧𐴞𐴌 𐴊𐴟𐴥𐴖𐴝𐴣 𐴒𐴟𐴥𐴕 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴟𐴖𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴝𐴒𐴡𐴥𐴌𐴁𐴝𐴃𐴧𐴞𐴌-𐴊𐴝𐴕𐴞 𐴒𐴝𐴥𐴕 𐴓𐴡𐴦𐴘𐴧𐴡𐴌𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴀𐴡𐴦𐴙𐴕 𐴓𐴡𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴠𐴥, 𐴁𐴝𐴦𐴊𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴠; 𐴃𐴡𐴥𐴘 𐴇𐴠𐴥𐴍𐴠 𐴄𐴝𐴥𐴍𐴝𐴓𐴡𐴌 𐴔𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴦𐴌 𐴓𐴝𐴒𐴠 𐴊𐴠 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴥𐴕𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴞𐴅𐴞𐴓𐴞𐴌 𐴐𐴡𐴥𐴍𐴡𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="REV 8:5" /></para>
  <para style="s1">𐴐𐴞𐴥𐴛𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />𐴎𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴐𐴞𐴥𐴛𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴔𐴝𐴃𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />𐴉𐴡𐴀𐴘𐴓𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴓𐴡𐴖𐴢 𐴔𐴞𐴘𐴝𐴥𐴙𐴓𐴧𐴝 𐴐𐴞𐴥𐴓𐴢-𐴁𐴡𐴌𐴡𐴥𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴦𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠; 𐴃𐴡𐴥𐴘 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴘𐴡𐴥 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴎𐴡𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴒𐴝𐴏𐴒𐴟𐴏𐴝𐴥𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴎𐴡𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴥𐴙𐴓𐴢 𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴎𐴡𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴡𐴦𐴙𐴕 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴉𐴝𐴀𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥𐴌𐴠 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠; 𐴃𐴡𐴥𐴘 𐴊𐴡𐴙𐴅𐴧𐴝 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴓𐴡𐴖𐴢 𐴁𐴡𐴕𐴞𐴒𐴞𐴘𐴡𐴥𐴘, <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴎𐴝𐴀𐴣𐴏𐴢 𐴕𐴝𐴐𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴟𐴎𐴝𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴡𐴓𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴃𐴝𐴌𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴎𐴡𐴥𐴌𐴞 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴇𐴝𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥𐴌 𐴎𐴡𐴥𐴕𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />𐴇𐴠𐴥 𐴃𐴝𐴌𐴝 𐴖𐴝𐴌 𐴕𐴝𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, ”𐴎𐴡𐴇𐴡𐴥𐴌 𐴃𐴞𐴃𐴝.“ 𐴘𐴞𐴥𐴁𐴝 𐴉𐴡𐴌𐴞 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴉𐴝𐴕𐴞𐴥 𐴎𐴡𐴇𐴡𐴥𐴌 𐴃𐴞𐴃𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴉𐴝𐴕𐴞𐴥𐴌 𐴃𐴞𐴃𐴝𐴘𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />𐴏𐴝𐴙𐴌 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴁𐴠𐴙𐴓𐴡𐴌 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑𐴠, 𐴏𐴝𐴕𐴡𐴌 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑𐴠, 𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑𐴠 𐴀𐴠𐴀𐴕 𐴎𐴡𐴈𐴡𐴥𐴔 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴊𐴞𐴕𐴡𐴌 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴉𐴡𐴀𐴌 𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴌𐴝𐴙𐴃𐴡𐴌 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴀𐴡𐴥.<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />𐴏𐴝𐴘𐴃𐴠𐴥-𐴏𐴝𐴘𐴃𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴏𐴞𐴓𐴠 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴟𐴌𐴞-𐴀𐴟𐴌𐴞 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, ”𐴎𐴠 𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴞𐴁𐴝𐴥𐴌 𐴁𐴝𐴑𐴞 𐴃𐴝𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴇𐴞𐴥𐴀𐴕𐴡𐴓𐴧𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢, 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢, 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢.“<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />𐴉𐴝𐴣𐴏𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴃𐴝𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥; 𐴀𐴡𐴄𐴝𐴥𐴘 𐴒𐴝𐴣𐴃𐴡𐴌 𐴏𐴝𐴁𐴞𐴤 𐴖𐴝 𐴇𐴠𐴥 𐴃𐴝𐴌𐴝 𐴖𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴡𐴄𐴝𐴥𐴘 𐴒𐴝𐴣𐴃𐴧𐴗𐴝 𐴑𐴟𐴥𐴙𐴓𐴧𐴠, 𐴃𐴡𐴥𐴘 𐴇𐴠𐴥 𐴒𐴝𐴣𐴃𐴡𐴃𐴧𐴟 𐴖𐴡𐴌𐴠 𐴊𐴟𐴥𐴖𐴝𐴣 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴀𐴕 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕 𐴁𐴡𐴌 𐴉𐴡𐴦𐴙𐴕𐴡𐴃𐴧𐴟 𐴊𐴟𐴥𐴖𐴝𐴣 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴘𐴧𐴠𐴤; 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴒𐴝𐴣𐴃𐴡𐴌 𐴊𐴟𐴥𐴖𐴝𐴣𐴘𐴠 𐴁𐴠𐴙𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />𐴇𐴠𐴥 𐴊𐴟𐴥𐴖𐴝𐴣𐴃𐴧𐴟 𐴉𐴞𐴥𐴌𐴞𐴚 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴠𐴦𐴓𐴞 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴠𐴀𐴕 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴎𐴠 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴞𐴏𐴧𐴟𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝, 𐴇𐴡𐴕𐴡𐴤 𐴏𐴝𐴌𐴝 𐴘𐴝𐴥 𐴇𐴡𐴕𐴡𐴤 𐴒𐴝𐴏𐴡𐴌𐴠 𐴓𐴟𐴏𐴧𐴝𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴑𐴟𐴖𐴝𐴓𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴀𐴌 𐴕𐴝𐴥𐴘. <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴞𐴕 𐴊𐴞𐴘𐴝 𐴕𐴡𐴥 𐴎𐴝, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴉𐴝𐴣𐴏𐴢 𐴔𐴝𐴐𐴢 𐴉𐴝𐴥𐴕 𐴃𐴡𐴎𐴞𐴘𐴝 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥; 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴃𐴡𐴎𐴞𐴘𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴞𐴏𐴧𐴟𐴥𐴘𐴠 𐴐𐴟𐴥𐴔 𐴒𐴡𐴥𐴓𐴝𐴘 𐴊𐴞𐴓𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴊𐴟𐴑 𐴉𐴝𐴦. <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴔𐴡𐴦𐴃𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴉𐴝𐴘𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴙𐴃𐴧𐴡 𐴁𐴞𐴐𐴞𐴤 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴁𐴡𐴥 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴡𐴦𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴊𐴝𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />𐴉𐴞𐴥𐴌𐴞𐴚 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴟𐴥𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴓𐴝𐴌𐴝𐴥𐴘 𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴝𐴥; 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴐𐴟𐴥𐴕𐴝𐴌 𐴃𐴝𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴞𐴕𐴊𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴟𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴊𐴝𐴃𐴧𐴟𐴕 𐴐𐴞𐴥𐴚𐴒𐴡𐴌 𐴊𐴝𐴃𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴓𐴟𐴖𐴝𐴥𐴌 𐴎𐴝𐴔𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴝𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴉𐴝𐴑𐴡𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴝𐴌𐴝𐴥𐴙𐴃𐴢 𐴊𐴟𐴣𐴌𐴞 𐴎𐴝𐴦 𐴊𐴠 𐴁𐴞𐴐𐴞𐴤 𐴒𐴟𐴥𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴟𐴥𐴌𐴝-𐴒𐴝𐴌𐴞𐴥𐴌 𐴀𐴝𐴁𐴝𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴁𐴞𐴏𐴧𐴟𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴓𐴠𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴟𐴥𐴔 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴝𐴣𐴏𐴢 𐴔𐴝𐴐𐴢 𐴉𐴝𐴥𐴕 𐴊𐴟𐴑 𐴊𐴞𐴁𐴝𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴓𐴠𐴏𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴡𐴄𐴝𐴥𐴘 𐴒𐴝𐴣𐴃𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴕𐴝𐴔 𐴇𐴞𐴁𐴌𐴟𐴤 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴁𐴝𐴊𐴧𐴡𐴕<note caller="+" style="f"><char style="fr" closed="false">9‏:11 </char><char style="ft" closed="false">𐴇𐴞𐴁𐴌𐴟𐴤 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴁𐴝𐴊𐴧𐴡𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴝𐴥𐴓𐴝𐴑-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 </char></note>, 𐴀𐴝𐴦𐴌 𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴂𐴡𐴓𐴞𐴘𐴡𐴕.<note caller="+" style="f"><char style="fr" closed="false">9‏:11 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴂𐴡𐴓𐴞𐴘𐴡𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴇𐴝𐴥𐴓𐴝𐴑-𐴒𐴡𐴌𐴡𐴤𐴘𐴝</char></note><verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />𐴉𐴡𐴀𐴘𐴓𐴝 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴃𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴡𐴀, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌𐴡𐴤 𐴊𐴟𐴘𐴧𐴝𐴥𐴕 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴏𐴠𐴤.<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴏𐴡𐴥 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴐𐴟𐴥𐴕𐴝𐴌 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴐𐴞𐴥𐴚𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞. <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />𐴀𐴝𐴁𐴝𐴏𐴢 𐴏𐴗𐴝𐴥𐴘𐴠 𐴐𐴞𐴥𐴛𐴝 𐴀𐴡𐴓𐴝 𐴏𐴡𐴥 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴝𐴘𐴌𐴡𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴟𐴀𐴙𐴕𐴡𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴠, 𐴎𐴞𐴀𐴕 𐴁𐴡𐴌 𐴇𐴝𐴥𐴓𐴢 𐴀𐴠𐴉𐴟𐴌𐴝𐴃𐴡𐴃𐴢 𐴁𐴡𐴕 𐴀𐴝𐴏𐴠𐴤.“ <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />𐴃𐴡𐴥𐴘 𐴇𐴠𐴥 𐴏𐴝𐴘𐴌𐴡𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴀𐴠 𐴀𐴡𐴑𐴃𐴡𐴥, 𐴀𐴠 𐴊𐴞𐴕، 𐴀𐴠 𐴔𐴝𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴠. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />𐴒𐴟𐴥𐴌𐴝-𐴏𐴡𐴓𐴡𐴙𐴕𐴧𐴝 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴡𐴕𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴑𐴟𐴌𐴞 𐴑𐴟𐴄𐴞𐴥; 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴒𐴡𐴕𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞.<verse eid="REV 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 9:17" />𐴀𐴝𐴣𐴀𐴌 𐴊𐴡𐴌𐴐𐴡𐴥𐴕𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴀𐴝𐴀𐴛 𐴒𐴟𐴥𐴌𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴏𐴡𐴌𐴡𐴥𐴙𐴕𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥: 𐴏𐴡𐴌𐴡𐴥𐴙𐴕𐴧𐴝 𐴒𐴟𐴥𐴕𐴡𐴌 𐴎𐴝𐴔𐴝 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴓𐴝𐴓𐴢, 𐴕𐴞𐴥𐴓𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴌𐴟𐴏𐴢 𐴁𐴝𐴕𐴝 𐴊𐴠 𐴒𐴡𐴥𐴕𐴋𐴡𐴑𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴓𐴡𐴙𐴊𐴧𐴝. 𐴒𐴟𐴥𐴌𐴝 𐴒𐴟𐴥𐴕𐴡𐴌 𐴔𐴝𐴃𐴝𐴥 𐴒𐴟𐴥𐴕 𐴐𐴞𐴥𐴚𐴒𐴡𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴀𐴡𐴦𐴙𐴕، 𐴊𐴟𐴥𐴖𐴝𐴣 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴥𐴕𐴋𐴡𐴑 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴎𐴠 𐴀𐴡𐴦𐴙𐴕، 𐴊𐴟𐴥𐴖𐴝𐴣, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴥𐴕𐴋𐴡𐴑 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴇𐴠𐴥 𐴃𐴞𐴕𐴞𐴥 𐴀𐴝𐴉𐴡𐴃𐴠 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴟𐴥𐴌𐴝 𐴒𐴟𐴥𐴕𐴡𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴒𐴝𐴓𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴓𐴠𐴏𐴢 𐴀𐴡𐴃𐴢; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴓𐴠𐴏𐴢 𐴏𐴟𐴥𐴕 𐴔𐴝𐴃𐴝𐴥 𐴀𐴡𐴓𐴝 𐴇𐴝𐴥𐴉𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕 𐴓𐴡𐴥𐴘 𐴇𐴞𐴥𐴀𐴕𐴠 𐴇𐴡𐴥𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴇𐴠𐴥 𐴀𐴝𐴉𐴡𐴃𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴕𐴡𐴥 𐴎𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴅𐴞𐴕𐴞𐴥𐴐𐴡𐴃𐴧𐴟 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴠𐴓𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴐𐴟𐴥𐴕𐴝𐴌, 𐴌𐴟𐴉𐴝𐴌, 𐴉𐴞𐴃𐴡𐴓𐴢 𐴀𐴡𐴌, 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴀𐴡𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴝𐴏𐴡𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴔𐴟𐴃𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴟𐴣𐴎𐴝 𐴁𐴡𐴕 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥—𐴔𐴟𐴃𐴧𐴞 𐴎𐴞𐴀𐴕𐴠 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴠, 𐴕𐴡 𐴉𐴟𐴥𐴕𐴞 𐴉𐴝𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴝𐴥𐴣𐴍𐴞 𐴉𐴝𐴌𐴠. <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴡𐴃𐴡𐴥𐴓𐴝𐴑𐴡𐴃𐴡𐴥𐴓𐴞 𐴃𐴧𐴟, 𐴅𐴝𐴊𐴟𐴒𐴝𐴌𐴞 𐴃𐴧𐴟, 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞 𐴃𐴧𐴟, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴟𐴌𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴧𐴟 𐴘𐴡𐴥 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴠𐴓𐴠.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s1">𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴌𐴝 𐴑𐴞𐴃𐴝𐴁𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴀𐴞𐴥𐴁𐴝 𐴔𐴞𐴘𐴟𐴥𐴓𐴝 𐴉𐴞𐴕𐴊𐴝𐴤. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴊𐴡𐴥𐴕𐴟 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝 𐴁𐴠𐴙𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴄𐴠𐴥𐴚 𐴒𐴟𐴥𐴕 𐴀𐴡𐴦𐴘𐴕𐴞 𐴄𐴟𐴥𐴕𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴢. <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴌𐴝 𐴑𐴞𐴃𐴝𐴁𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴁𐴝𐴤 𐴑𐴟𐴥𐴙𐴓𐴧𐴝. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴠𐴕 𐴄𐴠𐴥𐴚 𐴒𐴝𐴥𐴕 𐴊𐴡𐴌𐴞𐴘𐴝𐴃𐴢 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴕 𐴄𐴠𐴥𐴚 𐴒𐴝𐴥𐴕 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴌𐴝𐴙𐴑𐴧𐴠𐴥; <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴒𐴟𐴎𐴡𐴌𐴝𐴕 𐴔𐴝𐴙𐴅𐴧𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴐𐴞𐴥𐴚𐴒𐴡𐴘𐴠 𐴔𐴝𐴌𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴟𐴎𐴡𐴌𐴝𐴕 𐴔𐴝𐴙𐴅𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴄𐴝𐴥𐴍𐴝𐴓𐴡𐴌 𐴔𐴝𐴃𐴢 𐴉𐴟𐴥𐴕𐴝 𐴒𐴞𐴥𐴘𐴠. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴄𐴝𐴥𐴍𐴝𐴓𐴡𐴌 𐴔𐴝𐴃𐴢 𐴉𐴟𐴥𐴕𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴀𐴛 𐴓𐴠𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴡𐴥𐴘𐴧𐴞, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴝𐴥𐴣𐴃𐴡 𐴖𐴝 𐴄𐴝𐴥𐴍𐴝𐴓𐴠 𐴎𐴞𐴀𐴕 𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴒𐴟𐴉𐴡𐴕 𐴌𐴝𐴑, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴕𐴡 𐴓𐴠𐴑𐴞𐴥𐴐𐴢.“<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />𐴎𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴧𐴝𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴃𐴟𐴙𐴓𐴧𐴠𐴥, <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />𐴀𐴝𐴦𐴌 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥𐴍𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴌𐴠, 𐴎𐴡𐴁𐴞𐴕 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥𐴍𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴌𐴠, 𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥𐴍𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴝𐴓𐴝 𐴀𐴝𐴌 𐴊𐴠𐴌𐴞 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡, <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴝𐴥𐴣𐴃𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴝𐴘𐴁𐴡𐴥 𐴊𐴠 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴉𐴡𐴕 𐴕𐴞𐴘𐴡𐴃𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴝𐴕𐴝𐴀𐴙𐴓𐴢.“<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴀𐴛 𐴎𐴞𐴁𐴝𐴤𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴝𐴔, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴦, 𐴎𐴝𐴘 𐴀𐴡 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴓𐴡𐴦𐴒𐴡𐴥𐴘, 𐴎𐴞𐴁𐴝𐴤 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴑𐴟𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤.“<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘 𐴒𐴟𐴌𐴝 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦 𐴁𐴡𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴞𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴞𐴁𐴝𐴤 𐴓𐴡𐴦𐴘𐴢 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴡; 𐴘𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴠𐴄𐴡𐴌𐴠 𐴃𐴞𐴃𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴝𐴓𐴡𐴃𐴢 𐴘𐴞𐴁𐴝𐴤𐴌𐴠 𐴔𐴡𐴊𐴟𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴞𐴍𐴝𐴤 𐴓𐴝𐴒𐴞𐴁𐴡𐴥.“ <verse eid="REV 10:9" /><verse number="10" style="v" sid="REV 10:10" />𐴃𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴒𐴟𐴌𐴝 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴗𐴝𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴓𐴡𐴦𐴘𐴢 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴞; 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴓𐴡𐴃𐴢 𐴔𐴡𐴊𐴟𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴞𐴍𐴝𐴤 𐴓𐴝𐴙𐴒𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴒𐴞𐴓𐴧𐴞𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴝𐴣𐴀𐴌 𐴉𐴠𐴄𐴢 𐴃𐴞𐴃𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴝𐴁𐴝𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴡𐴗𐴔, 𐴊𐴠𐴐𐴡𐴥𐴙𐴃𐴧𐴝, 𐴎𐴟𐴁𐴝𐴕 𐴀𐴡𐴓𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.“<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s1">𐴊𐴟𐴘 𐴎𐴡𐴕 𐴒𐴡𐴁𐴝𐴤</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴟𐴥𐴖𐴝𐴣𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴉𐴡𐴕𐴞𐴌 𐴓𐴡𐴍𐴞𐴥 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, ”𐴎𐴡𐴦, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣 𐴒𐴝𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴉𐴡𐴒𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴡𐴕𐴡𐴒𐴡𐴥𐴘. <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴎𐴠 𐴀𐴟𐴍𐴝𐴥𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴊𐴞𐴘𐴡; 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴕𐴡 𐴔𐴝𐴉𐴞𐴘𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠. 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴂𐴝𐴑 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕𐴡𐴌𐴠 𐴏𐴝𐴓𐴞𐴐𐴢-𐴊𐴟𐴘 𐴔𐴝𐴐𐴢 𐴉𐴝𐴥𐴕 𐴀𐴟𐴥𐴣𐴌𐴞𐴁𐴡. <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴒𐴡𐴁𐴝𐴤𐴌𐴠 𐴀𐴠𐴀𐴕 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴟𐴔, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴥𐴓𐴝𐴌𐴐𐴡𐴄𐴢 𐴉𐴞𐴣𐴊𐴞𐴥𐴘𐴡𐴌𐴠 𐴁𐴝𐴌𐴡𐴥 𐴐𐴡𐴥𐴀 𐴇𐴝𐴥𐴙𐴄𐴢 𐴊𐴞𐴕 𐴉𐴝𐴥𐴕 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.“ <verse eid="REV 11:3" /><verse number="4" style="v" sid="REV 11:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴡 𐴊𐴟𐴖𐴝𐴥 𐴎𐴝𐴘𐴃𐴟𐴕-𐴒𐴝𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡 𐴊𐴟𐴘𐴧𐴝𐴥𐴕 𐴏𐴠𐴌𐴝𐴑-𐴀𐴡𐴌-𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞, 𐴎𐴞𐴀𐴕 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴃𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴓𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴑𐴡𐴃𐴧𐴟 𐴀𐴡𐴦𐴙𐴕 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴃𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴔𐴡𐴌𐴝 𐴉𐴡𐴌𐴠. <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴔𐴝𐴕 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴎𐴡𐴥𐴌 𐴕𐴡 𐴊𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴝𐴕𐴞𐴥𐴌𐴠 𐴓𐴡𐴖𐴢 𐴁𐴝𐴕𐴝𐴘 𐴉𐴠𐴓𐴝𐴘𐴁𐴝𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴌𐴠 𐴎𐴠𐴃𐴡𐴥𐴁𐴝𐴌 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴇𐴠𐴥𐴃𐴡𐴁𐴝𐴌 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴉𐴡𐴃𐴢 𐴊𐴞 𐴇𐴡𐴥𐴃𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴥 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤.<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴝 𐴉𐴟𐴥𐴌𐴝𐴘𐴁𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴡𐴄𐴝𐴥𐴘 𐴒𐴝𐴣𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴁𐴡𐴥 𐴊𐴠 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴌𐴝𐴘 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡. <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴓𐴝𐴐𐴢 𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕𐴡𐴌 𐴌𐴝𐴏𐴃𐴝𐴃𐴢 𐴉𐴡𐴌𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴑𐴞𐴥𐴃𐴝𐴁𐴞 𐴕𐴝𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴡𐴥𐴊𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴅𐴞𐴤𐴂𐴢, 𐴎𐴠𐴍𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴘𐴡𐴥 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴀𐴓𐴢. <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />𐴇𐴝𐴥𐴀𐴌 𐴑𐴡𐴗𐴔 𐴀𐴡𐴌, 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕 𐴀𐴡𐴌, 𐴎𐴟𐴁𐴝𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴠𐴐𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴐𐴝𐴥𐴌𐴡 𐴃𐴞𐴕 𐴊𐴞𐴕 𐴉𐴝𐴥𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴓𐴝𐴐𐴢 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴓𐴝𐴐𐴢 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴢 𐴊𐴞𐴃𐴡 𐴕𐴡 𐴊𐴞𐴁𐴡. <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴔𐴠𐴓𐴝-𐴐𐴡𐴥𐴁𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴊𐴟𐴕𐴞𐴥 𐴕𐴡𐴁𐴞𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴝𐴓𐴝𐴀𐴙𐴓𐴢.<verse eid="REV 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴝𐴥𐴌𐴡 𐴃𐴞𐴕 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴎𐴝𐴕𐴡𐴌 𐴕𐴞𐴘𐴝𐴥𐴐𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴄𐴠𐴥𐴚𐴠 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴠. 𐴎𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠 𐴃𐴝𐴌𐴝𐴥 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠𐴍𐴠𐴥 𐴖𐴡𐴌𐴠 𐴀𐴝𐴘𐴧𐴡𐴤.“ 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴌𐴞 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴟𐴍𐴞𐴤𐴒𐴞𐴘𐴡𐴘, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴝𐴀𐴘𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="REV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 11:13" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕 𐴊𐴡𐴐𐴢 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. 𐴇𐴠𐴥 𐴁𐴟𐴥𐴏𐴝𐴓𐴠 𐴇𐴝𐴥𐴣𐴃𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴒𐴟𐴥𐴕𐴠 𐴋𐴡𐴦𐴌𐴝𐴘 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴃𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴡𐴀, 𐴘𐴝𐴓𐴝 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.<verse eid="REV 11:14" /></para>
  <para style="s1">𐴇𐴝𐴥𐴣𐴃𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴐𐴞𐴥𐴛𐴝</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴝𐴥𐴣𐴃𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="REV 11:15">”𐴘𐴝𐴓𐴝 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴌𐴝𐴙𐴅𐴧𐴡</para>
  <para style="q2" vid="REV 11:15">𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘;</para>
  <para style="q2" vid="REV 11:15">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.“<verse eid="REV 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 11:16" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴟𐴌𐴞 𐴏𐴝𐴙𐴌 𐴎𐴡𐴕 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢,</para>
  <para style="q1" vid="REV 11:17">”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴖𐴝𐴓𐴝 𐴑𐴟𐴥𐴊𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴏𐴡𐴤 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝,</para>
  <para style="q2" vid="REV 11:17">𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥𐴌,</para>
  <para style="q1" vid="REV 11:17">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴋𐴡𐴣𐴀𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴓𐴡𐴦𐴘𐴢</para>
  <para style="q2" vid="REV 11:17">𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴟𐴐𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠,</para>
  <para style="q2" vid="REV 11:18">𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠.</para>
  <para style="q1" vid="REV 11:18">𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌,</para>
  <para style="q2" vid="REV 11:18">𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴟𐴓𐴝𐴔 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠</para>
  <para style="q1" vid="REV 11:18">𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴋𐴡𐴣𐴀𐴌-𐴐𐴡𐴥𐴣𐴍𐴡 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔𐴡𐴌𐴠 𐴋𐴡𐴦𐴌𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴊𐴞𐴦𐴁𐴝𐴌,</para>
  <para style="q2" vid="REV 11:18">𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌.“<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴟𐴥𐴓𐴝𐴒𐴞𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴌 𐴏𐴡𐴥𐴕𐴊𐴟𐴑 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴊𐴝𐴈𐴝𐴤 𐴒𐴞𐴥𐴘𐴠. 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴞𐴅𐴞𐴓𐴞𐴌 𐴐𐴡𐴥𐴍𐴡𐴑, 𐴋𐴡𐴦𐴌 𐴓𐴝𐴒𐴠 𐴊𐴠 𐴀𐴝𐴁𐴝𐴏𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴄𐴝𐴥𐴍𐴝𐴓𐴡𐴌 𐴔𐴝𐴃𐴢 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴐𐴞𐴥𐴓𐴢-𐴁𐴡𐴌𐴡𐴥𐴉𐴢 𐴉𐴡𐴌𐴝𐴌 𐴃𐴟𐴖𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s1">𐴔𐴝𐴘𐴧𐴝𐴉𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴕𐴝𐴒𐴝𐴤</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴋𐴡𐴣𐴀𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴈𐴝𐴤 𐴒𐴞𐴥𐴘𐴠: 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴁𐴠𐴙𐴓𐴢 𐴉𐴞𐴕𐴊𐴝𐴤, 𐴇𐴞𐴥𐴁𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴃𐴡𐴓𐴠 𐴏𐴝𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴝𐴌𐴡𐴥 𐴖𐴝 𐴃𐴝𐴌𐴝 𐴀𐴡𐴓𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴃𐴝𐴏𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />𐴇𐴞𐴥𐴁𐴝 𐴇𐴝𐴥𐴔𐴞𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴖𐴝 𐴎𐴡𐴌𐴔𐴡 𐴊𐴞𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴌 𐴊𐴟𐴑𐴧𐴠𐴥 𐴒𐴟𐴎𐴡𐴌𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="REV 12:2" /><verse number="3" style="v" sid="REV 12:3" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴌𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴈𐴝𐴤 𐴒𐴞𐴥𐴘𐴠: 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴓𐴝𐴓𐴢 𐴕𐴝𐴒𐴝𐴤, 𐴘𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴔𐴝𐴃𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴐𐴞𐴥𐴚 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥 𐴒𐴟𐴥𐴕𐴡𐴃𐴢 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴃𐴝𐴏𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />𐴘𐴞𐴥𐴁𐴝𐴌 𐴓𐴠𐴏𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴃𐴝𐴌𐴝 𐴄𐴝𐴕𐴞 𐴀𐴝𐴕𐴞𐴤𐴘𐴡𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴠. 𐴇𐴠𐴥 𐴕𐴝𐴒𐴝𐴤 𐴖𐴝 𐴎𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴉𐴟𐴖𐴝 𐴎𐴡𐴌𐴔𐴡 𐴊𐴡𐴦𐴔-𐴊𐴡𐴦𐴔 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴡𐴌𐴔𐴡 𐴊𐴞𐴓𐴠𐴥 𐴔𐴡𐴃𐴧𐴡𐴌 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘 𐴉𐴝𐴌𐴠. <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴡𐴌𐴡𐴃𐴢 𐴉𐴟𐴖𐴝 𐴎𐴡𐴌𐴔𐴡 𐴊𐴞𐴘𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴓𐴟𐴖𐴝𐴥𐴌 𐴓𐴡𐴍𐴞𐴥 𐴓𐴡𐴥𐴘 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴇𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴏𐴟𐴥𐴓𐴝𐴕 𐴔𐴝𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴕𐴝𐴤 𐴒𐴞𐴥𐴘𐴠. <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴊𐴝𐴥𐴘𐴒𐴞𐴘𐴠𐴒𐴡𐴘, 𐴎𐴠𐴍𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴎𐴝𐴒𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥𐴍𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴝𐴌𐴡𐴥 𐴐𐴡𐴥 𐴇𐴝𐴥𐴙𐴄𐴢 𐴊𐴞𐴕 𐴉𐴝𐴥𐴕 𐴉𐴝𐴓𐴝 𐴎𐴝.<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴓𐴝𐴌𐴝𐴥𐴘 𐴀𐴡𐴥𐴘𐴧𐴠: 𐴔𐴝𐴘𐴑𐴠𐴓𐴠<note caller="+" style="f"><char style="fr" closed="false">12‏:7 </char><char style="ft" closed="false">𐴔𐴝𐴘𐴑𐴠𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴃𐴡𐴑𐴧𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝. </char></note> 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴝𐴒𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴕𐴝𐴒𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕𐴠 𐴕𐴡𐴥 𐴎𐴞𐴃𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴌 𐴎𐴝𐴒𐴝 𐴊𐴞𐴦𐴘𐴝 𐴕𐴡𐴥 𐴎𐴝. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />𐴇𐴠𐴥 𐴋𐴡𐴣𐴀𐴌 𐴕𐴝𐴒𐴝𐴤𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴉𐴟𐴌𐴝𐴕𐴝 𐴇𐴝𐴥𐴉𐴢 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝 𐴘𐴞𐴥𐴁𐴝 𐴌𐴠. 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴘𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠.<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="REV 12:10">”𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴠𐴅𐴝𐴃𐴢, 𐴃𐴝𐴦𐴑𐴡𐴃𐴢, 𐴌𐴝𐴙𐴅𐴧𐴡</para>
  <para style="q2" vid="REV 12:10">𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴇𐴝𐴥𐴎𐴞𐴌 𐴀𐴡𐴥𐴘𐴧𐴠,</para>
  <para style="q1" vid="REV 12:10">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴓𐴎𐴝𐴔-𐴓𐴝𐴒𐴡𐴘𐴝</para>
  <para style="q2" vid="REV 12:10">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴊𐴞𐴕𐴠 𐴌𐴝𐴘𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴓𐴎𐴝𐴔 𐴓𐴝𐴒𐴝𐴘𐴃𐴡𐴥,</para>
  <para style="q2" vid="REV 12:10">𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴃𐴡 𐴕𐴞𐴏𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠.<verse eid="REV 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 12:11" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀𐴌 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌</para>
  <para style="q2" vid="REV 12:11">𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴠 𐴊𐴞𐴀𐴓𐴢 𐴊𐴠 𐴒𐴡𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝</para>
  <para style="q2" vid="REV 12:11">𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥;</para>
  <para style="q1" vid="REV 12:11">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴡𐴦𐴃𐴡𐴌 𐴔𐴟𐴑𐴡𐴃𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝</para>
  <para style="q2" vid="REV 12:11">𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕𐴡𐴌𐴠 𐴀𐴝𐴊𐴡𐴌 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥.<verse eid="REV 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 12:12" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="q2" vid="REV 12:12">𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴑𐴡, 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤.</para>
  <para style="q1" vid="REV 12:12">𐴔𐴡𐴕𐴃𐴡𐴌, 𐴀𐴡𐴥 𐴎𐴡𐴁𐴞𐴕 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴙𐴅𐴧𐴝,</para>
  <para style="q2" vid="REV 12:12">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢,</para>
  <para style="q2" vid="REV 12:12">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴢 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴓𐴝𐴔𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.</para>
  <para style="q1" vid="REV 12:12">𐴀𐴞𐴥𐴃𐴠 𐴌𐴝𐴑𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠,</para>
  <para style="q2" vid="REV 12:12">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴄𐴝𐴙𐴔 𐴁𐴝𐴍𐴞𐴥 𐴊𐴠 𐴎𐴝𐴕𐴠.“<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴕𐴝𐴒𐴝𐴤 𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴞𐴥𐴁𐴝 𐴎𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴘𐴠 𐴔𐴡𐴌𐴡𐴃𐴢 𐴉𐴟𐴖𐴝 𐴎𐴡𐴌𐴔𐴡 𐴊𐴞𐴘𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴏𐴞𐴓𐴡𐴌 𐴊𐴟𐴘𐴧𐴝𐴥𐴕 𐴉𐴝𐴑 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴒𐴝 𐴖𐴝𐴀𐴕𐴡𐴃𐴢 𐴀𐴟𐴌𐴞 𐴎𐴝𐴘 𐴉𐴝𐴌𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴃𐴢 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴐𐴝𐴥𐴌𐴡 𐴃𐴞𐴕 𐴁𐴡𐴏𐴡𐴥𐴌 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴠𐴥 𐴇𐴝𐴥𐴉𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴕𐴡 𐴉𐴡𐴌𐴠 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴉𐴝𐴓𐴝 𐴎𐴝𐴘𐴁𐴡. <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴠𐴥 𐴇𐴝𐴥𐴉𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴉𐴝𐴕𐴞𐴥 𐴕𐴠𐴦𐴓𐴝𐴘 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴉𐴞𐴏𐴠𐴤 𐴇𐴝𐴥𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥 𐴉𐴝𐴕𐴞𐴥𐴁𐴝𐴕𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴝𐴥𐴐𐴝𐴘 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴁𐴞𐴕𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴎𐴡𐴁𐴞𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴓𐴢 𐴑𐴟𐴥𐴓𐴞 𐴇𐴝𐴥𐴓𐴢 𐴓𐴝𐴕𐴡𐴌 𐴉𐴝𐴕𐴞𐴥 𐴒𐴟𐴥𐴕 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴎𐴞𐴀𐴕 𐴕𐴝𐴒𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴕𐴠𐴓𐴝𐴀𐴓𐴢. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴠𐴥 𐴕𐴝𐴒𐴝𐴤 𐴖𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴓𐴧𐴡𐴘 𐴁𐴞𐴐𐴞𐴤 𐴌𐴝𐴑 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴡𐴘 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴒𐴞𐴦𐴘𐴡𐴥𐴘 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴞𐴘𐴝 𐴒𐴡𐴁𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴠.<verse eid="REV 12:17" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s1">𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />𐴇𐴠𐴥 𐴕𐴝𐴒𐴝𐴤 𐴖𐴝 𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴁𐴝𐴓𐴟𐴌 𐴏𐴡𐴌𐴡𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠.</para>
  <para style="p" vid="REV 13:1">𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴧𐴠𐴥𐴌; 𐴘𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴐𐴞𐴥𐴚 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴔𐴝𐴃𐴝𐴥 𐴀𐴝𐴏𐴠𐴤; 𐴘𐴞𐴥𐴁𐴝𐴌 𐴐𐴞𐴥𐴚 𐴒𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴊𐴡𐴐𐴧𐴗𐴝 𐴃𐴝𐴏𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥 𐴒𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴑𐴟𐴉𐴠𐴥𐴌𐴞𐴌 𐴕𐴝𐴔 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />𐴀𐴝𐴀𐴛 𐴎𐴠 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴗𐴝𐴥 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴘𐴞𐴥𐴁𐴝 𐴓𐴝𐴔𐴁𐴝-𐴁𐴝𐴒𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴞𐴥𐴁𐴝𐴌 𐴄𐴠𐴥𐴚 𐴒𐴟𐴥𐴕 𐴁𐴝𐴥𐴓𐴧𐴟𐴑𐴡𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴒𐴝𐴓𐴢 𐴓𐴝𐴕 𐴐𐴞𐴥𐴚𐴒𐴡𐴌 𐴒𐴝𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. 𐴕𐴝𐴒𐴝𐴤 𐴖𐴝𐴘𐴠 𐴇𐴠𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴢, 𐴕𐴞𐴎𐴡𐴌 𐴃𐴡𐴑𐴃𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴔𐴝𐴃𐴝𐴥 𐴒𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤𐴌𐴠 𐴏𐴝𐴘𐴃𐴠𐴥 𐴔𐴡𐴦𐴃𐴞 𐴎𐴡𐴈𐴡𐴥𐴔 𐴀𐴝𐴏𐴠𐴤 𐴉𐴝𐴥𐴕, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴔𐴡𐴦𐴃𐴞 𐴎𐴡𐴈𐴡𐴥𐴔 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘 𐴇𐴠𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴠; <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />𐴕𐴝𐴒𐴝𐴤 𐴖𐴝𐴘𐴠 𐴇𐴠𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴝𐴒𐴝𐴤 𐴖𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢, ”𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟ 𐴘𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴇𐴡𐴕𐴠 𐴓𐴝𐴌𐴝𐴥𐴘 𐴊𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟“<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />𐴇𐴠𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌𐴠 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴒𐴝𐴓𐴢 𐴔𐴝𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴑 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥; 𐴘𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴝𐴓𐴞𐴐𐴢 𐴊𐴟𐴘 𐴔𐴝𐴐𐴢 𐴉𐴝𐴥𐴕 𐴈𐴝𐴔 𐴏𐴡𐴓𐴝𐴘𐴁𐴝𐴥𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴉𐴝𐴘𐴧𐴠𐴥. <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />𐴃𐴡𐴥𐴘 𐴘𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴑 𐴑𐴟𐴥𐴙𐴓𐴧𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴀𐴡𐴌, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴥𐴏𐴃𐴝𐴕 𐴀𐴡𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴌𐴝𐴘𐴁𐴝𐴌. 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴡𐴗𐴔, 𐴇𐴝𐴥𐴀𐴌 𐴎𐴟𐴁𐴝𐴕 𐴀𐴡𐴓𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴊𐴠𐴐𐴡𐴥𐴙𐴃𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴘𐴡𐴥 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴕𐴝𐴔 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴎𐴡𐴦𐴌𐴝𐴥𐴘𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌-𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝.<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴠 𐴉𐴟𐴥𐴕𐴡.<verse eid="REV 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 13:10" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴡𐴕𐴊𐴞𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤,</para>
  <para style="q2" vid="REV 13:10">𐴀𐴞𐴥𐴃𐴠 𐴁𐴡𐴕𐴊𐴞𐴃𐴢 𐴎𐴝𐴘𐴁𐴡.</para>
  <para style="q1" vid="REV 13:10">𐴎𐴝𐴌𐴠𐴥 𐴃𐴡𐴓𐴟𐴖𐴝𐴌𐴠 𐴑𐴡𐴃𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤,</para>
  <para style="q2" vid="REV 13:10">𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴃𐴡𐴓𐴟𐴖𐴝𐴌𐴠 𐴑𐴡𐴃𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.</para>
  <para style="m" vid="REV 13:10">𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴏𐴡𐴁𐴡𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴑𐴝𐴤𐴌 𐴎𐴡𐴌𐴟𐴌.<verse eid="REV 13:10" /></para>
  <para style="s1">𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴧𐴠𐴥𐴌; 𐴘𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴊𐴟𐴘𐴧𐴝𐴥𐴕 𐴐𐴞𐴥𐴚 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴀𐴕 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀𐴌 𐴐𐴞𐴥𐴚𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴃𐴞𐴃𐴡𐴥 𐴊𐴠 𐴕𐴝𐴒𐴝𐴤𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />𐴘𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴉𐴟𐴌𐴝 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴘𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴠𐴥 𐴉𐴡𐴀𐴘𐴓𐴝 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴁𐴝𐴘𐴃𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴔𐴡𐴦𐴃𐴞 𐴎𐴡𐴈𐴡𐴥𐴔 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />𐴘𐴞𐴥𐴁𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴈𐴝𐴤𐴘𐴃𐴡, 𐴀𐴠𐴁𐴧𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴀𐴡𐴦𐴙𐴕 𐴕𐴝𐴎𐴞𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥. <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />𐴘𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴃𐴡𐴥, 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴟𐴀𐴙𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴉𐴡𐴀𐴘𐴓𐴝 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. 𐴘𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴠, 𐴎𐴠 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴗𐴝𐴥 𐴃𐴡𐴓𐴟𐴖𐴝𐴌𐴡𐴌 𐴎𐴡𐴈𐴡𐴥𐴔 𐴉𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡 𐴎𐴞𐴛𐴝𐴃𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴃𐴧𐴞 𐴁𐴝𐴕𐴝𐴘𐴃𐴡𐴥. <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴠𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴔𐴟𐴃𐴧𐴞 𐴖𐴝𐴌𐴠 𐴉𐴡𐴌𐴝𐴕 𐴊𐴞𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴘𐴡𐴥 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴔𐴟𐴃𐴧𐴞 𐴖𐴝𐴘𐴠 𐴔𐴝𐴃𐴞 𐴉𐴝𐴌𐴠 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥 𐴔𐴟𐴃𐴧𐴞𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴑𐴡𐴃𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴉𐴝𐴌𐴠. <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />𐴘𐴞𐴥𐴁𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴣𐴍𐴡, 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴒𐴡𐴌𐴞𐴉𐴢, 𐴁𐴠𐴒𐴟𐴓𐴝𐴔 𐴒𐴟𐴓𐴝𐴔, 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴘𐴝𐴥 𐴑𐴟𐴖𐴝𐴓𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴌 𐴊𐴡𐴥𐴌𐴠 𐴕𐴞𐴐𐴝𐴥𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴁𐴡𐴓𐴝𐴎𐴟𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />𐴎𐴠𐴀𐴕𐴠 𐴎𐴝𐴌 𐴖𐴡𐴌𐴠 𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴝𐴥𐴕𐴞 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴕𐴝𐴔 𐴘𐴝𐴥 𐴘𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔𐴡𐴌 𐴕𐴡𐴔𐴁𐴡𐴥𐴌 𐴓𐴝𐴒𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴠𐴏𐴝 𐴑𐴞𐴕𐴝 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠.<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />𐴘𐴝𐴀𐴕 𐴁𐴟𐴎𐴞𐴥𐴃𐴠 𐴒𐴞𐴘𐴝𐴕𐴡𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢. 𐴎𐴝𐴃𐴧𐴟 𐴁𐴟𐴊𐴧𐴞𐴥 𐴀𐴝𐴏𐴠𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴀𐴞𐴥𐴏𐴝𐴉𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴕𐴡𐴔𐴁𐴡𐴥𐴌; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥 𐴕𐴡𐴔𐴁𐴡𐴥𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 666.<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s1">144,000 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴏𐴠𐴀𐴌</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝 𐴏𐴞𐴥𐴘𐴡𐴕 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴠𐴑 𐴓𐴝𐴑 𐴏𐴝𐴓𐴞𐴐𐴢 𐴏𐴝𐴙𐴌 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴑𐴟𐴖𐴝𐴓𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴉𐴡𐴌 𐴕𐴝𐴔 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴎𐴞𐴁𐴝𐴤 𐴁𐴞𐴐𐴞𐴤 𐴉𐴝𐴕𐴞𐴥𐴌 𐴇𐴡𐴓𐴇𐴡𐴓𐴝𐴕𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴞 𐴔𐴝𐴃𐴠 𐴊𐴠 𐴄𐴝𐴥𐴍𐴝𐴓𐴡𐴌 𐴀𐴝𐴁𐴝𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. 𐴀𐴝𐴀𐴛 𐴎𐴠 𐴀𐴝𐴁𐴝𐴏𐴢 𐴏𐴗𐴝𐴥 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴘𐴞𐴥𐴁𐴝 𐴉𐴟𐴥𐴙𐴕𐴃𐴠 𐴁𐴞𐴕𐴝-𐴁𐴝𐴎𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴞𐴕𐴝 𐴁𐴝𐴀𐴌 𐴊𐴠 𐴀𐴝𐴁𐴝𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴓𐴝𐴙𐴒𐴧𐴠𐴥. <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕 𐴀𐴡𐴌, 𐴏𐴝𐴘𐴌𐴡𐴥 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴒𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴕𐴡𐴘𐴝 𐴏𐴠𐴀𐴌 𐴒𐴝𐴘𐴧𐴠𐴥. 𐴇𐴠𐴥 𐴏𐴠𐴀𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴐𐴞𐴥𐴑𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴠𐴥 𐴀𐴠𐴑 𐴓𐴝𐴑 𐴏𐴝𐴓𐴞𐴐𐴢 𐴏𐴝𐴙𐴌 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴧𐴟 𐴑𐴞𐴕𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠 𐴉𐴝𐴙𐴅𐴧𐴠𐴥. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴓𐴡𐴘 𐴔𐴞𐴓𐴔𐴞𐴓𐴝𐴁𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴝𐴉𐴝𐴑 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥 𐴁𐴡𐴥𐴓𐴑𐴠 𐴂𐴝𐴑 𐴌𐴝𐴙𐴑𐴧𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝 𐴎𐴠𐴍𐴠𐴥-𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴦 𐴇𐴠𐴥𐴍𐴠-𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴎𐴝𐴦. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕-𐴎𐴝𐴃𐴞𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴉𐴡𐴀𐴘𐴓𐴝 𐴉𐴡𐴥𐴏𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴓𐴧𐴝 𐴑𐴞𐴕𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌.<verse eid="REV 14:5" /></para>
  <para style="s1">𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴟𐴌𐴠𐴌, 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴝𐴥𐴕𐴞 𐴇𐴝𐴥𐴀𐴌 𐴊𐴠𐴐𐴡𐴥𐴙𐴃𐴧𐴝, 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕, 𐴎𐴟𐴁𐴝𐴕 𐴀𐴡𐴓𐴝 𐴀𐴠𐴊𐴧𐴠 𐴑𐴡𐴗𐴔𐴡𐴌 𐴇𐴝𐴣𐴏𐴠. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴋𐴡𐴦𐴌𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴏𐴔𐴝𐴕, 𐴎𐴡𐴁𐴞𐴕، 𐴊𐴡𐴙𐴅𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥𐴌 𐴎𐴡𐴥𐴕𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.“<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴖𐴝 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴀𐴌 𐴁𐴝𐴁𐴞𐴓𐴡𐴕 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞𐴌 𐴀𐴝𐴎𐴧𐴟𐴌 𐴐𐴡𐴥𐴌𐴝𐴁𐴢 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴝𐴥𐴀 𐴁𐴝𐴘𐴧𐴠𐴥.“<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />𐴇𐴠𐴥 𐴊𐴟𐴕𐴞𐴥 𐴖𐴝 𐴁𐴝𐴦𐴊𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴝𐴀𐴘𐴢 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴎𐴡𐴊𐴞 𐴇𐴠𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴃𐴧𐴞𐴌𐴠 𐴉𐴟𐴣𐴎𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴖𐴝𐴓𐴡𐴃𐴢 𐴘𐴝𐴥 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴘𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴐𐴧𐴝𐴤𐴌 𐴐𐴡𐴥𐴌𐴝𐴁𐴢 𐴈𐴝𐴥𐴘𐴁𐴡, 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴌 𐴉𐴞𐴘𐴝𐴓𐴝𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴔𐴞𐴘𐴝𐴥𐴓𐴢 𐴏𐴝𐴥𐴌𐴝 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴂𐴝𐴑 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴡𐴦𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴥𐴕𐴋𐴡𐴑 𐴓𐴡𐴥𐴘 𐴀𐴝𐴎𐴝𐴁𐴢 𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡. <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥 𐴀𐴝𐴎𐴝𐴁𐴡𐴌 𐴊𐴟𐴥𐴖𐴝𐴣 𐴖𐴡𐴌𐴔𐴞𐴑𐴧𐴝𐴥 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴟𐴍𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡. 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴗𐴝𐴥𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴃𐴧𐴞 𐴖𐴝𐴌𐴠 𐴉𐴟𐴣𐴎𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔𐴡𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴞𐴕𐴠 𐴌𐴝𐴘𐴃𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴌𐴝𐴔 𐴕𐴡 𐴉𐴝𐴘𐴁𐴡.“ <verse eid="REV 14:11" /><verse number="12" style="v" sid="REV 14:12" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴑𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴏𐴡𐴁𐴡𐴥𐴌 𐴃𐴝𐴥𐴑𐴝𐴌 𐴎𐴡𐴌𐴟𐴌.<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, ”𐴘𐴝𐴀𐴕 𐴓𐴠𐴑: 𐴘𐴝𐴓𐴝 𐴓𐴡𐴥𐴃𐴞 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴔𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴟𐴁𐴝𐴌𐴠𐴑!“</para>
  <para style="p" vid="REV 14:13">𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴌𐴝𐴔 𐴉𐴝𐴘𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴎𐴝𐴘𐴁𐴡.“<verse eid="REV 14:13" /></para>
  <para style="s1">𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴊𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴙𐴕𐴊𐴝</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴡𐴥𐴓𐴝 𐴔𐴞𐴘𐴟𐴥𐴓𐴝, 𐴇𐴠𐴥 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴖𐴡𐴌𐴠 𐴔𐴡𐴕𐴞𐴐𐴧𐴡𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴇𐴡𐴕𐴧𐴗𐴝𐴤𐴒𐴧𐴗𐴝 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴐𐴟𐴥𐴕𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴃𐴝𐴏𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴠𐴥𐴑𐴧𐴝𐴕 𐴊𐴝𐴥𐴌 𐴇𐴝𐴣𐴏𐴞 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴋𐴝𐴑 𐴔𐴝𐴌𐴞-𐴔𐴝𐴌𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢-𐴈𐴡𐴀𐴘𐴢, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴞 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴓𐴡𐴦𐴘𐴢 𐴊𐴝𐴘𐴉𐴠𐴥𐴓𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴙𐴕𐴊𐴝 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘; 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴃𐴡 𐴉𐴝𐴒𐴞𐴒𐴞𐴘𐴡𐴥𐴘.“ <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />𐴃𐴡𐴥𐴘 𐴎𐴞𐴁𐴝𐴤 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴞 𐴏𐴡𐴓𐴝𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴊𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴝𐴥𐴌 𐴇𐴝𐴣𐴏𐴞 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 14:17" /><verse number="18" style="v" sid="REV 14:18" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴃𐴧𐴟 𐴊𐴝𐴥𐴌 𐴇𐴝𐴣𐴏𐴞 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴋𐴝𐴥𐴑 𐴔𐴝𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴝𐴥𐴌 𐴇𐴝𐴣𐴏𐴞 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴚𐴒𐴟𐴌-𐴒𐴝𐴏𐴢<note caller="+" style="f"><char style="fr" closed="false">14‏:18 </char><char style="ft" closed="false">𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴀𐴝𐴚𐴒𐴟𐴌-𐴒𐴝𐴏𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.</char></note> 𐴏𐴗𐴝𐴥𐴃𐴧𐴟 𐴏𐴡𐴥𐴌𐴝 𐴒𐴟𐴥𐴕 𐴈𐴝𐴍𐴞 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴚𐴒𐴟𐴌 𐴉𐴝𐴒𐴞𐴒𐴞𐴘𐴡𐴥𐴘.“ <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />𐴃𐴡𐴥𐴘 𐴇𐴠𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴝𐴣𐴏𐴞 𐴒𐴝𐴥𐴕 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴏𐴡𐴓𐴝𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴚𐴒𐴟𐴌-𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥𐴃𐴧𐴟 𐴏𐴡𐴥𐴌𐴝 𐴒𐴟𐴥𐴕 𐴈𐴝𐴍𐴞 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠. 𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴕𐴠𐴦𐴓𐴝 𐴊𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴝𐴣𐴌𐴝𐴥𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴠, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴌 𐴒𐴝𐴣𐴌𐴝𐴥. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴇𐴠𐴥 𐴒𐴝𐴣𐴌𐴝𐴥 𐴖𐴝𐴃𐴢 𐴀𐴟𐴥𐴣𐴌𐴝 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴒𐴝𐴣𐴌𐴝𐴥𐴃𐴧𐴟 𐴀𐴠𐴊𐴟𐴥𐴕 𐴓𐴡𐴖𐴢 𐴕𐴠𐴦𐴙𐴓𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴇𐴞𐴥𐴀𐴕 𐴖𐴡𐴌𐴔𐴞𐴑𐴧𐴝𐴥 𐴒𐴟𐴥𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴠𐴈𐴝𐴕𐴡𐴌 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴀𐴟𐴙𐴄𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴌𐴠𐴥 𐴊𐴟𐴘 𐴐𐴡𐴥𐴃𐴢 𐴔𐴝𐴙𐴓𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴒𐴞𐴦𐴘𐴠𐴥.<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s1">𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴝𐴉𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴌𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴔𐴧𐴟𐴥𐴙𐴑𐴧𐴝: 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴇𐴝𐴥𐴣𐴃𐴧𐴝𐴕 𐴀𐴝𐴉𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴒𐴟𐴥𐴕, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴉𐴡𐴃𐴢 𐴇𐴞𐴥𐴀𐴕𐴠 𐴁𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴐𐴧𐴝𐴤 𐴉𐴟𐴥𐴌𐴝. <verse eid="REV 15:1" /><verse number="2" style="v" sid="REV 15:2" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴀𐴡𐴦𐴙𐴕 𐴔𐴞𐴘𐴝𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴘𐴕𐴝𐴌 𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴊𐴠𐴙𐴑𐴧𐴞𐴥; 𐴇𐴠𐴥 𐴀𐴝𐴘𐴕𐴝𐴌 𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴉𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴞𐴦𐴘𐴝 𐴁𐴞𐴕𐴝 𐴊𐴡𐴥𐴌𐴞 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴀𐴡𐴌𐴠, 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴃𐴧𐴞 𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔𐴡𐴌 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴔𐴟𐴀𐴏𐴝𐴌 𐴏𐴠𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀𐴌 𐴖𐴝𐴌 𐴏𐴠𐴀𐴌 𐴒𐴝𐴘𐴧𐴠𐴥, 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝,</para>
  <para style="q1" vid="REV 15:3">”𐴀𐴡𐴥 𐴔𐴝𐴁𐴟𐴊𐴢, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴖𐴝𐴓𐴝 𐴑𐴟𐴥𐴊𐴝,</para>
  <para style="q2" vid="REV 15:3">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴝𐴔 𐴇𐴡𐴃𐴡𐴥 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴦𐴌 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝!</para>
  <para style="q1" vid="REV 15:3">𐴀𐴡𐴥 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝,</para>
  <para style="q2" vid="REV 15:3">𐴇𐴡𐴃𐴡𐴥 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞 𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴌𐴝𐴏𐴃𐴝!<verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />𐴀𐴡𐴥 𐴔𐴝𐴁𐴟𐴊𐴢, 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴁𐴡𐴥 𐴊𐴠𐴥؟</para>
  <para style="q2" vid="REV 15:4">𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴊𐴠𐴥؟</para>
  <para style="q1" vid="REV 15:4">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴃𐴟𐴀𐴛 𐴁𐴠 𐴂𐴝𐴑.</para>
  <para style="q1" vid="REV 15:4">𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴀𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴏𐴡𐴥𐴘𐴊𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥,</para>
  <para style="q2" vid="REV 15:4">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠.“<note caller="+" style="f"><char style="fr" closed="false">15‏:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 111:2">𐴎𐴡𐴁𐴟𐴌 111‏:2</ref>‏,<ref loc="PSA 111:3">3</ref></char>; <char style="xt"><ref loc="DEU 32:4">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 32‏:4</ref></char>; <char style="xt"><ref loc="JER 10:7">𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝 10‏:7</ref></char>; <char style="xt"><ref loc="PSA 86:9">𐴎𐴡𐴁𐴟𐴌 86‏:9</ref>; <ref loc="PSA 98:2">98‏:2</ref></char>.</char></note><verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝 𐴒𐴝𐴥𐴕, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴥𐴎𐴞𐴌𐴞𐴌 𐴄𐴝𐴔𐴁𐴟 𐴒𐴝𐴥𐴕 𐴑𐴟𐴥𐴓𐴝𐴒𐴞𐴘𐴠, <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴟𐴀𐴙𐴕 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴎𐴞𐴀𐴕𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴃𐴧𐴝𐴕 𐴀𐴝𐴉𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴥𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴏𐴡𐴙𐴑𐴧𐴝 𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴝𐴤 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴞𐴥𐴕𐴝𐴃𐴢 𐴐𐴟𐴥𐴕𐴝𐴌 𐴉𐴝𐴄𐴧𐴞 𐴁𐴠𐴌𐴝𐴤𐴘𐴧𐴝. <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />𐴏𐴝𐴘𐴌𐴡𐴥 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴒𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤𐴘𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴐𐴟𐴥𐴕𐴝𐴌 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴘𐴝𐴓𐴝 𐴊𐴞𐴦𐴘𐴠𐴥; 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴐𐴧𐴝𐴤 𐴓𐴡𐴥𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝 𐴒𐴝𐴥𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴊𐴟𐴥𐴖𐴝𐴣 𐴓𐴡𐴥𐴘 𐴁𐴡𐴥𐴌𐴞𐴒𐴞𐴘𐴠𐴒𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴀𐴡𐴃𐴟𐴑𐴧𐴟𐴥𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴒𐴡𐴥𐴓𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠 𐴎𐴠𐴃𐴟𐴑𐴧𐴟𐴥𐴕 𐴇𐴝𐴥𐴣𐴃𐴡 𐴖𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴇𐴝𐴥𐴣𐴃𐴧𐴝𐴕 𐴀𐴝𐴉𐴡𐴃𐴧𐴟𐴕 𐴕𐴡𐴥 𐴉𐴟𐴥𐴌𐴝.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴌 𐴉𐴞𐴘𐴝𐴓𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴠𐴥 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴀𐴝𐴀𐴛 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴇𐴝𐴥𐴣𐴃𐴡 𐴖𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴦, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴇𐴝𐴥𐴣𐴃𐴡 𐴖𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴡𐴒𐴡𐴘.“<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />𐴃𐴡𐴥𐴘 𐴉𐴡𐴀𐴘𐴓𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝 𐴎𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴖𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠; 𐴁𐴝𐴦𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴒𐴝𐴦𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴇𐴡𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴢 𐴀𐴡𐴓𐴝 𐴀𐴠𐴑 𐴎𐴝𐴃𐴡𐴌 𐴒𐴝𐴥𐴀 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴃𐴧𐴞𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴖𐴝 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠; 𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴡𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴓𐴡𐴖𐴢 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴡𐴖𐴢 𐴁𐴡𐴕𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴖𐴝 𐴇𐴝𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥𐴌 𐴎𐴡𐴥𐴕𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠; 𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴖𐴢 𐴁𐴡𐴕𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴊𐴠, 𐴉𐴝𐴕𐴞𐴥𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌,</para>
  <para style="q1" vid="REV 16:5">”𐴀𐴡𐴥 𐴂𐴝𐴑𐴎𐴡𐴕, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴏𐴡𐴤 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝,</para>
  <para style="q2" vid="REV 16:5">𐴃𐴟𐴀𐴛 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴖𐴝𐴓𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴀𐴞𐴀𐴕𐴡𐴌 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥;<verse eid="REV 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 16:6" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌</para>
  <para style="q2" vid="REV 16:6">𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴡𐴖𐴢 𐴁𐴝𐴥𐴐𐴝𐴘𐴧𐴠,</para>
  <para style="q1" vid="REV 16:6">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴓𐴡𐴖𐴢 𐴈𐴝𐴥𐴀 𐴁𐴝𐴘𐴧𐴡𐴥;</para>
  <para style="q1" vid="REV 16:6">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑.“<verse eid="REV 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 16:7" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴊𐴠, 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴌,</para>
  <para style="q1" vid="REV 16:7">”𐴀𐴡𐴥𐴘, 𐴀𐴡𐴥 𐴔𐴝𐴁𐴟𐴊𐴢, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴖𐴝𐴓𐴝 𐴑𐴟𐴥𐴊𐴝,</para>
  <para style="q2" vid="REV 16:7">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴞𐴏𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴦𐴌 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞.“<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />𐴏𐴝𐴙𐴌 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴖𐴝 𐴁𐴠𐴙𐴓𐴡𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴡𐴦𐴙𐴕 𐴓𐴡𐴘 𐴉𐴟𐴌𐴝𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴡𐴔𐴡𐴌 𐴃𐴠𐴎𐴠 𐴎𐴡𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴝𐴔𐴡𐴌 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴇𐴠𐴥 𐴀𐴝𐴉𐴡𐴃𐴧𐴟𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡𐴖𐴝𐴥 𐴘𐴡𐴥 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴘𐴡𐴥 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴉𐴝𐴣𐴏𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴖𐴝 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴡𐴑𐴡𐴓𐴞𐴉𐴠 𐴎𐴞𐴌 𐴇𐴡𐴦𐴣𐴌𐴞 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴃𐴡𐴑𐴡𐴓𐴞𐴉𐴠 𐴀𐴠𐴊𐴧𐴠 𐴒𐴝𐴥𐴀 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴝𐴔𐴡𐴃𐴧𐴟 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴠𐴓𐴠.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />𐴏𐴡𐴥 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴖𐴝 𐴁𐴡𐴌 𐴇𐴝𐴥𐴓𐴢 𐴀𐴠𐴉𐴟𐴌𐴝𐴃𐴡𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠; 𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴝𐴕𐴞𐴥 𐴒𐴟𐴥𐴕 𐴉𐴟𐴥𐴖𐴝𐴘𐴒𐴞𐴘𐴡𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴉𐴟𐴑 𐴑𐴟𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴌𐴝𐴏𐴃𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴡𐴥. <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴁𐴠𐴚𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴕𐴝𐴉𐴝𐴑 𐴌𐴟𐴀 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴧𐴠𐴥𐴌, 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴕𐴝𐴒𐴝𐴤𐴌 𐴒𐴝𐴓𐴢 𐴀𐴡𐴃𐴧𐴟, 𐴀𐴝𐴌 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴒𐴝𐴓𐴢 𐴀𐴡𐴃𐴧𐴟, 𐴀𐴝𐴌 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡𐴁𐴞𐴌 𐴒𐴝𐴓𐴢 𐴀𐴡𐴃𐴧𐴟. <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴌𐴟𐴀 𐴎𐴞𐴀𐴕𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴈𐴝𐴤. 𐴇𐴞𐴥𐴀𐴕 𐴕𐴠𐴦𐴓𐴞 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴖𐴝𐴓𐴝 𐴑𐴟𐴥𐴊𐴝𐴌 𐴋𐴡𐴣𐴀𐴌 𐴊𐴞𐴕𐴡𐴌 𐴓𐴝𐴌𐴝𐴥𐴘 𐴓𐴧𐴝 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝.<verse eid="REV 16:14" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="15" style="v" sid="REV 16:15" />
    <char style="wj">”𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴏𐴟𐴌 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴀𐴝𐴘𐴧𐴞𐴤𐴌. 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴠 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴞𐴥 𐴃𐴝𐴥𐴑𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴁𐴞𐴘𐴡𐴏𐴧𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴠 𐴁𐴠𐴌𐴝 𐴕𐴡 𐴉𐴡𐴌𐴠 𐴀𐴝𐴦𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴡𐴥𐴌𐴡𐴔 𐴕𐴡 𐴊𐴠𐴑𐴠𐴥.“</char><verse eid="REV 16:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴝𐴒𐴝 𐴖𐴝𐴀𐴕𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴇𐴞𐴁𐴌𐴟𐴤 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴧𐴟 𐴇𐴝𐴌𐴔𐴝𐴒𐴞𐴊𐴡𐴕 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀.<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴇𐴝𐴥𐴣𐴃𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴖𐴝 𐴁𐴡𐴘𐴧𐴝𐴌𐴡𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝 𐴒𐴝𐴥𐴕𐴡𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.“ <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴞𐴅𐴞𐴓𐴞𐴌 𐴐𐴡𐴥𐴍𐴡𐴑 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴋𐴡𐴦𐴌 𐴓𐴝𐴒𐴠 𐴊𐴠 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴄𐴝𐴥𐴍𐴝𐴓𐴢 𐴉𐴡𐴌𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠; 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴞𐴕𐴏𐴝𐴥𐴕-𐴎𐴝𐴃𐴞 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴇𐴡𐴕𐴡𐴤 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴘𐴞𐴥𐴁𐴝 𐴇𐴠𐴥𐴃𐴧𐴡𐴌 𐴋𐴡𐴣𐴀𐴌 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴞𐴤 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝. <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕 𐴃𐴞𐴕 𐴁𐴝𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴡𐴥𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴀𐴌 𐴁𐴝𐴁𐴞𐴓𐴡𐴕𐴡𐴌𐴠 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴞𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴟𐴐𐴧𐴝𐴤𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴌 𐴐𐴡𐴥𐴌𐴝𐴁𐴢 𐴓𐴡𐴥𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴉𐴞𐴘𐴝𐴓𐴝 𐴈𐴝𐴥𐴀 𐴁𐴝𐴘𐴧𐴠𐴥. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />𐴇𐴝𐴥𐴀𐴌 𐴋𐴞𐴘𐴝 𐴒𐴝𐴙𐴁𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴡𐴍𐴠𐴥 𐴒𐴞𐴦𐴘𐴡𐴥𐴘. <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴔𐴡𐴕-𐴔𐴡𐴕 𐴀𐴟𐴎𐴡𐴥𐴕 𐴀𐴡𐴓𐴝 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴐𐴞𐴥𐴓𐴢-𐴁𐴡𐴌𐴡𐴥𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴉𐴡𐴌𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥 𐴐𐴞𐴥𐴓𐴢-𐴁𐴡𐴌𐴡𐴥𐴉𐴡𐴌 𐴀𐴝𐴉𐴡𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴀𐴝𐴉𐴡𐴃𐴢 𐴃𐴝𐴥𐴕 𐴁𐴞𐴐𐴞𐴤 𐴇𐴡𐴥𐴃𐴝𐴌𐴕𐴝𐴑.<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s1">𐴔𐴡𐴐𐴟𐴥𐴌 𐴔𐴝𐴒𐴞𐴕𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />𐴎𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴘𐴝𐴓𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴉𐴝𐴕𐴞𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴠𐴥 𐴋𐴡𐴣𐴀𐴌 𐴔𐴝𐴒𐴞𐴕𐴞𐴌 𐴏𐴝𐴥𐴣𐴎𐴝 𐴑𐴞𐴦 𐴊𐴠 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴟𐴔, <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />𐴎𐴞𐴁𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞𐴌 𐴐𐴡𐴥𐴌𐴝𐴁𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴄𐴟𐴀𐴓𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘.“<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴇𐴠𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴌𐴟𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴌𐴞 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥. 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴑𐴞𐴌𐴔𐴞𐴏𐴢 𐴌𐴡𐴙𐴚𐴒𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴑𐴟𐴉𐴠𐴥𐴌𐴞𐴌 𐴕𐴝𐴔 𐴓𐴡𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴔𐴝𐴃𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴐𐴞𐴥𐴚 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />𐴇𐴠𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴁𐴝𐴘𐴡𐴙𐴕𐴧𐴝 𐴌𐴡𐴚𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴞𐴌𐴔𐴞𐴏𐴢 𐴌𐴡𐴚𐴡𐴌 𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴝𐴤, 𐴀𐴝𐴦𐴌 𐴐𐴟𐴥𐴕𐴝, 𐴑𐴞𐴔𐴡𐴃𐴞 𐴅𐴡𐴇𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴑𐴃𐴝 𐴓𐴡𐴘 𐴇𐴝𐴥𐴣𐴎𐴝𐴘𐴧𐴝. 𐴇𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴐𐴟𐴥𐴕𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴞𐴘𐴝𐴓𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴒𐴞𐴥𐴕𐴝𐴘𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞𐴌 𐴕𐴝𐴉𐴝𐴑𐴞 𐴓𐴡𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝. <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />𐴇𐴞𐴥𐴁𐴝𐴌 𐴑𐴟𐴖𐴝𐴓𐴡𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴒𐴟𐴉𐴡𐴕 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴓𐴝 𐴕𐴝𐴔 𐴘𐴝𐴀𐴕 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤, ”𐴋𐴡𐴣𐴀𐴌 𐴁𐴝𐴁𐴞𐴓𐴡𐴕, 𐴔𐴝𐴒𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴒𐴞𐴥𐴕𐴝𐴘𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴝𐴦.“<verse eid="REV 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 17:6" />𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴇𐴠𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴡𐴖𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴡𐴁𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴡𐴖𐴢 𐴇𐴝𐴥𐴘 𐴄𐴟𐴀𐴓𐴢 𐴀𐴡𐴥𐴘 𐴀𐴝𐴏𐴠𐴤.</para>
  <para style="p" vid="REV 17:6">𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴀𐴛 𐴀𐴠𐴁𐴧𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴞𐴒𐴡𐴘. <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴑𐴞𐴘𐴝𐴥 𐴀𐴡𐴥𐴘𐴧𐴡؟ 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴇𐴠𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴡𐴀𐴘𐴢 𐴓𐴡𐴘𐴎𐴝 𐴊𐴠 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴒𐴟𐴉𐴡𐴕 𐴔𐴝𐴀𐴕𐴞 𐴁𐴟𐴎𐴝𐴥𐴘𐴊𐴞𐴘𐴟𐴔, 𐴎𐴠 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴔𐴝𐴃𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴐𐴞𐴥𐴚 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />𐴃𐴟𐴀𐴛 𐴎𐴠 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴊𐴠𐴙𐴑𐴧𐴡𐴥 𐴘𐴞𐴥𐴁𐴝 𐴀𐴝𐴒𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠𐴥, 𐴘𐴝𐴓𐴝 𐴕𐴝𐴥𐴘; 𐴘𐴞𐴥𐴁𐴝 𐴀𐴡𐴄𐴝𐴥𐴘 𐴒𐴝𐴣𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴊𐴡𐴥𐴚𐴐𐴡𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤. 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴥𐴐𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴕𐴝𐴔 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌-𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴕𐴝𐴥𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴗𐴝𐴥𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴞𐴥𐴁𐴝 𐴀𐴝𐴒𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴘𐴝𐴓𐴝 𐴕𐴝𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴘𐴁𐴡𐴤.<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />”𐴀𐴞𐴀𐴕 𐴁𐴟𐴎𐴞𐴥𐴃𐴠 𐴒𐴞𐴘𐴝𐴕 𐴀𐴡𐴓𐴝 𐴊𐴠𐴔𐴝𐴑𐴡𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢: 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴔𐴝𐴃𐴝𐴥 𐴒𐴟𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴝𐴀𐴌 𐴎𐴞𐴀𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴁𐴡𐴘𐴧𐴠𐴥. <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴔𐴝𐴃𐴝𐴥 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴥𐴣𐴃𐴢 𐴎𐴡𐴕 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴘𐴡𐴥. 𐴈𐴠𐴥𐴕𐴃𐴟 𐴉𐴝𐴣𐴏𐴢 𐴎𐴡𐴕 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴘𐴁𐴡𐴤 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴇𐴡𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴀𐴝𐴥𐴕𐴞𐴑 𐴃𐴝𐴥𐴑𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />𐴎𐴠 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴗𐴝𐴥 𐴀𐴝𐴒𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴘𐴝𐴓𐴝 𐴕𐴝𐴥𐴘, 𐴘𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴐𐴄𐴡 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝. 𐴘𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴝𐴥𐴣𐴃𐴡 𐴖𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴎𐴡𐴕, 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝 𐴊𐴡𐴥𐴚𐴐𐴡𐴌 𐴀𐴟𐴎𐴟 𐴎𐴝𐴦𐴌.<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />”𐴃𐴟𐴀𐴛 𐴎𐴠 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴐𐴞𐴥𐴚 𐴊𐴠𐴙𐴑𐴧𐴡𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴡𐴐𐴢 𐴎𐴡𐴕 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴌𐴝𐴙𐴅𐴧𐴡 𐴕𐴡𐴥 𐴉𐴝𐴦, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴄𐴝𐴙𐴔 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴗𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴉𐴝𐴘𐴁𐴡. <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴗𐴝𐴥𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴌𐴝𐴥𐴘 𐴊𐴞𐴥𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴌𐴝𐴘𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴑𐴟𐴥𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴟𐴥𐴊𐴝 𐴀𐴝𐴦𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝. 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴋𐴝𐴈𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴖𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌.“<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴎𐴠 𐴉𐴝𐴕𐴞𐴥 𐴊𐴠𐴙𐴑𐴧𐴡𐴥, 𐴎𐴞𐴀𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴔𐴝𐴒𐴞𐴕𐴞 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴊𐴠𐴐𐴡𐴥𐴙𐴃𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴟𐴁𐴝𐴕 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />𐴃𐴟𐴀𐴛 𐴎𐴠 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴐𐴞𐴥𐴚 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴃𐴧𐴟 𐴊𐴠𐴙𐴑𐴧𐴡𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥 𐴔𐴝𐴒𐴞𐴕𐴞𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴞𐴘𐴡𐴏𐴧𐴡𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝𐴌 𐴒𐴟𐴏𐴧𐴡 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴡𐴦𐴙𐴕 𐴓𐴡𐴘 𐴉𐴟𐴌𐴝𐴃𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴠 𐴊𐴠 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝, 𐴀𐴠𐴑 𐴕𐴞𐴘𐴡𐴃𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌𐴠 𐴀𐴡𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴡𐴓𐴧𐴝 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴡𐴌𐴠 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴌𐴝 𐴕𐴡𐴥. <verse eid="REV 17:17" /><verse number="18" style="v" sid="REV 17:18" />𐴃𐴟𐴀𐴛 𐴎𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴊𐴠𐴙𐴑𐴧𐴡𐴥 𐴇𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴀𐴌 𐴖𐴝𐴀𐴕 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥.“<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s1">𐴁𐴝𐴁𐴞𐴓𐴡𐴕 𐴐𐴡𐴥𐴀𐴌 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌; 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴋𐴡𐴣𐴀𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴎𐴡𐴓𐴧𐴞𐴘𐴠 𐴉𐴡𐴀𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴌𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="REV 18:2">”𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴋𐴡𐴣𐴀𐴌 𐴁𐴝𐴁𐴞𐴓𐴡𐴕 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘!</para>
  <para style="q2" vid="REV 18:2">𐴇𐴞𐴥𐴁𐴝 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴝𐴌 𐴎𐴝𐴒𐴝,</para>
  <para style="q1" vid="REV 18:2">𐴉𐴡𐴃𐴧𐴞𐴥 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴡𐴌 𐴀𐴝𐴋𐴧𐴝-𐴈𐴝𐴥𐴕𐴝,</para>
  <para style="q2" vid="REV 18:2">𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴝𐴉𐴝𐴑</para>
  <para style="q2" vid="REV 18:2">𐴀𐴠𐴊𐴧𐴠 𐴒𐴞𐴥𐴕𐴝𐴘𐴞 𐴉𐴝𐴙𐴑𐴡𐴌 𐴀𐴝𐴋𐴧𐴝-𐴈𐴝𐴥𐴕𐴝 𐴁𐴡𐴕𐴞𐴒𐴞𐴘𐴡𐴥𐴘.<verse eid="REV 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="REV 18:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡</para>
  <para style="q2" vid="REV 18:3">𐴇𐴞𐴥𐴁𐴝𐴌 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞𐴌 𐴀𐴝𐴎𐴧𐴟𐴌 𐴐𐴡𐴥𐴌𐴝𐴁𐴢 𐴇𐴝𐴥𐴘 𐴄𐴟𐴀𐴓𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘;</para>
  <para style="q1" vid="REV 18:3">𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴠𐴥,</para>
  <para style="q2" vid="REV 18:3">𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴐𐴡𐴥𐴊𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴘𐴝𐴐𐴞𐴌 𐴀𐴝𐴄𐴝𐴓𐴞𐴑𐴧𐴝 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴠 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.“<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴌 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="REV 18:4">”𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴎𐴡𐴥𐴒𐴡𐴘,</para>
  <para style="q2" vid="REV 18:4">𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴁𐴝𐴌 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴑 𐴕𐴡,</para>
  <para style="q2" vid="REV 18:4">𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴉𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴕𐴟 𐴀𐴝𐴘𐴧𐴠𐴤;<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴃𐴡 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴟𐴣𐴏𐴡𐴓𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠,</para>
  <para style="q2" vid="REV 18:5">𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴡𐴌𐴡𐴤;</para>
  <para style="q2" vid="REV 18:6">𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴈𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴊𐴟𐴘 𐴒𐴟𐴕 𐴁𐴞𐴐𐴞𐴤 𐴁𐴡𐴊𐴡𐴓𐴝 𐴊𐴡.</para>
  <para style="q1" vid="REV 18:6">𐴎𐴠 𐴉𐴞𐴘𐴝𐴓𐴝𐴃𐴢 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴓𐴧𐴝 𐴕𐴞𐴐𐴝𐴥 𐴔𐴞𐴘𐴝𐴥𐴓𐴊𐴞𐴘𐴠,</para>
  <para style="q2" vid="REV 18:6">𐴇𐴠𐴥 𐴉𐴞𐴘𐴝𐴓𐴝𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴀𐴝𐴌𐴡𐴤 𐴊𐴟𐴘 𐴒𐴟𐴕 𐴁𐴞𐴐𐴞𐴤 𐴕𐴞𐴐𐴝𐴥 𐴔𐴞𐴘𐴝𐴥𐴓𐴢 𐴊𐴡𐴥.<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴟𐴥𐴌 𐴀𐴝𐴎𐴝𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴑 𐴊𐴡,</para>
  <para style="q2" vid="REV 18:7">𐴎𐴠𐴊𐴧𐴟𐴥𐴌 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴥𐴖𐴝𐴓𐴝𐴘𐴧𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴘𐴝𐴐𐴞𐴘𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴧𐴠𐴥,</para>
  <para style="q1" vid="REV 18:7">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴈𐴡𐴀 𐴊𐴠,</para>
  <para style="q2" vid="REV 18:7">’𐴀𐴝𐴀𐴛 𐴌𐴝𐴕𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴞𐴤;</para>
  <para style="q1" vid="REV 18:7">𐴀𐴝𐴀𐴛 𐴇𐴡𐴥𐴕𐴡 𐴌𐴝𐴌𐴞 𐴕𐴡,</para>
  <para style="q2" vid="REV 18:7">𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴕𐴝𐴥𐴘.‘<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴠𐴑 𐴊𐴞𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴉𐴡𐴃𐴢 𐴇𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴘𐴁𐴡𐴘,</para>
  <para style="q2" vid="REV 18:8">𐴘𐴝𐴥𐴕𐴞 𐴔𐴡𐴦𐴃𐴢, 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴄𐴢.</para>
  <para style="q1" vid="REV 18:8">𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴡𐴦𐴙𐴕 𐴊𐴞 𐴉𐴟𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡,</para>
  <para style="q2" vid="REV 18:8">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴏𐴝𐴌-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴓𐴧𐴝 𐴃𐴡 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝.“<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴝𐴦𐴌 𐴀𐴝𐴘𐴝𐴐𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴁𐴝 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴊𐴟𐴥𐴖𐴝𐴣 𐴊𐴠𐴑𐴞𐴥 𐴇𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴞𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴎𐴝𐴁𐴢 𐴊𐴠𐴑𐴞𐴥 𐴋𐴡𐴦𐴌𐴠 𐴊𐴟𐴌 𐴀𐴡𐴥𐴃𐴧𐴟 𐴃𐴞𐴥𐴘𐴝𐴘 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠,</para>
  <para style="q1" vid="REV 18:10">”𐴀𐴡𐴥 𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴀𐴌 𐴁𐴝𐴁𐴞𐴓𐴡𐴕, 𐴀𐴡𐴥 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴐𐴡𐴥𐴀𐴌,</para>
  <para style="q2" vid="REV 18:10">𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢, 𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢!</para>
  <para style="q1" vid="REV 18:10">𐴈𐴡𐴔 𐴄𐴝𐴙𐴔𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴡 𐴃𐴡𐴌 𐴏𐴝𐴥𐴣𐴎𐴝 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘.“<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴐𐴡𐴥𐴊𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴝𐴓𐴏𐴝𐴥𐴔𐴝𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴑𐴞𐴕𐴠𐴌. <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />𐴇𐴠𐴥 𐴔𐴝𐴓𐴏𐴝𐴥𐴔𐴝𐴕𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠: 𐴐𐴟𐴥𐴕𐴝, 𐴌𐴟𐴉𐴝, 𐴑𐴞𐴔𐴡𐴃𐴞 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴑𐴃𐴝; 𐴁𐴝𐴌𐴞𐴥𐴑 𐴉𐴝𐴍𐴡𐴌-𐴇𐴡𐴦𐴌, 𐴁𐴝𐴘𐴡𐴙𐴕𐴧𐴝 𐴌𐴡𐴚𐴡𐴌 𐴇𐴡𐴦𐴌, 𐴌𐴠𐴐𐴡𐴥𐴔 𐴇𐴡𐴦𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴞𐴌𐴔𐴞𐴏𐴢 𐴌𐴡𐴚𐴡𐴌 𐴇𐴡𐴦𐴌; 𐴇𐴝𐴥𐴀𐴌 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴑𐴟𐴥𐴐𐴁𐴡 𐴒𐴝𐴏𐴢, 𐴀𐴝𐴥𐴣𐴃𐴞𐴌 𐴊𐴝𐴃𐴡𐴃𐴧𐴟 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴔𐴞 𐴒𐴝𐴏𐴢 𐴀𐴡𐴃𐴧𐴟, 𐴉𐴞𐴃𐴡𐴓𐴢 𐴀𐴡𐴃𐴧𐴟, 𐴓𐴟𐴖𐴝𐴥𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴌𐴁𐴡𐴥𐴓𐴡𐴃𐴧𐴟 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢; <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />𐴒𐴝𐴏𐴡𐴌 𐴏𐴝𐴥𐴓𐴢, 𐴔𐴡𐴏𐴡𐴥𐴓𐴧𐴝, 𐴀𐴝𐴒𐴡𐴥𐴌𐴁𐴝𐴃𐴧𐴞, 𐴀𐴝𐴣𐴃𐴡𐴌, 𐴓𐴟𐴁𐴝𐴕, 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴐𐴡𐴥𐴌𐴝𐴁𐴢, 𐴃𐴠𐴓𐴢, 𐴔𐴡𐴘𐴊𐴝, 𐴒𐴞𐴣𐴘𐴟, 𐴒𐴡𐴌𐴟, 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢, 𐴒𐴟𐴥𐴌𐴝, 𐴒𐴟𐴥𐴌𐴝-𐴒𐴝𐴌𐴞𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢.<verse eid="REV 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 18:14" />𐴇𐴠𐴥 𐴐𐴡𐴥𐴊𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ”𐴃𐴟𐴘 𐴎𐴠 𐴉𐴡𐴥𐴓𐴉𐴡𐴓𐴝 𐴉𐴝𐴘𐴃𐴡 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴞 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴊𐴟𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴃𐴡𐴌 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴡𐴌 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴒𐴝𐴙𐴁𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴝𐴌 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡 𐴉𐴝𐴘𐴁𐴡.“ <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />𐴇𐴠𐴥 𐴅𐴞𐴕𐴞𐴥𐴐𐴡𐴌 𐴐𐴡𐴥𐴊𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴎𐴝𐴁𐴢 𐴊𐴠𐴑𐴞𐴥 𐴋𐴡𐴦𐴌𐴠 𐴊𐴟𐴌𐴠𐴥 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴑𐴞𐴁𐴡. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴓𐴝𐴑 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢-𐴈𐴡𐴀𐴘𐴢,</para>
  <para style="q1" vid="REV 18:16">”𐴀𐴡𐴥 𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴀𐴌, 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢, 𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢,</para>
  <para style="q2" vid="REV 18:16">𐴎𐴞𐴁𐴝𐴤 𐴁𐴝𐴌𐴞𐴥𐴑 𐴉𐴝𐴍𐴡𐴌-𐴇𐴡𐴦𐴌, 𐴁𐴝𐴘𐴡𐴙𐴕𐴧𐴝 𐴌𐴡𐴚𐴡𐴌 𐴇𐴡𐴦𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴞𐴌𐴔𐴞𐴏𐴢 𐴌𐴡𐴚𐴡𐴌 𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴝𐴤,</para>
  <para style="q2" vid="REV 18:16">𐴀𐴝𐴦𐴌 𐴐𐴟𐴥𐴕𐴝, 𐴑𐴞𐴔𐴡𐴃𐴞 𐴉𐴝𐴃𐴧𐴡𐴥𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴑𐴃𐴝 𐴓𐴡𐴘 𐴇𐴝𐴥𐴣𐴎𐴝𐴘𐴧𐴝;<verse eid="REV 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 18:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴡𐴔 𐴄𐴝𐴙𐴔𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴊𐴟𐴥𐴕 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴢 𐴃𐴡 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘!“</para>
  <para style="p" vid="REV 18:17">𐴎𐴝𐴀𐴣𐴏𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴔𐴝𐴎𐴞𐴥, 𐴇𐴝𐴥𐴀𐴌 𐴉𐴝𐴐𐴞𐴥𐴕𐴊𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴠𐴥𐴌𐴝𐴙𐴚𐴒𐴝, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴊𐴟𐴥𐴕𐴠 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴏𐴡𐴓𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴊𐴟𐴌𐴠𐴥 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴑𐴞𐴁𐴡. <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />𐴇𐴞𐴥𐴁𐴝 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴊𐴟𐴥𐴖𐴝𐴣 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ”𐴀𐴠 𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴀𐴌 𐴘𐴝𐴀𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴐𐴡𐴥𐴀𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴕𐴞𐴥𐴑𐴞؟“ <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴊𐴟𐴥𐴙𐴓𐴢 𐴔𐴝𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴈𐴝𐴣𐴊𐴞-𐴈𐴝𐴣𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴓𐴝𐴑 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠,</para>
  <para style="q1" vid="REV 18:19">”𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢, 𐴇𐴠𐴥 𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢,</para>
  <para style="q2" vid="REV 18:19">𐴎𐴞𐴁𐴝𐴤𐴌 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴠</para>
  <para style="q2" vid="REV 18:19">𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴎𐴝𐴀𐴣𐴏𐴢 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴘𐴧𐴠,</para>
  <para style="q1" vid="REV 18:19">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴡 𐴈𐴡𐴔 𐴄𐴝𐴙𐴔𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠!“<verse eid="REV 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="REV 18:20" />𐴀𐴡𐴥 𐴀𐴝𐴏𐴔𐴝𐴕, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴌𐴡𐴏𐴟𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢,</para>
  <para style="q2" vid="REV 18:20">𐴇𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤;</para>
  <para style="q1" vid="REV 18:20">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥</para>
  <para style="q2" vid="REV 18:20">𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴡𐴊𐴡𐴓𐴝 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.<verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴏𐴝𐴑𐴧𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴔𐴠𐴓𐴝𐴤𐴔𐴝𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="REV 18:21">”𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴟𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴀𐴌 𐴁𐴝𐴁𐴞𐴓𐴡𐴕𐴡𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</para>
  <para style="q2" vid="REV 18:21">𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴉𐴝𐴦 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.<verse eid="REV 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="REV 18:22" />𐴁𐴞𐴕𐴝-𐴁𐴝𐴎𐴡𐴘𐴝𐴌, 𐴃𐴝𐴓𐴢-𐴁𐴝𐴎𐴡𐴘𐴝𐴌, 𐴁𐴝𐴐𐴞𐴤-𐴁𐴝𐴎𐴡𐴘𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴐𐴞𐴥𐴛𐴝-𐴔𐴝𐴃𐴡𐴘𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴢</para>
  <para style="q2" vid="REV 18:22">𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴟𐴥𐴕𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡;</para>
  <para style="q1" vid="REV 18:22">𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕</para>
  <para style="q2" vid="REV 18:22">𐴇𐴡𐴕𐴡𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴞𐴏𐴃𐴞𐴥𐴌𐴞𐴌 𐴐𐴡𐴥𐴊𐴡𐴌𐴞 𐴉𐴝𐴦 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡;</para>
  <para style="q1" vid="REV 18:22">𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴏𐴝𐴑𐴧𐴞𐴌 𐴀𐴝𐴁𐴝𐴏𐴢</para>
  <para style="q2" vid="REV 18:22">𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴉𐴟𐴥𐴕𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.<verse eid="REV 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="REV 18:23" />𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴠𐴌𐴝𐴑𐴡𐴌 𐴉𐴡𐴀𐴌𐴠</para>
  <para style="q2" vid="REV 18:23">𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴉𐴡𐴀𐴌 𐴕𐴡 𐴊𐴞𐴁𐴡;</para>
  <para style="q1" vid="REV 18:23">𐴊𐴟𐴓𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴓𐴞𐴥𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠</para>
  <para style="q2" vid="REV 18:23">𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴉𐴟𐴥𐴕𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡;</para>
  <para style="q1" vid="REV 18:23">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴡𐴌 𐴐𐴡𐴥𐴊𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴋𐴡𐴣𐴀𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢,</para>
  <para style="q2" vid="REV 18:23">𐴀𐴝𐴦𐴌 𐴃𐴡𐴌 𐴅𐴝𐴊𐴟𐴒𐴝𐴌𐴞 𐴓𐴡𐴘 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴡𐴥𐴘.<verse eid="REV 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="REV 18:24" />𐴇𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌,</para>
  <para style="q2" vid="REV 18:24">𐴀𐴠𐴊𐴧𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴓𐴡𐴖𐴢 𐴉𐴝𐴦 𐴒𐴞𐴘𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴑𐴟𐴥𐴕 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.“<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴣𐴀𐴌 𐴊𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴡𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="REV 19:1">”𐴇𐴝𐴥𐴓𐴠𐴓𐴟𐴘𐴝!<note caller="+" style="f"><char style="fr" closed="false">19‏:1 </char><char style="ft" closed="false">”𐴇𐴝𐴥𐴓𐴠𐴓𐴟𐴘𐴝“ 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴇𐴞𐴁𐴌𐴟𐴤 𐴓𐴡𐴉𐴎𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 ”𐴀𐴝𐴥𐴓𐴇𐴝𐴔𐴊𐴟𐴓𐴞𐴓𐴧𐴝𐴤“ 𐴘𐴝𐴥𐴕𐴞 ”𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑.“</char></note></para>
  <para style="q1" vid="REV 19:1">𐴕𐴠𐴅𐴝𐴃𐴢, 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴝𐴦𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌,<verse eid="REV 19:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="REV 19:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞.</para>
  <para style="q1" vid="REV 19:2">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴋𐴡𐴣𐴀𐴌 𐴔𐴝𐴒𐴞𐴕𐴞𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥,</para>
  <para style="q2" vid="REV 19:2">𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞 𐴓𐴡𐴥𐴘 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌</para>
  <para style="q1" vid="REV 19:2">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴁𐴡𐴊𐴡𐴓𐴝 𐴓𐴡𐴘𐴧𐴠𐴥.“<verse eid="REV 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 19:3" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴑𐴁𐴝𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="REV 19:3">”𐴇𐴝𐴥𐴓𐴠𐴓𐴟𐴘𐴝!</para>
  <para style="q1" vid="REV 19:3">𐴇𐴞𐴥𐴁𐴝 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴊𐴟𐴥𐴖𐴝𐴣 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴟𐴍𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.“<verse eid="REV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4" />𐴀𐴠𐴑𐴧𐴟𐴌𐴞-𐴏𐴝𐴙𐴌 𐴎𐴡𐴕 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴒𐴟𐴥𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴘𐴌𐴡𐴥 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴒𐴟𐴥𐴕𐴠 𐴉𐴡𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢, ”𐴀𐴝𐴦𐴔𐴞𐴕. 𐴇𐴝𐴥𐴓𐴠𐴓𐴟𐴘𐴝!“<verse eid="REV 19:4" /></para>
  <para style="s1">𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀𐴌 𐴁𐴞𐴘𐴝𐴥𐴌 𐴔𐴠𐴓𐴝</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠,</para>
  <para style="q1" vid="REV 19:5">”𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴡𐴤,</para>
  <para style="q2" vid="REV 19:5">𐴀𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢,</para>
  <para style="q2" vid="REV 19:5">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴋𐴡𐴦𐴌𐴡,</para>
  <para style="q1" vid="REV 19:5">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴋𐴡𐴣𐴀𐴌 𐴐𐴡𐴥𐴣𐴍𐴡 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠.“<verse eid="REV 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴣𐴀𐴌 𐴊𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴡𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴁𐴞𐴐𐴞𐴤 𐴉𐴝𐴕𐴞𐴥𐴌 𐴇𐴡𐴓𐴇𐴡𐴓𐴝𐴕𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴄𐴝𐴥𐴍𐴝𐴓𐴡𐴌 𐴋𐴡𐴣𐴀𐴌 𐴔𐴝𐴃𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="REV 19:6">”𐴇𐴝𐴥𐴓𐴠𐴓𐴟𐴘𐴝!</para>
  <para style="q2" vid="REV 19:6">𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴖𐴝𐴓𐴝 𐴑𐴟𐴥𐴊𐴝𐴘𐴠 𐴃𐴡 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌.<verse eid="REV 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 19:7" />𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘 𐴀𐴝𐴦𐴌 𐴑𐴟𐴥𐴐𐴞-𐴀𐴝𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥</para>
  <para style="q2" vid="REV 19:7">𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴒𐴡𐴌𐴞𐴥,</para>
  <para style="q1" vid="REV 19:7">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴁𐴞𐴘𐴝𐴥𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴃𐴡 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘,</para>
  <para style="q2" vid="REV 19:7">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴓𐴞𐴥𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.“<verse eid="REV 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 19:8" />𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴏𐴡𐴙𐴑𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴥𐴉𐴢 𐴁𐴝𐴌𐴞𐴥𐴑 𐴉𐴝𐴍𐴡𐴌-𐴇𐴡𐴦𐴌</para>
  <para style="q2" vid="REV 19:8">𐴉𐴞𐴕𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥,</para>
  <para style="qm" vid="REV 19:8">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴝𐴌𐴞𐴥𐴑 𐴉𐴝𐴍𐴡𐴌-𐴇𐴡𐴦𐴌𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢.<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴝𐴀𐴕 𐴓𐴠𐴑𐴡𐴥: 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴁𐴡𐴘𐴌𐴝𐴃𐴡𐴌 𐴔𐴠𐴓𐴝𐴃𐴢 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥.“ 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴀𐴞𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢.“<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴦𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴒𐴟𐴓𐴝𐴔, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴞𐴘𐴝 𐴒𐴡𐴁𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴃𐴝𐴥𐴑𐴠. 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴁𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴡𐴤. 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴞𐴘𐴝 𐴒𐴡𐴁𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴡 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴓𐴢 𐴈𐴡𐴃𐴝𐴤.“<verse eid="REV 19:10" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴡𐴥𐴓𐴝 𐴒𐴟𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕 𐴑𐴟𐴥𐴓𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴇𐴠𐴥𐴍𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴊𐴡𐴥𐴓𐴝 𐴒𐴟𐴥𐴌𐴝. 𐴘𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴁𐴝𐴤 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴁𐴞𐴏𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴠𐴥. <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴟𐴑 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴎𐴞𐴓𐴇𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴃𐴝𐴏𐴢 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴝𐴦𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴝𐴔 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠. <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />𐴀𐴞𐴥𐴁𐴝 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴃𐴢 𐴁𐴟𐴌𐴝𐴘𐴧𐴝 𐴉𐴟𐴐𐴝𐴥𐴑 𐴉𐴞𐴕𐴊𐴝𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔. <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴡𐴥𐴓𐴝 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴥𐴉𐴢 𐴁𐴝𐴌𐴞𐴥𐴑 𐴉𐴝𐴍𐴡𐴌-𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴞𐴥, 𐴊𐴡𐴥𐴓𐴝 𐴒𐴟𐴥𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴝𐴥𐴌 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴝𐴥𐴌𐴝𐴘 𐴉𐴝𐴌𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴓𐴟𐴖𐴝𐴥𐴌 𐴓𐴡𐴍𐴞𐴥 𐴓𐴡𐴥𐴘 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴕𐴠𐴦𐴓𐴝 𐴊𐴠 𐴒𐴝𐴣𐴌𐴝𐴥𐴌𐴠 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠𐴁𐴝𐴎𐴠 𐴀𐴟𐴥𐴣𐴌𐴞𐴁𐴡, 𐴎𐴠 𐴒𐴝𐴣𐴌𐴝𐴥𐴃𐴢 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴖𐴝𐴓𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴐𐴧𐴝𐴤𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴐𐴝𐴥𐴑𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴕𐴡𐴃𐴢 𐴕𐴝𐴔 𐴘𐴝𐴀𐴕 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤, ”𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝, 𐴑𐴟𐴥𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴟𐴥𐴊𐴝.“<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴁𐴠𐴙𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴟𐴌𐴠 𐴊𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴋𐴡𐴣𐴀𐴌 𐴔𐴠𐴓𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴡𐴘, <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴟𐴏𐴧𐴡, 𐴎𐴡𐴕𐴧𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴟𐴏𐴧𐴡, 𐴁𐴡𐴓𐴟𐴖𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴟𐴏𐴧𐴡, 𐴒𐴟𐴥𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴏𐴡𐴌𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴏𐴧𐴡, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴟𐴏𐴧𐴡 𐴇𐴝𐴥𐴘 𐴉𐴝𐴌𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴒𐴟𐴓𐴝𐴔, 𐴐𐴡𐴥𐴣𐴍𐴡 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴋𐴡𐴣𐴀𐴌.“<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴗𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴞𐴁𐴝𐴤 𐴒𐴟𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴗𐴝𐴥𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡𐴁𐴞 𐴀𐴟𐴁𐴝𐴤𐴌𐴠 𐴘𐴡𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴠𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴎𐴞𐴀𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴡𐴥𐴘 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕𐴡𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴃𐴧𐴞𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴇𐴠𐴥 𐴊𐴟𐴕𐴞𐴥 𐴖𐴝𐴌𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴋𐴞𐴀𐴃𐴢 𐴎𐴞𐴕𐴊𐴝 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴥𐴕𐴋𐴡𐴑𐴠 𐴎𐴡𐴓𐴠. <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />𐴀𐴝𐴦𐴌 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴖𐴝𐴀𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴎𐴞𐴁𐴝𐴤 𐴒𐴟𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴏𐴧𐴡 𐴇𐴝𐴥𐴘 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s1">𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴡𐴏𐴡𐴥𐴌</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌; 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴡𐴄𐴝𐴥𐴘 𐴒𐴝𐴣𐴃𐴡𐴌 𐴏𐴝𐴁𐴞𐴤 𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴋𐴡𐴣𐴀𐴌 𐴏𐴞𐴥𐴘𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴝𐴒𐴝𐴤 𐴖𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴉𐴟𐴌𐴝𐴕𐴝 𐴇𐴝𐴥𐴉𐴢 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴢 𐴘𐴝𐴥 𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴠; 𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴓𐴧𐴝 𐴁𐴝𐴣𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠. <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴡𐴄𐴝𐴥𐴘 𐴒𐴝𐴣𐴃𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞 𐴘𐴞𐴥𐴁𐴝 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝𐴃𐴢 𐴔𐴡𐴀𐴌 𐴓𐴝𐴒𐴝𐴘𐴊𐴞𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴡𐴏𐴡𐴥𐴌 𐴉𐴟𐴌𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴃𐴠 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴌 𐴓𐴡𐴘𐴎𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠; 𐴁𐴠𐴐𐴡𐴥𐴑 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴏𐴧𐴝𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴠𐴌𐴞𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴃𐴡𐴑𐴃𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. 𐴀𐴝𐴀𐴛 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴌𐴟𐴀 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴡𐴥 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴈𐴡𐴓𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴡𐴥𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴗𐴝𐴥𐴌𐴠 𐴘𐴝𐴥 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴃𐴧𐴞𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴖𐴝𐴓𐴡𐴃𐴢 𐴘𐴝𐴥 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴘𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴡𐴏𐴡𐴥𐴌 𐴉𐴝𐴥𐴕 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴟𐴌𐴟𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴡𐴏𐴡𐴥𐴌 𐴉𐴟𐴌𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴎𐴞𐴕𐴊𐴝 𐴕𐴡𐴥. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴉𐴡𐴀𐴘𐴓𐴝𐴁𐴝𐴌. <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴉𐴡𐴀𐴘𐴓𐴝𐴁𐴝𐴌 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴃𐴝𐴥𐴑𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴦𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴕𐴝𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴡𐴏𐴡𐴥𐴌 𐴉𐴝𐴥𐴕 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.<verse eid="REV 20:6" /></para>
  <para style="s1">𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴇𐴝𐴥𐴌𐴞𐴒𐴞𐴘𐴡𐴘</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴡𐴏𐴡𐴥𐴌 𐴒𐴟𐴎𐴡𐴌𐴞 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡, <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴑𐴟𐴕𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴕𐴠𐴦𐴓𐴞𐴁𐴡𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴘𐴝𐴅𐴟𐴥𐴅 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴅𐴟𐴥𐴅 𐴀𐴡𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴓𐴝𐴌𐴝𐴥𐴘 𐴓𐴧𐴝 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴡𐴕𐴝 𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴏𐴡𐴌𐴡𐴌 𐴁𐴝𐴓𐴟𐴌 𐴇𐴠𐴥𐴊𐴟𐴕 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴉𐴡𐴥𐴓𐴞𐴎𐴝𐴘, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕𐴡𐴌𐴠 𐴒𐴠𐴥𐴌𐴒𐴗𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕 𐴀𐴡𐴌𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴡𐴦𐴙𐴕 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌𐴠 𐴒𐴡𐴥𐴕𐴋𐴡𐴑𐴠 𐴎𐴡𐴓𐴠 𐴊𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴋𐴞𐴀𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴠𐴍𐴠𐴥 𐴇𐴝𐴥𐴘𐴡𐴖𐴝𐴕 𐴕𐴗𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡𐴁𐴞 𐴖𐴝 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤. 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴞𐴕𐴠 𐴌𐴝𐴘𐴃𐴠 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴝𐴎𐴝𐴁𐴢 𐴉𐴝𐴘𐴁𐴡.<verse eid="REV 20:10" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴡𐴌 𐴁𐴞𐴏𐴝𐴌</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴋𐴡𐴣𐴀𐴌 𐴊𐴡𐴥𐴓𐴝 𐴃𐴡𐴑𐴃𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴎𐴡𐴁𐴞𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴏𐴔𐴝𐴕 𐴊𐴝𐴥𐴘𐴒𐴞𐴘𐴠𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴠 𐴇𐴡𐴕𐴡𐴤 𐴎𐴝𐴒𐴝 𐴕𐴡𐴥 𐴉𐴝𐴦. <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴋𐴡𐴣𐴀𐴌-𐴐𐴡𐴥𐴣𐴍𐴡 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴑𐴞𐴃𐴝𐴁𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴑𐴟𐴥𐴓𐴝𐴒𐴞𐴘𐴠. 𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴑𐴞𐴃𐴝𐴁𐴢 𐴑𐴟𐴥𐴓𐴝𐴒𐴞𐴘𐴠, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌-𐴑𐴞𐴃𐴝𐴁𐴢; 𐴁𐴝𐴦𐴊𐴠 𐴇𐴠𐴥 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴠 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴠𐴥 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴟𐴥𐴕𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />𐴎𐴠 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴡𐴙𐴅𐴧𐴝𐴘𐴠 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴔𐴡𐴦𐴃𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴃𐴝𐴓𐴉𐴟𐴌𐴠 𐴘𐴡𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴎𐴠 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴘𐴠; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />𐴁𐴝𐴦𐴊𐴠 𐴔𐴡𐴦𐴃𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴃𐴝𐴓𐴉𐴟𐴌𐴡𐴌𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴋𐴞𐴀𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠. 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴋𐴞𐴀 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴦𐴃𐴢. <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />𐴎𐴝𐴌-𐴎𐴝𐴌 𐴕𐴝𐴔 𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌-𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴉𐴝𐴦 𐴕𐴡𐴥 𐴎𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠-𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴋𐴞𐴀𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠.<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s1">𐴕𐴡𐴘𐴝 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴘𐴝 𐴎𐴡𐴁𐴞𐴕</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴘𐴝 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴘𐴝 𐴎𐴡𐴁𐴞𐴕 𐴊𐴠𐴙𐴑𐴧𐴞𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴡𐴀𐴘𐴓𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴀𐴘𐴓𐴝𐴌 𐴎𐴡𐴁𐴞𐴕 𐴃𐴡 𐴐𐴠𐴥𐴐𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴇𐴡𐴕𐴡𐴤 𐴊𐴡𐴙𐴅𐴧𐴝 𐴘𐴡𐴥 𐴀𐴝𐴌 𐴕𐴝𐴥𐴘. <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠, 𐴂𐴝𐴑 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕, 𐴘𐴝𐴥𐴕𐴞 𐴕𐴡𐴘𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴔𐴝𐴥𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌; 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴊𐴟𐴓𐴞𐴥𐴌𐴠 𐴊𐴟𐴓𐴝𐴤 𐴓𐴧𐴝 𐴇𐴝𐴥𐴣𐴎𐴝 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴇𐴝𐴥𐴣𐴎𐴝 𐴒𐴞𐴥𐴘𐴠. <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴝𐴓𐴧𐴝 𐴃𐴝𐴥𐴑𐴞𐴁𐴝𐴌 𐴎𐴝𐴒𐴝 𐴘𐴝𐴓𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠. 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴁𐴡. 𐴀𐴝𐴓𐴧𐴝 𐴕𐴞𐴎𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴀𐴌 𐴏𐴟𐴑𐴡𐴌 𐴉𐴝𐴕𐴞𐴥 𐴉𐴟𐴣𐴏𐴞𐴥𐴊𐴞𐴁𐴡; 𐴇𐴡𐴕𐴡𐴤 𐴔𐴡𐴦𐴃𐴢 𐴀𐴝𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴇𐴡𐴕𐴡𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞, 𐴈𐴝𐴣𐴊𐴝𐴕𐴞, 𐴘𐴝𐴥 𐴊𐴟𐴑 𐴀𐴡𐴥 𐴀𐴝𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴒𐴡𐴌 𐴒𐴟𐴥𐴕 𐴃𐴡 𐴉𐴟𐴥𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴘.“<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />𐴃𐴡𐴑𐴃𐴡𐴥 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴝𐴀, 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴘𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴙𐴌.“ 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴀𐴕 𐴓𐴠𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴡𐴃𐴝𐴤 𐴀𐴞𐴀𐴕 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞.“<verse eid="REV 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 21:6" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴝𐴓𐴝 𐴉𐴟𐴥𐴌𐴝𐴘𐴧𐴠. 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴓𐴉𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴔𐴞𐴥𐴒𐴝, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴖𐴝𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴑𐴠𐴥𐴌. 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴞𐴌𐴝𐴥𐴐𐴞 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴠𐴦 𐴊𐴠 𐴉𐴝𐴕𐴞𐴥𐴌 𐴎𐴡𐴥𐴕𐴧𐴝𐴃𐴧𐴟 𐴉𐴝𐴕𐴞𐴥 𐴊𐴞𐴦𐴘𐴟𐴔, 𐴀𐴠𐴁𐴧𐴠 𐴔𐴝𐴦𐴕𐴝. <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴧𐴠𐴤 𐴀𐴞𐴥𐴃𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴘𐴁𐴡; 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴟𐴔 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴠𐴥𐴓𐴉𐴝𐴊𐴟𐴥𐴌𐴝𐴌, 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌, 𐴒𐴞𐴥𐴕𐴝𐴘𐴞 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝𐴌, 𐴑𐴟𐴥𐴕𐴞𐴌, 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌 𐴀𐴡𐴌, 𐴅𐴝𐴊𐴟𐴒𐴡𐴌 𐴀𐴡𐴌, 𐴔𐴟𐴃𐴧𐴞-𐴉𐴟𐴣𐴎𐴡𐴘𐴝𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴞𐴏𐴝𐴥𐴑𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴥𐴑 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴡𐴦𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴥𐴕𐴋𐴡𐴑𐴠 𐴎𐴡𐴓𐴠 𐴊𐴠 𐴇𐴝𐴥𐴁𐴞𐴘𐴝 𐴎𐴟𐴎𐴟𐴑; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴦𐴃𐴢.“<verse eid="REV 21:8" /></para>
  <para style="s1">𐴕𐴡𐴘𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴎𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴃𐴧𐴟 𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴌 𐴇𐴝𐴥𐴣𐴃𐴧𐴝𐴕 𐴀𐴝𐴉𐴡𐴃𐴢 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴉𐴞𐴘𐴝𐴓𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴟𐴓𐴞𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴁𐴡𐴖𐴢 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴟𐴔.“ <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴌𐴞 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴂𐴝𐴑 𐴐𐴡𐴥𐴀𐴌 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴔𐴝𐴥𐴕 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴎𐴡𐴓𐴧𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴏𐴡𐴏𐴧𐴡𐴈𐴝𐴕𐴞 𐴁𐴞𐴐𐴞𐴤 𐴑𐴞𐴔𐴡𐴃𐴞 𐴅𐴡𐴇𐴝𐴥𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴘𐴝𐴥𐴕𐴞 𐴉𐴡𐴥𐴍𐴞𐴑𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴝𐴥𐴉𐴢 𐴅𐴝𐴏𐴂𐴝𐴌 𐴅𐴡𐴇𐴝𐴥𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴢. <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴁𐴝𐴌𐴡𐴥 𐴖𐴝𐴕 𐴒𐴠𐴙𐴄𐴢 𐴀𐴡𐴓𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴋𐴠𐴁𐴝𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴒𐴠𐴙𐴄𐴢 𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴝𐴌𐴡𐴥 𐴖𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴝𐴏𐴠𐴤. 𐴒𐴠𐴙𐴄𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴕𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴁𐴝𐴌𐴡𐴥 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴌 𐴕𐴝𐴔. <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />𐴃𐴞𐴕 𐴕𐴝𐴥𐴕 𐴒𐴠𐴙𐴄𐴢 𐴉𐴟𐴑 𐴔𐴞𐴑𐴧𐴝𐴥 𐴃𐴧𐴟, 𐴃𐴞𐴕 𐴕𐴝𐴥𐴕 𐴒𐴠𐴙𐴄𐴢 𐴀𐴟𐴃𐴧𐴡𐴌 𐴔𐴞𐴑𐴧𐴝𐴥 𐴃𐴧𐴟, 𐴃𐴞𐴕 𐴕𐴝𐴥𐴕 𐴒𐴠𐴙𐴄𐴢 𐴊𐴡𐴀𐴙𐴕 𐴔𐴞𐴑𐴧𐴝𐴥 𐴃𐴧𐴟, 𐴀𐴝𐴦𐴌 𐴃𐴞𐴕 𐴕𐴝𐴥𐴕 𐴒𐴠𐴙𐴄𐴢 𐴉𐴡𐴏𐴞𐴥𐴔 𐴔𐴞𐴑𐴧𐴝𐴥 𐴃𐴧𐴟. <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴋𐴠𐴁𐴝𐴓𐴢 𐴓𐴝𐴕 𐴁𐴝𐴌𐴡𐴥 𐴖𐴝 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞𐴌 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴝𐴕𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴕𐴝𐴔 𐴀𐴝𐴏𐴠𐴤.<verse eid="REV 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴉𐴡𐴕𐴞𐴌 𐴓𐴡𐴍𐴞𐴥 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴁𐴝𐴤 𐴐𐴟𐴥𐴕𐴝𐴌; 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕 𐴀𐴡𐴌𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴒𐴠𐴙𐴄𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴋𐴠𐴁𐴝𐴓𐴡𐴌𐴠 𐴔𐴝𐴉𐴞 𐴁𐴡𐴓𐴧𐴝. <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕 𐴏𐴝𐴙𐴌 𐴑𐴟𐴙𐴕𐴧𐴝; 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴓𐴝𐴔𐴁𐴝 𐴎𐴠𐴊𐴧𐴟𐴥𐴌 𐴉𐴝𐴃𐴝𐴥𐴌𐴞 𐴘𐴡𐴥 𐴇𐴠𐴥𐴊𐴧𐴟𐴌. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕 𐴓𐴡𐴍𐴞𐴥 𐴖𐴝 𐴓𐴡𐴥𐴘 𐴔𐴝𐴙𐴂𐴧𐴠𐴥 𐴌𐴝𐴥𐴌 𐴁𐴝𐴌𐴡𐴥 𐴀𐴝𐴥𐴎𐴝𐴌 𐴑𐴟𐴕𐴞 𐴊𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥; 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴓𐴝𐴔𐴁𐴝, 𐴉𐴝𐴃𐴝𐴥𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴖𐴡𐴌𐴔𐴞𐴑𐴧𐴝𐴥 𐴁𐴡𐴌𐴝𐴁𐴡𐴌. <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴋𐴠𐴁𐴝𐴓𐴢 𐴓𐴝𐴕𐴡𐴌𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴔𐴝𐴉𐴠 𐴔𐴝𐴙𐴂𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴠𐴑 𐴐𐴡𐴥𐴀 𐴏𐴝𐴓𐴞𐴐𐴢-𐴏𐴝𐴙𐴌 𐴀𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴘𐴡𐴥 𐴔𐴝𐴉𐴠. <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />𐴋𐴠𐴁𐴝𐴓𐴢 𐴓𐴝𐴕 𐴅𐴝𐴏𐴂𐴝𐴌 𐴅𐴡𐴇𐴝𐴥𐴌 𐴓𐴡𐴥𐴘 𐴁𐴝𐴕𐴝𐴘𐴧𐴝; 𐴀𐴝𐴦𐴌 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕 𐴏𐴝𐴥𐴉𐴢 𐴀𐴝𐴘𐴕𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴇𐴝𐴥𐴄𐴞 𐴐𐴟𐴥𐴕𐴝𐴌. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />𐴇𐴠𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴋𐴠𐴁𐴝𐴓𐴡𐴌 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞𐴌 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴒𐴟𐴥𐴕 𐴇𐴝𐴥𐴀𐴌 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴑𐴞𐴔𐴡𐴃𐴞 𐴅𐴡𐴇𐴝𐴥𐴌 𐴓𐴡𐴥𐴘 𐴇𐴝𐴥𐴣𐴎𐴝𐴘𐴧𐴝. 𐴉𐴡𐴀𐴘𐴓𐴝 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞𐴌 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴒𐴗𐴝𐴥 𐴅𐴝𐴏𐴂𐴝𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴡𐴏𐴡𐴙𐴑𐴧𐴝, 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴖𐴝 𐴏𐴝𐴉𐴝𐴘𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴐𐴟𐴥𐴌𐴔𐴝 𐴌𐴡𐴙𐴚𐴒𐴝, 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴖𐴝 𐴑𐴝𐴓𐴏𐴠𐴥𐴋𐴝𐴕𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴡𐴙𐴚𐴒𐴝, 𐴏𐴝𐴙𐴌 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌𐴒𐴗𐴝𐴥 𐴀𐴠𐴔𐴠𐴌𐴝𐴓𐴋𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴥𐴙𐴓𐴢, <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />𐴉𐴝𐴣𐴏𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌𐴒𐴗𐴝𐴥 𐴏𐴝𐴌𐴋𐴡𐴕𐴞𐴑𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴡𐴥𐴓𐴝 𐴀𐴠𐴊𐴧𐴠 𐴔𐴞𐴍𐴝𐴤 𐴌𐴡𐴙𐴚𐴒𐴝, 𐴏𐴡𐴥 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌𐴒𐴗𐴝𐴥 𐴏𐴝𐴌𐴊𐴞𐴘𐴝𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴐𐴡𐴥𐴌𐴁𐴡𐴃𐴞 𐴌𐴡𐴙𐴚𐴒𐴝, 𐴇𐴝𐴥𐴣𐴃𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌𐴒𐴗𐴝𐴥 𐴑𐴌𐴞𐴏𐴡𐴓𐴝𐴙𐴄𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴓𐴡𐴙𐴊𐴧𐴝, 𐴀𐴝𐴣𐴐𐴄𐴡 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌𐴒𐴗𐴝𐴥 𐴁𐴠𐴌𐴝𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴉𐴝𐴕𐴞𐴥 𐴌𐴡𐴙𐴚𐴒𐴝, 𐴕𐴡𐴖 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌𐴒𐴗𐴝𐴥 𐴄𐴡𐴂𐴝𐴎𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴐𐴟𐴥𐴕𐴝 𐴌𐴡𐴙𐴚𐴒𐴝, 𐴊𐴡𐴐𐴢 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌𐴒𐴗𐴝𐴥 𐴑𐴌𐴞𐴏𐴡𐴂𐴌𐴠𐴙𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴈𐴡𐴌𐴝 𐴀𐴝𐴥𐴙𐴓𐴢, 𐴀𐴠𐴒𐴝𐴌𐴡 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌𐴒𐴗𐴝𐴥 𐴅𐴝𐴏𐴠𐴕𐴊𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴓𐴝𐴓𐴢 𐴌𐴡𐴙𐴚𐴒𐴝, 𐴁𐴝𐴌𐴡𐴥 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌𐴒𐴗𐴝𐴥 𐴀𐴝𐴔𐴠𐴃𐴞𐴏𐴃𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴝𐴘𐴡𐴙𐴕𐴧𐴝 𐴌𐴡𐴙𐴚𐴒𐴝. <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />𐴁𐴝𐴌𐴡𐴥 𐴖𐴝𐴕 𐴒𐴠𐴙𐴄𐴢 𐴃𐴟𐴕 𐴁𐴝𐴌𐴡𐴥 𐴖𐴝 𐴔𐴟𐴑𐴃𐴝; 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴠𐴙𐴄𐴢 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴌 𐴊𐴡𐴥𐴌𐴠 𐴔𐴟𐴑𐴃𐴝. 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴌𐴝𐴏𐴃𐴝 𐴒𐴝𐴥𐴕 𐴏𐴝𐴥𐴉𐴢 𐴀𐴝𐴘𐴕𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴇𐴝𐴥𐴄𐴞 𐴐𐴟𐴥𐴕𐴝𐴌.<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝 𐴕𐴡𐴥 𐴊𐴠𐴑𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴁𐴟𐴊𐴢 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴖𐴝𐴓𐴝 𐴀𐴝𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴈𐴝𐴥𐴕𐴝. <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴀𐴌 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠𐴙𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴕𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴉𐴡𐴀𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴏𐴠𐴌𐴝𐴑. <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴡𐴀𐴌𐴠 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴕𐴞𐴤𐴁𐴡. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />𐴊𐴞𐴕𐴡𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴒𐴠𐴙𐴄𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴁𐴡𐴕 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴍𐴠 𐴃𐴡 𐴌𐴝𐴙𐴃𐴢 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />𐴀𐴝𐴦𐴌 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴕𐴝𐴤 𐴎𐴝𐴘𐴁𐴡. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴕𐴝𐴉𐴝𐴑 𐴅𐴞𐴕𐴞𐴥𐴐𐴢, 𐴒𐴞𐴥𐴕𐴝𐴘𐴞 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴘𐴝𐴥 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴒𐴡𐴥𐴓𐴞 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴕𐴝𐴔 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌-𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤.<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴉𐴝𐴕𐴞𐴥𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴢 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴠; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴡𐴥𐴍𐴞𐴑𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴉𐴡𐴀𐴕, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕𐴡𐴌 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴓𐴊𐴞𐴌 𐴔𐴝𐴎𐴡𐴥𐴃𐴧𐴟 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴠𐴑 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴒𐴝𐴏𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴃𐴢 𐴁𐴝𐴌𐴡𐴥 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝 𐴊𐴡𐴥𐴌𐴠, 𐴉𐴡𐴃𐴧𐴞𐴥 𐴔𐴝𐴐𐴠𐴥-𐴔𐴝𐴐𐴠𐴥. 𐴇𐴠𐴥 𐴒𐴝𐴏𐴡𐴌 𐴉𐴝𐴃𐴝𐴘𐴠 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴡𐴔 𐴀𐴡𐴥. <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴕𐴡𐴤 𐴓𐴝𐴀𐴕𐴡𐴃𐴢 𐴀𐴝𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀 𐴖𐴝𐴌 𐴃𐴡𐴑𐴃𐴡𐴥 𐴇𐴠𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡; <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝 𐴊𐴠𐴑𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴑𐴟𐴖𐴝𐴓𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴃𐴝𐴥𐴑𐴞𐴁𐴡. <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴕𐴡𐴤 𐴌𐴝𐴙𐴃𐴢 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴏𐴠𐴌𐴝𐴑𐴡𐴌 𐴉𐴡𐴀𐴌 𐴘𐴝𐴥 𐴁𐴠𐴙𐴓𐴡𐴌 𐴉𐴡𐴀𐴌 𐴕𐴡 𐴓𐴝𐴒𐴞𐴁𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴉𐴡𐴀𐴌 𐴊𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.<verse eid="REV 22:5" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴘𐴧𐴠𐴤𐴌</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴈𐴡𐴃𐴝𐴤 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞. 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴝𐴎𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴟𐴀𐴙𐴕 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝 𐴎𐴞𐴀𐴕 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴥𐴌𐴝 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤.“<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴘𐴧𐴞𐴤𐴌. 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴁𐴝𐴤 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠 𐴑𐴞𐴃𐴝𐴁𐴡𐴌 𐴂𐴡𐴘𐴒𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.“</char><verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />𐴀𐴝𐴀𐴛 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴀𐴠𐴊𐴟𐴥𐴕 𐴀𐴞𐴀𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥. 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴞𐴀𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴀𐴝𐴀𐴛 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴌 𐴉𐴡𐴦𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴀𐴕 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴠. <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠 𐴑𐴞𐴃𐴝𐴁𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴒𐴟𐴓𐴝𐴔. 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴁𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴡𐴤!“<verse eid="REV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴑𐴞𐴃𐴝𐴁𐴡𐴌 𐴂𐴡𐴘𐴒𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴡𐴀𐴌 𐴓𐴝𐴒𐴝𐴘 𐴕𐴡 𐴌𐴝𐴙𐴑𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥 𐴃𐴡 𐴋𐴝𐴥𐴑𐴠. <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴟𐴌𐴝𐴘 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴟𐴌𐴝𐴘 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴝𐴉𐴝𐴙𐴑𐴧𐴝, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴝𐴉𐴝𐴙𐴑𐴧𐴝 𐴃𐴝𐴥𐴑𐴡𐴗𐴑; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌, 𐴀𐴞𐴥𐴃𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴢 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴂𐴝𐴑, 𐴀𐴞𐴥𐴃𐴠 𐴂𐴝𐴑 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.“<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴘𐴧𐴞𐴤𐴌, 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴊𐴞𐴦 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤. </char> <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴓𐴉𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴔𐴞𐴥𐴒𐴝, 𐴀𐴝𐴖𐴝𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴑𐴠𐴥𐴌, 𐴐𐴟𐴥𐴌𐴟 𐴀𐴠𐴊𐴧𐴠 𐴐𐴠𐴥𐴐𐴢.“</char><verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌 𐴎𐴟𐴁𐴧𐴝 𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴒𐴝𐴏𐴡𐴌 𐴇𐴡𐴥𐴑 𐴉𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴒𐴠𐴙𐴄𐴢 𐴄𐴟𐴥𐴕 𐴁𐴝𐴥𐴘 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴉𐴝𐴌𐴞𐴁𐴡𐴥. <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴑𐴟𐴃𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴅𐴝𐴊𐴟𐴒𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴑𐴟𐴥𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴔𐴟𐴃𐴧𐴞-𐴉𐴟𐴣𐴎𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴥𐴑𐴞 𐴔𐴞𐴏𐴝𐴥𐴌𐴠 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴔𐴞𐴏𐴝𐴥𐴘𐴠 𐴏𐴡𐴓𐴠.<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴞, 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴀𐴕 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴃𐴡. 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴐𐴞𐴥𐴛𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴏𐴡𐴥𐴓𐴢, 𐴉𐴡𐴥𐴎𐴡𐴌𐴡𐴌 𐴏𐴡𐴏𐴡𐴙𐴑𐴧𐴝 𐴏𐴟𐴥𐴃𐴢-𐴃𐴝𐴌𐴝.“</char><verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴓𐴞𐴥𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴘𐴧𐴡𐴤.“ 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴟𐴥𐴕𐴠𐴌 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴈𐴡𐴀, ”𐴀𐴝𐴘𐴧𐴡𐴤.“ 𐴎𐴝𐴃𐴧𐴟 𐴃𐴞𐴌𐴝𐴥𐴐𐴢 𐴓𐴝𐴙𐴒𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴘𐴧𐴡𐴤; 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴞𐴥𐴃𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴉𐴝𐴕𐴞𐴥 𐴔𐴝𐴦𐴕𐴝 𐴓𐴡𐴦𐴒𐴝𐴥𐴘.<verse eid="REV 22:17" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠 𐴑𐴞𐴃𐴝𐴁𐴡𐴌 𐴂𐴡𐴘𐴒𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴥𐴕𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠 𐴒𐴡𐴁𐴝𐴤 𐴒𐴝𐴥𐴕 𐴊𐴞𐴌 𐴊𐴠, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴀𐴕𐴡𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴝𐴌𐴝𐴤, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴀𐴠 𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴝𐴉𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴦𐴁𐴡; <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠 𐴑𐴞𐴃𐴝𐴁𐴡𐴌 𐴂𐴡𐴘𐴒𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴃𐴝𐴤 𐴕𐴠𐴦𐴓𐴝𐴘𐴉𐴠𐴥𐴓𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴠 𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴒𐴝𐴏𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴇𐴡𐴥𐴑 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡.<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴠𐴊𐴟𐴥𐴕 𐴀𐴞𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴊𐴠𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴘𐴧𐴞𐴤𐴌.“</char></para>
  <para style="p" vid="REV 22:20">𐴀𐴝𐴦𐴔𐴞𐴕. 𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤, 𐴀𐴝𐴘𐴧𐴡𐴤.<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>