<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴔𐴡𐴃𐴞</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴡𐴃𐴞</para>
  <para style="toc2">𐴔𐴡𐴃𐴞</para>
  <para style="toc3">𐴔𐴡𐴃𐴢</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴔𐴡𐴃𐴞</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴡𐴃𐴞𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="ip">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴡𐴃𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴞𐴥𐴘𐴝𐴌𐴝, 𐴎𐴞𐴁𐴝𐴤𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴇𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞, 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴉𐴡𐴀𐴘𐴓𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴌𐴠 ”𐴀𐴞𐴕𐴅𐴞𐴓𐴢“ 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 ”𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌“ 𐴘𐴝𐴥𐴕𐴞 ”𐴒𐴡𐴔 𐴈𐴡𐴥𐴁𐴡𐴌.“ 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴞 𐴁𐴝𐴦𐴊𐴠 𐴔𐴡𐴃𐴞, 𐴔𐴝𐴌𐴑𐴟𐴏𐴢, 𐴓𐴟𐴑𐴝𐴥𐴏𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴡𐴃𐴞 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴃𐴝𐴌𐴞𐴥𐴑 𐴀𐴟𐴓𐴠𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴇𐴝𐴥𐴙𐴄𐴢-𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠. 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴡𐴃𐴞𐴌𐴠 𐴇𐴡𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴓𐴠𐴑𐴞𐴕 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴄𐴝𐴥𐴀𐴌𐴠 𐴊𐴠, 𐴘𐴞𐴁𐴝𐴤𐴌𐴠 𐴉𐴞𐴓𐴞𐴥𐴏𐴃𐴞𐴕 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴘𐴝𐴥 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.</para>
  <para style="ip">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴁𐴝𐴤𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴃𐴞, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴋𐴝𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴃𐴡 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴀𐴝𐴒𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴓𐴠𐴀𐴜𐴞 𐴘𐴡𐴥 𐴋𐴝𐴑𐴠. 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴔𐴡𐴃𐴞 𐴘𐴡𐴥 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴉𐴡𐴌𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴌𐴝𐴕𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴙𐴄𐴧𐴗𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴘𐴝𐴃𐴡𐴌𐴠 𐴇𐴝𐴥𐴖𐴝𐴓𐴝 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴥𐴘 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴎𐴝𐴕𐴝 𐴎𐴝. 𐴔𐴡𐴃𐴞𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴠𐴏𐴝𐴥𐴘𐴧𐴝 𐴊𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴝𐴥 𐴁𐴝𐴏𐴝𐴘𐴓𐴡𐴘𐴝 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴝𐴈𐴝𐴤𐴘𐴃𐴡 𐴏𐴝𐴘𐴧𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤. 𐴔𐴡𐴃𐴞𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥 𐴁𐴞𐴐𐴞𐴤 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴐𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴔𐴠𐴏𐴝𐴥𐴘𐴧𐴝 𐴏𐴞𐴥𐴘𐴝𐴏𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴁𐴡𐴕𐴞𐴁𐴡𐴥. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴡𐴃𐴞𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</para>
  <para style="ip">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴡𐴃𐴞𐴃𐴢 𐴇𐴝𐴥𐴖𐴝𐴓𐴝 𐴊𐴞𐴥𐴘𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴉𐴟𐴌𐴝𐴕𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴀𐴝𐴘𐴝𐴃𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝, 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴒𐴡𐴔. 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴔𐴡𐴃𐴞 𐴘𐴞𐴁𐴝𐴤𐴘𐴠 𐴉𐴟𐴌𐴝𐴕𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌𐴠 𐴕𐴡𐴘𐴝 𐴕𐴞𐴘𐴡𐴔 𐴓𐴡𐴘 𐴎𐴟𐴌𐴝 𐴊𐴠. 𐴀𐴟𐴓𐴠𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴌𐴝𐴘 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, 𐴉𐴟𐴌𐴝𐴕𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴉𐴡𐴀𐴘𐴓𐴝𐴌 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴔𐴟𐴀𐴏𐴝𐴌 𐴃𐴡𐴌𐴝𐴃𐴢, 𐴔𐴡𐴃𐴞𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴔𐴡𐴎𐴞𐴕 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝 𐴓𐴠𐴑𐴞𐴥𐴃𐴡 𐴏𐴝𐴘𐴧𐴠𐴥. 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴀𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 <char style="ior">(<ref loc="MAT 5-7">5‏—7</ref>) </char> 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴀𐴏𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴊𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝 (𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 19:3—23:33).</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴎𐴡𐴌𐴔𐴡 <char style="ior">(<ref loc="MAT 1-2">1‏—2</ref>) </char></para>
  <para style="io1">2. 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 <char style="ior">(<ref loc="MAT 3:1-12">3‏:1‏-12</ref>)</char></para>
  <para style="io1">3. 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴝𐴥 <char style="ior">(<ref loc="MAT 3:13-4:11">3‏:13‏—4‏:11</ref>)</char></para>
  <para style="io1">4. 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴏𐴝𐴤𐴌 𐴈𐴝𐴔 <char style="ior">(<ref loc="MAT 4:12-18:35">4‏:12‏—18‏:35</ref>)</char></para>
  <para style="io1">5. 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴧𐴟 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴀𐴟𐴎𐴟 𐴀𐴞𐴏𐴝𐴤𐴌 𐴌𐴡𐴖𐴝𐴕𐴝 <char style="ior">(<ref loc="MAT 19-20">19‏—20</ref>)</char></para>
  <para style="io1">6. 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴇𐴝𐴥𐴉𐴃𐴝 <char style="ior">(<ref loc="MAT 21-27">21‏—27</ref>)</char></para>
  <para style="io1">7. 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴞𐴥𐴘𐴝 <char style="ior">(<ref loc="MAT 28">28</ref>)</char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴞𐴏𐴧𐴝𐴥𐴕</para>
  <para style="r">(<ref loc="LUK 3:23-38">𐴓𐴟𐴑 3‏:23‏-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤<note caller="+" style="f"><char style="fr" closed="false">1‏:1 </char><char style="fq">𐴔𐴡𐴀𐴏𐴞𐴤</char> <char style="ft" closed="false">𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴞𐴌𐴞𐴥𐴑 𐴓𐴡𐴉𐴎𐴡𐴥 𐴀𐴝𐴦𐴌 𐴇𐴞𐴁𐴌𐴟𐴤 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴔𐴠𐴏𐴝𐴥𐴘𐴧𐴝 𐴈𐴡𐴀, 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴖𐴝</char></note> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴀𐴡𐴌, 𐴀𐴝𐴦𐴌 𐴊𐴝𐴖𐴟𐴊𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴌. 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴞𐴏𐴧𐴝𐴥𐴕𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝:<verse eid="MAT 1:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑;</para>
  <para style="li2" vid="MAT 1:2">𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴝𐴑𐴟𐴁𐴢;</para>
  <para style="li2" vid="MAT 1:2">𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕.<verse eid="MAT 1:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="MAT 1:3" />𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌 𐴉𐴟𐴖𐴝 𐴉𐴝𐴌𐴠𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴌𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴝𐴦 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴃𐴝𐴔𐴝𐴌;</para>
  <para style="li2" vid="MAT 1:3">𐴉𐴝𐴌𐴠𐴏𐴡𐴌 𐴉𐴟𐴖𐴝 𐴇𐴞𐴏𐴌𐴡𐴕;</para>
  <para style="li2" vid="MAT 1:3">𐴇𐴞𐴏𐴌𐴡𐴕𐴡𐴌 𐴉𐴟𐴖𐴝 𐴌𐴝𐴔.<verse eid="MAT 1:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="MAT 1:4" />𐴌𐴝𐴔𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴔𐴧𐴞𐴕𐴝𐴊𐴝𐴁𐴢;</para>
  <para style="li2" vid="MAT 1:4">𐴀𐴝𐴔𐴧𐴞𐴕𐴝𐴊𐴝𐴁𐴡𐴌 𐴉𐴟𐴖𐴝 𐴕𐴝𐴐𐴡𐴕;</para>
  <para style="li2" vid="MAT 1:4">𐴕𐴝𐴐𐴡𐴕𐴡𐴌 𐴉𐴟𐴖𐴝 𐴏𐴝𐴥𐴓𐴔𐴡𐴕.<verse eid="MAT 1:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="MAT 1:5" />𐴏𐴝𐴥𐴓𐴔𐴡𐴕𐴡𐴌 𐴉𐴟𐴖𐴝 𐴁𐴡𐴀𐴝𐴎𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴝𐴦 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴌𐴝𐴇𐴝𐴥𐴁𐴝;</para>
  <para style="li2" vid="MAT 1:5">𐴁𐴡𐴀𐴝𐴎𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴡𐴁𐴠𐴊𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴝𐴦 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴌𐴟𐴀𐴃𐴢;</para>
  <para style="li2" vid="MAT 1:5">𐴀𐴡𐴁𐴠𐴊𐴡𐴌 𐴉𐴟𐴖𐴝 𐴅𐴠𐴏𐴞.<verse eid="MAT 1:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="MAT 1:6" />𐴅𐴠𐴏𐴞𐴌 𐴉𐴟𐴖𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴊𐴝𐴖𐴟𐴊𐴢.</para>
  <para style="b" vid="MAT 1:6" />
  <para style="li1" vid="MAT 1:6">𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝 𐴏𐴡𐴥𐴓𐴡𐴔𐴝𐴕, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴝𐴦 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴡𐴌𐴐𐴞𐴥𐴁𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴒𐴠 𐴀𐴟𐴌𐴞𐴘𐴝𐴌 𐴁𐴡𐴖𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MAT 1:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="MAT 1:7" />𐴏𐴡𐴥𐴓𐴡𐴔𐴝𐴕𐴡𐴌 𐴉𐴟𐴖𐴝 𐴌𐴠𐴇𐴡𐴁𐴡𐴔;</para>
  <para style="li2" vid="MAT 1:7">𐴌𐴠𐴇𐴡𐴁𐴡𐴔𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴁𐴞𐴘𐴝𐴤;</para>
  <para style="li2" vid="MAT 1:7">𐴀𐴝𐴁𐴞𐴘𐴝𐴤𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴏𐴝.<verse eid="MAT 1:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="MAT 1:8" />𐴀𐴝𐴏𐴝𐴌 𐴉𐴟𐴖𐴝 𐴅𐴠𐴇𐴡𐴥𐴐𐴝𐴉𐴝𐴃𐴢;</para>
  <para style="li2" vid="MAT 1:8">𐴅𐴠𐴇𐴡𐴥𐴐𐴝𐴉𐴝𐴃𐴡𐴌 𐴉𐴟𐴖𐴝 𐴅𐴡𐴌𐴝𐴔;</para>
  <para style="li2" vid="MAT 1:8">𐴅𐴡𐴌𐴝𐴔𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴟𐴎𐴞𐴘𐴝.<verse eid="MAT 1:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="MAT 1:9" />𐴀𐴟𐴎𐴞𐴘𐴝𐴌 𐴉𐴟𐴖𐴝 𐴅𐴡𐴃𐴝𐴔;</para>
  <para style="li2" vid="MAT 1:9">𐴅𐴡𐴃𐴝𐴔𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴇𐴝𐴤𐴎𐴢;</para>
  <para style="li2" vid="MAT 1:9">𐴀𐴝𐴇𐴝𐴤𐴎𐴡𐴌 𐴉𐴟𐴖𐴝 𐴈𐴠𐴥𐴎𐴠𐴑𐴞𐴘𐴝.<verse eid="MAT 1:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="MAT 1:10" />𐴈𐴠𐴥𐴎𐴠𐴑𐴞𐴘𐴝𐴌 𐴉𐴟𐴖𐴝 𐴔𐴝𐴕𐴝𐴏𐴠𐴥;</para>
  <para style="li2" vid="MAT 1:10">𐴔𐴝𐴕𐴝𐴏𐴠𐴥𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴔𐴡𐴕;</para>
  <para style="li2" vid="MAT 1:10">𐴀𐴝𐴔𐴡𐴕𐴡𐴌 𐴉𐴟𐴖𐴝 𐴅𐴡𐴏𐴞𐴥𐴘𐴝.<verse eid="MAT 1:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="MAT 1:11" />𐴅𐴡𐴏𐴞𐴥𐴘𐴝𐴌 𐴉𐴟𐴖𐴝 𐴅𐴠𐴑𐴡𐴕𐴞𐴥𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴣𐴃𐴧𐴠𐴤 𐴀𐴡𐴥𐴀𐴙𐴓𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴑𐴡𐴗𐴔𐴡𐴌𐴠 𐴁𐴡𐴕𐴊𐴞 𐴁𐴝𐴕𐴝𐴘 𐴁𐴝𐴁𐴞𐴓𐴡𐴕 𐴊𐴠𐴐𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴌.<verse eid="MAT 1:11" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="12" style="v" sid="MAT 1:12" />𐴀𐴞𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴕𐴊𐴞 𐴁𐴝𐴕𐴝𐴘 𐴁𐴝𐴁𐴞𐴓𐴡𐴕𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘 𐴁𐴝𐴦𐴊𐴠:</para>
  <para style="li2" vid="MAT 1:12">𐴅𐴠𐴑𐴡𐴕𐴞𐴥𐴘𐴝𐴌 𐴉𐴟𐴖𐴝 𐴐𐴝𐴥𐴓𐴃𐴞𐴘𐴠𐴓𐴢,</para>
  <para style="li2" vid="MAT 1:12">𐴐𐴝𐴥𐴓𐴃𐴞𐴘𐴠𐴓𐴡𐴌 𐴉𐴟𐴖𐴝 𐴎𐴠𐴌𐴟𐴁𐴝𐴁𐴠𐴓𐴢.<verse eid="MAT 1:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="MAT 1:13" />𐴎𐴠𐴌𐴟𐴁𐴝𐴁𐴠𐴓𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴁𐴞𐴇𐴟𐴥𐴊𐴢;</para>
  <para style="li2" vid="MAT 1:13">𐴀𐴝𐴁𐴞𐴇𐴟𐴥𐴊𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴠𐴓𐴞𐴘𐴝𐴑𐴞𐴥𐴔;</para>
  <para style="li2" vid="MAT 1:13">𐴀𐴠𐴓𐴞𐴘𐴝𐴑𐴞𐴥𐴔𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴎𐴡𐴌.<verse eid="MAT 1:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="MAT 1:14" />𐴀𐴝𐴎𐴡𐴌𐴡𐴌 𐴉𐴟𐴖𐴝 𐴏𐴝𐴥𐴊𐴡𐴑;</para>
  <para style="li2" vid="MAT 1:14">𐴏𐴝𐴥𐴊𐴡𐴑𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴑𐴞𐴔;</para>
  <para style="li2" vid="MAT 1:14">𐴀𐴝𐴑𐴞𐴔𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴠𐴓𐴞𐴇𐴟𐴥𐴊𐴢.<verse eid="MAT 1:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="MAT 1:15" />𐴀𐴠𐴓𐴞𐴇𐴟𐴥𐴊𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴠𐴓𐴞𐴘𐴝𐴎𐴝𐴌;</para>
  <para style="li2" vid="MAT 1:15">𐴀𐴠𐴓𐴞𐴘𐴝𐴎𐴝𐴌𐴡𐴌 𐴉𐴟𐴖𐴝 𐴔𐴝𐴃𐴝𐴕;</para>
  <para style="li2" vid="MAT 1:15">𐴔𐴝𐴃𐴝𐴕𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴝𐴑𐴟𐴁𐴢.<verse eid="MAT 1:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="MAT 1:16" />𐴀𐴝𐴦𐴌 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴘𐴟𐴏𐴟𐴥𐴉𐴢. 𐴇𐴠𐴥 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴃𐴧𐴟 𐴀𐴞𐴏𐴝𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴀𐴙𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴀.<verse eid="MAT 1:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴊𐴝𐴖𐴟𐴊𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴏𐴡𐴙𐴊𐴧𐴡𐴥 𐴉𐴞𐴏𐴧𐴝𐴥𐴕. 𐴊𐴝𐴖𐴟𐴊𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴁𐴝𐴁𐴞𐴓𐴡𐴕𐴡𐴃𐴢 𐴁𐴡𐴕𐴊𐴞𐴃𐴢 𐴓𐴡𐴘𐴎𐴝 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴏𐴡𐴙𐴊𐴧𐴡𐴥 𐴉𐴞𐴏𐴧𐴝𐴥𐴕; 𐴀𐴝𐴦𐴌 𐴁𐴡𐴕𐴊𐴞 𐴁𐴝𐴕𐴝𐴘 𐴁𐴝𐴁𐴞𐴓𐴡𐴕𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴔𐴡𐴀𐴏𐴞𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴏𐴡𐴙𐴊𐴧𐴡𐴥 𐴉𐴞𐴏𐴧𐴝𐴥𐴕.<verse eid="MAT 1:17" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴡𐴌𐴔𐴡</para>
  <para style="r">(<ref loc="LUK 2:1-7">𐴓𐴟𐴑 2‏:1‏-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴡𐴌𐴔𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴀𐴡𐴥𐴘𐴧𐴠: 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌 𐴎𐴟𐴌𐴝𐴒𐴝𐴃𐴝𐴤 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴓𐴡𐴥𐴘 𐴀𐴡𐴥𐴀𐴙𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴞𐴓𐴔𐴞𐴓𐴝𐴁𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴇𐴞𐴥𐴁𐴝 𐴇𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴉𐴝𐴦 𐴒𐴞𐴘𐴠𐴥. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />𐴇𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴐𐴡𐴥𐴌𐴡𐴔 𐴊𐴞𐴥𐴃𐴡 𐴔𐴡𐴕𐴠 𐴕𐴡 𐴈𐴡𐴀𐴌, 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴎𐴟𐴘𐴃𐴠𐴥𐴒𐴡𐴌𐴞 𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘 𐴕𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴥𐴉𐴠𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴀𐴠𐴑 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴐𐴡𐴥𐴂𐴧𐴡𐴕𐴡𐴃𐴢 𐴊𐴝𐴈𐴝𐴤 𐴊𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴘𐴟𐴏𐴟𐴥𐴉𐴢, 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴠𐴍𐴡𐴃𐴢 𐴎𐴠 𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴀𐴞𐴏𐴝𐴤<note caller="+" style="f"><char style="fr" closed="false">1‏:21 </char><char style="fq">𐴀𐴞𐴏𐴝𐴤</char> <char style="ft" closed="false">𐴕𐴝𐴔𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴘𐴝𐴥 𐴁𐴝𐴏𐴝𐴘𐴓𐴡𐴘𐴝 </char></note> 𐴌𐴝𐴑𐴞𐴥𐴁𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘𐴁𐴡𐴥.“<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴔𐴝𐴁𐴟𐴊𐴠 𐴕𐴡𐴁𐴞𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />”𐴏𐴡𐴀, 𐴀𐴠𐴑 𐴑𐴟𐴖𐴝𐴥𐴌𐴞<note caller="+" style="f"><char style="fr" closed="false">1‏:23 </char><char style="ft" closed="false">𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴔𐴞𐴓𐴝𐴁𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀 𐴊𐴠 </char><char style="fq">𐴑𐴟𐴖𐴝𐴥𐴌𐴞</char> </note> 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴇𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴝𐴔 𐴌𐴝𐴑𐴞𐴥𐴁𐴡 𐴊𐴠 𐴀𐴞𐴔𐴧𐴝𐴕𐴟𐴀𐴠𐴓𐴢,“<note caller="+" style="f"><char style="fr" closed="false">1‏:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 7:14">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 7‏:14</ref></char> </char></note> 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴃𐴡𐴌𐴅𐴟𐴔𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞.<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />𐴁𐴝𐴦𐴊𐴠 𐴘𐴟𐴏𐴟𐴥𐴉𐴠 𐴒𐴟𐴥𐴔𐴡𐴃𐴧𐴟 𐴀𐴟𐴍𐴞𐴤 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴓𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴎𐴡𐴌𐴔𐴡 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴔𐴞𐴓𐴝𐴁𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥. 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴕𐴝𐴔 𐴀𐴞𐴏𐴝𐴤 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴉𐴡𐴕𐴋𐴞𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴇𐴝𐴓𐴠, 𐴁𐴠𐴃𐴠𐴥𐴓𐴈𐴠𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴉𐴟𐴑 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴉𐴡𐴕𐴋𐴞𐴃𐴢 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴎𐴞𐴁𐴝𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴍𐴠𐴥؟ 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴟𐴑 𐴔𐴞𐴑𐴧𐴝𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴌𐴝 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠.“<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴈𐴠𐴥𐴌𐴟𐴊𐴢 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴥. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴊𐴡𐴓𐴝𐴒𐴡𐴌𐴞𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤 𐴇𐴡𐴍𐴠𐴥 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴏𐴝𐴘 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴁𐴠𐴃𐴠𐴥𐴓𐴈𐴠𐴔 𐴀𐴡𐴃𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴕𐴡𐴁𐴞𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴙𐴑𐴧𐴠𐴥:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />’𐴀𐴡𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴁𐴠𐴃𐴠𐴥𐴓𐴈𐴠𐴔,</para>
  <para style="q2" vid="MAT 2:6">𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴟𐴘 𐴇𐴡𐴕𐴡𐴤 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴐𐴡𐴥𐴣𐴍𐴡 𐴕𐴡;</para>
  <para style="q1" vid="MAT 2:6">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴀𐴕 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴝𐴘𐴁𐴡𐴤,</para>
  <para style="q2" vid="MAT 2:6">𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴕𐴊𐴝 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞𐴌𐴠 𐴏𐴡𐴌𐴝𐴘𐴁𐴡𐴥.‘ “<note caller="+" style="f"><char style="fr" closed="false">2‏:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="MIC 5:2">𐴔𐴞𐴑𐴝𐴘𐴝 5‏:2</ref>‏,<ref loc="MIC 5:4">4</ref></char> </char></note><verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴉𐴡𐴕𐴋𐴞𐴃𐴢 𐴄𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴠 𐴔𐴝𐴃𐴝𐴘 𐴎𐴝𐴕𐴞𐴓𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴃𐴝𐴌𐴝 𐴖𐴝 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴡𐴃𐴟𐴥𐴕𐴡𐴃𐴢 𐴊𐴝𐴈𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴁𐴠𐴃𐴠𐴥𐴓𐴈𐴠𐴔𐴡𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴘 𐴇𐴠𐴥 𐴒𐴟𐴌𐴝 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴒𐴡𐴌𐴞 𐴃𐴟𐴖𐴡𐴒𐴡𐴥𐴘. 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴥𐴁𐴡𐴌 𐴊𐴞𐴥𐴘𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞.“<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴁𐴝𐴐𐴝𐴥 𐴓𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴟𐴑 𐴔𐴞𐴑𐴧𐴝𐴥 𐴎𐴠 𐴃𐴝𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴘𐴞𐴥𐴁𐴝 𐴉𐴟𐴖𐴝 𐴖𐴝 𐴎𐴞𐴘𐴡𐴥𐴣𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴎𐴝𐴘 𐴕𐴡𐴥 𐴃𐴞𐴥𐴘𐴝 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴒𐴠-𐴀𐴝𐴒𐴠 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />𐴃𐴝𐴌𐴝 𐴖𐴝 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴊𐴡𐴌𐴁𐴝𐴀𐴌𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴡𐴥𐴌 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴞𐴘𐴡𐴌𐴠, 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴊𐴠𐴙𐴑𐴧𐴠𐴥; 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴠𐴍𐴞𐴃𐴢 𐴉𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴐𐴧𐴟𐴤 𐴒𐴟𐴥𐴕 𐴑𐴟𐴥𐴓𐴞 𐴐𐴟𐴥𐴕𐴝, 𐴓𐴟𐴁𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌 𐴀𐴝𐴣𐴃𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />𐴀𐴝𐴦𐴌 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴕𐴡 𐴎𐴝𐴘𐴃𐴡 𐴐𐴡𐴥𐴂𐴧𐴡𐴕𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴉𐴝𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌𐴀𐴠𐴑 𐴁𐴡𐴓𐴞 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴉𐴞𐴥𐴌𐴞 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="MAT 2:12" /></para>
  <para style="s1">𐴀𐴞𐴅𐴞𐴤𐴂𐴢 𐴊𐴠𐴐𐴡𐴃𐴢 𐴊𐴝𐴥𐴘𐴒𐴞𐴘𐴠𐴒𐴡𐴘</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />𐴉𐴡𐴕𐴋𐴞𐴃𐴢 𐴄𐴟𐴥𐴕 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴀𐴠𐴑 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌𐴠 𐴐𐴡𐴥𐴂𐴧𐴡𐴕𐴡𐴃𐴢 𐴊𐴝𐴈𐴝𐴤 𐴊𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴍𐴡𐴥, 𐴉𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦𐴌𐴠 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴅𐴞𐴤𐴂𐴡𐴃𐴢 𐴊𐴝𐴥𐴘𐴎𐴡𐴒𐴡𐴘. 𐴀𐴝𐴀𐴛 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴕𐴡𐴥 𐴈𐴡𐴀𐴘𐴢 𐴇𐴠𐴥𐴃𐴡𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴑𐴞𐴘𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴃𐴟𐴖𐴝𐴘𐴁𐴡𐴥.“<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴀𐴟𐴍𐴞𐴤 𐴌𐴝𐴙𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴉𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦𐴌𐴠 𐴓𐴡𐴦𐴘𐴢, 𐴀𐴞𐴅𐴞𐴤𐴂𐴡𐴓𐴧𐴝 𐴁𐴝𐴐𐴝𐴥 𐴓𐴡𐴥𐴘𐴧𐴠, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />𐴀𐴝𐴦𐴌 𐴈𐴠𐴥𐴌𐴟𐴊𐴢 𐴕𐴡𐴥 𐴔𐴡𐴌𐴠 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴔𐴝𐴁𐴟𐴊𐴠 𐴕𐴡𐴁𐴞𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥, ”𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴞𐴅𐴞𐴤𐴂𐴡𐴃𐴧𐴟 𐴋𐴝𐴈𐴝𐴘 𐴀𐴝𐴙𐴕𐴧𐴞𐴤.“<note caller="+" style="f"><char style="fr" closed="false">2‏:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 11:1">𐴇𐴡𐴥𐴐𐴞𐴘𐴝 11‏:1</ref></char></char></note><verse eid="MAT 2:15" /></para>
  <para style="s1">𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴡𐴕𐴋𐴞𐴃𐴢 𐴄𐴟𐴥𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴡𐴥𐴀𐴣𐴃𐴢 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴎𐴝𐴙𐴕𐴧𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴒𐴟𐴐𐴧𐴝𐴤 𐴀𐴟𐴙𐴄𐴧𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴉𐴡𐴕𐴋𐴞𐴃𐴢 𐴄𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴎𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴌 𐴈𐴡𐴃𐴝𐴤 𐴎𐴝𐴕𐴞𐴓𐴡𐴀𐴙𐴓𐴢 𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴌 𐴀𐴞𐴥𐴏𐴝𐴉𐴢 𐴔𐴡𐴎𐴞𐴕، 𐴁𐴠𐴃𐴠𐴥𐴓𐴈𐴠𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴎𐴝𐴒𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴊𐴟𐴘 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴘𐴝𐴥𐴌 𐴕𐴞𐴏𐴡𐴌 𐴎𐴠𐴊𐴟𐴥𐴕 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴕𐴡𐴁𐴞 𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴧𐴠,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />”𐴌𐴝𐴔𐴝𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴝 𐴒𐴞𐴥𐴘𐴠,</para>
  <para style="q2" vid="MAT 2:18">𐴈𐴝𐴣𐴊𐴝𐴕𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴞𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴌.</para>
  <para style="q1" vid="MAT 2:18">𐴌𐴝𐴇𐴠𐴥𐴓𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴓𐴧𐴝 𐴈𐴝𐴣𐴊𐴠𐴌,</para>
  <para style="q2" vid="MAT 2:18">𐴀𐴝𐴦𐴌 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥𐴌,</para>
  <para style="q2" vid="MAT 2:18">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌 𐴕𐴝𐴥𐴘.“<note caller="+" style="f"><char style="fr" closed="false">2‏:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:15">𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝 31‏:15</ref></char> </char></note><verse eid="MAT 2:18" /></para>
  <para style="s1">𐴀𐴞𐴅𐴞𐴤𐴂𐴡𐴃𐴧𐴟 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴈𐴠𐴥𐴌𐴟𐴊𐴢 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴀𐴠𐴑 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌𐴠 𐴀𐴞𐴅𐴞𐴤𐴂𐴡𐴃𐴢 𐴐𐴡𐴥𐴂𐴧𐴡𐴕𐴡𐴃𐴢 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴍𐴡𐴥, 𐴉𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦𐴌𐴠 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴎𐴡𐴦𐴒𐴡𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴑𐴞 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴃𐴟𐴖𐴝𐴀𐴙𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘.“<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />𐴃𐴡𐴥𐴘 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴀𐴟𐴍𐴞𐴤, 𐴉𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦𐴌𐴠 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴀𐴝𐴌𐴑𐴠𐴓𐴝𐴘𐴡𐴏𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴢 𐴃𐴝𐴌 𐴁𐴝𐴉𐴢 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘𐴃𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴠𐴥. 𐴁𐴝𐴦𐴊𐴠 𐴐𐴡𐴥𐴂𐴧𐴡𐴕𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴉𐴝𐴘, 𐴒𐴝𐴓𐴞𐴓𐴢 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />𐴀𐴝𐴦𐴌 𐴎𐴝𐴘 𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴢 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴁𐴡𐴐𐴡𐴥𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥, ”𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴝𐴏𐴝𐴥𐴌𐴞 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴁𐴡.“<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑</para>
  <para style="r">(<ref loc="MRK 1:1-8">𐴔𐴝𐴑 1‏:1‏-8</ref>; <ref loc="LUK 3:1-9">𐴓𐴟𐴑 3‏:1‏-9</ref>‏,<ref loc="LUK 3:15-17">15‏-17</ref>; <ref loc="JHN 1:19-28">𐴘𐴡 1‏:19‏-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴀𐴝𐴀𐴘𐴢, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴌 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />”𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡<note caller="+" style="f"><char style="fr" closed="false">3‏:2 </char><char style="ft" closed="false">𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡. 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴝𐴔 𐴊𐴡𐴥𐴙𐴃𐴧𐴠 𐴋𐴡𐴦𐴌𐴝 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴞𐴑𐴧𐴝𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴕𐴡 𐴈𐴡𐴀𐴘𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴓𐴡𐴦𐴃𐴉𐴝 𐴎𐴝. </char></note> 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘.“ <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴘𐴠 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠,</para>
  <para style="q1" vid="MAT 3:3">”𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌,</para>
  <para style="q1" vid="MAT 3:3">’𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴉𐴡𐴣𐴃𐴢 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴡𐴤;</para>
  <para style="q2" vid="MAT 3:3">𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴏𐴃𐴝 𐴀𐴟𐴎𐴟 𐴒𐴡𐴌𐴡𐴤.‘ “<note caller="+" style="f"><char style="fr" closed="false">3‏:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 40‏:3</ref></char></char></note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴀𐴟𐴣𐴄𐴡𐴌 𐴑𐴠𐴣𐴐𐴢 𐴓𐴡𐴘 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴇𐴡𐴦𐴌 𐴉𐴞𐴣𐴊𐴞𐴥𐴃𐴡, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴑𐴠𐴣𐴙𐴓𐴡𐴃𐴢 𐴏𐴝𐴔𐴝𐴌𐴝𐴌 𐴊𐴟𐴖𐴝𐴓𐴞 𐴁𐴝𐴙𐴕𐴊𐴝𐴤 𐴃𐴝𐴥𐴑𐴞𐴃𐴡. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴈𐴝𐴥𐴕𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴉𐴞𐴥𐴌𐴞𐴚 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴦𐴣𐴓𐴡𐴌 𐴔𐴡𐴊𐴟𐴥. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴀𐴡𐴃𐴧𐴟, 𐴃𐴝𐴔𐴝𐴥𐴔 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴃𐴧𐴟, 𐴀𐴠𐴊𐴧𐴠 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴞𐴦𐴘𐴠𐴥, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝<note caller="+" style="f"><char style="fr" closed="false">3‏:6 </char><char style="fq">𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝</char> <char style="ft" closed="false">𐴔𐴝𐴀𐴕𐴞 𐴉𐴝𐴕𐴞𐴥𐴌 𐴋𐴟𐴂𐴢 𐴓𐴡𐴦𐴕</char></note> 𐴓𐴡𐴘𐴧𐴠𐴥.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴃𐴡 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴇𐴝𐴥𐴉𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢! 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴃𐴧𐴟 𐴊𐴝𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴞𐴥𐴘𐴠؟ <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />𐴃𐴡𐴖𐴝𐴥 𐴓𐴡𐴥𐴘 𐴔𐴞𐴓𐴢 𐴇𐴝𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴡𐴥𐴌𐴡, <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴕𐴟 𐴀𐴝𐴙𐴕𐴧𐴡𐴤 𐴊𐴠 𐴑𐴞, ’𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴃𐴡 𐴁𐴝𐴉𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔 𐴀𐴝𐴏𐴠𐴤.‘ 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴏𐴝𐴘𐴓𐴠𐴥 𐴀𐴠 𐴐𐴞𐴥𐴓𐴢 𐴓𐴟𐴕𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴓𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />𐴀𐴝𐴦𐴌 𐴀𐴠𐴇𐴡𐴥𐴕 𐴃𐴡 𐴒𐴝𐴏𐴡𐴌 𐴒𐴟𐴌𐴝𐴃𐴢 𐴑𐴟𐴌𐴡𐴥𐴙𐴓𐴢 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴘𐴠. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠 𐴒𐴝𐴏𐴡𐴃𐴢 𐴒𐴡𐴔 𐴒𐴟𐴓𐴝 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠, 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴝𐴍𐴞 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />𐴀𐴝𐴀𐴛 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴁𐴝𐴦𐴊𐴠 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴑𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌. 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴠𐴕𐴄𐴝𐴥𐴌 𐴁𐴡𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴦𐴙𐴕 𐴓𐴡𐴘 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴁𐴡. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴑𐴟𐴓𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴣𐴓𐴝𐴌𐴠 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴒𐴡𐴌𐴞 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴞𐴣𐴘𐴟𐴌𐴠 𐴒𐴟𐴊𐴝𐴔𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴟𐴖𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴕𐴞𐴉𐴠𐴥 𐴊𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴟𐴌𐴝𐴃𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡.“<verse eid="MAT 3:12" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝</para>
  <para style="r">(<ref loc="MRK 1:9-11">𐴔𐴝𐴑 1‏:9‏-11</ref>; <ref loc="LUK 3:21">𐴓𐴟𐴑 3‏:21</ref>‏,<ref loc="LUK 3:22">22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴃𐴡 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴧𐴟 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, ”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴠𐴥𐴕𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴡𐴥 𐴊𐴠𐴥؟“<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴁𐴝𐴌 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴘𐴃𐴡 𐴊𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴧𐴟, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴏𐴝𐴀𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌.“</char> 𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴌𐴝𐴎𐴞 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘 𐴔𐴡𐴃𐴧𐴡𐴌, 𐴉𐴝𐴕𐴞𐴥𐴃𐴧𐴟 𐴑𐴟𐴓𐴡𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴝𐴘. 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴔𐴝𐴕 𐴑𐴟𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀 𐴈𐴡𐴘𐴃𐴡𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘 𐴓𐴝𐴔𐴞 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴧𐴠𐴥𐴌. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴖𐴝, 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞.“<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 1:12-13">𐴔𐴝𐴑 1‏:12‏-13</ref>; <ref loc="LUK 4:1-13">𐴓𐴟𐴑 4‏:1‏-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴠𐴥. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />𐴏𐴝𐴓𐴞𐴐𐴢 𐴊𐴞𐴕 𐴏𐴝𐴓𐴞𐴐𐴢 𐴌𐴝𐴙𐴃𐴢 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴁𐴟𐴥𐴑 𐴓𐴝𐴙𐴒𐴧𐴠𐴥. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴠𐴕𐴃𐴝𐴥𐴕-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴌𐴟𐴄𐴞 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴡𐴥.“<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ’𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴌𐴟𐴄𐴞 𐴓𐴡𐴘 𐴁𐴝𐴏𐴠 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴑𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴠 𐴊𐴠 𐴇𐴝𐴥𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴥𐴘 𐴁𐴠 𐴁𐴝𐴏𐴠.‘ “</char><note caller="+" style="f"><char style="fr" closed="false">4‏:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 8:3">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 8‏:3</ref></char></char></note> <verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />𐴃𐴡𐴥𐴘 𐴇𐴠𐴥 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴂𐴝𐴑 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘, 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴃𐴟𐴓𐴧𐴞𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴒𐴝𐴌𐴝𐴘𐴧𐴠, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴕𐴞𐴏𐴠 𐴎𐴝𐴥𐴂𐴢 𐴔𐴝𐴌𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="MAT 4:6">’𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴁𐴡;</para>
  <para style="q2" vid="MAT 4:6">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴁𐴡,</para>
  <para style="q2" vid="MAT 4:6">𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴄𐴠𐴥𐴚𐴠 𐴇𐴡𐴕𐴡𐴤 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴃𐴢 𐴊𐴟𐴑 𐴕𐴡 𐴉𐴝𐴦.‘ “<note caller="+" style="f"><char style="fr" closed="false">4‏:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 91:11">𐴎𐴡𐴁𐴟𐴌 91‏:11</ref>‏,<ref loc="PSA 91:12">12</ref></char></char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, ’𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴝𐴁𐴟𐴊𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘ “</char><note caller="+" style="f"><char style="fr" closed="false">4‏:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:16">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 6‏:16</ref></char></char></note><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘, 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴉𐴟𐴌𐴝 𐴐𐴝𐴥𐴀𐴕𐴊𐴝𐴌𐴞 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴠. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴔𐴠𐴍𐴞𐴃𐴢 𐴉𐴡𐴌𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴟𐴔.“<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴐𐴡𐴥𐴘𐴃𐴝𐴕, 𐴊𐴟𐴌 𐴀𐴡𐴥! 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ’𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴝𐴁𐴟𐴊𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴁𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘ “</char><note caller="+" style="f"><char style="fr" closed="false">4‏:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:13">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 6‏:13</ref></char></char></note><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴌𐴞 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MAT 4:11" /></para>
  <para style="s1">𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴈𐴝𐴔𐴡𐴌 𐴐𐴟𐴥𐴌𐴟</para>
  <para style="r">(<ref loc="MRK 1:14-15">𐴔𐴝𐴑 1‏:14‏-15</ref>; <ref loc="LUK 4:14-15">𐴓𐴟𐴑 4‏:14‏-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴡𐴥𐴘; <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />𐴀𐴝𐴦𐴌 𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴢 𐴐𐴡𐴥𐴀𐴌 𐴉𐴠𐴥𐴓𐴝𐴘, 𐴎𐴠𐴁𐴟𐴓𐴟𐴕 𐴀𐴠𐴊𐴧𐴠 𐴕𐴝𐴉𐴄𐴝𐴓𐴞𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴋𐴞𐴀𐴌 𐴇𐴝𐴣𐴏𐴝 𐴓𐴡𐴘 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴎𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠𐴒𐴡𐴘. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />”𐴎𐴠𐴁𐴟𐴓𐴟𐴕𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴕𐴝𐴉𐴄𐴝𐴓𐴞𐴌 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢,</para>
  <para style="q2" vid="MAT 4:15">𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴌𐴝𐴏𐴃𐴝𐴃𐴢, 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴌 𐴀𐴡𐴑𐴟𐴓𐴠,</para>
  <para style="q2" vid="MAT 4:15">𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴝𐴓𐴞𐴓𐴢 𐴀𐴡𐴃𐴢,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢,</para>
  <para style="q2" vid="MAT 4:16">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴋𐴡𐴣𐴀𐴌 𐴉𐴡𐴀𐴌 𐴊𐴠𐴙𐴑𐴧𐴠𐴥,</para>
  <para style="q1" vid="MAT 4:16">𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴦𐴃𐴡𐴌 𐴀𐴝𐴕𐴊𐴝𐴤𐴙𐴅𐴝 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢,</para>
  <para style="q2" vid="MAT 4:16">𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴡𐴀𐴌 𐴀𐴡𐴥𐴘𐴧𐴠.“<note caller="+" style="f"><char style="fr" closed="false">4‏:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 9:1">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 9‏:1</ref>‏,<ref loc="ISA 9:2">2</ref></char></char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, <char style="wj">”𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘.“</char><verse eid="MAT 4:17" /></para>
  <para style="s1">𐴐𐴟𐴥𐴌𐴟𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 1:16-20">𐴔𐴝𐴑 1‏:16‏-20</ref>; <ref loc="LUK 5:1-11">𐴓𐴟𐴑 5‏:1‏-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />𐴀𐴞𐴏𐴝𐴤 𐴒𐴝𐴓𐴞𐴓𐴢 𐴋𐴞𐴀𐴌 𐴇𐴝𐴣𐴏𐴝 𐴁𐴝𐴥𐴘 𐴀𐴝𐴥𐴣𐴍𐴞 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴟𐴖𐴝𐴥 𐴁𐴝𐴥𐴘 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴉𐴞𐴃𐴡𐴌 𐴋𐴝𐴙𐴑𐴧𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴥𐴘 𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴢 𐴀𐴡𐴌𐴠. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴞𐴀𐴃𐴢 𐴎𐴝𐴓𐴢 𐴔𐴝𐴌𐴠𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴙𐴓𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴡𐴥𐴌𐴠 𐴊𐴠 𐴎𐴝𐴙𐴓𐴧𐴝 𐴁𐴝𐴕𐴝𐴘𐴧𐴟𐴥𐴔.“</char> <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴝𐴓𐴢 𐴓𐴟𐴕 𐴀𐴠𐴌𐴞, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />𐴇𐴞𐴥𐴘𐴝𐴕𐴃𐴟 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴊𐴧𐴟𐴥𐴌 𐴒𐴞𐴦𐴘𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴌𐴡𐴤 𐴊𐴟𐴘 𐴁𐴝𐴥𐴘 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌 𐴉𐴟𐴖𐴝 𐴘𐴝𐴑𐴟𐴁𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴥𐴘 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴌𐴠. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡𐴦𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴓𐴢 𐴄𐴟𐴕𐴠𐴌. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴃𐴝𐴘𐴧𐴠𐴥, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴡𐴦 𐴒𐴝𐴥𐴕 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴉𐴡𐴌𐴠 𐴀𐴠𐴌𐴞, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MAT 4:22" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴡𐴔 𐴒𐴡𐴌𐴝𐴥</para>
  <para style="r">(<ref loc="LUK 6:17-19">𐴓𐴟𐴑 6‏:17‏-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴎𐴝𐴘-𐴎𐴝𐴘 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴃𐴡 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴀𐴡𐴐𐴟𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴏𐴞𐴀𐴌𐴞𐴘𐴝𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴉𐴡𐴥𐴓𐴞𐴒𐴞𐴓𐴒𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴝𐴏𐴠𐴤 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴑 𐴉𐴝𐴦𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴏𐴟𐴥𐴖𐴝𐴣𐴉𐴞𐴥𐴌𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴃𐴟𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />𐴒𐴝𐴓𐴞𐴓𐴢 𐴀𐴡𐴃𐴧𐴟, 𐴊𐴠𐴑𐴝𐴂𐴡𐴥𐴓𐴞𐴏𐴢<note caller="+" style="f"><char style="fr" closed="false">4‏:25 </char><char style="fq">𐴊𐴠𐴑𐴝𐴂𐴡𐴥𐴓𐴞𐴏𐴢</char> <char style="ft" closed="false">𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴒𐴞𐴌𐴞𐴥𐴑 𐴓𐴡𐴉𐴎𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴔𐴝𐴀𐴕𐴞 𐴊𐴡𐴐𐴢 𐴐𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝</char></note> 𐴀𐴡𐴃𐴧𐴟, 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴀𐴡𐴃𐴧𐴟, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴃𐴧𐴟, 𐴀𐴠𐴊𐴧𐴠 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴌 𐴉𐴝𐴌𐴑𐴟𐴓𐴡𐴃𐴧𐴟 𐴊𐴡𐴓𐴢-𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴞𐴓𐴢.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴃𐴝𐴦𐴓𐴞𐴔</para>
  <para style="r">(<ref loc="MAT 5-7">𐴔𐴡𐴃𐴢 5‏—7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴁𐴡𐴙𐴐𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴦 𐴑𐴟𐴥𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠:<verse eid="MAT 5:2" /></para>
  <para style="s1">𐴔𐴟𐴁𐴝𐴌𐴠𐴑</para>
  <para style="r">(<ref loc="LUK 6:20-23">𐴓𐴟𐴑 6‏:20‏-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />
    <char style="wj">”𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴒𐴡𐴌𐴞𐴉𐴢,</char></para>
  <para style="q2" vid="MAT 5:3">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌.</char><verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />
    <char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢 𐴀𐴝𐴏𐴠𐴤,</char></para>
  <para style="q2" vid="MAT 5:4">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴉𐴝𐴘𐴁𐴡.</char><verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />
    <char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴐𐴞𐴥𐴊𐴝,</char></para>
  <para style="q2" vid="MAT 5:5">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴘𐴁𐴡.</char><verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />
    <char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴁𐴟𐴥𐴑𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴃𐴞𐴌𐴝𐴥𐴐𐴞,</char></para>
  <para style="q2" vid="MAT 5:6">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥 𐴔𐴡𐴕𐴐𐴝𐴥 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.</char><verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />
    <char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴌𐴝𐴇𐴝𐴥𐴔 𐴊𐴞𐴓𐴢 𐴀𐴡𐴓𐴝,</char></para>
  <para style="q2" vid="MAT 5:7">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />
    <char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴊𐴞𐴓𐴢 𐴏𐴝𐴥𐴉𐴢,</char></para>
  <para style="q2" vid="MAT 5:8">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥𐴁𐴡.</char><verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />
    <char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴏𐴡𐴥𐴓𐴧𐴟𐴑 𐴒𐴡𐴌𐴞𐴥𐴊𐴠,</char></para>
  <para style="q2" vid="MAT 5:9">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />
    <char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴌𐴡𐴤𐴕𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴉𐴝𐴦,</char></para>
  <para style="q2" vid="MAT 5:10">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌.“</char><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />
    <char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴕𐴝 𐴇𐴡𐴥𐴑𐴧𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴟𐴌𐴝-𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡𐴀.</char> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴋𐴡𐴣𐴀𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴀𐴝𐴏𐴠𐴤. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴒𐴠 𐴎𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.</char><verse eid="MAT 5:12" /></para>
  <para style="s1">𐴕𐴟𐴕 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴀𐴌</para>
  <para style="r">(<ref loc="MRK 9:50">𐴔𐴝𐴑 9‏:50</ref>; <ref loc="LUK 14:34-35">𐴓𐴟𐴑 14‏:34‏-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴟𐴕; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴕𐴟𐴕𐴡𐴌 𐴊𐴡𐴑 𐴎𐴝𐴦𐴒𐴡𐴥𐴘, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴝𐴁𐴝𐴌 𐴕𐴟𐴕𐴐𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴝 𐴎𐴝𐴘𐴁𐴡؟ 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴈𐴝𐴔𐴡𐴃𐴢 𐴕𐴟 𐴀𐴝𐴘𐴧𐴠𐴤. 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴝𐴀𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴀𐴟𐴥𐴣𐴌𐴝𐴕𐴡𐴃𐴢 𐴉𐴡𐴌𐴠.</char><verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴟𐴌. 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴝𐴣𐴊𐴝𐴤 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴐𐴡𐴥𐴀𐴌 𐴃𐴡 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴑𐴞𐴥 𐴉𐴝𐴌𐴝 𐴕𐴡 𐴎𐴝.</char> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" /><char style="wj">𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴏𐴠𐴌𐴝𐴑 𐴊𐴡𐴥𐴌𐴝𐴘 𐴁𐴝𐴥𐴙𐴌𐴡𐴌 𐴃𐴡𐴓𐴠 𐴌𐴝𐴑𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞𐴌 𐴖𐴡𐴌𐴠 𐴁𐴠 𐴌𐴝𐴑𐴠𐴥, 𐴃𐴡𐴥𐴘 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴉𐴡𐴀𐴌 𐴊𐴠𐴥.</char> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴡𐴀𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴎𐴡𐴓𐴡𐴗𐴑, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴠𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴒𐴡𐴌𐴠𐴥. </char><verse eid="MAT 5:16" /></para>
  <para style="s1">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴄𐴝𐴥𐴀𐴙𐴅𐴧𐴡 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴔𐴟𐴀𐴏𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴘𐴝𐴥 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴞𐴥𐴑𐴧𐴝 𐴁𐴝𐴦𐴃𐴠𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴞𐴤. 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴦𐴃𐴠𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴟𐴌𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠.</char> <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴀𐴝𐴏𐴔𐴝𐴕 𐴎𐴡𐴁𐴞𐴕 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴡𐴥 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴈𐴠𐴥𐴕𐴃𐴟 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴑𐴃𐴝𐴤 𐴘𐴝𐴥 𐴎𐴠𐴌 𐴎𐴡𐴁𐴡𐴌 𐴕𐴡 𐴁𐴟𐴥𐴎𐴞𐴁𐴡 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴌𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡.</char> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴁𐴧𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴌𐴠 𐴁𐴝𐴦𐴃𐴠𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴝𐴦𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴐𐴞𐴥𐴑𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴀𐴠𐴁𐴧𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴐𐴞𐴥𐴑𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴋𐴡𐴣𐴀𐴌 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="MAT 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 5:20" />
    <char style="wj">”𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴕𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴒𐴡𐴥𐴓𐴞 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥. </char><verse eid="MAT 5:20" /></para>
  <para style="s1">𐴒𐴟𐴐𐴧𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴝 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴒𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢, ’𐴑𐴟𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝,</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5‏:21 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="EXO 20:13">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 20‏:13</ref>
        </char> </char>
    </note> <char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴟𐴥𐴕 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴝𐴊𐴝𐴓𐴡𐴃𐴡𐴃𐴢 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.‘</char> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘</char><note caller="+" style="f"><char style="fr" closed="false">5‏:22 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴟𐴕𐴞𐴥 𐴒𐴟𐴥𐴕 𐴒𐴡𐴥𐴓𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴃𐴎𐴞𐴥𐴘𐴝𐴙𐴕; 𐴓𐴡𐴉𐴎𐴡𐴥 𐴘𐴞𐴥𐴁𐴝 𐴀𐴝𐴘𐴝𐴃𐴢 23 𐴀𐴡𐴃𐴢 𐴀𐴡𐴥 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠</char></note> <char style="wj">𐴀𐴡𐴌 𐴖𐴡𐴌𐴠 𐴒𐴟𐴐𐴧𐴝𐴤 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴝𐴊𐴝𐴓𐴡𐴃𐴡𐴃𐴢 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘 𐴀𐴡𐴌𐴠, ’𐴃𐴟𐴘 𐴁𐴠𐴇𐴝𐴎𐴡𐴌‘ 𐴈𐴡𐴀, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴁𐴡𐴌 𐴀𐴝𐴊𐴝𐴓𐴡𐴃𐴡𐴃𐴢 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘 𐴀𐴡𐴌𐴠, ’𐴃𐴟𐴘 𐴁𐴠𐴑𐴟𐴉𐴢‘ 𐴈𐴡𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴎𐴟𐴎𐴟𐴑𐴡𐴌 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴏𐴝𐴥𐴣𐴎𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴀𐴡𐴥𐴘𐴁𐴡.</char><verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴀𐴛 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴖𐴡𐴌𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴐𐴧𐴡𐴃𐴢, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴍𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴡𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴓𐴋𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴀𐴝𐴏𐴠𐴤,</char> <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" /><char style="wj">𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴇𐴠𐴥 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴠𐴌𐴞 𐴎𐴝𐴘𐴧𐴡𐴒𐴡𐴥𐴘. 𐴎𐴝𐴘𐴧𐴡𐴌𐴠 𐴀𐴝𐴒𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘 𐴓𐴡𐴥𐴘 𐴁𐴡𐴕𐴞𐴎𐴡𐴒𐴡𐴥𐴘, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴘𐴡𐴒𐴝𐴥𐴘.</char><verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴥𐴘 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴔𐴝𐴦𐴔𐴠𐴓𐴝 𐴇𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴡, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴅𐴡𐴐𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴅𐴡𐴐𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴉𐴟𐴓𐴞𐴐𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴁𐴡, 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴉𐴡𐴘𐴐𐴝𐴤 𐴕𐴡𐴥 𐴊𐴡𐴦 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴈𐴠𐴥𐴕𐴃𐴟 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.</char><verse eid="MAT 5:26" /></para>
  <para style="s1">𐴎𐴠𐴕𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴝, ’𐴎𐴠𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5‏:27 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="EXO 20:14">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 20‏:14</ref>
        </char>
      </char>
    </note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌𐴠 𐴁𐴟𐴌𐴝 𐴑𐴞𐴥𐴘𐴝𐴓𐴠 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴇𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.</char> <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" /><char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴌 𐴏𐴟𐴑𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴟𐴎𐴟 𐴄𐴝𐴕𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴘𐴞𐴥𐴁𐴝 𐴕𐴠𐴦𐴓𐴝𐴘 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴡. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴟𐴣𐴍𐴝 𐴒𐴝𐴦 𐴎𐴟𐴎𐴟𐴑𐴡𐴃𐴢 𐴎𐴝𐴦𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴝𐴦𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴇𐴞𐴥𐴏𐴧𐴝 𐴕𐴡 𐴃𐴝𐴥𐴑𐴡𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌.</char> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" /><char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴟𐴎𐴟 𐴄𐴝𐴕𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴝𐴍𐴞 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴡. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴟𐴣𐴍𐴝 𐴒𐴝𐴦 𐴎𐴟𐴎𐴟𐴑𐴡𐴃𐴢 𐴎𐴝𐴦𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴝𐴦𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴇𐴞𐴥𐴏𐴧𐴝 𐴕𐴡 𐴃𐴝𐴥𐴑𐴡𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌.</char><verse eid="MAT 5:30" /></para>
  <para style="s1">𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="MAT 19:9">𐴔𐴡𐴃𐴢 19‏:9</ref>; <ref loc="MRK 10:11-12">𐴔𐴝𐴑 10‏:11‏-12</ref>; <ref loc="LUK 16:18">𐴓𐴟𐴑 16‏:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />
    <char style="wj">”𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴥 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢, ’𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴡𐴌𐴠 𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴝𐴥𐴌𐴇𐴝𐴁𐴡𐴏𐴢 𐴊𐴡𐴑.‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5‏:31 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="DEU 24:1">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 24‏:1</ref>
        </char>
      </char>
    </note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴡𐴌𐴠 𐴎𐴠𐴕𐴝𐴤𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴓𐴡𐴥𐴘 𐴁𐴝𐴊𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴓𐴡𐴥𐴘 𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥𐴁𐴝; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥. </char><verse eid="MAT 5:32" /></para>
  <para style="s1">𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴌𐴡𐴤 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴝 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴒𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢, ’𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴏𐴡𐴥𐴔 𐴕𐴝 𐴇𐴝𐴥𐴘𐴧𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴀𐴛 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘𐴧𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘ </char> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴈𐴡𐴏𐴡𐴥𐴔 𐴕𐴝 𐴇𐴝𐴥𐴘𐴧𐴡, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴕𐴝𐴔𐴠 𐴘𐴡𐴥 𐴕𐴝 𐴇𐴝𐴥𐴘𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴑𐴃𐴡𐴥.</char> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" /><char style="wj">𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴕𐴝𐴔𐴠 𐴘𐴡𐴥 𐴕𐴝 𐴇𐴝𐴥𐴘𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴦 𐴌𐴝𐴑𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴚𐴒𐴟𐴥. 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴕𐴝𐴔𐴠 𐴘𐴡𐴥 𐴕𐴝 𐴇𐴝𐴥𐴘𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴐𐴡𐴥𐴀𐴌. </char> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" /><char style="wj">𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥 𐴊𐴡𐴥𐴌𐴞 𐴘𐴡𐴥 𐴈𐴡𐴏𐴡𐴥𐴔 𐴕𐴝 𐴇𐴝𐴥𐴘𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴓𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴊𐴡𐴥𐴓𐴝 𐴘𐴝𐴥 𐴇𐴝𐴓𐴝 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴡.</char> <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴕𐴝𐴤 𐴀𐴠𐴊𐴧𐴟𐴥𐴌 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴀𐴡𐴥𐴘𐴓𐴠 ’𐴀𐴡𐴥𐴘‘ 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴡𐴥𐴘𐴓𐴠 ’𐴕𐴡,‘ 𐴘𐴝𐴥𐴌 𐴁𐴝𐴀𐴌𐴠 𐴎𐴞𐴀𐴕 𐴀𐴝𐴘𐴧𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟. </char><verse eid="MAT 5:37" /></para>
  <para style="s1">𐴁𐴡𐴊𐴡𐴓𐴝 𐴓𐴡𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="LUK 6:29-30">𐴓𐴟𐴑 6‏:29‏-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴝, ’𐴏𐴟𐴑𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴏𐴟𐴑, 𐴀𐴝𐴦𐴌 𐴊𐴝𐴃𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴊𐴝𐴃𐴢.‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5‏:38 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="EXO 21:24">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 21‏:24</ref>
        </char>; <char style="xt"><ref loc="LEV 24:20">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 24‏:20</ref></char>; <char style="xt"><ref loc="DEU 19:21">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 19‏:21</ref></char></char>
    </note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴥𐴘 𐴔𐴟𐴑𐴝𐴁𐴠𐴓𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴌 𐴒𐴝𐴓𐴏𐴝𐴁𐴝 𐴏𐴝𐴥𐴘 𐴏𐴟𐴖𐴝𐴌 𐴔𐴝𐴌𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴡 𐴋𐴝𐴥𐴑 𐴀𐴡𐴥 𐴉𐴞𐴥𐴌𐴝𐴘𐴊𐴞𐴘𐴡.</char> <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴟𐴌𐴟𐴃𐴝 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴔𐴡𐴦𐴊𐴧𐴞𐴔𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴝𐴊𐴧𐴡𐴌 𐴀𐴡𐴥 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴡. </char> <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" /><char style="wj">𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴠𐴑 𐴔𐴝𐴙𐴓𐴢 𐴎𐴝𐴘𐴃𐴡 𐴁𐴡𐴓𐴝𐴎𐴟𐴌𐴞 𐴒𐴡𐴙𐴓𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴊𐴟𐴘 𐴔𐴝𐴙𐴓𐴢 𐴎𐴝𐴘𐴧𐴡.</char> <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴔𐴝𐴒𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴟𐴊𐴝𐴥𐴌 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴕𐴡 𐴉𐴞𐴥𐴌𐴝𐴘𐴧𐴡. </char><verse eid="MAT 5:42" /></para>
  <para style="s1">𐴊𐴟𐴐𐴧𐴡𐴕𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤</para>
  <para style="r">(<ref loc="LUK 6:27-28">𐴓𐴟𐴑 6‏:27‏-28</ref>‏,<ref loc="LUK 6:32-36">32‏-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴝, ’𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝,</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5‏:43 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="LEV 19:18">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 19‏:18</ref>
        </char> </char>
    </note> <char style="wj">𐴀𐴝𐴦𐴌 𐴊𐴟𐴐𐴧𐴡𐴕𐴡𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘</char> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥,</char> <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" /><char style="wj">𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴄𐴡𐴥𐴀𐴌𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴒𐴡𐴔 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴊𐴟𐴕𐴞𐴥 𐴒𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴠𐴙𐴓𐴡𐴌 𐴉𐴡𐴀𐴌 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴡𐴥𐴌 𐴊𐴞𐴉𐴠𐴍𐴝𐴥.</char> <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" /><char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴟𐴥𐴊𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴏𐴟𐴥𐴖𐴝𐴁𐴢 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴉𐴝𐴘𐴁𐴝؟ 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴑𐴞𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴕𐴠𐴥؟</char> <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴟𐴥𐴊𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴡𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴑𐴞𐴦 𐴒𐴡𐴌𐴡𐴤𐴌؟ 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴑𐴞𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴕𐴠𐴥؟</char> <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴢 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴏𐴡𐴥𐴘𐴧𐴞, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴡𐴥.“</char><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">𐴏𐴡𐴥𐴃𐴑𐴝 𐴊𐴞𐴦𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />
    <char style="wj">”𐴇𐴡𐴥𐴁𐴡𐴌𐴡𐴊𐴧𐴝𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴈𐴝𐴔 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴕𐴡 𐴉𐴝𐴘𐴁𐴝.</char><verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴀𐴛 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴝𐴘 𐴀𐴠𐴓𐴝𐴕 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴏𐴃𐴝-𐴌𐴝𐴏𐴃𐴝 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.</char> <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴀𐴛 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴠 𐴑𐴞𐴦 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴕 𐴀𐴝𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥,</char> <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" /><char style="wj">𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴌𐴝𐴥 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴠 𐴀𐴡𐴥. 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴉𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴡𐴃𐴢 𐴊𐴠𐴑𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴊𐴞𐴦𐴁𐴡. </char><verse eid="MAT 6:4" /></para>
  <para style="s1">𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="LUK 11:2-4">𐴓𐴟𐴑 11‏:2‏-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />
    <char style="wj">”𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴏𐴃𐴝𐴌 𐴑𐴟𐴕𐴝-𐴑𐴟𐴕𐴝 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴡𐴌𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.</char> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴀𐴛 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴑𐴝𐴔𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴞, 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴣𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴉𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴡, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴉𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴡𐴃𐴢 𐴊𐴠𐴑𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴊𐴞𐴦𐴁𐴡.</char> <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴠𐴇𐴝𐴎𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴡 𐴊𐴟𐴖𐴝𐴌𐴝𐴥𐴘𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴄𐴝𐴥𐴀𐴌𐴠 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴃𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴟𐴖𐴝 𐴑𐴡𐴁𐴟𐴓𐴢 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴠 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴔𐴝𐴒𐴞𐴁𐴝𐴥𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴎𐴝𐴕𐴠.</char> <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥:</char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="wj">’𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴢,</char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔 𐴂𐴝𐴑 𐴔𐴝𐴕𐴝 𐴎𐴡𐴑.</char><verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴝𐴘𐴧𐴡𐴤𐴑.</char></para>
  <para style="q1" vid="MAT 6:10">
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥,</char></para>
  <para style="q2" vid="MAT 6:10">
    <char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴡𐴥 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴗𐴑.</char><verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />
    <char style="wj">𐴀𐴝𐴙𐴅𐴧𐴝𐴌 𐴈𐴝𐴥𐴕𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴙𐴅𐴧𐴝 𐴊𐴡𐴦.</char><verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />
    <char style="wj">𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴡𐴤,</char></para>
  <para style="q2" vid="MAT 6:12">
    <char style="wj">𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴔𐴝𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥.</char><verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />
    <char style="wj">𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴃𐴧𐴡 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥,</char></para>
  <para style="q2" vid="MAT 6:13">
    <char style="wj">𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘 𐴌𐴝𐴑𐴡𐴥. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴌𐴝𐴙𐴅𐴧𐴡, 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴀𐴝𐴦𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴃𐴡 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌.‘</char><verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴁𐴡.</char> <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴔𐴝𐴉𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴔𐴝𐴉𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char><verse eid="MAT 6:15" /></para>
  <para style="s1">𐴌𐴟𐴎𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴡𐴥 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴕𐴝𐴑𐴔𐴟𐴑 𐴇𐴝𐴓𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴞𐴘𐴝𐴥𐴌𐴝 𐴁𐴡𐴊𐴡𐴓𐴠 𐴊𐴠 𐴃𐴡 𐴌𐴟𐴎𐴝 𐴌𐴝𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝. 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.</char> <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴀𐴛 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴡𐴥, 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴃𐴠𐴓𐴢 𐴊𐴞𐴘𐴡, 𐴀𐴝𐴦𐴌 𐴔𐴟𐴑 𐴊𐴟𐴥𐴘𐴧𐴡,</char> <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" /><char style="wj">𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴀𐴛 𐴌𐴟𐴎𐴝 𐴌𐴝𐴙𐴑𐴧𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴉𐴠 𐴎𐴝𐴕𐴠, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴉𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴡𐴃𐴢 𐴊𐴠𐴑𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴊𐴞𐴦𐴁𐴡.</char><verse eid="MAT 6:18" /></para>
  <para style="s1">𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴊𐴡𐴥𐴕 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴝𐴥</para>
  <para style="r">(<ref loc="LUK 12:33-34">𐴓𐴟𐴑 12‏:33‏-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />
    <char style="wj">”𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴊𐴡𐴥𐴕-𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴡𐴔𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴎𐴠𐴍𐴠𐴥 𐴉𐴟𐴑𐴠 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴦𐴣𐴌𐴠 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴠, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴍𐴠𐴥 𐴏𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴠𐴌𐴝𐴤 𐴈𐴝𐴍𐴞 𐴏𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠.</char> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" /><char style="wj">𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴊𐴡𐴥𐴕-𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴍𐴠𐴥 𐴕𐴡 𐴉𐴟𐴑𐴠 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴎𐴡𐴦𐴣𐴌𐴠 𐴕𐴝𐴐𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴍𐴠𐴥 𐴏𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴠𐴌𐴝𐴤 𐴈𐴝𐴍𐴞 𐴏𐴟𐴌 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴡𐴥𐴕-𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴎𐴠𐴍𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡 𐴊𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥𐴍𐴠.</char><verse eid="MAT 6:21" /></para>
  <para style="s1">𐴒𐴝𐴦𐴌 𐴉𐴡𐴀𐴌</para>
  <para style="r">(<ref loc="LUK 11:34-36">𐴓𐴟𐴑 11‏:34‏-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />
    <char style="wj">”𐴒𐴝𐴦𐴌 𐴏𐴠𐴌𐴝𐴑 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴟𐴑; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴟𐴑 𐴒𐴡𐴔 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴟𐴣𐴍𐴝 𐴒𐴝𐴦 𐴉𐴡𐴀𐴌𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴟𐴑 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴟𐴣𐴍𐴝 𐴒𐴝𐴦 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴠 𐴉𐴡𐴀𐴌 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴡𐴊𐴞 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴠𐴥 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴇𐴡𐴃𐴡𐴥 𐴒𐴟𐴄𐴒𐴟𐴙𐴄𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌!</char><verse eid="MAT 6:23" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞</para>
  <para style="r">(<ref loc="LUK 16:13">𐴓𐴟𐴑 16‏:13</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />
    <char style="wj">”𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴊𐴟𐴘 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴀𐴝𐴦𐴌 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡; 𐴘𐴝𐴥𐴃𐴡 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴡𐴘 𐴄𐴞𐴥𐴑 𐴃𐴝𐴥𐴑𐴞𐴁𐴡 𐴀𐴝𐴦𐴌 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴑𐴧𐴟 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.</char><verse eid="MAT 6:24" /></para>
  <para style="s1">𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥</para>
  <para style="r">(<ref loc="LUK 12:22-34">𐴓𐴟𐴑 12‏:22‏-34</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴑𐴞𐴦 𐴈𐴝𐴥𐴘𐴧𐴟𐴔 𐴘𐴝𐴥 𐴑𐴞𐴦 𐴉𐴞𐴀𐴘𐴟𐴔 𐴇𐴡𐴘 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴓𐴧𐴝 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴀𐴝𐴦𐴌 𐴑𐴞𐴦 𐴉𐴞𐴣𐴊𐴞𐴥𐴘𐴟𐴔 𐴇𐴡𐴘 𐴒𐴝𐴦 𐴓𐴧𐴝 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴑𐴞 𐴈𐴝𐴥𐴕𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴑𐴞𐴔𐴡𐴃𐴞 𐴕𐴡 𐴕𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴒𐴝𐴦 𐴑𐴞 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴑𐴞𐴔𐴡𐴃𐴞 𐴕𐴡 𐴕𐴠𐴥؟</char> <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" /><char style="wj">𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴥𐴉𐴞𐴏𐴡; 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴡 𐴕𐴡 𐴐𐴞𐴥𐴣𐴍𐴠, 𐴕𐴡 𐴊𐴝𐴦, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴒𐴟𐴊𐴝𐴔𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴈𐴝𐴥𐴀𐴁𐴝. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴑𐴞𐴔𐴡𐴃𐴞 𐴕𐴡 𐴕𐴠𐴥؟</char> <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴠 𐴏𐴞𐴕𐴃𐴝 𐴒𐴡𐴌𐴞𐴥 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴘𐴧𐴝𐴃𐴡𐴌𐴠 𐴀𐴠𐴑 𐴒𐴡𐴥𐴕𐴋𐴝 𐴁𐴝𐴌𐴝𐴤𐴘 𐴉𐴝𐴌𐴞𐴁𐴝𐴥 𐴊𐴠 𐴀𐴝𐴏𐴡𐴤؟</char><verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />
    <char style="wj">”𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌𐴡𐴓𐴧𐴝 𐴑𐴞𐴘𐴝𐴥 𐴏𐴞𐴕𐴃𐴝 𐴒𐴡𐴌𐴡𐴤؟ 𐴁𐴝𐴥𐴉𐴞𐴏𐴡, 𐴔𐴡𐴘𐴊𐴝𐴕𐴡𐴌 𐴉𐴟𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴠𐴤; 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴡 𐴕𐴡 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴉𐴟𐴥𐴣𐴃𐴝 𐴈𐴝𐴍𐴠.</char> <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴏𐴡𐴥𐴓𐴡𐴔𐴝𐴕𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴢 𐴓𐴡𐴥𐴘 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴇𐴝𐴥𐴣𐴎𐴝𐴘 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘.</char> <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴔𐴡𐴘𐴊𐴝𐴕𐴡𐴌 𐴑𐴠𐴥𐴌𐴡𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴇𐴝𐴥𐴣𐴎𐴝, 𐴎𐴞𐴀𐴕 𐴀𐴝𐴙𐴅𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴇𐴝𐴙𐴓𐴧𐴝 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝; 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴡𐴥 𐴈𐴡𐴔 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴕𐴡 𐴇𐴝𐴥𐴣𐴎𐴝𐴘𐴁𐴡 𐴕𐴠𐴥؟</char> <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, ’𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴦 𐴈𐴝𐴥𐴘𐴧𐴟𐴔؟ 𐴑𐴞𐴦 𐴉𐴞𐴀𐴘𐴟𐴔؟‘ 𐴘𐴝𐴥 ’𐴑𐴞𐴦 𐴉𐴞𐴣𐴊𐴞𐴥𐴘𐴟𐴔؟‘ 𐴈𐴡𐴀𐴘𐴢 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. </char> <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴥𐴕𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴞𐴏𐴠𐴤 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑𐴠. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴠 𐴃𐴡 𐴎𐴝𐴕𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴓𐴝𐴒𐴠𐴌 𐴊𐴠.</char> <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" /><char style="wj">𐴀𐴝𐴒𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴞𐴁𐴝𐴥𐴌 𐴃𐴝𐴓𐴝𐴐𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴡, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴥 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴇𐴝𐴙𐴓𐴧𐴝𐴓𐴧𐴝 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴝𐴙𐴓𐴧𐴝𐴌 𐴊𐴞𐴕𐴠 𐴇𐴝𐴙𐴓𐴧𐴝𐴓𐴧𐴝 𐴏𐴞𐴕𐴃𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴊𐴞𐴕𐴡𐴌 𐴊𐴟𐴑 𐴊𐴞𐴕𐴡𐴓𐴧𐴝 𐴑𐴝𐴉𐴞𐴥.</char><verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴃𐴟𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="r">(<ref loc="LUK 6:37-38">𐴓𐴟𐴑 6‏:37‏-38</ref>‏,<ref loc="LUK 6:41-42">41‏-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />
    <char style="wj">”𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡 𐴊𐴡𐴙𐴅𐴧𐴡, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴘𐴡𐴥 𐴊𐴡𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴊𐴡𐴥𐴌𐴡, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴘𐴡𐴥 𐴊𐴡𐴥𐴌𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴔𐴝𐴉𐴠 𐴊𐴞𐴦𐴁𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥 𐴔𐴝𐴉𐴠 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />
    <char style="wj">”𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴡𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴝𐴥𐴓𐴢 𐴓𐴝𐴕 𐴑𐴞𐴘𐴝𐴥 𐴊𐴠𐴑𐴡𐴥𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴡𐴊𐴧𐴝 𐴒𐴝𐴥𐴕 𐴀𐴡𐴥𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤𐴌؟</char> <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" /><char style="wj">𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴇𐴡𐴊𐴧𐴝 𐴃𐴝𐴥𐴑𐴞 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴀𐴛 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴈𐴡𐴀𐴌, ’𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴟𐴑𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴓𐴢 𐴓𐴝𐴕 𐴕𐴠𐴦𐴓𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘‘؟</char> <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" /><char style="wj">𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑! 𐴀𐴝𐴒𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴡𐴃𐴧𐴟 𐴇𐴡𐴊𐴧𐴝 𐴒𐴝𐴥𐴕 𐴕𐴠𐴦𐴓𐴝𐴘𐴉𐴠𐴥𐴓𐴡, 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴡𐴌 𐴏𐴟𐴑𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴓𐴢 𐴓𐴝𐴕 𐴕𐴠𐴦𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴊𐴠𐴑𐴞𐴥𐴁𐴝.</char><verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />
    <char style="wj">”𐴑𐴟𐴣𐴙𐴌𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴂𐴝𐴑 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴕𐴡 𐴊𐴞𐴦𐴘𐴡, 𐴀𐴝𐴦𐴌 𐴐𐴟𐴥𐴖𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴑𐴃𐴝 𐴕𐴡 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴡, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴄𐴠𐴥𐴚𐴠 𐴀𐴟𐴥𐴣𐴌𐴝𐴕 𐴔𐴝𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴉𐴞𐴥𐴌𐴞 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴕-𐴇𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡. </char><verse eid="MAT 7:6" /></para>
  <para style="s1">𐴔𐴝𐴒𐴡, 𐴃𐴟𐴖𐴡 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴙𐴅𐴧𐴡</para>
  <para style="r">(<ref loc="LUK 11:9-13">𐴓𐴟𐴑 11‏:9‏-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />
    <char style="wj">”𐴔𐴝𐴒𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴃𐴟𐴖𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴝𐴘𐴁𐴝; 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴙𐴅𐴧𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝𐴌 𐴑𐴟𐴥𐴓𐴝 𐴎𐴝𐴥𐴘𐴁𐴡.</char> <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴝𐴒𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴉𐴝𐴦; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴖𐴝, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴖𐴝𐴘 𐴉𐴝𐴦; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴙𐴅𐴧𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴝 𐴑𐴟𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴘𐴠 𐴌𐴟𐴄𐴞 𐴔𐴝𐴒𐴞𐴓𐴠𐴥 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴊𐴞𐴦𐴁𐴡 𐴊𐴠𐴥؟</char> <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" /><char style="wj">𐴘𐴝𐴥𐴃𐴡 𐴔𐴝𐴏𐴢 𐴔𐴝𐴒𐴞𐴓𐴠𐴥 𐴇𐴝𐴥𐴉𐴢 𐴊𐴞𐴦𐴁𐴡 𐴊𐴠𐴥؟</char> <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" /><char style="wj">𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴒𐴡𐴔-𐴒𐴡𐴔 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴦 𐴎𐴝𐴕𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴔𐴝𐴒𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴃𐴡𐴥 𐴒𐴡𐴔 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴦𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌!</char><verse eid="MAT 7:11" /></para>
  <para style="s1">𐴐𐴟𐴥𐴕𐴝𐴓𐴞 𐴑𐴝𐴦𐴕𐴟𐴕</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴡𐴤 𐴎𐴞𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴡𐴀 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴠 𐴃𐴡𐴌𐴝𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴞𐴥𐴑𐴧𐴝. </char><verse eid="MAT 7:12" /></para>
  <para style="s1">𐴏𐴞𐴘𐴡𐴕 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴍𐴝 𐴊𐴡𐴌𐴡𐴎𐴝</para>
  <para style="r">(<ref loc="LUK 13:24">𐴓𐴟𐴑 13‏:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />
    <char style="wj">”𐴏𐴞𐴘𐴡𐴕 𐴊𐴡𐴌𐴡𐴎𐴝 𐴁𐴝𐴥𐴘 𐴒𐴡𐴥𐴓𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴡𐴌𐴁𐴝𐴊𐴞𐴌 𐴀𐴟𐴎𐴟 𐴓𐴡𐴘𐴎𐴝 𐴊𐴠 𐴌𐴝𐴏𐴃𐴝 𐴉𐴝𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴊𐴡𐴌𐴡𐴎𐴝 𐴐𐴡𐴍𐴝; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴥𐴘 𐴒𐴡𐴥𐴓𐴡𐴘𐴝 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴠𐴤.</char> <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴀𐴟𐴎𐴟 𐴓𐴡𐴘𐴎𐴝 𐴊𐴠 𐴌𐴝𐴏𐴃𐴝 𐴑𐴟𐴃𐴝𐴇𐴝𐴙𐴄𐴧𐴝 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴊𐴡𐴌𐴡𐴎𐴝 𐴏𐴞𐴘𐴡𐴕, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴉𐴡𐴦𐴘𐴝 𐴈𐴡𐴔.</char><verse eid="MAT 7:14" /></para>
  <para style="s1">𐴒𐴝𐴏𐴢 𐴏𐴞𐴕𐴝𐴥 𐴎𐴝 𐴊𐴠 𐴒𐴟𐴓𐴝𐴘𐴠</para>
  <para style="r">(<ref loc="LUK 6:43-44">𐴓𐴟𐴑 6‏:43‏-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />
    <char style="wj">”𐴔𐴞𐴏𐴝𐴥 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴏𐴡𐴥𐴕𐴧𐴝 𐴊𐴡𐴥𐴌𐴞 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴥𐴑𐴝 𐴌𐴝𐴚𐴑𐴟𐴣𐴙𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝.</char> <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝𐴘𐴠 𐴏𐴞𐴕𐴞𐴥𐴁𐴝. 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴑𐴞𐴥 𐴑𐴠𐴣𐴍𐴝𐴁𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴚𐴒𐴟𐴌 𐴀𐴝𐴦𐴌 𐴑𐴠𐴣𐴍𐴝𐴌 𐴎𐴝𐴥𐴋𐴧𐴗𐴝𐴃𐴧𐴟 𐴋𐴟𐴣𐴙𐴌 𐴒𐴟𐴓𐴝 𐴉𐴝𐴌𐴠؟</char> <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" /><char style="wj">𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴒𐴡𐴔 𐴒𐴝𐴏𐴡𐴃𐴢 𐴒𐴡𐴔 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴒𐴝𐴏𐴡𐴃𐴢 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴠.</char> <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" /><char style="wj">𐴒𐴡𐴔 𐴒𐴝𐴏𐴡𐴃𐴢 𐴃𐴡 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴒𐴝𐴏𐴡𐴃𐴢 𐴒𐴡𐴔 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" /><char style="wj">𐴎𐴠 𐴒𐴝𐴏𐴡𐴃𐴢 𐴒𐴡𐴔 𐴒𐴟𐴓𐴝 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠, 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴡 𐴈𐴝𐴍𐴞 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝.</char> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝𐴘𐴠 𐴏𐴞𐴕𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.</char><verse eid="MAT 7:20" /></para>
  <para style="s1">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥𐴃𐴝𐴔</para>
  <para style="r">(<ref loc="LUK 13:25-27">𐴓𐴟𐴑 13‏:25‏-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />
    <char style="wj">”𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴠𐴥, ’𐴔𐴝𐴓𐴞𐴑, 𐴔𐴝𐴓𐴞𐴑‘ 𐴋𐴝𐴑𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥𐴀𐴕 𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴟𐴘𐴃𐴠 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" /><char style="wj">𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴞𐴘𐴠𐴥 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴥𐴉𐴝𐴘𐴓𐴝𐴔 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟ 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴝𐴔𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟‘</char> <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥𐴃𐴝𐴔; 𐴑𐴟𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴊𐴟𐴌 𐴀𐴡𐴥.‘</char><verse eid="MAT 7:23" /></para>
  <para style="s1">𐴊𐴟𐴘 𐴎𐴡𐴕 𐴒𐴡𐴥𐴌 𐴁𐴝𐴕𐴡𐴘𐴝</para>
  <para style="r">(<ref loc="LUK 6:47-49">𐴓𐴟𐴑 6‏:47‏-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴀𐴞𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴟𐴊𐴧𐴞𐴥𐴔𐴝𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥.</char> <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" /><char style="wj">𐴁𐴝𐴦𐴊𐴠 𐴎𐴡𐴥𐴌 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴉𐴝𐴕𐴞𐴥𐴁𐴝𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴘𐴧𐴝𐴌 𐴁𐴝𐴀𐴘𐴢 𐴇𐴠𐴥 𐴒𐴡𐴥𐴌 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴊𐴡𐴥𐴏𐴝𐴊𐴞𐴘𐴠; 𐴃𐴡𐴀 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴡𐴌𐴞 𐴕𐴡𐴥 𐴎𐴝𐴒𐴡𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞 𐴃𐴡</char><note caller="+" style="f"><char style="fr" closed="false">7‏:25 </char><char style="ft" closed="false">𐴀𐴞𐴚𐴒𐴞𐴌𐴝𐴎𐴞𐴃𐴢 𐴉𐴡𐴥𐴕𐴋𐴠𐴐𐴞𐴕 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴀</char></note> <char style="wj">𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴃𐴢 𐴋𐴝𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠.</char> <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴀𐴞𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴀𐴕 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴁𐴠𐴑𐴟𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌 𐴁𐴝𐴓𐴟𐴌 𐴖𐴡𐴌𐴠 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥.</char> <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" /><char style="wj">𐴁𐴝𐴦𐴊𐴠 𐴎𐴡𐴥𐴌 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴉𐴝𐴕𐴞𐴥𐴁𐴝𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴘𐴧𐴝𐴌 𐴁𐴝𐴀𐴘𐴢 𐴇𐴠𐴥 𐴒𐴡𐴥𐴌 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴊𐴡𐴥𐴏𐴝𐴊𐴞𐴘𐴠; 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴡𐴌𐴞 𐴀𐴠𐴁𐴧𐴠 𐴕𐴝𐴐𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.“</char><verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴘𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥 𐴃𐴝𐴦𐴓𐴞𐴔 𐴉𐴟𐴥𐴕𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴀𐴡𐴓𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴃𐴡.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MRK 1:40-45">𐴔𐴝𐴑 1‏:40‏-45</ref>; <ref loc="LUK 5:12-16">𐴓𐴟𐴑 5‏:12‏-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴓𐴝𐴙𐴔𐴧𐴠𐴥𐴒𐴝𐴘, 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴠𐴎𐴧𐴡𐴕 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴏𐴝𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.“<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴁𐴝𐴌𐴝𐴤𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢; 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴡𐴘.“</char> 𐴃𐴡𐴥𐴘 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴔𐴡𐴃𐴧𐴟 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴝𐴘𐴧𐴡𐴥, 𐴘𐴝𐴀𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴧𐴡𐴥; 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴡𐴦, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴝𐴈𐴡𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴁𐴝𐴤 𐴀𐴡𐴥 𐴉𐴝𐴕, 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴡𐴒𐴡𐴥𐴘.“</char><verse eid="MAT 8:4" /></para>
  <para style="s1">𐴀𐴠𐴑 𐴌𐴡𐴔𐴞 𐴐𐴝𐴥𐴀𐴂𐴡𐴌 𐴒𐴟𐴓𐴝𐴔𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="LUK 7:1-10">𐴓𐴟𐴑 7‏:1‏-10</ref>; <ref loc="JHN 4:43-54">𐴘𐴡 4‏:43‏-54</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴠𐴎𐴧𐴡𐴕 𐴐𐴝𐴥𐴀𐴂𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴉𐴡𐴥𐴗𐴏𐴡𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌, 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴝𐴣𐴃𐴟𐴌 𐴀𐴡𐴥𐴘 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴉𐴡𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴠; 𐴀𐴞𐴥𐴃𐴠 𐴑𐴟𐴥𐴁𐴢 𐴊𐴟𐴑 𐴉𐴝𐴦𐴌.“<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔.“</char><verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴝𐴥𐴀𐴂𐴢 𐴂𐴗𐴝𐴥𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴓𐴡𐴌 𐴕𐴞𐴏𐴠 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴀𐴛 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡. 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴔𐴟𐴑𐴠𐴥 𐴈𐴡𐴀, 𐴃𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴓𐴝𐴔 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴞𐴤, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴣𐴀𐴌 𐴕𐴞𐴏𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴝𐴀𐴛 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 ’𐴎𐴝𐴦‘ 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴎𐴝𐴦, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 ’𐴀𐴝𐴘‘ 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴓𐴝𐴔𐴡𐴌𐴠 ’𐴘𐴝𐴀𐴕 𐴒𐴡𐴌‘ 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴠𐴥.“<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴌𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴀𐴛 𐴀𐴠𐴃𐴧𐴡𐴥𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡𐴥 𐴉𐴝𐴘.</char> <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴉𐴟𐴑 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴏𐴞𐴥𐴔𐴡𐴃𐴧𐴟 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔, 𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴘𐴁𐴡𐴥.</char> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴝𐴀𐴌𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴇𐴠𐴥𐴍𐴠 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴃𐴠 𐴊𐴝𐴃𐴢 𐴑𐴞𐴌𐴑𐴞𐴌𐴝𐴕𐴞 𐴀𐴡𐴥𐴘𐴁𐴡.“</char><verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴐𐴝𐴥𐴀𐴂𐴢 𐴂𐴗𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴦𐴒𐴡𐴥𐴘; 𐴃𐴟𐴀𐴛 𐴎𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴁𐴡𐴥𐴓𐴞 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴇𐴠𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴀𐴡𐴥𐴗𐴑.“</char> 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴟𐴓𐴝𐴔𐴧𐴗𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MAT 8:13" /></para>
  <para style="s1">𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 1:29-34">𐴔𐴝𐴑 1‏:29‏-34</ref>; <ref loc="LUK 4:38-41">𐴓𐴟𐴑 4‏:38‏-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴇𐴡𐴥𐴖𐴌𐴞 𐴒𐴝𐴦𐴃𐴎𐴡𐴌𐴠 𐴁𐴞𐴏𐴝𐴥𐴕𐴝𐴃𐴢 𐴉𐴡𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴥𐴃𐴢 𐴊𐴡𐴥𐴙𐴅𐴧𐴠 𐴌𐴝𐴥𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴒𐴝𐴦𐴃𐴎𐴡𐴌 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘; 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴠𐴀𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴀𐴝𐴙𐴕𐴧𐴞𐴤𐴓𐴢. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴅𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴟𐴑 𐴎𐴡𐴁𐴝𐴕𐴠 𐴊𐴝𐴥𐴉𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥,</para>
  <para style="q1" vid="MAT 8:17">”𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴡𐴔𐴎𐴟𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠,</para>
  <para style="q2" vid="MAT 8:17">𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.“<note caller="+" style="f"><char style="fr" closed="false">8‏:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:4">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 53‏:4</ref></char></char></note><verse eid="MAT 8:17" /></para>
  <para style="s1">𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="LUK 9:57-62">𐴓𐴟𐴑 9‏:57‏-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴋𐴞𐴀𐴌 𐴀𐴡 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴓𐴠𐴔 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴃𐴟𐴀𐴛 𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴘𐴁𐴝 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴎𐴝𐴘𐴧𐴟𐴔.“<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠 <char style="wj">”𐴐𐴞𐴥𐴘𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴒𐴝𐴣𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴝𐴇𐴝𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴇𐴡𐴕𐴡𐴤 𐴔𐴞𐴑𐴧𐴝𐴥 𐴎𐴝𐴒𐴝 𐴕𐴝𐴥𐴘.“</char><verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴟𐴔𐴧𐴡𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴒𐴠 𐴀𐴝𐴀𐴛 𐴎𐴝𐴘 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴘𐴧𐴞𐴤.“<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴔𐴟𐴌𐴟𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴌𐴟𐴊𐴝𐴌𐴠 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴡𐴥𐴗𐴑𐴒𐴡𐴘.“</char><verse eid="MAT 8:22" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴟𐴖𐴝𐴥𐴕 𐴃𐴝𐴥𐴔𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MRK 4:35-41">𐴔𐴝𐴑 4‏:35‏-41</ref>; <ref loc="LUK 8:22-25">𐴓𐴟𐴑 8‏:22‏-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />𐴀𐴝𐴃𐴞𐴥𐴑𐴧𐴝 𐴋𐴞𐴀𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴠𐴀𐴕 𐴋𐴡𐴣𐴀𐴌 𐴃𐴟𐴖𐴝𐴥𐴕 𐴐𐴟𐴥𐴌𐴟 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴕𐴡𐴦 𐴒𐴝𐴥𐴕 𐴒𐴡𐴙𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴞𐴎𐴝𐴌𐴒𐴡𐴘. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />𐴀𐴟𐴔𐴧𐴡𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴊𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴝𐴏𐴡! 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴌𐴞𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘!“<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴈𐴡𐴔 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴋𐴡𐴦𐴌𐴡𐴥𐴌 𐴑𐴞𐴘𐴝𐴥؟“ </char> 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴀𐴟𐴍𐴞𐴤 𐴁𐴡𐴘𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴙𐴌𐴡𐴌𐴠 𐴊𐴡𐴥𐴀𐴣𐴑 𐴊𐴞𐴥𐴘𐴠 𐴌𐴝𐴥𐴌, 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴃𐴝𐴥𐴔𐴝𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐؟ 𐴁𐴡𐴘𐴧𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥𐴘𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴊𐴠 𐴀𐴞𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴝𐴕𐴠!“<verse eid="MAT 8:27" /></para>
  <para style="s1">𐴊𐴟𐴘 𐴎𐴡𐴕 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 5:1-20">𐴔𐴝𐴑 5‏:1‏-20</ref>; <ref loc="LUK 8:26-39">𐴓𐴟𐴑 8‏:26‏-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴋𐴞𐴀𐴌 𐴀𐴡𐴑𐴟𐴓𐴠 𐴒𐴝𐴊𐴝𐴌𐴞𐴕𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴃𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴊𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴀𐴕 𐴇𐴡𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴠𐴥 𐴉𐴡𐴣𐴃𐴢 𐴁𐴝𐴥𐴘 𐴎𐴝𐴘 𐴕𐴡 𐴉𐴝𐴙𐴃𐴧𐴡. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />𐴀𐴝𐴃𐴞𐴥𐴑𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴑𐴞𐴦 𐴈𐴝𐴔 𐴀𐴝𐴏𐴠𐴤؟ 𐴀𐴡𐴑𐴃𐴡𐴥 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴃𐴠 𐴃𐴟𐴀𐴛 𐴇𐴡𐴥𐴕𐴡 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴃𐴡𐴎𐴞𐴘𐴝 𐴊𐴞𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴡𐴥 𐴊𐴠 𐴕𐴠𐴥؟“<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴇𐴡𐴊𐴧𐴟𐴥𐴌 𐴊𐴟𐴌𐴠𐴥 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴎𐴝𐴥𐴑 𐴐𐴟𐴥𐴖𐴡𐴌 𐴏𐴡𐴌𐴠𐴌 𐴊𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />𐴁𐴟𐴥𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴠𐴦𐴓𐴝𐴘𐴉𐴠𐴥𐴓𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴡 𐴐𐴟𐴥𐴖𐴡𐴌𐴡𐴌 𐴎𐴝𐴥𐴑𐴧𐴗𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴡.“<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴦𐴒𐴡𐴥𐴘.“</char> 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴞𐴥𐴀𐴕 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴢 𐴐𐴟𐴥𐴖𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴧𐴠𐴒𐴡𐴘; 𐴃𐴡𐴥𐴘 𐴒𐴟𐴣𐴍𐴝 𐴎𐴝𐴥𐴑𐴧𐴗𐴝 𐴉𐴝𐴀𐴌𐴡𐴌 𐴇𐴝𐴙𐴕𐴊𐴝𐴤 𐴁𐴝𐴥𐴘 𐴎𐴟𐴌𐴠 𐴋𐴞𐴀𐴃𐴢 𐴊𐴟𐴣𐴌𐴞 𐴒𐴞𐴦𐴘𐴠𐴥 𐴀𐴝𐴦𐴌 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴋𐴟𐴉𐴞𐴥 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />𐴏𐴡𐴌𐴡𐴘𐴝 𐴒𐴟𐴥𐴕 𐴊𐴟𐴣𐴌𐴊𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴎𐴝𐴘 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴈𐴡𐴥𐴁𐴡𐴌 𐴊𐴞𐴥𐴘𐴠, 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />𐴃𐴡𐴥𐴘 𐴃𐴝𐴔𐴝𐴥𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴏𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴃𐴡 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴧𐴟 𐴎𐴝𐴘𐴃𐴡𐴒𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴣𐴃𐴟𐴌𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 2:1-12">𐴔𐴝𐴑 2‏:1‏-12</ref>; <ref loc="LUK 5:17-26">𐴓𐴟𐴑 5‏:17‏-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />𐴀𐴞𐴏𐴝𐴤 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴞𐴤, 𐴋𐴞𐴀 𐴉𐴝𐴌𐴝𐴤𐴘 𐴕𐴞𐴎𐴡𐴌 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴁𐴞𐴏𐴝𐴥𐴕𐴝𐴃𐴢 𐴕𐴠𐴙𐴄𐴧𐴝 𐴀𐴠𐴑 𐴀𐴝𐴣𐴃𐴟𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴃𐴟𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴉𐴟𐴃𐴢, 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴒𐴡𐴌; 𐴃𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠.“</char><verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴀𐴝𐴓𐴠𐴔𐴠 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴃𐴡 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴠𐴥𐴌!“<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴌𐴠 𐴎𐴝𐴕𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴑𐴞𐴘𐴝𐴥 𐴁𐴝𐴥𐴉𐴡𐴌؟</char> <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" /><char style="wj">𐴈𐴡𐴘𐴃𐴠𐴤 𐴇𐴡𐴕 𐴕𐴝𐴥𐴕 𐴀𐴝𐴏𐴝𐴤𐴕, 𐴑𐴞 ’𐴃𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠,‘ 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 ’𐴀𐴟𐴍𐴞𐴤 𐴀𐴝𐴥𐴣𐴄𐴢‘؟</char> <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤.“</char> 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴃𐴟𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴟𐴄𐴢, 𐴃𐴡𐴌 𐴁𐴞𐴏𐴝𐴥𐴕𐴝 𐴃𐴟𐴓𐴞𐴤 𐴓𐴡𐴦𐴘𐴢 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴒𐴡𐴥𐴘.“</char> <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴟𐴍𐴞𐴤 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴠𐴥.<verse eid="MAT 9:8" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴡𐴃𐴞𐴌𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 2:13-17">𐴔𐴝𐴑 2‏:13‏-17</ref>; <ref loc="LUK 5:27-32">𐴓𐴟𐴑 5‏:27‏-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />𐴀𐴞𐴏𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴃𐴟 𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴔𐴡𐴃𐴞 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴃𐴟𐴓𐴠𐴥 𐴊𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌𐴡.“</char> 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴡𐴃𐴞𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴌, 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴟𐴏𐴃𐴝𐴃𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴞𐴘𐴝𐴥 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀؟“<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴃𐴡 𐴋𐴝𐴑𐴄𐴡𐴌 𐴕𐴡 𐴓𐴝𐴒𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴠 𐴓𐴝𐴒𐴠.</char> <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴘 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤𐴌 𐴔𐴝𐴀𐴕𐴞 𐴑𐴞𐴦 𐴐𐴞𐴥𐴑𐴡𐴒𐴡𐴘, ’𐴀𐴝𐴀𐴛 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠.‘</char><note caller="+" style="f"><char style="fr" closed="false">9‏:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">𐴇𐴡𐴥𐴐𐴞𐴘𐴝 6‏:6</ref></char></char></note> <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠.“</char><verse eid="MAT 9:13" /></para>
  <para style="s1">𐴌𐴟𐴎𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 2:18-22">𐴔𐴝𐴑 2‏:18‏-22</ref>; <ref loc="LUK 5:33-39">𐴓𐴟𐴑 5‏:33‏-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴡 𐴕𐴞𐴃𐴧𐴞 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴞𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴑𐴞𐴘𐴝𐴥 𐴌𐴟𐴎𐴝 𐴕𐴡 𐴌𐴝𐴑𐴠𐴥؟“<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴊𐴟𐴓𐴝𐴤 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴑𐴞𐴥 𐴁𐴡𐴘𐴌𐴝𐴙𐴃𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴠؟ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴀𐴕 𐴊𐴞𐴕 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴟𐴓𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴟𐴎𐴝 𐴌𐴝𐴑𐴞𐴥𐴁𐴡.</char><verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />
    <char style="wj">”𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴡 𐴉𐴟𐴌𐴝𐴕 𐴉𐴟𐴐𐴝𐴥𐴑𐴡𐴃𐴢 𐴕𐴡𐴘𐴝 𐴇𐴡𐴦𐴌 𐴃𐴝𐴓𐴞 𐴊𐴠𐴊𐴠 𐴕𐴝𐴥𐴘; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴉𐴟𐴐𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴃𐴝𐴓𐴞 𐴒𐴝𐴥𐴕 𐴎𐴡𐴥𐴌𐴞𐴎𐴝𐴘𐴁𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴥𐴍𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴌𐴡𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.</char> <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡𐴘𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴕 𐴏𐴝𐴔𐴝𐴌𐴝𐴌 𐴇𐴡𐴥𐴙𐴓𐴧𐴝𐴃𐴢 𐴌𐴝𐴑𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘; 𐴎𐴡𐴊𐴞 𐴌𐴝𐴑𐴞𐴥𐴓𐴠 𐴃𐴡 𐴇𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴟𐴥𐴕 𐴉𐴝𐴥𐴍𐴞 𐴌𐴡𐴐𐴧𐴟𐴥𐴕 𐴒𐴡𐴓𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴟𐴥𐴕 𐴀𐴡𐴥 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴎𐴝𐴘𐴁𐴡𐴘. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴕𐴡𐴘𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴡𐴌𐴠 𐴕𐴡𐴘𐴝 𐴏𐴝𐴔𐴝𐴌𐴝𐴌 𐴇𐴡𐴥𐴙𐴓𐴧𐴝𐴃𐴢 𐴌𐴝𐴑𐴠𐴥 𐴊𐴠, 𐴃𐴡𐴥𐴘 𐴊𐴟𐴕𐴞𐴥 𐴒𐴟𐴥𐴕 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠.“</char><verse eid="MAT 9:17" /></para>
  <para style="s1">𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴡𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴡𐴦𐴌 𐴏𐴟𐴥𐴘𐴧𐴠 𐴊𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝</para>
  <para style="r">(<ref loc="MRK 5:21-43">𐴔𐴝𐴑 5‏:21‏-43</ref>; <ref loc="LUK 8:40-56">𐴓𐴟𐴑 8‏:40‏-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝 𐴀𐴠𐴇𐴡𐴥𐴕-𐴀𐴠𐴇𐴡𐴥𐴕 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴀𐴛 𐴀𐴝𐴀𐴘𐴢 𐴇𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴥𐴃𐴢 𐴊𐴡𐴦𐴒𐴝𐴥𐴘, 𐴃𐴡𐴥𐴘 𐴇𐴞𐴥𐴁𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“ <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴀𐴟𐴍𐴞𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴦𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴒𐴞𐴦𐴘𐴠𐴥.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴝𐴌𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴑𐴟𐴥𐴕𐴎𐴝𐴌𐴞 𐴎𐴝𐴥𐴌 𐴊𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴞𐴏𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌𐴡𐴌 𐴇𐴝𐴣𐴌𐴝 𐴏𐴟𐴥𐴘𐴧𐴠. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴝𐴥𐴙𐴂𐴧𐴞𐴓𐴢 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌 𐴏𐴟𐴥𐴘, 𐴀𐴝𐴀𐴛 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴧𐴟𐴔𐴁𐴡𐴘.“<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴞𐴥𐴌𐴞 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴎𐴞𐴥𐴀, 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴒𐴡𐴌! 𐴃𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴠 𐴃𐴡𐴌𐴠𐴥 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.“</char> 𐴃𐴡𐴥𐴘 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />𐴀𐴞𐴏𐴝𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴒𐴗𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴁𐴝𐴐𐴞𐴤-𐴁𐴝𐴎𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴡𐴓𐴇𐴡𐴓𐴝𐴕𐴞 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴠𐴦𐴓𐴡𐴒𐴡𐴥𐴘. 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴟𐴥𐴔 𐴎𐴝𐴌 𐴊𐴠.“</char> 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴥𐴣𐴐𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴝𐴘 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴞 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴀𐴝𐴥𐴃𐴢 𐴊𐴡𐴥𐴙𐴅𐴧𐴠, 𐴃𐴡𐴥𐴘 𐴇𐴞𐴥𐴁𐴝 𐴀𐴟𐴍𐴞𐴤𐴒𐴞𐴘𐴡𐴘. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />𐴇𐴠𐴥 𐴈𐴡𐴥𐴁𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴠𐴥 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝𐴃𐴢 𐴉𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘.<verse eid="MAT 9:26" /></para>
  <para style="s1">𐴊𐴟𐴘 𐴎𐴡𐴕 𐴀𐴝𐴣𐴊𐴝𐴤𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />𐴀𐴞𐴏𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴃𐴟 𐴎𐴝𐴦𐴌𐴒𐴡𐴥𐴘 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴀𐴝𐴣𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴝𐴑 𐴔𐴝𐴌𐴞-𐴔𐴝𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤!“<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴀𐴝𐴣𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴘𐴝𐴀𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴟𐴔 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤 𐴕𐴠؟“</char></para>
  <para style="p" vid="MAT 9:28">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴅𐴞𐴦 𐴔𐴝𐴓𐴞𐴑, 𐴒𐴡𐴌𐴞𐴥.“<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑 𐴊𐴡𐴥𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴔𐴡𐴎𐴞𐴕 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴑.“</char> <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑 𐴑𐴟𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘. 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴊𐴡𐴌𐴡𐴤𐴒𐴡𐴌𐴞 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, <char style="wj">”𐴏𐴝𐴘𐴧𐴡𐴥, 𐴘𐴝𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠 𐴉𐴝𐴥𐴕.“</char> <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴘 𐴇𐴠𐴥 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴡𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴠.<verse eid="MAT 9:31" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴟𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴀𐴌𐴠 𐴎𐴝𐴦𐴌𐴒𐴡𐴥𐴘 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴁𐴟𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴟𐴥𐴃𐴧𐴗𐴝 𐴊𐴝𐴥𐴉𐴝𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴇𐴠𐴥 𐴁𐴟𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴔𐴝𐴃𐴞 𐴉𐴝𐴙𐴅𐴧𐴠𐴥. 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴡 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴊𐴝𐴈𐴝𐴤 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴕𐴝𐴥𐴘.“<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴥𐴉𐴝 𐴊𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴡𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴠.“<verse eid="MAT 9:34" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴠𐴄𐴉𐴟𐴌𐴝𐴕𐴞</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />𐴀𐴞𐴏𐴝𐴤 𐴉𐴡𐴃𐴧𐴞𐴥 𐴐𐴡𐴥𐴀𐴌𐴠-𐴐𐴡𐴥𐴀𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴌𐴝-𐴉𐴝𐴌𐴝 𐴎𐴝𐴘 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢, 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴀𐴡𐴐𐴟𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴠𐴄𐴉𐴟𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴡𐴌𐴡𐴘𐴝 𐴏𐴝𐴥𐴌𐴝 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴐𐴝𐴥𐴕𐴃𐴞𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴊𐴠 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴡𐴦𐴘𐴝 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴔.</char> <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴉𐴡𐴥𐴏𐴡𐴓𐴡𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴊𐴝𐴘𐴃𐴡 𐴊𐴡𐴦𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝.“</char><verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MRK 3:13-19">𐴔𐴝𐴑 3‏:13‏-19</ref>; <ref loc="LUK 6:12-16">𐴓𐴟𐴑 6‏:12‏-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴥𐴉𐴝𐴘𐴁𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴀𐴡𐴐𐴟𐴥𐴑 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴊𐴞𐴦𐴘𐴠𐴥.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />𐴇𐴠𐴥 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴌 𐴕𐴝𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴀𐴕: 𐴉𐴡𐴀𐴘𐴓𐴝 𐴖𐴝, 𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴉𐴞𐴃𐴡𐴌 𐴋𐴝𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴥𐴘 𐴀𐴠𐴕𐴊𐴠𐴌𐴞𐴘𐴝𐴏𐴢; 𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌 𐴉𐴟𐴖𐴝 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴥𐴘 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />𐴉𐴞𐴓𐴞𐴥𐴂𐴢, 𐴁𐴝𐴌𐴃𐴡𐴥𐴓𐴡𐴔𐴞𐴘𐴡, 𐴃𐴡𐴥𐴔𐴝𐴏𐴢, 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴔𐴡𐴃𐴞, 𐴀𐴝𐴓𐴉𐴝𐴥𐴘𐴧𐴝𐴏𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴝𐴑𐴟𐴁𐴢, 𐴃𐴝𐴥𐴀𐴊𐴞𐴘𐴝𐴏𐴢, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴎𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴠𐴥𐴓𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴞𐴏𐴑𐴝𐴥𐴌𐴞𐴘𐴠𐴃𐴢, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴓𐴢.<verse eid="MAT 10:4" /></para>
  <para style="s1">𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴕𐴟𐴥𐴕𐴡𐴌𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴡𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MRK 6:7-13">𐴔𐴝𐴑 6‏:7‏-13</ref>; <ref loc="LUK 9:1-6">𐴓𐴟𐴑 9‏:1‏-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴠𐴥 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴕𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠: <char style="wj">”𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴕𐴡 𐴎𐴝𐴘𐴧𐴡, 𐴀𐴝𐴦𐴌 𐴏𐴝𐴔𐴝𐴥𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴥𐴙𐴓𐴧𐴡.</char> <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" /><char style="wj">𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴑𐴡𐴗𐴔 𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴓𐴟𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘𐴧𐴡.</char> <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" /><char style="wj">𐴎𐴝𐴘𐴃𐴠-𐴎𐴝𐴘𐴃𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥𐴘𐴡, ’𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘.‘</char> <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" /><char style="wj">𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴘𐴡, 𐴔𐴟𐴌𐴟𐴊𐴝𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴡, 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝𐴌𐴠 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴡, 𐴀𐴝𐴦𐴌 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴥𐴉𐴝𐴘𐴧𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴦𐴕𐴝 𐴉𐴝𐴘𐴧𐴡𐴥, 𐴔𐴝𐴦𐴕𐴝 𐴊𐴞𐴦𐴘𐴡.</char><verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />
    <char style="wj">”𐴑𐴠𐴣𐴙𐴓𐴡𐴌 𐴎𐴝𐴓𐴞𐴃𐴢 𐴒𐴡𐴌𐴞 𐴐𐴟𐴥𐴕𐴝, 𐴌𐴟𐴉𐴝, 𐴘𐴝𐴥 𐴃𐴝𐴔𐴝𐴌 𐴉𐴡𐴘𐴐𐴝𐴤 𐴕𐴡 𐴓𐴡𐴘𐴎𐴝𐴘𐴧𐴡𐴥, </char> <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" /><char style="wj">𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴇𐴡𐴥𐴙𐴓𐴧𐴝, 𐴁𐴝𐴃𐴧𐴞𐴥 𐴇𐴡𐴦𐴌, 𐴐𐴠𐴕𐴄𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴍𐴞𐴥 𐴕𐴡 𐴓𐴡𐴘𐴎𐴝𐴘𐴧𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴈𐴝𐴥𐴕𐴝 𐴉𐴝𐴘𐴁𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑.</char> <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴘𐴝𐴥 𐴉𐴝𐴌𐴝𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴁𐴝, 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴒𐴝 𐴊𐴞𐴦𐴁𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴡, 𐴀𐴝𐴦𐴌 𐴐𐴡𐴥𐴀𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴡𐴥 𐴕𐴠𐴦𐴓𐴡 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴘𐴡.</char> <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" /><char style="wj">𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴁𐴝𐴐𐴧𐴡𐴃𐴢 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴡.</char> <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" /><char style="wj">𐴎𐴡𐴊𐴞 𐴒𐴡𐴥𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴝𐴦𐴘𐴠𐴑 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴝𐴥𐴕𐴃𐴞 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴝𐴥𐴕𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴞𐴥𐴌𐴞 𐴀𐴝𐴘𐴧𐴡𐴤𐴑.</char> <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><char style="wj">𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴘𐴝𐴥𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴉𐴟𐴥𐴕𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴠𐴥 𐴒𐴡𐴥𐴌𐴡𐴃𐴧𐴟 𐴘𐴝𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴎𐴝𐴘𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴃𐴡𐴓𐴧𐴝𐴌 𐴊𐴟𐴥𐴙𐴓𐴢 𐴎𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴡.</char> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴇𐴠𐴥 𐴐𐴡𐴥𐴀𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴧𐴟 𐴏𐴡𐴥𐴊𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴔𐴡𐴥𐴌𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char><verse eid="MAT 10:15" /></para>
  <para style="s1">𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 13:9-13">𐴔𐴝𐴑 13‏:9‏-13</ref>; <ref loc="LUK 21:12-17">𐴓𐴟𐴑 21‏:12‏-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />
    <char style="wj">”𐴉𐴟𐴥𐴕𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴌𐴝𐴚𐴑𐴟𐴣𐴙𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴝𐴎𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌 𐴊𐴠. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴝𐴥𐴉𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴝𐴓𐴝𐴥𐴑 𐴀𐴡𐴥 𐴀𐴝𐴦𐴌 𐴈𐴡𐴘𐴃𐴡𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴝𐴦𐴏𐴟𐴔 𐴁𐴡𐴕𐴡.</char> <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" /><char style="wj">𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴊𐴝𐴓𐴡𐴃𐴡𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴁𐴠𐴃𐴢 𐴔𐴝𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴑𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴝𐴕𐴝𐴤 𐴎𐴝𐴘𐴁𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥 𐴉𐴝𐴌𐴡. </char> <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴑𐴞𐴦 𐴈𐴡𐴘𐴁𐴝𐴤 𐴘𐴝𐴥 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴘𐴁𐴝𐴤 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴈𐴡𐴖𐴝𐴤 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴡𐴀𐴘𐴧𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴡𐴌 𐴌𐴟𐴀 𐴀𐴠𐴥𐴕𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀.</char><verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />
    <char style="wj">”𐴁𐴝𐴥𐴘𐴧𐴠 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴀𐴝𐴦𐴌 𐴁𐴝𐴉𐴠 𐴉𐴟𐴖𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡. 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴁𐴝𐴥𐴘𐴁𐴡.</char> <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴌𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴊𐴝𐴥𐴘 𐴎𐴝𐴘𐴧𐴡𐴒𐴡𐴥𐴘. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴎𐴝𐴘𐴧𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴃𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴘𐴁𐴡𐴘.</char><verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />
    <char style="wj">”𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴏𐴃𐴝𐴃𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴒𐴡𐴗𐴀𐴌 𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴕𐴡.</char> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" /><char style="wj">𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴏𐴃𐴝𐴃𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴝𐴦𐴌 𐴒𐴡𐴗𐴀𐴌 𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴓𐴠 𐴑𐴝𐴉𐴞𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴡𐴊𐴞 𐴒𐴡𐴥𐴌𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌𐴠 𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴢</char><note caller="+" style="f"><char style="fr" closed="false">10‏:25 </char><char style="fq">𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴢</char> <char style="ft" closed="false">𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴀𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴝𐴔 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴞 𐴋𐴝𐴑𐴠.</char></note> <char style="wj">𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴇𐴠𐴥 𐴒𐴡𐴥𐴌𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴃𐴡𐴥 𐴋𐴡𐴙𐴓𐴧𐴝 𐴈𐴡𐴘𐴁𐴡𐴤 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌!</char><verse eid="MAT 10:25" /></para>
  <para style="s1">𐴇𐴝𐴌𐴠𐴤 𐴋𐴡𐴦𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥؟</para>
  <para style="r">(<ref loc="LUK 12:2-7">𐴓𐴟𐴑 12‏:2‏-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴒𐴟𐴥𐴙𐴅𐴧𐴝 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴎𐴝𐴕𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴕𐴝𐴥𐴘.</char> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴞𐴀𐴕 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴈𐴡𐴀𐴙𐴌, 𐴇𐴞𐴥𐴀𐴕 𐴉𐴡𐴀𐴌𐴡𐴃𐴢 𐴈𐴡𐴘𐴧𐴡𐴥; 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴝𐴕𐴡𐴃𐴢 𐴉𐴟𐴥𐴐𐴉𐴟𐴐𐴝𐴘 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴊𐴡𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴠𐴓𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char> <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" /><char style="wj">𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴝𐴘𐴧𐴝𐴌𐴠 𐴑𐴡𐴃𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴔𐴡𐴕𐴃𐴡𐴌 𐴌𐴟𐴀𐴌𐴠 𐴑𐴡𐴃𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠; 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴟𐴁𐴝𐴤𐴌𐴠 𐴋𐴡𐴦𐴌𐴡 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴌𐴟𐴀 𐴀𐴠𐴊𐴧𐴠 𐴅𐴞𐴏𐴞𐴥𐴔 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴎𐴟𐴎𐴟𐴑𐴡𐴃𐴢 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴉𐴝𐴌𐴠.</char> <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" /><char style="wj">𐴊𐴟𐴖𐴝𐴥 𐴉𐴞𐴛𐴝𐴙𐴅𐴧𐴝 𐴑𐴞 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴔 𐴄𐴞𐴛𐴝 𐴓𐴡𐴘 𐴕𐴡 𐴁𐴠𐴏𐴠 𐴕𐴠𐴥؟ 𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴡𐴌 𐴀𐴠𐴎𐴞𐴕 𐴏𐴝𐴥𐴌𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴘𐴡𐴥 𐴔𐴠𐴍𐴞𐴃𐴢 𐴉𐴡𐴌𐴠 𐴊𐴠 𐴕𐴝𐴥𐴘.</char> <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" /><char style="wj">𐴁𐴠𐴐𐴡𐴥𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴏𐴟𐴓𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴒𐴡𐴕𐴝 𐴀𐴝𐴏𐴠𐴤.</char> <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴞𐴔𐴡𐴃𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴉𐴞𐴛𐴝𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤.</char><verse eid="MAT 10:31" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴝𐴥</para>
  <para style="r">(<ref loc="LUK 12:8-9">𐴓𐴟𐴑 12‏:8‏-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />
    <char style="wj">”𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔.</char> <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔.</char><verse eid="MAT 10:33" /></para>
  <para style="s1">𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴡𐴓𐴟𐴖𐴝𐴌</para>
  <para style="r">(<ref loc="LUK 12:51-53">𐴓𐴟𐴑 12‏:51‏-53</ref>; <ref loc="LUK 14:26-27">14‏:26‏-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴐𐴝𐴥𐴕𐴃𐴞 𐴊𐴞𐴦𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴁𐴡𐴥𐴓𐴞 𐴕𐴡 𐴄𐴝𐴥𐴀𐴌𐴞𐴘𐴡. 𐴀𐴝𐴀𐴛 𐴐𐴝𐴥𐴕𐴃𐴞 𐴊𐴞𐴦𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴏𐴡𐴓𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠.</char> <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴊𐴠,</char></para>
  <para style="li1" vid="MAT 10:35">
    <char style="wj">𐴉𐴟𐴖𐴝𐴌𐴠 𐴁𐴝𐴉𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴒𐴡𐴌𐴞𐴥𐴊𐴞 𐴁𐴡𐴓𐴧𐴝,</char></para>
  <para style="li2" vid="MAT 10:35">
    <char style="wj">𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝𐴌𐴠 𐴔𐴝𐴦𐴌 𐴀𐴟𐴓𐴋𐴝 𐴒𐴡𐴌𐴞𐴥𐴊𐴞 𐴁𐴡𐴓𐴧𐴝,</char></para>
  <para style="li2" vid="MAT 10:35">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴇𐴡𐴥𐴖𐴌𐴞𐴌 𐴀𐴟𐴓𐴋𐴝 𐴒𐴡𐴌𐴞𐴥𐴊𐴞 𐴁𐴡𐴓𐴧𐴝.</char><verse eid="MAT 10:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="MAT 10:36" />
    <char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10‏:36 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="MIC 7:6">𐴔𐴞𐴑𐴝𐴘𐴝 7‏:6</ref>
        </char>
      </char>
    </note><verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴘𐴝𐴥 𐴔𐴝𐴦𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴘𐴝𐴥 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡.</char> <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴢 𐴕𐴡 𐴁𐴡𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡.</char> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥 𐴏𐴝𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴝𐴘𐴁𐴡.</char><verse eid="MAT 10:39" /></para>
  <para style="s1">𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 9:41">𐴔𐴝𐴑 9‏:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠.</char> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴁𐴞𐴌𐴠 𐴕𐴡𐴁𐴞𐴌 𐴕𐴝𐴔𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴡𐴁𐴞𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴉𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴡𐴕𐴡𐴤 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴡𐴌𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴡𐴌 𐴕𐴝𐴔𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴡𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴉𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" /><char style="wj">𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴁𐴧𐴠 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴀𐴠𐴥𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴠𐴑 𐴉𐴞𐴘𐴝𐴓𐴝 𐴄𐴝𐴥𐴕𐴋𐴝 𐴉𐴝𐴕𐴞𐴥 𐴊𐴞𐴦𐴓𐴠𐴥 𐴀𐴟𐴥𐴊𐴧𐴗𐴝, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴉𐴝𐴘 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴐𐴡𐴥𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴃𐴡 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴈𐴠𐴥𐴕𐴃𐴟 𐴁𐴝𐴐𐴝𐴥 𐴓𐴡𐴥𐴘𐴧𐴠.<verse eid="MAT 11:1" /></para>
  <para style="s1">𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴈𐴡𐴥𐴁𐴡𐴌𐴒𐴗𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="r">(<ref loc="LUK 7:18-35">𐴓𐴟𐴑 7‏:18‏-35</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴃𐴝𐴥𐴘 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />𐴘𐴝𐴀𐴕 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, ”𐴃𐴟𐴀𐴛 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴕𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟“<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴦, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴉𐴟𐴥𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴠𐴑𐴡𐴥𐴌 𐴇𐴞𐴥𐴀𐴕 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌𐴠 𐴎𐴝𐴕𐴡𐴒𐴡𐴥𐴘,</char> <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" /><char style="wj">𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴊𐴝𐴤𐴘𐴠 𐴊𐴠𐴑𐴠𐴥𐴌, 𐴓𐴠𐴚𐴠 𐴀𐴝𐴥𐴣𐴍𐴠𐴌, 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴌, 𐴕𐴝𐴥𐴉𐴝𐴚𐴠 𐴉𐴟𐴥𐴕𐴠𐴌, 𐴔𐴟𐴌𐴟𐴊𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴌.</char> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" /><char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴁𐴝𐴤, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴕𐴊𐴝𐴐𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥.“</char><verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴧𐴟𐴕 𐴎𐴝𐴦𐴌𐴒𐴡𐴥𐴘, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴑𐴞𐴦 𐴏𐴝𐴘𐴃𐴡𐴥 𐴒𐴞𐴀𐴓𐴝 𐴊𐴠𐴥؟ 𐴁𐴡𐴘𐴧𐴝𐴌𐴠 𐴓𐴡𐴌𐴠 𐴊𐴠 𐴇𐴡𐴥𐴙𐴌 𐴕𐴠𐴥؟</char> <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" /><char style="wj">𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴏𐴝𐴘𐴃𐴡𐴥 𐴒𐴞𐴀𐴓𐴝 𐴊𐴠𐴥؟ 𐴁𐴝𐴌𐴞𐴥𐴑 𐴇𐴡𐴦𐴌 𐴉𐴞𐴕𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴕𐴠𐴥؟ 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴝𐴌𐴞𐴥𐴑 𐴇𐴡𐴦𐴌 𐴉𐴞𐴣𐴊𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴌𐴝𐴎𐴔𐴡𐴇𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴠𐴥𐴕𐴝.</char> <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" /><char style="wj">𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴏𐴝𐴘𐴃𐴡𐴥 𐴒𐴞𐴀𐴓𐴝 𐴊𐴠𐴥؟ 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴁𐴞 𐴕𐴠𐴥؟ 𐴀𐴡𐴥𐴘, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴕𐴡𐴁𐴞𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴡𐴌𐴠.</char> <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, </char></para>
  <para style="li1" vid="MAT 11:10">
    <char style="wj">’𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴥𐴁𐴡𐴌𐴒𐴗𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴒𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌,</char></para>
  <para style="li2" vid="MAT 11:10">
    <char style="wj">𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴒𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴡𐴣𐴃𐴢 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">11‏:10 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="MAL 3:1">𐴔𐴝𐴓𐴝𐴑𐴞𐴥 3‏:1</ref>
        </char> </char>
    </note><verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴝𐴥𐴘; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠𐴁𐴧𐴠 𐴐𐴡𐴥𐴣𐴍𐴡, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌. </char> <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" /><char style="wj">𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴘𐴝𐴓𐴝 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴘𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴉𐴝𐴦𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴎𐴟𐴓𐴟𐴥𐴔𐴑𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴁𐴡𐴓𐴝𐴎𐴟𐴌𐴞 𐴑𐴡𐴁𐴎𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥𐴌.</char> <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴝𐴔𐴝𐴥𐴔 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴞𐴃𐴝𐴁𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌𐴝𐴃𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥.</char> <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴘𐴝𐴀𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴥𐴁𐴝.</char> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" /><char style="wj">𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴥𐴕𐴡. </char><verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴑𐴞𐴦 𐴓𐴡𐴘 𐴉𐴟𐴥𐴖𐴝𐴕 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟ 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴝𐴎𐴝𐴌𐴡𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴀𐴡𐴙𐴕𐴧𐴡 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀 𐴊𐴠, </char><verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />
    <char style="wj">’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴝𐴐𐴞𐴤 𐴁𐴝𐴎𐴝𐴘𐴧𐴞𐴥,</char></para>
  <para style="q2" vid="MAT 11:17">
    <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡𐴥 𐴕𐴝𐴏𐴡;</char></para>
  <para style="q1" vid="MAT 11:17">
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴞𐴓𐴝𐴑𐴡𐴌 𐴎𐴝𐴌𐴞 𐴒𐴝𐴘𐴧𐴞𐴥,</char></para>
  <para style="q2" vid="MAT 11:17">
    <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡𐴥 𐴈𐴝𐴣𐴊𐴡.‘</char><verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />
    <char style="wj">𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴀𐴝𐴀𐴘𐴢 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴈𐴡𐴀 𐴊𐴠, ’𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴟𐴥𐴃𐴠 𐴉𐴝𐴘𐴧𐴠𐴥.‘</char> <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" /><char style="wj">𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴀𐴘𐴢 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴈𐴡𐴀 𐴊𐴠, ’𐴏𐴡𐴀, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴉𐴞𐴃𐴝𐴥𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴥𐴌𐴝𐴁𐴑𐴟𐴌, 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴟𐴏𐴃𐴡𐴥.‘ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴒𐴞𐴘𐴝𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴈𐴝𐴔𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥.“</char><verse eid="MAT 11:19" /></para>
  <para style="s1">𐴃𐴡𐴖𐴝𐴥 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢</para>
  <para style="r">(<ref loc="LUK 10:13-15">𐴓𐴟𐴑 10‏:13‏-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴠 𐴐𐴡𐴥𐴀𐴌 𐴒𐴟𐴥𐴕𐴡𐴃𐴢 𐴁𐴠𐴦𐴐𐴁𐴝𐴥𐴑 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴞 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴡𐴖𐴝𐴥 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" /><char style="wj">”𐴀𐴡𐴥 𐴑𐴡𐴌𐴝𐴎𐴞𐴕، 𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴀𐴡𐴥 𐴁𐴠𐴃𐴏𐴝𐴥𐴘𐴊𐴝, 𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴞 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴎𐴡𐴊𐴞 𐴄𐴝𐴘𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴥𐴊𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴃𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴥𐴓𐴝𐴌𐴐𐴡𐴄𐴢 𐴉𐴞𐴣𐴊𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴥𐴘𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴀𐴘𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴃𐴡. </char> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕، 𐴇𐴠𐴥 𐴄𐴝𐴘𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴥𐴊𐴡𐴕𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴔 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" /><char style="wj">𐴀𐴝𐴦𐴌 𐴃𐴟𐴘, 𐴀𐴡𐴥 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔, 𐴃𐴡𐴌𐴠𐴥 𐴑𐴞𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴁𐴝𐴎𐴠𐴥 𐴉𐴝𐴥𐴕 𐴖𐴡𐴌𐴠 𐴃𐴟𐴓𐴝𐴤 𐴎𐴝𐴘𐴁𐴡؟ 𐴃𐴡𐴌𐴠𐴥 𐴕𐴞𐴏𐴠 𐴉𐴝𐴃𐴝𐴓𐴉𐴟𐴌𐴡𐴃𐴢 𐴀𐴠𐴥𐴕𐴝 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴞 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴎𐴡𐴊𐴞 𐴏𐴡𐴥𐴊𐴡𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴃𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴙𐴅 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴡.</char> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕، 𐴏𐴡𐴥𐴊𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴃𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴔 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.“ </char><verse eid="MAT 11:24" /></para>
  <para style="s1">𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴧𐴡𐴤</para>
  <para style="r">(<ref loc="LUK 10:21-22">𐴓𐴟𐴑 10‏:21‏-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴀𐴝𐴏𐴔𐴝𐴕 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴀𐴞𐴀𐴕𐴡𐴌𐴠 𐴒𐴞𐴘𐴝𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴊𐴧𐴞𐴥𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴑𐴞𐴥 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char> <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" /><char style="wj">𐴀𐴡𐴥𐴘, 𐴀𐴡𐴥 𐴁𐴝𐴉𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴞𐴐𐴞𐴤 𐴉𐴡𐴏𐴡𐴥𐴕 𐴓𐴝𐴙𐴒𐴧𐴠𐴥. </char><verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />
    <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. 𐴉𐴟𐴖𐴝𐴌𐴠 𐴁𐴝𐴉𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴘𐴡𐴥 𐴉𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴖𐴝𐴘𐴠 𐴎𐴝𐴌𐴠𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴝𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠.</char><verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴡𐴥𐴌𐴝𐴕 𐴀𐴡𐴥𐴘𐴧𐴡 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴥𐴌 𐴉𐴟𐴣𐴎𐴝𐴤 𐴓𐴡𐴥𐴘 𐴀𐴝𐴏𐴡𐴤, 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴝𐴔 𐴊𐴞𐴦𐴘𐴟𐴔.</char> <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴎𐴟𐴣𐴖𐴝𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴓𐴡𐴦 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴐𐴞𐴥𐴑𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴕𐴡𐴌𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴐𐴞𐴥𐴊𐴝 𐴊𐴞𐴓𐴢 𐴀𐴡𐴓𐴝, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴡𐴌𐴝𐴕𐴠 𐴀𐴝𐴌𐴝𐴔 𐴉𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴎𐴟𐴣𐴖𐴝𐴓𐴢 𐴁𐴡𐴘𐴃𐴠𐴥 𐴀𐴝𐴏𐴝𐴤𐴕, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴣𐴎𐴝𐴤 𐴉𐴝𐴃𐴡𐴓𐴢.“</char><verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴒𐴞𐴣𐴘𐴟𐴌 𐴃𐴟𐴥𐴌 𐴃𐴟𐴓𐴝𐴤</para>
  <para style="r">(<ref loc="MRK 2:23-28">𐴔𐴝𐴑 2‏:23‏-28</ref>; <ref loc="LUK 6:1-5">𐴓𐴟𐴑 6‏:1‏-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴀𐴞𐴏𐴝𐴤 𐴒𐴞𐴣𐴘𐴟𐴌 𐴑𐴟𐴣𐴍𐴝𐴤 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦𐴌; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴟𐴥𐴑 𐴓𐴝𐴙𐴒𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴞𐴣𐴘𐴟𐴌 𐴃𐴟𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴓𐴞𐴤-𐴃𐴟𐴓𐴞𐴤 𐴈𐴝𐴥𐴀𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴕𐴝𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴒𐴡𐴌𐴠𐴥𐴌.“<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴘𐴝𐴀𐴕 𐴕𐴡𐴥 𐴉𐴡𐴌𐴡𐴥, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴝𐴖𐴟𐴊𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴟𐴥𐴑 𐴓𐴝𐴙𐴒𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴦 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠𐴥؟</char> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" /><char style="wj">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴌𐴟𐴄𐴞 𐴈𐴝𐴥𐴀𐴙𐴓𐴢, 𐴎𐴞𐴀𐴕 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴕𐴡 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.</char> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" /><char style="wj">𐴘𐴝𐴥𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴃𐴡𐴌𐴝𐴃𐴡𐴃𐴢 𐴘𐴝𐴀𐴕 𐴕𐴡𐴥 𐴉𐴡𐴌𐴡𐴥, 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴁𐴝𐴥𐴚𐴒𐴞𐴓𐴠 𐴘𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴠𐴥؟</char> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.</char> <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤𐴌 𐴔𐴝𐴀𐴕𐴞 𐴒𐴝𐴥𐴕 𐴎𐴝𐴙𐴕𐴃𐴝, ’𐴀𐴝𐴀𐴛 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠,‘</char> <note caller="+" style="f"><char style="fr" closed="false">12‏:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">𐴇𐴡𐴥𐴐𐴞𐴘𐴝 6‏:6</ref></char></char></note> <char style="wj">𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌𐴡𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴕𐴡 𐴊𐴞𐴃𐴝.</char> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕𐴡𐴌 𐴔𐴝𐴓𐴞𐴑.“</char><verse eid="MAT 12:8" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴉𐴟𐴥𐴖𐴝𐴕𐴝 𐴀𐴝𐴥𐴃𐴢 𐴀𐴡𐴓𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢</para>
  <para style="r">(<ref loc="MRK 3:1-6">𐴔𐴝𐴑 3‏:1‏-6</ref>; <ref loc="LUK 6:6-11">𐴓𐴟𐴑 6‏:6‏-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />𐴀𐴞𐴏𐴝𐴤 𐴈𐴠𐴥𐴕𐴃𐴟 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴝𐴌 𐴀𐴝𐴥𐴃𐴢 𐴉𐴟𐴥𐴖𐴝𐴘𐴒𐴞𐴘𐴡𐴘. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴓𐴎𐴝𐴔 𐴓𐴝𐴒𐴝𐴘 𐴉𐴝𐴌𐴠 𐴉𐴝𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴝𐴘𐴠𐴏𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥؟“<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴝𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴒𐴝𐴣𐴌𐴝𐴥𐴃𐴢 𐴉𐴡𐴌𐴞𐴓𐴠𐴥 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴃𐴟𐴓𐴞𐴤 𐴕𐴡 𐴓𐴡𐴘𐴁𐴡 𐴊𐴠𐴥؟</char> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" /><char style="wj">𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴑𐴞𐴔𐴡𐴃𐴢 𐴃𐴡 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴞𐴐𐴞𐴤! 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴝𐴘𐴠𐴏𐴢 𐴀𐴝𐴏𐴠𐴤.“</char><verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴥𐴃𐴧𐴝𐴕 𐴁𐴝𐴌𐴡𐴥.“</char> 𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴌𐴝𐴤𐴘𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘 𐴀𐴡𐴙𐴕𐴧𐴡 𐴒𐴝𐴥𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴀𐴌𐴠 𐴎𐴝𐴘 𐴏𐴡𐴥𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴞𐴦 𐴁𐴡𐴃𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.<verse eid="MAT 12:14" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴙𐴐𐴧𐴝𐴥 𐴈𐴝𐴥𐴀𐴊𐴠𐴔</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞 𐴈𐴠𐴥𐴕𐴃𐴟 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴞𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴞𐴐𐴡𐴥𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴃𐴡𐴤. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />”𐴏𐴡𐴀! 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴌𐴠, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴀𐴛 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴞,</para>
  <para style="q2" vid="MAT 12:18">𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌 𐴌𐴟𐴀 𐴑𐴟𐴥𐴐𐴞.</para>
  <para style="q1" vid="MAT 12:18">𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴌𐴟𐴀 𐴀𐴞𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴟𐴔,</para>
  <para style="q2" vid="MAT 12:18">𐴀𐴝𐴦𐴌 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴀𐴠𐴓𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴡 𐴇𐴡𐴙𐴅𐴧𐴝 𐴊𐴞𐴁𐴡, 𐴕𐴡 𐴏𐴞𐴓𐴧𐴝𐴘𐴁𐴡𐴥,</para>
  <para style="q2" vid="MAT 12:19">𐴀𐴝𐴦𐴌 𐴕𐴡 𐴌𐴝𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴞𐴁𐴝𐴤𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴉𐴟𐴥𐴕𐴞𐴁𐴡.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴡𐴌𐴠 𐴉𐴡𐴥𐴃𐴝 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡,</para>
  <para style="q2" vid="MAT 12:20">𐴀𐴠𐴥𐴓𐴝𐴘𐴧𐴝 𐴇𐴡𐴥𐴙𐴌𐴡𐴌𐴠 𐴕𐴡 𐴁𐴝𐴥𐴚𐴒𐴞𐴁𐴡,</para>
  <para style="q1" vid="MAT 12:20">𐴀𐴝𐴦𐴌 𐴊𐴟𐴥𐴖𐴝𐴣𐴌 𐴊𐴠 𐴁𐴝𐴃𐴧𐴞 𐴕𐴡 𐴕𐴞𐴉𐴝𐴥𐴘𐴁𐴡.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />𐴀𐴞𐴁𐴝𐴤𐴌 𐴕𐴝𐴔𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴐𐴝𐴤 𐴌𐴝𐴑𐴞𐴥𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">12‏:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 42:1-4">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 42‏:1‏-4</ref></char></char></note><verse eid="MAT 12:21" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 3:20-30">𐴔𐴝𐴑 3‏:20‏-30</ref>; <ref loc="LUK 11:14-23">𐴓𐴟𐴑 11‏:14‏-23</ref>; <ref loc="LUK 12:10">12‏:10</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴕𐴝𐴤 𐴒𐴞𐴥𐴘𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴑 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴇𐴠𐴥 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴔𐴝𐴃𐴞 𐴘𐴡𐴥 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴊𐴠𐴑𐴞𐴥 𐴘𐴡𐴥 𐴉𐴝𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴘 𐴕𐴠𐴥؟“<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴥𐴉𐴝 𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴡𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴠.“<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴌𐴠 𐴎𐴝𐴕𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴎𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴘𐴝𐴥 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴃𐴡 𐴄𐴞𐴑𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.</char> <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴎𐴡𐴊𐴞 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕 𐴊𐴝𐴥𐴉𐴝, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴕𐴞𐴎𐴠 𐴁𐴝𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴇𐴠𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡؟</char> <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴁𐴟𐴥𐴃𐴢 𐴊𐴝𐴥𐴉𐴝𐴘 𐴊𐴠 𐴁𐴠𐴓𐴎𐴠𐴁𐴟𐴓𐴡𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴇𐴝𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴠 𐴊𐴝𐴥𐴉𐴝 𐴊𐴠𐴥؟ 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝.</char> <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴁𐴟𐴥𐴃𐴢 𐴊𐴝𐴥𐴉𐴝𐴘 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘.</char><verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />
    <char style="wj">”𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴡𐴓𐴟𐴖𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴓𐴟𐴄𐴢 𐴒𐴡𐴌𐴞𐴥 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴉𐴝𐴌𐴞𐴁𐴡𐴥, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴒𐴠 𐴁𐴡𐴓𐴟𐴖𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴝𐴣𐴊𐴞𐴥 𐴕𐴡 𐴀𐴠𐴌𐴠؟ 𐴁𐴝𐴣𐴊𐴞𐴥 𐴀𐴠𐴌𐴞𐴓𐴠𐴥 𐴀𐴠𐴥𐴕𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴡𐴥𐴌 𐴓𐴟𐴄𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥. </char><verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴕𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴓𐴋𐴝; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴊𐴡𐴓𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴐𐴞𐴥𐴣𐴍𐴝𐴐𐴞𐴄𐴧𐴝𐴤 𐴒𐴡𐴌𐴠𐴥.</char><verse eid="MAT 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 12:31" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴀𐴟𐴓𐴋𐴝 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" /><char style="wj">𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴃𐴡 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴀𐴡𐴥 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴀𐴡𐴥 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="MAT 12:32" /></para>
  <para style="s1">𐴒𐴝𐴏𐴢 𐴏𐴞𐴕𐴝𐴥 𐴎𐴝 𐴊𐴠 𐴒𐴟𐴓𐴝𐴘𐴠</para>
  <para style="r">(<ref loc="LUK 6:43-45">𐴓𐴟𐴑 6‏:43‏-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />
    <char style="wj">”𐴒𐴝𐴏𐴢 𐴒𐴡𐴔 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴒𐴟𐴓𐴝 𐴘𐴡𐴥 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴒𐴝𐴏𐴢 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴒𐴟𐴓𐴝 𐴘𐴡𐴥 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴁𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴝𐴏𐴢 𐴃𐴡 𐴒𐴟𐴓𐴝𐴘𐴠 𐴀𐴠𐴥𐴕𐴝 𐴏𐴞𐴕𐴝𐴥 𐴎𐴝.</char> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" /><char style="wj">𐴀𐴡𐴥 𐴇𐴝𐴥𐴉𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢! 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴒𐴡𐴔 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴘𐴢 𐴉𐴝𐴌𐴞𐴁𐴝𐴥؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴞𐴓𐴢 𐴎𐴞𐴀𐴕𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝, 𐴔𐴟𐴑𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠 𐴈𐴡𐴀.</char> <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" /><char style="wj">𐴒𐴡𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴒𐴡𐴔 𐴎𐴡𐴔𐴝𐴘𐴧𐴝𐴃𐴧𐴟 𐴒𐴡𐴔 𐴔𐴟𐴥𐴕 𐴕𐴠𐴦𐴓𐴝; 𐴀𐴝𐴦𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴎𐴡𐴔𐴝𐴘𐴧𐴝𐴃𐴧𐴟 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴉𐴟𐴕 𐴕𐴠𐴦𐴓𐴝.</char> <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴕𐴡 𐴁𐴝𐴥𐴉𐴞 𐴈𐴡𐴀 𐴊𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴈𐴡𐴃𐴝𐴤𐴌 𐴇𐴞𐴥𐴏𐴝𐴉𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴊𐴞𐴘𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴄𐴡𐴥𐴀𐴌𐴞𐴁𐴝 𐴊𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴞𐴁𐴝 𐴊𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤𐴘𐴠.“</char><verse eid="MAT 12:37" /></para>
  <para style="s1">𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴝𐴌 𐴊𐴝𐴁𐴞</para>
  <para style="r">(<ref loc="MRK 8:11-12">𐴔𐴝𐴑 8‏:11‏-12</ref>; <ref loc="LUK 11:29-32">𐴓𐴟𐴑 11‏:29‏-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴀𐴝𐴓𐴠𐴔 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴥𐴎𐴟𐴌, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕 𐴏𐴝𐴘𐴃𐴡𐴥 𐴏𐴝𐴀𐴘𐴢.“<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴡𐴁𐴞 𐴘𐴟𐴕𐴟𐴏𐴡𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴞𐴘𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴟𐴕𐴟𐴏𐴢 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴞𐴕 𐴊𐴞𐴕 𐴃𐴞𐴕 𐴌𐴝𐴙𐴃𐴢 𐴋𐴡𐴣𐴀𐴌 𐴔𐴝𐴏𐴡𐴌 𐴉𐴠𐴍𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴡𐴥 𐴔𐴠𐴍𐴞𐴌 𐴃𐴡𐴓𐴠 𐴃𐴞𐴕 𐴊𐴞𐴕 𐴃𐴞𐴕 𐴌𐴝𐴙𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.</char> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" /><char style="wj">𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴕𐴞𐴕𐴞𐴜𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴀𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴞𐴥𐴘𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥𐴁𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴘𐴟𐴕𐴟𐴏𐴡𐴌 𐴀𐴠𐴓𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴏𐴡𐴀, 𐴘𐴟𐴕𐴟𐴏𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.</char> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" /><char style="wj">𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴐𐴞𐴁𐴝𐴤 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴌 𐴌𐴝𐴕𐴞 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴀𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴟𐴍𐴞𐴤𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥𐴁𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴏𐴡𐴥𐴓𐴡𐴔𐴝𐴕𐴡𐴌 𐴁𐴟𐴊𐴧𐴞𐴥𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴞 𐴁𐴡𐴓𐴧𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴐𐴠𐴥𐴐𐴢 𐴔𐴝𐴃𐴝𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴏𐴡𐴀, 𐴏𐴡𐴥𐴓𐴡𐴔𐴝𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.</char><verse eid="MAT 12:42" /></para>
  <para style="s1">𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴡𐴌 𐴖𐴝𐴦𐴉𐴠𐴏𐴞</para>
  <para style="r">(<ref loc="LUK 11:24-26">𐴓𐴟𐴑 11‏:24‏-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />
    <char style="wj">”𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴕𐴠𐴦𐴓𐴠, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴇𐴠𐴥 𐴅𐴞𐴕 𐴕𐴗𐴝𐴥 𐴉𐴟𐴥𐴖𐴝𐴕𐴝 𐴎𐴝𐴒𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴎𐴝𐴘 𐴀𐴝𐴌𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴎𐴝𐴒𐴝 𐴃𐴟𐴖𐴝. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴉𐴝𐴘𐴓𐴠, </char> <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" /><char style="wj">𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴈𐴡𐴀 𐴊𐴠 ’𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴎𐴝𐴘𐴧𐴟𐴔𐴁𐴡𐴥𐴘, 𐴎𐴠𐴕𐴃𐴟𐴥 𐴀𐴝𐴀𐴛 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴙𐴐𐴧𐴞𐴥,‘ 𐴘𐴞𐴥𐴁𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴞, 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴄𐴞𐴥𐴑 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴓𐴡𐴦𐴃𐴉𐴝.</char> <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" /><char style="wj">𐴁𐴝𐴦𐴊𐴠 𐴘𐴞𐴥𐴁𐴝 𐴎𐴝𐴘 𐴀𐴝𐴌𐴡𐴤 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴕𐴞𐴎𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕 𐴀𐴝𐴕𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴥𐴓𐴞 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴑𐴠; 𐴃𐴡𐴥𐴘 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴉𐴞𐴏𐴡𐴥𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴒𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡.“</char><verse eid="MAT 12:45" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕</para>
  <para style="r">(<ref loc="MRK 3:31-35">𐴔𐴝𐴑 3‏:31‏-35</ref>; <ref loc="LUK 8:19-21">𐴓𐴟𐴑 8‏:19‏-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴃𐴡𐴤 𐴁𐴝𐴀𐴌𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴃𐴡𐴤 𐴁𐴝𐴀𐴌𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠.“<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴦 𐴇𐴡𐴕؟ 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤؟“</char> <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴟 𐴀𐴝𐴥𐴃𐴢 𐴁𐴝𐴌𐴝𐴤𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥𐴃𐴞𐴘𐴝, 𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕.</char> <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘, 𐴁𐴡𐴥𐴙𐴕 𐴀𐴝𐴦𐴌 𐴔𐴝𐴦.“</char><verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴍𐴡𐴘𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 4:1-9">𐴔𐴝𐴑 4‏:1‏-9</ref>; <ref loc="LUK 8:4-8">𐴓𐴟𐴑 8‏:4‏-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴞𐴏𐴝𐴤 𐴒𐴡𐴥𐴌𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴞 𐴋𐴞𐴀𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴎𐴝𐴘 𐴁𐴡𐴙𐴐𐴧𐴠𐴥𐴒𐴡𐴘. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠𐴥 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴁𐴡𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴑𐴟𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, <char style="wj">”𐴉𐴟𐴥𐴕𐴡, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴍𐴡𐴘𐴝 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴄𐴧𐴡 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥.</char> <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴐𐴞𐴥𐴣𐴍𐴠𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴌𐴝𐴏𐴃𐴝𐴌</char><note caller="+" style="f"><char style="fr" closed="false">13‏:4 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa">𐴀𐴝𐴙𐴓𐴢 𐴀𐴡𐴌</char> </note> <char style="wj">𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴀𐴘𐴢 𐴇𐴞𐴥𐴀𐴕 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠.</char> <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" /><char style="wj">𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴓𐴢 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴍𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴔𐴠𐴍𐴞 𐴕𐴝𐴥𐴘. 𐴔𐴟𐴌 𐴔𐴠𐴍𐴞 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴇𐴝𐴥𐴌𐴝 𐴒𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.</char> <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴠𐴙𐴓𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥 𐴌𐴝𐴥𐴌 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴐𐴞𐴥𐴛𐴡𐴌 𐴕𐴡𐴥 𐴒𐴝𐴏𐴝𐴤 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴖𐴝𐴘𐴒𐴞𐴘𐴡𐴘.</char> <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" /><char style="wj">𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴑𐴠𐴣𐴍𐴝𐴁𐴡𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴑𐴠𐴣𐴍𐴝𐴁𐴡𐴕 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴞𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴏𐴞𐴁𐴞 𐴌𐴝𐴙𐴑𐴧𐴠𐴥.</char> <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴞𐴏𐴢 𐴒𐴡𐴔 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴊𐴡𐴥𐴙𐴅𐴧𐴠: 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴒𐴟𐴕, 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴇𐴝𐴥𐴙𐴄𐴢 𐴒𐴟𐴕, 𐴀𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴃𐴞𐴌𐴞𐴥𐴐𐴢 𐴒𐴟𐴕.</char> <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" /><char style="wj">𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴥𐴕𐴡.“</char><verse eid="MAT 13:9" /></para>
  <para style="s1">𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴟𐴕𐴡𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢</para>
  <para style="r">(<ref loc="MRK 4:10-12">𐴔𐴝𐴑 4‏:10‏-12</ref>; <ref loc="LUK 8:9-10">𐴓𐴟𐴑 8‏:9‏-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />𐴁𐴝𐴦𐴊𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴑𐴞𐴘𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀؟“<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴒𐴟𐴉𐴡𐴕𐴞𐴌𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴠 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴘𐴝 𐴕𐴡𐴥 𐴎𐴝.</char> <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴝𐴃𐴧𐴟 𐴕𐴞𐴑𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴡𐴥𐴊𐴡𐴌𐴁𐴝𐴀𐴌𐴝 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴝𐴃𐴧𐴟 𐴕𐴞𐴑𐴞 𐴕𐴝𐴥𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" /><char style="wj">𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴁𐴠 𐴈𐴡𐴀𐴘𐴢,</char></para>
  <para style="q1" vid="MAT 13:13">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴘𐴓𐴠𐴥 𐴘𐴡 𐴕𐴡 𐴊𐴠𐴑𐴠𐴥,</char></para>
  <para style="q2" vid="MAT 13:13">
    <char style="wj">𐴉𐴟𐴥𐴕𐴞𐴓𐴠 𐴘𐴡 𐴕𐴡 𐴉𐴟𐴥𐴕𐴠, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴘𐴡𐴥 𐴁𐴟𐴎𐴠𐴥.</char><verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />
    <char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴧𐴠,</char></para>
  <para style="q1" vid="MAT 13:14">
    <char style="wj">’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴝𐴕𐴠 𐴉𐴟𐴥𐴕𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴝 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴁𐴟𐴎𐴞𐴥𐴁𐴝,</char></para>
  <para style="q2" vid="MAT 13:14">
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴟𐴑𐴠𐴤 𐴏𐴝𐴀𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴝 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥𐴁𐴝.</char><verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴃𐴡 𐴊𐴡𐴌𐴡𐴤 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴝𐴕 𐴁𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴠𐴤 𐴊𐴠𐴑𐴞𐴥𐴃𐴡,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">𐴈𐴝𐴕𐴠 𐴉𐴟𐴥𐴕𐴞𐴃𐴡,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴠 𐴁𐴟𐴎𐴞𐴥 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴞𐴥𐴌𐴞 𐴀𐴝𐴘𐴃𐴡𐴤,</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔.‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13‏:15 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 6:9">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 6‏:9</ref>‏,<ref loc="ISA 6:10">10</ref></char>
      </char>
    </note><verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />
    <char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴟𐴑, 𐴇𐴞𐴥𐴀𐴕𐴠 𐴊𐴠𐴑𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝; 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴝𐴕, 𐴇𐴞𐴥𐴀𐴕𐴠 𐴉𐴟𐴥𐴕𐴠 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝.</char> <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴁𐴡𐴀𐴗𐴃𐴢 𐴕𐴡𐴁𐴞 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴊𐴠𐴑𐴡𐴥𐴌 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡𐴥 𐴊𐴠𐴑𐴠𐴥; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴉𐴟𐴥𐴕𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴥 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡𐴥 𐴉𐴟𐴥𐴕𐴠.</char><verse eid="MAT 13:17" /></para>
  <para style="s1">𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴍𐴡𐴘𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴁𐴟𐴎𐴝𐴥𐴘𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MRK 4:13-20">𐴔𐴝𐴑 4‏:13‏-20</ref>; <ref loc="LUK 8:11-15">𐴓𐴟𐴑 8‏:11‏-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />
    <char style="wj">”𐴘𐴝𐴓𐴝 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴍𐴡𐴘𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴑𐴞𐴦 𐴉𐴟𐴥𐴕𐴡.</char> <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴠 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴁𐴟𐴎𐴠𐴥, 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴝𐴀𐴘𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴎𐴞𐴀𐴕 𐴐𐴞𐴥𐴣𐴍𐴝 𐴒𐴞𐴥𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴌𐴞𐴤 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴌𐴝𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴁𐴞𐴏𐴢.</char> <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" /><char style="wj">𐴐𐴞𐴥𐴓𐴢 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴁𐴞𐴏𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴠 𐴀𐴝𐴦𐴌 𐴀𐴠𐴥𐴇𐴡𐴕 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥;</char> <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴐𐴞𐴥𐴛𐴡𐴌 𐴕𐴡𐴥 𐴒𐴝𐴏𐴝𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕 𐴇𐴡𐴦𐴊𐴧𐴞𐴕 𐴁𐴠 𐴃𐴝𐴥𐴑𐴠. 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴠𐴥 𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴘𐴝𐴥 𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴠𐴥𐴇𐴡𐴕 𐴉𐴞𐴏𐴧𐴝𐴥 𐴔𐴝𐴌𐴠.</char> <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" /><char style="wj">𐴑𐴠𐴣𐴍𐴝𐴁𐴡𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴁𐴞𐴏𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴥𐴕-𐴊𐴡𐴓𐴡𐴃𐴡𐴌 𐴀𐴝𐴊𐴡𐴌𐴠 𐴇𐴠𐴥 𐴑𐴝𐴓𐴝𐴔𐴡𐴌𐴠 𐴏𐴞𐴁𐴞 𐴌𐴝𐴑𐴠𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴒𐴟𐴓𐴝 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠.</char> <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴒𐴡𐴔 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴁𐴞𐴏𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴎𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴝: 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴒𐴟𐴕, 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴇𐴝𐴥𐴙𐴄𐴢 𐴒𐴟𐴕, 𐴀𐴝𐴦𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴃𐴞𐴌𐴞𐴥𐴐𐴢 𐴒𐴟𐴕.“</char><verse eid="MAT 13:23" /></para>
  <para style="s1">𐴒𐴞𐴣𐴘𐴟𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴒𐴡𐴔 𐴁𐴞𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴐𐴞𐴥𐴣𐴄𐴧𐴠.</char> <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴟𐴥𐴔 𐴒𐴞𐴥𐴘𐴠 𐴌𐴝𐴥𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴝𐴀𐴘𐴢 𐴒𐴞𐴣𐴘𐴟𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝𐴌 𐴁𐴞𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴐𐴞𐴥𐴣𐴍𐴞𐴊𐴞 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.</char> <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴒𐴞𐴣𐴘𐴟𐴌 𐴏𐴝𐴌𐴝 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴞𐴤 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴊𐴡𐴥𐴙𐴅𐴧𐴠, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝 𐴘𐴡𐴥 𐴊𐴝𐴈𐴝𐴤 𐴒𐴞𐴥𐴘𐴠.</char><verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />
    <char style="wj">”𐴃𐴡𐴥𐴘 𐴒𐴡𐴥𐴌𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴅𐴡𐴕𐴝𐴁𐴢, 𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴒𐴡𐴔 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴄𐴧𐴞𐴓𐴝 𐴊𐴠 𐴕𐴡𐴥 𐴕𐴠𐴥؟ 𐴃𐴡𐴥𐴘 𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴙𐴐𐴧𐴠𐴥؟‘</char><verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />
    <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴠𐴎𐴧𐴡𐴕 𐴊𐴟𐴐𐴧𐴡𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠.‘ 𐴒𐴡𐴗𐴀𐴌 𐴒𐴟𐴥𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴘 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴥𐴣𐴌𐴞 𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴝𐴔𐴁𐴡𐴘 𐴕𐴠𐴥؟‘</char><verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴕𐴡, 𐴕𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝 𐴇𐴝𐴥𐴣𐴌𐴞𐴁𐴝𐴐𐴧𐴡𐴃𐴢 𐴒𐴞𐴣𐴘𐴟 𐴘𐴡𐴥 𐴇𐴝𐴥𐴣𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴁𐴝.</char> <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" /><char style="wj">𐴊𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴙𐴕𐴊𐴝 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴊𐴟𐴕𐴞𐴥 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴝𐴌𐴞𐴥𐴃𐴡 𐴊𐴡; 𐴀𐴡𐴕𐴠 𐴊𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴙𐴕𐴊𐴝 𐴀𐴝𐴘𐴓𐴠𐴤 𐴀𐴝𐴀𐴛 𐴊𐴡𐴦𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴊𐴠, 𐴉𐴟𐴌𐴝𐴃𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴒𐴠 𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝 𐴒𐴟𐴥𐴕 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴃𐴝𐴌𐴝 𐴁𐴝𐴣𐴊𐴞𐴥𐴉𐴠𐴓𐴡; 𐴁𐴝𐴦𐴊𐴠 𐴒𐴞𐴣𐴘𐴟 𐴒𐴟𐴥𐴕 𐴀𐴝𐴣𐴀𐴌 𐴒𐴟𐴊𐴝𐴔𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴡𐴤.‘ “</char><verse eid="MAT 13:30" /></para>
  <para style="s1">𐴇𐴡𐴥𐴌𐴡𐴙𐴌 𐴊𐴝𐴕𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 4:30-32">𐴔𐴝𐴑 4‏:30‏-32</ref>; <ref loc="LUK 13:18-21">𐴓𐴟𐴑 13‏:18‏-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴇𐴡𐴥𐴌𐴡𐴙𐴌 𐴊𐴝𐴕𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴓𐴡𐴦𐴘𐴢 𐴕𐴞𐴎𐴡𐴌 𐴑𐴠𐴥𐴃𐴞𐴃𐴢 𐴓𐴝𐴒𐴝𐴘𐴠𐴥𐴒𐴡𐴘;</char> <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" /><char style="wj">𐴘𐴞𐴥𐴁𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴁𐴞𐴏𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴐𐴡𐴥𐴣𐴍𐴡 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴁𐴝𐴌𐴞𐴥 𐴀𐴟𐴍𐴞𐴤𐴓𐴠 𐴘𐴞𐴥𐴁𐴝 𐴑𐴠𐴥𐴃𐴞𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴏𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴝𐴏𐴢 𐴁𐴡𐴕𐴠, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴉𐴝𐴙𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴀𐴘𐴢 𐴘𐴞𐴥𐴁𐴝𐴌 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴁𐴝𐴇𐴝𐴤 𐴁𐴝𐴣𐴊𐴠𐴤.“</char><verse eid="MAT 13:32" /></para>
  <para style="s1">𐴐𐴟𐴥𐴄𐴝𐴌𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="LUK 13:20">𐴓𐴟𐴑 13‏:20</ref>‏,<ref loc="LUK 13:21">21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, <char style="wj">”𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴐𐴟𐴥𐴄𐴝𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴓𐴡𐴦𐴘𐴢 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴀𐴠𐴑𐴧𐴟𐴌𐴞 𐴃𐴞𐴕 𐴐𐴠𐴥𐴌 𐴀𐴝𐴄𐴝𐴃𐴢 𐴔𐴞𐴘𐴝𐴥𐴘𐴧𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴒𐴟𐴣𐴍𐴝 𐴈𐴝𐴛𐴡𐴌 𐴊𐴡𐴓𐴝 𐴉𐴟𐴥𐴓𐴞 𐴀𐴟𐴙𐴄𐴧𐴠𐴥.“</char><verse eid="MAT 13:33" /></para>
  <para style="s1">𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 4:33-34">𐴔𐴝𐴑 4‏:33‏-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴁𐴠 𐴈𐴡𐴘𐴧𐴠𐴥; 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴏𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴈𐴡𐴘𐴃𐴡𐴤. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />𐴎𐴠𐴀𐴕𐴠 𐴕𐴡𐴁𐴞𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥:</para>
  <para style="q1" vid="MAT 13:35">”𐴀𐴝𐴀𐴛 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴥 𐴀𐴝𐴣𐴀𐴌 𐴔𐴟𐴦 𐴑𐴟𐴥𐴓𐴞𐴘𐴟𐴔;</para>
  <para style="q2" vid="MAT 13:35">𐴀𐴝𐴀𐴛 𐴀𐴟𐴀𐴙𐴕 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔 𐴎𐴞𐴀𐴕 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤.“<note caller="+" style="f"><char style="fr" closed="false">13‏:35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 78:2">𐴎𐴡𐴁𐴟𐴌 78‏:2</ref></char></char></note><verse eid="MAT 13:35" /></para>
  <para style="s1">𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴌𐴞 𐴒𐴡𐴥𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴞𐴦𐴘𐴠𐴥. 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴝𐴕 𐴁𐴟𐴎𐴝𐴥𐴘𐴊𐴡.“<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴑𐴞 𐴒𐴡𐴔 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴄𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝.</char> <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" /><char style="wj">𐴎𐴡𐴁𐴞𐴕 𐴕𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘, 𐴒𐴡𐴔 𐴁𐴞𐴏𐴢 𐴏𐴟𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕, 𐴀𐴝𐴦𐴌 𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝 𐴒𐴟𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕,</char> <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" /><char style="wj">𐴎𐴠 𐴊𐴟𐴐𐴧𐴡𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴐𐴞𐴥𐴣𐴄𐴧𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴢, 𐴊𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴙𐴕𐴊𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴢, 𐴀𐴝𐴦𐴌 𐴊𐴡𐴦𐴘𐴝 𐴒𐴟𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢.</char><verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />
    <char style="wj">”𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝, 𐴑𐴠𐴥𐴌𐴑𐴟𐴣𐴍𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴟𐴌𐴝𐴃𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴠, 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴡𐴃𐴢 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" /><char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴝𐴁𐴝 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴟𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡,</char> <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴉𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴁𐴡; 𐴇𐴠𐴥𐴍𐴠 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴃𐴠 𐴊𐴝𐴃𐴢 𐴑𐴞𐴌𐴑𐴞𐴌𐴝𐴕𐴞 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴡𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴁𐴠𐴙𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴡𐴔𐴑𐴞𐴁𐴡𐴥. 𐴎𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴞𐴁𐴝𐴌 𐴈𐴝𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴥𐴕𐴡.</char><verse eid="MAT 13:43" /></para>
  <para style="s1">𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴝𐴥 𐴊𐴡𐴥𐴕𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />
    <char style="wj">”𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴝𐴥 𐴊𐴡𐴥𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴉𐴝𐴘 𐴀𐴝𐴁𐴝𐴌 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴎𐴝𐴘 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴠𐴏𐴞 𐴇𐴠𐴥 𐴎𐴡𐴁𐴞𐴕 𐴕𐴝𐴥𐴕 𐴑𐴞𐴕𐴧𐴠𐴥𐴒𐴡𐴘.</char><verse eid="MAT 13:44" /></para>
  <para style="s1">𐴔𐴟𐴑𐴃𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />
    <char style="wj">”𐴀𐴝𐴁𐴝𐴌, 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴐𐴡𐴥𐴊𐴡𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴝𐴥𐴄𐴞 𐴔𐴟𐴑𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤;</char> <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴞𐴐𐴞𐴤 𐴊𐴝𐴔𐴞 𐴔𐴟𐴑𐴃𐴝 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴎𐴝𐴘 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴠𐴏𐴞 𐴘𐴞𐴥𐴁𐴝 𐴑𐴞𐴕𐴧𐴠𐴥𐴒𐴡𐴘.</char><verse eid="MAT 13:46" /></para>
  <para style="s1">𐴄𐴝𐴕𐴝-𐴎𐴝𐴓𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />
    <char style="wj">”𐴀𐴝𐴁𐴝𐴌, 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴄𐴝𐴕𐴝-𐴎𐴝𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴁𐴟𐴖𐴝𐴥𐴘 𐴇𐴝𐴥𐴀𐴌 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴔𐴝𐴏𐴢 𐴊𐴡𐴥𐴙𐴅𐴧𐴠,</char> <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" /><char style="wj">𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴡𐴥𐴌𐴞𐴒𐴞𐴘𐴡𐴘 𐴌𐴝𐴥𐴌 𐴎𐴝𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴄𐴝𐴕𐴞 𐴏𐴡𐴌𐴡𐴃𐴢 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴡𐴀𐴘𐴢 𐴒𐴡𐴔 𐴔𐴟𐴥𐴕 𐴒𐴡𐴔 𐴔𐴟𐴥𐴕 𐴋𐴟𐴓𐴝𐴃𐴢 𐴁𐴡𐴥𐴙𐴅𐴧𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴉𐴟𐴕 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴉𐴟𐴕 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴠.</char> <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" /><char style="wj">𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴡𐴃𐴢 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡. 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴝𐴀𐴘𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴝𐴓𐴡𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡,</char> <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" /><char style="wj">𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴡𐴓𐴠𐴌 𐴊𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴉𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴁𐴡; 𐴇𐴠𐴥𐴍𐴠 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴃𐴠 𐴊𐴝𐴃𐴢 𐴑𐴞𐴌𐴑𐴞𐴌𐴝𐴕𐴞 𐴀𐴡𐴥𐴘𐴁𐴡.“</char><verse eid="MAT 13:50" /></para>
  <para style="s1">𐴕𐴡𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴌𐴝𐴕 𐴊𐴡𐴥𐴕</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴟𐴙𐴅𐴧𐴡𐴥 𐴕𐴠𐴥؟“</char></para>
  <para style="p" vid="MAT 13:51">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴟𐴙𐴅𐴧𐴞𐴥 𐴎𐴠.“<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴝𐴓𐴠𐴔 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴁𐴡𐴕𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴒𐴡𐴥𐴌𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴊𐴝𐴔𐴡𐴃𐴧𐴟 𐴕𐴡𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴌𐴝𐴕 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴠𐴦𐴓𐴝.“</char><verse eid="MAT 13:52" /></para>
  <para style="s1">𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌</para>
  <para style="r">(<ref loc="MRK 6:1-6">𐴔𐴝𐴑 6‏:1‏-6</ref>; <ref loc="LUK 4:16-30">𐴓𐴟𐴑 4‏:16‏-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴘𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴃𐴡𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴀𐴠𐴀𐴕 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴔𐴧𐴟𐴥𐴑𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴒𐴞𐴘𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴞 𐴈𐴝𐴔 𐴀𐴞𐴀𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴇𐴡𐴕𐴃𐴟𐴤 𐴉𐴝𐴘𐴧𐴠𐴥؟ <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />𐴀𐴞𐴁𐴝𐴤 𐴑𐴞𐴥 𐴔𐴞𐴏𐴃𐴞𐴥𐴌𐴞𐴌 𐴉𐴟𐴖𐴝 𐴕𐴡؟ 𐴀𐴞𐴁𐴝𐴤𐴌 𐴔𐴝𐴦 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴁𐴝 𐴕𐴡 𐴕𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴘𐴝𐴑𐴟𐴁𐴢, 𐴘𐴟𐴏𐴟𐴥𐴉𐴢, 𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴕𐴡 𐴕𐴠𐴥؟ <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />𐴀𐴞𐴁𐴝𐴤𐴌 𐴁𐴡𐴥𐴘𐴕𐴝𐴙𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟ 𐴃𐴡𐴥𐴘 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴇𐴡𐴕𐴃𐴟𐴤 𐴉𐴝𐴘𐴧𐴠𐴥؟“ <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</para>
  <para style="p" vid="MAT 13:57">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴁𐴞𐴌 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴃𐴡𐴥𐴕𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴁𐴝𐴊𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤.“</char><verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴝𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴠𐴥𐴍𐴠 𐴁𐴞𐴐𐴞𐴤 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴔𐴡𐴦𐴃𐴢</para>
  <para style="r">(<ref loc="MRK 6:14-29">𐴔𐴝𐴑 6‏:14‏-29</ref>; <ref loc="LUK 9:7-9">𐴓𐴟𐴑 9‏:7‏-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴒𐴝𐴓𐴞𐴓𐴢 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴎𐴞𐴌-𐴕𐴝𐴎𐴞𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝, 𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴞 𐴈𐴝𐴔 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠𐴌.“<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴠𐴥𐴌𐴟𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘 𐴉𐴞𐴓𐴞𐴥𐴂𐴡𐴌 𐴁𐴡𐴖𐴢 𐴈𐴠𐴥𐴌𐴟𐴊𐴞𐴀𐴝𐴏𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴇𐴠𐴥 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴣𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴞𐴥𐴓𐴢. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴃𐴡𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴝𐴘𐴠𐴏𐴢 𐴕𐴝𐴥𐴘.“ <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴃𐴡𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴖𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴃𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌𐴠 𐴕𐴡𐴁𐴞 𐴔𐴝𐴕𐴞𐴃𐴡𐴥.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌 𐴎𐴡𐴌𐴔𐴡-𐴊𐴞𐴕 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴈𐴠𐴥𐴌𐴟𐴊𐴞𐴀𐴝𐴏𐴡𐴌 𐴎𐴞𐴥𐴀𐴘𐴠 𐴔𐴝𐴀𐴉𐴞𐴓𐴡𐴃𐴢 𐴕𐴝𐴏𐴞 𐴈𐴠𐴥𐴌𐴟𐴊𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘 𐴖𐴝𐴦𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴞𐴀𐴕 𐴔𐴝𐴒𐴠 𐴇𐴞𐴥𐴀𐴕 𐴊𐴞𐴦𐴁𐴡 𐴈𐴡𐴀𐴘𐴢. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴦𐴘𐴠 𐴐𐴞𐴥𐴑𐴝𐴘𐴊𐴞𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴈𐴡𐴓𐴧𐴝 𐴖𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴃𐴝𐴥𐴓𐴞𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴦.“ <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴓𐴝𐴙𐴒𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴕𐴞𐴎𐴡𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴔𐴠𐴀𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴇𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴌𐴡𐴏𐴢 𐴏𐴝𐴥𐴕 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘, 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴈𐴡𐴓𐴧𐴝 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴝 𐴁𐴝𐴘𐴠𐴤. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴓𐴧𐴝 𐴖𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴃𐴝𐴥𐴓𐴞𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴕𐴞𐴤 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴦𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴓𐴝𐴐𐴧𐴗𐴝 𐴓𐴡𐴘𐴎𐴝𐴘 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠; 𐴁𐴝𐴦𐴊𐴠 𐴎𐴝𐴘 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥.<verse eid="MAT 14:12" /></para>
  <para style="s1">𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴁𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MRK 6:30-44">𐴔𐴝𐴑 6‏:30‏-44</ref>; <ref loc="LUK 9:10-17">𐴓𐴟𐴑 9‏:10‏-17</ref>; <ref loc="JHN 6:1-14">𐴘𐴡 6‏:1‏-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴈𐴠𐴥𐴕𐴃𐴟 𐴏𐴞𐴥𐴌𐴝 𐴀𐴡𐴥𐴘 𐴕𐴡𐴦𐴃𐴢 𐴒𐴡𐴌𐴞 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴡𐴐𐴡𐴥𐴃𐴞-𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴒𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴡𐴥𐴘. 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞, 𐴐𐴡𐴥𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴥𐴣𐴍𐴞-𐴀𐴝𐴥𐴣𐴍𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴕𐴡𐴦𐴃𐴧𐴟 𐴓𐴝𐴙𐴔𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴠𐴙𐴑𐴧𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴉𐴠𐴄𐴉𐴟𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴝𐴀𐴕 𐴃𐴡 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴡𐴐𐴡𐴥𐴃𐴞-𐴏𐴝𐴥𐴌𐴝 𐴎𐴝𐴒𐴝, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴙𐴓𐴢 𐴀𐴡𐴥 𐴒𐴞𐴘𐴡𐴥𐴘. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴝𐴌𐴝𐴥 𐴉𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴎𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴈𐴝𐴥𐴕𐴝 𐴑𐴞𐴕𐴞𐴒𐴡𐴥𐴘 𐴉𐴝𐴌𐴠.“<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴝𐴌𐴝𐴥𐴃𐴧𐴟 𐴎𐴝𐴦𐴒𐴡𐴥𐴘 𐴕𐴡 𐴉𐴡𐴌𐴞𐴁𐴡𐴥; 𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴡𐴦.“</char><verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴍𐴠𐴥 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴌𐴟𐴄𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝𐴥 𐴔𐴝𐴏𐴢 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘.“<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴕𐴡𐴤𐴒𐴡𐴘.“</char> <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴑𐴠𐴥𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴃𐴡𐴥 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴌𐴟𐴄𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝𐴥 𐴔𐴝𐴏𐴢 𐴏𐴟𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴌𐴟𐴄𐴞 𐴒𐴟𐴥𐴕 𐴁𐴝𐴥𐴚𐴒𐴞-𐴁𐴝𐴥𐴚𐴒𐴞 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴝𐴍𐴞𐴊𐴞𐴘𐴠𐴥. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />𐴃𐴝𐴌𐴝𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴞 𐴈𐴝𐴥𐴘𐴧𐴠. 𐴁𐴝𐴦𐴊𐴠 𐴎𐴠 𐴃𐴟𐴑𐴟𐴍𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴏𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴉𐴠𐴣𐴍𐴝𐴘 𐴓𐴡𐴦𐴘𐴢 𐴉𐴟𐴌𐴝 𐴁𐴝𐴌𐴡𐴥 𐴁𐴝𐴥𐴙𐴌 𐴁𐴡𐴥𐴙𐴅𐴧𐴠. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />𐴈𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴀𐴝𐴙𐴕 𐴁𐴝𐴊𐴢 𐴊𐴞 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴠𐴍𐴝𐴀𐴙𐴕.<verse eid="MAT 14:21" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴉𐴝𐴕𐴞𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴥𐴣𐴙𐴄𐴧𐴠</para>
  <para style="r">(<ref loc="MRK 6:45-52">𐴔𐴝𐴑 6‏:45‏-52</ref>; <ref loc="JHN 6:15-21">𐴘𐴡 6‏:15‏-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴔𐴡𐴅𐴁𐴟𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴞𐴊𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴊𐴞𐴃𐴠-𐴊𐴞𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴀𐴕𐴠 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴋𐴞𐴀𐴌 𐴀𐴡𐴑𐴟𐴓𐴠 𐴎𐴝𐴦𐴒𐴡𐴥𐴘. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴞𐴊𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴊𐴞 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴑𐴠𐴥𐴓𐴝 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴟𐴙𐴄𐴧𐴡𐴥𐴘. 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴠𐴥𐴣𐴃𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴇𐴠𐴥𐴍𐴠 𐴇𐴝𐴥𐴓𐴞𐴒𐴝, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡𐴦 𐴒𐴝𐴥𐴕 𐴑𐴟𐴓𐴡𐴃𐴧𐴟 𐴁𐴡𐴀𐴗𐴃𐴢 𐴊𐴟𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴘𐴧𐴝𐴌 𐴀𐴟𐴎𐴝𐴕 𐴁𐴝𐴀𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴠𐴥𐴙𐴚𐴧𐴠 𐴀𐴠𐴥𐴣𐴏𐴑𐴝𐴌.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />𐴉𐴟𐴀𐴝𐴥𐴣𐴙𐴃𐴧𐴝, 𐴀𐴞𐴏𐴝𐴤 𐴉𐴝𐴕𐴞𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴥𐴣𐴍𐴞-𐴀𐴝𐴥𐴣𐴍𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />𐴀𐴞𐴥𐴁𐴝 𐴉𐴝𐴕𐴞𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴥𐴣𐴍𐴠𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴊𐴠𐴑𐴞𐴥 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴁𐴟𐴥𐴃𐴢!“ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴦𐴌𐴠 𐴒𐴟𐴎𐴡𐴌𐴝𐴕 𐴔𐴝𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤! 𐴀𐴞𐴁𐴝𐴤 𐴀𐴝𐴀𐴛; 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥.“</char><verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />𐴎𐴟𐴖𐴝𐴁𐴠 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴝𐴕𐴞𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴃𐴡𐴤 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴡𐴥.“<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴘.“</char> 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴃𐴡𐴌 𐴕𐴡𐴦𐴃𐴧𐴟 𐴓𐴝𐴔𐴞, 𐴉𐴝𐴕𐴞𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴥𐴣𐴍𐴞-𐴀𐴝𐴥𐴣𐴍𐴞 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴎𐴝𐴦𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴠𐴎𐴢 𐴁𐴡𐴘𐴧𐴝𐴌 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴋𐴟𐴉𐴞𐴥𐴎𐴝𐴌𐴒𐴡𐴘 𐴌𐴝𐴥𐴌 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴝𐴏𐴡!“<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴁𐴝𐴌𐴝𐴤𐴘 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴈𐴡𐴔 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴀𐴡𐴓𐴝, 𐴐𐴡𐴥𐴀𐴑 𐴑𐴞𐴘𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴡𐴥𐴏؟“</char><verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥𐴒𐴝𐴘, 𐴁𐴡𐴘𐴧𐴝𐴌 𐴃𐴝𐴥𐴔𐴝𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴡𐴦𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, ”𐴁𐴠𐴐𐴡𐴥𐴑, 𐴃𐴟𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝.“<verse eid="MAT 14:33" /></para>
  <para style="s1">𐴒𐴠𐴕𐴠𐴏𐴝𐴥𐴌𐴠𐴃𐴡𐴃𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 6:53-56">𐴔𐴝𐴑 6‏:53‏-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴞𐴀 𐴉𐴝𐴌𐴝𐴤𐴘, 𐴒𐴠𐴕𐴠𐴏𐴝𐴥𐴌𐴠𐴃𐴢 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴏𐴞𐴕𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴑𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝𐴃𐴢 𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴡𐴀𐴣𐴏𐴝𐴘, 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤; <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴊𐴠, 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴐𐴝𐴥𐴑𐴡𐴌 𐴇𐴝𐴣𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴠 𐴏𐴟𐴥𐴘𐴃𐴡 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴡𐴥 𐴎𐴡𐴕𐴠 𐴏𐴟𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴌𐴡𐴏𐴡𐴥𐴔</para>
  <para style="r">(<ref loc="MRK 7:1-13">𐴔𐴝𐴑 7‏:1‏-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴧𐴟 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴀𐴝𐴓𐴠𐴔 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞, 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴒𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴌𐴡𐴏𐴡𐴥𐴔 𐴑𐴞𐴘𐴝𐴥 𐴁𐴝𐴥𐴚𐴒𐴠؟ 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴡𐴃𐴧𐴟 𐴀𐴝𐴥𐴃𐴢 𐴕𐴡 𐴊𐴟𐴥𐴖𐴠.“<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴑𐴞𐴘𐴝𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴌𐴡𐴏𐴡𐴥𐴔𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴁𐴝𐴥𐴚𐴒𐴡؟</char> <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" /><char style="wj">𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥, ’𐴁𐴝𐴉𐴔𐴝𐴦𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝‘ </char><note caller="+" style="f"><char style="fr" closed="false">15‏:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 20‏:12</ref></char>; <char style="xt"><ref loc="DEU 5:16">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 5‏:16</ref></char></char></note> <char style="wj">𐴀𐴝𐴦𐴌 ’𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴝𐴉𐴡𐴌 𐴘𐴝𐴥 𐴔𐴝𐴦𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.‘</char><note caller="+" style="f"><char style="fr" closed="false">15‏:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:17">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 21‏:17</ref></char>; <char style="xt"><ref loc="LEV 20:9">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 20‏:9</ref></char></char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴀 𐴊𐴠, ’𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴝𐴉𐴡𐴌𐴠 𐴘𐴝𐴥 𐴔𐴝𐴦𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀, ”𐴎𐴠 𐴏𐴞𐴎𐴢 𐴓𐴡𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴓𐴝𐴉𐴢 𐴉𐴝𐴘𐴃𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠,“</char> <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" /><char style="wj">𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴁𐴝𐴉𐴡𐴌𐴠 𐴘𐴝𐴥 𐴔𐴝𐴦𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌 𐴕𐴝𐴥𐴘.‘ 𐴇𐴠𐴥𐴀𐴕 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴌𐴡𐴏𐴡𐴥𐴔𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔𐴡𐴌𐴠 𐴁𐴝𐴦𐴃𐴠𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴡.</char> <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" /><char style="wj">𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴕𐴡𐴁𐴞 𐴘𐴠𐴏𐴝𐴥𐴘𐴝𐴘𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥,</char><verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />
    <char style="wj">’𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴑𐴠𐴥 𐴁𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥,</char></para>
  <para style="q2" vid="MAT 15:8">
    <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴝𐴌𐴝𐴥𐴌 𐴊𐴞𐴓𐴢 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥. </char><verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />
    <char style="wj">𐴃𐴝𐴌𐴝𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴊𐴠 𐴁𐴠𐴇𐴝𐴌;</char></para>
  <para style="q2" vid="MAT 15:9">
    <char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴝𐴌𐴝𐴥 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴐𐴞𐴥𐴑𐴝 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴕𐴞𐴘𐴡𐴔-𐴑𐴝𐴦𐴕𐴟𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢.‘ “</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">15‏:9 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 29:13">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 29‏:13</ref>
        </char>
      </char>
    </note><verse eid="MAT 15:9" /></para>
  <para style="s1">𐴎𐴞𐴀𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 7:14-23">𐴔𐴝𐴑 7‏:14‏-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴝𐴃𐴝𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴟𐴥𐴕𐴡 𐴀𐴝𐴦𐴌 𐴁𐴟𐴎𐴡𐴥.</char> <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" /><char style="wj">𐴒𐴝𐴓𐴡𐴃𐴢 𐴎𐴞𐴀𐴕 𐴒𐴡𐴥𐴓𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴁𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥.“</char><verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴇𐴡𐴘 𐴉𐴝𐴌𐴡 𐴕𐴠𐴥, 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴠𐴎𐴝𐴌 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠𐴥؟“<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠 𐴏𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴠 𐴓𐴝𐴒𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴝𐴥𐴣𐴌𐴞𐴉𐴠𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴠𐴥𐴓𐴝𐴘 𐴀𐴠𐴌𐴡. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴣𐴊𐴝𐴤 𐴉𐴡𐴣𐴃𐴢 𐴊𐴝𐴈𐴡𐴥𐴘𐴝; 𐴎𐴡𐴊𐴞 𐴀𐴠𐴑 𐴀𐴝𐴣𐴊𐴝𐴤𐴘𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴀𐴝𐴣𐴊𐴝𐴤𐴌𐴠 𐴉𐴡𐴣𐴃𐴢 𐴊𐴝𐴈𐴝𐴤, 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴃𐴡 𐴒𐴝𐴣𐴃𐴡𐴃𐴢 𐴉𐴡𐴌𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘.“</char><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴟𐴎𐴝𐴥𐴘𐴊𐴡.“<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴡𐴁𐴟𐴎𐴢 𐴃𐴝𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘 𐴊𐴠𐴥؟</char> <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴕𐴡 𐴁𐴟𐴎𐴡𐴥, 𐴎𐴞𐴀𐴕 𐴒𐴝𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴠 𐴇𐴞𐴥𐴀𐴕 𐴎𐴝𐴦 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴠𐴍𐴡𐴃𐴢, 𐴀𐴝𐴦𐴌 𐴉𐴠𐴘𐴑𐴝𐴥𐴕𐴝𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴎𐴝𐴒𐴡𐴥𐴘 𐴊𐴠𐴥؟</char> <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴞𐴀𐴕 𐴒𐴝𐴓𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴞𐴓𐴢 𐴀𐴡𐴃𐴧𐴟, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴁𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴞𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴥𐴕𐴝 𐴑𐴟𐴑𐴞𐴥𐴘𐴝𐴓𐴢, 𐴑𐴡𐴃𐴡𐴥𐴓𐴝𐴑𐴡𐴃𐴡𐴥𐴓𐴞, 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞, 𐴏𐴟𐴌𐴞, 𐴔𐴞𐴏𐴝𐴥 𐴒𐴡𐴁𐴝𐴤, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴞𐴉𐴡𐴃𐴢 𐴀𐴝𐴘𐴧𐴠𐴤.</char> <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" /><char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴁𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴊𐴟𐴥𐴘𐴧𐴝 𐴀𐴝𐴥𐴃𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴓𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴕𐴡.“</char><verse eid="MAT 15:20" /></para>
  <para style="s1">𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴀𐴞𐴔𐴝𐴕</para>
  <para style="r">(<ref loc="MRK 7:24-30">𐴔𐴝𐴑 7‏:24‏-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝 𐴉𐴠𐴥𐴓𐴝𐴘, 𐴄𐴝𐴘𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴥𐴊𐴡𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />𐴇𐴠𐴥 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴑𐴝𐴥𐴕𐴝𐴕𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤! 𐴀𐴝𐴣𐴀𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝 𐴁𐴟𐴥𐴃𐴠 𐴉𐴝𐴘 𐴁𐴞𐴐𐴞𐴤 𐴊𐴟𐴑 𐴉𐴝𐴌.“<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴖𐴝𐴁𐴢 𐴕𐴡𐴥 𐴊𐴠. 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴊𐴟𐴣𐴌𐴝𐴘 𐴊𐴞𐴉𐴠𐴥𐴓𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴁𐴝𐴤 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴒𐴟𐴎𐴡𐴌𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.“<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴑𐴡𐴗𐴔𐴡𐴌 𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.“</char><verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴏𐴡𐴥𐴘𐴊𐴝 𐴉𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤!“<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴓𐴡𐴦𐴘𐴢 𐴑𐴟𐴣𐴙𐴌𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴉𐴠𐴥𐴓𐴝𐴘 𐴊𐴡𐴥𐴕 𐴒𐴡𐴔 𐴕𐴡.“</char><verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥𐴘, 𐴔𐴝𐴓𐴞𐴑, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴊𐴠 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴔𐴠𐴏𐴡𐴃𐴧𐴟 𐴉𐴡𐴌𐴞𐴎𐴝𐴒𐴡𐴥𐴘 𐴊𐴠 𐴃𐴟𐴑𐴟𐴍𐴝 𐴇𐴞𐴥𐴀𐴕 𐴑𐴟𐴣𐴘𐴌𐴠 𐴈𐴝𐴥𐴀.“<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴞𐴔𐴝𐴕 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴣𐴀𐴌! 𐴃𐴟𐴀𐴛 𐴎𐴞𐴘𐴝𐴥𐴕 𐴏𐴡𐴀𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴥𐴘𐴁𐴡.“</char> 𐴃𐴡𐴥𐴘 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝 𐴖𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MAT 15:28" /></para>
  <para style="s1">𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴈𐴠𐴥𐴕𐴃𐴟 𐴁𐴝𐴐𐴝𐴥 𐴓𐴡𐴥𐴘, 𐴒𐴝𐴓𐴞𐴓𐴢 𐴋𐴞𐴀 𐴁𐴝𐴥𐴘 𐴎𐴝𐴘 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴟𐴍𐴞𐴤 𐴁𐴡𐴙𐴐𐴧𐴠𐴥𐴒𐴡𐴘. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴠𐴚, 𐴀𐴝𐴣𐴊𐴝𐴤, 𐴔𐴝𐴎𐴟𐴌, 𐴁𐴟𐴑, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌𐴡𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴕𐴞𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴒𐴟𐴌𐴝𐴃𐴢 𐴀𐴠𐴙𐴅𐴧𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, 𐴔𐴝𐴎𐴟𐴌 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴓𐴠𐴚𐴠 𐴀𐴝𐴥𐴣𐴍𐴠𐴌 𐴊𐴠, 𐴀𐴝𐴣𐴊𐴝𐴤𐴘𐴠 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="MAT 15:31" /></para>
  <para style="s1">𐴏𐴝𐴙𐴌 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴁𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MRK 8:1-10">𐴔𐴝𐴑 8‏:1‏-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴉𐴠𐴄𐴉𐴟𐴌𐴠𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴃𐴞𐴕 𐴊𐴞𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴝𐴦𐴌 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴈𐴝𐴥𐴘𐴃𐴡 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘. 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴖𐴝𐴀𐴐𐴧𐴝 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞𐴃𐴡 𐴔𐴡𐴕𐴠 𐴕𐴡 𐴈𐴡𐴀𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴔𐴝𐴃𐴝𐴥 𐴒𐴟𐴥𐴌𐴝𐴘 𐴉𐴡𐴌𐴞 𐴕𐴡 𐴎𐴝𐴒𐴡𐴥𐴘.“</char><verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴀𐴠𐴃𐴧𐴡𐴥𐴌 𐴋𐴡𐴣𐴀𐴌 𐴊𐴡𐴓𐴡𐴌𐴠 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴞 𐴈𐴝𐴥𐴁𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠 𐴁𐴡𐴐𐴡𐴥𐴃𐴞-𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴇𐴠𐴥𐴊𐴟𐴕 𐴌𐴟𐴄𐴞 𐴇𐴡𐴍𐴠𐴥 𐴉𐴝𐴘𐴧𐴟𐴔؟“<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴌𐴟𐴄𐴞 𐴈𐴡𐴖𐴝𐴤 𐴀𐴝𐴏𐴠𐴤؟“</char></para>
  <para style="p" vid="MAT 15:34">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴌𐴝 𐴔𐴝𐴏𐴢.“<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴠𐴍𐴞𐴃𐴢 𐴁𐴡𐴘𐴃𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥; <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴠𐴥 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴌𐴟𐴄𐴞 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴏𐴢 𐴏𐴟𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴥𐴚𐴒𐴞 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴉𐴠𐴄𐴢 𐴁𐴡𐴥𐴌𐴞 𐴈𐴝𐴥𐴘𐴧𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴎𐴠 𐴃𐴟𐴑𐴟𐴍𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴏𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴁𐴡𐴥𐴙𐴅𐴧𐴠 𐴌𐴝𐴥𐴌 𐴓𐴝𐴘 𐴓𐴡𐴘 𐴇𐴝𐴥𐴣𐴃𐴢 𐴓𐴝𐴘 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴈𐴝𐴥𐴘𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴙𐴌 𐴀𐴝𐴥𐴎𐴝𐴌 𐴁𐴠𐴍𐴝𐴀𐴙𐴕، 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴀𐴝𐴙𐴕 𐴁𐴝𐴊𐴢 𐴊𐴞. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴓𐴗𐴝𐴥𐴌𐴠 𐴁𐴞𐴊𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴊𐴞 𐴁𐴝𐴦𐴊𐴠, 𐴕𐴡𐴦𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴔𐴝𐴒𐴝𐴥𐴊𐴝𐴕 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕𐴡𐴌 𐴊𐴝𐴁𐴞</para>
  <para style="r">(<ref loc="MRK 8:11-13">𐴔𐴝𐴑 8‏:11‏-13</ref>; <ref loc="LUK 12:54-56">𐴓𐴟𐴑 12‏:54‏-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴈𐴝𐴤𐴘𐴃𐴡.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴀 𐴊𐴠, ’𐴔𐴡𐴀𐴏𐴟𐴔 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕 𐴓𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠.‘</char> <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" /><char style="wj">𐴀𐴝𐴦𐴌 𐴁𐴞𐴀𐴕𐴧𐴝 𐴈𐴡𐴀 𐴊𐴠, ’𐴀𐴝𐴙𐴅𐴧𐴝 𐴃𐴟𐴖𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕 𐴓𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴁𐴧𐴝𐴌 𐴀𐴡𐴥𐴘𐴧𐴠.‘ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴏𐴝𐴀𐴘𐴢 𐴔𐴡𐴀𐴏𐴟𐴔 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴎𐴝𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴀𐴝𐴓𐴝𐴔𐴡𐴃𐴡𐴌𐴠 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴡𐴀𐴌 𐴊𐴠𐴥؟</char> <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" /><char style="wj">𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴕𐴞𐴐𐴝𐴥𐴕 𐴃𐴟𐴖𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴡𐴁𐴞 𐴘𐴟𐴕𐴟𐴏𐴡𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴞𐴘𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.“</char> 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴌𐴞, 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="MAT 16:4" /></para>
  <para style="s1">𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴟𐴥𐴄𐴝𐴌</para>
  <para style="r">(<ref loc="MRK 8:14-21">𐴔𐴝𐴑 8‏:14‏-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />𐴀𐴝𐴦𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴋𐴞𐴀𐴌 𐴀𐴡𐴑𐴟𐴓𐴠 𐴎𐴝𐴘𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢, 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴌𐴟𐴄𐴞 𐴓𐴡𐴘𐴎𐴝𐴘𐴃𐴡𐴥 𐴉𐴡𐴀𐴌𐴝𐴘𐴒𐴞𐴓𐴒𐴡𐴘. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴡𐴥𐴁𐴡𐴌𐴡𐴊𐴧𐴝𐴌, 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴟𐴥𐴄𐴝𐴌𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡.“</char><verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴈𐴡𐴖𐴝𐴤𐴇𐴡𐴘 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴟𐴄𐴞 𐴕𐴟𐴥 𐴀𐴝𐴕𐴞𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝.“<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴈𐴡𐴔 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢! 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴌𐴟𐴄𐴞 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴘𐴝𐴥 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴈𐴡𐴖𐴝𐴤𐴇𐴡𐴘 𐴒𐴡𐴌𐴡𐴤𐴌؟</char> <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴕𐴡𐴥 𐴁𐴟𐴎𐴡𐴥 𐴕𐴞𐴥𐴑𐴞؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴕𐴡𐴃𐴢 𐴕𐴝𐴥𐴘 𐴕𐴠𐴥, 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴌𐴟𐴄𐴞 𐴓𐴡𐴘 𐴈𐴝𐴥𐴁𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡 𐴁𐴝𐴥𐴙𐴌 𐴁𐴡𐴥𐴌𐴞 𐴓𐴡𐴀𐴘𐴓𐴝؟</char> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴏𐴝𐴙𐴌 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴇𐴝𐴥𐴣𐴃𐴧𐴗𐴝 𐴌𐴟𐴄𐴞 𐴓𐴡𐴘 𐴈𐴝𐴥𐴁𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡 𐴓𐴝𐴘 𐴁𐴡𐴥𐴌𐴞 𐴓𐴡𐴀𐴘𐴓𐴝؟</char> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴌𐴟𐴄𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴕𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡 𐴑𐴞𐴘𐴝𐴥 𐴁𐴟𐴎𐴡𐴥𐴌؟ 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴟𐴥𐴄𐴝𐴌𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡.“</char> <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴌𐴟𐴄𐴞𐴌 𐴐𐴟𐴥𐴄𐴝𐴌𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴃𐴧𐴟.<verse eid="MAT 16:12" /></para>
  <para style="s1">𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 8:27-30">𐴔𐴝𐴑 8‏:27‏-30</ref>; <ref loc="LUK 9:18-21">𐴓𐴟𐴑 9‏:18‏-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴑𐴝𐴘𐴏𐴝𐴥𐴌𐴞𐴘𐴝 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴞 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴇𐴡𐴕 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀؟“</char><verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ”𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀 𐴊𐴠 𐴃𐴟𐴀𐴛 𐴁𐴡𐴥𐴓𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝; 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀 𐴊𐴠, 𐴕𐴡𐴁𐴞 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢; 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴈𐴡𐴀 𐴊𐴠, 𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝 𐴘𐴝𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴒𐴧𐴗𐴝𐴤.“<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴈𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕؟“</char><verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />𐴏𐴝𐴥𐴘𐴔𐴡𐴕 𐴉𐴞𐴃𐴡𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴇𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤, 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝.“<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴟𐴕𐴟𐴏𐴡𐴌 𐴉𐴟𐴖𐴝 𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴃𐴟𐴘 𐴔𐴟𐴁𐴝𐴌𐴠𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴡𐴌𐴠𐴥 𐴘𐴝𐴀𐴕 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠.</char> <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" /><char style="wj">𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡𐴌𐴠𐴥 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴘 𐴀𐴡𐴥𐴘𐴓𐴞𐴊𐴠 𐴉𐴞𐴃𐴡𐴌,</char><note caller="+" style="f"><char style="fr" closed="false">16‏:18 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 </char><char style="fq" closed="false">𐴉𐴞𐴃𐴡𐴌 </char><char style="ft" closed="false">𐴔𐴝𐴀𐴕𐴞 𐴉𐴝𐴃𐴧𐴡𐴥𐴌</char></note> <char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴀𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴁𐴝𐴕𐴝𐴘𐴧𐴟𐴥𐴔; 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴔𐴡𐴦𐴃𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡 𐴎𐴞𐴃𐴞𐴁𐴡𐴥.</char> <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴏𐴝𐴁𐴞𐴤 𐴊𐴞𐴦𐴘𐴟𐴔; 𐴃𐴟𐴘 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴞𐴀𐴕 𐴁𐴝𐴣𐴊𐴞𐴥𐴁𐴞 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴡𐴥 𐴁𐴝𐴣𐴊𐴝𐴤 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴞𐴀𐴕 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞𐴁𐴞 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴡𐴥 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.“</char> <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴕𐴞𐴐𐴡𐴥𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴃𐴡𐴤.<verse eid="MAT 16:20" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴦𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">𐴔𐴝𐴑 8‏:31‏—9‏:1</ref>; <ref loc="LUK 9:22-27">𐴓𐴟𐴑 9‏:22‏-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴦 𐴉𐴡𐴌𐴞𐴁𐴡𐴥; 𐴀𐴝𐴦𐴌 𐴔𐴟𐴌𐴟𐴁𐴧𐴞, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴟𐴑 𐴉𐴝𐴦 𐴉𐴡𐴌𐴞𐴁𐴡𐴥; 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴞𐴕𐴝𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘 𐴁𐴟𐴎𐴝𐴥𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴟𐴌 𐴀𐴡𐴥𐴗𐴑. 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴖𐴡𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴀𐴡𐴥𐴑.“<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴉𐴞𐴥𐴌𐴞 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴐𐴡𐴥𐴘𐴃𐴝𐴕, 𐴀𐴝𐴣𐴀𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴊𐴟𐴌 𐴀𐴡𐴥! 𐴃𐴟𐴘 𐴀𐴡𐴥𐴘𐴓𐴞𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴀𐴡𐴣𐴏𐴝𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴡𐴌 𐴊𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴀𐴟𐴎𐴟.“</char><verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴝𐴘𐴃𐴡𐴤 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴢 𐴁𐴡𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥 𐴏𐴝𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" /><char style="wj">𐴑𐴞𐴦 𐴓𐴝𐴉𐴢, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴉𐴝𐴦, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴕𐴝𐴥𐴕 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴠؟ 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴑𐴞𐴦 𐴊𐴞𐴦 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤؟</char> <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴎𐴡𐴕𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴁𐴡𐴊𐴡𐴓𐴝 𐴊𐴞𐴦𐴁𐴡.</char><verse eid="MAT 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 16:28" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠𐴍𐴠𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴕𐴡𐴥 𐴊𐴠𐴑𐴞𐴥𐴃𐴠 𐴕𐴡 𐴔𐴡𐴌𐴞𐴁𐴡𐴥.“</char><verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴁𐴡𐴊𐴡𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘</para>
  <para style="r">(<ref loc="MRK 9:2-13">𐴔𐴝𐴑 9‏:2‏-13</ref>; <ref loc="LUK 9:28-36">𐴓𐴟𐴑 9‏:28‏-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />𐴏𐴡𐴥 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴉𐴞𐴃𐴡𐴌 𐴀𐴡𐴌𐴠, 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴡𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴥𐴘 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌𐴠 𐴓𐴡𐴦𐴘𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴁𐴡𐴊𐴡𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝 𐴁𐴠𐴙𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴡𐴓𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌 𐴕𐴟𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴟𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴔𐴟𐴀𐴏𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴏𐴞𐴤. 𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴀𐴠𐴍𐴠𐴥 𐴃𐴞𐴕 𐴕𐴝𐴥𐴕 𐴄𐴝𐴔𐴁𐴟 𐴄𐴝𐴑𐴞𐴘𐴟𐴥𐴔: 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝, 𐴀𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴟𐴀𐴏𐴝𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴡𐴓𐴧𐴝.“<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴟𐴌𐴝𐴕𐴞 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴃𐴧𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴖𐴝, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞. 𐴀𐴞𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴡!“<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴔𐴠𐴍𐴞𐴃𐴢 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴟𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴟𐴍𐴡𐴥, 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥.“</char> <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴟𐴑 𐴃𐴟𐴓𐴞𐴤 𐴏𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡𐴥 𐴊𐴠𐴑𐴠𐴥.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴝𐴀𐴌𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴘𐴝𐴥𐴕 𐴊𐴠𐴙𐴑𐴧𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴧𐴡𐴥.“</char><verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴑𐴞𐴘𐴝𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀, 𐴀𐴝𐴒𐴠 𐴕𐴡𐴁𐴞 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴝𐴀𐴌 𐴎𐴡𐴌𐴟𐴌؟“<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴝𐴒𐴠 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴝𐴘𐴁𐴡𐴤 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴙𐴃𐴧𐴡 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴁𐴡.</char> <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. 𐴓𐴠𐴑𐴞𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡𐴥 𐴏𐴞𐴕𐴠𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴀𐴕 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴧𐴠𐴥 𐴇𐴠𐴥𐴀𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴟𐴑 𐴉𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤.“</char> <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴟𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴊𐴡𐴘𐴝 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠.<verse eid="MAT 17:13" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴟𐴥𐴃𐴠-𐴉𐴝𐴘𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴟𐴖𐴝 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 9:14-29">𐴔𐴝𐴑 9‏:14‏-29</ref>; <ref loc="LUK 9:37-43">𐴓𐴟𐴑 9‏:37‏-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴣𐴍𐴟𐴥 𐴉𐴠𐴥𐴓𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴏𐴟𐴥𐴖𐴝𐴣𐴉𐴞𐴥𐴌𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴁𐴞𐴐𐴞𐴤 𐴊𐴟𐴑 𐴉𐴝𐴦𐴌; 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴒𐴝𐴎𐴝𐴥 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥𐴃𐴢 𐴉𐴡𐴌𐴠. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴕𐴧𐴞𐴤𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠.“<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴀𐴞𐴔𐴝𐴕 𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴀𐴣𐴌𐴝 𐴕𐴡𐴏𐴡𐴥𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴝𐴔؟ 𐴇𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟ 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴕𐴡𐴤.“</char> <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴟𐴥𐴃𐴧𐴗𐴝𐴌𐴠 𐴊𐴡𐴥𐴔𐴑𐴞𐴊𐴞𐴘𐴠 𐴌𐴝𐴥𐴌, 𐴘𐴞𐴥𐴁𐴝 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴘𐴝𐴥 𐴕𐴠𐴦𐴓𐴝𐴘 𐴕𐴡𐴥 𐴉𐴝𐴌𐴞؟“<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴈𐴡𐴔𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴥𐴌𐴡𐴙𐴌 𐴊𐴝𐴕𐴝𐴌 𐴇𐴠𐴥𐴃𐴧𐴞𐴌𐴞𐴕 𐴀𐴞𐴔𐴝𐴕 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴉𐴝𐴀𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴉𐴝𐴌𐴞𐴁𐴝𐴥, ’𐴀𐴠𐴕𐴃𐴟𐴥 𐴓𐴡𐴌𐴞 𐴀𐴟𐴍𐴠𐴤 𐴎𐴝𐴦𐴒𐴡𐴥𐴘,‘ 𐴃𐴡𐴥𐴘 𐴘𐴞𐴥𐴁𐴝 𐴓𐴡𐴌𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥 𐴊𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.</char> <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴊𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴌𐴟𐴎𐴝 𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴟𐴥𐴕 𐴕𐴠𐴦𐴓𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.“</char><verse eid="MAT 17:21" /></para>
  <para style="s1">𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴦𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴈𐴡𐴘𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 9:30-32">𐴔𐴝𐴑 9‏:30‏-32</ref>; <ref loc="LUK 9:43-45">𐴓𐴟𐴑 9‏:43‏-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡;</char> <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.“</char> 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴓𐴝𐴙𐴒𐴧𐴞𐴥𐴓𐴢.<verse eid="MAT 17:23" /></para>
  <para style="s1">𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴇𐴝𐴥𐴎𐴝𐴕𐴝</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />𐴀𐴞𐴏𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴑𐴝𐴂𐴝𐴌𐴕𐴝𐴈𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴞 𐴁𐴝𐴦𐴊𐴠, 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴟𐴏𐴃𐴝𐴃𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴕𐴡 𐴊𐴠𐴦 𐴕𐴞𐴥𐴑𐴞؟“<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴠𐴐𐴡𐴥𐴑, 𐴊𐴠𐴦.“ 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴞𐴃𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴀𐴝𐴒𐴡𐴃𐴧𐴟 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴝𐴥𐴘𐴔𐴡𐴕, 𐴃𐴟𐴘 𐴑𐴞𐴦 𐴁𐴝𐴥𐴉𐴡𐴏؟ 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴘𐴝𐴥 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴇𐴝𐴌𐴃𐴧𐴟 𐴃𐴟𐴓𐴠𐴥, 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴁𐴝𐴀𐴌𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴃𐴧𐴟؟“</char><verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴝𐴀𐴌𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴃𐴧𐴟.“</para>
  <para style="p" vid="MAT 17:26">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴏𐴞𐴒𐴞𐴘𐴡𐴥𐴘.</char> <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴠𐴎𐴝𐴌 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴥𐴕, 𐴋𐴞𐴀𐴃𐴢 𐴎𐴝𐴘 𐴁𐴡𐴌𐴑𐴞𐴥 𐴁𐴝𐴀𐴒𐴡𐴘. 𐴎𐴠 𐴔𐴝𐴏𐴢 𐴀𐴝𐴒𐴠 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴓𐴡𐴘𐴁𐴞; 𐴀𐴝𐴦𐴌 𐴘𐴞𐴥𐴁𐴝𐴌 𐴒𐴝𐴓𐴢 𐴑𐴟𐴥𐴓𐴞𐴓𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴟𐴉𐴝𐴌 𐴉𐴡𐴘𐴐𐴝𐴤 𐴉𐴝𐴘𐴁𐴞 𐴎𐴞𐴘𐴝𐴥𐴕 𐴑𐴝𐴉𐴞𐴥 𐴀𐴡𐴥𐴘𐴁𐴡. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌 𐴓𐴧𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴊𐴞𐴐𐴢.“</char><verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴕𐴧𐴗𐴝𐴤؟</para>
  <para style="r">(<ref loc="MRK 9:33-37">𐴔𐴝𐴑 9‏:33‏-37</ref>; <ref loc="LUK 9:46-48">𐴓𐴟𐴑 9‏:46‏-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴕𐴧𐴗𐴝𐴤؟“<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴟𐴌𐴝 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴝𐴃𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴝𐴎𐴠𐴥 𐴃𐴞𐴥𐴘𐴝𐴒𐴝𐴌𐴝𐴘𐴧𐴠, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴡𐴊𐴡𐴓𐴞 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡 𐴁𐴡𐴕𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴒𐴡𐴥𐴓𐴞 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥.</char> <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴠 𐴒𐴟𐴌𐴝 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴐𐴡𐴥𐴣𐴍𐴡 𐴁𐴝𐴕𐴝, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌.</char> <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴒𐴟𐴌𐴝 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠.“ </char><verse eid="MAT 18:5" /></para>
  <para style="s1">𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴝𐴁𐴝𐴌 𐴀𐴠𐴕𐴃𐴝𐴥𐴕</para>
  <para style="r">(<ref loc="MRK 9:42-48">𐴔𐴝𐴑 9‏:42‏-48</ref>; <ref loc="LUK 17:1-2">𐴓𐴟𐴑 17‏:1‏-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />
    <char style="wj">”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴊𐴠 𐴀𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥𐴁𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴡𐴓𐴝𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴡𐴥𐴌 𐴐𐴞𐴥𐴓𐴡𐴌 𐴏𐴝𐴑𐴧𐴞 𐴁𐴝𐴣𐴊𐴞𐴥 𐴔𐴟𐴌 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴋𐴟𐴉𐴝𐴥𐴘𐴊𐴞𐴘𐴝 𐴎𐴝.</char> <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" /><char style="wj">𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴖𐴡𐴌𐴠 𐴏𐴞𐴎𐴢 𐴀𐴟𐴀𐴙𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢, 𐴎𐴞𐴀𐴕𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴝𐴁𐴝. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴟𐴘𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢, 𐴎𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴕𐴞𐴑𐴞 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴘𐴧𐴠𐴤.“</char> <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" /><char style="wj">𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴥𐴃𐴠 𐴘𐴝𐴥 𐴄𐴠𐴥𐴚𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴟𐴎𐴟 𐴄𐴝𐴕𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴝𐴍𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴡. 𐴊𐴟𐴘 𐴀𐴝𐴥𐴃𐴢 𐴘𐴝𐴥 𐴊𐴟𐴘 𐴄𐴠𐴥𐴚 𐴃𐴝𐴥𐴑𐴞 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴄𐴟𐴥𐴣𐴍𐴝 𐴘𐴝𐴥 𐴓𐴠𐴚 𐴀𐴡𐴥𐴘 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴒𐴡𐴥𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌.</char> <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴟𐴑𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴟𐴎𐴟 𐴄𐴝𐴕𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴘𐴞𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴕𐴠𐴦𐴓𐴝𐴘 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴡. 𐴊𐴟𐴘 𐴏𐴟𐴑 𐴃𐴝𐴥𐴑𐴞 𐴎𐴟𐴎𐴟𐴑𐴡𐴌 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴟𐴑 𐴓𐴡𐴘 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴒𐴡𐴥𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌. </char><verse eid="MAT 18:9" /></para>
  <para style="s1">𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="LUK 15:3-7">𐴓𐴟𐴑 15‏:3‏-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />
    <char style="wj">𐴏𐴝𐴘𐴧𐴡𐴥, 𐴀𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴝𐴌𐴝𐴥𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴡𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝 𐴊𐴠𐴑𐴠𐴥.</char> <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" /><char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴥𐴣𐴎𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝.</char><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴁𐴝𐴥𐴉𐴡؟ 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴃𐴝𐴥𐴑𐴠 𐴀𐴝𐴦𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴡𐴁𐴧𐴡𐴘-𐴕𐴡𐴖 𐴖𐴝𐴌𐴠 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴌𐴞, 𐴀𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴖𐴝𐴘𐴃𐴡𐴥 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡 𐴕𐴠𐴥؟</char> <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴖𐴝𐴘 𐴉𐴝𐴘𐴓𐴠, 𐴀𐴡𐴥𐴌 𐴕𐴡𐴥 𐴊𐴠 𐴕𐴡𐴁𐴧𐴡𐴘-𐴕𐴡𐴖 𐴖𐴝 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴓𐴟𐴕𐴡𐴌𐴠 𐴓𐴡𐴥𐴘 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴀𐴞𐴥𐴃𐴠 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char> <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴘𐴝𐴀𐴕 𐴕𐴡 𐴊𐴠 𐴑𐴞, 𐴀𐴠 𐴒𐴟𐴌𐴝 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴎𐴡𐴕.</char><verse eid="MAT 18:14" /></para>
  <para style="s1">𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴁𐴝𐴥𐴘</para>
  <para style="r">(<ref loc="LUK 17:3">𐴓𐴟𐴑 17‏:3</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />
    <char style="wj">”𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴓𐴋𐴝 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴎𐴝𐴘 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴝𐴈𐴝𐴤𐴘𐴊𐴞𐴘𐴡. 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴡𐴃𐴝𐴤 𐴊𐴡𐴥𐴌𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴉𐴞𐴥𐴌𐴝𐴘 𐴉𐴝𐴘𐴧𐴡𐴥.</char> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴎𐴧𐴡𐴕 𐴘𐴝𐴥 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴧𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 ’𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴦𐴔𐴠𐴓𐴝 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴘𐴝𐴥 𐴃𐴞𐴕 𐴎𐴡𐴕 𐴒𐴡𐴁𐴝𐴤𐴌 𐴎𐴡𐴁𐴝𐴕𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴁𐴡𐴓𐴞 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.‘</char><note caller="+" style="f"><char style="fr" closed="false">18‏:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 19:15">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 19‏:15</ref></char> </char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴘𐴡𐴥 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴈𐴡𐴘𐴧𐴡𐴥. 𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴘𐴡𐴥 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴘𐴝𐴥 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴗𐴑.</char><verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴞𐴀𐴕 𐴁𐴝𐴣𐴊𐴞𐴥𐴁𐴝, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴡𐴥 𐴁𐴝𐴣𐴊𐴝𐴤 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴞𐴀𐴕 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞𐴁𐴝, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴡𐴥 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />
    <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴡𐴊𐴞 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴊𐴟𐴘 𐴎𐴡𐴕𐴠 𐴀𐴠𐴑𐴃𐴡𐴉𐴝𐴥𐴑 𐴀𐴡𐴥𐴘 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥𐴓𐴠, 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴍𐴠𐴥 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴘𐴝𐴥 𐴃𐴞𐴕 𐴎𐴡𐴕 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥, 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴝𐴎𐴠𐴥 𐴀𐴝𐴏𐴞𐴤.“</char><verse eid="MAT 18:20" /></para>
  <para style="s1">𐴔𐴝𐴉𐴢 𐴕𐴡 𐴊𐴠𐴊𐴠 𐴒𐴡𐴗𐴀𐴌𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴓𐴋𐴝 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡 𐴁𐴝𐴌 𐴔𐴝𐴉𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟ 𐴇𐴝𐴥𐴣𐴃𐴢 𐴁𐴝𐴌 𐴕𐴠𐴥؟“<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴇𐴝𐴥𐴣𐴃𐴢 𐴁𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴕𐴡 𐴈𐴡𐴀𐴙𐴌, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴡𐴥𐴙𐴃𐴧𐴡𐴌 𐴒𐴟𐴕 𐴇𐴝𐴥𐴣𐴃𐴢 𐴁𐴝𐴌.</char><verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />
    <char style="wj">”𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴞𐴥𐴏𐴝𐴉𐴢 𐴓𐴡𐴘𐴃𐴡 𐴏𐴝𐴘𐴧𐴠𐴥.</char> <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴏𐴝𐴉𐴢 𐴓𐴡𐴖𐴝 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴝𐴕𐴝𐴤 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴝𐴃𐴧𐴟 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴓𐴝𐴑-𐴓𐴝𐴑 𐴄𐴞𐴛𐴝 𐴉𐴡𐴦𐴃𐴞 𐴉𐴝𐴦𐴌.</char> <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" /><char style="wj">𐴀𐴞𐴥𐴃𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴣𐴎𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴣𐴎𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴡𐴖𐴢 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴠𐴏𐴞𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝.</char><verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴒𐴡𐴗𐴀𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴇𐴡𐴦𐴊𐴧𐴞𐴕 𐴀𐴝𐴥𐴕𐴞𐴑 𐴏𐴡𐴁𐴡𐴥𐴌 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴥𐴣𐴎𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴟𐴔.‘</char> <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" /><char style="wj">𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴒𐴡𐴗𐴀𐴌 𐴒𐴗𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴝 𐴉𐴠𐴄𐴉𐴟𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴦𐴃𐴞 𐴒𐴟𐴥𐴕 𐴔𐴝𐴉𐴢 𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴌𐴞𐴊𐴞𐴘𐴠𐴥.</char><verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴒𐴡𐴗𐴀𐴌𐴒𐴗𐴝𐴥 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴎𐴝𐴘, 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴒𐴡𐴗𐴀𐴌𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴊𐴞𐴕𐴝𐴥𐴌</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">18‏:28 </char>
      <char style="ft" closed="false">𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌 𐴀𐴠𐴑 𐴊𐴞𐴕𐴡𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴓𐴡𐴘 𐴁𐴡𐴌𐴝𐴁𐴡𐴌</char>
    </note> <char style="wj">𐴄𐴞𐴛𐴝 𐴀𐴟𐴊𐴝𐴥𐴌 𐴓𐴡𐴀𐴙𐴓𐴢. 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴒𐴡𐴓𐴝 𐴏𐴞𐴁𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌 𐴉𐴡𐴦𐴃𐴞 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝.‘</char><verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴒𐴡𐴗𐴀𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴄𐴠𐴥𐴚𐴡𐴃𐴢 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴌𐴞 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ’𐴇𐴡𐴦𐴊𐴧𐴞𐴕 𐴀𐴝𐴥𐴕𐴞𐴑 𐴏𐴡𐴁𐴡𐴥𐴌 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴥𐴣𐴎𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴟𐴔.‘ </char><verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴠 𐴕𐴡𐴥 𐴔𐴝𐴕𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴝𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴡𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴡𐴓𐴧𐴝 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥𐴒𐴡𐴘, 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴉𐴡𐴦𐴃𐴞 𐴇𐴞𐴥𐴀𐴕 𐴕𐴡𐴥 𐴉𐴟𐴥𐴣𐴎𐴠.</char> <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴓𐴝𐴙𐴒𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌𐴠 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥.</char><verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />
    <char style="wj">”𐴃𐴡𐴥𐴘 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴘 𐴃𐴡 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴒𐴡𐴗𐴀𐴌! 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥𐴏𐴢 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴃𐴡𐴌 𐴉𐴡𐴦𐴃𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴔𐴝𐴉𐴢 𐴊𐴞𐴘𐴞𐴥.</char> <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" /><char style="wj">𐴃𐴡𐴌𐴃𐴧𐴟 𐴘𐴡𐴥 𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴒𐴡𐴗𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤𐴕 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴕𐴠𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥؟‘ </char> <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" /><char style="wj">𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴃𐴧𐴟 𐴒𐴟𐴐𐴧𐴝𐴤 𐴀𐴟𐴍𐴞𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴡𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴡𐴌𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠, 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌 𐴉𐴡𐴦𐴃𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴥𐴣𐴎𐴞 𐴕𐴡𐴥 𐴉𐴠𐴓𐴠.</char><verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />
    <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴁𐴝𐴉𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴠 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴊𐴞𐴓𐴡𐴃𐴧𐴟 𐴔𐴝𐴉𐴢 𐴕𐴡 𐴊𐴡.“</char><verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="r">(<ref loc="MRK 10:1-12">𐴔𐴝𐴑 10‏:1‏-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴘𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴧𐴟 𐴁𐴝𐴐𐴝𐴥 𐴓𐴡𐴥𐴘 𐴅𐴡𐴌𐴊𐴝𐴥𐴕 𐴇𐴝𐴥𐴓𐴡𐴌 𐴉𐴝𐴌𐴑𐴟𐴓𐴡𐴌 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴞𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴘𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴖𐴝𐴅𐴝𐴤𐴘𐴠 𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘𐴁𐴝𐴌 𐴎𐴝𐴘𐴠𐴏𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥؟“<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴕𐴡𐴥 𐴉𐴡𐴌𐴡𐴥, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴐𐴟𐴥𐴌𐴟𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴡𐴌𐴡𐴃𐴢 𐴀𐴝𐴦𐴌 𐴔𐴝𐴘𐴝 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴊𐴠,</char><note caller="+" style="f"><char style="fr" closed="false">19‏:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 1:27">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 1‏:27</ref></char></char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" /><char style="wj">𐴀𐴝𐴦𐴌 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ’𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴃𐴡 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴃𐴧𐴟 𐴎𐴟𐴊𐴝 𐴀𐴡𐴥𐴘 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴀𐴠𐴑 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘‘؟</char><note caller="+" style="f"><char style="fr" closed="false">19‏:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 2‏:24</ref></char></char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" /><char style="wj">𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌 𐴊𐴟𐴘 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴑 𐴅𐴞𐴏𐴞𐴥𐴔. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴎𐴟𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴏𐴞𐴥𐴌𐴝 𐴕𐴡 𐴒𐴡𐴌𐴡𐴥𐴗𐴑.“</char><verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴞𐴘𐴝𐴥 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠, 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴝𐴥𐴌𐴇𐴝𐴁𐴡𐴏𐴢 𐴊𐴞𐴦 𐴊𐴟𐴣𐴌𐴝𐴘 𐴊𐴞𐴘𐴡؟“<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴊𐴡𐴌𐴡𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴡𐴖𐴝𐴥𐴙𐴕 𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴌 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴟𐴥𐴌𐴟𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.</char> <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴎𐴠𐴕𐴝𐴤𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴞𐴓𐴧𐴝 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴖𐴝𐴅𐴝𐴤𐴘𐴠 𐴏𐴝𐴥𐴌𐴞𐴉𐴠𐴓𐴠 𐴀𐴝𐴦𐴌 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠.“</char><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴎𐴝𐴔𐴝𐴘 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴁𐴞𐴘𐴝𐴥 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤𐴕 𐴀𐴠𐴥𐴕𐴝 𐴁𐴠𐴀𐴃𐴡𐴌.“<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴁𐴠 𐴉𐴝𐴌𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥.</char> <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴎𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴦𐴌 𐴉𐴠𐴍𐴡𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴥𐴎𐴝𐴌𐴝,</char><note caller="+" style="f"><char style="fr" closed="false">19‏:12 </char><char style="ft" closed="false">𐴔𐴝𐴀𐴕𐴞 </char><char style="fqa">𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴡𐴌𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴉𐴟𐴀𐴝𐴙𐴕 𐴁𐴞𐴘𐴝𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴏𐴝𐴥𐴌𐴝 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥</char></note> <char style="wj">𐴀𐴝𐴦𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴎𐴝𐴌𐴝 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥; 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴥 𐴇𐴡𐴊𐴟𐴥𐴕 𐴀𐴞𐴥𐴎𐴝𐴌𐴝 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴁𐴞𐴘𐴝𐴥 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴡𐴥𐴗𐴑.“</char><verse eid="MAT 19:12" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 10:13-16">𐴔𐴝𐴑 10‏:13‏-16</ref>; <ref loc="LUK 18:15-17">𐴓𐴟𐴑 18‏:15‏-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />𐴀𐴠𐴑 𐴊𐴞𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴕𐴝𐴤𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴥𐴃𐴢 𐴊𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴡𐴥𐴄𐴁𐴡𐴍𐴝𐴥𐴘𐴧𐴠.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴃𐴡𐴤𐴊𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴡 𐴀𐴡𐴀𐴛𐴓𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴠𐴥𐴕𐴝 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.“</char> <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴥𐴃𐴢 𐴊𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="MAT 19:15" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴅𐴟𐴖𐴝𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢</para>
  <para style="r">(<ref loc="MRK 10:17-31">𐴔𐴝𐴑 10‏:17‏-31</ref>; <ref loc="LUK 18:18-30">𐴓𐴟𐴑 18‏:18‏-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />𐴉𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘𐴃𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴞𐴦 𐴒𐴡𐴔 𐴈𐴝𐴔<note caller="+" style="f"><char style="fr" closed="false">19‏:16 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa" closed="false">𐴕𐴠𐴑 𐴈𐴝𐴔</char></note> 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥؟“<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴒𐴡𐴔 𐴀𐴡𐴌</char><note caller="+" style="f"><char style="fr" closed="false">19‏:17 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa" closed="false">𐴕𐴠𐴑𐴞𐴌</char></note> <char style="wj">𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴞𐴘𐴝𐴥 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴡𐴤𐴌؟ 𐴒𐴡𐴔 𐴃𐴡 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴏𐴠𐴤. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴓𐴠𐴥, 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴡𐴤.“</char><verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴡𐴕 𐴕𐴟𐴥𐴕؟“</para>
  <para style="p" vid="MAT 19:18">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">” ’𐴑𐴟𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝; 𐴎𐴠𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝; 𐴏𐴟𐴌𐴞 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝; 𐴔𐴞𐴏𐴝𐴥 𐴒𐴡𐴁𐴝𐴤 𐴕𐴡 𐴊𐴞𐴁𐴝;</char> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" /><char style="wj">𐴁𐴝𐴉𐴔𐴝𐴦𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝,‘</char><note caller="+" style="f"><char style="fr" closed="false">19‏:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12-16">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 20‏:12‏-16</ref></char>; <char style="xt"><ref loc="DEU 5:16-20">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 5‏:16‏-20</ref></char></char></note> <char style="wj">𐴀𐴠𐴊𐴧𐴠 ’𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘ “</char><note caller="+" style="f"><char style="fr" closed="false">19‏:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 19‏:18</ref></char></char></note><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />𐴅𐴟𐴖𐴝𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴘𐴧𐴞𐴤𐴌. 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴌 𐴑𐴞𐴦 𐴁𐴝𐴑𐴞 𐴀𐴝𐴏𐴠𐴤؟“<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴇𐴝𐴥𐴄𐴞 𐴀𐴡𐴥𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴎𐴡𐴦, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴠𐴏𐴞 𐴒𐴡𐴌𐴞𐴉𐴡𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴡𐴒𐴡𐴘, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴀𐴛 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴊𐴡𐴥𐴕 𐴉𐴝𐴘𐴁𐴝; 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴡𐴥𐴘𐴧𐴡𐴒𐴝𐴘.“</char><verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴅𐴟𐴖𐴝𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴊𐴡𐴥𐴕-𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴀𐴝𐴏𐴠𐴤.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴃𐴠 𐴁𐴞𐴐𐴞𐴤 𐴔𐴡𐴐𐴑𐴞𐴓𐴢.</char> <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴟𐴣𐴄𐴢 𐴉𐴟𐴥𐴣𐴐𐴡𐴌 𐴉𐴝𐴀𐴙𐴃𐴧𐴟 𐴒𐴡𐴓𐴞 𐴎𐴝𐴦 𐴀𐴝𐴌𐴡𐴤 𐴀𐴝𐴏𐴝𐴤𐴕.“</char><verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴌𐴝𐴥𐴌 𐴁𐴞𐴐𐴞𐴤 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴡𐴕𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟“<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴟𐴎𐴟 𐴏𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴠 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠.“</char><verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴀, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴠𐴌𐴞𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴞𐴒𐴡𐴘. 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴦 𐴉𐴝𐴘𐴧𐴟𐴔؟“<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴕𐴡𐴘𐴝 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴡𐴘𐴁𐴡𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴁𐴝𐴌𐴡𐴥 𐴖𐴝𐴕 𐴃𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴁𐴝𐴌𐴡𐴥 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝,</char> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌, 𐴁𐴝𐴥𐴘, 𐴁𐴡𐴥𐴙𐴕, 𐴁𐴝𐴉𐴢, 𐴔𐴝𐴦, 𐴁𐴡𐴖𐴢, 𐴉𐴟𐴀𐴝𐴙𐴕, 𐴘𐴝𐴥 𐴎𐴝𐴒𐴝𐴎𐴡𐴁𐴞𐴕 𐴀𐴠𐴌𐴞𐴊𐴞𐴘𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴒𐴟𐴕 𐴁𐴞𐴐𐴞𐴤 𐴉𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴝𐴓𐴝 𐴀𐴝𐴒𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴞𐴏𐴠𐴤 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴝𐴓𐴝 𐴉𐴞𐴏𐴠𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴒𐴠 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“</char><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴔𐴡𐴎𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />
    <char style="wj">”𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴡𐴔𐴞𐴊𐴝𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴠𐴑 𐴊𐴞𐴕 𐴁𐴞𐴀𐴕𐴧𐴝 𐴏𐴡𐴥𐴀𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝𐴓𐴧𐴝 𐴔𐴡𐴎𐴟𐴌 𐴊𐴡𐴥𐴙𐴃𐴧𐴡 𐴒𐴞𐴦𐴘𐴠𐴥.</char> <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴞𐴕𐴠 𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌</char><note caller="+" style="f"><char style="fr" closed="false">20‏:2 </char><char style="ft" closed="false">𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌 𐴀𐴠𐴑 𐴊𐴞𐴕𐴡𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴓𐴡𐴘 𐴁𐴡𐴌𐴝𐴁𐴡𐴌</char></note> <char style="wj">𐴀𐴡𐴌 𐴊𐴡𐴥𐴌𐴠 𐴊𐴞𐴦 𐴁𐴡𐴓𐴧𐴝 𐴌𐴝𐴎𐴞 𐴀𐴡𐴥𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴞𐴘𐴠.</char><verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />
    <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴡𐴖 𐴖𐴝 𐴁𐴝𐴥𐴎𐴠 𐴒𐴡𐴥𐴌𐴞 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴒𐴞𐴦𐴘𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴝𐴌𐴡𐴤 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴈𐴝𐴔 𐴏𐴝𐴥𐴌𐴝, 𐴁𐴝𐴎𐴝𐴌𐴡𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥.</char> <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴎𐴝𐴘 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝𐴃𐴢 𐴈𐴝𐴔 𐴒𐴡𐴌𐴡𐴤𐴒𐴡𐴘, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑 𐴔𐴡𐴃𐴝𐴉𐴠 𐴒𐴡𐴥𐴌𐴞 𐴊𐴝𐴔 𐴊𐴞𐴦𐴘𐴟𐴔.‘ 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴞𐴦𐴘𐴠𐴥. </char><verse eid="MAT 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 20:5" />
    <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴁𐴝𐴌 𐴁𐴝𐴌𐴡𐴥 𐴖𐴝 𐴁𐴝𐴥𐴎𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴁𐴝𐴥𐴎𐴠 𐴒𐴡𐴥𐴌𐴞 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴎𐴝𐴘, 𐴀𐴠𐴑𐴞𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" /><char style="wj">𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴁𐴝𐴥𐴎𐴠 𐴒𐴡𐴥𐴌𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴝𐴀𐴌𐴑𐴟𐴓𐴠 𐴒𐴞𐴦𐴘𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴌𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴠 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴍𐴠𐴥 𐴊𐴞𐴕𐴁𐴡𐴥𐴌 𐴈𐴝𐴔 𐴏𐴝𐴥𐴌𐴝 𐴑𐴞𐴘𐴝𐴥 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴡؟‘</char><verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />
    <char style="wj">”𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴈𐴝𐴔𐴡𐴃𐴢 𐴕𐴡𐴥 𐴓𐴡𐴦 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝.‘</char></para>
  <para style="p" vid="MAT 20:7">
    <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴎𐴝𐴘 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝𐴃𐴢 𐴈𐴝𐴔 𐴒𐴡𐴌𐴡𐴤𐴒𐴡𐴘.‘</char><verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />
    <char style="wj">”𐴇𐴝𐴥𐴣𐴎𐴞𐴕𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴔𐴝𐴎𐴞𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴔𐴡𐴎𐴟𐴌 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴃𐴝, 𐴀𐴝𐴦𐴌 𐴉𐴞𐴏𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴓𐴡𐴥𐴃𐴞 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴒𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴊𐴝𐴔 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝.‘</char><verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />
    <char style="wj">”𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴉𐴝𐴣𐴏𐴢 𐴏𐴗𐴝𐴥 𐴁𐴝𐴥𐴎𐴠 𐴈𐴝𐴔𐴡𐴃𐴢 𐴓𐴝𐴒𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌𐴡𐴌 𐴊𐴡𐴥𐴌𐴠 𐴉𐴝𐴘𐴧𐴠𐴥.</char> <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴒𐴠 𐴈𐴝𐴔𐴡𐴃𐴢 𐴓𐴝𐴒𐴝 𐴒𐴞𐴘𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴀𐴘𐴢, 𐴁𐴞𐴐𐴞𐴤 𐴉𐴝𐴘𐴁𐴡 𐴁𐴡𐴓𐴞 𐴄𐴝𐴥𐴀𐴙𐴅𐴧𐴠. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥 𐴎𐴡𐴕𐴠 𐴘𐴡𐴥 𐴉𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌𐴡𐴌 𐴊𐴡𐴥𐴌𐴠. </char> <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴝𐴘𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴎𐴡𐴔𐴞𐴊𐴝𐴌 𐴒𐴗𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴔𐴡𐴕𐴔𐴡𐴕𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.</char> <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" /><char style="wj">𐴀𐴠𐴀𐴕 𐴈𐴡𐴀𐴘𐴢, ’𐴉𐴞𐴏𐴡𐴥𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴑 𐴒𐴡𐴥𐴕𐴋𐴝 𐴁𐴠 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠 𐴊𐴞𐴕𐴁𐴡𐴥𐴌 𐴌𐴡𐴙𐴊𐴡𐴌 𐴒𐴡𐴌𐴡𐴔𐴡𐴃𐴢 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴃𐴡𐴀 𐴃𐴟𐴀𐴛 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴉𐴟𐴥𐴖𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.‘</char><verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴁𐴝𐴥𐴘, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴕𐴝𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞 𐴕𐴡𐴥 𐴒𐴡𐴌𐴞𐴥. 𐴃𐴟𐴘 𐴀𐴠𐴑 𐴊𐴞𐴕𐴝𐴥𐴌 𐴓𐴡𐴥𐴘 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴡𐴥𐴘 𐴌𐴝𐴎𐴞 𐴀𐴡𐴥𐴘𐴓𐴞𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟</char> <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" /><char style="wj">𐴃𐴡𐴌 𐴊𐴝𐴔 𐴓𐴡𐴦𐴘𐴧𐴡𐴌𐴠 𐴎𐴝𐴦𐴒𐴡𐴥𐴘. 𐴉𐴞𐴏𐴠𐴤 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴕 𐴊𐴝𐴔 𐴊𐴞𐴦𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌.</char> <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" /><char style="wj">𐴀𐴝𐴣𐴀𐴌 𐴕𐴞𐴎𐴡𐴌 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴠𐴀𐴕 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴇𐴠𐴥𐴀𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴡𐴥𐴑 𐴕𐴝𐴥𐴘 𐴕𐴞𐴑𐴞؟ 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴀𐴝𐴀𐴛 𐴒𐴡𐴔 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡𐴌𐴃𐴧𐴟 𐴌𐴞𐴐𐴢 𐴓𐴝𐴒𐴠𐴌 𐴊𐴠𐴥؟‘</char><verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴝𐴓𐴝 𐴀𐴝𐴒𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴞𐴏𐴠𐴤 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴝𐴓𐴝 𐴉𐴞𐴏𐴠𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴒𐴠 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“</char><verse eid="MAT 20:16" /></para>
  <para style="s1">𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴞𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴘𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 10:32-34">𐴔𐴝𐴑 10‏:32‏-34</ref>; <ref loc="LUK 18:31-34">𐴓𐴟𐴑 18‏:31‏-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />𐴀𐴞𐴏𐴝𐴤 𐴖𐴡𐴌𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴞𐴕𐴝𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘 𐴉𐴡𐴣𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" /><char style="wj">”𐴏𐴡𐴀, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴖𐴡𐴌𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴝𐴙𐴌𐴒𐴡𐴥𐴘, 𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴡𐴦𐴃𐴡𐴌 𐴉𐴡𐴥𐴃𐴟𐴖𐴝 𐴊𐴞𐴥𐴁𐴡, </char> <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" /><char style="wj">𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴁𐴡, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴥𐴕𐴐𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝, 𐴐𐴡𐴀𐴣𐴑 𐴔𐴝𐴌𐴞 𐴁𐴡𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝. 𐴓𐴠𐴑𐴞𐴕 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="MAT 20:19" /></para>
  <para style="s1">𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴔𐴝𐴦𐴌 𐴀𐴝𐴌𐴡𐴏𐴢</para>
  <para style="r">(<ref loc="MRK 10:35-45">𐴔𐴝𐴑 10‏:35‏-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴔𐴝𐴦𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴘𐴊𐴝 𐴉𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴑𐴞𐴦 𐴏𐴡𐴀𐴌 𐴊𐴠𐴥؟“</char></para>
  <para style="p" vid="MAT 20:21">𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴖𐴝𐴦𐴊𐴝 𐴊𐴡𐴦 𐴊𐴠, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠 𐴉𐴟𐴖𐴝 𐴊𐴟𐴕𐴞𐴥 𐴖𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴝𐴘𐴁𐴝, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑 𐴀𐴡𐴃𐴧𐴟, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴕 𐴋𐴝𐴥𐴑 𐴀𐴡𐴃𐴧𐴟.“<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴔𐴝𐴒𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡. 𐴀𐴝𐴀𐴛 𐴉𐴞𐴀𐴘𐴟𐴔 𐴊𐴠 𐴉𐴞𐴘𐴝𐴓𐴝 𐴘𐴞𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴞𐴀 𐴉𐴝𐴌𐴞𐴁𐴝𐴥 𐴕𐴠𐴥؟“</char></para>
  <para style="p" vid="MAT 20:22">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴉𐴝𐴌𐴞𐴘𐴟𐴥𐴔.“<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴁𐴠𐴐𐴡𐴥𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴉𐴞𐴀𐴁𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴘𐴝𐴥 𐴁𐴝𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴁𐴟𐴀𐴝𐴥𐴒𐴝𐴌𐴡𐴕 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴔 𐴕𐴡. 𐴎𐴝𐴒𐴝 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴠 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥.“</char><verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />𐴁𐴝𐴑𐴞 𐴊𐴡𐴐𐴢 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴥 𐴁𐴝𐴥𐴘 𐴓𐴡𐴥𐴘 𐴒𐴟𐴐𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴝𐴌𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴦𐴏𐴃𐴌𐴞 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴃𐴝𐴌𐴝𐴥𐴌 𐴋𐴡𐴣𐴀𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴏𐴡𐴓𐴝.</char> <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴕 𐴄𐴞𐴥𐴑 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘𐴃𐴡 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴁𐴡𐴕𐴝𐴌 𐴎𐴡𐴌𐴟𐴌;</char> <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" /><char style="wj">𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴒𐴠 𐴀𐴡𐴥𐴘𐴃𐴡 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴁𐴡𐴕𐴝𐴌 𐴎𐴡𐴌𐴟𐴌;</char> <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" /><char style="wj">𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴃𐴡 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴃𐴡.“</char><verse eid="MAT 20:28" /></para>
  <para style="s1">𐴊𐴟𐴘 𐴎𐴡𐴕 𐴀𐴝𐴣𐴊𐴝𐴤𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 10:46-52">𐴔𐴝𐴑 10‏:46‏-52</ref>; <ref loc="LUK 18:35-43">𐴓𐴟𐴑 18‏:35‏-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴅𐴠𐴌𐴞𐴑𐴡𐴥 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴠𐴌, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />𐴊𐴟𐴘 𐴎𐴡𐴕 𐴀𐴝𐴣𐴊𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴌𐴝𐴏𐴃𐴝𐴌 𐴇𐴝𐴣𐴏𐴝𐴃𐴢 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤 𐴇𐴠𐴥 𐴌𐴝𐴏𐴃𐴝 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤!“<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴘 𐴕𐴞𐴎𐴝𐴥𐴔 𐴀𐴡𐴥𐴘𐴃𐴡 𐴈𐴡𐴘𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌𐴡𐴤 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴞 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴤!“<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴃𐴞𐴥𐴘𐴝𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴑𐴞𐴦 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟“</char><verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴝𐴀𐴘𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴏𐴟𐴑 𐴑𐴟𐴥𐴕 𐴑𐴟𐴥𐴓𐴞𐴎𐴡𐴒𐴧𐴡𐴘.“<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴓𐴝𐴒𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑 𐴑𐴟𐴥𐴕 𐴏𐴟𐴥𐴘𐴧𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴒𐴡𐴥𐴙𐴓𐴧𐴠</para>
  <para style="r">(<ref loc="MRK 11:1-11">𐴔𐴝𐴑 11‏:1‏-11</ref>; <ref loc="LUK 19:28-38">𐴓𐴟𐴑 19‏:28‏-38</ref>; <ref loc="JHN 12:12-19">𐴘𐴡 12‏:12‏-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴠𐴃𐴉𐴠𐴥𐴒𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴡𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴟𐴀𐴔𐴡𐴌 𐴉𐴝𐴌𐴝 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴦, 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴘 𐴔𐴡𐴃𐴧𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴝𐴊𐴝𐴤 𐴁𐴝𐴙𐴕𐴊𐴝𐴤 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴁𐴝, 𐴘𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴡𐴥𐴀 𐴘𐴡𐴥 𐴉𐴝𐴘𐴁𐴝. 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴑𐴟𐴥𐴓𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴕𐴡𐴤𐴒𐴡𐴘.</char> <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" /><char style="wj">𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴡𐴀, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑𐴡𐴃𐴧𐴟 𐴀𐴞𐴀𐴕𐴡𐴌𐴠 𐴓𐴝𐴒𐴠𐴌.‘ 𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴠𐴥𐴇𐴡𐴕 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴞𐴁𐴡.“</char><verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴕𐴡𐴁𐴞𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />”𐴏𐴞𐴥𐴘𐴡𐴕𐴡𐴌 𐴎𐴠𐴥𐴌𐴉𐴟𐴖𐴝𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠,</para>
  <para style="q2" vid="MAT 21:5">’𐴏𐴡𐴀, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.</para>
  <para style="q1" vid="MAT 21:5">𐴀𐴞𐴥𐴁𐴝 𐴐𐴞𐴥𐴊𐴝, 𐴀𐴞𐴥𐴁𐴝 𐴒𐴝𐴊𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴌𐴞,</para>
  <para style="q2" vid="MAT 21:5">𐴒𐴝𐴊𐴝𐴤𐴌 𐴏𐴡𐴥𐴀𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴌𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.‘ “<note caller="+" style="f"><char style="fr" closed="false">21‏:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 9:9">𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝 9‏:9</ref></char> </char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />𐴇𐴠𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴘, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴐𐴞𐴥𐴑𐴝𐴘𐴊𐴞𐴘𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴝𐴊𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴒𐴝𐴊𐴝𐴤𐴌 𐴏𐴡𐴥𐴀 𐴖𐴝𐴌𐴠 𐴀𐴝𐴙𐴕𐴧𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴦𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴞𐴐𐴝𐴥𐴘𐴊𐴞𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />𐴁𐴠𐴦𐴐𐴢 𐴁𐴝𐴥𐴑 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴦𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴌𐴝𐴏𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴞𐴐𐴝𐴥𐴘𐴊𐴞𐴘𐴠; 𐴀𐴝𐴌𐴒𐴟𐴥𐴕𐴠 𐴒𐴝𐴏𐴡𐴌 𐴋𐴝𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴝𐴍𐴞 𐴌𐴝𐴏𐴃𐴝𐴃𐴢 𐴁𐴞𐴐𐴝𐴥𐴘𐴊𐴞𐴘𐴠. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />𐴎𐴠𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴒𐴠-𐴀𐴝𐴒𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠,</para>
  <para style="q1" vid="MAT 21:9">”𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴇𐴡𐴥𐴏𐴝𐴕𐴝!<note caller="+" style="f"><char style="fr" closed="false">21‏:9 </char><char style="ft" closed="false">𐴇𐴞𐴁𐴌𐴟𐴤 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴇𐴡𐴥𐴏𐴝𐴕𐴝 𐴔𐴝𐴀𐴕𐴞 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 </char></note></para>
  <para style="q1" vid="MAT 21:9">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.<note caller="+" style="f"><char style="fr" closed="false">21‏:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:25">𐴎𐴡𐴁𐴟𐴌 118‏:25</ref>‏,<ref loc="PSA 118:26">26</ref></char></char></note></para>
  <para style="q1" vid="MAT 21:9">𐴀𐴠𐴁𐴧𐴠 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴗𐴑!“<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴒𐴟𐴣𐴍𐴝 𐴐𐴡𐴥𐴀𐴌 𐴀𐴟𐴥𐴌𐴟𐴏𐴧𐴟𐴓𐴡𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴇𐴡𐴕؟“<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴕𐴡𐴁𐴞, 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴕𐴝𐴏𐴝𐴥𐴌𐴝𐴃𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴌.“<verse eid="MAT 21:11" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 11:15-19">𐴔𐴝𐴑 11‏:15‏-19</ref>; <ref loc="LUK 19:45-48">𐴓𐴟𐴑 19‏:45‏-48</ref>; <ref loc="JHN 2:13-22">𐴘𐴡 2‏:13‏-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥𐴍𐴠 𐴁𐴠𐴏𐴝 𐴑𐴞𐴕𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴓𐴡𐴌𐴝𐴘𐴊𐴞𐴘𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠; 𐴀𐴝𐴦𐴌 𐴁𐴝𐴄𐴧𐴝 𐴁𐴝𐴥𐴚𐴒𐴡𐴘𐴝𐴌 𐴄𐴠𐴁𐴞𐴥𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴈𐴡𐴘𐴃𐴡𐴌 𐴁𐴠𐴏𐴡𐴘𐴝𐴌 𐴁𐴡𐴘𐴍𐴡𐴥𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴝𐴃𐴋𐴞𐴘𐴝𐴒𐴝𐴌𐴝𐴘 𐴊𐴞𐴘𐴠. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ’𐴀𐴝𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴡𐴌𐴠 𐴔𐴟𐴕𐴝𐴎𐴝𐴃𐴡𐴌 𐴒𐴡𐴥𐴌 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴁𐴡,‘</char><note caller="+" style="f"><char style="fr" closed="false">21‏:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 56:7">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 56‏:7</ref></char></char></note> <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴡𐴌 𐴀𐴝𐴋𐴧𐴝-𐴈𐴝𐴥𐴕𐴝 𐴁𐴝𐴕𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴡.“</char><note caller="+" style="f"><char style="fr" closed="false">21‏:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 7:11">𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝 7‏:11</ref></char></char></note><verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴓𐴠𐴚 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />𐴓𐴠𐴑𐴞𐴕 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞, ”𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴇𐴡𐴥𐴏𐴝𐴕𐴝!“ 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴒𐴟𐴐𐴧𐴝𐴤 𐴀𐴟𐴍𐴞𐴤𐴒𐴞𐴘𐴡𐴘.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴉𐴟𐴥𐴕𐴡𐴌 𐴕𐴠𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴞𐴀𐴕𐴠 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌؟“</para>
  <para style="p" vid="MAT 21:16">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴉𐴟𐴥𐴕𐴞𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴘𐴝𐴀𐴕 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡𐴥 𐴉𐴡𐴌𐴡𐴥,</char></para>
  <para style="q1" vid="MAT 21:16">
    <char style="wj">’𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴊𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴔𐴟𐴑 𐴀𐴡𐴃𐴧𐴟</char></para>
  <para style="q2" vid="MAT 21:16">
    <char style="wj">𐴃𐴟𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴡𐴥؟‘ “</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21‏:16 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 8:2">𐴎𐴡𐴁𐴟𐴌 8‏:2</ref>
        </char>
      </char>
    </note><verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴌𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴌𐴝𐴙𐴃𐴢 𐴈𐴝𐴍𐴝𐴀𐴙𐴓𐴢.<verse eid="MAT 21:17" /></para>
  <para style="s1">𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴌𐴠 𐴁𐴡𐴊𐴧𐴟𐴖𐴝</para>
  <para style="r">(<ref loc="MRK 11:12-14">𐴔𐴝𐴑 11‏:12‏-14</ref>‏,<ref loc="MRK 11:20-24">20‏-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />𐴁𐴞𐴀𐴕𐴧𐴝 𐴏𐴡𐴥𐴀𐴌𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴎𐴝𐴘𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴁𐴟𐴥𐴑 𐴓𐴝𐴙𐴒𐴧𐴠𐴥. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴊𐴠𐴑𐴞𐴥, 𐴘𐴞𐴥𐴁𐴝𐴌 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴞𐴥𐴁𐴝𐴃𐴢 𐴉𐴝𐴃𐴝 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴡𐴦𐴃𐴢 𐴕𐴡𐴥 𐴉𐴝𐴦. 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴃𐴡𐴌𐴃𐴧𐴟 𐴒𐴟𐴓𐴝 𐴕𐴡 𐴊𐴡𐴥𐴌𐴡𐴗𐴑.“</char> 𐴃𐴡𐴥𐴘 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥 𐴉𐴟𐴥𐴖𐴝𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥 𐴀𐴠𐴀𐴕 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴑𐴠𐴀𐴕 𐴉𐴟𐴥𐴖𐴝𐴘𐴒𐴞𐴘𐴡𐴘؟“<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴔𐴝𐴕 𐴃𐴝𐴥𐴑𐴠 𐴀𐴝𐴦𐴌 𐴐𐴡𐴥𐴑 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴢 𐴏𐴗𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴡𐴊𐴞 𐴀𐴠 𐴉𐴝𐴀𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴘𐴡𐴥 𐴈𐴡𐴀, ’𐴀𐴟𐴍𐴞𐴤 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴉𐴡𐴌𐴒𐴡𐴥𐴘‘ 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴖𐴝𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴞𐴀𐴕 𐴔𐴝𐴒𐴞𐴁𐴝𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴝𐴘𐴁𐴝.“</char><verse eid="MAT 21:22" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 11:27-33">𐴔𐴝𐴑 11‏:27‏-33</ref>; <ref loc="LUK 20:1-8">𐴓𐴟𐴑 20‏:1‏-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴞 𐴁𐴝𐴦𐴊𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴠𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴈𐴝𐴔 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴠 𐴒𐴡𐴌𐴡𐴤𐴌؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴠 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴇𐴡𐴕𐴠 𐴊𐴞𐴦𐴘𐴠𐴥؟“<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴀𐴝𐴀𐴛 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴠 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠. </char> <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" /><char style="wj">𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴘𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴇𐴡𐴕𐴃𐴟𐴤 𐴉𐴝𐴀𐴙𐴓؟ 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴀𐴡𐴃𐴧𐴟؟“</char></para>
  <para style="p" vid="MAT 21:25">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴁𐴞𐴘𐴝𐴏𐴝𐴕𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴈𐴡𐴀𐴘𐴢 ’𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴡𐴃𐴧𐴟,‘ 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴑𐴞𐴘𐴝𐴥 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤؟‘ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴈𐴡𐴀𐴘𐴢, ’𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴀𐴡𐴃𐴧𐴟,‘ 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴡 𐴘𐴝𐴇𐴝𐴥𐴘𐴝𐴌𐴠 𐴕𐴡𐴁𐴞 𐴔𐴝𐴕𐴠.“<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴞.“</para>
  <para style="p" vid="MAT 21:27">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴡 𐴈𐴡𐴘𐴧𐴟𐴥𐴔 𐴀𐴝𐴀𐴛 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴠 𐴒𐴡𐴌𐴞𐴥𐴌.“ </char><verse eid="MAT 21:27" /></para>
  <para style="s1">𐴊𐴟𐴘 𐴉𐴟𐴖𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴎𐴝𐴥 𐴑𐴞𐴦؟ 𐴊𐴡𐴥𐴌𐴡, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴊𐴟𐴖𐴝𐴥 𐴉𐴟𐴖𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴖𐴝 𐴋𐴡𐴣𐴀𐴌 𐴒𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴡𐴥 𐴉𐴟𐴃𐴢, 𐴀𐴝𐴙𐴅𐴧𐴝 𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝𐴃𐴢 𐴎𐴝𐴘 𐴈𐴝𐴔 𐴒𐴡𐴌𐴒𐴡𐴥𐴘.‘</char> <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" /><char style="wj">𐴉𐴟𐴖𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴘𐴧𐴟𐴔,‘ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴠 𐴉𐴞𐴏𐴡𐴥𐴃𐴧𐴟 𐴔𐴡𐴕 𐴉𐴞𐴥𐴌𐴝𐴘𐴧𐴡𐴌𐴠 𐴒𐴞𐴦𐴘𐴠𐴥.</char> <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴖𐴝 𐴐𐴡𐴥𐴣𐴍𐴡 𐴖𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴡𐴥 𐴎𐴝𐴘 𐴀𐴠𐴑𐴞𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥. 𐴀𐴞𐴥𐴃𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, ’𐴅𐴞𐴦, 𐴎𐴝𐴘𐴧𐴟𐴔,‘ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴠 𐴕𐴡𐴥 𐴎𐴝𐴦.</char> <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" /><char style="wj">𐴉𐴟𐴖𐴝 𐴊𐴟𐴕𐴞𐴥 𐴖𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴠 𐴁𐴝𐴉𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴉𐴟𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥؟“ </char></para>
  <para style="p" vid="MAT 21:31">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴋𐴡𐴣𐴀𐴌𐴒𐴗𐴝𐴥 𐴘𐴠.“</para>
  <para style="p" vid="MAT 21:31">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴒𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</char><note caller="+" style="f"><char style="fr" closed="false">21‏:31 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa" closed="false">𐴔𐴝𐴒𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 </char></note> <char style="wj">𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴒𐴠 𐴒𐴡𐴥𐴓𐴠𐴌.</char> <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴝𐴇𐴝𐴥𐴘𐴝 𐴃𐴡 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴃𐴡𐴌𐴞𐴑𐴝 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴞𐴕 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴝𐴥𐴎𐴝𐴕𐴝-𐴃𐴟𐴓𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴒𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡 𐴔𐴡𐴕 𐴕𐴡𐴥 𐴉𐴞𐴥𐴌𐴡 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴞𐴕 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤.“</char><verse eid="MAT 21:32" /></para>
  <para style="s1">𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴐𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 12:1-12">𐴔𐴝𐴑 12‏:1‏-12</ref>; <ref loc="LUK 20:9-19">𐴓𐴟𐴑 20‏:9‏-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />
    <char style="wj">”𐴀𐴝𐴌𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴉𐴟𐴥𐴕𐴡: 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴎𐴡𐴔𐴞𐴊𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝 𐴓𐴝𐴒𐴝𐴘𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴏𐴝𐴘𐴌𐴡𐴥 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴒𐴞𐴥𐴌𐴝 𐴊𐴞𐴥𐴘𐴠, 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴕𐴠𐴦𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴠𐴥𐴍𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴝𐴣𐴌𐴝𐴥 𐴑𐴟𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴄𐴡𐴚𐴑𐴞 𐴁𐴝𐴙𐴕𐴊𐴠𐴤. 𐴁𐴝𐴦𐴊𐴠 𐴁𐴝𐴌𐴞𐴎𐴝 𐴒𐴝𐴥𐴕 𐴐𐴝𐴐𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴄𐴠𐴥𐴑𐴝 𐴊𐴞𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴡𐴥𐴘. </char> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" /><char style="wj">𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴀𐴝𐴙𐴕𐴊𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴟𐴓𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠. </char> <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴡𐴗𐴀𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴊𐴡𐴥𐴌𐴞, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴝-𐴊𐴡𐴥𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤𐴌𐴠 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤𐴌𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴔𐴝𐴙𐴅𐴧𐴠𐴥. </char> <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" /><char style="wj">𐴀𐴝𐴁𐴝𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴒𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴠𐴦𐴐𐴒𐴡𐴌𐴞 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠; 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴀𐴠𐴑𐴞𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" /><char style="wj">𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴀𐴕 𐴁𐴝𐴥𐴉𐴞 𐴕𐴞𐴎𐴡𐴌</char><note caller="+" style="f"><char style="fr" closed="false">21‏:37 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa" closed="false">𐴐𐴟𐴥𐴊𐴧𐴡𐴌 </char></note> <char style="wj">𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, ’𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.‘</char> <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴠 𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴉𐴡𐴤𐴏𐴡𐴃𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴞𐴃𐴠 𐴃𐴡 𐴔𐴞𐴌𐴝𐴏𐴊𐴝𐴥𐴌; 𐴀𐴝𐴘𐴧𐴡𐴤 𐴀𐴞𐴃𐴝𐴌𐴠𐴤 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴀𐴞𐴃𐴝𐴌 𐴔𐴞𐴌𐴝𐴏𐴢 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘.‘</char> <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" /><char style="wj">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴁𐴝𐴀𐴌𐴠 𐴓𐴡𐴘𐴎𐴝𐴘 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.“</char><verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />
    <char style="wj">”𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴁𐴝𐴌𐴞𐴎𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴝𐴘𐴓𐴠𐴤, 𐴇𐴠𐴥 𐴐𐴝𐴐𐴝𐴤 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴑𐴞𐴦 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌؟“ </char><verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴏𐴝𐴥𐴀𐴁𐴒𐴡𐴌𐴞 𐴇𐴡𐴥𐴃𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴌𐴞𐴎𐴝 𐴒𐴝𐴥𐴕 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴐𐴝𐴐𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴄𐴠𐴥𐴑𐴝 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴙𐴕𐴊𐴝 𐴀𐴝𐴘𐴓𐴠𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴒𐴟𐴓𐴝𐴌 𐴁𐴝𐴥𐴑 𐴊𐴞𐴦𐴁𐴡.“<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴘𐴝𐴀𐴕 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡𐴥 𐴉𐴡𐴌𐴡𐴥 𐴕𐴞𐴥𐴑𐴞,</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">’𐴎𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴔𐴞𐴏𐴃𐴞𐴥𐴌𐴞𐴘𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠,</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="wj">𐴘𐴞𐴥𐴁𐴝 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴌𐴟𐴌𐴞 𐴖𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴡𐴥𐴘𐴀𐴝𐴙𐴐𐴧𐴠,</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴏𐴟𐴑𐴡𐴃𐴢 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝؟‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21‏:42 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 118:22">𐴎𐴡𐴁𐴟𐴌 118‏:22</ref>‏,<ref loc="PSA 118:23">23</ref></char> </char>
    </note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴑𐴡𐴗𐴔𐴡𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴑𐴞 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴌</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21‏:43 </char>
      <char style="ft" closed="false">𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌</char>
    </note> <char style="wj">𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝 𐴊𐴡𐴥𐴌𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴝𐴥𐴚𐴒𐴞 𐴇𐴝𐴥𐴕-𐴇𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴝𐴌 𐴖𐴡𐴌𐴠 𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴉𐴞𐴐𐴞𐴥 𐴎𐴝𐴥𐴘𐴁𐴡𐴘.“</char><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴟𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴟𐴎𐴞𐴥𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘<note caller="+" style="f"><char style="fr" closed="false">21‏:46 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa">𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌</char></note> 𐴁𐴡𐴓𐴧𐴝 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴖𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴃𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡𐴁𐴞 𐴔𐴝𐴙𐴕𐴃𐴡.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">𐴁𐴡𐴘𐴌𐴝𐴙𐴃𐴧𐴝 𐴈𐴝𐴥𐴕𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="LUK 14:15-24">𐴓𐴟𐴑 14‏:15‏-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴀𐴠𐴑𐴁𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" /><char style="wj">”𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴁𐴡𐴘𐴌𐴝𐴃𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" /><char style="wj">𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴁𐴡𐴘𐴌𐴝𐴙𐴃𐴧𐴝 𐴈𐴝𐴥𐴕𐴝𐴌 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥,</char><note caller="+" style="f"><char style="fr" closed="false">22‏:3 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴕𐴞 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴠𐴀𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤</char></note> <char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴘𐴃𐴡𐴤 𐴕𐴡𐴥 𐴏𐴝𐴀.</char><verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />
    <char style="wj">”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴒𐴡𐴗𐴀𐴌𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, ’𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, 𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴈𐴝𐴥𐴕𐴝 𐴕𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴘𐴧𐴠; 𐴀𐴝𐴣𐴀𐴌 𐴊𐴡𐴀𐴣𐴌𐴝 𐴒𐴡𐴌𐴟 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴓𐴞 𐴒𐴡𐴌𐴟 𐴎𐴡𐴦𐴌𐴝𐴥𐴘𐴧𐴞, 𐴘𐴝𐴓𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴕𐴝𐴓𐴢. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴡𐴘𐴌𐴝𐴃𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴃𐴢 𐴀𐴝𐴘𐴧𐴡𐴤.‘ </char><verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴥𐴐𐴑𐴝𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴑𐴞𐴘𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴑𐴠𐴥𐴃𐴞𐴃𐴢 𐴀𐴝𐴌 𐴑𐴞𐴘𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴐𐴡𐴥𐴊𐴡𐴌𐴞𐴃𐴢,</char> <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" /><char style="wj">𐴀𐴝𐴦𐴌 𐴁𐴝𐴑𐴞 𐴒𐴟𐴥𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴒𐴡𐴗𐴀𐴌 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴊𐴏𐴡𐴥𐴓𐴧𐴟𐴑 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.</char> <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴁𐴞𐴐𐴞𐴤 𐴌𐴝𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴇𐴠𐴥 𐴑𐴟𐴥𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴐𐴡𐴥𐴀𐴌 𐴉𐴟𐴌𐴝𐴃𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.</char><verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />
    <char style="wj">”𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴁𐴡𐴘𐴌𐴝𐴃𐴡𐴌 𐴈𐴝𐴥𐴕𐴝 𐴃𐴡 𐴕𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴞𐴘𐴝 𐴒𐴞𐴀𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡.</char> <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴌𐴝𐴏𐴃𐴝𐴌 𐴔𐴟𐴀𐴝𐴥𐴣-𐴔𐴟𐴀𐴝𐴥𐴣 𐴎𐴝𐴘 𐴎𐴠𐴃𐴡𐴥 𐴎𐴡𐴕 𐴓𐴡𐴦𐴃𐴢 𐴉𐴡𐴦, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴘𐴌𐴝𐴃𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴌 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴡𐴒𐴡𐴥𐴘.‘</char> <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" /><char style="wj">𐴃𐴡𐴥𐴘 𐴒𐴡𐴗𐴀𐴌 𐴒𐴟𐴥𐴕𐴠 𐴁𐴝𐴀𐴌𐴠 𐴌𐴝𐴏𐴃𐴝𐴃𐴢 𐴎𐴝𐴘 𐴎𐴝𐴌𐴠𐴥-𐴎𐴝𐴌𐴠𐴥 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴒𐴡𐴔 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴡𐴓𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥; 𐴁𐴝𐴦𐴊𐴠 𐴁𐴡𐴘𐴌𐴝𐴙𐴃𐴧𐴝-𐴈𐴝𐴥𐴕𐴝 𐴒𐴝𐴥𐴕 𐴔𐴠𐴀𐴔𐴝𐴕𐴠 𐴉𐴟𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘.</char><verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴘𐴠 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴠𐴀𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴇𐴠𐴥𐴍𐴠 𐴁𐴡𐴘𐴌𐴝𐴙𐴃𐴧𐴝 𐴇𐴡𐴦𐴌 𐴀𐴝𐴉𐴞𐴕𐴊𐴝𐴤 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴠𐴙𐴑𐴧𐴠𐴥.</char> <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ’𐴊𐴟𐴏𐴃𐴡𐴥, 𐴃𐴟𐴀𐴛 𐴁𐴡𐴘𐴌𐴝𐴙𐴃𐴧𐴝 𐴇𐴡𐴦𐴌 𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴍𐴠𐴥 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴒𐴡𐴥𐴙𐴓𐴧𐴡؟‘ 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠.</char><verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴘𐴠 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴞𐴃𐴝𐴌 𐴀𐴝𐴥𐴃𐴢 𐴄𐴠𐴥𐴚 𐴁𐴝𐴣𐴊𐴞𐴥, 𐴀𐴞𐴃𐴝𐴌𐴠𐴤 𐴁𐴝𐴀𐴌𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘 𐴊𐴡𐴒𐴡𐴥𐴘; 𐴇𐴠𐴥𐴍𐴠 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴃𐴠 𐴊𐴝𐴃𐴢 𐴑𐴞𐴌𐴑𐴞𐴌𐴝𐴕𐴞 𐴀𐴡𐴥𐴘𐴁𐴡.‘</char><verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />
    <char style="wj">”𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴋𐴝𐴈𐴝 𐴃𐴡 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴒𐴞𐴘𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴦𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴁𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴖𐴝 𐴒𐴞𐴥𐴘𐴠.“</char><verse eid="MAT 22:14" /></para>
  <para style="s1">𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴊𐴞𐴦𐴘𐴝</para>
  <para style="r">(<ref loc="MRK 12:13-17">𐴔𐴝𐴑 12‏:13‏-17</ref>; <ref loc="LUK 20:20-26">𐴓𐴟𐴑 20‏:20‏-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴘, 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴞𐴦 𐴁𐴡𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴥𐴘 𐴈𐴡𐴓𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴡𐴥𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥𐴒𐴡𐴘. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴠𐴥𐴌𐴟𐴊𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴃𐴟𐴀𐴛 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴏𐴃𐴝𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴡. 𐴃𐴟𐴀𐴛 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴉𐴡𐴌𐴁𐴝 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴕𐴝𐴥𐴘. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴏𐴝𐴘, 𐴃𐴟𐴀𐴛 𐴑𐴞𐴦 𐴁𐴝𐴥𐴉𐴡؟ 𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝<note caller="+" style="f"><char style="fr" closed="false">22‏:17 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑𐴡𐴃𐴢 𐴑𐴝𐴥𐴘𐴏𐴝𐴌 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴝𐴔 𐴕𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴡𐴔 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴓𐴡𐴑𐴡𐴥𐴁𐴢. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠. </char></note>𐴌𐴠 𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴊𐴡𐴦𐴕 𐴎𐴝𐴘𐴠𐴏𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴕𐴝𐴥𐴘؟“<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴃𐴝𐴌𐴝𐴥𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴕𐴞𐴘𐴡𐴃𐴡𐴌𐴠 𐴎𐴝𐴕𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴡𐴤𐴌 𐴑𐴞𐴘𐴝𐴥؟</char> <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" /><char style="wj">𐴇𐴝𐴥𐴎𐴝𐴕𐴝 𐴊𐴠𐴦 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴡𐴘𐴐𐴝𐴤 𐴊𐴝𐴈𐴡𐴥.“</char> 𐴃𐴡𐴥𐴘 𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴞𐴕𐴝𐴥𐴌 𐴀𐴝𐴕𐴞𐴤 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴘𐴝𐴀𐴕 𐴇𐴝𐴌 𐴏𐴡𐴥𐴁𐴞 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴌 𐴕𐴝𐴔؟“</char><verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />𐴃𐴝𐴌𐴝𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴡𐴔𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌.“</para>
  <para style="p" vid="MAT 22:21">𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴎𐴞𐴀𐴕 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴡, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴊𐴞𐴦𐴘𐴡.“</char><verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴃𐴝𐴌𐴝𐴥 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴌𐴞 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="MAT 22:22" /></para>
  <para style="s1">𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 12:18-27">𐴔𐴝𐴑 12‏:18‏-27</ref>; <ref loc="LUK 20:27-40">𐴓𐴟𐴑 20‏:27‏-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴝𐴥𐴣𐴐𐴡𐴌 𐴕𐴝𐴥𐴘 𐴈𐴡𐴀, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴔𐴟𐴀𐴏𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ’𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴉𐴟𐴀𐴝𐴙𐴕 𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴌𐴞𐴎𐴝𐴒𐴡𐴥𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴝𐴥𐴘𐴡𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴡𐴖𐴢 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴓𐴧𐴝 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.‘ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />𐴊𐴡𐴥𐴌𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴝𐴥𐴣𐴃𐴢 𐴎𐴡𐴕 𐴁𐴝𐴥𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴉𐴡𐴀𐴘𐴓𐴝 𐴖𐴝𐴘𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴏𐴝𐴥𐴌𐴝 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴁𐴝𐴥𐴘𐴡𐴓𐴧𐴝 𐴌𐴝𐴑𐴞𐴥𐴒𐴞𐴘𐴡𐴘. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴊𐴟𐴏𐴝𐴥𐴌𐴝, 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴁𐴧𐴠 𐴇𐴝𐴥𐴣𐴃𐴡 𐴁𐴝𐴥𐴘 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />𐴀𐴝𐴇𐴠𐴥𐴌𐴞𐴃𐴢, 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝 𐴘𐴡𐴥 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴇𐴝𐴓𐴠 𐴇𐴞𐴥𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴣𐴃𐴡 𐴎𐴡𐴕𐴡𐴃𐴧𐴟 𐴇𐴝𐴌 𐴁𐴡𐴖𐴢 𐴀𐴡𐴥𐴘𐴁𐴡؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.“<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴏𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴕𐴡 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴎𐴝𐴕𐴡.</char> <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴇𐴝𐴥𐴓𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴡 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴊𐴞𐴥𐴘𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" /><char style="wj">𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴕𐴡𐴥 𐴉𐴡𐴌𐴡𐴥, </char> <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" /><char style="wj">’𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑𐴡𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴀𐴝𐴓𐴧𐴝‘؟</char><note caller="+" style="f"><char style="fr" closed="false">22‏:32 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 3‏:6</ref></char></char></note> <char style="wj">𐴀𐴝𐴓𐴧𐴝 𐴃𐴡 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴥𐴕𐴝.“</char><verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥 𐴃𐴝𐴦𐴓𐴞𐴔𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MAT 22:33" /></para>
  <para style="s1">𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔</para>
  <para style="r">(<ref loc="MRK 12:28-34">𐴔𐴝𐴑 12‏:28‏-34</ref>; <ref loc="LUK 10:25-28">𐴓𐴟𐴑 10‏:25‏-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴏𐴝𐴊𐴟𐴑𐴝𐴥𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴞𐴎𐴝𐴥𐴔 𐴔𐴝𐴥𐴌𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴝𐴓𐴠𐴔𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />”𐴀𐴟𐴏𐴃𐴝𐴃𐴢, 𐴃𐴡𐴌𐴝𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴃𐴢 𐴇𐴡𐴥𐴑𐴟𐴔 𐴇𐴡𐴕 𐴕𐴝𐴥𐴕 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌؟“<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">” ’𐴔𐴝𐴁𐴟𐴊𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴌𐴝 𐴊𐴞𐴓𐴠, 𐴉𐴟𐴌𐴝 𐴎𐴝𐴕𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴌𐴝 𐴊𐴠𐴔𐴝𐴑𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘</char><note caller="+" style="f"><char style="fr" closed="false">22‏:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:5">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 6‏:5</ref></char></char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" /><char style="wj">𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴁𐴧𐴠 𐴎𐴡𐴌𐴟𐴌𐴞 𐴇𐴡𐴥𐴑𐴟𐴔. </char> <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" /><char style="wj">𐴀𐴠𐴁𐴧𐴠 𐴎𐴡𐴌𐴟𐴌𐴞 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴟𐴘 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴌 𐴒𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, ’𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.‘</char><note caller="+" style="f"><char style="fr" closed="false">22‏:39 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 19‏:18</ref></char></char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" /><char style="wj">𐴇𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴉𐴟𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴄𐴑𐴝𐴘𐴧𐴝.“</char><verse eid="MAT 22:40" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 12:35-37">𐴔𐴝𐴑 12‏:35‏-37</ref>; <ref loc="LUK 20:41-44">𐴓𐴟𐴑 20‏:41‏-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴒𐴟𐴥𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" /><char style="wj">”𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴎𐴝𐴥 𐴑𐴞𐴦؟ 𐴀𐴞𐴥𐴁𐴝 𐴇𐴝𐴌 𐴉𐴟𐴖𐴝؟“</char></para>
  <para style="p" vid="MAT 22:42">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝.“<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴊𐴝𐴖𐴟𐴊𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴠 ’𐴔𐴝𐴓𐴞𐴑‘ 𐴋𐴝𐴙𐴑𐴧𐴠𐴥؟ 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥, </char><verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />
    <char style="wj">’𐴔𐴝𐴁𐴟𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠,</char></para>
  <para style="q2" vid="MAT 22:44">
    <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴡𐴘𐴧𐴡𐴥,</char></para>
  <para style="q1" vid="MAT 22:44">
    <char style="wj">𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠</char></para>
  <para style="q2" vid="MAT 22:44">
    <char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴡𐴦𐴌 𐴃𐴡𐴓𐴠 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴠𐴓𐴝𐴘.“ ‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">22‏:44 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 110:1">𐴎𐴡𐴁𐴟𐴌 110‏:1</ref>
        </char>
      </char>
    </note><verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />
    <char style="wj">𐴃𐴡𐴥𐴘 𐴊𐴝𐴖𐴟𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 ’𐴔𐴝𐴓𐴞𐴑‘ 𐴋𐴝𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠𐴥؟“</char> <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴈𐴡𐴀𐴌 𐴀𐴡𐴥 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴌 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="r">(<ref loc="MRK 12:38-40">𐴔𐴝𐴑 12‏:38‏-40</ref>; <ref loc="LUK 11:37-52">𐴓𐴟𐴑 11‏:37‏-52</ref>; <ref loc="LUK 20:45-47">20‏:45‏-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" /><char style="wj">”𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴁𐴟𐴎𐴝𐴥𐴘𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴟𐴀𐴏𐴝𐴌 𐴎𐴝𐴒𐴝𐴃𐴢.</char> <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴞𐴀𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴈𐴡𐴀, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴙𐴕𐴧𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴈𐴡𐴀 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴕𐴞𐴎𐴠 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴡𐴥𐴌-𐴁𐴡𐴥𐴌 𐴉𐴟𐴣𐴎𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴣𐴊𐴞𐴥 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴈𐴝𐴣𐴊𐴡𐴌 𐴖𐴡𐴌𐴠 𐴃𐴟𐴓𐴞𐴤 𐴊𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴓𐴝𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴡𐴦𐴣𐴓𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴊𐴞𐴃𐴡 𐴕𐴡 𐴏𐴝𐴀.</char><verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />
    <char style="wj">”𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴀𐴝𐴘𐴝𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴃𐴝𐴁𐴞𐴏𐴡𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴞 𐴁𐴝𐴕𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴐𐴝𐴥𐴑𐴡𐴌 𐴇𐴝𐴣𐴌𐴝𐴌 𐴊𐴡𐴀𐴘𐴢 𐴓𐴝𐴔𐴁𐴝 𐴒𐴡𐴌𐴠𐴥.</char> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴠𐴓𐴝-𐴐𐴡𐴥𐴁𐴝𐴃𐴢 𐴁𐴝𐴌𐴞𐴥𐴑 𐴎𐴝𐴒𐴝 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴟𐴣𐴏𐴡𐴓𐴢 𐴃𐴡𐴑𐴧𐴝𐴌 𐴇𐴝𐴊𐴞𐴌𐴝𐴤𐴃𐴢 𐴁𐴡𐴘𐴃𐴡𐴥 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴌𐴠𐴥, </char> <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌𐴡𐴤, 𐴁𐴝𐴎𐴝𐴌𐴠-𐴁𐴝𐴎𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴉𐴝𐴘𐴃𐴡, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 ’𐴌𐴝𐴁𐴧𐴞𐴥, 𐴌𐴝𐴁𐴧𐴞𐴥‘ 𐴈𐴡𐴀𐴘𐴢 𐴋𐴝𐴑𐴞𐴓𐴠𐴥 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴌𐴠𐴥.</char><verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 ’𐴌𐴝𐴁𐴧𐴞𐴥‘ 𐴋𐴝𐴈𐴝 𐴕𐴡 𐴁𐴝𐴘𐴧𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴃𐴡 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴠𐴥𐴕𐴝, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴁𐴝𐴥𐴘 𐴁𐴝𐴥𐴘.</char> <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" /><char style="wj">𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴁𐴝𐴉𐴢 𐴕𐴡 𐴋𐴝𐴑𐴞𐴘𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴃𐴡 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴀𐴠𐴥𐴕𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.</char> <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 ’𐴏𐴡𐴥𐴊𐴧𐴝𐴌‘ 𐴋𐴝𐴈𐴝 𐴕𐴡 𐴁𐴝𐴘𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴃𐴡 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴀𐴠𐴥𐴕𐴝, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤.</char> <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴁𐴡𐴕𐴡𐴗𐴑.</char> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴥𐴖𐴝𐴓𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴐𐴡𐴥𐴣𐴍𐴡 𐴑𐴟𐴥𐴖𐴝𐴓𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡.</char><verse eid="MAT 23:12" /></para>
  <para style="s1">𐴀𐴝𐴓𐴠𐴔 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />
    <char style="wj">”𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴕𐴡 𐴒𐴡𐴥𐴓𐴡 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴃𐴡 𐴏𐴝𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴒𐴡𐴥𐴙𐴓𐴃𐴡 𐴕𐴡 𐴊𐴡.</char> <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" /><char style="wj">𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴑 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴡𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴟𐴄𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴀𐴝𐴌𐴀𐴠𐴑 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝 𐴓𐴝𐴔𐴁𐴝-𐴓𐴝𐴔𐴁𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴝𐴥𐴣𐴎𐴝 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴣𐴀𐴌 𐴉𐴝𐴘𐴁𐴝. </char><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />
    <char style="wj">”𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴡𐴥𐴌𐴔𐴡𐴃𐴢 𐴀𐴝𐴕𐴞𐴤 𐴁𐴡𐴓𐴧𐴝 𐴊𐴡𐴙𐴅𐴧𐴝-𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴎𐴝𐴒𐴝-𐴎𐴝𐴒𐴝 𐴓𐴝𐴔𐴁𐴝 𐴏𐴡𐴉𐴡𐴥𐴌 𐴒𐴡𐴌𐴡𐴤; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴝𐴕𐴞𐴤 𐴉𐴝𐴌𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴊𐴟𐴘 𐴒𐴟𐴕 𐴎𐴟𐴎𐴟𐴑𐴞 𐴁𐴝𐴕𐴡.</char><verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />
    <char style="wj">”𐴀𐴡𐴥 𐴀𐴝𐴣𐴊𐴝𐴤 𐴉𐴡𐴣𐴃𐴢 𐴊𐴝𐴈𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴀 𐴊𐴠, ’𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘𐴓𐴠, 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴐𐴟𐴥𐴕𐴝𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘𐴓𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.‘ </char> <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" /><char style="wj">𐴀𐴡𐴥 𐴁𐴠𐴑𐴟𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢! 𐴇𐴡𐴕 𐴕𐴝𐴥𐴕 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴣𐴀𐴌, 𐴐𐴟𐴥𐴕𐴝 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴐𐴟𐴥𐴕𐴝𐴌𐴠 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏؟</char> <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴈𐴡𐴀 𐴊𐴠 𐴑𐴞, ’𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘𐴓𐴠, 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘𐴓𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.‘</char> <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" /><char style="wj">𐴀𐴡𐴥 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢! 𐴇𐴡𐴕 𐴕𐴝𐴥𐴕 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴣𐴀𐴌, 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴕𐴠 𐴕𐴝𐴥𐴑𐴞 𐴑𐴟𐴌𐴁𐴝𐴕𐴞𐴌𐴠 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣؟</char> <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴠 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥.</char> <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴠 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥.</char> <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴁𐴝𐴤 𐴁𐴡𐴘𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴠 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥.</char><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />
    <char style="wj">”𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴉𐴟𐴊𐴞𐴕𐴝𐴌, 𐴔𐴝𐴏𐴧𐴖𐴝𐴤 𐴁𐴝𐴇𐴡𐴥𐴌 𐴀𐴡𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴌𐴝𐴌 𐴊𐴡𐴐𐴢 𐴁𐴝𐴥𐴑𐴡𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴑 𐴊𐴡𐴦, 𐴓𐴠𐴑𐴞𐴕 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴡𐴌</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">23‏:23 </char>
      <char style="ft" closed="false">𐴔𐴝𐴀𐴕𐴞 </char>
      <char style="fqa" closed="false">𐴃𐴡𐴌𐴝𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴢 𐴘𐴝𐴥𐴃𐴡 𐴔𐴟𐴀𐴏𐴝𐴌 𐴃𐴡𐴌𐴝𐴃𐴢</char>
    </note> <char style="wj">𐴁𐴞𐴐𐴞𐴤 𐴊𐴝𐴔𐴞 𐴈𐴡𐴃𐴝𐴤 𐴌𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢, 𐴌𐴝𐴇𐴝𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴊𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴀𐴕 𐴀𐴡𐴥 𐴒𐴡𐴌𐴡𐴤𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴀𐴟𐴀𐴙𐴕 𐴀𐴡𐴥 𐴁𐴝𐴊𐴢 𐴕𐴡 𐴊𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.</char> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴣𐴊𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴉𐴡𐴣𐴃𐴢 𐴊𐴝𐴈𐴡𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴏𐴞𐴥𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴏𐴝𐴥𐴘𐴧𐴡𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴟𐴣𐴄𐴢 𐴒𐴞𐴓𐴞𐴉𐴠𐴥𐴓𐴡.</char><verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />
    <char style="wj">”𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴉𐴞𐴘𐴝𐴓𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴥𐴓𐴁𐴝𐴏𐴡𐴕𐴡𐴌 𐴁𐴝𐴀𐴌𐴋𐴝𐴥𐴑 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴓𐴏𐴞𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴘𐴧𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝.</char> <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" /><char style="wj">𐴀𐴡𐴥 𐴀𐴝𐴣𐴊𐴝𐴤 𐴉𐴠𐴥𐴌𐴡𐴐𐴞! 𐴀𐴝𐴒𐴠 𐴉𐴞𐴘𐴝𐴓𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴥𐴓𐴁𐴝𐴏𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴡𐴌 𐴋𐴝𐴥𐴑 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴃𐴡𐴥𐴘 𐴁𐴝𐴀𐴌𐴋𐴝𐴥𐴑 𐴀𐴡𐴥 𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.</char><verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />
    <char style="wj">”𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴊𐴡𐴥𐴓𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴀𐴃𐴧𐴟 𐴏𐴝𐴘𐴃𐴠𐴥 𐴊𐴠 𐴐𐴟𐴥𐴕𐴊𐴡𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴡𐴌𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴀𐴝𐴥𐴣𐴋𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴇𐴡𐴣𐴏𐴝𐴌𐴝 𐴓𐴡𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝.</char> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡𐴥, 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴁𐴝𐴀𐴃𐴧𐴟 𐴏𐴝𐴘𐴃𐴠𐴥 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴊𐴠𐴑𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑𐴞 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴈𐴝𐴔𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝.</char><verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />
    <char style="wj">”𐴀𐴡𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴡𐴁𐴡𐴌𐴡𐴌𐴠 𐴁𐴝𐴕𐴝𐴘𐴃𐴟𐴓𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴡𐴁𐴡𐴌𐴡𐴌𐴠 𐴇𐴝𐴥𐴣𐴎𐴡.</char> <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" /><char style="wj">𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴀 𐴊𐴠, ’𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴝𐴔, 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴟𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴐𐴡𐴥𐴌𐴞𐴑 𐴕𐴡 𐴀𐴡𐴥𐴘𐴃𐴝𐴔.‘ </char> <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" /><char style="wj">𐴇𐴠𐴥𐴀𐴕𐴒𐴡𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴡𐴥 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴟𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕.</char> <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" /><char style="wj">𐴘𐴝𐴓𐴝 𐴎𐴡𐴦, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴞𐴀𐴕 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴌𐴟𐴏𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡𐴒𐴡𐴘.</char><verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />
    <char style="wj">”𐴀𐴡𐴥 𐴇𐴝𐴥𐴉𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴇𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢! 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴟𐴎𐴟𐴑𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴧𐴟 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴇𐴝𐴥𐴌𐴞𐴁𐴝؟</char> <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴉𐴟𐴥𐴕𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴡𐴁𐴞, 𐴒𐴞𐴘𐴝𐴕𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴑𐴟𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢-𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴐𐴡𐴀𐴣𐴑 𐴔𐴝𐴌𐴞𐴁𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴐𐴡𐴥𐴀𐴌𐴠-𐴐𐴡𐴥𐴀𐴌𐴠 𐴓𐴡𐴌𐴝𐴘𐴁𐴝𐴥.</char> <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴠𐴊𐴟𐴥𐴕 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴑𐴟𐴥𐴕 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴘𐴁𐴝 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝, 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴝𐴁𐴠𐴓𐴡𐴌 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴁𐴠𐴌𐴠𐴑𐴝𐴘𐴧𐴡𐴏𐴡𐴌 𐴉𐴟𐴖𐴝 𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝𐴌 𐴓𐴡𐴖𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴔𐴝𐴎𐴠𐴥𐴔𐴝𐴙𐴅𐴧𐴝 𐴑𐴟𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝.</char> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴠 𐴕𐴡𐴏𐴡𐴥𐴓𐴢.</char><verse eid="MAT 23:36" /></para>
  <para style="s1">𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢</para>
  <para style="r">(<ref loc="LUK 13:34-35">𐴓𐴟𐴑 13‏:34‏-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />
    <char style="wj">”𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔, 𐴀𐴡𐴥 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔, 𐴃𐴟𐴘 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴡𐴃𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴡𐴤𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴃𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴐𐴞𐴥𐴓𐴡𐴌 𐴊𐴡𐴓𐴝 𐴔𐴝𐴌𐴡𐴏𐴢. 𐴑𐴟𐴀𐴣𐴌𐴞-𐴑𐴟𐴌𐴝𐴤𐴘𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴏𐴡𐴥𐴀 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴞𐴥𐴁𐴝𐴌 𐴉𐴝𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴇𐴡𐴃𐴡𐴥 𐴁𐴝𐴌 𐴏𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡𐴥 𐴏𐴡𐴀.</char> <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" /><char style="wj">𐴉𐴟𐴥𐴕𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴡𐴥𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴟𐴑𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴏𐴝𐴥𐴌𐴝𐴒𐴡𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.</char> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴡𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴀𐴝𐴌 𐴕𐴡 𐴊𐴠𐴑𐴞𐴥𐴁𐴝 𐴎𐴠𐴃𐴡𐴥𐴑𐴧𐴝𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡𐴥 𐴈𐴡𐴀 𐴊𐴠, ’𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.‘ “</char><note caller="+" style="f"><char style="fr" closed="false">23‏:39 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:26">𐴎𐴡𐴁𐴟𐴌 118‏:26</ref></char></char></note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴖𐴝𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="r">(<ref loc="MRK 13:1-2">𐴔𐴝𐴑 13‏:1‏-2</ref>; <ref loc="LUK 21:5-6">𐴓𐴟𐴑 21‏:5‏-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴎𐴝𐴦𐴌𐴒𐴡𐴥𐴘, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴁𐴞𐴓𐴧𐴞𐴥𐴚 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴊𐴠𐴑𐴡𐴥𐴌 𐴕𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠𐴍𐴠𐴥 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴇𐴞𐴥𐴀𐴕 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴒𐴗𐴝𐴥𐴌𐴠 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="MAT 24:2" /></para>
  <para style="s1">𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴀𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 13:3-13">𐴔𐴝𐴑 13‏:3‏-13</ref>; <ref loc="LUK 21:7-19">𐴓𐴟𐴑 21‏:7‏-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />𐴀𐴞𐴏𐴝𐴤 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴊𐴧𐴡𐴕𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴕𐴝, 𐴇𐴞𐴥𐴀𐴕 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠𐴥؟ 𐴃𐴟𐴀𐴛 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴡؟“ <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴝𐴘𐴧𐴡𐴥, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴎𐴠𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴕𐴡 𐴓𐴡𐴘𐴎𐴝.</char> <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤,‘ 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴁𐴡𐴥𐴘.</char> <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" /><char style="wj">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴝𐴌𐴝𐴥𐴙𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴌𐴝𐴥𐴙𐴌 𐴈𐴡𐴥𐴁𐴡𐴌𐴝-𐴈𐴡𐴥𐴁𐴡𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴥𐴕𐴞𐴁𐴝; 𐴇𐴡𐴥𐴁𐴡𐴌𐴡𐴊𐴧𐴝𐴌, 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴁𐴝𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴖𐴝𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴘𐴡𐴥 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴕𐴡.</char> <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" /><char style="wj">𐴀𐴠𐴑 𐴑𐴡𐴗𐴔𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴑𐴡𐴗𐴔𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑 𐴌𐴝𐴙𐴅𐴧𐴡𐴘𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴃𐴞𐴥𐴘𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴎𐴝𐴒𐴝-𐴎𐴝𐴒𐴝 𐴌𐴝𐴄𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢, 𐴉𐴟𐴖𐴝 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴐𐴟𐴥𐴌𐴟𐴌 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝.</char><verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />
    <char style="wj">”𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴡𐴑𐴡𐴓𐴞𐴉𐴢 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡; 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴉𐴞𐴏𐴧𐴝𐴥 𐴔𐴝𐴌𐴞𐴁𐴡𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char> <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" /><char style="wj">𐴀𐴝𐴦𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴟𐴍𐴞𐴤, 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴁𐴡𐴥𐴘.</char> <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" /><char style="wj">𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴌𐴞𐴥𐴎𐴝𐴘𐴁𐴡𐴘 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴁𐴠𐴦𐴐𐴢 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴈𐴡𐴔𐴞 𐴎𐴝𐴘𐴁𐴡𐴘.</char> <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" /><char style="wj">𐴀𐴝𐴦𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴁𐴝𐴤 𐴀𐴡𐴥 𐴉𐴝𐴥𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡, 𐴃𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠 𐴁𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴘𐴁𐴡𐴤.</char><verse eid="MAT 24:14" /></para>
  <para style="s1">𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢</para>
  <para style="r">(<ref loc="MRK 13:14-23">𐴔𐴝𐴑 13‏:14‏-23</ref>; <ref loc="LUK 21:20-24">𐴓𐴟𐴑 21‏:20‏-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />
    <char style="wj">”𐴋𐴝𐴥𐴕𐴞𐴘𐴠𐴓𐴢 𐴕𐴡𐴁𐴞𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴇𐴡𐴥𐴃𐴝𐴌𐴝 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴠𐴥,</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24‏:15 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="DAN 9:27">𐴋𐴝𐴥𐴕𐴞𐴘𐴠𐴓𐴢 9‏:27</ref>; <ref loc="DAN 11:31">11‏:31</ref>; <ref loc="DAN 12:11">12‏:11</ref></char>
      </char>
    </note> <char style="wj">𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴂𐴝𐴑 𐴎𐴝𐴒𐴝𐴃𐴢 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴊𐴠𐴑𐴞𐴥𐴁𐴝—𐴉𐴡𐴌𐴡𐴥𐴘𐴝𐴘𐴠 𐴁𐴟𐴎𐴡𐴥— </char> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴊𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴊𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴡𐴦𐴘𐴢 𐴁𐴡𐴓𐴧𐴝 𐴓𐴝𐴔𐴝𐴃𐴢 𐴕𐴡 𐴓𐴝𐴔𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" /><char style="wj">𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴠𐴥𐴃𐴞𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴊𐴧𐴡𐴌 𐴓𐴡𐴦𐴘𐴢 𐴁𐴡𐴓𐴧𐴝 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴕𐴟 𐴀𐴝𐴀 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴇𐴝𐴥𐴔𐴞𐴓𐴢 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴊𐴡𐴌 𐴔𐴝𐴦 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡. </char> <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" /><char style="wj">𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴐𐴞𐴥𐴃𐴑𐴝𐴓𐴠 𐴘𐴝𐴥 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴊𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴕𐴡 𐴉𐴡𐴌𐴠.</char> <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴠𐴃𐴧𐴡𐴥𐴌 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴁𐴝𐴌 𐴕𐴡 𐴘𐴡𐴥 𐴀𐴡𐴥𐴘𐴁𐴡.</char><verse eid="MAT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 24:22" />
    <char style="wj">”𐴎𐴡𐴊𐴞 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴔𐴝𐴘𐴊𐴞𐴘𐴝 𐴕𐴡 𐴎𐴝𐴘𐴃𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴁𐴝𐴏𐴞𐴃𐴡𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴊𐴞𐴕 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴔𐴝𐴘𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀, ’𐴏𐴡𐴀, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴠𐴍𐴠𐴥 𐴀𐴝𐴏𐴠𐴤!‘ 𐴘𐴝𐴥𐴃𐴡 ’𐴀𐴟𐴍𐴠𐴤 𐴀𐴝𐴏𐴠𐴤!‘ 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴑𐴞𐴕 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char> <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴞𐴏𐴝𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴟𐴍𐴞𐴤𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴓𐴧𐴝𐴘𐴞-𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝 𐴇𐴝𐴌𐴇𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴈𐴝𐴤𐴘𐴁𐴡, 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝, 𐴉𐴝𐴌𐴞𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝.</char> <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" /><char style="wj">𐴏𐴝𐴘𐴧𐴡𐴥, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴈𐴡𐴀𐴘𐴊𐴞𐴘𐴞.</char><verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴡𐴊𐴞 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀, ’𐴏𐴡𐴀, 𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤!‘ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴀𐴌𐴠 𐴕𐴡 𐴕𐴠𐴦𐴙𐴓𐴧𐴡, 𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀, ’𐴏𐴡𐴀, 𐴀𐴞𐴥𐴁𐴝 𐴁𐴟𐴥𐴃𐴡𐴌𐴡𐴌 𐴑𐴝𐴔𐴝𐴥𐴌𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤!‘ 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴑𐴞𐴕 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.</char> <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴑𐴡𐴃𐴧𐴟 𐴁𐴞𐴅𐴞𐴓𐴞 𐴏𐴡𐴔𐴑𐴞𐴓𐴠𐴥 𐴉𐴡𐴏𐴞𐴥𐴔 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴉𐴡𐴀𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴀𐴝𐴀 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" /><char style="wj">𐴔𐴡𐴌𐴝 𐴓𐴝𐴐𐴢 𐴎𐴠𐴍𐴠𐴥, 𐴇𐴠𐴥𐴍𐴠 𐴃𐴡 𐴇𐴡𐴥𐴖𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴁𐴡.</char><verse eid="MAT 24:28" /></para>
  <para style="s1">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴀𐴝𐴀</para>
  <para style="r">(<ref loc="MRK 13:24-27">𐴔𐴝𐴑 13‏:24‏-27</ref>; <ref loc="LUK 21:25-28">𐴓𐴟𐴑 21‏:25‏-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴉𐴟𐴥𐴌𐴝𐴘 𐴔𐴡𐴃𐴧𐴡𐴌</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">𐴁𐴠𐴙𐴓𐴢 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘,</char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴏𐴝𐴕𐴠 𐴉𐴡𐴀𐴌 𐴕𐴡 𐴊𐴞𐴁𐴡;</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴌𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘,</char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡𐴥𐴃𐴧𐴡𐴌𐴝𐴘𐴁𐴡.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24‏:29 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 13:10">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 13‏:10</ref>; <ref loc="ISA 34:4">34‏:4</ref></char>
      </char>
    </note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />
    <char style="wj">”𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝𐴘𐴁𐴡, 𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴠𐴑𐴞𐴥𐴁𐴡 𐴊𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24‏:30 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="DAN 7:13-14">𐴋𐴝𐴥𐴕𐴞𐴘𐴠𐴓𐴢 7‏:13‏-14</ref>
        </char>.</char>
    </note> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴐𐴞𐴥𐴛𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴊𐴞𐴘𐴝𐴁𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴠𐴑 𐴔𐴝𐴃𐴝𐴥𐴃𐴧𐴟 𐴀𐴝𐴌𐴀𐴠𐴑 𐴔𐴝𐴃𐴝𐴥 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴎𐴝𐴘 𐴏𐴝𐴘𐴌𐴡𐴥𐴔𐴞𐴑𐴧𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</char><verse eid="MAT 24:31" /></para>
  <para style="s1">𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴃𐴧𐴟 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="MRK 13:28-31">𐴔𐴝𐴑 13‏:28‏-31</ref>; <ref loc="LUK 21:29-33">𐴓𐴟𐴑 21‏:29‏-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />
    <char style="wj">”𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴃𐴧𐴟 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴡𐴦: 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴌 𐴋𐴠𐴥𐴀𐴘𐴓𐴝 𐴇𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴘 𐴉𐴝𐴃𐴝 𐴕𐴠𐴦𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴞𐴎𐴡𐴒𐴡𐴥𐴘 𐴊𐴠, 𐴇𐴡𐴥𐴌𐴝𐴕 𐴋𐴝𐴥𐴑𐴠.</char> <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴁𐴟𐴎𐴞𐴥𐴁𐴝 𐴊𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴋𐴝𐴥𐴑𐴠, 𐴀𐴠𐴁𐴧𐴠 𐴊𐴡𐴌𐴡𐴎𐴝𐴃𐴢.</char> <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴟𐴌𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴠 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡 𐴉𐴟𐴥𐴌𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" /><char style="wj">𐴀𐴝𐴏𐴔𐴝𐴕 𐴎𐴡𐴁𐴞𐴕 𐴃𐴡 𐴎𐴝𐴌𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.</char><verse eid="MAT 24:35" /></para>
  <para style="s1">𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠 𐴊𐴠 𐴊𐴞𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴑𐴃𐴡𐴥</para>
  <para style="r">(<ref loc="MRK 13:32-37">𐴔𐴝𐴑 13‏:32‏-37</ref>; <ref loc="LUK 17:26-30">𐴓𐴟𐴑 17‏:26‏-30</ref>‏,<ref loc="LUK 17:34-36">34‏-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />
    <char style="wj">”𐴓𐴠𐴑𐴞𐴕 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴖𐴝𐴘𐴠 𐴘𐴡𐴥 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴁𐴝𐴉𐴠 𐴁𐴠 𐴎𐴝𐴕𐴠.</char> <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" /><char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡𐴁𐴞 𐴕𐴟𐴌 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴡𐴥𐴀𐴙𐴓𐴢.</char> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" /><char style="wj">𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴃𐴟𐴖𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠, 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴕𐴟 𐴑𐴞𐴐𐴄𐴞𐴃𐴢 𐴕𐴡𐴥 𐴀𐴟𐴍𐴠𐴤 𐴇𐴠𐴥𐴃𐴡𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢, 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴠𐴊𐴧𐴠, 𐴁𐴞𐴘𐴝𐴥 𐴊𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢,</char> <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" /><char style="wj">𐴀𐴝𐴦𐴌 𐴃𐴟𐴖𐴝𐴥𐴕 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴝𐴥𐴐𐴝𐴘 𐴕𐴡𐴥 𐴓𐴡𐴘𐴎𐴝 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴇𐴡𐴘 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥𐴘𐴁𐴡.</char> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" /><char style="wj">𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴞𐴓𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴓𐴡𐴘𐴎𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" /><char style="wj">𐴊𐴟𐴖𐴝𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴀𐴠𐴑𐴧𐴟 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴏𐴝𐴑𐴧𐴞 𐴒𐴟𐴥𐴌𐴝𐴘𐴁𐴡 𐴊𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴓𐴡𐴘𐴎𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴁𐴝𐴊𐴢 𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />
    <char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴇𐴡𐴕 𐴊𐴞𐴕 𐴀𐴝𐴘𐴁𐴡𐴤.</char> <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴞𐴓𐴡 𐴊𐴠 𐴑𐴞, 𐴎𐴡𐴊𐴞 𐴒𐴡𐴥𐴌𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴏𐴟𐴌 𐴌𐴝𐴙𐴃𐴧𐴝 𐴇𐴡𐴃𐴟𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴎𐴝𐴕𐴞𐴃𐴡𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴌𐴠 𐴁𐴝𐴥𐴚𐴒𐴞𐴃𐴡 𐴕𐴡 𐴊𐴞𐴃𐴡.</char> <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴃𐴡𐴘𐴧𐴝𐴌 𐴃𐴝𐴥𐴑𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴄𐴝𐴥𐴀𐴌𐴡 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴠 𐴀𐴝𐴘𐴁𐴡𐴤.</char><verse eid="MAT 24:44" /></para>
  <para style="s1">𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴒𐴡𐴗𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴔𐴝𐴕 𐴒𐴡𐴗𐴀𐴌</para>
  <para style="r">(<ref loc="LUK 12:41-48">𐴓𐴟𐴑 12‏:41‏-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />
    <char style="wj">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴠𐴀𐴕 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴊𐴧𐴞𐴥𐴔𐴝𐴕 𐴒𐴡𐴗𐴀𐴌 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴝𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴄𐴝𐴙𐴔𐴡𐴌 𐴖𐴡𐴌𐴠 𐴈𐴝𐴥𐴕𐴝 𐴊𐴞𐴦 𐴁𐴡𐴓𐴧𐴝؟</char> <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" /><char style="wj">𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴒𐴡𐴗𐴀𐴌 𐴀𐴟𐴁𐴝𐴤 𐴎𐴝𐴌𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴘𐴓𐴠𐴤 𐴈𐴝𐴔 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴓𐴡𐴦𐴃𐴉𐴝.</char> <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴁𐴡𐴥.</char> <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴎𐴡𐴊𐴞 𐴇𐴠𐴥 𐴒𐴡𐴗𐴀𐴌𐴒𐴗𐴝𐴥 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀, ’𐴀𐴝𐴣𐴀𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴝𐴘𐴃𐴠𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴊𐴠𐴌𐴞 𐴀𐴝𐴏𐴠𐴤,‘</char> <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴌𐴝𐴃𐴢 𐴊𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴐𐴝𐴥𐴑𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴌𐴠𐴥,</char> <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" /><char style="wj">𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴠𐴥 𐴒𐴡𐴗𐴀𐴌 𐴒𐴗𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴠𐴀𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴎𐴠 𐴊𐴞𐴕 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴕𐴡 𐴄𐴝𐴥𐴀𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴀𐴕 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴎𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴃𐴠 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.</char> <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" /><char style="wj">𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴝𐴍𐴞 𐴇𐴝𐴥𐴕-𐴇𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡; 𐴇𐴠𐴥𐴍𐴠 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴃𐴠 𐴊𐴝𐴃𐴢 𐴑𐴞𐴌𐴑𐴞𐴌𐴝𐴕𐴞 𐴀𐴡𐴥𐴘𐴁𐴡.</char><verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">𐴊𐴡𐴐𐴢 𐴎𐴡𐴕 𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />
    <char style="wj">”𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴡𐴐𐴢 𐴎𐴡𐴕 𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴏𐴠𐴌𐴝𐴑 𐴓𐴡𐴦𐴘𐴢 𐴊𐴟𐴓𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴃𐴡 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥.</char> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" /><char style="wj">𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴝𐴣𐴏𐴢 𐴎𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴁𐴠𐴑𐴟𐴉𐴢, 𐴀𐴝𐴦𐴌 𐴉𐴝𐴣𐴏𐴢 𐴎𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴏𐴝𐴓𐴝𐴥𐴑.</char> <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" /><char style="wj">𐴁𐴠𐴑𐴟𐴉𐴢 𐴉𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴠𐴌𐴝𐴑 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴓𐴠𐴑𐴞𐴕 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴝𐴃𐴧𐴞𐴥 𐴃𐴠𐴓𐴢 𐴕𐴡𐴥 𐴓𐴡𐴘𐴎𐴝;</char> <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴝𐴓𐴝𐴥𐴑 𐴑𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴠𐴌𐴝𐴑𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴉𐴡𐴍𐴡𐴃𐴢 𐴒𐴡𐴌𐴞 𐴁𐴝𐴃𐴧𐴞𐴥 𐴃𐴠𐴓𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥.</char> <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" /><char style="wj">𐴊𐴟𐴓𐴝𐴤 𐴀𐴝𐴘𐴃𐴠𐴤 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴊𐴠𐴌𐴞 𐴀𐴡𐴥𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴎𐴟𐴥𐴌𐴞-𐴎𐴟𐴥𐴌𐴞 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘.</char><verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />
    <char style="wj">”𐴀𐴝𐴊𐴝𐴤 𐴌𐴝𐴙𐴃𐴧𐴝 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴟𐴎𐴡𐴌 𐴉𐴟𐴥𐴕𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, ’𐴏𐴡𐴀, 𐴊𐴟𐴓𐴝𐴤 𐴀𐴝𐴘𐴧𐴠𐴤𐴌; 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴃𐴡 𐴕𐴠𐴦𐴓𐴡.‘</char><verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴟𐴍𐴞𐴤 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴏𐴠𐴌𐴝𐴑 𐴕𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.</char> <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" /><char style="wj">𐴁𐴠𐴑𐴟𐴉𐴢 𐴉𐴟𐴥𐴕𐴠 𐴏𐴝𐴓𐴝𐴥𐴑 𐴑𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴠𐴓𐴢 𐴊𐴡𐴀𐴕𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴏𐴠𐴌𐴝𐴑 𐴕𐴞𐴉𐴞𐴥𐴎𐴝𐴌𐴒𐴡𐴘.‘</char><verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />
    <char style="wj">”𐴏𐴝𐴓𐴝𐴥𐴑 𐴑𐴟𐴥𐴕𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴠𐴌 𐴊𐴠, ’𐴃𐴠𐴓𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴕𐴡 𐴑𐴟𐴓𐴝𐴘𐴃𐴡𐴥 𐴉𐴝𐴌𐴠. 𐴘𐴝𐴥𐴌𐴁𐴡𐴊𐴡𐴓𐴢 𐴎𐴝𐴘 𐴁𐴠𐴏𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴑𐴞𐴕𐴞 𐴀𐴝𐴕𐴡𐴤𐴒𐴡𐴘.‘</char><verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />
    <char style="wj">”𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴠𐴓𐴢 𐴑𐴞𐴕𐴃𐴡 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴊𐴟𐴓𐴝𐴤 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠𐴒𐴝𐴘; 𐴃𐴡𐴥𐴘 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴝𐴓𐴢 𐴀𐴡𐴥𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴡𐴘𐴌𐴝𐴃𐴡𐴌 𐴔𐴠𐴓𐴝𐴃𐴢 𐴒𐴡𐴥𐴙𐴓𐴧𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴊𐴟𐴖𐴝𐴌 𐴒𐴝𐴥𐴕 𐴁𐴝𐴣𐴊𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠.</char><verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />
    <char style="wj">”𐴇𐴡𐴃𐴟𐴑𐴧𐴟𐴥𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴘𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝𐴌 𐴒𐴝𐴥𐴕 𐴑𐴟𐴥𐴓𐴡𐴕𐴝.‘</char><verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />
    <char style="wj">”𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥.‘</char><verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴘𐴝𐴥 𐴀𐴡𐴑𐴃𐴡𐴥 𐴕𐴡 𐴎𐴝𐴕𐴡.</char><verse eid="MAT 25:13" /></para>
  <para style="s1">𐴃𐴞𐴕 𐴎𐴡𐴕 𐴒𐴡𐴗𐴀𐴌𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="r">(<ref loc="LUK 19:11-27">𐴓𐴟𐴑 19‏:11‏-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />
    <char style="wj">”𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴀𐴠𐴎𐴧𐴡𐴕 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴃𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠.</char> <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" /><char style="wj">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴑𐴝𐴁𐴞𐴓𐴞𐴘𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕، 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴄𐴞𐴛𐴝 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴊𐴟𐴘 𐴀𐴝𐴥𐴎𐴝𐴌 𐴄𐴞𐴛𐴝 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴄𐴞𐴛𐴝 𐴊𐴞𐴦𐴘𐴠𐴥. 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴞𐴎𐴡𐴌 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.</char> <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴄𐴞𐴛𐴝 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴎𐴝𐴘 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴐𐴡𐴥𐴊𐴡𐴌𐴞 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴌𐴡𐴤 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴈𐴝𐴔𐴝𐴘𐴧𐴠𐴥.</char> <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" /><char style="wj">𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴊𐴟𐴘 𐴀𐴝𐴥𐴎𐴝𐴌 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴌𐴡𐴤 𐴊𐴟𐴘 𐴀𐴝𐴥𐴎𐴝𐴌 𐴈𐴝𐴔𐴝𐴘𐴧𐴠𐴥.</char> <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" /><char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴎𐴝𐴘𐴧𐴡𐴌𐴠 𐴔𐴠𐴍𐴞𐴃𐴢 𐴒𐴝𐴣𐴃𐴢 𐴑𐴟𐴌𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴠𐴥 𐴄𐴞𐴛𐴝 𐴓𐴟𐴑𐴝𐴘 𐴀𐴠𐴙𐴅𐴧𐴠𐴥.</char><verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />
    <char style="wj">”𐴁𐴡𐴀𐴗𐴃𐴢 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴒𐴡𐴗𐴀𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴏𐴝𐴉𐴢 𐴓𐴡𐴖𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.</char> <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" /><char style="wj">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴄𐴞𐴛𐴝 𐴉𐴝𐴀𐴙𐴓𐴢, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴌𐴡𐴤 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴀𐴝𐴕𐴞𐴤 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴊𐴞𐴀𐴓𐴝. 𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌𐴡𐴤 𐴉𐴝𐴣𐴏𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴄𐴞𐴛𐴝 𐴈𐴝𐴔𐴝𐴘𐴧𐴞𐴥.‘</char><verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />
    <char style="wj">”𐴃𐴡𐴥𐴘 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴐𐴝𐴁𐴝𐴥𐴐𐴢, 𐴒𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴒𐴡𐴗𐴀𐴌! 𐴃𐴟𐴘 𐴈𐴡𐴔 𐴅𐴞𐴕𐴞𐴥𐴐𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴡𐴏𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴏𐴞𐴎𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴟𐴥𐴔. 𐴀𐴝𐴘, 𐴃𐴡𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴑𐴟𐴥𐴐𐴞𐴃𐴢 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴡𐴥𐴒𐴝𐴘.‘</char><verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />
    <char style="wj">”𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴊𐴟𐴘 𐴀𐴝𐴥𐴎𐴝𐴌 𐴄𐴞𐴛𐴝 𐴉𐴝𐴀𐴙𐴓𐴢, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴟𐴘 𐴀𐴝𐴥𐴎𐴝𐴌 𐴄𐴞𐴛𐴝 𐴊𐴞𐴀𐴓𐴝. 𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌𐴡𐴤 𐴊𐴟𐴘 𐴀𐴝𐴥𐴎𐴝𐴌 𐴄𐴞𐴛𐴝 𐴈𐴝𐴔𐴝𐴘𐴧𐴞𐴥.‘</char><verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />
    <char style="wj">”𐴃𐴡𐴥𐴘 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴐𐴝𐴁𐴝𐴥𐴐𐴢, 𐴃𐴟𐴘 𐴒𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴒𐴡𐴗𐴀𐴌! 𐴃𐴟𐴘 𐴈𐴡𐴔 𐴅𐴞𐴕𐴞𐴥𐴐𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴊𐴝𐴈𐴝𐴤𐴘𐴧𐴡𐴏𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴏𐴞𐴎𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴟𐴥𐴔. 𐴀𐴝𐴘, 𐴃𐴡𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴑𐴟𐴥𐴐𐴞𐴃𐴢 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴡𐴥𐴒𐴝𐴘.‘</char><verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />
    <char style="wj">”𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠𐴑 𐴀𐴝𐴥𐴎𐴝𐴌 𐴄𐴞𐴛𐴝 𐴉𐴝𐴀𐴙𐴓𐴢, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴊𐴠 𐴃𐴟𐴀𐴛 𐴈𐴡𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢; 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴎𐴠𐴍𐴠𐴥 𐴕𐴡𐴥 𐴓𐴝𐴒𐴡 𐴈𐴠𐴥𐴕𐴃𐴟 𐴈𐴝𐴍𐴡, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴍𐴠𐴥 𐴁𐴞𐴏𐴢 𐴕𐴡𐴥 𐴐𐴞𐴥𐴣𐴍𐴡 𐴈𐴠𐴥𐴕𐴃𐴟 𐴊𐴡𐴓𐴝 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴋𐴡𐴦𐴌𐴠 𐴎𐴝𐴘𐴧𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴄𐴞𐴛𐴝 𐴀𐴞𐴀𐴕 𐴔𐴠𐴍𐴞𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴓𐴟𐴑𐴝𐴘 𐴀𐴠𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔. 𐴏𐴡𐴀, 𐴀𐴡𐴥𐴃𐴞𐴘𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴄𐴞𐴛𐴝.‘</char><verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />
    <char style="wj">”𐴀𐴞𐴥𐴃𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴃𐴟𐴘 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴐𐴞𐴤𐴘𐴝 𐴒𐴡𐴗𐴀𐴌! 𐴃𐴟𐴘 𐴃𐴡 𐴎𐴝𐴙𐴕𐴃𐴞, 𐴀𐴝𐴀𐴛 𐴎𐴠𐴍𐴠𐴥 𐴕𐴡𐴥 𐴓𐴝𐴒𐴝𐴘 𐴈𐴠𐴥𐴕𐴃𐴟 𐴈𐴝𐴍𐴞 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴍𐴠𐴥 𐴁𐴞𐴏𐴢 𐴕𐴡𐴥 𐴐𐴞𐴥𐴣𐴍𐴞 𐴈𐴠𐴥𐴕𐴃𐴟 𐴊𐴡𐴓𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠.</char> <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" /><char style="wj">𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡𐴌𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴄𐴞𐴛𐴝 𐴒𐴟𐴥𐴕 𐴁𐴠𐴚𐴒𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴘𐴓𐴠 𐴌𐴝𐴑𐴡𐴥𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴃𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴄𐴞𐴛𐴝 𐴒𐴟𐴥𐴕 𐴐𐴟𐴥𐴄𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴉𐴝𐴘𐴃𐴝𐴔.‘</char><verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />
    <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴃𐴝𐴃𐴧𐴟 𐴄𐴞𐴛𐴝 𐴒𐴟𐴥𐴕 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘, 𐴎𐴝𐴃𐴧𐴟 𐴕𐴞𐴑𐴞 𐴊𐴡𐴐𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴄𐴞𐴛𐴝 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴡.</char> <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴡𐴥𐴊𐴡𐴌𐴁𐴝𐴀𐴌𐴝 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴝𐴃𐴧𐴟 𐴕𐴝𐴥𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘𐴁𐴡.</char> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" /><char style="wj">𐴘𐴝𐴓𐴝 𐴀𐴠 𐴁𐴠𐴇𐴝𐴎𐴡𐴌 𐴒𐴡𐴗𐴀𐴌 𐴀𐴞𐴃𐴝𐴌𐴠𐴤 𐴁𐴝𐴀𐴌𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘 𐴊𐴡𐴒𐴡𐴥𐴘; 𐴇𐴠𐴥𐴍𐴠 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴃𐴠 𐴊𐴝𐴃𐴢 𐴑𐴞𐴌𐴑𐴞𐴌𐴝𐴕𐴞 𐴀𐴡𐴥𐴘𐴁𐴡.</char><verse eid="MAT 25:30" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴡𐴌 𐴁𐴞𐴏𐴝𐴌</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />
    <char style="wj">”𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴘𐴠 𐴀𐴝𐴘𐴁𐴡𐴤 𐴀𐴝𐴦𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴁𐴡𐴘𐴁𐴡𐴥.</char> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" /><char style="wj">𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴟𐴘 𐴊𐴡𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴥𐴀𐴓𐴢 𐴏𐴡𐴌𐴡𐴘𐴝𐴘𐴠 𐴏𐴡𐴥𐴀𐴓𐴡𐴃𐴧𐴟 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌𐴠 𐴀𐴝𐴓𐴡𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠.</char> <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" /><char style="wj">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢 𐴓𐴟𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴙𐴑𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴡𐴥𐴀𐴓𐴢 𐴓𐴟𐴕𐴡𐴌𐴠 𐴁𐴝𐴕 𐴋𐴝𐴥𐴙𐴑𐴧𐴝.</char><verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />
    <char style="wj">”𐴁𐴝𐴦𐴊𐴠 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴌𐴝𐴙𐴅𐴧𐴡 𐴔𐴞𐴌𐴝𐴏𐴢 𐴓𐴡𐴦𐴒𐴝𐴥𐴘, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴓𐴡𐴥𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴘𐴠.</char> <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴁𐴟𐴥𐴑𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴝𐴥𐴕𐴝 𐴊𐴞𐴀𐴓𐴝; 𐴀𐴝𐴀𐴛 𐴃𐴞𐴌𐴝𐴥𐴐𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴝𐴕𐴞𐴥 𐴊𐴞𐴀𐴓𐴝; 𐴀𐴝𐴀𐴛 𐴉𐴡𐴌𐴁𐴝𐴥𐴐𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴝𐴒𐴝 𐴊𐴞𐴀𐴓𐴝; </char> <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" /><char style="wj">𐴀𐴝𐴀𐴛 𐴁𐴞𐴘𐴡𐴏𐴧𐴡𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴡𐴦𐴌 𐴊𐴞𐴀𐴓𐴝; 𐴀𐴝𐴀𐴛 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴠𐴥𐴌𐴔𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝; 𐴀𐴝𐴀𐴛 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴝.‘</char><verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴇𐴠𐴥 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴒𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴟𐴥𐴑𐴝 𐴊𐴠𐴑𐴞𐴥 𐴈𐴝𐴥𐴕𐴝 𐴊𐴞𐴦𐴘𐴞𐴥 𐴊𐴠, 𐴘𐴝𐴥𐴃𐴡 𐴃𐴞𐴌𐴝𐴥𐴐𐴞 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴕𐴞𐴥 𐴊𐴞𐴦𐴘𐴞𐴥 𐴊𐴠𐴥؟ </char> <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" /><char style="wj">𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴉𐴡𐴌𐴁𐴝𐴥𐴐𐴞 𐴊𐴠𐴑𐴞𐴥 𐴎𐴝𐴒𐴝 𐴊𐴞𐴦𐴘𐴞𐴥 𐴊𐴠, 𐴘𐴝𐴥𐴃𐴡 𐴁𐴞𐴘𐴡𐴏𐴧𐴡𐴌 𐴊𐴠𐴑𐴞𐴥 𐴇𐴡𐴦𐴌 𐴊𐴞𐴦𐴘𐴞𐴥 𐴊𐴠𐴥؟</char> <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" /><char style="wj">𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴊𐴠𐴑𐴞𐴥 𐴑𐴠𐴥𐴌𐴔𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠, 𐴘𐴝𐴥𐴃𐴡 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴠𐴑𐴞𐴥 𐴏𐴝𐴘𐴃𐴡𐴥 𐴒𐴞𐴦𐴘𐴞𐴥 𐴊𐴠𐴥؟‘</char><verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴁𐴧𐴠 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴠 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.‘</char><verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />
    <char style="wj">”𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴕 𐴋𐴝𐴥𐴑𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴡𐴥 𐴓𐴝𐴀𐴕𐴡𐴙𐴃𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴊𐴟𐴌 𐴀𐴡𐴥𐴘 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴀𐴡𐴦𐴙𐴕𐴡𐴃𐴢 𐴎𐴡𐴦𐴒𐴡𐴥𐴘, 𐴎𐴞𐴀𐴕 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠;</char> <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴁𐴟𐴥𐴑𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴝𐴥𐴕𐴝 𐴕𐴡𐴥 𐴊𐴡𐴦; 𐴀𐴝𐴀𐴛 𐴃𐴞𐴌𐴝𐴥𐴐𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴝𐴕𐴞𐴥 𐴕𐴡𐴥 𐴊𐴡𐴦; </char> <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" /><char style="wj">𐴀𐴝𐴀𐴛 𐴉𐴡𐴌𐴁𐴝𐴥𐴐𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴝𐴒𐴝 𐴕𐴡𐴥 𐴊𐴡𐴦; 𐴁𐴞𐴘𐴡𐴏𐴧𐴡𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴡𐴦𐴌 𐴕𐴡𐴥 𐴊𐴡𐴦; 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴝𐴀𐴏𐴞𐴃𐴝 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤.‘ </char><verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />
    <char style="wj">”𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴟𐴥𐴑𐴝, 𐴃𐴞𐴌𐴝𐴥𐴐𐴞, 𐴉𐴡𐴌𐴁𐴝𐴥𐴐𐴞, 𐴁𐴞𐴘𐴡𐴏𐴧𐴡𐴌, 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴘𐴝𐴥 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴠𐴑𐴞𐴥 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠𐴥؟‘</char><verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />
    <char style="wj">”𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴁𐴧𐴠 𐴕𐴞𐴌𐴡𐴥𐴐𐴧𐴗𐴝𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴎𐴞𐴘𐴝𐴥𐴕 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴠 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤.‘</char><verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />
    <char style="wj">”𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴏𐴝𐴥𐴣𐴎𐴝 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴎𐴝𐴘𐴁𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴒𐴟𐴥𐴕 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴒𐴡𐴥𐴓𐴞𐴁𐴡.“</char><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴏𐴡𐴥𐴓𐴧𐴝</para>
  <para style="r">(<ref loc="MRK 14:1-2">𐴔𐴝𐴑 14‏:1‏-2</ref>; <ref loc="LUK 22:1-2">𐴓𐴟𐴑 22‏:1‏-2</ref>; <ref loc="JHN 11:45-53">𐴘𐴡 11‏:45‏-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴃𐴧𐴟 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴈𐴡𐴘𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" /><char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴊𐴟𐴘 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴢 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴑𐴝𐴥𐴘𐴧𐴝𐴉𐴝𐴏𐴢 𐴈𐴡𐴀 𐴊𐴠 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴔𐴡𐴇𐴡𐴥𐴓𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠; <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />𐴀𐴝𐴦𐴌 𐴔𐴞𐴓𐴞 𐴏𐴡𐴥𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴎𐴟𐴘𐴃𐴠𐴥𐴒𐴡𐴌𐴞 𐴊𐴡𐴥𐴌𐴞𐴉𐴠𐴓𐴝𐴘 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴊𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴕𐴡, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴟𐴥𐴌𐴟𐴏𐴧𐴟𐴓𐴢 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠.“<verse eid="MAT 26:5" /></para>
  <para style="s1">𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝 𐴉𐴝𐴌𐴝𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴃𐴡𐴌 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠</para>
  <para style="r">(<ref loc="MRK 14:3-9">𐴔𐴝𐴑 14‏:3‏-9</ref>; <ref loc="JHN 12:1-8">𐴘𐴡 12‏:1‏-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />𐴀𐴞𐴏𐴝𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴁𐴠𐴃𐴝𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴑𐴟𐴌𐴟𐴏𐴢 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴏𐴝𐴥𐴘𐴔𐴡𐴕𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴉𐴝𐴃𐴧𐴡𐴥𐴌𐴡𐴌 𐴇𐴝𐴥𐴣𐴌𐴞𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴁𐴞𐴐𐴞𐴤 𐴔𐴡𐴀𐴚𐴒𐴝 𐴀𐴝𐴣𐴃𐴡𐴌 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴃𐴡𐴌 𐴒𐴟𐴥𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴑𐴞𐴥 𐴒𐴡𐴔 𐴕𐴡𐴥 𐴓𐴝𐴒𐴠, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴀𐴕 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴑𐴞𐴘𐴝𐴥 𐴊𐴞𐴉𐴠𐴥𐴓𐴠𐴌؟ <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />𐴀𐴠 𐴀𐴝𐴣𐴃𐴡𐴌 𐴒𐴟𐴥𐴕 𐴊𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴄𐴞𐴛𐴝 𐴊𐴞 𐴁𐴠𐴏𐴞 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴙𐴃𐴧𐴡.“<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴌𐴠 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴑𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴡𐴤𐴌؟ 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴓𐴝𐴘 𐴀𐴠𐴥𐴕𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.</char> <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" /><char style="wj">𐴒𐴡𐴌𐴞𐴁𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴕𐴞𐴃𐴧𐴞 𐴀𐴝𐴏𐴠𐴤,</char><note caller="+" style="f"><char style="fr" closed="false">26‏:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 15:11">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 15‏:11</ref></char>.</char></note> <char style="wj">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴃𐴧𐴞 𐴕𐴡 𐴉𐴝𐴘𐴁𐴝.</char> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" /><char style="wj">𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴦𐴃𐴢 𐴀𐴝𐴣𐴃𐴡𐴌 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴇𐴡𐴥𐴕𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠.</char> <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴠𐴍𐴠𐴥-𐴎𐴠𐴍𐴠𐴥 𐴀𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴘𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴀𐴞𐴁𐴝𐴤𐴌 𐴘𐴝𐴊𐴒𐴝𐴌𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴠𐴥𐴍𐴠-𐴇𐴠𐴥𐴍𐴠 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝𐴘𐴁𐴡.“</char><verse eid="MAT 26:13" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌 𐴌𐴝𐴎𐴞</para>
  <para style="r">(<ref loc="MRK 14:10-11">𐴔𐴝𐴑 14‏:10‏-11</ref>; <ref loc="LUK 22:3-6">𐴓𐴟𐴑 22‏:3‏-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕, 𐴎𐴝𐴌 𐴕𐴝𐴔 𐴕𐴞𐴑𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴞𐴏𐴑𐴝𐴥𐴌𐴞𐴘𐴠𐴃𐴢, 𐴀𐴞𐴥𐴃𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴒𐴞𐴦𐴘𐴠𐴥, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴡𐴥𐴌𐴞𐴊𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴞𐴦 𐴊𐴞𐴦𐴁𐴝؟“ 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴃𐴞𐴌𐴞𐴥𐴐𐴧𐴗𐴝 𐴌𐴟𐴉𐴝𐴌 𐴄𐴞𐴛𐴝 𐴒𐴡𐴕𐴞 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴑𐴝𐴌 𐴃𐴝𐴓𐴝𐴐𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MAT 26:16" /></para>
  <para style="s1">𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝</para>
  <para style="r">(<ref loc="MRK 14:12-21">𐴔𐴝𐴑 14‏:12‏-21</ref>; <ref loc="LUK 22:7-14">𐴓𐴟𐴑 22‏:7‏-14</ref>‏,<ref loc="LUK 22:21-23">21‏-23</ref>; <ref loc="JHN 13:21-30">𐴘𐴡 13‏:21‏-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />𐴐𐴟𐴥𐴄𐴝𐴌-𐴏𐴝𐴥𐴌𐴝 𐴌𐴟𐴄𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴊𐴞𐴕، 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴃𐴟𐴀𐴛 𐴇𐴝𐴥𐴘 𐴉𐴝𐴌𐴡 𐴉𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴓𐴧𐴝 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴌 𐴃𐴡𐴘𐴧𐴝𐴌𐴞 𐴇𐴡𐴍𐴠𐴥 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟“<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴉𐴡𐴥𐴓𐴡𐴕𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴎𐴡𐴦,“ 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ”𐴀𐴟𐴏𐴃𐴝𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴋𐴝𐴥𐴑𐴠; 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔.‘ “</char> <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />𐴃𐴡𐴥𐴘 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴈𐴝𐴥𐴕𐴝𐴌 𐴃𐴡𐴘𐴧𐴝𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />𐴁𐴝𐴦𐴊𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴝𐴥𐴣𐴎𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡.“</char><verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴀𐴡𐴥𐴘 𐴎𐴡𐴕𐴉𐴡𐴃𐴞 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟“<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴎𐴠𐴦 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴡𐴊𐴧𐴝𐴤𐴃𐴢 𐴀𐴝𐴥𐴃𐴢 𐴋𐴝𐴥𐴓𐴠𐴌, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡.</char> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" /><char style="wj">𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴎𐴝𐴦𐴌; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴊𐴡𐴥𐴌𐴝 𐴇𐴝𐴥𐴘𐴁𐴡. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴎𐴡𐴌𐴔𐴡 𐴕𐴡 𐴀𐴡𐴥𐴘𐴃𐴡 𐴁𐴡𐴥𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴝 𐴒𐴡𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.“</char><verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴇𐴟𐴥𐴊𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴁𐴡 𐴀𐴞𐴥𐴃𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴀𐴛 𐴕𐴠𐴥؟“ 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴘 𐴕𐴞𐴎𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴘𐴉𐴠𐴓𐴝𐴘𐴡𐴏𐴢.“</char><verse eid="MAT 26:25" /></para>
  <para style="s1">𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴝𐴥𐴕𐴝</para>
  <para style="r">(<ref loc="MRK 14:22-26">𐴔𐴝𐴑 14‏:22‏-26</ref>; <ref loc="LUK 22:15-20">𐴓𐴟𐴑 22‏:15‏-20</ref>; <ref loc="1CO 11:23-25">1𐴑𐴡𐴥𐴌 11‏:23‏-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴌𐴟𐴄𐴞 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴥𐴚𐴒𐴞 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴊𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴓𐴡𐴦𐴘𐴢 𐴈𐴡𐴥𐴀; 𐴘𐴝𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴦.“</char><verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴘𐴝𐴓𐴝 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴊𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴠𐴕𐴃𐴟𐴥 𐴈𐴡𐴥𐴀;</char> <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" /><char style="wj">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴡𐴘𐴝 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴖𐴢, 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴞𐴘𐴠𐴥 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴟𐴔.</char> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" /><char style="wj">𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴠𐴇𐴡𐴥𐴕𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴠 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴀𐴞𐴀𐴕 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌 𐴕𐴝 𐴈𐴝𐴥𐴘𐴧𐴟𐴔, 𐴀𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴕𐴡𐴘𐴝 𐴒𐴡𐴌𐴞 𐴕𐴝𐴥 𐴇𐴝𐴥𐴘.“</char><verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴠𐴀𐴌 𐴒𐴝𐴀𐴘𐴢, 𐴕𐴠𐴦𐴓𐴞 𐴎𐴝𐴘𐴃𐴟𐴕 𐴉𐴝𐴀𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴡𐴥𐴘.<verse eid="MAT 26:30" /></para>
  <para style="s1">𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="r">(<ref loc="MRK 14:27-31">𐴔𐴝𐴑 14‏:27‏-31</ref>; <ref loc="LUK 22:31-34">𐴓𐴟𐴑 22‏:31‏-34</ref>; <ref loc="JHN 13:36-38">𐴘𐴡 13‏:36‏-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴙𐴅𐴧𐴝 𐴌𐴝𐴙𐴃𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴐𐴡𐴥𐴀𐴑 𐴀𐴝𐴘𐴁𐴡𐴤 𐴀𐴝𐴦𐴌 𐴊𐴝𐴥𐴘𐴁𐴝𐴒𐴡𐴘; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</char></para>
  <para style="q1" vid="MAT 26:31">
    <char style="wj">’𐴀𐴝𐴀𐴛 𐴏𐴡𐴥𐴀𐴓𐴢 𐴏𐴡𐴌𐴡𐴘𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴟𐴔,</char></para>
  <para style="q2" vid="MAT 26:31">
    <char style="wj">𐴃𐴡𐴥𐴘 𐴎𐴝𐴥𐴑𐴡𐴌 𐴏𐴡𐴥𐴀𐴓𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴐𐴞𐴥𐴣𐴍𐴝𐴐𐴞𐴄𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.‘</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">26‏:31 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ZEC 13:7">𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝 13‏:7</ref>
        </char>
      </char>
    </note><verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />
    <char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴒𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴎𐴝𐴘𐴧𐴟𐴔.“</char><verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴎𐴝𐴘𐴓𐴠𐴥 𐴘𐴡, 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴎𐴝𐴘𐴧𐴟𐴔.“<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴙𐴅𐴧𐴝 𐴌𐴝𐴙𐴃𐴧𐴝 𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴁𐴝𐴑 𐴊𐴞𐴁𐴝𐴌 𐴀𐴝𐴒𐴠, 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴞𐴕 𐴁𐴝𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴞.“</char><verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />𐴉𐴞𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴌𐴝 𐴉𐴡𐴌𐴠 𐴘𐴡𐴥, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔.“ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴈𐴡𐴘𐴧𐴠𐴥.<verse eid="MAT 26:35" /></para>
  <para style="s1">𐴒𐴠𐴃𐴏𐴝𐴥𐴔𐴝𐴕𐴞 𐴁𐴝𐴒𐴝𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴖𐴝</para>
  <para style="r">(<ref loc="MRK 14:32-42">𐴔𐴝𐴑 14‏:32‏-42</ref>; <ref loc="LUK 22:39-46">𐴓𐴟𐴑 22‏:39‏-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴓𐴡𐴦𐴘𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴒𐴠𐴃𐴏𐴝𐴥𐴔𐴝𐴕𐴞 𐴈𐴡𐴀. 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴀𐴛 𐴖𐴡𐴀𐴣𐴃𐴢 𐴎𐴝𐴘 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔𐴁𐴡𐴘, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴑𐴡.“</char> <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌 𐴉𐴟𐴖𐴝 𐴊𐴟𐴕𐴞𐴥 𐴖𐴝𐴌𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴡𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴞𐴤 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴓𐴝𐴒𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴐𐴝𐴥𐴕𐴃𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴡𐴌𐴝𐴕 𐴕𐴠𐴦𐴓𐴞𐴎𐴝𐴘𐴃𐴡𐴥𐴘 𐴏𐴝𐴥𐴌. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴣𐴘𐴡𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴡.“</char><verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴒𐴡𐴌𐴞 𐴔𐴟𐴀𐴔𐴧𐴞𐴑𐴧𐴝 𐴎𐴝𐴘, 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴌𐴞 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴢, 𐴎𐴡𐴊𐴞 𐴀𐴡𐴥𐴘 𐴉𐴝𐴙𐴓𐴧𐴠, 𐴀𐴠 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴌 𐴉𐴞𐴘𐴝𐴓𐴝 𐴘𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴟𐴌 𐴀𐴡𐴥𐴗𐴑; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴝𐴣𐴀𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴀𐴡𐴥𐴗𐴑.“</char><verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴠𐴑 𐴒𐴡𐴥𐴕𐴋𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴞 𐴕𐴡 𐴉𐴝𐴌𐴡𐴀𐴌 𐴊𐴠𐴥؟</char> <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" /><char style="wj">𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴡 𐴀𐴝𐴦𐴌 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴕𐴡 𐴉𐴡𐴌𐴡; 𐴁𐴠𐴐𐴡𐴥𐴑 𐴌𐴟𐴀𐴃𐴧𐴟 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴑𐴡𐴔𐴎𐴟𐴌 𐴊𐴠.“</char><verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴎𐴝𐴘 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥𐴌, <char style="wj">”𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴢, 𐴀𐴝𐴀𐴛 𐴕𐴝 𐴈𐴝𐴥𐴘𐴓𐴠 𐴎𐴡𐴊𐴞 𐴀𐴠 𐴉𐴞𐴘𐴝𐴓𐴝 𐴘𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴊𐴟𐴌 𐴕𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴑.“</char><verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴟𐴑 𐴒𐴟𐴥𐴔𐴠 𐴁𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴠𐴌𐴞𐴎𐴝𐴘 𐴀𐴠𐴑𐴞𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴘𐴢 𐴃𐴞𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌𐴝𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴡𐴤 𐴊𐴠𐴥؟ 𐴏𐴡𐴀, 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡. </char> <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" /><char style="wj">𐴀𐴟𐴍𐴡𐴥, 𐴎𐴝𐴘𐴒𐴡𐴥𐴘. 𐴏𐴡𐴀, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴡𐴥𐴌𐴞𐴊𐴡𐴘𐴝 𐴋𐴝𐴥𐴑𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠𐴒𐴝𐴘.“</char><verse eid="MAT 26:46" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌𐴞</para>
  <para style="r">(<ref loc="MRK 14:43-50">𐴔𐴝𐴑 14‏:43‏-50</ref>; <ref loc="LUK 22:47-53">𐴓𐴟𐴑 22‏:47‏-53</ref>; <ref loc="JHN 18:3-12">𐴘𐴡 18‏:3‏-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠𐴒𐴝𐴘, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕. 𐴀𐴞𐴥𐴃𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴋𐴡𐴣𐴀𐴌 𐴀𐴠𐴑 𐴊𐴡𐴓𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴍𐴞𐴥-𐴐𐴟𐴥𐴍𐴝 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴊𐴠𐴥𐴌, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴝𐴌𐴝𐴥𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕 𐴊𐴞𐴥𐴓𐴢, ”𐴀𐴝𐴀𐴛 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴘𐴟𐴔, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝; 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴡.“ <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />𐴘𐴡𐴇𐴟𐴥𐴊𐴝 𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴞𐴥𐴣𐴘𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴌𐴝𐴁𐴧𐴞𐴥, 𐴀𐴝𐴏𐴧𐴝𐴓𐴝𐴔𐴟 𐴀𐴝𐴓𐴝𐴘𐴑𐴟𐴔!“ 𐴇𐴠𐴥𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥𐴘𐴠.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴊𐴡𐴗𐴀𐴡𐴥𐴏𐴢, 𐴃𐴟𐴘 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴙𐴐𐴧𐴡𐴥𐴏𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌.“</char></para>
  <para style="p" vid="MAT 26:50">𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴕𐴠𐴦𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴡𐴓𐴝𐴘 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴒𐴟𐴓𐴝𐴔𐴡𐴌 𐴈𐴝𐴕 𐴈𐴝𐴍𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴡𐴌 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴋𐴝𐴉𐴡𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴘 𐴀𐴠𐴌; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴏𐴡𐴓𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡𐴓𐴟𐴖𐴝𐴌𐴠 𐴁𐴠 𐴔𐴡𐴌𐴞𐴁𐴡𐴥.</char> <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" /><char style="wj">𐴃𐴟𐴘 𐴑𐴞 𐴕𐴡 𐴎𐴝𐴕𐴡𐴏𐴢, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴀𐴝𐴥𐴎𐴝𐴌-𐴀𐴝𐴥𐴎𐴝𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴥𐴗𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴁𐴡 𐴊𐴠𐴥؟</char> <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴇𐴠𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴇𐴠𐴥 𐴈𐴡𐴃𐴝𐴤 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴡؟“</char><verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴢 𐴓𐴗𐴝𐴥𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴢 𐴊𐴡𐴥𐴙𐴃𐴧𐴡 𐴀𐴝𐴙𐴐𐴧𐴡𐴥 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴃𐴡𐴓𐴟𐴖𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴍𐴞𐴥-𐴐𐴟𐴥𐴍𐴝 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴠𐴦𐴙𐴓𐴧𐴡𐴥 𐴊𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴉𐴡𐴃𐴧𐴞𐴥 𐴊𐴞𐴕 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴢 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴃𐴝𐴔, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤.</char> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" /><char style="wj">𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.“</char> 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴌𐴞 𐴊𐴝𐴥𐴘 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="MAT 26:56" /></para>
  <para style="s1">𐴉𐴡𐴥𐴃𐴟𐴖𐴝𐴘𐴞-𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴏𐴝𐴤</para>
  <para style="r">(<ref loc="MRK 14:53-65">𐴔𐴝𐴑 14‏:53‏-65</ref>; <ref loc="LUK 22:54-55">𐴓𐴟𐴑 22‏:54‏-55</ref>‏,<ref loc="LUK 22:63-71">63‏-71</ref>; <ref loc="JHN 18:13-14">𐴘𐴡 18‏:13‏-14</ref>‏,<ref loc="JHN 18:19-24">19‏-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴒𐴠𐴌𐴠𐴉𐴃𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔 𐴑𐴝𐴥𐴘𐴧𐴝𐴉𐴝𐴏𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴡𐴥𐴘, 𐴎𐴠𐴍𐴠𐴥 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />𐴉𐴞𐴃𐴡𐴌 𐴊𐴟𐴌𐴠𐴥-𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴏𐴠𐴤-𐴉𐴞𐴏𐴠𐴤 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴡𐴌 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴌 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴑𐴞𐴦-𐴑𐴞𐴦 𐴀𐴡𐴥 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴓𐴞 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴥𐴃𐴟𐴖𐴝𐴘𐴞-𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢 𐴄𐴞𐴥𐴘𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴟𐴓𐴋𐴝 𐴔𐴞𐴏𐴝𐴥 𐴒𐴡𐴁𐴝𐴤 𐴃𐴟𐴖𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴌𐴠. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴔𐴞𐴏𐴝𐴥 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴃𐴡 𐴔𐴟𐴀𐴔𐴧𐴞𐴑𐴧𐴝 𐴀𐴝𐴘𐴓𐴠𐴤 𐴘𐴡, 𐴃𐴡𐴀 𐴇𐴝𐴥𐴍𐴠 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴒𐴡𐴁𐴝𐴤 𐴕𐴡𐴥 𐴉𐴝𐴦.</para>
  <para style="p" vid="MAT 26:60">𐴓𐴠𐴑𐴞𐴕 𐴉𐴡𐴌𐴠 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴔𐴟𐴀𐴔𐴧𐴞𐴑𐴧𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴝𐴘, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴊𐴞 𐴉𐴝𐴙𐴅𐴧𐴟𐴔.‘“<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴖𐴝𐴁𐴢 𐴕𐴡 𐴊𐴞𐴁𐴝؟ 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴞𐴀𐴕 𐴑𐴞𐴦 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥𐴌؟“ <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤 𐴕𐴞𐴎𐴝𐴥𐴔 𐴔𐴝𐴥𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢.</para>
  <para style="p" vid="MAT 26:63">𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘 𐴈𐴡𐴀 𐴏𐴝𐴥𐴘, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘 𐴕𐴠؟“<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴃𐴟𐴀𐴛 𐴕𐴞𐴎𐴠 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴡. 𐴃𐴡𐴀 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴘𐴝𐴌𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠𐴑𐴞𐴥𐴁𐴝, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴓𐴧𐴝 𐴃𐴝𐴥𐴓𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴘𐴧𐴠𐴤𐴌.“</char><note caller="+" style="f"><char style="fr" closed="false">26‏:64 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:1">𐴎𐴡𐴁𐴟𐴌 110‏:1</ref></char>; <char style="xt"><ref loc="DAN 7:13">𐴋𐴝𐴥𐴕𐴞𐴘𐴠𐴓𐴢 7‏:13</ref></char>.</char></note><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴡𐴌𐴡 𐴀𐴞𐴔𐴝𐴔𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴙𐴌𐴡𐴌 𐴇𐴡𐴦𐴌 𐴉𐴝𐴥𐴍𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥! 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴌 𐴑𐴞𐴦 𐴒𐴡𐴁𐴝𐴤 𐴓𐴝𐴒𐴠𐴌 𐴊𐴠𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴞𐴁𐴝𐴤𐴌 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴉𐴟𐴥𐴙𐴕𐴧𐴡; <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴌𐴝𐴘 𐴑𐴞𐴦؟“</para>
  <para style="p" vid="MAT 26:66">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴁𐴝𐴤 𐴔𐴡𐴦𐴃𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑!“<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴑𐴡𐴃𐴢 𐴏𐴠𐴥𐴂𐴢 𐴔𐴝𐴙𐴅𐴧𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴒𐴟𐴥𐴐𐴝 𐴔𐴝𐴙𐴅𐴧𐴠𐴥; 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴖𐴝𐴌 𐴔𐴝𐴌𐴞 <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴠𐴥𐴘 𐴔𐴡𐴀𐴏𐴞𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴕𐴃𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴏𐴝𐴘, 𐴃𐴡𐴌𐴠𐴥 𐴇𐴡𐴕𐴠 𐴔𐴝𐴙𐴅𐴧𐴠𐴥؟“<verse eid="MAT 26:68" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴀𐴞𐴕𐴑𐴝𐴌</para>
  <para style="r">(<ref loc="MRK 14:66-72">𐴔𐴝𐴑 14‏:66‏-72</ref>; <ref loc="LUK 22:56-62">𐴓𐴟𐴑 22‏:56‏-62</ref>; <ref loc="JHN 18:15-18">𐴘𐴡 18‏:15‏-18</ref>‏,<ref loc="JHN 18:25-27">25‏-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴉𐴞𐴃𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴀𐴟𐴍𐴝𐴥𐴕𐴡𐴃𐴢 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴝𐴣𐴊𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴘𐴡𐴥 𐴃𐴡 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝!“<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠, ”𐴃𐴟𐴀𐴛 𐴑𐴞𐴘𐴡𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴀𐴌 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴎𐴝𐴕𐴞.“<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴁𐴝𐴀𐴌𐴠 𐴁𐴝𐴦𐴕𐴋𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴝𐴣𐴊𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥, 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴀𐴞𐴏𐴝𐴤 𐴕𐴝𐴏𐴝𐴥𐴌𐴞𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.“<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴝𐴁𐴝𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠, ”𐴀𐴝𐴀𐴛 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥.“<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />𐴇𐴡𐴃𐴟𐴥𐴕 𐴁𐴝𐴦𐴊𐴠 𐴋𐴝𐴑𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴟𐴥𐴕𐴠 𐴀𐴝𐴀𐴘𐴢 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴟𐴀𐴛 𐴘𐴡𐴥 𐴃𐴝𐴌𐴝𐴥𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴎𐴡𐴕; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴎𐴡𐴁𐴝𐴕𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴡𐴥𐴌𐴝 𐴊𐴠𐴥𐴌.“<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴓𐴝𐴀𐴕𐴡𐴃𐴢 𐴀𐴡𐴥𐴑 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠; 𐴀𐴝𐴀𐴛 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥!“</para>
  <para style="p" vid="MAT 26:74">𐴁𐴝𐴦𐴊𐴠 𐴀𐴠𐴥𐴇𐴡𐴕-𐴀𐴠𐴥𐴇𐴡𐴕 𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴁𐴝𐴑 𐴊𐴞𐴘𐴠𐴥. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴃𐴡𐴌𐴡𐴃𐴧𐴟 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴈𐴡𐴃𐴝𐴤 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴙𐴄𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, <char style="wj">”𐴌𐴝𐴃𐴝𐴑𐴟𐴌𐴝𐴤 𐴁𐴝𐴑 𐴊𐴞𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴞𐴕 𐴁𐴝𐴌 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴞.“</char> 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴞𐴒𐴡𐴥𐴘 𐴑𐴟𐴥𐴁𐴢 𐴈𐴝𐴣𐴊𐴝𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴏𐴝𐴤</para>
  <para style="r">(<ref loc="MRK 15:1">𐴔𐴝𐴑 15‏:1</ref>; <ref loc="LUK 23:1-2">𐴓𐴟𐴑 23‏:1‏-2</ref>; <ref loc="JHN 18:28-32">𐴘𐴡 18‏:28‏-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴁𐴞𐴀𐴕𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴔𐴞𐴓𐴞 𐴏𐴡𐴥𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴎𐴝𐴕𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴝𐴣𐴊𐴞𐴥 𐴓𐴡𐴘𐴎𐴝𐴘 𐴇𐴝𐴥𐴑𐴞𐴔 𐴉𐴞𐴓𐴝𐴃𐴡𐴌𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠.<verse eid="MAT 27:2" /></para>
  <para style="s1">𐴘𐴡𐴇𐴟𐴥𐴊𐴝𐴌 𐴔𐴡𐴦𐴃𐴢</para>
  <para style="r">(<ref loc="ACT 1:18-19">𐴈𐴝𐴔 1‏:18‏-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴘𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴔𐴡𐴦𐴃𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴠 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴇𐴝𐴥𐴘 𐴃𐴞𐴌𐴞𐴥𐴐𐴧𐴗𐴝 𐴌𐴟𐴉𐴝𐴌 𐴉𐴡𐴘𐴐𐴝𐴤 𐴒𐴟𐴥𐴕 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴞𐴥𐴌𐴝𐴘𐴊𐴞 <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴊𐴡𐴥𐴌𐴞𐴊𐴞 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴞𐴥.“</para>
  <para style="p" vid="MAT 27:4">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴠؟ 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴘 𐴁𐴟𐴎𐴡𐴥𐴏𐴢.“<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴠 𐴌𐴟𐴉𐴝𐴌 𐴉𐴡𐴘𐴐𐴝𐴤 𐴒𐴟𐴥𐴕 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴠𐴓𐴝𐴤𐴔𐴝𐴌𐴞 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴎𐴝𐴘 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴉𐴝𐴥𐴣𐴐𐴞 𐴇𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴌𐴟𐴉𐴝𐴌 𐴉𐴡𐴘𐴐𐴝𐴤 𐴒𐴟𐴥𐴕 𐴓𐴡𐴦𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴀𐴕 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴁𐴝𐴐𐴧𐴟𐴤𐴃𐴢 𐴌𐴝𐴑𐴡𐴥𐴕 𐴎𐴝𐴘𐴠𐴏𐴢 𐴕𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴀𐴕 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴊𐴝𐴔.“ <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴘𐴝𐴏𐴝𐴕𐴝 𐴒𐴡𐴌𐴞𐴥, 𐴁𐴞𐴊𐴠𐴐𐴡𐴥𐴙𐴃𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴈𐴡𐴁𐴡𐴌𐴡𐴏𐴃𐴝𐴥𐴕 𐴁𐴝𐴕𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴠𐴥 𐴌𐴟𐴉𐴝𐴌 𐴉𐴡𐴘𐴐𐴝𐴤 𐴒𐴟𐴥𐴕 𐴓𐴡𐴥𐴘 𐴑𐴟𐴀𐴝𐴥𐴣𐴙𐴅𐴧𐴝𐴌 𐴎𐴡𐴁𐴞𐴕 𐴕𐴝𐴥𐴕 𐴑𐴞𐴕𐴧𐴠𐴥. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴠𐴥 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕𐴡𐴌𐴠 𐴀𐴝𐴙𐴅 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴓𐴡𐴖𐴢 𐴖𐴡𐴌 𐴎𐴝𐴒𐴝 𐴈𐴡𐴀𐴘𐴢 𐴋𐴝𐴑𐴠. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠, 𐴕𐴡𐴁𐴞 𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴘𐴝𐴀𐴕 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, ”𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥 𐴃𐴞𐴌𐴞𐴥𐴐𐴧𐴗𐴝 𐴌𐴟𐴉𐴝𐴌 𐴉𐴡𐴘𐴐𐴝𐴤 𐴒𐴟𐴥𐴕 𐴓𐴡𐴘𐴧𐴠𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤𐴌 𐴊𐴝𐴔, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴊𐴡𐴌 𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴄𐴞𐴥𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢; <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴑𐴟𐴀𐴝𐴥𐴣𐴙𐴅𐴧𐴝𐴌 𐴎𐴡𐴁𐴞𐴕 𐴕𐴝𐴥𐴕 𐴑𐴞𐴕𐴝𐴃𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴁𐴟𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠.“<note caller="+" style="f"><char style="fr" closed="false">27‏:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 11:12">𐴎𐴝𐴑𐴝𐴌𐴞𐴥𐴘𐴝 11‏:12</ref>‏,<ref loc="ZEC 11:13">13</ref></char>; <char style="xt"><ref loc="JER 19:1-13">𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝 19‏:1‏-13</ref>; <ref loc="JER 32:6-9">32‏:6‏-9</ref></char>.</char></note><verse eid="MAT 27:10" /></para>
  <para style="s1">𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥</para>
  <para style="r">(<ref loc="MRK 15:2-5">𐴔𐴝𐴑 15‏:2‏-5</ref>; <ref loc="LUK 23:3-5">𐴓𐴟𐴑 23‏:3‏-5</ref>; <ref loc="JHN 18:33-38">𐴘𐴡 18‏:33‏-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />𐴀𐴞𐴏𐴝𐴤 𐴇𐴝𐴥𐴑𐴞𐴔 𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴝𐴥𐴑𐴞𐴔𐴠 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴕𐴞𐴥𐴑𐴞؟“</para>
  <para style="p" vid="MAT 27:11">𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴡𐴥𐴘, 𐴃𐴟𐴀𐴛 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝.“</char><verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴔𐴟𐴥𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴒𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴓𐴎𐴝𐴔 𐴓𐴝𐴒𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴎𐴟𐴖𐴝𐴁𐴢 𐴕𐴡𐴥 𐴊𐴠𐴥. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴕𐴡 𐴉𐴟𐴥𐴕𐴡𐴌 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴟𐴓𐴋𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥𐴌؟“ <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴠𐴓𐴎𐴝𐴔𐴡𐴌 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴎𐴟𐴖𐴝𐴁𐴢 𐴕𐴡𐴥 𐴊𐴠, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴝𐴥𐴑𐴞𐴔 𐴀𐴠𐴁𐴧𐴠 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="MAT 27:14" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔</para>
  <para style="r">(<ref loc="MRK 15:6-15">𐴔𐴝𐴑 15‏:6‏-15</ref>; <ref loc="LUK 23:13-25">𐴓𐴟𐴑 23‏:13‏-25</ref>; <ref loc="JHN 18:39-19:6">𐴘𐴡 18‏:39‏—19‏:6</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />𐴇𐴝𐴥𐴑𐴞𐴔𐴡𐴌 𐴕𐴞𐴘𐴡𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴎𐴠 𐴇𐴡𐴊𐴞𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴃𐴡 𐴈𐴡𐴀 𐴇𐴠𐴥 𐴇𐴡𐴊𐴞𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴡𐴕. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴕𐴝𐴔 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴡𐴐𐴟𐴥𐴌 𐴇𐴡𐴊𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴝𐴌 𐴕𐴝𐴔 𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴝𐴌𐴠𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴁𐴝𐴘𐴃𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝𐴌𐴠 𐴕𐴠𐴥, 𐴕𐴝𐴥𐴑𐴞 𐴀𐴞𐴏𐴝𐴤 𐴌𐴠, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴈𐴡𐴀؟“ <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴞𐴓𐴝𐴃𐴠 𐴎𐴝𐴙𐴕𐴃𐴡 𐴊𐴠, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴝𐴥𐴏𐴡𐴌𐴡𐴃𐴢 𐴒𐴡𐴥𐴌𐴞 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠 𐴊𐴠.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />𐴉𐴞𐴓𐴝𐴃𐴢 𐴁𐴞𐴏𐴝𐴌𐴡𐴌 𐴃𐴡𐴑𐴃𐴡𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴀𐴘𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴡𐴖𐴢 𐴖𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴧𐴠 𐴊𐴠, ”𐴇𐴠𐴥 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴘𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴠𐴓𐴢 𐴊𐴠 𐴌𐴝𐴙𐴃𐴧𐴝 𐴀𐴝𐴀𐴛 𐴐𐴡𐴥𐴂𐴧𐴡𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴁𐴞𐴐𐴞𐴤 𐴊𐴟𐴑 𐴉𐴝𐴘𐴧𐴞𐴥.“<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />𐴓𐴠𐴑𐴞𐴕 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴡𐴓𐴡𐴌𐴠 𐴀𐴟𐴏𐴑𐴝𐴘𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, 𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝𐴌𐴠 𐴔𐴝𐴒𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴇𐴡𐴘 𐴁𐴡𐴓𐴧𐴝.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />𐴇𐴝𐴥𐴑𐴞𐴔𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕𐴡𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴝𐴌𐴠𐴤 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴁𐴝𐴘𐴃𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌؟“</para>
  <para style="p" vid="MAT 27:21">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝 𐴌𐴠.“<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴏𐴝𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴈𐴡𐴀, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴑𐴞𐴦 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔؟“</para>
  <para style="p" vid="MAT 27:22">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴡!“<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴑𐴞𐴘𐴝𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴞𐴦 𐴁𐴟𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠𐴥؟“</para>
  <para style="p" vid="MAT 27:23">𐴃𐴡𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌𐴡𐴤 𐴒𐴟𐴎𐴡𐴌𐴞-𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, ”𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴡!“<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />𐴁𐴝𐴦𐴊𐴠 𐴉𐴞𐴓𐴝𐴃𐴠 𐴊𐴠𐴑𐴠𐴥𐴌 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠𐴌, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴟𐴥𐴌𐴟𐴏𐴧𐴟𐴓𐴢 𐴐𐴟𐴥𐴌𐴟 𐴀𐴡𐴥𐴘𐴎𐴝𐴌𐴒𐴡𐴘, 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴝𐴕𐴞𐴥 𐴓𐴡𐴦𐴘𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴢 𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴝𐴘 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴎𐴞𐴔𐴧𐴝 𐴀𐴝𐴀𐴛 𐴕𐴡; 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴎𐴟𐴖𐴝𐴁𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠 𐴊𐴞𐴁𐴝.“<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴎𐴟𐴖𐴝𐴁𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴌 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴎𐴞𐴔𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴘𐴧𐴟𐴔!“<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴝𐴥𐴌𐴝𐴁𐴧𐴝𐴌𐴠 𐴇𐴝𐴥𐴓𐴝𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴐𐴡𐴀𐴣𐴑 𐴔𐴝𐴌𐴝𐴁𐴝𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴒𐴡𐴏𐴝𐴥𐴘 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="MAT 27:26" /></para>
  <para style="s1">𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴃𐴠𐴥𐴐𐴠𐴌𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MRK 15:16-20">𐴔𐴝𐴑 15‏:16‏-20</ref>; <ref loc="JHN 19:2-3">𐴘𐴡 19‏:2‏-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />𐴁𐴝𐴦𐴊𐴠 𐴇𐴝𐴥𐴑𐴞𐴔𐴡𐴌 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴡𐴇𐴡𐴥𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴄𐴠𐴀𐴌𐴝𐴚 𐴄𐴞𐴥𐴘𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴘𐴌𐴡𐴥𐴑𐴟𐴓𐴃𐴟 𐴎𐴡𐴔𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴝𐴙𐴌𐴡𐴌 𐴇𐴡𐴦𐴌 𐴑𐴟𐴥𐴓𐴞𐴉𐴠𐴓𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴓𐴝𐴓𐴢 𐴌𐴡𐴚𐴡𐴌 𐴎𐴟𐴁𐴧𐴝 𐴉𐴞𐴣𐴊𐴝𐴥𐴘𐴊𐴞𐴘𐴠. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴠𐴣𐴍𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴃𐴝𐴏𐴢 𐴁𐴝𐴕𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴊𐴞𐴘𐴝𐴘𐴊𐴞𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴊𐴠𐴕 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴓𐴝𐴍𐴞𐴥 𐴊𐴡𐴥𐴌𐴝𐴊𐴞𐴘𐴠. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴣𐴍𐴟𐴥𐴌 𐴃𐴡𐴥𐴑 𐴊𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴄𐴝𐴥𐴃𐴄𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴇𐴠𐴥𐴘 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝, 𐴃𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴓𐴝𐴔!“ <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴠𐴥𐴂𐴢 𐴔𐴝𐴙𐴅𐴧𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴍𐴞𐴥 𐴖𐴝 𐴓𐴡𐴦𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥 𐴏𐴝𐴥𐴘 𐴁𐴝𐴌𐴞 𐴔𐴝𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴄𐴝𐴥𐴃𐴄𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴓𐴝𐴓𐴢 𐴌𐴡𐴚𐴡𐴌 𐴎𐴟𐴁𐴧𐴝 𐴖𐴝 𐴑𐴟𐴥𐴓𐴞𐴉𐴠𐴓𐴝𐴘 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴞𐴣𐴊𐴝𐴥𐴘𐴊𐴞𐴘𐴠; 𐴁𐴝𐴦𐴊𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥𐴒𐴡𐴘.<verse eid="MAT 27:31" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MRK 15:21-32">𐴔𐴝𐴑 15‏:21‏-32</ref>; <ref loc="LUK 23:26-43">𐴓𐴟𐴑 23‏:26‏-43</ref>; <ref loc="JHN 19:17-27">𐴘𐴡 19‏:17‏-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴁𐴝𐴀𐴌𐴠 𐴕𐴠𐴦𐴓𐴠𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴑𐴟𐴌𐴠𐴕𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴦𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥 𐴎𐴞𐴁𐴝𐴤𐴌 𐴕𐴝𐴔 𐴏𐴝𐴥𐴘𐴔𐴡𐴕; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴑𐴟𐴥𐴌𐴟𐴐𐴢 𐴐𐴝𐴕 𐴁𐴡𐴀𐴘𐴢 𐴓𐴡𐴘𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴅𐴁𐴟𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴒𐴡𐴓𐴒𐴡𐴃𐴝 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴎𐴝𐴒𐴝𐴃𐴢, 𐴘𐴝𐴥𐴕𐴞 𐴔𐴝𐴃𐴝𐴥𐴌 𐴔𐴝𐴓𐴝𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠, <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴞𐴃𐴝 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴔𐴞𐴘𐴝𐴥𐴘𐴧𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴈𐴝𐴥𐴘𐴃𐴡 𐴊𐴞𐴦𐴘𐴠𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴥𐴘 𐴏𐴝𐴀𐴘𐴢 𐴕𐴝𐴥 𐴈𐴝𐴥𐴀. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴓𐴡𐴄𐴝𐴥𐴌𐴞 𐴔𐴝𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌𐴡𐴌𐴠 𐴁𐴝𐴥𐴑 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴦𐴛 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴠. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴒𐴝𐴥𐴕 𐴏𐴝𐴥𐴀𐴘𐴕𐴁𐴟𐴥𐴄𐴢 𐴔𐴝𐴌𐴞𐴊𐴞𐴘𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, <char style="sc">”𐴀𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤, 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝.“</char><verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴡𐴌𐴠 𐴘𐴡𐴥 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴓𐴢, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴕 𐴋𐴝𐴥𐴑 𐴀𐴡𐴃𐴧𐴟. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥 𐴉𐴡𐴣𐴃𐴢 𐴁𐴝𐴥𐴘 𐴎𐴝𐴦𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴃𐴝𐴥 𐴓𐴝𐴌𐴞-𐴓𐴝𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴠𐴥𐴐𐴠𐴌𐴝𐴘 <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴟𐴘 𐴃𐴡 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴢 𐴁𐴝𐴥𐴚𐴒𐴞 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴁𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴊𐴡𐴘𐴝, 𐴘𐴝𐴓𐴝 𐴃𐴟𐴘 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴁𐴝𐴏𐴝 𐴏𐴝𐴥𐴘! 𐴎𐴡𐴊𐴞 𐴃𐴟𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴘.“ <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔, 𐴀𐴝𐴓𐴠𐴔 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴄𐴝𐴥𐴃𐴄𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴌 𐴊𐴠, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />”𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴡 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴊𐴠 𐴁𐴝𐴏𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠𐴌! 𐴀𐴞𐴁𐴝𐴤 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴕𐴡 𐴕𐴠𐴥, 𐴘𐴝𐴓𐴝 𐴀𐴞𐴁𐴝𐴤 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴘𐴧𐴡𐴤𐴑, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴁𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴘𐴟𐴔. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴌𐴝𐴑𐴠𐴥; 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴁𐴝𐴏𐴡𐴗𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴁𐴝𐴤𐴘𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴊𐴠, ’𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝.‘ “ <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />𐴎𐴠 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴢 𐴃𐴟𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝-𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="MAT 27:44" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴔𐴡𐴦𐴃𐴢</para>
  <para style="r">(<ref loc="MRK 15:33-41">𐴔𐴝𐴑 15‏:33‏-41</ref>; <ref loc="LUK 23:44-49">𐴓𐴟𐴑 23‏:44‏-49</ref>; <ref loc="JHN 19:28-30">𐴘𐴡 19‏:28‏-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />𐴇𐴠𐴥 𐴊𐴞𐴕 𐴊𐴟𐴀𐴣𐴙𐴅𐴧𐴝𐴌 𐴁𐴝𐴌𐴡𐴥 𐴖𐴝 𐴁𐴝𐴥𐴎𐴠 𐴓𐴡𐴥𐴃𐴞 𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴁𐴝𐴥𐴎𐴠 𐴉𐴝𐴥𐴕 𐴒𐴟𐴣𐴍𐴝 𐴔𐴟𐴓𐴧𐴟𐴑 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴀𐴡𐴥𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />𐴃𐴞𐴕 𐴕𐴗𐴝𐴥 𐴀𐴝𐴥𐴕𐴞𐴑 𐴁𐴝𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴠𐴓𐴞𐴥, 𐴀𐴠𐴓𐴞𐴥, 𐴓𐴝𐴔𐴝𐴥 𐴏𐴝𐴁𐴝𐴑𐴇𐴄𐴝𐴥𐴕𐴞؟“</char> 𐴘𐴝𐴥𐴕𐴞, <char style="wj">”𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴃𐴟𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴏𐴝𐴥𐴌𐴞𐴊𐴞𐴘𐴡؟“</char><note caller="+" style="f"><char style="fr" closed="false">27‏:46 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:1">𐴎𐴡𐴁𐴟𐴌 22‏:1</ref></char></char></note><verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />𐴇𐴠𐴥𐴍𐴠 𐴃𐴞𐴥𐴘𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴕𐴡𐴁𐴞 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴡𐴌𐴠 𐴋𐴝𐴑𐴠𐴌.“<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴠𐴑𐴧𐴟𐴥 𐴊𐴟𐴣𐴌𐴠 𐴎𐴝𐴘 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴠𐴏𐴉𐴡𐴥𐴕𐴅<note caller="+" style="f"><char style="fr" closed="false">27‏:48 </char><char style="fq">𐴀𐴠𐴏𐴉𐴡𐴥𐴕𐴅</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴞𐴚𐴒𐴞𐴌𐴝𐴎𐴞 𐴓𐴡𐴉𐴎𐴡𐴥, 𐴉𐴟𐴀𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴉𐴝𐴕𐴞𐴥 𐴄𐴝𐴕𐴠 𐴊𐴠 𐴏𐴞𐴎𐴢</note> 𐴓𐴡𐴦𐴘𐴢 𐴏𐴞𐴥𐴌𐴑𐴝𐴃𐴢<note caller="+" style="f"><char style="fr" closed="false">27‏:48 </char><char style="fq">𐴏𐴞𐴥𐴌𐴑𐴝</char> 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴝𐴕𐴞𐴥 𐴔𐴞𐴘𐴝𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴐𐴡𐴥𐴌𐴁𐴡𐴃𐴢, 𐴎𐴞𐴀𐴕 𐴈𐴝𐴥𐴘𐴃𐴠 𐴇𐴡𐴥𐴌𐴡-𐴇𐴡𐴥𐴌𐴡 𐴓𐴝𐴒𐴠.</note> 𐴁𐴟𐴌𐴝𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴟𐴥𐴖𐴝𐴣𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴁𐴝𐴎𐴝𐴥𐴘𐴊𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴌𐴒𐴟𐴥𐴕𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴃𐴞𐴥𐴘𐴡, 𐴀𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴠 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴕𐴠𐴥 𐴏𐴝𐴀𐴘𐴢.“<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴒𐴟𐴎𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴌𐴝𐴕 𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴉𐴡𐴌𐴡𐴊𐴝 𐴒𐴝𐴥𐴕 𐴖𐴡𐴃𐴧𐴟𐴥 𐴓𐴡𐴥𐴃𐴞 𐴕𐴞𐴏𐴠 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴉𐴝𐴥𐴍𐴞 𐴊𐴟𐴘 𐴁𐴝𐴥𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴁𐴝𐴘𐴧𐴠𐴥, 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴐𐴞𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴥𐴍𐴞𐴒𐴞𐴘𐴡𐴘, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />𐴈𐴡𐴁𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴑𐴟𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴦𐴃𐴡𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴞 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴝𐴦𐴌 𐴂𐴝𐴑 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴎𐴝𐴘 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />𐴌𐴡𐴔𐴞 𐴐𐴝𐴥𐴀𐴂𐴢<note caller="+" style="f"><char style="fr" closed="false">27‏:54 </char><char style="ft" closed="false">𐴔𐴝𐴀𐴕𐴞 </char><char style="fqa">𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴉𐴡𐴥𐴗𐴏𐴡𐴌 𐴐𐴝𐴥𐴀𐴂𐴢 𐴎𐴞𐴁𐴝𐴤 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴌𐴡𐴔𐴞𐴘𐴡</char> </note> 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴉𐴝𐴀𐴌𐴝 𐴊𐴞𐴥𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌𐴡𐴤 𐴑𐴞𐴦-𐴑𐴞𐴦 𐴀𐴡𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴦𐴌𐴝𐴘𐴒𐴞𐴘𐴡𐴥𐴘 𐴀𐴝𐴦𐴌 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴞𐴁𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢!“<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴞𐴏𐴝𐴤𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴌𐴡𐴃𐴧𐴟 𐴒𐴡𐴥𐴌𐴞 𐴇𐴞𐴥𐴀𐴕 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴘𐴟𐴏𐴟𐴥𐴉𐴡𐴌 𐴔𐴝𐴦 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴁𐴠𐴊𐴝𐴙𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴔𐴝𐴦 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MAT 27:56" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴝𐴥𐴘𐴧𐴠</para>
  <para style="r">(<ref loc="MRK 15:42-47">𐴔𐴝𐴑 15‏:42‏-47</ref>; <ref loc="LUK 23:50-56">𐴓𐴟𐴑 23‏:50‏-56</ref>; <ref loc="JHN 19:38-42">𐴘𐴡 19‏:38‏-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />𐴇𐴝𐴥𐴣𐴎𐴞𐴕𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴌𐴝𐴥𐴌, 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴌𐴝𐴔𐴝𐴥𐴃𐴞𐴘𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴘𐴟𐴏𐴟𐴥𐴉𐴢 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘 𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴝𐴐𐴧𐴗𐴝 𐴔𐴝𐴙𐴒𐴧𐴠𐴥. 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴉𐴞𐴓𐴝𐴃𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴓𐴝𐴐𐴧𐴗𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />𐴘𐴟𐴏𐴟𐴥𐴉𐴠 𐴓𐴝𐴐𐴧𐴗𐴝 𐴓𐴡𐴦𐴘𐴢, 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴝𐴥𐴉𐴢 𐴇𐴡𐴇𐴡𐴥𐴕𐴡𐴌 𐴇𐴡𐴦𐴌𐴡𐴃𐴢 𐴁𐴠𐴌𐴝𐴤𐴘𐴧𐴠, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴕𐴡𐴘𐴝 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴢 𐴌𐴝𐴙𐴑𐴧𐴠𐴥𐴒𐴡𐴘, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴐𐴞𐴥𐴓𐴢 𐴑𐴟𐴥𐴣𐴊𐴞 𐴁𐴝𐴕𐴝𐴀𐴙𐴓𐴢. 𐴁𐴝𐴦𐴊𐴠 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴔𐴟𐴑𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴋𐴡𐴣𐴀𐴌 𐴐𐴞𐴥𐴓𐴢 𐴀𐴡𐴗𐴎𐴝𐴘𐴊𐴞, 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴇𐴠𐴥𐴍𐴠 𐴈𐴡𐴁𐴡𐴌𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="MAT 27:61" /></para>
  <para style="s1">𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴢 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />𐴃𐴝𐴌𐴉𐴡𐴌 𐴊𐴞𐴕، 𐴎𐴞𐴁𐴝𐴤 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴠𐴥𐴌𐴡𐴐𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴅𐴡𐴕𐴝𐴥𐴁𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴠𐴥 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴢 𐴀𐴞𐴥𐴁𐴝 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠, ’𐴃𐴞𐴕 𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴟𐴔.‘ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴞𐴕 𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴈𐴡𐴁𐴡𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴉𐴝𐴀𐴌𐴝 𐴊𐴞𐴥𐴘𐴝 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴡𐴥; 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴓𐴝𐴐𐴧𐴗𐴝 𐴏𐴟𐴌 𐴒𐴡𐴌𐴞𐴥 𐴓𐴡𐴘𐴎𐴝𐴘 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ’𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘,‘ 𐴃𐴡𐴥𐴘 𐴉𐴞𐴏𐴡𐴥𐴌 𐴊𐴟𐴥𐴑𐴝 𐴀𐴝𐴒𐴡𐴌 𐴊𐴟𐴥𐴑𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴁𐴡.“<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />𐴉𐴞𐴓𐴝𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴘𐴎𐴡, 𐴎𐴝𐴘 𐴎𐴠𐴊𐴧𐴟𐴥𐴌 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴉𐴝𐴌𐴡 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴁𐴡𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴉𐴝𐴀𐴌𐴝 𐴊𐴡𐴥𐴒𐴡𐴘.“ <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴝𐴘 𐴐𐴞𐴥𐴓𐴢 𐴓𐴝𐴕𐴡𐴃𐴢 𐴔𐴡𐴀𐴌 𐴓𐴝𐴒𐴝𐴘 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴠𐴥𐴍𐴠 𐴌𐴝𐴑𐴞𐴥, 𐴈𐴡𐴁𐴡𐴌𐴒𐴗𐴝𐴥𐴌𐴠 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴉𐴝𐴀𐴌𐴝𐴊𐴞𐴘𐴠.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘</para>
  <para style="r">(<ref loc="MRK 16:1-8">𐴔𐴝𐴑 16‏:1‏-8</ref>; <ref loc="LUK 24:1-12">𐴓𐴟𐴑 24‏:1‏-12</ref>; <ref loc="JHN 20:1-10">𐴘𐴡 20‏:1‏-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕 𐴁𐴝𐴦𐴊𐴠, 𐴇𐴝𐴥𐴉𐴃𐴝𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴊𐴞𐴕 𐴉𐴡𐴥𐴎𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴔𐴡𐴌𐴞𐴘𐴝𐴔 𐴔𐴝𐴑𐴊𐴝𐴥𐴓𐴞𐴕𐴞𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴔𐴡𐴌𐴞𐴘𐴝𐴔𐴠 𐴈𐴡𐴁𐴡𐴌𐴒𐴗𐴝𐴥 𐴏𐴝𐴘𐴃𐴡𐴥 𐴒𐴞𐴦𐴘𐴠𐴥.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />𐴀𐴝𐴏𐴞𐴔𐴁𐴞𐴃𐴢 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴋𐴡𐴣𐴀𐴌 𐴁𐴟𐴥𐴏𐴝𐴓𐴢 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴀𐴠𐴑 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴓𐴝𐴙𐴔𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴈𐴡𐴁𐴡𐴌 𐴒𐴗𐴝𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴘𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴑𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴐𐴞𐴥𐴓𐴢 𐴓𐴝𐴕 𐴓𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴙𐴐𐴧𐴠𐴥. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴁𐴞𐴅𐴞𐴓𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴁𐴡𐴌𐴡𐴥𐴑𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴡𐴥𐴓𐴝. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴒𐴟𐴥𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘 𐴇𐴝𐴉𐴞 𐴀𐴟𐴙𐴄𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴔𐴡𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴖𐴝𐴘𐴠 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴕𐴟𐴥𐴕𐴡𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, ”𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴃𐴟𐴖𐴡𐴀𐴌 𐴊𐴠, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴀𐴓𐴢. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴍𐴠𐴥 𐴕𐴝𐴥𐴘; 𐴀𐴞𐴥𐴁𐴝 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴙𐴓𐴢. 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕 𐴏𐴡𐴀𐴒𐴝𐴘.<verse eid="MAT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 28:7" />”𐴘𐴝𐴓𐴝 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴎𐴡𐴦, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ’𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴒𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴎𐴝𐴦𐴌. 𐴇𐴠𐴥𐴍𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥𐴁𐴝!‘ 𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴊𐴞𐴘𐴞.“ <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />𐴃𐴡𐴥𐴘 𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴈𐴡𐴁𐴡𐴌𐴡𐴃𐴧𐴟 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴦𐴌𐴝𐴀𐴙𐴓𐴢, 𐴃𐴡𐴀 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴀𐴙𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴏𐴝𐴤𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕𐴡𐴌𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴊𐴟𐴣𐴌𐴞-𐴊𐴟𐴣𐴌𐴞 𐴒𐴞𐴦𐴘𐴠𐴥. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />𐴀𐴝𐴃𐴞𐴥𐴑𐴧𐴝 𐴀𐴞𐴏𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴧𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴏𐴡𐴥𐴓𐴝𐴔!“</char> 𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴞𐴦𐴘𐴠𐴥 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴦𐴃𐴢 𐴊𐴡𐴥𐴌𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴎𐴡𐴦, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴝𐴓𐴞𐴓𐴡𐴃𐴢 𐴎𐴝𐴘𐴃𐴡 𐴈𐴡𐴀𐴒𐴡𐴘; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴠𐴑𐴞𐴥𐴁𐴡.“</char><verse eid="MAT 28:10" /></para>
  <para style="s1">𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴡𐴥𐴁𐴡𐴌</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />𐴁𐴠𐴍𐴞𐴘𐴝𐴥𐴙𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠, 𐴇𐴡𐴊𐴟𐴥𐴕 𐴉𐴝𐴀𐴌𐴝𐴊𐴝𐴌𐴠 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢, 𐴎𐴞𐴀𐴕-𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />𐴀𐴝𐴦𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴊𐴡𐴓𐴝 𐴀𐴡𐴥𐴘 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴏𐴡𐴥𐴓𐴧𐴝-𐴔𐴡𐴐𐴖𐴝𐴌𐴝 𐴒𐴡𐴌𐴞𐴥, 𐴉𐴡𐴥𐴗𐴏𐴢 𐴏𐴟𐴕𐴡𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴄𐴞𐴛𐴝 𐴊𐴞𐴦𐴘𐴠𐴥, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />𐴀𐴝𐴦𐴌 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ’𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴝𐴙𐴃𐴧𐴝 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴟𐴌 𐴒𐴡𐴌𐴞𐴥 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥𐴒𐴡𐴘.‘ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />𐴎𐴡𐴊𐴞 𐴈𐴡𐴃𐴝𐴤 𐴘𐴝𐴀𐴕 𐴇𐴝𐴥𐴑𐴞𐴔𐴡𐴌 𐴈𐴝𐴕𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴠, 𐴀𐴡𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴟𐴎𐴝𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘𐴧𐴟𐴥𐴔.“ <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />𐴃𐴡𐴥𐴘 𐴇𐴠𐴥 𐴉𐴡𐴥𐴗𐴏𐴢 𐴏𐴟𐴕𐴠𐴥 𐴄𐴞𐴛𐴝 𐴒𐴟𐴥𐴕 𐴓𐴡𐴦𐴘𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴐𐴞𐴥𐴑𐴝𐴘𐴊𐴞𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴀𐴠 𐴑𐴝𐴇𐴝𐴥𐴕𐴞 𐴘𐴝𐴀𐴕 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴙𐴅 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴉𐴡𐴥𐴓𐴝𐴘𐴧𐴝.<verse eid="MAT 28:15" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴌 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔</para>
  <para style="r">(<ref loc="MRK 16:14-18">𐴔𐴝𐴑 16‏:14‏-18</ref>; <ref loc="LUK 24:36-49">𐴓𐴟𐴑 24‏:36‏-49</ref>; <ref loc="JHN 20:19-23">𐴘𐴡 20‏:19‏-23</ref>; <ref loc="ACT 1:6-8">𐴈𐴝𐴔 1‏:6‏-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴠𐴒𐴝𐴌𐴡 𐴎𐴡𐴕 𐴐𐴝𐴥𐴌𐴞𐴃𐴧𐴟𐴕 𐴒𐴝𐴓𐴞𐴓𐴡𐴌 𐴀𐴡 𐴉𐴝𐴀𐴌 𐴒𐴗𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴃𐴢 𐴎𐴝𐴘𐴃𐴡 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴓𐴢. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴐𐴡𐴥𐴀𐴑 𐴓𐴝𐴙𐴒𐴧𐴞𐴥𐴓𐴢. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />𐴇𐴠𐴥𐴃𐴟𐴕𐴡𐴃𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴈𐴡𐴀𐴌 𐴊𐴠, <char style="wj">”𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴘𐴠𐴥.</char> <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" /><char style="wj">𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴡𐴦, 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴁𐴝𐴕𐴡𐴒𐴡𐴥𐴘; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴝𐴉𐴢 𐴀𐴡𐴌, 𐴉𐴟𐴖𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴕𐴝𐴔𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴘𐴡,</char> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" /><char style="wj">𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴠𐴊𐴟𐴥𐴕 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴞, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴡. 𐴀𐴝𐴦𐴌 𐴏𐴡𐴀, 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴞𐴤.“</char> 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>