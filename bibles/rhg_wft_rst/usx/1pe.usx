<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">1 𐴉𐴞𐴃𐴡𐴌</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴉𐴞𐴃𐴡𐴌</para>
  <para style="toc2">1 𐴉𐴞𐴃𐴡𐴌</para>
  <para style="toc3">1𐴉𐴞𐴃𐴢</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">1 𐴉𐴞𐴃𐴡𐴌</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴉𐴞𐴃𐴡𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴉𐴞𐴃𐴡𐴌. 𐴉𐴞𐴃𐴡𐴌𐴠 𐴕𐴞𐴎𐴠 𐴇𐴡𐴕 𐴊𐴠 𐴀𐴝𐴦𐴌 𐴇𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴠𐴥𐴌 𐴊𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴑𐴝𐴥 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 ”𐴉𐴡𐴌𐴁𐴝𐴥𐴐𐴞“ 𐴋𐴝𐴙𐴑𐴧𐴠𐴥 <char style="ior">(<ref loc="1PE 1:1">1‏:1</ref>; <ref loc="1PE 1:17">1‏:17</ref>; <ref loc="1PE 2:11">2‏:11</ref>)</char>. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴡𐴌𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴝𐴌 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴡𐴑-𐴀𐴝𐴓𐴡𐴑 𐴊𐴠𐴐𐴡𐴃𐴢 𐴊𐴡𐴌𐴁𐴡𐴊𐴡𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴀𐴞𐴥𐴉𐴞𐴐𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴞𐴑𐴧𐴝𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴀𐴞𐴥𐴉𐴞𐴐𐴞𐴀𐴡𐴥𐴓𐴢 𐴁𐴝𐴦𐴊𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴇𐴝𐴥𐴙𐴄𐴢-𐴉𐴝𐴣𐴏𐴢 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠. 𐴉𐴞𐴃𐴡𐴌𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴝𐴁𐴞𐴓𐴡𐴕 𐴈𐴡𐴘𐴧𐴠𐴥 <char style="ior">(<ref loc="1PE 5:13">5‏:13</ref>)</char>.</para>
  <para style="ip">𐴉𐴞𐴃𐴡𐴌𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴓𐴠𐴑𐴝𐴥𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴅𐴡𐴏𐴁𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴡𐴕 <char style="ior">(<ref loc="1PE 5:12">5‏:12</ref>)</char>. <char style="ior">(<ref loc="1PE 2:11-3:7">2‏:11‏—3‏:7</ref>)</char>, <char style="xt"><ref loc="EPH 5:18-6:9">𐴀𐴞𐴥𐴉𐴞𐴐𐴞𐴀𐴡𐴥𐴓𐴢 5‏:18‏—6‏:9</ref></char>, 𐴀𐴠𐴊𐴧𐴠 <char style="xt"><ref loc="COL 3:18-4:6">𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴀𐴡𐴥𐴓𐴢 3‏:18‏—4‏:6</ref></char> 𐴀𐴡𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴞𐴓𐴢 𐴇𐴝𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴇𐴠𐴥 𐴃𐴞𐴕𐴞𐴥 𐴇𐴞𐴥𐴏𐴧𐴝𐴘𐴠 𐴉𐴡𐴌𐴞𐴁𐴝𐴌𐴡𐴌 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴝𐴕𐴞𐴁𐴝𐴥𐴌 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴟𐴑 𐴉𐴝𐴘𐴓𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴟𐴎𐴊𐴞𐴘𐴠𐴥.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴉𐴞𐴃𐴡𐴌𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 <char style="ior">(<ref loc="1PE 1:1-2">1‏:1‏-2</ref>) </char></para>
  <para style="io1">2. 𐴕𐴠𐴅𐴝𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴝𐴕𐴝 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴕𐴠𐴅𐴝𐴃𐴡𐴌 𐴑𐴞𐴔𐴡𐴃𐴢 <char style="ior">(<ref loc="1PE 1:3-2:10">1‏:3‏—2‏:10</ref>) </char></para>
  <para style="io1">3. 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴁𐴝𐴥𐴌 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴑𐴞 𐴁𐴡𐴖𐴢 𐴎𐴝𐴔𐴝𐴙𐴌, 𐴒𐴟𐴓𐴝𐴔 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 <char style="ior">(<ref loc="1PE 2:11-4:11">2‏:11‏—4‏:11</ref>) </char></para>
  <para style="io1">4. 𐴊𐴟𐴑 𐴉𐴝𐴘𐴓𐴠 𐴏𐴡𐴁𐴡𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴎𐴢 <char style="ior">(<ref loc="1PE 4:12-5:11">4‏:12‏—5‏:11</ref>) </char></para>
  <para style="io1">5. 𐴐𐴠𐴣𐴍𐴞𐴥𐴌 𐴇𐴡𐴥𐴃𐴡𐴔 <char style="ior">(<ref loc="1PE 5:12-14">5‏:12‏-14</ref>) </char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />𐴀𐴝𐴀𐴛 𐴉𐴞𐴃𐴡𐴌, 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴏𐴝𐴥𐴇𐴝𐴁𐴞.</para>
  <para style="p" vid="1PE 1:1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴡𐴌𐴁𐴡𐴊𐴡𐴌 𐴀𐴡𐴥𐴘 𐴂𐴡𐴕𐴃𐴟𐴏𐴢, 𐴒𐴝𐴓𐴝𐴃𐴞𐴥𐴘𐴝, 𐴑𐴝𐴂𐴧𐴝𐴊𐴡𐴥𐴑𐴞𐴘𐴝, 𐴀𐴠𐴐𐴞𐴥𐴘𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴃𐴟𐴥𐴕𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴉𐴡𐴌𐴁𐴝𐴥𐴐𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴝𐴥𐴑𐴠𐴌, <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴡𐴌 𐴀𐴝𐴒𐴡𐴌𐴞 𐴕𐴞𐴘𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴂𐴝𐴑 𐴁𐴝𐴕𐴝 𐴓𐴡𐴘 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴖𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴐𐴞𐴥𐴄𐴑𐴝𐴘𐴠 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝.</para>
  <para style="p" vid="1PE 1:2">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="1PE 1:2" /></para>
  <para style="s1">𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴐𐴝𐴤</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴉𐴡𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴋𐴡𐴣𐴀𐴌 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴡𐴘𐴝 𐴎𐴡𐴌𐴔𐴡 𐴊𐴞𐴘𐴠𐴥. 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴐𐴝𐴤 𐴉𐴝𐴘𐴧𐴞𐴥, <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴘𐴁𐴝𐴌 𐴎𐴞𐴘𐴝𐴥𐴕 𐴉𐴝𐴥𐴕𐴝 𐴕𐴡, 𐴊𐴝𐴑 𐴕𐴡 𐴉𐴡𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴉𐴝𐴥𐴃𐴢 𐴕𐴡. 𐴇𐴠𐴥 𐴔𐴞𐴌𐴝𐴏𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴘𐴠, <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴀𐴡 𐴕𐴠𐴅𐴝𐴃𐴡𐴓𐴧𐴝 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴀𐴝𐴏𐴡𐴤 𐴎𐴞𐴘𐴝𐴥𐴕 𐴐𐴠𐴥𐴐𐴢 𐴇𐴝𐴓𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴝𐴏𐴠𐴤. <verse eid="1PE 1:5" /><verse number="6" style="v" sid="1PE 1:6" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞, 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴄𐴝𐴙𐴔𐴡𐴓𐴧𐴝 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴠 𐴊𐴟𐴑 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴠𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡. <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴦𐴙𐴕 𐴓𐴡𐴘 𐴎𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴎𐴝𐴒𐴡𐴥𐴘 𐴊𐴠 𐴐𐴟𐴥𐴕𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴑𐴞𐴔𐴡𐴃𐴞, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴝 𐴀𐴝𐴏𐴡𐴥𐴓𐴞𐴘𐴠 𐴎𐴠𐴕 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴃𐴝𐴦𐴌𐴞𐴉𐴢, 𐴔𐴡𐴈𐴞𐴥𐴔𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴝𐴕𐴠𐴤. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡𐴥 𐴊𐴠𐴑𐴡𐴥, 𐴃𐴡𐴀 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤; 𐴀𐴝𐴦𐴌 𐴀𐴠𐴇𐴡𐴥𐴕 𐴕𐴡 𐴊𐴠𐴑𐴡𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴙𐴑𐴧𐴡𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴌𐴝𐴀 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴝𐴁𐴞 𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞, <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴉𐴡𐴀𐴌, 𐴘𐴝𐴥𐴕𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴌𐴟𐴀𐴌 𐴕𐴠𐴅𐴝𐴃𐴢.<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />𐴇𐴠𐴥 𐴕𐴠𐴅𐴝𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴡 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴊𐴞𐴥𐴘𐴝𐴕𐴠 𐴃𐴝𐴓𐴝𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴇𐴝𐴥𐴑𐴞𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴒𐴟𐴕 𐴎𐴝𐴕𐴝𐴀𐴙𐴓𐴢. <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴇𐴝𐴥𐴑𐴞𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴠 𐴌𐴟𐴀 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴑 𐴉𐴝𐴦𐴌 𐴀𐴠𐴊𐴧𐴠 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴉𐴝𐴦𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴠𐴌, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴡𐴣𐴃𐴧𐴞𐴥𐴘𐴝𐴌𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴕 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴞𐴐𐴝𐴥𐴌𐴝 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴝𐴀𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌; 𐴀𐴟𐴀𐴙𐴕 𐴈𐴡𐴀𐴘𐴢 𐴎𐴞𐴀𐴕 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢; 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴇𐴠𐴥 𐴏𐴞𐴎𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴠𐴥.<verse eid="1PE 1:12" /></para>
  <para style="s1">𐴂𐴝𐴑 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴁𐴝𐴥𐴌 𐴋𐴝𐴑</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴠𐴔𐴝𐴑𐴡𐴌𐴠 𐴕𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴦𐴌 𐴀𐴟𐴥𐴣𐴐𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴡 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴑𐴡𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴁𐴡𐴕𐴡, 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴡𐴥 𐴏𐴞𐴕𐴞𐴥𐴃𐴠 𐴀𐴝𐴒𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴠 𐴁𐴟𐴌𐴝 𐴀𐴝𐴎𐴧𐴟 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡 𐴏𐴡𐴓𐴞𐴘𐴡𐴥, <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴡𐴃𐴢 𐴂𐴝𐴑 𐴁𐴡𐴕𐴡; <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴂𐴝𐴑 𐴀𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴂𐴝𐴑.“<note caller="+" style="f"><char style="fr" closed="false">1‏:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 11:44">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 11‏:44</ref>‏,<ref loc="LEV 11:45">45</ref>; <ref loc="LEV 19:2">19‏:2</ref></char></char></note><verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴑𐴃𐴡𐴌𐴉𐴞𐴥𐴘𐴝 𐴏𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴁𐴝𐴉𐴢 𐴋𐴝𐴑𐴡, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴠 𐴉𐴡𐴌𐴁𐴝𐴥𐴐𐴞𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴡𐴦𐴌 𐴌𐴝𐴑𐴞𐴥 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴒𐴡𐴌𐴡𐴤; <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴎𐴠 𐴁𐴠𐴇𐴝𐴌 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴀𐴘𐴓𐴝 𐴈𐴠𐴥𐴕𐴃𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴕𐴝𐴐𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴊𐴠 𐴏𐴞𐴎𐴢 𐴘𐴝𐴥𐴕𐴞 𐴐𐴟𐴥𐴕𐴝-𐴌𐴟𐴉𐴝 𐴓𐴡𐴥𐴘 𐴕𐴡, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴑𐴟𐴥𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴊𐴝𐴑 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀𐴌, 𐴘𐴝𐴥𐴕𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴞𐴔𐴡𐴃𐴞 𐴓𐴡𐴖𐴢 𐴓𐴡𐴘. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴁𐴝𐴏𐴞𐴥𐴌𐴝𐴑𐴝 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴡𐴤, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴞𐴥 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴐𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴠 𐴀𐴡𐴥.<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴔𐴝𐴕𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴡 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴇𐴝𐴥𐴄𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴅𐴡𐴏𐴁𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴞𐴓𐴡𐴃𐴧𐴟 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴡. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴕𐴡𐴘𐴝 𐴒𐴡𐴌𐴞 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴧𐴡 𐴊𐴠, 𐴕𐴝𐴐𐴢 𐴀𐴡𐴥 𐴊𐴠 𐴁𐴞𐴏𐴡𐴃𐴧𐴟 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴝𐴐𐴢 𐴕𐴡 𐴀𐴡𐴥 𐴊𐴠 𐴁𐴞𐴏𐴢 𐴀𐴡𐴃𐴧𐴟, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴑𐴝𐴓𐴝𐴔 𐴀𐴡𐴃𐴧𐴟. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠,</para>
  <para style="q1" vid="1PE 1:24">”𐴇𐴝𐴥𐴀𐴌 𐴔𐴡𐴕𐴞𐴐𐴧𐴡𐴥 𐴑𐴠𐴥𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝,</para>
  <para style="q2" vid="1PE 1:24">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴌𐴟𐴁𐴢 𐴑𐴠𐴥𐴌𐴒𐴗𐴝 𐴉𐴟𐴥𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝.</para>
  <para style="q1" vid="1PE 1:24">𐴑𐴠𐴥𐴌 𐴉𐴟𐴥𐴖𐴝𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴥𐴓𐴢 𐴎𐴡𐴥𐴌𐴞𐴎𐴝𐴒𐴡𐴘,<verse eid="1PE 1:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴑𐴝𐴓𐴝𐴔 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠.“<note caller="+" style="f"><char style="fr" closed="false">1‏:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:6-8">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 40‏:6‏-8</ref></char> </char></note></para>
  <para style="m" vid="1PE 1:25">𐴇𐴠𐴥 𐴑𐴝𐴓𐴝𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴡 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴇𐴝𐴥𐴀𐴌 𐴊𐴟𐴐𐴧𐴡𐴕𐴞, 𐴇𐴝𐴥𐴀𐴌 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴞, 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑𐴞, 𐴌𐴞𐴐𐴝𐴥𐴌𐴞𐴐𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴞𐴉𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />𐴀𐴝𐴦𐴌 𐴕𐴡𐴘𐴝-𐴕𐴡𐴘𐴝 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴇𐴝𐴥𐴄𐴞 𐴊𐴟𐴊𐴢 𐴇𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴠𐴅𐴝𐴃𐴡𐴓𐴧𐴝 𐴁𐴝𐴌𐴝𐴤𐴃𐴢 𐴃𐴝𐴥𐴑𐴡, <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞𐴌 𐴔𐴡𐴎𐴝 𐴉𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴡.<verse eid="1PE 2:3" /></para>
  <para style="s1">𐴎𐴞𐴕𐴊𐴝 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑 𐴑𐴡𐴖𐴔</para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴝 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴑𐴞𐴔𐴡𐴃𐴢 𐴀𐴡𐴓𐴝, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴧𐴡𐴤𐴕𐴠, <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴎𐴞𐴕𐴊𐴝 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴒𐴡𐴥𐴌 𐴁𐴝𐴕𐴝 𐴎𐴝𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴂𐴝𐴑 𐴀𐴞𐴔𐴝𐴔 𐴁𐴡𐴕𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴞𐴀𐴕 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="1PE 2:6">”𐴏𐴡𐴀, 𐴀𐴝𐴀𐴛 𐴏𐴞𐴥𐴘𐴡𐴕𐴡𐴃𐴢 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴌𐴝𐴑𐴞𐴥𐴌,</para>
  <para style="q2" vid="1PE 2:6">𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴑𐴞𐴔𐴡𐴃𐴢 𐴀𐴡𐴓𐴝 𐴑𐴟𐴕𐴝𐴌-𐴉𐴝𐴃𐴧𐴡𐴥𐴌.</para>
  <para style="q1" vid="1PE 2:6">𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴁𐴡,</para>
  <para style="q2" vid="1PE 2:6">𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">2‏:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 28:16">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 28‏:16</ref></char></char></note><verse eid="1PE 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴡𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴇𐴠𐴥 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴑𐴞𐴔𐴡𐴃𐴢 𐴀𐴡𐴓𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴔𐴝𐴕 𐴕𐴟𐴥 𐴀𐴝𐴕𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴘𐴝𐴀𐴕 𐴇𐴝𐴥𐴙𐴄𐴧𐴠:</para>
  <para style="q1" vid="1PE 2:7">”𐴎𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴔𐴞𐴏𐴃𐴞𐴥𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠,</para>
  <para style="q2" vid="1PE 2:7">𐴘𐴞𐴥𐴁𐴝 𐴉𐴝𐴃𐴧𐴡𐴥𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴌𐴟𐴌𐴞 𐴖𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘,“<note caller="+" style="f"><char style="fr" closed="false">2‏:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:22">𐴎𐴡𐴁𐴟𐴌 118‏:22</ref></char> </char></note><verse eid="1PE 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />𐴘𐴝𐴀𐴕 𐴀𐴡𐴥:</para>
  <para style="q1" vid="1PE 2:8">”𐴘𐴞𐴁𐴝𐴤 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴀𐴟𐴅𐴝𐴥𐴄𐴢 𐴇𐴝𐴥 𐴊𐴠 𐴉𐴝𐴃𐴧𐴡𐴥𐴌,</para>
  <para style="q2" vid="1PE 2:8">𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴌𐴝𐴁𐴝 𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴐𐴞𐴥𐴓𐴢.“<note caller="+" style="f"><char style="fr" closed="false">2‏:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:14">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 8‏:14</ref></char></char></note></para>
  <para style="m" vid="1PE 2:8">𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴟𐴅𐴝𐴥𐴄𐴢 𐴇𐴝𐴥 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴝𐴓𐴝𐴔 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴁𐴠 𐴄𐴞𐴥𐴑 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴕𐴡𐴏𐴡𐴥𐴓𐴢, 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴀𐴞𐴔𐴝𐴔, 𐴂𐴝𐴑 𐴑𐴡𐴗𐴔, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴥𐴀𐴏𐴢 𐴁𐴡𐴕𐴊𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴃𐴝𐴦𐴅𐴟𐴙𐴂𐴧𐴝 𐴉𐴡𐴀𐴌𐴡𐴃𐴢 𐴋𐴝𐴈𐴝𐴘 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴞 𐴈𐴝𐴔𐴡𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴡𐴤. <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />𐴀𐴠𐴑 𐴇𐴝𐴓𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢; 𐴀𐴝𐴒𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴌𐴝𐴇𐴝𐴥𐴔 𐴕𐴡𐴥 𐴉𐴡𐴦, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴌𐴝𐴇𐴝𐴥𐴔 𐴉𐴝𐴘𐴧𐴡𐴥.<verse eid="1PE 2:10" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴡</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴁𐴞𐴊𐴠𐴐𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴌𐴁𐴝𐴥𐴐𐴞 𐴁𐴟𐴎𐴞𐴥 𐴅𐴞𐴏𐴞𐴥𐴔𐴞 𐴀𐴝𐴎𐴧𐴟 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴡, 𐴎𐴞𐴀𐴕𐴠 𐴌𐴟𐴀 𐴓𐴡𐴥𐴘 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴠𐴥. <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴄𐴞𐴥𐴑 𐴌𐴝𐴙𐴑𐴧𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴟𐴌𐴝𐴘-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴇𐴡𐴘 𐴀𐴠𐴓𐴎𐴝𐴔 𐴓𐴝𐴒𐴝𐴘𐴓𐴠𐴥 𐴘𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴥𐴓𐴝 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴠𐴑𐴞𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝, 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴊𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴠𐴥.<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴇𐴝𐴥𐴀𐴌 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡: 𐴀𐴞𐴥𐴁𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑 𐴎𐴞𐴁𐴝𐴤 𐴖𐴡𐴌𐴡𐴌 𐴃𐴡𐴑𐴧𐴝𐴃𐴢, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />𐴘𐴝𐴥 𐴇𐴝𐴥𐴑𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴊𐴞𐴉𐴠𐴍𐴝𐴥 𐴎𐴝 𐴊𐴠, 𐴁𐴟𐴌𐴝𐴘 𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴦𐴌 𐴁𐴝𐴥𐴓𐴝 𐴈𐴝𐴔 𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕 𐴁𐴝𐴥𐴓𐴝 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴠𐴑𐴟𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴉𐴝𐴥𐴍𐴝𐴙𐴚𐴒𐴝 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴞𐴎𐴝𐴥𐴔 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴉𐴝𐴌𐴡. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />𐴀𐴝𐴎𐴝𐴊𐴢 𐴉𐴝𐴘𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴎𐴝𐴊𐴞𐴌𐴠 𐴁𐴟𐴌𐴝𐴙𐴌 𐴒𐴟𐴥𐴌𐴡𐴕𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴀𐴝𐴓𐴧𐴝𐴌 𐴋𐴡𐴦𐴌 𐴌𐴝𐴙𐴑𐴧𐴡; 𐴁𐴝𐴀𐴣𐴐𐴧𐴝𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.<verse eid="1PE 2:17" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴑 𐴉𐴝𐴦𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴞𐴎𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴒𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴐𐴞𐴥𐴊𐴝 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴝𐴥𐴀𐴣𐴌 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴡𐴥. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴝𐴀𐴕 𐴃𐴡 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴌𐴝𐴑𐴞𐴥 𐴕𐴝𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞 𐴊𐴟𐴑𐴡𐴌 𐴃𐴡𐴑𐴡𐴓𐴞𐴉𐴢 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴒𐴡𐴌𐴡𐴤𐴕𐴠 𐴉𐴞𐴍𐴝 𐴈𐴡𐴥𐴀 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴑𐴞𐴦 𐴏𐴟𐴥𐴖𐴝𐴁𐴢 𐴀𐴝𐴏𐴠𐴤؟ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴊𐴟𐴑 𐴉𐴡𐴦 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴠𐴥𐴕𐴝 𐴋𐴝𐴑𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴑 𐴉𐴝𐴘 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴌𐴝𐴑𐴞𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴝𐴛𐴘𐴠-𐴈𐴝𐴛𐴘𐴠 𐴏𐴡𐴓𐴡.<verse eid="1PE 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1PE 2:22" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴠𐴥,</para>
  <para style="q2" vid="1PE 2:22">𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴑𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴉𐴠𐴥𐴌𐴡𐴑𐴁𐴝𐴎𐴞 𐴉𐴝𐴦 𐴒𐴞𐴘𐴠𐴥.<note caller="+" style="f"><char style="fr" closed="false">2‏:22 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:9">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 53‏:9</ref> </char> </char></note><verse eid="1PE 2:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="1PE 2:23" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴝𐴙𐴓𐴢 𐴇𐴝𐴥𐴘𐴧𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴟𐴎𐴝𐴕 𐴒𐴝𐴙𐴓𐴢 𐴕𐴡𐴥 𐴊𐴠; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴟𐴑 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴡𐴥𐴔𐴑𐴞 𐴕𐴡𐴥 𐴊𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠. <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴝𐴦𐴃𐴢 𐴒𐴡𐴌𐴞 𐴓𐴡𐴦𐴘𐴢 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴓𐴡𐴘𐴒𐴞𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴒𐴟𐴕𐴝𐴤𐴃𐴧𐴟 𐴔𐴡𐴌𐴞 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴓𐴧𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴈𐴡𐴥𐴔𐴠 𐴁𐴠 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴧𐴡. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴌𐴝𐴏𐴃𐴝𐴃𐴢 𐴎𐴝𐴦𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴏𐴡𐴌𐴡𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴌𐴟𐴀𐴌 𐴏𐴝𐴀𐴏𐴞𐴃𐴝-𐴒𐴡𐴌𐴡𐴤𐴘𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴞𐴥𐴌𐴞 𐴀𐴝𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴥𐴘.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s1">𐴁𐴡𐴖𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴥𐴐𐴡𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />𐴁𐴡𐴖𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴝𐴦𐴎𐴢 𐴑𐴞𐴘𐴠𐴥 𐴑𐴝𐴓𐴝𐴔 𐴕𐴡 𐴔𐴝𐴕𐴞𐴓𐴠𐴥 𐴘𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴡𐴖𐴝𐴥𐴙𐴕 𐴊𐴠 𐴎𐴠𐴕 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴃𐴝𐴤 𐴏𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴍𐴝𐴘 𐴀𐴝𐴕𐴞𐴤 𐴉𐴝𐴌𐴠, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴝𐴘𐴁𐴡𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴂𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴎𐴧𐴡𐴙𐴃𐴧𐴝 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴁𐴝𐴀𐴃𐴧𐴟 𐴇𐴝𐴥𐴣𐴎𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 𐴕𐴝𐴥𐴘, 𐴏𐴟𐴓𐴡𐴌 𐴁𐴞𐴕𐴞𐴏𐴢 𐴁𐴝𐴥𐴚𐴒𐴞, 𐴐𐴟𐴥𐴕𐴝 𐴓𐴡𐴥𐴘 𐴘𐴝𐴥 𐴁𐴝𐴌𐴞𐴥𐴑 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌 𐴉𐴞𐴕𐴊𐴞𐴥; <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴎𐴡𐴌𐴟𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴌𐴠 𐴇𐴝𐴥𐴣𐴎𐴡𐴕, 𐴌𐴟𐴀𐴌 𐴉𐴝𐴥𐴕𐴝 𐴕𐴡 𐴀𐴡𐴥 𐴊𐴠 𐴕𐴡𐴌𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴐𐴞𐴥𐴊𐴝 𐴓𐴡𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴠 𐴁𐴞𐴐𐴞𐴤 𐴑𐴞𐴔𐴡𐴃𐴞. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />𐴀𐴝𐴒𐴡𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴌𐴝𐴑𐴞𐴥𐴃𐴡 𐴊𐴠 𐴂𐴝𐴑 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴝𐴥𐴣𐴎𐴝𐴘𐴃𐴡 𐴊𐴠, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞. <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴑𐴞 𐴏𐴝𐴥𐴌𐴝, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌𐴠 𐴔𐴝𐴓𐴞𐴑 𐴋𐴝𐴑𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴌 𐴃𐴡𐴓𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴡; 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴒𐴡𐴌𐴡𐴤 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴡𐴤 𐴋𐴡𐴦𐴌𐴡𐴌𐴠 𐴉𐴝𐴄𐴧𐴝 𐴕𐴡 𐴊𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴇𐴞𐴥𐴁𐴝𐴌 𐴎𐴞𐴥𐴘𐴝𐴙𐴕 𐴀𐴡𐴥𐴘𐴧𐴡.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />𐴇𐴡𐴥𐴐𐴡𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴁𐴡𐴖𐴝𐴥𐴙𐴕 𐴊𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴟𐴊𐴧𐴞𐴥𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴑𐴡𐴔𐴎𐴟𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴊𐴠 𐴎𐴝𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴔𐴞𐴌𐴝𐴏𐴊𐴝𐴥𐴌 𐴊𐴠 𐴁𐴟𐴎𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴊𐴞𐴘𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴟𐴖𐴝𐴃𐴢 𐴁𐴝𐴎𐴝𐴥 𐴉𐴡𐴘𐴊𐴝 𐴕𐴡.<verse eid="1PE 3:7" /></para>
  <para style="s1">𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴓𐴧𐴝 𐴊𐴟𐴑 𐴉𐴡𐴦𐴕</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴙𐴌 𐴊𐴠, 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴑 𐴔𐴡𐴕 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥, 𐴉𐴠𐴄𐴉𐴟𐴌𐴝𐴕𐴞 𐴌𐴝𐴑𐴡𐴥, 𐴁𐴝𐴥𐴘𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴌𐴝𐴇𐴝𐴥𐴔 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥, 𐴕𐴡𐴌𐴡𐴔 𐴀𐴡𐴥; <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />𐴁𐴟𐴌𐴝𐴙𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴁𐴟𐴌𐴝𐴘 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴒𐴝𐴙𐴓𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴒𐴝𐴙𐴓𐴢 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥; 𐴘𐴝𐴥𐴌𐴁𐴡𐴊𐴡𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴔𐴝𐴙𐴒𐴧𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴠𐴥 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴠 𐴀𐴠𐴥𐴕𐴝 𐴋𐴝𐴈𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴡𐴦. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="1PE 3:10">”𐴎𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴓𐴝𐴒𐴠,</para>
  <para style="q2" vid="1PE 3:10">𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴁𐴝𐴥𐴓𐴝 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴠𐴑𐴞𐴥𐴃𐴠,</para>
  <para style="q1" vid="1PE 3:10">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴎𐴞𐴌𐴡𐴌𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴞 𐴃𐴧𐴟</para>
  <para style="q2" vid="1PE 3:10">𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴣𐴄𐴡𐴌𐴠 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤𐴃𐴧𐴟 𐴏𐴡𐴥𐴣𐴓𐴝𐴌 𐴎𐴡𐴌𐴟𐴌.<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴁𐴟𐴌𐴝𐴙𐴃𐴧𐴟 𐴉𐴞𐴥𐴌𐴞 𐴀𐴝𐴀𐴘𐴢 𐴒𐴡𐴔 𐴔𐴟𐴥𐴕 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌;</para>
  <para style="q2" vid="1PE 3:11">𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴥𐴌𐴝𐴌 𐴎𐴡𐴌𐴟𐴌.<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴏𐴟𐴑 𐴃𐴡 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠,</para>
  <para style="q2" vid="1PE 3:12">𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴝𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴟𐴖𐴝 𐴉𐴟𐴥𐴕𐴠;</para>
  <para style="q1" vid="1PE 3:12">𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴁𐴟𐴊𐴢 𐴁𐴟𐴌𐴝𐴘-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢.“<note caller="+" style="f"><char style="fr" closed="false">3‏:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 34:12-16">𐴎𐴡𐴁𐴟𐴌 34‏:12‏-16</ref></char></char></note><verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴒𐴡𐴔 𐴔𐴟𐴥𐴕 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴅𐴡𐴏𐴁𐴝 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴃𐴞-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴇𐴡𐴕؟ <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴊𐴟𐴑 𐴉𐴝𐴦 𐴉𐴡𐴌𐴠 𐴘𐴡𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴟𐴁𐴝𐴌𐴠𐴑. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴡𐴥𐴔𐴑𐴞𐴌𐴠 𐴕𐴡 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴏𐴞𐴕𐴃𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴂𐴝𐴑 𐴔𐴝𐴕𐴞𐴘𐴡𐴥. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴝𐴐𐴝𐴤𐴌 𐴖𐴝𐴅𐴝𐴤 𐴃𐴝𐴊𐴝𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴃𐴝𐴥𐴙𐴑𐴧𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴞𐴃𐴠 𐴕𐴡𐴌𐴡𐴔𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴠 𐴊𐴞𐴘𐴡, <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />𐴀𐴝𐴦𐴌 𐴊𐴞𐴓𐴢 𐴀𐴡𐴥 𐴏𐴝𐴥𐴉𐴢 𐴌𐴝𐴙𐴑𐴧𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴝𐴥𐴓𐴝 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴡𐴌𐴠 𐴒𐴝𐴙𐴓𐴢 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴀𐴡𐴥. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴊𐴟𐴑 𐴉𐴝𐴦𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴀𐴡𐴥𐴘𐴓𐴠 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴊𐴟𐴑 𐴉𐴝𐴦 𐴃𐴡 𐴁𐴠𐴀𐴃𐴡𐴌. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴘𐴡𐴥 𐴊𐴠 𐴒𐴟𐴕𐴝𐴤 𐴓𐴧𐴝 𐴀𐴠𐴑𐴁𐴝𐴌 𐴊𐴟𐴑 𐴉𐴝𐴀𐴙𐴓𐴢 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴝𐴥𐴕𐴞 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴒𐴗𐴝𐴥𐴘𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴡𐴘𐴎𐴝𐴘 𐴉𐴝𐴌𐴠. 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴌𐴟𐴀𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴇𐴝𐴥𐴓𐴡𐴃𐴠 𐴀𐴞𐴥𐴁𐴝 𐴎𐴝𐴘 𐴁𐴡𐴕𐴊𐴞𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴌𐴟𐴀 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴝𐴒𐴠 𐴕𐴟𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴑𐴞𐴐𐴄𐴞 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴡𐴥𐴌 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴇𐴠𐴥 𐴑𐴞𐴐𐴄𐴞 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴔, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴣𐴐𐴄𐴡 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠 𐴉𐴝𐴕𐴞𐴥𐴃𐴧𐴟 𐴁𐴝𐴙𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />𐴇𐴠𐴥 𐴉𐴝𐴕𐴞𐴥 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕, 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴁𐴝. 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴕 𐴒𐴝𐴦𐴌 𐴇𐴡𐴣𐴏𐴝𐴌𐴝 𐴊𐴟𐴌 𐴒𐴡𐴌𐴡𐴤𐴕 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴉𐴢 𐴊𐴞𐴓𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴌𐴡𐴏𐴢. 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴁𐴝 𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝, <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠, 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴔𐴝𐴕𐴠.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴓𐴧𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴡𐴕</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴃𐴢 𐴊𐴟𐴑 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴘𐴡𐴥 𐴀𐴠𐴑𐴞𐴤 𐴕𐴞𐴘𐴡𐴃𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴡𐴤; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴃𐴢 𐴊𐴟𐴑 𐴉𐴝𐴘𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴝𐴊𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴠, <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />𐴃𐴡𐴥𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴝𐴑𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴡𐴕𐴐𐴝𐴥𐴘𐴠 𐴀𐴝𐴌 𐴕𐴡 𐴈𐴝𐴍𐴝, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥𐴘𐴠 𐴁𐴠 𐴈𐴝𐴍𐴝. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />𐴒𐴞𐴦𐴘𐴡𐴥𐴘 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴀𐴙𐴕 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴑𐴝𐴉𐴞𐴥 𐴄𐴝𐴙𐴔 𐴈𐴝𐴍𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴡 𐴎𐴞𐴀𐴕 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴌𐴠𐴥; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴀𐴕𐴡𐴃𐴢 𐴁𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴀𐴘𐴓𐴝: 𐴁𐴡𐴊𐴔𐴝𐴐𐴞, 𐴑𐴟𐴑𐴞𐴥𐴘𐴝𐴓𐴢, 𐴕𐴞𐴐𐴝𐴥𐴁𐴝𐴎𐴞, 𐴀𐴝𐴋𐴧𐴝𐴁𐴝𐴎𐴞, 𐴕𐴞𐴐𐴝𐴥𐴌 𐴔𐴠𐴓𐴝-𐴐𐴡𐴥𐴁𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴞𐴥𐴕𐴝𐴘𐴞 𐴔𐴟𐴃𐴧𐴞 𐴉𐴟𐴣𐴎𐴝. <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴘𐴝𐴐𐴞-𐴑𐴟𐴥𐴐𐴞𐴃𐴢 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴟𐴌𐴝-𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴀. <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴟𐴁𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴥𐴏𐴝𐴉𐴢 𐴊𐴞𐴥𐴘𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴎𐴞𐴁𐴝𐴤 𐴎𐴞𐴕𐴊𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴠𐴥𐴕𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴞 𐴇𐴝𐴥𐴓𐴡𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴌𐴟𐴀𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴠.<verse eid="1PE 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />𐴃𐴝𐴔𐴝𐴥𐴔 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴡𐴥𐴃𐴡𐴔 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴑𐴡 𐴀𐴠𐴊𐴧𐴠 𐴀𐴟𐴥𐴣𐴐𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴡. <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />𐴀𐴠𐴁𐴧𐴠 𐴎𐴡𐴌𐴟𐴌𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴅𐴡𐴏𐴁𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴥𐴉𐴝𐴘 𐴌𐴝𐴑𐴠𐴥. <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />𐴕𐴡 𐴔𐴡𐴕𐴔𐴡𐴕𐴝𐴘 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴠𐴀𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴒𐴡𐴌𐴡𐴤. <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />𐴎𐴠𐴦 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴡𐴥, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴁𐴝𐴥𐴓𐴝 𐴔𐴝𐴎𐴞𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴡𐴤. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴡𐴥𐴗𐴑; 𐴎𐴠𐴦 𐴑𐴞𐴘𐴠𐴥 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴊𐴠𐴦 𐴊𐴠 𐴃𐴡𐴖𐴉𐴞𐴥𐴑𐴠 𐴁𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥. 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴦𐴏𐴃𐴌𐴞 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴞𐴥𐴁𐴝𐴌. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="1PE 4:11" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴊𐴟𐴑 𐴉𐴡𐴦𐴕</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴠 𐴀𐴡𐴦𐴘𐴕𐴞 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴞𐴀𐴕 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝, 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴡𐴏𐴞𐴕 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴡𐴥𐴌 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡, <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴠𐴃𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴌 𐴇𐴠𐴥𐴃𐴡 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴟𐴥𐴐𐴞𐴌 𐴖𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />𐴎𐴡𐴊𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴝𐴔𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴀𐴡𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴟𐴁𐴝𐴌𐴠𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴓𐴝 𐴌𐴟𐴀, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />𐴊𐴟𐴑 𐴉𐴝𐴘𐴓𐴠 𐴘𐴡, 𐴏𐴝𐴘𐴧𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴎𐴠𐴕 𐴑𐴟𐴥𐴕𐴞, 𐴏𐴟𐴌𐴞, 𐴁𐴟𐴌𐴝𐴘-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴘𐴝𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴔𐴝𐴦𐴔𐴠𐴓𐴝𐴃𐴢 𐴕𐴝𐴑 𐴒𐴡𐴥𐴓𐴝𐴘𐴊𐴞 𐴊𐴟𐴑 𐴕𐴡 𐴉𐴝𐴦, <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴊𐴟𐴑 𐴉𐴝𐴦, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴡 𐴐𐴡𐴥𐴌𐴔𐴡𐴑, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴠𐴥 𐴉𐴡𐴌𐴞𐴏𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴡𐴥𐴗𐴑. <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴞𐴏𐴝𐴌𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴃𐴡 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴁𐴞𐴏𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴡𐴌𐴞𐴁𐴝𐴌𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴁𐴠 𐴐𐴟𐴥𐴌𐴟 𐴀𐴡𐴥𐴌. 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴐𐴟𐴥𐴌𐴟 𐴀𐴡𐴥𐴌 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴑𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥؟ <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />𐴀𐴝𐴦𐴌,</para>
  <para style="q1" vid="1PE 4:18">”𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴃𐴠 𐴔𐴡𐴐𐴑𐴞𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠,</para>
  <para style="q2" vid="1PE 4:18">𐴁𐴠𐴊𐴞𐴕𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴑𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴉𐴝𐴥𐴣𐴓𐴧𐴝𐴌؟“<note caller="+" style="f"><char style="fr" closed="false">4‏:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 11:31">𐴔𐴠𐴀𐴏𐴝𐴓𐴢 11‏:31</ref></char></char></note><verse eid="1PE 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴊𐴟𐴑 𐴉𐴝𐴦𐴌 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕𐴡𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴉𐴡𐴘𐴊𐴝𐴒𐴡𐴌𐴡𐴤𐴘𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡𐴗𐴑.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴎𐴝𐴥𐴑</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠, 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴌 𐴀𐴠𐴎𐴧𐴡𐴕 𐴒𐴡𐴁𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴃𐴢 𐴀𐴡𐴥 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴡𐴥𐴘𐴧𐴟𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴌: <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴎𐴝𐴥𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴡𐴌𐴡, 𐴘𐴞𐴥𐴁𐴝𐴌 𐴏𐴝𐴀𐴏𐴞𐴃𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴊𐴠 𐴔𐴡𐴅𐴁𐴟𐴌𐴞𐴘𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴘𐴧𐴡𐴌𐴠; 𐴕𐴝𐴎𐴝𐴘𐴠𐴏𐴢 𐴕𐴡𐴉𐴝𐴤𐴌 𐴀𐴝𐴐𐴝𐴤𐴘𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴎𐴧𐴟𐴘𐴠; <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴕𐴡 𐴏𐴡𐴓𐴝𐴘𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴠𐴥 𐴏𐴡𐴥𐴀𐴓𐴡𐴌 𐴎𐴝𐴥𐴑𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴡𐴔𐴟𐴕𐴝 𐴁𐴡𐴙𐴕𐴧𐴡. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />𐴃𐴡𐴥𐴘 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴋𐴡𐴣𐴀𐴌 𐴏𐴡𐴌𐴡𐴘𐴝 𐴖𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴃𐴝𐴏𐴢 𐴉𐴝𐴘𐴁𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴝𐴐𐴢 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡.<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />𐴀𐴡𐴥 𐴅𐴟𐴖𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡. 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴐𐴞𐴥𐴊𐴝𐴘𐴞𐴌𐴠 𐴉𐴞𐴣𐴊𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥,</para>
  <para style="q1" vid="1PE 5:5">”𐴀𐴝𐴓𐴧𐴝 𐴉𐴡𐴇𐴡𐴥𐴌 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴃𐴞𐴥𐴘𐴝,</para>
  <para style="q2" vid="1PE 5:5">𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥.“<note caller="+" style="f"><char style="fr" closed="false">5‏:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 3:34">𐴔𐴠𐴀𐴏𐴝𐴓𐴢 3‏:34</ref></char></char></note><verse eid="1PE 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="1PE 5:6" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴖𐴝𐴓𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴟𐴣𐴏𐴡𐴓𐴡𐴃𐴢 𐴃𐴟𐴓𐴠𐴥. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴥𐴀𐴌 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴋𐴝𐴥𐴓𐴞𐴊𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴥𐴘𐴝𐴕 𐴌𐴝𐴑𐴠𐴥.<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />𐴀𐴟𐴥𐴣𐴐𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴡, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴑𐴡; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴢, 𐴒𐴟𐴎𐴡𐴌𐴠 𐴊𐴠 𐴐𐴞𐴥𐴚𐴒𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴟𐴥𐴌𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴝𐴌𐴠𐴤 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴃𐴝𐴓𐴝𐴐𐴠. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴢 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴃𐴝𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌 𐴔𐴟𐴑𐴝𐴁𐴠𐴓𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴀𐴠𐴑𐴞𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴦𐴌.<verse eid="1PE 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 5:10" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴄𐴝𐴙𐴔 𐴊𐴟𐴑 𐴉𐴝𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴇𐴝𐴥𐴀𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴃𐴢 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴝𐴑𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴁𐴡𐴓𐴢 𐴊𐴞𐴦𐴁𐴡, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴞𐴥𐴘𐴝𐴒𐴝𐴌𐴝𐴘𐴁𐴡. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴦𐴏𐴃𐴌𐴞 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="1PE 5:11" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />𐴀𐴝𐴀𐴛 𐴀𐴠 𐴁𐴝𐴍𐴞𐴥 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠, 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴁𐴝𐴥𐴘 𐴁𐴡𐴓𐴞 𐴒𐴡𐴕𐴞 𐴊𐴠 𐴏𐴞𐴥𐴓𐴖𐴝𐴕𐴟𐴏𐴡𐴌 𐴀𐴝𐴥𐴃𐴝 𐴓𐴠𐴙𐴑𐴧𐴞𐴥 𐴊𐴠. 𐴘𐴝𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴅𐴡𐴏𐴁𐴝 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴌 𐴊𐴠 𐴑𐴞, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢. 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴃𐴝𐴥𐴑𐴡.<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />𐴁𐴝𐴁𐴞𐴓𐴡𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠, 𐴘𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌; 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝 𐴔𐴝𐴌𐴑𐴟𐴏𐴠 𐴘𐴡𐴥 𐴎𐴝𐴕𐴝𐴌. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴂𐴝𐴑 𐴊𐴞𐴓𐴠 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴡.</para>
  <para style="p" vid="1PE 5:14">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴡𐴤 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>