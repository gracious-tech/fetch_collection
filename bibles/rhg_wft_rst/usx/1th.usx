<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">1 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc2">1 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc3">1𐴃𐴞𐴏𐴢</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">1 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 <char style="ior">(<ref loc="1TH 1:1">1‏:1</ref>)</char>. 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠, 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴎𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴘𐴁𐴠𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴌 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢-𐴀𐴠𐴑 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴑𐴡𐴥𐴌𐴞𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴑𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴇𐴠𐴥 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴀𐴡𐴣𐴃𐴧𐴠𐴤 𐴁𐴝𐴕𐴝𐴀𐴙𐴓𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴡𐴌 𐴈𐴝𐴔𐴡𐴃𐴢 𐴒𐴞𐴀𐴓𐴢 (<char style="xt"><ref loc="ACT 17:1-10">𐴈𐴝𐴔𐴡𐴥𐴓𐴢 17‏:1‏-10</ref></char>). 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴈𐴝𐴔𐴡𐴥𐴓𐴡𐴌 𐴎𐴞𐴑𐴞𐴥𐴌 𐴔𐴡𐴎𐴞𐴕، 𐴇𐴠𐴥 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴒𐴞𐴌𐴞𐴥𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴥𐴘 𐴁𐴝𐴕𐴝 𐴒𐴞𐴘𐴠𐴥.</para>
  <para style="ip">𐴇𐴠𐴥 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝 𐴁𐴝𐴕𐴝𐴘 𐴁𐴝𐴦𐴊𐴠, 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴑𐴝𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴊𐴞𐴕 𐴃𐴝𐴥𐴑𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴉𐴡𐴌𐴠𐴎𐴝𐴘 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴇𐴠𐴥𐴍𐴞𐴘𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴧𐴠 𐴊𐴠. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴁𐴞𐴐𐴞𐴤 𐴔𐴡𐴗𐴎𐴟𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤. 𐴘𐴞𐴁𐴝𐴤𐴃𐴢 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴝𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥 𐴇𐴠𐴥𐴃𐴝𐴂𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴑𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴇𐴠𐴥 𐴔𐴡𐴗𐴎𐴟𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴊𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴃𐴡 𐴊𐴠 𐴀𐴡𐴥𐴘𐴁𐴡. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴝𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴓𐴠𐴑𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴅𐴡𐴏𐴁𐴝 𐴊𐴞𐴘𐴠𐴥 𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴡𐴏𐴡𐴥𐴕𐴊𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝 <char style="ior">(<ref loc="1TH 5:6-8">5‏:6‏-8</ref>)</char>.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴝𐴕𐴝 <char style="ior">(<ref loc="1TH 1:1-10">1‏:1‏-10</ref>) </char></para>
  <para style="io1">2. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴘𐴠 𐴀𐴝𐴙𐴕𐴧𐴞𐴤𐴓𐴢 𐴊𐴠 𐴈𐴡𐴥𐴁𐴡𐴌 <char style="ior">(<ref loc="1TH 2:1-3:13">2‏:1‏—3‏:13</ref>) </char></para>
  <para style="io1">3. 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴝𐴀𐴌𐴠 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴌 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 <char style="ior">(<ref loc="1TH 4:1-5:15">4‏:1‏—5‏:15</ref>) </char></para>
  <para style="io1">4. 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴉𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 <char style="ior">(<ref loc="1TH 5:16-28">5‏:16‏-28</ref>) </char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴏𐴞𐴥𐴓𐴖𐴝𐴕𐴟𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤.</para>
  <para style="p" vid="1TH 1:1">𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴑𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤:</para>
  <para style="p" vid="1TH 1:1">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="1TH 1:1" /></para>
  <para style="s1">𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴀𐴞𐴔𐴝𐴕</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴟𐴖𐴝𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴘𐴝𐴦𐴊𐴢 𐴌𐴝𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴠 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠 𐴈𐴝𐴔 𐴀𐴡𐴌𐴠, 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴀𐴡𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴐𐴝𐴤 𐴌𐴝𐴑𐴞𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌𐴠 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴐𐴧𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴃𐴧𐴞 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥; <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴝𐴊𐴡𐴌𐴁𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴈𐴡𐴃𐴝𐴤𐴘𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴁𐴡𐴓𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴠𐴑𐴞𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴘𐴡𐴥. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴀𐴘𐴓𐴝𐴔. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝, 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴊𐴞𐴦𐴘𐴝 𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴕𐴡𐴔𐴟𐴕𐴝 𐴔𐴡𐴎𐴞𐴕 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴀𐴘𐴓𐴝. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴑𐴝𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴕𐴡𐴔𐴟𐴕𐴝 𐴁𐴡𐴕𐴞𐴒𐴞𐴘𐴡𐴥𐴒𐴡𐴘. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴑𐴝𐴓𐴝𐴔 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴑𐴝𐴘𐴝𐴃𐴢 𐴉𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴀𐴠𐴀𐴕 𐴉𐴡𐴥𐴓𐴞𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴡𐴖𐴝𐴤 𐴕𐴡 𐴉𐴡𐴌𐴠. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴝𐴔 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴔𐴟𐴃𐴧𐴞 𐴉𐴟𐴣𐴎𐴝 𐴁𐴝𐴊𐴢 𐴊𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴟𐴎𐴟 𐴉𐴞𐴥𐴌𐴞 𐴀𐴝𐴀𐴘𐴢 𐴎𐴞𐴕𐴊𐴝 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴡𐴤 𐴊𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴞𐴎𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴀, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴈𐴡𐴀 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴡𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤 𐴌𐴠, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘𐴁𐴡𐴥.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s1">𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴑𐴝𐴃𐴢 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴞 𐴈𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴝𐴔 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴠𐴇𐴝𐴌 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴎𐴝𐴕𐴡 𐴊𐴠 𐴑𐴞, 𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴞 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴊𐴟𐴑 𐴉𐴝𐴀𐴘𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴀𐴡𐴥𐴘𐴓𐴝𐴔. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴞𐴐𐴞𐴤 𐴁𐴝𐴎𐴝𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴘𐴡, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴃𐴧𐴟 𐴕𐴡, 𐴇𐴡𐴕𐴡𐴤 𐴕𐴝𐴉𐴝𐴑 𐴘𐴝𐴥 𐴉𐴠𐴥𐴌𐴡𐴑𐴁𐴝𐴎𐴞𐴌 𐴕𐴞𐴘𐴡𐴃𐴠 𐴘𐴡𐴥 𐴕𐴡. <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴓𐴝𐴦𐴘𐴠𐴑 𐴁𐴝𐴥𐴉𐴞 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴎𐴞𐴔𐴧𐴝 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴠𐴥 𐴔𐴡𐴎𐴞𐴕 𐴁𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥. 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴎𐴝𐴏𐴝𐴘 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴠. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴟𐴓𐴝𐴤𐴊𐴞𐴘𐴝 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴓𐴝𐴓𐴡𐴥𐴏𐴡𐴌 𐴕𐴞𐴘𐴡𐴃𐴠 𐴇𐴡𐴕𐴡𐴤 𐴁𐴝𐴇𐴝𐴤𐴕𐴝 𐴊𐴞𐴘𐴞𐴥 𐴊𐴠 𐴘𐴡𐴥 𐴕𐴝𐴥𐴘. 𐴀𐴝𐴓𐴧𐴝 𐴒𐴡𐴁𐴝𐴤 𐴀𐴝𐴏𐴠𐴤. <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴉𐴝𐴘𐴃𐴡 𐴘𐴡𐴥 𐴏𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴕𐴡𐴥 𐴏𐴝𐴀𐴘𐴢 𐴀𐴝𐴦𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴞𐴘𐴡𐴥𐴃𐴧𐴟 𐴘𐴡𐴥 𐴕𐴡𐴥 𐴏𐴝𐴀𐴘𐴢. 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴝𐴘𐴃𐴝𐴥𐴔 𐴁𐴡𐴥𐴓𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴙𐴃𐴧𐴝𐴔. <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴐𐴞𐴥𐴊𐴝 𐴀𐴡𐴥𐴘 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴝𐴔, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴔𐴝𐴦𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴉𐴝𐴓𐴠. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴊𐴡𐴌 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴐𐴟𐴥𐴊𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴑𐴟𐴥𐴐𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴃𐴡 𐴘𐴡𐴥 𐴑𐴟𐴥𐴐𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴟𐴥𐴁𐴢 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘.<verse eid="1TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴟𐴑 𐴀𐴠𐴊𐴧𐴠 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴘𐴝𐴦𐴊𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴞𐴕𐴠 𐴌𐴝𐴘𐴃𐴠 𐴈𐴝𐴔 𐴀𐴡𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴟𐴓𐴝𐴂𐴢 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴝𐴘𐴒𐴡𐴥𐴘.<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴒𐴡𐴁𐴝𐴤 𐴀𐴝𐴏𐴡𐴤 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝 𐴘𐴡𐴥 𐴒𐴡𐴁𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴇𐴡𐴃𐴡𐴥 𐴂𐴝𐴑, 𐴏𐴡𐴥𐴘𐴧𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴁𐴝𐴉𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔, 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴞𐴥𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴎𐴢 𐴊𐴞𐴓𐴝𐴤𐴔 𐴊𐴠 𐴑𐴞, <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴡, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴋𐴝𐴑𐴠𐴌.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴘𐴡𐴥 𐴓𐴝𐴒𐴝𐴃𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴒𐴡𐴌𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠. 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴈𐴝𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴟𐴀𐴙𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴞𐴀𐴕 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴑𐴡𐴗𐴔𐴡𐴃𐴧𐴟 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴟𐴓𐴟𐴥𐴔 𐴉𐴝𐴘𐴧𐴡𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴑𐴡𐴗𐴔 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴉𐴝𐴀𐴙𐴓𐴢, <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴘𐴡𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴙𐴓𐴢, 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴡𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴙𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴘𐴡𐴥 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴉𐴡𐴏𐴡𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴟𐴐𐴧𐴡𐴕𐴞 𐴒𐴡𐴌𐴠𐴥. <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴡 𐴁𐴡𐴓𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴃𐴝𐴌𐴝𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴕𐴡 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴌𐴠𐴥. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴓𐴡𐴥𐴘 𐴒𐴟𐴕𐴝𐴤𐴌 𐴐𐴞𐴥𐴔𐴝 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴉𐴡𐴀𐴣𐴏𐴠𐴒𐴝𐴘. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="1TH 2:16" /></para>
  <para style="s1">𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘𐴁𐴝𐴌 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴝𐴎𐴧𐴟</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />𐴔𐴡𐴕𐴃𐴡𐴌, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴠𐴇𐴡𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴄𐴝𐴙𐴔𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴡𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴅𐴞𐴏𐴞𐴥𐴔 𐴊𐴟𐴌𐴠𐴥 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴑 𐴊𐴠𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴎𐴧𐴟𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴘𐴃𐴡𐴤 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴧𐴠𐴥. 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴁𐴝𐴌𐴁𐴝𐴥𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴝𐴎𐴝𐴥 𐴊𐴞𐴥𐴘𐴠. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴘𐴁𐴡𐴤 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴐𐴝𐴤, 𐴑𐴟𐴥𐴐𐴞 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴙𐴌 𐴃𐴝𐴏𐴢 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤؟ 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴕𐴠𐴥؟ <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴘, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴟𐴥𐴐𐴞.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴌 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴌, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴃𐴠𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴠𐴑𐴠𐴥𐴓𐴝 𐴃𐴝𐴥𐴀𐴘𐴎𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴁𐴝𐴥𐴉𐴞 <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴥𐴘 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴞, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴞 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴅𐴡𐴏𐴁𐴝 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝, <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />𐴎𐴠𐴀𐴕𐴠 𐴀𐴠 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴞𐴀𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴉𐴞𐴏𐴧𐴝𐴥 𐴕𐴡 𐴎𐴡𐴦𐴒𐴡𐴥𐴘. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴓𐴧𐴝 𐴁𐴠 𐴄𐴞𐴥𐴑 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴈𐴡𐴖𐴝𐴤𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴡𐴥𐴘𐴁𐴡. 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴝𐴕𐴡, 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴘𐴡𐴥. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴀𐴛 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴌 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴞𐴌, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴏𐴝𐴘𐴃𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴞 𐴊𐴠; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴋𐴡𐴦𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴟𐴥𐴑𐴝 𐴊𐴞𐴥𐴘𐴠 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴁𐴠𐴉𐴡𐴥𐴎𐴟𐴓𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴇𐴡𐴥𐴕 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴁𐴝𐴥𐴓𐴝 𐴈𐴡𐴥𐴁𐴡𐴌 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴁𐴝𐴥𐴓𐴝 𐴁𐴝𐴥𐴉𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥𐴃𐴡 𐴀𐴠𐴊𐴧𐴟𐴥𐴌 𐴀𐴝𐴎𐴧𐴟 𐴓𐴝𐴒𐴠𐴌 𐴎𐴠𐴊𐴧𐴟𐴥𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴠𐴑𐴞𐴥𐴃𐴡 𐴀𐴝𐴎𐴧𐴟 𐴓𐴝𐴒𐴠𐴌. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴉𐴝𐴘𐴧𐴞𐴥. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡𐴘𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘𐴧𐴞𐴥 𐴉𐴝𐴥𐴕 𐴓𐴝𐴒𐴠𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴝𐴏𐴡𐴤. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴎𐴠 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴥𐴐𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴞. <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴝𐴘𐴃𐴠 𐴊𐴞𐴕𐴠 𐴉𐴟𐴌𐴝 𐴊𐴞𐴓𐴔𐴡𐴕 𐴊𐴞 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴑 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴞 𐴉𐴝𐴥𐴕, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴈𐴡𐴔𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞 𐴉𐴝𐴥𐴕.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴢 𐴕𐴞𐴎𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴌𐴝𐴏𐴃𐴝 𐴒𐴡𐴌𐴞𐴥𐴊𐴡𐴗𐴑. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />𐴔𐴝𐴓𐴞𐴑𐴠 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴁𐴝𐴀𐴘𐴢 𐴉𐴡𐴌𐴠, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴡𐴥 𐴎𐴠𐴕 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴥𐴘 𐴁𐴝𐴀𐴘𐴢 𐴉𐴡𐴌𐴠, <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴕𐴞𐴎𐴡𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑 𐴄𐴡𐴥𐴀𐴌𐴡.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴐𐴞𐴥𐴑𐴧𐴡, 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴓𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴐𐴡𐴥𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴓𐴡𐴀𐴌 𐴀𐴡𐴥. 𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴕𐴝𐴔𐴠 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴌𐴡𐴤 𐴏𐴡𐴓𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴞𐴦𐴘𐴝 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴞𐴦-𐴑𐴞𐴦 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴘𐴞𐴥.<verse eid="1TH 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴏𐴝𐴀 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴂𐴝𐴑 𐴀𐴡𐴥; 𐴘𐴝𐴥𐴕𐴞 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴠𐴕𐴝𐴤𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴑𐴡; <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />𐴀𐴝𐴦𐴌 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴦𐴌𐴠 𐴂𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴏𐴡𐴥𐴣𐴓𐴞 𐴌𐴝𐴑𐴞𐴥 𐴎𐴝𐴕𐴡, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴀𐴝𐴎𐴧𐴟 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴞 𐴕𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥 𐴊𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴒𐴡𐴌𐴠𐴥. <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />𐴀𐴝𐴌𐴡𐴤 𐴏𐴝𐴀 𐴊𐴠 𐴑𐴞, 𐴇𐴠𐴥 𐴔𐴡𐴏𐴡𐴥𐴓𐴝 𐴓𐴡𐴥𐴘 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴡𐴌 𐴇𐴡𐴥𐴃𐴞 𐴕𐴡 𐴒𐴡𐴌𐴡𐴥𐴗𐴑 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴡 𐴃𐴟𐴓𐴡𐴥𐴗𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴓𐴞𐴑𐴠 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴊𐴞𐴥𐴁𐴡. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴈𐴡𐴀𐴘𐴊𐴞𐴘𐴞 𐴀𐴝𐴦𐴌 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴞𐴥𐴘𐴞. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴝𐴉𐴝𐴑 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴡𐴓𐴧𐴝 𐴋𐴝𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴂𐴝𐴑 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴐𐴞𐴥𐴑𐴧𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴊𐴞𐴦𐴘𐴠𐴥.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />𐴁𐴝𐴥𐴘𐴧𐴝𐴓𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴎𐴡𐴌𐴟𐴌 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴐𐴞𐴥𐴑𐴝𐴘𐴧𐴠. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />𐴀𐴝𐴦𐴌 𐴁𐴠𐴐𐴡𐴥𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴉𐴟𐴌𐴝 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴡𐴤𐴌. 𐴃𐴡𐴀, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤. <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴓𐴝𐴔 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘 𐴁𐴡𐴓𐴧𐴝, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴒𐴟𐴥𐴕𐴡𐴃𐴢 𐴕𐴝𐴑 𐴒𐴡𐴥𐴓𐴝𐴘 𐴕𐴡 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴠 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴕𐴞𐴘𐴡𐴃𐴢 𐴁𐴝𐴕𐴡. <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴀𐴌𐴒𐴗𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴑𐴡𐴊𐴡𐴌 𐴉𐴝𐴘𐴁𐴝 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤 𐴔𐴟𐴀𐴃𐴝𐴐𐴡𐴃𐴢 𐴕𐴡 𐴉𐴡𐴌𐴞𐴁𐴝𐴤.<verse eid="1TH 4:12" /></para>
  <para style="s1">𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴊𐴟𐴏𐴝𐴥𐴌𐴝𐴁𐴝𐴌 𐴀𐴝𐴀</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴡 𐴏𐴝𐴀𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴦𐴃𐴡𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴎𐴝𐴕𐴝𐴘𐴧𐴝 𐴃𐴝𐴥𐴑𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢 𐴕𐴡 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴀𐴝𐴐𐴝𐴤 𐴕𐴝𐴥𐴘. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴀𐴝𐴁𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴘𐴡𐴥 𐴓𐴡𐴘𐴎𐴝𐴘𐴁𐴡𐴥𐴘 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴔𐴡𐴦𐴃𐴡𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴑𐴝𐴓𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴓𐴞𐴑 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴎𐴞𐴕𐴊𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴦𐴃𐴡𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴒𐴡𐴃𐴧𐴟 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴕𐴡 𐴉𐴝𐴙𐴅𐴧𐴟𐴔. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴓𐴞𐴑 𐴕𐴞𐴎𐴠 𐴃𐴡 𐴋𐴡𐴣𐴀𐴌 𐴀𐴝𐴁𐴝𐴏𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴓𐴝𐴔𐴞 𐴀𐴝𐴘𐴁𐴡𐴤; 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴁𐴡𐴌𐴡 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴉𐴟𐴥𐴕𐴝 𐴎𐴝𐴘𐴁𐴡 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴝 𐴎𐴝𐴘𐴁𐴡. 𐴇𐴠𐴥 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴀𐴝𐴒𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴁𐴡 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴁𐴡𐴕𐴞 𐴔𐴡𐴌𐴞𐴒𐴞𐴥𐴓𐴒𐴡𐴘. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴎𐴞𐴕𐴊𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴟𐴔, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴔𐴝𐴓𐴞𐴑 𐴓𐴡𐴘 𐴔𐴞𐴓𐴞 𐴁𐴡𐴓𐴧𐴝 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴖𐴡𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴉𐴠𐴓𐴝 𐴎𐴝𐴘𐴁𐴡. 𐴃𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴡𐴥𐴘𐴧𐴟𐴔. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴈𐴡𐴃𐴝𐴤 𐴀𐴞𐴀𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴞𐴥𐴘𐴡.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s1">𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴊𐴞𐴕</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕 𐴇𐴡𐴕 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 𐴕𐴝𐴥𐴘. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴃𐴡 𐴁𐴝𐴥𐴓𐴝𐴒𐴡𐴌𐴞 𐴎𐴝𐴕𐴡, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴊𐴞𐴕 𐴘𐴞𐴥𐴁𐴝 𐴌𐴝𐴙𐴃𐴧𐴝 𐴏𐴟𐴌 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴀𐴝𐴘𐴁𐴡𐴤. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ”𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴋𐴡𐴦𐴌𐴝𐴘𐴁𐴝𐴥𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘,“ 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴞𐴔𐴁𐴞𐴃𐴢 𐴋𐴡𐴣𐴀𐴌 𐴊𐴡𐴐𐴝𐴤 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴘𐴁𐴡𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴝𐴥𐴔𐴞𐴓𐴢 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴦𐴣𐴌𐴞 𐴊𐴡𐴥𐴌𐴝𐴕𐴞 𐴀𐴝𐴀𐴘𐴎𐴝𐴥𐴒𐴡𐴘. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴇𐴝𐴥𐴌𐴞 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.<verse eid="1TH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4" />𐴓𐴠𐴑𐴞𐴕، 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴕𐴡, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴏𐴟𐴌 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴀𐴝𐴘𐴃𐴡𐴤; <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡 𐴕𐴟𐴌𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴞𐴕𐴡𐴌 𐴉𐴡𐴀𐴌𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴝𐴙𐴃𐴡𐴌 𐴀𐴡𐴥 𐴕𐴡 𐴀𐴝𐴦𐴌 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴌 𐴀𐴡𐴥 𐴕𐴡. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴟𐴥𐴔 𐴕𐴡 𐴎𐴝𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴞 𐴀𐴝𐴦𐴌 𐴀𐴟𐴥𐴣𐴐𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴟𐴥𐴔 𐴎𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴝𐴙𐴃𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴒𐴟𐴥𐴔 𐴎𐴝, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴐𐴝𐴥 𐴈𐴝𐴥𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴝𐴙𐴃𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴕𐴞𐴐𐴝𐴥 𐴇𐴝𐴥𐴘 𐴄𐴟𐴀𐴓𐴢 𐴀𐴡𐴥. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴊𐴞𐴕𐴡𐴌 𐴉𐴡𐴀𐴌 𐴀𐴡𐴌, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴟𐴥𐴣𐴐𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞. 𐴁𐴟𐴑𐴡𐴌 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌𐴠 𐴓𐴝𐴌𐴝𐴥𐴙𐴌 𐴎𐴝𐴔𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴉𐴞𐴣𐴊𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴃𐴝𐴥𐴌 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴡𐴓𐴧𐴝 𐴕𐴠𐴅𐴝𐴃𐴡𐴌 𐴀𐴝𐴐𐴝𐴤𐴌𐴠 𐴄𐴟𐴉𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴉𐴞𐴣𐴊𐴞𐴥. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴓𐴧𐴝 𐴄𐴞𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝. <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴔𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴠𐴃𐴡𐴕 𐴃𐴝𐴥𐴑𐴞 𐴘𐴝𐴥 𐴔𐴡𐴦𐴃𐴡𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴌𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴊𐴡𐴥; 𐴀𐴝𐴦𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴃𐴡𐴌𐴑𐴞 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴓𐴝 𐴘𐴡𐴥 𐴒𐴡𐴌𐴡𐴤𐴌.<verse eid="1TH 5:11" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴑𐴡𐴊𐴡𐴌 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴝𐴔𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴁𐴞𐴐𐴞𐴤 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴊𐴞𐴘𐴡. 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴡𐴘 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴃𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴡. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴀𐴡𐴐𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴃𐴡𐴌𐴁𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴊𐴞𐴥𐴘𐴡, 𐴑𐴡𐴔𐴎𐴟𐴌𐴡𐴌𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />𐴏𐴝𐴘𐴧𐴡𐴥, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴟𐴌𐴝𐴙𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴁𐴟𐴌𐴝𐴘 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴡, <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />𐴕𐴞𐴃𐴧𐴞 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />𐴇𐴝𐴥𐴀𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />𐴂𐴝𐴑-𐴌𐴟𐴀𐴌𐴠 𐴕𐴞𐴉𐴝𐴥𐴘 𐴕𐴡 𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴡. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />𐴀𐴝𐴦𐴌 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴝𐴇𐴝𐴥𐴑𐴞𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴡𐴥𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴡; <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴟𐴌𐴝𐴙𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴙𐴑𐴧𐴡.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />𐴐𐴝𐴥𐴕𐴃𐴞 𐴊𐴡𐴦𐴘𐴝 𐴀𐴝𐴓𐴧𐴝 𐴕𐴞𐴎𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴝𐴦 𐴌𐴠, 𐴌𐴟𐴀 𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴝𐴕𐴡𐴌𐴠 𐴀𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴌𐴝𐴑𐴡𐴥𐴗𐴑, 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝 𐴃𐴡 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌; 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴥𐴔𐴝𐴈𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />𐴃𐴝𐴔𐴝𐴥𐴔 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴂𐴝𐴑 𐴊𐴞𐴓𐴠 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴘𐴧𐴡𐴥. <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴉𐴡𐴌𐴞𐴥𐴘𐴡.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>