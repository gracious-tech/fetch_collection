<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">3 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 3 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc2">3 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc3">3𐴘𐴡</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">3 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴃𐴞𐴏𐴝𐴥𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 3 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴡𐴃𐴧𐴟 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴁𐴡𐴓𐴞 𐴉𐴡𐴌𐴞𐴏𐴡 𐴕𐴡𐴥 𐴊𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 <char style="ior">(<ref loc="3JN 1:1">1‏:1</ref>)</char>. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 <char style="xt"><ref loc="2JN 1:1">2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 1‏:1</ref></char> 𐴀𐴡𐴃𐴢 𐴀𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 1 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 3 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥.</para>
  <para style="ip">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴒𐴝𐴘𐴟𐴏𐴢 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴑 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴌 𐴇𐴝𐴣𐴏𐴠. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴒𐴝𐴘𐴟𐴏𐴡𐴌𐴠 𐴊𐴟𐴏𐴃𐴡𐴥 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴎𐴝𐴒𐴝-𐴎𐴝𐴒𐴝 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴡𐴌 𐴏𐴡𐴉𐴡𐴥𐴌 𐴒𐴡𐴌𐴠𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴠𐴀𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 <char style="ior">(<ref loc="3JN 1:1">1‏:1</ref>)</char></para>
  <para style="io1">2. 𐴒𐴝𐴘𐴟𐴏𐴡𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴔𐴠𐴀𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴈𐴡𐴖𐴝𐴤 <char style="ior">(<ref loc="3JN 1:2-8">1‏:2‏-8</ref>)</char></para>
  <para style="io1">3. 𐴊𐴞𐴘𐴟𐴃𐴌𐴞𐴉𐴠𐴏𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴊𐴠𐴔𐴠𐴃𐴌𐴞𐴘𐴟𐴏𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 <char style="ior">(<ref loc="3JN 1:9-12">1‏:9‏-12</ref>)</char></para>
  <para style="io1">4. 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 <char style="ior">(<ref loc="3JN 1:13-14">1‏:13‏-14</ref>)</char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />𐴀𐴝𐴀𐴛 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴘𐴠,</para>
  <para style="p" vid="3JN 1:1">𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴒𐴝𐴘𐴟𐴏𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴀𐴛 𐴏𐴡𐴥𐴘𐴧𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞 𐴃𐴡𐴌𐴑𐴞 𐴀𐴡𐴥𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴀𐴛 𐴎𐴠𐴕 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴃𐴡𐴌𐴑𐴞 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴡𐴘 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴠𐴇𐴠𐴥𐴃𐴢 𐴁𐴝𐴥𐴓𐴝 𐴃𐴝𐴥𐴑𐴠. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴞, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴡𐴊𐴟𐴥𐴕 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴀𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴥𐴑𐴞𐴒𐴡𐴃𐴡𐴌 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴠, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴀𐴛 𐴁𐴡𐴥𐴓𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴉𐴡𐴣𐴃𐴢 𐴁𐴝𐴥𐴘 𐴏𐴡𐴓𐴝𐴃𐴢 𐴀𐴝𐴏𐴡𐴤. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴏𐴡𐴥𐴘𐴧𐴞 𐴉𐴡𐴣𐴃𐴢 𐴁𐴝𐴥𐴘 𐴏𐴡𐴓𐴠𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴕𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴥𐴐𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴌 𐴕𐴝𐴥𐴘.<verse eid="3JN 1:4" /></para>
  <para style="s1">𐴒𐴝𐴘𐴟𐴏𐴡𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴝𐴥</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴊𐴟𐴏𐴃𐴡𐴥, 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴡𐴤𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴡𐴌𐴡𐴤𐴌, 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴏𐴞𐴕𐴉𐴡𐴌𐴞𐴏𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴕𐴡. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴠. 𐴃𐴟𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴌𐴡𐴖𐴝𐴕𐴝 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴃𐴠 𐴀𐴝𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴊𐴞𐴓𐴠𐴥 𐴁𐴞𐴐𐴞𐴤 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥 𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴝𐴔𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴔𐴡𐴊𐴡𐴃𐴢 𐴕𐴡𐴥 𐴓𐴡𐴦. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴉𐴡𐴥𐴌𐴡𐴏𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴞.<verse eid="3JN 1:8" /></para>
  <para style="s1">𐴊𐴞𐴘𐴟𐴃𐴌𐴞𐴉𐴠𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴊𐴠𐴔𐴠𐴃𐴌𐴞𐴘𐴟𐴏𐴢</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />𐴀𐴝𐴀𐴛 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴝𐴔; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴞𐴘𐴟𐴃𐴌𐴞𐴉𐴠𐴏𐴢, 𐴎𐴠𐴦 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴓𐴠𐴤, 𐴀𐴞𐴥𐴃𐴠 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴓𐴞𐴤𐴊𐴡𐴌𐴞𐴘𐴟𐴔. 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴕𐴐𐴝 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴠𐴥𐴌. 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴥𐴘 𐴑𐴝𐴉𐴞𐴥 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴘𐴡𐴥 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴝𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴌𐴠𐴥 𐴀𐴝𐴦𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴝𐴘𐴊𐴠.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴊𐴟𐴏𐴃𐴡𐴥, 𐴁𐴟𐴌𐴝𐴙𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴡𐴔𐴡𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴡. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴡𐴥 𐴊𐴠𐴑𐴠𐴥. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />𐴊𐴠𐴔𐴠𐴃𐴌𐴞𐴘𐴟𐴏𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴒𐴡𐴔 𐴕𐴝𐴔 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴀𐴟𐴥𐴊𐴧𐴗𐴝. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴕𐴝𐴔 𐴒𐴡𐴌𐴞𐴥. 𐴃𐴟𐴀𐴛 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴞 𐴊𐴠 𐴒𐴡𐴁𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴠.<verse eid="3JN 1:12" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴓𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴐𐴞𐴥𐴘𐴝𐴘 𐴓𐴡𐴥𐴘 𐴓𐴠𐴑𐴞𐴥𐴃𐴡 𐴕𐴡 𐴏𐴝𐴀𐴙𐴌. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴐𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴥𐴌𐴝 𐴊𐴠𐴑𐴞𐴥𐴘𐴟𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴟𐴀𐴝𐴥𐴔𐴟𐴙𐴑𐴧𐴝 𐴀𐴡𐴥𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴟𐴥𐴔.<verse eid="3JN 1:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴖𐴡𐴌𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴡𐴥𐴑. 𐴀𐴠𐴍𐴞𐴥𐴘𐴝𐴌 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌. 𐴃𐴟𐴀𐴛 𐴇𐴠𐴥𐴍𐴞𐴘𐴝𐴌 𐴊𐴟𐴏𐴃𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴡𐴕-𐴎𐴡𐴕 𐴒𐴡𐴌𐴞 𐴀𐴝𐴣𐴀𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴘𐴡.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>