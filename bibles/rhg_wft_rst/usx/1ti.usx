<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">1 𐴃𐴞𐴔𐴡𐴥𐴃𐴞</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴃𐴞𐴔𐴡𐴥𐴃𐴞</para>
  <para style="toc2">1 𐴃𐴞𐴔𐴡𐴥𐴃𐴞</para>
  <para style="toc3">1𐴃𐴞𐴔</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">1 𐴃𐴞𐴔𐴡𐴥𐴃𐴞</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴇𐴝𐴥𐴙𐴄𐴢-𐴊𐴟𐴘𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴙𐴄𐴢-𐴏𐴝𐴙𐴌 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝 𐴓𐴠𐴑𐴠𐴥𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴇𐴡𐴥𐴘𐴧𐴝𐴃𐴢 𐴉𐴟𐴥𐴌𐴝𐴘 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴃𐴧𐴟 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴓𐴧𐴡𐴥𐴘 𐴁𐴝𐴥𐴓𐴝 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴝𐴌 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝 𐴁𐴡𐴓𐴞 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤 <char style="ior">(<ref loc="1TI 1:2">1‏:2</ref>; <ref loc="1TI 1:18">1‏:18</ref>)</char>; (<char style="xt"><ref loc="PHP 2:22">𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴝𐴘𐴀𐴡𐴥𐴓𐴢 2‏:22</ref></char>).</para>
  <para style="ip">𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴎𐴠 𐴏𐴝𐴙𐴌 𐴒𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴡 𐴀𐴡𐴥𐴘 𐴎𐴡𐴕-𐴎𐴡𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕. 𐴎𐴡𐴕-𐴎𐴡𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴃𐴞𐴕 𐴕𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 2 𐴃𐴞𐴔𐴡𐴥𐴃𐴞, 𐴃𐴞𐴃𐴟𐴏𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴓𐴞𐴔𐴡𐴕. 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴁𐴝𐴤𐴃𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴐𐴞𐴥𐴑𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴑𐴞, 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴡𐴌𐴞𐴑𐴝 <char style="ior">(<ref loc="1TI 2:1-15">2‏:1‏-15</ref>)</char>, 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 <char style="ior">(<ref loc="1TI 3:1-13">3‏:1‏-13</ref>)</char>, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 <char style="ior">(<ref loc="1TI 1:3-11">1‏:3‏-11</ref>; <ref loc="1TI 4:1-5">4‏:1‏-5</ref>; <ref loc="1TI 6:2-5">6‏:2‏-5</ref>)</char>. 𐴇𐴞𐴥𐴀𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠, 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴃𐴡𐴌𐴁𐴞𐴘𐴡𐴃𐴢 𐴊𐴞𐴘𐴠𐴥. 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴕𐴞𐴘𐴡𐴔 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="1TI 1:1-2">1‏:1‏-2</ref>)</char></para>
  <para style="io1">2. 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 <char style="ior">(<ref loc="1TI 1:3-11">1‏:3‏-11</ref>)</char></para>
  <para style="io1">3. 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴓𐴧𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴐𐴟𐴥𐴑𐴟𐴌𐴝𐴕𐴝 <char style="ior">(<ref loc="1TI 1:12-19">1‏:12‏-19</ref>)</char></para>
  <para style="io1">4. 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝 <char style="ior">(<ref loc="1TI 2-3">2‏—3</ref>)</char></para>
  <para style="io1">5. 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 <char style="ior">(<ref loc="1TI 4-6">4‏—6</ref>)</char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴔𐴡𐴎𐴞𐴕 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴏𐴝𐴥𐴇𐴝𐴁𐴞.<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴇𐴠𐴥 𐴌𐴟𐴥𐴖𐴝𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴉𐴟𐴖𐴝.</para>
  <para style="b" vid="1TI 1:2" />
  <para style="p" vid="1TI 1:2">𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢, 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="1TI 1:2" /></para>
  <para style="s1">𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />𐴀𐴝𐴀𐴛 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴃𐴡𐴌𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴡𐴏𐴢. <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴁𐴞𐴤 𐴊𐴠, 𐴁𐴝𐴕𐴝𐴖𐴡𐴃𐴞 𐴑𐴞𐴏𐴧𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴟 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴔𐴁𐴝-𐴓𐴝𐴔𐴁𐴝 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴌 𐴓𐴠𐴐𐴄𐴞𐴥𐴌 𐴀𐴟𐴎𐴟 𐴊𐴞𐴥𐴘𐴝𐴕 𐴕𐴡 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕𐴠 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞 𐴁𐴠 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥. 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴢 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴌𐴝 𐴕𐴡 𐴎𐴝, 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴌𐴝 𐴎𐴝 𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴔𐴝𐴕𐴠. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />𐴀𐴝𐴣𐴀𐴌 𐴀𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴐𐴝𐴥𐴊𐴝 𐴊𐴞𐴓𐴢 𐴀𐴡𐴃𐴧𐴟, 𐴁𐴝𐴥𐴓𐴝 𐴇𐴠𐴥𐴓𐴡𐴔 𐴀𐴡𐴃𐴧𐴟, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴄𐴞 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴡𐴤𐴕. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴊𐴢 𐴊𐴞 𐴁𐴠𐴇𐴝𐴎𐴡𐴌 𐴒𐴡𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴊𐴠, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴀𐴝𐴓𐴠𐴔 𐴀𐴡𐴥𐴘𐴃𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴈𐴡𐴀 𐴘𐴝𐴥 𐴎𐴞𐴀𐴕 𐴀𐴠𐴑𐴞𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴕𐴞𐴎𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡 𐴁𐴟𐴎𐴠𐴥.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴔, 𐴎𐴡𐴊𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴡𐴌𐴞𐴑𐴝 𐴓𐴡𐴘 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴎𐴝𐴕𐴞 𐴊𐴠 𐴑𐴞, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴀𐴓𐴢 𐴊𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴞𐴘𐴡𐴔 𐴁𐴝𐴥𐴚𐴒𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴕𐴝𐴉𐴝𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴕𐴡 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝, 𐴁𐴝𐴉𐴡𐴌𐴠 𐴘𐴝𐴥 𐴔𐴝𐴦𐴌𐴠 𐴑𐴡𐴃𐴡𐴥𐴓𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝𐴓𐴧𐴝, 𐴑𐴟𐴥𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴔𐴡𐴌𐴡𐴃𐴠-𐴔𐴡𐴌𐴡𐴃𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴘𐴝𐴘𐴠 𐴔𐴝𐴘𐴝𐴘𐴠 𐴎𐴠𐴕𐴝𐴤-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴒𐴟𐴓𐴝𐴔 𐴐𐴡𐴥𐴊𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴔𐴞𐴏𐴝𐴥𐴑𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴔𐴞𐴏𐴝𐴥 𐴒𐴡𐴁𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴌 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴎𐴠𐴊𐴟𐴥𐴕𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝, <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />𐴎𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴝𐴦𐴌𐴞𐴉𐴊𐴝𐴥𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴋𐴡𐴣𐴀𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴞𐴔𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥.<verse eid="1TI 1:11" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴓𐴧𐴝 𐴐𐴟𐴥𐴑𐴟𐴌 𐴒𐴡𐴌𐴝𐴥</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴁𐴝𐴥𐴉𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴈𐴝𐴔𐴡𐴃𐴢 𐴓𐴝𐴒𐴝𐴘𐴧𐴠𐴥. <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴀𐴠𐴑 𐴇𐴝𐴓𐴠 𐴑𐴟𐴉𐴠𐴥𐴌𐴞-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, 𐴎𐴟𐴓𐴟𐴥𐴔𐴑𐴟𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴝𐴦𐴓𐴠𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴃𐴡𐴀 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴃𐴠 𐴕𐴡 𐴁𐴟𐴎𐴞𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴡𐴥𐴊𐴡𐴌𐴁𐴝𐴀𐴌𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴡𐴥𐴃𐴧𐴟 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴡𐴥 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴊𐴞𐴦𐴘𐴠𐴥.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴘𐴝𐴀𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴦𐴌 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴑𐴡𐴁𐴟𐴓𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴊𐴠 𐴑𐴞, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢 𐴊𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴏𐴝𐴘𐴃𐴡𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌𐴒𐴗𐴝𐴥 𐴀𐴝𐴀𐴛. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴎𐴞𐴁𐴝𐴤 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴡𐴐𐴞𐴥𐴔𐴝𐴕𐴝 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴠𐴕 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴔𐴟𐴕𐴝 𐴁𐴡𐴕𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘𐴁𐴡. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴞 𐴁𐴝𐴀𐴣𐴐𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴉𐴝𐴥𐴕𐴝 𐴕𐴡, 𐴎𐴞𐴁𐴝𐴤 𐴕𐴡𐴘𐴌𐴝𐴇𐴝𐴌, 𐴇𐴠𐴥 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝 𐴃𐴞𐴔𐴡𐴥𐴃𐴞, 𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴠 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴇𐴠𐴥 𐴔𐴡𐴎𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴀𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴔𐴝𐴕 𐴊𐴞𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴘 𐴇𐴠𐴥 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴁𐴝𐴥𐴓𐴝 𐴓𐴝𐴌𐴝𐴥𐴙𐴃𐴢<note caller="+" style="f"><char style="fr" closed="false">1‏:18 </char><char style="ft" closed="false">𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌 𐴎𐴞𐴔𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴡𐴤𐴕 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴡𐴌𐴡𐴤𐴕. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴥𐴑𐴧𐴝𐴕 𐴓𐴝𐴌𐴝𐴥𐴙𐴌 𐴔𐴡𐴘𐴊𐴝𐴕𐴡𐴃𐴢 𐴓𐴝𐴙𐴔𐴧𐴠𐴥 𐴉𐴝𐴥𐴕. </char></note> 𐴊𐴞𐴓𐴠-𐴎𐴝𐴕𐴠 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴡𐴏𐴢, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />𐴀𐴝𐴦𐴌 𐴃𐴡𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴓𐴝 𐴇𐴠𐴥𐴓𐴡𐴔 𐴎𐴠𐴕 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴕𐴞𐴎𐴡𐴌 𐴇𐴠𐴥𐴓𐴡𐴔𐴡𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴢 𐴕𐴡𐴥 𐴔𐴝𐴕𐴠 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴕𐴞𐴎𐴡𐴌 𐴀𐴞𐴔𐴝𐴕 𐴎𐴝𐴀𐴣𐴏𐴢 𐴁𐴝𐴥𐴚𐴒𐴠 𐴉𐴝𐴥𐴕 𐴁𐴝𐴥𐴚𐴒𐴞𐴒𐴞𐴘𐴡𐴘. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴟𐴔𐴞𐴕𐴝𐴘𐴟𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴠𐴑𐴏𐴎𐴠𐴕𐴊𐴝𐴌 𐴀𐴡𐴥 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴀𐴛 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴞, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴕𐴡 𐴒𐴡𐴌𐴝𐴥 𐴐𐴞𐴥𐴑𐴠.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s1">𐴊𐴟𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />𐴀𐴝𐴣𐴀𐴌 𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴒𐴡𐴌 𐴀𐴝𐴌𐴡𐴏𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴌𐴡𐴏𐴢, 𐴊𐴟𐴖𐴝, 𐴐𐴟𐴥𐴖𐴝𐴌𐴞𐴐𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴡𐴤. <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴀𐴝𐴊𐴞𐴑𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴘𐴡𐴥 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴎𐴧𐴡𐴙𐴃𐴧𐴝 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴓𐴡𐴘 𐴕𐴞𐴌𐴡𐴓𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘 𐴉𐴝𐴌𐴞. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤𐴕 𐴕𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴁𐴝𐴥𐴓𐴝; 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴞𐴥𐴁𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥. <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴝𐴀 𐴊𐴠, 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴡𐴗𐴑 𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴌𐴡𐴗𐴑, <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠𐴑𐴒𐴗𐴝𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴎𐴠𐴥 𐴀𐴟𐴏𐴞𐴥𐴓𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴘𐴡𐴥 𐴀𐴠𐴑𐴒𐴗𐴝𐴥, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤, <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴎𐴝𐴕𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴘𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴡𐴁𐴡𐴓𐴞𐴑-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴞. 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴣𐴏𐴝 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠, 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠, 𐴇𐴝𐴥𐴀𐴌 𐴎𐴝𐴒𐴝𐴃𐴢 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴇𐴡𐴕𐴡𐴤 𐴒𐴟𐴐𐴧𐴝𐴤 𐴏𐴝𐴥𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌𐴑𐴝𐴃𐴡𐴌𐴑𐴞 𐴏𐴝𐴥𐴌𐴝, 𐴕𐴞𐴎𐴡𐴌 𐴂𐴝𐴑 𐴀𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴓𐴞𐴤 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴥𐴗𐴑. <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠 𐴑𐴞, 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴞𐴎𐴧𐴡𐴃𐴢-𐴐𐴡𐴥𐴌𐴡𐴔𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴞𐴎𐴧𐴡𐴙𐴃𐴧𐴝 𐴒𐴡𐴌𐴞 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌 𐴓𐴡𐴘 𐴇𐴝𐴥𐴣𐴎𐴡𐴗𐴑, 𐴏𐴟𐴓𐴡𐴌 𐴁𐴞𐴕𐴞𐴏𐴢, 𐴐𐴟𐴥𐴕𐴝, 𐴔𐴟𐴑𐴃𐴝, 𐴘𐴝𐴥 𐴊𐴝𐴔𐴞 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌 𐴓𐴡𐴘 𐴕𐴡, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴡𐴗𐴑, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴞𐴕𐴊𐴝𐴥𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴃𐴧𐴟 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴌 𐴎𐴡𐴌𐴟𐴌.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />𐴔𐴝𐴘𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴕𐴞𐴎𐴝𐴥𐴔𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴡𐴥𐴗𐴑. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴘𐴝𐴥𐴃𐴡 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴏𐴡𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴕𐴡 𐴊𐴞. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴝𐴥𐴔 𐴀𐴡𐴥𐴘 𐴃𐴝𐴥𐴑𐴡𐴕 𐴎𐴡𐴌𐴟𐴌. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴒𐴠 𐴃𐴡 𐴀𐴝𐴊𐴡𐴔𐴡𐴌𐴠 𐴀𐴠𐴥𐴕𐴝 𐴁𐴝𐴕𐴝 𐴒𐴞𐴀𐴓𐴢, 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴇𐴝𐴥𐴖𐴝 𐴌𐴠. <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />𐴊𐴟𐴥𐴑𐴝𐴃𐴢 𐴃𐴡 𐴀𐴝𐴊𐴡𐴔 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴝𐴥𐴖𐴝𐴘𐴠 𐴀𐴠𐴥𐴕𐴝 𐴉𐴡𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴁𐴝𐴥𐴙𐴚𐴒𐴞𐴓𐴢. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />𐴃𐴡𐴀 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴟𐴀𐴝𐴙𐴕 𐴁𐴞𐴘𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴁𐴡, 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴢 𐴌𐴝𐴑𐴞𐴥 𐴀𐴞𐴔𐴝𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴂𐴝𐴑 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s1">𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />𐴘𐴝𐴀𐴕 𐴇𐴡𐴥𐴑 𐴈𐴡𐴃𐴝𐴤 𐴊𐴠 𐴑𐴞, 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴘𐴃𐴡 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴡𐴔 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞𐴌 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴕𐴠𐴃𐴝 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴑 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴢 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴡𐴘𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴣𐴓𐴡𐴘𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴞𐴎𐴧𐴡𐴃𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴔𐴠𐴀𐴔𐴝𐴕𐴊𐴝𐴌𐴞-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴁𐴝𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴐𐴝𐴥𐴑𐴟𐴌 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴔𐴝𐴌𐴝𐴔𐴝𐴌𐴞-𐴊𐴡𐴘𐴝 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴐𐴞𐴥𐴊𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴄𐴞𐴛𐴝-𐴉𐴡𐴘𐴐𐴝𐴤𐴌 𐴓𐴝𐴓𐴡𐴥𐴏𐴁𐴡𐴕 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴌𐴠 𐴁𐴝𐴥𐴓𐴝𐴒𐴡𐴌𐴞 𐴏𐴡𐴥𐴣𐴓𐴞 𐴉𐴝𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴝𐴁𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴉𐴝𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴡𐴌𐴞𐴁𐴝𐴌𐴡𐴌𐴠 𐴏𐴡𐴥𐴣𐴓𐴞 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴏𐴡𐴥𐴣𐴓𐴞𐴁𐴡؟ <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />𐴀𐴞𐴥𐴁𐴝 𐴕𐴡𐴘𐴝 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴞𐴥𐴁𐴝 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴘𐴧𐴠 𐴉𐴟𐴥𐴓𐴞 𐴀𐴟𐴍𐴞𐴤 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴝𐴥𐴣𐴎𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />𐴀𐴝𐴌𐴡𐴤, 𐴁𐴝𐴀𐴌𐴒𐴗𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴟𐴥𐴕𐴝𐴔 𐴃𐴝𐴥𐴑𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴞𐴥𐴁𐴝 𐴁𐴡𐴊𐴕𐴝𐴔 𐴎𐴟𐴌𐴝𐴘 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴌𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘.<verse eid="1TI 3:7" /></para>
  <para style="s1">𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴞𐴎𐴧𐴡𐴃𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴠𐴈𐴠𐴥𐴓𐴝𐴏𐴢 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴐𐴡𐴥𐴌𐴝𐴁𐴑𐴟𐴌 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴄𐴞𐴛𐴝-𐴉𐴡𐴘𐴐𐴝𐴤𐴌 𐴓𐴝𐴓𐴡𐴥𐴏𐴁𐴡𐴕 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴒𐴟𐴉𐴡𐴕𐴞 𐴇𐴝𐴥𐴣𐴏𐴝𐴌𐴠 𐴏𐴝𐴥𐴉𐴢 𐴊𐴞𐴓𐴠 𐴊𐴡𐴥𐴌𐴞 𐴌𐴝𐴑𐴝𐴤 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴝𐴒𐴠 𐴎𐴝𐴏𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴏𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴁𐴝𐴦𐴊𐴠 𐴎𐴡𐴊𐴞 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴄𐴡𐴥𐴀𐴌𐴠, 𐴃𐴡𐴥𐴘 𐴈𐴝𐴥𐴀𐴊𐴠𐴔𐴞 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥. <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴡𐴖𐴢 𐴖𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴞𐴎𐴧𐴡𐴃𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴒𐴞𐴉𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴢 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴡𐴘𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.<verse eid="1TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12" />𐴈𐴝𐴥𐴀𐴊𐴠𐴔𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴑 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴥𐴌𐴡𐴌 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴥𐴓𐴝𐴒𐴡𐴌𐴞 𐴏𐴡𐴥𐴣𐴓𐴞 𐴉𐴝𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />𐴎𐴠 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴝𐴥𐴓𐴝𐴒𐴡𐴌𐴞 𐴈𐴝𐴥𐴀𐴊𐴠𐴔𐴞 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴎𐴟𐴌𐴝𐴘𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴞𐴐𐴞𐴤 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.<verse eid="1TI 3:13" /></para>
  <para style="s1">𐴋𐴡𐴣𐴀𐴌 𐴒𐴟𐴉𐴡𐴕𐴞</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴘𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴀𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴠𐴀𐴕𐴠 <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴀𐴝𐴘𐴃𐴠𐴤 𐴊𐴠𐴌𐴞 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴃𐴟𐴘 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴡𐴏𐴢 𐴊𐴠 𐴑𐴞, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴡𐴌𐴞𐴁𐴝𐴌 𐴀𐴡𐴃𐴢, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴃𐴝𐴥𐴑𐴝𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴎𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴄𐴟𐴥𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />𐴇𐴡𐴕𐴡𐴤 𐴐𐴡𐴥𐴑 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴒𐴟𐴉𐴡𐴕𐴞 𐴁𐴞𐴐𐴞𐴤 𐴋𐴡𐴣𐴀𐴌, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥,</para>
  <para style="q1" vid="1TI 3:16">𐴀𐴞𐴥𐴁𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴀𐴙𐴓𐴢 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴠;</para>
  <para style="q2" vid="1TI 3:16">𐴀𐴝𐴦𐴌 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴁𐴡𐴥𐴓𐴞 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴘𐴠;</para>
  <para style="q1" vid="1TI 3:16">𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠.</para>
  <para style="q2" vid="1TI 3:16">𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠;</para>
  <para style="q1" vid="1TI 3:16">𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤𐴓𐴢 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴔𐴝𐴎𐴠𐴥;</para>
  <para style="q2" vid="1TI 3:16">𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴖𐴡𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s1">𐴔𐴞𐴏𐴝𐴥 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴇𐴝𐴥𐴌𐴝𐴏𐴞𐴌𐴝 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴀 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴓𐴡𐴌𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴢 𐴌𐴟𐴀 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴟 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴥𐴃𐴡𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴟 𐴔𐴡𐴕 𐴊𐴞𐴁𐴡. <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴔𐴞𐴏𐴝𐴥𐴑𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑𐴞 𐴃𐴧𐴟, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴠𐴥𐴓𐴡𐴔𐴡𐴌𐴠 𐴒𐴡𐴌𐴡𐴔 𐴁𐴥𐴡𐴀𐴣𐴌 𐴓𐴡𐴥𐴘 𐴔𐴝𐴌𐴇𐴝𐴤 𐴔𐴝𐴌𐴞𐴊𐴞𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴘𐴝𐴥-𐴐𐴝𐴥𐴊𐴞 𐴕𐴡 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴊𐴟𐴥𐴕-𐴇𐴡𐴊𐴟𐴥𐴕 𐴈𐴝𐴥𐴕𐴝 𐴁𐴝𐴎𐴢 𐴌𐴝𐴑𐴞𐴥𐴃𐴡 𐴔𐴝𐴕𐴝𐴥 𐴒𐴡𐴌𐴠𐴥, 𐴎𐴠 𐴈𐴝𐴥𐴕𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴎𐴝𐴕𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴠𐴕 𐴇𐴞𐴥𐴀𐴕 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥 𐴈𐴝𐴥𐴀. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴔, 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴇𐴝𐴥𐴌𐴝𐴔 𐴄𐴝𐴥𐴀𐴌𐴞𐴁𐴝𐴌 𐴕𐴝𐴥𐴘 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥 𐴈𐴝𐴥𐴀, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔𐴠 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴖𐴝𐴘𐴠 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.<verse eid="1TI 4:5" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴓𐴝 𐴈𐴝𐴥𐴀𐴊𐴠𐴔</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />𐴃𐴟𐴘 𐴎𐴡𐴊𐴞 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴒𐴟𐴥𐴕 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴡𐴌𐴠 𐴁𐴟𐴎𐴝𐴥𐴘 𐴊𐴡𐴥𐴏𐴢, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴘 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴕𐴠𐴑𐴧𐴝𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴘𐴁𐴞, 𐴃𐴟𐴘 𐴃𐴡 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴠 𐴔𐴝𐴕𐴞 𐴏𐴡𐴓𐴡𐴀𐴌 𐴊𐴠 𐴁𐴝𐴥𐴓𐴝 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴌𐴁𐴞𐴘𐴡𐴃𐴢 𐴉𐴝𐴦𐴃𐴢 𐴀𐴝𐴏𐴡𐴤𐴏𐴢. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴑𐴞𐴏𐴧𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴑𐴞𐴐𐴢, 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴁𐴟𐴌𐴝𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴁𐴝𐴕𐴝𐴖𐴡𐴃𐴞 𐴑𐴝𐴇𐴝𐴥𐴕𐴞 𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡 𐴉𐴝𐴌𐴠. 𐴘𐴝𐴥𐴌𐴁𐴡𐴊𐴡𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴌𐴠 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴝𐴕𐴝. <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴝𐴦𐴌𐴠 𐴁𐴝𐴕𐴝𐴘𐴓𐴠𐴤 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴝𐴥𐴘𐴊𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, 𐴓𐴠𐴑𐴞𐴕 𐴊𐴞𐴓𐴡𐴌𐴠 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞𐴓𐴧𐴝 𐴁𐴝𐴕𐴝𐴘𐴓𐴠𐴤 𐴇𐴝𐴥𐴀𐴌 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴉𐴝𐴥𐴘𐴊𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞𐴃𐴢 𐴀𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴡𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴖𐴝𐴦𐴊𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴇𐴡𐴥𐴑 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴦𐴌 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴑𐴡𐴁𐴟𐴓𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴑 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴙𐴑𐴧𐴞𐴥, 𐴎𐴞𐴁𐴝𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />𐴃𐴟𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴀𐴕𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴐𐴢. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />𐴃𐴟𐴘 𐴅𐴟𐴖𐴝𐴕 𐴁𐴡𐴓𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴘 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝𐴘𐴠, 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴠, 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠, 𐴀𐴞𐴔𐴝𐴕𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴂𐴝𐴑 𐴃𐴝𐴥𐴑𐴝𐴘𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴕𐴡𐴔𐴟𐴕𐴝 𐴁𐴡𐴕. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />𐴀𐴝𐴀𐴛 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴞𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴃𐴠𐴓𐴝𐴖𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢, 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴃𐴢 𐴁𐴞𐴌𐴝𐴕𐴝 𐴃𐴝𐴥𐴑. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴠 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴀𐴠𐴥𐴐𐴑𐴝𐴌𐴝 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴐𐴢, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴥𐴃𐴢 𐴊𐴞𐴥𐴘𐴠 𐴌𐴝𐴥𐴌 𐴀𐴝𐴒𐴟𐴕 𐴈𐴡𐴃𐴝𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴉𐴝𐴘𐴧𐴡𐴥𐴏𐴢. <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴊𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴥; 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴉𐴡𐴌𐴞 𐴃𐴝𐴥𐴑, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴡𐴌 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴃𐴡𐴌𐴑𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴊𐴠𐴑𐴠𐴥. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />𐴕𐴞𐴎𐴡𐴌 𐴀𐴟𐴎𐴟 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴝𐴌 𐴀𐴟𐴎𐴟 𐴊𐴞𐴥𐴘𐴝𐴕 𐴌𐴝𐴑. 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴃𐴟𐴘 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴘𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴉𐴟𐴥𐴕𐴠 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝 𐴁𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴞𐴥.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s1">𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴥𐴌𐴡𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />𐴇𐴡𐴕𐴡𐴤 𐴔𐴡𐴌𐴡𐴃𐴢 𐴔𐴟𐴌𐴟𐴁𐴧𐴞𐴌𐴠 𐴕𐴡 𐴅𐴠𐴥𐴅𐴧𐴠𐴍𐴝𐴙𐴐𐴢, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴡𐴌𐴠 𐴁𐴟𐴎𐴝𐴥 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴁𐴟𐴎𐴝𐴥𐴙𐴐𐴢; 𐴅𐴟𐴖𐴝𐴕 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴁𐴟𐴎𐴝𐴥𐴘𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴁𐴟𐴎𐴝𐴥 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴁𐴟𐴎𐴝𐴥𐴙𐴐𐴢; <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />𐴔𐴝𐴘𐴝 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴟𐴎𐴝𐴥𐴘𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴦𐴌𐴠 𐴁𐴟𐴎𐴝𐴥 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴁𐴟𐴎𐴝𐴥𐴙𐴐𐴢; 𐴀𐴝𐴦𐴌 𐴅𐴟𐴖𐴝𐴕 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴁𐴟𐴎𐴝𐴥𐴘𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴥𐴙𐴕𐴡𐴌𐴠 𐴁𐴟𐴎𐴝𐴥 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴏𐴝𐴥𐴉𐴢 𐴊𐴞𐴓𐴠 𐴁𐴟𐴎𐴝𐴥𐴙𐴐𐴢.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />𐴎𐴠 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴏𐴝𐴀𐴏𐴞𐴃𐴝-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴝𐴥𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴝𐴀𐴏𐴞𐴃𐴝 𐴒𐴡𐴌𐴞𐴥𐴐𐴢. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴌𐴝𐴌𐴞𐴃𐴧𐴟 𐴎𐴡𐴊𐴞 𐴉𐴟𐴀𐴝𐴙𐴕 𐴘𐴝𐴥 𐴕𐴝𐴃𐴞𐴘𐴝𐴥𐴙𐴕 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴒𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴀𐴏𐴞𐴃𐴝 𐴒𐴡𐴌𐴞𐴥 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝 𐴐𐴞𐴥𐴑𐴡𐴗𐴑. 𐴇𐴠𐴥𐴀𐴕𐴒𐴡𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴊𐴝𐴊𐴝-𐴁𐴝𐴉𐴊𐴝𐴊𐴝𐴌 𐴒𐴟𐴕 𐴉𐴟𐴥𐴣𐴎𐴞 𐴉𐴝𐴌𐴞𐴁𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴡𐴏𐴡𐴥𐴕𐴊𐴝𐴌. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />𐴎𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴌𐴝𐴌𐴞𐴌 𐴇𐴡𐴕𐴡𐴤 𐴏𐴝𐴀𐴏𐴞𐴃𐴝-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴝𐴥𐴘 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴑𐴞𐴥, 𐴌𐴝𐴘𐴃𐴠 𐴊𐴞𐴕𐴠 𐴉𐴡𐴥𐴌𐴞𐴘𐴝𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴉𐴡𐴌𐴞 𐴃𐴝𐴥𐴑𐴠. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠 𐴌𐴝𐴌𐴞𐴘𐴠 𐴀𐴝𐴘𐴝𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝, 𐴇𐴞𐴥𐴁𐴝 𐴃𐴡 𐴎𐴞𐴕𐴊𐴝 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴘𐴡 𐴔𐴡𐴌𐴝. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴐𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴓𐴎𐴝𐴔 𐴓𐴝𐴒𐴝𐴘𐴁𐴝𐴥𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴠𐴒𐴝𐴕𐴝-𐴒𐴟𐴙𐴐𐴧𐴞𐴥𐴌𐴠 𐴏𐴝𐴀𐴏𐴞𐴃𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴕𐴞𐴎𐴡𐴌 𐴉𐴡𐴌𐴞𐴁𐴝𐴌 𐴀𐴡𐴌𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴠 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴃𐴧𐴟 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴈𐴡𐴥𐴌𐴝𐴉𐴢.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />𐴇𐴡𐴕𐴡𐴤 𐴌𐴝𐴌𐴞𐴌𐴠 𐴌𐴝𐴌𐴞𐴌 𐴏𐴠𐴌𐴝𐴥𐴚𐴡𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴃𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴁𐴡𐴐𐴢 𐴇𐴝𐴥𐴙𐴄𐴢 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴕𐴞𐴏𐴠 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥; 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴓𐴡𐴥𐴘 𐴔𐴞𐴓𐴔𐴞𐴓𐴝𐴁𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴌 𐴕𐴝𐴔 𐴃𐴝𐴥𐴑𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴉𐴡𐴌𐴡𐴌𐴠 𐴔𐴠𐴀𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴄𐴠𐴥𐴚 𐴊𐴟𐴥𐴖𐴝𐴘 𐴊𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴊𐴟𐴑𐴧𐴞𐴥𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴉𐴡𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴅𐴟𐴖𐴝𐴕 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴠𐴌𐴝𐴥𐴚𐴡𐴃𐴢 𐴕𐴡 𐴃𐴟𐴓𐴞𐴤𐴐𐴢; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴋𐴡𐴦𐴌 𐴈𐴡𐴔𐴞 𐴎𐴝𐴘 𐴀𐴝𐴁𐴝𐴌 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀. <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴒𐴡𐴌 𐴖𐴝𐴦𐴊𐴝 𐴁𐴝𐴥𐴚𐴒𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴝. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />𐴀𐴝𐴌𐴡𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴡𐴥𐴌𐴠-𐴒𐴡𐴥𐴌𐴠 𐴎𐴝𐴘𐴧𐴡𐴌𐴠 𐴁𐴡𐴘𐴍𐴝𐴤 𐴃𐴝𐴥𐴑𐴝𐴌 𐴀𐴝𐴊𐴡𐴃𐴢 𐴁𐴝𐴕𐴝; 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴌𐴡𐴌 𐴒𐴞𐴉𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴔𐴝𐴦𐴔𐴠𐴓𐴝𐴃𐴢 𐴄𐴠𐴥𐴚 𐴒𐴡𐴥𐴓𐴝𐴘𐴊𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡𐴀 𐴎𐴞𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴕𐴡 𐴈𐴡𐴀𐴕 𐴏𐴝𐴥. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢, 𐴅𐴟𐴖𐴝𐴕 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴉𐴟𐴀𐴝𐴙𐴕 𐴁𐴞𐴘𐴡𐴑, 𐴕𐴞𐴎𐴡𐴌 𐴒𐴡𐴥𐴌 𐴏𐴡𐴥𐴣𐴓𐴡𐴗𐴑, 𐴎𐴠𐴀𐴕𐴠 𐴊𐴟𐴐𐴧𐴡𐴕𐴠 𐴁𐴡𐴊𐴕𐴝𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴦𐴗𐴑𐴝 𐴕𐴡 𐴉𐴝𐴦. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴡𐴊𐴟𐴥𐴕 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴡 𐴏𐴡𐴥𐴘𐴧𐴞 𐴌𐴝𐴏𐴃𐴝𐴃𐴧𐴟 𐴓𐴡𐴌𐴞𐴎𐴝𐴘 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴉𐴞𐴏𐴝𐴥𐴓𐴞 𐴊𐴡𐴙𐴅𐴧𐴠.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴉𐴡𐴌𐴞𐴁𐴝𐴌𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴉𐴟𐴣𐴎𐴝𐴤 𐴃𐴟𐴓𐴞𐴤 𐴕𐴡 𐴊𐴞𐴥 𐴕𐴞𐴎𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴝𐴀𐴏𐴞𐴃𐴝 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴠 𐴌𐴝𐴌𐴞 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴏𐴝𐴀𐴏𐴞𐴃𐴝 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴏𐴝𐴀𐴏𐴞𐴃𐴝-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴝𐴥𐴘.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />𐴎𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴥𐴓𐴝𐴒𐴡𐴌𐴞 𐴏𐴡𐴓𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴘 𐴒𐴟𐴕 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴉𐴝𐴘𐴁𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴠. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴊𐴝𐴥𐴕 𐴀𐴟𐴥𐴣𐴌𐴡𐴌 𐴊𐴠 𐴒𐴡𐴌𐴟𐴌𐴠 𐴈𐴡𐴀𐴣𐴌 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥.“ 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴔𐴟𐴎𐴟𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴎𐴟𐴌𐴞 𐴉𐴝𐴘𐴁𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑.“ <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />𐴊𐴟𐴘 𐴎𐴡𐴕 𐴘𐴝𐴥 𐴃𐴞𐴕 𐴎𐴡𐴕 𐴒𐴡𐴁𐴝𐴤 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴓𐴎𐴝𐴔 𐴕𐴡 𐴒𐴡𐴏𐴞𐴥𐴐𐴢. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴊𐴝𐴈𐴝𐴤𐴘 𐴊𐴞𐴐𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴌𐴒𐴟𐴥𐴕𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />𐴀𐴝𐴓𐴧𐴝 𐴌𐴠, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴟𐴀𐴕𐴃𐴟 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴕𐴞𐴐𐴡𐴥𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴓𐴧𐴝 𐴁𐴟𐴑 𐴕𐴡 𐴄𐴝𐴕𐴞 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴐𐴢, 𐴀𐴠𐴑𐴃𐴡𐴌𐴉𐴞𐴥𐴘𐴝𐴘𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴐𐴢.<verse eid="1TI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22" />𐴎𐴞𐴔𐴧𐴝 𐴊𐴞𐴦 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴖𐴡𐴌𐴠 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴀𐴝𐴥𐴃𐴢 𐴕𐴡 𐴊𐴞𐴐𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴕𐴡 𐴀𐴡𐴥𐴙𐴐𐴢. 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴌𐴝𐴑.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />𐴁𐴝𐴕𐴝𐴤 𐴉𐴝𐴕𐴞𐴥 𐴇𐴝𐴥𐴘-𐴇𐴝𐴥𐴘 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴐𐴢; 𐴃𐴡𐴌 𐴉𐴠𐴍𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌𐴃𐴧𐴟 𐴀𐴠𐴒𐴝𐴎𐴝𐴥 𐴎𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴀𐴡𐴥𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴠𐴑𐴧𐴝-𐴀𐴠𐴑𐴧𐴝 𐴀𐴝𐴚𐴒𐴟𐴌𐴡𐴌 𐴌𐴡𐴐𐴢 𐴀𐴡𐴥 𐴈𐴝𐴥𐴙𐴐𐴢.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴏𐴝𐴥𐴉𐴢 𐴎𐴝𐴇𐴠𐴥𐴌, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴀𐴝𐴒𐴠 𐴀𐴡𐴥; 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴉𐴡𐴌𐴠 𐴁𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴏𐴝𐴥𐴉𐴢 𐴎𐴝𐴇𐴠𐴥𐴌, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴏𐴝𐴥𐴉𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴕𐴡 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥 𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴃𐴝𐴥𐴑𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />𐴎𐴠𐴊𐴟𐴥𐴕 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴟𐴓𐴝𐴔𐴞𐴌 𐴎𐴟𐴣𐴖𐴝𐴓𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴞𐴎𐴧𐴡𐴃𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴁𐴡𐴓𐴞 𐴁𐴝𐴥𐴉𐴝𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴕𐴡. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />𐴎𐴠 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴃𐴝𐴥𐴑𐴡𐴗𐴑, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴝𐴔𐴡𐴃𐴧𐴟 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴝𐴥𐴘𐴊𐴝 𐴉𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢.</para>
  <para style="p" vid="1TI 6:2">𐴃𐴟𐴘 𐴀𐴞𐴀𐴕 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴥𐴌.<verse eid="1TI 6:2" /></para>
  <para style="s1">𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴊𐴡𐴥𐴕</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴌𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴠 𐴎𐴞𐴀𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴥𐴘, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴓𐴡𐴘 𐴔𐴞𐴓𐴢 𐴕𐴡 𐴇𐴝𐴥, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />𐴀𐴞𐴥𐴃𐴠 𐴉𐴡𐴇𐴡𐴥𐴌 𐴀𐴡𐴓𐴝 𐴀𐴝𐴦𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴁𐴟𐴎𐴠𐴥. 𐴓𐴡𐴉𐴎𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞 𐴊𐴡𐴕 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌𐴑𐴝𐴃𐴡𐴌𐴑𐴞 𐴊𐴡𐴕 𐴀𐴞𐴥𐴃𐴝𐴌 𐴀𐴠𐴥𐴑𐴧𐴝𐴕 𐴁𐴞𐴘𐴝𐴌𐴝𐴔, 𐴎𐴞𐴀𐴕𐴡𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴌𐴞𐴐𐴢, 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢, 𐴒𐴝𐴓𐴝𐴒𐴝𐴓𐴞, 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴐𐴡𐴥𐴑-𐴐𐴟𐴁𐴝𐴤, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴒𐴞𐴍𐴞-𐴎𐴝𐴘𐴧𐴝 𐴊𐴠𐴔𐴝𐴑 𐴀𐴡𐴓𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴑𐴠𐴌𐴝𐴚𐴇𐴝𐴓𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴄𐴝𐴥𐴀𐴌𐴠 𐴊𐴠, 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴓𐴠𐴥 𐴕𐴡𐴉𐴝𐴤 𐴀𐴝𐴏𐴠𐴤.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴑𐴞 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴓𐴠𐴥 𐴁𐴠 𐴋𐴡𐴣𐴀𐴌 𐴕𐴡𐴉𐴝𐴤 𐴀𐴝𐴏𐴠𐴤. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴘𐴃𐴠𐴤 𐴊𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴟𐴥 𐴀𐴝𐴕𐴞𐴤, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴧𐴟 𐴎𐴝𐴘𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴀𐴡𐴥 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴠𐴏𐴧𐴟𐴥 𐴓𐴡𐴘𐴎𐴝𐴘 𐴕𐴡 𐴉𐴝𐴙𐴅𐴧𐴟𐴔. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴈𐴝𐴥𐴕𐴝 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴣𐴊𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴦𐴌 𐴃𐴝𐴥𐴑𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴑𐴟𐴥𐴐𐴞 𐴃𐴝𐴥𐴑𐴡𐴕 𐴏𐴝𐴥. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴘𐴃𐴡 𐴏𐴝𐴀, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴁𐴠𐴇𐴝𐴎𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴓𐴟𐴏𐴧𐴝𐴥𐴕𐴞 𐴀𐴝𐴎𐴧𐴟 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥, 𐴎𐴞𐴀𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴁𐴡𐴌𐴁𐴝𐴊𐴞𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴥𐴚𐴐𐴡𐴃𐴢 𐴋𐴟𐴉𐴝𐴥𐴘𐴉𐴠𐴓𐴠. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴄𐴞𐴛𐴝-𐴉𐴡𐴘𐴐𐴝𐴤𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴞𐴌 𐴀𐴠𐴥𐴑𐴧𐴝𐴕 𐴒𐴟𐴙𐴅𐴧𐴝. 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴄𐴞𐴛𐴝-𐴉𐴡𐴘𐴐𐴝𐴤𐴌 𐴓𐴝𐴓𐴡𐴥𐴏𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴓𐴡𐴌𐴞𐴎𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴌𐴠 𐴋𐴡𐴣𐴀𐴌 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞 𐴀𐴝𐴙𐴕𐴧𐴠𐴤.<verse eid="1TI 6:10" /></para>
  <para style="s1">𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴇𐴡𐴥𐴑𐴟𐴔</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴘, 𐴀𐴡𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴡𐴕𐴊𐴝, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴊𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌, 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞𐴌, 𐴀𐴞𐴔𐴝𐴕 𐴀𐴡𐴌, 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴡𐴌, 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴌𐴡𐴔𐴞𐴌 𐴉𐴞𐴏𐴠𐴤 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴓𐴝𐴌𐴝𐴥𐴙𐴃𐴢 𐴁𐴝𐴥𐴓𐴝𐴒𐴡𐴌𐴞 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴎𐴝; 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴌𐴝𐴑, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴃𐴡𐴌𐴠𐴥 𐴋𐴝𐴈𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴘 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴞. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />𐴀𐴝𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴌𐴠 𐴉𐴡𐴌𐴝𐴕 𐴊𐴠𐴦, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴂𐴡𐴕𐴃𐴞𐴘𐴟𐴏𐴢 𐴉𐴞𐴓𐴝𐴃𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴃𐴟𐴀𐴝𐴙𐴅𐴧𐴡 𐴊𐴞𐴌, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />𐴃𐴟𐴘 𐴕𐴞𐴊𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴃𐴝𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴥𐴌, 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴝𐴇𐴠𐴥𐴌 𐴕𐴡𐴥. <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴄𐴝𐴙𐴔𐴡𐴃𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴇𐴠𐴥 𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴝𐴦𐴌𐴞𐴉𐴊𐴝𐴥𐴌, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, 𐴀𐴞𐴥𐴁𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴝𐴦𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴝𐴓𐴞𐴑. <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴎𐴞𐴁𐴝𐴤 𐴉𐴝𐴥𐴕𐴝 𐴕𐴡 𐴀𐴡𐴥. 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴎𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴟𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠. 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴊𐴠𐴑𐴞𐴥 𐴉𐴝𐴌𐴠. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴌𐴝𐴦𐴏𐴃𐴌𐴞 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴁𐴞 𐴊𐴠, 𐴉𐴡𐴇𐴡𐴥𐴌 𐴀𐴡𐴓𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴇𐴡𐴕𐴡𐴤 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴊𐴡𐴥𐴕-𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞𐴌 𐴖𐴡𐴌𐴠 𐴕𐴡 𐴌𐴝𐴑𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴑𐴞𐴥𐴃𐴡, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴟𐴥𐴐𐴞𐴓𐴧𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴄𐴝𐴓𐴞𐴑𐴧𐴝 𐴒𐴡𐴌𐴞 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴠. <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴈𐴡𐴘𐴁𐴞𐴤 𐴊𐴠, 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴁𐴝𐴥𐴓𐴝𐴘 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴌 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴊𐴞𐴓𐴑𐴟𐴥𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴡𐴥𐴕-𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞𐴌 𐴁𐴝𐴥𐴑 𐴊𐴞𐴦𐴃𐴡 𐴃𐴡𐴘𐴧𐴝𐴌 𐴃𐴝𐴥𐴑𐴞𐴃𐴡. <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴊𐴡𐴥𐴕 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴀𐴔𐴡𐴌 𐴓𐴧𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞 𐴁𐴡𐴕𐴞𐴁𐴡𐴥 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴃𐴞𐴥𐴘𐴝𐴘𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌𐴠 𐴊𐴡𐴥𐴌𐴞 𐴌𐴝𐴑𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />𐴀𐴡𐴥 𐴃𐴞𐴔𐴡𐴥𐴃𐴞, 𐴃𐴡𐴌𐴠𐴥 𐴎𐴞𐴀𐴕𐴡𐴌 𐴎𐴞𐴔𐴧𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑. 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴁𐴠𐴇𐴝𐴎𐴡𐴌 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴔𐴞𐴓𐴢 𐴕𐴡 𐴇𐴝𐴥 𐴊𐴠 𐴎𐴠 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞𐴌𐴠 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴒𐴡𐴓𐴃𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 ”𐴒𐴞𐴘𐴝𐴕“ 𐴈𐴡𐴀, 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑. <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴇𐴠𐴥 𐴒𐴞𐴘𐴝𐴕𐴡𐴌 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴌𐴝𐴏𐴃𐴝 𐴇𐴝𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤.</para>
  <para style="p" vid="1TI 6:21">𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>