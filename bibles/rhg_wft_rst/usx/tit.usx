<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴃𐴞𐴃𐴟𐴏𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴃𐴞𐴃𐴟𐴏𐴢</para>
  <para style="toc2">𐴃𐴞𐴃𐴟𐴏𐴢</para>
  <para style="toc3">𐴃𐴞𐴃𐴢</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴃𐴞𐴃𐴟𐴏𐴢</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴃𐴞𐴃𐴟𐴏𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴃𐴞𐴃𐴟𐴏𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢. 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴡 𐴀𐴡𐴥𐴘 𐴎𐴡𐴕-𐴎𐴡𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴏𐴝𐴙𐴌 𐴒𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕. 𐴎𐴡𐴕-𐴎𐴡𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴃𐴞𐴕 𐴕𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 1 𐴃𐴞𐴔𐴡𐴥𐴃𐴞, 2 𐴃𐴞𐴔𐴡𐴥𐴃𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴓𐴞𐴔𐴡𐴕. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴃𐴞𐴃𐴟𐴏𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴓𐴠 𐴘𐴡, 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴥𐴌𐴞 𐴉𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴓𐴠𐴙𐴑𐴧𐴠𐴥. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞 𐴊𐴠, 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴒𐴞𐴌𐴞𐴌 𐴎𐴞𐴔𐴧𐴝 𐴁𐴟𐴎𐴝𐴥𐴘𐴊𐴞𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕 𐴃𐴞𐴃𐴟𐴏𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴎𐴝𐴙𐴕𐴃𐴡. 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴇𐴝𐴥𐴙𐴄𐴢-𐴃𐴞𐴕 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴃𐴧𐴟 𐴇𐴝𐴥𐴙𐴄𐴢-𐴉𐴝𐴣𐴏𐴢 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.</para>
  <para style="ip">𐴑𐴠𐴌𐴠𐴃𐴢 𐴋𐴞𐴘𐴝𐴌 𐴖𐴡𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴏𐴡𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴃𐴞𐴃𐴟𐴏𐴡𐴌𐴠 𐴀𐴝𐴌𐴝𐴥𐴙𐴓𐴢 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴃𐴞𐴃𐴟𐴏𐴡𐴌𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴏𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴡𐴌𐴁𐴞𐴘𐴡𐴃𐴢 𐴊𐴞𐴁𐴝𐴌 𐴐𐴞𐴥𐴑𐴧𐴝 𐴊𐴞𐴥𐴃𐴡. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴑𐴞𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴐𐴞𐴥𐴑𐴧𐴝 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴟𐴥𐴕 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴀𐴡𐴥 𐴊𐴞𐴘𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥𐴃𐴢 𐴁𐴟𐴎𐴝𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴡𐴃𐴧𐴡𐴥𐴌 𐴔𐴝𐴕𐴝 𐴎𐴝𐴘𐴁𐴡. 𐴀𐴠 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥𐴃𐴧𐴟 𐴇𐴠𐴥 𐴎𐴡𐴌𐴟𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴟 𐴁𐴝𐴥𐴓𐴝𐴒𐴡𐴌𐴞 𐴊𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴘𐴝𐴌 𐴎𐴡𐴌𐴟𐴌.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴊𐴞𐴕𐴊𐴝𐴥𐴌 𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴓𐴞𐴤𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 <char style="ior">(<ref loc="TIT 1:1-16">1‏:1‏-16</ref>)</char></para>
  <para style="io1">2. 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴁𐴝𐴥𐴌 𐴃𐴡𐴌𐴁𐴞𐴘𐴡𐴃𐴢 𐴊𐴞𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 <char style="ior">(<ref loc="TIT 2:1-3:11">2‏:1‏—3‏:11</ref>)</char></para>
  <para style="io1">3. 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="TIT 3:12-15">3‏:12‏-15</ref>)</char></para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴏𐴝𐴥𐴇𐴝𐴁𐴞. 𐴀𐴝𐴣𐴀𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴀𐴝𐴕𐴡𐴤𐴕 𐴀𐴠𐴊𐴧𐴠 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴁𐴝𐴥𐴌 𐴎𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴏𐴠𐴤 𐴇𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴡𐴕. <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />𐴇𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴀𐴝𐴐𐴝𐴤 𐴊𐴞𐴦𐴁𐴡; 𐴎𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴈𐴡𐴀 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴞𐴦𐴁𐴝𐴌 𐴖𐴝𐴦𐴊𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />𐴀𐴝𐴦𐴌 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴕𐴞𐴎𐴡𐴌 𐴇𐴠𐴥 𐴑𐴝𐴓𐴝𐴔𐴡𐴌𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴡𐴌 𐴎𐴞𐴔𐴧𐴝 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴠 𐴉𐴝𐴘𐴧𐴞𐴥.<verse eid="TIT 1:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />𐴃𐴞𐴃𐴟𐴏𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴞𐴁𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴊𐴠 𐴇𐴠𐴥 𐴌𐴟𐴥𐴖𐴝𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴉𐴟𐴖𐴝.</para>
  <para style="b" vid="TIT 1:4" />
  <para style="p" vid="TIT 1:4">𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="TIT 1:4" /></para>
  <para style="s1">𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴑𐴠𐴌𐴠𐴃𐴢 𐴋𐴞𐴘𐴝𐴃𐴢 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴠𐴌𐴞 𐴀𐴝𐴙𐴐𐴧𐴞𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴑𐴞 𐴃𐴝𐴥𐴘𐴒𐴞𐴘𐴠𐴒𐴡𐴘 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴘 𐴄𐴞𐴥𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴉𐴝𐴌𐴡𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴞 𐴇𐴠𐴥 𐴔𐴡𐴎𐴞𐴕 𐴇𐴝𐴥𐴀𐴌 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴔𐴟𐴌𐴟𐴁𐴧𐴞-𐴕𐴠𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴓𐴞𐴤 𐴉𐴝𐴌𐴡𐴏𐴢. <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥𐴐𐴢, 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴃𐴟𐴓𐴞𐴤𐴁𐴞 𐴀𐴞𐴥𐴁𐴝 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴠𐴑 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴀𐴝𐴘𐴝𐴐𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕𐴞𐴌 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴓𐴎𐴝𐴔 𐴕𐴝𐴥𐴘. <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴕𐴠𐴃𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴎𐴞𐴔𐴧𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴀𐴞𐴥𐴁𐴝 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴠𐴒𐴧𐴗𐴝𐴣𐴅𐴧𐴝 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴁𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴒𐴟𐴐𐴧𐴝𐴤-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴕𐴞𐴐𐴝𐴥𐴑𐴟𐴌 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴔𐴝𐴌𐴝𐴔𐴝𐴌𐴞-𐴊𐴡𐴘𐴝 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴕𐴝𐴎𐴝𐴘𐴠𐴏𐴢 𐴕𐴡𐴉𐴝𐴤𐴌 𐴓𐴝𐴓𐴡𐴥𐴏𐴁𐴡𐴕 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝 𐴔𐴠𐴀𐴔𐴝𐴕𐴊𐴝𐴌𐴞-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴌𐴠 𐴉𐴡𐴏𐴡𐴥𐴕-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴑𐴧𐴡𐴥𐴓𐴢 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴡𐴘𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴂𐴝𐴑 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴣𐴓𐴞-𐴉𐴝𐴌𐴡𐴘𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴑𐴝𐴓𐴝𐴔 𐴀𐴟𐴀𐴙𐴕𐴡𐴃𐴢 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴎𐴞𐴀𐴕 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴞 𐴊𐴠 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴔𐴡𐴎𐴞𐴕، 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴇𐴠𐴥 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠.<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴥𐴔𐴝𐴕𐴝-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, 𐴒𐴝𐴓𐴟 𐴀𐴠𐴊𐴧𐴠 𐴊𐴝𐴒𐴝𐴁𐴝𐴎𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴡 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴒𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠. <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴑 𐴁𐴡𐴕 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴝𐴎𐴝𐴘𐴠𐴏𐴢 𐴕𐴡𐴉𐴝𐴤 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴉𐴟𐴌𐴝 𐴒𐴡𐴥𐴌-𐴒𐴡𐴥𐴌 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔𐴠 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴊𐴞𐴉𐴠𐴥𐴓𐴠𐴌 𐴎𐴞𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴕𐴡 𐴊𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴀𐴠𐴑 𐴕𐴡𐴁𐴞𐴘𐴠 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴑𐴞, ”𐴑𐴠𐴌𐴠𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴝𐴀𐴌𐴞 𐴅𐴝𐴕𐴟𐴖𐴝𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴓𐴐𐴞𐴤 𐴀𐴠𐴊𐴧𐴠 𐴋𐴝𐴙𐴕.“ <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴏𐴡𐴥𐴘𐴧𐴞. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴘 𐴈𐴡𐴌𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴡𐴓𐴃𐴞 𐴊𐴝𐴈𐴝𐴤𐴘𐴊𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴕 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴕𐴝𐴖𐴡𐴃𐴞 𐴑𐴞𐴏𐴧𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴟 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴧𐴟 𐴓𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴌 𐴀𐴟𐴎𐴟 𐴈𐴝𐴕 𐴕𐴡 𐴊𐴠. <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴂𐴝𐴑, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴃𐴡 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴂𐴝𐴑; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴝𐴉𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴔𐴝𐴕 𐴏𐴝𐴥𐴌𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴂𐴝𐴑 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴠𐴈𐴠𐴥𐴕, 𐴇𐴠𐴥𐴓𐴡𐴔, 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕 𐴕𐴝𐴉𐴝𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴎𐴝𐴕𐴞 𐴈𐴡𐴀𐴘𐴢 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔𐴇𐴡𐴌𐴡𐴏𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑, 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴡𐴤 𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴕𐴡.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s1">𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴁𐴡𐴘𐴧𐴝𐴕</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴌𐴃𐴧𐴟 𐴀𐴟𐴀𐴙𐴕 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴎𐴞𐴀𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴦𐴓𐴞𐴔 𐴓𐴡𐴘 𐴔𐴞𐴓𐴢 𐴇𐴝𐴥. <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />𐴔𐴡𐴌𐴡𐴃𐴢 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴘𐴁𐴞𐴤 𐴊𐴠, 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴢 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴙𐴓𐴃𐴡, 𐴀𐴞𐴎𐴧𐴡𐴃𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴣𐴙𐴓𐴃𐴡; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕, 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴌𐴝𐴑𐴞𐴥𐴃𐴡.<verse eid="TIT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 2:3" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴔𐴝𐴘𐴝 𐴔𐴟𐴌𐴟𐴁𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴡𐴥 𐴈𐴡𐴘𐴁𐴞𐴤 𐴊𐴠, 𐴀𐴞𐴎𐴧𐴡𐴙𐴃𐴧𐴝 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴌𐴝𐴑𐴞𐴥𐴃𐴡, 𐴒𐴞𐴉𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴐𐴡𐴥𐴌𐴝𐴁𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴕𐴡 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴐𐴞𐴥𐴑𐴝𐴘𐴃𐴡, <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴅𐴟𐴖𐴝𐴕 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴀𐴞𐴀𐴕𐴡𐴌 𐴃𐴡𐴌𐴁𐴞𐴘𐴡𐴃𐴢 𐴊𐴞 𐴉𐴝𐴌𐴠, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />𐴀𐴝𐴑𐴧𐴡𐴥𐴓𐴢 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴙𐴓𐴃𐴡, 𐴂𐴝𐴑 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴒𐴡𐴥𐴌𐴡𐴌 𐴈𐴝𐴔𐴧𐴗𐴝 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴔𐴠𐴀𐴌𐴁𐴝𐴕 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴕𐴡.<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴅𐴟𐴖𐴝𐴕 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴘𐴡𐴥 𐴀𐴝𐴑𐴧𐴡𐴥𐴓𐴢 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴙𐴓𐴃𐴡 𐴁𐴟𐴎𐴢 𐴊𐴞𐴐𐴢. <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />𐴃𐴟𐴘 𐴕𐴞𐴎𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴌 𐴕𐴡𐴔𐴟𐴕𐴝 𐴁𐴡𐴕. 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴃𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴞𐴘𐴡𐴃𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴞𐴐𐴢. <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴓𐴡𐴉𐴎𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴐𐴢, 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴓𐴎𐴝𐴔 𐴊𐴞 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴕𐴝𐴥𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴡𐴌 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝𐴃𐴢 𐴉𐴡𐴌𐴠.<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴈𐴡𐴘𐴁𐴞𐴤 𐴊𐴠, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴞𐴌𐴡𐴥𐴏𐴡𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴡𐴌𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴌𐴝𐴑𐴞𐴥𐴃𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤𐴌 𐴖𐴡𐴃𐴧𐴟𐴥 𐴕𐴡 𐴔𐴝𐴃𐴞𐴃𐴡𐴥, <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />𐴏𐴟𐴌𐴞 𐴕𐴡 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴌𐴞 𐴊𐴝𐴈𐴝𐴤𐴘𐴃𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴒𐴡𐴌𐴞 𐴇𐴝𐴥𐴣𐴎𐴝𐴘 𐴉𐴝𐴌𐴠.<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴡 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴡 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝. <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴐𐴞𐴥𐴑𐴝 𐴊𐴠, 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴔𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴠 𐴅𐴝𐴥𐴈𐴝𐴕𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴀𐴝𐴑𐴧𐴡𐴥𐴓𐴢, 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴃𐴡𐴥, <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴟𐴥𐴐𐴞 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴝𐴐𐴝𐴤 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴞𐴤, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝 𐴃𐴝𐴥𐴓𐴝 𐴀𐴠𐴊𐴧𐴠 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴞𐴤; <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴀𐴓𐴢 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴠𐴊𐴞𐴕𐴞 𐴈𐴝𐴔𐴡𐴃𐴧𐴟 𐴏𐴟𐴥𐴌𐴝𐴘 𐴁𐴡𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴈𐴝𐴥𐴀𐴏𐴢 𐴑𐴡𐴗𐴔 𐴁𐴝𐴕𐴝𐴘𐴃𐴡𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴅𐴟𐴏𐴢 𐴃𐴝𐴥𐴑𐴠.<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />𐴇𐴞𐴥𐴀𐴕 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴅𐴡𐴏𐴁𐴝 𐴒𐴡𐴥𐴓𐴝𐴘 𐴊𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴡𐴓𐴃𐴞 𐴊𐴝𐴈𐴝𐴤𐴘𐴊𐴠. 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴡𐴌𐴠𐴥 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴥𐴗𐴑.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s1">𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴠 𐴊𐴠 𐴑𐴞, 𐴊𐴠𐴐𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴊𐴞𐴑𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴝𐴕𐴞𐴃𐴡𐴥, 𐴉𐴡𐴃𐴧𐴞𐴥 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴕𐴡 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢 𐴕𐴡 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴐𐴞𐴥𐴊𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴡𐴌𐴡𐴔𐴊𐴝𐴌𐴞 𐴊𐴝𐴈𐴝𐴤𐴘𐴃𐴡. <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴑 𐴇𐴝𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴃𐴡 𐴀𐴡𐴁𐴟𐴎𐴢, 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴀𐴝𐴦𐴌 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴔𐴡𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴘𐴝𐴐𐴞𐴌 𐴒𐴟𐴓𐴝𐴔𐴞𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴟𐴐𐴧𐴡𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴏𐴡𐴌𐴡𐴃𐴠 𐴁𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴃𐴝𐴥𐴔; 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴃𐴡 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴞𐴕𐴏𐴝𐴥𐴕-𐴎𐴝𐴃𐴞𐴓𐴧𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠, <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴝𐴏𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴠 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴇𐴡𐴕𐴡𐴤 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞 𐴔𐴡𐴎𐴞𐴕 𐴁𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴁𐴝𐴏𐴝𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴎𐴠 𐴌𐴟𐴀𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴝𐴘 𐴕𐴡𐴘𐴝 𐴎𐴡𐴌𐴔𐴡 𐴊𐴞𐴘𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴘𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴞𐴦𐴘𐴠𐴥, <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴠, <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴞𐴘𐴡𐴌𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴔𐴞𐴌𐴝𐴏𐴊𐴝𐴥𐴌 𐴁𐴡𐴕𐴞 𐴉𐴝𐴌𐴞, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴐𐴝𐴤 𐴀𐴝𐴏𐴠𐴤. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />𐴇𐴞𐴥𐴀𐴕 𐴇𐴡𐴥𐴑 𐴈𐴡𐴃𐴝𐴤. 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴘 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴃𐴢 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴝𐴌 𐴀𐴟𐴎𐴟 𐴊𐴞𐴥𐴘𐴝𐴕 𐴊𐴠. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴡𐴤𐴕 𐴃𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴁𐴝𐴥𐴓𐴝 𐴀𐴝𐴦𐴌 𐴉𐴝𐴥𐴘𐴊𐴝𐴌 𐴈𐴝𐴔.<verse eid="TIT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 3:9" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴠𐴇𐴝𐴌 𐴃𐴡𐴌𐴑𐴝𐴃𐴡𐴌𐴑𐴞, 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴔𐴝𐴃𐴝𐴔𐴝𐴃𐴞, 𐴀𐴝𐴦𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢 𐴊𐴞𐴘𐴝𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴑𐴞𐴐𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴝𐴥𐴘, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴇𐴝𐴌. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴠𐴑𐴁𐴝𐴌 𐴊𐴟𐴘𐴁𐴝𐴌 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴞𐴐𐴢, 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴧𐴡𐴥𐴘 𐴀𐴝𐴌 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴕𐴡 𐴌𐴝𐴑𐴞𐴥𐴐𐴢, <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴘 𐴃𐴡 𐴎𐴝𐴕𐴡𐴏𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴧𐴟 𐴓𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴝.<verse eid="TIT 3:11" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴌𐴃𐴞𐴔𐴝𐴏𐴡𐴌𐴠 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴟𐴑𐴞𐴑𐴟𐴏𐴡𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴟𐴔, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴠𐴥𐴍𐴠 𐴕𐴞𐴑𐴡𐴥𐴂𐴡𐴓𐴞𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴎𐴠𐴀𐴕𐴠 𐴉𐴝𐴌𐴡𐴏𐴢 𐴇𐴠𐴥𐴀𐴕𐴠 𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴐𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴐𐴞𐴥𐴃𐴑𐴝𐴓𐴢 𐴇𐴠𐴥𐴍𐴠 𐴈𐴝𐴍𐴝𐴘𐴁𐴝𐴥𐴌 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥. <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />𐴀𐴟𐴑𐴞𐴓𐴢 𐴎𐴠𐴕𐴝𐴤𐴏𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴂𐴡𐴥𐴓𐴡𐴏𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴎𐴠𐴊𐴧𐴟𐴥𐴌 𐴉𐴝𐴌𐴡𐴏𐴢 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴐𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴔𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑𐴝 𐴐𐴞𐴥𐴑𐴡𐴕 𐴎𐴡𐴌𐴟𐴌, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴎𐴠𐴍𐴠𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴌𐴟𐴌 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴐𐴝𐴥𐴌 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴁𐴡.<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌. 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴐𐴢, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥.</para>
  <para style="p" vid="TIT 3:15">𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>