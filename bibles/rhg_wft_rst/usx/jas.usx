<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴘𐴝𐴑𐴟𐴁𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴝𐴑𐴟𐴁𐴢</para>
  <para style="toc2">𐴘𐴝𐴑𐴟𐴁𐴢</para>
  <para style="toc3">𐴘𐴝𐴑</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt">𐴘𐴝𐴑𐴟𐴁𐴢</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴘 𐴘𐴝𐴑𐴟𐴁𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴐𐴟𐴥𐴌𐴟𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴁𐴟𐴎𐴟𐴌𐴒𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴎𐴠 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴀𐴙𐴓𐴢 𐴇𐴠𐴥𐴍𐴠 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 (<char style="xt"><ref loc="ACT 15:13">𐴈𐴝𐴔𐴡𐴥𐴓𐴢 15‏:13</ref></char>). 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴀𐴠𐴑 ”𐴄𐴟𐴥𐴕𐴞“ 𐴁𐴡𐴓𐴞 𐴈𐴡𐴘𐴧𐴠𐴥 (<char style="xt"><ref loc="GAL 2:9">𐴒𐴝𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴢 2‏:9</ref></char>). 𐴀𐴟𐴓𐴠𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢 𐴁𐴡𐴏𐴡𐴥𐴌 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴃𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴘𐴝𐴑𐴟𐴁𐴢 𐴀𐴠𐴎𐴧𐴡𐴕 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴕𐴠𐴃𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝 𐴇𐴠𐴥𐴍𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥.</para>
  <para style="ip">𐴘𐴝𐴑𐴟𐴁𐴠 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝 𐴁𐴝𐴌𐴡𐴥 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴊𐴡𐴌𐴁𐴡𐴊𐴡𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 <char style="ior">(<ref loc="JAS 1:1">1‏:1</ref>)</char>. 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴝𐴑𐴟𐴁𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴏𐴠𐴥𐴁𐴡𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴎𐴡𐴌𐴟𐴌𐴞, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠 ”𐴁𐴝𐴌𐴡𐴥 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕“ 𐴈𐴡𐴀𐴘𐴢 𐴓𐴡𐴉𐴎𐴡𐴥 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠, 𐴘𐴝𐴑𐴟𐴁𐴠 𐴌𐴟𐴀𐴌𐴟 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴁𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴠 𐴁𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠; 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴞𐴁𐴝𐴤𐴃𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴔𐴡𐴗𐴎𐴟𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤. 𐴘𐴝𐴑𐴟𐴁𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴞𐴔𐴝𐴕𐴡𐴌𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝𐴘𐴁𐴡 <char style="ior">(<ref loc="JAS 2:17">2‏:17</ref>)</char>. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴑 𐴕𐴡𐴎𐴡𐴌𐴠 𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴘𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥 <char style="ior">(<ref loc="JAS 2:1-4">2‏:1‏-4</ref>)</char> 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴡𐴁𐴝𐴕 𐴏𐴡𐴥𐴣𐴓𐴞 𐴈𐴡𐴃𐴝𐴤 𐴇𐴡𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴞𐴥𐴘𐴠 <char style="ior">(<ref loc="JAS 3:1-12">3‏:1‏-12</ref>)</char>.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴉𐴡𐴌𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="JAS 1:1">1‏:1</ref>) </char></para>
  <para style="io1">2. 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴟𐴑 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴎𐴢 <char style="ior">(<ref loc="JAS 1:2-27">1‏:2‏-27</ref>) </char></para>
  <para style="io1">3. 𐴀𐴞𐴔𐴝𐴕𐴡𐴌𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴊𐴝𐴈𐴡𐴥𐴕 𐴎𐴡𐴌𐴟𐴌 <char style="ior">(<ref loc="JAS 2">2</ref>) </char></para>
  <para style="io1">4. 𐴎𐴡𐴁𐴝𐴕 𐴏𐴡𐴥𐴣𐴓𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤𐴌 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 <char style="ior">(<ref loc="JAS 3:1-12">3‏:1‏-12</ref>) </char></para>
  <para style="io1">5. 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴞𐴘𐴝𐴕 𐴓𐴡𐴘 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴒𐴞𐴘𐴝𐴕 𐴓𐴡𐴘 𐴑𐴞𐴦 𐴉𐴡𐴌𐴡𐴥𐴑؟ <char style="ior">(<ref loc="JAS 3:13-4:10">3‏:13‏—4‏:10</ref>) </char></para>
  <para style="io1">6. 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴙𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 <char style="ior">(<ref loc="JAS 4:11-5:6">4‏:11‏—5‏:6</ref>) </char></para>
  <para style="io1">7. 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 <char style="ior">(<ref loc="JAS 5:7-20">5‏:7‏-20</ref>)</char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />𐴀𐴝𐴀𐴛 𐴘𐴝𐴑𐴟𐴁𐴢, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴒𐴟𐴓𐴝𐴔.</para>
  <para style="p" vid="JAS 1:1">𐴎𐴠 𐴁𐴝𐴌𐴡𐴥 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴊𐴡𐴌𐴁𐴡𐴊𐴡𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔.<verse eid="JAS 1:1" /></para>
  <para style="s1">𐴀𐴞𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴒𐴞𐴘𐴝𐴕</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢,<note caller="+" style="f"><char style="fr" closed="false">1‏:2 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴟𐴕𐴞𐴥 𐴒𐴟𐴥𐴕 𐴒𐴡𐴥𐴓𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴃𐴎𐴞𐴥𐴘𐴝𐴙𐴕; 𐴀𐴝𐴌𐴡𐴤 𐴏𐴡𐴀 𐴀𐴝𐴘𐴝𐴃𐴢 16 𐴀𐴠𐴊𐴧𐴠 19; 𐴀𐴝𐴦𐴌 2:1, 5, 14; 3:10, 12; 4:11; 5:7, 9, 10, 12, 19.</char></note> 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴌𐴡, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴁𐴝𐴥𐴒𐴧𐴞𐴃𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴞𐴘𐴡, <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴠 𐴏𐴡𐴁𐴡𐴥𐴌 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />𐴀𐴝𐴦𐴌 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴈𐴝𐴔 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴞𐴥𐴘𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴝𐴥𐴄𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴈𐴡𐴔𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠. <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴎𐴡𐴊𐴞 𐴒𐴞𐴘𐴝𐴕𐴡𐴌 𐴈𐴡𐴔𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴔𐴝𐴒𐴡𐴗𐴑, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴊𐴞𐴦𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴠𐴎𐴝𐴌 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡𐴌𐴠 𐴊𐴞𐴓𐴑𐴟𐴥𐴓𐴝 𐴒𐴡𐴥𐴌𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴊𐴠𐴦. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴐𐴡𐴥𐴑 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴔𐴝𐴕𐴠 𐴔𐴝𐴒𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴐𐴡𐴥𐴑 𐴒𐴡𐴌𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴃𐴡 𐴊𐴡𐴙𐴅𐴧𐴝𐴌 𐴒𐴡𐴙𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕𐴡𐴌𐴠 𐴁𐴡𐴘𐴧𐴝𐴌𐴠 𐴀𐴞𐴑𐴧𐴝𐴤-𐴀𐴟𐴙𐴑𐴧𐴝𐴤 𐴓𐴡𐴘𐴎𐴝𐴒𐴡𐴥𐴘. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴐𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴡𐴕 𐴃𐴡 𐴊𐴟𐴘 𐴔𐴞𐴑𐴧𐴝𐴥; 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴄𐴞𐴑𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠.<verse eid="JAS 1:8" /></para>
  <para style="s1">𐴒𐴡𐴌𐴞𐴁𐴢 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />𐴒𐴡𐴌𐴞𐴁𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴖𐴡𐴌𐴡𐴌 𐴃𐴡𐴑𐴧𐴝𐴃𐴢 𐴃𐴟𐴙𐴓𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴑; <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />𐴀𐴝𐴦𐴌 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌𐴞 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠 𐴁𐴞𐴓𐴡𐴌 𐴉𐴟𐴥𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴝𐴐𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />𐴁𐴠𐴙𐴓𐴢 𐴃𐴡 𐴁𐴞𐴐𐴞𐴤 𐴒𐴡𐴌𐴡𐴔𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴟𐴍𐴞𐴤 𐴒𐴝𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴥𐴖𐴝𐴘𐴉𐴠𐴓𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴉𐴟𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴥𐴌𐴞𐴎𐴝𐴘 𐴀𐴝𐴌 𐴐𐴟𐴥𐴕𐴊𐴡𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔 𐴓𐴡𐴘 𐴁𐴞𐴌𐴝𐴕𐴝 𐴃𐴝𐴥𐴑𐴞𐴃𐴠-𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.<verse eid="JAS 1:11" /></para>
  <para style="s1">𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴁𐴝𐴤, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴏𐴡𐴁𐴡𐴥𐴌 𐴌𐴝𐴑𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴞𐴃𐴞 𐴁𐴝𐴦𐴊𐴠 𐴃𐴝𐴏𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘𐴁𐴡, 𐴎𐴞𐴁𐴝𐴤 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴞𐴦𐴁𐴝𐴌 𐴖𐴝𐴦𐴊𐴝 𐴊𐴞𐴘𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥.<verse eid="JAS 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 1:13" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 ”𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥,“ 𐴁𐴡𐴥𐴓𐴞 𐴕𐴡 𐴈𐴡𐴀𐴗𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴥𐴌𐴝𐴉𐴞𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴟𐴎𐴟 𐴄𐴝𐴕𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴟𐴎𐴟 𐴕𐴡 𐴄𐴝𐴕𐴠. <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴡𐴕𐴐𐴝𐴥𐴃𐴧𐴟 𐴁𐴠 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴎𐴞𐴀𐴕𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴄𐴝𐴕𐴞 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />𐴁𐴝𐴦𐴊𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴡𐴕𐴐𐴝𐴥 𐴇𐴞𐴥𐴀𐴕 𐴇𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴡𐴥𐴘 𐴒𐴟𐴕𐴝𐴤 𐴎𐴡𐴌𐴔𐴡 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴒𐴟𐴕𐴝𐴤 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘 𐴔𐴡𐴦𐴃𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴉𐴝𐴥𐴑𐴞 𐴕𐴝 𐴇𐴝𐴥𐴘𐴧𐴡. <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />𐴉𐴡𐴃𐴧𐴞𐴥 𐴒𐴡𐴔 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴇𐴝𐴥𐴄𐴞 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴁𐴠 𐴕𐴞𐴏𐴠 𐴀𐴝𐴘𐴧𐴠𐴤; 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴁𐴝𐴉𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴕𐴟𐴌𐴝𐴕𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴀𐴞𐴥𐴁𐴝 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴡 𐴁𐴡𐴊𐴡𐴓𐴠 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴓𐴡𐴌𐴞𐴎𐴝𐴒𐴡𐴥𐴘 𐴊𐴠 𐴏𐴝𐴥𐴁𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴓𐴡𐴥𐴘 𐴏𐴡𐴥𐴘𐴧𐴞 𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴡𐴘𐴝 𐴎𐴞𐴁𐴡𐴕 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴁𐴧𐴠 𐴑𐴞𐴔𐴡𐴃𐴢 𐴀𐴡𐴓𐴝 𐴒𐴟𐴥𐴕 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴞.<verse eid="JAS 1:18" /></para>
  <para style="s1">𐴉𐴟𐴥𐴕𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴘𐴝𐴀𐴕 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥𐴘𐴡 𐴊𐴠 𐴑𐴞: 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴉𐴟𐴥𐴕𐴝𐴃𐴢 𐴏𐴝𐴓𐴟 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝 𐴈𐴡𐴘𐴃𐴠𐴤 𐴁𐴝𐴥𐴉𐴞𐴏𐴞𐴕𐴃𐴞 𐴈𐴡𐴖𐴝𐴤 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴒𐴟𐴐𐴧𐴝𐴤 𐴕𐴡 𐴀𐴟𐴍𐴝𐴤 𐴉𐴡𐴌𐴞𐴁𐴡𐴥; <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴏𐴝𐴀 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴒𐴟𐴐𐴧𐴝𐴤 𐴓𐴡𐴥𐴘 𐴈𐴝𐴍𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴝𐴔𐴝𐴥𐴔 𐴁𐴟𐴌𐴝 𐴀𐴝𐴊𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴌𐴟𐴖𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴑𐴝𐴓𐴝𐴔𐴡𐴌𐴠 𐴕𐴡𐴌𐴡𐴔𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴡𐴏𐴞𐴥𐴓𐴡, 𐴎𐴞𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴊𐴞 𐴉𐴝𐴌𐴠.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />𐴑𐴝𐴓𐴝𐴔 𐴀𐴝𐴔𐴡𐴥𐴓𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴁𐴡𐴕𐴡, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴉𐴟𐴥𐴕𐴡𐴘𐴝 𐴕𐴡, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴉𐴝𐴥𐴑𐴞 𐴊𐴡𐴥𐴌 𐴉𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴥𐴕𐴡𐴘𐴝 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴔𐴡𐴥𐴓𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴡, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝 𐴀𐴝𐴘𐴕𐴝𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴏𐴝𐴀; <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴒𐴡𐴌𐴞 𐴏𐴝𐴀𐴘𐴢 𐴎𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴝𐴘𐴃𐴠𐴥 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴝𐴙𐴒𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴥𐴇𐴡𐴕 𐴉𐴡𐴀𐴌𐴝𐴘𐴉𐴠𐴓𐴠. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴎𐴝𐴊𐴞 𐴊𐴠𐴊𐴠 𐴇𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴞𐴘𐴡𐴔𐴡𐴌 𐴀𐴟𐴎𐴟 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴡𐴔𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴎𐴡𐴌 𐴊𐴞𐴘𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴉𐴟𐴥𐴕𐴞 𐴉𐴡𐴀𐴌𐴝𐴘 𐴕𐴡 𐴉𐴠𐴓𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴊𐴞𐴕𐴊𐴝𐴥𐴌 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌 𐴎𐴡𐴁𐴝𐴕 𐴕𐴡 𐴏𐴡𐴥𐴣𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴉𐴝𐴥𐴑𐴞 𐴊𐴠𐴥𐴌, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴁𐴠𐴇𐴝𐴌. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴡𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴂𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴠𐴃𐴞𐴔 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴟𐴑𐴧𐴡𐴥𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴏𐴝𐴀𐴏𐴞𐴃𐴝 𐴒𐴡𐴌𐴡𐴤𐴕, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴈𐴡𐴥𐴌𐴝𐴉𐴞𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴌𐴝𐴑𐴡𐴥𐴕.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s1">𐴀𐴠𐴑𐴃𐴡𐴌𐴉𐴞𐴥𐴘𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴓𐴝 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴡𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴠𐴑 𐴕𐴡𐴎𐴡𐴌𐴠 𐴏𐴝𐴘𐴧𐴡𐴥. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />𐴊𐴡𐴥𐴌𐴡, 𐴀𐴠𐴎𐴧𐴡𐴕 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴅𐴞𐴓𐴞𐴥𐴐𐴡𐴃𐴢 𐴐𐴟𐴥𐴕𐴝𐴌 𐴀𐴡𐴀𐴣𐴍𐴞 𐴊𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴌𐴞𐴥𐴑 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌 𐴉𐴞𐴣𐴊𐴞𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴒𐴡𐴌𐴞𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴎𐴝𐴌 𐴒𐴝𐴙𐴌𐴡𐴌 𐴇𐴡𐴦𐴌 𐴕𐴞𐴌𐴡𐴥𐴐𐴢. <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴁𐴝𐴌𐴞𐴥𐴑 𐴇𐴡𐴦𐴌 𐴉𐴞𐴣𐴊𐴞𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴟𐴎𐴟 𐴈𐴝𐴥𐴀𐴏𐴢 𐴊𐴞𐴥𐴘𐴝𐴕 𐴊𐴞𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀, ”𐴃𐴟𐴀𐴛 𐴀𐴠 𐴒𐴡𐴔 𐴎𐴝𐴒𐴝 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴁𐴡𐴘𐴧𐴡𐴥,“ 𐴀𐴝𐴦𐴌 𐴒𐴡𐴌𐴞𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀, ”𐴃𐴟𐴘 𐴀𐴟𐴍𐴠𐴤 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴑, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴕𐴞𐴏𐴠 𐴀𐴝𐴣𐴀𐴌 𐴄𐴠𐴥𐴚𐴡𐴌 𐴋𐴝𐴥𐴑𐴠 𐴒𐴡𐴥𐴌𐴞 𐴁𐴡𐴘,“ <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴡𐴌𐴡𐴥𐴑 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤 𐴕𐴠𐴥 𐴀𐴝𐴦𐴌 𐴁𐴟𐴌𐴝 𐴕𐴞𐴘𐴡𐴃𐴠 𐴁𐴞𐴏𐴝𐴌 𐴕𐴡𐴥 𐴒𐴡𐴌𐴡𐴤 𐴕𐴠𐴥؟<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕, 𐴉𐴟𐴥𐴕𐴡, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴙𐴅𐴧𐴡 𐴖𐴝𐴀𐴕𐴡𐴌 𐴔𐴞𐴌𐴝𐴏𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴊𐴞𐴦𐴁𐴝𐴌 𐴖𐴝𐴦𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥؟ <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠 𐴒𐴡𐴌𐴞𐴉𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴡 𐴕𐴠𐴥 𐴎𐴝𐴓𐴝 𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴄𐴝𐴕𐴞-𐴄𐴝𐴕𐴞 𐴁𐴞𐴏𐴝𐴌𐴡𐴃𐴢 𐴃𐴟𐴓𐴠𐴥 𐴊𐴠𐴥؟ <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴡 𐴕𐴠𐴥 𐴀𐴟𐴁𐴝𐴤𐴌 𐴀𐴞𐴎𐴧𐴡𐴙𐴃𐴧𐴝 𐴕𐴝𐴔𐴡𐴌 𐴑𐴟𐴉𐴠𐴥𐴌𐴞 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥؟<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.“<note caller="+" style="f"><char style="fr" closed="false">2‏:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 19‏:18</ref></char></char></note> 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴌 𐴇𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴡𐴔 𐴈𐴝𐴔 𐴒𐴡𐴌𐴡𐴤𐴌. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴡𐴊𐴞 𐴀𐴠𐴑𐴃𐴡𐴌𐴉𐴞𐴥𐴘𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴡𐴤𐴌 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴁𐴝𐴥𐴚𐴒𐴡𐴘𐴝 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴟𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴝𐴥𐴚𐴒𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴃𐴡 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴝𐴥𐴙𐴚𐴒𐴠 𐴁𐴡𐴥𐴓𐴞 𐴊𐴡𐴥𐴌𐴝 𐴎𐴝𐴘𐴁𐴡. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥, ”𐴎𐴠𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝,“<note caller="+" style="f"><char style="fr" closed="false">2‏:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:14">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 20‏:14</ref></char>; <char style="xt"><ref loc="DEU 5:18">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 5‏:18</ref></char> </char></note> 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴥 𐴈𐴡𐴘𐴧𐴠𐴥, ”𐴑𐴟𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝.“<note caller="+" style="f"><char style="fr" closed="false">2‏:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:13">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 20‏:13</ref></char>; <char style="xt"><ref loc="DEU 5:17">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 5‏:17</ref></char></char></note> 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴑𐴟𐴥𐴕 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴁𐴝𐴥𐴚𐴒𐴡𐴘𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘.<verse eid="JAS 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12" />𐴇𐴡𐴕𐴡𐴤 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴃𐴠𐴤 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥𐴘𐴡 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴀𐴝𐴎𐴝𐴊𐴞 𐴊𐴠𐴊𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴓𐴡𐴥𐴘 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴁𐴞𐴏𐴝𐴌𐴡𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴘𐴡𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴌𐴝𐴇𐴝𐴥𐴔 𐴊𐴞𐴓𐴢 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴃𐴡 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝.<verse eid="JAS 2:13" /></para>
  <para style="s1">𐴀𐴞𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀, ”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴏𐴠𐴤,“ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴝𐴥𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴑𐴞𐴦 𐴉𐴝𐴥𐴘𐴊𐴝 𐴀𐴝𐴏𐴠𐴤؟ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴔𐴝𐴕𐴠 𐴑𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴝𐴏𐴝𐴘 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟ <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />𐴊𐴡𐴥𐴌𐴡, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴁𐴝𐴥𐴘 𐴀𐴡𐴥𐴃𐴧𐴟 𐴘𐴝𐴥 𐴁𐴡𐴥𐴙𐴕 𐴀𐴡𐴥𐴃𐴧𐴟 𐴉𐴞𐴣𐴊𐴞𐴥𐴃𐴡 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴈𐴝𐴥𐴘𐴃𐴡 𐴈𐴝𐴥𐴕𐴝 𐴕𐴝𐴥𐴘. <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />𐴇𐴠𐴥 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀, ”𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴡𐴦𐴒𐴡𐴥𐴘, 𐴀𐴟𐴔 𐴃𐴝𐴥𐴙𐴑𐴧𐴡 𐴀𐴝𐴦𐴌 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴡𐴥,“ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴌𐴝 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴑𐴞𐴦 𐴉𐴝𐴥𐴘𐴊𐴝 𐴀𐴝𐴏𐴠𐴤؟ <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴎𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴝𐴥𐴘, 𐴇𐴠𐴥 𐴀𐴞𐴔𐴝𐴕 𐴔𐴡𐴌𐴝.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴁𐴡𐴤, ”𐴑𐴞𐴘𐴡𐴥𐴃𐴧𐴟 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴑𐴞𐴘𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴀𐴝𐴏𐴠𐴤.“ 𐴄𐴞𐴥𐴑 𐴀𐴝𐴏𐴠𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴏𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴝𐴈𐴝𐴤𐴘 𐴉𐴝𐴌𐴞𐴁𐴝𐴥 𐴕𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴔𐴡𐴥𐴓𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴘 𐴉𐴝𐴙𐴅𐴧𐴟𐴔. <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />𐴃𐴟𐴀𐴛 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠𐴑𐴒𐴗𐴝𐴥. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴥𐴓𐴝! 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴋𐴡𐴦𐴌𐴠 𐴇𐴝𐴉𐴠.<verse eid="JAS 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20" />𐴀𐴡𐴥 𐴁𐴠𐴑𐴟𐴉𐴢, 𐴎𐴠 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴝𐴥𐴘 𐴇𐴠𐴥 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴊𐴝𐴔 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴃𐴟𐴀𐴛 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴏𐴡𐴀 𐴕𐴠𐴥؟ <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔 𐴃𐴡 𐴀𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴙𐴅𐴧𐴞𐴓𐴢, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴈𐴝𐴥𐴑𐴡𐴌𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴖𐴡𐴌𐴠 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />𐴃𐴟𐴀𐴛 𐴃𐴡 𐴊𐴠𐴑𐴡𐴥𐴌, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴀𐴠𐴑𐴧𐴟 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴡𐴣𐴃𐴧𐴠𐴤 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴡𐴥𐴘𐴧𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴙𐴕𐴧𐴞𐴥𐴓𐴢.“<note caller="+" style="f"><char style="fr" closed="false">2‏:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:6">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 15‏:6</ref></char></char></note> 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 ”𐴊𐴟𐴏𐴃𐴡𐴥“ 𐴋𐴝𐴙𐴑𐴧𐴠𐴥. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴡𐴥, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴔𐴝𐴕 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴕𐴡 𐴄𐴡𐴥𐴀𐴌𐴠, 𐴄𐴡𐴥𐴀𐴌𐴞𐴃𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴀𐴡𐴥 𐴓𐴝𐴒𐴠.<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />𐴌𐴝𐴇𐴝𐴥𐴁𐴝 𐴕𐴝𐴔𐴡𐴌 𐴔𐴝𐴒𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴖𐴝𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝. 𐴇𐴞𐴥𐴁𐴝 𐴀𐴠 𐴀𐴝𐴔𐴡𐴥𐴓𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴙𐴅𐴧𐴞𐴓𐴢, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴒𐴟𐴌𐴞𐴕𐴊𐴝<note caller="+" style="f"><char style="fr" closed="false">2‏:25 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa" closed="false">𐴅𐴝𐴦𐴏𐴟𐴏𐴢</char></note> 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴑𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴁𐴡𐴓𐴞 𐴊𐴟𐴣𐴌𐴝𐴘𐴊𐴞𐴀𐴓𐴢. <verse eid="JAS 2:25" /><verse number="26" style="v" sid="JAS 2:26" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝, 𐴌𐴟𐴀 𐴏𐴝𐴥𐴌𐴝 𐴒𐴝𐴦 𐴔𐴡𐴌𐴝, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴏𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴡𐴥 𐴔𐴡𐴌𐴝.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s1">𐴕𐴞𐴎𐴡𐴌 𐴎𐴡𐴁𐴝𐴕 𐴏𐴡𐴥𐴣𐴓𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴕 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴕𐴡 𐴁𐴡𐴙𐴕𐴧𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴝𐴏𐴞𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴞𐴘𐴡𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴒𐴡𐴓𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴞𐴥. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴁𐴝𐴓𐴡𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴎𐴞𐴀𐴕 𐴈𐴡𐴀 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴒𐴟𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴦 𐴒𐴟𐴣𐴍𐴝𐴌𐴠 𐴏𐴡𐴥𐴣𐴓𐴞 𐴌𐴝𐴑𐴞𐴥 𐴉𐴝𐴌𐴠.<verse eid="JAS 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JAS 3:3" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴒𐴟𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴣𐴓𐴞 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴒𐴟𐴥𐴌𐴝𐴌 𐴒𐴝𐴓𐴡𐴃𐴢 𐴓𐴠𐴈𐴝𐴕 𐴓𐴝𐴒𐴝𐴘, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴒𐴟𐴣𐴍𐴝 𐴒𐴝𐴦𐴌𐴠 𐴎𐴞𐴑𐴧𐴝𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴇𐴞𐴥𐴑𐴧𐴝 𐴓𐴡𐴘𐴎𐴝𐴘 𐴉𐴝𐴌𐴞. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />𐴎𐴝𐴀𐴣𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥 𐴁𐴝𐴥𐴉𐴞𐴏𐴡: 𐴇𐴞𐴥𐴀𐴕 𐴎𐴠𐴃𐴧𐴡𐴥𐴌 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴡𐴥𐴑 𐴀𐴝𐴦𐴌 𐴎𐴠𐴀𐴕 𐴃𐴠𐴎𐴢 𐴁𐴡𐴘𐴧𐴝𐴌𐴠 𐴏𐴡𐴓𐴞𐴁𐴡𐴥 𐴏𐴡𐴓𐴡𐴗𐴑, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴏𐴠𐴥𐴌𐴝𐴙𐴚𐴒𐴝𐴘𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴞𐴐𐴞𐴤 𐴐𐴡𐴥𐴣𐴍𐴡 𐴏𐴟𐴥𐴖𐴝𐴕 𐴓𐴡𐴥𐴘𐴧𐴡𐴌𐴠 𐴎𐴞𐴑𐴧𐴝𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴇𐴞𐴥𐴑𐴧𐴝 𐴓𐴡𐴘𐴎𐴝. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴞𐴌 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴝𐴦𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴣𐴍𐴡 𐴇𐴞𐴥𐴏𐴧𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴘 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴠𐴥. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴁𐴝𐴥𐴉𐴡, 𐴀𐴠𐴑𐴧𐴞𐴕𐴞𐴥𐴏𐴧𐴝𐴌𐴝 𐴀𐴡𐴦𐴙𐴕 𐴓𐴡𐴘 𐴇𐴡𐴃𐴡𐴥 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴎𐴡𐴦𐴣𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴌𐴝𐴃𐴢 𐴊𐴞 𐴉𐴝𐴌𐴠. <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />𐴎𐴞𐴌 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴘𐴡𐴥; 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴝𐴦𐴃𐴢 𐴎𐴠 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴞𐴌𐴡𐴌𐴠 𐴑𐴟𐴈𐴝𐴔𐴡𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴝𐴌𐴠. 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴝𐴦 𐴀𐴝𐴒𐴝𐴒𐴟𐴌𐴝 𐴕𐴝𐴉𐴝𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴒𐴟𐴣𐴍𐴝𐴃𐴢 𐴀𐴡𐴦𐴙𐴕 𐴊𐴡𐴥𐴌𐴝𐴘 𐴊𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴎𐴟𐴎𐴟𐴑𐴡𐴌 𐴀𐴡𐴦𐴙𐴕 𐴀𐴝𐴏𐴠𐴤.<verse eid="JAS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7" />𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴠 𐴃𐴡 𐴇𐴝𐴥𐴀𐴌 𐴑𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴅𐴝𐴕𐴟𐴖𐴝𐴌, 𐴉𐴝𐴙𐴑, 𐴁𐴟𐴑𐴠 𐴀𐴝𐴥𐴣𐴍𐴠 𐴊𐴠 𐴎𐴝𐴕𐴊𐴝𐴥𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥𐴌 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴏𐴡𐴥𐴣𐴙𐴓𐴧𐴠 𐴀𐴠𐴊𐴧𐴠 𐴘𐴝𐴓𐴝 𐴘𐴡𐴥 𐴏𐴡𐴥𐴣𐴓𐴠. <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴎𐴞𐴌𐴡𐴌𐴠 𐴏𐴡𐴥𐴣𐴓𐴞 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴕𐴝𐴥𐴘; 𐴎𐴞𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴏𐴡𐴥𐴣𐴓𐴞 𐴉𐴝𐴌𐴝 𐴕𐴡 𐴎𐴝; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴝𐴥𐴉𐴡𐴌 𐴁𐴞𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤 𐴇𐴡𐴥𐴃𐴝𐴌𐴝.<verse eid="JAS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 3:9" />𐴇𐴠𐴥 𐴎𐴞𐴌 𐴎𐴞𐴘𐴝𐴥𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴉𐴡𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴠 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌𐴠 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴀𐴡𐴥 𐴊𐴞. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴠 𐴔𐴟𐴑 𐴀𐴡𐴥𐴃𐴧𐴟 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴝𐴘𐴧𐴠𐴤 𐴇𐴠𐴥 𐴔𐴟𐴑 𐴀𐴡𐴥𐴃𐴧𐴟 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴀𐴡𐴥 𐴀𐴝𐴘𐴧𐴠𐴤. 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴀𐴡𐴥𐴕 𐴏𐴝𐴥. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />𐴎𐴠 𐴕𐴡𐴓𐴑𐴗𐴝𐴃𐴧𐴟 𐴔𐴟𐴃𐴟𐴥𐴌𐴝 𐴉𐴝𐴕𐴞𐴥 𐴀𐴟𐴍𐴠𐴤, 𐴇𐴠𐴥 𐴕𐴡𐴓𐴑𐴗𐴝𐴃𐴧𐴟 𐴑𐴞𐴥 𐴕𐴟𐴕𐴝 𐴉𐴝𐴕𐴞𐴥 𐴘𐴡𐴥 𐴀𐴟𐴍𐴠𐴤 𐴕𐴠𐴥؟ <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕, 𐴋𐴟𐴣𐴙𐴌-𐴒𐴝𐴏𐴡𐴃𐴢 𐴑𐴞𐴥 𐴎𐴡𐴓𐴉𐴝𐴘 𐴊𐴡𐴥𐴌𐴠 𐴕𐴠𐴥؟ 𐴀𐴝𐴦𐴌 𐴀𐴝𐴚𐴒𐴟𐴌-𐴒𐴝𐴏𐴡𐴃𐴢 𐴑𐴞𐴥 𐴋𐴟𐴣𐴙𐴌 𐴒𐴟𐴓𐴝 𐴊𐴡𐴥𐴌𐴠 𐴕𐴠𐴥؟ 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴕𐴟𐴕𐴝 𐴉𐴝𐴕𐴞𐴥𐴌 𐴕𐴡𐴓𐴑𐴗𐴝𐴃𐴧𐴟 𐴔𐴟𐴃𐴟𐴥𐴌𐴝 𐴉𐴝𐴕𐴞𐴥 𐴕𐴡 𐴀𐴟𐴍𐴠𐴤.<verse eid="JAS 3:12" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴒𐴞𐴘𐴝𐴕</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴞𐴘𐴝𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴎𐴡𐴥𐴕𐴡𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟ 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴓𐴝 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴓𐴡𐴘 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴡𐴥𐴗𐴑 𐴊𐴠 𐴑𐴞, 𐴒𐴞𐴘𐴝𐴕 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴎𐴠 𐴕𐴡𐴌𐴡𐴔𐴊𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠 𐴇𐴠𐴥 𐴕𐴡𐴌𐴡𐴔𐴊𐴝𐴌𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴌𐴞𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴖𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴒𐴟𐴔𐴝𐴕 𐴕𐴡 𐴁𐴡𐴙𐴕𐴧𐴡 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴣𐴏𐴝𐴌𐴠 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡 𐴁𐴝𐴕𐴝𐴘𐴧𐴡𐴥. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴞𐴘𐴝𐴕 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴃𐴧𐴟, 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴡𐴕𐴐𐴝𐴥 𐴃𐴧𐴟, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴥𐴃𐴉𐴠𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴃𐴧𐴟. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴍𐴠𐴥 𐴌𐴞𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴖𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔 𐴀𐴡𐴥 𐴃𐴝𐴥𐴑𐴠.<verse eid="JAS 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠 𐴒𐴞𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴒𐴠 𐴂𐴝𐴑, 𐴁𐴝𐴦𐴊𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴘𐴠 𐴁𐴡𐴥𐴌𐴝; 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴐𐴞𐴥𐴊𐴝𐴘𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴎𐴢 𐴀𐴝𐴏𐴠𐴤; 𐴇𐴞𐴥𐴘𐴝𐴕 𐴌𐴝𐴇𐴝𐴥𐴔𐴠 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴔 𐴕𐴡𐴃𐴞𐴎𐴝𐴘𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝; 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴉𐴡𐴌𐴡𐴥𐴑𐴝𐴘 𐴘𐴝𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑𐴞 𐴕𐴝𐴥𐴘. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴝𐴕𐴞𐴤𐴁𐴝𐴌 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴊𐴝𐴘𐴁𐴝𐴌 𐴁𐴞𐴏𐴢 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴐𐴞𐴥𐴣𐴍𐴠.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s1">𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴓𐴧𐴡𐴘 𐴊𐴟𐴏𐴃𐴞𐴥𐴒𐴞𐴌𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴝𐴌𐴝𐴔𐴝𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢 𐴇𐴡𐴕𐴃𐴟𐴤 𐴀𐴝𐴘𐴧𐴠𐴤؟ 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴘𐴝𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴠 𐴀𐴝𐴎𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴃𐴧𐴟 𐴕𐴡 𐴕𐴠𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠, 𐴎𐴞𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴝𐴦𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴠𐴥؟ <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴡𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴉𐴝𐴘𐴓𐴠 𐴑𐴟𐴥𐴕 𐴒𐴡𐴌𐴡𐴤. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴓𐴝𐴓𐴡𐴥𐴏𐴢 𐴓𐴝𐴒𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴉𐴝𐴘𐴓𐴠 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴡𐴤 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴌𐴝𐴔𐴝𐴌𐴞 𐴊𐴡. 𐴃𐴡𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴕𐴡 𐴔𐴝𐴒𐴡. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴒𐴞𐴓𐴠𐴥 𐴘𐴡 𐴕𐴡 𐴉𐴡𐴦, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴕𐴞𐴘𐴡𐴃𐴠 𐴀𐴠𐴥𐴕𐴝 𐴔𐴝𐴒𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴝𐴘𐴝𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴡.<verse eid="JAS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4" />𐴀𐴡𐴥 𐴁𐴠𐴘𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴓𐴧𐴡𐴘 𐴊𐴟𐴏𐴃𐴞𐴥 𐴒𐴡𐴌𐴡𐴤𐴕 𐴔𐴝𐴀𐴕𐴞 𐴀𐴝𐴓𐴧𐴝 𐴓𐴧𐴡𐴘 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴕 𐴊𐴠𐴥؟ 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴓𐴧𐴡𐴘 𐴊𐴟𐴏𐴃𐴞𐴥 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴝𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴁𐴝𐴕𐴝. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴘𐴝𐴀𐴕 𐴇𐴝𐴥𐴕𐴧𐴝𐴑 𐴀𐴝𐴏𐴠𐴤 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴡, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴠 𐴌𐴟𐴀 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴇𐴠𐴥 𐴌𐴟𐴀 𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴒𐴝𐴘𐴌𐴡𐴃𐴢 𐴓𐴝𐴒𐴠؟“ <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="JAS 4:6">”𐴀𐴝𐴓𐴧𐴝 𐴉𐴡𐴇𐴡𐴥𐴌 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴃𐴞𐴥𐴘𐴝,</para>
  <para style="q2" vid="JAS 4:6">𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥.“<note caller="+" style="f"><char style="fr" closed="false">4‏:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 3:34">𐴔𐴠𐴀𐴏𐴝𐴓𐴢 3‏:34</ref></char></char></note><verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡. 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴔𐴟𐴑𐴝𐴁𐴠𐴓𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴊𐴝𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴀𐴝𐴘𐴁𐴡𐴤. 𐴀𐴡𐴥 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴘 𐴔𐴞𐴑𐴧𐴝𐴥 𐴔𐴡𐴕 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴢 𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴡𐴤. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴇𐴝𐴥𐴘 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴒𐴡𐴌𐴡𐴤 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴓𐴝𐴑 𐴒𐴡𐴌𐴡𐴤; 𐴀𐴝𐴥𐴣𐴐𐴝𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴈𐴝𐴣𐴊𐴡, 𐴀𐴝𐴦𐴌 𐴑𐴟𐴥𐴐𐴞𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴀𐴡𐴥. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴀𐴡𐴥, 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴖𐴡𐴌𐴡𐴌 𐴃𐴡𐴑𐴧𐴝𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴁𐴡.<verse eid="JAS 4:10" /></para>
  <para style="s1">𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴌𐴀𐴠𐴑 𐴁𐴝𐴥𐴘𐴡𐴌<note caller="+" style="f"><char style="fr" closed="false">4‏:11 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴌𐴠 𐴁𐴝𐴥𐴘 𐴈𐴡𐴀𐴘𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴔𐴡𐴌𐴡𐴃𐴢 𐴉𐴟𐴖𐴝, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴃𐴎𐴞𐴥𐴘𐴝𐴙𐴕;</char></note> 𐴁𐴡𐴊𐴕𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴘𐴝𐴥 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴉𐴝𐴥𐴕 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴉𐴝𐴥𐴕. 𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴃𐴟𐴀𐴛 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴊𐴡𐴦𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌 𐴀𐴠𐴑𐴎𐴡𐴕 𐴁𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴁𐴝𐴏𐴝𐴘 𐴘𐴡𐴥 𐴉𐴝𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴘𐴡𐴥 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴀𐴛 𐴇𐴡𐴕 𐴀𐴝𐴁𐴝𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴀𐴝𐴃𐴠𐴇𐴝𐴣𐴏𐴡𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴝𐴥؟<verse eid="JAS 4:12" /></para>
  <para style="s1">𐴁𐴡𐴌𐴝𐴥𐴙𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />𐴉𐴟𐴥𐴕𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀, ”𐴀𐴝𐴙𐴅𐴧𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴓𐴠 𐴇𐴝𐴙𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴡𐴥𐴓𐴝𐴕𐴝 𐴐𐴡𐴥𐴀𐴌 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴝𐴘𐴧𐴟𐴔, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴠𐴑 𐴁𐴡𐴏𐴡𐴥𐴌 𐴃𐴝𐴥𐴑𐴞 𐴁𐴝𐴦𐴊𐴠 𐴐𐴡𐴥𐴊𐴡𐴌𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴞𐴐𐴞𐴤-𐴁𐴞𐴐𐴞𐴤 𐴄𐴞𐴛𐴝 𐴈𐴝𐴔𐴝𐴘𐴧𐴟𐴥𐴔.“ <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴇𐴝𐴙𐴓𐴧𐴝 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴃𐴡 𐴁𐴝𐴥𐴉𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕 𐴀𐴠𐴏𐴧𐴝𐴥𐴃𐴢 𐴀𐴝𐴥𐴕𐴞𐴑 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴒𐴝𐴙𐴁𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴕 𐴏𐴝𐴀, ”𐴔𐴝𐴓𐴞𐴑𐴠 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔 𐴀𐴝𐴦𐴌 𐴖𐴝𐴀𐴕-𐴘𐴝𐴀𐴕 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔.“ <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠 𐴒𐴟𐴔𐴝𐴕𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴡𐴤; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴡𐴌𐴝𐴥𐴘 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴈𐴡𐴥𐴌𐴝𐴉𐴢. <verse eid="JAS 4:16" /><verse number="17" style="v" sid="JAS 4:17" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴡𐴔 𐴔𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴎𐴝𐴕𐴠 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴥𐴘𐴁𐴡.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s1">𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />𐴀𐴡𐴥 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴟𐴥𐴕𐴡, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴠 𐴋𐴡𐴣𐴀𐴌 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴝𐴘𐴧𐴠𐴤𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴓𐴧𐴝 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴓𐴝𐴑 𐴒𐴡𐴌𐴡𐴤. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌𐴞 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌 𐴀𐴟𐴦𐴘𐴧𐴠 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴟𐴥𐴕𐴝-𐴐𐴝𐴣𐴊𐴞𐴃𐴢 𐴎𐴡𐴦𐴣𐴌𐴠 𐴊𐴡𐴙𐴅𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴎𐴡𐴦𐴣𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴁𐴡 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴦𐴙𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴝𐴦 𐴉𐴟𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴊𐴞𐴕𐴡𐴃𐴢 𐴀𐴠𐴥𐴕𐴝 𐴊𐴡𐴥𐴕 𐴎𐴡𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴡. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />𐴏𐴡𐴀, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴡𐴥𐴏𐴡𐴓𐴢-𐴊𐴡𐴦𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠 𐴔𐴟𐴎𐴟𐴌𐴞 𐴁𐴠𐴘𐴔𐴝𐴕𐴞 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴞𐴥𐴊𐴞𐴘𐴡, 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴓𐴝𐴉𐴢 𐴒𐴟𐴎𐴡𐴌𐴠𐴌, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥 𐴊𐴡𐴦𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴝𐴣𐴊𐴝𐴕𐴞 𐴀𐴝𐴓𐴧𐴝 𐴌𐴡𐴁𐴧𐴟𐴓𐴢 𐴀𐴝𐴦𐴓𐴝𐴔𐴞𐴕𐴡𐴌 𐴈𐴝𐴕𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴉𐴟𐴥𐴌𐴟𐴃𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴘𐴝𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴠 𐴊𐴞𐴕 𐴈𐴝𐴍𐴝𐴘𐴧𐴡𐴥. 𐴎𐴡𐴦𐴌𐴝𐴥𐴘𐴁𐴝𐴌 𐴊𐴞𐴕𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴝 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴁𐴡𐴓𐴝𐴘𐴧𐴡𐴥. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥𐴘𐴡 𐴀𐴝𐴦𐴌 𐴑𐴟𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴑𐴝𐴁𐴠𐴓𐴝 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥.<verse eid="JAS 5:6" /></para>
  <para style="s1">𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕, 𐴔𐴝𐴓𐴞𐴑 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴏𐴡𐴁𐴡𐴥𐴌 𐴒𐴡𐴌𐴡𐴤. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴝𐴀𐴘𐴢 𐴉𐴝𐴌𐴞𐴁𐴝𐴥, 𐴐𐴝𐴐𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴑𐴞𐴔𐴡𐴃𐴞 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴡𐴃𐴡𐴥 𐴏𐴡𐴁𐴡𐴥𐴌 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴎𐴠𐴄𐴢 𐴔𐴝𐴐𐴡𐴃𐴧𐴟 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴌𐴞𐴥 𐴀𐴡𐴀𐴕 𐴔𐴝𐴐𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌 𐴒𐴡𐴌𐴠𐴥. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴏𐴡𐴁𐴡𐴥𐴌 𐴒𐴡𐴌𐴡𐴤. 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴌𐴝𐴑𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴋𐴝𐴥𐴑𐴠. <verse eid="JAS 5:8" /><verse number="9" style="v" sid="JAS 5:9" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴐𐴠𐴥𐴑𐴝𐴘𐴡𐴃𐴢 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴏𐴟𐴥𐴌 𐴕𐴡 𐴊𐴡𐴥𐴌𐴠. 𐴉𐴟𐴥𐴕𐴡, 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴡𐴌 𐴒𐴟𐴌𐴝𐴃𐴢 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠𐴒𐴝𐴘.<verse eid="JAS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 5:10" />𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕, 𐴎𐴠 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴕𐴝𐴔𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴊𐴟𐴑 𐴉𐴝𐴦𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴁𐴡𐴥𐴌 𐴒𐴡𐴌𐴝𐴥𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴓𐴡𐴥. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴟𐴑 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴔𐴟𐴁𐴝𐴌𐴠𐴑 𐴁𐴡𐴓𐴞 𐴈𐴡𐴀𐴘𐴢. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴘𐴟𐴁𐴠 𐴊𐴟𐴑 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴡; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴎𐴝𐴕𐴡, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴉𐴡𐴌𐴠𐴎𐴝𐴘 𐴔𐴝𐴁𐴟𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. 𐴔𐴝𐴁𐴟𐴊𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴠𐴄𐴉𐴟𐴌𐴝𐴕𐴞𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞𐴘𐴠 𐴉𐴟𐴌𐴝𐴘𐴧𐴝.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕, 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴏𐴔𐴝𐴕 𐴀𐴡𐴌, 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴘𐴝𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴕𐴝𐴔𐴠 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴈𐴡𐴏𐴡𐴥𐴔 𐴕𐴝 𐴇𐴝𐴥𐴘𐴧𐴡. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴕𐴝𐴤 𐴀𐴠𐴊𐴧𐴟𐴥𐴌 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴀𐴡𐴥𐴘𐴓𐴠 𐴕𐴡, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴞𐴁𐴝.<verse eid="JAS 5:12" /></para>
  <para style="s1">𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴊𐴟𐴑𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥؟ 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴥𐴗𐴑. 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴐𐴟𐴥𐴑𐴧𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥؟ 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴝𐴦𐴌𐴞𐴉𐴡𐴌 𐴏𐴠𐴀𐴌 𐴒𐴡𐴗𐴀𐴑. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴡𐴐𐴟𐴥𐴙𐴑𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴕𐴠𐴥؟ 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴋𐴝𐴘𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴃𐴡𐴗𐴑, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴀𐴘𐴢 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴕𐴝𐴔𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴃𐴠𐴓𐴢 𐴊𐴞𐴘𐴡𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴥𐴗𐴑. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />𐴎𐴡𐴊𐴞 𐴇𐴠𐴥 𐴊𐴟𐴖𐴝 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴡𐴐𐴟𐴥𐴙𐴑𐴧𐴝 𐴖𐴝 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴓𐴞𐴑𐴠. 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴎𐴡𐴊𐴞 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴞𐴥 𐴃𐴝𐴥𐴑𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴎𐴝𐴘𐴁𐴡. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴡𐴐𐴟𐴥𐴑𐴡𐴃𐴧𐴟 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴡. 𐴀𐴠𐴎𐴧𐴡𐴕 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴕𐴊𐴝𐴌 𐴊𐴟𐴖𐴝𐴃𐴢 𐴁𐴞𐴐𐴞𐴤 𐴁𐴡𐴓𐴢 𐴃𐴝𐴥𐴑𐴠 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴊𐴟𐴖𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴠.<verse eid="JAS 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 5:17" />𐴕𐴡𐴁𐴞 𐴀𐴠𐴓𐴞𐴘𐴝𐴏𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴎𐴡𐴥𐴌 𐴕𐴡 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴊𐴞𐴓𐴔𐴡𐴕 𐴊𐴞 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴓𐴧𐴟𐴑𐴡𐴃𐴢 𐴐𐴝𐴥𐴌𐴡 𐴃𐴞𐴕 𐴁𐴡𐴏𐴡𐴥𐴌 𐴉𐴝𐴥𐴕 𐴎𐴡𐴥𐴌 𐴕𐴡𐴥 𐴊𐴠. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />𐴀𐴝𐴁𐴝𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴎𐴡𐴥𐴌𐴡𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴧𐴟 𐴎𐴡𐴥𐴌 𐴉𐴡𐴌𐴞 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴡𐴥𐴌𐴝 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴎𐴝𐴦𐴒𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴉𐴞𐴥𐴌𐴝𐴘 𐴀𐴝𐴕𐴠𐴤, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴞 𐴓𐴡𐴑 𐴊𐴠 𐴑𐴞, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴡𐴕𐴡𐴤 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌𐴡𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴌𐴝𐴏𐴃𐴝𐴃𐴧𐴟 𐴉𐴞𐴥𐴌𐴝𐴘 𐴀𐴝𐴕𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴠𐴥 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌𐴡𐴌 𐴎𐴝𐴕 𐴁𐴝𐴏𐴝𐴘𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴝𐴌 𐴁𐴞𐴐𐴞𐴤 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴝𐴉𐴢 𐴉𐴝𐴦 𐴁𐴝𐴘𐴧𐴠𐴥.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>