<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">1 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc2">1 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="toc3">1𐴘𐴡</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">1 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴡𐴃𐴧𐴟 𐴀𐴠𐴑 𐴐𐴡𐴥𐴃𐴢 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴁𐴡𐴓𐴞 𐴉𐴡𐴌𐴞𐴏𐴡 𐴕𐴡𐴥 𐴊𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴌𐴟𐴑𐴟𐴥𐴃𐴢 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴖𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴑𐴊𐴝𐴈𐴝𐴤 𐴒𐴡𐴁𐴝𐴤 <char style="ior">(<ref loc="1JN 1:1-3">1‏:1‏-3</ref>)</char>. 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴓𐴠𐴑𐴝𐴥𐴌 𐴋𐴡𐴥𐴑 𐴀𐴡𐴥 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌 𐴋𐴡𐴥𐴑 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝. 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 1 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 2 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝, 3 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥.</para>
  <para style="ip">𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴃𐴝𐴔𐴝𐴥𐴔 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴡𐴣𐴃𐴧𐴠𐴤 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 ”𐴕𐴡𐴏𐴄𐴞𐴑“ 𐴈𐴡𐴀 𐴊𐴠 𐴊𐴡𐴓𐴢 𐴓𐴡𐴘 𐴉𐴠𐴌𐴠𐴐𐴝𐴕𐴞𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴞𐴥𐴀𐴕𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴀𐴞𐴏𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴓𐴧𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴓𐴡𐴖𐴢 𐴓𐴡𐴘 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴁𐴡𐴕𐴞 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴏𐴟𐴑𐴊𐴝𐴈𐴝𐴤 𐴒𐴡𐴁𐴝𐴤 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴞𐴎𐴠 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴝𐴥𐴃𐴠 𐴊𐴡𐴥𐴙𐴅𐴧𐴠 <char style="ior">(<ref loc="1JN 1:1-5">1‏:1‏-5</ref>)</char>. 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴑𐴟𐴥𐴐𐴞 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥 <char style="ior">(<ref loc="1JN 1:4">1‏:4</ref>)</char>, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥𐴃𐴧𐴟 𐴀𐴡𐴀𐴣𐴏𐴞 𐴉𐴝𐴌𐴠 <char style="ior">(<ref loc="1JN 2:1">2‏:1</ref>)</char>, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴃𐴧𐴟 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴉𐴝𐴌𐴠 <char style="ior">(<ref loc="1JN 2:26">2‏:26</ref>)</char>, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴕𐴝𐴘𐴊𐴞 𐴉𐴝𐴌𐴠 <char style="ior">(<ref loc="1JN 5:13">5‏:13</ref>)</char>.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 <char style="ior">(<ref loc="1JN 1:1-4">1‏:1‏-4</ref>)</char></para>
  <para style="io1">2. 𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴟𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴏𐴝𐴤𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 <char style="ior">(<ref loc="1JN 1:5-3:10">1‏:5‏—3‏:10</ref>)</char></para>
  <para style="io1">3. 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴞𐴘𐴝 <char style="ior">(<ref loc="1JN 3:11-5:12">3‏:11‏—5‏:12</ref>)</char></para>
  <para style="io1">4. 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 <char style="ior">(<ref loc="1JN 5:13-21">5‏:13‏-21</ref>)</char></para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s1">𐴎𐴞𐴕𐴊𐴞𐴒𐴞-𐴊𐴡𐴦𐴘𐴝 𐴑𐴝𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴟𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴞𐴁𐴝𐴤 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴔𐴟𐴑 𐴎𐴡𐴁𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴠𐴤 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴒𐴡𐴥𐴌𐴞 𐴏𐴝𐴀𐴘𐴧𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴠 𐴊𐴡𐴥𐴙𐴅𐴧𐴞, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞-𐴊𐴡𐴦𐴘𐴝 𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠; 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴁𐴝𐴉𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴀𐴕 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴀𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴠. 𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴃𐴡 𐴁𐴝𐴉𐴢 𐴓𐴡𐴘 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴓𐴧𐴡𐴥𐴘 𐴀𐴠𐴥𐴕𐴝. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴀𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴑𐴟𐴥𐴐𐴞 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥.<verse eid="1JN 1:4" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴟𐴌</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴟𐴌, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴕𐴝𐴥𐴘. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘 𐴎𐴡𐴊𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴝𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴌. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴟𐴌𐴡𐴃𐴢 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴕𐴟𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕 𐴓𐴡𐴘 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤𐴌 𐴓𐴡𐴖𐴢 𐴖𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴒𐴟𐴕𐴝𐴤𐴃𐴧𐴟 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="1JN 1:7" /><verse number="8" style="v" sid="1JN 1:8" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴡𐴊𐴞 𐴈𐴡𐴀𐴘𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴒𐴟𐴕𐴝𐴤 𐴕𐴝𐴥𐴘; 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴉𐴝𐴥𐴑𐴞 𐴊𐴞𐴥𐴌 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴝𐴥𐴘. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴟𐴈𐴝𐴔𐴡𐴃𐴧𐴟 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌; 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴕𐴝𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴡𐴊𐴞 𐴈𐴡𐴀𐴘𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴡𐴕𐴡𐴤 𐴒𐴟𐴕𐴝𐴤 𐴕𐴡𐴥 𐴒𐴡𐴌𐴞𐴥; 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴞𐴏𐴝𐴥𐴑𐴟𐴌 𐴁𐴝𐴕𐴝𐴙𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴕𐴝𐴥𐴘.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴐𐴟𐴥𐴖𐴝𐴌𐴞𐴐𐴒𐴝𐴌</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴀𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴟𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴊𐴠 𐴁𐴝𐴉𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴎𐴧𐴡𐴕 𐴐𐴟𐴥𐴖𐴝𐴌𐴞𐴐𐴒𐴝𐴌 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />𐴀𐴞𐴥𐴁𐴝 𐴕𐴞𐴎𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤𐴌 𐴑𐴡𐴉𐴧𐴝𐴌𐴝; 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴒𐴟𐴕𐴝𐴤𐴌 𐴀𐴡𐴥.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴟𐴔 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴞𐴥. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀, ”𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴞𐴥,“ 𐴓𐴠𐴑𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴔𐴞𐴏𐴝𐴥𐴑𐴟𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴝𐴥𐴘. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴞𐴤. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴞𐴤 𐴈𐴡𐴀𐴘𐴢 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴝𐴌 𐴉𐴡𐴥𐴌𐴡𐴏𐴢.<verse eid="1JN 2:6" /></para>
  <para style="s1">𐴕𐴡𐴘𐴝 𐴇𐴡𐴥𐴑𐴟𐴔</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴘𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴓𐴠𐴑𐴞𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴉𐴟𐴌𐴝𐴕𐴝 𐴇𐴡𐴥𐴑𐴟𐴔, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴉𐴟𐴌𐴝𐴕𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴟𐴥𐴙𐴕𐴧𐴡 𐴊𐴠 𐴇𐴠𐴥 𐴑𐴝𐴓𐴝𐴔. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />𐴀𐴝𐴌𐴀𐴠𐴑 𐴌𐴟𐴖𐴝𐴃𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴡𐴘𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴓𐴠𐴑𐴞𐴥𐴌 𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴝𐴌𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴕𐴊𐴝𐴤𐴌 𐴉𐴟𐴥𐴌𐴝𐴘𐴎𐴝𐴌𐴒𐴡𐴘 𐴀𐴝𐴦𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴕𐴟𐴌 𐴎𐴡𐴓𐴝 𐴐𐴟𐴥𐴌𐴟 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴟𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴞𐴤 𐴈𐴡𐴀 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴕𐴟𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴟𐴅𐴝𐴥𐴄𐴢 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴞𐴥𐴃𐴠 𐴇𐴡𐴍𐴠𐴥 𐴎𐴝𐴦𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴏𐴟𐴑 𐴀𐴝𐴣𐴊𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠.<verse eid="1JN 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1JN 2:12" />𐴀𐴡𐴥 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴑𐴞𐴥𐴌,</para>
  <para style="q2" vid="1JN 2:12">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴝𐴔𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠.<verse eid="1JN 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1JN 2:13" />𐴀𐴡𐴥 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴑𐴞𐴥𐴌,</para>
  <para style="q2" vid="1JN 2:13">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴟𐴁𐴝𐴤𐴌𐴠 𐴏𐴞𐴕𐴡𐴥 𐴎𐴞𐴁𐴝𐴤 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴏𐴠𐴤.</para>
  <para style="q1" vid="1JN 2:13">𐴀𐴡𐴥 𐴅𐴟𐴖𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴑𐴞𐴥𐴌,</para>
  <para style="q2" vid="1JN 2:13">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴙𐴐𐴧𐴡𐴥.</para>
  <para style="q1" vid="1JN 2:13">𐴀𐴡𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴙𐴑𐴧𐴞𐴥,</para>
  <para style="q2" vid="1JN 2:13">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴁𐴝𐴉𐴡𐴌𐴠 𐴏𐴞𐴕𐴡𐴥.<verse eid="1JN 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1JN 2:14" />𐴀𐴡𐴥 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴙𐴑𐴧𐴞𐴥,</para>
  <para style="q2" vid="1JN 2:14">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴟𐴁𐴝𐴤𐴌𐴠 𐴏𐴞𐴕𐴡𐴥 𐴎𐴞𐴁𐴝𐴤 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴢 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴏𐴠𐴤.</para>
  <para style="q1" vid="1JN 2:14">𐴀𐴡𐴥 𐴅𐴟𐴖𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴓𐴠𐴙𐴑𐴧𐴞𐴥,</para>
  <para style="q2" vid="1JN 2:14">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴎𐴁𐴟𐴃𐴢;</para>
  <para style="q2" vid="1JN 2:14">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴃𐴝𐴥𐴑𐴠,</para>
  <para style="q2" vid="1JN 2:14">𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴙𐴐𐴧𐴡𐴥.<verse eid="1JN 2:14" /></para>
  <para style="s1">𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴘𐴝𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴉𐴡𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴝𐴥𐴘. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡, 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴀𐴝𐴎𐴧𐴟, 𐴏𐴟𐴑𐴡𐴌 𐴓𐴝𐴓𐴡𐴥𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴁𐴡𐴌𐴝𐴥𐴘; 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴉𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴝𐴎𐴧𐴟 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴥𐴌𐴝𐴘𐴎𐴝𐴌𐴒𐴡𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.<verse eid="1JN 2:17" /></para>
  <para style="s1">𐴊𐴡𐴙𐴅𐴧𐴝𐴓𐴢</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />𐴀𐴡𐴥 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴘𐴝𐴓𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴡𐴑𐴃𐴡𐴥; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴡, 𐴊𐴡𐴙𐴅𐴧𐴝𐴓𐴢 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴊𐴡𐴙𐴅𐴧𐴝𐴓𐴢 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴘𐴝𐴓𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴡𐴑𐴃𐴡𐴥. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴕𐴠𐴦𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘, 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴠𐴦𐴓𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴏𐴝𐴥𐴉𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴃𐴡 𐴂𐴝𐴑𐴎𐴡𐴕𐴠 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴎𐴝𐴕𐴡. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴞 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴌𐴡𐴤 𐴎𐴝𐴕𐴡 𐴊𐴠 𐴑𐴞, 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴔𐴞𐴏𐴝𐴥 𐴕𐴟 𐴀𐴝𐴘𐴧𐴠𐴤. <verse eid="1JN 2:21" /><verse number="22" style="v" sid="1JN 2:22" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴔𐴞𐴏𐴝𐴥𐴑𐴟𐴌 𐴕𐴡 𐴀𐴡𐴥𐴘 𐴀𐴝𐴌 𐴑𐴞𐴦؟ 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴝𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴊𐴡𐴙𐴅𐴧𐴝𐴓𐴢. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴉𐴢 𐴕𐴝𐴥𐴘; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴟𐴖𐴝𐴌𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴝𐴉𐴢 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴏𐴝𐴘𐴧𐴡𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴎𐴞𐴀𐴕 𐴉𐴟𐴥𐴕𐴞-𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴘𐴧𐴡𐴤𐴌 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠 𐴉𐴝𐴥𐴕. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴎𐴞𐴀𐴕 𐴉𐴟𐴥𐴕𐴞-𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴘𐴧𐴡𐴤𐴌 𐴇𐴞𐴥𐴀𐴕 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴉𐴟𐴖𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴉𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴝. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴊𐴞𐴦𐴁𐴝𐴌 𐴖𐴝𐴦𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴞𐴀𐴕 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴌𐴝𐴏𐴃𐴝𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴃𐴡𐴥 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥𐴌. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞 𐴊𐴞𐴦𐴘𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴌𐴟𐴀𐴘𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴡𐴥𐴘𐴧𐴞. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴌𐴟𐴀𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡.<verse eid="1JN 2:27" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />𐴀𐴡𐴥𐴘, 𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴊𐴞𐴕𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝 𐴕𐴡 𐴉𐴡𐴌𐴠.<verse eid="1JN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1JN 2:29" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴇𐴡𐴥𐴕 𐴀𐴞𐴥𐴁𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴊𐴠 𐴎𐴝𐴕𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴎𐴝𐴕𐴞𐴁𐴝𐴥 𐴊𐴠 𐴑𐴞, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴎𐴡𐴌𐴔𐴡 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴀𐴡𐴥𐴘𐴧𐴠.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />𐴏𐴡𐴀, 𐴁𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴡𐴃𐴡𐴥 𐴋𐴡𐴣𐴀𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝; 𐴀𐴠𐴀𐴕𐴠 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴏𐴡𐴥𐴘𐴧𐴞. 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴘𐴝𐴓𐴝 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴎𐴝𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴦 𐴀𐴡𐴥𐴘𐴧𐴟𐴔 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴎𐴝𐴇𐴠𐴥𐴌 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴊𐴧𐴟𐴥𐴌 𐴎𐴝𐴕𐴞 𐴊𐴠 𐴑𐴞, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴧𐴟𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴠𐴑𐴞𐴥𐴘𐴟𐴔. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />𐴎𐴠𐴃𐴡𐴥 𐴎𐴡𐴕𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴇𐴠𐴥 𐴀𐴝𐴐𐴝𐴤 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴌𐴝𐴑𐴠𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴁𐴝𐴥𐴚𐴒𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴡𐴤𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴁𐴝𐴥𐴚𐴒𐴡𐴕. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴀𐴙𐴓𐴢; 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴒𐴟𐴕𐴝𐴤 𐴕𐴝𐴥𐴘. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠 𐴀𐴞𐴥𐴃𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴞 𐴃𐴝𐴥𐴑𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴏𐴝𐴘𐴧𐴡𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴕𐴡 𐴓𐴡𐴘𐴎𐴝 𐴉𐴝𐴥𐴕. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴞 𐴃𐴝𐴥𐴑𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴢 𐴀𐴡𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴃𐴡 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴀𐴙𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝. <verse eid="1JN 3:8" /><verse number="9" style="v" sid="1JN 3:9" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴞𐴥𐴃𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴞𐴏𐴢 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴞 𐴃𐴝𐴥𐴑𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴦𐴌 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴏𐴞𐴕𐴝𐴥 𐴎𐴝: 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴕𐴡 𐴈𐴝𐴍𐴝 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴟𐴘𐴃𐴠 𐴘𐴡𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥.<verse eid="1JN 3:10" /></para>
  <para style="s1">𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴎𐴞𐴘𐴝𐴥𐴕 𐴉𐴟𐴥𐴕𐴞-𐴉𐴟𐴥𐴕𐴞 𐴀𐴝𐴘𐴧𐴡𐴤𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />𐴑𐴠𐴀𐴙𐴕𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴑𐴟𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴑𐴞𐴘𐴝𐴥 𐴑𐴟𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴙𐴓؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴟𐴌𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌 𐴈𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="1JN 3:12" /><verse number="13" style="v" sid="1JN 3:13" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴦𐴃𐴡𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴉𐴝𐴌𐴝𐴤𐴘𐴞𐴒𐴝𐴘; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴔𐴡𐴦𐴃𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴠𐴤. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴑𐴟𐴥𐴕𐴞, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴇𐴡𐴕𐴡𐴤 𐴑𐴟𐴥𐴕𐴞𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴕𐴝𐴥𐴘.<verse eid="1JN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 3:16" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴀𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴧𐴟 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴈𐴡𐴀 𐴊𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴞𐴥. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴘𐴝𐴌 𐴉𐴡𐴥𐴌𐴡𐴏𐴢. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴎𐴡𐴊𐴞 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴊𐴠𐴑𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡؟ <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴈𐴡𐴃𐴝𐴤𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴁𐴝𐴕𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴈𐴝𐴔𐴠 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴘𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥.<verse eid="1JN 3:18" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />𐴃𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴉𐴝𐴙𐴅𐴧𐴟𐴔 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴉𐴝𐴘𐴁𐴡. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴠 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴝, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴝𐴕𐴠. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴠 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴕𐴡 𐴄𐴡𐴥𐴀𐴌𐴝, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴔𐴝𐴒𐴞 𐴇𐴞𐴥𐴀𐴕 𐴉𐴝𐴘𐴧𐴟𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴎𐴞𐴀𐴕 𐴉𐴡𐴏𐴡𐴥𐴕𐴊𐴝𐴌 𐴇𐴞𐴥𐴀𐴕 𐴒𐴡𐴌𐴞𐴥. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴡𐴤𐴕 𐴀𐴝𐴦𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴕, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴀𐴝𐴏𐴠𐴤.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴙𐴅𐴧𐴝𐴓𐴡𐴌 𐴌𐴟𐴀</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴇𐴝𐴥𐴀𐴌 𐴌𐴟𐴀𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴡𐴥𐴘 𐴕𐴠 𐴕𐴡 𐴃𐴝𐴇𐴝𐴥𐴑𐴞𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴏𐴝𐴘𐴧𐴡𐴥; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴁𐴡𐴀𐴗𐴃𐴢 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴏𐴞𐴕𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥: 𐴎𐴠 𐴌𐴟𐴀𐴘𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕 𐴁𐴡𐴕𐴞 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴠𐴥 𐴌𐴟𐴀 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟; <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠 𐴌𐴟𐴀𐴘𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴐𐴞𐴥𐴑𐴝𐴌 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴠𐴥 𐴌𐴟𐴀 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴕𐴡; 𐴇𐴠𐴥 𐴌𐴟𐴀 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴊𐴡𐴙𐴅𐴧𐴝𐴓𐴢 𐴀𐴡𐴌, 𐴎𐴠 𐴌𐴟𐴀 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴈𐴡𐴃𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴟𐴥𐴙𐴕𐴧𐴡, 𐴀𐴝𐴦𐴌 𐴘𐴝𐴓𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴀𐴘𐴒𐴞𐴥𐴘𐴡𐴒𐴡𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴞𐴁𐴝𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴁𐴝 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴎𐴠𐴦 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴠. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟. 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴏𐴞𐴕𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴥𐴕𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴕𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴉𐴟𐴥𐴕𐴠. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴌𐴟𐴀𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴞𐴌 𐴌𐴟𐴀𐴌𐴠 𐴏𐴞𐴕𐴞𐴥 𐴉𐴝𐴌𐴞.<verse eid="1JN 4:6" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴏𐴞𐴕𐴠𐴥. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴃𐴡 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴘𐴝𐴀𐴕𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴓𐴠𐴇𐴝𐴥𐴌 𐴀𐴠𐴑 𐴉𐴟𐴖𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞 𐴉𐴝𐴌𐴞. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤𐴌 𐴑𐴡𐴉𐴧𐴝𐴌𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠. 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴈𐴡𐴀 𐴊𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢. <verse eid="1JN 4:10" /><verse number="11" style="v" sid="1JN 4:11" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴠𐴃𐴡𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴉𐴡𐴥𐴌𐴡𐴏𐴢. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴡𐴊𐴞 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴏𐴠𐴤.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴌𐴟𐴀𐴃𐴧𐴟 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴀𐴝𐴏𐴞𐴤 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴀𐴝𐴏𐴠𐴤. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥 𐴊𐴠 𐴑𐴞, 𐴁𐴝𐴉𐴠 𐴉𐴟𐴖𐴝𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴓𐴢. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴎𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥.</para>
  <para style="p" vid="1JN 4:16">𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢; 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴑𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴋𐴡𐴦𐴌 𐴕𐴝𐴥𐴘; 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴋𐴡𐴦𐴌𐴡𐴌𐴠 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴋𐴡𐴦𐴌𐴡𐴌 𐴉𐴞𐴏𐴠𐴤 𐴏𐴝𐴥𐴣𐴎𐴝𐴌 𐴏𐴞𐴕𐴃𐴝 𐴃𐴝𐴥𐴑𐴠. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴋𐴡𐴦𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴕𐴝𐴥𐴘.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴒𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀, ”𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥,“ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴔𐴞𐴏𐴝𐴥𐴑𐴟𐴌; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴊𐴠𐴙𐴑𐴧𐴝𐴥 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴕𐴊𐴠𐴙𐴑𐴧𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟ <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴑𐴞, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴘𐴡𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s1">𐴀𐴞𐴔𐴝𐴕𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴎𐴞𐴃𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴊𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴝𐴉𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴘𐴡𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴎𐴝𐴕𐴞 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴟𐴓𐴝𐴂𐴢 𐴕𐴡. <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴞𐴥𐴃𐴠 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴧𐴠𐴤. 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴊𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴃𐴠 𐴕𐴡 𐴀𐴡𐴥𐴘 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴎𐴞𐴃𐴞 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴠؟<verse eid="1JN 5:5" /></para>
  <para style="s1">𐴉𐴟𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴁𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴉𐴝𐴕𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥; 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴉𐴝𐴕𐴞𐴥𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴝𐴕𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴊𐴟𐴖𐴝𐴌𐴝. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴌𐴟𐴀 𐴃𐴡 𐴕𐴞𐴎𐴠 𐴏𐴡𐴥𐴘𐴧𐴞. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />𐴒𐴡𐴁𐴝𐴤𐴊𐴡𐴘𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴃𐴞𐴕، 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠: <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />𐴂𐴝𐴑-𐴌𐴟𐴀, 𐴉𐴝𐴕𐴞𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴓𐴡𐴖𐴢; 𐴇𐴠𐴥 𐴃𐴞𐴕𐴞𐴥 𐴒𐴡𐴁𐴝𐴤𐴘𐴠 𐴀𐴠𐴑𐴞𐴤 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴁𐴝𐴤 𐴊𐴠𐴥. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴒𐴡𐴁𐴝𐴤𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴁𐴝𐴤 𐴃𐴡 𐴀𐴝𐴌𐴡𐴤 𐴋𐴡𐴣𐴀𐴌. 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴖𐴝𐴀𐴕 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴊𐴞𐴘𐴠𐴥. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌 𐴊𐴞𐴓𐴠 𐴇𐴠𐴥 𐴒𐴡𐴁𐴝𐴤 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴞𐴏𐴝𐴥 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴊𐴠 𐴀𐴞𐴥𐴃𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />𐴇𐴠𐴥 𐴒𐴡𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴖𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴏𐴠𐴤. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥 𐴉𐴟𐴖𐴝𐴌𐴠 𐴉𐴝𐴘𐴧𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴠𐴥 𐴉𐴟𐴖𐴝𐴌𐴠 𐴕𐴡𐴥 𐴉𐴝𐴦 𐴀𐴞𐴥𐴃𐴠 𐴇𐴠𐴥 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴕𐴡𐴥 𐴉𐴝𐴦.<verse eid="1JN 5:12" /></para>
  <para style="s1">𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴡𐴤, 𐴀𐴞𐴀𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴓𐴠𐴑𐴞𐴥𐴌 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴝𐴕𐴡. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴠 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴒𐴞, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴟𐴥𐴕𐴠. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴇𐴡𐴥𐴕 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴘𐴝𐴥𐴕 𐴔𐴝𐴒𐴞 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴟𐴥𐴕𐴠; 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴎𐴝𐴕𐴞 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴔𐴝𐴙𐴒𐴧𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴉𐴝𐴘𐴧𐴞𐴥.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴘𐴧𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴊𐴠𐴑𐴠𐴥 𐴎𐴠 𐴒𐴟𐴕𐴝𐴤𐴘𐴠 𐴔𐴡𐴦𐴃𐴢 𐴕𐴟 𐴀𐴝𐴕𐴠𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴠𐴥 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴊𐴞𐴦𐴁𐴡. 𐴀𐴝𐴀𐴛 𐴒𐴟𐴕𐴝𐴤 𐴖𐴝𐴀𐴕𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴎𐴠 𐴒𐴟𐴕𐴝𐴤𐴘𐴠 𐴔𐴡𐴦𐴃𐴢 𐴕𐴟 𐴀𐴝𐴕𐴠𐴤. 𐴔𐴡𐴦𐴃𐴢 𐴀𐴝𐴕𐴠𐴤 𐴊𐴠 𐴒𐴟𐴕𐴝𐴤 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴟𐴕𐴝𐴤 𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴕𐴡. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴑𐴟𐴈𐴝𐴔 𐴒𐴟𐴕𐴝𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴡𐴦𐴃𐴢 𐴕𐴟 𐴀𐴝𐴕𐴠𐴤 𐴊𐴠 𐴒𐴟𐴕𐴝𐴤 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴞𐴥𐴃𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴏𐴟𐴥𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="1JN 5:18" /><verse number="19" style="v" sid="1JN 5:19" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴎𐴝𐴕𐴞 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴑𐴡𐴁𐴎𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="1JN 5:19" /><verse number="20" style="v" sid="1JN 5:20" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴌𐴡𐴤 𐴎𐴝𐴕𐴞 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴟𐴎𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴁𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴞. 𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴁𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴞𐴤, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴖𐴝 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠. 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴦𐴌 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />𐴀𐴡𐴥 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴔𐴟𐴃𐴧𐴞 𐴉𐴟𐴣𐴎𐴝𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘 𐴌𐴝𐴑𐴡𐴥.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>