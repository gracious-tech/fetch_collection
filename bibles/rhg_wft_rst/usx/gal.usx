<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴒𐴝𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴒𐴝𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc2">𐴒𐴝𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc3">𐴒𐴝𐴓𐴢</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴒𐴝𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴒𐴝𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴒𐴝𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 <char style="ior">(<ref loc="GAL 1:1">1‏:1</ref>)</char>. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴏𐴝𐴓𐴞𐴐𐴢-𐴀𐴝𐴣𐴐𐴄𐴡 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴃𐴧𐴟 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢-𐴇𐴝𐴥𐴣𐴃𐴢 𐴁𐴡𐴏𐴡𐴥𐴌𐴡𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴒𐴝𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴝𐴓𐴝𐴃𐴞𐴥𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴡, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴌𐴡𐴔𐴞 𐴐𐴡𐴥𐴌𐴑𐴝𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥. 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴓𐴠𐴑𐴞𐴥𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴇𐴝𐴥𐴄𐴞 𐴇𐴡𐴍𐴠𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴟𐴓𐴠𐴔𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴕𐴡 𐴎𐴝𐴕𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴑𐴡𐴥𐴌𐴞𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠.</para>
  <para style="ip">𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴒𐴝𐴓𐴝𐴃𐴞𐴥𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠. 𐴘𐴝𐴀𐴕 𐴓𐴠𐴑𐴝𐴥𐴌 𐴈𐴝𐴥𐴀𐴏𐴢 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠 𐴁𐴟𐴥𐴓𐴢 𐴐𐴞𐴥𐴑𐴧𐴝 𐴒𐴝𐴥𐴕𐴡𐴌𐴠 𐴇𐴠𐴥𐴃𐴝𐴂𐴢 𐴒𐴡𐴌𐴡𐴤𐴕, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴉𐴟𐴌𐴝𐴕𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴝𐴥𐴌 𐴒𐴝𐴥𐴕. 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴅𐴟𐴊𐴝𐴥𐴘𐴎𐴠𐴌 𐴕𐴝𐴔𐴡𐴌 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴊𐴡𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴈𐴡𐴀 𐴊𐴠, 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴡𐴤𐴕 𐴉𐴡𐴥𐴌𐴡𐴏𐴢. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴒𐴞𐴌𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴙𐴓𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴕𐴞𐴎𐴡𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴑𐴝𐴇𐴝𐴥𐴕𐴞 𐴈𐴡𐴀𐴘𐴢 𐴕𐴞𐴎𐴡𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴒𐴞𐴌𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴡𐴥𐴉𐴝𐴘 𐴊𐴞𐴥𐴓𐴢 <char style="ior">(<ref loc="GAL 1:11-2:14">1‏:11‏—2‏:14</ref>)</char>. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴉𐴝𐴘 𐴊𐴞𐴥𐴓𐴢, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴕𐴠𐴅𐴝𐴃𐴢 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴓𐴠 <char style="ior">(<ref loc="GAL 2:16">2‏:16</ref>)</char>. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴇𐴝𐴥𐴊𐴞𐴘𐴝, 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴕𐴡.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴒𐴝𐴓𐴝𐴃𐴞𐴥𐴘𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="GAL 1:1-5">1‏:1‏-5</ref>)</char></para>
  <para style="io1">2. 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 <char style="ior">(<ref loc="GAL 1:6-10">1‏:6‏-10</ref>)</char></para>
  <para style="io1">3. 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 <char style="ior">(<ref loc="GAL 1:6-2:21">1‏:6‏—2‏:21</ref>)</char></para>
  <para style="io1">4. 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 <char style="ior">(<ref loc="GAL 3-4">3‏—4</ref>)</char></para>
  <para style="io1">5. 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴝𐴎𐴝𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴔𐴧𐴝 <char style="ior">(<ref loc="GAL 5:1-6:10">5‏:1‏—6‏:10</ref>) </char></para>
  <para style="io1">6. 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 <char style="ior">(<ref loc="GAL 6:11-18">6‏:11‏-18</ref>)</char></para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴝𐴥𐴇𐴝𐴁𐴞. 𐴀𐴝𐴀𐴛 𐴀𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴒𐴞𐴌𐴞 𐴇𐴡𐴕𐴡𐴤 𐴋𐴝𐴀𐴙𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴘𐴝𐴥 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠.<verse eid="GAL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 1:2" />𐴀𐴝𐴀𐴛 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕<note caller="+" style="f"><char style="fr" closed="false">1‏:2 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴟𐴕𐴞𐴥 𐴒𐴟𐴥𐴕 𐴒𐴡𐴥𐴓𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴃𐴎𐴞𐴥𐴘𐴝𐴙𐴕; 𐴀𐴝𐴌𐴡𐴤 𐴏𐴡𐴀 𐴀𐴝𐴘𐴝𐴃𐴢 11; 𐴀𐴝𐴦𐴌 3:15; 4:12, 28, 31; 5:11, 13; 6:1, 18.</char></note> 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠, 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴝𐴓𐴝𐴃𐴞𐴥𐴘𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑. <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴃𐴡 𐴀𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴇𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴘𐴠𐴥. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="GAL 1:5" /></para>
  <para style="s1">𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴕𐴝𐴥𐴘</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴃𐴝𐴦𐴅𐴟𐴂𐴢 𐴀𐴡𐴥𐴘𐴧𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴥𐴌𐴝 𐴏𐴝𐴥𐴌𐴞, 𐴀𐴝𐴌𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴇𐴞𐴥𐴑𐴧𐴝 𐴎𐴡𐴀𐴌𐴒𐴡𐴘. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴝𐴌𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴕𐴝𐴥𐴘. 𐴃𐴡𐴀 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴡𐴓𐴎𐴡𐴥𐴓𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴠𐴌, 𐴀𐴝𐴦𐴌 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴁𐴡𐴊𐴡𐴓𐴞 𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴏𐴝𐴥𐴌. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴇𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴌𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴠 𐴒𐴡𐴌𐴞𐴥 𐴘𐴝𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴉𐴡𐴌𐴡𐴗𐴑. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴒𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴓𐴝𐴔 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴡𐴥 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴝𐴌𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴉𐴡𐴌𐴡𐴗𐴑.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴝𐴀𐴛 𐴇𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴉𐴝𐴘𐴃𐴡 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠, 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴕𐴠𐴥 𐴕𐴝𐴥𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌؟ 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴀𐴝𐴀𐴛 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠؟ 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴝𐴘𐴃𐴝𐴥𐴔, 𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴒𐴟𐴓𐴝𐴔 𐴕𐴡 𐴀𐴡𐴥𐴘𐴃𐴝𐴔.<verse eid="GAL 1:10" /></para>
  <para style="s1">𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴁𐴡𐴙𐴕𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴌, 𐴎𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴁𐴝𐴕𐴝𐴖𐴡𐴃𐴞 𐴕𐴡, <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴉𐴝𐴘𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴐𐴞𐴥𐴑𐴝𐴘𐴧𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴞𐴎𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴡, 𐴀𐴠𐴑 𐴇𐴝𐴓𐴠 𐴀𐴝𐴀𐴛 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴊𐴡𐴥𐴌𐴔𐴡𐴃𐴢 𐴃𐴝𐴥𐴘𐴃𐴠 𐴀𐴝𐴣𐴀𐴌 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴇𐴡𐴃𐴡𐴥 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴃𐴡 𐴏𐴝𐴀𐴘𐴓𐴝𐴔, <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />𐴀𐴝𐴦𐴌 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴊𐴡𐴥𐴌𐴔𐴡 𐴔𐴝𐴕𐴝𐴃𐴢 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴐𐴧𐴝𐴤 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴖𐴡𐴌𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴊𐴝𐴊𐴝-𐴁𐴝𐴉𐴊𐴝𐴊𐴝𐴌 𐴌𐴡𐴏𐴡𐴥𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴡𐴥𐴊𐴡𐴌𐴁𐴝𐴀𐴌𐴝 𐴅𐴟𐴏𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴔𐴝𐴦𐴌 𐴉𐴠𐴍𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴡𐴥𐴃𐴞 𐴈𐴝𐴥𐴀𐴏𐴢 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴋𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢. 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴉𐴡𐴏𐴡𐴥𐴕 𐴓𐴝𐴙𐴒𐴧𐴠𐴥 <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴠𐴥 𐴉𐴟𐴖𐴝𐴌𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴔𐴡𐴐𐴖𐴝𐴌𐴝 𐴕𐴡𐴥 𐴓𐴡𐴥𐴘, <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴃𐴡 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴀𐴡𐴥 𐴕𐴡𐴥 𐴎𐴝𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴌𐴡𐴁𐴢 𐴊𐴠𐴐𐴡𐴃𐴢 𐴒𐴞𐴀𐴓𐴝𐴔𐴁𐴡𐴘, 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴁𐴝𐴌 𐴊𐴝𐴔𐴝𐴥𐴏𐴑𐴝𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴖𐴝𐴦𐴉𐴠𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴞𐴤𐴓𐴝𐴔.<verse eid="GAL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴃𐴞𐴕 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠, 𐴑𐴠𐴥𐴉𐴝𐴏𐴢<note caller="+" style="f"><char style="fr" closed="false">1‏:18 </char><char style="ft" closed="false">𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴞𐴃𐴡𐴌</char></note> 𐴓𐴡𐴥𐴘 𐴔𐴞𐴓𐴃𐴡 𐴀𐴝𐴀𐴛 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴒𐴞𐴀𐴓𐴝𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴠𐴥𐴍𐴠 𐴉𐴟𐴕𐴊𐴡𐴥𐴌𐴡 𐴊𐴞𐴕 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴝𐴔; <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴓𐴡𐴥𐴘 𐴔𐴞𐴓𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴞. 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴛 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴝𐴥𐴘 𐴘𐴝𐴑𐴟𐴁𐴢 𐴓𐴡𐴘 𐴘𐴡𐴥 𐴔𐴞𐴓𐴧𐴞𐴥𐴓𐴝𐴔. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴔𐴟𐴀𐴕𐴃𐴟 𐴒𐴡𐴌𐴞𐴥 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴞𐴀𐴕 𐴓𐴠𐴑𐴞𐴥𐴌 𐴇𐴞𐴥𐴀𐴕 𐴔𐴞𐴏𐴝𐴥 𐴕𐴡.<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴏𐴞𐴀𐴌𐴞𐴘𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴑𐴞𐴓𐴞𐴐𐴞𐴥𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴒𐴞𐴀𐴓𐴝𐴔. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴃𐴢 𐴎𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴑 𐴏𐴞𐴕𐴝𐴥 𐴕𐴡 𐴏𐴞𐴕𐴃𐴡𐴥. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴉𐴟𐴥𐴙𐴕𐴃𐴡 𐴊𐴠, ”𐴀𐴝𐴒𐴠 𐴎𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴝𐴓𐴝 𐴀𐴞𐴔𐴝𐴕 𐴖𐴝𐴀𐴕𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴠𐴥𐴌 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴃𐴡 𐴏𐴝𐴀𐴙𐴓𐴢.“ <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s1">𐴀𐴡𐴙𐴕𐴧𐴡 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌𐴠 𐴒𐴡𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />𐴏𐴡𐴙𐴊𐴧𐴡𐴥 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠, 𐴁𐴝𐴥𐴌𐴕𐴝𐴁𐴝𐴏𐴡𐴌𐴠 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴀𐴛 𐴀𐴝𐴁𐴝𐴌 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴒𐴞𐴀𐴓𐴝𐴔. 𐴃𐴞𐴃𐴟𐴏𐴡𐴌𐴠 𐴘𐴡𐴥 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴦𐴘𐴢 𐴒𐴞𐴀𐴓𐴝𐴔. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴠𐴥𐴍𐴠 𐴎𐴝𐴦 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴒𐴞𐴀𐴓𐴝𐴔. 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴛 𐴎𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴍𐴞𐴘𐴝𐴌 𐴋𐴝𐴘𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴏𐴞𐴥𐴌𐴝 𐴁𐴡𐴘𐴍𐴡𐴥𐴑𐴡𐴃𐴢 𐴁𐴟𐴎𐴝𐴥𐴘𐴓𐴝𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴕𐴡𐴥 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴘𐴝𐴥 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴁𐴠𐴉𐴡𐴥𐴎𐴟𐴓𐴢 𐴀𐴡𐴥𐴑. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴃𐴞𐴃𐴟𐴏𐴢 𐴀𐴠𐴎𐴧𐴡𐴕 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴝𐴎𐴟𐴌𐴞 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />𐴇𐴠𐴥 𐴔𐴡𐴏𐴡𐴥𐴓𐴝 𐴒𐴝𐴥𐴕 𐴀𐴟𐴙𐴄𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴑𐴟𐴥𐴖𐴝𐴓𐴝𐴘 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴠 𐴀𐴝𐴎𐴝𐴊𐴞 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴒𐴟𐴌𐴞𐴕𐴊𐴝<note caller="+" style="f"><char style="fr" closed="false">2‏:4 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa" closed="false">𐴅𐴝𐴦𐴏𐴟𐴏𐴢</char></note> 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴒𐴡𐴥𐴙𐴓𐴧𐴞𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴒𐴟𐴓𐴝𐴔 𐴁𐴝𐴕𐴝𐴘 𐴉𐴝𐴌𐴠. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴏𐴧𐴝𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴔𐴝𐴕𐴞 𐴕𐴡𐴥 𐴓𐴡𐴥𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴠.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴋𐴝𐴘𐴋𐴡𐴣𐴀𐴌 𐴁𐴡𐴥𐴓𐴞 𐴔𐴝𐴕𐴝 𐴎𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴝𐴀𐴛 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴇𐴡𐴕𐴡𐴤 𐴕𐴡𐴘𐴝 𐴔𐴡𐴐𐴖𐴝𐴌𐴝 𐴊𐴞 𐴕𐴡𐴥 𐴉𐴝𐴌𐴠. 𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴞𐴀𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴡𐴥𐴑, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴉𐴡𐴌𐴡𐴥𐴑 𐴕𐴝𐴥𐴘. 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴠𐴑𐴃𐴡𐴌𐴉𐴞𐴥𐴘𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞<note caller="+" style="f"><char style="fr" closed="false">2‏:7 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa" closed="false">𐴁𐴠-𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥</char></note> 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴞𐴔𐴧𐴝 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞<note caller="+" style="f"><char style="fr" closed="false">2‏:7 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa" closed="false">𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥</char></note> 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴁𐴝𐴕𐴝𐴘 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴁𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴘𐴡𐴥 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴁𐴝𐴕𐴝𐴘 𐴈𐴝𐴔 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />𐴘𐴝𐴑𐴟𐴁𐴢, 𐴑𐴠𐴥𐴉𐴝𐴏𐴢,<note caller="+" style="f"><char style="fr" closed="false">2‏:9 </char><char style="ft" closed="false">𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴞𐴃𐴡𐴌; 𐴀𐴝𐴌𐴡𐴤 𐴏𐴡𐴀 𐴀𐴝𐴘𐴝𐴃𐴢 11 𐴀𐴠𐴊𐴧𐴠 14</char></note> 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴝𐴥𐴕𐴧𐴝𐴌𐴠 𐴃𐴡 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴄𐴟𐴥𐴕𐴞 𐴁𐴡𐴓𐴞 𐴔𐴝𐴕𐴝 𐴎𐴝. 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴙𐴕𐴧𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴌𐴕𐴝𐴁𐴝𐴏𐴢 𐴓𐴡𐴥𐴘 𐴁𐴡𐴥𐴚 𐴁𐴝𐴣𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴥𐴃𐴢 𐴔𐴞𐴓𐴝𐴘𐴧𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴌𐴝𐴎𐴞 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠, 𐴒𐴡𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴡 𐴉𐴡𐴀𐴌𐴝𐴘𐴃𐴡, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴁𐴞𐴐𐴞𐴤 𐴔𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.<verse eid="GAL 2:10" /></para>
  <para style="s1">𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴉𐴞𐴃𐴡𐴌𐴡𐴌𐴠 𐴈𐴡𐴏𐴟𐴥𐴌 𐴊𐴞𐴥𐴘𐴠</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴑𐴠𐴥𐴉𐴝𐴏𐴢 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴠𐴕𐴄𐴞𐴘𐴡𐴑𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴐𐴞𐴥𐴑𐴧𐴞𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴙𐴅𐴧𐴠, <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴘𐴝𐴑𐴟𐴁𐴡𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴇𐴡𐴦𐴎𐴧𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴒𐴠, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴌𐴝𐴥𐴌, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴏𐴞𐴥𐴌𐴝 𐴀𐴡𐴥𐴘 𐴀𐴝𐴓𐴡𐴑 𐴒𐴡𐴌𐴞𐴥 𐴃𐴝𐴥𐴙𐴑𐴧𐴞𐴓𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝 𐴊𐴡𐴓𐴡𐴌𐴠 𐴋𐴡𐴦𐴌𐴝𐴘𐴧𐴠𐴥. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />𐴁𐴝𐴑𐴞 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴠𐴥 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑𐴞𐴃𐴢 𐴁𐴡𐴥𐴚 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴁𐴝𐴥𐴌𐴕𐴝𐴁𐴝𐴏𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴔𐴟𐴕𐴝𐴉𐴠𐴥𐴑𐴞𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴥𐴓𐴒𐴡𐴘. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴇𐴡𐴥𐴕 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴢 𐴕𐴡 𐴏𐴡𐴓𐴠𐴌 𐴊𐴠 𐴊𐴠𐴙𐴑𐴧𐴞𐴥, 𐴀𐴝𐴀𐴛 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴑𐴠𐴥𐴉𐴝𐴏𐴡𐴌𐴠 𐴈𐴡𐴘𐴧𐴞𐴥 𐴊𐴠, ”𐴃𐴟𐴀𐴛 𐴃𐴡 𐴘𐴡𐴇𐴟𐴥𐴊𐴞, 𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴀𐴛 𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴡𐴤𐴌. 𐴃𐴡𐴥𐴘 𐴃𐴟𐴀𐴛 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴡𐴓𐴝𐴉𐴞𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴝𐴎𐴟𐴌𐴞 𐴒𐴡𐴌𐴡𐴤𐴌؟“<verse eid="GAL 2:14" /></para>
  <para style="s1">𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴘𐴠 𐴀𐴞𐴔𐴝𐴕𐴠 𐴁𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴘𐴧𐴠𐴥</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴠 𐴎𐴡𐴌𐴔𐴡𐴃𐴧𐴟 𐴓𐴡𐴥𐴃𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴞; 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴈𐴡𐴖𐴝𐴤 𐴎𐴝 𐴊𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴠𐴍𐴡𐴃𐴧𐴟 𐴀𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴕𐴡. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞 𐴊𐴠, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤𐴓𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴠, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴕𐴡. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴞 𐴉𐴝𐴌𐴞, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴀𐴝𐴔𐴡𐴥𐴓𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴕𐴡 𐴄𐴡𐴥𐴀𐴌𐴞𐴁𐴡.<verse eid="GAL 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17" />𐴓𐴠𐴑𐴞𐴕 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴞𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴙𐴃𐴧𐴠𐴤-𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴒𐴡𐴘, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴑𐴞𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴒𐴟𐴕𐴝𐴤𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴁𐴝𐴥𐴚𐴒𐴞𐴉𐴠𐴓𐴝𐴘𐴧𐴞 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴡𐴊𐴞 𐴀𐴝𐴁𐴝𐴌 𐴁𐴝𐴕𐴝𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴝𐴙𐴌 𐴊𐴠.<verse eid="GAL 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 2:19" />𐴀𐴝𐴀𐴛 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴧𐴟 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴓𐴧𐴝 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞 𐴉𐴝𐴌𐴞. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴄𐴝𐴑𐴞 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠; 𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌 𐴎𐴞𐴕𐴊𐴝 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠. 𐴀𐴝𐴀𐴛 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴠 𐴅𐴞𐴏𐴞𐴥𐴔 𐴓𐴡𐴥𐴘 𐴎𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴙𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴖𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴑𐴞𐴥 𐴁𐴠 𐴈𐴝𐴍𐴝𐴙𐴌, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴕 𐴊𐴞𐴘𐴠𐴥. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴞 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴃𐴡 𐴇𐴝𐴥𐴕𐴧𐴝𐴑 𐴔𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s1">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴘𐴝𐴥𐴃𐴡 𐴀𐴞𐴔𐴝𐴕</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />𐴀𐴡𐴥 𐴀𐴡𐴁𐴟𐴎𐴢 𐴒𐴝𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴢! 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴠 𐴅𐴝𐴊𐴟 𐴒𐴡𐴙𐴅𐴧𐴠𐴥؟ 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴑𐴠𐴤 𐴊𐴠𐴙𐴑𐴧𐴡𐴥 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴁𐴟𐴎𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴘𐴝𐴀𐴕 𐴎𐴝𐴙𐴕𐴃𐴡 𐴏𐴝𐴀𐴙𐴌: 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴉𐴝𐴘𐴧𐴡𐴥 𐴊𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴠𐴥, 𐴕𐴝𐴥𐴑𐴞 𐴉𐴟𐴥𐴙𐴕𐴧𐴡 𐴊𐴠 𐴇𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴞𐴤؟ <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴁𐴟𐴎𐴢 𐴑𐴞𐴘𐴝𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴘𐴝𐴥𐴕 𐴌𐴟𐴀𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴇𐴡𐴥𐴕 𐴅𐴞𐴏𐴞𐴥𐴔𐴠 𐴉𐴟𐴌𐴟𐴏𐴧𐴝𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴏𐴡𐴀𐴌 𐴊𐴠 𐴕𐴞𐴥𐴑𐴞؟ <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴀𐴠𐴊𐴟𐴥𐴕 𐴊𐴟𐴑 𐴇𐴝𐴥𐴕𐴧𐴝𐴑 𐴉𐴝𐴘𐴧𐴡𐴥 𐴊𐴠؟ 𐴇𐴝𐴥𐴕𐴧𐴝𐴑 𐴕𐴡 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟ <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />𐴃𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴊𐴞𐴦𐴘𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴡𐴤𐴕𐴠 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴕𐴠𐴥, 𐴕𐴝𐴥𐴑𐴞 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴟𐴥𐴕𐴞 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴡𐴤 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠؟ <verse eid="GAL 3:5" /><verse number="6" style="v" sid="GAL 3:6" />𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴥𐴉𐴞𐴏𐴡, ”𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴕𐴝 𐴒𐴞𐴀𐴓𐴢.“<note caller="+" style="f"><char style="fr" closed="false">3‏:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:6">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 15‏:6</ref></char></char></note><verse eid="GAL 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 3:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴞 𐴌𐴝𐴑𐴡𐴥 𐴊𐴠 𐴑𐴞, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴕𐴡𐴏𐴡𐴥𐴓𐴢. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌𐴠 𐴀𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴘𐴝𐴀𐴕 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴥𐴓𐴢, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴃𐴝𐴔𐴝𐴥𐴔 𐴑𐴡𐴗𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">3‏:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 12:3">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 12‏:3</ref>; <ref loc="GEN 18:18">18‏:18</ref>; <ref loc="GEN 22:18">22‏:18</ref></char></char></note> <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴀𐴞𐴔𐴝𐴕 𐴀𐴡𐴓𐴝 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴠 𐴉𐴝𐴘𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴁𐴡.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴥𐴌𐴝𐴐𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴇𐴝𐴥𐴀𐴌 𐴀𐴠𐴑𐴎𐴡𐴕 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴑𐴞𐴃𐴝𐴁𐴡𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴐𐴡𐴌𐴡𐴥𐴃𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠.“<note caller="+" style="f"><char style="fr" closed="false">3‏:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 27:26">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 27‏:26</ref> </char></char></note> <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴏𐴝𐴥𐴉𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴊𐴠 𐴑𐴞, 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴓𐴡𐴥𐴘 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴕𐴡 𐴄𐴡𐴥𐴀𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴔𐴝𐴕𐴠 𐴁𐴠 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">3‏:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAB 2:4">𐴇𐴝𐴥𐴁𐴝𐴑𐴧𐴟𐴑 2‏:4</ref></char></char></note> <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />𐴎𐴠𐴀𐴕 𐴀𐴡𐴥𐴘𐴁𐴡 𐴀𐴡𐴥𐴑, 𐴀𐴞𐴔𐴝𐴕 𐴓𐴡𐴘 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴁𐴝𐴎𐴝𐴥 𐴕𐴝𐴥𐴘 𐴁𐴡𐴥𐴓𐴑𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, ”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴝𐴕𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">3‏:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 18:5">𐴀𐴞𐴔𐴝𐴔𐴞-𐴈𐴝𐴔 18‏:5</ref></char></char></note> <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴠 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴌𐴠 𐴓𐴡𐴦𐴘𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴎𐴝𐴌𐴠𐴥-𐴎𐴝𐴌𐴠𐴥 𐴒𐴝𐴏𐴡𐴌 𐴖𐴡𐴌𐴠 𐴄𐴝𐴑𐴝 𐴎𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴒𐴡𐴎𐴧𐴡𐴁𐴡𐴌 𐴃𐴡𐴓𐴠.“<note caller="+" style="f"><char style="fr" closed="false">3‏:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 21:23">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 21‏:23</ref></char></char></note> <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌𐴠 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴉𐴝𐴦, 𐴃𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴕 𐴖𐴝𐴦𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌𐴠 𐴀𐴞𐴔𐴝𐴕𐴠 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥.<verse eid="GAL 3:14" /></para>
  <para style="s1">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴖𐴝𐴦𐴊𐴝</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴁𐴟𐴎𐴝𐴥𐴘: 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴊𐴟𐴘 𐴎𐴡𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴌𐴝𐴎𐴞 𐴀𐴡𐴥𐴘 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴁𐴝𐴦𐴃𐴠𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴝𐴌𐴝𐴤𐴘 𐴘𐴡𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴌𐴠 𐴇𐴠𐴥 𐴖𐴝𐴦𐴊𐴝 𐴊𐴞𐴀𐴓𐴢. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴑𐴞, ”𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘,“ 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴔𐴝𐴀𐴕𐴞 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢, 𐴁𐴡𐴥𐴓𐴑𐴠 ”𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴓𐴡𐴥𐴘,“<note caller="+" style="f"><char style="fr" closed="false">3‏:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 12:7">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 12‏:7</ref>; <ref loc="GEN 13:15">13‏:15</ref>; <ref loc="GEN 24:7">24‏:7</ref></char></char></note> 𐴔𐴝𐴀𐴕𐴞 𐴀𐴠𐴑𐴎𐴡𐴕 𐴓𐴡𐴘, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />𐴀𐴝𐴀𐴛 𐴈𐴡𐴘𐴃𐴝𐴥𐴔 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝 𐴒𐴡𐴌𐴞𐴥 𐴖𐴝𐴦𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴑𐴞, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴄𐴞𐴑𐴝𐴘 𐴌𐴝𐴑𐴞𐴥𐴁𐴡. 𐴎𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴏𐴝𐴙𐴌 𐴐𐴡𐴥 𐴃𐴞𐴌𐴞𐴥𐴐𐴢 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴇𐴠𐴥 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴌𐴠 𐴁𐴝𐴥𐴚𐴒𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴝𐴦𐴊𐴝𐴌𐴠 𐴁𐴝𐴦𐴃𐴠𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴠 𐴎𐴡𐴊𐴞 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴦 𐴎𐴝, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴖𐴝𐴦𐴊𐴝𐴘𐴠 𐴉𐴝𐴦 𐴎𐴝 𐴊𐴠 𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴖𐴝𐴦𐴊𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴠𐴥𐴕𐴝 𐴊𐴞𐴀𐴓𐴢.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴊𐴞𐴦𐴓𐴡𐴥؟ 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴊𐴞𐴀𐴓𐴢 𐴊𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴀𐴟𐴁𐴝𐴤 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴠 𐴎𐴞𐴁𐴝𐴤𐴌 𐴖𐴝𐴦𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢. 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴇𐴠𐴥 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴞𐴀𐴓𐴢. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />𐴓𐴠𐴑𐴞𐴕 𐴀𐴠𐴑𐴎𐴡𐴕𐴡𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴓𐴠 𐴃𐴡 𐴀𐴟𐴏𐴞𐴥𐴓𐴝 𐴕𐴡 𐴓𐴝𐴒𐴠; 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠𐴑.<verse eid="GAL 3:20" /></para>
  <para style="s1">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />𐴇𐴠𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴑𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴖𐴝𐴦𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴓𐴋𐴝؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡! 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝𐴘𐴃𐴡 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴎𐴞𐴁𐴡𐴕 𐴊𐴞𐴦 𐴉𐴝𐴌𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴞 𐴉𐴝𐴙𐴃𐴧𐴡. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴠 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴑𐴡𐴁𐴎𐴝𐴃𐴢 𐴒𐴡𐴥𐴓𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴖𐴝𐴦𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥 𐴀𐴞𐴔𐴝𐴕𐴠 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="GAL 3:22" /><verse number="23" style="v" sid="GAL 3:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴒𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴁𐴡𐴕 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢. 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴀𐴞𐴔𐴝𐴕 𐴖𐴝𐴀𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴕𐴡𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴄𐴡𐴥𐴀𐴌𐴞. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴊𐴠 𐴇𐴠𐴥 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴡𐴌 𐴃𐴡𐴓𐴠 𐴕𐴡.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴡𐴤𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴓𐴧𐴡𐴥𐴘 𐴀𐴠𐴑 𐴀𐴡𐴥𐴘𐴧𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴔𐴝𐴎𐴠, 𐴒𐴟𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴒𐴟𐴓𐴝𐴔𐴡𐴌 𐴔𐴝𐴎𐴠, 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴔𐴝𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴉𐴡𐴌𐴡𐴥𐴑 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴡𐴤𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡 𐴀𐴠𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴞𐴁𐴌𐴝𐴇𐴞𐴥𐴔𐴡𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴕𐴡𐴏𐴡𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴎𐴞𐴀𐴕𐴡𐴌 𐴖𐴝𐴦𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴔𐴞𐴌𐴝𐴏𐴊𐴝𐴥𐴌.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />𐴀𐴝𐴀𐴛 𐴈𐴡𐴘𐴃𐴝𐴥𐴔 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠, 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴘𐴁𐴡 𐴊𐴠 𐴉𐴟𐴖𐴝 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴕𐴝𐴁𐴝𐴓𐴡𐴑 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴝𐴉𐴡𐴌 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴝𐴓𐴞𐴑 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴀𐴞𐴥𐴃𐴝𐴌 𐴓𐴡𐴥𐴘 𐴒𐴟𐴓𐴝𐴔 𐴓𐴡𐴘 𐴇𐴡𐴕𐴡𐴤 𐴉𐴡𐴌𐴡𐴥𐴑 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴝𐴉𐴠 𐴄𐴞𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴁𐴡𐴐𐴢 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴏𐴡𐴥𐴣𐴓𐴡𐴘𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴡𐴌 𐴃𐴡𐴓𐴠 𐴃𐴝𐴥𐴑𐴝 𐴉𐴡𐴌𐴠. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴃𐴢 𐴕𐴝𐴁𐴝𐴓𐴡𐴑 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴁𐴟𐴥𐴃𐴢-𐴉𐴠𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴟𐴓𐴝𐴔𐴞𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴡𐴑𐴃𐴡𐴥 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴀𐴙𐴓𐴢 𐴀𐴝𐴦𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴀𐴙𐴓𐴢, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴒𐴡𐴘. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴌𐴟𐴀 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴓𐴧𐴝 𐴌𐴠, ”𐴀𐴝𐴁𐴧𐴝“<note caller="+" style="f"><char style="fr" closed="false">4‏:6 </char><char style="ft" closed="false">𐴀𐴝𐴌𐴝𐴤𐴔𐴞𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴁𐴝𐴉𐴡𐴌𐴠 𐴈𐴡𐴀 𐴊𐴠 </char><char style="fqa" closed="false">𐴀𐴝𐴁𐴧𐴝</char></note> 𐴘𐴝𐴥𐴕𐴞 ”𐴁𐴝𐴉𐴢“ 𐴇𐴡𐴘 𐴋𐴝𐴈𐴝𐴁𐴝. <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴟𐴀𐴝𐴙𐴕. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴉𐴟𐴀𐴝𐴙𐴕, 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴎𐴞𐴀𐴕 𐴊𐴞𐴦𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴞𐴦𐴁𐴡.<verse eid="GAL 4:7" /></para>
  <para style="s1">𐴒𐴝𐴓𐴝𐴃𐴞𐴀𐴡𐴥𐴓𐴡𐴓𐴧𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴞</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥𐴃𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴀𐴙𐴕𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴑𐴟𐴥𐴊𐴝 𐴕𐴡. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴏𐴞𐴕𐴡𐴥, 𐴘𐴝𐴥𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴞𐴕𐴠𐴥. 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴇𐴠𐴥 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴇𐴝𐴎𐴡𐴌 𐴁𐴟𐴥𐴃𐴢-𐴉𐴠𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴟 𐴉𐴞𐴥𐴌𐴞 𐴎𐴝𐴘𐴃𐴡 𐴏𐴡𐴀𐴌؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴥𐴕𐴡 𐴀𐴝𐴁𐴝𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴟𐴓𐴝𐴔𐴞𐴃𐴢 𐴀𐴡𐴥𐴘𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴕𐴠𐴥؟ <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴈𐴝𐴥𐴀𐴏𐴢-𐴈𐴝𐴥𐴀𐴏𐴢 𐴊𐴞𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴔𐴝𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴔𐴡𐴀𐴏𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴏𐴡𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴓𐴡𐴕 𐴒𐴡𐴌𐴡𐴤. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />𐴀𐴝𐴀𐴛 𐴋𐴡𐴦𐴌𐴝𐴙𐴌 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴎𐴠 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴇𐴡𐴥𐴕𐴡 𐴐𐴝𐴥𐴌 𐴕𐴡 𐴀𐴡𐴥𐴘𐴁𐴡 𐴕𐴠.<verse eid="GAL 4:11" /></para>
  <para style="p">
