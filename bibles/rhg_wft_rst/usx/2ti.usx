<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">2 𐴃𐴞𐴔𐴡𐴥𐴃𐴞</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 2 𐴃𐴞𐴔𐴡𐴥𐴃𐴞</para>
  <para style="toc2">2 𐴃𐴞𐴔𐴡𐴥𐴃𐴞</para>
  <para style="toc3">2𐴃𐴞𐴔</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">2 𐴃𐴞𐴔𐴡𐴥𐴃𐴞</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 2 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢. 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴐𐴝𐴥𐴌𐴞𐴃𐴢 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴘𐴧𐴝𐴃𐴢 𐴉𐴟𐴥𐴌𐴝𐴘 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 <char style="ior">(<ref loc="2TI 1:16">1‏:16</ref>)</char>. 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴃𐴧𐴟 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴓𐴧𐴡𐴥𐴘 𐴁𐴝𐴥𐴓𐴝 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴝𐴌 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝 𐴁𐴡𐴓𐴞 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤 (<char style="xt"><ref loc="PHP 2:22">𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴝𐴘𐴀𐴡𐴥𐴓𐴢 2‏:22</ref>; <ref loc="1TI 1:2">1 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 1‏:2</ref>; <ref loc="1TI 1:18">1‏:18</ref></char>).</para>
  <para style="ip">𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴎𐴠 𐴏𐴝𐴙𐴌 𐴒𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴕𐴡 𐴀𐴡𐴥𐴘 𐴎𐴡𐴕-𐴎𐴡𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢, 𐴈𐴠𐴥𐴕𐴃𐴟 𐴀𐴠𐴑𐴧𐴝𐴥𐴕. 𐴎𐴡𐴕-𐴎𐴡𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴃𐴞𐴕 𐴕𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 1 𐴃𐴞𐴔𐴡𐴥𐴃𐴞, 𐴃𐴞𐴃𐴟𐴏𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴓𐴞𐴔𐴡𐴕. 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝 𐴓𐴠𐴑𐴠𐴥𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴎𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴌𐴡𐴔𐴞 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴟𐴓𐴟𐴥𐴔 𐴉𐴝𐴦𐴌. 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌𐴠 𐴘𐴡𐴥 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴊𐴞𐴥𐴘𐴝 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴈𐴠𐴥𐴕𐴃𐴟 𐴃𐴝𐴥𐴘 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠. 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴃𐴢 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴌𐴠, 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴀𐴓𐴢 (<char style="xt"><ref loc="1TI 1:16-18">1 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 1‏:16‏-18</ref></char>). 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥 𐴈𐴡𐴀𐴙𐴓𐴢 𐴊𐴠 𐴑𐴞, 𐴔𐴟𐴀𐴕𐴃𐴟 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴏𐴠𐴤 <char style="ior">(<ref loc="2TI 3:1">3‏:1</ref>)</char>.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴟𐴀𐴝𐴙𐴅𐴧𐴡 <char style="ior">(<ref loc="2TI 1:1-2">1‏:1‏-2</ref>; <ref loc="2TI 1:3-18">1‏:3‏-18</ref>) </char></para>
  <para style="io1">2. 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴃𐴡 𐴈𐴡𐴖𐴝𐴤 <char style="ior">(<ref loc="2TI 2:1-13">2‏:1‏-13</ref>) </char></para>
  <para style="io1">3. 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 <char style="ior">(<ref loc="2TI 2:14-26">2‏:14‏-26</ref>) </char></para>
  <para style="io1">4. 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴑𐴞𐴦 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 <char style="ior">(<ref loc="2TI 3:1-4:8">3‏:1‏—4‏:8</ref>) </char></para>
  <para style="io1">5. 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 <char style="ior">(<ref loc="2TI 4:9-22">4‏:9‏-22</ref>)</char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴌 𐴖𐴝𐴦𐴊𐴝 𐴔𐴡𐴎𐴞𐴕 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴏𐴝𐴥𐴇𐴝𐴁𐴞.<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴖𐴝 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌.</para>
  <para style="b" vid="2TI 1:2" />
  <para style="p" vid="2TI 1:2">𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢, 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="2TI 1:2" /></para>
  <para style="s1">𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴀𐴝𐴙𐴅𐴧𐴡</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />𐴎𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴊𐴝𐴊𐴝-𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴏𐴝𐴥𐴉𐴢 𐴊𐴞𐴓𐴡𐴃𐴧𐴟 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴖𐴝𐴃𐴢 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴞𐴥 𐴇𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴒𐴡𐴌𐴞𐴥. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />𐴃𐴡𐴌 𐴈𐴝𐴣𐴊𐴝𐴕𐴞 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴟𐴍𐴞𐴤 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴡𐴌𐴠𐴥 𐴏𐴝𐴘𐴃𐴡𐴥 𐴑𐴟𐴥𐴁𐴢 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴑𐴟𐴥𐴐𐴞𐴘𐴠 𐴁𐴡𐴥𐴌𐴞 𐴎𐴝𐴘𐴒𐴡𐴘. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />𐴃𐴡𐴌 𐴇𐴝𐴥𐴄𐴞 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴡𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴝𐴒𐴠 𐴃𐴡𐴌 𐴕𐴝𐴕𐴞 𐴓𐴡𐴖𐴞𐴏𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴌 𐴔𐴝𐴦 𐴘𐴟𐴕𐴞𐴑𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴠𐴑𐴞𐴕 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴔𐴝𐴕 𐴃𐴡𐴌𐴃𐴧𐴟 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤.<verse eid="2TI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴘𐴝𐴦𐴊𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴞𐴌, 𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴥𐴃𐴢 𐴊𐴞𐴥𐴘𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴃𐴟𐴘 𐴎𐴠 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴡𐴥𐴏𐴢, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴎𐴡𐴓𐴝𐴘 𐴃𐴟𐴓𐴢. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴋𐴡𐴦𐴌𐴡𐴌 𐴌𐴟𐴀 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴝𐴦𐴑𐴡𐴃𐴢, 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴣𐴓𐴞𐴁𐴝𐴌 𐴌𐴟𐴀 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥𐴃𐴠 𐴕𐴡 𐴐𐴡𐴥𐴌𐴔𐴝𐴙𐴐𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴁𐴡𐴕 𐴀𐴝𐴏𐴞𐴤, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴓𐴡𐴥𐴘 𐴘𐴡𐴥 𐴕𐴡 𐴐𐴡𐴥𐴌𐴔𐴝𐴙𐴐𐴢, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴞𐴦𐴘𐴝 𐴃𐴝𐴦𐴑𐴡𐴃𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴊𐴟𐴑 𐴉𐴝𐴦. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴊𐴞𐴘𐴠𐴥 𐴀𐴝𐴦𐴌 𐴂𐴝𐴑 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴋𐴝𐴙𐴑𐴧𐴠𐴥; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴈𐴝𐴔𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴠𐴌𐴝𐴊𐴝 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕، 𐴎𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴞𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴀𐴡𐴥𐴘𐴧𐴠, <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />𐴀𐴝𐴦𐴌 𐴘𐴝𐴓𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴕𐴠𐴅𐴝𐴃𐴊𐴡𐴘𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴘𐴧𐴡𐴤𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴧𐴠. 𐴇𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴔𐴡𐴦𐴃𐴡𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴡𐴔𐴡𐴌𐴡𐴕𐴞𐴌𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠, <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" />𐴎𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴡𐴁𐴡𐴓𐴞𐴑-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴠𐴊𐴧𐴠 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠. <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴀𐴛 𐴀𐴠 𐴊𐴟𐴑 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴝𐴙𐴌; 𐴃𐴡𐴀 𐴀𐴝𐴀𐴛 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴕𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕𐴞 𐴀𐴝𐴀𐴛 𐴇𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴞𐴤 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴠𐴑𐴞𐴕 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴞 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴝𐴦𐴉𐴠𐴏𐴞𐴌 𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />𐴃𐴟𐴘 𐴀𐴝𐴣𐴀𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴎𐴞𐴀𐴕𐴡𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴉𐴝𐴘𐴧𐴡𐴥𐴏𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴊𐴡𐴥𐴌𐴞 𐴌𐴝𐴑, 𐴀𐴝𐴦𐴌 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />𐴎𐴠 𐴀𐴝𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴡𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴌𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴁𐴡𐴓𐴠 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />𐴃𐴟𐴘 𐴃𐴡 𐴎𐴝𐴕𐴡𐴏𐴢, 𐴀𐴠𐴐𐴞𐴥𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴟𐴒𐴞𐴓𐴝𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴌𐴔𐴟𐴒𐴞𐴕𐴝𐴏𐴢 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤.<verse eid="2TI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16" />𐴀𐴟𐴕𐴞𐴏𐴞𐴥𐴉𐴝𐴌𐴝𐴏𐴡𐴌 𐴒𐴡𐴥𐴌 𐴄𐴞𐴥𐴘𐴝𐴌𐴠 𐴔𐴝𐴓𐴞𐴑𐴠 𐴌𐴝𐴇𐴝𐴥𐴔 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴔𐴡𐴕𐴡𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴁𐴝𐴌 𐴉𐴡𐴄𐴉𐴡𐴙𐴄𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴁𐴡𐴕 𐴀𐴝𐴏𐴞𐴤 𐴁𐴡𐴓𐴞 𐴀𐴞𐴥𐴁𐴝 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴕𐴡𐴥, <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴃𐴟𐴖𐴝𐴘 𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴥𐴘 𐴊𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />𐴔𐴝𐴓𐴞𐴑𐴠 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴠𐴕 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴖𐴝𐴦𐴉𐴠𐴏𐴞𐴌 𐴊𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔 𐴉𐴝𐴦. 𐴃𐴟𐴘 𐴃𐴡 𐴁𐴝𐴥𐴓𐴝𐴒𐴡𐴌𐴞 𐴎𐴝𐴕𐴡𐴏𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴇𐴡𐴃𐴡𐴥 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴝𐴥𐴓𐴝 𐴉𐴡𐴥𐴗𐴏𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴖𐴝, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />𐴀𐴝𐴦𐴌 𐴁𐴞𐴐𐴞𐴤 𐴒𐴡𐴁𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴔𐴟𐴑𐴡𐴃𐴧𐴟 𐴎𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴃𐴟𐴘 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴞, 𐴇𐴠𐴥 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌𐴠 𐴀𐴠𐴀𐴕 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴊𐴠𐴦 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴁𐴝𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴞𐴘𐴡𐴃𐴞 𐴀𐴝𐴏𐴠𐴤. <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴠𐴑 𐴁𐴝𐴥𐴓𐴝 𐴉𐴡𐴥𐴗𐴏𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴊𐴟𐴑 𐴉𐴝𐴦. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />𐴇𐴡𐴕𐴡𐴤 𐴉𐴡𐴥𐴗𐴏𐴠 𐴃𐴡 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴎𐴝𐴘𐴓𐴠𐴥 𐴀𐴝𐴖𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴝𐴦𐴔𐴠𐴓𐴝𐴃𐴢 𐴁𐴝𐴎𐴞𐴥 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴎𐴡𐴕𐴧𐴝𐴓𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴑𐴠𐴥𐴓𐴝𐴃𐴢 𐴓𐴝𐴔𐴞 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴠𐴥𐴓𐴝𐴌 𐴕𐴞𐴘𐴡𐴔 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡 𐴑𐴠𐴥𐴓𐴝, 𐴀𐴞𐴥𐴃𐴠 𐴎𐴞𐴃𐴝𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴕𐴡 𐴉𐴝𐴦. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />𐴎𐴠 𐴐𐴝𐴐𐴝𐴤𐴘𐴠 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴕𐴞𐴘𐴡𐴔 𐴔𐴡𐴎𐴞𐴕 𐴉𐴡𐴥𐴏𐴡𐴓𐴡𐴌 𐴁𐴝𐴥𐴑 𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴒𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴥𐴕𐴝 𐴉𐴝𐴦. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />𐴀𐴝𐴀𐴛 𐴎𐴞𐴀𐴕 𐴈𐴡𐴀𐴙𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴥𐴉𐴞 𐴏𐴝𐴀, 𐴔𐴝𐴓𐴞𐴑𐴠 𐴃𐴡𐴌𐴠𐴥 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴟𐴎𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴞𐴦𐴁𐴡.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />𐴊𐴝𐴖𐴟𐴊𐴡𐴌 𐴕𐴡𐴏𐴡𐴥𐴓𐴡𐴌 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴘𐴝𐴦𐴊𐴢 𐴌𐴝𐴑𐴞𐴥𐴐𐴢. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴀𐴛 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌, <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴀𐴝𐴐𐴝𐴥𐴔𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴟𐴑 𐴉𐴝𐴙𐴌, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴀𐴛 𐴁𐴡𐴕 𐴀𐴝𐴏𐴞𐴤; 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴃𐴡 𐴁𐴡𐴕 𐴕𐴡. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴝 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴝𐴀𐴛 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴡𐴉𐴟𐴥𐴌𐴝𐴕𐴞 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴦.<verse eid="2TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11" />𐴘𐴝𐴀𐴕 𐴇𐴡𐴥𐴑 𐴈𐴡𐴃𐴝𐴤 𐴊𐴠 𐴑𐴞,</para>
  <para style="q1" vid="2TI 2:11">”𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴙𐴅𐴧𐴞𐴥,</para>
  <para style="q2" vid="2TI 2:11">𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔 𐴀𐴡𐴥.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴟𐴑 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥,</para>
  <para style="q2" vid="2TI 2:12">𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴟𐴔 𐴀𐴡𐴥.</para>
  <para style="q1" vid="2TI 2:12">𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥,</para>
  <para style="q2" vid="2TI 2:12">𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡.<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴘𐴔𐴝𐴕 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴓𐴠 𐴘𐴡,</para>
  <para style="q2" vid="2TI 2:13">𐴀𐴞𐴥𐴁𐴝 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴁𐴠𐴘𐴔𐴝𐴕 𐴀𐴡𐴥 𐴊𐴠 𐴕𐴝𐴥𐴘,</para>
  <para style="q2" vid="2TI 2:13">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴔𐴞𐴏𐴝𐴥 𐴄𐴡𐴥𐴀𐴌𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠.“<verse eid="2TI 2:13" /></para>
  <para style="s1">𐴁𐴠𐴇𐴝𐴎𐴡𐴌 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴃𐴟𐴘 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴔𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴘𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴞 𐴊𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴎𐴠𐴕 𐴓𐴡𐴉𐴎𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴃𐴡𐴌𐴑𐴝𐴃𐴡𐴌𐴑𐴞 𐴕𐴡 𐴊𐴠. 𐴇𐴞𐴥𐴀𐴕𐴠 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤 𐴉𐴝𐴥𐴘𐴊𐴝𐴘 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴉𐴟𐴥𐴕𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />𐴃𐴟𐴘 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴝𐴥𐴎𐴞𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴥𐴌 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴕𐴝𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴡𐴌𐴞𐴑𐴝 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴠. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />𐴓𐴠𐴑𐴞𐴕 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴁𐴠𐴇𐴝𐴎𐴡𐴌 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴑𐴞𐴐𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴎𐴠𐴃𐴡𐴥 𐴀𐴠𐴥𐴃𐴡 𐴁𐴠𐴊𐴞𐴕𐴞 𐴁𐴝𐴕𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴡, <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴎𐴞𐴀𐴕 𐴑𐴠𐴕𐴏𐴝𐴌𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴉𐴡𐴥𐴓𐴞𐴎𐴝𐴘𐴁𐴡𐴘. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔-𐴊𐴡𐴘𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴟𐴔𐴞𐴕𐴝𐴘𐴟𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴓𐴠𐴃𐴟𐴏𐴢 𐴀𐴡𐴥 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴌𐴝𐴏𐴃𐴝 𐴀𐴠𐴌𐴞𐴊𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴡𐴀 𐴊𐴠, 𐴇𐴝𐴥𐴣𐴐𐴡𐴌 𐴁𐴞𐴃𐴞𐴒𐴞𐴘𐴡𐴥𐴘; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌 𐴀𐴞𐴔𐴝𐴕 𐴕𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴌. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴟𐴖𐴝𐴥𐴘𐴧𐴝 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞 𐴃𐴡 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴔𐴡𐴀𐴌 𐴔𐴝𐴙𐴅𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴑𐴞, ”𐴔𐴝𐴓𐴞𐴑𐴠 𐴎𐴝𐴕𐴠 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴁𐴝𐴌,“ 𐴀𐴝𐴦𐴌, ”𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴕𐴝𐴔 𐴓𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴈𐴝𐴔𐴡𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.“<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />𐴁𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴡 𐴁𐴝𐴕𐴝𐴤 𐴐𐴟𐴥𐴕𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴏𐴝𐴣𐴊𐴞𐴌 𐴏𐴡𐴥𐴕𐴇𐴡𐴊𐴧𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴒𐴝𐴏𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴠𐴍𐴞𐴌 𐴀𐴡𐴥 𐴃𐴝𐴥𐴑𐴠; 𐴇𐴡𐴊𐴟𐴥𐴕 𐴈𐴝𐴥𐴀𐴏𐴢 𐴈𐴝𐴔 𐴀𐴡𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴀𐴠𐴣𐴀𐴃𐴠 𐴈𐴝𐴔 𐴀𐴡𐴓𐴧𐴝. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴠 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔 𐴀𐴞𐴀𐴕𐴡𐴃𐴧𐴟 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴈𐴝𐴥𐴀𐴏𐴢 𐴈𐴝𐴔𐴡𐴌 𐴏𐴡𐴥𐴕𐴇𐴡𐴊𐴧𐴝𐴤 𐴀𐴡𐴥𐴘𐴁𐴡. 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴂𐴝𐴑 𐴌𐴝𐴑𐴝𐴤 𐴎𐴝𐴘𐴁𐴡. 𐴀𐴞𐴥𐴃𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴈𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴡𐴥𐴘𐴁𐴡.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />𐴅𐴟𐴖𐴝𐴕 𐴇𐴝𐴓𐴡𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴡𐴕𐴡𐴃𐴧𐴟 𐴊𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴂𐴝𐴑 𐴊𐴞𐴓𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴔𐴝𐴃𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌, 𐴀𐴞𐴔𐴝𐴕 𐴀𐴡𐴌, 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴡𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴉𐴞𐴏𐴠𐴤 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />𐴓𐴠𐴑𐴞𐴕 𐴁𐴠𐴇𐴝𐴎𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴑𐴟𐴙𐴂𐴧𐴝 𐴃𐴡𐴌𐴑𐴝𐴃𐴡𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴝𐴊𐴢 𐴊𐴞𐴐𐴢; 𐴃𐴟𐴘 𐴃𐴡 𐴎𐴝𐴕𐴡𐴏𐴢, 𐴇𐴞𐴥𐴀𐴕𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢 𐴁𐴠 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴠𐴥. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴒𐴟𐴓𐴝𐴔𐴡𐴃𐴧𐴟 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴡 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴠𐴀𐴌𐴁𐴝𐴕 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴁𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴌𐴊𐴝𐴐𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />𐴀𐴝𐴦𐴌 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴐𐴞𐴥𐴊𐴝 𐴒𐴡𐴥𐴌𐴞 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴡𐴖𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴞𐴦𐴁𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴠, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />𐴀𐴝𐴦𐴌 𐴁𐴟𐴎𐴡𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴀𐴘𐴢 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴡𐴌 𐴉𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴞𐴎𐴝𐴒𐴡𐴥𐴘, 𐴎𐴠 𐴀𐴞𐴁𐴞𐴓𐴞𐴥𐴐𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴔𐴡𐴕 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴞 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴕𐴊𐴞 𐴁𐴝𐴕𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴠𐴥.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴎𐴡𐴁𐴝𐴕𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴑 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴎𐴡𐴁𐴝𐴕𐴝𐴃𐴢 𐴋𐴡𐴣𐴀𐴌 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴡𐴌 𐴊𐴞𐴕 𐴀𐴝𐴘𐴁𐴡𐴤. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴄𐴞𐴛𐴝-𐴉𐴡𐴘𐴐𐴝𐴤𐴌 𐴓𐴝𐴓𐴡𐴥𐴏𐴁𐴡𐴕 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴁𐴡𐴌𐴝𐴥𐴘 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴉𐴡𐴇𐴡𐴥𐴌 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴁𐴡𐴊𐴕𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴁𐴝𐴉𐴔𐴝𐴦𐴌 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴕𐴝𐴐𐴟𐴥𐴑𐴟𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴕𐴝𐴉𐴝𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴊𐴡𐴌-𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴁𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴌𐴝𐴇𐴝𐴥𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴒𐴞𐴉𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴣𐴓𐴞 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥, 𐴎𐴝𐴦𐴓𐴠𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴁𐴝𐴥𐴓𐴝𐴘𐴌𐴠 𐴕𐴝𐴉𐴡𐴥𐴌𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />𐴁𐴠𐴘𐴔𐴝𐴕 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴏𐴠𐴕𐴉𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴑𐴝𐴁𐴧𐴡𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴘𐴝𐴐𐴞 𐴒𐴡𐴌𐴝𐴥𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡; <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴝𐴘𐴃𐴠𐴥 𐴊𐴞𐴕𐴊𐴝𐴥𐴌 𐴓𐴝𐴒𐴞𐴁𐴡𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴝𐴥𐴑𐴞𐴒𐴡𐴃𐴡𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞𐴌 𐴀𐴝𐴏𐴡𐴥𐴌𐴡𐴌𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴃𐴝𐴥𐴑𐴞𐴐𐴢.<verse eid="2TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴒𐴡𐴥𐴌𐴠-𐴒𐴡𐴥𐴌𐴠 𐴎𐴝𐴘 𐴁𐴠𐴑𐴟𐴉𐴢 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝, 𐴎𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌 𐴖𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴌 𐴉𐴟𐴣𐴎𐴝𐴤 𐴀𐴝𐴏𐴠𐴤. 𐴇𐴠𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴔𐴡𐴕𐴠 𐴏𐴡𐴓𐴝; <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴉𐴟𐴥𐴕𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞𐴌𐴠 𐴎𐴝𐴕𐴞 𐴉𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴊𐴧𐴟𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴉𐴡𐴀𐴣𐴏𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴅𐴝𐴕𐴧𐴞𐴏𐴠 𐴀𐴠𐴊𐴧𐴠 𐴅𐴝𐴔𐴁𐴌𐴞𐴏𐴠 𐴔𐴟𐴀𐴏𐴝𐴌 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴞𐴥𐴀𐴕𐴠 𐴘𐴡𐴥 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴠𐴔𐴝𐴑 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴁𐴠𐴇𐴝𐴌 𐴊𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴌 𐴕𐴡 𐴁𐴝𐴌𐴞𐴥𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴠𐴑𐴟𐴉𐴝𐴘 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴅𐴝𐴕𐴧𐴞𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴅𐴝𐴔𐴁𐴌𐴞𐴏𐴡𐴌 𐴀𐴡𐴥 𐴀𐴡𐴥𐴀𐴙𐴓𐴢.<verse eid="2TI 3:9" /></para>
  <para style="s1">𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴎𐴞𐴔𐴧𐴝</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />𐴓𐴠𐴑𐴞𐴕 𐴃𐴟𐴘 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴃𐴝𐴦𐴓𐴞𐴔, 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢, 𐴀𐴠𐴌𐴝𐴊𐴝, 𐴀𐴞𐴔𐴝𐴕, 𐴏𐴡𐴁𐴡𐴥𐴌, 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴡𐴏𐴢, <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />𐴃𐴟𐴘 𐴀𐴝𐴌𐴡𐴤 𐴎𐴝𐴕𐴡𐴏𐴢 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴇𐴡𐴊𐴟𐴥𐴕 𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴘𐴧𐴞𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴠𐴕𐴄𐴞𐴘𐴡𐴑, 𐴀𐴞𐴑𐴡𐴥𐴕𐴞𐴘𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴓𐴟𐴏𐴞𐴥𐴃𐴝𐴌𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴑𐴞𐴦-𐴑𐴞𐴦 𐴒𐴟𐴎𐴡𐴙𐴅𐴧𐴠𐴥; 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴛 𐴇𐴡𐴃𐴡𐴥 𐴎𐴟𐴓𐴟𐴥𐴔 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥! 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴁𐴝𐴏𐴝𐴘𐴧𐴠𐴥. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴊𐴞𐴕𐴊𐴝𐴥𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘𐴃𐴡𐴥 𐴏𐴝𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴟𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴢 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴕𐴁𐴡𐴊𐴞𐴕 𐴀𐴝𐴌𐴡𐴤 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴘𐴡𐴥 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴁𐴡𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴒𐴡𐴓𐴧𐴡𐴃𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴁𐴡𐴥𐴘. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴘 𐴀𐴟𐴀𐴙𐴕𐴡𐴃𐴢 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑, 𐴎𐴞𐴀𐴕 𐴐𐴞𐴥𐴑𐴧𐴡𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴙𐴅𐴧𐴡𐴥𐴏𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴘 𐴃𐴡 𐴎𐴝𐴕𐴡𐴏𐴢 𐴇𐴞𐴥𐴀𐴕 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴐𐴞𐴥𐴑𐴧𐴡𐴏𐴢, <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />𐴀𐴝𐴦𐴌 𐴒𐴟𐴌𐴝𐴇𐴝𐴓𐴠 𐴓𐴡𐴥𐴃𐴞 𐴃𐴟𐴘 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴎𐴝𐴙𐴕𐴃𐴞, 𐴎𐴞𐴀𐴕 𐴀𐴡𐴥𐴃𐴧𐴟 𐴃𐴡𐴌𐴠𐴥 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴞𐴘𐴝𐴕 𐴊𐴞𐴦𐴁𐴝𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠 𐴒𐴞𐴘𐴝𐴕𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴝𐴤𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴕𐴠𐴅𐴝𐴃𐴢 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴌𐴝𐴏𐴃𐴝 𐴊𐴝𐴈𐴝𐴤𐴘𐴊𐴠. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴁𐴠 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝, 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴊𐴝𐴈𐴝𐴤𐴘𐴊𐴞 𐴁𐴡𐴓𐴧𐴝, 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴃𐴡𐴌𐴁𐴞𐴘𐴡𐴃𐴢 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴈𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴘𐴧𐴠𐴤, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴁𐴡𐴕𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴓𐴧𐴝 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴎𐴞𐴁𐴝𐴤 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴎𐴞𐴕𐴊𐴝 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴐𐴝𐴥𐴙𐴑𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡𐴌𐴠𐴥 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴕𐴞𐴐𐴡𐴥𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌; 𐴄𐴝𐴘𐴔𐴠 𐴁𐴠𐴄𐴝𐴘𐴔𐴠 𐴃𐴡𐴘𐴧𐴝𐴌 𐴃𐴝𐴥𐴑; 𐴑𐴟𐴥𐴁𐴢 𐴏𐴡𐴁𐴡𐴥𐴌𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴁𐴟𐴎𐴢 𐴊𐴠, 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴥𐴌. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠𐴀𐴕 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴝𐴦𐴓𐴞𐴔 𐴕𐴡 𐴉𐴟𐴥𐴕𐴞𐴁𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴕𐴡𐴌 𐴀𐴝𐴎𐴧𐴟 𐴔𐴡𐴎𐴞𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴡𐴓𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴉𐴟𐴥𐴕𐴞𐴃𐴡 𐴈𐴝𐴕 𐴀𐴟𐴣𐴃𐴝𐴌 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴝𐴘𐴁𐴡. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴈𐴝𐴕 𐴉𐴞𐴥𐴌𐴝𐴘𐴉𐴠𐴓𐴝𐴘 𐴁𐴝𐴕𐴝𐴖𐴡𐴃𐴞 𐴑𐴞𐴏𐴧𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴟 𐴈𐴝𐴕 𐴊𐴞𐴁𐴡. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴘 𐴇𐴝𐴥𐴀𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴣𐴓𐴞 𐴌𐴝𐴑, 𐴊𐴟𐴑 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌, 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡𐴌𐴠𐴥 𐴎𐴠 𐴎𐴞𐴔𐴧𐴝 𐴊𐴞𐴦𐴘𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴇𐴡𐴥𐴕 𐴌𐴡𐴐𐴢 𐴑𐴟𐴌𐴁𐴝𐴕𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴋𐴝𐴥𐴓𐴞𐴊𐴞𐴘𐴝 𐴎𐴝𐴌. 𐴀𐴝𐴀𐴛 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴧𐴟 𐴎𐴝𐴘𐴁𐴝𐴌 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴀𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />𐴀𐴝𐴀𐴛 𐴁𐴝𐴥𐴓𐴝 𐴓𐴝𐴌𐴝𐴥𐴙𐴃𐴢 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴎𐴞𐴁𐴧𐴝𐴃𐴡𐴌𐴠 𐴇𐴡𐴥𐴃𐴡𐴔 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌𐴠 𐴄𐴞𐴑𐴝𐴘 𐴌𐴝𐴙𐴑𐴧𐴞𐴥. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞𐴌 𐴃𐴝𐴏𐴢 𐴎𐴡𐴔𐴝 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴖𐴝𐴓𐴝 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴝𐴦𐴉𐴠𐴏𐴞𐴌 𐴊𐴞𐴕𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴁𐴡; 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴊𐴞𐴦𐴁𐴡 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴀𐴌 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.<verse eid="2TI 4:8" /></para>
  <para style="s1">𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴡𐴌𐴝𐴃𐴡𐴌𐴞 𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴥𐴌. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴠𐴥𐴔𐴝𐴏𐴠 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴀𐴠𐴌𐴞𐴊𐴞𐴘𐴠𐴥. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴃𐴞𐴏𐴡𐴥𐴓𐴡𐴕𐴞𐴑𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. 𐴑𐴌𐴠𐴏𐴑𐴠𐴕 𐴃𐴡 𐴒𐴝𐴓𐴝𐴃𐴞𐴥𐴘𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴃𐴞𐴃𐴟𐴏𐴢 𐴊𐴝𐴓𐴔𐴝𐴃𐴞𐴘𐴝𐴃𐴢 𐴒𐴞𐴦𐴘𐴠𐴥𐴒𐴡𐴘. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴓𐴟𐴑𐴝𐴥𐴏𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴔𐴝𐴌𐴑𐴟𐴏𐴡𐴌𐴠 𐴃𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴓𐴡𐴘𐴀𐴝𐴕𐴞𐴤𐴐𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴔𐴡𐴃𐴢 𐴓𐴝𐴒𐴠𐴌. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴑𐴞𐴑𐴟𐴏𐴡𐴌𐴠 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴡𐴃𐴢 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴊𐴞𐴘𐴞. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />𐴃𐴡𐴌𐴝𐴏𐴡𐴃𐴢 𐴑𐴝𐴌𐴂𐴟𐴏𐴡𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴀𐴛 𐴎𐴠 𐴐𐴝𐴥𐴓𐴢 𐴓𐴝𐴕 𐴀𐴠𐴌𐴞 𐴀𐴝𐴙𐴐𐴧𐴞𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴘 𐴀𐴝𐴘𐴃𐴠𐴤 𐴓𐴡𐴘𐴀𐴝𐴕𐴞𐴤𐴐𐴢, 𐴀𐴝𐴦𐴌 𐴑𐴞𐴃𐴝𐴁𐴢 𐴂𐴟𐴥𐴕 𐴀𐴡𐴥 𐴓𐴡𐴘𐴀𐴝𐴕𐴞𐴤𐴐𐴢, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴏𐴝𐴔𐴝𐴌𐴝 𐴀𐴡𐴓𐴝 𐴒𐴟𐴥𐴕.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />𐴃𐴝𐴔𐴝𐴌 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴝𐴓𐴠𐴑𐴏𐴎𐴠𐴕𐴊𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴓𐴟𐴏𐴧𐴝𐴥𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴈𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴁𐴡𐴊𐴡𐴓𐴝 𐴊𐴞𐴦𐴁𐴡. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />𐴃𐴟𐴘 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴝𐴥𐴑𐴞𐴐𐴢, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑𐴡𐴌 𐴁𐴞𐴐𐴞𐴤 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="2TI 4:15" /><verse number="16" style="v" sid="2TI 4:16" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴡𐴀𐴘𐴓𐴝𐴁𐴝𐴌 𐴀𐴝𐴣𐴀𐴌 𐴏𐴡𐴥𐴉𐴝𐴘 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴞𐴏𐴝𐴌𐴡𐴃𐴢 𐴃𐴟𐴓𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴢 𐴕𐴡𐴥 𐴊𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴉𐴠𐴥𐴓𐴝𐴘 𐴒𐴞𐴀𐴓𐴒𐴡𐴘. 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥 𐴈𐴝𐴔𐴡𐴌 𐴀𐴞𐴥𐴏𐴝𐴉𐴑𐴞𐴃𐴝𐴁𐴢 𐴕𐴡 𐴌𐴝𐴑𐴡𐴥𐴗𐴑. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴊𐴞𐴀𐴓𐴢, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴀𐴝𐴦𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴠𐴕 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴕𐴠. 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴐𐴞𐴥𐴚𐴒𐴡𐴌 𐴔𐴟𐴑𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘𐴧𐴠𐴥 𐴊𐴠. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴝𐴥𐴀𐴌 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴓𐴝𐴔𐴡𐴃𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴓𐴡𐴘𐴎𐴝𐴘𐴁𐴡𐴥𐴘. 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴝𐴁𐴝𐴊𐴟𐴓𐴀𐴝𐴁𐴝𐴊𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="2TI 4:18" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />𐴂𐴌𐴞𐴏𐴞𐴥𐴓𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑𐴟𐴥𐴘𐴓𐴝 𐴌𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴟𐴕𐴞𐴏𐴞𐴥𐴉𐴝𐴌𐴝𐴏𐴡𐴌 𐴒𐴡𐴥𐴌 𐴄𐴞𐴥𐴘𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴞 𐴁𐴡𐴥𐴓𐴞 𐴈𐴡𐴀𐴙𐴐𐴢. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />𐴀𐴠𐴌𐴝𐴏𐴃𐴟𐴏𐴢 𐴑𐴡𐴥𐴌𐴞𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴘𐴒𐴞𐴘𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴃𐴡𐴌𐴡𐴉𐴞𐴥𐴔𐴡𐴏𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴔𐴞𐴓𐴠𐴃𐴟𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴠𐴌𐴞 𐴀𐴝𐴙𐴐𐴧𐴞𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴡𐴐𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴧𐴠. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />𐴐𐴞𐴥𐴃𐴑𐴝𐴓𐴡𐴌 𐴀𐴝𐴒𐴠 𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴥𐴌. 𐴘𐴟𐴁𐴟𐴓𐴟𐴏𐴢, 𐴂𐴟𐴊𐴠𐴕𐴏𐴢, 𐴓𐴞𐴕𐴡𐴏𐴢, 𐴑𐴝𐴓𐴟𐴊𐴞𐴘𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴠𐴥 𐴃𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />𐴔𐴝𐴓𐴞𐴑 𐴃𐴡𐴌 𐴌𐴟𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>