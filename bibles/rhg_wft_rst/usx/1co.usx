<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">1-𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc2">1 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc3">1𐴑𐴡𐴥𐴌</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">1 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴉𐴡𐴀𐴘𐴓𐴝 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="ip">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 1 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢. 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴉𐴡𐴕𐴎𐴝𐴙𐴐𐴢 𐴉𐴝𐴣𐴏𐴢 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 <char style="ior">(<ref loc="1CO 1:1">1‏:1</ref>)</char>. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴑𐴡𐴥𐴌𐴞𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴎𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤 𐴈𐴠𐴥𐴕𐴃𐴟 𐴘𐴝𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴒𐴝𐴥𐴕. 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝 𐴁𐴝𐴥𐴘 𐴏𐴡𐴉𐴡𐴥𐴌 𐴒𐴡𐴌𐴞𐴥 𐴑𐴡𐴥𐴌𐴞𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴢 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢 <char style="ior">(<ref loc="1CO 16:5-9">16‏:5‏-9</ref>)</char>.</para>
  <para style="ip">𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴡𐴊𐴟𐴥𐴕 𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴎𐴟𐴖𐴝𐴁𐴢, 𐴎𐴞𐴀𐴕 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴃𐴧𐴟 𐴉𐴝𐴘𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴌 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴎𐴠 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴏𐴡𐴓𐴠𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠. 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴥𐴌𐴞𐴕 𐴐𐴡𐴥𐴀𐴌 𐴀𐴠𐴑 𐴕𐴝𐴔𐴡𐴌 𐴋𐴝𐴑, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴠𐴥𐴍𐴞𐴘𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴔𐴝𐴦𐴔𐴠𐴓𐴝 𐴇𐴞𐴥𐴀𐴕 𐴏𐴡𐴓𐴠𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴔𐴧𐴟𐴥𐴑 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴕𐴝𐴥𐴘. 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝𐴃𐴢 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴡𐴐𐴟𐴥𐴌 𐴌𐴟𐴑𐴟𐴥 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴌𐴟𐴑𐴟𐴥 <char style="ior">(<ref loc="1CO 13">13</ref>)</char>.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴡𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴒𐴡𐴌𐴝𐴥 <char style="ior">(<ref loc="1CO 1:1-9">1‏:1‏-9</ref>)</char></para>
  <para style="io1">2. 𐴑𐴡𐴥𐴌𐴞𐴕𐴃𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴡𐴓𐴠𐴌 𐴊𐴠 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞𐴌 𐴔𐴟𐴃𐴝𐴓𐴠𐴑 𐴈𐴡𐴃𐴝𐴤 <char style="ior">(<ref loc="1CO 1:10-4:21">1‏:10‏—4‏:21</ref>)</char></para>
  <para style="io1">3. 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴁𐴞𐴏𐴝𐴌𐴡𐴃𐴢 𐴃𐴟𐴓𐴝𐴤𐴌 𐴔𐴟𐴃𐴝𐴓𐴠𐴑 𐴈𐴡𐴃𐴝𐴤 <char style="ior">(<ref loc="1CO 5-6">5‏—6</ref>)</char></para>
  <para style="io1">4. 𐴁𐴞𐴘𐴝𐴥-𐴐𐴝𐴥𐴊𐴞𐴌, 𐴔𐴟𐴃𐴧𐴞𐴌𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴘𐴝𐴌, 𐴅𐴟𐴔𐴡𐴥𐴌𐴞 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴀𐴡𐴌, 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴃𐴝𐴤 <char style="ior">(<ref loc="1CO 7-15">7‏—15</ref>)</char></para>
  <para style="io1">5. 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="1CO 16">16</ref>)</char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴋𐴝𐴑𐴝 𐴒𐴞𐴘𐴠𐴥. 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴥𐴘 𐴏𐴡𐴥𐴏𐴄𐴞𐴕𐴠𐴏𐴢 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤.<verse eid="1CO 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />𐴑𐴡𐴥𐴌𐴞𐴕 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴘𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴂𐴝𐴑 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴋𐴝𐴑𐴝 𐴒𐴞𐴘𐴠𐴥. 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴡𐴥 𐴓𐴠𐴑𐴞𐴥𐴌, 𐴎𐴠 𐴇𐴝𐴥𐴀𐴌 𐴎𐴝𐴒𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴝𐴔 𐴓𐴡𐴖𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴡𐴥 𐴔𐴝𐴓𐴞𐴑.<verse eid="1CO 1:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="1CO 1:3" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴁𐴡𐴌𐴈𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴝𐴔𐴝𐴥𐴔 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴒𐴞𐴘𐴝𐴕𐴠 𐴇𐴝𐴥𐴀𐴌 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘, <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴊𐴞𐴘𐴞𐴥 𐴊𐴠 𐴒𐴡𐴁𐴝𐴤 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴒𐴝𐴣𐴙𐴃𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴝𐴇𐴠𐴥𐴌𐴞𐴓𐴧𐴝 𐴊𐴞𐴓𐴔𐴡𐴕 𐴊𐴞 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴀𐴝𐴏𐴡𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴌 𐴈𐴡𐴔𐴞 𐴕𐴝𐴥𐴘. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴡𐴥 𐴌𐴝𐴑𐴞𐴥𐴁𐴡, 𐴘𐴝𐴥𐴕𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴊𐴞𐴕𐴡𐴃𐴢 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴝. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />𐴀𐴝𐴓𐴧𐴝 𐴃𐴡 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴥𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝 𐴓𐴧𐴡𐴘 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴓𐴡𐴘.<verse eid="1CO 1:9" /></para>
  <para style="s1">𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢,<note caller="+" style="f"><char style="fr" closed="false">1‏:10 </char><char style="ft" closed="false">𐴒𐴞𐴌𐴞𐴥𐴑 𐴎𐴟𐴁𐴝𐴕𐴡𐴃𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴈𐴡𐴀𐴘𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴟𐴕𐴞𐴥 𐴒𐴟𐴥𐴕 𐴒𐴡𐴥𐴓𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴃𐴎𐴞𐴥𐴘𐴝𐴙𐴕; 𐴓𐴡𐴉𐴎𐴡𐴥 𐴘𐴞𐴥𐴁𐴝 𐴀𐴝𐴘𐴝𐴃𐴢 𐴀𐴞𐴀𐴕𐴡𐴃𐴢 𐴀𐴡𐴥 𐴓𐴡𐴦𐴃𐴉𐴝 𐴎𐴝: 11, 26; 2:1; 3:1; 4:6; 6:8; 7:24, 29; 10:1; 11:33; 12:1; 14:6, 20, 26, 39; 15:1, 6, 50, 58; 16:15, 20. </char></note> 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴝𐴔𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴑 𐴏𐴡𐴥𐴓𐴧𐴟𐴑 𐴀𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴡𐴕 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴘 𐴎𐴠𐴕 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴀𐴡𐴥. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴑𐴝𐴓𐴡𐴖𐴞𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴈𐴡𐴥𐴁𐴡𐴌 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴡𐴥𐴓𐴠 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢 𐴏𐴡𐴓𐴠𐴌. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />𐴀𐴝𐴀𐴛 𐴈𐴡𐴘𐴃𐴝𐴥𐴔 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴑𐴞𐴘𐴠𐴥 𐴈𐴡𐴀 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢,“ 𐴑𐴞𐴘𐴠𐴥 𐴈𐴡𐴀 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴀𐴝𐴂𐴡𐴥𐴓𐴡𐴏𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢,“ 𐴑𐴞𐴘𐴠𐴥 𐴈𐴡𐴀 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴑𐴠𐴥𐴉𐴝𐴏𐴢 𐴀𐴡𐴌<note caller="+" style="f"><char style="fr" closed="false">1‏:12 </char><char style="ft" closed="false">𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴞𐴃𐴡𐴌</char></note> 𐴀𐴟𐴔𐴧𐴡𐴃𐴢,“ 𐴀𐴝𐴌 𐴑𐴞𐴘𐴠𐴥 𐴈𐴡𐴀 𐴊𐴠, ”𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢.“<verse eid="1CO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 1:13" />𐴔𐴡𐴀𐴏𐴞𐴤 𐴑𐴞𐴥 𐴉𐴝𐴀𐴄𐴢-𐴉𐴝𐴀𐴄𐴢 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘؟ 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌𐴠 𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴕𐴝𐴔𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴧𐴡𐴥؟ <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴑𐴌𐴞𐴏𐴂𐴟𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴒𐴝𐴘𐴟𐴏𐴡𐴌𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴕𐴡𐴥 𐴊𐴞𐴥. <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴕𐴝𐴔𐴠 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴧𐴠𐴥 𐴁𐴡𐴥𐴓𐴞 𐴇𐴡𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴀𐴝𐴀𐴛 𐴀𐴠𐴏𐴄𐴠𐴉𐴝𐴥𐴕𐴝𐴏𐴡𐴌 𐴒𐴡𐴥𐴌𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴘𐴡𐴥 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴓𐴝𐴔, 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴌 𐴇𐴝𐴌𐴠𐴤 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴘𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴡𐴕𐴡𐴃𐴢 𐴕𐴡 𐴀𐴟𐴍𐴠𐴤𐴌. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴠 𐴊𐴠 𐴃𐴡 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴊𐴞𐴥𐴃𐴡 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴏𐴝𐴓𐴝𐴥𐴑𐴞 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴥𐴘 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴌 𐴖𐴡𐴌𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴏𐴡𐴥𐴌 𐴏𐴝𐴥𐴌𐴝 𐴕𐴡.<verse eid="1CO 1:17" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴒𐴞𐴘𐴝𐴕</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴎𐴝𐴌𐴒𐴡𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴁𐴠𐴑𐴟𐴙𐴂𐴧𐴝 𐴈𐴡𐴥𐴁𐴡𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝𐴙𐴌, 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="1CO 1:19">”𐴀𐴝𐴀𐴛 𐴒𐴞𐴘𐴝𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴒𐴞𐴘𐴝𐴕𐴡𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴟𐴔,</para>
  <para style="q2" vid="1CO 1:19">𐴀𐴝𐴦𐴌 𐴁𐴟𐴊𐴧𐴞𐴥𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴊𐴧𐴞𐴥𐴌𐴠 𐴁𐴠𐴇𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴟𐴔.“<note caller="+" style="f"><char style="fr" closed="false">1‏:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 29:14">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 29‏:14</ref></char></char></note><verse eid="1CO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />𐴃𐴡𐴥𐴘 𐴒𐴞𐴘𐴝𐴕𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴇𐴡𐴍𐴠𐴥؟ 𐴀𐴝𐴓𐴠𐴔 𐴇𐴡𐴍𐴠𐴥؟ 𐴀𐴠 𐴅𐴝𐴥𐴈𐴝𐴕𐴡𐴌 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞-𐴊𐴡𐴥𐴘𐴝 𐴇𐴡𐴍𐴠𐴥؟ 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴒𐴞𐴘𐴝𐴕𐴡𐴌𐴠 𐴁𐴠𐴑𐴟𐴉𐴢 𐴁𐴡𐴓𐴞 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟ <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴞𐴘𐴝𐴕𐴠 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠, 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴞𐴘𐴝𐴕𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴏𐴞𐴕𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠 𐴉𐴝𐴥𐴕. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴘𐴝𐴀𐴕 𐴉𐴡𐴏𐴡𐴥𐴕 𐴓𐴝𐴙𐴒𐴧𐴠𐴥, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝 𐴊𐴠 𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌𐴠 𐴁𐴠𐴑𐴟𐴉𐴢 𐴄𐴝𐴥𐴀𐴌𐴝 𐴎𐴝 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴊𐴡𐴕. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴞𐴓𐴧𐴝𐴘𐴞-𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴒𐴞𐴌𐴞𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴒𐴞𐴘𐴝𐴕𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴢 𐴒𐴡𐴌𐴠𐴥, <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴝𐴌𐴞 𐴕𐴡 𐴉𐴝𐴌𐴠 𐴀𐴝𐴦𐴌 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴁𐴠𐴑𐴟𐴙𐴂𐴧𐴝 𐴈𐴡𐴥𐴁𐴡𐴌 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴠, <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />𐴓𐴠𐴑𐴞𐴕 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴒𐴞𐴌𐴞𐴥𐴑, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴞𐴘𐴝𐴕. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴠𐴑𐴟𐴉𐴝𐴘𐴧𐴞 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴒𐴞𐴘𐴝𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴒𐴞𐴘𐴝𐴕𐴞, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴡𐴔𐴎𐴟𐴌𐴞 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴁𐴡𐴓𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴡𐴓𐴟𐴖𐴝𐴌.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕, 𐴁𐴝𐴥𐴉𐴞𐴏𐴡, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴋𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝. 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴒𐴞𐴘𐴝𐴕𐴞 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴃𐴝𐴦𐴑𐴡𐴃𐴖𐴝𐴓𐴝 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴖𐴡𐴌𐴡𐴌 𐴃𐴡𐴑𐴧𐴝𐴌 𐴈𐴝𐴥𐴀𐴕𐴊𐴝𐴕𐴡𐴌 𐴀𐴡𐴥 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴒𐴞𐴘𐴝𐴕𐴞 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴐𐴡𐴥𐴌𐴡𐴔 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴁𐴠𐴑𐴟𐴉𐴢 𐴄𐴝𐴥𐴀𐴌𐴠 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴓𐴟𐴖𐴝𐴌 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴐𐴡𐴥𐴌𐴡𐴔 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴑𐴡𐴔𐴎𐴟𐴌 𐴄𐴝𐴥𐴀𐴌𐴠 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴧𐴠 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴇𐴝𐴌 𐴄𐴝𐴥𐴀𐴌𐴠 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴌𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴞𐴀𐴕 𐴕𐴝𐴥𐴘 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴧𐴠 𐴊𐴠 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴝𐴦𐴃𐴠𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝, <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />𐴎𐴠𐴀𐴕𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴡𐴕𐴞𐴐𐴧𐴡𐴥𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴁𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴡𐴤, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴝𐴕; 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌𐴞, 𐴂𐴝𐴑𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴎𐴝𐴊𐴞. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴔𐴡𐴎𐴞𐴕، ”𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴔𐴝𐴁𐴟𐴊𐴡𐴌𐴠 𐴓𐴡𐴥𐴘 𐴁𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴡𐴥𐴗𐴑.“<note caller="+" style="f"><char style="fr" closed="false">1‏:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 9:24">𐴘𐴝𐴌𐴔𐴞𐴥𐴘𐴝 9‏:24</ref></char></char></note><verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴌𐴁𐴝𐴕𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴓𐴝𐴕</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴉𐴡𐴕 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔, 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴐𐴟𐴥𐴕𐴊𐴡𐴌-𐴐𐴟𐴥𐴕𐴊𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴘𐴝𐴥 𐴒𐴞𐴘𐴝𐴕𐴞 𐴈𐴡𐴃𐴝𐴤 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴕𐴡𐴥 𐴒𐴡𐴌𐴞𐴥. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴕𐴞𐴘𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴀𐴝𐴀𐴛 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴎𐴝𐴕𐴞 𐴁𐴡𐴓𐴧𐴝. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴋𐴡𐴦𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴇𐴝𐴉𐴞𐴃𐴝𐴥𐴔. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴘𐴧𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴁𐴞𐴥𐴌𐴝 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴞𐴘𐴝𐴕𐴞 𐴈𐴡𐴃𐴝𐴤 𐴓𐴡𐴥𐴘 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴊𐴝𐴈𐴝𐴤𐴘 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢 𐴊𐴠, <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴒𐴞𐴘𐴝𐴕𐴠 𐴕𐴡 𐴀𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴠.<verse eid="1CO 2:5" /></para>
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴞𐴘𐴝𐴕</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />𐴒𐴞𐴘𐴝𐴕𐴞 𐴈𐴡𐴃𐴝𐴤 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴈𐴡𐴀𐴘𐴢 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴢 𐴁𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥 𐴒𐴞𐴘𐴝𐴕 𐴀𐴠 𐴅𐴝𐴥𐴈𐴝𐴕𐴡𐴌 𐴘𐴝𐴥 𐴀𐴠 𐴅𐴝𐴥𐴈𐴝𐴕𐴡𐴌 𐴏𐴡𐴥𐴊𐴧𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴕𐴡, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴖𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴀𐴕 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴉𐴡𐴕𐴞 𐴒𐴞𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴓𐴧𐴝 𐴄𐴞𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴇𐴠𐴥 𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴒𐴞𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />𐴇𐴠𐴥 𐴒𐴞𐴘𐴝𐴕𐴡𐴌𐴠 𐴀𐴠 𐴅𐴝𐴥𐴈𐴝𐴕𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴏𐴡𐴥𐴊𐴧𐴝𐴌𐴠 𐴕𐴡𐴥 𐴁𐴟𐴎𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴁𐴟𐴎𐴞𐴥𐴃𐴡 𐴃𐴡 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴊𐴞𐴥 𐴔𐴝𐴌𐴞 𐴕𐴡 𐴉𐴠𐴓𐴝𐴘𐴃𐴡. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠,</para>
  <para style="q1" vid="1CO 2:9">”𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥,</para>
  <para style="q2" vid="1CO 2:9">𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴞𐴀𐴕 𐴃𐴡𐴘𐴧𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴠𐴥,</para>
  <para style="q1" vid="1CO 2:9">𐴇𐴞𐴥𐴀𐴕 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤 𐴏𐴟𐴑𐴠𐴤 𐴊𐴠𐴙𐴑𐴧𐴠𐴥,</para>
  <para style="q2" vid="1CO 2:9">𐴕𐴡 𐴇𐴡𐴕𐴡𐴤 𐴈𐴝𐴕𐴠 𐴉𐴟𐴥𐴙𐴕𐴧𐴠,</para>
  <para style="q2" vid="1CO 2:9">𐴀𐴝𐴦𐴌 𐴕𐴡 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.“<note caller="+" style="f"><char style="fr" closed="false">2‏:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 64:4">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 64‏:4</ref></char></char></note><verse eid="1CO 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 2:10" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴞𐴥𐴀𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥 𐴌𐴟𐴀𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴃𐴝𐴇𐴝𐴥𐴑𐴞𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴀𐴠𐴁𐴧𐴠 𐴒𐴟𐴉𐴡𐴕𐴞 𐴒𐴟𐴥𐴕 𐴀𐴟𐴥𐴊𐴧𐴗𐴝. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴌𐴠 𐴎𐴝𐴕𐴠 𐴊𐴠؟ 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴕𐴞𐴎𐴡𐴌 𐴌𐴟𐴀𐴘𐴠 𐴀𐴠𐴥𐴕𐴝 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴌𐴠 𐴎𐴝𐴕𐴠. 𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴌𐴠 𐴘𐴡𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴘𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴎𐴝𐴕𐴠. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴌𐴟𐴀 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴌𐴟𐴀 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴠 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴦𐴘𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴏𐴞𐴕𐴞𐴥 𐴉𐴝𐴌𐴞. <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴈𐴡𐴀𐴘𐴢 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠. 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴘𐴃𐴠𐴤 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠 𐴓𐴡𐴉𐴎𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴒𐴞𐴘𐴝𐴕𐴠 𐴊𐴞𐴘𐴝 𐴐𐴞𐴥𐴑𐴧𐴝𐴌 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴊𐴞𐴘𐴝 𐴐𐴞𐴥𐴑𐴧𐴝𐴌. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴇𐴝𐴥𐴑𐴞𐴒𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴟𐴎𐴝𐴥𐴘𐴃𐴠 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴓𐴡𐴉𐴎𐴡𐴥 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥.<verse eid="1CO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 2:14" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴝𐴃𐴧𐴟 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴕𐴝𐴥𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴎𐴞𐴀𐴕 𐴀𐴝𐴘𐴧𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴑𐴡𐴁𐴟𐴓𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴁𐴠𐴑𐴟𐴙𐴂𐴧𐴝. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴟𐴎𐴞𐴥 𐴘𐴡𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴇𐴠𐴥 𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />𐴎𐴝𐴃𐴧𐴟 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴀𐴝𐴏𐴠𐴤 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴏𐴝𐴀, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠, <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤,</para>
  <para style="q1" vid="1CO 2:16">”𐴔𐴝𐴁𐴟𐴊𐴡𐴌 𐴊𐴠𐴔𐴝𐴑𐴡𐴌𐴠 𐴇𐴡𐴕𐴠 𐴎𐴝𐴙𐴕𐴧𐴠𐴥,</para>
  <para style="q2" vid="1CO 2:16">𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴟𐴊𐴧𐴞𐴥 𐴊𐴞𐴥 𐴉𐴝𐴙𐴃𐴧𐴡؟“<note caller="+" style="f"><char style="fr" closed="false">2‏:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:13">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 40‏:13</ref></char></char></note></para>
  <para style="m" vid="1CO 2:16">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴠𐴔𐴝𐴑 𐴀𐴝𐴏𐴠𐴤.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s1">𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞 𐴀𐴡𐴓𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤 𐴉𐴡𐴌𐴠, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴈𐴡𐴀𐴘𐴢 𐴕𐴡𐴥 𐴉𐴝𐴌𐴞, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴈𐴡𐴀 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴈𐴡𐴖𐴝𐴤 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴊𐴟𐴊𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴟𐴊𐴢 𐴈𐴝𐴥𐴁𐴝𐴘𐴓𐴝𐴔, 𐴊𐴡𐴌𐴡𐴤 𐴈𐴝𐴥𐴕𐴝 𐴕𐴡; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝. 𐴁𐴠𐴐𐴡𐴥𐴑 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡𐴥 𐴀𐴡𐴥𐴘𐴧𐴡, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞.<note caller="+" style="f"><char style="fr" closed="false">3‏:3 </char><char style="ft" closed="false">𐴘𐴝𐴥 </char><char style="fqa">𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴡𐴀𐴌 </char> </note> 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴇𐴝𐴥𐴏𐴡𐴌𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴙𐴅𐴧𐴝-𐴉𐴡𐴥𐴎𐴧𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴦𐴔 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴏𐴡𐴓𐴡𐴀𐴌 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟ <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀, ”𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢,“ 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴠, ”𐴀𐴝𐴀𐴛 𐴀𐴝𐴂𐴡𐴥𐴓𐴡𐴏𐴡𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢,“ 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />𐴀𐴠𐴀𐴕𐴠, 𐴀𐴝𐴂𐴡𐴥𐴓𐴡𐴏𐴢 𐴇𐴡𐴕؟ 𐴀𐴝𐴦𐴌 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴇𐴡𐴕؟ 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴃𐴡 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴠𐴥𐴕𐴝, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴡𐴤. 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴎𐴝𐴌-𐴎𐴝𐴌 𐴎𐴞𐴔𐴧𐴝 𐴃𐴝𐴌𐴠𐴥-𐴃𐴝𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴠𐴥. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />𐴀𐴝𐴀𐴛 𐴁𐴞𐴏𐴢 𐴓𐴝𐴒𐴝𐴘𐴧𐴞𐴥, 𐴀𐴝𐴂𐴡𐴥𐴓𐴡𐴏𐴠 𐴉𐴝𐴕𐴞𐴥 𐴊𐴞𐴦𐴘𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴝𐴌𐴝𐴤𐴘𐴧𐴠 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝 𐴘𐴠. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴓𐴝𐴒𐴡𐴘𐴝 𐴘𐴡𐴥 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡, 𐴉𐴝𐴕𐴞𐴥-𐴊𐴡𐴦𐴘𐴝 𐴘𐴡𐴥 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴥𐴑𐴞 𐴁𐴝𐴌𐴝𐴤𐴘𐴧𐴠 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />𐴓𐴝𐴒𐴡𐴘𐴧𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴉𐴝𐴕𐴞𐴥-𐴊𐴡𐴦𐴘𐴝𐴌 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴉𐴝𐴘𐴁𐴡. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴡𐴥𐴘𐴧𐴞 𐴊𐴠 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴡𐴁𐴞𐴕، 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴁𐴞𐴓𐴧𐴞𐴥𐴚.<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴊𐴞𐴦𐴘𐴠𐴥 𐴊𐴠 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴔𐴡𐴎𐴞𐴕، 𐴀𐴠𐴎𐴧𐴡𐴕 𐴒𐴞𐴘𐴝𐴕𐴞 𐴔𐴞𐴏𐴃𐴞𐴥𐴌𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞 𐴋𐴝𐴥𐴙𐴓𐴧𐴞, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴞𐴓𐴧𐴞𐴥𐴚 𐴃𐴟𐴓𐴠𐴥𐴌. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴕𐴞𐴎𐴠 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴁𐴝𐴕𐴝𐴘𐴃𐴟𐴓𐴠𐴥𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴎𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴀𐴡𐴥𐴖𐴝𐴌 𐴎𐴡𐴌𐴟𐴌. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />𐴎𐴠 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴋𐴝𐴥𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴇𐴠𐴥 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤. 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞 𐴋𐴝𐴥𐴓𐴞 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴐𐴟𐴥𐴕𐴝, 𐴌𐴟𐴉𐴝, 𐴊𐴝𐴔𐴞 𐴉𐴝𐴃𐴧𐴡𐴥𐴌, 𐴒𐴝𐴏𐴢, 𐴁𐴡𐴙𐴅𐴧𐴝𐴓𐴢 𐴘𐴝𐴥 𐴕𐴝𐴣𐴌𐴝𐴤 𐴓𐴡𐴥𐴘 𐴇𐴠𐴥 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴥𐴌 𐴁𐴝𐴕𐴝𐴘𐴁𐴡𐴥 𐴊𐴠 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴎𐴡𐴕𐴡𐴌 𐴈𐴝𐴔 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴊𐴞𐴕 𐴀𐴝𐴘𐴓𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴦𐴙𐴕 𐴓𐴡𐴘 𐴁𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴡𐴦𐴘𐴕𐴠 𐴇𐴝𐴌 𐴈𐴝𐴔 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴎𐴠𐴦 𐴎𐴞𐴘𐴝𐴥𐴕 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴡𐴊𐴞 𐴕𐴡 𐴉𐴟𐴌𐴞 𐴄𐴞𐴑𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴁𐴝𐴕𐴡𐴘𐴝𐴘𐴠 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴉𐴝𐴘𐴁𐴡. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴝𐴌 𐴒𐴝𐴥𐴕 𐴉𐴟𐴌𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴒𐴟𐴕𐴝𐴤𐴌𐴞 𐴀𐴡𐴥𐴘𐴁𐴡. 𐴁𐴠𐴐𐴡𐴥𐴑 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴝𐴏𐴞𐴎𐴝𐴘𐴁𐴡𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴠𐴀𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴡𐴦𐴙𐴕 𐴉𐴝𐴌𐴝𐴤𐴘 𐴀𐴝𐴙𐴐𐴧𐴠𐴥.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌 𐴊𐴠 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠 𐴊𐴠𐴥؟ <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴌𐴠 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴥𐴌 𐴃𐴡 𐴂𐴝𐴑, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥 𐴒𐴡𐴥𐴌 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴉𐴝𐴥𐴑𐴞 𐴕𐴡 𐴊𐴞𐴘𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠 𐴅𐴝𐴥𐴈𐴝𐴕𐴡𐴃𐴢 𐴒𐴞𐴘𐴝𐴕𐴞 𐴁𐴡𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴁𐴠𐴑𐴟𐴉𐴢 𐴁𐴡𐴕𐴡𐴗𐴑, 𐴎𐴠𐴀𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴒𐴞𐴘𐴝𐴕𐴞 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴒𐴞𐴘𐴝𐴕-𐴁𐴟𐴊𐴧𐴞𐴥 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴁𐴠𐴑𐴟𐴉𐴝𐴘𐴧𐴞. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴒𐴞𐴘𐴝𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴏𐴝𐴓𐴝𐴥𐴑𐴞𐴌 𐴉𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴠𐴥𐴓𐴝.“<note caller="+" style="f"><char style="fr" closed="false">3‏:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 5:13">𐴀𐴝𐴘𐴟𐴁𐴢 5‏:13</ref></char></char></note> <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, ”𐴔𐴝𐴁𐴟𐴊𐴠 𐴒𐴞𐴘𐴝𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴥𐴉𐴝 𐴁𐴠𐴇𐴝𐴌 𐴊𐴠 𐴎𐴝𐴕𐴠.“<note caller="+" style="f"><char style="fr" closed="false">3‏:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 94:11">𐴎𐴡𐴁𐴟𐴌 94‏:11</ref></char></char></note> <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴓𐴡𐴥𐴘 𐴁𐴡𐴌𐴝𐴥𐴘 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌: <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴀𐴡𐴥𐴑, 𐴀𐴝𐴂𐴡𐴥𐴓𐴡𐴏𐴢 𐴀𐴡𐴥𐴑, 𐴑𐴠𐴥𐴉𐴝𐴏𐴢<note caller="+" style="f"><char style="fr" closed="false">3‏:22 </char><char style="ft" closed="false">𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴞𐴃𐴡𐴌</char></note> 𐴀𐴡𐴥𐴑, 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴀𐴡𐴥𐴑, 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴀𐴡𐴥𐴑, 𐴔𐴡𐴦𐴃𐴢 𐴀𐴡𐴥𐴑, 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕, 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌, 𐴀𐴝𐴦𐴌 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s1">𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴉𐴡𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴁𐴝𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴁𐴡𐴓𐴞 𐴁𐴟𐴎𐴡𐴥𐴗𐴑. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴎𐴡𐴌𐴟𐴌𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴓𐴡𐴦𐴃𐴉𐴡𐴕. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />𐴀𐴝𐴣𐴀𐴌 𐴁𐴞𐴏𐴝𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴒𐴡𐴌𐴡𐴤 𐴘𐴝𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴀𐴝𐴊𐴝𐴓𐴡𐴃𐴠 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴋𐴡𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡; 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴕𐴞𐴎𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴀𐴟𐴓𐴋𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴎𐴝𐴕𐴞; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴇𐴡𐴥𐴕𐴡 𐴀𐴝𐴀𐴛 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌 𐴁𐴡𐴥𐴓𐴞 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴝𐴣𐴀𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴓𐴞𐴑𐴠. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴀𐴝𐴒𐴠 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴁𐴞𐴏𐴝𐴌 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴔𐴝𐴓𐴞𐴑 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴃𐴝𐴥𐴙𐴑𐴧𐴡. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴎𐴞𐴀𐴕 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴃𐴢 𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴉𐴡𐴀𐴌𐴡𐴃𐴢 𐴀𐴝𐴕𐴞𐴤𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴊𐴞𐴓𐴡𐴌 𐴀𐴠𐴌𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴎𐴝𐴌-𐴎𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴃𐴠𐴦-𐴃𐴠𐴦 𐴉𐴝𐴘𐴁𐴡.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴥𐴓𐴝𐴘 𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴕𐴞𐴎𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴂𐴡𐴥𐴓𐴡𐴏𐴡𐴌 𐴔𐴠𐴀𐴏𐴝𐴓𐴢 𐴊𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴞𐴀𐴕 𐴈𐴡𐴘𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤𐴌 𐴔𐴝𐴀𐴕𐴞 𐴐𐴞𐴥𐴑𐴡, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, ”𐴎𐴞𐴀𐴕 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴕𐴡 𐴎𐴝𐴘𐴧𐴡.“ 𐴁𐴝𐴦𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴁𐴡𐴌𐴝𐴥𐴘𐴧𐴠 𐴉𐴟𐴥𐴓𐴞 𐴕𐴡 𐴀𐴟𐴍𐴞𐴤𐴁𐴝. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌 𐴇𐴡𐴕𐴠 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴕𐴡𐴥 𐴉𐴡𐴦 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤؟ 𐴎𐴡𐴊𐴞 𐴉𐴝𐴘𐴧𐴡𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴘 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡𐴥 𐴉𐴡𐴦 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴡𐴤؟<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />𐴏𐴝𐴘𐴃𐴠𐴥 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴉𐴝𐴘𐴧𐴡𐴌𐴠 𐴃𐴟𐴖𐴝𐴚𐴒𐴡𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘; 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘 𐴉𐴝𐴥𐴕 𐴓𐴝𐴒𐴠𐴌. 𐴁𐴠𐴐𐴡𐴥𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴀𐴣𐴐𐴧𐴝 𐴀𐴡𐴥𐴘𐴃𐴝 𐴁𐴡𐴥𐴓𐴞 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴙𐴃𐴧𐴝𐴔. <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴓𐴝𐴒𐴠 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴞𐴏𐴠𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴌𐴝𐴙𐴑𐴧𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌, 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴕𐴡𐴎𐴡𐴌𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴃𐴡𐴦𐴣𐴐𐴝𐴤 𐴁𐴡𐴕𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴁𐴠𐴑𐴟𐴉𐴢 𐴁𐴡𐴕𐴞𐴒𐴞𐴘𐴞𐴥𐴒𐴡𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘 𐴒𐴞𐴘𐴝𐴕𐴞 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴒𐴡𐴘. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴡𐴔𐴎𐴟𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴡𐴓𐴟𐴖𐴝𐴌. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴕𐴝𐴥𐴘. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴁𐴟𐴥𐴑𐴧𐴞 𐴀𐴠𐴊𐴧𐴠 𐴃𐴞𐴌𐴝𐴥𐴐𐴞. 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴦𐴌𐴏𐴟𐴖𐴡𐴌𐴡𐴌 𐴈𐴡𐴔𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴞𐴍𐴝 𐴇𐴝𐴥𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴡𐴥𐴌, <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴠 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥. 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴘𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴁𐴡𐴌𐴈𐴡𐴃𐴢 𐴊𐴞. 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴙𐴓𐴧𐴠𐴥 𐴘𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥. <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴕𐴡𐴌𐴡𐴔𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴇𐴡𐴣𐴏𐴝𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴉𐴟𐴥𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴞𐴒𐴡𐴘, 𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />𐴀𐴝𐴀𐴛 𐴀𐴞𐴀𐴕 𐴓𐴠𐴑𐴞𐴥𐴌 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴐𐴡𐴥𐴌𐴡𐴔 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝𐴊𐴡𐴘𐴝 𐴀𐴝𐴥𐴎𐴝𐴌-𐴀𐴝𐴥𐴎𐴝𐴌 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴘𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴁𐴝𐴉𐴢 𐴁𐴞𐴐𐴞𐴤 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴡𐴤𐴕𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴢. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴕𐴡𐴔𐴟𐴕𐴝 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴡. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />𐴇𐴠𐴥 𐴕𐴞𐴘𐴡𐴃𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴞𐴔𐴡𐴥𐴃𐴞𐴌𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴞, 𐴎𐴞𐴁𐴝𐴤 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴉𐴟𐴖𐴝. 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴠 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴎𐴝𐴒𐴝𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴁𐴡.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴌 𐴕𐴟 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴡𐴌𐴝𐴥𐴘𐴧𐴠 𐴉𐴟𐴥𐴓𐴞 𐴀𐴟𐴙𐴄𐴧𐴠𐴥. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />𐴔𐴝𐴓𐴞𐴑𐴠 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴝𐴥𐴌𐴝 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔, 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴁𐴡𐴌𐴝𐴥𐴘𐴧𐴠 𐴉𐴟𐴥𐴓𐴞 𐴀𐴟𐴙𐴄𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴕𐴞𐴓𐴡𐴘𐴧𐴟𐴔 𐴊𐴠 𐴕𐴡 𐴏𐴞𐴌𐴞𐴥𐴉𐴢, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴑𐴞𐴦 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴎𐴝𐴕𐴞𐴓𐴡𐴘𐴧𐴟𐴔. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴃𐴡 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴡𐴌 𐴖𐴡𐴌𐴠. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕 𐴕𐴝𐴥𐴕 𐴁𐴝𐴏𐴞𐴥𐴁𐴝؟ 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴡𐴍𐴞𐴥 𐴓𐴡𐴥𐴘 𐴀𐴝𐴘𐴃𐴝𐴤𐴔 𐴕𐴠𐴥, 𐴕𐴝𐴥𐴑𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴄𐴝𐴥𐴕𐴋𐴝 𐴔𐴠𐴎𐴝𐴏𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴘𐴃𐴝𐴤𐴔؟<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s1">𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞𐴌 𐴁𐴞𐴏𐴝𐴌</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />𐴉𐴟𐴥𐴕𐴝 𐴎𐴝𐴌 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞 𐴏𐴡𐴓𐴠𐴌, 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞 𐴎𐴞𐴀𐴕 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴝𐴥𐴘, 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴝𐴉𐴡𐴌 𐴁𐴡𐴖𐴢 𐴓𐴡𐴘 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴒𐴟𐴥𐴔 𐴎𐴝. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢 𐴈𐴝𐴥𐴘𐴁𐴝 𐴃𐴡𐴥𐴑, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴌𐴡𐴤 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴘 𐴒𐴡𐴌𐴡𐴤. 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴝𐴘 𐴊𐴡𐴕 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴕𐴠𐴥؟ <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴇𐴝𐴥𐴎𐴞𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴘𐴡, 𐴌𐴟𐴀𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴇𐴝𐴥𐴎𐴞𐴌 𐴀𐴝𐴏𐴞𐴤; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴀𐴝𐴀𐴛 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴇𐴝𐴥𐴎𐴞𐴌 𐴀𐴝𐴏𐴞𐴤 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴒𐴡𐴌𐴞𐴥 𐴌𐴝𐴙𐴑𐴧𐴞𐴥. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴕𐴝𐴔𐴠 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴁𐴝, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴌𐴟𐴀𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴝𐴥𐴎𐴞𐴌 𐴀𐴡𐴥𐴘𐴧𐴟𐴔, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴝𐴥𐴑𐴞𐴁𐴡, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌 𐴌𐴟𐴀𐴘𐴠 𐴎𐴠𐴕 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴇𐴠𐴥 𐴊𐴞𐴕 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴡𐴤𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴔 𐴕𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴀𐴠𐴑𐴧𐴞𐴕𐴞𐴥 𐴒𐴡𐴥𐴌𐴞 𐴐𐴟𐴥𐴄𐴝𐴌𐴠 𐴈𐴝𐴛𐴡𐴌 𐴊𐴡𐴓𐴝 𐴒𐴟𐴣𐴍𐴝 𐴉𐴟𐴥𐴓𐴝𐴘𐴉𐴠𐴓𐴠 𐴊𐴠𐴥؟ <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />𐴉𐴟𐴌𐴝𐴕𐴝 𐴐𐴟𐴥𐴄𐴝𐴌 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡𐴘𐴝 𐴈𐴝𐴛 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴡𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴐𐴟𐴥𐴄𐴝𐴌 𐴏𐴝𐴥𐴌𐴝. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴎𐴝𐴊𐴞𐴌-𐴀𐴞𐴊𐴡𐴌 𐴁𐴠𐴥𐴌𐴝𐴏𐴡𐴥𐴀𐴓𐴢-𐴀𐴡𐴌-𐴏𐴡𐴥𐴀𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴟𐴌𐴝𐴕𐴝 𐴐𐴟𐴥𐴄𐴝𐴌, 𐴘𐴝𐴥𐴕𐴞 𐴊𐴟𐴐𐴧𐴡𐴕𐴞𐴌 𐴀𐴠𐴊𐴧𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴞𐴌 𐴐𐴟𐴥𐴄𐴝𐴌 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴡𐴌𐴠 𐴐𐴟𐴥𐴄𐴝𐴌 𐴏𐴝𐴥𐴌𐴝 𐴌𐴟𐴄𐴞 𐴓𐴡𐴘 𐴀𐴞𐴊𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴠𐴈𐴠𐴥𐴓𐴝𐴏𐴠 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />𐴀𐴝𐴣𐴀𐴌 𐴐𐴠𐴣𐴍𐴞𐴥𐴃𐴢 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴕𐴡 𐴌𐴝𐴙𐴑𐴧𐴡𐴥; <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />𐴀𐴝𐴀𐴛 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴓𐴧𐴡𐴥𐴘 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴕𐴡 𐴌𐴝𐴑𐴞𐴥𐴃𐴡 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴕𐴡 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴓𐴝𐴓𐴡𐴥𐴏𐴁𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴋𐴝𐴈𐴝𐴣𐴙𐴄𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴘𐴝𐴥 𐴔𐴟𐴃𐴧𐴞-𐴉𐴟𐴣𐴎𐴡𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴓𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴝𐴀𐴌𐴠 𐴎𐴝𐴦𐴒𐴡𐴥𐴘 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴑𐴟𐴥𐴖𐴝𐴓𐴝 𐴊𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴥𐴘 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴕𐴡 𐴌𐴝𐴙𐴑𐴧𐴡𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌, 𐴓𐴝𐴓𐴡𐴥𐴏𐴁𐴡𐴕, 𐴔𐴟𐴃𐴧𐴞-𐴉𐴟𐴣𐴎𐴡𐴘𐴝, 𐴁𐴡𐴊𐴕𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, 𐴕𐴞𐴐𐴝𐴥𐴑𐴟𐴌, 𐴘𐴝𐴥 𐴄𐴞𐴛𐴝𐴔𐴝𐴌𐴟. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴝𐴥𐴕𐴝 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴕𐴝 𐴈𐴝𐴥𐴘𐴧𐴡.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴑𐴞𐴘𐴠𐴥 𐴉𐴝𐴘𐴧𐴠𐴥 𐴁𐴝𐴀𐴌𐴒𐴗𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴝𐴥𐴘𐴠؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴥 𐴃𐴡𐴌𐴞𐴑𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴡𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴁𐴞𐴏𐴝𐴌 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤 𐴕𐴠𐴥؟ <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴝𐴀𐴌𐴒𐴗𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴁𐴞𐴏𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴇𐴠𐴥 𐴁𐴟𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴐𐴡𐴥𐴔𐴝𐴎𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴓𐴝𐴘𐴊𐴡.“<note caller="+" style="f"><char style="fr" closed="false">5‏:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 13:5">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 13‏:5</ref>; <ref loc="DEU 17:7">17‏:7</ref>; <ref loc="DEU 19:19">19‏:19</ref>; <ref loc="DEU 21:21">21‏:21</ref>; <ref loc="DEU 22:21">22‏:21</ref>‏,<ref loc="DEU 22:24">24</ref>; <ref loc="DEU 24:7">24‏:7</ref></char></char></note><verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s1">𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴞𐴏𐴝𐴌 𐴏𐴝𐴘𐴃𐴡𐴥 𐴎𐴝𐴦𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘 𐴓𐴡𐴥𐴘 𐴇𐴡𐴙𐴅𐴧𐴝 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴇𐴡𐴕 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴞𐴏𐴝𐴌 𐴏𐴝𐴘𐴃𐴡𐴥 𐴕𐴡 𐴎𐴝𐴘 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴏𐴝𐴘𐴃𐴡𐴥 𐴎𐴡𐴦؟ <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴊𐴠𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴐𐴡𐴥𐴣𐴍𐴡-𐴐𐴡𐴥𐴣𐴍𐴡 𐴇𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴕𐴡 𐴕𐴠𐴥؟ <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔 𐴊𐴠𐴥؟ 𐴇𐴠𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴒𐴟𐴥𐴕 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴑𐴞𐴦؟ <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴦𐴔𐴠𐴓𐴝 𐴃𐴝𐴥𐴑𐴞𐴓𐴠, 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴁𐴝𐴀𐴌𐴒𐴗𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴑𐴞𐴘𐴝𐴥 𐴁𐴞𐴏𐴝𐴌𐴇𐴝𐴌 𐴃𐴞𐴥𐴘𐴝𐴒𐴝𐴌𐴡؟ <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />𐴀𐴝𐴀𐴛 𐴀𐴞𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴐𐴡𐴥𐴌𐴡𐴔 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴒𐴞𐴘𐴝𐴕𐴞 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴕𐴝𐴥𐴘 𐴕𐴞𐴥𐴑𐴞, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌 𐴔𐴝𐴦𐴔𐴠𐴓𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴝𐴦𐴁𐴠𐴓؟ <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴠𐴑 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴝𐴌𐴀𐴠𐴑 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴠 𐴁𐴞𐴏𐴝𐴌𐴡𐴃𐴢 𐴎𐴡𐴦, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟!<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴡𐴦𐴊𐴧𐴞𐴔𐴝 𐴒𐴡𐴌𐴡𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴊𐴝𐴈𐴝𐴤 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴁𐴧𐴠𐴌𐴠 𐴇𐴡𐴥𐴣𐴍𐴞 𐴒𐴞𐴥𐴘𐴡𐴒𐴡𐴘. 𐴘𐴝𐴥𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴕𐴝𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞 𐴑𐴞𐴘𐴝𐴥 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤؟ 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴁𐴠𐴘𐴔𐴝𐴕𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴑𐴞𐴘𐴝𐴥 𐴕𐴡 𐴊𐴡؟ <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴃𐴡 𐴕𐴝𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴞 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴁𐴠𐴘𐴔𐴝𐴕𐴞 𐴒𐴡𐴌𐴡𐴤, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴡𐴌𐴠 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴒𐴡𐴌𐴡𐴤.<verse eid="1CO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴑𐴟𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴔𐴞𐴌𐴝𐴏𐴢 𐴕𐴡 𐴉𐴝𐴘𐴁𐴡 𐴊𐴠𐴥؟ 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴉𐴝𐴥𐴑𐴞 𐴕𐴡 𐴊𐴞𐴘𐴡; 𐴁𐴡𐴊𐴔𐴝𐴐𐴢, 𐴔𐴟𐴃𐴧𐴞-𐴉𐴟𐴣𐴎𐴡𐴘𐴝, 𐴎𐴠𐴕𐴝𐴤𐴑𐴟𐴌, 𐴔𐴡𐴌𐴡𐴃𐴠-𐴔𐴡𐴌𐴡𐴃𐴠 𐴎𐴠𐴕𐴝𐴤-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />𐴏𐴟𐴌, 𐴓𐴝𐴓𐴡𐴥𐴏𐴁𐴡𐴕, 𐴕𐴞𐴐𐴝𐴥𐴑𐴟𐴌, 𐴁𐴡𐴊𐴕𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, 𐴄𐴞𐴛𐴝𐴔𐴝𐴌𐴟, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴔𐴞𐴌𐴝𐴏𐴢 𐴕𐴡 𐴉𐴝𐴘𐴁𐴡. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴝𐴔𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴟𐴥𐴘𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴡𐴌𐴇𐴠𐴥𐴏𐴒𐴝𐴌 𐴁𐴡𐴥𐴓𐴞 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠.<verse eid="1CO 6:11" /></para>
  <para style="s1">𐴅𐴞𐴏𐴞𐴥𐴔 𐴓𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴡𐴤</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴉𐴝𐴌𐴠, ”𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴝𐴘𐴠𐴏𐴢,“ 𐴄𐴞𐴥𐴑 𐴈𐴡𐴃𐴝𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴈𐴡𐴀𐴘𐴢 𐴉𐴝𐴙𐴅𐴧𐴟𐴔, ”𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴝𐴘𐴠𐴏𐴢,“ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴕𐴡 𐴊𐴞𐴘𐴟𐴔. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴘𐴡𐴥 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴉𐴝𐴌𐴠, ”𐴈𐴝𐴥𐴕𐴝 𐴉𐴠𐴄𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴉𐴠𐴄𐴢 𐴈𐴝𐴥𐴕𐴝𐴓𐴧𐴝,“ 𐴄𐴞𐴥𐴑 𐴈𐴡𐴃𐴝𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴊𐴟𐴕𐴞𐴥𐴘𐴝𐴕 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡. 𐴔𐴡𐴕𐴡𐴃𐴢 𐴌𐴝𐴙𐴑𐴧𐴡𐴥, 𐴅𐴞𐴏𐴞𐴥𐴔 𐴎𐴠𐴕𐴝𐴤 𐴓𐴧𐴝 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴝𐴓𐴞𐴑 𐴀𐴡𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴡𐴓𐴧𐴝. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴠𐴥 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡. <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴠𐴥؟ 𐴃𐴡𐴥𐴘 𐴀𐴝𐴀𐴛 𐴑𐴞𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴒𐴞𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴁𐴝𐴕𐴝𐴘𐴧𐴟𐴥𐴔؟ 𐴁𐴞𐴓𐴑𐴟𐴥𐴓𐴢 𐴕𐴡. <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴀𐴕 𐴕𐴡 𐴎𐴝𐴕𐴡, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴒𐴞 𐴓𐴧𐴡𐴘 𐴔𐴞𐴓𐴔𐴞𐴓𐴝𐴁𐴢 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴇𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴀𐴠𐴑 𐴒𐴝𐴦 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴊𐴠𐴥؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕 𐴀𐴠𐴑 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘.“ <note caller="+" style="f"><char style="fr" closed="false">6‏:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 2‏:24</ref></char></char></note> <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴝𐴓𐴞𐴑 𐴓𐴡𐴘 𐴀𐴠𐴑 𐴀𐴡𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴀𐴠𐴑 𐴌𐴟𐴀 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘.<note caller="+" style="f"><char style="fr" closed="false">6‏:17 </char><char style="ft" closed="false">𐴘𐴝𐴥 </char><char style="fqa" closed="false">𐴀𐴠𐴑 𐴌𐴟𐴀𐴃𐴢</char></note><verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞𐴃𐴧𐴟 𐴊𐴝𐴥𐴘𐴎𐴡𐴒𐴡𐴘. 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴀𐴝𐴌 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴎𐴠 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴡𐴌𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴁𐴝𐴀𐴌𐴠 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴎𐴠𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴂𐴝𐴑-𐴌𐴟𐴀 𐴃𐴝𐴥𐴑𐴞𐴁𐴝𐴌 𐴒𐴡𐴥𐴌 𐴊𐴠, 𐴎𐴞𐴁𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴡𐴓𐴧𐴡𐴥𐴉𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴉𐴝𐴘𐴧𐴡𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴕𐴡, <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴝𐴔 𐴊𐴞𐴦 𐴑𐴞𐴕𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴓𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴡𐴤.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s1">𐴁𐴞𐴘𐴝𐴥-𐴐𐴝𐴥𐴊𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴐𐴞𐴥𐴑𐴧𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴙𐴑𐴧𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴌: 𐴀𐴡𐴥𐴘, 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴓𐴡𐴘 𐴔𐴞𐴓𐴔𐴞𐴓𐴝𐴁𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴤𐴕 𐴒𐴡𐴔. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞𐴃𐴧𐴟 𐴁𐴝𐴏𐴞 𐴃𐴝𐴥𐴑𐴞 𐴁𐴡𐴓𐴧𐴝, 𐴉𐴡𐴃𐴧𐴞𐴥 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴃𐴝𐴥𐴑𐴡𐴗𐴑, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />𐴇𐴡𐴥𐴐𐴡𐴔𐴠 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴇𐴡𐴥𐴑 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴁𐴡𐴖𐴢 𐴖𐴠𐴥 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌 𐴇𐴡𐴥𐴑 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴡𐴥𐴗𐴑. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />𐴁𐴡𐴖𐴢 𐴖𐴡𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴦𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴕𐴝𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴃𐴧𐴟 𐴁𐴠 𐴀𐴝𐴏𐴠𐴤; 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴦𐴌 𐴖𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌 𐴕𐴝𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴃𐴧𐴟 𐴁𐴠 𐴀𐴝𐴏𐴠𐴤. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴀𐴞𐴕𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴊𐴞𐴥𐴘𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴊𐴟𐴕𐴞𐴥 𐴎𐴡𐴕𐴠 𐴌𐴝𐴎𐴞𐴌𐴡𐴁𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴡𐴌𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴡𐴑𐴃𐴡𐴥 𐴓𐴧𐴝 𐴉𐴝𐴌𐴞𐴁𐴝𐴥. 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴁𐴝𐴌 𐴀𐴝𐴒𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴡𐴒𐴡𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴣𐴓𐴞 𐴌𐴝𐴑𐴝𐴤𐴌 𐴈𐴡𐴔𐴞 𐴓𐴡𐴘𐴧𐴡𐴌𐴠 𐴐𐴡𐴥𐴘𐴃𐴝𐴕𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴕𐴡 𐴉𐴠𐴥𐴓𐴝. <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴞𐴀𐴕 𐴇𐴡𐴥𐴑𐴟𐴔 𐴒𐴡𐴌𐴞𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴞𐴌 𐴊𐴠. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴎𐴧𐴟 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴉𐴡𐴃𐴧𐴞𐴥 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴝𐴣𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴑. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴎𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴞𐴦𐴘𐴝 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴌𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴘𐴝𐴀𐴕 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴣𐴓𐴞 𐴌𐴝𐴑𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴎𐴧𐴟𐴘𐴠 𐴎𐴡𐴓𐴞𐴉𐴟𐴌𐴞 𐴎𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴠𐴀𐴃𐴡𐴌 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡𐴕.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴝𐴀𐴛 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴌, 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴝𐴀𐴛 𐴊𐴞𐴌 𐴊𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴝𐴓𐴞𐴑𐴠 𐴊𐴠𐴌 𐴊𐴠, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴁𐴡𐴖𐴢 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴃𐴧𐴟 𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴡𐴒𐴧𐴡𐴥𐴘. <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴃𐴝𐴥𐴑𐴞𐴎𐴝𐴒𐴡𐴘 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴓𐴡𐴥𐴘 𐴀𐴝𐴁𐴝𐴌 𐴁𐴡𐴕𐴞𐴎𐴝𐴒𐴡𐴥𐴘 𐴉𐴡𐴌𐴞𐴁𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴕𐴡 𐴏𐴝𐴥𐴌𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />𐴀𐴝𐴦𐴌 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴝𐴓𐴞𐴑𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴀𐴛 𐴈𐴡𐴀𐴙𐴌, 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴡𐴃𐴧𐴟 𐴎𐴡𐴊𐴞 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴡𐴖𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴁𐴝 𐴃𐴝𐴌 𐴓𐴡𐴘 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴌𐴝𐴎𐴞 𐴀𐴡𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴠𐴦 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴕𐴡 𐴏𐴝𐴥𐴌𐴡𐴗𐴑. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴎𐴡𐴊𐴞 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴃𐴠𐴦 𐴇𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴌𐴝𐴎𐴞 𐴀𐴡𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌𐴠 𐴕𐴡 𐴏𐴝𐴥𐴌𐴡𐴗𐴑. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴇𐴡𐴥𐴐𐴡𐴔 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴡𐴖𐴢 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴂𐴝𐴑-𐴏𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘; 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴕𐴝𐴉𐴝𐴑 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴂𐴝𐴑.<verse eid="1CO 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌𐴒𐴗𐴝𐴥 𐴎𐴡𐴊𐴞 𐴀𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘 𐴏𐴝𐴀, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴧𐴡𐴘. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘 𐴘𐴝𐴥 𐴁𐴡𐴥𐴙𐴕 𐴁𐴞𐴘𐴝𐴥-𐴐𐴝𐴥𐴊𐴞𐴌 𐴁𐴝𐴕𐴡𐴌 𐴃𐴡𐴓𐴠 𐴕𐴝𐴥𐴘. 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴋𐴝𐴙𐴑𐴧𐴠𐴥. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />𐴀𐴡𐴥 𐴁𐴡𐴖𐴢, 𐴃𐴟𐴘 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴎𐴝𐴕𐴡𐴏𐴢, 𐴃𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝 𐴁𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴞𐴥 𐴊𐴠؟ 𐴀𐴡𐴥 𐴇𐴡𐴥𐴐𐴡𐴔, 𐴃𐴟𐴘 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴎𐴝𐴕𐴡𐴏𐴢, 𐴃𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝 𐴁𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴞𐴥 𐴊𐴠؟<verse eid="1CO 7:16" /></para>
  <para style="s1">𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴋𐴝𐴑𐴝 𐴔𐴡𐴎𐴞𐴕 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴡</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />𐴔𐴝𐴓𐴞𐴑𐴠 𐴎𐴝𐴌𐴠𐴥 𐴎𐴠 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴌𐴝𐴙𐴑𐴧𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴎𐴝𐴌𐴠𐴥 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴇𐴠𐴥 𐴔𐴡𐴎𐴞𐴕 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴡. 𐴃𐴝𐴔𐴝𐴥𐴔 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴛 𐴊𐴞 𐴊𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴋𐴝𐴈𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴁𐴠-𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴕𐴡 𐴒𐴡𐴌𐴡𐴥𐴗𐴑. 𐴎𐴡𐴊𐴞 𐴁𐴠-𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴋𐴝𐴈𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴕𐴡 𐴒𐴡𐴌𐴡𐴥𐴗𐴑. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴝𐴥 𐴘𐴡𐴥 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡, 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴕𐴡 𐴒𐴡𐴌𐴝𐴥 𐴘𐴡𐴥 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴢 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴡𐴤𐴕. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴝𐴌𐴠𐴥 𐴎𐴠 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴠𐴥 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴡.<verse eid="1CO 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 7:21" />𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴒𐴟𐴓𐴝𐴔𐴞 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴋𐴝𐴈𐴝 𐴒𐴞𐴘𐴠𐴥 𐴊𐴠 𐴕𐴠𐴥؟ 𐴉𐴠𐴌𐴠𐴐𐴝𐴕 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴞𐴁𐴝𐴥𐴌 𐴔𐴡𐴦𐴗𐴑𐴝 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴡𐴤. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴓𐴞𐴑𐴠 𐴎𐴝𐴌𐴠𐴥 𐴒𐴟𐴓𐴝𐴔𐴞 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴎𐴝𐴌𐴠𐴥 𐴀𐴝𐴎𐴝𐴊𐴞 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴋𐴝𐴙𐴑𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴒𐴟𐴓𐴝𐴔. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴝𐴔 𐴊𐴞𐴦 𐴑𐴞𐴕𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴕𐴡 𐴁𐴡𐴕𐴞𐴘𐴡𐴥. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕, 𐴎𐴝𐴌𐴠𐴥 𐴎𐴠 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴠 𐴋𐴝𐴈𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴇𐴠𐴥 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞 𐴀𐴝𐴓𐴧𐴝 𐴓𐴧𐴡𐴘 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴎𐴝𐴌𐴞 𐴌𐴝𐴑𐴡𐴥.<verse eid="1CO 7:24" /></para>
  <para style="s1">𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴀𐴠𐴊𐴧𐴠 𐴌𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />𐴘𐴝𐴓𐴝 𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥: 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤 𐴇𐴡𐴥𐴑𐴟𐴔 𐴕𐴡𐴥 𐴉𐴝𐴘, 𐴓𐴠𐴑𐴞𐴕 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴀𐴝𐴀𐴛 𐴁𐴡𐴥𐴌𐴝𐴐𐴝𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴀𐴡𐴥𐴘𐴧𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌 𐴌𐴝𐴘 𐴊𐴞𐴌. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />𐴘𐴝𐴓𐴝 𐴏𐴡𐴓𐴠𐴌 𐴊𐴠 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴟𐴎𐴟 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴉𐴝 𐴔𐴡𐴎𐴞𐴕، 𐴎𐴠𐴦 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴒𐴡𐴔 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴁𐴡𐴖𐴢 𐴀𐴝𐴏𐴠𐴤 𐴕𐴞𐴑𐴞؟ 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴏𐴞𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴃𐴡𐴘 𐴎𐴟𐴦 𐴕𐴡 𐴃𐴟𐴖𐴝𐴘𐴧𐴡𐴥. 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴃𐴧𐴟 𐴁𐴡𐴖𐴢 𐴕𐴝𐴥𐴘 𐴕𐴞𐴑𐴞؟ 𐴕𐴡 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴁𐴡𐴖𐴢 𐴕𐴡 𐴃𐴟𐴖𐴝𐴘𐴧𐴡𐴥. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡, 𐴃𐴟𐴀𐴛 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴡𐴤𐴌 𐴊𐴠 𐴇𐴠𐴥𐴀𐴕 𐴕𐴡; 𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴡𐴥 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴠𐴥𐴌 𐴊𐴠 𐴇𐴠𐴥𐴀𐴕 𐴕𐴡. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴁𐴝𐴏𐴝𐴘 𐴁𐴡𐴓𐴧𐴝, 𐴎𐴞𐴀𐴕 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴀𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴈𐴡𐴘𐴃𐴝𐴥𐴔 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴡𐴑𐴃𐴡𐴥 𐴀𐴠𐴁𐴧𐴠 𐴈𐴡𐴔; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴁𐴡𐴖𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴘𐴝𐴓𐴝 𐴓𐴡𐴥𐴃𐴞 𐴀𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴏𐴡𐴓𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴁𐴡𐴖𐴢 𐴕𐴝𐴥𐴘; <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴒𐴡𐴌𐴠𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴑 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴈𐴝𐴣𐴊𐴝𐴈𐴝𐴍𐴞 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥𐴌; 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴠𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴑 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴟𐴥𐴐𐴞 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥𐴌; 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴑𐴞𐴕𐴠𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴑 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘; <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴀𐴕 𐴀𐴡𐴥𐴑 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴁𐴞𐴌𐴝𐴕𐴝 𐴕𐴝𐴥𐴘. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴃𐴡 𐴁𐴡𐴊𐴡𐴓𐴞𐴎𐴝𐴌𐴒𐴡𐴥𐴘.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴞 𐴏𐴝𐴥𐴌𐴝 𐴃𐴝𐴥𐴑𐴡. 𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴠 𐴁𐴝𐴥𐴉𐴠, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴕𐴞𐴎𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴠 𐴁𐴝𐴥𐴉𐴠, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥; <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />𐴀𐴞𐴥𐴃𐴝𐴌 𐴔𐴡𐴕 𐴊𐴟𐴘𐴈𐴝𐴍𐴝𐴃𐴢 𐴉𐴡𐴌𐴠. 𐴎𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴀𐴝𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴘𐴝𐴥 𐴑𐴟𐴖𐴝𐴥𐴌𐴞, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴠 𐴁𐴝𐴥𐴉𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴞𐴥𐴁𐴝 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴌𐴟𐴀𐴃𐴢 𐴂𐴝𐴑 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴠. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴞𐴘𐴝𐴥𐴃𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴠 𐴁𐴝𐴥𐴉𐴠, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴡𐴥. <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴝𐴥𐴘𐴊𐴝𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴞𐴉𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕 𐴎𐴞𐴘𐴝𐴥𐴕 𐴏𐴡𐴥𐴘𐴧𐴞 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴑 𐴊𐴞𐴥𐴘𐴝𐴕𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴀𐴕 𐴄𐴝𐴥𐴀𐴌𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴞𐴥𐴃𐴝𐴌 𐴎𐴟𐴌𐴝𐴒𐴝𐴃𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴠𐴓𐴠𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴡𐴔 𐴕𐴡 𐴀𐴡𐴥𐴌, 𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴁𐴞𐴘𐴝𐴥𐴌 𐴉𐴟𐴌𐴝𐴕𐴞 𐴁𐴞𐴐𐴞𐴤 𐴀𐴡𐴥𐴘 𐴇𐴞𐴥𐴁𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 𐴊𐴠 𐴁𐴝𐴥𐴉𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴠𐴌𐴝𐴊𐴝 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴟𐴕𐴝𐴤 𐴕𐴡; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡𐴗𐴑. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴑𐴟𐴖𐴝𐴥𐴌𐴞 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴠𐴃𐴧𐴝𐴌 𐴁𐴞𐴘𐴝𐴥 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴠-𐴊𐴞𐴓𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴡𐴤 𐴔𐴡𐴅𐴁𐴟𐴌𐴞 𐴕𐴝𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴡𐴕𐴐𐴝𐴥𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴏𐴡𐴥𐴣𐴓𐴞 𐴉𐴝𐴌𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴘𐴡𐴥 𐴒𐴡𐴔 𐴒𐴡𐴌𐴠𐴥. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴌 𐴎𐴟𐴌𐴝𐴒𐴝𐴃𐴝𐴤 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌𐴠 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴠 𐴀𐴞𐴥𐴃𐴠 𐴒𐴡𐴔 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴠𐴓𐴠 𐴀𐴞𐴥𐴃𐴠 𐴀𐴝𐴌𐴡𐴤 𐴒𐴡𐴔 𐴒𐴡𐴌𐴠𐴥.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />𐴇𐴡𐴥𐴐𐴡𐴔 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴎𐴞𐴕𐴊𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴁𐴡𐴖𐴢 𐴇𐴡𐴥𐴐𐴡𐴔 𐴓𐴡𐴥𐴘 𐴇𐴠𐴥𐴃𐴡𐴊𐴞𐴕 𐴁𐴠 𐴁𐴝𐴙𐴕𐴊𐴝𐴤 𐴃𐴝𐴥𐴑𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴥𐴐𐴡𐴔 𐴔𐴡𐴌𐴞𐴎𐴝𐴒𐴡𐴥𐴘, 𐴇𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴎𐴝𐴌𐴠𐴥 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴃𐴝𐴌𐴠𐴥 𐴁𐴞𐴘𐴝𐴥 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴀𐴝𐴎𐴝𐴊𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴓𐴠𐴑𐴞𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴧𐴗𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴃𐴡𐴌𐴞𐴑𐴝𐴌 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />𐴀𐴝𐴣𐴀𐴌 𐴌𐴝𐴘 𐴔𐴡𐴎𐴞𐴕، 𐴇𐴞𐴥𐴁𐴝 𐴎𐴡𐴊𐴞 𐴇𐴠𐴥𐴊𐴧𐴟𐴌𐴡𐴃𐴢 𐴃𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘, 𐴇𐴞𐴥𐴁𐴝 𐴀𐴝𐴌𐴡𐴤 𐴑𐴟𐴥𐴐𐴞𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴁𐴡. 𐴀𐴝𐴀𐴛 𐴄𐴝𐴥𐴀𐴌𐴞𐴌 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴠 𐴈𐴡𐴀𐴙𐴌.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s1">𐴔𐴟𐴃𐴧𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴘𐴝 𐴈𐴝𐴥𐴕𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />𐴘𐴝𐴓𐴝 𐴔𐴟𐴃𐴧𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴘𐴝 𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥: 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴞, 𐴀𐴡𐴥𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴀𐴝𐴏𐴠𐴤. 𐴎𐴝𐴕𐴑𐴝𐴌𐴞𐴘𐴠 𐴃𐴡 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴘 𐴁𐴝𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴃𐴡𐴌𐴑𐴞 𐴀𐴝𐴕𐴠𐴤. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴀𐴝𐴏𐴠𐴤 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴠, 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴀𐴡𐴊𐴧𐴟𐴥𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴕𐴝𐴥𐴘 𐴎𐴠𐴊𐴧𐴟𐴥𐴌 𐴀𐴞𐴥𐴃𐴝𐴃𐴧𐴟 𐴃𐴝𐴥𐴑𐴝 𐴉𐴡𐴙𐴃𐴧𐴡. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴠 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴏𐴞𐴕𐴠𐴥.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴔𐴟𐴃𐴧𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴘𐴝 𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴇𐴝𐴥𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥: 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴝𐴕𐴞, 𐴔𐴟𐴃𐴧𐴞 𐴃𐴡 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴀𐴝𐴏𐴡𐴥𐴓𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴕𐴝𐴥𐴘. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴊𐴠𐴁𐴡𐴃𐴝 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴘𐴝𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴘𐴡, 𐴁𐴠𐴐𐴡𐴥𐴑 𐴊𐴠𐴁𐴡𐴃𐴝 𐴈𐴡𐴀 𐴊𐴠 𐴘𐴡𐴥 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴑𐴟𐴥𐴊𐴝 𐴈𐴡𐴀 𐴊𐴠 𐴘𐴡𐴥 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴠𐴤; <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴑𐴒𐴗𐴝𐴥, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴁𐴝𐴉𐴢, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴝𐴦𐴌 𐴎𐴞𐴁𐴝𐴤 𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴙𐴌. 𐴀𐴝𐴦𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴘𐴡𐴥 𐴀𐴠𐴑𐴒𐴗𐴝𐴥, 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠 𐴀𐴝𐴦𐴌 𐴎𐴞𐴁𐴝𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴝𐴏𐴞 𐴀𐴝𐴏𐴞𐴤.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴃𐴧𐴟 𐴇𐴠𐴥 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴒𐴝𐴥𐴕 𐴕𐴝𐴥𐴘. 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴔𐴟𐴃𐴧𐴞 𐴉𐴟𐴣𐴎𐴝𐴌 𐴀𐴝𐴊𐴡𐴃𐴢 𐴃𐴝𐴥𐴘𐴒𐴞𐴘𐴡𐴘 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴟𐴃𐴧𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴘𐴝 𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴝𐴥𐴀, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴠𐴥𐴓𐴡𐴔 𐴑𐴡𐴔𐴎𐴟𐴌𐴞𐴘𐴠 𐴕𐴝𐴉𐴝𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />𐴈𐴝𐴥𐴕𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴋𐴝𐴥𐴑𐴠 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥; 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴕𐴝 𐴈𐴝𐴥𐴘𐴓𐴠 𐴘𐴡 𐴇𐴡𐴕𐴡𐴤 𐴓𐴟𐴏𐴧𐴝𐴥𐴕 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴦𐴌 𐴈𐴝𐴥𐴘𐴓𐴠 𐴘𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴝𐴥𐴘.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />𐴃𐴡𐴀 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴠 𐴀𐴝𐴎𐴝𐴊𐴞𐴘𐴠 𐴇𐴠𐴥𐴓𐴡𐴔 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴡𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴕𐴡 𐴉𐴡𐴌𐴝𐴁𐴝. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤 𐴇𐴠𐴥𐴓𐴡𐴔 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴡𐴓𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴃𐴟𐴀𐴛 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴀𐴡𐴓𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴔𐴟𐴃𐴧𐴞𐴌 𐴔𐴡𐴕𐴊𐴞𐴌𐴡𐴃𐴢 𐴈𐴝𐴥𐴕𐴝 𐴈𐴡𐴥𐴀𐴌 𐴊𐴠 𐴊𐴠𐴑𐴠𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴘𐴡𐴥 𐴑𐴞𐴥 𐴔𐴟𐴃𐴧𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴘𐴝 𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴝𐴥𐴘𐴃𐴡 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴕𐴡 𐴉𐴝𐴘𐴁𐴡 𐴕𐴠𐴥؟ <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />𐴃𐴡𐴥𐴘 𐴇𐴠𐴥 𐴑𐴡𐴔𐴎𐴟𐴌 𐴁𐴝𐴥𐴘 𐴎𐴝𐴌 𐴓𐴧𐴝 𐴔𐴡𐴀𐴏𐴞𐴤 𐴔𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡𐴥𐴘 𐴕𐴠𐴥؟ <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴞𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴑𐴡𐴔𐴎𐴟𐴌 𐴇𐴠𐴥𐴓𐴡𐴔𐴡𐴃𐴢 𐴎𐴡𐴈𐴡𐴥𐴔 𐴒𐴡𐴌𐴡𐴤, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴓𐴋𐴝 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴡𐴤𐴌 𐴊𐴠. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴡𐴊𐴞 𐴈𐴝𐴥𐴕𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴉𐴡𐴌𐴝𐴁𐴝, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴒𐴟𐴏𐴧𐴡 𐴕𐴝 𐴈𐴝𐴥𐴘𐴧𐴟𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴒𐴟𐴕𐴝𐴤𐴃𐴢 𐴕𐴡 𐴉𐴡𐴌𐴠.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s1">𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴌 𐴇𐴡𐴥𐴑 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />𐴀𐴝𐴀𐴛 𐴑𐴞𐴥 𐴀𐴝𐴎𐴝𐴊𐴢 𐴕𐴡؟ 𐴀𐴝𐴀𐴛 𐴑𐴞𐴥 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴕𐴡؟ 𐴀𐴝𐴀𐴛 𐴑𐴞𐴥 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴕𐴡𐴥 𐴊𐴠𐴑𐴞𐴥؟ 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴝𐴔𐴡𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴕𐴠𐴥؟ <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴌𐴒𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴊𐴠 𐴕𐴡 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴁𐴠𐴐𐴡𐴥𐴑 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴡𐴥𐴘; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴒𐴞𐴌𐴞𐴌 𐴔𐴡𐴀𐴌.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴏𐴝𐴥𐴇𐴝𐴁𐴞𐴒𐴞𐴌𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴣𐴀𐴌 𐴎𐴟𐴖𐴝𐴁𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠: <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴈𐴝𐴥𐴕𐴝-𐴉𐴞𐴕𐴝 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑 𐴕𐴝𐴥𐴘 𐴕𐴞𐴑𐴞؟ <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴑𐴞𐴥 𐴕𐴞𐴎𐴡𐴌 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴡𐴖𐴢 𐴓𐴡𐴘 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴝𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑 𐴕𐴝𐴥𐴘, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴙𐴕𐴧𐴡 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕 𐴀𐴡𐴃𐴧𐴟, 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌 𐴃𐴧𐴟, 𐴀𐴠𐴊𐴧𐴠 𐴑𐴠𐴥𐴉𐴝𐴏𐴢<note caller="+" style="f"><char style="fr" closed="false">9‏:5 </char><char style="ft" closed="false">𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴞𐴃𐴡𐴌</char></note>𐴀𐴡𐴃𐴧𐴟 𐴀𐴝𐴏𐴠𐴤؟ <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴁𐴝𐴥𐴌𐴕𐴝𐴁𐴝𐴏𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴈𐴝𐴔 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑 𐴕𐴝𐴥𐴘 𐴊𐴠؟<verse eid="1CO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7" />𐴕𐴞𐴎𐴡𐴌 𐴄𐴞𐴛𐴝 𐴇𐴡𐴥𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴡𐴥𐴗𐴏𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟ 𐴀𐴝𐴚𐴒𐴟𐴌-𐴁𐴝𐴌𐴞𐴎𐴝 𐴓𐴝𐴒𐴝𐴘 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴧𐴟 𐴒𐴟𐴓𐴝 𐴕𐴝 𐴈𐴝𐴥𐴀 𐴊𐴠 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟ 𐴀𐴝𐴦𐴌 𐴒𐴡𐴌𐴟-𐴏𐴡𐴥𐴀𐴓𐴢 𐴉𐴝𐴓𐴞 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴊𐴟𐴊𐴢 𐴕𐴝 𐴈𐴝𐴥𐴀 𐴊𐴠 𐴇𐴡𐴕 𐴀𐴝𐴏𐴠𐴤؟ <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />𐴀𐴝𐴀𐴛 𐴑𐴞𐴥 𐴀𐴞𐴀𐴕 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴑𐴞𐴘𐴝𐴏𐴠 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴕𐴠𐴥؟ 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴠 𐴘𐴡𐴥 𐴑𐴞𐴥 𐴀𐴞𐴀𐴕 𐴕𐴡 𐴈𐴡𐴀 𐴕𐴠𐴥؟ <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />𐴔𐴟𐴀𐴏𐴝𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴊𐴝𐴥𐴕 𐴀𐴟𐴥𐴣𐴌𐴡𐴌 𐴊𐴠 𐴒𐴡𐴌𐴟𐴌𐴠 𐴈𐴡𐴀𐴣𐴌 𐴕𐴡 𐴊𐴞𐴘𐴡𐴥.“<note caller="+" style="f"><char style="fr" closed="false">9‏:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 25:4">𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢-𐴕𐴝𐴔𐴝 25‏:4</ref></char></char></note> 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴑𐴞 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴒𐴡𐴌𐴟 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴏𐴞𐴕𐴃𐴝 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴕𐴠𐴥؟ <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡 𐴕𐴠𐴥؟ 𐴁𐴠𐴐𐴡𐴥𐴑, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴁𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴥𐴓𐴐𐴝𐴐𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝𐴃𐴧𐴟 𐴀𐴝𐴐𐴝𐴤𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴥𐴓𐴐𐴝𐴐𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴀𐴝𐴦𐴌 𐴊𐴝𐴥𐴕-𐴀𐴟𐴥𐴣𐴌𐴡𐴘𐴝𐴃𐴧𐴟 𐴁𐴝𐴥𐴑 𐴉𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴐𐴝𐴤𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴝𐴥𐴕 𐴀𐴟𐴥𐴣𐴌𐴝𐴌 𐴎𐴡𐴌𐴟𐴌. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴁𐴞𐴏𐴢 𐴐𐴞𐴥𐴣𐴄𐴧𐴞, 𐴃𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴉𐴡𐴥𐴏𐴡𐴓𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴝𐴘 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴞𐴥 𐴋𐴡𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴕𐴠𐴥؟ <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴞𐴘𐴡𐴥𐴃𐴧𐴟 𐴎𐴡𐴊𐴞 𐴇𐴞𐴥𐴀𐴕 𐴉𐴝𐴘𐴁𐴝𐴌 𐴇𐴡𐴥𐴑 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴑𐴞𐴥 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴕𐴝𐴥𐴘 𐴕𐴠𐴥؟</para>
  <para style="p" vid="1CO 9:12">𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴠𐴥 𐴇𐴡𐴥𐴑 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝𐴘 𐴕𐴡𐴥 𐴃𐴟𐴓𐴞𐴤; 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴓𐴧𐴝 𐴁𐴝𐴎𐴝𐴥 𐴉𐴡𐴘𐴊𐴝 𐴕𐴡.<verse eid="1CO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 9:13" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴁𐴝𐴘𐴃𐴟𐴓𐴢-𐴔𐴟𐴑𐴝𐴊𐴧𐴡𐴏𐴡𐴃𐴧𐴟 𐴈𐴝𐴥𐴕𐴝 𐴉𐴝𐴦 𐴊𐴠𐴥؟ 𐴀𐴝𐴦𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴃𐴧𐴟 𐴁𐴝𐴥𐴑 𐴉𐴝𐴦 𐴊𐴠𐴥؟ <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />𐴁𐴡𐴌𐴝𐴁𐴡𐴌 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴔𐴝𐴓𐴞𐴑𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴘𐴠 𐴊𐴠 𐴑𐴞, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴗𐴑.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥 𐴇𐴡𐴥𐴑 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴧𐴟 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴉𐴝𐴥𐴘𐴊𐴝𐴘 𐴕𐴡𐴥 𐴃𐴟𐴓𐴞𐴤. 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴥𐴑𐴡𐴌 𐴊𐴝𐴁𐴞 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴀𐴕 𐴓𐴠𐴑𐴞𐴥𐴌 𐴊𐴠 𐴕𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴇𐴡𐴥𐴑 𐴇𐴝𐴌𐴞𐴤 𐴓𐴡𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴡 𐴊𐴞𐴥𐴘𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴀𐴝𐴀𐴛 𐴔𐴡𐴌𐴞𐴎𐴡𐴕 𐴕𐴝𐴥𐴕 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴁𐴠𐴀𐴃𐴡𐴌 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />𐴀𐴝𐴀𐴛 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴁𐴡𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴉𐴡𐴥𐴌𐴡𐴏𐴢. 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴉𐴏𐴟𐴥𐴏𐴢, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥. <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥 𐴈𐴝𐴔 𐴕𐴞𐴎𐴡𐴃𐴧𐴟 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴘𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴃𐴝𐴥𐴑𐴞𐴃𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴎𐴞𐴔𐴧𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴑𐴞𐴦؟ 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴀𐴛 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴝𐴀𐴛 𐴎𐴠𐴕 𐴇𐴡𐴕𐴡𐴤 𐴊𐴝𐴔 𐴏𐴝𐴥𐴌𐴝 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌 𐴎𐴠 𐴇𐴡𐴥𐴑 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴀𐴛 𐴎𐴠𐴕 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴝𐴥𐴘𐴊𐴝𐴘 𐴕𐴡 𐴃𐴟𐴓𐴞𐴤.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴕𐴡 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴟𐴓𐴝𐴔 𐴁𐴝𐴕𐴝𐴘𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴄𐴝𐴕𐴞𐴀𐴝𐴕𐴞𐴤 𐴉𐴝𐴌𐴞. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴛 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴡𐴙𐴕𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴄𐴝𐴕𐴞𐴀𐴝𐴕𐴞𐴤 𐴉𐴝𐴌𐴞. 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴀𐴛 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴕𐴡 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴞𐴤 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴃𐴝𐴥𐴙𐴑𐴧𐴞, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴄𐴝𐴕𐴞𐴀𐴝𐴕𐴞𐴤 𐴉𐴝𐴌𐴞. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴁𐴡𐴙𐴕𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴏𐴠𐴤 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴄𐴝𐴕𐴞𐴀𐴝𐴕𐴞𐴤 𐴉𐴝𐴌𐴞. 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴞𐴦𐴘𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝 𐴊𐴠 𐴕𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴞𐴤. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴛 𐴑𐴡𐴔𐴎𐴟𐴌 𐴁𐴡𐴙𐴕𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴄𐴝𐴕𐴞𐴀𐴝𐴕𐴞𐴤 𐴉𐴝𐴌𐴞. 𐴀𐴝𐴀𐴛 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴡𐴙𐴕𐴧𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴎𐴠 𐴇𐴡𐴕𐴡𐴤 𐴁𐴡𐴃𐴠 𐴇𐴡𐴊𐴟𐴥𐴕𐴡𐴌𐴠 𐴁𐴝𐴏𐴝𐴘 𐴉𐴝𐴌𐴞. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴘 𐴉𐴝𐴌𐴞.<verse eid="1CO 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴡 𐴎𐴝𐴕𐴡 𐴕𐴠𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴊𐴟𐴣𐴌𐴝𐴊𐴟𐴣𐴌𐴞 𐴎𐴞𐴁𐴧𐴝𐴃𐴢 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴣𐴙𐴃𐴧𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴊𐴟𐴣𐴌𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠𐴑𐴎𐴡𐴕𐴠 𐴉𐴝𐴦 𐴊𐴠𐴥؟ 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴎𐴞𐴃𐴞 𐴉𐴝𐴌𐴡 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴊𐴟𐴣𐴌𐴡. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴠𐴥𐴓𐴝𐴃𐴢 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴀𐴡𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴌𐴝 𐴕𐴞𐴘𐴡𐴔-𐴑𐴝𐴦𐴕𐴟𐴕 𐴔𐴝𐴕𐴞 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴏𐴡𐴥𐴣𐴓𐴞 𐴌𐴝𐴑𐴠𐴥. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴝𐴐𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴊𐴠 𐴃𐴝𐴏𐴢 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴝𐴐𐴢 𐴕𐴡 𐴀𐴡𐴥 𐴊𐴠 𐴃𐴝𐴏𐴢 𐴉𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠 𐴒𐴡𐴌𐴞𐴥. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴔𐴡𐴑𐴏𐴡𐴥𐴃𐴢 𐴏𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴊𐴟𐴣𐴌𐴞; 𐴁𐴡𐴐𐴧𐴞𐴕 𐴑𐴠𐴥𐴓𐴡𐴘𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴁𐴡𐴘𐴧𐴝𐴌𐴡𐴃𐴢 𐴕𐴡 𐴔𐴝𐴌𐴞. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴦𐴌 𐴖𐴡𐴌𐴠 𐴈𐴡𐴌𐴝𐴒𐴡𐴌𐴞 𐴕𐴞𐴘𐴡𐴔-𐴑𐴝𐴦𐴕𐴟𐴕 𐴏𐴡𐴓𐴝𐴘 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴓𐴝𐴔 𐴁𐴝𐴕𐴝𐴘 𐴌𐴝𐴑𐴞𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴠 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴡𐴌 𐴕𐴝𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴝𐴘𐴒𐴡𐴥𐴘.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s1">𐴔𐴟𐴃𐴧𐴞 𐴉𐴟𐴣𐴎𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴏𐴝𐴀𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴀𐴕𐴡𐴌 𐴀𐴡𐴎𐴝𐴕𐴝 𐴃𐴝𐴥𐴑𐴡, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴁𐴝𐴉𐴊𐴝𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴌 𐴏𐴝𐴥𐴘𐴧𐴝𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴝𐴌𐴝𐴤𐴘 𐴒𐴞𐴀𐴓𐴢. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴟𐴀𐴏𐴝𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴔𐴞𐴘𐴟𐴥𐴓𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴊𐴡𐴙𐴅𐴧𐴝𐴃𐴢 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴥𐴙𐴓𐴢; <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴠𐴑𐴞𐴤 𐴒𐴝𐴁𐴞 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴀𐴙𐴓𐴢, <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴠𐴑𐴞𐴤 𐴒𐴝𐴁𐴞 𐴉𐴝𐴕𐴞𐴥 𐴈𐴝𐴥𐴀𐴙𐴓𐴢. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴝𐴕𐴞𐴥 𐴈𐴝𐴥𐴘𐴃𐴡 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴘𐴃𐴡 𐴊𐴠 𐴒𐴝𐴁𐴞 𐴐𐴞𐴥𐴓𐴢 𐴘𐴞𐴥𐴁𐴝 𐴃𐴧𐴟, 𐴇𐴠𐴥 𐴐𐴞𐴥𐴓𐴢 𐴓𐴗𐴝𐴥 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴡𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴦𐴐𐴁𐴝𐴥𐴑 𐴓𐴡𐴥𐴘 𐴀𐴝𐴓𐴧𐴝 𐴑𐴟𐴥𐴐𐴞 𐴕𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴓𐴝𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴡𐴘𐴊𐴝𐴕 𐴎𐴝𐴒𐴝𐴃𐴢 𐴊𐴡𐴌𐴁𐴡𐴊𐴡𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴓𐴒𐴡𐴘.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴏𐴠𐴥𐴁𐴡𐴑 𐴁𐴡𐴙𐴕𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴞𐴓𐴔𐴡𐴕 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴟𐴃𐴧𐴞 𐴉𐴟𐴣𐴎𐴝 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢. 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴈𐴝𐴥𐴕𐴝-𐴉𐴞𐴕𐴝 𐴈𐴝𐴥𐴘𐴃𐴡 𐴁𐴡𐴀𐴘𐴢 𐴕𐴝𐴏𐴞𐴃𐴡𐴥 𐴀𐴟𐴙𐴄𐴧𐴠𐴥.“<note caller="+" style="f"><char style="fr" closed="false">10‏:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 32:6">𐴇𐴞𐴥𐴎𐴡𐴌𐴡𐴃𐴢 32‏:6</ref></char></char></note> <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />𐴀𐴝𐴘𐴧𐴡𐴤 𐴀𐴝𐴣𐴀𐴌𐴝 𐴎𐴠𐴕𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴒𐴡𐴌𐴞𐴥 𐴀𐴠𐴑 𐴊𐴞𐴕𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴟𐴌𐴞 𐴃𐴞𐴕 𐴀𐴝𐴥𐴎𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴔𐴡𐴌𐴞𐴒𐴞𐴥𐴓𐴒𐴡𐴘; <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴉𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴡𐴣𐴌𐴝𐴕 𐴇𐴝𐴥𐴘 𐴔𐴡𐴌𐴞𐴒𐴞𐴥𐴓𐴒𐴡𐴘; <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />𐴐𐴠𐴥𐴑𐴝𐴘𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴞𐴥, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴓𐴝𐴑-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴘𐴠 𐴇𐴝𐴥𐴓𐴝𐴑 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴙𐴓𐴢.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴏𐴠𐴥𐴁𐴡𐴑 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴡𐴥𐴘𐴧𐴠 𐴊𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴎𐴡𐴁𐴝𐴕𐴝𐴌 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴡𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴃𐴞𐴥𐴘𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴠, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴃𐴡𐴥𐴑, 𐴎𐴠𐴀𐴕𐴠 𐴉𐴡𐴌𐴞 𐴕𐴡 𐴎𐴝𐴒𐴡𐴥𐴘. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴕𐴡𐴥 𐴉𐴡𐴌𐴡, 𐴎𐴞𐴀𐴕 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴦𐴔𐴉𐴝𐴥𐴔 𐴕𐴡. 𐴀𐴝𐴓𐴧𐴝 𐴃𐴡 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌; 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴡 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴃𐴢 𐴉𐴡𐴙𐴃𐴧𐴡 𐴕𐴡 𐴊𐴞𐴁𐴡; 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴠𐴕𐴃𐴝𐴥𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴠𐴥𐴕𐴃𐴟 𐴕𐴠𐴦𐴓𐴞𐴀𐴝𐴘𐴁𐴝𐴥𐴌 𐴉𐴡𐴣𐴃𐴢 𐴀𐴡𐴥 𐴔𐴞𐴓𐴝𐴘𐴊𐴞𐴁𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴡.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴔𐴟𐴃𐴧𐴞 𐴉𐴟𐴣𐴎𐴝𐴃𐴧𐴟 𐴊𐴝𐴥𐴘𐴎𐴡𐴒𐴡𐴘. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴇𐴡𐴓𐴁𐴡𐴕 𐴁𐴡𐴓𐴞 𐴁𐴟𐴎𐴞𐴥 𐴈𐴡𐴃𐴝𐴤 𐴀𐴞𐴀𐴕 𐴈𐴡𐴀𐴙𐴌. 𐴀𐴝𐴀𐴛 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴁𐴝𐴥𐴉𐴞𐴏𐴡. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌 𐴉𐴞𐴘𐴝𐴓𐴝𐴃𐴧𐴟 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥 𐴇𐴝𐴥𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴕𐴠𐴥؟ 𐴀𐴝𐴦𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴌𐴟𐴄𐴞 𐴁𐴝𐴥𐴚𐴒𐴞 𐴇𐴝𐴥𐴘, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴒𐴝𐴦𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴝𐴘𐴒𐴡𐴥𐴘 𐴕𐴠𐴥؟ <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />𐴌𐴟𐴄𐴞 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴃𐴡 𐴀𐴠𐴑𐴒𐴗𐴝𐴥, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴞𐴐𐴞𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴠𐴑 𐴒𐴝𐴦, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴡 𐴇𐴠𐴥 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴌𐴟𐴄𐴞 𐴀𐴠𐴥𐴕𐴝 𐴇𐴝𐴥𐴘.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />𐴁𐴡𐴕𐴞 𐴀𐴞𐴏𐴌𐴝𐴥𐴙𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴥𐴉𐴞𐴏𐴡: 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴘𐴝 𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴝𐴥𐴀, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴞𐴥 𐴑𐴟𐴌𐴁𐴝𐴕𐴞-𐴒𐴝𐴥𐴣𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴎𐴝𐴒𐴡𐴥𐴘 𐴕𐴠𐴥؟ <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴓𐴡𐴥𐴘 𐴑𐴞𐴥 𐴀𐴝𐴀𐴛 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠, 𐴔𐴟𐴃𐴧𐴞𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴞𐴘𐴝 𐴈𐴝𐴥𐴕𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴞𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴘𐴝𐴥 𐴔𐴟𐴃𐴧𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴞𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤؟ <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠, 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴞𐴀𐴕 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴑𐴟𐴌𐴁𐴝𐴕𐴞 𐴊𐴠𐴊𐴠 𐴕𐴡 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴊𐴠 𐴊𐴠. 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴏𐴝𐴀𐴘𐴢 𐴊𐴠 𐴑𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴇𐴡𐴕𐴡𐴤 𐴃𐴝𐴦𐴓𐴟𐴑𐴝𐴃𐴢 𐴌𐴝𐴑𐴡𐴥. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴉𐴞𐴘𐴝𐴓𐴝𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴞𐴘𐴝𐴓𐴝𐴃𐴧𐴟 𐴀𐴠𐴑𐴧𐴟 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴝𐴥𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴔𐴠𐴏𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴠𐴏𐴡𐴃𐴢 𐴀𐴠𐴑𐴧𐴟 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴡𐴥𐴘 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴝𐴥. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />𐴕𐴝𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴒𐴝𐴘𐴌𐴡𐴃𐴢 𐴃𐴟𐴓𐴞𐴤𐴊𐴞𐴌 𐴊𐴠𐴥؟ 𐴀𐴝𐴣𐴀𐴌𐴝 𐴑𐴞𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴡𐴓𐴟𐴖𐴝𐴌؟<verse eid="1CO 10:22" /></para>
  <para style="s1">𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴉𐴝𐴌𐴠, ”𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴝𐴘𐴠𐴏𐴢,“ 𐴄𐴞𐴥𐴑 𐴈𐴡𐴃𐴝𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴈𐴡𐴀𐴘𐴢 𐴉𐴝𐴙𐴅𐴧𐴟𐴔, ”𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴝𐴘𐴠𐴏𐴢,“ 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴘𐴠 𐴃𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌𐴠 𐴃𐴡𐴌𐴑𐴞 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴡 𐴃𐴟𐴖𐴝𐴘𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝 𐴃𐴟𐴖𐴡.<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />𐴒𐴟𐴏𐴧𐴡𐴌 𐴁𐴝𐴎𐴝𐴌𐴡𐴃𐴢 𐴎𐴞𐴀𐴕 𐴁𐴠𐴏𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴝𐴥𐴘𐴧𐴡; 𐴇𐴠𐴥𐴓𐴡𐴔𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, ”𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴔𐴝𐴁𐴟𐴊𐴡𐴌.“<note caller="+" style="f"><char style="fr" closed="false">10‏:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 24:1">𐴎𐴡𐴁𐴟𐴌 24‏:1</ref></char></char></note><verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴝𐴥𐴕𐴝𐴌 𐴊𐴝𐴖𐴡𐴃𐴢 𐴊𐴠 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴠𐴥 𐴊𐴝𐴖𐴡𐴃𐴢 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴎𐴞𐴀𐴕 𐴊𐴠𐴦 𐴇𐴞𐴥𐴀𐴕 𐴈𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴡; 𐴇𐴠𐴥𐴓𐴡𐴔𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴇𐴡𐴕𐴡𐴤 𐴏𐴟𐴥𐴖𐴝𐴓𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴀𐴕 𐴈𐴡𐴀, ”𐴒𐴟𐴏𐴧𐴡 𐴀𐴞𐴀𐴕 𐴔𐴟𐴃𐴧𐴞𐴌𐴠 𐴂𐴠𐴦𐴐𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥,“ 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴝𐴃𐴝𐴓𐴝𐴘𐴊𐴞𐴘𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴀𐴠𐴊𐴧𐴠 𐴇𐴠𐴥𐴓𐴡𐴔𐴡𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴕𐴝 𐴈𐴝𐴥𐴘𐴧𐴡; <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴕𐴞𐴎𐴡𐴌 𐴇𐴠𐴥𐴓𐴡𐴔𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌 𐴇𐴠𐴥𐴓𐴡𐴔𐴠 𐴑𐴞𐴘𐴝𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴎𐴝𐴊𐴞𐴌 𐴉𐴝𐴥𐴘𐴏𐴠𐴓𐴝 𐴒𐴡𐴙𐴃𐴧𐴡𐴥؟ <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥 𐴇𐴝𐴥𐴘, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴎𐴞𐴀𐴕𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴑𐴞𐴘𐴝𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴡𐴊𐴕𐴝𐴔 𐴀𐴡𐴥𐴘𐴃𐴡؟<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴥𐴀 𐴘𐴝𐴥 𐴉𐴞𐴘𐴡𐴤, 𐴘𐴝𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴠𐴏𐴧𐴟𐴥 𐴒𐴡𐴌𐴡𐴤, 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴡. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴓𐴧𐴝 𐴀𐴡𐴣𐴏𐴝𐴥 𐴕𐴡 𐴁𐴡𐴙𐴕𐴧𐴡; 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴒𐴞𐴌𐴞𐴥𐴑 𐴀𐴡𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴘𐴝𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴓𐴧𐴝, <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥 𐴇𐴝𐴥𐴀𐴌 𐴃𐴡𐴌𐴞𐴑𐴝𐴘𐴠 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴞𐴥. 𐴀𐴝𐴀𐴛 𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝𐴘 𐴕𐴡 𐴃𐴟𐴖𐴝𐴘 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴕𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝𐴘 𐴃𐴟𐴖𐴝𐴘, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴝.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴕𐴡𐴔𐴟𐴕𐴝 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴕𐴡𐴔𐴟𐴕𐴝 𐴔𐴡𐴎𐴞𐴕 𐴏𐴡𐴓𐴞.<verse eid="1CO 11:1" /></para>
  <para style="s1">𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴘𐴡𐴔</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴘𐴝𐴦𐴊𐴢 𐴌𐴝𐴑𐴡𐴥 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴊𐴞𐴘𐴞𐴥 𐴇𐴞𐴥𐴀𐴕 𐴔𐴡𐴎𐴁𐴟𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴡𐴥𐴌𐴞 𐴀𐴝𐴏𐴡𐴤. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴁𐴝𐴃𐴝𐴓𐴝𐴘𐴊𐴞𐴃𐴡 𐴏𐴝𐴀𐴙𐴌, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴌 𐴔𐴝𐴃𐴝𐴥, 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴔𐴝𐴃𐴝𐴥,<note caller="+" style="f"><char style="fr" closed="false">11‏:3 </char><char style="ft" closed="false">𐴘𐴝𐴥 </char><char style="fqa" closed="false">𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴔𐴝𐴃𐴝𐴥 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴡𐴥𐴐𐴡𐴔</char></note> 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴔𐴝𐴃𐴝𐴥. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />𐴎𐴠 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥 𐴒𐴟𐴥𐴌𐴞𐴊𐴞 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥 𐴘𐴝𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴠𐴥. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />𐴀𐴝𐴦𐴌 𐴎𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴀𐴟𐴙𐴊𐴧𐴝 𐴔𐴝𐴃𐴝𐴥 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥 𐴘𐴝𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴠𐴥, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥𐴌𐴠 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴁𐴝𐴌 𐴔𐴝𐴃𐴝𐴥 𐴀𐴠𐴣𐴌𐴝𐴘𐴧𐴝 𐴔𐴝𐴃𐴝𐴥 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />𐴎𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥 𐴒𐴟𐴥𐴌𐴞 𐴕𐴡 𐴌𐴝𐴑𐴠𐴥, 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴓𐴢 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴡𐴗𐴑, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴕𐴞𐴎𐴡𐴌 𐴏𐴟𐴓𐴢 𐴈𐴝𐴍𐴞𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴠 𐴘𐴝𐴥 𐴔𐴝𐴃𐴝𐴥 𐴀𐴠𐴣𐴌𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴃𐴠 𐴇𐴡𐴕𐴡𐴤 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴁𐴠𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴓𐴝𐴒𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥 𐴒𐴟𐴥𐴌𐴞 𐴌𐴝𐴑𐴡𐴥𐴗𐴑.<verse eid="1CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 11:7" />𐴇𐴡𐴕𐴡𐴤 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥 𐴒𐴟𐴥𐴌𐴞 𐴌𐴝𐴑𐴝𐴤𐴌 𐴎𐴡𐴌𐴟𐴌 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝 𐴃𐴡 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴀𐴠𐴥𐴕𐴝 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴀𐴝𐴙𐴐𐴧𐴠𐴥; <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴌𐴠 𐴃𐴡 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴓𐴧𐴝 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴌𐴠 𐴀𐴠𐴥𐴕𐴝 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴓𐴧𐴝 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴓𐴧𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴕𐴞𐴎𐴡𐴌 𐴔𐴝𐴃𐴝𐴥𐴃𐴢 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌𐴡𐴌 𐴔𐴝𐴌𐴇𐴝𐴤 𐴃𐴝𐴥𐴑𐴝𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴡 𐴏𐴝𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠, 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴕𐴡, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴀𐴝𐴎𐴝𐴊𐴢 𐴕𐴡. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴑𐴞 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴃𐴧𐴟 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴖𐴝𐴌 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥 𐴊𐴠 𐴘𐴡𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴖𐴝 𐴃𐴧𐴟. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴠 𐴁𐴝𐴥𐴉𐴞𐴏𐴡: 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴟𐴙𐴊𐴧𐴝 𐴔𐴝𐴃𐴝𐴥 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥 𐴑𐴞𐴥 𐴄𐴞𐴥𐴑؟ <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴠 𐴘𐴡𐴥 𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴕𐴡 𐴐𐴞𐴥𐴑𐴝 𐴕𐴠𐴥, 𐴔𐴡𐴌𐴡𐴃𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴏𐴟𐴓𐴢 𐴓𐴝𐴔𐴁𐴝 𐴌𐴝𐴑𐴡𐴥𐴕 𐴐𐴡𐴥𐴌𐴔𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴊𐴠𐴥؟ <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴠 𐴏𐴟𐴓𐴢 𐴓𐴝𐴔𐴁𐴝 𐴌𐴝𐴑𐴡𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴞𐴎𐴧𐴡𐴙𐴃𐴧𐴝 𐴈𐴝𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴒𐴟𐴥𐴌𐴞 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴏𐴟𐴓𐴢 𐴇𐴞𐴥𐴀𐴕 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴞𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴁𐴝𐴌𐴝𐴤𐴁𐴝𐴌𐴞 𐴊𐴞𐴥𐴃𐴡 𐴏𐴝𐴀, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴎𐴟𐴖𐴝𐴁𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴀𐴕 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤 𐴕𐴞𐴘𐴡𐴔 𐴕𐴝𐴥𐴘, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴘𐴡𐴥 𐴕𐴝𐴥𐴘.<verse eid="1CO 11:16" /></para>
  <para style="s1">𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴈𐴝𐴥𐴕𐴝</para>
  <para style="r">(<ref loc="MAT 26:26-29">𐴔𐴡𐴃𐴢 26‏:26‏-29</ref>; <ref loc="MRK 14:22-25">𐴔𐴝𐴑 14‏:22‏-25</ref>; <ref loc="LUK 22:14-20">𐴓𐴟𐴑 22‏:14‏-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />𐴀𐴝𐴀𐴛 𐴘𐴝𐴓𐴝 𐴎𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴘𐴟𐴔, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴔𐴟𐴃𐴝𐴓𐴠𐴑 𐴀𐴝𐴣𐴀𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴕𐴝𐴥𐴘, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴖𐴝𐴘𐴠 𐴉𐴝𐴥𐴘𐴊𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴓𐴟𐴏𐴧𐴝𐴥𐴕 𐴁𐴞𐴐𐴞𐴤 𐴒𐴡𐴌𐴠𐴥. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />𐴐𐴟𐴥𐴌𐴟𐴌 𐴒𐴝𐴥𐴕 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴝𐴀𐴛 𐴉𐴟𐴥𐴕𐴞𐴌 𐴊𐴠, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴃𐴝𐴥𐴑𐴠. 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴠𐴏𐴧𐴟𐴥 𐴁𐴝𐴥𐴑 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴢 𐴀𐴡𐴥 𐴒𐴡𐴌𐴞𐴥. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴝𐴀𐴄𐴝-𐴉𐴝𐴀𐴄𐴞 𐴀𐴡𐴥𐴕 𐴎𐴡𐴌𐴟𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴃𐴝𐴌𐴝𐴤 𐴏𐴡𐴥𐴘𐴧𐴞𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴘𐴝𐴊𐴒𐴝𐴌𐴞𐴌 𐴈𐴝𐴥𐴕𐴝 𐴈𐴝𐴥𐴘𐴁𐴡𐴓𐴧𐴝 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴕𐴡, <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴈𐴝𐴥𐴘𐴁𐴝𐴐𐴧𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴝𐴒𐴠 𐴎𐴝𐴌-𐴎𐴝𐴌 𐴈𐴝𐴥𐴕𐴝 𐴃𐴠𐴦-𐴃𐴠𐴦 𐴓𐴡𐴦𐴘𐴢 𐴈𐴝𐴥𐴀𐴃𐴢 𐴊𐴡𐴥𐴌𐴡; 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴇𐴡𐴊𐴟𐴥𐴕 𐴁𐴟𐴥𐴑𐴧𐴞 𐴃𐴝𐴥𐴘𐴎𐴝𐴒𐴡𐴘 𐴀𐴝𐴌 𐴇𐴡𐴊𐴟𐴥𐴕 𐴄𐴟𐴀𐴓𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴒𐴡𐴘. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴑𐴞𐴥 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴒𐴡𐴥𐴌 𐴕𐴝𐴥𐴘؟ 𐴕𐴝𐴥𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴌 𐴊𐴠 𐴀𐴝𐴦𐴌 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴝𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴐𐴡𐴥𐴌𐴡𐴔 𐴊𐴡𐴥𐴌 𐴊𐴠𐴥؟ 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴑𐴞𐴦 𐴈𐴡𐴘𐴃𐴝𐴥𐴔؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔 𐴕𐴠𐴥؟ 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴟𐴃𐴝𐴓𐴠𐴑 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴞𐴥, 𐴇𐴞𐴥𐴀𐴕 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴎𐴠 𐴌𐴝𐴙𐴃𐴧𐴝 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴊𐴡𐴥𐴌𐴞𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴇𐴠𐴥 𐴌𐴝𐴙𐴃𐴡𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴌𐴟𐴄𐴞 𐴓𐴡𐴦𐴘𐴢 <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴥𐴚𐴒𐴞 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴘𐴝𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴦, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝. 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴡.“</char> <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴈𐴝𐴥𐴕𐴝 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴞𐴘𐴝𐴓𐴝 𐴘𐴡𐴥 𐴓𐴡𐴦𐴘𐴢 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, <char style="wj">”𐴀𐴝𐴣𐴀𐴌 𐴓𐴡𐴖𐴢 𐴓𐴡𐴘 𐴀𐴡𐴥𐴘𐴁𐴡 𐴊𐴠 𐴕𐴡𐴘𐴝 𐴌𐴝𐴎𐴞𐴕𐴝𐴔𐴝𐴌 𐴕𐴞𐴐𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠 𐴉𐴞𐴘𐴝𐴓𐴝. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴡𐴥𐴁𐴝𐴌 𐴉𐴞𐴀𐴁𐴝, 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴡𐴕𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴉𐴞𐴀𐴘𐴡.“</char> <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴃𐴡𐴥𐴁𐴝𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠 𐴌𐴟𐴄𐴞 𐴈𐴝𐴥𐴘𐴁𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠 𐴉𐴞𐴘𐴝𐴓𐴝𐴃𐴧𐴟 𐴉𐴞𐴀𐴁𐴝, 𐴇𐴠𐴥𐴃𐴡𐴁𐴝𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴀𐴠𐴓𐴝𐴕 𐴒𐴡𐴌𐴡𐴤𐴌 𐴊𐴠, 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴕𐴞𐴥𐴑𐴞 𐴀𐴞𐴥𐴁𐴝 𐴕𐴟𐴥 𐴀𐴝𐴘𐴧𐴠𐴤.<verse eid="1CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴕𐴝𐴓𐴝𐴦𐴘𐴠𐴑 𐴀𐴝𐴇𐴝𐴥𐴓𐴝𐴑𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴌𐴟𐴄𐴞 𐴈𐴝𐴥𐴀 𐴘𐴝𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴞𐴘𐴝𐴓𐴝𐴃𐴧𐴟 𐴉𐴞𐴀𐴘𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴒𐴝𐴦 𐴀𐴠𐴊𐴧𐴠 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴞𐴁𐴡. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴇𐴠𐴥 𐴌𐴟𐴄𐴞 𐴈𐴝𐴥𐴘𐴁𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴘𐴝𐴓𐴝𐴃𐴧𐴟 𐴉𐴞𐴀𐴁𐴝𐴌 𐴀𐴝𐴒𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴃𐴝𐴇𐴝𐴥𐴑𐴞𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴏𐴡𐴗𐴀𐴑. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴒𐴝𐴦𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴞𐴥 𐴇𐴠𐴥 𐴌𐴟𐴄𐴞 𐴈𐴝𐴥𐴀 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴘𐴝𐴓𐴝𐴃𐴧𐴟 𐴉𐴞𐴀𐴘𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴈𐴡𐴥𐴀𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴀𐴘𐴡𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴖𐴡𐴌𐴠 𐴏𐴝𐴥𐴣𐴎𐴝 𐴀𐴝𐴕𐴞𐴤𐴁𐴡. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴑𐴡𐴔𐴎𐴟𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴘𐴝𐴌𐴝𐴙𐴔𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴁𐴡𐴀𐴗𐴃𐴢 𐴎𐴡𐴕 𐴔𐴡𐴦𐴃𐴡𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴁𐴞𐴏𐴝𐴌 𐴕𐴞𐴎𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡 𐴉𐴡𐴙𐴃𐴧𐴡. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴞𐴥 𐴃𐴡𐴌𐴁𐴞𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴕𐴡 𐴄𐴡𐴥𐴀𐴌𐴞.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴈𐴝𐴥𐴘𐴃𐴡 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥, 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴕𐴃𐴠𐴎𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴘𐴡. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴁𐴟𐴥𐴑 𐴓𐴝𐴒𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴒𐴡𐴥𐴌𐴡𐴃𐴧𐴟 𐴈𐴝𐴥𐴕𐴝 𐴇𐴝𐴥𐴘 𐴎𐴝𐴘𐴧𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴈𐴡𐴏𐴟𐴥𐴌𐴁𐴡𐴕 𐴄𐴡𐴥𐴀𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘𐴧𐴡 𐴉𐴝𐴥𐴕 𐴕𐴡.</para>
  <para style="p" vid="1CO 11:34">𐴀𐴝𐴦𐴌 𐴁𐴝𐴊𐴁𐴝𐴑𐴞 𐴔𐴝𐴦𐴔𐴠𐴓𐴝 𐴒𐴟𐴥𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴓𐴠𐴤 𐴈𐴡𐴘𐴧𐴟𐴥𐴔.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s1">𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥: 𐴀𐴝𐴀𐴛 𐴕𐴡 𐴏𐴝𐴀𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴡𐴎𐴝𐴕𐴝 𐴃𐴝𐴥𐴑𐴡. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴊𐴞𐴕𐴞 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴟𐴒𐴝 𐴔𐴟𐴃𐴧𐴞𐴌 𐴀𐴟𐴎𐴟 𐴎𐴠𐴦 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴡𐴘𐴎𐴝𐴘𐴃𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴎𐴝𐴘𐴃𐴝𐴒𐴡𐴥𐴘. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴊𐴠 𐴑𐴞, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀, 𐴀𐴞𐴥𐴃𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴡 𐴈𐴡𐴀 𐴊𐴠, ”𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴓𐴝𐴀𐴕𐴡𐴃𐴢 𐴀𐴡𐴥𐴑,“ 𐴀𐴝𐴦𐴌 𐴂𐴝𐴑-𐴌𐴟𐴀𐴌 𐴇𐴠𐴥𐴊𐴝𐴘𐴧𐴡𐴃𐴢 𐴏𐴝𐴥𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴑𐴞, ”𐴀𐴞𐴏𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴝𐴓𐴞𐴑.“<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴃𐴡 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴊𐴠𐴦 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴞𐴤 𐴌𐴟𐴀 𐴘𐴠. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴌𐴞𐴑𐴝 𐴘𐴡𐴥 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴑𐴞𐴤 𐴔𐴝𐴓𐴞𐴑 𐴀𐴡𐴌𐴠. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴈𐴝𐴔 𐴀𐴡𐴥 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴠𐴑𐴞𐴤 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴁𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥.<verse eid="1CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 12:7" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴕-𐴎𐴡𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴌𐴟𐴀𐴌 𐴎𐴝𐴇𐴠𐴥𐴌𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝𐴓𐴧𐴝 𐴁𐴠 𐴀𐴡𐴥. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />𐴇𐴠𐴥 𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴒𐴞𐴘𐴝𐴕𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝; 𐴇𐴠𐴥 𐴀𐴠𐴑𐴞𐴤 𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴌 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴀𐴝𐴇𐴡𐴓𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴇𐴠𐴥 𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴞𐴔𐴝𐴕 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝, 𐴀𐴝𐴌 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴇𐴠𐴥 𐴀𐴠𐴑𐴞𐴤 𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌, 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴁𐴝𐴥𐴌, 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴌𐴟𐴀 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴡𐴌𐴡𐴥𐴑 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌, 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴁𐴝𐴥𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴑𐴞𐴘𐴡𐴥𐴌𐴠 𐴇𐴠𐴥 𐴎𐴟𐴁𐴝𐴕 𐴁𐴝𐴥𐴚𐴒𐴞𐴊𐴞𐴁𐴝𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴠𐴥 𐴀𐴠𐴑𐴞𐴤 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴌𐴟𐴀𐴌 𐴈𐴝𐴔. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴎𐴝𐴌𐴠𐴥 𐴎𐴠 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴊𐴞𐴦𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀 𐴇𐴠𐴥 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴊𐴠𐴦.<verse eid="1CO 12:11" /></para>
  <para style="s1">𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴝𐴦 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴞𐴐𐴞𐴤 𐴇𐴞𐴥𐴏𐴧𐴝</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴝𐴦𐴃𐴢 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴓𐴡𐴥𐴘 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴝𐴦 𐴁𐴡𐴕𐴠, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴒𐴞𐴌𐴞𐴥𐴑, 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴁𐴠𐴒𐴟𐴓𐴝𐴔, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴃𐴡 𐴀𐴠𐴑 𐴒𐴝𐴦 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴑𐴞𐴤 𐴌𐴟𐴀𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴘𐴧𐴞𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴠𐴑𐴞𐴤 𐴌𐴟𐴀 𐴉𐴝𐴘𐴧𐴞𐴥. <verse eid="1CO 12:13" /><verse number="14" style="v" sid="1CO 12:14" />𐴒𐴝𐴦𐴃𐴢 𐴃𐴡 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴁𐴞𐴐𐴞𐴤.<verse eid="1CO 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 12:15" />𐴄𐴠𐴥𐴚𐴡𐴌 𐴉𐴝𐴃𐴝𐴘𐴠 𐴎𐴡𐴊𐴞 𐴈𐴡𐴀, ”𐴀𐴝𐴀𐴛 𐴀𐴝𐴥𐴃𐴢 𐴕𐴡 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴒𐴝𐴦𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴕𐴡,“ 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴝𐴦𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴕𐴡 𐴊𐴠 𐴇𐴠𐴥𐴀𐴕 𐴕𐴡. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴈𐴝𐴕𐴠 𐴈𐴡𐴀, ”𐴀𐴝𐴀𐴛 𐴏𐴟𐴑 𐴕𐴡 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴒𐴝𐴦𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴕𐴡,“ 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴒𐴝𐴦𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴕𐴡 𐴊𐴠 𐴇𐴠𐴥𐴀𐴕 𐴕𐴡. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />𐴒𐴟𐴣𐴍𐴝 𐴒𐴝𐴦 𐴎𐴡𐴊𐴞 𐴏𐴟𐴑 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴉𐴟𐴥𐴙𐴕𐴃𐴡 𐴇𐴡𐴕𐴃𐴟𐴤؟ 𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴒𐴟𐴣𐴍𐴝 𐴒𐴝𐴦 𐴈𐴝𐴕 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴉𐴟𐴥𐴀𐴟𐴛 𐴉𐴝𐴙𐴃𐴧𐴡 𐴇𐴡𐴕𐴃𐴟𐴤؟ <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴇𐴞𐴥𐴏𐴧𐴝 𐴇𐴞𐴥𐴀𐴕 𐴉𐴡𐴃𐴧𐴞𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴌𐴠 𐴒𐴝𐴦𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴖𐴡𐴀𐴣𐴃𐴢-𐴖𐴡𐴀𐴣𐴃𐴢 𐴌𐴝𐴙𐴑𐴧𐴠𐴥 𐴎𐴞𐴘𐴡𐴥𐴣𐴃𐴢-𐴎𐴞𐴘𐴡𐴥𐴣𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴃𐴧𐴟 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴧𐴠𐴥. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />𐴎𐴡𐴊𐴞 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴘𐴃𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴒𐴝𐴦 𐴇𐴡𐴍𐴠𐴥 𐴀𐴡𐴥𐴘𐴃𐴡؟ <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴃𐴡 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴠𐴤, 𐴓𐴠𐴑𐴞𐴕 𐴒𐴝𐴦 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴏𐴟𐴑𐴠𐴤 𐴀𐴝𐴥𐴃𐴡𐴌𐴠 𐴈𐴡𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴡𐴌 𐴎𐴡𐴌𐴟𐴌 𐴕𐴝𐴥𐴘,“ 𐴀𐴝𐴦𐴌 𐴔𐴝𐴃𐴝𐴥𐴘𐴠 𐴄𐴠𐴥𐴚𐴡𐴌 𐴉𐴝𐴃𐴝𐴌𐴠 𐴈𐴡𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞𐴁𐴡𐴥 𐴊𐴠, ”𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴡𐴌 𐴎𐴡𐴌𐴟𐴌 𐴕𐴝𐴥𐴘.“ <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />𐴇𐴝𐴥𐴓𐴠𐴑𐴠, 𐴒𐴝𐴦𐴌 𐴎𐴠 𐴇𐴞𐴥𐴏𐴧𐴝 𐴒𐴟𐴥𐴕 𐴏𐴝𐴘𐴃𐴠𐴥 𐴑𐴡𐴔𐴎𐴟𐴌, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴌𐴟𐴌𐴞, <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />𐴀𐴝𐴦𐴌 𐴒𐴝𐴦𐴌 𐴎𐴠 𐴇𐴞𐴥𐴏𐴧𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴈𐴡𐴔 𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴁𐴡𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴞, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴊𐴞. 𐴎𐴠 𐴇𐴞𐴥𐴏𐴧𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴐𐴡𐴥𐴌𐴡𐴔𐴠 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴑𐴞𐴥, 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴃𐴧𐴡𐴕𐴠 𐴒𐴟𐴥𐴌𐴞 𐴌𐴝𐴑𐴞𐴥, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴇𐴞𐴥𐴏𐴧𐴝 𐴒𐴟𐴥𐴕𐴡𐴌𐴠 𐴎𐴡𐴃𐴧𐴡𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴎𐴡𐴌𐴟𐴌 𐴕𐴝𐴥𐴘. 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴒𐴝𐴦𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞𐴥-𐴒𐴡𐴌𐴞𐴥 𐴔𐴞𐴓𐴝𐴘 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴎𐴠 𐴇𐴞𐴥𐴏𐴧𐴝 𐴒𐴟𐴥𐴕 𐴈𐴡𐴔 𐴀𐴞𐴎𐴧𐴡𐴃𐴞 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴊𐴞𐴘𐴝 𐴉𐴡𐴌𐴠; <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />𐴎𐴠𐴀𐴕𐴠 𐴒𐴝𐴦𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴕𐴝-𐴀𐴠𐴑𐴃𐴡𐴉𐴝𐴥𐴑𐴞 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴎𐴠𐴕 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴠 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴌𐴝𐴑𐴠𐴥. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴇𐴞𐴥𐴏𐴧𐴝𐴘𐴠 𐴊𐴟𐴑 𐴉𐴝𐴘𐴓𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴞𐴥𐴏𐴧𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴊𐴟𐴑 𐴉𐴝𐴦. 𐴀𐴝𐴦𐴌 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴇𐴞𐴥𐴏𐴧𐴝𐴘𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴉𐴝𐴘𐴓𐴠, 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴞𐴥𐴏𐴧𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />𐴃𐴡𐴥𐴘 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴡𐴥𐴘𐴓𐴝𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴒𐴝𐴦, 𐴀𐴝𐴦𐴌 𐴉𐴡𐴃𐴧𐴞𐴥 𐴎𐴡𐴕 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴇𐴞𐴥𐴏𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴀𐴝𐴓𐴡𐴑-𐴀𐴝𐴓𐴡𐴑 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴙𐴓𐴧𐴠𐴥: 𐴀𐴠𐴑 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴃𐴢 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴊𐴟𐴘 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴃𐴢 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴞𐴕 𐴕𐴡𐴔𐴁𐴡𐴥𐴌𐴡𐴃𐴢 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢. 𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴃𐴟𐴙𐴓𐴧𐴠𐴥 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴔𐴡𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴃𐴧𐴟 𐴋𐴡𐴙𐴓𐴧𐴝-𐴁𐴡𐴋𐴡𐴙𐴓𐴧𐴝 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴑𐴞𐴥 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴕𐴠𐴥؟ 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴑𐴞𐴥 𐴕𐴡𐴁𐴞 𐴕𐴠𐴥؟ 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴑𐴞𐴥 𐴀𐴟𐴏𐴃𐴝𐴃𐴢 𐴕𐴠𐴥؟ 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴑𐴞𐴥 𐴑𐴠𐴌𐴝𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴕𐴠𐴥؟ <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴧𐴟 𐴑𐴞𐴥 𐴁𐴞𐴘𐴝𐴌𐴝𐴔 𐴒𐴡𐴔 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤؟ 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴑𐴞𐴥 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀؟ 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴑𐴞𐴥 𐴎𐴟𐴁𐴝𐴕 𐴁𐴝𐴥𐴚𐴒𐴞𐴊𐴞 𐴉𐴝𐴌𐴠؟ <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴟𐴀𐴙𐴕𐴡𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴞𐴀𐴕 𐴋𐴡𐴣𐴀𐴌.</para>
  <para style="p" vid="1CO 12:31">𐴃𐴡𐴀 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴌𐴡𐴤 𐴁𐴞𐴐𐴞𐴤 𐴁𐴝𐴥𐴓𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴌𐴝𐴏𐴃𐴝 𐴊𐴝𐴈𐴝𐴤𐴘 𐴊𐴞𐴥𐴌.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s1">𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝𐴌 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴘𐴢 𐴉𐴝𐴌𐴞, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴁𐴝𐴎𐴝𐴘𐴓𐴠𐴥 𐴀𐴟𐴎𐴡𐴌 𐴀𐴡𐴥 𐴊𐴠 𐴁𐴟𐴥𐴚𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴘𐴝𐴥 𐴁𐴝𐴎𐴝 𐴊𐴠 𐴎𐴟𐴌𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴀𐴠𐴥𐴕𐴝. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴀𐴛 𐴃𐴝𐴔𐴝𐴥𐴔 𐴒𐴟𐴉𐴡𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴟𐴎𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴌𐴡𐴤 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴉𐴝𐴀𐴌 𐴓𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴝𐴘 𐴉𐴝𐴌𐴠 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴞𐴔𐴝𐴕 𐴃𐴝𐴥𐴑𐴠, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴀𐴛 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴀𐴝𐴣𐴀𐴌 𐴐𐴡𐴥𐴔𐴁𐴡𐴃𐴧𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴏𐴡𐴥𐴃𐴑𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴦𐴌𐴠 𐴉𐴟𐴌𐴝𐴃𐴢 𐴊𐴞 𐴁𐴡𐴓𐴧𐴝 𐴊𐴞𐴦𐴉𐴠𐴥𐴓𐴝𐴘, 𐴓𐴠𐴑𐴞𐴕 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴇𐴡𐴕𐴡𐴤 𐴉𐴝𐴥𐴘𐴊𐴝𐴘 𐴕𐴝𐴥𐴘.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴡𐴁𐴡𐴥𐴌, 𐴀𐴝𐴦𐴌 𐴔𐴠𐴀𐴌𐴁𐴝𐴕. 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴇𐴝𐴥𐴏𐴡𐴌𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥 𐴀𐴝𐴦𐴌 𐴉𐴡𐴇𐴡𐴥𐴌𐴝𐴘 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴁𐴞𐴘𐴝𐴊𐴡𐴉𐴞 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥; 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴡 𐴃𐴟𐴖𐴝, 𐴎𐴠𐴦𐴕𐴃𐴠𐴕 𐴒𐴟𐴐𐴧𐴝𐴤 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴈𐴡𐴥𐴌𐴝𐴉𐴞 𐴊𐴞𐴓𐴡𐴃𐴢 𐴕𐴡 𐴌𐴝𐴑𐴠𐴥. <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴈𐴡𐴥𐴌𐴝𐴉𐴞𐴃𐴢 𐴑𐴟𐴥𐴐𐴞 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴖𐴡𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴠𐴥. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴐𐴡𐴥𐴀, 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴠𐴑𐴞𐴕 𐴒𐴡𐴌𐴠𐴥, 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴃𐴢 𐴀𐴝𐴐𐴝𐴤 𐴌𐴝𐴑𐴠𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴒𐴡𐴌𐴠𐴥.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴇𐴡𐴕𐴡𐴤𐴊𐴞𐴕 𐴇𐴡𐴥𐴃𐴡𐴔 𐴕𐴡; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴃𐴝𐴥𐴑𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴁𐴡𐴕 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴎𐴡𐴊𐴞 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴃𐴡𐴖𐴉𐴞𐴥𐴑 𐴃𐴝𐴥𐴑𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥 𐴁𐴡𐴕 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴀𐴠𐴓𐴡𐴥𐴔 𐴃𐴝𐴥𐴑𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴌𐴝𐴘𐴎𐴝𐴘𐴁𐴡𐴘. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴕𐴡 𐴎𐴝𐴕𐴞, 𐴀𐴝𐴦𐴌 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴘𐴡𐴥 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴘𐴢 𐴕𐴡 𐴉𐴝𐴌𐴞; <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴈𐴡𐴔𐴞 𐴒𐴟𐴥𐴕 𐴇𐴡𐴥𐴃𐴡𐴔 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘. <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />𐴀𐴝𐴀𐴛 𐴒𐴟𐴌𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢, 𐴒𐴟𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴃𐴝𐴥𐴔, 𐴒𐴟𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴁𐴝𐴥𐴉𐴞𐴃𐴝𐴔, 𐴀𐴠𐴊𐴧𐴠 𐴒𐴟𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴋𐴡𐴣𐴀𐴌 𐴀𐴡𐴥𐴘𐴧𐴞, 𐴀𐴝𐴀𐴛 𐴒𐴟𐴌𐴝𐴇𐴝𐴓𐴡𐴌 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴞. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />𐴀𐴠𐴇𐴡𐴥𐴕 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴘𐴕𐴝𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴔𐴞𐴘𐴟𐴥𐴕𐴊𐴝 𐴒𐴡𐴥𐴌𐴞 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝 𐴉𐴝𐴥𐴚𐴒𐴡𐴌𐴞 𐴀𐴠𐴥𐴕𐴝 𐴊𐴠𐴑𐴞𐴥𐴌; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴔𐴟𐴀𐴝𐴥𐴔𐴟𐴙𐴑𐴧𐴝 𐴊𐴠𐴑𐴞𐴥𐴘𐴟𐴔. 𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴛 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴕𐴡 𐴎𐴝𐴕𐴞, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴝𐴀𐴛 𐴀𐴠𐴀𐴕 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴎𐴝𐴕𐴞𐴘𐴟𐴥𐴔 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴒𐴡𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴎𐴝𐴕𐴠.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />𐴇𐴠𐴥 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴀𐴞𐴔𐴝𐴕, 𐴀𐴝𐴐𐴝𐴤, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢, 𐴀𐴠 𐴃𐴞𐴕𐴞𐴥𐴘𐴝𐴕 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴠; 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴁𐴧𐴠 𐴋𐴡𐴣𐴀𐴌 𐴒𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s1">𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴝𐴥</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴉𐴞𐴏𐴝𐴥 𐴊𐴡𐴌𐴡, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴘𐴡𐴥 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴡𐴤, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴓𐴧𐴝. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴈𐴡𐴀 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴈𐴡𐴀 𐴊𐴠. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴃𐴡 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴡 𐴁𐴟𐴎𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴒𐴟𐴉𐴡𐴕 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴌𐴟𐴀𐴌 𐴁𐴡𐴓𐴠. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴠 𐴈𐴡𐴀, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴡𐴌𐴑𐴞 𐴀𐴡𐴥, 𐴁𐴡𐴓𐴢 𐴉𐴝𐴦, 𐴀𐴠𐴊𐴧𐴠 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞 𐴉𐴝𐴦. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴁𐴠 𐴃𐴡𐴌𐴑𐴞 𐴒𐴡𐴌𐴠𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴠𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴁𐴠 𐴃𐴡𐴌𐴑𐴞 𐴒𐴡𐴌𐴠𐴥. <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />𐴀𐴝𐴀𐴛 𐴏𐴝𐴀𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴠𐴦𐴐𐴇𐴞𐴥𐴏𐴧𐴝 𐴘𐴝𐴀𐴕 𐴏𐴝𐴀𐴘𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴡𐴤. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀, 𐴎𐴡𐴊𐴞 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴃𐴡𐴌𐴑𐴞𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴥𐴚𐴒𐴞 𐴕𐴡 𐴊𐴠𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴋𐴡𐴣𐴀𐴌.<verse eid="1CO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴘𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴡𐴥𐴘𐴧𐴞𐴌 𐴎𐴝𐴇𐴠𐴥𐴌𐴞𐴌 𐴈𐴡𐴃𐴝𐴤, 𐴘𐴝𐴥 𐴎𐴝𐴕𐴑𐴝𐴌𐴞𐴌 𐴈𐴡𐴃𐴝𐴤, 𐴘𐴝𐴥 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴞𐴦𐴘𐴝 𐴈𐴡𐴃𐴝𐴤, 𐴘𐴝𐴥 𐴃𐴝𐴦𐴓𐴞𐴔𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴡 𐴈𐴡𐴀𐴘𐴢, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴞𐴦 𐴉𐴝𐴥𐴘𐴊𐴝 𐴉𐴝𐴘𐴁𐴝؟ <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />𐴑𐴞 𐴁𐴝𐴐𐴞𐴤 𐴑𐴞 𐴁𐴞𐴕𐴝, 𐴇𐴠𐴥 𐴎𐴝𐴕 𐴏𐴝𐴥𐴌𐴝 𐴅𐴞𐴕𐴞𐴥𐴐𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴃𐴧𐴟 𐴎𐴡𐴊𐴞 𐴀𐴝𐴁𐴝𐴏𐴢 𐴕𐴠𐴦𐴙𐴓𐴃𐴠 𐴀𐴝𐴓𐴡𐴑-𐴀𐴝𐴓𐴡𐴑 𐴀𐴝𐴁𐴝𐴏𐴢 𐴕𐴡 𐴕𐴠𐴦𐴙𐴓𐴃𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴁𐴝𐴐𐴞𐴤𐴃𐴢 𐴘𐴝𐴥 𐴁𐴞𐴕𐴝𐴃𐴢 𐴑𐴞𐴦 𐴁𐴝𐴎𐴝𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴏𐴞𐴕𐴝𐴥 𐴎𐴝𐴘𐴃𐴡؟ <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />𐴐𐴞𐴥𐴛𐴝𐴘𐴠 𐴎𐴡𐴊𐴞 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴐𐴞𐴥𐴛𐴝𐴌 𐴀𐴝𐴁𐴝𐴏𐴢 𐴕𐴡 𐴊𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴓𐴝𐴌𐴝𐴥𐴘 𐴓𐴧𐴝 𐴇𐴡𐴕𐴠 𐴃𐴡𐴘𐴧𐴝𐴌 𐴀𐴡𐴥𐴘𐴁𐴡؟ <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴎𐴡𐴊𐴞 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴠 𐴕𐴡 𐴁𐴟𐴎𐴠𐴥 𐴊𐴠 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴁𐴟𐴎𐴝𐴥 𐴎𐴝𐴘𐴁𐴡؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴁𐴡𐴘𐴧𐴝𐴌 𐴓𐴡𐴘 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴌 𐴉𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴁𐴡. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />𐴁𐴠𐴐𐴡𐴥𐴑, 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴔𐴝𐴎𐴠𐴥 𐴁𐴠𐴐𐴝𐴤𐴁𐴞𐴐𐴞𐴤 𐴎𐴟𐴁𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴑𐴒𐴗𐴝𐴥 𐴘𐴡𐴥 𐴔𐴝𐴀𐴕𐴞 𐴏𐴝𐴥𐴌𐴝 𐴕𐴡. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴎𐴠 𐴎𐴟𐴁𐴝𐴕 𐴈𐴡𐴀𐴌 𐴇𐴠𐴥 𐴎𐴟𐴁𐴝𐴕 𐴕𐴡 𐴁𐴟𐴎𐴞𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴛 𐴁𐴞𐴊𐴠𐴐𐴡𐴥𐴙𐴃𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴁𐴞𐴊𐴠𐴐𐴡𐴥𐴙𐴃𐴧𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴘𐴝𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴘𐴡𐴥 𐴇𐴝𐴥𐴍𐴠. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴎𐴧𐴟 𐴀𐴝𐴏𐴠𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴘𐴝𐴔𐴡𐴃𐴡𐴓𐴧𐴝 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴑𐴟𐴐𐴞𐴥𐴐𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴞𐴀𐴕𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴃𐴡𐴌𐴑𐴞 𐴒𐴡𐴌𐴠𐴥.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴥𐴚𐴒𐴞𐴊𐴞 𐴉𐴝𐴌𐴞 𐴁𐴡𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴡𐴥𐴗𐴑. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴡𐴊𐴞 𐴀𐴝𐴀𐴛 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌 𐴌𐴟𐴀𐴘𐴠 𐴀𐴠𐴥𐴕𐴝 𐴒𐴡𐴌𐴠𐴥𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴣𐴀𐴌 𐴔𐴡𐴕𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥𐴌. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴑𐴞𐴦 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌؟ 𐴀𐴝𐴀𐴛 𐴌𐴟𐴀𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴘𐴡𐴥 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔, 𐴔𐴡𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴘𐴡𐴥 𐴊𐴟𐴖𐴝 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔. 𐴀𐴝𐴀𐴛 𐴌𐴟𐴀𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴘𐴡𐴥 𐴏𐴠𐴀𐴌 𐴒𐴝𐴘𐴧𐴟𐴥𐴔, 𐴔𐴡𐴕𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴘𐴡𐴥 𐴏𐴠𐴀𐴌 𐴒𐴝𐴘𐴧𐴟𐴥𐴔. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠, 𐴎𐴡𐴊𐴞 𐴃𐴟𐴀𐴛 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴌𐴟𐴀𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴝𐴦𐴌𐴞𐴉𐴢 𐴒𐴡𐴌𐴡𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴐𐴝𐴥𐴊𐴝𐴌𐴝𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 ”𐴀𐴝𐴦𐴔𐴞𐴕“ 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴀𐴘𐴢 𐴉𐴝𐴌𐴞𐴁𐴡𐴥؟ 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴡 𐴃𐴟𐴀𐴛 𐴑𐴞𐴦 𐴈𐴡𐴀𐴌 𐴊𐴠 𐴕𐴡 𐴁𐴟𐴎𐴠𐴥𐴌. <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴃𐴟𐴀𐴛 𐴐𐴟𐴥𐴕𐴊𐴡𐴌𐴒𐴡𐴌𐴞 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴡𐴤𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕 𐴃𐴡𐴌𐴑𐴞 𐴕𐴡 𐴀𐴡𐴥𐴌.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />𐴀𐴝𐴀𐴛 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴈𐴡𐴀𐴘𐴢. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴊𐴡𐴐𐴢 𐴀𐴝𐴥𐴎𐴝𐴌 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡, 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴕𐴡𐴌𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴁𐴟𐴎𐴝𐴥 𐴎𐴝 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴝𐴣𐴏𐴢 𐴏𐴝𐴥𐴕 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴖𐴝𐴤 𐴁𐴝𐴏𐴞𐴥𐴘𐴟𐴔.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />𐴀𐴡𐴥 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕, 𐴁𐴟𐴎𐴝𐴥𐴃𐴢 𐴉𐴟𐴀𐴝𐴙𐴕 𐴕𐴡 𐴁𐴡𐴙𐴕𐴧𐴡. 𐴁𐴟𐴌𐴝𐴙𐴃𐴢 𐴒𐴟𐴌𐴝 𐴉𐴟𐴀𐴝𐴙𐴕 𐴁𐴡𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴟𐴎𐴝𐴥𐴃𐴢 𐴁𐴝𐴓𐴡𐴑 𐴀𐴡𐴥. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴡𐴃𐴢 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴓𐴠𐴙𐴑𐴧𐴝𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴝𐴁𐴟𐴊𐴠 𐴉𐴡𐴥𐴌𐴔𐴝𐴌 𐴊𐴠,</para>
  <para style="q1" vid="1CO 14:21">”𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴀𐴡𐴏𐴞𐴕 𐴎𐴟𐴁𐴝𐴕𐴠</para>
  <para style="q2" vid="1CO 14:21">𐴀𐴠𐴊𐴧𐴠 𐴁𐴞𐴊𐴠𐴐𐴡𐴥𐴙𐴃𐴧𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴟𐴑𐴠𐴥</para>
  <para style="q1" vid="1CO 14:21">𐴀𐴝𐴀𐴛 𐴀𐴠 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴃𐴝𐴌𐴝𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴘𐴧𐴟𐴥𐴔,</para>
  <para style="q2" vid="1CO 14:21">𐴀𐴝𐴦𐴌 𐴃𐴡𐴀 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴀𐴞𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴉𐴟𐴥𐴕𐴞𐴁𐴡.“<note caller="+" style="f"><char style="fr" closed="false">14‏:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 28:11">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 28‏:11</ref>‏,<ref loc="ISA 28:12">12</ref></char></char></note><verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴁𐴟𐴎𐴝𐴥 𐴎𐴝𐴌 𐴊𐴠, 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴕𐴞𐴐𐴝𐴥𐴕, 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴕𐴡. 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴝𐴥 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴓𐴧𐴝, 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴕𐴡. <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴎𐴡𐴊𐴞 𐴉𐴟𐴌𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴠𐴑 𐴎𐴝𐴒𐴝𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥𐴘 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴁𐴝𐴀𐴌𐴒𐴗𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴘𐴝𐴥 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴞𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴡𐴦𐴓𐴢 𐴕𐴡 𐴈𐴡𐴘𐴁𐴡𐴤 𐴕𐴠𐴥؟ <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴕𐴡𐴤 𐴒𐴝𐴙𐴌𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴘𐴝𐴥 𐴁𐴝𐴀𐴌𐴒𐴗𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴈𐴡𐴃𐴝𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴠 𐴒𐴟𐴕𐴝𐴤𐴒𐴝𐴌 𐴊𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴉𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴞𐴏𐴝𐴌 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴊𐴞𐴓𐴡𐴌 𐴒𐴟𐴉𐴡𐴕𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘; 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴟𐴣𐴀𐴘𐴃𐴡𐴘 𐴉𐴡𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴏𐴡𐴥𐴘𐴊𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴡 𐴀𐴝𐴦𐴌 𐴈𐴡𐴘𐴁𐴡𐴤 𐴊𐴠, ”𐴀𐴝𐴓𐴧𐴝 𐴏𐴡𐴥𐴘𐴧𐴞-𐴏𐴡𐴥𐴘𐴧𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴡𐴌𐴔𐴞𐴘𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.“<verse eid="1CO 14:25" /></para>
  <para style="s1">𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴕𐴞𐴘𐴡𐴔-𐴕𐴞𐴘𐴡𐴔𐴠 𐴀𐴡𐴥𐴕 𐴎𐴡𐴌𐴟𐴌</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴑𐴞𐴦 𐴀𐴡𐴥𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥؟ 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴠𐴑𐴧𐴝𐴥𐴕𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴞𐴘𐴡𐴥𐴃𐴧𐴟 𐴏𐴠𐴀𐴌 𐴃𐴝𐴥𐴑𐴠, 𐴑𐴞𐴘𐴡𐴥𐴃𐴧𐴟 𐴃𐴝𐴦𐴓𐴞𐴔 𐴃𐴝𐴥𐴑𐴠, 𐴑𐴞𐴘𐴡𐴥𐴃𐴧𐴟 𐴖𐴝𐴈𐴞𐴤 𐴃𐴝𐴥𐴑𐴠, 𐴑𐴞𐴘𐴡𐴥𐴃𐴧𐴟 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕 𐴃𐴝𐴥𐴑𐴠, 𐴀𐴝𐴦𐴌 𐴑𐴞𐴘𐴡𐴥𐴃𐴧𐴟 𐴇𐴠𐴥 𐴎𐴟𐴁𐴝𐴕 𐴁𐴝𐴥𐴚𐴒𐴞 𐴊𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴥𐴑𐴠. 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴃𐴡𐴌𐴑𐴞𐴓𐴧𐴝 𐴀𐴡𐴥𐴖𐴝𐴌 𐴎𐴡𐴌𐴟𐴌. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />𐴎𐴡𐴊𐴞 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀, 𐴊𐴟𐴘 𐴎𐴡𐴕𐴠 𐴘𐴝𐴥 𐴁𐴞𐴐𐴞𐴤𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴃𐴞𐴕 𐴎𐴡𐴕𐴠 𐴈𐴡𐴀𐴗𐴑; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴠𐴑𐴎𐴡𐴕 𐴒𐴡𐴌𐴞 𐴈𐴡𐴀𐴗𐴑, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴌 𐴀𐴠𐴑𐴎𐴡𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴁𐴝𐴥𐴚𐴒𐴞𐴊𐴡𐴖𐴑; <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴁𐴝𐴥𐴚𐴒𐴞𐴊𐴡𐴘𐴝 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴕𐴞𐴎𐴝𐴥𐴔 𐴔𐴝𐴥𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑; 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴡𐴘 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴓𐴧𐴝 𐴓𐴧𐴡𐴘 𐴈𐴡𐴀𐴗𐴑.<verse eid="1CO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴘 𐴎𐴡𐴕𐴠 𐴘𐴝𐴥 𐴃𐴞𐴕 𐴎𐴡𐴕𐴠 𐴈𐴡𐴀𐴗𐴑, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴌𐴒𐴟𐴥𐴕𐴠 𐴇𐴞𐴥𐴀𐴕 𐴃𐴝𐴊𐴝𐴌𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴏𐴡𐴗𐴀𐴑. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴇𐴠𐴥𐴍𐴠 𐴁𐴡𐴀𐴘𐴢 𐴃𐴝𐴥𐴙𐴑𐴧𐴠 𐴊𐴠 𐴀𐴠𐴥𐴎𐴧𐴡𐴕𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴡𐴕𐴡𐴤 𐴖𐴝𐴈𐴞𐴤 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴈𐴡𐴀𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴕𐴞𐴎𐴝𐴥𐴔 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴧𐴡𐴘. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴀𐴠𐴑𐴎𐴡𐴕 𐴀𐴠𐴑𐴎𐴡𐴕 𐴒𐴡𐴌𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞𐴁𐴝𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴐𐴞𐴥𐴑𐴠 𐴀𐴝𐴦𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴠 𐴅𐴡𐴏𐴁𐴝 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴌𐴟𐴀 𐴃𐴡 𐴕𐴡𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴑𐴡𐴁𐴎𐴝𐴃𐴢 𐴀𐴠𐴥𐴕𐴝 𐴃𐴝𐴥𐴑𐴠. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴓𐴧𐴝 𐴃𐴡 𐴐𐴟𐴥𐴑𐴐𐴝𐴑𐴡𐴌 𐴀𐴝𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴌, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴑𐴞 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤.<verse eid="1CO 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CO 14:34" />𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴕𐴞𐴎𐴝𐴥𐴔 𐴔𐴝𐴥𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴃𐴞𐴁𐴝𐴥𐴌 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴕𐴝𐴥𐴘, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴡𐴥𐴌𐴔𐴝𐴊𐴝𐴌 𐴃𐴝𐴥𐴑𐴡𐴗𐴑, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴠 𐴘𐴡𐴥 𐴈𐴡𐴀. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />𐴎𐴡𐴊𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴐𐴞𐴥𐴑𐴞𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴃𐴧𐴟 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴔𐴝𐴥𐴎𐴠 𐴉𐴟𐴏𐴝𐴥𐴌 𐴒𐴡𐴌𐴡𐴥𐴗𐴑, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴘𐴝𐴉𐴟𐴀𐴝𐴙𐴕 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴔𐴝𐴃𐴡𐴕 𐴃𐴡 𐴐𐴡𐴥𐴌𐴔𐴡𐴌 𐴈𐴡𐴃𐴝𐴤.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴑𐴞 𐴉𐴡𐴀𐴘𐴓𐴝 𐴐𐴟𐴥𐴌𐴟𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴕𐴠𐴦𐴙𐴓𐴧𐴠𐴥 𐴊𐴠𐴥؟ 𐴀𐴝𐴦𐴌 𐴕𐴝𐴥𐴑𐴞 𐴇𐴞𐴥𐴀𐴕 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠 𐴊𐴠𐴥؟ <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴡𐴁𐴞 𐴘𐴝𐴥 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞 𐴀𐴡𐴓𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴌𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴘𐴝𐴀𐴕 𐴔𐴝𐴕𐴞 𐴓𐴡𐴖𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴞𐴀𐴕 𐴓𐴠𐴑𐴞𐴥𐴌 𐴇𐴞𐴥𐴀𐴕 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴔𐴝𐴕𐴞 𐴕𐴡 𐴓𐴡𐴖𐴢, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴘𐴡𐴥 𐴔𐴝𐴕𐴞 𐴓𐴡𐴖𐴝 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴕𐴡𐴁𐴞 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴀𐴝𐴎𐴧𐴟 𐴒𐴡𐴌𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴒𐴝𐴁𐴞 𐴎𐴟𐴁𐴝𐴕𐴠 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴈𐴡𐴘𐴃𐴡𐴤 𐴔𐴝𐴕𐴝𐴥 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴘𐴡𐴔𐴠-𐴕𐴞𐴘𐴡𐴔𐴠 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s1">𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴞𐴕𐴊𐴝</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔 𐴇𐴞𐴥𐴘𐴝𐴕 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴌, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥 𐴀𐴝𐴦𐴌 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴝𐴒𐴞 𐴀𐴝𐴏𐴡𐴤. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴝𐴔 𐴊𐴠 𐴑𐴝𐴓𐴝𐴔 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴊𐴡𐴥𐴌𐴞 𐴀𐴝𐴏𐴡𐴤 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴕𐴠𐴅𐴝𐴃𐴢 𐴉𐴡𐴀𐴌, 𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴝𐴤 𐴁𐴠𐴇𐴝𐴌 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴧𐴞 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴟𐴀𐴙𐴕 𐴎𐴞𐴀𐴕 𐴀𐴝𐴀𐴛 𐴉𐴝𐴘𐴧𐴞𐴥 𐴊𐴠 𐴈𐴠𐴥𐴕𐴃𐴟 𐴁𐴞𐴐𐴞𐴤 𐴊𐴡𐴌𐴇𐴝𐴌𐴞 𐴒𐴟𐴥𐴕, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔 𐴔𐴡𐴎𐴞𐴕 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴒𐴟𐴕𐴝𐴤 𐴓𐴧𐴝 𐴁𐴡𐴥𐴓𐴞 𐴔𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢, <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴀𐴝𐴦𐴌 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴌 𐴈𐴡𐴃𐴝𐴤 𐴔𐴡𐴎𐴞𐴕 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴃𐴞𐴕 𐴊𐴞𐴕𐴡𐴃𐴢 𐴊𐴞𐴕 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴠𐴥𐴉𐴝𐴏𐴢<note caller="+" style="f"><char style="fr" closed="false">15‏:5 </char><char style="ft" closed="false">𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴞𐴃𐴡𐴌</char></note>𐴀𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠, 𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴁𐴝𐴌𐴡𐴥 𐴎𐴡𐴕 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕 𐴀𐴡𐴌𐴠. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴀𐴠𐴑𐴁𐴝𐴌𐴡𐴃𐴢 𐴉𐴝𐴣𐴏𐴢 𐴐𐴡𐴥𐴃𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴡𐴦𐴃𐴡𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴓𐴠𐴑𐴞𐴕 𐴁𐴞𐴐𐴞𐴤 𐴎𐴡𐴕 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴁𐴝𐴏𐴞 𐴀𐴝𐴏𐴠𐴤. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />𐴃𐴝𐴌𐴉𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴘𐴝𐴑𐴟𐴁𐴡𐴌𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠, 𐴁𐴝𐴦𐴊𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴌𐴠; <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />𐴀𐴝𐴦𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴞𐴏𐴠𐴤, 𐴀𐴝𐴀𐴛 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴁𐴠𐴄𐴝𐴙𐴔𐴧𐴝 𐴎𐴡𐴌𐴔𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴊𐴝𐴈𐴝𐴤𐴊𐴞𐴘𐴠.<verse eid="1CO 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 15:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴀𐴛 𐴀𐴡𐴥𐴘𐴓𐴝𐴔 𐴊𐴠 𐴀𐴠𐴁𐴧𐴠 𐴕𐴞𐴌𐴡𐴥𐴐𐴧𐴗𐴝; 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴈𐴡𐴘𐴁𐴝𐴥𐴌 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴓𐴝𐴦𐴘𐴠𐴑 𐴕𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴡 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴎𐴟𐴓𐴟𐴥𐴔 𐴒𐴡𐴙𐴃𐴧𐴝𐴥𐴔. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴀𐴝𐴀𐴛 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴘𐴧𐴞 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴠 𐴀𐴡𐴥𐴘𐴧𐴞 𐴊𐴠; 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴎𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴠𐴇𐴝𐴌 𐴀𐴡𐴥𐴘 𐴕𐴡𐴥 𐴎𐴝𐴒𐴡𐴘; 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴁𐴞𐴐𐴞𐴤 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴇𐴝𐴥𐴓𐴠𐴑𐴠 𐴀𐴝𐴀𐴛 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴝𐴣𐴀𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴘𐴧𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴝𐴀𐴛 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴃𐴡 𐴖𐴝𐴀𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴠𐴥𐴕𐴝 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌 𐴖𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴙𐴕𐴧𐴡𐴤.<verse eid="1CO 15:11" /></para>
  <para style="s1">𐴇𐴝𐴥𐴣𐴐𐴡𐴌𐴡𐴌 𐴊𐴞𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴃𐴡 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴡𐴊𐴟𐴥𐴕𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴈𐴡𐴀 𐴊𐴠, 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴥𐴣𐴐𐴡𐴌 𐴕𐴝𐴥𐴘؟ <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴡𐴊𐴞 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴥𐴣𐴐𐴡𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴘𐴡𐴥 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝. <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴃𐴡 𐴁𐴠𐴇𐴝𐴌 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴀𐴡𐴥 𐴁𐴠𐴇𐴝𐴌. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴁𐴝𐴦𐴊𐴠 𐴘𐴡, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴞𐴏𐴝𐴥 𐴒𐴡𐴁𐴝𐴤 𐴄𐴡𐴥𐴀𐴙𐴅𐴧𐴞; 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴒𐴡𐴁𐴝𐴤 𐴊𐴞𐴥 𐴊𐴠 𐴑𐴞, 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴓𐴠𐴑𐴞𐴕 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴡𐴊𐴞 𐴏𐴡𐴥𐴘𐴧𐴞 𐴕𐴡, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴘𐴡𐴥 𐴎𐴞𐴕𐴊𐴝 𐴕𐴡𐴥 𐴒𐴡𐴌𐴠𐴥. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡 𐴎𐴝𐴘𐴓𐴠𐴥, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴘𐴡𐴥 𐴃𐴡 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡𐴥 𐴎𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕 𐴁𐴠𐴇𐴝𐴌; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴕𐴝𐴤𐴌 𐴃𐴡𐴓𐴠 𐴀𐴝𐴏𐴡𐴤. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />𐴇𐴠𐴥𐴀𐴕 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴡𐴥𐴘 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴦𐴃𐴡𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴊𐴡𐴥𐴚𐴐𐴡 𐴀𐴡𐴥𐴘𐴒𐴞𐴘𐴡𐴘. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴐𐴝𐴤 𐴌𐴝𐴙𐴑𐴧𐴞𐴥 𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞𐴓𐴧𐴝 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴃𐴡 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴃𐴟𐴥𐴖𐴝𐴌𐴡 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴡𐴊𐴕𐴡𐴏𐴞𐴥𐴉𐴢 𐴀𐴡𐴓𐴝.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴁𐴠𐴐𐴡𐴥𐴑, 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴃𐴡 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴎𐴞𐴘𐴝𐴥𐴕𐴠 𐴉𐴝𐴑𐴧𐴝 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠, 𐴔𐴡𐴦𐴃𐴡𐴌 𐴒𐴟𐴥𐴔𐴡𐴃𐴢 𐴉𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴘𐴡𐴥 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴔𐴡𐴦𐴃𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴥𐴣𐴐𐴡𐴌 𐴀𐴡𐴥 𐴀𐴝𐴙𐴐𐴧𐴠𐴥. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴊𐴡𐴔𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴔𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴟𐴘𐴃𐴝𐴌𐴝𐴤 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴘𐴡𐴥 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />𐴓𐴠𐴑𐴞𐴕 𐴁𐴝𐴌𐴞-𐴁𐴝𐴌𐴞 𐴔𐴡𐴎𐴞𐴕: 𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴒𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴟𐴔𐴧𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴀𐴝𐴘𐴁𐴡𐴤. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴇𐴠𐴥𐴌𐴡𐴃𐴢 𐴀𐴝𐴘𐴁𐴡𐴤; 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢, 𐴇𐴝𐴥𐴀𐴌 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴀𐴌 𐴃𐴝𐴦𐴑𐴡𐴃𐴡𐴌𐴠 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴓𐴧𐴝 𐴁𐴝𐴉𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴌𐴝𐴙𐴅𐴧𐴡 𐴒𐴡𐴏𐴝𐴥𐴘 𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴁𐴡. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴃𐴧𐴟 𐴀𐴡𐴃𐴡𐴥𐴊𐴞𐴕 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴎𐴠𐴃𐴡𐴥𐴊𐴞𐴕 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴡𐴦𐴌 𐴃𐴡𐴓𐴠 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴠𐴓𐴠. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴊𐴟𐴐𐴧𐴡𐴕, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴉𐴝𐴥𐴕𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴎𐴝𐴘𐴁𐴡 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴦𐴃𐴢. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, ”𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴓𐴠 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠.“<note caller="+" style="f"><char style="fr" closed="false">15‏:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 8:6">𐴎𐴡𐴁𐴟𐴌 8‏:6</ref></char></char></note> 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴞𐴥𐴁𐴝 𐴘𐴠, ”𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥,“ 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴓𐴠 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠 𐴈𐴡𐴀 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴏𐴝𐴥𐴁𐴟𐴃𐴢 𐴀𐴡𐴥 𐴊𐴠, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴓𐴠 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠 𐴀𐴞𐴥𐴁𐴝 𐴇𐴠𐴥𐴍𐴠 𐴐𐴝𐴥𐴔𐴞𐴓𐴢 𐴕𐴝𐴥𐴘. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴓𐴠 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴃𐴡𐴥𐴘 𐴉𐴟𐴖𐴝 𐴕𐴞𐴎𐴠 𐴘𐴡𐴥 𐴀𐴟𐴁𐴝𐴤𐴌 𐴃𐴡𐴓𐴠 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴡𐴘 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴓𐴠 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴀𐴝𐴓𐴧𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴡𐴥.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />𐴀𐴝𐴌𐴕𐴡𐴥𐴘𐴓𐴠, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴖𐴢, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴑𐴞𐴦 𐴒𐴡𐴌𐴞𐴥𐴁𐴡؟ 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴡𐴊𐴞 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴑𐴞𐴘𐴝𐴥 𐴔𐴝𐴙𐴕𐴐𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴖؟ <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴘𐴡𐴥 𐴑𐴞𐴘𐴝𐴥 𐴇𐴝𐴥𐴀𐴌 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴇𐴡𐴥𐴃𐴡𐴌𐴝𐴃𐴢 𐴉𐴡𐴌𐴝𐴃𐴢 𐴃𐴝𐴥𐴑𐴞؟ <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴓𐴡𐴥𐴘 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴎𐴠 𐴁𐴡𐴌𐴝𐴥𐴘 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴈𐴡𐴏𐴡𐴥𐴔 𐴇𐴝𐴥𐴘 𐴈𐴡𐴀𐴙𐴌, 𐴀𐴝𐴀𐴛 𐴉𐴡𐴃𐴧𐴞𐴥 𐴊𐴞𐴕 𐴔𐴡𐴌𐴞𐴎𐴝𐴘𐴒𐴡𐴥𐴘. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴡𐴃𐴢 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴅𐴡𐴚𐴒𐴡𐴓𐴞 𐴅𐴝𐴕𐴟𐴖𐴝𐴌 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴡𐴥𐴘 𐴎𐴠 𐴓𐴝𐴌𐴝𐴥𐴘 𐴒𐴡𐴌𐴝𐴥 𐴉𐴡𐴙𐴅𐴧𐴠𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴎𐴡𐴊𐴞 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴕𐴞𐴘𐴡𐴃𐴠 𐴒𐴡𐴙𐴅𐴧𐴞𐴥 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴣𐴀𐴌 𐴑𐴞𐴦 𐴉𐴝𐴥𐴘𐴊𐴝؟ 𐴎𐴡𐴊𐴞 𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴕𐴡 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠,</para>
  <para style="q1" vid="1CO 15:32">”𐴃𐴡𐴥𐴀𐴘𐴓𐴠 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴈𐴝𐴥𐴀𐴉𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥,</para>
  <para style="q2" vid="1CO 15:32">𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴝𐴙𐴓𐴧𐴝 𐴃𐴡 𐴔𐴡𐴌𐴞 𐴎𐴝𐴘𐴧𐴟𐴔𐴁𐴡𐴥𐴘.“<note caller="+" style="f"><char style="fr" closed="false">15‏:32 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 22:13">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 22‏:13</ref></char></char></note><verse eid="1CO 15:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="1CO 15:33" />𐴉𐴝𐴥𐴑𐴞 𐴕𐴝 𐴇𐴝𐴥𐴘𐴧𐴡. ”𐴈𐴡𐴥𐴌𐴝𐴉𐴢 𐴏𐴝𐴥𐴀𐴣𐴃𐴞𐴘𐴠 𐴒𐴡𐴔 𐴀𐴝𐴊𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴁𐴞𐴒𐴞𐴍𐴞𐴉𐴠𐴥𐴓𐴠.“ <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />𐴏𐴡𐴥𐴘𐴧𐴞 𐴀𐴟𐴥𐴣𐴐𐴡𐴃𐴢 𐴀𐴝𐴘𐴧𐴡𐴤, 𐴀𐴝𐴦𐴌 𐴒𐴟𐴕𐴝𐴤 𐴒𐴡𐴌𐴝𐴥 𐴁𐴡𐴕 𐴒𐴡𐴌𐴡𐴤. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴊𐴟𐴥𐴕 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴏𐴠𐴤 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴕𐴡 𐴏𐴞𐴕𐴠𐴥. 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴈𐴡𐴀𐴙𐴌 𐴊𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴐𐴡𐴥𐴌𐴡𐴔 𐴊𐴞𐴥 𐴁𐴡𐴓𐴧𐴝.<verse eid="1CO 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴈𐴡𐴘𐴁𐴡𐴤, ”𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴠𐴀𐴕𐴒𐴡𐴌𐴞 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴘𐴁𐴡؟ 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴅𐴞𐴏𐴞𐴥𐴔 𐴃𐴝𐴥𐴑𐴞𐴁𐴡؟“ <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />𐴀𐴡𐴥 𐴉𐴡𐴦𐴓𐴢! 𐴎𐴠 𐴁𐴞𐴏𐴢 𐴓𐴝𐴒𐴡𐴏𐴢 𐴘𐴞𐴥𐴁𐴝 𐴕𐴡 𐴔𐴡𐴙𐴓𐴧𐴠 𐴃𐴡 𐴏𐴝𐴌𐴝 𐴕𐴡 𐴉𐴟𐴥𐴍𐴠. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />𐴓𐴝𐴒𐴝𐴘𐴃𐴠𐴥 𐴃𐴡 𐴉𐴡𐴌𐴠 𐴁𐴡𐴕𐴞𐴁𐴡𐴥 𐴊𐴠 𐴏𐴝𐴌𐴝 𐴓𐴝𐴒𐴡𐴏𐴢 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴁𐴞𐴏𐴢 𐴀𐴠𐴥𐴕𐴝, 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴘𐴞𐴥𐴁𐴝 𐴒𐴞𐴣𐴘𐴟𐴌 𐴘𐴝𐴥 𐴀𐴡𐴙𐴕𐴧𐴡 𐴑𐴠𐴏𐴧𐴟𐴥𐴌. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴡𐴏𐴡𐴥𐴕 𐴔𐴡𐴎𐴞𐴕 𐴘𐴞𐴥𐴁𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴝𐴦 𐴊𐴠𐴦. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴉𐴡𐴃𐴧𐴞𐴥 𐴁𐴞𐴏𐴡𐴌𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴎𐴝𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴒𐴝𐴦 𐴊𐴠𐴦. <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />𐴇𐴝𐴥𐴀𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴠𐴑 𐴋𐴡𐴙𐴓𐴧𐴝 𐴕𐴡, 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴠𐴑 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴅𐴝𐴕𐴟𐴖𐴝𐴌𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴠𐴑 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴉𐴝𐴙𐴑𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴠𐴑 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴔𐴝𐴏𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴠𐴑 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴐𐴝𐴥𐴀𐴕 𐴀𐴠𐴑 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴐𐴝𐴥𐴀𐴕 𐴀𐴠𐴑 𐴋𐴡𐴥𐴙𐴓𐴧𐴝. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />𐴁𐴠𐴙𐴓𐴡𐴌 𐴐𐴝𐴥𐴀𐴕 𐴀𐴠𐴑 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴏𐴝𐴕𐴡𐴌 𐴐𐴝𐴥𐴀𐴕 𐴀𐴠𐴑 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴐𐴝𐴥𐴀𐴕 𐴀𐴠𐴑 𐴋𐴡𐴥𐴙𐴓𐴧𐴝, 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴠𐴑 𐴃𐴝𐴌𐴝𐴌 𐴐𐴝𐴥𐴀𐴕 𐴀𐴝𐴌𐴀𐴠𐴑 𐴃𐴝𐴌𐴝𐴌 𐴐𐴝𐴥𐴀𐴕 𐴓𐴡𐴥𐴘 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴉𐴡𐴌𐴡𐴥𐴑.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />𐴔𐴡𐴌𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴥𐴣𐴐𐴡𐴌 𐴀𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝. 𐴇𐴝𐴘𐴧𐴝 𐴔𐴠𐴍𐴞𐴃𐴢 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝 𐴊𐴠 𐴃𐴡 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴓𐴝𐴤 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴉𐴝𐴥𐴕𐴝 𐴕𐴡 𐴀𐴡𐴥 𐴊𐴠 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />𐴔𐴠𐴍𐴞𐴃𐴢 𐴊𐴞𐴦𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴇𐴡𐴕𐴡𐴤 𐴑𐴡𐴊𐴡𐴌 𐴕𐴡 𐴃𐴝𐴥𐴑𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴃𐴟𐴓𐴝𐴤 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴀𐴞𐴎𐴧𐴡𐴃𐴢 𐴀𐴡𐴃𐴢. 𐴔𐴠𐴍𐴞𐴃𐴢 𐴊𐴞𐴦𐴁𐴝𐴐𐴧𐴡𐴥𐴃𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴑𐴡𐴔𐴎𐴟𐴌, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴃𐴟𐴓𐴝𐴤 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴃𐴝𐴦𐴑𐴡𐴃𐴢 𐴀𐴡𐴃𐴢; <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌𐴠 𐴔𐴠𐴍𐴞𐴃𐴢 𐴊𐴞𐴦𐴘𐴝 𐴎𐴝 𐴊𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴃𐴟𐴓𐴝𐴤 𐴎𐴝𐴘𐴁𐴡 𐴊𐴠 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠.</para>
  <para style="p" vid="1CO 15:44">𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴡𐴥 𐴀𐴝𐴏𐴠𐴤. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠, ”𐴉𐴡𐴀𐴘𐴓𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴊𐴡𐴔 𐴎𐴞𐴕𐴊𐴝 𐴎𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴡𐴥𐴘𐴀𐴝𐴙𐴐𐴧𐴠.“<note caller="+" style="f"><char style="fr" closed="false">15‏:45 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:7">𐴉𐴡𐴘𐴊𐴝𐴘𐴠𐴐𐴢 2‏:7</ref></char></char></note> 𐴀𐴝𐴦𐴌 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴝𐴊𐴡𐴔 𐴎𐴞𐴕𐴊𐴞𐴒𐴞-𐴊𐴡𐴦𐴘𐴝 𐴌𐴟𐴀 𐴀𐴡𐴥𐴘𐴀𐴝𐴙𐴐𐴧𐴠. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />𐴀𐴝𐴒𐴠 𐴃𐴡 𐴅𐴞𐴏𐴞𐴥𐴔 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴒𐴝𐴥𐴕 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴒𐴝𐴥𐴕 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠, 𐴘𐴝𐴥𐴌𐴁𐴝𐴦𐴊𐴠 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴒𐴝𐴥𐴕. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />𐴉𐴡𐴀𐴘𐴓𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴠𐴍𐴞𐴌, 𐴘𐴝𐴥𐴕𐴞 𐴔𐴠𐴍𐴞 𐴓𐴡𐴘 𐴁𐴝𐴕𐴝𐴘𐴧𐴝; 𐴊𐴟𐴏𐴝𐴥𐴌𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴏𐴔𐴝𐴕𐴞. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴔𐴠𐴍𐴞𐴌𐴒𐴗𐴝𐴥 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝, 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝; 𐴀𐴝𐴦𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴖𐴝 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴘𐴡𐴥 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴠𐴍𐴞𐴌 𐴒𐴗𐴝𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝-𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴉𐴝𐴘𐴧𐴞𐴥, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴖𐴝𐴌 𐴏𐴞𐴘𐴝𐴥𐴌𐴝-𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴀𐴡𐴥 𐴉𐴝𐴘𐴧𐴟𐴔.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴈𐴡𐴘𐴃𐴝𐴥𐴔 𐴏𐴝𐴀𐴙𐴌 𐴊𐴠 𐴑𐴞, 𐴅𐴞𐴏𐴞𐴥𐴔 𐴀𐴠𐴊𐴧𐴠 𐴓𐴡𐴖𐴢 𐴖𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴠 𐴉𐴝𐴥𐴕𐴝 𐴕𐴡 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕 𐴔𐴞𐴌𐴝𐴏𐴢 𐴉𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" />𐴉𐴟𐴥𐴕𐴡, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴒𐴟𐴉𐴡𐴕𐴞 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴌, 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴔𐴡𐴦𐴃𐴡𐴌 𐴒𐴟𐴥𐴔 𐴕𐴡 𐴎𐴝𐴘𐴧𐴟𐴔, 𐴓𐴠𐴑𐴞𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴡𐴊𐴡𐴓𐴞 𐴎𐴝𐴘𐴧𐴟𐴔𐴁𐴡𐴥𐴘. <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴥𐴇𐴡𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠, 𐴏𐴟𐴑𐴡𐴌 𐴁𐴝𐴙𐴓𐴉𐴝𐴃𐴝 𐴉𐴞𐴥𐴌𐴝𐴘𐴁𐴝𐴐𐴧𐴡𐴃𐴢, 𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴡𐴥𐴘𐴁𐴡. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴞𐴥𐴛𐴝 𐴔𐴝𐴃𐴞𐴓𐴠𐴥 𐴔𐴟𐴌𐴟𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴥𐴕𐴝 𐴕𐴡 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴝𐴥𐴓𐴡𐴃𐴡𐴃𐴢 𐴀𐴟𐴍𐴞𐴤𐴎𐴝𐴘𐴁𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝 𐴁𐴡𐴊𐴡𐴓𐴞 𐴎𐴝𐴘𐴧𐴟𐴔𐴁𐴡𐴥𐴘. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴝𐴘𐴧𐴝 𐴘𐴝𐴀𐴕𐴡𐴃𐴢 𐴉𐴝𐴥𐴕𐴝 𐴕𐴡 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴞𐴕𐴊𐴝𐴤𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴠 𐴔𐴡𐴌𐴡𐴕𐴞 𐴇𐴝𐴘𐴧𐴝 𐴘𐴝𐴀𐴕𐴡𐴃𐴢 𐴀𐴡𐴔𐴡𐴌𐴡𐴕𐴞 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴞𐴕𐴊𐴝𐴤𐴌 𐴎𐴡𐴌𐴟𐴌. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴉𐴝𐴥𐴕𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴝𐴘𐴧𐴝 𐴘𐴝𐴀𐴕𐴡𐴃𐴢 𐴉𐴝𐴥𐴕𐴝 𐴕𐴡 𐴀𐴡𐴥 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴞𐴕𐴊𐴝𐴤 𐴎𐴝𐴘𐴁𐴡, 𐴀𐴝𐴦𐴌 𐴔𐴡𐴌𐴡𐴕𐴞 𐴇𐴝𐴘𐴧𐴝 𐴘𐴝𐴀𐴕𐴡𐴃𐴢 𐴀𐴡𐴔𐴡𐴌𐴡𐴕𐴞 𐴑𐴠𐴏𐴧𐴟𐴥 𐴉𐴞𐴕𐴊𐴝𐴤 𐴎𐴝𐴘𐴁𐴡, 𐴃𐴡𐴥𐴘 𐴁𐴝𐴦𐴊𐴠 𐴂𐴝𐴑-𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴠 𐴈𐴡𐴃𐴝𐴤 𐴉𐴟𐴌𐴝 𐴀𐴡𐴥𐴘𐴁𐴡, ”𐴔𐴡𐴦𐴃𐴡𐴌𐴠 𐴎𐴞𐴃𐴞 𐴊𐴡𐴥𐴚𐴐𐴡 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠.“<note caller="+" style="f"><char style="fr" closed="false">15‏:54 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 25:8">𐴘𐴠𐴏𐴝𐴥𐴘𐴝 25‏:8</ref></char></char></note><verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />”𐴀𐴡𐴥 𐴔𐴡𐴦𐴃𐴢, 𐴃𐴡𐴌 𐴉𐴡𐴥𐴃𐴝 𐴇𐴡𐴍𐴠𐴥؟</para>
  <para style="q2" vid="1CO 15:55">𐴀𐴡𐴥 𐴔𐴡𐴦𐴃𐴢, 𐴃𐴡𐴌 𐴐𐴟𐴥𐴔 𐴇𐴡𐴍𐴠𐴥؟“<note caller="+" style="f"><char style="fr" closed="false">15‏:55 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 13:14">𐴇𐴡𐴥𐴐𐴞𐴘𐴝 13‏:14</ref></char></char></note><verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />𐴔𐴡𐴦𐴃𐴡𐴌 𐴐𐴟𐴥𐴔 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴟𐴕𐴝𐴤, 𐴀𐴝𐴦𐴌 𐴒𐴟𐴕𐴝𐴤𐴌 𐴁𐴡𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴀𐴡𐴥𐴑, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴕𐴞𐴥𐴑𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴉𐴡𐴥𐴃𐴝 𐴊𐴝𐴕 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴡𐴥 𐴀𐴝𐴦𐴌 𐴃𐴡𐴥𐴌𐴡𐴑 𐴊𐴡𐴥𐴌𐴞 𐴃𐴝𐴥𐴑𐴡. 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴈𐴝𐴔 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴒𐴡𐴌𐴡𐴤, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴁𐴠𐴉𐴡𐴥𐴎𐴟𐴓𐴢 𐴕𐴡.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s1">𐴏𐴝𐴣𐴊𐴝 𐴃𐴟𐴓𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />𐴘𐴝𐴓𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴓𐴧𐴝 𐴏𐴝𐴣𐴊𐴝 𐴃𐴟𐴓𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥: 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴀𐴛 𐴒𐴝𐴓𐴝𐴃𐴞𐴥𐴘𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴡𐴥𐴑𐴟𐴔 𐴊𐴞𐴥𐴓𐴝𐴔. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />𐴉𐴡𐴃𐴧𐴞𐴥 𐴇𐴝𐴥𐴉𐴃𐴝𐴌 𐴐𐴟𐴥𐴌𐴟𐴌 𐴊𐴞𐴕، 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴠 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴔𐴡𐴊𐴡𐴕𐴞 𐴔𐴡𐴎𐴞𐴕 𐴑𐴠𐴏𐴧𐴟𐴥 𐴄𐴞𐴛𐴝 𐴀𐴝𐴓𐴡𐴑 𐴒𐴡𐴌𐴞𐴥 𐴎𐴡𐴔𐴝 𐴌𐴝𐴑𐴞𐴥𐴘𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴀𐴝𐴘𐴓𐴠𐴤 𐴏𐴝𐴣𐴊𐴝 𐴃𐴟𐴓𐴝𐴤 𐴕𐴡 𐴉𐴡𐴌𐴠. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />𐴀𐴝𐴀𐴛 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴓𐴠𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴝𐴌𐴝𐴤𐴌𐴠 𐴁𐴝𐴏𐴞𐴥𐴓𐴡𐴘𐴁𐴝 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴀𐴝𐴥𐴃𐴡𐴃𐴢 𐴐𐴠𐴣𐴍𐴞𐴥 𐴊𐴞𐴦 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴥𐴊𐴞𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴅𐴠𐴌𐴟𐴥𐴏𐴝𐴓𐴠𐴔𐴡𐴃𐴢 𐴉𐴡𐴀𐴣𐴏𐴝𐴘𐴃𐴡 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴘𐴧𐴟𐴔. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />𐴀𐴝𐴦𐴌 𐴎𐴡𐴊𐴞 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴘𐴡𐴥 𐴎𐴝𐴦 𐴉𐴡𐴌𐴠, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴘𐴁𐴡.<verse eid="1CO 16:4" /></para>
  <para style="s1">𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴌 𐴕𐴞𐴘𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝 𐴁𐴝𐴥𐴘 𐴏𐴡𐴉𐴡𐴥𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴝𐴦𐴊𐴠 𐴀𐴝𐴙𐴐𐴧𐴟𐴤𐴔, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴔𐴝𐴑𐴠𐴊𐴡𐴥𐴕𐴞𐴘𐴝 𐴁𐴝𐴥𐴘 𐴏𐴡𐴉𐴡𐴥𐴌 𐴒𐴡𐴙𐴅𐴧𐴟𐴥𐴔. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴡𐴦𐴊𐴧𐴞𐴕 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔, 𐴘𐴝𐴥 𐴉𐴟𐴌𐴝 𐴐𐴞𐴥𐴃𐴑𐴝𐴓𐴢 𐴀𐴟𐴥𐴊𐴧𐴗𐴝 𐴈𐴝𐴍𐴝𐴘𐴧𐴟𐴥𐴔, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴀𐴛 𐴎𐴠𐴍𐴠𐴥 𐴎𐴝𐴘𐴧𐴟𐴔 𐴇𐴠𐴥 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴌𐴡𐴖𐴝𐴕𐴝 𐴒𐴡𐴌𐴞𐴥𐴊𐴞 𐴉𐴝𐴌𐴡. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />𐴀𐴝𐴀𐴛 𐴀𐴠𐴇𐴡𐴥𐴕 𐴎𐴝𐴘𐴁𐴝𐴌 𐴉𐴡𐴣𐴃𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴓𐴧𐴡𐴥𐴘 𐴔𐴞𐴓𐴃𐴡 𐴕𐴡 𐴏𐴝𐴀𐴙𐴌, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴑𐴠𐴏𐴧𐴟𐴥 𐴄𐴝𐴙𐴔 𐴈𐴝𐴍𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴎𐴡𐴊𐴞 𐴔𐴝𐴓𐴞𐴑𐴠 𐴀𐴠𐴎𐴝𐴎𐴡𐴃𐴢 𐴊𐴠. <verse eid="1CO 16:7" /><verse number="8" style="v" sid="1CO 16:8" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴀𐴛 𐴀𐴞𐴥𐴉𐴞𐴏𐴝𐴏𐴡𐴃𐴢 𐴂𐴠𐴕𐴄𐴞𐴑𐴡𐴏𐴢 𐴀𐴞𐴊𐴢 𐴉𐴡𐴙𐴅𐴧𐴡𐴕𐴃𐴡 𐴃𐴝𐴥𐴑𐴞𐴘𐴟𐴔, <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴐𐴝𐴥𐴌 𐴀𐴡𐴥 𐴊𐴠 𐴈𐴝𐴔 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴌 𐴓𐴧𐴝 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴁𐴡𐴥𐴋𐴧𐴝 𐴊𐴡𐴌𐴡𐴎𐴝 𐴑𐴟𐴥𐴙𐴓𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴔𐴟𐴈𐴝𐴥𐴓𐴠𐴉𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴥 𐴁𐴞𐴐𐴞𐴤 𐴀𐴝𐴏𐴠𐴤.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />𐴎𐴡𐴊𐴞 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴀𐴝𐴘𐴧𐴠𐴤, 𐴏𐴝𐴘𐴧𐴡𐴥, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴇𐴡𐴕𐴡𐴤 𐴋𐴡𐴦𐴌 𐴏𐴝𐴥𐴌𐴝 𐴃𐴝𐴥𐴑𐴞 𐴉𐴝𐴌𐴠 𐴉𐴝𐴥𐴕, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴘𐴡𐴥 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴈𐴝𐴔 𐴀𐴠𐴥𐴕𐴝 𐴒𐴡𐴌𐴠𐴥𐴌. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴇𐴠𐴥𐴑𐴝𐴌𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴐𐴝𐴥𐴕𐴃𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴏𐴡𐴉𐴡𐴥𐴌𐴡𐴃𐴢 𐴌𐴡𐴖𐴝𐴕𐴝 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴡, 𐴎𐴠𐴀𐴕𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴝𐴣𐴀𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴀𐴘𐴢 𐴉𐴝𐴌𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴘𐴁𐴡𐴤 𐴁𐴡𐴥𐴓𐴞 𐴀𐴝𐴐𐴝𐴤 𐴒𐴡𐴌𐴞𐴥𐴌.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />𐴘𐴝𐴓𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴥𐴘 𐴀𐴝𐴂𐴡𐴥𐴓𐴡𐴏𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥: 𐴀𐴝𐴀𐴛 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴧𐴝𐴙𐴕 𐴊𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴙𐴅𐴧𐴞𐴥, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴠𐴇𐴡𐴥𐴕 𐴀𐴝𐴘𐴁𐴝𐴤𐴌 𐴇𐴡𐴕𐴡𐴤 𐴔𐴡𐴕 𐴕𐴝𐴥𐴘; 𐴀𐴡𐴕𐴠 𐴔𐴡𐴦𐴗𐴑𐴝 𐴉𐴝𐴘𐴓𐴠 𐴀𐴝𐴘𐴁𐴡𐴤.<verse eid="1CO 16:12" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴀𐴝𐴌𐴡𐴏𐴢 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌 𐴀𐴡𐴥; 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴢 𐴊𐴡𐴌𐴡𐴤𐴒𐴡𐴌𐴞 𐴃𐴝𐴥𐴑𐴡; 𐴇𐴞𐴥𐴔𐴧𐴡𐴃𐴢 𐴌𐴝𐴑𐴡𐴥; 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴡𐴥. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴡𐴤 𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴒𐴡𐴌𐴡𐴤.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴠𐴏𐴄𐴠𐴉𐴝𐴥𐴕𐴝𐴏𐴡𐴌 𐴒𐴡𐴥𐴌 𐴄𐴞𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴑𐴝𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴉𐴡𐴀𐴘𐴓𐴝 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴡𐴃𐴢 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴞𐴘𐴠. 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴞𐴐𐴞𐴤𐴒𐴡𐴌𐴞 𐴀𐴝𐴌𐴡𐴏𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴎𐴠𐴃𐴡𐴥 𐴎𐴡𐴕 𐴇𐴠𐴥 𐴈𐴝𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴡𐴃𐴢 𐴐𐴡𐴥𐴌𐴞𐴑 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴡𐴥 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡. <verse eid="1CO 16:16" /><verse number="17" style="v" sid="1CO 16:17" />𐴀𐴝𐴀𐴛 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥𐴘𐴧𐴞, 𐴀𐴠𐴏𐴄𐴠𐴉𐴝𐴥𐴕𐴝𐴏𐴢, 𐴉𐴡𐴌𐴃𐴟𐴥𐴕𐴝𐴃𐴟𐴏𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴑𐴝𐴘𐴞𐴑𐴟𐴏𐴢 𐴀𐴝𐴙𐴐𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴟𐴕𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴉𐴟𐴌𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌 𐴀𐴠𐴊𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴌𐴟𐴀𐴌𐴠 𐴉𐴡𐴄𐴉𐴡𐴙𐴄𐴧𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴑𐴡𐴊𐴡𐴌 𐴒𐴡𐴌𐴞𐴥𐴘𐴡.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />𐴀𐴠𐴐𐴞𐴥𐴘𐴝 𐴀𐴠𐴓𐴝𐴑𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌. 𐴀𐴠𐴑𐴟𐴥𐴘𐴓𐴝 𐴀𐴠𐴊𐴧𐴠 𐴂𐴌𐴞𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴕𐴝𐴔𐴠 𐴊𐴞𐴓𐴡𐴃𐴧𐴟 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌; 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴠 𐴘𐴡𐴥 𐴎𐴝𐴕𐴝𐴌. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />𐴃𐴝𐴔𐴝𐴥𐴔 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴠 𐴘𐴡𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴂𐴝𐴑 𐴊𐴞𐴓𐴠 𐴀𐴝𐴂𐴧𐴝𐴤 𐴊𐴞𐴥 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴡.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />𐴀𐴠 𐴏𐴡𐴥𐴓𐴝𐴔𐴧𐴗𐴝 𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴡𐴌 𐴓𐴠𐴑𐴝𐴥.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴔𐴝𐴓𐴞𐴑𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴕𐴡 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌 𐴖𐴡𐴌𐴠 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴉𐴡𐴌𐴡𐴗𐴑. 𐴀𐴡𐴥 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑, 𐴀𐴝𐴘𐴧𐴡𐴤.<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑. 𐴀𐴝𐴦𐴔𐴞𐴕.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>