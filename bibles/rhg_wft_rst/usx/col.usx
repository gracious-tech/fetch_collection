<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Rohingya New Testament - Hanifi</book>
  <para style="h">𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc1">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc2">𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="toc3">𐴑𐴡𐴓𐴢</para>
  <para style="mt2">𐴀𐴞𐴕𐴅𐴞𐴓𐴢 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴏𐴞𐴥𐴘𐴝𐴌𐴝</para>
  <para style="mt1">𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴀𐴡𐴥𐴓𐴢</para>
  <para style="is">𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴉𐴡𐴌𐴞𐴏𐴡</para>
  <para style="im">𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴀𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴠𐴑𐴧𐴝𐴥𐴕 𐴐𐴠𐴣𐴍𐴞𐴥. 𐴘𐴝𐴀𐴕𐴡𐴌 𐴓𐴠𐴑𐴡𐴥𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴝𐴥𐴇𐴝𐴁𐴞 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 <char style="ior">(<ref loc="COL 1:1">1‏:1</ref>)</char>. 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕𐴡𐴌𐴠 𐴌𐴡𐴔 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴧𐴟 𐴓𐴠𐴙𐴑𐴧𐴠𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴘𐴝𐴀𐴕 𐴓𐴠𐴑𐴠𐴥𐴌 𐴊𐴠 𐴀𐴡𐴑𐴃𐴡𐴥𐴃𐴢 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴁𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢. 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤 𐴎𐴡𐴌𐴔𐴡 𐴀𐴡𐴥𐴘 𐴃𐴡𐴑𐴡𐴌𐴞𐴁𐴝𐴕 𐴇𐴝𐴥𐴙𐴄𐴢 𐴁𐴡𐴏𐴡𐴥𐴌 𐴁𐴝𐴦𐴊𐴠 𐴓𐴠𐴑𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴀𐴡𐴥𐴓𐴢 𐴐𐴡𐴥𐴀 𐴀𐴞𐴥𐴉𐴞𐴐𐴞𐴀𐴡𐴥𐴓𐴢, 𐴉𐴞𐴓𐴞𐴤𐴂𐴧𐴝𐴘𐴀𐴡𐴥𐴓𐴢, 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴓𐴞𐴔𐴡𐴕𐴡𐴌𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴞 𐴐𐴠𐴣𐴍𐴞𐴥 𐴁𐴡𐴓𐴞 𐴎𐴝𐴕𐴝 𐴎𐴝, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌𐴠 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴧𐴟 𐴃𐴝𐴥𐴘 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢. 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕𐴡𐴌𐴠 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴘𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠. 𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴕𐴡, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 <char style="ior">(<ref loc="COL 2:1">2‏:1</ref>)</char> 𐴀𐴡𐴃𐴢 𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠 𐴔𐴡𐴎𐴞𐴕، 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴀𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝𐴓𐴧𐴝 𐴑𐴠𐴏𐴧𐴟𐴥 𐴎𐴞𐴔𐴧𐴝 𐴀𐴝𐴏𐴠𐴤 𐴁𐴡𐴥𐴓𐴞 𐴄𐴝𐴥𐴀𐴙𐴃𐴧𐴡. 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴀𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴧𐴗𐴝 𐴐𐴟𐴥𐴌𐴟 𐴒𐴡𐴙𐴅𐴧𐴞𐴥𐴓𐴢 𐴊𐴠 𐴀𐴠𐴂𐴝𐴉𐴝𐴌𐴝𐴏𐴠, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴞𐴥𐴁𐴝 𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴘𐴝𐴌 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢.</para>
  <para style="ip">𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴃𐴧𐴟 𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴘𐴝𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴃𐴢 𐴏𐴡𐴓𐴠𐴌 𐴊𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕𐴡𐴃𐴢 𐴁𐴠𐴦𐴐𐴇𐴞𐴥𐴏𐴧𐴝 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴔𐴟𐴃𐴝𐴓𐴠𐴑 𐴓𐴠𐴙𐴑𐴧𐴞𐴥𐴓𐴢. 𐴀𐴡𐴥𐴘𐴃𐴡𐴉𐴝𐴌𐴠 𐴇𐴠𐴥𐴍𐴠 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴁𐴡𐴙𐴕𐴧𐴠𐴥 𐴊𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴊𐴡𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴕𐴝 𐴕𐴞𐴘𐴡𐴔𐴡𐴃𐴧𐴟 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴐𐴡𐴥𐴌𐴞𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴔𐴡𐴥𐴓𐴢 𐴒𐴡𐴌𐴝𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴝𐴎𐴟𐴌𐴞 𐴒𐴡𐴙𐴃𐴧𐴡𐴥, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴌𐴝𐴥𐴌 𐴒𐴝𐴥𐴕. 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴀𐴠 𐴏𐴞𐴥𐴘𐴝𐴌𐴝 𐴖𐴝𐴃𐴢 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴓𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴑𐴞 𐴈𐴡𐴘𐴓𐴠𐴥, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴁𐴝𐴊𐴠 𐴀𐴝𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴘𐴝𐴥 𐴇𐴡𐴕𐴡𐴤 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴎𐴡𐴌𐴟𐴌𐴡𐴃𐴢 𐴕𐴝𐴥𐴘 <char style="ior">(<ref loc="COL 1:15-20">1‏:15‏-20</ref>)</char> 𐴀𐴝𐴦𐴌 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴊𐴠𐴔𐴝𐴑𐴠 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴠𐴇𐴝𐴌 <char style="ior">(<ref loc="COL 2:8">2‏:8</ref>)</char>.</para>
  <para style="iot">𐴏𐴟𐴥𐴌𐴑𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="io1">1. 𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 <char style="ior">(<ref loc="COL 1:1-2">1‏:1‏-2</ref>)</char></para>
  <para style="io1">2. 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴋𐴡𐴣𐴀𐴌 𐴃𐴡𐴑𐴧𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠, 𐴈𐴝𐴥𐴀𐴏𐴒𐴡𐴌𐴞 𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴘𐴝𐴃𐴢 𐴏𐴡𐴓𐴠𐴌 𐴊𐴠 𐴒𐴡𐴓𐴧𐴡𐴃𐴢 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴇𐴠𐴥𐴃𐴝𐴂𐴢 𐴒𐴡𐴌𐴞𐴥 <char style="ior">(<ref loc="COL 1:3-3:4">1‏:3‏—3‏:4</ref>)</char></para>
  <para style="io1">3. 𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴑𐴠𐴏𐴧𐴟𐴥 𐴐𐴞𐴥𐴑𐴧𐴝 <char style="ior">(<ref loc="COL 3:5-4:6">3‏:5‏—4‏:6</ref>)</char></para>
  <para style="io1">4. 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕𐴡𐴌𐴠 𐴀𐴡𐴙𐴕𐴧𐴡 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴡𐴥 𐴃𐴠𐴓𐴝𐴖𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴁𐴝𐴥𐴘𐴃𐴡 𐴈𐴡𐴘𐴧𐴠𐴥 <char style="ior">(<ref loc="COL 4:7-18">4‏:7‏-18</ref>)</char></para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s1">𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢, 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥 𐴔𐴡𐴎𐴞𐴕 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴀𐴠𐴥𐴒𐴧𐴗𐴝 𐴏𐴝𐴥𐴇𐴝𐴁𐴞. 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴥𐴘 𐴃𐴞𐴔𐴡𐴥𐴃𐴞 𐴘𐴡𐴥 𐴀𐴝𐴏𐴠𐴤.<verse eid="COL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2" />𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴘𐴝 𐴐𐴡𐴥𐴀𐴌𐴡𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴎𐴠 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴇𐴠𐴥 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴠𐴑𐴞𐴥𐴌:</para>
  <para style="p" vid="COL 1:2">𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴕𐴝𐴎𐴞𐴓𐴢 𐴀𐴡𐴥𐴑.<verse eid="COL 1:2" /></para>
  <para style="s1">𐴑𐴡𐴓𐴡𐴥𐴐𐴞𐴀𐴡𐴥𐴓𐴡𐴓𐴧𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝𐴌 𐴊𐴟𐴖𐴝</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴐𐴧𐴡𐴃𐴢, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥, <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤, <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />𐴖𐴝𐴀𐴕𐴡𐴌 𐴀𐴝𐴐𐴝𐴤𐴘𐴠 𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴈𐴠𐴥𐴉𐴝𐴎𐴡𐴃𐴢 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴘𐴠. 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴝𐴦𐴌 𐴀𐴝𐴒𐴠 𐴏𐴡𐴥𐴘𐴧𐴞 𐴑𐴝𐴓𐴝𐴔𐴡𐴃𐴢 𐴉𐴟𐴥𐴙𐴕𐴧𐴞𐴓𐴝, 𐴘𐴝𐴥𐴕𐴞 𐴀𐴡 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴀𐴡𐴃𐴢 <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />𐴎𐴞𐴘𐴝𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴉𐴡𐴀𐴣𐴙𐴐𐴧𐴠. 𐴇𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴠 𐴉𐴟𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴙𐴃𐴢 𐴒𐴟𐴓𐴝𐴒𐴝𐴓𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴊𐴡𐴥𐴌𐴝𐴌 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴡𐴥 𐴀𐴠𐴥𐴃𐴡 𐴉𐴡𐴥𐴓𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴡𐴥 𐴀𐴡 𐴊𐴞𐴕 𐴓𐴡𐴥𐴃𐴞 𐴊𐴡𐴥𐴌𐴝𐴌 𐴎𐴠 𐴊𐴞𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴡 𐴀𐴝𐴦𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴡𐴌𐴠 𐴏𐴡𐴥𐴘𐴧𐴞𐴒𐴡𐴌𐴞 𐴁𐴟𐴎𐴞𐴥 𐴉𐴝𐴙𐴅𐴧𐴡𐴥. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />𐴇𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴏𐴝𐴥𐴀𐴣𐴃𐴞 𐴒𐴟𐴓𐴝𐴔 𐴀𐴠𐴂𐴝𐴉𐴝𐴌𐴝𐴏𐴡𐴃𐴧𐴟 𐴐𐴞𐴥𐴑𐴧𐴞𐴓𐴝, 𐴎𐴞𐴁𐴝𐴤 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴞𐴥𐴏𐴝𐴉𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴁𐴡𐴊𐴡𐴓𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥𐴌. <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴎𐴝𐴕𐴝𐴘𐴧𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴂𐴝𐴑-𐴌𐴟𐴀𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="COL 1:8" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴑𐴧𐴝 𐴀𐴠𐴊𐴧𐴠 𐴈𐴝𐴔</para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴀𐴝𐴣𐴀𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴞 𐴓𐴡𐴥𐴃𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴕𐴡𐴥 𐴉𐴠𐴓𐴝𐴘. 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴝𐴒𐴞 𐴊𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴒𐴞𐴘𐴝𐴕𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴊𐴧𐴞𐴥𐴘𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴡𐴕𐴐𐴝𐴥𐴌 𐴎𐴝𐴕𐴑𐴝𐴌𐴞 𐴓𐴡𐴘 𐴉𐴟𐴌𐴝𐴘𐴧𐴝 𐴀𐴡𐴥𐴘𐴎𐴡𐴒𐴡𐴘 𐴉𐴝𐴥𐴕, <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴓𐴝𐴦𐴘𐴠𐴑 𐴏𐴡𐴓𐴞 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴇𐴝𐴥𐴀𐴌 𐴔𐴞𐴑𐴧𐴝𐴥𐴃𐴧𐴟 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤, 𐴘𐴝𐴥𐴕𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴕 𐴉𐴡𐴃𐴧𐴞𐴥 𐴒𐴡𐴔 𐴈𐴝𐴔𐴡𐴃𐴢 𐴉𐴡𐴥𐴓𐴢 𐴀𐴡𐴥, 𐴀𐴝𐴓𐴧𐴝𐴌𐴠 𐴎𐴠𐴃𐴡𐴥 𐴀𐴠𐴥𐴃𐴡 𐴏𐴞𐴕𐴡𐴥, <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴏𐴡𐴁𐴡𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴁𐴡𐴌𐴊𐴝𐴐𐴢 𐴃𐴝𐴥𐴑𐴞 𐴁𐴡𐴓𐴧𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴀𐴡𐴓𐴝 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴞𐴌 𐴉𐴟𐴌𐴝 𐴁𐴡𐴓𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴀𐴡𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴑𐴟𐴥𐴐𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />𐴁𐴝𐴉𐴡𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴕𐴟𐴌𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴞𐴌𐴝𐴏𐴡𐴌 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴑𐴝𐴦𐴁𐴠𐴓𐴢 𐴁𐴝𐴕𐴝𐴘𐴧𐴠𐴥. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴃𐴡 𐴀𐴝𐴣𐴀𐴌𐴝𐴌𐴠 𐴀𐴝𐴕𐴊𐴝𐴤𐴌𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴃𐴧𐴟 𐴌𐴠𐴇𐴝𐴥𐴘 𐴒𐴡𐴌𐴞𐴥 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴉𐴟𐴖𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴃𐴢 𐴉𐴝𐴌𐴒𐴝𐴌𐴝𐴥𐴘𐴉𐴠𐴓𐴝𐴘𐴧𐴠, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />𐴎𐴠 𐴉𐴟𐴖𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝 𐴌𐴠𐴇𐴝𐴥𐴘 𐴉𐴝𐴘𐴧𐴞𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴒𐴟𐴕𐴝𐴤𐴌 𐴔𐴝𐴉𐴢 𐴉𐴝𐴘𐴧𐴞𐴥.<verse eid="COL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />𐴇𐴠𐴥 𐴉𐴟𐴖𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴕𐴡𐴘𐴌𐴝𐴇𐴝𐴌 𐴀𐴝𐴓𐴧𐴝𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢; 𐴀𐴞𐴥𐴁𐴝 𐴀𐴠𐴁𐴧𐴠 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴑𐴧𐴝 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴎𐴡𐴁𐴞𐴕𐴡𐴃𐴢 𐴎𐴞𐴀𐴕 𐴊𐴝𐴈𐴝𐴤 𐴎𐴝 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴊𐴝𐴈𐴝𐴤 𐴕𐴡 𐴎𐴝 𐴊𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴁𐴠 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥𐴘𐴧𐴠, 𐴇𐴞𐴥𐴀𐴕 𐴌𐴝𐴦𐴏𐴃𐴌𐴞 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴑𐴠𐴥𐴔𐴡𐴃𐴝, 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴀𐴝𐴊𐴞𐴥𐴑𐴝𐴌; 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴓𐴧𐴝 𐴁𐴠 𐴉𐴡𐴘𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />𐴀𐴞𐴥𐴁𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴌 𐴀𐴝𐴒𐴠 𐴓𐴡𐴥𐴃𐴞 𐴀𐴝𐴏𐴠𐴤, 𐴀𐴝𐴦𐴌 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴁𐴠 𐴄𐴞𐴑𐴝𐴘 𐴌𐴝𐴑𐴠𐴥. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴒𐴝𐴦𐴌 𐴔𐴝𐴃𐴝𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴡𐴔𐴝𐴥𐴃𐴢 𐴀𐴡𐴌; 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴐𐴟𐴥𐴌𐴟 𐴀𐴝𐴦𐴌 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴉𐴡𐴀𐴘𐴓𐴝 𐴎𐴡𐴕, 𐴎𐴠𐴀𐴕𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴃𐴡𐴑𐴧𐴝 𐴖𐴡𐴌𐴠 𐴀𐴡𐴥. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴝𐴉𐴡𐴃𐴧𐴟 𐴉𐴡𐴏𐴡𐴥𐴕 𐴓𐴝𐴙𐴒𐴧𐴠𐴥 𐴊𐴠, 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴌𐴝 𐴑𐴟𐴥𐴊𐴝𐴘𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴝, <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴌 𐴖𐴡𐴌𐴠 𐴁𐴝𐴥𐴐𐴝𐴘𐴧𐴠 𐴊𐴠 𐴓𐴡𐴖𐴢 𐴖𐴡𐴥𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴐𐴝𐴥𐴕𐴃𐴞 𐴀𐴝𐴕𐴞𐴤𐴘𐴡𐴌𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴡𐴘 𐴁𐴡𐴕𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘 𐴁𐴡𐴓𐴧𐴝; 𐴇𐴞𐴥𐴀𐴕 𐴎𐴡𐴁𐴞𐴕𐴡𐴌 𐴒𐴟𐴥𐴕 𐴀𐴡𐴥𐴑 𐴘𐴝𐴥 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴒𐴟𐴥𐴕.<verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴀𐴠𐴑 𐴇𐴝𐴓𐴠 𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴊𐴟𐴌𐴠𐴥 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔 𐴀𐴠𐴊𐴧𐴠 𐴁𐴝𐴥𐴉𐴝𐴕𐴞𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴐𐴧𐴡𐴕 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴖𐴝𐴌 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴞 𐴇𐴝𐴘𐴧𐴝𐴌 𐴔𐴡𐴦𐴃𐴡𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴓𐴧𐴡𐴘 𐴁𐴡𐴕𐴝𐴘𐴉𐴠𐴥𐴓𐴝𐴘𐴧𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴕𐴞𐴎𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴂𐴝𐴑, 𐴁𐴠𐴈𐴡𐴏𐴟𐴥𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴕𐴡𐴤 𐴊𐴝𐴑 𐴏𐴝𐴥𐴌𐴝 𐴇𐴝𐴥𐴎𐴞𐴌 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝— <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />𐴎𐴡𐴊𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴢 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴁𐴟𐴕𐴞𐴘𐴝𐴊𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴡𐴌𐴡𐴤𐴒𐴡𐴌𐴞 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑𐴡, 𐴀𐴝𐴦𐴌 𐴀𐴝𐴐𐴝𐴤 𐴖𐴝𐴀𐴕𐴡𐴃𐴧𐴟 𐴓𐴡𐴌𐴞 𐴕𐴡 𐴎𐴡𐴒𐴡𐴥𐴘 𐴎𐴞𐴘𐴝𐴥𐴕 𐴉𐴟𐴥𐴙𐴕𐴧𐴡 𐴊𐴠 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌𐴡𐴃𐴧𐴟 𐴉𐴝𐴘𐴧𐴡𐴥. 𐴇𐴠𐴥 𐴑𐴟𐴥𐴐𐴈𐴡𐴥𐴁𐴡𐴌 𐴃𐴡 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴌 𐴕𐴞𐴏𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴔𐴡𐴇𐴡𐴥𐴓𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠; 𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴢 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴘𐴧𐴞.<verse eid="COL 1:23" /></para>
  <para style="s1">𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴓𐴧𐴝 𐴂𐴝𐴥𐴀𐴟𐴓𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴝𐴏𐴃𐴠𐴥 𐴊𐴟𐴑 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴉𐴝𐴙𐴌 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴑𐴟𐴥𐴐𐴞, 𐴀𐴝𐴦𐴌 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴎𐴠 𐴊𐴟𐴑-𐴔𐴡𐴏𐴞𐴁𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴞𐴥𐴁𐴝𐴌 𐴒𐴝𐴦 𐴓𐴧𐴝, 𐴘𐴝𐴥𐴕𐴞 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴓𐴧𐴝 𐴁𐴝𐴑𐴞 𐴀𐴝𐴏𐴠𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴣𐴀𐴌 𐴒𐴝𐴦𐴃𐴢 𐴓𐴡𐴘 𐴉𐴟𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴌. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴞𐴦𐴘𐴝 𐴎𐴞𐴔𐴧𐴝𐴊𐴝𐴌𐴞 𐴔𐴡𐴎𐴞𐴕 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴉𐴝𐴥𐴘𐴊𐴝𐴓𐴧𐴝 𐴇𐴠𐴥 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴡𐴥𐴘𐴧𐴞, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴝𐴓𐴝𐴔 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝, <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />𐴘𐴝𐴥𐴕𐴞 𐴒𐴟𐴉𐴡𐴕𐴞 𐴖𐴝𐴀𐴕 𐴀𐴡𐴌𐴠, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴒𐴟𐴎𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴘 𐴊𐴠 𐴃𐴝𐴔𐴝𐴥𐴔 𐴎𐴡𐴁𐴝𐴕𐴝 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴏𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴓𐴟𐴑𐴝𐴘 𐴌𐴝𐴑𐴝𐴤 𐴒𐴞𐴥𐴀𐴓𐴢, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴘𐴝𐴓𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴂𐴝𐴑 𐴁𐴡𐴕𐴊𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />𐴀𐴝𐴓𐴧𐴝𐴃𐴧𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴘𐴧𐴠𐴥 𐴊𐴠, 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴇𐴠𐴥 𐴒𐴟𐴉𐴡𐴕𐴞 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴔𐴡𐴈𐴞𐴥𐴔𐴝 𐴇𐴡𐴃𐴡𐴥 𐴋𐴡𐴣𐴀𐴌. 𐴇𐴠𐴥 𐴒𐴟𐴉𐴡𐴕𐴞 𐴀𐴡𐴥𐴙𐴓𐴊𐴠, 𐴔𐴡𐴀𐴏𐴞𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴁𐴝𐴥𐴒𐴞 𐴀𐴡𐴥𐴘𐴁𐴝𐴌 𐴀𐴝𐴐𐴝𐴤.<verse eid="COL 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="COL 1:28" />𐴀𐴝𐴣𐴀𐴌𐴝 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴉𐴟𐴌𐴝 𐴒𐴞𐴘𐴝𐴕𐴠 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴞 𐴊𐴞𐴥 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴡𐴌𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠, 𐴎𐴠𐴀𐴕𐴠 𐴉𐴡𐴃𐴧𐴞𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴁𐴝𐴓𐴡𐴑 𐴇𐴝𐴥𐴓𐴡𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴇𐴝𐴥𐴎𐴞𐴌 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />𐴇𐴠𐴥 𐴕𐴞𐴘𐴡𐴃𐴠 𐴀𐴝𐴀𐴛 𐴎𐴝𐴕-𐴉𐴡𐴌𐴝𐴕 𐴊𐴞 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴡 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴡𐴌 𐴁𐴡𐴓𐴠 𐴎𐴠 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴢 𐴀𐴝𐴣𐴀𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴟𐴌𐴠𐴏𐴟𐴥𐴌𐴠 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥𐴌.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴘𐴝𐴀𐴕 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴃𐴡 𐴔𐴡𐴕𐴠𐴈𐴡𐴀𐴌 𐴊𐴠 𐴑𐴞, 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝, 𐴓𐴝𐴀𐴟𐴥𐴊𐴞𐴑𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴀𐴝𐴣𐴀𐴌𐴠𐴥 𐴔𐴟𐴑 𐴊𐴠𐴈𐴝𐴥 𐴕𐴡𐴥 𐴊𐴠𐴑𐴠𐴥 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴇𐴡𐴃𐴡𐴥 𐴁𐴞𐴐𐴞𐴤 𐴔𐴠𐴀𐴕𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴌, <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴠 𐴀𐴠𐴑 𐴀𐴡𐴥𐴘𐴎𐴝𐴘 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴅𐴡𐴏𐴁𐴝 𐴉𐴝𐴦, 𐴀𐴝𐴦𐴌 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴁𐴟𐴎𐴝𐴥𐴌𐴃𐴧𐴟 𐴎𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴝𐴑𐴧𐴝𐴘𐴞 𐴉𐴡𐴘𐴊𐴝 𐴀𐴡𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴊𐴡𐴥𐴕 𐴇𐴝𐴥𐴏𐴞𐴓𐴢 𐴒𐴡𐴌𐴠𐴥. 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴟𐴉𐴡𐴕𐴞 𐴎𐴝𐴕𐴞𐴁𐴡𐴥, 𐴘𐴝𐴥𐴕𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌𐴠 𐴏𐴞𐴕𐴞𐴥𐴁𐴡, <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴕𐴞𐴥𐴑𐴞 𐴒𐴞𐴘𐴝𐴕 𐴀𐴠𐴊𐴧𐴠 𐴁𐴟𐴊𐴧𐴞𐴥𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴊𐴡𐴥𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴈𐴡𐴀𐴙𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴔𐴞𐴍𐴝𐴤-𐴔𐴞𐴍𐴝𐴤 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴈𐴡𐴀𐴘𐴢 𐴊𐴟𐴥𐴑𐴝 𐴊𐴞𐴥 𐴕𐴡 𐴉𐴝𐴌𐴠. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴀𐴝𐴀𐴛 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴇𐴝𐴥𐴎𐴞𐴌 𐴕𐴝𐴥𐴘 𐴊𐴠 𐴀𐴡𐴥𐴘𐴓𐴠 𐴘𐴡, 𐴌𐴟𐴀𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴏𐴞𐴤. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴄𐴞𐴥𐴑 𐴏𐴡𐴓𐴝𐴏𐴡𐴓𐴢 𐴀𐴠𐴊𐴧𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴖𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴞𐴔𐴝𐴕𐴡𐴌 𐴔𐴡𐴎𐴁𐴟𐴃𐴞 𐴊𐴠𐴑𐴞𐴥 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴁𐴞𐴐𐴞𐴤 𐴑𐴟𐴥𐴐𐴞 𐴓𐴝𐴒𐴠𐴌.<verse eid="COL 2:5" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴎𐴞𐴕𐴊𐴞𐴒𐴞</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴇𐴡𐴥𐴕 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌𐴠 𐴔𐴝𐴓𐴞𐴑 𐴊𐴠 𐴑𐴡𐴁𐴟𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴃𐴡𐴥𐴘 𐴀𐴞𐴥𐴁𐴝 𐴓𐴧𐴡𐴥𐴘 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑𐴞 𐴏𐴡𐴓𐴡, <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴐𐴞𐴥𐴛𐴡𐴌 𐴒𐴝𐴏𐴝𐴤𐴘 𐴀𐴠𐴊𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴖𐴡𐴌𐴠 𐴁𐴡𐴕𐴞 𐴀𐴟𐴍𐴞𐴤𐴘𐴡𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴐𐴞𐴥𐴑𐴝 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴀𐴞𐴔𐴝𐴕𐴡𐴃𐴢 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴘𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴞𐴥𐴘𐴡𐴌𐴠.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌, 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴃𐴝𐴦𐴓𐴞𐴔𐴠 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴇𐴝𐴌 𐴊𐴟𐴥𐴑𐴝𐴁𐴝𐴎𐴞 𐴓𐴡𐴥𐴘 𐴐𐴞𐴥𐴑𐴝𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠 𐴉𐴝𐴥𐴕, 𐴎𐴞𐴀𐴕 𐴀𐴝𐴘𐴧𐴠𐴤 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴌𐴡𐴏𐴡𐴥𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴀𐴠𐴊𐴧𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴁𐴟𐴥𐴃𐴢-𐴉𐴠𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴡𐴃𐴧𐴟; 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴕𐴡.<verse eid="COL 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 2:9" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝­-𐴈𐴡𐴘𐴓𐴠𐴥 𐴉𐴟𐴌𐴝 𐴀𐴞𐴓𐴧𐴝𐴘𐴞 𐴀𐴞𐴥𐴁𐴝𐴌 𐴇𐴝𐴘𐴧𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴝𐴥𐴑𐴠, <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴉𐴟𐴌𐴟𐴏𐴧𐴝𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠. 𐴀𐴞𐴥𐴁𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴇𐴝𐴥𐴀𐴌 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴊𐴞𐴑𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴔𐴝𐴃𐴝𐴥. <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />𐴀𐴞𐴥𐴁𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴘𐴡𐴥 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠; 𐴇𐴠𐴥 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴇𐴞𐴥𐴘𐴝𐴕 𐴇𐴡𐴕𐴡𐴤 𐴀𐴝𐴥𐴃𐴠 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠 𐴊𐴠 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴡𐴀𐴏𐴞𐴤 𐴕𐴞𐴎𐴠 𐴁𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴖𐴡𐴌𐴠 𐴒𐴟𐴕𐴝𐴤 𐴀𐴡𐴓𐴝 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴡𐴌 𐴎𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢, 𐴇𐴠𐴥 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴡𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴝𐴎𐴝𐴊𐴢 𐴒𐴡𐴙𐴅𐴧𐴠𐴥. <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴁𐴝𐴥𐴂𐴄𐴞𐴏𐴔𐴝 𐴓𐴡𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴊𐴡𐴇𐴡𐴥𐴕 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝 𐴒𐴞𐴥𐴘𐴠, 𐴀𐴝𐴦𐴌 𐴎𐴞𐴁𐴝𐴤𐴘𐴠 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴔𐴡𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴇𐴠𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴑𐴟𐴊𐴟𐴌𐴟𐴃𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴞𐴔𐴝𐴕 𐴀𐴝𐴕𐴡𐴤𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴊𐴟𐴖𐴝𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴘𐴡𐴥 𐴒𐴞𐴘𐴠𐴥.<verse eid="COL 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="COL 2:13" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴒𐴟𐴕𐴝𐴤𐴘𐴠 𐴀𐴠𐴊𐴧𐴠 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴁𐴠-𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴇𐴝𐴥𐴓𐴡𐴃𐴠 𐴔𐴡𐴌𐴝 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴝, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴃𐴡 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴃𐴝𐴔𐴝𐴥𐴔 𐴒𐴟𐴕𐴝𐴤-𐴇𐴝𐴥𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴡𐴌𐴠, <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴟𐴓𐴋𐴝 𐴎𐴠 𐴊𐴡𐴓𐴞𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴀𐴝𐴐𐴧𐴞𐴥𐴓𐴢 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴊𐴝𐴁𐴞-𐴊𐴝𐴖𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴁𐴝𐴦𐴃𐴠𐴓𐴢 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴡𐴌𐴠. 𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴠𐴥 𐴊𐴡𐴓𐴞𐴓𐴡𐴌𐴠 𐴑𐴟𐴥𐴌𐴟𐴐𐴡𐴃𐴢 𐴎𐴡𐴓𐴡𐴘 𐴔𐴝𐴌𐴞 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />𐴀𐴞𐴥𐴁𐴝𐴘𐴠 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴊𐴞𐴑𐴝𐴌𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴑𐴠𐴥𐴔𐴡𐴃𐴝 𐴏𐴝𐴥𐴌𐴝 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴠, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴃𐴧𐴟 𐴎𐴞𐴃𐴞𐴘𐴡𐴌𐴠 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌𐴠 𐴐𐴡𐴥𐴌𐴔𐴞𐴕𐴊𐴝 𐴒𐴡𐴙𐴅𐴧𐴠𐴥.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴈𐴝𐴥𐴕𐴝-𐴉𐴞𐴕𐴝𐴌, 𐴇𐴡𐴕𐴡𐴤 𐴀𐴞𐴊𐴢 𐴀𐴡𐴌, 𐴀𐴡𐴛𐴐𐴧𐴝𐴥𐴌, 𐴘𐴝𐴥 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢-𐴀𐴡𐴌-𐴊𐴞𐴕𐴡𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴏𐴟𐴥𐴌𐴞 𐴕𐴡 𐴊𐴡𐴑. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴀𐴕 𐴃𐴡 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴔𐴟𐴀𐴕𐴃𐴟 𐴀𐴝𐴘𐴁𐴡𐴤 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴏𐴝𐴥𐴁𐴝 𐴀𐴠𐴥𐴕𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴀𐴝𐴏𐴡𐴥𐴓𐴞𐴘𐴡𐴃𐴢 𐴃𐴡 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />𐴏𐴝𐴘𐴧𐴡𐴥, 𐴎𐴠𐴃𐴝𐴌𐴝𐴤 𐴔𐴞𐴏𐴝𐴥 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴑𐴟𐴥𐴖𐴝𐴓𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴉𐴞𐴥𐴌𐴞𐴏𐴃𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥𐴌𐴠 𐴉𐴡𐴏𐴡𐴥𐴕 𐴒𐴡𐴌𐴠𐴥, 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴡𐴃𐴧𐴟 𐴔𐴝𐴀𐴌𐴟𐴔 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴝𐴘 𐴕𐴡 𐴉𐴝𐴌𐴠 𐴉𐴝𐴥𐴕. 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴊𐴠𐴔𐴝𐴑𐴠 𐴇𐴝𐴥𐴕𐴧𐴝𐴑 𐴉𐴟𐴥𐴓𐴞𐴎𐴝𐴘, 𐴊𐴠𐴙𐴑𐴧𐴠𐴥 𐴊𐴠 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴋𐴡𐴣𐴀𐴌-𐴋𐴡𐴣𐴀𐴌 𐴒𐴡𐴉𐴢 𐴔𐴝𐴌𐴠. <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴔𐴝𐴃𐴝𐴥𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴡𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴡𐴥𐴌𐴞 𐴕𐴡𐴥 𐴌𐴝𐴑𐴠𐴥, 𐴎𐴞𐴁𐴝𐴤𐴃𐴧𐴟 𐴔𐴡𐴊𐴡𐴃𐴢 𐴓𐴡𐴦𐴘𐴢 𐴒𐴝𐴦 𐴒𐴟𐴣𐴍𐴝 𐴒𐴞𐴌𐴝𐴤 𐴀𐴠𐴊𐴧𐴠 𐴌𐴡𐴒𐴄𐴝𐴕𐴝 𐴓𐴡𐴘 𐴎𐴟𐴌𐴝𐴎𐴟𐴙𐴅𐴧𐴝 𐴃𐴝𐴥𐴑𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴌𐴝𐴤𐴘𐴧𐴠 𐴁𐴝𐴌𐴠𐴥.<verse eid="COL 2:19" /></para>
  <para style="s1">𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴌𐴝 𐴀𐴠𐴊𐴧𐴠 𐴎𐴞𐴕𐴊𐴝 𐴀𐴡𐴥𐴖𐴝</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴊𐴠 𐴊𐴟𐴕𐴞𐴘𐴝𐴘 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴠𐴥 𐴊𐴠 𐴁𐴟𐴥𐴃𐴢-𐴉𐴠𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴃𐴧𐴟 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴒𐴡𐴘, 𐴃𐴡𐴥𐴘 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴙𐴅𐴧𐴡𐴤 𐴑𐴞𐴘𐴝𐴥 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴒𐴡𐴥𐴌𐴞 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴕𐴞𐴘𐴡𐴔-𐴑𐴝𐴦𐴕𐴟𐴕𐴠 𐴏𐴡𐴓𐴡𐴀𐴌, 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />”𐴘𐴝𐴀𐴕 𐴕𐴡 𐴊𐴡𐴥𐴌𐴞𐴘𐴡! 𐴖𐴝𐴀𐴕 𐴕𐴝 𐴈𐴝𐴥𐴘𐴧𐴡! 𐴘𐴝𐴀𐴕 𐴕𐴡 𐴏𐴟𐴥𐴛𐴘𐴡!“ <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />𐴇𐴞𐴥𐴀𐴕 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴞𐴎𐴢 𐴀𐴟𐴀𐴙𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴓𐴧𐴝 𐴎𐴞𐴀𐴕 𐴀𐴠𐴏𐴃𐴠𐴔𐴝𐴓𐴢 𐴒𐴡𐴙𐴃𐴧𐴠𐴤-𐴒𐴡𐴙𐴃𐴧𐴠𐴤 𐴁𐴡𐴌𐴁𐴝𐴊𐴢 𐴀𐴡𐴥𐴘𐴎𐴝𐴘𐴁𐴝𐴌 𐴀𐴝𐴏𐴠𐴤; 𐴇𐴞𐴥𐴀𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴌 𐴇𐴡𐴥𐴑𐴟𐴔 𐴀𐴠𐴊𐴧𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />𐴁𐴠𐴐𐴡𐴥𐴑 𐴕𐴞𐴘𐴡𐴔 𐴇𐴞𐴥𐴀𐴕𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴁𐴝𐴕𐴝𐴘𐴧𐴝 𐴀𐴠𐴁𐴝𐴦𐴊𐴡𐴃𐴡𐴌 𐴃𐴡𐴌𐴞𐴑𐴝, 𐴔𐴞𐴏𐴝𐴥 𐴕𐴞𐴌𐴡𐴥𐴐𐴢 𐴑𐴟𐴥𐴖𐴝𐴓𐴝, 𐴀𐴠𐴊𐴧𐴠 𐴕𐴞𐴎𐴡𐴌 𐴒𐴝𐴦𐴌𐴠 𐴊𐴝𐴁𐴡𐴃𐴢 𐴌𐴝𐴑𐴝𐴤 𐴐𐴞𐴥𐴑𐴝, 𐴇𐴞𐴥𐴀𐴕 𐴏𐴝𐴘𐴃𐴠𐴥 𐴒𐴞𐴘𐴝𐴕𐴠 𐴁𐴡𐴥𐴌𐴝, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴅𐴞𐴏𐴞𐴥𐴔𐴡𐴌 𐴀𐴝𐴎𐴧𐴟 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴁𐴡𐴕 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴇𐴞𐴥𐴀𐴕𐴠 𐴇𐴡𐴕𐴡𐴤 𐴉𐴝𐴥𐴘𐴊𐴝 𐴕𐴡 𐴊𐴠.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴞𐴕𐴊𐴝 𐴒𐴡𐴌𐴝𐴥 𐴒𐴞𐴥𐴘𐴠, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴀𐴙𐴕𐴡𐴌 𐴃𐴝𐴓𐴝𐴐𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴡 𐴎𐴞𐴀𐴕 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴍𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴝𐴓𐴧𐴝𐴌 𐴊𐴠𐴕 𐴋𐴝𐴥𐴑𐴡𐴃𐴧𐴟 𐴁𐴡𐴘𐴍𐴝𐴤 𐴀𐴝𐴏𐴠𐴤. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴑𐴞𐴥𐴘𐴝𐴓𐴢 𐴀𐴝𐴏𐴔𐴝𐴕𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴌𐴝𐴑𐴡𐴥, 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴒𐴟𐴥𐴕𐴡𐴌 𐴀𐴟𐴎𐴟 𐴕𐴡. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴔𐴡𐴌𐴞𐴒𐴞𐴘𐴡𐴥𐴒𐴡𐴘, 𐴀𐴝𐴦𐴌 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴓𐴟𐴑𐴝𐴘𐴧𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴔𐴡𐴀𐴏𐴞𐴤, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴎𐴞𐴕𐴊𐴞𐴒𐴞, 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴡, 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴞𐴥𐴁𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴡𐴈𐴞𐴥𐴔𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴝𐴇𐴠𐴥𐴌 𐴀𐴡𐴥𐴘𐴁𐴝.<verse eid="COL 3:4" /></para>
  <para style="s1">𐴉𐴟𐴌𐴝𐴕𐴝 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴘𐴝 𐴎𐴞𐴕𐴊𐴞𐴒𐴞</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴔𐴝𐴌𐴞𐴉𐴠𐴥𐴓𐴡, 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴕𐴞𐴑𐴞, 𐴎𐴠𐴕𐴝𐴤𐴑𐴝𐴌𐴞, 𐴕𐴝𐴉𐴝𐴑𐴞, 𐴑𐴟𐴑𐴞𐴥𐴘𐴝𐴓𐴢, 𐴁𐴟𐴌𐴝 𐴔𐴡𐴕𐴐𐴝𐴥, 𐴀𐴠𐴊𐴧𐴠 𐴓𐴝𐴓𐴏𐴞𐴥 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴔𐴟𐴃𐴧𐴞 𐴉𐴟𐴣𐴎𐴝 𐴓𐴡𐴘 𐴁𐴡𐴌𐴝𐴁𐴡𐴌. <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴕𐴝𐴉𐴡𐴥𐴌𐴔𐴝𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴖𐴡𐴌𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴒𐴡𐴎𐴧𐴡𐴁𐴢 𐴃𐴡 𐴇𐴞𐴥𐴀𐴕𐴡𐴌 𐴎𐴡𐴌𐴞𐴘𐴝 𐴀𐴠𐴥𐴕𐴝 𐴀𐴝𐴘𐴧𐴠𐴤𐴌, <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />𐴎𐴞𐴀𐴕𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴘𐴡𐴥 𐴀𐴠𐴑 𐴇𐴝𐴓𐴠 𐴏𐴡𐴙𐴓𐴧𐴞𐴥𐴓𐴝, 𐴎𐴠𐴣𐴃𐴧𐴠𐴥 𐴕𐴞𐴥𐴑𐴞 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴀𐴕 𐴔𐴡𐴎𐴞𐴕 𐴎𐴞𐴕𐴊𐴞𐴒𐴞 𐴈𐴝𐴍𐴝𐴀𐴘𐴓𐴝. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />𐴓𐴠𐴑𐴞𐴕 𐴘𐴝𐴓𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴀𐴞𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴀𐴡𐴥 𐴊𐴟𐴌 𐴒𐴡𐴌𐴞𐴥𐴉𐴠𐴓𐴡: 𐴒𐴟𐴐𐴧𐴝𐴤, 𐴌𐴝𐴑, 𐴊𐴟𐴐𐴧𐴡𐴕𐴞, 𐴁𐴡𐴊𐴕𐴝𐴔𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴔𐴟𐴑𐴡𐴃𐴧𐴟 𐴁𐴠𐴌𐴠𐴙𐴅𐴧𐴝 𐴈𐴡𐴃𐴝𐴤 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴔𐴞𐴏𐴝𐴥 𐴈𐴡𐴃𐴝𐴤 𐴕𐴡 𐴈𐴡𐴘𐴧𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴌𐴝𐴕𐴝 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴡𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴇𐴡𐴥𐴌𐴑𐴡𐴃𐴢 𐴐𐴡𐴥𐴀 𐴑𐴟𐴥𐴓𐴞 𐴉𐴠𐴥𐴓𐴝𐴘𐴊𐴞𐴘𐴡, <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />𐴀𐴝𐴦𐴌 𐴕𐴡𐴘𐴝 𐴉𐴞𐴥𐴃𐴡𐴌𐴡𐴃𐴡𐴌𐴠 𐴉𐴞𐴣𐴊𐴞𐴥𐴉𐴠𐴓𐴝𐴘𐴧𐴡, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴌 𐴁𐴝𐴕𐴞𐴌 𐴏𐴟𐴥𐴌𐴡𐴃𐴢 𐴔𐴡𐴎𐴞𐴕 𐴕𐴡𐴘𐴝 𐴒𐴡𐴌𐴝𐴥 𐴎𐴝𐴥𐴃𐴢 𐴀𐴝𐴏𐴠𐴤, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴞𐴥𐴁𐴝𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴎𐴝𐴕𐴡. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />𐴇𐴞𐴥𐴘𐴝𐴕𐴡𐴃𐴢 𐴁𐴠𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴠𐴊𐴧𐴠 𐴘𐴡𐴇𐴟𐴥𐴊𐴞𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠, 𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠-𐴀𐴝𐴥𐴎𐴡𐴔𐴞 𐴒𐴡𐴙𐴅𐴧𐴝𐴥𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠, 𐴁𐴞𐴊𐴠𐴐𐴡𐴥𐴙𐴃𐴧𐴝, 𐴒𐴝𐴛𐴘𐴝, 𐴒𐴟𐴓𐴝𐴔, 𐴀𐴠𐴊𐴧𐴠 𐴁𐴠𐴒𐴟𐴓𐴝𐴔𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴡𐴕𐴡𐴤 𐴉𐴡𐴌𐴡𐴥𐴑 𐴕𐴝𐴥𐴘, 𐴔𐴡𐴕𐴃𐴡𐴌 𐴔𐴡𐴀𐴏𐴞𐴤 𐴁𐴠 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥, 𐴀𐴝𐴦𐴌 𐴀𐴞𐴥𐴁𐴝 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴏𐴠𐴤.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />𐴇𐴠𐴥𐴃𐴡𐴓𐴧𐴝, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴠𐴃𐴧𐴡𐴥𐴃𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴁𐴝𐴙𐴐𐴧𐴝𐴥, 𐴂𐴝𐴑 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴊𐴡𐴌𐴁𐴡𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴉𐴠𐴄𐴉𐴟𐴌𐴝𐴕𐴞, 𐴔𐴠𐴀𐴌𐴁𐴝𐴕𐴞, 𐴕𐴞𐴌𐴡𐴥𐴐𐴞, 𐴐𐴞𐴥𐴊𐴝𐴘𐴞, 𐴀𐴠𐴊𐴧𐴠 𐴏𐴡𐴁𐴡𐴥𐴌 𐴓𐴡𐴥𐴘 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴌𐴠 𐴇𐴝𐴥𐴣𐴎𐴡. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌 𐴁𐴡𐴥𐴌 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴐𐴡𐴥𐴀, 𐴀𐴝𐴦𐴌 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴃𐴧𐴟 𐴇𐴡𐴕𐴡𐴤𐴑𐴞𐴘𐴡𐴌 𐴀𐴟𐴓𐴋𐴝 𐴐𐴠𐴥𐴑𐴝𐴘𐴡𐴃𐴢 𐴃𐴝𐴥𐴑𐴞𐴓𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴡; 𐴔𐴝𐴓𐴞𐴑𐴠 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴃𐴧𐴟 𐴘𐴡𐴥 𐴔𐴝𐴉𐴢 𐴒𐴡𐴌𐴞𐴥𐴊𐴞𐴘𐴝𐴌 𐴎𐴡𐴌𐴟𐴌. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />𐴇𐴞𐴥𐴀𐴕 𐴁𐴠𐴒𐴧𐴟𐴥𐴕𐴡𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴓𐴡𐴥𐴘 𐴘𐴡𐴥 𐴇𐴝𐴥𐴣𐴎𐴡, 𐴎𐴞𐴘𐴝𐴥𐴕 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴠𐴑𐴃𐴡𐴉𐴝𐴥𐴑𐴞𐴌 𐴁𐴝𐴕.<verse eid="COL 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 3:15" />𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴐𐴝𐴥𐴕𐴃𐴞𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴇𐴡𐴥𐴑𐴟𐴔𐴡𐴃𐴢 𐴒𐴡𐴙𐴃𐴧𐴡𐴥 𐴊𐴡𐴥, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴇𐴠𐴥 𐴐𐴝𐴥𐴕𐴃𐴞𐴃𐴢 𐴀𐴠𐴑 𐴒𐴝𐴦 𐴀𐴡𐴥𐴘 𐴁𐴡𐴓𐴧𐴝 𐴀𐴠𐴥𐴕𐴝 𐴋𐴝𐴈𐴝 𐴒𐴞𐴘𐴠𐴥; 𐴀𐴝𐴦𐴌 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴃𐴝𐴥𐴑𐴡. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴑𐴝𐴓𐴝𐴔𐴡𐴌𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴃𐴝𐴥𐴑𐴞𐴃𐴡 𐴊𐴡𐴥, 𐴃𐴝𐴔𐴝𐴥𐴔 𐴒𐴞𐴘𐴝𐴕𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴡𐴌𐴠 𐴀𐴠𐴎𐴧𐴡𐴕𐴠 𐴃𐴝𐴦𐴓𐴞𐴔 𐴊𐴞𐴘𐴡𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴡𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴕𐴞𐴎𐴡𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝𐴌 𐴕𐴞𐴘𐴡𐴃𐴢 𐴌𐴝𐴑𐴞𐴥 𐴀𐴝𐴓𐴧𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴎𐴡𐴁𐴟𐴌 𐴐𐴡𐴥𐴌𐴞𐴉𐴡𐴌 𐴑𐴝𐴖𐴝𐴓𐴞, 𐴏𐴠𐴀𐴌, 𐴀𐴠𐴊𐴧𐴠 𐴌𐴟𐴀𐴈𐴝𐴥𐴕𐴞𐴌 𐴒𐴡𐴎𐴡𐴥𐴓𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴒𐴝𐴀𐴘𐴧𐴡𐴌𐴠. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴈𐴡𐴘𐴁𐴝𐴤 𐴈𐴡𐴀 𐴀𐴝𐴦𐴌 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴒𐴡𐴌𐴡𐴤, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥 𐴔𐴝𐴓𐴞𐴑 𐴀𐴞𐴏𐴝𐴤𐴌 𐴕𐴝𐴔𐴠 𐴁𐴠 𐴒𐴡𐴙𐴅𐴧𐴡𐴥, 𐴀𐴝𐴦𐴌 𐴇𐴠𐴥𐴣𐴃𐴧𐴠 𐴀𐴞𐴥𐴁𐴝𐴌 𐴀𐴟𐴏𐴞𐴥𐴓𐴝𐴘𐴠 𐴁𐴝𐴉𐴢 𐴀𐴝𐴓𐴧𐴝𐴌 𐴐𐴟𐴥𐴑𐴟𐴌 𐴀𐴡𐴥 𐴒𐴡𐴙𐴅𐴧𐴡𐴥.<verse eid="COL 3:17" /></para>
  <para style="s1">𐴀𐴞𐴏𐴝𐴤𐴘𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴉𐴡𐴥𐴌𐴡𐴏𐴢</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />𐴁𐴡𐴖𐴝𐴥𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌𐴠𐴥 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴇𐴡𐴥𐴐𐴡𐴔𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴒𐴡𐴏𐴝𐴥𐴘𐴊𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴌𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴄𐴞𐴥𐴑 𐴈𐴝𐴔.<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />𐴇𐴡𐴥𐴐𐴡𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴕𐴞𐴎𐴡𐴌-𐴕𐴞𐴎𐴡𐴌 𐴁𐴡𐴖𐴢 𐴖𐴡𐴥𐴌𐴠 𐴔𐴟𐴇𐴝𐴥𐴁𐴧𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴃𐴞𐴃𐴝 𐴕𐴡 𐴀𐴡𐴥𐴘𐴧𐴡.<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />𐴉𐴟𐴀𐴝𐴙𐴕 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴝𐴉𐴔𐴝𐴦𐴌 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝 𐴔𐴝𐴕𐴡, 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴇𐴞𐴥𐴘𐴝𐴕𐴠 𐴔𐴝𐴓𐴞𐴑 𐴑𐴟𐴥𐴐𐴞 𐴀𐴡𐴥.<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />𐴁𐴝𐴉𐴝𐴥𐴙𐴕,<note caller="+" style="f"><char style="fr" closed="false">3‏:21 </char><char style="ft" closed="false">𐴘𐴝𐴥𐴃𐴡 </char><char style="fqa" closed="false">𐴁𐴝𐴉𐴔𐴝𐴦 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 </char></note> 𐴕𐴞𐴎𐴡𐴌 𐴉𐴟𐴀𐴝𐴙𐴕 𐴊𐴡𐴌𐴠 𐴕𐴡 𐴎𐴝𐴓𐴝𐴘𐴧𐴡𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴌 𐴊𐴞𐴓𐴢 𐴕𐴡 𐴁𐴝𐴥𐴚𐴒𐴠.<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴇𐴝𐴥𐴀𐴌 𐴑𐴠𐴏𐴧𐴟𐴥𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴟𐴕𐴞𐴘𐴝𐴘𐴁𐴞 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝 𐴔𐴝𐴕𐴡, 𐴔𐴝𐴙𐴕𐴐𐴡𐴥𐴌𐴠 𐴑𐴟𐴥𐴐𐴞 𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴋𐴡𐴥𐴙𐴓𐴧𐴝 𐴊𐴝𐴈𐴝𐴤𐴘 𐴁𐴡𐴓𐴧𐴝 𐴕𐴡, 𐴁𐴡𐴥𐴓𐴑𐴠 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴋𐴡𐴦𐴌 𐴌𐴝𐴑𐴞𐴥 𐴊𐴞𐴓𐴡𐴌 𐴀𐴠𐴈𐴠𐴥𐴓𐴝𐴏𐴞𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴡𐴤. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴎𐴞𐴀𐴕 𐴒𐴡𐴌𐴡𐴤 𐴇𐴞𐴥𐴀𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴉𐴟𐴌𐴝 𐴊𐴞𐴓𐴔𐴡𐴕 𐴊𐴞 𐴒𐴡𐴌𐴡𐴤, 𐴎𐴠𐴀𐴕 𐴕𐴞𐴥𐴑𐴞 𐴔𐴝𐴓𐴞𐴑𐴡𐴓𐴧𐴝 𐴁𐴠 𐴒𐴡𐴌𐴡𐴤𐴌, 𐴀𐴞𐴕𐴏𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴕𐴡. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴃𐴡𐴌𐴉𐴡𐴥𐴃𐴧𐴟 𐴔𐴞𐴌𐴝𐴏𐴢 𐴁𐴡𐴐𐴧𐴞𐴥𐴐𐴢 𐴉𐴝𐴘𐴁𐴝. 𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴔𐴝𐴓𐴞𐴑 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴀𐴠𐴥𐴕𐴝 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴡𐴤𐴌. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />𐴑𐴞𐴘𐴡𐴥𐴓𐴧𐴝-𐴈𐴡𐴘𐴓𐴠𐴥 𐴎𐴠𐴦𐴕𐴞𐴑𐴞 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔 𐴒𐴡𐴌𐴠𐴥 𐴀𐴞𐴥𐴃𐴠 𐴕𐴞𐴎𐴠 𐴒𐴡𐴙𐴅𐴧𐴠𐴥 𐴊𐴠 𐴇𐴠𐴥 𐴁𐴟𐴌𐴝 𐴈𐴝𐴔𐴡𐴌 𐴕𐴡𐴃𐴞𐴎𐴝 𐴉𐴝𐴘𐴁𐴡, 𐴇𐴠𐴥𐴍𐴠 𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴑𐴃𐴡𐴌𐴉𐴞𐴥𐴘𐴝 𐴕𐴝𐴥𐴘.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌𐴠 𐴀𐴞𐴕𐴏𐴝𐴥𐴉𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴡𐴥𐴑 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴙𐴅𐴧𐴡𐴥; 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴃𐴡 𐴎𐴝𐴕𐴡, 𐴀𐴝𐴏𐴔𐴝𐴕𐴡𐴃𐴢 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴀𐴡𐴥 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴒𐴞𐴌𐴡𐴥𐴏𐴢 𐴀𐴝𐴏𐴠𐴤.<verse eid="COL 4:1" /></para>
  <para style="s1">𐴕𐴡𐴏𐴞𐴥𐴘𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴟𐴥𐴣𐴐𐴞𐴘𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴐𐴟𐴥𐴑𐴟𐴌𐴞𐴘𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴝𐴥𐴃𐴢 𐴓𐴝𐴒𐴞 𐴃𐴝𐴥𐴑𐴡, <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />𐴀𐴝𐴦𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞-𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴘𐴡𐴥 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴊𐴠, 𐴀𐴝𐴓𐴧𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌𐴝𐴓𐴧𐴝 𐴑𐴝𐴓𐴝𐴔 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥𐴁𐴝𐴌 𐴊𐴟𐴖𐴝𐴌 𐴑𐴟𐴥𐴓𐴠 𐴉𐴝𐴥𐴕, 𐴎𐴠𐴀𐴕𐴠 𐴀𐴝𐴣𐴀𐴌𐴝 𐴔𐴡𐴀𐴏𐴞𐴤𐴌 𐴒𐴟𐴉𐴡𐴕𐴞𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴡𐴁𐴡𐴓𐴞𐴑 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞, 𐴎𐴞𐴘𐴝𐴥𐴕𐴡𐴓𐴧𐴝 𐴁𐴡𐴓𐴞 𐴀𐴝𐴀𐴛 𐴁𐴡𐴕 𐴀𐴝𐴏𐴞𐴤; <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />𐴀𐴝𐴌𐴡𐴤 𐴒𐴡𐴌𐴞𐴥𐴁𐴝 𐴊𐴠, 𐴀𐴝𐴀𐴛 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴏𐴝𐴥𐴉𐴢-𐴏𐴝𐴥𐴉𐴢 𐴒𐴡𐴥𐴌𐴞 𐴁𐴡𐴘𐴧𐴝𐴕 𐴒𐴡𐴌𐴞𐴥 𐴉𐴝𐴌𐴞 𐴉𐴝𐴥𐴕 𐴎𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴀𐴝𐴣𐴀𐴃𐴧𐴟 𐴒𐴡𐴌𐴝𐴥𐴌 𐴎𐴡𐴌𐴟𐴌. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />𐴇𐴡𐴕𐴡𐴤 𐴀𐴠𐴒𐴧𐴗𐴝𐴤 𐴔𐴡𐴑𐴝 𐴕𐴡 𐴇𐴝𐴥𐴌𐴝𐴘, 𐴃𐴡𐴌𐴞𐴑𐴝𐴌 𐴁𐴝𐴀𐴌𐴒𐴗𐴝 𐴔𐴝𐴕𐴟𐴥𐴙𐴐𐴢 𐴓𐴡𐴥𐴘 𐴊𐴠𐴔𐴝𐴑 𐴇𐴝𐴥𐴍𐴝𐴘 𐴏𐴡𐴓𐴞𐴘𐴡𐴥. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴈𐴡𐴃𐴝𐴤𐴁𐴝𐴃𐴧𐴝𐴌𐴝𐴃𐴢 𐴕𐴟𐴕 𐴊𐴞𐴦𐴘𐴠𐴥 𐴉𐴝𐴥𐴕 𐴔𐴡𐴎𐴝 𐴃𐴝𐴥𐴑𐴝𐴌 𐴎𐴡𐴌𐴟𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴝𐴌𐴠𐴤 𐴇𐴡𐴕𐴊𐴞𐴓𐴧𐴝 𐴒𐴡𐴌𐴞 𐴎𐴟𐴖𐴝𐴁𐴢 𐴊𐴞𐴘𐴝 𐴉𐴡𐴌𐴞𐴁𐴡𐴥 𐴊𐴠 𐴎𐴝𐴕𐴡.<verse eid="COL 4:6" /></para>
  <para style="s1">𐴀𐴝𐴇𐴠𐴥𐴌𐴞 𐴏𐴡𐴥𐴓𐴝𐴔</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />𐴀𐴝𐴣𐴀𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴈𐴡𐴘𐴃𐴡𐴤 𐴏𐴝𐴘𐴓𐴠𐴥, 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴁𐴝𐴥𐴘 𐴃𐴟𐴑𐴞𐴑𐴟𐴏𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴀𐴠𐴥𐴎𐴧𐴡𐴕 𐴁𐴞𐴐𐴧𐴝𐴥𐴐𐴊𐴝𐴌 𐴈𐴝𐴥𐴀𐴊𐴠𐴔 𐴀𐴝𐴦𐴌 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴀𐴝𐴣𐴀𐴌 𐴈𐴡𐴥𐴁𐴡𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴎𐴝𐴕𐴝𐴘𐴁𐴡𐴥. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />𐴀𐴝𐴀𐴛 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴀𐴠𐴃𐴡𐴓𐴧𐴝𐴤 𐴁𐴠 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴝𐴣𐴀𐴌𐴝𐴌 𐴇𐴝𐴥𐴓𐴡𐴃𐴢 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴢 𐴎𐴝𐴕𐴡 𐴀𐴝𐴦𐴌 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴊𐴞𐴓𐴡𐴃𐴢 𐴅𐴡𐴏𐴁𐴝 𐴊𐴠. <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴀𐴠𐴊𐴧𐴠 𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴁𐴝𐴥𐴘 𐴀𐴡𐴕𐴠𐴏𐴞𐴥𐴔𐴡𐴏𐴡𐴌𐴠 𐴘𐴡𐴥 𐴊𐴞𐴉𐴠𐴍𐴝𐴥𐴙𐴌, 𐴎𐴞𐴁𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴎𐴡𐴕. 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴀𐴠𐴍𐴠𐴥 𐴑𐴞𐴦-𐴑𐴞𐴦 𐴀𐴡𐴥𐴌 𐴁𐴠𐴒𐴧𐴟𐴥𐴕 𐴎𐴝𐴕𐴝𐴘𐴊𐴞𐴁𐴡.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴎𐴞𐴘𐴡𐴥𐴓𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴝𐴌𐴞𐴏𐴃𐴝𐴌𐴑𐴟𐴏𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌, 𐴀𐴝𐴦𐴌 𐴁𐴝𐴥𐴌𐴕𐴝𐴁𐴝𐴏𐴡𐴌 𐴏𐴝𐴣𐴏𐴝𐴃𐴡 𐴁𐴝𐴥𐴘 𐴔𐴝𐴌𐴑𐴟𐴏𐴠 𐴘𐴡𐴥 𐴎𐴝𐴕𐴝𐴌, 𐴎𐴞𐴁𐴝𐴤𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴀𐴠𐴕𐴊𐴞𐴓𐴧𐴝 𐴇𐴡𐴥𐴑𐴟𐴔 𐴉𐴝𐴘𐴧𐴡𐴥 𐴊𐴠 𐴑𐴞, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴠𐴥𐴍𐴠 𐴀𐴝𐴘𐴓𐴠𐴤, 𐴀𐴠𐴏𐴃𐴠𐴑𐴁𐴝𐴓𐴢 𐴒𐴡𐴙𐴅𐴧𐴡𐴥. <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝, 𐴀𐴞𐴏𐴝𐴤 𐴎𐴞𐴁𐴝𐴤𐴌𐴠 𐴘𐴟𐴏𐴃𐴟𐴏𐴢 𐴋𐴝𐴑𐴠, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌. 𐴘𐴡𐴇𐴟𐴥𐴊𐴞 𐴀𐴡𐴥𐴑𐴧𐴡𐴓𐴡𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴉𐴟𐴥𐴖𐴝𐴣𐴃𐴞 𐴀𐴝𐴓𐴧𐴝𐴌 𐴌𐴝𐴙𐴅𐴧𐴡𐴓𐴧𐴝 𐴈𐴝𐴔-𐴒𐴡𐴌𐴡𐴤𐴘𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴏𐴞𐴌𐴞𐴥𐴉𐴢 𐴀𐴞𐴥𐴃𐴝𐴌𐴝; 𐴀𐴞𐴥𐴃𐴝𐴌𐴝 𐴀𐴡𐴥𐴙𐴓𐴊𐴠 𐴀𐴝𐴣𐴀𐴌 𐴃𐴡𐴏𐴡𐴥𐴓𐴧𐴞. <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" />𐴔𐴡𐴀𐴏𐴞𐴤 𐴀𐴞𐴏𐴝𐴤𐴌 𐴒𐴟𐴓𐴝𐴔 𐴀𐴠𐴂𐴝𐴉𐴝𐴌𐴝𐴏𐴢, 𐴎𐴞𐴁𐴝𐴤 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴁𐴟𐴥𐴃𐴡𐴃𐴧𐴟 𐴀𐴠𐴑𐴎𐴡𐴕, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌; 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴘𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝 𐴇𐴝𐴥𐴔𐴞𐴐𐴝 𐴊𐴞𐴓𐴔𐴡𐴕 𐴊𐴞 𐴊𐴟𐴖𐴝 𐴒𐴡𐴌𐴠𐴥, 𐴎𐴠𐴀𐴕𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴁𐴝𐴓𐴡𐴑 𐴀𐴡𐴥𐴘 𐴀𐴠𐴊𐴧𐴠 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴉𐴝𐴑𐴧𐴝𐴌 𐴏𐴝𐴥𐴀𐴣𐴃𐴠 𐴀𐴝𐴓𐴧𐴝𐴌 𐴉𐴟𐴌𐴝 𐴔𐴡𐴕𐴐𐴝𐴥𐴌 𐴖𐴡𐴌𐴠 𐴔𐴡𐴎𐴁𐴟𐴃𐴢 𐴒𐴡𐴌𐴞 𐴃𐴞𐴥𐴘𐴝𐴘 𐴃𐴝𐴥𐴑𐴡. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴌 𐴁𐴝𐴦𐴁𐴟𐴃𐴠 𐴀𐴝𐴀𐴛 𐴈𐴡𐴀𐴘𐴢 𐴉𐴝𐴙𐴅𐴧𐴟𐴔 𐴊𐴠 𐴑𐴞, 𐴘𐴡𐴥𐴒𐴧𐴗𐴝𐴃𐴧𐴟 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴓𐴧𐴝, 𐴀𐴝𐴦𐴌 𐴓𐴝𐴀𐴟𐴥𐴊𐴞𐴑𐴞𐴘𐴝𐴃𐴢 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴘𐴠𐴌𐴝𐴂𐴡𐴓𐴞𐴏𐴡𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴥𐴃𐴝𐴌𐴝𐴓𐴧𐴝 𐴑𐴟𐴥𐴁𐴢 𐴏𐴞𐴕𐴃𐴝𐴁𐴝𐴥𐴉𐴝𐴕𐴝 𐴀𐴝𐴏𐴠𐴤. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />𐴀𐴝𐴊𐴡𐴙𐴅𐴧𐴝 𐴋𐴝𐴑𐴄𐴡𐴌 𐴓𐴟𐴑𐴝𐴥𐴏𐴠 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴎𐴝𐴕𐴝𐴌, 𐴇𐴠𐴥𐴕𐴊𐴞𐴓𐴧𐴝 𐴊𐴠𐴥𐴔𐴝𐴏𐴠 𐴘𐴡𐴥 𐴎𐴝𐴕𐴝𐴌. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />𐴓𐴝𐴀𐴟𐴥𐴊𐴞𐴑𐴞𐴘𐴝𐴃𐴢 𐴀𐴝𐴏𐴠𐴤 𐴊𐴠 𐴀𐴞𐴔𐴝𐴕𐴊𐴝𐴥𐴌 𐴁𐴝𐴥𐴘𐴁𐴡𐴘𐴕𐴝𐴥𐴙𐴕 𐴊𐴡𐴌𐴠, 𐴀𐴝𐴦𐴌 𐴕𐴟𐴔𐴉𐴝𐴌𐴠 𐴀𐴠𐴊𐴧𐴠 𐴇𐴞𐴥𐴁𐴝𐴌 𐴒𐴡𐴥𐴌𐴡𐴃𐴢 𐴎𐴡𐴔𐴝 𐴀𐴡𐴥 𐴊𐴠 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌𐴠 𐴀𐴝𐴣𐴀𐴌 𐴏𐴡𐴥𐴓𐴝𐴔 𐴊𐴞𐴥𐴘𐴡.<verse eid="COL 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 4:16" />𐴐𐴠𐴣𐴍𐴞𐴥 𐴘𐴝𐴀𐴕 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴇𐴝𐴣𐴏𐴠 𐴃𐴠𐴓𐴝𐴖𐴡𐴃𐴢 𐴒𐴡𐴙𐴅𐴧𐴝𐴥 𐴀𐴡𐴥𐴘𐴓𐴠, 𐴓𐴝𐴀𐴟𐴊𐴞𐴥𐴑𐴞𐴀𐴡𐴥𐴓𐴡𐴌 𐴎𐴡𐴔𐴝𐴥𐴃𐴡𐴌 𐴇𐴝𐴣𐴏𐴠 𐴘𐴡𐴥 𐴃𐴠𐴓𐴝𐴖𐴡𐴃𐴢 𐴒𐴡𐴌𐴝𐴥 𐴁𐴝𐴥𐴘𐴡, 𐴀𐴝𐴦𐴌 𐴓𐴝𐴀𐴟𐴥𐴊𐴞𐴑𐴞𐴘𐴝𐴃𐴧𐴟 𐴀𐴝𐴣𐴀𐴌 𐴎𐴠 𐴐𐴠𐴣𐴍𐴞𐴥 𐴒𐴝𐴥𐴕 𐴀𐴝𐴘𐴁𐴡𐴤, 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝 𐴇𐴞𐴥𐴘𐴝𐴕 𐴀𐴡𐴥 𐴃𐴠𐴓𐴝𐴖𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥𐴘𐴡.<verse eid="COL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="COL 4:17" />𐴀𐴝𐴌𐴑𐴞𐴂𐴟𐴏𐴡𐴌𐴠 𐴈𐴡𐴘𐴁𐴝𐴤 𐴊𐴠, ”𐴔𐴝𐴓𐴞𐴑𐴡𐴌 𐴇𐴠𐴥𐴊𐴔𐴡𐴃𐴢 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴃𐴟𐴣𐴀𐴝𐴥𐴣𐴌𐴠 𐴎𐴠 𐴎𐴞𐴔𐴧𐴝 𐴊𐴞𐴦𐴘𐴝 𐴒𐴞𐴘𐴠𐴥, 𐴇𐴞𐴥𐴘𐴝𐴕 𐴉𐴟𐴌𐴝𐴉𐴟𐴌𐴞 𐴀𐴝𐴊𐴝𐴘 𐴒𐴡𐴌𐴞𐴥 𐴁𐴡𐴓𐴧𐴝 𐴏𐴝𐴘𐴧𐴡𐴥.“<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />𐴀𐴝𐴀𐴛 𐴂𐴝𐴥𐴀𐴟𐴓𐴠 𐴕𐴞𐴎𐴡𐴌 𐴀𐴝𐴥𐴃𐴠 𐴀𐴠 𐴏𐴡𐴥𐴓𐴝𐴔 𐴓𐴠𐴑𐴞𐴥𐴌. 𐴀𐴝𐴀𐴛 𐴁𐴡𐴕 𐴀𐴝𐴏𐴞𐴤 𐴊𐴠 𐴇𐴞𐴥𐴘𐴝𐴕 𐴕𐴡 𐴉𐴡𐴀𐴌𐴝𐴘𐴧𐴡. 𐴃𐴟𐴣𐴀𐴝𐴥𐴌𐴝𐴌 𐴖𐴡𐴌𐴠 𐴌𐴝𐴇𐴝𐴥𐴔𐴡𐴃𐴢 𐴎𐴝𐴌𐴞 𐴃𐴝𐴥𐴑𐴡𐴗𐴑.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>