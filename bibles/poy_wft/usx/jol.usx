<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Pogoro Bible Version</book>
  <para style="h">Yoweli</para>
  <para style="toc1">Shitabu sha Yoweli</para>
  <para style="toc2">Yoweli</para>
  <para style="toc3">Yowe</para>
  <para style="mt2">Shitabu sha</para>
  <para style="mt1">YOWELI</para>
  <para style="imt">ULONGULERU</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Awu ndo ujumbi ulii Mtuwa Mlungu kampananiti Yoweli mwana gwa Petueli.<verse eid="JOL 1:1" /></para>
  <para style="s">Wantu wankudaya kuusu kuharibisiwa kwa vimeru</para>
  <para style="p">
    <verse number="2" style="v" sid="JOL 1:2" />Mwenga wakulu wa Israeli, mpikaniri ujumbi awu, mwenga mwawoseri yamulikala muisi ayi mpikaniri weri!</para>
  <para style="q" vid="JOL 1:2">Mpikaniri wantu woseri wa Yuda!</para>
  <para style="q" vid="JOL 1:2">Hashi, shitwatira shilawiriti mumakaliru genu,</para>
  <para style="q" vid="JOL 1:2">ama shaka sha wazewi wenu?<verse eid="JOL 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 1:3" />Muwatambiri wana wenu ujumbi awu,</para>
  <para style="q" vid="JOL 1:3">nawomberi wawatambiri wana wawu,</para>
  <para style="q" vid="JOL 1:3">na wana wawu washitambiri shiyuwuku shashiza.<verse eid="JOL 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 1:4" />Waving'ongolu, vipinga kwa vipinga waliyiti vimeru vyoseri,</para>
  <para style="q" vid="JOL 1:4">su shashilekituwi na wanjombi, shiliyituwi na tunutu,</para>
  <para style="q" vid="JOL 1:4">shashashilekituwi na tunutu, shiliyituwi parare,</para>
  <para style="q" vid="JOL 1:4">shashilekituwi na parare shiliyituwi na matapa. <verse eid="JOL 1:4" /><verse number="5" style="v" sid="JOL 1:5" />Mwenga yamlowela, mwimuki!</para>
  <para style="q" vid="JOL 1:5">Na mwenga yamlanda divayi mlili,</para>
  <para style="q" vid="JOL 1:5">toziya zyabibu zyoseri ziharabisiwa na hapeni mpati divayi ya syayi kayi. <verse eid="JOL 1:5" /><verse number="6" style="v" sid="JOL 1:6" />Shonta lya wanjombi liliingilira isi yangu,</para>
  <para style="q" vid="JOL 1:6">liwera na likakala likulu na hapeni liwalanguwi,</para>
  <para style="q" vid="JOL 1:6">malinu gawu gawera gambira ga simba,</para>
  <para style="q" vid="JOL 1:6">na malinu makulu gakuwi gawera gambira simba gwa shidala.<verse eid="JOL 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 1:7" />Liharabisiya mizyabibu yatwenga,</para>
  <para style="q" vid="JOL 1:7">na kuiliya mitera yetu ya tini.</para>
  <para style="q" vid="JOL 1:7">Likobola mabaku gakuwi,</para>
  <para style="q" vid="JOL 1:7">na mitambi yakuwi ilekuwa hera.<verse eid="JOL 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 1:8" />Mliri gambira kamwali yakavaliti malobota,</para>
  <para style="q" vid="JOL 1:8">pakadaya kuhowa kwa muheta gwakuwi.<verse eid="JOL 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 1:9" />Malaviwu ga viboga na malaviwu ga vilandiru kwahera mnumba mwa Mtuwa Mlungu.</para>
  <para style="p" vid="JOL 1:9">Watambika yawatenda lihengu kulongolu kwa Mtuwa Mlungu, wankudaya.<verse eid="JOL 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 1:10" />Malambu gasigala lupala hera,</para>
  <para style="q" vid="JOL 1:10">isi yankudaya,</para>
  <para style="q" vid="JOL 1:10">toziya viboga ziharabisiwa,</para>
  <para style="q" vid="JOL 1:10">divayi yasyai iyuma,</para>
  <para style="q" vid="JOL 1:10">lipaki lya mizyetuni kwahera nakamu.<verse eid="JOL 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 1:11" />Mdayi mwenga walimi,</para>
  <para style="q" vid="JOL 1:11">mbotangi mwenga yamlolera mizyabibu.</para>
  <para style="q" vid="JOL 1:11">Nganu pamuhera na mpunga ziharabika,</para>
  <para style="q" vid="JOL 1:11">toziya mabenu goseri ga mumalambu gahagamira.<verse eid="JOL 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 1:12" />Mizyabibu inyala na mitera ya tini iyuma,</para>
  <para style="q" vid="JOL 1:12">mitera ya komamanga na mitendi na mitera ya tini inyala,</para>
  <para style="q" vid="JOL 1:12">mitera yoseri ya mabwajubwaju iyuma.</para>
  <para style="q" vid="JOL 1:12">Nemeleru ya wantu iwuka.<verse eid="JOL 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 1:13" />Mwenga watambika, mvali malobota na mdayi,</para>
  <para style="q" vid="JOL 1:13">mliri mwenga yamtenda lihengu pahala pa kutambikira.</para>
  <para style="q" vid="JOL 1:13">Mwingiri Mnumba nkulu mwakadayi pashiru poseri!</para>
  <para style="q" vid="JOL 1:13">Tambiku zya viboga pamuhera na vyakulanda kwahera mnumba ya Mlungu.<verse eid="JOL 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 1:14" />Muwalagaliri wantu woyi kuliya,</para>
  <para style="q" vid="JOL 1:14">muwashemeri wantu wizi mumikutanu.</para>
  <para style="q" vid="JOL 1:14">Muwashemi wazewi pamuhera na wantu woseri muisi ya Yuda,</para>
  <para style="q" vid="JOL 1:14">Mnumba nkulu ya Mtuwa Mlungu gwenu,</para>
  <para style="q" vid="JOL 1:14">amu mwakamliliri.<verse eid="JOL 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 1:15" />Shondi twenga kwa lishaka lya Mtuwa Mlungu,</para>
  <para style="q" vid="JOL 1:15">lishaka ali lya Mtuwa Mlungu lyapakwegera,</para>
  <para style="q" vid="JOL 1:15">lyankwiza pamuhera na maagamiziwu,</para>
  <para style="q" vid="JOL 1:15">kulawa kwa Mlungu yakawera na makakala.<verse eid="JOL 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 1:16" />Viboga vyetu viharabisiwa uganu patulola.</para>
  <para style="q" vid="JOL 1:16">Nemeleru na kuseka viwusiwa ukaya kwa Mlungu gwetu.<verse eid="JOL 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 1:17" />Mbeyu zyankuwola mulitapaka,</para>
  <para style="q" vid="JOL 1:17">hanja zya viboga ushiwa hera,</para>
  <para style="q" vid="JOL 1:17">hanja ziharabisiwa</para>
  <para style="q" vid="JOL 1:17">kwa kukosa viboga vya kutulira.<verse eid="JOL 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 1:18" />Wankanyama ntambu yawalila nentu kwa hinginiku!</para>
  <para style="q" vid="JOL 1:18">Vipinga vya wang'ombi vyankuyerayera,</para>
  <para style="q" vid="JOL 1:18">toziya kwahera mahamba ga kuliya,</para>
  <para style="q" vid="JOL 1:18">ata vipinga vya wakondolu vyankutabika.<verse eid="JOL 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 1:19" />Nukulilira gwenga, gwee Mtuwa Mlungu,</para>
  <para style="q" vid="JOL 1:19">moto gumalira mahamba ga kuntundu,</para>
  <para style="q" vid="JOL 1:19">mimbamba ya motu ilunguziya mitera mumalambu.<verse eid="JOL 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 1:20" />Ata wankanyama wa kuntundu wankukulilira gwenga,</para>
  <para style="q" vid="JOL 1:20">toziya nshemba zya mashi ziyuma,</para>
  <para style="q" vid="JOL 1:20">motu gumalira mahamba ga kuntundu.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s">Likalipiru kuusu lishaka lya Mtuwa Mlungu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 2:1" />Mgombi mbalapi aku Sayuni,</para>
  <para style="q" vid="JOL 2:1">mgombi ng'oma ya ngondu kulugongu lunanagala!</para>
  <para style="q" vid="JOL 2:1">Mlendemeri mwenga wenikaya wa isi ya Yuda,</para>
  <para style="q" vid="JOL 2:1">toziya lishaka lya Mtuwa Mlungu lyankwiza,</para>
  <para style="q" vid="JOL 2:1">lishaka ali lyapakwegera!<verse eid="JOL 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 2:2" />Ali ndo lishaka lya luwindu na hinginiku,</para>
  <para style="q" vid="JOL 2:2">lishaka lya mawundi na ntiti totolu.</para>
  <para style="q" vid="JOL 2:2">Shonta likulu la wanjombi lyapakwegera</para>
  <para style="q" vid="JOL 2:2">gambira luwindu lyaligubika mumigongu.</para>
  <para style="q" vid="JOL 2:2">Ntambu ayi hayenipati kuwera nakamu</para>
  <para style="q" vid="JOL 2:2">na hapeni liwoneki kayi</para>
  <para style="q" vid="JOL 2:2">muviyuwuku vyaviza. <verse eid="JOL 2:2" /><verse number="3" style="v" sid="JOL 2:3" />Gambira motu ntambu yagulunguziya nakamu</para>
  <para style="q" vid="JOL 2:3">shonta ali lyankuharabisiya kila shintu kulongolu kwakuwi</para>
  <para style="q" vid="JOL 2:3">na kuleka kumberi kila shintu shankuharabisiwa.</para>
  <para style="q" vid="JOL 2:3">Pamberi hawenipiti, isi iwera gambira shiwunga sha Edeni,</para>
  <para style="q" vid="JOL 2:3">kumbiti pawapita kala, isi iwera shiwala hera.</para>
  <para style="q" vid="JOL 2:3">Kwahera shashiweza kuwashapira!<verse eid="JOL 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 2:4" />Wawoneka gambira nkanyama falasi,</para>
  <para style="q" vid="JOL 2:4">wankutuga gambira falasi gwa ngondu.<verse eid="JOL 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 2:5" />Pawagulukaguluka pavigongu,</para>
  <para style="q" vid="JOL 2:5">liziwu lyawalaviya liwera gambira mbutuka zyakukeguwa na falasi,</para>
  <para style="q" vid="JOL 2:5">wankupikanika gambira miberegi iyuma yaipambiruwa mumotu.</para>
  <para style="q" vid="JOL 2:5">Walitula weri gambira shonta likulu</para>
  <para style="q" vid="JOL 2:5">wawera kala kulikomanga ngondu.<verse eid="JOL 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 2:6" />Wantu pawona pawawiza,</para>
  <para style="q" vid="JOL 2:6">su wawera na lyoga nentu na kulendemela.<verse eid="JOL 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 2:7" />Wankulikomanga ngondu gambira wakanka wa ngondu,</para>
  <para style="q" vid="JOL 2:7">wankukwena muvibambaza gambira wanjagira.</para>
  <para style="q" vid="JOL 2:7">Woseri wankugenda kulongolu pota kuwuya kumberi,</para>
  <para style="q" vid="JOL 2:7">pota na yumu gwawu kugalambula njira.<verse eid="JOL 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 2:8" />Kwahera yakamsukumiza muyaguwi,</para>
  <para style="q" vid="JOL 2:8">kila yumu kasakula munjira yakuwi nakaka.</para>
  <para style="q" vid="JOL 2:8">Wankupita pakati pa vidiwiru vya vikomaniru,</para>
  <para style="q" vid="JOL 2:8">kwahera shashiweza kuwapingila.<verse eid="JOL 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 2:9" />Wankululingilira lushi,</para>
  <para style="q" vid="JOL 2:9">wankutuga mbiru muvibambaza.</para>
  <para style="q" vid="JOL 2:9">Wankwingira mnumba zyoseri gambira wapoka ntambu yawingira mumadirisha.<verse eid="JOL 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 2:10" />Isi yankulendemera kulongolu kwawu,</para>
  <para style="q" vid="JOL 2:10">kumpindi kwankutikinyika.</para>
  <para style="q" vid="JOL 2:10">Mshenji na lyezi viwera na luwindu,</para>
  <para style="q" vid="JOL 2:10">na ntondu zankuleka kulangala.<verse eid="JOL 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 2:11" />Mtuwa Mlungu kankugalagalira mashonta gakuwi kwa liziwu,</para>
  <para style="q" vid="JOL 2:11">wanjagira wakuwi wavuwa nentu yawamjimira na wawera na makakala.</para>
  <para style="q" vid="JOL 2:11">Lishaka lya Mtuwa Mlungu, nakaka ndo likulu na lya kutiriziya nentu!</para>
  <para style="q" vid="JOL 2:11">Gaa hakawezi kupona?<verse eid="JOL 2:11" /></para>
  <para style="s">Mtuwa Mlungu kankuwashema wantu woyi vidoda</para>
  <para style="p">
    <verse number="12" style="v" sid="JOL 2:12" />“Mtuwa Mlungu kalonga hangu, muwuyiri neni kwa moyu gwenu gwoseri</para>
  <para style="q" vid="JOL 2:12">kwa kwoya kuliya, kulira na kudaya.”<verse eid="JOL 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 2:13" />Nampapula nguwu zyenu hera,</para>
  <para style="q" vid="JOL 2:13">kumbiti mpapuli myoyu yenu viraa.</para>
  <para style="q" vid="JOL 2:13">Mumuwuyiri Mtuwa Mlungu, Mlungu gwenu,</para>
  <para style="q" vid="JOL 2:13">toziya mweni kamema manemu pamuhera na lusungu,</para>
  <para style="q" vid="JOL 2:13">yomberi kakalala ndiri kalongola, mweni kamema ufiru,</para>
  <para style="q" vid="JOL 2:13">mashaka goseri kakala kulegeziya na hapeni kazibu.<verse eid="JOL 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 2:14" />Pamonga gaa yakavimana kuwera Mtuwa Mlungu, Mlungu gwetu, hakagalambuli nfiru</para>
  <para style="q" vid="JOL 2:14">na kuwapanana matekeleru ga viboga,</para>
  <para style="q" vid="JOL 2:14">su hamuwezi kumlaviliri tambiku za viboga pamuhera na virandilu.<verse eid="JOL 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 2:15" />Mgombi mbalapi aku Sayuni!</para>
  <para style="q" vid="JOL 2:15">Mlagaliri wantu woyi kuliya,</para>
  <para style="q" vid="JOL 2:15">muwashemi wantu mumkutanu.<verse eid="JOL 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 2:16" />Muwajojonili wantu woseri,</para>
  <para style="q" vid="JOL 2:16">muwatuli wantu kwajili ya lihengu lya Mtuwa.</para>
  <para style="q" vid="JOL 2:16">Muwajegi pamuhera wakulu na wana na ata wanonu.</para>
  <para style="q" vid="JOL 2:16">Mpalu gwa ndowa pamuhera na mdala gwa ndowa walawi muviwogu vyawu.<verse eid="JOL 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 2:17" />Watambika yawatenda lihengu kulongolu kwa Mtuwa Mlungu, walili pakati pa ligomi lya Numba nkulu ya Mlungu na pahala pa kutambikira.</para>
  <para style="q" vid="JOL 2:17">Womberi waluwi, guwawoneri lusungu wantu waku, gwee Mtuwa Mlungu.</para>
  <para style="q" vid="JOL 2:17">Naguzileka isi zimonga wawasoniziyi,</para>
  <para style="q" vid="JOL 2:17">nagutenda isi zimonga wawakolimlima wantu waku</para>
  <para style="q" vid="JOL 2:17">na kuwatendera lidufiya pawalonga,</para>
  <para style="q" vid="JOL 2:17">hashi, kakoshi Mlungu gwawu?<verse eid="JOL 2:17" /></para>
  <para style="s">Mtuwa Mlungu kankuwankula</para>
  <para style="p">
    <verse number="18" style="v" sid="JOL 2:18" />Shakapanu Mtuwa Mlungu kaifiriti isi yakuwi</para>
  <para style="q" vid="JOL 2:18">kawawonera lusungu wantu wakuwi.<verse eid="JOL 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 2:19" />Yomberi kapikaniriti na kawankuliti maluwa gawu pakalonga,</para>
  <para style="q" vid="JOL 2:19">“Vinu hanuwapanani kayi viboga na divayi ya syayi na lipaki lya mizyetuni,</para>
  <para style="q" vid="JOL 2:19">vyoseri vyakuwatosha mwenga,</para>
  <para style="q" vid="JOL 2:19">hapeni nuwatendi mwenga wawatenderi lidufiya kayi kulawa kwa isi zyamonga.<verse eid="JOL 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 2:20" />Hanuwawusi wankondu awa yawalawa kushana,</para>
  <para style="q" vid="JOL 2:20">hanuwatendi watugi mpaka kushiwala,</para>
  <para style="q" vid="JOL 2:20">wanjagira wa kulongolu hanuwasili kubahali ifuwa,</para>
  <para style="q" vid="JOL 2:20">na walii wanjagira yawawera kumberi hanuwawasili mubahali ya mediteraneya.</para>
  <para style="q" vid="JOL 2:20">Hawalaviyi shivundu na kununka,</para>
  <para style="q" vid="JOL 2:20">awa yawatenditi ukondola mkulu.”<verse eid="JOL 2:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOL 2:21" />Nagutira, gwee isi,</para>
  <para style="q" vid="JOL 2:21">su gusekeleri na kunemelera.</para>
  <para style="q" vid="JOL 2:21">Nakaka Mtuwa Mlungu katenditi vitwatira vikulu.<verse eid="JOL 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOL 2:22" />Namtira, mwenga wakanyama wakuntundu,</para>
  <para style="q" vid="JOL 2:22">mahamba ga kuliya ga kuntundu gawera gaherepa,</para>
  <para style="q" vid="JOL 2:22">mitera yankulera mabwajubwaju gakuwi,</para>
  <para style="q" vid="JOL 2:22">mizyabibu pamuhera na mitera ya tini yankulera nentu.<verse eid="JOL 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOL 2:23" />Mnemeleri mwenga wantu wa Sayuni,</para>
  <para style="q" vid="JOL 2:23">mnemuki toziya ya Mtuwa Mlungu, Mlungu gwenu,</para>
  <para style="q" vid="JOL 2:23">toziya kawapanana mvula ya masika,</para>
  <para style="q" vid="JOL 2:23">kawapanana mvula ivuwa.</para>
  <para style="q" vid="JOL 2:23">Mvula za masika na mvula za vuli gambira kwanja.<verse eid="JOL 2:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOL 2:24" />Pahala pa kupetera hapamemi viboga</para>
  <para style="q" vid="JOL 2:24">pahala pa kukamira hagamemi divayi na lipaki lya mizyetuni. <verse eid="JOL 2:24" /><verse number="25" style="v" sid="JOL 2:25" />Hanuwawuziliri mivinja ilii yailiwituwi na wanjombi,</para>
  <para style="q" vid="JOL 2:25">na kila shintu shashiliwituwi na tunutu na parare na matapa,</para>
  <para style="q" vid="JOL 2:25">shonta ali likulu lyanilijegiti kwa mwenga. <verse eid="JOL 2:25" /><verse number="26" style="v" sid="JOL 2:26" />Hamliyi viboga mpaka mwikuti na kuleka,</para>
  <para style="q" vid="JOL 2:26">hamlikwisuwi litawu lya Mtuwa Mlungu, Mlungu gwenu,</para>
  <para style="q" vid="JOL 2:26">yakawatenderiti vitwatira vya kulikangasha.</para>
  <para style="q" vid="JOL 2:26">Wantu wangu, nakaka hapeni wasoniziwi.<verse eid="JOL 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOL 2:27" />Shakapanu hamuvimani kuwera neni napamuhera na Israeli,</para>
  <para style="q" vid="JOL 2:27">kuwera Namtuwa Mlungu, Mlungu ngwaku, kwahera gwingi,</para>
  <para style="q" vid="JOL 2:27">kayi hapeni wantu wangu wasoniziwi.<verse eid="JOL 2:27" /></para>
  <para style="s">Mtuwa Mlungu kalagila kumjega Rohu Mnanagala gwakuwi</para>
  <para style="p">
    <verse number="28" style="v" sid="JOL 2:28" />Shakapanu pa aga,</para>
  <para style="q" vid="JOL 2:28">neni hamiminili Rohu gwangu kwa wantu woseri.</para>
  <para style="q" vid="JOL 2:28">Wana wenu wapalu pamuhera wahinga wenu hawatungi,</para>
  <para style="q" vid="JOL 2:28">wagogolu wenu hawaloti ndotu kulawa kwaneni,</para>
  <para style="q" vid="JOL 2:28">na wantemba wenu hawawoni mawonu.<verse eid="JOL 2:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOL 2:29" />Ata kwa wantumintumi wangu wapalu na wadala,</para>
  <para style="q" vid="JOL 2:29">hanuwamiminiri Rohu gwangu mumashaka aga.<verse eid="JOL 2:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOL 2:30" />Hananguziyi makangashu kumpindi na pasipanu,</para>
  <para style="q" vid="JOL 2:30">hakuweri na mwazi na motu na minara ya lyosi.<verse eid="JOL 2:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOL 2:31" />Mshenji hagutuluwi ntiti,</para>
  <para style="q" vid="JOL 2:31">na lyezi haliweri lisheri gambira mwazi,</para>
  <para style="q" vid="JOL 2:31">pamberi pa kusoka lishaka lya Mtuwa Mlungu,</para>
  <para style="q" vid="JOL 2:31">lishaka lilii lyaliwera likulu na lya kutiliziya. <verse eid="JOL 2:31" /><verse number="32" style="v" sid="JOL 2:32" />“Panu wantu woseri yawaluwa kwa litawu lya Mtuwa Mlungu, hakalopoziwi.</para>
  <para style="q" vid="JOL 2:32">Toziya kulugongu lwa Sayuni na Yerusalemu,</para>
  <para style="q" vid="JOL 2:32">hakuweri na wantu yawashapira,</para>
  <para style="q" vid="JOL 2:32">ntambu yanongiti neni Mtuwa Mlungu.”<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s">Mtuwa Mlungu hakamjegi Rohu gwakuwi</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 3:1" />Mtuwa Mlungu kalongiti, nakaka mumashaka galii,</para>
  <para style="q" vid="JOL 3:1">panuitenda weri ntambu ya Yuda na Yerusalemu, <verse eid="JOL 3:1" /><verse number="2" style="v" sid="JOL 3:2" />hanuzijojoniri isi zoseri mulilaranda lyalishemuwa,</para>
  <para style="q" vid="JOL 3:2">Mtuwa Mlungu katozi.</para>
  <para style="q" vid="JOL 3:2">Kulii hanuwatozi womberi</para>
  <para style="q" vid="JOL 3:2">kwa woseri vyawawatendiriti kwa wantu wangu,</para>
  <para style="q" vid="JOL 3:2">toziya wapalanganyiki pakati pa isi zya shihenga</para>
  <para style="q" vid="JOL 3:2">na wabagulaniti Israeli isi yaneni <verse eid="JOL 3:2" /><verse number="3" style="v" sid="JOL 3:3" />na kubagulana wantu waneni yawakamulituwi mungondu kwa kuzigalambula simbi.</para>
  <para style="q" vid="JOL 3:3">Wawashuwuziti wantemba kupata mpiya zya kulipila undiyandiya,</para>
  <para style="q" vid="JOL 3:3">wawashuwuziti wahinga su kupata mpiya zya kuhemera ujimbi.<verse eid="JOL 3:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="JOL 3:4" />Hashi, mfira kuntenda shishi mwenga Tiru na Sidoni na mwenga woseri mikowa ya Filistia? Hashi, mwenga mfira kuwuzilira neni kwa shilii shantenditi? Handa mwenga mwankumbuzilira, neni hanuwawuziliri kwa shilii shamtenditi. <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Mwenga mtola madini gangu ga mpiya na zahabu, na kuvitola vintu vya neni vya beyi nkulu na kuvijega mpaka kunumba zyenu za kuwaguwira milungu wenu. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Mwenga muwashuwuza wantu wa Yuda na Yerusalemu kwa Wagiriki, muwajega kutali na isi zyawu. <verse eid="JOL 3:6" /><verse number="7" style="v" sid="JOL 3:7" />Vinu, neni nankugenda kuwawuziya wantu wangu kulawa aku kwamshuwuzirituwi, hanuwawuzilili vyoseri vyamuwatendiriti. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Hanuwatendi wana wapalu wenu na wahinga wawashuwuzi kwa wantu wa Yuda, womberi hawawashuwuzi kwa wantu wa Sheba na wantu wa isi zya kutali nentu. Neni Mtuwa Mlungu ntakula aga.<verse eid="JOL 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOL 3:9" />Muwabweleri wantu wa isi shitwatira ashi.</para>
  <para style="q" vid="JOL 3:9">Mulitandi kwa ngondu,</para>
  <para style="q" vid="JOL 3:9">muwashemi wavikambaku wenu,</para>
  <para style="q" vid="JOL 3:9">wanjagira woseri wajojoniki wagendi kulongolu.<verse eid="JOL 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 3:10" />Magembi genu mgapondi gaweri magumba,</para>
  <para style="q" vid="JOL 3:10">hengu zyenu zya kubenela ziweri migoha.</para>
  <para style="q" vid="JOL 3:10">Ata yakawera legilegi su kalongi,</para>
  <para style="q" vid="JOL 3:10">neni viraa nashikambaku. <verse eid="JOL 3:10" /><verse number="11" style="v" sid="JOL 3:11" />Mwizi kalongola, mwenga isi zoseri kulawa kila wega,</para>
  <para style="q" vid="JOL 3:11">mjojoniki aku kulilalanda.</para>
  <para style="q" vid="JOL 3:11">Gwee Mtuwa Mlungu, gujegi wamashonta waku wawakomangi ngondu.<verse eid="JOL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOL 3:12" />“Isi zilitandi kala,</para>
  <para style="q" vid="JOL 3:12">waizi mulilalanda lyalishemuwa,</para>
  <para style="q" vid="JOL 3:12">Mtuwa Mlungu katozi.</para>
  <para style="q" vid="JOL 3:12">Aku neni Mtuwa Mlungu,</para>
  <para style="q" vid="JOL 3:12">hanulivagi kuzitoza isi zyoseri zya pakwegera.<verse eid="JOL 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 3:13" />Su mtoli hengu zya kubenela,</para>
  <para style="q" vid="JOL 3:13">toziya vinu ndo shaka sha mabenu.</para>
  <para style="q" vid="JOL 3:13">Mwingili! Muwakamiri gambira zyabibu</para>
  <para style="q" vid="JOL 3:13">zyazimema pahala pa kukamira,</para>
  <para style="q" vid="JOL 3:13">toziya ukondola awu uwera mkulu</para>
  <para style="q" vid="JOL 3:13">gambira vulu vyavimemiti nduu.”<verse eid="JOL 3:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JOL 3:14" />Wankusoka vipinga vikulu nentu kwa vipinga vikulu nentu</para>
  <para style="q" vid="JOL 3:14">kulilalanda lya utoza,</para>
  <para style="q" vid="JOL 3:14">toziya shaka sha Mtuwa Mlungu sha kutoza shapakwegera. <verse eid="JOL 3:14" /><verse number="15" style="v" sid="JOL 3:15" />Mshenji na lyezi havituluwi luwindu,</para>
  <para style="q" vid="JOL 3:15">ntondu hazileki kulangala.<verse eid="JOL 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOL 3:16" />Mtuwa Mlungu hakagugumi aku Sayuni,</para>
  <para style="q" vid="JOL 3:16">na liziwu lyakuwi gambira lupanda kulawa Yerusalemu,</para>
  <para style="q" vid="JOL 3:16">kumpindi na pasipanu vyankulendemera.</para>
  <para style="q" vid="JOL 3:16">Kumbiti Mtuwa Mlungu ndo tugiru ya wantu wakuwi,</para>
  <para style="q" vid="JOL 3:16">kawera liboma lya kuwalolera wantu wakuwi Israeli.<verse eid="JOL 3:16" /></para>
  <para style="s">Matekeleru ga Mtuwa Mlungu kwa wantu wakuwi</para>
  <para style="p">
    <verse number="17" style="v" sid="JOL 3:17" />Shakapanu mwenga wantu wa Israeli hamuvimani kuwera neni Mtuwa Mlungu, Mlungu gwaku</para>
  <para style="q" vid="JOL 3:17">nankulikala Sayuni, mulugongu lwangu lunanagala.</para>
  <para style="q" vid="JOL 3:17">Yerusalemu haluweri lushi lunanagala,</para>
  <para style="q" vid="JOL 3:17">na wahenga hapeni walulingilili kayi amu.<verse eid="JOL 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 3:18" />Shaka ashi, migongu haimemi mizyabibu,</para>
  <para style="q" vid="JOL 3:18">na muvigongu hakuweri na wankanyama yawalaviya maweri.</para>
  <para style="q" vid="JOL 3:18">Nshemba zyoseri zya Yuda hazimemi mashi,</para>
  <para style="q" vid="JOL 3:18">na mbwiru hazilawili kunumba nkulu ya Mtuwa Mlungu,</para>
  <para style="q" vid="JOL 3:18">na kulitilira lulalanda lwa Shitimu.<verse eid="JOL 3:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JOL 3:19" />Misri haiweri ushiwa,</para>
  <para style="q" vid="JOL 3:19">na Edomu haiweri shiwala,</para>
  <para style="q" vid="JOL 3:19">toziya ya ungondu yaitendituwi na wantu wa Yuda,</para>
  <para style="q" vid="JOL 3:19">na kuwalaga wantu wavuwa yawatendi ndiri shintu shidoda.<verse eid="JOL 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 3:20" />Kumbiti isi ya Yuda haikaliluwi na wantu mashaka goseri,</para>
  <para style="q" vid="JOL 3:20">na Yerusalemu hailikali shiyuwuku mpaka shiyuwuku. <verse eid="JOL 3:20" /><verse number="21" style="v" sid="JOL 3:21" />“Hanuwazibu yawalagiti wantu wa Yuda</para>
  <para style="q" vid="JOL 3:21">hapeni nuwaleki yawawera na likosa.</para>
  <para style="q" vid="JOL 3:21">Neni Mtuwa Mlungu, nilikala Sayuni.”<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>