<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">POGORO Bible Version</book>
  <para style="h">Mesali</para>
  <para style="toc1">Shitabu sha Mesali</para>
  <para style="toc2">Mesali</para>
  <para style="toc3">Mesa</para>
  <para style="mt2">Shitabu sha</para>
  <para style="mt1">Mesali</para>
  <para style="imt">Ulonguleru</para>
  <para style="ip">Shitabu sha Mesali ndo mjojoniku gwa visoweru vya luhala, walemba wavuwa waweriti pamuhera ama washangiliti mushitabu ashi sha visoweru vya luhala, kumbiti mfalumi Selemani, mwana gwa mfalumi Dawudi yomberi ndo yakalembiti mesali zivuwa. Selemani kamanikiti kwa luhala na wafalumi wa kwanja shipandi 4:32 itakulwa yomberi ndo yakalembiti visoweru elufu tatu. Hangu shitabu sha visoweru shilembitwi shaka sha kulikala kwa mfalumi Selemani mukalini ya lilongu pamberi pa Yesu kwiwuka. Vitabu vyavisigaliti vilembitwi na kumalilika shaka Ezekia pakakolitimlima Yuda mushinja sha mia saba kumi na tanu mpaka mia sita semanini na sita pamberi pa Yesu kwiwuka. 25:1. Visoweru vya luhala ndo visoweru vyavitakulira unakaka, kumbiti vya gweka kuliku visoweru vya ntakuliti hantendi na umbuyi, kwa mfanu visoweru vya luhala shipandi 22:6 Gumfundi mwana ntambu yakulikala na yomberi hapeni kalyaluwi njira ayi mpaka ukulu wakuyi. Ata hangu mwana hapakaweri hangu pakakulaku. Visoweru viherepa visindandiri kutendeka ama vya ntambu yingi, mukila mwana yawamleliti munjira yayiweriti teratera, kumbiti ndo utakulu uherepa weni utakulira unakaka woseri. Shitabu sha mesali sheni shiyowelera ntambu yashiwera mshipandi sha 1:2-6. Nfiru ndo kutanga wantu wa ntambu iraayi na wantemba kuvimana luhala na magambiziya maheri na kuwatenda waweri na luhala nentu.</para>
  <para style="iot">Yagawera amu</para>
  <para style="io">Visoweru vya luhala vya Selemani. Shipandi sha 1 mpaka 22:16</para>
  <para style="io">Mijojoniru miwili ya visoweru vya luhala. Shipandi sha 22:17-24</para>
  <para style="io">Mijojoniru yimonga miwili ya matakulu ga mesali za Selemani. Visoweru avi vyana mahala vijojonilwa na watenda lihengu wa mfalumi Hezekia. Shipandi sha 25 mpaka 29</para>
  <para style="io">Matakulu ga Aguri. Shipandi sha 30</para>
  <para style="io">Matakulu ga Lemueli. Shipandi sha 31:1-9</para>
  <para style="io">Upeleru umtakulira mdala yakana zyuma ziherepa. Shipandi sha 31:10-31</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">Uherepa wa Mesali</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Ayi ndo mesali ya Selemani mwana mpalu gwa Dawudi, mfalumi gwa Israeli.<verse eid="PRO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 1:2" />Mesali azi viwapanana wantu luhala na migendelanu miheri, su viwatenda wavimani visoweru vya luhala. <verse eid="PRO 1:2" /><verse number="3" style="v" sid="PRO 1:3" />Mesali azi kayi zimtanga muntu kulikala kwa luhala na kutenda yagamfiriziya Mlungu na kutenda pota kulola uwega woseri. <verse eid="PRO 1:3" /><verse number="4" style="v" sid="PRO 1:4" />Viwapanana luhala yawahera umani na wantemba umani su waliloleri weri. <verse eid="PRO 1:4" /><verse number="5" style="v" sid="PRO 1:5" />Yakana luhala kalupikiniri na kongera umani wakuyi na yakana umani kapati mlonguziwu, <verse eid="PRO 1:5" /><verse number="6" style="v" sid="PRO 1:6" />su muntu kavimani mana ya mesali na mifanu na mana ya visoweru vya wana luhala na vitendawiri vyawu.<verse eid="PRO 1:6" /></para>
  <para style="s">Malagalira kwa wantemba</para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 1:7" />Kumguwira Mtuwa Mlungu ndo shanjiru sha umani, kumbiti wazigizigi wabeziya luhala na walema kulifunda.<verse eid="PRO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 1:8" />Mwanagwangu, gupikanili mlonguziwu gwa tati gwaku, pota nagugaleka mafunda ga mawu gwaku. <verse eid="PRO 1:8" /><verse number="9" style="v" sid="PRO 1:9" />Aga hagaweri lijenjeri liherepa pamtuwi paku na handa mkufu gwaguherepa msingu mwaku.<verse eid="PRO 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 1:10" />Mwanagwangu paguzyangwazyangwa na wana vidoda naguwajimira. <verse eid="PRO 1:10" /><verse number="11" style="v" sid="PRO 1:11" />Pawalonga, tugendi twakamgwadiri muntu na kumlaga; gwizi twakawakomangi yawahera vidoda, <verse eid="PRO 1:11" /><verse number="12" style="v" sid="PRO 1:12" />tuwamiri pawawera wakomu handa lisembi, waweri handa walii yawapatukira mulirindi litali. <verse eid="PRO 1:12" /><verse number="13" style="v" sid="PRO 1:13" />Hatupati lunda zoseri za beyi nkulu na numba zyetu hatumemiziyi vintu vyatuvipokiti. <verse eid="PRO 1:13" /><verse number="14" style="v" sid="PRO 1:14" />Gwizi gulikolani na twenga, vyoseri vyanatupati hatubagulani,<verse eid="PRO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 1:15" />mwanagwangu nagulilonguziya nawa, nagugenda nawa, <verse eid="PRO 1:15" /><verse number="16" style="v" sid="PRO 1:16" />toziya womberi wawera mumbiwu kutenda makontola, wawera kalongola kulaga. <verse eid="PRO 1:16" /><verse number="17" style="v" sid="PRO 1:17" />Lihengu lya hera mgomiziwu yaguyambirwa agawu wampongu pawaguwona, <verse eid="PRO 1:17" /><verse number="18" style="v" sid="PRO 1:18" />kumbiti wantu awa wagwadira na kulyagamiziya weni, wayambira mgomiziwu gwa kugomiziya miyoyu yawu weni. <verse eid="PRO 1:18" /><verse number="19" style="v" sid="PRO 1:19" />Awu ndo upeleru wa wantu yawatola vintu kwa kupoka, ntambu yayilawira kwa muntu yakalikala kwa kupoka.<verse eid="PRO 1:19" /></para>
  <para style="s">Luhala lwa kushemera wantu</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 1:20" />Luhala lishemelanga kwa liziwu mnjira, lubota liziwu lyakuyi kusoku, <verse eid="PRO 1:20" /><verse number="21" style="v" sid="PRO 1:21" />lushema kwa liziwu mu magomi ga mji, pahala wantu pawalijojonira.<verse eid="PRO 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 1:22" />Mwenga mwawazigizigi! Mpaka ndii hamwendeleyi kuwera wazigizigi? Mpaka ndii mwenga yamwana beziya hawanemeleri beziya zawu na wazigizigi kukalalira luhala? <verse eid="PRO 1:22" /><verse number="23" style="v" sid="PRO 1:23" />Mpikiniri makalapira gangu, haniwamintiri maholu gangu, haniwamaniziyi visoweru vyangu. <verse eid="PRO 1:23" /><verse number="24" style="v" sid="PRO 1:24" />Toziya niwashema mlema kupikanira, niwashemera kwa liwoku mwizi mlema. <verse eid="PRO 1:24" /><verse number="25" style="v" sid="PRO 1:25" />Mgasherandiri matakula gangu, pota kugashera makalapira gangu, <verse eid="PRO 1:25" /><verse number="26" style="v" sid="PRO 1:26" />hangu neni haniwaseki palii pamtabika, haniwajongeri pamkangalwa na lyoga, <verse eid="PRO 1:26" /><verse number="27" style="v" sid="PRO 1:27" />lyoga paliwapata handa shimpepera shikulu, ndo ntabiku zyenu haziwapati handa shizyokutera, shaka utama na ntabiku paviwapata. <verse eid="PRO 1:27" /><verse number="28" style="v" sid="PRO 1:28" />Panu ndo hamnshemi kumbiti hapeninitiki, hamnsakuli kwa gangamala kumbiti hapenimmpati. <verse eid="PRO 1:28" /><verse number="29" style="v" sid="PRO 1:29" />Toziya muukalaliriti umani, na mlema kumtira Mtuwa Mlungu. <verse eid="PRO 1:29" /><verse number="30" style="v" sid="PRO 1:30" />Toziya mlemiti shaniwagambiriti neni, mgapikinirandiri magambiziya gangu. <verse eid="PRO 1:30" /><verse number="31" style="v" sid="PRO 1:31" />Su hagupati shagufiruwa kupata, na hamtabiki kulawirana na galii yamgatenda. <verse eid="PRO 1:31" /><verse number="32" style="v" sid="PRO 1:32" />Mana wazigizigi wahowa kwa kulema luhala na wapukapuka wahowa kwa kubeziya kwawu, <verse eid="PRO 1:32" /><verse number="33" style="v" sid="PRO 1:33" />kumbiti kila yakampikanira hakalikali poneka, hakalikali pota kutira.<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s">Mafupu ga luhala</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 2:1" />Mwanagwangu, paguvijimira visoweru vyangu na kugashera malagalira gangu, <verse eid="PRO 2:1" /><verse number="2" style="v" sid="PRO 2:2" />paguyambira likutu lyaku kupikinili luhala na kutula kala moyu gwaku gupati umani, <verse eid="PRO 2:2" /><verse number="3" style="v" sid="PRO 2:3" />yina, paguluwa gupananwi luhala, pagulonga shondi gupananwi umani, <verse eid="PRO 2:3" /><verse number="4" style="v" sid="PRO 2:4" />paguyisakula luhala handa madini ga feza na kuyisakula handa luhanja lwalulufifikiti, <verse eid="PRO 2:4" /><verse number="5" style="v" sid="PRO 2:5" />ndo haguvimani kumtira Mtuwa Mlungu na haguvimani mota ya kummana Mlungu. <verse eid="PRO 2:5" /><verse number="6" style="v" sid="PRO 2:6" />Toziya Mtuwa Mlungu kawapanana wantu luhala, mumulomu mwakuyi mlawa umani na mahala. <verse eid="PRO 2:6" /><verse number="7" style="v" sid="PRO 2:7" />Kawatulira yawamfiriziya Mlungu shigibikiru sha luhala luherepa, yomberi ndo ngawu kwa wantu yawalikala kwa waminika. <verse eid="PRO 2:7" /><verse number="8" style="v" sid="PRO 2:8" />Kawalolera wantu yawalikala na kutenda galii yagamfiriziya Mlungu, nakuwalonguziya wantu yawaliliviyiti kwa yomberi.<verse eid="PRO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 2:9" />Pagumpikinira haguvimani mirandu ya nakaka na yayifiruwa kulongolu kwa Mlungu, hagumani mlandu yaguwera teratera na haguvimani njira yayiwera heri. <verse eid="PRO 2:9" /><verse number="10" style="v" sid="PRO 2:10" />Toziya luhala halwingiri mumoyu mwaku na umani hawuhelipiziyi umuntu waku. <verse eid="PRO 2:10" /><verse number="11" style="v" sid="PRO 2:11" />Luhala halukuloleri, umani hawukutuliweri, <verse eid="PRO 2:11" /><verse number="12" style="v" sid="PRO 2:12" />halukulopoli nagutenda makontola, nagupayirwa na wantu yawana visoweru vipotuziya, <verse eid="PRO 2:12" /><verse number="13" style="v" sid="PRO 2:13" />wantu walii yawaleka kutenda mirandu iherepa, su walikali na kutenda vidoda, <verse eid="PRO 2:13" /><verse number="14" style="v" sid="PRO 2:14" />wantu yawanemelera kutenda makontola na kufiriziwa na upotuziya wa makontola, <verse eid="PRO 2:14" /><verse number="15" style="v" sid="PRO 2:15" />wantu weni ng'endu zawu zipotoka na njira zawu zaminikandiri.<verse eid="PRO 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 2:16" />Luhala halukutendi guwezi kumshapira mdala mhumba, mdala mndiyandiya yakana visoweru vinoga, <verse eid="PRO 2:16" /><verse number="17" style="v" sid="PRO 2:17" />mdala yakamlekiti mpalu gwa uhinga wakuyi, na kulyaluwa lipatanu lyakalituliti kwa Mlungu gwakuyi. <verse eid="PRO 2:17" /><verse number="18" style="v" sid="PRO 2:18" />Numba yakuyi yankugenda mukuhowa na matendu gakuyi gamjega pahala pawalikala yawahowiti. <verse eid="PRO 2:18" /><verse number="19" style="v" sid="PRO 2:19" />Yoseri yakamgendera mdala ayu kawuyandiri nakamu, pota hapakayiwuyiri njira ya ukomu. <verse eid="PRO 2:19" /><verse number="20" style="v" sid="PRO 2:20" />Hangu gufati mfanu gwa wantu waheri na kulikala na kutenda yagamfiriziya Mtuwa Mlungu. <verse eid="PRO 2:20" /><verse number="21" style="v" sid="PRO 2:21" />Toziya wantu waheri hawalikali muisi na waminika hawalikali mashaka goseri amu. <verse eid="PRO 2:21" /><verse number="22" style="v" sid="PRO 2:22" />Kumbiti wakontola hawawusiwi muisi na wanavidoda hawatupulwi amu.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s">Magambaziwu gamonga kwa wantemba</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 3:1" />Mwanagwangu, nagulyaluwa mafunda gangu, mumoyu gwaku kuliholi malagaliru gangu, <verse eid="PRO 3:1" /><verse number="2" style="v" sid="PRO 3:2" />toziya hagakupanani mashaka gavuwa na haguweli na mpatiru nentu. <verse eid="PRO 3:2" /><verse number="3" style="v" sid="PRO 3:3" />Ufiru na waminika navilitula gweka na gwenga. Guvitawi musingu mwaku na guvilembi mumoyu mwaku. <verse eid="PRO 3:3" /><verse number="4" style="v" sid="PRO 3:4" />Pagutenda hangu hagujimiliki na kuzyumika, kulongolu kwa Mlungu na kwa wantu.<verse eid="PRO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 3:5" />Gumtumbiri Mtuwa Mlungu kwa moyu gwaku goseri, pota nagulitumbira mahala gaku gamweni. <verse eid="PRO 3:5" /><verse number="6" style="v" sid="PRO 3:6" />Gumholi Mtuwa Mlungu mukila lyagutenda, nayomberi hakakulonguziyi njira zaku. <verse eid="PRO 3:6" /><verse number="7" style="v" sid="PRO 3:7" />Naguliwona gamweni kuwera gwana luhala nentu mumoyu gwaku, gumtiri Mtuwa Mlungu na kulitula gweka na ukontola. <verse eid="PRO 3:7" /><verse number="8" style="v" sid="PRO 3:8" />Pagutenda hangu hayiweli afya mushimba yaku na kutenda mihonju yaku iweri na makakala. <verse eid="PRO 3:8" /><verse number="9" style="v" sid="PRO 3:9" />Gumpanani ligoya Mtuwa Mlungu kwa kumlavilira lunda zaku na kwa viboga vya kwanja vyaku vyoseri. <verse eid="PRO 3:9" /><verse number="10" style="v" sid="PRO 3:10" />Panu hanja zaku hazimemi viboga nentu na mapipa gaku hagamemi divayi yasyayi.<verse eid="PRO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 3:11" />Mwanagwangu, nagubeziya Mtuwa Mlungu pakakugambiziya, pota nagukalazika kwa makalapiru gakuyi. <verse eid="PRO 3:11" /><verse number="12" style="v" sid="PRO 3:12" />Toziya Mtuwa Mlungu kawakalapira walii yakawafira, gambira tati ntambu yakamkalapira mwana gwakuyi yakamfira. <verse eid="PRO 3:12" /><verse number="13" style="v" sid="PRO 3:13" />Mbaka muntu yakayambula luhala, muntu ulii yakapata kuvimana, <verse eid="PRO 3:13" /><verse number="14" style="v" sid="PRO 3:14" />toziya luhala ndo luhelepa kuliku madini ga feza na lwana mota kuliku zahabu. <verse eid="PRO 3:14" /><verse number="15" style="v" sid="PRO 3:15" />Luhala lwana mana kuliku madini ga feza, kwahera shagushifira shashiweza kulinganira na ashi. <verse eid="PRO 3:15" /><verse number="16" style="v" sid="PRO 3:16" />Ku liwoku lyakuyi lya kumliwu kwana luhala, kuliwoku lyakuyi lya kumshigi lyana lunda na ligoya. <verse eid="PRO 3:16" /><verse number="17" style="v" sid="PRO 3:17" />Njira zakuyi ndo ziherepa, zoseri ndo njira za ponga muponga. <verse eid="PRO 3:17" /><verse number="18" style="v" sid="PRO 3:18" />Luhala ndo mtera gwa ukomu kwa woseri yawampata, hawatekeleri woseri yawamkola.<verse eid="PRO 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19" />Mtuwa Mlungu kanyawiti pasipanu kwa luhala lwakuyi,</para>
  <para style="q" vid="PRO 3:19">kwa umani wakuyi kanyawa lyela pahala pakuyi.<verse eid="PRO 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20" />Kwa umani wakuyi mbwiru zilaviyiti mashi</para>
  <para style="q" vid="PRO 3:20">na mawundi gatulusiya mangami.<verse eid="PRO 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 3:21" />Mwanagwangu, naguleka luhala na umani,</para>
  <para style="q" vid="PRO 3:21">naguvileka viwuki pamasu gaku, <verse eid="PRO 3:21" /><verse number="22" style="v" sid="PRO 3:22" />navyeni havitendi gulikali mashaka gavuwa na malembeziya gaherepa musingu mwaku. <verse eid="PRO 3:22" /><verse number="23" style="v" sid="PRO 3:23" />Panu haguwezi kugenda zaku kwa ponga na hapenigulikwali. <verse eid="PRO 3:23" /><verse number="24" style="v" sid="PRO 3:24" />Pagulikala hapeniguweri na lyoga, pagugonja hagupati mpota zinoga. <verse eid="PRO 3:24" /><verse number="25" style="v" sid="PRO 3:25" />Hapenigutira vitiliziwu vya vumu, ama makomangu kulawa kwa wakontola, <verse eid="PRO 3:25" /><verse number="26" style="v" sid="PRO 3:26" />Toziya Mtuwa Mlungu hakaweri litumbiru lyaku, hakakuloleri nagwiza kugomiziwa mmigomiziwu.<verse eid="PRO 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 3:27" />Nagumwima muntu yakafira kutangwa, handa gwana uwezu wa kutenda hangu. <verse eid="PRO 3:27" /><verse number="28" style="v" sid="PRO 3:28" />Nagumgambira gwapakwegera gwaku kagendi zakuyi mpaka shirawu, shaka gwenga guweza kumpanana shakafira leru. <verse eid="PRO 3:28" /><verse number="29" style="v" sid="PRO 3:29" />Nagupanga makontola kwa gwapakwegera gwaku, yakalikala pakwegera na gwenga pakakwamini. <verse eid="PRO 3:29" /><verse number="30" style="v" sid="PRO 3:30" />Nagulilewa na muntu pota toziya payiwera hakenikutenderi mlandu goseri mdoda. <verse eid="PRO 3:30" /><verse number="31" style="v" sid="PRO 3:31" />Nagumwonera weya muntu gwa ndewi, pota nagujera ntambu yakatenda. <verse eid="PRO 3:31" /><verse number="32" style="v" sid="PRO 3:32" />Toziya wakontola ndo nkalaliru kwa Mtuwa Mlungu, kumbiti yomberi kankuwatenda wamaganja wakuyi walii yawatenda yagafiruwa na Mlungu. <verse eid="PRO 3:32" /><verse number="33" style="v" sid="PRO 3:33" />Mtuwa Mlungu kapangira numba za wakontola, kumbiti katekelera numba za wantu yawatenda yagafiruwa na Mlungu. <verse eid="PRO 3:33" /><verse number="34" style="v" sid="PRO 3:34" />Yomberi kawabeziya yawambeziya, kumbiti kawapanana upenderewu yawalisereziya. <verse eid="PRO 3:34" /><verse number="35" style="v" sid="PRO 3:35" />Yawana luhala hawahali ligoya, kumbiti wazigizigi hawapati soni.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s">Kumota kwa Luhala</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 4:1" />Wanawangu, mpikaniri mafunda gwa tati gwenu, myambili likutu muweri na umani. <verse eid="PRO 4:1" /><verse number="2" style="v" sid="PRO 4:2" />Mana nankuwapanana malagalira maheri, gugaholi mafunda ganeni. <verse eid="PRO 4:2" /><verse number="3" style="v" sid="PRO 4:3" />Shaka paweriti mwana gwa tati, weriti mwana gwa gweka kwa mawu gwangu. <verse eid="PRO 4:3" /><verse number="4" style="v" sid="PRO 4:4" />Tati gwangu kafunditi: “Guvikoli kwa moyu visoweru vyangu, gukoli lagalira zyangu na hagulikali. <verse eid="PRO 4:4" /><verse number="5" style="v" sid="PRO 4:5" />Gupati luhala, gupati umani, nagulyaluwa pota kubeziya visoweru vyangu. <verse eid="PRO 4:5" /><verse number="6" style="v" sid="PRO 4:6" />Nagumleka luhala nayomberi hakakutuliweri, gumfiri nayomberi halukuloleri. <verse eid="PRO 4:6" /><verse number="7" style="v" sid="PRO 4:7" />Mlandu gwa mana nentu ndo kulipanana luhala; gulaviyi vyoseri vyaguweriti navi gupati umani. <verse eid="PRO 4:7" /><verse number="8" style="v" sid="PRO 4:8" />Gumsheri nentu luhala nayomberi hakakukwisi, pagumkolera hakakupanani ligoya. <verse eid="PRO 4:8" /><verse number="9" style="v" sid="PRO 4:9" />Hakakuvaliziyi shilemba shiherepa pamtuyi paku, hakakupanani lijenjeri lyaliherepeziyitwi.”<verse eid="PRO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 4:10" />Mwanagwangu, gupikanili na kwanka visoweru vyangu, su guweri na vinja vivuwa vya kulikala. <verse eid="PRO 4:10" /><verse number="11" style="v" sid="PRO 4:11" />Nikulanguziya njira ya luhala, nikulonguziya munjira yayimherepiziya Mlungu. <verse eid="PRO 4:11" /><verse number="12" style="v" sid="PRO 4:12" />Pagugendagenda kwahera shakukulowelera, na pagutuga hapenigulikwali. <verse eid="PRO 4:12" /><verse number="13" style="v" sid="PRO 4:13" />Gukoleri mafunda ga luhala nagumleka kakupoti, gugaloleri weri toziya ndo ukomu waku. <verse eid="PRO 4:13" /><verse number="14" style="v" sid="PRO 4:14" />Nagulingiziya munjira ya wakontola, pota nagufata vyawatenda wantu wadoda. <verse eid="PRO 4:14" /><verse number="15" style="v" sid="PRO 4:15" />Gulitulikutali na njira ayi pota naguyisegelera, gulekani nayi, gugendi zaku. <verse eid="PRO 4:15" /><verse number="16" style="v" sid="PRO 4:16" />Wakontola nakamu wagonjandiri pawatendandiri ukontola, wapatandiri mpota pawamtendandiri muntu. <verse eid="PRO 4:16" /><verse number="17" style="v" sid="PRO 4:17" />Waliya shiboga shashilawirana na ukondola, na kulanda divayi yayilawirana na ungesela.<verse eid="PRO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 4:18" />Kumbiti njira ya wantu waheri ndo handa gulangala gwa mandawira, gweni gulangala nentu na nentu ata paliwala poseri. <verse eid="PRO 4:18" /><verse number="19" style="v" sid="PRO 4:19" />Njira ya wantu wakontola ndo handa luwindu dunyu, washimanandiri shashiwatenda walikwali.<verse eid="PRO 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 4:20" />Mwanagwangu gupikanili weri visoweru vyangu, guyambiri likutu galii gantakula. <verse eid="PRO 4:20" /><verse number="21" style="v" sid="PRO 4:21" />Nagugaleka gawuki, gugatuli mu moyu mwaku. <verse eid="PRO 4:21" /><verse number="22" style="v" sid="PRO 4:22" />Toziya aga ndo ukomu kwa muntu yakagapata, ndo mgota kwa nshimba yoseri. <verse eid="PRO 4:22" /><verse number="23" style="v" sid="PRO 4:23" />Guloleri weri moyu gwaku, toziya amu ndo kwazilawa mbwiru za ukomu. <verse eid="PRO 4:23" /><verse number="24" style="v" sid="PRO 4:24" />Nagutakula visoweru vyavipotiziya na milomu yaku nayitakula visoweru vya mpayu. <verse eid="PRO 4:24" /><verse number="25" style="v" sid="PRO 4:25" />Masu gaku galoli kulongolu kwa ugangamala, guloli kulongolu magenda. <verse eid="PRO 4:25" /><verse number="26" style="v" sid="PRO 4:26" />Guyitandi njira zyagupitira na maleka gaku hagaweri magangamala. <verse eid="PRO 4:26" /><verse number="27" style="v" sid="PRO 4:27" />Nagugalambuka kumliwu pota kumshigi, gukali kutali na ukontola.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s">Libeliziwu toziya ya uhumba</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 5:1" />Mwanagwangu, gupikanili luhala lwangu, gwambili likutu gupikini mafunda gangu. <verse eid="PRO 5:1" /><verse number="2" style="v" sid="PRO 5:2" />Su guwezi kwamuwa weri na miromu yaku nayileka kutakula visoweru vya umani. <verse eid="PRO 5:2" /><verse number="3" style="v" sid="PRO 5:3" />Mlomu gwa mdala mhumba gulaviya visoweru vinoga handa lwashi, visoweru vyakuyi vikwegeziya handa lipaki lya mzeyituni, <verse eid="PRO 5:3" /><verse number="4" style="v" sid="PRO 5:4" />kumbiti upeleru wakuyi ndo ukalipa handa shikalikali na ukalipa handa ligumba lyalilikitula koseri. <verse eid="PRO 5:4" /><verse number="5" style="v" sid="PRO 5:5" />Magulu gakuyi gagendera kumauti, maleka gakuyi gagenda pahala pa wantu yawahowiti. <verse eid="PRO 5:5" /><verse number="6" style="v" sid="PRO 5:6" />Yomberi kayisherandiri njira ya ukomu, njira zakuyi zakuyerayera pota kavimanandiri.<verse eid="PRO 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 5:7" />Vinu mwenga wanawangu mumpikaniri, pota namlyaluwa visoweru vyangu. <verse eid="PRO 5:7" /><verse number="8" style="v" sid="PRO 5:8" />Gulikali kutali nayomberi, pota nagusegelera ligomi lya numba yakuyi. <verse eid="PRO 5:8" /><verse number="9" style="v" sid="PRO 5:9" />Nagwiza kuwapanana wamonga makakala gaku, na vinja vyaku kwa wankesera, <verse eid="PRO 5:9" /><verse number="10" style="v" sid="PRO 5:10" />wahenga hawatoli lunda zaku, na livuki lyaku lipeleri kwa mhenga. <verse eid="PRO 5:10" /><verse number="11" style="v" sid="PRO 5:11" />Upeleru wa kulikala kwaku hagudayi shaka nshimba yaku pagwagamiziwa. <verse eid="PRO 5:11" /><verse number="12" style="v" sid="PRO 5:12" />Panu hagulongi, iweriti hashi nkalaliriti kufundwa, na kubeziya mabereziwu mumoyu gwangu? <verse eid="PRO 5:12" /><verse number="13" style="v" sid="PRO 5:13" />Niwapikaniritindiri wafunda wangu, pota kuwayambira likutu kwa wagambiziya wangu. <verse eid="PRO 5:13" /><verse number="14" style="v" sid="PRO 5:14" />Vinu napakwegera kwagamira nakamu, pakati pa shipinga shoseri sha wantu kusoniziwa.<verse eid="PRO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 5:15" />Gulandi mashi ga mbwiru yaku gamweni, gulandi mashi ga linegu lyaku gamweni. <verse eid="PRO 5:15" /><verse number="16" style="v" sid="PRO 5:16" />Hashi mbwiru zaku zipalasiwi kutali na nshemba za mashi zilipalasi munjira? <verse eid="PRO 5:16" /><verse number="17" style="v" sid="PRO 5:17" />Ayi iweri yaku gamweni, pota naguwapanana wantu wamonga. <verse eid="PRO 5:17" /><verse number="18" style="v" sid="PRO 5:18" />Mbwiru yaku na itekelerwi, gumnemeleri mdala gwaku yagumhetiti paguweriti mntemba. <verse eid="PRO 5:18" /><verse number="19" style="v" sid="PRO 5:19" />Kaherepa handa mbalapi, kafiriziya handa mbawala. Maweri gakuyi gakufiriziyi mashaka goseri na ufiru wakuyi ukukisikiri mashaka goseri. <verse eid="PRO 5:19" /><verse number="20" style="v" sid="PRO 5:20" />Mwanagwangu, ntambu gaa gulopolwa na mdala muhumba? Ntambu gaa kumkisikira pashifuwa mdala yumonga? <verse eid="PRO 5:20" /><verse number="21" style="v" sid="PRO 5:21" />Toziya njira za muntu zyalupalahera kulongolu kwa Mtuwa Mlungu, yomberi kawona kila shintu shakatenda muntu. <verse eid="PRO 5:21" /><verse number="22" style="v" sid="PRO 5:22" />Muntu mkontola kagomiziwa kwa ukontola wakuyi mweni, kabatwa na migomiziwu ya vidoda vyakuyi mweni. <verse eid="PRO 5:22" /><verse number="23" style="v" sid="PRO 5:23" />Yomberi kahowa toziya kasinda kulilewelera, kagamira toziya ya uzigizigi wakuyi mkulu.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s">Maberiziwu gamonga</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 6:1" />Mwanagwangu, handa gulilaviya kumtanga gwapakwegera gwaku, payiwera gutakula hagutendi shintu tunga toziya ya muntu yumonga, <verse eid="PRO 6:1" /><verse number="2" style="v" sid="PRO 6:2" />handa gulipata kwa visoweru vyaku gamweni, handa guligomiziya kwa shilii shagutakuliti hagutendi. <verse eid="PRO 6:2" /><verse number="3" style="v" sid="PRO 6:3" />Guvimani gwa pasi pa ukulu wa muyagu, hangu mwanagwangu, pagufira kulilopola gufiruwa gutendi hangu gumgenderi na kulinanagaziyi kwa muntu ayu kalongola gumluwi kakupanani ulekeru waku. <verse eid="PRO 6:3" /><verse number="4" style="v" sid="PRO 6:4" />Nagujimira kugonja, pota kusizira. <verse eid="PRO 6:4" /><verse number="5" style="v" sid="PRO 6:5" />Gulilopoli kwa kulilaviya mumgomiziwu agu, ntambu ya mbawala ama mpongu yakampota yakamwinditi.<verse eid="PRO 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 6:6" />Gwee mleri, gukamsunguliri mehi, guliholi ntambu yakalikala su gupati luhala. <verse eid="PRO 6:6" /><verse number="7" style="v" sid="PRO 6:7" />Mehi kahera mlonguziya, mkulu, pota mkolamlima, <verse eid="PRO 6:7" /><verse number="8" style="v" sid="PRO 6:8" />kumbiti walitulira shiboga shaka sha mabenangu, kajojonira shiboga shakuyi shaka pashiwera shitangala shipatikana shkubenanga. <verse eid="PRO 6:8" /><verse number="9" style="v" sid="PRO 6:9" />Gwee mleri, hagugonji panu mpaka ndii? Hagwimuki ndii mumpota zaku? <verse eid="PRO 6:9" /><verse number="10" style="v" sid="PRO 6:10" />Gulonga, guleki ng'onji shididini hera, guleki ndaviyi mpota shididini, guleki mawoku goyeri shididini. <verse eid="PRO 6:10" /><verse number="11" style="v" sid="PRO 6:11" />Shaka ashi uhushu hawukukankali handa mpoka, na kuperuwa hakukufati handa mashinjashinja.<verse eid="PRO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 6:12" />Muntu mpotoziya na muntu mkontola, kayerayera pakalonga visoweru vyawupotuziya. <verse eid="PRO 6:12" /><verse number="13" style="v" sid="PRO 6:13" />Kakupira lisu kuwapotuziya wamonga, na kuyowera kwa nzyayu, na kulanguziya wantu kwa vyala su kupayira, <verse eid="PRO 6:13" /><verse number="14" style="v" sid="PRO 6:14" />su kamema upyota mumoyu mwakuyi na kapanga kutenda makontola na kasongeziya ndewi kila pahala. <verse eid="PRO 6:14" /><verse number="15" style="v" sid="PRO 6:15" />Kulawirana na mirandu ayi madoda ntabiku haimkankali vumu, hakatenduwi nentu hapakaponi kayi.<verse eid="PRO 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 6:16" />Kwana vintu sita vyakavikalalira Mtuwa Mlungu, yina vintu saba vyeni ndo nkalaliru kwakuyi.<verse eid="PRO 6:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="PRO 6:17" />Masu ga mtiti na lulimi lwa mpayu na mawoku yagalaga wantu yawatenditindiri vidoda,<verse eid="PRO 6:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="PRO 6:18" />Moyu gwagupanga makontola na magulu yagatuga kutenda makontola,<verse eid="PRO 6:18" /></para>
  <para style="li">
    <verse number="19" style="v" sid="PRO 6:19" />Kapitawu gwa mpayu yakatakula mpayu na muntu yakasongiziya ndewu pakati pa walongu.<verse eid="PRO 6:19" /></para>
  <para style="s">Maberiziwu toziya ya uhumba</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 6:20" />Mwanagwangu, gukoli malagalira ga tati gwaku, pota kulyaluwa mafunda ga mawu gwaku, <verse eid="PRO 6:20" /><verse number="21" style="v" sid="PRO 6:21" />gugatuli mumoyu gwaku mashaka goseri, gugatawi handa ukufu musingu mwaku. <verse eid="PRO 6:21" /><verse number="22" style="v" sid="PRO 6:22" />Hagakulonguziyi munjira mwaku, hagakuloleri shaka pagugonja, hagakugambiziyi shaka paguwera masu paliwala. <verse eid="PRO 6:22" /><verse number="23" style="v" sid="PRO 6:23" />Toziya malagalira aga ndo handa koroboyi na lagiru ali ndo handa langala. Maberiziya gakuyi ndo handa njira yayilonguziya muukomu. <verse eid="PRO 6:23" /><verse number="24" style="v" sid="PRO 6:24" />Hagakuloleri kulawirana na mdala mdoda, havikushapili na visoweru vinoga vya mdala mhumba. <verse eid="PRO 6:24" /><verse number="25" style="v" sid="PRO 6:25" />Nagumfira mdala ulii kwa kuherepa kwakuyi, pota nagujimira kugomoziwa kwa masu gakuyi ga kalembula. <verse eid="PRO 6:25" /><verse number="26" style="v" sid="PRO 6:26" />Toziya ya uhumba muntu kaweza kuwera mhushu mpaka kaluwa libumunda, toziya ya mdala gwa muntu yumonga kakutenda kuhowiziyi kila shintu.<verse eid="PRO 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 6:27" />Muntu kaweza kutula motu pashifuwa na nguwu zaku kulungulira? <verse eid="PRO 6:27" /><verse number="28" style="v" sid="PRO 6:28" />Hashi muntu kaweza kutimbanga makala ga motu na nzayu zaku hapazilunguliri? <verse eid="PRO 6:28" /><verse number="29" style="v" sid="PRO 6:29" />Ndo ntambu yakawera mpalu yakagonja na mdala gwa myaguyi, yoseri yakamshinkula mdala ulii hapakalekwi kukomangwa. <verse eid="PRO 6:29" /><verse number="30" style="v" sid="PRO 6:30" />Wantu wambereziyandiri shimbegu pakiwa toziya ya njala, <verse eid="PRO 6:30" /><verse number="31" style="v" sid="PRO 6:31" />kumbiti pawambata kafiruwa kalipi mala saba, kayi hakalaviyi lunda yoseri yakaweranayi. <verse eid="PRO 6:31" /><verse number="32" style="v" sid="PRO 6:32" />Kumbiti mpalu yakagonja na mdala gwa muntu ayu kahera mahala nakamu, nayomberi kalyagamiziya mweni. <verse eid="PRO 6:32" /><verse number="33" style="v" sid="PRO 6:33" />Hakapati vironda na hakabeziwi na soni yanakayipati hapeniimuwuki. <verse eid="PRO 6:33" /><verse number="34" style="v" sid="PRO 6:34" />Toziya weya wa mpalu umtenda kuwera kakalipi nakamu, shaka pakawuzilira hapenikaweri na lusungu. <verse eid="PRO 6:34" /><verse number="35" style="v" sid="PRO 6:35" />Hapenikajimiri malipu goseri, pota kunyamaziwa na mafupu goseri.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 7:1" />Mwanagwangu, gukoli visoweru vyangu na guzituli lagaru zyangu. <verse eid="PRO 7:1" /><verse number="2" style="v" sid="PRO 7:2" />Gufati lagalira zyangu na gwenga hagulikali. Gugaloleri mafundu gangu handa lisu lyaku. <verse eid="PRO 7:2" /><verse number="3" style="v" sid="PRO 7:3" />Shaka shoseri gugaholi malagaliru gangu na gugatuli mumoyu gwaku. <verse eid="PRO 7:3" /><verse number="4" style="v" sid="PRO 7:4" />Gulugambiri luhala, gwenga ndo dada gwangu na mahala gwenga ndo ganja gwagu. <verse eid="PRO 7:4" /><verse number="5" style="v" sid="PRO 7:5" />Aga agakutuli kutali na mdala mhumba, havituli kutali na visoweru vinoga vya mdala yakaminikandiri.<verse eid="PRO 7:5" /></para>
  <para style="s">Mdala mhumba</para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 7:6" />Lishaka limu nsunguliriti kunja kupitira lidilisha lya numba yangu, <verse eid="PRO 7:6" /><verse number="7" style="v" sid="PRO 7:7" />niwawona wantemba wavuwa wapukapuka, na yumu gwawu kaweriti mzigizigi. <verse eid="PRO 7:7" /><verse number="8" style="v" sid="PRO 7:8" />Ayu kaweriti kakugendagenda munjira ilii, pakwegera na numba yakalikala mdala tunga. Su kayifata njira yayigenda ukaya kwa mdala ayu, <verse eid="PRO 7:8" /><verse number="9" style="v" sid="PRO 7:9" />iweriti shaka sha pashimii, luwindu na pashiru viweriti lyanjiti kala kwingira. <verse eid="PRO 7:9" /><verse number="10" style="v" sid="PRO 7:10" />Vumu mdala kaliwona na mntemba ayu; kaweriti kavala handa mhumba na kaweriti na yakana mipangu yakuyi. <verse eid="PRO 7:10" /><verse number="11" style="v" sid="PRO 7:11" />Kaweriti mdala yakana umatu na yakahera soni na kaweriti kalikalandiri ukaya: <verse eid="PRO 7:11" /><verse number="12" style="v" sid="PRO 7:12" />Katepu munjira, katepu kusoku, mumapandanjira hapenigumkosi pakagwadira. <verse eid="PRO 7:12" /><verse number="13" style="v" sid="PRO 7:13" />Kamkisikiliti mntemba ayu na kumnonera na kwa visoweru vinoga, kamgambira pota soni, <verse eid="PRO 7:13" /><verse number="14" style="v" sid="PRO 7:14" />ndaviya tambiku zangu za mapatanu, leru ndo malira shanongiti. <verse eid="PRO 7:14" /><verse number="15" style="v" sid="PRO 7:15" />Ndo mana ndawa su nikwanki nikusakula kwa nfiru nikupata. <verse eid="PRO 7:15" /><verse number="16" style="v" sid="PRO 7:16" />Nyalika shitanda shangu weri, kwa shuka za rangi nfufu kulawa Misri. <verse eid="PRO 7:16" /><verse number="17" style="v" sid="PRO 7:17" />Ndekeriti utuli, manimani, udi na mdalasini. <verse eid="PRO 7:17" /><verse number="18" style="v" sid="PRO 7:18" />Gwizi tugonji pamuhera mpaka mandawira, gwizi tulinemiziyi kwa kuligonja. <verse eid="PRO 7:18" /><verse number="19" style="v" sid="PRO 7:19" />Mpalu gwangu kwahera ukaya kagenda mwanja gwa kutali. <verse eid="PRO 7:19" /><verse number="20" style="v" sid="PRO 7:20" />Katola libulungutu lya mpiya, hapanikawuyi ukaya mpaka mpeleru gwa mwezi. <verse eid="PRO 7:20" /><verse number="21" style="v" sid="PRO 7:21" />Kamgambiriti visoweru vivuwa vya kazyangwazyangwa, na kamkwenga kwa visoweru vyakuyi vinoga. <verse eid="PRO 7:21" /><verse number="22" style="v" sid="PRO 7:22" />Panu kamfata mdala ayu magenda handa ng'ombi shipalu yakagenda mumachinjiru handa mpalapi yakabatwa mumgomiziwu, <verse eid="PRO 7:22" /><verse number="23" style="v" sid="PRO 7:23" />mpaka pakaliwoniti kawera handa wamsoma msali mumoyu, kuwera handa mpongu yakagendera muwavu, kavimanitindiri kuwera mekautendi ukomu wakuyi.<verse eid="PRO 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 7:24" />Hangu wanawangu, mumpikaniri, mviyambili makutu visoweru vyaniwagambira. <verse eid="PRO 7:24" /><verse number="25" style="v" sid="PRO 7:25" />Namjimira moyu gwaku kumfata mdala handa ayu, pota nampita munjira yakuyi. <verse eid="PRO 7:25" /><verse number="26" style="v" sid="PRO 7:26" />Toziya kawagusiya wapalu wavuwa na kutenda wapalu watangala walaguwi. <verse eid="PRO 7:26" /><verse number="27" style="v" sid="PRO 7:27" />Numba yakuyi ndo njira ya kugenda kulisembi na ndo njira ya kusulukira kuhowa.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s">Luhala lwankukwiswa</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 8:1" />Hashi! Luhala lulirandiri?</para>
  <para style="q" vid="PRO 8:1">Umani kabotanga liziwu lyakuyi?<verse eid="PRO 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2" />Pampindi pashidunda pakwegera na njira,</para>
  <para style="q" vid="PRO 8:2">mumapandanjira ndo kagoloka.<verse eid="PRO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3" />Pakwegera na magomi ga kwingilira kumjini,</para>
  <para style="q" vid="PRO 8:3">pahala pawingilira wantu kashema kwa kubota pakalonga.<verse eid="PRO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4" />Mwenga mwawantu woseri, Niwaluwa mwenga!</para>
  <para style="q" vid="PRO 8:4">Liziwu lyangu ndo lyakuwashemera.<verse eid="PRO 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5" />Mwenga yamumanandiri, mulifundi kuwera na luhala, mwenga wazigizigi mulifundi kuwera na umani.<verse eid="PRO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6" />Mpikaniri toziya shafira kutakula ndo sha mana,</para>
  <para style="q" vid="PRO 8:6">miromu yaneni hayilavi mirandu ya nakaka.<verse eid="PRO 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7" />Mlomu gwangu hagutakuli nakaka hera,</para>
  <para style="q" vid="PRO 8:7">ukontola ndo ngalaliru mmulomu mwangu.<verse eid="PRO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8" />Visoweru vyoseri vyantakula ndo vya nakaka,</para>
  <para style="q" vid="PRO 8:8">kwahera sha uzanga muvisoweru avi.<verse eid="PRO 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9" />Kwa muntu yakamana umani lupalahera,</para>
  <para style="q" vid="PRO 8:9">kwa yakana mahala ndo teratera.<verse eid="PRO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10" />Gusaguli mafunda gangu badala ya madini ga feza,</para>
  <para style="q" vid="PRO 8:10">umani badala ya zahabu iherepa.<verse eid="PRO 8:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11" />Neni luhala nanamana kuliku mabuwi ga beyi nkulu,</para>
  <para style="q" vid="PRO 8:11">shoseri shagushifira shiwezandiri kulifani na neni.<verse eid="PRO 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12" />Neni luhala nana umani,</para>
  <para style="q" vid="PRO 8:12">nana umani na mahala.<verse eid="PRO 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13" />Kumguwira Mtuwa Mlungu ndo kukalalira ukontola.</para>
  <para style="q" vid="PRO 8:13">Nkalalira mtiti na njira za ukontola na visoweru vya upaya.<verse eid="PRO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14" />Nana uwezu wa kumgambiziya muntu na kulipanana luhala.</para>
  <para style="q" vid="PRO 8:14">Neni nana umani na nana uwezu.<verse eid="PRO 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15" />Niwatanga wafalumi wakolamlima</para>
  <para style="q" vid="PRO 8:15">na walonguziya kulaviya lagiru ziherepa.<verse eid="PRO 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16" />Niwatanga walonguziya wakolamlima vilavilii wakulu</para>
  <para style="q" vid="PRO 8:16">na watoza wakolamlima weri.<verse eid="PRO 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17" />Niwafira walii yawanfira,</para>
  <para style="q" vid="PRO 8:17">yawansakula kwa gangamala hampati.<verse eid="PRO 8:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18" />Ulunda na ligoya vya kwaneni,</para>
  <para style="q" vid="PRO 8:18">kuwera na vintu vitangala kulikala na mpatiru,<verse eid="PRO 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19" />Mabwajubwaju ganeni ndo gaherepa kuliku zahabu iherepa,</para>
  <para style="q" vid="PRO 8:19">mota yaneni ikanka madini ga feza ilii iherepa.<verse eid="PRO 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20" />Ng'endang'enda munjira iherepa</para>
  <para style="q" vid="PRO 8:20">na nfata njira yazifiriziya.<verse eid="PRO 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21" />Neni niwapanana ulunda yawanfira,</para>
  <para style="q" vid="PRO 8:21">nizimemiziya nduu hanja munumba zawu yawanfira.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 8:22" />Mtuwa Mlungu kanyawiti pakanjiti lihengu lyakuyi,</para>
  <para style="q" vid="PRO 8:22">makashu pamberi kenetendi lihengu lyoseri.<verse eid="PRO 8:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23" />Nyawitwi pamwanjiru,</para>
  <para style="q" vid="PRO 8:23">pamberi pa pasipanu kuwera.<verse eid="PRO 8:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24" />Niwukiti pamberi pa matiwa ga bahari,</para>
  <para style="q" vid="PRO 8:24">pamberi pa mbwiru zyazibwitula mashi.<verse eid="PRO 8:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25" />Pamberi pa migongu hayeninyawiwi,</para>
  <para style="q" vid="PRO 8:25">navidunda kugolusiwa pahala pakuyi neni weritikala,<verse eid="PRO 8:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26" />Pamberi Mlungu keninyawi pasipanu na malambu gakuyi,</para>
  <para style="q" vid="PRO 8:26">pota lidikudiku lya pasipanu.<verse eid="PRO 8:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27" />Weriti shaka pakatuliti mpindi,</para>
  <para style="q" vid="PRO 8:27">shaka pakatuliti mpaka panani pa bahari,<verse eid="PRO 8:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28" />shaka pakagangamaziyiti mawundi kumpindi</para>
  <para style="q" vid="PRO 8:28">na pakazigamaziyiti mbwiru za pasi nentu,<verse eid="PRO 8:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29" />shaka pakayituliriti bahari mpaka zakuyi,</para>
  <para style="q" vid="PRO 8:29">su mashi gakuyi kuloka mpaka zakuyi</para>
  <para style="q" vid="PRO 8:29">na shaka pakayituliti miyanjiru ya pasipanu.<verse eid="PRO 8:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30" />Weriti pamuhera nayomberi handa fundi kaherepa,</para>
  <para style="q" vid="PRO 8:30">weriti nemeleru yakuyi kila lishaka, panemelera kulongolu kwakuyi mashaka goseri,<verse eid="PRO 8:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31" />panemelelera toziya ya pasipanu poseri,</para>
  <para style="q" vid="PRO 8:31">nakufiriziwa na wantu wakuyi.<verse eid="PRO 8:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32" />Vinu su wanawangu,</para>
  <para style="q" vid="PRO 8:32">mumpikaniri,</para>
  <para style="q" vid="PRO 8:32">mbaka walii yawafata njira zaneni.<verse eid="PRO 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33" />Mpikaniri mafunda mpati luhala,</para>
  <para style="q" vid="PRO 8:33">pota namgalema.<verse eid="PRO 8:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34" />Mbaka muntu yakampikanira,</para>
  <para style="q" vid="PRO 8:34">yakawera kila lishaka paligomi lyangu,</para>
  <para style="q" vid="PRO 8:34">yakalikala masu pa kwingilira kwaneni.<verse eid="PRO 8:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35" />Mana yakampata neni kapata ukomu,</para>
  <para style="q" vid="PRO 8:35">kapata upendelewu kwa Mtuwa Mlungu.<verse eid="PRO 8:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36" />Kumbiti yakampatandiri neni kalitenda mweni,</para>
  <para style="q" vid="PRO 8:36">woseri yawankalalira wafira kuhowa.<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s">Luhala na uzigizigi</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 9:1" />Luhala kanyawa numba yakuyi na numba yana mpanda saba. <verse eid="PRO 9:1" /><verse number="2" style="v" sid="PRO 9:2" />Kawalikitula wavigongolu wa msambu, kayitanda divayi yakuyi, kazalira meza yakuyi. <verse eid="PRO 9:2" /><verse number="3" style="v" sid="PRO 9:3" />Kawatumiti wantumintumi wakuyi wadala kumjini, washemi wantu kulawa kumpeleru za vidunda: <verse eid="PRO 9:3" /><verse number="4" style="v" sid="PRO 9:4" />“Yoseri yakwera mzigizigi kizi panu!” Na yoseri yakaweramahala kamgambiraga. <verse eid="PRO 9:4" /><verse number="5" style="v" sid="PRO 9:5" />Gwizi gulii shiboga na gulandi divayi yanyawiti. <verse eid="PRO 9:5" /><verse number="6" style="v" sid="PRO 9:6" />Mleki njira zyenu za uzigizigi su guwezi kulikala, gufati njira ya mahala.<verse eid="PRO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 9:7" />Muntu yoseri yakamkalapila yakana beziya kasakula kwigiranga, yoseri yakamkosola mkontola kapelera mukutenduwa. <verse eid="PRO 9:7" /><verse number="8" style="v" sid="PRO 9:8" />Nagumkalipira yakana beziya mana hakakukalaliri, kumbiti pagumberiziyi yakana luhala nayomberi hakakufili. <verse eid="PRO 9:8" /><verse number="9" style="v" sid="PRO 9:9" />Gumfundi yakana luhala nayomberi hakongeri kuwera na luhala, gumfundi yakana moyu guherepa nayomberi hakongeri kuvimana.<verse eid="PRO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 9:10" />Kumguwira Mtuwa Mlungu ndo lyanjiru lya luhala na kummana yulii mnanagala ndo kupata mahala. <verse eid="PRO 9:10" /><verse number="11" style="v" sid="PRO 9:11" />Toziya ya neni Luhala mashaka gaku hagongereki na hagongerewi vinja vivuwa mukulikala kwaku. <verse eid="PRO 9:11" /><verse number="12" style="v" sid="PRO 9:12" />Paguwera gwana luhala, hakuweri na mpatiru gamweni, kumbiti pagwana beziya hagupati ntabiku gamweni.<verse eid="PRO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 9:13" />Mdala mzigizigi kana umatu, kavimanandiri shintu pota kahera soni. <verse eid="PRO 9:13" /><verse number="14" style="v" sid="PRO 9:14" />Kalikala pamlyangu gwa numba yakuyi na katula shiti shakuyi pahalia pavidunda pa mji, <verse eid="PRO 9:14" /><verse number="15" style="v" sid="PRO 9:15" />na kuwashema wantu yawapita munjira, wantu yawagenda mumahengu gawu. <verse eid="PRO 9:15" /><verse number="16" style="v" sid="PRO 9:16" />“Yoseri kapukapuka na kizi panu! Na yoseri yakawera mzigizigi kamgambiraga,” <verse eid="PRO 9:16" /><verse number="17" style="v" sid="PRO 9:17" />mashi ga kwiwa ganoga ng'anji, libumunda lyawaliliya kwa bada gunoga nentu. <verse eid="PRO 9:17" /><verse number="18" style="v" sid="PRO 9:18" />Kumbiti wavimanandiri walii yawahowa wagenda kunumba yakuyi, wahenga yawawera amu wamumasembi.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">Visoweru vyana umani vya Selemeni</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Luhala lwa Selemeni,</para>
  <para style="p" vid="PRO 10:1">Mwana yakana luhala ndo nemeru kwa tati gwakuyi; kumbiti mwana mzigizigi ndo hinginika ya mawu gwakuyi.<verse eid="PRO 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 10:2" />Lunda yayipatikaniti kwa njira idoda ifaandiri, kumbiti kutenda yagamfiriziya Mlungu gamlopola muntu kulawa mkuhowa.<verse eid="PRO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 10:3" />Mtuwa Mlungu kawalekandiri yawatenda yagamfiriziya wapati njala, kumbiti kazilema matamata za wakontola.<verse eid="PRO 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 10:4" />Mawoku ga mleri gajega uhushu, kumbiti liwoku lya muntu mgangamala umtenda kuwera mlunda.<verse eid="PRO 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 10:5" />Yakana luhala kajojonira shaka sha mabenangu, kugonja shaka sha kubenanga ndo soni.<verse eid="PRO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 10:6" />Muntu mheri kalijegera tekelera ulamweni, kumbiti mlomu gwa mkontola gufifa unkesera.<verse eid="PRO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 10:7" />Yawatenda maheri waholwi kwa tekelera, kumbiti wakontola hawalyaluwi nakamu.<verse eid="PRO 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 10:8" />Yakana luhala mumoyu kajimira kugambiziya, kumbiti mzigizigi yakatakula pota kulihola hakagamiri.<verse eid="PRO 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 10:9" />Muntu yakalikala Mlungu ntambu yakafila kalikala poneka, kumbiti muntu yakagenda munjira yayipotuziya hakamaniki.<verse eid="PRO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 10:10" />Yakakupira kwa nfiru idoda, hakanjishi ntabiku, kumbiti yakaberiziya kwa ugangamala kajega ponga.<verse eid="PRO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 10:11" />Mlomu gwa mtenda maheri ndo mbwiru ya ukomu, kumbiti visoweru vya mkontola gafifa makontola.<verse eid="PRO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 10:12" />Maya gajega ndewu, kumbiti ufiru ugibikira madoda goseri.<verse eid="PRO 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 10:13" />Mmulomu mwa wana umani mwana luhala, kumbiti yawahera mahala hawakomangwi.<verse eid="PRO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 10:14" />Yawana luhala watula umani, kumbiti kutakula kwa wazigizigi kujega matenduwa kalongola.<verse eid="PRO 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 10:15" />Vintu vya muntu mlunda ndo liboma lyakuyi, kumbiti uhushu wa mhushu umjegera maagamiziya.<verse eid="PRO 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 10:16" />Shibenamgongu sha mtu mheri ndo ukomu, kumbiti shakapata muntu mkontola shimjegera toza.<verse eid="PRO 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 10:17" />Yakajimira mabeliziwu kagenda muukomu, kumbiti yakalema kuberiziwa kagamira.<verse eid="PRO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 10:18" />Yakamkalira yumonga kwa bada ndo mfyangu, yakampayira muntu ndo mzigizigi.<verse eid="PRO 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 10:19" />Pavisoweru vitangala pakosandiri vidoda, kumbiti yakalulewelera lulimi lwakuyi kana luhala.<verse eid="PRO 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 10:20" />Visoweru vya muntu mheri ndo handa madini gaherepa ga feza,kumbiti maholu ga muntu mkondola gahera mana yoseri.<verse eid="PRO 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 10:21" />Visoweru vya muntu mheri viwafaa wantu wavuwa, kumbiti wazigizigi wahowa toziya wahera mahala.<verse eid="PRO 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 10:22" />Tekelera za Mtuwa Mlungu ndo zyazijega mpatiru na lihengu lya muntu zongerandiri hinginika.<verse eid="PRO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 10:23" />Kwa mzigizigi kutenda makontola ndo handa kudinga, kumbiti wantu yawana mahala wanemelera luhala.<verse eid="PRO 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 10:24" />Shakashitira muntu mkontola ndo shanakashipati, kumbiti shakashifira muntu mheri ndo shakapananwa.<verse eid="PRO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 10:25" />Shimbepera pashipita mkontola ndo yagagamira, kumbiti muntu mheri kagangamiziwa mashaka goseri.<verse eid="PRO 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 10:26" />Limawu ntambu yalijega wazira mumenu ama lyosi ntambu yaliwawa mumasu, ndo ntambu yakawera mleri kwa yakamlagaliliti.<verse eid="PRO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 10:27" />Kumguwira Mtuwa Mlungu, kongera mashaka ga kulikala, kumbiti vinja vya wakontola haviweri mifupi.<verse eid="PRO 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 10:28" />Litumbiru lya muntu mheri lipelera kunemelera, kumbiti liloleru lya mkontola lipelera hera.<verse eid="PRO 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 10:29" />Mtuwa Mlugu ndo yakawalolera yawamfiriziya, kumbiti yawatenda makontola hakawaagamiziyi.<verse eid="PRO 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 10:30" />Wantu waheri hapeni wawusiwi nakumu muisi, kumbiti wakontola hapeni walikali muisi.<verse eid="PRO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 10:31" />Mlomu gwa muntu mheri gutakula mirandu ya luhala, kumbiti lulimi lwa muntu mkontola halulimbatulwi.<verse eid="PRO 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 10:32" />Milomu ya wantu waheri wavimana yagajimilika kutakulwa, kumbiti milomu ya wakontola wazumba makontola hera.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 11:1" />Shibaba sha upayira ndo likalalilu kwa Mtuwa Mlungu, kumbiti kutendera shipimu shiherepa ndo nemeru kwakuyi.<verse eid="PRO 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 11:2" />Mtiti gulibatana na soniziya, kumbiti kwa wantu wananaga kwana luhala.<verse eid="PRO 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 11:3" />Waminika wa waheri uwalonguziya, kumbiti wantu wadoda hawagamiziwi kwa kwaminikandiri kwawu.<verse eid="PRO 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 11:4" />Ulunda ufaandiri shintu lishaka la nkalaliru, kumbiti waminika ulopola kulawa mukuhowa.<verse eid="PRO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 11:5" />Waminika wa waheri wayitalipisiya njira yawu, kumbiti wakontola waguwa kwa ukontola wawu weni.<verse eid="PRO 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 11:6" />Waminika wa waheri uwalopola na makontola, kumbiti wakontola wabatwa kwa nfiru zawu weni.<verse eid="PRO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 11:7" />Mkontola pakahowa litumbiru lyakuyi lyankuwuka. Vyoseri vyakavitumbira muntu kwa makakala gakuyi shintundiri.<verse eid="PRO 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 11:8" />Muntu mheri kalopolwa muntabiku, kumbiti mkontola huyingira amu pa yomberi.<verse eid="PRO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 11:9" />Yakamguwirandiri Mlungu kagamiziya wamonga kwa mlomu gwakuyi, kumbiti muntu mheri kalopolwa kwa umani wakuyi.<verse eid="PRO 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 11:10" />Wantu waheri pawawera na mpatiru mji gunemelera, nawakontola pawagamira wantu watenda nsheka.<verse eid="PRO 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 11:11" />Mji pagwana mpatiru kwa tekelera za wantu waheri, kumbiti hagwagamiziwi kwa mlomu gwa wakontola.<verse eid="PRO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 11:12" />Yakambeziya gwapakwegera gwakuyi kahera mahala, muntu yakana umani kalikala jii.<verse eid="PRO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 11:13" />Yakapitapita kuwalonga wamonga kalaviya bada, kumbiti yakaminika murohu kafifa bada.<verse eid="PRO 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 11:14" />Yapahera ugambiziya isi iguwa, kumbiti pahala papawera na wagambiziya wavuwa pana ukanka.<verse eid="PRO 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 11:15" />Muntu yakamlipira uwanda gwapakwegera gwakuyi hakatabiki, kumbiti yakakalalira mirandu ya mapatanu kaponeka.<verse eid="PRO 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 11:16" />Mdala muheri hakapananwi ligoya, kumbiti mpalu yakahera lusungu hakapati ulunda.<verse eid="PRO 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 11:17" />Muntu mheri kanamota ulamweni, kumbiti muntu nkesera kalitenda ulamweni.<verse eid="PRO 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 11:18" />Mota yakayipata mkontola ndo ya mpayu, kumbiti yakatenda maheri nakaka hakapati mota ya nakaka.<verse eid="PRO 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 11:19" />Muntu yakafira kuwera mwaminika hakalikali, kumbiti yakasyagula kutenda makontola hakahowi.<verse eid="PRO 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 11:20" />Mlungu kawakalalira woseri yawatenda vintu vidoda, kumbiti kawafira yawatenda maheri.<verse eid="PRO 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 11:21" />Nakaka mkontola hapakashapili kukomangwa, kumbiti wantu waheri hawalopolwi.<verse eid="PRO 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 11:22" />Mdala kaherepa yakahera luhala, ndo handa peti ya zahabu mumpula ya mtumbi.<verse eid="PRO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 11:23" />Malolera ga wantu waheri gana malawira maheri, kumbiti matamata za wakontola zipelera mumaya.<verse eid="PRO 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 11:24" />Yakalaviya vintu vyakuyi kwa ufiru hakendeleyi kuwera mlunda nentu, kumbiti yakanamalema hakendeleyi kuwera muuhushu.<verse eid="PRO 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 11:25" />Muntu yakalaviya kwa kufira hakapananwi vintu vivuwa, yakamlandaziya yumonga mashi na yomberi hakalandiziwi.<verse eid="PRO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 11:26" />Wantu wampangira yakafifa viboga, kumbiti wamkwisa yakaishuhuza.<verse eid="PRO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 11:27" />Yakasakula kutenda maheri hakapata utanga, kumbiti yakasakula kutenda makontola hakapatwi na makontola.<verse eid="PRO 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 11:28" />Yakalitumbira lunda zakuyi hakaguwi, kumbiti muntu muheri hakaherepi handa luhambi luwisi.<verse eid="PRO 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 11:29" />Yakajega ntabiku mukaya yakuyi hapeni kapati shoseri. Mzigizigi hakaweri mmanda gwa muntu yakana luhala.<verse eid="PRO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 11:30" />Matendu ga muntu mheri gakwegeziya miyoyu ya wantu nakaka wantu wakontola hawapananwi malipu nentu.<verse eid="PRO 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 11:31" />Iwera muntu muheri kapananwa lifupu pasipanu, nakaka muntu mkontola na yakana vidoda hawatozwi.<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 12:1" />Yakafira kufundwa kafira umani, ila yakalema kuberiziwa ndo mzigizigi.<verse eid="PRO 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 12:2" />Muntu muheri kafiruwa na Mtuwa Mlungu, kumbiti yakatenda madoda kapangalirwa na Mlungu.<verse eid="PRO 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 12:3" />Muntu hapakagangamali kwa kutenda makontola, kumbiti kwahera shashiweza kumwusiya muntu muheri.<verse eid="PRO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 12:4" />Mdala muheri kamnemiziya mpalu gwakuyi, kumbiti yakamsoniziya mpalu gwakuyi ndo handa shironda mumihonju mwakuyi.<verse eid="PRO 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 12:5" />Maholu ga muntu muheri ndo kuwatendera wantu pota kubagula, magambaziya ga mkontola ndo ga upayira.<verse eid="PRO 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 12:6" />Visoweru vya wakontola nfiru yakuyi ndo kulaga yawahera vidoda, kumbiti visoweru vya muntu muheri viwalopola wantu.<verse eid="PRO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 12:7" />Wantu yawatenda ukondola wahowa pawawera wazewi, kumbiti yawawatenda maheri hawalikali mivinja itangala.<verse eid="PRO 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 12:8" />Muntu kazyumwa kulawirana na luhala lwakuyi, kumbiti muntu gwa maholu madoda kabeziwa.<verse eid="PRO 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 12:9" />Mbaka muntu gwa yakalisulusiya na kana vintu vyakuyi mweni, kuliku yakalifilira makulu na kukosa shiboga.<verse eid="PRO 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 12:10" />Muntu muheri kawashera shawafira wavigongolu wakuyi, kumbiti matendu ga lusungu lwa muntu mkontola ndo ungesera.<verse eid="PRO 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 12:11" />Mlimi yakagangamala kana shiboga shivuwa, kumbiti yakatenda mirandu yayifaa ndiri kahera mahala.<verse eid="PRO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 12:12" />Wakontola wafira shilii shawaweriti nashi wantu wadoda, kumbiti muntu mheri kagoloka ugangamala.<verse eid="PRO 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 12:13" />Muntu mkontola kagomiziwa kwa mpayu yakuyi mweni, kumbiti muntu mheri kalawa muntabiku.<verse eid="PRO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 12:14" />Muntu kanampatiru kulawirana na visoweru vyakuyi, na hakapati malawiru ga mahengu ga mawoku gakuyi.<verse eid="PRO 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 12:15" />Mzigizigi kalihola kila shakatenda kuwera ndo teratera, kumbiti yakana luhala kapikanira shakagambiruwa.<verse eid="PRO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 12:16" />Maya ga mzigizigi gamanika kalongola, kumbiti yakavimana kabeziya mayigilangu.<verse eid="PRO 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 12:17" />Yakatakula nakaka hakalaviyi upitawu wa nakaka, kumbiti kapitawu gwa mpayu katakula uzyanga.<verse eid="PRO 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 12:18" />Visoweru vya vuluvulu vitenda handa ligumba, kumbiti visoweru vyakatakula muntu yakana luhala gaponiziya.<verse eid="PRO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 12:19" />Nakaka ulikala mashaka goseri, kumbiti upayira ndo wa shaka shifupi hera.<verse eid="PRO 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 12:20" />Yawapanga makontola wamema upayira mumoyu, kumbiti yawafira ponga wapata nemeleru.<verse eid="PRO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 12:21" />Wantu waheri wapatwandiri na mlandu gudoda, kumbiti wakontola wanantabiku zivuwa.<verse eid="PRO 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 12:22" />Miromu yayitakula mpaya ndo nkalaliru kwa Mtuwa Mlungu, kumbiti wantu waminika ndo nemeleru yakuyi.<verse eid="PRO 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 12:23" />Yakana mahala wafifa umani wakuyi, kumbiti wazigizigi wabwera uzigizigi wawu.<verse eid="PRO 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 12:24" />Liwoku lya muntu mgangamala kumtenda muntu kaweri mkolamlima, kumbiti uleri hawumtendi mmanda.<verse eid="PRO 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 12:25" />Lyoga mumoyu limtenda muntu kaheri nemeru, kumbiti shisoweru shiherepa shimkalamziya.<verse eid="PRO 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 12:26" />Muntu muheri kawushapira ukontola, kumbiti matendu ga wakontola gawapotuziya weni.<verse eid="PRO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 12:27" />Mwinga mleri kapatandiri shakawinga, kumbiti yakagangamala hakaweri na mpatiru.<verse eid="PRO 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 12:28" />Munjira yayifiruwa na Mlungu kwana ukomu, kumbiti njira ya ukontola ilonguziya mukuhowa.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 13:1" />Mwana yakana luhala kapikanira malagalira ga tati gwakuyi, kumbiti yakana beziya kapikanirandiri maberiziwu.<verse eid="PRO 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 13:2" />Muntu muheri kapata maheri kulawirana na visoweru vyakuyi, kumbiti mpayira wafira ndewi.<verse eid="PRO 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 13:3" />Yakalolera mlomu gwakuyi kagatula weri makaliru gakuyi, yakatakula vuluvulu kalijegera magamiziya.<verse eid="PRO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 13:4" />Mleri kafira kumbiti hakapatandiri shoseri, kumbiti nfiru ya muntu yakagangamala kapananwa vintu vivuwa.<verse eid="PRO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 13:5" />Muntu mheri kakalalira mpayu, kumbiti mkontola katenda kwa soni na soniziya.<verse eid="PRO 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 13:6" />Matendu maheri gawalolera wantu yawalikala ntambu yakafira Mlungu, kumbiti vidoda viwagusiya wakontola.<verse eid="PRO 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 13:7" />Wamu walitumba kuwera walunda kumbiti wahera shintu na wamonga waliwona kuwera wahushu kumbiti wana lunda zivuwa ndu.<verse eid="PRO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 13:8" />Ulunda wa muntu waweza kukombola kulikala kwakuyi ila muntu mhushu kahera shintu shakumtiriziya.<verse eid="PRO 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 13:9" />Muntu muheri kamelemeta handa limbamba lyaliyaka weri, kumbiti wakontola ndo handa limbamba lyalizimika.<verse eid="PRO 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 13:10" />Mtiti gujega ndewu hera, kumbiti kwa yakajimira kugambiziwa kana luhala.<verse eid="PRO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 13:11" />Lunda ya kalongolalongola iwuki, kumbiti yakajojonira shididinididini hakongeri.<verse eid="PRO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 13:12" />Litumbiru lya kuheperahera ligutenda moyu, kumbiti liloleru lyalitendeka ndo mtera gwa ukomu.<verse eid="PRO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 13:13" />Yakagabeziya magambiziya kalijegera magamiziya, kumbiti yakagajimira lagaliru hakapananwi lifupu.<verse eid="PRO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 13:14" />Mafunda ga yawana luhala ndo mbwiru ya ukomu, imtenda muntu kushapila migomiziwu ya kuhowa.<verse eid="PRO 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 13:15" />Kwamuwa weri kujega ligoya, kumbiti njira ya wakontola ilonguziya muntabiku.<verse eid="PRO 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 13:16" />Yakana umani katenda kila shintu kwa mahala, kumbiti mzigizigi kalanguziya uzigizigi wakuyi.<verse eid="PRO 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 13:17" />Mlagilagi mdoda kawingiziya wantu muntabiku, kumbiti mlagilagi mwaminika kajega uponiziya.<verse eid="PRO 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 13:18" />Uhushu na soniziya vimpata yakasherandiri mafunda, kumbiti yakapikanira maberiziya kapananwa ligoya.<verse eid="PRO 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 13:19" />Litumbiru lyalikamika linoga mumoyu, kumbiti wazigizigi wakalalira kuleka ukontola.<verse eid="PRO 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 13:20" />Yakagenda pamuhera na wantu yawana luhala kapata luhala, kumbiti yakawera pamuhera na wazigizigi hakapati ntabiku.<verse eid="PRO 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 13:21" />Yawatenda vidoda wapatwa na ntabiku, kumbiti yawatenda maheri hawapananwi vintu viherepa.<verse eid="PRO 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 13:22" />Muntu muheri kawalekera uhala wiwuka wakuyi, kumbiti lunda za mtenda vidoda hawapananwi wantu yawatenda maheri.<verse eid="PRO 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 13:23" />Lilambu lya mhushu lilaviya viboga vivuwa, kumbiti kutenda madoda kumalira<verse eid="PRO 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 13:24" />Yakamkomangandiri mwana gwakuyi kamfirandiri, kumbiti yakamfira mwana gwakuyi kamberiziya kalongola.<verse eid="PRO 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 13:25" />Muntu muheri kana shiboga sha kumtosheya, kumbiti mkontola hakapati njala.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 14:1" />Mdala yakana luhala hakanyawi numba yakuyi, kumbiti mzigizigi hakayibomoli kwa mawoku gakuyi ulamweni.<verse eid="PRO 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 14:2" />Yakatenda matendu maheri kamguwira Mtuwa Mlungu, kumbiti mpotuziya kambeziya Mlungu.<verse eid="PRO 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 14:3" />Mzigizigi kalitenda ulamweni kwa kutakula vuluvulu, kumbiti yakana luhala hakalolerwi kwa visoweru vyakuyi.<verse eid="PRO 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 14:4" />Pota ng'ombi gwa kulima lizizi lya lupalahera, kumbiti mabenangu gavuwa galawirana na makakala ga ng'ombi gwa kulima.<verse eid="PRO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 14:5" />Kapitawu mwaminika kalongandiri mpayu, kumbiti yakaminikandiri kayowera mpayu.<verse eid="PRO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 14:6" />Yakana beziya kasakula luhala kayipatandiri, kumbiti yakana mahala kapata umani kalongola.<verse eid="PRO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 14:7" />Guwuki pahala pakawera mzigizigi, mana pakawera kwahera visoweru vya mahala.<verse eid="PRO 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 14:8" />Luhala lwa yawana mahala lulanguziya njira yakuyi, kumbiti uzigizigi wa wazigizigi uwapayira weni.<verse eid="PRO 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 14:9" />Wazigizigi wasekelera kutenda vidoda, kumbiti waminika wapata ligoya kulawa kwa Mlungu.<verse eid="PRO 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 14:10" />Moyu gugumana utama wakuyi weni, kumbiti nemeru yakuyi hapakayioni muntu yumonga.<verse eid="PRO 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 14:11" />Numba ya muntu mkontola hayibomoluwi, kumbiti kaya ya muntu mheri haligangamiziwi.<verse eid="PRO 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 14:12" />Matendu yagulishera kuwera ndo teratera, upeleru iweza kukulonguziya mkuhowa.<verse eid="PRO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 14:13" />Nemeru iweza kulififa hinginika, kumbiti mpeleru za nemeru kwiza hinginika.<verse eid="PRO 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 14:14" />Muntu mpotuziya hakabenangi mabwajubwaju ga njira zakuyi na muntu muheri hakapananwi lifupu lya matendu gakuyi.<verse eid="PRO 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 14:15" />Mzigizigi kamini kila shintu shawamgambira, kumbiti yakana luhala kalihola uti pamberi pa kutenda.<verse eid="PRO 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 14:16" />Yakana luhala ndo kalilolera weri na kushapira ukontola, kumbiti mzigizigi kalilewelerandiri pota kalilolera werindiri.<verse eid="PRO 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 14:17" />Yakana maya kalongola katenda shizigizigi na muntu yakapyera kakalalwa.<verse eid="PRO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 14:18" />Yawahera mahala wahala uzigizigi, kumbiti yawana luhala wapananwa lijenjeri lya umani.<verse eid="PRO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 14:19" />Wakontola hawasuntamali kulongolu kwa wantu waheri na wantu wadoda hawasuntamali paligomi lya wantu waheri.<verse eid="PRO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 14:20" />Wahushu wakalalilwa ata na wapakwegera wakuyi, kumbiti mlunda kana wamaganja wavuwa.<verse eid="PRO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 14:21" />Yakambeziya gwapakwegera gwakuyi katenda vidoda, ila katekelelwa uli yakanalusungu kwa wahushu.<verse eid="PRO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 14:22" />Yakapanga makontola nakaka katenda vidoda! Yawapanga kutenda maheri wafiruwa na kwaminiwa.<verse eid="PRO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 14:23" />Gangamala mukila lihengu lijega mota, kumbiti visoweru hera vijega uhushu.<verse eid="PRO 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 14:24" />Lunda ndo lifupu lya nemelela yawana luhala, kumbiti uzigizigi ujega uzigizigi ng'anji.<verse eid="PRO 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 14:25" />Kapitawu gwa nakaka kalopula ukomu, kumbiti yakatakula mpaya kagamiziya ukomu.<verse eid="PRO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 14:26" />Yakamguwira Mtuwa Mlungu kana litumbiru gangamala na wana wakuyi hawapati tugira ponera.<verse eid="PRO 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 14:27" />Kumguwira Mtuwa Mlungu ndo mbwiru ya ukomu, imtenda muntu kushapira migomiziwu ya kuhowa.<verse eid="PRO 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 14:28" />Uvuwa wa wantu ndo sekeleru ya mfalumi, kumbiti wantu pawadidini mkolamlima kagamira.<verse eid="PRO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 14:29" />Muntu yakahera maya ga kalongola kana umani uvuwa, kumbiti yakakalala kalongola kalanguziya uzigizigi wakuyi.<verse eid="PRO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 14:30" />Ponga mumoyu impanana muntu uponera, kumbiti matamata iwoluziya mihonju.<verse eid="PRO 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 14:31" />Yakamzulumu mhushu kamwigira mnyawa gwakuyi, kumbiti yakamwonera lusungu muhushu kampanana ligoya Mlungu.<verse eid="PRO 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 14:32" />Mkontola kagamiziwa kwa matendu gakuyi makontola, kumbiti muntu mheri hakapati uponera kwa maheri gakuyi.<verse eid="PRO 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 14:33" />Luhala lukala mumoyu mwa muntu yakana umani, kumbiti ata mumiyoyu ya wazigizigi lumanika.<verse eid="PRO 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="PRO 14:34" />Yawamfiriziya Mlungu watenda isi kuwera nkulu, kumbiti vidoda viwatenda wantu wawoni soni.<verse eid="PRO 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="PRO 14:35" />Mfalumi kafiliziwa na ntumintumi yakana luhala, kumbiti maya gakuyi gawapata wantu yawatenda yagafaandiri.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 15:1" />Kwankula mpolimpoli kunyamaziya maya, kumbiti shisoweru shikalipa shisongiziya maya.<verse eid="PRO 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 15:2" />Lulimi lwa yakana luhala lupalasiya umani, kumbiti milomu ya wazigizigi watakula uzigizigi.<verse eid="PRO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 15:3" />Masu ga Mtuwa Mlungu gawona kila shintu, kamlolalola muntu mheri na muntu mdoda.<verse eid="PRO 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 15:4" />Visoweru vipoli ndo shanjiru sha ukomu, kumbiti lulimi lalutakula ukontola lubena moyu.<verse eid="PRO 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 15:5" />Mzigizigi kabeziya mafunda ga tati gwakuyi, kumbiti yakajimira kuberiziwa kana mahala.<verse eid="PRO 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 15:6" />Ukaya mwa muntu mheri mwana lunda zivuwa, kumbiti mapatu ga wantu wakontola gawajegera ntabiku.<verse eid="PRO 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 15:7" />Mlomu gwa yakana luhala gujega umani, kumbiti ntambu yayiwerandiri mumiyoyu ya wazigizigi.<verse eid="PRO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 15:8" />Malaviwu ga wakontola ndo nkalaliru kwa Mtuwa Mlungu, kumbiti maluwa ga wantu waheri gamunemiziya Mlungu.<verse eid="PRO 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 15:9" />Matendu ga wakontola ndo nkalaliru kwa Mtuwa Mlungu, kumbiti Mlungu kawafira walii yawatenda mirandu mihera.<verse eid="PRO 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 15:10" />Azabu ikalipa yapalaa kwa yawaleka kutenda mirandu maheri, yoseri yakakalalira kuberiziwa hakahowi.<verse eid="PRO 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 15:11" />Handa Mtuwa Mlungu kavimana yagawera kulilirindi litali, maholu ga muntu hagawezi hashi kulififa kulongolu kwakuyi?<verse eid="PRO 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 15:12" />Yakana beziya kafirandiri kuberuwa, kasakulandiri nakamu magambiziya ga yawana mahala.<verse eid="PRO 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 15:13" />Moyu gwa nemeleru gukalamusiya sheni, kumbiti utama umega moyu.<verse eid="PRO 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 15:14" />Wana mahala wasakula umani, kumbiti wazigizigi waliliyiziya uzigizigi.<verse eid="PRO 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 15:15" />Kwa yakatabisiwa kila lishaka ndo lidoda, kumbiti kwa yakana moyu gukalamuka kasekela mashaka goseri.<verse eid="PRO 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 15:16" />Mbaka kuwera na shintu shididini pamuhera na kumguwira Mtuwa Mlungu, kuliku kuwera na lunda ivuwa pamuhera na ntabiku.<verse eid="PRO 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 15:17" />Mbaka kuliya shiboga pahala yapawera na ufiru, kuliku kuliya vinofu vinonu pahala pana ngalaliru.<verse eid="PRO 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 15:18" />Muntu gwa maya idoda kajega ndewi, kumbiti yakayewukandiri kwa maya kanyamaziya ndewu.<verse eid="PRO 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 15:19" />Njira ya mleri imema misontu, kumbiti njira ya mwaminika ndo lupalahera handa njira nkulu.<verse eid="PRO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 15:20" />Mwana yakana luhala kamnemiziya tati gwakuyi, kumbiti mzigizigi kambeziya mawu gwakuyi.<verse eid="PRO 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 15:21" />Uzigizigi ndo nemeleru kwa muntu yakahera na mahala, kumbiti yakana luhala kasyagula njira yayiwera teratera.<verse eid="PRO 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 15:22" />Mipangu isinda kuwera na mpatiru toziya ya kukosa magambiziya, kumbiti kwa wagambiziya wavuwa hakuweri na mpatiru.<verse eid="PRO 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 15:23" />Kulaviya lyankulu lya nakaka kusekeziya; shisoweru yashifaa kwa shaka shakuyi ndo shiherepa nentu!<verse eid="PRO 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 15:24" />Njira ya muntu yakana luhala kajega ukomu, hangu humtenda kashapili kwingira pasi palilirindi litali.<verse eid="PRO 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 15:25" />Mtuwa Mlungu kabomola numba za wana mtiti, kumbiti kalolera lunda za mkenja.<verse eid="PRO 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 15:26" />Maholu ga wakontola ndo nkalaliru kwa Mtuwa Mlungu, kumbiti visoweru vya wantu waheri vimnemziya.<verse eid="PRO 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 15:27" />Muntu yakana matamata kawajegera walongu wakuyi ntabiku, kumbiti yakakalalira swinda hakalikali.<verse eid="PRO 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 15:28" />Moyu gwa muntu muheri gulihola pamberi pa kwankula, kumbiti mlomu gwa mkontola gulaviya ukontola.<verse eid="PRO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 15:29" />Mtuwa Mlungu kakutali na wantu wakontola, kumbiti ka pakwegera na wantu waheri kuwapikinira maluwa.<verse eid="PRO 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 15:30" />Masu ga lusungu gasekeziya moyu, visoweru viheri vijega ponga munshimba.<verse eid="PRO 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 15:31" />Muntu yakapikanira maberiziwu yagajega ukomu, hakalikali muwamu mwa yawana luhala.<verse eid="PRO 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 15:32" />Yakalema kufundwa kalibeza mweni, kumbiti yakajimira maberiziya kapata umani.<verse eid="PRO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 15:33" />Kumguwira Mtuwa Mlungu kumfunda muntu luhala na unanaga wiza pamberi pa ligoya.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 16:1" />Muntu kapanga mipangu yakuyi, kumbiti shisoweru sha upeleru shilawa kwa Mtuwa Mlungu.<verse eid="PRO 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 16:2" />Njira ya muntu iwoneka kwakuyi kuwera teratera pamasu pakuyi, kumbiti Mtuwa Mlungu ndo yakapima nfiru ya muntu.<verse eid="PRO 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 16:3" />Gumluwi Mtuwa Mlungu shoseri shagutenda na mipangu yaku hayiweli na mpitiru.<verse eid="PRO 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 16:4" />Mtuwa Mlungu kanyawa kila shintu kwa nfiru yakuyi, ata wakontola kawanyawiti kwajili ya lishaka lya maagamiziya.<verse eid="PRO 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 16:5" />Kila yakana mtiti ndo nkalaliru nentu kwa Mtuwa Mlungu, nakaka muntu gwa ntambu ayi hapanikalekwi kukomangwa.<verse eid="PRO 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 16:6" />Kwa ujimira na waminika muntu kalekeziwa vidoda, kwa kumguwira Mtuwa Mlungu kashapira ukontola.<verse eid="PRO 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 16:7" />Mtuwa Mlungu pakafiriziwa na vitendu vya muntu, kawatenda ata wankondu wakuyi kuwera wamaganja.<verse eid="PRO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 16:8" />Mbaka lunda ndidini kupitira matendu maheri, kuliku vintu vivuwa kupitira udoda.<verse eid="PRO 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 16:9" />Muntu kaweza kutenda mipangu gwakuyi mumoyu, kumbiti Mtuwa Mlungu ndo nakaka kapanga shilii shakafira kutenda muntu ulii.<verse eid="PRO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 16:10" />Mfalumi katakula pakalonguziwa na Mlungu na pakalaviya toza kakoseya ndiri.<verse eid="PRO 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 16:11" />Mtuwa Mlungu kafira tutenderi shipimu na shibaba sha nakaka na mabuwi goseri mumihaku ndo ga mahengu gakuyi.<verse eid="PRO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 16:12" />Ndo nkalaliru nkulu wafalumi kutenda ukontola, toziya ukulu wawu ugangamiziwa kwa njira ya kutenda galii yagamfiriziya Mlungu.<verse eid="PRO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 16:13" />Mfalumi kamfira muntu yakatakula kwa uheri, kafiliziwa na muntu yakatakula unakaka.<verse eid="PRO 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 16:14" />Maya ga mfalumi gatoziya kuhowa, kumbiti muntu yakana luhala kaweza kuyinyamaziya.<verse eid="PRO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 16:15" />Sheni sha mfalumi pashing'ereng'eta kwana ukomu, uheri wakuyi ndo handa liwundi lya mvula shaka sha mvula.<verse eid="PRO 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 16:16" />Mbaka kupata luhala kuliku zahabu na kupata umani ndo syagula helepa kuliku madini ga feza.<verse eid="PRO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 16:17" />Njira nkulu ya muntu yakatenda yagajimiruwa ndo kulekana na ukontola, yakalolera njira yakuyi katulira ukomu wakuyi.<verse eid="PRO 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 16:18" />Mtiti gujega maagamiziya, kulitumba kumlonguziya muntu mukuguwa.<verse eid="PRO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 16:19" />Mbaka kuwera mnanaga na kulikala mhushu, kuliku kubagulana vintu vyavilopolitwi na yawana malingu.<verse eid="PRO 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 16:20" />Yakagafata magambaziya hakaweri na mpatiru, mbaka muntu yulii yakamtumbira Mtuwa Mlungu.<verse eid="PRO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 16:21" />Yakana luhala mumoyu kashemwa kanaumani na shisoweru sha kuherepiziya shiwakwegiziya wantu nentu.<verse eid="PRO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 16:22" />Luhala ndo mbwiru ya ukomu kwakuyi yakaweriti nayi, kumbiti uzigizigi ijega azabu kwa wazigizigi.<verse eid="PRO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 16:23" />Moyu gwa yakana luhala gumtenda kutakula kwa mahala, na visoweru vyakuyi vyongera ukwegiziya.<verse eid="PRO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 16:24" />Visoweru viherepa ndo handa lisega lyalyana lwashi, navinoga murohu na guyitenda nshimba kuwera ponera.<verse eid="PRO 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 16:25" />Kwana njira yayionekana kuwera teratera pamasu pa muntu, kumbiti upeleru wakuyi ndo njira za kuhowa.<verse eid="PRO 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 16:26" />Nfiru ya shiboga imuhimiziya muntu kutenda lihengu, mana njala yakuyi imtenda kendeleyi.<verse eid="PRO 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 16:27" />Muntu mkontola kapanga ukontola na visoweru vyakuyi ndo handa motu gukalipa.<verse eid="PRO 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 16:28" />Muntu mpotuziya kasongeziya ndewi, mpayu zakatakula ziwatulagweka wamaganja wapakwegera.<verse eid="PRO 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 16:29" />Muntu mnkesera kamzyangazyanga gwapakwegera gwakuyi na kamlonguziya munjira zidoda.<verse eid="PRO 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 16:30" />Yakakupira lisu kwa nfiru idoda kapanga makontola na yakaminula miromu yakuyi kafira kutenda madoda.<verse eid="PRO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 16:31" />Kuwera na neziwu ndo handa lijengeri lya ukulu, zipatikana kwa njira yakulikala ntambu yakafira Mtuwa Mlungu.<verse eid="PRO 16:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 16:32" />Mbaka muntu yakahera maya ga kalongola ndo kaherepa kuliku yakana makakala; yakakolamlima mweni ndo kaherepa kuliku yakagulopola mji.<verse eid="PRO 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 16:33" />Simbi zigalambulwa kwamuwa shashifira kulawira, kumbiti kila lyankulu lilawa kwakuyi Mtuwa Mlungu.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 17:1" />Mbaka kuliya libumunda liyuma pahala yapana ponga, kuliku kulikali munumba yana msambu gwa shiboga yapawera na ndewi.<verse eid="PRO 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 17:2" />Mmanda ulii yakana mahala hakamkolimlima mntemba gwa mtuwa gwakuyi yagajega soni, hakapati seemu ya uhala wa kaya ayi.<verse eid="PRO 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 17:3" />Uherepa wa madini ga zahabu ama madini ga feza zipimwa kwa motu, kumbiti Mtuwa Mlungu ndo yakapima miyoyu ya wantu.<verse eid="PRO 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 17:4" />Yakatenda makontola kapikanira visoweru vidoda, mpayira kayambira likutu lyakuyi kwa lulimi lupayira.<verse eid="PRO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 17:5" />Yakamjongera mhushu kamwigira Mnyawa gwakuyi, yakanemelera ntabiku za muyaguyi hapakaleki kukomangwa.<verse eid="PRO 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 17:6" />Wazewi walitumbira wazukulu wawu, wana walitumbira walera wawu.<verse eid="PRO 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 17:7" />Visoweru viherepa hapavilawi kumlomu kwa mzigizigi, ntambu ilaa visoweru vya upayira ufaandiri mumlomu mwa mlonguziya.<verse eid="PRO 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 17:8" />Kwa yakalaviya swinda, swinda ndo handa ndumba, kila shakatenda hashiweri na mpatiru.<verse eid="PRO 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 17:9" />Yakalekeziya vidoda kendeleza uganja, kumbiti yakaholusiya vidoda katula gweka uganja wapakwegera.<verse eid="PRO 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 17:10" />Likalipiru limu kwa yakana mahala lyana mana, kuliku makomangu mia kwa mzigizigi.<verse eid="PRO 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 17:11" />Shakafira muntu mkontola ndo kugalambuka hera, mlagilagi mngesera hakatumwi kwa yomberi.<verse eid="PRO 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 17:12" />Mbaka kuliwona na simba gwa shidala yakapokitwi wana wakuyi, kuliku kuliwona na mzigizigi muuzigizigi wakuyi.<verse eid="PRO 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 17:13" />Yakawuzilira madoda kwa maheri, madoda hapegawuki nakamu munumba yakuyi.<verse eid="PRO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 17:14" />Kwanjisha ndewi ndo handa kuvugula mashi ga litanda, guleki ndewi pamberi hayeniweri mkulu.<verse eid="PRO 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 17:15" />Kumlekiziya yakatenda shidoda na kumkomanga yakahera likosa, goseri mawili kagakalalira Mtuwa Mlungu.<verse eid="PRO 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 17:16" />Yahera mana gaa mzigizigi kuwera na mpiya mumawoku kuhemera luhala na agawu yomberi kafirandiri kupata mahala.<verse eid="PRO 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 17:17" />Ganja gwa nakaka ndo mwaminika mashaka goseri, mlongu kiwuka katangi shaka sha ntabiku?<verse eid="PRO 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 17:18" />Mahala ndiri kutula poni kwa muntu yumonga na kuwera mgolokera gwa gwapakwegera gwaku.<verse eid="PRO 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 17:19" />Yakafira ndewi kafira vidoda, yakanyawa shibambaza na kutula ligomi lihelepa kalisakulira maagamiziya.<verse eid="PRO 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 17:20" />Yakana moyu mpotuziya kaweza ndiri kuwera na mpatiru, na yakatakula mpaya hakapati ntabiku.<verse eid="PRO 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 17:21" />Yakalera mwana mzigizigi kalijegera hinginika ulamweni na tati gwa mzigizigi kahera nemeru.<verse eid="PRO 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 17:22" />Moyu mkalamka ndo mgota guherepa, kumbiti moyu gwana hinginika gondiziya nshimba.<verse eid="PRO 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 17:23" />Muntu mdoda kanka swinda kwa bada, su nakalavia toza ntambu yayifiluwa.<verse eid="PRO 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 17:24" />Muntu yakana mahala nfiru yakuyi ndo luhala, kumbiti mzigizigi kaligaziya na kila shintu pasipanu.<verse eid="PRO 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 17:25" />Mwana mzigizigi ndo hinginiku kwa tati gwakuyi, na utama kwa mawu gwakuyi yakamwiwuliti.<verse eid="PRO 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 17:26" />Iherepa ndiri kumtoza muntu yakahera shidoda na kuwasyatanga walonguziya waherepa toziya wa uheri wawu.<verse eid="PRO 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 17:27" />Muntu yakana umani katendera visoweru kwa kulilewelera na yomberi yakana umani kana moyu gwa unyamalira.<verse eid="PRO 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 17:28" />Ata mzigizigi pakanyamala kawoneka kana luhala, pakadiwa mlomu gwakuyi kawoneka kuwera kana mahala.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 18:1" />Yakasakula gakuyi hera kalitula gweka na wayaguyi, kakalala pakagambiziwa mlandu goseri mheri.<verse eid="PRO 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 18:2" />Mzigizigi kafiriziwandiri na umani, kwakuyi sha mana ndo shili shakaliho hera.<verse eid="PRO 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 18:3" />Shaka ukontola pawiza na beziya yiza viraa, pamuhera na soni yiza malongalonga.<verse eid="PRO 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 18:4" />Visoweru viweza kuwera mbwiru ya luhala ndo handa mashi matali ga bahari, handa shishemba sha mashi gatuga.<verse eid="PRO 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 18:5" />Iherepa ndiri kumpendeleya muntu mkontola, ama kusinda kumtendera muntu yakahera vidoda galii gakafiruwa kutenderwa.<verse eid="PRO 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 18:6" />Visoweru vya mzigizigi vijega ndewi, kila shakatakula shijega makomangu.<verse eid="PRO 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 18:7" />Visoweru vya mzigizigi vimwagamiziya mweni, mlomu gwakuyi ndo mgomiziwu gwa kugomera mweni.<verse eid="PRO 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 18:8" />Visoweru vya msongiziya ndo handa viboga vinoga, vyeni visuluka magenda mpaka kumtima.<verse eid="PRO 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 18:9" />Muntu mleri mlihengu lyakuyi, ndo handa mhalibisiya.<verse eid="PRO 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 18:10" />Litawu lya Mtuwa Mlungu ndo liboma liganagala, yakatenda maheri katugira kawera ponera. <verse eid="PRO 18:10" /><verse number="11" style="v" sid="PRO 18:11" />Kumbiti mlunda kalihola lunda ndo liboma lyakuyi, mweni kagatenda aga ndo shibambaza shitali shashimlolera.<verse eid="PRO 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 18:12" />Matumbiru ga mumoyu gajega maagamiziya, kumbiti unanaga ujega ligoya.<verse eid="PRO 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 18:13" />Kwankula pamberi pa kupikanira ndo uzigizigi na soni.<verse eid="PRO 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 18:14" />Moyu gwa muntu iweza kuhepelera, ulweri, kumbiti moyu pagumegeka haguhepeleri hashi?<verse eid="PRO 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 18:15" />Muntu yakana mahala kalipanana umani, likutu lya yakana mahala lisakula umani.<verse eid="PRO 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 18:16" />Lifupu limvugulira njira muntu ulii yakalaviya, liweza kumfikiziya muntu kulongolu kwa mkulu.<verse eid="PRO 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 18:17" />Yomberi yakawera gwa kwanja kujega masitaka kawoneka kuyowera nakaka, mpaka pakalilaviya muntu yumonga kumkosiya.<verse eid="PRO 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 18:18" />Simbi imalira ushingani, ijega maamuliri pakati pa wakulu yawasingana.<verse eid="PRO 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 18:19" />Mlongu yakatenderitwi shidoda ndo kakamala kukolaniziwa kuliku kukomanga mji yaguzyengetiziwi shibambaza, ndewu zikoweka handa makufuli ga liboma.<verse eid="PRO 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 18:20" />Visoweru vya luhala vya muntu viweza kumwikutuziya handa shiboga shihelepa, visoweru vihelepa vimtosheya. <verse eid="PRO 18:20" /><verse number="21" style="v" sid="PRO 18:21" />Lulimi lwana makakala ga kujega ukomu na kulaga, yawafira kulutendera weri hawalii mabwajubwaju gakuyi.<verse eid="PRO 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 18:22" />Yakapata mdala kapata shintu shiheri, na yomberi kalipanana upenderewu kulawa kwa Mtuwa.<verse eid="PRO 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 18:23" />Mhushu kaluwa kwa unanaga, ila mlunda kankula kwa ukalipa.<verse eid="PRO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 18:24" />Maganja wavuwa waweza kumgusiya muntu, kumbiti kwana maganja waminika kuliku mlongu.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 19:1" />Mbaka mhushu yakalikala kwa kutenda maheri, kuliku muntu mzigizigi mweni milomu yakuyi ipotoka.<verse eid="PRO 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 19:2" />Ifaandiri muntu kuwera pota umani, yakagenda kalongolalongola kalikwala.<verse eid="PRO 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 19:3" />Muntu pakalyagamiziya kwa uzigizigi wakuyi, moyu gwakuyi gumkalalira Mtuwa Mlungu.<verse eid="PRO 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 19:4" />Lunda zikwega maganja wavuwa wasyayi, kumbiti mhushu kalekwa ata na ganja.<verse eid="PRO 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 19:5" />Kapitawu gwa mpayu hapenikaleki kwazibiwa, yakatakula upyota hapeni kashapili azabu.<verse eid="PRO 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 19:6" />Wantu wavuwa wajera kulitula pakwegera na wakulu na kila muntu kafira kuwera ganja gwa muntu yakalaviya mafupu.<verse eid="PRO 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 19:7" />Mhushu kakalalirwa na walongu wakuyi, wamaganja wakuyi ndo nentu: Wamtira! Ata pakawazyangazyanga ntambu gaa hawamlemi.<verse eid="PRO 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 19:8" />Yakalipanana luhala kalifira mweni; yakagafata mahala hakaweri na mpatiru.<verse eid="PRO 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 19:9" />Kapitawu yakatakula kwa mpayu hapeni kakosi kwazibiwa; yakatakula mpayu hakagamiri.<verse eid="PRO 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 19:10" />Ifaandiri kwa mzigizigi kulikala makaliru gaherepa, kayi ndo idoda nentu mmanda kuwakolamlima wakulu.<verse eid="PRO 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 19:11" />Yakana mahala hapenikakalali kalongola, kulekeziya vidoda ndo zyuma kwakuyi.<verse eid="PRO 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 19:12" />Maya ga mfalumi ndo handa kuguguma kwa simba, kumbiti uheri wakuyi ndo handa mangami panani pa mihamba.<verse eid="PRO 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 19:13" />Mwana mzigizigi ndo matatizu kwa tati wakuyi na mdala mndewi ndo handa mandonda ga mvula yagaperandiri.<verse eid="PRO 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 19:14" />Numba na lunda ndo uhala wakapata muntu kwa walera wakuyi, kumbiti mdala yakana mahala kalawa kwa Mtuwa Mlungu.<verse eid="PRO 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 19:15" />Uleri ujega mpota zizotopa, muntu yakalema lihengu hakatabiki kwa njala.<verse eid="PRO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 19:16" />Yakakola malagalira kaponiziya ukomu wakuyi, yakabeziya lagaliru hakahowi.<verse eid="PRO 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 19:17" />Yakamtanga mhushu kampanana uwanda Mtuwa Mlungu, Mtuwa Mlungu hakamlipi kwa shitendu shakuyi shiheri.<verse eid="PRO 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 19:18" />Gumwazibu mwana gwaku badu kwankali na litumbiru, kumbiti nagumwazibu mpaka kumwagamiziya.<verse eid="PRO 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 19:19" />Muntu gwa maya ikalipa mpaka kazabu, pagumleka mara yimu gufiruwi kumleka kayi.<verse eid="PRO 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 19:20" />Gupikanili magambiziya na kwanka mafunda, su gupati luhala kwa mashaka gagiza.<verse eid="PRO 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 19:21" />Mumoyu gwa muntu mwana mipangu ivuwa, kumbiti shakafira Mtuwa Mlungu ndo shashifira kutendeka.<verse eid="PRO 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 19:22" />Shashifiruwa kwa muntu ndo ufiru yawupera ndiri, mbaka muntu mhushu kuliku muntu yakapaya.<verse eid="PRO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 19:23" />Kumguwira Mtuwa Mlungu kujega ukomu, hakapananwi koyera ya kutosheya, pota hapeni kapatwi na malombu goseri.<verse eid="PRO 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 19:24" />Mleri ndo handa muntu yakatula liwoku lyakuyi musahani ya shiboga, kumbiti kahera makakala ga kuyinyasula mpaka mlomu.<verse eid="PRO 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 19:25" />Gumwazibu yakana lidufiya na mngalimahala hakapati mahala, gumberiziyi yakana mahala nayomberi hakapati umani.<verse eid="PRO 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 19:26" />Yakamzulumu tati gwakuyi na kumwinga mawu gwakuyi, ndo mwana yakajega soni na kakalaziya nakamu.<verse eid="PRO 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 19:27" />Mwanagwangu, paguleka kupikanira mafunda, hagwagamiri na hagulekani na visoweru vya luhala vya gulifunditi.<verse eid="PRO 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 19:28" />Kapitawu yakafaandiri shintu kajongera mirandu yayifiriziwa na mlomu gwa mkontola guwugira ukontola.<verse eid="PRO 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 19:29" />Azabu iwera kala kwa wana lidufiya, mboku zitandwa kala kulwapula migongu ya wazigizigi.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 20:1" />Divayi ijega lidufiya na ujimbi ujega ndewu, yoseri yakakwegwa nayi kahera luhala.<verse eid="PRO 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 20:2" />Maya ga mfalumi gakalipa handa kuguguma kwa simba na yakamkalaziya kulikala kwakuyi.<verse eid="PRO 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 20:3" />Ndo mlandu gwa ligoya kushapira ndewu, kumbiti wazigizigi ndo yawalilewa.<verse eid="PRO 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 20:4" />Mleri kalimandiri shaka shashifaa, kumbiti shaka sha kubenanga kasakula kapatandiri shoseri.<verse eid="PRO 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 20:5" />Maholu ga muntu galififa handa litiwa lya mashi, kumbiti muntu yakana mahala kavimana kugadidibula amu.<verse eid="PRO 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 20:6" />Wantu wavuwa walitumbira kuwera waheri, kumbiti mwaminika gaa hakampati?<verse eid="PRO 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 20:7" />Muntu mheri pakalikala kwa matendu maheri, wana wakuyi hawatekelerwi pa yomberi.<verse eid="PRO 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 20:8" />Shaka mfalumi pakalivaga kulaviya toza, kalolalola ukontola woseri kwa masu gakuyi.<verse eid="PRO 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 20:9" />Gaa yakajera kulonga, nigutenda guwelepi moyu gwangu, neni nherepa na nahera vidoda vyangu?<verse eid="PRO 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 20:10" />Shibaba sha upaya na vipimu vya upaya vyoseri ndo nkalalilu kwa Mtuwa Mlungu.<verse eid="PRO 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 20:11" />Ata mwana kamanikana kwa mirandu yakuyi, handa matendu gakuyi ndo maheri na gaminika.<verse eid="PRO 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 20:12" />Makutu lyalipikanira na Masu lyaliwona, vyoseri viwili kavitenda Mtuwa Mlungu.<verse eid="PRO 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 20:13" />Nagufira kugonja nagwiza kuwera mhushu, guweri masu na gwenga haguweli na shiboga shivuwa.<verse eid="PRO 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 20:14" />Yakahemera kalonga shifaandiri, shifaandiri, kumbiti pakawuka kalizyuma kapungulirwa beyi.<verse eid="PRO 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 20:15" />Kwana zahabu na uvuwa wa mabuwi ga beyi nkulu; kumbiti shana mana nkulu ndo visoweru vya mahala.<verse eid="PRO 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 20:16" />Muntu pakatakula hakamlipili uwanda mhenga gutoli nguwu yakuyi gumtendi kalipi toziya ya wahenga.<verse eid="PRO 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 20:17" />Shiboga shashipatikanika kwa upaya ndo shinoga, kumbiti shakapanu shiwera handa mhanga kumlomu.<verse eid="PRO 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 20:18" />Mipangu miherepa itendeka kwa kuligambiziya; pagufira kwanja nkondu mpaka kulihola huti.<verse eid="PRO 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 20:19" />Visoweru vya kumyowelera muntu kwa vidoda kumtenda muntu kujimiluwindiri, hangu gumshapili muntu yanaka shilomulomu.<verse eid="PRO 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 20:20" />Yakampangira tati gwakuyi ama mawu gwakuyi, gulangala gwa ukomu wakuyi hagutendwitiya handa koroboyi muluwindu dunu.<verse eid="PRO 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 20:21" />Uhala yayipatikana kwa kalongola pakwanja, hapeni itekelerwi pawupeleru.<verse eid="PRO 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 20:22" />Nagutakula, hambuziliri udoda wantendiritwi. Gumtumbiri Mtuwa Mlungu na yomberi hakakutangi.<verse eid="PRO 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 20:23" />Shibaba sha upayira ndo nkalalilu kwa Mtuwa Mlungu, na vipimiru vyavijimilwandiri ndo shinti shidoda.<verse eid="PRO 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 20:24" />Maleka ga muntu galonguziwa na Mtuwa Mlungu, kawezahashi muntu kuvimana njira ya kugenda?<verse eid="PRO 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 20:25" />Nagutula takulu ya kumlavalila Mlungu shintu pota kulihola, shakapanu kanji kulihola kwa shilii shakatakula.<verse eid="PRO 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 20:26" />Mfalumi yakana luhala kawatenda wakontola wamaniki, kawakoma pota lusungu.<verse eid="PRO 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 20:27" />Uheri wa muntu ndo gulangala gwa Mlungu, kalolalola goseri yagawera mngati nakamu.<verse eid="PRO 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 20:28" />Ufiru na waminika vimtenda mfalumi kuwela poneka, ukolamlima wakuyi ugangamaziwa ntambu yakafira Mlungu.<verse eid="PRO 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 20:29" />Shawalitumbira wantemba ndo makakala gawu, uherepa wa wazewi ndo neziwu zawu.<verse eid="PRO 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 20:30" />Makomangu na makweshula vilaviya ukontola, viboku vigulula mngati nakamu.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 21:1" />Moyu gwa mfalumi gwa mumawoku ga Mtuwa Mlungu na kamlonguziya poseri pakafira.<verse eid="PRO 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 21:2" />Matendu yoseri ya muntu gawoneka teratera pakuyi, kumbiti Mtuwa Mlungu kayipima miyoyu.<verse eid="PRO 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 21:3" />Kutenda mirandu miheri na ntambu yayifiruwa na Mlungu, kumfiriziya Mtuwa Mlungu kuliku kumlavalira malaviwu.<verse eid="PRO 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 21:4" />Masu ga yakana mtiti na moyu gwa kulitumba kulangaziya pota kufifa vidoda vya wakontola.<verse eid="PRO 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 21:5" />Mipangu ya muntu yakana gangamala ijega lunda kwa uvuwa, kumbiti kila yakawera na kalongola kajega uhushu.<verse eid="PRO 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 21:6" />Lunda yayipatikana kwa mpayu, ndo livuki lyalipita na mgomiziwu gwa kuhowa.<verse eid="PRO 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 21:7" />Ungesera wa wakontola hawuwatendi wagamiri, toziya walema kutenda yagafiruwa.<verse eid="PRO 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 21:8" />Njira ya muntu yakatenda vidoda imindikamindika, kumbiti njira ya wantu yatenda maheri italipasiwa.<verse eid="PRO 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 21:9" />Mbaka kulikala pambeku pampidi pa litala, kuliku kulikala numba yimu na mdala mndewi.<verse eid="PRO 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 21:10" />Shakafira kutenda muntu mdoda ndo ukontola, kahera lusungu ata kwa gwapakwera gwakuyi.<verse eid="PRO 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 21:11" />Pagumkoma yakana lidufiya, mpukapuka kapata luhala, pagumfunda yakana luhala, gumpanana umani.<verse eid="PRO 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 21:12" />Mlungu mweni ndo mheri, kavimana yagatendeka munumba ya wakontola, nayomberi hakawagusiyi wadoda muudoda wawu.<verse eid="PRO 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 21:13" />Yakalema kupikanira kulira kwa mhushu, yomberi viraa hapenikapikanirwi pakaluwa utanga.<verse eid="PRO 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 21:14" />Maya ganyamaziwa kwa lifupu lyalilaviwa kwa bada, swinda yayififwa munguwu inyamaziya maya gakalipa.<verse eid="PRO 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 21:15" />Payitendeka mirandu yayifiruwa wantu waheri wanemelera, kumbiti ijega lyoga kwa wantu wakontola.<verse eid="PRO 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 21:16" />Muntu yakayerayera munjira ya umani, hakaliwoni ka mushipinga sha wantu yawahowiti.<verse eid="PRO 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 21:17" />Muntu yakatendera mpiya zakuyi kuhemera vintu vya kunemiziya hakaweri mhushu: yakalihola kuliya na kulanda hapeni kaweri na vintu vivuwa.<verse eid="PRO 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 21:18" />Mkontola hakapati likomangu pa muntu mheri, yakaminikandiri hakaweri hazalira kwa wantu yawatenda mirandu yayifiruwa.<verse eid="PRO 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 21:19" />Mbaka kulikala kushiwala, kuliku kulikala na mdala yakanandewi na yakana maya.<verse eid="PRO 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 21:20" />Mnumba mwa yakana luhala mwana viboga vivuwa viherepa na lipaki, kumbiti mzigizigi kananga lunda vuluvulu.<verse eid="PRO 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 21:21" />Muntu yagatenda maheri na ufiru, hakalikali mashaka mavuwa na mpatiru na kupananwa ligoya.<verse eid="PRO 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 21:22" />Yakana luhala kaweza kulopola mji gwa wana makakala, nakushigusiya shibambaza shawashitumbira.<verse eid="PRO 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 21:23" />Yakalolera mlomu gwakuyi na lulimi lwakuyi, kawera kutali na ntabiku.<verse eid="PRO 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 21:24" />Yakana malingu na mtiti litawu lyakuyi ndo “Mabeziya,” Mirandu yakuyi imema mtiti nentu.<verse eid="PRO 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 21:25" />Mleri kahowa kwa kutendandiri matamata zakuyi, toziya mawoku gakuyi galema kutenda lihengu.<verse eid="PRO 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 21:26" />Mkontola mashaka goseri kafira kapati shintu, kumbiti muntu muheri kawapanana wantu kwa ufiru.<verse eid="PRO 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 21:27" />Tambiku ya mkontola ndo shintu sha shimkalaziya Mtuwa Mlungu: kakalazika nentu payilaviwa kwa nfiru idoda.<verse eid="PRO 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 21:28" />Kapitawu yakanampayu hakagamili, kumbiti muntu yakapikinira yagafaa hakalikali mashaka goseri.<verse eid="PRO 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 21:29" />Muntu mkontola kaliranguziya kuwera mgangamala, kumbiti muntu muheri kalihola weri gakutenda.<verse eid="PRO 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 21:30" />Kwahera luhala, umana, pota shintu shoseri shakapanga muntu. Kwahera shintu shoseri shilii Mtuwa Mlungu kasinda kushitenda.<verse eid="PRO 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 21:31" />Farasi katandwa toziya ya nkondu, kumbiti ukanka ulawa kwa Mtuwa Mlungu.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 22:1" />Mbaka kuwera na litawu liherepa kuliku lunda zivuwa, uheri ndo uherepa kuliko madini ga feza ama zahabu.<verse eid="PRO 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 22:2" />Walunda na wahushu walifana mu shintu shimu: Woseri awa Mtuwa Mlungu ndo mnyawa gwawu.<verse eid="PRO 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 22:3" />Muntu yakalolaweri kawona atali na kulififa, kumbiti wapukapuka wendeleya kulongolu na kulitenda.<verse eid="PRO 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 22:4" />Pagunanaga na kumguwira Mtuwa Mlungu, hagupati lifupu na lunda na ligoya na ukomu.<verse eid="PRO 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 22:5" />Njira ya wakontola imema misontu na migomiziwu, kumbiti yulii yakalolera makaliru gakuyi hakalikali kutali na migomiziwu ayi.<verse eid="PRO 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 22:6" />Gumfundi mwana njira ya kulikala na yomberi hapenikalyaluwi njira ayi mpaka kuuzewi wakuyi.<verse eid="PRO 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 22:7" />Mlunda kamkolamlima mhushu, yakatola uwanda ndo mmanda gwa yakalaviya uwanda.<verse eid="PRO 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 22:8" />Yakayala ukontola hakabeni ntabiku, uwezu wakuyi wa kutenda madoda hawuwagamiziwi.<verse eid="PRO 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 22:9" />Muntu yakalaviya shintu kwa nemeleru hakatekelerwi, mana shiboga shakuyi hakambaguliri mhushu.<verse eid="PRO 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 22:10" />Gumuwingi yakana beziya na mabishanu hagawuki, kulilewa na mahigirangu haviperi.<verse eid="PRO 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 22:11" />Yakafira kuwera na moyu guherepa na visoweru vya manemu, hakaweri ganja gwa mfalumi.<verse eid="PRO 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 22:12" />Mtuwa Mlungu kalolera umani, kumbiti kavivuluga visoweru vya wakontola.<verse eid="PRO 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 22:13" />Mleri katakula kwana simba kunja, kayi katakula handaguwi kunjira.<verse eid="PRO 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 22:14" />Mlomu gwa mdala mhumba ndo lirindi litali, yakakalalirwa na Mtuwa Mlungu hakapatukili amu.<verse eid="PRO 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 22:15" />Upukapuka utawa mumoyu mwa mwana, kumbiti luhonga lwa kuberiziya haluwusilirwi kutali.<verse eid="PRO 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 22:16" />Yakamzurumu mhushu su kaweri na ulunda, yakawapanana walunda mafupu woseri hawaweli wahushu.<verse eid="PRO 22:16" /></para>
  <para style="s">Matakulu selasini ga yawana luhala</para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 22:17" />Guyambili likutu gupikanili matakulu ga yawana luhala, guloziyi moyu gwaku kwa mafunda gangu,<verse eid="PRO 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 22:18" />toziya hagunemeleri handa pagugatula mumoyu mwaku, napagugakanta kila shaka.<verse eid="PRO 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 22:19" />Ata na gwenga nikufunda aga leru, su litumbiru lyaku liweri kwa Mtuwa Mlungu.<verse eid="PRO 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 22:20" />Nikulembiritindiri matakula selasini? Matakulu ga magambiziya na maberiziya na umani,<verse eid="PRO 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 22:21" />Su gakufundindiri yagawera nakaka na yagaminika, su muntu pakakukosiya guwezi kumwankula weri?<verse eid="PRO 22:21" /></para>
  <para style="s">Litakulu lya Kwanja</para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 22:22" />Nagumzurumu mhushu toziya ndo mhushu, pota nagumwima mhushu shilii shakafiruwa kupata kumahakama,<verse eid="PRO 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 22:23" />toziya Mtuwa Mlungu hakawakomangili, hakawapoki wali yawafira kuwapoka lunda zawu.<verse eid="PRO 22:23" /></para>
  <para style="s">Litakulu lya pili</para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 22:24" />Nagutenda uganja na muntu yakana maya, pota nagulikola na yakana nkalaliru,<verse eid="PRO 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 22:25" />Nagwiza kulifunda shakatenda yomberi, nakuliyingiziya nakamu mmugomiziwu.<verse eid="PRO 22:25" /></para>
  <para style="s">Litakulu lya tatu</para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 22:26" />Naguwera yumu gwawu pakati pawalii yawatakula hawalipili wamonga uwanda, ama guweri muntu gwakugolokera wantu mawanda,<verse eid="PRO 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 22:27" />Payiwera gwahera shoseri ya kulipa, ata shitanda shagugonjera hashitolwi.<verse eid="PRO 22:27" /></para>
  <para style="s">Litakulu lya msheshi</para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 22:28" />Naguwusiya shimaniziwu sha mbaka ya makashu yeni itulitwi na wazewi waku.<verse eid="PRO 22:28" /></para>
  <para style="s">Litakulu lya mhanu</para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 22:29" />Hashi, kwana muntu yakatenda lihengu lyakuyi kwa ugangamala? Ayu hakawatenderi wafalumi na hakatendi lihengu kwa wantu wamana.<verse eid="PRO 22:29" /></para>
  <para style="s">Litakulu lya sita</para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 23:1" />Pagulikala kuliya pamuhera na mkolamlima, nagulyaluwa ata padidini kuwera gwapamuhera na gaa. <verse eid="PRO 23:1" /><verse number="2" style="v" sid="PRO 23:2" />Guleweleri nentu matamata gaku, payiwera gwenga gufira nentu kuliya. <verse eid="PRO 23:2" /><verse number="3" style="v" sid="PRO 23:3" />Nagwana matamata na viboga vyakuyi vinoga, mana viweza kukuzyanga.<verse eid="PRO 23:3" /></para>
  <para style="s">Litakulu lya saba.</para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 23:4" />Naguligaziya su kupata ulunda, guweri na luhala kulilewelera. <verse eid="PRO 23:4" /><verse number="5" style="v" sid="PRO 23:5" />Vumu ulunda uwuka, guwera handa gupata mbapatiru vumu, nakuguluka kumpindi nakwagamira handa nkachanga.<verse eid="PRO 23:5" /></para>
  <para style="s">Litakulu lya nani.</para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 23:6" />Naguliya shiboga sha muntu yakana malema, pota nagwanamatamata kuliya viboga vyakuyi vinoga. <verse eid="PRO 23:6" /><verse number="7" style="v" sid="PRO 23:7" />Mana mumoyu mwakuyi kawalanga shaguliya, hakakugambiri guliyi na Kulanda. Kumbiti mumoyu mwakuyi kapamuherandiri na gwenga. <verse eid="PRO 23:7" /><verse number="8" style="v" sid="PRO 23:8" />Haguhiluli vyaguliyiti, kulonga mayagashii kwaku koseri hakuweri hera.<verse eid="PRO 23:8" /></para>
  <para style="s">Litakulu lya tisa.</para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 23:9" />Nagutakula visoweru vyaku kulongolu kwa mzigizigi, toziya hakabeziyi visoweru vyaku vya luhala.<verse eid="PRO 23:9" /></para>
  <para style="s">Litakulu lya lilongu</para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 23:10" />Naguwusiya shimaniziwu sha mbaka ya makashu, pota nagwingilira malambu ga washiwa,<verse eid="PRO 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 23:11" />toziya Mtuwa Mlungu, mlopola na yakana makakala, yomberi hakavikomaniri virii vyawafiruwa kupata kulongolu kwaku.<verse eid="PRO 23:11" /></para>
  <para style="s">Litakulu lya kumi na moja.</para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 23:12" />Gutenderi moyu gwaku kupikanira mafunda, gutuliweri makutu gaku kupikanira visoweru vya umani.<verse eid="PRO 23:12" /></para>
  <para style="s">Litakulu lya kumi na mbili</para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 23:13" />Naguleka kumfunda mwana, mana pagumkoma kwa shiboku hapakahowi. <verse eid="PRO 23:13" /><verse number="14" style="v" sid="PRO 23:14" />Pagumsyatanga shiboku, hagulopoli ukomu wakuyi kulawa mkuhowa.<verse eid="PRO 23:14" /></para>
  <para style="s">Litakulu lya kumi na tatu.</para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 23:15" />Mwanagwangu, moyu gwako paguwera gwana mahala, moyu gwangu haguweli gwana nemeru: <verse eid="PRO 23:15" /><verse number="16" style="v" sid="PRO 23:16" />Moyu gwangu hagutendishereku, shaka mlomu gwaku pagutakula visoweru viherepa.<verse eid="PRO 23:16" /></para>
  <para style="s">Litakulu lya kumi na msheshi.</para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 23:17" />Moyu gwaku naguwawonera weya yawana vidoda, ila gwendeleyi kumguwira Mtuwa Mlungu mashaka goseri. <verse eid="PRO 23:17" /><verse number="18" style="v" sid="PRO 23:18" />Nakaka kwana litumbiru lya shakapanu toziya yagwenga na shilii shaguhepelera hepenishiweri hera.<verse eid="PRO 23:18" /></para>
  <para style="s">Litakulu lya kumi na mhanu.</para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 23:19" />Gupikanili mwanagwangu, guweri na luhala na kayi guliholi nentu ntambu yagulikala. <verse eid="PRO 23:19" /><verse number="20" style="v" sid="PRO 23:20" />Naguwera yumu gwa walowera, pota walwaliya yawafira vinofu, <verse eid="PRO 23:20" /><verse number="21" style="v" sid="PRO 23:21" />mana walowera na walwaliya upeleru haweli wahushu, na uleri utenda muntu kavali malapulapu.<verse eid="PRO 23:21" /></para>
  <para style="s">Litakulu lya kumi na sita.</para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 23:22" />Gumpikaniri tati gwaku yakakuleriti, nagumbeziya mawu gwaku pakawera mzewi.<verse eid="PRO 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 23:23" />Guhemeli unakaka pota naguushuwuza, guhemeli luhala na mafunda na mahala.<verse eid="PRO 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 23:24" />Tati gwa mwana yakatenda maheri kana nemeru nkulu, yakamwiwula mwana yakana luhala hakamnemeleri. <verse eid="PRO 23:24" /><verse number="25" style="v" sid="PRO 23:25" />Guwaleki tati gwaku na mawu gwaku wanemeleri, mawu yakamwiwuliti na kanemeleri.<verse eid="PRO 23:25" /></para>
  <para style="s">Litakulu lya kumi na saba.</para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 23:26" />Mwanagwangu gumpikaniri weri, gunfati neni ntambu yantenda, <verse eid="PRO 23:26" /><verse number="27" style="v" sid="PRO 23:27" />toziya mhumba ndo handa lirindi litali lya kuyambira wantu, mdala mhenga ndo handa linegu libabani. <verse eid="PRO 23:27" /><verse number="28" style="v" sid="PRO 23:28" />Yomberi kanyatira handa mpoka, kawatenda wapalu wavuwa waminikindiri.<verse eid="PRO 23:28" /></para>
  <para style="s">Litakulu lya kumi na nani.</para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 23:29" />Ndo gaa yakatenda umatu? Na gaa yakana hinginika? Na gaa yakana ndewi? Na gaa yakalalamika? Na gaa yakatenduwa pota toziya? Na gaa yakana masu masheri? <verse eid="PRO 23:29" /><verse number="30" style="v" sid="PRO 23:30" />Ndo walii yawawukandiri pawahanganyia viloweru, walii yawagenda kusakula viloweru vya vihanganikitwi. <verse eid="PRO 23:30" /><verse number="31" style="v" sid="PRO 23:31" />Naguyifira divayi toziya ya usheri wakuyi, ata handa imetameta mugilasi na kuselela mpolimpoli paguyilanda. <verse eid="PRO 23:31" /><verse number="32" style="v" sid="PRO 23:32" />Upeleru itama handa njoka, isoma handa njoka yakana usungu. <verse eid="PRO 23:32" /><verse number="33" style="v" sid="PRO 23:33" />Masu gaku hagawoni vimulimuli, namahala gaku hagaliholi makontola. <verse eid="PRO 23:33" /><verse number="34" style="v" sid="PRO 23:34" />Haguweli handa muntu yakagonja pakati pa bahari, handa muntu yakagonja pampindi pa mpanda ya meli. <verse eid="PRO 23:34" /><verse number="35" style="v" sid="PRO 23:35" />Hagutakuli, wasyatangiti, kumbiti ntenduwandiri, wankomangiti, kumbiti nivimanandiri. Hanimuki ndii? Guleki nsakuli shilandu shimonga.<verse eid="PRO 23:35" /></para>
  <para style="s">Litakulu lya kumi na tisa</para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 24:1" />Naguwawonera weya wantu wakontola, pota nagufira kuwera pamuhera nawa, <verse eid="PRO 24:1" /><verse number="2" style="v" sid="PRO 24:2" />toziya maholu gawu goseri ndo muunkesera, kwahera shisoweru shoseri shiheri shashilawa mmilomu mwawu.<verse eid="PRO 24:2" /></para>
  <para style="s">Litakulu lya ishilini.</para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 24:3" />Numba inyawiwa kwa luhala na kuganagamaziwa kwa umani.<verse eid="PRO 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 24:4" />Kwa mahala vyumba vyakuyi vimemiziwa vintu vifiriziya na vya beyi nkulu.<verse eid="PRO 24:4" /></para>
  <para style="s">Litakulu lya ishilini na moja.</para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 24:5" />Mgangamala yakana luhala kana likakala nentu, muntu yakana umani kana likakala nentu: <verse eid="PRO 24:5" /><verse number="6" style="v" sid="PRO 24:6" />Toziya kwa mlonguziwu guherepa guweza kulikomanga nkondu na yapawera na wagambiziya wavuwa kwana ukanka.<verse eid="PRO 24:6" /></para>
  <para style="s">Litakulu lya ishilini na mbili.</para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 24:7" />Kwa mzigizigi luhala ndo lukamala kulumana, pakuliwona pa magambaziya hapenigumamuli mlomu.<verse eid="PRO 24:7" /></para>
  <para style="s">Litakulu lya ishilini na tatu.</para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 24:8" />Yakaliholera kutenda makontola mashaka goseri, hakashemwi muntu gwa ndewi. <verse eid="PRO 24:8" /><verse number="9" style="v" sid="PRO 24:9" />Mpangu gwakaliholera mzigizigi ndo vidoda, wantu wamlema yakana beziya.<verse eid="PRO 24:9" /></para>
  <para style="s">Litakulu lya ishilini na msheshi.</para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 24:10" />Pagutwezuka shaka sha ntabiku, gulimani gwenga makakala gaku ndo madidika.<verse eid="PRO 24:10" /></para>
  <para style="s">Litakulu lya ishilini na mhanu.</para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 24:11" />Gumlopoli muntu yakatolwa kulaguwa hera, naguleka kumlopola yakagenda kulikitulwa. <verse eid="PRO 24:11" /><verse number="12" style="v" sid="PRO 24:12" />Nagutakula, tuvimanandiri mana Mlungu yakapima miyoyu ya wantu kawona, yomberi hakakulipi kulinganira na matendu yaku<verse eid="PRO 24:12" /></para>
  <para style="s">Litakulu lya ishilini na sita.</para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 24:13" />Mwanagwangu, gulii lwashi mana ndo iherepa, lisega lyana lwashi ndo linoga mumlomu. <verse eid="PRO 24:13" /><verse number="14" style="v" sid="PRO 24:14" />Hangu ndo ntambu yalunoga luhala mumoyu gwaku, pagulupata haguweli na maloleru maheri, pota litumbiru lyaku hapeniliweri lyahera.<verse eid="PRO 24:14" /></para>
  <para style="s">Litakulu lya ishilini na saba.</para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 24:15" />Nagugwadira handa mkontola mumakawu ga muntu mheri, pota nayikomanga numba yakuyi; <verse eid="PRO 24:15" /><verse number="16" style="v" sid="PRO 24:16" />tembera muntu mheri kaguwa mara zitangala, mara zoseri kagoloka kayi, kumbiti muntu mkontola kagamiziwa na mirandu idoda.<verse eid="PRO 24:16" /></para>
  <para style="s">Litakulu lya sihilini na nani.</para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 24:17" />Nagunemelera kuguwa kwa mnkondu gwaku, Nagusekelera mumoyu mwaku kulikwala kwakuyi, <verse eid="PRO 24:17" /><verse number="18" style="v" sid="PRO 24:18" />mana Mtuwa Mlungu nakiza kuliwona ali nakakalaziwa, nakuwusiyi kutali maya gakuyi na yomberi.<verse eid="PRO 24:18" /></para>
  <para style="s">Litakulu lya ishilini na tisa.</para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 24:19" />Nagukalala toziya ya watenda madoda, pota naguwawonera weya wantu wakontola, <verse eid="PRO 24:19" /><verse number="20" style="v" sid="PRO 24:20" />mana mkontola hapakaweri na maheri, shakapanu ukomu wakuyi hawudosolwi dosu.<verse eid="PRO 24:20" /></para>
  <para style="s">Litakulu lya selasini.</para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 24:21" />Mwanagwangu, gumguwiri Mtuwa Mlungu na kumtendera ligoya mfalumi, pota nagulikolanawa na walii yawagalambukagalambuka, <verse eid="PRO 24:21" /><verse number="22" style="v" sid="PRO 24:22" />mana wantu handa awa walaguwa vumu. Gaa yakaweza kuvimana madoda galaviwa na Mtuwa Mlungu ama mfalumi?<verse eid="PRO 24:22" /></para>
  <para style="s">Matakulu gamonga ga wana luhala</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Aga viraa ndo matakula ga wana luhala: Kupendeleya muntu mukutozwa iherepandiri. <verse eid="PRO 24:23" /><verse number="24" style="v" sid="PRO 24:24" />Yakamlekeziya muntu yakana shidoda, kapangirwa na wantu na kukalalirwa na wantu wa maisi gamonga. <verse eid="PRO 24:24" /><verse number="25" style="v" sid="PRO 24:25" />Kumbiti yawawazibu wakontola hawapati nemeleru, na tekelera weri haziwiziri.<verse eid="PRO 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 24:26" />Lyankulu lya nakaka, ndo handa lilangaziwu lya uganja.<verse eid="PRO 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 24:27" />Gumaliri mahengu gaku ga kunja, gutandi kila shintu kulirambu, shakapanu gunyawi numba yaku.<verse eid="PRO 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 24:28" />Nagumpitaulira gwapakwegera gwaku, pota nagutakula mpayu kwa yomberi. <verse eid="PRO 24:28" /><verse number="29" style="v" sid="PRO 24:29" />Nagutakula, hanimtendi ntambu yakantenditi! Hanimwuziliri muntu ulii kwa shilii shakantendiriti!<verse eid="PRO 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 24:30" />Mpitiriti pakwegera na lirambu lya mleri, lirambu lya mzabibu lya muntu mzigizigi, <verse eid="PRO 24:30" /><verse number="31" style="v" sid="PRO 24:31" />nilikangasha kuwona limera misontu, magugu gagibikira pahala pakuyi poseri, na shibambaza shakuyi sha mabuwi shibomoka. <verse eid="PRO 24:31" /><verse number="32" style="v" sid="PRO 24:32" />Pamoniti aga, nilihola, upeleru wakuyi lifunda shintu. <verse eid="PRO 24:32" /><verse number="33" style="v" sid="PRO 24:33" />Gugonja shididini, gusiziri shididini kukusa mawoku gaku hera goyeri, <verse eid="PRO 24:33" /><verse number="34" style="v" sid="PRO 24:34" />uhushu hawukukankali handa mpoka, nakupunguluwa handa muntu yakana vintu vya kulikomangira.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s">Mesali zimonga za Selemani</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Azi ndo mesali zimonga za mfalumi Selemani yazilembitwi kayi na walemba wa Hezekia, mfalumi gwa Yuda.<verse eid="PRO 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 25:2" />Ukwisa wa Mlungu kufifa mirandu, kumbiti mfalumi kakwiswa kwa galii gakatakula.<verse eid="PRO 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 25:3" />Ntambu yayiwera mpindi ya kutali nentu na pasipanu, kumbiti miyoyu ya wafalumi ilolwalolwandiri.<verse eid="PRO 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 25:4" />Guwusiyi uhakata mumadini ga feza na mponda vintu hakakunyawiri shintu shiherepa; <verse eid="PRO 25:4" /><verse number="5" style="v" sid="PRO 25:5" />Guwawusiyi wakontola kulongolu kwa mfalumi na ukolamlima wakuyi hawugangamali mushilii shashifiruwa kushitenda.<verse eid="PRO 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 25:6" />Nagulijegelera kwa mfalumi, pota nagulitenda mlonguziya; <verse eid="PRO 25:6" /><verse number="7" style="v" sid="PRO 25:7" />mbaka mfalumi mweni kakugambiri gwizi gulikali kulongolu, kuliku kusoniziwa kulongolu kwa mkulu.<verse eid="PRO 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 25:8" />Nagulopukera kugajega kumahakama, shakapanu hagutendi hashi, kapitawu yumonga pakatakula visoweru vimonga vya kukusoniziya?<verse eid="PRO 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 25:9" />Tutendi lipatanu na myagu mundewi yenu gweka yenu, na kila yumu gwenu nakalaviya bada ya myaguyi, <verse eid="PRO 25:9" /><verse number="10" style="v" sid="PRO 25:10" />wantu nawiza kuvimana kuwera kwana bada na soni yaku hapeniiwuki.<verse eid="PRO 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 25:11" />Shisoweru shashitakulwa shaka shashifaa, ndo handa uherepa wa zahabu pampindi pa madini ga feza.<verse eid="PRO 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 25:12" />Libeliziwu lya yakana luhala kwa muntu yakapikanira, ndo iherepa kuliku peti ya zahabu ama shintu shashiwanya kwa madini maherepa ga zahabu.<verse eid="PRO 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 25:13" />Mlagilagi mwaminika kamsekeziya ulii yakamtumiti, gambira mashi gazizimira shaka sha mabenagu,.<verse eid="PRO 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 25:14" />Handa mawundi na lyega pota mvula, ndo teratera na muntu yakalitumba kulaviya mafupu nakalaviyandiri.<verse eid="PRO 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 25:15" />Kwanjira ya uhepelera mkolamlima kaweza kugambiziwa, lulimi lunama lumega mihonju.<verse eid="PRO 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 25:16" />Pagupata lwashi guliyi seemu ya kutosheya, nagwiza kutosiwa na kuhilula. <verse eid="PRO 25:16" /><verse number="17" style="v" sid="PRO 25:17" />Nagumtyangira gwapakwegera gwaku mara zivuwa, nagwiza kumtosiya na yomberi kakukalaliri.<verse eid="PRO 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 25:18" />Muntu yakalaviya ukapitawu wa upaya kwa muyaguyi, ndo atali handa shindonga na ligumba na msali gukalipa.<verse eid="PRO 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 25:19" />Kumtumbira muntu yakaminikandiri shaka sha ntabiku, ndo handa linu liwola ama ligulu yaliteguka.<verse eid="PRO 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 25:20" />Kumwimbira muntu yakana hinginika, ndo handa kuvula nguwu shaka sha mpepu ama kulekera munu mushironda.<verse eid="PRO 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 25:21" />Mnkondu gwaku pakawera na njala gumupanani shiboga, pakimiluwa, gumupanani mashi ga kulanda, <verse eid="PRO 25:21" /><verse number="22" style="v" sid="PRO 25:22" />hangu hagumtendi kapati soni nentu, handa makala ga motu mumtuyi gwakuyi, na Mtuwa Mlungu hakakupanani lifupu.<verse eid="PRO 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 25:23" />Lyega lyalilawa kushana lijega mvula, ntambuiraa kumtakula muntu kwa udoda gujega nkalaliru.<verse eid="PRO 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 25:24" />Mbaka kulikala pambwega pampindi pa litala lya shitwiku, kuliku kulikala ukaya pamuhera na mdala yakana ndewu.<verse eid="PRO 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 25:25" />Handa mashi gazizimira kwa muntu yakimluwa, ndo visoweru viheri kulawa kutali.<verse eid="PRO 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 25:26" />Muntu yakana luhala pakajimira kufata mirandu ya mkontola, ndo mbwiru yayidodisiwa ama linogu lyalitimbulitwi.<verse eid="PRO 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 25:27" />Iherepandiri kuliya lwashi luvuwa ng'anji, ntambuira ifaandiri kulijegelera nentu.<verse eid="PRO 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 25:28" />Muntu yakasinda kugalewelera maya gakuyi, ndo handa mji yagwahera shibambaza.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 26:1" />Ligoya lyakapananwa mzigizigi limfaandiri, ndo handa balafu ya shiyangazi, ama mvula shaka sha kubenangu.<verse eid="PRO 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 26:2" />Shilikwinta ama mbayuwayu yawatukirandiri,handa mpangira yahera toziya hapeniimpati.<verse eid="PRO 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 26:3" />Shiboku kwa farasi shimpingapinga kwa punda na luhonga kwa mgongu gwa mzigizigi.<verse eid="PRO 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 26:4" />Nagumwankula mzigizigi teratera na uzigizigi wakuyi, nagwiza kulifana nayu.<verse eid="PRO 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 26:5" />Gumwankuli mzigizigi teratera na uzigizigi wakuyi, nakiza kuliwona yomberi kana luhala nentu.<verse eid="PRO 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 26:6" />Yakamlagalira mzigizigi, ndo handa kulilimbatula magulu ama kulisakulira ntabiku.<verse eid="PRO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 26:7" />Visoweru vyana luhala mumulomu mwa mzigizigi, ndo handa magulu ga shibyeketu yagatyeteka.<verse eid="PRO 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 26:8" />Kumpanana mzigizigi ligoya, ndo handa kutawa libuhi kuluhembelu.<verse eid="PRO 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 26:9" />Mzigizigi yakajera kutendera visoweru vyana luhala, ndo handa mlowera yakajera kutupula lusontu muliwoku lyakuyi.<verse eid="PRO 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 26:10" />Muntu yakamtula mlihengu mzigizigi ama mlowera, ndo handa yakaguma msali pota kulola kamtenda kila muntu.<verse eid="PRO 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 26:11" />Mzigizigi yakawuyirawuyira uzigizigi wakuyi, ndo handa ng'ang'a yakaliya vyakatapikiti.<verse eid="PRO 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 26:12" />Hashi gumwona muntu yakaliwona kana luhala pamasu pakuyi? Mbaka kumtumbira mzigizigi kuliku muntu handa ayu.<verse eid="PRO 26:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 26:13" />Mleri kalonga, kwana simba kunjira aku, simba ka munjira nkulu.<verse eid="PRO 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 26:14" />Handa ligomi ntambu yalizyengeta mubawaba zakuyi, ndo handa mleri ntambu yakaligalambula pashitanda shakuyi.<verse eid="PRO 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 26:15" />Mleri katula liwoku lyakuyi musahani ya shiboga, kumbiti kasinda kulinyasula mpaka kumlomu.<verse eid="PRO 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 26:16" />Mleri kaliwona kuwera kana luhala, kuliku wantu saba yawaweza kwankula kwa mahala.<verse eid="PRO 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 26:17" />Yakalingiziya mundewi yayiwerayakuyindiri kana maya, ayu ndo handa muntu yakambata ng'ang'a makutu gakuyi.<verse eid="PRO 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 26:18" />Handa muntu yakana lukwali ntambu yakashinigira mambamba, ama misali yayijega kuhowa, <verse eid="PRO 26:18" /><verse number="19" style="v" sid="PRO 26:19" />ndo ntambuyakawera muntu yakampotuziya gwapakwegera, shakapanu kalongi, weriti ntenda lidufiya hera.<verse eid="PRO 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 26:20" />Bila mbawu, motu guzimika bila gwakwang'anira, ndewi imalilika.<verse eid="PRO 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 26:21" />Gambira makala pampindi pa makala na handa mbawu pampindi pa motu, ndo mndewu ntambu yakasongiziya ndewi.<verse eid="PRO 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 26:22" />Visoweru vya yamsongiziya ndo handa shiboga shinoga, visuluka mpaka mmutima mwa muntu.<verse eid="PRO 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 26:23" />Visoweru vinoga vyavilawa mumlomu mwa mdoda, ndo handa vyombu vya ukaka vyavikulugitwi.<verse eid="PRO 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 26:24" />Yakana unywanywa kafifa unywanywa wakuyi kwa visoweru viherepa, kumbiti ukondola umema mngati mmoyu gwakuyi. <verse eid="PRO 26:24" /><verse number="25" style="v" sid="PRO 26:25" />Tembera visoweru vyakuyi vikwegiziya, nagumwamini, toziya mumoyu mwakuyi mumema mirandu mivuwa yayikalalira. <verse eid="PRO 26:25" /><verse number="26" style="v" sid="PRO 26:26" />Pamonga kafifa nkalaliru yakuyi, kumbiti nfiru zakuyi zidoda hazimaniki kulongolu kwa wantu.<verse eid="PRO 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 26:27" />Yakambawira muyaguyi lirindi, hakapatukili ulamweni; yakabilingisiya libuwi halimuwuyili ulamweni.<verse eid="PRO 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 26:28" />Lulimi lwalutakula mpayu luwalema walii yaluwatenditi, namlomu gwaguzyangazyanga gujega magamiziya.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 27:1" />Nagulizyumira ga shirawu, toziya guvimanandiri shishi hashilawili leru.<verse eid="PRO 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 27:2" />Guleki muntu yumonga kakuzyumi pota mlomu gwaku gamweni, guleki mhenga kakuzyumi kuliku lulimi lwaku gamweni.<verse eid="PRO 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 27:3" />Libuwi na mhanga vyoseri ndo vizotopa, kumbiti kukalaziwa na mzigizigi ndo utopa nentu kuliku vyoseri viwili.<verse eid="PRO 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 27:4" />Nkalala ndo nkesera na maya gagamiziya, kumbiti ndo gaa yakaweza kugoloka kulongolu kwa muntu mweni weya?<verse eid="PRO 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 27:5" />Mbaka muntu yakakuberiziya pota kulififa, kuliku ufiru yaulififa.<verse eid="PRO 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 27:6" />Matenduwa ga ganja galanguziya waminika, kuliku mnkondu yakakulangaziya ufiru nentu yawaminikandiri.<verse eid="PRO 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 27:7" />Yakikutiti, ata lwashi kalulema, kumbiti yakana njala kila shashikalipa ndo shinoga.<verse eid="PRO 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 27:8" />Muntu yakagamiriti kutali na kwakuyi, ndo handa mpongu yakagamiriti kutali na shitukulu shakuyi.<verse eid="PRO 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 27:9" />Lipaki linunkira na utuli vijega nemeru mumoyu, ndo handa utakuziya uherepa na waminika wa ganja gwaku.<verse eid="PRO 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 27:10" />Nagulyaluwa wamaganja waku pota tati gwaku. Pagupatwa na ntabiku nagumtugira mlongu gwaku, mbaka gwapakwegera gwaku kuliku mlongu yakawera kutali.<verse eid="PRO 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 27:11" />Mwana gwangu guweri na luhala na gwenga gujegi nemeru mumoyu mwangu, su mpati kumwakula yakambeziya.<verse eid="PRO 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 27:12" />Yakana mahala pakawona shintu shidoda kalififa, kumbiti mzigizigi kalilaviya kulongolu katenduwa.<verse eid="PRO 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 27:13" />Muntu pakatakula kulongolu kwaku kuwera hakamlipili mhenga, gutoli nguwu yakuyi pakamgolokera mhenga.<verse eid="PRO 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 27:14" />Yakamtekelera gwapakwegera gwakuyi kwa umatu mandawira putiputi, shitendu ashi hshimaniki handa mpangira.<verse eid="PRO 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 27:15" />Mdala mndewi mashaka goseri, ndo teratera na lindonda lya mashi ga mvula yagaperandiri; <verse eid="PRO 27:15" /><verse number="16" style="v" sid="PRO 27:16" />Kumlewelera yomberi ndo handa kulewelera lyega, ama yakafira kubata lipaki lyalitelebuka kwa liwoku.<verse eid="PRO 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 27:17" />Shuma shikuwa shuma shimonga, viravilii muntu kafundwa na myaguyi.<verse eid="PRO 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 27:18" />Yakagulolera mtera hakalii mabwajubwaju gakuyi, nayakamtendera mtuwa gwakuyi hakapananwi ligoya.<verse eid="PRO 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 27:19" />Handa sheni ntambu yashiliwona mumashi, ndo ntambu yagulimana gamweni mumoyu.<verse eid="PRO 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 27:20" />Lirindi litali na uhalibisiya vikutandiri, viraa masu ga wantu gigutandiri.<verse eid="PRO 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 27:21" />Uherepa wa madini ga feza ama zahabu vijerwa kwa motu na muntu kajerwa kulawirana na zyuma zakuyi.<verse eid="PRO 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 27:22" />Pagumtwanga mzigizigi mulituli pamuhera na viboga, kumbiti hapeni gumtuligweka na uzigizigi wakuyi.<verse eid="PRO 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 27:23" />Guloli weri mifugu yaku, naguwaloleri weri wakanyama waku, <verse eid="PRO 27:23" /><verse number="24" style="v" sid="PRO 27:24" />toziya ulunda ulikalandiri mashaka goseri, viraa lijenjeri likalandiri muviwuka vyoseri. <verse eid="PRO 27:24" /><verse number="25" style="v" sid="PRO 27:25" />Shaka mihambi miyuma payihengwa na mihambi miwisi ichomola, shaka mihambi kulawa kumigongu payijojonirwa, <verse eid="PRO 27:25" /><verse number="26" style="v" sid="PRO 27:26" />Wankondolu hawakupanani mibayira kwajili ya kunyawira nguwu, wambuzi haguwashuwuzi na kuhemera malambu. <verse eid="PRO 27:26" /><verse number="27" style="v" sid="PRO 27:27" />Wambuzi hawakupanani maweri ga kukutosheya gwenga na kaya yaku, na kwajili ya wantumintumi waku wadala.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 28:1" />Wakondola watuga tembera wawingwawingwandiri na muntu, kumbiti wantu yawatenda maheri wagangamala handa simba.<verse eid="PRO 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 28:2" />Shaka isi payitenda vidoda ijega walonguziya wavuwa, kumbiti kwa muntu yakana luhala na umani isi inyamalira.<verse eid="PRO 28:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 28:3" />Mhushu yakawawonera wahushu wayaguyi, ayu kalifana na mvula nkulu yayihalibisiya viboga vyoseri mumalambu.<verse eid="PRO 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 28:4" />Wantu yawamega lagiru wawazyuma wakontola, kumbiti yawakola lagiru wasingana nawa.<verse eid="PRO 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 28:5" />Mkontola kavimanandiri mana yakuwamula teratera, kumbiti yawamsakula Mtuwa Mlungu wayimana nentu.<verse eid="PRO 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 28:6" />Mbaka mhushu yakalikala kwa kutenda maheri, kuliku mlunda yakalikala kwa kutenda mapotuziya.<verse eid="PRO 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 28:7" />Mwana yakabata lagiru ndo yakana luhala, kumbiti yakawela ganja gwa walwaliya kamsoniziya tati gwakuyi.<verse eid="PRO 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 28:8" />Muntu ulii yakatola lunda kwa nongera na kutola mota, kamjojonilira yumonga yakawawonera lusungu wahushu.<verse eid="PRO 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 28:9" />Yakalema kujimira lagiru, ayu luwa yakuyi ndo nkalaliru kwa Mlungu.<verse eid="PRO 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 28:10" />Yakamzangazanga muntu maheri kutenda madoda, hakapatukiri mulirindi lyakuyi ulamweni,</para>
  <para style="p" vid="PRO 28:10">kumbiti yawahera madoda hawanki vintu viherepa vyawatulilitwi.<verse eid="PRO 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 28:11" />Mlunda kaliwona mweni kuwera kana luhala, kumbiti mhushu yakana mahala kamwona ntambu yakawera.<verse eid="PRO 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 28:12" />Wantu waheri pawakanka kila muntu kanemelera, kumbiti wantu wakontola pawakolamlima wantu walififa.<verse eid="PRO 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 28:13" />Yakafifa vidoda vyakuyi hapenikafanikiwi, kumbiti yakalonga kanavidoda na kuvileka hakalekeziwi.<verse eid="PRO 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 28:14" />Mbaka muntu yakamguwira Mtuwa Mlungu mashaka goseri, kumbiti yakatenda moyu gwakuyi kuwera mkamala hakaguwiri muntabiku.<verse eid="PRO 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 28:15" />Mkolamlima mkontola yakawakolamlima wahushu, ndo handa simba yakaguguma ama kanyama yawamshema dubu yakakomanga.<verse eid="PRO 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 28:16" />Mkolamlima yakahera mahala ndo mnkesera kawawomera wantu, kumbiti yakakalalira vintu vya zuluma hakakolimlima shaka shitangala.<verse eid="PRO 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 28:17" />Muntu yakalitoza toziya ya kumlaga muntu, hakaweri mtugaisi mpaka kuhowa, muntu yoseri nakamtanga.<verse eid="PRO 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 28:18" />Muntu yakahera shidoda hakaponiziwi, kumbiti mpayira hakagamiziwi kalongola.<verse eid="PRO 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 28:19" />Yakalima lirambu lyakuyi hakapati shiboga shivuwa, kumbiti yakafata yagafaandiri hakapati uhushu uvuwa.<verse eid="PRO 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 28:20" />Muntu yakaminika hakapati tekelera zivuwa, kumbiti yakatenda kalongola kupata ulunda hapenikashapiri kukomangwa.<verse eid="PRO 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 28:21" />Iherepandiri kumbagula muntu, wantu watenda madoda ata kwa shipandi sha libumunda.<verse eid="PRO 28:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 28:22" />Muntu Yakanashapa katugira lunda, kumbiti kavimanandiri handa uhushu wankumuhepelera.<verse eid="PRO 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 28:23" />Yakamberiziya myaguyi upeleru hakajimiruwi, kuliku ulii yakajongera kwa visoweru vinoga.<verse eid="PRO 28:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 28:24" />Yakiwa lunda za tati gwakuyi ama mawu gwakuyi, nakalonga shidodandiri, yomberi ndo handa wantu yawahalibisiya.<verse eid="PRO 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 28:25" />Muntu yakana matamata kasongiziya ndewi, kumbiti yakamtumbira Mtuwa Mlungu hakaweri nampatiru.<verse eid="PRO 28:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 28:26" />Yakatumbira mahala gakuyi ulamweni ndo mzigizigi, kumbiti yakalikala kwa luhala hakaweri poneka.<verse eid="PRO 28:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 28:27" />Yakawapanana vintu wahushu hapeni kapungukiwi na shintu, kumbiti yakalema kuwalola hakapangirwi nentu.<verse eid="PRO 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 28:28" />Wakontola pawakolamlima wantu walififa, kumbiti pawagamira, wantu waheri hawongeleki.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 29:1" />Yakaberiziwa mara zivuwa na kuwera kakamala, hakagamiri vumu na hapenikaponi kayi.<verse eid="PRO 29:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 29:2" />Wantu waheri pawafanikwa wantu hawanemeleri, kumbiti wakontola pawakolamlima wantu walalama.<verse eid="PRO 29:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 29:3" />Yakafira luhala kamnemiziya tati gwakuyi, kumbiti Yakalikolana na mhumba kananga lunda yakuyi.<verse eid="PRO 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 29:4" />Mfalumi pakakolamlima pota upendelewu, kayitenda isi kuwera gangamala, kumbiti pakafira swinda isi kayiyagamiziya.<verse eid="PRO 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 29:5" />Yakamzangazanga gwapakwegera gwakuyi, kayalika wavu su kugagomiziya magulu gakuyi.<verse eid="PRO 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 29:6" />Muntu mdoda kagomera kwa shidoda shakuyi, kumbiti muntu yakatenda maheri kimba na kunemelera.<verse eid="PRO 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 29:7" />Muntu muheri kavimana mirandu ilii yayifiruwa wahushu kutenderwa, kumbiti muntu yakatenda madoda kavimanandiri mirandu ayi.<verse eid="PRO 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 29:8" />Yawana beziya wajega ndewi mji goseri, kumbiti yawana luhala wanyamaziya maya.<verse eid="PRO 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 29:9" />Yakana luhala pakagenda kumahakama na mzigizigi, mzigizigi kawera na maya na kaseka kwa beziya kayi kwahera ponga.<verse eid="PRO 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 29:10" />Yawafira kwita mwazi wamkalalira muntu yakahera shidoda, kumbiti wantu waheri waulolera ukomu wakuyi.<verse eid="PRO 29:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 29:11" />Mzigizigi kalangaziya maya gakuyi pota kufifa, kumbiti yakana luhala kaganyamaziya.<verse eid="PRO 29:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 29:12" />Mkolamlima pakapikanira mirandu yaupaya, wakulu yawawera pasi pakuyi hawaweli wakontola.<verse eid="PRO 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 29:13" />Mhushu na myonera walifana kwa shintu shimu, woseri wawili wapananwa masu na Mtuwa Mlungu.<verse eid="PRO 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 29:14" />Mfalumi yakalaviyatoza kwa wahushu pota kulola kusheni kwa, kanfiliziya Mlungu, hakauwoni ukolamlima wakuyi uligangamaziya mashaka goseri.<verse eid="PRO 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 29:15" />Azabu na maberiziwu gajega luhala, kumbiti mwana yakalekitwi katendi ntambu vyakafira mweni kamsoniziya mawu gwakuyi.<verse eid="PRO 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 29:16" />Wakontola pawakolamlima makontola gongereka, kumbiti wantu yawatenda maheri hawawoni kuguwa kwawu.<verse eid="PRO 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 29:17" />Gumberiziyi mwana gwaku nayomberi hakakupanani lyoga, yomberi hakagunemiziyi moyu gwaku.<verse eid="PRO 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 29:18" />Pahala yapawerandiri na malola wantu wagamira, kumbiti yakakola lagiru hakatekelerwi.<verse eid="PRO 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 29:19" />Mmanda kaberizikandiri kwa visoweru hera, mana tembera kagamana yomberi hapeni kagajimiri.<verse eid="PRO 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 29:20" />Gumwona muntu yakatakula pota kulihola? Muntu mzigizigi ndo mbaka kuliku yomberi.<verse eid="PRO 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 29:21" />Yakamzyangazyanga ntumintumi gwakuyi kwanjira uwana, upeleru wakuyi mmanda ayu hakamgaziyi.<verse eid="PRO 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 29:22" />Yakana maya kasogiziya ndewi, muntu gwa mtiti kajega madoda gavuwa.<verse eid="PRO 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 29:23" />Mkulitumba kwa muntu gumtenda mweni kalisulusiyi, kumbiti mnanaga gwa rohu hakapananwi ligoya.<verse eid="PRO 29:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 29:24" />Yakalikolana na muntu shimbegu kalitenda ulamweni, ata pakalilapa hapeni kayoweli unakaka.<verse eid="PRO 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 29:25" />Kuwatira wantu ndo kuliyambila ulagamweni, kumbiti yakamtumbira Mtuwa Mlungu kaponeka.<verse eid="PRO 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 29:26" />Wavuwa wafira kulijegelera kwa mkolamlima, kumbiti muntu kapata shakafiruwa kushipata kulawa kwa Mtuwa Mlungu.<verse eid="PRO 29:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 29:27" />Mkontola ndo nkalaliru kwa muntu yakatenda maheri, mtenda maheri ndo nkalaliru kwa mkontola.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s">Visoweru vya Aguri</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Visoweru vya Aguri, mwana gwa Yake,</para>
  <para style="q" vid="PRO 30:1">Magambiziya geni muntu ayu kamgambira Itieli,</para>
  <para style="q" vid="PRO 30:1">yina, Itieli na Ukali.<verse eid="PRO 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2" />Neni ndo mzigizigi kuliku wantu woseri,</para>
  <para style="q" vid="PRO 30:2">nahera mahala geni muntu kaweza kuweranaga.<verse eid="PRO 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 30:3" />Hanenilifundi luhala,</para>
  <para style="q" vid="PRO 30:3">pota nivimanandiri shintu shoseri kuusu Mlungu Mnanagala.<verse eid="PRO 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4" />Ndo gaa yakakweniti kumpindi shakapanu kasuluka pasi?</para>
  <para style="q" vid="PRO 30:4">Ndo gaa yakalibatiti lyega mumawoku gakuyi?</para>
  <para style="q" vid="PRO 30:4">Ndo gaa yakabilinga mashi mushitambala?</para>
  <para style="q" vid="PRO 30:4">Ndo gaa yakatuliti mbaka yoseri ya upeleru wa pasipanu?</para>
  <para style="q" vid="PRO 30:4">Litawu lyakuyi ndo gaa?</para>
  <para style="q" vid="PRO 30:4">Ama litawu lya mwanagwakuyi mpalu ndo gaa? Handa guvimana gung'ambili.<verse eid="PRO 30:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 30:5" />Visoweru vyoseri vya Mlungu ndo vya nakaka, yomberi ndo ngawu yawu woseri yawamtugira. <verse eid="PRO 30:5" /><verse number="6" style="v" sid="PRO 30:6" />Nagongera shisoweru muvisoweru vyakuyi, nakiza kukukalipira na gwenga guwoneka gwampaya.<verse eid="PRO 30:6" /></para>
  <para style="s">Mesali zimonga</para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 30:7" />Mirandu ayi miwili nikuluwa gwee Mlungu, pota nagumbelera pamberi nenefuwi: <verse eid="PRO 30:7" /><verse number="8" style="v" sid="PRO 30:8" />Gumbusiliri upaya na uzyanga, nagumpanana uhushu pota ulunda, ila gumpanani shiboga shanishifira kula lishaka, <verse eid="PRO 30:8" /><verse number="9" style="v" sid="PRO 30:9" />naniza kwikuta na kukulema, pantakula Mtuwa Mlungu ndo gaa? Ama naniza kuwera mhushu na kwiwa na kuligira litawu lyaku gwee Mlungu gwangu.<verse eid="PRO 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 30:10" />Nagumshongera ntumintumi kwa mtuwa gwakuyi, nakiza kukupangira, guwoneki gwana makosa.<verse eid="PRO 30:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 30:11" />Kwana wantu weni wawapangalira watati wawu, kayi wawatekelerandiri wamawu wawu.<verse eid="PRO 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 30:12" />Kwana wantu weni waliwona kuwera waheri, kumbiti hawenelekiziwi vidoda vyawu.<verse eid="PRO 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 30:13" />Kwana wantu walidumba ng'anji, wabeziya kila shintu shawashiwona.<verse eid="PRO 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 30:14" />Kwana wantu weni menu gawu ndo gakalipa handa ligumba likola kuwili na magegu gawu handa vimagi. Wawera kala kuwamemena wahushu muisi, na wantu yawanafiru muwamu mwa wantu.<verse eid="PRO 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 30:15" />Mruba kana wahinga wawili yawatakula “Gumpanani”</para>
  <para style="p" vid="PRO 30:15">Kwana vintu vitatu vyeni nakamu vikutandiri, yina vintu vyamsheshi vyavitakulandiri, itosheya<verse eid="PRO 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16" />Kulisembi,</para>
  <para style="q" vid="PRO 30:16">mtima gwa mdala yakalerandiri,</para>
  <para style="q" vid="PRO 30:16">litapaka lyalikutandiri mashi na motu gwagutakulandiri,</para>
  <para style="q" vid="PRO 30:16">itosheya<verse eid="PRO 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 30:17" />Handa muntu pakamjongera tati gwakuyi, na kubeziya kujimira kwa mawu gwakuyi, masu gakuyi hagadonolangwi na kunguru gwa kululalanda na nkashanga hawamliyi.<verse eid="PRO 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 30:18" />Kwana mirandu mitatu yayiwera ya kulikangasha kwaneni, yina, mirandu msheshi yaniyimanandiri:<verse eid="PRO 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19" />Njira ya shipanga kuliyera,</para>
  <para style="q" vid="PRO 30:19">njoka ntambuyakatyanga kulitalawu,</para>
  <para style="q" vid="PRO 30:19">meri ntambu yayityanga mubahari</para>
  <para style="q" vid="PRO 30:19">na ufiru wawumkwega mpalu kwa mdala.<verse eid="PRO 30:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 30:20" />Matendu ga mdala mhumba ndo aga: Yomberi kaliya, kalipukuta mlomu na kulonga, “Ntendandiri shidoda shoseri!”<verse eid="PRO 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 30:21" />Kwana mirandu mitatu yeni ipalendemeziya pasipanu, yina, mirandu yamsheshi yeni pawezandiri kuhepelera:<verse eid="PRO 30:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22" />Mmanda yakawera mfalumi,</para>
  <para style="q" vid="PRO 30:22">mzigizigi yakikuta shiboga,<verse eid="PRO 30:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23" />mdala yakafiruwandiri kuyugwa pakayugwa</para>
  <para style="q" vid="PRO 30:23">na yaya yakatola lupenu lwa bibi gwakuyi.<verse eid="PRO 30:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 30:24" />Kwana viumbi vyamsheshi vididiki ng'anji pasipanu, kumbiti vyana mahala nentu:<verse eid="PRO 30:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25" />Awa ndo wasungu, wang'ong'olu wahera makakala, kumbiti walitulira shiboga shawu toziya ya shaka sha shiyangazi;<verse eid="PRO 30:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26" />pimbi, wankanyama yawahera uwezu, kumbiti walinyawira seemu za kulikala mulitalawu;<verse eid="PRO 30:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27" />wanjombi wahera mlonguziya, kumbiti woseri wagendagenda pamuhera muvipinga.<verse eid="PRO 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28" />Shitunu: Guweza kumbata muliwoku, kumbiti waweza kwingira mumaboma ga shifalumi.<verse eid="PRO 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 30:29" />Kwana viumbi vitatu vyeni kutyanga kwawu kuherepa, yina, kwana viwumbi msheshi vyeni kutyanga kwawu kwa malingu:<verse eid="PRO 30:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30" />Simba, shigongolu yakana makakala kuliku woseri pota kamtirandiri shigongolu yumonga yoseri;<verse eid="PRO 30:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31" />njogolu yakagenda kwa maringu, kayi mbuzi pongu</para>
  <para style="q" vid="PRO 30:31">na mfalumi kulongolu kwa wantu wakuyi.<verse eid="PRO 30:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 30:32" />Handa gutenda uzigizigi na gulizyuma mweni ama handa gupanga mirandu midoda, gudiwi mlomu gwaku. <verse eid="PRO 30:32" /><verse number="33" style="v" sid="PRO 30:33" />Toziya pagugapima maweri hagupati siyagi, pagumkoma muntu mpalu hakalawi mwazi, viravilii kusongiziya maya kujega ndewi.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s">Visoweru vya mfalumi Lemueli</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Avi ndo visoweru vya mfalumi Lemueli, vyakagambiritwi na mawu gwakuyi:<verse eid="PRO 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 31:2" />“Nikugambiri shishi mwanagwangu? Nikugambiri shishi mwanagwangu yanikwiwuliti? Nikugambiri shishi gwenga mwana yagulawinaniti na shantakuliti? <verse eid="PRO 31:2" /><verse number="3" style="v" sid="PRO 31:3" />Nagumalira makakala gaku kwa wadala, naguwapanana uwezu waku awa yawawahalibisiya wafalumi. <verse eid="PRO 31:3" /><verse number="4" style="v" sid="PRO 31:4" />Ifaandiri gwee Lemueli, ifaandiri mfalumi kulanda divayi, pota wakulu kufira ujimbi, <verse eid="PRO 31:4" /><verse number="5" style="v" sid="PRO 31:5" />su nawalanda na kulwaluwa malagalira ga lagiru, kuwima wahushu shilii shawafiruwa kupata. <verse eid="PRO 31:5" /><verse number="6" style="v" sid="PRO 31:6" />Gumpanani ujimbi muntu yakagamira, gumpanani divayi muntu yakana hinginika nentu; <verse eid="PRO 31:6" /><verse number="7" style="v" sid="PRO 31:7" />Walandi na kulwaluwa uhushu wawu, nawalihola kayi ntabiku zawu.”<verse eid="PRO 31:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 31:8" />“Kumbiti gwenga, gufiruwa gutakuli kwajili ya woseri yawawezandi kuyowera na kukomanira shili sheni wafiruwa kupata yawawezandiri kulitakulira. <verse eid="PRO 31:8" /><verse number="9" style="v" sid="PRO 31:9" />Gutakuli toziya yawu na kwamuwa pota kumwonera muntu, guwatakuliri wahushu na yawananfiru shilii shawafiruwa kupata.”<verse eid="PRO 31:9" /></para>
  <para style="s">Mdala muheri</para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 31:10" />Mdala yakana zyuma ziherepa ndo gaa kaweza kumpata? Yomberi ndo gwa mana kuliku madini ga beyi nkula!<verse eid="PRO 31:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 31:11" />Mpalu gwakuyi kamwamini kwa moyu gwakuyi, hapeni kakosi shintu shoseri shiheri mashaka goseri.<verse eid="PRO 31:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 31:12" />Hapeni kamtenderi mpalu gwakuyi mirandu midoda, ilaa hakamtenderi mirandu miheri mukulikala kwakuyi koseri.<verse eid="PRO 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 31:13" />Kasakula mibahira ya kondolu na nguwu nvufu na kutenda lihengu kwa mawoku gakuyi kwa ugangamala.<verse eid="PRO 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 31:14" />Yomberi ndo handa meri za ushuhuzi, kajega shiboga shakuyi kulawa kutali.<verse eid="PRO 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 31:15" />Kimuka mandawira putiputi, kuyitandira kaya yakuyi shiboga na kuwapanana mahengu mayaya.<verse eid="PRO 31:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 31:16" />Kalihola kuhemera lirambu, kulawirana na vyakapata na kulima mizabibu.<verse eid="PRO 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 31:17" />Kawera kala kutenda lihegu kwa makakala na kugangamaziya mawoku gakuyi.<verse eid="PRO 31:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 31:18" />Kavimana handa mahengu gakuyi gana mota, katenda lihengu mpaka pashiru.<verse eid="PRO 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 31:19" />Kapota ubunda kwa mawoku gakuyi mweni, kasona nguwu kwa mawoku gakuyi.<verse eid="PRO 31:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 31:20" />Kayi kawapanana wahushu, katalipisiya liwoku kuwatanga yawahera vintu.<verse eid="PRO 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 31:21" />Kantirandiri shaka sha mpepu, toziya kila yumu kana nguwu za mpepu.<verse eid="PRO 31:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 31:22" />Kalinyawira matandiku, nguwu zakuyi za rangi zambarawu na nguwu nvufu nentu.<verse eid="PRO 31:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 31:23" />Mpalu gwakuyi kamanika muwamu mwa watoza wa mji, kalikala muwamu mwa wazewi wa isi.<verse eid="PRO 31:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 31:24" />Mdala ayu kanyawa nguwu nvufu na kashuwuza, kawawuzira washuwuzi wa mifunga.<verse eid="PRO 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 31:25" />Makakala na ligoya ndo zyuma zakuyi, kaseka na kaliholerandiri mashaka gagiza.<verse eid="PRO 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 31:26" />Kazumba kwa luhala na mafunda ga ufiru ga mululimi mwakuyi.<verse eid="PRO 31:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 31:27" />Kagatendera lihengu goseri yagatendeka munumba yakuyi, kalikayandiri shiboga sha uleri.<verse eid="PRO 31:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 31:28" />Wana wakuyi wimuka na kumgambira mayagashiii na mpalu gwakuyi viraa kamzyuma.<verse eid="PRO 31:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 31:29" />Kalonga, “Wadala wavuwa watenda mirandu iherepa nentu, kumbiti gwenga guwakanka woseri.”<verse eid="PRO 31:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 31:30" />Maherepiziya gapayira na kuherepa kufaandiri, kumbiti mdala yakamguwira Mtuwa Mlungu ndo hakazyumwi.<verse eid="PRO 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 31:31" />Gumpanani zyuma kwa galii gakatenditi, lihengu lyakuyi lipananwi ligoya na wantu woseri.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>