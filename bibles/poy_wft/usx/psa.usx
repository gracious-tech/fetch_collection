<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Pogoro Bible Version</book>
  <para style="h">Zabuli</para>
  <para style="toc1">Shitabu sha zabuli</para>
  <para style="toc2">Zabuli</para>
  <para style="toc3">Zabu</para>
  <para style="mt2">Shitabu sha</para>
  <para style="mt1">Zabuli</para>
  <para style="imt">ULONGULERU</para>
  <para style="ip">Shitabu sha Zabuli ndo mjojoniru gwa nyimbu na maluwa. Muluga ya Shiebrania shisoweru Zabuli shana mana “Lwimbu lwa zyuma.” Zabuli zivuwa zimema yimbu zya kumzyuma Mlungu, kumbiti kwana ayi na zimonga za Zabuli, zimonga ziyowelera maluwa ga utanga kwa Mlungu zimonga zya madaya zyazitakulira hinginika nkulu. Kwana yimbu zya kumzyuma mfalumi gwa Israeli, zimonga zitenderwa kuwafunda wantu luhala na mafiru ga Mlungu na gamonga. Shitabu sha Zabuli shilebwa na wantu gwekagweka na shijojonilitwi kwa muvinja nentu ya miya yimu. Zabuli zimonga zilembitwi makashu shaka sha mfalumi Daudi. Bibilia itakula yomberi ndo yakalembiti Zaburi zivuwa. Na wamonga walemba pa Wayahudi kuwuya muumanda aku Babeli. Wabetula wamaniti handa upeleru wa majojoniru ga Zabuli ziweriti pakati pa kalini ya tatu mpaka ya msheshi pamberi pa kwiwuka kwa Kristu Yesu. Mpangiliwu gwa upeleru guweriti na walanga ya zaburi miya amusini, gweni gubagulitwi mala mhanu muvitabu vidikavidika.</para>
  <para style="ip">Ziweri nyimbu ama maluwa Zabuli zoseri ndo muundu gwa shayili. Umani mdidini kuusu muundu gwa shayili wa Shiebrania hawutangi nentu kumana Zabuli. Shintu shamana mukulemba shayili ya Shiebrania shishemwa uteratera, walemba watula pamuhera misitali miwili mu Zabuli. Mfanu msitali gwa kwanja gulaviya matakulu na gwa pili gutola muwamu mwa msitali gumu gwa mitatu ayi, iwezekana paguwuyira liholu lilii lya kwanja, ama kuwuyira liholu lilaali kwa visoweru vimonga su kushishintila ama kutula liholu lyalisingana na mstali gwa kwanja, ama litakulira mstali gwa kwanja kwa lupalahera nentu.</para>
  <para style="ip">Shitabu sha Zabuli ndo muwamu mwa shitabu shimanika na shitabu shashinemelerwa nentu Mubibiliya. Zabuli zivuwa ziweriti zitenderwa munguwira mu Numba Nkulu ya Mlungu aku Yerusalemu. Zabuli itufunda twenga ntambu ya kumluwa na kumzyuma Mlungu gwa kumpindi nentu. Zabuli ya ishilini na tatu ijega nyamaziya kwa wantu yawawera mukwinginika. Zabuli ya amusini na yimu itakulira kuleka vidoda. Zabuli miya na lilongu ijega nyamaziya ya moyu na matumbiru kwa kubwera kwiza kwakuyi Masiya yanakaweri mfalumi na mtambika.</para>
  <para style="iot">Yagawera amu mushitabu sha zabuli</para>
  <para style="io">Shitabu sha kwanja sha Zabuli ndo kwanjira shipandi sha 1-41</para>
  <para style="io">Shitabu sha pili sha Zabuli ndo kwanjira shipandi sha 42-72</para>
  <para style="io">Shitabu sha tatu sha Zabuli ndo kwanjira shipandi sha 73-89</para>
  <para style="io">Shitabu sha msheshi sha Zabuli ndo kwanjira shipandi sha 90-106</para>
  <para style="io">Shitabu sha mhanu sha Zabuli ndo kwanjira shipandi sha 107-150</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">SHITABU SHA KWANJA</para>
  <para style="r">
    <ref loc="PSA 1-41">Zabuli 1-41</ref></para>
  <para style="s">Nemeru ya nakaka</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1" />Mbaka muntu yakafatandiri litakuziwu lya wakontola,</para>
  <para style="q" vid="PSA 1:1">yakatendandiri ntambu yawatenda yawanavidoda,</para>
  <para style="q" vid="PSA 1:1">pota kuwera pamuhera na yawanalijonga,<verse eid="PSA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2" />kumbiti kanemelera kujimira lagiru ya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 1:2">na kuyihola paluwala na pashiru.<verse eid="PSA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3" />Muntu ayu ndo handa mtera yaguyalitwi kumpeku kulushemba,</para>
  <para style="q" vid="PSA 1:3">yagulera mabwajubwaju kwa shaka shakuyi,</para>
  <para style="q" vid="PSA 1:3">na mihamba yakuyi inyalandiri.</para>
  <para style="q" vid="PSA 1:3">Shoseri shakatenda shiwera na mpatiru.<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4" />Kumbiti wakontola wahangundiri,</para>
  <para style="q" vid="PSA 1:4">womberi ndo handa miwawi yayigulusiwa na lihega.<verse eid="PSA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5" />Hangu wakontola hawatozwi na Mlungu,</para>
  <para style="q" vid="PSA 1:5">pota wanavidoda hapeniwaweri pamuhera na wananagala wa Mlungu.<verse eid="PSA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6" />Mana Mtuwa Mlungu kazilonguziya njira za wanahaki,</para>
  <para style="q" vid="PSA 1:6">kumbiti njira za wakontola haziagamiziwi.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">Mfalumi yakasyagulitwi na Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1" />Hashi maisi gankutenda ndewu?</para>
  <para style="q" vid="PSA 2:1">Mbona wantu wankulitakuziya hera?<verse eid="PSA 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2" />Wafalumi wa pasipanu wagalambuka,</para>
  <para style="q" vid="PSA 2:2">wakolamlima wankupanga madoda pamuhera,</para>
  <para style="q" vid="PSA 2:2">su kumgalambuka Mtuwa Mlungu na mfalumi yakamsyagula.<verse eid="PSA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3" />Wankulonga, “Tuliyopoli minyololu yawu,”</para>
  <para style="q" vid="PSA 2:3">“Tudumuliri kutali ngoyi zyawu.”<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4" />Mtuwa Mlungu yakalikala kumpindi,</para>
  <para style="q" vid="PSA 2:4">kankuwaseka na kuwajongera.<verse eid="PSA 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5" />Shakapanu kankuwakalipira kwa maya,</para>
  <para style="q" vid="PSA 2:5">na kuwatiliziya kwa nkalaliru, pakalonga.<verse eid="PSA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6" />“Nimlumika mfalumi yanimsyaguliti,” Kankukolamlima sayuni,</para>
  <para style="q" vid="PSA 2:6">“Lugongu lwangu lunanagala.”<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7" />Mfalumi ayu kalonga, “Hambweri,” shakang'ambiriti Mtuwa Mlungu.</para>
  <para style="q" vid="PSA 2:7">“Gwenga ndo mwana gwangu,</para>
  <para style="q" vid="PSA 2:7">leru neni wera tati gwaku.<verse eid="PSA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8" />Gunduwi na neni hanikupanani maisi gaweri uhala waku,</para>
  <para style="q" vid="PSA 2:8">na pasipanu poseri kuwera lunda yaku.<verse eid="PSA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9" />Haguwaposholi kwa luhonga lwa shuma,</para>
  <para style="q" vid="PSA 2:9">haguwampantangi handa shiwiga.”<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10" />Vinu mwenga wafalumi, mtenderi luhala,</para>
  <para style="q" vid="PSA 2:10">mpikiniri likalapiru ali mwenga wakolamlima wa pasipanu.<verse eid="PSA 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11" />Mmutenderi Mtuwa Mlungu kwa kumguwira,</para>
  <para style="q2" vid="PSA 2:11">munemeleri kwa kulendemera,<verse eid="PSA 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12" />mumsuntamaliri mwana gwakuyi mpalu,</para>
  <para style="q" vid="PSA 2:12">nakiza kukalala na mwenga namwagamira munjira zyenu,</para>
  <para style="q" vid="PSA 2:12">toziya maya gakuyi ga kalongola.</para>
  <para style="b" vid="PSA 2:12" />
  <para style="q" vid="PSA 2:12">Mbaka woseri yawamtugira.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s">Luwa ya mandawira</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 3:1" />Gwee Mtuwa Mungu, guloli ntambu yawawera wavuwa wankondu waneni.</para>
  <para style="q" vid="PSA 3:1">Wavuwa nentu awa yawankomanga.<verse eid="PSA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2" />Wavuwa wantakula,</para>
  <para style="q" vid="PSA 3:2">“Hapenikapati utanga kwa Mlungu.”<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3" />Kumbiti gwenga Mlungu ndo lusegeyu lwa neni kila uwega,</para>
  <para style="q" vid="PSA 3:3">gwenga ndo yaguntenda ng'ering'eti</para>
  <para style="q" vid="PSA 3:3">na mpananwi ligoya,<verse eid="PSA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4" />Kwa liziwu lyangu nikulilira gwee Mlungu,</para>
  <para style="q" vid="PSA 3:4">na gwenga gumpikinira kulawa lugongu lwaku lunanagala.<verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5" />Ng'onja na kupata mpota,</para>
  <para style="q" vid="PSA 3:5">nanimuka kayi toziya gwenga gundolera.<verse eid="PSA 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6" />Hanigatirindiri malongu elufu ga wankondu,</para>
  <para style="q" vid="PSA 3:6">yawazyengeta kila uwega.<verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7" />Gwee Mtuwa Mlungu, Mlungu gwangu gwizi! Gundopoli!</para>
  <para style="q" vid="PSA 3:7">Gwenga guwamega nzaya wankondu waneni woseri,</para>
  <para style="q" vid="PSA 3:7">guwamega menu wakontola nawantenda.<verse eid="PSA 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8" />Mtuwa Mlungu ndo yakalopola,</para>
  <para style="q" vid="PSA 3:8">guwatekeleri wantu waku.<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s">Kuluwa utanga pashimihi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 4:1" />Gwee Mlungu gwangu yagumbusilira ndawumu,</para>
  <para style="q" vid="PSA 4:1">gunankuli panduwa.</para>
  <para style="q" vid="PSA 4:1">Pawera na ntabiku, gwenga guntangi,</para>
  <para style="q" vid="PSA 4:1">gumoneri lusungu na kupikinira luwa yaneni.<verse eid="PSA 4:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2" />Mwenga, hamhalibisiyi litawu lyaneni mpakandii,</para>
  <para style="q" vid="PSA 4:2">mpakandii hamfiri mirandu yamanandiri</para>
  <para style="q" vid="PSA 4:2">na kulonga mpayu?<verse eid="PSA 4:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3" />Muvimani kuwera Mtuwa Mlungu kamsyagula mwaminika kwajili yakuyi.</para>
  <para style="q" vid="PSA 4:3">Nakapikiniraga kila panimshema.<verse eid="PSA 4:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4" />Mlendemeri kwa lyoga na namtenda vidoda,</para>
  <para style="q" vid="PSA 4:4">pamunyamala mvitanda vyenu mliholi.<verse eid="PSA 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5" />Mlaviyi tambiku zyazifiruwa,</para>
  <para style="q" vid="PSA 4:5">na kumtumbira Mtuwa Mlungu.<verse eid="PSA 4:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6" />Wavuwa walonga,</para>
  <para style="q" vid="PSA 4:6">“Gaa hakatupanani mpatiru?</para>
  <para style="q" vid="PSA 4:6">Gutuloli kwa lusungu, gwee Mlungu!”<verse eid="PSA 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7" />Kumbiti neni gumpanana nemeru nkulu mmoyu,</para>
  <para style="q" vid="PSA 4:7">kuliku yawawera na</para>
  <para style="q" vid="PSA 4:7">nganu na divai ivuwa.<verse eid="PSA 4:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8" />Hang'onji na kupata mbota kwa ponga,</para>
  <para style="q" vid="PSA 4:8">toziya gwee Mtuwa Mlungu gweka yaku, gundolera.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s">Maluwa ga ulolera</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 5:1" />Gupikiniri visoweru vyaneni, Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 5:1">gupikaniri ntambu yandaya.<verse eid="PSA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 5:2" />Gupikiniri kulira kwaneni,</para>
  <para style="q" vid="PSA 5:2">Mfalumi gwangu na Mlungu gwangu,</para>
  <para style="b" vid="PSA 5:2" />
  <para style="q" vid="PSA 5:2">toziya gwenga ndo yanikuluwa.<verse eid="PSA 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3" />Gwee Mtuwa Mlungu, mandawira putiputi gulipikinira liziwu lyangu,</para>
  <para style="q" vid="PSA 5:3">mandawira njega maluwa</para>
  <para style="q" vid="PSA 5:3">shakapanu hepelera gunankuli.<verse eid="PSA 5:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4" />Gwenga gwa Mlungu yagufirandiri udoda,</para>
  <para style="q" vid="PSA 5:4">kwagwenga mkontola hapeni kalikali.<verse eid="PSA 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5" />Yawana mtiti wafiruwandiri kulongolu kwaku,</para>
  <para style="q" vid="PSA 5:5">gwenga guwakalalira woseri yawatenda makontola.<verse eid="PSA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6" />Haguwalagi woseri yawatakula mpayu,</para>
  <para style="q" vid="PSA 5:6">guwakalalira yawalaga na wapayira.<verse eid="PSA 5:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7" />Kumbiti kwa utanga waku mkulu neni,</para>
  <para style="q" vid="PSA 5:7">hanizi mnumba mwaku,</para>
  <para style="q" vid="PSA 5:7">kwa unanaga, hanikuguwiri Kuhekalu laku linanagala,<verse eid="PSA 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8" />Gunonguziyi ntambuyagufira, gwee Mtuwa Mlungu, toziya wankondu wangu wankuhepera kunkomanga,</para>
  <para style="q" vid="PSA 5:8">njira yaku guyituli luparahera kulongolu kwaneni.<verse eid="PSA 5:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9" />Mumilomu mwawu mwahera unakaka,</para>
  <para style="q" vid="PSA 5:9">mumiyoyu mwawu wamema mahalabisiwu,</para>
  <para style="q" vid="PSA 5:9">makulumiru gawu ndo handa lisembi lya lupalahera,</para>
  <para style="q" vid="PSA 5:9">milimi yawu imema uzyanga.<verse eid="PSA 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10" />Guwakomi kwa vidoda vyawu gwee Mlungu,</para>
  <para style="q" vid="PSA 5:10">wabatwi kwa migomiziwu yawu weni,</para>
  <para style="q" vid="PSA 5:10">guwawingili kunja kwa vidoda vyawu vivuwa,</para>
  <para style="q" vid="PSA 5:10">toziya wakugalambuka gwenga.<verse eid="PSA 5:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11" />Kumbiti wanemeleri woseri yawatugira uponeru waku,</para>
  <para style="q" vid="PSA 5:11">wimbi kwa nemeru mashaka goseri.</para>
  <para style="q" vid="PSA 5:11">Guwaloleri waminika waku,</para>
  <para style="q" vid="PSA 5:11">su wanemeleri.<verse eid="PSA 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12" />Mana gwee Mtuwa Mlungu nakaka guwatekelera waminika,</para>
  <para style="q" vid="PSA 5:12">gwawashinga kwa tanga zaku handa kwa lusegeyu.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s">Maluwa shaka sha ntabiku</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 6:1" />Gwee Mtuwa Mlungu, nagunkalipira kwa maya gaku,</para>
  <para style="q" vid="PSA 6:1">nagunkomanga kwa nkalaliru yaku,<verse eid="PSA 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2" />Gumoneri lusungu, Gwee Mtuwa Mlungu, mperuwa makakala,</para>
  <para style="q" vid="PSA 6:2">gwee Mtuwa Mlungu, gumponiziyi ndwala mpaka kumihonju.<verse eid="PSA 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3" />Nshanshatika nentu mumoyu mwa neni.</para>
  <para style="q" vid="PSA 6:3">Gwee Mtuwa Mlungu, hagukawawiri mpaka ndii?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4" />Gundoli, gwee Mtuwa Mlungu, gundopoli,</para>
  <para style="q" vid="PSA 6:4">gumponiziyi kwa ufiru waku mkulu.<verse eid="PSA 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5" />Aku kwa wahowiti kwahera yakakuhola,</para>
  <para style="q" vid="PSA 6:5">aku kumambi ndo gaa yakaweza kulonga maya ga shii?<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6" />Ntoka kulira kwa utama,</para>
  <para style="q" vid="PSA 6:6">pashiru poseri ndoviya shitanda shangu kwa masozi,</para>
  <para style="q" vid="PSA 6:6">kwa kulira kwa neni msagamu gwangu gulowa.<verse eid="PSA 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7" />Masu gangu gatoka kwa kuhinginika,</para>
  <para style="q" vid="PSA 6:7">gawera masheri toziya ya wankondu.<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8" />Muwuki kwa neni woseri yamutenda makontola!</para>
  <para style="q" vid="PSA 6:8">Toziya Mtuwa Mlungu kapikinira kulira kwa neni.<verse eid="PSA 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9" />Mtuwa Mlungu kapikinira luwa yaneni yakuluwa kamoneri lusungu,</para>
  <para style="q" vid="PSA 6:9">Mlungu kajimira maluwa ganeni.<verse eid="PSA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10" />Wankondu waneni woseri hawasoniziki na kwinginika,</para>
  <para style="q" vid="PSA 6:10">hawawuyi kumbeli na kusoniziwa vumu.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s">Maluwa ga kuluwa haki</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 7:1" />Gwee Mtuwa Mlungu, Mlungu gwangu, nikutugira gwenga,</para>
  <para style="q" vid="PSA 7:1">gundopoli na gunkomboli nawoseri yawanfata kwa udoda,<verse eid="PSA 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2" />Hera hangu, hawizi kumpapula handa simba,</para>
  <para style="q" vid="PSA 7:2">pawanyofolanga pota napawera na gwa kundopola.<verse eid="PSA 7:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 7:3" />Gwee Mtuwa Mlungu, Mlungu gwangu,</para>
  <para style="q" vid="PSA 7:3">Handa ntenda aga,</para>
  <para style="q" vid="PSA 7:3">ama ntenda madoda,<verse eid="PSA 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 7:4" />ama nimtendara madoda ganja gwangu,</para>
  <para style="q" vid="PSA 7:4">ama nimkomanga mnkondu gwangu pota toziya,<verse eid="PSA 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5" />su, mnkondu na kanfati na kumpata,</para>
  <para style="q" vid="PSA 7:5">kantimbangi,</para>
  <para style="q" vid="PSA 7:5">nakandeki nfuwiri pasi.<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6" />Gwee Mtuwa Mlungu kwa maya gaku,</para>
  <para style="q" vid="PSA 7:6">gugoloki kwajili ya makomangu ga wankondu waneni.</para>
  <para style="q" vid="PSA 7:6">Gugoloki toziya yaneni,</para>
  <para style="q" vid="PSA 7:6">gwenga guhimiziya haki itendeki,<verse eid="PSA 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7" />gugajojoniri maisi kubwegabwega kwaku na gwenga gugakolimlima kulawa pampindi.<verse eid="PSA 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8" />Gwee, Mtuwa Mlungu, gwankugatoza maisi,</para>
  <para style="q" vid="PSA 7:8">nagunanguziyi kuwera nahera vidoda,</para>
  <para style="q" vid="PSA 7:8">toziya nahera makosa.<verse eid="PSA 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9" />Guumaliri ukontola wa wantu wadoda,</para>
  <para style="q" vid="PSA 7:9">guwagangamaziyi wantu waheri,</para>
  <para style="q" vid="PSA 7:9">toziya gwee Mlungu ndo yaguwera mwaminika,</para>
  <para style="q" vid="PSA 7:9">na yaguzimana bada za miyoyu na maholu gwa wantu.<verse eid="PSA 7:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10" />Mlungu ndo lusegeyu lwangu,</para>
  <para style="q" vid="PSA 7:10">yomberi kawalopola wanamoyu guherepa.<verse eid="PSA 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11" />Mlungu ndo mtoza gwa haki,</para>
  <para style="q" vid="PSA 7:11">Kawatoza yawatenda makontola.<verse eid="PSA 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12" />Wantu pawalekandiri vidoda,</para>
  <para style="q" vid="PSA 7:12">Mungu hakakuwi ligumba lyakuyi na</para>
  <para style="q" vid="PSA 7:12">hakaniki upindi wakuyi kuwuloliziya kwakaguma.<verse eid="PSA 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13" />Hakatandi vikomangiru vikalipa na</para>
  <para style="q" vid="PSA 7:13">kuyitanda kala kuguma misali yakuyi yayiwaka motu.<verse eid="PSA 7:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14" />Guloli, Muntu mdoda kamema makontola,</para>
  <para style="q" vid="PSA 7:14">kapanga uhalibisiya</para>
  <para style="q" vid="PSA 7:14">na kulera upayira.<verse eid="PSA 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15" />Kabawa lirindi,</para>
  <para style="q" vid="PSA 7:15">Shakapanu kapatukira mulirindi lyakabawiti ulamweni.<verse eid="PSA 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16" />Uhalibisiya wakuyi hawumuwuyiri ulamweni,</para>
  <para style="q" vid="PSA 7:16">unkesera wakuyi hawumguwili ulamweni.<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17" />Hanongi mayagashii Mtuwa Mlungu toziya yomberi ndo gwa haki,</para>
  <para style="q" vid="PSA 7:17">hanimwimbili zyuma Mtuwa Mlungu, Mlungu Mkulu.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s">Ukwisa wa Mlungu na ligoya lya Muntu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 8:1" />Gwee Mtuwa Mlungu, Mtuwa gwetu,</para>
  <para style="q" vid="PSA 8:1">ntambu yaliwera liweru litawu lyaku pasipanu poseri!</para>
  <para style="q" vid="PSA 8:1">Gwenga guwutula uweru waku kumpindi!<verse eid="PSA 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2" />Mmilomu ya wana wanonu na yawanona</para>
  <para style="q" vid="PSA 8:2">gulitula liboma, toziya ya wankondu waku,</para>
  <para style="q" vid="PSA 8:2">su kuwatenda yawakulema wanyamali.<verse eid="PSA 8:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3" />Pandola mpindi zyaku, lihengu lya liwoku lyaku,</para>
  <para style="q" vid="PSA 8:3">lyezi na ntondu yaguzituliti pahala pakuyi.<verse eid="PSA 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4" />Muntu ndo gaa, ata gumholi?</para>
  <para style="q" vid="PSA 8:4">Mwana gwa muntu ndo gaa ata gumsheri?<verse eid="PSA 8:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5" />Gumtenda kaweri pakwegera na Mlungu;</para>
  <para style="q" vid="PSA 8:5">gumvalaziya lijenjeri lya manemu na ukwisa;<verse eid="PSA 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6" />gumtenda kakolimlima kila shintu shagunyawiti;</para>
  <para style="q" vid="PSA 8:6">guvituliti viwumbi vyoseri pasi pa ukulu wakuyi,<verse eid="PSA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7" />pamuhera na kondolu na mbuzi, ng'ombi na wakanyama wa mntundu;<verse eid="PSA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8" />wampongu wa kuliyera na wasomba wa bahari,</para>
  <para style="q" vid="PSA 8:8">nakila yashiwera mu bahari.<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9" />Gwee Mtuwa Mlungu, Mtuwa gwetu,</para>
  <para style="q" vid="PSA 8:9">ukulu waku uwoneka pasipanu poseri!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s">Mayagashi kwa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 9:1" />Hanongi mayagashii Mlungu kwa moyu gwangu goseri,</para>
  <para style="q" vid="PSA 9:1">hanigatambiri matendu gaku goseri ga kulikangasha,<verse eid="PSA 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2" />Hanemeleri na kukufyapilira gwenga,</para>
  <para style="q" vid="PSA 9:2">gwee Mlungu Mkulu hanikuzyumi kwa nyimbu.<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3" />Shaka shagulawiriti wankondu wangu wawuya kumbeli,</para>
  <para style="q" vid="PSA 9:3">kulongolu kwaku walikwaliti na kwagamira.<verse eid="PSA 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4" />Gunteteya kulinganira na shilii shantenditi,</para>
  <para style="q" vid="PSA 9:4">gulikala mushiti shaku sha ukulu, pagulaviya toza yahaki.<verse eid="PSA 9:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5" />Gugakalipira maisi,</para>
  <para style="q" vid="PSA 9:5">guwahalibisiya wakontola,</para>
  <para style="q" vid="PSA 9:5">matawu gawu hapagaholwi kayi.<verse eid="PSA 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6" />Wankondu wagamira mashaka goseri,</para>
  <para style="q" vid="PSA 9:6">guyitupulira kutali miji yawu,</para>
  <para style="q" vid="PSA 9:6">ata liholu lyawu lyagamira.<verse eid="PSA 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7" />Kumbiti Mtuwa Mlungu kakolamlima mashaka goseri,</para>
  <para style="q" vid="PSA 9:7">katula shiti shakuyi sha ukulu kapati kutoza.<verse eid="PSA 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8" />Kankupatoza pasipanu kwa haki,</para>
  <para style="q" vid="PSA 9:8">kagaamuwa maisi kwa waminika<verse eid="PSA 9:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9" />Mtuwa Mlungu ndo liboma lya wantu yawawonerwa,</para>
  <para style="q" vid="PSA 9:9">yomberi ndo litugiru shaka sha ntabiku.<verse eid="PSA 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10" />Yawakumana gwenga, Mlungu wakutumbira,</para>
  <para style="q" vid="PSA 9:10">toziya gwenga Mlungu, guwawasandiri yawakusakula.<verse eid="PSA 9:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11" />Mumwimbiri zyuma Mlungu yomberi kakolamlima aku sayuni.</para>
  <para style="q" vid="PSA 9:11">Mgabweleri maisi mirandu yakatenditi,<verse eid="PSA 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12" />toziya Mlungu kawawuzilira shawatenditi walaga,</para>
  <para style="q" vid="PSA 9:12">nakaka kalyaluwandiri kulira kwa wantu yawawonerwa.<verse eid="PSA 9:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13" />Gwee Mtuwa Mlungu gumoneri lusungu!</para>
  <para style="q" vid="PSA 9:13">Guloli ntabiku yantabisiwa na yawankalalira,</para>
  <para style="q" vid="PSA 9:13">gundopoli kulawa mukuhowa,<verse eid="PSA 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14" />su ntambi zyuma zaku kulongolu kwa wantu wa sayuni,</para>
  <para style="q" vid="PSA 9:14">na hanemeleri toziya gundopola.<verse eid="PSA 9:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15" />Wantu wa maisi wapatukira mulirindi lyawabawiti</para>
  <para style="q" vid="PSA 9:15">wagomiziwa magulu gawu mumugomiziwu gwawawufifiti.<verse eid="PSA 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16" />Mtuwa Mlungu kalilanguziya ntambu yakawera, nakutenda toza.</para>
  <para style="q" vid="PSA 9:16">Wantu wakontola wagomiziwa kwa matendu gawu mweni.<verse eid="PSA 9:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17" />Wakontola hawasuluki kuzimu,</para>
  <para style="q" vid="PSA 9:17">vilavirii maisi goseri wambeziya Mlungu.<verse eid="PSA 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18" />Kumbiti wahushu hapeni walwaluwi mashaka goseri,</para>
  <para style="q" vid="PSA 9:18">litumbiru lya wawonerwa hapeni lyagamiri mashaka goseri.<verse eid="PSA 9:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19" />Gugoloki Mlungu!</para>
  <para style="q" vid="PSA 9:19">Nagumleka muntu kakubeziyi!</para>
  <para style="q" vid="PSA 9:19">Gugajojoniri maisi kulongolu kwaku,</para>
  <para style="q" vid="PSA 9:19">gugatozi.<verse eid="PSA 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20" />Mtuwa Mlungu guwatendi walendemeli kwa lyoga,</para>
  <para style="q" vid="PSA 9:20">wantu wa maisi wavimani kuwera womberi ndo wantu hera!<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s">Maluwa gakutenderwa haki</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1" />Gwee Mtuwa Mlungu, hashi gugoloka kutali?</para>
  <para style="q" vid="PSA 10:1">Ntambu gaa gulififa shaka sha ntabiku?<verse eid="PSA 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2" />Kwa mtiti wankontola wawawinda wahushu,</para>
  <para style="q" vid="PSA 10:2">wahushu ndo yawagomiziwa na migomiziwu ya wakontola.<verse eid="PSA 10:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3" />Mkontola kalizyumira shapa shakuyi shidoda,</para>
  <para style="q" vid="PSA 10:3">muntu yakana shapa kapangira na kumlema Mtuwa Mlungu.<verse eid="PSA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4" />Kwa mtiti gwakuyi mkontola kalihola,</para>
  <para style="q" vid="PSA 10:4">Mlungu hapakandeti shoseri.<verse eid="PSA 10:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5" />Njira za mkontola zifanikiwa mashaka goseri,</para>
  <para style="q" vid="PSA 10:5">kwakuyi toza zaku ziwera kutali na maholu gakuyi,</para>
  <para style="q" vid="PSA 10:5">na kawabeziya wankondu wakuyi woseri.<verse eid="PSA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6" />Kalihola mumoyu pakalonga, hapeni ntikinyiki,</para>
  <para style="q" vid="PSA 10:6">hapenintabiki nakamu mukulikala kwangu.<verse eid="PSA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7" />Mlomu gwakuyi gumema pangira, mpaya na vitiliziwu,</para>
  <para style="q" vid="PSA 10:7">nalulimi lwakuyi lulonga visoweru vidoda na ukontola.<verse eid="PSA 10:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8" />Kalififa muvijiji agawu pakalotera,</para>
  <para style="q" vid="PSA 10:8">kamlagi kwa bada muntu yakahera shidoda.</para>
  <para style="q" vid="PSA 10:8">Masu gakuyi gamgwadira muntu yakonda,<verse eid="PSA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9" />kalotera kwa masu gakuyi gambira simba.</para>
  <para style="q" vid="PSA 10:9">Kanyata su kawabati yawahera likakala,</para>
  <para style="q" vid="PSA 10:9">kawagomiziya kwa mgomiziwu gwakuyi na kuwatola.<verse eid="PSA 10:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10" />Yawahera likakala wakangalwa na kugusiwa pasi,</para>
  <para style="q" vid="PSA 10:10">wagomiziwa na muntu mkontola yakana makakala.<verse eid="PSA 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11" />Mkondola kalihola mmoyu mwakuyi, Mlungu kalwaluwa,</para>
  <para style="q" vid="PSA 10:11">kashififa sheni shakuyi, kawonandiri nakamu!<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12" />Gwee Mtuwa Mlungu, gugoloki, guwakomi,</para>
  <para style="q" vid="PSA 10:12">naguwalyaluwa yawatabika.<verse eid="PSA 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13" />Hashi muntu mkontola kambeziya Mlungu,</para>
  <para style="q" vid="PSA 10:13">mumoyu gwakuyi kulitakulira, Mlungu hapenikantozi?<verse eid="PSA 10:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14" />Kumbiti gwenga guziwona ntabiku zyawawonerwa,</para>
  <para style="q" vid="PSA 10:14">nagwenga mashaka goseri gwakala kuwatanga.</para>
  <para style="q" vid="PSA 10:14">Gwee Mlungu, yakahera likakala kakutumbira gwenga,</para>
  <para style="q" vid="PSA 10:14">gwenga guwera mtanga kwa washiwa<verse eid="PSA 10:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15" />Gugamegi makakala ga mkontola na mdoda,</para>
  <para style="q" vid="PSA 10:15">gumkomangi kwa ukontola wakuyi woseri wakatenditi,</para>
  <para style="q" vid="PSA 10:15">Nawuwera kayi.<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16" />Mtuwa Mlungu ndo mfalumi gwa mashaka goseri,</para>
  <para style="q" vid="PSA 10:16">Maisi hagawuki kulawa muisi yakuyi.<verse eid="PSA 10:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17" />Mtuwa Mlungu, gupikanira shawafira wantu yawahera likakala,</para>
  <para style="q" vid="PSA 10:17">guwagangamiziya moyu na kuwapikinira.<verse eid="PSA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18" />Haguwatenderi haki washiwa na yawawonerwa,</para>
  <para style="q" vid="PSA 10:18">su wantu yawawera litapaka nawaweza kayi kujega lyoga.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s">Kumtumbira Mtuwa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 11:1" />Kwakuyi Mtuwa Mlungu ntugira uponera, muwezahashi kung'ambira,</para>
  <para style="q" vid="PSA 11:1">guguluki gambira mpongu,</para>
  <para style="q" vid="PSA 11:1">mpaka kumigongu,<verse eid="PSA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2" />toziya wakontola wanika pindi, watula kala misali mulugoyi,</para>
  <para style="q" vid="PSA 11:2">su wawagumi wantu waheri mluwindu.<verse eid="PSA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3" />Shaka lyanjiru palihalibisiwa,</para>
  <para style="q" vid="PSA 11:3">muntu mwaminika hakatendi shishi?<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4" />Mtuwa Mlungu Kamulihekalu lyakuyi linanagala,</para>
  <para style="q" vid="PSA 11:4">shiti shakuyi sha ukulu sha Mlungu sha kumpindi.</para>
  <para style="q" vid="PSA 11:4">Kwa masu gakuyi kawasungulira wantu,</para>
  <para style="q" vid="PSA 11:4">na kuvimana kila shintu shawatenda<verse eid="PSA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5" />Mtuwa Mlungu kawapima waminika,</para>
  <para style="q" vid="PSA 11:5">kumbiti kwawakalalira wakontola na yawatenda ndewi.<verse eid="PSA 11:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6" />Hakawatoweri wakontola mvula ya makala ga motu na shibiriti,</para>
  <para style="q" vid="PSA 11:6">lyega lya livuki ndo nkomangu yawu.<verse eid="PSA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7" />Mtuwa Mlungu ndo gwa haki na kafira matendu ga haki,</para>
  <para style="q" vid="PSA 11:7">wantu waheri hawalikali pamuhera nayomberi.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s">Kuluwa utanga</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 12:1" />Gwee Mtuwa Mlungu gutendi kalongola kulopola, toziya wantu waheri wapera,</para>
  <para style="q" vid="PSA 12:1">na wantu waminika wagamira muwamu mwa wantu.<verse eid="PSA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2" />Kila yumu kampanyira myaguwi,</para>
  <para style="q" vid="PSA 12:2">kalonga kwa kupaya na kwa moyu gwa ufyanku.<verse eid="PSA 12:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3" />Gwee Mtuwa Mlungu guyinyamaziyi miromu yoseri yayiyowera mpayu,</para>
  <para style="q" vid="PSA 12:3">na kila lulimi lwalulitumba lutakula,<verse eid="PSA 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4" />“Kwa miromu yetu hatukanki,</para>
  <para style="q" vid="PSA 12:4">tuweza kulitumba,</para>
  <para style="q" vid="PSA 12:4">kwahera yakaweza kutukolamlima.”<verse eid="PSA 12:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5" />Kumbiti Mtuwa Mlungu kalonga,</para>
  <para style="q" vid="PSA 12:5">“Toziya wahushu wankuzulumiwa,</para>
  <para style="q" vid="PSA 12:5">na yawafira vintu wankulalama,</para>
  <para style="q" vid="PSA 12:5">vinu niza niwapanani uponera yawahepera niwatangi.”<verse eid="PSA 12:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6" />Visoweru vya Mtuwa Mlungu viherepa,</para>
  <para style="q" vid="PSA 12:6">viherepa gambira madini ga feza yagagululitwi mulitanuli,</para>
  <para style="q" vid="PSA 12:6">yina, handa mpiya yayigululitwi mala saba.<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 12:7" />Gwee Mtuwa Mlungu gutuloleri mashaka goseri</para>
  <para style="q" vid="PSA 12:7">na gutushingi na shiyiwuku ashi sha ukontola.<verse eid="PSA 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 12:8" />Wakontola wankuzyengeta kila pahala,</para>
  <para style="q" vid="PSA 12:8">ukontola wankukwiswa pakati pa wantu.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s">Luwa ya kulopolwa</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 13:1" />Gwee Mtuwa Mlungu mpaka ndii hagundyaluwi? Hashi, hagundyaluwi mashaka goseri?</para>
  <para style="q" vid="PSA 13:1">Mpakandii hagunfifiri sheni shaku?<verse eid="PSA 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2" />Hankosi ponga mpakandii,</para>
  <para style="q" vid="PSA 13:2">hashi hahinginiki mumoyu kila lishaka?</para>
  <para style="q" vid="PSA 13:2">Mpakandii wankondu waneni hawankanki?<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3" />Gwee Mtuwa Mlungu, Mlungu gwangu gundoli na kunankula,</para>
  <para style="q" vid="PSA 13:3">Gugapanani masu gangu kulangala, su nag'onja mpota za kuhowa.<verse eid="PSA 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4" />“Naguwaleka wankondu wangu walongi.</para>
  <para style="q" vid="PSA 13:4">Tumkanka ayu! Walii yawantabisiya neni nawiza kunemelera kuguwa kwangu.”<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5" />Kumbiti neni nizitumbira tanga zaku,</para>
  <para style="q" vid="PSA 13:5">moyu gwanku na gunemeleri ulopola waku.<verse eid="PSA 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6" />Gwee Mtuwa Mlungu hanikwimbiri gwenga,</para>
  <para style="q" vid="PSA 13:6">kwa ukalamuka uvuwa waguntendiriti.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s">Ukontola wa wantu</para>
  <para style="r">
    <ref loc="PSA 53">Zabuli 53</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 14:1" />Mzigizigi kalitakulila mmoyu,</para>
  <para style="q" vid="PSA 14:1">kwahera Mlungu.</para>
  <para style="q" vid="PSA 14:1">Woseri wawera wakontola,</para>
  <para style="q" vid="PSA 14:1">watenda mirandu ya kukalaziya,</para>
  <para style="q" vid="PSA 14:1">kwahera ata yumu yakatenda liheri!<verse eid="PSA 14:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2" />Mtuwa Mlungu Kawalola wantu kulawa kumpindi,</para>
  <para style="q" vid="PSA 14:2">kawoni handa kwana yoseri yakana umani,</para>
  <para style="q" vid="PSA 14:2">yakamsakula Mlungu.<verse eid="PSA 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3" />Kumbiti woseri watenda vidoda,</para>
  <para style="q" vid="PSA 14:3">woseri wapotoka pamuhera,</para>
  <para style="q" vid="PSA 14:3">kwahera yakatenda maheri,</para>
  <para style="q" vid="PSA 14:3">kwahera ata yumu.<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4" />Hashi, woseri yawatenda makontola wavimanandiri shintu?</para>
  <para style="q" vid="PSA 14:4">Wawaliya wantu waneni ntambu yawaliya mabumunda,</para>
  <para style="q" vid="PSA 14:4">pota wanduwandiri neni Mtuwa Mlungu.<verse eid="PSA 14:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5" />Kumbiti hawabatwi na lyoga likulu,</para>
  <para style="q" vid="PSA 14:5">mana Mlungu ka pamuhera na waminika.<verse eid="PSA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6" />Mwenga wantu wadoda mvuluvutira galii wahushu gawafira kutenda,</para>
  <para style="q" vid="PSA 14:6">kumbiti Mtuwa Mlungu ndo ntugira yawu.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7" />Mbaka ukombola wa Israeli meusoki kulawa sayuni. Shaka Mtuwa Mlungu pakawawuziya mpatiru wantu wakuyi,</para>
  <para style="q" vid="PSA 14:7">wiwuka wa Yakobu hawafyapiliri,</para>
  <para style="q" vid="PSA 14:7">Waisraeli hawanemeleri.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s">Shintu shakashifira Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 15:1" />Gwee Mtuwa Mlungu, ndo gaa hakingili muliringu lyaku?</para>
  <para style="q" vid="PSA 15:1">Gaa hakalikali pa lugongu lwaku lunanagala?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2" />Ndo muntu yakalikala pakatenda maheri,</para>
  <para style="q" vid="PSA 15:2">yakatenda yagafiliziwa na Mlungu mashaka goseri,</para>
  <para style="q" vid="PSA 15:2">yakalonga nakaka kulawa mumoyu,<verse eid="PSA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3" />ndo muntu yakampayilandiri yumonga,</para>
  <para style="q" vid="PSA 15:3">yakamtenderandiri ukontola yumonga</para>
  <para style="q" vid="PSA 15:3">pota kumteta yumonga,<verse eid="PSA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4" />muntu yakambeziya muntu mkontola,</para>
  <para style="q" vid="PSA 15:4">kumbiti kawapanana ligoya yawamguwira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 15:4">tembera kalirapa kwa maya gakuyi, Kavigalambulandiri visoweru vyakuyi,<verse eid="PSA 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5" />muntu yakamupandiri mpiya yumonga su kupata nongera,</para>
  <para style="q" vid="PSA 15:5">nakankandiri swinda su kamwimi shakafiruwa kupata yakahera likosa.</para>
  <para style="b" vid="PSA 15:5" />
  <para style="q" vid="PSA 15:5">Muntu yakatenda aga nakaka hapenikatikinyiki.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s">Kuluwa uponera</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 16:1" />Gwee Mlungu gundoleri, mana kwaku ntugira uponera.<verse eid="PSA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2" />Nimgambira Mlungu, gwenga ndo Mtuwa gwangu,</para>
  <para style="q" vid="PSA 16:2">nahera liheri lyoseri ila lyalilawa kwa gwenga.<verse eid="PSA 16:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3" />Mbaka wananagala awa yawawera muisi,</para>
  <para style="q" vid="PSA 16:3">kulikala na womberi ndo nemeru yangu.<verse eid="PSA 16:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4" />Kumbiti yawaguwira wamlungu wamonga,</para>
  <para style="q" vid="PSA 16:4">hawaweri na ntabiku zivuwa. Tambiku ya mwazi hapeniniilaviliri nakamu,</para>
  <para style="q" vid="PSA 16:4">na matawu ga wamlungu awa hapeninigaguwiri.<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5" />Gwee Mtuwa Mlungu, gwenga gwa kila shintu kwaneni,</para>
  <para style="q" vid="PSA 16:5">gundolera na kukolamlima makaliru gangu.<verse eid="PSA 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6" />Gumpanana pahala paherepa,</para>
  <para style="q" vid="PSA 16:6">yina mpata uhala uherepa.<verse eid="PSA 16:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7" />Nimuzyuma Mtuwa Mlungu kwa kunongoziya,</para>
  <para style="q" vid="PSA 16:7">ata pashiru moyu gwangu gunfunda.<verse eid="PSA 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8" />Nimlola Mtuwa Mlungu mashaka goseri,</para>
  <para style="q" vid="PSA 16:8">toziya ka pamuhera na neni, pota kutikinyika.<verse eid="PSA 16:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9" />Hangu hanemeleri na kufyapilira kwa moyu gwangu goseri,</para>
  <para style="q" vid="PSA 16:9">naneni hanilikali kwa ponga,<verse eid="PSA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10" />toziya gwenga hapenigundeki kulisembi,</para>
  <para style="q" vid="PSA 16:10">pota kundeka nagamiri.<verse eid="PSA 16:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11" />Gunanguziya njira ya kufikira ukomu,</para>
  <para style="q" vid="PSA 16:11">kuwera kwaku kumemiziya nemeru ya nakaka,</para>
  <para style="q" vid="PSA 16:11">muliwoku lyaku lya likakala mwanamaheri ga mashaka goseri.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s">Luwa ya muntu mheri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 17:1" />Gwee Mtuwa Mlungu, gupikaniri kuluwa kwaneni kwa haki,</para>
  <para style="q" vid="PSA 17:1">gupikanili kulira kwangu,</para>
  <para style="q" vid="PSA 17:1">guyambili likutu gupikaniri luwa yangu yahera mpayu.<verse eid="PSA 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2" />Haki yaneni ilawi kwa gwenga,</para>
  <para style="q" vid="PSA 17:2">toziya gwenga guvimana mrandu yaguwera gwa teratera.<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3" />Gwenga guvimana nakamu moyu gwangu.</para>
  <para style="q" vid="PSA 17:3">Gunizira pashiru kundolandola na kunjera</para>
  <para style="q" vid="PSA 17:3">kumbiti guwonandiri ukontola mngati mwaneni na</para>
  <para style="q" vid="PSA 17:3">nandulandiri shintu shashifaandiri,<verse eid="PSA 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4" />kwa vitwatira vyawatenda wantu.</para>
  <para style="q" vid="PSA 17:4">Neni nigajimira malagaliru gaku,</para>
  <para style="q" vid="PSA 17:4">nfatandiri njira ya wanamtiti.<verse eid="PSA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5" />Nfata njira yaku mashaka goseri,</para>
  <para style="q" vid="PSA 17:5">pota magulu gangu gakoserandiri njira.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6" />Gwee Mlungu, nikuluwa, toziya gunankulaga,</para>
  <para style="q" vid="PSA 17:6">gunyambili likutu, guvipikiniri visoweru vyangu.<verse eid="PSA 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7" />Gulanguziyi matendu gaku makulu ga kulikangasha,</para>
  <para style="q" vid="PSA 17:7">guwalopoli kulawa kwa wankondu wawu,</para>
  <para style="q" vid="PSA 17:7">wali yawatugira uponera kwa gwenga,<verse eid="PSA 17:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8" />Gundoleri gambira shiligiligi sha lisu,</para>
  <para style="q" vid="PSA 17:8">gunfifi palisisi lya mpapatiru zyaku,<verse eid="PSA 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9" />kulawa mu makomangu ga wakontola,</para>
  <para style="b" vid="PSA 17:9" />
  <para style="q" vid="PSA 17:9">kutali na wankondu waneni yawazyengeta,<verse eid="PSA 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10" />awa wahera lusungu loseri mumoyu, wamema visoweru vya kulidumba.<verse eid="PSA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11" />Wanfata na kunzyengeta,</para>
  <para style="q" vid="PSA 17:11">wangwadira su wangusiyi pasi.<verse eid="PSA 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12" />Wakala kumpapula gambira simba,</para>
  <para style="q" vid="PSA 17:12">handa mwana gwa simba yakagwadira nkanyama.<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13" />Gwee Mtuwa Mlungu, gugoloki gulikomangi nawa na guwakanki,</para>
  <para style="q" vid="PSA 17:13">kwa ligumba lyaku gundopoli kutali na wakontola.<verse eid="PSA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14" />Gwee Mtuwa Mlungu, gundopoli mmawoku mwa wantu awa,</para>
  <para style="q" vid="PSA 17:14">weni mpatiru yawu pasipanu hera.</para>
  <para style="q" vid="PSA 17:14">Wanemeleriti ulunda wawu</para>
  <para style="q" vid="PSA 17:14">mana guwapanana ulunda uvuwa,</para>
  <para style="q" vid="PSA 17:14">weni wawalekera wana wawu</para>
  <para style="q" vid="PSA 17:14">vilavirii hawusigali kwa wazukuru wawu.<verse eid="PSA 17:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15" />Kumbiti neni hanishiwoni sheni shaku, toziya ntenda shashikufiriziya gwenga,</para>
  <para style="q" vid="PSA 17:15">panimuka hamemi nemeru kwa kukuwona.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s">Nyimbu za ukanka wa Daudi</para>
  <para style="r">
    <ref loc="2SA 22:1-51">2 Samweli 22:1-51</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 18:1" />Nikufira gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 18:1">yagumpanana likakala.<verse eid="PSA 18:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2" />Mtuwa Mlungu ndo litalabuhi lyangu,</para>
  <para style="q" vid="PSA 18:2">liboma lyangu na mkombola gwangu,</para>
  <para style="q" vid="PSA 18:2">Mlungu gwangu, litalabuhi lyangu,</para>
  <para style="q" vid="PSA 18:2">kwakuyi ntugira uponera,</para>
  <para style="q" vid="PSA 18:2">lusegeyu lwangu,</para>
  <para style="q" vid="PSA 18:2">yomberi ndo ulopola waneni na liboma lyangu.<verse eid="PSA 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3" />Nimshema Mtuwa Mlungu yakafiruwa zyumwa kantangi,</para>
  <para style="q" vid="PSA 18:3">naneni ndopolwa kulawa kwa wankondu wangu.<verse eid="PSA 18:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4" />Makupala ga mashi yagahowiziya gazyengetiti,</para>
  <para style="q" vid="PSA 18:4">makakala ga mashi gankangaliti.<verse eid="PSA 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5" />Likakala lya kuzimu linzyengetiti,</para>
  <para style="q" vid="PSA 18:5">miyambiru ya kuhowa iweriti kulongolu gwaneni.<verse eid="PSA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6" />Mukutabika kwaneni nimshemiti Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 18:6">nimliliti Mlungu gwangu kantangi.</para>
  <para style="q" vid="PSA 18:6">Kapikiniriti liziwu lyangu kulawa Kuhekalu,</para>
  <para style="q" vid="PSA 18:6">kapikanira shiwembu sha kuluwa utanga.<verse eid="PSA 18:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7" />Pasipanu palendemera na kutikinyika,</para>
  <para style="q" vid="PSA 18:7">miyanjiru ya migongu iwegukaweguka,</para>
  <para style="q" vid="PSA 18:7">toziya Mlungu kaweriti kakalala.<verse eid="PSA 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8" />Lyosi litumiti kulawa mumpula mwakuyi,</para>
  <para style="q" vid="PSA 18:8">motu yagulunguziya gulawa mumulomu mwakuyi,</para>
  <para style="q" vid="PSA 18:8">vilavilii namakala ga motu.<verse eid="PSA 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9" />Kapantiti liyera, kasuluka pasi,</para>
  <para style="q" vid="PSA 18:9">na liwundi lititu pasi pa magulu gakuyi.<verse eid="PSA 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10" />Kakweniti pampindi pa shiwumbi shana mpapatiru kaguluka,</para>
  <para style="q" vid="PSA 18:10">kaguluka kalongola panani pa mpambatiru za lyega.<verse eid="PSA 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11" />Kaligibikiti luwindu,</para>
  <para style="q" vid="PSA 18:11">kalizyengetiriti mawundi gazotopa ga mashi.<verse eid="PSA 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12" />Lumeta lumulikiti kulongolu kwakuyi,</para>
  <para style="q" vid="PSA 18:12">mumawundi kulawira mvula ya mabuwi</para>
  <para style="q" vid="PSA 18:12">na makala ga motu.<verse eid="PSA 18:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13" />Mtuwa Mlungu Kaguguma kulawa kumpindi,</para>
  <para style="q" vid="PSA 18:13">liziwu lya Mlungu yakawera kumpindi nentu lipikinilika.<verse eid="PSA 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14" />Kawagumiti wankondu misali yakuyi kawapalasiya,</para>
  <para style="q" vid="PSA 18:14">kamulikiti lumeta, kawatenda watugi.<verse eid="PSA 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15" />Matiwa ga bahari gavugulwa,</para>
  <para style="q" vid="PSA 18:15">miyanjiru ya pasipanu iwonekana,</para>
  <para style="q" vid="PSA 18:15">toziya ya nguguma yaku ya nkondu,</para>
  <para style="q" vid="PSA 18:15">na toziya ya pumula yaku.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16" />Mtuwa Mlungu katalipisiyiti liwoku lyakuyi kulawa pampindi kantola,</para>
  <para style="q" vid="PSA 18:16">kanyasuliti kulawa mumashi gavuwa.<verse eid="PSA 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17" />Kandopola kulawa kwa wankondu wangu wana likakala livuwa,</para>
  <para style="q" vid="PSA 18:17">kandopola kulawa kwa awa yawankalaliriti,</para>
  <para style="q" vid="PSA 18:17">toziya waweriti na likakala kunkanka.<verse eid="PSA 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18" />Wankomangiti paweriti mkutabika,</para>
  <para style="q" vid="PSA 18:18">kumbiti Mtuwa Mlungu kaweriti mlolera gwangu.<verse eid="PSA 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19" />Kanjegiti na kuntula pahala pa uponera,</para>
  <para style="q" vid="PSA 18:19">kaponiziyiti, toziya kafiriziyitwi naneni.<verse eid="PSA 18:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20" />Mtuwa Mlungu kanfupiti toziya ya uwaminika wangu,</para>
  <para style="q" vid="PSA 18:20">kantekeleriti toziya ntenditi shashifiruwitwi kulongolu kwa Mlungu.<verse eid="PSA 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21" />Toziya nfata njira ya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 18:21">pota kulitula gweka na Mlungu gwangu kwa ukontola.<verse eid="PSA 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22" />Nkola malagaliru gakuyi goseri,</para>
  <para style="q" vid="PSA 18:22">ndekitindiri kufata vyakandagaliriti.<verse eid="PSA 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23" />Kulongolu kwakuyi weritindiri na likosa,</para>
  <para style="q" vid="PSA 18:23">nilishinga nawera na vidoda.<verse eid="PSA 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24" />Mtuwa Mlungu kantuliti weri ntambu ya uwaminika wangu,</para>
  <para style="q" vid="PSA 18:24">yomberi kavimana handa ntenda shashifiruwa kulongolu kwakuyi.<verse eid="PSA 18:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25" />Kwa walii yawawera waminika Gwenga Mlungu gwa mwaminika,</para>
  <para style="q" vid="PSA 18:25">na kwa walii yawahera likosa gwenga gwahera likosa.<verse eid="PSA 18:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26" />Kwa yawawera wananagala gwenga Mlungu gwa mnanagala,</para>
  <para style="q" vid="PSA 18:26">kumbiti yawawera wakontola gwenga guwera mnkesela.<verse eid="PSA 18:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27" />Gwenga guwalopola yawawera wananaga,</para>
  <para style="q" vid="PSA 18:27">kumbiti yawalikweniziya guwasulusiya.<verse eid="PSA 18:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28" />Gwee Mtuwa Mlungu, gumulikira mumoyu mwangu,</para>
  <para style="q" vid="PSA 18:28">gwee Mtuwa Mlungu, Mlungu gwangu guluwusiya luwindu mungati mwangu.<verse eid="PSA 18:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29" />Kwa utanga waku nkomanga shipinga,</para>
  <para style="q" vid="PSA 18:29">gwenga gunupa likakala lya kubomola maboma ga wankondu wangu.<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30" />Matendu gakuyi Mlungu gateratara!</para>
  <para style="q" vid="PSA 18:30">Shakalongiti Mtuwa Mlungu ndo shakwaminika,</para>
  <para style="q" vid="PSA 18:30">yomberi lusegeyu kwa woseri yawamtugira.<verse eid="PSA 18:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31" />Mtuwa gweka yakuyi ndo Mlungu,</para>
  <para style="q" vid="PSA 18:31">Yomberi Mlungu gwetu ndo yakawera litalabuhi lya uponeru,<verse eid="PSA 18:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32" />yomberi ndo yakanupa likakala,</para>
  <para style="q" vid="PSA 18:32">na kuyitenda poneka njira yaneni.<verse eid="PSA 18:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33" />Kagagangamaziya magulu gangu handa ga fyembi,</para>
  <para style="q" vid="PSA 18:33">na kuntula poneka pampindi pa migongu.<verse eid="PSA 18:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34" />Kanfunda kulikomanga nkondu,</para>
  <para style="q" vid="PSA 18:34">mawoku gangu gawezi kunika upindi wa shaba.<verse eid="PSA 18:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35" />Gumpanana lusegeyu lyaku lya kundolera,</para>
  <para style="q" vid="PSA 18:35">liwoku lyaku lya kumliwu lintanga</para>
  <para style="q" vid="PSA 18:35">na kulisulusiya kwaku kuntenda weri mkulu.<verse eid="PSA 18:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36" />Gupanula njira toziya yangu,</para>
  <para style="q" vid="PSA 18:36">magulu gangu nagatyerebuka.<verse eid="PSA 18:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37" />Niwafatiti wankondu wangu na kuwabata,</para>
  <para style="q" vid="PSA 18:37">hapenimbuyi kumbeli mpaka wamaliriki.<verse eid="PSA 18:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38" />Niwakomangiti na wawezandiri kugoloka kayi,</para>
  <para style="q" vid="PSA 18:38">waguwiti pasi pamagulu gangu.<verse eid="PSA 18:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39" />Gwenga gumpananiti likakala lya kulikomanga nkondu,</para>
  <para style="q" vid="PSA 18:39">guwasulusiyiti wankondu pasipangu.<verse eid="PSA 18:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40" />Guwatenditi wankondu wangu watugi,</para>
  <para style="q" vid="PSA 18:40">na walii yawankalaliriti niwalagi.<verse eid="PSA 18:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41" />Wasakuliti gwakuwatanga kumbiti paweritindiri gwa kuwatanga,</para>
  <para style="q" vid="PSA 18:41">wamliliriti Mtuwa Mlungu kumbiti kawankulandiri.<verse eid="PSA 18:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42" />Niwaposhola wawera gambira lidiku,</para>
  <para style="q" vid="PSA 18:42">lyaligulusiwa na lyega.</para>
  <para style="q" vid="PSA 18:42">Niwatimbatimba handa lidiku lya munjira.<verse eid="PSA 18:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43" />Gwenga gundopola na makomangu ga wantu,</para>
  <para style="q" vid="PSA 18:43">guntenda mkolamlima gwa maisi,</para>
  <para style="q" vid="PSA 18:43">wantu yaniwamanandiri wantendiriti.<verse eid="PSA 18:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44" />Katepu pawapikiniriti visoweri vya ukanka wangu wanjimiriti;</para>
  <para style="q" vid="PSA 18:44">wahenga waniziriti pawananaga,<verse eid="PSA 18:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45" />na kutwezuka moyu,</para>
  <para style="q" vid="PSA 18:45">wiza kulawa mumaboma gawu pawalendemera.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46" />Mtuwa Mlungu mkomu! Kazyumwi litalabuhi lya uponeru wangu,</para>
  <para style="q" vid="PSA 18:46">kakwiswi Mlungu gwa ulopola wangu.<verse eid="PSA 18:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47" />Yomberi kantenda mbuziliri shilii sha ntendilitwi,</para>
  <para style="q" vid="PSA 18:47">na kugatenda maisi gaweri pasi pangu.<verse eid="PSA 18:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48" />Kandopola kulawa kwa wankondu wangu,</para>
  <para style="b" vid="PSA 18:48" />
  <para style="q" vid="PSA 18:48">na kunkuliziya pampindi pa wasingani wangu,</para>
  <para style="q" vid="PSA 18:48">na kumponiziya kutali na wantu wankesera.<verse eid="PSA 18:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49" />Hangu hanikukwisi pakati pa maisi,</para>
  <para style="q" vid="PSA 18:49">gwee Mtuwa Mlungu hanikwimbili zyuma,<verse eid="PSA 18:49" /></para>
  <para style="b" />
  <para style="q">
    <verse number="50" style="v" sid="PSA 18:50" />toziya gumpanana mfalumi ukanka mkulu,</para>
  <para style="q" vid="PSA 18:50">nakumlanguziya utanga msyagula gwakuyi,</para>
  <para style="q" vid="PSA 18:50">Daudi na wiwuka wakuyi mashaka goseri.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s">Uweru wa Mlungu muviwumbi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 19:1" />Mpindi zimbwera ukwisa wa Mlungu,</para>
  <para style="q" vid="PSA 19:1">lyera lilanguziya lihengu lya mawoku gakuyi.<verse eid="PSA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2" />Lishaka kwa lishaka lilaviya visoweru,</para>
  <para style="q" vid="PSA 19:2">pashiru papagambira pashiru papiza umani.<verse eid="PSA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3" />Kwahera litakulu ama visoweru vyavitumika,</para>
  <para style="q" vid="PSA 19:3">pota liziwu lyalipikinirika,<verse eid="PSA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4" />Ata hangu,</para>
  <para style="q" vid="PSA 19:4">liziwu lyawu lyeneya pasipanu poseri na visoweru vyawu visoka mpeleru za pasipanu.</para>
  <para style="q" vid="PSA 19:4">Kulyela Mlungu kagutulira mshenji pahala pakuyi pakulikala,<verse eid="PSA 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5" />gweni gulawa handa mpalu gwa ndowa pakalawa mushumba mwakuyi,</para>
  <para style="q" vid="PSA 19:5">handa muntu shikambaku gunemerela kufata njira yakuyi.<verse eid="PSA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6" />Gulawira uwega wumu,</para>
  <para style="q" vid="PSA 19:6">na kuzyengeta mpaka uwega umonga,</para>
  <para style="q" vid="PSA 19:6">kwahera shintu shashiweza kulikwepa livuki lyakuyi.<verse eid="PSA 19:6" /></para>
  <para style="s">Lagiru ya Mtuwa Mlungu</para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7" />Lagiru ya Mtuwa Mlungu ndo ikamilika,</para>
  <para style="q" vid="PSA 19:7">impanana muntu ukomu wasyayi,</para>
  <para style="q" vid="PSA 19:7">malagaliru ga Mtuwa Mlungu ga gagalambukandiri,</para>
  <para style="q" vid="PSA 19:7">gawapanana luhala yawawerandiri na umani.<verse eid="PSA 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8" />Malagaliru ga Mtuwa Mlungu ndo za haki,</para>
  <para style="q" vid="PSA 19:8">inemiziya miyoyu,</para>
  <para style="q" vid="PSA 19:8">lagiru lya Mtuwa Mlungu ijega ulangala,</para>
  <para style="q" vid="PSA 19:8">itenda masu gawoni.<verse eid="PSA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9" />Kumguwira Mtuwa Mlungu ndo mlandu mnanagala,</para>
  <para style="q" vid="PSA 19:9">nagwa mashaka goseri,</para>
  <para style="q" vid="PSA 19:9">malagalira ga Mtuwa Mlungu ndo maheri,</para>
  <para style="q" vid="PSA 19:9">nageni ndo ga haki.<verse eid="PSA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10" />Ya mana kuliku zahabu,</para>
  <para style="q" vid="PSA 19:10">kuliku zahabu iherepa nentu,</para>
  <para style="q" vid="PSA 19:10">inoga kuliku lwashi na</para>
  <para style="q" vid="PSA 19:10">kuliku lisega liherepa.<verse eid="PSA 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11" />Aga ganfunda neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 19:11">kugafata aga kunjegera lifupu likulu.<verse eid="PSA 19:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12" />Kumbiti gaa yakawona makosa gakuyi mweni?</para>
  <para style="q" vid="PSA 19:12">Gwee Mtuwa Mlungu, gundekisiliri makosa yanagamanandiri.<verse eid="PSA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13" />Gushingi neni ntumintumi gwaku nantenda makosa ga ng'anji,</para>
  <para style="q" vid="PSA 19:13">nagujimira aga gankolimlima.</para>
  <para style="q" vid="PSA 19:13">Su nawera na lalama,</para>
  <para style="q" vid="PSA 19:13">pota kuwera na likosa likulu.<verse eid="PSA 19:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14" />Visoweru vya mlomu gwangu,</para>
  <para style="q" vid="PSA 19:14">na maholu ga moyu gwangu gajimiliki kulongolu kwaku,</para>
  <para style="q" vid="PSA 19:14">gwee Mtuwa Mlungu, litalabuhi lyangu na mkombola gwangu!<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s">Kuluwa ukanka</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 20:1" />Mtuwa Mlungu kakwankuli paguwera mkutabika,</para>
  <para style="q" vid="PSA 20:1">litawu lya Mlungu gwa Yakobu likuloleri.<verse eid="PSA 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2" />Kakujegeri utanga kulawa Kuhekalu lyakuwi,</para>
  <para style="q" vid="PSA 20:2">kakutangi kulawa lugongu Sayuni.<verse eid="PSA 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3" />Kaziholi tambiku zaku zoseri</para>
  <para style="q" vid="PSA 20:3">na kazijimiri tambika zaku za kulunguziya.<verse eid="PSA 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4" />Kakupanani gagufira mumoyu mwaku,</para>
  <para style="q" vid="PSA 20:4">nakafanikishi goseri galii gagufira kutenda.<verse eid="PSA 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5" />Hatunemeleri toziya ya ukanka waku,</para>
  <para style="q" vid="PSA 20:5">hatunyasuli bendera kulikwisa litawu lya Mtuwa Mlungu gwetu.</para>
  <para style="q" vid="PSA 20:5">Mlungu kakutenderi goseri galii gagumluwa!<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6" />Vinu nivimana Mtuwa Mlungu hakamtangi mfalumi yakamsyaguliti,</para>
  <para style="q" vid="PSA 20:6">hakamwankuli kulawa pananagala pakuyi kumpindi,</para>
  <para style="q" vid="PSA 20:6">kwa makakala gakuyi hakampanani ukanka mkulu.<verse eid="PSA 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7" />Wamonga walitumbira mbutuka za nkondu na wamonga farasi,</para>
  <para style="q" vid="PSA 20:7">Kumbiti twenga tulitumbira Mtuwa Mlungu, Mlungu gwetu.<verse eid="PSA 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8" />Womberi walikwala na kuguwa,</para>
  <para style="q" vid="PSA 20:8">kumbiti twenga hatwimuki na kugoloka ugangamala.<verse eid="PSA 20:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9" />Mtuwa Mlungu, gumpanani ukanka mfalumi,</para>
  <para style="q" vid="PSA 20:9">gutwankuli shaka patukushema.<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s">Mayagashi kwa ukanka</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 21:1" />Gwee Mtuwa Mlungu mfalumi kankufyapilira, kwa likakala lyaku,</para>
  <para style="q" vid="PSA 21:1">kanemelera nentu kwa ukanka yagumpiti.<verse eid="PSA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2" />Gumtendera shakafiriti mumoyu mwakuyi,</para>
  <para style="q" vid="PSA 21:2">pota kumubelera luwa yakuyi.<verse eid="PSA 21:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3" />Gumwizira, gumpanana ntekerera zivuwa,</para>
  <para style="q" vid="PSA 21:3">gumvalasiya lijenjeri lya zahabu liherepa kumtuyi gwakuyi.<verse eid="PSA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4" />Kakuluwiti ukomu na gwenga gumupa,</para>
  <para style="q" vid="PSA 21:4">gumupiti kulikala mashaka matangala.<verse eid="PSA 21:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5" />Kulawilana na ukanka yagumupiti kakwiswa nentu,</para>
  <para style="q" vid="PSA 21:5">gwenga gumtenda kamaniki na manemu.<verse eid="PSA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6" />Gumpana ntekelera zaku mashaka goseri,</para>
  <para style="q" vid="PSA 21:6">gumnemiziya toziya gwa pamuhera nayu.<verse eid="PSA 21:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 21:7" />Mfalumi kamtumbira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 21:7">toziya ya ufiru mkulu wa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 21:7">hakaweri poneka.<verse eid="PSA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8" />Liwoku lyaku haliwabati wankondu waku woseri,</para>
  <para style="q" vid="PSA 21:8">liwoku lyaku lya kumliwu haliwabati yawakukalalira.<verse eid="PSA 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9" />Pagulawiraku,</para>
  <para style="q" vid="PSA 21:9">haguwagamiziyi handa tanuli lya motu.</para>
  <para style="b" vid="PSA 21:9" />
  <para style="q" vid="PSA 21:9">Mtuwa Mlungu hakawamaliri kwa maya gakuyi,</para>
  <para style="q" vid="PSA 21:9">motu haguwalunguziyi nakamu.<verse eid="PSA 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10" />Haguwagamiziyi wiwuka wawu pasipanu,</para>
  <para style="q" vid="PSA 21:10">wana wawu hapeniwasigali pakati pawantu.<verse eid="PSA 21:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11" />Ata pawapanga makontola kwa gwenga,</para>
  <para style="q" vid="PSA 21:11">na pawatunga mipangu idoda, nakaka hapeni wafanikiwi.<verse eid="PSA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12" />Toziya gwenga haguwagumi misali,</para>
  <para style="q" vid="PSA 21:12">na haguwatendi watugi.<verse eid="PSA 21:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13" />Gwee Mtuwa Mlungu gukwiswi kwa makakala gaku,</para>
  <para style="q" vid="PSA 21:13">na twenga hatwimbi na kuzyuma makakala gaku.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s">Shiwembu na lwimbu lya zyuma</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 22:1" />Mlungu gwangu,</para>
  <para style="q" vid="PSA 22:1">Mlungu gwangu, mbona gundeka?</para>
  <para style="q" vid="PSA 22:1">Mbona gwa kutali nentu kuntanga?</para>
  <para style="q" vid="PSA 22:1">Hashi gupikanilandiri kulira kwangu?<verse eid="PSA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2" />Gwee Mlungu gwangu, ndira paluwala,</para>
  <para style="q" vid="PSA 22:2">kumbiti gunankulandiri,</para>
  <para style="q" vid="PSA 22:2">mbotanga pashiru,</para>
  <para style="q" vid="PSA 22:2">kumbiti nyamalandiri.<verse eid="PSA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3" />Ata hangu, gwenga ndo Mnanagala na gulikala mushiti shikulu,</para>
  <para style="q" vid="PSA 22:3">gwenga guzyumwa na wantu wa Israeli.<verse eid="PSA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4" />Wazewi wa twenga wakutumbiriti gwenga,</para>
  <para style="q" vid="PSA 22:4">wakutumbiliti na gwenga guwalopola.<verse eid="PSA 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5" />Wakuliliriti gwenga, walopolwa,</para>
  <para style="q" vid="PSA 22:5">wakutumbiliti na womberi wasoniziwandiri.<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6" />Kumbiti neni na muntu ndiri,</para>
  <para style="q" vid="PSA 22:6">wamona nashintundiri na wambeziya.<verse eid="PSA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7" />Woseri yawamona wantendera lijonga,</para>
  <para style="q" vid="PSA 22:7">wandokola na kutikisiya mituyi yawu.<verse eid="PSA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8" />“Walonga, kamtumbiriti Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 22:8">Mlungu su kamkomboli!</para>
  <para style="q" vid="PSA 22:8">Handa Mlungu kafiliziwa na yomberi,</para>
  <para style="q" vid="PSA 22:8">su, kamlopoli!”<verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9" />Kumbiti gwenga ndo yagundaviyiti mumtima mwa mawu gwangu,</para>
  <para style="q" vid="PSA 22:9">gunteka poneka pashifuwa sha mawu gwangu.<verse eid="PSA 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10" />Nikutumbiliti kwanjira kwiwuka kwangu.</para>
  <para style="q" vid="PSA 22:10">Kwanjira ndawi mumtima gwa mawu gwangu gwenga guwera Mlungu gwangu<verse eid="PSA 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11" />Nagulikala kutali na neni,</para>
  <para style="q" vid="PSA 22:11">ntabiku yapakwegera,</para>
  <para style="q" vid="PSA 22:11">pota kwahera muntu gwa kuntanga.<verse eid="PSA 22:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12" />Wankondu wavuwa wanzyengeta handa ng'ombi shipalu,</para>
  <para style="q" vid="PSA 22:12">wambabanika handa ng'ombi shipalu wanamakakala kulawa Bashani.<verse eid="PSA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13" />Handa simba yawaguguma pawapapula vyawawinda,</para>
  <para style="q" vid="PSA 22:13">Wasama miromu su wankomangi.<verse eid="PSA 22:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14" />Nitwa handa mashi,</para>
  <para style="q" vid="PSA 22:14">mihonju yaneni yoseri iteguka,</para>
  <para style="q" vid="PSA 22:14">moyu gwangu ndo handa ungombi,</para>
  <para style="q" vid="PSA 22:14">ulumbuka mngati mwaneni.<verse eid="PSA 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15" />Makakala gapera handa shikalangiru,</para>
  <para style="q" vid="PSA 22:15">lulimi lwangu lunamatuka mmulomu gwaneni.</para>
  <para style="q" vid="PSA 22:15">Gundeka mlidikudiku lya kuhowa.<verse eid="PSA 22:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16" />Zyengetwa na shipinga sha wang'ang'a,</para>
  <para style="q" vid="PSA 22:16">lijojoniru lya wakondola lizyengeta,</para>
  <para style="q" vid="PSA 22:16">handa simba wanuma mawoku na magulu.<verse eid="PSA 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17" />Nsigala mihonju hera,</para>
  <para style="q" vid="PSA 22:17">wankondu waneni wandola na kunonganonga.<verse eid="PSA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18" />Wabagulana nguwu zangu,</para>
  <para style="q" vid="PSA 22:18">na kugalambuziya simbi nguwu yangu.<verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19" />Kumbiti gwee Mtuwa Mlungu, nagulikala kutali naneni.</para>
  <para style="q" vid="PSA 22:19">Gwizi kalongola kuntanga.<verse eid="PSA 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20" />Kundopoli neni kutali na ligumba,</para>
  <para style="q" vid="PSA 22:20">gugalopoli makaliru mumikoji mwa wang'ang'a awa!<verse eid="PSA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21" />Gundopoli mmulomu mwa simba,</para>
  <para style="q" vid="PSA 22:21">gundopoli neni kulawa magoli ga nyati awa</para>
  <para style="q" vid="PSA 22:21">gwankula luwa yaneni.<verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22" />Haniwatambili walongu wangu matendu gaku,</para>
  <para style="q" vid="PSA 22:22">hanukuzyumi pakati pa lijojoniru lyawu panonga,<verse eid="PSA 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23" />mwenga yamumguwira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 22:23">mumzyumi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 22:23">mwenga wiwuka woseri wa Yakobu mumpanani ligoya!</para>
  <para style="q" vid="PSA 22:23">Mwenga wiwuka woseri wa Israel Mumguwiri!<verse eid="PSA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24" />Toziya yomberi kawawonandiri shintu yawahera makakala pota kuwabeziya,</para>
  <para style="q" vid="PSA 22:24">na kawafifandiri sheni shakuyi,</para>
  <para style="q" vid="PSA 22:24">kumbiti kawapikinira pawaluwa utanga.<verse eid="PSA 22:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25" />Toziya yaku hanikuzyumi</para>
  <para style="q" vid="PSA 22:25">mulijojonilu likulu lya wantu,</para>
  <para style="q" vid="PSA 22:25">hantendi shanongiti kulongolu kwawu yawakuguwira.<verse eid="PSA 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26" />Wahushu hawaliyi na kwikuta,</para>
  <para style="q" vid="PSA 22:26">yawamsakula Mtuwa Mlungu hawamzyumi.</para>
  <para style="q" vid="PSA 22:26">Mlungu kawapanani kulikala mashaka goseri!<verse eid="PSA 22:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27" />Pasipanu poseri hawammani na</para>
  <para style="q" vid="PSA 22:27">kumwuyira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 22:27">makabila goseri hagamguwiri.<verse eid="PSA 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28" />Toziya Mtuwa Mlungu ndo mfalumi,</para>
  <para style="q" vid="PSA 22:28">na kagakolamlima maisi.<verse eid="PSA 22:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29" />Walunda woseri pasipanu hawizi na kumsuntamali kulongolu kwakuyi,</para>
  <para style="q" vid="PSA 22:29">na woseri yawafuwa hawang'ong'onali kulongolu kwakuyi,</para>
  <para style="q" vid="PSA 22:29">pamuhera na woseri yawawezandiri kuwera na ukomu.<verse eid="PSA 22:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30" />Viyiwuku havimtenderi,</para>
  <para style="q" vid="PSA 22:30">wantu hawavitambiri viyiwuku vyaviza visoweru vya Mtuwa Mlungu.<verse eid="PSA 22:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31" />Wantu weni haweniyiwuki hawagambilwi matendu gakuyi ga ulopola geni,</para>
  <para style="q" vid="PSA 22:31">Mtuwa Mlungu gakatenditi.<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">Mlungu mshungaji Mheri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1" />Mtuwa Mlungu ndo mshugaji gwangu,</para>
  <para style="q" vid="PSA 23:1">hapenimpunguluwi na shintu.<verse eid="PSA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2" />Mumaliwuziwu mawisi kang'onjiziya</para>
  <para style="q" vid="PSA 23:2">kanonguziya mumashi ganyamala.<verse eid="PSA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3" />Kambuzilira makakala na kunonguziya,</para>
  <para style="q" vid="PSA 23:3">munjira za haki toziya ya litawu lyakuyi.<verse eid="PSA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4" />Ata pampita pahala panaluwindu dunyu,</para>
  <para style="q" vid="PSA 23:4">hapenintiri madoda,</para>
  <para style="q" vid="PSA 23:4">toziya gwenga Mtuwa Mlungu gwa pamuhera naneni,</para>
  <para style="q" vid="PSA 23:4">shimbingapinga shaku na luhonga lwaku vindolera.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5" />Guntandira msambu,</para>
  <para style="q" vid="PSA 23:5">Pamasu pa wankondu waneni,</para>
  <para style="q" vid="PSA 23:5">gunswaga lipaki pamtuyi paneni na</para>
  <para style="q" vid="PSA 23:5">shikombi shangu gushimemiziya mpaka kwitika.<verse eid="PSA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6" />Nakaka uheri waku na tanga yaku haviweli pamuhera naneni,</para>
  <para style="q" vid="PSA 23:6">mashaka goseri ga kulikala kwangu na</para>
  <para style="q" vid="PSA 23:6">neni hanilikali ukaya kwa Mtuwa Mlungu mashaka goseri.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s">Mfalumi mkulu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1" />Pasipanu na vyoseri yaviweraamu ndo vyakuyi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 24:1">na woseri yawalikala amu ndo lunda yakuyi.<verse eid="PSA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2" />Toziya yomberi katuliti pasipanu pampindi pa bahari,</para>
  <para style="q" vid="PSA 24:2">kaigolusiyiti gangamala pampindi pa mashi.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3" />Gaa hakakweni kulugongu lwa Mtuwa Mlungu?</para>
  <para style="q" vid="PSA 24:3">Gaa hakalikali muliringu lyakuyi Linanagala?<verse eid="PSA 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4" />Ndo muntu ulii gwa matendu maheri na moyu guherepa,</para>
  <para style="q" vid="PSA 24:4">yakagugendeziyandiri moyu gwakuyi kutenda mirandu ya shizigizigi,</para>
  <para style="q" vid="PSA 24:4">pota kulirapa kwa upaya.<verse eid="PSA 24:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5" />Muntu ayu hakanki ntekelera kulawa kwa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 24:5">nahakapananwi haki kulawa kwa Mlungu mlopola gwakuyi.<verse eid="PSA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6" />Ashi ndo shiyiwuku sha wantu yawamsakula,</para>
  <para style="q" vid="PSA 24:6">yina, wantu yawamsakula Mlungu gwa Yakobu.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7" />Mwee migomi mgulosiyi mituwi yenu,</para>
  <para style="q" vid="PSA 24:7">mgolosiyi mituwi mwee migomi ya makashu,</para>
  <para style="q" vid="PSA 24:7">su mfalumi gwa uweru kingiri.<verse eid="PSA 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8" />Gaa ayu mfalumi gwa uweru?</para>
  <para style="q" vid="PSA 24:8">Ndo Mtuwa Mlungu, kana likakala na uwezu, Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 24:8">yakana uwezu kunkondu.<verse eid="PSA 24:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9" />Mgolosiyi mituwi mwee migomi,</para>
  <para style="q" vid="PSA 24:9">mgolosiyi mituwi mwee migomi ya makashu,</para>
  <para style="q" vid="PSA 24:9">su mfalumi muweru kingiri.<verse eid="PSA 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10" />Ndo gaa ayu Mfalumi muweru?</para>
  <para style="q" vid="PSA 24:10">Ndo Mtuwa Mlungu gwa mashonta,</para>
  <para style="q" vid="PSA 24:10">yomberi ndo Mfalumi gwa uweru.<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s">Kumluwa Mlungu ulonguziya na ulolera</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1" />Gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 25:1">nikulavalira moyu gwangu;<verse eid="PSA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2" />nikutumbira gwenga, gwee Mlungu gwangu,</para>
  <para style="q" vid="PSA 25:2">nagundeka nsoniziki,</para>
  <para style="q" vid="PSA 25:2">wankondu waneni nawanemelera kusinda kwaneni.<verse eid="PSA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3" />Nagumleka yakakutumbira kapati soni,</para>
  <para style="q" vid="PSA 25:3">kumbiti wasoniziwi woseri yawakulema kwang'anji.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4" />Gumaniziyi njira zaku, gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 25:4">gunfundi nfati gagufira.<verse eid="PSA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5" />Gunonguziyi munakaka yaku na kunfunda,</para>
  <para style="q" vid="PSA 25:5">toziya gwenga ndo Mlungu, mlopola gwaneni,</para>
  <para style="q" vid="PSA 25:5">nikutumbira gwenga kila lishaka.<verse eid="PSA 25:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6" />Gwee Mtuwa Mlungu, guliholi lusungu lwaku,</para>
  <para style="q" vid="PSA 25:6">na ufiru waku mkulu, wawuweriti kwanjira makashu.<verse eid="PSA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7" />Naguhola vidoda vya untemba wa neni</para>
  <para style="q" vid="PSA 25:7">na makosa ganeni ga unkesera,</para>
  <para style="q" vid="PSA 25:7">gunholi kulinganira na ufiru waku,</para>
  <para style="q" vid="PSA 25:7">toziya ya uheri waku, gwee Mtuwa Mlungu.<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8" />Mtuwa Mlungu ndo mheri na mwaminika,</para>
  <para style="q" vid="PSA 25:8">hangu kawafunda yawana vidoda njira zakuyi.<verse eid="PSA 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9" />Kawalonguziya wananaga munjira iherepa,</para>
  <para style="q" vid="PSA 25:9">kawafunda awa njira yakuyi.<verse eid="PSA 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10" />Njira zoseri za Mtuwa Mlungu ndo za ufiru na uwaminika,</para>
  <para style="q" vid="PSA 25:10">kwa walii yawakola lipatanu lyakuyi na malagaliru gakuyi.<verse eid="PSA 25:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11" />Gwee Mtuwa Mlungu, toziya ya litawu lyaku,</para>
  <para style="q" vid="PSA 25:11">gundekiziyi shidoda shangu toziya ndo shikulu.<verse eid="PSA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12" />Kila muntu yakamguwira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 25:12">Mlungu hakamfundi njira ya kufata.<verse eid="PSA 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13" />Muntu gwa ntambu ayi hakafanikiwi mashaka goseri</para>
  <para style="q" vid="PSA 25:13">na wiwuka wakuyi hawaihali isi.<verse eid="PSA 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14" />Mtuwa Mlungu kawalongoziya walii yawamtira,</para>
  <para style="q" vid="PSA 25:14">yomberi kawamaniziya awa lipatanu lyakuyi.<verse eid="PSA 25:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15" />Nimlola Mtuwa Mlungu mashaka goseri kantangi,</para>
  <para style="q" vid="PSA 25:15">na hakagawusiyi magulu gangu mumigomiziwu.<verse eid="PSA 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16" />Gundoli, gwee Mtuwa Mlungu gumoneri lusungu,</para>
  <para style="q" vid="PSA 25:16">toziya neni na gweka na ntabisiwa.<verse eid="PSA 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17" />Gumpusiliri magaziwu ga mumoyu mwaneni,</para>
  <para style="q" vid="PSA 25:17">gundopoli kulawa muntabiku zyangu.<verse eid="PSA 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18" />Guloli ngomangu yangu na ntabiku yaneni,</para>
  <para style="q" vid="PSA 25:18">gundekiziyi vidoda vyangu vyoseri.<verse eid="PSA 25:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19" />Guloli ntambu yawawera wavuwa wankondu waneni,</para>
  <para style="q" vid="PSA 25:19">guloli ntambu yawankalalira na kuntenda.<verse eid="PSA 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20" />Gugaloleri makaliru ganeni gundopoli,</para>
  <para style="q" vid="PSA 25:20">nagujimila soniziwi,</para>
  <para style="q" vid="PSA 25:20">toziya ntugila uponeru kwaku.<verse eid="PSA 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21" />Uheri na uwaminika vintulaweri,</para>
  <para style="q" vid="PSA 25:21">toziya nikutumbira gwenga.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22" />Gwee Mlungu, guwalopoli wantu waku Israeli,</para>
  <para style="q" vid="PSA 25:22">guwalopoli mukutabika kwawu koseri.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s">Luwa ya muntu mheri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1" />Gwee Mtuwa Mlungu, gunteteyi,</para>
  <para style="q" vid="PSA 26:1">mana nilikala pota kubodola,</para>
  <para style="q" vid="PSA 26:1">na nikutumbira ulagwenga pota kutira.<verse eid="PSA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2" />Gwee Mtuwa Mlungu, gunjeri na gumpimi,</para>
  <para style="q" vid="PSA 26:2">guloliloli moyu gwangu na maholu gangu.<verse eid="PSA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3" />Mana ufiru waku wa kulongolu kwa masu gangu,</para>
  <para style="q" vid="PSA 26:3">nilikala kulawirana na uwaminika wa gwenga.<verse eid="PSA 26:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4" />Nilikalandiri na wantu yawayowera mpayu,</para>
  <para style="q" vid="PSA 26:4">na ntyangandiri pamuhera na wantu wafyanku.<verse eid="PSA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5" />Nkalalira kuliwona kwa wadoda,</para>
  <para style="q" vid="PSA 26:5">pota hapanilihangi na wakontola.<verse eid="PSA 26:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6" />Nankunaviya mawoku gangu kulanguziya nahera likosa,</para>
  <para style="q" vid="PSA 26:6">na kupazyengeta pakutambikira paku gwee Mtuwa Mlungu,<verse eid="PSA 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7" />su mboti panonga mayagashi,</para>
  <para style="q" vid="PSA 26:7">na kugatambira matendu gaku goseri ga kulikangasha.<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8" />Gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 26:8">nfira makawu gaku,</para>
  <para style="q" vid="PSA 26:8">pahala pawulikala uweru waku.<verse eid="PSA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9" />Nagundaga pamuhera na wanavidoda,</para>
  <para style="q" vid="PSA 26:9">pota nagutola makaliru gangu pamuhera na yawalaga,<verse eid="PSA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10" />wantu weni matendu gawu ndo makontola mashaka goseri,</para>
  <para style="q" vid="PSA 26:10">wantu weni wakala kwanka swinda.<verse eid="PSA 26:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11" />Kumbiti neni nilikala kwa kutenda uheri,</para>
  <para style="q" vid="PSA 26:11">gunkomboli na gumoneri lusungu.<verse eid="PSA 26:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12" />Ngoloka pahala pa uponera,</para>
  <para style="q" vid="PSA 26:12">hanimzyumi Mtuwa Mlungu mulijojoniku likulu.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s">Maluwa ga zyuma</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1" />Mtuwa Mlungu ndo langala yaneni na ulopola wangu,</para>
  <para style="q" vid="PSA 27:1">nimtiri gaa?</para>
  <para style="q" vid="PSA 27:1">Mtuwa Mlungu ndo liboma lya ukomu wangu,</para>
  <para style="q" vid="PSA 27:1">hapeni nimtiri muntu yoseri.<verse eid="PSA 27:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2" />Wakontola pawankomanga na kufira kundaga,</para>
  <para style="q" vid="PSA 27:2">wasinganu na wankondu waneni hawalikwali na kuguwa.<verse eid="PSA 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3" />Ata lishonta palizyengeta,</para>
  <para style="q" vid="PSA 27:3">moyu gwangu hapeni gutiri shintu,</para>
  <para style="q" vid="PSA 27:3">ata pawera na nkondu,</para>
  <para style="q" vid="PSA 27:3">badu nimtumbira Mtuwa.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4" />Mlandu gumu nimluwa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 27:4">na gweni ndo yanigusakula,</para>
  <para style="q" vid="PSA 27:4">nilikala mnumba mwa Mtuwa Mlungu mashaka goseri ga kulikala kwangu,</para>
  <para style="q" vid="PSA 27:4">niwuwoni uherepa wakuyi Mtuwa Mlungu na</para>
  <para style="q" vid="PSA 27:4">kusakula malonguziwu gakuyi Muhekalu lyakuyi.<verse eid="PSA 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5" />Lishaka lya ntabiku hakanfifi munumba mwakuyi,</para>
  <para style="q" vid="PSA 27:5">hakanfifi muliringu lyakuyi,</para>
  <para style="q" vid="PSA 27:5">na hakantuli poneka pa litalambuhi.<verse eid="PSA 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6" />Naneni haniwakanki wankondu wangu yawazyengeta.</para>
  <para style="q" vid="PSA 27:6">Hanimlaviliri tambiku kwa nemeleru Mulihekalu lyakuyi,</para>
  <para style="q" vid="PSA 27:6">hanimbi na kumnemelera Mtuwa Mlungu.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7" />Gwee Mtuwa Mlungu gupikinili, panukulilira,</para>
  <para style="q" vid="PSA 27:7">gumoneri lusungu na gunankula.<verse eid="PSA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8" />Moyu gwangu gung'ambira,</para>
  <para style="q" vid="PSA 27:8">gwizi gumsakuli Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 27:8">su niza kwa gwenga, gwee Mtuwa Mlungu.<verse eid="PSA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9" />Nagushififa sheni shaku,</para>
  <para style="b" vid="PSA 27:9" />
  <para style="q" vid="PSA 27:9">Nagunkalalira na kunema neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 27:9">gwenga guwera mtanga gwangu mashaka goseri;</para>
  <para style="q" vid="PSA 27:9">nagunasa pota kundeka,</para>
  <para style="q" vid="PSA 27:9">gwee Mlungu mlopola gwangu.<verse eid="PSA 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10" />Ata walela waneni pawanasa,</para>
  <para style="q" vid="PSA 27:10">Mtuwa Mlungu hakananki kwakuyi.<verse eid="PSA 27:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11" />Gunfundi njira yaku,</para>
  <para style="q" vid="PSA 27:11">gwee Mtuwa Mlungu, gunonguziyi munjira yayiwera teratera,</para>
  <para style="q" vid="PSA 27:11">toziya ya wankondu waneni.<verse eid="PSA 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12" />Nagundeka wankondu wantendi ntambu yawafira,</para>
  <para style="q" vid="PSA 27:12">toziya wakapitawu wa upayu wafira wantendi,</para>
  <para style="q" vid="PSA 27:12">na womberi walaviya matiriziwu ga unkesera.<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13" />Nivimana kuwera haniwuwoni uheri wakuyi</para>
  <para style="q" vid="PSA 27:13">Mtuwa Mlungu muisi yawalikala wantu wakomu.<verse eid="PSA 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14" />Gumtumbiri Mtuwa Mlungu.</para>
  <para style="q" vid="PSA 27:14">Guweri na moyu, naguwuya kumbeli.</para>
  <para style="q" vid="PSA 27:14">Yina gumtumbiri Mtuwa Mlungu.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s">Luwa ya utanga</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1" />Gwee Mtuwa Mlungu, nikulilira,</para>
  <para style="q" vid="PSA 28:1">Gwenga litalabuhi lya uponera wangu nagulema kumpikanira,</para>
  <para style="q" vid="PSA 28:1">pagumpikinirandiri,</para>
  <para style="q" vid="PSA 28:1">haweli pamuhera na walii yawasuluka kulilindi lya wahowiti.<verse eid="PSA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2" />Gupikinili liziwu lya kuluwa kwangu,</para>
  <para style="q" vid="PSA 28:2">panikulilira guntangi,</para>
  <para style="q" vid="PSA 28:2">panipanyasulira mawoku gangu kulihekalu lyaku linanagala.<verse eid="PSA 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3" />Nagunkomanga pamuhera na wantu wadoda,</para>
  <para style="q" vid="PSA 28:3">walii yawatenda ukontola,</para>
  <para style="q" vid="PSA 28:3">wantu yawatakula na wayawu visoweru vya ponga,</para>
  <para style="q" vid="PSA 28:3">kumbiti mumoyu wamema shuki.<verse eid="PSA 28:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4" />Guwakomangi kulawirana na ntambu yawatenditi,</para>
  <para style="q" vid="PSA 28:4">kugenderana na makontola gawatenditi.</para>
  <para style="q" vid="PSA 28:4">Guwakomangi kulinganira na matendu gawu weni,</para>
  <para style="q" vid="PSA 28:4">guwatenderi galii gawafiluwa kutenderwa.<verse eid="PSA 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5" />Walisherandiri mahengu ga Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 28:5">pota matendu gakatenditi.</para>
  <para style="q" vid="PSA 28:5">Toziya ayi hakawamalili mashaka goseri.<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6" />Kakwiswi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 28:6">toziya kapikinira luwa yangu ya utanga.<verse eid="PSA 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7" />Mtuwa Mlungu kampanan makakala na kandolera,</para>
  <para style="q" vid="PSA 28:7">hanimtumbiru kwa moyu gwangu goseri.</para>
  <para style="q" vid="PSA 28:7">Kandopola na moyu gwangu gumema nemeru,</para>
  <para style="q" vid="PSA 28:7">na hanimwimbili nyimbu za mayagashii.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8" />Mtuwa Mlungu kawapanana makakala wantu wakuyi,</para>
  <para style="q" vid="PSA 28:8">yomberi kamlolera na kumlopola mfalumi yakamsyaguliti.<verse eid="PSA 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9" />Gwee Mtuwa Mlungu, guwalopoli wantu waku,</para>
  <para style="q" vid="PSA 28:9">guwatekeleri wantu awa yawawera isi yaku.</para>
  <para style="q" vid="PSA 28:9">Guweri mshungaji gwawu na guwaloleri mashaka goseri.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s">Liziwu lya Mlungu lyanamakakala</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1" />Mmupanani Mtuwa Mlungumanemu mwenga viwumbi vya kumpindi,</para>
  <para style="q" vid="PSA 29:1">mlongi Mlungu ndo muweru na kana likakala.<verse eid="PSA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2" />Mlongi litawu lya Mtuwa Mlungu ndo liweru.</para>
  <para style="q" vid="PSA 29:2">Mmuguwiri pahala pakuyi pananagala.<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3" />Liziwu lya Mtuwa Mlungu lipikinirika pampindi pa mashi,</para>
  <para style="q" vid="PSA 29:3">Mlungu muweru kaguguma,</para>
  <para style="q" vid="PSA 29:3">liziwu lya Mlungu lipikinirika pampindi pa mashi gavuwa.<verse eid="PSA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4" />Liziwu lya Mtuwa Mlungu lyana likakala,</para>
  <para style="q" vid="PSA 29:4">liziwu lya Mlungu limema uweru.<verse eid="PSA 29:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5" />Liziwu lya Mtuwa Mlungu lipantaga miyelezi,</para>
  <para style="q" vid="PSA 29:5">Mlungu kapanta mielezi ya Lebanoni.<verse eid="PSA 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6" />Kaigulusiyaga migongu ya Lebanoni handa njita,</para>
  <para style="q" vid="PSA 29:6">migongu ya Herimoni handa mwana gwa nyati.<verse eid="PSA 29:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7" />Liziwu lya Mtuwa Mlungu lilaviya meta za motu.<verse eid="PSA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8" />Liziwu lya Mtuwa Mlungu litetemiziya shiwala;</para>
  <para style="q" vid="PSA 29:8">Mtuwa katetemesiya shiwala sha Kadeshi.<verse eid="PSA 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9" />Liziwu lya Mtuwa Mlungu litikisiya mivuli,</para>
  <para style="q" vid="PSA 29:9">lipukutuziya mihambi ya mitera kulidowi</para>
  <para style="q" vid="PSA 29:9">na woseri yawawera Kulihekalu walongi, ukwisa kwa Mlungu!<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10" />Mtuwa Mlungu kakolamlima pampindi pa mashi,</para>
  <para style="q" vid="PSA 29:10">Mlungu ndo mfalumi yakakolamlima mashaka goseri.<verse eid="PSA 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11" />Mtuwa Mlungu kawapanani likakala wantu wakuyi!</para>
  <para style="q" vid="PSA 29:11">Mlungu na kawatekeleri wantu wakuyi kwa ponga!<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s">Luwa ya kulonga mayagashi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 30:1" />Gwee Mtuwa Mlungu nikukwisa, toziya gundopola,</para>
  <para style="q" vid="PSA 30:1">pota guwalekandiri wankondu waneni wanonginongi.<verse eid="PSA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2" />Gwee Mtuwa Mlungu, Mlungu gwangu,</para>
  <para style="q" vid="PSA 30:2">nikuliliriti na gwenga gundopola.<verse eid="PSA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3" />Gwee Mlungu, gundopola kulawa kuzimu,</para>
  <para style="q" vid="PSA 30:3">gundaviya muwamu mwa yawagenda kuzimu,</para>
  <para style="q" vid="PSA 30:3">gunupa kayi ukomu.<verse eid="PSA 30:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4" />Mumwimbiri Mtuwa Mlungu zyuma,</para>
  <para style="q" vid="PSA 30:4">mwee waaminika wakuyi,</para>
  <para style="q" vid="PSA 30:4">mliholi shilii shakatenditi mnanagala na</para>
  <para style="q" vid="PSA 30:4">kulonga mayagashii.<verse eid="PSA 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5" />Maya gakuyi galikala shaka shididini,</para>
  <para style="q" vid="PSA 30:5">ufiru wakuyi ulikala mashaka goseri.</para>
  <para style="q" vid="PSA 30:5">Kulila kuweza kuwera pashiru,</para>
  <para style="q" vid="PSA 30:5">kumbiti mandawira kwiza nemelera.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6" />Neni pamotiti, ntakuliti,</para>
  <para style="q" vid="PSA 30:6">nakaka hapenisindi.<verse eid="PSA 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7" />Gwee Mtuwa Mlungu, guwera mheri kwaneni,</para>
  <para style="q" vid="PSA 30:7">nagungangamaziya handa lugongu lukulu.</para>
  <para style="q" vid="PSA 30:7">Kumbiti pagulififiti,</para>
  <para style="q" vid="PSA 30:7">naneni hinginika mumoyu.<verse eid="PSA 30:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8" />Gwee Mtuwa Mlungu, nikuliliriti gwenga,</para>
  <para style="q" vid="PSA 30:8">nimluwiti Mtuwa Mlungu kantangi.<verse eid="PSA 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9" />Hagupati mota gaa pahowa na kusuluka mpaka kwa yawahowiti?</para>
  <para style="q" vid="PSA 30:9">Hashi, madikudiku ga yawahowiti gaweza kukuzyuma?</para>
  <para style="q" vid="PSA 30:9">Hashi, waweza kutamba uaminika waku?<verse eid="PSA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10" />Gwee Mtuwa Mlungu, gumpikaniri,</para>
  <para style="q" vid="PSA 30:10">gumoneri lusungu na guntangi!<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11" />Gwenga gugalambula madaya ganeni kuwera msambu gwa nemeru,</para>
  <para style="q" vid="PSA 30:11">gumpusilira kwinginika kwangu,</para>
  <para style="q" vid="PSA 30:11">gumemiziya nemeru.<verse eid="PSA 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12" />Neni hanikuzyumi pota kunyamala.</para>
  <para style="q" vid="PSA 30:12">Gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 30:12">Mlungu gwangu,</para>
  <para style="q" vid="PSA 30:12">hanongi mayagashii mashaka goseri.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s">Luwa ya kumtumbira Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 31:1" />Nikutugira gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 31:1">nasoniziwi nakamu,</para>
  <para style="q" vid="PSA 31:1">kwa waminika waku gundopoli.<verse eid="PSA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2" />Gumpikaniri, gundopoli kalongola!</para>
  <para style="q" vid="PSA 31:2">Guweri kwaneni litalabuyi lya uponeru,</para>
  <para style="q" vid="PSA 31:2">guweri liboma ligangamala lya kundopola.<verse eid="PSA 31:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3" />Gwenga ndo litalabuhi lyangu na liboma lyangu,</para>
  <para style="q" vid="PSA 31:3">kwa utanga waku gunonguziya na kundolera.<verse eid="PSA 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4" />Gumbusii mmugomiziwu gwawantegiriti,</para>
  <para style="q" vid="PSA 31:4">toziya gwenga ndo tugira ya uponera waneni.<verse eid="PSA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5" />Mmawoku mwaku ntula rohu yaneni,</para>
  <para style="q" vid="PSA 31:5">gundopoli, gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 31:5">Mlungu mwaminika.<verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6" />Niwakalalira yawaguwira wamlungu wamonga,</para>
  <para style="q" vid="PSA 31:6">ilaneni nikutumbira gwenga Mtuwa Mlungu.<verse eid="PSA 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7" />Hanemeleri na kufyapilira utanga waku,</para>
  <para style="q" vid="PSA 31:7">toziya gwenga guwona utama wangu na ntabika yaneni.<verse eid="PSA 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8" />Gundekandiri mbatwi na wankondu waneni,</para>
  <para style="q" vid="PSA 31:8">gungolusiya pahala pa uponeru.<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9" />Gwee Mtuwa Mlungu gumoneri lusungu,</para>
  <para style="q" vid="PSA 31:9">namuntabisiwu,</para>
  <para style="q" vid="PSA 31:9">masu gangu gatoka kulira,</para>
  <para style="q" vid="PSA 31:9">mperuwa likakala mushimba na murohu.<verse eid="PSA 31:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10" />Makaliru gangu gapera kwa kuhinginika,</para>
  <para style="q" vid="PSA 31:10">navinja vyangu kwa kulalama.</para>
  <para style="q" vid="PSA 31:10">Makakala gangu gapera kwa vidoda,</para>
  <para style="q" vid="PSA 31:10">ata mihonju yangu yahera makakala.<verse eid="PSA 31:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11" />Wankondu woseri waneni wankumbeziya,</para>
  <para style="q" vid="PSA 31:11">ata wapakwegera waneni wamona nashihoja.</para>
  <para style="q" vid="PSA 31:11">Wera tiriziwu kwa waganja waneni,</para>
  <para style="q" vid="PSA 31:11">pawamona munjira wantira.<verse eid="PSA 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 31:12" />Wandwaluwa handa muntu yakahowiti,</para>
  <para style="q" vid="PSA 31:12">wera handa shiwiga shashipandika.<verse eid="PSA 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13" />Mpikinira wantu pawalininitira,</para>
  <para style="q" vid="PSA 31:13">visoweru vyakutiriziya vilawa kila uwega,</para>
  <para style="q" vid="PSA 31:13">wantulira mipangu ya kundaga.<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14" />Gwee Mtuwa Mlungu, kumbiti neni nikutumbira gwenga,</para>
  <para style="q" vid="PSA 31:14">ntakula, gwenga ndo Mlungu gwangu!<verse eid="PSA 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15" />Makaliru gangu gammawoku mwaku,</para>
  <para style="q" vid="PSA 31:15">gundopoli na wankondu waneni,</para>
  <para style="q" vid="PSA 31:15">gundopoli na awa yawansakula.<verse eid="PSA 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16" />Gundoli kwa lusungu neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 31:16">gundopoli kwa utanga waku.<verse eid="PSA 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17" />Gwee Mlungu nagundeka nsoniziwi,</para>
  <para style="q" vid="PSA 31:17">kumbiti guwaleki wakontola wasoniziki,</para>
  <para style="q" vid="PSA 31:17">guwaleki wagendi kuzimu na wanyamali jii.<verse eid="PSA 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18" />Guyinyamaziyi miromu ya wanampayu,</para>
  <para style="q" vid="PSA 31:18">miromu yayiyowera madoda kwa wantu yawatenda maheri,</para>
  <para style="q" vid="PSA 31:18">miromu yayiwera na mtiti na yawaliwona.<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19" />Ntambu yaluwera luvuwa lusungu lwaku,</para>
  <para style="q" vid="PSA 31:19">yaguwatuliliti walii yawakuguwira!</para>
  <para style="q" vid="PSA 31:19">Yawakutugira gwenga</para>
  <para style="q" vid="PSA 31:19">hawapati maheri, wantu woseri pawawona.<verse eid="PSA 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20" />Guwafifa pahala poneka paguwera,</para>
  <para style="q" vid="PSA 31:20">walikala kutali na mipangu midoda ya wantu,</para>
  <para style="q" vid="PSA 31:20">guwatula poneka muulolera waku,</para>
  <para style="q" vid="PSA 31:20">kutali na visoweru vya lusoziya vya wankondu wawu.<verse eid="PSA 31:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21" />Kazyumwi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 31:21">toziya kananguziya utanga wakuyi kwa ntambu ya makangashu,</para>
  <para style="q" vid="PSA 31:21">pazyengetitwi na wankondu.<verse eid="PSA 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22" />Ntiriti na kulishera handa guweriti gunasa,</para>
  <para style="q" vid="PSA 31:22">kumbiti, gupikaniriti kulira kwa neni</para>
  <para style="q" vid="PSA 31:22">panikushemiti guntangi.<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23" />Mmufiri Mtuwa Mlungu, mwenga wananagala wakuyi woseri.</para>
  <para style="q" vid="PSA 31:23">Mtuwa Mlungu kawaloleraga wantu waaminika,</para>
  <para style="q" vid="PSA 31:23">kumbiti kawakomanga nakamu yawanamtiti ntambu yawafiruwa kutendwa.<verse eid="PSA 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24" />Muweri wagangamala na mkamalili,</para>
  <para style="q" vid="PSA 31:24">mwenga yamumtumbira Mtuwa Mlungu.<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s">Kulekeziwa vidoda</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1" />Mbaka yakalekeziwitwi vidoda vyakuyi,</para>
  <para style="q" vid="PSA 32:1">nakuwusilirwa makosa gakuyi.<verse eid="PSA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2" />Mbaka muntu mweni Mtuwa Mlungu kamuwalangirandiri likosa,</para>
  <para style="q" vid="PSA 32:2">mumoyu mwakuyi kahera upayu.<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3" />Shaka paweriti nenetakuli vidoda vyangu,</para>
  <para style="q" vid="PSA 32:3">weriti nonda kwa kulira paluwala poseri.<verse eid="PSA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4" />Paluwala na pashiru gunkomangiti,</para>
  <para style="q" vid="PSA 32:4">likakala lyangu lipeliti,</para>
  <para style="q" vid="PSA 32:4">gambira mangami shaka sha shiyangazi.<verse eid="PSA 32:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5" />Shakapanu ntakuliti vidoda vyangu kwagwenga,</para>
  <para style="q" vid="PSA 32:5">pota niwufifandiri ukontola wangu,</para>
  <para style="q" vid="PSA 32:5">ntakuliti makosa gangu kwaku</para>
  <para style="q" vid="PSA 32:5">nagwenga gundekeziya vidoda vyangu vyoseri.<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6" />Nakaka malawa pagankagalaku hapeni ganfikiri.<verse eid="PSA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7" />Gwee ndo liboma lyangu,</para>
  <para style="q" vid="PSA 32:7">gundolera muntabiku,</para>
  <para style="q" vid="PSA 32:7">gunzegetera nyimbu za kukombolwa.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8" />Mtuwa Mlungu kalonga, hanikufundi na kukulanguziya njira yagufiruwa kufata.</para>
  <para style="q" vid="PSA 32:8">Hanikutakuziyi na kukutula weri.<verse eid="PSA 32:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9" />Naguwera mzigizigi handa farasi ama nyumbu,</para>
  <para style="q" vid="PSA 32:9">weni mpaka watawalilwi lugoyi mumulomu,</para>
  <para style="q" vid="PSA 32:9">ndo wajimiri kulonguziwa.<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10" />Wakontola hawapati ntabika ivuwa,</para>
  <para style="q" vid="PSA 32:10">kumbiti yawamtumbira Mtuwa Mlungu, hawazyengetwi na ufiru wakuyi.<verse eid="PSA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11" />Munemeleri na kufyapilira</para>
  <para style="q" vid="PSA 32:11">toziya ya Mtuwa Mlungu mwenga waminika,</para>
  <para style="q" vid="PSA 32:11">mnemeleri na kufyapiliri mwenga yamuwera na moyu guherepa.<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s">Lwimbu lwa kumzyuma Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1" />Mufyapiri toziya ya Mtuwa Mlungu mwenga yamumtira,</para>
  <para style="q" vid="PSA 33:1">toziya yomberi kafiruwa kuzyumwa na wantu yawamjimira.<verse eid="PSA 33:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2" />Mmuzyumi Mtuwa Mlungu kwa zezi,</para>
  <para style="q" vid="PSA 33:2">mmwimbiri kwa shinubi sha nyuzi lirongu.<verse eid="PSA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3" />Mmwimbiri lwimbu lwasyayi,</para>
  <para style="q" vid="PSA 33:3">mgombi shinubi na kufyapira.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4" />Shisoweru sha Mtuwa Mlungu ndo sha</para>
  <para style="q" vid="PSA 33:4">nakaka na mirandu yakuyi yoseri ndo ya kwaminika.<verse eid="PSA 33:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5" />Mtuwa Mlungu kafira uwaminika na haki,</para>
  <para style="q" vid="PSA 33:5">pasipanu pamema ufiru wa Mlungu.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6" />Mpindi zinyawitwi kwa shisoweru sha Mtuwa Mlungu na</para>
  <para style="q" vid="PSA 33:6">vyoseri yaviwera amu kwa pumla ya mlomu gwakuyi.<verse eid="PSA 33:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7" />Kajojoniriti pamuhera mashi ga bahari,</para>
  <para style="q" vid="PSA 33:7">handa muntu ntambu yakatula mashi muviwiga vikulu.<verse eid="PSA 33:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8" />Pasipanu poseri pamtiri Mlungu!</para>
  <para style="q" vid="PSA 33:8">Woseri yawalikala pasipanu, wampanani ligoya!<verse eid="PSA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9" />Toziya kalongiti, napasipanu pawera,</para>
  <para style="q" vid="PSA 33:9">kalaviyiti lilagaliru na peni palilaviya.<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10" />Mtuwa Mlungu kahalibisiya maholu gawu</para>
  <para style="q" vid="PSA 33:10">na kagagalambula mipangu ya wantu.<verse eid="PSA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11" />Kumbiti shilii Mtuwa Mlungu shakamuwiti kushitenda shilikala mashaka goseri,</para>
  <para style="q" vid="PSA 33:11">mipangu yakuyi ilikala viwuka vyoseri.<verse eid="PSA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12" />Mbaka isi yeni Mlungu gwakuyi ndo Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 33:12">mbaka walii yakawasyaguliti kuwera wantu wakuyi!<verse eid="PSA 33:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13" />Mtuwa Mlungu kalolaga pasi kulawa kumpindi</para>
  <para style="q" vid="PSA 33:13">na kuwona wantu woseri.<verse eid="PSA 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14" />Kulawa kushiti shakuyi sha ukulu,</para>
  <para style="q" vid="PSA 33:14">kawalola woseri yawalikala pasipanu.<verse eid="PSA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15" />Yomberi kayinyawaga miyoyu ya wantu woseri,</para>
  <para style="q" vid="PSA 33:15">yomberi kavimana kila shintu shawatenda.<verse eid="PSA 33:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16" />Mfalumi kawezandiri kukanka toziya kana lishonta likulu.</para>
  <para style="q" vid="PSA 33:16">Pota mgangamala kakankandiri kwa makakala gakuyi gatangala<verse eid="PSA 33:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17" />Farasi gwa nkondu kafaandiri shintu kwa kupata ukanka,</para>
  <para style="q" vid="PSA 33:17">pota makakala gakuyi gavuwa gamlopolandiri muntu.<verse eid="PSA 33:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18" />Mtuwa Mlungu kawalolaga walii yawamguwira,</para>
  <para style="q" vid="PSA 33:18">wantu weni yawatumbira ufiru waku wa mashaka goseri.<verse eid="PSA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19" />Yomberi kawalopolaga mukuhowa,</para>
  <para style="q" vid="PSA 33:19">nakawatula wakomu shaka sha njala.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20" />Miyoyu ya twenga imtubira Mlungu;</para>
  <para style="q" vid="PSA 33:20">yomberi ndo mtanga gwetu na lusegeyu lwatwenga.<verse eid="PSA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21" />Yina tunemelera toziya yakuyi,</para>
  <para style="q" vid="PSA 33:21">twana matumbiru mu litawu lwakuyi linanagala.<verse eid="PSA 33:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22" />Gwee Mtuwa Mlungu ufiru waku yawahera upeleru ulikali natwenga,</para>
  <para style="q" vid="PSA 33:22">mana tukutumbira gwenga.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s">Zyuma kwa uheri wa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 34:1" />Hanongi mayagashii kwa Mtuwa Mlungu vyaka vyoseri,</para>
  <para style="q" vid="PSA 34:1">hapeni ndeki nakamu kuzikanta zyuma zakuyi.<verse eid="PSA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2" />Neni hanilitumbi kwajili ya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 34:2">wanyongi wapikiniri na kunemelera.<verse eid="PSA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3" />Mmukwisi Mtuwa Mlungu pamuhera na neni,</para>
  <para style="q" vid="PSA 34:3">twawoseri pamuhera tulizyumi litawu lyakuyi.<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4" />Nimluwiti Mtuwa Mlungu na yomberi kanankula</para>
  <para style="q" vid="PSA 34:4">na kumpusiya mulyoga lyangu lyoseri.<verse eid="PSA 34:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5" />Yawamtumbira Mlungu wanemeleri;</para>
  <para style="q" vid="PSA 34:5">namwenga hapeni msoniziwi nakamu.<verse eid="PSA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6" />Mhushu kamliliti Mtuwa Mlungu na yomberi kampakinira</para>
  <para style="q" vid="PSA 34:6">na kamlopola muntabika zakuyi zoseri.<verse eid="PSA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7" />Malaika gwa Mtuwa Mlungu kawalolera woseri yawamguwira</para>
  <para style="q" vid="PSA 34:7">na kuwalopola muhatali.<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8" />Mjeri muwoni Mtuwa Mlungu ntambu yakawera mheri,</para>
  <para style="q" vid="PSA 34:8">mbaka muntu yakatugira uponera kwayomberi,<verse eid="PSA 34:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9" />Mmuguwiri Mtuwa Mlungu mwenga wananagala wakuyi,</para>
  <para style="q" vid="PSA 34:9">toziya yawamguwira hapeni wapungukiwi shintu.<verse eid="PSA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10" />Ata wana wa simba wapungukiwa na kuwona njala,</para>
  <para style="q" vid="PSA 34:10">kumbiti yawamsakula Mtuwa Mlungu hapeniwakosi shintu shiheri<verse eid="PSA 34:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11" />Wanawaneni mwizi, mpikiniri,</para>
  <para style="q" vid="PSA 34:11">neni haniwafundi kumguwira Mtuwa Mlungu.<verse eid="PSA 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12" />Hashi, gufira kunemelera makaliru?</para>
  <para style="q" vid="PSA 34:12">Nakulikala makaliru matangala na kunelelera maheri?<verse eid="PSA 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13" />Su, guleki kulonga madoda,</para>
  <para style="q" vid="PSA 34:13">na guleki kulonga mpayu.<verse eid="PSA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14" />Guleki ukontola, gutendi maheri,</para>
  <para style="q" vid="PSA 34:14">gusakuli ponga na kuyitenda.<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15" />Mtuwa Mlungu kawalolaga yawatenda maheri</para>
  <para style="q" vid="PSA 34:15">nakupikinira kulira kwawu,<verse eid="PSA 34:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16" />kumbiti kawasinga wantu yawatenda makontola,</para>
  <para style="q" vid="PSA 34:16">pawahowaku vumu walyaluwika nakamu.<verse eid="PSA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17" />Yawatenda maheri pawamlilira Mtuwa Mlungu yomberi kawapikanira,</para>
  <para style="q" vid="PSA 34:17">na kuwalopola muntabika zawu zoseri.<verse eid="PSA 34:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18" />Mtuwa Mlungu kapakwegera na yawatwezuka moyu,</para>
  <para style="q" vid="PSA 34:18">nakuwalopola wantu wa yawahera litumbiru.<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19" />Ntabiku za muntu mheri ndo zivuwa,</para>
  <para style="q" vid="PSA 34:19">kumbiti Mtuwa Mlungu kamlopola kulawa muntabiku zoseri azi.<verse eid="PSA 34:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20" />Mtuwa Mlungu kavilolera viwungu vya nshimba yakuyi yoseri,</para>
  <para style="q" vid="PSA 34:20">kwahera ata luhonju lwakuyi lumu halumegeki.<verse eid="PSA 34:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21" />Udoda uwajegera wakontola kuhowa,</para>
  <para style="q" vid="PSA 34:21">yawawakalalira yawatenda maheri hawakomangwi.<verse eid="PSA 34:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22" />Mtuwa Mlungu kalopola makaliru ga wantumintumi wakuyi,</para>
  <para style="q" vid="PSA 34:22">woseri yawamtugira hapeni wakomangwi.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s">Luwa ya utanga</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1" />Gwee Mtuwa Mlungu guwasingi awa yawansinga,</para>
  <para style="q" vid="PSA 35:1">guwakomangi awa yawankomanga.<verse eid="PSA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2" />Gutoli lusegeyu lwaku na shingiru gundoleri,</para>
  <para style="q" vid="PSA 35:2">gwizi guntangi.<verse eid="PSA 35:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3" />Gutoli mgoha na janvia yaku toziya ya yawanfata.</para>
  <para style="q" vid="PSA 35:3">Gung'ambili handa hagundopoli.<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4" />Wawoni soni na kusonizika,</para>
  <para style="q" vid="PSA 35:4">awa yawanyatira makaliru gangu!</para>
  <para style="q" vid="PSA 35:4">Wawuziwi kumbeli kwa soni,</para>
  <para style="q" vid="PSA 35:4">awa yawafira kuntendera makontola.<verse eid="PSA 35:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5" />Waweri gambira miwawi yayigulusiwa na liyega,</para>
  <para style="q" vid="PSA 35:5">pawatugiziwa na malaika gwa Mtuwa Mlungu!<verse eid="PSA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6" />Njira yawu iweri ya luwindu, nayayityerebuka,</para>
  <para style="q" vid="PSA 35:6">pawatugiziwa na malaika wa Mtuwa Mlungu!<verse eid="PSA 35:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7" />Pota kutenda shoseri wanyambiriti mgomiziwu,</para>
  <para style="q" vid="PSA 35:7">nawambawiriti lirindi su mpatukili.<verse eid="PSA 35:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8" />Maagamiziya gawapati womberi kwa vumu,</para>
  <para style="q" vid="PSA 35:8">wagomiziwi mumgomiziwu gwawu weni,</para>
  <para style="q" vid="PSA 35:8">wapatukili amu na kwagamira!<verse eid="PSA 35:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9" />Panu neni hanemeleri toziya ya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 35:9">hafyapiliri toziya yomberi kandopola.<verse eid="PSA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10" />Hanimgambiri Mtuwa Mlungu kulawa mumoyu.</para>
  <para style="q" vid="PSA 35:10">“Gwee Mtuwa Mlungu, kwa hera yakawera handa gwenga!</para>
  <para style="q" vid="PSA 35:10">Gwenga guwalopola wanyongi kulawa kwa yawana makakala,</para>
  <para style="q" vid="PSA 35:10">nawahushu na yawahera shinti kulawa mumawoku mwa wapoka.”<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11" />Wantu wakontola walilaviya,</para>
  <para style="q" vid="PSA 35:11">wankumpayira.<verse eid="PSA 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12" />Wandipa madoda kwa maheri na</para>
  <para style="q" vid="PSA 35:12">neni nsigala muushiwa.<verse eid="PSA 35:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13" />Kumbiti womberi pawaweriti walweri,</para>
  <para style="q" vid="PSA 35:13">neni nvaliti mafafa kulanguziya hinginika,</para>
  <para style="q" vid="PSA 35:13">ntabikiti kwa kuleka kuliya.</para>
  <para style="q" vid="PSA 35:13">Nduwiti pawera ng'ong'onaziya mtuwi,<verse eid="PSA 35:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14" />handa vilii nimlilira ganja ama mlongu gwangu.</para>
  <para style="q" vid="PSA 35:14">Handa muntu yakadaya kuhowa kwa mawu gwakuyi.<verse eid="PSA 35:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15" />Kumbiti neni panguwiti wajojonikiti kunonganonga.</para>
  <para style="q" vid="PSA 35:15">Wajojonika pamuhera kunjongera.</para>
  <para style="q" vid="PSA 35:15">Wantu yaniwamandiri wankomangiti pota kuleka,</para>
  <para style="q" vid="PSA 35:15">pota kwahera yakawaleweleriti.<verse eid="PSA 35:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16" />Wajongera na kunigira handa wantu yawammanandiri Mlungu,</para>
  <para style="q" vid="PSA 35:16">wandola na kunkalalira.<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17" />Gwee Mtuwa Mlungu, hagulolihera mpaka ndii?</para>
  <para style="q" vid="PSA 35:17">Gundopoli kulawa mumakomangu gawu,</para>
  <para style="q" vid="PSA 35:17">gugalopoli makaliru gangu na simba awa.<verse eid="PSA 35:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18" />Panu hanongi mayagashi pakati pa lijojoniku likulu lya wantu,</para>
  <para style="q" vid="PSA 35:18">hanikukwisi pakati pa wantu wavuwa.<verse eid="PSA 35:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19" />Naguwaleka wankondu awa wadoda wanonginongi,</para>
  <para style="q" vid="PSA 35:19">awa yawankalalira pota likosa, su wanemeleri ntabika yangu,<verse eid="PSA 35:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20" />Visoweru vyawalonga vya pongandiri,</para>
  <para style="q" vid="PSA 35:20">walonga visoweru vya udoda kwa yawafira ponga.<verse eid="PSA 35:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21" />Wanshitaki kwa liziwu pawalonga,</para>
  <para style="q" vid="PSA 35:21">“Yina! Tugawona twaweni gagutenditi.”<verse eid="PSA 35:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22" />Kumbiti gwenga Mtuwa Mlungu guwona mlandu agu,</para>
  <para style="q" vid="PSA 35:22">nagunyamala, gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 35:22">nagulika kutali naneni.<verse eid="PSA 35:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23" />Gwee Mtuwa Mlungu gugoloki na gunteteyi,</para>
  <para style="q" vid="PSA 35:23">gwizi guloli mirandu yangu.<verse eid="PSA 35:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24" />Gwee Mtuwa Mlungu, Mlungu gwangu gunteteyi,</para>
  <para style="q" vid="PSA 35:24">gutendi teratera na uwaminika waku,</para>
  <para style="q" vid="PSA 35:24">naguwaleka wankondu wangu wanonginongi.<verse eid="PSA 35:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25" />Naguwaleka walilongeri,</para>
  <para style="q" vid="PSA 35:25">Tupata shatufiriti! Ama walongi.</para>
  <para style="q" vid="PSA 35:25">“Tummalira ayu!”<verse eid="PSA 35:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26" />Wasindi woseri na wasoniziwi</para>
  <para style="q" vid="PSA 35:26">awa yawanemelera kutenduwa kwa neni,</para>
  <para style="q" vid="PSA 35:26">wawoni soni na kusonizika.</para>
  <para style="q" vid="PSA 35:26">Awa yawaliwona waheri kuliku neni.<verse eid="PSA 35:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27" />Kumbiti yawafira kuwona kuwera nahera likosa,</para>
  <para style="q" vid="PSA 35:27">wabotangi kwa nemeleru walongi mashaka goseri.</para>
  <para style="q" vid="PSA 35:27">“Mtuwa Mlungu ndo mkulu nentu!</para>
  <para style="q" vid="PSA 35:27">Kafiriziwa na mpatiru za ntumintumi gwakuyi.”<verse eid="PSA 35:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28" />Panu naneni hambweri waminika waku,</para>
  <para style="q" vid="PSA 35:28">hanimbi zyuma zaku paluwala poseri.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s">Ukontola wa muntu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1" />Vidoda viyowera na muntu mkontola, mngati mwa moyu mwakuyi,</para>
  <para style="q" vid="PSA 36:1">mlandu gwa kumguwira Mlungu kwahera nakamu kwakuyi.<verse eid="PSA 36:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2" />Mkontola kalipendeleya mweni,</para>
  <para style="q" vid="PSA 36:2">kalihola handa Mlungu hapeni kavimani na kupangirwa.<verse eid="PSA 36:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3" />Kila shakatakula ndo ukontola na mpayu,</para>
  <para style="q" vid="PSA 36:3">kalisherandiri mirandu ya luhala na kutenda maheri.<verse eid="PSA 36:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4" />Kapanga makontola pakawera mushitanda,</para>
  <para style="q" vid="PSA 36:4">kalitula mumakaliru ga kutenda vidoda,</para>
  <para style="q" vid="PSA 36:4">pota kalekanandiri na ukontola.<verse eid="PSA 36:4" /></para>
  <para style="s">Uheri wa Mlungu</para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 36:5" />Gwee Mtuwa Mlungu ufiru waku wa mashaka goseri ueneya kumpindi,</para>
  <para style="q" vid="PSA 36:5">uaminika waku usoka kumawundi.<verse eid="PSA 36:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6" />Uwaminika waku ndo handa migongu mitali,</para>
  <para style="q" vid="PSA 36:6">toza zaku ndo handa matiwa ga bahari.</para>
  <para style="q" vid="PSA 36:6">Gwee Mtuwa Mlungu, guwaloleri wantu na wankanyama.<verse eid="PSA 36:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7" />Ntambu gaa yawuwera ukulu ufiru waku!</para>
  <para style="q" vid="PSA 36:7">Ata wantu watugira kulisisi lya mbapatiru zaku.<verse eid="PSA 36:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8" />Guwatenda wikuti kwa lunda za numba ya gwenga,</para>
  <para style="q" vid="PSA 36:8">guwalandaziya kulawa lushemba lwa uheri waku.<verse eid="PSA 36:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9" />Gwenga ndo shanjiru sha ukomu,</para>
  <para style="q" vid="PSA 36:9">kwa lulangala lwaku twenga tuwoni.<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10" />Gwendereyi kuwafira walii yawakumana,</para>
  <para style="q" vid="PSA 36:10">gwendeleyi kuwera mheri kwa waaminika.<verse eid="PSA 36:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11" />Nagujimira wanamtiti wankanki,</para>
  <para style="q" vid="PSA 36:11">pota wantu wakontola wantugiziyi.<verse eid="PSA 36:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12" />Guloli yawatenda makontola waguwa,</para>
  <para style="q" vid="PSA 36:12">wagusiwa pasi, wawezandiri kugoloka.<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s">Mpeleru zya wakontola na waheri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1" />Naguyerayera toziya ya ukontola,</para>
  <para style="q" vid="PSA 37:1">naguwawonera weya yawatenda madoda.<verse eid="PSA 37:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2" />Toziya awa hawawuki katepu handa lyasi,</para>
  <para style="q" vid="PSA 37:2">hawanyali kalongola handa vimeru viwisi,<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3" />Gumtumbiri Mtuwa Mlungu na kutenda maheri,</para>
  <para style="q" vid="PSA 37:3">gupati kulikala muisi na kuwera poneka.<verse eid="PSA 37:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4" />Guisakuli nemeru yaku kwa Mtuwa Mlungu na</para>
  <para style="q" vid="PSA 37:4">yomberi hakakupanani gagufira mumoyu mwaku.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5" />Gumpanani Mtuwa Mlungu makaliru gaku,</para>
  <para style="q" vid="PSA 37:5">gumtumbiri yomberi na yomberi hakakutangi.<verse eid="PSA 37:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6" />Hakawutendi uheri waku ung'ering'eti,</para>
  <para style="q" vid="PSA 37:6">na haki yaku ilangali handa mshenji gwa paluwala.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7" />Gukalijii kulongolu kwa Mtuwa Mlungu, gumhepi kwa hepelera,</para>
  <para style="q" vid="PSA 37:7">naguyerayera toziya ya walii yawana mpatiru,</para>
  <para style="q" vid="PSA 37:7">wantu yawafanikiwa mumipangu yawu midoda.<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8" />Gushapili maya pota naguwera na nkalala,</para>
  <para style="q" vid="PSA 37:8">toziya aga gongera udoda.<verse eid="PSA 37:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9" />Wantu yawatenda madoda hawalaguwi,</para>
  <para style="q" vid="PSA 37:9">ila yawamtumbira Mtuwa Mlungu hawahali isi.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10" />Isigala padidini hera, mkontola hapakaweri,</para>
  <para style="q" vid="PSA 37:10">hagumsakuli palii pakaweriti, pota hapeni gumwoni.<verse eid="PSA 37:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11" />Kumbiti wananaga hawayihali isi,</para>
  <para style="q" vid="PSA 37:11">na hawanemeleri uvuwa wa ponga.<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12" />Mkontola katenda mpangu gwa kumtenda muntu mheri,</para>
  <para style="q" vid="PSA 37:12">na kumgayagayira menu kwa nkalaliru;<verse eid="PSA 37:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13" />kumbiti Mtuwa Mlungu kamseka mkontola,</para>
  <para style="q" vid="PSA 37:13">toziya kavimana upeleru wakuyi wapakwegera.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14" />Wakontola wasomola ligumba na kunika pindi zawu,</para>
  <para style="q" vid="PSA 37:14">wapati kuwalaga wahushu na yawahera shintu,</para>
  <para style="q" vid="PSA 37:14">wawalikituli wantu yawalikala kwa kumfiriziya Mlungu,<verse eid="PSA 37:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15" />kumbiti magumba gawu hagawalagi weni,</para>
  <para style="q" vid="PSA 37:15">na pindi zyawu hazimegangwimegangwi.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16" />Mbaka muntu mheri yakana lunda ndidini,</para>
  <para style="q" vid="PSA 37:16">kuliku wantu wakontola yawana lunda zivuwa,<verse eid="PSA 37:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17" />toziya makakala ga wakontola hagamegwi,</para>
  <para style="q" vid="PSA 37:17">kumbiti Mtuwa Mlungu kawatanga wantu waheri.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18" />Mtuwa Mlungu katulaweri makaliru ga wantu waheri,</para>
  <para style="q" vid="PSA 37:18">na uhala wawu hawulikali mashaka goseri.<verse eid="PSA 37:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19" />Hapeniwatabiki pavisoka vyaka vidoda,</para>
  <para style="q" vid="PSA 37:19">mashaka ga njala hawaweli na shiboga shivuwa.<verse eid="PSA 37:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20" />Kumbiti wakontola hawagamiri,</para>
  <para style="q" vid="PSA 37:20">wankondu wa Mtuwa Mlungu hawanyali handa uluwa kuntuntu,</para>
  <para style="q" vid="PSA 37:20">yina hawawuki handa lyosi.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21" />Muntu mkontola katola uwanda pota kuwuziya,</para>
  <para style="q" vid="PSA 37:21">kumbiti muntu mheri kalaviya kwa kukalamuka.<verse eid="PSA 37:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22" />Yawatekeleritwi na Mtuwa Mlungu hawahali isi,</para>
  <para style="q" vid="PSA 37:22">kumbiti yawapangilitwi na yomberi hawalagwi.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23" />Mtuwa Mlungu kazilongoziya njira za muntu,</para>
  <para style="q" vid="PSA 37:23">kalolera maleka ga yakamfiriziya,<verse eid="PSA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24" />ata pakalikwala hapakaguwi,</para>
  <para style="q" vid="PSA 37:24">toziya Mtuwa Mlungu kamtanga.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25" />Weriti mntemba vinu ndo mzewi,</para>
  <para style="q" vid="PSA 37:25">nakaka haneniwoni muntu mheri kalekwa na Mlungu,</para>
  <para style="q" vid="PSA 37:25">ama wana wakuyi pawaluwaluwa shiboga.<verse eid="PSA 37:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26" />Mashaka goseri kawapanana wamonga kwa nemeru na kulaviya uwanda,</para>
  <para style="q" vid="PSA 37:26">na wana wawu hawatekelerwi.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27" />Guleki ukontola, gutendi maheli,</para>
  <para style="q" vid="PSA 37:27">nagwenga hagulikali mashaka goseri,<verse eid="PSA 37:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28" />mana Mtuwa Mlungu kafira haki,</para>
  <para style="q" vid="PSA 37:28">pota hapakawaleki waaminika wakuyi.</para>
  <para style="q" vid="PSA 37:28">Kawalolera awa mashaka goseri,</para>
  <para style="q" vid="PSA 37:28">kumbiti wiwuka wa wakontola hawagamiziwi.<verse eid="PSA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29" />Yawamfiriziya Mlungu hawayihali isi,</para>
  <para style="q" vid="PSA 37:29">na hawalikali amu mashaka goseri.<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30" />Mlomu gwa muheri gulonga visoweru vya luhala,</para>
  <para style="q" vid="PSA 37:30">kwa lulimi lwakuyi kalonga visoweru vya haki.<verse eid="PSA 37:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31" />Lagiru ya Mlungu gwawu yamumoyu mwawu,</para>
  <para style="q" vid="PSA 37:31">na womberi wahera lyoga mmatendu gawu.<verse eid="PSA 37:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32" />Muntu mkontola kamgwadira muntu mheri</para>
  <para style="q" vid="PSA 37:32">nakujera kumlaga,<verse eid="PSA 37:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33" />kumbiti Mlungu kamlekandiri mumawoku mwa mnkondu,</para>
  <para style="q" vid="PSA 37:33">pota kamlekandiri katozwi pawamshitaki.<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34" />Gumtumbiri Mtuwa Mlungu na kukolanjira yakuyi,</para>
  <para style="q" vid="PSA 37:34">na yomberi hakakutendi guyihali isi,</para>
  <para style="q" vid="PSA 37:34">na kuwawona wakontola pawagamiziwa.<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35" />Nimwoniti mkontola mnkesera nentu,</para>
  <para style="q" vid="PSA 37:35">kalitula pampindi pa woseri handa mitera ya mielezi ya Lebanoni,<verse eid="PSA 37:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36" />shakapanu mpititi panu, nayomberi kaweritikayindiri,</para>
  <para style="q" vid="PSA 37:36">nimsakula kumbiti kawonekakayindiri.<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37" />Gumloli muntu mheri, muntu mwaminika,</para>
  <para style="q" vid="PSA 37:37">muntu yakafira ponga kapananwa wiwuka,<verse eid="PSA 37:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38" />kumbiti watenda vidoda woseri hawagamiziwi,</para>
  <para style="q" vid="PSA 37:38">na wiwuka wawu hawulagwi.<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39" />Mtuwa Mlungu kawalopola wantu waheri,</para>
  <para style="q" vid="PSA 37:39">na kuwalolera shaka sha ntabiku.<verse eid="PSA 37:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40" />Mtuwa Mlungu kawatanga na kuwalopola,</para>
  <para style="q" vid="PSA 37:40">kawalaviya mumawoku mwa wakontola na kuwalopola,</para>
  <para style="q" vid="PSA 37:40">mana watugira uponera kwakuyi.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s">Maluwa muntabika</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 38:1" />Gwee Mtuwa Mlungu paguwera na maya nagungalapira,</para>
  <para style="q" vid="PSA 38:1">pota kungomanga kwa ngalaliru yaku.<verse eid="PSA 38:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2" />Mana misali yaku insoma,</para>
  <para style="q" vid="PSA 38:2">liwoku lyaku lintenda.<verse eid="PSA 38:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3" />Kwahera pahala pa mbaka mnshimba yangu,</para>
  <para style="q" vid="PSA 38:3">toziya gunkalalira, ndwala nshimba yoseri mpaka mumihonjhu, toziya ya vidoda vyangu.<verse eid="PSA 38:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4" />Vidoda vyangu vivuwa ng'anji,</para>
  <para style="q" vid="PSA 38:4">vintopera gambira shishanka shizotopa nentu kwa neni.<verse eid="PSA 38:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5" />Vironda vyangu viwola na kununka,</para>
  <para style="q" vid="PSA 38:5">na aga ndo malawiru ga uzigizigi wangu.<verse eid="PSA 38:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6" />Ng'ong'onara na kunanaga,</para>
  <para style="q" vid="PSA 38:6">paluwala poseri pazyengeta na kudaya.<verse eid="PSA 38:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7" />Mgongu gwangu gulwala,</para>
  <para style="q" vid="PSA 38:7">Nshimba yaneni yoseri ilwala.<verse eid="PSA 38:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8" />Nonda na ndeweleka,</para>
  <para style="q" vid="PSA 38:8">hinginika na kushenyiwa mumoyu.<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9" />Gwee Mtuwa Mlungu, gwenga guvimana ntambu yanikutumbila,</para>
  <para style="q" vid="PSA 38:9">kulira kwangu kulififandiri kwaku.<verse eid="PSA 38:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10" />Moyu gwangu gundunda kalongola, makakala gampelera,</para>
  <para style="q" vid="PSA 38:10">ata masu gangu gawonandiri weri.<verse eid="PSA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11" />Waganja wangu washapila toziya ya ntabika yangu,</para>
  <para style="q" vid="PSA 38:11">nakaya yangu wakala kutali naneni.<verse eid="PSA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12" />Yawafira kundaga wanyambira migomiziwu yawu,</para>
  <para style="q" vid="PSA 38:12">yawanfilira ntenduwi wantishiya kundaga.</para>
  <para style="q" vid="PSA 38:12">Paluwala poseri watenda mipangu toziya ya neni.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13" />Kumbiti neni wera handa muntu yakapikinirandiri,</para>
  <para style="q" vid="PSA 38:13">wera handa yakawezandiri kutakula shintu.<verse eid="PSA 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14" />Yina, wera handa muntu yakapikinirandiri,</para>
  <para style="q" vid="PSA 38:14">handa muntu yakawezandiri kuliteteteya.<verse eid="PSA 38:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15" />Kumbiti neni nikutumbira gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 38:15">gwee Mtuwa Mlungu, Mtuwa gwangu, gwenga ndo hagunankuli.<verse eid="PSA 38:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16" />Nikuluwa wankondu nawanonganga,</para>
  <para style="q" vid="PSA 38:16">nawalizyuma kuguwa kwa neni.<verse eid="PSA 38:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17" />Napakwegera kuguwa,</para>
  <para style="q" vid="PSA 38:17">nanautama mashaka goseri.<verse eid="PSA 38:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18" />Nduwa kulekeziwa vidoda,</para>
  <para style="q" vid="PSA 38:18">mana vidoda vyangu vihinginiziya.<verse eid="PSA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19" />Wankondu yawankalalira pota toziya ndo wavuwa,</para>
  <para style="q" vid="PSA 38:19">yawanfirandiri wawalangikandiri.<verse eid="PSA 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20" />Awa yawandipa makontola kwa maheri ganiwatendiriti,</para>
  <para style="q" vid="PSA 38:20">wanema toziya ntenda maheri.<verse eid="PSA 38:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21" />Gwee Mtuwa Mlungu, Mlungu gwangu, nagunasa,</para>
  <para style="q" vid="PSA 38:21">naguwera kutali naneni.<verse eid="PSA 38:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22" />Gwee Mtuwa Mlungu, gwizi kalongola guntangi,</para>
  <para style="q" vid="PSA 38:22">gwenga yaguwera ulopola wangu.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s">Muntu yakalonga ndeka vidoda kwa kutabika</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 39:1" />Nongiti, “Hanigaloleri makaliru gangu,</para>
  <para style="q" vid="PSA 39:1">naniza kutenda vidoda kwa visoweru vyangu.</para>
  <para style="q" vid="PSA 39:1">Hanyamali wakontola pawawera pakwegera naneni.”<verse eid="PSA 39:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2" />Weriti handa bebi, pota kulonga shintu,</para>
  <para style="q" vid="PSA 39:2">nyamaliti kumbiti mpatitindiri mbaka.</para>
  <para style="q" vid="PSA 39:2">Ntabiku yaneni yongelekiti kuwera ikalipa,<verse eid="PSA 39:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3" />Magaziya ganeni ganunguziya mmoyu.</para>
  <para style="q" vid="PSA 39:3">Ntambu yaniliholiti ndo ntambu yantabikiti,</para>
  <para style="q" vid="PSA 39:3">shakapanu visoweru avi vindawa.<verse eid="PSA 39:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4" />“Gwee Mtuwa Mlungu, gung'ambili upeleru wangu,</para>
  <para style="q" vid="PSA 39:4">mashaka gangu ga kulikala gasigala maninga,</para>
  <para style="q" vid="PSA 39:4">nivimani hanilikali vinja vininga.”<verse eid="PSA 39:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5" />Kumbiti gunupa makaliru mafupi nentu!</para>
  <para style="q" vid="PSA 39:5">Makaliru gangu shintundiri kulongolu kwaku.</para>
  <para style="q" vid="PSA 39:5">Nakaka, kila muntu ndo handa lyega hera!<verse eid="PSA 39:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6" />Nakaka, kila muntu kapita handa lisisi,</para>
  <para style="q" vid="PSA 39:6">makakala gakuyi goseri shintundiri,</para>
  <para style="q" vid="PSA 39:6">kajojonira lunda, kavimanandiri gaa hakayitenderi!<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7" />Gwee Mtuwa Mlungu, vinu ndolelera shishi?</para>
  <para style="q" vid="PSA 39:7">Litumbiru lyaneni ndo gwenga!<verse eid="PSA 39:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8" />Gundopoli mumakosa gangu goseri,</para>
  <para style="q" vid="PSA 39:8">nagujimira wazigizigi wantenderi lijonga.<verse eid="PSA 39:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9" />Wera handa muntu, yakatakulandiri shintu,</para>
  <para style="q" vid="PSA 39:9">toziya gwenga ndo yagutenditi aga.<verse eid="PSA 39:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10" />Nagungomanga kayi,</para>
  <para style="q" vid="PSA 39:10">sambira howa kwa makomangu gaku.<verse eid="PSA 39:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11" />Gumkomanga muntu vidoda vyakuyi kwa kumkalapira,</para>
  <para style="q" vid="PSA 39:11">guhalibisiya handa mehi ntambu yakahalibisiya shilii shakafira.</para>
  <para style="q" vid="PSA 39:11">Nakaka, kila wantu ndo handa lyegahera!<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12" />Gwee Mtuwa Mlungu gupikiniri kuluwa kwangu,</para>
  <para style="q" vid="PSA 39:12">gupikaniri kulira kwangu,</para>
  <para style="q" vid="PSA 39:12">nagulikala jii pandira.</para>
  <para style="q" vid="PSA 39:12">Mana neni handa mhengahera yakapita,</para>
  <para style="q" vid="PSA 39:12">ntambu yawaweriti wazewi waneni woseri.<verse eid="PSA 39:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13" />Shondi gundeki su nemeleri shididini,</para>
  <para style="q" vid="PSA 39:13">pamberi hanenihowi na kwagamira nakamu.<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s">Lwimbu lwa kulonga mayagashii</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 40:1" />Nimheperiti Mtuwa Mlungu kwa uhepelera,</para>
  <para style="q" vid="PSA 40:1">yomberi kapikinira kulira kwangu.<verse eid="PSA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2" />Kambusiyiti mulilindi lya mbulagu,</para>
  <para style="q" vid="PSA 40:2">kandaviyiti mumadika ga kutyerebuka,</para>
  <para style="q" vid="PSA 40:2">kang'olosiya poneka pampindi pa litalabuhi</para>
  <para style="q" vid="PSA 40:2">na kugangamaziya maleka gangu.<verse eid="PSA 40:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3" />Kanfunditi lwimbu lwasyayi,</para>
  <para style="q" vid="PSA 40:3">lwimbu lwa zyuma kwa Mlungu gwetu.</para>
  <para style="q" vid="PSA 40:3">Wavuwa hawawoni na kutira na kumtumbira Mtuwa Mlungu.<verse eid="PSA 40:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4" />Mbaka muntu yakamtumbira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 40:4">muntu yakawatumbirandiri wantu yawaliwona,</para>
  <para style="q" vid="PSA 40:4">pota wantu yawayowera mpayu.<verse eid="PSA 40:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5" />Gwee Mtuwa Mlungu, Mlungu gwangu, gutenda mirandu ivuwa yayiwalangikandiri,</para>
  <para style="q" vid="PSA 40:5">gutenda mirandu yakulikangasha kwa twenga, kwahera yakaweza kuyilewelera.</para>
  <para style="q" vid="PSA 40:5">Hambweri na kuyitakula,</para>
  <para style="q" vid="PSA 40:5">kumbiti gavuwa nentu kugatambira.<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6" />Gwenga gufiriziwitindiri na tambiku na malaviwu,</para>
  <para style="q" vid="PSA 40:6">tambika za kulunguziya wankanyama pota za kuwusiya vidoda guzifirandiri,</para>
  <para style="q" vid="PSA 40:6">kumbiti gunupa makutu nikupikiniri.<verse eid="PSA 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7" />Shakapanu ntakuliti, “Nakala,</para>
  <para style="q" vid="PSA 40:7">kugatenda yagalembitwi mushitabu sha lagiru,<verse eid="PSA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8" />Gwee Mtuwa Mlungu,Mlungu gwangu, kutenda mafiru gaku, ndo nemeleru yaneni,</para>
  <para style="q" vid="PSA 40:8">lagiru yaku niyikola kwa moyu gwangu goseri!”<verse eid="PSA 40:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9" />Ntamba visoweru viheri vya ukombola,</para>
  <para style="q" vid="PSA 40:9">kulongolu kwa lijojoniku likulu lya wantu.</para>
  <para style="q" vid="PSA 40:9">Ntambu yaguvimana gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 40:9">neni nililewelerandiri kuvibwera visoweru vyaku.<verse eid="PSA 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10" />Ndekandiri kutakula mirandu yaku ya haki,</para>
  <para style="q" vid="PSA 40:10">mbwera mashaka goseri kuwera gwenga ndo mlopola mwaminika,</para>
  <para style="q" vid="PSA 40:10">niligambiriti lijojoniku likulu lya wantu visoweru vya uheri waku na waminika waku.<verse eid="PSA 40:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11" />Gwee Mtuwa Mlungu, naguleka kumonera lusungu lwaku!</para>
  <para style="q" vid="PSA 40:11">Ufiru waku na uwaminika waku vintula weri mashaka goseri.<verse eid="PSA 40:11" /></para>
  <para style="s">Maluwa ga kuluwa utanga</para>
  <para style="r">
    <ref loc="PSA 70">Zabuli 70</ref></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12" />Zyengetwa na ntabiku zaziwalangikandiri,</para>
  <para style="q" vid="PSA 40:12">makontola gangu gangibikira ata wezandiri kuwona,</para>
  <para style="q" vid="PSA 40:12">ndogavuwa kuliku mvili kumtuwi gwangu,</para>
  <para style="q" vid="PSA 40:12">naneni twezukamoyu.<verse eid="PSA 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13" />Gwee Mtuwa Mlungu nikuluwa gundopoli,</para>
  <para style="q" vid="PSA 40:13">gwizi kalongola kuntanga.<verse eid="PSA 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14" />Yawafira kundaga waweri na soni na wasoniziwi!</para>
  <para style="q" vid="PSA 40:14">Awa yawafira ntenduwi,</para>
  <para style="q" vid="PSA 40:14">wawuyi kumbeli na kusonizika.<verse eid="PSA 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15" />“Awa yawanonganga</para>
  <para style="q" vid="PSA 40:15">na wasoniziki kwa kusinda kwawu.”<verse eid="PSA 40:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16" />Kumbiti woseri walii yawakusakula wanemeleri</para>
  <para style="q" vid="PSA 40:16">na kufyapilira toziya ya gwenga.</para>
  <para style="q" vid="PSA 40:16">Yawafira ulopola waku,</para>
  <para style="q" vid="PSA 40:16">walongi mashaka goseri, “Mtuwa Mlungu ndo Mkulu!”<verse eid="PSA 40:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17" />Gwee Mtuwa Mlungu neni namhushu na nahera shintu,</para>
  <para style="q" vid="PSA 40:17">kumbiti gwenga guntulaweri.</para>
  <para style="q" vid="PSA 40:17">Gwenga ndo utanga wangu na mlopola gwangu,</para>
  <para style="q" vid="PSA 40:17">gwizi, nagukawira!<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s">Maluwa mu ulweri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 41:1" />Mbaka muntu yakashera wahushu,</para>
  <para style="q" vid="PSA 41:1">Mtuwa Mlungu hakamlopoli shaka sha ntabiku.<verse eid="PSA 41:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2" />Mtuwa Mlungu hakamloleri</para>
  <para style="q" vid="PSA 41:2">na kumtula mkomu na yomberi hakaweri na mpatiru muisi,</para>
  <para style="q" vid="PSA 41:2">Mlungu hapakamleki mumawoku mwa wankondu wakuyi.<verse eid="PSA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3" />Mtuwa Mlungu hakamtangi pakawera mlweri</para>
  <para style="q" vid="PSA 41:3">hakamponiziyi malweri gakuyi goseri.<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4" />Naneni ntakuliti “Guntangi,</para>
  <para style="q" vid="PSA 41:4">gwee Mtuwa Mlungu, gumoneri lusungu toziya nikutenda vidoda.”<verse eid="PSA 41:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5" />Wankondu wangu watakulaga vidoda kwaneni,</para>
  <para style="q" vid="PSA 41:5">“Hakahowindii na litawu lyakuyi naliwerakayi!”<verse eid="PSA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6" />Pawantyangira walonga visoweru vyahera mpatiru kwaneni,</para>
  <para style="q" vid="PSA 41:6">wampikanira su wapati visoweru vya ulweri wangu,</para>
  <para style="q" vid="PSA 41:6">pawasoka kunja wawabwelera wamonga.<verse eid="PSA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7" />Woseri yawankalalira walininitira toziya ya neni,</para>
  <para style="q" vid="PSA 41:7">wafira madoda gampati.<verse eid="PSA 41:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8" />Walonga, “Malweri aga hagamlagi,</para>
  <para style="q" vid="PSA 41:8">pashitanda palii hapenikaponi kayi!”<verse eid="PSA 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9" />Ata ganja gwangu gwakumoyu yanimwaminiti,</para>
  <para style="q" vid="PSA 41:9">yakaliyiti shiboga pamuhera naneni,</para>
  <para style="q" vid="PSA 41:9">kangalambuka kunkomanga!<verse eid="PSA 41:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10" />Gwee Mtuwa Mlungu, gumoneri lusungu! Gumponiziyi,</para>
  <para style="q" vid="PSA 41:10">su neni niwawuziliri shawantendiriti.<verse eid="PSA 41:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11" />Panu hanivimani handa gufiriziwa naneni,</para>
  <para style="q" vid="PSA 41:11">wankondu wangu pawankankandiri.<verse eid="PSA 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12" />Gwenga guntanga toziya ntenda maheri,</para>
  <para style="q" vid="PSA 41:12">guntula kulongolu kwaku mashaka goseri.<verse eid="PSA 41:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13" />Kazyumwi Mtuwa, Mlungu, Mlungu gwa Israeli,</para>
  <para style="q" vid="PSA 41:13">mashaka goseri!</para>
  <para style="b" vid="PSA 41:13">Yinahaa! Yinahaa!<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">SHITABU SHA PILI</para>
  <para style="mr">
    <ref loc="PSA 42-72">Zabuli 42-72</ref></para>
  <para style="s">Maluwa ga muntu yakawera muuhamisiwu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 42:1" />Handa mbawala ntambu yakanahamu na mashi ga shishemba,</para>
  <para style="q" vid="PSA 42:1">ndontambu yananahamu na gwee Mlungu gwangu!<verse eid="PSA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2" />Nanahamu kuwera pakwegera na Mlungu, Mlungu yakawera mkomu.</para>
  <para style="q" vid="PSA 42:2">Hansokindii kwakuyi na kumwona kayi?<verse eid="PSA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3" />Masozi gawera shiboga shangu paluwala na pashiru,</para>
  <para style="q" vid="PSA 42:3">pawang'ambiriti kila lishaka,</para>
  <para style="q" vid="PSA 42:3">“Kakoshi Mlungu gwaku?”<verse eid="PSA 42:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4" />Nilihola kayi mirandu ayi kwa hinginika momuyu mwaneni,</para>
  <para style="q" vid="PSA 42:4">ntambu yaweriti na wantu wavuwa, paniwalonguziya kugenda ukaya kwa Mlungu</para>
  <para style="q" vid="PSA 42:4">pawataga nsheka za mayagashi,</para>
  <para style="q" vid="PSA 42:4">wantu wavuwa pawatenda msambu gunanagala!<verse eid="PSA 42:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5" />Mbona hinginika hangu mmoyu?</para>
  <para style="q" vid="PSA 42:5">Ntambu gaa moyu gwangu gwankugazika?</para>
  <para style="q" vid="PSA 42:5">Hanimtimbili Mtuwa Mlungu, mana hanimkwisi kayi,</para>
  <para style="q" vid="PSA 42:5">yomberi yakawera mtanga gwangu</para>
  <para style="q" vid="PSA 42:5">na Mlungu gwangu.<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 42:6" />Nshenyiwa na hinginika mmoyu mwangu,</para>
  <para style="q" vid="PSA 42:6">hangu hanikuholi gwenga,</para>
  <para style="q" vid="PSA 42:6">gwee Mtuwa Mlungu, kulawa aku Yoridani,</para>
  <para style="q" vid="PSA 42:6">kulawa aku lugongu Herimoni na Mizari.<verse eid="PSA 42:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 42:7" />Lushemba lwana mashi gagenda lushema lumonga, mpikanira liziwu lya mbutu zyaku zya mashi</para>
  <para style="q" vid="PSA 42:7">malawa gaku na makupala gaku ga mashi gandibiziya.<verse eid="PSA 42:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8" />Mtuwa Mlungu hakananguziyi ufiru wakuyi paluwala,</para>
  <para style="q" vid="PSA 42:8">naneni nimwimbiri lwimbu lwa zyuma pashiru,</para>
  <para style="q" vid="PSA 42:8">nimluwi Mlungu gwa ukomu.<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9" />Nimgambira Mlungu, litalabuhi lyangu,</para>
  <para style="q" vid="PSA 42:9">“Mbona gundyaluwa?</para>
  <para style="q" vid="PSA 42:9">Hashi ng'endi aku na aku pandaya</para>
  <para style="q" vid="PSA 42:9">kwa kuwonelwa na wankondu wangu?”<verse eid="PSA 42:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10" />Ntendwa na mahigiranga gawu,</para>
  <para style="q" vid="PSA 42:10">pawankosiya kila lishaka,</para>
  <para style="q" vid="PSA 42:10">“Kakoshi, Mlungu gwaku?”<verse eid="PSA 42:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11" />Mbona hinginika hangu mmoyu?</para>
  <para style="q" vid="PSA 42:11">Ntambu gaa moyu gwangu gwankugazika?</para>
  <para style="q" vid="PSA 42:11">Hanimtimbili Mtuwa Mlungu, mana hanimkwisi kayi,</para>
  <para style="q" vid="PSA 42:11">yomberi yakawera mtanga gwangu</para>
  <para style="q" vid="PSA 42:11">na Mlungu gwangu.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s">Luwa ya ukombolwa</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1" />Gwee Mlungu gunanguziyi handa nahera likosa,</para>
  <para style="q" vid="PSA 43:1">gunteteyi mushitwatila ashi kwa wantu wadoda,</para>
  <para style="q" vid="PSA 43:1">gundopoli na wantu wanampayu na wakontola.<verse eid="PSA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2" />Ntugira uponera kwa gwenga gwee Mlungu,</para>
  <para style="q" vid="PSA 43:2">ntambu gaa gunasira kutali?</para>
  <para style="q" vid="PSA 43:2">Su ng'endi ugawu na ugawa pandaya</para>
  <para style="q" vid="PSA 43:2">kwa kuwonerwa na wankondu wangu?<verse eid="PSA 43:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3" />Gunjegeli uweru wa gwenga na unakaka gwenga vinonguziyi,</para>
  <para style="q" vid="PSA 43:3">gunjegeli kulugongu lwaku lunanaga,</para>
  <para style="q" vid="PSA 43:3">pahala paku pa kulikala.<verse eid="PSA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4" />Panu, gwee Mlungu, hang'endi pakutambikira paku,</para>
  <para style="q" vid="PSA 43:4">hanizi kwa gwenga, gwee Mlungu, kwa nemeru nkulu.</para>
  <para style="q" vid="PSA 43:4">Hanikuzyumi kwa zezi,</para>
  <para style="q" vid="PSA 43:4">gwee Mlungu, Mlungu gwangu.<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5" />Mbona hinginika hangu mmoyu?</para>
  <para style="q" vid="PSA 43:5">Ntambu gaa moyu gwangu gwankugazika?</para>
  <para style="q" vid="PSA 43:5">Hanimtimbili Mtuwa Mlungu, mana hanimkwisi kayi,</para>
  <para style="q" vid="PSA 43:5">yomberi yakawera mtanga gwangu</para>
  <para style="q" vid="PSA 43:5">na Mlungu gwangu.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s">Kuluwa ulolera wa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 44:1" />Gwee Mlungu, tupikinira kwa makutu getu</para>
  <para style="q" vid="PSA 44:1">Wazewi wetu watutambira,</para>
  <para style="q" vid="PSA 44:1">mirandu yaguyitenditi mashaka gawu</para>
  <para style="q1" vid="PSA 44:1">yina, mirandu yagutenditi makashu.<verse eid="PSA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2" />Kwa liwoku lyaku mweni guwawingiti maisi gamonga</para>
  <para style="q" vid="PSA 44:2">na pahala pawu guwatula wantu waku,</para>
  <para style="q" vid="PSA 44:2">gugakomangiti maisi gamonga,</para>
  <para style="q" vid="PSA 44:2">na kuwapanana mpatiru wantu waku.<verse eid="PSA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3" />Wantu waku wayitolandiri isi kwa mgowa gwawu,</para>
  <para style="q" vid="PSA 44:3">pota kupata ukanka kwa makakala gawu,</para>
  <para style="q" vid="PSA 44:3">ila guwaponiziyiti kwa makakala gaku na uwezu waku na kujimirwa kwawu,</para>
  <para style="q" vid="PSA 44:3">kwa kuwawalira sheni shaku,</para>
  <para style="q" vid="PSA 44:3">toziya gwenga guwafiriti.<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4" />Gwenga ndo mfalumi gwangu na Mlungu gwangu!</para>
  <para style="q" vid="PSA 44:4">Guwapanana ukanka wiwuka wa Yakobu.<verse eid="PSA 44:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5" />Kwa likakala lyaku twawakanka wankondu wetu,</para>
  <para style="q" vid="PSA 44:5">na kwa uwezu waku tuwatimbanga yawatulema.<verse eid="PSA 44:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6" />Neni niutumbirandiri upindi wangu</para>
  <para style="q" vid="PSA 44:6">pota ligumba lyangu liwezandiri kundopola;<verse eid="PSA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7" />kumbiti gwenga gutulopoliti na wankondu wetu,</para>
  <para style="q" vid="PSA 44:7">guwavulugiti walii yawatukalaliliti.<verse eid="PSA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8" />Mashaka goseri hatukuzyumi, gwee Mlungu,</para>
  <para style="q" vid="PSA 44:8">hatulongi mayagashi mashaka goseri.<verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9" />Kumbiti vinu gutuleka na kutusoniziya,</para>
  <para style="q" vid="PSA 44:9">gugendandiri kayi pamuhera na mashonta getu.<verse eid="PSA 44:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10" />Gututenda tuwatili wankondu wetu,</para>
  <para style="q" vid="PSA 44:10">na womberi wazilopola lunda zetu.<verse eid="PSA 44:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11" />Gututenda gambira kondolu yawajegwa kulikitulwa,</para>
  <para style="q" vid="PSA 44:11">gutupalasiya pakati pa maisi gamonga.<verse eid="PSA 44:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12" />Guwashuwuza wantu waku kwa beyi ndidini,</para>
  <para style="q" vid="PSA 44:12">pota kukosilila kupata shikulu.<verse eid="PSA 44:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13" />Gututenda kuwera lijonga kwa wapakwegera wetu,</para>
  <para style="q" vid="PSA 44:13">na womberi watujongeri na kutuseka.<verse eid="PSA 44:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14" />Gututenda tubeziwi na wantu wa maisi,</para>
  <para style="q" vid="PSA 44:14">wahenga wankutikisiya mituwi yawu kwa kutubeziya.<verse eid="PSA 44:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15" />Paluwala poseri wera na fezeya,</para>
  <para style="q" vid="PSA 44:15">nasheni shangu shimema soni nentu,<verse eid="PSA 44:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16" />kulawilana na kupikanira beziya yawu na mahigirangu,</para>
  <para style="q" vid="PSA 44:16">kwa kulikoma na wankondu wangu yawambuzilira.<verse eid="PSA 44:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17" />Goseri aga gatupata twenga,</para>
  <para style="q" vid="PSA 44:17">tembera twenikulyaluwi</para>
  <para style="q" vid="PSA 44:17">pota hatweni megi lipatanu lyaku. <verse eid="PSA 44:17" /><verse number="18" style="v" sid="PSA 44:18" />Tulekandiri kuwera waaminika kwa gwenga,</para>
  <para style="q" vid="PSA 44:18">pota kuzileka njira zaku.<verse eid="PSA 44:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19" />Ata hangu gutuleka pota kututanga pakati pa wamamihi,</para>
  <para style="q" vid="PSA 44:19">viraa gutuleka muluwindu lukulu.<verse eid="PSA 44:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20" />Metuweri tukulyaluwa gwenga Mlungu gwetu</para>
  <para style="q" vid="PSA 44:20">metumutugiri mlungu gwa mpayu,<verse eid="PSA 44:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21" />gwee Mlungu guvimani kala mlandu agu,</para>
  <para style="q" vid="PSA 44:21">toziya gwenga guzimana bada za mmoyu.<verse eid="PSA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22" />Kumbiti toziya yaku sambira tuhowa kila lishaka</para>
  <para style="q" vid="PSA 44:22">tutenderwa handa wakondolu yawajengwa kulikitulwa.<verse eid="PSA 44:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23" />Gwee Mtuwa gwimuki! Mbona gugonja?</para>
  <para style="q" vid="PSA 44:23">Shondi! Gugoloki nagutwasa mashaka goseri!<verse eid="PSA 44:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24" />Mbona gulififa kutali na twenga?</para>
  <para style="q" vid="PSA 44:24">Na kulyaluwa uhushu na ntabika ya twenga!<verse eid="PSA 44:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25" />Tusuntamala mpaka mlidikudiku,</para>
  <para style="q" vid="PSA 44:25">tulinatila na litapaka.<verse eid="PSA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26" />Shondi! Gugoloki gwizi kututanga!</para>
  <para style="q" vid="PSA 44:26">Gutulopoli toziya ya ufiru waku.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s">Lwimbu lwa shifalumi lwa ndowa</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 45:1" />Moyu gwangu gumema maholu maheri.</para>
  <para style="q" vid="PSA 45:1">Nimtungira mfalumi lwimbu awu,</para>
  <para style="q" vid="PSA 45:1">lulimi lwangu ndo handa kalamu ya mlemba yakamanika nentu.<verse eid="PSA 45:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2" />Gwee guherepa kuliku wantu woseri,</para>
  <para style="q" vid="PSA 45:2">visoweru vyaku ndo zyuma hera.</para>
  <para style="q" vid="PSA 45:2">Hangu Mlungu kakutekelera mashaka goseri.<verse eid="PSA 45:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3" />Gulitawi ligumba lyaku, gwee mgangamala!</para>
  <para style="q" vid="PSA 45:3">Gwenga ndo muweru na yagwana ukulu.<verse eid="PSA 45:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4" />Ukulu waku uweneyi na guweri mkanka,</para>
  <para style="q" vid="PSA 45:4">paguwera gukwena farasi gulanguziyi visoweru vya mirandu ya nakaka unanaga pamuhera na haki.</para>
  <para style="q" vid="PSA 45:4">Kwa liwoku lyaku lya kumliwu gulanguziyi matendu ga kuligangasha.<verse eid="PSA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5" />Misali yaku ikalipa,</para>
  <para style="q" vid="PSA 45:5">ipena mumiyoyu ya wankondu wa mfalumi,</para>
  <para style="q" vid="PSA 45:5">na maisi gaguwa pasi paku.<verse eid="PSA 45:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6" />Gwee Mlungu shiti sha ufalumi waku sha mashaka goseri</para>
  <para style="q" vid="PSA 45:6">luhonga lwaku lulikala mashaka goseri</para>
  <para style="q" vid="PSA 45:6">gwenga gukolamlima wantu waku kwa haki.<verse eid="PSA 45:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7" />Gufira uwaminika na kukalalira ukontola,</para>
  <para style="q" vid="PSA 45:7">hangu Mlungu, Mlungu gwaku kakusyagula</para>
  <para style="q" vid="PSA 45:7">na kukwitira lipaki lya nemeru kuliku wayagu.<verse eid="PSA 45:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8" />Nguwu zaku zinunkira utuli na udi,</para>
  <para style="q" vid="PSA 45:8">yawimba wankukunemiziya munumba za magoli ga ntembu.<verse eid="PSA 45:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9" />Wahinga wa Wafalumi ndowamu yawadala yawakwanka,</para>
  <para style="q" vid="PSA 45:9">na malikia kagoloka kumliwu kwaku,</para>
  <para style="q" vid="PSA 45:9">kavala maherepizia ga zahabu iherepa ya ofiri.<verse eid="PSA 45:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10" />Gupikani weri mhinga, guliholi, guyambiki likutu lyaku,</para>
  <para style="q" vid="PSA 45:10">vinu gulyaluwi wantu waku na walongu waku.<verse eid="PSA 45:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11" />Uherepa waku umkwegegiziya mfalumi,</para>
  <para style="q" vid="PSA 45:11">yomberi ndo mtuwa gwaku gufiruwa kumjimira.<verse eid="PSA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12" />Mhinga Tiru hawakujegeri mafupu,</para>
  <para style="q" vid="PSA 45:12">walunda hawafiri upendelewu waku.<verse eid="PSA 45:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13" />Mhinga gwa mfalumi kankwingira kaherepa nentu!</para>
  <para style="q" vid="PSA 45:13">Nguwu yakuyi ipotwa kwa ubunta wa zahabu.<verse eid="PSA 45:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14" />Pakawera kavalira nguwu ya rangi zivuwa, kajegwa kwa mfalumi,</para>
  <para style="q" vid="PSA 45:14">pakagenda pamuhera na wali wayaguyi,</para>
  <para style="q" vid="PSA 45:14">na womberi viraa wajegwa kwa mfalumi.<verse eid="PSA 45:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15" />Kwa kunemelera na kufyapila wankusoka aku</para>
  <para style="q" vid="PSA 45:15">na kwingira munumba ya mfalumi.<verse eid="PSA 45:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16" />Gwee mfalumi hagupati wana wavuwa</para>
  <para style="q" vid="PSA 45:16">hawakolimlima pahala pa wazewi waku</para>
  <para style="q" vid="PSA 45:16">haguwatendi wakolimlima pasipanu poseri.<verse eid="PSA 45:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17" />Hanilitendi litawu lyaku liholwi viyiwuku vyoseri,</para>
  <para style="q" vid="PSA 45:17">na maisi hagakuzyumi mashaka goseri.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s">Mlungu ka uwega wetu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 46:1" />Mlungu ndo tugira yetu na likakala lyetu,</para>
  <para style="q" vid="PSA 46:1">yomberi ndo mtanga gwetu gwa pakwegera mashaka goseri ga kutabika.<verse eid="PSA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2" />Hangu hapeni tutiri shintu ata pasipanu papatikinyika</para>
  <para style="q" vid="PSA 46:2">na vigongu pavilendemera pakati pa bahali,<verse eid="PSA 46:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3" />ata bahari payiliputa na kutiliziya,</para>
  <para style="q" vid="PSA 46:3">na migongu ilendemera kwa makomangu gakuyi.<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4" />Kwana lushemba lwalujega nemeru kumji gwa Mlungu,</para>
  <para style="q" vid="PSA 46:4">kaya nanagala yakawera kumpindi.<verse eid="PSA 46:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5" />Mlungu kamulushi alu na lweni hapeni lutikinyilwi,</para>
  <para style="q" vid="PSA 46:5">Mlungu hakalupanani utanga mandawira putiputi.<verse eid="PSA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6" />Maisi gatira nentu na kolamlima zyangutikinyika,</para>
  <para style="q" vid="PSA 46:6">Mlungu kaguguma na pasipanu palumbujuka.<verse eid="PSA 46:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7" />Mtuwa gwa mashonta kapamuhera na twenga,</para>
  <para style="q" vid="PSA 46:7">Mlungu gwa Yakobu ndo mlolera gwa twenga<verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8" />Mwizi mloli matendu ga Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 46:8">muwoni makangashu gakatenditi pasipanu.<verse eid="PSA 46:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9" />Kamalira nkondu zoseri pasipanu,</para>
  <para style="q" vid="PSA 46:9">kamegamega upindi na mgoha,</para>
  <para style="q" vid="PSA 46:9">kalunguziya lusegeyu kwa motu.<verse eid="PSA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10" />Kalonga. “Mnyamali” “na kuvimana handa neni ndo Mlungu!</para>
  <para style="q" vid="PSA 46:10">Neni hanyasulwi pakati pa maisi goseri,</para>
  <para style="q" vid="PSA 46:10">neni nkwiswa pasipanu poseri!”<verse eid="PSA 46:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11" />Mtuwa Mlungu gwa mashonta ka pamuhera na twenga,</para>
  <para style="q" vid="PSA 46:11">Mlungu gwa Yakobu ndo tugira ya twenga.<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s">Mlungu, Mfalumi gwa pasipanu poseri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 47:1" />Mwenga wantu woseri mkomi mapopu, mumzyumi Mlungu kwa kufyapira!<verse eid="PSA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2" />Mana Mtuwa Mlungu, Mlungu Mkulu, katiliziya,</para>
  <para style="q" vid="PSA 47:2">toziya yomberi ndo Mfalumi mkulu gwa pasipanu poseri.<verse eid="PSA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3" />Katutenda kuwakanka wantu wa maisi gamonga,</para>
  <para style="q" vid="PSA 47:3">katutenda tukolimlima isi zimonga.<verse eid="PSA 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4" />Katusyagulira isi ayi iweri uhala wetu,</para>
  <para style="q" vid="PSA 47:4">isi yakalitumbira Yakobu yakamfira.<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5" />Mtuwa Mlungu kakwena mushiti shakuyi sha ukulu pakafyapilirwa,</para>
  <para style="q" vid="PSA 47:5">Mtuwa kagenda mushiti shakuyi sha ukolamlim a pakagomberwa lipenka.<verse eid="PSA 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6" />Mumwimbiri Mlungu zyuma, mumwimbiri!</para>
  <para style="q" vid="PSA 47:6">Mumwimbiri mfalumi gwetu zyuma mumwimbiri!<verse eid="PSA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7" />Toziya yomberi ndo mfalumi gwa pasipanu poseri,</para>
  <para style="q" vid="PSA 47:7">mumwimbili lwimbu lwa zyuma,<verse eid="PSA 47:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8" />Mlungu kagakolamlima maisi goseri,</para>
  <para style="q" vid="PSA 47:8">kakala mushiti shakuyi sha ukulu shinanagala.<verse eid="PSA 47:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9" />Walongoziya wa maisi gamonga wankujojonika,</para>
  <para style="q" vid="PSA 47:9">pamuhera na wantu wa Mlungu gwa Abrahamu,</para>
  <para style="q" vid="PSA 47:9">toziya yomberi kanamakakala kuliku wakulu wa pasipanu poseri,</para>
  <para style="q" vid="PSA 47:9">yomberi kakwiswa nentu.<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s">Sayuni mji gwa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 48:1" />Mtuwa Mlungu, ndo mkulu, kafiruwa kuzyumwa nentu</para>
  <para style="q" vid="PSA 48:1">kumji gwa Mlungu gwetu, mulugongu lwakuyi lunanagala.<verse eid="PSA 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2" />Sayuni ndo lugongu lutali na guherepa,</para>
  <para style="q" vid="PSA 48:2">shanjiru sha nemeleru pasipanu poseri.</para>
  <para style="q" vid="PSA 48:2">Lugongu Sayuni gulifana na migongu ya Zafoni,</para>
  <para style="q" vid="PSA 48:2">ndo mji mkulu gwa mfalumi mkulu nentu.<verse eid="PSA 48:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3" />Mlungu ndo liboma lyakuyi,</para>
  <para style="q" vid="PSA 48:3">yomberi kalilanguziya kuwera mlolera gwakuyi.<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4" />Wafalumi wajojonikiti,</para>
  <para style="q" vid="PSA 48:4">wagenda pamuhera kukomanga.<verse eid="PSA 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5" />Kumbiti pawaguwoniti, walikangasha,</para>
  <para style="q" vid="PSA 48:5">wawera na lyoga, watuga mbiru.<verse eid="PSA 48:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6" />Lyoga likulu liwakola,</para>
  <para style="q" vid="PSA 48:6">wapikinira kutama handa mawu yakalera,<verse eid="PSA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7" />guwahalibisiyi handa virii meli za Tarishishi,</para>
  <para style="q" vid="PSA 48:7">zazimegangwa na lyega lya kwagulawa mshenji.<verse eid="PSA 48:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8" />Ntambu yatupikiniriti, ndo ntambu yatuwoniti,</para>
  <para style="q" vid="PSA 48:8">mumji gwa Mtuwa Mlungu yakana makakala,</para>
  <para style="q" vid="PSA 48:8">Mlungu hakagugangamiziyi mashaka goseri.<verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9" />Mulihekalu lyaku</para>
  <para style="q" vid="PSA 48:9">Gwee Mlungu, tuwuholera ufiru waku.<verse eid="PSA 48:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10" />Gwee Mtuwa Litawu lyaku ntambu ya lizyumika kila pahala,</para>
  <para style="q" vid="PSA 48:10">zyuma zaku zipalasiwa poseri pasipanu.</para>
  <para style="q" vid="PSA 48:10">Kwa mawoku gaku gutenda haki,<verse eid="PSA 48:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11" />lugongu Sayuni lunemelera!</para>
  <para style="q" vid="PSA 48:11">Isi ya Yuda ifyapilira,</para>
  <para style="q" vid="PSA 48:11">toziya ya haki yaku!<verse eid="PSA 48:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12" />Mtyangi aku Sayuni mkaguzyengeti,</para>
  <para style="q" vid="PSA 48:12">mkaviwalangi vindwalingu vyakuyi.<verse eid="PSA 48:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13" />Mviloli vibambaza vyakuyi,</para>
  <para style="q" vid="PSA 48:13">na kulolalola maboma gakuyi,</para>
  <para style="q" vid="PSA 48:13">mpati kuvitambira viyiwuku vyaviza handa,<verse eid="PSA 48:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14" />ayu ndo Mlungu, Mlungu gwetu mashaka goseri,</para>
  <para style="q" vid="PSA 48:14">hakaweri mlonguziya gwetu mashaka goseri<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s">Uzigizigi wa kutumbira lunda</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 49:1" />Mpikaniri mlandu agu mwenga wantu woseri!</para>
  <para style="q" vid="PSA 49:1">Myambiri likutu mwenga yamlikala pasipanu,<verse eid="PSA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2" />mpikiniri mwawoseri, wakulu kwa wapusu,</para>
  <para style="q" vid="PSA 49:2">walunda na wantu wahushu kwa pamuhera.<verse eid="PSA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3" />Hayoweri visoweru vya luhala,</para>
  <para style="q" vid="PSA 49:3">hantakuli visoweru vya mahala.<verse eid="PSA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4" />Hanyambili likutu kupikinira mesali,</para>
  <para style="q" vid="PSA 49:4">na hantakuliliri shitendawiri kwakutendera zezi.<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5" />Ntambu gaa ntiri shaka shamadoda,</para>
  <para style="q" vid="PSA 49:5">panzengetwa na ukontola wa wankondu?<verse eid="PSA 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6" />Wantu wakontola watumbira lunda zawu</para>
  <para style="q" vid="PSA 49:6">walizyuma uvuwa wa ulunda wawu.<verse eid="PSA 49:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7" />Kumbiti kwahera muntu yakaweza kukombola makaliru ga yumonga,</para>
  <para style="q" vid="PSA 49:7">ama kumlipa Mlungu hazilila ya ukomu wakuyi,<verse eid="PSA 49:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8" />mana hazilira ya makaliru ga muntu ndo makulu nentu.</para>
  <para style="q" vid="PSA 49:8">Kawezandiri kulaviya shintu shoseri shashitosheya,<verse eid="PSA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9" />nashimtendi kendeleyi kulikala mashaka goseri,</para>
  <para style="q" vid="PSA 49:9">nakahowa.<verse eid="PSA 49:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10" />Yomberi kamanandiri kuwera ata yakana luhala kahowa,</para>
  <para style="q" vid="PSA 49:10">viraa wangalimahala na wazigizigi wagamira.</para>
  <para style="q" vid="PSA 49:10">Woseri awa wawalekera wantu wamonga lunda zawu.<verse eid="PSA 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11" />Masembi ndo mahala pawu pakulikala ata mashaka goseri</para>
  <para style="q" vid="PSA 49:11">ndo pahala pawu pakulika viyiwuku vyoseri,</para>
  <para style="q" vid="PSA 49:11">tembera panu kwanja waweriti na malambu gawu weni.<verse eid="PSA 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12" />Ata muntu pakawera na ligoya ntambu gaa,</para>
  <para style="q" vid="PSA 49:12">hakahowi hera handa nkanyama.<verse eid="PSA 49:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13" />Awu ndo upeleru wa wazigizigi,</para>
  <para style="q" vid="PSA 49:13">na yawawafata na kujimira visoweru vyawu.<verse eid="PSA 49:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14" />Hawalonguziwi handa kondolu mpaka kuzimu,</para>
  <para style="q" vid="PSA 49:14">kuhowa hakuweri mshugaji gwawu.</para>
  <para style="q" vid="PSA 49:14">Wantu yawamguwira Mlungu hawawakolimlima mandawira,</para>
  <para style="q" vid="PSA 49:14">nshimba zawu haziwoleri aku,</para>
  <para style="q" vid="PSA 49:14">na hapeni walikali munumba zyawu zazihelepa.<verse eid="PSA 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15" />Nakaka Mlungu hakalopoli makaliru gangu,</para>
  <para style="q" vid="PSA 49:15">Hakankomboli kulawa aku kuzimu.<verse eid="PSA 49:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16" />Naguligaziya paguwona muntu kalunda,</para>
  <para style="q" vid="PSA 49:16">pota lunda yakuyi payiyongereka nentu na nentu,<verse eid="PSA 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17" />mana pakahowa hapenikatoli shoseri,</para>
  <para style="q" vid="PSA 49:17">lunda yakuyi hapeni isuluki pasi pamuhera na yomberi.<verse eid="PSA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18" />Ata pakalikulaziya mumakaliru aga</para>
  <para style="q" vid="PSA 49:18">nakuzyumirwa toziya ya kuwera na mpatiru,<verse eid="PSA 49:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19" />hakaweri pamuhera na wazewi yawamlongoleriti kuhowa,</para>
  <para style="q" vid="PSA 49:19">weni hapeni wawezi kayikuwona gulangala.<verse eid="PSA 49:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20" />Muntu yakapananwa ligoya kumbiti kahera mahala,</para>
  <para style="q" vid="PSA 49:20">ndo handa kanyama yakatenduwa.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s">Guwira ya nakaka</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1" />Mlungu gwa likakala, Mtuwa Mlungu, kalonga,</para>
  <para style="q" vid="PSA 50:1">kawashema yawalikala pasipanu,</para>
  <para style="q" vid="PSA 50:1">kulawa kwagulawa mshenji mpaka kwaguzyeta.<verse eid="PSA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2" />Kulawa Sayuni,</para>
  <para style="q" vid="PSA 50:2">lushi luherepa nentu, Mlungu kankulilaviya, pakawawalira.<verse eid="PSA 50:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3" />Mlungu gwa twenga kankwiza jiyajiyandiri,</para>
  <para style="q" vid="PSA 50:3">motu yagulunguziya gumlongolera,</para>
  <para style="q" vid="PSA 50:3">lipuga likalipa limzyengeta.<verse eid="PSA 50:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4" />Kulawa kunani kazishema mpindi na pasipanu</para>
  <para style="q" vid="PSA 50:4">ziloli pakawatoza wantu wakuyi.<verse eid="PSA 50:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5" />Mjojoniri kwaneni wantu waminika,</para>
  <para style="q" vid="PSA 50:5">yawatenditi lipatanu na neni kwa tambiku.<verse eid="PSA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6" />Mpindi zibweri umanika wa Mlungu,</para>
  <para style="q" vid="PSA 50:6">handa Mlungu mweni ndo mtoza.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7" />“Mpikiniri wantu wa neni shantakula!</para>
  <para style="q" vid="PSA 50:7">Israeli handaviyi kwaku ukapitawu wa kukusitaki.</para>
  <para style="q" vid="PSA 50:7">Neni ndo Mlungu, Neni ndo Mlungu gwanu.<verse eid="PSA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8" />Nikukalipirandiri toziya ya tambiku zaku,</para>
  <para style="q" vid="PSA 50:8">mana hagweneleki kulavalira tambiku za kulungiziya.<verse eid="PSA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9" />Nakaka nfirandiri ng'ombi shipalu gwa shisasa shaku,</para>
  <para style="q" vid="PSA 50:9">pota pongu gwa mifugu yaku,<verse eid="PSA 50:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10" />toziya wankanyama woseri wa kuntundu ndo lunda yangu,</para>
  <para style="q" vid="PSA 50:10">na maelufu ga migongu na wang'ombi ndo waneni.<verse eid="PSA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11" />Wampongu woseri wa kumigongu niwamana,</para>
  <para style="q" vid="PSA 50:11">na viwumbi wakomu woseri mumalambu ndo vya neni.<verse eid="PSA 50:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12" />Handa panana njala menikugambilindiri gwenga,</para>
  <para style="q" vid="PSA 50:12">toziya pasipanu na vyoseri vyaviwera ndo vya neni.<verse eid="PSA 50:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13" />Hashi, gulishera ndiya vinofu vya ng'ombi shipalu</para>
  <para style="q" vid="PSA 50:13">ama kulanda mwazi gwa mbuzi?”<verse eid="PSA 50:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14" />Mayagashii iweri ndo tambiku yaku kwa Mlungu,</para>
  <para style="q" vid="PSA 50:14">gumtenderi Mlungu shagulongiti hagushitendi.<verse eid="PSA 50:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15" />“Gunshemi shaka sha kutabika,</para>
  <para style="q" vid="PSA 50:15">na neni hanikulopoli,</para>
  <para style="q" vid="PSA 50:15">na gwenga hagumpanani ligoya.”<verse eid="PSA 50:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16" />Kumbiti Mlungu kamgambira muntu mkontola,</para>
  <para style="q" vid="PSA 50:16">hashi kuzikanta hera lagiru za neni?</para>
  <para style="q" vid="PSA 50:16">Ntambu gaa guyowerayowera kwaajili ya lipatanu lya neni?<verse eid="PSA 50:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17" />Gwenga gukalalira kuwera njimiru,</para>
  <para style="q" vid="PSA 50:17">na visoweru vya neni gugafirandiri kugafata.<verse eid="PSA 50:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18" />Pagumwona mwivi gulikola nayu,</para>
  <para style="q" vid="PSA 50:18">na wahumba guwera nawa.<verse eid="PSA 50:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19" />Gwakala mashaka goseri kulonga vidoda,</para>
  <para style="q" vid="PSA 50:19">na lulimi lwaku lutakula mpayu.<verse eid="PSA 50:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20" />Gukalapasi kumlongalonga muyagu</para>
  <para style="q" vid="PSA 50:20">yina, kumshongera mlongu gwaku gamweni.<verse eid="PSA 50:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21" />Shaka gwakutenda vyoseri avi na neni nyamalira</para>
  <para style="q" vid="PSA 50:21">hashi gulishera nakaka neni ndo handa gwenga?</para>
  <para style="q" vid="PSA 50:21">Kumbiti vinu nikukalipira,</para>
  <para style="q" vid="PSA 50:21">na hanikusitaki pota kufifa.<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22" />Mliholi weri mlandu agu, mwenga yamnsherandiri,</para>
  <para style="q" vid="PSA 50:22">hera hangu haniwangamiziyi,</para>
  <para style="q" vid="PSA 50:22">potakuwera muntu gwakuwalopola.<verse eid="PSA 50:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23" />Yakalonga mayagashii kwaneni handa tambiku yakuyi, ayu ndo yakanupa ligoya,</para>
  <para style="q" vid="PSA 50:23">yoseri yakajimira lagiru zyangu, ayu ndo hanimlopoli.<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">Maluwa ga kulekiziwa</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 51:1" />Gwee Mlungu gumoneri lusungu,</para>
  <para style="q" vid="PSA 51:1">toziya ya ufiru waku,</para>
  <para style="q" vid="PSA 51:1">kulinganira na uvuwa wa lusungu lwaku guwusiliri kutali vidoda vyangu.<verse eid="PSA 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 51:2" />Gungululi nakamu ukontola wangu,</para>
  <para style="q" vid="PSA 51:2">guvitakasiyi vidoda vyangu.<verse eid="PSA 51:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3" />Njimira nakaka makosa gangu,</para>
  <para style="q" vid="PSA 51:3">mashaka goseri mona lupalahera makontola gangu.<verse eid="PSA 51:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4" />Nikutendera vidoda gwenga gweka yaku,</para>
  <para style="q" vid="PSA 51:4">Ntenda madoda palongolu paku,</para>
  <para style="q" vid="PSA 51:4">shagwamuwiti gwenga ndo sha nakaka</para>
  <para style="q" vid="PSA 51:4">toza yaku yahera lawama.<verse eid="PSA 51:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5" />Neni nkoseya kwanjira kwiwuka kwangu,</para>
  <para style="q" vid="PSA 51:5">nana vidoda kwanjira mumtima mwa mawu gwangu.<verse eid="PSA 51:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6" />Gwenga gufira uwaminika kulawa mngati,</para>
  <para style="q" vid="PSA 51:6">hangu gunfundi luhala lwalufifikiti.<verse eid="PSA 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7" />Guntakasiyi kwa mivumbeza, ntakati,</para>
  <para style="q" vid="PSA 51:7">gungululi weri mfufu mbuu handa seluji.<verse eid="PSA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8" />Guntendi nemeleri na kufyapilira,</para>
  <para style="q" vid="PSA 51:8">gunemiziyi kayi, neni yagumbosholangiti<verse eid="PSA 51:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9" />Gugalambuki, naguvilola vidoda vyaneni,</para>
  <para style="q" vid="PSA 51:9">gugafuti makontola gangu goseri.<verse eid="PSA 51:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10" />Gwee Mlungu guwumbili moyu guherepa,</para>
  <para style="q" vid="PSA 51:10">gutuli mngati mwaneni rohu yasyayi ya waminika.<verse eid="PSA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11" />Nagunasa kutali nagwenga,</para>
  <para style="q" vid="PSA 51:11">nagumbusilira rohu gwaku mnanagala,<verse eid="PSA 51:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12" />Gumbuziliri nemeleru ya ulopola,</para>
  <para style="q" vid="PSA 51:12">gumpanani moyu gwa kujimira su guntedi nendeleyi kukujimira.<verse eid="PSA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13" />Panu haniwafundi yawatenda vidoda njira zako,</para>
  <para style="q" vid="PSA 51:13">na wana vidoda hawawuyi kwa gwenga.<verse eid="PSA 51:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14" />Gwee Mlungu gundopoli kwa kundekaziya likosa lya kwita mwazi,</para>
  <para style="q" vid="PSA 51:14">gwee Mlungu, mlopola gwangu,</para>
  <para style="q" vid="PSA 51:14">naneni kwa nemeru hanimbi kwa kubotanga, toziya ya haki yaku.<verse eid="PSA 51:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15" />Gwee Mtuwa Mlungu guntangi kutakula,</para>
  <para style="q" vid="PSA 51:15">su neni mbweli zyuma zyaku.<verse eid="PSA 51:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16" />Nakaka gwenga gufiriziwandiri na tambiku hera,</para>
  <para style="q" vid="PSA 51:16">handa meyiweri hangu neni menikulaviliri,</para>
  <para style="q" vid="PSA 51:16">gwenga gufirandiri tambika za kulunguziya.<verse eid="PSA 51:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17" />Gwee Mlungu tambiku ya neni kwa gwenga, ndo moyu mnanaga,</para>
  <para style="q" vid="PSA 51:17">gwenga gulemandiri moyu gunanaga na gwa kulonga noya vidoda.<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18" />Gwee Mlungu, gufiri kulutendera maheri lushi lwa sayuni,</para>
  <para style="q" vid="PSA 51:18">guvinyawi kayi vibambaza vya lushi lwa Yerusalemu.<verse eid="PSA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19" />Panu hagufiriziwi na tambiku za nakaka,</para>
  <para style="q" vid="PSA 51:19">tambiku za kulunguziwa na tambiku za kulunguziwa yoseri,</para>
  <para style="q" vid="PSA 51:19">shakapanu ng'ombi shipalu hawalaviwi tambiku pakutambikira paku.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s">Toza ya Mlungu na lusungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 52:1" />Gwee likambaku, hashi gulitumbira udoda waku?</para>
  <para style="q" vid="PSA 52:1">Kumbit uaminika wa Mlungu ulikala mashaka goseri.<verse eid="PSA 52:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 52:2" />Kila shaka gupanga mahalibisiya,</para>
  <para style="q" vid="PSA 52:2">lulimi lwaku ndo handa shiwembi shikalipa.</para>
  <para style="q" vid="PSA 52:2">Lwalutakula mirandu ya upaya.<verse eid="PSA 52:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3" />Gwenga gufira ukontola kuliku uheri,</para>
  <para style="q" vid="PSA 52:3">gufira kutakula mpayu kuliku unakaka.<verse eid="PSA 52:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4" />Gwenga gufira visoweru vya kuharibisiya,</para>
  <para style="q" vid="PSA 52:4">na lulimi lwaluyowera mpayu.<verse eid="PSA 52:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5" />Hangu Mlungu hakakusulusiyi muuhalibisiya mashaka goseri,</para>
  <para style="q" vid="PSA 52:5">hakakunyasuli na kukuwusiya ukaya kwaku,</para>
  <para style="q" vid="PSA 52:5">hakakuwusiyi muisi yawawera wakomu.<verse eid="PSA 52:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6" />Waminika hawawoni aga na kutira,</para>
  <para style="q" vid="PSA 52:6">shakapanu hawakuseki na kulonga,<verse eid="PSA 52:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7" />mloli yagampatiti muntu ayu!</para>
  <para style="q" vid="PSA 52:7">Yomberi kafirandiri Mlungu kaweri tugira yakuyi,</para>
  <para style="q" vid="PSA 52:7">ila katumbiriti ulunda wakuyi uvuwa na kawera mgangamala kulaga wamonga.<verse eid="PSA 52:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8" />Kumbiti neni ndo handa mtera gwa mzeituni muwisi,</para>
  <para style="q" vid="PSA 52:8">yaguherepa munumba ya Mlungu na hanendeleyi kuzitumbira tanga zakuyi mashaka goseri.<verse eid="PSA 52:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9" />Gwee Mlungu hanongi mayagashi mashaka goseri,</para>
  <para style="q" vid="PSA 52:9">toziya ya mirandu yagutenditi,</para>
  <para style="q" vid="PSA 52:9">hazyumi litawu lyaku kulongolu kwa wantu waku.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s">Ukontola wa wantu</para>
  <para style="r">
    <ref loc="PSA 14">Zabuli 14</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 53:1" />Mzigizigi kalitakuziya mumoyu kwahera Mlungu.</para>
  <para style="q" vid="PSA 53:1">Woseri wakoseya nakamu,</para>
  <para style="q" vid="PSA 53:1">watenda mirandu ya kukalaziya,</para>
  <para style="q" vid="PSA 53:1">kwahera ata yumu yakatenda liheri.<verse eid="PSA 53:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2" />Mlungu kawalola wantu pakawera kumpindi,</para>
  <para style="q" vid="PSA 53:2">su kawoni handa kwana yoseri kana luhala</para>
  <para style="q" vid="PSA 53:2">handa kwana yoseri yakamsakula Mlungu,<verse eid="PSA 53:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3" />kumbiti woseri wakulema,</para>
  <para style="q" vid="PSA 53:3">woseri wapotoka,</para>
  <para style="q" vid="PSA 53:3">kwahera yakatenda liheri, kwahera ata yumu.<verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4" />Mlungu kakosiya hashi, awa yawatenda makontola wahera mahala?</para>
  <para style="q" vid="PSA 53:4">Wankuwamemena wantu wa neni ntambu yawaliya mabumunda</para>
  <para style="q" vid="PSA 53:4">pota wanguwirandiri neni Mlungu.<verse eid="PSA 53:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5" />Awa hawaweri na lyoga likulu,</para>
  <para style="q" vid="PSA 53:5">lyoga lyeni hawenipati kuliwona,</para>
  <para style="q" vid="PSA 53:5">mana Mlungu hakayipalasiyi mihonju ya wankondu,</para>
  <para style="q" vid="PSA 53:5">na hawasoniziki mana Mlungu kawalema.<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6" />Meyiherepi handa ukombola wa Israeli meusoki kulawa sayuni.</para>
  <para style="q" vid="PSA 53:6">Mlungu pakawuziya ntambu ya kwanja ya wantu wakuyi,</para>
  <para style="q" vid="PSA 53:6">wiwuka wa Yakobu hawafyapiliri na Waisraeli hawanemeleri.<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s">Liluwa lya kulishinga na wankondu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 54:1" />Gwee Mlungu, gundopoli kwa litawu lyaku</para>
  <para style="q" vid="PSA 54:1">gunteteyi kwa makakala gaku.<verse eid="PSA 54:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 54:2" />Gwee Mlungu, guyambiri likutu gupikinili luwa yangu,</para>
  <para style="q" vid="PSA 54:2">guvipikiniri visoweru vya mlomu gwangu.<verse eid="PSA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3" />Wantu wana mtiti wankunkomanga,</para>
  <para style="q" vid="PSA 54:3">wangesera wankugagwadira makaliru gangu,</para>
  <para style="q" vid="PSA 54:3">wantu yawamsherandiri Mlungu.<verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4" />Kumbiti nivimana Mlungu ndo mtanga gwangu,</para>
  <para style="q" vid="PSA 54:4">Mtuwa Mlungu ndo yakagalolera makaliru gangu.<verse eid="PSA 54:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 54:5" />Yomberi hakawakomangi wankondu wangu, kwa ukontola wawu weni</para>
  <para style="q" vid="PSA 54:5">kwa waminika waku, gwee Mlungu, guwagamiziyi.<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 54:6" />Hanikulaviliri tambiku kwa moyu guherepa</para>
  <para style="q" vid="PSA 54:6">hanongi mayagashii toziya gwenga ndo mheri,<verse eid="PSA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7" />mana gundopola muntabika zyangu zoseri,</para>
  <para style="q" vid="PSA 54:7">masu gangu gawona wankondu wangu wasinda.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s">Luwa ya muntu yakazulumiwiti</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 55:1" />Gwee Mlungu, gupikanili luwa ya neni, nagulola kumpeku panikuluwa.<verse eid="PSA 55:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 55:2" />Gumpikani na kunankula,</para>
  <para style="q" vid="PSA 55:2">ntoka na ntabiku yangu.<verse eid="PSA 55:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 55:3" />Toziya nana lyoga kwa ntiriziwu zya wankondu wa neni,</para>
  <para style="q" vid="PSA 55:3">na kwa kutabisiwa na wantu wakontola.</para>
  <para style="q" vid="PSA 55:3">Wantu wakontola wankutabisiya,</para>
  <para style="q" vid="PSA 55:3">kwa maya wantendera madoda.<verse eid="PSA 55:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4" />Moyu gwangu gumema hinginika,</para>
  <para style="q" vid="PSA 55:4">vitiliziwu vya kuhowa vimbabanika.<verse eid="PSA 55:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5" />Nendemera kwa lyoga likulu,</para>
  <para style="q" vid="PSA 55:5">nkangalwa na vitiliziwu vikulu.<verse eid="PSA 55:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6" />Mpaka ntakula meweri na mpapatiru handa ng'unda!</para>
  <para style="q" vid="PSA 55:6">Menguluki kutali nakoyeri,<verse eid="PSA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7" />yina, meng'endi kutali nentu,</para>
  <para style="q" vid="PSA 55:7">na kulikala kushiwala.<verse eid="PSA 55:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8" />Mentugili pahala pa kulififa,</para>
  <para style="q" vid="PSA 55:8">patali na lyega likalipa na lipuga.<verse eid="PSA 55:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9" />Gwee Mtuwa, Guwavuluvutira shawafira kutakula,</para>
  <para style="b" vid="PSA 55:9" />
  <para style="q" vid="PSA 55:9">mana mona unkesera na ndewu mumji,<verse eid="PSA 55:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10" />pavizyengeta pashiru na paluwala,</para>
  <para style="q" vid="PSA 55:10">na kuumemiziya ukontola na madoda.<verse eid="PSA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11" />Uhalibisiya umema poseri kumji, pota uwukandiri,</para>
  <para style="q" vid="PSA 55:11">ndewu na ntabiku zimema na ziwukandiri munjira zakuyi.<verse eid="PSA 55:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12" />Handa mnkondu gwangu mekanigiri,</para>
  <para style="q" vid="PSA 55:12">mewezi kuhepelera aga, handa mnkondu gwangu mekambeziyi,</para>
  <para style="q" vid="PSA 55:12">mewezi kulififa kutali na yomberi.<verse eid="PSA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13" />Kumbiti ndo gwenga myangu,</para>
  <para style="q" vid="PSA 55:13">ndo gwenga ganja gwangu gwapakwegera.<verse eid="PSA 55:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14" />Twenga tuzoweleliti kuyowera shiganja,</para>
  <para style="q" vid="PSA 55:14">mu shipinga tuweriti tulilonguziyana pamuhera kugenda ukaya kwa Mlungu.<verse eid="PSA 55:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15" />Kuhowa kuwiziri vumu wankondu waneni,</para>
  <para style="q" vid="PSA 55:15">wasuluki kuzimu wakali wakomu.</para>
  <para style="q" vid="PSA 55:15">Mana ukontola umema mukaya mwamu na muwamu mwawu.<verse eid="PSA 55:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16" />Kumbiti neni nimlilira Mlungu,</para>
  <para style="q" vid="PSA 55:16">na yomberi Mtuwa Mlungu hakandopoli.<verse eid="PSA 55:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17" />Mandawira na paluwala na pashimihi ndira kwa hinginika,</para>
  <para style="q" vid="PSA 55:17">na yomberi hakalipikiniri liziwu lya neni.<verse eid="PSA 55:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18" />Hakambuziyi poneka,</para>
  <para style="q" vid="PSA 55:18">kulawa munkondu yanilikomangiti,</para>
  <para style="q" vid="PSA 55:18">toziya ya wankondu wangu wavuwa.<verse eid="PSA 55:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19" />Mlungu yakakolamlima mashaka goseri, mweni yakagalambukandiri</para>
  <para style="q" vid="PSA 55:19">hakawapikiniri na kuwakomanga,</para>
  <para style="q" vid="PSA 55:19">wantu yawagalambulandiri njira zyawu, pota kumtira Mlungu,<verse eid="PSA 55:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20" />Myangu katalapisiya liwoku kawakomanga waganja wakuyi,</para>
  <para style="q" vid="PSA 55:20">kamega mapatanu gakuyi na womberi.<verse eid="PSA 55:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21" />Visoweru vyakuyi ndo vinama kuliku siyagi,</para>
  <para style="q" vid="PSA 55:21">kumbiti maholu gakuyi ndo gakutenda nkondu.</para>
  <para style="q" vid="PSA 55:21">Visoweru vyakuyi ndo vinama handa lipaki,</para>
  <para style="q" vid="PSA 55:21">kumbiti vilikitula handa ligumba likalipa.<verse eid="PSA 55:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22" />Gumlekeri Mtuwa Mlungu shisanka shaku,</para>
  <para style="q" vid="PSA 55:22">na yomberi hakakuloleri,</para>
  <para style="q" vid="PSA 55:22">nakamu hapeni kamleki mwaminika kasindi.<verse eid="PSA 55:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23" />Gwee Mlungu, haguwasulusiyi kulirindi nakamu,</para>
  <para style="q" vid="PSA 55:23">wantu awa yawalaga na wanampayu, awa hapeni wasoki ata nusu ya makaliru gawu.</para>
  <para style="q" vid="PSA 55:23">Kumbiti neni hanikutumbiri gwenga!<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s">Luwa ya kumtumbira Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 56:1" />Gwee Mlungu, gumoneri lusungu,</para>
  <para style="q" vid="PSA 56:1">mana wantu wankunkomanga.</para>
  <para style="q" vid="PSA 56:1">Paluwala poseri wankondu wankuntabisiya neni.<verse eid="PSA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2" />Paluwala poseri wankondu wangu wankunkomanga,</para>
  <para style="q" vid="PSA 56:2">ndo wavuwa nentu yawalikomanga na neni.<verse eid="PSA 56:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3" />Gwee Mlungu mkulu, lyoga palinkola,</para>
  <para style="q" vid="PSA 56:3">neni nikutumbira gwenga.<verse eid="PSA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4" />Nimtumbira Mlungu na kushizyuma shisoweru shakuyi,</para>
  <para style="q" vid="PSA 56:4">nimtumbira Mlungu, pota ntirandiri,</para>
  <para style="q" vid="PSA 56:4">Muntu yakiwuka na kuhowa hakantendi shishi?<verse eid="PSA 56:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5" />Paluwala poseri wapotoziya galii gantakuliti,</para>
  <para style="q" vid="PSA 56:5">mipangu yawu yoseri wafira kundaga.<verse eid="PSA 56:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6" />Waliwona pahala pa bada</para>
  <para style="q" vid="PSA 56:6">pawalolola goseri gantenda,</para>
  <para style="q" vid="PSA 56:6">wangwandira kwa nfiru ya kundaga.<verse eid="PSA 56:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7" />Gwee Mlungu, guwalipi teratera na ukontola wawu,</para>
  <para style="q" vid="PSA 56:7">guwagusiyi wakontola awa kwa maya gaku.<verse eid="PSA 56:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8" />Gwenga gukumana kutabika kwangu,</para>
  <para style="q" vid="PSA 56:8">gutula liholu lya masozi gangu goseri.</para>
  <para style="q" vid="PSA 56:8">Hashi, goseri gamushitabu shakundiri?<verse eid="PSA 56:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9" />Shaka shoseri shanikuluwa utanga waku,</para>
  <para style="q" vid="PSA 56:9">wankondu waneni wawuziwa kumbeli.</para>
  <para style="q" vid="PSA 56:9">Nakaka nivimana Mlungu kapamuhera na waneni.<verse eid="PSA 56:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10" />Nimtumbira Mlungu na kushizyuma shisoweru shakuyi,</para>
  <para style="q" vid="PSA 56:10">nimtumbira Mtuwa Mlungu na kuzyuma shisoweru shakuyi.<verse eid="PSA 56:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 56:11" />Nimtumbira Mlungu, pota ntirandiri.</para>
  <para style="q" vid="PSA 56:11">Muntu yakiwuka na kuhowa hakantendi shishi?<verse eid="PSA 56:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12" />Gwee Mlungu, hantendi shantakuliti kwagwenga,</para>
  <para style="q" vid="PSA 56:12">hanikulaviliri tambiku za kulonga mayagashii,<verse eid="PSA 56:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13" />mana gundopola mukulaguwa,</para>
  <para style="q" vid="PSA 56:13">yina, gundolera nanguwa pasi,</para>
  <para style="q" vid="PSA 56:13">gwee Mlungu mpati kulikala kulongolu kwaku na</para>
  <para style="q" vid="PSA 56:13">muulangala wa ukomu.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s">Luwa ya kuluwa utanga</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 57:1" />Gwee Mlungu, shondi gumoneri lusungu,</para>
  <para style="q" vid="PSA 57:1">mana kwagwenga ntugira uponera.</para>
  <para style="q" vid="PSA 57:1">Kushivinyiru sha mbapatiru zaku hantugiri uponera,</para>
  <para style="q" vid="PSA 57:1">ata lipuga lya maagamiziya palipitaku.<verse eid="PSA 57:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2" />Nimlilira Mlungu Mkulu,</para>
  <para style="q" vid="PSA 57:2">Mlungu kantangi kutenda galii gakagafira.<verse eid="PSA 57:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3" />Hakanjegeri utanga kulawa kumpindi na kundopola,</para>
  <para style="q" vid="PSA 57:3">hakawasoniziyi awa yawankomanga.</para>
  <para style="q" vid="PSA 57:3">Mlungu hakananguziyi ufiru wakuyi na uaminika wakuyi!<verse eid="PSA 57:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4" />Neni napakati pa wankondu,</para>
  <para style="q" vid="PSA 57:4">wananfiru ya mwazi handa simba.</para>
  <para style="q" vid="PSA 57:4">Menu gawu handa migowa na misali,</para>
  <para style="q" vid="PSA 57:4">milimi yawu ndo handa magumba gakalipa.<verse eid="PSA 57:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5" />Gwee Mlungu gukwiswi, panani pampindi,</para>
  <para style="q" vid="PSA 57:5">uweru waku weneyi pasipanu poseri.<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6" />Wankondu wanyambira wavu wang'omiziyi,</para>
  <para style="q" vid="PSA 57:6">naneni ntabika kwa kwinginika.</para>
  <para style="q" vid="PSA 57:6">Wampawira lilindi munjira yangu,</para>
  <para style="q" vid="PSA 57:6">kumbiti weni wapatukira amu.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7" />Gwee Mlungu, ngangamala mumoyu, moyu gwangu gugangamala</para>
  <para style="q" vid="PSA 57:7">hanimbi na kukufyapilira!<verse eid="PSA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8" />Gwimuki, gwee moyu gwangu!</para>
  <para style="q" vid="PSA 57:8">Mwimuki, mwee shinubi na lilimba!</para>
  <para style="q" vid="PSA 57:8">Hanimusiyi mandawira putiputi!<verse eid="PSA 57:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9" />Gwee Mtuwa Mlungu, hanongi mayagashii pakati pa maisi,</para>
  <para style="q" vid="PSA 57:9">hanikwimbili zyuma pakati pa wantu.<verse eid="PSA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10" />Ufiru waku upalasiwa ata panani pampindi,</para>
  <para style="q" vid="PSA 57:10">waminika waku usoka mpaka kumawundi.<verse eid="PSA 57:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11" />Gwee Mlungu, gukwiswi kumpindi aku,</para>
  <para style="q" vid="PSA 57:11">nauweru wako uweri pasipanu poseri.<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s">Luwa ya kuwakomanga wana vidoda</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 58:1" />Mwenga wakolamlima, hashi, mtoza kwa haki?</para>
  <para style="q" vid="PSA 58:1">Hashi mwankuwatoza wantu teratera?<verse eid="PSA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2" />Ndala, mwenga mlihola hera kutenda ukontola,</para>
  <para style="q" vid="PSA 58:2">maweni mwenga mpalasiya madoda pasipanu.<verse eid="PSA 58:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3" />Wakontola wapotoka kwanjira pawiwukiti.</para>
  <para style="q" vid="PSA 58:3">Wapaya awa, wakoseya kulawa pawiwukiti.<verse eid="PSA 58:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4" />Wanausungu handa usungu wa njoka,</para>
  <para style="q" vid="PSA 58:4">mazogu handa njoka lunkumbu,<verse eid="PSA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5" />mweni wapikinirandiri ata liziwu lya mhawi,</para>
  <para style="q" vid="PSA 58:5">ama lwimbu lwa yawapunga.<verse eid="PSA 58:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6" />Gwee Mlungu gugamegi menu ga wankondu,</para>
  <para style="q" vid="PSA 58:6">gwee Mtuwa Mlungu gugatupuli masaya gawu yagawera handa ga simba.<verse eid="PSA 58:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7" />Wawuki handa mashi yagadodomera mumhanga,</para>
  <para style="q" vid="PSA 58:7">pawanika upindi wawu na misali idufuki.<verse eid="PSA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8" />Wagamiri handa shikolukolu ntambu yakalififa,</para>
  <para style="q" vid="PSA 58:8">gambira ndengu yakahowiti yakawona ndiri mshenji.<verse eid="PSA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9" />Pamberi shiwiga hashenipati motu</para>
  <para style="q" vid="PSA 58:9">hakashinyasuli pamberi nyama hayenipiyi.</para>
  <para style="q" vid="PSA 58:9">Kwa maya ga Mlungu wagulusiwi kutali, pawawera wankali wakomu.<verse eid="PSA 58:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10" />Waaminika hawanemeleri pawawona wakontola wankukomangwa,</para>
  <para style="q" vid="PSA 58:10">hawatimbangi mwazi gwa wantu wadoda,<verse eid="PSA 58:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11" />Wantu woseri hawalongi, yina, waminika wankupata lifupu,</para>
  <para style="q" vid="PSA 58:11">nakaka kwana Mlungu yakapatoza pasipanu.<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s">Kuluwa ulolera wa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 59:1" />Gwee Mlungu gwangu gundopoli na wakondu wangu,</para>
  <para style="q" vid="PSA 59:1">gungomboli na awa yankomanga.<verse eid="PSA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2" />Gundopoli na awa yawatenda makontola,</para>
  <para style="q" vid="PSA 59:2">gumponiziyi kulawa kwa awa yawalaga!<verse eid="PSA 59:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3" />Gulori! Wankungwadira wandagi,</para>
  <para style="q" vid="PSA 59:3">wantu wangesera yawasongiziya ndewu kwaneni.<verse eid="PSA 59:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4" />Ntendandiri likosa kumbiti wankunkomanga,</para>
  <para style="q" vid="PSA 59:4">gwimuki guntanki, gwee Mtuwa Mlungu.<verse eid="PSA 59:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5" />Gugoloki Gwee Mtuwa Mlungu, Mlungu yakana likakala, Mlungu gwa Israeli.</para>
  <para style="q" vid="PSA 59:5">Gugoloki, guwakomangi wantu awa yawakumanandiri,</para>
  <para style="q" vid="PSA 59:5">naguwaleka awa yawapanga madoda.<verse eid="PSA 59:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6" />Kila pashimihi wawuya,</para>
  <para style="q" vid="PSA 59:6">pawawunguruma gambira ng'ang'a na kuyerayera kumjini.<verse eid="PSA 59:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7" />“Gupikaniri, mahigirangu yagalawa mumilomu mwawu,</para>
  <para style="q" vid="PSA 59:7">visoweru vyawu vyankulimbatula handa ligumba likalipa,</para>
  <para style="q" vid="PSA 59:7">kayi wankulihola kwahera yakawapikinira.”<verse eid="PSA 59:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8" />Kumbiti gwenga Mtuwa Mlungu guwaseka,</para>
  <para style="q" vid="PSA 59:8">guwajongera wantu awa wa isi zoseri yawakumanandiri.<verse eid="PSA 59:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9" />Gwee Mlungu, gwa liboma lyangu,</para>
  <para style="q" vid="PSA 59:9">hanikuheperi gwenga yaguwera likakala lyangu.<verse eid="PSA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10" />Mlungu gwangu hagunizili na tanga yaku,</para>
  <para style="q" vid="PSA 59:10">haguntendi moni wankondu wangu pawasinda.<verse eid="PSA 59:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11" />Kumbiti gwenga Mlungu naguwalaga kwa mala yimu wankondu awa, su wantu wangu nawiza kulyaluwa,</para>
  <para style="q" vid="PSA 59:11">ila guwakomi mpolimpoli kwa likakala lyaku, naguwapatuziyi pasi, gwee Mtuwa,</para>
  <para style="q" vid="PSA 59:11">gwenga ndo liboma lyetu.<verse eid="PSA 59:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12" />Womberi watenda vidoda kwa goseri gawatakula,</para>
  <para style="q" vid="PSA 59:12">na wagomiziwi kwamtiti gwawu!</para>
  <para style="q" vid="PSA 59:12">Toziya ya pangira na upaya wawu.<verse eid="PSA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13" />Guwahalibisiyi kwa maya gaku,</para>
  <para style="q" vid="PSA 59:13">guwahalibisiyi nawawera kayi, su wantu woseri wavimani kuwera gwenga gwa Mlungu.</para>
  <para style="q" vid="PSA 59:13">Guwakolamlima wiwuka wa Yakobu ata mpaka upeleru wa pasipanu.<verse eid="PSA 59:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 59:14" />Kila pashimihi wawuya pawawunguruma gambira ng'ang'a</para>
  <para style="q" vid="PSA 59:14">na kuyerayera kumjini.<verse eid="PSA 59:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 59:15" />Watyangatyanga pawasakula shiboga</para>
  <para style="q" vid="PSA 59:15">na pawikutandiri wendeleya kuguguma pashiru poseri.<verse eid="PSA 59:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16" />Kumbiti neni hanimbi zyuma kwa likakala lyaku,</para>
  <para style="q" vid="PSA 59:16">hanfapiliri mandawira kwa ufiru waku,</para>
  <para style="q" vid="PSA 59:16">mana gwenga guwera liboma lyangu,</para>
  <para style="q" vid="PSA 59:16">natugira ya neni shaka sha kutabika.<verse eid="PSA 59:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17" />Gwee Mtuwa Mlungu yaguwera likakala lyangu,</para>
  <para style="q" vid="PSA 59:17">hanikwimbiri zyuma,</para>
  <para style="q" vid="PSA 59:17">mana gwenga guwera liboma lyangu, Mlungu yagunfira.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s">Luwa ya ukombola</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 60:1" />Gwee Mlungu, gutulema na kutuposhola,</para>
  <para style="q" vid="PSA 60:1">toziya gutukalalira, shondi gutuwuziyi kayi kwaku.<verse eid="PSA 60:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 60:2" />Guyilendemiziya isi na kuyipanta,</para>
  <para style="q" vid="PSA 60:2">gudiwi mibaluka yakuyi nayendeleya.<verse eid="PSA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3" />Guwatenda wantu waku wapati ntabika,</para>
  <para style="q" vid="PSA 60:3">twankuwegukaweguka handa yawaloweriti.<verse eid="PSA 60:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4" />Guwapanani lilangaliru walii yawakupanana ligoya,</para>
  <para style="q" vid="PSA 60:4">su washapiri msali.<verse eid="PSA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5" />Gutulopoli kwa liwoku lyaku lya kumliwu,</para>
  <para style="q" vid="PSA 60:5">su walii yawakufira walopolwi.<verse eid="PSA 60:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6" />Mlungu kalonga kulawa pananagala pakuyi,</para>
  <para style="q" vid="PSA 60:6">“Vinu haniyibaguli Shekemu kwa nemeleru,</para>
  <para style="q" vid="PSA 60:6">lulalanda lwa Sukoti hanilupimi vipandivipandi.<verse eid="PSA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7" />Gileadi ndo yaneni na Manasi ndo yaneni,</para>
  <para style="q" vid="PSA 60:7">Efraimu kofia yangu ya shuma,</para>
  <para style="q" vid="PSA 60:7">na Yuda ndo luhonga lwangu lwa ukolamlima.<verse eid="PSA 60:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8" />Moabu ndo handa bakuli yangu ya kunawira,</para>
  <para style="q" vid="PSA 60:8">shilwatu shaneni hanishasiri Edomu iweri yangu.</para>
  <para style="q" vid="PSA 60:8">Hambotangi kwa ukanka kwa Filistia.”<verse eid="PSA 60:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9" />Gaa hakampeleki kulushi lwa liboma?</para>
  <para style="q" vid="PSA 60:9">Gaa hakanongoziyi mpaka Edomu?<verse eid="PSA 60:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10" />Hashi, gutuleka nakamu, gwee Mlungu?</para>
  <para style="q" vid="PSA 60:10">Mana gugendandiri kayi na mashonta getu.<verse eid="PSA 60:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11" />Gututangi kulawa kwa wankondu wetu,</para>
  <para style="q" vid="PSA 60:11">mana utanga wa wantu ufaandiri shintu.<verse eid="PSA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12" />Mlungu pakawera uwega watwenga hatukanki,</para>
  <para style="q" vid="PSA 60:12">yomberi hakawakanki wankondu watwenga.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s">Luwa ya ulolera</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 61:1" />Gwee Mlungu, gupikiniri kulira kwaneni</para>
  <para style="q" vid="PSA 61:1">guyambili likutu luwa yaneni.<verse eid="PSA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2" />Kulawa mpeleru zya pasipanu,</para>
  <para style="q" vid="PSA 61:2">pawera ntwezuka moyu,</para>
  <para style="b" vid="PSA 61:2" />
  <para style="q" vid="PSA 61:2">gunonguziyi kulitalabuwi likulu lyawezandiri kulikwena.<verse eid="PSA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3" />Toziya gwenga ndo tugira yaneni,</para>
  <para style="q" vid="PSA 61:3">liboma lyangu ligangamala kwa wankondu wangu.<verse eid="PSA 61:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4" />Nikuluwa nilikali mnumba mwaku mashaka goseri,</para>
  <para style="q" vid="PSA 61:4">mpati pakulikala pasi pa pambapatiru zaku.<verse eid="PSA 61:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5" />Gwee Mlungu, gupikinira shantakuliti,</para>
  <para style="q" vid="PSA 61:5">na gumpanana uhala wawalii yawalitira litawu lyaku.<verse eid="PSA 61:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6" />Gumwongeri mfalumi makaliru matali,</para>
  <para style="q" vid="PSA 61:6">vinja vyakuyi viweri vya viyiwuku vivuwa.<verse eid="PSA 61:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7" />Kakolimlima mashaka goseri kulongolu kwaku, gwee Mlungu,</para>
  <para style="q" vid="PSA 61:7">gutendi ufiru na waminika waku vimloleri.<verse eid="PSA 61:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8" />Hangu hanikwimbiri nyimbu zya zyuma,</para>
  <para style="q" vid="PSA 61:8">pantenda shantakuliti kila lishaka.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s">Mlungu ndo mlolera gwangu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 62:1" />Kwa Mlungu gweka yakuyi moyu gwangu gwana uponeru,</para>
  <para style="q" vid="PSA 62:1">ulopola wangu ulawa kwakuyi.<verse eid="PSA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2" />Yomberi gweka yakuyi ndo litalabuhi na ulopola waneni,</para>
  <para style="q" vid="PSA 62:2">yomberi ndo liboma lyangu, hapeni ntikinyiki.<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3" />Mpakandii hamunkomangi neni? Mpakandii woseri mwenga mfira kundaga?</para>
  <para style="q" vid="PSA 62:3">Neni yanahera makakala handa shibambaza shashing'ong'onaliti, handa shidiwira shashifira kuguwa.<verse eid="PSA 62:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4" />Mpanga kungusiya kulawa pahala pangu pa ukulu,</para>
  <para style="q" vid="PSA 62:4">mnemera kutakula mpayu.</para>
  <para style="q" vid="PSA 62:4">Mntekelera kwa visoweru,</para>
  <para style="q" vid="PSA 62:4">kumbiti mumiyoyu yenu mumpangira.<verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5" />Nimlola Mlungu gweka yakuyi,</para>
  <para style="q" vid="PSA 62:5">kwakuyi ntula litumbiru lyangu.<verse eid="PSA 62:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6" />Yomberi gweka yakuyi ndo litalabuhi na ulopola wangu,</para>
  <para style="q" vid="PSA 62:6">na liboma lya neni, hapeni ntinyiki.<verse eid="PSA 62:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7" />Ulopola na tumbiru yaneni vilawa kwa Mlungu,</para>
  <para style="q" vid="PSA 62:7">litalabuhi lyangu ligangamala na tugira yaneni ndo Mlungu.<verse eid="PSA 62:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8" />Mwenga wantu, mumtumbiri Mlungu mashaka goseri,</para>
  <para style="q" vid="PSA 62:8">mumvuguliri Mlungu vyaviwera mumiyoyu mwenu,</para>
  <para style="q" vid="PSA 62:8">mana Mlungu ndo tugira ya uponera watwenga.<verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9" />Wantu woseri ndo handa pumla hera,</para>
  <para style="q" vid="PSA 62:9">woseri, wakulu na wadidini, wafandiri shintu.</para>
  <para style="q" vid="PSA 62:9">Kayi paguwapima utopa wafika ndiri kilu, woseri pamuhera wayewuka kuliku pumla.<verse eid="PSA 62:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10" />Namlitumbira lunda zya uzyanga,</para>
  <para style="q" vid="PSA 62:10">pota namlizyumira vintu vya kwiwa,</para>
  <para style="q" vid="PSA 62:10">tembera lunda pazongereka namzitumbira.<verse eid="PSA 62:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 62:11" />Mlungu katakula mrandu gumu,</para>
  <para style="q" vid="PSA 62:11">na neni mpikinira mirandu miwili,</para>
  <para style="q" vid="PSA 62:11">handa makakala ndo gakuyi gweka yakuyi,<verse eid="PSA 62:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 62:12" />naufiru ndo waku Mtuwa,</para>
  <para style="q" vid="PSA 62:12">toziya gwenga Mlungu gumlipa kila muntu teratera na matendu gakuyi.<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s">Nfiru ya kuwera na Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 63:1" />Gwee Mlungu, gwenga ndo gwa Mlungu gwangu,</para>
  <para style="q" vid="PSA 63:1">nikusakula kwa moyu goseri,</para>
  <para style="q" vid="PSA 63:1">rohu yaneni ikufira handa muntu yakimiluwa</para>
  <para style="q" vid="PSA 63:1">nyimiluwa handa isi iyuma yayikenteka yahera mashi.<verse eid="PSA 63:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2" />Nikuwona pananagala paku,</para>
  <para style="q" vid="PSA 63:2">moni likakala lyaku na uweru waku.<verse eid="PSA 63:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3" />Toziya ya ufiru waku yawahera mpeleru,</para>
  <para style="q" vid="PSA 63:3">na milomu yaneni hayikuzyumi.<verse eid="PSA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4" />Hanongi mayagashi mumakaliru gangu goseri,</para>
  <para style="q" vid="PSA 63:4">hanyasuli mawoku gangu na kuluwa.<verse eid="PSA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5" />Rohu yaneni hayitosiwi handa iliya viboga vinoga,</para>
  <para style="q" vid="PSA 63:5">hanikwimbiri zyuma kwa nemeru.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6" />Pawera pashitanda hanikuholi,</para>
  <para style="q" vid="PSA 63:6">pashiru poseri hanikuholeri,<verse eid="PSA 63:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7" />toziya guwera mtanga gwangu.</para>
  <para style="q" vid="PSA 63:7">Hanimbi nyimbu zya nemeru pasi palisisi lya mbapatiru zyaku.<verse eid="PSA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8" />Rohu yaneni ya pamuhera na gwenga,</para>
  <para style="q" vid="PSA 63:8">liwoku lyaku lya kumliwu lindolera.<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9" />Kumbiti woseri yawafira kundaga</para>
  <para style="q" vid="PSA 63:9">hawapatukili pasi pawalikala wantu yawahowiti.<verse eid="PSA 63:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 63:10" />Hawalaguwi kwa ligumba,</para>
  <para style="q" vid="PSA 63:10">na hawaweri shiboga sha vibweta.<verse eid="PSA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11" />Kumbiti mfalumi hakamnemeleri Mlungu,</para>
  <para style="q" vid="PSA 63:11">woseri yawalirapiti kwa litawu lya Mlungu hawamzyumi,</para>
  <para style="q" vid="PSA 63:11">kumbiti wanampayu hawanyamaziwi.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s">Luwa ya ulolera</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 64:1" />Gwee Mlungu, gupikanili kulalama kwaneni,</para>
  <para style="q" vid="PSA 64:1">gugaloleri makaliru gangu kulawirana na ntiliziwu za wankondu.<verse eid="PSA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2" />Gundoleri na mipangu ya bada ya wadoda,</para>
  <para style="q" vid="PSA 64:2">kulawirana na shipinga sha wantu wakontola.<verse eid="PSA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3" />Wankukuwa milimi yawu gambira ligumba,</para>
  <para style="q" vid="PSA 64:3">wayowera visoweru vikalipa handa misali.<verse eid="PSA 64:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4" />Kulawa mumafifu wamkomanga muntu mwaminika,</para>
  <para style="q" vid="PSA 64:4">wankumkomanga vumu pota kutira.<verse eid="PSA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5" />Wankulipanana moyu mumipangu yawu idoda,</para>
  <para style="q" vid="PSA 64:5">wankupatana ntambu ya kufifa migomiziwu yawu.</para>
  <para style="q" vid="PSA 64:5">“Pawalihola kuwera kwahera yakaweza kuyiwona.”<verse eid="PSA 64:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6" />Watenda mipangu yawu ya ukontola na kulonga.</para>
  <para style="q" vid="PSA 64:6">“Vinu tumalira mipangu yetu.”</para>
  <para style="q" vid="PSA 64:6">Nakaka mipangu ya bada ya muntu ilififa mumoyu mwakuyi.<verse eid="PSA 64:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7" />Kumbiti Mlungu hakawagumi misali</para>
  <para style="q" vid="PSA 64:7">na womberi hawatenduwi vumu.<verse eid="PSA 64:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8" />Hakawagamiziyi toziya ya visoweru vyawu,</para>
  <para style="q" vid="PSA 64:8">kila yakawawona hakatikisiyi mtuyi kwa hinginika,<verse eid="PSA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9" />na wantu woseri hawatiri.</para>
  <para style="q" vid="PSA 64:9">Hawabweri galii gakatenditi Mlungu</para>
  <para style="q" vid="PSA 64:9">na kulihola mirandu yakatenditi.<verse eid="PSA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10" />Yawatenda maheri hawamnemeleri Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 64:10">na kutugira kwakuyi,</para>
  <para style="q" vid="PSA 64:10">wantu woseri waminika hawamzyumi.<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s">Lwimbu lwa zyuma na mayagashii</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 65:1" />Gwee Mlungu, gufiruwa zyuma aku sayuni,</para>
  <para style="q" vid="PSA 65:1">wantu hawatendi naziri zawu,<verse eid="PSA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2" />toziya gwenga gwankula luwa.</para>
  <para style="q" vid="PSA 65:2">Wantu woseri hawakwizili gwenga.<verse eid="PSA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3" />Makosa gangu pagantopeliti,</para>
  <para style="q1" vid="PSA 65:3">gwenga gundekeziyiti makontola gangu.<verse eid="PSA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4" />Mbaka ulii yagumsyaguliti,</para>
  <para style="q" vid="PSA 65:4">nakumjimira kalikali muligeleri lyaku.</para>
  <para style="q" vid="PSA 65:4">Twikutuziwa na maheri ga numba yaku,</para>
  <para style="q" vid="PSA 65:4">namaherepa ga Numba Nkulu yaku nanagala.<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5" />Hagutwankuli kwa matendu gakulikangasha ga haki</para>
  <para style="q" vid="PSA 65:5">gwee Mlungu gwa ulopola watwenga,</para>
  <para style="q" vid="PSA 65:5">gwenga ndo litumbiru vya viwumbi vyoseri pasipanu</para>
  <para style="q" vid="PSA 65:5">na wantu yawalikala kumwambu mwa bahali.<verse eid="PSA 65:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6" />Kwa makakala gaku guyituliti migongu pahala pakuyi,</para>
  <para style="q" vid="PSA 65:6">gwenga gulanguziya makakala gaku.<verse eid="PSA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7" />Gunyamaziyiti kuliputa kwa makupala ga bahari,</para>
  <para style="q" vid="PSA 65:7">na gumalira makupala gakuyi</para>
  <para style="q" vid="PSA 65:7">na kunyamaziya umatu wa wantu.<verse eid="PSA 65:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8" />Pasipanu poseri pakangashwa,</para>
  <para style="q" vid="PSA 65:8">na matendu gaku,</para>
  <para style="q" vid="PSA 65:8">gutenda wantu wanemeleri,</para>
  <para style="q" vid="PSA 65:8">kulawa kwagulawa mshenji mpaka kwaguzyeta mshenji.<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9" />Gwenga guyityangira isi na kuitowera mvula,</para>
  <para style="q" vid="PSA 65:9">na guyitenda iweri na wolera na kuyileliziya.</para>
  <para style="q" vid="PSA 65:9">Ina nshemba zazinyiririka mashi</para>
  <para style="q" vid="PSA 65:9">su kuwapanana wantu viboga,</para>
  <para style="q" vid="PSA 65:9">hangu ndo ntambu yaguyitanditi isi.<verse eid="PSA 65:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10" />Matuta gakuyi gugalowiziya kwa mashi gavuwa</para>
  <para style="q" vid="PSA 65:10">papalimitwi pamema mashi,</para>
  <para style="q" vid="PSA 65:10">gutowiti mvula su kuloviya litapaka</para>
  <para style="q" vid="PSA 65:10">na kuvitekelera vimeru vyakuyi.<verse eid="PSA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11" />Gushitekelera shinja kwa mabenangu gavuwa</para>
  <para style="q" vid="PSA 65:11">kila pagupititi pamema mbatiru.<verse eid="PSA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12" />Pahala pa maliwuziwu kuntundu pamema mifugu,</para>
  <para style="q" vid="PSA 65:12">vigongu vimema nemeru.<verse eid="PSA 65:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13" />Maliwuziwu gamema kondolu,</para>
  <para style="q" vid="PSA 65:13">lalanda zimema viboga,</para>
  <para style="q" vid="PSA 65:13">vyoseri vifyapiliriti kwa nemeru.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s">Lwimbu lwa mayagashi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1" />Mwenga wantu woseri pasipanu mumnemeleri Mlungu.<verse eid="PSA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2" />Mwimbi kwajili ya uweru wa litawu lyaku,</para>
  <para style="q" vid="PSA 66:2">mmuzyumi kwa uweru wakuyi.<verse eid="PSA 66:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3" />Mumgambili Mlungu, matendu gaku gakangasha nentu!</para>
  <para style="q" vid="PSA 66:3">Makakala gaku ndo makulu nentu</para>
  <para style="q" vid="PSA 66:3">ata wankondu waku waperuwa makakala kwa lyoga.<verse eid="PSA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4" />Pasi panu poseri pakuguwira gwenga,</para>
  <para style="q" vid="PSA 66:4">walimbiri zyuma litawu lyaku</para>
  <para style="q" vid="PSA 66:4">wantu woseri wakuzyumi gwenga.<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5" />Mwizi na mlori vitwatira vyoseri vyakatenda Mlungu,</para>
  <para style="q" vid="PSA 66:5">katenda vitwatira vya kutiriziya pakati pa wantu.<verse eid="PSA 66:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6" />Kagalambula bahari iwera isi iyuma,</para>
  <para style="q" vid="PSA 66:6">wantu wapititi amu kwa magulu,</para>
  <para style="q" vid="PSA 66:6">hangu tunemeleriti toziya yakuyi.<verse eid="PSA 66:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7" />Kakolamlima mashaka goseri kwa likakala lyakuyi,</para>
  <para style="q" vid="PSA 66:7">Masu gaku gawalola wantu woseri.</para>
  <para style="q" vid="PSA 66:7">Mkontola yoseri nakajera kuwera mkulu kuliku yomberi.<verse eid="PSA 66:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8" />Mmuzyumi Mlungu gwetu, mwenga maisi goseri;</para>
  <para style="q" vid="PSA 66:8">mbweri zyuma zakuyi zipikaniki.<verse eid="PSA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9" />Yomberi kagalolera makaliru getu,</para>
  <para style="q" vid="PSA 66:9">pota katulekandiri tuguwi.<verse eid="PSA 66:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10" />Gwee Mlungu gutujera,</para>
  <para style="q" vid="PSA 66:10">gutugulula kwa motu gambira madini ga feza.<verse eid="PSA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11" />Gutwingiziya mumgomiziwu,</para>
  <para style="q" vid="PSA 66:11">gututenda tuweri na ntabiku.<verse eid="PSA 66:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12" />Guwaleka wantu watutimbangi mumtuyi,</para>
  <para style="q" vid="PSA 66:12">tupita mumotu na mumashi,</para>
  <para style="q" vid="PSA 66:12">kumbiti vinu gutujega mu isi yayimema kila shintu.<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13" />Hanizi ukaya kwaku na tambiku za kulunguziya,</para>
  <para style="q" vid="PSA 66:13">na hantendi vyantakuliti kwaku,<verse eid="PSA 66:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14" />vilii vyatakuliti kwamlomu gwangu namweni,</para>
  <para style="q" vid="PSA 66:14">vyayoweriti paweriti mkutabika.<verse eid="PSA 66:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15" />Hanikulaviliri litambiku lya kulunguziwa lya wankanyama waherepa,</para>
  <para style="q" vid="PSA 66:15">litambiku lya kulunguziwa lya kondolu shipalu,</para>
  <para style="q" vid="PSA 66:15">litambiku lya kulunguziwa lya ng'ombi na mbuzi.<verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16" />Mwizi na mpikaniri woseri mwenga yamumguwira Mlungu,</para>
  <para style="q" vid="PSA 66:16">naneni haniwatambiri gakantenderiti.<verse eid="PSA 66:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17" />Neni nimshema kwa liziwu,</para>
  <para style="q" vid="PSA 66:17">zyuma zakuyi nizibwera.<verse eid="PSA 66:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18" />Handa mempangi makontola mumoyu mwangu</para>
  <para style="q" vid="PSA 66:18">Mtuwa Mlungu mekampikinirindiri.<verse eid="PSA 66:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19" />Kumbiti nakaka Mlungu kampikinira,</para>
  <para style="q" vid="PSA 66:19">na kayambira likutu maluwa gangu.<verse eid="PSA 66:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20" />Kazyumwi Mlungu,</para>
  <para style="q" vid="PSA 66:20">toziya kakulemandiri kuluwa kwaneni</para>
  <para style="q" vid="PSA 66:20">pota kalekandiri kuntendera maheri.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s">Lwimbu lwa mayagashii</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 67:1" />Gwee Mlungu, gutuwoneri lusungu na gututekeleri,</para>
  <para style="q" vid="PSA 67:1">gutulangaziyi langala la sheni shaku,<verse eid="PSA 67:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2" />su pasipanu poseri pavimani njira zyaku,</para>
  <para style="q" vid="PSA 67:2">maisi goseri gavimani makakala gaku ga kulopola.<verse eid="PSA 67:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3" />Gwee Mlungu wantu woseri wakukwisi,</para>
  <para style="q" vid="PSA 67:3">wantu woseri wakuzyumi gwenga!<verse eid="PSA 67:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4" />Gwee Mlungu maisi goseri ganemeleri na kwimba kwa nemeru,</para>
  <para style="q" vid="PSA 67:4">toziya guwatoza ntambu yagufira</para>
  <para style="q" vid="PSA 67:4">na kuwalongoziya wantu woseri pasipanu.<verse eid="PSA 67:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5" />Gwee Mlungu wantu woseri wakukwisi,</para>
  <para style="q" vid="PSA 67:5">wantu woseri wakuzyumi gwenga!<verse eid="PSA 67:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6" />Litapaka na liraviyi mabenangu gakuyi,</para>
  <para style="q" vid="PSA 67:6">Mlungu, Mlungu gwetu, katutekelera.<verse eid="PSA 67:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7" />Mlungu hakatutekeleri,</para>
  <para style="q" vid="PSA 67:7">na wantu woseri pasipanu wamguwiri yomberi.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s">Lwimbu lwa ukanka</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 68:1" />Mlungu hakagoloki na wankondu wakuyi hawapalasiki.</para>
  <para style="q" vid="PSA 68:1">Womberi yawamkalalira hawatugi kulongolu kwakuyi.<verse eid="PSA 68:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2" />Handa lyosi ntambu yaligulusiwa na lyega,</para>
  <para style="q" vid="PSA 68:2">ndo ntambu yanakawagulusiyi,</para>
  <para style="q" vid="PSA 68:2">handa unkombi ntambu yawulembuka pamotu,</para>
  <para style="q" vid="PSA 68:2">ndo wakontola ntambu yawagamira kulongolu kwa Mlungu.<verse eid="PSA 68:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3" />Kumbiti walii yawamfiriziya Mlungu wanemelera pakiza Mlungu,</para>
  <para style="q" vid="PSA 68:3">hawafyapilili na kwimba kwa nemeru.<verse eid="PSA 68:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4" />Mumwimbiri Mlungu, mlizyumi litawu lyakuyi,</para>
  <para style="q" vid="PSA 68:4">mumnyawili njira yakuyi yakakwena kumawundi handa mkwena farasi.</para>
  <para style="q" vid="PSA 68:4">Litawu lyakuyi ndo Mtuwa Mlungu, mfyapiliri kulongolu kwakuyi.<verse eid="PSA 68:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5" />Mlungu yakalikala pahala pakuyi pananagala,</para>
  <para style="q" vid="PSA 68:5">ndo tati gwa washiwa na ndo yakawalolera wakenja.<verse eid="PSA 68:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6" />Mlungu kawapanana pahala pakulika pa mashaka goseri walii yawahera utanga,</para>
  <para style="q" vid="PSA 68:6">kawavugulira watatirwa na kuwapanana mpatiru,</para>
  <para style="q" vid="PSA 68:6">kumbiti wagalambuka hawalikali muisi iyuma.<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7" />Gwee Mlungu, guwalongoziyiti wantu waku,</para>
  <para style="q" vid="PSA 68:7">pawaweriti mumwanja kushiwala kulii,<verse eid="PSA 68:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8" />pasipanu palendemeriti, mpindi itowa mvula,</para>
  <para style="q" vid="PSA 68:8">kulongolu kwa Mlungu, Mlungu gwa Sinai,</para>
  <para style="q" vid="PSA 68:8">kulongolu kwa Mlungu, Mlungu gwa Israeli!<verse eid="PSA 68:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9" />Gwee Mlungu, guyitowiriti isi mvula ivuwa,</para>
  <para style="q" vid="PSA 68:9">guyinemiziyiti isi ya uhala waku yayiyumiti ileki kuyuma,<verse eid="PSA 68:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10" />gwe Mlungu wantu waku wapata pahala pa kulikala, nagwenga kwa uvuwa wa ulunda waku</para>
  <para style="q" vid="PSA 68:10">guwapananiti wahushu vyawafiruwa.<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11" />Mtuwa kalaviyiti shisoweru shakuyi,</para>
  <para style="q" vid="PSA 68:11">na wadala wavuwa wabweriti visoweru avi.<verse eid="PSA 68:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12" />“Wafalumi na mashonta gawu watuga vuluvulu!”</para>
  <para style="q" vid="PSA 68:12">Wamawu yawasigaliti ukaya wabagulaniti lopola,<verse eid="PSA 68:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13" />tembera msigaliti mumazizi.</para>
  <para style="q" vid="PSA 68:13">Gwenga ndo handa vinyagu vya ng'unda vyavigibikilitwi na madini ga feza,</para>
  <para style="q" vid="PSA 68:13">na mbapatiru zawu zimelemeta kwa zahabu.<verse eid="PSA 68:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14" />Mlungu yakana likakala pakawapalasiyiti wafalumi muisi,</para>
  <para style="q" vid="PSA 68:14">ndo handa seruji yayitulukiti pampindi pa lugongu Salimoni.<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15" />Gwee lugongu lwa Mtuwa, lugongu lwa Bashani,</para>
  <para style="q" vid="PSA 68:15">gwee lugongu lwa mpeleru zivuwa, lugongu lwa Bashani!<verse eid="PSA 68:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16" />Mwenga migongu mitali hashi mululola kwa weya</para>
  <para style="q" vid="PSA 68:16">lugongu lwakalusyaguliti Mlungu kalikali pampindi pakuyi?</para>
  <para style="q" vid="PSA 68:16">Mtuwa Mlungu hakalikali aku mashaka goseri.<verse eid="PSA 68:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17" />Pakawera na mwanja mkulu,</para>
  <para style="q" vid="PSA 68:17">maelufu na maelufu ga mbutuka za kukwegwa na farasi,</para>
  <para style="q" vid="PSA 68:17">Mtuwa kankwiza pananagala pakuyi pakalawira Sinai.<verse eid="PSA 68:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18" />Gwenga gukwena kumpindi na kutola lopola,</para>
  <para style="q" vid="PSA 68:18">gwanka mafupu kulawa kwa wantu,</para>
  <para style="q" vid="PSA 68:18">ata kulawa kwa wantu walii yawagalambukiti,</para>
  <para style="q" vid="PSA 68:18">Mtuwa Mlungu hakalikali aku.<verse eid="PSA 68:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19" />Mtuwa Mlungu kazyumwi mashaka goseri,</para>
  <para style="q" vid="PSA 68:19">mweni lishaka kwa lishaka katupapira visanka vyetu,</para>
  <para style="q" vid="PSA 68:19">yomberi ndo Mlungu gwa ulopola wa twenga.<verse eid="PSA 68:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20" />Mlungu gwetu ndo Mlungu yakalopola,</para>
  <para style="q" vid="PSA 68:20">Mtuwa Mlungu gweka yakuyi ndo yakatulopola mukuhowa.<verse eid="PSA 68:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21" />Nakaka Mlungu hakayiposholi mituyi ya wankondu wakuyi,</para>
  <para style="q" vid="PSA 68:21">mituyi yayigendera njira za unkontola.<verse eid="PSA 68:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22" />Mtuwa kalongiti. “Haniwawuziyi wankondu wenu kulawa Bashani,</para>
  <para style="q" vid="PSA 68:22">haniwawuziyi kulawa mumatiwa ga bahari,<verse eid="PSA 68:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23" />su magulu gaku galowi mumwazi gwa wankondu waku,</para>
  <para style="q" vid="PSA 68:23">na wang'ang'a waku waliyi shiboga shashilawa mumizoga ya wankondu waku.”<verse eid="PSA 68:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24" />Gwee Mlungu, miyanja yaku ya ukanka iwoneka,</para>
  <para style="q" vid="PSA 68:24">miyanja ya Mlungu gwangu, mfalumi gwangu, igendera pananagala pakuyi!<verse eid="PSA 68:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25" />Kulongolu yawimba, kumbeli wagomba ngoma,</para>
  <para style="q" vid="PSA 68:25">pakatikati wahinga wankugomba sewi.<verse eid="PSA 68:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26" />Mmuzyumi Mlungu mulijojoniru likulu lya wantu.</para>
  <para style="q" vid="PSA 68:26">Mmukwisi Mtuwa Mlungu, mwenga shipinga sha Israeli!<verse eid="PSA 68:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27" />Lilongoleliti likabila lididika lya Benjamini,</para>
  <para style="q" vid="PSA 68:27">pawafata walongoziya wa Yuda na shipinga shawu,</para>
  <para style="q" vid="PSA 68:27">shakapanu wakulu wa Zebuluni na Naftali.<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28" />Gwee Mlungu, gulangaziyi uwezu waku,</para>
  <para style="q" vid="PSA 68:28">gutulangaziyi makakala gaku ntambu yagututenderiti makashu,<verse eid="PSA 68:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29" />kulawa mu Numba Nkulu yaku Yerusalemu,</para>
  <para style="q" vid="PSA 68:29">peni wafalumi hawakwizili na mafupu gawu.<verse eid="PSA 68:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30" />Guwakalapiri wankanyama walii yawalikala kumiteti,</para>
  <para style="q" vid="PSA 68:30">shipinga sha ng'ombi shipalu shashiwera muwamu mwa wana wang'ombi wa wantu,</para>
  <para style="q" vid="PSA 68:30">mpaka maisi aga gakupanani ligoya na kujega vipandi vya madini ga feza.</para>
  <para style="q" vid="PSA 68:30">Guwapalasiyi wantu wa maisi gamonga yawafira nkondu!<verse eid="PSA 68:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31" />Walagilagi hawizi kulawa Misri,</para>
  <para style="q" vid="PSA 68:31">Wantu wa Waisopia hawamguwiri Mlungu.<verse eid="PSA 68:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32" />Mwenga falumi za pasipanu, mumwimbiri Mlungu,</para>
  <para style="q" vid="PSA 68:32">mumwimbiri Mtuwa yimbu za zyuma,<verse eid="PSA 68:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33" />mumwimbiri yomberi yakakwena mpindi,</para>
  <para style="q" vid="PSA 68:33">kwanjira makashu.</para>
  <para style="q" vid="PSA 68:33">Mmupikiniri pakaguguma kwa liziwu likulu.<verse eid="PSA 68:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34" />Mumbweri uwezu wa Mlungu,</para>
  <para style="q" vid="PSA 68:34">mweni kakolamlima Israeli,</para>
  <para style="q" vid="PSA 68:34">na makakala gakuyi galuparahera kumpindi.<verse eid="PSA 68:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35" />Mlungu gutiriziya paguwera pahala paku pananagala,</para>
  <para style="q" vid="PSA 68:35">Mlungu gwa Israeli! Kawapanana wantu wakuyi uwezu na likakala.</para>
  <para style="b" vid="PSA 68:35" />
  <para style="q" vid="PSA 68:35">Kakwiswi Mlungu!<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s">Kuluwa mtanga shaka sha ntabiku</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 69:1" />Gwee Mlungu gundopoli,</para>
  <para style="q" vid="PSA 69:1">mana mashi gamusingu.<verse eid="PSA 69:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2" />Mpatukira mulidika livuwa,</para>
  <para style="q" vid="PSA 69:2">kwahera ata pahala pa kugoloka.</para>
  <para style="q" vid="PSA 69:2">Mpatukira mumashi matali,</para>
  <para style="q" vid="PSA 69:2">makupala gantola.<verse eid="PSA 69:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3" />Ntoka kuluwa utanga</para>
  <para style="q" vid="PSA 69:3">mpaka lukulamiru lwaneni luyuma.</para>
  <para style="q" vid="PSA 69:3">Na masu ganeni gafifiya,</para>
  <para style="q" vid="PSA 69:3">panikuhepera gwee Mlungu gwangu.<verse eid="PSA 69:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4" />Walii yawankalalira pota toziya</para>
  <para style="q" vid="PSA 69:4">ndo wavuwa kuliku viri za mtuyi gwangu.</para>
  <para style="q" vid="PSA 69:4">Wanamakakala nentu awa yawafira kundaga,</para>
  <para style="q" vid="PSA 69:4">awa yawankomanga kwa vitwatira vya mpayu.</para>
  <para style="q" vid="PSA 69:4">Hashi, mbuziyi shintu shaniwandiri?<verse eid="PSA 69:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5" />Gwee Mlungu, guwuumana ungalimahala waneni,</para>
  <para style="q" vid="PSA 69:5">vidoda vyaneni vififikandiri kwagwenga.<verse eid="PSA 69:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6" />Yawakutumbira nawasoniziwa toziya yaneni,</para>
  <para style="q" vid="PSA 69:6">gwee Mtuwa Mlungu gwa mashonta,</para>
  <para style="q" vid="PSA 69:6">yawakusakula nawasoniziwa toziya yaneni,</para>
  <para style="q" vid="PSA 69:6">gwee Mlungu gwa Israeli.<verse eid="PSA 69:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7" />Nsoniziwa toziya ya gwenga,</para>
  <para style="q" vid="PSA 69:7">soni igubika sheni shaneni.<verse eid="PSA 69:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8" />Wera mhenga kwa walongu wangu,</para>
  <para style="q" vid="PSA 69:8">wana wa mawu gwangu wamanandiri.<verse eid="PSA 69:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9" />Weya waneni kwa numba yaku umalira.</para>
  <para style="q" vid="PSA 69:9">Visoweru vidoda vyoseri vyawakulavilira gwenga vimpata neni.<verse eid="PSA 69:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10" />Pandiriti na koya kuliya,</para>
  <para style="q" vid="PSA 69:10">wantu wambeziyiti.<verse eid="PSA 69:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11" />Panvala nguwu za mafafa su kudaya,</para>
  <para style="q" vid="PSA 69:11">womberi wansekiti.<verse eid="PSA 69:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12" />Wantu yawalikala mumigomi ya mji wantakulanga,</para>
  <para style="q" vid="PSA 69:12">walowera wantungira nyimbu.<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13" />Kumbiti neni nikuluwa gwenga,</para>
  <para style="q" vid="PSA 69:13">gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 69:13">kwa shaka shagushifira kwa ufiru waku mkulu gunankuli,</para>
  <para style="q" vid="PSA 69:13">toziya ulopola waku wa unakaka.<verse eid="PSA 69:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14" />Kwa utanga waku gundopoli nandodomera mumadika,</para>
  <para style="q" vid="PSA 69:14">gundopoli na awa yawankalalira,</para>
  <para style="q" vid="PSA 69:14">gundopoli kulawa mumashi matali.<verse eid="PSA 69:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15" />Nagundeka njegwi na lirawa,</para>
  <para style="q" vid="PSA 69:15">ama mpatukiri mumashi matali,</para>
  <para style="q" vid="PSA 69:15">ama nagundeka ngibikirwi na lisembi.<verse eid="PSA 69:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16" />Gwee Mtuwa Mlungu, gunankuli kwa uheri wa ufiru waku,</para>
  <para style="q" vid="PSA 69:16">gundoli kwa lusungu lwaku lukulu.<verse eid="PSA 69:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17" />Nagunfifa sheni shaku neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 69:17">gunankuli kalongola, toziya namuntabiku.<verse eid="PSA 69:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18" />Guniziri pakwegera na kundopola,</para>
  <para style="q" vid="PSA 69:18">gunkomboli na wankondu wangu.<verse eid="PSA 69:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19" />Gwenga guvimana ntambu yanigirangwa,</para>
  <para style="q" vid="PSA 69:19">viraa guvimana ntambu yasoniziwa na</para>
  <para style="q" vid="PSA 69:19">wankondu wangu woseri gwenga guwamana.<verse eid="PSA 69:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20" />Ntwezuka moyo kwa mayigirangu</para>
  <para style="q" vid="PSA 69:20">na neni mbuya kumberi</para>
  <para style="q" vid="PSA 69:20">Nsakula gwa kunyamaziya kumbiti nimpatandiri,</para>
  <para style="q" vid="PSA 69:20">na gwakunkola mawoku kumbiti nimpatandiri.<verse eid="PSA 69:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21" />Watula usungu mushiboga shangu</para>
  <para style="q" vid="PSA 69:21">na paweriti nyumiluwa wanupa siki nandi.<verse eid="PSA 69:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22" />Matandiru ga shiboga shawu na gaweri mgomiziwu kwawomberi</para>
  <para style="q" vid="PSA 69:22">na viraa iweri mgomiziwu kwa wamaganja wawu.<verse eid="PSA 69:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23" />Masu gawu galekelwi luwindu nawaweza kuwona,</para>
  <para style="q" vid="PSA 69:23">guyilendemeziyi mashaka goseri migongu yawu.<verse eid="PSA 69:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24" />Guwitiri maya gaku,</para>
  <para style="q" vid="PSA 69:24">maya gaku gawapati.<verse eid="PSA 69:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25" />Kaya zyawu mahami,</para>
  <para style="q" vid="PSA 69:25">nakalikala yoseri mng'onjeru zawu.<verse eid="PSA 69:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26" />Toziya wawatabisiya walii yaguwakomiti,</para>
  <para style="q" vid="PSA 69:26">na kuyowelera utama wawu walii yawatenduwitwi.<verse eid="PSA 69:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27" />Guwongeri makomangu,</para>
  <para style="q" vid="PSA 69:27">naguwaleka wapati ulopola waku.<verse eid="PSA 69:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28" />Guwafuti mushitabu sha yawawera wakomu,</para>
  <para style="q" vid="PSA 69:28">nawawera muwalanga ya wantu yawajimirwa na Mlungu.<verse eid="PSA 69:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29" />Kumbiti neni monerwa na mlweri,</para>
  <para style="q" vid="PSA 69:29">gwee Mlungu gunyasuli kumpindi na gundopoli.<verse eid="PSA 69:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30" />Kwa lwimbu hanilizyumi litawu lya Mlungu,</para>
  <para style="q" vid="PSA 69:30">Hanimkwisi kwa mayagashi.<verse eid="PSA 69:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 69:31" />Mlandu agu hagumfiriziyi Mtuwa Mlungu nentu, kuliku kumlavilira tambiku ya ng'ombi shipalu,</para>
  <para style="q" vid="PSA 69:31">kuliku kumlavilira tambiku ya ng'ombi shipalu mkulu pakawera na magoli na vipaga vyakuyi.<verse eid="PSA 69:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32" />Wananaga hawawoni aga na kunemelera,</para>
  <para style="q" vid="PSA 69:32">yawampanana ligoya Mlungu hawapati moyu.<verse eid="PSA 69:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33" />Mtuwa Mlungu kawapikinira wahushu,</para>
  <para style="q" vid="PSA 69:33">hapeni kawalyaluwi nakamu wantu wakuyi yawatatirwa.<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34" />Mpindi na pasi panu zimzyumi Mlungu,</para>
  <para style="q" vid="PSA 69:34">bahari na vyoseri yaviwera amu, vimzyumi.<verse eid="PSA 69:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 69:35" />Toziya Mlungu hakagulopoli mji gwa Sayuni</para>
  <para style="q" vid="PSA 69:35">na kuyinyawa kayi miji ya Yuda.</para>
  <para style="q" vid="PSA 69:35">Wantu wakuyi hawalikali amu kuyikolamlima,<verse eid="PSA 69:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 69:36" />Wana wa wantumintumi wakuyi hawayihali,</para>
  <para style="q" vid="PSA 69:36">walii yawalifira litawu lyakuyi hawalikali amu.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s">Kuluwa utanga</para>
  <para style="r">
    <ref loc="PSA 40:13-17">Zabuli 40:13-17</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 70:1" />Gwee Mlungu gundopoli!</para>
  <para style="q" vid="PSA 70:1">Gwee Mtuwa Mlungu, gwizi kalongola kuntanga.<verse eid="PSA 70:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2" />Yawafira kundaga</para>
  <para style="q" vid="PSA 70:2">na wasoniziki na kufezeeka!</para>
  <para style="q" vid="PSA 70:2">Awa yawafira ntenduwi,</para>
  <para style="q" vid="PSA 70:2">wawuziwi kumbeli kwasoni.<verse eid="PSA 70:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3" />“Woseri yawambolera</para>
  <para style="q" vid="PSA 70:3">wawuyi kumberi toziya ya soni yawu.”<verse eid="PSA 70:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4" />Kumbiti woseri walii yawakusakula,</para>
  <para style="q" vid="PSA 70:4">wasekeleri na kufyapilira toziya ya gwenga.</para>
  <para style="q" vid="PSA 70:4">Yawafira ulopola waku walongi,</para>
  <para style="q" vid="PSA 70:4">mashaka goseri, na watakuli, “Mlungu ndo mkulu!”<verse eid="PSA 70:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5" />Neni yawera mhushu na nahera shintu,</para>
  <para style="q" vid="PSA 70:5">gunizili kalongola, gwee Mlungu!</para>
  <para style="q" vid="PSA 70:5">Gwenga ndo mtanga gwangu na mkombola gwangu,</para>
  <para style="q" vid="PSA 70:5">gwee Mtuwa Mlungu, nagukawalira<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s">Kuluwa ulolera na utanga mashaka goseri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1" />Gwee Mtuwa Mlungu, kwaku ntugira uponera,</para>
  <para style="q" vid="PSA 71:1">nagundeka nsoniziwi nakamu!<verse eid="PSA 71:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2" />Kwa uaminika waku gunkomboli na gumponiziyi.</para>
  <para style="q" vid="PSA 71:2">Gumpikaniri na kundopoli!<verse eid="PSA 71:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3" />Guweri litalabuhi lya uponera waneni,</para>
  <para style="q" vid="PSA 71:3">pahala panantugiri kila shaka,</para>
  <para style="q" vid="PSA 71:3">gulagaliri ndopolwi,</para>
  <para style="q" vid="PSA 71:3">mana gwenga litalabuhi lyangu na liboma lyangu<verse eid="PSA 71:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4" />Gwee Mlungu gwangu, gundopoli mumawoku mwa wantu wakontola,</para>
  <para style="q" vid="PSA 71:4">kulawa mumikonji mwa wantu wadoda na wankesera.<verse eid="PSA 71:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5" />Gwee Mtuwa gwangu, gwenga ndo litumbiru lyangu,</para>
  <para style="q" vid="PSA 71:5">litumbiru lyangu kwanjira untemba waneni.<verse eid="PSA 71:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6" />Nikutumbira gwenga kwanjira kwiwuka kwa neni,</para>
  <para style="q" vid="PSA 71:6">ndo yagundaviyiti mumtima mwa mawu gwangu.</para>
  <para style="q" vid="PSA 71:6">Neni hanikuzyumi gwenga mashaka goseri.<verse eid="PSA 71:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7" />Kwa wantu wavuwa wera shituku,</para>
  <para style="q" vid="PSA 71:7">kumbiti gwenga guwera tugira ya neni igangamala.<verse eid="PSA 71:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8" />Kila shaka mlomu gwangu gumema zyuma zaku na</para>
  <para style="q" vid="PSA 71:8">ukwisa waku paluwala poseri.<verse eid="PSA 71:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9" />Pawera mzewi nagunasa,</para>
  <para style="q" vid="PSA 71:9">pampeluwa likakala nagundeka.<verse eid="PSA 71:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10" />Mana wankondu waneni wantakulanga,</para>
  <para style="q" vid="PSA 71:10">yawagwandira ukomu wa neni wankutenda mipangu,<verse eid="PSA 71:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11" />na kulonga, “Mlungu kamleka,</para>
  <para style="q" vid="PSA 71:11">mmufati na kumbata,</para>
  <para style="q" vid="PSA 71:11">mana kwahera gwa kumlopola.”<verse eid="PSA 71:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12" />Gwee Mlungu nagulikala kutali na neni,</para>
  <para style="q" vid="PSA 71:12">gwee Mlungu gwangu gwizi kalongola kuntanga.<verse eid="PSA 71:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13" />Wankondu wa neni woseri</para>
  <para style="q" vid="PSA 71:13">wasoniziwi na kulaguwa,</para>
  <para style="q" vid="PSA 71:13">woseri yawafira kuntenda neni,</para>
  <para style="q" vid="PSA 71:13">waweri na soni na wasoniziki.<verse eid="PSA 71:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14" />Kumbiti neni haweli na matumbiru mashaka goseri,</para>
  <para style="q" vid="PSA 71:14">kayi hanikuzyumi ng'anji.<verse eid="PSA 71:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15" />Mlomu gwagu hagutakuli matendu gaku ga ulopola,</para>
  <para style="q" vid="PSA 71:15">mashaka goseri hambweri ukombola waku,</para>
  <para style="q" vid="PSA 71:15">tembera aga gapita mahala gangu.<verse eid="PSA 71:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16" />Gwee Mtuwa Mlungu hankanti matendu yaku makulu,</para>
  <para style="q" vid="PSA 71:16">habweri handa gwenga ndo mheri.<verse eid="PSA 71:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17" />Gwee Mlungu, gwenga gunfunda kwanjira untemba wangu,</para>
  <para style="q" vid="PSA 71:17">hanendeleyi kubwera matendu gaku ga kulikangasha.<verse eid="PSA 71:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18" />Gwee Mlungu nagundeka,</para>
  <para style="q" vid="PSA 71:18">ata pawera mzewi,</para>
  <para style="q" vid="PSA 71:18">guweri na neni mpaka pambweraku makakala gaku mu shiyiwuku ashi,</para>
  <para style="q" vid="PSA 71:18">na shiyiwuku shashiza pa neni kuusu makakala gaku.<verse eid="PSA 71:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19" />Gwee Mtuwa likakala na uheri waku, visoki mpaka liyera lya kumpindi.</para>
  <para style="q" vid="PSA 71:19">Gwenga gutenda vitwatira vikulu nentu.</para>
  <para style="q" vid="PSA 71:19">Gwee Mlungu ndo gaa yakawera handa gwenga?<verse eid="PSA 71:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20" />Tembera guntenda ntabiki nentu,</para>
  <para style="q" vid="PSA 71:20">kumbiti hagumbuziliri kayi makakala gangu,</para>
  <para style="q" vid="PSA 71:20">gwenga hagunyasuli kayi kulawa kulisembi,<verse eid="PSA 71:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21" />Hagunongeleri ligoya lyangu</para>
  <para style="q" vid="PSA 71:21">na kuzyangazyanga kayi.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22" />Gwee Mlungu hanikuzyumi kwa shinubi,</para>
  <para style="q" vid="PSA 71:22">toziya ya waminika waku, gwee Mlungu gwangu,</para>
  <para style="q" vid="PSA 71:22">gwenga yaguwera mnanagala gwa Israeli,</para>
  <para style="q" vid="PSA 71:22">hanikwimbiri zyuma kwa lingutinguti<verse eid="PSA 71:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23" />Hambotangi kwa nemeleru,</para>
  <para style="q" vid="PSA 71:23">hanukwimbiri zyuma na</para>
  <para style="q" vid="PSA 71:23">na neni hanikuzyumi toziya gundopola.<verse eid="PSA 71:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24" />Hantakuli matendu gaku ga haki mashaka goseri,</para>
  <para style="q" vid="PSA 71:24">toziya yawajeriti kuntenda,</para>
  <para style="q" vid="PSA 71:24">wasoniziwa na kufezeheshwa.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s">Kumluwira mfalumi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1" />Gwee Mlungu,</para>
  <para style="q" vid="PSA 72:1">gumfundi mfalumi kutoza kwa uaminifu,</para>
  <para style="q" vid="PSA 72:1">gumpanani haki yaku mwana gwa mfalumi,<verse eid="PSA 72:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2" />katozi wantu waku kwa haki,</para>
  <para style="q" vid="PSA 72:2">na wahushu waku kwa waminika.<verse eid="PSA 72:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3" />Migongu ijegi ponga kwa wantu,</para>
  <para style="q" vid="PSA 72:3">vigongu vibweri waminika.<verse eid="PSA 72:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4" />Mfalumi kawateteyi yawahera makakala muwamu mwa wantu,</para>
  <para style="q" vid="PSA 72:4">nakawalopoli wana wa wahushu,</para>
  <para style="q" vid="PSA 72:4">na kuwagamiziya yawawonera wantu.<verse eid="PSA 72:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5" />Kalikali mashaka gavuwa handa mshenji,</para>
  <para style="q" vid="PSA 72:5">na handa lyezi kwa viyiwuku vyoseri.<verse eid="PSA 72:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6" />Kaweri handa mvula yayitowera lirambu,</para>
  <para style="q" vid="PSA 72:6">handa lufolafola lwaluloviya litapaka.<verse eid="PSA 72:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7" />Haki yongereki mu makaliru gakuyi goseri,</para>
  <para style="q" vid="PSA 72:7">na ponga iweri mashaka goseri gambira lyezi ntambu yaliwala.<verse eid="PSA 72:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8" />Kakolimlima kulawa bahari mpaka bahari,</para>
  <para style="q" vid="PSA 72:8">kulawa lushemba Eufrati mpaka mpeleru za pasipanu.<verse eid="PSA 72:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9" />Makabila ga kushiwala gang'ong'onali kulongolu kwakuyi,</para>
  <para style="q" vid="PSA 72:9">wasingani wakuyi wang'ong'onali mpaka washinkuli lidikudiku.<verse eid="PSA 72:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10" />Wafalumi wa Tarishishi na visiwa vimlipi kodi,</para>
  <para style="q" vid="PSA 72:10">wafalumi wa Sheba na Seba wamjegeri mafupu.<verse eid="PSA 72:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11" />Wafalumi woseri hawamsuntamaliri,</para>
  <para style="q" vid="PSA 72:11">wantu wa maisi goseri wamtenderi.<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12" />Toziya kamkombola yakahera shintu yakamluwa,</para>
  <para style="q" vid="PSA 72:12">na mhushu yakahera gwa kumtanga.<verse eid="PSA 72:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13" />Kawawonera lusungu wahushu na yawahera shintu,</para>
  <para style="q" vid="PSA 72:13">kagalopola makaliru gawu yawananfiru.<verse eid="PSA 72:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14" />Kankuwalaviya muukontola na ungesera,</para>
  <para style="q" vid="PSA 72:14">toziya makaliru gawu ndo ga mana nentu kwakuyi.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15" />Mfalumi na kalikali makaliru matali,</para>
  <para style="q" vid="PSA 72:15">kanki lifupu lya zahabu kulawa Sheba,</para>
  <para style="q" vid="PSA 72:15">wantu wamluwiri kwa Mlungu mashaka goseri,</para>
  <para style="q" vid="PSA 72:15">na kumfilira tekelera paliwala poseri.<verse eid="PSA 72:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16" />Isi ilaviyi viboga kwa uvuwa,</para>
  <para style="q" vid="PSA 72:16">vigongu vimemi mabenangu.</para>
  <para style="q" vid="PSA 72:16">Mabwajubwaju gakuyi gaherepi handa ga Lebanoni.</para>
  <para style="q" vid="PSA 72:16">Na wantu wa kumjini wastawi handa ntundu.<verse eid="PSA 72:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17" />Litawu lyakuyi nalyaluwika mashaka goseri,</para>
  <para style="q" vid="PSA 72:17">zyuma zyakuyi zilikali handa mshenji.</para>
  <para style="q" vid="PSA 72:17">Kupitira litawu lyakuyi maisi goseri gatekelerwi,</para>
  <para style="q" vid="PSA 72:17">wantu woseri hawamshemi mtekelerwa!<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18" />Kakwiswi Mtuwa Mlungu, Mlungu gwa Israeli,</para>
  <para style="q" vid="PSA 72:18">mweni gweka yakuyi yakatenda mauzauza.<verse eid="PSA 72:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19" />Litawu lyaku liweru na lizyumwi mashaka goseri,</para>
  <para style="q" vid="PSA 72:19">uweru wakuyi umemi pasipanu poseri!</para>
  <para style="q" vid="PSA 72:19">Amina, Amina<verse eid="PSA 72:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20" />Upeleru wa maluwa ga Daudi, mwana gwa Yese.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">SHITABU SHA TATU</para>
  <para style="mr">
    <ref loc="PSA 73-89">Zabuli 73-89</ref></para>
  <para style="s">Haki ya Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 73:1" />Nakaka, Mlungu ndo mheri kwa Israeli,</para>
  <para style="q" vid="PSA 73:1">kwa walii yawawera na mumiyoyu iherepa.<verse eid="PSA 73:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2" />Kumbiti kwa neni weriti pakwegera kulikwala,</para>
  <para style="q" vid="PSA 73:2">shididini hera mentyerebuki,<verse eid="PSA 73:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3" />toziya nfiriti kuwera handa wanamtiti,</para>
  <para style="q" vid="PSA 73:3">pamoniti wamota kwa kutenda vidoda.<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4" />Mana wantu awa waheriti ntabiku,</para>
  <para style="q" vid="PSA 73:4">toziya nshimba zawu zyana afiya na wana makakala.<verse eid="PSA 73:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5" />Wapatandiri ntabiku zyaziwapata wantu wamonga,</para>
  <para style="q" vid="PSA 73:5">wapatandiri makomangu handa wantu wamonga.<verse eid="PSA 73:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6" />Hangu mtiti guwera handa ukufu wawu msingu,</para>
  <para style="q" vid="PSA 73:6">unkondu ndo handa nguwu yawu.<verse eid="PSA 73:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7" />Ukontola ulawa mumiyoyu ya hawa yawanenepiti,</para>
  <para style="q" vid="PSA 73:7">mipangu idoda ilawa mu mahala mwawu.<verse eid="PSA 73:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8" />Wawajongera wamonga na kulonga madoda,</para>
  <para style="q" vid="PSA 73:8">walitumba na kupanga kuwawonera wamonga.<verse eid="PSA 73:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9" />Kwa milomu yawu wigiranga mpindi,</para>
  <para style="q" vid="PSA 73:9">kwa milimi yawu wakolamlima pasipanu,<verse eid="PSA 73:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10" />ata wantu wa Mlungu wafata shawatenda,</para>
  <para style="q" vid="PSA 73:10">na kwamini kila shawatakula.<verse eid="PSA 73:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="PSA 73:11" />Walonga, “Mlungu hakavimani hashi!</para>
  <para style="q" vid="PSA 73:11">Mlungu mkulu hapeni kawezi kuyambula.”<verse eid="PSA 73:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12" />Hangu ndo wantu wakontola ntambu yawawera,</para>
  <para style="q" vid="PSA 73:12">wana kila shintu na wendeleya kupata lunda nentu.<verse eid="PSA 73:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13" />Nakaka, nigatula mumoyu mwangu hera</para>
  <para style="q" vid="PSA 73:13">nawa mawoku gangu pota toziya.<verse eid="PSA 73:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14" />Paluwala poseri mpata makomangu,</para>
  <para style="q" vid="PSA 73:14">kila mandawira mpata ntabiku.<verse eid="PSA 73:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15" />Handa mentakuli handa womberi,</para>
  <para style="q" vid="PSA 73:15">meweri mgalambuka muwamu mwa wantu waku.<verse eid="PSA 73:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16" />Panjeriti kuvimana mirandu ayi</para>
  <para style="q" vid="PSA 73:16">iweriti ikamala kwa neni,<verse eid="PSA 73:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17" />mpaka paningiriti pananagala pa Mlungu.</para>
  <para style="q" vid="PSA 73:17">Ndo panivimaniti mpeleru zyawu.<verse eid="PSA 73:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18" />Nakaka gwenga haguwatuli pahala patyelebuka,</para>
  <para style="q" vid="PSA 73:18">guwatenda waguwi na kwagamira.<verse eid="PSA 73:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19" />Guloli ntambu yawagamiziwa vumu</para>
  <para style="q" vid="PSA 73:19">na kuwusilirwa kutali kwa vitiriziwu.<verse eid="PSA 73:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20" />Handa muntu yakalota mandawira,</para>
  <para style="q" vid="PSA 73:20">gwee Mtuwa, pagugoloka womberi hawawusiwi katepu.<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21" />Moyu gwangu gutenditwi</para>
  <para style="q" vid="PSA 73:21">shaka paweriti na utama murohu,<verse eid="PSA 73:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22" />weriti pukapuka na mzigizigi,</para>
  <para style="q" vid="PSA 73:22">weriti handa kanyama kulongolu kwaku.<verse eid="PSA 73:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23" />Ata hangu napamuhera na gwenga,</para>
  <para style="q" vid="PSA 73:23">Gunkola liwoku lyangu lya kumliwu.<verse eid="PSA 73:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24" />Gwenga gunonguziya kwa magambiziwu gaku,</para>
  <para style="q" vid="PSA 73:24">upeleru hagunanki kwa ligoya.<verse eid="PSA 73:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25" />Gaa yawera nayu kumpindi ila gwenga?</para>
  <para style="q" vid="PSA 73:25">Na pasipanu kwahera shanfira ila gwenga!<verse eid="PSA 73:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26" />Nshimba na moyu gwangu guweza kusinda,</para>
  <para style="q" vid="PSA 73:26">kumbiti Mlungu, ndo likakala lya moyu gwangu,</para>
  <para style="q" vid="PSA 73:26">na yomberi ndo kila shintu shanfira mashaka goseri.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27" />Yawalitula gweka na gwenga, nakaka hawagamiri.</para>
  <para style="q" vid="PSA 73:27">Haguwalagi woseri yawawerandiri waminika.<verse eid="PSA 73:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28" />Kumbiti kwaneni mbaka kuwera pakwegera na Mlungu,</para>
  <para style="q" vid="PSA 73:28">nimtenda Mlungu kuwera tugira yangu.</para>
  <para style="q" vid="PSA 73:28">Naneni hambweri vitwatira vyoseri vyagutenditi!<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s">Maluwa ga kukombolwa kwa isi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1" />Gwee Mlungu, hashi gutuleka?</para>
  <para style="q" vid="PSA 74:1">Mbona gwana maya kwa kondolu wa maliwuziwu gaku?<verse eid="PSA 74:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2" />Guliholi lijojoniku lyaku lyagulipatiti makashu,</para>
  <para style="q" vid="PSA 74:2">lyagulikomboliti liweri likabila lya uhala waku,</para>
  <para style="q" vid="PSA 74:2">lugongu Sayuni lwagulutenditi pahala paku pagulikala.<verse eid="PSA 74:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3" />Gupiti mumahami aga ga kwanjira makashu.</para>
  <para style="q" vid="PSA 74:3">Wankondu wahalibisiya kila shintu pa numba yaku.<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4" />Wankondu waku wanemelera ukanka Mnumba Nkulu mwaku,</para>
  <para style="q" vid="PSA 74:4">watula amu bendela zawu za ukanka.<verse eid="PSA 74:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5" />Walifana na mkata mbawu,</para>
  <para style="q" vid="PSA 74:5">yakakata mitera kwa liwagu lyakuyi.<verse eid="PSA 74:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6" />Wamegitimegiti vintu vyoseri vya mbawu,</para>
  <para style="q" vid="PSA 74:6">kwa liwagu na nyundu zawu.<verse eid="PSA 74:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7" />Walunguziyiti motu pananagala paku,</para>
  <para style="q" vid="PSA 74:7">wapatula humba pahala litawu lyaku likwiswa.<verse eid="PSA 74:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8" />“Walongiti mumoyu mwawu hatupaagamiziyi nakamu,</para>
  <para style="q" vid="PSA 74:8">pahala poseri paisi,</para>
  <para style="q" vid="PSA 74:8">pawaliwona kumguwira Mlungu.”<verse eid="PSA 74:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9" />Hapeni tuwoni kayi langaliru kulawa kwa Mlungu,</para>
  <para style="q" vid="PSA 74:9">twahera kayi mbuyi yoseri,</para>
  <para style="q" vid="PSA 74:9">pota kwahera yakavimana upeleru wa goseri aga.<verse eid="PSA 74:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10" />Gwee Mlungu, mpakandii wankondu hawakuseki?</para>
  <para style="q" vid="PSA 74:10">Hashi, hawaligirangi litawu lyaku mashaka goseri?<verse eid="PSA 74:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11" />Mbona gulififa liwoku lyaku? Yina liwoku lyaku lya kumliwu</para>
  <para style="q" vid="PSA 74:11">gulilaviyi munguwu yaku na guwagamiziyi.<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12" />Kumbiti gwenga Mlungu ndo mfalumi gwangu kwanjira makashu,</para>
  <para style="q" vid="PSA 74:12">gutenda makulu ga ulopola pasipanu.<verse eid="PSA 74:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 74:13" />Kwa uwezu waku ukulu guyibagula bahari,</para>
  <para style="q" vid="PSA 74:13">guyimega mituyi ya wankanyama wakulu wa bahari.<verse eid="PSA 74:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14" />Gwenga guyiponditi mituyi ya Lewiatani,</para>
  <para style="q" vid="PSA 74:14">guwapanana wankanyama wa kushiwala shiweri shiboga shawu.<verse eid="PSA 74:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 74:15" />Gwenga ndo yagutenditi bwiru za mashi yaziyumandiri</para>
  <para style="q" vid="PSA 74:15">na kuziyumiziya nshemba nkulu.<verse eid="PSA 74:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16" />Paluwala ndo paku na pashiru ndo paku,</para>
  <para style="q" vid="PSA 74:16">gutula lyezi na mshenji pahala pakuyi.<verse eid="PSA 74:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17" />Gwenga gutula mbaka zoseri ya pasipanu,</para>
  <para style="q" vid="PSA 74:17">gupanga shaka sha mpepu na shaka sha livuki.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18" />Gwee Mtuwa Mlungu, guloli mahigiranga ga wankondu waku.</para>
  <para style="q" vid="PSA 74:18">Wantu wazigizigi ntambu yawalibeza litawu lyaku.<verse eid="PSA 74:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19" />Naguwasira wanyama wakalipa wang'unda waku,</para>
  <para style="q" vid="PSA 74:19">nagulyaluwa ukomu wa wantu waku yawatabika mashaka goseri.<verse eid="PSA 74:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20" />Guliholi lipatanu lyaku,</para>
  <para style="q" vid="PSA 74:20">toziya pahala pa lwindu mu isi pamema unkesera.<verse eid="PSA 74:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21" />Naguwaleka yawayonelwa wasoniziwi,</para>
  <para style="q" vid="PSA 74:21">guwatendi wahushu na wananfiru walizyumi litawu lyaku.<verse eid="PSA 74:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22" />Gwee Mlungu, gugoloki gulikomangiri gamweni,</para>
  <para style="q" vid="PSA 74:22">guholi ntambu yagwigirangwa na wazigizigi paluwala poseri.<verse eid="PSA 74:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23" />Nagulyaluwa mashowanganu ga wankondu waku na</para>
  <para style="q" vid="PSA 74:23">ndewu za mashaka goseri za wasingani waku.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s">Mlungu ndo mtoza</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 75:1" />Gwee Mlungu mayagashii,</para>
  <para style="q" vid="PSA 75:1">tulonga mayagashii!</para>
  <para style="q" vid="PSA 75:1">Toziya litawu lyaku lyapakwegera</para>
  <para style="q" vid="PSA 75:1">wantu watamba matendu gaku ga kulikangasha.<verse eid="PSA 75:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2" />Mlungu kalonga. “Neni ndo yantula shaka sha gweka!</para>
  <para style="q" vid="PSA 75:2">Shaka ashi hantozi pota kupendeleya.<verse eid="PSA 75:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3" />Shaka isi payilendemera na vyoseri vyaviwera amu,</para>
  <para style="q" vid="PSA 75:3">neni ndo yantula miyanjiru yakuyi.<verse eid="PSA 75:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4" />Niwagambira wana mtiti, mleki kulizyuma,</para>
  <para style="q" vid="PSA 75:4">na wakontola namulitumba,<verse eid="PSA 75:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5" />namliwona kuwera wantu wa mana nentu,</para>
  <para style="q" vid="PSA 75:5">pota kutakula visoweru vya kulitumba”<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6" />Kwahera yoseri yakalawa kwagulawa mshenji,</para>
  <para style="q" vid="PSA 75:6">ama kwaguzyeta mshenji, pota kulawa kushiwala yakaweza kumkwisa muntu.<verse eid="PSA 75:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7" />Toziya Mlungu mweni ndo mtoza,</para>
  <para style="q" vid="PSA 75:7">kamsulusiya yumu na kumkweniziya yumonga.<verse eid="PSA 75:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8" />Mtuwa Mlungu kakola shikombi mumawoku,</para>
  <para style="q" vid="PSA 75:8">shashimemiti divayi yayikalipa,</para>
  <para style="q" vid="PSA 75:8">kayimintira na wakontola woseri wankuilanda,</para>
  <para style="q" vid="PSA 75:8">yina wankuilanda mpaka lindonta lya upeleru.<verse eid="PSA 75:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9" />Kumbiti neni hanemeleri mashaka goseri,</para>
  <para style="q" vid="PSA 75:9">hanimwimbili zyuma Mlungu gwa Yakobu.<verse eid="PSA 75:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10" />Mlungu kalonga, “Hamegi likakala lyoseri lya wantu wakontola,</para>
  <para style="q" vid="PSA 75:10">kumbiti makakala ga wantu yawana haki hagagangamaziwi.”<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s">Mlungu mkanka</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 76:1" />Mlungu kamanika mu isi ya Yuda,</para>
  <para style="q" vid="PSA 76:1">litawu lyakuyi ndo likulu mu Israeli.<verse eid="PSA 76:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2" />Lilingu lyakuyi lya aku Salemu,</para>
  <para style="q" vid="PSA 76:2">na kalikala aku kulugongu Sayuni.<verse eid="PSA 76:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3" />Aku kamegiti misali ya motu yawankondu,</para>
  <para style="q" vid="PSA 76:3">lusegeyu na magumba na vikomangiru vyoseri vya nkondu.<verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4" />Gwee Mlungu, gukwiswa na mkulu nentu,</para>
  <para style="q" vid="PSA 76:4">kuliku migongu yayimema wanyama wa muntundu.<verse eid="PSA 76:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5" />Yawana makakala wapokitwi lopola zawu,</para>
  <para style="q" vid="PSA 76:5">toziya wagonjiti fofofu,</para>
  <para style="q" vid="PSA 76:5">Makambaku wa nkondu wawezandiri kunyasula mawoku gawu kulikomanga.<verse eid="PSA 76:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6" />Gwee Mlungu gwa Yakobu, paguwakalipiliti,</para>
  <para style="q" vid="PSA 76:6">farasi na wakwenafarasi waguwiti na kuhowa.<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7" />Gwee Mlungu, ndo gwa kutiliziya nentu!</para>
  <para style="q" vid="PSA 76:7">Gaa yakaweza kugoloka kulongolu kwaku pagukalala?<verse eid="PSA 76:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8" />Gubweriti toza yaku kulawa kumpindi,</para>
  <para style="q" vid="PSA 76:8">pasipanu poseri patiliti na kunyamala jii,<verse eid="PSA 76:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9" />pagugolokiti kutoza,</para>
  <para style="q" vid="PSA 76:9">nakuwalopola woseri yawawoneritwi pasipanu.<verse eid="PSA 76:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10" />Maya gaku kwa wantu gakujegera zyuma,</para>
  <para style="q" vid="PSA 76:10">yawaponikiti kulawirana na maya gaku hawakombolwi.<verse eid="PSA 76:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11" />Mlirapi kwa Mtuwa Mlungu, Mlungu gwenu na mshitendi shamlongiti,</para>
  <para style="q" vid="PSA 76:11">mwenga yamuwera pakwegera mmupanani Mlungu gwa kutiliziya mafupu.<verse eid="PSA 76:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12" />Yomberi kawalaga wakulu,</para>
  <para style="q" vid="PSA 76:12">na kawatiriziya wafalumi wa pasipanu.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s">Kunyamaziwa shaka sha ntabiku</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 77:1" />Nimlilira Mlungu kwa liziwu,</para>
  <para style="q" vid="PSA 77:1">kwa kubota nimlilira Mlungu su kampikiniri.<verse eid="PSA 77:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2" />Shaka sha ntabiku nimluwa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 77:2">nimtalapisiya liwoku lyangu pashiru pota kutoka,</para>
  <para style="q" vid="PSA 77:2">kumbiti nyamaziwandiri.<verse eid="PSA 77:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3" />Panikuholera Mlungu hinginika,</para>
  <para style="q" vid="PSA 77:3">panikuhola mumoyu gwangu gutwezuka.<verse eid="PSA 77:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4" />Guntenda nang'onja pashiru poseri,</para>
  <para style="q" vid="PSA 77:4">weriti nammagaziwu ata sinda kutakula.<verse eid="PSA 77:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5" />Nankulihola mashaka ga makashu,</para>
  <para style="q" vid="PSA 77:5">vinja vivuwa vyavipititi.<verse eid="PSA 77:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6" />Pashiru niliholiti lwimbu lwanimbiti,</para>
  <para style="q" vid="PSA 77:6">moyu gwangu gulihola</para>
  <para style="q" vid="PSA 77:6">rohu yangu ilikosiya,<verse eid="PSA 77:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7" />“Hashi, Mtuwa Mlungu katuleka mashaka goseri?</para>
  <para style="q" vid="PSA 77:7">Hashi, hapeni katutenderi maheri kayi?<verse eid="PSA 77:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8" />Hashi, ufiru wakuyi woya nakamu?</para>
  <para style="q" vid="PSA 77:8">Hashi, hapeni katendi kayi shakalongiti?<verse eid="PSA 77:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9" />Hashi, Mlungu kalyaluwa kuwera na lusungu?</para>
  <para style="q" vid="PSA 77:9">Hashi, maya gakuyi galewelera lusungu lwakuyi?”<verse eid="PSA 77:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10" />Shakapanu ntakula, “Ashi ndo shashintama nentu,</para>
  <para style="q" vid="PSA 77:10">Mlungu Mkulu kagalambuka katutenderandiri kayi shintu!”<verse eid="PSA 77:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11" />Hanigaholi matendu ga Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 77:11">hanigaholi makangashu gaku ga makashu.<verse eid="PSA 77:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12" />Hanigaholi mahengu gaku goseri,</para>
  <para style="q" vid="PSA 77:12">na kugahola matendu gaku makulu.<verse eid="PSA 77:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13" />Gwee Mlungu njira yaku ndo nanagala.</para>
  <para style="q" vid="PSA 77:13">Mlungu gaa yakawera mkulu handa gwenga Mlungu gwetu?<verse eid="PSA 77:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14" />Gwenga ndo Mlungu yagutenda makangashu,</para>
  <para style="q" vid="PSA 77:14">gwenga gugalanguziya maisi uwezu waku.<verse eid="PSA 77:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15" />Kwa liwoku lyaku lya likakala guwakombola wantu waku,</para>
  <para style="q" vid="PSA 77:15">guukombola wiwuka wa Yakobu na Yusufu.<verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16" />Mashi pagakuwoniti gwee Mlungu gakutira,</para>
  <para style="q" vid="PSA 77:16">makupala ga mashi galendemera.<verse eid="PSA 77:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17" />Mawundi galaviyiti mashi gavuwa,</para>
  <para style="q" vid="PSA 77:17">nguguma ziguguma kuliyera,</para>
  <para style="q" vid="PSA 77:17">na misali yaku ieneya kila pahala.<verse eid="PSA 77:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18" />Ngugumu ipikanilika mulyega,</para>
  <para style="q" vid="PSA 77:18">lumeta lwaku lulangala pasipanu,</para>
  <para style="q" vid="PSA 77:18">pasipanu patikinyika na kulendemera.<verse eid="PSA 77:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19" />Gwenga gutuliti njira yaku pampindi pa bahari,</para>
  <para style="q" vid="PSA 77:19">gutyangiti pampindi pa mashi matali,</para>
  <para style="q" vid="PSA 77:19">kumbiti zayu zaku ziwonekandiri.<verse eid="PSA 77:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20" />Guwalongoziyiti wantu waku handa kondolu,</para>
  <para style="q" vid="PSA 77:20">pawalongoziwa na Musa na Aruni.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s">Mlungu na wantu wakuyi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 78:1" />Mpikiniri mafunda gangu, mwenga wantu waneni,</para>
  <para style="q" vid="PSA 78:1">mpikiniri vyantakula.<verse eid="PSA 78:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2" />Hantakuli na mwenga kwa mafumbu,</para>
  <para style="q" vid="PSA 78:2">hantakuli vitwatira vyavififikiti kwanjira makashu,<verse eid="PSA 78:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3" />galii gatupikiniriti na kuvimana,</para>
  <para style="q" vid="PSA 78:3">galii gawatugambiriti wazewi wetu.<verse eid="PSA 78:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4" />Hapeni tuwafifi wana wetu,</para>
  <para style="q" vid="PSA 78:4">kumbiti hatushitambili shiyuwuku shashiza,</para>
  <para style="q" vid="PSA 78:4">matendu yagafiruwa zyuma kwa Mtuwa Mlungu na uwezu wakuyi,</para>
  <para style="q" vid="PSA 78:4">hatuwagambiri makangashu gakuyi gakatenditi.<verse eid="PSA 78:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5" />Kawapananiti lagalira wiwuka wa Yakobu,</para>
  <para style="q" vid="PSA 78:5">katuliti lagiru muisraeli,</para>
  <para style="q" vid="PSA 78:5">zeni kawalagaliti wazewi wetu,</para>
  <para style="q" vid="PSA 78:5">wawafundi wana wawu,<verse eid="PSA 78:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6" />su shiyiwuku shashiza wazimani na</para>
  <para style="q" vid="PSA 78:6">wana yanawiwuki,</para>
  <para style="q" vid="PSA 78:6">wazimani na</para>
  <para style="q" vid="PSA 78:6">womberi viraa wawamaniziyi wana wawu.<verse eid="PSA 78:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7" />Su wamtulili Mlungu litumbiru lyawu,</para>
  <para style="q" vid="PSA 78:7">nawiza kulwaluwa matendu gakuyi,</para>
  <para style="q" vid="PSA 78:7">su wagakoli malagiru gakuyi.<verse eid="PSA 78:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8" />Nawalifana na wazewi wawu,</para>
  <para style="q" vid="PSA 78:8">wantu yawanamtiti na wagalambuka,</para>
  <para style="q" vid="PSA 78:8">weni rohu zyawu ziweritindiri na uaminika kwa Mlungu,</para>
  <para style="q" vid="PSA 78:8">na miyoyu yawu imwaminitindiri.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9" />Wantu wa Efuraimu yawapapiti, upindi na misali mumawoku,</para>
  <para style="q" vid="PSA 78:9">wawuyiti kumbeli na kutuga lishaka lilii lya nkondu.<verse eid="PSA 78:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10" />Walikolandiri lipatanu lya Mlungu,</para>
  <para style="q" vid="PSA 78:10">walemiti kufata lagiru lyakuyi.<verse eid="PSA 78:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11" />Waliyaluwiti mirandu yakatenditi,</para>
  <para style="q" vid="PSA 78:11">mauzauza gakaweriti kawalanguziya.<verse eid="PSA 78:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12" />Katenditi makangashu kulongolu kwa wambuyi wawu,</para>
  <para style="q" vid="PSA 78:12">kululalanda lwa Soani muisi ya Misri.<verse eid="PSA 78:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13" />Kayibaguliti bahari na kuwapitiziya wantu amu,</para>
  <para style="q" vid="PSA 78:13">kagatenditi mashi gagoloki handa shibambaza.<verse eid="PSA 78:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14" />Paluwala kawalongoziya kwa liwundi,</para>
  <para style="q" vid="PSA 78:14">pashiru poseri kwa gulangala gwa motu.<verse eid="PSA 78:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15" />Kulii kushiwala kagapantangiti matalabuhi,</para>
  <para style="q" vid="PSA 78:15">kawalandaziya mashi kulawa mumashimatali.<verse eid="PSA 78:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16" />Katenditi nshemba zilawi mulitalabuhi na</para>
  <para style="q" vid="PSA 78:16">kanyililiziyiti mashi handa nshemba.<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17" />Ata hangu wendeleya kumtendera vidoda Mlungu mkulu nentu,</para>
  <para style="q" vid="PSA 78:17">wamgalambukiti Mlungu mkulu kushiwala kulii.<verse eid="PSA 78:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18" />Wamjeriti Mlungu ng'anji,</para>
  <para style="q" vid="PSA 78:18">pawafira viboga vyawafiriti.<verse eid="PSA 78:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19" />Wamtakula Mlungu pawalonga,</para>
  <para style="q" vid="PSA 78:19">“Hashi, Mlungu kaweza kutupanana shiboga kushiwala?<verse eid="PSA 78:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20" />Nakaka, kalikomiti litalabuhi,</para>
  <para style="q" vid="PSA 78:20">mashi gavuwa gabwitula na vishemba vilaviya mashi gavuwa;</para>
  <para style="q" vid="PSA 78:20">ntambugaa kaweza kutupanana shiboga na</para>
  <para style="q" vid="PSA 78:20">kuwapanana wantu wakuyi vinofu?”<verse eid="PSA 78:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21" />Mtuwa Mlungu, pakapikiniriti aga, keniti maya nentu</para>
  <para style="q" vid="PSA 78:21">na motu gulawira kwa wiwuka wa Yakobu na</para>
  <para style="q" vid="PSA 78:21">maya gakuyi kwa wantu wa Israeli,<verse eid="PSA 78:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22" />toziya wamjimiritindiri Mlungu,</para>
  <para style="q" vid="PSA 78:22">pota kwamini ukombola wakuyi.<verse eid="PSA 78:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23" />Ata hangu kagalagalira mawundi ga kumpindi na</para>
  <para style="q" vid="PSA 78:23">kayivugula milyangu ya kumpindi,<verse eid="PSA 78:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24" />kawasulusiriti mana su walii,</para>
  <para style="q" vid="PSA 78:24">kawapanana viboga kulawa kumpindi.<verse eid="PSA 78:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25" />Wantu waliyiti shiboga sha ntumintumi gwa kumpindi na</para>
  <para style="q" vid="PSA 78:25">yomberi kawajegeriti shiboga shakwikutuziya.<verse eid="PSA 78:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26" />Kumpindi kulii kalijegiti liyega lya kwagulawa mshenji na</para>
  <para style="q" vid="PSA 78:26">kalilongoziya liyega lya kusika kwa likakala lyakuyi,<verse eid="PSA 78:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27" />kawajegera wantu wakuyi vinofu vivuwa,</para>
  <para style="q" vid="PSA 78:27">wampongu wavuwa handa mhanga gwa kumpwani,<verse eid="PSA 78:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28" />wampongu awa watulukiti mukambi mwawu,</para>
  <para style="q" vid="PSA 78:28">wega zoseri kuzyengeta malingu gawu.<verse eid="PSA 78:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29" />Wantu waliyiti na kuleka,</para>
  <para style="q" vid="PSA 78:29">toziya Mlungu kawapanana shawafiriti.<verse eid="PSA 78:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30" />Pamberi pa kumalira matamata yawu,</para>
  <para style="q" vid="PSA 78:30">shiboga pashiwera mumlomu mwawu,<verse eid="PSA 78:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31" />maya ga Mlungu gakalipiti kuusu womberi,</para>
  <para style="q" vid="PSA 78:31">kawalaga yawana makakala muwamu mwawu</para>
  <para style="q" vid="PSA 78:31">na kuwagusiya wantemba wa Israeli.<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32" />Ata hangu wandeleyiti kutenda vidoda na</para>
  <para style="q" vid="PSA 78:32">waminitindiri makangashu gakuyi.<verse eid="PSA 78:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33" />Su, kagadumula mashaka gawu handa pumula,</para>
  <para style="q" vid="PSA 78:33">na vinja vyawu kwa vitiriziwu.<verse eid="PSA 78:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34" />Kila pakawalagiti,</para>
  <para style="q" vid="PSA 78:34">yawasigaliti wamwuyira Mlungu,</para>
  <para style="q" vid="PSA 78:34">walekiti vidoda na wamgalambukira Mlungu kwa moyu.<verse eid="PSA 78:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35" />Waliholiti handa Mlungu kaweriti litalabuhi lyawu,</para>
  <para style="q" vid="PSA 78:35">Mlungu Mkulu nentu kaweriti mkombola gwawu.<verse eid="PSA 78:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36" />Kumbiti wamzyangiti kwa visoweru vyawu,</para>
  <para style="q" vid="PSA 78:36">kila shawamgambiriti shiweriti mpayu.<verse eid="PSA 78:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37" />Waweritindiri pamuhera na yomberi kwa moyu,</para>
  <para style="q" vid="PSA 78:37">waweritindiri waminika kwa lipatanu lyakuyi.<verse eid="PSA 78:37" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="38" style="v" sid="PSA 78:38" />Kumbiti Mlungu yakana lusungu kwa wantu wakuyi,</para>
  <para style="q" vid="PSA 78:38">kawalekiziya ukontola wawu na</para>
  <para style="q" vid="PSA 78:38">pota kawangamizandiri.</para>
  <para style="q" vid="PSA 78:38">Mala zitangala kagaleweleriti maya gakuyi,</para>
  <para style="q" vid="PSA 78:38">nagawonekana goseri.<verse eid="PSA 78:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39" />Kaholiti handa womberi ndo wantu hera,</para>
  <para style="q" vid="PSA 78:39">ndo handa lyega lyalipita na kwagamira.<verse eid="PSA 78:39" /></para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40" />Mala ninga wamgalambukiti kushiwala kulii na</para>
  <para style="q" vid="PSA 78:40">kumkalaziya kulii kushiwala!<verse eid="PSA 78:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41" />Wamjeriti Mlungu mala zivuwa,</para>
  <para style="q" vid="PSA 78:41">wamkalaziyiti ayu mananagala gwa Israeli.<verse eid="PSA 78:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42" />Waliholitindiri likakala lyakuyi,</para>
  <para style="q" vid="PSA 78:42">pota lishaka lilii pakawalopoliti na wankondu wawu,<verse eid="PSA 78:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43" />pakatenditi makangashu muisi ya Misri na</para>
  <para style="q" vid="PSA 78:43">mauzauza kululalanda lwa Soani.<verse eid="PSA 78:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44" />Kazigalambuliti nshemba zyawu kuwera mwazi,</para>
  <para style="q" vid="PSA 78:44">su Wamisri nawapata mashi ga kulanda.<verse eid="PSA 78:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45" />Kawajegeriti vipinga vya wavinkozi yawawashenyeyiti na</para>
  <para style="q" vid="PSA 78:45">vyuli vihalibisiya<verse eid="PSA 78:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46" />Kawatumiti wanjombi, waliyiti viboga vyawu na</para>
  <para style="q" vid="PSA 78:46">na mabwajubwaju gawalimiti.<verse eid="PSA 78:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47" />Kahalibisiyiti mizabibu yawu kwa mvula ya mabuwi na</para>
  <para style="q" vid="PSA 78:47">mitini yawu kwa mvula nkulu.<verse eid="PSA 78:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48" />Kawatowera wang'ombi wawu mvula ya mabuwi na</para>
  <para style="q" vid="PSA 78:48">kondolu wawu kwa lupanta.<verse eid="PSA 78:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49" />Kalekiti maya gakuyi gakalipa gawakalipili,</para>
  <para style="q" vid="PSA 78:49">Maya na shuki na ntabiku,</para>
  <para style="q" vid="PSA 78:49">handa shipinga sha ntumintumi wa kumpindi waagamiziya.<verse eid="PSA 78:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50" />Kalekiziyiti maya gakuyi gendereyi,</para>
  <para style="q" vid="PSA 78:50">pota kuwakwepiziya na kuhowa,</para>
  <para style="q" vid="PSA 78:50">ila kawaagamiziyiti kwa tauni.<verse eid="PSA 78:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51" />Kawalagiti wiwuka wa kwanja wapalu woseri wa Wamisri,</para>
  <para style="q" vid="PSA 78:51">wiwuka wa kwanja yawuweriti muliringu lya Hamu.<verse eid="PSA 78:51" /></para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52" />Shakapanu kawalaviyiti wantu wakuyi handa kondolu,</para>
  <para style="q" vid="PSA 78:52">kawalongoziya kushiwala handa shipinga sha mifugu.<verse eid="PSA 78:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53" />Kawalongoziya kwa uponeru pota watirandiri,</para>
  <para style="q" vid="PSA 78:53">kumbiti bahari iwagibikira wankondu wawu.<verse eid="PSA 78:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54" />Kawajegiti muisi yakuyi nanagala,</para>
  <para style="q" vid="PSA 78:54">kulugongu lwakalulopoliti kwa makakala gakuyi.<verse eid="PSA 78:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55" />Kagawingiti maisi kulongolu kwawu,</para>
  <para style="q" vid="PSA 78:55">kaziwusiya isi zawu ziweri lunda ya Israeli,</para>
  <para style="q" vid="PSA 78:55">kagatula makabila ga Israeli mukaya mwawu.<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56" />Ata hangu wamjeriti na kumgalambuka Mlungu Mkulu,</para>
  <para style="q" vid="PSA 78:56">pota wajimirandiri malagalira gakuyi.<verse eid="PSA 78:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57" />Kumbiti wagalambukiti na kutenda madoda handa wazewi wawu,</para>
  <para style="q" vid="PSA 78:57">wawegukaweguka handa upindi yawugangamalandiri.<verse eid="PSA 78:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58" />Wamkalaziyiti kwa vitalawanda vyawu za wamlungu,</para>
  <para style="q" vid="PSA 78:58">wamsongiziya kawoni weya kwa vinyagu vyawu vya kusongola.<verse eid="PSA 78:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59" />Mlungu pakawoniti aga, keniti maya ng'anji,</para>
  <para style="q" vid="PSA 78:59">kamlema Israeli nakamu.<verse eid="PSA 78:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60" />Kalekiti liringu lyakuyi Linanagala aku Shilu,</para>
  <para style="q" vid="PSA 78:60">liringu lyeni kalituliti pakatikati pa wantu.<verse eid="PSA 78:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61" />Kalekiti lisanduku lya likakala lyakuyi litolwi,</para>
  <para style="q" vid="PSA 78:61">uweru wakuyi utulwi mumawoku mwa wankondu.<verse eid="PSA 78:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62" />Kawalaviyiti walaguwi kwa ligumba</para>
  <para style="q" vid="PSA 78:62">kawakalaliriti wantu wakuyi mweni.<verse eid="PSA 78:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63" />Motu guwalunguziya wantemba wawu wapalu,</para>
  <para style="q" vid="PSA 78:63">na wahinga wawu wapatandiri wakuwayuga.<verse eid="PSA 78:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64" />Watambika wawu wahowiti kwa ligumba,</para>
  <para style="q" vid="PSA 78:64">wadala wawu wawezitindiri kudaya.<verse eid="PSA 78:64" /></para>
  <para style="b" />
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65" />Shakapanu Mtuwa Mlungu kimuka handa muntu yakalawiti mumpota,</para>
  <para style="q" vid="PSA 78:65">handa shikambaku yakakalamuziwitwi na divayi.<verse eid="PSA 78:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66" />Kawawinga na kuwakanka wankondu wakuyi,</para>
  <para style="q" vid="PSA 78:66">kawasoniziya mashaka goseri.<verse eid="PSA 78:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67" />Kumbiti kawalemiti wantu wa Yosefu,</para>
  <para style="q" vid="PSA 78:67">pota kulisyagula likabila lya Efraimu,<verse eid="PSA 78:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68" />ila kalisyaguliti likabila lya Yuda,</para>
  <para style="q" vid="PSA 78:68">lugongu sayuni lwakalufiriti.<verse eid="PSA 78:68" /></para>
  <para style="b" />
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69" />Kanyawiti panu Numba Nkulu yakuyi handa migongu,</para>
  <para style="q" vid="PSA 78:69">handa pasipanu yeni yakayigangamiziyiti mashaka goseri.<verse eid="PSA 78:69" /></para>
  <para style="b" />
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70" />Kamsyaguliti Daudi, ntumintumi gwakuyi,</para>
  <para style="q" vid="PSA 78:70">kamwusiyiti mlihengu lya kuwalolera kondolu.<verse eid="PSA 78:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71" />Kamlaviyiti mulihengu lya kuwalolera kondolu na wanakondolu,</para>
  <para style="q" vid="PSA 78:71">kamtenda kaweri mfalumi gwa Israeli,</para>
  <para style="q" vid="PSA 78:71">Kawaloleri wantu wa uhala wakuyi.<verse eid="PSA 78:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72" />Daudi kawashunga kwa moyu gwakuyi goseri,</para>
  <para style="q" vid="PSA 78:72">kawalongoziya kwa luhala lukulu.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s">Luwa ya ukombola wa isi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 79:1" />Gwee Mlungu, wantu wa maisi gamonga wayikankala isi yaku.</para>
  <para style="q" vid="PSA 79:1">Wayitula humba numba Nkulu yaku nanagala</para>
  <para style="q" vid="PSA 79:1">na kugutenda mji gwa Yerusalemu kuwera mahami.<verse eid="PSA 79:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2" />Waleka mauti ga wantumintumi waku wazilii wampongu,</para>
  <para style="q" vid="PSA 79:2">nshimba za wantu waku ziweri shiboga sha wankanyama wa kuntundu.<verse eid="PSA 79:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3" />Wita mwazi gwawu handa mashi,</para>
  <para style="q" vid="PSA 79:3">kuzyengeta wega zoseri za Yerusalemu,</para>
  <para style="q" vid="PSA 79:3">pota kwahera gwa kuwafintira.<verse eid="PSA 79:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4" />Tuwera shintu sha kulikangasha kwa wapakwegera watwenga,</para>
  <para style="q" vid="PSA 79:4">wapakwegera wetu wankutubeziya na kutujongera.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5" />Gwee Mtuwa Mlungu, hagukalali mashaka goseri?</para>
  <para style="q" vid="PSA 79:5">Maya gaku ga weya hagayaki handa motu mpakandii?<verse eid="PSA 79:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6" />Guwakalaliri wantu wa maisi yagakujimirandiri,</para>
  <para style="q" vid="PSA 79:6">na falme zoseri zyazijimirandiri litawu lyaku.<verse eid="PSA 79:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7" />Mana wawalaga wantu wa Yakobu,</para>
  <para style="q" vid="PSA 79:7">wahalibisiya nakamu pahala pakuyi pa kulikala.<verse eid="PSA 79:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8" />Nagulihola vidoda vya watati wetu.</para>
  <para style="q" vid="PSA 79:8">Lusungu lwaku lutwizili kalongola,</para>
  <para style="q" vid="PSA 79:8">mana twahera litumbiru!<verse eid="PSA 79:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9" />Gwee Mlungu, mlopola gwetu,</para>
  <para style="q" vid="PSA 79:9">toziya ya uweru wa litawu lyaku gutulopoli na kutulekiziya vidoda vyetu,</para>
  <para style="q" vid="PSA 79:9">toziya ya ligoya lya litawu lyaku.<verse eid="PSA 79:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10" />Ntambu gaa maisi gatugambili,</para>
  <para style="q" vid="PSA 79:10">kakoshi Mlungu gwenu?</para>
  <para style="q" vid="PSA 79:10">Gututendi tuwoni paguwakomanga wantu wa maisi</para>
  <para style="q" vid="PSA 79:10">kwajili ya malaga ga wantumintumi waku.<verse eid="PSA 79:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11" />Kulira kwa watatirwa awa kukusokeri,</para>
  <para style="q" vid="PSA 79:11">kwa likakala lyaku likulu guwavuguliri yawatozitwi kuhowa.<verse eid="PSA 79:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12" />Gwee Mtuwa Mlungu, guwawuziliri maisi gapakwegera mara saba,</para>
  <para style="q" vid="PSA 79:12">toziya ya mahingirangu gawakwigiriti!<verse eid="PSA 79:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13" />Natwenga wantu waku,</para>
  <para style="q" vid="PSA 79:13">yatuwera kondolu wa maliwuziwu gaku,</para>
  <para style="q" vid="PSA 79:13">hatulongi mayagashi mashaka goseri,</para>
  <para style="q" vid="PSA 79:13">na kukuzyuma viyiwuku mpaka viyiwuku.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s">Luwa kwajili ya isi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 80:1" />Gutupikiniri, Gwee Mshungaji gwa Israeli,</para>
  <para style="q" vid="PSA 80:1">yaguwalonguziya wiwuka wa Yosefu handa shipinga sha wakondolu.</para>
  <para style="q" vid="PSA 80:1">Gwee yagulikala pashiti sha ukulu pakati pa viumbi vyana mbapatiru, gutulangalili,<verse eid="PSA 80:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2" />kulongolu kwa Efraimu, Benjamini na Manasi.</para>
  <para style="q" vid="PSA 80:2">Gulanguziyi likakala lyaku</para>
  <para style="q" vid="PSA 80:2">gwizi kutulopola!<verse eid="PSA 80:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3" />Gwee Mlungu gutuwuziyi,</para>
  <para style="q" vid="PSA 80:3">gutuloli kwa lusungu lwaku na kutulopola.<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4" />Gwee Mtuwa Mlungu, Mlungu gwa Mashonta,</para>
  <para style="q" vid="PSA 80:4">mpaka ndii hagugakalaliri maluwa ga wantu waku?<verse eid="PSA 80:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5" />Gutupanana libumunda lya masozi,</para>
  <para style="q" vid="PSA 80:5">gutulandaziya masozi gavuwa.<verse eid="PSA 80:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6" />Gututenda tuweri beziwu kwa wapakwegera wetu,</para>
  <para style="q" vid="PSA 80:6">wankondu wetu wankutujongera.<verse eid="PSA 80:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7" />Gwee Mlungu gwa mashonta, gutuwuziyi,</para>
  <para style="q" vid="PSA 80:7">gutuloli kwa lusungu lwaku na kutulopola,<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8" />Gujegiti mzabibu kulawa Misri,</para>
  <para style="q" vid="PSA 80:8">guwawinga wantu wa maisi gamonga,</para>
  <para style="q" vid="PSA 80:8">na kuguyala muisi yawu.<verse eid="PSA 80:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9" />Gugulimiriti su gukuli,</para>
  <para style="q" vid="PSA 80:9">na gulaviyi mishigira na kweneya muisi yoseri.<verse eid="PSA 80:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10" />Guyigibikiriti migongu kwa shivuni shakuyi,</para>
  <para style="q" vid="PSA 80:10">na ntambi zakuyi zigibika mierezi mikulu.<verse eid="PSA 80:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11" />Ntambi zakuyi zyeneya mpaka kubahali,</para>
  <para style="q" vid="PSA 80:11">ntomoleru zakuyi mpaka kumpeku kulushemba.<verse eid="PSA 80:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12" />Mbona gubomoliti vibambaza vyavizyengekiti?</para>
  <para style="q" vid="PSA 80:12">Vinu kila yakapita kapa zabibu zakuyi,<verse eid="PSA 80:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13" />mtumbi gwa kuntundu kanguguhalibisiya,</para>
  <para style="q" vid="PSA 80:13">na wankanyama wa kuntundu wankugumemena!<verse eid="PSA 80:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14" />Gwee Mlungu yagwana likakala gutuwuyiri,</para>
  <para style="q" vid="PSA 80:14">guloli kulawa kumpindi, guwoni.</para>
  <para style="q" vid="PSA 80:14">Guguloleri mzabibu agu,<verse eid="PSA 80:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15" />guloleri lushigira lwaguyaliti kwa liwoku lyaku lya kumliwu,</para>
  <para style="q" vid="PSA 80:15">mwana mpalu yagumtenditi gangamala kwajili yaku gamweni.<verse eid="PSA 80:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16" />Mzabibu gudumulitwi na kulunguziwa,</para>
  <para style="q" vid="PSA 80:16">guwakalipili na guwagamiziyi.<verse eid="PSA 80:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17" />Liwoku lyaku liweri pampindi pa ulii yagumsyaguliti,</para>
  <para style="q" vid="PSA 80:17">pampindi pa ulii yagumgangamaziyiti kwajili yaku gamweni.<verse eid="PSA 80:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18" />Hapeni tukuleki,</para>
  <para style="q" vid="PSA 80:18">gutupanani ukomu na twenga hatukuzyumi.<verse eid="PSA 80:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19" />Gwee Mtuwa Mlungu, Mlungu Yagwana Makakala gutuwuziyili makakala,</para>
  <para style="q" vid="PSA 80:19">gutuloli kwa lusungu lwaku na gutulopoli.<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s">Lwimbu lwa msambu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 81:1" />Mmwimbili kwa nemeru Mlungu yakawera likakala lyetu,</para>
  <para style="q" vid="PSA 81:1">mmufyapiliri Mlungu gwa Yakobu,<verse eid="PSA 81:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2" />Mwanji kwimba, mgombi ngoma,</para>
  <para style="q" vid="PSA 81:2">mgombi miluli na lingutinguti kwa liziwu liherepa.<verse eid="PSA 81:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3" />Mgombi lipenka kubwera kulawa kwa lyezi,</para>
  <para style="q" vid="PSA 81:3">na viraa lyezi lya pakati, shaka sha msambu gwetu,<verse eid="PSA 81:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4" />ayi ndo lagiru mu Israeli,</para>
  <para style="q" vid="PSA 81:4">ayi ndo lagalira ya Mlungu gwa Yakobu.<verse eid="PSA 81:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5" />Kawapananiti wantu wa Israeli lagalira ali,</para>
  <para style="q" vid="PSA 81:5">pakayikomangiti isi ya Misri.</para>
  <para style="b" vid="PSA 81:5" />
  <para style="q" vid="PSA 81:5">Aku tupikiniriti luga yayimanikandiri,<verse eid="PSA 81:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6" />“Neni mbusiyiti visanka vyaku mumawega,</para>
  <para style="q" vid="PSA 81:6">mbusiya vikapu vizotopa kulawa mumawoku mwawu.<verse eid="PSA 81:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7" />Paguweriti mkutabika gunshemiti nikulopola.</para>
  <para style="q" vid="PSA 81:7">Nikwankuliti pawera nilififa mulupanta.</para>
  <para style="q" vid="PSA 81:7">Nikujeriti kumashi ga Meriba.<verse eid="PSA 81:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8" />Mwenga wantu wangu mpikiniri mabeziwu gangu.</para>
  <para style="q" vid="PSA 81:8">Mbaka memumpikaniri, mwee Israeli.<verse eid="PSA 81:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9" />Nakawera kwa gwenga mlungu muhenga.</para>
  <para style="q" vid="PSA 81:9">Naguguwira nakamu mlungu yumonga.<verse eid="PSA 81:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10" />Neni ndo Mtuwa Mlungu, Mlungu gwenu,</para>
  <para style="q" vid="PSA 81:10">yanikulaviyeni muisi ya Misri.</para>
  <para style="q" vid="PSA 81:10">Mumamuli milomu yenu na neni hanikuliyiziyeni.”<verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11" />“Kumbiti wantu waneni wampikiniritindiri,</para>
  <para style="q" vid="PSA 81:11">Israeli wafiritindiri kunjimira.<verse eid="PSA 81:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12" />Hangu, niwaleka wasigali na unkesera wawu,</para>
  <para style="q" vid="PSA 81:12">wafati matakula gawu weni.<verse eid="PSA 81:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13" />Tembera wantu wa neni mewampikiniri,</para>
  <para style="q" vid="PSA 81:13">Tembera Israeli mewafati njira zyangu,<verse eid="PSA 81:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14" />meniwakanki wankodu wawu kalongola,</para>
  <para style="q" vid="PSA 81:14">meniwakomangi watabisiya wawu.<verse eid="PSA 81:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15" />Yawamkalalira Mtuwa mewamnsuntamaliri kwa lyoga,</para>
  <para style="q" vid="PSA 81:15">na nkomangu zyawu meziweri zya mashaka goseri.<verse eid="PSA 81:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16" />Kumbiti gwee Israeli menikuliyiziyi kwa nganu iherepa,</para>
  <para style="q" vid="PSA 81:16">Menikwikutuziyi kwa lwashi lwalulawa mulitalabuhi.”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s">Mlungu ndo mkolamlima mkulu</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 82:1" />Mlungu kagolokera lijojoniru lyakuyi,</para>
  <para style="q" vid="PSA 82:1">kankulaviya toza mulijojoniru lya wamlungu.<verse eid="PSA 82:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2" />Mpakandii hamtozi pota haki</para>
  <para style="q" vid="PSA 82:2">na kuwapendeleya wantu wakontola?<verse eid="PSA 82:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3" />Mteteyi yawahera likakala na washiwa,</para>
  <para style="q" vid="PSA 82:3">mtuliweri haki zya wahushu na yawawonelwa.<verse eid="PSA 82:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4" />Muwalopoli yawawonerwa na wahushu,</para>
  <para style="q" vid="PSA 82:4">muwalopoli kulawa mumakakala ga wakontola.<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5" />“Kumbiti wavimanandiri shoseri pota kuvimana!</para>
  <para style="q" vid="PSA 82:5">Wankugendagenda muluwindu,</para>
  <para style="q" vid="PSA 82:5">miyanjiru yoseri ya pasipanu ibegiziwa.<verse eid="PSA 82:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6" />Neni nongiti mwenga ndo wamlungu,</para>
  <para style="q" vid="PSA 82:6">mwenga woseri ndo wana wa yakawera kumpindi nentu!<verse eid="PSA 82:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7" />Ata hangu, hamhowi gambira wantu woseri,</para>
  <para style="q" vid="PSA 82:7">hamguwi handa mkulu yoseri.”<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8" />Gwee Mlungu, gugoloki gupatozi pasipanu,</para>
  <para style="q" vid="PSA 82:8">mana maisi goseri ndo uhala waku.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s">Luwa kwajili ya wankondu wa Israeli</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 83:1" />Gwee Mlungu, nagulikala jii!</para>
  <para style="q" vid="PSA 83:1">Gwee Mlungu nagunyamala, pota kulikala hera!<verse eid="PSA 83:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2" />Guloli! Wankondu waku wankutenda ndewi,</para>
  <para style="q" vid="PSA 83:2">yawakukalalira wakala kukugalambuka.<verse eid="PSA 83:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3" />Wapanga vidoda vyakuwatendera wantu waku;</para>
  <para style="q" vid="PSA 83:3">walitakuziyana kuhusu wantu awa yaguwashera.<verse eid="PSA 83:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4" />Walonga, “Mwizi tuyiyagamiziyi isi yawu,</para>
  <para style="q" vid="PSA 83:4">su litawu lya Israeli naliholwa kayi.”<verse eid="PSA 83:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5" />Wajimirana kwa moyu gumu,</para>
  <para style="q" vid="PSA 83:5">watenda lipatanu kuusu gwenga.<verse eid="PSA 83:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6" />Wantu wa Edomu na Waishimaeli,</para>
  <para style="q" vid="PSA 83:6">Wamoabu na wantu wa Hagari,<verse eid="PSA 83:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7" />wantu wa Gebali, Amoni na Amaleki,</para>
  <para style="q" vid="PSA 83:7">wantu wa Filisti na wenikaya wa Tiru.<verse eid="PSA 83:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8" />Ata Ashuru yapamuhera na womberi,</para>
  <para style="q" vid="PSA 83:8">iwatanga wiwuka wa Lutu!<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9" />Guwatenderi ntambu yaguwatenditi wantu wa Midiyani na</para>
  <para style="q" vid="PSA 83:9">ntambu yaguwatenditi Sisera na Yabini mlushemba kishoni,<verse eid="PSA 83:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10" />wantu yaguwalagiti kulii Endori,</para>
  <para style="q" vid="PSA 83:10">wawera handa wolera muisi.<verse eid="PSA 83:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11" />Guwatendi wakulu wawu handa Orebu na Zeebu,</para>
  <para style="q" vid="PSA 83:11">wakolamlima wawu woseri handa Zeba na Salmuna,<verse eid="PSA 83:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12" />Weni walongiti, “Hatuyitori isi ya Mlungu yayina maliwuziwu.”<verse eid="PSA 83:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13" />Gwee Mlungu gwangu, guwagulusiyi handa lidiku mu shivyulavyula,</para>
  <para style="q" vid="PSA 83:13">Handa miwawi yayigulusiwa na lyega.<verse eid="PSA 83:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14" />Handa motu ntambu yagulunguziya lidowi,</para>
  <para style="q" vid="PSA 83:14">handa limbamba ntambu yalilunguziya migongu,<verse eid="PSA 83:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15" />guwatugiziyi awa kwa lipuga lyaku,</para>
  <para style="q" vid="PSA 83:15">na kuwatiliziya kwa lyega lyaku likulu.<verse eid="PSA 83:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16" />Guvimemiziyi vyenu vyawu soni,</para>
  <para style="q" vid="PSA 83:16">wapati kukusakula, gwee Mtuwa Mlungu.<verse eid="PSA 83:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17" />Wasoniziwi na kufezeeka mashaka goseri,</para>
  <para style="q" vid="PSA 83:17">waagamiziwi nakamu kwa soni.<verse eid="PSA 83:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18" />Wavimani kuwera gwenga gwekayaku</para>
  <para style="q" vid="PSA 83:18">litawu lyaku Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 83:18">ndo Mlungu Mkulu pasipanu poseri.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s">Nfiru ya kuwera mu Numba Nkulu ya Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 84:1" />Pahala paku pakulika paherepa nentu!</para>
  <para style="q" vid="PSA 84:1">Gwee Mtuwa Mlungu gwa mashonta!<verse eid="PSA 84:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2" />Moyu gwangu gufira nentu kulikala mungeleri zya Mtuwa Mlungu!</para>
  <para style="q" vid="PSA 84:2">Moyu gwangu na nshimba ya neni vyoseri vimfyapilira Mlungu mkomu.<verse eid="PSA 84:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3" />Viraa shomoru wapata pahala pawu pakulikala,</para>
  <para style="q" vid="PSA 84:3">mbayuwayu wanyawa vitukulu vyawu,</para>
  <para style="q" vid="PSA 84:3">pahala pawaweza kutula wana wawu, pakwegera na vitalawanda vyaku,</para>
  <para style="q" vid="PSA 84:3">gwee Mtuwa Mlungu yagwana makakala, Mfalumi gwangu na Mlungu gwangu!<verse eid="PSA 84:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4" />Mbaka walii yawalikala mu Numba mwaku,</para>
  <para style="q" vid="PSA 84:4">pawimba zyuma mashaka goseri.<verse eid="PSA 84:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5" />Mbaka walii yawapata makakala gawu kulawa kwa gwenga,</para>
  <para style="q" vid="PSA 84:5">yawafira kuguwira kulugongu Sayuni.<verse eid="PSA 84:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6" />Pawapita mululalanda luyuma lwa Baka,</para>
  <para style="q" vid="PSA 84:6">walutenda kuwera pahala pa mbwiru,</para>
  <para style="q2" vid="PSA 84:6">na mvula zya kuyalira zimemiziya mashi.<verse eid="PSA 84:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7" />Hawendereyi kupata likakala nentu,</para>
  <para style="q" vid="PSA 84:7">mpaka wamwoni Mlungu kulugongu lya Sayuni.<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8" />Gwee Mtuwa Mlungu, Mlungu yagwana makakala goseri gumpikiniri kuluwa kwawu,</para>
  <para style="q" vid="PSA 84:8">Gwee Mlungu gwa Yakobu gunyambiri likutu lyaku.<verse eid="PSA 84:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9" />Gwee Mtuwa Mlungu gumtekeleri mfalumi gwetu yakawera lusegeyu lwetu,</para>
  <para style="q" vid="PSA 84:9">gumloli kwa uheri mswagwa lipaki gwaku.<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10" />Lishaka limu mungeleri zyaku,</para>
  <para style="q" vid="PSA 84:10">ndo liherepa kuliku mashaka elufu pahala pamonga,</para>
  <para style="q" vid="PSA 84:10">mbaka kugoloka paligomi pa Numba yaku,</para>
  <para style="q" vid="PSA 84:10">kuliku kulikala ukaya kwa wakontola.<verse eid="PSA 84:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11" />Mana Mtuwa Mlungu ndo mshenji gwetu na litumbiru lyetu,</para>
  <para style="q" vid="PSA 84:11">yomberi katupendereya na kutupanana uweru.</para>
  <para style="q" vid="PSA 84:11">Hapeni kawimi shoseri shiheri,</para>
  <para style="q" vid="PSA 84:11">walii woseri yawatenda gakafira.<verse eid="PSA 84:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12" />Gwee Mtuwa Mlungu yagwana makakala,</para>
  <para style="q" vid="PSA 84:12">mbaka muntu ulii yakakwamini gwenga!<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s">Kuluwira isi tekelera</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 85:1" />Gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 85:1">gulangaziya upenderewu muisi yaku,</para>
  <para style="q" vid="PSA 85:1">guwawuziya walopolwa kwa Yakobu.<verse eid="PSA 85:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2" />Guwalekeziya wantu waku ukontola wawu,</para>
  <para style="q" vid="PSA 85:2">guwusiya vidoda vyawu vyoseri.<verse eid="PSA 85:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3" />Gugalewelera maya gaku goseri,</para>
  <para style="q" vid="PSA 85:3">guwuya na kuleka ukalipa waku.<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4" />Gwee Mlungu mlopola gwetu gutuwuziliri makakala kayi,</para>
  <para style="q" vid="PSA 85:4">gugawusiyi maya gaguwera naga kwa twenga.<verse eid="PSA 85:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5" />Hashi, hagutukalaliri mashaka goseri?</para>
  <para style="q" vid="PSA 85:5">Hashi, hagwendeleyi kuwera na maya kwa viyiwuku vyoseri?<verse eid="PSA 85:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6" />Hashi hapeni gutupanani kayi ukomu,</para>
  <para style="q" vid="PSA 85:6">su wantu waku wakunemeleri?<verse eid="PSA 85:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7" />Gwee Mtuwa Mlungu gutulanguziyi ufiru waku yawuhera na upeleru,</para>
  <para style="q" vid="PSA 85:7">gutupanani ulopola waku.<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8" />Hanishipikiniri shakatakula Mlungu yakawera Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 85:8">mana katakula kuwapanana ponga wantu wakuyi,</para>
  <para style="q" vid="PSA 85:8">kumbuti weni nawawuyira uzigizigi.<verse eid="PSA 85:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9" />Nakaka kakala kuwalopola yawamguwira,</para>
  <para style="q" vid="PSA 85:9">na uweru wakuyi uweri muisi ya twenga mashaka goseri.<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10" />Ufiru na waminika haviliwoni,</para>
  <para style="q" vid="PSA 85:10">haki na ponga haviweri pamuhera.<verse eid="PSA 85:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11" />Waminika hawutomoli muisi,</para>
  <para style="q" vid="PSA 85:11">haki hayisuluki kulawa kumpindi.<verse eid="PSA 85:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12" />Nakaka Mtuwa Mlungu hakatupanani shashiwera shiheri,</para>
  <para style="q" vid="PSA 85:12">na isi ya twenga hayilaviyi mabenangu mavuwa.<verse eid="PSA 85:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13" />Haki hayilongoleri kulongoleru kwakuyi,</para>
  <para style="q" vid="PSA 85:13">na kunyawa njira toziya yakuyi.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s">Kuluwa utanga</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 86:1" />Gwee Mtuwa Mlungu, gumpikiniri na gunankuli,</para>
  <para style="q" vid="PSA 86:1">toziya neni ndo mhushu nahera shintu.<verse eid="PSA 86:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2" />Gugaloleri makaliru gangu mana neni namwaminika kwagwenga,</para>
  <para style="q" vid="PSA 86:2">gundopoli neni ntumintumi gwaku yanikutumbira.<verse eid="PSA 86:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3" />Gwenga ndo Mlungu gwangu,</para>
  <para style="q" vid="PSA 86:3">su, gumoneri lusungu,</para>
  <para style="q" vid="PSA 86:3">toziya nikuliliri paluwala poseri.<verse eid="PSA 86:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4" />Guyinemiziyi rohu ya neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 86:4">mana maluwa gangu nikujegara gwee Mtuwa.<verse eid="PSA 86:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5" />Gwee Mtuwa, gwamheri na yagulekiziya,</para>
  <para style="q" vid="PSA 86:5">ufiru waku ndo uvuwa kwa woseri yawakuluwa.<verse eid="PSA 86:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6" />Gwee Mtuwa Mlungu, gupikanili kuluwa kwangu,</para>
  <para style="q" vid="PSA 86:6">gupikanili kulira kwangu.<verse eid="PSA 86:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7" />Mashaka ga kutabika hanikushemi,</para>
  <para style="q" vid="PSA 86:7">toziya gwenga hagunankuli.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8" />Gwee Mtuwa pakatikati pa wamlungu kwahera yakawera handa gwenga,</para>
  <para style="q" vid="PSA 86:8">kwahera yakaweza kutenda gagutenda gwenga.<verse eid="PSA 86:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9" />Gwee Mtuwa maisi goseri gaguwumbiti, hagizi kukuguwira na</para>
  <para style="q" vid="PSA 86:9">hagabweri ukulu wa litawu lyaku.<verse eid="PSA 86:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10" />Gwenga ndo mkulu, gutenda mauzauza,</para>
  <para style="q" vid="PSA 86:10">gwenga gweka yaku ndo Mlungu.<verse eid="PSA 86:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11" />Gwee Mtuwa Mlungu, gunfundi njira yaku,</para>
  <para style="q" vid="PSA 86:11">mpati kuwera mwaminika kwaku.</para>
  <para style="q" vid="PSA 86:11">Moyo gwangu goseri gunemeleri kulipanana ligoya litawu lyaku.<verse eid="PSA 86:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12" />Gwee Mtuwa Mlungu gwangu, hanikuzyumi kwa moyu gwangu goseri,</para>
  <para style="q" vid="PSA 86:12">habweri ukulu wa litawu lyaku mashaka goseri.<verse eid="PSA 86:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13" />Toziya ufiru waku ndo mkulu kwa neni!</para>
  <para style="q" vid="PSA 86:13">Gundopola kulawa kwa yawahowiti.<verse eid="PSA 86:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14" />Gwee Mlungu, wantu wana mtiti wankomanga,</para>
  <para style="q" vid="PSA 86:14">shipinga sha wantu wankesela wafira kundaga,</para>
  <para style="q" vid="PSA 86:14">pota wakutirandiri gwenga ata shididini.<verse eid="PSA 86:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15" />Kumbiti gwenga Mtuwa, ndo Mlungu gwa lusungu na manemu,</para>
  <para style="q" vid="PSA 86:15">gwenga ndo mhepelera na gwana ufiru uvuwa na waminika.<verse eid="PSA 86:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16" />Gung'alambukiri, gumoneri lusungu,</para>
  <para style="q" vid="PSA 86:16">gunupi likakala lyaku neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 86:16">gumlopoli mwana gwa ntumintumi gwaku mdala.<verse eid="PSA 86:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17" />Gwee Mtuwa Mlungu, gunanguziyi lilangaliru lya uheri waku,</para>
  <para style="q" vid="PSA 86:17">su walii yawankalalira wasoniziwi,</para>
  <para style="q" vid="PSA 86:17">pawawona guntanga na kuzyangazyanga.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s">Zyuma kwa Yerusalemu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 87:1" />Mlungu kanyawa mji gwakuyi</para>
  <para style="q" vid="PSA 87:1">pampindi pa migongu yakuyi minanagala.<verse eid="PSA 87:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2" />Mtuwa Mlungu kayifira migomi ya Sayuni,</para>
  <para style="q" vid="PSA 87:2">kuliku pahala gamonga pa Yakobu.<verse eid="PSA 87:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3" />Mirandu yakukangashwa ikantwa kwa gwenga,</para>
  <para style="q" vid="PSA 87:3">gwee mji gwa Mlungu.<verse eid="PSA 87:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4" />“Hantuli liholu lya Rahabu na Babeli.</para>
  <para style="q" vid="PSA 87:4">Muwamu mwa walii yawanjimira</para>
  <para style="q" vid="PSA 87:4">Filisti, Tiru pamuhera na Esopiya,</para>
  <para style="q" vid="PSA 87:4">woseri wiwukiti amu.”<verse eid="PSA 87:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5" />“Kuusu Sayuni hayitakulwi,</para>
  <para style="q" vid="PSA 87:5">Sayuni ndo mawu gwa ayu na ayu,</para>
  <para style="q" vid="PSA 87:5">Mlungu mkulu hakagugangamaziyi.”<verse eid="PSA 87:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6" />Mtuwa Mlungu hakalembi mushitabu,</para>
  <para style="q" vid="PSA 87:6">walanga ya wantu.</para>
  <para style="q" vid="PSA 87:6">Ayu kiwuka Sayuni!<verse eid="PSA 87:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7" />Yawavina na wimba hawalongi.</para>
  <para style="q" vid="PSA 87:7">“Sayuni shanjiru shetu sha tekelera.”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s">Kulilira utanga</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 88:1" />Gwee Mtuwa Mlungu, mlopola gwangu,</para>
  <para style="q" vid="PSA 88:1">Ndira paluwala poseri,</para>
  <para style="q" vid="PSA 88:1">na pashiru nankwiza kulongolu kwaku.<verse eid="PSA 88:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2" />Luwa ya neni isoki kwaku,</para>
  <para style="q" vid="PSA 88:2">gupikanili kulira kwa neni.<verse eid="PSA 88:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3" />Madoda gavuwa gampata,</para>
  <para style="q" vid="PSA 88:3">neni sambira howa.<verse eid="PSA 88:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4" />Woneka gambira muntu yakafira kuhowa,</para>
  <para style="q" vid="PSA 88:4">makakala gangu goseri gampelera.<verse eid="PSA 88:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5" />Ndulwa pamuhera na wantu yawahowiti,</para>
  <para style="q" vid="PSA 88:5">handa yawalagwitwi, yawawera mlisembi,</para>
  <para style="q" vid="PSA 88:5">walii yaguwahola kayi ndiri,</para>
  <para style="q" vid="PSA 88:5">weni watulwa gweka na ulolera waku.<verse eid="PSA 88:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6" />Gunasa kulisembi litali,</para>
  <para style="q" vid="PSA 88:6">pasi ng'anji paluwindu dunyu.<verse eid="PSA 88:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7" />Maya gaku gantopera,</para>
  <para style="q" vid="PSA 88:7">guntabisiya kwa makupala gaku goseri.<verse eid="PSA 88:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8" />Guwatenda waganja waneni wantugi,</para>
  <para style="q" vid="PSA 88:8">guntenda kuwera likalaliru kwawomberi.</para>
  <para style="q" vid="PSA 88:8">Ng'omiziwa, wezandiri kutuga,<verse eid="PSA 88:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9" />Masu gangu gatifutifu kwa kwinginika.</para>
  <para style="q" vid="PSA 88:9">Kila lishaka nikulilira, Gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 88:9">nikunyasulira mawoku gangu guntangi.<verse eid="PSA 88:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10" />Hashi, gwenga guwatendera yawahoti makangashu gaku?</para>
  <para style="q" vid="PSA 88:10">Hashi, yawahowiti wazyuka na kukuzyuma?<verse eid="PSA 88:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11" />Hashi, ufiru waku ukantwa kulisembi,</para>
  <para style="q" vid="PSA 88:11">ama uwaminika waku pahala pa maagamiziya?<verse eid="PSA 88:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12" />Hashi, makangashu gaku gamanikana mluwindu amu,</para>
  <para style="q" vid="PSA 88:12">ama mirandu ya haki muisi yayilyaluwikitwi?<verse eid="PSA 88:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13" />Kumbiti neni nikulilira, gwee Mtuwa Mlungu guntangi,</para>
  <para style="q" vid="PSA 88:13">kila mandawira nikuluwa.<verse eid="PSA 88:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14" />Gwee Mtuwa Mlungu, hashi gunasira kutali?</para>
  <para style="q" vid="PSA 88:14">Ntambu gaa gunasa?<verse eid="PSA 88:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15" />Ntabika na sambira howa kwanjira untemba wangu,</para>
  <para style="q" vid="PSA 88:15">ntabika kwa makomangu gaku na ntoka nentu.<verse eid="PSA 88:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16" />Maya gaku gangalapira,</para>
  <para style="q" vid="PSA 88:16">makomangu gaku ga kutiriziya gantenda,<verse eid="PSA 88:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17" />gazyengeta handa malawa paluwala poseri,</para>
  <para style="q" vid="PSA 88:17">gazyengeta wega zoseri kwa pamuhera.<verse eid="PSA 88:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18" />Guwatenda waganja na wapakwegera wangu woseri wanshapiri,</para>
  <para style="q" vid="PSA 88:18">luwindu ndo ganja gwangu.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s">Ntabiku ya isi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 89:1" />Gwee Mtuwa Mlungu, hanimbi ufiru waku mashaka goseri,</para>
  <para style="q" vid="PSA 89:1">hanivibweleri viyiwuku vyoseri waminika waku.<verse eid="PSA 89:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2" />Hanongi ufiru waku ulikala mashaka goseri,</para>
  <para style="q" vid="PSA 89:2">waminika waku ugangamala handa kumpindi.<verse eid="PSA 89:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3" />Gulongiti, “Ntenda lipatanu na msyagula gwangu,</para>
  <para style="q" vid="PSA 89:3">nimlapira ntumintumi gwangu Daudi.<verse eid="PSA 89:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4" />Kayi haniwugangamaziyi wiwuka waku mashaka goseri,</para>
  <para style="q" vid="PSA 89:4">na haniwuendelezi ufalumi waku viwuku mpaka viwuku.”<verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5" />Gwee Mtuwa Mlungu, mpindi na zizyumi makangashu gaku,</para>
  <para style="q" vid="PSA 89:5">wantumintu wa kumpindi na wawuzyumi uwaminika waku.<verse eid="PSA 89:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6" />Gaa kumpindi yakaweza kalifaniziya na gwenga Mtuwa Mlungu?</para>
  <para style="q" vid="PSA 89:6">Kwahera yakawera teratera na gwenga pakati pa viwumbi vya kumpindi,<verse eid="PSA 89:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7" />gwee Mlungu gutirwa palijojoniku lya wananagala,</para>
  <para style="q" vid="PSA 89:7">woseri yawakuzyengeta wanalyoga.<verse eid="PSA 89:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8" />Gwee Mtuwa Mlungu, Mlungu yagwana makakala goseri, ndo gaa yakawera na makakala handa gwenga,</para>
  <para style="q" vid="PSA 89:8">gwee Mtuwa Mlungu uwaminika waku ukuzyengeta wega zoseri.<verse eid="PSA 89:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9" />Gwenga gukolamlima bahali payitimbuka,</para>
  <para style="q" vid="PSA 89:9">makupala gakuyi pagakwena gwenga guganyamaziya.<verse eid="PSA 89:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10" />Gumposholiti njoka Rahabu na kumlaga,</para>
  <para style="q" vid="PSA 89:10">guwapasiyiti wankondu waku kwa makakala gaku.<verse eid="PSA 89:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11" />Mpindi ndo za gwenga viraa pasipanu ndo paku,</para>
  <para style="q" vid="PSA 89:11">gunyawiti pasipanu na vintu vyoseri yaviwera amu.<verse eid="PSA 89:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12" />Gwenga gunyawiti kushana na kusika,</para>
  <para style="q" vid="PSA 89:12">Migongu Tabori na Herimoni yankukuzyuma litawu lyaku kwa nemeru.<verse eid="PSA 89:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13" />Liwoku lyaku lyana uwezu,</para>
  <para style="q" vid="PSA 89:13">liwoku lyaku lyana makakala na likanka!<verse eid="PSA 89:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14" />Waminika na haki ndo lyanjiru lya ukolamlima waku,</para>
  <para style="q" vid="PSA 89:14">ufiru na waminika vikulongolera!<verse eid="PSA 89:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15" />Mbaka wantu yawamana kukuzyuma kwa kukufyapilira,</para>
  <para style="q" vid="PSA 89:15">yawatyanga muulangala mwaku, gwee Mtuwa Mlungu.<verse eid="PSA 89:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16" />Wanemelera paluwala poseri toziya ya gwenga,</para>
  <para style="q" vid="PSA 89:16">kwa haki yaku wanyasulwa.<verse eid="PSA 89:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17" />Gwenga ndo mkulu na makakala gawu,</para>
  <para style="q" vid="PSA 89:17">toziya ya shibali shaku tupata ukanka.<verse eid="PSA 89:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18" />Gwee Mtuwa Mlungu, ulolera wetu ulawa kwaku,</para>
  <para style="q" vid="PSA 89:18">mfalumi gwetu kalawa kwa gwenga yaguwera Mnanagala gwa Israeli.<verse eid="PSA 89:18" /></para>
  <para style="s">Shakalongiti Mlungu kwa Daudi</para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19" />Makashu gulongiti mumalola, guwagambiriti wantumintumi waku waminika,</para>
  <para style="q" vid="PSA 89:19">“Nimpanana makakala shikambaku yumu,</para>
  <para style="q" vid="PSA 89:19">nimkwisa ayu yanimsyaguliti pakati pa wantu.<verse eid="PSA 89:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20" />Nimpata Daudi, ntumintumi gwangu,</para>
  <para style="q" vid="PSA 89:20">nimswaga lipaki lyangu kaweri mfalumi.<verse eid="PSA 89:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21" />Liwoku lyangu halimkoleri,</para>
  <para style="q" vid="PSA 89:21">makakala gangu hagamgangamaziyi.<verse eid="PSA 89:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22" />Wankondu hapeni wawezi kumzyanga,</para>
  <para style="q" vid="PSA 89:22">pota wakontola hapeni wamwoneri.<verse eid="PSA 89:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23" />Neni haniwaposholi wankondu wakuyi kulongolu kwakuyi,</para>
  <para style="q" vid="PSA 89:23">haniwagamiziyi wankondu yawamkalalira.<verse eid="PSA 89:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24" />Uaminika na ufiru wangu yawahera mpeleru hawuweri na yomberi,</para>
  <para style="q" vid="PSA 89:24">kwa litawu lyangu hakapati ukanka.<verse eid="PSA 89:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25" />Haniwugangamaziyi ukolamlima wakuyi,</para>
  <para style="q" vid="PSA 89:25">kulawa bahari mpaka nshemba.<verse eid="PSA 89:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26" />Yomberi hakanshemi, gwenga ndo tati gwangu.</para>
  <para style="q" vid="PSA 89:26">Mlungu gwangu, litalabuhi lya ulopola wa neni.<verse eid="PSA 89:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27" />Neni hanimtendi kuwera mwiwuka gwangu gwa kwanja,</para>
  <para style="q" vid="PSA 89:27">mkulu kuliku wafalumi woseri pasipanu.<verse eid="PSA 89:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28" />Ufiru wangu haniutuli mashaka goseri,</para>
  <para style="q" vid="PSA 89:28">na lipatanu lyangu kwakuyi halilikali mashaka goseri.<verse eid="PSA 89:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29" />Haniwugangamiziyi wiwuka wakuyi wa shifalumi mashaka goseri,</para>
  <para style="q" vid="PSA 89:29">na ufalumi wakuyi haulikali handa mpindi mashaka goseri.”<verse eid="PSA 89:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30" />“Wiwuka wakuyi pawuleka lagiru lyangu,</para>
  <para style="q" vid="PSA 89:30">na pawafatandiri malagalira gangu,<verse eid="PSA 89:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31" />handa pawalema kujimira malagalira gangu</para>
  <para style="q" vid="PSA 89:31">na kuleka kukola lagiru zyangu,<verse eid="PSA 89:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32" />haniwasyatangi mboku toziya ya madoda gawu,</para>
  <para style="q" vid="PSA 89:32">haniwakomi kwa makomangu toziya ya ukontola wawu.<verse eid="PSA 89:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33" />Kumbiti hapeni ndeki kumfira Daudi,</para>
  <para style="q" vid="PSA 89:33">pota kuwutenda uwaminika waneni kuwera mpayu.<verse eid="PSA 89:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34" />Hapeni megi lipatanu lyangu na yomberi,</para>
  <para style="q" vid="PSA 89:34">pota kugalambula shisoweru shantakuliti kwakuyi.”<verse eid="PSA 89:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35" />“Nilirapa mala yimu kwa unanagala wa neni,</para>
  <para style="q" vid="PSA 89:35">na neni hapeni nimpayili Daudi.<verse eid="PSA 89:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36" />Wiwuka wakuyi hawulikali mashaka goseri,</para>
  <para style="q" vid="PSA 89:36">na ufalumi wakuyi hawulikali kulongolu kwaneni handa mshenji,<verse eid="PSA 89:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37" />hawulikali mashaka goseri</para>
  <para style="q" vid="PSA 89:37">handa lyezi</para>
  <para style="q" vid="PSA 89:37">ntambu yalilawira kuliyera.”<verse eid="PSA 89:37" /></para>
  <para style="s">Kudaya kwajili ya kusinda kwa mfalumi</para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38" />Kumbiti vinu gwee Mlungu, gumwasa na kumlema,</para>
  <para style="q" vid="PSA 89:38">gumkalalira mfalumi gwaku yagumlumikiti.<verse eid="PSA 89:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39" />Gulimega lipatanu lyagulitenditi na ntumintumi gwaku,</para>
  <para style="q" vid="PSA 89:39">gulyasa lijenjeri lyakuyi mlidikudiku.<verse eid="PSA 89:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40" />Guvibomola vibambaza vyoseri za mji gwakuyi,</para>
  <para style="q" vid="PSA 89:40">gubenanga maboma gakuyi.<verse eid="PSA 89:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41" />Woseri yawapita watola kwa makakala lunda zakuyi,</para>
  <para style="q" vid="PSA 89:41">kawera gwa kubeziwa na wapakwegera wakuyi.<verse eid="PSA 89:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42" />Wankondu wakuyi guwapanana ukanka,</para>
  <para style="q" vid="PSA 89:42">guwanemiziya wankondu wakuyi woseri.<verse eid="PSA 89:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43" />Ligumba lyakuyi gulitenda lidufuki,</para>
  <para style="q" vid="PSA 89:43">gumleka kakankwi kunkondu.<verse eid="PSA 89:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44" />Guwusiyi uweru wakuyi,</para>
  <para style="q" vid="PSA 89:44">guwugusiya ukolamlima wakuyi.<verse eid="PSA 89:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45" />Gupungula mashaka ga untemba wakuyi,</para>
  <para style="q" vid="PSA 89:45">gumsoniziya.<verse eid="PSA 89:45" /></para>
  <para style="s">Luwa ya uponeru</para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46" />Gwee Mtuwa Mlungu, hagulififi mashaka goseri?</para>
  <para style="q" vid="PSA 89:46">Maya gaku hagaki handa motu mpaka ndii?<verse eid="PSA 89:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47" />Guliholi kuwera makaliru gangu gagamira kalongola,</para>
  <para style="q" vid="PSA 89:47">hashi gumuumbiti muntu pota toziya?<verse eid="PSA 89:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48" />Gaa yakaweza kulikala pota kahowi?</para>
  <para style="q" vid="PSA 89:48">Gaa yakaweza kutuga kuhowa?<verse eid="PSA 89:48" /></para>
  <para style="b" />
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49" />Gwee Mtuwa, ufiru waku wamakashu wakoshi,</para>
  <para style="q" vid="PSA 89:49">weni gumlapiliti Daudi kwa waminika waku?<verse eid="PSA 89:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50" />Gwee Mtuwa, guliholi ntambu yakigirangwa ntumintumi gwaku,</para>
  <para style="q" vid="PSA 89:50">ntambu yahepelera pankalipirwa na wantu woseri.<verse eid="PSA 89:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51" />Gwee Mtuwa Mlungu guwona wakondu waku ntambu yawamlonganga mswagwa lipaki gwaku,</para>
  <para style="q" vid="PSA 89:51">ntambu yawamjongera msyagulwa gwaku kila kwakagenda.<verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52" />Kazyumi Mtuwa Mlungu mashaka goseri!</para>
  <para style="b" vid="PSA 89:52" />
  <para style="q" vid="PSA 89:52">Amina, Amina!<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">SHATABU SHA MSHESHI</para>
  <para style="mr">
    <ref loc="PSA 90-106">Zabuli 90-106</ref></para>
  <para style="s">Luwa lya Musa ntumintumi gwa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 90:1" />Gwee Mtuwa, kwanjira viyiwuku vyoseri,</para>
  <para style="q" vid="PSA 90:1">gwenga guwera uponera wa twenga.<verse eid="PSA 90:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2" />Pamberi pa kuwera migongu,</para>
  <para style="q" vid="PSA 90:2">pamberi hagweni umbi pasipanu,</para>
  <para style="q" vid="PSA 90:2">gwenga ndo Mlungu, yagulikala mashaka goseri.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3" />Guwawuziya wantu mulitapaka,</para>
  <para style="q" vid="PSA 90:3">gutakula mwenga wantu muwuyi mulitapaka.<verse eid="PSA 90:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4" />Kwaku vinja elufu ndo handa lishaka limu hera,</para>
  <para style="q" vid="PSA 90:4">ndo handa lishaka lyalipititi,</para>
  <para style="q" vid="PSA 90:4">ama handa masaa madidini.<verse eid="PSA 90:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5" />Guwagamiziya kutali wantu mumpota za kuhowa.</para>
  <para style="q" vid="PSA 90:5">Wantu ndo handa ntundu yayitomola mandawira,<verse eid="PSA 90:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6" />mandawira itomola na kubuma,</para>
  <para style="q" vid="PSA 90:6">pashimihi inyala na kuyuma.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7" />Maya gaku gatwagamiziya,</para>
  <para style="q" vid="PSA 90:7">tunyamaziwa na maya gaku.<verse eid="PSA 90:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8" />Makontola getu gugatula kulongolu kwaku,</para>
  <para style="q" vid="PSA 90:8">vidoda vyetu vya bada vya lupalahera kulongolu kwaku.<verse eid="PSA 90:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9" />Kwa maya gaku makaliru getu gawusiwa,</para>
  <para style="q" vid="PSA 90:9">gapera handa pumla.<verse eid="PSA 90:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10" />Vinja vyetu vya kulikala ndo sabini,</para>
  <para style="q" vid="PSA 90:10">ama patuwera na likakala, semanini,</para>
  <para style="q" vid="PSA 90:10">kumbiti upuleru wakuyi ndo ntabiku na hinginika,</para>
  <para style="q" vid="PSA 90:10">mashaka gagenda na twenga tuhowa.<verse eid="PSA 90:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11" />Gaa yakavimana makakala ga maya gaku?</para>
  <para style="q" vid="PSA 90:11">Toziya ukulu waku ututenda tukutiri.<verse eid="PSA 90:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12" />Gutufundi kuwalanga mashaka getu,</para>
  <para style="q" vid="PSA 90:12">su tuwezi kuwera na moyu gwa luhala.<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13" />Gwee Mtuwa Mlungu guwuyi!</para>
  <para style="q" vid="PSA 90:13">Hagukawawili mpaka ndii?</para>
  <para style="q" vid="PSA 90:13">Gutuwoneri lusungu twenga wantumintumi waku.<verse eid="PSA 90:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14" />Gutumemiziyi ufiru waku mandawira,</para>
  <para style="q" vid="PSA 90:14">su tuwezi kwimba kwa nemeleru na kufyapilira mashaka goseri.<verse eid="PSA 90:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15" />Gutuwongeri vinja vivuwa vya nemeru,</para>
  <para style="q" vid="PSA 90:15">ntambu yagutupananiti vinja vivuwa vya ntabiku na hinginiku.<verse eid="PSA 90:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16" />Gugalangaziyi matendu gaku kwa wantumintumi waku,</para>
  <para style="q" vid="PSA 90:16">uwezu waku kwa wana wawu.<verse eid="PSA 90:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17" />Uheri wa Mtuwa, Mlungu gwetu uweri kwa twenga,</para>
  <para style="q" vid="PSA 90:17">gugatekeleri mahengu getu,</para>
  <para style="q" vid="PSA 90:17">gutupanani mpatiru gatugatenda.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s">Mlungu mlolera gwetu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1" />Yakalikala paulolera wa Mlungu Mkulu,</para>
  <para style="q" vid="PSA 91:1">hakalikali poneka kwa Mlungu Yakana Makakala,<verse eid="PSA 91:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2" />hanimgambiri Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 91:2">“Gwenga ndo tugira ya neni na liboma lya neni,</para>
  <para style="q" vid="PSA 91:2">Mlungu gwangu, yanikutumbira.”<verse eid="PSA 91:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3" />Nakaka Mlungu hakakulopoli mmugomiziwu,</para>
  <para style="q" vid="PSA 91:3">hakakushingi na malweri yagalaga.<verse eid="PSA 91:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4" />Hakakugibikiri kwa mibahira yakuyi,</para>
  <para style="q" vid="PSA 91:4">na pasi pa mbapatiru zakuyi, hagupati ulolera</para>
  <para style="q" vid="PSA 91:4">waminika wakuyi hawukuloleri na kukushinga,<verse eid="PSA 91:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5" />hapenigutiri vitiriziwu vya pashiru,</para>
  <para style="q" vid="PSA 91:5">pota likomangu lya vumu paluwala,<verse eid="PSA 91:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6" />pota makomangu yagalawira pashiru,</para>
  <para style="q" vid="PSA 91:6">ama malweli yagalawira paluwala.<verse eid="PSA 91:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7" />Handa wantu elufu yimu pawahowa pakwegera na gwenga na</para>
  <para style="q" vid="PSA 91:7">elufu kumi kumliwu kwaku,</para>
  <para style="q" vid="PSA 91:7">kumbiti gwenga lidoda hapeni likusegeleri.<verse eid="PSA 91:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8" />Kwa masu gaku gamweni haguloli na</para>
  <para style="q" vid="PSA 91:8">kuwona wantu wakontola ntambu yawakomangwa.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9" />Mana gwenga gumtenda Mtuwa Mlungu kuwera tugira yaku,</para>
  <para style="q" vid="PSA 91:9">Mlungu gwa kumpindi nentu kuwera litumbiru lyaku,<verse eid="PSA 91:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10" />hangu, hapeni gupatwi na madoda,</para>
  <para style="q" vid="PSA 91:10">na numba yaku hapeni isegelerwi na makomangu goseri.<verse eid="PSA 91:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11" />Toziya Mlungu hakawalagaliri wantumintumi wakuyi wa kumpindi,</para>
  <para style="q" vid="PSA 91:11">wakuloleri poseri pagugenda.<verse eid="PSA 91:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12" />Hawakukoli mmawoku mwawu,</para>
  <para style="q" vid="PSA 91:12">nagwiza kulikwala mulibuhi.<verse eid="PSA 91:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13" />Hagutimbi simba na njoka,</para>
  <para style="q" vid="PSA 91:13">haguwapondi wana simba na njoka wana usungu.<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14" />Mlungu katakula, hanimlopoli ulii yakanfira,</para>
  <para style="q" vid="PSA 91:14">hanimloleri yakamana neni na Mlungu.<verse eid="PSA 91:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15" />Pakanshema na neni hanimwitikiri,</para>
  <para style="q" vid="PSA 91:15">pakawera mkutabika haweli na yomberi,</para>
  <para style="q" vid="PSA 91:15">hanimlopoli na kumpanana ligoya.<verse eid="PSA 91:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16" />Hanimpanani makaliru matali,</para>
  <para style="q" vid="PSA 91:16">Hanimlangaziyi ulopola wa neni.<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s">Lwimbu lwa kumzyuma Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 92:1" />Iherepa kulonga mayagashii kwa Mtuwa Mlungu na</para>
  <para style="q" vid="PSA 92:1">kulizyumira litawu lyaku, gwenga Yaguwera Kumpindi Nentu,<verse eid="PSA 92:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2" />kubwera zyuma zaku mandawira na</para>
  <para style="q" vid="PSA 92:2">waminika waku shaka sha pashiru,<verse eid="PSA 92:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3" />kwa zezi na lingutinguti na</para>
  <para style="q" vid="PSA 92:3">kwa liziwu liherepa lya zezi.<verse eid="PSA 92:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4" />Gwee Mtuwa Mlungu, matendu gaku ganemiziya,</para>
  <para style="q" vid="PSA 92:4">hanemeleri toziya ya matendu gaku gagutenditi.<verse eid="PSA 92:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5" />Gwee Mtuwa Mlungu, matendu gaku makulu nentu!</para>
  <para style="q" vid="PSA 92:5">Maholu gaku gamanikandiri!<verse eid="PSA 92:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6" />Muntu mpukapuka kaliholandiri,</para>
  <para style="q" vid="PSA 92:6">pota mzigizigi kavimanandiri mirandu ayi.<verse eid="PSA 92:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7" />Tembera wakontola waweza kongereka handa ntundu,</para>
  <para style="q" vid="PSA 92:7">yawatenda makontola waweza kumota,</para>
  <para style="q" vid="PSA 92:7">kumbiti upeleru wawu ndo kwangamiziwa mashaka goseri,<verse eid="PSA 92:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8" />kumbiti gwenga Mtuwa Mlungu, gukwiswa mashaka goseri.<verse eid="PSA 92:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9" />Guloli wankondu waku ndo awa</para>
  <para style="q" vid="PSA 92:9">gwee Mtuwa Mlungu wankondu waku, nakaka hawagamiri,</para>
  <para style="q" vid="PSA 92:9">woseri yawatenda makontola, hawapalasiki.<verse eid="PSA 92:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10" />Gwenga gunupa likakala handa nyati,</para>
  <para style="q" vid="PSA 92:10">gumintira lipaki liherepa.<verse eid="PSA 92:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11" />Masu gangu gawona wankondu wa neni wasinda,</para>
  <para style="q" vid="PSA 92:11">mpikinira kulira kwawu yawatenda makontola.<verse eid="PSA 92:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12" />Yawana haki hawaherepi handa mtera gwa mtendi,</para>
  <para style="q" vid="PSA 92:12">hawakuli handa mtera gwa mwerezi gwa Lebanoni,<verse eid="PSA 92:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13" />handa mitera yayiyalitwi muligeleri lya Numba Nkulu ya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 92:13">hawongeleki mumageleri ga Numba Nkulu ya Mlungu gwetu,<verse eid="PSA 92:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14" />hayendeleyi kulera mabwajubwaju mpaka uzewi,</para>
  <para style="q" vid="PSA 92:14">mashaka goseri hayiweri miwisi na yayimema makakala.<verse eid="PSA 92:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15" />Su wabweri handa Mtuwa Mlungu ndo mwaminika,</para>
  <para style="q" vid="PSA 92:15">litalabuhi lyangu, kwakuyi kwahera mpunjiru.<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s">Mlungu mkolamlima</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1" />Mtuwa Mlungu kakolamlima.</para>
  <para style="q" vid="PSA 93:1">Mtuwa Mlungu kalivalasiya uweru na kulitawa makakala.</para>
  <para style="q" vid="PSA 93:1">Kapagangamaziya pasipanu na hapeni pabegiziwi nakamu.<verse eid="PSA 93:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2" />Ukolamlima waku ugangamala kwanjira makashu,</para>
  <para style="q" vid="PSA 93:2">gwenga guwera pamberi ya vyaka vyoseri.<verse eid="PSA 93:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3" />Gwee Mtuwa Mlungu, nshemba zilaviya liziwu,</para>
  <para style="q" vid="PSA 93:3">nshemba zibotanga,</para>
  <para style="q" vid="PSA 93:3">nshemba zankulaviya maziwu ga makupala gakuyi.<verse eid="PSA 93:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4" />Mtuwa Mlungu ndo mkulu kumpindi,</para>
  <para style="q" vid="PSA 93:4">kana likakala kuliku liziwu lya bahari,</para>
  <para style="q" vid="PSA 93:4">kana likakala kuliku makupala ga bahari.<verse eid="PSA 93:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5" />Gwee Mtuwa Mlungu, malagalira gaku ndo magangamala nakamu,</para>
  <para style="q" vid="PSA 93:5">numba yaku nkulu ndo nanagala,</para>
  <para style="q" vid="PSA 93:5">mashaka goseri.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s">Mlungu mtoza gwa wantu woseri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1" />Gwee Mtuwa Mlungu, Mlungu yakawuzilira,</para>
  <para style="q" vid="PSA 94:1">Gwee Mlungu mwuzilira, guwoneki!<verse eid="PSA 94:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2" />Gugoloki, gwee mtoza gwa wantu woseri,</para>
  <para style="q" vid="PSA 94:2">guwakomangi wana mtiti ntambuyawafiruwa!<verse eid="PSA 94:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3" />Gwee Mtuwa Mlungu, mpakandii wakontola hawendeleyi kuwera?</para>
  <para style="q" vid="PSA 94:3">Mpakandiri, wakontola hawendeleyi hawalizyumi?<verse eid="PSA 94:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4" />Wakontola wayowera visoweri vya mtiti</para>
  <para style="q" vid="PSA 94:4">wakontola woseri wana malingisu.<verse eid="PSA 94:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5" />Gwee Mtuwa Mlungu, wantu waku wankulaguwa,</para>
  <para style="q" vid="PSA 94:5">wawatabisiya wantu yaguwasyaguliti waweri waku.<verse eid="PSA 94:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6" />Wawalaga wakenja na wahenga,</para>
  <para style="q" vid="PSA 94:6">wawalikitula wana yawahera tati!<verse eid="PSA 94:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7" />Walonga, “Mtuwa Mlungu kawonandiri,</para>
  <para style="q" vid="PSA 94:7">Mlungu gwa Yakobu kavimanandiri”<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8" />Mwenga wazigizigi wa upeleru, mliholi shididini!</para>
  <para style="q" vid="PSA 94:8">Mwenga wazigizigi, hampatindii umani?<verse eid="PSA 94:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9" />Yakatenditi likutu, hashi, kawezandiri kupikinira?</para>
  <para style="q" vid="PSA 94:9">Yakawumbiti lisu, hashi, kaweza ndiri kuwona?<verse eid="PSA 94:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10" />Yakakomanga maisi, kawezandiri kukalipira?</para>
  <para style="q" vid="PSA 94:10">Yakafunda wantu, kahera umani?<verse eid="PSA 94:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11" />Mtuwa Mlungu kagamana maholu ga wantu,</para>
  <para style="q" vid="PSA 94:11">kavimana handa gafaandiri shintu.<verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12" />Gwee Mtuwa Mlungu, mbaka muntu yagumfunda vitendu viherepa,</para>
  <para style="q" vid="PSA 94:12">muntu yakafunda lagiru yaku,<verse eid="PSA 94:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13" />su lishaka lya kutabika kapati kwoyera,</para>
  <para style="q" vid="PSA 94:13">mpaka wakontola wabawirwi lirindi.<verse eid="PSA 94:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14" />Toziya Mtuwa Mlungu hapeni kawaleki wantu wakuyi,</para>
  <para style="q" vid="PSA 94:14">hapeni kawasi awa yawawera wakuyi.<verse eid="PSA 94:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15" />Toziya toza hazilaviwi kayi kwa haki,</para>
  <para style="q" vid="PSA 94:15">na waminika woseri wa moyu guherepa hawazitendi.<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16" />Gaa yanakantangi kumkoma muntu mkontola?</para>
  <para style="q" vid="PSA 94:16">Gaa yanakaweri uwega wangu toziya ya wadoda?<verse eid="PSA 94:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17" />Mtuwa Mlungu mekatangindiri,</para>
  <para style="q" vid="PSA 94:17">meng'endi kala muisi yawahowiti.<verse eid="PSA 94:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18" />Panongiti, “Handa hatyerebuki”,</para>
  <para style="q" vid="PSA 94:18">ufiru waku, gwee Mtuwa Mlungu, untangiti.<verse eid="PSA 94:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19" />Magaziwu ga moyu gwangu pagongereka,</para>
  <para style="q" vid="PSA 94:19">gwenga guzyangazyanga na kunsekeziya.<verse eid="PSA 94:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20" />Gwenga guweza ndiri kutenda pamuhera na watoza wangesera,</para>
  <para style="q" vid="PSA 94:20">yawapanga mbinu za kuteteya makontola.<verse eid="PSA 94:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21" />Walijimirana kuwagamiziya waaminika,</para>
  <para style="q" vid="PSA 94:21">na kuwatoza wantu wahera shidoda walaguwi.<verse eid="PSA 94:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22" />Kumbiti Mtuwa Mlungu ndo litugiru lyangu,</para>
  <para style="q" vid="PSA 94:22">Mlungu gwangu ndo litalabuhi lya uponera waneni.<verse eid="PSA 94:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23" />Ukontola wawu hakawawuziliri weni,</para>
  <para style="q" vid="PSA 94:23">hagawagamizili kutali toziya ya udoda wawu.</para>
  <para style="q" vid="PSA 94:23">Mtuwa Mlungu gwetu, hakawagamiziyi.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s">Lwimbu lwa kumzyuma kwa Mtuwa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1" />Mwizi tumwimbiri Mtuwa Mlungu kwa kunemelera,</para>
  <para style="q" vid="PSA 95:1">tumfyapiliri kwa nemeru litalabuhi lya ulopola wa twenga!<verse eid="PSA 95:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2" />Tugendi kulongolu kwakuyi kwa kulonga mayagashi,</para>
  <para style="q" vid="PSA 95:2">tumfyapiliri kwa nyimbu za kumzyuma.<verse eid="PSA 95:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3" />Toziya Mtuwa Mlungu, ndo Mlungu mkulu,</para>
  <para style="q" vid="PSA 95:3">yomberi ndo mfalumi mkulu kwa wamlungu woseri.<verse eid="PSA 95:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4" />Miyanjiru ya pasipanu poseri yapamawoku gakuyi,</para>
  <para style="q" vid="PSA 95:4">mbeleru za migongu ndo zakuyi.<verse eid="PSA 95:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5" />Bahari ndo yakuyi toziya ndo yakainyawiti,</para>
  <para style="q" vid="PSA 95:5">kwa mawoku gakuyi kanyawiti isi iyuma.<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6" />Mwizi tuguwi makukama na kumguwira,</para>
  <para style="q" vid="PSA 95:6">tumsundamaliri Mtuwa Mlungu, Muumba gwetu!<verse eid="PSA 95:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7" />Mana yomberi ndo Mlungu gwetu,</para>
  <para style="q" vid="PSA 95:7">na twenga ndo wantu wakuyi,</para>
  <para style="q" vid="PSA 95:7">katulolera handa mshunga gwa kondolu.</para>
  <para style="b" vid="PSA 95:7" />
  <para style="q" vid="PSA 95:7">Meyiweri mbaka leru kupikanira liziwu lyakuyi.<verse eid="PSA 95:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8" />“Namuwera wankesera ntambu yamtenditi kulii Meriba,</para>
  <para style="q" vid="PSA 95:8">ntambu yamtenditi lishaka lii Masa kushiwala,<verse eid="PSA 95:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9" />wazewi wenu pawanjeriti na kumpima,</para>
  <para style="q" vid="PSA 95:9">tembera waweriti wawona mirandu yaniwatendiriti.<verse eid="PSA 95:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10" />Kwa vinja arobaini, ngalaziwitwi na shiyiwuku ashi,</para>
  <para style="q" vid="PSA 95:10">ntakula, nakaka, awa ndo wantu yawapotokiti.</para>
  <para style="q" vid="PSA 95:10">Wavimanandiri njira za neni.<verse eid="PSA 95:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11" />Su, nkalaliti na nilirapa,</para>
  <para style="q" vid="PSA 95:11">hapeni wingiri pahala pangu pa kwoyera.”<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s">Mlungu mfalumi na mtoza</para>
  <para style="r">
    <ref loc="1CH 16:23-33">1 Mirandu 16:23-33</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1" />Mmwimbiri Mtuwa Mlungu lwimbu lwasyai!</para>
  <para style="q" vid="PSA 96:1">Mwenga wantu wa pasipanu poseri mumwimbiri Mtuwa Mlungu.<verse eid="PSA 96:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2" />Mmwimbi Mtuwa Mlungu na kulizyuma litawu lyakuyi.</para>
  <para style="q" vid="PSA 96:2">Mubweri ulopola wakuyi kila lishaka.<verse eid="PSA 96:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3" />Mgabweleri maisi uweru wakuyi,</para>
  <para style="q" vid="PSA 96:3">muwagambiri wantu woseri matendu gakuyi gakulikangasha.<verse eid="PSA 96:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4" />Toziya Mtuwa Mlungu ndo mkulu, kazyumwa nentu,</para>
  <para style="q" vid="PSA 96:4">kafiruwa kutirwa kuliku wamlungu woseri.<verse eid="PSA 96:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5" />Toziya Wamlungu wa maisi gamonga shintundiri,</para>
  <para style="q" vid="PSA 96:5">kumbiti Mtuwa Mlungu kawumbiti mpindi.<verse eid="PSA 96:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6" />Uweru na ligoya vimzyengeta,</para>
  <para style="q" vid="PSA 96:6">likakala na ukulu viyimemiziya Numba Nkulu yakuyi.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7" />Mwenga wantu wa maisi goseri mumpanani ligoya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 96:7">mumzyumi Mtuwa toziya ya uweru na likakala lyakuyi.<verse eid="PSA 96:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8" />Mlizyumi litawu lyakuyi liweru,</para>
  <para style="q" vid="PSA 96:8">mjegi tambiku na kwingira mu Numba Nkulu mwakuyi.<verse eid="PSA 96:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9" />Mmuguwiri Mtuwa Mlungu toziya yomberi ndo mnanagala.</para>
  <para style="q" vid="PSA 96:9">Mlendemeri kulongolu kwakuyi mwenga wantu wa pasipanu poseri!<verse eid="PSA 96:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10" />Mgagambiri maisi, “Mtuwa Mlungu kakolamlima!</para>
  <para style="q" vid="PSA 96:10">Kapagangamaziya pasipanu na hapeni patikinyiki.</para>
  <para style="q" vid="PSA 96:10">Hakawatozi wantu kwa haki.”<verse eid="PSA 96:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11" />Mpindi na pasipanu vinemeleri!</para>
  <para style="q" vid="PSA 96:11">Bahari na ivumi pamuhera na vyoseri yaviwera amu!<verse eid="PSA 96:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12" />Mnemeleri mwe malambu na vyoseri vyaviwera amu!</para>
  <para style="q" vid="PSA 96:12">Shakapanu mitera yoseri ya kulidowi hayiyimbi kwa nemeleri,<verse eid="PSA 96:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13" />kulongolu kwa Mtuwa Mlungu yakiza,</para>
  <para style="q" vid="PSA 96:13">yakiza kupatoza pasipanu,</para>
  <para style="q" vid="PSA 96:13">hakapatozi pasipanu na maisi goseri kwa haki.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s">Mlungu mkolamlima mkulu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1" />Mtuwa Mlungu kakolamlima, gwe isi gufyapiliri!</para>
  <para style="q" vid="PSA 97:1">Gwe visiwa gunemeleli!<verse eid="PSA 97:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2" />Mawundi na luwindu dunyu vimzyengeta,</para>
  <para style="q" vid="PSA 97:2">uaminika na haki ndo lyanjiru lya ukolamlima wakuyi.<verse eid="PSA 97:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3" />Motu gulongolera kulongolu kwakuyi</para>
  <para style="q" vid="PSA 97:3">na kuwalunguziya wankondu wakuyi wega zakuyi zoseri.<verse eid="PSA 97:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4" />Lumeta lwakuyi lulangala pasipanu,</para>
  <para style="q" vid="PSA 97:4">Pasipanu paluluwona palendemera.<verse eid="PSA 97:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5" />Vigongu vilumbutuka handa unkombi kulongolu kwa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 97:5">kulongolu kwa Mtuwa gwa pasipanu poseri.<verse eid="PSA 97:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6" />Mpindi zibwera haki yakuyi,</para>
  <para style="q" vid="PSA 97:6">wantu wa maisi goseri wawuwona uweru wakuyi.<verse eid="PSA 97:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7" />Woseri yawaguwira shinyagu na woseri yawalitumbira wamlungu hawasoniziwi,</para>
  <para style="q" vid="PSA 97:7">wamlungu woseri wasuntamala makukama kulongolu kwakuyi.<verse eid="PSA 97:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8" />Wantu wa Sayuni wapikanira na kunemelera,</para>
  <para style="q" vid="PSA 97:8">wantu wa Yuda wankufyapilira,</para>
  <para style="q" vid="PSA 97:8">toziya ya toza zaku, gwee Mtuwa Mlungu.<verse eid="PSA 97:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9" />Toziya gwenga Mtuwa Mlungu ndo gwakumpindi nentu kuliku pasipanu poseri,</para>
  <para style="q" vid="PSA 97:9">guwera mkulu nentu kuliku wamlungu woseri.<verse eid="PSA 97:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10" />Mwenga yamumfira Mtuwa Mlungu mkalaliri ukontola,</para>
  <para style="q" vid="PSA 97:10">toziya yomberi kagalolera makaliru ga yawamwamini,</para>
  <para style="q" vid="PSA 97:10">na kawalopola kulawa mmawoku mwa wakontola.<verse eid="PSA 97:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11" />Gulangala guwawalira wantu yawana haki,</para>
  <para style="q" vid="PSA 97:11">na nemeleru kwa wantu yawawera na miyoyu iherepa.<verse eid="PSA 97:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12" />Mwenga yamwana haki mumnemeleri Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 97:12">mlongi mayagashi toziya ya litawu lyakuyi linanagala.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s">Mlungu mkolamlima gwa pasipanu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 98:1" />Mumwimbili Mtuwa Mlungu lwimbu lwa syayi,</para>
  <para style="q" vid="PSA 98:1">mana katenda mirandu ya kulikangasha!</para>
  <para style="q" vid="PSA 98:1">Kwa makakala gakuyi na uwezu wakuyi mnanagala,</para>
  <para style="q" vid="PSA 98:1">avi vimmpanana ukanka uvuwa.<verse eid="PSA 98:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2" />Mtuwa Mlungu kawutenda ulopola wakuyi umanikani,</para>
  <para style="q" vid="PSA 98:2">haki yakuyi imanikana kwa maisi.<verse eid="PSA 98:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3" />Kalihola ufiru na waminika wakuyi kwa Waisraeli,</para>
  <para style="q" vid="PSA 98:3">pasipanu poseri pawuwona ulopola wa Mlungu gwetu.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4" />Wantu wa pasipanu poseri wamfyapiliri Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 98:4">wamfyapiliri kwa nyimbu za nemeru.<verse eid="PSA 98:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5" />Mmuzyumi Mtuwa Mlungu kwa lingutinguti,</para>
  <para style="q" vid="PSA 98:5">kwa lingutinguti na liziwu lya kwimba,<verse eid="PSA 98:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6" />kwa lipenka na liziwu lya lipenka lya magoli,</para>
  <para style="q" vid="PSA 98:6">mnemeleri kulongolu kwa Mtuwa Mlungu.<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7" />Bahari na ivumi na vintu vyoseri yaviwera amu,</para>
  <para style="q" vid="PSA 98:7">pasipanu na woseri yawalikala mngati mwakuyi.<verse eid="PSA 98:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8" />Nshemba nayikomi mapopu,</para>
  <para style="q" vid="PSA 98:8">migongu yimbi pamuhera kwa nemeru,<verse eid="PSA 98:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9" />kulongolu kwa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 98:9">mana kankwiza kupatoza pasipanu.</para>
  <para style="q" vid="PSA 98:9">Hakapatozi pasipanu kwa haki na wantu wa maisi kwa uaminika.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s">Mlungu mkolamlima Mkulu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1" />Mtuwa Mlungu kankukolamlima,</para>
  <para style="q" vid="PSA 99:1">wantu wankulendemera!</para>
  <para style="q" vid="PSA 99:1">Kalikala pampindi pa viwumbi vyana mpapatiru,</para>
  <para style="q" vid="PSA 99:1">na pasipanu pabegiziwa!<verse eid="PSA 99:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2" />Mtuwa Mlungu ndo mkulu mu Sayuni,</para>
  <para style="q" vid="PSA 99:2">kapananwa ligoya mu maisi goseri.<verse eid="PSA 99:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3" />Woseri na walizyumi litawu lyakuyi likulu lya kutiliziya.</para>
  <para style="q" vid="PSA 99:3">Yomberi ndo Mnanagala!<verse eid="PSA 99:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4" />Mfalumi ndo yagwana makakala na gufira uaminika!</para>
  <para style="q" vid="PSA 99:4">Gulanguziya haki yaku,</para>
  <para style="q" vid="PSA 99:4">kwa Yakobo gutenda yagawera ga haki na yagawera teratera.<verse eid="PSA 99:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5" />Mumzyumi Mtuwa Mlungu, Mlungu gwetu,</para>
  <para style="q" vid="PSA 99:5">mguwiri kulongolu kwakuyi.</para>
  <para style="q" vid="PSA 99:5">Yomberi Mnanagala!<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6" />Musa na Aruni waweriti watambika wakuyi,</para>
  <para style="q" vid="PSA 99:6">Samweli kaweriti muwamu mwa yawamshemiti,</para>
  <para style="q" vid="PSA 99:6">wamshemiti Mtuwa Mlungu na yomberi kawapikinira.<verse eid="PSA 99:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7" />Kayoweriti nawomberi mumpanda ya liwundi,</para>
  <para style="q" vid="PSA 99:7">Wagatenditi malagalira gakuyi na lagiru zyakawapananiti.<verse eid="PSA 99:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8" />Gwee Mtuwa Mlungu, Mlungu gwetu, gwenga guwankuliti,</para>
  <para style="q" vid="PSA 99:8">kwa womberi guweriti Mlungu yakawalekiziya,</para>
  <para style="q" vid="PSA 99:8">tembera guwakomangiti kwa vidoda vyawu.<verse eid="PSA 99:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9" />Mmuzyumi Mtuwa Mlungu, Mlungu gwetu,</para>
  <para style="q" vid="PSA 99:9">mguwiri mulugongu lwakuyi lunanagala!</para>
  <para style="q" vid="PSA 99:9">Mana Mtuwa Mlungu, Mlungu gwetu, ndo mnanagala.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">Lwimbu lwa zyuma</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 100:1" />Mumfyapiliri Mtuwa Mlungu, mwenga isi zoseri!<verse eid="PSA 100:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2" />Mmuguwiri Mtuwa Mlungu kwa nemeleru,</para>
  <para style="q" vid="PSA 100:2">mwizi kulongolu kwakuyi kwa nyimbu zya nemeleru!<verse eid="PSA 100:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3" />Muvimani handa Mtuwa Mlungu ndo Mlungu.</para>
  <para style="q" vid="PSA 100:3">Yomberi katuwumbiti, twenga,</para>
  <para style="q" vid="PSA 100:3">twenga ndo wantu wakuyi na kondolu wa maliwuziwu gakuyi.<verse eid="PSA 100:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4" />Mpitiri mmilyangu ya Numba Nkulu yakuyi kwa kulonga mayagashi,</para>
  <para style="q" vid="PSA 100:4">mwingiri mumageleri gakuyi kwa kuzyuma.</para>
  <para style="q" vid="PSA 100:4">Mlongi mayagashii na kulizyuma litawu lyakuyi.<verse eid="PSA 100:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5" />Mtuwa Mlungu ndo mheri,</para>
  <para style="q" vid="PSA 100:5">ufiru wakuyi ulikala mashaka goseri</para>
  <para style="q" vid="PSA 100:5">na waminika wakuyi ulikala muviyiwuku vyoseri.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s">Gakalongiti Mfalumi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 101:1" />Hanimbi kuusu ufiru na haki yaku,</para>
  <para style="q" vid="PSA 101:1">Gwee Mtuwa Mlungu, hanikuzyumi kwa nyimbu.<verse eid="PSA 101:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2" />Hankamalili kulikala makaliru yagahera na likosa.</para>
  <para style="b" vid="PSA 101:2" />
  <para style="q" vid="PSA 101:2">Hagwizi kwanenindii?</para>
  <para style="q" vid="PSA 101:2">Hanilikali kwa waminika ukaya kwangu,<verse eid="PSA 101:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3" />hapeni njimiri matendu madoda kulongolu kwangu.</para>
  <para style="q" vid="PSA 101:3">Nagakalalira matendu ga wakontola,</para>
  <para style="q" vid="PSA 101:3">mirandu yawu hayigendindiri pamuhera na neni.<verse eid="PSA 101:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4" />Hapaweri pamuhera na muntu mpotuziya,</para>
  <para style="q" vid="PSA 101:4">hanilituli gweka na kila likontola.<verse eid="PSA 101:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5" />Kila yakampayira gwapakwera gwakuyi kwa bada,</para>
  <para style="q" vid="PSA 101:5">hanimnyamaziyi</para>
  <para style="q" vid="PSA 101:5">yakana mtiti na kulitumba</para>
  <para style="q" vid="PSA 101:5">hapeni nimhepeleri.<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6" />Haniwaloli kwa uheri wantu yawawera waminika,</para>
  <para style="q" vid="PSA 101:6">su walikali pamuhera naneni.</para>
  <para style="q" vid="PSA 101:6">Wantu yawalikala kwa ukamilika,</para>
  <para style="q" vid="PSA 101:6">ndo yawafira kuntendera.<verse eid="PSA 101:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7" />Kanampayu yoseri hapeni kalikali mu numba yangu,</para>
  <para style="q" vid="PSA 101:7">kwahera yakatakula mpayu yakaweza kugoloka kulongolu kwaneni.<verse eid="PSA 101:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8" />Kila lishaka haniwagamiziyi</para>
  <para style="q" vid="PSA 101:8">wakontola woseri paisi,</para>
  <para style="q" vid="PSA 101:8">haniwagamiziyi wadoda woseri,</para>
  <para style="q" vid="PSA 101:8">kumji gwa Mtuwa Mlungu.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s">Luwa mukutabika</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 102:1" />Gwee Mtuwa Mlungu, gupikiniri kuluwa kwa neni,</para>
  <para style="q" vid="PSA 102:1">na kuluwa utanga kwaneni kukufikili.<verse eid="PSA 102:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2" />Nagulififa kutali naneni,</para>
  <para style="q" vid="PSA 102:2">pawera muntabika!</para>
  <para style="q" vid="PSA 102:2">Gunyambili likutu lyaku,</para>
  <para style="q" vid="PSA 102:2">gunankuli kalongola shaka panikuluwa!<verse eid="PSA 102:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3" />Mashaka gangu gankupita handa lyosi,</para>
  <para style="q" vid="PSA 102:3">mihonju yangu ilungula handa makala ga motu.<verse eid="PSA 102:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4" />Moyu gwangu guposholwa handa ntundu yayiyuma,</para>
  <para style="q" vid="PSA 102:4">nahera ata matamata ya shiboga.<verse eid="PSA 102:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5" />Kulawirana na kwinginika kwa neni,</para>
  <para style="q" vid="PSA 102:5">nsigala mihonju hera.<verse eid="PSA 102:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6" />Wera handa lisisigira gwa kushiwala,</para>
  <para style="q" vid="PSA 102:6">handa lisisigira mumahami.<verse eid="PSA 102:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7" />Ngonjandiri,</para>
  <para style="q" vid="PSA 102:7">wera gambira mpongu yakakala gwekayakuyi pampindi pa shitwiku.<verse eid="PSA 102:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8" />Mashaka goseri wankondu wangu wambeziya,</para>
  <para style="q" vid="PSA 102:8">walitendera litawu lyaneni kuwapangira wamonga.<verse eid="PSA 102:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 102:9" />Malivu gawera shiboga shaneni,</para>
  <para style="q" vid="PSA 102:9">nigahanganyia masozi na shilandu shangu,<verse eid="PSA 102:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 102:10" />toziya ya nkalaliru na maya gaku,</para>
  <para style="q" vid="PSA 102:10">ndo mana guntola na kunasira kutali.<verse eid="PSA 102:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11" />Makaliru gangu ndo handa lisisi lya pashimihi,</para>
  <para style="q" vid="PSA 102:11">nyala handa ntundu.<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12" />Kumbiti gwenga, Mtuwa Mlungu gukolamlima mashaka goseri,</para>
  <para style="q" vid="PSA 102:12">litawu lyaku liholuwa mu viyiwuku vyoseri.<verse eid="PSA 102:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13" />Gwenga hagugoloki na kuguwonera lusungu mji gwa Sayuni,</para>
  <para style="q" vid="PSA 102:13">toziya shaka shisoka sha kugutendera maheri.</para>
  <para style="q" vid="PSA 102:13">Shaka shakuyi shashipangitwi shisoka.<verse eid="PSA 102:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14" />Wantumintumi waku wagufira nentu,</para>
  <para style="q" vid="PSA 102:14">tembera guwera mahami,</para>
  <para style="q" vid="PSA 102:14">waguwonera lusungu,</para>
  <para style="q" vid="PSA 102:14">tembera guhalibika nakamu.<verse eid="PSA 102:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15" />Maisi hawalipanani ligoya litawu lya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 102:15">wafalumi woseri pasipanu hawatiri uweru waku,<verse eid="PSA 102:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16" />shaka Mtuwa Mlungu hakayinyawi kayi mji gwa Sayuni,</para>
  <para style="q" vid="PSA 102:16">na hakawoneki ntambu yakawera muweru,<verse eid="PSA 102:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17" />shaka pakajimira maluwa ga mhushu,</para>
  <para style="q" vid="PSA 102:17">pota kugalema maluwa gawu.<verse eid="PSA 102:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18" />Mlandu agu gulembwi toziya ya viyiwuku vyaviza,</para>
  <para style="q" vid="PSA 102:18">yanawiwuki wamzyumi Mtuwa Mlungu.<verse eid="PSA 102:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19" />Mtuwa Mlungu hakaloli pasi kulawa pananagala pakuyi yapawera pampindi,</para>
  <para style="q" vid="PSA 102:19">kulawa kumpindi hakaloli pasipanu,<verse eid="PSA 102:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20" />su kupikanira kulira kwa watatilwa,</para>
  <para style="q" vid="PSA 102:20">na kuwalekiziya yawatozitwi kulaguwa.<verse eid="PSA 102:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21" />Hangu wantu hawabweri litawu lya Mtuwa Mlungu aku Sayuni,</para>
  <para style="q" vid="PSA 102:21">zyuma zakuyi hazibwerwi aku Yerusalemu,<verse eid="PSA 102:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22" />shaka wantu wa maisi pawajojonika pamuhera na falumi</para>
  <para style="q" vid="PSA 102:22">su kumtendera Mtuwa Mlungu.<verse eid="PSA 102:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23" />Mtuwa Mlungu kampungula makakala nangali munjira,</para>
  <para style="q" vid="PSA 102:23">kagafupiziya makaliru gangu.<verse eid="PSA 102:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24" />Naneni ntakula, gwee Mlungu gwangu, naguntola vinu</para>
  <para style="b" vid="PSA 102:24" />
  <para style="q" vid="PSA 102:24">shaka nangali mntemba.</para>
  <para style="q" vid="PSA 102:24">Mana gwenga gulikala viyiwuku na viyiwuku.<verse eid="PSA 102:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25" />Makashu gwenga guwumbiti pasipanu,</para>
  <para style="q" vid="PSA 102:25">mpindi ndo lihengu lya mawoku gaku.<verse eid="PSA 102:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26" />Azi haziwuki, kumbiti gwenga hagusigali,</para>
  <para style="q" vid="PSA 102:26">azi hazisakali handa nguwu.</para>
  <para style="q" vid="PSA 102:26">Hagwasili kutali handa mavalu,</para>
  <para style="q" vid="PSA 102:26">na zeni haziwusiwi.<verse eid="PSA 102:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27" />Kumbiti gwenga ndo ulaulii mashaka goseri,</para>
  <para style="q" vid="PSA 102:27">na vinja vyaku vyahera upeleru.<verse eid="PSA 102:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28" />Wana wa wantumintumi gwaku hawalikali,</para>
  <para style="q" vid="PSA 102:28">wiwuka wawu hawugangamaziwi kulongolu kwaku.<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s">Luwa ya kulonga mayagashii</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 103:1" />Gwee moyu gwangu, gumzyumi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 103:1">rohu yaneni yoseri ilizyumi litawu lyakuyi linanagala!<verse eid="PSA 103:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2" />Gwee moyu gwangu, gumzyumi Mtuwa Mlungu!</para>
  <para style="q" vid="PSA 103:2">Nagulyaluwa uheri wakuyi woseri.<verse eid="PSA 103:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3" />Ndo yakalekeziya ukontola waneni woseri,</para>
  <para style="q" vid="PSA 103:3">na kumponiziya malweri gangu goseri.<verse eid="PSA 103:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4" />Ndo yakandopola kulawa mkuhowa,</para>
  <para style="q" vid="PSA 103:4">na yakakupanana ufiru na lusungu.<verse eid="PSA 103:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5" />Ndo yakamemiziya maheri makaliru gaku goseri,</para>
  <para style="q" vid="PSA 103:5">su guwera kayi muntemba yakana likakala handa kapungu.<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6" />Mtuwa Mlungu katenda mirandu ya haki,</para>
  <para style="q" vid="PSA 103:6">na katoza kwa haki wantu yawawonerwa.<verse eid="PSA 103:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7" />Kamgambiriti Musa njira yakuyi,</para>
  <para style="q" vid="PSA 103:7">kawalanguziyiti wantu wa Israeli matendu gakuyi.<verse eid="PSA 103:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8" />Mtuwa Mlungu ndo yakana ufiru na lusungu,</para>
  <para style="q" vid="PSA 103:8">ndo mhepelera na mvuwa gwa ufiru.<verse eid="PSA 103:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9" />Katukalapiragandiri mashaka goseri,</para>
  <para style="q" vid="PSA 103:9">Mlungu kakalalandiri mashaka goseri.<verse eid="PSA 103:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10" />Katukomangandiri ntambu yaviwera vidoda vyetu,</para>
  <para style="q" vid="PSA 103:10">katuwuzilirandiri teratera na ukontola wetu.<verse eid="PSA 103:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11" />Handa liyera ntambuyaliwera kutali na pasipanu,</para>
  <para style="q" vid="PSA 103:11">ndo ntambuyawuwera ufiru wakuyi kwa wantu yawamtira.<verse eid="PSA 103:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12" />Handa kwagulawa mshenji ntambu yakuwera kutali na kwaguzyeta mshenji,</para>
  <para style="q" vid="PSA 103:12">ndo ntambu yakavitula gweka vidoda vyetu kutali na twenga.<verse eid="PSA 103:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13" />Handa tati ntambu yakawera na lusungu kwa wana wakuyi,</para>
  <para style="q" vid="PSA 103:13">ndo Mtuwa Mlungu ntambu yakawawonera lusungu woseri yawamguwira.<verse eid="PSA 103:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14" />Mlungu kavimana ntambu yakatuwumbiti,</para>
  <para style="q" vid="PSA 103:14">kalihola handa twenga ndo madikudiku.<verse eid="PSA 103:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15" />Kumbiti makaliru ga muntu ndo handa ntundu hera,</para>
  <para style="q" vid="PSA 103:15">gabuma handa uluwa mlirambu,<verse eid="PSA 103:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16" />lyega livuma pambindi pakuyi na lyeni lyagamira,</para>
  <para style="q" vid="PSA 103:16">na pahala paliweriti hapeni liwoneki kayi.<verse eid="PSA 103:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17" />Kumbiti ufiru wa Mtuwa Mlungu ulikala mashaka goseri,</para>
  <para style="q" vid="PSA 103:17">kwa woseri walii yawamguwira,</para>
  <para style="q" vid="PSA 103:17">na uaminika wakuyi ulikala viyiwuku vyoseri,<verse eid="PSA 103:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18" />Kwa woseri yawatulaweri lipatanu lyakuyi,</para>
  <para style="q" vid="PSA 103:18">na kulihola kujimira lagalira zakuyi,<verse eid="PSA 103:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19" />Mtuwa Mlungu katula shiti shakuyi sha ukulu kumpindi,</para>
  <para style="q" vid="PSA 103:19">yomberi kakolamlima pampindi pa vintu vyoseri.<verse eid="PSA 103:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20" />Mumzyumi Mtuwa Mlungu mwenga wantumintumi wakuyi wakulu yamwana makakala,</para>
  <para style="q" vid="PSA 103:20">mwenga vikambaku yamjimira lagiru zakuyi</para>
  <para style="q" vid="PSA 103:20">na kutenda shilii shakatakula!<verse eid="PSA 103:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21" />Mwenga lishonta lyoseri lya kumpindi, mmuzyumi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 103:21">mwenga wantumintumi wakuyi yamtenda vyakafira yomberi.<verse eid="PSA 103:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22" />Mmuzyumi Mtuwa Mlungu mwenga viwumbi vyakawumbiti vyoseri,</para>
  <para style="q" vid="PSA 103:22">mmuzyumi kila pahala pakakolamlima.</para>
  <para style="q" vid="PSA 103:22">Gwee moyu gwangu, gumzyumi Mtuwa Mlungu!<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s">Kumzyuma munyawa</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1" />Gumzyumi Mtuwa Mlungu, gwee moyu yangu!</para>
  <para style="q" vid="PSA 104:1">Gwee Mtuwa Mlungu, Mlungu gwangu, gwenga ndo mkulu nentu!</para>
  <para style="q" vid="PSA 104:1">Gulivalasiya ukulu na uweru.<verse eid="PSA 104:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2" />Guligibikira kulangala handa shivalu,</para>
  <para style="q" vid="PSA 104:2">guziyalika mpindi handa liringu,<verse eid="PSA 104:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3" />Gunyawa mpanda zya pahala paku pampindi pa mashi.</para>
  <para style="q" vid="PSA 104:3">Gugatenda mawundi kuwera mbutuka yaku ya nkondu,</para>
  <para style="q" vid="PSA 104:3">guguluka pampindi pa mpapatiru zya lyega,<verse eid="PSA 104:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4" />gulitenda lyega kuwera mlagilagi gwaku,</para>
  <para style="q" vid="PSA 104:4">motu na mambamba gakuyi kuwera wantumintumi waku.<verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5" />Pasipanu gupatula gangamala pampindi pa miyanjiru yakuyi,</para>
  <para style="q" vid="PSA 104:5">su nayitikinyika mashaka goseri.<verse eid="PSA 104:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6" />Gupagibikiliti pasipanu kwa bahari handa nguwu,</para>
  <para style="q" vid="PSA 104:6">na mashi gagibikira migongu mitali.<verse eid="PSA 104:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7" />Pagugakalipiliti, mashi gatugiti,</para>
  <para style="q" vid="PSA 104:7">pagapikiniriti kuwunguluma kwaku gatugiti,<verse eid="PSA 104:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8" />migongu payinyasukiti mashi ganyinyirikiti kwanjira kumigongu, mpaka kululalanda,</para>
  <para style="q" vid="PSA 104:8">mpaka pahala palii pagupapangiriti.<verse eid="PSA 104:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9" />Gugatuliliti mbaka mashi aga,</para>
  <para style="q" vid="PSA 104:9">nagiza gupagibikira kayi pasipanu.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10" />Gwenga gutenda bwiru ziti mashi mu malalanda,</para>
  <para style="q" vid="PSA 104:10">na kunyilirika pakati pa migongu.<verse eid="PSA 104:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11" />Azi ziwapanana mashi wankanyama woseri wa kuntundu.</para>
  <para style="q" vid="PSA 104:11">Amu punda wamntundu wapoliziya kwimiluwa kwawu.<verse eid="PSA 104:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12" />Wampongu wa kulyela wanyawa vitukulu vyawu,</para>
  <para style="q" vid="PSA 104:12">wankwimba pawawera muntambi zya mitera.<verse eid="PSA 104:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13" />Kulawa pampindi pa migongu mashi guganyiririka,</para>
  <para style="q" vid="PSA 104:13">na pasipanu gupamemiziya kwa lihengu lya lyaku.<verse eid="PSA 104:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14" />Gutenda ntundu imeri toziya ya mifugu,</para>
  <para style="q" vid="PSA 104:14">na vimeru kwajili ya matenderu ga wantu</para>
  <para style="q" vid="PSA 104:14">su womberi wapati shiboga kulawa mulitapaka,<verse eid="PSA 104:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15" />divayi ya kumkalamziya,</para>
  <para style="q" vid="PSA 104:15">lipaki kwajili ya kung'ereng'eziya sheni shakuyi,</para>
  <para style="q" vid="PSA 104:15">na libumunda lya kumpanana makakala.<verse eid="PSA 104:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16" />Mitera ya Mtuwa Mlungu ipata mashi gavuwa,</para>
  <para style="q" vid="PSA 104:16">mitera ya miyerezi yayiwera Lebanoni yakayiyaliti.<verse eid="PSA 104:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17" />Amu, wampongu wanyawa vitukulu vyawu;</para>
  <para style="q" vid="PSA 104:17">korongu kana numba mu mitera ya misonobali.<verse eid="PSA 104:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18" />Migongu mitali ndo pakulikala pa mbuzi wa kuntundu,</para>
  <para style="q" vid="PSA 104:18">na mpimbi wapata mafifu gawu mumatalabuhi.<verse eid="PSA 104:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19" />Gulitenditi lyezi lilangaziyi vyaka;</para>
  <para style="q" vid="PSA 104:19">mshenji guvimana shaka shakuyi sha kwinala.<verse eid="PSA 104:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20" />Gujega luwindu kuwera pashiru,</para>
  <para style="q" vid="PSA 104:20">na wankanyama woseri wa kuntundu wankulawa.<verse eid="PSA 104:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21" />Wana wa simba wankuguguma wapati vyawawinga,</para>
  <para style="q" vid="PSA 104:21">wankusakula viboga vyawu kulawa kwa Mlungu.<verse eid="PSA 104:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22" />Mshenji pagulawa wawuya kwawalawiti,</para>
  <para style="q" vid="PSA 104:22">na koyera mu mumpanga zyawu.<verse eid="PSA 104:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23" />Panu na muntu kagenda kumahengu gakuyi,</para>
  <para style="q" vid="PSA 104:23">na kutenda lihengu lyakuyi mpaka pashimihi.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24" />Gwee Mtuwa Mlungu, gutenda mirandu ivuwa nentu!</para>
  <para style="q" vid="PSA 104:24">Yoseri guyitenda kwa luhala!</para>
  <para style="q" vid="PSA 104:24">Pasipanu pamema viwumbi vyaku.<verse eid="PSA 104:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25" />Kutali kulii kwana bahari nkulu na ipanuka,</para>
  <para style="q" vid="PSA 104:25">yeni imema viwumbi vyaviwalangikandiri,</para>
  <para style="q" vid="PSA 104:25">viwumbi vikomu, vididini na vikulu.<verse eid="PSA 104:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26" />Ndo mwazipita meli,</para>
  <para style="q" vid="PSA 104:26">na ulii kanyama Lewiyatani yagumwumbiti kavini amu.<verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27" />Woseri wankuhepera gwenga,</para>
  <para style="q" vid="PSA 104:27">guwapanani shiboga shawu kwa shaka shakuyi.<verse eid="PSA 104:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28" />Wankusola shoseri shilii shaguwapanana;</para>
  <para style="q" vid="PSA 104:28">pangukuzumla liwoku lyaku wikuta weri.<verse eid="PSA 104:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29" />Panguwatulira shisogu, watira,</para>
  <para style="q" vid="PSA 104:29">paguwusiya pumla yawu, wahowa,</para>
  <para style="q" vid="PSA 104:29">na kuwuya mulitapaka mwawalawiti.<verse eid="PSA 104:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30" />Kwa pumla yaku guwanyawa woseri,</para>
  <para style="q" vid="PSA 104:30">gwenga gupagalambula pasipanu kuwera pasyayi.<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31" />Uweru wa Mtuwa Mlungu ulikali mashaka goseri,</para>
  <para style="q" vid="PSA 104:31">Mtuwa Mlungu kanemeleri mahengu gakuyi mweni.<verse eid="PSA 104:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32" />Kapalola pasipanu napeni palendemera,</para>
  <para style="q" vid="PSA 104:32">kayishinkula migongu nayeni ilaviya lyosi!<verse eid="PSA 104:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33" />Hanimwimbili Mtuwa Mlungu makaliru gangu goseri,</para>
  <para style="q" vid="PSA 104:33">hanimzyumi Mlungu gwangu mashaka goseri ganilikala.<verse eid="PSA 104:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34" />Gwee Mtuwa Mlungu, gufiriziwi na maholu gangu aga,</para>
  <para style="q" vid="PSA 104:34">mana gwenga ndo nemeru yaneni.<verse eid="PSA 104:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35" />Yawana vidoda wagamiri nakamu pasipanu,</para>
  <para style="q" vid="PSA 104:35">na wakontola nawawera kayi!</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q" vid="PSA 104:35">Gwee moyu gwangu gumzyumi Mtuwa Mlungu!</para>
  <para style="q" vid="PSA 104:35">Gumzyumi Mtuwa Mlungu.<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s">Mlungu na wantu wakuyi</para>
  <para style="r">
    <ref loc="1CH 16:8-22">1 Mirandu 16:8-22</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1" />Mlongimayagashii kwa Mtuwa Mlungu, mbweri ukulu wakuyi,</para>
  <para style="q" vid="PSA 105:1">mugamaniziyi maisi mirandu yakatenditi.<verse eid="PSA 105:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2" />Mumwimbili na mumzyumi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 105:2">mtambili matendu gakuyi ga kulikangasha gakatenditi.<verse eid="PSA 105:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3" />Mlizyumiri litawu lyakuyi linanagala,</para>
  <para style="q" vid="PSA 105:3">yawamguwira Mtuwa Mlungu wanemeleri.<verse eid="PSA 105:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4" />Mumsakuli Mtuwa Mlungu na makakala gakuyi,</para>
  <para style="q" vid="PSA 105:4">msakuli sheni shakuyi mashaka goseri.<verse eid="PSA 105:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5" />Mliholi matendu gakuyi ga kulikangasha gakatenditi,</para>
  <para style="q" vid="PSA 105:5">mauzauza gakuyi na toza yakalaviyiti,<verse eid="PSA 105:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6" />mwenga wiwuka wa Abrahamu ntumintumi gwakuyi na</para>
  <para style="q" vid="PSA 105:6">mwenga wiwuka wa Yakobu, msyagulwa gwakuyi.<verse eid="PSA 105:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7" />Yomberi ndo Mtuwa Mlungu, Mlungu gwetu,</para>
  <para style="q" vid="PSA 105:7">toza zakuyi zyana likakala pasipanu poseri.<verse eid="PSA 105:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8" />Yomberi kalikola lipatanu lyakuyi mashaka goseri,</para>
  <para style="q" vid="PSA 105:8">katenda shakalongiti kwa viyiwuku elufu,<verse eid="PSA 105:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9" />lipatanu lyakatenditi na Abrahamu,</para>
  <para style="q" vid="PSA 105:9">na shakatakuliti katendi kwa Isaka.<verse eid="PSA 105:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10" />Kamlanguziyiti Yakobu kuwera lagalira,</para>
  <para style="q" vid="PSA 105:10">na kwa Israeli kuwera lipatanu lya mashaka goseri,<verse eid="PSA 105:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11" />“Pakalonga, haniwapanani isi ya Kanani,”</para>
  <para style="q" vid="PSA 105:11">nayeni hayiweli yenu maweni.<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12" />Wawaweriti wadidini,</para>
  <para style="q" vid="PSA 105:12">kayi waweriti wadidini nentu na wahenga muisi ya Kanaani,<verse eid="PSA 105:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13" />wayeritiyeriti kulawa isi mpaka isi,</para>
  <para style="q" vid="PSA 105:13">kulawa ukolamlima umu mpaka isi imonga.<verse eid="PSA 105:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14" />Kumbiti Mlungu kajimirandiri muntu kawawoneri,</para>
  <para style="q" vid="PSA 105:14">toziya yawu kawakalipiliti wafalumi,<verse eid="PSA 105:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15" />“Pakalonga namuwashinkula wasyagulwa waneni;</para>
  <para style="q" vid="PSA 105:15">namuwatenda wambuyi waneni.”<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16" />Mtuwa Mlungu kajegiti njala nkulu muisi yawu,</para>
  <para style="q" vid="PSA 105:16">kahalibisiya shiboga shawu shoseri.<verse eid="PSA 105:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17" />Kumbiti kamlongoliziyiti muntu yumu kulongolu kwawu,</para>
  <para style="q" vid="PSA 105:17">Yusufu kashuwuzwa kuwera mmanda.<verse eid="PSA 105:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18" />Wamtawiti magulu kwa minyololu,</para>
  <para style="q" vid="PSA 105:18">katawalirwa musingu kwa lugoyi lwa shuma,<verse eid="PSA 105:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19" />mpaka galii gakalongiti pagatendikiti.</para>
  <para style="q" vid="PSA 105:19">Mpaka shisoweru sha Mtuwa Mlungu pashimlanguziyiti handa muntu gwa nakaka.<verse eid="PSA 105:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20" />Shakapanu mfalumi gwa Misri kalagalira wamvuguliri,</para>
  <para style="q" vid="PSA 105:20">mkolamlima gwa wantu kamleka lekeru.<verse eid="PSA 105:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21" />Kamtula kaweri mkulu gwa numba yakuyi,</para>
  <para style="q" vid="PSA 105:21">na mkulu gwa lunda yakuyi yoseri,<verse eid="PSA 105:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22" />kawalongoziyi wantumintumi wa mfalumi ntambu yakafira,</para>
  <para style="q" vid="PSA 105:22">na kuwafunda luhala wazewi wakuyi.<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23" />Shakapanu Israeli kingira muisi ya Misri,</para>
  <para style="q" vid="PSA 105:23">Yakobu kawera mhenga muisi ya Hamu.<verse eid="PSA 105:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24" />Mtuwa Mlungu kawatenda wantu wakuyi wiwuli nentu,</para>
  <para style="q" vid="PSA 105:24">kawapanana likakala kuliku wankondu wawu.<verse eid="PSA 105:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25" />Kawatenda Wamisri wawakalaliri wantu wakuyi.</para>
  <para style="q" vid="PSA 105:25">Yawawatendera madoda wantumintumi wakuyi.<verse eid="PSA 105:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26" />Shakapanu kamlagalira Musa ntumintumi gwakuyi,</para>
  <para style="q" vid="PSA 105:26">na Aruni mweni yakamsyaguliti.<verse eid="PSA 105:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27" />Watenda langalira za Mlungu pakati pa Wamisri,</para>
  <para style="q" vid="PSA 105:27">na mauzauza muisi ya Hamu.<verse eid="PSA 105:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28" />Mlungu kajega luwindu lwalugibikiti isi,</para>
  <para style="q" vid="PSA 105:28">kumbiti Wamisri walemiti kujimira lagalira zakuyi.<verse eid="PSA 105:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29" />Kagalambula nshemba zawu kuwera mwazi,</para>
  <para style="q" vid="PSA 105:29">kawalaga wasomba wawu woseri.<verse eid="PSA 105:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30" />Malyuli wakangala isi yawu,</para>
  <para style="q" vid="PSA 105:30">ata munumba ya mfalumi wamema.<verse eid="PSA 105:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31" />Mlungu kalongiti, kulawira vipinga vya wavinkozi,</para>
  <para style="q" vid="PSA 105:31">na wamala wamema muisi yoseri.<verse eid="PSA 105:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32" />Katenditi mvula yawu iweri mvula ya mabuwi,</para>
  <para style="q" vid="PSA 105:32">na lumeta lumetiti muisi yawu yoseri,<verse eid="PSA 105:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33" />kahalibisiya mizabibu na mitini yawu,</para>
  <para style="q" vid="PSA 105:33">viraa kayimeganga mtera ya isi yawu.<verse eid="PSA 105:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34" />Mlungu kalonga, kulawira wanjombi,</para>
  <para style="q" vid="PSA 105:34">na vibatala yawawalangikandiri,<verse eid="PSA 105:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35" />wavimemena vimeru vyoseri muisi,</para>
  <para style="q" vid="PSA 105:35">waliya viboga vyawu vyoseri.<verse eid="PSA 105:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36" />Kawalagiti wiwuka wa kwanja muisi yawu,</para>
  <para style="q" vid="PSA 105:36">Wapantanjira wawu wa untemba wawu.<verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37" />Shakapanu kawalaviya wantu wa Israeli muisi,</para>
  <para style="q" vid="PSA 105:37">pawawera na mpiya na zahabu,</para>
  <para style="q" vid="PSA 105:37">pota kwahera ata yumu gwawu yakasigaliti.<verse eid="PSA 105:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38" />Wamisri wanemeleliti kuwuka kwawu,</para>
  <para style="q" vid="PSA 105:38">lyoga liwakoliti toziya yawu.<verse eid="PSA 105:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39" />Mlungu katuliti liwundi pampindi pa wantu wakuyi,</para>
  <para style="q" vid="PSA 105:39">na motu guwamulikiri pashiru.<verse eid="PSA 105:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40" />Waluwiti na yomberi kawajegera wankwali,</para>
  <para style="q" vid="PSA 105:40">kawikutuziya kwa mabumunda kulawa kumpindi.<verse eid="PSA 105:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41" />Kapantiti litalabuhi mashi galawa,</para>
  <para style="q" vid="PSA 105:41">ganyililika kushiwala gambira lushemba.<verse eid="PSA 105:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42" />Kaliholiti shakatakuliti shinanagala,</para>
  <para style="q" vid="PSA 105:42">shakampanananiti Abrahamu ntumintumi gwakuyi.<verse eid="PSA 105:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43" />Kawalaviya wantu wakuyi kwa nemeru,</para>
  <para style="q" vid="PSA 105:43">wasyagulwa wakuyi wimbiti na kufyapilira.<verse eid="PSA 105:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44" />Kawapananiti isi za wantu wamonga</para>
  <para style="q" vid="PSA 105:44">na kawapanana malambu ga wenikaya,<verse eid="PSA 105:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45" />su wakoli malagalira gakuyi</para>
  <para style="q" vid="PSA 105:45">na kuzijimira lagiru zakuyi.</para>
  <para style="b" vid="PSA 105:45" />
  <para style="q" vid="PSA 105:45">Kakwiswi Mtuwa Mlungu!<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s">Uheri wa Mlungu kwa wantu wakuyi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1" />Mumzyumi Mlungu!</para>
  <para style="q" vid="PSA 106:1">Mlongi mayagashi kwa Mtuwa Mlungu kwa kuwera ndo mheri,</para>
  <para style="q" vid="PSA 106:1">toziya ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 106:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2" />Gaa yakaweza kutamba matendu makulu ga Mtuwa Mlungu?</para>
  <para style="q" vid="PSA 106:2">Ndo gaa yakaweza kubwera zyuma zyakuyi ntambu yayifiruwa?<verse eid="PSA 106:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3" />Watekelerwa walii yawatenda shashifiruwa,</para>
  <para style="q" vid="PSA 106:3">yawatenda mashaka goseri vitwatira vya haki.<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4" />Gwee Mtuwa Mlungu nagundyaluwa shaka paguwatendera maheri wantu waku,</para>
  <para style="q" vid="PSA 106:4">guntangi shaka paguwalopola,<verse eid="PSA 106:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5" />su wezi kuwona ulunda wa wasyagulwa wakuyi,</para>
  <para style="q" vid="PSA 106:5">su nemeleri nemeru ya isi yaku na</para>
  <para style="q" vid="PSA 106:5">su nilitumbi pamuhera na wantu waku.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6" />Tutenda vidoda twenga na wambuyi wetu,</para>
  <para style="q" vid="PSA 106:6">tutenda makontola na tutenda madoda.<verse eid="PSA 106:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7" />Wambuyi wetu pawaweriti Misri,</para>
  <para style="q" vid="PSA 106:7">walisherandiri matendu gaku ga kulikangasha,</para>
  <para style="q" vid="PSA 106:7">waliholandiri uvuwa wa tanga zaku,</para>
  <para style="q" vid="PSA 106:7">kumbiti wagalambukiti kumpeku ya bahari ya Shamu.<verse eid="PSA 106:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8" />Kumbiti Mlungu kawalopoliti toziya litawu lyakuyi,</para>
  <para style="q" vid="PSA 106:8">su kalanguziyi likakala lyakuyi likulu.<verse eid="PSA 106:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9" />Kayikalipiliti bahari ya Shamu,</para>
  <para style="q" vid="PSA 106:9">na yeni iyuma,</para>
  <para style="q" vid="PSA 106:9">kawapitisiya amu handa kushiwala.<verse eid="PSA 106:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10" />Kawalopoliti mumawoku mwa yawawakalaliriti,</para>
  <para style="q" vid="PSA 106:10">kawalopoliti kulawa kwa makakala ga wankondu wawu.<verse eid="PSA 106:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11" />Mashi ga bahari gawagibikiriti wankondu wawu,</para>
  <para style="q" vid="PSA 106:11">kasigalandiri ata yumu gwawu.<verse eid="PSA 106:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12" />Ndo pawaminiti visoweru vyakuyi,</para>
  <para style="q" vid="PSA 106:12">wimba zyuma zyakuyi.<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13" />Kumbiti katepu walilyaluwiti matendu gakuyi,</para>
  <para style="q" vid="PSA 106:13">woya kutumbira magambiziya gakuyi.<verse eid="PSA 106:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14" />Wamemiti matamata nkulu kushiwala kulii na</para>
  <para style="q" vid="PSA 106:14">wamjeriti Mlungu kushiwala kulii.<verse eid="PSA 106:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15" />Nayomberi kawapanana shilii shawaluwiti,</para>
  <para style="q" vid="PSA 106:15">kumbiti kajega malweri madoda gakuwapungula makakala<verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16" />Kulugonjeru wamwoniriti weya Musa na</para>
  <para style="q" vid="PSA 106:16">Aruni mnanagala gwa Mtuwa Mlungu.<verse eid="PSA 106:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17" />Shakapanu litapaka lipantika na kummira Datani na</para>
  <para style="q" vid="PSA 106:17">kumfintira Abiramu na shipinga shakuyi shoseri,<verse eid="PSA 106:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18" />motu gwaka pakati pa wantu walii yawawera pamuhera nawa,</para>
  <para style="q" vid="PSA 106:18">guwalunguziya wantu wakontola.<verse eid="PSA 106:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19" />Wanyawiti ng'ombi gwa zahabu kulii Horebu,</para>
  <para style="q" vid="PSA 106:19">waguwira shinyagu ashi sha shuma,<verse eid="PSA 106:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20" />wawugalambuliti uweru wa Mlungu,</para>
  <para style="q" vid="PSA 106:20">kwa shinyagu sha ng'ombi yakaliya ntundu.<verse eid="PSA 106:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21" />Wamulwaluwiti Mlungu yakawalopoliti,</para>
  <para style="q" vid="PSA 106:21">yakatenditi mirandu mikulu muisi ya Misri,<verse eid="PSA 106:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22" />makangashu muisi ayi ya Hamu na</para>
  <para style="q" vid="PSA 106:22">mirandu ya kutiriziya mubahari ya Shamu.<verse eid="PSA 106:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23" />Mlungu kalongiti hakawangamizi,</para>
  <para style="q" vid="PSA 106:23">kumbiti Musa msyagulwa gwakuyi kingiliya pakati,</para>
  <para style="q" vid="PSA 106:23">kagalewelera maya ga Mlungu nagawagamiziya.<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24" />Shakapanu wayibeziya isi ilii iherepa,</para>
  <para style="q" vid="PSA 106:24">waminitindiri shakalongiti.<verse eid="PSA 106:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25" />Walalamikiti mumalingu gawu,</para>
  <para style="q" vid="PSA 106:25">walemiti kumpikanira Mtuwa Mlungu.<verse eid="PSA 106:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26" />Hangu Mlungu kalirapa,</para>
  <para style="q" vid="PSA 106:26">pakalonga, haniwagamiziyi kushiwala,<verse eid="PSA 106:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27" />haniwapalasiyi wiwuka wawu pakati pa wantu na</para>
  <para style="q" vid="PSA 106:27">kuwapalasiya pasipanu poseri.<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28" />Shakapanu waweriti pamuhera na wantu yawamguwira Baali kulii Peori,</para>
  <para style="q" vid="PSA 106:28">waliya tambiku zyawatambikiliti mahoka.<verse eid="PSA 106:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29" />Wamkalaziyiti nentu Mtuwa Mlungu kwa Matendu gawu,</para>
  <para style="q" vid="PSA 106:29">malweri madoda galawira pakati pawu.<verse eid="PSA 106:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30" />Kumbiti Finehasi kagenda kuwalaga walii yawatenditi makontola</para>
  <para style="q" vid="PSA 106:30">na malweri galii gapera.<verse eid="PSA 106:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31" />Kwakutenda hangu kawoneka kuwera na haki,</para>
  <para style="q" vid="PSA 106:31">kwanjira shiyiwuku mpaka shiyiwuku.<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32" />Wamkalaziyiti Mlungu pamashi ga Meriba,</para>
  <para style="q" vid="PSA 106:32">Musa katabika kwajili yawu.<verse eid="PSA 106:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33" />Wambeziyiti rohu gwa Mlungu,</para>
  <para style="q" vid="PSA 106:33">na kumtenda musa katakula visoweru vya uzigizigi.<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34" />Wawalagandiri wantu wa maisi gamonga,</para>
  <para style="q" vid="PSA 106:34">handa Mtuwa Mlungu ntambu yakawalagaliriti,<verse eid="PSA 106:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35" />su walijojonira na wantu wa maisi,</para>
  <para style="q" vid="PSA 106:35">walifunda kutenda mirandu yawu.<verse eid="PSA 106:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36" />Waguwiriti vinyagu vya wamlungu wawu,</para>
  <para style="q" vid="PSA 106:36">vyeni viwera mgomiziwu gwa kuwangamiziya.<verse eid="PSA 106:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37" />Wawalagiti wana wawu wapalu na wadala,</para>
  <para style="q" vid="PSA 106:37">walaviya tambiku kwa washamshera.<verse eid="PSA 106:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38" />Wititi mwazi gwa wantu yawahera na likosa,</para>
  <para style="q" vid="PSA 106:38">mwazi gwa wana wawu wapalu na wadala weni wawalaviyiti tambiku kwa shinyagu sha kanani na</para>
  <para style="q" vid="PSA 106:38">isi idodiziwa na mwazi agu.<verse eid="PSA 106:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39" />Hangu walidodiziya kwa matendu gawu,</para>
  <para style="q" vid="PSA 106:39">gawatenditi galifana na wahumba.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40" />Hangu Mtuwa Mlungu kawakalaliriti nentu wantu wakuyi,</para>
  <para style="q" vid="PSA 106:40">kakalaziwa nentu na awa yawaweriti lunda yakuyi.<verse eid="PSA 106:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41" />Kawalekera mumawoku mwa wantu wa maisi,</para>
  <para style="q" vid="PSA 106:41">na wankondu wawakolamlima.<verse eid="PSA 106:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42" />Wankondu wawu wawayoniliti,</para>
  <para style="q" vid="PSA 106:42">wawakolamlima.<verse eid="PSA 106:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43" />Mala zivuwa Mtuwa Mlungu kawalopoliti wantu wakuyi,</para>
  <para style="q" vid="PSA 106:43">kumbiti womberi wamgalambukiti,</para>
  <para style="q" vid="PSA 106:43">wendereya kutenda ukontola wawu.<verse eid="PSA 106:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44" />Kumbiti Mtuwa Mlungu kalola ntabiku zawu,</para>
  <para style="q" vid="PSA 106:44">shaka pakapikiniriti kulira kwawu,<verse eid="PSA 106:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45" />Kwajili yawu kaliholiti lipatanu lyawu,</para>
  <para style="q" vid="PSA 106:45">kawawonera lusungu kwa ufiru wakuyi uvuwa.<verse eid="PSA 106:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46" />Kawatenditi yawawayoneriti Waisraeli,</para>
  <para style="q" vid="PSA 106:46">wawawoneri lusungu.<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47" />Gwee Mtuwa Mlungu, Mlungu gwetu, gutulopoli</para>
  <para style="q" vid="PSA 106:47">gutujojoniri pamuhera kulawa mu maisi,</para>
  <para style="q" vid="PSA 106:47">su tuligambiri mayagashishi litawu lyaku linanagala na</para>
  <para style="q" vid="PSA 106:47">kulitumbira zyuma zyaku.<verse eid="PSA 106:47" /></para>
  <para style="b" />
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48" />Kazyumwi Mtuwa Mlungu, Mlungu gwa Israeli,</para>
  <para style="q" vid="PSA 106:48">mashaka goseri!</para>
  <para style="q" vid="PSA 106:48">Na wantu woseri walongi, amina!</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q" vid="PSA 106:48">Kazyumi Mtuwa Mlungu!<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">SHITABU SHA MHANU</para>
  <para style="mr">
    <ref loc="PSA 107-150">Zabuli 107-150</ref></para>
  <para style="s">Kumzyuma Mlungu kwa uheri wakuyi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1" />Mlongi mayagashii kwa Mtuwa Mlungu toziya ndo muheri,</para>
  <para style="q" vid="PSA 107:1">toziya ufiru wakuyi ulikala mashaka goseri!<verse eid="PSA 107:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2" />Mtakuli hangu, mwenga yamlopolitwi na Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 107:2">wantu weni kawalopoliti kulawa mumawoku mwa wankondu,<verse eid="PSA 107:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3" />kawajojoniriti kulawa isi ya shihenga:</para>
  <para style="q" vid="PSA 107:3">kulawa kwagulawa mshenji na kwaguzyeta mshenji,</para>
  <para style="q" vid="PSA 107:3">kulawa kushana na kusika.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4" />Woseri wayeritiyeriti mushiwala,</para>
  <para style="q" vid="PSA 107:4">pota wawonandiri njira ya kugenda ku mji su kulikala.<verse eid="PSA 107:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5" />Waweriti na njala na wimuluwa,</para>
  <para style="q" vid="PSA 107:5">waheriti makakala nakamu.<verse eid="PSA 107:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6" />Muntabiku yawu wamliliriti Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 107:6">nayomberi kawalopola muntabiku yawu.<verse eid="PSA 107:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7" />Kawalonguziya munjira yayinyoshikiti,</para>
  <para style="q" vid="PSA 107:7">mpaka wasoka mji gwa kulikala.<verse eid="PSA 107:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8" />Su wamgambiri mayagashii Mtuwa Mlungu kwa ufiru wakuyi mkulu,</para>
  <para style="q" vid="PSA 107:8">na kwa matendu gakuyi gakulikangasha gakawatendiriti wantu.<verse eid="PSA 107:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9" />Yomberi kapeliziya kwimiluwa,</para>
  <para style="q" vid="PSA 107:9">na yawana njala kawikutuziya maheri.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10" />Walii yawalikaliti mluwindu na luwindu dunyu,</para>
  <para style="q" vid="PSA 107:10">na watatilwa muminyololu,<verse eid="PSA 107:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11" />toziya wagagalambukiti visoweru vya Mlungu,</para>
  <para style="q" vid="PSA 107:11">na kugabeziya matakuziya gakuyi Mlungu gwa kumpindi.<verse eid="PSA 107:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12" />Watokiti kwa lihengu likamala,</para>
  <para style="q" vid="PSA 107:12">Waguwa pasi na paweritindiri muntu gwa kuwatanga.<verse eid="PSA 107:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13" />Muntabika yawu wamlilira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 107:13">nayomberi kawalopola mumatesu gawu.<verse eid="PSA 107:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14" />Kawalaviyiti mluwindu na luwindu dunyu,</para>
  <para style="q" vid="PSA 107:14">na minyololu yawu kayimeganga.<verse eid="PSA 107:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15" />Su wamgambili mayagashii Mtuwa Mlungu kwa ufiru wakuyi mkulu,</para>
  <para style="q" vid="PSA 107:15">na kwa makangashu gakawatendiliti wantu.<verse eid="PSA 107:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16" />Yomberi kamega migomi ya shaba,</para>
  <para style="q" vid="PSA 107:16">na kudumuladumula pingu za shuma.<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17" />Wawaweriti wazigizigi toziya ya ugalambuka wawu,</para>
  <para style="q" vid="PSA 107:17">watabikiti toziya ya ukontola wawu,<verse eid="PSA 107:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18" />Wakalaliriti viboga vyoseri,</para>
  <para style="q" vid="PSA 107:18">waweriti sambira kuhowa.<verse eid="PSA 107:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19" />Wamlilira Mtuwa Mlungu muntabiku yawu,</para>
  <para style="q" vid="PSA 107:19">nayomberi kawalopola mumatesu gawu.<verse eid="PSA 107:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20" />Kwa shisoweru shakuyi kawaponiziyiti,</para>
  <para style="q" vid="PSA 107:20">kawalopola nawagamira.<verse eid="PSA 107:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21" />Su wamgambiri mayagashi Mtuwa Mlungu kwa ufiru wakuyi mkulu,</para>
  <para style="q" vid="PSA 107:21">na kwa makangashu gakawatendiriti wantu.<verse eid="PSA 107:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22" />Na walaviyi tambiku za kulonga mayagashii,</para>
  <para style="q" vid="PSA 107:22">wimbi kwa nemeru toziya ya matendu gakuyi.<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23" />Walii yawanitimwanja kwa meli mubahali,</para>
  <para style="q" vid="PSA 107:23">watenditi biashara zawu mumashi matali.<verse eid="PSA 107:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24" />Wagawoniti matendu ga Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 107:24">mirandu ya kulikangasha gakatenditi aku.<verse eid="PSA 107:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25" />Kalagaliliti na lyega lilawira,</para>
  <para style="q" vid="PSA 107:25">linyasula makupala ga bahari.<verse eid="PSA 107:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26" />Meli zinyasulwa pampindi,</para>
  <para style="q" vid="PSA 107:26">nakuwuya pasi pamashi matali.</para>
  <para style="q" vid="PSA 107:26">Muntabiku ayi ugangamala wawu upera.<verse eid="PSA 107:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27" />Wawegukaweguka na kushashatika handa walowera,</para>
  <para style="q" vid="PSA 107:27">kudaha kwawu kupera.<verse eid="PSA 107:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28" />Muntabiku zawu wamlilira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 107:28">nayomberi kawalopola mumatesu gawu.<verse eid="PSA 107:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29" />Kanyamaziya lyega,</para>
  <para style="q" vid="PSA 107:29">na makupala ga bahari ganyamala.<verse eid="PSA 107:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30" />Wanemelera shaka bahali payinyamaliti,</para>
  <para style="q" vid="PSA 107:30">kawalonguziya mpaka pa shiloku sha meli shawashifiriti.<verse eid="PSA 107:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31" />Su wamgambili mayagashii Mtuwa Mlungu kwa ufiru wakuyi mkulu,</para>
  <para style="q" vid="PSA 107:31">na kwa makangashu gakawatendiliti wantu.<verse eid="PSA 107:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32" />Wamkwisi mulijojoniku lya wantu,</para>
  <para style="q" vid="PSA 107:32">na kumzyuma pashoteramotu sha wazewi.<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33" />Mlungu kazigalambuliti nshemba kuwera shiwala,</para>
  <para style="q" vid="PSA 107:33">bwiru kaziyumiziyiti nakamu.<verse eid="PSA 107:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34" />Litapaka lyana wolera kalitenda litapaka lya munu,</para>
  <para style="q" vid="PSA 107:34">toziya ya ukontola wa wenikaya wakuyi.<verse eid="PSA 107:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35" />Kagalambuliti shiwala kuwera matanda ga mashi,</para>
  <para style="q" vid="PSA 107:35">na isi iyuma kuwera mbwiru za mashi.<verse eid="PSA 107:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36" />Kawahamiziya aku wananjala,</para>
  <para style="q" vid="PSA 107:36">nawomberi wanyawa mji gwa kulikala.<verse eid="PSA 107:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37" />Walimiti malambu na kuyala mizabibu,</para>
  <para style="q" vid="PSA 107:37">wabenanga viboga vivuwa.<verse eid="PSA 107:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38" />Kawatekeleriti wantu wakuyi, na weni wongereka,</para>
  <para style="q" vid="PSA 107:38">na walanga ya mifugu yawu yongeleka.<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39" />Shakapanu walanga yawu payiweriti ndidini na kutokuwera na likakala</para>
  <para style="q" vid="PSA 107:39">kwa kuyonerwa, ntabiku na kwinginika,<verse eid="PSA 107:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40" />kawasoniziti wakulu yawawayoneriti,</para>
  <para style="q" vid="PSA 107:40">kwa kuwayeriziya kushiwala kwakuwerandiri na njira.<verse eid="PSA 107:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41" />Kumbiti kawalopola wananfiru muntabika zawu,</para>
  <para style="q" vid="PSA 107:41">kongera walongu wawu handa shipinga sha kondolu.<verse eid="PSA 107:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42" />Waminika pawawoniti mlandu agu wanemelera,</para>
  <para style="q" vid="PSA 107:42">kumbiti wakontola woseri wanyamala.<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43" />Yakana luhala na kaliholi mirandu ayi,</para>
  <para style="q" vid="PSA 107:43">kaliholi ufiru mkulu wa Mtuwa Mlungu.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s">Kuluwa utanga toziya ya wankondu</para>
  <para style="r">
    <ref loc="PSA 57:7-11">Zabuli 57:7-11</ref>,<ref loc="PSA 60:5-12">60:5-12</ref></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 108:1" />Gwee Mlungu ngangamala kumoyu,</para>
  <para style="q" vid="PSA 108:1">hanimbi na kukufyapilira!</para>
  <para style="q" vid="PSA 108:1">Gwimuka, gwee moyu gwangu!<verse eid="PSA 108:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2" />Mwimuki mwee lingutinguti na lugombugombu!</para>
  <para style="q" vid="PSA 108:2">Hanikwimusiyi mandawira putiputi.<verse eid="PSA 108:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3" />Gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 108:3">hanongi mayagashii pakati pa wantu,</para>
  <para style="q" vid="PSA 108:3">hanikuzyumi pakati pa maisi gamonga.<verse eid="PSA 108:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4" />Mana ufiru waku ndo mkulu kuliku mpindi,</para>
  <para style="q" vid="PSA 108:4">uwaminika waku usoka mpaka kumawundi.<verse eid="PSA 108:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5" />Gwee Mlungu gukwiswi kumpindi!</para>
  <para style="q" vid="PSA 108:5">Uweru waku uweri pasipanu poseri!<verse eid="PSA 108:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6" />Wantu awa yaguwafira na waponiziwi,</para>
  <para style="q" vid="PSA 108:6">guwatangi kwa liwoku lyaku na gutwankuli.<verse eid="PSA 108:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7" />Mlungu katakula kulawa pananagala pakuyi,</para>
  <para style="b" vid="PSA 108:7" />
  <para style="q" vid="PSA 108:7">“Pawera mkanka haniyibaguli Shekemu,</para>
  <para style="q" vid="PSA 108:7">na lulalanda lwa Sukoti hanilupimi vipandi vipandi.<verse eid="PSA 108:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8" />Gileadi ndo yaneni na Manasi ndo yaneni,</para>
  <para style="q" vid="PSA 108:8">Efraimu ndo kofia yaneni ya shuma,</para>
  <para style="q" vid="PSA 108:8">na Yuda ndo luhonga lyaneni lya ukolamlima.<verse eid="PSA 108:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9" />Isi ya Moabu ndo handa bakuli yaneni ya kunawira,</para>
  <para style="q" vid="PSA 108:9">shilwatu shaneni hanishasili isi ya Edomu kuyikolamlima.</para>
  <para style="q" vid="PSA 108:9">Hambotangili ukanka mu isi ya Filisti!”<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10" />Gaa yakafira kunjega kumji yagwana liboma?</para>
  <para style="q" vid="PSA 108:10">Gaa yakaweza kunongoziya mpaka muisi ya Edomu?<verse eid="PSA 108:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11" />Gwee Mlungu, gutuleka nakamu?</para>
  <para style="q" vid="PSA 108:11">Hashi gugendandiri na wamashonta wetu?<verse eid="PSA 108:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12" />Gututangi tuwakanki wankondu wetu,</para>
  <para style="q" vid="PSA 108:12">toziya utanga wa wantu ufaandiri shintu.<verse eid="PSA 108:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13" />Mlungu pakawera uwega watwenga hatukanki,</para>
  <para style="q" vid="PSA 108:13">yomberi hakawaposholi wankondu wetu.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s">Lilalamiku lya muntu yakawera muntabiku</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 109:1" />Gwee Mlungu, yanikuzyuma nagunyamala,<verse eid="PSA 109:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2" />mana wantu wazyanga na wapayira, wantakulira madoda.</para>
  <para style="q" vid="PSA 109:2">Watakula mpayu toziya yaneni.<verse eid="PSA 109:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3" />Watakula makontola toziya neni,</para>
  <para style="q" vid="PSA 109:3">na kunkomanga pota likosa.<verse eid="PSA 109:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4" />Tembera niwafiriti womberi wankomangiti,</para>
  <para style="q" vid="PSA 109:4">kumbiti neni niwaluwiriti.<verse eid="PSA 109:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5" />Wandipa ukontola kwa maheri ganeni,</para>
  <para style="q" vid="PSA 109:5">na nkalaliru kwa ufiru wangu.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6" />Wankondu waneni watakula, mumsakuli muntu mkontola kasingani nayu,</para>
  <para style="q" vid="PSA 109:6">na yakamsitaki kamjegi kumahakama.<verse eid="PSA 109:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7" />Pakatozwa kapatikani na likosa,</para>
  <para style="q" vid="PSA 109:7">na pakaliteteya kongera likosa limonga.<verse eid="PSA 109:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8" />Mashaka ga makaliru gakuyi gaweri madidini,</para>
  <para style="q" vid="PSA 109:8">muntu yumonga katoli lihengu lyakuyi!<verse eid="PSA 109:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9" />Wana wakuyi waweri wahera tati,</para>
  <para style="q" vid="PSA 109:9">na mdala gwakuyi kaweri mkenja!<verse eid="PSA 109:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10" />Wana wakuyi wayeriyeri na kuluwaluwa,</para>
  <para style="q" vid="PSA 109:10">wawigwi mumahami ga numba zawu!<verse eid="PSA 109:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11" />Yakamshonga shintu kampoki lunda yakuyi yoseri,</para>
  <para style="q" vid="PSA 109:11">na wahenga watoli mpatiru zakuyi zoseri!<verse eid="PSA 109:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12" />Napawera na muntu gwa kumwonera lusungu,</para>
  <para style="q" vid="PSA 109:12">ama kuwalera wana wakuyi yawahera tati.<verse eid="PSA 109:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13" />Wiwuka wakuyi woseri wahowi,</para>
  <para style="q" vid="PSA 109:13">litawu lyakuyi liwaluwi mushiyiwuku shashiza.<verse eid="PSA 109:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14" />Mtuwa Mlungu kawuholi ukontola wa wambuyi wakuyi,</para>
  <para style="q" vid="PSA 109:14">vidoda vya mawu gwakuyi navilekeziwa!<verse eid="PSA 109:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15" />Mtuwa Mlungu kaviholi vidoda vyawu mashaka goseri,</para>
  <para style="q" vid="PSA 109:15">su woseri walyaluwiki pasipanu.<verse eid="PSA 109:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16" />Mkontola ayu kalisherandiri kutenda maheri,</para>
  <para style="q" vid="PSA 109:16">ila kawawingiti wahushu na yawahera shintu,</para>
  <para style="q" vid="PSA 109:16">na yawatwezuka moyu kawalaga.<verse eid="PSA 109:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17" />Kafiriti kupangira wantu,</para>
  <para style="q" vid="PSA 109:17">pangira na impati mweni.</para>
  <para style="q" vid="PSA 109:17">Kawafilirandiri kuwatekelera wamonga,</para>
  <para style="q" vid="PSA 109:17">nayomberi nakatekelerwa.<verse eid="PSA 109:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18" />Kwakuyi pangira handa kuvala nguwu,</para>
  <para style="q" vid="PSA 109:18">pangira azi zimuloviyi handa mashi,</para>
  <para style="q" vid="PSA 109:18">zimwigili mumihonju mwakuyi handa lipaki.<verse eid="PSA 109:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19" />Pangira imgibikili handa nguwu,</para>
  <para style="q" vid="PSA 109:19">kalitawi handa lugoyi lwa kupota.<verse eid="PSA 109:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20" />Mtuwa Mlungu kawawuzilili wantu awa yawashitaki,</para>
  <para style="q" vid="PSA 109:20">awa yawatakula madoda kwa neni.<verse eid="PSA 109:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21" />Kumbiti gwee Mtuwa Mlungu, Mtuwa gwangu,</para>
  <para style="q" vid="PSA 109:21">guntangi kwajili ya ligoya lya litawu lyaku,</para>
  <para style="q" vid="PSA 109:21">gundopoli kwajili ya uheri wa ufiru waku!<verse eid="PSA 109:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22" />Neni ndo mhushu na nahera shintu,</para>
  <para style="q" vid="PSA 109:22">ntenduwa mpaka mumoyu mwangu.<verse eid="PSA 109:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23" />Nagamira handa lisisi lya pashimihi,</para>
  <para style="q" vid="PSA 109:23">ngulusiwa handa wanjombi.<verse eid="PSA 109:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24" />Manung'unu gangu gahera likakala kwa koyakuliya,</para>
  <para style="q" vid="PSA 109:24">nsigala mihonju na likuli hera.<verse eid="PSA 109:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25" />Wera lijonga hera kwa wantu,</para>
  <para style="q" vid="PSA 109:25">pawawona watikisiya mituwi yawu kwa beziya.<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26" />Gwee Mtuwa Mlungu, Mlungu gwangu,</para>
  <para style="q" vid="PSA 109:26">gundopoli teratera na ufiru waku.<verse eid="PSA 109:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27" />Guwalanguziyi wantu kuwera gwenga ndo yaguntenditi aga,</para>
  <para style="q" vid="PSA 109:27">gwenga Mtuwa Mlungu, ndo yagutenditi hangu.<verse eid="PSA 109:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28" />Guwaleki wapangili kumbiti gwenga guntekeleri,</para>
  <para style="q" vid="PSA 109:28">yawankomanga wasoniziwi na neni ntumintumi gwaku nemeleri.<verse eid="PSA 109:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29" />Yawasitaki na wasoniziwi,</para>
  <para style="q" vid="PSA 109:29">waligibikili soni yawu handa libulangeti,<verse eid="PSA 109:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30" />Hanongi mayagashi kwa Mtuwa Mlungu kwa liziwu,</para>
  <para style="q" vid="PSA 109:30">hanimzyumi pakati pa shipinga shikulu sha wantu,<verse eid="PSA 109:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31" />toziya yomberi kamtanga muhushu,</para>
  <para style="q" vid="PSA 109:31">kamlopola shaka pakatozwa.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s">Mtuwa Mlungu na mfalumi msyagulwa gwakuyi</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 110:1" />Mtuwa Mlungu kamgambira mtuwa gwangu,</para>
  <para style="q" vid="PSA 110:1">“Gulikali uwega waneni wa kumliwu,</para>
  <para style="q" vid="PSA 110:1">mpaka paniwatula wankondu waku pasi pa magulu gaku”<verse eid="PSA 110:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2" />Mtuwa Mlungu hakapalasiyi makakala gaku ga ukulu kulawa Sayuni,</para>
  <para style="q" vid="PSA 110:2">hagukolimlima wankondu waku woseri.<verse eid="PSA 110:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3" />Wantu waku hawalilavii weni,</para>
  <para style="q" vid="PSA 110:3">mu lishaka pagugenda kuwakomanga wankondu.</para>
  <para style="q" vid="PSA 110:3">Paguwera guvaliziwa nguwu nanagala,</para>
  <para style="q" vid="PSA 110:3">na makakala gaku hagatendwi syayi handa mangami ga mandawira.<verse eid="PSA 110:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4" />Mtuwa Mlungu kalirapa na hapeni kagalambuli maholu gakuyi:</para>
  <para style="q" vid="PSA 110:4">“Gwenga ndo mtambika mashaka goseri ntambu yakaweriti Melikizedeki.”<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5" />Mtuwa kauwega waku wa kumliwu,</para>
  <para style="q" vid="PSA 110:5">hakawaposholi wafalumi pakakalalaku.<verse eid="PSA 110:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6" />Hakagatozi maisi na kuwalaga wantu wavuwa,</para>
  <para style="q" vid="PSA 110:6">Hakawapondi wakulu kila pahala pasipanu.<verse eid="PSA 110:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7" />Mfalumi hakalandi mashi ga lushemba lwaluwera pakwegera na njira,</para>
  <para style="q" vid="PSA 110:7">nayomberi hakaweri mkanka.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s">Mlungu kazyumwa kwa makangashu gakuyi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1" />Mmuzyumi Mtuwa Mlungu!</para>
  <para style="b" vid="PSA 111:1" />
  <para style="q" vid="PSA 111:1">Hanongi mayagashi Mtuwa Mlungu kwa moyu gwangu goseri,</para>
  <para style="q" vid="PSA 111:1">mu lijojoniru lya wantu yawamguwira Mlungu.<verse eid="PSA 111:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2" />Matendu ga Mtuwa Mlungu ndo makulu nentu!</para>
  <para style="q" vid="PSA 111:2">Woseri yawaganemelera wagaholera.<verse eid="PSA 111:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3" />Kila shakatenda shimema uweru na ligoya,</para>
  <para style="q" vid="PSA 111:3">haki yakuyi ilikala mashaka goseri.<verse eid="PSA 111:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4" />Katenda matendu gakuyi ga kulikangasha gaholuwi,</para>
  <para style="q" vid="PSA 111:4">Mtuwa Mlungu ndo mheri na kana lusungu.<verse eid="PSA 111:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5" />Kankuwapanana shiboga yawamguwira,</para>
  <para style="q" vid="PSA 111:5">kalyaluwandiri lipatanu lyakuyi mashaka goseri.<verse eid="PSA 111:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6" />Kawalanguziya wantu wakuyi uwezu wa matendu gakuyi,</para>
  <para style="q" vid="PSA 111:6">kwa kuwapanana isi za maisi gamonga ziweri lunda yakuyi.<verse eid="PSA 111:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7" />Matendu gakuyi ndo ga haki na ga kwaminika;</para>
  <para style="q" vid="PSA 111:7">lagiru zakuyi zoseri ndo za kutumbilwa.<verse eid="PSA 111:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8" />Lagalira zakuyi zigangamala mashaka goseri;</para>
  <para style="q" vid="PSA 111:8">zilaviwa kwa haki na waminika.<verse eid="PSA 111:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9" />Kawalopoliti wantu wakuyi</para>
  <para style="q" vid="PSA 111:9">na kutenda nawa lipatanu lya mashaka goseri.</para>
  <para style="q" vid="PSA 111:9">Yomberi ndo mnanagala na gwa kutirwa!<verse eid="PSA 111:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10" />Kumguwira Mtuwa Mlungu ndo shanjiru sha luhala;</para>
  <para style="q" vid="PSA 111:10">woseri yawazijimira lagiru zakuyi wana luhala.</para>
  <para style="q" vid="PSA 111:10">Zyuma zakuyi zilikala mashaka goseri.<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s">Katekelerwa muntu yakana haki</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1" />Mmuzyumi Mtuwa Mlungu!</para>
  <para style="b" vid="PSA 112:1" />
  <para style="q" vid="PSA 112:1">Katekelerwa muntu yakamguwira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 112:1">yakanemelera nentu kujimira lagiru zakuyi.<verse eid="PSA 112:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2" />Wana wakuyi hawaweli wana likakala mu isi,</para>
  <para style="q" vid="PSA 112:2">wiwuka wa muntu mwaminika hawutekelerwi.<verse eid="PSA 112:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3" />Ukaya kwakuyi hakuweri na lunda zivuwa,</para>
  <para style="q" vid="PSA 112:3">haki yakuyi hayilikali mashaka goseri<verse eid="PSA 112:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4" />Kuwala kulangala kuluwindu kwajili ya wantu waheri,</para>
  <para style="q" vid="PSA 112:4">na kwa yakana lusungu, mnyamalira na yakana haki.<verse eid="PSA 112:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5" />Katekelerwa muntu mheri yakalaviya uwanda kwa manemu,</para>
  <para style="q" vid="PSA 112:5">yakatenda mahengu gakuyi kwa haki.<verse eid="PSA 112:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6" />Mana hapeni kasindi nakamu,</para>
  <para style="q" vid="PSA 112:6">yakana haki hakaholwi mashaka goseri.<verse eid="PSA 112:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7" />Hapenikatiri visoweru vidoda,</para>
  <para style="q" vid="PSA 112:7">kana moyu gugangamala na kamtumbira Mtuwa Mlungu.<verse eid="PSA 112:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8" />Kagangamala mumoyu, pota kutira,</para>
  <para style="q" vid="PSA 112:8">nayomberi hakawawoni wankondu zakuyi wankusinda.<verse eid="PSA 112:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9" />Kalaviya kwa kukalamuka, kawapanana wahushu,</para>
  <para style="q" vid="PSA 112:9">haki yakuyi ilikala mashaka goseri,</para>
  <para style="q" vid="PSA 112:9">muntu ayu hakapananwi ligoya nentu.<verse eid="PSA 112:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10" />Wantu wakontola hawagawoni aga na kukalala,</para>
  <para style="q" vid="PSA 112:10">wagayagaya menu kwa ngalaliru na kwagamira,</para>
  <para style="q" vid="PSA 112:10">matumbiru ga muntu mdoda gagamira hera.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s">Zyuma zya Mtuwa Mlungu kwa uheri wakuyi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1" />Mumzyumi Mtuwa Mlungu!</para>
  <para style="b" vid="PSA 113:1" />
  <para style="q" vid="PSA 113:1">Mwenga wantumintumi wa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 113:1">mlizyumi litawu lyakuyi!<verse eid="PSA 113:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2" />Litawu lya Mtuwa Mlungu litekelerwi,</para>
  <para style="q" vid="PSA 113:2">vinu na ata mashaka goseri.<verse eid="PSA 113:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3" />Kulawa kwakagulawa mshenji mpaka kwaguzyeta mshenji,</para>
  <para style="q" vid="PSA 113:3">litawu lya Mtuwa Mlungu likwiswi!<verse eid="PSA 113:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4" />Mtuwa Mlungu kanyasulwa pampindi pa maisi goseri,</para>
  <para style="q" vid="PSA 113:4">uweru wakuyi usoka pampindi pa mpindi.<verse eid="PSA 113:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5" />Gaa yakawera handa Mtuwa Mlungu, Mlungu gwetu?</para>
  <para style="q" vid="PSA 113:5">Yomberi kalikala pampindi nentu,<verse eid="PSA 113:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6" />kumbiti kankulola pasi,</para>
  <para style="q" vid="PSA 113:6">kaziwoni mpindi na pasipanu.<verse eid="PSA 113:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7" />Kawanyasula wahushu kulawa mumadikudiku;</para>
  <para style="q" vid="PSA 113:7">kamnyasula yakana nfiru kulawa mulifunkusi,<verse eid="PSA 113:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8" />na kumtula pamuhera na wakulu,</para>
  <para style="q" vid="PSA 113:8">pamuhera na wakulu wa wantu wakuyi.<verse eid="PSA 113:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9" />Kampanana mdala mpendi nemeru mnumba mwakuyi,</para>
  <para style="q" vid="PSA 113:9">kamnemiziya kwa kumpanana wana.</para>
  <para style="b" vid="PSA 113:9" />
  <para style="q" vid="PSA 113:9">Mmuzyumi Mtuwa Mlungu!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s">Makangashu ga Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1" />Wantu wa Israeli pawalawiti Misri,</para>
  <para style="q" vid="PSA 114:1">wiwuka wa Yakobu pawalawiti muuhenga,<verse eid="PSA 114:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2" />mji gwa Yuda guweriti pahala pananagala,</para>
  <para style="q" vid="PSA 114:2">Israeli iwera ukolamlima wakuyi.<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3" />Bahari iwoniti aga itugiti,</para>
  <para style="q" vid="PSA 114:3">lushemba Yoridani luwuyiti kumberi.<verse eid="PSA 114:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4" />Migongu ikopokakopoka handa kondolu shipalu,</para>
  <para style="q" vid="PSA 114:4">vigongu vikopoka handa wana wa kondolu!<verse eid="PSA 114:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5" />Gwee bahari, iwerahashi gutuga?</para>
  <para style="q" vid="PSA 114:5">Nagwenga Yoridani, guwuya hashi kumberi?<verse eid="PSA 114:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6" />Mwenga migongu, iwerahashi mkopoka handa kondolu shipalu?</para>
  <para style="q" vid="PSA 114:6">Na mwenga vigongu, iwerahashi mkopoka handa wana wa kondolu?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7" />Gulendemeri, gwee pasipanu kulongolu kwakuyi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 114:7">gulendemeri kulongolu kwa Mlungu gwa Yakobu,<verse eid="PSA 114:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8" />ulii yakagalambula litalabuhi kuwera litanda lya mashi,</para>
  <para style="q" vid="PSA 114:8">na libuhi likamala kuwera bwiru za mashi.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s">Mlungu gwa nakaka ndo yumu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1" />Wakuzyumwa twengandiri, gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 115:1">ila gwenga gwekayaku,</para>
  <para style="q" vid="PSA 115:1">toziya ya ufiru waku na uaminika waku.<verse eid="PSA 115:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2" />Hashi maisi galongi,</para>
  <para style="q" vid="PSA 115:2">“Mlungu gwenu ka koshi?”<verse eid="PSA 115:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3" />Mlungu gwetu ka kumpindi,</para>
  <para style="q" vid="PSA 115:3">yomberi katenda loseri lyakafira.<verse eid="PSA 115:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4" />Wamlungu wawu ndo ya madini ga feza na zahabu,</para>
  <para style="q" vid="PSA 115:4">wanyawiwa kwa mawoku ga wantu.<verse eid="PSA 115:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5" />Wana milomu kumbiti watakulandiri.</para>
  <para style="q" vid="PSA 115:5">Wana masu kumbiti wawonandiri.<verse eid="PSA 115:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6" />Wana makutu kumbiti wapikanirandiri.</para>
  <para style="q" vid="PSA 115:6">Wana mpula kumbiti wanusiyandiri.<verse eid="PSA 115:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7" />Wana mawoku kumbuti wakolandiri.</para>
  <para style="q" vid="PSA 115:7">Wana magulu kumbiti wagendagendandiri,</para>
  <para style="q" vid="PSA 115:7">pota makulamiru gawu galaviyandiri liziwu.<verse eid="PSA 115:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8" />Woseri yawazinyawa hawaweri gambira womberi,</para>
  <para style="q" vid="PSA 115:8">ntambuiraa na woseri yawayitumbira.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9" />Mwenga wantu wa Israeli, mmutumbiri Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 115:9">yomberi ndo mtanga gwenu na liboma lyenu.<verse eid="PSA 115:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10" />Mwenga wiwuka wa Aruni, mmutumbiri Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 115:10">yomberi ndo lusegeyu lwenu na liboma lyenu.<verse eid="PSA 115:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11" />Mwenga yammuguwira Mtuwa Mlungu, mmutumbiri,</para>
  <para style="q" vid="PSA 115:11">yomberi ndo lusegeyu lwenu na liboma lyenu.<verse eid="PSA 115:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12" />Mtuwa Mlungu katuhola na hakatutekeleri,</para>
  <para style="q" vid="PSA 115:12">hakawatekeleri wantu wa Israeli,</para>
  <para style="q" vid="PSA 115:12">hakawatekeleri wiwuka wa Aruni.<verse eid="PSA 115:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13" />Hakawatekeleri woseri yawamguwira,</para>
  <para style="q" vid="PSA 115:13">hakawatekeleri wakulu kwa wapusu.<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14" />Mtuwa Mlungu kawatendi mwongereki,</para>
  <para style="q" vid="PSA 115:14">kawongeri mwenga na wiwuka wenu!<verse eid="PSA 115:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15" />Mtekelerwi na Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 115:15">yakaziwumbiti mpindi na pasipanu.<verse eid="PSA 115:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16" />Mpindi ndo yakuyi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 115:16">kumbiti pasipanu kawapanana wantu.<verse eid="PSA 115:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17" />Yawahowiti wamuzyumindiri Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 115:17">pota walii yawasuluka muisi ya wantu yawahowiti.<verse eid="PSA 115:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18" />Kumbiti twenga yatuwera wakomu twankumzyuma Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 115:18">kwanjira vinu mpaka mashaka goseri.</para>
  <para style="b" vid="PSA 115:18" />
  <para style="q" vid="PSA 115:18">Mmuzyumi Mtuwa Mlungu!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">Mayagashi kwa kulopolwa kulawa mukuhowa</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1" />Nimfira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 116:1">toziya kampikinira,</para>
  <para style="q" vid="PSA 116:1">kapikinira shaka pandira kuluwa utanga.<verse eid="PSA 116:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2" />Yomberi kampikanira,</para>
  <para style="q" vid="PSA 116:2">hangu hanimluwi shaka shoseri sha makaliru gangu.<verse eid="PSA 116:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3" />Atali ya kuhowa izyengetiti,</para>
  <para style="q" vid="PSA 116:3">vitiliziwu vya lisembi vinkankaliti,</para>
  <para style="q" vid="PSA 116:3">niwiti na magaziwu na kwinginika.<verse eid="PSA 116:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4" />Shakapanu nimlilira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 116:4">“Gwee Mtuwa Mlungu, shondi gundopoli!”<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5" />Mtuwa Mlungu ndo muheri na kana haki,</para>
  <para style="q" vid="PSA 116:5">Mlungu gwetu kana lusungu.<verse eid="PSA 116:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6" />Mtuwa Mlungu kawalolera wahushu,</para>
  <para style="q" vid="PSA 116:6">pamonilitwi kandopola.<verse eid="PSA 116:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7" />Gwee moyu gwangu guwuyi pahala paku,</para>
  <para style="q" vid="PSA 116:7">toziya Mtuwa Mlungu kakutendera maheri.<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8" />Gundopola mkuhowa</para>
  <para style="q" vid="PSA 116:8">gumpukuta masozi gangu,</para>
  <para style="q" vid="PSA 116:8">gundolera naniza kulikwala,<verse eid="PSA 116:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9" />hang'endi kulongolu kwa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 116:9">muisi ya wantu yawawera wakomu.<verse eid="PSA 116:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10" />Weriti na njimiru mpaka panongiti,</para>
  <para style="q" vid="PSA 116:10">“Neni ntabisiwa nentu.”<verse eid="PSA 116:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11" />Paweriti na lyoga nongiti,</para>
  <para style="q" vid="PSA 116:11">“Wantu woseri wapaya!”<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12" />Nimwuzilili shishi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 116:12">kwa uheri wakuyi woseri wakantenderiti?<verse eid="PSA 116:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13" />Hanimlavilili shikombi sha divayi kuwera tambiku,</para>
  <para style="q" vid="PSA 116:13">na kumgambira mayagashii Mtuwa Mlungu kwa kundopola.<verse eid="PSA 116:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14" />Hanimtendeli Mtuwa Mlungu nazili zangu,</para>
  <para style="q" vid="PSA 116:14">kulongolu kwa wantu wakuyi woseri.<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15" />Kuhowa kwa wamwamini kuna mana pamasu ga Mtuwa Mlungu.<verse eid="PSA 116:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16" />Gwee Mtuwa Mlungu neni na ntumintumi gwaku,</para>
  <para style="q" vid="PSA 116:16">neni na ntumintumi gwaku mwana gwa ntumintumi gwaku mdala,</para>
  <para style="q" vid="PSA 116:16">gundopola kulawa muvitawaliru vyangu.<verse eid="PSA 116:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17" />Hanikulaviliri tambiku za kulonga mayagashii,</para>
  <para style="q" vid="PSA 116:17">na kulishemira litawu lya Mtuwa Mlungu.<verse eid="PSA 116:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18" />Hantendi shantakuliti kwa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 116:18">kulongolu kwa wantu waku woseri,<verse eid="PSA 116:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19" />kuligeleri lya numba ya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 116:19">pakati pa Yerusalemu.</para>
  <para style="b" vid="PSA 116:19" />
  <para style="q" vid="PSA 116:19">Mmuzyumi Mtuwa Mlungu!<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">Kumzyuma Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1" />Mwenga maisi goseri, mmuzyumi Mtuwa Mlungu!</para>
  <para style="q" vid="PSA 117:1">Mwenga wantu woseri mmuzyumi!<verse eid="PSA 117:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2" />Toziya ufiru wakuyi kwa twenga ndo nkulu,</para>
  <para style="q" vid="PSA 117:2">uwaminika wakuyi Mtuwa Mlungu ulikala mashaka goseri!</para>
  <para style="b" vid="PSA 117:2" />
  <para style="q" vid="PSA 117:2">Mmuzyumi Mtuwa Mlungu!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">Mayagashi toziya ya ukanka</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1" />Mlongi mayagashii kwa Mtuwa Mlungu, toziya ndo mheri,</para>
  <para style="q" vid="PSA 118:1">toziya ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 118:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2" />Wantu wa Israeli na walongi,</para>
  <para style="q" vid="PSA 118:2">ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 118:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3" />Wiwuka wa Aruni na walongi,</para>
  <para style="q" vid="PSA 118:3">ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 118:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4" />Woseri yawamguwira Mtuwa Mlungu na walongu,</para>
  <para style="q" vid="PSA 118:4">ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5" />Paweriti muntabiku nimluwiti Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 118:5">nayomberi kampikana na kuntula lekeru.<verse eid="PSA 118:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6" />Mtuwa Mlungu kapamuhera naneni, hapeni ntiri shintu,</para>
  <para style="q" vid="PSA 118:6">muntu hakantendi shishi?<verse eid="PSA 118:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7" />Mtuwa Mlungu kapamuhera naneni, kuntanga;</para>
  <para style="q" vid="PSA 118:7">naneni haniwawoni wankondu wangu pawasinda.<verse eid="PSA 118:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8" />Mbaka kutugira uponera kwa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 118:8">kuliku kumtumbira muntu.<verse eid="PSA 118:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9" />Mbaka kutugira uponera kwa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 118:9">kuliku kuwatumbira wakulu.<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10" />Maisi goseri gazyengetiti,</para>
  <para style="q" vid="PSA 118:10">kumbiti kwa litawu lya Mtuwa Mlungu hanigaamizi!<verse eid="PSA 118:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11" />Gazyengekiti kila uwega,</para>
  <para style="q" vid="PSA 118:11">kumbiti kwa litawu lya Mtuwa Mlungu, hanigagamizi!<verse eid="PSA 118:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12" />Gazyengekiti handa wanjuki,</para>
  <para style="q" vid="PSA 118:12">kumbiti galunguliti handa ntundu mumotu,</para>
  <para style="q" vid="PSA 118:12">kwa litawu lya Mtuwa Mlungu hanigaagamizi!<verse eid="PSA 118:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13" />Nkomangitwi nentu sambira nsindi,</para>
  <para style="q" vid="PSA 118:13">kumbiti Mtuwa Mlungu kantangi.<verse eid="PSA 118:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14" />Mtuwa Mlungu ndo likakala lyangu na lwimbu lyaneni,</para>
  <para style="q" vid="PSA 118:14">yomberi ndo ulopola waneni.<verse eid="PSA 118:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15" />Maziwu ga nemeru ya ukanka gapikinirika mnumba mwa waminika,</para>
  <para style="q" vid="PSA 118:15">pawimbiti, liwoku lya Mtuwa Mlungu litenda mirandu mikulu!<verse eid="PSA 118:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16" />Liwoku lya likakala lya Mtuwa Mlungu lijega ukanka!</para>
  <para style="q" vid="PSA 118:16">Liwoku lya Mtuwa Mlungu litenda mirandu mikulu!<verse eid="PSA 118:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17" />Hapenihowi ila hanilikali,</para>
  <para style="q" vid="PSA 118:17">su nigatambi matendu makulu ga Mtuwa Mlungu.<verse eid="PSA 118:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18" />Mtuwa Mlungu kankomanga nentu,</para>
  <para style="q" vid="PSA 118:18">kumbiti kandekandiri howi.<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19" />Mumvuguliliri migomi ya haki,</para>
  <para style="q" vid="PSA 118:19">ningiri na kulonga mayagashii Mtuwa Mlungu!<verse eid="PSA 118:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20" />Ali ndo ligomi lya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 118:20">wantu waminika hawapitiri amu.<verse eid="PSA 118:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21" />Gwee Mtuwa Mlungu hanongi mayagashii toziya gunankula,</para>
  <para style="q" vid="PSA 118:21">gwenga ndo ulopola waneni.<verse eid="PSA 118:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22" />Libuhi lyawalilemiti wanyawa wa numba,</para>
  <para style="q" vid="PSA 118:22">vinu liwera libuhi likulu lya kushisoku.<verse eid="PSA 118:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23" />Aga ndo mahengu gakuyi Mtuwa Mlungu</para>
  <para style="q" vid="PSA 118:23">na geni ndo ga kulikangasha nentu kwatwenga.<verse eid="PSA 118:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24" />Ali ndo lishaka lyakalitenditi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 118:24">tunemeleri na kufyapilira.<verse eid="PSA 118:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25" />Gwee Mtuwa Mlungu shondi gutulopoli!</para>
  <para style="q" vid="PSA 118:25">Gwee Mtuwa Mlungu shondi gutupanani mpatiru!<verse eid="PSA 118:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26" />Katekelerwi ayu yakiza kwa litawu lya Mtuwa Mlungu!</para>
  <para style="q" vid="PSA 118:26">Hatuwatekeleri kulawa ukaya kwa Mtuwa Mlungu<verse eid="PSA 118:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27" />Mtuwa Mlungu ndo Mlungu,</para>
  <para style="q" vid="PSA 118:27">yomberi katupanana kulangala kwakuyi</para>
  <para style="q" vid="PSA 118:27">Mkoli ntambi mumawoku mwenu mwingiri mumsambu,</para>
  <para style="q" vid="PSA 118:27">pamlilongoziya mpaka mumagoli ga shitalawanda.<verse eid="PSA 118:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28" />Gwenga ndo Mlungu gwangu naneni hanongi mayagashi,</para>
  <para style="q" vid="PSA 118:28">gwee Mlungu gwangu hanikukwisi.<verse eid="PSA 118:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29" />Mlongi mayagashi kwa Mtuwa Mlungu kwakuwera ndo mheri,</para>
  <para style="q" vid="PSA 118:29">kwa mana ufiru wakuyi ndo wa mashaka goseri.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s">Lagiru lya Mtuwa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1" />Watekelerwa wantu yawalikala pota likosa,</para>
  <para style="q" vid="PSA 119:1">yawafata lagiru lya Mtuwa Mlungu.<verse eid="PSA 119:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2" />Watekelerwa yawafata malagaliru gakuyi,</para>
  <para style="q" vid="PSA 119:2">yawamsakula kwa moyu gwawu goseri,<verse eid="PSA 119:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3" />wantu yawatendandiri ukontola nakamu,</para>
  <para style="q" vid="PSA 119:3">ila mashaka goseri wankufata njira zaku.<verse eid="PSA 119:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4" />Gwee Mlungu, gutupanana lagiru zyaku</para>
  <para style="q" vid="PSA 119:4">su tuzikoli kwa waminika.<verse eid="PSA 119:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5" />Kumbiti mgenderanu gwangu megugangamali,</para>
  <para style="q" vid="PSA 119:5">kwa kugafata malagalira gaku!<verse eid="PSA 119:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6" />Panizikola lagiru zaku zoseri,</para>
  <para style="q" vid="PSA 119:6">nakaka hapeni nsoniziwi.<verse eid="PSA 119:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7" />Hanikuzyumi kwa moyu guherepa,</para>
  <para style="q" vid="PSA 119:7">panilifunda malagaliru gaku ga haki.<verse eid="PSA 119:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8" />Hanigafati malagalira gaku,</para>
  <para style="q" vid="PSA 119:8">nagundeka nakamu.<verse eid="PSA 119:8" /></para>
  <para style="s">Kujimira lagiru lya Mtuwa Mlungu</para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9" />Ntambu gaa mntemba kayitendi njira yakuyi iweri iherepa?</para>
  <para style="q" vid="PSA 119:9">Ndo kwakulikala teratera na shisoweru shaku.<verse eid="PSA 119:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10" />Hanikusakuli kwa moyu gwangu goseri,</para>
  <para style="q" vid="PSA 119:10">nagundeka nigaleki malagalira gaku.<verse eid="PSA 119:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11" />Mumoyu mwangu nishitula shisoweru shangu,</para>
  <para style="q" vid="PSA 119:11">naniza kukutendera vidoda.<verse eid="PSA 119:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12" />Gutekelerwi, gwee Mtuwa Mlungu!</para>
  <para style="q" vid="PSA 119:12">Gunfundi malagalira gaku.<verse eid="PSA 119:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13" />Hambuyili kayi kwa liziwu</para>
  <para style="q" vid="PSA 119:13">malagira gaku goseri gagulaviyiti.<verse eid="PSA 119:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14" />Hanemeleri kufata malagaliru gaku,</para>
  <para style="q" vid="PSA 119:14">handa muntu yakanemelera lunda ivuwa.<verse eid="PSA 119:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15" />Nigahola malagalira gaku,</para>
  <para style="q" vid="PSA 119:15">na kulola njira zaku.<verse eid="PSA 119:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16" />Niganemelera malagalira gaku,</para>
  <para style="q" vid="PSA 119:16">hapeni nilyaluwi shisoweru shaku,<verse eid="PSA 119:16" /></para>
  <para style="s">Kunemelera lagiru lya Mtuwa Mlungu</para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17" />Guntenderi neni ntumintumi gwaku kwa uheri,</para>
  <para style="q" vid="PSA 119:17">mpati kulikala na kujimira shisoweru shaku.<verse eid="PSA 119:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18" />Guvuguli masu gangu,</para>
  <para style="q" vid="PSA 119:18">su nigawoni makangashu ga lagiru yaku.<verse eid="PSA 119:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19" />Neni namhenga hera pasipanu;</para>
  <para style="q" vid="PSA 119:19">nagunfifa lagiru zaku.<verse eid="PSA 119:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20" />Rohu yaneni ilwala kwa nfiru nkulu</para>
  <para style="q" vid="PSA 119:20">ya kuvimana lagiru zaku mashaka goseri.<verse eid="PSA 119:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21" />Gwenga guwakalipira wana mtiti,</para>
  <para style="q" vid="PSA 119:21">yawapangilitwi weni yawazimirandiri lagalira zaku.<verse eid="PSA 119:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22" />Gunshapili na mayigiranga na mabeziwu,</para>
  <para style="q" vid="PSA 119:22">toziya nigafata malagalira gaku.<verse eid="PSA 119:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23" />Tembera wakulu wapanga kuntendera madoda,</para>
  <para style="q" vid="PSA 119:23">neni ntumintumi gwaku hanigaholi malagalira gaku.<verse eid="PSA 119:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24" />Malagalira gaku ndo nemeru yaneni,</para>
  <para style="q" vid="PSA 119:24">geni ndo matakuziya gangu.<verse eid="PSA 119:24" /></para>
  <para style="s">Kukola lagiru lya Mtuwa Mlungu</para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25" />Ng'alangata pasi mumadiku,</para>
  <para style="q" vid="PSA 119:25">gunupi kayi ukomu ntambu yagutakuliti.<verse eid="PSA 119:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26" />Nikugambira njira zangu, nagwenga gunankula,</para>
  <para style="q" vid="PSA 119:26">gunfundi malagalira gaku.<verse eid="PSA 119:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27" />Gunfundi ntambu ya kukola njira zakuyi,</para>
  <para style="q" vid="PSA 119:27">naneni hanigaholi matendu gaku ga makangashu.<verse eid="PSA 119:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28" />Ntoka kulira kwa hinginika,</para>
  <para style="q" vid="PSA 119:28">gumpuziliri likakala ntambu yagulongiti.<verse eid="PSA 119:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29" />Gunshapili na njira zya upotiziya,</para>
  <para style="q" vid="PSA 119:29">gunfundi kwa uheri lagiru yaku.<verse eid="PSA 119:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30" />Nsyagula njira ya waminika,</para>
  <para style="q" vid="PSA 119:30">moyu gwangu gufata malagalira gaku.<verse eid="PSA 119:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31" />Gwee Mtuwa Mlungu, nfata malagalira gaku,</para>
  <para style="q" vid="PSA 119:31">nagujimira nsoniziwi!<verse eid="PSA 119:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32" />Hanjimiri malagalira gaku,</para>
  <para style="q" vid="PSA 119:32">toziya gumpanana umani nentu.<verse eid="PSA 119:32" /></para>
  <para style="s">Kuluwa umani</para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33" />Gwee Mtuwa Mlungu, gunfundi kujimira malagalira gaku,</para>
  <para style="q" vid="PSA 119:33">naneni hanigakoli mpaka upeleru.<verse eid="PSA 119:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34" />Gumaniziyi naneni hanfati lagiru yaku,</para>
  <para style="q" vid="PSA 119:34">hanfati kwa moyu gwangu goseri.<verse eid="PSA 119:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35" />Gunongoziyi munjira ya lagiru zaku,</para>
  <para style="q" vid="PSA 119:35">mana amu mpata nemeleru.<verse eid="PSA 119:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36" />Gumpanani nfiru ya kufata malagira gaku,</para>
  <para style="q" vid="PSA 119:36">kuliku kupata ulunda.<verse eid="PSA 119:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37" />Gugalambuli masu gangu nagalola mirandu yayahera mana,</para>
  <para style="q" vid="PSA 119:37">gunanguzuyi njira yaku, gunupi ukomu.<verse eid="PSA 119:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38" />Guntenderi shagulongiti kwa neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 119:38">shilii shashiwatenda wantu wakupanani ligoya.<verse eid="PSA 119:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39" />Gundopoli na soni yantira,</para>
  <para style="q" vid="PSA 119:39">mana malagalira gaku ndo maheri.<verse eid="PSA 119:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40" />Guloli ntambu ya nfira nentu lagiru zaku,</para>
  <para style="q" vid="PSA 119:40">gumpanani ukomu wa syayi toziya gwenga ndo mwaminika.<verse eid="PSA 119:40" /></para>
  <para style="s">Kutumbira lagiru lya Mtuwa Mlungu</para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41" />Gwee Mtuwa Mlungu, ufiru waku yawahera upeleru unizili,</para>
  <para style="q" vid="PSA 119:41">gundopoli kulawirana na shisoweru shaku.<verse eid="PSA 119:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42" />Panu hawezi kuwawankula awa yawanigira,</para>
  <para style="q" vid="PSA 119:42">toziya neni namini nentu shisoweru shaku.<verse eid="PSA 119:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43" />Gumpanana kutakula nakaka mashaka goseri,</para>
  <para style="q" vid="PSA 119:43">toziya litumbiru lyangu lya mulagiru yaku.<verse eid="PSA 119:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44" />Hanjimili lagiru yaku kila shaka,</para>
  <para style="q" vid="PSA 119:44">haniyikoli mashaka goseri.<verse eid="PSA 119:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45" />Hantyangi pawera lekeru,</para>
  <para style="q" vid="PSA 119:45">toziya njimira lagiru zyaku.<verse eid="PSA 119:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46" />Haniwabweleri wafalumi lagiru zaku,</para>
  <para style="q" vid="PSA 119:46">na hapeni nsoniziwi,<verse eid="PSA 119:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47" />Nemeru ya neni ndo kuzijimira lagalira zaku,</para>
  <para style="q" vid="PSA 119:47">zyeni neni nizifira.<verse eid="PSA 119:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48" />Nizipanana ligoya na kuzifira lagiru zaku,</para>
  <para style="q" vid="PSA 119:48">hanigaholeri malagalira gaku.<verse eid="PSA 119:48" /></para>
  <para style="s">Kwamini lagiru lya Mtuwa Mlungu</para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49" />Guholi shagulongiti kwa neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 119:49">shagulongiti sheni shimpanana litumbiru.<verse eid="PSA 119:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50" />Pawera mkutabika ashi shinyamaziya,</para>
  <para style="q" vid="PSA 119:50">toziya shagutakuliti shimpanana ukomu.<verse eid="PSA 119:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51" />Yawanamtiti wambeza nentu,</para>
  <para style="q" vid="PSA 119:51">kumbiti neni ndekandiri lagiru yaku.<verse eid="PSA 119:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52" />Panigahola malagalira gaku ga makashu,</para>
  <para style="q" vid="PSA 119:52">gwe Mtuwa Mlungu ganzyanganzyanga.<verse eid="PSA 119:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53" />Nana maya gakalipa kwajili ya wakontola,</para>
  <para style="q" vid="PSA 119:53">weni yawaleka lagiru yaku.<verse eid="PSA 119:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54" />Malagalira gaku gawera lwimbu lwaneni,</para>
  <para style="q" vid="PSA 119:54">poseri pang'enda.<verse eid="PSA 119:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55" />Gwee Mtuwa Mlungu, pashiru nilihola litawu lyaku</para>
  <para style="q" vid="PSA 119:55">na kukola lagiru yaku.<verse eid="PSA 119:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56" />Ayi ndo tekelera nkulu kwa neni,</para>
  <para style="q" vid="PSA 119:56">toziya nigajimira malagalira gaku.<verse eid="PSA 119:56" /></para>
  <para style="s">Kujimira lagiru lya Mtuwa Mlungu</para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57" />Gwee Mtuwa Mlungu, ndo uhala wangu,</para>
  <para style="q" vid="PSA 119:57">nonga hanjimiri malagaliru gaku.<verse eid="PSA 119:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58" />Nfira kukufiriziya kwa moyu gwangu goseri,</para>
  <para style="q" vid="PSA 119:58">gumoneri lusungu ntambu yagulongiti.<verse eid="PSA 119:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59" />Niliholera njira zangu,</para>
  <para style="q" vid="PSA 119:59">na mbuya nfati malagalira gaku.<verse eid="PSA 119:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60" />Ntenda kalongola pota kukawalira</para>
  <para style="q" vid="PSA 119:60">kufata lagiru zaku.<verse eid="PSA 119:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61" />Ata wakontola pawanyambira migomiziwu,</para>
  <para style="q" vid="PSA 119:61">kumbiti neni hapeninilyaluwi lagira zaku.<verse eid="PSA 119:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62" />Pashiru totolu nimka kulonga mayagashii,</para>
  <para style="q" vid="PSA 119:62">toziya ya malagalira gaku ga haki.<verse eid="PSA 119:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63" />Neni ndo ganja gwa woseri yawakujimira,</para>
  <para style="q" vid="PSA 119:63">ganja gwawu yawafata magambiziwu gaku.<verse eid="PSA 119:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64" />Gwee Mtuwa Mlungu pasipanu pamema ufiru waku,</para>
  <para style="q" vid="PSA 119:64">gunfundi malagaliru gaku.<verse eid="PSA 119:64" /></para>
  <para style="s">Samani ya lagiru lya Mtuwa Mlungu</para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65" />Guntenderi maheri neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 119:65">ntambu yagulongiti, gwee Mtuwa Mlungu.<verse eid="PSA 119:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66" />Gunfundi kuwera na umani, nakwamuwa weri</para>
  <para style="q" vid="PSA 119:66">toziya namini lagaliru zaku.<verse eid="PSA 119:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67" />Pamberi pa kunkomanga weriti pankoseya,</para>
  <para style="q" vid="PSA 119:67">kumbiti vinu nkola shisoweru shaku.<verse eid="PSA 119:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68" />Gwenga ndo mheri na gutenda maheri,</para>
  <para style="q" vid="PSA 119:68">gunfundi malagalira gaku.<verse eid="PSA 119:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69" />Wana mtiti walonga mpayu toziya yangu,</para>
  <para style="q" vid="PSA 119:69">kumbiti neni hankoli lagalira zaku kwa moyu goseri.<verse eid="PSA 119:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70" />Miyoyu yawu minkesera na ikamala,</para>
  <para style="q" vid="PSA 119:70">kumbiti neni nemelera lagiru yaku.<verse eid="PSA 119:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71" />Iheripiti kwa neni kupata ntabiku,</para>
  <para style="q" vid="PSA 119:71">su nilifundi lagiru yaku.<verse eid="PSA 119:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72" />Lagiru yayilawa kwagwenga ndo ya samani nentu kwaneni,</para>
  <para style="q" vid="PSA 119:72">kuliku lunda zoseri za pasipanu.<verse eid="PSA 119:72" /></para>
  <para style="s">Lagiru lya Mtuwa Mlungu ijega haki</para>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73" />Gwenga ndo yagumumbiti kwa mawoku gaku na guntenda ntambuyawera</para>
  <para style="q" vid="PSA 119:73">gumpanani mahala su nilifundi lagaru zaku.<verse eid="PSA 119:73" /></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74" />Yawakuguwira hawamoni na kunemelera,</para>
  <para style="q" vid="PSA 119:74">toziya litumbiru lyaneni lya mushisoweru shaku.<verse eid="PSA 119:74" /></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75" />Nivimana toza zaku ndo za kwaminika gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 119:75">na kwa uwaminika waku, gunkomanga.<verse eid="PSA 119:75" /></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76" />Ufiru waku uzyangizyangi,</para>
  <para style="q" vid="PSA 119:76">ntambu yagung'ambiliti neni ntumintumi gwaku.<verse eid="PSA 119:76" /></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77" />Gumoneri lusungu su nilikali,</para>
  <para style="q" vid="PSA 119:77">toziya lagiru yaku ndo nemelera yaneni.<verse eid="PSA 119:77" /></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78" />Yawanamtiti wasoniziwi toziya wampayira,</para>
  <para style="q" vid="PSA 119:78">kumbiti neni hanigaholi malagaliru gaku.<verse eid="PSA 119:78" /></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79" />Woseri yawakuguwira wizi kwaneni,</para>
  <para style="q" vid="PSA 119:79">wapati kuvimana lagalira zaku.<verse eid="PSA 119:79" /></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80" />Moyu gwangu naguwera na likosa mu lagaliru yaku,</para>
  <para style="q" vid="PSA 119:80">su nasoniziwa.<verse eid="PSA 119:80" /></para>
  <para style="s">Maluwa ga kulopolwa</para>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81" />Ntoka kuhepelera ulopola waku,</para>
  <para style="q" vid="PSA 119:81">ntula litumbiru lyangu mushisoweru shaku.<verse eid="PSA 119:81" /></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82" />Masu gangu gatoka kuhepelera shagutakuliti.</para>
  <para style="q" vid="PSA 119:82">Ngosiya, “Hagwizi ndiri kunzyangazyanga?”<verse eid="PSA 119:82" /></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83" />Nkukutala handa likuli lyaliyumiziwa mulyosi,</para>
  <para style="q" vid="PSA 119:83">ata hangu haneni lilyaluwi lagalira zaku.<verse eid="PSA 119:83" /></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84" />Neni ntumintumi gwaku hahepeleri mpakandii?</para>
  <para style="q" vid="PSA 119:84">Haguwakomangi ndii walii yawantabisiya?<verse eid="PSA 119:84" /></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85" />Wana mtiti wambawira malindi,</para>
  <para style="q" vid="PSA 119:85">lyeni lagiru lyakundiri.<verse eid="PSA 119:85" /></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86" />Lagiru zaku zoseri ndo za kwaminika,</para>
  <para style="q" vid="PSA 119:86">guntangi toziya wantu wantabisiya pota likosa!<verse eid="PSA 119:86" /></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87" />Wapakwegera kunagamiziya,</para>
  <para style="q" vid="PSA 119:87">kumbiti neni ndekandiri lagiru zaku.<verse eid="PSA 119:87" /></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88" />Gumponiziyi teratera na ufiru waku,</para>
  <para style="q" vid="PSA 119:88">su nfati malagaliru gagulongiti.<verse eid="PSA 119:88" /></para>
  <para style="s">Kwamini lagiru lya Mtuwa Mlungu</para>
  <para style="p">
    <verse number="89" style="v" sid="PSA 119:89" />Gwee Mtuwa Mlungu shisoweru shaku,</para>
  <para style="q" vid="PSA 119:89">shilikala mashaka goseri,</para>
  <para style="q" vid="PSA 119:89">shigangamla kumpindi.<verse eid="PSA 119:89" /></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90" />Waminika waku ulikala viyiwuku vyoseri,</para>
  <para style="q" vid="PSA 119:90">gupawumba pasipanu napeni palikala.<verse eid="PSA 119:90" /></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91" />Lagiru zyaku zilikala mpaka leru,</para>
  <para style="q" vid="PSA 119:91">toziya vintu vyoseri vikutendera.<verse eid="PSA 119:91" /></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92" />Handa menemelerindiri lagiru yaku,</para>
  <para style="q" vid="PSA 119:92">Menagamiri muntabiku zyangu.<verse eid="PSA 119:92" /></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93" />Hapeni nigalyaluwi nakamu malagiru gaku,</para>
  <para style="q" vid="PSA 119:93">mana kwa aga gumpanana ukomu.<verse eid="PSA 119:93" /></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94" />Neni na gwaku, gundopoli,</para>
  <para style="q" vid="PSA 119:94">toziya nkamala kuzijimira lagira zaku.<verse eid="PSA 119:94" /></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95" />Wakontola wangwadira wapati kundaga.</para>
  <para style="q" vid="PSA 119:95">Kumbiti neni nigaholera malagira gaku.<verse eid="PSA 119:95" /></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96" />Nivimana kuwera kila shintu shashikamilikiti shana upeleru,</para>
  <para style="q" vid="PSA 119:96">kumbiti lagaru zaku zahera mpaka.<verse eid="PSA 119:96" /></para>
  <para style="s">Ufiru wa lagiru lya Mlungu</para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97" />Niifira nentu lagiru yaku!</para>
  <para style="q" vid="PSA 119:97">Niyihola paliwala poseri!<verse eid="PSA 119:97" /></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98" />Lagiru yaku impanana luhala nentu kuliku wankondu waneni,</para>
  <para style="q" vid="PSA 119:98">toziya ya pamuhera naneni kila shaka.<verse eid="PSA 119:98" /></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99" />Nana mahala kuliku wafunda waneni woseri,</para>
  <para style="q" vid="PSA 119:99">toziya nigahola malagalira gaku.<verse eid="PSA 119:99" /></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100" />Nana umani kuliku wazewi,</para>
  <para style="q" vid="PSA 119:100">toziya nizikola lagaliru zaku.<verse eid="PSA 119:100" /></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101" />Nililewelera nanfata njira idoda,</para>
  <para style="q" vid="PSA 119:101">su wezi kujimira shisoweru shaku.<verse eid="PSA 119:101" /></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102" />Nizilekandiri lagiru zaku,</para>
  <para style="q" vid="PSA 119:102">toziya gamweni gwenga gunfunditi.<verse eid="PSA 119:102" /></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103" />Visoweru vyaku vinoga nentu kwaneni,</para>
  <para style="q" vid="PSA 119:103">vinoga kuliku lwashi!<verse eid="PSA 119:103" /></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104" />Kwa lagira zaku mpata luhala,</para>
  <para style="q" vid="PSA 119:104">hangu nkalalira kila njira idoda.<verse eid="PSA 119:104" /></para>
  <para style="s">Lagiru lya Mtuwa Mlungu ndo langala</para>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105" />Shisoweru shaku ndo shikoloboyi sha kulonguziya magulu gangu,</para>
  <para style="q" vid="PSA 119:105">na kulangala munjira ya neni.<verse eid="PSA 119:105" /></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106" />Nilirapa na kutenda shilii shantakuliti,</para>
  <para style="q" vid="PSA 119:106">kuzitenda lagiru zyaku zya haki.<verse eid="PSA 119:106" /></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107" />Gwee Mtuwa Mlungu, ntabika nentu,</para>
  <para style="q" vid="PSA 119:107">gugangamaziyi makaliru gangu kulinganira na shisoweru shaku.<verse eid="PSA 119:107" /></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108" />Gwee Mtuwa Mlungu, gwanki zyuma za kulilaviya namweni,</para>
  <para style="q" vid="PSA 119:108">na gunfundi malagalira gaku.<verse eid="PSA 119:108" /></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109" />Makaliru gangu gamkutenduwa mashaka goseri,</para>
  <para style="q" vid="PSA 119:109">kumbiti hapeni nilyaluwi lagiru yaku.<verse eid="PSA 119:109" /></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110" />Wakontola wanyambira mgomiziwu,</para>
  <para style="q" vid="PSA 119:110">kumbiti ngalambukandiri malagaliru gaku.<verse eid="PSA 119:110" /></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111" />Lagiru zaku ndo uhala waneni mashaka goseri,</para>
  <para style="q" vid="PSA 119:111">geni ndo nemeleru ya moyu gwangu.<verse eid="PSA 119:111" /></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112" />Nfira kwa moyu gwangu goseri</para>
  <para style="q" vid="PSA 119:112">kugafata malagalira gaku mashaka goseri.<verse eid="PSA 119:112" /></para>
  <para style="s">Uponera mu lagiru lya Mtuwa Mlungu</para>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113" />Niwakalalira wantu wafyanku,</para>
  <para style="q" vid="PSA 119:113">kumbiti niyifira lagiru lyaku.<verse eid="PSA 119:113" /></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114" />Gwenga ndo lusegeyu lwangu, kwa gwenga mpata uponera,</para>
  <para style="q" vid="PSA 119:114">ntula litumbiru mu shisoweru shaku.<verse eid="PSA 119:114" /></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115" />Muwuki kwaneni mwenga yamtenda madoda,</para>
  <para style="q" vid="PSA 119:115">su wezi kukola lagalira za Mlungu gwangu.<verse eid="PSA 119:115" /></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116" />Gungangamaziyi ntambu yagulongiti naneni hanilikali,</para>
  <para style="q" vid="PSA 119:116">naguleka litumbiru lyangu lyagamiri.<verse eid="PSA 119:116" /></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117" />Guntangi naneni haweli poneka,</para>
  <para style="q" vid="PSA 119:117">mashaka goseri su nilikali panjimira lagiru zaku.<verse eid="PSA 119:117" /></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118" />Guwalema woseri yawagalambuka malagalira gaku;</para>
  <para style="q" vid="PSA 119:118">toziya uzyanga wawu ndo hera.<verse eid="PSA 119:118" /></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119" />Wakontola woseri guwawona handa uhakata,</para>
  <para style="q" vid="PSA 119:119">hangu nilifira lagalira lyaku.<verse eid="PSA 119:119" /></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120" />Nendemera kwa kukutira gwenga,</para>
  <para style="q" vid="PSA 119:120">nina lyoga toziya ya lagiru zaku.<verse eid="PSA 119:120" /></para>
  <para style="s">Kujimira lagiru lya Mtuwa Mlungu</para>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121" />Ntenda mirandu miheri na iherepa,</para>
  <para style="q" vid="PSA 119:121">nagundeka kwa wankondu wangu.<verse eid="PSA 119:121" /></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122" />Gung'ambiri handa haweri poneka,</para>
  <para style="q" vid="PSA 119:122">naguwaleka yawana mtiti wamoneri.<verse eid="PSA 119:122" /></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123" />Masu gatifutifu kuhepelera shagutakuliti</para>
  <para style="q" vid="PSA 119:123">pahepelera shisoweru shaku sha nakaka.<verse eid="PSA 119:123" /></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124" />Guntenderi neni ntumintumi gwaku kulinganira na ufiru waku,</para>
  <para style="q" vid="PSA 119:124">gunfundi malagalira gaku.<verse eid="PSA 119:124" /></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125" />Neni ndo ntumintumi gwaku, gunupi umani,</para>
  <para style="q" vid="PSA 119:125">su wezi kuvimana lagiru zaku.<verse eid="PSA 119:125" /></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126" />Gwee Mtuwa Mlungu, vinu ndo shaka sha kutenda shintu,</para>
  <para style="q" vid="PSA 119:126">toziya wantu wayimega lagiru laku.<verse eid="PSA 119:126" /></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127" />Toziya nizifira lagiru zaku kuliku zahabu,</para>
  <para style="q" vid="PSA 119:127">yina kuliku zahabu iherepa.<verse eid="PSA 119:127" /></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128" />Hangu, nfata lagiru zaku zoseri,</para>
  <para style="q" vid="PSA 119:128">kila njira yayipotuziya niyikalalira.<verse eid="PSA 119:128" /></para>
  <para style="s">Nfiru ya kujimira lagiru za Mlungu</para>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129" />Lagiru zaku ndo za kulikangasha,</para>
  <para style="q" vid="PSA 119:129">hangu nizijimira.<verse eid="PSA 119:129" /></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130" />Kutakulira visoweru vyaku vijega kulangala,</para>
  <para style="q" vid="PSA 119:130">kuwapanana mahala wantu yawamanandiri.<verse eid="PSA 119:130" /></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131" />Nasama mlomu kwa hamu nkulu,</para>
  <para style="q" vid="PSA 119:131">toziya nfiriti.<verse eid="PSA 119:131" /></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132" />Gungalambukili na kumonera lusungu,</para>
  <para style="q" vid="PSA 119:132">ntambu yaguwatenda yawakufira.<verse eid="PSA 119:132" /></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133" />Gulongoziyi maleka ganeni kwa shisoweru shaku,</para>
  <para style="q" vid="PSA 119:133">nagundeka nkolwimlima na ukontola.<verse eid="PSA 119:133" /></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134" />Gundopoli na wantu yawamonera,</para>
  <para style="q" vid="PSA 119:134">su wezi kuzijimira lagiru zaku.<verse eid="PSA 119:134" /></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135" />Gundoli kwa lusungu neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 119:135">na gunfundi lagiru zaku.<verse eid="PSA 119:135" /></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136" />Masu gangu galawa masozi gavuwa handa lushemba,</para>
  <para style="q" vid="PSA 119:136">toziya ya wantu yawajimirandiri lagiru yaku.<verse eid="PSA 119:136" /></para>
  <para style="s">Lagiru lya Mtuwa Mungu lijega haki</para>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137" />Gwee Mtuwa Mlungu, gwenga ndo yagwana haki,</para>
  <para style="q" vid="PSA 119:137">na toza zaku ndo zanakaka.<verse eid="PSA 119:137" /></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138" />Lagiru zaku ndo za haki,</para>
  <para style="q" vid="PSA 119:138">na uwaminika.<verse eid="PSA 119:138" /></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139" />Ugangamala wangu unagamiziya,</para>
  <para style="q" vid="PSA 119:139">mana wankondu waneni walisherandiri visoweru vyaku.<verse eid="PSA 119:139" /></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140" />Shagulongiti ndo nakaka,</para>
  <para style="q" vid="PSA 119:140">naneni ntumintumi gwaku nishifira.<verse eid="PSA 119:140" /></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141" />Tembera neni na mdidini na mbeziwa,</para>
  <para style="q" vid="PSA 119:141">kumbiti nilyaluwandiri lagiru zaku.<verse eid="PSA 119:141" /></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142" />Haki yaku ndo ya mashaka goseri,</para>
  <para style="q" vid="PSA 119:142">lagiru yaku ndo ya nakaka.<verse eid="PSA 119:142" /></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143" />Ntabiku na hinginika vimbata,</para>
  <para style="q" vid="PSA 119:143">kumbiti lagiru zaku ndo nemeleru yaneni.<verse eid="PSA 119:143" /></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144" />Lagiru zaku ndo za haki mashaka goseri,</para>
  <para style="q" vid="PSA 119:144">gumpanani umani su wezi kulikala.<verse eid="PSA 119:144" /></para>
  <para style="s">Luwa ya kukombolwa</para>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145" />Nikulilira Kwa moyu gwangu goseri,</para>
  <para style="q" vid="PSA 119:145">gwee Mtuwa Mlungu, gunankuli su nfati lagiru zaku.<verse eid="PSA 119:145" /></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146" />Nikulilira, gundopoli,</para>
  <para style="q" vid="PSA 119:146">mpati kugatenda malagalira gaku<verse eid="PSA 119:146" /></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147" />Nimuka mandawira putiputi na kukuluwa guntangi,</para>
  <para style="q" vid="PSA 119:147">ntula litumbiru lyangu mushisoweru shaku.<verse eid="PSA 119:147" /></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148" />Ngonjandiri pashiru poseri,</para>
  <para style="q" vid="PSA 119:148">Su niliholi shisoweru shaku.<verse eid="PSA 119:148" /></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149" />Gwee Mtuwa Mlungu, kwaufiru waku gumpikiniri,</para>
  <para style="q" vid="PSA 119:149">gutuliweri makaliru gangu kulinganira na lagiru zaku.<verse eid="PSA 119:149" /></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150" />Walii yawapanga makontola wapakwegera naneni,</para>
  <para style="q" vid="PSA 119:150">kumbiti wakutali na lagiru yaku.<verse eid="PSA 119:150" /></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151" />Kumbiti gwee Mtuwa Mlungu gwapakwegera,</para>
  <para style="q" vid="PSA 119:151">na lagiru zaku zoseri za nakaka.<verse eid="PSA 119:151" /></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152" />Kwanjira makashu, nilifunda malagaliru gaku,</para>
  <para style="q" vid="PSA 119:152">geni gugatula ata galikali mashaka goseri.<verse eid="PSA 119:152" /></para>
  <para style="s">Kuluwa utanga</para>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153" />Guloli ntabika yaneni, gundopoli,</para>
  <para style="q" vid="PSA 119:153">toziya nilyaluwandiri lagiru yaku.<verse eid="PSA 119:153" /></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154" />Gundeteyi na kunkombola,</para>
  <para style="q" vid="PSA 119:154">gumpanani ukomu kulinganira na shisoweru shaku.<verse eid="PSA 119:154" /></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155" />Ulopola waku wakutali na wakontola,</para>
  <para style="q" vid="PSA 119:155">toziya walisherandiri lagiru zaku.<verse eid="PSA 119:155" /></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156" />Gwee Mtuwa Mlungu, lusungu lwaku ndo lukulu,</para>
  <para style="q" vid="PSA 119:156">gumpanani ukomu ntambu yagulongiti.<verse eid="PSA 119:156" /></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157" />Wankondu na wankesera waneni ndo wavuwa,</para>
  <para style="q" vid="PSA 119:157">kumbiti neni hapandeki lagiru laku.<verse eid="PSA 119:157" /></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158" />Paniwawona yawaminindiri nkalala,</para>
  <para style="q" vid="PSA 119:158">toziya wazijimirandiri malagalira gaku.<verse eid="PSA 119:158" /></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159" />Gwee Mlungu, guloli ntambu yanfira malagaliru gaku!</para>
  <para style="q" vid="PSA 119:159">Gumpanani ukomu teratera na ufiru waku.<verse eid="PSA 119:159" /></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160" />Visoweru vyaku vyoseri ndo nakaka,</para>
  <para style="q" vid="PSA 119:160">lagiru zaku za haki na zilikali mashaka goseri.<verse eid="PSA 119:160" /></para>
  <para style="s">Kujimira lagiru za Mlungu</para>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161" />Wakolamlima wankuntabisiya pota likosa,</para>
  <para style="q" vid="PSA 119:161">kumbiti moyu gwangu guwera na ligoya kwa visoweru vyaku.<verse eid="PSA 119:161" /></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162" />Nemelera toziya ya shisoweru shaku,</para>
  <para style="q" vid="PSA 119:162">handa muntu yakapatiti shintu sha mana nentu.<verse eid="PSA 119:162" /></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163" />Nkalalira na nfirandiri mpayu nakamu,</para>
  <para style="q" vid="PSA 119:163">kumbiti nilifira lagiru lyaku.<verse eid="PSA 119:163" /></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164" />Kila lishaka neni nikuzyuma mala saba,</para>
  <para style="q" vid="PSA 119:164">toziya ya lagiru zyaku ndo za haki.<verse eid="PSA 119:164" /></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165" />Yawafira lagiru yaku wanaponga nentu,</para>
  <para style="q" vid="PSA 119:165">pota kwahera yashiweza kuwagusiya.<verse eid="PSA 119:165" /></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166" />Gwee Mtuwa Mlungu, nikuhepera gundopoli,</para>
  <para style="q" vid="PSA 119:166">neni njimira lagalira zaku.<verse eid="PSA 119:166" /></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167" />Nigajimira magambiziya gaku,</para>
  <para style="q" vid="PSA 119:167">toziya nigafira nentu.<verse eid="PSA 119:167" /></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168" />Nizijimira lagiru zaku na malagalira gaku,</para>
  <para style="q" vid="PSA 119:168">toziya gwenga guziwona njira zangu.<verse eid="PSA 119:168" /></para>
  <para style="s">Kuluwa utanga</para>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169" />Gwee Mtuwa Mlungu, kulira kwa kuluwa utanga kwaneni kukufikiri!</para>
  <para style="q" vid="PSA 119:169">Gumpanani umani kulinganira na shisoweru shaku.<verse eid="PSA 119:169" /></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170" />Luwa yaneni ikufikiri,</para>
  <para style="q" vid="PSA 119:170">gundopoli kulinganira na shisoweru shaku.<verse eid="PSA 119:170" /></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171" />Hanikuzyumi mashaka goseri,</para>
  <para style="q" vid="PSA 119:171">toziya gunfunda malagalira gaku.<verse eid="PSA 119:171" /></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172" />Hanimbi lagiru zaku,</para>
  <para style="q" vid="PSA 119:172">toziya lagiru zaku zoseri ndo za haki.<verse eid="PSA 119:172" /></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173" />Liwoku lyaku liweri kala kuntanga,</para>
  <para style="q" vid="PSA 119:173">mana namuwa kufata lagiru zaku.<verse eid="PSA 119:173" /></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174" />Gwee Mtuwa Mlungu nfira gundopoli,</para>
  <para style="q" vid="PSA 119:174">lagiru lyaku ndo nemeleru yaneni.<verse eid="PSA 119:174" /></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175" />Gundeki nilikali su nikuzyumi,</para>
  <para style="q" vid="PSA 119:175">na lagiru zaku zintangi.<verse eid="PSA 119:175" /></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176" />Nyerayera handa kondolu yakagamiliti,</para>
  <para style="q" vid="PSA 119:176">gwizi gunsakuli neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 119:176">toziya nilyaluwandiri lagiru zaku.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">Kuluwa utanga</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 120:1" />Mukutabika kwaneni nimshemiti Mtuwa Mlungu</para>
  <para style="q" vid="PSA 120:1">Nayomberi kanitikira.<verse eid="PSA 120:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2" />Gwee Mtuwa Mlungu, gundopoli</para>
  <para style="q" vid="PSA 120:2">na milomu ya wantu wazyanga na wanampayu.<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3" />Mwenga wazyanga, Mlungu hakawatenderi shishi?</para>
  <para style="q" vid="PSA 120:3">Hakawakomangi hashi?<verse eid="PSA 120:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4" />Hakawagumi kwa misali mikalipa ya mashonta,</para>
  <para style="q" vid="PSA 120:4">na makala ga motu gukalipa!<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5" />Shondi neni yanilikala aku Mesheki,</para>
  <para style="q" vid="PSA 120:5">nkala muwamu muliringu lya Kedari.<verse eid="PSA 120:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6" />Nilikala shipindi shitali nentu</para>
  <para style="q" vid="PSA 120:6">pakati pa wantu yawayifirandir ponga!<verse eid="PSA 120:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7" />Shaka panonga nfira ponga,</para>
  <para style="q" vid="PSA 120:7">womberi wafira nkondu.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">Mtuwa Mlungu mlolera gwetu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 121:1" />Ndola pampindi pamigongu,</para>
  <para style="q" vid="PSA 121:1">utanga wangu hawulawi koshi?<verse eid="PSA 121:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2" />Utanga wangu hawulawi kwa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 121:2">yakawumbiti mpindi na pasipanu.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3" />Hapeni kakuleki guguwi,</para>
  <para style="q" vid="PSA 121:3">mlolera gwaku yakasizirandiri.<verse eid="PSA 121:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4" />Nakaka mlolera gwa Israeli,</para>
  <para style="q" vid="PSA 121:4">kasizirandiri pota kugonja.<verse eid="PSA 121:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5" />Mtuwa Mlungu ndo mlolera gwaku,</para>
  <para style="q" vid="PSA 121:5">kauwega waku wa kumliwu kukulolera.<verse eid="PSA 121:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6" />Paluwala mshenji hapeni gukutendi,</para>
  <para style="q" vid="PSA 121:6">pota lyezi shaka sha pashiru.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7" />Mtuwa Mlungu hakakushingi na kila lidoda,</para>
  <para style="q" vid="PSA 121:7">hakagaloleri makaliru gaku.<verse eid="PSA 121:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8" />Mtuwa Mlungu hakakuloleri pagugendaku na kuwuya,</para>
  <para style="q" vid="PSA 121:8">kwanjira vinu na ata mashaka goseri.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">Zyuma kwajili ya Yerusalemu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 122:1" />Nemeliriti pawang'ambiriti,</para>
  <para style="q" vid="PSA 122:1">“Tugendi ukaya kwa Mtuwa Mlungu.”<verse eid="PSA 122:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2" />Vinu tugoloka,</para>
  <para style="q" vid="PSA 122:2">kumigomi yaku,</para>
  <para style="q" vid="PSA 122:2">gwee Yerusalemu,<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3" />Yerusalemu ndo mji yagunyawitwi gangamala,</para>
  <para style="q" vid="PSA 122:3">su gugoloki pamuhera.<verse eid="PSA 122:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4" />Aku wantu wa makabila wagenda, makabila ga Israeli,</para>
  <para style="q" vid="PSA 122:4">su kulonga mayagashii kwa Mtuwa Mlungu kulinganira na lagiru ntambu lalitakula.<verse eid="PSA 122:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5" />Aku ndo kwana viti vya kutoza,</para>
  <para style="q" vid="PSA 122:5">viti vya ukolamlima vya numba ya mfalumi Daudi.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6" />Mluwi ponga kwajili ya Yerusalemu.</para>
  <para style="q" vid="PSA 122:6">Woseri yawakufira Yerusalemu waweri na mpatiru.<verse eid="PSA 122:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7" />Mngati mwa vibambaza vyaku kuweri na ponga,</para>
  <para style="q" vid="PSA 122:7">mumaboma gaku kuweri na uponera.<verse eid="PSA 122:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8" />Kwajili ya walongu na waganja waneni,</para>
  <para style="q" vid="PSA 122:8">ntakula ponga iweri na gwenga,<verse eid="PSA 122:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9" />kwajili ya numba ya Mtuwa Mlungu, Mlungu gwetu,</para>
  <para style="q" vid="PSA 122:9">nikufilira mpatiru.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">Luwa ya lusungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 123:1" />Nyasula masu gangu kwa gwenga,</para>
  <para style="q" vid="PSA 123:1">gwenga yagulikala kumpindi.<verse eid="PSA 123:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2" />Handa wantumintumi ntambu yawamtumbira Mtuwa gwawu,</para>
  <para style="q" vid="PSA 123:2">handa yaya ntambu yakamtumbira mdala yakamkolamlima,</para>
  <para style="q" vid="PSA 123:2">twenga ndo ntambu yatukulolelera gwenga Mtuwa Mlungu, Mlungu gwangu</para>
  <para style="q" vid="PSA 123:2">mpaka pagutuwoneraku lusungu.<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3" />Gwee Mtuwa Mlungu gutuwoneri lusungu, gutuwoneri lusungu nentu,</para>
  <para style="q" vid="PSA 123:3">toziya tubeziwa nentu.<verse eid="PSA 123:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4" />Twigwirangwa nentu na yawana mtiti,</para>
  <para style="q" vid="PSA 123:4">tubeziwa nentu na yawalidumba.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s">Mlungu ndo mlolera gwetu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 124:1" />Handa Mtuwa Mlungu mekawerindiri uwega wa twenga,</para>
  <para style="q" vid="PSA 124:1">Israeli mtakuli vinu,<verse eid="PSA 124:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2" />Handa Mtuwa Mlungu mekawerindiri uwega wa twenga,</para>
  <para style="q" vid="PSA 124:2">shaka patukomangitwi na wankondu,<verse eid="PSA 124:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3" />metumilwi patuwera wakomu,</para>
  <para style="q" vid="PSA 124:3">shaka pagaweriti na maya na twenga,<verse eid="PSA 124:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4" />mashi megatugibikili,</para>
  <para style="q" vid="PSA 124:4">malawa megatutoli,<verse eid="PSA 124:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5" />mashi yagatuga megatujoli.<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6" />Kakwiswi Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 124:6">mweni kawalekatindiri wankondu wetu watukomangi.<verse eid="PSA 124:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7" />Tuponeka handa wampongu mumgomiziwu,</para>
  <para style="q" vid="PSA 124:7">mgomiziwu gumegwa na twenga tulopolwa.<verse eid="PSA 124:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8" />Utanga wetu ulawa kwa Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 124:8">yakawumbiti mpindi na pasipanu.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">Ulolera wa wantu wa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 125:1" />Yawamtumbira Mtuwa Mlungu, wawera handa lugongu Sayuni,</para>
  <para style="q" vid="PSA 125:1">gweni gutikinyikandiri ila gulikala mashaka goseri.<verse eid="PSA 125:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2" />Handa migongu ntambu yayizyengeta Yerusalemu,</para>
  <para style="q" vid="PSA 125:2">ndo Mtuwa Mlungu ntambu yakawazyengeta wantu wakuyi,</para>
  <para style="q" vid="PSA 125:2">kwanjira vinu na ata mashaka goseri.<verse eid="PSA 125:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3" />Wakontola hapeni wakolamlima isi ya waminika,</para>
  <para style="q" vid="PSA 125:3">ili waminika nawiza kutenda makontola.<verse eid="PSA 125:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4" />Gwee Mtuwa Mlungu, guweri mheri kwa wantu waheri,</para>
  <para style="q" vid="PSA 125:4">kwa walii yawazijimira lagalira zaku.<verse eid="PSA 125:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5" />Kumbiti yawagalambuka na kufata njira zawu zidoda,</para>
  <para style="b" vid="PSA 125:5" />
  <para style="q" vid="PSA 125:5">guwawingi pamuhera na yawatenda makontola.</para>
  <para style="q" vid="PSA 125:5">Ponga iweri kwa Israeli!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">Kuluwa likakala lyasyayi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 126:1" />Mtuwa Mlungu pakatuwuziyiti Sayuni kulawa muumanda,</para>
  <para style="q" vid="PSA 126:1">tuweriti handa twankulota!<verse eid="PSA 126:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2" />Panu tusekeleriti na kufyapilira kwa nemeru.</para>
  <para style="q" vid="PSA 126:2">Na wantu wa maisi gamonga walongiti.</para>
  <para style="q" vid="PSA 126:2">Mtuwa Mlungu kawatendera mirandu mikulu,<verse eid="PSA 126:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3" />Nakaka Mtuwa Mlungu katutenderiti mirandu mikulu,</para>
  <para style="q" vid="PSA 126:3">nakaka tunemeleriti!<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4" />Gwee Mtuwa Mlungu, guwawuziyi wantu wa twenga yawawera muumanda,</para>
  <para style="q" vid="PSA 126:4">handa nshemba zazipata mashi mu shiwala sha Negebu.<verse eid="PSA 126:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5" />Yawayala kwa masozi,</para>
  <para style="q" vid="PSA 126:5">hawabenangi kwa nemelera.<verse eid="PSA 126:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6" />Yawayala mbeyu agawu pawalira,</para>
  <para style="q" vid="PSA 126:6">hawawuyi kwa kunemelera pawapapa mabenangu.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s">Pota Mlungu lihengu lya muntu shintundiri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 127:1" />Mtuwa Mlungu pakayinyawandiri numba,</para>
  <para style="q" vid="PSA 127:1">yawayinyawa waligaziya hera.</para>
  <para style="q" vid="PSA 127:1">Mtuwa Mlungu pakagulolerandiri mji,</para>
  <para style="q" vid="PSA 127:1">yawagulolera walikala masu hera.<verse eid="PSA 127:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2" />Mligaziya hera kwimuka mandawira putiputi</para>
  <para style="q" vid="PSA 127:2">na kukawalira kugonja,</para>
  <para style="q" vid="PSA 127:2">kwa kusakula shiboga.</para>
  <para style="q" vid="PSA 127:2">Kumbiti yomberi kawapanana shiboga yakawafira ata pawawera wagonja.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3" />Wana ndo uhala weni Mtuwa Mlungu katupanana,</para>
  <para style="q" vid="PSA 127:3">wana ndo lifupu lyakuyi kwa twenga.<verse eid="PSA 127:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4" />Wana yawiwuka shaka walera wawu pawawera wantemba,</para>
  <para style="q" vid="PSA 127:4">ndo handa misali mumawoku mwa wamashonta.<verse eid="PSA 127:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5" />Katekelerwa mweni kammemiziya misali mivuwa mumbeta.</para>
  <para style="q" vid="PSA 127:5">Hapeni kasindi,</para>
  <para style="q" vid="PSA 127:5">shaka pakaliwona na wankondu wakuyi kumigomi mikulu.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s">Lifupu kwa wantu yawamguwira Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 128:1" />Mbaka woseri yawamguwira Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 128:1">yawalikala kwakufata njira zakuyi.<verse eid="PSA 128:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2" />Haguliyi kulawilana na lihengu lyaku,</para>
  <para style="q" vid="PSA 128:2">hagunemeleri na kuwera na mbatiru.<verse eid="PSA 128:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3" />Mdala gwaku hakaleri nentu ukaya kwaku handa mzyabibu yagulera mabwajubwaju gavuwa,</para>
  <para style="q" vid="PSA 128:3">wana waku hawaweri handa ntomolu za mizeyituni hawazyengeti meza yaku.<verse eid="PSA 128:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4" />Ndo ntambu yanakatekelerwi,</para>
  <para style="q" vid="PSA 128:4">muntu yakamguwira Mtuwa Mlungu.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5" />Mtuwa Mlungu kakutekeleri kulawa Sayuni!</para>
  <para style="q" vid="PSA 128:5">Ili guwoni mbatiru ya Yerusalemu,</para>
  <para style="q" vid="PSA 128:5">mashaka goseri ga makaliru gaku.<verse eid="PSA 128:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6" />Hagulikali mpaka guwawoni wazukulu waku!</para>
  <para style="b" vid="PSA 128:6" />
  <para style="q" vid="PSA 128:6">Ponga iweri kwa Israeli!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s">Maluwa toziya ya wankondu wa Israeli</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 129:1" />Ntabisiwa nentu kwanjira untemba wangu,</para>
  <para style="q" vid="PSA 129:1">kila muntu mu Israeli nakalongi,<verse eid="PSA 129:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2" />Wantabisiya nentu kwanjira untemba wangu,</para>
  <para style="q" vid="PSA 129:2">kumbiti wawezandiri kunkanka.<verse eid="PSA 129:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3" />Walima mmugongu gwangu,</para>
  <para style="q" vid="PSA 129:3">handa muntu yakalima lirambu.<verse eid="PSA 129:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4" />Kumbiti Mtuwa Mlungu ndo yakana haki,</para>
  <para style="q" vid="PSA 129:4">kazidumula ngoyi za wantu wakontola.<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5" />Woseri walii yawagukalalira mji gwa Sayuni.</para>
  <para style="q" vid="PSA 129:5">Wasoniziwi na kuwuziwa kumbeli<verse eid="PSA 129:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6" />Waweri handa ntundu pampindi pa shitwiku sha numba,</para>
  <para style="q" vid="PSA 129:6">zyeni zinyala pamberi hazenikuli,<verse eid="PSA 129:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7" />zimemandiri ata muliwoku lya mbenanga,</para>
  <para style="q" vid="PSA 129:7">pota zitoshandiri kwa yakatawa visonku.<verse eid="PSA 129:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8" />Kwahera yakapita pakwegera yakafira kuwagambira,</para>
  <para style="q" vid="PSA 129:8">Mtuwa Mlungu Kawatekeleri!</para>
  <para style="q" vid="PSA 129:8">Tuwatekeleri kwa litawu lya Mtuwa Mlungu.<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s">Kuluwa Utanga</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 130:1" />Gwee Mtuwa Mlungu nikulilira kuwala mumashi matali.<verse eid="PSA 130:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2" />Gwee Mtuwa, gupikanili kulira kwaneni,</para>
  <para style="q" vid="PSA 130:2">guyambili likutu kupikanira liziwu lya maluwa ganeni.<verse eid="PSA 130:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3" />Gwee Mtuwa Mlungu handa meguwalangi makontola getu,</para>
  <para style="q" vid="PSA 130:3">gaa mekawezi kuponeka?<verse eid="PSA 130:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4" />Kumbiti kwagwenga tulekeziwa,</para>
  <para style="q" vid="PSA 130:4">su gukwiswi.<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5" />Nimutumbira Mtuwa Mlungu kwa moyu gwangu goseri,</para>
  <para style="q" vid="PSA 130:5">nishitumbira shisoweru shakuyi.<verse eid="PSA 130:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6" />Nimtumbira Mtuwa Mlungu kwa moyu gwangu goseri,</para>
  <para style="q" vid="PSA 130:6">kuliku walolera yawahepelera kushiyi,</para>
  <para style="q" vid="PSA 130:6">kuliku walolera yawahepelera mandawira<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7" />Gwee Israeli, gumtumbiri Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 130:7">mana kwa Mtuwa Mlungu kwana ufiru yawahera upeleru,</para>
  <para style="q" vid="PSA 130:7">kwakuyi kwana likakala likulu lya kutukombola.<verse eid="PSA 130:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8" />Yomberi hakakomboli wantu wa Israeli,</para>
  <para style="q" vid="PSA 130:8">kulawa mu vidoda vyawu vyoseri.<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s">Kumtumbira Mlungu kwa unyamaliru</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 131:1" />Gwee Mtuwa Mlungu, moyu gwahera mtiti,</para>
  <para style="q" vid="PSA 131:1">neni na muntundiri gwa kulitumba.</para>
  <para style="q" vid="PSA 131:1">Nilishenyiandiri na mirandu mikulu,</para>
  <para style="q" vid="PSA 131:1">ama mirandu mikamala kwaneni.<verse eid="PSA 131:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2" />Kumbiti moyu gwangu gunyamala na gwanaponga,</para>
  <para style="q" vid="PSA 131:2">handa mwana yakikutiti kunona maweri ga mawu gwakuyi,</para>
  <para style="q" vid="PSA 131:2">hangu ndo moyu gwaneni ntambu yagunyamala.<verse eid="PSA 131:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3" />Gwee Israeli, gumtumbiri Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 131:3">kwanjira vinu na ata mashaka goseri.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s">Zyuma ya numba ya Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 132:1" />Gwee Mtuwa Mlungu, gumholi Daudi,</para>
  <para style="q" vid="PSA 132:1">guholi ntabiku zoseri zyakapatiti.<verse eid="PSA 132:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2" />Kamlapiliti Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 132:2">katuliti naziri kwa Yakana Makakala gwa Yakobu.<verse eid="PSA 132:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3" />Hapeni ningiri mu numba ya neni,</para>
  <para style="q" vid="PSA 132:3">pota kugenda mushitanda shangu,<verse eid="PSA 132:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4" />hapeni njimiri kusizira pota kugonja,<verse eid="PSA 132:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5" />Mpaka nikupanani gwenga Mtuwa Mlungu pahala pa kulikala,</para>
  <para style="q" vid="PSA 132:5">makawu gaku, gwee Yakana Makakala gwa Yakobu.<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6" />Tupikaniriti visoweri vya lisandiku lya lipatanu aku Efrati,</para>
  <para style="q" vid="PSA 132:6">tulipatiti mumalambu ga Yearimu.<verse eid="PSA 132:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7" />Tulongiti, “Tugendi ukaya kwa Mlungu,</para>
  <para style="q" vid="PSA 132:7">tuguwiri palongolu pa shiti shakuyi sha ukulu!”<verse eid="PSA 132:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8" />Gwee Mtuwa Mlungu, gugoloki pahala paku pa koyera,</para>
  <para style="q" vid="PSA 132:8">gugoloki pamuhera na lisandiku lya likakala lyaku</para>
  <para style="q" vid="PSA 132:8">lyeni ndo shimaniziwu sha makakala gaku,</para>
  <para style="q" vid="PSA 132:8">na goyeli panu mashaka goseri!<verse eid="PSA 132:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9" />Watambika waku waweri wajimilika kulongolu kwa Mtuwa Mlungu mashaka goseri,</para>
  <para style="q" vid="PSA 132:9">na waminika waku watagi lusheka lwa nemeru!<verse eid="PSA 132:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10" />Toziya ya Daudi ntumintumi gwaku,</para>
  <para style="q" vid="PSA 132:10">nagumlema mswagwa lipaki gwaku.<verse eid="PSA 132:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11" />Mtuwa Mlungu kamrapira Daudi shirapu sha nakaka,</para>
  <para style="q" vid="PSA 132:11">“Shakalongiti hapeni kashigalambuli,</para>
  <para style="q" vid="PSA 132:11">hanimsyaguli yumu gwa wiwuka waku,</para>
  <para style="q" vid="PSA 132:11">kaweri mfalumi pa gwenga.<verse eid="PSA 132:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12" />Wana waku pawakola lipatanu lyangu,</para>
  <para style="q" vid="PSA 132:12">na kufata lagiru zya niwapananiti,</para>
  <para style="q" vid="PSA 132:12">wana wawu wapalu viraa hawaweli wafalumi handa gwenga.”<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13" />Mtuwa Mlungu kagusyagula mji gwa Sayuni,</para>
  <para style="q" vid="PSA 132:13">kafira guweri numba yakuyi yakulikala.<verse eid="PSA 132:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14" />Kalongiti, “Panu ndo hapaweri pahala pangu pa koyera mashaka goseri,</para>
  <para style="q" vid="PSA 132:14">ndo pakaya pangu toziya nipasyagula.<verse eid="PSA 132:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15" />Hanigutekeleri mji gwa Sayuni kwa kugupanana vintu vyakuyi,</para>
  <para style="q" vid="PSA 132:15">haniwapanani shiboga shivuwa wahushu wakuyi.<verse eid="PSA 132:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16" />Ulopola hawuweri handa mavalu kwa watambika,</para>
  <para style="q" vid="PSA 132:16">wananagala hawimbi kwa nemeleru.<verse eid="PSA 132:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17" />Panu hanimgangamaziyi mfalumi kulawa lukolu lwa Daudi.</para>
  <para style="q" vid="PSA 132:17">Na yomberi hakaweri handa shikoloboyi kwa Dawudi yanimsyaguliti,<verse eid="PSA 132:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18" />Wankondu wakuyi haniwasoniziyi,</para>
  <para style="q" vid="PSA 132:18">kumbiti yomberi hanimvaliziyi ligoya lya shifalumi.”<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s">Kulikala pamuhera</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 133:1" />Ndo mlandu mheri na gwa kufiriziya nentu,</para>
  <para style="q" vid="PSA 133:1">walongu kulikala pamuhera.<verse eid="PSA 133:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2" />Handa lipaki liherepa lyalinyiririka pamtuyi,</para>
  <para style="q" vid="PSA 133:2">lyaliselera mpaka kushilevu sha Aruni,</para>
  <para style="q" vid="PSA 133:2">nakusoka mulukosi lwa nguwu yakuyi.<verse eid="PSA 133:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3" />Ndo handa mangami ga lugongu Herimoni,</para>
  <para style="q" vid="PSA 133:3">yagatuluka pampindi pa vigongu vya Sayuni.</para>
  <para style="q" vid="PSA 133:3">Aku ndo Mtuwa Mlungu kalongiti hakawatekeleri wantu wakuyi,</para>
  <para style="q" vid="PSA 133:3">na kuwapanana ukomu wa mashaka goseri.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s">Lwimbu lwa kuzyuma Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 134:1" />Mwizi kumzyuma Mtuwa Mlungu mwenga wantumintumi wakuyi woseri,</para>
  <para style="q" vid="PSA 134:1">mwenga yamumtendera Mtuwa pashiru ukaya kwakuyi.<verse eid="PSA 134:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2" />Mnyasuli mawoku genu kulanguziya pahala pananagala,</para>
  <para style="q" vid="PSA 134:2">na kumzyuma Mtuwa Mlungu!<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3" />Mtuwa Mlungu yakawumbiti mpindi na pasipanu</para>
  <para style="q" vid="PSA 134:3">kawatekeleri kulawa Sayuni.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s">Lwimbu lwa kumzyuma Mtuwa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1" />Mumzyumi Mtuwa Mlungu!</para>
  <para style="b" vid="PSA 135:1" />
  <para style="q" vid="PSA 135:1">Mlizyumi litawu lya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 135:1">mumzyumi mwenga wantumintumi wa Mtuwa Mlungu,<verse eid="PSA 135:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2" />mwenga yamtenda lihengu mu numba yakuyi,</para>
  <para style="q" vid="PSA 135:2">mu ligeleri lya numba ya Mlungu gwetu.<verse eid="PSA 135:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3" />Mumzyumi Mtuwa Mlungu toziya yomberi ndo mheri,</para>
  <para style="q" vid="PSA 135:3">mumkwisi kwa lwimbu toziya litawu lyakuyi ndo liherepa.<verse eid="PSA 135:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4" />Mtuwa Mlungu kamsyagula Yakobu kuwera gwakuyi,</para>
  <para style="q" vid="PSA 135:4">na wantu wa Israeli kuwera uhala wakuyi.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5" />Nivimana nakaka kuwera Mtuwa Mlungu ndo mkulu,</para>
  <para style="q" vid="PSA 135:5">Mtuwa gwetu ndo mkulu kuliku wamlungu woseri.<verse eid="PSA 135:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6" />Mtuwa Mlungu katenda shoseri shakafira,</para>
  <para style="q" vid="PSA 135:6">kumpindi na pasipanu na kubahali na kumashi matali.<verse eid="PSA 135:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7" />Ndo yakajega mawundi kulawa mpeleru zya pasipanu,</para>
  <para style="q" vid="PSA 135:7">katenda lumeta pamuhera na mvula,</para>
  <para style="q" vid="PSA 135:7">na kuvumisiya lyega kulawa hanja zakuyi.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8" />Kawalagiti wiwuka wa kwanja aku Misri,</para>
  <para style="q" vid="PSA 135:8">wiwuka wa wantu na wankanyama viraa.<verse eid="PSA 135:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9" />Katenditi langiru na makangashu aku Misri,</para>
  <para style="q" vid="PSA 135:9">na kwa Farao na wantumintumi wakuyi woseri.<verse eid="PSA 135:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10" />Kagayagamiziyiti maisi gavuwa,</para>
  <para style="q" vid="PSA 135:10">kawalaga wafalumi yawana makakala.<verse eid="PSA 135:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11" />Mfalumi Sihoni gwa Waamori,</para>
  <para style="q" vid="PSA 135:11">mfalumi Ogu gwa Bashani,</para>
  <para style="q" vid="PSA 135:11">na wafalumi woseri wa Kanaani.<verse eid="PSA 135:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12" />Katoliti isi zawu na kuwapanana wantu wakuyi,</para>
  <para style="q" vid="PSA 135:12">ziweri uhala kwa wantu wakuyi Israeli.<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13" />Gwee Mtuwa Mlungu, litawu lyakuyi lilikala mashaka goseri,</para>
  <para style="q" vid="PSA 135:13">haguholwi viyiwuku mpaka viyiwuku.<verse eid="PSA 135:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14" />Mtuwa Mlungu hakawateteyi wantu wakuyi,</para>
  <para style="q" vid="PSA 135:14">na kuwawonera lusungu wantumintumi wakuyi.<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15" />Wamlungu wa maisi wanyawiwa na madini ga feza na zahabu,</para>
  <para style="q" vid="PSA 135:15">inyawiwa kwa mawoku ga wantu.<verse eid="PSA 135:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16" />Yana milomu kumbiti itakulandiri,</para>
  <para style="q" vid="PSA 135:16">yana masu kumbiti iwonandiri.<verse eid="PSA 135:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17" />Yana makutu kumbiti ipikinirandiri,</para>
  <para style="q" vid="PSA 135:17">pota iwezandiri kupumula.<verse eid="PSA 135:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18" />Woseri yawayinyawiti waweri handa womberi,</para>
  <para style="q" vid="PSA 135:18">na woseri yawayitumbira.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19" />Mwenga wantu wa Israeli, mumkwisi Mtuwa Mlungu!</para>
  <para style="q" vid="PSA 135:19">Mwenga watambika, mumkwisi Mtuwa Mlungu!<verse eid="PSA 135:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20" />Mwenga Walawi, mmukwisi Mtuwa Mlungu!</para>
  <para style="q" vid="PSA 135:20">Mwenga yamumguwira Mtuwa Mlungu mumkwisi yomberi!<verse eid="PSA 135:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21" />Kazyumwi Mtuwa Mlungu mu Sayuni,</para>
  <para style="q" vid="PSA 135:21">kakwisi mu makawu gakuyi Yerusalemu.</para>
  <para style="b" vid="PSA 135:21" />
  <para style="q" vid="PSA 135:21">Mumzyumi Mtuwa Mlungu!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s">Lwimbu lwa kulonga mayagashii kwa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1" />Mlongi mayagashii Mtuwa Mlungu toziya ndo mheri,</para>
  <para style="q" vid="PSA 136:1">mana ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 136:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2" />Mlongi mayagashi kwa Mlungu gwa wamlungu,</para>
  <para style="q" vid="PSA 136:2">toziya ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 136:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3" />Mlongi mayagashii Mtuwa gwa watuwa,</para>
  <para style="q" vid="PSA 136:3">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4" />yomberi gweka yakuyi yakatenda mawuzawuza makulu,</para>
  <para style="q" vid="PSA 136:4">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5" />yomberi kawumbiti mpindi kwa mahala gakuyi,</para>
  <para style="q" vid="PSA 136:5">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6" />yomberi ndo yakatandaziti isi pampindi pa mashi,</para>
  <para style="q" vid="PSA 136:6">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7" />yomberi ndo yakawumbiti mshenji na lyezi,</para>
  <para style="q" vid="PSA 136:7">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8" />mshenji guwali paliwala,</para>
  <para style="q" vid="PSA 136:8">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9" />mwezi na ntondu vilangali pashiru,</para>
  <para style="q" vid="PSA 136:9">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10" />ndo yakawalagiti wiwuka wa kwanja wa Misri,</para>
  <para style="q" vid="PSA 136:10">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11" />kawawusiya wantu wa Israeli kulawa Misri,</para>
  <para style="q" vid="PSA 136:11">mana ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 136:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12" />Kwa liwoku lyakuyi lyana likakala na ukulu,</para>
  <para style="q" vid="PSA 136:12">mana ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 136:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13" />Ndo yakayibaguliti Bahari ya Shamu sehemu mbili,</para>
  <para style="q" vid="PSA 136:13">mana ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 136:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14" />Kawapitiziya wantu wa Israeli amu,</para>
  <para style="q" vid="PSA 136:14">mana ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 136:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15" />Kumbiti kawadibisiyiti amu Farao na shonta lyakuyi,</para>
  <para style="q" vid="PSA 136:15">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16" />ndo yakawalonguziyiti wantu wakuyi kushiwala,</para>
  <para style="q" vid="PSA 136:16">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17" />ndo yakawakomangiti wafalumi yawana makalala,</para>
  <para style="q" vid="PSA 136:17">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18" />kawalagiti wafalumi yawamanika,</para>
  <para style="q" vid="PSA 136:18">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19" />shakapanu kamlagiti Sihoni, mfalumi gwa Waamori,</para>
  <para style="q" vid="PSA 136:19">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20" />na Ogu, mfalumi gwa Bashani,</para>
  <para style="q" vid="PSA 136:20">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21" />kawapanana isi wantu wakuyi kuwera uhala wawu,</para>
  <para style="q" vid="PSA 136:21">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22" />ziweri uhala wa wana wa Israeli, wantumintumi wakuyi,</para>
  <para style="q" vid="PSA 136:22">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23" />ndo yakatuholiti shaka sha kuwonerwa kwa twenga,</para>
  <para style="q" vid="PSA 136:23">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24" />katulopola kulawa kwa wankondu wetu,</para>
  <para style="q" vid="PSA 136:24">mana ufiru wakuyi ulikala mashaka goseri,<verse eid="PSA 136:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25" />ndo yakashipanana shiboga kila shiwumbi shashiwera shikomu,</para>
  <para style="q" vid="PSA 136:25">mana ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 136:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26" />Mlongi mayagashi kwa Mlungu gwa kumpindi,</para>
  <para style="q" vid="PSA 136:26">mana ufiru wakuyi ulikala mashaka goseri.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s">Madaya ga Israeli muuhamisiwu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1" />Kumbeku kulushemba Babeli, ndo patulikaliti,</para>
  <para style="q" vid="PSA 137:1">tuliriti patuyiholiti Sayuni.<verse eid="PSA 137:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2" />Mumitera ya isi ilii,</para>
  <para style="q" vid="PSA 137:2">tukweteka zeze letu.<verse eid="PSA 137:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3" />Yawatulopoliti wafiriti tuwimbiri,</para>
  <para style="q" vid="PSA 137:3">watabisiya wa twenga wafiriti tuwanemiziyi,</para>
  <para style="q" vid="PSA 137:3">pawalonga, “Mtwimbili lwimbu lumu lwa Sayuni!”<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4" />Hatwimbi hashi lwimbu lwa Mtuwa Mlungu muisi ya shihenga?<verse eid="PSA 137:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5" />Gwee Yerusalemu, handa panikulyaluwa!</para>
  <para style="q" vid="PSA 137:5">Liwoku lyangu lya kumliwu na lisindi kutenda lihengu!<verse eid="PSA 137:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6" />Lulimi lwangu na luweri lutopa,</para>
  <para style="q" vid="PSA 137:6">handa panikuholandiri, gwee Yerusalemu!</para>
  <para style="q" vid="PSA 137:6">Handa panikukwisandiri gwe Yerusalemu kuliku shilii shashinemiziya nentu.<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7" />Gwee Mtuwa Mlungu, guliholi gawatenditi Waedomu,</para>
  <para style="q" vid="PSA 137:7">lishaka lilii payilopolitwi Yerusalemu watakuliti,</para>
  <para style="q" vid="PSA 137:7">“Mubomoli mji gwa Yerusalemu! Mbomoli mpaka miyanjiru yakuyi!”<verse eid="PSA 137:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8" />Gwee Babeli, hagwagamiziwi!</para>
  <para style="q" vid="PSA 137:8">Katekelerwa yakafira kukuwuzilira,</para>
  <para style="q" vid="PSA 137:8">kwa galii gamututendiriti!<verse eid="PSA 137:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9" />Mbaka ulii yakafira kuwatola wana waku</para>
  <para style="q" vid="PSA 137:9">na kuwakomera kulitalabuhi!<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s">Luwa ya mayagashi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1" />Gwee Mtuwa Mlungu, nonga mayagashii kwa moyu gwangu goseri,</para>
  <para style="q" vid="PSA 138:1">hanikwimbili zyuma kulongolu kwa wamlungu.<verse eid="PSA 138:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2" />Hansuntamali kulola Numba Nkulu yaku nananagala,</para>
  <para style="q" vid="PSA 138:2">hanilizyumi litawu lyaku kwajili ya ufuiru waku na waminika waku,</para>
  <para style="q" vid="PSA 138:2">toziya gutenda shisoweru shaku na litawu lyaku kuwera vikulu kuliku vintu vyoseri.<verse eid="PSA 138:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3" />Panikuliliriti, gwenga gunankuliti,</para>
  <para style="q" vid="PSA 138:3">gunongeriti makakala gangu.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4" />Wafalumi woseri pasipanu hawakuzyumi gwee Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 138:4">toziya wavipikinira visoweru vyaku.<verse eid="PSA 138:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5" />Wimbi zyuma za matendu gaku,</para>
  <para style="q" vid="PSA 138:5">gwee Mtuwa Mlungu, toziya uweru waku ndo mkulu.<verse eid="PSA 138:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6" />Tembera Mtuwa Mlungu gwakumpindi,</para>
  <para style="q" vid="PSA 138:6">guwashera yawahera makakala,</para>
  <para style="q" vid="PSA 138:6">na yawana mtiti guwawona kulawa kutali.<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7" />Pawera muntabika,</para>
  <para style="q" vid="PSA 138:7">gwenga gundolera,</para>
  <para style="q" vid="PSA 138:7">gulitapisiya liwoku lyaku lya kumliwu,</para>
  <para style="q" vid="PSA 138:7">kundopola kwa wankondu wangu yawankalalira.<verse eid="PSA 138:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8" />Gwee Mtuwa Mlungu, hagumpuziliri goseri gantendiritwi.</para>
  <para style="q" vid="PSA 138:8">Gwee Mtuwa Mlungu ufiru waku wa mashaka goseri,</para>
  <para style="q" vid="PSA 138:8">nagulyaluwa lihengu lya mawoku gaku.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s">Mlungu kavimana goseri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 139:1" />Gwee Mtuwa Mlungu, gwenga gundolandola na kumana.<verse eid="PSA 139:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2" />Gwenga gumana kulikala na kugoloka kwa neni,</para>
  <para style="q" vid="PSA 139:2">guvimana kulawa kutali kila shintu shanishiholera.<verse eid="PSA 139:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3" />Guvimana kutyanga kwangu na kugonja kwangu,</para>
  <para style="q" vid="PSA 139:3">gwenga guvimana matendu gangu goseri.<verse eid="PSA 139:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4" />Pamberi haneni takuli shisoweru shosheli,</para>
  <para style="q" vid="PSA 139:4">gwenga Mtuwa Mlungu, guvimana goseri.<verse eid="PSA 139:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5" />Gwenga guzyengeta kulongolu na kumbeli,</para>
  <para style="q" vid="PSA 139:5">gundolera na likakala lyaku.<verse eid="PSA 139:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6" />Umani waku upita mahala gangu,</para>
  <para style="q" vid="PSA 139:6">ndo makulu nentu, wezandiri kugamana.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7" />Ng'endi koshi kweni rohu yaku kwahera?</para>
  <para style="q" vid="PSA 139:7">Ntugili koshi kweni gwenga kwahera?<verse eid="PSA 139:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8" />Pankwena kumpindi, gwenga gwakulaa,</para>
  <para style="q" vid="PSA 139:8">paniligonjeka pasi kwa yawahowiti,</para>
  <para style="q" vid="PSA 139:8">gwenga gwakulaa.<verse eid="PSA 139:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9" />Panguluka mpaka kwagulawa mshenji,</para>
  <para style="q" vid="PSA 139:9">mpaka upeleru wa bahari,<verse eid="PSA 139:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10" />ata aku gwakulaa kunongiziya,</para>
  <para style="q" vid="PSA 139:10">makakala gaku hagantangi.<verse eid="PSA 139:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11" />Ata panonga luwindu lunfifi,</para>
  <para style="q" vid="PSA 139:11">na kulangala kugalambuki kuweri pashiru,<verse eid="PSA 139:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12" />Kwa gwenga luwindu lukufifandiri,</para>
  <para style="q" vid="PSA 139:12">na pashiru pamulika handa paluwala,</para>
  <para style="q" vid="PSA 139:12">kwa gwenga luwindu ndo handa kulangala.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13" />Gwenga guviwumbiti viwungiru vyangu vya mngati,</para>
  <para style="q" vid="PSA 139:13">gunkolaniziya mumtima mwa mawu gwangu.<verse eid="PSA 139:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14" />Nonga mayagashi toziya neni gwakulikangasha,</para>
  <para style="q" vid="PSA 139:14">na matendu gaku ndo ga mauzauza</para>
  <para style="q" vid="PSA 139:14">na neni gumana nakamu.<verse eid="PSA 139:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15" />Mihonju yangu ififakandiri kwaku</para>
  <para style="q" vid="PSA 139:15">shaka pawumbitwi kwa bada.</para>
  <para style="q" vid="PSA 139:15">Shaka pawumbitwi kwa kunkolanila mumashi matali.<verse eid="PSA 139:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16" />Gwenga gumoniti pamberi haneni niwuki,</para>
  <para style="q" vid="PSA 139:16">gulembiti mashaka gangu mushitabu shaku,</para>
  <para style="q" vid="PSA 139:16">pamberi pa kuwera mashaka aga.<verse eid="PSA 139:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17" />Gwee Mlungu, yaguholela neni ndo makulu.</para>
  <para style="q" vid="PSA 139:17">Gawezandiri kuwalangika.<verse eid="PSA 139:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18" />Menigawalangi megaweri gavuwa kuliku mhanga.</para>
  <para style="q" vid="PSA 139:18">Panimkaku na pamuhera na gwenga.<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19" />Gwee Mtuwa Mlungu, nfira meguwalagi wakontola!</para>
  <para style="q" vid="PSA 139:19">Muwuki kwa neni mwega walagaji.<verse eid="PSA 139:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20" />Womberi walonga madoda kwa gwenga,</para>
  <para style="q" vid="PSA 139:20">waligiranga litawu lyaku.<verse eid="PSA 139:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21" />Gwee Mtuwa Mlungu, si niwakalalira yawakukalalira?</para>
  <para style="q" vid="PSA 139:21">Si niwabeza nentu walii yawakugalambuka?<verse eid="PSA 139:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22" />Niwakalalira nentu yawakukalalira,</para>
  <para style="q" vid="PSA 139:22">wankondu waku ndo wankondu waneni.<verse eid="PSA 139:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23" />Gwee Mlungu gundolindoli na gugumani moyu gwangu,</para>
  <para style="q" vid="PSA 139:23">gunjeri na gugamani maholu gangu.<verse eid="PSA 139:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24" />Gundoli mngati mwaneni guwoni handa kwana shikontola,</para>
  <para style="q" vid="PSA 139:24">gunonguziyi munjira ya mashaka goseri<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s">Kuluwa ulolera wa Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 140:1" />Gwee Mtuwa Mlungu, gundopoli na wantu wadoda,</para>
  <para style="q" vid="PSA 140:1">gunshingi na wantu wankesera.<verse eid="PSA 140:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2" />Wantu awa walihola madoda mumiyoyu mwawu mashaka goseri,</para>
  <para style="q" vid="PSA 140:2">wanjisha ndewu kila shaka.<verse eid="PSA 140:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3" />Milimi yawu inausungu handa ya njoka,</para>
  <para style="q" vid="PSA 140:3">mumilomu mwawu mwana visoweru vya usungu handa njoka moma.<verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4" />Gwee Mtuwa Mlungu, gumbusiyi kulawa mumawoku ga wantu wadoda,</para>
  <para style="q" vid="PSA 140:4">gunshingi na wantu wankesera</para>
  <para style="q" vid="PSA 140:4">weni wapanga kungusiya.<verse eid="PSA 140:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5" />Wanamtiti wanyambika mgomiziwu,</para>
  <para style="q" vid="PSA 140:5">wayalika ngoyi handa wavu,</para>
  <para style="q" vid="PSA 140:5">wafifa migomiziwu munjira su wangomiziyi.<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6" />Nimgambira Mtuwa Mlungu, “Gwenga ndo Mlungu gwangu.”</para>
  <para style="q" vid="PSA 140:6">Gwee Mtuwa Mlungu, gupikinili liziwu lya kuluwa kwangu.<verse eid="PSA 140:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7" />Gwee Mtuwa Mlungu, Mtuwa Gwangu, mlopola gwangu mkulu,</para>
  <para style="q" vid="PSA 140:7">gundoleliriti shaka sha nkondu.<verse eid="PSA 140:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 140:8" />Gwee Mtuwa Mlungu, naguwapanana wakontola vyawafira,</para>
  <para style="q" vid="PSA 140:8">naguleka mipangu yawu midoda nayifanikiwa na wiza kulitumba.<verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 140:9" />Naguwaleka wakondu wangu wakanki,</para>
  <para style="q" vid="PSA 140:9">ukontola wa miromu yawu iwapati weni.<verse eid="PSA 140:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10" />Makala ga motu gawatulukili,</para>
  <para style="q" vid="PSA 140:10">wapatuziwi mumalindi matali, nawagoloka kayi.<verse eid="PSA 140:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11" />Yawawatakula wamonga nawawera na mpatiru muisi,</para>
  <para style="q" vid="PSA 140:11">ukontola uwapati wankesera na kuwaagamiziya nakamu.<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12" />Mtuwa Mlungu nivimana kuwera guwateteya wahushu,</para>
  <para style="q" vid="PSA 140:12">kawapanana haki yawahera shintu.<verse eid="PSA 140:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13" />Nakaka yawana haki hawalizyumi litawu lyaku,</para>
  <para style="q" vid="PSA 140:13">waaminika hawalikali kwa gwenga.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s">Luwa ya pashimihi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 141:1" />Gwee Mtuwa Mlungu nikushema,</para>
  <para style="q" vid="PSA 141:1">gwizi kalongola guntangi!</para>
  <para style="q" vid="PSA 141:1">Gulipikinili liziwu lyangu shaka panikushema!<verse eid="PSA 141:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2" />Luwa yangu guyiyanki handa ubani,</para>
  <para style="q" vid="PSA 141:2">panyasula mawoku gangu kwagwenga gunjimiri handa tambiku ya pashimihi.<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3" />Gwee Mtuwa Mlungu guguleweleri mlomu gwangu nagulonga makontola,</para>
  <para style="q" vid="PSA 141:3">milomu yangu naitakula madoda.<verse eid="PSA 141:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4" />Guleweleri moyu gwangu nagutenda madoda,</para>
  <para style="q" vid="PSA 141:4">nantenda matendu makontola,</para>
  <para style="q" vid="PSA 141:4">nankwegwa na yawatenda vidoda,</para>
  <para style="q" vid="PSA 141:4">pota nawera mu misambu yawu.<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5" />Mbaka muntu mheri kankomi na kunkalipira kwa ufiru,</para>
  <para style="q" vid="PSA 141:5">kumbiti njimirandiri kuzyumwa na wadoda,</para>
  <para style="q" vid="PSA 141:5">mana nduwa mashaka goseri kugalema makontola gawu.<verse eid="PSA 141:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6" />Wakulu wawu pawasangwa mumatalabuhi,</para>
  <para style="q" vid="PSA 141:6">wakontola ndo hawavimani kuwera visoweru vyaneni vya nakaka.<verse eid="PSA 141:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7" />Hawalongi, handa muntu yakalima na kukomanga mabulumunda vipandi vipandi</para>
  <para style="q" vid="PSA 141:7">mihonju yawu ndo hayiwapalasiyi mumlomu gwa wantu yawahowiti.<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8" />Gwee Mtuwa Mlungu, neni nikutumbira,</para>
  <para style="q" vid="PSA 141:8">Mlungu gwangu, nikutugira uponera kwa gwenga,</para>
  <para style="q" vid="PSA 141:8">nagundeka mukutenduwa.<verse eid="PSA 141:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9" />Gunshingi na migomiziwu yawanyambiliti,</para>
  <para style="q" vid="PSA 141:9">gumponiziyi na migomiziwu ya wantu wakontola awa.<verse eid="PSA 141:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10" />Wakontola wagomiziwi munyavu zawu,</para>
  <para style="q" vid="PSA 141:10">naneni hampiti poneka.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s">Luwa ga utanga</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 142:1" />Nimlilira Mtuwa Mlungu kwa kubota,</para>
  <para style="q" vid="PSA 142:1">nimluwa Mtuwa Mlungu kamoneri lusungu.<verse eid="PSA 142:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2" />Nimjegera lalamiku lyangu,</para>
  <para style="q" vid="PSA 142:2">nimgambira tabika yangu.<verse eid="PSA 142:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3" />Patwezukiti moyu,</para>
  <para style="q" vid="PSA 142:3">gwenga guvimana mgenderanu gwangu.</para>
  <para style="q" vid="PSA 142:3">Munjira yampita wankondu wanyambira mgomiziwu.<verse eid="PSA 142:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4" />Pandola uwega wakumliwu na kuhepelera,</para>
  <para style="q" vid="PSA 142:4">mona kwahera muntu gwa kuntanga,</para>
  <para style="q" vid="PSA 142:4">nahera kayi pahala pa kutugira,</para>
  <para style="q" vid="PSA 142:4">kwahera muntu yakanshera.<verse eid="PSA 142:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5" />Gwee Mtuwa Mlungu nikulilira gwenga!</para>
  <para style="q" vid="PSA 142:5">Naneni nonga, gwenga ndo tugira ya neni uhala waneni muisi ya wakomu.<verse eid="PSA 142:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6" />Gupikinili kulira kwa neni,</para>
  <para style="q" vid="PSA 142:6">toziya nahera likakala,</para>
  <para style="q" vid="PSA 142:6">gundopoli na watabisiya waneni,</para>
  <para style="q" vid="PSA 142:6">toziya wanzidi likakala.<verse eid="PSA 142:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7" />Gundaviyi mukutatirwa,</para>
  <para style="q" vid="PSA 142:7">su nongi mayagashii.</para>
  <para style="q" vid="PSA 142:7">Wantu waminika hawazyengeti toziya guntendera maheri.<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s">Kuluwa utanga</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1" />Gwee Mtuwa Mlungu, gupikinili kuluwa kwa neni!</para>
  <para style="q" vid="PSA 143:1">Gupikanili luwa yangu</para>
  <para style="q" vid="PSA 143:1">toziya gwenga ndo yagwana haki,</para>
  <para style="q" vid="PSA 143:1">gunankuli toziya ya waminika waku.<verse eid="PSA 143:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2" />Naguntoza neni ntumintumi gwaku,</para>
  <para style="q" vid="PSA 143:2">toziya kwahera yoseri yakawera mkomu kana haki kulongolu kwaku.<verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3" />Wankondu wa wangu wanfata,</para>
  <para style="q" vid="PSA 143:3">wankusiya pasi nakamu,</para>
  <para style="q" vid="PSA 143:3">wankaliziya kuluwindu handa muntu yakahowiti makashu.<verse eid="PSA 143:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4" />Twezuka moyu,</para>
  <para style="q" vid="PSA 143:4">rohu yangu isintuka toziya ya lyoga.<verse eid="PSA 143:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5" />Nilihola mashaka gapititi,</para>
  <para style="q" vid="PSA 143:5">nilihola goseri gagutenditi,</para>
  <para style="q" vid="PSA 143:5">nigalola weri matendu gaku.<verse eid="PSA 143:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6" />Nyasula mawoku gangu kukuluwa,</para>
  <para style="q" vid="PSA 143:6">nana yumiluwa yangu handa isi iyuma yayahera mashi.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7" />Gwee Mtuwa Mlungu, gunankuli kalongola,</para>
  <para style="q" vid="PSA 143:7">toziya moyu gwangu gutoka!</para>
  <para style="q" vid="PSA 143:7">Nagulififa kutali na neni,</para>
  <para style="q" vid="PSA 143:7">naniza kuwera handa walii yawaselera kwa wantu yawahowiti.<verse eid="PSA 143:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8" />Mandawira gunanguziyi ufiru waku,</para>
  <para style="q" vid="PSA 143:8">mana nikutumbira gwenga.</para>
  <para style="q" vid="PSA 143:8">Gunanguziyi njira ya kufata, toziya nikutumbira gwenga.<verse eid="PSA 143:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9" />Gwee Mtuwa Mlungu, gundopoli, kulawa kwa wankondu wangu,</para>
  <para style="q" vid="PSA 143:9">toziya kwa gwenga nilififa.<verse eid="PSA 143:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10" />Gunfundi kutenda gagufira,</para>
  <para style="q" vid="PSA 143:10">toziya gwenga ndo Mlungu gwangu!</para>
  <para style="q" vid="PSA 143:10">Rohu gwaku muheri kanonguziyi muisi lalanda.<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11" />Gwee Mtuwa Mlungu, toziya ya litawu lyaku gulopoli ukomu wangu,</para>
  <para style="q" vid="PSA 143:11">kwa haki gumbusiyi mukutabika.<verse eid="PSA 143:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12" />Kwajili ya ufiru waku kwaneni, guwalagi wankondu wangu,</para>
  <para style="q" vid="PSA 143:12">guwagamiziyi nakamu yawantabisiya,</para>
  <para style="q" vid="PSA 143:12">toziya neni na ntumintumi gwaku.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s">Mayagashii toziya ukanka</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 144:1" />Katekelerwi Mtuwa Mlungu, litalabuhi lyangu,</para>
  <para style="q" vid="PSA 144:1">yakafunda mawoku gangu nkondu,</para>
  <para style="q" vid="PSA 144:1">na vyala vyangu kulikomanga.<verse eid="PSA 144:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2" />Yomberi ndo ufiru wangu na liboma lyangu,</para>
  <para style="q" vid="PSA 144:2">shinga yaneni na mlopola gwangu,</para>
  <para style="q" vid="PSA 144:2">yomberi ndo lusegeyu lwangu kwakuyi mpata uponera,</para>
  <para style="q" vid="PSA 144:2">yomberi kagakanka maisi na kugatula pasipaneni.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3" />Gwee Mtuwa Mlungu, muntu ndo gaa ata gumsheri?</para>
  <para style="q" vid="PSA 144:3">Muntu yakana shimba ndo shii ata gumloli?<verse eid="PSA 144:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4" />Muntu ndo handa pumla hera,</para>
  <para style="q" vid="PSA 144:4">mashaka gakuyi ndo madidini handa lisisi lyalipita.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5" />Gwee Mtuwa Mlungu gupanti mpindi zaku, gusuluki pasi!</para>
  <para style="q" vid="PSA 144:5">Guyishing'uli migongu na yeni ilaviyi lyosi!<verse eid="PSA 144:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6" />Gumeti, guwapalasiyi wankondu,</para>
  <para style="q" vid="PSA 144:6">gugumi misali yaku, guwatugiziyi!<verse eid="PSA 144:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7" />Gutalipisiyi liwoku lyaku kulawa kumpindi,</para>
  <para style="q" vid="PSA 144:7">gundopoli na kumpusiya mumashi gavuwa,</para>
  <para style="q" vid="PSA 144:7">gumpusiyi mumawoku mwa wahenga,<verse eid="PSA 144:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8" />yakalonga visoweru vya mpayu,</para>
  <para style="q" vid="PSA 144:8">yakapaya pakalirapa.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9" />Hanikwimbili lwimbu lwa syayi, gwee Mlungu,</para>
  <para style="q" vid="PSA 144:9">hanikugomberi lingutinguti lya nyuzi lilongu.<verse eid="PSA 144:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10" />Gwenga yaguwapanana wafalumi ukanka,</para>
  <para style="q" vid="PSA 144:10">yagumlopoliti Daudi ntumintumi gwaku, kulawirana na ligumba lya kuhowa.<verse eid="PSA 144:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11" />Gundopoli na kuntula lekeru,</para>
  <para style="q" vid="PSA 144:11">kulawa mumawoku mwa wahenga,</para>
  <para style="q" vid="PSA 144:11">weni walonga visoweru vya mpayu,</para>
  <para style="q" vid="PSA 144:11">wapaya pawalirapa.<verse eid="PSA 144:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12" />Wantemba wa twenga muwuntemba wawu hawaweri handa shimeru yashisisitawi,</para>
  <para style="q" vid="PSA 144:12">wahinga wetu waweri handa mpanda yazisongolitwi kuherepiziya numba ya mfalumi.<verse eid="PSA 144:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13" />Hanja zyetu zimemi viboga vya kila ntambu.</para>
  <para style="q" vid="PSA 144:13">Kondolu wa twenga mumalambu waleri maelufu kwa maelufu.<verse eid="PSA 144:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14" />Ng'ombi wetu hawapapi visanka vizotopa,</para>
  <para style="q" vid="PSA 144:14">kwahera yanakaweri lopola.</para>
  <para style="q" vid="PSA 144:14">Kwahera kulira mu njira za miji yetu.<verse eid="PSA 144:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15" />Watekelerwa wantu yawapananitwi aga,</para>
  <para style="q" vid="PSA 144:15">watekelerwa weni Mtuwa Mlungu ndo Mlungu gwawu!<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s">Lwimbu lwa kumzyuma Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1" />Gwee Mlungu gwangu na mfalumi gwangu, hanikukwisi,</para>
  <para style="q" vid="PSA 145:1">hanilikwisi litawu lyaku mashaka goseri.<verse eid="PSA 145:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2" />Hanikutekeleri kila lishaka,</para>
  <para style="q" vid="PSA 145:2">hanilizyumi litawu lyaku mashaka goseri.<verse eid="PSA 145:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3" />Mtuwa Mlungu ndo mkulu, yakafiruwa zyuma zivuwa,</para>
  <para style="q" vid="PSA 145:3">ukulu wakuyi ulolwalolwandiri.<verse eid="PSA 145:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4" />Zyuma za matendu gaku hazitambirwi kulawa wiwuka mpaka wiwuka,</para>
  <para style="q" vid="PSA 145:4">wantu hawabweri matendu gaku makulu.<verse eid="PSA 145:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5" />Hantakuli kuusu uweru na ukulu waku,</para>
  <para style="q" vid="PSA 145:5">hanigaholi matendu gaku ga kulikangasha.<verse eid="PSA 145:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6" />Wantu hawabweri ukulu wa matendu gaku ga kulikangasha,</para>
  <para style="q" vid="PSA 145:6">naneni habweri ukulu waku.<verse eid="PSA 145:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7" />Hawaliholi ukulu wa uherepa waku hawakuzyumi</para>
  <para style="q" vid="PSA 145:7">hawakwimbiri kwajili ya uaminika waku.<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8" />Mtuwa Mlungu ndo yakana lusungu na kalekaziya,</para>
  <para style="q" vid="PSA 145:8">kakalalandiri kalongola na kamema ufiru.<verse eid="PSA 145:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9" />Mtuwa Mlungu ndo mheri kwa wantu woseri,</para>
  <para style="q" vid="PSA 145:9">kana lusungu kwa viwumbi vyakuyi vyoseri.<verse eid="PSA 145:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10" />Gwee Mtuwa Mlungu, viwumbi vyaku vyoseri havilongi mayagashi,</para>
  <para style="q" vid="PSA 145:10">na waminika waku hawakutekeleri.<verse eid="PSA 145:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11" />Hawalongi kuusu ukwisa wa ufalumi waku,</para>
  <para style="q" vid="PSA 145:11">na kubwera kuusu likakala lyaku likulu,<verse eid="PSA 145:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12" />su kila muntu kavimani matendu gaku makulu,</para>
  <para style="q" vid="PSA 145:12">na uweru mkulu wa ufalumi waku.<verse eid="PSA 145:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13" />Ufalumi waku ndo ufalumi wa mashaka goseri,</para>
  <para style="q" vid="PSA 145:13">ukolamlima waku ulikala wiwuka woseri.</para>
  <para style="b" vid="PSA 145:13" />
  <para style="q" vid="PSA 145:13">Mtuwa Mlungu ndo mwaminika kwa galii goseri gakalongiti,</para>
  <para style="q" vid="PSA 145:13">ndo muheri mumatendu gakuyi goseri.<verse eid="PSA 145:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14" />Mtuwa Mlungu kawatanga woseri yawaguwa</para>
  <para style="q" vid="PSA 145:14">kawanyasula woseri yawayonelitwi.<verse eid="PSA 145:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15" />Viwumbi vyoseri vikutumbira gwenga,</para>
  <para style="q" vid="PSA 145:15">na gwenga guvipanana viboga vyawu kwa shaka shakuyi.<verse eid="PSA 145:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16" />Gukuzumla liwoku kuwapanana,</para>
  <para style="q" vid="PSA 145:16">kila shiwumbi gushikutiziya kwa shilii shakashifira.<verse eid="PSA 145:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17" />Mtuwa Mlungu ndo mwaminika munjira zakuyi zoseri,</para>
  <para style="q" vid="PSA 145:17">ndo yakana haki mumahengu gakuyi goseri.<verse eid="PSA 145:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18" />Mtuwa Mlungu kapakwegera na woseri yawamshema,</para>
  <para style="q" vid="PSA 145:18">woseri yawamluwa kwa moyu mwaminika.<verse eid="PSA 145:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19" />Kawapanana nfiru zawu zoseri yawamguwira,</para>
  <para style="q" vid="PSA 145:19">kapikinira kulira kwawu na kuwalopola.<verse eid="PSA 145:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20" />Mtuwa Mlungu kawaloleraga woseri yawamfira,</para>
  <para style="q" vid="PSA 145:20">kumbiti hakawagamiziyi wakontola woseri.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21" />Habweri zyuma za Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 145:21">na woseri yakawawumbiti walizyumi litawu lyakuyi linanagala,</para>
  <para style="q" vid="PSA 145:21">mashaka goseri.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s">Kumzyuma Mlungu mlopola</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1" />Gumzyumi Mtuwa Mlungu!</para>
  <para style="q" vid="PSA 146:1">Gwee rohu yangu gumzyumi Mtuwa Mlungu!<verse eid="PSA 146:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2" />Hanimzyumi Mtuwa Mlungu makaliru gangu goseri,</para>
  <para style="q" vid="PSA 146:2">Hanimwimbiri Mlungu gwangu mashaka gangu goseri.<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3" />Namuwatumbira wakulu wa isi,</para>
  <para style="q" vid="PSA 146:3">awa ndo wantu hera, wawezandiri kulopola.<verse eid="PSA 146:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4" />Muntu pakahowa kawuya mumadikudiku,</para>
  <para style="q" vid="PSA 146:4">lishaka lilaali mipangu yakuyi yoseri ipera.<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5" />Katekelerwa muntu yakatagwa na Mlungu gwa Yakobu,</para>
  <para style="q" vid="PSA 146:5">muntu yakatuliti litumbiru lyakuyi kwa Mtuwa Mlungu, Mlungu gwakuyi,<verse eid="PSA 146:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6" />Yakawumbiti mpindi na pasipanu,</para>
  <para style="q" vid="PSA 146:6">bahari na vyoseri yaviwera amu.</para>
  <para style="q" vid="PSA 146:6">Mashaka goseri yomberi ndo mwaminika.<verse eid="PSA 146:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7" />Yomberi kawateteya yawaonerwa,</para>
  <para style="q" vid="PSA 146:7">kawapanana wana njala shiboga.</para>
  <para style="b" vid="PSA 146:7" />
  <para style="q" vid="PSA 146:7">Mtuwa Mlungu kawavugula yawatatirwa,<verse eid="PSA 146:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8" />Kawatenda yawanalwisi wawoni.</para>
  <para style="q" vid="PSA 146:8">Mtuwa Mlungu kawanyasula yawaguwa,</para>
  <para style="q" vid="PSA 146:8">kawafira wantu yawawera waminika.<verse eid="PSA 146:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9" />Mtuwa Mlungu kawalolera wahenga,</para>
  <para style="q" vid="PSA 146:9">kawatanga wakenja na yawahera tati,</para>
  <para style="q" vid="PSA 146:9">kumbiti kazivuluvutira njira ya wakontola.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10" />Mtuwa Mlungu hakakolimlima mashaka goseri,</para>
  <para style="q" vid="PSA 146:10">gwee Sayuni, Mlungu gwaku ndo mfalumi gwa viyiwuku woseri!</para>
  <para style="b" vid="PSA 146:10" />
  <para style="q" vid="PSA 146:10">Mmuzyumi Mtuwa Mlungu!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s">Iherepa kumzyuma Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1" />Mumzyumi Mtuwa Mlungu!</para>
  <para style="b" vid="PSA 147:1" />
  <para style="q" vid="PSA 147:1">Mana ndo iherepa kumzyuma Mlungu gwetu!</para>
  <para style="q" vid="PSA 147:1">Yomberi ndo mheri na kafiruwa kwimbirwa zyuma.<verse eid="PSA 147:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2" />Mtuwa Mlungu kanyawa kayi mji gwa Yerusalemu,</para>
  <para style="q" vid="PSA 147:2">kankuwawuziya Waisraeli yawaweriti kuuhamisiwu.<verse eid="PSA 147:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3" />Kankuwaponiziya yawatwezuka moyu,</para>
  <para style="q" vid="PSA 147:3">na kuwatawa malonda gawu.<verse eid="PSA 147:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4" />Kawalanga ntondu zoseri,</para>
  <para style="q" vid="PSA 147:4">na kuzipanana matawu.<verse eid="PSA 147:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5" />Mtuwa gwetu ndo mkulu na kana makakala nentu,</para>
  <para style="q" vid="PSA 147:5">umani wakuyi wahera mpaka.<verse eid="PSA 147:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6" />Mtuwa Mlungu kawanyasula wananaga,</para>
  <para style="q" vid="PSA 147:6">kumbiti kawasira wakontola mumalivu.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7" />Mumwimbiri Mtuwa Mlungu nyimbu za mayagashi,</para>
  <para style="q" vid="PSA 147:7">mumgomberi lugombugombu Mlungu gwetu!<verse eid="PSA 147:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8" />Yomberi kaligibikira liyera kwa mawundi,</para>
  <para style="q" vid="PSA 147:8">kayitandira isi mvula,</para>
  <para style="q" vid="PSA 147:8">na kutomiziya ntundu kuvigongu.<verse eid="PSA 147:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9" />Kawapanana wankanyama shiboga shawu,</para>
  <para style="q" vid="PSA 147:9">na kuwaliyiziya wana wa kungulu pawalira.<verse eid="PSA 147:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10" />Yomberi kafirandiri makakala ga farasi,</para>
  <para style="q" vid="PSA 147:10">pota kafiliziwandiri na ugangamala wa wanjagira,<verse eid="PSA 147:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11" />kumbiti kafiliziwa na wantu yawamguwira,</para>
  <para style="q" vid="PSA 147:11">wantu yawatumbira ufiru wakuyi.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12" />Gwee Yerusalemu, gumzyumi Mtuwa Mlungu.</para>
  <para style="q" vid="PSA 147:12">Gwee Sayuni, gulongi mayagashii kwa Mlungu gwaku.<verse eid="PSA 147:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13" />Toziya yomberi kagangamaziya migomi yakuyi,</para>
  <para style="q" vid="PSA 147:13">kawatekelera wantu yawawera mngati mwakuyi.<verse eid="PSA 147:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14" />Kakupanana ponga mumpaka mwaku,</para>
  <para style="q" vid="PSA 147:14">kakwikutuziya viboga viherepa.<verse eid="PSA 147:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15" />Yomberi kajega lagalira yakuyi pasipanu,</para>
  <para style="q" vid="PSA 147:15">shisoweru shakuyi shitenda shakafiriti kalongola.<verse eid="PSA 147:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16" />Katandaziya seluji handa mibahira,</para>
  <para style="q" vid="PSA 147:16">kapalasiya mangami handa malivu.<verse eid="PSA 147:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17" />Katowa mvula ya mabuwi handa kokotu</para>
  <para style="q" vid="PSA 147:17">kwahera yakaweza kuhepelera mpepu yakuyi.<verse eid="PSA 147:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18" />Kalagalira shisoweru shakuyi shilumbujuka,</para>
  <para style="q" vid="PSA 147:18">kavumisiya lyega lyakuyi, liwera mashi.<verse eid="PSA 147:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19" />Kamgambiriti Yakobu ulagilagi wakuyi,</para>
  <para style="q" vid="PSA 147:19">na Israeli malagalira na toza zakuyi.<verse eid="PSA 147:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20" />Kumbiti kagatenderandiri hangu maisi gamonga,</para>
  <para style="q" vid="PSA 147:20">wantu wamonga wavimanandiri lagiru zakuyi.</para>
  <para style="b" vid="PSA 147:20" />
  <para style="q" vid="PSA 147:20">Mmuzyumi Mtuwa Mlungu!<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s">Pasipanu poseri pamzyumi Mlungu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1" />Mumzyumi Mtuwa Mlungu!</para>
  <para style="b" vid="PSA 148:1" />
  <para style="q" vid="PSA 148:1">Mumzyumi Mtuwa Mlungu kulawa kumpindi,</para>
  <para style="q" vid="PSA 148:1">mumzyumi kulawa aku kumpindi.<verse eid="PSA 148:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2" />Mumzyumi, mwenga wantumintumi wakuyi woseri wa kumpindi,</para>
  <para style="q" vid="PSA 148:2">mumzyumi, mwenga wamashonta wakuyi woseri.<verse eid="PSA 148:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3" />Mumzyumi, mwenga mshenji na lyezi,</para>
  <para style="q" vid="PSA 148:3">mumzyumi, ntondu zoseri zyazing'erengeta,<verse eid="PSA 148:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4" />mumzyumi, mwenga mpindi za pampindi,</para>
  <para style="q" vid="PSA 148:4">na mashi yagawera pampindi pa mpindi.<verse eid="PSA 148:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5" />Vyoseri vilizyumi litawu lya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 148:5">toziya viwumbitwi kwa lagaliru yakuyi.<verse eid="PSA 148:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6" />Yomberi kashituliti kila shintu pahala pakuyi mashaka goseri,</para>
  <para style="q" vid="PSA 148:6">kwa lagiru lyayiwezandiri kugalambulwa.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7" />Mumzyumi Mtuwa Mlungu kulawa pasipanu,</para>
  <para style="q" vid="PSA 148:7">mwenga viwumbi vikulu vya bahari na mumashi matali, mumzyumi Mlungu.<verse eid="PSA 148:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8" />Mwenga mpanta, mvula ya mabuwi na seluji mumzyumi,</para>
  <para style="q" vid="PSA 148:8">lyega lyalivuma kwa lagalira yakuyi,<verse eid="PSA 148:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9" />mumzyumi mwenga vigongu na vidunda,</para>
  <para style="q" vid="PSA 148:9">mitera ya mabwajubwaju na miyerezi,<verse eid="PSA 148:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10" />mmuzyumi mwenga wakanyama wa kuntundu na wakufuga,</para>
  <para style="q" vid="PSA 148:10">viwumbi yavikwawakwawa na wampongu woseri,<verse eid="PSA 148:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11" />mumzyumi mwenga wafalumi na wantu woseri pasipanu,</para>
  <para style="q" vid="PSA 148:11">walonguziya na wakolamilima woseri pasipanu,<verse eid="PSA 148:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12" />mumzyumi mwenga wantemba na wahinga,</para>
  <para style="q" vid="PSA 148:12">wazewi woseri na wana,<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13" />mwawoseri mlizyumi litawu lya Mtuwa Mlungu,</para>
  <para style="q" vid="PSA 148:13">mana litawu lyakuyi gweka yakuyi ndo likulu nentu,</para>
  <para style="q" vid="PSA 148:13">uweru wakuyi panani pa pasipanu na kumpindi.<verse eid="PSA 148:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14" />Kawapanana wantu wakuyi makakala,</para>
  <para style="q" vid="PSA 148:14">ligoya kwa wananagala wakuyi woseri,</para>
  <para style="q" vid="PSA 148:14">wantu wa Israeli yakawafira.</para>
  <para style="b" vid="PSA 148:14" />
  <para style="q" vid="PSA 148:14">Mumzyumi Mtuwa Mlungu!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s">Lwimbu lwa zyuma</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1" />Mumzyumi Mtuwa Mlungu!</para>
  <para style="b" vid="PSA 149:1" />
  <para style="q" vid="PSA 149:1">Mumwimbili Mtuwa Mlungu lwimbu lwasyayi,</para>
  <para style="q" vid="PSA 149:1">Mumzyumi mulijojoniku lya waminika!<verse eid="PSA 149:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2" />Gwee Israeli gunemeleri toziya ya mwumba gwaku,</para>
  <para style="q" vid="PSA 149:2">wantu wa Sayuni mfyapiliri toziya ya mfalumi gwenu.<verse eid="PSA 149:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3" />Na walizyumi litawu lyakuyi,</para>
  <para style="q" vid="PSA 149:3">wamwimbili kwa ngoma na zezi.<verse eid="PSA 149:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4" />Toziya Mtuwa Mlungu kafiliziwa na wantu wakuyi,</para>
  <para style="q" vid="PSA 149:4">yomberi kawanyasula yawawonerwa kwa kuwalopola.<verse eid="PSA 149:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5" />Wantu waminika wanemeleri ligoya ali,</para>
  <para style="q" vid="PSA 149:5">wafyapiliri ata pawawera muvitanda vyawu.<verse eid="PSA 149:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6" />Wamzyumi Mlungu kwa kubotanga,</para>
  <para style="q" vid="PSA 149:6">wakola magumba gakalipa wega zoseri mumawoku mwawu,<verse eid="PSA 149:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7" />su wawawuziliri wantu wa maisi gamonga,</para>
  <para style="q" vid="PSA 149:7">wawakomangi wantu yawammanandiri Mlungu,<verse eid="PSA 149:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8" />wawatawi wafalumi wawu kwa minyololu,</para>
  <para style="q" vid="PSA 149:8">na walonguziya wawu kwa pingu za shuma,<verse eid="PSA 149:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9" />su wawatozi ntambu yayilembitwi!</para>
  <para style="q" vid="PSA 149:9">Ali ndo ligoya lya waminika wa Mlungu.</para>
  <para style="b" vid="PSA 149:9" />
  <para style="q" vid="PSA 149:9">Mumzyumi Mtuwa Mlungu!<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s">Mumzyumi Mlungu kwa ufiru wakuyi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1" />Mumzyumi Mtuwa Mlungu!</para>
  <para style="b" vid="PSA 150:1" />
  <para style="q" vid="PSA 150:1">Mumzyumi Mlungu pananagala pakuyi,</para>
  <para style="q" vid="PSA 150:1">Mumzyumi kumpindi zakuyi nkulu.<verse eid="PSA 150:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2" />Mumzyumi toziya ya matendu gakuyi makulu,</para>
  <para style="q" vid="PSA 150:2">mumzyumi toziya ya uweru wakuyi mkulu.<verse eid="PSA 150:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3" />Mumzyumi kwa mlilu gwa lipenka,</para>
  <para style="q" vid="PSA 150:3">mumzyumi kwa zezi na lingutinguti.<verse eid="PSA 150:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4" />Mumzyumi kwa ngoma na kuvina,</para>
  <para style="q" vid="PSA 150:4">mumzyumi kwa miluli na lingutinguti!<verse eid="PSA 150:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5" />Mumzyumi kwa kugomba madebi.</para>
  <para style="q" vid="PSA 150:5">Mumzyumi kwa madebi yagana liziwu nentu.<verse eid="PSA 150:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6" />Kila shiwumbi shikomu shimzyumi Mtuwa Mlungu!</para>
  <para style="b" vid="PSA 150:6" />
  <para style="q" vid="PSA 150:6">Mumzyumi Mtuwa Mlungu!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>