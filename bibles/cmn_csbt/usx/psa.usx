<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">詩篇</para>
  <para style="mt">詩篇</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">第一卷</para>
  <para style="mr">（<ref loc="PSA 1-41">詩篇1-41</ref>）</para>
  <para style="b" />
  <para style="s">兩條道路</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />這樣的人是多麼有福啊：</para>
  <para style="q1" vid="PSA 1:1">他不從惡人的計謀，</para>
  <para style="q1" vid="PSA 1:1">不站罪人的道路，</para>
  <para style="q1" vid="PSA 1:1">不坐譏諷者的座位！<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />他所喜悅的，就是耶和華的律法；</para>
  <para style="q1" vid="PSA 1:2">耶和華的律法，他晝思夜想。<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />他像一棵樹，栽種在溪水旁，</para>
  <para style="q1" vid="PSA 1:3">他的果實按時結出，</para>
  <para style="q1" vid="PSA 1:3">他的葉子也不凋零，</para>
  <para style="q1" vid="PSA 1:3">凡他所做的都會興盛。<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />惡人卻不是這樣，</para>
  <para style="q1" vid="PSA 1:4">而像糠秕，被風吹散。<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />因此，在審判的時候，惡人將站立不住；</para>
  <para style="q1" vid="PSA 1:5">在義人的集會中，罪人也是如此。<verse eid="PSA 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />是的，耶和華知道義人的道路，</para>
  <para style="q1" vid="PSA 1:6">惡人的道路卻必滅亡。<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">神的兒子作王</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />為什麼萬國悖逆，</para>
  <para style="q1" vid="PSA 2:1">萬民圖謀虛妄的事呢？<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />地上的君王們站出來，君主們一同商定，</para>
  <para style="q1" vid="PSA 2:2">敵對耶和華和他的受膏者，說：<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />「讓我們掙斷他們的捆綁，</para>
  <para style="q1" vid="PSA 2:3">把他們的繩索從我們身上甩掉！」<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />坐在天上的那一位會譏笑，</para>
  <para style="q1" vid="PSA 2:4">主會嘲笑他們。<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />那時他在怒氣中向他們說話，</para>
  <para style="q1" vid="PSA 2:5">在烈怒中使他們惶恐，說：<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />「我在<char style="pn">錫安</char>我的聖山上，膏立了我的王。」<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7" />我要宣講耶和華的諭旨：</para>
  <para style="q1" vid="PSA 2:7">他對我說：「你是我的兒子，我今日生了你。<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />你向我求，</para>
  <para style="q1" vid="PSA 2:8">我就賜列國為你的繼業，</para>
  <para style="q1" vid="PSA 2:8">賜地極為你的產業。<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />你將用鐵杖打破<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">打破——七十士譯本作「統治」。</char></note>他們，</para>
  <para style="q1" vid="PSA 2:9">把他們像陶匠的器皿那樣打碎。」<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />因此，君王們哪，你們當慎思明辨！</para>
  <para style="q1" vid="PSA 2:10">地上的審判官哪，你們當接受警誡！<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />你們當在敬畏中服事耶和華，</para>
  <para style="q1" vid="PSA 2:11">當在戰兢中快樂！<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />當親吻他的兒子，否則他一發怒，</para>
  <para style="q1" vid="PSA 2:12">你們就在所行的<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">在所行的——輔助詞語。</char></note>路上滅亡，</para>
  <para style="q1" vid="PSA 2:12">因為他的怒火片刻間就會燃起！</para>
  <para style="b" vid="PSA 2:12" />
  <para style="q1" vid="PSA 2:12">所有投靠他的人是多麼有福啊！<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s">救恩在於耶和華</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩。那時他逃避自己的兒子<char style="pn">押沙龍</char>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />耶和華啊，我的敵人何其多，</para>
  <para style="q1" vid="PSA 3:1">許多人起來攻擊我！<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />許多人論到我的靈魂說：</para>
  <para style="q1" vid="PSA 3:2">「他從神那裡得不到拯救。」<char style="qs">細拉</char><verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />可是你，耶和華啊，你是我四圍的盾牌，</para>
  <para style="q1" vid="PSA 3:3">是我的榮耀，是讓我揚起頭來的那一位！<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />我用我的聲音向耶和華呼求，</para>
  <para style="q1" vid="PSA 3:4">他就從他的聖山回應我。<char style="qs">細拉</char><verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />我躺下，我睡著，我醒來，</para>
  <para style="q1" vid="PSA 3:5">都因耶和華扶持我。<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />縱有萬千民眾四圍列陣攻擊我，我也不害怕。<verse eid="PSA 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />耶和華啊，求你起來！</para>
  <para style="q1" vid="PSA 3:7">我的神哪，求你拯救我！</para>
  <para style="q1" vid="PSA 3:7">是的，你擊打了我一切仇敵的臉頰，</para>
  <para style="q1" vid="PSA 3:7">打碎了惡人的牙。<verse eid="PSA 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />救恩在於耶和華！</para>
  <para style="q1" vid="PSA 3:8">願你的祝福臨到你的子民。<char style="qs">細拉</char><verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s">平安在於耶和華</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮，用弦樂器。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />顯我為義的神哪，</para>
  <para style="q1" vid="PSA 4:1">我呼求的時候，求你回應我！</para>
  <para style="q1" vid="PSA 4:1">你曾使我從困境中解脫；</para>
  <para style="q1" vid="PSA 4:1">求你恩待我，垂聽我的禱告！<verse eid="PSA 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />尊貴人哪，你們把我的榮耀變為羞辱，</para>
  <para style="q1" vid="PSA 4:2">要到什麼時候呢？</para>
  <para style="q1" vid="PSA 4:2">你們喜愛虛空、尋求謊言，</para>
  <para style="q1" vid="PSA 4:2">要到什麼時候呢？<char style="qs">細拉</char><verse eid="PSA 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />你們要知道：</para>
  <para style="q1" vid="PSA 4:3">耶和華已經把忠信的人分別出來歸於自己，</para>
  <para style="q1" vid="PSA 4:3">我向耶和華呼求的時候，他就垂聽。<verse eid="PSA 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />你們發怒<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">發怒——或譯作「顫抖」。</char></note>卻不可犯罪；</para>
  <para style="q1" vid="PSA 4:4">在床上的時候，要心裡默想，</para>
  <para style="q1" vid="PSA 4:4">並要安靜。<char style="qs">細拉</char><verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />你們當獻上公義的祭物，</para>
  <para style="q1" vid="PSA 4:5">當依靠耶和華。<verse eid="PSA 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />許多人說：「誰能讓我們看到好處呢？」</para>
  <para style="q1" vid="PSA 4:6">耶和華啊，求你用你的容光照耀我們！<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />你放在我心裡的喜樂，</para>
  <para style="q1" vid="PSA 4:7">勝過人們在豐收五穀和新酒時的喜樂。<verse eid="PSA 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />我必在平安中躺下並睡著；</para>
  <para style="q1" vid="PSA 4:8">因為唯獨你——耶和華啊，</para>
  <para style="q1" vid="PSA 4:8">你使我安然居住！<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s">義人的盾牌</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮，用管樂器。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />耶和華啊，求你傾聽我的言語，</para>
  <para style="q1" vid="PSA 5:1">顧念我的哀嘆！<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />我的王、我的神哪，求你留心聽我呼救的聲音，</para>
  <para style="q1" vid="PSA 5:2">因為我向你禱告！<verse eid="PSA 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />耶和華啊，</para>
  <para style="q1" vid="PSA 5:3">清晨你必聽我的聲音，</para>
  <para style="q1" vid="PSA 5:3">清晨我向你陳明心意<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">心意——輔助詞語。</char></note>，切切守望！<verse eid="PSA 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />因為你是不喜悅惡事的神，</para>
  <para style="q1" vid="PSA 5:4">罪惡不能與你同住。<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />狂傲的人不能站立在你眼前，</para>
  <para style="q1" vid="PSA 5:5">你憎恨所有作惡的人。<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />你必消滅說謊的人；</para>
  <para style="q1" vid="PSA 5:6">殺人流血的、行詭詐的，都為耶和華所憎惡。<verse eid="PSA 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />至於我，我要藉著你豐盛的慈愛，來到你的家；</para>
  <para style="q1" vid="PSA 5:7">因著對你的敬畏，向你的聖殿下拜。<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />耶和華啊，</para>
  <para style="q1" vid="PSA 5:8">求你因我仇敵的緣故，</para>
  <para style="q1" vid="PSA 5:8">藉著你的公義引導我，</para>
  <para style="q1" vid="PSA 5:8">在我面前修直你的道路！<verse eid="PSA 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />因為他們口中的話不可信，</para>
  <para style="q1" vid="PSA 5:9">他們裡面都是奸惡，</para>
  <para style="q1" vid="PSA 5:9">他們的喉嚨是敞開的墳墓，</para>
  <para style="q1" vid="PSA 5:9">他們用舌頭諂媚人。<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />神哪，求你使他們承擔罪責！</para>
  <para style="q1" vid="PSA 5:10">願他們因自己的計謀而跌倒；</para>
  <para style="q1" vid="PSA 5:10">求你因他們眾多的過犯驅趕他們，</para>
  <para style="q1" vid="PSA 5:10">因為他們悖逆了你。<verse eid="PSA 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />願所有投靠你的都歡喜，</para>
  <para style="q1" vid="PSA 5:11">永遠歡呼；</para>
  <para style="q1" vid="PSA 5:11">願你庇護他們，</para>
  <para style="q1" vid="PSA 5:11">讓那些愛你名的人因你歡慶；<verse eid="PSA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />耶和華啊，因為你必祝福義人，</para>
  <para style="q1" vid="PSA 5:12">你用恩典如盾牌圍繞他！<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s">求憐憫的禱告</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮，用弦樂器，用「第八」曲調<note caller="+" style="f"><char style="fr" closed="false">6:0 </char><char style="ft" closed="false">用「第八」曲調——或譯作「調用謝米尼特」。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />耶和華啊，求你不要在你的怒氣中責備我，</para>
  <para style="q1" vid="PSA 6:1">不要在你的怒火中管教我！<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />耶和華啊，求你恩待我，因為我軟弱！</para>
  <para style="q1" vid="PSA 6:2">耶和華啊，求你醫治我，因為我的骨頭顫栗！<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />我的靈魂也大大顫栗；</para>
  <para style="q1" vid="PSA 6:3">耶和華啊，你要等到什麼時候呢？<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />耶和華啊！求你轉回，</para>
  <para style="q1" vid="PSA 6:4">搭救我的靈魂；</para>
  <para style="q1" vid="PSA 6:4">求你因你慈愛的緣故拯救我；<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />因為在死地沒有人記念你，</para>
  <para style="q1" vid="PSA 6:5">在陰間有誰會稱謝你呢？<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />我因嘆息而疲憊；</para>
  <para style="q1" vid="PSA 6:6">每個夜晚，我的眼淚使我的床榻漂浮，</para>
  <para style="q1" vid="PSA 6:6">使我的床鋪浸透。<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />我的眼睛因煩惱而枯乾，</para>
  <para style="q1" vid="PSA 6:7">因一切的敵人而衰竭。<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />你們所有作惡的人，遠離我吧！</para>
  <para style="q1" vid="PSA 6:8">因為耶和華垂聽了我哀哭的聲音。<verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />耶和華垂聽了我的懇求，</para>
  <para style="q1" vid="PSA 6:9">耶和華必接受我的禱告。<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />我一切的仇敵都必蒙羞，大大顫栗；</para>
  <para style="q1" vid="PSA 6:10">他們必後退，瞬間蒙羞。<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s">求公義的禱告</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的流離歌<note caller="+" style="f"><char style="fr" closed="false">7:0 </char><char style="ft" closed="false">流離歌——音譯作「希加永」。</char></note>，他因<char style="pn">便雅憫</char>人<char style="pn">庫實</char>的話，向耶和華所唱的。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1" />耶和華我的神哪，我投靠了你！</para>
  <para style="q1" vid="PSA 7:1">求你拯救我脫離一切追趕我的人，</para>
  <para style="q1" vid="PSA 7:1">求你解救我，<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />免得他們像獅子那樣撕裂我，撕碎我，</para>
  <para style="q1" vid="PSA 7:2">也沒有人解救。<verse eid="PSA 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3" />耶和華我的神哪，</para>
  <para style="q1" vid="PSA 7:3">如果我做了這事，</para>
  <para style="q1" vid="PSA 7:3">如果我的手中有不義，<verse eid="PSA 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4" />如果我惡待那與我和好的人，</para>
  <para style="q1" vid="PSA 7:4">或是無故掠奪我的敵人，<verse eid="PSA 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />就任憑仇敵追趕我，並且追上！</para>
  <para style="q1" vid="PSA 7:5">任憑他把我的性命踩踏於地，</para>
  <para style="q1" vid="PSA 7:5">使我的榮耀歸入塵土！<char style="qs">細拉</char><verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />耶和華啊，求你在怒氣中起來！</para>
  <para style="q1" vid="PSA 7:6">求你挺身而起對抗我敵人的盛怒，</para>
  <para style="q1" vid="PSA 7:6">求你為我醒來！</para>
  <para style="q1" vid="PSA 7:6">你已經下令施行審判。<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />願萬民會眾環繞你，</para>
  <para style="q1" vid="PSA 7:7">願你歸回高處，在萬民之上。<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />願耶和華審斷萬民；</para>
  <para style="q1" vid="PSA 7:8">耶和華啊，求你照著我的公義、</para>
  <para style="q1" vid="PSA 7:8">照著我裡面的純全判斷我！<verse eid="PSA 7:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />願惡人的惡斷絕，</para>
  <para style="q1" vid="PSA 7:9">願你使義人堅立！</para>
  <para style="q1" vid="PSA 7:9">公義的神哪，</para>
  <para style="q1" vid="PSA 7:9">你是察驗人心思和肺腑的。<verse eid="PSA 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />神是我的盾牌，</para>
  <para style="q1" vid="PSA 7:10">他是心裡正直人的拯救者。<verse eid="PSA 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />神是公義的審判者，</para>
  <para style="q1" vid="PSA 7:11">是天天對惡人<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">對惡人——輔助詞語。</char></note>惱怒的神。<verse eid="PSA 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />如果人不悔改，</para>
  <para style="q1" vid="PSA 7:12">神就把自己的刀劍磨利，</para>
  <para style="q1" vid="PSA 7:12">並拉開弓瞄準；<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />他預備了致命的武器，</para>
  <para style="q1" vid="PSA 7:13">做好了燃燒的箭矢。<verse eid="PSA 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />看哪，惡人孕育壞事，</para>
  <para style="q1" vid="PSA 7:14">懷上禍患，生下虛假。<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />他挖了坑，挖得很深，</para>
  <para style="q1" vid="PSA 7:15">自己卻掉進所挖的深坑裡。<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />他的禍患將歸到自己頭上，</para>
  <para style="q1" vid="PSA 7:16">他的殘暴將落在自己的頭頂。<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />我要照著耶和華的公義稱謝他，</para>
  <para style="q1" vid="PSA 7:17">歌頌耶和華至高者的名。<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s">神的榮耀和人的尊貴</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮，用「搾酒」曲調<note caller="+" style="f"><char style="fr" closed="false">8:0 </char><char style="ft" closed="false">「榨酒」曲調——或譯作「『迦特』樂器」或「『迦特』曲調」。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />耶和華我們的主啊，</para>
  <para style="q1" vid="PSA 8:1">你的名在全地多麼尊貴，</para>
  <para style="q1" vid="PSA 8:1">你把你的尊榮彰顯在諸天之上！<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />你因敵人的緣故，</para>
  <para style="q1" vid="PSA 8:2">從幼童和吃奶的嬰兒口中，建立了能力，</para>
  <para style="q1" vid="PSA 8:2">使仇敵和報復者啞口無言。<verse eid="PSA 8:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />我觀看你手指所造的天，</para>
  <para style="q1" vid="PSA 8:3">並你所安設的月亮和星辰，<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />啊，人算什麼，你竟顧念他！</para>
  <para style="q1" vid="PSA 8:4">世人算什麼，你竟眷顧他！<verse eid="PSA 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />你使他比神<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">神——或譯作「天使」。</char></note>低微一點，</para>
  <para style="q1" vid="PSA 8:5">賜給他榮耀威嚴為冠冕。<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />你讓他管轄你手所造的，</para>
  <para style="q1" vid="PSA 8:6">把萬有都放在他的腳下，<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />就是所有的羊群、牛群、</para>
  <para style="q1" vid="PSA 8:7">田野的走獸、<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />天空的鳥、海裡的魚，</para>
  <para style="q1" vid="PSA 8:8">以及所有游在海中之路的。<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />耶和華我們的主啊，</para>
  <para style="q1" vid="PSA 8:9">你的名在全地多麼尊貴！<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s">歌頌神公義的審判</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮，用「穆拉本<note caller="+" style="f"><char style="fr" closed="false">9:0 </char><char style="ft" closed="false">穆拉本——或譯作「兒子之死」。</char></note>」曲調。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1" />我要全心稱謝耶和華，</para>
  <para style="q1" vid="PSA 9:1">講述你一切的奇妙作為。<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />我要因你歡喜、歡慶；</para>
  <para style="q1" vid="PSA 9:2">至高者啊，我要歌頌你的名！<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />我的仇敵轉身退後的時候，</para>
  <para style="q1" vid="PSA 9:3">就在你面前絆倒、滅亡；<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />因你為我施行公正、執行判決；</para>
  <para style="q1" vid="PSA 9:4">你坐在寶座上施行公義的審判。<verse eid="PSA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />你斥責了列國，消滅了惡人，</para>
  <para style="q1" vid="PSA 9:5">抹掉了他們的名號，直到永永遠遠。<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />仇敵被滅盡，敵國成為永久的廢墟；</para>
  <para style="q1" vid="PSA 9:6">你把他們的城鎮拔出，連他們的名號也消亡了。<verse eid="PSA 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />耶和華卻永遠坐著為王，</para>
  <para style="q1" vid="PSA 9:7">他早已為審判設立了寶座。<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />是他以公義審判世界，</para>
  <para style="q1" vid="PSA 9:8">以正直審斷萬民。<verse eid="PSA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />耶和華是受壓迫之人的庇護所，</para>
  <para style="q1" vid="PSA 9:9">是災荒之時的庇護所。<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />耶和華啊，認識你名的人都要依靠你，</para>
  <para style="q1" vid="PSA 9:10">因為你沒有離棄尋求你的人！<verse eid="PSA 9:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />你們當歌頌在<char style="pn">錫安</char>坐著為王<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">在錫安坐著為王——或譯作「住在錫安」。</char></note>的耶和華，</para>
  <para style="q1" vid="PSA 9:11">當在萬民中宣告他的作為；<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />因為追討血債的那一位會記念他們，</para>
  <para style="q1" vid="PSA 9:12">不會忘記卑微人的呼聲。<verse eid="PSA 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />耶和華啊，求你恩待我！</para>
  <para style="q1" vid="PSA 9:13">願你看到那些恨我的人加給我的苦難，</para>
  <para style="q1" vid="PSA 9:13">求你把我從死門中拉上來，<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />好讓我在女子<char style="pn">錫安</char><note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">女子錫安——或譯作「錫安城」。</char></note>的城門，</para>
  <para style="q1" vid="PSA 9:14">述說你當受的一切讚美，</para>
  <para style="q1" vid="PSA 9:14">因你的救恩而歡樂。<verse eid="PSA 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />列國陷入自己所挖的深坑裡，</para>
  <para style="q1" vid="PSA 9:15">他們的腳被自己暗設的網羅纏住。<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />耶和華顯明自己，施行公正；</para>
  <para style="q1" vid="PSA 9:16">惡人因自己手所做的陷入圈套。<char style="qs">希加永　細拉</char><verse eid="PSA 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />惡人將歸到陰間，</para>
  <para style="q1" vid="PSA 9:17">所有忘記神的國家也是如此。<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />是的，貧窮人不會被永久忘記，</para>
  <para style="q1" vid="PSA 9:18">困苦人的希望不會永遠消亡。<verse eid="PSA 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />耶和華啊，求你起來！</para>
  <para style="q1" vid="PSA 9:19">不要讓世人得勝，</para>
  <para style="q1" vid="PSA 9:19">願列國在你面前受審判。<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />耶和華啊，求你使他們畏懼！</para>
  <para style="q1" vid="PSA 9:20">願列國的人都明白自己不過是人。<char style="qs">細拉</char><verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s">求神追究惡人</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />耶和華啊，你為什麼站在遠處，</para>
  <para style="q1" vid="PSA 10:1">在災難之時隱藏呢？<verse eid="PSA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />惡人狂傲地追逼困苦人，</para>
  <para style="q1" vid="PSA 10:2">願他們被自己謀劃的詭計抓住！<verse eid="PSA 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />因為惡人以自己心中的欲望自誇；</para>
  <para style="q1" vid="PSA 10:3">貪婪的人詛咒並藐視耶和華<note caller="+" style="f"><char style="fr" closed="false">10:3 </char><char style="ft" closed="false">貪婪的人詛咒並藐視耶和華——或譯作「他祝福貪婪的人，卻藐視耶和華」。</char></note>。<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />惡人面帶高傲，不尋求耶和華；</para>
  <para style="q1" vid="PSA 10:4">他所有的心思中都沒有神。<verse eid="PSA 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />他的道路時常亨通，</para>
  <para style="q1" vid="PSA 10:5">然而你的審判在至高處，超過他的眼界；</para>
  <para style="q1" vid="PSA 10:5">他對所有的敵人都嗤之以鼻。<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />他心裡說：「我必不動搖，</para>
  <para style="q1" vid="PSA 10:6">世世代代不遭惡事。」<verse eid="PSA 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />他滿口都在詛咒、欺詐、欺壓，</para>
  <para style="q1" vid="PSA 10:7">舌頭底下滿是禍患和壞事。<verse eid="PSA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />他在村莊的陰暗處蹲伏，</para>
  <para style="q1" vid="PSA 10:8">在隱祕處殺害無辜的人，</para>
  <para style="q1" vid="PSA 10:8">他的眼目窺伺無助的人。<verse eid="PSA 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9" />他埋伏在隱祕處，</para>
  <para style="q1" vid="PSA 10:9">如同洞穴中的獅子。</para>
  <para style="q1" vid="PSA 10:9">他埋伏要擄走困苦人；</para>
  <para style="q1" vid="PSA 10:9">他把困苦人拉入自己的網羅，擄走他們。<verse eid="PSA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />他屈身伏擊，</para>
  <para style="q1" vid="PSA 10:10">無助之人就倒在他的強勢之下。<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false">此節或譯作：無助之人被壓垮，低頭屈服，倒在他的強勢下。</char></note><verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />他心裡說：「神已經忘記了！</para>
  <para style="q1" vid="PSA 10:11">神隱藏了他的臉，永遠不看。」<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />耶和華啊，求你起來！</para>
  <para style="q1" vid="PSA 10:12">神哪，求你舉起你的手，</para>
  <para style="q1" vid="PSA 10:12">不要忘記卑微人！<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />惡人為什麼藐視神，</para>
  <para style="q1" vid="PSA 10:13">為什麼心裡說「你不會追討」呢？<verse eid="PSA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />其實你已經看見，</para>
  <para style="q1" vid="PSA 10:14">你顧念人的禍患和煩惱，</para>
  <para style="q1" vid="PSA 10:14">把它們放在你的手中。</para>
  <para style="q1" vid="PSA 10:14">無助之人把自己交託給你，</para>
  <para style="q1" vid="PSA 10:14">你一向是孤兒的幫助者。<verse eid="PSA 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />求你打斷惡人的膀臂；</para>
  <para style="q1" vid="PSA 10:15">至於壞人，求你追討他的邪惡，</para>
  <para style="q1" vid="PSA 10:15">直到淨盡！<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />耶和華永永遠遠是王，</para>
  <para style="q1" vid="PSA 10:16">列國都要從他的地上滅亡。<verse eid="PSA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />耶和華啊，你垂聽了卑微人的願望！</para>
  <para style="q1" vid="PSA 10:17">你使他們的心堅定；</para>
  <para style="q1" vid="PSA 10:17">你側耳傾聽，<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />要為孤兒和被壓迫的人伸冤，</para>
  <para style="q1" vid="PSA 10:18">使地上的人絕不再恐嚇他們。<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s">投靠公義的神</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">11:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />我投靠了耶和華，</para>
  <para style="q1" vid="PSA 11:1">你們怎麼對我說</para>
  <para style="q1" vid="PSA 11:1">「要像雀鳥那樣逃到你的山裡去」；<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />看哪，惡人拉開弓，</para>
  <para style="q1" vid="PSA 11:2">在弦上備好箭，</para>
  <para style="q1" vid="PSA 11:2">要在幽暗中射那心裡正直的人！<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />如果根基被毀，</para>
  <para style="q1" vid="PSA 11:3">義人還能做什麼呢？<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />耶和華在他的聖殿中，</para>
  <para style="q1" vid="PSA 11:4">耶和華在天上的寶座上，</para>
  <para style="q1" vid="PSA 11:4">他的眼睛觀看，他的眼目察驗世人。<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />耶和華察驗義人，</para>
  <para style="q1" vid="PSA 11:5">他的心憎恨惡人和那些喜愛殘暴的人<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">此節或譯作：耶和華察驗義人和惡人，他的心憎恨那些喜愛殘暴的人。</char></note>。<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />他必向惡人密布網羅<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="ft" closed="false">向惡人密布網羅——或譯作「使火炭落在惡人身上」。</char></note>，</para>
  <para style="q1" vid="PSA 11:6">火、硫磺、灼熱的風是他們杯中的份。<verse eid="PSA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />因為耶和華是公義的，他愛公義；</para>
  <para style="q1" vid="PSA 11:7">正直的人必見他的榮面。<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s">神護佑困苦人</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮，用「第八」曲調<note caller="+" style="f"><char style="fr" closed="false">12:0 </char><char style="ft" closed="false">用「第八」曲調——或譯作「調用謝米尼特」。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />耶和華啊，求你拯救！</para>
  <para style="q1" vid="PSA 12:1">因為忠信的人不存在了，</para>
  <para style="q1" vid="PSA 12:1">忠實的人從世人中消失了。<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />人人向鄰舍說謊，</para>
  <para style="q1" vid="PSA 12:2">他們說話油嘴滑舌，心懷二意。<verse eid="PSA 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />願耶和華剪除一切油滑的嘴唇</para>
  <para style="q1" vid="PSA 12:3">和說大話的舌頭！<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />他們說：「我們要靠舌頭得勝，</para>
  <para style="q1" vid="PSA 12:4">我們的嘴唇是自己的，</para>
  <para style="q1" vid="PSA 12:4">誰是我們的主呢？」<verse eid="PSA 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />耶和華說：「因為困苦人所受的迫害</para>
  <para style="q1" vid="PSA 12:5">和貧窮人的呻吟，</para>
  <para style="q1" vid="PSA 12:5">我現在要挺身而起，</para>
  <para style="q1" vid="PSA 12:5">把他們安置在他們渴望的安穩之地。」<verse eid="PSA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />耶和華的言語是純淨的言語，</para>
  <para style="q1" vid="PSA 12:6">如同銀子在地上的熔爐中</para>
  <para style="q1" vid="PSA 12:6">被熬煉、精煉過七次。<verse eid="PSA 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />耶和華啊，你必保守他們<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">他們——有古抄本和古譯本作「我們」。</char></note>，</para>
  <para style="q1" vid="PSA 12:7">守護他們<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">他們——原文直譯「我們」；另有古抄本和古譯本作「他」。</char></note>永遠脫離這世代！<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />卑劣的事在世人中受尊崇時，</para>
  <para style="q1" vid="PSA 12:8">惡人就四處橫行。<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s">求神看顧</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />耶和華啊，你要等到什麼時候呢？</para>
  <para style="q1" vid="PSA 13:1">你要永久忘記我嗎？</para>
  <para style="q1" vid="PSA 13:1">你向我隱藏你的臉，</para>
  <para style="q1" vid="PSA 13:1">要到什麼時候呢？<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />我靈裡滿是思慮、心裡終日悲哀，</para>
  <para style="q1" vid="PSA 13:2">要到什麼時候呢？</para>
  <para style="q1" vid="PSA 13:2">我的仇敵高高在我之上，</para>
  <para style="q1" vid="PSA 13:2">要到什麼時候呢？<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />耶和華我的神哪，</para>
  <para style="q1" vid="PSA 13:3">求你看顧我、回應我！</para>
  <para style="q1" vid="PSA 13:3">求你使我的眼目明亮，</para>
  <para style="q1" vid="PSA 13:3">免得我沉睡至死；<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />免得我的仇敵說「我勝過了他」；</para>
  <para style="q1" vid="PSA 13:4">免得我的敵人在我動搖時快樂。<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />至於我，我依靠你的慈愛，</para>
  <para style="q1" vid="PSA 13:5">我的心要因你的救恩而快樂。<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />我要向耶和華歌唱，</para>
  <para style="q1" vid="PSA 13:6">因他厚厚地恩待我。<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s">愚頑人的罪惡</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">14:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />愚頑人心裡說：「沒有神！」</para>
  <para style="q1" vid="PSA 14:1">他們都敗壞，行為可憎；</para>
  <para style="q1" vid="PSA 14:1">沒有人行善。<verse eid="PSA 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />耶和華從天上俯看世人，</para>
  <para style="q1" vid="PSA 14:2">要看是否有明達人，是否有尋求神的人。<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />所有的人都偏離正道<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">正道——輔助詞語。</char></note>，他們一同墮落；</para>
  <para style="q1" vid="PSA 14:3">沒有行善的，連一個也沒有！<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />難道作惡的人都不明白嗎？</para>
  <para style="q1" vid="PSA 14:4">他們吞噬我的子民像吃飯那樣，</para>
  <para style="q1" vid="PSA 14:4">他們不呼求耶和華。<verse eid="PSA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />然而，他們會大大恐懼，</para>
  <para style="q1" vid="PSA 14:5">因為神與那世代的義人同在。<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />你們惡人使困苦人的籌算蒙羞，</para>
  <para style="q1" vid="PSA 14:6">但耶和華是他的避難所。<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />但願<char style="pn">以色列</char>的救恩來自<char style="pn">錫安</char>！</para>
  <para style="q1" vid="PSA 14:7">耶和華使他流亡的子民回歸<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">使他流亡的子民回歸——或譯作「復興他子民的家業」。</char></note>時，</para>
  <para style="q1" vid="PSA 14:7">願<char style="pn">雅各</char>快樂，願<char style="pn">以色列</char>歡喜！<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s">居住聖山的人</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />耶和華啊，誰能居住在你的帳篷中呢？</para>
  <para style="q1" vid="PSA 15:1">誰能安居在你的聖山上呢？<verse eid="PSA 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />就是那行事純全、實行公義、</para>
  <para style="q1" vid="PSA 15:2">內心說誠實話的人。<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />他不用舌頭誹謗人，</para>
  <para style="q1" vid="PSA 15:3">不對鄰人做惡事，</para>
  <para style="q1" vid="PSA 15:3">也不辱罵自己的親人。<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />他眼中輕視被神<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">神——輔助詞語。</char></note>所厭棄的人，</para>
  <para style="q1" vid="PSA 15:4">卻尊重敬畏耶和華的人；</para>
  <para style="q1" vid="PSA 15:4">他起了誓，就算自己吃虧也不反悔。<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />他不放債取利，</para>
  <para style="q1" vid="PSA 15:5">也不收取賄賂害無辜的人。</para>
  <para style="q1" vid="PSA 15:5">行這些事的人將永不動搖！<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s">好處不在神以外</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的金詩<note caller="+" style="f"><char style="fr" closed="false">16:0 </char><char style="ft" closed="false">金詩——或譯作「米克塔姆詩」。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />神哪，求你保守我，</para>
  <para style="q1" vid="PSA 16:1">因為我投靠了你！<verse eid="PSA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />我<note caller="+" style="f"><char style="fr" closed="false">16:2 </char><char style="ft" closed="false">我——有古抄本和古譯本作「你」。</char></note>對耶和華說：「你是我的主；</para>
  <para style="q1" vid="PSA 16:2">我的好處不在你以外。」<verse eid="PSA 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />至於這地上的聖民，他們都是尊貴的，</para>
  <para style="q1" vid="PSA 16:3">是我全部的喜樂。<verse eid="PSA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />那些追求別的神明<note caller="+" style="f"><char style="fr" closed="false">16:4 </char><char style="ft" closed="false">神明——輔助詞語。</char></note>的，他們的愁苦必增加；</para>
  <para style="q1" vid="PSA 16:4">他們獻的血祭，我不澆奠；</para>
  <para style="q1" vid="PSA 16:4">我的嘴唇也不提別的神明的名號。<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />耶和華是我繼業的份、我的杯；</para>
  <para style="q1" vid="PSA 16:5">是你掌握我的命運<note caller="+" style="f"><char style="fr" closed="false">16:5 </char><char style="ft" closed="false">命運——原文直譯「籤」。</char></note>！<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />你為我劃界的<note caller="+" style="f"><char style="fr" closed="false">16:6 </char><char style="ft" closed="false">劃界的——輔助詞語。</char></note>量繩落在美福之地，</para>
  <para style="q1" vid="PSA 16:6">我的繼業實在美好！<verse eid="PSA 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />我要頌讚那指教我的耶和華；</para>
  <para style="q1" vid="PSA 16:7">夜間我的肺腑也警誡我。<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />我總是以耶和華為念<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">我總是以耶和華為念——原文直譯「我總是把耶和華擺在我面前」。</char></note>；</para>
  <para style="q1" vid="PSA 16:8">因為他在我的右邊，我就不致動搖。<verse eid="PSA 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />因此我的心歡喜，我的靈<note caller="+" style="f"><char style="fr" closed="false">16:9 </char><char style="ft" closed="false">靈——原文直譯「榮耀」。</char></note>快樂，</para>
  <para style="q1" vid="PSA 16:9">我的肉體也安然居住；<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />因為你不會把我的靈魂撇棄在陰間，</para>
  <para style="q1" vid="PSA 16:10">也不會讓你的聖者經歷腐朽<note caller="+" style="f"><char style="fr" closed="false">16:10 </char><char style="ft" closed="false">經歷腐朽——或譯作「見陰坑」。</char></note>。<verse eid="PSA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />你使我明白生命的路途；</para>
  <para style="q1" vid="PSA 16:11">在你面前有滿足的喜樂，</para>
  <para style="q1" vid="PSA 16:11">在你的右手中有永久的美福。<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s">求主保守無辜的人</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的禱告。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />耶和華啊，求你垂聽我公義的呼聲，</para>
  <para style="q1" vid="PSA 17:1">留心聽我的呼求！</para>
  <para style="q1" vid="PSA 17:1">求你傾聽我的禱告，</para>
  <para style="q1" vid="PSA 17:1">因它不出自欺詐的嘴唇。<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />願我應得的公正從你面前發出，</para>
  <para style="q1" vid="PSA 17:2">願你的眼睛察看公平。<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />你察驗了我的心，你在夜間鑒察我；</para>
  <para style="q1" vid="PSA 17:3">你熬煉了我，沒有找到什麼過犯<note caller="+" style="f"><char style="fr" closed="false">17:3 </char><char style="ft" closed="false">什麼過犯——輔助詞語。</char></note>；</para>
  <para style="q1" vid="PSA 17:3">我決意不讓我的口有過失。<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />論到人的行為，</para>
  <para style="q1" vid="PSA 17:4">我藉著你嘴上的話語，</para>
  <para style="q1" vid="PSA 17:4">保守自己不走凶惡者的路。<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />我的步履踏在你的路徑上，</para>
  <para style="q1" vid="PSA 17:5">我的雙腳沒有動搖。<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />神哪，我呼求你，因為你必回應我；</para>
  <para style="q1" vid="PSA 17:6">求你向我側耳聽，垂聽我的言語！<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />求你奇妙地顯明你的慈愛；</para>
  <para style="q1" vid="PSA 17:7">拯救者啊，你用右手使投靠你的人脫離那起來的敵對者！<verse eid="PSA 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />求你保守我，如同保守眼中的瞳人，</para>
  <para style="q1" vid="PSA 17:8">把我隱藏在你翅膀的蔭庇下，<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />使我脫離那些要摧毀我的惡人，</para>
  <para style="q1" vid="PSA 17:9">就是那些包圍我的死敵。<verse eid="PSA 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />他們麻木的心<note caller="+" style="f"><char style="fr" closed="false">17:10 </char><char style="ft" closed="false">他們麻木的心——原文直譯「他們的脂油」。</char></note>封閉了，</para>
  <para style="q1" vid="PSA 17:10">他們的口說話高傲。<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />他們跟蹤了我們，現在把我們圍困了<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="ft" closed="false">他們跟蹤了我們，現在把我們圍困了——或譯作「他們圍困了我們的腳蹤」。</char></note>；</para>
  <para style="q1" vid="PSA 17:11">他們瞪著眼睛，要把我們推倒在地。<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />他們像急於撕碎獵物<note caller="+" style="f"><char style="fr" closed="false">17:12 </char><char style="ft" closed="false">獵物——輔助詞語。</char></note>的獅子，</para>
  <para style="q1" vid="PSA 17:12">又像蹲伏在隱祕處的少壯獅子。<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />耶和華啊，求你起來，</para>
  <para style="q1" vid="PSA 17:13">迎面抵擋他們，使他們屈服！</para>
  <para style="q1" vid="PSA 17:13">求你用你的刀劍，挽救我的性命脫離惡人！<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />耶和華啊，求你用手使我脫離世人——</para>
  <para style="q1" vid="PSA 17:14">他們只在今生有份：</para>
  <para style="q1" vid="PSA 17:14">你用你所儲藏的填滿他們的肚腹；</para>
  <para style="q1" vid="PSA 17:14">他們也因有兒女而滿足<note caller="+" style="f"><char style="fr" closed="false">17:14 </char><char style="ft" closed="false">他們也因有兒女而滿足——或譯作「他們的兒女也會滿足」。</char></note>，</para>
  <para style="q1" vid="PSA 17:14">還把剩餘的留給他們的幼童。<verse eid="PSA 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />至於我，我要在公義中見你的面；</para>
  <para style="q1" vid="PSA 17:15">當我醒來時，就因你的形象而滿足。<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s">神是我的力量和磐石</para>
  <para style="b" />
  <para style="d">耶和華的僕人<char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">18:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>，給樂隊指揮。在耶和華解救他脫離一切仇敵和<char style="pn">掃羅</char>之手的日子，他向耶和華吟誦了這首歌的歌詞。他說：</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />耶和華我的力量啊，</para>
  <para style="q1" vid="PSA 18:1">我深愛你！<verse eid="PSA 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />耶和華是我的岩石、我的要塞、我的救主。</para>
  <para style="q1" vid="PSA 18:2">我的神是我的磐石，是我所投靠的！</para>
  <para style="q1" vid="PSA 18:2">他是我的盾牌、我救恩的角、我的庇護所。<verse eid="PSA 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />我呼求那當受讚美的耶和華，</para>
  <para style="q1" vid="PSA 18:3">我就蒙拯救，脫離仇敵。<verse eid="PSA 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />死亡的繩索纏繞我，</para>
  <para style="q1" vid="PSA 18:4">險惡的急流驚擾我；<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />陰間的繩索圍繞我，</para>
  <para style="q1" vid="PSA 18:5">死亡的陷阱迎向我。<verse eid="PSA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />我在危難中呼求耶和華，</para>
  <para style="q1" vid="PSA 18:6">我向我的神呼救，</para>
  <para style="q1" vid="PSA 18:6">他從他的聖殿中垂聽了我的聲音，</para>
  <para style="q1" vid="PSA 18:6">我在他面前的呼救進入他的耳中。<verse eid="PSA 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />那時大地搖撼、震動，</para>
  <para style="q1" vid="PSA 18:7">群山的根基也顫抖、搖撼，</para>
  <para style="q1" vid="PSA 18:7">因為他發怒了。<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />濃煙從他的鼻孔上騰，</para>
  <para style="q1" vid="PSA 18:8">烈火從他口中出來吞噬，</para>
  <para style="q1" vid="PSA 18:8">火炭也從他那裡燃起。<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />他又使諸天下垂，親自降臨；</para>
  <para style="q1" vid="PSA 18:9">他的腳下是幽深的黑暗。<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />他乘駕基路伯飛翔，</para>
  <para style="q1" vid="PSA 18:10">在風的翅膀上翱翔。<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />他以黑暗作他的藏身處，</para>
  <para style="q1" vid="PSA 18:11">以眾水的黑暗、天空的烏雲作他四周的帷幕。<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />冰雹和火炭從他面前的光輝中而出，</para>
  <para style="q1" vid="PSA 18:12">穿過了烏雲。<note caller="+" style="f"><char style="fr" closed="false">18:12 </char><char style="ft" closed="false">此節或譯作：烏雲、冰雹與火炭，從他面前的光輝經過。</char></note><verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />耶和華在天上打雷，</para>
  <para style="q1" vid="PSA 18:13">至高者發出聲音，降下冰雹和火炭；<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />他發出箭矢，使仇敵四散，</para>
  <para style="q1" vid="PSA 18:14">發出眾多閃電，使他們潰亂。<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />耶和華啊，</para>
  <para style="q1" vid="PSA 18:15">你斥責一發，你鼻孔的氣一出，</para>
  <para style="q1" vid="PSA 18:15">海<note caller="+" style="f"><char style="fr" closed="false">18:15 </char><char style="ft" closed="false">海——原文直譯「眾水」。</char></note>底就出現，世界的根基也顯露。<verse eid="PSA 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />他從高處伸手抓住我，</para>
  <para style="q1" vid="PSA 18:16">把我從大水中拉上來；<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />他解救我脫離凶猛的仇敵，</para>
  <para style="q1" vid="PSA 18:17">脫離恨我的人，</para>
  <para style="q1" vid="PSA 18:17">因為他們比我強大。<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />在我遭難的日子裡，他們攻擊我，</para>
  <para style="q1" vid="PSA 18:18">但耶和華是我的依靠。<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />他把我領到寬闊之地；</para>
  <para style="q1" vid="PSA 18:19">他搭救了我，因為他喜悅我。<verse eid="PSA 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />耶和華照著我的公義恩待我，</para>
  <para style="q1" vid="PSA 18:20">照著我手中的清潔回報我；<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />因為我謹守耶和華的道路，</para>
  <para style="q1" vid="PSA 18:21">沒有作惡離開我的神；<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />他一切的法規都在我面前，</para>
  <para style="q1" vid="PSA 18:22">我沒有讓他的律例遠離我。<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />我在他面前是純全的，</para>
  <para style="q1" vid="PSA 18:23">我謹守自己遠離我的罪孽。<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />所以耶和華照著我的公義，</para>
  <para style="q1" vid="PSA 18:24">在他眼前照著我手中的清潔回報我。<verse eid="PSA 18:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />對忠信的人，你顯出信實；</para>
  <para style="q1" vid="PSA 18:25">對純全的人，你顯出純全；<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />對純潔的人，你顯出純潔；</para>
  <para style="q1" vid="PSA 18:26">對悖謬的人，你還以其道<note caller="+" style="f"><char style="fr" closed="false">18:26 </char><char style="ft" closed="false">還以其道——原文直譯「顯出精明 」。</char></note>；<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />你拯救卑微的百姓，</para>
  <para style="q1" vid="PSA 18:27">卻使高傲的眼目降卑；<verse eid="PSA 18:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />你使我的燈發出亮光，</para>
  <para style="q1" vid="PSA 18:28">耶和華我的神照亮我的黑暗。<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />是的，藉著你，我衝向敵軍<note caller="+" style="f"><char style="fr" closed="false">18:29 </char><char style="ft" closed="false">沖向敵軍——或譯作「攻破壁壘」。</char></note>；</para>
  <para style="q1" vid="PSA 18:29">藉著我的神，我躍過牆垣。<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />這位神，他的道路是純全的，</para>
  <para style="q1" vid="PSA 18:30">耶和華的言語是精煉的，</para>
  <para style="q1" vid="PSA 18:30">他是所有投靠他之人的盾牌。<verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />除了耶和華，誰是神呢？</para>
  <para style="q1" vid="PSA 18:31">除了我們的神，誰是磐石呢？<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />這位神，他以能力裝備我，</para>
  <para style="q1" vid="PSA 18:32">他使我的道路純全。<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />他使我的腳快<note caller="+" style="f"><char style="fr" closed="false">18:33 </char><char style="ft" closed="false">快——輔助詞語。</char></note>如母鹿的腳，</para>
  <para style="q1" vid="PSA 18:33">又使我穩立在高處。<verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />他訓練我的手作戰，</para>
  <para style="q1" vid="PSA 18:34">使我的膀臂能拉開銅弓。<verse eid="PSA 18:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />你把你救恩的盾牌賜給我，</para>
  <para style="q1" vid="PSA 18:35">你的右手扶持我，</para>
  <para style="q1" vid="PSA 18:35">你的謙卑<note caller="+" style="f"><char style="fr" closed="false">18:35 </char><char style="ft" closed="false">謙卑——或譯作「溫柔」。</char></note>使我為大。<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />你使我腳下的路寬闊<note caller="+" style="f"><char style="fr" closed="false">18:36 </char><char style="ft" closed="false">腳下的路寬闊——或譯作「邁大腳步」。</char></note>，</para>
  <para style="q1" vid="PSA 18:36">我的腳踝也不顫抖。<verse eid="PSA 18:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />我追趕我的仇敵，並要追上他們；</para>
  <para style="q1" vid="PSA 18:37">不滅絕他們，我絕不返回。<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />我擊碎他們，使他們不能起來；</para>
  <para style="q1" vid="PSA 18:38">他們都仆倒在我的腳下。<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />你以能力裝備我作戰，</para>
  <para style="q1" vid="PSA 18:39">又使起來敵對我的人屈服在我之下。<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />你使我的仇敵在我面前轉身而逃，</para>
  <para style="q1" vid="PSA 18:40">我把那些恨我的人除盡。<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />他們呼救，卻沒有人拯救；</para>
  <para style="q1" vid="PSA 18:41">他們向耶和華呼救，他也不回應。<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />我搗碎他們，如同風前的塵土；</para>
  <para style="q1" vid="PSA 18:42">我倒出他們，如同街上的爛泥。<verse eid="PSA 18:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />你救我脫離民眾的紛爭，</para>
  <para style="q1" vid="PSA 18:43">立我作列國之首，</para>
  <para style="q1" vid="PSA 18:43">連我不認識的民也服事我。<verse eid="PSA 18:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44" />他們風聞了我，就順從我；</para>
  <para style="q1" vid="PSA 18:44">外邦人向我卑躬屈膝。<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />外邦人聞風喪膽，</para>
  <para style="q1" vid="PSA 18:45">戰戰兢兢地從他們的營寨中出來。<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />耶和華永遠活著！</para>
  <para style="q1" vid="PSA 18:46">我的磐石是當受頌讚的！</para>
  <para style="q1" vid="PSA 18:46">願拯救我的神受尊崇！<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />這位神，他是為我報仇的那一位，</para>
  <para style="q1" vid="PSA 18:47">他使萬民降服在我之下。<verse eid="PSA 18:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48" />你救我脫離我的仇敵；</para>
  <para style="q1" vid="PSA 18:48">是的，你舉起我高過那些起來敵對我的人，</para>
  <para style="q1" vid="PSA 18:48">你又解救我脫離殘暴的人。<verse eid="PSA 18:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />因此我要在列國中稱謝你，</para>
  <para style="q1" vid="PSA 18:49">耶和華啊，我要歌頌你的名！<verse eid="PSA 18:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />耶和華賜偉大的救恩給他所立的王，</para>
  <para style="q1" vid="PSA 18:50">施慈愛給他的受膏者，就是<char style="pn">大衛</char>和他的後裔，</para>
  <para style="q1" vid="PSA 18:50">直到永遠。<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s">神的創造與律法</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />諸天述說神的榮耀，</para>
  <para style="q1" vid="PSA 19:1">穹蒼宣告他手的作為。<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />這日到那日湧出言語，</para>
  <para style="q1" vid="PSA 19:2">這夜到那夜陳述知識。<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />無言無語，無聲無息。<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />但它們的聲音傳遍全地，</para>
  <para style="q1" vid="PSA 19:4">它們的言語傳到地極。</para>
  <para style="q1" vid="PSA 19:4">神在它們中間為太陽安設帳篷，<verse eid="PSA 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5" />太陽如同新郎出洞房，</para>
  <para style="q1" vid="PSA 19:5">又如勇士歡然奔路。<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />它從天這邊出來，繞到天的那邊，</para>
  <para style="q1" vid="PSA 19:6">沒有什麼能在它的熱氣面前隱藏。<verse eid="PSA 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />耶和華的律法純全，使人靈魂甦醒；</para>
  <para style="q1" vid="PSA 19:7">耶和華的法度信實，使無知的人有智慧；<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />耶和華的訓誡正直，使人心歡喜；</para>
  <para style="q1" vid="PSA 19:8">耶和華的誡命純潔，使人眼目明亮；<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />敬畏耶和華的訓誨<note caller="+" style="f"><char style="fr" closed="false">19:9 </char><char style="ft" closed="false">的訓誨——輔助詞語。</char></note>是純正的，存留到永遠；</para>
  <para style="q1" vid="PSA 19:9">耶和華的法規是真實的，全然公義；<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />它們比金子、比大量的純金更珍貴；</para>
  <para style="q1" vid="PSA 19:10">比蜂蜜、比蜂房下滴的蜜更甘甜。<verse eid="PSA 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />而且你的僕人也藉著它們受警誡，</para>
  <para style="q1" vid="PSA 19:11">遵守它們就有豐盛的賞賜。<verse eid="PSA 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />誰能察覺自己的過失呢？</para>
  <para style="q1" vid="PSA 19:12">求你赦免我隱而未現的過失。<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />求你攔阻你僕人，不犯任意妄為的罪，</para>
  <para style="q1" vid="PSA 19:13">不要讓這些罪轄制我；</para>
  <para style="q1" vid="PSA 19:13">這樣我就完全，免於大的過犯。<verse eid="PSA 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />耶和華——我的磐石、我的救贖主啊，</para>
  <para style="q1" vid="PSA 19:14">願我口中的言語、心裡的默想，</para>
  <para style="q1" vid="PSA 19:14">在你面前蒙悅納。<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s">求神拯救受膏者</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1" />願耶和華在患難的日子裡回應你，</para>
  <para style="q1" vid="PSA 20:1">願<char style="pn">雅各</char>之神的名把你安置在高處。<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />願他從聖所給予你幫助，</para>
  <para style="q1" vid="PSA 20:2">願他從<char style="pn">錫安</char>扶持你；<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />願他記念你一切的供物，</para>
  <para style="q1" vid="PSA 20:3">悅納你的燔祭。<char style="qs">細拉</char><verse eid="PSA 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />願他照著你的心意賜給你，</para>
  <para style="q1" vid="PSA 20:4">成就你一切的籌算。<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />我們要因你得救而歡呼，</para>
  <para style="q1" vid="PSA 20:5">奉我們神的名高舉旌旗。</para>
  <para style="q1" vid="PSA 20:5">願耶和華成就你所求的一切！<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />現在我知道耶和華拯救他的受膏者；</para>
  <para style="q1" vid="PSA 20:6">他必用右手的拯救大能，</para>
  <para style="q1" vid="PSA 20:6">從神聖的高天回應受膏者。<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />有人靠戰車，有人靠馬匹，</para>
  <para style="q1" vid="PSA 20:7">但我們卻靠我們神耶和華的名。<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />他們都屈膝仆倒，</para>
  <para style="q1" vid="PSA 20:8">我們卻起來，穩穩站立。<verse eid="PSA 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />耶和華啊，求你拯救！</para>
  <para style="q1" vid="PSA 20:9">在我們呼求的日子裡，願王回應我們。<note caller="+" style="f"><char style="fr" closed="false">20:9 </char><char style="ft" closed="false">此節或譯作：耶和華啊，求你拯救我們的王！在我們呼求的日子裡，願他回應我們。</char></note><verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s">勝利的頌歌</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />耶和華啊，</para>
  <para style="q1" vid="PSA 21:1">因你的力量，王必歡喜；</para>
  <para style="q1" vid="PSA 21:1">因你的救恩，他的快樂何等大！<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />他心中所願的，你賜給了他；</para>
  <para style="q1" vid="PSA 21:2">他嘴唇所求的，你沒有拒絕。<char style="qs">細拉</char><verse eid="PSA 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />是的，你用美好的祝福迎接他，</para>
  <para style="q1" vid="PSA 21:3">把純金的冠冕戴在他頭上。<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />他向你祈求長壽，你就賜給他，</para>
  <para style="q1" vid="PSA 21:4">就是長久的日子，永永遠遠。<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />因你的救恩，他大有榮耀；</para>
  <para style="q1" vid="PSA 21:5">你又把尊榮和威嚴賜給他。<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />是的，你給他祝福，直到永遠，</para>
  <para style="q1" vid="PSA 21:6">又使他在你面前<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="ft" closed="false">在你面前——或譯作「因與你同在的」。</char></note>喜樂歡悅；<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />因為王依靠耶和華；</para>
  <para style="q1" vid="PSA 21:7">靠著至高者的慈愛，他不致動搖。<verse eid="PSA 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />你的手找出你一切的仇敵，</para>
  <para style="q1" vid="PSA 21:8">你的右手找出那些恨你的人。<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />當你出現的時候，</para>
  <para style="q1" vid="PSA 21:9">你要使他們如同燃燒的火爐；</para>
  <para style="q1" vid="PSA 21:9">耶和華必在他的怒氣中吞滅他們，</para>
  <para style="q1" vid="PSA 21:9">他的烈火必把他們吞噬。<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />你從地上消滅他們的後代，</para>
  <para style="q1" vid="PSA 21:10">從世人中消滅他們的後裔。<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />他們雖然向你圖謀惡事、謀劃詭計，</para>
  <para style="q1" vid="PSA 21:11">卻不能成功，<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />因為你必使他們轉身而逃；</para>
  <para style="q1" vid="PSA 21:12">你必拉開弓弦，對準他們的臉。<verse eid="PSA 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />耶和華啊，願你因你的力量受尊崇！</para>
  <para style="q1" vid="PSA 21:13">我們要歌唱，歌頌你的大能。<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s">受難中的哀呼和頌讚</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮，用「黎明的母鹿」曲調。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />我的神，我的神，</para>
  <para style="q1" vid="PSA 22:1">你為什麼離棄我？</para>
  <para style="q1" vid="PSA 22:1">為什麼遠離不救我，</para>
  <para style="q1" vid="PSA 22:1">不聽我唉哼的話語？<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />我的神哪，</para>
  <para style="q1" vid="PSA 22:2">我白天呼求，你不回應；</para>
  <para style="q1" vid="PSA 22:2">我在夜間也得不到安寧！<verse eid="PSA 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />但你是至聖者，</para>
  <para style="q1" vid="PSA 22:3">用<char style="pn">以色列</char>的讚美為寶座。<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />我們的祖先依靠你；</para>
  <para style="q1" vid="PSA 22:4">他們依靠你，你就解救他們。<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />他們向你哀求就得拯救；</para>
  <para style="q1" vid="PSA 22:5">他們依靠你就不致蒙羞。<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />但我是蟲，不是人；</para>
  <para style="q1" vid="PSA 22:6">我遭人辱罵，被民眾輕視。<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />所有看見我的都嘲笑我，</para>
  <para style="q1" vid="PSA 22:7">他們撇嘴搖頭說：<verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />「他把自己交託給耶和華了，</para>
  <para style="q1" vid="PSA 22:8">讓耶和華搭救他吧！</para>
  <para style="q1" vid="PSA 22:8">既然耶和華喜悅他，</para>
  <para style="q1" vid="PSA 22:8">就讓耶和華解救他！」<verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />然而，是你使我從母腹中出來，</para>
  <para style="q1" vid="PSA 22:9">是你使我在母親的懷中就有依靠。<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />我自出胎胞就被交託給你；</para>
  <para style="q1" vid="PSA 22:10">一出母腹，你就是我的神。<verse eid="PSA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />求你不要遠離我，</para>
  <para style="q1" vid="PSA 22:11">因為患難臨近了，沒有人幫助！<verse eid="PSA 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />許多公牛圍繞我，</para>
  <para style="q1" vid="PSA 22:12">
    <char style="pn">巴珊</char>的壯牛圍困我。<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />他們向我張大了口，</para>
  <para style="q1" vid="PSA 22:13">如同撕咬吼叫的獅子。<verse eid="PSA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />我像水一樣被傾倒，</para>
  <para style="q1" vid="PSA 22:14">我全身的骨頭都脫節了；</para>
  <para style="q1" vid="PSA 22:14">我的心像蠟那樣，</para>
  <para style="q1" vid="PSA 22:14">在我裡面融化。<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />我的力量如同瓦片一樣枯乾，</para>
  <para style="q1" vid="PSA 22:15">我的舌頭緊貼著上顎；</para>
  <para style="q1" vid="PSA 22:15">你把我放在死亡的塵土中。<verse eid="PSA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />群狗圍繞我，一夥惡黨包圍我，</para>
  <para style="q1" vid="PSA 22:16">他們刺穿<note caller="+" style="f"><char style="fr" closed="false">22:16 </char><char style="ft" closed="false">他們刺穿——馬索拉文本作「像獅子」。</char></note>我的雙手、我的雙腳；<verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />我能數算我全身的骨頭；</para>
  <para style="q1" vid="PSA 22:17">他們又瞪著眼看我。<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />他們分了我的衣服，</para>
  <para style="q1" vid="PSA 22:18">又為我的衣裳抽籤。<verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />可是你，耶和華啊，求你不要遠離我！</para>
  <para style="q1" vid="PSA 22:19">我的力量啊，求你快來幫助我！<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />求你解救我的性命脫離刀劍，</para>
  <para style="q1" vid="PSA 22:20">從狗爪中救我寶貴的生命；<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />求你拯救我脫離獅子的口，</para>
  <para style="q1" vid="PSA 22:21">脫離野牛的犄角。</para>
  <para style="q1" vid="PSA 22:21">你已經應允了我。<verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />我要向我的弟兄們講述你的名，</para>
  <para style="q1" vid="PSA 22:22">要在會眾當中讚美你。<verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />敬畏耶和華的人哪，你們當讚美他！</para>
  <para style="q1" vid="PSA 22:23">所有<char style="pn">雅各</char>的後裔啊，都當榮耀他！</para>
  <para style="q1" vid="PSA 22:23">所有<char style="pn">以色列</char>的後裔啊，都當在他面前懼怕！<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />因為他沒有輕視、沒有厭煩困苦人的苦難，</para>
  <para style="q1" vid="PSA 22:24">也沒有向他們隱藏自己的臉；</para>
  <para style="q1" vid="PSA 22:24">當困苦人向他呼救時，他就垂聽。<verse eid="PSA 22:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />在廣大的會眾當中，</para>
  <para style="q1" vid="PSA 22:25">我因你而獻上讚美<note caller="+" style="f"><char style="fr" closed="false">22:25 </char><char style="ft" closed="false">我因你而獻上讚美——或譯作「我的讚美從你而來」。</char></note>；</para>
  <para style="q1" vid="PSA 22:25">在敬畏他的人面前，</para>
  <para style="q1" vid="PSA 22:25">我要償還我所許的願。<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />卑微的人必將吃得飽足；</para>
  <para style="q1" vid="PSA 22:26">求問耶和華的人將讚美他。</para>
  <para style="q1" vid="PSA 22:26">願你們的心得以存活，直到永遠！<verse eid="PSA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />地極都要記念耶和華，歸向他；</para>
  <para style="q1" vid="PSA 22:27">列邦萬族都要在他<note caller="+" style="f"><char style="fr" closed="false">22:27 </char><char style="ft" closed="false">他——原文直譯「你」。</char></note>面前下拜；<verse eid="PSA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />因為國度屬於耶和華，</para>
  <para style="q1" vid="PSA 22:28">他是列國的管轄者。<verse eid="PSA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />地上所有豐足的人都要來吃喝敬拜；</para>
  <para style="q1" vid="PSA 22:29">所有下入塵土的——不能保住自己性命的人，</para>
  <para style="q1" vid="PSA 22:29">都要在他面前屈身。<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />後裔必服事他；</para>
  <para style="q1" vid="PSA 22:30">主的事必給後代講述。<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />他們必來向將出生的民宣告他的公義，說：</para>
  <para style="q1" vid="PSA 22:31">他已經成就了！<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">神是我的牧者</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />耶和華是我的牧者，</para>
  <para style="q1" vid="PSA 23:1">我必不缺乏。<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />他讓我躺臥在青草地上，</para>
  <para style="q1" vid="PSA 23:2">領我到安寧的水邊。<verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />他使我的靈魂甦醒<note caller="+" style="f"><char style="fr" closed="false">23:3 </char><char style="ft" closed="false">甦醒——或譯作「回轉」或「恢復」。</char></note>，</para>
  <para style="q1" vid="PSA 23:3">為自己的名引導我走公義的路。<verse eid="PSA 23:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />我縱然行過死蔭的幽谷，</para>
  <para style="q1" vid="PSA 23:4">也不怕遭害，因為你與我同在；</para>
  <para style="q1" vid="PSA 23:4">你的杖、你的杆都安慰我。<verse eid="PSA 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />當著我敵人的面，</para>
  <para style="q1" vid="PSA 23:5">你在我面前擺設筵席；</para>
  <para style="q1" vid="PSA 23:5">你用油膏了我的頭，</para>
  <para style="q1" vid="PSA 23:5">使我的杯滿溢。<verse eid="PSA 23:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />我一生一世，</para>
  <para style="q1" vid="PSA 23:6">必有福份和慈愛伴隨著我；</para>
  <para style="q1" vid="PSA 23:6">我要住在耶和華的殿中，</para>
  <para style="q1" vid="PSA 23:6">直到永遠。<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s">榮耀的王</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />大地和其上所充滿的，</para>
  <para style="q1" vid="PSA 24:1">世界和住在其中的，都屬於耶和華，<verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />因為他把大地奠定在海洋上，</para>
  <para style="q1" vid="PSA 24:2">確立在河流之上。<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />誰能登上耶和華的山呢？</para>
  <para style="q1" vid="PSA 24:3">誰能站在他的聖所中呢？<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />就是手上清正、心裡純潔的人，</para>
  <para style="q1" vid="PSA 24:4">他的心不傾向虛妄，</para>
  <para style="q1" vid="PSA 24:4">他也不起假誓。<verse eid="PSA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />他必領受來自耶和華的祝福，</para>
  <para style="q1" vid="PSA 24:5">領受來自拯救他的神的公義。<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />這就是求問耶和華的那些人，</para>
  <para style="q1" vid="PSA 24:6">是尋求你容面的<char style="pn">雅各</char>。<char style="qs">細拉</char><verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />眾城門哪，當抬起你們的頭！</para>
  <para style="q1" vid="PSA 24:7">永久的門哪，你們要被抬起，</para>
  <para style="q1" vid="PSA 24:7">好讓榮耀的王進來！<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />這榮耀的王是誰呢？</para>
  <para style="q1" vid="PSA 24:8">就是強大而全能的耶和華，</para>
  <para style="q1" vid="PSA 24:8">是戰爭中全能的耶和華。<verse eid="PSA 24:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />眾城門哪，當抬起你們的頭！</para>
  <para style="q1" vid="PSA 24:9">永久的門哪，當抬起頭，</para>
  <para style="q1" vid="PSA 24:9">好讓榮耀的王進來！<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />這榮耀的王，他是誰呢？</para>
  <para style="q1" vid="PSA 24:10">就是萬軍之耶和華，</para>
  <para style="q1" vid="PSA 24:10">他是榮耀的王！<char style="qs">細拉</char><verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s">仰望神的救恩</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">25:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />耶和華啊，我的心仰望你！<verse eid="PSA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />我的神哪，我依靠你，</para>
  <para style="q1" vid="PSA 25:2">求你不要讓我蒙羞，</para>
  <para style="q1" vid="PSA 25:2">不要讓我的仇敵在我面前歡慶！<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />所有等候你的必不致蒙羞，</para>
  <para style="q1" vid="PSA 25:3">那些無故背信的必會蒙羞。<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />耶和華啊，求你使我明白你的道路，</para>
  <para style="q1" vid="PSA 25:4">把你的路途指示給我！<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />求你以你的真理引導我、教導我，</para>
  <para style="q1" vid="PSA 25:5">因為你是拯救我的神；</para>
  <para style="q1" vid="PSA 25:5">我終日等候你。<verse eid="PSA 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />耶和華啊！求你記念你的憐憫和慈愛，</para>
  <para style="q1" vid="PSA 25:6">因為它們從亙古就存在。<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />不要記念我年幼時的罪惡和我的過犯；</para>
  <para style="q1" vid="PSA 25:7">耶和華啊，求你因著你的美善，</para>
  <para style="q1" vid="PSA 25:7">按著你的慈愛記念我！<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />耶和華是美善正直的，</para>
  <para style="q1" vid="PSA 25:8">因此他必指示罪人走正道。<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />他以公正引導卑微人，</para>
  <para style="q1" vid="PSA 25:9">把他的道教導給他們。<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />對於謹守耶和華的約和他法度的人，</para>
  <para style="q1" vid="PSA 25:10">耶和華一切的道都是慈愛和信實。<verse eid="PSA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />耶和華啊，求你為你名的緣故，</para>
  <para style="q1" vid="PSA 25:11">赦免我的罪孽，因為我罪孽深重！<verse eid="PSA 25:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />誰是那敬畏耶和華的人呢？</para>
  <para style="q1" vid="PSA 25:12">耶和華必指示他當選擇的道路。<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />他自己將安享福份，</para>
  <para style="q1" vid="PSA 25:13">他的後裔必繼承那地。<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />耶和華與敬畏他的人親密<note caller="+" style="f"><char style="fr" closed="false">25:14 </char><char style="ft" closed="false">耶和華與敬畏他的人親密——或譯作「耶和華的心意向敬畏他的人顯示」。</char></note>，</para>
  <para style="q1" vid="PSA 25:14">使他們明白他的約。<verse eid="PSA 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />我的眼睛一直仰望耶和華，</para>
  <para style="q1" vid="PSA 25:15">因為他會使我的腳脫離網羅。<verse eid="PSA 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />求你轉向我、恩待我，</para>
  <para style="q1" vid="PSA 25:16">因為我孤苦伶仃。<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />我心裡的苦難加增，</para>
  <para style="q1" vid="PSA 25:17">求你把我從困境中領出來。<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />求你察看我的苦情和禍患，</para>
  <para style="q1" vid="PSA 25:18">除去我一切的罪惡。<verse eid="PSA 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />求你關注我的仇敵，</para>
  <para style="q1" vid="PSA 25:19">因為他們人數眾多，並深深痛恨我。<verse eid="PSA 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />求你保守我的性命、解救我，</para>
  <para style="q1" vid="PSA 25:20">不要讓我蒙羞，因為我投靠你。<verse eid="PSA 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />願純全和正直守護我，</para>
  <para style="q1" vid="PSA 25:21">因為我等候你。<verse eid="PSA 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />神哪，求你救贖<char style="pn">以色列</char>脫離一切的患難！<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s">義人求神伸冤</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">26:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />耶和華啊，求你為我伸冤！</para>
  <para style="q1" vid="PSA 26:1">因為我行在純全中；</para>
  <para style="q1" vid="PSA 26:1">我依靠耶和華，必不動搖。<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />耶和華啊，求你察驗我，試驗我，</para>
  <para style="q1" vid="PSA 26:2">熬煉我的肺腑心腸！<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />因為你的慈愛在我眼前，</para>
  <para style="q1" vid="PSA 26:3">我行在你的真理中。<verse eid="PSA 26:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />我不與虛妄的人同坐，</para>
  <para style="q1" vid="PSA 26:4">也不與偽善的人來往。<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />我憎恨作惡的會眾，</para>
  <para style="q1" vid="PSA 26:5">也不與惡人同坐。<verse eid="PSA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />耶和華啊，我要洗淨雙手表明清白，</para>
  <para style="q1" vid="PSA 26:6">還要繞著你的祭壇而行，<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />好發出感謝的聲音，</para>
  <para style="q1" vid="PSA 26:7">講述你一切的奇妙作為！<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />耶和華啊，我愛你所住的殿，</para>
  <para style="q1" vid="PSA 26:8">你榮耀所居之處！<verse eid="PSA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />不要把我的靈魂與罪人一同收回，</para>
  <para style="q1" vid="PSA 26:9">不要把我的性命與殺人流血的一同收回。<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />他們的手中有惡計，</para>
  <para style="q1" vid="PSA 26:10">他們的右手滿是賄賂。<verse eid="PSA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />至於我，我要行在純全中，</para>
  <para style="q1" vid="PSA 26:11">求你救贖我，恩待我。<verse eid="PSA 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />我的腳站在平坦之地，</para>
  <para style="q1" vid="PSA 26:12">我要在集會中頌讚耶和華。<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s">神是我的保障</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">27:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />耶和華是我的光，是我的救恩，</para>
  <para style="q1" vid="PSA 27:1">我還怕誰呢？</para>
  <para style="q1" vid="PSA 27:1">耶和華是我一生的保障，</para>
  <para style="q1" vid="PSA 27:1">我還懼怕誰呢？<verse eid="PSA 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />那些作惡者，就是我的敵人、我的仇敵，</para>
  <para style="q1" vid="PSA 27:2">他們逼近我、要吞噬我肉體的時候，</para>
  <para style="q1" vid="PSA 27:2">就絆跌、仆倒。<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />儘管有軍兵紮營攻擊我，</para>
  <para style="q1" vid="PSA 27:3">我的心也不害怕；</para>
  <para style="q1" vid="PSA 27:3">儘管有戰爭興起臨到我，</para>
  <para style="q1" vid="PSA 27:3">我依然無所懼怕。<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />有一件事我求過耶和華，</para>
  <para style="q1" vid="PSA 27:4">這件事我還要求問，</para>
  <para style="q1" vid="PSA 27:4">就是一生一世住在耶和華的殿中，</para>
  <para style="q1" vid="PSA 27:4">仰望耶和華的恩慈，在他的聖殿中尋求；<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />因為在禍患的日子裡，</para>
  <para style="q1" vid="PSA 27:5">他必將我藏在他的帳幕中，</para>
  <para style="q1" vid="PSA 27:5">隱藏在他帳篷的隱祕處，</para>
  <para style="q1" vid="PSA 27:5">又將我高舉到磐石上；<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />這樣我的頭可以揚起來，</para>
  <para style="q1" vid="PSA 27:6">高過我四圍的仇敵。</para>
  <para style="q1" vid="PSA 27:6">我要在他帳篷中歡呼獻祭，</para>
  <para style="q1" vid="PSA 27:6">我要歌唱、歌頌耶和華。<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />耶和華啊，我呼求的時候，求你垂聽我的聲音！</para>
  <para style="q1" vid="PSA 27:7">求你恩待我，回應我。<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />你說：「你們要尋求我的榮面。」</para>
  <para style="q1" vid="PSA 27:8">我的心向你說：</para>
  <para style="q1" vid="PSA 27:8">「耶和華啊，你的榮面，我要尋求！」<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />不要向我隱藏你的臉，</para>
  <para style="q1" vid="PSA 27:9">不要在怒氣中趕走你的僕人；</para>
  <para style="q1" vid="PSA 27:9">你一向是我的幫助！</para>
  <para style="q1" vid="PSA 27:9">拯救我的神哪，不要撇棄我，不要離棄我！<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />即使我的父母離棄我，</para>
  <para style="q1" vid="PSA 27:10">耶和華也必收留我。<verse eid="PSA 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />耶和華啊，求你將你的道路指示我！</para>
  <para style="q1" vid="PSA 27:11">因我仇敵的緣故，求你引導我走平坦的路。<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />求你不要照著我敵人的願望把我交出去，</para>
  <para style="q1" vid="PSA 27:12">因為作假見證並口吐凶言的起來攻擊我。<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />我確實相信：在活人之地</para>
  <para style="q1" vid="PSA 27:13">我必會看到耶和華的美善。<note caller="+" style="f"><char style="fr" closed="false">27:13 </char><char style="ft" closed="false">此節或譯作：我如果不相信在活人之地會看到耶和華的美善，就早已喪膽了。</char></note><verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />你要等候耶和華；</para>
  <para style="q1" vid="PSA 27:14">你要堅強，願你的心勇敢！</para>
  <para style="q1" vid="PSA 27:14">你要等候耶和華！<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s">神是我的力量</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">28:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />耶和華啊，我向你呼求！</para>
  <para style="q1" vid="PSA 28:1">我的磐石啊，求你不要向我沉默——</para>
  <para style="q1" vid="PSA 28:1">如果你對我靜默，</para>
  <para style="q1" vid="PSA 28:1">我就與下陰坑的人一樣了！<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />我向你呼救，</para>
  <para style="q1" vid="PSA 28:2">向你的至聖所舉起雙手的時候，</para>
  <para style="q1" vid="PSA 28:2">求你垂聽我懇求的聲音。<verse eid="PSA 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />不要把我與惡人、與作惡者一同拖走；</para>
  <para style="q1" vid="PSA 28:3">他們與自己的鄰人說平安的話，心裡卻是奸惡。<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />求你照著他們的作為，</para>
  <para style="q1" vid="PSA 28:4">照著他們的惡行對待他們；</para>
  <para style="q1" vid="PSA 28:4">求你照著他們手所做的對待他們，</para>
  <para style="q1" vid="PSA 28:4">向他們施行應得的報應！<verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />因為他們無視耶和華的作為和他手所做的，</para>
  <para style="q1" vid="PSA 28:5">他就必拆毀他們，不建立他們！<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />耶和華是當受頌讚的，</para>
  <para style="q1" vid="PSA 28:6">因為他垂聽了我懇求的聲音。<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />耶和華是我的力量、我的盾牌，</para>
  <para style="q1" vid="PSA 28:7">我的心依靠他，我就得到幫助。</para>
  <para style="q1" vid="PSA 28:7">因此我的心歡躍，</para>
  <para style="q1" vid="PSA 28:7">我要用我的歌稱謝他。<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />耶和華是他子民<note caller="+" style="f"><char style="fr" closed="false">28:8 </char><char style="ft" closed="false">他子民——原文直譯「他們」。</char></note>的力量，</para>
  <para style="q1" vid="PSA 28:8">又是他受膏者得救的保障。<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />求你拯救你的子民，祝福你的繼業，</para>
  <para style="q1" vid="PSA 28:9">求你牧養他們，扶持他們，直到永遠。<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s">神的威榮</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />神的眾子<note caller="+" style="f"><char style="fr" closed="false">29:1 </char><char style="ft" closed="false">神的眾子——或譯作「神的眾天使」或「諸神」。</char></note>啊，</para>
  <para style="q1" vid="PSA 29:1">你們當把榮耀和力量</para>
  <para style="q1" vid="PSA 29:1">歸給耶和華，歸給耶和華！<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />你們當把耶和華名的榮耀歸給他，</para>
  <para style="q1" vid="PSA 29:2">要向神聖威嚴的耶和華下拜<note caller="+" style="f"><char style="fr" closed="false">29:2 </char><char style="ft" closed="false">要向神聖威嚴的耶和華下拜——或譯作「當穿上聖潔的裝束敬拜他」。</char></note>。<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />耶和華的聲音在眾水之上，</para>
  <para style="q1" vid="PSA 29:3">榮耀的神打雷；</para>
  <para style="q1" vid="PSA 29:3">耶和華在大水之上。<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />耶和華的聲音帶著能力，</para>
  <para style="q1" vid="PSA 29:4">耶和華的聲音帶著威嚴。<verse eid="PSA 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />耶和華的聲音震斷香柏樹，</para>
  <para style="q1" vid="PSA 29:5">耶和華震斷<char style="pn">黎巴嫩</char>的香柏樹。<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />他使<char style="pn">黎巴嫩</char>跳躍如牛犢，</para>
  <para style="q1" vid="PSA 29:6">使<char style="pn">西連</char>跳躍如野牛犢。<note caller="+" style="f"><char style="fr" closed="false">29:6 </char><char style="ft" closed="false">此節或譯作：他使黎巴嫩和西連跳躍如牛犢，使它們跳躍如野牛犢。</char></note><verse eid="PSA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />耶和華的聲音劈下火焰。<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />耶和華的聲音震撼曠野，</para>
  <para style="q1" vid="PSA 29:8">耶和華震撼<char style="pn">加低斯</char>曠野。<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />耶和華的聲音使母鹿分娩，</para>
  <para style="q1" vid="PSA 29:9">使林中的樹木凋零光禿；</para>
  <para style="q1" vid="PSA 29:9">凡在他聖殿中的都說：「榮耀啊！」<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />耶和華坐在洪水之上，</para>
  <para style="q1" vid="PSA 29:10">耶和華坐著為王，直到永遠。<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />耶和華賜力量給他的子民，</para>
  <para style="q1" vid="PSA 29:11">耶和華以平安祝福他的子民。<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s">感恩的頌讚</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，獻殿之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />耶和華啊，我要尊崇你！</para>
  <para style="q1" vid="PSA 30:1">因為你救拔我，</para>
  <para style="q1" vid="PSA 30:1">沒有讓我的仇敵對我幸災樂禍。<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />耶和華我的神哪，我向你呼救，</para>
  <para style="q1" vid="PSA 30:2">你就醫治了我！<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />耶和華啊，你把我的靈魂從陰間帶上來，</para>
  <para style="q1" vid="PSA 30:3">使我存活，不至於下到陰坑！<verse eid="PSA 30:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />耶和華的忠信者啊，你們當歌頌他，</para>
  <para style="q1" vid="PSA 30:4">當稱頌他的聖名！<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />因為他的怒氣只是一瞬間，</para>
  <para style="q1" vid="PSA 30:5">他的恩典卻是一生之久；</para>
  <para style="q1" vid="PSA 30:5">晚上雖有不停的哭泣，</para>
  <para style="q1" vid="PSA 30:5">早晨必有歡呼。<verse eid="PSA 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />至於我，我安穩的時候曾說：</para>
  <para style="q1" vid="PSA 30:6">「我永遠不致動搖。」<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />耶和華啊，藉著你的恩典，</para>
  <para style="q1" vid="PSA 30:7">你使我的江山穩固<note caller="+" style="f"><char style="fr" closed="false">30:7 </char><char style="ft" closed="false">你使我的江山穩固——或譯作「你使我堅立，如雄偉的群山」。</char></note>；</para>
  <para style="q1" vid="PSA 30:7">你隱藏你的臉，我就感到惶恐！<verse eid="PSA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />耶和華啊，我向你呼求；</para>
  <para style="q1" vid="PSA 30:8">我向我的主懇求：<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />「我死亡下到陰坑，有什麼好處呢？</para>
  <para style="q1" vid="PSA 30:9">難道塵土會稱謝你，宣告你的信實嗎？<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />耶和華啊，求你垂聽，求你恩待我！</para>
  <para style="q1" vid="PSA 30:10">耶和華啊，求你幫助我！」<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />你已將我的哀哭變為跳舞，</para>
  <para style="q1" vid="PSA 30:11">你已脫去我的麻衣，為我披上喜樂，<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />好讓我的靈<note caller="+" style="f"><char style="fr" closed="false">30:12 </char><char style="ft" closed="false">靈——原文直譯「榮耀」。</char></note>歌頌你，不致靜默。</para>
  <para style="q1" vid="PSA 30:12">耶和華我的神哪，我要稱謝你，直到永遠！<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s">信靠神的祈禱</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />耶和華啊，我投靠了你，</para>
  <para style="q1" vid="PSA 31:1">求你使我永不蒙羞！</para>
  <para style="q1" vid="PSA 31:1">求你藉著你的公義挽救我。<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />求你向我側耳聽，速速地解救我；</para>
  <para style="q1" vid="PSA 31:2">求你作保護我的磐石、拯救我的堡壘；<verse eid="PSA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />因為你是我的岩石、我的要塞；</para>
  <para style="q1" vid="PSA 31:3">為你名的緣故，你引導我、帶領我。<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />你必領我脫離他們為我暗設的網羅，</para>
  <para style="q1" vid="PSA 31:4">因為你是我的保障。<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />我把我的靈交託在你的手中。</para>
  <para style="q1" vid="PSA 31:5">耶和華信實的神哪，你救贖了我！<verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />我恨惡那些信奉虛妄假神的人，</para>
  <para style="q1" vid="PSA 31:6">至於我，我卻依靠耶和華。<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />我要在你的慈愛中快樂歡喜，</para>
  <para style="q1" vid="PSA 31:7">因你看到我的苦難，知道我心中的患難。<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />你沒有把我交在仇敵的手中，</para>
  <para style="q1" vid="PSA 31:8">卻使我的腳站在寬闊之地。<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />耶和華啊，求你恩待我！</para>
  <para style="q1" vid="PSA 31:9">因為我在危難中，</para>
  <para style="q1" vid="PSA 31:9">我的眼睛、我的身、我的心，</para>
  <para style="q1" vid="PSA 31:9">都因愁煩而枯乾。<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />是的，我的一生在悲哀中消逝，</para>
  <para style="q1" vid="PSA 31:10">我的歲月在嘆息中消亡；</para>
  <para style="q1" vid="PSA 31:10">我的力量在我的罪孽中衰敗，</para>
  <para style="q1" vid="PSA 31:10">連我的骨頭也枯乾。<verse eid="PSA 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />我因一切的敵人成了羞辱，</para>
  <para style="q1" vid="PSA 31:11">尤其是在我的鄰居面前；</para>
  <para style="q1" vid="PSA 31:11">認識我的都懼怕我，</para>
  <para style="q1" vid="PSA 31:11">街道上看見我的都逃離我。<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />我像死人那樣從人心中被忘掉，</para>
  <para style="q1" vid="PSA 31:12">我就像破碎的器皿；<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />我聽見許多的謠言，四圍都是驚嚇；</para>
  <para style="q1" vid="PSA 31:13">他們一同商定對付我，決意取走我的性命。<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />耶和華啊，我還要依靠你，</para>
  <para style="q1" vid="PSA 31:14">我說：「你是我的神！」<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />我的時日在你的手中；</para>
  <para style="q1" vid="PSA 31:15">求你解救我脫離仇敵的手，</para>
  <para style="q1" vid="PSA 31:15">脫離追逼我的人。<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />求你使你的臉光照你的僕人，</para>
  <para style="q1" vid="PSA 31:16">因你的慈愛拯救我。<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />耶和華啊，求你不要讓我蒙羞，</para>
  <para style="q1" vid="PSA 31:17">因為我呼求你！</para>
  <para style="q1" vid="PSA 31:17">求你讓惡人蒙羞，讓他們在陰間靜默無語。<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />願撒謊的嘴唇啞然無聲——</para>
  <para style="q1" vid="PSA 31:18">它們因著自高和輕慢，向義人說狂傲的話。<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />在世人面前，</para>
  <para style="q1" vid="PSA 31:19">你為敬畏你的人所留存的美善，</para>
  <para style="q1" vid="PSA 31:19">為投靠你的人所行的美善，</para>
  <para style="q1" vid="PSA 31:19">是何等豐富！<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />你把他們隱藏在你面前的隱祕處，</para>
  <para style="q1" vid="PSA 31:20">遠離人的圈套；</para>
  <para style="q1" vid="PSA 31:20">你把他們藏匿在帳幕中，遠離口舌的爭鬥。<verse eid="PSA 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />耶和華是當受頌讚的，</para>
  <para style="q1" vid="PSA 31:21">因為我被圍困在城中時，</para>
  <para style="q1" vid="PSA 31:21">他向我奇妙地彰顯了他的慈愛。<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />至於我，我曾在慌亂中說：</para>
  <para style="q1" vid="PSA 31:22">「我從你眼前被隔絕了！」</para>
  <para style="q1" vid="PSA 31:22">然而當我向你呼救時，</para>
  <para style="q1" vid="PSA 31:22">你仍然垂聽了我懇求的聲音。<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />耶和華所有的忠信者啊，你們都當愛他！</para>
  <para style="q1" vid="PSA 31:23">耶和華守護忠實的人，</para>
  <para style="q1" vid="PSA 31:23">卻將十足的報應加給行事自高的人。<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />所有期盼耶和華的人哪，</para>
  <para style="q1" vid="PSA 31:24">你們要堅強，願你們的心勇敢！<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s">認罪與赦免</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的智慧詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />過犯得赦免、罪過被遮蓋的人，</para>
  <para style="q1" vid="PSA 32:1">是蒙福的！<verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />不被耶和華算為有罪、</para>
  <para style="q1" vid="PSA 32:2">心裡沒有詭詐的人，</para>
  <para style="q1" vid="PSA 32:2">是蒙福的！<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />我保持沉默、不認罪<note caller="+" style="f"><char style="fr" closed="false">32:3 </char><char style="ft" closed="false">不認罪——輔助詞語。</char></note>的時候，</para>
  <para style="q1" vid="PSA 32:3">就因終日唉哼而骨頭衰朽；<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />因為你的手晝夜重壓在我身上，</para>
  <para style="q1" vid="PSA 32:4">我的精力耗盡，如同在夏天的乾旱中。<char style="qs">細拉</char><verse eid="PSA 32:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />我向你告白我的罪，沒有掩蓋我的罪孽；</para>
  <para style="q1" vid="PSA 32:5">我說：「我要為我的過犯向耶和華認罪」，</para>
  <para style="q1" vid="PSA 32:5">你就赦免了我的罪愆。<char style="qs">細拉</char><verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />為此，願每個忠信者在能找到你的時候向你禱告；</para>
  <para style="q1" vid="PSA 32:6">即使大水氾濫，也不能觸及他。<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />你是我的藏身之處，</para>
  <para style="q1" vid="PSA 32:7">你守護我脫離危難，</para>
  <para style="q1" vid="PSA 32:7">以得救的歡呼圍繞我。<char style="qs">細拉</char><verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />我要教導你，指示你當走的路；</para>
  <para style="q1" vid="PSA 32:8">我要指教你，我的目光在你身上。<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />你不要像沒有悟性的騾馬，</para>
  <para style="q1" vid="PSA 32:9">如果不用嚼環和轡頭勒住，</para>
  <para style="q1" vid="PSA 32:9">牠就不肯靠近你。<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />惡人必有許多痛苦；</para>
  <para style="q1" vid="PSA 32:10">但依靠耶和華的，必有慈愛圍繞他。<verse eid="PSA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />義人哪，你們當因耶和華而歡喜快樂！</para>
  <para style="q1" vid="PSA 32:11">所有心裡正直的人哪，你們都當歡呼！<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s">歌頌全能的創造主</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />義人哪，你們當因耶和華而歡呼！</para>
  <para style="q1" vid="PSA 33:1">正直人讚美他，是合宜的。<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />你們當用豎琴稱謝耶和華，</para>
  <para style="q1" vid="PSA 33:2">用十弦的里拉琴歌頌他！<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />你們當向他唱新歌，</para>
  <para style="q1" vid="PSA 33:3">在歡呼中美妙地彈奏！<verse eid="PSA 33:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />因為耶和華的話語正直，</para>
  <para style="q1" vid="PSA 33:4">他所做的一切都信實；<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />他喜愛公義和公正，</para>
  <para style="q1" vid="PSA 33:5">耶和華的慈愛充滿大地。<verse eid="PSA 33:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />諸天藉著耶和華的話語而造，</para>
  <para style="q1" vid="PSA 33:6">其中的萬象藉著他口中的氣息而成。<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />他聚集海水如壘，</para>
  <para style="q1" vid="PSA 33:7">收藏深淵在庫房。<verse eid="PSA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />願全地都敬畏耶和華，</para>
  <para style="q1" vid="PSA 33:8">願世上所有的居民都懼怕他；<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />因為他說有<note caller="+" style="f"><char style="fr" closed="false">33:9 </char><char style="ft" closed="false">有——輔助詞語。</char></note>，就有；</para>
  <para style="q1" vid="PSA 33:9">命立<note caller="+" style="f"><char style="fr" closed="false">33:9 </char><char style="ft" closed="false">立——輔助詞語。</char></note>，就立。<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />耶和華挫敗列國的謀略，</para>
  <para style="q1" vid="PSA 33:10">使萬民的計策落空。<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />耶和華的謀略確立，直到永遠；</para>
  <para style="q1" vid="PSA 33:11">他心裡的意念存到萬代。<verse eid="PSA 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />以耶和華為神的，那國是蒙福的！</para>
  <para style="q1" vid="PSA 33:12">耶和華所揀選為自己繼業的，那民是蒙福的！<verse eid="PSA 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />耶和華從天上垂看，</para>
  <para style="q1" vid="PSA 33:13">看所有的世人。<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />他從自己所坐的地方，</para>
  <para style="q1" vid="PSA 33:14">察看地上所有的居民。<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />他塑造每個人的心，</para>
  <para style="q1" vid="PSA 33:15">他了解他們所做的一切。<verse eid="PSA 33:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />君王不能靠軍隊眾多得拯救，</para>
  <para style="q1" vid="PSA 33:16">勇士不能靠力量強大得解救；<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />靠馬得救是枉然的，</para>
  <para style="q1" vid="PSA 33:17">馬不能靠牠的力大救人。<verse eid="PSA 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />看哪，耶和華的眼目看顧</para>
  <para style="q1" vid="PSA 33:18">那些敬畏他、期盼他慈愛的人；<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />他要解救他們的靈魂脫離死亡，</para>
  <para style="q1" vid="PSA 33:19">使他們在饑荒中得以存活！<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />我們的靈魂等候耶和華，</para>
  <para style="q1" vid="PSA 33:20">他是我們的幫助、我們的盾牌。<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />我們的心必因他歡喜，</para>
  <para style="q1" vid="PSA 33:21">因為我們依靠他的聖名。<verse eid="PSA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />耶和華啊，願你的慈愛臨到我們，</para>
  <para style="q1" vid="PSA 33:22">正如我們對你的期盼！<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s">頌讚神的美善</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">34:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>。那時他在<char style="pn">亞比米勒</char>面前裝瘋，<char style="pn">亞比米勒</char>驅逐他，他就離開。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />我要時時頌讚耶和華，</para>
  <para style="q1" vid="PSA 34:1">常常在我的口中讚美他。<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />我的靈魂要因耶和華而誇耀，</para>
  <para style="q1" vid="PSA 34:2">願卑微人聽見就歡喜。<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />你們要與我一起尊耶和華為大，</para>
  <para style="q1" vid="PSA 34:3">讓我們一同高舉他的名。<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />我尋求耶和華，他就回應我，</para>
  <para style="q1" vid="PSA 34:4">解救我脫離一切的恐懼。<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />仰望他的，就有光彩；</para>
  <para style="q1" vid="PSA 34:5">他們的臉也不致慚愧。<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />我這困苦人呼求，耶和華就垂聽，</para>
  <para style="q1" vid="PSA 34:6">拯救我<note caller="+" style="f"><char style="fr" closed="false">34:6 </char><char style="ft" closed="false">我——原文直譯「他」。</char></note>脫離一切的患難。<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />耶和華的使者在敬畏耶和華的人四圍紮營，</para>
  <para style="q1" vid="PSA 34:7">搭救他們。<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />你們要嘗試，就知道耶和華是美善的！</para>
  <para style="q1" vid="PSA 34:8">那投靠他的人，是蒙福的！<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />耶和華的聖者們哪，你們當敬畏他！</para>
  <para style="q1" vid="PSA 34:9">因為敬畏他的人一無所缺。<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />少壯獅子也會疲乏、飢餓，</para>
  <para style="q1" vid="PSA 34:10">但尋求耶和華的，什麼福份都不缺。<verse eid="PSA 34:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />來吧，兒女們，聽從我！</para>
  <para style="q1" vid="PSA 34:11">我要教導你們敬畏耶和華。<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />誰是那喜愛生命、愛慕長壽</para>
  <para style="q1" vid="PSA 34:12">為要看到福份的人呢？<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />他<note caller="+" style="f"><char style="fr" closed="false">34:13 </char><char style="ft" closed="false">他——原文直譯「你」。</char></note>就當謹守舌頭不出惡言，</para>
  <para style="q1" vid="PSA 34:13">謹守嘴唇不說欺詐的話。<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />當遠離惡事，當行善事，</para>
  <para style="q1" vid="PSA 34:14">尋找並追求和平。<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />耶和華的眼目向著義人，</para>
  <para style="q1" vid="PSA 34:15">他的耳朵聽他們的呼求。<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />耶和華的臉敵對作惡的人，</para>
  <para style="q1" vid="PSA 34:16">要把他們的名號從地上剪除。<verse eid="PSA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />義人呼求，耶和華就垂聽，</para>
  <para style="q1" vid="PSA 34:17">解救他們脫離一切的患難。<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />耶和華與心靈破碎的人相近，</para>
  <para style="q1" vid="PSA 34:18">他拯救靈裡痛悔的人。<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />義人有許多患難，</para>
  <para style="q1" vid="PSA 34:19">但耶和華解救他脫離這一切，<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />又保守他全身的骨頭，</para>
  <para style="q1" vid="PSA 34:20">一根也不折斷。<verse eid="PSA 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />惡事必害死惡人，</para>
  <para style="q1" vid="PSA 34:21">恨義人的必承受罪責。<verse eid="PSA 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />耶和華救贖他僕人們的靈魂，</para>
  <para style="q1" vid="PSA 34:22">所有投靠他的都不致承受罪責。<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s">求神伸冤對付仇敵</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">35:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />耶和華啊，</para>
  <para style="q1" vid="PSA 35:1">與我相爭的，求你與他們相爭；</para>
  <para style="q1" vid="PSA 35:1">與我爭戰的，求你與他們爭戰！<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />求你握住大小盾牌，</para>
  <para style="q1" vid="PSA 35:2">起來幫助我；<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />求你拔出長矛和標槍，迎戰追趕我的人；</para>
  <para style="q1" vid="PSA 35:3">求你對我說：「我是你的拯救！」<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />願那些尋索我命的，抱愧羞慚；</para>
  <para style="q1" vid="PSA 35:4">願那些設計加害我的，後退蒙羞。<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />願他們如同風前的糠秕，</para>
  <para style="q1" vid="PSA 35:5">有耶和華的使者驅趕他們。<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />願他們的道路又暗又滑，</para>
  <para style="q1" vid="PSA 35:6">有耶和華的使者追趕他們；<verse eid="PSA 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />因為他們無故暗設網羅害我，</para>
  <para style="q1" vid="PSA 35:7">無故挖掘深坑害我的性命。<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />願毀滅在他們不知不覺時臨到他們，</para>
  <para style="q1" vid="PSA 35:8">願他們暗設的網羅纏住他們，</para>
  <para style="q1" vid="PSA 35:8">願他們落在其中遭毀滅。<verse eid="PSA 35:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />那時我的心必因耶和華而快樂，</para>
  <para style="q1" vid="PSA 35:9">因他的救恩而歡喜。<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />我全身的骨頭都要說：</para>
  <para style="q1" vid="PSA 35:10">「耶和華啊，誰能像你呢？</para>
  <para style="q1" vid="PSA 35:10">你解救困苦人脫離那些比他強大的；</para>
  <para style="q1" vid="PSA 35:10">解救困苦人和貧窮人脫離那些搶奪他的。」<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />惡毒的見證人起來，</para>
  <para style="q1" vid="PSA 35:11">質問我不知道的事。<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />他們對我以惡報善，</para>
  <para style="q1" vid="PSA 35:12">使我的心孤苦。<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />而我在他們患病的時候，</para>
  <para style="q1" vid="PSA 35:13">以麻布為衣袍，以禁食刻苦己心，</para>
  <para style="q1" vid="PSA 35:13">心中一再禱告<note caller="+" style="f"><char style="fr" closed="false">35:13 </char><char style="ft" closed="false">心中一再禱告——原文直譯「我的禱告回到我懷中」。</char></note>。<verse eid="PSA 35:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14" />我往來奔走，像為我的朋友、弟兄；</para>
  <para style="q1" vid="PSA 35:14">我哀痛、沮喪，像為母親悲哀。<verse eid="PSA 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />但我跌倒的時候，</para>
  <para style="q1" vid="PSA 35:15">他們卻歡喜聚集；</para>
  <para style="q1" vid="PSA 35:15">我不認識的卑賤人聚集攻擊我，</para>
  <para style="q1" vid="PSA 35:15">不停地撕扯我；<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />他們像宴席上狂妄的譏笑者，</para>
  <para style="q1" vid="PSA 35:16">向我咬牙切齒。<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />主啊，你還要看多久呢？</para>
  <para style="q1" vid="PSA 35:17">求你救我的性命脫離他們的殘害，</para>
  <para style="q1" vid="PSA 35:17">救我寶貴的生命脫離少壯獅子。<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />我要在廣大的會眾裡稱謝你，</para>
  <para style="q1" vid="PSA 35:18">在強盛的子民中讚美你。<verse eid="PSA 35:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />求你不要讓那些無理與我為敵的</para>
  <para style="q1" vid="PSA 35:19">對我幸災樂禍，</para>
  <para style="q1" vid="PSA 35:19">不要讓那些無故恨我的用眼嘲弄我；<verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />因為他們不說平安的話，</para>
  <para style="q1" vid="PSA 35:20">卻針對地上安分的人謀算欺詐的事<note caller="+" style="f"><char style="fr" closed="false">35:20 </char><char style="ft" closed="false">事——或譯作「話語」。</char></note>；<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />他們對我張大嘴巴說：</para>
  <para style="q1" vid="PSA 35:21">「啊哈！啊哈！我們的眼睛看到了！」<verse eid="PSA 35:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />耶和華啊，你已經看到了，</para>
  <para style="q1" vid="PSA 35:22">求你不要沉默！</para>
  <para style="q1" vid="PSA 35:22">主啊，求你不要遠離我！<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />我的神、我的主啊，</para>
  <para style="q1" vid="PSA 35:23">求你醒來、醒起，</para>
  <para style="q1" vid="PSA 35:23">為我伸冤、為我辯護！<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />耶和華我的神哪，</para>
  <para style="q1" vid="PSA 35:24">求你照著你的公義為我施行審判！</para>
  <para style="q1" vid="PSA 35:24">不要讓他們對我幸災樂禍，<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />不要讓他們心裡說：</para>
  <para style="q1" vid="PSA 35:25">「啊哈，這正如我們所願！」</para>
  <para style="q1" vid="PSA 35:25">不要讓他們說：</para>
  <para style="q1" vid="PSA 35:25">「我們已經把他吞掉了！」<verse eid="PSA 35:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />那些對我幸災樂禍的，</para>
  <para style="q1" vid="PSA 35:26">願他們都抱愧蒙羞；</para>
  <para style="q1" vid="PSA 35:26">那些在我面前高抬自己的，</para>
  <para style="q1" vid="PSA 35:26">願他們披上恥辱和羞愧。<verse eid="PSA 35:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />但那些喜歡我被顯為義的，</para>
  <para style="q1" vid="PSA 35:27">願他們歡呼歡喜；</para>
  <para style="q1" vid="PSA 35:27">願他們常說：「當尊耶和華為大！</para>
  <para style="q1" vid="PSA 35:27">耶和華喜悅他的僕人平安。」<verse eid="PSA 35:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />我的舌頭要述說你的公義，</para>
  <para style="q1" vid="PSA 35:28">終日讚美你！<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s">人的罪孽和神的慈愛</para>
  <para style="b" />
  <para style="d">耶和華的僕人<char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />論到惡人的罪過，我心裡有這樣的話語<note caller="+" style="f"><char style="fr" closed="false">36:1 </char><char style="ft" closed="false">論到惡人的罪過，我心裡有這樣的話語——或譯作「惡人的罪過在他心中說話」。</char></note>：</para>
  <para style="q1" vid="PSA 36:1">「他的眼中沒有對神的敬畏；<verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />因為他自我諂媚，</para>
  <para style="q1" vid="PSA 36:2">以致他不能察覺、不能恨惡自己的罪。<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />他口中的話語充滿奸惡和欺詐，</para>
  <para style="q1" vid="PSA 36:3">他不再有智慧，也不再行善。<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />他在床上就圖謀作惡，</para>
  <para style="q1" vid="PSA 36:4">定意行不善之道，不拒絕惡事。」<verse eid="PSA 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />耶和華啊，你的慈愛上達諸天，</para>
  <para style="q1" vid="PSA 36:5">你的信實上達雲霄！<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />你的公義如高大的群山，</para>
  <para style="q1" vid="PSA 36:6">你的公正如巨大的深淵。</para>
  <para style="q1" vid="PSA 36:6">耶和華啊，人和牲畜，你都救護！<verse eid="PSA 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />神哪，你的慈愛多麼寶貴，</para>
  <para style="q1" vid="PSA 36:7">世人投靠在你翅膀的蔭庇下！<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />他們飽嘗你家中的美食，</para>
  <para style="q1" vid="PSA 36:8">你給他們喝你喜樂河的水；<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />因為生命的泉源在於你，</para>
  <para style="q1" vid="PSA 36:9">在你的光中，我們才能看到光。<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />求你向認識你的人延續你的慈愛，</para>
  <para style="q1" vid="PSA 36:10">向心裡正直的人延續你的公義。<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />不要讓高傲人的腳靠近我，</para>
  <para style="q1" vid="PSA 36:11">不要讓惡人的手趕逐我。<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />看哪<note caller="+" style="f"><char style="fr" closed="false">36:12 </char><char style="ft" closed="false">看哪——原文直譯「在那裡」。</char></note>，作惡的人已經仆倒；</para>
  <para style="q1" vid="PSA 36:12">他們被推倒，再也不能起來。<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s">義人和惡人的結局</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">37:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />不要因作惡者而心懷不平，</para>
  <para style="q1" vid="PSA 37:1">也不要嫉妒那行不義的人，<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />因為他們就像青草快被割掉，</para>
  <para style="q1" vid="PSA 37:2">也像青綠的嫩草即將衰殘。<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />你要依靠耶和華，要行善事，</para>
  <para style="q1" vid="PSA 37:3">在地上安居，並要以信實為糧；<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />你要以耶和華為樂，</para>
  <para style="q1" vid="PSA 37:4">他就把你心裡所求的賜給你。<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />當把你的道路交託耶和華，</para>
  <para style="q1" vid="PSA 37:5">當依靠他，他必成全；<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />他將使你的公義如光發出，</para>
  <para style="q1" vid="PSA 37:6">使你的公正明<note caller="+" style="f"><char style="fr" closed="false">37:6 </char><char style="ft" closed="false">明——輔助詞語。</char></note>如正午。<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />你要在耶和華面前靜默，耐心等候他；</para>
  <para style="q1" vid="PSA 37:7">不要因那道路通達、施行詭計的人而心懷不平。<verse eid="PSA 37:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />當抑制怒氣，離棄怒火；</para>
  <para style="q1" vid="PSA 37:8">不要心懷不平，那只會導致惡事。<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />因為作惡的必被剪除，</para>
  <para style="q1" vid="PSA 37:9">唯有等候耶和華的必繼承那地。<verse eid="PSA 37:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />再過不久，惡人就不復存在；</para>
  <para style="q1" vid="PSA 37:10">你就是在他的地方仔細查找，也找不到他。<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />但謙卑的人必繼承那地，</para>
  <para style="q1" vid="PSA 37:11">以豐盛的平安為樂。<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />惡人決意要對付義人，</para>
  <para style="q1" vid="PSA 37:12">向他咬牙切齒。<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />但主必譏笑惡人，</para>
  <para style="q1" vid="PSA 37:13">因為見他受罰的<note caller="+" style="f"><char style="fr" closed="false">37:13 </char><char style="ft" closed="false">受罰的——輔助詞語。</char></note>日子將來到。<verse eid="PSA 37:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />惡人已經拔出刀劍，拉開了弓，</para>
  <para style="q1" vid="PSA 37:14">要使困苦人和貧窮人倒下，</para>
  <para style="q1" vid="PSA 37:14">要殺戮行為正直的人。<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />但惡人的刀劍將刺入自己的心，</para>
  <para style="q1" vid="PSA 37:15">他們的弓也將被打斷。<verse eid="PSA 37:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />一個義人擁有的雖少，</para>
  <para style="q1" vid="PSA 37:16">卻好過許多惡人的富有。<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />因為惡人的膀臂必被打斷，</para>
  <para style="q1" vid="PSA 37:17">耶和華卻扶助義人。<verse eid="PSA 37:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />耶和華知道純全人的日子，</para>
  <para style="q1" vid="PSA 37:18">他們的繼業長存，直到永遠。<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />他們在災禍中不致蒙羞，</para>
  <para style="q1" vid="PSA 37:19">在饑荒的日子裡也會飽足。<verse eid="PSA 37:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />然而惡人必將滅亡，</para>
  <para style="q1" vid="PSA 37:20">耶和華的仇敵如同草場<note caller="+" style="f"><char style="fr" closed="false">37:20 </char><char style="ft" closed="false">草場——或譯作「羊羔」。</char></note>的華美必將消逝——</para>
  <para style="q1" vid="PSA 37:20">如煙消逝。<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />惡人只借不還；</para>
  <para style="q1" vid="PSA 37:21">義人卻恩待人、給予人。<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />要知道，蒙耶和華祝福的，必繼承那地；</para>
  <para style="q1" vid="PSA 37:22">被耶和華詛咒的，必被剪除。<verse eid="PSA 37:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />人的腳步被耶和華所立定，</para>
  <para style="q1" vid="PSA 37:23">他的道路為耶和華所喜悅。<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />他即使仆倒，也不被拋棄，</para>
  <para style="q1" vid="PSA 37:24">因為耶和華扶助他的手。<verse eid="PSA 37:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />我曾經年少，現在老了，</para>
  <para style="q1" vid="PSA 37:25">卻未曾見過義人被離棄，</para>
  <para style="q1" vid="PSA 37:25">也未曾見過他的後裔討飯。<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />他終日恩待人、借予人，</para>
  <para style="q1" vid="PSA 37:26">連他的後裔也成為人的祝福<note caller="+" style="f"><char style="fr" closed="false">37:26 </char><char style="ft" closed="false">成為人的祝福——或譯作「必蒙福」或「成為他的祝福」。</char></note>。<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />你當遠離惡事，當行善事，</para>
  <para style="q1" vid="PSA 37:27">就必安居直到永遠；<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />因為耶和華喜愛公正，</para>
  <para style="q1" vid="PSA 37:28">不離棄他的忠信者，</para>
  <para style="q1" vid="PSA 37:28">他們必蒙保守，直到永遠；</para>
  <para style="q1" vid="PSA 37:28">而惡人的後裔必被剪除。<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />義人將繼承那地，</para>
  <para style="q1" vid="PSA 37:29">在其上永遠安居。<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />義人的口，述說智慧；</para>
  <para style="q1" vid="PSA 37:30">他的舌頭，講說公正。<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />神的律法在他心裡，</para>
  <para style="q1" vid="PSA 37:31">他的步履不會搖擺。<verse eid="PSA 37:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />惡人窺伺義人，</para>
  <para style="q1" vid="PSA 37:32">尋機置他於死地；<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />但耶和華必不將他離棄在惡人的手中；</para>
  <para style="q1" vid="PSA 37:33">在審判的時候，也不定他有罪。<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />你當等候耶和華，謹守他的道路；</para>
  <para style="q1" vid="PSA 37:34">他就高舉你，使你繼承那地；</para>
  <para style="q1" vid="PSA 37:34">惡人被剪除的時候，你必看到。<verse eid="PSA 37:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />我曾看到惡人的強橫，</para>
  <para style="q1" vid="PSA 37:35">像本地青翠的樹那樣蔓延；<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />但他很快就消逝了<note caller="+" style="f"><char style="fr" closed="false">37:36 </char><char style="ft" closed="false">他很快就消逝了——或譯作「我再經過時」。</char></note>，看哪，他不復存在！</para>
  <para style="q1" vid="PSA 37:36">雖然我尋找他，卻找不到。<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />你當留意純全的人，觀看正直的人，</para>
  <para style="q1" vid="PSA 37:37">因為這些和平的人必有前途<note caller="+" style="f"><char style="fr" closed="false">37:37 </char><char style="ft" closed="false">前途——或譯作「後代」。</char></note>。<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />但悖逆者都要被除滅，</para>
  <para style="q1" vid="PSA 37:38">惡人的前途必遭斷絕。<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />義人的拯救來自耶和華，</para>
  <para style="q1" vid="PSA 37:39">他是他們在患難時的保障。<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />耶和華幫助他們，搭救他們；</para>
  <para style="q1" vid="PSA 37:40">他搭救他們脫離惡人，把他們拯救出來，</para>
  <para style="q1" vid="PSA 37:40">因為他們投靠他。<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s">認罪祈求幫助</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的記念詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />耶和華啊，求你不要在你的震怒中責備我，</para>
  <para style="q1" vid="PSA 38:1">不要在你的怒火中管教我！<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />因為你的箭射入我身，</para>
  <para style="q1" vid="PSA 38:2">你的手壓住了我。<verse eid="PSA 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />因你的憤怒，</para>
  <para style="q1" vid="PSA 38:3">我的肉體無一處健全；</para>
  <para style="q1" vid="PSA 38:3">因我的罪過，</para>
  <para style="q1" vid="PSA 38:3">我的骨頭沒有安寧；<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />我的罪孽高過我的頭，</para>
  <para style="q1" vid="PSA 38:4">過於沉重，如同重擔。<verse eid="PSA 38:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />因我的愚妄，</para>
  <para style="q1" vid="PSA 38:5">我的傷口發臭腐爛；<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />我屈身彎腰，低到極處，</para>
  <para style="q1" vid="PSA 38:6">終日在哀痛中行走；<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />因為我的腰滿是灼痛，</para>
  <para style="q1" vid="PSA 38:7">我的肉體無一處健全。<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />我失去知覺，全然被壓碎，</para>
  <para style="q1" vid="PSA 38:8">我因內心掙扎而呻吟。<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />主啊，我全部的願望都在你面前！</para>
  <para style="q1" vid="PSA 38:9">我的嘆息也不能向你隱藏。<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />我的心劇烈跳動，我的力量離開我，</para>
  <para style="q1" vid="PSA 38:10">連我眼中的光也沒有了。<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />我所愛的人和朋友，</para>
  <para style="q1" vid="PSA 38:11">都從我禍患面前站開，</para>
  <para style="q1" vid="PSA 38:11">我的親屬也遠遠地站著。<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />那些尋索我命的設下圈套，</para>
  <para style="q1" vid="PSA 38:12">那些尋機加害我的口吐威嚇，</para>
  <para style="q1" vid="PSA 38:12">他們終日思想詭計。<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />至於我，我就像耳聾的不能聽見，</para>
  <para style="q1" vid="PSA 38:13">像啞巴不能開口。<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />我就像是一個不能聽見、</para>
  <para style="q1" vid="PSA 38:14">口中也無法辯論的人。<verse eid="PSA 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />然而耶和華啊，我期盼你！</para>
  <para style="q1" vid="PSA 38:15">我的主我的神哪，你必回應！<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />因為我曾說：</para>
  <para style="q1" vid="PSA 38:16">「不要讓他們對我幸災樂禍；</para>
  <para style="q1" vid="PSA 38:16">我的腳動搖時，</para>
  <para style="q1" vid="PSA 38:16">不要讓他們在我面前高抬自己。」<verse eid="PSA 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />是的，我快要跌倒了，</para>
  <para style="q1" vid="PSA 38:17">我的痛苦一直在我面前。<verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />我要承認我的罪孽，</para>
  <para style="q1" vid="PSA 38:18">我因自己的罪而憂傷。<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />我的仇敵活躍強盛，</para>
  <para style="q1" vid="PSA 38:19">無故恨我的人眾多。<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />那些以惡報善的人控告我，</para>
  <para style="q1" vid="PSA 38:20">因為我追求良善。<verse eid="PSA 38:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />耶和華啊，求你不要離棄我！</para>
  <para style="q1" vid="PSA 38:21">我的神哪，求你不要遠離我！<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />拯救我的主啊，</para>
  <para style="q1" vid="PSA 38:22">求你快來幫助我！<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s">人生短暫虛幻</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮<char style="pn">耶杜頓</char>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />我說：「我要謹守我的道路，</para>
  <para style="q1" vid="PSA 39:1">免得犯口舌之罪。</para>
  <para style="q1" vid="PSA 39:1">惡人還在我面前的時候，</para>
  <para style="q1" vid="PSA 39:1">我要用籠套約束我的口。」<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />我默然不語，</para>
  <para style="q1" vid="PSA 39:2">連好話也不出口，</para>
  <para style="q1" vid="PSA 39:2">我的苦痛就加劇了。<verse eid="PSA 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3" />我的心在我裡面灼熱，</para>
  <para style="q1" vid="PSA 39:3">在我哀嘆時如火中燒，</para>
  <para style="q1" vid="PSA 39:3">我就開口<note caller="+" style="f"><char style="fr" closed="false">39:3 </char><char style="ft" closed="false">開口——原文直譯「用舌頭」。</char></note>說話。<verse eid="PSA 39:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />耶和華啊，求你讓我知道我的結局，</para>
  <para style="q1" vid="PSA 39:4">以及我的年日還有多少，</para>
  <para style="q1" vid="PSA 39:4">讓我明白自己是何等短暫易逝！<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />看哪，你賜給我的年日窄如手掌，</para>
  <para style="q1" vid="PSA 39:5">我的一生在你面前如同無有；</para>
  <para style="q1" vid="PSA 39:5">所有人站得最穩的時候，也都全然虛空！<char style="qs">細拉</char><verse eid="PSA 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />人們往來行走，只是幻像；</para>
  <para style="q1" vid="PSA 39:6">他們喧鬧，也是虛空；</para>
  <para style="q1" vid="PSA 39:6">他們積聚，卻不知道誰會收取。<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />主啊，我現在等候什麼呢？</para>
  <para style="q1" vid="PSA 39:7">我的期盼就在於你！<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />求你解救我脫離一切的過犯，</para>
  <para style="q1" vid="PSA 39:8">不要使我遭受愚頑人的羞辱。<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />我默然無聲，也不開口，</para>
  <para style="q1" vid="PSA 39:9">因為這都是你所做的。<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />求你從我身上除掉你所加的打擊；</para>
  <para style="q1" vid="PSA 39:10">因你手的責打，我快要滅亡了。<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />你因人的罪孽，就用責罰管教他，</para>
  <para style="q1" vid="PSA 39:11">使他所喜愛的，像被蛀蟲吞蝕；</para>
  <para style="q1" vid="PSA 39:11">所有世人也都虛空！<char style="qs">細拉</char><verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />耶和華啊，求你垂聽我的禱告，</para>
  <para style="q1" vid="PSA 39:12">傾聽我的呼求！</para>
  <para style="q1" vid="PSA 39:12">我流淚時，求你不要沉默！</para>
  <para style="q1" vid="PSA 39:12">因為我是依靠你的外人，是寄居的，</para>
  <para style="q1" vid="PSA 39:12">像我所有的祖先那樣。<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />求你不要怒視我，</para>
  <para style="q1" vid="PSA 39:13">好使我在去而不返之前，可以重獲喜樂。<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s">等候神的必蒙憐愛</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />我切切等候耶和華，</para>
  <para style="q1" vid="PSA 40:1">他就轉向我，垂聽我的呼求。<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />他把我從荒蕪的坑裡，</para>
  <para style="q1" vid="PSA 40:2">從泥濘沼澤中拉上來；</para>
  <para style="q1" vid="PSA 40:2">他使我的腳立在磐石上，</para>
  <para style="q1" vid="PSA 40:2">又使我的腳步安穩。<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />他在我口中賜下新歌，</para>
  <para style="q1" vid="PSA 40:3">就是對我們神的讚美；</para>
  <para style="q1" vid="PSA 40:3">許多人看見就心存敬畏，</para>
  <para style="q1" vid="PSA 40:3">並要依靠耶和華。<verse eid="PSA 40:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />那以耶和華為依賴的人是蒙福的，</para>
  <para style="q1" vid="PSA 40:4">他不轉向驕傲，不偏向虛謊。<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />耶和華我的神哪，</para>
  <para style="q1" vid="PSA 40:5">你所行的奇妙作為和你向我們所懷的意念甚多，</para>
  <para style="q1" vid="PSA 40:5">沒有人能與你相比<note caller="+" style="f"><char style="fr" closed="false">40:5 </char><char style="ft" closed="false">你所行的奇妙作為和你向我們所懷的意念甚多，沒有人能與你相比——或譯作「你所行的甚多，你的奇妙作為和你向我們所懷的意念數算不盡」。</char></note>；</para>
  <para style="q1" vid="PSA 40:5">即使我要宣告述說，</para>
  <para style="q1" vid="PSA 40:5">也多得不可勝數！<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />祭物和供物不是你所喜悅的，</para>
  <para style="q1" vid="PSA 40:6">燔祭和贖罪祭不是你所要的；</para>
  <para style="q1" vid="PSA 40:6">你開通了我的耳朵，<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />那時我說：「看哪，我來了，</para>
  <para style="q1" vid="PSA 40:7">正如經卷上有關我的記載。<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />我的神哪，我喜愛遵行你的旨意！</para>
  <para style="q1" vid="PSA 40:8">你的律法在我的心裡。」<verse eid="PSA 40:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />我在廣大的會眾裡傳揚公義的佳音；</para>
  <para style="q1" vid="PSA 40:9">看哪，我不會禁止我的嘴唇！</para>
  <para style="q1" vid="PSA 40:9">耶和華啊，你是知道的。<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />我沒有把你的公義掩藏在心裡，</para>
  <para style="q1" vid="PSA 40:10">我述說了你的信實和救恩，</para>
  <para style="q1" vid="PSA 40:10">我沒有向廣大的會眾隱瞞你的慈愛和信實。<verse eid="PSA 40:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />可是你，耶和華啊，</para>
  <para style="q1" vid="PSA 40:11">求你不要向我止住你的憐憫！</para>
  <para style="q1" vid="PSA 40:11">願你的慈愛和信實一直守護我，<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />因為纏繞我的惡事無法數算，</para>
  <para style="q1" vid="PSA 40:12">我的罪孽追上我，以致我不能看見；</para>
  <para style="q1" vid="PSA 40:12">它們比我的頭髮更多，</para>
  <para style="q1" vid="PSA 40:12">我的勇氣<note caller="+" style="f"><char style="fr" closed="false">40:12 </char><char style="ft" closed="false">勇氣——原文直譯「心」。</char></note>也離棄了我。<verse eid="PSA 40:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />耶和華啊，求你開恩解救我！</para>
  <para style="q1" vid="PSA 40:13">耶和華啊，求你快來幫助我！<verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />願那些尋索要除掉我性命的，</para>
  <para style="q1" vid="PSA 40:14">一同抱愧蒙羞；</para>
  <para style="q1" vid="PSA 40:14">願那些喜歡我遭害的，後退受辱。<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />願那些對我說「啊哈，啊哈」的，</para>
  <para style="q1" vid="PSA 40:15">因自己的恥辱而驚恐。<verse eid="PSA 40:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />願所有尋求你的，都因你而高興歡喜；</para>
  <para style="q1" vid="PSA 40:16">願那些喜愛你救恩的，時常說：</para>
  <para style="q1" vid="PSA 40:16">「願耶和華被尊為大！」<verse eid="PSA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />至於我，我困苦貧窮，</para>
  <para style="q1" vid="PSA 40:17">願主顧惜我！</para>
  <para style="q1" vid="PSA 40:17">你是我的幫助、我的救主；</para>
  <para style="q1" vid="PSA 40:17">我的神哪，求你不要遲延！<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s">病中的禱告</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />眷顧貧弱者的，是蒙福的！</para>
  <para style="q1" vid="PSA 41:1">在禍患的日子裡，耶和華必搭救他。<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />耶和華要保守他，使他存活；</para>
  <para style="q1" vid="PSA 41:2">他在這地上被稱為有福的人。</para>
  <para style="q1" vid="PSA 41:2">耶和華啊<note caller="+" style="f"><char style="fr" closed="false">41:2 </char><char style="ft" closed="false">耶和華啊——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PSA 41:2">求你不要照著他仇敵的心願把他交出去！<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />他在病床上，耶和華會扶持他；</para>
  <para style="q1" vid="PSA 41:3">耶和華啊<note caller="+" style="f"><char style="fr" closed="false">41:3 </char><char style="ft" closed="false">耶和華啊——輔助詞語。</char></note>，他傷病時，</para>
  <para style="q1" vid="PSA 41:3">你使他在病榻上痊癒<note caller="+" style="f"><char style="fr" closed="false">41:3 </char><char style="ft" closed="false">你使他在病榻上痊癒——或譯作「你鋪床疊被照顧他」。</char></note>。<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />至於我，我曾說：</para>
  <para style="q1" vid="PSA 41:4">「耶和華啊，求你恩待我！</para>
  <para style="q1" vid="PSA 41:4">求你醫治我，因為我對你犯了罪。」<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />我的仇敵對我說惡言：</para>
  <para style="q1" vid="PSA 41:5">「他什麼時候會死呢？</para>
  <para style="q1" vid="PSA 41:5">他的名什麼時候消亡呢？」<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />即使他來看我，也只說假話；</para>
  <para style="q1" vid="PSA 41:6">他心中積蓄奸惡，</para>
  <para style="q1" vid="PSA 41:6">走到外面才說出來。<verse eid="PSA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />所有恨我的人都交頭接耳，一同議論我；</para>
  <para style="q1" vid="PSA 41:7">他們設計加害我，說：<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />「惡疾已臨到他身上，</para>
  <para style="q1" vid="PSA 41:8">他躺下就再也不會起來！」<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />連我信任的密友<note caller="+" style="f"><char style="fr" closed="false">41:9 </char><char style="ft" closed="false">密友——原文直譯「我的和平之人」。</char></note>，</para>
  <para style="q1" vid="PSA 41:9">就是那吃過我飯的，也抬腳踢我。<verse eid="PSA 41:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />可是你，耶和華啊，求你恩待我，</para>
  <para style="q1" vid="PSA 41:10">使我起來報復他們。<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />藉此我就知道你喜悅我：</para>
  <para style="q1" vid="PSA 41:11">我的仇敵不能向我誇勝。<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />至於我，因我的純全，你扶持我，</para>
  <para style="q1" vid="PSA 41:12">使我永遠站立在你面前。<verse eid="PSA 41:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />
    <char style="pn">以色列</char>的神耶和華是當受頌讚的，</para>
  <para style="q1" vid="PSA 41:13">從永遠到永遠<note caller="+" style="f"><char style="fr" closed="false">41:13 </char><char style="ft" closed="false">永遠到永遠——或譯作「亙古到永遠」。</char></note>！</para>
  <para style="q1" vid="PSA 41:13">阿們，阿們！<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">第二卷</para>
  <para style="mr">（<ref loc="PSA 42-72">詩篇42-72</ref>）</para>
  <para style="b" />
  <para style="s">渴想期盼神</para>
  <para style="b" />
  <para style="d">
    <char style="pn">可拉</char>子孫的智慧詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />神哪，我的靈魂切慕你，</para>
  <para style="q1" vid="PSA 42:1">如鹿切慕溪水！<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />我的靈魂渴想神，渴想永生的神。</para>
  <para style="q1" vid="PSA 42:2">我什麼時候來朝見神呢？<verse eid="PSA 42:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />我晝夜以眼淚為食；</para>
  <para style="q1" vid="PSA 42:3">人們終日對我說：「你的神在哪裡呢？」<verse eid="PSA 42:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />從前我與眾人同行，</para>
  <para style="q1" vid="PSA 42:4">在歡呼頌讚聲中帶領他們到神的殿，</para>
  <para style="q1" vid="PSA 42:4">與守節期的民眾在一起。</para>
  <para style="q1" vid="PSA 42:4">每當記起這些事，</para>
  <para style="q1" vid="PSA 42:4">我就向自己傾吐靈魂的苦情<note caller="+" style="f"><char style="fr" closed="false">42:4 </char><char style="ft" closed="false">的苦情——輔助詞語。</char></note>。<verse eid="PSA 42:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />我的靈魂哪，你為什麼沮喪？</para>
  <para style="q1" vid="PSA 42:5">為什麼在我裡面哀鳴？</para>
  <para style="q1" vid="PSA 42:5">當期盼神！</para>
  <para style="q1" vid="PSA 42:5">因為我還要為著他面前的救恩稱謝他<note caller="+" style="f"><char style="fr" closed="false">42:5 </char><char style="ft" closed="false">為著他面前的救恩稱謝他——或譯作「稱謝我面前的救恩——我的神」。</char></note>。<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />我的神哪，我的靈魂在我裡面沮喪！</para>
  <para style="q1" vid="PSA 42:6">因此我從<char style="pn">約旦</char>地、<char style="pn">黑門</char>嶺、<char style="pn">米薩</char>山記念你。<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />在你瀑布的聲音中，深淵與深淵響應；</para>
  <para style="q1" vid="PSA 42:7">你的波浪、你的洪濤全都漫過了我。<verse eid="PSA 42:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />白天，耶和華賜下他的慈愛；</para>
  <para style="q1" vid="PSA 42:8">夜間，稱頌他的歌與我相伴；</para>
  <para style="q1" vid="PSA 42:8">我向著我的生命之神禱告。<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />我要對神我的岩石說：</para>
  <para style="q1" vid="PSA 42:9">「你為什麼忘記了我呢？</para>
  <para style="q1" vid="PSA 42:9">我為什麼要在仇敵的壓迫下哀痛而行呢？」<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />我的敵人終日對我說：</para>
  <para style="q1" vid="PSA 42:10">「你的神在哪裡呢？」，</para>
  <para style="q1" vid="PSA 42:10">他們這樣辱罵我的時候，</para>
  <para style="q1" vid="PSA 42:10">好像在擊碎我的骨頭。<verse eid="PSA 42:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />我的靈魂哪，你為什麼沮喪？</para>
  <para style="q1" vid="PSA 42:11">為什麼在我裡面哀鳴？</para>
  <para style="q1" vid="PSA 42:11">當期盼神！</para>
  <para style="q1" vid="PSA 42:11">因為我還要稱謝我面前的救恩——我的神。<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s">期盼到神的住所去</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />神哪，求你為我伸冤，</para>
  <para style="q1" vid="PSA 43:1">在不忠信的國民面前，為我辯護！</para>
  <para style="q1" vid="PSA 43:1">求你救我脫離詭詐和不義的人！<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />因為你是作我保障的神。</para>
  <para style="q1" vid="PSA 43:2">你為什麼拋棄了我呢？</para>
  <para style="q1" vid="PSA 43:2">我又為什麼因仇敵的壓迫時常哀痛徘徊呢？<verse eid="PSA 43:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />求你發出你的光和真理，</para>
  <para style="q1" vid="PSA 43:3">願它們引導我，</para>
  <para style="q1" vid="PSA 43:3">將我帶到你的聖山，</para>
  <para style="q1" vid="PSA 43:3">帶到你的居所。<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />我就來到神的祭壇，</para>
  <para style="q1" vid="PSA 43:4">來到神——我最大的喜樂那裡；</para>
  <para style="q1" vid="PSA 43:4">神哪，我的神，</para>
  <para style="q1" vid="PSA 43:4">我要用豎琴稱謝你！<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />我的靈魂哪，你為什麼沮喪？</para>
  <para style="q1" vid="PSA 43:5">為什麼在我裡面哀鳴？</para>
  <para style="q1" vid="PSA 43:5">當期盼神！</para>
  <para style="q1" vid="PSA 43:5">因為我還要稱謝我面前的救恩——我的神。<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s">求神不丟棄</para>
  <para style="b" />
  <para style="d">
    <char style="pn">可拉</char>子孫的智慧詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />神哪，你在古時，在我們祖先的日子裡所做的事，</para>
  <para style="q1" vid="PSA 44:1">我們親耳聽見了，我們的祖先也向我們講述過。<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />你親手趕出列國，卻栽培了我們的祖先；</para>
  <para style="q1" vid="PSA 44:2">你向萬民降災禍，卻使我們的祖先興旺。<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />要知道，他們占有土地不是靠自己的刀劍，</para>
  <para style="q1" vid="PSA 44:3">他們得拯救不是靠自己的膀臂，</para>
  <para style="q1" vid="PSA 44:3">而是靠你的右手、你的膀臂和你的容光，</para>
  <para style="q1" vid="PSA 44:3">因你喜悅他們。<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />神哪，你是我的王，</para>
  <para style="q1" vid="PSA 44:4">求你命定<char style="pn">雅各</char>得拯救！<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />藉著你，我們衝垮我們的敵人；</para>
  <para style="q1" vid="PSA 44:5">奉你的名，我們踐踏那些起來敵對我們的人；<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />因為我不是依靠我的弓，</para>
  <para style="q1" vid="PSA 44:6">我的刀劍也不能拯救我。<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />然而你拯救我們脫離我們的敵人，</para>
  <para style="q1" vid="PSA 44:7">使恨我們的人蒙羞。<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />我們終日以神誇耀，</para>
  <para style="q1" vid="PSA 44:8">要稱頌你的名，直到永遠。<char style="qs">細拉</char><verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />但如今，你拋棄了我們，使我們受辱，</para>
  <para style="q1" vid="PSA 44:9">不與我們的隊伍一同出征。<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />你使我們從敵人面前轉身退後；</para>
  <para style="q1" vid="PSA 44:10">那些恨我們的人任意搶掠。<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />你把我們交出，如同作食物的羊；</para>
  <para style="q1" vid="PSA 44:11">你又把我們打散在列國中。<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />你把你的子民廉價賣掉，</para>
  <para style="q1" vid="PSA 44:12">並沒有從他們的售價多獲利益。<verse eid="PSA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />你使我們被鄰居羞辱，</para>
  <para style="q1" vid="PSA 44:13">被周圍人嘲笑和諷刺。<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />你使我們在列國中成為笑柄，</para>
  <para style="q1" vid="PSA 44:14">在萬族中被人搖頭嘲笑<note caller="+" style="f"><char style="fr" closed="false">44:14 </char><char style="ft" closed="false">嘲笑——輔助詞語。</char></note>。<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />我的羞愧終日在我面前，</para>
  <para style="q1" vid="PSA 44:15">我臉上的恥辱掩蓋了我。<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />這是因辱罵者和褻瀆者的聲音，</para>
  <para style="q1" vid="PSA 44:16">是因仇敵和報復者的緣故。<verse eid="PSA 44:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />這一切臨到我們，</para>
  <para style="q1" vid="PSA 44:17">但我們沒有忘記你，也沒有背棄你的約。<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />我們的心沒有向後退縮，</para>
  <para style="q1" vid="PSA 44:18">我們的步履沒有偏離你的道路。<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />然而你在豺狗出沒之地壓垮我們，</para>
  <para style="q1" vid="PSA 44:19">用死蔭籠罩我們。<verse eid="PSA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />如果我們忘記了我們神的名，</para>
  <para style="q1" vid="PSA 44:20">或伸開雙手向外族的神明禱告<note caller="+" style="f"><char style="fr" closed="false">44:20 </char><char style="ft" closed="false">禱告——輔助詞語。</char></note>，<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />難道神不會洞察這事嗎？</para>
  <para style="q1" vid="PSA 44:21">要知道，他明白人心裡的隱祕。<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />然而為你的緣故，我們終日被置於死地，</para>
  <para style="q1" vid="PSA 44:22">被看為要宰殺的羊。<verse eid="PSA 44:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />主啊，求你醒起！</para>
  <para style="q1" vid="PSA 44:23">你為什麼還在沉睡？</para>
  <para style="q1" vid="PSA 44:23">求你醒來，不要永久拋棄我們！<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />你為什麼要隱藏你的臉，</para>
  <para style="q1" vid="PSA 44:24">忘記我們所受的苦難和壓迫呢？<verse eid="PSA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />我們的靈魂沉淪在塵土中，</para>
  <para style="q1" vid="PSA 44:25">我們的肚腹緊貼在地。<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />求你起來幫助我們，</para>
  <para style="q1" vid="PSA 44:26">為你慈愛的緣故救贖我們！<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s">榮耀的婚禮歌</para>
  <para style="b" />
  <para style="d">
    <char style="pn">可拉</char>子孫的智慧詩，愛慕之歌，給樂隊指揮，用「百合花」曲調。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />我的心湧出優美的言詞，</para>
  <para style="q1" vid="PSA 45:1">我為王朗誦我的作品，</para>
  <para style="q1" vid="PSA 45:1">我的舌頭是老練文士的筆。<verse eid="PSA 45:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />你比世人更美，</para>
  <para style="q1" vid="PSA 45:2">恩惠澆灌在你的嘴唇上，</para>
  <para style="q1" vid="PSA 45:2">因此神祝福你，直到永遠。<verse eid="PSA 45:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />勇士啊，當把刀劍在腿上束好，</para>
  <para style="q1" vid="PSA 45:3">帶著你的尊榮和威嚴！<verse eid="PSA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />為真理、謙卑和公義的緣故，</para>
  <para style="q1" vid="PSA 45:4">帶著你的威嚴乘勝前進！</para>
  <para style="q1" vid="PSA 45:4">願你的右手向你顯明可畏的事！<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />你的箭矢尖銳，射入王的仇敵的心；</para>
  <para style="q1" vid="PSA 45:5">萬民都仆倒在你之下。<verse eid="PSA 45:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />神哪，你的寶座是永永遠遠的，</para>
  <para style="q1" vid="PSA 45:6">你國度的權杖是正直的權杖！<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />你愛公義，恨邪惡；</para>
  <para style="q1" vid="PSA 45:7">因此神，就是你的神，</para>
  <para style="q1" vid="PSA 45:7">用喜樂的油膏抹你，勝過膏抹你的同伴。<verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />你的衣服都有沒藥、沉香、桂皮的香氣<note caller="+" style="f"><char style="fr" closed="false">45:8 </char><char style="ft" closed="false">的香氣——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PSA 45:8">在象牙宮殿裡有絲弦樂器聲使你歡喜。<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />屬你的尊貴婦女中，有君王們的女兒；</para>
  <para style="q1" vid="PSA 45:9">王后佩戴<char style="pn">俄斐</char>的黃金，站在你右邊。<verse eid="PSA 45:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />女兒啊，你要聽、要看、要側耳聽——</para>
  <para style="q1" vid="PSA 45:10">你當忘記你的民和你的父家！<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />願王渴慕你的美麗！</para>
  <para style="q1" vid="PSA 45:11">因他是你的主，你當向他下拜！<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />
    <char style="pn">提爾</char>女子將帶著禮物而來，</para>
  <para style="q1" vid="PSA 45:12">民中的富人將懇求你的情面。<verse eid="PSA 45:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />王的女兒在宮殿<note caller="+" style="f"><char style="fr" closed="false">45:13 </char><char style="ft" closed="false">宮殿——輔助詞語。</char></note>裡極其榮華，</para>
  <para style="q1" vid="PSA 45:13">她的衣袍上有金線的刺繡。<verse eid="PSA 45:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14" />她身穿彩衣，被領到王那裡；</para>
  <para style="q1" vid="PSA 45:14">她後面陪伴著的童女們也被帶到你那裡。<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />她們在歡喜和快樂中被引領，</para>
  <para style="q1" vid="PSA 45:15">進入王的宮殿。<verse eid="PSA 45:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />你的子孫將接續你的祖先，</para>
  <para style="q1" vid="PSA 45:16">你將設立他們在全地作首領。<verse eid="PSA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />我要使你的名萬世萬代被記念，</para>
  <para style="q1" vid="PSA 45:17">萬民將因此稱謝你，直到永永遠遠。<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s">神與我們同在</para>
  <para style="b" />
  <para style="d">
    <char style="pn">可拉</char>子孫的歌，給樂隊指揮，用「少女」曲調<note caller="+" style="f"><char style="fr" closed="false">46:0 </char><char style="ft" closed="false">用「少女」曲調——或譯作「調用阿拉莫特」。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />神是我們的避難所和力量，</para>
  <para style="q1" vid="PSA 46:1">是患難中隨時可得的幫助，<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />因此我們不害怕——</para>
  <para style="q1" vid="PSA 46:2">即使大地變動，</para>
  <para style="q1" vid="PSA 46:2">群山動搖墜入大海深處；<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />即使海水咆哮、翻騰，</para>
  <para style="q1" vid="PSA 46:3">群山因海水上漲而震動，</para>
  <para style="q1" vid="PSA 46:3">我們也不害怕。<char style="qs">細拉</char><verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />有一條河，它的眾支流使神的城歡喜；</para>
  <para style="q1" vid="PSA 46:4">這城是至高者神聖的居所。<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />神在這城當中，城就不致動搖；</para>
  <para style="q1" vid="PSA 46:5">清晨來臨，神就幫助它。<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />列邦喧鬧，列國動搖；</para>
  <para style="q1" vid="PSA 46:6">神發出聲音，大地就消融。<verse eid="PSA 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />萬軍之耶和華與我們同在，</para>
  <para style="q1" vid="PSA 46:7">
    <char style="pn">雅各</char>的神是我們的庇護所。<char style="qs">細拉</char><verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />你們當來，觀察耶和華的作為！</para>
  <para style="q1" vid="PSA 46:8">他在地上行了令人驚駭的事<note caller="+" style="f"><char style="fr" closed="false">46:8 </char><char style="ft" closed="false">在地上行了令人驚駭的事——依據七十士譯本；或譯作「使大地成為荒場」。</char></note>；<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />他使戰爭止息，直到地極；</para>
  <para style="q1" vid="PSA 46:9">他打斷弓、砍斷矛，</para>
  <para style="q1" vid="PSA 46:9">用烈火燒毀戰車。<verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />「平靜吧，當明白我是神！</para>
  <para style="q1" vid="PSA 46:10">我必在列國中受尊崇，必在全地受尊崇。」<verse eid="PSA 46:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />萬軍之耶和華與我們同在，</para>
  <para style="q1" vid="PSA 46:11">
    <char style="pn">雅各</char>的神是我們的庇護所。<char style="qs">細拉</char><verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s">神是全地的偉大君王</para>
  <para style="b" />
  <para style="d">
    <char style="pn">可拉</char>子孫的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />萬民哪，你們當鼓掌，</para>
  <para style="q1" vid="PSA 47:1">當用歡呼的聲音向神呼喊！<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />因為耶和華至高者是可畏的，</para>
  <para style="q1" vid="PSA 47:2">他是全地之上的大君王。<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />他使萬民降服在我們之下，</para>
  <para style="q1" vid="PSA 47:3">使萬族降服在我們腳下。<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />他為我們揀選了繼業，</para>
  <para style="q1" vid="PSA 47:4">就是他所愛的<char style="pn">雅各</char>的榮耀<note caller="+" style="f"><char style="fr" closed="false">47:4 </char><char style="ft" closed="false">雅各的榮耀——指迦南地。</char></note>。<char style="qs">細拉</char><verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />神在歡呼中上升，</para>
  <para style="q1" vid="PSA 47:5">耶和華在號角聲中上升。<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />你們當歌頌，歌頌神！</para>
  <para style="q1" vid="PSA 47:6">你們當歌頌，歌頌我們的王；<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />因為神是全地的王。</para>
  <para style="q1" vid="PSA 47:7">你們當用智慧詩來歌頌他！<verse eid="PSA 47:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />神在列國之上作王，</para>
  <para style="q1" vid="PSA 47:8">在他神聖的寶座上坐著為王。<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />萬民中高貴的人聚集，</para>
  <para style="q1" vid="PSA 47:9">作<char style="pn">亞伯拉罕</char>之神的子民；</para>
  <para style="q1" vid="PSA 47:9">因為地上的盾牌<note caller="+" style="f"><char style="fr" closed="false">47:9 </char><char style="ft" closed="false">盾牌——指君王。</char></note>都屬於神，</para>
  <para style="q1" vid="PSA 47:9">他極其受尊崇。<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s">讚美偉大君王的城</para>
  <para style="b" />
  <para style="d">
    <char style="pn">可拉</char>子孫的詩，一首歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />耶和華真偉大，</para>
  <para style="q1" vid="PSA 48:1">在我們神的城中，在他的聖山上，</para>
  <para style="q1" vid="PSA 48:1">當受極大的讚美！<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />
    <char style="pn">錫安</char>山——大君王的城，在北方的極處，</para>
  <para style="q1" vid="PSA 48:2">高聳美麗，是全地的喜樂。<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />神在城的堡壘中，</para>
  <para style="q1" vid="PSA 48:3">顯明自己是庇護所。<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />看哪，君王們會合，</para>
  <para style="q1" vid="PSA 48:4">一同過去；<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />他們看見這城就感到驚愕惶恐，</para>
  <para style="q1" vid="PSA 48:5">慌忙逃走；<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />他們在那裡渾身顫抖，</para>
  <para style="q1" vid="PSA 48:6">劇痛像婦人臨產那樣。<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />神哪<note caller="+" style="f"><char style="fr" closed="false">48:7 </char><char style="ft" closed="false">神哪——輔助詞語。</char></note>，你用東風打破<char style="pn">塔爾施</char>的船隻。<verse eid="PSA 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />在萬軍之耶和華的城中，就是我們神的城中，</para>
  <para style="q1" vid="PSA 48:8">我們所看見的正如所聽見的：</para>
  <para style="q1" vid="PSA 48:8">神必堅立這城，直到永遠。<char style="qs">細拉</char><verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />神哪，我們在你的聖殿中思想你的慈愛！<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />神哪，你當受的讚美正如你的名，也達到地極！</para>
  <para style="q1" vid="PSA 48:10">你的右手充滿公義。<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />願<char style="pn">錫安</char>山因你的審判而歡喜，</para>
  <para style="q1" vid="PSA 48:11">願<char style="pn">猶大</char>的村鎮因此而快樂。<verse eid="PSA 48:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />你們當周遊<char style="pn">錫安</char>，環繞這城，</para>
  <para style="q1" vid="PSA 48:12">數算她的塔樓，<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />留心她的城垣，巡察她的城堡，</para>
  <para style="q1" vid="PSA 48:13">為要向後代講述；<verse eid="PSA 48:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />因為這位神永永遠遠是我們的神，</para>
  <para style="q1" vid="PSA 48:14">他必引領我們到底<note caller="+" style="f"><char style="fr" closed="false">48:14 </char><char style="ft" closed="false">到底——或譯作「直到我們死的時候」或「直到永遠」。</char></note>。<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s">富貴榮華不足以依靠</para>
  <para style="b" />
  <para style="d">
    <char style="pn">可拉</char>子孫的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />萬民哪，你們當聽這話！</para>
  <para style="q1" vid="PSA 49:1">世上所有的居民哪，<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />無論地位高低、或貧或富，</para>
  <para style="q1" vid="PSA 49:2">都當傾聽！<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />我口出智慧，</para>
  <para style="q1" vid="PSA 49:3">心思聰慧。<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />我要側耳聽箴言，</para>
  <para style="q1" vid="PSA 49:4">彈豎琴解開謎題。<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />在禍患的日子，在欺詐之徒的奸惡圍繞我時，</para>
  <para style="q1" vid="PSA 49:5">我為什麼要害怕呢？<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />他們只是依靠財富、</para>
  <para style="q1" vid="PSA 49:6">自誇多財的人。<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />人實在不能救贖弟兄，</para>
  <para style="q1" vid="PSA 49:7">也不能把他的贖價交給神，<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />——因為靈魂的贖價昂貴，</para>
  <para style="q1" vid="PSA 49:8">人只好永遠罷休——<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />好使他永久存活，</para>
  <para style="q1" vid="PSA 49:9">不看到陰坑<note caller="+" style="f"><char style="fr" closed="false">49:9 </char><char style="ft" closed="false">不看到陰坑——或譯作「不經歷腐朽」。</char></note>。<verse eid="PSA 49:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />要知道，人必看見智慧人也會死；</para>
  <para style="q1" vid="PSA 49:10">愚昧人和愚拙人一同滅亡，</para>
  <para style="q1" vid="PSA 49:10">把他們的財富留給別人。<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />他們以為自己的家必存到永遠，</para>
  <para style="q1" vid="PSA 49:11">他們的居所必存到萬代；</para>
  <para style="q1" vid="PSA 49:11">他們用自己的名字給土地命名。<note caller="+" style="f"><char style="fr" closed="false">49:11 </char><char style="ft" closed="false">此節或譯作：儘管他們用自己的名字給土地命名，他們的墳墓卻是他們永遠的家，是他們世世代代的住所。</char></note><verse eid="PSA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />可是人在尊榮中不能持久，</para>
  <para style="q1" vid="PSA 49:12">就像要滅亡的牲畜一樣。<verse eid="PSA 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />這就是那些愚昧之人的道路，</para>
  <para style="q1" vid="PSA 49:13">也是以後那些喜悅他們話語之人的道路。<char style="qs">細拉</char><verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />他們像註定下到陰間的羊群，</para>
  <para style="q1" vid="PSA 49:14">死亡將作他們的牧者<note caller="+" style="f"><char style="fr" closed="false">49:14 </char><char style="ft" closed="false">作他們的牧者——或譯作「以他們為食」。</char></note>；</para>
  <para style="q1" vid="PSA 49:14">到了早晨，正直人將管轄他們。</para>
  <para style="q1" vid="PSA 49:14">他們的形體必被陰間吞噬，無處容身。<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />然而神將救贖我的靈魂脫離陰間的權勢，</para>
  <para style="q1" vid="PSA 49:15">他必會把我接去。<char style="qs">細拉</char><verse eid="PSA 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />當有人變得富有，</para>
  <para style="q1" vid="PSA 49:16">他家中的尊榮增多的時候，</para>
  <para style="q1" vid="PSA 49:16">你不要害怕，<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />因為他死的時候，什麼都帶不走，</para>
  <para style="q1" vid="PSA 49:17">他的尊榮也不能隨著他下去。<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />雖然人活著的時候自誇為有福，說：</para>
  <para style="q1" vid="PSA 49:18">「只要你做得好，人們就會稱讚你」，<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />但他的靈魂卻要歸到他歷代的祖先那裡，</para>
  <para style="q1" vid="PSA 49:19">永遠不再看到光。<verse eid="PSA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />人在尊榮中卻沒有悟性，</para>
  <para style="q1" vid="PSA 49:20">就像要滅亡的牲畜一樣。<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s">真誠的敬拜</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />大能的神耶和華已經發話，</para>
  <para style="q1" vid="PSA 50:1">他從日出之地到日落之處呼喚大地。<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />從美麗絕倫的<char style="pn">錫安</char>，</para>
  <para style="q1" vid="PSA 50:2">神發出光芒。<verse eid="PSA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />我們的神來臨，絕不沉默；</para>
  <para style="q1" vid="PSA 50:3">烈火在他面前吞噬，暴風在他四圍颳起。<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />他向天上、向大地呼喚，</para>
  <para style="q1" vid="PSA 50:4">為要審判自己的子民；<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />他說：「把我的忠信者招聚到我這裡來，</para>
  <para style="q1" vid="PSA 50:5">他們是那些用祭物與我立約的人。」<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />諸天宣告神的公義，</para>
  <para style="q1" vid="PSA 50:6">因為神才是審判者。<char style="qs">細拉</char><verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />「聽啊，我的子民，我要說話！</para>
  <para style="q1" vid="PSA 50:7">
    <char style="pn">以色列</char>啊，我要警誡你！</para>
  <para style="q1" vid="PSA 50:7">我是神，是你的神。<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />我不是因你的祭物責備你，</para>
  <para style="q1" vid="PSA 50:8">你的燔祭一直在我面前。<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />我不從你家裡拿公牛，</para>
  <para style="q1" vid="PSA 50:9">不從你羊圈裡拿公山羊；<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />因為森林中的百獸是我的，</para>
  <para style="q1" vid="PSA 50:10">千山上的牲畜也是我的。<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />群山一切的飛鳥，我都認識，</para>
  <para style="q1" vid="PSA 50:11">田野一切的動物也都屬我。<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />我就算飢餓，也不用對你說，</para>
  <para style="q1" vid="PSA 50:12">因為世界和其中所充滿的都是我的。<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />難道我吃壯牛的肉，</para>
  <para style="q1" vid="PSA 50:13">喝公山羊的血嗎？<verse eid="PSA 50:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />你要向神獻上感謝為祭，</para>
  <para style="q1" vid="PSA 50:14">又要向至高者還你所許的願。<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />在患難的日子裡，你當呼求我，</para>
  <para style="q1" vid="PSA 50:15">我必搭救你，而你將榮耀我。」<verse eid="PSA 50:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16" />但神對惡人說：</para>
  <para style="q1" vid="PSA 50:16">「你憑什麼講述我的律例，</para>
  <para style="q1" vid="PSA 50:16">口中提起我的約呢？<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />實際上，你恨惡管教，</para>
  <para style="q1" vid="PSA 50:17">把我的話語拋在身後。<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />你看見盜賊時，就喜悅與他在一起，</para>
  <para style="q1" vid="PSA 50:18">你又與通姦的人一同有份。<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />你讓嘴巴發出奸惡，</para>
  <para style="q1" vid="PSA 50:19">讓舌頭編造謊言。<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />你坐著說話攻擊你的弟兄，</para>
  <para style="q1" vid="PSA 50:20">毀謗你母親的兒子。<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />你做了這些，我還保持沉默；</para>
  <para style="q1" vid="PSA 50:21">你就以為我完全像你一樣；</para>
  <para style="q1" vid="PSA 50:21">其實我要責備你，並且把這些擺列在你眼前。<verse eid="PSA 50:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />忘記神的人哪，你們當領悟這事，</para>
  <para style="q1" vid="PSA 50:22">免得我撕碎你們，沒有人解救！<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />那獻上感謝為祭的，就是榮耀我；</para>
  <para style="q1" vid="PSA 50:23">那使自己道路正直的，</para>
  <para style="q1" vid="PSA 50:23">我必使他得見神的救恩。」<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">真誠的痛悔</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。那時先知<char style="pn">拿單</char>在<char style="pn">大衛</char>與<char style="pn">芭示巴</char>同房之後來到他那裡。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />神哪，求你照著你的慈愛恩待我，</para>
  <para style="q1" vid="PSA 51:1">照著你豐盛的憐憫抹掉我的過犯！<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />求你徹底洗滌我的罪孽，</para>
  <para style="q1" vid="PSA 51:2">潔淨我的罪；<verse eid="PSA 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />因為我知道我的過犯，</para>
  <para style="q1" vid="PSA 51:3">我的罪一直在我面前。<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />我對你，唯獨對你犯了罪，</para>
  <para style="q1" vid="PSA 51:4">我做了你眼中看為惡的事；</para>
  <para style="q1" vid="PSA 51:4">因此你說話的時候就顯為公義，</para>
  <para style="q1" vid="PSA 51:4">你審判的時候就顯為清正。<verse eid="PSA 51:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />看哪，我在罪孽裡出生；</para>
  <para style="q1" vid="PSA 51:5">我母親懷胎時，我就在罪中！<verse eid="PSA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />看哪，你喜悅內心深處的誠實，</para>
  <para style="q1" vid="PSA 51:6">你使我在內心的<note caller="+" style="f"><char style="fr" closed="false">51:6 </char><char style="ft" closed="false">內心的——輔助詞語。</char></note>隱祕處明白智慧！<verse eid="PSA 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />求你用牛膝草潔淨我，我就得潔淨；</para>
  <para style="q1" vid="PSA 51:7">求你洗滌我，我就比雪更潔白。<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />求你讓我聽到歡樂和喜悅的聲音，</para>
  <para style="q1" vid="PSA 51:8">使你所壓碎的骨頭得以快樂。<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />求你隱藏你的臉，不看我的罪過；</para>
  <para style="q1" vid="PSA 51:9">抹掉我一切的罪孽。<verse eid="PSA 51:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />神哪，求你為我造一顆純淨的心，</para>
  <para style="q1" vid="PSA 51:10">使我裡面重新有堅定的靈！<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />不要從你面前把我丟棄，</para>
  <para style="q1" vid="PSA 51:11">不要從我身上收回你的聖靈。<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />求你使救恩之樂復歸於我，</para>
  <para style="q1" vid="PSA 51:12">賜甘心樂意的靈來扶助我。<verse eid="PSA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />我就把你的道教導有過犯的人，</para>
  <para style="q1" vid="PSA 51:13">罪人必回轉歸向你。<verse eid="PSA 51:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />神哪，拯救我的神，</para>
  <para style="q1" vid="PSA 51:14">求你救我脫離殺人流血的罪，</para>
  <para style="q1" vid="PSA 51:14">我的舌頭就頌唱你的公義！<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />主啊，求你使我的嘴唇張開，</para>
  <para style="q1" vid="PSA 51:15">我的口就宣告你當受的讚美！<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />你所喜悅的不是祭物，</para>
  <para style="q1" vid="PSA 51:16">否則我就會獻上；</para>
  <para style="q1" vid="PSA 51:16">燔祭也不是你所悅納的。<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />神所要的祭物，就是破碎的靈；</para>
  <para style="q1" vid="PSA 51:17">神哪，破碎、痛悔的心，你必不輕視！<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />求你以你的恩典善待<char style="pn">錫安</char>，</para>
  <para style="q1" vid="PSA 51:18">建造<char style="pn">耶路撒冷</char>的城牆。<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />那時你必喜悅公義的祭物，</para>
  <para style="q1" vid="PSA 51:19">就是燔祭和全燒祭；</para>
  <para style="q1" vid="PSA 51:19">那時人們必把公牛獻在你的祭壇上。<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s">神審判詭詐的人</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的智慧詩，給樂隊指揮。那時<char style="pn">以東</char>人<char style="pn">多益</char>來向<char style="pn">掃羅</char>報告，對他說：「<char style="pn">大衛</char>到了<char style="pn">亞希米勒</char>的家。」</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />勇士啊，你為什麼以作惡自誇呢？</para>
  <para style="q1" vid="PSA 52:1">神的慈愛是長存的<note caller="+" style="f"><char style="fr" closed="false">52:1 </char><char style="ft" closed="false">是長存的——原文直譯「終日」。</char></note>！<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />行事詭詐的人哪，</para>
  <para style="q1" vid="PSA 52:2">你的舌頭謀算奸惡，</para>
  <para style="q1" vid="PSA 52:2">如同磨利的剃刀！<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />你喜愛作惡勝過行善，</para>
  <para style="q1" vid="PSA 52:3">喜愛撒謊勝過說公正的話。<char style="qs">細拉</char><verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />欺詐的舌頭啊，</para>
  <para style="q1" vid="PSA 52:4">你喜愛一切吞滅人的話！<verse eid="PSA 52:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />為此神要把你永久拆毀，</para>
  <para style="q1" vid="PSA 52:5">他會抓住你，把你從帳篷裡拖出來，</para>
  <para style="q1" vid="PSA 52:5">把你從活人之地連根拔出。<char style="qs">細拉</char><verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />義人看見，就會心存敬畏，</para>
  <para style="q1" vid="PSA 52:6">並且譏笑這人：<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />「看哪，這個人不把神當作自己的保障，</para>
  <para style="q1" vid="PSA 52:7">他依靠自己豐盛的財富，</para>
  <para style="q1" vid="PSA 52:7">投靠自己的貪慾<note caller="+" style="f"><char style="fr" closed="false">52:7 </char><char style="ft" closed="false">投靠自己的貪慾——或譯作「以自己的奸惡為保障」。</char></note>。」<verse eid="PSA 52:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />至於我，我就像神殿中青翠的橄欖樹，</para>
  <para style="q1" vid="PSA 52:8">永永遠遠依靠神的慈愛。<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />我要稱謝你，直到永遠，</para>
  <para style="q1" vid="PSA 52:9">因為你已經成就了這一切！</para>
  <para style="q1" vid="PSA 52:9">我要在你忠信者面前仰望你的名，</para>
  <para style="q1" vid="PSA 52:9">因為你的名是美好的！<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s">神棄絕愚頑人</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的智慧詩，給樂隊指揮，用「麻哈拉」曲調。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />愚頑人心裡說：「沒有神！」</para>
  <para style="q1" vid="PSA 53:1">他們敗壞，行事可憎不義；</para>
  <para style="q1" vid="PSA 53:1">沒有人行善。<verse eid="PSA 53:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />神從天上俯看世人，</para>
  <para style="q1" vid="PSA 53:2">要看是否有明達人，是否有尋求神的人。<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />他們全都背道，一同墮落；</para>
  <para style="q1" vid="PSA 53:3">沒有行善的，連一個也沒有！<verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />難道作惡的人都不明白嗎？</para>
  <para style="q1" vid="PSA 53:4">他們吞噬我的子民像吃飯那樣，</para>
  <para style="q1" vid="PSA 53:4">他們不呼求神。<verse eid="PSA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />他們在無可恐懼之處也會大大恐懼；</para>
  <para style="q1" vid="PSA 53:5">因為神打散了那些紮營攻擊你之人的骨頭。</para>
  <para style="q1" vid="PSA 53:5">你使他們蒙羞，因為神厭棄他們。<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />但願<char style="pn">以色列</char>的救恩來自<char style="pn">錫安</char>！</para>
  <para style="q1" vid="PSA 53:6">神使他流亡的子民回歸<note caller="+" style="f"><char style="fr" closed="false">53:6 </char><char style="ft" closed="false">使他流亡的子民回歸——或譯作「復興他子民的家業」。</char></note>時，</para>
  <para style="q1" vid="PSA 53:6">願<char style="pn">雅各</char>快樂，願<char style="pn">以色列</char>歡喜！<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s">求神拯救脫離仇敵</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的智慧詩，給樂隊指揮，用弦樂器。那時<char style="pn">西弗</char>人來對<char style="pn">掃羅</char>說：「<char style="pn">大衛</char>不就躲藏在我們這裡嗎？」</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />神哪，求你因你的名拯救我，</para>
  <para style="q1" vid="PSA 54:1">以你的大能為我伸冤！<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />神哪，求你垂聽我的禱告，</para>
  <para style="q1" vid="PSA 54:2">傾聽我口中的言語！<verse eid="PSA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />因為外族人起來攻擊我，</para>
  <para style="q1" vid="PSA 54:3">強橫的人尋索我的性命，</para>
  <para style="q1" vid="PSA 54:3">他們不把神放在眼裡。<char style="qs">細拉</char><verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />看哪，神是我的幫助，</para>
  <para style="q1" vid="PSA 54:4">主是扶持我性命的！<verse eid="PSA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />願他使我仇敵所做的惡回報到他們身上；</para>
  <para style="q1" vid="PSA 54:5">神哪<note caller="+" style="f"><char style="fr" closed="false">54:5 </char><char style="ft" closed="false">神哪——輔助詞語。</char></note>，求你因你的信實而除盡他們。<verse eid="PSA 54:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />我要向你獻上甘心祭；</para>
  <para style="q1" vid="PSA 54:6">耶和華啊，我要稱頌你的名，</para>
  <para style="q1" vid="PSA 54:6">因為你的名是美好的！<verse eid="PSA 54:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />他解救我脫離了一切患難，</para>
  <para style="q1" vid="PSA 54:7">我的眼睛已經看到我仇敵的下場<note caller="+" style="f"><char style="fr" closed="false">54:7 </char><char style="ft" closed="false">的下場——輔助詞語。</char></note>。<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s">同伴的出賣</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的智慧詩，給樂隊指揮，用弦樂器。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />神哪，求你傾聽我的禱告，</para>
  <para style="q1" vid="PSA 55:1">不要不理睬我的懇求！<verse eid="PSA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2" />求你留心聽、回應我！</para>
  <para style="q1" vid="PSA 55:2">我在苦惱中煩躁不安，發出哀嘆；<verse eid="PSA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3" />這是因仇敵的聲音、因惡人壓迫的緣故；</para>
  <para style="q1" vid="PSA 55:3">是的，他們使壞事落在我身上，</para>
  <para style="q1" vid="PSA 55:3">並在怒氣中追逼我。<verse eid="PSA 55:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />我的心在我裡面痛苦，</para>
  <para style="q1" vid="PSA 55:4">死亡的恐怖落在我身上。<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />懼怕和戰兢臨到我，</para>
  <para style="q1" vid="PSA 55:5">驚駭籠罩著我。<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />於是我說：「但願我像鴿子那樣有翅膀！</para>
  <para style="q1" vid="PSA 55:6">我就飛走，得以安居。<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />看哪，我要遠走高飛，</para>
  <para style="q1" vid="PSA 55:7">在曠野中住宿！<char style="qs">細拉</char><verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />我要快快地到我的避難所，</para>
  <para style="q1" vid="PSA 55:8">避開肆虐的風，避開風暴。」<verse eid="PSA 55:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />主啊，求你使他們混亂，變亂他們的言語<note caller="+" style="f"><char style="fr" closed="false">55:9 </char><char style="ft" closed="false">求你使他們混亂，變亂他們的言語——或譯作「求你使他們的言語變亂、混亂」。</char></note>！</para>
  <para style="q1" vid="PSA 55:9">因為我在城中看見殘暴和爭競：<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />它們晝夜在城牆上繞行，</para>
  <para style="q1" vid="PSA 55:10">壞事和禍患也在城中；<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />奸惡在城中，</para>
  <para style="q1" vid="PSA 55:11">欺壓和詭詐不離它的街市。<verse eid="PSA 55:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />其實不是仇敵辱罵我——</para>
  <para style="q1" vid="PSA 55:12">如果是，我還可以承受；</para>
  <para style="q1" vid="PSA 55:12">也不是恨我的人在我面前高抬自己——</para>
  <para style="q1" vid="PSA 55:12">如果是，我還可以躲藏。<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />但竟然是你，是與我一樣的人，</para>
  <para style="q1" vid="PSA 55:13">是我的同伴、我的知己！<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />我們曾經一起親密交流，</para>
  <para style="q1" vid="PSA 55:14">與會眾一起走在神的殿中。<verse eid="PSA 55:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />願死亡突然毀滅他們，</para>
  <para style="q1" vid="PSA 55:15">願他們活活下到陰間！</para>
  <para style="q1" vid="PSA 55:15">因為惡事在他們的住處，</para>
  <para style="q1" vid="PSA 55:15">就在他們當中。<verse eid="PSA 55:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />至於我，我要向神呼求，</para>
  <para style="q1" vid="PSA 55:16">耶和華必拯救我。<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />晚上、早晨、中午，</para>
  <para style="q1" vid="PSA 55:17">我都要悲訴哀鳴，</para>
  <para style="q1" vid="PSA 55:17">他必垂聽我的聲音。<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />他救贖我的性命脫離攻擊我的人，</para>
  <para style="q1" vid="PSA 55:18">使我得享平安，</para>
  <para style="q1" vid="PSA 55:18">儘管敵對我的人眾多。<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />從太初就坐著為王的神聽見了，</para>
  <para style="q1" vid="PSA 55:19">就苦待他們。<char style="qs">細拉</char></para>
  <para style="q1" vid="PSA 55:19">這是因他們不悔改，也不敬畏神。<verse eid="PSA 55:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />我的同伴<note caller="+" style="f"><char style="fr" closed="false">55:20 </char><char style="ft" closed="false">我的同伴——原文直譯「他」，指55:13的「人」。</char></note>伸手對付自己的朋友，</para>
  <para style="q1" vid="PSA 55:20">他褻瀆了自己的約。<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />他的口比奶油更光滑，</para>
  <para style="q1" vid="PSA 55:21">其實他心懷敵意；</para>
  <para style="q1" vid="PSA 55:21">他的話語比油更滋潤，</para>
  <para style="q1" vid="PSA 55:21">其實是出鞘的刀。<verse eid="PSA 55:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />你當把你的重擔卸給耶和華，</para>
  <para style="q1" vid="PSA 55:22">他就會扶持你，</para>
  <para style="q1" vid="PSA 55:22">他永遠不讓義人動搖。<verse eid="PSA 55:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />神哪，你必使惡人下到滅亡的深坑裡！</para>
  <para style="q1" vid="PSA 55:23">那些殺人流血、行詭詐的人，必活不過半生；</para>
  <para style="q1" vid="PSA 55:23">至於我，我要依靠你。<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s">依靠神的必不害怕</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的金詩，給樂隊指揮，用「遠方無聲鴿」曲調。那時<char style="pn">非利士</char>人在<char style="pn">迦特</char>抓住了他。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1" />神哪，求你恩待我！</para>
  <para style="q1" vid="PSA 56:1">因為世人踐踏我，</para>
  <para style="q1" vid="PSA 56:1">與我爭戰的人終日壓迫我。<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />我的仇敵終日踐踏我，</para>
  <para style="q1" vid="PSA 56:2">狂傲地<note caller="+" style="f"><char style="fr" closed="false">56:2 </char><char style="ft" closed="false">狂傲地——或譯作「至高者啊，」。</char></note>與我爭戰的人實在多！<verse eid="PSA 56:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />我害怕的時候，</para>
  <para style="q1" vid="PSA 56:3">我要依靠你。<verse eid="PSA 56:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />靠著神，我要讚美他的話；</para>
  <para style="q1" vid="PSA 56:4">依靠神，我就不害怕，</para>
  <para style="q1" vid="PSA 56:4">血肉之軀能對我做什麼呢？<verse eid="PSA 56:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />他們終日歪曲我的話，</para>
  <para style="q1" vid="PSA 56:5">千方百計加害於我；<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />他們聚集、設伏、窺探我的腳蹤，</para>
  <para style="q1" vid="PSA 56:6">伺機要害我的命。<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />他們既有這些罪，難道還能逃脫嗎？</para>
  <para style="q1" vid="PSA 56:7">神哪，求你在怒氣中使這民眾敗落！<verse eid="PSA 56:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />我多次流離失所，你都數算；</para>
  <para style="q1" vid="PSA 56:8">求你把我的眼淚收在你的皮囊中。</para>
  <para style="q1" vid="PSA 56:8">這些不都在你的冊子上嗎？<verse eid="PSA 56:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />於是在我呼求的日子裡，</para>
  <para style="q1" vid="PSA 56:9">我的仇敵必轉身退後；</para>
  <para style="q1" vid="PSA 56:9">我明白這一點：神在我這邊！<verse eid="PSA 56:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />靠著神，我要讚美他的話語；</para>
  <para style="q1" vid="PSA 56:10">靠著耶和華，我要讚美他的話語。<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />依靠神，我就不害怕，</para>
  <para style="q1" vid="PSA 56:11">人能對我做什麼呢？<verse eid="PSA 56:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />神哪，我向你所許的願在我身上，</para>
  <para style="q1" vid="PSA 56:12">我要用感謝祭向你償還！<verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />因為你解救了我的性命脫離死亡，</para>
  <para style="q1" vid="PSA 56:13">絕不會讓我的腳絆跌，</para>
  <para style="q1" vid="PSA 56:13">好使我在生命的光中行在神的面前！<note caller="+" style="f"><char style="fr" closed="false">56:13 </char><char style="ft" closed="false">絕不會讓我的腳絆跌，好使我在生命的光中行在神的面前！——或譯作「難道你不是解救了我的腳不絆跌，使我在生命的光中，行在神你的面前嗎？」</char></note><verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s">投靠神的心必堅定</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的金詩，給樂隊指揮，用「不要毀滅」曲調。那時他從<char style="pn">掃羅</char>面前逃走，藏在洞穴裡。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />神哪，求你恩待我、恩待我，</para>
  <para style="q1" vid="PSA 57:1">因為我的心投靠你！</para>
  <para style="q1" vid="PSA 57:1">我投靠在你翅膀的蔭庇下，</para>
  <para style="q1" vid="PSA 57:1">直到禍患過去。<verse eid="PSA 57:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />我要向至高神呼求，</para>
  <para style="q1" vid="PSA 57:2">向那為我成就萬事<note caller="+" style="f"><char style="fr" closed="false">57:2 </char><char style="ft" closed="false">萬事——輔助詞語。</char></note>的神呼求。<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />他從天上賜下救恩<note caller="+" style="f"><char style="fr" closed="false">57:3 </char><char style="ft" closed="false">救恩——輔助詞語。</char></note>拯救我，</para>
  <para style="q1" vid="PSA 57:3">他斥責那踐踏我的人。<char style="qs">細拉</char></para>
  <para style="q1" vid="PSA 57:3">神賜下了他的慈愛和信實。<verse eid="PSA 57:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />我的性命在獅子當中，</para>
  <para style="q1" vid="PSA 57:4">我躺臥在吞噬我的人中間；</para>
  <para style="q1" vid="PSA 57:4">這些人牙齒是長矛和箭矢，</para>
  <para style="q1" vid="PSA 57:4">舌頭是銳利的刀劍。<verse eid="PSA 57:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />神哪，願你受尊崇高於諸天，</para>
  <para style="q1" vid="PSA 57:5">願你的榮耀遍及全地！<verse eid="PSA 57:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />他們為我的腳設下網羅，</para>
  <para style="q1" vid="PSA 57:6">我的心受了壓制。</para>
  <para style="q1" vid="PSA 57:6">他們在我面前挖了陷阱，</para>
  <para style="q1" vid="PSA 57:6">自己反掉在其中。<char style="qs">細拉</char><verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />神哪，我心堅定，我心堅定；</para>
  <para style="q1" vid="PSA 57:7">我要歌唱，我要歌頌！<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />醒來吧，我的靈<note caller="+" style="f"><char style="fr" closed="false">57:8 </char><char style="ft" closed="false">靈——原文直譯「榮耀」。</char></note>！</para>
  <para style="q1" vid="PSA 57:8">醒來吧，里拉琴和豎琴，</para>
  <para style="q1" vid="PSA 57:8">我要把黎明喚醒！<verse eid="PSA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />主啊，我要在萬民中稱謝你，</para>
  <para style="q1" vid="PSA 57:9">在萬族中歌頌你！<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />因為你的慈愛偉大，上達諸天，</para>
  <para style="q1" vid="PSA 57:10">你的信實上達雲霄。<verse eid="PSA 57:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />神哪，願你受尊崇高於諸天，</para>
  <para style="q1" vid="PSA 57:11">願你的榮耀遍及全地！<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s">求神審判不義</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的金詩，給樂隊指揮，用「不要毀滅」曲調。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />掌權者啊，你們<note caller="+" style="f"><char style="fr" closed="false">58:1 </char><char style="ft" closed="false">掌權者啊，你們——或譯作「你們默然不語，」或「神明啊，你們」。</char></note>真的講公義嗎？</para>
  <para style="q1" vid="PSA 58:1">你們真的以正直審判世人<note caller="+" style="f"><char style="fr" closed="false">58:1 </char><char style="ft" closed="false">你們真的以正直審判世人——或譯作「世人哪，你們真的按正直審判」。</char></note>嗎？<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />不，你們在心裡行不義，</para>
  <para style="q1" vid="PSA 58:2">你們在地上手施殘暴。<verse eid="PSA 58:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />惡人一出胎胞就背離神<note caller="+" style="f"><char style="fr" closed="false">58:3 </char><char style="ft" closed="false">神——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PSA 58:3">說謊的人一離母腹就迷失。<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />他們的毒液好像蛇的毒液，</para>
  <para style="q1" vid="PSA 58:4">他們如同耳聾的毒蛇，耳朵封閉了，<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />不聽行法術者的聲音，</para>
  <para style="q1" vid="PSA 58:5">也不聽熟練念咒人的聲音。<verse eid="PSA 58:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />神哪，求你打碎他們口中的牙齒！</para>
  <para style="q1" vid="PSA 58:6">耶和華啊，求你打斷少壯獅子的尖牙！<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />願他們像自行流去的水那樣消逝；</para>
  <para style="q1" vid="PSA 58:7">願他們拉弓時，他們的箭頭彷彿自行折斷。<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />願他們像蝸牛那樣在爬行中消融，</para>
  <para style="q1" vid="PSA 58:8">又像女人流產的胎兒未見天日。<verse eid="PSA 58:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />在你們的鍋還沒有被荊棘燒熱之前，</para>
  <para style="q1" vid="PSA 58:9">他就要用旋風，</para>
  <para style="q1" vid="PSA 58:9">把未燒著的和已燒著的一起颳走！<verse eid="PSA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />義人看到惡人<note caller="+" style="f"><char style="fr" closed="false">58:10 </char><char style="ft" closed="false">惡人——輔助詞語。</char></note>遭報就歡喜；</para>
  <para style="q1" vid="PSA 58:10">他要在惡人的血中洗自己的腳。<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />這樣，人們就會說：「義人確實有善報！</para>
  <para style="q1" vid="PSA 58:11">確實有一位在地上施行審判的神！」<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s">求神懲罰背信者</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的金詩，給樂隊指揮，用「不要毀滅」曲調。那時<char style="pn">掃羅</char>派人去窺探<char style="pn">大衛</char>的家，想要殺他。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />我的神哪，求你解救我脫離我的仇敵，</para>
  <para style="q1" vid="PSA 59:1">把我安置在高處，脫離那些起來敵對我的人！<verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />求你解救我脫離那些作惡之徒，</para>
  <para style="q1" vid="PSA 59:2">拯救我脫離那些殺人流血的人。<verse eid="PSA 59:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />看哪，他們埋伏要害我的性命，</para>
  <para style="q1" vid="PSA 59:3">凶猛的人聚集來攻擊我！</para>
  <para style="q1" vid="PSA 59:3">耶和華啊，這不是因我的過犯，</para>
  <para style="q1" vid="PSA 59:3">也不是因我的罪！<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />我沒有過犯，他們卻跑來，預備好攻擊我。</para>
  <para style="q1" vid="PSA 59:4">求你起來幫助<note caller="+" style="f"><char style="fr" closed="false">59:4 </char><char style="ft" closed="false">幫助——原文直譯「迎見」。</char></note>我，求你查看！<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />萬軍之神耶和華啊，你就是<char style="pn">以色列</char>的神！</para>
  <para style="q1" vid="PSA 59:5">求你醒來懲罰萬國，</para>
  <para style="q1" vid="PSA 59:5">不要恩待任何作惡的背信者。<char style="qs">細拉</char><verse eid="PSA 59:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />他們傍晚回來，</para>
  <para style="q1" vid="PSA 59:6">像狗那樣咆哮，在城中繞行。<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />看哪，他們口中吐出惡言<note caller="+" style="f"><char style="fr" closed="false">59:7 </char><char style="ft" closed="false">惡言——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PSA 59:7">嘴唇間有刀劍！</para>
  <para style="q1" vid="PSA 59:7">他們說：「誰能聽見呢？」<verse eid="PSA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />可是你，耶和華啊，你要譏笑他們，</para>
  <para style="q1" vid="PSA 59:8">你要嘲笑萬國！<verse eid="PSA 59:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />我<note caller="+" style="f"><char style="fr" closed="false">59:9 </char><char style="ft" closed="false">我——有古抄本和古譯本作「他」。</char></note>的力量啊，我要等候你！</para>
  <para style="q1" vid="PSA 59:9">神哪！因為你是我的庇護所。<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />我慈愛的神將迎接我，</para>
  <para style="q1" vid="PSA 59:10">神必使我看到我仇敵的下場<note caller="+" style="f"><char style="fr" closed="false">59:10 </char><char style="ft" closed="false">的下場——輔助詞語。</char></note>。<verse eid="PSA 59:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />求你不要殺死他們，</para>
  <para style="q1" vid="PSA 59:11">免得我的子民忘記；</para>
  <para style="q1" vid="PSA 59:11">求你以你的力量使他們四處漂泊，</para>
  <para style="q1" vid="PSA 59:11">使他們降卑！</para>
  <para style="q1" vid="PSA 59:11">主啊，你是我們的盾牌！<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />願他們因口中的罪和嘴上的話，</para>
  <para style="q1" vid="PSA 59:12">在自己的驕傲中被纏住；</para>
  <para style="q1" vid="PSA 59:12">因為他們所說的都是詛咒和謊言。<verse eid="PSA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13" />求你在怒火中滅絕他們、滅絕他們，</para>
  <para style="q1" vid="PSA 59:13">使他們不復存在。</para>
  <para style="q1" vid="PSA 59:13">願人們明白：</para>
  <para style="q1" vid="PSA 59:13">神在<char style="pn">雅各</char>中掌權，直到地極。<char style="qs">細拉</char><verse eid="PSA 59:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />他們傍晚回來，</para>
  <para style="q1" vid="PSA 59:14">像狗那樣咆哮，在城中繞行。<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />他們四處漂泊就是為了吃，</para>
  <para style="q1" vid="PSA 59:15">如果沒有飽足，他們就吠叫。<verse eid="PSA 59:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />至於我，我要歌唱你的力量，</para>
  <para style="q1" vid="PSA 59:16">我要在早晨頌唱你的慈愛；</para>
  <para style="q1" vid="PSA 59:16">因為你是我的庇護所，</para>
  <para style="q1" vid="PSA 59:16">是我危難日子裡的避難所。<verse eid="PSA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />我的力量啊，我要歌頌你！</para>
  <para style="q1" vid="PSA 59:17">神哪，你就是我的庇護所，</para>
  <para style="q1" vid="PSA 59:17">是我慈愛的神。<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s">求神拯救所愛的子民</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的金詩，給樂隊指揮，用「見證的百合花」曲調，用於教導。<char style="pn">大衛</char>與<char style="pn">美索不達米亞</char>和<char style="pn">瑣巴</char>的<char style="pn">亞蘭</char>打仗時，<char style="pn">約押</char>轉回來在<char style="pn">鹽谷</char>擊殺了一萬兩千個<char style="pn">以東</char>人。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />神哪，你拋棄了我們，毀壞了我們；</para>
  <para style="q1" vid="PSA 60:1">你曾經發怒，現在求你復興我們。<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />你使大地震動、裂開；</para>
  <para style="q1" vid="PSA 60:2">求你修復裂口，因為大地在搖動。<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />你使你的子民遇見艱難，</para>
  <para style="q1" vid="PSA 60:3">讓我們喝了使人踉蹌的酒。<verse eid="PSA 60:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />你賜旗幟給敬畏你的人，</para>
  <para style="q1" vid="PSA 60:4">好使他們可以逃到那裡躲避弓箭<note caller="+" style="f"><char style="fr" closed="false">60:4 </char><char style="ft" closed="false">好使他們可以逃到那裡躲避弓箭——或譯作「好讓它為真理揚起來」。</char></note>。<char style="qs">細拉</char><verse eid="PSA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />求你用你的右手施行拯救，</para>
  <para style="q1" vid="PSA 60:5">求你回應我們<note caller="+" style="f"><char style="fr" closed="false">60:5 </char><char style="ft" closed="false">我們——或譯作「我」。</char></note>，</para>
  <para style="q1" vid="PSA 60:5">好讓你所愛的人得救。<verse eid="PSA 60:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />神在他的聖所中說：</para>
  <para style="q1" vid="PSA 60:6">「我要歡躍，我要分割<char style="pn">示劍</char>，</para>
  <para style="q1" vid="PSA 60:6">我要測量<char style="pn">疏割</char>谷。<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />
    <char style="pn">基列</char>屬於我，<char style="pn">瑪拿西</char>也屬於我，</para>
  <para style="q1" vid="PSA 60:7">
    <char style="pn">以法蓮</char>是我的頭盔，<char style="pn">猶大</char>是我的權杖。<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />
    <char style="pn">摩押</char>是我的洗腳盆，</para>
  <para style="q1" vid="PSA 60:8">我要向<char style="pn">以東</char>扔鞋，</para>
  <para style="q1" vid="PSA 60:8">向<char style="pn">非利士</char>誇勝<note caller="+" style="f"><char style="fr" closed="false">60:8 </char><char style="ft" closed="false">向非利士誇勝——或譯作「非利士啊，你要因我而誇勝」。</char></note>。」<verse eid="PSA 60:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />誰能領我到那堅固城呢？</para>
  <para style="q1" vid="PSA 60:9">誰能引導我到<char style="pn">以東</char>呢？<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />神哪，你不會拋棄了我們吧？</para>
  <para style="q1" vid="PSA 60:10">神哪，你不與我們的隊伍一同出征嗎？<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />求你幫助我們抵擋敵人；</para>
  <para style="q1" vid="PSA 60:11">因為人的拯救是枉然的。<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />藉著神，我們將做大能的事；</para>
  <para style="q1" vid="PSA 60:12">他必踐踏我們的敵人。<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s">求神護佑</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">61:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>，給樂隊指揮，用弦樂器。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />神哪，求你垂聽我的呼聲，</para>
  <para style="q1" vid="PSA 61:1">留心聽我的禱告！<verse eid="PSA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />我心裡虛弱的時候，</para>
  <para style="q1" vid="PSA 61:2">就從地極向你呼求；</para>
  <para style="q1" vid="PSA 61:2">求你<note caller="+" style="f"><char style="fr" closed="false">61:2 </char><char style="ft" closed="false">求你——或譯作「你會」。</char></note>引導我到那比我更高的磐石。<verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />因為你是我的避難所、</para>
  <para style="q1" vid="PSA 61:3">是我躲避仇敵的堅固塔樓。<verse eid="PSA 61:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />我要永遠居住在你的帳篷中，</para>
  <para style="q1" vid="PSA 61:4">投靠在你翅膀下的隱祕處。<char style="qs">細拉</char><verse eid="PSA 61:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />是的，神哪，是你垂聽了我所許的願，</para>
  <para style="q1" vid="PSA 61:5">將產業賜給敬畏你名的人！<verse eid="PSA 61:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />願你增添王的日子；</para>
  <para style="q1" vid="PSA 61:6">使他的歲月如世世代代長久<note caller="+" style="f"><char style="fr" closed="false">61:6 </char><char style="ft" closed="false">長久——輔助詞語。</char></note>。<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />願他永遠住在神的面前，</para>
  <para style="q1" vid="PSA 61:7">求你指派慈愛和信實守護他。<verse eid="PSA 61:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />因此我要永遠歌頌你的名，</para>
  <para style="q1" vid="PSA 61:8">好天天還我所許的願。<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s">一切在於神</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮<char style="pn">耶杜頓</char>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />我的靈魂靜默，唯獨等候神，</para>
  <para style="q1" vid="PSA 62:1">我的救恩從他而來。<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />唯有他是我的磐石、我的救恩、我的庇護所，</para>
  <para style="q1" vid="PSA 62:2">我就不致大大動搖。<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />你們大家攻擊一個人，要殺害他，</para>
  <para style="q1" vid="PSA 62:3">使他像歪斜的牆壁、將塌的圍牆，</para>
  <para style="q1" vid="PSA 62:3">要到什麼時候呢？<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />他們彼此商議，只為把他從高位上趕下來；</para>
  <para style="q1" vid="PSA 62:4">他們喜悅虛謊，</para>
  <para style="q1" vid="PSA 62:4">口中雖祝福，心中卻詛咒。<char style="qs">細拉</char><verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />我的靈魂哪，你要靜默，唯獨等候神，</para>
  <para style="q1" vid="PSA 62:5">因為我的盼望從他而來。<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />唯有他是我的磐石、我的救恩、我的庇護所，</para>
  <para style="q1" vid="PSA 62:6">我就不致動搖。<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />我的救恩、我的榮耀都在於神，</para>
  <para style="q1" vid="PSA 62:7">我堅固的磐石、我的避難所都在神裡面。<verse eid="PSA 62:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />你們作子民的，要時時依靠他，</para>
  <para style="q1" vid="PSA 62:8">在他面前傾心吐意，</para>
  <para style="q1" vid="PSA 62:8">神是我們的避難所！<char style="qs">細拉</char><verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />卑賤的人不過是虛空，</para>
  <para style="q1" vid="PSA 62:9">尊貴的人也只是虛幻；</para>
  <para style="q1" vid="PSA 62:9">他們在天平這端<note caller="+" style="f"><char style="fr" closed="false">62:9 </char><char style="ft" closed="false">這端——輔助詞語。</char></note>上升，</para>
  <para style="q1" vid="PSA 62:9">加起來比空氣還輕。<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />你不要依靠欺壓，也不要妄想搶奪；</para>
  <para style="q1" vid="PSA 62:10">即使財富增加，也不要放在心上。<verse eid="PSA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />神說過一次，</para>
  <para style="q1" vid="PSA 62:11">我再次聽到：</para>
  <para style="q1" vid="PSA 62:11">力量在於神！<verse eid="PSA 62:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12" />主啊，慈愛也在於你，</para>
  <para style="q1" vid="PSA 62:12">你必照著各人所做的回報他。<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s">渴慕神</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩。那時他在<char style="pn">猶大</char>曠野中。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />神哪，你是我的神，</para>
  <para style="q1" vid="PSA 63:1">我切切尋求你！</para>
  <para style="q1" vid="PSA 63:1">在乾旱、疲乏、無水之地，</para>
  <para style="q1" vid="PSA 63:1">我的靈魂渴想你，</para>
  <para style="q1" vid="PSA 63:1">我的肉體渴盼你。<verse eid="PSA 63:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />因此我在聖所中仰望你，</para>
  <para style="q1" vid="PSA 63:2">為要看見你的能力和榮耀。<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />因你的慈愛比生命更美好，</para>
  <para style="q1" vid="PSA 63:3">我的嘴唇就稱讚你。<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />這樣，我一生都要頌讚你，</para>
  <para style="q1" vid="PSA 63:4">奉你的名舉起雙手。<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />我的心就像飽嘗了骨髓脂油，</para>
  <para style="q1" vid="PSA 63:5">我的口要以歡樂的嘴唇發出讚美。<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />我在床榻上也記念你，</para>
  <para style="q1" vid="PSA 63:6">在每個夜更都思想你；<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />因為你是我的幫助，</para>
  <para style="q1" vid="PSA 63:7">我在你翅膀的蔭庇下歡呼；<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />我的心緊緊跟隨你，</para>
  <para style="q1" vid="PSA 63:8">你的右手扶持了我。<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />而那些尋索要毀滅我性命的人，</para>
  <para style="q1" vid="PSA 63:9">他們必下到地的深處；<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />他們必被交在刀劍之下，</para>
  <para style="q1" vid="PSA 63:10">成為豺狗的食物。<verse eid="PSA 63:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />可是王必因著神而歡喜，</para>
  <para style="q1" vid="PSA 63:11">所有指著神<note caller="+" style="f"><char style="fr" closed="false">63:11 </char><char style="ft" closed="false">神——原文直譯「他」。</char></note>起誓的都必誇耀，</para>
  <para style="q1" vid="PSA 63:11">因為說謊之人的口必被封住。<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s">求神拯救脫離作惡者</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />神哪，我訴苦的時候，求你垂聽我的聲音！</para>
  <para style="q1" vid="PSA 64:1">求你守護我的性命，免於仇敵的恐嚇。<verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />求你隱藏我，脫離惡人的密謀，</para>
  <para style="q1" vid="PSA 64:2">脫離作惡者的擾亂。<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />他們磨快自己的舌頭，如同刀劍；</para>
  <para style="q1" vid="PSA 64:3">他們發出苦毒的話語，好像弦上的箭，<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />為要從隱祕處射純全人；</para>
  <para style="q1" vid="PSA 64:4">他們突然射他，肆無忌憚。<verse eid="PSA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />他們彼此慫恿去做惡事，</para>
  <para style="q1" vid="PSA 64:5">彼此商量要暗設陷阱，說：</para>
  <para style="q1" vid="PSA 64:5">「誰能看見呢？」<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />他們籌劃不義，說：</para>
  <para style="q1" vid="PSA 64:6">「我們所籌劃的計謀定好了。」</para>
  <para style="q1" vid="PSA 64:6">人的意念和心思實在深不可測。<verse eid="PSA 64:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />但是神會用箭射他們，</para>
  <para style="q1" vid="PSA 64:7">他們必突然被擊傷。<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />他們將使自己絆倒，</para>
  <para style="q1" vid="PSA 64:8">他們的舌頭與自己作對；</para>
  <para style="q1" vid="PSA 64:8">所有看見他們的人都必搖頭。<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />這樣，人人都必心存敬畏，</para>
  <para style="q1" vid="PSA 64:9">宣告神的作為，</para>
  <para style="q1" vid="PSA 64:9">明白他所做的事。<verse eid="PSA 64:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />願義人因耶和華而歡喜，並且投靠他；</para>
  <para style="q1" vid="PSA 64:10">願所有心裡正直的人，都因他而<note caller="+" style="f"><char style="fr" closed="false">64:10 </char><char style="ft" closed="false">因他而——輔助詞語。</char></note>誇耀！<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s">神眷顧大地</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，一首歌，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />神哪，在<char style="pn">錫安</char>，讚美等候著你<note caller="+" style="f"><char style="fr" closed="false">65:1 </char><char style="ft" closed="false">讚美等候著你——或譯作「你配得讚美」。</char></note>，</para>
  <para style="q1" vid="PSA 65:1">所許的願也要向你償還！<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />垂聽禱告的那一位啊，</para>
  <para style="q1" vid="PSA 65:2">一切有血肉的都要來到你面前！<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />罪孽勝過我；</para>
  <para style="q1" vid="PSA 65:3">至於我們的過犯，你都會贖清。<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />你所揀選、帶到你身邊、讓他安居在你院宇中的，是蒙福的！</para>
  <para style="q1" vid="PSA 65:4">我們將因你家的美善、你殿的神聖<note caller="+" style="f"><char style="fr" closed="false">65:4 </char><char style="ft" closed="false">你家的美善、你殿的神聖——或譯作「你家，就是你聖殿的美善」。</char></note>而心滿意足。<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />拯救我們的神哪，</para>
  <para style="q1" vid="PSA 65:5">你以公義、用可畏的事回應我們，</para>
  <para style="q1" vid="PSA 65:5">你是一切遠在天涯海角的人所依賴的！<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />你以大能束腰，</para>
  <para style="q1" vid="PSA 65:6">以自己的能力堅立群山。<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />你平息海洋和其中波濤的喧嚷，</para>
  <para style="q1" vid="PSA 65:7">平息萬民的喧囂。<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />住在地極的人因你的神蹟而心存敬畏，</para>
  <para style="q1" vid="PSA 65:8">你使日出日落之地都歡呼。<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />你眷顧大地，澆灌它，使它極其肥沃；</para>
  <para style="q1" vid="PSA 65:9">神的河渠滿了水；</para>
  <para style="q1" vid="PSA 65:9">你為人們預備五穀；</para>
  <para style="q1" vid="PSA 65:9">你就是這樣預備了大地。<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />你潤澤它的犁溝，平整它的犁脊；</para>
  <para style="q1" vid="PSA 65:10">你用甘霖使地鬆軟，祝福其中所生長的。<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />你以恩惠為年歲的冠冕，</para>
  <para style="q1" vid="PSA 65:11">你的路徑都滴下脂油，<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />滴在曠野的牧場上；</para>
  <para style="q1" vid="PSA 65:12">岡陵也以快樂束腰；<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />草場以羊群為衣，</para>
  <para style="q1" vid="PSA 65:13">谷中都蓋滿了穀物；</para>
  <para style="q1" vid="PSA 65:13">這一切都歡呼歌唱！<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s">頌讚神的作為</para>
  <para style="b" />
  <para style="d">一首詩歌，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />全地啊，你們當向神歡呼！<verse eid="PSA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2" />當歌頌他名的榮耀，</para>
  <para style="q1" vid="PSA 66:2">向他獻上榮耀的讚美！<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />當對神說：「你的作為多麼可畏！</para>
  <para style="q1" vid="PSA 66:3">因你強大的能力，你的仇敵向你卑躬屈膝。<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />全地都要向你下拜，要歌頌你；</para>
  <para style="q1" vid="PSA 66:4">他們要歌頌你的名！」<char style="qs">細拉</char><verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />你們當來，觀看神的作為！</para>
  <para style="q1" vid="PSA 66:5">他向世人所行的事是可畏的：<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />他曾把海變成乾地，</para>
  <para style="q1" vid="PSA 66:6">眾人曾徒步過河——</para>
  <para style="q1" vid="PSA 66:6">在那裡，讓我們因他而歡喜！<verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />他以自己的大能管轄萬有<note caller="+" style="f"><char style="fr" closed="false">66:7 </char><char style="ft" closed="false">萬有——輔助詞語。</char></note>，直到永遠，</para>
  <para style="q1" vid="PSA 66:7">他的眼目守望列國；</para>
  <para style="q1" vid="PSA 66:7">那些頑梗的人不要高舉自己！<char style="qs">細拉</char><verse eid="PSA 66:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />萬民哪，你們當頌讚我們的神，</para>
  <para style="q1" vid="PSA 66:8">當使人聽見讚美他的聲音！<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />是他把我們的性命存留在活人中，</para>
  <para style="q1" vid="PSA 66:9">不讓我們的腳動搖。<verse eid="PSA 66:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />是的，神哪，你試煉我們，</para>
  <para style="q1" vid="PSA 66:10">你熬煉我們，如同熬煉銀子！<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />你使我們進入牢籠，</para>
  <para style="q1" vid="PSA 66:11">把重擔壓在我們的腰背上。<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />你使人騎在我們的頭上；</para>
  <para style="q1" vid="PSA 66:12">我們曾進入烈火、進入眾水，</para>
  <para style="q1" vid="PSA 66:12">但你又把我們領到那福份<note caller="+" style="f"><char style="fr" closed="false">66:12 </char><char style="ft" closed="false">福份——輔助詞語。</char></note>滿溢之地。<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />我要帶著燔祭來到你的殿，</para>
  <para style="q1" vid="PSA 66:13">向你還我所許的願，<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />就是我在危難中，</para>
  <para style="q1" vid="PSA 66:14">我的嘴唇所發、我的口中所許的願。<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />我要把肥畜的燔祭與公綿羊的馨香祭，</para>
  <para style="q1" vid="PSA 66:15">一同向你獻上；</para>
  <para style="q1" vid="PSA 66:15">我要把公牛與公山羊，</para>
  <para style="q1" vid="PSA 66:15">一同獻上。<char style="qs">細拉</char><verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />所有敬畏神的人哪，你們都當來聽！</para>
  <para style="q1" vid="PSA 66:16">我要講述他為我所做的事。<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />我開口向他呼求，</para>
  <para style="q1" vid="PSA 66:17">我的舌頭也頌揚他。<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />如果我的心以罪為念，</para>
  <para style="q1" vid="PSA 66:18">主就不會垂聽。<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />但神確實垂聽了，</para>
  <para style="q1" vid="PSA 66:19">他留心聽了我禱告的聲音。<verse eid="PSA 66:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />神是當受頌讚的！</para>
  <para style="q1" vid="PSA 66:20">他沒有拒絕我的禱告，</para>
  <para style="q1" vid="PSA 66:20">也沒有使他的慈愛離開我。<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s">萬民都要讚美神</para>
  <para style="b" />
  <para style="d">一首詩歌，給樂隊指揮，用弦樂器。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />願神恩待我們、祝福我們，</para>
  <para style="q1" vid="PSA 67:1">願他的臉照亮我們！<char style="qs">細拉</char><verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />這樣，你的道路就顯明在地上，</para>
  <para style="q1" vid="PSA 67:2">你的救恩就顯明在萬國中。<verse eid="PSA 67:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />神哪，願萬民稱謝你，</para>
  <para style="q1" vid="PSA 67:3">願萬民都稱謝你！<verse eid="PSA 67:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />願萬族歡喜、歡唱，</para>
  <para style="q1" vid="PSA 67:4">因為你按正直審判萬民，</para>
  <para style="q1" vid="PSA 67:4">並引導地上的萬族。<char style="qs">細拉</char><verse eid="PSA 67:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />神哪，願萬民稱謝你，</para>
  <para style="q1" vid="PSA 67:5">願萬民都稱謝你！<verse eid="PSA 67:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />大地有了出產；</para>
  <para style="q1" vid="PSA 67:6">神，我們的神，要祝福我們。<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />神要祝福我們，</para>
  <para style="q1" vid="PSA 67:7">地極都要敬畏他。<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s">頌讚神的威榮</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，一首歌，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />願神興起，願他的仇敵四散；</para>
  <para style="q1" vid="PSA 68:1">願恨惡他的人從他面前逃跑。<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />他們被神吹散<note caller="+" style="f"><char style="fr" closed="false">68:2 </char><char style="ft" closed="false">他們被神吹散——原文直譯「你吹散他們」。</char></note>，</para>
  <para style="q1" vid="PSA 68:2">如同煙被吹散；</para>
  <para style="q1" vid="PSA 68:2">惡人在神面前滅亡，</para>
  <para style="q1" vid="PSA 68:2">如同蠟在火面前融化。<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />但願義人歡喜，在神面前歡慶；</para>
  <para style="q1" vid="PSA 68:3">願他們喜樂歡欣。<verse eid="PSA 68:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />你們當向神歌唱，歌頌他的名，</para>
  <para style="q1" vid="PSA 68:4">高舉在雲中乘駕的那一位<note caller="+" style="f"><char style="fr" closed="false">68:4 </char><char style="ft" closed="false">高舉在雲中乘駕的那一位——或譯作「為那駕車經過曠野的修平道路」。</char></note>；</para>
  <para style="q1" vid="PSA 68:4">耶和華是他的名，</para>
  <para style="q1" vid="PSA 68:4">你們當在他面前歡躍！<verse eid="PSA 68:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />神在他神聖的居所中，</para>
  <para style="q1" vid="PSA 68:5">作孤兒的父親，作寡婦的辯護者。<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />神使孤獨者在家安居，</para>
  <para style="q1" vid="PSA 68:6">使被囚者出來進入自由<note caller="+" style="f"><char style="fr" closed="false">68:6 </char><char style="ft" closed="false">自由——或譯作「幸福」。</char></note>，</para>
  <para style="q1" vid="PSA 68:6">然而頑梗的人將住在焦乾之地。<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />神哪，你走在你子民的前面，</para>
  <para style="q1" vid="PSA 68:7">在曠野前進；<char style="qs">細拉</char><verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />那時，在神——<char style="pn">西奈</char>山上的那一位面前，</para>
  <para style="q1" vid="PSA 68:8">在神——<char style="pn">以色列</char>的神面前，</para>
  <para style="q1" vid="PSA 68:8">大地震動，諸天降雨。<verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />神哪，你降下豐沛的大雨；</para>
  <para style="q1" vid="PSA 68:9">當你的繼業疲倦時，是你堅立了他！<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />你的會眾住在那地，</para>
  <para style="q1" vid="PSA 68:10">神哪，你在恩惠中為困苦人預備了一切！<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />主賜下話語，</para>
  <para style="q1" vid="PSA 68:11">傳揚好消息的女子隊伍龐大。<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />她們說：「領兵的君王們</para>
  <para style="q1" vid="PSA 68:12">逃亡了，逃亡了！</para>
  <para style="q1" vid="PSA 68:12">留在家裡的女子也將分得戰利品。」<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />你們在羊圈中睡覺時，</para>
  <para style="q1" vid="PSA 68:13">好像鴿子翅膀上鍍著銀子，</para>
  <para style="q1" vid="PSA 68:13">羽翼鍍著黃金。<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />全能者驅散境內君王們的時候，</para>
  <para style="q1" vid="PSA 68:14">白雪降在<char style="pn">撒門</char>山。<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />
    <char style="pn">巴珊</char>的山是神的山，</para>
  <para style="q1" vid="PSA 68:15">
    <char style="pn">巴珊</char>的山是多峰的山。<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />多峰的群山哪，</para>
  <para style="q1" vid="PSA 68:16">你們為什麼嫉妒神喜愛居住的山呢？</para>
  <para style="q1" vid="PSA 68:16">要知道，耶和華將在那裡永久居住。<verse eid="PSA 68:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />神的戰車千千萬萬，</para>
  <para style="q1" vid="PSA 68:17">主就在其中，從<char style="pn">西奈</char>山進入聖所<note caller="+" style="f"><char style="fr" closed="false">68:17 </char><char style="ft" closed="false">主就在其中，從西奈山進入聖所——或譯作「主在聖所如同他在西奈山一樣與他們同在」或「主就在其中，西奈山在聖所中」。</char></note>。<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />你升上高天<note caller="+" style="f"><char style="fr" closed="false">68:18 </char><char style="ft" closed="false">高天——或譯作「高處」。</char></note>，擄掠了俘虜；</para>
  <para style="q1" vid="PSA 68:18">你在人間，甚至在頑梗的人中，</para>
  <para style="q1" vid="PSA 68:18">接受了供奉，</para>
  <para style="q1" vid="PSA 68:18">好使耶和華神與他們同住<note caller="+" style="f"><char style="fr" closed="false">68:18 </char><char style="ft" closed="false">與他們同住——或譯作「住在那裡」。</char></note>！<verse eid="PSA 68:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />主是當受頌讚的，</para>
  <para style="q1" vid="PSA 68:19">他天天為我們背負重擔，</para>
  <para style="q1" vid="PSA 68:19">他是拯救我們的神。<char style="qs">細拉</char><verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />我們的神是施行拯救的神，</para>
  <para style="q1" vid="PSA 68:20">脫離死亡的出路在於主耶和華。<verse eid="PSA 68:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />神必然擊碎他仇敵的頭，</para>
  <para style="q1" vid="PSA 68:21">就是那行在罪中之人的頭顱。<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />主說：「我將使子民從<char style="pn">巴珊</char>回來，</para>
  <para style="q1" vid="PSA 68:22">從海洋的深處回來，<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />好使你的腳把仇敵擊碎在血中，</para>
  <para style="q1" vid="PSA 68:23">使你的狗的舌頭從中也有份。」<verse eid="PSA 68:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />神哪，人們看見你的隊列，</para>
  <para style="q1" vid="PSA 68:24">就是看見我的神、我的王的隊列進入聖所！<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />歌唱的在前，彈琴的隨後，</para>
  <para style="q1" vid="PSA 68:25">擊鼓的童女們在中間。<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />你們當在集會中頌讚神，</para>
  <para style="q1" vid="PSA 68:26">從<char style="pn">以色列</char>源頭而來的啊，</para>
  <para style="q1" vid="PSA 68:26">你們當頌讚耶和華！<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />那裡有最小的<char style="pn">便雅憫</char>管理他們，</para>
  <para style="q1" vid="PSA 68:27">在他們的隊伍中有<char style="pn">猶大</char>的首領們，</para>
  <para style="q1" vid="PSA 68:27">還有<char style="pn">西布倫</char>的首領們和<char style="pn">拿弗他利</char>的首領們。<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />你的神命定了你的力量。</para>
  <para style="q1" vid="PSA 68:28">神哪，彰顯你的能力吧，</para>
  <para style="q1" vid="PSA 68:28">你所做的是為了我們<note caller="+" style="f"><char style="fr" closed="false">68:28 </char><char style="ft" closed="false">彰顯你的能力吧，你所做的是為了我們——或譯作「堅立你為我們所做的事吧」。</char></note>！<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />因你在<char style="pn">耶路撒冷</char>的聖殿，</para>
  <para style="q1" vid="PSA 68:29">君王們將給你帶來禮物。<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />求你斥責蘆葦中的野獸，</para>
  <para style="q1" vid="PSA 68:30">斥責壯牛群以及萬民中的牛犢；</para>
  <para style="q1" vid="PSA 68:30">把貪愛銀塊的人踐踏在腳下<note caller="+" style="f"><char style="fr" closed="false">68:30 </char><char style="ft" closed="false">把貪愛銀塊的人踐踏在腳下——或譯作「使他們俯首獻上貢銀」。</char></note>，</para>
  <para style="q1" vid="PSA 68:30">驅散那喜好戰鬥的民眾。<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />公使們將從<char style="pn">埃及</char>前來，</para>
  <para style="q1" vid="PSA 68:31">
    <char style="pn">庫實</char>也急忙向神伸出手。<verse eid="PSA 68:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />地上的列國啊，你們當向神歌唱，</para>
  <para style="q1" vid="PSA 68:32">當歌頌主！<char style="qs">細拉</char><verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />歌頌那自古乘駕於天上之天的主！</para>
  <para style="q1" vid="PSA 68:33">看哪，他發出聲音，是強大的聲音！<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />你們當陳明神的大能，</para>
  <para style="q1" vid="PSA 68:34">他的威榮在<char style="pn">以色列</char>之上，</para>
  <para style="q1" vid="PSA 68:34">他的大能在雲霄之中。<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />神哪，你在你的聖所顯為可畏！</para>
  <para style="q1" vid="PSA 68:35">
    <char style="pn">以色列</char>的神是把力量和權能賜給子民的。</para>
  <para style="q1" vid="PSA 68:35">神是當受頌讚的！<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s">哀求神的拯救</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮，用「百合花」曲調。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />神哪，求你拯救我，</para>
  <para style="q1" vid="PSA 69:1">因為眾水臨近，直至我的脖子！<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />我陷入深深的沼澤中，沒有立足之地；</para>
  <para style="q1" vid="PSA 69:2">我進入眾水的深處，洪流漫過我身。<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />我因呼求而疲憊，我的喉嚨焦乾；</para>
  <para style="q1" vid="PSA 69:3">我的眼睛衰竭，期盼著我的神。<verse eid="PSA 69:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />無故恨我的人，比我的頭髮還多；</para>
  <para style="q1" vid="PSA 69:4">無理與我為敵、要除盡我的人，實在強盛。</para>
  <para style="q1" vid="PSA 69:4">我沒有搶奪什麼，竟然必須償還！<verse eid="PSA 69:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />神哪，我的愚妄，你是知道的，</para>
  <para style="q1" vid="PSA 69:5">我的罪責，不能向你隱瞞！<verse eid="PSA 69:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />萬軍之主耶和華啊，</para>
  <para style="q1" vid="PSA 69:6">願那些等候你的人，不要因我而蒙羞！</para>
  <para style="q1" vid="PSA 69:6">
    <char style="pn">以色列</char>的神哪，</para>
  <para style="q1" vid="PSA 69:6">願那些尋求你的人，不要因我而受辱！<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />因為我為你的緣故承受辱罵，臉上蒙羞。<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />我的弟兄們把我當作外族人，</para>
  <para style="q1" vid="PSA 69:8">我母親的兒女把我當作外人。<verse eid="PSA 69:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />然而我為你的殿，心火焚燒；</para>
  <para style="q1" vid="PSA 69:9">辱罵你之人的辱罵都落在我身上。<verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />我哭泣，以禁食刻苦<note caller="+" style="f"><char style="fr" closed="false">69:10 </char><char style="ft" closed="false">刻苦——輔助詞語。</char></note>我心，</para>
  <para style="q1" vid="PSA 69:10">這卻成了對我的羞辱；<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />我披上麻布為衣袍，</para>
  <para style="q1" vid="PSA 69:11">我卻成了他們的笑柄。<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />坐在城門口的人談論我，</para>
  <para style="q1" vid="PSA 69:12">我成了醉酒之人的歌謠。<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />可是我，耶和華啊，我向你禱告！</para>
  <para style="q1" vid="PSA 69:13">神哪，在悅納的時候，</para>
  <para style="q1" vid="PSA 69:13">求你藉著你豐盛的慈愛，</para>
  <para style="q1" vid="PSA 69:13">藉著你信實的救恩，回應我吧！<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />求你解救我脫離淤泥，</para>
  <para style="q1" vid="PSA 69:14">不要讓我陷下去；</para>
  <para style="q1" vid="PSA 69:14">解救我脫離恨我的人，</para>
  <para style="q1" vid="PSA 69:14">脫離眾水的深處。<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />求你不要讓洪流漫過我，</para>
  <para style="q1" vid="PSA 69:15">不要讓深淵吞掉我，</para>
  <para style="q1" vid="PSA 69:15">不要讓深坑的口在我上面關閉。<verse eid="PSA 69:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />耶和華啊，求你回應我，</para>
  <para style="q1" vid="PSA 69:16">因為你的慈愛是美善的！</para>
  <para style="q1" vid="PSA 69:16">求你照著你豐盛的憐憫轉向我！<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />不要向你的僕人隱藏你的臉，</para>
  <para style="q1" vid="PSA 69:17">因為我在危難中；</para>
  <para style="q1" vid="PSA 69:17">求你快快回應我！<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />求你親近我的靈魂，贖回我；</para>
  <para style="q1" vid="PSA 69:18">求你因我仇敵的緣故救贖我！<verse eid="PSA 69:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />我所受的辱罵、恥辱和羞愧，</para>
  <para style="q1" vid="PSA 69:19">你都知道；</para>
  <para style="q1" vid="PSA 69:19">我所有的敵人，都在你面前。<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />辱罵使我心靈破碎，我就絕望。</para>
  <para style="q1" vid="PSA 69:20">我等候有人勸慰，卻得不到；</para>
  <para style="q1" vid="PSA 69:20">我等候有人安慰，卻找不到。<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />他們還在我的食物中放入膽汁，</para>
  <para style="q1" vid="PSA 69:21">我渴了，他們把醋給我喝。<verse eid="PSA 69:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />願他們的筵席在他們面前成為網羅，</para>
  <para style="q1" vid="PSA 69:22">在他們平安的時候<note caller="+" style="f"><char style="fr" closed="false">69:22 </char><char style="ft" closed="false">在他們平安的時候——或譯作「對他們的盟友」。</char></note>成為陷阱。<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />願他們的眼睛變為昏暗，不能看見；</para>
  <para style="q1" vid="PSA 69:23">求你使他們的腰一直顫抖。<verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />求你向他們傾瀉你的憤怒，</para>
  <para style="q1" vid="PSA 69:24">願你猛烈的怒氣追上他們。<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />願他們的營寨變得荒涼，</para>
  <para style="q1" vid="PSA 69:25">願他們的帳篷無人居住；<verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />因為他們追逼你所打擊的人，</para>
  <para style="q1" vid="PSA 69:26">議論你所擊傷之人的痛苦。<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />求你使他們罪上加罪，</para>
  <para style="q1" vid="PSA 69:27">不要讓他們進入你的公義。<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />願他們從生命冊上被抹掉，</para>
  <para style="q1" vid="PSA 69:28">不要讓他們與義人一同被記錄。<verse eid="PSA 69:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />至於我，我困苦傷痛；</para>
  <para style="q1" vid="PSA 69:29">神哪，願你的救恩將我安置在高處！<verse eid="PSA 69:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />我要用詩歌讚美神的名，</para>
  <para style="q1" vid="PSA 69:30">以感謝來尊他為大；<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />這會使耶和華喜悅，</para>
  <para style="q1" vid="PSA 69:31">勝過獻上<note caller="+" style="f"><char style="fr" closed="false">69:31 </char><char style="ft" closed="false">獻上——輔助詞語。</char></note>牛，</para>
  <para style="q1" vid="PSA 69:31">勝過獻上<note caller="+" style="f"><char style="fr" closed="false">69:31 </char><char style="ft" closed="false">獻上——輔助詞語。</char></note>有角有蹄的公牛。<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />卑微人看見就歡喜，</para>
  <para style="q1" vid="PSA 69:32">求問神的人哪，願你們的心得以存活！<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />因為耶和華垂聽貧窮人，</para>
  <para style="q1" vid="PSA 69:33">不輕視他被囚的子民。<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />願諸天和大地、</para>
  <para style="q1" vid="PSA 69:34">海洋和其中游動的一切，都讚美他！<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />因為神將拯救<char style="pn">錫安</char>，建造<char style="pn">猶大</char>的各城；</para>
  <para style="q1" vid="PSA 69:35">他的子民將住在那裡，擁有那地。<verse eid="PSA 69:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36" />他僕人的後裔將以那地為繼業，</para>
  <para style="q1" vid="PSA 69:36">愛他名的人將在其中安居。<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s">求神快來解救</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的記念詩<note caller="+" style="f"><char style="fr" closed="false">70:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />神哪，求你快來解救我！</para>
  <para style="q1" vid="PSA 70:1">耶和華啊，求你快來幫助我！<verse eid="PSA 70:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />願那些尋索我性命的，抱愧蒙羞；</para>
  <para style="q1" vid="PSA 70:2">願那些喜歡我遭害的，後退受辱。<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />願那些說「啊哈，啊哈」的，</para>
  <para style="q1" vid="PSA 70:3">因自己的恥辱而退回。<verse eid="PSA 70:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />願所有尋求你的，都因你而高興歡喜；</para>
  <para style="q1" vid="PSA 70:4">願那些喜愛你救恩的常說：</para>
  <para style="q1" vid="PSA 70:4">「願神被尊為大！」<verse eid="PSA 70:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />至於我，我困苦貧窮；</para>
  <para style="q1" vid="PSA 70:5">神哪，求你快到我這裡來！</para>
  <para style="q1" vid="PSA 70:5">你是我的幫助、我的救主，</para>
  <para style="q1" vid="PSA 70:5">耶和華啊，求你不要遲延！<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s">自幼到老的依靠</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />耶和華啊，我投靠了你，</para>
  <para style="q1" vid="PSA 71:1">求你使我永不蒙羞！<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />求你照著你的公義解救我，救拔我；</para>
  <para style="q1" vid="PSA 71:2">求你向我側耳聽，拯救我。<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />求你作我安身的磐石，</para>
  <para style="q1" vid="PSA 71:3">讓我可以隨時來投靠你<note caller="+" style="f"><char style="fr" closed="false">71:3 </char><char style="ft" closed="false">投靠你——輔助詞語。</char></note>；</para>
  <para style="q1" vid="PSA 71:3">你已經命定要拯救我，</para>
  <para style="q1" vid="PSA 71:3">因為你是我的岩石、我的要塞。<verse eid="PSA 71:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />我的神哪，求你挽救我脫離惡人的手，</para>
  <para style="q1" vid="PSA 71:4">脫離行事不義和苦毒之人的手；<verse eid="PSA 71:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />因為你是我的希望！</para>
  <para style="q1" vid="PSA 71:5">主耶和華啊，從我年幼以來，</para>
  <para style="q1" vid="PSA 71:5">你就是我的依賴！<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />我在胎胞中就依賴你，</para>
  <para style="q1" vid="PSA 71:6">是你從母腹中把我接出來，</para>
  <para style="q1" vid="PSA 71:6">我要時常讚美你。<verse eid="PSA 71:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />我在眾人眼中成了某種惡兆，</para>
  <para style="q1" vid="PSA 71:7">但你是我堅固的避難所。<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />我的口充滿你當受的讚美，</para>
  <para style="q1" vid="PSA 71:8">終日述說<note caller="+" style="f"><char style="fr" closed="false">71:8 </char><char style="ft" closed="false">述說——輔助詞語。</char></note>你的榮耀。<verse eid="PSA 71:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />我年老時，求你不要丟棄我，</para>
  <para style="q1" vid="PSA 71:9">我力量衰竭時，求你不要離棄我；<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />因為我的仇敵議論我，</para>
  <para style="q1" vid="PSA 71:10">伺機要害我命的人一同商議，<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />他們說：「神已經離棄了他。</para>
  <para style="q1" vid="PSA 71:11">追趕他，抓住他，因為沒有人救他！」<verse eid="PSA 71:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />神哪，求你不要遠離我！</para>
  <para style="q1" vid="PSA 71:12">我的神哪，求你快來幫助我！<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />願我的死敵，蒙羞滅絕；</para>
  <para style="q1" vid="PSA 71:13">願那些謀害我的，披戴辱罵和羞愧。<verse eid="PSA 71:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />至於我，我要一直盼望，</para>
  <para style="q1" vid="PSA 71:14">並向你獻上更多的讚美。<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />我的口要終日講述你的公義和救恩，</para>
  <para style="q1" vid="PSA 71:15">其數無法數算。<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />我因主耶和華的大能而來，</para>
  <para style="q1" vid="PSA 71:16">我要提說唯屬你的公義。<verse eid="PSA 71:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />神哪，從我年幼以來，你就教導我！</para>
  <para style="q1" vid="PSA 71:17">直到如今，我還宣告你的奇妙作為。<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />神哪，縱然到我年老髮白的時候，</para>
  <para style="q1" vid="PSA 71:18">你也不要離棄我，</para>
  <para style="q1" vid="PSA 71:18">直到我向這世代宣告你的力量<note caller="+" style="f"><char style="fr" closed="false">71:18 </char><char style="ft" closed="false">力量——原文直譯「膀臂」。</char></note>，</para>
  <para style="q1" vid="PSA 71:18">向後世所有的人宣告你的大能！<verse eid="PSA 71:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />神哪，你的公義上達高天；</para>
  <para style="q1" vid="PSA 71:19">你已經行了大事！</para>
  <para style="q1" vid="PSA 71:19">神哪，誰能像你那樣呢？<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />雖然你使我看到許多患難和惡事，</para>
  <para style="q1" vid="PSA 71:20">但你必使我再次活過來，</para>
  <para style="q1" vid="PSA 71:20">把我從地的深處再次帶上來。<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />願你使我的尊榮增多，</para>
  <para style="q1" vid="PSA 71:21">願你轉過來安慰我。<verse eid="PSA 71:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />我的神哪，</para>
  <para style="q1" vid="PSA 71:22">我要用里拉琴來稱謝你，</para>
  <para style="q1" vid="PSA 71:22">稱謝你的信實！</para>
  <para style="q1" vid="PSA 71:22">
    <char style="pn">以色列</char>的聖者啊，</para>
  <para style="q1" vid="PSA 71:22">我要用豎琴歌頌你！<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />我歌頌你的時候，</para>
  <para style="q1" vid="PSA 71:23">我的嘴唇要歡呼；</para>
  <para style="q1" vid="PSA 71:23">我的靈魂，就是你所救贖的靈魂，</para>
  <para style="q1" vid="PSA 71:23">必要歡呼。<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />我的舌頭也要終日述說你的公義，</para>
  <para style="q1" vid="PSA 71:24">因為那些謀害我的已經抱愧蒙羞。<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s">為王祈禱</para>
  <para style="b" />
  <para style="d">
    <char style="pn">所羅門</char>的詩<note caller="+" style="f"><char style="fr" closed="false">72:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />神哪，求你把你的公正賜給王，</para>
  <para style="q1" vid="PSA 72:1">把你的公義賜給王的兒子！<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />願他以公義審斷你的子民，</para>
  <para style="q1" vid="PSA 72:2">以公正審斷屬你的困苦人；<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />願群山和岡陵藉著公義為百姓帶來平安；<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />願他為子民中的困苦人施行審判，</para>
  <para style="q1" vid="PSA 72:4">拯救貧窮人的兒女，壓碎那欺壓者。<verse eid="PSA 72:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />人們必敬畏你，</para>
  <para style="q1" vid="PSA 72:5">如日之恆，如月之久，</para>
  <para style="q1" vid="PSA 72:5">直到萬代。<verse eid="PSA 72:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />他必降臨，</para>
  <para style="q1" vid="PSA 72:6">如同雨水降在割過的草地上，</para>
  <para style="q1" vid="PSA 72:6">又如甘霖滋潤大地。<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />在他的日子裡，義人必興盛，</para>
  <para style="q1" vid="PSA 72:7">並有豐盛的平安，如月長存<note caller="+" style="f"><char style="fr" closed="false">72:7 </char><char style="ft" closed="false">如月長存——原文直譯「直到月亮不復存在」。</char></note>。<verse eid="PSA 72:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />願他執掌大權，從這海直到那海，</para>
  <para style="q1" vid="PSA 72:8">從大河<note caller="+" style="f"><char style="fr" closed="false">72:8 </char><char style="ft" closed="false">大河——指幼發拉底河。</char></note>直到地極。<verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />曠野的走獸將在他面前屈身，</para>
  <para style="q1" vid="PSA 72:9">他的仇敵將舔食塵土。<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />
    <char style="pn">塔爾施</char>和眾海島的君王們將帶來貢物，</para>
  <para style="q1" vid="PSA 72:10">
    <char style="pn">示巴</char>和<char style="pn">西拔</char>的君王們將獻上禮物。<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />所有的君王都要向他下拜，</para>
  <para style="q1" vid="PSA 72:11">所有的國家都要服事他。<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />他解救那呼救的貧窮人，</para>
  <para style="q1" vid="PSA 72:12">以及那無人幫助的困苦人；<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />他顧惜貧弱者和窮人，</para>
  <para style="q1" vid="PSA 72:13">拯救窮人的性命；<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />他從欺壓和殘暴中贖回他們的性命，</para>
  <para style="q1" vid="PSA 72:14">他們的血在他眼中看為寶貴。<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />願他長壽！</para>
  <para style="q1" vid="PSA 72:15">願人把<char style="pn">示巴</char>的金子獻給他；</para>
  <para style="q1" vid="PSA 72:15">願人一直為他禱告，終日祝福他。<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />願穀物在大地、在群山的頂上豐盛；</para>
  <para style="q1" vid="PSA 72:16">願它們的果實晃動，如同<char style="pn">黎巴嫩</char>的香柏樹<note caller="+" style="f"><char style="fr" closed="false">72:16 </char><char style="ft" closed="false">的香柏樹——輔助詞語。</char></note>；</para>
  <para style="q1" vid="PSA 72:16">願城中人丁興旺，如同地上的牧草。<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />願他的名存到永遠，</para>
  <para style="q1" vid="PSA 72:17">如太陽長久；</para>
  <para style="q1" vid="PSA 72:17">願人們因他蒙福，</para>
  <para style="q1" vid="PSA 72:17">願所有的國家都稱他有福。<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />耶和華神——獨行奇事的<char style="pn">以色列</char>的神，</para>
  <para style="q1" vid="PSA 72:18">是當受頌讚的！<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />他榮耀的名是當受頌讚的，直到永遠；</para>
  <para style="q1" vid="PSA 72:19">願他的榮耀充滿全地！</para>
  <para style="q1" vid="PSA 72:19">阿們，阿們！<verse eid="PSA 72:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />
    <char style="pn">耶西</char>的兒子<char style="pn">大衛</char>的禱告結束。<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">第三卷</para>
  <para style="mr">（<ref loc="PSA 73-89">詩篇73-89</ref>）</para>
  <para style="b" />
  <para style="s">述說神的公義</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />神必然善待<char style="pn">以色列</char>，</para>
  <para style="q1" vid="PSA 73:1">善待那些心裡純潔的人。<verse eid="PSA 73:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />至於我，我的腳幾乎絆跌，</para>
  <para style="q1" vid="PSA 73:2">我的腳步快要散亂；<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />因為我看到惡人享平安時，</para>
  <para style="q1" vid="PSA 73:3">就嫉妒那些狂傲的人。<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />他們到死也沒有疼痛，</para>
  <para style="q1" vid="PSA 73:4">他們的身體肥壯；<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />他們沒有一般人所受的苦難，</para>
  <para style="q1" vid="PSA 73:5">也不與普通人一樣遭遇災害。<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />因此自高是他們的項鏈，</para>
  <para style="q1" vid="PSA 73:6">殘暴如衣裳披在他們的身上。<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />他們的眼睛因體胖而凸出，</para>
  <para style="q1" vid="PSA 73:7">心裡的妄想四處氾濫。<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />他們譏諷、嘲笑，</para>
  <para style="q1" vid="PSA 73:8">懷著惡意說欺壓人的話。</para>
  <para style="q1" vid="PSA 73:8">他們說話出於高傲；<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />他們開口褻瀆上天，</para>
  <para style="q1" vid="PSA 73:9">他們的舌頭殃及全地，<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />以致連神的子民也轉向那裡，</para>
  <para style="q1" vid="PSA 73:10">喝了他們大量的水。<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />他們說：「神怎能知道呢？</para>
  <para style="q1" vid="PSA 73:11">至高者有知識嗎？」<verse eid="PSA 73:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />看哪，惡人就是這樣——</para>
  <para style="q1" vid="PSA 73:12">他們常享安穩，財富增添。<verse eid="PSA 73:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />即使我保持內心純潔，</para>
  <para style="q1" vid="PSA 73:13">洗淨雙手表明清白，</para>
  <para style="q1" vid="PSA 73:13">也都是徒然的！<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />我終日遭受責打，</para>
  <para style="q1" vid="PSA 73:14">每天早晨遭受責備。<verse eid="PSA 73:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />如果我這樣說話<note caller="+" style="f"><char style="fr" closed="false">73:15 </char><char style="ft" closed="false">如果我這樣說話——原文直譯「如果我說『我要這樣說』」。</char></note>，</para>
  <para style="q1" vid="PSA 73:15">就是對你這一代的兒女背信了。<verse eid="PSA 73:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />我思想，要明白這事，</para>
  <para style="q1" vid="PSA 73:16">這在我眼中實在困惑；<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />直到我進了神的聖所，</para>
  <para style="q1" vid="PSA 73:17">才明白他們的結局：<verse eid="PSA 73:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />你確實把他們放在易滑之地，</para>
  <para style="q1" vid="PSA 73:18">使他們仆倒滅亡。<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />他們怎麼一瞬間成了荒場呢？</para>
  <para style="q1" vid="PSA 73:19">他們被恐怖的事徹底清除！<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />人醒來時怎樣輕視夢，</para>
  <para style="q1" vid="PSA 73:20">主啊，你醒起時，</para>
  <para style="q1" vid="PSA 73:20">也會怎樣輕視夢幻般的他們！<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />我心中苦毒，</para>
  <para style="q1" vid="PSA 73:21">肺腑被刺傷時，<verse eid="PSA 73:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22" />我是愚昧無知的；</para>
  <para style="q1" vid="PSA 73:22">我在你面前如同畜類。<verse eid="PSA 73:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />但是我一直隨著你；</para>
  <para style="q1" vid="PSA 73:23">你抓住我的右手。<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />你以你的謀略引導我，</para>
  <para style="q1" vid="PSA 73:24">以後必接我到榮耀裡。<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />除你以外，在天上我還有誰呢？</para>
  <para style="q1" vid="PSA 73:25">除你以外，在地上我也沒有所喜悅的。<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />我的肉體和我的心都在衰竭，</para>
  <para style="q1" vid="PSA 73:26">但神是我心裡的力量<note caller="+" style="f"><char style="fr" closed="false">73:26 </char><char style="ft" closed="false">力量——原文直譯「磐石」。</char></note>，</para>
  <para style="q1" vid="PSA 73:26">是我繼業的份，直到永遠。<verse eid="PSA 73:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />看哪，遠離你的都將滅亡；</para>
  <para style="q1" vid="PSA 73:27">所有行淫背叛你的，你都要除盡！<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />至於我，在神的近旁對我是美好的；</para>
  <para style="q1" vid="PSA 73:28">我以主耶和華為我的避難所，</para>
  <para style="q1" vid="PSA 73:28">為要講述他<note caller="+" style="f"><char style="fr" closed="false">73:28 </char><char style="ft" closed="false">他——原文直譯「你」。</char></note>一切的作為。<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s">為子民的禱告</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的智慧詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />神哪，你為什麼永久拋棄了我們呢？</para>
  <para style="q1" vid="PSA 74:1">為什麼你的怒氣向你牧場的羊群如煙冒出呢？<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />求你記念你古時就買贖了的會眾，</para>
  <para style="q1" vid="PSA 74:2">就是你所贖回作你繼業的支派；</para>
  <para style="q1" vid="PSA 74:2">求你記念你所安居的<char style="pn">錫安</char>山。<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />求你舉步到那長久荒涼之地——</para>
  <para style="q1" vid="PSA 74:3">在聖所中，仇敵已經做了一切惡事。<verse eid="PSA 74:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />你的敵人在你的會所中吼叫，</para>
  <para style="q1" vid="PSA 74:4">設立了自己的標幟為記號；<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />他們像是在樹林中揮斧頭的人；<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />而現在，他們用斧子和錘子，</para>
  <para style="q1" vid="PSA 74:6">把聖所<note caller="+" style="f"><char style="fr" closed="false">74:6 </char><char style="ft" closed="false">聖所——原文直譯「她」。</char></note>的雕刻全都擊碎了。<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />他們放火把你的聖所燒成平地，</para>
  <para style="q1" vid="PSA 74:7">褻瀆了你名的居所。<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />他們心裡說：</para>
  <para style="q1" vid="PSA 74:8">「我們要徹底制伏這些人！」</para>
  <para style="q1" vid="PSA 74:8">他們在地上焚燒了神一切的會所。<verse eid="PSA 74:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />我們看不到自己的標幟<note caller="+" style="f"><char style="fr" closed="false">74:9 </char><char style="ft" closed="false">自己的標幟——或譯作「你給我們的徵兆」。</char></note>，</para>
  <para style="q1" vid="PSA 74:9">也不再有先知；</para>
  <para style="q1" vid="PSA 74:9">在我們中間，</para>
  <para style="q1" vid="PSA 74:9">沒有人知道這要到什麼時候。<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />神哪，敵人的辱罵要到什麼時候呢？</para>
  <para style="q1" vid="PSA 74:10">仇敵要永久藐視你的名嗎？<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />你為什麼把你的手、把你的右手收回去呢？</para>
  <para style="q1" vid="PSA 74:11">求你從懷中伸出手，滅絕他們！<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />神哪，你自古以來就是我的王，</para>
  <para style="q1" vid="PSA 74:12">你在地上施行拯救！<verse eid="PSA 74:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />你以你的力量分開了海洋，</para>
  <para style="q1" vid="PSA 74:13">打碎了眾水中巨獸的頭。<verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />你壓碎了<char style="pn">利維坦</char>的頭，</para>
  <para style="q1" vid="PSA 74:14">把牠賜給曠野中的人和獸<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="ft" closed="false">人和獸——原文直譯「民眾」。</char></note>作食物。<verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />你開闢泉源和溪流，</para>
  <para style="q1" vid="PSA 74:15">也使常流的河乾枯。<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />白晝屬你，黑夜也屬你；</para>
  <para style="q1" vid="PSA 74:16">明亮的星體<note caller="+" style="f"><char style="fr" closed="false">74:16 </char><char style="ft" closed="false">明亮的星體——或譯作「月亮」。</char></note>和太陽是你確立的。<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />你劃定了大地所有的疆界，</para>
  <para style="q1" vid="PSA 74:17">你設定了夏季和冬季。<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />耶和華啊，求你記住這事：</para>
  <para style="q1" vid="PSA 74:18">仇敵辱罵你，愚頑的子民藐視你的名！<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />不要把你斑鳩<note caller="+" style="f"><char style="fr" closed="false">74:19 </char><char style="ft" closed="false">斑鳩——指以色列。</char></note>的性命交給野獸，</para>
  <para style="q1" vid="PSA 74:19">不要永久忘記你困苦人的生命。<verse eid="PSA 74:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />求你顧念所立的約，</para>
  <para style="q1" vid="PSA 74:20">因為強暴的居所遍布在大地的黑暗之處。<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />不要讓被壓迫的人受辱而返；</para>
  <para style="q1" vid="PSA 74:21">願困苦人和貧窮人都讚美你的名。<verse eid="PSA 74:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />神哪，求你起來為自己辯護，</para>
  <para style="q1" vid="PSA 74:22">求你記住愚頑人終日對你的辱罵！<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />不要忘記你敵人的聲音——</para>
  <para style="q1" vid="PSA 74:23">那些起來敵對你之人的喧嚷一直上升！<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s">神降卑惡人高舉義人</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的詩，一首歌，給樂隊指揮，用「不要毀滅<note caller="+" style="f"><char style="fr" closed="false">75:0 </char><char style="ft" closed="false">不要毀滅——參《以賽亞書》65:8。</char></note>」曲調。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />我們稱謝你，</para>
  <para style="q1" vid="PSA 75:1">神哪，我們稱謝你！</para>
  <para style="q1" vid="PSA 75:1">你的名就在近處，</para>
  <para style="q1" vid="PSA 75:1">人們都講述你的奇妙作為。<verse eid="PSA 75:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />「在我選定的時期，</para>
  <para style="q1" vid="PSA 75:2">我必以正直施行審判。<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />大地和其上所有的居民都消融時，</para>
  <para style="q1" vid="PSA 75:3">是我穩固了大地的柱子。<char style="qs">細拉</char><verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />我對誇耀的人說：『不要誇耀！』</para>
  <para style="q1" vid="PSA 75:4">又對惡人說：『不要高舉你們的角！<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />不要向上高舉你們的角，</para>
  <para style="q1" vid="PSA 75:5">不要揚起脖子說傲慢的話！』」<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />因為人被高舉不是來自東面或西面，</para>
  <para style="q1" vid="PSA 75:6">也不是來自曠野；<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />因為神是審判者，</para>
  <para style="q1" vid="PSA 75:7">他降卑這人、高舉那人；<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />原來在耶和華的手中有杯，</para>
  <para style="q1" vid="PSA 75:8">杯中酒泛著泡沫，充滿混合物；</para>
  <para style="q1" vid="PSA 75:8">他倒出酒，地上所有的惡人都必須喝，</para>
  <para style="q1" vid="PSA 75:8">甚至連杯中的渣滓都要喝盡！<verse eid="PSA 75:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />至於我，我要永遠宣揚他的作為<note caller="+" style="f"><char style="fr" closed="false">75:9 </char><char style="ft" closed="false">他的作為——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PSA 75:9">並歌頌<char style="pn">雅各</char>的神。<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />神說：「惡人一切的角，我將砍斷；</para>
  <para style="q1" vid="PSA 75:10">而義人的角，必被高舉。」<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s">可畏的神</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的詩，一首歌，給樂隊指揮，用弦樂器。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />在<char style="pn">猶大</char>，神被人所認識；</para>
  <para style="q1" vid="PSA 76:1">在<char style="pn">以色列</char>，他的名為大。<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />他的帳幕在<char style="pn">撒冷</char>，</para>
  <para style="q1" vid="PSA 76:2">他的住處在<char style="pn">錫安</char>。<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />在那裡，他打斷了弓上帶著烈焰的箭，</para>
  <para style="q1" vid="PSA 76:3">以及盾牌、刀劍和爭戰的兵器<note caller="+" style="f"><char style="fr" closed="false">76:3 </char><char style="ft" closed="false">的兵器——輔助詞語。</char></note>。<char style="qs">細拉</char><verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />你大有榮光，</para>
  <para style="q1" vid="PSA 76:4">比獵物豐富的群山更壯美。<note caller="+" style="f"><char style="fr" closed="false">76:4 </char><char style="ft" closed="false">此節七十士譯本作「你從遠古的群山，壯觀地發出光輝。」</char></note><verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />心強膽壯的人都被搶奪，長眠不醒；</para>
  <para style="q1" vid="PSA 76:5">所有大能的勇士都手足無措<note caller="+" style="f"><char style="fr" closed="false">76:5 </char><char style="ft" closed="false">手足無措——原文直譯「找不到自己的手」。</char></note>。<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />
    <char style="pn">雅各</char>的神哪，因你的斥責，</para>
  <para style="q1" vid="PSA 76:6">駕戰車的和戰馬都沉睡了！<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />唯獨你是可畏的！</para>
  <para style="q1" vid="PSA 76:7">你一旦怒氣發作，</para>
  <para style="q1" vid="PSA 76:7">誰能在你面前站立得住呢？<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />你從天上宣告判決，</para>
  <para style="q1" vid="PSA 76:8">大地就懼怕，並且緘默；<verse eid="PSA 76:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9" />那時神要起來，</para>
  <para style="q1" vid="PSA 76:9">為要施行公正，</para>
  <para style="q1" vid="PSA 76:9">為要拯救地上所有的卑微人。<char style="qs">細拉</char><verse eid="PSA 76:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />人的怒火，也會使你得稱讚；</para>
  <para style="q1" vid="PSA 76:10">你也會以餘怒束腰。<verse eid="PSA 76:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />你們當向耶和華你們的神許願，</para>
  <para style="q1" vid="PSA 76:11">並要還願；</para>
  <para style="q1" vid="PSA 76:11">所有在他四圍的人，</para>
  <para style="q1" vid="PSA 76:11">都要把禮物帶給當受敬畏的那一位！<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />他挫敗領袖們的心志，</para>
  <para style="q1" vid="PSA 76:12">被地上的君王所敬畏。<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s">神是患難中的力量</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的詩，給樂隊指揮<char style="pn">耶杜頓</char>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />我向著神發聲，我呼求；</para>
  <para style="q1" vid="PSA 77:1">我向著神發聲，他就傾聽。<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />在我患難的日子裡，我求問主，</para>
  <para style="q1" vid="PSA 77:2">夜間我的手伸著祈求，也不倦怠；</para>
  <para style="q1" vid="PSA 77:2">我的靈魂不肯受安慰。<verse eid="PSA 77:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />我記念神，大聲哀鳴；</para>
  <para style="q1" vid="PSA 77:3">我默想，就靈裡虛弱。<char style="qs">細拉</char><verse eid="PSA 77:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />你使我不能合眼<note caller="+" style="f"><char style="fr" closed="false">77:4 </char><char style="ft" closed="false">你使我不能合眼——原文直譯「你撐住我的眼皮」。</char></note>；</para>
  <para style="q1" vid="PSA 77:4">我煩亂不安，甚至不能說話。<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />我追想古時的日子、亙古的歲月。<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />夜間我記起我的歌曲，</para>
  <para style="q1" vid="PSA 77:6">我心中默想，靈裡仔細省察：<verse eid="PSA 77:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />難道主要永遠拋棄我們<note caller="+" style="f"><char style="fr" closed="false">77:7 </char><char style="ft" closed="false">我們——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PSA 77:7">不再悅納我們<note caller="+" style="f"><char style="fr" closed="false">77:7 </char><char style="ft" closed="false">我們——輔助詞語。</char></note>嗎？<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />難道他的慈愛永久消逝，</para>
  <para style="q1" vid="PSA 77:8">他的言語斷絕，直到萬代嗎？<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />難道神忘記了施恩，</para>
  <para style="q1" vid="PSA 77:9">在怒氣中收起了他的憐憫嗎？<char style="qs">細拉</char><verse eid="PSA 77:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />我就說：「我痛心的是：</para>
  <para style="q1" vid="PSA 77:10">至高者右手的能力<note caller="+" style="f"><char style="fr" closed="false">77:10 </char><char style="ft" closed="false">能力——輔助詞語。</char></note>變了。」<verse eid="PSA 77:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />我要記念耶和華的作為，</para>
  <para style="q1" vid="PSA 77:11">是的，我要記念你古時奇妙的事。<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />我思想你一切的作為，</para>
  <para style="q1" vid="PSA 77:12">默想你所行的事。<verse eid="PSA 77:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />神哪，你的道路聖潔，</para>
  <para style="q1" vid="PSA 77:13">有哪個神明像神那樣偉大呢？<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />你是那位行奇妙事的神，</para>
  <para style="q1" vid="PSA 77:14">在萬民中顯明你的力量。<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />你用膀臂贖回你的子民，</para>
  <para style="q1" vid="PSA 77:15">就是<char style="pn">雅各</char>和<char style="pn">約瑟</char>的子孫。<char style="qs">細拉</char><verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />神哪，眾水看見你，</para>
  <para style="q1" vid="PSA 77:16">眾水看見你就震撼，連深淵也顫抖！<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />烏雲傾瀉雨水，雲霄發出雷聲，</para>
  <para style="q1" vid="PSA 77:17">你的箭也飛射四方。<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />你的雷聲在旋風中，</para>
  <para style="q1" vid="PSA 77:18">你的閃電照亮世界，大地顫抖震動。<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />你的道路在海洋中，</para>
  <para style="q1" vid="PSA 77:19">你的路途在大水上，</para>
  <para style="q1" vid="PSA 77:19">但你的腳蹤沒有人知道。<verse eid="PSA 77:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />你藉著<char style="pn">摩西</char>和<char style="pn">亞倫</char>的手，</para>
  <para style="q1" vid="PSA 77:20">引導你的子民如同引導羊群。<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s">不忘神的奇妙作為</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的智慧詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />我的子民哪，當傾聽我的訓誨，</para>
  <para style="q1" vid="PSA 78:1">側耳聽我口中的言語！<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />我要開口說比喻，</para>
  <para style="q1" vid="PSA 78:2">說出古時的謎題，<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />就是我們所聽過、所知道的，</para>
  <para style="q1" vid="PSA 78:3">也是我們的祖先向我們講述過的——<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />我們不會向子孫隱瞞，</para>
  <para style="q1" vid="PSA 78:4">而要向後代講述對耶和華的讚美，</para>
  <para style="q1" vid="PSA 78:4">講述他的大能和他所行的奇妙作為。<verse eid="PSA 78:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />他在<char style="pn">雅各</char>中立下法度，</para>
  <para style="q1" vid="PSA 78:5">在<char style="pn">以色列</char>中設立律法，</para>
  <para style="q1" vid="PSA 78:5">就是他吩咐我們的祖先教導子孫的，<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />好讓將要出生的後代子孫可以明白，</para>
  <para style="q1" vid="PSA 78:6">並且起來向他們的子孫講述；<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />這樣他們就把神當作他們的依靠，</para>
  <para style="q1" vid="PSA 78:7">不會忘記神所行的，而會謹守他的誡命；<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />以免像他們的祖先，</para>
  <para style="q1" vid="PSA 78:8">成為頑梗悖逆的一代，</para>
  <para style="q1" vid="PSA 78:8">心裡不堅定、靈裡對神不忠實的一代。<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />
    <char style="pn">以法蓮</char>的子孫是裝備好的弓箭手，</para>
  <para style="q1" vid="PSA 78:9">但他們在戰鬥之日轉身退後。<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />他們沒有遵守神的約，</para>
  <para style="q1" vid="PSA 78:10">不肯按照他的律法而行。<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />他們忘掉了他所行的，</para>
  <para style="q1" vid="PSA 78:11">以及他顯明給他們的奇妙作為。<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />他在<char style="pn">埃及</char>地，在<char style="pn">瑣安</char>的田野，</para>
  <para style="q1" vid="PSA 78:12">在他們的祖先面前，行了奇妙的事。<verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />他將海分開，使他們過去，</para>
  <para style="q1" vid="PSA 78:13">使眾水立起如壘。<verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />他白天用雲柱、</para>
  <para style="q1" vid="PSA 78:14">整夜用火光引導他們。<verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />他在曠野使磐石裂開，</para>
  <para style="q1" vid="PSA 78:15">流出多如深淵的水給他們喝。<verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />他讓水從岩石流出，</para>
  <para style="q1" vid="PSA 78:16">如江河流下。<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />可是他們又繼續對他犯罪，</para>
  <para style="q1" vid="PSA 78:17">在那乾旱之地悖逆至高者。<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />他們心中試探神，</para>
  <para style="q1" vid="PSA 78:18">隨著自己的欲望索要食物。<verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />他們說反對神的話：</para>
  <para style="q1" vid="PSA 78:19">「難道神能在曠野中擺設筵席嗎？<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />看哪，雖然他曾擊打磐石、</para>
  <para style="q1" vid="PSA 78:20">使水湧出、溪流漫溢，</para>
  <para style="q1" vid="PSA 78:20">難道他還能賜下糧食嗎？</para>
  <para style="q1" vid="PSA 78:20">還能為自己的子民預備肉嗎？」<verse eid="PSA 78:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />耶和華聽了就動怒，</para>
  <para style="q1" vid="PSA 78:21">烈火向<char style="pn">雅各</char>燃起，</para>
  <para style="q1" vid="PSA 78:21">怒氣也向<char style="pn">以色列</char>上騰；<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />因為他們不相信神，</para>
  <para style="q1" vid="PSA 78:22">也不依靠他的救恩。<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />但他還是吩咐天上的雲朵，</para>
  <para style="q1" vid="PSA 78:23">打開了天上的門；<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />他降下嗎哪給他們吃，</para>
  <para style="q1" vid="PSA 78:24">把天上的糧食賜給他們；<verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />人吃到了天使<note caller="+" style="f"><char style="fr" closed="false">78:25 </char><char style="ft" closed="false">天使——原文直譯「大能者」。</char></note>的糧食；</para>
  <para style="q1" vid="PSA 78:25">他賜食物給他們，使他們飽足。<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />他使東風從天上颳起，</para>
  <para style="q1" vid="PSA 78:26">以他的力量引導南風；<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />他降下肉給他們，多如塵土；</para>
  <para style="q1" vid="PSA 78:27">他降下飛鳥，多如海沙；<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />他使飛鳥落在他們營中，</para>
  <para style="q1" vid="PSA 78:28">在他們住處<note caller="+" style="f"><char style="fr" closed="false">78:28 </char><char style="ft" closed="false">他們營中，在他們住處——或譯作「自己營中，在自己帳幕」。</char></note>的四圍；<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />他們吃了，非常飽足；</para>
  <para style="q1" vid="PSA 78:29">神就這樣把他們所要的給了他們。<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />當他們貪得無厭，</para>
  <para style="q1" vid="PSA 78:30">食物還在他們口中的時候，<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />神的怒氣就向他們上騰，</para>
  <para style="q1" vid="PSA 78:31">他殺死了他們當中肥壯的，</para>
  <para style="q1" vid="PSA 78:31">使<char style="pn">以色列</char>的青年人倒下。<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />即使如此，他們還是犯罪，</para>
  <para style="q1" vid="PSA 78:32">不相信他的奇妙作為。<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />所以他使他們的日子在虛空中消逝，</para>
  <para style="q1" vid="PSA 78:33">使他們的歲月在突然驚恐中消亡。<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />他殺他們的時候，他們才尋求他，</para>
  <para style="q1" vid="PSA 78:34">回轉過來，切切尋求神。<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />他們這才記起神是他們的磐石，</para>
  <para style="q1" vid="PSA 78:35">至高神是他們的救贖主。<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />但他們用口欺騙他，</para>
  <para style="q1" vid="PSA 78:36">用舌對他說謊；<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />他們的心對他不堅定，</para>
  <para style="q1" vid="PSA 78:37">他們也不忠於他的約。<verse eid="PSA 78:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />然而神有憐憫，贖清了他們的罪孽，</para>
  <para style="q1" vid="PSA 78:38">沒有施行毀滅；</para>
  <para style="q1" vid="PSA 78:38">他多次使他的怒氣轉消，</para>
  <para style="q1" vid="PSA 78:38">沒有發盡他的怒火。<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />他顧念他們不過是血肉之軀，</para>
  <para style="q1" vid="PSA 78:39">是一陣去而不返的風。<verse eid="PSA 78:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />他們多少次在曠野悖逆他，</para>
  <para style="q1" vid="PSA 78:40">在荒漠使他憂傷！<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />他們屢次試探神，</para>
  <para style="q1" vid="PSA 78:41">惹動<char style="pn">以色列</char>的聖者。<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />他們不記念他手的能力<note caller="+" style="f"><char style="fr" closed="false">78:42 </char><char style="ft" closed="false">的能力——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PSA 78:42">不記念他救贖他們脫離敵人的日子。<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />那時他在<char style="pn">埃及</char>施行他的神蹟，</para>
  <para style="q1" vid="PSA 78:43">在<char style="pn">瑣安</char>的田野施行他的奇事。<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />他把<char style="pn">埃及</char>人的江河變成血，</para>
  <para style="q1" vid="PSA 78:44">他們就不能喝其中的流水。<verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />他打發成群的蒼蠅到他們中間，吞噬他們；</para>
  <para style="q1" vid="PSA 78:45">他打發青蛙，毀掉他們。<verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />他把他們的收成交給螞蚱，</para>
  <para style="q1" vid="PSA 78:46">把他們的辛苦所得交給蝗蟲。<verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />他用冰雹毀了他們的葡萄樹，</para>
  <para style="q1" vid="PSA 78:47">用嚴霜毀了他們的西克莫無花果樹。<verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />他把他們的家畜交給冰雹，</para>
  <para style="q1" vid="PSA 78:48">把他們的牲畜交給閃電。<verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />他向他們發出猛烈的怒氣——</para>
  <para style="q1" vid="PSA 78:49">盛怒、憤怒和患難，</para>
  <para style="q1" vid="PSA 78:49">像一隊降禍的使者。<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />他為自己的怒氣修平了路，</para>
  <para style="q1" vid="PSA 78:50">不惜讓他們死亡，</para>
  <para style="q1" vid="PSA 78:50">把他們的性命交給瘟疫。<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />他擊殺<char style="pn">埃及</char>所有的長子，</para>
  <para style="q1" vid="PSA 78:51">在<char style="pn">含</char>族帳篷中擊殺他們強壯時頭生的。<verse eid="PSA 78:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />他領出自己的子民如同領出羊群，</para>
  <para style="q1" vid="PSA 78:52">在曠野引領他們如同引領群羊。<verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />他引導他們安然行進，使他們不懼怕；</para>
  <para style="q1" vid="PSA 78:53">海水卻淹沒了他們的仇敵。<verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />他帶他們來到他聖地的邊界，</para>
  <para style="q1" vid="PSA 78:54">到他右手所得的那座山。<verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />他從他們面前驅逐列國，</para>
  <para style="q1" vid="PSA 78:55">用量繩為他們分繼業，</para>
  <para style="q1" vid="PSA 78:55">使<char style="pn">以色列</char>眾支派在他們的帳篷中安居。<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />但他們仍然試探、悖逆至高神，</para>
  <para style="q1" vid="PSA 78:56">不持守他的法度。<verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />他們退縮、背信，如同他們的祖先；</para>
  <para style="q1" vid="PSA 78:57">他們扭曲，如同翻背的弓。<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />他們的高壇使他惱怒，</para>
  <para style="q1" vid="PSA 78:58">他們的雕像惹他嫉憤。<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />神聽了就動怒，</para>
  <para style="q1" vid="PSA 78:59">極其厭棄<char style="pn">以色列</char>。<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />以致他撇棄<char style="pn">示羅</char>的居所，</para>
  <para style="q1" vid="PSA 78:60">就是他在人間安居的帳幕。<verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />他又把象徵他權能的約櫃<note caller="+" style="f"><char style="fr" closed="false">78:61 </char><char style="ft" closed="false">象徵他權能的約櫃——原文直譯「他的力量」。</char></note>給人擄去，</para>
  <para style="q1" vid="PSA 78:61">把他的榮耀交在敵人的手中，<verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />他把他的子民交給刀劍，</para>
  <para style="q1" vid="PSA 78:62">對他的繼業動怒。<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />少男被火吞噬，</para>
  <para style="q1" vid="PSA 78:63">少女沒有喜歌。<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />祭司倒在刀下，</para>
  <para style="q1" vid="PSA 78:64">寡婦卻不能哭泣。<verse eid="PSA 78:64" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />那時主像從沉睡中醒過來，</para>
  <para style="q1" vid="PSA 78:65">像勇士因酒而歡呼。<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />他擊退了他的敵人，</para>
  <para style="q1" vid="PSA 78:66">把永遠的羞辱加給他們。<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />他厭棄<char style="pn">約瑟</char>的帳篷，</para>
  <para style="q1" vid="PSA 78:67">沒有揀選<char style="pn">以法蓮</char>支派；<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />他卻揀選了<char style="pn">猶大</char>支派，</para>
  <para style="q1" vid="PSA 78:68">他所愛的<char style="pn">錫安</char>山。<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />他建造他的聖所如同高峰，</para>
  <para style="q1" vid="PSA 78:69">又像他永遠建立的大地。<verse eid="PSA 78:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />他揀選了自己的僕人<char style="pn">大衛</char>，</para>
  <para style="q1" vid="PSA 78:70">從羊圈中把他挑選出來，<verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />從所照顧的哺乳母羊當中把他帶出來，</para>
  <para style="q1" vid="PSA 78:71">為要牧養自己的子民<char style="pn">雅各</char>，</para>
  <para style="q1" vid="PSA 78:71">自己的繼業<char style="pn">以色列</char>。<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />於是<char style="pn">大衛</char><note caller="+" style="f"><char style="fr" closed="false">78:72 </char><char style="ft" closed="false">大衛——原文直譯「他」。</char></note>就以純全的心牧養他們，</para>
  <para style="q1" vid="PSA 78:72">以聰慧的手引導他們。<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s">求主解救子民</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />神哪，列國進入了你的繼業，</para>
  <para style="q1" vid="PSA 79:1">玷汙了你的聖殿，</para>
  <para style="q1" vid="PSA 79:1">使<char style="pn">耶路撒冷</char>變為荒堆！<verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />他們把你僕人的屍體</para>
  <para style="q1" vid="PSA 79:2">給了天空的飛鳥為食物，</para>
  <para style="q1" vid="PSA 79:2">把你忠信者的肉給了地上的走獸。<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />他們使<char style="pn">耶路撒冷</char>四圍血流成河，</para>
  <para style="q1" vid="PSA 79:3">屍體無人埋葬。<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />我們被鄰居羞辱，</para>
  <para style="q1" vid="PSA 79:4">被周圍人嘲笑和諷刺。<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />耶和華啊，這要到什麼時候呢？</para>
  <para style="q1" vid="PSA 79:5">你要永久發怒嗎？</para>
  <para style="q1" vid="PSA 79:5">你的妒愛要像火那樣燃燒嗎？<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />求你將你的怒火，</para>
  <para style="q1" vid="PSA 79:6">傾瀉在不認識你的列邦身上，</para>
  <para style="q1" vid="PSA 79:6">不呼求你名的列國身上；<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />因為他們吞噬了<char style="pn">雅各</char>，</para>
  <para style="q1" vid="PSA 79:7">使他的居所變得荒涼。<verse eid="PSA 79:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />求你不要記住我們先前<note caller="+" style="f"><char style="fr" closed="false">79:8 </char><char style="ft" closed="false">先前——或譯作「先祖」。</char></note>的罪孽，</para>
  <para style="q1" vid="PSA 79:8">願你的憐憫快快臨到我們，</para>
  <para style="q1" vid="PSA 79:8">因為我們變得極其衰微。<verse eid="PSA 79:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />拯救我們的神哪，</para>
  <para style="q1" vid="PSA 79:9">求你因你名的榮耀幫助我們，</para>
  <para style="q1" vid="PSA 79:9">為你名的緣故解救我們，</para>
  <para style="q1" vid="PSA 79:9">赦免<note caller="+" style="f"><char style="fr" closed="false">79:9 </char><char style="ft" closed="false">赦免——原文直譯「贖」。</char></note>我們的罪！<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />為什麼容列國說：</para>
  <para style="q1" vid="PSA 79:10">「他們的神在哪裡呢？」</para>
  <para style="q1" vid="PSA 79:10">願我們親眼看見，</para>
  <para style="q1" vid="PSA 79:10">在列國中人都知道：</para>
  <para style="q1" vid="PSA 79:10">你為被殺流血的僕人報仇。<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />願被囚者的呻吟達到你面前——</para>
  <para style="q1" vid="PSA 79:11">求你照著你膀臂的大能，</para>
  <para style="q1" vid="PSA 79:11">使那些註定要死的人存留。<verse eid="PSA 79:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />主啊，求你把我們鄰國對你的羞辱，</para>
  <para style="q1" vid="PSA 79:12">七倍歸回到他們身上！<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />這樣，我們這些子民，</para>
  <para style="q1" vid="PSA 79:13">你牧場上的群羊，</para>
  <para style="q1" vid="PSA 79:13">將稱謝你，直到永遠；</para>
  <para style="q1" vid="PSA 79:13">我們將世世代代述說你當受的讚美。<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s">求主復興子民</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的見證，一首詩，給樂隊指揮，用「百合花」曲調。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1" />
    <char style="pn">以色列</char>的牧者啊，</para>
  <para style="q1" vid="PSA 80:1">引領<char style="pn">約瑟</char>如同引領羊群的那一位啊，</para>
  <para style="q1" vid="PSA 80:1">求你傾聽！</para>
  <para style="q1" vid="PSA 80:1">坐在基路伯之上的那一位啊，</para>
  <para style="q1" vid="PSA 80:1">求你發出光芒！<verse eid="PSA 80:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2" />求你在<char style="pn">以法蓮</char>、<char style="pn">便雅憫</char>和<char style="pn">瑪拿西</char>面前</para>
  <para style="q1" vid="PSA 80:2">喚醒你的大能；</para>
  <para style="q1" vid="PSA 80:2">求你來臨，成為我們的救恩！<verse eid="PSA 80:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />神哪，求你使我們回轉；</para>
  <para style="q1" vid="PSA 80:3">使你的臉發出亮光，我們就得拯救！<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />萬軍之神耶和華啊，</para>
  <para style="q1" vid="PSA 80:4">你因你子民的禱告而發怒，</para>
  <para style="q1" vid="PSA 80:4">要到什麼時候呢？<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />你以眼淚當作糧食給他們吃，</para>
  <para style="q1" vid="PSA 80:5">又把大碗的眼淚給他們喝。<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />你使我們成為鄰國紛爭的對象，</para>
  <para style="q1" vid="PSA 80:6">我們的仇敵也都嘲笑我們。<verse eid="PSA 80:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />萬軍之神哪，求你使我們回轉；</para>
  <para style="q1" vid="PSA 80:7">使你的臉發出亮光，我們就得拯救！<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />你從<char style="pn">埃及</char>帶出一棵葡萄樹，</para>
  <para style="q1" vid="PSA 80:8">你驅逐列國，栽種了這樹。<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />你為它預備了地方<note caller="+" style="f"><char style="fr" closed="false">80:9 </char><char style="ft" closed="false">地方——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PSA 80:9">它就深深扎根，充滿大地。<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />它的影子遮蓋了群山，</para>
  <para style="q1" vid="PSA 80:10">它的枝條遮蓋了高大的香柏樹。<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />它伸出枝葉直到海洋，</para>
  <para style="q1" vid="PSA 80:11">它的嫩枝直到大河<note caller="+" style="f"><char style="fr" closed="false">80:11 </char><char style="ft" closed="false">大河——指幼發拉底河。</char></note>。<verse eid="PSA 80:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />你為什麼毀壞它的圍牆，</para>
  <para style="q1" vid="PSA 80:12">以致所有過路的人都去摘取呢？<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />來自森林的豬把它糟踏，</para>
  <para style="q1" vid="PSA 80:13">田野的動物把它吃掉。<verse eid="PSA 80:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />萬軍之神哪，求你轉回！</para>
  <para style="q1" vid="PSA 80:14">求你從天上垂看鑒察，眷顧這葡萄樹，<verse eid="PSA 80:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15" />就是你右手所栽種的幼苗，</para>
  <para style="q1" vid="PSA 80:15">你為自己所堅固的根苗。<verse eid="PSA 80:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />這葡萄樹在烈火中被燒了，被砍掉了，</para>
  <para style="q1" vid="PSA 80:16">因你臉上的怒容就要滅亡。<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />願你的手與你右邊的人同在，</para>
  <para style="q1" vid="PSA 80:17">就是你為自己所堅固的人子。<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />這樣我們就不致退縮離開你。</para>
  <para style="q1" vid="PSA 80:18">求你使我們活過來，我們就呼求你的名。<verse eid="PSA 80:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />萬軍之神耶和華啊，求你使我們回轉；</para>
  <para style="q1" vid="PSA 80:19">使你的臉發出亮光，我們就得拯救！<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s">聽從神的勸誡</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的詩，給樂隊指揮，用「搾酒」曲調<note caller="+" style="f"><char style="fr" closed="false">81:0 </char><char style="ft" closed="false">「榨酒」曲調——或譯作「迦特樂器」或「迦特曲調」。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />你們當向神——我們的力量歡唱，</para>
  <para style="q1" vid="PSA 81:1">向<char style="pn">雅各</char>的神歡呼！<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />當高唱頌歌，搖起鈴鼓，</para>
  <para style="q1" vid="PSA 81:2">彈奏美妙的豎琴與里拉琴！<verse eid="PSA 81:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />當在新月時、在滿月時，</para>
  <para style="q1" vid="PSA 81:3">在我們過節的日子吹響號角！<verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />因為這是給<char style="pn">以色列</char>的律例，</para>
  <para style="q1" vid="PSA 81:4">是<char style="pn">雅各</char>之神的法規。<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />神出去對付<char style="pn">埃及</char>地的時候，</para>
  <para style="q1" vid="PSA 81:5">在<char style="pn">約瑟</char>中設立了這法度。</para>
  <para style="q1" vid="PSA 81:5">我聽見了我不明白的話：<verse eid="PSA 81:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />「我除去他肩膀的重擔，</para>
  <para style="q1" vid="PSA 81:6">使他的手放下筐子。<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />你在患難中呼求，我搭救了你，</para>
  <para style="q1" vid="PSA 81:7">我在雷霆的隱祕處回應了你，</para>
  <para style="q1" vid="PSA 81:7">在<char style="pn">米利巴</char>的水邊試驗了你。<char style="qs">細拉</char><verse eid="PSA 81:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />我的子民哪，你當聽，我要警誡你！</para>
  <para style="q1" vid="PSA 81:8">
    <char style="pn">以色列</char>啊，但願你肯聽從我！<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />你們中間不可有外族的神明，</para>
  <para style="q1" vid="PSA 81:9">你不可向外邦的神明下拜。<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />我是耶和華你的神，</para>
  <para style="q1" vid="PSA 81:10">是把你從<char style="pn">埃及</char>地帶上來的那一位。</para>
  <para style="q1" vid="PSA 81:10">你要張大你的口，讓我填滿它。<verse eid="PSA 81:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />然而我的子民不聽我的聲音，</para>
  <para style="q1" vid="PSA 81:11">
    <char style="pn">以色列</char>不肯順從我。<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />我就任憑他們心裡頑固，</para>
  <para style="q1" vid="PSA 81:12">隨自己的計謀而行。<verse eid="PSA 81:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />但願我的子民肯聽從我，</para>
  <para style="q1" vid="PSA 81:13">
    <char style="pn">以色列</char>肯走我的道路，<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />我就片刻間制伏他們的仇敵，</para>
  <para style="q1" vid="PSA 81:14">轉手對付他們的敵人。」<verse eid="PSA 81:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />恨耶和華的人將向他卑躬屈膝，</para>
  <para style="q1" vid="PSA 81:15">願他們受罰的日子直到永遠。<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />但他必給<char style="pn">以色列</char><note caller="+" style="f"><char style="fr" closed="false">81:16 </char><char style="ft" closed="false">以色列——原文直譯「他」。</char></note>吃最好的麥子，並說：</para>
  <para style="q1" vid="PSA 81:16">「我要用磐石所出的蜂蜜使你飽足。」<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s">神是最高的審判者</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />在神<note caller="+" style="f"><char style="fr" closed="false">82:1 </char><char style="ft" closed="false">神——或譯作「諸神」或「大能者」。</char></note>的集會裡，</para>
  <para style="q1" vid="PSA 82:1">神站在眾神明當中施行審判：<verse eid="PSA 82:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />「你們施行不義的審判，</para>
  <para style="q1" vid="PSA 82:2">顧及惡人的情面，要到什麼時候呢？<char style="qs">細拉</char><verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />你們當為貧弱者和孤兒伸冤，</para>
  <para style="q1" vid="PSA 82:3">為困苦人和貧窮人施行公義；<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />當挽救貧弱者和貧窮人，</para>
  <para style="q1" vid="PSA 82:4">解救他們脫離惡人的手！<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />你們<note caller="+" style="f"><char style="fr" closed="false">82:5 </char><char style="ft" closed="false">你們——原文直譯「他們」。</char></note>不明白，也不領悟；</para>
  <para style="q1" vid="PSA 82:5">你們<note caller="+" style="f"><char style="fr" closed="false">82:5 </char><char style="ft" closed="false">你們——原文直譯「他們」。</char></note>在黑暗中往來行走；</para>
  <para style="q1" vid="PSA 82:5">大地的根基全都動搖了。<verse eid="PSA 82:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />我曾說：『你們是神，</para>
  <para style="q1" vid="PSA 82:6">都是至高者的兒子。』<verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />然而你們要死去，像世人一樣；</para>
  <para style="q1" vid="PSA 82:7">要仆倒，像任何一位首領。」<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />神哪，求你起來，審判大地，</para>
  <para style="q1" vid="PSA 82:8">因為你將擁有萬國！<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s">求神消滅四圍仇敵</para>
  <para style="b" />
  <para style="d">
    <char style="pn">亞薩</char>的詩，一首歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />神哪，求你不要靜息！</para>
  <para style="q1" vid="PSA 83:1">神哪，求你不要沉默，不要緘默！<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />看哪，你的仇敵喧囂，</para>
  <para style="q1" vid="PSA 83:2">恨你的人抬起了頭！<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />他們合夥密謀，對付你的子民；</para>
  <para style="q1" vid="PSA 83:3">他們彼此商議，對付你所珍愛的人。<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />他們說：「來吧！</para>
  <para style="q1" vid="PSA 83:4">讓我們將他們除滅，不再是一個國，</para>
  <para style="q1" vid="PSA 83:4">使<char style="pn">以色列</char>的名不再被人記念。」<verse eid="PSA 83:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />他們同心商議，</para>
  <para style="q1" vid="PSA 83:5">立約對付你。<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />他們是：<char style="pn">以東</char>帳篷裡的人和<char style="pn">以實瑪利</char>人，</para>
  <para style="q1" vid="PSA 83:6">
    <char style="pn">摩押</char>人和<char style="pn">哈格利</char>人；<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />
    <char style="pn">迦巴勒</char>、<char style="pn">亞捫</char>和<char style="pn">亞瑪力</char>人，</para>
  <para style="q1" vid="PSA 83:7">
    <char style="pn">非利士</char>與<char style="pn">提爾</char>的居民；<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />
    <char style="pn">亞述</char>也與他們聯合，</para>
  <para style="q1" vid="PSA 83:8">作<char style="pn">羅得</char>子孫的左膀右臂。<char style="qs">細拉</char><verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />求你對待他們，如同對待<char style="pn">米甸</char>，</para>
  <para style="q1" vid="PSA 83:9">如同在<char style="pn">基順</char>河畔對待<char style="pn">西西拉</char>和<char style="pn">耶賓</char>——<verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />他們在<char style="pn">恩多爾</char>被除滅，</para>
  <para style="q1" vid="PSA 83:10">成為那地上的糞土。<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />求你使他們的權貴如同<char style="pn">俄立</char>和<char style="pn">西伊伯</char>，</para>
  <para style="q1" vid="PSA 83:11">使他們所有的首領如同<char style="pn">西巴</char>和<char style="pn">撒慕拿</char>，<verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />因他們說：</para>
  <para style="q1" vid="PSA 83:12">「讓我們把神的牧場占為己有！」<verse eid="PSA 83:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />我的神哪，</para>
  <para style="q1" vid="PSA 83:13">求你使他們如同旋風中的塵土<note caller="+" style="f"><char style="fr" closed="false">83:13 </char><char style="ft" closed="false">旋風中的塵土——或譯作「風滾草」。</char></note>，</para>
  <para style="q1" vid="PSA 83:13">如同風前的麥稭！<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />火怎樣焚燒森林，</para>
  <para style="q1" vid="PSA 83:14">火焰怎樣燒盡群山，<verse eid="PSA 83:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15" />求你照樣用你的狂風追趕他們，</para>
  <para style="q1" vid="PSA 83:15">用你的旋風使他們惶恐。<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />耶和華啊，求你使他們滿面羞辱，</para>
  <para style="q1" vid="PSA 83:16">使他們因此尋求你的名！<verse eid="PSA 83:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />願他們抱愧惶恐，直到永遠；</para>
  <para style="q1" vid="PSA 83:17">願他們蒙羞滅亡。<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />願他們知道，唯獨你名為耶和華，</para>
  <para style="q1" vid="PSA 83:18">是全地之上的至高者。<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s">渴慕耶和華的殿宇</para>
  <para style="b" />
  <para style="d">
    <char style="pn">可拉</char>子孫的詩，給樂隊指揮，用「搾酒」曲調<note caller="+" style="f"><char style="fr" closed="false">84:0 </char><char style="ft" closed="false">「榨酒」曲調——或譯作「『迦特』樂器」或「『迦特』曲調」。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />萬軍之耶和華啊，</para>
  <para style="q1" vid="PSA 84:1">你的居所多麼令人愛慕！<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />我的靈魂切慕渴想耶和華的院宇；</para>
  <para style="q1" vid="PSA 84:2">我的心和我的肉體向永生的神歡呼。<verse eid="PSA 84:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />萬軍之耶和華，我的王、我的神哪！</para>
  <para style="q1" vid="PSA 84:3">在你的祭壇那裡，</para>
  <para style="q1" vid="PSA 84:3">連雀鳥也找到了家，</para>
  <para style="q1" vid="PSA 84:3">燕子為自己找到了安置幼雛的窩巢。<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />住在你殿中的是蒙福的！</para>
  <para style="q1" vid="PSA 84:4">他們要一直讚美你。<char style="qs">細拉</char><verse eid="PSA 84:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />那以你為力量、</para>
  <para style="q1" vid="PSA 84:5">心中嚮往<char style="pn">錫安</char><note caller="+" style="f"><char style="fr" closed="false">84:5 </char><char style="ft" closed="false">錫安——輔助詞語。</char></note>大道<note caller="+" style="f"><char style="fr" closed="false">84:5 </char><char style="ft" closed="false">心中嚮往錫安大道——或譯作「切望要往錫安山朝聖」。</char></note>的，是蒙福的！<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />他們經過<char style="pn">流淚谷</char><note caller="+" style="f"><char style="fr" closed="false">84:6 </char><char style="ft" closed="false">流淚谷——或譯作「巴克谷」或「桑林谷」。</char></note>，</para>
  <para style="q1" vid="PSA 84:6">使它變為泉源之地，</para>
  <para style="q1" vid="PSA 84:6">秋雨也給它披上祝福。<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />他們行走，力上加力，</para>
  <para style="q1" vid="PSA 84:7">各人到<char style="pn">錫安</char>朝見神。<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />萬軍之神耶和華啊，求你垂聽我的禱告！</para>
  <para style="q1" vid="PSA 84:8">
    <char style="pn">雅各</char>的神哪，求你傾聽！<char style="qs">細拉</char><verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />神哪，我們的盾牌，求你看顧；</para>
  <para style="q1" vid="PSA 84:9">求你垂看你受膏者的容面！<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />是的，在你的院宇中一日，</para>
  <para style="q1" vid="PSA 84:10">好過在別處<note caller="+" style="f"><char style="fr" closed="false">84:10 </char><char style="ft" closed="false">別處——輔助詞語。</char></note>千日；</para>
  <para style="q1" vid="PSA 84:10">我寧願在我神的殿中看門，</para>
  <para style="q1" vid="PSA 84:10">也不願住在惡人的帳篷裡；<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />因為耶和華神是太陽，是盾牌，</para>
  <para style="q1" vid="PSA 84:11">耶和華賜下恩惠和榮耀；</para>
  <para style="q1" vid="PSA 84:11">他為行事純全的人賜下福份，毫無保留。<verse eid="PSA 84:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />萬軍之耶和華啊，</para>
  <para style="q1" vid="PSA 84:12">那依靠你的人，是蒙福的！<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s">求神使子民回轉</para>
  <para style="b" />
  <para style="d">
    <char style="pn">可拉</char>子孫的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />耶和華啊，你喜悅你的大地，</para>
  <para style="q1" vid="PSA 85:1">使<char style="pn">雅各</char>的擄民回歸<note caller="+" style="f"><char style="fr" closed="false">85:1 </char><char style="ft" closed="false">使雅各的擄民回歸——或譯作「復興雅各的家業」。</char></note>！<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />你赦免了你子民的罪孽，</para>
  <para style="q1" vid="PSA 85:2">遮蓋了他們一切的罪。<char style="qs">細拉</char><verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />你收回了你一切的盛怒，</para>
  <para style="q1" vid="PSA 85:3">轉消了你猛烈的怒氣。<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />拯救我們的神哪，</para>
  <para style="q1" vid="PSA 85:4">求你使我們回轉，</para>
  <para style="q1" vid="PSA 85:4">求你收回對我們的惱怒！<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />難道你要對我們發怒到永遠嗎？</para>
  <para style="q1" vid="PSA 85:5">你要延續你的怒氣，直到萬代嗎？<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />難道你不願讓我們再次活過來，</para>
  <para style="q1" vid="PSA 85:6">好讓你的子民因你而歡喜嗎？<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />耶和華啊，</para>
  <para style="q1" vid="PSA 85:7">求你使我們看到你的慈愛，</para>
  <para style="q1" vid="PSA 85:7">把你的救恩賜給我們！<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />我要聽神耶和華所說的話，</para>
  <para style="q1" vid="PSA 85:8">因為他要向他的子民、</para>
  <para style="q1" vid="PSA 85:8">向他的忠信者宣告平安，</para>
  <para style="q1" vid="PSA 85:8">不讓他們轉回愚昧。<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />他的救恩必然在敬畏他的人身邊，</para>
  <para style="q1" vid="PSA 85:9">好使榮耀居留在我們的地上。<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />慈愛和信實彼此相遇，</para>
  <para style="q1" vid="PSA 85:10">公義和平安互相親吻。<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />信實從地上生出，</para>
  <para style="q1" vid="PSA 85:11">公義從天上俯看。<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />耶和華必賜下福份，</para>
  <para style="q1" vid="PSA 85:12">我們的土地必有出產。<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />公義在他前面行走，</para>
  <para style="q1" vid="PSA 85:13">為他的腳步預備道路。<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s">求神幫助安慰</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的禱告。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />耶和華啊，求你側耳聽、回應我，</para>
  <para style="q1" vid="PSA 86:1">因為我困苦貧窮！<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />求你保守我的靈魂，</para>
  <para style="q1" vid="PSA 86:2">因為我是忠信的人；</para>
  <para style="q1" vid="PSA 86:2">你是我的神，</para>
  <para style="q1" vid="PSA 86:2">求你拯救我這依靠你的僕人。<verse eid="PSA 86:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />主啊，求你恩待我，</para>
  <para style="q1" vid="PSA 86:3">因為我終日向你呼求！<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />主啊，求你使你僕人的靈魂歡喜，</para>
  <para style="q1" vid="PSA 86:4">因為我的靈魂仰望你！<verse eid="PSA 86:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />主啊，你是美善的，赦免人的；</para>
  <para style="q1" vid="PSA 86:5">對所有呼求你的人，</para>
  <para style="q1" vid="PSA 86:5">你有豐盛的慈愛！<verse eid="PSA 86:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />耶和華啊，求你傾聽我的禱告，</para>
  <para style="q1" vid="PSA 86:6">留心聽我懇求的聲音！<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />在我患難的日子裡，我呼求你，</para>
  <para style="q1" vid="PSA 86:7">因為你必回應我。<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />主啊，神明中沒有能與你相比的，</para>
  <para style="q1" vid="PSA 86:8">你的作為無與倫比！<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />主啊，你所造的萬國都要來，</para>
  <para style="q1" vid="PSA 86:9">在你面前下拜，</para>
  <para style="q1" vid="PSA 86:9">他們必榮耀你的名。<verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />因為你真偉大，行奇妙的事，</para>
  <para style="q1" vid="PSA 86:10">唯獨你是神！<verse eid="PSA 86:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />耶和華啊，</para>
  <para style="q1" vid="PSA 86:11">求你把你的道路指示給我，</para>
  <para style="q1" vid="PSA 86:11">我要行走在你的真理中！</para>
  <para style="q1" vid="PSA 86:11">求你使我一心敬畏你的名。<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />我的主我的神哪，</para>
  <para style="q1" vid="PSA 86:12">我要全心稱謝你；</para>
  <para style="q1" vid="PSA 86:12">我要榮耀你的名，直到永遠！<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />因為你對我的慈愛浩大，</para>
  <para style="q1" vid="PSA 86:13">你解救我的靈魂脫離極深的陰間。<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />神哪，傲慢的人起來攻擊我，</para>
  <para style="q1" vid="PSA 86:14">一夥強橫的人尋索我的性命，</para>
  <para style="q1" vid="PSA 86:14">他們不把你放在眼裡！<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />但主啊，</para>
  <para style="q1" vid="PSA 86:15">你是有憐憫、有恩惠的神！</para>
  <para style="q1" vid="PSA 86:15">你不輕易發怒，</para>
  <para style="q1" vid="PSA 86:15">並有豐盛的慈愛和信實。<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />求你轉向我、恩待我；</para>
  <para style="q1" vid="PSA 86:16">求你把你的力量賜給你的僕人，</para>
  <para style="q1" vid="PSA 86:16">拯救你女僕的兒子。<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />求你向我顯出恩寵的標記，</para>
  <para style="q1" vid="PSA 86:17">願恨我的人看見就蒙羞；</para>
  <para style="q1" vid="PSA 86:17">因為你耶和華幫助我、安慰我。<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s">錫安是萬民的城</para>
  <para style="b" />
  <para style="d">
    <char style="pn">可拉</char>子孫的詩，一首歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />耶和華所立的根基在聖山上；<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />耶和華愛<char style="pn">錫安</char>的城門，</para>
  <para style="q1" vid="PSA 87:2">勝過<char style="pn">雅各</char>所有的住處。<verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />神的城啊，</para>
  <para style="q1" vid="PSA 87:3">有許多榮耀的事是指著你說的！<char style="qs">細拉</char><verse eid="PSA 87:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />「在認識我的人中，</para>
  <para style="q1" vid="PSA 87:4">我要提起<char style="pn">拉哈伯</char><note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="ft" closed="false">拉哈伯——指埃及。</char></note>和<char style="pn">巴比倫</char>；</para>
  <para style="q1" vid="PSA 87:4">看哪，還有<char style="pn">非利士</char>、<char style="pn">提爾</char>與<char style="pn">庫實</char>，</para>
  <para style="q1" vid="PSA 87:4">我說：『這一個出生在那裡！』」<verse eid="PSA 87:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />論到<char style="pn">錫安</char>，必有話說：</para>
  <para style="q1" vid="PSA 87:5">「這一個、那一個都出生在其中。」</para>
  <para style="q1" vid="PSA 87:5">至高者必親自堅立這城。<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />在耶和華登記萬民的時候，</para>
  <para style="q1" vid="PSA 87:6">他將要數點：</para>
  <para style="q1" vid="PSA 87:6">「這一個出生在那裡。」<char style="qs">細拉</char><verse eid="PSA 87:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />歌唱的和跳舞的都說：</para>
  <para style="q1" vid="PSA 87:7">「我一切的泉源都在你<note caller="+" style="f"><char style="fr" closed="false">87:7 </char><char style="ft" closed="false">你——指錫安。</char></note>裡面。」<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s">絕望中的呼求</para>
  <para style="b" />
  <para style="d">
    <char style="pn">可拉</char>子孫的詩，一首歌，就是<char style="pn">以斯拉</char>人<char style="pn">希幔</char>的智慧詩，給樂隊指揮，用「麻哈拉利暗俄」曲調。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />耶和華，拯救我的神哪，</para>
  <para style="q1" vid="PSA 88:1">我晝夜在你面前呼求！<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />願我的禱告達到你面前，</para>
  <para style="q1" vid="PSA 88:2">求你側耳聽我的呼聲；<verse eid="PSA 88:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />因為我的生命充滿患難，</para>
  <para style="q1" vid="PSA 88:3">我的性命臨近陰間，<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />我被列在下陰坑的人中，</para>
  <para style="q1" vid="PSA 88:4">如同無力的人；<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />我被丟棄在死人中，</para>
  <para style="q1" vid="PSA 88:5">如同躺在墳墓裡被殺的人，</para>
  <para style="q1" vid="PSA 88:5">不再被你記念，</para>
  <para style="q1" vid="PSA 88:5">與你手的眷顧隔絕了。<verse eid="PSA 88:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />你把我放在最深的陰坑裡，</para>
  <para style="q1" vid="PSA 88:6">在黑暗之地，在幽深之處；<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />你的怒火壓在我身上，</para>
  <para style="q1" vid="PSA 88:7">你用你一切的波浪苦待我。<char style="qs">細拉</char><verse eid="PSA 88:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />你使認識我的人遠離我，</para>
  <para style="q1" vid="PSA 88:8">使我成為他們所憎惡的；</para>
  <para style="q1" vid="PSA 88:8">我被囚禁，不能出來。<verse eid="PSA 88:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9" />我的眼睛因苦難而衰竭；</para>
  <para style="q1" vid="PSA 88:9">耶和華啊，我每天呼求你，</para>
  <para style="q1" vid="PSA 88:9">向你展開雙手！<verse eid="PSA 88:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />難道你要為死人行奇妙的事嗎？</para>
  <para style="q1" vid="PSA 88:10">難道陰魂會起來稱謝你嗎？<char style="qs">細拉</char><verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />難道有人會在墳墓裡述說你的慈愛，</para>
  <para style="q1" vid="PSA 88:11">在地獄裡述說你的信實嗎？<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />難道你的奇妙之事要顯明在黑暗中，</para>
  <para style="q1" vid="PSA 88:12">你的公義要顯明在被遺忘之地嗎？<verse eid="PSA 88:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />耶和華啊，至於我，我向你呼救！</para>
  <para style="q1" vid="PSA 88:13">我的禱告在清晨達到你面前。<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />耶和華啊，你為什麼拋棄我的靈魂，</para>
  <para style="q1" vid="PSA 88:14">向我隱藏你的臉呢？<verse eid="PSA 88:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />我自幼困苦，幾乎斷氣；</para>
  <para style="q1" vid="PSA 88:15">承受你的威嚇，陷入絕望。<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />你的烈怒漫過我，</para>
  <para style="q1" vid="PSA 88:16">你的威嚇毀滅我。<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />它們如水終日圍繞我，</para>
  <para style="q1" vid="PSA 88:17">一同包圍我。<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />你使我所愛的人和朋友遠離我，</para>
  <para style="q1" vid="PSA 88:18">我的同伴只有黑暗。<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s">神以信實立約</para>
  <para style="b" />
  <para style="d">
    <char style="pn">以斯拉</char>人<char style="pn">伊坦</char>的智慧詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />我要永遠歌唱耶和華的慈愛，</para>
  <para style="q1" vid="PSA 89:1">我要用口傳揚你的信實，直到萬代；<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />我說：「你的慈愛必建立到永遠；</para>
  <para style="q1" vid="PSA 89:2">你必在天上堅立你的信實。」<verse eid="PSA 89:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />你曾說：「我與我所揀選的人立了約，</para>
  <para style="q1" vid="PSA 89:3">我向我的僕人<char style="pn">大衛</char>起了誓：<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />我要使你的後裔堅立，直到永遠；</para>
  <para style="q1" vid="PSA 89:4">我要建立你的寶座，直到萬代。」<char style="qs">細拉</char><verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />耶和華啊，諸天要稱頌你奇妙的事；</para>
  <para style="q1" vid="PSA 89:5">在聖者的會眾裡，也要稱頌你的信實！<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />在那雲霄之上，有誰能與耶和華相比呢？</para>
  <para style="q1" vid="PSA 89:6">在神的眾子<note caller="+" style="f"><char style="fr" closed="false">89:6 </char><char style="ft" closed="false">神的眾子——或譯作「神的眾天使」或「諸神」。</char></note>中，有誰能像耶和華呢？<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />在聖者的會中，他是大受敬畏的神；</para>
  <para style="q1" vid="PSA 89:7">他比他四圍的一切都更可畏<note caller="+" style="f"><char style="fr" closed="false">89:7 </char><char style="ft" closed="false">大受敬畏的神；他比他四圍的一切都更可畏——七十士譯本作「可畏的神；他偉大可畏，超越一切在他四圍的」。</char></note>。<verse eid="PSA 89:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />萬軍之神耶和華啊，誰像你那樣大能呢？</para>
  <para style="q1" vid="PSA 89:8">耶和華啊<note caller="+" style="f"><char style="fr" closed="false">89:8 </char><char style="ft" closed="false">誰像你那樣大能呢？耶和華啊——七十士譯本作「有誰像你？耶和華啊！你是大能的」。</char></note>，你的信實在你四圍！<verse eid="PSA 89:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />是你管轄海洋的狂濤；</para>
  <para style="q1" vid="PSA 89:9">波浪翻騰時，是你平息它們。<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />是你壓碎<char style="pn">拉哈伯</char>，使它如同被刺透的人；</para>
  <para style="q1" vid="PSA 89:10">你用大力的膀臂打散你的仇敵。<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />諸天屬於你，大地也屬於你；</para>
  <para style="q1" vid="PSA 89:11">世界和其中所充滿的，都是你奠定的。<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />北和南，都是你創造的，</para>
  <para style="q1" vid="PSA 89:12">
    <char style="pn">他泊</char>和<char style="pn">黑門</char>奉你的名歡呼。<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />你有大能的膀臂，</para>
  <para style="q1" vid="PSA 89:13">你的手有能力，你的右手高舉。<verse eid="PSA 89:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />公義和公正是你寶座的根基，</para>
  <para style="q1" vid="PSA 89:14">慈愛和信實行在你面前。<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />懂得向你歡呼的，那民是蒙福的！</para>
  <para style="q1" vid="PSA 89:15">耶和華啊，他們在你容光中行走！<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />他們因你的名終日快樂，</para>
  <para style="q1" vid="PSA 89:16">藉著你的公義被高舉；<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />因為你是他們能力的榮耀。</para>
  <para style="q1" vid="PSA 89:17">因你的恩典，我們的角被高舉；<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />因為我們的盾牌屬於耶和華，</para>
  <para style="q1" vid="PSA 89:18">我們的王屬於<char style="pn">以色列</char>的聖者。<verse eid="PSA 89:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />那時你在異象中對你的忠信者宣告，</para>
  <para style="q1" vid="PSA 89:19">說：「我幫助了一位勇士，</para>
  <para style="q1" vid="PSA 89:19">高舉了那從民中所揀選的。<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />我找到我的僕人<char style="pn">大衛</char>，</para>
  <para style="q1" vid="PSA 89:20">用我神聖的膏油膏抹了他。<verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />我的手必堅定地與他同在，</para>
  <para style="q1" vid="PSA 89:21">我的膀臂也必使他穩固。<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />仇敵不能毀滅他，</para>
  <para style="q1" vid="PSA 89:22">不義之子也不能苦待他。<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />我要在他面前打碎他的敵人，</para>
  <para style="q1" vid="PSA 89:23">我要擊倒那些恨他的人。<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />我的信實和我的慈愛要與他同在；</para>
  <para style="q1" vid="PSA 89:24">奉我的名，他的角必被高舉。<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />我要把他的左<note caller="+" style="f"><char style="fr" closed="false">89:25 </char><char style="ft" closed="false">左——輔助詞語。</char></note>手放到海洋上，</para>
  <para style="q1" vid="PSA 89:25">把他的右手放到河流中。<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />他將呼求我：</para>
  <para style="q1" vid="PSA 89:26">『你是我的父、我的神，</para>
  <para style="q1" vid="PSA 89:26">是我救恩的磐石。』<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />我還要立他作長子，</para>
  <para style="q1" vid="PSA 89:27">作地上君王中的至高者。<verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />我要向他持守我的慈愛，直到永遠；</para>
  <para style="q1" vid="PSA 89:28">我與他所立的約也必堅定。<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />我要堅立他的後裔，直到永遠；</para>
  <para style="q1" vid="PSA 89:29">使他的寶座如天之久。<verse eid="PSA 89:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />如果他的子孫離棄我的律法，</para>
  <para style="q1" vid="PSA 89:30">不照著我的法規而行；<verse eid="PSA 89:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31" />如果他們褻瀆我的律例，</para>
  <para style="q1" vid="PSA 89:31">不遵守我的誡命；<verse eid="PSA 89:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32" />我就要用杖懲罰他們的過犯，</para>
  <para style="q1" vid="PSA 89:32">用鞭懲罰他們的罪孽。<verse eid="PSA 89:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />然而，我不會從他身上收回我的慈愛，</para>
  <para style="q1" vid="PSA 89:33">也不會背棄我的信實。<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />我不會違背我的約，</para>
  <para style="q1" vid="PSA 89:34">也不會改變我口中說出的話。<verse eid="PSA 89:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />我曾指著我的神聖起過一次誓，</para>
  <para style="q1" vid="PSA 89:35">我絕不對<char style="pn">大衛</char>說謊。<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />他的後裔將長存，直到永遠；</para>
  <para style="q1" vid="PSA 89:36">他的寶座在我面前如同太陽，<verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />又如月亮永遠確立，</para>
  <para style="q1" vid="PSA 89:37">像是天上確實的見證。」<char style="qs">細拉</char><verse eid="PSA 89:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />但如今，你對你的受膏者動了怒，</para>
  <para style="q1" vid="PSA 89:38">你拋棄並厭棄了他。<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />你廢棄了與你僕人所立的約，</para>
  <para style="q1" vid="PSA 89:39">把他的冠冕踐踏在地。<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />你毀掉了他所有的圍牆，</para>
  <para style="q1" vid="PSA 89:40">使他的堡壘成為廢墟。<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />所有過路的人都搶掠他，</para>
  <para style="q1" vid="PSA 89:41">他被自己的鄰居羞辱。<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />你使他敵人的右手高舉，</para>
  <para style="q1" vid="PSA 89:42">使他一切的仇敵歡喜。<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />你也使他的刀劍捲刃，</para>
  <para style="q1" vid="PSA 89:43">使他在戰爭中站立不住。<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />你使他的光輝止息，</para>
  <para style="q1" vid="PSA 89:44">把他的寶座拋在地上。<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />你縮短了他青春的日子，</para>
  <para style="q1" vid="PSA 89:45">使他蒙受羞恥。<char style="qs">細拉</char><verse eid="PSA 89:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />耶和華啊，這要到什麼時候呢？</para>
  <para style="q1" vid="PSA 89:46">你要永久隱藏自己嗎？</para>
  <para style="q1" vid="PSA 89:46">你的憤怒要像烈火那樣繼續燃燒嗎？<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />求你記念我的一生是多麼短暫，</para>
  <para style="q1" vid="PSA 89:47">你創造的所有世人是多麼虛妄！<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />誰能長生不死呢？</para>
  <para style="q1" vid="PSA 89:48">誰能救自己的靈魂脫離陰間的權勢呢？<char style="qs">細拉</char><verse eid="PSA 89:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />主啊，你先前以你的信實</para>
  <para style="q1" vid="PSA 89:49">向<char style="pn">大衛</char>起誓要施行的慈愛，</para>
  <para style="q1" vid="PSA 89:49">如今在哪裡呢？<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />主啊，求你記住你僕人們所受的辱罵，</para>
  <para style="q1" vid="PSA 89:50">記住我如何在懷中承受萬民的辱罵！<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />耶和華啊，</para>
  <para style="q1" vid="PSA 89:51">你的仇敵就是這樣羞辱了我，</para>
  <para style="q1" vid="PSA 89:51">這樣羞辱了你受膏者的腳蹤！<verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />耶和華是當受頌讚的，直到永遠！</para>
  <para style="q1" vid="PSA 89:52">阿們，阿們！<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">第四卷</para>
  <para style="mr">（<ref loc="PSA 90-106">詩篇90-106</ref>）</para>
  <para style="b" />
  <para style="s">飛逝的人生</para>
  <para style="b" />
  <para style="d">神人<char style="pn">摩西</char>的禱告。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />主啊，</para>
  <para style="q1" vid="PSA 90:1">你世世代代是我們的居所！<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />群山生出之前，</para>
  <para style="q1" vid="PSA 90:2">你造出大地和世界之前，</para>
  <para style="q1" vid="PSA 90:2">從永遠到永遠<note caller="+" style="f"><char style="fr" closed="false">90:2 </char><char style="ft" closed="false">永遠到永遠——或譯作「亙古到永遠」。</char></note>，你是神。<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />你使人歸回塵土，說：</para>
  <para style="q1" vid="PSA 90:3">「世人哪，你們要歸回！」<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />在你的眼中，</para>
  <para style="q1" vid="PSA 90:4">千年如已過的昨日，</para>
  <para style="q1" vid="PSA 90:4">又如夜間的一更。<verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />你把他們如水沖去，他們就沉睡；</para>
  <para style="q1" vid="PSA 90:5">他們如同早晨生長的草——<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />早晨發芽生長，</para>
  <para style="q1" vid="PSA 90:6">晚上凋敝枯乾。<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />是的，我們因你的怒氣而滅亡，</para>
  <para style="q1" vid="PSA 90:7">因你的怒火而惶恐。<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />你把我們的罪孽擺在你面前，</para>
  <para style="q1" vid="PSA 90:8">把我們隱藏的事擺在你的容光之中。<verse eid="PSA 90:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />我們一生的日子都在你的盛怒中消逝，</para>
  <para style="q1" vid="PSA 90:9">我們度盡的歲月如同一聲嘆息。<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />我們一生的日子，是七十歲，</para>
  <para style="q1" vid="PSA 90:10">如果強壯，可到八十歲；</para>
  <para style="q1" vid="PSA 90:10">但其中可誇耀<note caller="+" style="f"><char style="fr" closed="false">90:10 </char><char style="ft" closed="false">可誇耀——或譯作「最好」。</char></note>的，不過是勞苦愁煩，</para>
  <para style="q1" vid="PSA 90:10">轉瞬即逝，我們就如飛而去。<verse eid="PSA 90:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />誰明白你怒氣的威力呢？</para>
  <para style="q1" vid="PSA 90:11">誰按著你該受的敬畏，明白你的盛怒呢？<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />求你教導我們怎樣數算自己的日子，</para>
  <para style="q1" vid="PSA 90:12">好讓我們得著智慧的心。<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />耶和華啊，這要等到什麼時候呢？</para>
  <para style="q1" vid="PSA 90:13">求你轉回，憐憫你的僕人們！<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />求你使我們清晨就飽嘗你的慈愛，</para>
  <para style="q1" vid="PSA 90:14">好讓我們在一生的日子裡歡呼喜樂。<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />求你照著你苦待我們的日子，照著我們遭害的歲月，</para>
  <para style="q1" vid="PSA 90:15">使我們長久歡喜。<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />願你的作為向你的僕人們顯現，</para>
  <para style="q1" vid="PSA 90:16">願你的威嚴向他們的子孫顯現。<verse eid="PSA 90:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />願主我們神的恩慈臨到我們；</para>
  <para style="q1" vid="PSA 90:17">願你為我們堅立我們手所做的；</para>
  <para style="q1" vid="PSA 90:17">我們手所做的，願你堅立！<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s">至高者是避難所</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1" />住在至高者隱祕處的，</para>
  <para style="q1" vid="PSA 91:1">將安居在全能者的蔭庇下。<verse eid="PSA 91:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />我要對耶和華說：</para>
  <para style="q1" vid="PSA 91:2">「我的避難所、我的要塞、我的神，</para>
  <para style="q1" vid="PSA 91:2">我依靠你<note caller="+" style="f"><char style="fr" closed="false">91:2 </char><char style="ft" closed="false">你——原文直譯「他」。</char></note>！」<verse eid="PSA 91:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />是的，他必解救你脫離捕鳥人的網羅，</para>
  <para style="q1" vid="PSA 91:3">脫離致命的瘟疫；<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />他必用自己的羽翼遮蔽你，</para>
  <para style="q1" vid="PSA 91:4">你要投靠在他的翅膀底下；</para>
  <para style="q1" vid="PSA 91:4">他的信實是盾牌和壁壘。<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />你必不怕夜間的恐怖，</para>
  <para style="q1" vid="PSA 91:5">或是白天飛來的箭；<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />也不怕幽暗中流行的瘟疫，</para>
  <para style="q1" vid="PSA 91:6">或是正午毀滅人的病毒。<verse eid="PSA 91:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />即使千人仆倒在你旁邊，</para>
  <para style="q1" vid="PSA 91:7">萬人仆倒在你右邊，</para>
  <para style="q1" vid="PSA 91:7">災禍<note caller="+" style="f"><char style="fr" closed="false">91:7 </char><char style="ft" closed="false">災禍——原文直譯「它」。</char></note>也不會接近你。<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />你只要用眼觀看，</para>
  <para style="q1" vid="PSA 91:8">就會看到惡人的報應。<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />因為你把耶和華</para>
  <para style="q1" vid="PSA 91:9">——至高者、我的避難所——</para>
  <para style="q1" vid="PSA 91:9">當作你的居所，<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />惡事必不會發生在你身上，</para>
  <para style="q1" vid="PSA 91:10">疾患也不會靠近你的帳篷；<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />因為他會為你吩咐他的使者們，</para>
  <para style="q1" vid="PSA 91:11">在你一切的道路上保守你；<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />他們會用手把你舉起來，</para>
  <para style="q1" vid="PSA 91:12">免得你的腳撞到石頭上；<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />你會踏在猛獅和毒蛇身上，</para>
  <para style="q1" vid="PSA 91:13">踩踏少壯獅子和大蛇。<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />「因為他愛慕我，我就挽救他；</para>
  <para style="q1" vid="PSA 91:14">因為他認識我的名，我就高舉他。<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />他呼求我，我就回應他；</para>
  <para style="q1" vid="PSA 91:15">他在患難中，我就與他同在；</para>
  <para style="q1" vid="PSA 91:15">我要搭救他，使他得尊榮。<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />我要使他得享長壽，</para>
  <para style="q1" vid="PSA 91:16">使他看到我的救恩。」<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s">稱頌神的慈愛信實</para>
  <para style="b" />
  <para style="d">一首詩，安息日的歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />稱謝耶和華、</para>
  <para style="q1" vid="PSA 92:1">歌頌至高者你的名，</para>
  <para style="q1" vid="PSA 92:1">是多麼美好——<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />在早晨宣告你的慈愛、</para>
  <para style="q1" vid="PSA 92:2">在夜間宣告你的信實，<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />用十弦琴、里拉琴、</para>
  <para style="q1" vid="PSA 92:3">豎琴的旋律！<verse eid="PSA 92:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />耶和華啊，</para>
  <para style="q1" vid="PSA 92:4">是你藉著你的作為使我歡喜，</para>
  <para style="q1" vid="PSA 92:4">我要因你手所做的而歡呼！<verse eid="PSA 92:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />耶和華啊，</para>
  <para style="q1" vid="PSA 92:5">你的作為多麼偉大，</para>
  <para style="q1" vid="PSA 92:5">你的意念極其深奧！<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />愚拙人不明白，</para>
  <para style="q1" vid="PSA 92:6">愚昧人不領悟：<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />儘管惡人如牧草興盛，</para>
  <para style="q1" vid="PSA 92:7">作惡的人全都興旺，</para>
  <para style="q1" vid="PSA 92:7">他們也要被永遠除滅。<verse eid="PSA 92:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />耶和華啊，</para>
  <para style="q1" vid="PSA 92:8">唯有你是至高的，直到永遠！<verse eid="PSA 92:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />耶和華啊，</para>
  <para style="q1" vid="PSA 92:9">看哪，你的仇敵！</para>
  <para style="q1" vid="PSA 92:9">看哪，你的仇敵必要滅亡，</para>
  <para style="q1" vid="PSA 92:9">作惡的人都要被打散！<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />你高舉了我的角，</para>
  <para style="q1" vid="PSA 92:10">使它如同野牛的角；</para>
  <para style="q1" vid="PSA 92:10">你用新油膏抹了我。<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />我親眼看到我的仇敵滅亡<note caller="+" style="f"><char style="fr" closed="false">92:11 </char><char style="ft" closed="false">滅亡——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PSA 92:11">親耳聽到起來攻擊我的惡人遭報<note caller="+" style="f"><char style="fr" closed="false">92:11 </char><char style="ft" closed="false">遭報——輔助詞語。</char></note>。<verse eid="PSA 92:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />義人將興盛如棕櫚樹，</para>
  <para style="q1" vid="PSA 92:12">興旺如<char style="pn">黎巴嫩</char>的香柏樹。<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />他們被栽種在耶和華的殿中，</para>
  <para style="q1" vid="PSA 92:13">在我們神的院宇中興盛。<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />他們在年老時仍然結果實，</para>
  <para style="q1" vid="PSA 92:14">他們豐美並且青翠，<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />以此宣告耶和華是正直的；</para>
  <para style="q1" vid="PSA 92:15">他是我的磐石，在他沒有不義。<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s">耶和華作王</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />耶和華作王，他以威嚴為衣；</para>
  <para style="q1" vid="PSA 93:1">耶和華以威嚴為衣，以力量束腰；</para>
  <para style="q1" vid="PSA 93:1">世界就被確立，不致動搖！<verse eid="PSA 93:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />你的寶座從太初就堅立，</para>
  <para style="q1" vid="PSA 93:2">你從亙古就存在！<verse eid="PSA 93:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />耶和華啊，洪流揚起——</para>
  <para style="q1" vid="PSA 93:3">洪流揚起它們的聲音，</para>
  <para style="q1" vid="PSA 93:3">洪流揚起它們的濤聲！<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />耶和華在至高處大有能力，</para>
  <para style="q1" vid="PSA 93:4">勝過大水的聲音，</para>
  <para style="q1" vid="PSA 93:4">勝過海洋巨大的波浪！<verse eid="PSA 93:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />耶和華啊，你所賜的法度極其信實；</para>
  <para style="q1" vid="PSA 93:5">你的殿配得神聖，直到永遠！<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s">公義的審判者</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />耶和華啊，你是報仇的神！</para>
  <para style="q1" vid="PSA 94:1">報仇的神哪，求你發出光芒！<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />大地的審判者啊，求你挺起身來，</para>
  <para style="q1" vid="PSA 94:2">使傲慢者受應得的報應！<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />耶和華啊，惡人要到什麼時候——</para>
  <para style="q1" vid="PSA 94:3">惡人歡躍要到什麼時候呢？<verse eid="PSA 94:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />他們不斷地吐出傲慢的話，</para>
  <para style="q1" vid="PSA 94:4">所有作惡的人都自我誇耀。<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />耶和華啊，</para>
  <para style="q1" vid="PSA 94:5">他們壓碎你的子民，</para>
  <para style="q1" vid="PSA 94:5">苦待你的繼業；<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />他們殺死寡婦和寄居者，</para>
  <para style="q1" vid="PSA 94:6">又殺害孤兒！<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />他們說：</para>
  <para style="q1" vid="PSA 94:7">「耶和華不會看，</para>
  <para style="q1" vid="PSA 94:7">
    <char style="pn">雅各</char>的神並不關心。」<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />民中的愚拙人哪，你們要有悟性！</para>
  <para style="q1" vid="PSA 94:8">愚昧人哪，你們什麼時候才有智慧呢？<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />那造耳朵的，難道不垂聽嗎？</para>
  <para style="q1" vid="PSA 94:9">那造眼睛的，難道不觀看嗎？<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />那管教列國、教導人知識的，</para>
  <para style="q1" vid="PSA 94:10">難道不責備嗎？<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />耶和華知道人的意念是虛空的。<verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />耶和華啊，</para>
  <para style="q1" vid="PSA 94:12">你所管教、用律法教導的人是蒙福的。<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />你使他在禍患的日子裡平穩，</para>
  <para style="q1" vid="PSA 94:13">直到給惡人挖好了深坑；<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />因為耶和華不撇棄他的子民，</para>
  <para style="q1" vid="PSA 94:14">不離棄他的繼業；<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />因為審判將重回公義，</para>
  <para style="q1" vid="PSA 94:15">所有心裡正直的都必跟隨公義。<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />誰為我起來反對作惡者呢？</para>
  <para style="q1" vid="PSA 94:16">誰為我站出來反對作惡的人呢？<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />要不是耶和華幫助我，</para>
  <para style="q1" vid="PSA 94:17">我的靈魂早就歸入寂靜之地了。<verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />如果我說：「我的腳動搖了」，</para>
  <para style="q1" vid="PSA 94:18">耶和華啊，你的慈愛就扶持我！<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />當我心裡思慮眾多時，</para>
  <para style="q1" vid="PSA 94:19">你的安慰就使我的靈魂歡喜。<verse eid="PSA 94:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />那些坐在奸惡王位上的，</para>
  <para style="q1" vid="PSA 94:20">就是藉著律例製造禍患的，</para>
  <para style="q1" vid="PSA 94:20">難道能成為你的盟友嗎？<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />他們互相勾結攻擊義人，</para>
  <para style="q1" vid="PSA 94:21">把無辜人定了死罪。<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />但耶和華是我的庇護所，</para>
  <para style="q1" vid="PSA 94:22">我的神是我避難的磐石。<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />他使他們的罪孽回到他們身上，</para>
  <para style="q1" vid="PSA 94:23">又因他們的罪惡除盡他們；</para>
  <para style="q1" vid="PSA 94:23">我們的神耶和華必除盡他們！<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s">頌讚創造主</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />來吧！讓我們向耶和華歡唱，</para>
  <para style="q1" vid="PSA 95:1">向我們救恩的磐石歡呼！<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />讓我們以感謝來到他面前，</para>
  <para style="q1" vid="PSA 95:2">用頌歌向他歡呼；<verse eid="PSA 95:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />因為耶和華是偉大的神，</para>
  <para style="q1" vid="PSA 95:3">是超越一切神明的偉大君王。<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />大地的深處在他的手中，</para>
  <para style="q1" vid="PSA 95:4">群山的高峰也屬於他；<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />海洋屬於他，是他造的；</para>
  <para style="q1" vid="PSA 95:5">陸地是他親手形成的。<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />來吧！讓我們俯伏敬拜，</para>
  <para style="q1" vid="PSA 95:6">在造我們的耶和華面前屈膝！<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />因為他是我們的神，</para>
  <para style="q1" vid="PSA 95:7">我們是他牧場的子民，</para>
  <para style="q1" vid="PSA 95:7">是他手下的羊群。</para>
  <para style="q1" vid="PSA 95:7">但願你們今日聽他的聲音：<verse eid="PSA 95:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />「你們不可硬著心，</para>
  <para style="q1" vid="PSA 95:8">像在<char style="pn">米利巴</char>，</para>
  <para style="q1" vid="PSA 95:8">在曠野中<char style="pn">瑪撒</char>的日子一樣；<verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />在那裡，</para>
  <para style="q1" vid="PSA 95:9">你們的祖先儘管看見了我的作為，</para>
  <para style="q1" vid="PSA 95:9">還是試探我、試驗我。<verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />四十年之久，我厭惡了那世代，</para>
  <para style="q1" vid="PSA 95:10">我說：『他們是心裡迷失的子民，</para>
  <para style="q1" vid="PSA 95:10">他們不認識我的道路。』<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />因此我在怒氣中起誓：</para>
  <para style="q1" vid="PSA 95:11">『他們絕不能進入我的安息。』」<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s">敬拜至高的王</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />你們當向耶和華唱新歌，</para>
  <para style="q1" vid="PSA 96:1">全地啊，你們當向耶和華歌唱！<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />你們當向耶和華歌唱，頌讚他的名，</para>
  <para style="q1" vid="PSA 96:2">日復一日地傳揚他的救恩。<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />當在列國中講述他的榮耀，</para>
  <para style="q1" vid="PSA 96:3">在萬民中講述他的奇妙作為；<verse eid="PSA 96:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />因耶和華偉大，當受極大的讚美；</para>
  <para style="q1" vid="PSA 96:4">他超越一切神明，當受敬畏；<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />萬民的一切神明都是虛無的偶像，</para>
  <para style="q1" vid="PSA 96:5">但耶和華造了諸天。<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />尊榮和威嚴在他的面前，</para>
  <para style="q1" vid="PSA 96:6">力量和榮美在他的聖所。<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />萬民中的萬族啊，</para>
  <para style="q1" vid="PSA 96:7">你們當把榮耀和力量</para>
  <para style="q1" vid="PSA 96:7">歸給耶和華，歸給耶和華！<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />當把耶和華名的榮耀歸給他，</para>
  <para style="q1" vid="PSA 96:8">帶著供物，進入他的院宇。<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />當向神聖威嚴的耶和華下拜；</para>
  <para style="q1" vid="PSA 96:9">全地啊，你們當在他面前震撼！<verse eid="PSA 96:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />你們當在列國中說：</para>
  <para style="q1" vid="PSA 96:10">「耶和華作王，</para>
  <para style="q1" vid="PSA 96:10">世界就被確立，不致動搖；</para>
  <para style="q1" vid="PSA 96:10">他必以正直審斷萬民。」<verse eid="PSA 96:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />願諸天歡喜，願大地快樂，</para>
  <para style="q1" vid="PSA 96:11">願海洋和其中所充滿的澎湃如雷，<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />願田野和其中的一切都歡躍；</para>
  <para style="q1" vid="PSA 96:12">那時森林中所有的樹木都必歡呼，<verse eid="PSA 96:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13" />在耶和華面前歡呼，</para>
  <para style="q1" vid="PSA 96:13">因為他要來，</para>
  <para style="q1" vid="PSA 96:13">因為他要來審判大地；</para>
  <para style="q1" vid="PSA 96:13">他將以公義審判世界，</para>
  <para style="q1" vid="PSA 96:13">以他的信實審判萬民！<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s">尊崇至高的神</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />耶和華作王！</para>
  <para style="q1" vid="PSA 97:1">願大地快樂，願眾海島歡喜！<verse eid="PSA 97:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />密雲和幽暗在他的四圍，</para>
  <para style="q1" vid="PSA 97:2">公義和公正是他寶座的根基。<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />烈火行在他的面前，</para>
  <para style="q1" vid="PSA 97:3">燒盡他四圍的敵人。<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />他的閃電照亮世界，</para>
  <para style="q1" vid="PSA 97:4">大地看見了就震撼。<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />在耶和華面前，在全地之主面前，</para>
  <para style="q1" vid="PSA 97:5">群山像蠟那樣融化。<verse eid="PSA 97:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />諸天宣告他的公義，</para>
  <para style="q1" vid="PSA 97:6">萬民看見他的榮耀。<verse eid="PSA 97:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />願一切服事雕刻偶像的、</para>
  <para style="q1" vid="PSA 97:7">以虛無的偶像誇耀的，都蒙羞；</para>
  <para style="q1" vid="PSA 97:7">一切的神明啊，</para>
  <para style="q1" vid="PSA 97:7">你們都當向他下拜！<verse eid="PSA 97:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />耶和華啊，因你的審判，</para>
  <para style="q1" vid="PSA 97:8">
    <char style="pn">錫安</char>聽了就歡喜，<char style="pn">猶大</char>的村鎮也快樂！<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />耶和華啊，你是全地之上的至高者，</para>
  <para style="q1" vid="PSA 97:9">你極其受尊崇，超越一切神明！<verse eid="PSA 97:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />愛耶和華的人哪，</para>
  <para style="q1" vid="PSA 97:10">你們當憎恨惡事！</para>
  <para style="q1" vid="PSA 97:10">耶和華保守他忠信者的性命，</para>
  <para style="q1" vid="PSA 97:10">解救他們脫離惡人的手。<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />撒播光明是為了義人，</para>
  <para style="q1" vid="PSA 97:11">撒播喜樂是為心裡正直的人。<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />義人哪，</para>
  <para style="q1" vid="PSA 97:12">你們當因耶和華而歡喜，</para>
  <para style="q1" vid="PSA 97:12">當稱頌他的聖名！<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s">歌頌大君王</para>
  <para style="b" />
  <para style="d">一首詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />你們當向耶和華唱新歌，</para>
  <para style="q1" vid="PSA 98:1">因為他行了奇妙的事，</para>
  <para style="q1" vid="PSA 98:1">他的右手和神聖的膀臂帶來了拯救。<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />耶和華顯明了他的救恩，</para>
  <para style="q1" vid="PSA 98:2">在列國眼前顯出他的公義。<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />他記念他對<char style="pn">以色列</char>家的慈愛和信實，</para>
  <para style="q1" vid="PSA 98:3">地極都看見了我們神的救恩。<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />全地啊，你們當向耶和華歡呼，</para>
  <para style="q1" vid="PSA 98:4">當放聲歡唱、歌頌！<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />當用豎琴歌頌耶和華，</para>
  <para style="q1" vid="PSA 98:5">當用豎琴和頌歌的聲音，<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />用號筒和號角的聲音，</para>
  <para style="q1" vid="PSA 98:6">在大君王耶和華面前歡呼！<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />願海洋和其中所充滿的、</para>
  <para style="q1" vid="PSA 98:7">世界和其中的居民，都歡呼如雷！<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />願江河拍掌，</para>
  <para style="q1" vid="PSA 98:8">願群山在耶和華面前一同歡唱！<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />因為他要來審判大地，</para>
  <para style="q1" vid="PSA 98:9">他將以公義審判世界，</para>
  <para style="q1" vid="PSA 98:9">以正直審判萬民。<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s">稱頌至聖者</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />耶和華作王，萬民當顫抖！</para>
  <para style="q1" vid="PSA 99:1">他坐在基路伯之上，大地當搖撼！<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />耶和華在<char style="pn">錫安</char>是至大的，</para>
  <para style="q1" vid="PSA 99:2">他在萬民之上是至高的。<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />願他們稱頌他<note caller="+" style="f"><char style="fr" closed="false">99:3 </char><char style="ft" closed="false">他——原文直譯「你」。</char></note>大而可畏的名！</para>
  <para style="q1" vid="PSA 99:3">他是至聖者！<verse eid="PSA 99:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />大能的王喜愛公正；</para>
  <para style="q1" vid="PSA 99:4">是他<note caller="+" style="f"><char style="fr" closed="false">99:4 </char><char style="ft" closed="false">他——原文直譯「你」。</char></note>堅立了公平，</para>
  <para style="q1" vid="PSA 99:4">在<char style="pn">雅各</char>中施行公正和公義。<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />你們當尊崇耶和華我們的神，</para>
  <para style="q1" vid="PSA 99:5">當在他的腳凳前下拜，</para>
  <para style="q1" vid="PSA 99:5">他是至聖者！<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />在他的祭司中有<char style="pn">摩西</char>和<char style="pn">亞倫</char>，</para>
  <para style="q1" vid="PSA 99:6">在呼求他名的人中有<char style="pn">撒母耳</char>，</para>
  <para style="q1" vid="PSA 99:6">他們向耶和華呼求，</para>
  <para style="q1" vid="PSA 99:6">他就回應他們。<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />他在雲柱中向他們說話；</para>
  <para style="q1" vid="PSA 99:7">他們持守了他賜下的法度和律例。<verse eid="PSA 99:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />耶和華我們的神哪，</para>
  <para style="q1" vid="PSA 99:8">你回應了他們！</para>
  <para style="q1" vid="PSA 99:8">你是饒恕他們的神，</para>
  <para style="q1" vid="PSA 99:8">但也照著他們的行為報應他們。<verse eid="PSA 99:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />你們當尊崇耶和華我們的神，</para>
  <para style="q1" vid="PSA 99:9">當在他的聖山下拜，</para>
  <para style="q1" vid="PSA 99:9">因為我們的神耶和華是至聖者！<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">感謝之歌</para>
  <para style="b" />
  <para style="d">感謝的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />全地啊，</para>
  <para style="q1" vid="PSA 100:1">你們當向耶和華歡呼！<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />你們當在喜樂中服事耶和華，</para>
  <para style="q1" vid="PSA 100:2">當在歡唱中來到他的面前！<verse eid="PSA 100:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />要知道耶和華是神，</para>
  <para style="q1" vid="PSA 100:3">是他造了我們，我們屬於他<note caller="+" style="f"><char style="fr" closed="false">100:3 </char><char style="ft" closed="false">我們屬於他——或譯作「不是我們自己」。</char></note>；</para>
  <para style="q1" vid="PSA 100:3">我們是他的子民，</para>
  <para style="q1" vid="PSA 100:3">是他牧場的群羊。<verse eid="PSA 100:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />當以感謝進入他的門，</para>
  <para style="q1" vid="PSA 100:4">以讚美進入他的院；</para>
  <para style="q1" vid="PSA 100:4">當稱謝他，頌讚他的名。<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />耶和華是美善的，</para>
  <para style="q1" vid="PSA 100:5">他的慈愛永遠長存，</para>
  <para style="q1" vid="PSA 100:5">他的信實直到萬代！<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s">王的諾言</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />我要歌唱慈愛和公正，</para>
  <para style="q1" vid="PSA 101:1">耶和華啊，我要歌頌你！<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />我要謹慎明智地行在完全的道上，</para>
  <para style="q1" vid="PSA 101:2">你什麼時候才到我這裡來呢？</para>
  <para style="q1" vid="PSA 101:2">我要在我家中以純全的心行事。<verse eid="PSA 101:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />卑劣的事，我不擺在眼前；</para>
  <para style="q1" vid="PSA 101:3">背道者所做的，</para>
  <para style="q1" vid="PSA 101:3">我都恨惡，不容它沾我身。<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />歪邪的心必遠離我，</para>
  <para style="q1" vid="PSA 101:4">邪惡的事，我不理會。<verse eid="PSA 101:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />暗中說鄰人壞話的，</para>
  <para style="q1" vid="PSA 101:5">我要除盡；</para>
  <para style="q1" vid="PSA 101:5">眼目高傲、心裡驕橫的，</para>
  <para style="q1" vid="PSA 101:5">我不容忍。<verse eid="PSA 101:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />我的眼目向著地上忠實的人，</para>
  <para style="q1" vid="PSA 101:6">好讓他們與我一起居住；</para>
  <para style="q1" vid="PSA 101:6">走在完全道路上的人，</para>
  <para style="q1" vid="PSA 101:6">他必事奉我。<verse eid="PSA 101:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />行事詭詐的，不能在我家裡居住；</para>
  <para style="q1" vid="PSA 101:7">說話虛假的，不能在我眼前堅立。<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />每天早晨，</para>
  <para style="q1" vid="PSA 101:8">我都除盡地上的一切惡人，</para>
  <para style="q1" vid="PSA 101:8">要從耶和華的城中剪除一切作惡之徒。<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s">危難中的呼求</para>
  <para style="b" />
  <para style="d">困苦人的禱告，他虛弱時在耶和華面前傾吐苦情。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />耶和華啊，求你垂聽我的禱告，</para>
  <para style="q1" vid="PSA 102:1">願我的呼求達到你那裡！<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />在我危難的日子裡，</para>
  <para style="q1" vid="PSA 102:2">不要向我隱藏你的臉；</para>
  <para style="q1" vid="PSA 102:2">求你向我側耳聽；</para>
  <para style="q1" vid="PSA 102:2">在我呼求的日子裡，</para>
  <para style="q1" vid="PSA 102:2">求你快快回應我；<verse eid="PSA 102:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />因為我的年日如煙雲消逝，</para>
  <para style="q1" vid="PSA 102:3">我的骨頭如爐渣焦乾，<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />我的心如牧草，受摧殘而枯乾，</para>
  <para style="q1" vid="PSA 102:4">以致我忘記了吃飯。<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />因我嘆息的聲音，</para>
  <para style="q1" vid="PSA 102:5">我的皮包著骨頭。<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />我像是曠野中的鵜鶘，</para>
  <para style="q1" vid="PSA 102:6">又像廢墟中的小鴞；<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />我驚醒無眠，</para>
  <para style="q1" vid="PSA 102:7">就像是屋頂上孤獨的雀鳥。<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />我的仇敵終日辱罵我，</para>
  <para style="q1" vid="PSA 102:8">嘲弄我的人指著我的名詛咒。<verse eid="PSA 102:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />我吃灰燼如同吃飯，</para>
  <para style="q1" vid="PSA 102:9">我所喝的與眼淚混雜。<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />這都是因你憤怒和震怒的緣故，</para>
  <para style="q1" vid="PSA 102:10">是的，你把我舉起來，又把我扔下。<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />我的年日如同偏斜的影子，</para>
  <para style="q1" vid="PSA 102:11">我像牧草那樣枯乾。<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />唯有你，耶和華啊，</para>
  <para style="q1" vid="PSA 102:12">你永遠坐著為王，</para>
  <para style="q1" vid="PSA 102:12">你的名號存到萬代！<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />你必起來憐憫<char style="pn">錫安</char>，</para>
  <para style="q1" vid="PSA 102:13">因為這是恩待她的時候，</para>
  <para style="q1" vid="PSA 102:13">又因為所定的時間已經來到。<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />是的，</para>
  <para style="q1" vid="PSA 102:14">你的僕人們喜悅<char style="pn">錫安</char>的石頭，</para>
  <para style="q1" vid="PSA 102:14">愛慕她的塵土。<verse eid="PSA 102:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />那時列國將敬畏耶和華的名，</para>
  <para style="q1" vid="PSA 102:15">地上所有的君王將敬畏你的榮耀；<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />因為耶和華建造<char style="pn">錫安</char>，</para>
  <para style="q1" vid="PSA 102:16">在自己的榮耀裡顯現。<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />他垂顧窮苦人的禱告，</para>
  <para style="q1" vid="PSA 102:17">不輕視他們的祈求。<verse eid="PSA 102:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />願這為後代記下，</para>
  <para style="q1" vid="PSA 102:18">好讓受造的子民讚美耶和華：<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />「耶和華從他神聖的至高處俯看，</para>
  <para style="q1" vid="PSA 102:19">從天上向大地觀看；<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />為要垂聽被囚者的呻吟，</para>
  <para style="q1" vid="PSA 102:20">釋放那些註定要死的人；<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />好在<char style="pn">錫安</char>傳揚耶和華的名，</para>
  <para style="q1" vid="PSA 102:21">在<char style="pn">耶路撒冷</char>傳揚他當受的讚美。<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />那時萬民、列國聚集在一起，</para>
  <para style="q1" vid="PSA 102:22">為要服事耶和華。」<verse eid="PSA 102:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />他使我的力量中途衰微，</para>
  <para style="q1" vid="PSA 102:23">使我的年日縮短。<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />我說：「我的神哪，</para>
  <para style="q1" vid="PSA 102:24">不要在我年日的中途就把我帶走！</para>
  <para style="q1" vid="PSA 102:24">你的歲月世世代代長存。<verse eid="PSA 102:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />你在起初奠定了大地的根基，</para>
  <para style="q1" vid="PSA 102:25">諸天也是你手所造的。<verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />天地將要消亡，</para>
  <para style="q1" vid="PSA 102:26">你卻繼續存留；</para>
  <para style="q1" vid="PSA 102:26">天地都要像衣服那樣漸漸破舊，</para>
  <para style="q1" vid="PSA 102:26">你把它們像衣袍那樣更換，</para>
  <para style="q1" vid="PSA 102:26">它們就消逝了；<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />你卻永不改變，</para>
  <para style="q1" vid="PSA 102:27">你的歲月沒有窮盡。<verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />你僕人們的子孫將安居，</para>
  <para style="q1" vid="PSA 102:28">他們的後裔將在你面前堅立。」<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s">稱頌慈愛的神</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">103:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />我的靈魂哪，你要頌讚耶和華！</para>
  <para style="q1" vid="PSA 103:1">在我裡面的一切，都要頌讚他的聖名。<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />我的靈魂哪，你要頌讚耶和華！</para>
  <para style="q1" vid="PSA 103:2">不要忘記他的一切恩惠——<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />他赦免你一切的罪孽，</para>
  <para style="q1" vid="PSA 103:3">醫治你一切的疾病；<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />他從陰坑贖回你的生命，</para>
  <para style="q1" vid="PSA 103:4">賜給你慈愛和憐憫為冠冕；<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />他用福份使你的心願滿足，</para>
  <para style="q1" vid="PSA 103:5">以致你返老還童，如鷹一般！<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />耶和華施行公義，</para>
  <para style="q1" vid="PSA 103:6">為一切受欺壓的人施行公正。<verse eid="PSA 103:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />他把自己的道路顯明給<char style="pn">摩西</char>，</para>
  <para style="q1" vid="PSA 103:7">把自己的作為顯明給<char style="pn">以色列</char>子孫。<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />耶和華有憐憫、有恩惠，</para>
  <para style="q1" vid="PSA 103:8">不輕易發怒，並有豐盛的慈愛。<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />他不長久責備，也不永遠懷怒。<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />他沒有照著我們的罪過對待我們，</para>
  <para style="q1" vid="PSA 103:10">也沒有照著我們的罪孽報應我們。<verse eid="PSA 103:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />因為天離地有多麼高，</para>
  <para style="q1" vid="PSA 103:11">他的慈愛向敬畏他的人也多麼大；<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />東離西有多麼遠，</para>
  <para style="q1" vid="PSA 103:12">他使我們的過犯離我們也多麼遠；<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />父親怎樣憐憫自己的兒女，</para>
  <para style="q1" vid="PSA 103:13">耶和華也怎樣憐憫敬畏他的人；<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />因為他知道我們的本體，</para>
  <para style="q1" vid="PSA 103:14">記念我們不過是塵土。<verse eid="PSA 103:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />至於世人，他的年日如草一樣，</para>
  <para style="q1" vid="PSA 103:15">他興旺如野地的花，<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />經風一吹，就不復存在，</para>
  <para style="q1" vid="PSA 103:16">連自己的地方也不再認識它。<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />但是耶和華的慈愛臨到敬畏他的人，</para>
  <para style="q1" vid="PSA 103:17">從永遠到永遠<note caller="+" style="f"><char style="fr" closed="false">103:17 </char><char style="ft" closed="false">永遠到永遠——或譯作「亙古到永遠」。</char></note>；</para>
  <para style="q1" vid="PSA 103:17">他的公義歸於他們的子子孫孫，<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />就是那些遵守他的約，</para>
  <para style="q1" vid="PSA 103:18">並記住他的訓誡去遵行的人。<verse eid="PSA 103:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />耶和華在天上使他的寶座堅立，</para>
  <para style="q1" vid="PSA 103:19">他的王權管轄萬有。<verse eid="PSA 103:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />你們作他天使的，</para>
  <para style="q1" vid="PSA 103:20">就是大有能力、</para>
  <para style="q1" vid="PSA 103:20">聽從他命令<note caller="+" style="f"><char style="fr" closed="false">103:20 </char><char style="ft" closed="false">命令——原文直譯「話語的聲音」。</char></note>、遵行他話語的，</para>
  <para style="q1" vid="PSA 103:20">都要頌讚耶和華！<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />你們作他眾軍的，</para>
  <para style="q1" vid="PSA 103:21">就是事奉他、</para>
  <para style="q1" vid="PSA 103:21">遵行他旨意的，</para>
  <para style="q1" vid="PSA 103:21">都要頌讚耶和華！<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />你們一切被他造的，</para>
  <para style="q1" vid="PSA 103:22">在他統管的各個地方，</para>
  <para style="q1" vid="PSA 103:22">都要頌讚耶和華！</para>
  <para style="q1" vid="PSA 103:22">我的靈魂哪，</para>
  <para style="q1" vid="PSA 103:22">你要頌讚耶和華！<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s">頌讚創造的神</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />我的靈魂哪，你當頌讚耶和華！</para>
  <para style="q1" vid="PSA 104:1">耶和華我的神哪，你極其偉大，</para>
  <para style="q1" vid="PSA 104:1">你以尊榮和威嚴為衣！<verse eid="PSA 104:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />耶和華披戴光明如披外袍，</para>
  <para style="q1" vid="PSA 104:2">展開諸天如幔帳。<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />他在水中為自己的樓閣架棟梁，</para>
  <para style="q1" vid="PSA 104:3">以雲彩為自己的戰車，</para>
  <para style="q1" vid="PSA 104:3">乘駕風的翅膀而行。<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />他以風作自己的使者，</para>
  <para style="q1" vid="PSA 104:4">以火焰作自己的僕役。<verse eid="PSA 104:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />他把大地奠定在根基上，</para>
  <para style="q1" vid="PSA 104:5">使它永永遠遠不動搖。<verse eid="PSA 104:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />你使深淵的水如同衣袍遮蓋大地，</para>
  <para style="q1" vid="PSA 104:6">眾水高過群山。<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />眾水因你的斥責而奔逃，</para>
  <para style="q1" vid="PSA 104:7">因你的雷聲而逃竄；<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />眾水向上漫過群山，向下流入山谷<note caller="+" style="f"><char style="fr" closed="false">104:8 </char><char style="ft" closed="false">眾水向上漫過群山，向下流入山谷——或譯作「群山上升，眾谷下沉」。</char></note>，</para>
  <para style="q1" vid="PSA 104:8">歸到你為它們指定的地方。<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />你設立了界限，它們就不能越過，</para>
  <para style="q1" vid="PSA 104:9">不再轉回遮蓋大地。<verse eid="PSA 104:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />你使泉源在溪谷中湧流，</para>
  <para style="q1" vid="PSA 104:10">在山間流淌，<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />讓田野的一切走獸有水喝；</para>
  <para style="q1" vid="PSA 104:11">野驢得以解渴。<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />天空的飛鳥在水邊安居，</para>
  <para style="q1" vid="PSA 104:12">在枝葉間啼叫。<verse eid="PSA 104:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />你從你的樓閣澆灌群山；</para>
  <para style="q1" vid="PSA 104:13">因你作為的果效，大地就飽足。<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />你使青草為牲畜長出來，</para>
  <para style="q1" vid="PSA 104:14">又使蔬菜長出來供人需用，</para>
  <para style="q1" vid="PSA 104:14">好使人能從地裡得食物。<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />你用酒使人心裡歡喜，</para>
  <para style="q1" vid="PSA 104:15">用油使人臉帶光澤，</para>
  <para style="q1" vid="PSA 104:15">用糧使人心中振作。<verse eid="PSA 104:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />耶和華的樹木，</para>
  <para style="q1" vid="PSA 104:16">就是他栽種的<char style="pn">黎巴嫩</char>的香柏樹，</para>
  <para style="q1" vid="PSA 104:16">有充足的水。<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />雀鳥在那裡搭窩，</para>
  <para style="q1" vid="PSA 104:17">白鸛以松樹為家。<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />高大的群山屬於野山羊，</para>
  <para style="q1" vid="PSA 104:18">岩石是巖貍的避難所。<verse eid="PSA 104:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />耶和華造月亮為定節令，</para>
  <para style="q1" vid="PSA 104:19">太陽知道何時沉落。<verse eid="PSA 104:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />你設立黑暗，就有了夜，</para>
  <para style="q1" vid="PSA 104:20">森林中的百獸在夜間活動；<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />少壯獅子吼叫獵食，</para>
  <para style="q1" vid="PSA 104:21">尋求來自神的食物。<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />太陽升起，牠們就退回，</para>
  <para style="q1" vid="PSA 104:22">到自己的巢穴裡躺臥；<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />而人出去工作，</para>
  <para style="q1" vid="PSA 104:23">勞碌直到傍晚。<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />耶和華啊，你所做的何其多！</para>
  <para style="q1" vid="PSA 104:24">你藉著智慧成就了這一切，</para>
  <para style="q1" vid="PSA 104:24">大地充滿了你的創造；<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />其中有巨大的海洋，兩面寬廣；</para>
  <para style="q1" vid="PSA 104:25">海裡游動的活物無法數算，大小都有；<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />那裡有船隻航行，</para>
  <para style="q1" vid="PSA 104:26">你所造的<char style="pn">利維坦</char>在裡面玩耍。<verse eid="PSA 104:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />所有這些都仰望你按時賜給牠們食物。<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />你賜給牠們，牠們就收取；</para>
  <para style="q1" vid="PSA 104:28">你張開手，牠們就飽享美食。<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />你隱藏你的臉，牠們就惶恐；</para>
  <para style="q1" vid="PSA 104:29">你收回牠們的氣息，</para>
  <para style="q1" vid="PSA 104:29">牠們就斷氣，歸回塵土。<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />你發出你的氣息<note caller="+" style="f"><char style="fr" closed="false">104:30 </char><char style="ft" closed="false">氣息——或譯作「靈」。</char></note>，牠們就被創造；</para>
  <para style="q1" vid="PSA 104:30">你使地面更換一新！<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />願耶和華的榮耀長存，直到永遠；</para>
  <para style="q1" vid="PSA 104:31">願耶和華因自己的作為而歡喜！<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />他觀看大地，大地就戰兢；</para>
  <para style="q1" vid="PSA 104:32">他觸碰群山，群山就冒煙。<verse eid="PSA 104:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />我一生要向耶和華歌唱；</para>
  <para style="q1" vid="PSA 104:33">我還活著的時候，要歌頌我的神。<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />願我的默想蒙他喜悅，</para>
  <para style="q1" vid="PSA 104:34">我要因耶和華而歡喜。<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />願罪人從地上被滅盡，</para>
  <para style="q1" vid="PSA 104:35">不再有惡人！</para>
  <para style="q1" vid="PSA 104:35">我的靈魂哪，你當頌讚耶和華！</para>
  <para style="q1" vid="PSA 104:35">哈利路亞！<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s">神以信實引領子民</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />你們當稱謝耶和華，呼求他的名，</para>
  <para style="q1" vid="PSA 105:1">在萬民中傳揚他的作為；<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />當向他歌唱，歌頌他，</para>
  <para style="q1" vid="PSA 105:2">談論他一切的奇妙作為；<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />當以他的聖名誇耀；</para>
  <para style="q1" vid="PSA 105:3">願尋求耶和華的人心裡歡喜！<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />你們當尋求耶和華和他的力量，</para>
  <para style="q1" vid="PSA 105:4">一直尋求他的榮面。<verse eid="PSA 105:4" /></para>
  <para style="q1">
    <verse number="5-6" style="v" sid="PSA 105:5-6" />他的僕人<char style="pn">亞伯拉罕</char>的後裔啊，</para>
  <para style="q1" vid="PSA 105:5-6">他所揀選的<char style="pn">雅各</char>子孫哪，</para>
  <para style="q1" vid="PSA 105:5-6">你們當記念他所行的奇妙作為，</para>
  <para style="q1" vid="PSA 105:5-6">記念他的奇事和他口中的法規！<verse eid="PSA 105:5-6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />他是耶和華我們的神，</para>
  <para style="q1" vid="PSA 105:7">他的公正充滿全地。<verse eid="PSA 105:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />他記念自己的約，直到永遠；</para>
  <para style="q1" vid="PSA 105:8">記念他吩咐的話，直到千代——<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />就是他與<char style="pn">亞伯拉罕</char>所立的約，</para>
  <para style="q1" vid="PSA 105:9">向<char style="pn">以撒</char>所起的誓；<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />又把這約給<char style="pn">雅各</char>立為律例，</para>
  <para style="q1" vid="PSA 105:10">給<char style="pn">以色列</char>立為永遠的約；<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />他說：「我要把<char style="pn">迦南</char>地賜給你，</para>
  <para style="q1" vid="PSA 105:11">作為你們分得的繼業。」<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />那時他們人數稀少，實在很少，</para>
  <para style="q1" vid="PSA 105:12">在那地是寄居的；<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />他們從這國流浪到那國，</para>
  <para style="q1" vid="PSA 105:13">從這邦流浪到那邦。<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />他不容任何人欺壓他們，</para>
  <para style="q1" vid="PSA 105:14">還為他們的緣故責備君王：<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />「你們不可碰我的受膏者，</para>
  <para style="q1" vid="PSA 105:15">不可惡待我的先知。」<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />他召來饑荒臨到那地，</para>
  <para style="q1" vid="PSA 105:16">斷絕了一切糧食供應。<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />他在他們之前派遣了一個人，</para>
  <para style="q1" vid="PSA 105:17">就是被賣為奴的<char style="pn">約瑟</char>。<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />人們用腳鐐傷了他的腳，</para>
  <para style="q1" vid="PSA 105:18">他的脖子被套進鐵索；<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />耶和華的言語熬煉他，</para>
  <para style="q1" vid="PSA 105:19">直到他的話語應驗。<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />王派人把他解開，</para>
  <para style="q1" vid="PSA 105:20">民眾的管轄者將他釋放；<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />立他為王家之主，</para>
  <para style="q1" vid="PSA 105:21">管轄王一切所擁有的；<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />讓他可以隨意捆綁<note caller="+" style="f"><char style="fr" closed="false">105:22 </char><char style="ft" closed="false">捆綁——七十士譯本作「教導」。</char></note>王的群臣，</para>
  <para style="q1" vid="PSA 105:22">將智慧傳授給王的眾長老。<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />後來<char style="pn">以色列</char>來到<char style="pn">埃及</char>，</para>
  <para style="q1" vid="PSA 105:23">
    <char style="pn">雅各</char>寄居在<char style="pn">含</char>族之地。<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />耶和華使他的子民生養眾多，</para>
  <para style="q1" vid="PSA 105:24">使他們比敵人更強盛。<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />他又使敵人的心轉去恨他的子民，</para>
  <para style="q1" vid="PSA 105:25">行詭詐對付他的僕人們。<verse eid="PSA 105:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />他派遣了他的僕人<char style="pn">摩西</char>，</para>
  <para style="q1" vid="PSA 105:26">以及他所揀選的<char style="pn">亞倫</char>；<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />兩人將他的神蹟行在<char style="pn">埃及</char>人中間，</para>
  <para style="q1" vid="PSA 105:27">將奇事行在<char style="pn">含</char>族之地。<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />他發出黑暗，使那地黑暗；</para>
  <para style="q1" vid="PSA 105:28">誰也沒有<note caller="+" style="f"><char style="fr" closed="false">105:28 </char><char style="ft" closed="false">誰也沒有——或譯作「他們沒有」或「他們卻」。</char></note>違背他的話。<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />他把他們的水變成血，</para>
  <para style="q1" vid="PSA 105:29">使他們的魚都死了。<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />他們的地上、</para>
  <para style="q1" vid="PSA 105:30">甚至他們君王的內室，</para>
  <para style="q1" vid="PSA 105:30">都爬滿了青蛙。<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />他一發話，成群的蒼蠅就來，</para>
  <para style="q1" vid="PSA 105:31">蠓蚋遍滿他們的全境。<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />他給他們降下冰雹為雨，</para>
  <para style="q1" vid="PSA 105:32">又在他們的地上降下閃電為火。<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />他打擊他們的葡萄樹和無花果樹，</para>
  <para style="q1" vid="PSA 105:33">打斷他們境內的樹木。<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />他一發話，蝗蟲和蝗蝻就來，</para>
  <para style="q1" vid="PSA 105:34">無法數算，<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />吃盡他們地上的一切植物，</para>
  <para style="q1" vid="PSA 105:35">吃盡他們土地的出產。<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />他又擊殺他們地上所有的長子，</para>
  <para style="q1" vid="PSA 105:36">就是他們強壯時頭生的。<verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />他領他的子民帶著金銀出來，</para>
  <para style="q1" vid="PSA 105:37">他的眾支派中沒有絆倒的。<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />他們出來的時候，<char style="pn">埃及</char>就歡喜，</para>
  <para style="q1" vid="PSA 105:38">因為全<char style="pn">埃及</char>都懼怕他們。<verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />他鋪開雲彩作遮蓋，</para>
  <para style="q1" vid="PSA 105:39">用火來照亮黑夜。<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />他們祈求，他就使鵪鶉飛來，</para>
  <para style="q1" vid="PSA 105:40">並用天上的糧食使他們飽足。<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />他打開磐石，水就湧出，</para>
  <para style="q1" vid="PSA 105:41">在那乾旱之地流淌如河；<verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />因為他記念他神聖的話語，</para>
  <para style="q1" vid="PSA 105:42">記念他的僕人<char style="pn">亞伯拉罕</char>。<verse eid="PSA 105:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />他使自己的子民歡樂地出來，</para>
  <para style="q1" vid="PSA 105:43">使自己的選民歡呼而出。<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />他把列國的土地都賜給他們，</para>
  <para style="q1" vid="PSA 105:44">讓他們繼承了萬民的勞苦所得，<verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />為要他們遵守他的律例，</para>
  <para style="q1" vid="PSA 105:45">謹守他的訓誨。</para>
  <para style="q1" vid="PSA 105:45">哈利路亞！<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s">神以良善恩待子民</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />哈利路亞！</para>
  <para style="q1" vid="PSA 106:1">你們當稱謝耶和華，</para>
  <para style="q1" vid="PSA 106:1">他是美善的，他的慈愛永遠長存！<verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />誰能說出耶和華的大能作為呢？</para>
  <para style="q1" vid="PSA 106:2">誰能傳揚他當受的一切讚美呢？<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />那些持守公正、時時行公義的人，</para>
  <para style="q1" vid="PSA 106:3">是蒙福的！<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />耶和華啊，你悅納你子民的時候，</para>
  <para style="q1" vid="PSA 106:4">求你記念我，以你的救恩看顧我，<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />好讓我看到你選民的福份，</para>
  <para style="q1" vid="PSA 106:5">以你國民的歡喜為歡喜，</para>
  <para style="q1" vid="PSA 106:5">與你的繼業一同誇耀！<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />我們與我們的祖先一同犯了罪，</para>
  <para style="q1" vid="PSA 106:6">我們行事扭曲，做事邪惡。<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />我們的祖先在<char style="pn">埃及</char>時，</para>
  <para style="q1" vid="PSA 106:7">不明白你的奇妙作為，</para>
  <para style="q1" vid="PSA 106:7">不記念你豐盛的慈愛，</para>
  <para style="q1" vid="PSA 106:7">反倒在<char style="pn">紅海</char>邊悖逆。<verse eid="PSA 106:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />但他為自己名的緣故拯救他們，</para>
  <para style="q1" vid="PSA 106:8">為要彰顯他的大能。<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />他斥責<char style="pn">紅海</char>，海就乾涸了；</para>
  <para style="q1" vid="PSA 106:9">他帶他們走過深淵，如同走過旱地。<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />他拯救他們脫離仇恨者的手，</para>
  <para style="q1" vid="PSA 106:10">從仇敵的手中救贖了他們。<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />水淹沒了他們的敵人，</para>
  <para style="q1" vid="PSA 106:11">連一個也沒有留下。<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />那時他們才相信了他的話，</para>
  <para style="q1" vid="PSA 106:12">歌唱對他的讚美。<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />但他們很快就忘記了他的作為，</para>
  <para style="q1" vid="PSA 106:13">也沒有等候他的帶領。<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />他們在曠野貪圖口腹之欲，</para>
  <para style="q1" vid="PSA 106:14">在荒漠中試探神。<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />那時，神把他們所求的賜給他們，</para>
  <para style="q1" vid="PSA 106:15">卻使衰敗臨到他們的靈魂。<verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />他們在營中嫉妒<char style="pn">摩西</char>，</para>
  <para style="q1" vid="PSA 106:16">以及耶和華的聖者<char style="pn">亞倫</char>。<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />地就裂開，吞掉了<char style="pn">大坍</char>，</para>
  <para style="q1" vid="PSA 106:17">掩埋了<char style="pn">亞比蘭</char>的同黨。<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />火在他們的同黨中燃燒，</para>
  <para style="q1" vid="PSA 106:18">火焰燒盡了惡人。<verse eid="PSA 106:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />他們在<char style="pn">何烈</char>山鑄造牛犢，</para>
  <para style="q1" vid="PSA 106:19">竟向一個鑄像下拜，<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />把他們榮耀的主<note caller="+" style="f"><char style="fr" closed="false">106:20 </char><char style="ft" closed="false">的主——輔助詞語。</char></note></para>
  <para style="q1" vid="PSA 106:20">替換為吃草之牛的樣子。<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />他們忘記了神是他們的拯救者——</para>
  <para style="q1" vid="PSA 106:21">是他在<char style="pn">埃及</char>行了大事，<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />是他在<char style="pn">含</char>族之地行了奇妙之事，</para>
  <para style="q1" vid="PSA 106:22">在<char style="pn">紅海</char>行了可畏之事。<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />所以他說要除滅他們；</para>
  <para style="q1" vid="PSA 106:23">要不是他所揀選的<char style="pn">摩西</char>在他面前</para>
  <para style="q1" vid="PSA 106:23">站在破口處，使他的怒火轉消，</para>
  <para style="q1" vid="PSA 106:23">他早就毀掉他們了！<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />他們厭棄那美好之地，</para>
  <para style="q1" vid="PSA 106:24">不相信他的話語；<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />他們在自己的帳篷中發怨言，</para>
  <para style="q1" vid="PSA 106:25">不聽從耶和華的話；<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />所以他針對他們舉手起誓，</para>
  <para style="q1" vid="PSA 106:26">要使他們倒在曠野中，<verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />使他們的後裔倒在列國，</para>
  <para style="q1" vid="PSA 106:27">把他們打散在各地。<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />他們與<char style="pn">毗珥</char>的<char style="pn">巴力</char>聯合，</para>
  <para style="q1" vid="PSA 106:28">吃了給無生命之物的祭品；<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />他們以自己的行為惹神惱怒，</para>
  <para style="q1" vid="PSA 106:29">瘟疫就在他們中間爆發。<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />那時<char style="pn">非尼哈</char>站出來干預，</para>
  <para style="q1" vid="PSA 106:30">瘟疫才被止住。<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />這就算為他的義，</para>
  <para style="q1" vid="PSA 106:31">世世代代，直到永遠。<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />他們又在<char style="pn">米利巴</char>的水邊惹怒神，</para>
  <para style="q1" vid="PSA 106:32">以致<char style="pn">摩西</char>也因他們的緣故受了虧損；<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />他們忤逆神的靈，</para>
  <para style="q1" vid="PSA 106:33">因此<char style="pn">摩西</char>的嘴說了輕率的話。<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />他們沒有照著耶和華所吩咐的，</para>
  <para style="q1" vid="PSA 106:34">除滅那裡的族群；<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />反而與列國混合，</para>
  <para style="q1" vid="PSA 106:35">學習他們的行為，<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />服事他們的偶像。</para>
  <para style="q1" vid="PSA 106:36">這就成為自己的陷阱。<verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />他們把自己的兒子和女兒</para>
  <para style="q1" vid="PSA 106:37">祭獻給鬼魔；<verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />他們流無辜人的血，</para>
  <para style="q1" vid="PSA 106:38">就是自己兒女的血，</para>
  <para style="q1" vid="PSA 106:38">把他們祭獻給<char style="pn">迦南</char>的偶像，</para>
  <para style="q1" vid="PSA 106:38">那地就被血玷汙了。<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />這樣他們行為不潔，</para>
  <para style="q1" vid="PSA 106:39">行事淫亂。<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />於是耶和華的怒氣向他的子民發作；</para>
  <para style="q1" vid="PSA 106:40">他厭惡自己的繼業，<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />把他們交在列國的手中，</para>
  <para style="q1" vid="PSA 106:41">恨他們的人就管轄他們。<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />他們的仇敵壓迫他們，</para>
  <para style="q1" vid="PSA 106:42">他們就屈服在仇敵手下。<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />他多次解救他們，</para>
  <para style="q1" vid="PSA 106:43">他們卻圖謀悖逆，</para>
  <para style="q1" vid="PSA 106:43">在自己的罪孽中墮落。<verse eid="PSA 106:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />然而，當他聽到他們呼聲的時候，</para>
  <para style="q1" vid="PSA 106:44">就垂顧他們的危難，<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />為他們的緣故，記念自己的約，</para>
  <para style="q1" vid="PSA 106:45">照著他豐盛的慈愛改變心意；<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />又使他們在所有擄走他們的人面前蒙憐憫。<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />耶和華我們的神哪，求你拯救我們，</para>
  <para style="q1" vid="PSA 106:47">求你從列國中招聚我們，</para>
  <para style="q1" vid="PSA 106:47">好讓我們稱頌你的聖名，以讚美你為福樂！<verse eid="PSA 106:47" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />
    <char style="pn">以色列</char>的神耶和華是當受頌讚的，</para>
  <para style="q1" vid="PSA 106:48">從永遠到永遠<note caller="+" style="f"><char style="fr" closed="false">106:48 </char><char style="ft" closed="false">永遠到永遠——或譯作「亙古到永遠」。</char></note>。</para>
  <para style="q1" vid="PSA 106:48">願全體民眾都說：「阿們！」</para>
  <para style="q1" vid="PSA 106:48">哈利路亞！<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">第五卷</para>
  <para style="mr">（<ref loc="PSA 107-150">詩篇107-150</ref>）</para>
  <para style="b" />
  <para style="s">神以慈愛拯救子民</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />你們當稱謝耶和華，</para>
  <para style="q1" vid="PSA 107:1">他是美善的，他的慈愛永遠長存！<verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />願耶和華所贖回的民這樣感謝；</para>
  <para style="q1" vid="PSA 107:2">這民就是他從敵人手中贖回來，<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />從東從西、從北從南<note caller="+" style="f"><char style="fr" closed="false">107:3 </char><char style="ft" closed="false">南——原文直譯「海」。</char></note>，</para>
  <para style="q1" vid="PSA 107:3">從各地所招聚的人。<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />一些人在曠野和荒漠中漂流，</para>
  <para style="q1" vid="PSA 107:4">找不到路通往可安居的城。<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />他們又飢又渴，</para>
  <para style="q1" vid="PSA 107:5">靈裡虛弱。<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />於是他們在危難中向耶和華呼求，</para>
  <para style="q1" vid="PSA 107:6">他就解救他們脫離困境；<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />領他們踏上正直的道路，</para>
  <para style="q1" vid="PSA 107:7">前往可安居的城。<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />願他們因耶和華的慈愛，</para>
  <para style="q1" vid="PSA 107:8">以及他向世人顯明的奇妙作為稱謝他！<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />因為他滿足了乾渴的靈魂，</para>
  <para style="q1" vid="PSA 107:9">又使飢餓的靈魂飽享福份。<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />一些人坐在黑暗和死蔭裡，</para>
  <para style="q1" vid="PSA 107:10">是苦難和鐵索中的被囚者；<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />他們違背了神的話語，</para>
  <para style="q1" vid="PSA 107:11">藐視至高者的旨意；<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />因此神用勞苦使他們的心謙卑下來；</para>
  <para style="q1" vid="PSA 107:12">他們絆倒，也沒有人幫助。<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />於是他們在危難中向耶和華哀求，</para>
  <para style="q1" vid="PSA 107:13">他就拯救他們脫離困境；<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />他把他們從黑暗和死蔭裡領出來，</para>
  <para style="q1" vid="PSA 107:14">拉斷他們的繩索。<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />願他們因耶和華的慈愛，</para>
  <para style="q1" vid="PSA 107:15">以及他向世人顯明的奇妙作為稱謝他！<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />因為他打碎了銅門，</para>
  <para style="q1" vid="PSA 107:16">砍斷了鐵閂。<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />另一些是愚妄人，</para>
  <para style="q1" vid="PSA 107:17">因自己的悖逆行徑和罪孽受苦。<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />他們的心厭惡一切食物，</para>
  <para style="q1" vid="PSA 107:18">他們臨近死亡的大門。<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />於是他們在危難中向耶和華哀求，</para>
  <para style="q1" vid="PSA 107:19">他就拯救他們脫離困境；<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />他發出話語醫治他們，</para>
  <para style="q1" vid="PSA 107:20">救他們脫離陷坑。<verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />願他們因耶和華的慈愛，</para>
  <para style="q1" vid="PSA 107:21">以及他向世人顯明的奇妙作為稱謝他！<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />願他們獻上感謝的祭物，</para>
  <para style="q1" vid="PSA 107:22">在歡呼中講述他所做的！<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />又一些人乘船航行在海上，</para>
  <para style="q1" vid="PSA 107:23">在大水上往來經商；<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />他們看見了耶和華所做的，</para>
  <para style="q1" vid="PSA 107:24">以及他在深海中的奇妙作為。<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />他一吩咐，暴風就興起，</para>
  <para style="q1" vid="PSA 107:25">揚起海洋的波濤。<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />他們上到天空，又下到深淵，</para>
  <para style="q1" vid="PSA 107:26">在危急中魂飛魄散。<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />他們像醉酒的人，</para>
  <para style="q1" vid="PSA 107:27">搖搖晃晃，東倒西歪，</para>
  <para style="q1" vid="PSA 107:27">他們一切的智慧毫無用處<note caller="+" style="f"><char style="fr" closed="false">107:27 </char><char style="ft" closed="false">毫無用處——原文直譯「被吞沒了」。</char></note>。<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />於是他們在危難中向耶和華呼求，</para>
  <para style="q1" vid="PSA 107:28">他就把他們從困境中領出來。<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />他使狂風止息，歸於靜寂，</para>
  <para style="q1" vid="PSA 107:29">海洋的波濤也平靜了。<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />他們因為波濤平靜下來就歡喜，</para>
  <para style="q1" vid="PSA 107:30">他就引導他們到想要去的安全港。<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />願他們因耶和華的慈愛，</para>
  <para style="q1" vid="PSA 107:31">以及他向世人顯明的奇妙作為稱謝他！<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />願他們在子民的集會裡尊崇他，</para>
  <para style="q1" vid="PSA 107:32">在長老們的座位上讚美他！<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />神使河流成為曠野，</para>
  <para style="q1" vid="PSA 107:33">水源成為乾涸之地，<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />使結果實的土地成為鹽鹼地，</para>
  <para style="q1" vid="PSA 107:34">這都因其上居民的邪惡。<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />他也使曠野成為水池，</para>
  <para style="q1" vid="PSA 107:35">使乾旱之地成為水源，<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />使飢餓的人居住在那裡，</para>
  <para style="q1" vid="PSA 107:36">得以建造可安居的城。<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />他們耕種田地，種植葡萄園，</para>
  <para style="q1" vid="PSA 107:37">得到出產的果實。<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />神祝福他們，他們就大大增多；</para>
  <para style="q1" vid="PSA 107:38">他也使他們的牲畜沒有減少。<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />後來因著壓迫、災禍和悲哀的事，</para>
  <para style="q1" vid="PSA 107:39">他們就人數減少，降為卑屈。<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />神使權貴受到藐視，</para>
  <para style="q1" vid="PSA 107:40">使他們在無路的荒涼之地漂流。<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />但他把貧窮的人安置在高處，</para>
  <para style="q1" vid="PSA 107:41">脫離苦難，</para>
  <para style="q1" vid="PSA 107:41">使他們的家族多<note caller="+" style="f"><char style="fr" closed="false">107:41 </char><char style="ft" closed="false">多——輔助詞語。</char></note>如羊群。<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />正直的人看見就歡喜，</para>
  <para style="q1" vid="PSA 107:42">所有不義的人卻閉口無言。<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />誰是有智慧的呢？</para>
  <para style="q1" vid="PSA 107:43">願他留意這些事，</para>
  <para style="q1" vid="PSA 107:43">領悟耶和華的慈愛！<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s">求神抵擋敵人</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，一首歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />神哪，我的心堅定；</para>
  <para style="q1" vid="PSA 108:1">我的靈<note caller="+" style="f"><char style="fr" closed="false">108:1 </char><char style="ft" closed="false">靈——原文直譯「榮耀」。</char></note>要唱詩歌頌！<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />醒來吧，里拉琴和豎琴，</para>
  <para style="q1" vid="PSA 108:2">我要把黎明喚醒！<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />耶和華啊，我要在萬民中稱謝你，</para>
  <para style="q1" vid="PSA 108:3">在萬族中歌頌你！<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />因為你的慈愛偉大，超過諸天，</para>
  <para style="q1" vid="PSA 108:4">你的信實上達雲霄。<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />神哪，願你受尊崇高於諸天，</para>
  <para style="q1" vid="PSA 108:5">願你的榮耀遍及全地！<verse eid="PSA 108:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />求你用你的右手施行拯救，</para>
  <para style="q1" vid="PSA 108:6">求你回應我，</para>
  <para style="q1" vid="PSA 108:6">好讓你所愛的人得救。<verse eid="PSA 108:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />神在他的聖所中說：</para>
  <para style="q1" vid="PSA 108:7">「我要歡躍，我要分割<char style="pn">示劍</char>，</para>
  <para style="q1" vid="PSA 108:7">我要測量<char style="pn">疏割</char>谷。<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />
    <char style="pn">基列</char>屬於我，<char style="pn">瑪拿西</char>也屬於我，</para>
  <para style="q1" vid="PSA 108:8">
    <char style="pn">以法蓮</char>是我的頭盔，<char style="pn">猶大</char>是我的權杖。<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />
    <char style="pn">摩押</char>是我的洗腳盆，</para>
  <para style="q1" vid="PSA 108:9">我要向<char style="pn">以東</char>扔鞋，</para>
  <para style="q1" vid="PSA 108:9">向<char style="pn">非利士</char>誇勝。」<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />誰能領我到那堡壘城呢？</para>
  <para style="q1" vid="PSA 108:10">誰能引導我到<char style="pn">以東</char>呢？<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />神哪，你不會拋棄了我們吧？</para>
  <para style="q1" vid="PSA 108:11">神哪，你不與我們的隊伍一同出征嗎？<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />求你幫助我們抵擋敵人，</para>
  <para style="q1" vid="PSA 108:12">因為人的拯救是枉然的。<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />藉著神，我們將做大能的事；</para>
  <para style="q1" vid="PSA 108:13">他必踐踏我們的敵人。<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s">求神報應控告者</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />我所讚美的神哪，</para>
  <para style="q1" vid="PSA 109:1">求你不要沉默！<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />因為邪惡的口和欺詐的口都向我張開，</para>
  <para style="q1" vid="PSA 109:2">用撒謊的舌頭對我說話，<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />用仇恨的話語圍攻我，</para>
  <para style="q1" vid="PSA 109:3">又無故與我爭戰；<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />他們用控告來回報我的愛，</para>
  <para style="q1" vid="PSA 109:4">但我不斷地禱告。<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />他們對我以惡報善，</para>
  <para style="q1" vid="PSA 109:5">以恨報愛。<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />求你派一個惡人對付他，</para>
  <para style="q1" vid="PSA 109:6">讓一個控告者<note caller="+" style="f"><char style="fr" closed="false">109:6 </char><char style="ft" closed="false">控告者——或譯作「撒旦」。</char></note>站在他的右邊。<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />他受審判的時候，願他的罪顯出來，</para>
  <para style="q1" vid="PSA 109:7">願他的禱告也成為罪過。<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />願他的年日減少，</para>
  <para style="q1" vid="PSA 109:8">願別人得到他的職份。<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />願他的兒女成為孤兒，</para>
  <para style="q1" vid="PSA 109:9">他的妻子成為寡婦。<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />願他的兒女流離失所去乞討，</para>
  <para style="q1" vid="PSA 109:10">從他們的廢墟中出來尋找食物<note caller="+" style="f"><char style="fr" closed="false">109:10 </char><char style="ft" closed="false">食物——輔助詞語。</char></note>。<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />願債主奪走一切屬於他的，</para>
  <para style="q1" vid="PSA 109:11">別人掠奪他的辛苦所得。<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />願無人向他伸出慈愛的手，</para>
  <para style="q1" vid="PSA 109:12">無人恩待他的孤兒。<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />願他的後代被剪除，</para>
  <para style="q1" vid="PSA 109:13">他們的名號在下一代被抹掉。<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />願他祖先的罪孽被記在耶和華面前，</para>
  <para style="q1" vid="PSA 109:14">不要讓他母親的罪被抹掉。<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />願這些罪一直在耶和華面前，</para>
  <para style="q1" vid="PSA 109:15">願耶和華把他們的名號從地上剪除；<verse eid="PSA 109:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />因為他從不記得施慈愛，</para>
  <para style="q1" vid="PSA 109:16">卻追逼困苦人、貧窮人、心裡哀痛的人，</para>
  <para style="q1" vid="PSA 109:16">要置他們於死地。<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />他喜愛詛咒人，詛咒就臨到他；</para>
  <para style="q1" vid="PSA 109:17">他不喜歡祝福人，祝福就遠離他。<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />他把詛咒當作衣袍穿上，</para>
  <para style="q1" vid="PSA 109:18">所以詛咒像水那樣進到他裡面，</para>
  <para style="q1" vid="PSA 109:18">像油那樣進到他的骨頭裡。<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />願詛咒如同他披戴在身上的衣服，</para>
  <para style="q1" vid="PSA 109:19">又如他日常束上的腰帶。<verse eid="PSA 109:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />願這成為來自耶和華的報償，</para>
  <para style="q1" vid="PSA 109:20">加給那些控告我的人，</para>
  <para style="q1" vid="PSA 109:20">加給那些說惡言攻擊我的人。<verse eid="PSA 109:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />可是你，主耶和華啊，</para>
  <para style="q1" vid="PSA 109:21">求你為你名的緣故恩待我；</para>
  <para style="q1" vid="PSA 109:21">因你的慈愛是美善的，</para>
  <para style="q1" vid="PSA 109:21">求你解救我，<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />因為我困苦貧窮，</para>
  <para style="q1" vid="PSA 109:22">我的心在我裡面被刺透。<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />我如影子偏斜消逝，</para>
  <para style="q1" vid="PSA 109:23">又如蝗蟲被抖落。<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />我的膝蓋因禁食而軟弱，</para>
  <para style="q1" vid="PSA 109:24">我的肉體消瘦，不再肥美。<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />我被他們羞辱，</para>
  <para style="q1" vid="PSA 109:25">他們看見我就搖頭。<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />耶和華我的神哪，求你幫助我，</para>
  <para style="q1" vid="PSA 109:26">求你照著你的慈愛拯救我！<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />願他們明白這是出自你的手，</para>
  <para style="q1" vid="PSA 109:27">是你耶和華做了這事。<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />任憑他們詛咒，你卻要祝福；</para>
  <para style="q1" vid="PSA 109:28">他們起來就蒙羞，你的僕人卻要歡喜。<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />願那些控告我的人穿上羞愧，</para>
  <para style="q1" vid="PSA 109:29">披戴恥辱如同披戴外袍。<verse eid="PSA 109:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />我要用口大大稱謝耶和華，</para>
  <para style="q1" vid="PSA 109:30">在眾人中間讚美他；<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />因為耶和華站在貧窮人的右邊，</para>
  <para style="q1" vid="PSA 109:31">要拯救他脫離那些定他死罪的人。<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s">作祭司的王</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />耶和華對我主宣告：</para>
  <para style="q1" vid="PSA 110:1">「你坐在我的右邊，</para>
  <para style="q1" vid="PSA 110:1">等我使你的仇敵作你的腳凳。」<verse eid="PSA 110:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />耶和華將從<char style="pn">錫安</char>把你的權杖伸出；</para>
  <para style="q1" vid="PSA 110:2">你當在你的仇敵中執掌大權！<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />在你掌權的日子，</para>
  <para style="q1" vid="PSA 110:3">你的子民都甘心奉獻自己；</para>
  <para style="q1" vid="PSA 110:3">你的少年人以聖潔為裝飾，</para>
  <para style="q1" vid="PSA 110:3">如黎明初曉<note caller="+" style="f"><char style="fr" closed="false">110:3 </char><char style="ft" closed="false">黎明初曉——原文直譯「早晨的母胎」。</char></note>時的甘露歸屬你<note caller="+" style="f"><char style="fr" closed="false">110:3 </char><char style="ft" closed="false">歸屬你——或譯作「到你那裡」。</char></note>。<verse eid="PSA 110:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />耶和華起了誓，不改變心意，說：</para>
  <para style="q1" vid="PSA 110:4">「你是照著<char style="pn">麥基洗德</char>的等級，</para>
  <para style="q1" vid="PSA 110:4">永遠作祭司。」<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />主<note caller="+" style="f"><char style="fr" closed="false">110:5 </char><char style="ft" closed="false">主——有古抄本作「耶和華」；馬索拉文本作「我主」。</char></note>在你的右邊；</para>
  <para style="q1" vid="PSA 110:5">他必在烈怒的日子裡擊碎君王們。<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />他將在列國中施行審判，</para>
  <para style="q1" vid="PSA 110:6">使列國屍橫遍野；</para>
  <para style="q1" vid="PSA 110:6">他將擊碎全地的首領。<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />他將喝路旁的溪水，</para>
  <para style="q1" vid="PSA 110:7">從而抬起頭來。<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s">讚美耶和華的作為</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />哈利路亞！</para>
  <para style="q1" vid="PSA 111:1">在正直人的聚會和集會中，</para>
  <para style="q1" vid="PSA 111:1">我要全心稱謝耶和華。<verse eid="PSA 111:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />耶和華的作為偉大，</para>
  <para style="q1" vid="PSA 111:2">一切喜愛他作為的人都會探究。<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />他的作為有尊榮、有威嚴，</para>
  <para style="q1" vid="PSA 111:3">他的公義存留到永遠。<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />他使人記念他的奇妙之事；</para>
  <para style="q1" vid="PSA 111:4">耶和華有恩惠、有憐憫。<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />他賜糧食給敬畏他的人，</para>
  <para style="q1" vid="PSA 111:5">永遠記念自己的約。<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />他向他的子民宣告自己的大能作為，</para>
  <para style="q1" vid="PSA 111:6">把列國的繼業賜給他們。<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />他手所做的都信實公正，</para>
  <para style="q1" vid="PSA 111:7">他一切的訓誡全都可靠——<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />它們被立定，直到永永遠遠，</para>
  <para style="q1" vid="PSA 111:8">並藉著信實和正直被成就。<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />他為他的子民賜下救贖，</para>
  <para style="q1" vid="PSA 111:9">永遠立定他的約；</para>
  <para style="q1" vid="PSA 111:9">他的名至聖可畏。<verse eid="PSA 111:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />敬畏耶和華是智慧的開端；</para>
  <para style="q1" vid="PSA 111:10">所有遵行這些的都有美好的見識。</para>
  <para style="q1" vid="PSA 111:10">耶和華當受的讚美將存留到永遠。<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s">義人的福份</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />哈利路亞！</para>
  <para style="q1" vid="PSA 112:1">敬畏耶和華、極其喜悅他誡命的，</para>
  <para style="q1" vid="PSA 112:1">是蒙福的！<verse eid="PSA 112:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />他的後裔在地上必強盛，</para>
  <para style="q1" vid="PSA 112:2">正直人的後代必蒙福。<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />他的家裡有金錢財富，</para>
  <para style="q1" vid="PSA 112:3">他的公義將存留到永遠。<verse eid="PSA 112:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />光在黑暗中為正直人升起；</para>
  <para style="q1" vid="PSA 112:4">他有恩惠、有憐憫、有公義。<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />恩待人、借予人的，是有福之人，</para>
  <para style="q1" vid="PSA 112:5">他秉公辦事；<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />是的，他永不動搖，</para>
  <para style="q1" vid="PSA 112:6">義人將永遠被記念。<verse eid="PSA 112:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />他不會因壞消息而害怕，</para>
  <para style="q1" vid="PSA 112:7">他的心因依靠耶和華而堅定；<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />他的心堅定，總不害怕，</para>
  <para style="q1" vid="PSA 112:8">直到看見敵人的結局<note caller="+" style="f"><char style="fr" closed="false">112:8 </char><char style="ft" closed="false">的結局——輔助詞語。</char></note>。<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />他施捨、給予貧窮人，</para>
  <para style="q1" vid="PSA 112:9">他的公義將存留到永遠，</para>
  <para style="q1" vid="PSA 112:9">他的角將在榮耀中被高舉。<verse eid="PSA 112:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />惡人看見就惱怒，</para>
  <para style="q1" vid="PSA 112:10">他們咬牙切齒終必消逝；</para>
  <para style="q1" vid="PSA 112:10">他們的願望也要消亡。<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s">讚美神垂顧貧弱者</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />哈利路亞！</para>
  <para style="q1" vid="PSA 113:1">耶和華的僕人們哪，</para>
  <para style="q1" vid="PSA 113:1">你們當讚美，讚美耶和華的名！<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />願耶和華的名受頌讚，</para>
  <para style="q1" vid="PSA 113:2">從今直到永遠。<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />從日出之地到日落之處，</para>
  <para style="q1" vid="PSA 113:3">耶和華的名都當受讚美。<verse eid="PSA 113:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />耶和華至高，在萬國之上；</para>
  <para style="q1" vid="PSA 113:4">他的榮耀在諸天之上。<verse eid="PSA 113:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />誰像耶和華我們的神呢？</para>
  <para style="q1" vid="PSA 113:5">他在至高之處坐著為王；<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />他俯身觀看天上和地上的事。<verse eid="PSA 113:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />他從塵土中興起貧弱者，</para>
  <para style="q1" vid="PSA 113:7">從糞堆中高舉貧窮人，<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />要使他們與高貴人同坐，</para>
  <para style="q1" vid="PSA 113:8">與他子民中的高貴人同坐。<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />他使不能生育的女人安居家中，</para>
  <para style="q1" vid="PSA 113:9">成為有兒女的快樂母親。</para>
  <para style="q1" vid="PSA 113:9">哈利路亞！<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s">出埃及之歌</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />當<char style="pn">以色列</char>從<char style="pn">埃及</char>出來，</para>
  <para style="q1" vid="PSA 114:1">
    <char style="pn">雅各</char>家離開言語陌生之民的時候，<verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />
    <char style="pn">猶大</char>成為耶和華的聖所，</para>
  <para style="q1" vid="PSA 114:2">
    <char style="pn">以色列</char>成為他的國度。<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />海水看見了就逃跑，</para>
  <para style="q1" vid="PSA 114:3">
    <char style="pn">約旦</char>河也倒流。<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />群山跳躍如公羊，</para>
  <para style="q1" vid="PSA 114:4">岡陵跳躍如羊羔。<verse eid="PSA 114:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />海水啊，你為什麼逃跑呢？</para>
  <para style="q1" vid="PSA 114:5">
    <char style="pn">約旦</char>河啊，你為什麼倒流呢？<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />群山哪，你為什麼跳躍如公羊呢？</para>
  <para style="q1" vid="PSA 114:6">岡陵啊，你為什麼跳躍如羊羔呢？<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />大地啊，在主的面前，</para>
  <para style="q1" vid="PSA 114:7">在<char style="pn">雅各</char>的神面前，你當震撼！<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />神使磐石變成水池，</para>
  <para style="q1" vid="PSA 114:8">使堅石變成水泉。<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s">依靠獨一真神</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />耶和華啊，不要把榮耀歸於我們，</para>
  <para style="q1" vid="PSA 115:1">不要歸於我們；</para>
  <para style="q1" vid="PSA 115:1">而要因你的慈愛和信實，</para>
  <para style="q1" vid="PSA 115:1">把榮耀歸於你的名！<verse eid="PSA 115:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />列國為什麼要說：</para>
  <para style="q1" vid="PSA 115:2">「他們的神在哪裡呢？」<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />我們的神在天上，</para>
  <para style="q1" vid="PSA 115:3">他完全照自己的意願行事。<verse eid="PSA 115:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />列國的偶像是銀的、金的，</para>
  <para style="q1" vid="PSA 115:4">是人手所造的：<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />它們有嘴卻不能說，</para>
  <para style="q1" vid="PSA 115:5">有眼卻不能看；<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />有耳卻不能聽，</para>
  <para style="q1" vid="PSA 115:6">有鼻卻不能聞；<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />有手卻不能摸，</para>
  <para style="q1" vid="PSA 115:7">有腳卻不能走，</para>
  <para style="q1" vid="PSA 115:7">也不能用喉嚨發出聲音。<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />那些造它們的、所有依靠它們的，</para>
  <para style="q1" vid="PSA 115:8">都會像它們那樣。<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />
    <char style="pn">以色列</char>啊，當依靠耶和華！</para>
  <para style="q1" vid="PSA 115:9">他是他們的幫助、他們的盾牌。<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />
    <char style="pn">亞倫</char>家啊，當依靠耶和華！</para>
  <para style="q1" vid="PSA 115:10">他是他們的幫助、他們的盾牌。<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />敬畏耶和華的人哪，當依靠耶和華！</para>
  <para style="q1" vid="PSA 115:11">他是他們的幫助、他們的盾牌。<verse eid="PSA 115:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />耶和華記念我們，祝福我們；</para>
  <para style="q1" vid="PSA 115:12">他祝福<char style="pn">以色列</char>家，祝福<char style="pn">亞倫</char>家。<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />耶和華祝福敬畏他的人，</para>
  <para style="q1" vid="PSA 115:13">無論卑微的或尊貴的！<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />願耶和華使你們增多，</para>
  <para style="q1" vid="PSA 115:14">使你們和你們的子孫增多。<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />願造天地的耶和華祝福你們！<verse eid="PSA 115:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />天，是耶和華的天；</para>
  <para style="q1" vid="PSA 115:16">地，他卻賜給了世人。<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />死人不能讚美耶和華，</para>
  <para style="q1" vid="PSA 115:17">所有下到寂靜之地的都不能。<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />至於我們，我們要頌讚耶和華，</para>
  <para style="q1" vid="PSA 115:18">從今直到永遠。</para>
  <para style="q1" vid="PSA 115:18">哈利路亞！<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">神拯救脫離死亡</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />我愛耶和華，</para>
  <para style="q1" vid="PSA 116:1">因為他垂聽我的聲音和我的懇求；<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />又因為他向我側耳聽，</para>
  <para style="q1" vid="PSA 116:2">我要在我的年日裡呼求他。<verse eid="PSA 116:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />死亡的繩索纏繞我，</para>
  <para style="q1" vid="PSA 116:3">陰間的苦楚臨到我；</para>
  <para style="q1" vid="PSA 116:3">我遭遇患難和悲哀的事。<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />那時我呼求耶和華的名：</para>
  <para style="q1" vid="PSA 116:4">「哦，耶和華啊，</para>
  <para style="q1" vid="PSA 116:4">求你救我的靈魂！」<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />耶和華有恩惠、有公義，</para>
  <para style="q1" vid="PSA 116:5">我們的神大有憐憫。<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />耶和華保守無知的人，</para>
  <para style="q1" vid="PSA 116:6">我衰微時，他就拯救我。<verse eid="PSA 116:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />我的靈魂哪，</para>
  <para style="q1" vid="PSA 116:7">當歸回你的歇息之處，</para>
  <para style="q1" vid="PSA 116:7">因為耶和華恩待你！<verse eid="PSA 116:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />是的，</para>
  <para style="q1" vid="PSA 116:8">耶和華搭救了我的靈魂脫離死亡，</para>
  <para style="q1" vid="PSA 116:8">使我的眼睛不致流淚，</para>
  <para style="q1" vid="PSA 116:8">使我的腳不致絆跌。<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />我要在活人之地，</para>
  <para style="q1" vid="PSA 116:9">行在耶和華面前。<verse eid="PSA 116:9" /></para>
  <para style="q1">
    <verse number="10-11" style="v" sid="PSA 116:10-11" />儘管我曾說：</para>
  <para style="q1" vid="PSA 116:10-11">「我受了極大的苦待」，</para>
  <para style="q1" vid="PSA 116:10-11">儘管我曾在慌亂中說：</para>
  <para style="q1" vid="PSA 116:10-11">「所有的人都是說謊的」，</para>
  <para style="q1" vid="PSA 116:10-11">但我仍然相信。<verse eid="PSA 116:10-11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />我要用什麼回報耶和華，</para>
  <para style="q1" vid="PSA 116:12">回報他對我的一切厚恩呢？<verse eid="PSA 116:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />我要舉起救恩的杯，</para>
  <para style="q1" vid="PSA 116:13">呼求耶和華的名。<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />我要在耶和華所有的子民面前，</para>
  <para style="q1" vid="PSA 116:14">向他還我所許的願。<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />在耶和華的眼中，</para>
  <para style="q1" vid="PSA 116:15">他忠信者的死是寶貴的。<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />哦，耶和華啊，</para>
  <para style="q1" vid="PSA 116:16">我確實是你的僕人！</para>
  <para style="q1" vid="PSA 116:16">我是你的僕人，是你女僕的兒子。</para>
  <para style="q1" vid="PSA 116:16">你已經解開了我的繩索。<verse eid="PSA 116:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />我要向你獻上感謝的祭物，</para>
  <para style="q1" vid="PSA 116:17">並要呼求耶和華的名。<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />我要在耶和華所有的子民面前，</para>
  <para style="q1" vid="PSA 116:18">向他還我所許的願；<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />
    <char style="pn">耶路撒冷</char>啊，就在你當中，</para>
  <para style="q1" vid="PSA 116:19">就在耶和華殿的院宇裡還願！</para>
  <para style="q1" vid="PSA 116:19">哈利路亞！<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">萬國要讚美神</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />萬國啊，你們當讚美耶和華！</para>
  <para style="q1" vid="PSA 117:1">萬民哪，你們當稱讚他！<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />因為他的慈愛對我們何等<note caller="+" style="f"><char style="fr" closed="false">117:2 </char><char style="ft" closed="false">何等——輔助詞語。</char></note>大，</para>
  <para style="q1" vid="PSA 117:2">耶和華的信實存到永遠！</para>
  <para style="q1" vid="PSA 117:2">哈利路亞！<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">神的慈愛永遠長存</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />你們當稱謝耶和華，</para>
  <para style="q1" vid="PSA 118:1">他是美善的，他的慈愛永遠長存！<verse eid="PSA 118:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />願<char style="pn">以色列</char>說：</para>
  <para style="q1" vid="PSA 118:2">「他的慈愛永遠長存！」<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />願<char style="pn">亞倫</char>家說：</para>
  <para style="q1" vid="PSA 118:3">「他的慈愛永遠長存！」<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />願敬畏耶和華的人說：</para>
  <para style="q1" vid="PSA 118:4">「他的慈愛永遠長存！」<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />我在苦楚中呼求耶和華；</para>
  <para style="q1" vid="PSA 118:5">耶和華回應了我，</para>
  <para style="q1" vid="PSA 118:5">把我安置<note caller="+" style="f"><char style="fr" closed="false">118:5 </char><char style="ft" closed="false">把我安置——輔助詞語。</char></note>在寬闊之地。<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />耶和華在我這邊，我就不害怕；</para>
  <para style="q1" vid="PSA 118:6">人能對我做什麼呢？<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />耶和華在我這邊，作我的幫助者，</para>
  <para style="q1" vid="PSA 118:7">我就會看見那些恨我之人的下場<note caller="+" style="f"><char style="fr" closed="false">118:7 </char><char style="ft" closed="false">的下場——輔助詞語。</char></note>。<verse eid="PSA 118:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />投靠耶和華，好過依靠人；<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />投靠耶和華，好過依靠權貴。<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />列國都圍繞我；</para>
  <para style="q1" vid="PSA 118:10">我靠耶和華的名必要割除他們！<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />他們圍繞我，是的，他們圍繞我；</para>
  <para style="q1" vid="PSA 118:11">我靠耶和華的名必要割除他們！<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />他們像蜂群那樣圍繞我，</para>
  <para style="q1" vid="PSA 118:12">卻像荊棘火那樣被熄滅；</para>
  <para style="q1" vid="PSA 118:12">我靠耶和華的名必要割除他們！<verse eid="PSA 118:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />我被人推搡，將要<note caller="+" style="f"><char style="fr" closed="false">118:13 </char><char style="ft" closed="false">我被人推搡，將要——或譯作「你用力推我，要叫我」。</char></note>跌倒；</para>
  <para style="q1" vid="PSA 118:13">但是耶和華幫助我。<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />耶和華是我的力量、我的頌歌，</para>
  <para style="q1" vid="PSA 118:14">他也成了我的救恩。<verse eid="PSA 118:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />在義人的帳篷中，</para>
  <para style="q1" vid="PSA 118:15">有歡呼和稱謝<note caller="+" style="f"><char style="fr" closed="false">118:15 </char><char style="ft" closed="false">稱謝——輔助詞語。</char></note>救恩的聲音：</para>
  <para style="q1" vid="PSA 118:15">「耶和華的右手做大能的事！<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />耶和華的右手高舉，</para>
  <para style="q1" vid="PSA 118:16">耶和華的右手做大能的事！」<verse eid="PSA 118:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />我必不至於死，卻要存活，</para>
  <para style="q1" vid="PSA 118:17">並要述說耶和華的作為。<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />耶和華雖嚴厲地管教我，</para>
  <para style="q1" vid="PSA 118:18">但沒有把我交於死亡。<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />為我打開公義之門吧，</para>
  <para style="q1" vid="PSA 118:19">我要進去稱謝耶和華！<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />這是耶和華的門，</para>
  <para style="q1" vid="PSA 118:20">義人要從這門進入。<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />讓我稱謝你，</para>
  <para style="q1" vid="PSA 118:21">因為你已經回應我，</para>
  <para style="q1" vid="PSA 118:21">又成了我的救恩。<verse eid="PSA 118:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />工匠所棄絕的石頭，</para>
  <para style="q1" vid="PSA 118:22">已經成了房角的頭塊石頭。<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />這是耶和華所成就的，</para>
  <para style="q1" vid="PSA 118:23">在我們眼中看為奇妙。<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />這是耶和華所定的日子，</para>
  <para style="q1" vid="PSA 118:24">讓我們在其中快樂歡喜。<verse eid="PSA 118:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />哦，耶和華啊，</para>
  <para style="q1" vid="PSA 118:25">求你施行拯救！</para>
  <para style="q1" vid="PSA 118:25">哦，耶和華啊，</para>
  <para style="q1" vid="PSA 118:25">求你使我們興盛！<verse eid="PSA 118:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />奉耶和華的名而來的那一位，</para>
  <para style="q1" vid="PSA 118:26">是蒙祝福的！</para>
  <para style="q1" vid="PSA 118:26">我們從耶和華的殿中祝福你們。<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />耶和華是神，他照亮我們；</para>
  <para style="q1" vid="PSA 118:27">你們當用繩索捆住祭牲，</para>
  <para style="q1" vid="PSA 118:27">帶到<note caller="+" style="f"><char style="fr" closed="false">118:27 </char><char style="ft" closed="false">用繩索捆住祭牲，帶到——或譯作「拿著枝條，加入過節的行列，直到」。</char></note>壇角。<verse eid="PSA 118:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />你是我的神，我要稱謝你；</para>
  <para style="q1" vid="PSA 118:28">你是我的神，我要尊崇你。<verse eid="PSA 118:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />你們當稱謝耶和華，</para>
  <para style="q1" vid="PSA 118:29">他是美善的，他的慈愛永遠長存！<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s">我喜愛神的話語</para>
  <para style="b" />
  <para style="qa">א Alef<note caller="+" style="f"><char style="fr" closed="false">119:0 </char><char style="ft" closed="false">這首希伯來文的字母詩，每段包含八節詩句，每詩句的開頭用同一個希伯來字母，便於記誦。</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />行為純全、遵行耶和華律法的人，</para>
  <para style="q1" vid="PSA 119:1">是蒙福的！<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />謹守耶和華的法度、全心尋求他的人，</para>
  <para style="q1" vid="PSA 119:2">是蒙福的！<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />他們不做不義的事，</para>
  <para style="q1" vid="PSA 119:3">只走在他的道路上。<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />你用你的訓誡吩咐了我們，</para>
  <para style="q1" vid="PSA 119:4">為要我們竭力遵守。<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />但願我的道路被你堅立，</para>
  <para style="q1" vid="PSA 119:5">好使我遵守你的律例。<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />這樣，我注目你一切誡命時，</para>
  <para style="q1" vid="PSA 119:6">就不致蒙羞；<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />我學習你公義法規時，</para>
  <para style="q1" vid="PSA 119:7">就以正直的心稱謝你。<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />我要遵守你的律例，</para>
  <para style="q1" vid="PSA 119:8">求你不要全然離棄我！<verse eid="PSA 119:8" /></para>
  <para style="b" />
  <para style="qa">ב Bet</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />少年人如何保持自己的行為純潔呢？</para>
  <para style="q1" vid="PSA 119:9">就是要遵守你的話語！<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />我全心尋求你，</para>
  <para style="q1" vid="PSA 119:10">求你不要讓我偏離你的誡命。<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />我將你的話語珍藏在我心裡，</para>
  <para style="q1" vid="PSA 119:11">免得我對你犯罪。<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />耶和華啊，你是當受頌讚的，</para>
  <para style="q1" vid="PSA 119:12">求你將你的律例教導我！<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />我要用我的嘴唇，</para>
  <para style="q1" vid="PSA 119:13">講述你口中一切的法規。<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />我因你的法度之道而歡喜，</para>
  <para style="q1" vid="PSA 119:14">如同因一切財寶而歡喜。<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />我要默想你的訓誡，</para>
  <para style="q1" vid="PSA 119:15">注目你的路途。<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />我要以你的律例為樂，</para>
  <para style="q1" vid="PSA 119:16">我不會忘記你的話語。<verse eid="PSA 119:16" /></para>
  <para style="b" />
  <para style="qa">ג Gimel</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />求你恩待你的僕人，</para>
  <para style="q1" vid="PSA 119:17">讓我得以存活，並遵守你的話語！<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />求你開啟我的眼睛，</para>
  <para style="q1" vid="PSA 119:18">使我看出你律法中的奇妙。<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />我在地上是寄居者，</para>
  <para style="q1" vid="PSA 119:19">求你不要向我隱藏你的誡命。<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />我的靈魂因時時切慕你的法規而耗盡。<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />你斥責受詛咒的傲慢人，</para>
  <para style="q1" vid="PSA 119:21">就是偏離你誡命的人。<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />求你挪去我所受的辱罵和藐視，</para>
  <para style="q1" vid="PSA 119:22">因為我謹守你的法度。<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />即使首領們坐著說話反對我，</para>
  <para style="q1" vid="PSA 119:23">你的僕人也默想你的律例。<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />你的法度就是我的喜樂，</para>
  <para style="q1" vid="PSA 119:24">是我的謀士！<verse eid="PSA 119:24" /></para>
  <para style="b" />
  <para style="qa">ד Dalet</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />我的靈魂緊貼塵土，</para>
  <para style="q1" vid="PSA 119:25">求你照著你的話語使我存活。<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />我陳明我所行的，你就回應了我；</para>
  <para style="q1" vid="PSA 119:26">求你將你的律例教導我。<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />求你使我領悟你的訓誡之道，</para>
  <para style="q1" vid="PSA 119:27">好讓我默想你的奇妙作為。<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />我的靈魂因愁苦而消融<note caller="+" style="f"><char style="fr" closed="false">119:28 </char><char style="ft" closed="false">我的靈魂因愁苦而消融——或譯作「我因愁苦而流淚」或「我因愁苦身心耗盡」。</char></note>，</para>
  <para style="q1" vid="PSA 119:28">求你照著你的話語使我堅強起來。<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />求你使虛假之道遠離我，</para>
  <para style="q1" vid="PSA 119:29">施恩將你的律法賜給我。<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />我選擇了信實之道，</para>
  <para style="q1" vid="PSA 119:30">將你的法規擺在我面前<note caller="+" style="f"><char style="fr" closed="false">119:30 </char><char style="ft" closed="false">在我面前——輔助詞語。</char></note>。<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />我緊緊守著你的法度，</para>
  <para style="q1" vid="PSA 119:31">耶和華啊，求你不要讓我蒙羞！<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />我要在你誡命之路上奔跑，</para>
  <para style="q1" vid="PSA 119:32">因為你使我的心舒暢！<verse eid="PSA 119:32" /></para>
  <para style="b" />
  <para style="qa">ה He</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />耶和華啊，</para>
  <para style="q1" vid="PSA 119:33">求你把你律例之道指示給我，</para>
  <para style="q1" vid="PSA 119:33">好讓我謹守到底！<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />求你賜我悟性，</para>
  <para style="q1" vid="PSA 119:34">好讓我謹守你的律法，</para>
  <para style="q1" vid="PSA 119:34">全心遵守它。<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />求你使我踏上你誡命之路，</para>
  <para style="q1" vid="PSA 119:35">因為我喜悅它。<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />求你使我的心傾向你的法度，</para>
  <para style="q1" vid="PSA 119:36">而不向著私利。<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />求你使我轉眼不看虛妄的事，</para>
  <para style="q1" vid="PSA 119:37">使我在你的道路上存活。<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />求你向你的僕人成就你的話語，</para>
  <para style="q1" vid="PSA 119:38">好使人敬畏你。<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />求你除去我所害怕的辱罵，</para>
  <para style="q1" vid="PSA 119:39">因為你的法規是美好的。<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />看哪，我切慕你的訓誡，</para>
  <para style="q1" vid="PSA 119:40">求你藉著你的公義使我存活！<verse eid="PSA 119:40" /></para>
  <para style="b" />
  <para style="qa">ו Vav</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />耶和華啊，</para>
  <para style="q1" vid="PSA 119:41">願你的慈愛臨到我！</para>
  <para style="q1" vid="PSA 119:41">願你照著你的應許，</para>
  <para style="q1" vid="PSA 119:41">使你的救恩臨到我！<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />這樣，我就有話回應辱罵我的人，</para>
  <para style="q1" vid="PSA 119:42">因為我依靠你的話語。<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />求你讓真理的話語總不離開我的口，</para>
  <para style="q1" vid="PSA 119:43">因為我期盼你的法規。<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />我要一直遵守你的律法，</para>
  <para style="q1" vid="PSA 119:44">直到永永遠遠。<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />我要在寬廣之處<note caller="+" style="f"><char style="fr" closed="false">119:45 </char><char style="ft" closed="false">在寬廣之處——或譯作「自由」。</char></note>往來，</para>
  <para style="q1" vid="PSA 119:45">我必尋求你的訓誡。<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />我也要在君王們面前說出你的法度，</para>
  <para style="q1" vid="PSA 119:46">並不致蒙羞。<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />我要以你的誡命為樂，</para>
  <para style="q1" vid="PSA 119:47">它們是我所愛的。<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />我要向你的誡命舉起雙手，</para>
  <para style="q1" vid="PSA 119:48">它們是我所愛的；</para>
  <para style="q1" vid="PSA 119:48">我也要默想你的律例！<verse eid="PSA 119:48" /></para>
  <para style="b" />
  <para style="qa">ז Zayin</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />求你記念你向僕人所說的話，</para>
  <para style="q1" vid="PSA 119:49">你用這話給了我盼望。<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />這就是我在苦難中的安慰：</para>
  <para style="q1" vid="PSA 119:50">你的言語使我存活。<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />傲慢的人極力譏諷我，</para>
  <para style="q1" vid="PSA 119:51">但我沒有偏離你的律法。<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />耶和華啊，</para>
  <para style="q1" vid="PSA 119:52">我記念你從亙古以來的法規，</para>
  <para style="q1" vid="PSA 119:52">就受到安慰！<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />我因那些離棄你律法的惡人，</para>
  <para style="q1" vid="PSA 119:53">就怒火中燒。<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />在我的寄居之所，</para>
  <para style="q1" vid="PSA 119:54">你的律例是我的頌歌。<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />耶和華啊，我在夜間記念你的名，</para>
  <para style="q1" vid="PSA 119:55">並且遵守你的律法！<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />謹守你的訓誡，</para>
  <para style="q1" vid="PSA 119:56">已經成為我的一部分。<note caller="+" style="f"><char style="fr" closed="false">119:56 </char><char style="ft" closed="false">此節或譯作：這臨到我，是因為我謹守你的訓誡。</char></note><verse eid="PSA 119:56" /></para>
  <para style="b" />
  <para style="qa">ח Khet</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />耶和華是我繼業的份，</para>
  <para style="q1" vid="PSA 119:57">我說：我要遵守你的話語。<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />我一心懇求你的恩寵，</para>
  <para style="q1" vid="PSA 119:58">求你照著你的言語恩待我。<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />我思想自己的道路，</para>
  <para style="q1" vid="PSA 119:59">就將我的腳轉向你的法度。<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />我快快遵守你的誡命，</para>
  <para style="q1" vid="PSA 119:60">不會耽延。<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />惡人的繩索捆住我，</para>
  <para style="q1" vid="PSA 119:61">但我沒有忘記你的律法。<verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />我因你公義的法規，</para>
  <para style="q1" vid="PSA 119:62">半夜起來稱謝你。<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />所有敬畏你、遵守你訓誡的人，</para>
  <para style="q1" vid="PSA 119:63">都是我的同伴。<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />耶和華啊，你的慈愛充滿大地，</para>
  <para style="q1" vid="PSA 119:64">求你將你的律例教導我！<verse eid="PSA 119:64" /></para>
  <para style="b" />
  <para style="qa">ט Tet</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />耶和華啊，</para>
  <para style="q1" vid="PSA 119:65">你照著自己的話，善待了你的僕人！<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />求你教導我，使我有知識和辨識力，</para>
  <para style="q1" vid="PSA 119:66">因為我相信你的誡命。<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />在我受磨煉之前，我是迷失的；</para>
  <para style="q1" vid="PSA 119:67">而現在，我遵守你的言語。<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />你本是美善，行事美好，</para>
  <para style="q1" vid="PSA 119:68">求你將你的律例教導我。<verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />傲慢人用謊言汙衊我，</para>
  <para style="q1" vid="PSA 119:69">但我要全心謹守你的訓誡。<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />他們的心麻木如蒙脂油，</para>
  <para style="q1" vid="PSA 119:70">我卻以你的律法為樂。<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />我受磨煉使我受益，</para>
  <para style="q1" vid="PSA 119:71">好讓我學習你的律例。<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />你口中的律法對我有益，</para>
  <para style="q1" vid="PSA 119:72">勝過千萬金銀。<verse eid="PSA 119:72" /></para>
  <para style="b" />
  <para style="qa">י Yod</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />你的手造了我，又堅立我；</para>
  <para style="q1" vid="PSA 119:73">求你使我有悟性，好學習你的誡命。<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />願敬畏你的人看見我就歡喜，</para>
  <para style="q1" vid="PSA 119:74">因為我期盼你的話語。<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />耶和華啊，</para>
  <para style="q1" vid="PSA 119:75">我知道你的法規是公義的；</para>
  <para style="q1" vid="PSA 119:75">你磨煉我也是因著你的<note caller="+" style="f"><char style="fr" closed="false">119:75 </char><char style="ft" closed="false">是因著你的——輔助詞語。</char></note>信實！<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />求你照著你對僕人所說的，</para>
  <para style="q1" vid="PSA 119:76">以你的慈愛安慰我。<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />願你的憐憫臨到我，使我得以存活，</para>
  <para style="q1" vid="PSA 119:77">因為你的律法是我的喜樂。<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />願傲慢人蒙羞，</para>
  <para style="q1" vid="PSA 119:78">因為他們以虛謊屈枉我；</para>
  <para style="q1" vid="PSA 119:78">但我要默想你的訓誡。<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />願敬畏你、明白你法度的人，</para>
  <para style="q1" vid="PSA 119:79">都轉向我。<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />願我的心在你的律例中純全，</para>
  <para style="q1" vid="PSA 119:80">好使我不致蒙羞。<verse eid="PSA 119:80" /></para>
  <para style="b" />
  <para style="qa">כ Kaf</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />我的靈魂因渴望你的救恩而衰竭；</para>
  <para style="q1" vid="PSA 119:81">我期盼你的話語。<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />我的眼睛因渴望你的言語而衰竭；</para>
  <para style="q1" vid="PSA 119:82">我說：「你什麼時候才安慰我呢？」<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />雖然我像煙薰的皮囊，</para>
  <para style="q1" vid="PSA 119:83">但我沒有忘記你的律例。<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />你僕人的日子還有多少呢？</para>
  <para style="q1" vid="PSA 119:84">你什麼時候才對追逼我的人施行審判呢？<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />傲慢人為我挖了陷阱，</para>
  <para style="q1" vid="PSA 119:85">他們不照著你的律法而行。<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />你一切的誡命都信實；</para>
  <para style="q1" vid="PSA 119:86">而他們以虛謊追逼我，</para>
  <para style="q1" vid="PSA 119:86">求你幫助我！<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />他們幾乎把我從這地上除滅；</para>
  <para style="q1" vid="PSA 119:87">但我卻沒有離棄你的訓誡。<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />求你照著你的慈愛使我存活，</para>
  <para style="q1" vid="PSA 119:88">我就持守你口中的法度。<verse eid="PSA 119:88" /></para>
  <para style="b" />
  <para style="qa">ל Lamed</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />耶和華啊，你的話語設立在天，</para>
  <para style="q1" vid="PSA 119:89">直到永遠！<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />你的信實存到萬代，</para>
  <para style="q1" vid="PSA 119:90">你堅立了大地，大地就存留。<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />天地照著你的法規存到今日，</para>
  <para style="q1" vid="PSA 119:91">因為萬有都是你的僕役。<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />要不是你的律法成為我的喜樂，</para>
  <para style="q1" vid="PSA 119:92">我早就在苦難中滅亡了。<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />我永遠不會忘記你的訓誡，</para>
  <para style="q1" vid="PSA 119:93">因為你用它們使我存活。<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />我是屬於你的，求你拯救我，</para>
  <para style="q1" vid="PSA 119:94">因為我尋求你的訓誡。<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />惡人等著要消滅我；</para>
  <para style="q1" vid="PSA 119:95">但我要領悟你的法度。<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />我看見一切完美的事都有盡頭，</para>
  <para style="q1" vid="PSA 119:96">唯有你的誡命極其寬廣。<verse eid="PSA 119:96" /></para>
  <para style="b" />
  <para style="qa">מ Mem</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />我多麼愛你的律法！</para>
  <para style="q1" vid="PSA 119:97">我終日都在默想它。<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />你的誡命使我比仇敵更有智慧，</para>
  <para style="q1" vid="PSA 119:98">因為它永遠屬於我<note caller="+" style="f"><char style="fr" closed="false">119:98 </char><char style="ft" closed="false">屬於我——或譯作「與我同在」。</char></note>。<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />我比我所有的教師更明達，</para>
  <para style="q1" vid="PSA 119:99">因為我默想你的法度。<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />我比長老們更有悟性，</para>
  <para style="q1" vid="PSA 119:100">因為我謹守你的訓誡。<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />我阻止我的腳走任何邪惡的路，</para>
  <para style="q1" vid="PSA 119:101">為要遵守你的話語。<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />我沒有偏離你的法規，</para>
  <para style="q1" vid="PSA 119:102">因為你親自指示了我。<verse eid="PSA 119:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />你的言語在我的唇齒中多麼甜美！</para>
  <para style="q1" vid="PSA 119:103">在我的口中勝過蜂蜜。<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />我藉著你的訓誡而有悟性，</para>
  <para style="q1" vid="PSA 119:104">因此我恨惡一切虛謊的道。<verse eid="PSA 119:104" /></para>
  <para style="b" />
  <para style="qa">נ Nun</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />你的話是我腳前的燈，</para>
  <para style="q1" vid="PSA 119:105">是我路上的光。<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />我起了誓並且堅守，</para>
  <para style="q1" vid="PSA 119:106">要遵守你公義的法規。<verse eid="PSA 119:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />耶和華啊，我受到極大的磨煉，</para>
  <para style="q1" vid="PSA 119:107">求你照著你的話語使我存活！<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />耶和華啊，</para>
  <para style="q1" vid="PSA 119:108">求你悅納我口中的讚美<note caller="+" style="f"><char style="fr" closed="false">119:108 </char><char style="ft" closed="false">的讚美——輔助詞語。</char></note>作為甘心祭，</para>
  <para style="q1" vid="PSA 119:108">又將你的法規教導我！<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />我的性命一直在危險中<note caller="+" style="f"><char style="fr" closed="false">119:109 </char><char style="ft" closed="false">危險中——原文直譯「我的手掌中」。</char></note>，</para>
  <para style="q1" vid="PSA 119:109">但我沒有忘記你的律法。<verse eid="PSA 119:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />惡人為我設下網羅，</para>
  <para style="q1" vid="PSA 119:110">但我沒有從你的訓誡中迷失。<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />我以你的法度為繼業直到永遠，</para>
  <para style="q1" vid="PSA 119:111">因為它們是我心裡的歡樂。<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />我一心謹守你的律例，遵行到底，</para>
  <para style="q1" vid="PSA 119:112">直到永遠。<verse eid="PSA 119:112" /></para>
  <para style="b" />
  <para style="qa">ס Samek</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />我恨惡心懷二意的人，</para>
  <para style="q1" vid="PSA 119:113">但我愛你的律法。<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />你是我的藏身之處，是我的盾牌，</para>
  <para style="q1" vid="PSA 119:114">我期盼你的話語。<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />作惡者啊，遠離我吧，</para>
  <para style="q1" vid="PSA 119:115">我好謹守我神的誡命！<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />求你照著你的言語扶助我，</para>
  <para style="q1" vid="PSA 119:116">使我得以存活；</para>
  <para style="q1" vid="PSA 119:116">不要讓我因我的盼望而蒙羞。<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />求你扶持我，使我得拯救，</para>
  <para style="q1" vid="PSA 119:117">我就一直看重你的律例。<verse eid="PSA 119:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />你輕視一切偏離你律例的人，</para>
  <para style="q1" vid="PSA 119:118">因為他們的詭詐成為虛妄。<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />你把地上所有的惡人像渣滓那樣除掉，</para>
  <para style="q1" vid="PSA 119:119">因此我愛你的法度。<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />我的肉體因懼怕你而戰慄，</para>
  <para style="q1" vid="PSA 119:120">我敬畏你的法規。<verse eid="PSA 119:120" /></para>
  <para style="b" />
  <para style="qa">ע Ayin</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />我實行了公正和公義，</para>
  <para style="q1" vid="PSA 119:121">求你不要把我交給欺壓我的人。<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />求你為僕人的福份作保，</para>
  <para style="q1" vid="PSA 119:122">不要讓傲慢人欺壓我。<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />因渴望你的救恩和你公義的言語，</para>
  <para style="q1" vid="PSA 119:123">我的眼睛衰竭。<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />求你照著你的慈愛對待你的僕人，</para>
  <para style="q1" vid="PSA 119:124">將你的律例教導我。<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />我是你的僕人，求你使我有悟性，</para>
  <para style="q1" vid="PSA 119:125">好讓我明白你的法度。<verse eid="PSA 119:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />現在是耶和華行動的時候了，</para>
  <para style="q1" vid="PSA 119:126">因為他們違背了你的律法。<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />而我愛你的誡命，</para>
  <para style="q1" vid="PSA 119:127">勝過金子，勝過純金，<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />因此在一切事上，</para>
  <para style="q1" vid="PSA 119:128">你所有的訓誡，我都視為合宜；</para>
  <para style="q1" vid="PSA 119:128">我恨惡一切虛假的路。<verse eid="PSA 119:128" /></para>
  <para style="b" />
  <para style="qa">פ Pe</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />你的法度奇妙，</para>
  <para style="q1" vid="PSA 119:129">所以我的靈魂謹守它們。<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />你的話語一解開，就發出亮光，</para>
  <para style="q1" vid="PSA 119:130">使無知的人有悟性。<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />我張口喘息，</para>
  <para style="q1" vid="PSA 119:131">因我切慕你的誡命。<verse eid="PSA 119:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />求你轉向我、恩待我，</para>
  <para style="q1" vid="PSA 119:132">就像你素常對待那些愛你名的人。<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />求你用你的言語使我的腳步堅定，</para>
  <para style="q1" vid="PSA 119:133">不要讓任何壞事轄制我。<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />求你救贖我脫離人的欺壓，</para>
  <para style="q1" vid="PSA 119:134">好讓我遵守你的訓誡。<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />求你用你的臉照亮你的僕人，</para>
  <para style="q1" vid="PSA 119:135">將你的律例教導我。<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />我的眼睛淚流成河，</para>
  <para style="q1" vid="PSA 119:136">因為人們不遵守你的律法。<verse eid="PSA 119:136" /></para>
  <para style="b" />
  <para style="qa">צ Tsade</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />耶和華啊，你是公義的，</para>
  <para style="q1" vid="PSA 119:137">你的法規是正直的！<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />你以公義和極大的信實，</para>
  <para style="q1" vid="PSA 119:138">命定了你的法度。<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />我心火焚燒，</para>
  <para style="q1" vid="PSA 119:139">因為我的敵人忘記了你的話語。<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />你的言語極其精煉，</para>
  <para style="q1" vid="PSA 119:140">為你的僕人所喜愛。<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />我雖然微小，被人輕視，</para>
  <para style="q1" vid="PSA 119:141">但我沒有忘記你的訓誡。<verse eid="PSA 119:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />你的公義是永遠的公義，</para>
  <para style="q1" vid="PSA 119:142">你的律法就是真理。<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />危難和壓迫臨到我，</para>
  <para style="q1" vid="PSA 119:143">但你的誡命是我的喜樂。<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />你的法度永遠公義，</para>
  <para style="q1" vid="PSA 119:144">求你賜我悟性，好讓我得以存活。<verse eid="PSA 119:144" /></para>
  <para style="b" />
  <para style="qa">ק Qof</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />耶和華啊，我全心呼求你，</para>
  <para style="q1" vid="PSA 119:145">求你回應我！我必謹守你的律例。<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />我呼求你，求你拯救我，</para>
  <para style="q1" vid="PSA 119:146">好使我持守你的法度。<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />我在黎明前起來呼救，</para>
  <para style="q1" vid="PSA 119:147">我期盼你的話語。<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />我睜著眼等待每個更次，</para>
  <para style="q1" vid="PSA 119:148">為要默想你的言語。<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />求你照著你的慈愛垂聽我的聲音，</para>
  <para style="q1" vid="PSA 119:149">耶和華啊，</para>
  <para style="q1" vid="PSA 119:149">求你照著你的法規使我存活！<verse eid="PSA 119:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />追隨奸惡的人<note caller="+" style="f"><char style="fr" closed="false">119:150 </char><char style="ft" closed="false">追隨奸惡的人——有古抄本和古譯本作「惡意追趕我的人」。</char></note>臨近了，</para>
  <para style="q1" vid="PSA 119:150">他們遠離你的律法。<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />耶和華啊，你就在近處，</para>
  <para style="q1" vid="PSA 119:151">你一切的誡命都是真理！<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />我早就從你的法度中明白：</para>
  <para style="q1" vid="PSA 119:152">你奠定了這法度，直到永遠！<verse eid="PSA 119:152" /></para>
  <para style="b" />
  <para style="qa">ר Resh</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />求你察看我的苦難並且搭救我，</para>
  <para style="q1" vid="PSA 119:153">因為我沒有忘記你的律法。<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />求你為我辯護並且贖回我，</para>
  <para style="q1" vid="PSA 119:154">照著你的話語使我存活。<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />救恩遠離惡人，</para>
  <para style="q1" vid="PSA 119:155">因為他們不尋求你的律例。<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />耶和華啊，你的憐憫豐盛，</para>
  <para style="q1" vid="PSA 119:156">求你照著你的法規使我存活！<verse eid="PSA 119:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />追逼我、以我為敵的人有許多，</para>
  <para style="q1" vid="PSA 119:157">但我沒有偏離你的法度。<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />我看見背信者就厭惡，</para>
  <para style="q1" vid="PSA 119:158">因為他們不遵守你的話語。<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />耶和華啊，</para>
  <para style="q1" vid="PSA 119:159">看，我是多麼地愛你的訓誡！</para>
  <para style="q1" vid="PSA 119:159">求你照著你的慈愛使我存活！<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />你的每一句話都真實可信，</para>
  <para style="q1" vid="PSA 119:160">你一切公義的法規都存到永遠。<verse eid="PSA 119:160" /></para>
  <para style="b" />
  <para style="qa">שׁ Shin / שׂ Sin</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />首領們無故追逼我，</para>
  <para style="q1" vid="PSA 119:161">但我的心只畏懼你的話語。<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />我因你的言語而歡喜，</para>
  <para style="q1" vid="PSA 119:162">如同得了大量戰利品的人。<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />我恨惡並憎嫌虛假，</para>
  <para style="q1" vid="PSA 119:163">但我愛你的律法。<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />我因你公義的法規，</para>
  <para style="q1" vid="PSA 119:164">一天七次讚美你。<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />愛你律法的人大有平安，</para>
  <para style="q1" vid="PSA 119:165">沒有什麼能絆倒他們。<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />耶和華啊，我盼望你的救恩，</para>
  <para style="q1" vid="PSA 119:166">我遵行你的誡命！<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />我靈裡持守你的法度，</para>
  <para style="q1" vid="PSA 119:167">我非常愛它們。<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />我持守你的訓誡和你的法度，</para>
  <para style="q1" vid="PSA 119:168">因為我一切的道路都在你面前。<verse eid="PSA 119:168" /></para>
  <para style="b" />
  <para style="qa">ת Tav</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />耶和華啊，</para>
  <para style="q1" vid="PSA 119:169">願我的呼聲達到你面前，</para>
  <para style="q1" vid="PSA 119:169">求你照著你的話語賜我悟性！<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />願我的懇求達到你面前，</para>
  <para style="q1" vid="PSA 119:170">求你照著你的言語解救我。<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />願我的嘴唇湧出讚美，</para>
  <para style="q1" vid="PSA 119:171">因為你將你的律例教導我。<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />願我的舌頭歌唱你的言語，</para>
  <para style="q1" vid="PSA 119:172">因為你一切的誡命都是公義的。<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />願你的手成為我的幫助，</para>
  <para style="q1" vid="PSA 119:173">因為我選擇了你的訓誡。<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />耶和華啊，我切慕你的救恩，</para>
  <para style="q1" vid="PSA 119:174">你的律法是我的喜樂！<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />願我的性命得以存活，</para>
  <para style="q1" vid="PSA 119:175">得以讚美你；</para>
  <para style="q1" vid="PSA 119:175">願你的法規幫助我。<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />我如失喪的羊迷失；</para>
  <para style="q1" vid="PSA 119:176">求你尋找你的僕人，</para>
  <para style="q1" vid="PSA 119:176">因為我沒有忘記你的誡命。<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">求神解救脫離詭詐的人</para>
  <para style="b" />
  <para style="d">登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />我在患難中向耶和華呼求，</para>
  <para style="q1" vid="PSA 120:1">他就回應我。<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />耶和華啊，</para>
  <para style="q1" vid="PSA 120:2">求你解救我脫離虛謊的嘴唇和詭詐的舌頭！<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />詭詐的舌頭啊，耶和華會給你什麼呢？</para>
  <para style="q1" vid="PSA 120:3">他會加給你什麼呢？<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />會加給你勇士的利箭，</para>
  <para style="q1" vid="PSA 120:4">連同羅騰木的火炭。<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />我有禍了！因為我寄居在<char style="pn">米設</char>，</para>
  <para style="q1" vid="PSA 120:5">居住在<char style="pn">基達</char>的帳篷之間。<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />我與恨惡和平的人，一同居住太久了。<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />我要和平，</para>
  <para style="q1" vid="PSA 120:7">我只要一說話，他們就要爭戰。<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">神是子民的保護者</para>
  <para style="b" />
  <para style="d">登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />我要向群山舉目，</para>
  <para style="q1" vid="PSA 121:1">我的幫助從哪裡來？<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />我的幫助從造天地的耶和華而來！<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />他必不讓你的腳動搖；</para>
  <para style="q1" vid="PSA 121:3">保守你的必不打盹。<verse eid="PSA 121:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />看哪，保守<char style="pn">以色列</char>的，</para>
  <para style="q1" vid="PSA 121:4">既不打盹，也不睡覺！<verse eid="PSA 121:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />保守你的是耶和華，</para>
  <para style="q1" vid="PSA 121:5">他在你右邊蔭庇你。<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />白天，太陽不會傷你；</para>
  <para style="q1" vid="PSA 121:6">夜間，月亮也不會害你。<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />耶和華保守你免受一切禍患，</para>
  <para style="q1" vid="PSA 121:7">他保守你的性命。<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />你出你入，耶和華都保守你，</para>
  <para style="q1" vid="PSA 121:8">從今直到永遠！<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">為耶路撒冷求平安</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />我歡喜，因人們對我說：</para>
  <para style="q1" vid="PSA 122:1">「讓我們到耶和華的殿去吧！」<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />
    <char style="pn">耶路撒冷</char>啊，</para>
  <para style="q1" vid="PSA 122:2">我們的雙腳站在你的城門內了！<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />
    <char style="pn">耶路撒冷</char>被建造，</para>
  <para style="q1" vid="PSA 122:3">如同連為一體的城市。<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />眾支派，就是耶和華的眾支派，</para>
  <para style="q1" vid="PSA 122:4">都上那裡去——</para>
  <para style="q1" vid="PSA 122:4">這是照著<char style="pn">以色列</char>的法度，</para>
  <para style="q1" vid="PSA 122:4">為要稱頌耶和華的名；<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />因為在那裡設有公正的寶座，</para>
  <para style="q1" vid="PSA 122:5">就是<char style="pn">大衛</char>家的寶座。<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />你們當為<char style="pn">耶路撒冷</char>的平安祈求：</para>
  <para style="q1" vid="PSA 122:6">「願那些愛你的人安穩！<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />願你的城垣裡有平安！</para>
  <para style="q1" vid="PSA 122:7">願你的城堡中有安穩！」<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />為我弟兄和朋友們的緣故，</para>
  <para style="q1" vid="PSA 122:8">我要說：「願你裡面有平安！」<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />為了我們神耶和華的殿，</para>
  <para style="q1" vid="PSA 122:9">我要為你求福份。<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">仰望神的恩待</para>
  <para style="b" />
  <para style="d">登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />在天上坐著為王的那一位啊，</para>
  <para style="q1" vid="PSA 123:1">我要向你舉目！<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />看哪，</para>
  <para style="q1" vid="PSA 123:2">僕人的眼睛怎樣望著主人的手，</para>
  <para style="q1" vid="PSA 123:2">婢女的眼睛怎樣望著主母的手，</para>
  <para style="q1" vid="PSA 123:2">我們的眼睛也照樣望著耶和華我們的神，</para>
  <para style="q1" vid="PSA 123:2">直到他恩待我們。<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />耶和華啊，求你恩待我們，</para>
  <para style="q1" vid="PSA 123:3">求你恩待我們！</para>
  <para style="q1" vid="PSA 123:3">因為我們實在受盡了藐視——<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />安逸人的嘲笑和高慢人的藐視，</para>
  <para style="q1" vid="PSA 123:4">我們實在受盡了。<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s">我們的幫助在於神</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />願<char style="pn">以色列</char>說：</para>
  <para style="q1" vid="PSA 124:1">「要不是耶和華在我們這邊，<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />要不是耶和華在我們這邊，</para>
  <para style="q1" vid="PSA 124:2">那麼，人們起來攻擊我們時，<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />他們的怒氣向我們發作時，</para>
  <para style="q1" vid="PSA 124:3">他們早就活活吞掉了我們——<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />眾水漫過我們，急流淹沒我們，<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />狂傲的眾水早就淹沒我們了！」<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />耶和華是當受頌讚的，</para>
  <para style="q1" vid="PSA 124:6">他沒有把我們交出，</para>
  <para style="q1" vid="PSA 124:6">成為他們牙齒下的獵物。<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />我們像雀鳥從設網人的網羅中逃出；</para>
  <para style="q1" vid="PSA 124:7">那網羅被撕裂，我們就逃脫了！<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />我們的幫助在於造天地之耶和華的名！<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">依靠神的必不動搖</para>
  <para style="b" />
  <para style="d">登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />依靠耶和華的人，就像<char style="pn">錫安</char>山，</para>
  <para style="q1" vid="PSA 125:1">不致動搖，永遠屹立。<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />群山怎樣環繞<char style="pn">耶路撒冷</char>，</para>
  <para style="q1" vid="PSA 125:2">耶和華也怎樣環繞他的子民，</para>
  <para style="q1" vid="PSA 125:2">從今直到永遠！<verse eid="PSA 125:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />惡人的杖不能留在義人所分得的土地上，</para>
  <para style="q1" vid="PSA 125:3">免得義人把手伸進不義。<verse eid="PSA 125:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />耶和華啊，求你善待好人，</para>
  <para style="q1" vid="PSA 125:4">善待心裡正直的人！<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />至於那些偏行歪路的人，</para>
  <para style="q1" vid="PSA 125:5">耶和華必把他們與作惡的人一同除去。</para>
  <para style="b" vid="PSA 125:5" />
  <para style="q1" vid="PSA 125:5">願平安臨到<char style="pn">以色列</char>！<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">回歸者的歡樂</para>
  <para style="b" />
  <para style="d">登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />耶和華使<char style="pn">錫安</char>的擄民回歸<note caller="+" style="f"><char style="fr" closed="false">126:1 </char><char style="ft" closed="false">使錫安的擄民回歸——或譯作「復興錫安的家業」。</char></note>時，</para>
  <para style="q1" vid="PSA 126:1">我們就像是在做夢。<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />那時我們的口充滿歡笑，</para>
  <para style="q1" vid="PSA 126:2">我們的舌頭充滿歡呼；</para>
  <para style="q1" vid="PSA 126:2">人們在列國中說：</para>
  <para style="q1" vid="PSA 126:2">「耶和華為他們行了大事！」<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />耶和華為我們行了大事，</para>
  <para style="q1" vid="PSA 126:3">我們就歡喜。<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />耶和華啊，</para>
  <para style="q1" vid="PSA 126:4">求你使我們的擄民回歸<note caller="+" style="f"><char style="fr" closed="false">126:4 </char><char style="ft" closed="false">使我們的擄民回歸——或譯作「復興我們的家業」。</char></note>，</para>
  <para style="q1" vid="PSA 126:4">好像南地<note caller="+" style="f"><char style="fr" closed="false">126:4 </char><char style="ft" closed="false">南地——音譯作「內蓋夫」。</char></note>的水回流<note caller="+" style="f"><char style="fr" closed="false">126:4 </char><char style="ft" closed="false">回流——輔助詞語。</char></note>！<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />流淚撒種的，</para>
  <para style="q1" vid="PSA 126:5">必歡呼收割。<verse eid="PSA 126:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />那扛著種子、流著淚出去的，</para>
  <para style="q1" vid="PSA 126:6">必定扛著禾捆，歡呼著回來。<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s">耶和華的賞賜</para>
  <para style="b" />
  <para style="d">
    <char style="pn">所羅門</char>的登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />如果不是耶和華建造房屋，</para>
  <para style="q1" vid="PSA 127:1">建造的人就枉然勞苦；</para>
  <para style="q1" vid="PSA 127:1">如果不是耶和華看守城池，</para>
  <para style="q1" vid="PSA 127:1">看守的人就枉然警醒。<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />你們早早起來，遲遲安歇，</para>
  <para style="q1" vid="PSA 127:2">吃勞苦得來的飯，也是枉然；</para>
  <para style="q1" vid="PSA 127:2">要知道，</para>
  <para style="q1" vid="PSA 127:2">耶和華必使他所愛的人安睡。<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />看哪，兒女是耶和華所賜的繼業，</para>
  <para style="q1" vid="PSA 127:3">腹中的胎兒就是賞報！<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />年輕時所生的兒女，</para>
  <para style="q1" vid="PSA 127:4">好像勇士手中的箭矢。<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />箭袋滿滿的人，是蒙福的！</para>
  <para style="q1" vid="PSA 127:5">他們即使在城門口與仇敵說話，</para>
  <para style="q1" vid="PSA 127:5">也不致蒙羞。<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s">蒙福的家</para>
  <para style="b" />
  <para style="d">登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />所有敬畏耶和華、走在他道路上的人，</para>
  <para style="q1" vid="PSA 128:1">都是蒙福的！<verse eid="PSA 128:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />你必然吃到你手辛苦得來的，</para>
  <para style="q1" vid="PSA 128:2">你必蒙福，事事順利！<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />你的妻子在你的內室，</para>
  <para style="q1" vid="PSA 128:3">如同多結果實的葡萄樹；</para>
  <para style="q1" vid="PSA 128:3">你的兒女圍繞你的桌子，</para>
  <para style="q1" vid="PSA 128:3">如同橄欖樹的幼苗。<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />看哪，敬畏耶和華的人</para>
  <para style="q1" vid="PSA 128:4">必蒙這樣的祝福！<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />願耶和華從<char style="pn">錫安</char>祝福你！</para>
  <para style="q1" vid="PSA 128:5">願你一生一世都看到<char style="pn">耶路撒冷</char>的美福！<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />願你看到你兒女的兒女，</para>
  <para style="q1" vid="PSA 128:6">願平安臨到<char style="pn">以色列</char>！<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s">求神報應惡人</para>
  <para style="b" />
  <para style="d">登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />願<char style="pn">以色列</char>說：</para>
  <para style="q1" vid="PSA 129:1">「從我年幼以來，他們就多次苦害我——<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />從我年幼以來，他們就多次苦害我，</para>
  <para style="q1" vid="PSA 129:2">但他們沒有勝過我。<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />他們如同犁地的人在我背上犁，</para>
  <para style="q1" vid="PSA 129:3">犁出長長的溝。<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />耶和華是公義的，</para>
  <para style="q1" vid="PSA 129:4">他砍斷了惡人的繩索！」<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />願所有恨惡<char style="pn">錫安</char>的人，</para>
  <para style="q1" vid="PSA 129:5">都蒙羞後退。<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />願他們像屋頂上的草，</para>
  <para style="q1" vid="PSA 129:6">尚未長大就枯乾——<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />收割的填不滿自己的手，</para>
  <para style="q1" vid="PSA 129:7">捆禾的填不滿自己的懷；<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />連過路的也不會說：</para>
  <para style="q1" vid="PSA 129:8">「願耶和華的祝福臨到你們；</para>
  <para style="q1" vid="PSA 129:8">我們奉耶和華的名祝福你們。」<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s">等候神的赦免救贖</para>
  <para style="b" />
  <para style="d">登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />耶和華啊，我從深處呼求你！<verse eid="PSA 130:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2" />主啊，求你垂聽我的聲音，</para>
  <para style="q1" vid="PSA 130:2">願你側耳聽我懇求的聲音！<verse eid="PSA 130:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />主耶和華啊，</para>
  <para style="q1" vid="PSA 130:3">如果你監察罪孽，</para>
  <para style="q1" vid="PSA 130:3">誰能站立得住呢？<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />然而赦免在於你，</para>
  <para style="q1" vid="PSA 130:4">好使人敬畏你。<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />我等候耶和華——</para>
  <para style="q1" vid="PSA 130:5">我的靈魂等候，</para>
  <para style="q1" vid="PSA 130:5">我期盼他的話語；<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />我的靈魂期盼主，</para>
  <para style="q1" vid="PSA 130:6">勝過守夜的人期盼清晨，</para>
  <para style="q1" vid="PSA 130:6">勝過守夜的人期盼清晨！<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />
    <char style="pn">以色列</char>啊，你當期盼耶和華，</para>
  <para style="q1" vid="PSA 130:7">因為慈愛在於耶和華，</para>
  <para style="q1" vid="PSA 130:7">豐盛的救贖也在於他！<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />他必救贖<char style="pn">以色列</char>脫離一切的罪孽。<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s">安穩在神的懷中</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />耶和華啊，我的心不自高，</para>
  <para style="q1" vid="PSA 131:1">我的眼也不高傲！</para>
  <para style="q1" vid="PSA 131:1">那些對於我過大和測不透的事，</para>
  <para style="q1" vid="PSA 131:1">我都不涉及。<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />我必要讓我的靈魂平穩安靜，</para>
  <para style="q1" vid="PSA 131:2">如同斷奶的孩子在自己母親的懷中<note caller="+" style="f"><char style="fr" closed="false">131:2 </char><char style="ft" closed="false">的懷中——輔助詞語。</char></note>；</para>
  <para style="q1" vid="PSA 131:2">我的靈魂在我裡面，</para>
  <para style="q1" vid="PSA 131:2">如同斷奶的孩子。<verse eid="PSA 131:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />
    <char style="pn">以色列</char>啊，你當期盼耶和華，</para>
  <para style="q1" vid="PSA 131:3">從今直到永遠！<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s">耶和華揀選了錫安</para>
  <para style="b" />
  <para style="d">登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />耶和華啊，求你因<char style="pn">大衛</char>的緣故，</para>
  <para style="q1" vid="PSA 132:1">記住他所受的一切苦待！<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />他曾如此向耶和華起誓，</para>
  <para style="q1" vid="PSA 132:2">向<char style="pn">雅各</char>的大能者許願：<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />「我絕不進我的居所帳篷，</para>
  <para style="q1" vid="PSA 132:3">也不上我的寢具床榻，<verse eid="PSA 132:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4" />絕不讓我的眼睛睡覺，</para>
  <para style="q1" vid="PSA 132:4">也不讓我的眼簾打盹——<verse eid="PSA 132:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5" />直到我為耶和華找到住處，</para>
  <para style="q1" vid="PSA 132:5">為<char style="pn">雅各</char>的大能者找到居所。」<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />看哪，</para>
  <para style="q1" vid="PSA 132:6">我們在<char style="pn">以法他</char><note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="ft" closed="false">以法他——就是伯利恆。</char></note>聽到約櫃的消息，</para>
  <para style="q1" vid="PSA 132:6">我們在<char style="pn">雅爾</char>的田野<note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="ft" closed="false">雅爾的田野——指基列耶琳。</char></note>中找到了它！<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />我們要來到耶和華的居所，</para>
  <para style="q1" vid="PSA 132:7">在他的腳凳前下拜。<verse eid="PSA 132:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />耶和華啊，求你起來，</para>
  <para style="q1" vid="PSA 132:8">與你大能的約櫃同入安息之所！<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />願你的祭司們披上公義，</para>
  <para style="q1" vid="PSA 132:9">願你的忠信者歡呼。<verse eid="PSA 132:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />求你因你僕人<char style="pn">大衛</char>的緣故，</para>
  <para style="q1" vid="PSA 132:10">不要回絕你的受膏者。<verse eid="PSA 132:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />耶和華以信實向<char style="pn">大衛</char>起了誓，</para>
  <para style="q1" vid="PSA 132:11">必不收回，他說：</para>
  <para style="q1" vid="PSA 132:11">「我將從你親生的後裔中，</para>
  <para style="q1" vid="PSA 132:11">立一位坐在你的寶座上。<verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />如果你的子孫遵守我的約，</para>
  <para style="q1" vid="PSA 132:12">以及我所教導他們的法度，</para>
  <para style="q1" vid="PSA 132:12">他們的子孫也必坐在你的寶座上，</para>
  <para style="q1" vid="PSA 132:12">直到永遠。」<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />因為耶和華選擇了<char style="pn">錫安</char>，</para>
  <para style="q1" vid="PSA 132:13">選定她作自己居住的地方：<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />「這是我永遠的安息之所；</para>
  <para style="q1" vid="PSA 132:14">我要住在這裡，因為我選定了<char style="pn">錫安</char>。<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />我要大大祝福<char style="pn">錫安</char><note caller="+" style="f"><char style="fr" closed="false">132:15 </char><char style="ft" closed="false">錫安——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PSA 132:15">使她的食物豐足，</para>
  <para style="q1" vid="PSA 132:15">使其中的窮人飽享糧食。<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />我要使她的祭司們披上救恩，</para>
  <para style="q1" vid="PSA 132:16">使她的忠信者大大歡呼。<verse eid="PSA 132:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />在那裡，</para>
  <para style="q1" vid="PSA 132:17">我要使一個角為<char style="pn">大衛</char>長出來，</para>
  <para style="q1" vid="PSA 132:17">為我的受膏者擺好燈盞。<verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />我必使他的仇敵披上恥辱；</para>
  <para style="q1" vid="PSA 132:18">而他的冠冕必在他頭上發光。」<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s">弟兄合一</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />看哪，弟兄們合一居住，</para>
  <para style="q1" vid="PSA 133:1">是多麼美善，多麼美好！<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />這就像澆在<char style="pn">亞倫</char>頭上貴重的膏油，</para>
  <para style="q1" vid="PSA 133:2">流到他的鬍鬚，又流到他的衣襟；<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />又像<char style="pn">黑門</char>的甘露降在<char style="pn">錫安</char>的眾山上，</para>
  <para style="q1" vid="PSA 133:3">因為在那裡，耶和華命定了祝福，</para>
  <para style="q1" vid="PSA 133:3">就是永遠的生命。<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s">夜間的頌讚</para>
  <para style="b" />
  <para style="d">登階之歌。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />看哪，你們當頌讚耶和華！</para>
  <para style="q1" vid="PSA 134:1">耶和華所有的僕人哪，</para>
  <para style="q1" vid="PSA 134:1">夜間站在耶和華殿中的人哪，<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />你們當向聖所舉起雙手，</para>
  <para style="q1" vid="PSA 134:2">頌讚耶和華！<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />願造天地的耶和華，</para>
  <para style="q1" vid="PSA 134:3">從<char style="pn">錫安</char>祝福你們！<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s">頌讚神的揀選</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />哈利路亞！</para>
  <para style="q1" vid="PSA 135:1">你們當讚美耶和華的名！</para>
  <para style="q1" vid="PSA 135:1">耶和華的僕人們哪，你們當讚美他！<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />那些站在耶和華的殿中，</para>
  <para style="q1" vid="PSA 135:2">站在我們神殿的院宇裡的，<verse eid="PSA 135:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />你們當讚美耶和華，</para>
  <para style="q1" vid="PSA 135:3">因為耶和華是美善的！</para>
  <para style="q1" vid="PSA 135:3">你們當歌頌他的名，</para>
  <para style="q1" vid="PSA 135:3">因為這是美好的，<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />又因為耶和華揀選了<char style="pn">雅各</char>歸於自己，</para>
  <para style="q1" vid="PSA 135:4">揀選了<char style="pn">以色列</char>作他珍貴的產業。<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />是的，我知道耶和華偉大，</para>
  <para style="q1" vid="PSA 135:5">我們的主超過一切神明。<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />在諸天、在大地、</para>
  <para style="q1" vid="PSA 135:6">在海洋和一切的深處，</para>
  <para style="q1" vid="PSA 135:6">耶和華完全照自己的意願行事。<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />他使雲霧從地極上騰，</para>
  <para style="q1" vid="PSA 135:7">使閃電隨雨水而發，</para>
  <para style="q1" vid="PSA 135:7">又使風從他的庫房而出。<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />他把<char style="pn">埃及</char>頭生的，</para>
  <para style="q1" vid="PSA 135:8">無論人或牲畜，都擊殺了。<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />
    <char style="pn">埃及</char>啊，他在你那裡降下神蹟奇事，</para>
  <para style="q1" vid="PSA 135:9">落在法老和他所有的臣僕身上。<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />他擊敗許多的國家，</para>
  <para style="q1" vid="PSA 135:10">殺戮強盛的君王們，<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />就是<char style="pn">亞摩利</char>王<char style="pn">西宏</char>、<char style="pn">巴珊</char>王<char style="pn">歐革</char>，</para>
  <para style="q1" vid="PSA 135:11">以及<char style="pn">迦南</char>所有國家的王；<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />並且他把他們的土地作為繼業賜下，</para>
  <para style="q1" vid="PSA 135:12">就是給他子民<char style="pn">以色列</char>的繼業。<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />耶和華啊，你的名存到永遠！</para>
  <para style="q1" vid="PSA 135:13">耶和華啊，你的名號存到萬代！<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />因為耶和華為他的子民伸冤，</para>
  <para style="q1" vid="PSA 135:14">向他的僕人們施憐憫。<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />列國的偶像是銀的、金的，</para>
  <para style="q1" vid="PSA 135:15">是人手所造的：<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />它們有嘴卻不能說，</para>
  <para style="q1" vid="PSA 135:16">有眼卻不能看；<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />有耳卻不能聽，</para>
  <para style="q1" vid="PSA 135:17">口中也沒有氣息；<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />那些造它們的、所有依靠它們的，</para>
  <para style="q1" vid="PSA 135:18">都會像它們那樣。<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />
    <char style="pn">以色列</char>家啊，當頌讚耶和華！</para>
  <para style="q1" vid="PSA 135:19">
    <char style="pn">亞倫</char>家啊，當頌讚耶和華！<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />
    <char style="pn">利未</char>家啊，當頌讚耶和華！</para>
  <para style="q1" vid="PSA 135:20">敬畏耶和華的人哪，當頌讚耶和華！<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />從<char style="pn">錫安</char>來的耶和華，</para>
  <para style="q1" vid="PSA 135:21">就是安居在<char style="pn">耶路撒冷</char>的那一位，</para>
  <para style="q1" vid="PSA 135:21">是當受頌讚的！</para>
  <para style="q1" vid="PSA 135:21">哈利路亞！<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s">他的慈愛永遠長存</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />你們當稱謝耶和華，</para>
  <para style="q1" vid="PSA 136:1">他是美善的，</para>
  <para style="q1" vid="PSA 136:1">他的慈愛永遠長存！<verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />你們當稱謝萬神之神，</para>
  <para style="q1" vid="PSA 136:2">他的慈愛永遠長存！<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />你們當稱謝萬主之主，</para>
  <para style="q1" vid="PSA 136:3">他的慈愛永遠長存！<verse eid="PSA 136:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />當稱謝那獨自施行大奇事的，</para>
  <para style="q1" vid="PSA 136:4">他的慈愛永遠長存！<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />當稱謝那藉著聰慧造了諸天的，</para>
  <para style="q1" vid="PSA 136:5">他的慈愛永遠長存！<verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />當稱謝那把大地鋪在眾水之上的，</para>
  <para style="q1" vid="PSA 136:6">他的慈愛永遠長存！<verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />當稱謝那造了大光的，</para>
  <para style="q1" vid="PSA 136:7">他的慈愛永遠長存！<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />他讓太陽管白晝，</para>
  <para style="q1" vid="PSA 136:8">他的慈愛永遠長存！<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />他讓月亮和星辰管黑夜，</para>
  <para style="q1" vid="PSA 136:9">他的慈愛永遠長存！<verse eid="PSA 136:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />當稱謝那擊殺<char style="pn">埃及</char>頭生的，</para>
  <para style="q1" vid="PSA 136:10">他的慈愛永遠長存！<verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />他把<char style="pn">以色列</char>從他們中間領出來，</para>
  <para style="q1" vid="PSA 136:11">他的慈愛永遠長存！<verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />就是用他大能的手和伸出的膀臂，</para>
  <para style="q1" vid="PSA 136:12">他的慈愛永遠長存！<verse eid="PSA 136:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />當稱謝那把<char style="pn">紅海</char>分為兩邊的，</para>
  <para style="q1" vid="PSA 136:13">他的慈愛永遠長存！<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />他使<char style="pn">以色列</char>從其中經過，</para>
  <para style="q1" vid="PSA 136:14">他的慈愛永遠長存！<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />卻把法老和他的軍隊抖落在<char style="pn">紅海</char>中，</para>
  <para style="q1" vid="PSA 136:15">他的慈愛永遠長存！<verse eid="PSA 136:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />當稱謝那帶領自己的子民走過曠野的，</para>
  <para style="q1" vid="PSA 136:16">他的慈愛永遠長存！<verse eid="PSA 136:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />當稱謝那擊殺大君王的，</para>
  <para style="q1" vid="PSA 136:17">他的慈愛永遠長存！<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />他殺戮強盛的君王們，</para>
  <para style="q1" vid="PSA 136:18">他的慈愛永遠長存！<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />他殺了<char style="pn">亞摩利</char>王<char style="pn">西宏</char>，</para>
  <para style="q1" vid="PSA 136:19">他的慈愛永遠長存！<verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />他也殺了<char style="pn">巴珊</char>王<char style="pn">歐革</char>，</para>
  <para style="q1" vid="PSA 136:20">他的慈愛永遠長存！<verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />他把他們的土地作為繼業賜下，</para>
  <para style="q1" vid="PSA 136:21">他的慈愛永遠長存！<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />就是賜給他僕人<char style="pn">以色列</char>的繼業，</para>
  <para style="q1" vid="PSA 136:22">他的慈愛永遠長存！<verse eid="PSA 136:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />他在我們卑微的時候記念我們，</para>
  <para style="q1" vid="PSA 136:23">他的慈愛永遠長存！<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />他救拔我們脫離敵人，</para>
  <para style="q1" vid="PSA 136:24">他的慈愛永遠長存！<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />他賜糧食給一切有血肉的，</para>
  <para style="q1" vid="PSA 136:25">他的慈愛永遠長存！<verse eid="PSA 136:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />你們當稱謝天上的神，</para>
  <para style="q1" vid="PSA 136:26">他的慈愛永遠長存！<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s">被擄的哀歌</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />在<char style="pn">巴比倫</char>河邊，我們坐在那裡，</para>
  <para style="q1" vid="PSA 137:1">想起<char style="pn">錫安</char>的時候，就哭了。<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />在那裡的柳樹林中，</para>
  <para style="q1" vid="PSA 137:2">我們掛起我們的豎琴；<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />因為在那裡，擄走我們的要我們唱歌，</para>
  <para style="q1" vid="PSA 137:3">苦害我們的要我們作樂，說：</para>
  <para style="q1" vid="PSA 137:3">「給我們唱一首<char style="pn">錫安</char>的歌吧！」<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />在外邦的土地上，</para>
  <para style="q1" vid="PSA 137:4">我們怎能唱耶和華的歌呢？<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />
    <char style="pn">耶路撒冷</char>啊，如果我忘記你，</para>
  <para style="q1" vid="PSA 137:5">願我的右手忘記技巧<note caller="+" style="f"><char style="fr" closed="false">137:5 </char><char style="ft" closed="false">技巧——輔助詞語。</char></note>！<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />如果我不記念你，</para>
  <para style="q1" vid="PSA 137:6">如果我不將<char style="pn">耶路撒冷</char>置於我最高的喜樂之上，</para>
  <para style="q1" vid="PSA 137:6">情願我的舌頭緊貼著上顎！<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />耶和華啊，</para>
  <para style="q1" vid="PSA 137:7">求你記住<char style="pn">耶路撒冷</char>遭難<note caller="+" style="f"><char style="fr" closed="false">137:7 </char><char style="ft" closed="false">遭難——輔助詞語。</char></note>的日子，</para>
  <para style="q1" vid="PSA 137:7">
    <char style="pn">以東</char>的子孫說過：</para>
  <para style="q1" vid="PSA 137:7">「拆光！拆光！直到她的根基！」<verse eid="PSA 137:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />將被摧毀的<char style="pn">巴比倫</char>城<note caller="+" style="f"><char style="fr" closed="false">137:8 </char><char style="ft" closed="false">城——原文直譯「女兒」。</char></note>啊，</para>
  <para style="q1" vid="PSA 137:8">照著你向我們所做的去報應你的，</para>
  <para style="q1" vid="PSA 137:8">那人是蒙福的！<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />抓住你的幼童往岩石上摔的，</para>
  <para style="q1" vid="PSA 137:9">那人是蒙福的！<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s">稱謝神的慈愛</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">138:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />我要全心稱謝你，</para>
  <para style="q1" vid="PSA 138:1">在眾神明面前歌頌你！<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />我要向你的聖殿下拜，</para>
  <para style="q1" vid="PSA 138:2">要因你的慈愛和信實稱頌你的名，</para>
  <para style="q1" vid="PSA 138:2">因為你使你的名和你的話顯為大，</para>
  <para style="q1" vid="PSA 138:2">超過一切。<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />在我呼求的日子，你回應了我，</para>
  <para style="q1" vid="PSA 138:3">使我靈裡力量剛強。<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />耶和華啊，</para>
  <para style="q1" vid="PSA 138:4">地上所有的君王都要稱謝你，</para>
  <para style="q1" vid="PSA 138:4">因為他們聽見了你口中的言語！<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />願他們歌唱耶和華的作為，</para>
  <para style="q1" vid="PSA 138:5">因為耶和華的榮耀偉大。<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />耶和華雖然是至高的，</para>
  <para style="q1" vid="PSA 138:6">卻看顧卑微的人；</para>
  <para style="q1" vid="PSA 138:6">他從遠處就認出高傲的人。<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />即使我行走在患難當中，</para>
  <para style="q1" vid="PSA 138:7">你也能使我存活；</para>
  <para style="q1" vid="PSA 138:7">你伸手對付我仇敵的怒氣，</para>
  <para style="q1" vid="PSA 138:7">你的右手必拯救我。<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />耶和華必成全關乎我的事。</para>
  <para style="b" vid="PSA 138:8" />
  <para style="q1" vid="PSA 138:8">耶和華啊，你的慈愛永遠長存；</para>
  <para style="q1" vid="PSA 138:8">求你不要放棄你手所造的！<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s">全知全在的神</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />耶和華啊，你已經洞察我，</para>
  <para style="q1" vid="PSA 139:1">認識我！<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />我坐下、我起來，你都知道；</para>
  <para style="q1" vid="PSA 139:2">你從遠方就知道我的意念。<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />我行路、我躺臥，你都細察；</para>
  <para style="q1" vid="PSA 139:3">你熟悉我的一切道路。<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />耶和華啊，我舌頭上的言語還沒有說，</para>
  <para style="q1" vid="PSA 139:4">看哪，你已經完全知道了！<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />你前後圍繞我，</para>
  <para style="q1" vid="PSA 139:5">把你的手按在我身上。<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />這知識對我過於奇妙，</para>
  <para style="q1" vid="PSA 139:6">過於高深，我不能達到。<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />我往哪裡去，逃避你的靈呢？</para>
  <para style="q1" vid="PSA 139:7">我往哪裡逃，躲避你的面呢？<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />如果我升到天上，你在那裡；</para>
  <para style="q1" vid="PSA 139:8">如果我躺在陰間，看哪，你也在那裡！<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />如果我揚起黎明的翅膀，</para>
  <para style="q1" vid="PSA 139:9">安居在海洋的盡頭，<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />縱然在那裡，你的手仍引導我，</para>
  <para style="q1" vid="PSA 139:10">你的右手也抓緊我。<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />就算我說：「黑暗必然覆蓋我，</para>
  <para style="q1" vid="PSA 139:11">我周圍的亮光也必變為黑夜」，<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />但對你來說，黑暗也不是黑暗，</para>
  <para style="q1" vid="PSA 139:12">黑夜如同白晝一樣明亮，</para>
  <para style="q1" vid="PSA 139:12">黑暗就像光明一樣。<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />是你創造了我的肺腑，</para>
  <para style="q1" vid="PSA 139:13">在我母腹中編織了我。<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />我要稱謝你，因為我受造<note caller="+" style="f"><char style="fr" closed="false">139:14 </char><char style="ft" closed="false">受造——輔助詞語。</char></note>奇妙可畏；</para>
  <para style="q1" vid="PSA 139:14">你所做的奇妙，我的靈魂深深知道。<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />當我在隱祕處受造、</para>
  <para style="q1" vid="PSA 139:15">在大地的深處<note caller="+" style="f"><char style="fr" closed="false">139:15 </char><char style="ft" closed="false">大地的深處——指母腹中。</char></note>被織成時，</para>
  <para style="q1" vid="PSA 139:15">我的形體不能向你隱藏。<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />我未成形的身體，你的眼睛早已看見；</para>
  <para style="q1" vid="PSA 139:16">你為我所定的日子，連一天也還沒有過，</para>
  <para style="q1" vid="PSA 139:16">就全都記在你的冊子上了。<verse eid="PSA 139:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />神哪，你的意念對我是多麼寶貴<note caller="+" style="f"><char style="fr" closed="false">139:17 </char><char style="ft" closed="false">寶貴——或譯作「深奧」。</char></note>，</para>
  <para style="q1" vid="PSA 139:17">其數目又何等多！<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />如果我數算，它們比海沙更多；</para>
  <para style="q1" vid="PSA 139:18">我醒來時，我還是與你同在！<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />神哪，但願你殺掉惡人！</para>
  <para style="q1" vid="PSA 139:19">殺人流血的人哪，你們遠離我吧！<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />他們對你說詭詐的話，</para>
  <para style="q1" vid="PSA 139:20">你的敵人妄稱你的名。<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />耶和華啊，</para>
  <para style="q1" vid="PSA 139:21">難道我不恨那些恨你的人嗎？</para>
  <para style="q1" vid="PSA 139:21">難道我不厭惡那些起來敵對你的人嗎？<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />我恨惡他們到極點，</para>
  <para style="q1" vid="PSA 139:22">我以他們為仇敵。<verse eid="PSA 139:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />神哪，求你洞察我，明白我的內心；</para>
  <para style="q1" vid="PSA 139:23">求你察驗我，明白我的思慮。<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />求你察看我有沒有讓你痛心的行為<note caller="+" style="f"><char style="fr" closed="false">139:24 </char><char style="ft" closed="false">讓你痛心的行為——或譯作「拜偶像的行為」。</char></note>，</para>
  <para style="q1" vid="PSA 139:24">引導我走永生的道路。<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s">求神搭救脫離惡人</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩，給樂隊指揮。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />耶和華啊，求你搭救我脫離惡人，</para>
  <para style="q1" vid="PSA 140:1">守護我脫離殘暴的人，<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />他們心裡謀算惡事，</para>
  <para style="q1" vid="PSA 140:2">每天都要挑起爭戰。<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />他們使自己的舌頭尖銳如蛇，</para>
  <para style="q1" vid="PSA 140:3">他們的嘴唇下有蝮蛇的毒液。<char style="qs">細拉</char><verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />耶和華啊，求你保守我脫離惡人的手，</para>
  <para style="q1" vid="PSA 140:4">守護我脫離殘暴的人，</para>
  <para style="q1" vid="PSA 140:4">他們謀算要推倒我。<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />傲慢者為我暗設網羅和繩索，</para>
  <para style="q1" vid="PSA 140:5">他們在路旁張開網，為我設下陷阱。<char style="qs">細拉</char><verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />我對耶和華說：「你是我的神。」</para>
  <para style="q1" vid="PSA 140:6">耶和華啊，求你傾聽我懇求的聲音！<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />主耶和華，我救恩的力量啊，</para>
  <para style="q1" vid="PSA 140:7">在爭戰的日子裡，你遮護了我的頭！<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />耶和華啊，求你不容惡人的願望實現，</para>
  <para style="q1" vid="PSA 140:8">不讓他們的謀劃成功，</para>
  <para style="q1" vid="PSA 140:8">免得<note caller="+" style="f"><char style="fr" closed="false">140:8 </char><char style="ft" closed="false">免得——輔助詞語。</char></note>他們高舉自己！<char style="qs">細拉</char><verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />至於那些圍困我的人，</para>
  <para style="q1" vid="PSA 140:9">願他們嘴唇的禍患遮蓋自己的頭；<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />願火炭落在他們身上，</para>
  <para style="q1" vid="PSA 140:10">願他們被扔進烈火中、</para>
  <para style="q1" vid="PSA 140:10">被拋進深坑裡，不能起來！<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />願誹謗者在地上不能堅立，</para>
  <para style="q1" vid="PSA 140:11">願惡事速速獵取殘暴的人！<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />我知道耶和華為困苦人施行判決，</para>
  <para style="q1" vid="PSA 140:12">也為貧窮人施行公正。<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />義人必然稱頌你的名，</para>
  <para style="q1" vid="PSA 140:13">正直人必居住在你面前。<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s">求神幫助遠離罪惡</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />耶和華啊，我呼求你，</para>
  <para style="q1" vid="PSA 141:1">求你快快到我這裡！</para>
  <para style="q1" vid="PSA 141:1">我向你呼求的時候，求你傾聽我的聲音。<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />願我的禱告如香呈獻在你面前；</para>
  <para style="q1" vid="PSA 141:2">願我的雙手舉起如獻晚祭。<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />耶和華啊，</para>
  <para style="q1" vid="PSA 141:3">求你為我的口設立看守，</para>
  <para style="q1" vid="PSA 141:3">守護我嘴唇的門！<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />不要讓我的心偏向惡事，</para>
  <para style="q1" vid="PSA 141:4">以致我與作惡的人一同行惡；</para>
  <para style="q1" vid="PSA 141:4">也不要讓我吃他們的美食。<verse eid="PSA 141:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />情願義人責打我，這是慈愛；</para>
  <para style="q1" vid="PSA 141:5">情願義人責備我，這是頭上的膏油，</para>
  <para style="q1" vid="PSA 141:5">我的頭並不拒絕！</para>
  <para style="q1" vid="PSA 141:5">要知道，我的禱告始終敵對惡人<note caller="+" style="f"><char style="fr" closed="false">141:5 </char><char style="ft" closed="false">惡人——原文直譯「他們」。</char></note>的惡行。<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />他們的審判官被扔下懸崖，</para>
  <para style="q1" vid="PSA 141:6">他們才會聽我的言語，</para>
  <para style="q1" vid="PSA 141:6">這言語是令人喜悅的。<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />他們說：「我們的骨頭散落在陰間口，</para>
  <para style="q1" vid="PSA 141:7">就像人耕作翻地時的土塊<note caller="+" style="f"><char style="fr" closed="false">141:7 </char><char style="ft" closed="false">的土塊——輔助詞語。</char></note>。」<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />主耶和華啊，</para>
  <para style="q1" vid="PSA 141:8">我的眼睛只仰望你！</para>
  <para style="q1" vid="PSA 141:8">我投靠了你，</para>
  <para style="q1" vid="PSA 141:8">求你不要讓我暴露在危險中<note caller="+" style="f"><char style="fr" closed="false">141:8 </char><char style="ft" closed="false">在危險中——輔助詞語。</char></note>。<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />求你保守我脫離惡人<note caller="+" style="f"><char style="fr" closed="false">141:9 </char><char style="ft" closed="false">惡人——原文直譯「他們」。</char></note>為我所設的網羅，</para>
  <para style="q1" vid="PSA 141:9">脫離作惡者的陷阱。<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />願惡人都落在自己的網羅裡，</para>
  <para style="q1" vid="PSA 141:10">而我卻安然<note caller="+" style="f"><char style="fr" closed="false">141:10 </char><char style="ft" closed="false">安然——輔助詞語。</char></note>經過。<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s">患難中求神解救</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的智慧詩，是在洞穴裡作的，是一個禱告。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />我用我的聲音向耶和華哀求，</para>
  <para style="q1" vid="PSA 142:1">用我的聲音向耶和華懇求。<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />我在他面前傾吐我的苦情，</para>
  <para style="q1" vid="PSA 142:2">在他面前陳說我的患難。<verse eid="PSA 142:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />我的靈在我裡面虛弱時，</para>
  <para style="q1" vid="PSA 142:3">你知道我的道路；</para>
  <para style="q1" vid="PSA 142:3">在我所行的路上，</para>
  <para style="q1" vid="PSA 142:3">他們為我暗設網羅。<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />求你向我右邊觀看，</para>
  <para style="q1" vid="PSA 142:4">沒有人理睬我，</para>
  <para style="q1" vid="PSA 142:4">我沒有避難的地方，</para>
  <para style="q1" vid="PSA 142:4">也沒有人顧念我的靈魂！<verse eid="PSA 142:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />耶和華啊，我向你哀求，說：</para>
  <para style="q1" vid="PSA 142:5">「你是我的避難所，</para>
  <para style="q1" vid="PSA 142:5">是我在活人之地繼業的份！」<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />求你留心聽我的呼聲，</para>
  <para style="q1" vid="PSA 142:6">因為我極其衰微；</para>
  <para style="q1" vid="PSA 142:6">求你解救我脫離追逼我的人，</para>
  <para style="q1" vid="PSA 142:6">因為他們比我強大。<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />求你把我的靈魂從被囚之地領出來，</para>
  <para style="q1" vid="PSA 142:7">好讓我稱頌你的名；</para>
  <para style="q1" vid="PSA 142:7">義人將環繞我，</para>
  <para style="q1" vid="PSA 142:7">因為你恩待我。<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s">求神解救與引導</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />耶和華啊，求你垂聽我的禱告，</para>
  <para style="q1" vid="PSA 143:1">傾聽我的懇求！</para>
  <para style="q1" vid="PSA 143:1">以你的信實和公義，求你回應我！<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />不要對你的僕人進行審判，</para>
  <para style="q1" vid="PSA 143:2">因為在你面前，沒有一個活人是公義的。<verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />仇敵追逼我，</para>
  <para style="q1" vid="PSA 143:3">把我的性命壓碎在地；</para>
  <para style="q1" vid="PSA 143:3">他使我住在黑暗之地，</para>
  <para style="q1" vid="PSA 143:3">如同死了很久的人。<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />因此我的靈在我裡面虛弱，</para>
  <para style="q1" vid="PSA 143:4">我的心在我裡面驚恐。<verse eid="PSA 143:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />我記起古時的日子，</para>
  <para style="q1" vid="PSA 143:5">思想你一切的作為，</para>
  <para style="q1" vid="PSA 143:5">默想你手所做的。<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />我向你伸開雙手，</para>
  <para style="q1" vid="PSA 143:6">我的靈魂渴望你，</para>
  <para style="q1" vid="PSA 143:6">如同乾旱之地盼望雨水<note caller="+" style="f"><char style="fr" closed="false">143:6 </char><char style="ft" closed="false">盼望雨水——輔助詞語。</char></note>。<char style="qs">細拉</char><verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />耶和華啊，求你快快回應我，</para>
  <para style="q1" vid="PSA 143:7">我的靈衰竭了！</para>
  <para style="q1" vid="PSA 143:7">不要向我隱藏你的臉，</para>
  <para style="q1" vid="PSA 143:7">免得我與下陰坑的人一樣。<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />求你使我在清晨聽見你慈愛的聲音，</para>
  <para style="q1" vid="PSA 143:8">因為我依靠你；</para>
  <para style="q1" vid="PSA 143:8">求你使我明白我當走的路，</para>
  <para style="q1" vid="PSA 143:8">因為我的靈魂仰望你。<verse eid="PSA 143:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />耶和華啊，求你解救我脫離我的仇敵，</para>
  <para style="q1" vid="PSA 143:9">我要在你那裡藏身！<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />求你教導我遵行你的旨意，</para>
  <para style="q1" vid="PSA 143:10">因為你是我的神；</para>
  <para style="q1" vid="PSA 143:10">願你美好的靈引導我到平坦之地。<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />耶和華啊，求你為你名的緣故使我存活；</para>
  <para style="q1" vid="PSA 143:11">藉著你的公義，</para>
  <para style="q1" vid="PSA 143:11">把我的靈魂從患難中領出來；<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />藉著你的慈愛，除盡我的仇敵，</para>
  <para style="q1" vid="PSA 143:12">消滅我靈魂所有的敵人，</para>
  <para style="q1" vid="PSA 143:12">因為我是你的僕人！<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s">蒙福的子民</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的詩<note caller="+" style="f"><char style="fr" closed="false">144:0 </char><char style="ft" closed="false">詩——輔助詞語。</char></note>。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />耶和華我的磐石是當受頌讚的！</para>
  <para style="q1" vid="PSA 144:1">他訓練我的手爭戰，</para>
  <para style="q1" vid="PSA 144:1">訓練我的手指打仗。<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />他是我慈愛的主<note caller="+" style="f"><char style="fr" closed="false">144:2 </char><char style="ft" closed="false">主——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PSA 144:2">我的要塞、我的庇護所，</para>
  <para style="q1" vid="PSA 144:2">我的救主、我的盾牌，</para>
  <para style="q1" vid="PSA 144:2">是我所投靠的；</para>
  <para style="q1" vid="PSA 144:2">他使我的子民降服在我之下。<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />耶和華啊，</para>
  <para style="q1" vid="PSA 144:3">人算什麼，你竟認識他！</para>
  <para style="q1" vid="PSA 144:3">世人算什麼，你竟顧惜他！<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />人好像一口氣，</para>
  <para style="q1" vid="PSA 144:4">他的年日就像影子那樣過去。<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />耶和華啊，</para>
  <para style="q1" vid="PSA 144:5">求你使諸天展開，親自降臨；</para>
  <para style="q1" vid="PSA 144:5">求你觸碰群山，使它們冒煙！<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />求你發出閃電，使仇敵四散；</para>
  <para style="q1" vid="PSA 144:6">求你發出箭矢，使他們潰亂。<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />求你從至高處伸出手；</para>
  <para style="q1" vid="PSA 144:7">求你救拔我，解救我脫離大水，</para>
  <para style="q1" vid="PSA 144:7">脫離外邦人的手。<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />他們的口說虛妄的事，</para>
  <para style="q1" vid="PSA 144:8">他們的右手是起假誓的右手。<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />神哪，我要向你唱新歌，</para>
  <para style="q1" vid="PSA 144:9">用十弦的里拉琴歌頌你！<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />是你為君王們賜下拯救，</para>
  <para style="q1" vid="PSA 144:10">是你救你僕人<char style="pn">大衛</char>脫離凶惡的刀劍！<verse eid="PSA 144:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />求你救拔我，</para>
  <para style="q1" vid="PSA 144:11">解救我脫離外邦人的手；</para>
  <para style="q1" vid="PSA 144:11">他們的口說虛妄的事，</para>
  <para style="q1" vid="PSA 144:11">他們的右手是起假誓的右手。<verse eid="PSA 144:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />我們的兒子在年幼時如同樹苗成長；</para>
  <para style="q1" vid="PSA 144:12">我們的女兒如同房角的柱子，</para>
  <para style="q1" vid="PSA 144:12">照著宮殿的樣式被雕琢。<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />我們的倉庫滿滿，</para>
  <para style="q1" vid="PSA 144:13">供應各樣的物產；</para>
  <para style="q1" vid="PSA 144:13">我們的羊群成千上萬，</para>
  <para style="q1" vid="PSA 144:13">在我們的田野中繁衍。<verse eid="PSA 144:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14" />我們的牛群滿負貨物，</para>
  <para style="q1" vid="PSA 144:14">城牆<note caller="+" style="f"><char style="fr" closed="false">144:14 </char><char style="ft" closed="false">城牆——輔助詞語。</char></note>也沒有破口，沒有人流亡，</para>
  <para style="q1" vid="PSA 144:14">我們的廣場上也沒有哭聲。<verse eid="PSA 144:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />這樣景況中的子民是蒙福的！</para>
  <para style="q1" vid="PSA 144:15">以耶和華為神的子民是蒙福的！<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s">宣告神的大能</para>
  <para style="b" />
  <para style="d">
    <char style="pn">大衛</char>的讚美詩。</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />我的神，我的王啊，我要尊崇你，</para>
  <para style="q1" vid="PSA 145:1">我要頌讚你的名，直到永永遠遠！<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />我要每天頌讚你，</para>
  <para style="q1" vid="PSA 145:2">讚美你的名，直到永永遠遠！<verse eid="PSA 145:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />耶和華真偉大，當受極大的讚美；</para>
  <para style="q1" vid="PSA 145:3">他的偉大無法測度。<verse eid="PSA 145:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />這世代要向那世代稱讚你所做的，</para>
  <para style="q1" vid="PSA 145:4">並要宣告你的大能作為。<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />我要默想<note caller="+" style="f"><char style="fr" closed="false">145:5 </char><char style="ft" closed="false">我要默想——死海古卷和一些古譯本作「他們要述說」。</char></note>你榮耀威嚴的尊榮，</para>
  <para style="q1" vid="PSA 145:5">默想你的奇妙作為。<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />人們要述說你行可畏之事的大能；</para>
  <para style="q1" vid="PSA 145:6">我也要講述你的偉大。<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />他們要傳揚你美善至尊的名，</para>
  <para style="q1" vid="PSA 145:7">也要頌唱你的公義。<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />耶和華有恩惠、有憐憫，</para>
  <para style="q1" vid="PSA 145:8">不輕易發怒，並大有慈愛。<verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />耶和華善待萬有，</para>
  <para style="q1" vid="PSA 145:9">他的憐憫臨到他所造的一切。<verse eid="PSA 145:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />耶和華啊，</para>
  <para style="q1" vid="PSA 145:10">你所造的一切都要稱謝你，</para>
  <para style="q1" vid="PSA 145:10">你的忠信者也要頌讚你！<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />他們要述說你王權的榮耀，</para>
  <para style="q1" vid="PSA 145:11">也要宣告你的大能；<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />為要讓世人知道你<note caller="+" style="f"><char style="fr" closed="false">145:12 </char><char style="ft" closed="false">你——原文直譯「他」。</char></note>的大能作為，</para>
  <para style="q1" vid="PSA 145:12">以及你<note caller="+" style="f"><char style="fr" closed="false">145:12 </char><char style="ft" closed="false">你——原文直譯「他」。</char></note>王權威嚴的榮耀。<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />你的王權是萬世永恆的王權，</para>
  <para style="q1" vid="PSA 145:13">你的統治存到萬世萬代。<verse eid="PSA 145:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />耶和華扶助所有跌倒的人，</para>
  <para style="q1" vid="PSA 145:14">扶起所有受壓制的人。<verse eid="PSA 145:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />一切的眼目都仰望你，</para>
  <para style="q1" vid="PSA 145:15">你按時賜給他們食物；<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />你張開手，</para>
  <para style="q1" vid="PSA 145:16">使一切活物都意願滿足。<verse eid="PSA 145:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />耶和華在他一切的道路上都公義，</para>
  <para style="q1" vid="PSA 145:17">在他所做的一切事上都信實。<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />耶和華與所有呼求他的人相近，</para>
  <para style="q1" vid="PSA 145:18">與所有真誠呼求他的人相近。<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />敬畏他的人，他必成就他們的意願；</para>
  <para style="q1" vid="PSA 145:19">他們的呼求，他必垂聽，</para>
  <para style="q1" vid="PSA 145:19">也必拯救他們。<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />耶和華保守所有愛他的人，</para>
  <para style="q1" vid="PSA 145:20">卻要除滅所有的惡人。<verse eid="PSA 145:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />我的口要述說耶和華當受的讚美，</para>
  <para style="q1" vid="PSA 145:21">一切有血肉的都要頌讚他的聖名，</para>
  <para style="q1" vid="PSA 145:21">直到永永遠遠！<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s">讚美神的信實</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />哈利路亞！</para>
  <para style="q1" vid="PSA 146:1">我的靈魂哪，你當讚美耶和華！<verse eid="PSA 146:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />我一生都要讚美耶和華；</para>
  <para style="q1" vid="PSA 146:2">我還活著的時候，要歌頌我的神。<verse eid="PSA 146:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />你們不要依靠權貴，</para>
  <para style="q1" vid="PSA 146:3">不要依靠世人，在他們那裡沒有拯救。<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />他們的氣一斷，就歸回塵土；</para>
  <para style="q1" vid="PSA 146:4">他們所謀劃的當天就消亡了。<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />以<char style="pn">雅各</char>的神為自己的幫助、</para>
  <para style="q1" vid="PSA 146:5">以耶和華神為自己盼望的，</para>
  <para style="q1" vid="PSA 146:5">那人是蒙福的！<verse eid="PSA 146:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />造諸天、大地、海洋和其中一切的那一位，</para>
  <para style="q1" vid="PSA 146:6">他必持守信實，直到永遠。<verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />他為那些受欺壓的人伸冤，</para>
  <para style="q1" vid="PSA 146:7">為那些飢餓的人賜下糧食；</para>
  <para style="q1" vid="PSA 146:7">耶和華使被囚的人得解放；<verse eid="PSA 146:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8" />耶和華打開瞎眼之人的眼睛，</para>
  <para style="q1" vid="PSA 146:8">耶和華扶起受壓制的人，</para>
  <para style="q1" vid="PSA 146:8">耶和華喜愛義人；<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />耶和華保護寄居者，扶助孤兒和寡婦，</para>
  <para style="q1" vid="PSA 146:9">卻使惡人的道路扭曲。<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />耶和華作王，直到永遠！</para>
  <para style="q1" vid="PSA 146:10">
    <char style="pn">錫安</char>哪，你的神作王，直到萬代！</para>
  <para style="q1" vid="PSA 146:10">哈利路亞！<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s">讚美神復興以色列</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />哈利路亞！</para>
  <para style="q1" vid="PSA 147:1">歌頌我們的神，是多麼美善；</para>
  <para style="q1" vid="PSA 147:1">讚美他，是多麼美好合宜！<verse eid="PSA 147:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />耶和華建造<char style="pn">耶路撒冷</char>，</para>
  <para style="q1" vid="PSA 147:2">聚集被驅散的<char style="pn">以色列</char>人。<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />他醫治心靈破碎的人，</para>
  <para style="q1" vid="PSA 147:3">包紮他們的傷處。<verse eid="PSA 147:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />他數點星辰的數目，</para>
  <para style="q1" vid="PSA 147:4">一一給它們起名。<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />我們的主偉大，大有能力，</para>
  <para style="q1" vid="PSA 147:5">他的聰慧無法衡量。<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />耶和華扶助卑微人，</para>
  <para style="q1" vid="PSA 147:6">使惡人降卑在地。<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />你們當以感謝向耶和華歌唱，</para>
  <para style="q1" vid="PSA 147:7">當用豎琴歌頌我們的神！<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />他用烏雲遮蓋天空，</para>
  <para style="q1" vid="PSA 147:8">為大地預備雨水，</para>
  <para style="q1" vid="PSA 147:8">使群山長出青草。<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />他賜糧食給走獸，</para>
  <para style="q1" vid="PSA 147:9">也給啼叫的烏鴉幼雛。<verse eid="PSA 147:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />他喜歡的不是馬的力量，</para>
  <para style="q1" vid="PSA 147:10">他喜悅的不是人的腳力——<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />耶和華喜悅的是那些敬畏他的人、</para>
  <para style="q1" vid="PSA 147:11">那些期盼他慈愛的人。<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />
    <char style="pn">耶路撒冷</char>啊，當稱讚耶和華！</para>
  <para style="q1" vid="PSA 147:12">
    <char style="pn">錫安</char>哪，當讚美你的神！<verse eid="PSA 147:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />因為他堅固你城門的門閂，</para>
  <para style="q1" vid="PSA 147:13">祝福你當中的兒女。<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />他使你境內平安，</para>
  <para style="q1" vid="PSA 147:14">用最好的麥子使你飽足。<verse eid="PSA 147:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />他向大地發出命令，</para>
  <para style="q1" vid="PSA 147:15">他的話語迅速地傳開。<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />他降雪如同羊毛，</para>
  <para style="q1" vid="PSA 147:16">撒霜如同灰燼；<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />他拋下冰雹如同碎餅；</para>
  <para style="q1" vid="PSA 147:17">面對從他而出的寒冷，</para>
  <para style="q1" vid="PSA 147:17">誰能站立得住呢？<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />他發出話語，使這些融化；</para>
  <para style="q1" vid="PSA 147:18">他使風吹動，水就流出。<verse eid="PSA 147:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />他向<char style="pn">雅各</char>宣告他的話語，</para>
  <para style="q1" vid="PSA 147:19">向<char style="pn">以色列</char>宣告他的律例和法規。<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />他沒有這樣對待過任何國民；</para>
  <para style="q1" vid="PSA 147:20">至於他的法規，他們都不知道。</para>
  <para style="q1" vid="PSA 147:20">哈利路亞！<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s">萬有當讚美耶和華</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />哈利路亞！</para>
  <para style="q1" vid="PSA 148:1">你們當從天上讚美耶和華，</para>
  <para style="q1" vid="PSA 148:1">在高處讚美他！<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />他的眾使者啊，你們當讚美他！</para>
  <para style="q1" vid="PSA 148:2">他的眾天軍啊，你們當讚美他！<verse eid="PSA 148:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />太陽和月亮啊，你們當讚美他！</para>
  <para style="q1" vid="PSA 148:3">所有放光的星辰哪，你們當讚美他！<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />天上的天和天上的水啊，</para>
  <para style="q1" vid="PSA 148:4">你們當讚美他！<verse eid="PSA 148:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />願這一切都讚美耶和華的名，</para>
  <para style="q1" vid="PSA 148:5">因為他一吩咐，它們就被造成。<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />他確立這些，直到永永遠遠；</para>
  <para style="q1" vid="PSA 148:6">他賜下律例，永不廢去。<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />你們當從地上讚美耶和華！</para>
  <para style="q1" vid="PSA 148:7">你們海獸和一切深淵、<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />烈火和冰雹、</para>
  <para style="q1" vid="PSA 148:8">冰雪和雲霧、</para>
  <para style="q1" vid="PSA 148:8">遵行他話語的暴風、<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />群山和所有的岡陵、</para>
  <para style="q1" vid="PSA 148:9">果樹和所有的香柏樹、<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />野獸和所有的牲畜、</para>
  <para style="q1" vid="PSA 148:10">爬蟲和飛鳥、<verse eid="PSA 148:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />地上的君王和萬民、</para>
  <para style="q1" vid="PSA 148:11">首領們和地上所有的審判官、<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />少男和少女、</para>
  <para style="q1" vid="PSA 148:12">老年人與少年人——<verse eid="PSA 148:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />願這一切都讚美耶和華的名！</para>
  <para style="q1" vid="PSA 148:13">是的，唯獨他的名被高舉，</para>
  <para style="q1" vid="PSA 148:13">他的尊榮超越大地和諸天。<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />他為自己的子民高舉了一個角，</para>
  <para style="q1" vid="PSA 148:14">要使他所有的忠信者，</para>
  <para style="q1" vid="PSA 148:14">就是與他相近的子民<char style="pn">以色列</char>子孫，</para>
  <para style="q1" vid="PSA 148:14">都讚美他<note caller="+" style="f"><char style="fr" closed="false">148:14 </char><char style="ft" closed="false">要使他所有的忠信者，就是與他相近的子民以色列子孫，都讚美他——或譯作「高舉他所有忠信者的讚美，就是與他相近的子民以色列子孫的讚美」或「要使他所有的忠信者，就是與他相近的子民以色列子孫，得著讚美」。</char></note>。</para>
  <para style="q1" vid="PSA 148:14">哈利路亞！<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s">忠信者當讚美耶和華</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />哈利路亞！</para>
  <para style="q1" vid="PSA 149:1">你們當向耶和華唱新歌，</para>
  <para style="q1" vid="PSA 149:1">在忠信者的會眾裡唱出他當受的讚美！<verse eid="PSA 149:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />願<char style="pn">以色列</char>因造他的主而歡喜，</para>
  <para style="q1" vid="PSA 149:2">願<char style="pn">錫安</char>的兒女因他們的王而快樂！<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />願他們跳舞讚美他的名，</para>
  <para style="q1" vid="PSA 149:3">伴著鈴鼓和豎琴歌頌他！<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />因為耶和華喜悅他的子民，</para>
  <para style="q1" vid="PSA 149:4">他使卑微人以救恩為裝飾。<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />願忠信的人在榮耀中歡躍，</para>
  <para style="q1" vid="PSA 149:5">在自己的床上歡唱！<verse eid="PSA 149:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />願他們口中充滿對神的頌揚；</para>
  <para style="q1" vid="PSA 149:6">願他們手中有雙刃的刀劍——<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />為要向列國施行報復，</para>
  <para style="q1" vid="PSA 149:7">責罰萬族；<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />為要用鎖鏈捆住他們的君王，</para>
  <para style="q1" vid="PSA 149:8">用鐵鐐捆住他們的權貴；<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />為要向他們施行所記錄的裁決；</para>
  <para style="q1" vid="PSA 149:9">這威榮屬於他所有的忠信者。</para>
  <para style="q1" vid="PSA 149:9">哈利路亞！<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s">讚美耶和華</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />哈利路亞！</para>
  <para style="q1" vid="PSA 150:1">你們要在神的聖所讚美他，</para>
  <para style="q1" vid="PSA 150:1">在彰顯<note caller="+" style="f"><char style="fr" closed="false">150:1 </char><char style="ft" closed="false">彰顯——輔助詞語。</char></note>他能力的穹蒼讚美他！<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />要因他的大能作為讚美他，</para>
  <para style="q1" vid="PSA 150:2">照著他無限的偉大讚美他！<verse eid="PSA 150:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />要用號角的聲音讚美他，</para>
  <para style="q1" vid="PSA 150:3">用里拉琴和豎琴讚美他！<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />要用鈴鼓和跳舞讚美他，</para>
  <para style="q1" vid="PSA 150:4">用絲弦和笛子讚美他！<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />要用響亮的銅鈸讚美他，</para>
  <para style="q1" vid="PSA 150:5">用大聲的銅鈸讚美他！<verse eid="PSA 150:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />一切有氣息的，</para>
  <para style="q1" vid="PSA 150:6">都要讚美耶和華！</para>
  <para style="q1" vid="PSA 150:6">哈利路亞！<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>