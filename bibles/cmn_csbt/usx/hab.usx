<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">哈巴谷書</para>
  <para style="mt">哈巴谷書</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />先知<char style="pn">哈巴谷</char>所見的默示：<verse eid="HAB 1:1" /></para>
  <para style="b" />
  <para style="s">哈巴谷的禱告</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2" />耶和華啊，我呼救，</para>
  <para style="q1" vid="HAB 1:2">你卻不垂聽，</para>
  <para style="q1" vid="HAB 1:2">這要到什麼時候呢？</para>
  <para style="q1" vid="HAB 1:2">我向你哀呼「有殘暴」，</para>
  <para style="q1" vid="HAB 1:2">你還不拯救！<verse eid="HAB 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3" />你為什麼使我目睹邪惡，</para>
  <para style="q1" vid="HAB 1:3">為什麼看著奸惡不管呢？</para>
  <para style="q1" vid="HAB 1:3">毀滅和殘暴在我面前，</para>
  <para style="q1" vid="HAB 1:3">爭訟和紛爭不斷發生。<verse eid="HAB 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4" />因此律法廢弛，</para>
  <para style="q1" vid="HAB 1:4">公正總不彰顯；</para>
  <para style="q1" vid="HAB 1:4">因惡人圍住義人，</para>
  <para style="q1" vid="HAB 1:4">公正就顯為歪曲。<verse eid="HAB 1:4" /></para>
  <para style="b" />
  <para style="s">神的回應</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5" />「你們要向列國觀看，</para>
  <para style="q1" vid="HAB 1:5">要注目，大大驚奇！</para>
  <para style="q1" vid="HAB 1:5">因為在你們的年日裡，</para>
  <para style="q1" vid="HAB 1:5">我要做一件事，</para>
  <para style="q1" vid="HAB 1:5">即使有人講述，你們也不會相信。<verse eid="HAB 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6" />看哪，我要興起<char style="pn">迦勒底</char>人，</para>
  <para style="q1" vid="HAB 1:6">他們是殘忍暴躁的民族，</para>
  <para style="q1" vid="HAB 1:6">他們橫行遍地，</para>
  <para style="q1" vid="HAB 1:6">占有不屬於自己的住處。<verse eid="HAB 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7" />他們恐怖可怕，</para>
  <para style="q1" vid="HAB 1:7">自定裁決，唯我獨尊。<verse eid="HAB 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8" />他們的戰馬比豹子還快，</para>
  <para style="q1" vid="HAB 1:8">比夜晚的豺狼更猛，</para>
  <para style="q1" vid="HAB 1:8">他們的馬兵飛奔。</para>
  <para style="q1" vid="HAB 1:8">他們的馬兵從遠方而來，</para>
  <para style="q1" vid="HAB 1:8">如鷹飛馳，俯衝吞吃。<verse eid="HAB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 1:9" />他們都為施暴而來，奮勇向前；</para>
  <para style="q1" vid="HAB 1:9">他們聚集俘虜，多如沙土。<verse eid="HAB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10" />他們嘲諷君王，嘲笑君主；</para>
  <para style="q1" vid="HAB 1:10">他們譏笑一切堡壘，</para>
  <para style="q1" vid="HAB 1:10">築起土堆攻取它。<verse eid="HAB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11" />然後，他們如風掃蕩過去。</para>
  <para style="q1" vid="HAB 1:11">這些以自己的勢力為神的，</para>
  <para style="q1" vid="HAB 1:11">必承擔罪責。」<verse eid="HAB 1:11" /></para>
  <para style="b" />
  <para style="s">哈巴谷的禱告</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12" />耶和華我的神，我的至聖者啊，</para>
  <para style="q1" vid="HAB 1:12">你不是從太初就在嗎？</para>
  <para style="q1" vid="HAB 1:12">我們必不至於死。</para>
  <para style="q1" vid="HAB 1:12">耶和華啊，你差派他們是為要審判；</para>
  <para style="q1" vid="HAB 1:12">磐石啊，你設立他們是為要懲罰。<verse eid="HAB 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13" />你眼目純淨，</para>
  <para style="q1" vid="HAB 1:13">見不得邪惡，看不得奸惡。</para>
  <para style="q1" vid="HAB 1:13">可你為什麼看著詭詐的人不管呢？</para>
  <para style="q1" vid="HAB 1:13">為什麼惡人吞滅比自己公義的人，</para>
  <para style="q1" vid="HAB 1:13">你卻保持緘默呢？<verse eid="HAB 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14" />你使人像海裡的魚，</para>
  <para style="q1" vid="HAB 1:14">像沒有管轄者的爬蟲。<verse eid="HAB 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15" />
    <char style="pn">迦勒底</char>人用魚鉤把他們都釣上來，</para>
  <para style="q1" vid="HAB 1:15">用網羅捕獲他們，</para>
  <para style="q1" vid="HAB 1:15">用漁網聚攏他們，</para>
  <para style="q1" vid="HAB 1:15">為此歡喜快樂。<verse eid="HAB 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16" />因此<char style="pn">迦勒底</char>人向自己的網羅獻祭，</para>
  <para style="q1" vid="HAB 1:16">向自己的漁網燒香，</para>
  <para style="q1" vid="HAB 1:16">因為藉著這些，</para>
  <para style="q1" vid="HAB 1:16">他們的收獲豐碩，食物肥美。<verse eid="HAB 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17" />難道他們就這樣不斷倒空自己的網羅，</para>
  <para style="q1" vid="HAB 1:17">持續無情地殺戮列國嗎？<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="s">哈巴谷等候神的回應</para>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1" />我要站在我的哨所，</para>
  <para style="q1" vid="HAB 2:1">站在城樓上；</para>
  <para style="q1" vid="HAB 2:1">我要守望，看看他會對我說什麼，</para>
  <para style="q1" vid="HAB 2:1">我又如何回應對我的責備。<verse eid="HAB 2:1" /></para>
  <para style="b" />
  <para style="s">神的回應</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 2:2" />耶和華回應我，說：</para>
  <para style="q1" vid="HAB 2:2">你要把這異象清楚地寫在版上，</para>
  <para style="q1" vid="HAB 2:2">好讓宣讀的人讀得順暢。<verse eid="HAB 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3" />因為這異象到所定的日期才發生，</para>
  <para style="q1" vid="HAB 2:3">指向結局，絕非謊言。</para>
  <para style="q1" vid="HAB 2:3">就算耽延了，也要等候；</para>
  <para style="q1" vid="HAB 2:3">它一定來臨，不再遲延。<verse eid="HAB 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4" />看哪，</para>
  <para style="q1" vid="HAB 2:4">那些惡人自高自大，心不正直；</para>
  <para style="q1" vid="HAB 2:4">但義人將因信而活。<verse eid="HAB 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5" />財富<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">財富——依據死海古卷；馬索拉文本作「酒」。</char></note>必背棄狂妄人，</para>
  <para style="q1" vid="HAB 2:5">使他不得安息。</para>
  <para style="q1" vid="HAB 2:5">他擴張欲望，如同陰間；</para>
  <para style="q1" vid="HAB 2:5">從不飽足，如同死亡；</para>
  <para style="q1" vid="HAB 2:5">他招聚萬國、聚集萬民，</para>
  <para style="q1" vid="HAB 2:5">歸於自己。<verse eid="HAB 2:5" /></para>
  <para style="b" />
  <para style="s">有禍了</para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 2:6" />然而，那些國民</para>
  <para style="q1" vid="HAB 2:6">難道不都要向他唱諷刺歌嗎？</para>
  <para style="q1" vid="HAB 2:6">他們必用俗語、諷喻對他說：</para>
  <para style="q1" vid="HAB 2:6">「那增添不屬於自己財物的人，</para>
  <para style="q1" vid="HAB 2:6">給自己堆積抵押品的人，</para>
  <para style="q1" vid="HAB 2:6">你有禍了！</para>
  <para style="q1" vid="HAB 2:6">你這樣要到什麼時候呢？」<verse eid="HAB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7" />收取你利息的人，難道不會突然起來嗎？</para>
  <para style="q1" vid="HAB 2:7">使你顫抖的人，難道不會醒過來嗎？</para>
  <para style="q1" vid="HAB 2:7">那時，你必成為他們的擄物。<verse eid="HAB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8" />你既然搶奪了許多民族，</para>
  <para style="q1" vid="HAB 2:8">他們剩餘的國民也都搶奪你，</para>
  <para style="q1" vid="HAB 2:8">因為你殺人流血，</para>
  <para style="q1" vid="HAB 2:8">向全地各城和其中所有的居民施行殘暴。<verse eid="HAB 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9" />為自己的家貪圖不義之財的人，</para>
  <para style="q1" vid="HAB 2:9">為了逃避災禍在高處築巢的人，</para>
  <para style="q1" vid="HAB 2:9">你有禍了！<verse eid="HAB 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10" />你消滅許多民族，</para>
  <para style="q1" vid="HAB 2:10">是為自己的家謀取恥辱，自害己命。<verse eid="HAB 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11" />磚石必從牆裡哀叫<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">哀叫——或譯作「控訴」。</char></note>，</para>
  <para style="q1" vid="HAB 2:11">椽木必從屋梁中回應。<verse eid="HAB 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12" />以人血建造城市的人，</para>
  <para style="q1" vid="HAB 2:12">以不義堅立城邑的人，</para>
  <para style="q1" vid="HAB 2:12">你有禍了！<verse eid="HAB 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13" />看哪，這難道不是出於萬軍之耶和華嗎？</para>
  <para style="q1" vid="HAB 2:13">萬民的辛勞被火燒盡，</para>
  <para style="q1" vid="HAB 2:13">萬族白白勞苦。<verse eid="HAB 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14" />全地必充滿對耶和華榮耀的認知，</para>
  <para style="q1" vid="HAB 2:14">如同海洋盈滿了水。<verse eid="HAB 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15" />讓鄰人喝你摻入憤怒的酒，</para>
  <para style="q1" vid="HAB 2:15">以致他喝醉，為要看他下體的人，</para>
  <para style="q1" vid="HAB 2:15">你有禍了！<verse eid="HAB 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16" />你將飽受羞辱，而非榮耀。</para>
  <para style="q1" vid="HAB 2:16">你也喝吧，露出你未受割禮的下體！</para>
  <para style="q1" vid="HAB 2:16">耶和華右手的杯必傳到你這裡，</para>
  <para style="q1" vid="HAB 2:16">恥辱必代替你的榮耀。<verse eid="HAB 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17" />
    <char style="pn">黎巴嫩</char>所受的殘暴將淹沒你，</para>
  <para style="q1" vid="HAB 2:17">動物們所受的迫害將驚嚇你，</para>
  <para style="q1" vid="HAB 2:17">因為你殺人流血，</para>
  <para style="q1" vid="HAB 2:17">殘害全地各城和其中所有的居民。<verse eid="HAB 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18" />偶像有什麼益處呢？</para>
  <para style="q1" vid="HAB 2:18">不過是匠人刻鑿的，</para>
  <para style="q1" vid="HAB 2:18">是一個鑄像，是虛假的師傅。</para>
  <para style="q1" vid="HAB 2:18">匠人竟然信賴自己的作品，</para>
  <para style="q1" vid="HAB 2:18">製造出無用的啞巴偶像。<verse eid="HAB 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19" />對木頭說「醒來」的人，</para>
  <para style="q1" vid="HAB 2:19">對啞巴石頭說「起來」的人，</para>
  <para style="q1" vid="HAB 2:19">你有禍了！</para>
  <para style="q1" vid="HAB 2:19">偶像能指教人嗎？</para>
  <para style="q1" vid="HAB 2:19">看哪，它雖然包裹金銀，</para>
  <para style="q1" vid="HAB 2:19">裡面卻毫無氣息。<verse eid="HAB 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20" />唯有耶和華，他在自己的聖殿中，</para>
  <para style="q1" vid="HAB 2:20">全地都要在他面前肅靜。<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s">哈巴谷的禱告</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1" />先知<char style="pn">哈巴谷</char>的禱告，用流離歌的曲調。<verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />耶和華啊，</para>
  <para style="q1" vid="HAB 3:2">我聽到了你的傳聞；</para>
  <para style="q1" vid="HAB 3:2">耶和華啊，我因你的作為而敬畏。</para>
  <para style="q1" vid="HAB 3:2">求你在這些年間復興你的作為，</para>
  <para style="q1" vid="HAB 3:2">在這些年間把它顯明出來；</para>
  <para style="q1" vid="HAB 3:2">求你在烈怒中記得憐憫！<verse eid="HAB 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />神從<char style="pn">提幔</char>而來，</para>
  <para style="q1" vid="HAB 3:3">至聖者從<char style="pn">帕蘭</char>山臨到。<char style="qs">細拉</char></para>
  <para style="q1" vid="HAB 3:3">他的尊榮遍滿諸天，</para>
  <para style="q1" vid="HAB 3:3">他所受的讚美充滿大地。<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />他的光輝如同日光，</para>
  <para style="q1" vid="HAB 3:4">他的手發出光芒，</para>
  <para style="q1" vid="HAB 3:4">其中蘊藏著他的力量。<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />瘟疫行在他前面，</para>
  <para style="q1" vid="HAB 3:5">炎症在他腳下隨行。<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />他站住，撼動<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">撼動——或譯作「丈量」。</char></note>大地；</para>
  <para style="q1" vid="HAB 3:6">他觀看，驚散列國。</para>
  <para style="q1" vid="HAB 3:6">亙古的山嶺崩裂，</para>
  <para style="q1" vid="HAB 3:6">綿延的丘陵塌陷。</para>
  <para style="q1" vid="HAB 3:6">這就是他古時的道路。<verse eid="HAB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />我看見<char style="pn">古珊</char>的帳篷遭難，</para>
  <para style="q1" vid="HAB 3:7">
    <char style="pn">米甸</char>地的幔帳顫抖。<verse eid="HAB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />耶和華啊，</para>
  <para style="q1" vid="HAB 3:8">你乘駕戰馬和你得勝<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">得勝——或譯作「拯救」。</char></note>的戰車，</para>
  <para style="q1" vid="HAB 3:8">是向江河發怒嗎？</para>
  <para style="q1" vid="HAB 3:8">你是向江河發泄怒氣呢，</para>
  <para style="q1" vid="HAB 3:8">還是向海洋發泄盛怒？<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />你的弓全然展現，</para>
  <para style="q1" vid="HAB 3:9">誓言如箭發出。<char style="qs">細拉</char></para>
  <para style="q1" vid="HAB 3:9">你以江河分開大地。<verse eid="HAB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 3:10" />群山見你就震顫，</para>
  <para style="q1" vid="HAB 3:10">大水洶湧漫過，</para>
  <para style="q1" vid="HAB 3:10">深淵發聲，高舉其手。<verse eid="HAB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />因你的箭發出光芒，</para>
  <para style="q1" vid="HAB 3:11">你的長矛閃耀光輝，</para>
  <para style="q1" vid="HAB 3:11">日月就在高處停住。<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />你在憤怒中巡行大地，</para>
  <para style="q1" vid="HAB 3:12">在怒氣中踐踏列國。<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />你出來，是要拯救你的子民，</para>
  <para style="q1" vid="HAB 3:13">拯救你的受膏者。</para>
  <para style="q1" vid="HAB 3:13">你擊碎惡人之家的首領，</para>
  <para style="q1" vid="HAB 3:13">裸露他，從腳直到脖子<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">你擊碎惡人之家的首領，裸露他，從腳直到脖子——或譯作「你擊碎了惡人之家的屋頂，拆光它，從根基直到頂石」。</char></note>。<char style="qs">細拉</char><verse eid="HAB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />你用他的箭射穿他戰士的頭，</para>
  <para style="q1" vid="HAB 3:14">他們如旋風襲來，要把我驅散。</para>
  <para style="q1" vid="HAB 3:14">他們狂喜，就像在隱祕處吞吃困苦人。<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />你策馬踐踏海洋，大水翻騰。<verse eid="HAB 3:15" /></para>
  <para style="b" />
  <para style="s">哈巴谷信靠神</para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />我一聽見就膽戰心驚，</para>
  <para style="q1" vid="HAB 3:16">我的嘴唇因這聲音而發顫；</para>
  <para style="q1" vid="HAB 3:16">朽爛進入我的骨頭，</para>
  <para style="q1" vid="HAB 3:16">我的腳步顫抖。</para>
  <para style="q1" vid="HAB 3:16">然而，我要安靜等候</para>
  <para style="q1" vid="HAB 3:16">患難的日子臨到那侵犯我們的民。<verse eid="HAB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17" />雖然無花果樹不吐蕾，</para>
  <para style="q1" vid="HAB 3:17">葡萄樹不結果，</para>
  <para style="q1" vid="HAB 3:17">橄欖樹歉收，</para>
  <para style="q1" vid="HAB 3:17">田地不出糧食，</para>
  <para style="q1" vid="HAB 3:17">羊圈裡絕了羊，</para>
  <para style="q1" vid="HAB 3:17">牛棚內也沒有牛，<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />但我仍要因耶和華而歡欣，</para>
  <para style="q1" vid="HAB 3:18">因拯救我的神而喜樂。<verse eid="HAB 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />主耶和華是我的力量；</para>
  <para style="q1" vid="HAB 3:19">他使我的腳如母鹿的蹄，</para>
  <para style="q1" vid="HAB 3:19">使我穩行在高處。</para>
  <para style="b" vid="HAB 3:19" />
  <para style="p" vid="HAB 3:19">這首歌交給樂隊指揮，用弦樂器。<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>