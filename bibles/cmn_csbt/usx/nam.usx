<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">那鴻書</para>
  <para style="mt">那鴻書</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />有關<char style="pn">尼尼微</char>的默示，<char style="pn">伊勒克施</char>人<char style="pn">那鴻</char>的異象<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">異象——或譯作「啟示」。</char></note>記錄：<verse eid="NAM 1:1" /></para>
  <para style="b" />
  <para style="s">神施行報復</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />耶和華是忌邪和報復的神；</para>
  <para style="q1" vid="NAM 1:2">耶和華施行報復，懷有烈怒；</para>
  <para style="q1" vid="NAM 1:2">耶和華報復他的敵人，</para>
  <para style="q1" vid="NAM 1:2">對他的仇敵懷怒。<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />耶和華不輕易發怒，</para>
  <para style="q1" vid="NAM 1:3">有偉大的能力；</para>
  <para style="q1" vid="NAM 1:3">耶和華絕不會讓有罪的免於罪罰。</para>
  <para style="q1" vid="NAM 1:3">他在旋風和暴風中行路，</para>
  <para style="q1" vid="NAM 1:3">雲霧是他腳下的塵土。<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />他斥責海，海就枯乾，</para>
  <para style="q1" vid="NAM 1:4">他使所有的河流乾涸；</para>
  <para style="q1" vid="NAM 1:4">
    <char style="pn">巴珊</char>和<char style="pn">迦密</char>就衰敗，</para>
  <para style="q1" vid="NAM 1:4">
    <char style="pn">黎巴嫩</char>的花朵也衰殘。<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />大山因他而震動，</para>
  <para style="q1" vid="NAM 1:5">小山也崩解，</para>
  <para style="q1" vid="NAM 1:5">大地在他的面前起伏動盪，</para>
  <para style="q1" vid="NAM 1:5">世界和其上的居民也都如此。<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />誰能在他的憤怒面前站立得住，</para>
  <para style="q1" vid="NAM 1:6">誰能抵擋他猛烈的怒氣？</para>
  <para style="q1" vid="NAM 1:6">他的烈怒如火傾瀉，</para>
  <para style="q1" vid="NAM 1:6">磐石也在他面前崩裂。<verse eid="NAM 1:6" /></para>
  <para style="b" />
  <para style="s">尼尼微將毀滅</para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />耶和華是良善的，</para>
  <para style="q1" vid="NAM 1:7">是人在患難之日的堡壘，</para>
  <para style="q1" vid="NAM 1:7">他認識那些投靠他的人。<verse eid="NAM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 1:8" />他卻要用氾濫的洪流</para>
  <para style="q1" vid="NAM 1:8">徹底沖毀<char style="pn">尼尼微</char><note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">尼尼微——或譯作「仇敵的住處」。</char></note>，</para>
  <para style="q1" vid="NAM 1:8">把仇敵驅趕到黑暗中。<verse eid="NAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />你們謀劃什麼抵擋耶和華呢？</para>
  <para style="q1" vid="NAM 1:9">他必徹底沖毀，</para>
  <para style="q1" vid="NAM 1:9">敵對者<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">敵對者——或譯作「患難」。</char></note>再也不能興起。<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />他們即使像纏結的荊棘，</para>
  <para style="q1" vid="NAM 1:10">又像酒徒沉迷的酒，</para>
  <para style="q1" vid="NAM 1:10">也必如乾透的麥稭，</para>
  <para style="q1" vid="NAM 1:10">被火吞噬。<verse eid="NAM 1:10" /></para>
  <para style="b" />
  <para style="s">神應許拯救猶大</para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11" />有個卑劣的陰謀家從<char style="pn">尼尼微</char><note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">尼尼微——原文作「你」。</char></note>出來，</para>
  <para style="q1" vid="NAM 1:11">謀劃惡事抵擋耶和華。<verse eid="NAM 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 1:12" />耶和華如此說：</para>
  <para style="q1" vid="NAM 1:12">「雖然他們裝備齊全，</para>
  <para style="q1" vid="NAM 1:12">人數如此眾多，</para>
  <para style="q1" vid="NAM 1:12">但他們照樣會被剪除消逝。</para>
  <para style="q1" vid="NAM 1:12">
    <char style="pn">猶大</char>啊<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">猶大啊——輔助詞語。</char></note>，</para>
  <para style="q1" vid="NAM 1:12">我雖然曾苦待你，</para>
  <para style="q1" vid="NAM 1:12">但不會再苦待你。<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />現在我要從你身上打斷他的軛，</para>
  <para style="q1" vid="NAM 1:13">拉斷你身上的繩索。」<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="s">亞述王敗亡</para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />
    <char style="pn">尼尼微</char>啊<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">尼尼微啊——輔助詞語。</char></note>，</para>
  <para style="q1" vid="NAM 1:14">耶和華已經針對你下令：</para>
  <para style="q1" vid="NAM 1:14">你的名不會再延續下去了；</para>
  <para style="q1" vid="NAM 1:14">我將從你神明的廟宇中</para>
  <para style="q1" vid="NAM 1:14">鏟除雕像和鑄像，</para>
  <para style="q1" vid="NAM 1:14">我將預備你的墳墓，</para>
  <para style="q1" vid="NAM 1:14">因為你是被詛咒<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">被詛咒——或譯作「卑劣」。</char></note>的。<verse eid="NAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15" />看哪，群山上</para>
  <para style="q1" vid="NAM 1:15">有傳好消息、宣告平安的人的腳蹤。</para>
  <para style="q1" vid="NAM 1:15">
    <char style="pn">猶大</char>啊，守你的節期，</para>
  <para style="q1" vid="NAM 1:15">還你所許的願吧！</para>
  <para style="q1" vid="NAM 1:15">因為那卑劣之徒</para>
  <para style="q1" vid="NAM 1:15">再也不會從你中間經過了，</para>
  <para style="q1" vid="NAM 1:15">他們全都被剪除了。<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s">尼尼微受審判</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1" />
    <char style="pn">尼尼微</char>啊<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">尼尼微啊——輔助詞語。</char></note>，</para>
  <para style="q1" vid="NAM 2:1">驅散者上來攻擊你了！</para>
  <para style="q1" vid="NAM 2:1">你要堅守堡壘，</para>
  <para style="q1" vid="NAM 2:1">守望道路，</para>
  <para style="q1" vid="NAM 2:1">穩固你的腰，</para>
  <para style="q1" vid="NAM 2:1">鼓足你的全部力量。<verse eid="NAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />耶和華必恢復<char style="pn">雅各</char>的繁榮，</para>
  <para style="q1" vid="NAM 2:2">也就是<char style="pn">以色列</char>的繁榮；</para>
  <para style="q1" vid="NAM 2:2">儘管搶掠者曾把他們搶掠一空，</para>
  <para style="q1" vid="NAM 2:2">毀壞了他們的葡萄枝。<verse eid="NAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />驅散者的戰士們拿著赤紅的盾牌，</para>
  <para style="q1" vid="NAM 2:3">勇士們身穿朱紅色衣服；</para>
  <para style="q1" vid="NAM 2:3">在預備好戰鬥的日子，</para>
  <para style="q1" vid="NAM 2:3">鐵戰車如火閃亮，</para>
  <para style="q1" vid="NAM 2:3">柏木的矛桿飛舞。<verse eid="NAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />戰車在街道上狂奔，</para>
  <para style="q1" vid="NAM 2:4">在廣場上猛衝；</para>
  <para style="q1" vid="NAM 2:4">它們形狀像火把，</para>
  <para style="q1" vid="NAM 2:4">疾馳如閃電。<verse eid="NAM 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />王<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">王——輔助詞語。</char></note>召集他的軍官們，</para>
  <para style="q1" vid="NAM 2:5">他們跌跌撞撞前進，</para>
  <para style="q1" vid="NAM 2:5">急速衝向城牆，架起防護盾。<verse eid="NAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />河的閘門被打開了，</para>
  <para style="q1" vid="NAM 2:6">王宮被沖毀了。<verse eid="NAM 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />王后將被剝去榮華<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">王后將被剝去榮華——或譯作「這事已命定，她要被剝去榮華」。</char></note>，被帶走；</para>
  <para style="q1" vid="NAM 2:7">她的婢女們捶著胸，</para>
  <para style="q1" vid="NAM 2:7">哀鳴如鴿子。<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />
    <char style="pn">尼尼微</char>往日就像滿盈的蓄水池，</para>
  <para style="q1" vid="NAM 2:8">但現在人們紛紛逃跑；</para>
  <para style="q1" vid="NAM 2:8">雖有喊聲<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">雖有喊聲——輔助詞語。</char></note>「站住！站住！」</para>
  <para style="q1" vid="NAM 2:8">卻無一人回頭。<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />搶奪銀子吧，</para>
  <para style="q1" vid="NAM 2:9">搶奪金子吧！</para>
  <para style="q1" vid="NAM 2:9">滿屋的資財不計其數，</para>
  <para style="q1" vid="NAM 2:9">各樣的寶器琳瑯滿目。<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />荒廢了！荒蕪了！荒涼了！</para>
  <para style="q1" vid="NAM 2:10">人心消融，膝蓋顫抖，</para>
  <para style="q1" vid="NAM 2:10">滿腰劇痛，人人臉色慘白！<verse eid="NAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />獅子的巢穴在哪裡呢？</para>
  <para style="q1" vid="NAM 2:11">少壯獅子的棲息地在哪裡呢？</para>
  <para style="q1" vid="NAM 2:11">公獅、母獅行走遊蕩，</para>
  <para style="q1" vid="NAM 2:11">幼獅不受驚嚇的地方在哪裡呢？<verse eid="NAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />在那裡<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">在那裡——輔助詞語。</char></note>，</para>
  <para style="q1" vid="NAM 2:12">公獅為幼獅撕掠足夠的食物，</para>
  <para style="q1" vid="NAM 2:12">為母獅咬死活物；</para>
  <para style="q1" vid="NAM 2:12">獵物堆滿牠的洞穴，</para>
  <para style="q1" vid="NAM 2:12">撕碎的肉堆滿牠的巢穴。<verse eid="NAM 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />這是萬軍之耶和華的宣告：</para>
  <para style="q1" vid="NAM 2:13">看哪，我與你敵對！</para>
  <para style="q1" vid="NAM 2:13">我要使你的戰車在濃煙中燒掉，</para>
  <para style="q1" vid="NAM 2:13">使你的少壯獅子被刀劍吞滅。</para>
  <para style="q1" vid="NAM 2:13">我要使你的獵物從地上斷絕，</para>
  <para style="q1" vid="NAM 2:13">你使者的聲音再也不會被人聽見。<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s">亞述的覆滅</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1" />有禍了，這殺人流血的城！</para>
  <para style="q1" vid="NAM 3:1">城中盡是欺詐，充滿搶劫，</para>
  <para style="q1" vid="NAM 3:1">搶奪的事從不間斷。<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />聽啊，</para>
  <para style="q1" vid="NAM 3:2">鞭子的響聲，車輪的轟鳴！</para>
  <para style="q1" vid="NAM 3:2">戰馬飛躍，戰車奔騰。<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />馬兵衝上來，</para>
  <para style="q1" vid="NAM 3:3">刀劍閃耀，長矛閃亮。</para>
  <para style="q1" vid="NAM 3:3">被殺的人眾多，死屍成堆，</para>
  <para style="q1" vid="NAM 3:3">屍體不計其數，</para>
  <para style="q1" vid="NAM 3:3">以致人們絆倒在屍體上。<verse eid="NAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />一切都因這淫婦眾多的淫行，</para>
  <para style="q1" vid="NAM 3:4">這漂亮艷麗的女人行巫術，</para>
  <para style="q1" vid="NAM 3:4">以淫行迷惑<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">迷惑——馬索拉文本作「出賣」。</char></note>列邦，</para>
  <para style="q1" vid="NAM 3:4">以巫術迷惑各族。<verse eid="NAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />這是萬軍之耶和華的宣告：</para>
  <para style="q1" vid="NAM 3:5">看哪，我與你敵對！</para>
  <para style="q1" vid="NAM 3:5">我要掀開你的衣裙，蒙在你臉上，</para>
  <para style="q1" vid="NAM 3:5">讓列邦觀看你的裸體，</para>
  <para style="q1" vid="NAM 3:5">讓各國觀看你的羞辱。<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />我要把可憎之物扔到你身上，</para>
  <para style="q1" vid="NAM 3:6">辱沒你，拿你來示眾。<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />所有看見你的都會逃避你，說：</para>
  <para style="q1" vid="NAM 3:7">「<char style="pn">尼尼微</char>被摧毀了！</para>
  <para style="q1" vid="NAM 3:7">誰會為她悲哀，</para>
  <para style="q1" vid="NAM 3:7">從哪裡找安慰你的人呢？」<verse eid="NAM 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />難道你比<char style="pn">挪亞門</char><note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">挪亞門——希臘語音譯為「底比斯」。</char></note>更優越嗎？</para>
  <para style="q1" vid="NAM 3:8">她坐落在<char style="pn">尼羅</char>河邊，</para>
  <para style="q1" vid="NAM 3:8">大水環繞她，</para>
  <para style="q1" vid="NAM 3:8">海<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">海——指尼羅河；參《以賽亞書》19:5-8。</char></note>是她的壁壘，</para>
  <para style="q1" vid="NAM 3:8">海水是她的城牆。<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />
    <char style="pn">庫實</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:9 </char>
      <char style="ft" closed="false">庫實——指埃塞俄比亞。</char>
    </note>和<char style="pn">埃及</char>是她的力量，</para>
  <para style="q1" vid="NAM 3:9">無窮無盡；</para>
  <para style="q1" vid="NAM 3:9">
    <char style="pn">普特</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:9 </char>
      <char style="ft" closed="false">普特——指利比亞。</char>
    </note>和<char style="pn">利比亞</char>是她的幫手。<verse eid="NAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />但她還是成了俘虜，被擄去；</para>
  <para style="q1" vid="NAM 3:10">她的幼童在各街頭被摔死，</para>
  <para style="q1" vid="NAM 3:10">她的權貴被抽籤分配，</para>
  <para style="q1" vid="NAM 3:10">她的大臣全都被鎖鏈捆住。<verse eid="NAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11" />你也將這樣醉倒，神志不清<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">神志不清——或譯作「四處躲藏」。</char></note>；</para>
  <para style="q1" vid="NAM 3:11">你也將尋找堡壘躲避仇敵。<verse eid="NAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />你所有的堡壘</para>
  <para style="q1" vid="NAM 3:12">都像無花果樹上的初熟果實，</para>
  <para style="q1" vid="NAM 3:12">一被搖動，就掉進吞吃者口中。<verse eid="NAM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />看哪，</para>
  <para style="q1" vid="NAM 3:13">你當中的軍兵如同女人，</para>
  <para style="q1" vid="NAM 3:13">你各地的城門向仇敵大大敞開，</para>
  <para style="q1" vid="NAM 3:13">火焰吞噬你的門閂。<verse eid="NAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />你取水應對圍困吧！</para>
  <para style="q1" vid="NAM 3:14">加固你的堡壘吧！</para>
  <para style="q1" vid="NAM 3:14">你要進到爛泥中，踹踏泥團，</para>
  <para style="q1" vid="NAM 3:14">並且修繕磚窯。<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />在你那裡，火焰將吞噬你，</para>
  <para style="q1" vid="NAM 3:15">刀劍將剪除你，</para>
  <para style="q1" vid="NAM 3:15">像蝗蝻那樣吞滅你。</para>
  <para style="q1" vid="NAM 3:15">你像蝗蝻那樣增多吧，</para>
  <para style="q1" vid="NAM 3:15">像蝗蟲那樣增多吧！<verse eid="NAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />你增添客商，</para>
  <para style="q1" vid="NAM 3:16">多過天上的星辰。</para>
  <para style="q1" vid="NAM 3:16">但蝗蝻脫殼，就飛走。<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />你的首領多如蝗蟲，</para>
  <para style="q1" vid="NAM 3:17">你的軍官好像成群的螞蚱；</para>
  <para style="q1" vid="NAM 3:17">寒冷時牠們停留在圍欄上，</para>
  <para style="q1" vid="NAM 3:17">太陽一升起，牠們就飛走了，</para>
  <para style="q1" vid="NAM 3:17">沒有人知道牠們在哪裡。<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18" />
    <char style="pn">亞述</char>王啊，</para>
  <para style="q1" vid="NAM 3:18">你的牧人打盹，</para>
  <para style="q1" vid="NAM 3:18">你的貴族安眠，</para>
  <para style="q1" vid="NAM 3:18">你的子民散落在山上，</para>
  <para style="q1" vid="NAM 3:18">沒有人招聚他們。<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />你的創傷無法醫治，</para>
  <para style="q1" vid="NAM 3:19">你的傷勢嚴重。</para>
  <para style="q1" vid="NAM 3:19">凡是聽到你消息的，</para>
  <para style="q1" vid="NAM 3:19">都必因你而鼓掌，</para>
  <para style="q1" vid="NAM 3:19">因為誰不時常遭受你的禍害呢？<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>