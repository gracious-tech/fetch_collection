<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">彌迦書</para>
  <para style="mt">彌迦書</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />
    <char style="pn">猶大</char>王<char style="pn">約坦</char>、<char style="pn">亞哈斯</char>、<char style="pn">希西加</char>年間，耶和華的話語臨到了<char style="pn">摩利沙</char>人<char style="pn">彌迦</char>，這是他所見有關<char style="pn">撒瑪利亞</char>和<char style="pn">耶路撒冷</char>的異象：<verse eid="MIC 1:1" /></para>
  <para style="b" />
  <para style="s">審判臨到以色列</para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />所有的子民哪，你們要聽！</para>
  <para style="q1" vid="MIC 1:2">大地和其上所充滿的，你們要留心聽！</para>
  <para style="q1" vid="MIC 1:2">主耶和華作見證人指控你們，</para>
  <para style="q1" vid="MIC 1:2">主從他的聖殿指控你們。<verse eid="MIC 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />看哪，耶和華從他的居所出來，</para>
  <para style="q1" vid="MIC 1:3">他降臨，踏行大地的高處。<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />群山在他脚下消融，</para>
  <para style="q1" vid="MIC 1:4">山谷也崩裂，如蠟遇火，</para>
  <para style="q1" vid="MIC 1:4">如水從斜坡上沖下來。<verse eid="MIC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />這都是因為<char style="pn">雅各</char>的過犯，</para>
  <para style="q1" vid="MIC 1:5">因為<char style="pn">以色列</char>家的罪惡。</para>
  <para style="q1" vid="MIC 1:5">
    <char style="pn">雅各</char>的過犯在哪裡？</para>
  <para style="q1" vid="MIC 1:5">難道不是在<char style="pn">撒瑪利亞</char>嗎？</para>
  <para style="q1" vid="MIC 1:5">
    <char style="pn">猶大</char>的高壇<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">高壇——七十士譯本作「罪惡」。</char></note>在哪裡？</para>
  <para style="q1" vid="MIC 1:5">難道不是在<char style="pn">耶路撒冷</char>嗎？<verse eid="MIC 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />所以我要使<char style="pn">撒瑪利亞</char></para>
  <para style="q1" vid="MIC 1:6">成為田野的荒堆，</para>
  <para style="q1" vid="MIC 1:6">成為只能栽種葡萄園的地方。</para>
  <para style="q1" vid="MIC 1:6">我要把她的石頭倒在山谷中，</para>
  <para style="q1" vid="MIC 1:6">使她的根基裸露。<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />她所有的雕像都將被打碎，</para>
  <para style="q1" vid="MIC 1:7">所有賣淫的酬金都將被火燒掉，</para>
  <para style="q1" vid="MIC 1:7">我要使她所有的偶像都荒廢；</para>
  <para style="q1" vid="MIC 1:7">她既然從賣淫的酬金得積蓄，</para>
  <para style="q1" vid="MIC 1:7">所積蓄的也必再成為賣淫的酬金。<verse eid="MIC 1:7" /></para>
  <para style="b" />
  <para style="s">審判臨到猶大</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />為此我要哀哭號叫，</para>
  <para style="q1" vid="MIC 1:8">赤身光腳行走；</para>
  <para style="q1" vid="MIC 1:8">我要哀號如豺狗，</para>
  <para style="q1" vid="MIC 1:8">哀鳴如鴕鳥。<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />因為她的創傷無法救治，</para>
  <para style="q1" vid="MIC 1:9">並且蔓延到<char style="pn">猶大</char>，</para>
  <para style="q1" vid="MIC 1:9">延伸到我同胞的城門，</para>
  <para style="q1" vid="MIC 1:9">延伸到<char style="pn">耶路撒冷</char>。<verse eid="MIC 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />你們不要在<char style="pn">迦特</char><note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">迦特——與希伯來語的「報告」諧音。</char></note>報告這事，</para>
  <para style="q1" vid="MIC 1:10">絕不要哭泣！</para>
  <para style="q1" vid="MIC 1:10">要在<char style="pn">伯亞弗拉</char><note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">伯亞弗拉——意思是「塵土之家」。</char></note>打滾於塵土中。<verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />
    <char style="pn">沙斐</char>的居民哪，</para>
  <para style="q1" vid="MIC 1:11">赤身羞恥地走過去吧！</para>
  <para style="q1" vid="MIC 1:11">
    <char style="pn">策楠</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:11 </char>
      <char style="ft" closed="false">策楠——與希伯來語的「出來」諧音。</char>
    </note>的居民不敢出城；</para>
  <para style="q1" vid="MIC 1:11">
    <char style="wj">
      <char style="pn">伯伊澤爾</char>
    </char>在哀號，</para>
  <para style="q1" vid="MIC 1:11">你們失去了立足之地。<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />
    <char style="pn">瑪羅特</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:12 </char>
      <char style="ft" closed="false">瑪羅特——意思是「苦」。</char>
    </note>的居民苦苦等候好消息，</para>
  <para style="q1" vid="MIC 1:12">因為災禍從耶和華那裡</para>
  <para style="q1" vid="MIC 1:12">臨到了<char style="pn">耶路撒冷</char>城門。<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />
    <char style="pn">拉吉</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:13 </char>
      <char style="ft" closed="false">拉吉——與希伯來語的「套車」諧音。</char>
    </note>的居民哪，</para>
  <para style="q1" vid="MIC 1:13">用快馬套車吧！</para>
  <para style="q1" vid="MIC 1:13">你是女子<char style="pn">錫安</char>犯罪的開端，</para>
  <para style="q1" vid="MIC 1:13">
    <char style="pn">以色列</char>的過犯都在你中間找到了。<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />
    <char style="pn">猶大</char>啊<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">猶大啊——輔助詞語；本章下同。</char></note>，</para>
  <para style="q1" vid="MIC 1:14">你要拿出陪嫁禮品送別<char style="pn">摩利沙</char><note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">摩利沙——意思與希伯來語的「未婚妻」相近。</char></note>-<char style="pn">迦特</char>。</para>
  <para style="q1" vid="MIC 1:14">
    <char style="pn">阿克濟</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:14 </char>
      <char style="ft" closed="false">阿克濟——與希伯來語的「虛假、不可靠」諧音。</char>
    </note>的各家對<char style="pn">以色列</char>諸王</para>
  <para style="q1" vid="MIC 1:14">是不可靠的溪流。<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />
    <char style="pn">瑪利沙</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:15 </char>
      <char style="ft" closed="false">瑪利沙——與希伯來語的「占有、征服」諧音。</char>
    </note>的居民哪，</para>
  <para style="q1" vid="MIC 1:15">我要使征服你的再次來到你這裡，</para>
  <para style="q1" vid="MIC 1:15">
    <char style="pn">以色列</char>的尊貴人必逃往<char style="pn">亞杜蘭</char>。<verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />
    <char style="pn">猶大</char>啊，</para>
  <para style="q1" vid="MIC 1:16">為你喜愛的兒女，你剃頭剪髮吧！</para>
  <para style="q1" vid="MIC 1:16">讓你的頭如禿鷹徹底光禿！</para>
  <para style="q1" vid="MIC 1:16">因為他們將被擄走離開你。<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s">欺壓者受審判</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1" />有禍了，那些在床上謀劃奸惡、</para>
  <para style="q1" vid="MIC 2:1">策劃惡事的人！</para>
  <para style="q1" vid="MIC 2:1">早晨天一亮，他們就行動，</para>
  <para style="q1" vid="MIC 2:1">因為手中有權力。<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />他們貪愛田地就搶占，</para>
  <para style="q1" vid="MIC 2:2">貪愛房屋就奪取。</para>
  <para style="q1" vid="MIC 2:2">他們侵奪人的家產，</para>
  <para style="q1" vid="MIC 2:2">掠奪人的繼業。<verse eid="MIC 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 2:3" />因此耶和華如此說：</para>
  <para style="q1" vid="MIC 2:3">看哪，我必針對這族類謀劃災禍！</para>
  <para style="q1" vid="MIC 2:3">你們不能從脖子上甩脫它，</para>
  <para style="q1" vid="MIC 2:3">不能昂首行走，</para>
  <para style="q1" vid="MIC 2:3">因為那是災禍的時候。<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />到那日，</para>
  <para style="q1" vid="MIC 2:4">必有人針對你們吟唱諷刺歌，</para>
  <para style="q1" vid="MIC 2:4">像是在沉痛哀號，說：</para>
  <para style="q1" vid="MIC 2:4">「我們被徹底摧毀了！</para>
  <para style="q1" vid="MIC 2:4">他把子民的繼業轉給別人了！</para>
  <para style="q1" vid="MIC 2:4">他竟然把繼業從我挪去，</para>
  <para style="q1" vid="MIC 2:4">把我們的田地分給了悖逆的人！」<verse eid="MIC 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />確實，將來在耶和華的會眾裡，</para>
  <para style="q1" vid="MIC 2:5">必無人為你抽籤拉量繩分地<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">分地——輔助詞語。</char></note>。<verse eid="MIC 2:5" /></para>
  <para style="b" />
  <para style="s">主的話語被拒絕</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />那些人傳道說：</para>
  <para style="q1" vid="MIC 2:6">「你們不可傳道，</para>
  <para style="q1" vid="MIC 2:6">不可這樣傳道，</para>
  <para style="q1" vid="MIC 2:6">羞辱不會來臨的！」<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />
    <char style="pn">雅各</char>家啊，</para>
  <para style="q1" vid="MIC 2:7">怎麼有人這樣說：</para>
  <para style="q1" vid="MIC 2:7">「耶和華的靈會不耐煩嗎？</para>
  <para style="q1" vid="MIC 2:7">這些會是他的作為嗎？」</para>
  <para style="q1" vid="MIC 2:7">我的話語難道不是</para>
  <para style="q1" vid="MIC 2:7">對行事正直的人有益處嗎？<verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />近來我的子民如仇敵興起！</para>
  <para style="q1" vid="MIC 2:8">你們從那些沒想著戰鬥、</para>
  <para style="q1" vid="MIC 2:8">毫無戒備的過路人身上，</para>
  <para style="q1" vid="MIC 2:8">剝去他們的外衣。<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />你們把我子民中的婦人</para>
  <para style="q1" vid="MIC 2:9">趕出安樂的家園，</para>
  <para style="q1" vid="MIC 2:9">把我所賜的尊嚴</para>
  <para style="q1" vid="MIC 2:9">從她們的幼童永遠奪去。<verse eid="MIC 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />起來，離開吧！</para>
  <para style="q1" vid="MIC 2:10">這裡絕不是安息之地，</para>
  <para style="q1" vid="MIC 2:10">因為它不潔淨，必遭毀滅，</para>
  <para style="q1" vid="MIC 2:10">而且是慘重的禍患。<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />如果有人往來行走，</para>
  <para style="q1" vid="MIC 2:11">以虛妄和謊言欺騙說：</para>
  <para style="q1" vid="MIC 2:11">「我向你傳道，必有淡酒烈酒」，</para>
  <para style="q1" vid="MIC 2:11">那人反倒是這子民的傳道者！<verse eid="MIC 2:11" /></para>
  <para style="b" />
  <para style="s">招聚餘剩之民</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />
    <char style="pn">雅各</char>啊，</para>
  <para style="q1" vid="MIC 2:12">我必招聚你所有的人，</para>
  <para style="q1" vid="MIC 2:12">必聚集<char style="pn">以色列</char>的餘剩之民。</para>
  <para style="q1" vid="MIC 2:12">我要把他們安置在一起，</para>
  <para style="q1" vid="MIC 2:12">像羊群在羊圈裡，</para>
  <para style="q1" vid="MIC 2:12">像牛群在草場上，</para>
  <para style="q1" vid="MIC 2:12">人數眾多，喧鬧歡騰。<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />開路者在他們前面上去，</para>
  <para style="q1" vid="MIC 2:13">他們衝過城門出去；</para>
  <para style="q1" vid="MIC 2:13">他們的王在前面過去，</para>
  <para style="q1" vid="MIC 2:13">耶和華在他們的前頭。<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s">不義的領袖受審判</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />我又說：</para>
  <para style="q1" vid="MIC 3:1">
    <char style="pn">雅各</char>的首領、<char style="pn">以色列</char>家的領袖啊，</para>
  <para style="q1" vid="MIC 3:1">你們聽著！</para>
  <para style="q1" vid="MIC 3:1">難道你們不知道公正嗎？<verse eid="MIC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 3:2" />你們憎恨美善、喜愛邪惡，</para>
  <para style="q1" vid="MIC 3:2">從人們身上剝皮，</para>
  <para style="q1" vid="MIC 3:2">從他們骨頭上剔肉。<verse eid="MIC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3" />你們吃我子民的肉，</para>
  <para style="q1" vid="MIC 3:3">剝他們的皮，</para>
  <para style="q1" vid="MIC 3:3">打碎他們的骨頭，</para>
  <para style="q1" vid="MIC 3:3">把他們切成碎塊放進小鍋，</para>
  <para style="q1" vid="MIC 3:3">切成肉塊放進大鍋。<verse eid="MIC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />必有一天，你們<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">你們——原文直譯「他們」；指行惡的領袖們。本節下同。</char></note>將哀求耶和華，</para>
  <para style="q1" vid="MIC 3:4">他卻不回應你們。</para>
  <para style="q1" vid="MIC 3:4">到那時，</para>
  <para style="q1" vid="MIC 3:4">他必向你們隱藏他的臉，</para>
  <para style="q1" vid="MIC 3:4">因為你們是行惡的。<verse eid="MIC 3:4" /></para>
  <para style="b" />
  <para style="s">假先知受審判</para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 3:5" />至於那些使我子民迷失的先知，</para>
  <para style="q1" vid="MIC 3:5">他們口齒間有可嚼的，</para>
  <para style="q1" vid="MIC 3:5">就宣告平安，</para>
  <para style="q1" vid="MIC 3:5">誰不給他們吃的，</para>
  <para style="q1" vid="MIC 3:5">他們就對誰宣告天罰<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">天罰——或譯作「聖戰」。</char></note>，</para>
  <para style="q1" vid="MIC 3:5">耶和華論到他們如此說：<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />因此黑夜必臨到你們，</para>
  <para style="q1" vid="MIC 3:6">以致沒有異象；</para>
  <para style="q1" vid="MIC 3:6">黑暗必臨到你們，</para>
  <para style="q1" vid="MIC 3:6">以致不能占卜。</para>
  <para style="q1" vid="MIC 3:6">太陽向那些先知沉落，</para>
  <para style="q1" vid="MIC 3:6">白晝對他們變為黑暗。<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />那些先見將蒙羞，</para>
  <para style="q1" vid="MIC 3:7">那些占卜的將慚愧；</para>
  <para style="q1" vid="MIC 3:7">他們全都蒙著嘴，</para>
  <para style="q1" vid="MIC 3:7">因為得不到神的回應。<verse eid="MIC 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />然而我因著耶和華的靈，</para>
  <para style="q1" vid="MIC 3:8">充滿了能力、公正和勇氣，</para>
  <para style="q1" vid="MIC 3:8">可以向<char style="pn">雅各</char>指明他的過犯，</para>
  <para style="q1" vid="MIC 3:8">向<char style="pn">以色列</char>指明他的罪惡。<verse eid="MIC 3:8" /></para>
  <para style="b" />
  <para style="s">錫安被摧毀</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />
    <char style="pn">雅各</char>家的首領、<char style="pn">以色列</char>家的領袖啊，</para>
  <para style="q1" vid="MIC 3:9">你們要聽這話！</para>
  <para style="q1" vid="MIC 3:9">你們憎惡公正，扭曲一切正直，<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />以人血建造<char style="pn">錫安</char>，</para>
  <para style="q1" vid="MIC 3:10">以不義修築<char style="pn">耶路撒冷</char>。<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />這城的首領為賄賂而審判，</para>
  <para style="q1" vid="MIC 3:11">祭司為工價而教導，</para>
  <para style="q1" vid="MIC 3:11">先知為銀子而占卜，</para>
  <para style="q1" vid="MIC 3:11">他們卻仰賴耶和華說：</para>
  <para style="q1" vid="MIC 3:11">「難道耶和華不在我們當中嗎？</para>
  <para style="q1" vid="MIC 3:11">災禍不會臨到我們。」<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />為此，因你們的緣故，</para>
  <para style="q1" vid="MIC 3:12">
    <char style="pn">錫安</char>必像田地那樣被翻耕，</para>
  <para style="q1" vid="MIC 3:12">
    <char style="pn">耶路撒冷</char>將成為荒堆，</para>
  <para style="q1" vid="MIC 3:12">聖殿山將成為荒林的高處。<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s">耶和華將在錫安作王</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 4:1" />在末後的日子，</para>
  <para style="q1" vid="MIC 4:1">耶和華殿的山</para>
  <para style="q1" vid="MIC 4:1">將被堅立為群山之首，</para>
  <para style="q1" vid="MIC 4:1">被高舉超過萬嶺，</para>
  <para style="q1" vid="MIC 4:1">萬民都將湧向這山。<verse eid="MIC 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 4:2" />將有許多民族前往，說：</para>
  <para style="q1" vid="MIC 4:2">「來吧，讓我們上耶和華的山，</para>
  <para style="q1" vid="MIC 4:2">到<char style="pn">雅各</char>神的殿！</para>
  <para style="q1" vid="MIC 4:2">願他把道路指示給我們，</para>
  <para style="q1" vid="MIC 4:2">好讓我們遵行他的道。」</para>
  <para style="q1" vid="MIC 4:2">因為訓誨從<char style="pn">錫安</char>而出，</para>
  <para style="q1" vid="MIC 4:2">耶和華的話語從<char style="pn">耶路撒冷</char>而來。<verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />他將在許多民族之間施行審判，</para>
  <para style="q1" vid="MIC 4:3">為遠方強盛的列國作出裁決。</para>
  <para style="q1" vid="MIC 4:3">他們將把刀劍打成犁頭，</para>
  <para style="q1" vid="MIC 4:3">把長矛打成鐮刀；</para>
  <para style="q1" vid="MIC 4:3">這國不舉起刀劍攻擊那國，</para>
  <para style="q1" vid="MIC 4:3">他們不再學習戰事。<verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />各人安坐</para>
  <para style="q1" vid="MIC 4:4">在自己的葡萄樹和無花果樹下，</para>
  <para style="q1" vid="MIC 4:4">無人驚嚇。</para>
  <para style="q1" vid="MIC 4:4">這是萬軍之耶和華親口說的。<verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />列邦各奉自己神的名而行，</para>
  <para style="q1" vid="MIC 4:5">我們卻要奉我們神耶和華的名而行，</para>
  <para style="q1" vid="MIC 4:5">直到永永遠遠。<verse eid="MIC 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6" />這是耶和華的宣告：</para>
  <para style="q1" vid="MIC 4:6">到那日，我必招聚瘸腿的，</para>
  <para style="q1" vid="MIC 4:6">聚集被驅散的，以及我所懲治的。<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />我要使瘸腿的成為餘剩之民，</para>
  <para style="q1" vid="MIC 4:7">使被放逐的成為強盛之國。</para>
  <para style="q1" vid="MIC 4:7">耶和華要在<char style="pn">錫安</char>山作王統治他們，</para>
  <para style="q1" vid="MIC 4:7">從今直到永遠。<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />至於你，羊群的守望塔<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">羊群的守望塔——或音譯「伊德高臺」。</char></note>，</para>
  <para style="q1" vid="MIC 4:8">女子<char style="pn">錫安</char>的山岡啊，</para>
  <para style="q1" vid="MIC 4:8">那先前的權柄、女子<char style="pn">耶路撒冷</char>的國權，</para>
  <para style="q1" vid="MIC 4:8">將復歸於你。<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="s">被擄後得解救</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />現在你為什麼大聲哭號呢？</para>
  <para style="q1" vid="MIC 4:9">難道你中間沒有君王，</para>
  <para style="q1" vid="MIC 4:9">或者你的謀士都消亡了，</para>
  <para style="q1" vid="MIC 4:9">以致劇痛抓住你，像婦人臨產那樣嗎？<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />女子<char style="pn">錫安</char>哪，</para>
  <para style="q1" vid="MIC 4:10">像臨產婦人那樣痛苦呻吟吧！</para>
  <para style="q1" vid="MIC 4:10">現在你必從城中出來，</para>
  <para style="q1" vid="MIC 4:10">居住在野外，然後到<char style="pn">巴比倫</char>去。</para>
  <para style="q1" vid="MIC 4:10">在那裡你將得解救，</para>
  <para style="q1" vid="MIC 4:10">耶和華必救贖你脫離仇敵的手。<verse eid="MIC 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />現在許多民族聚集起來攻擊你，說：</para>
  <para style="q1" vid="MIC 4:11">「願<char style="pn">錫安</char>被玷汙，</para>
  <para style="q1" vid="MIC 4:11">我們要觀賞她！」<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />他們卻不知道耶和華的意念，</para>
  <para style="q1" vid="MIC 4:12">也不明白他的謀劃；</para>
  <para style="q1" vid="MIC 4:12">其實他聚集他們，</para>
  <para style="q1" vid="MIC 4:12">就像把禾捆聚集到打穀場上。<verse eid="MIC 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />女子<char style="pn">錫安</char>哪，你起來踹穀吧！</para>
  <para style="q1" vid="MIC 4:13">我必使你的犄角成為鐵的，</para>
  <para style="q1" vid="MIC 4:13">使你的蹄子成為銅的。</para>
  <para style="q1" vid="MIC 4:13">你將磨碎許多民族，</para>
  <para style="q1" vid="MIC 4:13">把戰利品永獻給耶和華，</para>
  <para style="q1" vid="MIC 4:13">把他們的財富歸給全地的主。<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="s">一位得勝的君王<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">此章在馬索拉文本為4:14至5:14。</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1" />你這被圍攻的女子啊，</para>
  <para style="q1" vid="MIC 5:1">割傷自己吧！</para>
  <para style="q1" vid="MIC 5:1">我們被圍困了！</para>
  <para style="q1" vid="MIC 5:1">敵人要用杖擊打<char style="pn">以色列</char>審判官的臉頰。<verse eid="MIC 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />
    <char style="pn">伯利恆</char>-<char style="pn">以法他</char>啊，</para>
  <para style="q1" vid="MIC 5:2">你在<char style="pn">猶大</char>各宗族的城<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">各宗族的城——原文直譯「一千」；常用於表示群體單位。</char></note>中雖然微小，</para>
  <para style="q1" vid="MIC 5:2">但從你中間將出來一個人，</para>
  <para style="q1" vid="MIC 5:2">為我作<char style="pn">以色列</char>的掌權者。</para>
  <para style="q1" vid="MIC 5:2">他的根源從太初就在，</para>
  <para style="q1" vid="MIC 5:2">從亙古的日子就有。<verse eid="MIC 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />因此耶和華將把他們交出去<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">把他們交出去——或譯作「把以色列人交付敵人」。</char></note>，</para>
  <para style="q1" vid="MIC 5:3">直到那臨產的婦人生孩子的時候。</para>
  <para style="q1" vid="MIC 5:3">那時，他餘剩的兄弟們</para>
  <para style="q1" vid="MIC 5:3">將重新歸入<char style="pn">以色列</char>子孫。<verse eid="MIC 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />他必興起，以耶和華的大能，</para>
  <para style="q1" vid="MIC 5:4">以他的神耶和華之名的威嚴牧養他們；</para>
  <para style="q1" vid="MIC 5:4">他們將安然居住，</para>
  <para style="q1" vid="MIC 5:4">因為那時他將尊大直到地極。<verse eid="MIC 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />這一位就是我們的平安。</para>
  <para style="q1" vid="MIC 5:5">當<char style="pn">亞述</char>入侵我們的土地，</para>
  <para style="q1" vid="MIC 5:5">踐踏我們的城堡時，</para>
  <para style="q1" vid="MIC 5:5">我們會興起</para>
  <para style="q1" vid="MIC 5:5">七個牧人、八個首領對付他，<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />他們以刀劍統管<char style="pn">亞述</char>地，</para>
  <para style="q1" vid="MIC 5:6">以拔出的劍統管<char style="pn">寧錄</char>地。</para>
  <para style="q1" vid="MIC 5:6">當<char style="pn">亞述</char>入侵我們的土地、</para>
  <para style="q1" vid="MIC 5:6">踐踏我們的地界時，</para>
  <para style="q1" vid="MIC 5:6">他必從<char style="pn">亞述</char>手中解救我們。<verse eid="MIC 5:6" /></para>
  <para style="b" />
  <para style="s">榮耀聖潔的餘剩之民</para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />那時，<char style="pn">雅各</char>的餘剩之民</para>
  <para style="q1" vid="MIC 5:7">在許多民族當中，</para>
  <para style="q1" vid="MIC 5:7">就像耶和華賜下的甘露，</para>
  <para style="q1" vid="MIC 5:7">又像牧草上的甘霖；</para>
  <para style="q1" vid="MIC 5:7">他們不仰望人，</para>
  <para style="q1" vid="MIC 5:7">也不期待世人。<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />
    <char style="pn">雅各</char>的餘剩之民</para>
  <para style="q1" vid="MIC 5:8">在列國中，在許多民族當中，</para>
  <para style="q1" vid="MIC 5:8">就像森林百獸中的獅子，</para>
  <para style="q1" vid="MIC 5:8">又像羊群中的少壯獅子；</para>
  <para style="q1" vid="MIC 5:8">他若經過，就踩踏撕碎，</para>
  <para style="q1" vid="MIC 5:8">無人解救。<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />願你的手高舉，</para>
  <para style="q1" vid="MIC 5:9">勝過你的敵人，</para>
  <para style="q1" vid="MIC 5:9">願你的一切仇敵都被剪除！<verse eid="MIC 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="MIC 5:10" />這是耶和華的宣告：</para>
  <para style="q1" vid="MIC 5:10">到那日，</para>
  <para style="q1" vid="MIC 5:10">我必從你中間剪除你的馬匹，</para>
  <para style="q1" vid="MIC 5:10">摧毀你的戰車。<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />我要剪除你境內的城鎮，</para>
  <para style="q1" vid="MIC 5:11">拆毀你所有的堡壘。<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />我要從你手中剪除巫術，</para>
  <para style="q1" vid="MIC 5:12">你那裡絕不再有算命者。<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />我要從你當中剪除你的雕像和神柱，</para>
  <para style="q1" vid="MIC 5:13">你不會再向自己手所做的下拜。<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />我要從你中間拔出<char style="pn">亞舍拉</char>柱，</para>
  <para style="q1" vid="MIC 5:14">毀滅你的城鎮。<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />我要在怒氣和怒火中，</para>
  <para style="q1" vid="MIC 5:15">向那些不聽從我的國家施行報復。<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s">主對猶大的指控</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />你們要聽耶和華所說的：</para>
  <para style="q1" vid="MIC 6:1">起來，在群山面前申辯吧，</para>
  <para style="q1" vid="MIC 6:1">讓山嶺聽見你的聲音；<verse eid="MIC 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />群山和大地恆久的根基啊，</para>
  <para style="q1" vid="MIC 6:2">請聽耶和華的爭訟！</para>
  <para style="q1" vid="MIC 6:2">因為耶和華與他的子民有爭訟，</para>
  <para style="q1" vid="MIC 6:2">與<char style="pn">以色列</char>辯論。<verse eid="MIC 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />我的子民哪，我對你做了什麼，</para>
  <para style="q1" vid="MIC 6:3">我在什麼事上使你厭煩呢？</para>
  <para style="q1" vid="MIC 6:3">你指證我吧！<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />是我把你從<char style="pn">埃及</char>地帶上來，</para>
  <para style="q1" vid="MIC 6:4">從為奴之家救贖出來，</para>
  <para style="q1" vid="MIC 6:4">又派遣了<char style="pn">摩西</char>、<char style="pn">亞倫</char>和<char style="pn">米利暗</char>帶領你。<verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />我的子民哪，</para>
  <para style="q1" vid="MIC 6:5">你們要回想<char style="pn">摩押</char>王<char style="pn">巴勒</char>策劃了什麼，</para>
  <para style="q1" vid="MIC 6:5">
    <char style="pn">比珥</char>的兒子<char style="pn">巴蘭</char>答應了他什麼，</para>
  <para style="q1" vid="MIC 6:5">以及從<char style="pn">什亭</char>到<char style="pn">吉甲</char>發生了什麼，</para>
  <para style="q1" vid="MIC 6:5">好使你們明白耶和華的公義行為。<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />我朝見耶和華，向至高的神跪拜時，</para>
  <para style="q1" vid="MIC 6:6">要獻上什麼呢？</para>
  <para style="q1" vid="MIC 6:6">難道我要帶著燔祭，</para>
  <para style="q1" vid="MIC 6:6">帶著一歲的公牛犢朝見他嗎？<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />難道耶和華喜悅</para>
  <para style="q1" vid="MIC 6:7">千千的公羊，萬萬的油河嗎？</para>
  <para style="q1" vid="MIC 6:7">難道我可以為自己的過犯獻上長子，</para>
  <para style="q1" vid="MIC 6:7">為自己的罪惡獻上親生兒女<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">親生兒女——原文直譯「腹中的出產」。</char></note>嗎？<verse eid="MIC 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />世人哪，耶和華已經告訴你了，</para>
  <para style="q1" vid="MIC 6:8">什麼是美善，</para>
  <para style="q1" vid="MIC 6:8">什麼是耶和華向你要求的：</para>
  <para style="q1" vid="MIC 6:8">他只要你實行公正，</para>
  <para style="q1" vid="MIC 6:8">喜愛恩慈<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">恩慈——或譯作「信實的愛」。</char></note>，</para>
  <para style="q1" vid="MIC 6:8">心存謙卑與你的神同行。<verse eid="MIC 6:8" /></para>
  <para style="b" />
  <para style="s">主的判決</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />耶和華向這城發聲呼喊！</para>
  <para style="q1" vid="MIC 6:9">敬畏他<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">他——原文直譯「你」。</char></note>的名是真智慧，</para>
  <para style="q1" vid="MIC 6:9">這支派和這城的會眾啊，</para>
  <para style="q1" vid="MIC 6:9">你們要聆聽<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">這支派和這城的會眾啊，你們要聆聽——或譯作「你們當聽從這權杖和指派它的那一位」。</char></note>：<verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />惡人家中不是還有不義之財，</para>
  <para style="q1" vid="MIC 6:10">有可憎的縮小<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">縮小——或譯作「詭詐」。</char></note>量斗<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">量斗——原文直譯「伊法」；相當於22公升的穀物量器。</char></note>嗎？<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />人用不義的天平和欺詐的砝碼，</para>
  <para style="q1" vid="MIC 6:11">難道我能看為清正嗎？<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">此節或譯作：我如果用不義的天平和欺詐的砝碼，難道能顯為清潔嗎？</char></note><verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />城中的富人充滿惡行，</para>
  <para style="q1" vid="MIC 6:12">城中的居民說虛假的話，</para>
  <para style="q1" vid="MIC 6:12">他們的舌頭滿口是詭詐。<verse eid="MIC 6:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />因此我要重重擊打你，</para>
  <para style="q1" vid="MIC 6:13">使你因罪惡而荒涼。<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />你吃卻吃不飽，飢腸轆轆。</para>
  <para style="q1" vid="MIC 6:14">你所獲取的，無法保全；</para>
  <para style="q1" vid="MIC 6:14">你所保全的，我必交給刀劍。<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />你播種卻沒有收獲，</para>
  <para style="q1" vid="MIC 6:15">踹橄欖卻不能用油抹身，</para>
  <para style="q1" vid="MIC 6:15">踹葡萄卻喝不到葡萄酒。<verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />你持守了<char style="pn">歐姆利</char>的習俗和</para>
  <para style="q1" vid="MIC 6:16">
    <char style="pn">亞哈</char>家的一切作為，</para>
  <para style="q1" vid="MIC 6:16">隨從他們的計謀，</para>
  <para style="q1" vid="MIC 6:16">因此我要使你成為荒場<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">成為荒場——或譯作「令人驚駭」。</char></note>，</para>
  <para style="q1" vid="MIC 6:16">使你的居民被嗤笑，</para>
  <para style="q1" vid="MIC 6:16">你們必擔當我子民的羞辱。<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s">以色列的敗壞</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1" />我多麼悲慘！</para>
  <para style="q1" vid="MIC 7:1">就像采摘夏季的果實，</para>
  <para style="q1" vid="MIC 7:1">又像採收遺落的葡萄，</para>
  <para style="q1" vid="MIC 7:1">卻找不到一串可吃的，</para>
  <para style="q1" vid="MIC 7:1">找不到我渴望的初熟無花果。<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />忠信者從地上消亡了，</para>
  <para style="q1" vid="MIC 7:2">世人中沒有一個正直人。</para>
  <para style="q1" vid="MIC 7:2">他們全都埋伏殺人流血，</para>
  <para style="q1" vid="MIC 7:2">用網羅彼此獵取。<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />他們雙手擅長作惡，</para>
  <para style="q1" vid="MIC 7:3">首領和審判官索要賄賂，</para>
  <para style="q1" vid="MIC 7:3">權貴們交談心中的貪慾，</para>
  <para style="q1" vid="MIC 7:3">他們相互勾結。<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />他們中最好的就像荊棘，</para>
  <para style="q1" vid="MIC 7:4">最正直的也不過是蒺藜。</para>
  <para style="q1" vid="MIC 7:4">你的守望者們所預言的日子，</para>
  <para style="q1" vid="MIC 7:4">你受懲罰的日子已經來到，</para>
  <para style="q1" vid="MIC 7:4">現在他們必定驚惶。<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />不要相信朋友，</para>
  <para style="q1" vid="MIC 7:5">不要信賴同伴，</para>
  <para style="q1" vid="MIC 7:5">連躺在你懷中的妻子，</para>
  <para style="q1" vid="MIC 7:5">你也要向她謹守你的口。<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />因為兒子將敵視父親，</para>
  <para style="q1" vid="MIC 7:6">女兒將起來敵對母親，</para>
  <para style="q1" vid="MIC 7:6">兒媳將敵對婆婆，</para>
  <para style="q1" vid="MIC 7:6">人的仇敵就是自己的家人。<verse eid="MIC 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />但我仍要守候耶和華，</para>
  <para style="q1" vid="MIC 7:7">等候神我的救主，</para>
  <para style="q1" vid="MIC 7:7">我的神必垂聽我。<verse eid="MIC 7:7" /></para>
  <para style="b" />
  <para style="s">為錫安施行公正</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />我的仇敵啊，不要對我幸災樂禍！</para>
  <para style="q1" vid="MIC 7:8">我雖然仆倒，仍將起來；</para>
  <para style="q1" vid="MIC 7:8">我雖然坐在黑暗裡，</para>
  <para style="q1" vid="MIC 7:8">耶和華必作我的光。<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />我應當承受耶和華的憤怒，</para>
  <para style="q1" vid="MIC 7:9">因為我對他犯了罪；</para>
  <para style="q1" vid="MIC 7:9">直到他為我辯護，</para>
  <para style="q1" vid="MIC 7:9">為我施行公正。</para>
  <para style="q1" vid="MIC 7:9">那時他將領我出黑暗<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">黑暗——輔助詞語。</char></note>，入光明，</para>
  <para style="q1" vid="MIC 7:9">我將看見他的公義。<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />我的仇敵看見了，</para>
  <para style="q1" vid="MIC 7:10">就必被羞恥淹沒，</para>
  <para style="q1" vid="MIC 7:10">他曾對我說：</para>
  <para style="q1" vid="MIC 7:10">「你的神耶和華在哪裡呢？」</para>
  <para style="q1" vid="MIC 7:10">我必親眼看他遭報，</para>
  <para style="q1" vid="MIC 7:10">那時他將被踐踏，</para>
  <para style="q1" vid="MIC 7:10">如同街上的爛泥。<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />必有一天，要重建你的圍牆；</para>
  <para style="q1" vid="MIC 7:11">那一天，你的地界將擴展；<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />那一天，</para>
  <para style="q1" vid="MIC 7:12">從<char style="pn">亞述</char>到<char style="pn">埃及</char>的城鎮，</para>
  <para style="q1" vid="MIC 7:12">從<char style="pn">埃及</char>到大河，</para>
  <para style="q1" vid="MIC 7:12">從這海到那海，</para>
  <para style="q1" vid="MIC 7:12">從這山到那山，</para>
  <para style="q1" vid="MIC 7:12">人們將來到你這裡。<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />全地卻將因其上的居民，</para>
  <para style="q1" vid="MIC 7:13">因他們行為所結的果實而荒涼。<verse eid="MIC 7:13" /></para>
  <para style="b" />
  <para style="s">彌迦的禱告</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14" />求你用你的杖牧養你的子民，</para>
  <para style="q1" vid="MIC 7:14">牧養你的產業、你的羊群，</para>
  <para style="q1" vid="MIC 7:14">他們獨自安居在林間，在果園中；</para>
  <para style="q1" vid="MIC 7:14">願他們在<char style="pn">巴珊</char>和<char style="pn">基列</char>得牧養，</para>
  <para style="q1" vid="MIC 7:14">像古時的日子那樣。<verse eid="MIC 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />「我必向他顯明奇妙的事，</para>
  <para style="q1" vid="MIC 7:15">就像你出<char style="pn">埃及</char>地的日子那樣。」<verse eid="MIC 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />列國看見了，</para>
  <para style="q1" vid="MIC 7:16">就為他們的一切勢力羞慚，</para>
  <para style="q1" vid="MIC 7:16">捂住嘴巴，耳朵變聾。<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />他們將舔土如蛇，</para>
  <para style="q1" vid="MIC 7:17">如地上的爬蟲；</para>
  <para style="q1" vid="MIC 7:17">他們將顫抖著從他們的營寨出來。</para>
  <para style="q1" vid="MIC 7:17">他們來到我們的神耶和華面前，</para>
  <para style="q1" vid="MIC 7:17">戰戰兢兢，因你而害怕。<verse eid="MIC 7:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />神哪，有哪一位能像你赦免罪孽，</para>
  <para style="q1" vid="MIC 7:18">除去你產業餘剩之民的過犯呢？</para>
  <para style="q1" vid="MIC 7:18">你不永遠懷怒，</para>
  <para style="q1" vid="MIC 7:18">而是喜愛施行恩慈<note caller="+" style="f"><char style="fr" closed="false">7:18 </char><char style="ft" closed="false">恩慈——或譯作「信實的愛」；下同。</char></note>。<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />你會重新憐憫我們，</para>
  <para style="q1" vid="MIC 7:19">制伏我們的罪孽；</para>
  <para style="q1" vid="MIC 7:19">你會把我們<note caller="+" style="f"><char style="fr" closed="false">7:19 </char><char style="ft" closed="false">我們——依據七十士譯本；馬索拉文本作「他們」。</char></note>所有的罪惡都拋入海洋深處。<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />你必照著你古時向我們祖先所起的誓，</para>
  <para style="q1" vid="MIC 7:20">向<char style="pn">雅各</char>顯出信實，</para>
  <para style="q1" vid="MIC 7:20">向<char style="pn">亞伯拉罕</char>施行恩慈。<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>