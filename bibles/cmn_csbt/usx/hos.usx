<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">何西阿書</para>
  <para style="mt">何西阿書</para>
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />在<char style="pn">烏西雅</char>、<char style="pn">約坦</char>、<char style="pn">亞哈斯</char>、<char style="pn">希西加</char>作<char style="pn">猶大</char>王，<char style="pn">約阿施</char>的兒子<char style="pn">耶羅波安</char>作<char style="pn">以色列</char>王的日子，耶和華的話語臨到了<char style="pn">貝爾里</char>的兒子<char style="pn">何西阿</char>。<verse eid="HOS 1:1" /></para>
  <para style="s">何西阿的婚姻與孩子</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />耶和華初次與<char style="pn">何西阿</char>說話。耶和華對<char style="pn">何西阿</char>說：</para>
  <para style="q1" vid="HOS 1:2">「你去，娶一個淫亂的女人，</para>
  <para style="q1" vid="HOS 1:2">得淫亂所生的孩子。</para>
  <para style="q1" vid="HOS 1:2">因為這地放縱行淫，</para>
  <para style="q1" vid="HOS 1:2">背棄了耶和華。」<verse eid="HOS 1:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="HOS 1:3" />他就去，娶了<char style="pn">迪布拉音</char>的女兒<char style="pn">格梅爾</char>。<char style="pn">格梅爾</char>懷孕，為他生了一個兒子。 <verse eid="HOS 1:3" /><verse number="4" style="v" sid="HOS 1:4" />耶和華對<char style="pn">何西阿</char>說：</para>
  <para style="q1" vid="HOS 1:4">「你要給他起名為<char style="pn">耶斯列</char>。</para>
  <para style="q1" vid="HOS 1:4">因為再過片刻，</para>
  <para style="q1" vid="HOS 1:4">我要向<char style="pn">耶戶</char>家追討<char style="pn">耶斯列</char>的血債，</para>
  <para style="q1" vid="HOS 1:4">並且使<char style="pn">以色列</char>家的王國終止。<verse eid="HOS 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 1:5" />到那日，我必在<char style="pn">耶斯列</char>平原</para>
  <para style="q1" vid="HOS 1:5">折斷<char style="pn">以色列</char>的弓。」<verse eid="HOS 1:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />後來<char style="pn">格梅爾</char>又懷孕，生了一個女兒。耶和華對<char style="pn">何西阿</char>說：</para>
  <para style="q1" vid="HOS 1:6">「你要給她起名為<char style="pn">羅茹哈瑪</char><note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">羅茹哈瑪——意思是「那不蒙憐憫的」；下同。</char></note>。</para>
  <para style="q1" vid="HOS 1:6">因為我絕不再憐憫<char style="pn">以色列</char>家，</para>
  <para style="q1" vid="HOS 1:6">我絕不饒恕他們。<verse eid="HOS 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 1:7" />我卻要憐憫<char style="pn">猶大</char>家；</para>
  <para style="q1" vid="HOS 1:7">我要使他們靠他們的神耶和華得救，</para>
  <para style="q1" vid="HOS 1:7">而不是靠弓、刀、武力<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">武力——或譯作「爭戰」。</char></note>、</para>
  <para style="q1" vid="HOS 1:7">馬匹和馬兵得救。」<verse eid="HOS 1:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />
    <char style="pn">格梅爾</char>給<char style="pn">羅茹哈瑪</char>斷奶以後，又懷孕，生了一個兒子。 <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />耶和華說：</para>
  <para style="q1" vid="HOS 1:9">「你要給他起名為<char style="pn">羅阿米</char><note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">羅阿米——意思是「不是我的子民」。</char></note>。</para>
  <para style="q1" vid="HOS 1:9">因為你們不是我的子民，</para>
  <para style="q1" vid="HOS 1:9">我也不是你們的神<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">神——原文直譯「我是」。</char></note>！」<verse eid="HOS 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="HOS 1:10" />然而，<char style="pn">以色列</char>子孫的數目</para>
  <para style="q1" vid="HOS 1:10">將多如海沙，</para>
  <para style="q1" vid="HOS 1:10">無法測量，無法數清。</para>
  <para style="q1" vid="HOS 1:10">從前在什麼地方對他們</para>
  <para style="q1" vid="HOS 1:10">說「你們不是我的子民」，</para>
  <para style="q1" vid="HOS 1:10">就在那裡，他們將被</para>
  <para style="q1" vid="HOS 1:10">稱為「永生神的兒女」。<verse eid="HOS 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 1:11" />
    <char style="pn">猶大</char>子孫和<char style="pn">以色列</char>子孫</para>
  <para style="q1" vid="HOS 1:11">將聚集在一起，</para>
  <para style="q1" vid="HOS 1:11">為自己立一位首領，</para>
  <para style="q1" vid="HOS 1:11">從這地上去。</para>
  <para style="q1" vid="HOS 1:11">
    <char style="pn">耶斯列</char>的日子實在是大日子！<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 2:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">2:1 </char>
      <char style="ft" closed="false">此章在馬索拉文本為2:3至2:25。</char>
    </note>那時，你們要</para>
  <para style="q1" vid="HOS 2:1">稱你們的兄弟為「我的子民<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">我的子民——音譯作「阿米」。</char></note>」，</para>
  <para style="q1" vid="HOS 2:1">稱你們的姐妹為「蒙憐憫的<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">蒙憐憫的——音譯作「茹哈瑪」。</char></note>」。<verse eid="HOS 2:1" /></para>
  <para style="b" />
  <para style="s">責罰以色列的淫行</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2" />你們要譴責你們的母親，要譴責她；</para>
  <para style="q1" vid="HOS 2:2">她已經不是我的妻子，</para>
  <para style="q1" vid="HOS 2:2">我也不是她的丈夫！</para>
  <para style="q1" vid="HOS 2:2">要讓她除掉臉上的淫相，</para>
  <para style="q1" vid="HOS 2:2">除掉雙乳間的淫蕩，<verse eid="HOS 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3" />免得我把她剝光，</para>
  <para style="q1" vid="HOS 2:3">使她赤裸如剛出生時那樣。</para>
  <para style="q1" vid="HOS 2:3">我要使她如同荒漠，</para>
  <para style="q1" vid="HOS 2:3">如同乾旱之地，</para>
  <para style="q1" vid="HOS 2:3">我要使她因乾渴而死。<verse eid="HOS 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4" />她的兒女，我也不會憐憫，</para>
  <para style="q1" vid="HOS 2:4">因為他們是淫亂所生的兒女。<verse eid="HOS 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5" />他們的母親實在淫亂，</para>
  <para style="q1" vid="HOS 2:5">那孕育他們的行了羞恥的事。</para>
  <para style="q1" vid="HOS 2:5">她竟然說：「我要隨從我的情人，</para>
  <para style="q1" vid="HOS 2:5">是他們給了我餅和水、</para>
  <para style="q1" vid="HOS 2:5">羊毛和細麻、油和酒。」<verse eid="HOS 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6" />所以看哪，</para>
  <para style="q1" vid="HOS 2:6">我要用荊棘堵住她的道路；</para>
  <para style="q1" vid="HOS 2:6">我要築牆攔住她，</para>
  <para style="q1" vid="HOS 2:6">使她找不到路徑。<verse eid="HOS 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7" />她追趕她的情人卻追不上，</para>
  <para style="q1" vid="HOS 2:7">尋找他們卻找不到，</para>
  <para style="q1" vid="HOS 2:7">就會說：</para>
  <para style="q1" vid="HOS 2:7">「我還是回到我第一個丈夫那裡去吧，</para>
  <para style="q1" vid="HOS 2:7">我那時比現在好！」<verse eid="HOS 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8" />她不知道，</para>
  <para style="q1" vid="HOS 2:8">是我賜給了她五穀、新酒和新油，</para>
  <para style="q1" vid="HOS 2:8">也給她增添了金銀——</para>
  <para style="q1" vid="HOS 2:8">他們竟把這些<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">把這些——輔助詞語。</char></note>獻給<char style="pn">巴力</char>！<verse eid="HOS 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9" />因此我要在收割時收回我的五穀，</para>
  <para style="q1" vid="HOS 2:9">在釀酒的季節收回我的新酒，</para>
  <para style="q1" vid="HOS 2:9">我要收走我給她遮體用的羊毛和細麻。<verse eid="HOS 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10" />現在我要在她情人們眼前</para>
  <para style="q1" vid="HOS 2:10">暴露她的醜態，</para>
  <para style="q1" vid="HOS 2:10">無人能從我手中解救她。<verse eid="HOS 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11" />我要終止她所有的歡慶，</para>
  <para style="q1" vid="HOS 2:11">終止她的節期、新月節、安息日</para>
  <para style="q1" vid="HOS 2:11">以及她所有的約期。<verse eid="HOS 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12" />我必摧毀她的葡萄樹和無花果樹，</para>
  <para style="q1" vid="HOS 2:12">因為她說：</para>
  <para style="q1" vid="HOS 2:12">「這些是我的情人們送給我的賞賜。」</para>
  <para style="q1" vid="HOS 2:12">我要使這些果樹成為荒林，</para>
  <para style="q1" vid="HOS 2:12">被田野的走獸吞吃。<verse eid="HOS 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13" />我必懲罰她，</para>
  <para style="q1" vid="HOS 2:13">因為她在<char style="pn">巴力</char>的節日向它們燒香；</para>
  <para style="q1" vid="HOS 2:13">那時她佩戴耳環和飾品，</para>
  <para style="q1" vid="HOS 2:13">隨從她的情人們，</para>
  <para style="q1" vid="HOS 2:13">反而把我忘記。</para>
  <para style="q1" vid="HOS 2:13">這是耶和華的宣告。<verse eid="HOS 2:13" /></para>
  <para style="b" />
  <para style="s">淫亂的以色列得赦免</para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14" />所以看哪，我要說服她，</para>
  <para style="q1" vid="HOS 2:14">把她帶到曠野去，</para>
  <para style="q1" vid="HOS 2:14">對她說寬心的話。<verse eid="HOS 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15" />我要在那裡把她的葡萄園給她，</para>
  <para style="q1" vid="HOS 2:15">使<char style="pn">亞割</char>谷成為她的希望之門。</para>
  <para style="q1" vid="HOS 2:15">她必在那裡回應我，</para>
  <para style="q1" vid="HOS 2:15">像她年幼時的日子，</para>
  <para style="q1" vid="HOS 2:15">像從<char style="pn">埃及</char>地上來的日子那樣。<verse eid="HOS 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16" />這是耶和華的宣告：</para>
  <para style="q1" vid="HOS 2:16">到那日，</para>
  <para style="q1" vid="HOS 2:16">你必稱呼我<char style="pn">伊施</char><note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">伊施——或譯作「我的丈夫」。</char></note>，</para>
  <para style="q1" vid="HOS 2:16">不再稱呼我<char style="pn">巴力</char><note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">巴力——或譯作「我的主」。</char></note>。<verse eid="HOS 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17" />我要從她口中除掉<char style="pn">巴力</char>的名號，</para>
  <para style="q1" vid="HOS 2:17">這些名號絕不再被提起。<verse eid="HOS 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18" />到那日，我必為我的民，</para>
  <para style="q1" vid="HOS 2:18">與田野的走獸、天空的飛鳥、</para>
  <para style="q1" vid="HOS 2:18">地上的爬蟲立約；</para>
  <para style="q1" vid="HOS 2:18">我也要從地上折斷弓刀，</para>
  <para style="q1" vid="HOS 2:18">止息戰爭，</para>
  <para style="q1" vid="HOS 2:18">使他們安然躺臥。<verse eid="HOS 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19" />我要聘娶你歸我，直到永遠；</para>
  <para style="q1" vid="HOS 2:19">我要以公義、公正、恩慈和憐憫，</para>
  <para style="q1" vid="HOS 2:19">聘娶你歸我；<verse eid="HOS 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20" />我要以信實聘娶你歸我。</para>
  <para style="q1" vid="HOS 2:20">那時，你必認識耶和華。<verse eid="HOS 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21" />這是耶和華的宣告：</para>
  <para style="q1" vid="HOS 2:21">到那日，我必應允，</para>
  <para style="q1" vid="HOS 2:21">我應允天，天應允地，<verse eid="HOS 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22" />地應允五穀、新酒和新油，</para>
  <para style="q1" vid="HOS 2:22">它們應允<char style="pn">耶斯列</char>。<verse eid="HOS 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23" />我要為自己把她栽種在這地；</para>
  <para style="q1" vid="HOS 2:23">我要憐憫<char style="pn">羅茹哈瑪</char><note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">羅茹哈瑪——或譯作「那不蒙憐憫的」。</char></note>，</para>
  <para style="q1" vid="HOS 2:23">對<char style="pn">羅阿米</char><note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">羅阿米——或譯作「那不是我子民的」。</char></note>說：「你是我的子民」，</para>
  <para style="q1" vid="HOS 2:23">他也將說：「你是我的神。」<verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="s">等待以色列回轉</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />耶和華對我說：「你再去愛那個另有新歡的女人，那個淫婦；正如耶和華愛<char style="pn">以色列</char>子民，雖然他們轉向了別的神，貪愛葡萄餅。」<verse eid="HOS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2" />於是，我用十五塊銀子、一賀梅珥<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">一賀梅珥——相當於220公升。</char></note>半<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">半——原文作「勒特克」；1勒特克=110公升。</char></note>的大麥，把她買回來歸我。 <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />我對她說：「你要為我獨居多日；不可淫亂，不可歸屬別的男人，我也不會親近你<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">我也不會親近你——或譯作「我也會同樣對你忠誠」。</char></note>。」<verse eid="HOS 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4" />
    <char style="pn">以色列</char>子民必獨居多日，沒有君王，沒有首領，沒有獻祭，沒有神柱，沒有以弗得和家族神像。 <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />之後，<char style="pn">以色列</char>子民將回轉，尋求耶和華他們的神，尋求<char style="pn">大衛</char>他們的王。在末後的日子，他們將以敬畏的心尋求耶和華和他的美福。<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="s">耶和華指控以色列</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1" />
    <char style="pn">以色列</char>子孫哪，</para>
  <para style="q1" vid="HOS 4:1">你們當聽耶和華的話語！</para>
  <para style="q1" vid="HOS 4:1">耶和華與這地的居民有爭訟，</para>
  <para style="q1" vid="HOS 4:1">因為這地上沒有真理，</para>
  <para style="q1" vid="HOS 4:1">沒有忠誠<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">忠誠——或譯作「信實的愛」。</char></note>，沒有人認識神，<verse eid="HOS 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2" />只有詛咒、欺騙、</para>
  <para style="q1" vid="HOS 4:2">殺人、偷竊、通姦，</para>
  <para style="q1" vid="HOS 4:2">他們任意妄為，</para>
  <para style="q1" vid="HOS 4:2">殺人流血的事接連不斷。<verse eid="HOS 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3" />因此這地荒蕪，</para>
  <para style="q1" vid="HOS 4:3">其上所有的居民、</para>
  <para style="q1" vid="HOS 4:3">田野的走獸、天空的飛鳥都衰微，</para>
  <para style="q1" vid="HOS 4:3">海裡的魚也絕跡。<verse eid="HOS 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4" />然而誰也不要指控，</para>
  <para style="q1" vid="HOS 4:4">誰也不要指責。</para>
  <para style="q1" vid="HOS 4:4">祭司啊，我是與你爭訟<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">祭司啊，我是與你爭訟——或譯作「我的子民像是指控祭司的」。</char></note>！<verse eid="HOS 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5" />白天你將絆倒，</para>
  <para style="q1" vid="HOS 4:5">夜間先知也與你一同絆倒。</para>
  <para style="q1" vid="HOS 4:5">我要使你的母親滅亡，<verse eid="HOS 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 4:6" />我的子民必因沒有知識而滅亡。</para>
  <para style="q1" vid="HOS 4:6">你既然厭棄知識，</para>
  <para style="q1" vid="HOS 4:6">我也要厭棄你作我的祭司；</para>
  <para style="q1" vid="HOS 4:6">你忘記你神的訓誨，</para>
  <para style="q1" vid="HOS 4:6">我也要忘記你的兒女。<verse eid="HOS 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7" />祭司越增多，</para>
  <para style="q1" vid="HOS 4:7">他們就越對我犯罪，</para>
  <para style="q1" vid="HOS 4:7">我要使他們的榮耀變為羞辱。<verse eid="HOS 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8" />他們享用我子民的贖罪祭，</para>
  <para style="q1" vid="HOS 4:8">心裡盼望我的子民犯罪。<verse eid="HOS 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9" />所以子民怎樣，</para>
  <para style="q1" vid="HOS 4:9">祭司也將怎樣，</para>
  <para style="q1" vid="HOS 4:9">我必照著他們各人的行徑懲罰他們，</para>
  <para style="q1" vid="HOS 4:9">照他們的行為報應他們。<verse eid="HOS 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10" />他們吃卻吃不飽，</para>
  <para style="q1" vid="HOS 4:10">行淫而不能繁衍。</para>
  <para style="q1" vid="HOS 4:10">因為他們離棄耶和華，</para>
  <para style="q1" vid="HOS 4:10">執意 <verse eid="HOS 4:10" /><verse number="11" style="v" sid="HOS 4:11" />行淫，</para>
  <para style="q1" vid="HOS 4:11">陳酒和新酒奪去了他們的心。<verse eid="HOS 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12" />我的子民求問木頭，</para>
  <para style="q1" vid="HOS 4:12">讓那些木杖指示他們。</para>
  <para style="q1" vid="HOS 4:12">因為淫亂的靈使他們迷失，</para>
  <para style="q1" vid="HOS 4:12">他們行淫背叛他們的神。<verse eid="HOS 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13" />他們在各山頂、各丘陵上，</para>
  <para style="q1" vid="HOS 4:13">在橡樹、楊樹和黃連樹底下</para>
  <para style="q1" vid="HOS 4:13">獻祭燒香，</para>
  <para style="q1" vid="HOS 4:13">因為樹蔭美好。</para>
  <para style="q1" vid="HOS 4:13">因此你們的女兒行淫，</para>
  <para style="q1" vid="HOS 4:13">新娶的兒媳<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">新娶的兒媳——或譯作「你們的新娘」。</char></note>通姦。<verse eid="HOS 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14" />但我不懲罰你們的女兒，</para>
  <para style="q1" vid="HOS 4:14">即使她們行淫；</para>
  <para style="q1" vid="HOS 4:14">我也不懲罰你們的兒媳，</para>
  <para style="q1" vid="HOS 4:14">即使她們通姦；</para>
  <para style="q1" vid="HOS 4:14">因為是你們轉離與妓女同居，</para>
  <para style="q1" vid="HOS 4:14">與廟妓一同獻祭。</para>
  <para style="q1" vid="HOS 4:14">無知的子民，必將滅亡！<verse eid="HOS 4:14" /></para>
  <para style="b" />
  <para style="s">警誡以色列和猶大</para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15" />
    <char style="pn">以色列</char>啊，你雖然行淫，</para>
  <para style="q1" vid="HOS 4:15">但不要讓<char style="pn">猶大</char>陷入罪惡。</para>
  <para style="q1" vid="HOS 4:15">你們不要去<char style="pn">吉甲</char>，</para>
  <para style="q1" vid="HOS 4:15">不要上<char style="pn">伯亞文</char>，</para>
  <para style="q1" vid="HOS 4:15">也不要說</para>
  <para style="q1" vid="HOS 4:15">「我指著耶和華的永生起誓」。<verse eid="HOS 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16" />
    <char style="pn">以色列</char>頑梗，</para>
  <para style="q1" vid="HOS 4:16">實在像頑梗的母牛！</para>
  <para style="q1" vid="HOS 4:16">耶和華怎能牧放他們，</para>
  <para style="q1" vid="HOS 4:16">像在寬闊之地牧放羊羔那樣？<verse eid="HOS 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17" />
    <char style="pn">以法蓮</char>與偶像聯合，</para>
  <para style="q1" vid="HOS 4:17">任憑他吧！<verse eid="HOS 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18" />他們縱情飲酒，放縱行淫；</para>
  <para style="q1" vid="HOS 4:18">他們的官長深愛羞恥的事。<verse eid="HOS 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19" />風把<char style="pn">以色列</char><note caller="+" style="f"><char style="fr" closed="false">4:19 </char><char style="ft" closed="false">以色列——原文直譯「她」。</char></note>裹在翅膀裡，</para>
  <para style="q1" vid="HOS 4:19">人們必因自己的祭物蒙羞！<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1" />祭司啊，要聽這些話！</para>
  <para style="q1" vid="HOS 5:1">
    <char style="pn">以色列</char>家啊，要留心聽！</para>
  <para style="q1" vid="HOS 5:1">王室啊，要傾聽！</para>
  <para style="q1" vid="HOS 5:1">因為這審判是針對你們的，</para>
  <para style="q1" vid="HOS 5:1">你們成了<char style="pn">米斯巴</char>的網羅，</para>
  <para style="q1" vid="HOS 5:1">成了<char style="pn">他泊</char>山上張開的網。<verse eid="HOS 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2" />這些人在<char style="pn">什亭</char>挖掘深坑<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">這些人在什亭挖掘深坑——或譯作「這些背道的人大行殺戮」。</char></note>，</para>
  <para style="q1" vid="HOS 5:2">所以我必懲治他們所有的人。<verse eid="HOS 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3" />我認識<char style="pn">以法蓮</char>，</para>
  <para style="q1" vid="HOS 5:3">
    <char style="pn">以色列</char>無法向我隱藏。</para>
  <para style="q1" vid="HOS 5:3">
    <char style="pn">以法蓮</char>哪，你竟然行淫，</para>
  <para style="q1" vid="HOS 5:3">
    <char style="pn">以色列</char>玷汙了自己！<verse eid="HOS 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4" />他們的惡行使他們不能回轉</para>
  <para style="q1" vid="HOS 5:4">歸向他們的神，</para>
  <para style="q1" vid="HOS 5:4">因為淫亂的靈在他們當中；</para>
  <para style="q1" vid="HOS 5:4">他們不認識耶和華。<verse eid="HOS 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5" />
    <char style="pn">以色列</char>臉上的傲慢指證他自己，</para>
  <para style="q1" vid="HOS 5:5">
    <char style="pn">以色列</char>和<char style="pn">以法蓮</char>必因自己的罪孽絆倒，</para>
  <para style="q1" vid="HOS 5:5">
    <char style="pn">猶大</char>也必與他們一起絆倒。<verse eid="HOS 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6" />他們將帶著牛羊去尋求耶和華，</para>
  <para style="q1" vid="HOS 5:6">卻找不到，</para>
  <para style="q1" vid="HOS 5:6">他已經離棄了他們。<verse eid="HOS 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7" />他們背棄耶和華，</para>
  <para style="q1" vid="HOS 5:7">他們生的是私生子<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">私生子——或譯作「外族兒女」。</char></note>，</para>
  <para style="q1" vid="HOS 5:7">所以新月節<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">新月節——或譯作「毀滅者」。</char></note>必吞噬他們和他們的地業。<verse eid="HOS 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8" />你們要在<char style="pn">基比亞</char>吹響號角，</para>
  <para style="q1" vid="HOS 5:8">在<char style="pn">拉瑪</char>吹響號筒，</para>
  <para style="q1" vid="HOS 5:8">要在<char style="pn">伯亞文</char>呼喊：</para>
  <para style="q1" vid="HOS 5:8">「<char style="pn">便雅憫</char>哪，小心背後！」<verse eid="HOS 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9" />在責罰的日子裡，<char style="pn">以法蓮</char>必成為荒場，</para>
  <para style="q1" vid="HOS 5:9">我已在<char style="pn">以色列</char>各支派指示確定的事。<verse eid="HOS 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10" />
    <char style="pn">猶大</char>的首領們就像挪移地界的人，</para>
  <para style="q1" vid="HOS 5:10">我必像潑水那樣向他們傾瀉我的盛怒。<verse eid="HOS 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11" />
    <char style="pn">以法蓮</char>受欺壓，被審判壓碎，</para>
  <para style="q1" vid="HOS 5:11">是因為他情願追隨虛無<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">虛無——或譯作「人的命令」。</char></note>。<verse eid="HOS 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12" />所以我親自行動，</para>
  <para style="q1" vid="HOS 5:12">如蛀蟲對付<char style="pn">以法蓮</char>，</para>
  <para style="q1" vid="HOS 5:12">如朽爛對付<char style="pn">猶大</char>家。<verse eid="HOS 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13" />
    <char style="pn">以法蓮</char>看見自己的病患，</para>
  <para style="q1" vid="HOS 5:13">
    <char style="pn">猶大</char>看見自己的創傷，</para>
  <para style="q1" vid="HOS 5:13">
    <char style="pn">以法蓮</char>就前往<char style="pn">亞述</char>，</para>
  <para style="q1" vid="HOS 5:13">派人去見那大君王。</para>
  <para style="q1" vid="HOS 5:13">可是他不能醫治你們，</para>
  <para style="q1" vid="HOS 5:13">不能治癒你們的創傷。<verse eid="HOS 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14" />我必如猛獅對付<char style="pn">以法蓮</char>，</para>
  <para style="q1" vid="HOS 5:14">如少壯獅子對付<char style="pn">猶大</char>家。</para>
  <para style="q1" vid="HOS 5:14">我，是我，要撕掠而去；</para>
  <para style="q1" vid="HOS 5:14">我拖走他們，無人解救。<verse eid="HOS 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15" />我要回我的地方去，</para>
  <para style="q1" vid="HOS 5:15">直到他們承擔罪責，</para>
  <para style="q1" vid="HOS 5:15">然後尋求我的面，</para>
  <para style="q1" vid="HOS 5:15">在危難中切切尋求我。<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s">呼籲子民回轉</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1" />來吧，讓我們回轉歸向耶和華！</para>
  <para style="q1" vid="HOS 6:1">因為他撕裂我們，</para>
  <para style="q1" vid="HOS 6:1">也必醫治我們；</para>
  <para style="q1" vid="HOS 6:1">他打傷我們，</para>
  <para style="q1" vid="HOS 6:1">也必包紮我們。<verse eid="HOS 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2" />兩天後他會使我們復甦，</para>
  <para style="q1" vid="HOS 6:2">第三天他會使我們起來，</para>
  <para style="q1" vid="HOS 6:2">我們就活在他的面前。<verse eid="HOS 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3" />我們要認識耶和華，竭力認識他。</para>
  <para style="q1" vid="HOS 6:3">他必如曙光出現；</para>
  <para style="q1" vid="HOS 6:3">他臨到我們像甘霖，</para>
  <para style="q1" vid="HOS 6:3">像滋潤大地的春雨。<verse eid="HOS 6:3" /></para>
  <para style="b" />
  <para style="s">第一首哀歌</para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4" />
    <char style="pn">以法蓮</char>哪，我要怎麼處置你呢？</para>
  <para style="q1" vid="HOS 6:4">
    <char style="pn">猶大</char>啊，我要怎麼處置你呢？</para>
  <para style="q1" vid="HOS 6:4">你們的忠誠<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">忠誠——或譯作「信實之愛」；下同。</char></note>消逝，</para>
  <para style="q1" vid="HOS 6:4">如同清晨的雲霧，</para>
  <para style="q1" vid="HOS 6:4">又如早上的露水。<verse eid="HOS 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5" />因此我藉著眾先知砍碎他們，</para>
  <para style="q1" vid="HOS 6:5">用我口中的言語殺死他們，</para>
  <para style="q1" vid="HOS 6:5">我的審判像光輝那樣發出。<verse eid="HOS 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6" />因為我喜悅忠誠，而不是祭物；</para>
  <para style="q1" vid="HOS 6:6">喜悅人認識神，而不是獻燔祭。<verse eid="HOS 6:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7" />他們卻如<char style="pn">亞當</char><note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">如亞當——或譯作「在亞當」；參《約書亞書》3:16。</char></note>違背了約，</para>
  <para style="q1" vid="HOS 6:7">他們在那裡背棄我：<verse eid="HOS 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8" />
    <char style="pn">基列</char>是作惡之徒的城，</para>
  <para style="q1" vid="HOS 6:8">足迹沾滿了血。<verse eid="HOS 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9" />祭司像埋伏等候的匪徒，</para>
  <para style="q1" vid="HOS 6:9">結伙在<char style="pn">示劍</char>的路上殺人；</para>
  <para style="q1" vid="HOS 6:9">他們實在行了醜惡的事。<verse eid="HOS 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10" />我在<char style="pn">以色列</char>家看見了可怕的事，</para>
  <para style="q1" vid="HOS 6:10">那裡有<char style="pn">以法蓮</char>的淫行，</para>
  <para style="q1" vid="HOS 6:10">
    <char style="pn">以色列</char>玷汙了自己。<verse eid="HOS 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11" />
    <char style="pn">猶大</char>啊，</para>
  <para style="q1" vid="HOS 6:11">我使流亡的子民回歸<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">使流亡的子民回歸——或譯作「復興我子民的繼業」。</char></note>時，</para>
  <para style="q1" vid="HOS 6:11">你也有命定的收成<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">收成——或譯作「審判」。</char></note>。<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 7:1" />當我想要醫治<char style="pn">以色列</char>時，</para>
  <para style="q1" vid="HOS 7:1">
    <char style="pn">以法蓮</char>的罪孽和<char style="pn">撒瑪利亞</char>的罪惡</para>
  <para style="q1" vid="HOS 7:1">就會暴露出來。</para>
  <para style="q1" vid="HOS 7:1">是的，他們行事詭詐，</para>
  <para style="q1" vid="HOS 7:1">內有竊賊進入，</para>
  <para style="q1" vid="HOS 7:1">外有匪徒搶掠。<verse eid="HOS 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2" />他們心裡不考慮</para>
  <para style="q1" vid="HOS 7:2">我會記住他們的一切惡行。</para>
  <para style="q1" vid="HOS 7:2">現在他們的行為圍繞著他們，</para>
  <para style="q1" vid="HOS 7:2">都在我的面前。<verse eid="HOS 7:2" /></para>
  <para style="b" />
  <para style="s">以色列的敗壞</para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3" />他們以惡行取悅君王，</para>
  <para style="q1" vid="HOS 7:3">以謊言取悅首領們。<verse eid="HOS 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4" />他們都是通姦的人，</para>
  <para style="q1" vid="HOS 7:4">像燒熱的火爐，</para>
  <para style="q1" vid="HOS 7:4">烤餅人從揉面到發酵的時候，</para>
  <para style="q1" vid="HOS 7:4">都不用扇火。<verse eid="HOS 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5" />在我們君王喜慶<note caller="+" style="f"><char style="fr" closed="false">7:5 </char><char style="ft" closed="false">喜慶——輔助詞語。</char></note>的日子，</para>
  <para style="q1" vid="HOS 7:5">首領們因酒烈而大醉，</para>
  <para style="q1" vid="HOS 7:5">王與褻慢人聯起手來。<verse eid="HOS 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6" />是的，他們心如火爐</para>
  <para style="q1" vid="HOS 7:6">從埋伏之處衝上來；</para>
  <para style="q1" vid="HOS 7:6">他們心中所烤的整夜沉寂，</para>
  <para style="q1" vid="HOS 7:6">一到清晨就像烈焰燃起。<verse eid="HOS 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7" />他們全都灼熱如同火爐，</para>
  <para style="q1" vid="HOS 7:7">吞噬他們的首領；</para>
  <para style="q1" vid="HOS 7:7">他們的君王都倒下了。</para>
  <para style="q1" vid="HOS 7:7">他們中間沒有人呼求我！<verse eid="HOS 7:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8" />
    <char style="pn">以法蓮</char>與各民族混雜，</para>
  <para style="q1" vid="HOS 7:8">
    <char style="pn">以法蓮</char>是沒有翻過的餅。<verse eid="HOS 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9" />外族人吞噬了他的力量，</para>
  <para style="q1" vid="HOS 7:9">他卻不知道；</para>
  <para style="q1" vid="HOS 7:9">他已經滿頭白髮，</para>
  <para style="q1" vid="HOS 7:9">他也不知道！<verse eid="HOS 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10" />
    <char style="pn">以色列</char>臉上的傲慢指證他自己。</para>
  <para style="q1" vid="HOS 7:10">在這一切事上，</para>
  <para style="q1" vid="HOS 7:10">他們並不回轉歸向耶和華他們的神，</para>
  <para style="q1" vid="HOS 7:10">也不尋求他。<verse eid="HOS 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11" />
    <char style="pn">以法蓮</char>就像愚笨、沒有心智的鴿子，</para>
  <para style="q1" vid="HOS 7:11">他們呼求<char style="pn">埃及</char>，投奔<char style="pn">亞述</char>。<verse eid="HOS 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12" />當他們去的時候，</para>
  <para style="q1" vid="HOS 7:12">我必向他們張開我的網羅。</para>
  <para style="q1" vid="HOS 7:12">我要把他們像天空的飛鳥打下來，</para>
  <para style="q1" vid="HOS 7:12">照著他們同黨的傳聞管教他們。<verse eid="HOS 7:12" /></para>
  <para style="b" />
  <para style="s">第二首哀歌</para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13" />他們有禍了，因為他們遠離我！</para>
  <para style="q1" vid="HOS 7:13">毀滅臨到他們了，因為他們悖逆我！</para>
  <para style="q1" vid="HOS 7:13">我要救贖他們，他們卻向我說謊。<verse eid="HOS 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14" />他們不是真心向我哀求，</para>
  <para style="q1" vid="HOS 7:14">只是在床上號叫；</para>
  <para style="q1" vid="HOS 7:14">他們為求五穀和新酒，砍傷自己<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">砍傷自己——依據七十士譯本；或譯作「聚集起來」。</char></note>。</para>
  <para style="q1" vid="HOS 7:14">他們離棄我！<verse eid="HOS 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15" />我管教他們，扶持他們的膀臂，</para>
  <para style="q1" vid="HOS 7:15">他們卻謀劃惡事敵對我。<verse eid="HOS 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16" />他們轉向，卻不轉向至高者；</para>
  <para style="q1" vid="HOS 7:16">他們就像翻背的弓。</para>
  <para style="q1" vid="HOS 7:16">他們的首領必因舌頭的狂傲<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">舌頭的狂傲——或譯作「惹怒我的話語」。</char></note>倒在刀下，</para>
  <para style="q1" vid="HOS 7:16">以致在<char style="pn">埃及</char>地成為笑柄。<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s">以色列的幻想破滅</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1" />你用口吹響號角吧！</para>
  <para style="q1" vid="HOS 8:1">敵人<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">敵人——輔助詞語。</char></note>必如鷹撲向耶和華的殿，</para>
  <para style="q1" vid="HOS 8:1">因為這民違背我的約，</para>
  <para style="q1" vid="HOS 8:1">背離我的訓誨。<verse eid="HOS 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2" />他們將向我呼救：</para>
  <para style="q1" vid="HOS 8:2">「我的神哪，</para>
  <para style="q1" vid="HOS 8:2">我們<char style="pn">以色列</char>認識你了！」<verse eid="HOS 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3" />
    <char style="pn">以色列</char>拋棄了美善，</para>
  <para style="q1" vid="HOS 8:3">仇敵必追趕他。<verse eid="HOS 8:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4" />他們立王，</para>
  <para style="q1" vid="HOS 8:4">不經過我；</para>
  <para style="q1" vid="HOS 8:4">他們立首領，</para>
  <para style="q1" vid="HOS 8:4">我並沒有承認。</para>
  <para style="q1" vid="HOS 8:4">他們用金銀為自己製造偶像，</para>
  <para style="q1" vid="HOS 8:4">以致他們被剪除。<verse eid="HOS 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5" />
    <char style="pn">撒瑪利亞</char>啊，</para>
  <para style="q1" vid="HOS 8:5">你的金牛犢被丟棄了！</para>
  <para style="q1" vid="HOS 8:5">我的怒氣向他們發作，</para>
  <para style="q1" vid="HOS 8:5">他們什麼時候才能清白無罪呢？<verse eid="HOS 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 8:6" />這金牛犢竟然出自<char style="pn">以色列</char>！</para>
  <para style="q1" vid="HOS 8:6">它是工匠所造的，它並不是神。</para>
  <para style="q1" vid="HOS 8:6">
    <char style="pn">撒瑪利亞</char>的金牛犢必成為碎末！<verse eid="HOS 8:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7" />其實，他們播種的是風，</para>
  <para style="q1" vid="HOS 8:7">收割的是旋風。</para>
  <para style="q1" vid="HOS 8:7">莊稼不結穗子，</para>
  <para style="q1" vid="HOS 8:7">無法出產麵粉；</para>
  <para style="q1" vid="HOS 8:7">即使出產了，</para>
  <para style="q1" vid="HOS 8:7">也會被外族人吞吃。<verse eid="HOS 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8" />
    <char style="pn">以色列</char>被吞吃了，</para>
  <para style="q1" vid="HOS 8:8">如今他們在列國中</para>
  <para style="q1" vid="HOS 8:8">就像沒人想要的器皿。<verse eid="HOS 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9" />他們竟然投奔<char style="pn">亞述</char>，</para>
  <para style="q1" vid="HOS 8:9">如同獨行的野驢；</para>
  <para style="q1" vid="HOS 8:9">
    <char style="pn">以法蓮</char>賄買情人。<verse eid="HOS 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10" />儘管他們在列國中賄買情人，</para>
  <para style="q1" vid="HOS 8:10">現在我必聚攏他們施行審判<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">施行審判——輔助詞語。</char></note>，</para>
  <para style="q1" vid="HOS 8:10">他們很快就要因君王和首領</para>
  <para style="q1" vid="HOS 8:10">所加的重擔而痛苦不堪。<verse eid="HOS 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11" />
    <char style="pn">以法蓮</char>雖然增多贖罪的祭壇，</para>
  <para style="q1" vid="HOS 8:11">卻成了使他犯罪的祭壇！<verse eid="HOS 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12" />我為他寫下千萬條<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">千萬條——或譯作「許多」。</char></note>訓誨，</para>
  <para style="q1" vid="HOS 8:12">都被看作與他無關的。<verse eid="HOS 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13" />至於獻給我的祭物，</para>
  <para style="q1" vid="HOS 8:13">他們獻上祭肉，也吃了，</para>
  <para style="q1" vid="HOS 8:13">耶和華卻不悅納他們。</para>
  <para style="q1" vid="HOS 8:13">現在他要記起他們的罪孽，</para>
  <para style="q1" vid="HOS 8:13">懲罰他們的罪惡，</para>
  <para style="q1" vid="HOS 8:13">他們必回到<char style="pn">埃及</char>。<verse eid="HOS 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14" />
    <char style="pn">以色列</char>忘記了他的創造主，</para>
  <para style="q1" vid="HOS 8:14">建造許多宮殿，</para>
  <para style="q1" vid="HOS 8:14">
    <char style="pn">猶大</char>也增多堅固的城。</para>
  <para style="q1" vid="HOS 8:14">所以我必使烈火降在他的城鎮，</para>
  <para style="q1" vid="HOS 8:14">吞噬他的城堡。<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s">以色列將被擄</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1" />
    <char style="pn">以色列</char>啊，不要歡喜，</para>
  <para style="q1" vid="HOS 9:1">不要像外邦人那樣快樂！</para>
  <para style="q1" vid="HOS 9:1">因為你行淫背叛你的神，</para>
  <para style="q1" vid="HOS 9:1">貪愛各處打穀場上賣淫的酬金。<verse eid="HOS 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2" />打穀場和榨酒池不會再供養他們，</para>
  <para style="q1" vid="HOS 9:2">新酒也不再供應他們。<verse eid="HOS 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3" />他們不能居住在耶和華的土地上，</para>
  <para style="q1" vid="HOS 9:3">
    <char style="pn">以法蓮</char>將回到<char style="pn">埃及</char>，</para>
  <para style="q1" vid="HOS 9:3">在<char style="pn">亞述</char>吃不潔之物。<verse eid="HOS 9:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4" />他們不能向耶和華澆奠酒祭，</para>
  <para style="q1" vid="HOS 9:4">他們的祭物也不蒙他喜悅。</para>
  <para style="q1" vid="HOS 9:4">他們的祭物是喪家的食物，</para>
  <para style="q1" vid="HOS 9:4">凡是吃的人都使自己受玷汙；</para>
  <para style="q1" vid="HOS 9:4">因為他們的食物是為自己的欲望，</para>
  <para style="q1" vid="HOS 9:4">不能奉入耶和華的殿。<verse eid="HOS 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5" />到所定的節期，</para>
  <para style="q1" vid="HOS 9:5">在耶和華節期的日子，</para>
  <para style="q1" vid="HOS 9:5">你們該怎麼辦呢？<verse eid="HOS 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6" />看哪，他們逃避毀滅，</para>
  <para style="q1" vid="HOS 9:6">
    <char style="pn">埃及</char>卻將收殮他們，</para>
  <para style="q1" vid="HOS 9:6">
    <char style="pn">摩弗</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">9:6 </char>
      <char style="ft" closed="false">摩弗——希臘語音譯為「孟斐斯」。</char>
    </note>將埋葬他們！</para>
  <para style="q1" vid="HOS 9:6">灌木叢將覆蓋他們寶貴的銀器，</para>
  <para style="q1" vid="HOS 9:6">蒺藜將占據他們的帳篷。<verse eid="HOS 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7" />懲罰的日子來到了，</para>
  <para style="q1" vid="HOS 9:7">報應的日子來到了！</para>
  <para style="q1" vid="HOS 9:7">要讓<char style="pn">以色列</char>知道：</para>
  <para style="q1" vid="HOS 9:7">先知是愚妄人，</para>
  <para style="q1" vid="HOS 9:7">受靈感的是瘋子；</para>
  <para style="q1" vid="HOS 9:7">因為你們的罪孽眾多，</para>
  <para style="q1" vid="HOS 9:7">你們的敵意極大。<verse eid="HOS 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8" />先知為我的神<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">為我的神——或譯作「與我的神一同」。</char></note>守望<char style="pn">以法蓮</char>，</para>
  <para style="q1" vid="HOS 9:8">然而他一切道路上</para>
  <para style="q1" vid="HOS 9:8">都有捕鳥人的網羅，</para>
  <para style="q1" vid="HOS 9:8">他神的殿中充滿敵意。<verse eid="HOS 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9" />
    <char style="pn">以法蓮</char>深深陷入敗壞，</para>
  <para style="q1" vid="HOS 9:9">像在<char style="pn">基比亞</char>的日子那樣。</para>
  <para style="q1" vid="HOS 9:9">耶和華必記起他們的罪孽，</para>
  <para style="q1" vid="HOS 9:9">懲罰他們的罪惡。<verse eid="HOS 9:9" /></para>
  <para style="b" />
  <para style="s">以法蓮斷絕後裔</para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10" />從前我找到<char style="pn">以色列</char>，</para>
  <para style="q1" vid="HOS 9:10">他們就像曠野中的葡萄，</para>
  <para style="q1" vid="HOS 9:10">我看你們的祖先</para>
  <para style="q1" vid="HOS 9:10">就像無花果樹最好的初熟果子。</para>
  <para style="q1" vid="HOS 9:10">他們來到<char style="pn">巴力</char>-<char style="pn">毗珥</char>，</para>
  <para style="q1" vid="HOS 9:10">卻把自己獻給可恥的偶像，</para>
  <para style="q1" vid="HOS 9:10">以致成為可憎厭的，</para>
  <para style="q1" vid="HOS 9:10">與他們所愛的偶像<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">偶像——輔助詞語。</char></note>一樣。<verse eid="HOS 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11" />
    <char style="pn">以法蓮</char>的榮耀必像鳥一樣飛走，</para>
  <para style="q1" vid="HOS 9:11">他們不生育，不受孕，不懷胎。<verse eid="HOS 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12" />即使他們養大了兒女，</para>
  <para style="q1" vid="HOS 9:12">我也要使這些兒女喪亡，一個不留。</para>
  <para style="q1" vid="HOS 9:12">是的，他們也有禍了，</para>
  <para style="q1" vid="HOS 9:12">因我離棄了他們。<verse eid="HOS 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13" />我看<char style="pn">以法蓮</char></para>
  <para style="q1" vid="HOS 9:13">像栽種在牧場上的<char style="pn">提爾</char>，</para>
  <para style="q1" vid="HOS 9:13">
    <char style="pn">以法蓮</char>卻把自己的兒女帶出去，</para>
  <para style="q1" vid="HOS 9:13">交給殺戮的人。<verse eid="HOS 9:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14" />耶和華啊，求你賞賜他們——</para>
  <para style="q1" vid="HOS 9:14">賜什麼呢？</para>
  <para style="q1" vid="HOS 9:14">賜給他們掉落的胎兒、枯竭的乳房！<verse eid="HOS 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15" />他們一切惡行都在<char style="pn">吉甲</char>；</para>
  <para style="q1" vid="HOS 9:15">是的，我在那裡憎惡他們。</para>
  <para style="q1" vid="HOS 9:15">因他們的惡行，</para>
  <para style="q1" vid="HOS 9:15">我要把他們從我的家中趕出去。</para>
  <para style="q1" vid="HOS 9:15">我不再喜愛他們，</para>
  <para style="q1" vid="HOS 9:15">他們的首領都是頑梗的。<verse eid="HOS 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16" />
    <char style="pn">以法蓮</char>必被責打，</para>
  <para style="q1" vid="HOS 9:16">樹根枯乾，</para>
  <para style="q1" vid="HOS 9:16">不能結出果實。</para>
  <para style="q1" vid="HOS 9:16">就算他們生了孩子，</para>
  <para style="q1" vid="HOS 9:16">我也要把他們親生的寶貝處死。<verse eid="HOS 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17" />我的神厭棄他們，</para>
  <para style="q1" vid="HOS 9:17">因為他們不聽從他。</para>
  <para style="q1" vid="HOS 9:17">他們必在列國中漂泊。<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="s">葡萄樹和小母牛</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1" />
    <char style="pn">以色列</char>是旺長<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">旺長——或譯作「虛無」。</char></note>的葡萄樹，</para>
  <para style="q1" vid="HOS 10:1">她結出果實，</para>
  <para style="q1" vid="HOS 10:1">果實越多，祭壇就越多；</para>
  <para style="q1" vid="HOS 10:1">她的土地越肥美，她就越妝飾神柱。<verse eid="HOS 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2" />他們虛心假意，</para>
  <para style="q1" vid="HOS 10:2">現在必承擔罪責，</para>
  <para style="q1" vid="HOS 10:2">耶和華將拆毀他們的祭壇，</para>
  <para style="q1" vid="HOS 10:2">摧毀他們的神柱。<verse eid="HOS 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3" />那時他們必說：</para>
  <para style="q1" vid="HOS 10:3">「我們沒有王，</para>
  <para style="q1" vid="HOS 10:3">因為我們不敬畏耶和華。</para>
  <para style="q1" vid="HOS 10:3">王又能為我們做什麼呢？」<verse eid="HOS 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4" />他們說空話，起假誓立約，</para>
  <para style="q1" vid="HOS 10:4">所以懲罰如毒草在田地的犁溝中蔓延。<verse eid="HOS 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5" />
    <char style="pn">撒瑪利亞</char>的居民</para>
  <para style="q1" vid="HOS 10:5">因<char style="pn">伯亞文</char>的小母牛而懼怕；</para>
  <para style="q1" vid="HOS 10:5">它的子民必為它悲慟，</para>
  <para style="q1" vid="HOS 10:5">這些服事偶像的祭司</para>
  <para style="q1" vid="HOS 10:5">將為它的榮耀嚎叫，</para>
  <para style="q1" vid="HOS 10:5">因為榮耀離開了它<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false">這些服事偶像的祭司將為它的榮耀嚎叫，因為榮耀離開了它——或譯作「這些服事偶像的祭司曾為它的榮耀快樂，但榮耀離開了它」。</char></note>。<verse eid="HOS 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6" />連它也要被帶到<char style="pn">亞述</char>，</para>
  <para style="q1" vid="HOS 10:6">成為獻給<char style="pn">亞述</char>大王的貢物。</para>
  <para style="q1" vid="HOS 10:6">
    <char style="pn">以法蓮</char>必承受羞辱，</para>
  <para style="q1" vid="HOS 10:6">
    <char style="pn">以色列</char>將因自己的謀略而羞慚。<verse eid="HOS 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7" />
    <char style="pn">撒瑪利亞</char>被摧毀了，</para>
  <para style="q1" vid="HOS 10:7">她的王好像水面上的殘枝<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">殘枝——或譯作「泡沫」。</char></note>。<verse eid="HOS 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8" />偶像的高壇，就是<char style="pn">以色列</char>的罪惡，</para>
  <para style="q1" vid="HOS 10:8">被拆毀了！</para>
  <para style="q1" vid="HOS 10:8">荊棘和蒺藜爬上他們的祭壇。</para>
  <para style="q1" vid="HOS 10:8">他們必對大山說：「遮蓋我們吧！」</para>
  <para style="q1" vid="HOS 10:8">對小山說：「倒在我們身上吧！」<verse eid="HOS 10:8" /></para>
  <para style="b" />
  <para style="s">以色列因罪而敗亡</para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9" />
    <char style="pn">以色列</char>啊，</para>
  <para style="q1" vid="HOS 10:9">從<char style="pn">基比亞</char>的日子起，你就犯罪！</para>
  <para style="q1" vid="HOS 10:9">他們一直在那裡犯罪。</para>
  <para style="q1" vid="HOS 10:9">對不義之人的戰爭，</para>
  <para style="q1" vid="HOS 10:9">難道不會在<char style="pn">基比亞</char>追上他們嗎？<verse eid="HOS 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10" />我必按自己的心意，管教他們。</para>
  <para style="q1" vid="HOS 10:10">他們被自己雙重罪孽捆綁的時候，</para>
  <para style="q1" vid="HOS 10:10">列邦必聚集起來攻擊他們。<verse eid="HOS 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11" />
    <char style="pn">以法蓮</char>曾是馴服的小母牛，</para>
  <para style="q1" vid="HOS 10:11">喜愛踹穀，</para>
  <para style="q1" vid="HOS 10:11">現在我卻要把軛套在牠肥壯的脖子上。</para>
  <para style="q1" vid="HOS 10:11">我要使<char style="pn">以法蓮</char>拉犁，</para>
  <para style="q1" vid="HOS 10:11">
    <char style="pn">猶大</char>要耕作，</para>
  <para style="q1" vid="HOS 10:11">
    <char style="pn">雅各</char>要為自己耙地。<verse eid="HOS 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12" />你們要為自己播種公義，</para>
  <para style="q1" vid="HOS 10:12">收獲忠誠<note caller="+" style="f"><char style="fr" closed="false">10:12 </char><char style="ft" closed="false">忠誠——或譯作「慈愛」。</char></note>的果實，</para>
  <para style="q1" vid="HOS 10:12">要開墾你們的荒地。</para>
  <para style="q1" vid="HOS 10:12">現在正是求問耶和華的時候，</para>
  <para style="q1" vid="HOS 10:12">要等到他來，使公義如雨滋潤你們。<verse eid="HOS 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13" />你們耕耘邪惡，收獲不義，</para>
  <para style="q1" vid="HOS 10:13">吃了謊言的果實。</para>
  <para style="q1" vid="HOS 10:13">因為你依靠自己的道路<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">道路——或譯作「戰車」。</char></note></para>
  <para style="q1" vid="HOS 10:13">和自己眾多的勇士，<verse eid="HOS 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14" />所以你的子民中將起喧嚷，</para>
  <para style="q1" vid="HOS 10:14">你所有的堡壘都要被摧毀，</para>
  <para style="q1" vid="HOS 10:14">就像<char style="pn">沙勒曼</char>在爭戰的日子裡</para>
  <para style="q1" vid="HOS 10:14">摧毀<char style="pn">伯亞比勒</char>那樣，</para>
  <para style="q1" vid="HOS 10:14">母親和兒女一同被摔死。<verse eid="HOS 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15" />
    <char style="pn">伯特利</char>啊，我必這樣對待你們，</para>
  <para style="q1" vid="HOS 10:15">因為你們的罪惡極大。</para>
  <para style="q1" vid="HOS 10:15">黎明的時候，</para>
  <para style="q1" vid="HOS 10:15">
    <char style="pn">以色列</char>的王將被徹底除滅。<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s">耶和華對以色列的愛</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1" />
    <char style="pn">以色列</char>年少的時候，我就愛他；</para>
  <para style="q1" vid="HOS 11:1">我把我的兒子從<char style="pn">埃及</char>召喚出來。<verse eid="HOS 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2" />我越召喚他們，他們越遠離我；</para>
  <para style="q1" vid="HOS 11:2">他們向<char style="pn">巴力</char>獻祭，向偶像燒香。<verse eid="HOS 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3" />我教導<char style="pn">以法蓮</char>走路，</para>
  <para style="q1" vid="HOS 11:3">用膀臂抱著他們，</para>
  <para style="q1" vid="HOS 11:3">他們卻不明白是我醫治<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false">醫治——或譯作「看護」。</char></note>了他們。<verse eid="HOS 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4" />我用慈繩愛索牽引他們；</para>
  <para style="q1" vid="HOS 11:4">我對待他們，</para>
  <para style="q1" vid="HOS 11:4">就像人把嬰孩抱在臉頰旁<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false">把嬰孩抱在臉頰旁——或譯作「除掉牛臉頰上的軛」。</char></note>，</para>
  <para style="q1" vid="HOS 11:4">俯身餵養他。<verse eid="HOS 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5" />他們絕不能回到<char style="pn">埃及</char>地，</para>
  <para style="q1" vid="HOS 11:5">
    <char style="pn">亞述</char>卻要作他們的王，</para>
  <para style="q1" vid="HOS 11:5">因為他們不肯悔改。<verse eid="HOS 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6" />刀劍必在他們各城揮舞，</para>
  <para style="q1" vid="HOS 11:6">消滅他們的占卜者<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="ft" closed="false">消滅他們的占卜者——或譯作「毀壞他們的門閂」。</char></note>，</para>
  <para style="q1" vid="HOS 11:6">挫敗他們的計謀。<verse eid="HOS 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7" />我的子民執意背離我，</para>
  <para style="q1" vid="HOS 11:7">他們雖然向至高者呼求，</para>
  <para style="q1" vid="HOS 11:7">卻全然不尊崇他。<verse eid="HOS 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8" />
    <char style="pn">以法蓮</char>哪，我怎能撇棄你呢？</para>
  <para style="q1" vid="HOS 11:8">
    <char style="pn">以色列</char>啊，我怎能把你交出去呢？</para>
  <para style="q1" vid="HOS 11:8">我怎能撇棄你如<char style="pn">押瑪</char>，</para>
  <para style="q1" vid="HOS 11:8">使你如<char style="pn">洗扁</char>那樣呢？</para>
  <para style="q1" vid="HOS 11:8">我心裡翻騰<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false">心裡翻騰——或譯作「回心轉意」。</char></note>，</para>
  <para style="q1" vid="HOS 11:8">我的憐愛全都湧上來。<verse eid="HOS 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9" />我不再發出我猛烈的怒氣，</para>
  <para style="q1" vid="HOS 11:9">不再毀掉<char style="pn">以法蓮</char>。</para>
  <para style="q1" vid="HOS 11:9">因為我是神，而非世人；</para>
  <para style="q1" vid="HOS 11:9">我是你們當中的至聖者，</para>
  <para style="q1" vid="HOS 11:9">我不願在烈怒中來臨。<verse eid="HOS 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10" />他們將跟隨耶和華；</para>
  <para style="q1" vid="HOS 11:10">他要像獅子吼叫，</para>
  <para style="q1" vid="HOS 11:10">他一吼叫，</para>
  <para style="q1" vid="HOS 11:10">兒女就從西方戰兢而來。<verse eid="HOS 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11" />他們要像雀鳥從<char style="pn">埃及</char>戰兢而來，</para>
  <para style="q1" vid="HOS 11:11">又如鴿子從<char style="pn">亞述</char>地戰兢歸來。</para>
  <para style="q1" vid="HOS 11:11">我要使他們住在自己家中。</para>
  <para style="q1" vid="HOS 11:11">這是耶和華的宣告。<verse eid="HOS 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12" />
    <note caller="+" style="f">
      <char style="fr" closed="false">11:12 </char>
      <char style="ft" closed="false">此節在馬索拉文本為12:1。</char>
    </note>
    <char style="pn">以法蓮</char>用謊言圍繞我，</para>
  <para style="q1" vid="HOS 11:12">
    <char style="pn">以色列</char>家用欺騙圍着我。</para>
  <para style="q1" vid="HOS 11:12">
    <char style="pn">猶大</char>一再抗拒神，</para>
  <para style="q1" vid="HOS 11:12">抗拒信實的至聖者<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">猶大一再抗拒神，抗拒信實的至聖者——或譯作「猶大仍然與神同行，忠實於至聖者」。</char></note>。<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="s">耶和華指控雅各家</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">12:1 </char>
      <char style="ft" closed="false">此章在馬索拉文本為12:2至12:15。</char>
    </note>
    <char style="pn">以法蓮</char>以風為食，</para>
  <para style="q1" vid="HOS 12:1">追逐東風，</para>
  <para style="q1" vid="HOS 12:1">終日增添虛謊和毀壞。</para>
  <para style="q1" vid="HOS 12:1">他與<char style="pn">亞述</char>立約，</para>
  <para style="q1" vid="HOS 12:1">把油送給<char style="pn">埃及</char>。<verse eid="HOS 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2" />耶和華與<char style="pn">猶大</char>有爭訟，</para>
  <para style="q1" vid="HOS 12:2">要照<char style="pn">雅各</char>的行徑懲罰他，</para>
  <para style="q1" vid="HOS 12:2">照他的行為報應他。<verse eid="HOS 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3" />他曾在母腹中抓住哥哥的腳跟，</para>
  <para style="q1" vid="HOS 12:3">又在壯年時與神較力。<verse eid="HOS 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4" />
    <char style="pn">雅各</char>與天使較力而得勝，</para>
  <para style="q1" vid="HOS 12:4">並且哭泣，懇求他施恩；</para>
  <para style="q1" vid="HOS 12:4">又在<char style="pn">伯特利</char>遇見他，</para>
  <para style="q1" vid="HOS 12:4">在那裡與他<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">他——依據七十士譯本；馬索拉文本作「我們」。</char></note>說話；<verse eid="HOS 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5" />他是耶和華萬軍之神，</para>
  <para style="q1" vid="HOS 12:5">耶和華是他的名號。<verse eid="HOS 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6" />所以你要回轉歸向你的神，</para>
  <para style="q1" vid="HOS 12:6">要持守忠誠<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="ft" closed="false">忠誠——或譯作「慈愛」。</char></note>和公義，</para>
  <para style="q1" vid="HOS 12:6">一直等候你的神。<verse eid="HOS 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7" />
    <char style="pn">以法蓮</char>是個<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">以法蓮是個——輔助詞語。</char></note>商人，</para>
  <para style="q1" vid="HOS 12:7">他手中有欺詐的天平，</para>
  <para style="q1" vid="HOS 12:7">他專愛欺壓。<verse eid="HOS 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8" />
    <char style="pn">以法蓮</char>還說：</para>
  <para style="q1" vid="HOS 12:8">「我真的富有了，我發財了！</para>
  <para style="q1" vid="HOS 12:8">這是我一切辛苦所得，</para>
  <para style="q1" vid="HOS 12:8">我身上找不到可定罪的過犯。」<verse eid="HOS 12:8" /></para>
  <para style="b" />
  <para style="s">以色列受管教</para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9" />自從你出<char style="pn">埃及</char>地以來，</para>
  <para style="q1" vid="HOS 12:9">我就是耶和華你的神。</para>
  <para style="q1" vid="HOS 12:9">我要使你再住帳篷，</para>
  <para style="q1" vid="HOS 12:9">像在節期的日子那樣。<verse eid="HOS 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10" />我已經告訴眾先知，</para>
  <para style="q1" vid="HOS 12:10">並且親自增多異象<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="ft" closed="false">異象——或譯作「啟示」。</char></note>，</para>
  <para style="q1" vid="HOS 12:10">藉著眾先知設了比喻。<verse eid="HOS 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11" />
    <char style="pn">基列</char>不是奸惡的嗎？</para>
  <para style="q1" vid="HOS 12:11">他們實在虛妄！</para>
  <para style="q1" vid="HOS 12:11">人們在<char style="pn">吉甲</char>向公牛獻祭，</para>
  <para style="q1" vid="HOS 12:11">他們的祭壇</para>
  <para style="q1" vid="HOS 12:11">也多如田間犁溝旁的石堆。<verse eid="HOS 12:11" /></para>
  <para style="b" />
  <para style="s">雅各家受責罰</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12" />
    <char style="pn">雅各</char>曾逃到<char style="pn">亞蘭</char>地，</para>
  <para style="q1" vid="HOS 12:12">
    <char style="pn">以色列</char>為得妻子而勞苦，</para>
  <para style="q1" vid="HOS 12:12">為得妻子而看顧羊群。<verse eid="HOS 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13" />耶和華藉著一位先知</para>
  <para style="q1" vid="HOS 12:13">把<char style="pn">以色列</char>從<char style="pn">埃及</char>帶上來，</para>
  <para style="q1" vid="HOS 12:13">也藉著一位先知看顧他。<verse eid="HOS 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14" />
    <char style="pn">以法蓮</char>極力惹怒耶和華，</para>
  <para style="q1" vid="HOS 12:14">所以他的主</para>
  <para style="q1" vid="HOS 12:14">把他的血債歸在他身上，</para>
  <para style="q1" vid="HOS 12:14">把他的羞辱回報給他。<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1" />從前<char style="pn">以法蓮</char>一說話，人都戰兢；</para>
  <para style="q1" vid="HOS 13:1">他在<char style="pn">以色列</char>中被高舉。</para>
  <para style="q1" vid="HOS 13:1">但他因事奉<char style="pn">巴力</char>而有了罪責，</para>
  <para style="q1" vid="HOS 13:1">以致敗亡<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">敗亡——原文直譯「死亡」。</char></note>。<verse eid="HOS 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2" />如今他們一再犯罪！</para>
  <para style="q1" vid="HOS 13:2">他們用銀子為自己鑄造神像，</para>
  <para style="q1" vid="HOS 13:2">照著自己的聰明鑄造偶像，</para>
  <para style="q1" vid="HOS 13:2">全都是工匠的作品。</para>
  <para style="q1" vid="HOS 13:2">論到這些，他們說：</para>
  <para style="q1" vid="HOS 13:2">「讓獻祭的人親吻金牛犢吧！」<verse eid="HOS 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3" />因此他們必如清晨的雲霧，</para>
  <para style="q1" vid="HOS 13:3">又如早上消逝的露水；</para>
  <para style="q1" vid="HOS 13:3">如打穀場上吹走的糠秕，</para>
  <para style="q1" vid="HOS 13:3">又如窗口冒出的煙。<verse eid="HOS 13:3" /></para>
  <para style="b" />
  <para style="s">摧毀與救贖</para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4" />自從你出<char style="pn">埃及</char>地，</para>
  <para style="q1" vid="HOS 13:4">我耶和華就是你的神。</para>
  <para style="q1" vid="HOS 13:4">除我以外，你不可認識別的神；</para>
  <para style="q1" vid="HOS 13:4">在我之外，沒有拯救者。<verse eid="HOS 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5" />是我在曠野中，</para>
  <para style="q1" vid="HOS 13:5">在乾旱之地眷顧<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">眷顧——原文直譯「認識」；七十士譯本作「餵養」。</char></note>你。<verse eid="HOS 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6" />他們在牧場上，</para>
  <para style="q1" vid="HOS 13:6">得以飽足。</para>
  <para style="q1" vid="HOS 13:6">他們飽足了，</para>
  <para style="q1" vid="HOS 13:6">就心裡高傲，</para>
  <para style="q1" vid="HOS 13:6">因此忘記了我。<verse eid="HOS 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7" />所以我要像猛獅攻擊他們，</para>
  <para style="q1" vid="HOS 13:7">像路旁的豹子窺伺他們。<verse eid="HOS 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8" />我要像失去幼仔的母熊衝向他們，</para>
  <para style="q1" vid="HOS 13:8">我要撕裂他們的胸膛，</para>
  <para style="q1" vid="HOS 13:8">像母獅在那裡吞噬他們，</para>
  <para style="q1" vid="HOS 13:8">田野的走獸必撕裂他們。<verse eid="HOS 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9" />
    <char style="pn">以色列</char>啊，我要毀滅你，</para>
  <para style="q1" vid="HOS 13:9">因為你敵對我，敵對你的幫助者<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false">因為你敵對我，敵對你的幫助者——七十士譯本作「誰能幫助你呢」。</char></note>。<verse eid="HOS 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10" />你的王究竟在哪裡呢？</para>
  <para style="q1" vid="HOS 13:10">讓他在你各城拯救你吧！</para>
  <para style="q1" vid="HOS 13:10">你的審判官在哪裡呢？</para>
  <para style="q1" vid="HOS 13:10">你從前竟然說：</para>
  <para style="q1" vid="HOS 13:10">「請賜給我君王和首領！」<verse eid="HOS 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11" />我在怒氣中賜給了你君王，</para>
  <para style="q1" vid="HOS 13:11">又在盛怒中廢去君王。<verse eid="HOS 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12" />
    <char style="pn">以法蓮</char>的罪孽被包裹起來，</para>
  <para style="q1" vid="HOS 13:12">他的罪惡被封存了。<verse eid="HOS 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13" />臨產婦人的絞痛將臨到他身上，</para>
  <para style="q1" vid="HOS 13:13">他是毫無智慧的兒子！</para>
  <para style="q1" vid="HOS 13:13">是的，孩子出母腹的時候到了，</para>
  <para style="q1" vid="HOS 13:13">他卻耽延不出。<verse eid="HOS 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14" />我要救贖他們脫離陰間的權勢，</para>
  <para style="q1" vid="HOS 13:14">把他們從死亡中贖回來。</para>
  <para style="q1" vid="HOS 13:14">死亡啊，你的毒刺<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">毒刺——原文直譯「瘟疫」。</char></note>在哪裡？</para>
  <para style="q1" vid="HOS 13:14">陰間哪，你的毒害在哪裡？</para>
  <para style="q1" vid="HOS 13:14">憐恤從我眼前隱藏了！<verse eid="HOS 13:14" /></para>
  <para style="b" />
  <para style="s">將要來臨的審判</para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 13:15" />他雖然在蘆葦<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">蘆葦——或譯作「兄弟」。</char></note>中茂盛，</para>
  <para style="q1" vid="HOS 13:15">但必有東風颳來，</para>
  <para style="q1" vid="HOS 13:15">是耶和華的風，從曠野上來。</para>
  <para style="q1" vid="HOS 13:15">他的源頭必枯乾，</para>
  <para style="q1" vid="HOS 13:15">他的泉源必乾涸；</para>
  <para style="q1" vid="HOS 13:15">東風將颳走寶庫裡的一切寶器。<verse eid="HOS 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16" />
    <char style="pn">撒瑪利亞</char>要承擔罪責，</para>
  <para style="q1" vid="HOS 13:16">因為他悖逆他的神。</para>
  <para style="q1" vid="HOS 13:16">他必倒在刀下，</para>
  <para style="q1" vid="HOS 13:16">他的幼童將被摔死，</para>
  <para style="q1" vid="HOS 13:16">他的孕婦將被剖開。<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="s">呼籲以色列回轉</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1" />
    <char style="pn">以色列</char>啊，回轉吧，</para>
  <para style="q1" vid="HOS 14:1">歸向耶和華你的神！</para>
  <para style="q1" vid="HOS 14:1">因為你的罪孽使你絆倒了。<verse eid="HOS 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2" />要帶上你的祈求，</para>
  <para style="q1" vid="HOS 14:2">回轉歸向耶和華，對他說：</para>
  <para style="q1" vid="HOS 14:2">「求你饒恕所有的罪孽，</para>
  <para style="q1" vid="HOS 14:2">以恩惠接納我們<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">我們——輔助詞語。</char></note>，</para>
  <para style="q1" vid="HOS 14:2">好讓我們以嘴唇的祭<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">嘴唇的祭——原文直譯「嘴唇」；或譯作「讚美」。</char></note>代替公牛獻上。<verse eid="HOS 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3" />
    <char style="pn">亞述</char>不能拯救我們，</para>
  <para style="q1" vid="HOS 14:3">我們不再乘駕<char style="pn">埃及</char><note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">埃及——輔助詞語。</char></note>戰馬，</para>
  <para style="q1" vid="HOS 14:3">也不再把我們手所造的稱為</para>
  <para style="q1" vid="HOS 14:3">『我們的神』。</para>
  <para style="q1" vid="HOS 14:3">只有在你那裡，孤兒才蒙憐憫！」<verse eid="HOS 14:3" /></para>
  <para style="b" />
  <para style="s">以色列復興的應許</para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4" />我要醫除他們的背道；</para>
  <para style="q1" vid="HOS 14:4">我心甘情願愛他們，</para>
  <para style="q1" vid="HOS 14:4">我已轉消對他們的怒氣。<verse eid="HOS 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5" />我要像露水滋潤<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">滋潤——輔助詞語。</char></note><char style="pn">以色列</char>，</para>
  <para style="q1" vid="HOS 14:5">他必如百合花綻放，</para>
  <para style="q1" vid="HOS 14:5">如<char style="pn">黎巴嫩</char>的樹木扎根。<verse eid="HOS 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 14:6" />他的嫩枝必伸展，</para>
  <para style="q1" vid="HOS 14:6">他的尊榮如橄欖樹，</para>
  <para style="q1" vid="HOS 14:6">他的香氣如<char style="pn">黎巴嫩</char>的香柏樹<note caller="+" style="f"><char style="fr" closed="false">14:6 </char><char style="ft" closed="false">的香柏樹——輔助詞語。</char></note>。<verse eid="HOS 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7" />那些曾住在他樹蔭下的</para>
  <para style="q1" vid="HOS 14:7">將回歸，發旺如五穀；</para>
  <para style="q1" vid="HOS 14:7">他必興盛如葡萄樹，</para>
  <para style="q1" vid="HOS 14:7">他的名聲如<char style="pn">黎巴嫩</char>的酒。<verse eid="HOS 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8" />
    <char style="pn">以法蓮</char>說：</para>
  <para style="q1" vid="HOS 14:8">「我與偶像還有什麼相干呢？」</para>
  <para style="q1" vid="HOS 14:8">那時，我必回應他，看顧他。</para>
  <para style="q1" vid="HOS 14:8">我像青翠的松樹，</para>
  <para style="q1" vid="HOS 14:8">你的果實從我而出。<verse eid="HOS 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9" />誰是智慧人，願他領悟這些事；</para>
  <para style="q1" vid="HOS 14:9">誰是有悟性的人，</para>
  <para style="q1" vid="HOS 14:9">願他明白這一切！</para>
  <para style="q1" vid="HOS 14:9">是的，耶和華的道路正直，</para>
  <para style="q1" vid="HOS 14:9">義人走在其上，</para>
  <para style="q1" vid="HOS 14:9">悖逆的人卻在其上絆倒。<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>