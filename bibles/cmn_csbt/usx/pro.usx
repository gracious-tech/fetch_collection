<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">箴言</para>
  <para style="mt">箴言</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">箴言的目的</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />
    <char style="pn">以色列</char>的王，<char style="pn">大衛</char>的兒子<char style="pn">所羅門</char>的箴言<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />是為了使人明白智慧和管教，</para>
  <para style="q1" vid="PRO 1:2">領悟有悟性的言語，<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />為了接受管教、行事明達，</para>
  <para style="q1" vid="PRO 1:3">有公義、公正、公平；<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />也是為了把聰明給無知的人，</para>
  <para style="q1" vid="PRO 1:4">把知識和謀略給少年人。<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />讓智慧人聽了，就增添學問，</para>
  <para style="q1" vid="PRO 1:5">讓有悟性的人得到指引，<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />使他們領悟箴言和比喻，</para>
  <para style="q1" vid="PRO 1:6">領悟智慧人的話語和謎題<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">謎題——或譯作「謎語」或「隱語」。</char></note>。<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />敬畏耶和華是知識的開端<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">開端——或譯作「源頭」 。</char></note>，</para>
  <para style="q1" vid="PRO 1:7">愚妄人藐視智慧和訓導。<verse eid="PRO 1:7" /></para>
  <para style="b" />
  <para style="s">不要受惡人的引誘</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />我兒啊，你要聽從你父親的管教，</para>
  <para style="q1" vid="PRO 1:8">不要撇棄你母親的訓誨！<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />因為這些是你頭上恩惠的花冠，</para>
  <para style="q1" vid="PRO 1:9">是你頸項上的一串明珠。<verse eid="PRO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />我兒啊，如果罪人引誘你，</para>
  <para style="q1" vid="PRO 1:10">你不要順從！<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />如果他們說：</para>
  <para style="q1" vid="PRO 1:11">「你與我們一起去吧，</para>
  <para style="q1" vid="PRO 1:11">讓我們埋伏，殺人流血，</para>
  <para style="q1" vid="PRO 1:11">任意設伏攻擊無辜的人，<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />讓我們活活地囫圇吞掉他們，</para>
  <para style="q1" vid="PRO 1:12">就像陰間吞掉那些下陰坑的人；<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />我們將找到各樣寶貴的財物，</para>
  <para style="q1" vid="PRO 1:13">用掠物裝滿我們的房屋；<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />把你的那份<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">份——原文直譯「籤」。</char></note>投入我們當中吧，</para>
  <para style="q1" vid="PRO 1:14">我們大家共用一個錢袋！」<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />如果這樣，我兒啊，不要與他們走同一條道路，</para>
  <para style="q1" vid="PRO 1:15">要禁止你的腳走他們的路，<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />因為他們的腳奔向邪惡，</para>
  <para style="q1" vid="PRO 1:16">他們急於殺人流血。<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />要知道，在任何飛鳥眼前布設網羅都是無用的。<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />他們埋伏，是在流自己的血；</para>
  <para style="q1" vid="PRO 1:18">他們設伏，是在害自己的性命。<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />一切貪圖私利者所行的路<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">路——七十士譯本作「結局」。</char></note>就是這樣，</para>
  <para style="q1" vid="PRO 1:19">不義之財將奪去其擁有者的性命。<verse eid="PRO 1:19" /></para>
  <para style="b" />
  <para style="s">智慧的呼喚</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />智慧在街道上呼喊，</para>
  <para style="q1" vid="PRO 1:20">在廣場上揚聲；<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />在喧鬧的街頭呼喚，</para>
  <para style="q1" vid="PRO 1:21">在城門的入口、在城中發出言語：<verse eid="PRO 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />「無知的人喜愛無知，</para>
  <para style="q1" vid="PRO 1:22">譏諷者貪愛譏諷，</para>
  <para style="q1" vid="PRO 1:22">愚昧人恨惡知識，</para>
  <para style="q1" vid="PRO 1:22">要到什麼時候呢？<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />你們要因我的責備而回轉；</para>
  <para style="q1" vid="PRO 1:23">看哪，我要把我的靈傾注在你們身上，</para>
  <para style="q1" vid="PRO 1:23">使你們明白我的話語！<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />既然我呼喚了，你們拒絕，</para>
  <para style="q1" vid="PRO 1:24">我伸出了手，沒有人留心，<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />你們忽視了我一切的勸告，</para>
  <para style="q1" vid="PRO 1:25">也沒有接受我的責備；<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />那麼，你們遭難時，我就譏笑；</para>
  <para style="q1" vid="PRO 1:26">恐怖臨到你們時，我就嘲笑——<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />那時，恐怖像風暴那樣臨到，</para>
  <para style="q1" vid="PRO 1:27">災難像旋風那樣來臨，</para>
  <para style="q1" vid="PRO 1:27">患難和困苦臨到你們身上。<verse eid="PRO 1:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />那時，他們將呼求我，我卻不回應；</para>
  <para style="q1" vid="PRO 1:28">他們將切切尋找我，卻找不到。<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />正是因為他們恨惡知識，</para>
  <para style="q1" vid="PRO 1:29">沒有選擇敬畏耶和華，<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />沒有接受我的勸告，</para>
  <para style="q1" vid="PRO 1:30">藐視了我一切的責備，<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />所以他們將吃盡自己行為的果實，</para>
  <para style="q1" vid="PRO 1:31">飽嘗自己計謀的後果。<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />要知道，無知人的背道將害死自己，</para>
  <para style="q1" vid="PRO 1:32">愚昧人的安樂將毀了自己；<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />但那聽從我的，將安然居住，</para>
  <para style="q1" vid="PRO 1:33">得享安逸，不怕惡事。」<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s">智慧的價值</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />我兒啊，如果你接受我的言語，</para>
  <para style="q1" vid="PRO 2:1">把我的誡命珍藏在你裡面，<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />使你的耳朵留心聽智慧，使你的心專注聰慧；<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />如果你向悟性呼求，向聰慧揚聲，<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />尋求她如同尋求銀子，搜尋她如同搜尋寶藏；<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />那麼，你就會領悟如何敬畏耶和華，</para>
  <para style="q2" vid="PRO 2:5">尋得對神的認識；<verse eid="PRO 2:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="PRO 2:6" />因為耶和華賜予智慧；</para>
  <para style="q2" vid="PRO 2:6">知識和聰慧都出自他的口。<verse eid="PRO 2:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="PRO 2:7" />他為正直人留存真知，</para>
  <para style="q2" vid="PRO 2:7">他是行事純全人的盾牌；<verse eid="PRO 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 2:8" />為要守護公正的路，</para>
  <para style="q2" vid="PRO 2:8">看守他忠信者的道；<verse eid="PRO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />你也會領悟公義、公正、公平，</para>
  <para style="q2" vid="PRO 2:9">就是一切美善的路；<verse eid="PRO 2:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="PRO 2:10" />因為智慧會進入你的心，</para>
  <para style="q2" vid="PRO 2:10">知識會使你的靈魂喜悅；<verse eid="PRO 2:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="PRO 2:11" />謀略會看守你，</para>
  <para style="q2" vid="PRO 2:11">聰慧會守護你。<verse eid="PRO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />這是要救你遠離邪惡的道路，</para>
  <para style="q2" vid="PRO 2:12">遠離說話荒謬的人——<verse eid="PRO 2:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 2:13" />那些人離棄正直的路途，</para>
  <para style="q2" vid="PRO 2:13">走在黑暗的道路上；<verse eid="PRO 2:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 2:14" />他們因做惡事而歡喜，</para>
  <para style="q2" vid="PRO 2:14">因惡人的荒謬而快樂；<verse eid="PRO 2:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PRO 2:15" />他們的路途歪邪，</para>
  <para style="q2" vid="PRO 2:15">他們的路徑邪僻。<verse eid="PRO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />這也是要救你遠離淫婦<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">淫婦——或譯作「陌生女子」。</char></note>，</para>
  <para style="q2" vid="PRO 2:16">遠離說諂媚話的淫蕩女子<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">淫蕩女子——或譯作「外邦女子」。</char></note>——<verse eid="PRO 2:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 2:17" />她離棄了年輕時的同伴，</para>
  <para style="q2" vid="PRO 2:17">忘記了神的約；<verse eid="PRO 2:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="PRO 2:18" />她的家必陷入死亡，</para>
  <para style="q2" vid="PRO 2:18">她的路徑必歸入陰魂之地；<verse eid="PRO 2:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="PRO 2:19" />所有到她那裡去的，都不能回來，</para>
  <para style="q2" vid="PRO 2:19">也不能踏上生命的路途。<verse eid="PRO 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />你領悟了<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">領悟了——輔助詞語。</char></note>，就必行良善人的道，</para>
  <para style="q1" vid="PRO 2:20">謹守義人的路。<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />要知道，正直人將在地上安居，</para>
  <para style="q1" vid="PRO 2:21">純全人將在地上存留；<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />而惡人將從地上被剪除，</para>
  <para style="q1" vid="PRO 2:22">背信者將從地上被拔出。<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s">要信靠主</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />我兒啊，不要忘記我的訓誨，</para>
  <para style="q1" vid="PRO 3:1">你的心要謹守我的誡命，<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />因為它們會將長久的日子、</para>
  <para style="q1" vid="PRO 3:2">生命的歲月與平安加給你。<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />不要讓慈愛和信實離開你，</para>
  <para style="q1" vid="PRO 3:3">要把它們繫在你的頸項上，</para>
  <para style="q1" vid="PRO 3:3">刻在你的心版上；<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />這樣，你就在神和人的眼前蒙恩，</para>
  <para style="q1" vid="PRO 3:4">得著美好的見識。<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />你要全心依靠耶和華，</para>
  <para style="q1" vid="PRO 3:5">不要依賴自己的悟性；<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />在你一切的道路上，都要認定他，</para>
  <para style="q1" vid="PRO 3:6">他就會修直你的路。<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />不要自以為<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">自以為——原文直譯「在你眼中」。</char></note>有智慧，</para>
  <para style="q1" vid="PRO 3:7">要敬畏耶和華，遠離惡事；<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />這樣健康就臨到你的身上<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">身上——原文直譯「肚臍」。</char></note>，</para>
  <para style="q1" vid="PRO 3:8">你的骨頭就得到滋養。<verse eid="PRO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />你當以你的財物，以一切初熟的收成，</para>
  <para style="q1" vid="PRO 3:9">榮耀耶和華；<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />這樣，你的倉庫必充滿，豐豐足足，</para>
  <para style="q1" vid="PRO 3:10">你的榨酒池也必溢出新酒。<verse eid="PRO 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />我兒啊，不可厭棄耶和華的管教，</para>
  <para style="q1" vid="PRO 3:11">也不可厭惡他的責備！<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />因為耶和華責備他所愛的，</para>
  <para style="q1" vid="PRO 3:12">正如父親責備他所喜悅的兒子。<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="s">智慧帶來福份</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />那找到智慧、獲得聰慧的人，</para>
  <para style="q1" vid="PRO 3:13">是蒙福的！<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />因為智慧的盈利好過銀子，</para>
  <para style="q1" vid="PRO 3:14">她的收益勝過金子；<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />她比紅寶石更寶貴，</para>
  <para style="q1" vid="PRO 3:15">你喜悅的一切都無法與她相比；<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />她的右手有長壽，</para>
  <para style="q1" vid="PRO 3:16">左手有財富和尊榮；<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />她的道路是恩慈的道路，</para>
  <para style="q1" vid="PRO 3:17">她的路徑全是平安；<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />對於持守她的，她就是生命樹；</para>
  <para style="q1" vid="PRO 3:18">持定她的人被稱為有福。<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />耶和華藉著智慧奠定大地的根基，</para>
  <para style="q1" vid="PRO 3:19">藉著聰慧確立諸天；<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />藉著他的知識，深淵就裂開，</para>
  <para style="q1" vid="PRO 3:20">雲朵也滴下甘露。<verse eid="PRO 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />我兒啊，你要謹守真知和謀略，</para>
  <para style="q1" vid="PRO 3:21">不要讓它們離開你的眼目！<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />對於你的靈魂，它們就是生命；</para>
  <para style="q1" vid="PRO 3:22">它們也是你頸項上的美飾<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">美飾——原文直譯「恩惠」。</char></note>。<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />這樣你就會安然行路，</para>
  <para style="q1" vid="PRO 3:23">你的腳也不會跌跌撞撞；<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />你躺下時，也不會懼怕；</para>
  <para style="q1" vid="PRO 3:24">你躺下，就睡得甜美。<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />突來的恐怖，你不必害怕；</para>
  <para style="q1" vid="PRO 3:25">惡人遭毀滅時，你也不必擔心。<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />因為耶和華是你的依靠<note caller="+" style="f"><char style="fr" closed="false">3:26 </char><char style="ft" closed="false">是你的依靠——或譯作「要在你身旁」。</char></note>，</para>
  <para style="q1" vid="PRO 3:26">他保守你的腳不陷入網羅。<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="s">要善待人</para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />當你的手有能力做好事時，</para>
  <para style="q1" vid="PRO 3:27">不要有所保留，不給應得的人；<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />當你那裡有鄰人所求的<note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">所求的——輔助詞語。</char></note>，不可對他說：</para>
  <para style="q1" vid="PRO 3:28">「走吧，明天再來，我才給你。」<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />你鄰人在你附近安居時，</para>
  <para style="q1" vid="PRO 3:29">不要向他策劃惡事；<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />如果人沒有惡待你，</para>
  <para style="q1" vid="PRO 3:30">不要無故與他相爭。<verse eid="PRO 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />不要嫉妒殘暴的人，</para>
  <para style="q1" vid="PRO 3:31">也不要選擇他的任何道路；<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />因為耶和華憎惡邪僻的人，</para>
  <para style="q1" vid="PRO 3:32">而與正直的人親密無間。<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />耶和華的詛咒在惡人的家，</para>
  <para style="q1" vid="PRO 3:33">而他祝福義人的居所；<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />他譏諷那些譏諷者，</para>
  <para style="q1" vid="PRO 3:34">把恩惠賜給卑微人。<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />智慧人將繼承榮耀，</para>
  <para style="q1" vid="PRO 3:35">愚昧人卻蒙受羞辱<note caller="+" style="f"><char style="fr" closed="false">3:35 </char><char style="ft" closed="false">蒙受羞辱——原文直譯「高舉羞辱」。</char></note>。<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s">父親的教導</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />孩子們哪，你們要聽從父親的管教；</para>
  <para style="q1" vid="PRO 4:1">要留心，好使你們獲得悟性；<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />因為我給你們的是美好的教導；</para>
  <para style="q1" vid="PRO 4:2">你們不要離棄我的訓誨。<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />當我在父親身邊還是個孩子，</para>
  <para style="q1" vid="PRO 4:3">在母親面前是幼嫩的獨生子時，<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />父親指教我，對我說：</para>
  <para style="q1" vid="PRO 4:4">「你的心要持定我的話語，</para>
  <para style="q1" vid="PRO 4:4">你當遵守我的誡命，就得以存活！<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />你要獲得智慧，獲得悟性；</para>
  <para style="q1" vid="PRO 4:5">不要忘記，也不要偏離我口中的言語。<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />你不要離棄智慧，她就會保守你；</para>
  <para style="q1" vid="PRO 4:6">你要愛她，她就守護你。<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />智慧是首要的，<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">智慧是首要的，——或譯作「智慧的開端就是：」。</char></note>你要獲得智慧；</para>
  <para style="q1" vid="PRO 4:7">要用你所得的一切獲得悟性！<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />你當尊崇智慧，她就高舉你；</para>
  <para style="q1" vid="PRO 4:8">你擁抱她，她就使你得尊榮，<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />她必將恩惠的花冠戴在你的頭上，</para>
  <para style="q1" vid="PRO 4:9">把榮耀的冠冕給予你。」<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="s">人生的兩條道路</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />我兒啊，你要聽，並要接受我的言語，</para>
  <para style="q1" vid="PRO 4:10">你生命的歲月就必增多！<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />我指示你走在智慧的道路上，</para>
  <para style="q1" vid="PRO 4:11">使你踏上正直的路徑；<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />你行走的時候，腳步就不受阻礙；</para>
  <para style="q1" vid="PRO 4:12">就算你奔跑，也不被絆倒。<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />你要持守訓導，不要放棄；</para>
  <para style="q1" vid="PRO 4:13">要謹守智慧，因為她是你的生命。<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />你不要進入惡人的路途，</para>
  <para style="q1" vid="PRO 4:14">也不要走上邪惡的道路；<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />你要躲避它，不要經過那裡，</para>
  <para style="q1" vid="PRO 4:15">要從那裡轉離，繼續前行。<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />要知道，這些人如果不作惡就睡不著覺，</para>
  <para style="q1" vid="PRO 4:16">不絆倒人就睡臥不安；<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />因為他們吃的是邪惡之餅，</para>
  <para style="q1" vid="PRO 4:17">喝的是殘暴之酒。<verse eid="PRO 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />但義人的路途如同黎明的光輝，</para>
  <para style="q1" vid="PRO 4:18">越來越亮，直到正午；<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />惡人的道路卻如幽暗黑夜，</para>
  <para style="q1" vid="PRO 4:19">他們不知道被什麼絆倒。<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="s">人生的正路</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />我兒啊，你要留心聽我的話語，</para>
  <para style="q1" vid="PRO 4:20">側耳聽我的言語！<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />不要讓它們離開你的眼目，</para>
  <para style="q1" vid="PRO 4:21">要把它們謹守在你心中；<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />因為對找到它們的人，它們就是生命，</para>
  <para style="q1" vid="PRO 4:22">也是全身的痊癒之道<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">之道——輔助詞語。</char></note>。<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />當謹守你的心，勝過保守一切，</para>
  <para style="q1" vid="PRO 4:23">因為生命的泉源由心而出。<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />當使口中的狡詐離開你，</para>
  <para style="q1" vid="PRO 4:24">使嘴上的邪僻遠離你。<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />你的眼目要向前觀看，</para>
  <para style="q1" vid="PRO 4:25">你的目光要直視前方。<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />你要度量腳下的路徑，</para>
  <para style="q1" vid="PRO 4:26">你一切的道路就會被確立。<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />你不要偏右，也不要偏左，</para>
  <para style="q1" vid="PRO 4:27">要使你的腳離開惡事。<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s">要逃離誘惑</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />我兒啊，你要留心聽我的智慧，</para>
  <para style="q1" vid="PRO 5:1">側耳聽我聰慧的話語，<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />好使你謹守謀略，</para>
  <para style="q1" vid="PRO 5:2">使你的嘴唇守護知識！<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />雖然淫婦的嘴唇滴落蜂房之蜜，</para>
  <para style="q1" vid="PRO 5:3">她的唇齒比油更滑；<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />但她的盡頭，卻苦澀如苦艾，</para>
  <para style="q1" vid="PRO 5:4">銳利如雙刃的刀劍；<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />她的雙腳下到死地，</para>
  <para style="q1" vid="PRO 5:5">她的腳步踏入陰間；<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />她不度量生命的路途，</para>
  <para style="q1" vid="PRO 5:6">她的路徑變遷不定，自己卻不知道。<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />孩子們哪，現在你們當聽從我，</para>
  <para style="q1" vid="PRO 5:7">不要偏離我口中的言語！<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />當使你的道路遠離那女人，</para>
  <para style="q1" vid="PRO 5:8">不要靠近她的家門口；<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />免得把你的尊榮交給別人，</para>
  <para style="q1" vid="PRO 5:9">把你的歲月交給殘忍的人；<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />免得別人滿得你的力量，</para>
  <para style="q1" vid="PRO 5:10">你的勞苦所得就歸入外人的家。<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />當你的皮肉和身體衰竭時，</para>
  <para style="q1" vid="PRO 5:11">你必在你的盡頭哀嘆，<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />說：「我怎麼就恨惡了管教呢？</para>
  <para style="q1" vid="PRO 5:12">我的心怎麼就藐視了責備呢？<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />我沒有聽導師的話，</para>
  <para style="q1" vid="PRO 5:13">也沒有側耳聽教導我的人；<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />在會眾和集會裡，</para>
  <para style="q1" vid="PRO 5:14">我幾乎身敗名裂！」<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="s">要專愛妻子</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />你當喝自己水窖中的水，</para>
  <para style="q1" vid="PRO 5:15">喝自己井裡流出來的水。<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />難道你的泉源要流溢在街道上，</para>
  <para style="q1" vid="PRO 5:16">你河渠的水要流溢在廣場上嗎？<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />讓它們唯獨屬於你自己，</para>
  <para style="q1" vid="PRO 5:17">不要讓別人與你共用。<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />願你的泉源蒙祝福，</para>
  <para style="q1" vid="PRO 5:18">你要因你年輕時所娶<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">所娶——輔助詞語。</char></note>的妻子歡喜；<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />可愛的母鹿，優美的雌鹿，</para>
  <para style="q1" vid="PRO 5:19">願她的雙乳使你時時滿足，</para>
  <para style="q1" vid="PRO 5:19">願你一直迷戀在她的愛中。<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />我兒啊，你為什麼迷戀淫婦，</para>
  <para style="q1" vid="PRO 5:20">為什麼擁抱淫蕩女子的胸呢？<verse eid="PRO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />因為人的道路都在耶和華的眼前，</para>
  <para style="q1" vid="PRO 5:21">他度量人一切的路徑；<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />惡人被自己的罪孽捉住，</para>
  <para style="q1" vid="PRO 5:22">被自己罪的繩索捆綁；<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />他必因不受管教而死亡，</para>
  <para style="q1" vid="PRO 5:23">因自己極度愚妄而迷失。<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s">不陷入作保的圈套</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />我兒啊，如果你為鄰人作保，</para>
  <para style="q1" vid="PRO 6:1">為別人<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">別人——或譯作「陌生人」。</char></note>擊掌起誓，<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />因你口中的言語陷入圈套，</para>
  <para style="q1" vid="PRO 6:2">因你口中的言語被捉住了——<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />那麼，我兒啊，既然你已經落在鄰人的掌中，</para>
  <para style="q1" vid="PRO 6:3">你就當這樣做來解救自己：</para>
  <para style="q1" vid="PRO 6:3">你當去，謙卑下來，懇求你的鄰人；<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />不要讓你的眼睛睡覺，</para>
  <para style="q1" vid="PRO 6:4">也不要讓你的眼簾打盹；<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />你當解救自己，如同羚羊脫離獵人的<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">獵人的——輔助詞語。</char></note>手，</para>
  <para style="q1" vid="PRO 6:5">如同雀鳥脫離捕鳥人的手。<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="s">對懶惰的人的警告</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />懶惰的人哪，你當到螞蟻那裡去，</para>
  <para style="q1" vid="PRO 6:6">觀看牠的行為，得著智慧！<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />螞蟻雖然沒有統領，沒有官長，也沒有管轄者，<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />卻在夏天預備自己的糧食，</para>
  <para style="q1" vid="PRO 6:8">在收割的時候收集自己的食物。<verse eid="PRO 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />懶惰的人哪，你要躺到什麼時候呢？</para>
  <para style="q1" vid="PRO 6:9">你什麼時候從睡眠中起來呢？<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />再睡一會兒，</para>
  <para style="q1" vid="PRO 6:10">再打盹一會兒，</para>
  <para style="q1" vid="PRO 6:10">再抱著雙手躺一會兒，<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />你的貧窮就會像強盜來到，</para>
  <para style="q1" vid="PRO 6:11">你的缺乏就會像拿兵器的人<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">拿兵器的人——原文直譯「拿盾牌的人」。</char></note>來到。<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="s">卑劣的人</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />卑劣的作惡者，</para>
  <para style="q1" vid="PRO 6:12">憑狡詐的口行事；<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />他用眼嘲弄，</para>
  <para style="q1" vid="PRO 6:13">用腳示意，用手指點劃；<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />他心裡荒謬，</para>
  <para style="q1" vid="PRO 6:14">時時策劃惡事，散布紛爭；<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />因此他的災難將突然臨到，</para>
  <para style="q1" vid="PRO 6:15">他頃刻之間將被摧毀，無法挽回。<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="s">主所恨惡的</para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />耶和華所恨惡的有六樣，</para>
  <para style="q1" vid="PRO 6:16">連他心中所憎惡的有七樣：<verse eid="PRO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17" />就是高傲的眼目、</para>
  <para style="q1" vid="PRO 6:17">撒謊的舌頭、</para>
  <para style="q1" vid="PRO 6:17">沾滿無辜人血的手、<verse eid="PRO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18" />圖謀惡計的心、</para>
  <para style="q1" vid="PRO 6:18">奔向邪惡的腳、<verse eid="PRO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19" />口吐謊言的假見證人，</para>
  <para style="q1" vid="PRO 6:19">以及在兄弟間散布紛爭的人。<verse eid="PRO 6:19" /></para>
  <para style="b" />
  <para style="s">不要淫亂</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />我兒啊，你當謹守你父親的誡命，</para>
  <para style="q1" vid="PRO 6:20">不要撇棄你母親的訓誨！<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />你當把它們一直繫在你的心上，</para>
  <para style="q1" vid="PRO 6:21">把它們束在你的頸項上。<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />你往來行走時，她就引導你；</para>
  <para style="q1" vid="PRO 6:22">你躺下時，她就保守你；</para>
  <para style="q1" vid="PRO 6:22">你醒來時，她就與你談論；<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />因為誡命是燈，訓誨是光，</para>
  <para style="q1" vid="PRO 6:23">出於管教的責備是生命的道路，<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />為要保守你遠離作惡的女人，</para>
  <para style="q1" vid="PRO 6:24">遠離淫蕩女子油滑的舌頭。<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />你心裡不要貪愛她的美色，</para>
  <para style="q1" vid="PRO 6:25">也不要被她的眼簾勾引。<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />要知道，為了妓女，</para>
  <para style="q1" vid="PRO 6:26">人會卑賤如一塊餅<note caller="+" style="f"><char style="fr" closed="false">6:26 </char><char style="ft" closed="false">為了妓女，人會卑賤如一塊餅——或譯作「給妓女的，只是一塊餅」或「妓女使人只剩一塊餅」。</char></note>；</para>
  <para style="q1" vid="PRO 6:26">而通姦的女人<note caller="+" style="f"><char style="fr" closed="false">6:26 </char><char style="ft" closed="false">通姦的女人——原文直譯「別人的妻子」。</char></note>，會獵取寶貴的性命。<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />如果人取火，放在自己的懷中，</para>
  <para style="q1" vid="PRO 6:27">難道他的衣服不會被燒掉嗎？<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />如果人走在火炭上，</para>
  <para style="q1" vid="PRO 6:28">難道他的腳不會被燒焦嗎？<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />那與鄰人妻子同房的也是如此；</para>
  <para style="q1" vid="PRO 6:29">所有碰她的，都難逃罪罰。<verse eid="PRO 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />如果竊賊實在飢餓，為了充飢而偷竊，</para>
  <para style="q1" vid="PRO 6:30">人們不會藐視他；<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />但如果他被發現，就要償還七倍，</para>
  <para style="q1" vid="PRO 6:31">甚至交出全部的家財。<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />與女人通姦的，缺乏心智；</para>
  <para style="q1" vid="PRO 6:32">行這事的，毀滅自己。<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />他必受打擊和羞辱，</para>
  <para style="q1" vid="PRO 6:33">他的恥辱無法抹掉。<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />因為嫉妒是男人<note caller="+" style="f"><char style="fr" closed="false">6:34 </char><char style="ft" closed="false">男人——或譯作「丈夫」。</char></note>的怒火，</para>
  <para style="q1" vid="PRO 6:34">他在報復之日必不留情；<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />他不顧任何的贖價，</para>
  <para style="q1" vid="PRO 6:35">即使禮物增多，他也不會接受。<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />我兒啊，你當遵守我的言語，</para>
  <para style="q1" vid="PRO 7:1">把我的誡命珍藏在你裡面！<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />遵守我的誡命，就得以存活！</para>
  <para style="q1" vid="PRO 7:2">遵守我的訓誨，</para>
  <para style="q1" vid="PRO 7:2">如同保守你眼中的瞳人。<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />你當把它們繫在你的手指上，</para>
  <para style="q1" vid="PRO 7:3">把它們刻在你的心版上。<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />你當對智慧說：「你是我的姐妹」，</para>
  <para style="q1" vid="PRO 7:4">並稱呼悟性為親人；<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />這樣就能保守你遠離淫婦，</para>
  <para style="q1" vid="PRO 7:5">遠離說諂媚話的淫蕩女子。<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="s">抵禦誘惑</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />當我在我家的窗戶那裡，</para>
  <para style="q1" vid="PRO 7:6">透過窗格觀望的時候，<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />我看到在無知的人中，</para>
  <para style="q1" vid="PRO 7:7">發現在年輕人中間，</para>
  <para style="q1" vid="PRO 7:7">有一個缺乏心智的少年人，<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />他經過街道，臨近女人家的角落，</para>
  <para style="q1" vid="PRO 7:8">走上通往她家的路；<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />在黃昏，在夜晚，</para>
  <para style="q1" vid="PRO 7:9">在深夜和幽暗之中，<verse eid="PRO 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />看哪，有一個女人來迎接他！</para>
  <para style="q1" vid="PRO 7:10">她打扮得像妓女，心存詭詐；<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />她喧鬧又悖逆，</para>
  <para style="q1" vid="PRO 7:11">她的腳不留在自己的家裡；<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />她有時在街道，有時在廣場，</para>
  <para style="q1" vid="PRO 7:12">在各個角落附近埋伏。<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />她緊抓那少年人，親吻他，</para>
  <para style="q1" vid="PRO 7:13">厚顏無恥地對他說：<verse eid="PRO 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />「我已經獻上平安祭，</para>
  <para style="q1" vid="PRO 7:14">今天償還了我所許的願；<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />因此我就出來迎接你，</para>
  <para style="q1" vid="PRO 7:15">切切尋找你的面，</para>
  <para style="q1" vid="PRO 7:15">總算找到了你。<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />我在床上鋪好了繡花床單，</para>
  <para style="q1" vid="PRO 7:16">是用<char style="pn">埃及</char>麻的花紋布做的；<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />我用沒藥、沉香、肉桂，</para>
  <para style="q1" vid="PRO 7:17">熏香了我的床。<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />你來吧！讓我們飽享愛情，直到早晨，</para>
  <para style="q1" vid="PRO 7:18">讓我們在愛中盡情取樂；<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />因為我的丈夫<note caller="+" style="f"><char style="fr" closed="false">7:19 </char><char style="ft" closed="false">我的丈夫——原文直譯「那男人」。</char></note>不在家，</para>
  <para style="q1" vid="PRO 7:19">他行遠路去了。<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />他手中拿了一袋銀子，</para>
  <para style="q1" vid="PRO 7:20">要到月圓的日子才回家。」<verse eid="PRO 7:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />那女人用許多巧言勾引他，</para>
  <para style="q1" vid="PRO 7:21">用油滑的嘴唇引誘他。<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />他立刻跟隨那女人，</para>
  <para style="q1" vid="PRO 7:22">如同牛走向屠場，</para>
  <para style="q1" vid="PRO 7:22">如同愚妄人戴著腳鐐去受懲罰<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">愚妄人戴著腳鐐去受懲罰——或譯作「雄鹿跳進陷阱」。</char></note>；<verse eid="PRO 7:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23" />直到箭射穿他的肝——</para>
  <para style="q1" vid="PRO 7:23">他就像雀鳥快速進入網羅，</para>
  <para style="q1" vid="PRO 7:23">他卻不明白，這會賠上<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">會賠上——輔助詞語。</char></note>自己的性命。<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />孩子們哪，現在你們當聽從我！</para>
  <para style="q1" vid="PRO 7:24">留心聽我口中的言語：<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />你的心不要偏向她的道路，</para>
  <para style="q1" vid="PRO 7:25">也不要迷失，進入她的路徑。<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />要知道，被她刺透而倒下的人有許多，</para>
  <para style="q1" vid="PRO 7:26">連無數強者都被她殺死；<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />她的家是陰間的通道，</para>
  <para style="q1" vid="PRO 7:27">下到死亡的深處。<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s">智慧的呼喚</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />智慧不是在呼喚嗎？</para>
  <para style="q1" vid="PRO 8:1">聰慧不是在揚聲嗎？<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />她站立在道旁高處的頂端，</para>
  <para style="q1" vid="PRO 8:2">在路徑的交匯處；<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />在城門旁、在城門口、</para>
  <para style="q1" vid="PRO 8:3">在城門的入口處，她呼喊：<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />「人哪，我向你們呼喚，</para>
  <para style="q1" vid="PRO 8:4">這是我對世人的聲音！<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />無知的人哪，你們當獲得聰明！</para>
  <para style="q1" vid="PRO 8:5">愚昧的人哪，你們當領悟智慧！<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />你們當聽！</para>
  <para style="q1" vid="PRO 8:6">因為我要講高貴的事，</para>
  <para style="q1" vid="PRO 8:6">要張嘴說公平的事；<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />我的唇齒述說真理，</para>
  <para style="q1" vid="PRO 8:7">我的嘴唇憎恨邪惡。<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />我口中的言語全都公義，</para>
  <para style="q1" vid="PRO 8:8">其中沒有扭曲悖謬。<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />對有悟性的人，它們全都坦誠；</para>
  <para style="q1" vid="PRO 8:9">對尋得知識的人，它們全都正直。<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />你們要接受我的管教，而不要接受銀子；</para>
  <para style="q1" vid="PRO 8:10">要接受知識，勝過精選的金子；<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />因為智慧比紅寶石更美好，</para>
  <para style="q1" vid="PRO 8:11">人所喜悅的一切都無法與她相比。<verse eid="PRO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />我就是智慧，與聰明同住，</para>
  <para style="q1" vid="PRO 8:12">我尋得知識和謀略。<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />敬畏耶和華就是憎恨邪惡；</para>
  <para style="q1" vid="PRO 8:13">我憎恨高慢、驕傲、邪惡的道路和荒謬的口。<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />謀略和真知在我；</para>
  <para style="q1" vid="PRO 8:14">我就是悟性，大能也在我。<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />藉著我，君王施行統治，</para>
  <para style="q1" vid="PRO 8:15">君主立定公義。<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />藉著我，首領們、權貴、</para>
  <para style="q1" vid="PRO 8:16">所有公義的審判官統管治理。<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />愛我的，我就愛他們；</para>
  <para style="q1" vid="PRO 8:17">切切尋找我的，必找到我。<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />財富和榮耀在我，</para>
  <para style="q1" vid="PRO 8:18">永久的財寶和公義也在我。<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />我的果實好過金子，勝過純金；</para>
  <para style="q1" vid="PRO 8:19">我的收獲勝過精選的銀子。<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />我走在公義的路途上，</para>
  <para style="q1" vid="PRO 8:20">行在公正的路徑中，<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />要使愛我的人繼承財產，</para>
  <para style="q1" vid="PRO 8:21">並要充滿他們的庫房。<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />在耶和華創世<note caller="+" style="f"><char style="fr" closed="false">8:22 </char><char style="ft" closed="false">創世——原文直譯「他的道路」。</char></note>之始，</para>
  <para style="q1" vid="PRO 8:22">在太初創造<note caller="+" style="f"><char style="fr" closed="false">8:22 </char><char style="ft" closed="false">創造——原文直譯「他的作為」。</char></note>以先，</para>
  <para style="q1" vid="PRO 8:22">他就擁有了我。<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />從亙古，從太初，</para>
  <para style="q1" vid="PRO 8:23">從大地之初，我已經被立。<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />在沒有深淵、</para>
  <para style="q1" vid="PRO 8:24">沒有湧流眾水的泉源之時，</para>
  <para style="q1" vid="PRO 8:24">我已經誕生。<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />在群山被安置以先、</para>
  <para style="q1" vid="PRO 8:25">岡陵被安置之前，</para>
  <para style="q1" vid="PRO 8:25">我已經誕生。<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />那時耶和華還沒有造大地、田野，</para>
  <para style="q1" vid="PRO 8:26">也沒有造世上最初的塵土。<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />在他確立諸天時，我在那裡——</para>
  <para style="q1" vid="PRO 8:27">他在淵面上立定圓穹，<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />他布置天上的雲朵，</para>
  <para style="q1" vid="PRO 8:28">使深淵的泉眼噴湧；<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />他為大海設立界限，</para>
  <para style="q1" vid="PRO 8:29">使眾水不能違背他的吩咐；</para>
  <para style="q1" vid="PRO 8:29">他立定了大地的根基——<verse eid="PRO 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30" />那時我在他身邊為工匠，</para>
  <para style="q1" vid="PRO 8:30">是他每天的喜樂<note caller="+" style="f"><char style="fr" closed="false">8:30 </char><char style="ft" closed="false">是他每天的喜樂——或譯作「每天都充滿喜樂」。</char></note>，</para>
  <para style="q1" vid="PRO 8:30">時時在他面前歡笑，<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />在他的全地上歡笑，</para>
  <para style="q1" vid="PRO 8:31">我的喜樂與世人同在。<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />孩子們哪，現在你們當聽從我！</para>
  <para style="q1" vid="PRO 8:32">那些謹守我道路的，是蒙福的！<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />你們要聽從管教、要有智慧，</para>
  <para style="q1" vid="PRO 8:33">不要忽視它。<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />那聽從我、</para>
  <para style="q1" vid="PRO 8:34">在我的門旁天天警醒、</para>
  <para style="q1" vid="PRO 8:34">在我的門柱邊守候的人，</para>
  <para style="q1" vid="PRO 8:34">是蒙福的！<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />要知道，找到我的，就找到生命，</para>
  <para style="q1" vid="PRO 8:35">他也從耶和華蒙了恩典；<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />錯過我的<note caller="+" style="f"><char style="fr" closed="false">8:36 </char><char style="ft" closed="false">錯過我的——或譯作「得罪我的」。</char></note>，就傷害自己的靈魂；</para>
  <para style="q1" vid="PRO 8:36">所有恨我的，都喜愛死亡。」<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s">兩種呼喚</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />智慧建立她的家，</para>
  <para style="q1" vid="PRO 9:1">鑿出七根柱子，<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />宰殺了牲畜，</para>
  <para style="q1" vid="PRO 9:2">調制了酒，</para>
  <para style="q1" vid="PRO 9:2">又擺設了筵席。<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />她派遣使女們出去，</para>
  <para style="q1" vid="PRO 9:3">又在城的至高處呼喚：<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />「誰是無知的人呢？</para>
  <para style="q1" vid="PRO 9:4">讓他轉到我這裡來！」</para>
  <para style="q1" vid="PRO 9:4">她對那缺乏心智的人說：<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />「你們當來，吃我的餅，</para>
  <para style="q1" vid="PRO 9:5">喝我調制的酒！<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />你們要離棄無知，就得以存活，</para>
  <para style="q1" vid="PRO 9:6">要走上有悟性的道路！」<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />管教譏諷者的，自取羞辱；</para>
  <para style="q1" vid="PRO 9:7">責備惡人的，自招虧損。<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />不要責備譏諷者，免得他恨你；</para>
  <para style="q1" vid="PRO 9:8">要責備智慧人，他必愛你。<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />指教智慧人，他就更有智慧；</para>
  <para style="q1" vid="PRO 9:9">教導義人，他就增添學問。<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />敬畏耶和華是智慧的開端，</para>
  <para style="q1" vid="PRO 9:10">認識至聖者<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">至聖者——或譯作「聖者們」。</char></note>就是有悟性；<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />因為藉著智慧<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">智慧——原文直譯「我」。</char></note>，你的日子就增多，</para>
  <para style="q1" vid="PRO 9:11">你生命的歲月也會增添。<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />如果你有智慧，是為自己有智慧；</para>
  <para style="q1" vid="PRO 9:12">如果你譏諷智慧<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">智慧——輔助詞語。</char></note>，你就要獨自承擔。<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />愚昧的女人喧鬧、無知，</para>
  <para style="q1" vid="PRO 9:13">她什麼都不明白。<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />她坐在自己的家門口，</para>
  <para style="q1" vid="PRO 9:14">在城高處的座位上，<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />呼喚過路的人，</para>
  <para style="q1" vid="PRO 9:15">就是那些在路上直行的人。<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />她說：「誰是無知的人呢？</para>
  <para style="q1" vid="PRO 9:16">讓他轉到我這裡來！」</para>
  <para style="q1" vid="PRO 9:16">又對那缺乏心智的人說：<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />「偷來的水是甜的，</para>
  <para style="q1" vid="PRO 9:17">暗中吃<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false">吃——輔助詞語。</char></note>的餅是香的！」<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />但那人不知道：陰魂就在那裡；</para>
  <para style="q1" vid="PRO 9:18">被她呼喚去的，都在陰間的深處。<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">所羅門箴言錄</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />
    <char style="pn">所羅門</char>的箴言：</para>
  <para style="b" vid="PRO 10:1" />
  <para style="q1" vid="PRO 10:1">有智慧的兒子使父親歡喜；</para>
  <para style="q1" vid="PRO 10:1">愚昧的兒子使母親愁苦。<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />不義之財沒有益處，</para>
  <para style="q1" vid="PRO 10:2">唯有公義解救人脫離死亡。<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />耶和華不讓義人挨餓；</para>
  <para style="q1" vid="PRO 10:3">惡人的貪慾，他會拒絕。<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />懈怠的手，使人貧窮；</para>
  <para style="q1" vid="PRO 10:4">殷勤的手，使人富有。<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />在夏天收集的，是明達之子；</para>
  <para style="q1" vid="PRO 10:5">收割時沉睡的，是羞愧之子。<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />祝福臨到義人的頭上，</para>
  <para style="q1" vid="PRO 10:6">而惡人的口掩蓋殘暴。<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />記念義人帶來祝福，</para>
  <para style="q1" vid="PRO 10:7">惡人的名卻必朽爛。<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />智慧的心，接受誡命；</para>
  <para style="q1" vid="PRO 10:8">愚妄的嘴，自招滅亡。<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />行事純全的，安然行走；</para>
  <para style="q1" vid="PRO 10:9">道路歪邪的，必被顯明。<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />嘲弄的眼，帶來傷害；</para>
  <para style="q1" vid="PRO 10:10">愚妄的嘴，自招滅亡。<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />義人的口，是生命的泉源；</para>
  <para style="q1" vid="PRO 10:11">惡人的口，掩蓋殘暴。<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />恨能挑動紛爭，</para>
  <para style="q1" vid="PRO 10:12">愛能遮蓋一切過犯。<verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />智慧顯明在有悟性之人的嘴唇上，</para>
  <para style="q1" vid="PRO 10:13">杖打<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">打——輔助詞語。</char></note>在缺乏心智之人的背上。<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />智慧人珍藏知識，</para>
  <para style="q1" vid="PRO 10:14">愚妄人的口速招敗亡。<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />富人的財物，是他的堅固城；</para>
  <para style="q1" vid="PRO 10:15">貧弱者的貧窮，使自己敗亡。<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />義人的報償，帶來生命；</para>
  <para style="q1" vid="PRO 10:16">惡人的收獲，導致罪惡。<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />接受管教的，在生命路上；</para>
  <para style="q1" vid="PRO 10:17">離棄責備的，必導致迷失。<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />掩蓋仇恨的，有撒謊的嘴；</para>
  <para style="q1" vid="PRO 10:18">傳出謠言的，是愚昧的人。<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />多言多語，不免有過失；</para>
  <para style="q1" vid="PRO 10:19">約束自己嘴唇的，是明智的人。<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />義人的舌頭，像精選的銀子；</para>
  <para style="q1" vid="PRO 10:20">惡人的心思，所值無幾。<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />義人的嘴唇能牧養許多人，</para>
  <para style="q1" vid="PRO 10:21">愚妄人卻因缺乏心智而死亡。<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />耶和華的祝福使人富有，</para>
  <para style="q1" vid="PRO 10:22">並且他不會加上勞苦<note caller="+" style="f"><char style="fr" closed="false">10:22 </char><char style="ft" closed="false">並且他不會加上勞苦——或譯作「人的勞苦不能使它增多」。</char></note>。<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />愚昧人以行惡為樂，</para>
  <para style="q1" vid="PRO 10:23">聰慧人以智慧為樂。<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />惡人所懼怕的必臨到他，</para>
  <para style="q1" vid="PRO 10:24">義人所渴望的必蒙應允。<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />旋風一過，惡人就不復存在；</para>
  <para style="q1" vid="PRO 10:25">而義人卻有永遠的根基。<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />醋對牙怎樣、煙對眼怎樣，</para>
  <para style="q1" vid="PRO 10:26">懶惰人對派遣他的人也怎樣。<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />敬畏耶和華使年日增添，</para>
  <para style="q1" vid="PRO 10:27">而惡人的歲月必被縮短。<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />義人的期望，帶來喜樂；</para>
  <para style="q1" vid="PRO 10:28">惡人的希望，將要消亡。<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />耶和華的道路，對純全人是保障，</para>
  <para style="q1" vid="PRO 10:29">對作惡者卻是敗亡。<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />義人永遠不致動搖，</para>
  <para style="q1" vid="PRO 10:30">惡人無法安居地上。<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />義人的口，結出智慧的果實；</para>
  <para style="q1" vid="PRO 10:31">荒謬的舌，必被剪除。<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />義人的嘴，知道說合宜的話；</para>
  <para style="q1" vid="PRO 10:32">惡人的口，只會說荒謬的事。<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />欺詐的天平，為耶和華所憎惡；</para>
  <para style="q1" vid="PRO 11:1">誠實的砝碼，為他所悅納。<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />狂傲來，羞辱也會來；</para>
  <para style="q1" vid="PRO 11:2">而智慧與謙卑人同在。<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />正直人的純全，引導自己；</para>
  <para style="q1" vid="PRO 11:3">背信者的乖僻，毀滅自己。<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />在盛怒的日子裡財物沒有益處；</para>
  <para style="q1" vid="PRO 11:4">唯有公義解救人脫離死亡。<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />純全人的公義修直自己的道路；</para>
  <para style="q1" vid="PRO 11:5">惡人必因自己的邪惡而仆倒。<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />正直人的公義必解救自己；</para>
  <para style="q1" vid="PRO 11:6">背信者必被自己的貪慾纏住。<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />惡人一死，他的希望就消亡，</para>
  <para style="q1" vid="PRO 11:7">對他財力的期望<note caller="+" style="f"><char style="fr" closed="false">11:7 </char><char style="ft" closed="false">對他財力的期望——七十士譯本作「惡人的期望」。</char></note>也就消亡。<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />義人被搭救脫離患難；</para>
  <para style="q1" vid="PRO 11:8">惡人卻代替他進入其中。<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />偽善者用口毀掉鄰人，</para>
  <para style="q1" vid="PRO 11:9">義人卻因知識得救。<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />義人享福，全城歡慶；</para>
  <para style="q1" vid="PRO 11:10">惡人滅亡，必有歡呼。<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />因正直人的祝福，城就被高舉；</para>
  <para style="q1" vid="PRO 11:11">因惡人的口，城就被傾覆。<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />藐視自己鄰人的，缺乏心智；</para>
  <para style="q1" vid="PRO 11:12">聰慧的人卻保持沉默。<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />到處搬弄是非的，洩露祕密；</para>
  <para style="q1" vid="PRO 11:13">內心忠實的，遮隱事情。<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />沒有引導，民就落敗；</para>
  <para style="q1" vid="PRO 11:14">謀士眾多，就必得勝。<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />為別人<note caller="+" style="f"><char style="fr" closed="false">11:15 </char><char style="ft" closed="false">別人——或譯作「陌生人」。</char></note>作保的，必受損害；</para>
  <para style="q1" vid="PRO 11:15">恨惡擊掌起誓的，安然無慮。<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />恩德的女人得榮耀，</para>
  <para style="q1" vid="PRO 11:16">強橫的男人<note caller="+" style="f"><char style="fr" closed="false">11:16 </char><char style="ft" closed="false">強橫的男人——七十士譯本作「勤勞的男人」。</char></note>得財富。<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />仁慈的人，自己獲益；</para>
  <para style="q1" vid="PRO 11:17">殘忍的人，擾害自己。<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />惡人賺得虛妄的報償，</para>
  <para style="q1" vid="PRO 11:18">播種公義的，得真實的賞報。<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />真正行義的，必得生命；</para>
  <para style="q1" vid="PRO 11:19">追求惡事的，必致死亡。<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />心裡歪邪的，為耶和華所憎惡；</para>
  <para style="q1" vid="PRO 11:20">行為純全的，為他所悅納。<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />惡人必然<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">必然——原文直譯「手連手」。</char></note>難逃罪罰，</para>
  <para style="q1" vid="PRO 11:21">但義人的後裔必蒙拯救。<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />女人美麗卻無見識，</para>
  <para style="q1" vid="PRO 11:22">就像金環戴在豬鼻上。<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />義人的願望，必然美好；</para>
  <para style="q1" vid="PRO 11:23">惡人的期待，招致盛怒。<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />有人慷慨好施，反增添更多；</para>
  <para style="q1" vid="PRO 11:24">有人該給不給，卻導致缺乏。<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />慷慨<note caller="+" style="f"><char style="fr" closed="false">11:25 </char><char style="ft" closed="false">慷慨——輔助詞語。</char></note>祝福的，必得豐裕；</para>
  <para style="q1" vid="PRO 11:25">潤澤他人的，自己也得滋潤。<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />屯糧不賣的，民將咒罵他；</para>
  <para style="q1" vid="PRO 11:26">出售五穀的，祝福將臨到他頭上。<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />切切尋求美善的，必找到恩典；</para>
  <para style="q1" vid="PRO 11:27">而尋求惡事的，惡事必臨到他。<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />依靠自己財富的必將倒下；</para>
  <para style="q1" vid="PRO 11:28">而義人卻像綠葉那樣興盛。<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />擾害自家的，只繼承清風；</para>
  <para style="q1" vid="PRO 11:29">愚妄人是心有智慧者的奴僕。<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />義人的果實，是生命樹；</para>
  <para style="q1" vid="PRO 11:30">智慧的人，贏取靈魂<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="ft" closed="false">智慧的人，贏取靈魂——或譯作「強暴的人，奪取人的性命」。</char></note>。<verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />看哪，義人在這地上尚且受報，</para>
  <para style="q1" vid="PRO 11:31">更何況惡人和罪人呢！<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />喜愛管教的，就是喜愛知識；</para>
  <para style="q1" vid="PRO 12:1">恨惡責備的，卻是愚拙。<verse eid="PRO 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />好人將蒙耶和華的恩典；</para>
  <para style="q1" vid="PRO 12:2">設詭計的人，耶和華必定他的罪。<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />人靠邪惡不能堅立，</para>
  <para style="q1" vid="PRO 12:3">而義人的根必不動搖。<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />才德的妻子，是丈夫的冠冕；</para>
  <para style="q1" vid="PRO 12:4">帶來羞恥的妻子，如同丈夫骨中的朽爛。<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />義人的意念都是公正；</para>
  <para style="q1" vid="PRO 12:5">惡人的指引都是詭詐。<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />惡人的話語，埋伏著要殺人流血；</para>
  <para style="q1" vid="PRO 12:6">正直人的口，將解救自己。<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />惡人覆滅，不復存在；</para>
  <para style="q1" vid="PRO 12:7">義人的家，站立得住。<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />人因自己的明達，將受稱讚；</para>
  <para style="q1" vid="PRO 12:8">而心裡扭曲的人，將受藐視。<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />人受蔑視卻有自己的奴僕，</para>
  <para style="q1" vid="PRO 12:9">好過自尊自大卻缺乏糧食。<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />義人顧惜自己牲畜的性命，</para>
  <para style="q1" vid="PRO 12:10">惡人的憐憫也是殘忍。<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />耕耘自己土地的，飽享糧食；</para>
  <para style="q1" vid="PRO 12:11">追求空虛之事的，缺乏心智。<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />惡人貪愛壞人的贓物<note caller="+" style="f"><char style="fr" closed="false">12:12 </char><char style="ft" closed="false">贓物——或譯作「圈套」。</char></note>，</para>
  <para style="q1" vid="PRO 12:12">義人的根將結果實<note caller="+" style="f"><char style="fr" closed="false">12:12 </char><char style="ft" closed="false">果實——輔助詞語。</char></note>。<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />嘴唇的過犯是惡人的陷阱，</para>
  <para style="q1" vid="PRO 12:13">而義人必脫離患難。<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />人因口所結的果實，飽享福份；</para>
  <para style="q1" vid="PRO 12:14">人手所做的，必回報在自己身上。<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />愚妄人的道路，在自己眼中看為正直；</para>
  <para style="q1" vid="PRO 12:15">但智慧人聽從勸告。<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />愚妄人的惱怒，立刻顯明；</para>
  <para style="q1" vid="PRO 12:16">聰明人卻會遮掩羞辱。<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />說真話的，顯出公義；</para>
  <para style="q1" vid="PRO 12:17">作假見證的，顯出詭詐。<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />有人輕率說話，如刀刺人；</para>
  <para style="q1" vid="PRO 12:18">智慧人的話語<note caller="+" style="f"><char style="fr" closed="false">12:18 </char><char style="ft" closed="false">話語——原文直譯「舌頭」。</char></note>，使人痊癒。<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />誠實的嘴唇，永遠存留；</para>
  <para style="q1" vid="PRO 12:19">撒謊的舌頭，轉瞬即逝。<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />策劃惡事的，心存詭詐；</para>
  <para style="q1" vid="PRO 12:20">倡導和平的，將有喜樂。<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />義人不遭壞事；</para>
  <para style="q1" vid="PRO 12:21">惡人滿受禍患。<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />撒謊的嘴唇，為耶和華所憎惡；</para>
  <para style="q1" vid="PRO 12:22">行事誠信的，為他所悅納。<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />聰明的人，掩藏知識；</para>
  <para style="q1" vid="PRO 12:23">愚昧的心，彰顯愚妄。<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />殷勤人的手必掌權，</para>
  <para style="q1" vid="PRO 12:24">懈怠的人卻在苦役中。<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />心裡的苦悶，壓垮人心；</para>
  <para style="q1" vid="PRO 12:25">和善的言詞，使心歡喜。<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />義人引導自己的鄰人，</para>
  <para style="q1" vid="PRO 12:26">惡人的道路使人迷失。<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />懈怠的人連自己的獵物也不烤，</para>
  <para style="q1" vid="PRO 12:27">殷勤的人卻得寶貴的財物<note caller="+" style="f"><char style="fr" closed="false">12:27 </char><char style="ft" closed="false">殷勤的人卻得寶貴的財物——或譯作「人寶貴的財物是殷勤」。</char></note>。<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />公義的路途上有生命，</para>
  <para style="q1" vid="PRO 12:28">在它的道上沒有死亡。<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />有智慧的兒子聽從父親的管教，</para>
  <para style="q1" vid="PRO 13:1">譏諷者卻不聽從斥責的話語。<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />人因口所結的果實，享用福份；</para>
  <para style="q1" vid="PRO 13:2">背信者的欲望，卻是殘暴。<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />謹守口的，是守護自己的性命；</para>
  <para style="q1" vid="PRO 13:3">口無遮攔的，導致自己的敗亡。<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />懶惰人貪得無厭，但他的欲望一無所得；</para>
  <para style="q1" vid="PRO 13:4">殷勤人的欲求，卻必得滿足。<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />義人恨惡虛假的話語；</para>
  <para style="q1" vid="PRO 13:5">惡人行事卻遺臭蒙羞。<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />公義守護行事純全的人，</para>
  <para style="q1" vid="PRO 13:6">邪惡卻必傾覆罪人。<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />有人假作富有<note caller="+" style="f"><char style="fr" closed="false">13:7 </char><char style="ft" closed="false">假作富有——或譯作「使自己顯得富有」。</char></note>，卻一無所有；</para>
  <para style="q1" vid="PRO 13:7">有人假作貧窮<note caller="+" style="f"><char style="fr" closed="false">13:7 </char><char style="ft" closed="false">假作貧窮——或譯作「使自己顯得貧窮」。</char></note>，卻多有財物。<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />人的財富是他性命的贖價，</para>
  <para style="q1" vid="PRO 13:8">而窮人不會聽到威嚇的話。<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />義人的光，明亮歡喜；</para>
  <para style="q1" vid="PRO 13:9">惡人的燈，必要熄滅。<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />狂傲只會帶來紛爭；</para>
  <para style="q1" vid="PRO 13:10">聽從指教的就有智慧。<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />不勞而獲的財物必減少；</para>
  <para style="q1" vid="PRO 13:11">親手積累的人使財物增多。<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />期望被拖延，使人心憂患；</para>
  <para style="q1" vid="PRO 13:12">願望得實現，就是生命樹。<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />藐視訓言的，自招毀滅；</para>
  <para style="q1" vid="PRO 13:13">敬畏誡命的，必得回報。<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />智慧人的訓誨是生命的泉源，</para>
  <para style="q1" vid="PRO 13:14">使人遠離死亡的陷阱。<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />美好的見識，帶來恩惠；</para>
  <para style="q1" vid="PRO 13:15">背信者的路，總是艱難<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">艱難——或譯作「常久不變」。</char></note>。<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />聰明人都按知識行事，</para>
  <para style="q1" vid="PRO 13:16">愚昧人顯露他的愚妄。<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />邪惡的使者，陷入禍患；</para>
  <para style="q1" vid="PRO 13:17">忠實的信使，使人痊癒。<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />忽視管教的，必受窮受辱；</para>
  <para style="q1" vid="PRO 13:18">接受責備的，必得尊榮。<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />願望成就，心裡甘甜；</para>
  <para style="q1" vid="PRO 13:19">遠離惡事，被愚昧人憎惡。<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />與智慧人同行的，必得智慧；</para>
  <para style="q1" vid="PRO 13:20">與愚昧人結交的，必受虧損。<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />惡事追趕罪人，</para>
  <para style="q1" vid="PRO 13:21">義人必得善報。<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />好人使子子孫孫得繼業；</para>
  <para style="q1" vid="PRO 13:22">罪人的財富，卻為義人留存。<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />窮人所開墾之地，有許多糧食，</para>
  <para style="q1" vid="PRO 13:23">但因不公正的事，被一掃而空。<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />不用管教之<note caller="+" style="f"><char style="fr" closed="false">13:24 </char><char style="ft" closed="false">管教之——輔助詞語。</char></note>杖的，就是恨自己的兒子；</para>
  <para style="q1" vid="PRO 13:24">而愛自己兒子的，必勤加管教他。<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />義人吃飽，心滿意足；</para>
  <para style="q1" vid="PRO 13:25">惡人腹中，常常缺乏。<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />智慧的女人建立自己的家；</para>
  <para style="q1" vid="PRO 14:1">愚妄的女人親手拆毀它。<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />行事正直的，敬畏耶和華；</para>
  <para style="q1" vid="PRO 14:2">行為邪僻的，輕視耶和華。<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />愚妄人的口招來背上的刑杖<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">愚妄人的口招來背上的刑杖——或譯作「愚妄人的口中有驕傲的嫩枝」。</char></note>；</para>
  <para style="q1" vid="PRO 14:3">智慧人的嘴保守自己。<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />沒有耕牛，槽頭空空<note caller="+" style="f"><char style="fr" closed="false">14:4 </char><char style="ft" closed="false">空空——或譯作「乾淨」。</char></note>；</para>
  <para style="q1" vid="PRO 14:4">藉著牛力，收獲豐盛。<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />忠實的見證人，不會說謊；</para>
  <para style="q1" vid="PRO 14:5">作假見證的人，口吐謊言。<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />譏諷者尋求智慧卻得不到；</para>
  <para style="q1" vid="PRO 14:6">有悟性的人輕易得知識。<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />你當從愚昧人的面前離開；</para>
  <para style="q1" vid="PRO 14:7">你在那裡找不到充滿知識的嘴唇。<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />聰明人的智慧，使他領悟自己的道路；</para>
  <para style="q1" vid="PRO 14:8">愚昧人的愚妄，卻是自欺。<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />愚妄人輕忽罪責；</para>
  <para style="q1" vid="PRO 14:9">正直人中間有恩典。<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />內心的痛楚，自己心裡明白；</para>
  <para style="q1" vid="PRO 14:10">心中的喜樂，別人不能分享。<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />惡人的家，將被除滅；</para>
  <para style="q1" vid="PRO 14:11">正直人的帳篷，將會興盛。<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />有一條路，在人看為正直；</para>
  <para style="q1" vid="PRO 14:12">但它的盡頭，卻是死亡之路。<verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />縱然在歡笑中，人心也會悲痛；</para>
  <para style="q1" vid="PRO 14:13">喜樂的盡頭，也會是愁苦。<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />心中背道的必飽嘗他行為的後果；</para>
  <para style="q1" vid="PRO 14:14">好人也必飽嘗他行為的回報。<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />無知的人，任何話都信；</para>
  <para style="q1" vid="PRO 14:15">聰明的人，留意自己的腳步。<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />智慧人有所畏懼，遠離惡事；</para>
  <para style="q1" vid="PRO 14:16">愚昧人魯莽易怒，無所懼怕。<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />輕易發怒的，做事愚妄；</para>
  <para style="q1" vid="PRO 14:17">謀設詭計的，被人恨惡。<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />無知的人，將繼承愚妄；</para>
  <para style="q1" vid="PRO 14:18">聰明的人，以知識為冠冕。<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />壞人必屈服在好人面前；</para>
  <para style="q1" vid="PRO 14:19">惡人必屈服在義人門口。<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />窮人甚至被他的鄰人所恨惡；</para>
  <para style="q1" vid="PRO 14:20">富人卻有許多喜愛他的人。<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />藐視自己鄰人的，是有罪的；</para>
  <para style="q1" vid="PRO 14:21">恩待卑微人的，是蒙福的！<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />策劃壞事的，難道不會迷失嗎？</para>
  <para style="q1" vid="PRO 14:22">策劃好事的，必得<note caller="+" style="f"><char style="fr" closed="false">14:22 </char><char style="ft" closed="false">必得——輔助詞語。</char></note>慈愛和信實。<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />一切的勞苦都有益處；</para>
  <para style="q1" vid="PRO 14:23">嘴上的空談必致缺乏。<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />智慧人的冠冕，是自己的財富；</para>
  <para style="q1" vid="PRO 14:24">愚昧人的愚妄，終究是愚妄。<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />作誠實見證的，救人性命；</para>
  <para style="q1" vid="PRO 14:25">口吐謊言的，是詭詐的人。<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />因著敬畏耶和華，人有堅固的依賴；</para>
  <para style="q1" vid="PRO 14:26">他的兒女也有避難所。<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />敬畏耶和華是生命的泉源，</para>
  <para style="q1" vid="PRO 14:27">可以使人遠離死亡的陷阱。<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />君王的尊嚴，在於民多；</para>
  <para style="q1" vid="PRO 14:28">沒有民眾，國君就敗亡。<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />不輕易發怒的，大有聰慧；</para>
  <para style="q1" vid="PRO 14:29">性情急躁的，高舉愚妄。<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />平靜的心帶給肉體生命，</para>
  <para style="q1" vid="PRO 14:30">嫉妒卻使骨頭朽爛。<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />欺壓貧弱者的，就是辱罵造他的主；</para>
  <para style="q1" vid="PRO 14:31">恩待窮乏人的，就是榮耀主。<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />惡人因自己的惡行被推倒，</para>
  <para style="q1" vid="PRO 14:32">義人在臨死時有投靠。<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />智慧留在有悟性的人心裡，</para>
  <para style="q1" vid="PRO 14:33">甚至也顯明在愚昧人當中。<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />公義使國家興起，</para>
  <para style="q1" vid="PRO 14:34">罪惡是國民的恥辱。<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />明達的臣僕，得王的恩典；</para>
  <para style="q1" vid="PRO 14:35">帶來羞恥的僕人，遭王的盛怒。<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />溫和的回答，使怒火消退；</para>
  <para style="q1" vid="PRO 15:1">尖刻的話語，會激起怒氣。<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />智慧人的舌頭，使知識美妙；</para>
  <para style="q1" vid="PRO 15:2">愚昧人的口，吐出愚妄。<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />耶和華的眼目無處不在；</para>
  <para style="q1" vid="PRO 15:3">壞人好人，他都察看。<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />使人痊癒的舌頭，就是生命樹；</para>
  <para style="q1" vid="PRO 15:4">奸惡的舌頭，使心靈破碎。<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />愚妄人藐視父親的管教；</para>
  <para style="q1" vid="PRO 15:5">而接受責備的是精明人。<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />義人的家，有許多財富；</para>
  <para style="q1" vid="PRO 15:6">惡人的收獲，帶來擾害。<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />智慧人的嘴，散播知識；</para>
  <para style="q1" vid="PRO 15:7">愚昧人的心，卻不這樣。<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />惡人的祭物，為耶和華所憎惡；</para>
  <para style="q1" vid="PRO 15:8">正直人的禱告，為他所悅納。<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />惡人的道路，為耶和華所憎惡；</para>
  <para style="q1" vid="PRO 15:9">追求公義的，為他所喜愛。<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />離棄正直<note caller="+" style="f"><char style="fr" closed="false">15:10 </char><char style="ft" closed="false">正直——輔助詞語。</char></note>路途的，必受嚴厲管教；</para>
  <para style="q1" vid="PRO 15:10">恨惡責備的，必致死亡。<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />陰間和地獄尚且展露<note caller="+" style="f"><char style="fr" closed="false">15:11 </char><char style="ft" closed="false">展露——輔助詞語。</char></note>在耶和華面前，</para>
  <para style="q1" vid="PRO 15:11">更何況世人的心呢！<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />譏諷者不喜愛責備他的人，</para>
  <para style="q1" vid="PRO 15:12">他不會到智慧人那裡去。<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />心中歡喜，面有喜色；</para>
  <para style="q1" vid="PRO 15:13">心中愁苦，靈裡憂傷。<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />有悟性的心，尋求知識；</para>
  <para style="q1" vid="PRO 15:14">愚昧人的口，以愚妄為食。<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />困苦人一生的日子，盡是不幸；</para>
  <para style="q1" vid="PRO 15:15">但心中的快樂，是持續的宴席。<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />財物<note caller="+" style="f"><char style="fr" closed="false">15:16 </char><char style="ft" closed="false">財物——輔助詞語。</char></note>雖少卻敬畏耶和華，</para>
  <para style="q1" vid="PRO 15:16">好過寶物眾多卻煩亂不安。<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />吃素食卻彼此相愛，</para>
  <para style="q1" vid="PRO 15:17">好過吃肥牛卻彼此相恨。<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />易怒的人，挑動紛爭；</para>
  <para style="q1" vid="PRO 15:18">不輕易發怒的，使爭辯平息。<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />懶惰人的道路，如同荊棘的籬笆；</para>
  <para style="q1" vid="PRO 15:19">正直人的路途，是平坦的大道。<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />有智慧的兒子使父親歡喜，</para>
  <para style="q1" vid="PRO 15:20">而愚昧人輕視自己的母親。<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />缺乏心智的人，以愚妄為樂；</para>
  <para style="q1" vid="PRO 15:21">聰慧的人，按正直而行。<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />不經商議，計策必敗；</para>
  <para style="q1" vid="PRO 15:22">謀士眾多，計策成就。<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />口善應對，人有喜樂；</para>
  <para style="q1" vid="PRO 15:23">話合其時，多麼美好！<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />生命的路途使明達人向上，</para>
  <para style="q1" vid="PRO 15:24">使他遠離下面的陰間。<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />耶和華拔除傲慢者的家，</para>
  <para style="q1" vid="PRO 15:25">卻要設立寡婦的地界。<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />惡人的意念，為耶和華所憎惡；</para>
  <para style="q1" vid="PRO 15:26">恩慈的言語，卻是純淨的。<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />貪圖私利的，擾害自己的家；</para>
  <para style="q1" vid="PRO 15:27">恨惡賄賂<note caller="+" style="f"><char style="fr" closed="false">15:27 </char><char style="ft" closed="false">賄賂——原文直譯「禮物」。</char></note>的，得以存活。<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />義人的心，思索怎樣回應；</para>
  <para style="q1" vid="PRO 15:28">惡人的口，吐出惡言。<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />耶和華遠離惡人，</para>
  <para style="q1" vid="PRO 15:29">卻垂聽義人的禱告。<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />眼中的光彩，使心裡歡喜；</para>
  <para style="q1" vid="PRO 15:30">美好的消息，讓骨頭滋潤。<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />耳朵聽從關乎生命的訓責，</para>
  <para style="q1" vid="PRO 15:31">這樣的人必安居在智慧人當中。<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />忽視管教的，厭棄自己的靈魂；</para>
  <para style="q1" vid="PRO 15:32">聽從責備的，獲得智慧的心。<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />敬畏耶和華是智慧所訓導的；</para>
  <para style="q1" vid="PRO 15:33">榮耀之前，先有謙卑。<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />心裡的想法在於人，</para>
  <para style="q1" vid="PRO 16:1">口中<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="ft" closed="false">口中——原文直譯「舌頭」。</char></note>的回答來自耶和華。<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />人一切的道路，在自己眼中看為純潔；</para>
  <para style="q1" vid="PRO 16:2">而耶和華衡量人的心。<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />當把你所做的交託給耶和華，</para>
  <para style="q1" vid="PRO 16:3">你的計劃就必堅立。<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />耶和華造一切都有其目的；</para>
  <para style="q1" vid="PRO 16:4">連惡人也為禍患的日子所造。<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />所有心裡高慢的，都為耶和華所憎惡；</para>
  <para style="q1" vid="PRO 16:5">他們必然<note caller="+" style="f"><char style="fr" closed="false">16:5 </char><char style="ft" closed="false">必然——原文直譯「手連手」。</char></note>難逃罪罰。<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />藉著慈愛和信實，罪孽被贖清；</para>
  <para style="q1" vid="PRO 16:6">因敬畏耶和華，人就遠離惡事。<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />人的道路蒙耶和華喜悅時，</para>
  <para style="q1" vid="PRO 16:7">耶和華也使他的仇敵與他和好。<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />收入<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">收入——輔助詞語。</char></note>少，卻有公義，</para>
  <para style="q1" vid="PRO 16:8">好過收入多，卻沒有公正。<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />人心中籌劃自己的道路，</para>
  <para style="q1" vid="PRO 16:9">唯有耶和華堅定他的腳步。<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />神的指示在王的嘴上，</para>
  <para style="q1" vid="PRO 16:10">他的口在裁決時不可不忠。<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />公正的秤和天平，都在於耶和華；</para>
  <para style="q1" vid="PRO 16:11">袋子裡一切的砝碼，都是他制定的。<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />行事邪惡，為君王所憎惡<note caller="+" style="f"><char style="fr" closed="false">16:12 </char><char style="ft" closed="false">行事邪惡，為君王所憎惡——或譯作「君王行事邪惡，是可憎惡的事」。</char></note>，</para>
  <para style="q1" vid="PRO 16:12">因為王位藉著公義而堅立。<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />公義的嘴唇，為君王所悅納；</para>
  <para style="q1" vid="PRO 16:13">他喜愛說話正直的人。<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />王的怒火是死亡的使者，</para>
  <para style="q1" vid="PRO 16:14">而智慧人能平息怒氣。<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />君王的容光，帶來生命；</para>
  <para style="q1" vid="PRO 16:15">他的恩典，如帶來春雨的雲。<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />獲得智慧多麼好，勝過得金子；</para>
  <para style="q1" vid="PRO 16:16">獲得悟性，勝過得精選的銀子。<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />正直人的道，遠離惡事；</para>
  <para style="q1" vid="PRO 16:17">謹守自己路的，守護自己的性命。<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />破敗以先，必有驕傲；</para>
  <para style="q1" vid="PRO 16:18">絆跌之前，靈裡高慢。<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />靈裡降卑、與卑微的人在一起，</para>
  <para style="q1" vid="PRO 16:19">好過與傲慢者同分戰利品。<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />明察事理的，必找到福份；</para>
  <para style="q1" vid="PRO 16:20">依靠耶和華的，就必蒙福！<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />心裡有智慧的，被稱為有悟性的人；</para>
  <para style="q1" vid="PRO 16:21">嘴唇的甘甜，使人增添學問。<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />見識是有見識者的生命泉源，</para>
  <para style="q1" vid="PRO 16:22">愚妄是對愚妄人的懲罰。<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />智慧人的心使他的口通達，</para>
  <para style="q1" vid="PRO 16:23">也使他的嘴唇增添學問。<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />恩慈的言語如蜂房滴蜜，</para>
  <para style="q1" vid="PRO 16:24">使人心裡甘甜，骨頭痊癒。<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />有一條路，在人看為正直；</para>
  <para style="q1" vid="PRO 16:25">但它的盡頭，卻是死亡之路。<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />勞力人的胃口促使他勞力，</para>
  <para style="q1" vid="PRO 16:26">因為他口腹之需催逼著他。<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />卑劣之徒挖掘惡事，</para>
  <para style="q1" vid="PRO 16:27">他的言語<note caller="+" style="f"><char style="fr" closed="false">16:27 </char><char style="ft" closed="false">言語——原文直譯「嘴唇」。</char></note>像灼熱的火。<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />荒謬的人散布紛爭，</para>
  <para style="q1" vid="PRO 16:28">傳謠者使同伴分離。<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />殘暴者引誘他的鄰人，</para>
  <para style="q1" vid="PRO 16:29">使他走上不好的道路。<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />眯縫眼睛的，謀算荒謬；</para>
  <para style="q1" vid="PRO 16:30">緊抿嘴唇的，做成惡事。<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />白髮是榮耀的冠冕，</para>
  <para style="q1" vid="PRO 16:31">在公義的道路上必能得著。<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />不輕易發怒的，好過勇士；</para>
  <para style="q1" vid="PRO 16:32">制伏自己情緒的，勝過攻取城池的人。<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />所抽的籤拋在懷<note caller="+" style="f"><char style="fr" closed="false">16:33 </char><char style="ft" closed="false">懷——或譯作「膝」。</char></note>中，</para>
  <para style="q1" vid="PRO 16:33">一切決斷卻來自耶和華。<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />有一口乾餅卻相安無事，</para>
  <para style="q1" vid="PRO 17:1">好過滿屋筵席卻爭辯不休。<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />明達的奴僕必管轄主人蒙羞的兒子，</para>
  <para style="q1" vid="PRO 17:2">並將在兄弟中間分得繼業。<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />熔鍋用以煉銀，熔爐用以煉金；</para>
  <para style="q1" vid="PRO 17:3">而耶和華試煉人心。<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />作惡的人，聆聽惡毒的嘴唇；</para>
  <para style="q1" vid="PRO 17:4">撒謊的人，傾聽奸惡的舌頭。<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />嘲笑窮人的，就是辱罵造他的主；</para>
  <para style="q1" vid="PRO 17:5">幸災樂禍的，難逃罪罰。<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />子孫是老年人的冠冕，</para>
  <para style="q1" vid="PRO 17:6">父親是兒女的榮耀。<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />愚頑人有誇讚<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="ft" closed="false">誇讚——或譯作「高雅」；原文直譯「多餘、豐富、卓越」。</char></note>的嘴唇尚且不相宜，</para>
  <para style="q1" vid="PRO 17:7">更何況高貴人有虛謊的嘴唇呢！<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />賄賂<note caller="+" style="f"><char style="fr" closed="false">17:8 </char><char style="ft" closed="false">賄賂——或譯作「禮物」。</char></note>在行賄者眼中是誘人的寶石，</para>
  <para style="q1" vid="PRO 17:8">無論他轉往哪裡去，都能通達。<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />遮蓋人過犯的，是在尋求愛；</para>
  <para style="q1" vid="PRO 17:9">重提舊帳的，使同伴分離。<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />一句責備的話深入有悟性人的心，</para>
  <para style="q1" vid="PRO 17:10">勝過責打愚昧人一百下。<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />惡人只尋求悖逆，</para>
  <para style="q1" vid="PRO 17:11">必有殘忍的使者被派去對付他。<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />寧可遇見失去幼仔的母熊，</para>
  <para style="q1" vid="PRO 17:12">也不要遇見行在愚妄中的愚昧人。<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />那以惡報善的人，</para>
  <para style="q1" vid="PRO 17:13">惡事不會離開他的家。<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />紛爭的開始，就如放開的水；</para>
  <para style="q1" vid="PRO 17:14">捲入爭執之前，當放棄爭辯。<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />定惡人為義的、判義人有罪的，</para>
  <para style="q1" vid="PRO 17:15">兩者都是耶和華所憎惡的。<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />愚昧人既然沒有心智，</para>
  <para style="q1" vid="PRO 17:16">為什麼手中還拿著銀錢要買智慧呢？<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />朋友會時時關愛，</para>
  <para style="q1" vid="PRO 17:17">兄弟為患難而生。<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />缺乏心智的人擊掌起誓，</para>
  <para style="q1" vid="PRO 17:18">在他的鄰人面前作保。<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />喜愛紛爭的，是喜愛過犯；</para>
  <para style="q1" vid="PRO 17:19">高立門戶的，是自尋破敗。<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />心裡歪邪的，找不到福份；</para>
  <para style="q1" vid="PRO 17:20">話語善變的，陷在惡事中。<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />生愚昧兒子的，招來愁苦；</para>
  <para style="q1" vid="PRO 17:21">愚頑人的父親，毫無喜樂。<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />心中歡喜，就是良藥；</para>
  <para style="q1" vid="PRO 17:22">靈裡憂傷，使骨頭枯乾。<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />惡人私下<note caller="+" style="f"><char style="fr" closed="false">17:23 </char><char style="ft" closed="false">私下——原文直譯「從懷中」。</char></note>收取賄賂，</para>
  <para style="q1" vid="PRO 17:23">為要扭曲公正的路途。<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />智慧就在有悟性的人面前；</para>
  <para style="q1" vid="PRO 17:24">愚昧人的眼卻望著地極。<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />愚昧的兒子，使父親煩惱，</para>
  <para style="q1" vid="PRO 17:25">並且使生他的母親痛苦。<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />懲罰義人，實在不好；</para>
  <para style="q1" vid="PRO 17:26">責打正直的高貴人，也是不對。<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />約束自己言語的，明白知識；</para>
  <para style="q1" vid="PRO 17:27">靈裡冷靜的，是聰慧的人。<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />愚妄人沉默，也算為智慧；</para>
  <para style="q1" vid="PRO 17:28">他閉口不言，也算有悟性。<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />孤僻離群的，只求自己的願望；</para>
  <para style="q1" vid="PRO 18:1">他抗拒一切真知。<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />愚昧人不喜歡聰慧，</para>
  <para style="q1" vid="PRO 18:2">只喜歡顯露自己的心思。<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />惡人來，藐視也來；</para>
  <para style="q1" vid="PRO 18:3">羞辱來，辱罵同來。<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />人口中的話語如深水，</para>
  <para style="q1" vid="PRO 18:4">智慧的泉源如湧出的溪流。<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />顧及惡人的情面，實為不好；</para>
  <para style="q1" vid="PRO 18:5">不向義人施行公正，也為不善。<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />愚昧人的嘴捲入爭辯，</para>
  <para style="q1" vid="PRO 18:6">他的口召來責打。<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />愚昧人的口導致自己的敗亡，</para>
  <para style="q1" vid="PRO 18:7">他的嘴成為自己靈魂的陷阱。<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />傳謠者的話語，如同可口的食物，</para>
  <para style="q1" vid="PRO 18:8">下到人的臟腑。<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />在自己工作上也懶惰的，</para>
  <para style="q1" vid="PRO 18:9">是毀滅者的兄弟。<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />耶和華的名是堅固的塔樓，</para>
  <para style="q1" vid="PRO 18:10">義人跑進去就安穩在高處。<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />富人的財物，是他堅固的城，</para>
  <para style="q1" vid="PRO 18:11">在他幻想中，如高高的城牆。<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />破敗之前，人心自高；</para>
  <para style="q1" vid="PRO 18:12">榮耀之前，先有謙卑。<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />一個人未聽完就回話，</para>
  <para style="q1" vid="PRO 18:13">就是他的愚妄和羞愧。<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />人有疾病，心靈能忍受；</para>
  <para style="q1" vid="PRO 18:14">心靈憂傷，誰能承受呢？<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />有悟性的心，獲得知識；</para>
  <para style="q1" vid="PRO 18:15">智慧人的耳，尋求知識。<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />人的禮物為他開路，</para>
  <para style="q1" vid="PRO 18:16">引導他到大人物面前。<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />爭訟中先陳說<note caller="+" style="f"><char style="fr" closed="false">18:17 </char><char style="ft" closed="false">陳說——輔助詞語。</char></note>的雖顯得公義；</para>
  <para style="q1" vid="PRO 18:17">但對方一來，就能查驗他的話。<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />抽籤使爭執停息，</para>
  <para style="q1" vid="PRO 18:18">也能在強者之間調停<note caller="+" style="f"><char style="fr" closed="false">18:18 </char><char style="ft" closed="false">調停——或譯作「判斷定奪」。</char></note>。<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />被冒犯的兄弟比堅固的城更難對付<note caller="+" style="f"><char style="fr" closed="false">18:19 </char><char style="ft" closed="false">難對付——輔助詞語。</char></note>；</para>
  <para style="q1" vid="PRO 18:19">而爭執就如城堡的門閂。<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />人的肚腹必因口所結的果實而飽足，</para>
  <para style="q1" vid="PRO 18:20">因嘴唇的收獲而滿足。<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />生與死都在舌頭的權下；</para>
  <para style="q1" vid="PRO 18:21">喜愛它的必食其果。<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />找到妻子的，是找到了福份，</para>
  <para style="q1" vid="PRO 18:22">他從耶和華蒙了恩典。<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />窮人苦苦哀求，</para>
  <para style="q1" vid="PRO 18:23">富人凶狠回應。<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />朋友太多的人，會受損害<note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="ft" closed="false">朋友太多的人，會受損害——或譯作「人的一些朋友，會導致損害」。</char></note>；</para>
  <para style="q1" vid="PRO 18:24">但有一知己，比兄弟更親密。<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />行事純全的貧窮人，</para>
  <para style="q1" vid="PRO 19:1">好過言語悖謬的愚昧人。<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />有熱心而無知識<note caller="+" style="f"><char style="fr" closed="false">19:2 </char><char style="ft" closed="false">有熱心而無知識——或譯作「心無知識」。</char></note>，實在不好；</para>
  <para style="q1" vid="PRO 19:2">腳步急躁的人，難免失足。<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />人的愚妄傾覆自己的道路，</para>
  <para style="q1" vid="PRO 19:3">他的心卻對耶和華惱怒。<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />財物能使朋友增多，</para>
  <para style="q1" vid="PRO 19:4">貧弱者卻遭夥伴遠離。<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />作假見證的，難逃罪罰；</para>
  <para style="q1" vid="PRO 19:5">口吐謊言的，不能逃脫。<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />許多人懇求權貴的情面，</para>
  <para style="q1" vid="PRO 19:6">每個人都是送禮之人的朋友。<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />窮人的兄弟都嫌棄他，</para>
  <para style="q1" vid="PRO 19:7">他的夥伴更是遠離他！</para>
  <para style="q1" vid="PRO 19:7">他說討好的話，他們卻不理會<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">理會——輔助詞語。</char></note>。<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />得智慧心的，愛惜自己的靈魂，</para>
  <para style="q1" vid="PRO 19:8">持守聰慧的，找得到福份。<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />作假見證的，難逃罪罰；</para>
  <para style="q1" vid="PRO 19:9">口吐謊言的，必要滅亡。<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />愚昧人享樂尚且不合宜，</para>
  <para style="q1" vid="PRO 19:10">更何況奴僕管轄首領呢！<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />人有見識就不輕易發怒；</para>
  <para style="q1" vid="PRO 19:11">寬恕過犯，是自己的榮耀。<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />王的憤怒，如同少壯獅子的咆哮；</para>
  <para style="q1" vid="PRO 19:12">而他的恩典，如同草上的甘露。<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />愚昧的兒子，是父親的禍患；</para>
  <para style="q1" vid="PRO 19:13">妻子的爭吵，像霪雨<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="ft" closed="false">霪雨——輔助詞語。</char></note>連連滴漏。<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />房屋和財物來自祖先的繼業，</para>
  <para style="q1" vid="PRO 19:14">而明達的妻子來自耶和華。<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />懶惰使人陷入沉睡，</para>
  <para style="q1" vid="PRO 19:15">懈怠的人必會挨餓。<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />遵守誡命的，保守自己的靈魂；</para>
  <para style="q1" vid="PRO 19:16">輕忽自己道路的，必將死亡。<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />人恩待貧弱者，就是借予耶和華；</para>
  <para style="q1" vid="PRO 19:17">耶和華將照著他所行的償還給他。<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />當在你的兒子還有指望時管教他<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">當在你的兒子還有指望時管教他——或譯作「當管教你的兒子，因為還有指望」。</char></note>；</para>
  <para style="q1" vid="PRO 19:18">不可存心害死他。<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />暴怒的人將承受責罰；</para>
  <para style="q1" vid="PRO 19:19">如果你要解救他，就得一救再救。<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />你當聽從勸告，接受管教，</para>
  <para style="q1" vid="PRO 19:20">好讓自己以後有智慧。<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />人心的意念很多，</para>
  <para style="q1" vid="PRO 19:21">唯有耶和華的籌算才能成立。<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />忠誠<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="ft" closed="false">忠誠——或譯作「慈愛」。</char></note>是人所渴慕的；</para>
  <para style="q1" vid="PRO 19:22">窮人好過說謊的人。<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />敬畏耶和華，就得到生命；</para>
  <para style="q1" vid="PRO 19:23">這樣的人睡得飽足<note caller="+" style="f"><char style="fr" closed="false">19:23 </char><char style="ft" closed="false">睡得飽足——或譯作「安居飽足」。</char></note>，不遭禍患。<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />懶惰的人手放在盤子裡，</para>
  <para style="q1" vid="PRO 19:24">甚至懶得拿起手把食物放進口中。<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />責打譏諷者，能使無知的人變精明；</para>
  <para style="q1" vid="PRO 19:25">責備有悟性的人，他就能領悟知識。<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />虐待父親、趕走母親的，</para>
  <para style="q1" vid="PRO 19:26">是蒙羞致辱的兒子。<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />我兒啊，你如果停止聽從管教，</para>
  <para style="q1" vid="PRO 19:27">就會偏離知識的言語！<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />卑劣的見證人，譏諷公正；</para>
  <para style="q1" vid="PRO 19:28">惡人的口，吞盡邪惡。<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />為譏諷者所預備的是審判，</para>
  <para style="q1" vid="PRO 19:29">為愚昧人的背所預備的是責打。<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />酒使人成為<note caller="+" style="f"><char style="fr" closed="false">20:1 </char><char style="ft" closed="false">使人成為——輔助詞語。</char></note>譏諷者，烈酒使人成為<note caller="+" style="f"><char style="fr" closed="false">20:1 </char><char style="ft" closed="false">使人成為——輔助詞語。</char></note>喧鬧者；</para>
  <para style="q1" vid="PRO 20:1">所有因酒而迷失的人，都沒有智慧。<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />王的威嚇，如同少壯獅子的咆哮；</para>
  <para style="q1" vid="PRO 20:2">惹怒他的，是自害己命。<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />止息紛爭是人的榮耀；</para>
  <para style="q1" vid="PRO 20:3">而愚妄人都捲入爭執。<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />懶惰的人不按季<note caller="+" style="f"><char style="fr" closed="false">20:4 </char><char style="ft" closed="false">按季——指秋後該播種的時候。</char></note>耕作，</para>
  <para style="q1" vid="PRO 20:4">卻在收割時乞求收穫<note caller="+" style="f"><char style="fr" closed="false">20:4 </char><char style="ft" closed="false">乞求收穫——或譯作「乞討」。</char></note>，他必一無所得。<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />人心裡的謀略如同深水，</para>
  <para style="q1" vid="PRO 20:5">但聰慧人能把它取出來。<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />許多人自稱是忠誠的，</para>
  <para style="q1" vid="PRO 20:6">但真正忠實的人，誰能找到呢？<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />行事純全的義人，</para>
  <para style="q1" vid="PRO 20:7">他的後代子孫是蒙福的！<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />王坐在審判的寶座上，</para>
  <para style="q1" vid="PRO 20:8">以自己的眼目分辨出一切惡事。<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />誰能說：「我保持自己的心純潔，</para>
  <para style="q1" vid="PRO 20:9">我是清潔無罪的」？<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />雙重標準的砝碼、雙重標準的量斗<note caller="+" style="f"><char style="fr" closed="false">20:10 </char><char style="ft" closed="false">雙重標準的量斗——原文直譯「兩種伊法」。</char></note>，</para>
  <para style="q1" vid="PRO 20:10">兩者都是耶和華所憎惡的。<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />就算是小孩子<note caller="+" style="f"><char style="fr" closed="false">20:11 </char><char style="ft" closed="false">小孩子——或譯作「少年人」。</char></note>，也能藉著他的行為，</para>
  <para style="q1" vid="PRO 20:11">辨認出他的作為是否純潔正直。<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />能聽的耳朵、能看的眼睛，</para>
  <para style="q1" vid="PRO 20:12">兩者都是耶和華所造的。<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />不要貪睡，免得你陷入窮困；</para>
  <para style="q1" vid="PRO 20:13">要睜開眼睛，你就得以飽食！<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />人買東西時說：「不好！不好！」</para>
  <para style="q1" vid="PRO 20:14">但走了之後，他就自誇。<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />世上有金子和許多紅寶石，</para>
  <para style="q1" vid="PRO 20:15">但充滿知識的嘴唇才是貴重的寶物。<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />誰為別人<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">別人——或譯作「陌生人」。</char></note>作保，就拿去誰的衣服；</para>
  <para style="q1" vid="PRO 20:16">誰替淫蕩女子<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">淫蕩女子——或譯作「外邦人」。</char></note>作保，就把誰當作抵押。<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />詭詐得來的食物，人覺得甜美；</para>
  <para style="q1" vid="PRO 20:17">但後來他的口必充滿沙石。<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />計策靠參謀確立，</para>
  <para style="q1" vid="PRO 20:18">作戰靠的是指引。<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />到處搬弄是非的，洩露祕密；</para>
  <para style="q1" vid="PRO 20:19">口無遮攔的人，你不可與他結交。<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />詛咒父母的，</para>
  <para style="q1" vid="PRO 20:20">他的燈將在極深的黑暗中熄滅。<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />起先速得的繼業，</para>
  <para style="q1" vid="PRO 20:21">最終卻不是祝福。<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />你不可說：「我要以惡報惡」；</para>
  <para style="q1" vid="PRO 20:22">你當等候耶和華，他必拯救你。<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />雙重標準的砝碼，是耶和華所憎惡的；</para>
  <para style="q1" vid="PRO 20:23">欺詐的天平，也為不善。<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />人的腳步由耶和華而定；</para>
  <para style="q1" vid="PRO 20:24">世人怎能明白自己的道路呢？<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />輕率地說「這是獻為聖的」，</para>
  <para style="q1" vid="PRO 20:25">許願之後才細想，這樣做是自設陷阱。<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />智慧的王篩出惡人，</para>
  <para style="q1" vid="PRO 20:26">又用石磙碾軋他們。<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />人的靈是耶和華的燈，</para>
  <para style="q1" vid="PRO 20:27">探尋人內心深處的一切。<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />慈愛和信實守護君王，</para>
  <para style="q1" vid="PRO 20:28">他的寶座也靠慈愛扶持。<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />力量是年輕人的榮耀；</para>
  <para style="q1" vid="PRO 20:29">白髮是老年人的威嚴。<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />鞭傷能潔淨人的邪惡；</para>
  <para style="q1" vid="PRO 20:30">責打能潔淨人的內心深處。<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />王的心在耶和華的手中，就像河渠的水：</para>
  <para style="q1" vid="PRO 21:1">耶和華可以任意使它流轉。<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />人一切的道路，在自己眼中看為正直；</para>
  <para style="q1" vid="PRO 21:2">而耶和華衡量人的心。<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />實行公義和公正，</para>
  <para style="q1" vid="PRO 21:3">比獻祭更蒙耶和華悅納。<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />高傲的眼、驕橫的心，</para>
  <para style="q1" vid="PRO 21:4">都是惡人的燈，都是罪。<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />殷勤籌劃的，必致豐富；</para>
  <para style="q1" vid="PRO 21:5">行事急躁的，都必缺乏。<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />撒謊的舌得來的財寶如吹散的霧，</para>
  <para style="q1" vid="PRO 21:6">這樣求財的人<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="ft" closed="false">這樣求財的人——輔助詞語。</char></note>是在尋求死亡。<verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />惡人的暴行必拖垮自己，</para>
  <para style="q1" vid="PRO 21:7">因為他們拒絕實行公正。<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />有罪的人，道路彎曲；</para>
  <para style="q1" vid="PRO 21:8">純潔的人，行為正直。<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />寧可住在屋頂的一角，</para>
  <para style="q1" vid="PRO 21:9">也好過與爭吵的女人同住一屋。<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />惡人的靈魂渴望邪惡，</para>
  <para style="q1" vid="PRO 21:10">他的眼目不憐憫鄰人。<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />譏諷者受懲罰時，無知人就得智慧；</para>
  <para style="q1" vid="PRO 21:11">智慧人受訓誨時，自己就得到知識。<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />公義的那一位明察惡人的家，</para>
  <para style="q1" vid="PRO 21:12">他使惡人傾覆滅亡。<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />塞耳不聽貧弱者哀聲的，</para>
  <para style="q1" vid="PRO 21:13">他自己呼求時也得不到回應。<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />暗中的禮物，平息怒氣；</para>
  <para style="q1" vid="PRO 21:14">私下<note caller="+" style="f"><char style="fr" closed="false">21:14 </char><char style="ft" closed="false">私下——原文直譯「在懷中」。</char></note>的賄賂，平息暴怒。<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />實行公正，對義人是喜樂，</para>
  <para style="q1" vid="PRO 21:15">對作惡者卻是敗亡。<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />從明達之路迷失的人，</para>
  <para style="q1" vid="PRO 21:16">將留在陰魂的會眾裡。<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />喜愛享樂的，必致缺乏；</para>
  <para style="q1" vid="PRO 21:17">喜愛酒和油的，不會富有。<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />惡人成為義人的贖價，</para>
  <para style="q1" vid="PRO 21:18">背信者成為正直人的贖價。<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />寧可住在曠野之地，</para>
  <para style="q1" vid="PRO 21:19">也好過與爭吵易怒的妻子<note caller="+" style="f"><char style="fr" closed="false">21:19 </char><char style="ft" closed="false">妻子——或譯作「女人」。</char></note>同住。<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />智慧人的居所裡積存珍貴的寶物和膏油；</para>
  <para style="q1" vid="PRO 21:20">愚昧人卻吞盡自己所得的一切。<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />追求公義和慈愛的，</para>
  <para style="q1" vid="PRO 21:21">必找到生命、公義和榮耀。<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />智慧人攻上勇士的城，</para>
  <para style="q1" vid="PRO 21:22">也拿下那城所依賴的堡壘。<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />保守自己的口與舌的，</para>
  <para style="q1" vid="PRO 21:23">就保守自己的靈魂免受患難。<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />傲慢、狂妄的人，他的名是譏諷者，</para>
  <para style="q1" vid="PRO 21:24">他行事極端地狂傲。<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />懶惰人的欲望害死自己，</para>
  <para style="q1" vid="PRO 21:25">因為他的雙手不肯做工。<verse eid="PRO 21:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />有人終日貪得無厭；</para>
  <para style="q1" vid="PRO 21:26">義人給予而不保留。<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />惡人的祭物尚且可憎，</para>
  <para style="q1" vid="PRO 21:27">更何況他獻祭時居心不良呢！<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />作假見證的，必要滅亡；</para>
  <para style="q1" vid="PRO 21:28">但善於聽的，其言長存<note caller="+" style="f"><char style="fr" closed="false">21:28 </char><char style="ft" closed="false">其言長存——或譯作「他的證詞有力」。</char></note>。<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />邪惡的人，虛張聲勢；</para>
  <para style="q1" vid="PRO 21:29">正直的人，謹慎行事<note caller="+" style="f"><char style="fr" closed="false">21:29 </char><char style="ft" closed="false">謹慎行事——或譯作「確立自己的道路」。</char></note>。<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />任何智慧、聰慧和謀略，</para>
  <para style="q1" vid="PRO 21:30">都在耶和華面前站立不住。<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />馬為爭戰的日子所預備，</para>
  <para style="q1" vid="PRO 21:31">得勝卻在於耶和華。<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />名聲比巨富更可取，</para>
  <para style="q1" vid="PRO 22:1">恩寵比金銀更美好。<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />富人和窮人有一相同之處<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="ft" closed="false">有一相同之處——原文直譯「彼此相遇」。</char></note>：</para>
  <para style="q1" vid="PRO 22:2">他們都是耶和華所造的。<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />聰明人看見惡事就會躲藏；</para>
  <para style="q1" vid="PRO 22:3">無知的人卻前去自招懲罰。<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />心存謙卑、敬畏耶和華，</para>
  <para style="q1" vid="PRO 22:4">就有財富、榮耀和生命為賞賜。<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />悖謬人的道路上有荊棘和網羅；</para>
  <para style="q1" vid="PRO 22:5">保守自己靈魂的必遠離這些。<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />訓練孩童走當行的路，</para>
  <para style="q1" vid="PRO 22:6">就是到老，他也不偏離。<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />富人管轄窮人；</para>
  <para style="q1" vid="PRO 22:7">借債人是債主的奴僕。<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />播種不義的，收獲惡果<note caller="+" style="f"><char style="fr" closed="false">22:8 </char><char style="ft" closed="false">惡果——或譯作「災禍」。</char></note>；</para>
  <para style="q1" vid="PRO 22:8">他盛怒的杖，終將滅絕。<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />心眼良善的必蒙祝福，</para>
  <para style="q1" vid="PRO 22:9">因為他把自己的糧食分給貧弱者。<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />趕出譏諷者，紛爭就離去，</para>
  <para style="q1" vid="PRO 22:10">爭訟和羞辱也都會止息。<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />喜愛內心純淨的，他的嘴上有恩言，</para>
  <para style="q1" vid="PRO 22:11">有君王與他做朋友。<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />耶和華的眼目守護知識，</para>
  <para style="q1" vid="PRO 22:12">他卻推翻背信者的話。<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />懶惰人說：「外面有獅子，</para>
  <para style="q1" vid="PRO 22:13">我會在街市中喪命。」<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />淫婦的口，是深深的坑；</para>
  <para style="q1" vid="PRO 22:14">耶和華所惱怒的人，陷入其中。<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />愚妄纏在孩子的心裡，</para>
  <para style="q1" vid="PRO 22:15">管教的杖使愚妄遠離。<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />欺壓貧弱者使自己富有的，</para>
  <para style="q1" vid="PRO 22:16">送禮給富人的，都必缺乏。<verse eid="PRO 22:16" /></para>
  <para style="b" />
  <para style="s">智慧人的話語</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />你當側耳聽從智慧人的話語，</para>
  <para style="q1" vid="PRO 22:17">你的心要專注於我的知識；<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />如果你心中謹守它們，</para>
  <para style="q1" vid="PRO 22:18">又隨時預備在嘴唇上，</para>
  <para style="q1" vid="PRO 22:18">那實在美妙！<verse eid="PRO 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />我今日特別指教你，</para>
  <para style="q1" vid="PRO 22:19">好讓你依賴耶和華。<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />那三十條有關計謀和知識的箴言<note caller="+" style="f"><char style="fr" closed="false">22:20 </char><char style="ft" closed="false">箴言——輔助詞語。</char></note>，</para>
  <para style="q1" vid="PRO 22:20">難道我沒有寫給你嗎？<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />那是要讓你明白確實的真理之言，</para>
  <para style="q1" vid="PRO 22:21">好用真理之言回應派遣你來的人。<verse eid="PRO 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />不要因為窮人貧弱，就搶奪他，</para>
  <para style="q1" vid="PRO 22:22">也不要在城門口壓迫困苦人；<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />因為耶和華會為他們辯護，</para>
  <para style="q1" vid="PRO 22:23">並要奪去那些搶奪者的性命。<verse eid="PRO 22:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />不要與好發火的人結交，</para>
  <para style="q1" vid="PRO 22:24">也不要與易怒的人來往；<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />免得你效法他的行為，</para>
  <para style="q1" vid="PRO 22:25">使自己落入陷阱。<verse eid="PRO 22:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />不要成為擊掌作保的人，</para>
  <para style="q1" vid="PRO 22:26">也不要為債務擔保；<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />如果你無力償還，</para>
  <para style="q1" vid="PRO 22:27">你身下的床就要被人拿走，</para>
  <para style="q1" vid="PRO 22:27">何必如此呢？<verse eid="PRO 22:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />你祖先在古時所設立的地界，</para>
  <para style="q1" vid="PRO 22:28">你不可挪移。<verse eid="PRO 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />你看見過做事老練的人嗎？</para>
  <para style="q1" vid="PRO 22:29">他必站立在君王面前，</para>
  <para style="q1" vid="PRO 22:29">而不會站立在低微的人面前。<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />當你與管轄者一起坐席吃飯的時候，</para>
  <para style="q1" vid="PRO 23:1">要小心留意你面對的是什麼。<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />如果你是個貪食的人，</para>
  <para style="q1" vid="PRO 23:2">就當把刀放在自己的喉嚨上；<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />不要貪戀他的美食，</para>
  <para style="q1" vid="PRO 23:3">因為那食物是圈套<note caller="+" style="f"><char style="fr" closed="false">23:3 </char><char style="ft" closed="false">那食物是圈套——原文直譯「那是騙人的食物」。</char></note>。<verse eid="PRO 23:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />不要辛勞求富，</para>
  <para style="q1" vid="PRO 23:4">要有悟性，適可而止。<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />你的目光飛向財富，它卻不見了；</para>
  <para style="q1" vid="PRO 23:5">因為財富必定長出翅膀，如鷹飛向天空。<verse eid="PRO 23:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />你不要吃吝嗇人<note caller="+" style="f"><char style="fr" closed="false">23:6 </char><char style="ft" closed="false">吝嗇人——或譯作「貪婪的人」。原文直譯「心眼壞的人」。</char></note>的餅，</para>
  <para style="q1" vid="PRO 23:6">也不要貪戀他的美食；<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />因為他是那種心裡算計的人；</para>
  <para style="q1" vid="PRO 23:7">雖然他對你說「吃吧，喝吧」，</para>
  <para style="q1" vid="PRO 23:7">但他的心卻不與你在一起。<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />你所吃的那點食物，必吐出來；</para>
  <para style="q1" vid="PRO 23:8">你那些恭維的話，也都白費了。<verse eid="PRO 23:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />你不要說話給愚昧人聽，</para>
  <para style="q1" vid="PRO 23:9">因為他會藐視你明達的言語。<verse eid="PRO 23:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />你不要挪移古時的地界，</para>
  <para style="q1" vid="PRO 23:10">也不要侵入孤兒的田地；<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />因為他們的救贖主大有能力，</para>
  <para style="q1" vid="PRO 23:11">他必為他們辯護對付你。<verse eid="PRO 23:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />你當專心領受管教，</para>
  <para style="q1" vid="PRO 23:12">側耳聽知識的言語。<verse eid="PRO 23:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />管教孩子，不要有所保留；</para>
  <para style="q1" vid="PRO 23:13">就算你用杖責打他，他也不至於死。<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />你用杖責打他，</para>
  <para style="q1" vid="PRO 23:14">就會救他的靈魂免下陰間。<verse eid="PRO 23:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />我兒啊，如果你的心有智慧，</para>
  <para style="q1" vid="PRO 23:15">我的心也就歡喜！<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />你的嘴說出正直的話，</para>
  <para style="q1" vid="PRO 23:16">我的內心就會歡躍。<verse eid="PRO 23:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />你的心不要嫉妒罪人，</para>
  <para style="q1" vid="PRO 23:17">而要終日敬畏耶和華；<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />你就一定會有前途，</para>
  <para style="q1" vid="PRO 23:18">你的希望也不會斷絕。<verse eid="PRO 23:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />我兒啊，聽我的話，要有智慧，</para>
  <para style="q1" vid="PRO 23:19">要引導你的心走在正道上！<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />你不要成為酗酒之徒，</para>
  <para style="q1" vid="PRO 23:20">也不要與貪吃肉的人為伍；<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />因為酗酒和貪吃的必陷入窮困，</para>
  <para style="q1" vid="PRO 23:21">而貪睡的必穿破爛衣服。<verse eid="PRO 23:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />那生你的父親，你當聽從；</para>
  <para style="q1" vid="PRO 23:22">你母親年老時，也不可藐視她<note caller="+" style="f"><char style="fr" closed="false">23:22 </char><char style="ft" closed="false">你母親年老時，也不可藐視她——或譯作「也不可因為母親老了，就藐視她」。</char></note>。<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />你當買真理、智慧、管教和悟性，</para>
  <para style="q1" vid="PRO 23:23">不可賣掉它們！<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />義人的父親，必大有快樂；</para>
  <para style="q1" vid="PRO 23:24">生智慧兒子的，必因他歡喜。<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />願你的父母歡喜，</para>
  <para style="q1" vid="PRO 23:25">願生你的母親快樂。<verse eid="PRO 23:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />我兒啊，要把你的心交給我，</para>
  <para style="q1" vid="PRO 23:26">你的眼目要謹守我的道路！<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />因為妓女是深深的坑，</para>
  <para style="q1" vid="PRO 23:27">淫蕩女子是狹窄的井。<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />她甚至像強盜那樣埋伏，</para>
  <para style="q1" vid="PRO 23:28">使背信的男人增多。<verse eid="PRO 23:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />誰有禍了？誰有痛苦？</para>
  <para style="q1" vid="PRO 23:29">誰有爭執？誰有苦情？</para>
  <para style="q1" vid="PRO 23:29">誰無故受傷？誰的眼目赤紅？<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />就是那些沉湎於酒，</para>
  <para style="q1" vid="PRO 23:30">常去找混合酒的人。<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />雖然酒發紅、在杯中閃爍、下咽舒暢，</para>
  <para style="q1" vid="PRO 23:31">但你不要去看它。<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />酒到盡頭，會像蛇那樣咬你，</para>
  <para style="q1" vid="PRO 23:32">像毒蛇那樣刺你；<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />你的眼就看見怪事，</para>
  <para style="q1" vid="PRO 23:33">你的心也吐出荒謬；<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />你就像是躺在海中，</para>
  <para style="q1" vid="PRO 23:34">也像躺在桅杆頂端，說：<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />「他們打我，我不疼痛；</para>
  <para style="q1" vid="PRO 23:35">他們擊打我，我也不知道。</para>
  <para style="q1" vid="PRO 23:35">我什麼時候醒來呢？</para>
  <para style="q1" vid="PRO 23:35">我還要繼續尋找酒。」<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />你不要嫉妒惡人，</para>
  <para style="q1" vid="PRO 24:1">也不要渴望與他們在一起；<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />因為他們的心圖謀毀滅，</para>
  <para style="q1" vid="PRO 24:2">他們的口談論禍事。<verse eid="PRO 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />房屋藉著智慧建立，藉著聰慧確立；<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />室內藉著知識充滿各樣寶貴美好的財物。<verse eid="PRO 24:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />有智慧的人，就有力量；</para>
  <para style="q1" vid="PRO 24:5">有知識的人，力上加力。<note caller="+" style="f"><char style="fr" closed="false">24:5 </char><char style="ft" closed="false">此節或譯作：有智慧的人勝過壯士，有知識的人勝過有大能的人。</char></note><verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />因為你作戰，要靠指引；</para>
  <para style="q1" vid="PRO 24:6">謀士眾多，就可得勝。<verse eid="PRO 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />智慧對愚妄人是高深的；</para>
  <para style="q1" vid="PRO 24:7">所以愚妄人在城門內開不了口。<verse eid="PRO 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />圖謀作惡的，</para>
  <para style="q1" vid="PRO 24:8">被稱為陰謀家。<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />愚妄人的計謀都是罪，</para>
  <para style="q1" vid="PRO 24:9">譏諷者為人所憎惡。<verse eid="PRO 24:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />如果你在患難的日子裡軟弱，</para>
  <para style="q1" vid="PRO 24:10">你的力量就微小。<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />有人被拉向死地，你要解救；</para>
  <para style="q1" vid="PRO 24:11">有人踉蹌著去殺戮之地，你一定要攔阻！<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />如果你說：「看哪，我不知道這事！」</para>
  <para style="q1" vid="PRO 24:12">難道衡量人心的那一位不了解嗎？</para>
  <para style="q1" vid="PRO 24:12">難道守護你性命的那一位不知道嗎？</para>
  <para style="q1" vid="PRO 24:12">難道他不照著各人所做的回報各人嗎？<verse eid="PRO 24:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />我兒啊，你當吃蜂蜜，因為它是美好的；</para>
  <para style="q1" vid="PRO 24:13">蜂房下滴的蜜，使你的唇齒甘甜！<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />當知道，智慧對你的心也是如此；</para>
  <para style="q1" vid="PRO 24:14">你如果找到她，就有前途，</para>
  <para style="q1" vid="PRO 24:14">你的希望也不會斷絕。<verse eid="PRO 24:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />惡人哪，不要埋伏攻擊義人的居所，</para>
  <para style="q1" vid="PRO 24:15">不要摧毀他的安歇之處！<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />因為義人即使跌倒七次，也能再起來；</para>
  <para style="q1" vid="PRO 24:16">惡人卻被禍患傾倒。<verse eid="PRO 24:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />你的仇敵跌倒時，你不要歡喜；</para>
  <para style="q1" vid="PRO 24:17">他傾倒時，你的心不要快樂；<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />免得耶和華看見，在他眼中看為惡，</para>
  <para style="q1" vid="PRO 24:18">他就使他的怒氣從仇敵身上轉消。<verse eid="PRO 24:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />不要因作惡者而心懷不平，</para>
  <para style="q1" vid="PRO 24:19">也不要嫉妒惡人；<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />因為壞人沒有前途，</para>
  <para style="q1" vid="PRO 24:20">惡人的燈必要熄滅。<verse eid="PRO 24:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />我兒啊，你當敬畏耶和華和君王，</para>
  <para style="q1" vid="PRO 24:21">不要與逆反的人<note caller="+" style="f"><char style="fr" closed="false">24:21 </char><char style="ft" closed="false">逆反的人——或譯作「反覆無常的人」。</char></note>結交！<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />因為來自耶和華和君王的災難會突然興起；</para>
  <para style="q1" vid="PRO 24:22">來自他們兩者的災患，誰能知道呢？<verse eid="PRO 24:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 24:23" />以下也是智慧人的話語：</para>
  <para style="q1" vid="PRO 24:23">在裁決時顧及情面是不好的。<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />誰要是對惡人說「你是義人」，</para>
  <para style="q1" vid="PRO 24:24">萬民就咒罵他，萬族就惱恨他；<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />而那些責備惡人的，令人喜悅<note caller="+" style="f"><char style="fr" closed="false">24:25 </char><char style="ft" closed="false">令人喜悅——或譯作「自己喜悅」。</char></note>，</para>
  <para style="q1" vid="PRO 24:25">美好的祝福將臨到他們。<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />回話坦誠的，</para>
  <para style="q1" vid="PRO 24:26">如親吻嘴唇。<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />你當在外面把工作預備好，</para>
  <para style="q1" vid="PRO 24:27">在田間為自己準備妥當，</para>
  <para style="q1" vid="PRO 24:27">然後才建造你的房屋。<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />不可無故作證控告你的鄰人；</para>
  <para style="q1" vid="PRO 24:28">難道你要用嘴唇欺騙人嗎？<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />不可說：</para>
  <para style="q1" vid="PRO 24:29">「人怎樣對待我，我也怎樣對待他；</para>
  <para style="q1" vid="PRO 24:29">我要照著他所做的報復他。」<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />我經過懶惰人的田地，</para>
  <para style="q1" vid="PRO 24:30">經過缺乏心智者的葡萄園；<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />看哪，那裡到處長滿灌木叢，</para>
  <para style="q1" vid="PRO 24:31">雜草遮蓋地面，</para>
  <para style="q1" vid="PRO 24:31">石頭的圍牆也倒塌了！<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />我觀察，就放在心上；</para>
  <para style="q1" vid="PRO 24:32">我看見，就接受教訓：<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />再睡一會兒，</para>
  <para style="q1" vid="PRO 24:33">再打盹一會兒，</para>
  <para style="q1" vid="PRO 24:33">再抱著雙手躺一會兒，<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />你的貧窮就會像強盜來到，</para>
  <para style="q1" vid="PRO 24:34">你的缺乏就會像拿兵器的人<note caller="+" style="f"><char style="fr" closed="false">24:34 </char><char style="ft" closed="false">拿兵器的人——原文直譯「拿盾牌的人」。</char></note>來到。<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s">希西加收錄的箴言</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />以下也是<char style="pn">所羅門</char>的箴言，是<char style="pn">猶大</char>王<char style="pn">希西加</char>的人所抄錄的：<verse eid="PRO 25:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />隱藏事情，是神的榮耀；</para>
  <para style="q1" vid="PRO 25:2">探查事情，是君王的榮耀。<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />如天之高，如地之深，</para>
  <para style="q1" vid="PRO 25:3">君王之心也無法測度。<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />除掉銀子中的渣滓，</para>
  <para style="q1" vid="PRO 25:4">煉銀者就造出器皿；<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />除掉王面前的惡人，</para>
  <para style="q1" vid="PRO 25:5">王的寶座就藉著公義而堅立。<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />你不要在王面前妄自尊大，</para>
  <para style="q1" vid="PRO 25:6">也不要站在大人物的位上；<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />因為讓人對你說「上到這裡來吧」，</para>
  <para style="q1" vid="PRO 25:7">好過在你所見的權貴面前被降卑。<verse eid="PRO 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8" />不可急於出去與人爭訟；</para>
  <para style="q1" vid="PRO 25:8">否則你的鄰人羞辱你時，</para>
  <para style="q1" vid="PRO 25:8">你最後要怎麼做呢？<verse eid="PRO 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />有了爭訟，可以與鄰人爭辯，</para>
  <para style="q1" vid="PRO 25:9">但不要暴露他人的祕密，<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />免得聽見的人辱罵你，</para>
  <para style="q1" vid="PRO 25:10">你的惡名就不會離開你。<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />話說得合宜，</para>
  <para style="q1" vid="PRO 25:11">就如金蘋果鑲在銀器上。<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />在聽從者的耳中，</para>
  <para style="q1" vid="PRO 25:12">智慧的責備就如金環和黃金首飾。<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />忠實的信使對於派遣他的人，</para>
  <para style="q1" vid="PRO 25:13">如同收割日子裡冰雪的清涼，</para>
  <para style="q1" vid="PRO 25:13">使主人的心舒暢<note caller="+" style="f"><char style="fr" closed="false">25:13 </char><char style="ft" closed="false">使主人的心舒暢——或譯作「使主人的靈魂甦醒」。</char></note>。<verse eid="PRO 25:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />為沒送的禮物誇耀，</para>
  <para style="q1" vid="PRO 25:14">就如有雲有風卻無雨。<verse eid="PRO 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />藉著恆久忍耐，能說服統領；</para>
  <para style="q1" vid="PRO 25:15">溫和的舌頭，能折斷骨頭。<verse eid="PRO 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />你找到蜂蜜，吃夠就好<note caller="+" style="f"><char style="fr" closed="false">25:16 </char><char style="ft" closed="false">就好——輔助詞語。</char></note>；</para>
  <para style="q1" vid="PRO 25:16">免得你過飽，把它吐出來。<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />你的腳要少進鄰人的家，</para>
  <para style="q1" vid="PRO 25:17">免得他厭煩你、恨惡你。<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />作假見證指證自己鄰人的，</para>
  <para style="q1" vid="PRO 25:18">就像大錘、刀劍和利箭。<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />在患難的日子裡依賴背信者，</para>
  <para style="q1" vid="PRO 25:19">就如依賴壞的牙齒、顫抖的腳。<verse eid="PRO 25:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />對著悲傷的心靈唱歌，</para>
  <para style="q1" vid="PRO 25:20">就像冷天脫衣服，</para>
  <para style="q1" vid="PRO 25:20">又像鹼上倒醋。<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />如果你的仇敵餓了，你當給他食物吃；</para>
  <para style="q1" vid="PRO 25:21">如果他渴了，你當給他水喝；<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />你這樣做<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="ft" closed="false">這樣做——輔助詞語。</char></note>，就如把火炭堆在他的頭上，</para>
  <para style="q1" vid="PRO 25:22">耶和華也必回報你。<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />北風帶來大雨，</para>
  <para style="q1" vid="PRO 25:23">暗中毀謗的口舌帶來怒容。<verse eid="PRO 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />寧可住在屋頂的一角，</para>
  <para style="q1" vid="PRO 25:24">也好過與爭吵的妻子<note caller="+" style="f"><char style="fr" closed="false">25:24 </char><char style="ft" closed="false">妻子——或譯作「女人」。</char></note>同住一屋。<verse eid="PRO 25:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />來自遙遠之地的好消息，</para>
  <para style="q1" vid="PRO 25:25">就如涼水滋潤<note caller="+" style="f"><char style="fr" closed="false">25:25 </char><char style="ft" closed="false">滋潤——輔助詞語。</char></note>疲乏的心靈。<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />義人在惡人面前動搖，</para>
  <para style="q1" vid="PRO 25:26">就如被踐踏的泉源，受汙染的水泉。<verse eid="PRO 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />吃蜂蜜過多不好；</para>
  <para style="q1" vid="PRO 25:27">刻意追求自己的榮耀，也不榮耀。<verse eid="PRO 25:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />人不控制自己的心靈，</para>
  <para style="q1" vid="PRO 25:28">就如毀壞的城沒有城牆。<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />就像夏天落雪，收割時下雨，</para>
  <para style="q1" vid="PRO 26:1">愚昧人得尊榮也不合宜。<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />就像麻雀在翻飛，燕子在飛翔，</para>
  <para style="q1" vid="PRO 26:2">無故的詛咒也不會降下。<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />鞭子用來打馬，嚼環用來套驢，</para>
  <para style="q1" vid="PRO 26:3">而杖用來打愚昧人的背。<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />不要照著愚昧人的愚妄回應他，</para>
  <para style="q1" vid="PRO 26:4">免得你也像他一樣。<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />要照著愚昧人的愚妄回應他，</para>
  <para style="q1" vid="PRO 26:5">免得他自以為<note caller="+" style="f"><char style="fr" closed="false">26:5 </char><char style="ft" closed="false">自以為——原文直譯「在自己眼中」。</char></note>有智慧。<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />藉著愚昧人的手傳送信息的，</para>
  <para style="q1" vid="PRO 26:6">就是自砍雙腳、自討苦吃<note caller="+" style="f"><char style="fr" closed="false">26:6 </char><char style="ft" closed="false">自討苦吃——原文直譯「喝下殘暴」。</char></note>。<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />箴言在愚昧人的口中，</para>
  <para style="q1" vid="PRO 26:7">就像瘸子的腿懸空無用。<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />把尊榮給愚昧人，</para>
  <para style="q1" vid="PRO 26:8">如同把石頭綁死在彈弓<note caller="+" style="f"><char style="fr" closed="false">26:8 </char><char style="ft" closed="false">彈弓——或譯作「投石器」。</char></note>上<note caller="+" style="f"><char style="fr" closed="false">26:8 </char><char style="ft" closed="false">把石頭綁死在彈弓上——或譯作「把寶石放在石堆中」。</char></note>。<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />箴言在愚昧人的口中，</para>
  <para style="q1" vid="PRO 26:9">就如蒺藜落在醉漢的手裡。<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />雇用愚昧人和過路人的，</para>
  <para style="q1" vid="PRO 26:10">就如任意射人的弓箭手。<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />愚昧人重複自己的愚妄，</para>
  <para style="q1" vid="PRO 26:11">如同狗轉回來吃自己所吐的。<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />你見過自以為<note caller="+" style="f"><char style="fr" closed="false">26:12 </char><char style="ft" closed="false">自以為——原文直譯「在自己眼中」。</char></note>有智慧的人嗎？</para>
  <para style="q1" vid="PRO 26:12">愚昧人比他更有希望。<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />懶惰人說：「道路上有猛獅，</para>
  <para style="q1" vid="PRO 26:13">街市中有獅子。」<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />懶惰人在自己床上，</para>
  <para style="q1" vid="PRO 26:14">就如門在軸上扭轉。<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />懶惰的人手放在盤子裡，</para>
  <para style="q1" vid="PRO 26:15">連把食物拿回自己口裡也嫌麻煩。<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />懶惰人自以為<note caller="+" style="f"><char style="fr" closed="false">26:16 </char><char style="ft" closed="false">自以為——原文直譯「在自己眼中」。</char></note>比七個善於應對的人更有智慧。<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />過路人捲入與自己無關的爭辯，</para>
  <para style="q1" vid="PRO 26:17">就如人去揪住狗的耳朵。<verse eid="PRO 26:17" /></para>
  <para style="q1">
    <verse number="18-19" style="v" sid="PRO 26:18-19" />人欺騙了鄰舍，</para>
  <para style="q1" vid="PRO 26:18-19">卻說「我不就是開個玩笑嗎？」</para>
  <para style="q1" vid="PRO 26:18-19">他就像瘋狂的人，</para>
  <para style="q1" vid="PRO 26:18-19">拋出火把、箭矢和死亡<note caller="+" style="f"><char style="fr" closed="false">26:18-19 </char><char style="ft" closed="false">拋出火把、箭矢和死亡——或譯作「拋出致死的火把和利箭」。</char></note>。<verse eid="PRO 26:18-19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />沒有木柴，火就熄滅；</para>
  <para style="q1" vid="PRO 26:20">沒有傳謠者，紛爭就平息。<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />好爭執的人煽動爭端，</para>
  <para style="q1" vid="PRO 26:21">就如餘火加炭，火上加柴。<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />傳謠者的話語，如同可口的食物，</para>
  <para style="q1" vid="PRO 26:22">下到人的臟腑。<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />火熱的嘴配奸惡的心，</para>
  <para style="q1" vid="PRO 26:23">就像銀渣包在瓦器上。<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />懷恨人的，用言語<note caller="+" style="f"><char style="fr" closed="false">26:24 </char><char style="ft" closed="false">言語——原文直譯「嘴唇」。</char></note>掩飾自己，</para>
  <para style="q1" vid="PRO 26:24">心裡卻存著詭詐。<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />他說的再好聽，也不要相信他，</para>
  <para style="q1" vid="PRO 26:25">因為他的心裡有七樣可憎之事。<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />他的怨恨雖用欺瞞掩蓋，</para>
  <para style="q1" vid="PRO 26:26">但他的邪惡必在會眾裡被揭露。<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />挖陷坑的，自己必掉在其中；</para>
  <para style="q1" vid="PRO 26:27">滾石頭的，石頭必反滾在自己身上。<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />撒謊的舌，恨它壓傷的人；</para>
  <para style="q1" vid="PRO 26:28">圓滑的口，造成敗壞的事。<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />不要為明天誇耀，</para>
  <para style="q1" vid="PRO 27:1">因為你不知道一天中會發生什麼。<verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />讓別人稱讚你，而不是用自己的口；</para>
  <para style="q1" vid="PRO 27:2">讓外人稱讚你，而不是用自己的嘴。<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />石頭重，沙土沉，</para>
  <para style="q1" vid="PRO 27:3">愚妄人的惱怒比這兩樣更重。<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />怒火雖凶殘，怒氣如洪流，</para>
  <para style="q1" vid="PRO 27:4">但在嫉妒面前，誰能站得住呢？<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />當面的責備，</para>
  <para style="q1" vid="PRO 27:5">好過隱藏的愛。<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />朋友所加的創傷，出於真誠；</para>
  <para style="q1" vid="PRO 27:6">仇敵連連的親吻，卻是多餘。<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />人飽足了，蜂房之蜜也會踐踏；</para>
  <para style="q1" vid="PRO 27:7">人飢餓了，一切苦澀都覺得甘甜。<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />人離開自己的地方漂泊，</para>
  <para style="q1" vid="PRO 27:8">就像雀鳥離開自己的窩巢漂游。<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />膏油和香料，使人心裡歡喜；</para>
  <para style="q1" vid="PRO 27:9">朋友的甘甜，來自真心的勸告。<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />你的朋友和你父親的朋友，你都不要離棄；</para>
  <para style="q1" vid="PRO 27:10">你遭難的日子裡，不要進入兄弟的家；</para>
  <para style="q1" vid="PRO 27:10">遠方的兄弟不如近處的鄰居。<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />我兒啊，你要有智慧，使我心裡歡喜，</para>
  <para style="q1" vid="PRO 27:11">我就能回應辱罵我的人！<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />聰明人看見惡事會躲藏；</para>
  <para style="q1" vid="PRO 27:12">無知的人前去自招懲罰。<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />誰為別人<note caller="+" style="f"><char style="fr" closed="false">27:13 </char><char style="ft" closed="false">別人——或譯作「陌生人」。</char></note>作保，就拿去誰的衣服；</para>
  <para style="q1" vid="PRO 27:13">誰替淫蕩女子<note caller="+" style="f"><char style="fr" closed="false">27:13 </char><char style="ft" closed="false">淫蕩女子——或譯作「外邦人」。</char></note>作保，就把誰當作抵押。<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />清早起來大聲祝福鄰人，</para>
  <para style="q1" vid="PRO 27:14">就被算為對他的詛咒。<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />大雨之日連連滴漏，</para>
  <para style="q1" vid="PRO 27:15">爭吵的妻子<note caller="+" style="f"><char style="fr" closed="false">27:15 </char><char style="ft" closed="false">妻子——或譯作「女人」。</char></note>也是如此；<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />想要攔阻她的，就像攔阻風，</para>
  <para style="q1" vid="PRO 27:16">又像用右手去抓膏油。<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />鐵磨利鐵，</para>
  <para style="q1" vid="PRO 27:17">朋友互相磨礪<note caller="+" style="f"><char style="fr" closed="false">27:17 </char><char style="ft" closed="false">朋友互相磨礪——原文直譯「人磨朋友的臉」。</char></note>也是如此。<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />看護無花果樹的，得享果實；</para>
  <para style="q1" vid="PRO 27:18">守護主人的，得享尊榮。<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />水面怎樣映出人的臉，</para>
  <para style="q1" vid="PRO 27:19">人的心也怎樣映出這個人。<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />陰間地府，從不飽足；</para>
  <para style="q1" vid="PRO 27:20">人的眼目，也不飽足。<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />熔鍋用以煉銀，熔爐用以煉金；</para>
  <para style="q1" vid="PRO 27:21">口中的誇讚也試煉人。<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />就算用杵將愚妄人與麥子一同搗碎在石臼中，</para>
  <para style="q1" vid="PRO 27:22">他的愚妄還是不會離開他。<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />你當清楚知道你羊群的情況，</para>
  <para style="q1" vid="PRO 27:23">又當把群羊放在你心上。<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />因為財富不會存到永遠，</para>
  <para style="q1" vid="PRO 27:24">冠冕也不會存到萬代。<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />乾草割去，嫩草出現，</para>
  <para style="q1" vid="PRO 27:25">山上的牧草被收取；<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />綿羊的毛給你做衣袍，</para>
  <para style="q1" vid="PRO 27:26">山羊用來作田價；<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />山羊的奶足夠作你的食物、</para>
  <para style="q1" vid="PRO 27:27">作你家人的食物，</para>
  <para style="q1" vid="PRO 27:27">也足夠養活你的使女們。<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />惡人雖沒有人追趕也會逃跑；</para>
  <para style="q1" vid="PRO 28:1">義人卻像少壯獅子無所懼怕。<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />國中因有過犯，就有許多首領爭權<note caller="+" style="f"><char style="fr" closed="false">28:2 </char><char style="ft" closed="false">爭權——輔助詞語。</char></note>；</para>
  <para style="q1" vid="PRO 28:2">但靠著有悟性、有知識的人，國就得以長存。<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />窮人欺壓貧弱者，就如暴雨沖過，</para>
  <para style="q1" vid="PRO 28:3">一點糧食也不剩。<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />離棄律法的，會稱讚惡人；</para>
  <para style="q1" vid="PRO 28:4">遵守律法的，向惡人挑戰。<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />惡人不領悟什麼是公正；</para>
  <para style="q1" vid="PRO 28:5">但尋求耶和華的，卻領悟一切。<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />行事純全的窮人，</para>
  <para style="q1" vid="PRO 28:6">好過行事歪邪的富人。<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />謹守律法的，是有悟性之子；</para>
  <para style="q1" vid="PRO 28:7">結交貪食者的，使他的父親受辱。<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />用高息厚利使自己財物增多的，</para>
  <para style="q1" vid="PRO 28:8">是為恩待貧弱者的人積蓄。<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />轉耳不聽從律法的，</para>
  <para style="q1" vid="PRO 28:9">連他的禱告也可憎。<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />使正直人迷失到邪路上的，</para>
  <para style="q1" vid="PRO 28:10">必掉進自己的坑裡；</para>
  <para style="q1" vid="PRO 28:10">而純全人必繼承福份。<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />富有的人自以為<note caller="+" style="f"><char style="fr" closed="false">28:11 </char><char style="ft" closed="false">自以為——原文直譯「在自己眼中」。</char></note>有智慧，</para>
  <para style="q1" vid="PRO 28:11">但有悟性的貧弱者能看透他。<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />義人歡慶時，大有榮耀；</para>
  <para style="q1" vid="PRO 28:12">惡人興起時，世人就躲藏<note caller="+" style="f"><char style="fr" closed="false">28:12 </char><char style="ft" closed="false">躲藏——或譯作「被搜查」。</char></note>。<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />掩蓋自己過犯的，不會興盛；</para>
  <para style="q1" vid="PRO 28:13">承認並離棄過犯的，必蒙憐憫。<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />常存敬畏的，這人是蒙福的！</para>
  <para style="q1" vid="PRO 28:14">硬著自己心的，必陷入禍患。<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />邪惡的管轄者統治貧弱的民眾，</para>
  <para style="q1" vid="PRO 28:15">就如咆哮的獅子、猛衝的熊。<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />無知的領袖是殘酷的欺壓者；</para>
  <para style="q1" vid="PRO 28:16">但恨惡私利的人必日子長久。<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />背負殺人流血之罪的，</para>
  <para style="q1" vid="PRO 28:17">會一直逃亡到陰坑；</para>
  <para style="q1" vid="PRO 28:17">誰也不要扶持他！<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />行事純全的，必得到拯救；</para>
  <para style="q1" vid="PRO 28:18">道路歪邪的，瞬間就仆倒。<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />耕耘自己土地的，飽享糧食；</para>
  <para style="q1" vid="PRO 28:19">追求空虛之事的，飽受貧窮。<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />忠實的人，大蒙祝福；</para>
  <para style="q1" vid="PRO 28:20">急於發財的，難逃罪罰。<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />顧及人的情面是不好的；</para>
  <para style="q1" vid="PRO 28:21">卻有人為一小塊餅而枉法。<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />貪婪的人<note caller="+" style="f"><char style="fr" closed="false">28:22 </char><char style="ft" closed="false">貪婪的人——或譯作「吝嗇的人」。原文直譯「心眼壞的人」。</char></note>，急切要發財，</para>
  <para style="q1" vid="PRO 28:22">但他不明白窮乏將臨到他。<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />責備人的，比說諂媚話的，</para>
  <para style="q1" vid="PRO 28:23">後來能得更多的恩惠。<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />搶奪父母卻說「沒犯罪」的，</para>
  <para style="q1" vid="PRO 28:24">這人是毀滅者的同伴。<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />貪得無厭的<note caller="+" style="f"><char style="fr" closed="false">28:25 </char><char style="ft" closed="false">貪得無厭的——或譯作「心裡驕橫的」。</char></note>，挑動紛爭；</para>
  <para style="q1" vid="PRO 28:25">依靠耶和華的，必得豐裕。<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />心裡依靠自己的，是愚昧人；</para>
  <para style="q1" vid="PRO 28:26">藉著智慧行事的，必蒙拯救。<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />給予窮人的，不致缺乏；</para>
  <para style="q1" vid="PRO 28:27">閉眼不顧的，大受詛咒。<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />惡人興起時，人人躲藏；</para>
  <para style="q1" vid="PRO 28:28">惡人滅亡時，義人增多。<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />屢次受責，仍然硬著頸項的人，</para>
  <para style="q1" vid="PRO 29:1">頃刻之間就會被摧毀，無法挽回。<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />義人增多時，民眾就歡喜；</para>
  <para style="q1" vid="PRO 29:2">惡人管轄時，民眾就嘆息。<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />喜愛智慧的，使父親歡喜；</para>
  <para style="q1" vid="PRO 29:3">結交妓女的，必失喪財物。<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />王藉著公正，使國堅立；</para>
  <para style="q1" vid="PRO 29:4">但收受賄賂的，使國傾覆。<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />諂媚鄰人的，</para>
  <para style="q1" vid="PRO 29:5">是在他的腳前張開網羅。<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />惡人因過犯而落入陷阱，</para>
  <para style="q1" vid="PRO 29:6">而義人將會歡唱、歡喜。<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />義人明白貧弱者的爭訟，</para>
  <para style="q1" vid="PRO 29:7">惡人卻無知、不能領悟。<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />譏諷者使城中騷動，</para>
  <para style="q1" vid="PRO 29:8">智慧人使怒氣轉消。<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />智慧人與愚妄人爭訟，</para>
  <para style="q1" vid="PRO 29:9">愚妄人又發怒又譏笑，沒有安寧。<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />那流人血的，恨惡純全人，</para>
  <para style="q1" vid="PRO 29:10">並尋索正直人的性命<note caller="+" style="f"><char style="fr" closed="false">29:10 </char><char style="ft" closed="false">並尋索正直人的性命——或譯作「但正直人顧惜他的性命」。</char></note>。<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />愚昧人怒氣發盡；</para>
  <para style="q1" vid="PRO 29:11">智慧人悄悄平息。<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />如果管轄者聽信虛假的話語，</para>
  <para style="q1" vid="PRO 29:12">所有事奉他的人都會是惡人。<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />窮人和欺壓者有一相同之處<note caller="+" style="f"><char style="fr" closed="false">29:13 </char><char style="ft" closed="false">有一相同之處——原文直譯「彼此相遇」。</char></note>：</para>
  <para style="q1" vid="PRO 29:13">他們的眼目都蒙耶和華光照。<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />如果王以真理審判貧弱者，</para>
  <para style="q1" vid="PRO 29:14">他的寶座就必永遠堅立。<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />杖打和責備，能帶來智慧；</para>
  <para style="q1" vid="PRO 29:15">放任的孩子<note caller="+" style="f"><char style="fr" closed="false">29:15 </char><char style="ft" closed="false">孩子——或譯作「少年人」。</char></note>，使母親蒙羞。<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />惡人增多時，過犯就增多；</para>
  <para style="q1" vid="PRO 29:16">但義人將看見惡人敗亡。<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />你當管教你的兒子，</para>
  <para style="q1" vid="PRO 29:17">他會使你安心，</para>
  <para style="q1" vid="PRO 29:17">給你心中帶來喜樂。<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />沒有異象<note caller="+" style="f"><char style="fr" closed="false">29:18 </char><char style="ft" closed="false">異象——或譯作「啟示」。</char></note>時，民眾就放縱；</para>
  <para style="q1" vid="PRO 29:18">遵守律法的，這人必蒙福！<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />只用言語，奴僕不會受管教；</para>
  <para style="q1" vid="PRO 29:19">他即使了解，也不會回應。<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />你看見過話語急躁的人嗎？</para>
  <para style="q1" vid="PRO 29:20">連愚昧人也比他更有希望。<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />如果人對奴僕從小縱容，</para>
  <para style="q1" vid="PRO 29:21">自己以後就會有麻煩<note caller="+" style="f"><char style="fr" closed="false">29:21 </char><char style="ft" closed="false">自己以後就會有麻煩——或譯作「這奴僕以後就會成了他的繼承人」。</char></note>。<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />好發火的人，挑動紛爭；</para>
  <para style="q1" vid="PRO 29:22">易怒的人，過犯眾多。<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />人的自高，將使他降卑；</para>
  <para style="q1" vid="PRO 29:23">靈裡謙卑的，必得榮耀。<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />與盜賊分贓的，恨惡自己的性命；</para>
  <para style="q1" vid="PRO 29:24">即使聽見要被詛咒，他也不坦白。<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />對人的懼怕，會成為陷阱；</para>
  <para style="q1" vid="PRO 29:25">依靠耶和華的，安穩在高處。<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />有許多人求管轄者的情面；</para>
  <para style="q1" vid="PRO 29:26">但人求的公正<note caller="+" style="f"><char style="fr" closed="false">29:26 </char><char style="ft" closed="false">公正——或譯作「裁決」。</char></note>來自耶和華。<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />不義的人，為義人所憎惡；</para>
  <para style="q1" vid="PRO 29:27">行事正直的，為惡人所憎惡。<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s">亞古珥的話語</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />
    <char style="pn">雅基</char>的兒子<char style="pn">亞古珥</char>的話語，是神諭，是他向<char style="pn">伊鐵勒</char>的宣告，就是向<char style="pn">伊鐵勒</char>和<char style="pn">烏甲</char>說的<note caller="+" style="f"><char style="fr" closed="false">30:1 </char><char style="ft" closed="false">是他向伊鐵勒的宣告，就是向伊鐵勒和烏甲說的——或譯作「這人說：神啊，我很疲倦；神啊，我很疲倦，筋疲力盡」。</char></note>：<verse eid="PRO 30:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />我實在比別人更愚拙，</para>
  <para style="q1" vid="PRO 30:2">也沒有世人的悟性；<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />我沒有學到智慧，</para>
  <para style="q1" vid="PRO 30:3">也不明白至聖者<note caller="+" style="f"><char style="fr" closed="false">30:3 </char><char style="ft" closed="false">至聖者——或譯作「聖者們」。</char></note>的知識。<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />誰曾升上天，又降下來呢？</para>
  <para style="q1" vid="PRO 30:4">誰把風聚攏在自己的手中呢？</para>
  <para style="q1" vid="PRO 30:4">誰把眾水包在衣服裡呢？</para>
  <para style="q1" vid="PRO 30:4">誰確立了所有地極呢？</para>
  <para style="q1" vid="PRO 30:4">他的名字是什麼呢？</para>
  <para style="q1" vid="PRO 30:4">他兒子的名字是什麼呢？</para>
  <para style="q1" vid="PRO 30:4">你確實知道嗎？<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />神一切的言語都是精煉的；</para>
  <para style="q1" vid="PRO 30:5">對那些投靠他的，他就是盾牌。<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />你不要在他的話語上增添什麼，</para>
  <para style="q1" vid="PRO 30:6">免得他責備你，就表明你是說謊的。<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />我向你求兩件事，</para>
  <para style="q1" vid="PRO 30:7">在我死之前，請不要不賜給我：<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />求你使虛妄和虛謊的事遠離我；</para>
  <para style="q1" vid="PRO 30:8">求你使我不貧窮也不富裕，</para>
  <para style="q1" vid="PRO 30:8">只要把我日用<note caller="+" style="f"><char style="fr" closed="false">30:8 </char><char style="ft" closed="false">日用——原文直譯「份額」。</char></note>的食糧分給我，<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />免得我飽足了，就否認你，說：</para>
  <para style="q1" vid="PRO 30:9">「耶和華是誰呢？」</para>
  <para style="q1" vid="PRO 30:9">又免得我陷入窮困，就去偷竊，</para>
  <para style="q1" vid="PRO 30:9">以致干犯了我神的名。<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />你不要對主人說僕人的壞話，</para>
  <para style="q1" vid="PRO 30:10">免得他詛咒你，你就要承擔罪責。<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />這世代詛咒自己的父親，</para>
  <para style="q1" vid="PRO 30:11">也不祝福自己的母親。<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />這世代自以為<note caller="+" style="f"><char style="fr" closed="false">30:12 </char><char style="ft" closed="false">自以為——原文直譯「在自己眼中」。</char></note>純潔，</para>
  <para style="q1" vid="PRO 30:12">但他的汙穢卻沒有被洗淨。<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />這世代的眼目多麼高傲！</para>
  <para style="q1" vid="PRO 30:13">連他的眼皮也高高抬起。<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />這世代的牙齒如劍，尖牙如刀，</para>
  <para style="q1" vid="PRO 30:14">要吞滅地上的困苦人和世人中的貧窮人。<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />螞蟥有兩個女兒，</para>
  <para style="q1" vid="PRO 30:15">總說「給我！給我！」</para>
  <para style="q1" vid="PRO 30:15">有三樣東西不知足，</para>
  <para style="q1" vid="PRO 30:15">絕不說「夠了」的共有四樣，就是：<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />陰間、</para>
  <para style="q1" vid="PRO 30:16">不育的胎胞、</para>
  <para style="q1" vid="PRO 30:16">水源不足的土地、</para>
  <para style="q1" vid="PRO 30:16">不說「夠了」的火。<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />嘲笑父親，藐視而不順從母親的，</para>
  <para style="q1" vid="PRO 30:17">他的眼睛將被溪谷的烏鴉啄出來，</para>
  <para style="q1" vid="PRO 30:17">被鷹雛吃掉。<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />有三樣事，對我過於奇妙；</para>
  <para style="q1" vid="PRO 30:18">連同我不明白的共有四樣，就是：<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />天空中鷹的道、</para>
  <para style="q1" vid="PRO 30:19">磐石上蛇的道、</para>
  <para style="q1" vid="PRO 30:19">海洋中船的道，</para>
  <para style="q1" vid="PRO 30:19">以及男女之道。<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />淫婦的行徑是這樣的：</para>
  <para style="q1" vid="PRO 30:20">她吃完，把嘴一擦，就說：</para>
  <para style="q1" vid="PRO 30:20">「我沒有做壞事。」<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />在這三樣事之下，大地顫抖；</para>
  <para style="q1" vid="PRO 30:21">連同大地承受不了的共有四樣，就是：<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />奴僕作王、</para>
  <para style="q1" vid="PRO 30:22">愚頑人飽享糧食、<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />令人厭惡的女子有了丈夫、</para>
  <para style="q1" vid="PRO 30:23">婢女趕出她的主母。<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />地上有四樣東西微小，</para>
  <para style="q1" vid="PRO 30:24">但牠們很有智慧：<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />螞蟻，牠們不是強悍的種類，</para>
  <para style="q1" vid="PRO 30:25">但在夏天預備糧食；<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />巖貍，牠們不是強壯的種類，</para>
  <para style="q1" vid="PRO 30:26">但在岩石中安置自己的家；<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />蝗蟲，牠們沒有王，</para>
  <para style="q1" vid="PRO 30:27">但全部列隊而出；<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />壁虎，你用手就能抓住，</para>
  <para style="q1" vid="PRO 30:28">但牠卻在王的宮殿裡。<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />有三樣東西，牠們腳步威武；</para>
  <para style="q1" vid="PRO 30:29">連同行走威武的共有四樣，就是：<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />動物中勇猛的獅子，</para>
  <para style="q1" vid="PRO 30:30">牠面對一切都不退縮；<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />紮著腹帶的戰馬<note caller="+" style="f"><char style="fr" closed="false">30:31 </char><char style="ft" closed="false">戰馬——或譯作「公雞」或「獵狗」。</char></note>；</para>
  <para style="q1" vid="PRO 30:31">還有公山羊；</para>
  <para style="q1" vid="PRO 30:31">以及帶著軍隊的王。<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />如果你行事愚昧、抬高自己，</para>
  <para style="q1" vid="PRO 30:32">或是你謀劃惡事，</para>
  <para style="q1" vid="PRO 30:32">就當用手掩口。<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />因為攪動奶就出乳酪，</para>
  <para style="q1" vid="PRO 30:33">攪動鼻子就出鼻血，</para>
  <para style="q1" vid="PRO 30:33">攪動怒氣就出爭端。<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s">利慕伊勒王的話語</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />
    <char style="pn">利慕伊勒</char>王的話語，是神諭，就是他母親給他的警誡：<verse eid="PRO 31:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />我的兒子啊，</para>
  <para style="q1" vid="PRO 31:2">我腹中所生的兒子啊，</para>
  <para style="q1" vid="PRO 31:2">我許願所得的兒子啊，<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />不要把你的精力放在女人身上，</para>
  <para style="q1" vid="PRO 31:3">也不要有敗壞君王的行為<note caller="+" style="f"><char style="fr" closed="false">31:3 </char><char style="ft" closed="false">有敗壞君王的行為——或譯作「迷戀那些毀滅君王的人」。</char></note>。<verse eid="PRO 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />
    <char style="pn">利慕伊勒</char>啊，君王不要這樣！</para>
  <para style="q1" vid="PRO 31:4">君王不宜喝酒，君主不宜貪杯；<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />免得他們喝了，就忘記所制定的律例，</para>
  <para style="q1" vid="PRO 31:5">又在所有困苦人的爭訟上，顛倒是非。<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />你們當把烈酒給將要滅亡的人，</para>
  <para style="q1" vid="PRO 31:6">把酒給心靈愁苦的人；<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />讓他喝了就忘記自己的貧窮，</para>
  <para style="q1" vid="PRO 31:7">不會再記起自己的勞苦。<verse eid="PRO 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />你當為啞巴和所有孤苦人的爭訟開口。<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />你當開口，以公義施行審判，</para>
  <para style="q1" vid="PRO 31:9">為困苦人和貧窮人施行審斷。<verse eid="PRO 31:9" /></para>
  <para style="b" />
  <para style="s">讚美才德的妻子</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />才德的妻子，誰能找得到呢？</para>
  <para style="q1" vid="PRO 31:10">她的價值遠超過紅寶石。<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />她的丈夫心裡依靠她，</para>
  <para style="q1" vid="PRO 31:11">不會缺少收益<note caller="+" style="f"><char style="fr" closed="false">31:11 </char><char style="ft" closed="false">收益——原文直譯「戰利品」。</char></note>。<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />她一生的日子，</para>
  <para style="q1" vid="PRO 31:12">都使丈夫有益無損。<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />她尋找羊毛和細麻，</para>
  <para style="q1" vid="PRO 31:13">樂意親手做工。<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />她就像商人的船隊，</para>
  <para style="q1" vid="PRO 31:14">從遠方運來糧食。<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />天還黑的時候，她就起來，</para>
  <para style="q1" vid="PRO 31:15">把糧食分給家人，</para>
  <para style="q1" vid="PRO 31:15">把任務分給<note caller="+" style="f"><char style="fr" closed="false">31:15 </char><char style="ft" closed="false">把任務分給——或譯作「又分一份給」。</char></note>使女們。<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />她看中一塊田，就把它買下來；</para>
  <para style="q1" vid="PRO 31:16">又用親手賺得的收入種植葡萄園。<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />她以力量束腰，</para>
  <para style="q1" vid="PRO 31:17">使自己的膀臂有力。<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />她確實嘗到自己盈利的美好，</para>
  <para style="q1" vid="PRO 31:18">她的燈夜間也不熄滅。<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />她伸手拿著線軸，</para>
  <para style="q1" vid="PRO 31:19">掌中握著紡錘。<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />她向困苦人張開手掌，</para>
  <para style="q1" vid="PRO 31:20">向貧窮人伸出雙手。<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />她不因下雪而為家人擔心，</para>
  <para style="q1" vid="PRO 31:21">因為全家都穿著朱紅色衣服。<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />她為自己製作繡花床單，</para>
  <para style="q1" vid="PRO 31:22">她的衣袍是用細麻和紫色布做的。<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />她丈夫與當地的長老們同坐，</para>
  <para style="q1" vid="PRO 31:23">在城門口被眾人所認識。<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />她製作細麻衣去賣，</para>
  <para style="q1" vid="PRO 31:24">又給商人供應腰帶。<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />力量和尊嚴是她的衣袍，</para>
  <para style="q1" vid="PRO 31:25">她想到<note caller="+" style="f"><char style="fr" closed="false">31:25 </char><char style="ft" closed="false">想到——輔助詞語。</char></note>將來的日子就歡笑。<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />她藉著智慧開口，</para>
  <para style="q1" vid="PRO 31:26">她的舌頭上有慈愛的訓誨。<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />她照看家中事務，</para>
  <para style="q1" vid="PRO 31:27">從不吃閒飯。<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />她的兒女起來，稱她有福，</para>
  <para style="q1" vid="PRO 31:28">她的丈夫也稱讚她：<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />「才德的女子有許多，</para>
  <para style="q1" vid="PRO 31:29">但你超越她們所有人！」<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />艷麗是虛假的，美貌是虛幻的；</para>
  <para style="q1" vid="PRO 31:30">唯有敬畏耶和華的女子必受稱讚。<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />願她享受自己手中的果實，</para>
  <para style="q1" vid="PRO 31:31">願她所做的使她在城門口受稱讚！<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>