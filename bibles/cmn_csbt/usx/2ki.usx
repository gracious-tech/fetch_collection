<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2KI" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">列王紀下</para>
  <para style="mt">列王紀下</para>
  <chapter number="1" style="c" sid="2KI 1" />
  <para style="s">亞哈謝病逝</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 1:1" />
    <char style="pn">亞哈</char>死後，<char style="pn">摩押</char>反叛了<char style="pn">以色列</char>。 <verse eid="2KI 1:1" /><verse number="2" style="v" sid="2KI 1:2" />有一天，<char style="pn">亞哈謝</char>在<char style="pn">撒瑪利亞</char>從樓上的窗格摔下去，受了重傷。於是他派遣使者，對他們說：「你們去求問<char style="pn">以革倫</char>的神<char style="pn">巴力西卜</char>，我是否能從這傷病中康復。」<verse eid="2KI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 1:3" />耶和華的使者對<char style="pn">提斯比</char>人<char style="pn">以利亞</char>說：「你起來，上去迎見<char style="pn">撒瑪利亞</char>王的使者，對他們說：『難道是<char style="pn">以色列</char>沒有神，以致你們要去求問<char style="pn">以革倫</char>的神<char style="pn">巴力西卜</char>嗎？ <verse eid="2KI 1:3" /><verse number="4" style="v" sid="2KI 1:4" />因此，耶和華如此說：你再不能從你所上的床榻下來了，你必定死。』」<char style="pn">以利亞</char>就去了。<verse eid="2KI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 1:5" />使者們回到王那裡，王問他們：「你們怎麼回來了？」<verse eid="2KI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 1:6" />他們對王說：「有一個人上來迎見我們，對我們說：『去吧，回到派你們來的王那裡告訴他，耶和華如此說：難道是<char style="pn">以色列</char>沒有神，以致你派人去求問<char style="pn">以革倫</char>的神<char style="pn">巴力西卜</char>嗎？因此，你再不能從你所上的床榻下來了，你必定死。』」<verse eid="2KI 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 1:7" />王就問他們：「那上來迎見你們，對你們說這話的人，長什麼樣子？」<verse eid="2KI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 1:8" />他們說：「是個穿著毛皮的人，腰間束著皮帶。」王說：「那是<char style="pn">提斯比</char>人<char style="pn">以利亞</char>。」<verse eid="2KI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 1:9" />於是王派遣一個五十夫長帶著他的五十人去見<char style="pn">以利亞</char>。五十夫長上去見他，看哪，他正坐在山頂。五十夫長對他說：「神人哪，王命令你下來！」<verse eid="2KI 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 1:10" />
    <char style="pn">以利亞</char>回應五十夫長說：「如果我是神人，就願火從天上降下，吞噬你和你的五十人！」於是有火從天上降下，吞噬了五十夫長和他的五十人。<verse eid="2KI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 1:11" />王又派遣另一個五十夫長帶著他的五十人去見<char style="pn">以利亞</char>。五十夫長上去<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">上去——依據七十士譯本；馬索拉文本作「回應」。</char></note>對<char style="pn">以利亞</char>說：「神人哪，王如此說：你趕快下來！」<verse eid="2KI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 1:12" />
    <char style="pn">以利亞</char>回應他們，說：「如果我是神人，就願火從天上降下，吞噬你和你的五十人。」於是神的火從天上降下，吞噬了五十夫長和他的五十人。<verse eid="2KI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 1:13" />王又派遣第三個五十夫長帶著他的五十人上去。這第三個五十夫長前來，在<char style="pn">以利亞</char>面前雙膝跪下，向他懇求說：「神人哪，願我的性命和你這五十個僕人的性命在你眼中看為寶貴！ <verse eid="2KI 1:13" /><verse number="14" style="v" sid="2KI 1:14" />看哪，已經有火從天上降下，把兩個五十夫長和他們的五十人吞噬了，現在願我的性命在你眼中看為寶貴！」<verse eid="2KI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 1:15" />耶和華的使者對<char style="pn">以利亞</char>說：「你隨同他下去吧，不要怕他。」<char style="pn">以利亞</char>就起來，隨同他下去見王。<verse eid="2KI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 1:16" />
    <char style="pn">以利亞</char>對王說：「耶和華如此說：你竟然派遣使者去求問<char style="pn">以革倫</char>的神<char style="pn">巴力西卜</char>，難道是<char style="pn">以色列</char>沒有神可以求問嗎？因此，你再不能從你所上的床榻下來了，你必定死。」<verse eid="2KI 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 1:17" />
    <char style="pn">亞哈謝</char>死了，正如<char style="pn">以利亞</char>所宣告的耶和華的話。由於他沒有兒子，他的兄弟<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">他的兄弟——輔助詞語；依據其他古譯本。</char></note><char style="pn">約蘭</char>接替他作王；那是在<char style="pn">約沙法</char>的兒子<char style="pn">猶大</char>王<char style="pn">約蘭</char>在位第二年。 <verse eid="2KI 1:17" /><verse number="18" style="v" sid="2KI 1:18" /><char style="pn">亞哈謝</char>其餘的事蹟，他的作為，不是都記在《<char style="pn">以色列</char>諸王年代志》上嗎？<verse eid="2KI 1:18" /></para>
  <chapter eid="2KI 1" />
  <chapter number="2" style="c" sid="2KI 2" />
  <para style="s">以利亞在旋風中升天</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 2:1" />耶和華將要用旋風接<char style="pn">以利亞</char>升天的時候，<char style="pn">以利亞</char>和<char style="pn">以利沙</char>正離開<char style="pn">吉甲</char>。 <verse eid="2KI 2:1" /><verse number="2" style="v" sid="2KI 2:2" /><char style="pn">以利亞</char>對<char style="pn">以利沙</char>說：「你留在這裡吧，因為耶和華派我去<char style="pn">伯特利</char>。」</para>
  <para style="p" vid="2KI 2:2">
    <char style="pn">以利沙</char>說：「我指著耶和華的永生和你的生命起誓：我絕不離開你。」於是他們下<char style="pn">伯特利</char>去了。<verse eid="2KI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 2:3" />
    <char style="pn">伯特利</char>先知團契的門徒們來見<char style="pn">以利沙</char>，對他說：「你知道嗎，今天耶和華要把你師傅從你身邊接走！」</para>
  <para style="p" vid="2KI 2:3">他回答：「我知道，你們不要作聲。」<verse eid="2KI 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 2:4" />
    <char style="pn">以利亞</char>又對<char style="pn">以利沙</char>說：「<char style="pn">以利沙</char>，你留在這裡吧，因為耶和華派我去<char style="pn">耶利哥</char>。」</para>
  <para style="p" vid="2KI 2:4">
    <char style="pn">以利沙</char>說：「我指著耶和華的永生和你的生命起誓：我絕不離開你。」於是他們來到了<char style="pn">耶利哥</char>。<verse eid="2KI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 2:5" />
    <char style="pn">耶利哥</char>先知團契的門徒們來見<char style="pn">以利沙</char>，對他說：「你知道嗎，今天耶和華要把你師傅從你身邊接走！」</para>
  <para style="p" vid="2KI 2:5">他回答：「我知道，你們不要作聲。」<verse eid="2KI 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 2:6" />
    <char style="pn">以利亞</char>又對<char style="pn">以利沙</char>說：「你留在這裡吧，因為耶和華派我去<char style="pn">約旦</char>河。」</para>
  <para style="p" vid="2KI 2:6">
    <char style="pn">以利沙</char>說：「我指著耶和華的永生和你的生命起誓：我絕不離開你。」於是二人繼續前行。<verse eid="2KI 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 2:7" />他們二人在<char style="pn">約旦</char>河岸站住，先知團契的門徒中有五十個人也前來，遠遠站在對面。 <verse eid="2KI 2:7" /><verse number="8" style="v" sid="2KI 2:8" /><char style="pn">以利亞</char>脫下外衣，捲起來擊打河水，河水往兩邊分開，二人就從乾地上過去了。 <verse eid="2KI 2:8" /><verse number="9" style="v" sid="2KI 2:9" />過去之後，<char style="pn">以利亞</char>對<char style="pn">以利沙</char>說：「我從你身邊被接走之前，能為你做些什麼？你只管求吧。」</para>
  <para style="p" vid="2KI 2:9">
    <char style="pn">以利沙</char>回答：「唯願你的靈雙倍臨到我！」<verse eid="2KI 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 2:10" />
    <char style="pn">以利亞</char>說：「你求了一件很難的事。不過，如果你看到我從你身邊被接走，事情就會如此為你成就；但如果你沒看到，就不會成就。」<verse eid="2KI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 2:11" />他們繼續前行，邊走邊談，看哪，一輛火戰車和幾匹火戰馬把二人隔開，<char style="pn">以利亞</char>就在旋風中升到天上去了。 <verse eid="2KI 2:11" /><verse number="12" style="v" sid="2KI 2:12" /><char style="pn">以利沙</char>看見了，就呼喊：「我父啊！我父啊！<char style="pn">以色列</char>的戰車和馬兵啊！」隨後再也見不到他了。<char style="pn">以利沙</char>抓住自己的衣服，撕成了兩半。<verse eid="2KI 2:12" /></para>
  <para style="s">以利沙接替以利亞</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 2:13" />他把<char style="pn">以利亞</char>身上掉下來的外衣撿起來，回去站在<char style="pn">約旦</char>河岸。 <verse eid="2KI 2:13" /><verse number="14" style="v" sid="2KI 2:14" />他拿著<char style="pn">以利亞</char>身上掉下來的外衣擊打河水，說：「<char style="pn">以利亞</char>的神耶和華在哪裡？」他一擊打河水，河水就往兩邊分開，<char style="pn">以利沙</char>就過去了。<verse eid="2KI 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 2:15" />
    <char style="pn">耶利哥</char>先知團契的門徒們從對面看見<char style="pn">以利沙</char>，就說：「<char style="pn">以利亞</char>的靈停留在<char style="pn">以利沙</char>身上了。」於是他們來迎接<char style="pn">以利沙</char>，俯伏於地，向他下拜。<verse eid="2KI 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 2:16" />他們對<char style="pn">以利沙</char>說：「看哪，僕人們這裡有五十個強壯的人，請讓他們去尋找你師傅吧。或許耶和華的靈把他提走，拋在某一座山上或某一個山谷裡了。」</para>
  <para style="p" vid="2KI 2:16">
    <char style="pn">以利沙</char>說：「不用派人去。」<verse eid="2KI 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 2:17" />但他們再三勸說，直到他難以推辭，他就說：「你們派人去吧！」他們就派遣五十個人，尋找了三天，卻沒有找到<char style="pn">以利亞</char>。 <verse eid="2KI 2:17" /><verse number="18" style="v" sid="2KI 2:18" />他們就回到<char style="pn">以利沙</char>那裡，那時<char style="pn">以利沙</char>住在<char style="pn">耶利哥</char>。<char style="pn">以利沙</char>對他們說：「我不是告訴你們不用去了嗎？」<verse eid="2KI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 2:19" />有一天，那城的人對<char style="pn">以利沙</char>說：「請看，正如我主所看到的，這城位置很好；但水質很差，以致這地有流產<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">流產——或譯作「果實不熟而落」。</char></note>的事。」<verse eid="2KI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 2:20" />
    <char style="pn">以利沙</char>說：「給我拿來一個新碗，裡面放點鹽。」</para>
  <para style="p" vid="2KI 2:20">他們就拿來給他。 <verse eid="2KI 2:20" /><verse number="21" style="v" sid="2KI 2:21" /><char style="pn">以利沙</char>出去到水源那裡，把鹽倒進去，說：「耶和華如此說：我已經治好這水，再不會因這水而有死亡或流產<note caller="+" style="f"><char style="fr" closed="false">2:21 </char><char style="ft" closed="false">流產——或譯作「果實不熟而落」。</char></note>的事了。」 <verse eid="2KI 2:21" /><verse number="22" style="v" sid="2KI 2:22" />於是那水被治好了，直到今日，正如<char style="pn">以利沙</char>所宣告的。<verse eid="2KI 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 2:23" />
    <char style="pn">以利沙</char>離開那裡上<char style="pn">伯特利</char>去，他正趕路上去，有一群小孩子從城裡出來，嘲諷他說：「上去啊，禿頭！上去啊，禿頭！」<verse eid="2KI 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 2:24" />
    <char style="pn">以利沙</char>回頭看著他們，奉耶和華的名詛咒他們。於是有兩隻母熊從森林裡出來，撕碎了其中四十二個孩子。 <verse eid="2KI 2:24" /><verse number="25" style="v" sid="2KI 2:25" /><char style="pn">以利沙</char>從那裡前往<char style="pn">迦密</char>山，再從<char style="pn">迦密</char>山回到<char style="pn">撒瑪利亞</char>。<verse eid="2KI 2:25" /></para>
  <chapter eid="2KI 2" />
  <chapter number="3" style="c" sid="2KI 3" />
  <para style="s">以色列王約蘭</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 3:1" />
    <char style="pn">猶大</char>王<char style="pn">約沙法</char>在位第十八年，<char style="pn">亞哈</char>的兒子<char style="pn">約蘭</char>在<char style="pn">撒瑪利亞</char>作<char style="pn">以色列</char>的王，統治了十二年。 <verse eid="2KI 3:1" /><verse number="2" style="v" sid="2KI 3:2" />他做耶和華眼中看為惡的事，只是沒有像他父母那樣。他除掉了他父親所造的<char style="pn">巴力</char>神柱， <verse eid="2KI 3:2" /><verse number="3" style="v" sid="2KI 3:3" />不過他執着於<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>使<char style="pn">以色列</char>所犯的罪惡，總不離開。<verse eid="2KI 3:3" /></para>
  <para style="s">摩押反叛以色列</para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 3:4" />
    <char style="pn">摩押</char>王<char style="pn">米沙</char>從事畜牧業，照例向<char style="pn">以色列</char>王交納十萬隻羊羔，以及十萬隻公綿羊的毛， <verse eid="2KI 3:4" /><verse number="5" style="v" sid="2KI 3:5" />但<char style="pn">亞哈</char>死後，<char style="pn">摩押</char>王就反叛了<char style="pn">以色列</char>王。 <verse eid="2KI 3:5" /><verse number="6" style="v" sid="2KI 3:6" />那時<char style="pn">約蘭</char>王從<char style="pn">撒瑪利亞</char>出來，調集<char style="pn">以色列</char>全軍。 <verse eid="2KI 3:6" /><verse number="7" style="v" sid="2KI 3:7" />他出發時，派人去見<char style="pn">猶大</char>王<char style="pn">約沙法</char>，說：「<char style="pn">摩押</char>王反叛了我，你願與我一起去攻打<char style="pn">摩押</char>嗎？」</para>
  <para style="p" vid="2KI 3:7">
    <char style="pn">約沙法</char>說：「我願意去，你我不分彼此，我的子民如同你的子民，我的馬匹如同你的馬匹。」 <verse eid="2KI 3:7" /><verse number="8" style="v" sid="2KI 3:8" />他又說：「我們從哪一條路上去呢？」</para>
  <para style="p" vid="2KI 3:8">
    <char style="pn">約蘭</char>回答：「<char style="pn">以東</char>曠野那條路。」<verse eid="2KI 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 3:9" />於是，<char style="pn">以色列</char>王、<char style="pn">猶大</char>王和<char style="pn">以東</char>王一起出發。他們繞行七天的路程，軍兵和跟隨的牲畜都沒有水喝了。<verse eid="2KI 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 3:10" />
    <char style="pn">以色列</char>王說：「唉！耶和華召來我們這三個王，是要把我們交在<char style="pn">摩押</char>人手中啊。」<verse eid="2KI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 3:11" />
    <char style="pn">約沙法</char>說：「這裡有没有耶和華的先知？我們可以藉著他求問耶和華。」</para>
  <para style="p" vid="2KI 3:11">
    <char style="pn">以色列</char>王的一個臣僕回覆說：「這裡有<char style="pn">沙法</char>的兒子<char style="pn">以利沙</char>，他從前服事<char style="pn">以利亞</char><note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">服事以利亞——原文直譯「給以利亞手上倒水」。</char></note>。」<verse eid="2KI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 3:12" />
    <char style="pn">約沙法</char>說：「他必有耶和華的話語。」<char style="pn">以色列</char>王、<char style="pn">約沙法</char>和<char style="pn">以東</char>王就下去見<char style="pn">以利沙</char>。<verse eid="2KI 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 3:13" />
    <char style="pn">以利沙</char>對<char style="pn">以色列</char>王說：「我與你有什麼相干呢？去找你父親的先知、你母親的先知吧！」</para>
  <para style="p" vid="2KI 3:13">
    <char style="pn">以色列</char>王回答：「不要這樣，是耶和華召來我們這三個王，要把我們交在<char style="pn">摩押</char>人手中！」<verse eid="2KI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 3:14" />
    <char style="pn">以利沙</char>說：「我指著我所事奉的萬軍之耶和華的永生起誓：要不是看在<char style="pn">猶大</char>王<char style="pn">約沙法</char>的情面上，我絕不理你，也不睬你。 <verse eid="2KI 3:14" /><verse number="15" style="v" sid="2KI 3:15" />現在，給我找來一個彈琴的人。」</para>
  <para style="p" vid="2KI 3:15">當彈琴的人彈奏時，耶和華的手<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">手——或譯作「大能」。</char></note>落在<char style="pn">以利沙</char>身上。 <verse eid="2KI 3:15" /><verse number="16" style="v" sid="2KI 3:16" />他就說：「耶和華如此說：『讓這溪谷遍地都是水池。』 <verse eid="2KI 3:16" /><verse number="17" style="v" sid="2KI 3:17" />因為耶和華如此說：『你們不會見風，也不會見雨，但這溪谷卻必充滿了水，你們和你們的牲畜都會有水喝。』 <verse eid="2KI 3:17" /><verse number="18" style="v" sid="2KI 3:18" />這在耶和華眼中算為小事，他還要把<char style="pn">摩押</char>交在你們手中。 <verse eid="2KI 3:18" /><verse number="19" style="v" sid="2KI 3:19" />你們必攻破所有的堡壘城和所有繁榮的城鎮，砍倒一切美好的樹木，堵上所有水泉，用石頭毀壞所有良田。」<verse eid="2KI 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 3:20" />到了早晨，大約獻祭的時間，看哪，有水從<char style="pn">以東</char>方向流過來，遍地都滿了水。<verse eid="2KI 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 3:21" />全<char style="pn">摩押</char>都聽說了有幾個王上來攻打他們，於是所有佩帶兵器<note caller="+" style="f"><char style="fr" closed="false">3:21 </char><char style="ft" closed="false">兵器——原文直譯「腰帶」。</char></note>的成年人都被召集起來，守在邊界上。 <verse eid="2KI 3:21" /><verse number="22" style="v" sid="2KI 3:22" />他們清早起來的時候，日光照射在水面上，<char style="pn">摩押</char>人從對面看到水紅如血。 <verse eid="2KI 3:22" /><verse number="23" style="v" sid="2KI 3:23" />他們就說：「那是血！一定是那些王彼此攻擊、自相殘殺。<char style="pn">摩押</char>人哪，去搶戰利品了！」<verse eid="2KI 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 3:24" />
    <char style="pn">摩押</char>人來到<char style="pn">以色列</char>的營地，<char style="pn">以色列</char>人起來擊殺他們，<char style="pn">摩押</char>人就從<char style="pn">以色列</char>人面前逃跑。<char style="pn">以色列</char>人又殺入他們境內，擊殺<char style="pn">摩押</char>人。 <verse eid="2KI 3:24" /><verse number="25" style="v" sid="2KI 3:25" /><char style="pn">以色列</char>人拆毀他們的城鎮，各人扔石頭填滿所有良田，堵上所有水泉，砍倒一切美好的樹木，只剩下<char style="pn">吉珥-哈列設</char>的石牆，後來擲石兵包圍並攻破了它。<verse eid="2KI 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 3:26" />
    <char style="pn">摩押</char>王見戰事激烈，對他不利，就帶領七百個刀手，要突圍進攻<char style="pn">以東</char>王，卻沒成功。 <verse eid="2KI 3:26" /><verse number="27" style="v" sid="2KI 3:27" />他就把要接替他作王的長子帶來，在城牆上獻為燔祭。這時有極大的震怒臨到<char style="pn">以色列</char>，他們就從那裡撤退，回自己的地方去了。<verse eid="2KI 3:27" /></para>
  <chapter eid="2KI 3" />
  <chapter number="4" style="c" sid="2KI 4" />
  <para style="s">寡婦的油倍增</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 4:1" />有一個婦人，是先知團契中一個門徒的妻子，她向<char style="pn">以利沙</char>訴苦說：「你的僕人我丈夫死了，你知道你這僕人是敬畏耶和華的，現在有債主前來，要帶走我兩個孩子給他作奴僕。」<verse eid="2KI 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 4:2" />
    <char style="pn">以利沙</char>對她說：「我能為你做什麼呢？請告訴我，你家裡還有什麼？」</para>
  <para style="p" vid="2KI 4:2">她說：「婢女家裡除了一瓶油，什麼也沒有了。」<verse eid="2KI 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 4:3" />
    <char style="pn">以利沙</char>說：「你到外面去向所有的鄰居借罐子，要空罐子，不要少借。 <verse eid="2KI 4:3" /><verse number="4" style="v" sid="2KI 4:4" />然後你和兒子們回來，關上門<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">關上門——原文直譯「把身後的門關上」；5節和33節相同。</char></note>，把油倒進所有的罐子裡，倒滿的就放一邊。」 <verse eid="2KI 4:4" /><verse number="5" style="v" sid="2KI 4:5" />那婦人就離開<char style="pn">以利沙</char>去了。</para>
  <para style="p" vid="2KI 4:5">之後，她和兒子們關上門，兒子們不斷地遞給她罐子，她一個個倒滿。 <verse eid="2KI 4:5" /><verse number="6" style="v" sid="2KI 4:6" />罐子都倒滿了，她對兒子說：「再遞過來一個罐子！」兒子說：「沒有罐子了。」這時油就停了。<verse eid="2KI 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 4:7" />婦人來告訴神人，神人就說：「去把油賣了還債吧。剩餘的，你和兒子們可以靠著生活。」<verse eid="2KI 4:7" /></para>
  <para style="s">書念婦人接待以利沙</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 4:8" />有一天，<char style="pn">以利沙</char>路過<char style="pn">書念</char>，那裡有一個貴婦人留他吃飯。此後，<char style="pn">以利沙</char>每次經過時，都會轉到她家去吃飯。 <verse eid="2KI 4:8" /><verse number="9" style="v" sid="2KI 4:9" />那婦人對丈夫說：「你看，那位常從我們這裡經過的人，我認出他是個聖潔的神人。 <verse eid="2KI 4:9" /><verse number="10" style="v" sid="2KI 4:10" />我們在樓上做個小隔間吧，給他放一張床，還有桌、椅、燈臺。他來我們這裡的時候，可以過來住在那裡。」<verse eid="2KI 4:10" /></para>
  <para style="s">書念婦人的兒子</para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 4:11" />這一天，<char style="pn">以利沙</char>過來了，就到樓上去躺下。 <verse eid="2KI 4:11" /><verse number="12" style="v" sid="2KI 4:12" />他吩咐僕人<char style="pn">基哈西</char>說：「你去叫來這位<char style="pn">書念</char>婦人。」<char style="pn">基哈西</char>把她叫來，她就站在<char style="pn">以利沙</char>門前<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">門前——原文直譯「面前」。</char></note>。<verse eid="2KI 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 4:13" />
    <char style="pn">以利沙</char>吩咐僕人：「你問她：看哪，你為我們費了這一切心思，我能為你做些什麼呢？你有什麼事要我替你向王或將領提說嗎？」</para>
  <para style="p" vid="2KI 4:13">她回答：「我在族人當中安居無憂。」<verse eid="2KI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 4:14" />
    <char style="pn">以利沙</char>問：「那還有什麼能為她做的嗎？」</para>
  <para style="p" vid="2KI 4:14">
    <char style="pn">基哈西</char>說：「對了，她沒有孩子，而她丈夫已經老了。」<verse eid="2KI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 4:15" />於是<char style="pn">以利沙</char>說：「叫她過來。」<char style="pn">基哈西</char>把她叫過來，她就站在門口。 <verse eid="2KI 4:15" /><verse number="16" style="v" sid="2KI 4:16" /><char style="pn">以利沙</char>說：「在所定的日期，大約明年這時候，你必懷抱一個兒子。」</para>
  <para style="p" vid="2KI 4:16">她說：「不，我主，神人哪，不要哄騙你的婢女。」<verse eid="2KI 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 4:17" />那婦人果然懷孕了，到了第二年，在所定的日期生下一個兒子，正如<char style="pn">以利沙</char>告訴她的。<verse eid="2KI 4:17" /></para>
  <para style="s">書念婦人的兒子復生</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 4:18" />那孩子長大了，有一天他出去，到收割的人那裡找他父親。 <verse eid="2KI 4:18" /><verse number="19" style="v" sid="2KI 4:19" />他忽然對父親說：「我的頭！我的頭！」</para>
  <para style="p" vid="2KI 4:19">他父親吩咐僕人：「把他抱到他母親那裡去。」 <verse eid="2KI 4:19" /><verse number="20" style="v" sid="2KI 4:20" />僕人抱著孩子，把他帶到他母親那裡去。孩子坐在母親的膝上，到了中午就死了。 <verse eid="2KI 4:20" /><verse number="21" style="v" sid="2KI 4:21" />婦人就上樓，把他放在神人的床上，然後關上門出去了。<verse eid="2KI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 4:22" />她呼喚她的丈夫，說：「請給我派來一個僕人和一頭驢，我要趕快去神人那裡，很快就回來。」<verse eid="2KI 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 4:23" />丈夫問：「你為什麼要今天去他那裡呢？今天既不是新月節，也不是安息日。」</para>
  <para style="p" vid="2KI 4:23">她回答：「請放心。」<verse eid="2KI 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 4:24" />她給驢子備好鞍，對僕人說：「牽著走吧！不要為我放慢速度，除非我吩咐你。」 <verse eid="2KI 4:24" /><verse number="25" style="v" sid="2KI 4:25" />於是她出發，來到<char style="pn">迦密</char>山，到了神人那裡。</para>
  <para style="p" vid="2KI 4:25">當神人從對面看見她，就對僕人<char style="pn">基哈西</char>說：「看，是那位<char style="pn">書念</char>婦人。 <verse eid="2KI 4:25" /><verse number="26" style="v" sid="2KI 4:26" />你現在趕快去迎接她，問她：『你平安嗎？你丈夫平安嗎？孩子平安嗎？』」</para>
  <para style="p" vid="2KI 4:26">那婦人回答：「平安！」<verse eid="2KI 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 4:27" />婦人來到山上神人那裡，就抱住他的腳。<char style="pn">基哈西</char>過去要推開她，神人說：「由她吧，她心中實在苦痛。耶和華向我隱藏了這事，沒有告訴我。」<verse eid="2KI 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 4:28" />婦人說：「我向我主求過孩子嗎？我難道不是說過『不要哄騙我』嗎？」<verse eid="2KI 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 4:29" />
    <char style="pn">以利沙</char>就對<char style="pn">基哈西</char>說：「你束上腰，手裡拿著我的杖前去。如果遇到什麼人，不要向他問安；如果有人向你問安，你也不要回應。你要把我的杖放在孩子臉上。」<verse eid="2KI 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 4:30" />但孩子的母親說：「我指著耶和華的永生和你的生命起誓：我絕不離開你。」<char style="pn">以利沙</char>就起身，跟著她去了。<verse eid="2KI 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 4:31" />
    <char style="pn">基哈西</char>在他們前面先到，把杖放在孩子臉上，但孩子沒有動靜，沒有反應。<char style="pn">基哈西</char>回去迎見<char style="pn">以利沙</char>，就告訴他說：「孩子沒有醒來。」<verse eid="2KI 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 4:32" />
    <char style="pn">以利沙</char>來到婦人家裡，看見孩子死了，躺在<char style="pn">以利沙</char>床上。 <verse eid="2KI 4:32" /><verse number="33" style="v" sid="2KI 4:33" />他進去後關上門，只有自己和孩子二人在裡面，他就向耶和華禱告。 <verse eid="2KI 4:33" /><verse number="34" style="v" sid="2KI 4:34" />然後他過去伏在孩子身上，口對著口，眼對著眼，手對著手；他伏在孩子身上，孩子的身體就暖和起來。 <verse eid="2KI 4:34" /><verse number="35" style="v" sid="2KI 4:35" />他起身在房屋裡來回走了一次，然後過去再伏在孩子身上。孩子打了七次噴嚏，就睜開眼睛了。<verse eid="2KI 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 4:36" />
    <char style="pn">以利沙</char>呼喚<char style="pn">基哈西</char>說：「你把那位<char style="pn">書念</char>婦人叫來。」<char style="pn">基哈西</char>去叫她，她就來了。<char style="pn">以利沙</char>說：「把你兒子抱走吧！」 <verse eid="2KI 4:36" /><verse number="37" style="v" sid="2KI 4:37" />她就進來，在<char style="pn">以利沙</char>腳前俯伏於地下拜，然後抱起她的兒子出去了。<verse eid="2KI 4:37" /></para>
  <para style="s">麵粉解毒</para>
  <para style="p">
    <verse number="38" style="v" sid="2KI 4:38" />
    <char style="pn">以利沙</char>回到<char style="pn">吉甲</char>，那地正有饑荒。先知團契的門徒坐在他面前，他吩咐他的僕人說：「放上大鍋，給先知門徒們煮一些湯。」<verse eid="2KI 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2KI 4:39" />有一個人出去，到田間采摘野菜。他發現了一株野瓜藤，從藤上採下滿滿一兜野瓜，帶回來切碎了放進湯鍋裡，不過沒有人知道那是什麼瓜。<verse eid="2KI 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2KI 4:40" />他們把湯舀出來給大家吃，正在吃的時候，有人呼叫：「神人哪，鍋裡有毒<note caller="+" style="f"><char style="fr" closed="false">4:40 </char><char style="ft" closed="false">毒——原文直譯「死」。</char></note>！」這樣大家就不能再吃了。<verse eid="2KI 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2KI 4:41" />
    <char style="pn">以利沙</char>說：「拿點麵粉來。」他把麵粉撒在鍋裡，然後說：「舀給大家吃吧。」鍋裡就沒有毒了。<verse eid="2KI 4:41" /></para>
  <para style="s">麥餅倍增</para>
  <para style="p">
    <verse number="42" style="v" sid="2KI 4:42" />有一個人從<char style="pn">巴力沙利沙</char>來，給神人帶來了初熟大麥做的餅二十張和一袋新穗子。神人說：「把這些分給大家吃吧。」<verse eid="2KI 4:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2KI 4:43" />他的侍從問：「我怎麼能把這些分給一百個人呢？」</para>
  <para style="p" vid="2KI 4:43">但<char style="pn">以利沙</char>回答：「你只管分給大家吃，因為耶和華如此說：都吃了還有剩餘！」 <verse eid="2KI 4:43" /><verse number="44" style="v" sid="2KI 4:44" />於是僕人擺在大家面前，他們都吃了，並且還有剩餘，正如耶和華所說的。<verse eid="2KI 4:44" /></para>
  <chapter eid="2KI 4" />
  <chapter number="5" style="c" sid="2KI 5" />
  <para style="s">奈曼的痲瘋得痊癒</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 5:1" />
    <char style="pn">亞蘭</char>王的元帥<char style="pn">奈曼</char>在主人面前是個重要的人，很受尊重，因為耶和華曾藉著他賜予<char style="pn">亞蘭</char>人勝利。這人是個英勇的戰士，卻患了痲瘋。<verse eid="2KI 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 5:2" />
    <char style="pn">亞蘭</char>人的一支劫掠隊出征，從<char style="pn">以色列</char>地擄回來一個少女，這少女就在<char style="pn">奈曼</char>的妻子面前侍候。 <verse eid="2KI 5:2" /><verse number="3" style="v" sid="2KI 5:3" />她對主母說：「真希望主人能去見那位在<char style="pn">撒瑪利亞</char>的先知，他一定會治好主人的痲瘋。」<verse eid="2KI 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 5:4" />
    <char style="pn">奈曼</char>就去稟告他的主人說：「來自<char style="pn">以色列</char>地的一個少女如此如此說。」 <verse eid="2KI 5:4" /><verse number="5" style="v" sid="2KI 5:5" /><char style="pn">亞蘭</char>王說：「你儘管去吧！我也送一封書信給<char style="pn">以色列</char>王。」</para>
  <para style="p" vid="2KI 5:5">於是<char style="pn">奈曼</char>去了，手上帶了十他連得<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">十他連得—— 相當於342公斤。1他連得=34.2公斤。</char></note>銀子、六千謝克爾<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">六千謝克爾——相當於68.4公斤。1謝克爾=11.4公克。</char></note>金子和十套服裝。 <verse eid="2KI 5:5" /><verse number="6" style="v" sid="2KI 5:6" />他把書信帶給<char style="pn">以色列</char>王，信中說：</para>
  <para style="mi" vid="2KI 5:6">「如今，這封書信到達你那裡時，看哪，我已經派遣我的臣僕<char style="pn">奈曼</char>到你那裡。你要治好他的痲瘋。」<verse eid="2KI 5:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="2KI 5:7" />
    <char style="pn">以色列</char>王讀了那封信，就撕裂衣服，說：「難道我是神，能使人死、使人活嗎？這人竟送信到我這裡，要我治好一個人的痲瘋。請你們想想看，他一定是在尋隙攻擊我！」<verse eid="2KI 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 5:8" />神人<char style="pn">以利沙</char>聽說<char style="pn">以色列</char>王撕裂衣服，就派人到王那裡說：「為什麼撕裂你的衣服呢？請那個人到我這裡來吧，他將會知道：<char style="pn">以色列</char>有先知。」 <verse eid="2KI 5:8" /><verse number="9" style="v" sid="2KI 5:9" />於是<char style="pn">奈曼</char>乘著他的車馬來了，站在<char style="pn">以利沙</char>的家門口。<verse eid="2KI 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 5:10" />
    <char style="pn">以利沙</char>派了一位使者去見他，說：「你去<char style="pn">約旦</char>河裡洗七次，皮肉就會復原，你就會得潔淨。」<verse eid="2KI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 5:11" />
    <char style="pn">奈曼</char>卻憤怒地離去，說：「看哪，我還以為他一定會出來，站在那裡呼求他的神耶和華的名，對著患處搖手，治好這痲瘋。 <verse eid="2KI 5:11" /><verse number="12" style="v" sid="2KI 5:12" />難道<char style="pn">大馬士革</char>的<char style="pn">亞巴拿</char>河、<char style="pn">帕珥帕</char>河不比<char style="pn">以色列</char>任何水流更好嗎？我就不能在那些河裡洗自己得潔淨嗎？」於是他轉身，在怒火中離去。<verse eid="2KI 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 5:13" />那時他的僕人們上前去，勸他說：「主人哪，如果先知吩咐你一件大事，難道你會不做嗎？更何況他吩咐你去洗自己得潔淨！」 <verse eid="2KI 5:13" /><verse number="14" style="v" sid="2KI 5:14" /><char style="pn">奈曼</char>就下去，照著神人的話浸入<char style="pn">約旦</char>河七次。他的皮肉就復原，像小孩子的皮肉那樣，他就得了潔淨。<verse eid="2KI 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 5:15" />
    <char style="pn">奈曼</char>帶著所有隨從回到神人那裡，進來站在<char style="pn">以利沙</char>面前，說：「看哪，現在我明白了：除了在<char style="pn">以色列</char>，全地都沒有神。現在請你收下僕人的禮物。」<verse eid="2KI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 5:16" />
    <char style="pn">以利沙</char>說：「我指著我所事奉的耶和華的永生起誓：我不收。」<char style="pn">奈曼</char>再三勸他收下，<char style="pn">以利沙</char>還是拒絕了。<verse eid="2KI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 5:17" />
    <char style="pn">奈曼</char>說：「不然，就請賜給你僕人兩頭騾子能馱的土吧。因為除了向耶和華以外，你的僕人絕不再向任何神明獻上燔祭或祭物了。 <verse eid="2KI 5:17" /><verse number="18" style="v" sid="2KI 5:18" />還有一件事，唯願耶和華赦免你的僕人：我主人進<char style="pn">臨門</char>廟下拜時，扶著我的手臂，因而我也在<char style="pn">臨門</char>廟下拜了。對於我在<char style="pn">臨門</char>廟下拜這件事，求耶和華赦免你的僕人。」<verse eid="2KI 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 5:19" />
    <char style="pn">以利沙</char>對他說：「平平安安地回去吧。」</para>
  <para style="s" vid="2KI 5:19">基哈西貪財受懲罰</para>
  <para style="p" vid="2KI 5:19">
    <char style="pn">奈曼</char>離開<char style="pn">以利沙</char>，走了一段路， <verse eid="2KI 5:19" /><verse number="20" style="v" sid="2KI 5:20" />神人<char style="pn">以利沙</char>的僕人<char style="pn">基哈西</char>心裡說：「看哪，我主人竟然放過了這<char style="pn">亞蘭</char>人<char style="pn">奈曼</char>，沒有從他手中收取他所帶來的。我指著耶和華的永生起誓：我一定要跑去追上他，從他那裡拿一些。」<verse eid="2KI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 5:21" />於是<char style="pn">基哈西</char>去追趕<char style="pn">奈曼</char>。<char style="pn">奈曼</char>看見有人從後面跑來，就從馬車下來迎接他，問：「平安嗎？」<verse eid="2KI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 5:22" />
    <char style="pn">基哈西</char>說：「平安！我主人派我來說：『看哪，現在有先知團契的兩個年輕門徒從<char style="pn">以法蓮</char>山地來見我，請你給他們一他連得<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">一他連得——相當於34.2公斤。</char></note>銀子和兩套服裝。』」<verse eid="2KI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 5:23" />
    <char style="pn">奈曼</char>說：「請收下兩他連得<note caller="+" style="f"><char style="fr" closed="false">5:23 </char><char style="ft" closed="false">兩他連得——相當於68.4公斤；下同。</char></note>銀子。」他再三勸<char style="pn">基哈西</char>，然後把兩他連得銀子裝在兩個袋子裡，連同兩套服裝交給兩個僕人，他們就在<char style="pn">基哈西</char>前面抬去了。 <verse eid="2KI 5:23" /><verse number="24" style="v" sid="2KI 5:24" />到了山岡，<char style="pn">基哈西</char>從他們手中接過來東西，放進屋子，然後送他們走，他們就回去了。<verse eid="2KI 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 5:25" />
    <char style="pn">基哈西</char>進來站在他主人面前，<char style="pn">以利沙</char>問他：「<char style="pn">基哈西</char>，你去了哪裡？」他說：「僕人哪裡也沒去。」<verse eid="2KI 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 5:26" />但<char style="pn">以利沙</char>對他說：「那人下車轉回迎接你時，我的心不是也去了嗎？這是接受銀子的時候嗎？是接受衣服、橄欖園、葡萄園、牛羊、僕婢的時候嗎？ <verse eid="2KI 5:26" /><verse number="27" style="v" sid="2KI 5:27" />因此，<char style="pn">奈曼</char>的痲瘋必永遠沾上你和你的後裔。」於是<char style="pn">基哈西</char>患上痲瘋，蒼白如雪，從<char style="pn">以利沙</char>面前離開了。<verse eid="2KI 5:27" /></para>
  <chapter eid="2KI 5" />
  <chapter number="6" style="c" sid="2KI 6" />
  <para style="s">斧頭浮出水面</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 6:1" />先知團契的門徒對<char style="pn">以利沙</char>說：「請看，我們與你居住<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">與你居住——或譯作「在你面前相聚」。</char></note>的地方太擠了。 <verse eid="2KI 6:1" /><verse number="2" style="v" sid="2KI 6:2" />請讓我們去<char style="pn">約旦</char>河邊，各人從那裡取一根木材，為我們在那裡蓋一個居住的地方。」</para>
  <para style="p" vid="2KI 6:2">
    <char style="pn">以利沙</char>說：「你們去吧！」<verse eid="2KI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 6:3" />有一個人說：「請你與僕人們一起去。」</para>
  <para style="p" vid="2KI 6:3">他說：「我會去的。」<verse eid="2KI 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 6:4" />於是<char style="pn">以利沙</char>與他們一起去了。他們來到<char style="pn">約旦</char>河邊，砍伐樹木。 <verse eid="2KI 6:4" /><verse number="5" style="v" sid="2KI 6:5" />有一個人正在砍伐木材的時候，斧頭掉進水裡了，他呼叫說：「唉，我主啊！那可是借來的。」<verse eid="2KI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 6:6" />神人問：「斧頭掉哪裡了？」</para>
  <para style="p" vid="2KI 6:6">他把那地方指給<char style="pn">以利沙</char>看。<char style="pn">以利沙</char>就砍了一根木頭，扔在那地方，使鐵器浮了上來。 <verse eid="2KI 6:6" /><verse number="7" style="v" sid="2KI 6:7" /><char style="pn">以利沙</char>說：「你拿起來吧。」他就伸手取回斧頭。<verse eid="2KI 6:7" /></para>
  <para style="s">亞蘭與以色列作戰</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 6:8" />
    <char style="pn">亞蘭</char>王與<char style="pn">以色列</char>作戰時，<char style="pn">亞蘭</char>王和他的臣僕們商議說：「要在某某地方紮營。」<verse eid="2KI 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 6:9" />神人派人去<char style="pn">以色列</char>王那裡說：「經過某某地方時要小心，因為<char style="pn">亞蘭</char>人會從那裡下來。」 <verse eid="2KI 6:9" /><verse number="10" style="v" sid="2KI 6:10" /><char style="pn">以色列</char>王就派人到神人所說的地方。神人警告王，王就在那裡防備，這樣不止一兩次。<verse eid="2KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 6:11" />
    <char style="pn">亞蘭</char>王為這事心裡翻騰不安，他召來臣僕，對他們說：「我們中間是誰在幫<char style="pn">以色列</char>王，你們不告訴我嗎？」<verse eid="2KI 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 6:12" />有一個臣僕說：「不，我主我王，是<char style="pn">以色列</char>的先知<char style="pn">以利沙</char>，他把你在臥室所說的話都報告給<char style="pn">以色列</char>王。」<verse eid="2KI 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 6:13" />王吩咐：「你們去察看他在哪裡，我好派人去捉拿他！」</para>
  <para style="p" vid="2KI 6:13">於是，有人稟告王說：「看哪，他在<char style="pn">多坍</char>。」 <verse eid="2KI 6:13" /><verse number="14" style="v" sid="2KI 6:14" />王就派去戰車馬匹和一支大軍到那裡。他們夜間前來包圍了那城。<verse eid="2KI 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 6:15" />神人的侍從清早起來出去，看哪，有一支軍隊連同戰車馬匹，圍困了那城。那僕人就對神人說：「唉，我主啊！我們怎麼辦呢？」<verse eid="2KI 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 6:16" />
    <char style="pn">以利沙</char>說：「不要害怕，因為與我們同在的比與他們同在的更多。」<verse eid="2KI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 6:17" />隨後，<char style="pn">以利沙</char>禱告說：「耶和華啊，求你打開他的眼睛，使他看見。」耶和華打開那僕人的眼睛，他就看見了，看哪，山上布滿了火戰馬、火戰車，圍繞著<char style="pn">以利沙</char>。<verse eid="2KI 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 6:18" />
    <char style="pn">亞蘭</char>人下到<char style="pn">以利沙</char>那裡，<char style="pn">以利沙</char>向耶和華禱告說：「求你打擊這民，使他們眼睛失明。」耶和華就照著<char style="pn">以利沙</char>的請求打擊了他們，使他們眼睛失明。 <verse eid="2KI 6:18" /><verse number="19" style="v" sid="2KI 6:19" />於是<char style="pn">以利沙</char>對他們說：「不是這條路，也不是這座城。你們跟著我走吧！我帶你們到你們找的人那裡去。」這樣，<char style="pn">以利沙</char>帶他們往<char style="pn">撒瑪利亞</char>去。 <verse eid="2KI 6:19" /><verse number="20" style="v" sid="2KI 6:20" />當他們來到<char style="pn">撒瑪利亞</char>，<char style="pn">以利沙</char>就說：「耶和華啊，求你打開這些人的眼睛，使他們看見。」耶和華打開他們的眼睛，他們就看見了，看哪，竟然在<char style="pn">撒瑪利亞</char>城中！<verse eid="2KI 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 6:21" />
    <char style="pn">以色列</char>王看見了他們就問<char style="pn">以利沙</char>：「我父啊，我可以殺<note caller="+" style="f"><char style="fr" closed="false">6:21 </char><char style="ft" closed="false">殺——該動詞在馬索拉文本裡有重複。</char></note>他們嗎？」<verse eid="2KI 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 6:22" />
    <char style="pn">以利沙</char>說：「不要殺！你用刀用弓擄回來的人，難道你會殺掉嗎？你要在他們面前擺上餅和水，讓他們吃喝，然後讓他們回他們主人那裡去。」<verse eid="2KI 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 6:23" />王就為他們擺設盛大的筵席，讓他們吃喝，然後送他們回主人那裡去。於是，<char style="pn">亞蘭</char>的劫掠隊不再入侵<char style="pn">以色列</char>地了。<verse eid="2KI 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 6:24" />此後，<char style="pn">亞蘭</char>王<char style="pn">本哈達</char>招聚他的全軍，上來圍攻<char style="pn">撒瑪利亞</char>。 <verse eid="2KI 6:24" /><verse number="25" style="v" sid="2KI 6:25" />於是<char style="pn">撒瑪利亞</char>城內有了大饑荒；看哪，他們持久圍困這城，以致一個驢頭值八十謝克爾<note caller="+" style="f"><char style="fr" closed="false">6:25 </char><char style="ft" closed="false">八十謝克爾——相當於912公克。1謝克爾=11.4公克。</char></note>銀子，四分之一公升<note caller="+" style="f"><char style="fr" closed="false">6:25 </char><char style="ft" closed="false">公升——原文作「喀伯」；1喀伯=1.2公升。</char></note>鴿子糞值五謝克爾<note caller="+" style="f"><char style="fr" closed="false">6:25 </char><char style="ft" closed="false">五謝克爾——相當於57公克。1謝克爾=11.4公克。</char></note>銀子。<verse eid="2KI 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 6:26" />
    <char style="pn">以色列</char>王在城牆上經過的時候，有一個婦人向他呼叫說：「我主我王啊，求你救助！」<verse eid="2KI 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 6:27" />王說：「如果耶和華不救助你<note caller="+" style="f"><char style="fr" closed="false">6:27 </char><char style="ft" closed="false">如果耶和華不救助你——或譯作「不，願耶和華救助你」。</char></note>，我還能從哪裡給你帶來救助？難道是從打穀場，或者從榨酒池嗎？」 <verse eid="2KI 6:27" /><verse number="28" style="v" sid="2KI 6:28" />王又對婦人說：「你有什麼事呢？」</para>
  <para style="p" vid="2KI 6:28">她說：「那個婦人對我說：『把你的兒子交出來，讓我們今天吃了吧，明天再吃我的兒子。』 <verse eid="2KI 6:28" /><verse number="29" style="v" sid="2KI 6:29" />我們就把我的兒子煮了吃了。第二天，我對她說：『把你的兒子交出來，讓我們吃了吧。』她卻把她的兒子藏起來了。」<verse eid="2KI 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 6:30" />王聽了這婦人的話，就撕裂衣服。當時王在城牆上經過，人們都看見了，看哪，王裡面貼身穿著麻衣。 <verse eid="2KI 6:30" /><verse number="31" style="v" sid="2KI 6:31" />王說：「今天如果<char style="pn">沙法</char>之子<char style="pn">以利沙</char>的頭顱還留在他身上，就願神處置我，重重地處置我！」<verse eid="2KI 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 6:32" />那時，<char style="pn">以利沙</char>正在家裡坐著，長老們與他坐在一起。王派了一個人在他前面先去，這使者還沒有來到<char style="pn">以利沙</char>那裡，<char style="pn">以利沙</char>就對長老們說：「你們看見了嗎，那個殺人者派人來砍我的頭了！你們注意，當使者來到時，你們要關上門，把他擋在門外。他後面不就是他主人的腳步聲嗎？」<verse eid="2KI 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 6:33" />
    <char style="pn">以利沙</char>還在與他們說話的時候，那使者下來，到了他那裡，說：「看哪，這禍患來自耶和華，我何必期盼耶和華呢？」<verse eid="2KI 6:33" /></para>
  <chapter eid="2KI 6" />
  <chapter number="7" style="c" sid="2KI 7" />
  <para style="s">亞蘭軍隊逃走</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 7:1" />
    <char style="pn">以利沙</char>說：「你們要聽耶和華的話語！耶和華如此說：『明天大約這個時候，在<char style="pn">撒瑪利亞</char>城門口，一斗<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">斗——原文作「細亞」；下同。1細亞=7.3公升。</char></note>細麵粉值一謝克爾<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">一謝克爾——相當於11.4公克銀子；下同。</char></note>，二斗大麥值一謝克爾。』」<verse eid="2KI 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 7:2" />有一個攙扶王的<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">攙扶王的——原文直譯「王扶在他手臂上的」；或譯作「王所依靠的」。</char></note>軍官回應神人說：「看哪，就算耶和華在天上開了窗，這樣的事能發生嗎？」</para>
  <para style="p" vid="2KI 7:2">
    <char style="pn">以利沙</char>就說：「看哪，你必親眼看見，卻吃不到。」<verse eid="2KI 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 7:3" />城門口有四個患痲瘋的人，他們彼此說：「我們為什麼坐在這裡等死呢？ <verse eid="2KI 7:3" /><verse number="4" style="v" sid="2KI 7:4" />我們如果說要進城去，城裡卻有饑荒，我們必死在那裡；我們如果坐在這裡，也必死。所以，我們還是到<char style="pn">亞蘭</char>人的軍營投降吧。如果他們讓我們活，我們就活著；如果他們處死我們，我們就死吧。」<verse eid="2KI 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 7:5" />於是他們在黃昏的時候動身去<char style="pn">亞蘭</char>人的軍營。當他們來到<char style="pn">亞蘭</char>人軍營的邊緣，看哪，那裡連一個人都沒有！ <verse eid="2KI 7:5" /><verse number="6" style="v" sid="2KI 7:6" />原來主使<char style="pn">亞蘭</char>人的軍隊聽到戰車馬匹的聲音以及大軍的聲音，他們就彼此說：「看哪，<char style="pn">以色列</char>王雇用了<char style="pn">赫提</char>眾王和<char style="pn">埃及</char>眾王來攻擊我們。」 <verse eid="2KI 7:6" /><verse number="7" style="v" sid="2KI 7:7" />於是，他們在黃昏的時候起身逃跑，撇棄他們的帳篷、馬匹、驢子，保持營地原樣，逃命去了。<verse eid="2KI 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 7:8" />這幾個患痲瘋的人來到營地邊，進入一個帳篷，吃了喝了，又從那裡拿走金銀和衣服，去藏起來。然後回去，進入另外一個帳篷，也從那裡帶走財物，去藏起來。 <verse eid="2KI 7:8" /><verse number="9" style="v" sid="2KI 7:9" />過後，他們彼此說：「我們這樣做不對，今天是有好消息的日子，我們卻不作聲！這樣等到明早天亮，罪孽必臨到我們。現在我們走吧，向王宮報信去！」<verse eid="2KI 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 7:10" />他們就去向城門的守衛呼喊，報告他們說：「我們去了<char style="pn">亞蘭</char>人的營地，看哪，那裡沒有一個人，也沒有人聲，只有拴著的馬匹、驢子，帳篷都保持原樣。」 <verse eid="2KI 7:10" /><verse number="11" style="v" sid="2KI 7:11" />守衛呼喊，有人就向王宮內報信。<verse eid="2KI 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 7:12" />於是王夜間起來，對臣僕們說：「讓我告訴你們<char style="pn">亞蘭</char>人要對我們做什麼：他們知道我們飢餓，所以離開營地隱藏在田野裡，說：『當他們從城裡出來時，我們就活捉他們，攻進城裡。』」<verse eid="2KI 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 7:13" />但他的一個臣僕回應說：「請吩咐人從城裡殘留的那些剩餘戰馬中取出五匹，派人去察看。反正那些馬像<char style="pn">以色列</char>的所有民眾一樣<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">那些馬像以色列的所有民眾一樣——此句在馬索拉文本裡有重複。</char></note>要死光了！」<verse eid="2KI 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 7:14" />於是，他們取出兩套戰車和馬匹，王就派人去追蹤<char style="pn">亞蘭</char>人的軍隊，說：「你們去察看吧！」 <verse eid="2KI 7:14" /><verse number="15" style="v" sid="2KI 7:15" />他們追蹤<char style="pn">亞蘭</char>人的軍隊，直到<char style="pn">約旦</char>河。看哪，一路上滿地都是<char style="pn">亞蘭</char>人慌亂中扔下的衣服和兵器。使者們回來稟告王， <verse eid="2KI 7:15" /><verse number="16" style="v" sid="2KI 7:16" />民眾就出來掠奪<char style="pn">亞蘭</char>人的軍營。</para>
  <para style="p" vid="2KI 7:16">於是一斗細麵粉值一謝克爾，二斗大麥值一謝克爾，正如耶和華所說的。 <verse eid="2KI 7:16" /><verse number="17" style="v" sid="2KI 7:17" />王指派那個攙扶他的<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false">攙扶他的——原文直譯「他扶在手臂上的」；或譯作「他所依靠的」。</char></note>軍官去管控城門口，民眾卻在城門口把他踩死了，正如神人所說的，就是王下來見他的時候他所宣告的。 <verse eid="2KI 7:17" /><verse number="18" style="v" sid="2KI 7:18" />當時神人向王宣告說：「明天大約這個時候，在<char style="pn">撒瑪利亞</char>城門口，二斗大麥值一謝克爾，一斗細麵粉值一謝克爾。」 <verse eid="2KI 7:18" /><verse number="19" style="v" sid="2KI 7:19" />但那個軍官回應神人說：「看哪，就算耶和華在天上開了窗，這樣的事能發生嗎？」<char style="pn">以利沙</char>就說：「看哪，你必親眼看見，卻吃不到。」 <verse eid="2KI 7:19" /><verse number="20" style="v" sid="2KI 7:20" />事情果然發生在他身上，民眾在城門口把他踩死了。<verse eid="2KI 7:20" /></para>
  <chapter eid="2KI 7" />
  <chapter number="8" style="c" sid="2KI 8" />
  <para style="s">書念婦人得回土地</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 8:1" />
    <char style="pn">以利沙</char>對那位被他救活兒子的婦人說：「你要和你全家起身離開這裡，去暫住在你可以寄居的地方，因為耶和華已經宣告了饑荒，而且饑荒要降在這地七年。」<verse eid="2KI 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 8:2" />婦人就起身，照著神人的話去做。她和她全家前往<char style="pn">非利士</char>人之地寄居了七年。 <verse eid="2KI 8:2" /><verse number="3" style="v" sid="2KI 8:3" />過了七年，婦人從<char style="pn">非利士</char>人之地回來，就去為自己的房屋和田地向王求助。<verse eid="2KI 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 8:4" />那時王正與神人的僕人<char style="pn">基哈西</char>交談，王說：「請你給我講述一下<char style="pn">以利沙</char>所做的一切大事！」<verse eid="2KI 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 8:5" />
    <char style="pn">基哈西</char>正在給王講述<char style="pn">以利沙</char>如何使死人復活，看哪，被<char style="pn">以利沙</char>救活兒子的那位婦人，來為她的房屋和田地向王求助。<char style="pn">基哈西</char>說：「我主我王啊，這就是那位婦人，這就是被<char style="pn">以利沙</char>救活的她的兒子。」<verse eid="2KI 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 8:6" />王詢問那婦人，她就給王講述了這件事。於是王為她指派了一個內臣，說：「把所有屬於她的，包括從她離開本地那天到現在田地的所有出產，都歸還給她。」<verse eid="2KI 8:6" /></para>
  <para style="s">哈薛篡奪亞蘭王位</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 8:7" />
    <char style="pn">以利沙</char>來到<char style="pn">大馬士革</char>，那時<char style="pn">亞蘭</char>王<char style="pn">本哈達</char>正患病；有人稟告王說：「神人到這裡來了。」 <verse eid="2KI 8:7" /><verse number="8" style="v" sid="2KI 8:8" />王就吩咐<char style="pn">哈薛</char>：「你手上帶些禮物去迎接神人，託他求問耶和華，我是否能從這病中康復？」<verse eid="2KI 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 8:9" />於是<char style="pn">哈薛</char>去迎接<char style="pn">以利沙</char>，手上帶著禮物——四十頭駱駝載著<char style="pn">大馬士革</char>的各樣美物。他來站在<char style="pn">以利沙</char>面前，說：「你的孩子<char style="pn">亞蘭</char>王<char style="pn">本哈達</char>派我到你這裡，他問：『我是否能從這病中康復？』」<verse eid="2KI 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 8:10" />
    <char style="pn">以利沙</char>回答：「你去告訴他：『你一定會康復。』不過耶和華已經向我指明：他必定死。」 <verse eid="2KI 8:10" /><verse number="11" style="v" sid="2KI 8:11" /><char style="pn">以利沙</char>一直盯著<char style="pn">哈薛</char>的臉，直到他羞慚。</para>
  <para style="p" vid="2KI 8:11">然後神人哭了。 <verse eid="2KI 8:11" /><verse number="12" style="v" sid="2KI 8:12" /><char style="pn">哈薛</char>說：「我主為什麼哭呢？」</para>
  <para style="p" vid="2KI 8:12">
    <char style="pn">以利沙</char>回答：「因為我知道你將要加害<char style="pn">以色列</char>子民，放火燒毀他們的堡壘，用刀殺死他們的青年人，摔死他們的幼童，剖開他們的孕婦。」<verse eid="2KI 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 8:13" />
    <char style="pn">哈薛</char>說：「你的僕人算什麼，不過是一條狗！怎能做出這樣的大事呢？」</para>
  <para style="p" vid="2KI 8:13">
    <char style="pn">以利沙</char>回答說：「耶和華已經向我指明：你必作<char style="pn">亞蘭</char>的王。」<verse eid="2KI 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 8:14" />
    <char style="pn">哈薛</char>離開<char style="pn">以利沙</char>，回到他主人那裡。主人問：「<char style="pn">以利沙</char>對你說了什麼呢？」</para>
  <para style="p" vid="2KI 8:14">
    <char style="pn">哈薛</char>回答：「他對我說：你一定會康復。」 <verse eid="2KI 8:14" /><verse number="15" style="v" sid="2KI 8:15" />到了第二天，<char style="pn">哈薛</char>拿了一塊厚布浸在水裡，蒙住王的臉，王就死了。於是<char style="pn">哈薛</char>接替他作王。<verse eid="2KI 8:15" /></para>
  <para style="s">猶大王約蘭</para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 8:16" />
    <char style="pn">亞哈</char>的兒子<char style="pn">以色列</char>王<char style="pn">約蘭</char>在位第五年，<char style="pn">猶大</char>王<char style="pn">約沙法</char>的兒子<char style="pn">約蘭</char>作王，接續<note caller="+" style="f"><char style="fr" closed="false">8:16 </char><char style="ft" closed="false">接續——輔助詞語。</char></note><char style="pn">猶大</char>王<char style="pn">約沙法</char>。 <verse eid="2KI 8:16" /><verse number="17" style="v" sid="2KI 8:17" /><char style="pn">約蘭</char>作王的時候三十二歲，在<char style="pn">耶路撒冷</char>統治了八年。 <verse eid="2KI 8:17" /><verse number="18" style="v" sid="2KI 8:18" />他走<char style="pn">以色列</char>王的道路，像<char style="pn">亞哈</char>家所做的那樣，因為<char style="pn">亞哈</char>的女兒作了他的妻子；他做耶和華眼中看為惡的事。 <verse eid="2KI 8:18" /><verse number="19" style="v" sid="2KI 8:19" />但耶和華因他僕人<char style="pn">大衛</char>的緣故，就不願毀掉<char style="pn">猶大</char>，而要照著他的應許永遠賜給<char style="pn">大衛</char>和<char style="pn">大衛</char>的子孫一盞燈。<verse eid="2KI 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 8:20" />
    <char style="pn">約蘭</char>年間，<char style="pn">以東</char>反叛脫離<char style="pn">猶大</char>的掌控，立了自己的王。 <verse eid="2KI 8:20" /><verse number="21" style="v" sid="2KI 8:21" /><char style="pn">約蘭</char>就帶著他所有的戰車過去，前往<char style="pn">撒益</char>。他夜間起來，攻擊那些包圍他的<char style="pn">以東</char>人和眾戰車長，但他的軍兵都逃回自己的帳篷去了。 <verse eid="2KI 8:21" /><verse number="22" style="v" sid="2KI 8:22" />最終，<char style="pn">以東</char>反叛脫離了<char style="pn">猶大</char>的掌控，直到今日。<char style="pn">立拿</char>也在那時反叛了。<verse eid="2KI 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 8:23" />
    <char style="pn">約蘭</char>其餘的事蹟和他所做的一切，不是都記在《<char style="pn">猶大</char>諸王年代志》上嗎？ <verse eid="2KI 8:23" /><verse number="24" style="v" sid="2KI 8:24" /><char style="pn">約蘭</char>與他的列祖長眠，葬在<char style="pn">大衛</char>城，與他的列祖在一起；他的兒子<char style="pn">亞哈謝</char>接替他作王。<verse eid="2KI 8:24" /></para>
  <para style="s">猶大王亞哈謝</para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 8:25" />
    <char style="pn">亞哈</char>的兒子<char style="pn">以色列</char>王<char style="pn">約蘭</char>在位第十二年，<char style="pn">猶大</char>王<char style="pn">約蘭</char>的兒子<char style="pn">亞哈謝</char>作王。 <verse eid="2KI 8:25" /><verse number="26" style="v" sid="2KI 8:26" /><char style="pn">亞哈謝</char>作王的時候二十二歲，在<char style="pn">耶路撒冷</char>統治了一年。他的母親名叫<char style="pn">婭塔利雅</char>，是<char style="pn">以色列</char>王<char style="pn">歐姆利</char>的女兒。 <verse eid="2KI 8:26" /><verse number="27" style="v" sid="2KI 8:27" /><char style="pn">亞哈謝</char>走<char style="pn">亞哈</char>家的道路，做耶和華眼中看為惡的事，像<char style="pn">亞哈</char>家一樣，因為他是<char style="pn">亞哈</char>家的女婿。<verse eid="2KI 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 8:28" />
    <char style="pn">亞哈謝</char>隨同<char style="pn">亞哈</char>的兒子<char style="pn">約蘭</char>前往<char style="pn">拉末-基列</char>，與<char style="pn">亞蘭</char>王<char style="pn">哈薛</char>爭戰；<char style="pn">亞蘭</char>人打傷了<char style="pn">約蘭</char>。 <verse eid="2KI 8:28" /><verse number="29" style="v" sid="2KI 8:29" /><char style="pn">約蘭</char>王就回去，在<char style="pn">耶斯列</char>療傷，因為他在<char style="pn">拉瑪</char>與<char style="pn">亞蘭</char>王<char style="pn">哈薛</char>交戰時被<char style="pn">亞蘭</char>人打傷了。<char style="pn">猶大</char>王<char style="pn">約蘭</char>的兒子<char style="pn">亞哈謝</char>就下去，到<char style="pn">耶斯列</char>看望<char style="pn">亞哈</char>的兒子<char style="pn">約蘭</char>，因為他受了傷。<verse eid="2KI 8:29" /></para>
  <chapter eid="2KI 8" />
  <chapter number="9" style="c" sid="2KI 9" />
  <para style="s">耶戶受膏為以色列王</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 9:1" />先知<char style="pn">以利沙</char>叫來先知團契的一個門徒，對他說：「你束上腰，手中拿著這瓶膏油，到<char style="pn">拉末-基列</char>去。 <verse eid="2KI 9:1" /><verse number="2" style="v" sid="2KI 9:2" />到了那裡，你要找<char style="pn">寧示</char>的孫子、<char style="pn">約沙法</char>的兒子<char style="pn">耶戶</char>。你去請他從他兄弟們當中起來，把他帶到內室。 <verse eid="2KI 9:2" /><verse number="3" style="v" sid="2KI 9:3" />然後拿這瓶膏油澆在他頭上，說：『耶和華如此說：我膏立你為<char style="pn">以色列</char>的王。』然後開門就跑，不要耽延。」 <verse eid="2KI 9:3" /><verse number="4" style="v" sid="2KI 9:4" />於是那年輕的先知就往<char style="pn">拉末-基列</char>去了。<verse eid="2KI 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 9:5" />他到了那裡，看哪，將領們都坐著。他說：「我有話帶給你，長官。」</para>
  <para style="p" vid="2KI 9:5">
    <char style="pn">耶戶</char>問：「是給我們當中哪一位呢？」</para>
  <para style="p" vid="2KI 9:5">他回答：「給你，長官。」<verse eid="2KI 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 9:6" />
    <char style="pn">耶戶</char>就起來，進了屋子。那年輕人把膏油澆在<char style="pn">耶戶</char>頭上，對他說：「<char style="pn">以色列</char>的神耶和華如此說：</para>
  <para style="p" vid="2KI 9:6">『我已經膏立你為王治理耶和華的子民<char style="pn">以色列</char>。 <verse eid="2KI 9:6" /><verse number="7" style="v" sid="2KI 9:7" />你要擊殺你主人<char style="pn">亞哈</char>的全家，好讓我向<char style="pn">耶洗別</char>施行報復，因她下手流了我僕人眾先知的血，耶和華眾僕人的血。<verse eid="2KI 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="2KI 9:8" />
    <char style="pn">亞哈</char>全家都必滅亡；</para>
  <para style="q1" vid="2KI 9:8">
    <char style="pn">以色列</char>中凡屬<char style="pn">亞哈</char>的男丁<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">男丁——原文直譯「對著牆撒尿的」。</char></note>，</para>
  <para style="q1" vid="2KI 9:8">無論是為奴的還是自由的，</para>
  <para style="q1" vid="2KI 9:8">我都必剪除。<verse eid="2KI 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="2KI 9:9" />我要使<char style="pn">亞哈</char>家</para>
  <para style="q1" vid="2KI 9:9">像<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>的家，</para>
  <para style="q1" vid="2KI 9:9">又像<char style="pn">亞希雅</char>的兒子<char style="pn">巴沙</char>的家那樣。<verse eid="2KI 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="2KI 9:10" />至於<char style="pn">耶洗別</char>，</para>
  <para style="q1" vid="2KI 9:10">狗必在<char style="pn">耶斯列</char>的地界內吃掉她，</para>
  <para style="q1" vid="2KI 9:10">無人埋葬。』」</para>
  <para style="b" vid="2KI 9:10" />
  <para style="p" vid="2KI 9:10">然後，他開門就跑了。<verse eid="2KI 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 9:11" />
    <char style="pn">耶戶</char>出來，回到他主人的臣僕們那裡。他們問他：「一切平安嗎？這瘋子為什麼來見你呢？」</para>
  <para style="p" vid="2KI 9:11">他回答：「你們都了解這個人和他的胡話。」<verse eid="2KI 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 9:12" />他們說：「你糊弄人，請告訴我們吧！」</para>
  <para style="p" vid="2KI 9:12">他就說：「那人說這說那，還告訴我：『耶和華如此說：我膏立你為<char style="pn">以色列</char>的王。』」<verse eid="2KI 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 9:13" />他們就急忙各自脫下外衣鋪在<char style="pn">耶戶</char>腳前的臺階上，隨後吹響號角，說：「<char style="pn">耶戶</char>作王了！」<verse eid="2KI 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 9:14" />這樣，<char style="pn">寧示</char>的孫子、<char style="pn">約沙法</char>的兒子<char style="pn">耶戶</char>密謀反叛了<char style="pn">約蘭</char>。當時<char style="pn">約蘭</char>和全體<char style="pn">以色列</char>人正駐守在<char style="pn">拉末-基列</char>，抵抗<char style="pn">亞蘭</char>王<char style="pn">哈薛</char>。 <verse eid="2KI 9:14" /><verse number="15" style="v" sid="2KI 9:15" />後來<char style="pn">約蘭</char>王回來，在<char style="pn">耶斯列</char>療傷，他與<char style="pn">亞蘭</char>王<char style="pn">哈薛</char>交戰時被<char style="pn">亞蘭</char>人打傷了。<char style="pn">耶戶</char>說：「如果你們有心讓我作王<note caller="+" style="f"><char style="fr" closed="false">9:15 </char><char style="ft" closed="false">讓我作王——輔助詞語。</char></note>，就不要讓任何人逃脫出城，去<char style="pn">耶斯列</char>報信。」<verse eid="2KI 9:15" /></para>
  <para style="s">耶戶殺約蘭和亞哈謝</para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 9:16" />隨後<char style="pn">耶戶</char>乘上戰車往<char style="pn">耶斯列</char>去，因為<char style="pn">約蘭</char>正在那裡臥床養傷。那時<char style="pn">猶大</char>王<char style="pn">亞哈謝</char>已經下去看望他。 <verse eid="2KI 9:16" /><verse number="17" style="v" sid="2KI 9:17" />守望的人站在<char style="pn">耶斯列</char>的塔樓上，看見<char style="pn">耶戶</char>一群人來了，就說：「我看見有一群人！」</para>
  <para style="p" vid="2KI 9:17">
    <char style="pn">約蘭</char>說：「叫來一個騎兵，派去迎見他們，詢問是否平安。」<verse eid="2KI 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 9:18" />騎兵就去迎見<char style="pn">耶戶</char>，說：「王如此說：平安嗎？」</para>
  <para style="p" vid="2KI 9:18">
    <char style="pn">耶戶</char>說：「是否平安，與你有什麼相干？跟到我後面去！」</para>
  <para style="p" vid="2KI 9:18">守望的人報告說：「派去的人到了他們那裡，但沒有回來。」<verse eid="2KI 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 9:19" />王又派第二個騎兵去。他來到他們那裡，說：「王如此說：平安嗎？」</para>
  <para style="p" vid="2KI 9:19">
    <char style="pn">耶戶</char>說：「是否平安，與你有什麼相干？跟到我後面去！」<verse eid="2KI 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 9:20" />守望的人報告說：「派去的人到了他們那裡，但沒有回來。那駕車的像是<char style="pn">寧示</char>的孫子<char style="pn">耶戶</char>的駕車風格，駕得很瘋狂。」<verse eid="2KI 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 9:21" />於是<char style="pn">約蘭</char>吩咐：「備車！」有人就備好他的戰車。<char style="pn">以色列</char>王<char style="pn">約蘭</char>和<char style="pn">猶大</char>王<char style="pn">亞哈謝</char>各乘自己的戰車出發，出去迎見<char style="pn">耶戶</char>，在<char style="pn">耶斯列</char>人<char style="pn">拿伯</char>的那塊田地遇見了他。 <verse eid="2KI 9:21" /><verse number="22" style="v" sid="2KI 9:22" /><char style="pn">約蘭</char>看見<char style="pn">耶戶</char>，就說：「<char style="pn">耶戶</char>，平安嗎？」</para>
  <para style="p" vid="2KI 9:22">
    <char style="pn">耶戶</char>回答說：「你母親<char style="pn">耶洗別</char>的淫行和法術如此氾濫，怎麼會有平安呢？」<verse eid="2KI 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 9:23" />
    <char style="pn">約蘭</char>急忙調頭逃走，對<char style="pn">亞哈謝</char>說：「<char style="pn">亞哈謝</char>啊，他謀反了！」<verse eid="2KI 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 9:24" />
    <char style="pn">耶戶</char>拉滿弓，射中了<char style="pn">約蘭</char>兩臂正中間，一箭穿心，他就癱倒在戰車裡。 <verse eid="2KI 9:24" /><verse number="25" style="v" sid="2KI 9:25" /><char style="pn">耶戶</char>對他的軍官<char style="pn">畢甲</char>說：「把他抬走扔到<char style="pn">耶斯列</char>人<char style="pn">拿伯</char>的那塊田地裡。你當記得，你我一同駕車跟隨他父親<char style="pn">亞哈</char>時，耶和華曾向<char style="pn">亞哈</char>發出了這默示：<verse eid="2KI 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2KI 9:26" />『昨夜我確實看見了<char style="pn">拿伯</char>的血和他兒子們的血</para>
  <para style="q2" vid="2KI 9:26">——這是耶和華的宣告；</para>
  <para style="q1" vid="2KI 9:26">我必在那塊田地上報應你</para>
  <para style="q2" vid="2KI 9:26">——這是耶和華的宣告。』</para>
  <para style="m" vid="2KI 9:26">現在你就照著耶和華的話，把他抬走扔到那塊田地裡吧。」<verse eid="2KI 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 9:27" />
    <char style="pn">猶大</char>王<char style="pn">亞哈謝</char>看見這一切，就往<char style="pn">伯哈干</char>的方向逃走。<char style="pn">耶戶</char>追趕他說：「把他也殺了！」於是在靠近<char style="pn">以伯蓮</char>的<char style="pn">古珥</char>山坡上，有人把他射傷在戰車上。他逃到<char style="pn">米吉多</char>，死在那裡。 <verse eid="2KI 9:27" /><verse number="28" style="v" sid="2KI 9:28" />他的臣僕們用車把他運送到<char style="pn">耶路撒冷</char>，葬在<char style="pn">大衛</char>城他的墳墓裡，與他的列祖在一起。 <verse eid="2KI 9:28" /><verse number="29" style="v" sid="2KI 9:29" /><char style="pn">亞哈</char>的兒子<char style="pn">約蘭</char>在位第十一年，<char style="pn">亞哈謝</char>作<char style="pn">猶大</char>的王。<verse eid="2KI 9:29" /></para>
  <para style="s">耶戶殺耶洗別</para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 9:30" />
    <char style="pn">耶戶</char>來到<char style="pn">耶斯列</char>，<char style="pn">耶洗別</char>聽說了，就畫眉梳頭，從窗戶俯看。 <verse eid="2KI 9:30" /><verse number="31" style="v" sid="2KI 9:31" /><char style="pn">耶戶</char>進了城門，<char style="pn">耶洗別</char>說：「你這弒主的<char style="pn">澤姆利</char>啊，平安嗎？」<verse eid="2KI 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 9:32" />
    <char style="pn">耶戶</char>抬頭對著窗戶，說：「有誰聽我的？有誰？」兩三個太監向他俯看。 <verse eid="2KI 9:32" /><verse number="33" style="v" sid="2KI 9:33" /><char style="pn">耶戶</char>說：「把她扔下來！」他們就把她扔下去，她的血噴濺到牆上和馬身上，<char style="pn">耶戶</char>從她上面軋過去。<verse eid="2KI 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 9:34" />
    <char style="pn">耶戶</char>進去，又吃又喝，然後說：「去看看這受詛咒的女人，把她埋葬了，她畢竟是王的女兒。」 <verse eid="2KI 9:34" /><verse number="35" style="v" sid="2KI 9:35" />他們就去埋葬她，卻發現除了頭骨和手腳以外，什麼都沒有了。 <verse eid="2KI 9:35" /><verse number="36" style="v" sid="2KI 9:36" />他們回去報告<char style="pn">耶戶</char>，<char style="pn">耶戶</char>說：「這應驗了耶和華藉著他的僕人<char style="pn">提斯比</char>人<char style="pn">以利亞</char>所宣告的話：『狗必在<char style="pn">耶斯列</char>地界內吃掉<char style="pn">耶洗別</char>的肉。 <verse eid="2KI 9:36" /><verse number="37" style="v" sid="2KI 9:37" /><char style="pn">耶洗別</char>的屍體必在<char style="pn">耶斯列</char>地界內如同地上的糞土，以致沒有人能說：這就是<char style="pn">耶洗別</char>。』」<verse eid="2KI 9:37" /></para>
  <chapter eid="2KI 9" />
  <chapter number="10" style="c" sid="2KI 10" />
  <para style="s">耶戶殺亞哈全家</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 10:1" />那時，<char style="pn">亞哈</char>的七十個兒子在<char style="pn">撒瑪利亞</char>。<char style="pn">耶戶</char>寫信送到<char style="pn">撒瑪利亞</char>，給<char style="pn">耶斯列</char>的首領、長老們以及<char style="pn">亞哈</char>子女的監護人，說：<verse eid="2KI 10:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="2KI 10:2" />「如今，這封書信到達你們那裡時，既然你們有主人的兒子與你們在一起，又有車馬、堡壘城和兵器， <verse eid="2KI 10:2" /><verse number="3" style="v" sid="2KI 10:3" />就請你們選出主人的兒子中最優秀最合適的，立他坐他父親的王位，然後你們為主人的家爭戰吧！」<verse eid="2KI 10:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="2KI 10:4" />他們卻極其害怕，說：「看哪，兩個王在這人面前都站立不住，我們怎麼能站立得住呢？」<verse eid="2KI 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 10:5" />於是宮廷總管、城裡的官長、長老們和<char style="pn">亞哈</char>兒女的監護人就派人去見<char style="pn">耶戶</char>，說：「我們是你的僕人，你吩咐我們什麼，我們都會去做，我們不立誰為王。你看怎樣好就怎樣做吧！」<verse eid="2KI 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 10:6" />
    <char style="pn">耶戶</char>就給他們寫了第二封信，說：</para>
  <para style="mi" vid="2KI 10:6">「你們如果歸屬我、聽從我的吩咐，就要把你們主人所有兒子的頭顱帶來，明天這時候到<char style="pn">耶斯列</char>來見我。」</para>
  <para style="b" vid="2KI 10:6" />
  <para style="p" vid="2KI 10:6">當時，眾王子七十人與城中那些撫養他們的大臣在一起。 <verse eid="2KI 10:6" /><verse number="7" style="v" sid="2KI 10:7" />當書信到達他們那裡時，他們就抓住那些王子，把七十個人都殺了。然後把他們的頭顱放進筐子裡，送到<char style="pn">耶斯列耶戶</char>那裡。 <verse eid="2KI 10:7" /><verse number="8" style="v" sid="2KI 10:8" />有一個使者來向<char style="pn">耶戶</char>報告說：「他們把那些王子的頭顱帶來了。」<char style="pn">耶戶</char>說：「把這些頭顱分成兩堆放在城門口，直到明天早晨。」<verse eid="2KI 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 10:9" />到了早晨，<char style="pn">耶戶</char>出去站著，對全體民眾說：「你們是清白的，看哪，是我密謀反叛我的主人，把他殺了；但這些人都是誰殺的呢？ <verse eid="2KI 10:9" /><verse number="10" style="v" sid="2KI 10:10" />現在你們當知道：耶和華的話語——耶和華指著<char style="pn">亞哈</char>家所說的，一句也不落空；耶和華已經成就了藉著他僕人<char style="pn">以利亞</char>所宣告的話。」 <verse eid="2KI 10:10" /><verse number="11" style="v" sid="2KI 10:11" />這樣，<char style="pn">耶戶</char>擊殺了<char style="pn">亞哈</char>家在<char style="pn">耶斯列</char>所有剩下的人、他所有的大臣、親密的朋友和他的祭司，沒有留下一人存活。<verse eid="2KI 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 10:12" />
    <char style="pn">耶戶</char>起身往<char style="pn">撒瑪利亞</char>去。路過牧羊人的<char style="pn">伯艾吉</char>時， <verse eid="2KI 10:12" /><verse number="13" style="v" sid="2KI 10:13" /><char style="pn">耶戶</char>遇見了<char style="pn">猶大</char>王<char style="pn">亞哈謝</char>的族兄弟們。他問：「你們是誰？」</para>
  <para style="p" vid="2KI 10:13">他們回答：「我們是<char style="pn">亞哈謝</char>的族兄弟，下來要向王的家人和太后的家人問安。」<verse eid="2KI 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 10:14" />
    <char style="pn">耶戶</char>吩咐：「活捉他們！」他的部下就活捉了他們，在<char style="pn">伯艾吉</char>的水窖旁邊把他們殺了，共四十二人，一個也沒有留下。<verse eid="2KI 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 10:15" />
    <char style="pn">耶戶</char>從那裡前行，遇見了<char style="pn">利甲</char>的兒子<char style="pn">約拿達</char>前來迎接他。<char style="pn">耶戶</char>向他問安，說：「你的心是否真誠，就像我的心對你的心那樣？」</para>
  <para style="p" vid="2KI 10:15">
    <char style="pn">約拿達</char>回答：「是。」</para>
  <para style="p" vid="2KI 10:15">
    <char style="pn">耶戶</char>說：「既然是，就請遞出你的手。」</para>
  <para style="p" vid="2KI 10:15">
    <char style="pn">約拿達</char>遞出手，<char style="pn">耶戶</char>就把他拉上戰車。 <verse eid="2KI 10:15" /><verse number="16" style="v" sid="2KI 10:16" /><char style="pn">耶戶</char>說：「跟我一起去，看看我對耶和華的熱心！」於是<char style="pn">耶戶</char>讓<char style="pn">約拿達</char>乘上了自己的戰車。 <verse eid="2KI 10:16" /><verse number="17" style="v" sid="2KI 10:17" /><char style="pn">耶戶</char>來到<char style="pn">撒瑪利亞</char>，擊殺了其餘在<char style="pn">撒瑪利亞</char>所有屬<char style="pn">亞哈</char>的人，直到滅盡了，正如耶和華向<char style="pn">以利亞</char>所宣告的話。<verse eid="2KI 10:17" /></para>
  <para style="s">耶戶除滅拜巴力的人</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 10:18" />
    <char style="pn">耶戶</char>招聚全體民眾，對他們說：「<char style="pn">亞哈</char>服事<char style="pn">巴力</char>還不夠熱心，<char style="pn">耶戶</char>要更加熱心服事。 <verse eid="2KI 10:18" /><verse number="19" style="v" sid="2KI 10:19" />現在，你們要把<char style="pn">巴力</char>的所有先知、所有服事<char style="pn">巴力</char>的人和<char style="pn">巴力</char>的所有祭司都召集到我這裡來，一個都不能缺，因為我要給<char style="pn">巴力</char>舉行一個盛大的祭祀；任何缺席者都不得存活。」原來<char style="pn">耶戶</char>是在用詭計，為要消滅服事<char style="pn">巴力</char>的人。 <verse eid="2KI 10:19" /><verse number="20" style="v" sid="2KI 10:20" /><char style="pn">耶戶</char>又說：「要為<char style="pn">巴力</char>舉行一個嚴肅聖會！」於是他們發出通告。<verse eid="2KI 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 10:21" />
    <char style="pn">耶戶</char>派人走遍全<char style="pn">以色列</char>，所有服事<char style="pn">巴力</char>的人都來了，沒有一個留下不來的。人們進入<char style="pn">巴力</char>的廟宇，<char style="pn">巴力</char>的廟宇從這頭到那頭都擠滿了人。 <verse eid="2KI 10:21" /><verse number="22" style="v" sid="2KI 10:22" /><char style="pn">耶戶</char>對掌管禮服的人說：「把衣袍給所有服事<char style="pn">巴力</char>的人拿出來。」他就把服裝給他們拿出來。<verse eid="2KI 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 10:23" />
    <char style="pn">耶戶</char>與<char style="pn">利甲</char>的兒子<char style="pn">約拿達</char>進入<char style="pn">巴力</char>的廟宇，<char style="pn">耶戶</char>對服事<char style="pn">巴力</char>的人說：「搜尋看看，你們這裡不許有耶和華的僕人與你們在一起，只能有那些服事<char style="pn">巴力</char>的人在場。」 <verse eid="2KI 10:23" /><verse number="24" style="v" sid="2KI 10:24" />這樣，他們進去獻上祭物和燔祭。</para>
  <para style="p" vid="2KI 10:24">
    <char style="pn">耶戶</char>在外面提前安排了八十人，說：「我交在你們手中的人，誰讓其中逃脫一個，誰就要以命抵命。」 <verse eid="2KI 10:24" /><verse number="25" style="v" sid="2KI 10:25" />獻完了燔祭，<char style="pn">耶戶</char>就吩咐護衛兵和軍官們：「進去擊殺他們，不要讓任何人逃出來！」護衛兵和軍官們就用刀把他們殺了扔出去，然後進到<char style="pn">巴力</char>廟宇的內殿， <verse eid="2KI 10:25" /><verse number="26" style="v" sid="2KI 10:26" />把<char style="pn">巴力</char>廟宇裡的神柱都搬出去燒毀了。 <verse eid="2KI 10:26" /><verse number="27" style="v" sid="2KI 10:27" />他們拆毀<char style="pn">巴力</char>的神柱，又拆毀<char style="pn">巴力</char>的廟宇，用作廁所，直到今日。<verse eid="2KI 10:27" /></para>
  <para style="s">耶戶的統治概述</para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 10:28" />這樣，<char style="pn">耶戶</char>從<char style="pn">以色列</char>中除滅了<char style="pn">巴力</char>。 <verse eid="2KI 10:28" /><verse number="29" style="v" sid="2KI 10:29" />只是<char style="pn">耶戶</char>沒有離棄<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>使<char style="pn">以色列</char>所犯的罪惡，就是敬拜<char style="pn">伯特利</char>和<char style="pn">但</char>的金牛犢。 <verse eid="2KI 10:29" /><verse number="30" style="v" sid="2KI 10:30" />耶和華對<char style="pn">耶戶</char>說：「因為你做我眼中看為正的事，做得很好，照著我心裡的一切處置了<char style="pn">亞哈</char>家，所以你子孫四代都必坐<char style="pn">以色列</char>的王位。」<verse eid="2KI 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 10:31" />然而，<char style="pn">耶戶</char>沒有全心謹守遵行<char style="pn">以色列</char>的神耶和華的律法，沒有離開<char style="pn">耶羅波安</char>使<char style="pn">以色列</char>所犯的罪惡。<verse eid="2KI 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 10:32" />在那些日子，耶和華開始切割<char style="pn">以色列</char>。<char style="pn">哈薛</char>在<char style="pn">以色列</char>境內各處擊敗他們， <verse eid="2KI 10:32" /><verse number="33" style="v" sid="2KI 10:33" />遍及<char style="pn">約旦</char>河東的<char style="pn">基列</char>地——<char style="pn">迦得</char>人、<char style="pn">魯本</char>人和<char style="pn">瑪拿西</char>人之地——從靠近<char style="pn">亞嫩</char>溪谷的<char style="pn">亞羅珥</char>，直到<char style="pn">基列</char>和<char style="pn">巴珊</char>。<verse eid="2KI 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 10:34" />
    <char style="pn">耶戶</char>其餘的事蹟和他所做的一切，以及他的所有武力，不是都記在《<char style="pn">以色列</char>諸王年代志》上嗎？ <verse eid="2KI 10:34" /><verse number="35" style="v" sid="2KI 10:35" /><char style="pn">耶戶</char>與他的列祖長眠，人們把他葬在<char style="pn">撒瑪利亞</char>；他的兒子<char style="pn">約哈斯</char>接替他作王。 <verse eid="2KI 10:35" /><verse number="36" style="v" sid="2KI 10:36" /><char style="pn">耶戶</char>在<char style="pn">撒瑪利亞</char>統治<char style="pn">以色列</char>的日子共二十八年。<verse eid="2KI 10:36" /></para>
  <chapter eid="2KI 10" />
  <chapter number="11" style="c" sid="2KI 11" />
  <para style="s">婭塔利雅篡權</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 11:1" />
    <char style="pn">亞哈謝</char>的母親<char style="pn">婭塔利雅</char>見自己的兒子死了，就動手消滅所有的王室後裔。 <verse eid="2KI 11:1" /><verse number="2" style="v" sid="2KI 11:2" />但<char style="pn">約蘭</char>王的女兒、<char style="pn">亞哈謝</char>的妹妹<char style="pn">約示巴</char>帶走了<char style="pn">亞哈謝</char>的兒子<char style="pn">約阿施</char>，從即將被處死的王子們當中偷走他，然後把他和他的乳母一起安置在一間臥室裡。這樣，他們把<char style="pn">約阿施</char>藏了起來，躲避<char style="pn">婭塔利雅</char>，他就沒有被處死。 <verse eid="2KI 11:2" /><verse number="3" style="v" sid="2KI 11:3" /><char style="pn">約阿施</char>與他的乳母在耶和華的殿中躲藏了六年，那時<char style="pn">婭塔利雅</char>統治那地。<verse eid="2KI 11:3" /></para>
  <para style="s">婭塔利雅被推翻</para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 11:4" />到了第七年，<char style="pn">耶赫亞達</char>派人去把<char style="pn">迦利</char>人的百夫長和護衛兵的百夫長請來，帶到耶和華的殿來見他。他就與他們結盟，讓他們在耶和華殿中起誓，然後使他們見到王子。 <verse eid="2KI 11:4" /><verse number="5" style="v" sid="2KI 11:5" />他吩咐他們說：「你們要這樣做：你們安息日當班的人，三分之一要值守王宮， <verse eid="2KI 11:5" /><verse number="6" style="v" sid="2KI 11:6" />三分之一值守在根基門<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="ft" closed="false">根基門——或譯作「蘇珥門」；參《歷代志下》23:5。</char></note>，三分之一值守在護衛兵院的後門；你們要輪流值守聖殿。<verse eid="2KI 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 11:7" />「你們所有在安息日休班的兩班人，都要為王值守在耶和華的殿。 <verse eid="2KI 11:7" /><verse number="8" style="v" sid="2KI 11:8" />你們要各自手拿兵器圍繞著王，靠近列隊的人必被處死。王出入的時候，你們必須緊隨著王。」<verse eid="2KI 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 11:9" />於是眾百夫長就照著祭司<char style="pn">耶赫亞達</char>所吩咐的一切去做，各自帶領部下，無論是安息日當班的還是安息日休班的，來到祭司<char style="pn">耶赫亞達</char>那裡。 <verse eid="2KI 11:9" /><verse number="10" style="v" sid="2KI 11:10" />祭司把耶和華殿中<char style="pn">大衛</char>王的那些長矛和盾牌交給眾百夫長， <verse eid="2KI 11:10" /><verse number="11" style="v" sid="2KI 11:11" />然後讓護衛兵各自手拿兵器，從殿宇右側到殿宇左側，對著祭壇和殿宇，侍立在王子<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">王子——原文直譯「王」。</char></note>的周圍。<verse eid="2KI 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 11:12" />
    <char style="pn">耶赫亞達</char>把王子領出來，給他戴上冠冕，把律法書交給他，立他為王。他們膏抹了他，然後眾人拍手鼓掌說：「願王萬歲！」<verse eid="2KI 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 11:13" />
    <char style="pn">婭塔利雅</char>聽見護衛兵和民眾的聲音，就來到耶和華殿中民眾那裡。 <verse eid="2KI 11:13" /><verse number="14" style="v" sid="2KI 11:14" />她觀看，看哪，王按照慣例站在柱子旁邊，將領們和吹號手在王身邊，這地所有的民眾在歡樂、吹號。<char style="pn">婭塔利雅</char>就撕裂衣服，喊叫：「謀反了！謀反了！」<verse eid="2KI 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 11:15" />祭司<char style="pn">耶赫亞達</char>吩咐率領軍隊的眾百夫長，對他們說：「把她從隊列之間趕出去，把跟隨她的人都用刀殺了！」因為祭司說不可在耶和華殿中處死她。 <verse eid="2KI 11:15" /><verse number="16" style="v" sid="2KI 11:16" />他們就下手抓住她，她到了王宮馬門入口處，在那裡被處死了。<verse eid="2KI 11:16" /></para>
  <para style="s">耶赫亞達的改革</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 11:17" />此後，<char style="pn">耶赫亞達</char>使王和民眾與耶和華立約，要作耶和華的子民；又使王與民眾立約。 <verse eid="2KI 11:17" /><verse number="18" style="v" sid="2KI 11:18" />於是這地所有的民眾來到<char style="pn">巴力</char>的廟宇，把它拆毀，徹底打碎其中的祭壇和偶像，並且在祭壇前殺了<char style="pn">巴力</char>的祭司<char style="pn">瑪坦</char>。</para>
  <para style="p" vid="2KI 11:18">祭司<char style="pn">耶赫亞達</char>為耶和華的殿安排了監管的人， <verse eid="2KI 11:18" /><verse number="19" style="v" sid="2KI 11:19" />然後他帶領百夫長、<char style="pn">迦利</char>人、護衛兵以及這地的所有民眾，請王從耶和華的殿下來，穿過護衛兵院的門進入王宮，王就坐上了王位。 <verse eid="2KI 11:19" /><verse number="20" style="v" sid="2KI 11:20" />於是這地所有的民眾都歡喜，城中也平靜，因為他們在王宮把<char style="pn">婭塔利雅</char>用刀殺了。 <verse eid="2KI 11:20" /><verse number="21" style="v" sid="2KI 11:21" /><char style="pn">約阿施</char>作王的時候七歲。<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">此節在馬索拉文本為12:1。</char></note><verse eid="2KI 11:21" /></para>
  <chapter eid="2KI 11" />
  <chapter number="12" style="c" sid="2KI 12" />
  <para style="s">猶大王約阿施</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 12:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">12:1 </char>
      <char style="ft" closed="false">此章在馬索拉文本為12:2至12:22。</char>
    </note>
    <char style="pn">耶戶</char>在位第七年，<char style="pn">約阿施</char>作王，在<char style="pn">耶路撒冷</char>統治了四十年。他的母親名叫<char style="pn">慈比婭</char>，是<char style="pn">比爾-謝巴</char>人。 <verse eid="2KI 12:1" /><verse number="2" style="v" sid="2KI 12:2" /><char style="pn">約阿施</char>在祭司<char style="pn">耶赫亞達</char>指教他的所有日子裡，都做耶和華眼中看為正的事。 <verse eid="2KI 12:2" /><verse number="3" style="v" sid="2KI 12:3" />只是那些高壇還沒有除掉，百姓仍舊在高壇獻祭燒香。<verse eid="2KI 12:3" /></para>
  <para style="s">重修耶和華的殿</para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 12:4" />
    <char style="pn">約阿施</char>對祭司們說：「所有分別為聖奉獻到耶和華殿的銀子，無論是人口統計時收取的銀子，還是個人還願時估定的銀子，或是人們發自內心奉獻到耶和華殿的一切銀子， <verse eid="2KI 12:4" /><verse number="5" style="v" sid="2KI 12:5" />祭司各自要從管事的人那裡收取，然後用來修繕殿宇的破損處，就是發現有破損的所有地方。」<verse eid="2KI 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 12:6" />可是到了<char style="pn">約阿施</char>王二十三年，祭司們還沒有修繕殿宇的破損處。 <verse eid="2KI 12:6" /><verse number="7" style="v" sid="2KI 12:7" />於是<char style="pn">約阿施</char>王召來祭司<char style="pn">耶赫亞達</char>和祭司們，對他們說：「你們為什麼不修繕殿宇的破損處呢？現在，你們不要從管事的人那裡再收取銀子了，要把所收的交出來，用於修繕殿宇的破損處。」 <verse eid="2KI 12:7" /><verse number="8" style="v" sid="2KI 12:8" />祭司們就答應不再接收百姓的銀子，也不再負責修繕殿宇的破損處了。<verse eid="2KI 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 12:9" />祭司<char style="pn">耶赫亞達</char>拿來一個箱櫃，在蓋子上開了一個口，把它放在祭壇旁邊，在耶和華殿的入口右邊。守門的祭司要把所有奉獻到耶和華殿的銀子，都投到那裡面。 <verse eid="2KI 12:9" /><verse number="10" style="v" sid="2KI 12:10" />每當他們看到奉獻箱裡的銀子很多，王的書記和大祭司就上來，把耶和華殿所收的銀子裝在袋子裡加以數算。 <verse eid="2KI 12:10" /><verse number="11" style="v" sid="2KI 12:11" />他們把稱量過的銀子交託在那些監管耶和華殿中工作的人手中，這些人再把銀子支付給在耶和華殿施工的木匠、建築工、 <verse eid="2KI 12:11" /><verse number="12" style="v" sid="2KI 12:12" />泥瓦匠和石匠，也用於買木材和鑿好的料石，來修繕耶和華殿的破損處，以及用於修繕殿宇的一切開支。<verse eid="2KI 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 12:13" />不過這些奉獻到耶和華殿的銀子，沒有用於製作耶和華殿中的銀缽、蠟剪、碗、號筒和任何金銀的器皿， <verse eid="2KI 12:13" /><verse number="14" style="v" sid="2KI 12:14" />因為他們把銀子交給了做工的人，用於修繕耶和華的殿。 <verse eid="2KI 12:14" /><verse number="15" style="v" sid="2KI 12:15" />交在這些人手中為要支付給工人的銀子，他們不必算帳，因為他們行事誠信。 <verse eid="2KI 12:15" /><verse number="16" style="v" sid="2KI 12:16" />至於贖愆祭和贖罪祭的銀子，並沒有奉獻到耶和華的殿，都歸於祭司。<verse eid="2KI 12:16" /></para>
  <para style="s">亞蘭人侵略猶大</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 12:17" />此後，<char style="pn">亞蘭</char>王<char style="pn">哈薛</char>上來攻打<char style="pn">迦特</char>，攻取了它，隨後<char style="pn">哈薛</char>決意上來攻打<char style="pn">耶路撒冷</char>。 <verse eid="2KI 12:17" /><verse number="18" style="v" sid="2KI 12:18" /><char style="pn">猶大</char>王<char style="pn">約阿施</char>就取出他列祖<char style="pn">猶大</char>王<char style="pn">約沙法</char>、<char style="pn">約蘭</char>、<char style="pn">亞哈謝</char>的所有分別為聖之物，以及自己所分別為聖之物，還有耶和華殿與王宮的庫房裡所有的金子，都送給<char style="pn">亞蘭</char>王<char style="pn">哈薛</char>。於是<char style="pn">哈薛</char>從<char style="pn">耶路撒冷</char>撤離了。<verse eid="2KI 12:18" /></para>
  <para style="s">約阿施被謀殺</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 12:19" />
    <char style="pn">約阿施</char>其餘的事蹟和他所做的一切，不是都記在《<char style="pn">猶大</char>諸王年代志》上嗎？ <verse eid="2KI 12:19" /><verse number="20" style="v" sid="2KI 12:20" />他的臣僕們起來謀反，在通往<char style="pn">悉拉</char>路上的<char style="pn">伯米羅</char>擊殺了<char style="pn">約阿施</char>。 <verse eid="2KI 12:20" /><verse number="21" style="v" sid="2KI 12:21" />他的兩個臣僕<char style="pn">示米押</char>的兒子<char style="pn">約撒卡</char>和<char style="pn">朔梅爾</char>的兒子<char style="pn">約撒巴</char>攻擊他，他就死了。人們把他葬在<char style="pn">大衛</char>城，與他的列祖在一起；他的兒子<char style="pn">亞瑪謝</char>接替他作王。<verse eid="2KI 12:21" /></para>
  <chapter eid="2KI 12" />
  <chapter number="13" style="c" sid="2KI 13" />
  <para style="s">以色列王約哈斯</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 13:1" />
    <char style="pn">亞哈謝</char>的兒子<char style="pn">猶大</char>王<char style="pn">約阿施</char>在位第二十三年，<char style="pn">耶戶</char>的兒子<char style="pn">約哈斯</char>在<char style="pn">撒瑪利亞</char>作<char style="pn">以色列</char>的王，統治了十七年。 <verse eid="2KI 13:1" /><verse number="2" style="v" sid="2KI 13:2" />他做耶和華眼中看為惡的事，隨從<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>使<char style="pn">以色列</char>所犯的罪惡，總不離開那罪。 <verse eid="2KI 13:2" /><verse number="3" style="v" sid="2KI 13:3" />於是耶和華的怒氣向<char style="pn">以色列</char>發作，長期把他們交在<char style="pn">亞蘭</char>王<char style="pn">哈薛</char>和<char style="pn">哈薛</char>的兒子<char style="pn">本哈達</char>手中。<verse eid="2KI 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 13:4" />
    <char style="pn">約哈斯</char>懇求耶和華的恩寵，耶和華垂聽了他，因為耶和華看見<char style="pn">以色列</char>所受的壓迫，<char style="pn">亞蘭</char>王實在是壓迫他們。 <verse eid="2KI 13:4" /><verse number="5" style="v" sid="2KI 13:5" />耶和華賜予<char style="pn">以色列</char>一位拯救者，他們就脫離了<char style="pn">亞蘭</char>人的手。於是<char style="pn">以色列</char>子民像從前那樣，安居在自己的帳篷裡。 <verse eid="2KI 13:5" /><verse number="6" style="v" sid="2KI 13:6" />然而他們不離開<char style="pn">耶羅波安</char>家使<char style="pn">以色列</char>所犯的罪惡，繼續行在其中，而且<char style="pn">亞舍拉</char>柱依然豎立在<char style="pn">撒瑪利亞</char>。 <verse eid="2KI 13:6" /><verse number="7" style="v" sid="2KI 13:7" /><char style="pn">約哈斯</char>除了五十個馬兵、十輛戰車和一萬步兵以外，再沒有其餘的軍兵<note caller="+" style="f"><char style="fr" closed="false">13:7 </char><char style="ft" closed="false">約哈斯……再沒有其餘的軍兵——或譯作「耶和華沒有給約哈斯留下軍兵」。</char></note>，因為<char style="pn">亞蘭</char>王消滅他們，踐踏他們如同禾場上的塵土。<verse eid="2KI 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 13:8" />
    <char style="pn">約哈斯</char>其餘的事蹟和他所做的一切，以及他的武力，不是都記在《<char style="pn">以色列</char>諸王年代志》上嗎？ <verse eid="2KI 13:8" /><verse number="9" style="v" sid="2KI 13:9" /><char style="pn">約哈斯</char>與他的列祖長眠，人們把他葬在<char style="pn">撒瑪利亞</char>；他的兒子<char style="pn">約阿施</char>接替他作王。<verse eid="2KI 13:9" /></para>
  <para style="s">以色列王約阿施</para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 13:10" />
    <char style="pn">猶大</char>王<char style="pn">約阿施</char>在位第三十七年，<char style="pn">約哈斯</char>的兒子<char style="pn">約阿施</char>在<char style="pn">撒瑪利亞</char>作<char style="pn">以色列</char>的王，統治了十六年。 <verse eid="2KI 13:10" /><verse number="11" style="v" sid="2KI 13:11" />他做耶和華眼中看為惡的事，不離開<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>使<char style="pn">以色列</char>所犯的一切罪惡，繼續行在其中。<verse eid="2KI 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 13:12" />
    <char style="pn">約阿施</char>其餘的事蹟和他所做的一切，以及他與<char style="pn">猶大</char>王<char style="pn">亞瑪謝</char>爭戰時的武力，不是都記在《<char style="pn">以色列</char>諸王年代志》上嗎？ <verse eid="2KI 13:12" /><verse number="13" style="v" sid="2KI 13:13" /><char style="pn">約阿施</char>與他的列祖長眠，<char style="pn">耶羅波安</char>坐上他的王位。<char style="pn">約阿施</char>被葬在<char style="pn">撒瑪利亞</char>，與<char style="pn">以色列</char>諸王在一起。<verse eid="2KI 13:13" /></para>
  <para style="s">以利沙去世</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 13:14" />
    <char style="pn">以利沙</char>患病將死，<char style="pn">以色列</char>王<char style="pn">約阿施</char>下去看他，在他面前哭泣，說：「我父啊，我父啊！<char style="pn">以色列</char>的戰車馬兵啊！」<verse eid="2KI 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 13:15" />
    <char style="pn">以利沙</char>對王說：「把弓箭拿來！」他就拿來了弓箭。 <verse eid="2KI 13:15" /><verse number="16" style="v" sid="2KI 13:16" /><char style="pn">以利沙</char>對<char style="pn">以色列</char>王說：「手握在弓把上！」王就用手握住，然後<char style="pn">以利沙</char>把自己的手按在王的手上， <verse eid="2KI 13:16" /><verse number="17" style="v" sid="2KI 13:17" />說：「打開朝東的窗戶。」他就打開了。<char style="pn">以利沙</char>說：「射箭！」王就射箭。<char style="pn">以利沙</char>說：「這是耶和華的勝利之箭，是戰勝<char style="pn">亞蘭</char>人的箭！你將在<char style="pn">阿費克</char>徹底擊敗<char style="pn">亞蘭</char>人。」<verse eid="2KI 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 13:18" />
    <char style="pn">以利沙</char>又說：「拿起箭來！」他就拿起來。<char style="pn">以利沙</char>對<char style="pn">以色列</char>王說：「往地上擊打！」他打了三下，就停了。 <verse eid="2KI 13:18" /><verse number="19" style="v" sid="2KI 13:19" />神人對他發怒，說：「你應該擊打五次、六次，這樣你就徹底擊敗了<char style="pn">亞蘭</char>人。而現在，你只能擊敗<char style="pn">亞蘭</char>人三次。」 <verse eid="2KI 13:19" /><verse number="20" style="v" sid="2KI 13:20" /><char style="pn">以利沙</char>死了，人們把他安葬了。</para>
  <para style="p" vid="2KI 13:20">那時每年的年初，<char style="pn">摩押</char>的劫掠隊都會入侵那地。 <verse eid="2KI 13:20" /><verse number="21" style="v" sid="2KI 13:21" />有一天，人們正在埋葬死人，突然看見一支劫掠隊，就把那死人扔到<char style="pn">以利沙</char>的墳墓裡跑了。那死人一碰到<char style="pn">以利沙</char>的骸骨，就復活了，雙腳站了起來。<verse eid="2KI 13:21" /></para>
  <para style="s">耶和華憐憫以色列</para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 13:22" />
    <char style="pn">約哈斯</char>一生的日子，<char style="pn">亞蘭</char>王<char style="pn">哈薛</char>一直壓迫<char style="pn">以色列</char>。 <verse eid="2KI 13:22" /><verse number="23" style="v" sid="2KI 13:23" />但耶和華因他與<char style="pn">亞伯拉罕</char>、<char style="pn">以撒</char>、<char style="pn">雅各</char>所立的約，就恩待<char style="pn">以色列</char>人，憐憫他們，垂顧他們。他不願意毀滅他們，沒有把他們從他面前趕走，直到今日。<verse eid="2KI 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 13:24" />
    <char style="pn">亞蘭</char>王<char style="pn">哈薛</char>死了，他的兒子<char style="pn">本哈達</char>接替他作王。 <verse eid="2KI 13:24" /><verse number="25" style="v" sid="2KI 13:25" /><char style="pn">約哈斯</char>的兒子<char style="pn">約阿施</char>從<char style="pn">哈薛</char>的兒子<char style="pn">本哈達</char>手中奪回了一些城鎮，都是以前<char style="pn">哈薛</char>打仗從他父親<char style="pn">約哈斯</char>手中奪取的。<char style="pn">約阿施</char>擊敗他三次，收復了<char style="pn">以色列</char>的一些城鎮。<verse eid="2KI 13:25" /></para>
  <chapter eid="2KI 13" />
  <chapter number="14" style="c" sid="2KI 14" />
  <para style="s">猶大王亞瑪謝</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 14:1" />
    <char style="pn">約哈斯</char>的兒子<char style="pn">以色列</char>王<char style="pn">約阿施</char>在位第二年，<char style="pn">猶大</char>王<char style="pn">約阿施</char>的兒子<char style="pn">亞瑪謝</char>作王。 <verse eid="2KI 14:1" /><verse number="2" style="v" sid="2KI 14:2" />他作王的時候二十五歲，在<char style="pn">耶路撒冷</char>統治了二十九年。他的母親名叫<char style="pn">耶赫阿丹</char>，是<char style="pn">耶路撒冷</char>人。 <verse eid="2KI 14:2" /><verse number="3" style="v" sid="2KI 14:3" />他做耶和華眼中看為正的事，只是不如他的先祖<char style="pn">大衛</char>；他效法他父親<char style="pn">約阿施</char>所做的一切。 <verse eid="2KI 14:3" /><verse number="4" style="v" sid="2KI 14:4" />只是那些高壇還沒有除掉，百姓仍舊在高壇獻祭燒香。<verse eid="2KI 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 14:5" />當他手中的王權穩固後，他就把殺他父王的臣僕都殺掉了。 <verse eid="2KI 14:5" /><verse number="6" style="v" sid="2KI 14:6" />但他沒有處死那些凶手的兒子，是照著<char style="pn">摩西</char>律法書上所記的，耶和華所指示的：「不可因著兒子處死父親，也不可因著父親處死兒子；各人只可因自己的罪過被處死。」<verse eid="2KI 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 14:7" />他在<char style="pn">鹽谷</char>擊殺了一萬<char style="pn">以東</char>人，又出戰攻取了<char style="pn">西拉</char>，給它起名為<char style="pn">約克帖</char>，直到今日。 <verse eid="2KI 14:7" /><verse number="8" style="v" sid="2KI 14:8" />此後<char style="pn">亞瑪謝</char>派遣使者去見<char style="pn">耶戶</char>的孫子、<char style="pn">約哈斯</char>的兒子<char style="pn">以色列</char>王<char style="pn">約阿施</char>，說：「來，讓我們戰場相見吧！」<verse eid="2KI 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 14:9" />
    <char style="pn">以色列</char>王<char style="pn">約阿施</char>就派人去見<char style="pn">猶大</char>王<char style="pn">亞瑪謝</char>，說：「<char style="pn">黎巴嫩</char>的蒺藜派人到<char style="pn">黎巴嫩</char>的香柏樹那裡，說：『把你的女兒嫁給我兒子為妻吧！』然而，有一隻<char style="pn">黎巴嫩</char>的野獸經過，把那蒺藜踐踏了。 <verse eid="2KI 14:9" /><verse number="10" style="v" sid="2KI 14:10" />你確實擊敗了<char style="pn">以東</char>，你的心就高傲了。你自高自大吧，但請留在家裡！何必招惹禍患，使自己和<char style="pn">猶大</char>一同敗亡呢？」<verse eid="2KI 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 14:11" />
    <char style="pn">亞瑪謝</char>卻不聽。於是<char style="pn">以色列</char>王<char style="pn">約阿施</char>上來，與<char style="pn">猶大</char>王<char style="pn">亞瑪謝</char>在<char style="pn">猶大</char>的<char style="pn">伯示麥</char>對陣。 <verse eid="2KI 14:11" /><verse number="12" style="v" sid="2KI 14:12" /><char style="pn">猶大</char>敗在<char style="pn">以色列</char>面前，各人逃回自己的帳篷。 <verse eid="2KI 14:12" /><verse number="13" style="v" sid="2KI 14:13" /><char style="pn">以色列</char>王<char style="pn">約阿施</char>在<char style="pn">伯示麥</char>捉住了<char style="pn">亞哈謝</char>的孫子、<char style="pn">約阿施</char>的兒子<char style="pn">猶大</char>王<char style="pn">亞瑪謝</char>，然後來到<char style="pn">耶路撒冷</char>，拆毀了<char style="pn">耶路撒冷</char>的城牆，從<char style="pn">以法蓮</char>門直到<char style="pn">角門</char>，有四百肘<note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="ft" closed="false">四百肘——相當於183公尺。1肘=45.7公分。</char></note>。 <verse eid="2KI 14:13" /><verse number="14" style="v" sid="2KI 14:14" /><char style="pn">約阿施</char>奪取耶和華殿中和王宮庫房裡所有的金銀、所有的器具，並帶走人質，然後回<char style="pn">撒瑪利亞</char>去了。<verse eid="2KI 14:14" /></para>
  <para style="s">約阿施之死</para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 14:15" />
    <char style="pn">約阿施</char>其餘的事蹟，他的作為，他的武力，以及他與<char style="pn">猶大</char>王<char style="pn">亞瑪謝</char>的爭戰，不是都記在《<char style="pn">以色列</char>諸王年代志》上嗎？ <verse eid="2KI 14:15" /><verse number="16" style="v" sid="2KI 14:16" /><char style="pn">約阿施</char>與他的列祖長眠，葬在<char style="pn">撒瑪利亞</char>，與<char style="pn">以色列</char>諸王在一起；他的兒子<char style="pn">耶羅波安</char>接替他作王。<verse eid="2KI 14:16" /></para>
  <para style="s">亞瑪謝之死</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 14:17" />
    <char style="pn">約哈斯</char>的兒子<char style="pn">以色列</char>王<char style="pn">約阿施</char>死後，<char style="pn">約阿施</char>的兒子<char style="pn">猶大</char>王<char style="pn">亞瑪謝</char>又活了十五年。 <verse eid="2KI 14:17" /><verse number="18" style="v" sid="2KI 14:18" /><char style="pn">亞瑪謝</char>其餘的事蹟，不是都記在《<char style="pn">猶大</char>諸王年代志》上嗎？ <verse eid="2KI 14:18" /><verse number="19" style="v" sid="2KI 14:19" />有人在<char style="pn">耶路撒冷</char>密謀反叛他，他就逃到<char style="pn">拉吉</char>，但他們派人追到<char style="pn">拉吉</char>，在那裡殺了他。 <verse eid="2KI 14:19" /><verse number="20" style="v" sid="2KI 14:20" />人們用馬把他馱回來，葬在<char style="pn">耶路撒冷</char>的<char style="pn">大衛</char>城，與他的列祖在一起。<verse eid="2KI 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 14:21" />
    <char style="pn">猶大</char>全體民眾選立<char style="pn">亞撒利雅</char><note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="ft" closed="false">亞撒利雅——又稱「烏西雅」；見《歷代志下》26:1。</char></note>，接替他父親<char style="pn">亞瑪謝</char>作王，那時他十六歲。 <verse eid="2KI 14:21" /><verse number="22" style="v" sid="2KI 14:22" /><char style="pn">亞瑪謝</char>王與列祖長眠之後，<char style="pn">亞撒利雅</char>重建<char style="pn">埃拉特</char>，使它回歸<char style="pn">猶大</char>。<verse eid="2KI 14:22" /></para>
  <para style="s">以色列王耶羅波安</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 14:23" />
    <char style="pn">約阿施</char>的兒子<char style="pn">猶大</char>王<char style="pn">亞瑪謝</char>在位第十五年，<char style="pn">以色列</char>王<char style="pn">約阿施</char>的兒子<char style="pn">耶羅波安</char>在<char style="pn">撒瑪利亞</char>作王，統治了四十一年。 <verse eid="2KI 14:23" /><verse number="24" style="v" sid="2KI 14:24" />他做耶和華眼中看為惡的事，不離開<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>使<char style="pn">以色列</char>所犯的一切罪惡。<verse eid="2KI 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 14:25" />他收復<char style="pn">以色列</char>的邊界，從<char style="pn">哈馬</char>隘口直到<char style="pn">亞拉巴</char>海，正如<char style="pn">以色列</char>的神耶和華藉著他的僕人——<char style="pn">迦特希弗</char>人<char style="pn">亞米太</char>的兒子先知<char style="pn">約拿</char>所宣告的話。 <verse eid="2KI 14:25" /><verse number="26" style="v" sid="2KI 14:26" />因為耶和華看見了<char style="pn">以色列</char>的苦難，無論是為奴的還是自由的，都極其悲慘，也沒有人幫助<char style="pn">以色列</char>。 <verse eid="2KI 14:26" /><verse number="27" style="v" sid="2KI 14:27" />其實耶和華並沒有說要把<char style="pn">以色列</char>的名號從天下抹掉，所以他藉著<char style="pn">約阿施</char>的兒子<char style="pn">耶羅波安</char>的手拯救了他們。<verse eid="2KI 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 14:28" />
    <char style="pn">耶羅波安</char>其餘的事蹟和他所做的一切，以及他的武力和爭戰，他怎樣把<char style="pn">猶大</char>時期擁有的<char style="pn">大馬士革</char>和<char style="pn">哈馬</char>收回歸於<char style="pn">以色列</char>，不是都記在《<char style="pn">以色列</char>諸王年代志》上嗎？ <verse eid="2KI 14:28" /><verse number="29" style="v" sid="2KI 14:29" /><char style="pn">耶羅波安</char>與他的列祖<char style="pn">以色列</char>諸王長眠，他的兒子<char style="pn">撒迦利亞</char>接替他作王。<verse eid="2KI 14:29" /></para>
  <chapter eid="2KI 14" />
  <chapter number="15" style="c" sid="2KI 15" />
  <para style="s">猶大王亞撒利雅</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 15:1" />
    <char style="pn">以色列</char>王<char style="pn">耶羅波安</char>在位第二十七年，<char style="pn">猶大</char>王<char style="pn">亞瑪謝</char>的兒子<char style="pn">亞撒利雅</char>作王。 <verse eid="2KI 15:1" /><verse number="2" style="v" sid="2KI 15:2" />他作王的時候十六歲，在<char style="pn">耶路撒冷</char>統治了五十二年。他的母親名叫<char style="pn">耶克利雅</char>，是<char style="pn">耶路撒冷</char>人。 <verse eid="2KI 15:2" /><verse number="3" style="v" sid="2KI 15:3" />他效法他父親<char style="pn">亞瑪謝</char>所做的一切，做耶和華眼中看為正的事。 <verse eid="2KI 15:3" /><verse number="4" style="v" sid="2KI 15:4" />只是那些高壇還沒有除掉，百姓仍舊在高壇獻祭燒香。<verse eid="2KI 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 15:5" />耶和華打擊王，他就患了痲瘋，直到死的日子；他住在隔離的房子裡。王的兒子<char style="pn">約坦</char>接管王室，治理國民。<verse eid="2KI 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 15:6" />
    <char style="pn">亞撒利雅</char>其餘的事蹟和他所做的一切，不是都記在《<char style="pn">猶大</char>諸王年代志》上嗎？ <verse eid="2KI 15:6" /><verse number="7" style="v" sid="2KI 15:7" /><char style="pn">亞撒利雅</char>與他的列祖長眠，人們把他葬在<char style="pn">大衛</char>城，與他的列祖在一起；他的兒子<char style="pn">約坦</char>接替他作王。<verse eid="2KI 15:7" /></para>
  <para style="s">以色列王撒迦利亞</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 15:8" />
    <char style="pn">猶大</char>王<char style="pn">亞撒利雅</char>在位第三十八年，<char style="pn">耶羅波安</char>的兒子<char style="pn">撒迦利亞</char>在<char style="pn">撒瑪利亞</char>作<char style="pn">以色列</char>的王，統治了六個月。 <verse eid="2KI 15:8" /><verse number="9" style="v" sid="2KI 15:9" />他效法他列祖的行為，做耶和華眼中看為惡的事，不離開<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>使<char style="pn">以色列</char>所犯的罪惡。<verse eid="2KI 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 15:10" />
    <char style="pn">雅比</char>的兒子<char style="pn">沙勒姆</char>密謀反叛<char style="pn">撒迦利亞</char>，當眾<note caller="+" style="f"><char style="fr" closed="false">15:10 </char><char style="ft" closed="false">當眾——或譯作「在以伯蓮」。</char></note>攻擊他，把他殺了，接替他作王。 <verse eid="2KI 15:10" /><verse number="11" style="v" sid="2KI 15:11" /><char style="pn">撒迦利亞</char>其餘的事蹟，看哪，都記在《<char style="pn">以色列</char>諸王年代志》上。 <verse eid="2KI 15:11" /><verse number="12" style="v" sid="2KI 15:12" />耶和華曾對<char style="pn">耶戶</char>說「你子孫四代都必坐<char style="pn">以色列</char>的王位」，這話就如此成就了。<verse eid="2KI 15:12" /></para>
  <para style="s">以色列王沙龍</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 15:13" />
    <char style="pn">猶大</char>王<char style="pn">亞撒利雅</char><note caller="+" style="f"><char style="fr" closed="false">15:13 </char><char style="ft" closed="false">亞撒利雅——原文是別名「烏西雅」；見《歷代志下》26:1。</char></note>在位第三十九年，<char style="pn">雅比</char>的兒子<char style="pn">沙勒姆</char>作王，在<char style="pn">撒瑪利亞</char>統治了一個月。 <verse eid="2KI 15:13" /><verse number="14" style="v" sid="2KI 15:14" /><char style="pn">迦底</char>的兒子<char style="pn">米納恆</char>從<char style="pn">提爾撒</char>上來，來到<char style="pn">撒瑪利亞</char>。他在<char style="pn">撒瑪利亞</char>攻擊<char style="pn">雅比</char>的兒子<char style="pn">沙勒姆</char>，把他殺了，接替他作王。 <verse eid="2KI 15:14" /><verse number="15" style="v" sid="2KI 15:15" /><char style="pn">沙勒姆</char>其餘的事蹟，包括他謀反的事，看哪，都記在《<char style="pn">以色列</char>諸王年代志》上。<verse eid="2KI 15:15" /></para>
  <para style="s">以色列王米納恆</para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 15:16" />那時<char style="pn">米納恆</char>從<char style="pn">提爾撒</char>出發，攻打<char style="pn">提弗薩</char>和城中所有的人，以及<char style="pn">提弗薩</char>的四境，因為他們沒有打開城門，他就屠殺他們，剖開所有的孕婦。<verse eid="2KI 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 15:17" />
    <char style="pn">猶大</char>王<char style="pn">亞撒利雅</char>在位第三十九年，<char style="pn">迦底</char>的兒子<char style="pn">米納恆</char>在<char style="pn">撒瑪利亞</char>作<char style="pn">以色列</char>的王，統治了十年。 <verse eid="2KI 15:17" /><verse number="18" style="v" sid="2KI 15:18" />他做耶和華眼中看為惡的事，一生的日子不離開<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>使<char style="pn">以色列</char>所犯的罪惡。<verse eid="2KI 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 15:19" />
    <char style="pn">亞述</char>王<char style="pn">普勒</char>侵入這地，<char style="pn">米納恆</char>就給了<char style="pn">普勒</char>一千他連得<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="ft" closed="false">一千他連得——相當於34.2公噸。1他連得=34.2公斤。</char></note>銀子，為要<char style="pn">普勒</char>幫助他鞏固手中的王權。 <verse eid="2KI 15:19" /><verse number="20" style="v" sid="2KI 15:20" /><char style="pn">米納恆</char>向<char style="pn">以色列</char>所有富豪徵收銀子，每人五十謝克爾<note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false">五十謝克爾——相當於570公克。1謝克爾=11.4公克。</char></note>銀子，交納給<char style="pn">亞述</char>王。於是<char style="pn">亞述</char>王回去，不在這地停留了。<verse eid="2KI 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 15:21" />
    <char style="pn">米納恆</char>其餘的事蹟和他所做的一切，不是都記在《<char style="pn">以色列</char>諸王年代志》上嗎？ <verse eid="2KI 15:21" /><verse number="22" style="v" sid="2KI 15:22" /><char style="pn">米納恆</char>與他的列祖長眠，他的兒子<char style="pn">佩卡希亞</char>接替他作王。<verse eid="2KI 15:22" /></para>
  <para style="s">以色列王佩卡希亞</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 15:23" />
    <char style="pn">猶大</char>王<char style="pn">亞撒利雅</char>在位第五十年，<char style="pn">米納恆</char>的兒子<char style="pn">佩卡希亞</char>在<char style="pn">撒瑪利亞</char>作<char style="pn">以色列</char>的王，統治了兩年。 <verse eid="2KI 15:23" /><verse number="24" style="v" sid="2KI 15:24" />他做耶和華眼中看為惡的事，不離開<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>使<char style="pn">以色列</char>所犯的罪惡。<verse eid="2KI 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 15:25" />他的軍官<char style="pn">利瑪利</char>的兒子<char style="pn">比加</char>密謀反叛他，與<char style="pn">亞珥歌伯</char>、<char style="pn">亞利耶</char>，以及跟隨<char style="pn">比加</char>的五十個<char style="pn">基列</char>人一起，在<char style="pn">撒瑪利亞</char>王宮的城堡裡攻擊他，把他殺了，接替他作王。<verse eid="2KI 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 15:26" />
    <char style="pn">佩卡希亞</char>其餘的事蹟和他所做的一切，看哪，都記在《<char style="pn">以色列</char>諸王年代志》上。<verse eid="2KI 15:26" /></para>
  <para style="s">以色列王比加</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 15:27" />
    <char style="pn">猶大</char>王<char style="pn">亞撒利雅</char>在位第五十二年，<char style="pn">利瑪利</char>的兒子<char style="pn">比加</char>在<char style="pn">撒瑪利亞</char>作<char style="pn">以色列</char>的王，統治了二十年。 <verse eid="2KI 15:27" /><verse number="28" style="v" sid="2KI 15:28" />他做耶和華眼中看為惡的事，不離開<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>使<char style="pn">以色列</char>所犯的罪惡。<verse eid="2KI 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 15:29" />
    <char style="pn">以色列</char>王<char style="pn">比加</char>年間，<char style="pn">亞述</char>王<char style="pn">提革拉·毗列色</char>前來奪取了<char style="pn">伊永</char>、<char style="pn">亞貝勒-伯瑪迦</char>、<char style="pn">雅挪哈</char>、<char style="pn">基低斯</char>、<char style="pn">哈佐</char>、<char style="pn">基列</char>、<char style="pn">加利利</char>，就是<char style="pn">拿弗他利</char>全地，並把那裡的人擄到<char style="pn">亞述</char>去了。<verse eid="2KI 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 15:30" />
    <char style="pn">烏西雅</char>的兒子<char style="pn">約坦</char>在位第二十年，<char style="pn">以拉</char>的兒子<char style="pn">何西阿</char>密謀反叛<char style="pn">利瑪利</char>的兒子<char style="pn">比加</char>，攻擊他，把他殺了，接替他作王。<verse eid="2KI 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 15:31" />
    <char style="pn">比加</char>其餘的事蹟和他所做的一切，看哪，都記在《<char style="pn">以色列</char>諸王年代志》上。<verse eid="2KI 15:31" /></para>
  <para style="s">猶大王約坦</para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 15:32" />
    <char style="pn">利瑪利</char>的兒子<char style="pn">以色列</char>王<char style="pn">比加</char>在位第二年，<char style="pn">猶大</char>王<char style="pn">烏西雅</char>的兒子<char style="pn">約坦</char>作王。 <verse eid="2KI 15:32" /><verse number="33" style="v" sid="2KI 15:33" />他作王的時候二十五歲，在<char style="pn">耶路撒冷</char>統治了十六年。他的母親名叫<char style="pn">耶路莎</char>，是<char style="pn">撒督</char>的女兒。 <verse eid="2KI 15:33" /><verse number="34" style="v" sid="2KI 15:34" /><char style="pn">約坦</char>效法他父親<char style="pn">烏西雅</char>所做的一切，做耶和華眼中看為正的事。 <verse eid="2KI 15:34" /><verse number="35" style="v" sid="2KI 15:35" />只是那些高壇還沒有除掉，百姓仍舊在高壇獻祭燒香。</para>
  <para style="p" vid="2KI 15:35">
    <char style="pn">約坦</char>修築了耶和華殿的上門。 <verse eid="2KI 15:35" /><verse number="36" style="v" sid="2KI 15:36" /><char style="pn">約坦</char>其餘的事蹟和他所做的，不是都記在《<char style="pn">猶大</char>諸王年代志》上嗎？ <verse eid="2KI 15:36" /><verse number="37" style="v" sid="2KI 15:37" />在那些日子，耶和華開始派遣<char style="pn">亞蘭</char>王<char style="pn">利汛</char>和<char style="pn">利瑪利</char>的兒子<char style="pn">比加</char>來進攻<char style="pn">猶大</char>。 <verse eid="2KI 15:37" /><verse number="38" style="v" sid="2KI 15:38" /><char style="pn">約坦</char>與他的列祖長眠，葬在先祖<char style="pn">大衛</char>的城，與他的列祖在一起；他的兒子<char style="pn">亞哈斯</char>接替他作王。<verse eid="2KI 15:38" /></para>
  <chapter eid="2KI 15" />
  <chapter number="16" style="c" sid="2KI 16" />
  <para style="s">猶大王亞哈斯</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 16:1" />
    <char style="pn">利瑪利</char>的兒子<char style="pn">比加</char>在位第十七年，<char style="pn">猶大</char>王<char style="pn">約坦</char>的兒子<char style="pn">亞哈斯</char>作王。 <verse eid="2KI 16:1" /><verse number="2" style="v" sid="2KI 16:2" /><char style="pn">亞哈斯</char>作王的時候二十歲，在<char style="pn">耶路撒冷</char>統治了十六年。他沒有像他先祖<char style="pn">大衛</char>那樣，做他的神耶和華眼中看為正的事， <verse eid="2KI 16:2" /><verse number="3" style="v" sid="2KI 16:3" />而是走<char style="pn">以色列</char>王的道路，甚至效法耶和華在<char style="pn">以色列</char>子民面前趕出的那些民族的可憎行為，使自己的兒子經火， <verse eid="2KI 16:3" /><verse number="4" style="v" sid="2KI 16:4" />又在高壇上、丘陵上、各青翠樹下獻祭燒香。<verse eid="2KI 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 16:5" />於是，<char style="pn">亞蘭</char>王<char style="pn">利汛</char>會同<char style="pn">利瑪利</char>的兒子<char style="pn">以色列</char>王<char style="pn">比加</char>上來攻打<char style="pn">耶路撒冷</char>。他們圍困<char style="pn">亞哈斯</char>，卻不能戰勝。 <verse eid="2KI 16:5" /><verse number="6" style="v" sid="2KI 16:6" />那時，<char style="pn">亞蘭</char>王<char style="pn">利汛</char>把<char style="pn">埃拉特</char>收歸<char style="pn">亞蘭</char>，將<char style="pn">猶大</char>人從<char style="pn">埃拉特</char>趕走。<char style="pn">以東</char>人就來到<char style="pn">埃拉特</char>，住在那裡，直到今日。<verse eid="2KI 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 16:7" />
    <char style="pn">亞哈斯</char>派遣使者去見<char style="pn">亞述</char>王<char style="pn">提革拉·毗列色</char>，說：「我是你的僕人、你的兒子。求你上來，救我脫離那起來攻擊我的<char style="pn">亞蘭</char>王和<char style="pn">以色列</char>王。」 <verse eid="2KI 16:7" /><verse number="8" style="v" sid="2KI 16:8" /><char style="pn">亞哈斯</char>把耶和華殿中和王宮庫房裡的金銀都拿去，送給<char style="pn">亞述</char>王作禮物。 <verse eid="2KI 16:8" /><verse number="9" style="v" sid="2KI 16:9" /><char style="pn">亞述</char>王答應了<char style="pn">亞哈斯</char>，<char style="pn">亞述</char>王就上去攻打<char style="pn">大馬士革</char>，攻取了那城。他把城裡的人擄到<char style="pn">吉珥</char>，把<char style="pn">利汛</char>殺了。<verse eid="2KI 16:9" /></para>
  <para style="s">亞哈斯供奉偶像</para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 16:10" />
    <char style="pn">亞哈斯</char>王去<char style="pn">大馬士革</char>會見<char style="pn">亞述</char>王<char style="pn">提革拉·毗列色</char>。<char style="pn">亞哈斯</char>王看到了<char style="pn">大馬士革</char>的祭壇，就把祭壇的圖樣以及詳細構造的設計圖，送到祭司<char style="pn">烏利亞</char>那裡。 <verse eid="2KI 16:10" /><verse number="11" style="v" sid="2KI 16:11" />祭司<char style="pn">烏利亞</char>完全照著<char style="pn">亞哈斯</char>王從<char style="pn">大馬士革</char>送來的圖樣，築了一座祭壇。這樣，祭司<char style="pn">烏利亞</char>在<char style="pn">亞哈斯</char>王從<char style="pn">大馬士革</char>回來之前，就完工了。 <verse eid="2KI 16:11" /><verse number="12" style="v" sid="2KI 16:12" />王從<char style="pn">大馬士革</char>回來，看見了那祭壇，王就上前來，在祭壇上獻祭。 <verse eid="2KI 16:12" /><verse number="13" style="v" sid="2KI 16:13" />他燒獻燔祭和素祭，澆奠了酒祭，把平安祭的血灑在祭壇上。 <verse eid="2KI 16:13" /><verse number="14" style="v" sid="2KI 16:14" />至於耶和華面前的銅祭壇，他把它從耶和華殿和新祭壇之間，從殿宇前面搬走了，放在新祭壇<note caller="+" style="f"><char style="fr" closed="false">16:14 </char><char style="ft" closed="false">新祭壇——原文直譯「那祭壇」。</char></note>的北邊。<verse eid="2KI 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 16:15" />
    <char style="pn">亞哈斯</char>王吩咐祭司<char style="pn">烏利亞</char>說：「你要在我的大祭壇上燒獻清晨的燔祭、傍晚的素祭，王的燔祭和素祭，所有國民的燔祭、素祭和酒祭；一切燔祭的血和祭物的血都要灑在它上面。至於銅祭壇，那是給我求問用的。」 <verse eid="2KI 16:15" /><verse number="16" style="v" sid="2KI 16:16" />祭司<char style="pn">烏利亞</char>就照著<char style="pn">亞哈斯</char>王所吩咐的一切做了。<verse eid="2KI 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 16:17" />
    <char style="pn">亞哈斯</char>王拆掉銅盆底座的鑲板，把盆從底座上取下來；又把銅海從底下的銅牛上拿下來，放在鋪石地上。 <verse eid="2KI 16:17" /><verse number="18" style="v" sid="2KI 16:18" />他還為了<char style="pn">亞述</char>王的緣故，把耶和華殿中為安息日建造的廊子，以及王從外面進殿的入口，都從耶和華的殿拆除了。<verse eid="2KI 16:18" /></para>
  <para style="s">亞哈斯去世</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 16:19" />
    <char style="pn">亞哈斯</char>所做的其餘事蹟，不是都記在《<char style="pn">猶大</char>諸王年代志》上嗎？ <verse eid="2KI 16:19" /><verse number="20" style="v" sid="2KI 16:20" /><char style="pn">亞哈斯</char>與他的列祖長眠，葬在<char style="pn">大衛</char>城，與他的列祖在一起；他的兒子<char style="pn">希西加</char>接替他作王。<verse eid="2KI 16:20" /></para>
  <chapter eid="2KI 16" />
  <chapter number="17" style="c" sid="2KI 17" />
  <para style="s">以色列王何西阿</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 17:1" />
    <char style="pn">猶大</char>王<char style="pn">亞哈斯</char>在位第十二年，<char style="pn">以拉</char>的兒子<char style="pn">何西阿</char>在<char style="pn">撒瑪利亞</char>作<char style="pn">以色列</char>的王，統治了九年。 <verse eid="2KI 17:1" /><verse number="2" style="v" sid="2KI 17:2" />他做耶和華眼中看為惡的事，只不過沒有像他之前的那些<char style="pn">以色列</char>王。<verse eid="2KI 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 17:3" />
    <char style="pn">亞述</char>王<char style="pn">撒縵以色</char>上來攻打<char style="pn">何西阿</char>，<char style="pn">何西阿</char>就臣服於他，向他進貢。 <verse eid="2KI 17:3" /><verse number="4" style="v" sid="2KI 17:4" />後來<char style="pn">亞述</char>王發現了<char style="pn">何西阿</char>的陰謀，就是他派遣使者去見<char style="pn">埃及</char>王<char style="pn">梭</char>，不再每年向<char style="pn">亞述</char>王進貢。於是<char style="pn">亞述</char>王把他關押起來，囚禁在牢房裡。 <verse eid="2KI 17:4" /><verse number="5" style="v" sid="2KI 17:5" /><char style="pn">亞述</char>王還入侵<char style="pn">以色列</char>全地，上來攻打<char style="pn">撒瑪利亞</char>，圍困這城三年。<verse eid="2KI 17:5" /></para>
  <para style="s">以色列國淪陷</para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 17:6" />
    <char style="pn">何西阿</char>在位第九年，<char style="pn">亞述</char>王攻取了<char style="pn">撒瑪利亞</char>。他把<char style="pn">以色列</char>人擄到<char style="pn">亞述</char>，安置在<char style="pn">哈臘</char>，<char style="pn">歌散</char>河流域的<char style="pn">哈博</char>，以及<char style="pn">米底亞</char><note caller="+" style="f"><char style="fr" closed="false">17:6 </char><char style="ft" closed="false">米底亞——原文作「瑪代」。</char></note>的城鎮。<verse eid="2KI 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 17:7" />這是因為<char style="pn">以色列</char>子民犯罪，得罪了耶和華他們的神——就是從<char style="pn">埃及</char>地和<char style="pn">埃及</char>王法老手下把他們帶上來的那一位，而去敬畏別的神， <verse eid="2KI 17:7" /><verse number="8" style="v" sid="2KI 17:8" />隨從耶和華在<char style="pn">以色列</char>子民面前趕出的那些民族的習俗，以及<char style="pn">以色列</char>諸王所推行的習俗。 <verse eid="2KI 17:8" /><verse number="9" style="v" sid="2KI 17:9" /><char style="pn">以色列</char>子民暗中對他們的神耶和華做了不義的事，在他們所有的城鎮，從守望樓到堡壘城，為自己建造了高壇。 <verse eid="2KI 17:9" /><verse number="10" style="v" sid="2KI 17:10" />他們在各高丘上、各青翠樹下，為自己豎立神柱和<char style="pn">亞舍拉</char>柱。 <verse eid="2KI 17:10" /><verse number="11" style="v" sid="2KI 17:11" />他們像耶和華在他們面前驅逐的那些國民一樣，在所有的高壇燒香，並且做惡事來惹怒耶和華。 <verse eid="2KI 17:11" /><verse number="12" style="v" sid="2KI 17:12" />他們服事偶像，儘管耶和華吩咐過他們不可做這樣的事。 <verse eid="2KI 17:12" /><verse number="13" style="v" sid="2KI 17:13" />所以，耶和華藉著眾先知、眾先見警誡<char style="pn">以色列</char>和<char style="pn">猶大</char>，說：「你們要轉離自己邪惡的道路，謹守我的誡命、律例，遵行我的一切律法，這律法是我所吩咐你們祖先，又藉著我的僕人眾先知傳給你們的。」<verse eid="2KI 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 17:14" />他們卻不聽從，反而像他們的祖先一樣硬著頸項，不信靠耶和華他們的神。 <verse eid="2KI 17:14" /><verse number="15" style="v" sid="2KI 17:15" />他們厭棄耶和華的定例和他與他們祖先所立的約，厭棄他對他們的警誡。他們隨從虛無的神明，以致自己也變得虛妄；又隨從周圍的那些民族，就是耶和華所吩咐他們不可效法的外邦人。<verse eid="2KI 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 17:16" />他們離棄了他們的神耶和華的一切誡命，為自己造了兩個牛犢的鑄像，製作了<char style="pn">亞舍拉</char>柱，向天上的萬象下拜，服事<char style="pn">巴力</char>。 <verse eid="2KI 17:16" /><verse number="17" style="v" sid="2KI 17:17" />他們使自己的兒女經火，並且占卜、行法術，出賣自己去做耶和華眼中看為惡的事，惹怒他。<verse eid="2KI 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 17:18" />於是耶和華對<char style="pn">以色列</char>大大發怒，把他們從自己面前驅逐，唯有<char style="pn">猶大</char>支派被留下。 <verse eid="2KI 17:18" /><verse number="19" style="v" sid="2KI 17:19" />然而，連<char style="pn">猶大</char>也不遵守他們神耶和華的誡命，而是隨從<char style="pn">以色列</char>所推行的習俗。 <verse eid="2KI 17:19" /><verse number="20" style="v" sid="2KI 17:20" />於是耶和華厭棄了<char style="pn">以色列</char>的所有後裔，苦待他們，把他們交在搶掠者的手中，最終把他們從自己面前趕走了。<verse eid="2KI 17:20" /></para>
  <para style="s">以色列歷史概述</para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 17:21" />耶和華把<char style="pn">以色列</char>從<char style="pn">大衛</char>家撕去之後，人們立了<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>為王。<char style="pn">耶羅波安</char>卻引誘<char style="pn">以色列</char>不跟從耶和華，使他們犯了大罪。 <verse eid="2KI 17:21" /><verse number="22" style="v" sid="2KI 17:22" /><char style="pn">以色列</char>子民隨從<char style="pn">耶羅波安</char>所行的一切罪惡，總不離開， <verse eid="2KI 17:22" /><verse number="23" style="v" sid="2KI 17:23" />直到耶和華把<char style="pn">以色列</char>從自己面前驅逐，正如藉著他的僕人眾先知所宣告的。這樣<char style="pn">以色列</char>人就從自己的國土被擄到<char style="pn">亞述</char>，直到今日。<verse eid="2KI 17:23" /></para>
  <para style="s">外邦移民入住以色列</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 17:24" />
    <char style="pn">亞述</char>王從<char style="pn">巴比倫</char>、<char style="pn">古它</char>、<char style="pn">阿瓦</char>、<char style="pn">哈馬</char>和<char style="pn">西法瓦音</char>遷移人過來，安置在<char style="pn">撒瑪利亞</char>的城鎮，取代<char style="pn">以色列</char>子民。這些人就占有了<char style="pn">撒瑪利亞</char>，住在它的城鎮。 <verse eid="2KI 17:24" /><verse number="25" style="v" sid="2KI 17:25" />這些人開始在那裡居住時，不敬畏耶和華，耶和華就派遣獅子到他們中間，咬死他們中間的一些人。 <verse eid="2KI 17:25" /><verse number="26" style="v" sid="2KI 17:26" />有人稟告<char style="pn">亞述</char>王，說：「你所遷徙並安置在<char style="pn">撒瑪利亞</char>城鎮的那些國民，不知道當地之神的規矩，神就派遣獅子到他們中間。看哪，獅子把他們咬死了，因為他們不知道當地之神的規矩。」<verse eid="2KI 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 17:27" />
    <char style="pn">亞述</char>王就吩咐說：「派去一個從那地擄來的祭司，讓他去住在那裡，指教他們當地之神的規矩。」 <verse eid="2KI 17:27" /><verse number="28" style="v" sid="2KI 17:28" />於是有一個從<char style="pn">撒瑪利亞</char>被擄去的祭司回來住在<char style="pn">伯特利</char>，指教他們如何敬畏耶和華。<verse eid="2KI 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 17:29" />可是各國各族的人仍然製造自己的神像，放在<char style="pn">撒瑪利亞</char>人建造的高壇廟宇裡；各國各族的人在所住的城鎮都這樣做。 <verse eid="2KI 17:29" /><verse number="30" style="v" sid="2KI 17:30" /><char style="pn">巴比倫</char>人製造<char style="pn">疏割比訥</char>，<char style="pn">古它</char>人製造<char style="pn">匿甲</char>，<char style="pn">哈馬</char>人製造<char style="pn">亞示瑪</char>， <verse eid="2KI 17:30" /><verse number="31" style="v" sid="2KI 17:31" /><char style="pn">亞瓦</char>人製造<char style="pn">尼布哈茲</char>和<char style="pn">塔珥塔克</char>，<char style="pn">西法瓦音</char>人把兒女用火焚燒給<char style="pn">西法瓦音</char>的神<char style="pn">亞得米勒</char>和<char style="pn">亞拿米勒</char>。 <verse eid="2KI 17:31" /><verse number="32" style="v" sid="2KI 17:32" />他們既畏懼耶和華，又從他們各類的人中為自己設立高壇的祭司，在高壇廟宇裡為他們服事。 <verse eid="2KI 17:32" /><verse number="33" style="v" sid="2KI 17:33" />他們又畏懼耶和華，又照著被遷徙之前本國的習俗來敬拜他們的神明。<verse eid="2KI 17:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 17:34" />這些人至今還是照著先前的習俗去行。他們不敬畏耶和華，也不遵行律例和法規，就是耶和華所吩咐<char style="pn">雅各</char>子孫的律法和誡命——這<char style="pn">雅各</char>，耶和華給他取名為<char style="pn">以色列</char>。 <verse eid="2KI 17:34" /><verse number="35" style="v" sid="2KI 17:35" />耶和華曾與他們立約，吩咐他們說：「你們不可敬畏別的神，不可向它們下拜，不可服事它們，不可向它們獻祭。 <verse eid="2KI 17:35" /><verse number="36" style="v" sid="2KI 17:36" />只有耶和華，就是以偉大的能力和伸出的膀臂把你們從<char style="pn">埃及</char>地帶上來的那一位，你們要敬畏他，向他下拜，向他獻祭。 <verse eid="2KI 17:36" /><verse number="37" style="v" sid="2KI 17:37" />他為你們寫下的律例、法規、律法、誡命，你們要終身謹守遵行，不可敬畏別的神。 <verse eid="2KI 17:37" /><verse number="38" style="v" sid="2KI 17:38" />你們不可忘記我與你們所立的約，不可敬畏別的神。 <verse eid="2KI 17:38" /><verse number="39" style="v" sid="2KI 17:39" />你們只要敬畏耶和華你們的神，他就會解救你們脫離一切仇敵的手。」<verse eid="2KI 17:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2KI 17:40" />然而，這些人沒有聽從，還是照著他們先前的習俗去行。 <verse eid="2KI 17:40" /><verse number="41" style="v" sid="2KI 17:41" />這些民族既畏懼耶和華，又敬拜他們的偶像。這些人的孩子、他們的子子孫孫也都這樣，他們祖先怎樣做，他們也怎樣做，直到今日。<verse eid="2KI 17:41" /></para>
  <chapter eid="2KI 17" />
  <chapter number="18" style="c" sid="2KI 18" />
  <para style="s">猶大王希西加</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 18:1" />
    <char style="pn">以拉</char>的兒子<char style="pn">以色列</char>王<char style="pn">何西阿</char>在位第三年，<char style="pn">猶大</char>王<char style="pn">亞哈斯</char>的兒子<char style="pn">希西加</char>作王。 <verse eid="2KI 18:1" /><verse number="2" style="v" sid="2KI 18:2" />他作王的時候二十五歲，在<char style="pn">耶路撒冷</char>統治了二十九年。他的母親名叫<char style="pn">婭比</char>，是<char style="pn">撒迦利亞</char>的女兒。 <verse eid="2KI 18:2" /><verse number="3" style="v" sid="2KI 18:3" />他效法他的先祖<char style="pn">大衛</char>所做的一切，做耶和華眼中看為正的事。 <verse eid="2KI 18:3" /><verse number="4" style="v" sid="2KI 18:4" />他除掉高壇，打碎神柱，砍倒<char style="pn">亞舍拉</char>柱，還打碎了<char style="pn">摩西</char>製作的銅蛇，<char style="pn">以色列</char>子民直到那時候一直向這銅蛇燒香，稱它為「<char style="pn">內胡什坦</char>」。<verse eid="2KI 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 18:5" />他依靠耶和華<char style="pn">以色列</char>的神，在他之後、在他之前所有的<char style="pn">猶大</char>王中沒有一個能與他相比的。 <verse eid="2KI 18:5" /><verse number="6" style="v" sid="2KI 18:6" />他緊緊跟隨耶和華，沒有偏離不跟隨他，而是遵守耶和華所指示<char style="pn">摩西</char>的誡命。<verse eid="2KI 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 18:7" />耶和華與他同在，他無論往哪裡去都通達。他背叛了<char style="pn">亞述</char>王，不再臣服於他。 <verse eid="2KI 18:7" /><verse number="8" style="v" sid="2KI 18:8" /><char style="pn">希西加</char>擊敗<char style="pn">非利士</char>人，直到<char style="pn">加沙</char>，攻取了它境內的守望樓以及堡壘城。<verse eid="2KI 18:8" /></para>
  <para style="s">以色列陷落的理由</para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 18:9" />到了<char style="pn">希西加</char>王第四年，就是<char style="pn">以拉</char>的兒子<char style="pn">以色列</char>王<char style="pn">何西阿</char>第七年，<char style="pn">亞述</char>王<char style="pn">撒縵以色</char>上來攻打<char style="pn">撒瑪利亞</char>，圍困它。 <verse eid="2KI 18:9" /><verse number="10" style="v" sid="2KI 18:10" />過了三年，它被攻取。<char style="pn">希西加</char>在位第六年，就是<char style="pn">以色列</char>王<char style="pn">何西阿</char>九年，<char style="pn">撒瑪利亞</char>被攻取了。 <verse eid="2KI 18:10" /><verse number="11" style="v" sid="2KI 18:11" /><char style="pn">亞述</char>王把<char style="pn">以色列</char>人擄到<char style="pn">亞述</char>，安置在<char style="pn">哈臘</char>，<char style="pn">歌散</char>河流域的<char style="pn">哈博</char>，以及<char style="pn">米底亞</char><note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">米底亞——原文作「瑪代」。</char></note>的城鎮。 <verse eid="2KI 18:11" /><verse number="12" style="v" sid="2KI 18:12" />這是因他們沒有聽從他們的神耶和華的話，違背他的約；他們對耶和華的僕人<char style="pn">摩西</char>所吩咐的一切，既不聽從，也不遵行。<verse eid="2KI 18:12" /></para>
  <para style="s">西納基立入侵</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 18:13" />
    <char style="pn">希西加</char>王十四年，<char style="pn">亞述</char>王<char style="pn">西納基立</char>上來攻打<char style="pn">猶大</char>所有堅固的城，攻取了它們。 <verse eid="2KI 18:13" /><verse number="14" style="v" sid="2KI 18:14" /><char style="pn">猶大</char>王<char style="pn">希西加</char>派人到<char style="pn">拉吉</char>去見<char style="pn">亞述</char>王，說：「我錯了，求你從我這裡撤離吧！你對我的處置，我都接受。」於是<char style="pn">亞述</char>王向<char style="pn">猶大</char>王<char style="pn">希西加</char>索要三百他連得<note caller="+" style="f"><char style="fr" closed="false">18:14 </char><char style="ft" closed="false">三百他連得——相當於10.3公噸。1他連得=34.2公斤。</char></note>銀子、三十他連得<note caller="+" style="f"><char style="fr" closed="false">18:14 </char><char style="ft" closed="false">三十他連得——相當於1公噸。</char></note>金子。 <verse eid="2KI 18:14" /><verse number="15" style="v" sid="2KI 18:15" /><char style="pn">希西加</char>就把耶和華殿中和王宮庫房裡所有的銀子都交出來。 <verse eid="2KI 18:15" /><verse number="16" style="v" sid="2KI 18:16" />那時，<char style="pn">希西加</char>把耶和華聖殿的門上和柱子上的金子<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">金子——輔助詞語。</char></note>拆下來，交給了<char style="pn">亞述</char>王，都是<char style="pn">猶大</char>王<char style="pn">希西加</char>原來貼在其上的。<verse eid="2KI 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 18:17" />但<char style="pn">亞述</char>王還是派遣元帥、參謀長、將軍<note caller="+" style="f"><char style="fr" closed="false">18:17 </char><char style="ft" closed="false">元帥、參謀長、將軍——音譯作「塔珥坦、拉伯撒利、拉伯沙基」；都是亞述高級官員的頭銜。</char></note>率領大軍，從<char style="pn">拉吉</char>往<char style="pn">耶路撒冷</char>，到<char style="pn">希西加</char>王那裡去。他們就上來，到了<char style="pn">耶路撒冷</char>。他們上來後，前來站在上池的溝渠旁，通往漂布場的大道上。 <verse eid="2KI 18:17" /><verse number="18" style="v" sid="2KI 18:18" />他們呼叫王，於是<char style="pn">希勒加</char>的兒子宮廷總管<char style="pn">以利亞敬</char>，書記<char style="pn">舍伯納</char>，以及<char style="pn">亞薩</char>的兒子史官<char style="pn">約亞</char>，都出來到他們那裡。<verse eid="2KI 18:18" /></para>
  <para style="s">亞述的將軍喊話</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 18:19" />將軍對他們說：</para>
  <para style="mi" vid="2KI 18:19">「請你們告訴<char style="pn">希西加</char>，<char style="pn">亞述</char>大王如此說：你所依靠的算什麼依靠？ <verse eid="2KI 18:19" /><verse number="20" style="v" sid="2KI 18:20" />你說你有作戰的謀略和實力，但那只是嘴上的空談！你現在依靠誰，竟敢背叛我！ <verse eid="2KI 18:20" /><verse number="21" style="v" sid="2KI 18:21" />現在看哪，你依靠的<char style="pn">埃及</char>是壓裂的蘆葦杖；如果有人倚靠它，它就會扎入那人的手掌，把手掌刺透。<char style="pn">埃及</char>王法老對所有依靠他的人都是這樣。 <verse eid="2KI 18:21" /><verse number="22" style="v" sid="2KI 18:22" />你們也許會對我說『我們依靠耶和華我們的神』，但<char style="pn">希西加</char>除掉了這神的高壇和祭壇，還對<char style="pn">猶大</char>和<char style="pn">耶路撒冷</char>的人說『你們當在<char style="pn">耶路撒冷</char>這祭壇前敬拜！』難道耶和華不就是這神嗎？<verse eid="2KI 18:22" /></para>
  <para style="mi">
    <verse number="23" style="v" sid="2KI 18:23" />現在你可以與我主<char style="pn">亞述</char>王下一個賭注：你那邊如果能給出相應的騎士，我就給你兩千匹馬； <verse eid="2KI 18:23" /><verse number="24" style="v" sid="2KI 18:24" />如果不能，你怎能擊退我主的臣僕中至小的一個軍官呢？你竟敢依靠<char style="pn">埃及</char>的戰車和馬兵！ <verse eid="2KI 18:24" /><verse number="25" style="v" sid="2KI 18:25" />現在，我上來攻打這地方，要把它毀滅，難道不是出於耶和華嗎？是耶和華對我說『你要上去攻打這地，把它毀滅！』」<verse eid="2KI 18:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="2KI 18:26" />
    <char style="pn">希勒加</char>的兒子<char style="pn">以利亞敬</char>、<char style="pn">舍伯納</char>、<char style="pn">約亞</char>對將軍說：「求你用<char style="pn">亞蘭</char>語對僕人們說話，因為我們聽得懂；不要用<char style="pn">猶大</char>話對我們說話，免得達到城牆上眾人的耳中。」<verse eid="2KI 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 18:27" />將軍卻對他們說：「難道我的主人派我來，只對你和你的主人說這些話嗎？不也對那些坐在城牆上，將與你們一同吃自己糞、喝自己尿的人說話嗎？」<verse eid="2KI 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 18:28" />然後，將軍站著用<char style="pn">猶大</char>話大聲呼喊，宣告說：</para>
  <para style="mi" vid="2KI 18:28">「你們要聽<char style="pn">亞述</char>大王的話！ <verse eid="2KI 18:28" /><verse number="29" style="v" sid="2KI 18:29" />王如此說：『不要讓<char style="pn">希西加</char>欺哄你們，因為他不能解救你們脫離王的手； <verse eid="2KI 18:29" /><verse number="30" style="v" sid="2KI 18:30" />也不要讓<char style="pn">希西加</char>說服你們依靠耶和華，因為他會說：耶和華必定解救我們，這城必不落入<char style="pn">亞述</char>王手中。』<verse eid="2KI 18:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="2KI 18:31" />「你們不要聽<char style="pn">希西加</char>的話，因為<char style="pn">亞述</char>王如此說：『你們要與我和好，出來向我投降，各人就可以吃自己葡萄樹和無花果樹的果實，喝自己水窖裡的水； <verse eid="2KI 18:31" /><verse number="32" style="v" sid="2KI 18:32" />以後我會來，把你們帶到一個地方，與你們本土一樣，是一個有五穀和新酒的地方，一個有糧食和葡萄園的地方，有橄欖油和蜂蜜的地方，好使你們存活，不至於死。不要聽<char style="pn">希西加</char>，因為他誤導你們，說：耶和華必解救我們。 <verse eid="2KI 18:32" /><verse number="33" style="v" sid="2KI 18:33" />列國的神明中，有哪一個曾真正解救自己的國土脫離<char style="pn">亞述</char>王的手呢？ <verse eid="2KI 18:33" /><verse number="34" style="v" sid="2KI 18:34" /><char style="pn">哈馬</char>和<char style="pn">阿爾帕</char>的神在哪裡呢？<char style="pn">西法瓦音</char>、<char style="pn">希拿</char>和<char style="pn">伊瓦</char>的神在哪裡呢？難道他們曾解救<char style="pn">撒瑪利亞</char>脫離我的手嗎？ <verse eid="2KI 18:34" /><verse number="35" style="v" sid="2KI 18:35" />這些國所有的神明中，有哪一個曾解救自己的國土脫離我的手呢？難道耶和華會解救<char style="pn">耶路撒冷</char>脫離我的手嗎？』」<verse eid="2KI 18:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="2KI 18:36" />眾人都默不作聲，一句也不回應，因為<char style="pn">希西加</char>王有令說：「不許回應他。」 <verse eid="2KI 18:36" /><verse number="37" style="v" sid="2KI 18:37" /><char style="pn">希勒加</char>的兒子宮廷總管<char style="pn">以利亞敬</char>，書記<char style="pn">舍伯納</char>，以及<char style="pn">亞薩</char>的兒子史官<char style="pn">約亞</char>，都撕裂衣服來到<char style="pn">希西加</char>那裡，把將軍的話告訴了他。<verse eid="2KI 18:37" /></para>
  <chapter eid="2KI 18" />
  <chapter number="19" style="c" sid="2KI 19" />
  <para style="s">希西加詢問以賽亞</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 19:1" />
    <char style="pn">希西加</char>王聽了就撕裂衣服，披上麻布，進入耶和華的殿。 <verse eid="2KI 19:1" /><verse number="2" style="v" sid="2KI 19:2" />他派遣宮廷總管<char style="pn">以利亞敬</char>、書記<char style="pn">舍伯納</char>和一些年長的祭司，個個披上麻布，到<char style="pn">亞摩斯</char>的兒子先知<char style="pn">以賽亞</char>那裡。 <verse eid="2KI 19:2" /><verse number="3" style="v" sid="2KI 19:3" />他們對他說：「<char style="pn">希西加</char>如此說：『今天是一個患難、責罰、恥辱的日子；因為嬰孩已經臨盆，我們卻沒有力氣生下來。 <verse eid="2KI 19:3" /><verse number="4" style="v" sid="2KI 19:4" />那位將軍的主人<char style="pn">亞述</char>王派他來辱罵永生的神，或許你的神耶和華聽見了他的一切話，就會斥責所聽見的那些話。因此，求你為倖存的餘剩之民獻上禱告。』」<verse eid="2KI 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 19:5" />當<char style="pn">希西加</char>王的臣僕來到<char style="pn">以賽亞</char>那裡時， <verse eid="2KI 19:5" /><verse number="6" style="v" sid="2KI 19:6" /><char style="pn">以賽亞</char>對他們說：「你們要這樣告訴你們的主人：『耶和華如此說：你不要因為聽見<char style="pn">亞述</char>王的僕人們褻瀆我的話而害怕。 <verse eid="2KI 19:6" /><verse number="7" style="v" sid="2KI 19:7" />看哪！我要把一個靈放入<char style="pn">亞述</char>王裡面，讓他一聽見傳來的風聲就返回本土；我必使他在那裡倒在刀下。』」<verse eid="2KI 19:7" /></para>
  <para style="s">西納基立撤離之前的威脅</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 19:8" />將軍聽到<char style="pn">亞述</char>王已拔營離開<char style="pn">拉吉</char>，就撤退了，與正在攻打<char style="pn">立拿</char>的<char style="pn">亞述</char>王會合。 <verse eid="2KI 19:8" /><verse number="9" style="v" sid="2KI 19:9" /><char style="pn">亞述</char>王聽到了有關<char style="pn">庫實</char>王<char style="pn">特哈加</char>出來要與自己爭戰的消息。他就再次派遣使者到<char style="pn">希西加</char>那裡，並吩咐使者們： <verse eid="2KI 19:9" /><verse number="10" style="v" sid="2KI 19:10" />「你們要對<char style="pn">猶大</char>王<char style="pn">希西加</char>這樣說：不要讓你所依靠的神欺哄你，說：『<char style="pn">耶路撒冷</char>必不落入<char style="pn">亞述</char>王的手中。』 <verse eid="2KI 19:10" /><verse number="11" style="v" sid="2KI 19:11" />看哪！你必定聽說過<char style="pn">亞述</char>列王向各國所行的，就是把它們滅絕淨盡；難道只有你能得解救嗎？ <verse eid="2KI 19:11" /><verse number="12" style="v" sid="2KI 19:12" />我祖先所毀滅的，有<char style="pn">歌散</char>、<char style="pn">哈蘭</char>和<char style="pn">利色</char>，還有在<char style="pn">提拉撒</char>的<char style="pn">伊甸</char>子孫，那些國的神明解救他們了嗎？ <verse eid="2KI 19:12" /><verse number="13" style="v" sid="2KI 19:13" /><char style="pn">哈馬</char>的王、<char style="pn">阿爾帕</char>的王，<char style="pn">拉伊爾</char>、<char style="pn">西法瓦音</char><note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="ft" closed="false">拉伊爾、西法瓦音——傳統譯法作「西法瓦音城」。</char></note>、<char style="pn">希拿</char>、<char style="pn">伊瓦</char>的眾王，如今都在哪裡呢？」<verse eid="2KI 19:13" /></para>
  <para style="s">希西加的禱告</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 19:14" />
    <char style="pn">希西加</char>從使者們手裡接過書信，讀完了，就上耶和華的殿，在耶和華面前展開書信。 <verse eid="2KI 19:14" /><verse number="15" style="v" sid="2KI 19:15" /><char style="pn">希西加</char>在耶和華面前禱告，說：</para>
  <para style="mi" vid="2KI 19:15">「坐在基路伯之上的耶和華，<char style="pn">以色列</char>的神哪！你——唯獨你是地上萬國的神，是你造了諸天和大地。 <verse eid="2KI 19:15" /><verse number="16" style="v" sid="2KI 19:16" />耶和華啊，求你側耳聽！耶和華啊，求你睜眼看！聽聽<char style="pn">西納基立</char>派人來辱罵永生神的話！ <verse eid="2KI 19:16" /><verse number="17" style="v" sid="2KI 19:17" />耶和華啊，<char style="pn">亞述</char>列王確實使各國和它們的國土荒廢， <verse eid="2KI 19:17" /><verse number="18" style="v" sid="2KI 19:18" />又把它們的神像扔進火中；那些神像之所以被滅絕，是因為它們不是神，只不過是人手所造的，是用木頭、石頭造的！ <verse eid="2KI 19:18" /><verse number="19" style="v" sid="2KI 19:19" />耶和華我們的神哪，現在求你拯救我們脫離<char style="pn">亞述</char>王的手，使地上萬國都知道，唯獨你耶和華是神！」<verse eid="2KI 19:19" /></para>
  <para style="s">耶和華的回應</para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 19:20" />
    <char style="pn">亞摩斯</char>的兒子<char style="pn">以賽亞</char>就派人到<char style="pn">希西加</char>那裡，說：「<char style="pn">以色列</char>的神耶和華如此說：你因<char style="pn">亞述</char>王<char style="pn">西納基立</char>向我所作的禱告，我已經垂聽了。 <verse eid="2KI 19:20" /><verse number="21" style="v" sid="2KI 19:21" />以下是耶和華針對<char style="pn">西納基立</char>說的話：</para>
  <para style="q1" vid="2KI 19:21">少女<char style="pn">錫安</char>藐視你、嘲笑你，</para>
  <para style="q1" vid="2KI 19:21">女子<char style="pn">耶路撒冷</char>在你背後搖頭。<verse eid="2KI 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2KI 19:22" />你辱罵誰、褻瀆誰呢？</para>
  <para style="q1" vid="2KI 19:22">你揚起聲音、</para>
  <para style="q1" vid="2KI 19:22">高舉眼目是針對誰呢？</para>
  <para style="q1" vid="2KI 19:22">是針對<char style="pn">以色列</char>的聖者！<verse eid="2KI 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2KI 19:23" />你藉著你的使者辱罵主<note caller="+" style="f"><char style="fr" closed="false">19:23 </char><char style="ft" closed="false">主——有古抄本作「耶和華」；馬索拉文本作「我主」。</char></note>；</para>
  <para style="q1" vid="2KI 19:23">你又說：</para>
  <para style="q1" vid="2KI 19:23">『我帶著眾多的戰車，</para>
  <para style="q1" vid="2KI 19:23">上到群山的高峰</para>
  <para style="q1" vid="2KI 19:23">和<char style="pn">黎巴嫩</char>的極深之處；</para>
  <para style="q1" vid="2KI 19:23">我砍伐<char style="pn">黎巴嫩</char>最高的香柏樹</para>
  <para style="q1" vid="2KI 19:23">和最好的松樹，</para>
  <para style="q1" vid="2KI 19:23">來到它極遠的居所</para>
  <para style="q1" vid="2KI 19:23">和最茂密的森林；<verse eid="2KI 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2KI 19:24" />我挖井喝了外族人的水，</para>
  <para style="q1" vid="2KI 19:24">我的腳掌踏乾了<char style="pn">埃及</char>一切的河流。』<verse eid="2KI 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="2KI 19:25" />我從遠古以來所立的，</para>
  <para style="q1" vid="2KI 19:25">在太初的日子所定的，</para>
  <para style="q1" vid="2KI 19:25">難道你沒有聽過嗎？</para>
  <para style="q1" vid="2KI 19:25">現在我使它應驗了，</para>
  <para style="q1" vid="2KI 19:25">就是讓你把堅固的城變為荒廢的石堆——<verse eid="2KI 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2KI 19:26" />那時城裡的居民軟弱無力，驚惶羞愧，</para>
  <para style="q1" vid="2KI 19:26">像田間蔬草、青綠嫩草，</para>
  <para style="q1" vid="2KI 19:26">像被東風吹焦<note caller="+" style="f"><char style="fr" closed="false">19:26 </char><char style="ft" closed="false">被東風吹焦——依據死海古卷；馬索拉文本作「尚未長大就被吹焦」。</char></note>的屋頂上的草。<verse eid="2KI 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="2KI 19:27" />你或坐或出或入，我都知道；</para>
  <para style="q1" vid="2KI 19:27">我也知道你對我發怒。<verse eid="2KI 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2KI 19:28" />因為你對我發怒，</para>
  <para style="q1" vid="2KI 19:28">你的驕奢安逸上達我的耳中，</para>
  <para style="q1" vid="2KI 19:28">所以我要把鉤子放進你的鼻孔，</para>
  <para style="q1" vid="2KI 19:28">把嚼環放入你的嘴裡，</para>
  <para style="q1" vid="2KI 19:28">我必使你從原路返回。<verse eid="2KI 19:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="2KI 19:29" />「<char style="pn">希西加</char>啊，以下是給你的徵兆：今年你們會吃自生的，第二年你們會吃自長的，而第三年你們將播種、收割，栽種葡萄園，吃園中的果實。 <verse eid="2KI 19:29" /><verse number="30" style="v" sid="2KI 19:30" /><char style="pn">猶大</char>家殘留的倖存者將再次往下扎根，向上結果； <verse eid="2KI 19:30" /><verse number="31" style="v" sid="2KI 19:31" />必有餘剩之民從<char style="pn">耶路撒冷</char>而出，必有倖存者從<char style="pn">錫安</char>山而來。萬軍之耶和華的熱心必成就這事。<verse eid="2KI 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 19:32" />「因此，耶和華論到<char style="pn">亞述</char>王如此說：</para>
  <para style="q1" vid="2KI 19:32">他必不進入這城，</para>
  <para style="q1" vid="2KI 19:32">也不在這裡射箭；</para>
  <para style="q1" vid="2KI 19:32">他必不拿著盾牌兵臨城下，</para>
  <para style="q1" vid="2KI 19:32">也不築起土壘攻城；<verse eid="2KI 19:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="2KI 19:33" />他必從原路返回，</para>
  <para style="q1" vid="2KI 19:33">也不進入這城。</para>
  <para style="q1" vid="2KI 19:33">這是耶和華的宣告。<verse eid="2KI 19:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="2KI 19:34" />我必為自己的緣故和我僕人<char style="pn">大衛</char>的緣故，</para>
  <para style="q1" vid="2KI 19:34">保護拯救這城。」<verse eid="2KI 19:34" /></para>
  <para style="s">西納基立潰敗與死亡</para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 19:35" />那天夜裡，耶和華的使者出去，在<char style="pn">亞述</char>的營中擊殺了十八萬五千人；清早人們起來，看哪，所見的都是死屍！ <verse eid="2KI 19:35" /><verse number="36" style="v" sid="2KI 19:36" /><char style="pn">亞述</char>王<char style="pn">西納基立</char>就拔營回去，住在<char style="pn">尼尼微</char>。<verse eid="2KI 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 19:37" />有一天，<char style="pn">西納基立</char>在自己的神<char style="pn">尼斯洛</char>的廟裡下拜，他的兒子<char style="pn">亞得米勒</char>和<char style="pn">沙利色</char>用刀殺了他，然後逃到<char style="pn">亞拉臘</char>地。他的兒子<char style="pn">以撒哈頓</char>接替他作王。<verse eid="2KI 19:37" /></para>
  <chapter eid="2KI 19" />
  <chapter number="20" style="c" sid="2KI 20" />
  <para style="s">希西加患病和痊癒</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 20:1" />在那些日子，<char style="pn">希西加</char>患病快要死了。<char style="pn">亞摩斯</char>的兒子先知<char style="pn">以賽亞</char>來到他那裡，對他說：「耶和華如此說：『你要安排好你的家事，因為你將要死，不能存活了。』」<verse eid="2KI 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 20:2" />
    <char style="pn">希西加</char>就轉臉對著牆，向耶和華禱告，說： <verse eid="2KI 20:2" /><verse number="3" style="v" sid="2KI 20:3" />「哦，耶和華啊，求你記念我怎樣以誠實和完全的心行走在你面前，又做你眼中看為善的事！」然後，<char style="pn">希西加</char>就痛哭起來。<verse eid="2KI 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 20:4" />那時，<char style="pn">以賽亞</char>還沒有走出中院，耶和華的話語就臨到他，說： <verse eid="2KI 20:4" /><verse number="5" style="v" sid="2KI 20:5" />「你回去告訴我子民的首領<char style="pn">希西加</char>：『你先祖<char style="pn">大衛</char>的神耶和華如此說：我聽到了你的禱告，看見了你的眼淚。看哪，我必使你痊癒，第三天你就能上耶和華的殿去。 <verse eid="2KI 20:5" /><verse number="6" style="v" sid="2KI 20:6" />我必在你的壽數上增添十五年。我必解救你和這城脫離<char style="pn">亞述</char>王的手；我必為我自己的緣故，為我僕人<char style="pn">大衛</char>的緣故，保護這城。』」<verse eid="2KI 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 20:7" />
    <char style="pn">以賽亞</char>說：「拿一塊無花果餅來。」他們拿來敷在瘡上，王就痊癒了。<verse eid="2KI 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 20:8" />
    <char style="pn">希西加</char>卻問<char style="pn">以賽亞</char>：「有什麼徵兆來證明耶和華將使我痊癒，第三天我就會上耶和華殿呢？」<verse eid="2KI 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 20:9" />
    <char style="pn">以賽亞</char>說：「以下是耶和華給你的徵兆，證明耶和華必成就他所說的事：你要日晷前進十個刻度呢，還是後退十個刻度？」<verse eid="2KI 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 20:10" />
    <char style="pn">希西加</char>說：「日晷前進十個刻度很容易，不要，還是讓日晷後退十個刻度吧。」 <verse eid="2KI 20:10" /><verse number="11" style="v" sid="2KI 20:11" />先知<char style="pn">以賽亞</char>向耶和華呼求，耶和華就使<char style="pn">亞哈斯</char>的日晷上前進的影子，後退了十個刻度。<verse eid="2KI 20:11" /></para>
  <para style="s">希西加行事愚昧</para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 20:12" />在那段時期，<char style="pn">巴拉旦</char>的兒子<char style="pn">巴比倫</char>王<char style="pn">米羅達·巴拉旦</char><note caller="+" style="f"><char style="fr" closed="false">20:12 </char><char style="ft" closed="false">米羅達·巴拉旦——依據七十士譯本以及其他古抄本；參《以賽亞書》39:1；馬索拉文本作「比羅達·巴拉旦」。</char></note>聽說了<char style="pn">希西加</char>患病，就給他送來書信和禮物。 <verse eid="2KI 20:12" /><verse number="13" style="v" sid="2KI 20:13" /><char style="pn">希西加</char>接見了使者<note caller="+" style="f"><char style="fr" closed="false">20:13 </char><char style="ft" closed="false">接見了使者——原文直譯「聽他們」。</char></note>，並且給他們看他整個寶庫裡的金子、銀子、香料、貴重的膏油，還有他的武器庫，以及他庫房中的一切。他家中和國中的所有東西，<char style="pn">希西加</char>沒有一樣不給他們看的。<verse eid="2KI 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 20:14" />於是先知<char style="pn">以賽亞</char>來到<char style="pn">希西加</char>王那裡，問他：「那些人說了什麼？他們是從哪裡來見你的？」</para>
  <para style="p" vid="2KI 20:14">
    <char style="pn">希西加</char>回答：「是從遙遠之地<char style="pn">巴比倫</char>來的。」<verse eid="2KI 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 20:15" />
    <char style="pn">以賽亞</char>問：「在你的家中他們看了什麼？」</para>
  <para style="p" vid="2KI 20:15">
    <char style="pn">希西加</char>回答：「我家中的所有東西，他們都看了；庫房中的一切，我沒有一樣不給他們看的。」<verse eid="2KI 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 20:16" />
    <char style="pn">以賽亞</char>就對<char style="pn">希西加</char>說：「你要聽耶和華的話語： <verse eid="2KI 20:16" /><verse number="17" style="v" sid="2KI 20:17" />『看哪，日子將到，你家中的一切，以及你祖先積蓄到今日的一切，都要被擄到<char style="pn">巴比倫</char>去，一樣也不留。』耶和華還說： <verse eid="2KI 20:17" /><verse number="18" style="v" sid="2KI 20:18" />『從你而出的、你親生的兒子們中，必有被帶到<char style="pn">巴比倫</char>王宮中作太監的。』」<verse eid="2KI 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 20:19" />
    <char style="pn">希西加</char>對<char style="pn">以賽亞</char>說：「你所說的耶和華的話甚好。」因為他想：「至少在我的年日裡有平安和安穩，不是嗎？」<verse eid="2KI 20:19" /></para>
  <para style="s">希西加去世</para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 20:20" />
    <char style="pn">希西加</char>其餘的事蹟和他的所有武力，以及他怎樣開挖水池和溝渠，把水引到城裡，不是都記在《<char style="pn">猶大</char>諸王年代志》上嗎？ <verse eid="2KI 20:20" /><verse number="21" style="v" sid="2KI 20:21" /><char style="pn">希西加</char>與他的列祖長眠，他的兒子<char style="pn">瑪拿西</char>接替他作王。<verse eid="2KI 20:21" /></para>
  <chapter eid="2KI 20" />
  <chapter number="21" style="c" sid="2KI 21" />
  <para style="s">猶大王瑪拿西</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 21:1" />
    <char style="pn">瑪拿西</char>作王的時候十二歲，在<char style="pn">耶路撒冷</char>統治了五十五年。他的母親名叫<char style="pn">赫菲茨巴</char>。 <verse eid="2KI 21:1" /><verse number="2" style="v" sid="2KI 21:2" />他做耶和華眼中看為惡的事，效法耶和華在<char style="pn">以色列</char>子民面前趕出的那些民族，行可憎之事。 <verse eid="2KI 21:2" /><verse number="3" style="v" sid="2KI 21:3" />他重建了他父親<char style="pn">希西加</char>毀掉的高壇，像<char style="pn">以色列</char>王<char style="pn">亞哈</char>所做的那樣，為<char style="pn">巴力</char>設立祭壇，製作<char style="pn">亞舍拉</char>柱，並向天上的萬象下拜，服事它們。 <verse eid="2KI 21:3" /><verse number="4" style="v" sid="2KI 21:4" />他在耶和華殿中築了別的祭壇，關於這殿，耶和華曾指著它說「我要在<char style="pn">耶路撒冷</char>安置我的名」。 <verse eid="2KI 21:4" /><verse number="5" style="v" sid="2KI 21:5" />他又在耶和華殿的兩個院子裡為天上的萬象築了祭壇， <verse eid="2KI 21:5" /><verse number="6" style="v" sid="2KI 21:6" />他使自己的兒子經火，並且算命、行法術、招魂、通靈。他做了許多在耶和華眼中看為惡的事，惹他惱怒。<verse eid="2KI 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 21:7" />
    <char style="pn">瑪拿西</char>甚至把自己製作的<char style="pn">亞舍拉</char>雕像立在聖殿中，而這殿宇，耶和華曾指著它對<char style="pn">大衛</char>和他兒子<char style="pn">所羅門</char>說：「我要在這殿宇中，在我從<char style="pn">以色列</char>眾支派所選擇的<char style="pn">耶路撒冷</char>，永遠安置我的名。 <verse eid="2KI 21:7" /><verse number="8" style="v" sid="2KI 21:8" />只要他們謹守遵行我所吩咐他們的一切，遵行我的僕人<char style="pn">摩西</char>所吩咐他們的一切律法，我就不再使<char style="pn">以色列</char>的腳流蕩，離開我所賜給他們祖先的這地。」 <verse eid="2KI 21:8" /><verse number="9" style="v" sid="2KI 21:9" />但他們沒有聽從。<char style="pn">瑪拿西</char>使他們迷失，以致作惡超過那些在<char style="pn">以色列</char>子民面前被耶和華除滅的民族。<verse eid="2KI 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 21:10" />耶和華藉著他的僕人眾先知宣告說： <verse eid="2KI 21:10" /><verse number="11" style="v" sid="2KI 21:11" />「因為<char style="pn">猶大</char>王<char style="pn">瑪拿西</char>做了這些可憎之事，作惡超過他之前的<char style="pn">亞摩利</char>人所做的一切，又使<char style="pn">猶大</char>拜偶像而陷入罪惡， <verse eid="2KI 21:11" /><verse number="12" style="v" sid="2KI 21:12" />因此<char style="pn">以色列</char>的神耶和華如此說：『看哪，我要使禍患臨到<char style="pn">耶路撒冷</char>和<char style="pn">猶大</char>，使所有聽見這事的人都會雙耳震響。 <verse eid="2KI 21:12" /><verse number="13" style="v" sid="2KI 21:13" />我要把<char style="pn">撒瑪利亞</char>的準繩和<char style="pn">亞哈</char>家的鉛垂線拉在<char style="pn">耶路撒冷</char>之上，我要把<char style="pn">耶路撒冷</char>擦乾淨，就像人擦盤子，擦完後把它翻過來。 <verse eid="2KI 21:13" /><verse number="14" style="v" sid="2KI 21:14" />我要撇棄我繼業的餘剩之民，把他們交在仇敵手中，他們必成為所有仇敵的掠物和擄物。 <verse eid="2KI 21:14" /><verse number="15" style="v" sid="2KI 21:15" />因為他們做我眼中看為惡的事，從他們的祖先出<char style="pn">埃及</char>那天起直到今日，他們一直惹怒我。』」<verse eid="2KI 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 21:16" />
    <char style="pn">瑪拿西</char>使<char style="pn">猶大</char>犯罪、去做耶和華眼中看為惡的事，此外他還流了很多無辜人的血，以致這血從這邊到那邊充滿了<char style="pn">耶路撒冷</char>。<verse eid="2KI 21:16" /></para>
  <para style="s">瑪拿西去世</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 21:17" />
    <char style="pn">瑪拿西</char>其餘的事蹟和他所做的一切，以及他所犯的罪，不是都記在《<char style="pn">猶大</char>諸王年代志》上嗎？ <verse eid="2KI 21:17" /><verse number="18" style="v" sid="2KI 21:18" /><char style="pn">瑪拿西</char>與他的列祖長眠，葬在他宮殿的園子，就是<char style="pn">烏撒</char>的園子裡；他的兒子<char style="pn">亞門</char>接替他作王。<verse eid="2KI 21:18" /></para>
  <para style="s">猶大王亞門</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 21:19" />
    <char style="pn">亞門</char>作王的時候二十二歲，在<char style="pn">耶路撒冷</char>統治了兩年。他的母親名叫<char style="pn">米淑利梅</char>，是<char style="pn">哈魯斯</char>的女兒，來自<char style="pn">約提巴</char>。 <verse eid="2KI 21:19" /><verse number="20" style="v" sid="2KI 21:20" /><char style="pn">亞門</char>效法他父親<char style="pn">瑪拿西</char>的行為，做耶和華眼中看為惡的事。 <verse eid="2KI 21:20" /><verse number="21" style="v" sid="2KI 21:21" />他走他父親所走的一切道路，服事他父親所服事的偶像，向它們下拜。 <verse eid="2KI 21:21" /><verse number="22" style="v" sid="2KI 21:22" />他離棄了耶和華他祖先的神，沒有遵行耶和華的道。<verse eid="2KI 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 21:23" />
    <char style="pn">亞門</char>的臣僕密謀反叛他，在他的宮殿裡把王殺了。 <verse eid="2KI 21:23" /><verse number="24" style="v" sid="2KI 21:24" />那地的民眾又把所有密謀反叛<char style="pn">亞門</char>王的人都殺了，然後立他的兒子<char style="pn">約西亞</char>接替他作王。<verse eid="2KI 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 21:25" />
    <char style="pn">亞門</char>所做的其餘事蹟，不是都記在《<char style="pn">猶大</char>諸王年代志》上嗎？ <verse eid="2KI 21:25" /><verse number="26" style="v" sid="2KI 21:26" />他被葬在<char style="pn">烏撒</char>的園子中自己的墳墓裡，他的兒子<char style="pn">約西亞</char>接替他作王。<verse eid="2KI 21:26" /></para>
  <chapter eid="2KI 21" />
  <chapter number="22" style="c" sid="2KI 22" />
  <para style="s">猶大王約西亞</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 22:1" />
    <char style="pn">約西亞</char>作王的時候八歲，在<char style="pn">耶路撒冷</char>統治了三十一年。他的母親名叫<char style="pn">耶迪達</char>，是<char style="pn">亞達雅</char>的女兒，來自<char style="pn">波斯加</char>。 <verse eid="2KI 22:1" /><verse number="2" style="v" sid="2KI 22:2" />他做耶和華眼中看為正的事，走他先祖<char style="pn">大衛</char>一切的道路，不偏離左右。<verse eid="2KI 22:2" /></para>
  <para style="s">約西亞修繕聖殿</para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 22:3" />
    <char style="pn">約西亞</char>王在位第十八年，王派遣<char style="pn">米書蘭</char>的孫子、<char style="pn">亞薩利雅</char>的兒子書記<char style="pn">沙番</char>，到耶和華的殿去，說： <verse eid="2KI 22:3" /><verse number="4" style="v" sid="2KI 22:4" />「你上大祭司<char style="pn">希勒加</char>那裡去，讓他結清那些奉獻到耶和華殿的銀子，就是門衛從民眾接收的， <verse eid="2KI 22:4" /><verse number="5" style="v" sid="2KI 22:5" />然後把銀子交託在那些監管耶和華殿中工作的人手中。他們再支付給那些在耶和華殿中做工的人，去修繕殿宇的破損處， <verse eid="2KI 22:5" /><verse number="6" style="v" sid="2KI 22:6" />也就是交給木匠、建築工和泥瓦匠，並且購買木材和鑿好的料石，用來修繕殿宇。 <verse eid="2KI 22:6" /><verse number="7" style="v" sid="2KI 22:7" />不過，交在這些人手中的銀子不必他們算帳，因為他們行事誠信。」<verse eid="2KI 22:7" /></para>
  <para style="s">發現律法書</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 22:8" />那時，大祭司<char style="pn">希勒加</char>對書記<char style="pn">沙番</char>說：「我在耶和華殿中發現了律法書。」<char style="pn">希勒加</char>把書卷交給<char style="pn">沙番</char>，<char style="pn">沙番</char>就讀了。<verse eid="2KI 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 22:9" />書記<char style="pn">沙番</char>來到王那裡，回稟王說：「臣僕們已經把聖殿中的銀子倒出來，交在那些監管耶和華殿中工作的人手中了。」 <verse eid="2KI 22:9" /><verse number="10" style="v" sid="2KI 22:10" />書記<char style="pn">沙番</char>接著告訴王說：「祭司<char style="pn">希勒加</char>交給我一個書卷。」<char style="pn">沙番</char>就在王面前朗讀它。<verse eid="2KI 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 22:11" />王聽了律法書上的話語，就撕裂衣服。 <verse eid="2KI 22:11" /><verse number="12" style="v" sid="2KI 22:12" />王吩咐祭司<char style="pn">希勒加</char>、<char style="pn">沙番</char>的兒子<char style="pn">亞希甘</char>、<char style="pn">米該亞</char>的兒子<char style="pn">亞革波</char>、書記<char style="pn">沙番</char>，以及王的僕人<char style="pn">亞撒雅</char>，說： <verse eid="2KI 22:12" /><verse number="13" style="v" sid="2KI 22:13" />「關於所發現這書卷上的話語，你們去，為我、為子民、為全<char style="pn">猶大</char>求問耶和華。因為我們的祖先沒有聽從這書卷上的話語，沒有去遵行所要求我們的一切內容，所以耶和華向我們燃起極大的怒火。」<verse eid="2KI 22:13" /></para>
  <para style="s">胡勒達預告審判</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 22:14" />於是祭司<char style="pn">希勒加</char>和<char style="pn">亞希甘</char>、<char style="pn">亞革波</char>、<char style="pn">沙番</char>、<char style="pn">亞撒雅</char>去見女先知<char style="pn">胡勒達</char>，她住在<char style="pn">耶路撒冷</char>第二區，是掌管禮服的<char style="pn">沙勒姆</char>的妻子；<char style="pn">沙勒姆</char>是<char style="pn">哈珥哈斯</char>的孫子、<char style="pn">提克瓦</char>的兒子。他們請教<char style="pn">胡勒達</char>， <verse eid="2KI 22:14" /><verse number="15" style="v" sid="2KI 22:15" />她就對他們說：</para>
  <para style="p" vid="2KI 22:15">「<char style="pn">以色列</char>的神耶和華如此說：你們告訴那派你們來見我的人， <verse eid="2KI 22:15" /><verse number="16" style="v" sid="2KI 22:16" />『耶和華如此說：看哪，我要使禍患，就是<char style="pn">猶大</char>王所讀的那書卷上的一切話語，臨到這地方和這裡的居民。 <verse eid="2KI 22:16" /><verse number="17" style="v" sid="2KI 22:17" />因為他們離棄了我，向別的神燒香，以他們手所造的一切惹怒我。我的怒火要焚燒這地方，絕不熄滅。』 <verse eid="2KI 22:17" /><verse number="18" style="v" sid="2KI 22:18" />不過，你們要對那派你們來求問耶和華的<char style="pn">猶大</char>王如此說：『關於你所聽見的那些話語，<char style="pn">以色列</char>的神耶和華如此說： <verse eid="2KI 22:18" /><verse number="19" style="v" sid="2KI 22:19" />你既然聽到我宣告這地方和它的居民將令人驚駭、被咒罵，就心裡柔軟，在耶和華面前謙卑下來，撕裂衣服、在我面前哀哭，因此我已經垂聽了你。這是耶和華的宣告。 <verse eid="2KI 22:19" /><verse number="20" style="v" sid="2KI 22:20" />所以看哪，我必使你歸到你列祖那裡，你將平平安安歸到你的墳墓裡，你不會親眼看到我要降在這地方的一切災禍。』」</para>
  <para style="p" vid="2KI 22:20">他們就回去稟告王。<verse eid="2KI 22:20" /></para>
  <chapter eid="2KI 22" />
  <chapter number="23" style="c" sid="2KI 23" />
  <para style="s">重新立約</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 23:1" />王派人去，招聚了<char style="pn">猶大</char>和<char style="pn">耶路撒冷</char>所有的長老到他那裡。 <verse eid="2KI 23:1" /><verse number="2" style="v" sid="2KI 23:2" />然後，王與<char style="pn">猶大</char>眾人、全<char style="pn">耶路撒冷</char>的居民、祭司、先知、全體民眾，無論尊卑，都一起上耶和華的殿去。王就把耶和華殿中發現的約書上一切話語，宣讀給他們聽。 <verse eid="2KI 23:2" /><verse number="3" style="v" sid="2KI 23:3" />王站在柱子旁邊，在耶和華面前立約，要全心、全靈跟從耶和華，遵守他的誡命、法度和律例，履行這書卷上所記的聖約之言。全體民眾也都歸入這約。<verse eid="2KI 23:3" /></para>
  <para style="s">約西亞的改革</para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 23:4" />王吩咐大祭司<char style="pn">希勒加</char>、副祭司們以及門衛，把那些為<char style="pn">巴力</char>、<char style="pn">亞舍拉</char>和天上的萬象所造的一切器具從耶和華聖殿中搬出去，在<char style="pn">耶路撒冷</char>外面<char style="pn">汲淪</char>溪谷的田野焚燒了，然後把灰燼運到<char style="pn">伯特利</char>。 <verse eid="2KI 23:4" /><verse number="5" style="v" sid="2KI 23:5" />他還驅除<char style="pn">猶大</char>列王所指派的那些服事偶像的祭司，就是在<char style="pn">猶大</char>各城的高壇和<char style="pn">耶路撒冷</char>四周燒香的祭司，並且驅除那些向<char style="pn">巴力</char>、太陽、月亮、星辰和天上萬象燒香的人。 <verse eid="2KI 23:5" /><verse number="6" style="v" sid="2KI 23:6" />他把<char style="pn">亞舍拉</char>柱從耶和華的殿搬出去，帶到<char style="pn">耶路撒冷</char>外面的<char style="pn">汲淪</char>溪谷，在<char style="pn">汲淪</char>溪谷焚燒了，磨碎成灰，然後把灰撒在平民的墳墓上。 <verse eid="2KI 23:6" /><verse number="7" style="v" sid="2KI 23:7" />他拆毀了耶和華殿中男廟妓的房屋，那裡也是婦女們為<char style="pn">亞舍拉</char>編織帳幔的地方。<verse eid="2KI 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 23:8" />他從<char style="pn">猶大</char>各城把那些祭司全召來，將祭司們燒香的高壇都玷汙了，從<char style="pn">迦巴</char>直到<char style="pn">比爾-謝巴</char>。他也拆毀了城門口的高壇，就在城主<char style="pn">約書亞</char>的城門入口處、城門的左邊。 <verse eid="2KI 23:8" /><verse number="9" style="v" sid="2KI 23:9" />然而，那些高壇的祭司沒有上<char style="pn">耶路撒冷</char>耶和華的祭壇，只是與兄弟們一起吃了無酵餅。<verse eid="2KI 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 23:10" />他還把<char style="pn">欣嫩子</char>谷的<char style="pn">陀斐特</char>玷汙了，以免有人使兒女經火獻給<char style="pn">摩洛</char>。 <verse eid="2KI 23:10" /><verse number="11" style="v" sid="2KI 23:11" />他從耶和華殿的入口、前院中內臣<char style="pn">拿單米勒</char>的房間旁邊，除掉了<char style="pn">猶大</char>列王獻給太陽的馬匹，用火焚燒了太陽戰車。<verse eid="2KI 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 23:12" />
    <char style="pn">猶大</char>列王在<char style="pn">亞哈斯</char>樓閣屋頂上所築的祭壇，以及<char style="pn">瑪拿西</char>在耶和華的殿兩個院子內所築的祭壇，<char style="pn">約西亞</char>王都拆毀搗碎了<note caller="+" style="f"><char style="fr" closed="false">23:12 </char><char style="ft" closed="false">搗碎了——或譯作「從那裡除去了」。</char></note>，把碎屑扔進<char style="pn">汲淪</char>溪谷。 <verse eid="2KI 23:12" /><verse number="13" style="v" sid="2KI 23:13" />王還把<char style="pn">耶路撒冷</char>東邊<char style="pn">邪僻</char>山南面的高壇玷汙了，這些都是從前<char style="pn">以色列</char>王<char style="pn">所羅門</char>為<char style="pn">西頓</char>人的可憎偶像<char style="pn">亞斯她錄</char>、<char style="pn">摩押</char>人的可憎偶像<char style="pn">基抹</char>、<char style="pn">亞捫</char>人的可憎偶像<char style="pn">米勒公</char>所建造的。 <verse eid="2KI 23:13" /><verse number="14" style="v" sid="2KI 23:14" />他打碎神柱，砍倒<char style="pn">亞舍拉</char>柱，使那些地方布滿了人的骸骨。<verse eid="2KI 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 23:15" />此外還有<char style="pn">伯特利</char>的祭壇，以及<char style="pn">尼八</char>之子<char style="pn">耶羅波安</char>所建造使<char style="pn">以色列</char>犯罪的高壇，王也把這祭壇和高壇拆毀了。他燒毀高壇，把殘餘磨碎成灰，並燒毀<char style="pn">亞舍拉</char>柱。 <verse eid="2KI 23:15" /><verse number="16" style="v" sid="2KI 23:16" /><char style="pn">約西亞</char>回頭，看見山上的那些墳墓，就派人從墳墓裡取出骸骨，在祭壇上焚燒，玷汙了祭壇，正如從前神人預言這些事情時所宣告的耶和華的話語。 <verse eid="2KI 23:16" /><verse number="17" style="v" sid="2KI 23:17" />王問：「我看見的這石碑是誰的？」</para>
  <para style="p" vid="2KI 23:17">那城的人告訴王：「這是以前那位從<char style="pn">猶大</char>來的神人的墳墓，他曾宣告了你現在向<char style="pn">伯特利</char>的祭壇所做的這些事。」<verse eid="2KI 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 23:18" />王說：「讓他安息吧！不要讓人驚動他的骸骨。」於是他們保全了他的骸骨，以及從<char style="pn">撒瑪利亞</char>來的那位先知的骸骨。<verse eid="2KI 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 23:19" />從前<char style="pn">以色列</char>諸王在<char style="pn">撒瑪利亞</char>各城建造高壇廟宇，以致惹怒耶和華，<char style="pn">約西亞</char>也把它們全都除掉了。他照著在<char style="pn">伯特利</char>的一切處理方式，處理它們。 <verse eid="2KI 23:19" /><verse number="20" style="v" sid="2KI 23:20" />他把那裡所有的高壇祭司都斬殺<note caller="+" style="f"><char style="fr" closed="false">23:20 </char><char style="ft" closed="false">斬殺——或譯作「祭獻」。</char></note>在祭壇上，並在祭壇上焚燒人的骸骨。之後，他回<char style="pn">耶路撒冷</char>去了。<verse eid="2KI 23:20" /></para>
  <para style="s">約西亞守逾越節</para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 23:21" />王吩咐全體民眾說：「你們要照著這約書上所記的，向你們的神耶和華守逾越節。」 <verse eid="2KI 23:21" /><verse number="22" style="v" sid="2KI 23:22" />從士師治理<char style="pn">以色列</char>的日子，到<char style="pn">以色列</char>和<char style="pn">猶大</char>列王的整個時期，實在沒有守過像這樣的逾越節； <verse eid="2KI 23:22" /><verse number="23" style="v" sid="2KI 23:23" />只有<char style="pn">約西亞</char>王第十八年，在<char style="pn">耶路撒冷</char>向耶和華守了這樣的逾越節。<verse eid="2KI 23:23" /></para>
  <para style="s">約西亞對耶和華的熱心</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 23:24" />此外，在<char style="pn">猶大</char>地和<char style="pn">耶路撒冷</char>所見的招魂者、通靈者、家族神像、偶像，以及一切可憎之物，<char style="pn">約西亞</char>也都清除了，為要履行祭司<char style="pn">希勒加</char>在耶和華殿中發現的書卷上所記律法的話語。 <verse eid="2KI 23:24" /><verse number="25" style="v" sid="2KI 23:25" />在他以前從來沒有一個王像他那樣照著<char style="pn">摩西</char>的全部律法，全心、全靈、全力回轉歸向耶和華，在他之後也沒有興起一個像他那樣的。<verse eid="2KI 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 23:26" />然而，因著<char style="pn">瑪拿西</char>惹怒耶和華的種種挑釁行為，耶和華還是沒有收回他向<char style="pn">猶大</char>所發的極其猛烈的怒氣。 <verse eid="2KI 23:26" /><verse number="27" style="v" sid="2KI 23:27" />耶和華說：「我要像驅逐<char style="pn">以色列</char>那樣，也把<char style="pn">猶大</char>從我面前驅逐了。我要棄絕我所選擇的這城<char style="pn">耶路撒冷</char>，以及我曾說『我的名必常在那裡』的這殿宇。」<verse eid="2KI 23:27" /></para>
  <para style="s">約西亞陣亡</para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 23:28" />
    <char style="pn">約西亞</char>其餘的事蹟和他所做的一切，不是都記在《<char style="pn">猶大</char>諸王年代志》上嗎？ <verse eid="2KI 23:28" /><verse number="29" style="v" sid="2KI 23:29" /><char style="pn">約西亞</char>年間，<char style="pn">埃及</char>王法老<char style="pn">尼科</char>上來攻打<char style="pn">幼發拉底</char>河那裡的<char style="pn">亞述</char>王，<char style="pn">約西亞</char>王去迎戰他。法老在<char style="pn">米吉多</char>見到<char style="pn">約西亞</char>時，把他殺了。 <verse eid="2KI 23:29" /><verse number="30" style="v" sid="2KI 23:30" />他的臣僕用車把他的屍體從<char style="pn">米吉多</char>運走，帶回<char style="pn">耶路撒冷</char>，葬在他的墳墓裡。那地的民眾選擇<char style="pn">約西亞</char>的兒子<char style="pn">約哈斯</char>，膏抹了他，立他為王接替他父親。<verse eid="2KI 23:30" /></para>
  <para style="s">猶大王約哈斯</para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 23:31" />
    <char style="pn">約哈斯</char>作王的時候二十三歲，在<char style="pn">耶路撒冷</char>統治了三個月。他的母親名叫<char style="pn">哈慕她勒</char>，是<char style="pn">立拿</char>人<char style="pn">耶利米</char>的女兒。 <verse eid="2KI 23:31" /><verse number="32" style="v" sid="2KI 23:32" />他效法他的祖先所做的一切，做耶和華眼中看為惡的事。 <verse eid="2KI 23:32" /><verse number="33" style="v" sid="2KI 23:33" />法老<char style="pn">尼科</char>把他囚禁在<char style="pn">哈馬</char>地的<char style="pn">利比拉</char>，不讓他在<char style="pn">耶路撒冷</char>作王，並且罰了<char style="pn">猶大</char>國一百他連得<note caller="+" style="f"><char style="fr" closed="false">23:33 </char><char style="ft" closed="false">一百他連得——相當於3.4公噸。</char></note>銀子、一他連得<note caller="+" style="f"><char style="fr" closed="false">23:33 </char><char style="ft" closed="false">一他連得——相當於34.2公斤。</char></note>金子。<verse eid="2KI 23:33" /></para>
  <para style="s">猶大王約雅敬</para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 23:34" />法老<char style="pn">尼科</char>立<char style="pn">約西亞</char>的兒子<char style="pn">以利亞敬</char>為王接替他父親<char style="pn">約西亞</char>，把他的名字改為<char style="pn">約雅敬</char>。然後<char style="pn">尼科</char>帶走<char style="pn">約哈斯</char>，把他帶到<char style="pn">埃及</char>去了，後來他死在那裡。 <verse eid="2KI 23:34" /><verse number="35" style="v" sid="2KI 23:35" /><char style="pn">約雅敬</char>向法老上交金銀，但他為了按照法老的要求上交銀子，就向本國攤派。他照著自己給各人的估價，向國民索取金銀，為要上交給法老<char style="pn">尼科</char>。<verse eid="2KI 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 23:36" />
    <char style="pn">約雅敬</char>作王的時候二十五歲，在<char style="pn">耶路撒冷</char>統治了十一年。他的母親名叫<char style="pn">澤布達</char>，是<char style="pn">魯瑪</char>人<char style="pn">皮達雅</char>的女兒。 <verse eid="2KI 23:36" /><verse number="37" style="v" sid="2KI 23:37" /><char style="pn">約雅敬</char>效法他祖先所做的一切，做耶和華眼中看為惡的事。<verse eid="2KI 23:37" /></para>
  <chapter eid="2KI 23" />
  <chapter number="24" style="c" sid="2KI 24" />
  <para style="s">約雅敬之背叛與死亡</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 24:1" />
    <char style="pn">約雅敬</char>年間，<char style="pn">巴比倫</char>王<char style="pn">尼布甲尼撒</char>上來，<char style="pn">約雅敬</char>就臣服於他三年，之後反悔背叛了他。 <verse eid="2KI 24:1" /><verse number="2" style="v" sid="2KI 24:2" />耶和華派遣<char style="pn">迦勒底</char>軍、<char style="pn">亞蘭</char>軍、<char style="pn">摩押</char>軍以及<char style="pn">亞捫</char>人的軍隊來攻打<char style="pn">約雅敬</char>。耶和華派遣他們攻打<char style="pn">猶大</char>，要消滅<char style="pn">猶大</char>，正如耶和華藉著他的僕人眾先知所宣告的話。 <verse eid="2KI 24:2" /><verse number="3" style="v" sid="2KI 24:3" />這事臨到<char style="pn">猶大</char>，誠然是出於耶和華的吩咐，為要把他們從耶和華面前驅逐。這是因<char style="pn">瑪拿西</char>的罪惡，因他所做的一切， <verse eid="2KI 24:3" /><verse number="4" style="v" sid="2KI 24:4" />也因他流無辜人的血，使<char style="pn">耶路撒冷</char>充滿了無辜人的血，以致耶和華不願赦免。<verse eid="2KI 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 24:5" />
    <char style="pn">約雅敬</char>其餘的事蹟和他所做的一切，不是都記在《<char style="pn">猶大</char>諸王年代志》上嗎？ <verse eid="2KI 24:5" /><verse number="6" style="v" sid="2KI 24:6" /><char style="pn">約雅敬</char>與他的列祖長眠，他的兒子<char style="pn">約雅斤</char>接替他作王。<verse eid="2KI 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 24:7" />
    <char style="pn">埃及</char>王沒有再從本國出征，因為<char style="pn">巴比倫</char>王奪取了從<char style="pn">埃及</char>河到<char style="pn">幼發拉底</char>河一切屬於<char style="pn">埃及</char>王的領土。<verse eid="2KI 24:7" /></para>
  <para style="s">猶大王約雅斤</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 24:8" />
    <char style="pn">約雅斤</char>作王的時候十八歲，在<char style="pn">耶路撒冷</char>統治了三個月。他的母親名叫<char style="pn">妮戶施特</char>，是<char style="pn">耶路撒冷</char>人<char style="pn">以利拿單</char>的女兒。 <verse eid="2KI 24:8" /><verse number="9" style="v" sid="2KI 24:9" /><char style="pn">約雅斤</char>效法他父親所做的一切，做耶和華眼中看為惡的事。<verse eid="2KI 24:9" /></para>
  <para style="s">遷徙巴比倫</para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 24:10" />那時，<char style="pn">巴比倫</char>王<char style="pn">尼布甲尼撒</char>的臣僕上來攻打<char style="pn">耶路撒冷</char>，城就被圍困。 <verse eid="2KI 24:10" /><verse number="11" style="v" sid="2KI 24:11" />臣僕們還在圍城的時候，<char style="pn">巴比倫</char>王<char style="pn">尼布甲尼撒</char>來到這城。 <verse eid="2KI 24:11" /><verse number="12" style="v" sid="2KI 24:12" /><char style="pn">猶大</char>王<char style="pn">約雅斤</char>和他的母親、臣僕、首領、內臣都出來投降<char style="pn">巴比倫</char>王。</para>
  <para style="p" vid="2KI 24:12">於是<char style="pn">巴比倫</char>王在位第八年，他把<char style="pn">約雅斤</char>擄走了。 <verse eid="2KI 24:12" /><verse number="13" style="v" sid="2KI 24:13" /><char style="pn">巴比倫</char>王也把耶和華殿中的寶物和王宮裡的寶物全都從那裡帶出來，又拆毀了<char style="pn">以色列</char>王<char style="pn">所羅門</char>在耶和華聖殿中所造的一切金器，正如耶和華所宣告的。 <verse eid="2KI 24:13" /><verse number="14" style="v" sid="2KI 24:14" />他擄走了全<char style="pn">耶路撒冷</char>的人、所有的首領、所有英勇的戰士，共一萬名俘虜，包括所有的木匠和鐵匠；除了當地最窮的人以外，沒有剩下的。<verse eid="2KI 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 24:15" />他把<char style="pn">約雅斤</char>擄到<char style="pn">巴比倫</char>去，也把王的母親、王的妃嬪、內臣以及當地的權貴，都從<char style="pn">耶路撒冷</char>俘虜到了<char style="pn">巴比倫</char>。 <verse eid="2KI 24:15" /><verse number="16" style="v" sid="2KI 24:16" />還有全部的勇士七千人，木匠鐵匠一千人，全是能作戰的，<char style="pn">巴比倫</char>王把他們也都俘虜到了<char style="pn">巴比倫</char>。 <verse eid="2KI 24:16" /><verse number="17" style="v" sid="2KI 24:17" /><char style="pn">巴比倫</char>王立<char style="pn">約雅斤</char>的叔叔<char style="pn">瑪塔尼亞</char>代替他作王，並把他的名字改為<char style="pn">西底加</char>。<verse eid="2KI 24:17" /></para>
  <para style="s">猶大王西底加</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 24:18" />
    <char style="pn">西底加</char>作王的時候二十一歲，在<char style="pn">耶路撒冷</char>統治了十一年。他的母親名叫<char style="pn">哈慕她勒</char>，是<char style="pn">立拿</char>人<char style="pn">耶利米</char>的女兒。 <verse eid="2KI 24:18" /><verse number="19" style="v" sid="2KI 24:19" /><char style="pn">西底加</char>效法<char style="pn">約雅敬</char>所做的一切，做耶和華眼中看為惡的事。 <verse eid="2KI 24:19" /><verse number="20" style="v" sid="2KI 24:20" />因此耶和華發怒，這些事就臨到<char style="pn">耶路撒冷</char>和<char style="pn">猶大</char>，直到耶和華把他們從自己面前趕走了。後來，<char style="pn">西底加</char>背叛了<char style="pn">巴比倫</char>王。<verse eid="2KI 24:20" /></para>
  <chapter eid="2KI 24" />
  <chapter number="25" style="c" sid="2KI 25" />
  <para style="s">尼布甲尼撒圍攻耶路撒冷</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 25:1" />
    <char style="pn">西底加</char>在位第九年的十月十日，<char style="pn">巴比倫</char>王<char style="pn">尼布甲尼撒</char>率領全軍來攻打<char style="pn">耶路撒冷</char>。他們在城外紮營，在城的四圍造臺築壘。 <verse eid="2KI 25:1" /><verse number="2" style="v" sid="2KI 25:2" />城被圍困，直到<char style="pn">西底加</char>王十一年。<verse eid="2KI 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 25:3" />到了四月九日，城中饑荒嚴重，當地百姓沒有糧食了。 <verse eid="2KI 25:3" /><verse number="4" style="v" sid="2KI 25:4" />城就被攻破，所有的戰士從王室園子旁邊兩道城牆之間的門趁夜逃走；那時<char style="pn">迦勒底</char>人正圍攻這城。王沿著<char style="pn">亞拉巴</char>方向的路逃走， <verse eid="2KI 25:4" /><verse number="5" style="v" sid="2KI 25:5" /><char style="pn">迦勒底</char>軍隊追趕王，在<char style="pn">耶利哥</char>平原追上了他，王的全軍從他身邊四散。 <verse eid="2KI 25:5" /><verse number="6" style="v" sid="2KI 25:6" /><char style="pn">迦勒底</char>人捉住王，把他帶到<char style="pn">利比拉</char>，到<char style="pn">巴比倫</char>王那裡，對他宣告裁決。 <verse eid="2KI 25:6" /><verse number="7" style="v" sid="2KI 25:7" />然後，他們在<char style="pn">西底加</char>眼前把他的兒子們殺了，並且弄瞎<char style="pn">西底加</char>的雙眼，用銅鏈捆住他，把他帶到<char style="pn">巴比倫</char>去了。<verse eid="2KI 25:7" /></para>
  <para style="s">耶路撒冷被毀</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 25:8" />
    <char style="pn">巴比倫</char>王<char style="pn">尼布甲尼撒</char>十九年的五月七日，<char style="pn">巴比倫</char>王的臣僕護衛長<char style="pn">尼布撒拉旦</char>進入<char style="pn">耶路撒冷</char>。 <verse eid="2KI 25:8" /><verse number="9" style="v" sid="2KI 25:9" />他燒毀了耶和華的殿和王宮，以及<char style="pn">耶路撒冷</char>所有的房屋；所有高大的建築，他都放火燒毀了。 <verse eid="2KI 25:9" /><verse number="10" style="v" sid="2KI 25:10" />護衛長率領的<char style="pn">迦勒底</char>全軍還拆毀了<char style="pn">耶路撒冷</char>四圍的城牆。 <verse eid="2KI 25:10" /><verse number="11" style="v" sid="2KI 25:11" />護衛長<char style="pn">尼布撒拉旦</char>把城中殘留的其餘民眾和那些之前向<char style="pn">巴比倫</char>王投降的人，以及其餘的群體<note caller="+" style="f"><char style="fr" closed="false">25:11 </char><char style="ft" closed="false">群體——或譯作「工匠」；參《耶利米書》52:15。</char></note>，都擄走了。 <verse eid="2KI 25:11" /><verse number="12" style="v" sid="2KI 25:12" />但護衛長留下當地一些窮人，作葡萄園丁和耕田的農夫。<verse eid="2KI 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 25:13" />
    <char style="pn">迦勒底</char>人打碎了耶和華殿的銅柱，以及耶和華殿中的銅盆底座和銅海，把這些銅都運到<char style="pn">巴比倫</char>去。 <verse eid="2KI 25:13" /><verse number="14" style="v" sid="2KI 25:14" />他們帶走了鍋、鏟子、蠟剪、勺子，以及事奉用的所有銅器。 <verse eid="2KI 25:14" /><verse number="15" style="v" sid="2KI 25:15" />還有香爐和碗，凡是純金的、純銀的，護衛長也都帶走了。<verse eid="2KI 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 25:16" />
    <char style="pn">所羅門</char>為耶和華殿製作的兩根柱子，一個銅海以及所有的銅盆底座，這一切器物所用銅的重量無法確定。 <verse eid="2KI 25:16" /><verse number="17" style="v" sid="2KI 25:17" />一根柱子高十八肘<note caller="+" style="f"><char style="fr" closed="false">25:17 </char><char style="ft" closed="false">十八肘——相當於8.2公尺。1肘=45.7公分。</char></note>，頂上的柱頭是銅的，柱頭高三肘<note caller="+" style="f"><char style="fr" closed="false">25:17 </char><char style="ft" closed="false">三肘——相當於1.4公尺。</char></note>，柱頭上環繞著網格和石榴，都是銅的。另一根柱子也一樣，上面有網格。<verse eid="2KI 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 25:18" />護衛長捉住了祭司長<char style="pn">西萊雅</char>、副祭司長<char style="pn">西番雅</char>和三個門衛， <verse eid="2KI 25:18" /><verse number="19" style="v" sid="2KI 25:19" />他在城裡還捉住一個監督軍兵的內臣，五個留在城裡的王室近臣，一個招募當地百姓的將軍秘書，以及六十個留在城裡的當地百姓。 <verse eid="2KI 25:19" /><verse number="20" style="v" sid="2KI 25:20" />護衛長<char style="pn">尼布撒拉旦</char>捉住他們，把他們帶到<char style="pn">利比拉</char>，到<char style="pn">巴比倫</char>王那裡。 <verse eid="2KI 25:20" /><verse number="21" style="v" sid="2KI 25:21" /><char style="pn">巴比倫</char>王擊殺他們，在<char style="pn">哈馬</char>地的<char style="pn">利比拉</char>把他們處死了。這樣<char style="pn">猶大</char>人就從自己的國土被擄走了。<verse eid="2KI 25:21" /></para>
  <para style="s">基大利被任命為總督</para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 25:22" />至於那些被留在<char style="pn">猶大</char>地的百姓，就是<char style="pn">巴比倫</char>王<char style="pn">尼布甲尼撒</char>所留下的人，<char style="pn">尼布甲尼撒</char>指派<char style="pn">沙番</char>的孫子、<char style="pn">亞希甘</char>的兒子<char style="pn">基大利</char>管理他們。 <verse eid="2KI 25:22" /><verse number="23" style="v" sid="2KI 25:23" />眾將領和他們的部下聽說<char style="pn">巴比倫</char>王指派了<char style="pn">基大利</char>，就到<char style="pn">米斯巴</char>去見<char style="pn">基大利</char>；這些人有<char style="pn">尼坦亞</char>的兒子<char style="pn">以實瑪利</char>、<char style="pn">加利亞</char>的兒子<char style="pn">約哈南</char>、<char style="pn">尼托法</char>人<char style="pn">坦胡米特</char>的兒子<char style="pn">西萊雅</char>、<char style="pn">瑪迦</char>人的子孫<char style="pn">雅撒尼亞</char>，還有他們的部下。 <verse eid="2KI 25:23" /><verse number="24" style="v" sid="2KI 25:24" /><char style="pn">基大利</char>向這些人和他們的部下起誓，對他們說：「不要懼怕<char style="pn">迦勒底</char>人的臣僕，只管住在這地，服事<char style="pn">巴比倫</char>王，這樣你們必安好無事。」<verse eid="2KI 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 25:25" />到了七月，王室後裔<char style="pn">以利沙瑪</char>的孫子、<char style="pn">尼坦亞</char>的兒子<char style="pn">以實瑪利</char>帶著十個人前來擊殺<char style="pn">基大利</char>，於是他和那些與他一起在<char style="pn">米斯巴</char>的<char style="pn">猶大</char>人和<char style="pn">迦勒底</char>人都死了。 <verse eid="2KI 25:25" /><verse number="26" style="v" sid="2KI 25:26" />於是全體民眾，無論尊卑，連同將領們起身往<char style="pn">埃及</char>去，因為他們懼怕<char style="pn">迦勒底</char>人。<verse eid="2KI 25:26" /></para>
  <para style="s">約雅斤獲釋</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 25:27" />在<char style="pn">猶大</char>王<char style="pn">約雅斤</char>被擄後三十七年的十二月二十七日，也就是<char style="pn">巴比倫</char>王<char style="pn">伊莫米羅達</char>作王的那一年，<char style="pn">巴比倫</char>王恩赦<note caller="+" style="f"><char style="fr" closed="false">25:27 </char><char style="ft" closed="false">恩赦——原文直譯「抬起～的頭」。</char></note><char style="pn">猶大</char>王<char style="pn">約雅斤</char>，把他從牢房釋放了， <verse eid="2KI 25:27" /><verse number="28" style="v" sid="2KI 25:28" />對他說和善的話，使他的地位高過那些與他同在<char style="pn">巴比倫</char>的王。 <verse eid="2KI 25:28" /><verse number="29" style="v" sid="2KI 25:29" /><char style="pn">約雅斤</char>換下囚服，以後終生常在王面前吃飯。 <verse eid="2KI 25:29" /><verse number="30" style="v" sid="2KI 25:30" />至於他的飲食，從<char style="pn">巴比倫</char>王那裡有份例賜給他，每天一份，終生都是如此。<verse eid="2KI 25:30" /></para>
  <chapter eid="2KI 25" />
</usx>