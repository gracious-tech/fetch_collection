<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">耶利米哀歌</para>
  <para style="mt">耶利米哀歌</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="s">為耶路撒冷悲哀</para>
  <para style="b" />
  <para style="qa">א Alef<note caller="+" style="f"><char style="fr" closed="false">1:0 </char><char style="ft" closed="false">這首希伯來文的字母詩，每行詩句的首字母按希伯來字母順序排列。1-4章下同。</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1" />從前人口眾多的城，</para>
  <para style="q1" vid="LAM 1:1">現在竟然孤獨地坐著！</para>
  <para style="q1" vid="LAM 1:1">這在列國中為大的，</para>
  <para style="q1" vid="LAM 1:1">竟然像寡婦那樣；</para>
  <para style="q1" vid="LAM 1:1">在各省中為王后的，</para>
  <para style="q1" vid="LAM 1:1">竟然成為服苦役的！<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="qa">ב Bet</para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />她夜間痛哭，</para>
  <para style="q1" vid="LAM 1:2">眼淚淌滿臉頰；</para>
  <para style="q1" vid="LAM 1:2">在她所有親愛的人中，</para>
  <para style="q1" vid="LAM 1:2">沒有一個安慰她的；</para>
  <para style="q1" vid="LAM 1:2">她所有的朋友都背棄她，</para>
  <para style="q1" vid="LAM 1:2">成為她的仇敵。<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="qa">ג Gimel</para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />
    <char style="pn">猶大</char>因苦難和嚴酷的勞役而遷徙；</para>
  <para style="q1" vid="LAM 1:3">她住在列國中，</para>
  <para style="q1" vid="LAM 1:3">找不到歇息之處；</para>
  <para style="q1" vid="LAM 1:3">在她的困境中，</para>
  <para style="q1" vid="LAM 1:3">所有追趕她的人都追上了她。<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="qa">ד Dalet</para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />
    <char style="pn">錫安</char>的道路因無人來守節期而悲哀；</para>
  <para style="q1" vid="LAM 1:4">她所有的城門都荒涼，</para>
  <para style="q1" vid="LAM 1:4">她的祭司們嘆息，</para>
  <para style="q1" vid="LAM 1:4">她的處女們憂傷，</para>
  <para style="q1" vid="LAM 1:4">她自己也苦痛。<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="qa">ה He</para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />她的敵人成為她的首領，</para>
  <para style="q1" vid="LAM 1:5">她的仇敵安穩；</para>
  <para style="q1" vid="LAM 1:5">耶和華因她眾多的過犯使她受苦；</para>
  <para style="q1" vid="LAM 1:5">她的幼童在敵人面前被擄去。<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="qa">ו Vav</para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />女子<char style="pn">錫安</char>所有的威榮都離她而去；</para>
  <para style="q1" vid="LAM 1:6">她的首領們像找不到草場的鹿，</para>
  <para style="q1" vid="LAM 1:6">在追趕他們的人面前行走無力。<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="qa">ז Zayin</para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />
    <char style="pn">耶路撒冷</char>在苦難和流浪的日子裡，</para>
  <para style="q1" vid="LAM 1:7">想起古時她一切所珍愛的。</para>
  <para style="q1" vid="LAM 1:7">她的民眾落在敵人手中，</para>
  <para style="q1" vid="LAM 1:7">卻無人幫助她；</para>
  <para style="q1" vid="LAM 1:7">敵人看見她，</para>
  <para style="q1" vid="LAM 1:7">就譏笑她的毀滅。<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="qa">ח Khet</para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />
    <char style="pn">耶路撒冷</char>大大犯罪，</para>
  <para style="q1" vid="LAM 1:8">因此成為不潔之物。</para>
  <para style="q1" vid="LAM 1:8">所有曾尊敬她的，都蔑視她，</para>
  <para style="q1" vid="LAM 1:8">因為看見她的下體；</para>
  <para style="q1" vid="LAM 1:8">她自己也嘆息，</para>
  <para style="q1" vid="LAM 1:8">轉過身去。<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="qa">ט Tet</para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />她的汙穢就在衣袍的下擺上；</para>
  <para style="q1" vid="LAM 1:9">她未曾顧念自己的結局，</para>
  <para style="q1" vid="LAM 1:9">她令人驚奇地敗落，</para>
  <para style="q1" vid="LAM 1:9">卻無人安慰她。</para>
  <para style="q1" vid="LAM 1:9">耶和華啊！求你看顧我的苦難，</para>
  <para style="q1" vid="LAM 1:9">因為仇敵高抬自己。<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="qa">י Yod</para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />敵人向她所珍愛的一切伸手，</para>
  <para style="q1" vid="LAM 1:10">她看見外邦人進入她的聖所——</para>
  <para style="q1" vid="LAM 1:10">你曾吩咐不可讓他們進入你的集會。<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="qa">כ Kaf</para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />她所有的民眾都嘆息，尋找糧食；</para>
  <para style="q1" vid="LAM 1:11">他們用自己所珍愛的換取食物，</para>
  <para style="q1" vid="LAM 1:11">為要恢復精力。</para>
  <para style="q1" vid="LAM 1:11">耶和華啊！求你看顧，求你垂看，</para>
  <para style="q1" vid="LAM 1:11">因為我被蔑視。<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="qa">ל Lamed</para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />所有過路的人哪，</para>
  <para style="q1" vid="LAM 1:12">這對你們不算什麼嗎？</para>
  <para style="q1" vid="LAM 1:12">你們要注目觀看，</para>
  <para style="q1" vid="LAM 1:12">有沒有痛苦像我所受的痛苦，</para>
  <para style="q1" vid="LAM 1:12">就是耶和華在他烈怒的日子裡使我受的苦？<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="qa">מ Mem</para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />他從至高處降火，</para>
  <para style="q1" vid="LAM 1:13">使火進入我的骨頭；</para>
  <para style="q1" vid="LAM 1:13">他在我的腳前張開網羅，</para>
  <para style="q1" vid="LAM 1:13">使我轉身退後；</para>
  <para style="q1" vid="LAM 1:13">他使我淒涼，</para>
  <para style="q1" vid="LAM 1:13">終日昏沉。<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="qa">נ Nun</para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />我過犯的軛被捆綁，</para>
  <para style="q1" vid="LAM 1:14">被他的手所纏綁，</para>
  <para style="q1" vid="LAM 1:14">加在我的頸項上；</para>
  <para style="q1" vid="LAM 1:14">他使我的力量衰敗。</para>
  <para style="q1" vid="LAM 1:14">主把我交在我不能抵擋的人手中。<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="qa">ס Samek</para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />主棄絕我當中的所有壯士，</para>
  <para style="q1" vid="LAM 1:15">宣告所定的日期對付我，</para>
  <para style="q1" vid="LAM 1:15">要打碎我的少男；</para>
  <para style="q1" vid="LAM 1:15">主踐踏少女<char style="pn">猶大</char>，</para>
  <para style="q1" vid="LAM 1:15">如在榨酒池中踹酒。<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="qa">ע Ayin</para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />我因這些事哭泣，雙眼流淚，</para>
  <para style="q1" vid="LAM 1:16">因為那安慰我、使我恢復精神的遠離我；</para>
  <para style="q1" vid="LAM 1:16">我的兒女淒涼，</para>
  <para style="q1" vid="LAM 1:16">因為仇敵得勝了。<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="qa">פ Pe</para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />
    <char style="pn">錫安</char>伸開雙手，卻無人安慰她。</para>
  <para style="q1" vid="LAM 1:17">耶和華針對<char style="pn">雅各</char>吩咐，</para>
  <para style="q1" vid="LAM 1:17">四圍的人都作他的敵人；</para>
  <para style="q1" vid="LAM 1:17">
    <char style="pn">耶路撒冷</char>在他們中間成為汙穢之物。<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="qa">צ Tsade</para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />耶和華是公義的！</para>
  <para style="q1" vid="LAM 1:18">我違背了他的命令。</para>
  <para style="q1" vid="LAM 1:18">萬民哪，你們要聽，看看我的痛苦！</para>
  <para style="q1" vid="LAM 1:18">我的少女和少男都被擄去了。<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="qa">ק Qof</para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19" />我呼喚我所親愛的，</para>
  <para style="q1" vid="LAM 1:19">他們卻欺騙我；</para>
  <para style="q1" vid="LAM 1:19">我的祭司們和長老們尋找食物恢復精力時，</para>
  <para style="q1" vid="LAM 1:19">就在城中斷了氣。<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="qa">ר Resh</para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />耶和華啊，求你看看，</para>
  <para style="q1" vid="LAM 1:20">危難臨到了我！</para>
  <para style="q1" vid="LAM 1:20">我的心腸翻騰，</para>
  <para style="q1" vid="LAM 1:20">我的心在我裡面翻轉，</para>
  <para style="q1" vid="LAM 1:20">因為我極其悖逆。</para>
  <para style="q1" vid="LAM 1:20">街上刀劍使人喪子，</para>
  <para style="q1" vid="LAM 1:20">在家也如死亡。<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="qa">שׁ Shin</para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />人們聽見我嘆息，</para>
  <para style="q1" vid="LAM 1:21">卻無人安慰我；</para>
  <para style="q1" vid="LAM 1:21">我一切的仇敵聽見我的災禍，</para>
  <para style="q1" vid="LAM 1:21">就因你做了這事而高興。</para>
  <para style="q1" vid="LAM 1:21">願你使你宣告的日子來到，</para>
  <para style="q1" vid="LAM 1:21">他們就會像我一樣。<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="qa">ת Tav</para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />願他們一切的惡行都呈到你面前，</para>
  <para style="q1" vid="LAM 1:22">求你對待他們，</para>
  <para style="q1" vid="LAM 1:22">像你因我一切的過犯而對待我一樣！</para>
  <para style="q1" vid="LAM 1:22">因為我的嘆息甚多，</para>
  <para style="q1" vid="LAM 1:22">我的心虛脫了。<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="s">對耶路撒冷的審判</para>
  <para style="b" />
  <para style="qa">א Alef</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1" />主竟然在怒氣中用黑雲籠罩女子<char style="pn">錫安</char>！</para>
  <para style="q1" vid="LAM 2:1">他把<char style="pn">以色列</char>的榮耀從天上拋棄在地，</para>
  <para style="q1" vid="LAM 2:1">在他烈怒的日子裡，</para>
  <para style="q1" vid="LAM 2:1">毫不記念自己的腳凳！<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="qa">ב Bet</para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />主吞滅<char style="pn">雅各</char>所有的居所，</para>
  <para style="q1" vid="LAM 2:2">並不顧惜；</para>
  <para style="q1" vid="LAM 2:2">他在盛怒中拆毀女子<char style="pn">猶大</char>的堡壘，</para>
  <para style="q1" vid="LAM 2:2">使它們墜落在地；</para>
  <para style="q1" vid="LAM 2:2">他折辱這國和其中的首領們。<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="qa">ג Gimel</para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />他在烈怒中砍斷<char style="pn">以色列</char>所有的角，</para>
  <para style="q1" vid="LAM 2:3">他從仇敵面前收回右手；</para>
  <para style="q1" vid="LAM 2:3">他像吞噬四圍的火焰，</para>
  <para style="q1" vid="LAM 2:3">在<char style="pn">雅各</char>中焚燒。<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="qa">ד Dalet</para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />他如仇敵拉開弓；</para>
  <para style="q1" vid="LAM 2:4">他如同敵人，</para>
  <para style="q1" vid="LAM 2:4">右手就位殺死一切眼中所珍愛的。</para>
  <para style="q1" vid="LAM 2:4">他在女子<char style="pn">錫安</char>的帳篷上，</para>
  <para style="q1" vid="LAM 2:4">傾瀉如火的烈怒。<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="qa">ה He</para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />主如仇敵吞滅<char style="pn">以色列</char>，</para>
  <para style="q1" vid="LAM 2:5">吞滅她所有的宮殿，</para>
  <para style="q1" vid="LAM 2:5">毀掉她的堡壘；</para>
  <para style="q1" vid="LAM 2:5">他給女子<char style="pn">猶大</char>加增了悲傷和哀號。<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="qa">ו Vav</para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />他摧毀自己的帳幕如摧毀園子，</para>
  <para style="q1" vid="LAM 2:6">毀掉自己所定的會所；</para>
  <para style="q1" vid="LAM 2:6">耶和華使節期和安息日在<char style="pn">錫安</char>被遺忘，</para>
  <para style="q1" vid="LAM 2:6">他在強烈的憤怒中藐視君王和祭司。<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="qa">ז Zayin</para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />主拋棄了自己的祭壇，</para>
  <para style="q1" vid="LAM 2:7">廢棄了自己的聖所；</para>
  <para style="q1" vid="LAM 2:7">他把宮殿的牆交在仇敵手中；</para>
  <para style="q1" vid="LAM 2:7">他們在耶和華的殿中大聲喧嚷，</para>
  <para style="q1" vid="LAM 2:7">像在節期之日那樣。<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="qa">ח Khet</para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />耶和華定意要毀掉女子<char style="pn">錫安</char>的城牆；</para>
  <para style="q1" vid="LAM 2:8">他拉了準繩，絕不收手停止吞滅；</para>
  <para style="q1" vid="LAM 2:8">他使城垣和城牆悲慟，一同敗落。<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="qa">ט Tet</para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />
    <char style="pn">錫安</char>的各城門都陷入地裡，</para>
  <para style="q1" vid="LAM 2:9">耶和華把她的門閂都毀壞、打斷；</para>
  <para style="q1" vid="LAM 2:9">她的君王和首領們都在列國之中；</para>
  <para style="q1" vid="LAM 2:9">律法不復存在，</para>
  <para style="q1" vid="LAM 2:9">她的先知們也得不到來自耶和華的異象。<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="qa">י Yod</para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />女子<char style="pn">錫安</char>的長老們坐在地上靜默，</para>
  <para style="q1" vid="LAM 2:10">揚塵土在頭上，束上麻布；</para>
  <para style="q1" vid="LAM 2:10">少女<char style="pn">耶路撒冷</char>垂頭於地。<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="qa">כ Kaf</para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />我的眼睛因流淚而衰竭，</para>
  <para style="q1" vid="LAM 2:11">我的心腸翻騰，</para>
  <para style="q1" vid="LAM 2:11">我的肝傾瀉於地，</para>
  <para style="q1" vid="LAM 2:11">因為我的子民<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">子民——原文直譯「女兒子民」。</char></note>敗亡，</para>
  <para style="q1" vid="LAM 2:11">幼童和吃奶的嬰兒在城裡的街上昏倒。<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="qa">ל Lamed</para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />他們像被擊傷的人昏倒在城裡的街上，</para>
  <para style="q1" vid="LAM 2:12">他們在母親的懷中要喪命<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">他們在母親的懷中要喪命——原文直譯「他們的性命傾瀉在母親的懷中」。</char></note>時，</para>
  <para style="q1" vid="LAM 2:12">就問母親：「五穀和酒在哪裡呢？」<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="qa">מ Mem</para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />女子<char style="pn">耶路撒冷</char>啊，</para>
  <para style="q1" vid="LAM 2:13">我能為你說什麼呢<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">我能為你說什麼呢——原文直譯「我用什麼為你作見證呢」。</char></note>？</para>
  <para style="q1" vid="LAM 2:13">我把你比作什麼呢？</para>
  <para style="q1" vid="LAM 2:13">少女<char style="pn">錫安</char>哪，</para>
  <para style="q1" vid="LAM 2:13">我把你等同什麼，</para>
  <para style="q1" vid="LAM 2:13">好安慰你呢？</para>
  <para style="q1" vid="LAM 2:13">因為你的破敗大如海洋，</para>
  <para style="q1" vid="LAM 2:13">誰能醫治你呢？<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="qa">נ Nun</para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />你的先知們為你見虛妄和騙人的異象；</para>
  <para style="q1" vid="LAM 2:14">他們沒有揭露你的罪孽，</para>
  <para style="q1" vid="LAM 2:14">好使你的擄民回歸，</para>
  <para style="q1" vid="LAM 2:14">卻向你指示虛妄和誤導人的默示。<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="qa">ס Samek</para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />所有過路的人都向你拍掌，</para>
  <para style="q1" vid="LAM 2:15">他們對女子<char style="pn">耶路撒冷</char>嗤笑、搖頭，說：</para>
  <para style="q1" vid="LAM 2:15">「這就是那被稱為全然美麗、全地所喜樂的城嗎？」<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="qa">פ Pe</para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />你一切的仇敵張開口攻擊你，</para>
  <para style="q1" vid="LAM 2:16">他們嗤笑、咬牙切齒，說：</para>
  <para style="q1" vid="LAM 2:16">「我們吞滅了她！</para>
  <para style="q1" vid="LAM 2:16">這真是我們等候的日子！</para>
  <para style="q1" vid="LAM 2:16">我們等到了，親眼看見了！」<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="qa">ע Ayin</para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />耶和華做成了他所決意的，</para>
  <para style="q1" vid="LAM 2:17">成就了他古時所命定的話語；</para>
  <para style="q1" vid="LAM 2:17">他拆毀，並不顧惜；</para>
  <para style="q1" vid="LAM 2:17">他讓仇敵對你幸災樂禍，</para>
  <para style="q1" vid="LAM 2:17">他高舉了你敵人的角。<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="qa">צ Tsade</para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />女子<char style="pn">錫安</char>的城牆啊，</para>
  <para style="q1" vid="LAM 2:18">你的心要向主呼求<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">你的心要向主呼求——原文直譯「他們的心向主呼求」。</char></note>！</para>
  <para style="q1" vid="LAM 2:18">願你的眼淚如河晝夜流下，</para>
  <para style="q1" vid="LAM 2:18">不讓自己歇息，</para>
  <para style="q1" vid="LAM 2:18">也不讓你眼中的瞳人休息！<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="qa">ק Qof</para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />起來，你要在夜間，</para>
  <para style="q1" vid="LAM 2:19">在更次開始的時候呼喊！</para>
  <para style="q1" vid="LAM 2:19">你要在主面前如水傾吐心意；</para>
  <para style="q1" vid="LAM 2:19">你要為你幼童的性命向主舉起雙手，</para>
  <para style="q1" vid="LAM 2:19">他們因饑荒在各個街頭昏倒。<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="qa">ר Resh</para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />耶和華啊，求你看顧，求你垂看！</para>
  <para style="q1" vid="LAM 2:20">你曾這樣對待過誰呢？</para>
  <para style="q1" vid="LAM 2:20">難道婦女可以吃自己所生的，撫育的幼童嗎？</para>
  <para style="q1" vid="LAM 2:20">難道祭司和先知可以在主的聖所中被殺死嗎？<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="qa">שׁ Shin</para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />少年人和老年人躺臥在街上的塵土中，</para>
  <para style="q1" vid="LAM 2:21">我的少女和少男倒在刀下；</para>
  <para style="q1" vid="LAM 2:21">你在烈怒的日子裡殺死了他們，</para>
  <para style="q1" vid="LAM 2:21">你殺戮，並不顧惜。<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="qa">ת Tav</para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />你從四圍召喚驚嚇我的人，</para>
  <para style="q1" vid="LAM 2:22">像在節期之日召喚人那樣。</para>
  <para style="q1" vid="LAM 2:22">在耶和華烈怒的日子裡，</para>
  <para style="q1" vid="LAM 2:22">沒有一個逃脫的人或倖存者；</para>
  <para style="q1" vid="LAM 2:22">我所撫育、養大的，</para>
  <para style="q1" vid="LAM 2:22">我的仇敵滅絕了他們。<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="s">耶和華的信實廣大</para>
  <para style="b" />
  <para style="qa">א Alef</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />我是在耶和華盛怒的杖下經歷苦難的人。<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />他驅趕我，使我行走在黑暗裡，</para>
  <para style="q1" vid="LAM 3:2">而沒有在光明中；<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />他真是終日一再地轉手攻擊我。<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="qa">ב Bet</para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />他使我的皮肉衰朽，</para>
  <para style="q1" vid="LAM 3:4">折斷我的骨頭；<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />他建造高壘攻擊我，</para>
  <para style="q1" vid="LAM 3:5">以苦楚和艱難包圍我。<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />他使我住在黑暗之地，</para>
  <para style="q1" vid="LAM 3:6">如同死了很久的人。<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="qa">ג Gimel</para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />他築牆攔住我，使我不能出去；</para>
  <para style="q1" vid="LAM 3:7">他使我的銅鏈沉重；<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />甚至我哀求、呼救的時候，</para>
  <para style="q1" vid="LAM 3:8">他掩耳不聽我的禱告；<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />他用鑿好的料石築牆攔住我的道路，</para>
  <para style="q1" vid="LAM 3:9">使我的路徑扭曲。<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="qa">ד Dalet</para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />他對我像埋伏的熊，</para>
  <para style="q1" vid="LAM 3:10">像在隱祕處的獅子；<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />他使我偏離道路，把我撕碎，</para>
  <para style="q1" vid="LAM 3:11">他使我淒涼；<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />他拉開弓，</para>
  <para style="q1" vid="LAM 3:12">把我立作箭靶子。<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="qa">ה He</para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />他把箭袋裡的箭射入我的肺腑；<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />我在我所有的族人中成為笑柄，</para>
  <para style="q1" vid="LAM 3:14">終日成為他們的歌謠。<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />他使我飽嘗苦澀，</para>
  <para style="q1" vid="LAM 3:15">醉嘗苦艾。<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="qa">ו Vav</para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />他用沙石磨碎我的牙齒，</para>
  <para style="q1" vid="LAM 3:16">使我蜷縮在灰燼中；<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />他使我的靈魂遠離平安，</para>
  <para style="q1" vid="LAM 3:17">我已忘記了福份；<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />我就說：「我的忍耐消亡了，</para>
  <para style="q1" vid="LAM 3:18">來自耶和華的盼望也消亡了！」<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="qa">ז Zayin</para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />求你記念我的苦難和流浪——苦艾和毒草！<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />我靈裡不斷想起這些事<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">這些事——輔助詞語。</char></note>，</para>
  <para style="q1" vid="LAM 3:20">就在我裡面沮喪，<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />但我心裡一回想以下的事，</para>
  <para style="q1" vid="LAM 3:21">我就因此有期盼。<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="qa">ח Khet</para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />我們不致滅盡，是因為耶和華的慈愛<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">我們不致滅盡，是因為耶和華的慈愛——有古抄本和古譯本作「耶和華的慈愛永不終止」。</char></note>，</para>
  <para style="q1" vid="LAM 3:22">他的憐憫永不止息；<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />每早晨這都是新的，</para>
  <para style="q1" vid="LAM 3:23">你的信實極其廣大！<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />我靈裡說：「耶和華是我繼業的份，</para>
  <para style="q1" vid="LAM 3:24">因此我要期盼他。」<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="qa">ט Tet</para>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />耶和華善待等候他的人和尋求他的人；<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />安靜等候耶和華的救恩，是美好的；<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />人在年輕時負軛，是美好的。<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="qa">י Yod</para>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />願他獨坐靜默，</para>
  <para style="q1" vid="LAM 3:28">因為這是耶和華讓他擔負的；<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />願他的口貼於塵土，</para>
  <para style="q1" vid="LAM 3:29">或許還有盼望；<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />願他把臉頰交給責打他的人，</para>
  <para style="q1" vid="LAM 3:30">使他飽受辱罵。<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="qa">כ Kaf</para>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />主必不永遠拋棄我們<note caller="+" style="f"><char style="fr" closed="false">3:31 </char><char style="ft" closed="false">我們——輔助詞語。</char></note>，<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />他雖然使我們悲傷，</para>
  <para style="q1" vid="LAM 3:32">卻照著豐盛的慈愛施憐憫；<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />因為他從心裡並不願意苦待人，</para>
  <para style="q1" vid="LAM 3:33">使世人悲傷。<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="qa">ל Lamed</para>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />把地上所有的被囚者壓碎在腳下，<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />在至高者面前屈枉人的公正，<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />在爭訟的事上屈枉人——</para>
  <para style="q1" vid="LAM 3:36">這些都是主不允許的。<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="qa">מ Mem</para>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />除非主命定，誰能說了就成就呢？<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />是禍是福，不都出於至高者的口嗎？<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />人——活著的人因自己的罪過受懲罰<note caller="+" style="f"><char style="fr" closed="false">3:39 </char><char style="ft" closed="false">受懲罰——輔助詞語。</char></note>，</para>
  <para style="q1" vid="LAM 3:39">為什麼發怨言呢？<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="qa">נ Nun</para>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />讓我們省察、探查自己的道路，</para>
  <para style="q1" vid="LAM 3:40">回轉歸向耶和華！<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />讓我們向天上的神，</para>
  <para style="q1" vid="LAM 3:41">舉起我們的心，舉起雙手！<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />我們叛逆、悖逆，</para>
  <para style="q1" vid="LAM 3:42">你並不赦免。<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="qa">ס Samek</para>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />你以怒氣披裹自己，追趕我們，</para>
  <para style="q1" vid="LAM 3:43">你殺戮，並不顧惜；<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />你以雲彩披裹自己，</para>
  <para style="q1" vid="LAM 3:44">以致禱告不能穿過；<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />你使我們在萬民當中成為渣滓和廢物。<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="qa">פ Pe</para>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />我們一切的仇敵張開口攻擊我們；<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />恐怖和陷坑，毀壞和敗亡都臨到我們；<verse eid="LAM 3:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />我的眼睛淚流成河，</para>
  <para style="q1" vid="LAM 3:48">因為我的子民<note caller="+" style="f"><char style="fr" closed="false">3:48 </char><char style="ft" closed="false">子民——原文直譯「女兒子民」。</char></note>敗亡。<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="qa">ע Ayin</para>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49" />我的眼睛流淚不止，</para>
  <para style="q1" vid="LAM 3:49">總是不停，<verse eid="LAM 3:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50" />直到耶和華俯看，</para>
  <para style="q1" vid="LAM 3:50">從天上觀看。<verse eid="LAM 3:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />因看見<note caller="+" style="f"><char style="fr" closed="false">3:51 </char><char style="ft" closed="false">看見——輔助詞語。</char></note>我城中女子，</para>
  <para style="q1" vid="LAM 3:51">我的眼睛給我的靈魂帶來悲痛。<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="qa">צ Tsade</para>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />我的仇敵無故獵捕我，</para>
  <para style="q1" vid="LAM 3:52">像獵捕雀鳥那樣；<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />他們要使我的性命在坑裡斷絕，</para>
  <para style="q1" vid="LAM 3:53">把石頭扔在我身上；<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />水淹過我的頭，</para>
  <para style="q1" vid="LAM 3:54">我說：「我被剪除了！」<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="qa">ק Qof</para>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />耶和華啊，我從最深的陰坑呼求你的名！<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />你已經聽見了我的聲音：</para>
  <para style="q1" vid="LAM 3:56">「求你不要掩耳不解救我，</para>
  <para style="q1" vid="LAM 3:56">不聽我的呼求！」<verse eid="LAM 3:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />在我呼求你的日子裡，</para>
  <para style="q1" vid="LAM 3:57">你靠近我，說：「不要害怕！」<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="qa">ר Resh</para>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />主啊，你為我的靈魂辯護，</para>
  <para style="q1" vid="LAM 3:58">你贖回了我的性命！<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />耶和華啊，你看見了我的冤屈，</para>
  <para style="q1" vid="LAM 3:59">求你為我施行公正的審判；<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />他們的報復，</para>
  <para style="q1" vid="LAM 3:60">他們針對我的計劃，</para>
  <para style="q1" vid="LAM 3:60">你全都看見了！<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="qa">שׂ Sin / שׁ Shin</para>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />耶和華啊，你聽見了他們的辱罵，</para>
  <para style="q1" vid="LAM 3:61">一切針對我的計策！<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />那些起來敵對我之人的嘴唇和流言蜚語終日攻擊我；<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />求你注目，他們坐下、起來，</para>
  <para style="q1" vid="LAM 3:63">我是他們嘲笑的歌曲！<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="qa">ת Tav</para>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />耶和華啊，你必照著他們手所做的，</para>
  <para style="q1" vid="LAM 3:64">向他們施行應得的報應！<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />你必使他們的心謬妄，</para>
  <para style="q1" vid="LAM 3:65">使你的詛咒臨到他們；<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />你必在怒氣中追趕他們，</para>
  <para style="q1" vid="LAM 3:66">從耶和華的諸天之下除滅他們。<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="s">陷落後的耶路撒冷</para>
  <para style="b" />
  <para style="qa">א Alef</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />金子竟然失去光澤，</para>
  <para style="q1" vid="LAM 4:1">上好的黃金竟然變了顏色！</para>
  <para style="q1" vid="LAM 4:1">神聖的寶石散落在各個街頭。<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="qa">ב Bet</para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />
    <char style="pn">錫安</char>寶貴的兒女曾與純金同比衡量，</para>
  <para style="q1" vid="LAM 4:2">現在竟然算為陶匠之手所做的瓦罐！<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="qa">ג Gimel</para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />連豺狗也哺乳牠們的幼仔，</para>
  <para style="q1" vid="LAM 4:3">但我的子民<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">子民——原文直譯「女兒子民」；本章下同。</char></note>卻凶狠如曠野中的鴕鳥。<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="qa">ד Dalet</para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />吃奶嬰兒的舌頭因乾渴緊貼著上顎；</para>
  <para style="q1" vid="LAM 4:4">幼童乞求糧食，卻無人分給他們。<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="qa">ה He</para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />那些曾吃美食的，</para>
  <para style="q1" vid="LAM 4:5">現在卻在街上淒涼；</para>
  <para style="q1" vid="LAM 4:5">那些穿著朱紅衣服長大的，</para>
  <para style="q1" vid="LAM 4:5">現在卻擁抱糞堆。<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="qa">ו Vav</para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />我子民的罪孽比<char style="pn">所多瑪</char>的罪惡更大——</para>
  <para style="q1" vid="LAM 4:6">
    <char style="pn">所多瑪</char>瞬間被傾覆，</para>
  <para style="q1" vid="LAM 4:6">儘管無人動手攻擊它。<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="qa">ז Zayin</para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />
    <char style="pn">錫安</char>的<char style="pn">拿細耳</char>人<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">拿細耳人——或譯作「貴族」或「分別為聖的人」。</char></note>曾比雪純淨，</para>
  <para style="q1" vid="LAM 4:7">比奶潔白；</para>
  <para style="q1" vid="LAM 4:7">他們的身體比紅寶石紅潤，</para>
  <para style="q1" vid="LAM 4:7">樣貌如同藍寶石。<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="qa">ח Khet</para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />現在他們的容貌比煤炭黝黑，</para>
  <para style="q1" vid="LAM 4:8">在街上無人認出；</para>
  <para style="q1" vid="LAM 4:8">他們的皮膚乾縮在骨頭上，</para>
  <para style="q1" vid="LAM 4:8">枯乾如同木柴。<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="qa">ט Tet</para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />被刀所殺的比死於饑荒的更好；</para>
  <para style="q1" vid="LAM 4:9">飢餓的因缺乏田野的出產，漸漸消瘦而死。<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="qa">י Yod</para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />慈心的婦女親手煮自己的孩子——</para>
  <para style="q1" vid="LAM 4:10">在我子民敗亡的時候，</para>
  <para style="q1" vid="LAM 4:10">孩子成為她們的食物。<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="qa">כ Kaf</para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />耶和華發盡了他的怒火，</para>
  <para style="q1" vid="LAM 4:11">傾瀉了他猛烈的怒氣；</para>
  <para style="q1" vid="LAM 4:11">他在<char style="pn">錫安</char>點火，</para>
  <para style="q1" vid="LAM 4:11">吞噬了她的根基。<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="qa">ל Lamed</para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />地上的君王們和世上所有的居民都不相信</para>
  <para style="q1" vid="LAM 4:12">敵人和仇敵能進入<char style="pn">耶路撒冷</char>的各城門。<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="qa">מ Mem</para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />這都因她的先知們的罪惡和祭司們的罪孽，</para>
  <para style="q1" vid="LAM 4:13">他們在城中流了義人血。<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="qa">נ Nun</para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />他們在街上盲目地流蕩，</para>
  <para style="q1" vid="LAM 4:14">他們被血玷汙，</para>
  <para style="q1" vid="LAM 4:14">沒有人能碰他們的衣袍。<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="qa">ס Samek</para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />人們向他們呼喊：</para>
  <para style="q1" vid="LAM 4:15">「走開，不潔淨的！</para>
  <para style="q1" vid="LAM 4:15">走開，走開，不要碰我們！」</para>
  <para style="q1" vid="LAM 4:15">他們就逃亡、四處漂泊；</para>
  <para style="q1" vid="LAM 4:15">列國中的人也說：</para>
  <para style="q1" vid="LAM 4:15">「他們不可再寄居下去！」<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="qa">פ Pe</para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />耶和華親自分散他們，</para>
  <para style="q1" vid="LAM 4:16">不再看顧他們；</para>
  <para style="q1" vid="LAM 4:16">人們不尊重祭司，</para>
  <para style="q1" vid="LAM 4:16">也不恩待長老。<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="qa">ע Ayin</para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />我們一直徒勞地期盼<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false">期盼——輔助詞語。</char></note>幫助，</para>
  <para style="q1" vid="LAM 4:17">以致眼睛衰竭；</para>
  <para style="q1" vid="LAM 4:17">我們在守望臺上守望，</para>
  <para style="q1" vid="LAM 4:17">期盼一個不能拯救我們的國家。<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="qa">צ Tsade</para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />敵人追蹤我們的腳步，</para>
  <para style="q1" vid="LAM 4:18">使我們不能在自己的街上行走。</para>
  <para style="q1" vid="LAM 4:18">我們的結局近了，</para>
  <para style="q1" vid="LAM 4:18">我們的日子滿了，</para>
  <para style="q1" vid="LAM 4:18">我們的結局已經來到了！<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="qa">ק Qof</para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />追趕我們的人比天空的老鷹更快，</para>
  <para style="q1" vid="LAM 4:19">他們在山上追逼我們，</para>
  <para style="q1" vid="LAM 4:19">在曠野中埋伏等着我們。<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="qa">ר Resh</para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />我們鼻孔的氣息——耶和華的受膏者，</para>
  <para style="q1" vid="LAM 4:20">在他們的陷坑中被捉住；</para>
  <para style="q1" vid="LAM 4:20">我們曾論到他，說：</para>
  <para style="q1" vid="LAM 4:20">「在他的蔭庇下，</para>
  <para style="q1" vid="LAM 4:20">我們要在列國中存活。」<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="qa">שׂ Sin</para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />住在<char style="pn">烏斯</char>地的女子<char style="pn">以東</char>啊，</para>
  <para style="q1" vid="LAM 4:21">儘管高興歡喜吧！</para>
  <para style="q1" vid="LAM 4:21">這杯也必傳到你那裡，</para>
  <para style="q1" vid="LAM 4:21">你必喝醉，赤身露體。<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="qa">ת Tav</para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />女子<char style="pn">錫安</char>哪，</para>
  <para style="q1" vid="LAM 4:22">你當受的懲罰已經結束，</para>
  <para style="q1" vid="LAM 4:22">耶和華必不再使你遷徙！</para>
  <para style="q1" vid="LAM 4:22">女子<char style="pn">以東</char>啊，</para>
  <para style="q1" vid="LAM 4:22">他必懲罰你的罪孽，</para>
  <para style="q1" vid="LAM 4:22">揭露你的罪惡！<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="s">求耶和華帶來更新</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1" />耶和華啊，求你記念所臨到我們的，</para>
  <para style="q1" vid="LAM 5:1">求你看顧，求你垂看我們的羞辱！<verse eid="LAM 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />我們的繼業轉歸外族人，</para>
  <para style="q1" vid="LAM 5:2">我們的房屋轉歸外邦人。<verse eid="LAM 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />我們成為孤兒，沒有父親，</para>
  <para style="q1" vid="LAM 5:3">我們的母親像寡婦那樣。<verse eid="LAM 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />我們喝的水要用銀子買，</para>
  <para style="q1" vid="LAM 5:4">我們的木柴要付代價得來。<verse eid="LAM 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />我們被緊緊追趕<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">我們被緊緊追趕——原文直譯「我們被追趕到了我們的頸項」。</char></note>；</para>
  <para style="q1" vid="LAM 5:5">我們疲憊，不得安息。<verse eid="LAM 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />我們向<char style="pn">埃及</char>和<char style="pn">亞述</char>舉手臣服，</para>
  <para style="q1" vid="LAM 5:6">為要得以飽食。<verse eid="LAM 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />我們的祖先犯了罪，</para>
  <para style="q1" vid="LAM 5:7">如今他們不在了，</para>
  <para style="q1" vid="LAM 5:7">我們卻背負他們的罪孽。<verse eid="LAM 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />奴僕管轄我們，</para>
  <para style="q1" vid="LAM 5:8">無人救拔我們脫離他們的手。<verse eid="LAM 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />因曠野中的刀劍，</para>
  <para style="q1" vid="LAM 5:9">我們冒生命危險得來糧食；<verse eid="LAM 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />因饑荒的燥熱，</para>
  <para style="q1" vid="LAM 5:10">我們的皮膚熱如火爐。<verse eid="LAM 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />婦女們在<char style="pn">錫安</char>被玷辱，</para>
  <para style="q1" vid="LAM 5:11">處女們在<char style="pn">猶大</char>各城被玷辱。<verse eid="LAM 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />首領們被綁手吊起，</para>
  <para style="q1" vid="LAM 5:12">長老們不被尊敬。<verse eid="LAM 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />青年人被迫推磨，</para>
  <para style="q1" vid="LAM 5:13">少年人在木柴的重壓<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">的重壓——輔助詞語。</char></note>之下絆倒。<verse eid="LAM 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />長老們已不在城門口，</para>
  <para style="q1" vid="LAM 5:14">青年人止息了他們的音樂。<verse eid="LAM 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />我們心裡的喜樂止息了，</para>
  <para style="q1" vid="LAM 5:15">我們的跳舞變為哀慟。<verse eid="LAM 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />冠冕從我們的頭上掉落；</para>
  <para style="q1" vid="LAM 5:16">我們有禍了！</para>
  <para style="q1" vid="LAM 5:16">因為我們犯了罪。<verse eid="LAM 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />因這事我們的心昏沉，</para>
  <para style="q1" vid="LAM 5:17">因這些事我們的眼睛昏暗——<verse eid="LAM 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />這都因為<char style="pn">錫安</char>山荒涼，</para>
  <para style="q1" vid="LAM 5:18">豺狗行在其上。<verse eid="LAM 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19" />耶和華啊，你永遠坐著為王，</para>
  <para style="q1" vid="LAM 5:19">你的寶座存到萬代！<verse eid="LAM 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />你為什麼永久忘記我們？</para>
  <para style="q1" vid="LAM 5:20">為什麼長久<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">長久——原文直譯「長久的日子」。</char></note>離棄我們呢？<verse eid="LAM 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />耶和華啊！求你使我們回轉歸向你，</para>
  <para style="q1" vid="LAM 5:21">我們就得以回轉；</para>
  <para style="q1" vid="LAM 5:21">求你更新我們的日子，</para>
  <para style="q1" vid="LAM 5:21">像古時一樣；<verse eid="LAM 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />或者你已經徹底厭棄了我們，</para>
  <para style="q1" vid="LAM 5:22">對我們發怒到了極點！<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>