<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">約珥書</para>
  <para style="mt">約珥書</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />耶和華的話語臨到<char style="pn">毗土珥</char>的兒子<char style="pn">約珥</char>：<verse eid="JOL 1:1" /></para>
  <para style="b" />
  <para style="s">蝗災</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />長老們哪，你們要聽這話！</para>
  <para style="q1" vid="JOL 1:2">這地所有的居民哪，你們要傾聽！</para>
  <para style="q1" vid="JOL 1:2">在你們的年日裡，</para>
  <para style="q1" vid="JOL 1:2">或在你們祖先的日子裡，</para>
  <para style="q1" vid="JOL 1:2">曾發生過這樣的事嗎？<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />你們要把這事向你們的兒女講述，</para>
  <para style="q1" vid="JOL 1:3">讓你們的兒女向他們的兒女講述，</para>
  <para style="q1" vid="JOL 1:3">再讓他們的兒女向後代講述。<verse eid="JOL 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />飛蝗剩下的，土蟥來吃；</para>
  <para style="q1" vid="JOL 1:4">土蟥剩下的，蝗蝻來吃；</para>
  <para style="q1" vid="JOL 1:4">蝗蝻剩下的，螞蚱來吃。<verse eid="JOL 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />醉酒的人哪，你們要醒來，要哭泣！</para>
  <para style="q1" vid="JOL 1:5">所有喝酒的人哪，你們都要為甜酒哀號！</para>
  <para style="q1" vid="JOL 1:5">因為甜酒從你們的口中斷絕了。<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />有一族上來攻擊我的土地，</para>
  <para style="q1" vid="JOL 1:6">強盛並且無法數算；</para>
  <para style="q1" vid="JOL 1:6">他們的牙齒如獅子的牙齒，</para>
  <para style="q1" vid="JOL 1:6">他們有母獅般的獠牙。<verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />他們使我的葡萄樹荒涼，</para>
  <para style="q1" vid="JOL 1:7">使我的無花果樹碎裂，</para>
  <para style="q1" vid="JOL 1:7">他們把樹皮剝盡又扔掉，</para>
  <para style="q1" vid="JOL 1:7">使樹枝露白。<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />當哀號，如處女束上麻布，為她年輕時的未婚夫<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">未婚夫——原文直譯「丈夫」。</char></note>哀號！<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />素祭和酒祭從耶和華的殿中斷絕了，</para>
  <para style="q1" vid="JOL 1:9">事奉耶和華的祭司們都悲慟。<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />田地被摧毀，土地荒蕪，</para>
  <para style="q1" vid="JOL 1:10">因為五穀被摧毀，</para>
  <para style="q1" vid="JOL 1:10">新酒枯竭，新油也缺乏了。<verse eid="JOL 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />農夫們哪，你們要羞愧！</para>
  <para style="q1" vid="JOL 1:11">葡萄園丁們哪，你們要哀號！</para>
  <para style="q1" vid="JOL 1:11">因為小麥、大麥和田地的莊稼都毀了。<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />葡萄樹枯乾，無花果樹衰殘，</para>
  <para style="q1" vid="JOL 1:12">石榴樹、棕櫚樹、蘋果樹、</para>
  <para style="q1" vid="JOL 1:12">田野一切的樹木都枯乾；</para>
  <para style="q1" vid="JOL 1:12">歡樂從世人中消逝了。<verse eid="JOL 1:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />祭司們哪，你們要束上麻布哀哭！</para>
  <para style="q1" vid="JOL 1:13">在祭壇前事奉的啊，你們要哀號！</para>
  <para style="q1" vid="JOL 1:13">事奉我神的啊，你們要來，披上麻布過夜！</para>
  <para style="q1" vid="JOL 1:13">因為素祭和酒祭從你們神的殿中都被止住了。<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />你們要把禁食的日子分別為聖，</para>
  <para style="q1" vid="JOL 1:14">要宣告嚴肅集會，</para>
  <para style="q1" vid="JOL 1:14">要招聚長老們和這地所有的居民，</para>
  <para style="q1" vid="JOL 1:14">到你們神耶和華的殿，</para>
  <para style="q1" vid="JOL 1:14">向耶和華哀求！<verse eid="JOL 1:14" /></para>
  <para style="b" />
  <para style="s">耶和華的日子</para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />哀哉那日子！</para>
  <para style="q1" vid="JOL 1:15">因為耶和華的日子臨近了；</para>
  <para style="q1" vid="JOL 1:15">那日子來到，像毀滅從全能者那裡來到。<verse eid="JOL 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />食物不是在我們眼前斷絕了嗎？</para>
  <para style="q1" vid="JOL 1:16">歡喜和快樂不是從我們神的殿中斷絕了嗎？<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />穀種在土塊下枯萎，</para>
  <para style="q1" vid="JOL 1:17">庫房荒涼，穀倉被拆毀，</para>
  <para style="q1" vid="JOL 1:17">因為五穀都枯乾了。<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />牲畜發出何等的哀鳴！</para>
  <para style="q1" vid="JOL 1:18">牛群流蕩，因為沒有草場給牠們，</para>
  <para style="q1" vid="JOL 1:18">連羊群也受了苦。<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />耶和華啊，我向你呼求！</para>
  <para style="q1" vid="JOL 1:19">因為火吞噬了曠野的牧場，</para>
  <para style="q1" vid="JOL 1:19">火焰燒盡了田野一切的樹木。<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />田野的走獸也切慕你，</para>
  <para style="q1" vid="JOL 1:20">因為溪水枯乾了，</para>
  <para style="q1" vid="JOL 1:20">火吞噬了曠野的牧場。<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />在<char style="pn">錫安</char>，當吹響號角！</para>
  <para style="q1" vid="JOL 2:1">在我的聖山，當呼喊！</para>
  <para style="q1" vid="JOL 2:1">讓這地所有的居民都顫抖，</para>
  <para style="q1" vid="JOL 2:1">因為耶和華的日子將到，</para>
  <para style="q1" vid="JOL 2:1">確實臨近了——<verse eid="JOL 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2" />那是黑暗幽冥的日子，</para>
  <para style="q1" vid="JOL 2:2">是密雲幽暗的日子。</para>
  <para style="q1" vid="JOL 2:2">有一個強盛的民族，</para>
  <para style="q1" vid="JOL 2:2">如同黎明覆蓋群山；</para>
  <para style="q1" vid="JOL 2:2">這樣的事自古以來未曾有過，</para>
  <para style="q1" vid="JOL 2:2">以後萬年萬代也不會再有。<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />他們前面有吞噬的烈火，</para>
  <para style="q1" vid="JOL 2:3">他們後面有燃燒的火焰；</para>
  <para style="q1" vid="JOL 2:3">他們前面的地像<char style="pn">伊甸</char>園，</para>
  <para style="q1" vid="JOL 2:3">他們後面的地如荒涼的曠野，</para>
  <para style="q1" vid="JOL 2:3">沒有一樣能逃脫他們的。<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />他們的樣子像馬的樣子，</para>
  <para style="q1" vid="JOL 2:4">戰馬怎樣奔跑，他們也怎樣奔跑。<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />他們在山頂上跳躍的聲音，</para>
  <para style="q1" vid="JOL 2:5">如戰車的聲音，</para>
  <para style="q1" vid="JOL 2:5">又如火焰吞噬麥稭的聲音，</para>
  <para style="q1" vid="JOL 2:5">他們好像強盛的民擺陣作戰。<verse eid="JOL 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />在他們面前，萬民痛苦，</para>
  <para style="q1" vid="JOL 2:6">人人臉色慘白。<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />他們如勇士奔跑，</para>
  <para style="q1" vid="JOL 2:7">又如戰士爬上城牆；</para>
  <para style="q1" vid="JOL 2:7">各行其道，</para>
  <para style="q1" vid="JOL 2:7">不偏離行進的路途；<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />他們彼此之間不擁擠，</para>
  <para style="q1" vid="JOL 2:8">各行其路；</para>
  <para style="q1" vid="JOL 2:8">他們衝鋒陷陣，也不停止。<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />他們猛衝入城，</para>
  <para style="q1" vid="JOL 2:9">奔上城牆，爬進房屋，</para>
  <para style="q1" vid="JOL 2:9">像盜賊那樣從窗戶進入。<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />在他們面前，大地顫抖，</para>
  <para style="q1" vid="JOL 2:10">諸天震動；</para>
  <para style="q1" vid="JOL 2:10">太陽和月亮變為黑暗，</para>
  <para style="q1" vid="JOL 2:10">星辰收回光輝。<verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />耶和華在他軍隊前面發出聲音，</para>
  <para style="q1" vid="JOL 2:11">他的陣營極大，</para>
  <para style="q1" vid="JOL 2:11">實行他話語的就是強者。</para>
  <para style="q1" vid="JOL 2:11">耶和華的日子極其大而可畏，</para>
  <para style="q1" vid="JOL 2:11">誰能承受得起呢？<verse eid="JOL 2:11" /></para>
  <para style="b" />
  <para style="s">神呼籲子民悔改</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />耶和華宣告：</para>
  <para style="q1" vid="JOL 2:12">「現在雖然如此，</para>
  <para style="q1" vid="JOL 2:12">你們要以禁食、哭泣、哀號，</para>
  <para style="q1" vid="JOL 2:12">全心回轉歸向我；<verse eid="JOL 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />你們要撕裂的是你們的心，</para>
  <para style="q1" vid="JOL 2:13">而不是你們的衣服。」</para>
  <para style="q1" vid="JOL 2:13">你們要回轉歸向耶和華你們的神，</para>
  <para style="q1" vid="JOL 2:13">因為他有恩惠、有憐憫，</para>
  <para style="q1" vid="JOL 2:13">不輕易發怒，並有豐盛的慈愛，</para>
  <para style="q1" vid="JOL 2:13">也會改變心意不降下災禍。<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />誰知道他不<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">不——輔助詞語。</char></note>會回轉、改變心意、</para>
  <para style="q1" vid="JOL 2:14">在他後面留下祝福——獻給耶和華你們神的素祭和酒祭？<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />在<char style="pn">錫安</char>，當吹響號角！</para>
  <para style="q1" vid="JOL 2:15">你們要把禁食的日子分別為聖，</para>
  <para style="q1" vid="JOL 2:15">要宣告嚴肅集會，<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />要招聚民眾，</para>
  <para style="q1" vid="JOL 2:16">要把會眾分別為聖，</para>
  <para style="q1" vid="JOL 2:16">要聚集老年人，</para>
  <para style="q1" vid="JOL 2:16">要招聚幼童和吃奶的嬰兒！</para>
  <para style="q1" vid="JOL 2:16">讓新郎從內室出來，</para>
  <para style="q1" vid="JOL 2:16">讓新娘從洞房出來，<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />讓事奉耶和華的祭司們</para>
  <para style="q1" vid="JOL 2:17">在柱廊和祭壇之間哭泣，</para>
  <para style="q1" vid="JOL 2:17">讓他們說：</para>
  <para style="q1" vid="JOL 2:17">「耶和華啊，求你顧惜你的子民！</para>
  <para style="q1" vid="JOL 2:17">不要使你的繼業受羞辱，</para>
  <para style="q1" vid="JOL 2:17">在列國中成為笑柄。</para>
  <para style="q1" vid="JOL 2:17">為什麼讓人在民眾當中說：</para>
  <para style="q1" vid="JOL 2:17">『他們的神在哪裡呢？』」<verse eid="JOL 2:17" /></para>
  <para style="s">神回應子民</para>
  <para style="p">
    <verse number="18" style="v" sid="JOL 2:18" />於是耶和華為自己的土地而嫉憤，憐恤他的子民。 <verse eid="JOL 2:18" /><verse number="19" style="v" sid="JOL 2:19" />耶和華回應他的子民說：</para>
  <para style="q1" vid="JOL 2:19">「看哪，我必賜給你們五穀、新酒和新油，</para>
  <para style="q1" vid="JOL 2:19">使你們飽足，</para>
  <para style="q1" vid="JOL 2:19">不再使你們受列國的羞辱！<verse eid="JOL 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />「我要使北方來的軍隊遠離你們，</para>
  <para style="q1" vid="JOL 2:20">我要把他們驅散到乾旱荒涼之地，</para>
  <para style="q1" vid="JOL 2:20">把他們的前隊趕入東邊的海，</para>
  <para style="q1" vid="JOL 2:20">把他們的後隊趕入西邊的海。</para>
  <para style="q1" vid="JOL 2:20">他們的臭氣上騰，</para>
  <para style="q1" vid="JOL 2:20">他們的惡臭上騰，</para>
  <para style="q1" vid="JOL 2:20">因為耶和華行了大事。」<verse eid="JOL 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOL 2:21" />土地啊，不要害怕，</para>
  <para style="q1" vid="JOL 2:21">當快樂歡喜！</para>
  <para style="q1" vid="JOL 2:21">因為耶和華行了大事。<verse eid="JOL 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22" />田野的走獸啊，不要害怕！</para>
  <para style="q1" vid="JOL 2:22">因為曠野的牧場長出了青草，</para>
  <para style="q1" vid="JOL 2:22">樹木結了果實，</para>
  <para style="q1" vid="JOL 2:22">無花果樹和葡萄樹也都結滿了佳果。<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />
    <char style="pn">錫安</char>的兒女啊，</para>
  <para style="q1" vid="JOL 2:23">你們當因耶和華你們的神而快樂歡喜！</para>
  <para style="q1" vid="JOL 2:23">因為他為公義的緣故賜給了你們秋雨<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">他為公義的緣故賜給了你們秋雨——或譯作「他賜給了你們公義的導師」。</char></note>，</para>
  <para style="q1" vid="JOL 2:23">他像先前那樣給你們降下了甘霖，</para>
  <para style="q1" vid="JOL 2:23">就是秋雨和春雨。<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />打穀場必滿了穀物，</para>
  <para style="q1" vid="JOL 2:24">榨池也必滿溢新酒和新油。<verse eid="JOL 2:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />「我派遣到你們中間的大軍——</para>
  <para style="q1" vid="JOL 2:25">土蟥、蝗蝻、螞蚱和飛蝗，</para>
  <para style="q1" vid="JOL 2:25">它們所吃盡的年份，</para>
  <para style="q1" vid="JOL 2:25">我必償還給你們。<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />你們必吃得豐富，並且飽足，</para>
  <para style="q1" vid="JOL 2:26">就讚美你們的神耶和華的名——</para>
  <para style="q1" vid="JOL 2:26">他為你們行了奇妙的事。</para>
  <para style="q1" vid="JOL 2:26">我的子民必不致蒙羞，直到永遠。<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />這樣，你們就會知道：</para>
  <para style="q1" vid="JOL 2:27">我就在<char style="pn">以色列</char>當中，</para>
  <para style="q1" vid="JOL 2:27">我是耶和華你們的神，沒有另一位。</para>
  <para style="q1" vid="JOL 2:27">我的子民必不致蒙羞，直到永遠。<verse eid="JOL 2:27" /></para>
  <para style="b" />
  <para style="s">神應許傾注他的靈</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />「此後，我要把我的靈</para>
  <para style="q1" vid="JOL 2:28">傾注在所有的人身<note caller="+" style="f"><char style="fr" closed="false">2:28 </char><char style="ft" closed="false">人身——原文直譯「肉體」。</char></note>上，</para>
  <para style="q1" vid="JOL 2:28">你們的兒女要說預言，</para>
  <para style="q1" vid="JOL 2:28">你們的老年人要做異夢，</para>
  <para style="q1" vid="JOL 2:28">你們的年輕人要見異象。<verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />在那些日子，</para>
  <para style="q1" vid="JOL 2:29">我也要把我的靈傾注在僕婢身上。<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />我要在天上地上行奇事——</para>
  <para style="q1" vid="JOL 2:30">有血、有火、有煙柱。<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />在耶和華大而可畏的日子來到之前，</para>
  <para style="q1" vid="JOL 2:31">太陽要變為黑暗，</para>
  <para style="q1" vid="JOL 2:31">月亮要變為血。<verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />那時候，無論誰呼求耶和華的名，</para>
  <para style="q1" vid="JOL 2:32">都將得救；</para>
  <para style="q1" vid="JOL 2:32">因為照著耶和華所說的，</para>
  <para style="q1" vid="JOL 2:32">在<char style="pn">錫安</char>山和<char style="pn">耶路撒冷</char>必有逃脫的，</para>
  <para style="q1" vid="JOL 2:32">在倖存者中，</para>
  <para style="q1" vid="JOL 2:32">必有耶和華所召喚的。<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s">審判萬國</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1" />「看哪，在那些日子，在那段時期，</para>
  <para style="q1" vid="JOL 3:1">我使<char style="pn">猶大</char>和<char style="pn">耶路撒冷</char>的擄民回歸時，<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />我要招聚萬國，</para>
  <para style="q1" vid="JOL 3:2">帶他們下到<char style="pn">約沙法</char>谷！</para>
  <para style="q1" vid="JOL 3:2">在那裡我要向他們施行審判——</para>
  <para style="q1" vid="JOL 3:2">這是為了我的子民，</para>
  <para style="q1" vid="JOL 3:2">就是他們打散在列國中的我的繼業<char style="pn">以色列</char>。</para>
  <para style="q1" vid="JOL 3:2">他們分了我的土地，<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />又為我的子民抽籤，</para>
  <para style="q1" vid="JOL 3:3">用男孩換妓女，</para>
  <para style="q1" vid="JOL 3:3">為喝酒賣女孩。<verse eid="JOL 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />「<char style="pn">提爾</char>、<char style="pn">西頓</char>和<char style="pn">非利士</char>全境的人哪，你們要對我做什麼呢？你們要向我施行報復嗎？如果你們要報復，我就使你們應得的報應飛快迅速地歸到你們頭上。 <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />你們既然奪取我的金銀，把我的珍寶帶到你們的廟宇， <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />又把<char style="pn">猶大</char>子孫和<char style="pn">耶路撒冷</char>子孫賣給<char style="pn">希臘</char>人的子孫，使他們遠離自己的地界， <verse eid="JOL 3:6" /><verse number="7" style="v" sid="JOL 3:7" />看哪，我要激起他們離開被你們所賣到的地方，又要使你們應得的報應歸到你們頭上！ <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />我必把你們的兒女賣在<char style="pn">猶大</char>子孫的手中，<char style="pn">猶大</char>子孫又必把他們賣給遠方<char style="pn">示巴</char>國的人。」這是耶和華說的。<verse eid="JOL 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />當在列國中宣告以下的話：</para>
  <para style="q1" vid="JOL 3:9">「你們要預備爭戰，</para>
  <para style="q1" vid="JOL 3:9">要激起勇士們，</para>
  <para style="q1" vid="JOL 3:9">讓所有的戰士都近前來，讓他們都上來；<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />你們要把犁頭打成刀劍，</para>
  <para style="q1" vid="JOL 3:10">要把鐮刀打成長矛，</para>
  <para style="q1" vid="JOL 3:10">讓軟弱的說：『我是勇士！』<verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />四圍所有的國家啊，</para>
  <para style="q1" vid="JOL 3:11">你們要趕快來，在那裡聚集！</para>
  <para style="q1" vid="JOL 3:11">耶和華啊，求你使你的勇士們下來！<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />「讓列國都奮起，</para>
  <para style="q1" vid="JOL 3:12">上到<char style="pn">約沙法</char>谷；</para>
  <para style="q1" vid="JOL 3:12">因為在那裡我必坐著審判四圍所有的國家。<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />伸出鐮刀吧，</para>
  <para style="q1" vid="JOL 3:13">因為莊稼成熟了；</para>
  <para style="q1" vid="JOL 3:13">來踐踏吧，</para>
  <para style="q1" vid="JOL 3:13">因為榨酒池滿了；</para>
  <para style="q1" vid="JOL 3:13">榨酒池已經滿溢，</para>
  <para style="q1" vid="JOL 3:13">因為他們的罪惡深重。<verse eid="JOL 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />「有許許多多的人群在『判決谷』，</para>
  <para style="q1" vid="JOL 3:14">因為耶和華的日子臨近了『判決谷』。<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />太陽和月亮變為黑暗，</para>
  <para style="q1" vid="JOL 3:15">星辰收回光輝。<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />耶和華從<char style="pn">錫安</char>吼叫，</para>
  <para style="q1" vid="JOL 3:16">從<char style="pn">耶路撒冷</char>發聲，</para>
  <para style="q1" vid="JOL 3:16">天地就震動；</para>
  <para style="q1" vid="JOL 3:16">但耶和華是他子民的避難所，</para>
  <para style="q1" vid="JOL 3:16">是<char style="pn">以色列</char>子孫的保障。」<verse eid="JOL 3:16" /></para>
  <para style="b" />
  <para style="s">猶大蒙祝福</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />「那時你們就知道：</para>
  <para style="q1" vid="JOL 3:17">我是耶和華你們的神，</para>
  <para style="q1" vid="JOL 3:17">居住在<char style="pn">錫安</char>我的聖山上。</para>
  <para style="q1" vid="JOL 3:17">
    <char style="pn">耶路撒冷</char>必成為神聖的，</para>
  <para style="q1" vid="JOL 3:17">外族人必不再從其中經過。<verse eid="JOL 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />到那日，</para>
  <para style="q1" vid="JOL 3:18">大山必淌落甜酒，</para>
  <para style="q1" vid="JOL 3:18">小山必流出奶，</para>
  <para style="q1" vid="JOL 3:18">
    <char style="pn">猶大</char>的溪谷都有水流淌；</para>
  <para style="q1" vid="JOL 3:18">必有泉源從耶和華的殿中流出，</para>
  <para style="q1" vid="JOL 3:18">澆灌<char style="pn">什亭</char>溪谷。<verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />
    <char style="pn">埃及</char>必變得荒涼，</para>
  <para style="q1" vid="JOL 3:19">
    <char style="pn">以東</char>必變為荒涼的曠野，</para>
  <para style="q1" vid="JOL 3:19">因為他們向<char style="pn">猶大</char>子孫行殘暴，</para>
  <para style="q1" vid="JOL 3:19">在<char style="pn">猶大</char>地流了無辜人的血。<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />然而，<char style="pn">猶大</char>必有人居住，直到永遠，</para>
  <para style="q1" vid="JOL 3:20">
    <char style="pn">耶路撒冷</char>也必有人居住，直到萬代。<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />我必追討我尚未追討的殺人流血的罪，</para>
  <para style="q1" vid="JOL 3:21">因為耶和華居住在<char style="pn">錫安</char>。」<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
  <chapter number="4" style="c" sid="JOL 4" />
  <chapter eid="JOL 4" />
</usx>