<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">雅歌</para>
  <para style="mt">雅歌</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="nb">
    <verse number="1" style="v" sid="SNG 1:1" />歌中之歌，<char style="pn">所羅門</char>的歌。<verse eid="SNG 1:1" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />願他的口連連親吻我！</para>
  <para style="q1" vid="SNG 1:2">你的愛情實在比酒更醇美。<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />你的膏油馨香芬芳，</para>
  <para style="q1" vid="SNG 1:3">你的名如膏油淌溢，</para>
  <para style="q1" vid="SNG 1:3">因此少女們都愛你。<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />拉著我跟隨你啊，</para>
  <para style="q1" vid="SNG 1:4">讓我們快跑——</para>
  <para style="q1" vid="SNG 1:4">王帶我進了他的內室！</para>
  <para style="q1" vid="SNG 1:4">讓我們因你而歡喜快樂，</para>
  <para style="q1" vid="SNG 1:4">回味你的愛情勝過品嘗美酒。</para>
  <para style="q1" vid="SNG 1:4">她們理當愛你！<verse eid="SNG 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />
    <char style="pn">耶路撒冷</char>的女兒們哪，</para>
  <para style="q1" vid="SNG 1:5">我雖然黑，但是秀美，</para>
  <para style="q1" vid="SNG 1:5">如同<char style="pn">基達</char>的帳篷，</para>
  <para style="q1" vid="SNG 1:5">如同<char style="pn">所羅門</char>的幔帳。<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />不要因為我黑就那樣看我，</para>
  <para style="q1" vid="SNG 1:6">是太陽曬黑了我。</para>
  <para style="q1" vid="SNG 1:6">我母親的兒子們對我發怒，</para>
  <para style="q1" vid="SNG 1:6">讓我看護葡萄園，</para>
  <para style="q1" vid="SNG 1:6">我自己的葡萄園卻沒有看護。<verse eid="SNG 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />我心所愛的啊，請告訴我，</para>
  <para style="q1" vid="SNG 1:7">你在何處放牧，</para>
  <para style="q1" vid="SNG 1:7">中午你讓羊群在何處安歇？</para>
  <para style="q1" vid="SNG 1:7">我何必像蒙著臉<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">蒙著臉——或譯作「徘徊」。</char></note>的女子，</para>
  <para style="q1" vid="SNG 1:7">在你同伴的羊群旁邊呢？<verse eid="SNG 1:7" /></para>
  <para style="b" />
  <para style="sp">眾人</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />你這女子中最美麗的，</para>
  <para style="q1" vid="SNG 1:8">你如果不知道，</para>
  <para style="q1" vid="SNG 1:8">就跟著羊群的腳蹤出去吧，</para>
  <para style="q1" vid="SNG 1:8">在牧人們的帳篷旁邊</para>
  <para style="q1" vid="SNG 1:8">牧放你的小羊。<verse eid="SNG 1:8" /></para>
  <para style="b" />
  <para style="s">良人</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />我的佳偶啊，</para>
  <para style="q1" vid="SNG 1:9">我將你比作法老車駕前的牝馬；<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />你的臉頰因流蘇而秀美，</para>
  <para style="q1" vid="SNG 1:10">你的頸項因珠串而優雅！<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />我們要為你製作金流蘇，</para>
  <para style="q1" vid="SNG 1:11">綴上銀珠子。<verse eid="SNG 1:11" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />王偎坐下來的時候，</para>
  <para style="q1" vid="SNG 1:12">我的哪噠散發馨香。<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />我以我的良人為一袋沒藥，</para>
  <para style="q1" vid="SNG 1:13">長留在我胸懷間；<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />我以我的良人為一串鳳仙花，</para>
  <para style="q1" vid="SNG 1:14">盛開<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">盛開——輔助詞語。</char></note>在<char style="pn">恩蓋迪</char>的葡萄園。<verse eid="SNG 1:14" /></para>
  <para style="b" />
  <para style="s">良人</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />看哪，我的佳偶，你多美麗！</para>
  <para style="q1" vid="SNG 1:15">看哪，你多美麗！</para>
  <para style="q1" vid="SNG 1:15">你的眼睛像一對鴿子。<verse eid="SNG 1:15" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />看哪，我的良人，</para>
  <para style="q1" vid="SNG 1:16">你多俊美，多麼美好！</para>
  <para style="q1" vid="SNG 1:16">我們的床多麼青翠，<verse eid="SNG 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />我們房屋的梁都是香柏木，</para>
  <para style="q1" vid="SNG 1:17">我們的椽子是松木。<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />我是<char style="pn">沙崙</char>的玫瑰花，</para>
  <para style="q1" vid="SNG 2:1">是谷中的百合花。<verse eid="SNG 2:1" /></para>
  <para style="b" />
  <para style="sp">良人</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />我的佳偶在女子中，</para>
  <para style="q1" vid="SNG 2:2">像蒺藜叢中的一枝百合花！<verse eid="SNG 2:2" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />我的良人在男子中，</para>
  <para style="q1" vid="SNG 2:3">像林木中的一棵蘋果樹。</para>
  <para style="q1" vid="SNG 2:3">我歡喜地坐在他樹蔭下，</para>
  <para style="q1" vid="SNG 2:3">他的果實在我唇齒間甘甜。<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />他帶我進入宴會殿堂，</para>
  <para style="q1" vid="SNG 2:4">愛的旗幟在我之上。<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />請以葡萄餅增補我力量，</para>
  <para style="q1" vid="SNG 2:5">以蘋果使我舒暢，</para>
  <para style="q1" vid="SNG 2:5">因我思愛成病！<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />願他左手托着我的頭，</para>
  <para style="q1" vid="SNG 2:6">右手抱住我。<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />
    <char style="pn">耶路撒冷</char>的女兒們哪，</para>
  <para style="q1" vid="SNG 2:7">我指著羚羊或田野的母鹿叮囑你們：</para>
  <para style="q1" vid="SNG 2:7">不要催促，不要催發愛情，</para>
  <para style="q1" vid="SNG 2:7">要等它自願發生！<verse eid="SNG 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />聽啊，我良人的聲音！</para>
  <para style="q1" vid="SNG 2:8">看哪，他來了——</para>
  <para style="q1" vid="SNG 2:8">躍過群山，翻過山嶺！<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />我的良人好比羚羊或小鹿。</para>
  <para style="q1" vid="SNG 2:9">看哪，他站在我們的牆外面，</para>
  <para style="q1" vid="SNG 2:9">透過窗戶凝望，</para>
  <para style="q1" vid="SNG 2:9">透過窗格探看！<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />我的良人呼喚我說：</para>
  <para style="q1" vid="SNG 2:10">「起來，我的佳偶！</para>
  <para style="q1" vid="SNG 2:10">走吧，我的美人！<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />看哪，冬天已經過去，</para>
  <para style="q1" vid="SNG 2:11">雨季已經消逝離開；<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />大地上百花綻放，</para>
  <para style="q1" vid="SNG 2:12">歡唱<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">歡唱——或譯作「修剪」；原文是雙關語。</char></note>的時節來到，</para>
  <para style="q1" vid="SNG 2:12">我們境內已經聽見斑鳩的叫聲；<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />無花果樹結出了青果，</para>
  <para style="q1" vid="SNG 2:13">葡萄樹也開花放香。</para>
  <para style="q1" vid="SNG 2:13">起來，我的佳偶！</para>
  <para style="q1" vid="SNG 2:13">跟我走吧，我的美人！」<verse eid="SNG 2:13" /></para>
  <para style="b" />
  <para style="s">良人</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />我的鴿子啊，</para>
  <para style="q1" vid="SNG 2:14">你在山岩縫隙中，</para>
  <para style="q1" vid="SNG 2:14">在峭壁的隱祕處。</para>
  <para style="q1" vid="SNG 2:14">請讓我看見你的容貌，</para>
  <para style="q1" vid="SNG 2:14">聽見你的聲音；</para>
  <para style="q1" vid="SNG 2:14">因為你的聲音甜美，</para>
  <para style="q1" vid="SNG 2:14">你的容貌秀美。<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />請為我們捉拿狐狸，</para>
  <para style="q1" vid="SNG 2:15">就是毀壞葡萄園的小狐狸，</para>
  <para style="q1" vid="SNG 2:15">我們的葡萄園正在花期。<verse eid="SNG 2:15" /></para>
  <para style="b" />
  <para style="s">女子</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />我的良人屬我，我也屬他；</para>
  <para style="q1" vid="SNG 2:16">他在百合花中放牧。<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />等天起涼風、日影飛逝的時候，</para>
  <para style="q1" vid="SNG 2:17">我的良人哪，你要回來，</para>
  <para style="q1" vid="SNG 2:17">好比羚羊或小鹿，</para>
  <para style="q1" vid="SNG 2:17">越過起伏的山嶺<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">起伏的山嶺——或音譯「比特山」。</char></note>！<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />夜間我在床上，</para>
  <para style="q1" vid="SNG 3:1">尋找我心所愛的；</para>
  <para style="q1" vid="SNG 3:1">我尋找他，卻沒有找到。<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />「我要起來，走遍城中，</para>
  <para style="q1" vid="SNG 3:2">在街道，在廣場，</para>
  <para style="q1" vid="SNG 3:2">尋找我心所愛的！」</para>
  <para style="q1" vid="SNG 3:2">我尋找他，還是沒有找到。<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />守夜的人遇見了我，</para>
  <para style="q1" vid="SNG 3:3">他們正在城中巡行。</para>
  <para style="q1" vid="SNG 3:3">「你們有沒有看見我心所愛的？」<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />我剛離開他們，</para>
  <para style="q1" vid="SNG 3:4">就找到我心所愛的。</para>
  <para style="q1" vid="SNG 3:4">我抱住他，不放他走，</para>
  <para style="q1" vid="SNG 3:4">直到把他帶到我母親的家，</para>
  <para style="q1" vid="SNG 3:4">進入孕育我之人的內室。<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />
    <char style="pn">耶路撒冷</char>的女兒們哪，</para>
  <para style="q1" vid="SNG 3:5">我指著羚羊或田野的母鹿叮囑你們：</para>
  <para style="q1" vid="SNG 3:5">不要催促，不要催發愛情，</para>
  <para style="q1" vid="SNG 3:5">要等它自願發生！<verse eid="SNG 3:5" /></para>
  <para style="b" />
  <para style="sp">眾人</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />那像煙柱一樣，</para>
  <para style="q1" vid="SNG 3:6">從曠野上來的是什麼呢？</para>
  <para style="q1" vid="SNG 3:6">它熏染了沒藥和乳香，</para>
  <para style="q1" vid="SNG 3:6">以及客商各樣的香粉。<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />看哪，是<char style="pn">所羅門</char>的御轎！</para>
  <para style="q1" vid="SNG 3:7">四圍有六十位勇士，</para>
  <para style="q1" vid="SNG 3:7">
    <char style="pn">以色列</char>精銳的勇士。<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />他們全都佩刀，善於爭戰；</para>
  <para style="q1" vid="SNG 3:8">各人腰間佩刀，</para>
  <para style="q1" vid="SNG 3:8">應對夜間的危險。<verse eid="SNG 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />
    <char style="pn">所羅門</char>王用<char style="pn">黎巴嫩</char>的木料，</para>
  <para style="q1" vid="SNG 3:9">為自己做了一頂轎子：<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />轎柱是銀做的，</para>
  <para style="q1" vid="SNG 3:10">轎底是金做的，</para>
  <para style="q1" vid="SNG 3:10">坐墊是紫色布，</para>
  <para style="q1" vid="SNG 3:10">轎內裝飾著<char style="pn">耶路撒冷</char>女兒們的愛情。<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />
    <char style="pn">錫安</char>的女兒啊，</para>
  <para style="q1" vid="SNG 3:11">你們出來觀看<char style="pn">所羅門</char>王，</para>
  <para style="q1" vid="SNG 3:11">他戴著冠冕，</para>
  <para style="q1" vid="SNG 3:11">是在他結婚的日子，</para>
  <para style="q1" vid="SNG 3:11">心裡喜樂的日子，</para>
  <para style="q1" vid="SNG 3:11">母親為他戴上的！<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">良人</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />看哪，我的佳偶，你多美麗！</para>
  <para style="q1" vid="SNG 4:1">看哪，你多美麗！</para>
  <para style="q1" vid="SNG 4:1">你的眼睛在面紗後，</para>
  <para style="q1" vid="SNG 4:1">好像一對鴿子。</para>
  <para style="q1" vid="SNG 4:1">你的頭髮像一群山羊，</para>
  <para style="q1" vid="SNG 4:1">從<char style="pn">基列</char>山奔下來。<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />你的牙齒好比一群新剪毛的羊，</para>
  <para style="q1" vid="SNG 4:2">洗淨後上來，</para>
  <para style="q1" vid="SNG 4:2">全都是雙生的，</para>
  <para style="q1" vid="SNG 4:2">沒有失喪一隻。<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />你的嘴唇像一條紅絲帶，</para>
  <para style="q1" vid="SNG 4:3">你的小嘴也秀美。</para>
  <para style="q1" vid="SNG 4:3">你的臉頰在面紗後，</para>
  <para style="q1" vid="SNG 4:3">就像兩瓣石榴。<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />你的頸項如<char style="pn">大衛</char>的塔樓，</para>
  <para style="q1" vid="SNG 4:4">層疊建造，</para>
  <para style="q1" vid="SNG 4:4">有一千小盾掛在其上，</para>
  <para style="q1" vid="SNG 4:4">全是勇士的盾牌。<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />你的雙乳像兩隻小鹿，</para>
  <para style="q1" vid="SNG 4:5">像雙生的羚羊，</para>
  <para style="q1" vid="SNG 4:5">徜徉在百合花中。<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />等到天起涼風、日影飛逝，</para>
  <para style="q1" vid="SNG 4:6">我就前往沒藥山、乳香嶺！<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />我的佳偶，</para>
  <para style="q1" vid="SNG 4:7">你全然美麗，你毫無瑕疵！<verse eid="SNG 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />我的新娘啊，</para>
  <para style="q1" vid="SNG 4:8">讓我帶你離開<char style="pn">黎巴嫩</char>山，</para>
  <para style="q1" vid="SNG 4:8">一同離開<char style="pn">黎巴嫩</char>山！</para>
  <para style="q1" vid="SNG 4:8">從<char style="pn">亞瑪拿</char>山頂，</para>
  <para style="q1" vid="SNG 4:8">從<char style="pn">示尼珥</char>和<char style="pn">黑門</char>山頂，</para>
  <para style="q1" vid="SNG 4:8">從獅子洞和豹子山俯看！<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />你奪去了我的心，</para>
  <para style="q1" vid="SNG 4:9">我的妹子，我的新娘！</para>
  <para style="q1" vid="SNG 4:9">你用眼眸的一瞥，</para>
  <para style="q1" vid="SNG 4:9">用你頸項上的一串明珠，</para>
  <para style="q1" vid="SNG 4:9">奪去了我的心。<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />你的愛情多麼美，</para>
  <para style="q1" vid="SNG 4:10">我的妹子，我的新娘！</para>
  <para style="q1" vid="SNG 4:10">你的愛情多麼醇美，勝過美酒；</para>
  <para style="q1" vid="SNG 4:10">你膏油的馨香勝過一切香料。<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />你的嘴唇滴落蜂房的蜜，</para>
  <para style="q1" vid="SNG 4:11">新娘啊，你舌頭底下有蜂蜜和奶，</para>
  <para style="q1" vid="SNG 4:11">你衣裳的香氣如<char style="pn">黎巴嫩</char>的香氣。<verse eid="SNG 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />你是關鎖的園子，</para>
  <para style="q1" vid="SNG 4:12">我的妹子，我的新娘！</para>
  <para style="q1" vid="SNG 4:12">你是關鎖的園林<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">園林——或譯作「水井」。</char></note>，封住的泉源。<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />你所栽種的<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">所栽種的——或譯作「所灌溉的」。</char></note>是石榴園，</para>
  <para style="q1" vid="SNG 4:13">有佳美的果實，</para>
  <para style="q1" vid="SNG 4:13">還有鳳仙花和哪噠，<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />哪噠和番紅花，菖蒲和肉桂，</para>
  <para style="q1" vid="SNG 4:14">以及各樣的乳香樹，</para>
  <para style="q1" vid="SNG 4:14">有沒藥和沉香，</para>
  <para style="q1" vid="SNG 4:14">以及各樣上等的香料。<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />你是園中的泉源，</para>
  <para style="q1" vid="SNG 4:15">是活水井，</para>
  <para style="q1" vid="SNG 4:15">是從<char style="pn">黎巴嫩</char>流下來的溪水。<verse eid="SNG 4:15" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />北風啊，興起！</para>
  <para style="q1" vid="SNG 4:16">南風啊，吹來！</para>
  <para style="q1" vid="SNG 4:16">吹進我的園子，</para>
  <para style="q1" vid="SNG 4:16">讓其中的香氣散發出來。</para>
  <para style="q1" vid="SNG 4:16">願我的良人進入他的園子，</para>
  <para style="q1" vid="SNG 4:16">享用佳美的果實。<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">良人</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />我進了我的園子，</para>
  <para style="q1" vid="SNG 5:1">我的妹子，我的新娘！</para>
  <para style="q1" vid="SNG 5:1">我采摘了我的沒藥和香料，</para>
  <para style="q1" vid="SNG 5:1">吃了我的蜂房和蜂蜜，</para>
  <para style="q1" vid="SNG 5:1">喝了我的酒和奶。</para>
  <para style="q1" vid="SNG 5:1">吃吧，朋友們！</para>
  <para style="q1" vid="SNG 5:1">喝吧，暢飲吧，親愛的人們！<verse eid="SNG 5:1" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />我沉睡，心卻醒著。</para>
  <para style="q1" vid="SNG 5:2">聽啊，我良人的聲音，</para>
  <para style="q1" vid="SNG 5:2">他在叩門。</para>
  <para style="b" vid="SNG 5:2" />
  <para style="sp" vid="SNG 5:2">良人</para>
  <para style="q1" vid="SNG 5:2">「請給我開門，</para>
  <para style="q1" vid="SNG 5:2">我的妹子，我的佳偶，</para>
  <para style="q1" vid="SNG 5:2">我的鴿子，我的完美佳人！</para>
  <para style="q1" vid="SNG 5:2">我頭上滿了露水，</para>
  <para style="q1" vid="SNG 5:2">髮綹沾滿夜間的霧滴。」<verse eid="SNG 5:2" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />「我已脫下袍子，</para>
  <para style="q1" vid="SNG 5:3">怎能再穿上呢？</para>
  <para style="q1" vid="SNG 5:3">我已洗淨雙腳，</para>
  <para style="q1" vid="SNG 5:3">怎能再弄髒呢？」<verse eid="SNG 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />我的良人從門縫伸進手來，</para>
  <para style="q1" vid="SNG 5:4">我的內心就因他而顫動。<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />我起來給我的良人開門，</para>
  <para style="q1" vid="SNG 5:5">我的雙手滴落沒藥，</para>
  <para style="q1" vid="SNG 5:5">我手指頭的沒藥汁落在門閂上。<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />我給良人開了門，</para>
  <para style="q1" vid="SNG 5:6">良人卻已轉身離去。</para>
  <para style="q1" vid="SNG 5:6">他告別的時候，我傷心至極！</para>
  <para style="q1" vid="SNG 5:6">我尋找他，卻沒有找到；</para>
  <para style="q1" vid="SNG 5:6">我呼喚他，卻沒有回應。<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />守夜的人遇見了我，</para>
  <para style="q1" vid="SNG 5:7">他們正在城中巡行。</para>
  <para style="q1" vid="SNG 5:7">他們擊打我，打傷我；</para>
  <para style="q1" vid="SNG 5:7">那些看守城牆的人，</para>
  <para style="q1" vid="SNG 5:7">從我身上拿走我的披巾。<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />
    <char style="pn">耶路撒冷</char>的女兒們哪，</para>
  <para style="q1" vid="SNG 5:8">我叮囑你們：</para>
  <para style="q1" vid="SNG 5:8">如果你們找到我的良人，</para>
  <para style="q1" vid="SNG 5:8">請告訴他：我思愛成病！<verse eid="SNG 5:8" /></para>
  <para style="b" />
  <para style="sp">耶路撒冷的女子</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />你這女子中最美麗的，</para>
  <para style="q1" vid="SNG 5:9">你的良人比別人的良人好在哪裡？</para>
  <para style="q1" vid="SNG 5:9">你的良人比別人的良人好在哪裡，</para>
  <para style="q1" vid="SNG 5:9">你竟這樣叮囑我們？<verse eid="SNG 5:9" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />我的良人光潔紅潤，</para>
  <para style="q1" vid="SNG 5:10">超乎萬人之上。<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />他的頭好像至純的黃金，</para>
  <para style="q1" vid="SNG 5:11">他的髮綹卷曲，黑如烏鴉。<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />他的眼睛好像溪水旁的鴿子，</para>
  <para style="q1" vid="SNG 5:12">在牛奶中洗淨了，</para>
  <para style="q1" vid="SNG 5:12">停落在池塘邊<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">停落在池塘邊——或譯作「鑲嵌如寶石」。</char></note>。<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />他的臉頰如香花畦，</para>
  <para style="q1" vid="SNG 5:13">如香草的高臺。</para>
  <para style="q1" vid="SNG 5:13">他的嘴唇是百合花，</para>
  <para style="q1" vid="SNG 5:13">滴落沒藥汁。<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />他的手臂是金杖，</para>
  <para style="q1" vid="SNG 5:14">鑲嵌著黃水晶。</para>
  <para style="q1" vid="SNG 5:14">他的腰腹是拋光的象牙，</para>
  <para style="q1" vid="SNG 5:14">鑲裹著藍寶石。<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />他的大腿是白玉石柱，</para>
  <para style="q1" vid="SNG 5:15">穩立在純金底座上。</para>
  <para style="q1" vid="SNG 5:15">他的身材像<char style="pn">黎巴嫩</char>山，</para>
  <para style="q1" vid="SNG 5:15">挺拔如香柏樹。<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />他的唇齒甜蜜，</para>
  <para style="q1" vid="SNG 5:16">他全然令人珍愛。</para>
  <para style="q1" vid="SNG 5:16">
    <char style="pn">耶路撒冷</char>的女兒們哪，</para>
  <para style="q1" vid="SNG 5:16">這就是我的良人，</para>
  <para style="q1" vid="SNG 5:16">這就是我的朋友！<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">耶路撒冷的女子</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />你這女子中最美麗的，</para>
  <para style="q1" vid="SNG 6:1">你的良人去了哪裡？</para>
  <para style="q1" vid="SNG 6:1">你的良人轉往了何處？</para>
  <para style="q1" vid="SNG 6:1">讓我們與你一同尋找他！<verse eid="SNG 6:1" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />我的良人前往他的園子，</para>
  <para style="q1" vid="SNG 6:2">到了香花畦，</para>
  <para style="q1" vid="SNG 6:2">在園子裡放牧，</para>
  <para style="q1" vid="SNG 6:2">采摘百合花。<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />我屬我的良人，</para>
  <para style="q1" vid="SNG 6:3">我的良人也屬我；</para>
  <para style="q1" vid="SNG 6:3">他在百合花中放牧。<verse eid="SNG 6:3" /></para>
  <para style="b" />
  <para style="sp">良人</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />我的佳偶，你美麗如<char style="pn">提爾撒</char>，</para>
  <para style="q1" vid="SNG 6:4">秀美如<char style="pn">耶路撒冷</char>，</para>
  <para style="q1" vid="SNG 6:4">威嚴如高舉旌旗的軍隊。<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />請將你的眼眸從我移開，</para>
  <para style="q1" vid="SNG 6:5">因為它們使我驚亂。</para>
  <para style="q1" vid="SNG 6:5">你的頭髮像一群山羊，</para>
  <para style="q1" vid="SNG 6:5">從<char style="pn">基列</char>山奔下來。<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />你的牙齒好比一群羊，</para>
  <para style="q1" vid="SNG 6:6">洗淨後上來，</para>
  <para style="q1" vid="SNG 6:6">全都是雙生的，</para>
  <para style="q1" vid="SNG 6:6">沒有失喪一隻。<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />你的臉頰在面紗後，</para>
  <para style="q1" vid="SNG 6:7">就像兩瓣石榴。<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />雖有六十位王后，</para>
  <para style="q1" vid="SNG 6:8">八十位妃嬪，</para>
  <para style="q1" vid="SNG 6:8">以及無數的少女——<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />我的鴿子，我的完美佳人，</para>
  <para style="q1" vid="SNG 6:9">她卻是獨一的！</para>
  <para style="q1" vid="SNG 6:9">她母親看她是獨一的，</para>
  <para style="q1" vid="SNG 6:9">生她的婦人以她為最愛<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">以她為最愛——依據七十士譯本；或譯作「看她最純潔」。</char></note>。</para>
  <para style="q1" vid="SNG 6:9">眾女子看見她，就稱她有福，</para>
  <para style="q1" vid="SNG 6:9">王后和妃嬪們也都讚美她。<verse eid="SNG 6:9" /></para>
  <para style="b" />
  <para style="sp">耶路撒冷的女子</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />那像曙光一樣俯視的是誰呢？</para>
  <para style="q1" vid="SNG 6:10">她美麗如月亮，</para>
  <para style="q1" vid="SNG 6:10">光潔如太陽，</para>
  <para style="q1" vid="SNG 6:10">威嚴如高舉旌旗的軍隊！<verse eid="SNG 6:10" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />我前往核桃園，</para>
  <para style="q1" vid="SNG 6:11">要看看溪谷中的嫩枝，</para>
  <para style="q1" vid="SNG 6:11">葡萄樹是否發芽，</para>
  <para style="q1" vid="SNG 6:11">石榴樹是否開花。<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />不知不覺，</para>
  <para style="q1" vid="SNG 6:12">我坐上了尊貴者的戰車。<verse eid="SNG 6:12" /></para>
  <para style="b" />
  <para style="sp">耶路撒冷的女子</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />
    <note caller="+" style="f">
      <char style="fr" closed="false">6:13 </char>
      <char style="ft" closed="false">——此節在馬索拉文本為7:1。</char>
    </note>回來，回來，<char style="pn">書拉密</char>的女子！</para>
  <para style="q1" vid="SNG 6:13">回來，回來，讓我們看看你！</para>
  <para style="b" vid="SNG 6:13" />
  <para style="sp" vid="SNG 6:13">良人</para>
  <para style="q1" vid="SNG 6:13">你們為什麼要觀看<char style="pn">書拉密</char>的女子，</para>
  <para style="q1" vid="SNG 6:13">就像觀看<char style="pn">瑪哈念</char><note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">瑪哈念——或譯作「兩隊軍兵」。</char></note>的舞蹈呢？<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">7:1 </char>
      <char style="ft" closed="false">此章在馬索拉文本為7:2至7:14。</char>
    </note>尊貴的女子啊，</para>
  <para style="q1" vid="SNG 7:1">你的腳在鞋子裡多麼美！</para>
  <para style="q1" vid="SNG 7:1">你的大腿圓潤如珠玉，</para>
  <para style="q1" vid="SNG 7:1">是巧匠的手藝。<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />你的肚臍像一個圓杯，</para>
  <para style="q1" vid="SNG 7:2">從不缺少調和的酒。</para>
  <para style="q1" vid="SNG 7:2">你的腰腹像一堆小麥，</para>
  <para style="q1" vid="SNG 7:2">四周環繞著百合花。<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />你的雙乳像兩隻小鹿，</para>
  <para style="q1" vid="SNG 7:3">像雙生的羚羊。<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />你的頸項如象牙的塔樓，</para>
  <para style="q1" vid="SNG 7:4">你的眼睛像<char style="pn">巴特拉賓</char>城門旁</para>
  <para style="q1" vid="SNG 7:4">
    <char style="pn">希實本</char>的水池。</para>
  <para style="q1" vid="SNG 7:4">你的鼻樑如<char style="pn">黎巴嫩</char>的塔樓，</para>
  <para style="q1" vid="SNG 7:4">俯看著<char style="pn">大馬士革</char>。<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />你的頭高昂如<char style="pn">迦密</char>山，</para>
  <para style="q1" vid="SNG 7:5">你的頭髮像紫色的緞子，</para>
  <para style="q1" vid="SNG 7:5">王被這秀髮纏住了。<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />你多麼美，多麼令人喜悅！</para>
  <para style="q1" vid="SNG 7:6">佳偶啊，你多麼令人陶醉！<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />你這身材好比棕櫚樹，</para>
  <para style="q1" vid="SNG 7:7">你的乳房是飽滿的果實。<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />我說：「我要爬上棕櫚樹，</para>
  <para style="q1" vid="SNG 7:8">我要抓住它的果實！」</para>
  <para style="q1" vid="SNG 7:8">願你的乳房像兩掛葡萄，</para>
  <para style="q1" vid="SNG 7:8">願你鼻孔的香氣如蘋果；<verse eid="SNG 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9" />願你的唇齒像上好的酒——</para>
  <para style="b" vid="SNG 7:9" />
  <para style="sp" vid="SNG 7:9">女子</para>
  <para style="q1" vid="SNG 7:9">緩緩流向我的良人，</para>
  <para style="q1" vid="SNG 7:9">滑入沉醉<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">沉醉——原文直譯「沉睡」。</char></note>的嘴唇！<verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />我屬我的良人，</para>
  <para style="q1" vid="SNG 7:10">他唯獨戀慕我。<verse eid="SNG 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />走吧，我的良人，</para>
  <para style="q1" vid="SNG 7:11">讓我們出去到田間，</para>
  <para style="q1" vid="SNG 7:11">在鳳仙花叢<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">鳳仙花叢——或譯作「鄉村」。</char></note>中留宿。<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />讓我們早早起來去葡萄園，</para>
  <para style="q1" vid="SNG 7:12">看看葡萄樹是否發芽，</para>
  <para style="q1" vid="SNG 7:12">花苞是否綻開，</para>
  <para style="q1" vid="SNG 7:12">石榴樹是否開花，</para>
  <para style="q1" vid="SNG 7:12">我要在那裡將我的愛情獻給你。<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />風茄正散發香氣，</para>
  <para style="q1" vid="SNG 7:13">在我們的門口有各樣新陳的佳果，</para>
  <para style="q1" vid="SNG 7:13">我的良人哪，</para>
  <para style="q1" vid="SNG 7:13">這都是我為你珍藏的。<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />多希望你是我的兄弟，</para>
  <para style="q1" vid="SNG 8:1">我母親的乳汁所餵養的！</para>
  <para style="q1" vid="SNG 8:1">這樣，我在外面遇見你，</para>
  <para style="q1" vid="SNG 8:1">就可以親吻你，</para>
  <para style="q1" vid="SNG 8:1">也沒有人藐視我。<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />我就能引領你，</para>
  <para style="q1" vid="SNG 8:2">進入那教導我的母親的家；</para>
  <para style="q1" vid="SNG 8:2">我要給你喝醇香的酒，</para>
  <para style="q1" vid="SNG 8:2">我釀的石榴甜酒。<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />願他左手托着我的頭，</para>
  <para style="q1" vid="SNG 8:3">右手抱住我。<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />
    <char style="pn">耶路撒冷</char>的女兒們哪，</para>
  <para style="q1" vid="SNG 8:4">我叮囑你們：</para>
  <para style="q1" vid="SNG 8:4">不要催促，不要催發愛情，</para>
  <para style="q1" vid="SNG 8:4">要等它自願發生！<verse eid="SNG 8:4" /></para>
  <para style="b" />
  <para style="sp">耶路撒冷的女子</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />那偎依著良人，</para>
  <para style="q1" vid="SNG 8:5">從曠野上來的是誰呢？</para>
  <para style="b" vid="SNG 8:5" />
  <para style="sp" vid="SNG 8:5">女子</para>
  <para style="q1" vid="SNG 8:5">在蘋果樹下，我喚醒了你；</para>
  <para style="q1" vid="SNG 8:5">在那裡，你的母親懷上你；</para>
  <para style="q1" vid="SNG 8:5">在那裡，她懷上你又生下你。<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />願你把我放在心上如印章，</para>
  <para style="q1" vid="SNG 8:6">戴在手臂上如印戒！</para>
  <para style="q1" vid="SNG 8:6">因為愛情如死亡一樣頑强，</para>
  <para style="q1" vid="SNG 8:6">妒愛像陰間一樣殘忍；</para>
  <para style="q1" vid="SNG 8:6">它的光焰是火的光焰，</para>
  <para style="q1" vid="SNG 8:6">是熾烈的火焰。<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />這愛情，</para>
  <para style="q1" vid="SNG 8:7">大水不能撲滅，</para>
  <para style="q1" vid="SNG 8:7">江河不能沖沒。</para>
  <para style="q1" vid="SNG 8:7">誰若拿全部的家財換這愛情，</para>
  <para style="q1" vid="SNG 8:7">就要被全然藐視。<verse eid="SNG 8:7" /></para>
  <para style="b" />
  <para style="sp">弟兄們</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />我們有一個小妹妹，</para>
  <para style="q1" vid="SNG 8:8">她的乳房還未長成。</para>
  <para style="q1" vid="SNG 8:8">有人給她提親的日子，</para>
  <para style="q1" vid="SNG 8:8">我們該為妹妹怎樣辦理呢？<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />如果她是城牆，</para>
  <para style="q1" vid="SNG 8:9">我們就在她前面修築銀的營寨；</para>
  <para style="q1" vid="SNG 8:9">如果她是城門，</para>
  <para style="q1" vid="SNG 8:9">我們就用香柏木板把她圍起來。<verse eid="SNG 8:9" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />我是城牆，</para>
  <para style="q1" vid="SNG 8:10">我的乳房就像塔樓；</para>
  <para style="q1" vid="SNG 8:10">那時在他眼中，</para>
  <para style="q1" vid="SNG 8:10">我像尋得了平安的人。<verse eid="SNG 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />
    <char style="pn">所羅門</char>在<char style="pn">巴力哈門</char>有一個葡萄園，</para>
  <para style="q1" vid="SNG 8:11">他把這葡萄園交給了看護的人，</para>
  <para style="q1" vid="SNG 8:11">各人要為收獲的果實</para>
  <para style="q1" vid="SNG 8:11">上交一千錠銀子。<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />我自己的葡萄園由我支配，</para>
  <para style="q1" vid="SNG 8:12">
    <char style="pn">所羅門</char>哪，</para>
  <para style="q1" vid="SNG 8:12">一千錠銀子給你，</para>
  <para style="q1" vid="SNG 8:12">兩百錠給看護果實的人。<verse eid="SNG 8:12" /></para>
  <para style="b" />
  <para style="sp">良人</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />在這園中安居的女子啊，</para>
  <para style="q1" vid="SNG 8:13">我的同伴都在聆聽你的聲音。</para>
  <para style="q1" vid="SNG 8:13">請讓我傾聽！<verse eid="SNG 8:13" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />我的良人哪，快來吧，</para>
  <para style="q1" vid="SNG 8:14">好比羚羊或小鹿，</para>
  <para style="q1" vid="SNG 8:14">越過香料山！<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>