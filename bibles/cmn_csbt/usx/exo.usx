<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EXO" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">出埃及記</para>
  <para style="mt">出埃及記</para>
  <chapter number="1" style="c" sid="EXO 1" />
  <para style="s">以色列在埃及受奴役</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1" />
    <char style="pn">以色列</char>的兒子們——各帶家屬與<char style="pn">雅各</char>一同來到<char style="pn">埃及</char>——他們的名字如下：<verse eid="EXO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 1:2" />
    <char style="pn">魯本</char>、<char style="pn">西緬</char>、<char style="pn">利未</char>、<char style="pn">猶大</char>、<verse eid="EXO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 1:3" />
    <char style="pn">以薩迦</char>、<char style="pn">西布倫</char>、<char style="pn">便雅憫</char>、<verse eid="EXO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EXO 1:4" />
    <char style="pn">但</char>、<char style="pn">拿弗他利</char>、<char style="pn">迦得</char>、<char style="pn">亞設</char>。<verse eid="EXO 1:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="EXO 1:5" />
    <char style="pn">雅各</char>所有的直系子孫，共有七十人。那時<char style="pn">約瑟</char>已經在<char style="pn">埃及</char>了。<verse eid="EXO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 1:6" />後來<char style="pn">約瑟</char>和他所有的兄弟，以及那一代所有的人都死了。 <verse eid="EXO 1:6" /><verse number="7" style="v" sid="EXO 1:7" /><char style="pn">以色列</char>子孫生養、繁衍、增多，極其強盛，充滿了那地。<verse eid="EXO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8" />再後來有一位不知道<char style="pn">約瑟</char>的新王興起，統治<char style="pn">埃及</char>。 <verse eid="EXO 1:8" /><verse number="9" style="v" sid="EXO 1:9" />他對自己的子民說：「看哪！<char style="pn">以色列</char>民比我們更多、更強大。 <verse eid="EXO 1:9" /><verse number="10" style="v" sid="EXO 1:10" />來吧！讓我們精明地對付他們，免得他們增多，一旦戰爭發生，他們就會與我們的仇敵聯合，攻打我們，然後離開這地<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">離開這地——原文直譯「從這地上去」。</char></note>。」 <verse eid="EXO 1:10" /><verse number="11" style="v" sid="EXO 1:11" />於是<char style="pn">埃及</char>人指派督工來管理<char style="pn">以色列</char>子孫，用苦役來苦待他們。他們為法老建造了兩座積貨城：<char style="pn">比東</char>和<char style="pn">拉美西斯</char>。 <verse eid="EXO 1:11" /><verse number="12" style="v" sid="EXO 1:12" />然而，<char style="pn">埃及</char>人越是苦待他們，他們越是增多，越是擴散。<char style="pn">埃及</char>人就因<char style="pn">以色列</char>子孫的緣故而憂心。 <verse eid="EXO 1:12" /><verse number="13" style="v" sid="EXO 1:13" />於是<char style="pn">埃及</char>人更嚴酷地奴役<char style="pn">以色列</char>子孫。 <verse eid="EXO 1:13" /><verse number="14" style="v" sid="EXO 1:14" /><char style="pn">埃及</char>人用沉重的勞役——和泥、做磚，以及田野中的各樣勞役——嚴酷地奴役他們的一切勞役，使他們的生活很苦。<verse eid="EXO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15" />當時<char style="pn">埃及</char>王吩咐兩個<char style="pn">希伯來</char>接生婆，一個名叫<char style="pn">施弗拉</char>，另一個名叫<char style="pn">普阿</char>； <verse eid="EXO 1:15" /><verse number="16" style="v" sid="EXO 1:16" />他說：「你們為<char style="pn">希伯來</char>婦女接生，看她們臨盆<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">臨盆——原文直譯「在產床上」。</char></note>的時候，如果所生的<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">所生的——輔助詞語。</char></note>是個男嬰<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">男嬰——原文直譯「兒子」。</char></note>，就把他殺死；如果是個女嬰<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">女嬰——原文直譯「女兒」。</char></note>，就讓她存活。」 <verse eid="EXO 1:16" /><verse number="17" style="v" sid="EXO 1:17" />然而，接生婆敬畏神，沒有照著<char style="pn">埃及</char>王吩咐她們的去做，卻讓男孩也存活。 <verse eid="EXO 1:17" /><verse number="18" style="v" sid="EXO 1:18" /><char style="pn">埃及</char>王就把接生婆叫來，問她們：「你們為什麼做這樣的事，讓男孩也存活呢？」<verse eid="EXO 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 1:19" />接生婆回答法老：「因為<char style="pn">希伯來</char>婦女不像<char style="pn">埃及</char>婦女，<char style="pn">希伯來</char>婦女很健壯，接生婆還沒有到她們那裡之前，她們就已經生產了。」<verse eid="EXO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 1:20" />神善待接生婆，<char style="pn">以色列</char>百姓就增多，而且極其強盛。 <verse eid="EXO 1:20" /><verse number="21" style="v" sid="EXO 1:21" />接生婆因為敬畏神，神就為她們建立了家庭。 <verse eid="EXO 1:21" /><verse number="22" style="v" sid="EXO 1:22" />法老吩咐他所有的子民說：「<char style="pn">希伯來</char>人<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">希伯來人——輔助詞語。</char></note>所生的每一個男嬰<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">男嬰——原文直譯「兒子」。</char></note>，你們都要把他扔進<char style="pn">尼羅</char>河裡；而每一個女嬰<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">女嬰——原文直譯「女兒」。</char></note>，你們可以讓她存活。」<verse eid="EXO 1:22" /></para>
  <chapter eid="EXO 1" />
  <chapter number="2" style="c" sid="EXO 2" />
  <para style="s">摩西出生</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1" />有一個<char style="pn">利未</char>家的男子娶了一個<char style="pn">利未</char>女子為妻。 <verse eid="EXO 2:1" /><verse number="2" style="v" sid="EXO 2:2" />那女人懷孕，生了一個兒子，見他俊美，就把他藏了三個月。 <verse eid="EXO 2:2" /><verse number="3" style="v" sid="EXO 2:3" />後來再也藏不下去了，那女人就為他取來一個蒲草箱，塗上瀝青和柏油，把那孩子放在裡面，然後把箱子放在<char style="pn">尼羅</char>河岸的蘆荻中。 <verse eid="EXO 2:3" /><verse number="4" style="v" sid="EXO 2:4" />那孩子的姐姐遠遠地站著，想知道會有什麼事發生在那孩子身上。<verse eid="EXO 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5" />那時，法老的女兒下到<char style="pn">尼羅</char>河去洗澡；她的使女們正在<char style="pn">尼羅</char>河岸走動。她看見蘆荻中的箱子，就打發她的女僕把箱子取來。 <verse eid="EXO 2:5" /><verse number="6" style="v" sid="EXO 2:6" />她打開箱子，看見了一個孩子。看哪，那男孩正在哭！她就可憐那男孩，說：「這是個<char style="pn">希伯來</char>人的孩子！」<verse eid="EXO 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7" />那孩子的姐姐對法老的女兒說：「我去為你從<char style="pn">希伯來</char>婦女中叫來一個乳母，讓她替你乳養這孩子，好嗎？」<verse eid="EXO 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 2:8" />法老的女兒對她說：「去吧！」那童女就去，叫來那孩子的母親。 <verse eid="EXO 2:8" /><verse number="9" style="v" sid="EXO 2:9" />法老的女兒對那女人說：「你把這孩子帶去，替我乳養他，我必給你酬報。」那女人就把孩子抱過來，乳養他。 <verse eid="EXO 2:9" /><verse number="10" style="v" sid="EXO 2:10" />孩子長大了，那女人把他帶到法老的女兒那裡，他就作了法老女兒的兒子。法老的女兒給他起名為<char style="pn">摩西</char>，說：「因為我把他從水裡拉上來。」<verse eid="EXO 2:10" /></para>
  <para style="s">摩西在米甸</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11" />過了好些日子，<char style="pn">摩西</char>長大了。有一天，他出去到他的同胞那裡，看見他們的苦役。他看見一個<char style="pn">埃及</char>人正在打他的一個<char style="pn">希伯來</char>同胞。 <verse eid="EXO 2:11" /><verse number="12" style="v" sid="EXO 2:12" /><char style="pn">摩西</char>左顧右看，確認沒有人，就打死了那個<char style="pn">埃及</char>人，把他埋在沙土裡。 <verse eid="EXO 2:12" /><verse number="13" style="v" sid="EXO 2:13" />第二天他又出去，看哪，有兩個<char style="pn">希伯來</char>人在打架！他就對那有錯的人說：「你為什麼打你的鄰人呢？」<verse eid="EXO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 2:14" />那人說：「誰立你作首領和審判官來管我們呢？難道你想殺我，像你殺那個<char style="pn">埃及</char>人一樣嗎？」</para>
  <para style="p" vid="EXO 2:14">
    <char style="pn">摩西</char>就害怕，心想：「這事必定被人知道了。」 <verse eid="EXO 2:14" /><verse number="15" style="v" sid="EXO 2:15" />法老聽到這事，就設法要殺<char style="pn">摩西</char>。於是<char style="pn">摩西</char>從法老面前逃走，到<char style="pn">米甸</char>地居住。有一天，他坐在一口水井旁。<verse eid="EXO 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 2:16" />
    <char style="pn">米甸</char>的祭司有七個女兒；她們這天<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">這天——輔助詞語。</char></note>來打水，灌滿水槽，要給她們父親的羊群飲水。 <verse eid="EXO 2:16" /><verse number="17" style="v" sid="EXO 2:17" />有些牧人來驅趕她們，但<char style="pn">摩西</char>起來救助了她們，給她們的羊群飲水。 <verse eid="EXO 2:17" /><verse number="18" style="v" sid="EXO 2:18" />她們回到父親<char style="pn">流珥</char>那裡，父親就問：「今天你們為什麼這麼快就回來了呢？」<verse eid="EXO 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 2:19" />她們回答：「有一個<char style="pn">埃及</char>人救我們脫離那些牧人的手，甚至還為我們打水，又給羊群飲水。」<verse eid="EXO 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 2:20" />他問女兒們：「那人在哪裡？你們為什麼就這樣撇下他呢？你們去請他來吃飯吧！」<verse eid="EXO 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 2:21" />
    <char style="pn">摩西</char>願意與那人住在一起，那人就把自己的女兒<char style="pn">西坡拉</char>嫁給<char style="pn">摩西</char>。 <verse eid="EXO 2:21" /><verse number="22" style="v" sid="EXO 2:22" /><char style="pn">西坡拉</char>生了一個兒子，<char style="pn">摩西</char>給他起名為<char style="pn">革順</char>，因為他說：「我在外邦之地作了寄居者。」<verse eid="EXO 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23" />過了許多日子，<char style="pn">埃及</char>王死了。<char style="pn">以色列</char>子孫因所服的勞役而嘆息、哀求；他們因所服的勞役而發出的呼求上達於神。 <verse eid="EXO 2:23" /><verse number="24" style="v" sid="EXO 2:24" />神垂聽他們的哀聲；神記念他與<char style="pn">亞伯拉罕</char>、<char style="pn">以撒</char>、<char style="pn">雅各</char>所立的約； <verse eid="EXO 2:24" /><verse number="25" style="v" sid="EXO 2:25" />神垂顧<char style="pn">以色列</char>子孫；神顧念<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="ft" closed="false">顧念——原文直譯「知道」。</char></note>他們。<verse eid="EXO 2:25" /></para>
  <chapter eid="EXO 2" />
  <chapter number="3" style="c" sid="EXO 3" />
  <para style="s">摩西與燃燒的荊棘叢</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1" />有一天，<char style="pn">摩西</char>正在牧放他岳父<char style="pn">米甸</char>祭司<char style="pn">耶特羅</char>的羊群；他把羊群引領到曠野的深處，來到神的山，就是<char style="pn">何烈</char>山。 <verse eid="EXO 3:1" /><verse number="2" style="v" sid="EXO 3:2" />這時耶和華的使者在荊棘叢的火焰中向他顯現。<char style="pn">摩西</char>觀看，看哪，荊棘叢在火中燃燒，但荊棘叢卻沒有被吞噬！ <verse eid="EXO 3:2" /><verse number="3" style="v" sid="EXO 3:3" /><char style="pn">摩西</char>就說：「我要轉過去觀看這個大異象，那荊棘叢為什麼沒有被燒毀！」<verse eid="EXO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4" />當耶和華看見<char style="pn">摩西</char>要轉過去觀看，神就在荊棘叢中向他呼喚，說：「<char style="pn">摩西</char>，<char style="pn">摩西</char>！」</para>
  <para style="p" vid="EXO 3:4">他說：「我在這裡！」<verse eid="EXO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 3:5" />神說：「不要靠近這裡，脫下你腳上的鞋子，因為你所站的地方是聖地。」 <verse eid="EXO 3:5" /><verse number="6" style="v" sid="EXO 3:6" />神又說：「我是你先祖的神——<char style="pn">亞伯拉罕</char>的神、<char style="pn">以撒</char>的神、<char style="pn">雅各</char>的神。」<char style="pn">摩西</char>就遮掩自己的臉，因為他害怕看見神。<verse eid="EXO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7" />耶和華說：「我確實看見了我子民在<char style="pn">埃及</char>的苦難，也聽見了他們因監工的壓迫而發出的哀聲；我確實知道他們的痛苦。 <verse eid="EXO 3:7" /><verse number="8" style="v" sid="EXO 3:8" />所以我下來是要解救他們脫離<char style="pn">埃及</char>人的手，並把他們從那地帶上來，帶到那美好寬廣之地——流奶與蜜之地，就是<char style="pn">迦南</char>人、<char style="pn">赫提</char>人、<char style="pn">亞摩利</char>人、<char style="pn">比利洗</char>人、<char style="pn">希未</char>人、<char style="pn">耶布斯</char>人的地方。 <verse eid="EXO 3:8" /><verse number="9" style="v" sid="EXO 3:9" />現在看哪，<char style="pn">以色列</char>子孫的哀聲已經達到我這裡，我也看見了<char style="pn">埃及</char>人怎樣壓迫他們！ <verse eid="EXO 3:9" /><verse number="10" style="v" sid="EXO 3:10" />現在你去，我要派遣你到法老那裡，把我的子民<char style="pn">以色列</char>子孫從<char style="pn">埃及</char>領出來！」<verse eid="EXO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11" />
    <char style="pn">摩西</char>對神說：「我是誰，竟能到法老那裡去？竟能把<char style="pn">以色列</char>子孫從<char style="pn">埃及</char>領出來？」<verse eid="EXO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 3:12" />神說：「我必定與你同在。你把子民從<char style="pn">埃及</char>領出來之後，你們必在這山上服事神——這就是給你的標記，表明<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">表明——輔助詞語。</char></note>是我派遣了你。」<verse eid="EXO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13" />
    <char style="pn">摩西</char>對神說：「看哪！我到<char style="pn">以色列</char>子孫那裡去，對他們說『你們先祖的神派遣我到你們這裡』，他們如果問我『他的名字是什麼』，那麼我要對他們說什麼呢？」<verse eid="EXO 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 3:14" />神對<char style="pn">摩西</char>說：「我是『我所是』的那一位。」神接著說：「你要對<char style="pn">以色列</char>子孫如此說：『我所是』的那一位派遣我到你們這裡。」 <verse eid="EXO 3:14" /><verse number="15" style="v" sid="EXO 3:15" />神又對<char style="pn">摩西</char>說：「你要對<char style="pn">以色列</char>子孫如此說：『耶和華你們先祖的神——<char style="pn">亞伯拉罕</char>的神、<char style="pn">以撒</char>的神、<char style="pn">雅各</char>的神，派遣我到你們這裡。』這是我的名字，直到永遠；這也是我的名號，直到萬代。<verse eid="EXO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 3:16" />「你去招聚<char style="pn">以色列</char>的長老們，對他們說：『耶和華你們先祖的神——<char style="pn">亞伯拉罕</char>、<char style="pn">以撒</char>、<char style="pn">雅各</char>的神，向我顯現，說：「我確實眷顧了你們，也看見了你們在<char style="pn">埃及</char>所受的對待； <verse eid="EXO 3:16" /><verse number="17" style="v" sid="EXO 3:17" />我就說：我要把你們帶上來，脫離<char style="pn">埃及</char>的苦難，到<char style="pn">迦南</char>人、<char style="pn">赫提</char>人、<char style="pn">亞摩利</char>人、<char style="pn">比利洗</char>人、<char style="pn">希未</char>人、<char style="pn">耶布斯</char>人之地，就是那流奶與蜜之地。」』 <verse eid="EXO 3:17" /><verse number="18" style="v" sid="EXO 3:18" /><char style="pn">以色列</char>的長老們必聽從你的話。然後，你和他們要到<char style="pn">埃及</char>王那裡去，對他說：『<char style="pn">希伯來</char>人的神耶和華向我們顯現了<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">向我們顯現了——原文直譯「與我們相見了」。</char></note>。現在，請讓我們在曠野中走三天的路程，好使我們向我們的神耶和華獻祭。』 <verse eid="EXO 3:18" /><verse number="19" style="v" sid="EXO 3:19" />不過我知道，如果不用大能的手，<char style="pn">埃及</char>王是不會允許你們走的。 <verse eid="EXO 3:19" /><verse number="20" style="v" sid="EXO 3:20" />所以我要伸手，在<char style="pn">埃及</char>當中行我一切的奇妙作為，以此打擊<char style="pn">埃及</char>；然後他才會讓你們走。 <verse eid="EXO 3:20" /><verse number="21" style="v" sid="EXO 3:21" />我要使這子民在<char style="pn">埃及</char>人眼前蒙恩，這樣你們走的時候就不會空手而去。 <verse eid="EXO 3:21" /><verse number="22" style="v" sid="EXO 3:22" />每個女人都要向她的鄰居，向寄居在她家裡的女人索要銀器、金器和衣服，並穿戴在你們的兒女身上；這樣你們就剝奪了<char style="pn">埃及</char>人。」<verse eid="EXO 3:22" /></para>
  <chapter eid="EXO 3" />
  <chapter number="4" style="c" sid="EXO 4" />
  <para style="s">給摩西的神蹟</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1" />
    <char style="pn">摩西</char>回應說：「看哪！他們不會相信我，也不會聽從我的話，因為他們會說：『耶和華沒有向你顯現。』」<verse eid="EXO 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 4:2" />耶和華問<char style="pn">摩西</char>：「你手中的是什麼呢？」</para>
  <para style="p" vid="EXO 4:2">他回答：「是一根杖。」<verse eid="EXO 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 4:3" />耶和華說：「把杖扔在地上！」<char style="pn">摩西</char>把它扔在地上，它就變成了一條蛇；<char style="pn">摩西</char>急忙<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">急忙——輔助詞語。</char></note>逃避那條蛇。 <verse eid="EXO 4:3" /><verse number="4" style="v" sid="EXO 4:4" />耶和華接著對<char style="pn">摩西</char>說：「伸出你的手來，抓住蛇的尾巴！」<char style="pn">摩西</char>伸出手，拿住牠，牠就在<char style="pn">摩西</char>的手掌中變回了杖。 <verse eid="EXO 4:4" /><verse number="5" style="v" sid="EXO 4:5" />耶和華說：<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">耶和華說：——輔助詞語。</char></note>「這是為了使他們相信：耶和華他們先祖的神——<char style="pn">亞伯拉罕</char>的神、<char style="pn">以撒</char>的神、<char style="pn">雅各</char>的神，向你顯現了。」<verse eid="EXO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6" />耶和華又對<char style="pn">摩西</char>說：「現在，把你的手放進懷裡！」他就把手放進懷裡。當他拿出手來，看哪，他的手長了痲瘋，像雪那樣白！ <verse eid="EXO 4:6" /><verse number="7" style="v" sid="EXO 4:7" />耶和華接著說：「把你的手放回懷裡！」他就把手放回懷裡。當他從懷裡拿出手來，看哪，他的手復原了，像他身上別處<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">別處——輔助詞語。</char></note>的皮肉那樣！ <verse eid="EXO 4:7" /><verse number="8" style="v" sid="EXO 4:8" />耶和華說：<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">耶和華說：——輔助詞語。</char></note>「如果他們不相信你，也不聽從第一個神蹟所表明的<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">神蹟所表明的——原文直譯「神蹟的聲音」。</char></note>，那麼他們必相信後一個神蹟所表明的<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">神蹟所表明的——原文直譯「神蹟的聲音」。</char></note>。 <verse eid="EXO 4:8" /><verse number="9" style="v" sid="EXO 4:9" />如果他們連這兩個神蹟都不相信，也不聽從你的話語，你就從<char style="pn">尼羅</char>河取一些水，倒在乾地上，你從<char style="pn">尼羅</char>河取來的水必在乾地上變成血。」<verse eid="EXO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10" />
    <char style="pn">摩西</char>對耶和華說：「哦，主啊，我不是個能說會道的人——以前不是<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">以前不是——原文直譯「昨天不是，前天也不是」。</char></note>，從你對僕人說話以後也不是——我是個笨口拙舌的人！」<verse eid="EXO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 4:11" />耶和華對他說：「是誰造人的口呢？又是誰使人口啞、耳聾、目明、眼瞎呢？難道不是我耶和華嗎？ <verse eid="EXO 4:11" /><verse number="12" style="v" sid="EXO 4:12" />現在你去，我必親自與你的口同在，並指示你當說的話！」<verse eid="EXO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 4:13" />
    <char style="pn">摩西</char>說：「哦，主啊，你要派遣誰經手，就派遣誰吧！」<verse eid="EXO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 4:14" />於是耶和華的怒氣向<char style="pn">摩西</char>發作，他說：「不是有你的哥哥<char style="pn">利未</char>人<char style="pn">亞倫</char>嗎？我知道他能言善道。看哪，他正出來迎接你！他一看見你，心裡就會歡喜。 <verse eid="EXO 4:14" /><verse number="15" style="v" sid="EXO 4:15" />你要向他說話，把當說的話放在他的口中；我必親自與你的口同在，也必與他的口同在，並指示你們當做的事； <verse eid="EXO 4:15" /><verse number="16" style="v" sid="EXO 4:16" />他要替你向子民說話，他對你就像是你的口，而你對他就像是神一樣。 <verse eid="EXO 4:16" /><verse number="17" style="v" sid="EXO 4:17" />你要把這根杖拿在你手中，用它來施行神蹟。」<verse eid="EXO 4:17" /></para>
  <para style="s">摩西回埃及</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18" />於是<char style="pn">摩西</char>就離開，回到他的岳父<char style="pn">耶特羅</char>那裡，對他說：「請讓我走，讓我回到我在<char style="pn">埃及</char>的同胞那裡，看看他們是否還活著。」</para>
  <para style="p" vid="EXO 4:18">
    <char style="pn">耶特羅</char>對<char style="pn">摩西</char>說：「你平平安安地去吧！」<verse eid="EXO 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 4:19" />耶和華在<char style="pn">米甸</char>對<char style="pn">摩西</char>說：「回<char style="pn">埃及</char>去！因為那些尋索你性命的人都死了。」 <verse eid="EXO 4:19" /><verse number="20" style="v" sid="EXO 4:20" /><char style="pn">摩西</char>就帶著他的妻子和兒子們，騎上驢，回<char style="pn">埃及</char>地去。<char style="pn">摩西</char>手中拿著神的杖。<verse eid="EXO 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21" />耶和華對<char style="pn">摩西</char>說：「你回到<char style="pn">埃及</char>的時候，要留意我交在你手中的一切奇事，把它們施行在法老面前；但是我要使他的心剛硬，他就不會讓我的子民走。 <verse eid="EXO 4:21" /><verse number="22" style="v" sid="EXO 4:22" />那時，你要對法老說：『耶和華如此說：<char style="pn">以色列</char>是我的兒子、我的長子。 <verse eid="EXO 4:22" /><verse number="23" style="v" sid="EXO 4:23" />我對你說過：讓我的兒子走，好使他服事我；你卻拒絕讓他走。看哪，我必殺你的兒子、你的長子！』」<verse eid="EXO 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24" />在路上一處住宿的地方，耶和華遇見<char style="pn">摩西</char>，想要殺死他。 <verse eid="EXO 4:24" /><verse number="25" style="v" sid="EXO 4:25" /><char style="pn">西坡拉</char>就拿一把石刀，割下她兒子的包皮，碰了<char style="pn">摩西</char>的腳，說：「你實在是我的血郎。」 <verse eid="EXO 4:25" /><verse number="26" style="v" sid="EXO 4:26" />這樣，耶和華就放了他。當時<char style="pn">西坡拉</char>說「血郎」，是因割禮的緣故。<verse eid="EXO 4:26" /></para>
  <para style="s">摩西與亞倫重逢</para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27" />耶和華對<char style="pn">亞倫</char>說：「你到曠野去迎接<char style="pn">摩西</char>。」他就去了，在神的山遇見<char style="pn">摩西</char>，並親吻他。 <verse eid="EXO 4:27" /><verse number="28" style="v" sid="EXO 4:28" /><char style="pn">摩西</char>把耶和華派遣他時所說的一切話以及吩咐他的一切神蹟都告訴了<char style="pn">亞倫</char>。 <verse eid="EXO 4:28" /><verse number="29" style="v" sid="EXO 4:29" /><char style="pn">摩西</char>和<char style="pn">亞倫</char>就去招聚<char style="pn">以色列</char>子孫所有的長老。 <verse eid="EXO 4:29" /><verse number="30" style="v" sid="EXO 4:30" /><char style="pn">亞倫</char>複述了耶和華對<char style="pn">摩西</char>所說的一切話，又在<char style="pn">以色列</char>百姓眼前施行了那些神蹟。 <verse eid="EXO 4:30" /><verse number="31" style="v" sid="EXO 4:31" />於是百姓就相信了。他們聽見耶和華眷顧了<char style="pn">以色列</char>子孫、垂顧了他們的苦難，就俯身下拜。<verse eid="EXO 4:31" /></para>
  <chapter eid="EXO 4" />
  <chapter number="5" style="c" sid="EXO 5" />
  <para style="s">摩西和亞倫首次見法老</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1" />此後，<char style="pn">摩西</char>和<char style="pn">亞倫</char>來對法老說：「<char style="pn">以色列</char>的神耶和華如此說：『讓我的子民走，好使他們在曠野向我守節期。』」<verse eid="EXO 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 5:2" />法老說：「耶和華是誰，要我聽從他的話，讓<char style="pn">以色列</char>人走呢？我不認識耶和華，也不讓<char style="pn">以色列</char>人走！」<verse eid="EXO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 5:3" />他們就說：「<char style="pn">希伯來</char>人的神向我們顯現了<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">向我們顯現了——原文直譯「與我們相見了」。</char></note>。請讓我們在曠野中走三天的路程，好使我們向我們的神耶和華獻祭，免得他用瘟疫或刀劍擊殺我們。」<verse eid="EXO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 5:4" />
    <char style="pn">埃及</char>王對他們說：「<char style="pn">摩西</char>、<char style="pn">亞倫</char>哪，你們為什麼要使<char style="pn">以色列</char>人放下他們的工作呢？你們回到苦役中去！」 <verse eid="EXO 5:4" /><verse number="5" style="v" sid="EXO 5:5" />法老接著說：「看哪，現在這地的<char style="pn">以色列</char>人如此眾多，你們竟然要讓他們停下苦役！」<verse eid="EXO 5:5" /></para>
  <para style="s">加重以色列人的勞役</para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 5:6" />那一天，法老吩咐那些管理<char style="pn">以色列</char>百姓的監工和工頭，說： <verse eid="EXO 5:6" /><verse number="7" style="v" sid="EXO 5:7" />「你們不要再像往日那樣提供乾草給<char style="pn">以色列</char>人做磚，要讓他們自己去撿拾乾草； <verse eid="EXO 5:7" /><verse number="8" style="v" sid="EXO 5:8" />至於他們往日做磚的數量，你們仍然要向他們索取，不可減少。因為他們懶惰，所以他們才呼求說『讓我們走，好使我們向我們的神獻祭。』 <verse eid="EXO 5:8" /><verse number="9" style="v" sid="EXO 5:9" />你們要加重這些人的勞役，使他們忙於做工，而不去關注虛假的話語。」<verse eid="EXO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10" />於是那些管理<char style="pn">以色列</char>百姓的監工和工頭就出來告訴<char style="pn">以色列</char>百姓說：「法老如此說：『我不再提供乾草給你們！ <verse eid="EXO 5:10" /><verse number="11" style="v" sid="EXO 5:11" />你們去，自己在哪裡找到乾草就在哪裡拾取，但是你們的勞役一點也不可減少！』」 <verse eid="EXO 5:11" /><verse number="12" style="v" sid="EXO 5:12" />於是<char style="pn">以色列</char>百姓就分散在<char style="pn">埃及</char>全地，撿拾麥稭當作乾草。 <verse eid="EXO 5:12" /><verse number="13" style="v" sid="EXO 5:13" />監工們催逼他們說：「你們要完成每天的工作份額，就像往日有乾草時那樣！」 <verse eid="EXO 5:13" /><verse number="14" style="v" sid="EXO 5:14" />法老的監工們所指派的<char style="pn">以色列</char>子孫的工頭們受了責打和責問：「你們為什麼昨天和今天都沒有像往日那樣完成你們做磚的份額呢？」<verse eid="EXO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15" />
    <char style="pn">以色列</char>子孫的工頭們就來向法老呼求說：「你為什麼這樣對待你的僕人們呢？ <verse eid="EXO 5:15" /><verse number="16" style="v" sid="EXO 5:16" />不再給你的僕人們乾草，但卻對我們說：『做磚吧！』看哪，你的僕人們受責打，其實是你子民的錯！」<verse eid="EXO 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 5:17" />法老說：「你們是懶惰人，真懶惰！所以你們才說：『讓我們走，好使我們向耶和華獻祭。』 <verse eid="EXO 5:17" /><verse number="18" style="v" sid="EXO 5:18" />現在，服你們的勞役去！不再提供乾草給你們，但你們要如數交出磚！」<verse eid="EXO 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 5:19" />
    <char style="pn">以色列</char>子孫的工頭們因為被吩咐「不可減少每天做磚的份額」，就知道自己有禍了。 <verse eid="EXO 5:19" /><verse number="20" style="v" sid="EXO 5:20" />他們從法老那裡出來的時候，遇上了正站著迎候他們的<char style="pn">摩西</char>和<char style="pn">亞倫</char>。<verse eid="EXO 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 5:21" />他們就對<char style="pn">摩西</char>和<char style="pn">亞倫</char>說：「願耶和華察看你們，施行審判！因為你們使我們在法老眼前和他的臣僕眼前有了臭名<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">有了臭名——原文直譯「發出臭氣了」。</char></note>，把刀放在他們的手中來殺我們。」<verse eid="EXO 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22" />
    <char style="pn">摩西</char>回到耶和華那裡，說：「主啊，你為什麼使這百姓受到惡待呢？你究竟為什麼派遣我呢？ <verse eid="EXO 5:22" /><verse number="23" style="v" sid="EXO 5:23" />自從我到法老那裡，奉你的名說話，他就惡待這百姓，而你一點都沒有解救你的子民。」<verse eid="EXO 5:23" /></para>
  <chapter eid="EXO 5" />
  <chapter number="6" style="c" sid="EXO 6" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1" />耶和華對<char style="pn">摩西</char>說：「現在你必看到我要對法老做的事；他必因我大能的手讓子民走，他必因我大能的手從自己的地驅逐他們。」<verse eid="EXO 6:1" /></para>
  <para style="s">神應許解救以色列</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2" />神指示<char style="pn">摩西</char>說：「我是耶和華。 <verse eid="EXO 6:2" /><verse number="3" style="v" sid="EXO 6:3" />我曾經以『全能的神』向<char style="pn">亞伯拉罕</char>、<char style="pn">以撒</char>、<char style="pn">雅各</char>顯現；至於我的名字『耶和華』，我未曾讓他們知道。 <verse eid="EXO 6:3" /><verse number="4" style="v" sid="EXO 6:4" />我又與他們確立了我的約，要賜給他們<char style="pn">迦南</char>地，就是他們曾寄居在其中的寄居之地。 <verse eid="EXO 6:4" /><verse number="5" style="v" sid="EXO 6:5" />現在，我聽見了<char style="pn">以色列</char>子孫因<char style="pn">埃及</char>人奴役他們而發出的哀聲，我就記念我的約。<verse eid="EXO 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 6:6" />「因此你當對<char style="pn">以色列</char>子孫說：『我是耶和華。我要把你們從<char style="pn">埃及</char>的苦役中領出來，我要解救你們脫離<char style="pn">埃及</char>的奴役，我要用伸出的膀臂和極大的審判來贖回你們； <verse eid="EXO 6:6" /><verse number="7" style="v" sid="EXO 6:7" />我要揀選你們作我的子民，我也要作你們的神。這樣你們就知道：我是耶和華你們的神，是把你們從<char style="pn">埃及</char>的苦役中領出來的那一位。 <verse eid="EXO 6:7" /><verse number="8" style="v" sid="EXO 6:8" />我要領你們進入我舉手起誓要賜給<char style="pn">亞伯拉罕</char>、<char style="pn">以撒</char>、<char style="pn">雅各</char>的那地，我要把那地賜給你們作產業。我是耶和華。』」 <verse eid="EXO 6:8" /><verse number="9" style="v" sid="EXO 6:9" /><char style="pn">摩西</char>就把這話告訴了<char style="pn">以色列</char>子孫，但他們因靈裡的沮喪和沉重的勞役，沒有聽從<char style="pn">摩西</char>。<verse eid="EXO 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 6:10" />於是耶和華指示<char style="pn">摩西</char>說： <verse eid="EXO 6:10" /><verse number="11" style="v" sid="EXO 6:11" />「你去，對<char style="pn">埃及</char>王法老說，讓<char style="pn">以色列</char>子孫走，離開法老的地。」<verse eid="EXO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 6:12" />
    <char style="pn">摩西</char>在耶和華面前說：「看哪，<char style="pn">以色列</char>子孫尚且不聽從我，法老又怎麼會聽從我呢？因為我是個口脣笨拙<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">口唇笨拙——原文直譯「嘴唇沒有受割禮」。</char></note>的人。」 <verse eid="EXO 6:12" /><verse number="13" style="v" sid="EXO 6:13" />耶和華對<char style="pn">摩西</char>和<char style="pn">亞倫</char>說話，吩咐了他們有關<char style="pn">以色列</char>子孫和<char style="pn">埃及</char>王法老的事，要他們把<char style="pn">以色列</char>子孫從<char style="pn">埃及</char>地領出來。<verse eid="EXO 6:13" /></para>
  <para style="s">摩西和亞倫的譜系</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 6:14" />以下是他們父家的首領：</para>
  <para style="q1" vid="EXO 6:14">
    <char style="pn">以色列</char>長子<char style="pn">魯本</char>的兒子是<char style="pn">哈諾</char>、<char style="pn">法路</char>、<char style="pn">希斯倫</char>和<char style="pn">迦米</char>。</para>
  <para style="q1" vid="EXO 6:14">這是<char style="pn">魯本</char>的家族。<verse eid="EXO 6:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="EXO 6:15" />
    <char style="pn">西緬</char>的兒子是<char style="pn">耶姆利</char>、<char style="pn">雅憫</char>、<char style="pn">阿轄</char>、<char style="pn">雅斤</char>、<char style="pn">瑣哈爾</char>，以及<char style="pn">掃羅</char>——<char style="pn">迦南</char>女子的兒子。</para>
  <para style="q1" vid="EXO 6:15">這是<char style="pn">西緬</char>的家族。<verse eid="EXO 6:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="EXO 6:16" />
    <char style="pn">利未</char>的兒子，按著他們的家系，名字如下：<char style="pn">革順</char>、<char style="pn">哥轄</char>、<char style="pn">米拉利</char>；</para>
  <para style="q1" vid="EXO 6:16">
    <char style="pn">利未</char>一生的年歲是一百三十七歲。<verse eid="EXO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EXO 6:17" />
    <char style="pn">革順</char>的兒子，按著他們的家族，名字如下<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">名字如下——輔助詞語。</char></note>：<char style="pn">立尼</char>、<char style="pn">示每</char>。<verse eid="EXO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 6:18" />
    <char style="pn">哥轄</char>的兒子是<char style="pn">阿姆蘭</char>、<char style="pn">以斯哈</char>、<char style="pn">希伯倫</char>和<char style="pn">烏基業</char>；</para>
  <para style="q1" vid="EXO 6:18">
    <char style="pn">哥轄</char>一生的年歲是一百三十三歲。<verse eid="EXO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="EXO 6:19" />
    <char style="pn">米拉利</char>的兒子是<char style="pn">瑪赫利</char>和<char style="pn">穆希</char>。</para>
  <para style="q1" vid="EXO 6:19">這是<char style="pn">利未</char>的家族，都按著他們的家系。<verse eid="EXO 6:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="EXO 6:20" />
    <char style="pn">阿姆蘭</char>娶了他父親的妹妹<char style="pn">約基別</char>為妻，</para>
  <para style="q1" vid="EXO 6:20">
    <char style="pn">約基別</char>為他生了<char style="pn">亞倫</char>和<char style="pn">摩西</char>；</para>
  <para style="q1" vid="EXO 6:20">
    <char style="pn">阿姆蘭</char>一生的年歲是一百三十七歲。<verse eid="EXO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="EXO 6:21" />
    <char style="pn">以斯哈</char>的兒子是<char style="pn">可拉</char>、<char style="pn">尼斐</char>和<char style="pn">澤克利</char>。<verse eid="EXO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="EXO 6:22" />
    <char style="pn">烏基業</char>的兒子是<char style="pn">米沙利</char>、<char style="pn">以利撒番</char>和<char style="pn">西提利</char>。<verse eid="EXO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="EXO 6:23" />
    <char style="pn">亞倫</char>娶了<char style="pn">亞米拿達</char>的女兒、<char style="pn">拿順</char>的妹妹<char style="pn">以利沙巴</char>為妻，</para>
  <para style="q1" vid="EXO 6:23">
    <char style="pn">以利沙巴</char>為他生了<char style="pn">納達布</char>、<char style="pn">亞比戶</char>、<char style="pn">以利亞撒</char>和<char style="pn">以塔瑪爾</char>。<verse eid="EXO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="EXO 6:24" />
    <char style="pn">可拉</char>的兒子是<char style="pn">亞惜</char>、<char style="pn">以利加拿</char>和<char style="pn">亞比亞撒</char>。</para>
  <para style="q1" vid="EXO 6:24">這是<char style="pn">可拉</char>的家族。<verse eid="EXO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="EXO 6:25" />
    <char style="pn">亞倫</char>的兒子<char style="pn">以利亞撒</char>娶了<char style="pn">普提業</char>的一個女兒為妻，</para>
  <para style="q1" vid="EXO 6:25">他的妻子為他生了<char style="pn">非尼哈</char>。</para>
  <para style="q1" vid="EXO 6:25">以上是<char style="pn">利未</char>人父系的首領，都按著他們的家族。<verse eid="EXO 6:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26" />正是這<char style="pn">亞倫</char>和<char style="pn">摩西</char>，耶和華曾對他們說：「你們要把<char style="pn">以色列</char>子孫從<char style="pn">埃及</char>地一隊一隊領出來！」 <verse eid="EXO 6:26" /><verse number="27" style="v" sid="EXO 6:27" />而對<char style="pn">埃及</char>王法老說話，要把<char style="pn">以色列</char>子孫從<char style="pn">埃及</char>領出來的，也正是這<char style="pn">摩西</char>和<char style="pn">亞倫</char>。<verse eid="EXO 6:27" /></para>
  <para style="s">摩西和亞倫再次受命</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28" />當耶和華在<char style="pn">埃及</char>地對<char style="pn">摩西</char>說話的日子， <verse eid="EXO 6:28" /><verse number="29" style="v" sid="EXO 6:29" />耶和華指示<char style="pn">摩西</char>說：「我是耶和華。我對你所說的一切，你都要告訴<char style="pn">埃及</char>王法老。」<verse eid="EXO 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 6:30" />
    <char style="pn">摩西</char>卻在耶和華面前說：「看哪，我是個口脣笨拙<note caller="+" style="f"><char style="fr" closed="false">6:30 </char><char style="ft" closed="false">口唇笨拙——原文直譯「嘴唇沒有受割禮」。</char></note>的人，法老怎麼會聽從我呢？」<verse eid="EXO 6:30" /></para>
  <chapter eid="EXO 6" />
  <chapter number="7" style="c" sid="EXO 7" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1" />耶和華對<char style="pn">摩西</char>說：「你看，我使你在法老面前像神一樣，而你哥哥<char style="pn">亞倫</char>是你的先知。 <verse eid="EXO 7:1" /><verse number="2" style="v" sid="EXO 7:2" />我所吩咐你的一切，你都要說；然後你哥哥<char style="pn">亞倫</char>要對法老說，讓<char style="pn">以色列</char>子孫走，離開法老的地。 <verse eid="EXO 7:2" /><verse number="3" style="v" sid="EXO 7:3" />然而，我要使法老硬著心，也要在<char style="pn">埃及</char>地使我的神蹟和奇事增多。 <verse eid="EXO 7:3" /><verse number="4" style="v" sid="EXO 7:4" />法老不會聽從你們；我要向<char style="pn">埃及</char>下手，用極大的審判把我的大軍——我的子民<char style="pn">以色列</char>子孫，從<char style="pn">埃及</char>地領出來。 <verse eid="EXO 7:4" /><verse number="5" style="v" sid="EXO 7:5" />當我伸出手攻擊<char style="pn">埃及</char>，把<char style="pn">以色列</char>子孫從<char style="pn">埃及</char>人中間領出來的時候，<char style="pn">埃及</char>人就知道我是耶和華。」<verse eid="EXO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 7:6" />
    <char style="pn">摩西</char>和<char style="pn">亞倫</char>就這樣做了；耶和華所指示他們的，他們都照著做了。 <verse eid="EXO 7:6" /><verse number="7" style="v" sid="EXO 7:7" />他們對法老說話的時候，<char style="pn">摩西</char>八十歲，<char style="pn">亞倫</char>八十三歲。<verse eid="EXO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8" />耶和華對<char style="pn">摩西</char>和<char style="pn">亞倫</char>說： <verse eid="EXO 7:8" /><verse number="9" style="v" sid="EXO 7:9" />「當法老吩咐你們說『你們行一件奇事吧』，你就對<char style="pn">亞倫</char>說：『拿你的杖，扔在法老面前，杖就會變成一條大蛇。』」 <verse eid="EXO 7:9" /><verse number="10" style="v" sid="EXO 7:10" /><char style="pn">摩西</char>和<char style="pn">亞倫</char>就到法老那裡去，照著耶和華所指示的做了。<char style="pn">亞倫</char>把他的杖扔在法老和他的臣僕面前，杖就變成了一條大蛇。 <verse eid="EXO 7:10" /><verse number="11" style="v" sid="EXO 7:11" />於是法老召來智慧人和行巫術的。這些<char style="pn">埃及</char>的術士們也用他們的邪術照樣做。 <verse eid="EXO 7:11" /><verse number="12" style="v" sid="EXO 7:12" />他們各人扔下自己的杖，他們的杖也都變成了大蛇；但<char style="pn">亞倫</char>的杖吞掉了他們的杖。 <verse eid="EXO 7:12" /><verse number="13" style="v" sid="EXO 7:13" />然而，法老的心剛硬，不聽從<char style="pn">摩西</char>和<char style="pn">亞倫</char>，正如耶和華所說的。<verse eid="EXO 7:13" /></para>
  <para style="s">第一災：血災</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14" />耶和華對<char style="pn">摩西</char>說：「法老心裡頑固，拒絕讓我的子民走。 <verse eid="EXO 7:14" /><verse number="15" style="v" sid="EXO 7:15" />明天早晨你要到法老那裡去。看哪，他會出來到水邊，你就站在<char style="pn">尼羅</char>河岸迎候他。你手中要拿著那根曾變成蛇的杖。 <verse eid="EXO 7:15" /><verse number="16" style="v" sid="EXO 7:16" />你要對他說：『<char style="pn">希伯來</char>人的神耶和華派遣我到你這裡說：讓我的子民走，好使他們在曠野中服事我。看哪，直到現在你都不聽！ <verse eid="EXO 7:16" /><verse number="17" style="v" sid="EXO 7:17" />耶和華如此說：看哪，我要用我手中的杖擊打<char style="pn">尼羅</char>河裡的水，水就會變成血，這樣你就知道我是耶和華。 <verse eid="EXO 7:17" /><verse number="18" style="v" sid="EXO 7:18" /><char style="pn">尼羅</char>河裡的魚都會死，<char style="pn">尼羅</char>河也會發臭，<char style="pn">埃及</char>人就不能<note caller="+" style="f"><char style="fr" closed="false">7:18 </char><char style="ft" closed="false">不能——原文直譯「厭惡」。</char></note>喝<char style="pn">尼羅</char>河裡的水了。』」<verse eid="EXO 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 7:19" />耶和華對<char style="pn">摩西</char>說：「你要對<char style="pn">亞倫</char>說：『拿你的杖，伸出你的手在<char style="pn">埃及</char>眾水之上，就是在他們的河流、運河、池塘以及所有的蓄水池之上，水就會變成血；在<char style="pn">埃及</char>全地都會有血，甚至在木器、石器裡。』」<verse eid="EXO 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20" />
    <char style="pn">摩西</char>和<char style="pn">亞倫</char>就照著耶和華所指示的做了。<char style="pn">亞倫</char>在法老眼前和他的臣僕眼前舉起杖，擊打<char style="pn">尼羅</char>河裡的水，<char style="pn">尼羅</char>河裡的水就全都變成了血。 <verse eid="EXO 7:20" /><verse number="21" style="v" sid="EXO 7:21" /><char style="pn">尼羅</char>河裡的魚都死了，<char style="pn">尼羅</char>河也發臭了，<char style="pn">埃及</char>人就不能喝<char style="pn">尼羅</char>河裡的水。在<char style="pn">埃及</char>全地都是血。<verse eid="EXO 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 7:22" />
    <char style="pn">埃及</char>的術士們也用他們的邪術照樣做。於是法老的心就剛硬，不聽從<char style="pn">摩西</char>和<char style="pn">亞倫</char>，正如耶和華所說的。 <verse eid="EXO 7:22" /><verse number="23" style="v" sid="EXO 7:23" />法老轉身回到他的宮殿裡，竟沒有把這事放在心上。 <verse eid="EXO 7:23" /><verse number="24" style="v" sid="EXO 7:24" />所有的<char style="pn">埃及</char>人在<char style="pn">尼羅</char>河周圍挖地找水喝，因為他們不能喝<char style="pn">尼羅</char>河裡的水。 <verse eid="EXO 7:24" /><verse number="25" style="v" sid="EXO 7:25" />耶和華打擊<char style="pn">尼羅</char>河之後，滿了七天。<verse eid="EXO 7:25" /></para>
  <chapter eid="EXO 7" />
  <chapter number="8" style="c" sid="EXO 8" />
  <para style="s">第二災：蛙災</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1" />耶和華對<char style="pn">摩西</char>說：「你到法老那裡去，對他說：『耶和華如此說：讓我的子民走，好使他們服事我。 <verse eid="EXO 8:1" /><verse number="2" style="v" sid="EXO 8:2" />如果你拒絕讓他們走，看哪，我就用青蛙打擊你的全境！ <verse eid="EXO 8:2" /><verse number="3" style="v" sid="EXO 8:3" /><char style="pn">尼羅</char>河裡將充滿青蛙，青蛙會上來，進入你的宮殿、你的臥室，上你的床榻，進入你臣僕的房屋，上到你的子民身上，進入你的火爐、你的揉麵盆。 <verse eid="EXO 8:3" /><verse number="4" style="v" sid="EXO 8:4" />青蛙也會上到你身上，上到你的子民和你所有的臣僕身上。』」<verse eid="EXO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5" />耶和華對<char style="pn">摩西</char>說：「你要對<char style="pn">亞倫</char>說：『拿你的杖，伸出你的手在河流、運河、池塘之上，使青蛙上到<char style="pn">埃及</char>地。』」 <verse eid="EXO 8:5" /><verse number="6" style="v" sid="EXO 8:6" /><char style="pn">亞倫</char>伸出他的手在<char style="pn">埃及</char>的眾水之上，青蛙就上來，遮蓋了<char style="pn">埃及</char>地。 <verse eid="EXO 8:6" /><verse number="7" style="v" sid="EXO 8:7" />術士們也用他們的邪術照樣做，使青蛙上到<char style="pn">埃及</char>地。<verse eid="EXO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8" />於是法老召來<char style="pn">摩西</char>和<char style="pn">亞倫</char>，說：「請你們向耶和華祈求，使這些青蛙離開我和我的子民，我就讓<char style="pn">以色列</char>人走，好使他們向耶和華獻祭。」<verse eid="EXO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 8:9" />
    <char style="pn">摩西</char>對法老說：「請指示我什麼時候為你、你的臣僕和你的子民祈求，使這些青蛙從你那裡、從你的宮殿中被除去，只留在<char style="pn">尼羅</char>河裡。」<verse eid="EXO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 8:10" />法老回答：「明天。」</para>
  <para style="p" vid="EXO 8:10">
    <char style="pn">摩西</char>說：「就照著你的話吧，好讓你知道我們的神耶和華無與倫比！ <verse eid="EXO 8:10" /><verse number="11" style="v" sid="EXO 8:11" />這些青蛙將離開你、你的宮殿、你的臣僕和你的子民，只留在<char style="pn">尼羅</char>河裡。」 <verse eid="EXO 8:11" /><verse number="12" style="v" sid="EXO 8:12" /><char style="pn">摩西</char>和<char style="pn">亞倫</char>從法老那裡出來，<char style="pn">摩西</char>為加給法老的蛙災<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">蛙災——原文直譯「青蛙的事」。</char></note>，向耶和華呼求。 <verse eid="EXO 8:12" /><verse number="13" style="v" sid="EXO 8:13" />耶和華就照著<char style="pn">摩西</char>所求的做了。於是在房屋、院子和田野中的青蛙都死了。 <verse eid="EXO 8:13" /><verse number="14" style="v" sid="EXO 8:14" />人們把青蛙一堆一堆積聚起來，那地就發臭了。 <verse eid="EXO 8:14" /><verse number="15" style="v" sid="EXO 8:15" />然而，法老看見災禍有所緩解，就硬著心，不聽從<char style="pn">摩西</char>和<char style="pn">亞倫</char>，正如耶和華所說的。<verse eid="EXO 8:15" /></para>
  <para style="s">第三災：蠓災</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16" />耶和華對<char style="pn">摩西</char>說：「你要對<char style="pn">亞倫</char>說：『伸出你的杖，擊打地上的塵土，使塵土在<char style="pn">埃及</char>全地變成蠓蚋。』」 <verse eid="EXO 8:16" /><verse number="17" style="v" sid="EXO 8:17" />他們就這樣做了。<char style="pn">亞倫</char>伸出手中的杖擊打了地上的塵土，人和牲畜的身上就都有了蠓蚋；在<char style="pn">埃及</char>全地，地上所有的塵土都變成了蠓蚋。 <verse eid="EXO 8:17" /><verse number="18" style="v" sid="EXO 8:18" />術士們也用他們的邪術照樣做，要變出蠓蚋來，卻是不能。這樣，人和牲畜的身上都有了蠓蚋。<verse eid="EXO 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 8:19" />術士們就對法老說：「這是神的手指所做的<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="ft" closed="false">所做的——輔助詞語。</char></note>。」然而，法老的心剛硬，不聽從<char style="pn">摩西</char>和<char style="pn">亞倫</char>，正如耶和華所說的。<verse eid="EXO 8:19" /></para>
  <para style="s">第四災：蠅災</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20" />耶和華對<char style="pn">摩西</char>說：「你要清早起來，站到法老面前。看哪，他會出來到水邊！你要對他說：『耶和華如此說：讓我的子民走，好使他們服事我。 <verse eid="EXO 8:20" /><verse number="21" style="v" sid="EXO 8:21" />如果你不讓我的子民走，看哪，我就打發成群的蒼蠅落在你、你的臣僕和你的子民身上，進入你的宮殿！<char style="pn">埃及</char>人的房屋和他們的所在之地都將充滿成群的蒼蠅。 <verse eid="EXO 8:21" /><verse number="22" style="v" sid="EXO 8:22" />到那日，我會把我子民所住的<char style="pn">歌珊</char>地分別出來，使那裡沒有成群的蒼蠅，好讓你知道在這地上，我是耶和華。 <verse eid="EXO 8:22" /><verse number="23" style="v" sid="EXO 8:23" />我要把我的子民和你的子民區分開來。明天必有這神蹟。』」<verse eid="EXO 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 8:24" />耶和華就這樣做了。無數成群的蒼蠅進入了法老的宮殿和他臣僕的房屋；在<char style="pn">埃及</char>全地，因成群的蒼蠅，地都毀壞了。 <verse eid="EXO 8:24" /><verse number="25" style="v" sid="EXO 8:25" />法老召來<char style="pn">摩西</char>和<char style="pn">亞倫</char>，說：「你們去，在這地向你們的神獻祭吧！」<verse eid="EXO 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 8:26" />
    <char style="pn">摩西</char>說：「這樣做不妥，因為我們獻給我們神耶和華的祭是<char style="pn">埃及</char>人所憎惡的。看哪，如果我們把<char style="pn">埃及</char>人所憎惡的在他們眼前獻為祭，難道他們不會用石頭砸死我們嗎？ <verse eid="EXO 8:26" /><verse number="27" style="v" sid="EXO 8:27" />我們必須在曠野中走三天的路程，照著我們的神耶和華對我們所說的向他獻祭。」<verse eid="EXO 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 8:28" />法老說：「我會讓你們走，好使你們在曠野向你們的神耶和華獻祭，只是不可走得太遠。請你們為我祈求！」<verse eid="EXO 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 8:29" />
    <char style="pn">摩西</char>說：「看哪，我從你這裡出去會向耶和華祈求，使成群的蒼蠅明天離開法老、他的臣僕和他的子民！只是法老不可再愚弄我們，不讓<char style="pn">以色列</char>百姓走，去向耶和華獻祭。」 <verse eid="EXO 8:29" /><verse number="30" style="v" sid="EXO 8:30" /><char style="pn">摩西</char>從法老那裡出來，向耶和華祈求。 <verse eid="EXO 8:30" /><verse number="31" style="v" sid="EXO 8:31" />耶和華就照著<char style="pn">摩西</char>所求的做了。於是成群的蒼蠅離開了法老、他的臣僕和他的子民，連一隻也沒有留下。 <verse eid="EXO 8:31" /><verse number="32" style="v" sid="EXO 8:32" />然而，這一次法老又硬著心，不讓<char style="pn">以色列</char>百姓走。<verse eid="EXO 8:32" /></para>
  <chapter eid="EXO 8" />
  <chapter number="9" style="c" sid="EXO 9" />
  <para style="s">第五災：畜疫之災</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1" />耶和華對<char style="pn">摩西</char>說：「你到法老那裡去，對他說：『耶和華<char style="pn">希伯來</char>人的神如此說：讓我的子民走，好使他們服事我。 <verse eid="EXO 9:1" /><verse number="2" style="v" sid="EXO 9:2" />如果你拒絕讓他們走，還要強行留住他們， <verse eid="EXO 9:2" /><verse number="3" style="v" sid="EXO 9:3" />看哪，耶和華的手就使極其嚴重的瘟疫臨到你田野中的牲畜，就是馬匹、驢子、駱駝、牛群和羊群！ <verse eid="EXO 9:3" /><verse number="4" style="v" sid="EXO 9:4" />但是耶和華會把<char style="pn">以色列</char>的牲畜和<char style="pn">埃及</char>的牲畜分別開來，所有屬於<char style="pn">以色列</char>子孫的，一隻也不會死。』」 <verse eid="EXO 9:4" /><verse number="5" style="v" sid="EXO 9:5" />耶和華定下了時間，說：「明天，耶和華必在這地做這事。」 <verse eid="EXO 9:5" /><verse number="6" style="v" sid="EXO 9:6" />第二天，耶和華就做了這事。<char style="pn">埃及</char>的牲畜全都死了，而屬於<char style="pn">以色列</char>子孫的牲畜一隻也沒有死。 <verse eid="EXO 9:6" /><verse number="7" style="v" sid="EXO 9:7" />法老派人去，看哪，屬於<char style="pn">以色列</char>的牲畜連一隻也沒有死！然而，法老又硬著心，不讓<char style="pn">以色列</char>百姓走。<verse eid="EXO 9:7" /></para>
  <para style="s">第六災：瘡災</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8" />耶和華對<char style="pn">摩西</char>和<char style="pn">亞倫</char>說：「你們要雙手滿滿捧著爐灰，<char style="pn">摩西</char>在法老眼前向天空揚撒這爐灰。 <verse eid="EXO 9:8" /><verse number="9" style="v" sid="EXO 9:9" />這爐灰將在<char style="pn">埃及</char>全地變成微塵，使<char style="pn">埃及</char>全地的人和牲畜的身上都生出流膿的瘡。」 <verse eid="EXO 9:9" /><verse number="10" style="v" sid="EXO 9:10" />於是他們就拿了爐灰，站在法老面前。<char style="pn">摩西</char>把爐灰向天揚撒，人和牲畜的身上就生出了流膿的瘡。 <verse eid="EXO 9:10" /><verse number="11" style="v" sid="EXO 9:11" />術士們因這瘡的緣故在<char style="pn">摩西</char>面前站立不住，因為術士們和所有<char style="pn">埃及</char>人的身上都生出了瘡。 <verse eid="EXO 9:11" /><verse number="12" style="v" sid="EXO 9:12" />然而，耶和華使法老的心剛硬，他就不聽從<char style="pn">摩西</char>和<char style="pn">亞倫</char>，正如耶和華對<char style="pn">摩西</char>所說的。<verse eid="EXO 9:12" /></para>
  <para style="s">第七災：雹災</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13" />耶和華對<char style="pn">摩西</char>說：「你要清早起來，站到法老面前，對他說，『<char style="pn">希伯來</char>人的神耶和華如此說：讓我的子民走，好使他們服事我。 <verse eid="EXO 9:13" /><verse number="14" style="v" sid="EXO 9:14" />要知道，這一次我要使我所有的災殃降到你<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">你——原文直譯「你的心」。</char></note>、你的臣僕和你的子民身上，為要你知道在全地上沒有能與我相比的。 <verse eid="EXO 9:14" /><verse number="15" style="v" sid="EXO 9:15" />如果我現在伸手用瘟疫打擊你和你的子民，你早已從地上除滅了。 <verse eid="EXO 9:15" /><verse number="16" style="v" sid="EXO 9:16" />實際上，我使你存留是為要向你顯明我的大能，好讓我的名在全地上被講述。 <verse eid="EXO 9:16" /><verse number="17" style="v" sid="EXO 9:17" />你還在對我的子民自高，不讓他們走。 <verse eid="EXO 9:17" /><verse number="18" style="v" sid="EXO 9:18" />看哪，明天大約這個時候，我必降下極其猛烈的冰雹，是自從<char style="pn">埃及</char>建國之日直到現在未曾有過的！ <verse eid="EXO 9:18" /><verse number="19" style="v" sid="EXO 9:19" />現在，你要派人去，把你的牲畜和田野中所有屬於你的都帶去避難。任何在田野中沒有被聚集到房屋裡的人和牲畜，冰雹必降在他們身上，他們就必死。』」 <verse eid="EXO 9:19" /><verse number="20" style="v" sid="EXO 9:20" />法老的臣僕中，那些懼怕耶和華這話的，就讓自己的僕人們和牲畜逃避進房屋； <verse eid="EXO 9:20" /><verse number="21" style="v" sid="EXO 9:21" />而那些不把耶和華這話放在心上的，就把自己的僕人們和牲畜留在田野中。<verse eid="EXO 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 9:22" />耶和華對<char style="pn">摩西</char>說：「向天伸出你的手，使冰雹落在<char style="pn">埃及</char>全地，落在人和牲畜身上，落在<char style="pn">埃及</char>地田間所有的蔬草上。」 <verse eid="EXO 9:22" /><verse number="23" style="v" sid="EXO 9:23" /><char style="pn">摩西</char>向天伸出他的杖，耶和華就發出雷聲和冰雹，有火閃到地上。耶和華在<char style="pn">埃及</char>地降下冰雹。 <verse eid="EXO 9:23" /><verse number="24" style="v" sid="EXO 9:24" />那時有冰雹，又有火在冰雹中不斷地閃爍，極其猛烈！這是<char style="pn">埃及</char>全地自從開國以來未曾有過的。 <verse eid="EXO 9:24" /><verse number="25" style="v" sid="EXO 9:25" />在<char style="pn">埃及</char>全地，冰雹打擊了田野中所有的人和牲畜；冰雹又打擊了田間所有的蔬草，摧毀了田野中所有的樹木。 <verse eid="EXO 9:25" /><verse number="26" style="v" sid="EXO 9:26" />只有<char style="pn">以色列</char>子孫所住的<char style="pn">歌珊</char>地，沒有冰雹。<verse eid="EXO 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 9:27" />於是法老派人召來<char style="pn">摩西</char>和<char style="pn">亞倫</char>，對他們說：「這一次我犯了罪，耶和華是公義的，而我和我的子民是邪惡的。 <verse eid="EXO 9:27" /><verse number="28" style="v" sid="EXO 9:28" />請你們向耶和華祈求，因為我們已經受夠了神的雷聲和冰雹。我讓你們走，你們不用再留下來了。」<verse eid="EXO 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 9:29" />
    <char style="pn">摩西</char>對他說：「我一出城，就會向耶和華伸開我的雙手，雷聲就會停止，也不會再有冰雹，好讓你知道這地是屬於耶和華的。 <verse eid="EXO 9:29" /><verse number="30" style="v" sid="EXO 9:30" />至於你和你的臣僕，我知道你們在神耶和華的面前還是沒有敬畏之心。」<verse eid="EXO 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 9:31" />那時，因為大麥已經吐穗，亞麻也開了花，亞麻和大麥就被擊打了。 <verse eid="EXO 9:31" /><verse number="32" style="v" sid="EXO 9:32" />小麥和黑麥卻沒有被擊打，因為它們是晚熟的。<verse eid="EXO 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 9:33" />
    <char style="pn">摩西</char>從法老那裡出了城，向耶和華伸開他的雙手，雷聲和冰雹就停止了，雨水也不再傾瀉在地。 <verse eid="EXO 9:33" /><verse number="34" style="v" sid="EXO 9:34" />法老看見雨水、冰雹和雷聲都停止了，就再次犯罪，他和他的臣僕都硬著心。 <verse eid="EXO 9:34" /><verse number="35" style="v" sid="EXO 9:35" />法老的心剛硬，不讓<char style="pn">以色列</char>子孫走，正如耶和華藉著<char style="pn">摩西</char>所說的。<verse eid="EXO 9:35" /></para>
  <chapter eid="EXO 9" />
  <chapter number="10" style="c" sid="EXO 10" />
  <para style="s">第八災：蝗災</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1" />耶和華對<char style="pn">摩西</char>說：「你到法老那裡去，因為我已經使他和他的臣僕硬著心，為要在他們當中施行我的這些神蹟， <verse eid="EXO 10:1" /><verse number="2" style="v" sid="EXO 10:2" />也為要你向你的兒孫講述我嚴厲對付<char style="pn">埃及</char>的事和我在他們中間施行的神蹟，好讓你們知道我是耶和華。」<verse eid="EXO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 10:3" />
    <char style="pn">摩西</char>和<char style="pn">亞倫</char>就來到法老那裡，對他說：「<char style="pn">希伯來</char>人的神耶和華如此說：『你拒絕在我面前謙卑，要到什麼時候呢？讓我的子民走，好使他們服事我。 <verse eid="EXO 10:3" /><verse number="4" style="v" sid="EXO 10:4" />如果你拒絕讓我的子民走，看哪，我明天就使蝗蟲進入你的境內！ <verse eid="EXO 10:4" /><verse number="5" style="v" sid="EXO 10:5" />牠們將遮蓋地面，以致人看不見地。牠們將吞噬冰雹後留給你們的那些餘剩物，也將吞噬田野中給你們長出的所有樹木。 <verse eid="EXO 10:5" /><verse number="6" style="v" sid="EXO 10:6" />牠們又將充滿你的宮殿、你所有臣僕的房屋和所有<char style="pn">埃及</char>人的房屋。這是自從你祖先和你祖先的祖先住在這地之日直到今日未曾見過的。』」然後<char style="pn">摩西</char>就轉身從法老那裡出去了。<verse eid="EXO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 10:7" />法老的臣僕對法老說：「這人作我們的陷阱，要到什麼時候呢？讓這些人走，好使他們服事耶和華他們的神。難道你不知道<char style="pn">埃及</char>已經毀了嗎？」<verse eid="EXO 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 10:8" />於是，<char style="pn">摩西</char>和<char style="pn">亞倫</char>被帶回到法老那裡。法老對他們說：「你們去，服事耶和華你們的神！不過，要去的是哪些人<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">哪些人——原文直譯「誰與誰」。</char></note>呢？」<verse eid="EXO 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 10:9" />
    <char style="pn">摩西</char>說：「我們要與我們的少年人、老年人一起去，與我們的兒子們、女兒們、羊群、牛群一起去，因為我們要守耶和華的節期。」<verse eid="EXO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 10:10" />法老對他們說：「如果我真讓你們與你們的孩童一起走，那麼我也會願耶和華與你們同在！看，邪惡就在你們的臉上<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false">邪惡就在你們的臉上——或譯作「災禍就在你們面前」。</char></note>！ <verse eid="EXO 10:10" /><verse number="11" style="v" sid="EXO 10:11" />不行，只有你們中的男人可以去服事耶和華！這是你們所要求的。」於是法老把他們從自己面前趕出去。<verse eid="EXO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 10:12" />耶和華對<char style="pn">摩西</char>說：「向<char style="pn">埃及</char>地伸出你的手，使蝗蟲上到<char style="pn">埃及</char>地，吞噬地上冰雹後留下的所有蔬草。」 <verse eid="EXO 10:12" /><verse number="13" style="v" sid="EXO 10:13" /><char style="pn">摩西</char>向<char style="pn">埃及</char>地伸出他的杖，耶和華就引導東風在地上颳了整整一日一夜。到了早晨，東風把蝗蟲颳來了。 <verse eid="EXO 10:13" /><verse number="14" style="v" sid="EXO 10:14" />蝗蟲上到<char style="pn">埃及</char>全地，停留在<char style="pn">埃及</char>全境，極其眾多；這樣多的蝗蟲，以前未曾有過，以後也不會再有。 <verse eid="EXO 10:14" /><verse number="15" style="v" sid="EXO 10:15" />蝗蟲遮蓋了整個地面，以致地都黑暗了。牠們吞噬了地上冰雹後留下的所有蔬草和樹上的所有果實。在<char style="pn">埃及</char>全地，無論是樹木，還是田間的蔬草，都沒有留下一點青綠。<verse eid="EXO 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 10:16" />於是法老急忙召來<char style="pn">摩西</char>和<char style="pn">亞倫</char>，說：「我對你們的神耶和華犯了罪，也對你們犯了罪。 <verse eid="EXO 10:16" /><verse number="17" style="v" sid="EXO 10:17" />現在，請你饒恕我的罪，就只這一次；也請你們向你們的神耶和華祈求，只要使這死亡離開我。」 <verse eid="EXO 10:17" /><verse number="18" style="v" sid="EXO 10:18" /><char style="pn">摩西</char>從法老那裡出來，向耶和華祈求。 <verse eid="EXO 10:18" /><verse number="19" style="v" sid="EXO 10:19" />耶和華就把東風轉為極其強大的西風，把蝗蟲颳起，吹入<char style="pn">紅海</char>；在<char style="pn">埃及</char>全境連一隻蝗蟲也沒有留下。 <verse eid="EXO 10:19" /><verse number="20" style="v" sid="EXO 10:20" />然而，耶和華使法老的心剛硬，他就不讓<char style="pn">以色列</char>子孫走。<verse eid="EXO 10:20" /></para>
  <para style="s">第九災：黑暗之災</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21" />耶和華又對<char style="pn">摩西</char>說：「向天伸出你的手，使黑暗——甚至可以摸得到的黑暗臨到<char style="pn">埃及</char>地。」 <verse eid="EXO 10:21" /><verse number="22" style="v" sid="EXO 10:22" /><char style="pn">摩西</char>向天伸出他的手，濃厚的黑暗就臨到<char style="pn">埃及</char>全地，有三天之久； <verse eid="EXO 10:22" /><verse number="23" style="v" sid="EXO 10:23" />這三天中，人們彼此看不見，誰也不能起來離開原處。然而，所有<char style="pn">以色列</char>子孫居住的地方都有光。<verse eid="EXO 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 10:24" />於是法老召來<char style="pn">摩西</char>，說：「你們去，服事耶和華！只是你們的羊群和牛群要留下，你們的孩童可以與你們一起去。」<verse eid="EXO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 10:25" />
    <char style="pn">摩西</char>就說：「你必須把祭物和燔祭也交在我們的手中，好使我們獻給耶和華我們的神。 <verse eid="EXO 10:25" /><verse number="26" style="v" sid="EXO 10:26" />我們的牲畜也要與我們一起去，連一蹄也不留下，因為我們要從中取出一些來服事耶和華我們的神，而在我們到達那裡之前，我們並不知道要用什麼來服事耶和華。」<verse eid="EXO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 10:27" />然而，耶和華使法老的心剛硬，他就不肯讓他們走。 <verse eid="EXO 10:27" /><verse number="28" style="v" sid="EXO 10:28" />法老對<char style="pn">摩西</char>說：「你離開我去吧！你要小心，不要再見我的面，因為你見我面的那一天，你必會死！」<verse eid="EXO 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 10:29" />
    <char style="pn">摩西</char>說：「你說得對，我絕不會再見你的面了！」<verse eid="EXO 10:29" /></para>
  <chapter eid="EXO 10" />
  <chapter number="11" style="c" sid="EXO 11" />
  <para style="s">第十災：頭生的被殺之災</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1" />耶和華對<char style="pn">摩西</char>說：「我還有一災要臨到法老和<char style="pn">埃及</char>；之後法老必讓你們走，離開這裡。他讓你們走的時候，必定會從這裡徹底驅逐你們。 <verse eid="EXO 11:1" /><verse number="2" style="v" sid="EXO 11:2" />現在你當說給子民聽，要每個男人向他們的鄰人、每個女人向她們的鄰舍索要銀器和金器。」 <verse eid="EXO 11:2" /><verse number="3" style="v" sid="EXO 11:3" />耶和華使<char style="pn">以色列</char>百姓在<char style="pn">埃及</char>人眼前蒙恩，而<char style="pn">摩西</char>這人也在<char style="pn">埃及</char>地、在法老的臣僕和他的子民眼中都極其偉大。<verse eid="EXO 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 11:4" />
    <char style="pn">摩西</char>說：「耶和華如此說：『大約在半夜，我必出去，進到<char style="pn">埃及</char>中。 <verse eid="EXO 11:4" /><verse number="5" style="v" sid="EXO 11:5" /><char style="pn">埃及</char>地所有頭生的——從坐寶座的法老的長子到推石磨的婢女的長子，以及所有頭生的牲畜，都必死。 <verse eid="EXO 11:5" /><verse number="6" style="v" sid="EXO 11:6" /><char style="pn">埃及</char>全地會有極大的哀聲；這樣的哀聲，以前未曾有過，以後也不會再有； <verse eid="EXO 11:6" /><verse number="7" style="v" sid="EXO 11:7" />但是在所有的<char style="pn">以色列</char>子孫中，連狗也不會對人或牲畜吠叫，好讓你們知道耶和華把<char style="pn">埃及</char>和<char style="pn">以色列</char>分別開來。』 <verse eid="EXO 11:7" /><verse number="8" style="v" sid="EXO 11:8" />你的這些臣僕全都會下到我這裡來，向我下拜，說：『你和所有跟隨你的子民都出去吧！』然後我才會出去。」於是<char style="pn">摩西</char>在烈怒中從法老那裡出去了。<verse eid="EXO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 11:9" />耶和華對<char style="pn">摩西</char>說：「法老不會聽從你們，好使我的奇事在<char style="pn">埃及</char>地增多。」 <verse eid="EXO 11:9" /><verse number="10" style="v" sid="EXO 11:10" /><char style="pn">摩西</char>和<char style="pn">亞倫</char>在法老面前行了這一切的奇事，但耶和華使法老的心剛硬，他就不讓<char style="pn">以色列</char>子孫走，離開他的地。<verse eid="EXO 11:10" /></para>
  <chapter eid="EXO 11" />
  <chapter number="12" style="c" sid="EXO 12" />
  <para style="s">逾越節和除酵節</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1" />耶和華在<char style="pn">埃及</char>地對<char style="pn">摩西</char>和<char style="pn">亞倫</char>說： <verse eid="EXO 12:1" /><verse number="2" style="v" sid="EXO 12:2" />「本月要作為你們的正月，作為你們一年的第一個月。 <verse eid="EXO 12:2" /><verse number="3" style="v" sid="EXO 12:3" />你們要吩咐全體<char style="pn">以色列</char>會眾說：本月十日，他們各人要按著父家為自己取羔羊，一家一隻羔羊。 <verse eid="EXO 12:3" /><verse number="4" style="v" sid="EXO 12:4" />如果一家的人太少，吃不了一隻羔羊，那麼就要與最靠近的鄰居按人數共取一隻；你們要按各人的食量估算羔羊的量。 <verse eid="EXO 12:4" /><verse number="5" style="v" sid="EXO 12:5" />羔羊必須是無瑕疵的一歲公羊，可以從綿羊或山羊裡取。 <verse eid="EXO 12:5" /><verse number="6" style="v" sid="EXO 12:6" />你們要把羔羊保留到本月十四日；當天黃昏的時候，<char style="pn">以色列</char>全體會眾要宰殺羔羊。 <verse eid="EXO 12:6" /><verse number="7" style="v" sid="EXO 12:7" />他們要取一些血，塗在他們吃羔羊的房屋的兩邊門框上和門楣上。 <verse eid="EXO 12:7" /><verse number="8" style="v" sid="EXO 12:8" />那天夜裡，他們要吃用火烤的羔羊肉，與無酵餅和苦菜一起吃。 <verse eid="EXO 12:8" /><verse number="9" style="v" sid="EXO 12:9" />你們不可吃任何生的或用水煮的羔羊肉，只可吃用火烤的，連頭帶腿，與內臟一起烤； <verse eid="EXO 12:9" /><verse number="10" style="v" sid="EXO 12:10" />你們一點也不可留到早晨，任何留到早晨的，都要用火燒掉。 <verse eid="EXO 12:10" /><verse number="11" style="v" sid="EXO 12:11" />你們要這樣吃羔羊的肉：腰間束帶，腳上穿鞋，手中拿杖，並要快快地吃。這是耶和華的逾越節。<verse eid="EXO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 12:12" />「那天夜裡，我要遍行<char style="pn">埃及</char>地，擊殺<char style="pn">埃及</char>地所有頭生的，無論是人還是牲畜；我還要對<char style="pn">埃及</char>的一切神明施行審判。我是耶和華。 <verse eid="EXO 12:12" /><verse number="13" style="v" sid="EXO 12:13" />這血在你們所住的房屋上，要作為你們的標記。我看見這血，就會越過你們；我打擊<char style="pn">埃及</char>地的時候，毀滅的災殃就不會臨到你們。<verse eid="EXO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 12:14" />「這一天要成為你們的記念，你們要守這日為耶和華的節期；你們世世代代要守這節期，作為永遠的律例。 <verse eid="EXO 12:14" /><verse number="15" style="v" sid="EXO 12:15" />你們要吃無酵餅七天；第一天就要把酵從你們的家裡除掉，因為從第一天到第七天，凡吃了有酵之物的，那人就要從<char style="pn">以色列</char>中被剪除。 <verse eid="EXO 12:15" /><verse number="16" style="v" sid="EXO 12:16" />第一天你們要有神聖的聚會，第七天你們也要有神聖的聚會；在這兩天，任何工作都不可做，只能預備各人吃的東西，這是你們唯一可做的。<verse eid="EXO 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 12:17" />「你們要守無酵節，因為就在這一天，我把你們的大軍從<char style="pn">埃及</char>地領出來，所以你們世世代代要守這一日，作為永遠的律例。 <verse eid="EXO 12:17" /><verse number="18" style="v" sid="EXO 12:18" />從一月十四日傍晚到二十一日傍晚，你們要吃無酵餅。 <verse eid="EXO 12:18" /><verse number="19" style="v" sid="EXO 12:19" />在這七天，你們的家裡不可有酵，因為凡吃了有酵之物的，無論是外人還是本族人<note caller="+" style="f"><char style="fr" closed="false">12:19 </char><char style="ft" closed="false">本族人——原文直譯「本地人」；本章下同。</char></note>，那人就要從<char style="pn">以色列</char>的會眾當中被剪除。 <verse eid="EXO 12:19" /><verse number="20" style="v" sid="EXO 12:20" />一切有酵之物，你們都不可吃；在你們居住的任何地方，你們都要吃無酵餅。」<verse eid="EXO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21" />於是<char style="pn">摩西</char>召來<char style="pn">以色列</char>所有的長老，對他們說：「你們要按著你們的家族，為自己挑選並取來一隻羔羊，宰殺這逾越節的羔羊。 <verse eid="EXO 12:21" /><verse number="22" style="v" sid="EXO 12:22" />你們要拿一把牛膝草，蘸在盆中的血裡，把盆中的血塗在門楣上和兩邊的門框上。你們誰都不可出自己的家門，直到早晨， <verse eid="EXO 12:22" /><verse number="23" style="v" sid="EXO 12:23" />因為耶和華要遍行這地，擊殺<char style="pn">埃及</char>人；耶和華看見門楣上和兩邊門框上的血，就會越過那門，不允許那毀滅者進入你們的房屋擊殺你們。<verse eid="EXO 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 12:24" />「你們要遵守這吩咐，作為你和你子孫的定例，直到永遠。 <verse eid="EXO 12:24" /><verse number="25" style="v" sid="EXO 12:25" />日後，你們進入耶和華應許賜給你們的那地，也要守這服事之禮。 <verse eid="EXO 12:25" /><verse number="26" style="v" sid="EXO 12:26" />日後，你們的子孫問你們『這服事之禮對你們是什麼意思呢？』 <verse eid="EXO 12:26" /><verse number="27" style="v" sid="EXO 12:27" />你們就要說『這是獻給耶和華的逾越節之祭；他在擊殺<char style="pn">埃及</char>人的時候，越過了在<char style="pn">埃及</char>的<char style="pn">以色列</char>子孫的房屋，解救了我們的家。』」於是，<char style="pn">以色列</char>百姓俯身下拜。 <verse eid="EXO 12:27" /><verse number="28" style="v" sid="EXO 12:28" /><char style="pn">以色列</char>子孫就這樣去做；耶和華所指示<char style="pn">摩西</char>和<char style="pn">亞倫</char>的，<char style="pn">以色列</char>子孫都照著去做了。<verse eid="EXO 12:28" /></para>
  <para style="s">出埃及</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29" />到了半夜，耶和華擊殺了<char style="pn">埃及</char>地所有頭生的——從坐寶座的法老的長子到牢房裡的俘虜的長子，以及所有頭生的牲畜。 <verse eid="EXO 12:29" /><verse number="30" style="v" sid="EXO 12:30" />法老夜間起來，他所有的臣僕和所有的<char style="pn">埃及</char>人也都起來了；在<char style="pn">埃及</char>有極大的哀聲，因為沒有一家不死人的。 <verse eid="EXO 12:30" /><verse number="31" style="v" sid="EXO 12:31" />於是法老夜間召來<char style="pn">摩西</char>和<char style="pn">亞倫</char>，說：「起來，你們和<char style="pn">以色列</char>子孫都從我的子民中間出去！照著你們所說的，去服事耶和華； <verse eid="EXO 12:31" /><verse number="32" style="v" sid="EXO 12:32" />也照著你們所說的，帶著你們的羊群和牛群走！不過，你們也要為我祝福！」<verse eid="EXO 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 12:33" />
    <char style="pn">埃及</char>人催促<char style="pn">以色列</char>百姓，要他們趕快走，離開那地，因為<char style="pn">埃及</char>人說：「我們全都要死了。」 <verse eid="EXO 12:33" /><verse number="34" style="v" sid="EXO 12:34" />於是<char style="pn">以色列</char>百姓拿起未放入酵的麵團和揉麵盆，用他們的衣服包住，扛在肩膀上。<verse eid="EXO 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 12:35" />
    <char style="pn">以色列</char>子孫照著<char style="pn">摩西</char>的話去做，向<char style="pn">埃及</char>人索要銀器、金器和衣服。 <verse eid="EXO 12:35" /><verse number="36" style="v" sid="EXO 12:36" />耶和華使<char style="pn">以色列</char>百姓在<char style="pn">埃及</char>人眼前蒙恩，<char style="pn">埃及</char>人就給了他們索要的；這樣他們就剝奪了<char style="pn">埃及</char>人。<verse eid="EXO 12:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37" />
    <char style="pn">以色列</char>子孫從<char style="pn">拉美西斯</char>起程往<char style="pn">疏割</char>去，除了孩童，步行的男人約有六十萬； <verse eid="EXO 12:37" /><verse number="38" style="v" sid="EXO 12:38" />與他們一起上去的，還有眾多混雜的族群，以及羊群、牛群等極多的牲畜。 <verse eid="EXO 12:38" /><verse number="39" style="v" sid="EXO 12:39" />他們把從<char style="pn">埃及</char>帶出來的未放入酵的麵團烤成無酵餅，因為他們被驅逐離開<char style="pn">埃及</char>，不能耽延，也沒有為自己預備食物。<verse eid="EXO 12:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 12:40" />
    <char style="pn">以色列</char>子孫在<char style="pn">埃及</char>居住的時間是四百三十年。 <verse eid="EXO 12:40" /><verse number="41" style="v" sid="EXO 12:41" />到了四百三十年結束的時候，就在這一天，耶和華的全軍都從<char style="pn">埃及</char>地出來了。 <verse eid="EXO 12:41" /><verse number="42" style="v" sid="EXO 12:42" />這一夜是為耶和華所謹守的，因為他把他們從<char style="pn">埃及</char>地領出來；這一夜是所有的<char style="pn">以色列</char>子孫世世代代都要為耶和華謹守的夜。<verse eid="EXO 12:42" /></para>
  <para style="s">逾越節的律例</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43" />耶和華對<char style="pn">摩西</char>和<char style="pn">亞倫</char>說：「逾越節的律例是這樣的：所有外邦人都不可吃逾越節的羔羊； <verse eid="EXO 12:43" /><verse number="44" style="v" sid="EXO 12:44" />至於各人用銀子買來的每一個奴僕，在你給他行過割禮之後，他就可以吃。 <verse eid="EXO 12:44" /><verse number="45" style="v" sid="EXO 12:45" />客居者和雇工都不可吃。 <verse eid="EXO 12:45" /><verse number="46" style="v" sid="EXO 12:46" />你們要在同一間屋子裡吃，羔羊的肉一點也不可帶到屋子外面，羔羊的骨頭一根也不可折斷。 <verse eid="EXO 12:46" /><verse number="47" style="v" sid="EXO 12:47" />全體<char style="pn">以色列</char>會眾都要守這節期。 <verse eid="EXO 12:47" /><verse number="48" style="v" sid="EXO 12:48" />如果有外人寄居在你們中間，也願意向耶和華守逾越節，那麼他們中的每一個男子都要在受割禮之後，才可以近前來守節期；他也就像本族人那樣了；但所有未受割禮的人都不可吃逾越節的羔羊。 <verse eid="EXO 12:48" /><verse number="49" style="v" sid="EXO 12:49" />本族人與寄居在你們中間的外人，都是同一個條例。」<verse eid="EXO 12:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="EXO 12:50" />所有的<char style="pn">以色列</char>子孫就這樣做了；耶和華所指示<char style="pn">摩西</char>和<char style="pn">亞倫</char>的，<char style="pn">以色列</char>子孫都照著做了。 <verse eid="EXO 12:50" /><verse number="51" style="v" sid="EXO 12:51" />就在這一天，耶和華把<char style="pn">以色列</char>子孫從<char style="pn">埃及</char>地一隊一隊領出來了。<verse eid="EXO 12:51" /></para>
  <chapter eid="EXO 12" />
  <chapter number="13" style="c" sid="EXO 13" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="EXO 13:1" /><verse number="2" style="v" sid="EXO 13:2" />「在<char style="pn">以色列</char>子孫中所有頭生的，就是所有的頭胎，無論是人還是牲畜，都要分別為聖歸我；他們是屬於我的。」<verse eid="EXO 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3" />
    <char style="pn">摩西</char>對<char style="pn">以色列</char>百姓說：「你們要記念從<char style="pn">埃及</char>、從為奴之家出來的這一天，因為耶和華用大能的手把你們從這裡領了出來。你們不可吃有酵之物。 <verse eid="EXO 13:3" /><verse number="4" style="v" sid="EXO 13:4" />你們是在亞筆月的這一天出來的。 <verse eid="EXO 13:4" /><verse number="5" style="v" sid="EXO 13:5" />日後，耶和華領你進入<char style="pn">迦南</char>人、<char style="pn">赫提</char>人、<char style="pn">亞摩利</char>人、<char style="pn">希未</char>人、<char style="pn">耶布斯</char>人之地，就是他向你的先祖起誓要賜給你的那流奶與蜜之地，那時你也要在這個月守這服事之禮。 <verse eid="EXO 13:5" /><verse number="6" style="v" sid="EXO 13:6" />你要吃無酵餅七天；第七天是耶和華的節期。 <verse eid="EXO 13:6" /><verse number="7" style="v" sid="EXO 13:7" />在這七天，你要吃無酵餅；在你那裡不可看到有酵之物，在你的全境也不可看到酵。 <verse eid="EXO 13:7" /><verse number="8" style="v" sid="EXO 13:8" />到那日，你要告訴你的兒子說：『這是因為耶和華在我出<char style="pn">埃及</char>的時候為我所做的事。』 <verse eid="EXO 13:8" /><verse number="9" style="v" sid="EXO 13:9" />這要在你手上作為標記，在你額上<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false">額上——原文直譯「雙眼之間」。</char></note>作為記念，使耶和華的律法在你的口中，因為耶和華用大能的手把你從<char style="pn">埃及</char>領了出來。 <verse eid="EXO 13:9" /><verse number="10" style="v" sid="EXO 13:10" />因此，你每年都要在所定的日期遵守這律例。<verse eid="EXO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11" />「日後，耶和華照著他向你和你的先祖所起的誓，領你進入<char style="pn">迦南</char>人之地，把這地賜給你的時候， <verse eid="EXO 13:11" /><verse number="12" style="v" sid="EXO 13:12" />你也要把所有的頭胎都獻給耶和華。你擁有的牲畜中所有頭生的，凡是公的都屬於耶和華。 <verse eid="EXO 13:12" /><verse number="13" style="v" sid="EXO 13:13" />所有頭生的驢子，你要用羔羊贖回；如果不贖回，就要打斷牠的脖子。你兒子們中所有頭生的人，你都要贖回。<verse eid="EXO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 13:14" />「日後，你的兒子問你說『這是什麼意思呢？』你就要對他說『耶和華用大能的手把我們從<char style="pn">埃及</char>、從為奴之家領了出來。 <verse eid="EXO 13:14" /><verse number="15" style="v" sid="EXO 13:15" />那時法老強硬地不讓我們走，耶和華就把<char style="pn">埃及</char>地所有頭生的，無論是頭生的人還是頭生的牲畜，都殺死了。因此我把牲畜中所有頭胎的，凡是公的都祭獻給耶和華；而我所有頭生的兒子，我都要贖回。』 <verse eid="EXO 13:15" /><verse number="16" style="v" sid="EXO 13:16" />這要在你手上作為標記，在你額上<note caller="+" style="f"><char style="fr" closed="false">13:16 </char><char style="ft" closed="false">額上——原文直譯「雙眼之間」。</char></note>作為標誌，因為耶和華用大能的手把我們從<char style="pn">埃及</char>領了出來。」<verse eid="EXO 13:16" /></para>
  <para style="s">出埃及的路徑</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17" />法老讓<char style="pn">以色列</char>百姓走的時候，神沒有引導他們走<char style="pn">非利士</char>人之地的路，儘管那條路近，因為神說：「恐怕子民看到戰爭而改變心意，就回<char style="pn">埃及</char>去。」 <verse eid="EXO 13:17" /><verse number="18" style="v" sid="EXO 13:18" />於是神使百姓繞道走曠野的路往<char style="pn">紅海</char>去，<char style="pn">以色列</char>子孫就整裝列隊上去，離開<char style="pn">埃及</char>地。<verse eid="EXO 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 13:19" />
    <char style="pn">摩西</char>把<char style="pn">約瑟</char>的骸骨一起帶上，因為<char style="pn">約瑟</char>曾經讓<char style="pn">以色列</char>子孫鄭重地起誓，對他們說：「神必定眷顧你們，而你們要把我的骸骨從這裡一起帶上去。」<verse eid="EXO 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 13:20" />他們從<char style="pn">疏割</char>起行，在曠野邊上的<char style="pn">伊坦</char>紮營。 <verse eid="EXO 13:20" /><verse number="21" style="v" sid="EXO 13:21" />耶和華在他們前面行走，白天用雲柱引導他們的路，夜間用火柱照亮他們，使他們晝夜都可以行走。 <verse eid="EXO 13:21" /><verse number="22" style="v" sid="EXO 13:22" />白天雲柱，夜間火柱，總不離開<char style="pn">以色列</char>百姓面前。<verse eid="EXO 13:22" /></para>
  <chapter eid="EXO 13" />
  <chapter number="14" style="c" sid="EXO 14" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="EXO 14:1" /><verse number="2" style="v" sid="EXO 14:2" />「你要吩咐<char style="pn">以色列</char>子孫轉回去，在<char style="pn">比哈希錄</char>前面，<char style="pn">密奪</char>和海之間紮營，就是在<char style="pn">巴力洗分</char>前面，面對著它，靠著海邊紮營。 <verse eid="EXO 14:2" /><verse number="3" style="v" sid="EXO 14:3" />這樣，法老就會說<char style="pn">以色列</char>子孫在這地迷了路，曠野把他們困住了。 <verse eid="EXO 14:3" /><verse number="4" style="v" sid="EXO 14:4" />那時我要使法老的心剛硬，他會追趕他們，但我必藉著法老和他的全軍得榮耀，<char style="pn">埃及</char>人就知道我是耶和華。」於是<char style="pn">以色列</char>子孫就這樣做了。<verse eid="EXO 14:4" /></para>
  <para style="s">埃及人追趕以色列人</para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5" />有人向<char style="pn">埃及</char>王報告<char style="pn">以色列</char>百姓逃走了；法老和他的臣僕就對<char style="pn">以色列</char>百姓改變了心意，說：「我們做的這是什麼呢？居然讓<char style="pn">以色列</char>人走，不再服事我們。」 <verse eid="EXO 14:5" /><verse number="6" style="v" sid="EXO 14:6" />於是法老備好他的戰車，帶著他的軍隊<note caller="+" style="f"><char style="fr" closed="false">14:6 </char><char style="ft" closed="false">軍隊——原文直譯「子民」。</char></note>一起去， <verse eid="EXO 14:6" /><verse number="7" style="v" sid="EXO 14:7" />又帶著六百輛精選的戰車和<char style="pn">埃及</char>其餘<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">其餘——輔助詞語。</char></note>所有的戰車，每輛戰車上都有軍官。 <verse eid="EXO 14:7" /><verse number="8" style="v" sid="EXO 14:8" />耶和華使<char style="pn">埃及</char>王法老的心剛硬，他就追趕<char style="pn">以色列</char>子孫；那時<char style="pn">以色列</char>子孫正昂然無懼地<note caller="+" style="f"><char style="fr" closed="false">14:8 </char><char style="ft" closed="false">昂然無懼地——原文直譯「高舉著手」。</char></note>出去。 <verse eid="EXO 14:8" /><verse number="9" style="v" sid="EXO 14:9" /><char style="pn">埃及</char>人追趕他們，法老所有的馬匹、戰車、馬兵和軍隊，追上了在海邊紮營的<char style="pn">以色列</char>子孫；那地方靠著<char style="pn">比哈希錄</char>，在<char style="pn">巴力洗分</char>前面。<verse eid="EXO 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 14:10" />法老逼近的時候，<char style="pn">以色列</char>子孫舉目，看哪，<char style="pn">埃及</char>人追過來了！<char style="pn">以色列</char>子孫就極其害怕，向耶和華呼求。 <verse eid="EXO 14:10" /><verse number="11" style="v" sid="EXO 14:11" />他們對<char style="pn">摩西</char>說：「難道<char style="pn">埃及</char>沒有墳墓，你就把我們帶來死在曠野嗎？你把我們從<char style="pn">埃及</char>領出來，你對我們做的這是什麼呢？ <verse eid="EXO 14:11" /><verse number="12" style="v" sid="EXO 14:12" />我們在<char style="pn">埃及</char>的時候，難道沒有對你說過『不要管我們，讓我們服事<char style="pn">埃及</char>人』這話嗎？因為服事<char style="pn">埃及</char>人總比死在曠野好。」<verse eid="EXO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 14:13" />
    <char style="pn">摩西</char>對<char style="pn">以色列</char>百姓說：「不要害怕，要站穩！看耶和華今天要為你們施行的拯救，因為你們今天所看見的<char style="pn">埃及</char>人，你們永遠不會再看見了。 <verse eid="EXO 14:13" /><verse number="14" style="v" sid="EXO 14:14" />耶和華必為你們爭戰，你們要沉默！」<verse eid="EXO 14:14" /></para>
  <para style="s">過紅海</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15" />耶和華對<char style="pn">摩西</char>說：「你為什麼向我呼求呢？你要吩咐<char style="pn">以色列</char>子孫前行。 <verse eid="EXO 14:15" /><verse number="16" style="v" sid="EXO 14:16" />你要舉起你的杖，向海伸出你的手，把海分開，讓<char style="pn">以色列</char>子孫從海中的乾地上過去。 <verse eid="EXO 14:16" /><verse number="17" style="v" sid="EXO 14:17" />而我，看哪，我要使<char style="pn">埃及</char>人的心剛硬，他們就會隨著下去。這樣，我必藉著法老、他的全軍、他的戰車和馬兵得榮耀。 <verse eid="EXO 14:17" /><verse number="18" style="v" sid="EXO 14:18" />我藉著法老、他的戰車和馬兵得榮耀的時候，<char style="pn">埃及</char>人就知道我是耶和華。」<verse eid="EXO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19" />於是，在<char style="pn">以色列</char>營地前面行走的神的使者就移動，轉到他們後面；雲柱也從他們前面移動，立在他們後面。 <verse eid="EXO 14:19" /><verse number="20" style="v" sid="EXO 14:20" />雲柱來到<char style="pn">埃及</char>營地和<char style="pn">以色列</char>營地之間，一邊是雲彩和黑暗，一邊是火<note caller="+" style="f"><char style="fr" closed="false">14:20 </char><char style="ft" closed="false">火——輔助詞語。</char></note>照亮夜間。這樣，雙方整夜沒有彼此靠近。<verse eid="EXO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21" />
    <char style="pn">摩西</char>向海伸出他的手，耶和華就用猛烈的東風颳了整整一夜，使海水退去，把海變成乾地；於是水被分開了， <verse eid="EXO 14:21" /><verse number="22" style="v" sid="EXO 14:22" /><char style="pn">以色列</char>子孫就從海中的乾地上過去，水在他們的右邊和左邊形成了牆。<verse eid="EXO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 14:23" />
    <char style="pn">埃及</char>人追趕過來，法老所有的馬匹、戰車和馬兵都隨著他們下到海中。 <verse eid="EXO 14:23" /><verse number="24" style="v" sid="EXO 14:24" />到了晨更的時候，耶和華從雲火柱中俯看<char style="pn">埃及</char>的軍隊，使<char style="pn">埃及</char>的軍隊潰亂， <verse eid="EXO 14:24" /><verse number="25" style="v" sid="EXO 14:25" />又使他們的車輪脫落，難以駕駛。<char style="pn">埃及</char>人就說：「我們從<char style="pn">以色列</char>人面前逃跑吧！因為耶和華為他們爭戰，攻擊<char style="pn">埃及</char>了。」<verse eid="EXO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 14:26" />耶和華對<char style="pn">摩西</char>說：「向海伸出你的手，使水回落淹沒<char style="pn">埃及</char>人、他們的戰車和馬兵。」 <verse eid="EXO 14:26" /><verse number="27" style="v" sid="EXO 14:27" /><char style="pn">摩西</char>就向海伸出他的手，清晨來臨的時候，海恢復了原狀；<char style="pn">埃及</char>人正迎著水逃跑，耶和華就把<char style="pn">埃及</char>人抖落在海中。 <verse eid="EXO 14:27" /><verse number="28" style="v" sid="EXO 14:28" />水一回落，就淹沒了戰車、馬兵，以及隨著<char style="pn">以色列</char>子孫下到海中的法老全軍；他們中間連一個也沒有留下。 <verse eid="EXO 14:28" /><verse number="29" style="v" sid="EXO 14:29" /><char style="pn">以色列</char>子孫卻從海中的乾地上走過，水在他們的右邊和左邊形成了牆。<verse eid="EXO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 14:30" />那一天，耶和華拯救<char style="pn">以色列</char>人脫離了<char style="pn">埃及</char>人的手；<char style="pn">以色列</char>人看見<char style="pn">埃及</char>人橫尸海邊。 <verse eid="EXO 14:30" /><verse number="31" style="v" sid="EXO 14:31" /><char style="pn">以色列</char>人看見了耶和華向<char style="pn">埃及</char>施展大能的手段，百姓就敬畏耶和華，並相信耶和華和他的僕人<char style="pn">摩西</char>。<verse eid="EXO 14:31" /></para>
  <chapter eid="EXO 14" />
  <chapter number="15" style="c" sid="EXO 15" />
  <para style="s">摩西和以色列人的歌</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1" />那時<char style="pn">摩西</char>和<char style="pn">以色列</char>子孫向耶和華唱這首歌，說：</para>
  <para style="q1" vid="EXO 15:1">「我要向耶和華歌唱，</para>
  <para style="q1" vid="EXO 15:1">因為他大大得勝，</para>
  <para style="q1" vid="EXO 15:1">他把馬匹和騎馬的都拋進海中。<verse eid="EXO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 15:2" />耶和華是我的力量、我的頌歌，</para>
  <para style="q1" vid="EXO 15:2">他也成了我的救恩。</para>
  <para style="q1" vid="EXO 15:2">這是我的神，我要讚美他；</para>
  <para style="q1" vid="EXO 15:2">他是我父親的神，我要尊崇他。<verse eid="EXO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 15:3" />耶和華是戰士，</para>
  <para style="q1" vid="EXO 15:3">耶和華是他的名。<verse eid="EXO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="EXO 15:4" />他把法老的戰車和他的軍隊扔進海中，</para>
  <para style="q1" vid="EXO 15:4">法老精選的軍官們都沉入<char style="pn">紅海</char>。<verse eid="EXO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EXO 15:5" />深淵淹沒他們，</para>
  <para style="q1" vid="EXO 15:5">他們如同石頭下沉到深處。<verse eid="EXO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EXO 15:6" />耶和華啊，你的右手顯出能力榮耀，</para>
  <para style="q1" vid="EXO 15:6">耶和華啊，你的右手擊碎仇敵！<verse eid="EXO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EXO 15:7" />你以極大的威嚴，</para>
  <para style="q1" vid="EXO 15:7">傾覆那些起來敵對你的人；</para>
  <para style="q1" vid="EXO 15:7">你發出烈怒，</para>
  <para style="q1" vid="EXO 15:7">吞噬他們如同吞噬麥稭。<verse eid="EXO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EXO 15:8" />你鼻孔的氣一出，眾水就堆聚起來，</para>
  <para style="q1" vid="EXO 15:8">流水立起如壘，</para>
  <para style="q1" vid="EXO 15:8">深水在大海中心凝結。<verse eid="EXO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EXO 15:9" />仇敵說：</para>
  <para style="q1" vid="EXO 15:9">『我要追趕，我要追上，</para>
  <para style="q1" vid="EXO 15:9">我要瓜分戰利品；</para>
  <para style="q1" vid="EXO 15:9">我的心要因攻擊他們得滿足。</para>
  <para style="q1" vid="EXO 15:9">我要拔出刀劍，</para>
  <para style="q1" vid="EXO 15:9">親手毀滅<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">毀滅——或譯作「趕出」。</char></note>他們。』<verse eid="EXO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EXO 15:10" />你的氣一吹，海就淹沒仇敵，</para>
  <para style="q1" vid="EXO 15:10">他們如同鉛沉沒在大水之中。<verse eid="EXO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="EXO 15:11" />耶和華啊，眾神明中有誰像你呢？</para>
  <para style="q1" vid="EXO 15:11">有誰像你神聖榮耀，可畏可讚，行奇妙的事呢？<verse eid="EXO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EXO 15:12" />你伸出你的右手，</para>
  <para style="q1" vid="EXO 15:12">地就吞滅他們。<verse eid="EXO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EXO 15:13" />你以你的慈愛，</para>
  <para style="q1" vid="EXO 15:13">引導你所贖回的子民；</para>
  <para style="q1" vid="EXO 15:13">你以你的力量，</para>
  <para style="q1" vid="EXO 15:13">帶領他們到你神聖的居所。<verse eid="EXO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="EXO 15:14" />眾民聽見就顫抖，</para>
  <para style="q1" vid="EXO 15:14">劇痛抓住<char style="pn">非利士</char>的居民。<verse eid="EXO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EXO 15:15" />那時<char style="pn">以東</char>的族長們惶恐，</para>
  <para style="q1" vid="EXO 15:15">戰兢抓住<char style="pn">摩押</char>的領袖們，</para>
  <para style="q1" vid="EXO 15:15">
    <char style="pn">迦南</char>所有的居民都心融膽喪。<verse eid="EXO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EXO 15:16" />恐怖和懼怕落在他們身上；</para>
  <para style="q1" vid="EXO 15:16">耶和華啊，因你膀臂的大能，</para>
  <para style="q1" vid="EXO 15:16">他們如同石頭靜寂不動，</para>
  <para style="q1" vid="EXO 15:16">直到你的子民經過，</para>
  <para style="q1" vid="EXO 15:16">直到你所買贖的子民經過！<verse eid="EXO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="EXO 15:17" />你要把他們領進去，</para>
  <para style="q1" vid="EXO 15:17">栽種在你繼業的山上，</para>
  <para style="q1" vid="EXO 15:17">耶和華啊，那是你為自己造的居所，</para>
  <para style="q1" vid="EXO 15:17">主啊，那是你的手堅立的聖所！<verse eid="EXO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 15:18" />耶和華必作王，直到永永遠遠。」<verse eid="EXO 15:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19" />法老的馬匹、他的戰車和馬兵下到海中，耶和華使海水回落淹沒他們，<char style="pn">以色列</char>子孫卻從海中的乾地上走過。 <verse eid="EXO 15:19" /><verse number="20" style="v" sid="EXO 15:20" /><char style="pn">亞倫</char>的姐姐女先知<char style="pn">米利暗</char>，手中拿著鈴鼓；所有的婦女都隨著她出去，拿著鈴鼓跳舞。 <verse eid="EXO 15:20" /><verse number="21" style="v" sid="EXO 15:21" /><char style="pn">米利暗</char>應和<char style="pn">摩西</char>和<char style="pn">以色列</char>子孫：</para>
  <para style="q1" vid="EXO 15:21">「你們要向耶和華歌唱，</para>
  <para style="q1" vid="EXO 15:21">因為他大大得勝，</para>
  <para style="q1" vid="EXO 15:21">他把馬匹和騎馬的都拋進海中。」<verse eid="EXO 15:21" /></para>
  <para style="s">苦水變甜</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22" />
    <char style="pn">摩西</char>讓<char style="pn">以色列</char>人從<char style="pn">紅海</char>起行；他們來到<char style="pn">書珥</char>曠野，在曠野中走了三天，找不到水。 <verse eid="EXO 15:22" /><verse number="23" style="v" sid="EXO 15:23" />後來他們到了<char style="pn">瑪拉</char>，卻不能喝<char style="pn">瑪拉</char>的水，因為那水苦澀。因此那地方名叫<char style="pn">瑪拉</char>。 <verse eid="EXO 15:23" /><verse number="24" style="v" sid="EXO 15:24" />百姓就向<char style="pn">摩西</char>發怨言說：「我們喝什麼呢？」 <verse eid="EXO 15:24" /><verse number="25" style="v" sid="EXO 15:25" /><char style="pn">摩西</char>向耶和華呼求，耶和華就把一棵樹指示給他。他把那樹扔進水裡，水就變甜了。</para>
  <para style="p" vid="EXO 15:25">耶和華在那裡為百姓設立了律例和法規，並在那裡試驗他們， <verse eid="EXO 15:25" /><verse number="26" style="v" sid="EXO 15:26" />說：「如果你留心聽你的神耶和華的吩咐，做他眼中看為正的事，傾聽他的誡命，遵守他一切的律例，那麼我加在<char style="pn">埃及</char>人身上的一切疾病，必不加在你身上，因為我耶和華是你的醫治者。」<verse eid="EXO 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 15:27" />後來他們到了<char style="pn">伊利姆</char>，那裡有十二股水泉和七十棵棕櫚樹，他們就在那裡的水邊紮營。<verse eid="EXO 15:27" /></para>
  <chapter eid="EXO 15" />
  <chapter number="16" style="c" sid="EXO 16" />
  <para style="s">嗎哪和鵪鶉</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1" />全體<char style="pn">以色列</char>會眾從<char style="pn">伊利姆</char>起行，在他們從<char style="pn">埃及</char>地出來後的第二個月的十五日，來到<char style="pn">伊利姆</char>和<char style="pn">西奈</char>之間<char style="pn">汛</char>的曠野。 <verse eid="EXO 16:1" /><verse number="2" style="v" sid="EXO 16:2" />全體<char style="pn">以色列</char>會眾在曠野向<char style="pn">摩西</char>和<char style="pn">亞倫</char>發怨言。 <verse eid="EXO 16:2" /><verse number="3" style="v" sid="EXO 16:3" /><char style="pn">以色列</char>子孫對他們說：「我們寧願在<char style="pn">埃及</char>地死在耶和華的手中！那時我們坐在肉鍋旁邊，吃糧吃到飽；你們卻把我們領到這曠野，要餓死這全體會眾！」<verse eid="EXO 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 16:4" />耶和華對<char style="pn">摩西</char>說：「看哪，我要從天上降下糧食給你們！子民要出去，每天撿拾每天的份額，我好試驗他們會不會遵行我的法規。 <verse eid="EXO 16:4" /><verse number="5" style="v" sid="EXO 16:5" />到了第六天，他們要把所收進來的預備好，那將是他們天天撿拾的雙倍。」<verse eid="EXO 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 16:6" />
    <char style="pn">摩西</char>和<char style="pn">亞倫</char>對所有的<char style="pn">以色列</char>子孫說：「晚上，你們就會知道是耶和華把你們從<char style="pn">埃及</char>地領出來的； <verse eid="EXO 16:6" /><verse number="7" style="v" sid="EXO 16:7" />早晨，你們就會看到耶和華的榮耀，因為耶和華聽見了你們對他的怨言。我們算什麼，你們為何向我們發怨言呢？」 <verse eid="EXO 16:7" /><verse number="8" style="v" sid="EXO 16:8" /><char style="pn">摩西</char>又說：「到了晚上，耶和華會給你們肉吃；到了早晨，他會給你們糧食吃到飽，因為耶和華聽見了你們向他所發的怨言。我們算什麼呢？你們的怨言其實不是向我們發的，而是向耶和華發的。」<verse eid="EXO 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 16:9" />
    <char style="pn">摩西</char>對<char style="pn">亞倫</char>說：「你要對全體<char style="pn">以色列</char>會眾說：『你們要近前來到耶和華的面前，因為他已經聽見了你們的怨言。』」 <verse eid="EXO 16:9" /><verse number="10" style="v" sid="EXO 16:10" /><char style="pn">亞倫</char>對全體<char style="pn">以色列</char>會眾說話的時候，他們轉向曠野，看哪，耶和華的榮耀在雲彩中顯現！<verse eid="EXO 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 16:11" />耶和華指示<char style="pn">摩西</char>說： <verse eid="EXO 16:11" /><verse number="12" style="v" sid="EXO 16:12" />「我已經聽見<char style="pn">以色列</char>子孫的怨言，你要告訴他們說：『黃昏的時候，你們會有肉吃；到了早晨，你們會有糧食得飽足。這樣你們就知道：我是耶和華你們的神。』」<verse eid="EXO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 16:13" />到了晚上，有鵪鶉飛上來，遮蓋了營地；到了早晨，營地的四圍有一層露水。 <verse eid="EXO 16:13" /><verse number="14" style="v" sid="EXO 16:14" />那一層露水蒸發之後，看哪，曠野的地面上有薄片狀的東西，薄得像地上的霜！ <verse eid="EXO 16:14" /><verse number="15" style="v" sid="EXO 16:15" /><char style="pn">以色列</char>子孫看到就彼此說：「這是什麼呢？」因為他們不知道那是什麼。</para>
  <para style="p" vid="EXO 16:15">
    <char style="pn">摩西</char>對他們說：「這就是耶和華賜給你們吃的糧食。 <verse eid="EXO 16:15" /><verse number="16" style="v" sid="EXO 16:16" />耶和華所指示的話是這樣的：『你們要按各人的食量撿拾，也要按你們各人帳篷中的人數撿收，一人一俄梅珥<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">一俄梅珥——相當於2.2公升，計量穀物的量器；本章下同。</char></note>。』」<verse eid="EXO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17" />
    <char style="pn">以色列</char>子孫就這樣做了。有人撿拾得多，有人撿拾得少； <verse eid="EXO 16:17" /><verse number="18" style="v" sid="EXO 16:18" />但他們用俄梅珥量的時候，多撿拾的沒有剩餘，少撿拾的也沒有缺少；各人都按自己的食量撿拾。 <verse eid="EXO 16:18" /><verse number="19" style="v" sid="EXO 16:19" /><char style="pn">摩西</char>對他們說：「誰都不可留下一點糧食到早晨。」 <verse eid="EXO 16:19" /><verse number="20" style="v" sid="EXO 16:20" />有些人卻沒有聽從<char style="pn">摩西</char>，把一些糧食留到早晨，那些糧食就生蟲發臭了。於是<char style="pn">摩西</char>對他們發怒。<verse eid="EXO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 16:21" />每天早晨，他們按各人的食量撿拾；太陽一熱，糧食就融化了。 <verse eid="EXO 16:21" /><verse number="22" style="v" sid="EXO 16:22" />到了第六天，他們撿拾雙倍的糧食，一人兩俄梅珥。所有的會眾領袖都來告訴<char style="pn">摩西</char>這事<note caller="+" style="f"><char style="fr" closed="false">16:22 </char><char style="ft" closed="false">這事——輔助詞語。</char></note>。 <verse eid="EXO 16:22" /><verse number="23" style="v" sid="EXO 16:23" /><char style="pn">摩西</char>就對他們說：「耶和華這樣說：『明天是完全安息的日子，是耶和華的聖安息日。今天<note caller="+" style="f"><char style="fr" closed="false">16:23 </char><char style="ft" closed="false">今天——輔助詞語。</char></note>你們要烤的就烤，要煮的就煮，所有剩餘的要留在一邊<note caller="+" style="f"><char style="fr" closed="false">16:23 </char><char style="ft" closed="false">留在一邊——原文直譯「為自己存放」。</char></note>保存到早晨。』」<verse eid="EXO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 16:24" />他們就照著<char style="pn">摩西</char>吩咐的，把剩餘的留到早晨，那些糧食既沒有發臭，裡面也沒有生蛆。 <verse eid="EXO 16:24" /><verse number="25" style="v" sid="EXO 16:25" /><char style="pn">摩西</char>說：「今天就吃這個吧，因為今天是耶和華的安息日，今天你們在田野中必找不到糧食。 <verse eid="EXO 16:25" /><verse number="26" style="v" sid="EXO 16:26" />六天你們可以撿拾糧食，但第七天是安息日，那一天不會有糧食。」<verse eid="EXO 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 16:27" />到了第七天，百姓中有些人出去撿拾，但找不到糧食。 <verse eid="EXO 16:27" /><verse number="28" style="v" sid="EXO 16:28" />耶和華對<char style="pn">摩西</char>說：「你們拒絕遵守我的誡命和訓誨，要到什麼時候呢？ <verse eid="EXO 16:28" /><verse number="29" style="v" sid="EXO 16:29" />你們看，耶和華賜給了你們安息日，因此第六天他就賜給你們兩天的糧食；第七天你們各人都要留在原處，任何人都不可離開自己的地方。」 <verse eid="EXO 16:29" /><verse number="30" style="v" sid="EXO 16:30" />於是百姓就在第七天安息了。<verse eid="EXO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31" />
    <char style="pn">以色列</char>家給這糧食起名為「嗎哪」，它像芫荽的種子，是白色的，它的味道像加蜂蜜的薄餅。 <verse eid="EXO 16:31" /><verse number="32" style="v" sid="EXO 16:32" /><char style="pn">摩西</char>說：「耶和華所指示的話是這樣的：『你們要把一俄梅珥滿滿的嗎哪保存下來給你們的世世代代，好讓他們看到我把你們從<char style="pn">埃及</char>地領出來的時候，給你們在曠野中吃的糧食。』」<verse eid="EXO 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 16:33" />
    <char style="pn">摩西</char>對<char style="pn">亞倫</char>說：「拿一個罐子，裝入滿滿一俄梅珥的嗎哪，放在耶和華面前，保存下來給你們的世世代代。」 <verse eid="EXO 16:33" /><verse number="34" style="v" sid="EXO 16:34" /><char style="pn">亞倫</char>就照著耶和華所指示<char style="pn">摩西</char>的，把嗎哪放在見證版前面，保存下來。<verse eid="EXO 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 16:35" />
    <char style="pn">以色列</char>子孫吃這嗎哪四十年，直到他們來到有人居住的地方；他們吃這嗎哪，直到他們來到<char style="pn">迦南</char>地的邊界。 <verse eid="EXO 16:35" /><verse number="36" style="v" sid="EXO 16:36" />（一俄梅珥<note caller="+" style="f"><char style="fr" closed="false">16:36 </char><char style="ft" closed="false">一俄梅珥——相當於2.2公升。</char></note>是一伊法<note caller="+" style="f"><char style="fr" closed="false">16:36 </char><char style="ft" closed="false">一伊法——相當於22公升。</char></note>的十分之一。）<verse eid="EXO 16:36" /></para>
  <chapter eid="EXO 16" />
  <chapter number="17" style="c" sid="EXO 17" />
  <para style="s">磐石出水</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1" />全體<char style="pn">以色列</char>會眾照著耶和華的吩咐，從<char style="pn">汛</char>的曠野起行，一程一程地前行。他們在<char style="pn">利菲迪姆</char>紮營，但在那裡百姓沒有水喝。 <verse eid="EXO 17:1" /><verse number="2" style="v" sid="EXO 17:2" />於是百姓就與<char style="pn">摩西</char>爭鬧，說：「給我們水喝！」</para>
  <para style="p" vid="EXO 17:2">
    <char style="pn">摩西</char>對他們說：「你們為什麼與我爭鬧呢？你們為什麼試探耶和華呢？」<verse eid="EXO 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 17:3" />百姓在那裡口渴要水喝，他們就向<char style="pn">摩西</char>發怨言說：「你為什麼把我們從<char style="pn">埃及</char>帶上來，使我們和我們的兒女以及我們的牲畜都乾渴而死呢？」<verse eid="EXO 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 17:4" />
    <char style="pn">摩西</char>向耶和華呼求，說：「我對這百姓要怎麼辦呢？再過不久他們就要用石頭砸死我了。」<verse eid="EXO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5" />耶和華對<char style="pn">摩西</char>說：「你從子民的面前過去，帶上<char style="pn">以色列</char>的幾個長老，手中拿著你曾擊打<char style="pn">尼羅</char>河的那根杖，去吧！ <verse eid="EXO 17:5" /><verse number="6" style="v" sid="EXO 17:6" />看哪，我必在<char style="pn">何烈</char>山的磐石那裡，站在你面前！你要擊打那磐石，水會從磐石中流出來，子民就有水喝了。」<char style="pn">摩西</char>就在<char style="pn">以色列</char>的長老們眼前這樣做了。 <verse eid="EXO 17:6" /><verse number="7" style="v" sid="EXO 17:7" />他給那地方起名為<char style="pn">瑪撒</char><note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="ft" closed="false">瑪撒——意思是「試探」。</char></note>，又叫<char style="pn">米利巴</char><note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="ft" closed="false">米利巴——意思是「爭鬧」。</char></note>，因為<char style="pn">以色列</char>子孫在那裡爭鬧，又因為他們試探耶和華，說：「耶和華到底在不在我們當中？」<verse eid="EXO 17:7" /></para>
  <para style="s">打敗亞瑪力人</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8" />後來，<char style="pn">亞瑪力</char>人來了，在<char style="pn">利菲迪姆</char>與<char style="pn">以色列</char>人爭戰。 <verse eid="EXO 17:8" /><verse number="9" style="v" sid="EXO 17:9" /><char style="pn">摩西</char>對<char style="pn">約書亞</char>說：「你為我們挑選一些人，出去與<char style="pn">亞瑪力</char>人爭戰。明天我會站在岡陵頂上，手中拿著神的杖。」<verse eid="EXO 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 17:10" />
    <char style="pn">約書亞</char>就照著<char style="pn">摩西</char>對他所說的做了，與<char style="pn">亞瑪力</char>人爭戰；而<char style="pn">摩西</char>、<char style="pn">亞倫</char>和<char style="pn">戶珥</char>上到岡陵頂。 <verse eid="EXO 17:10" /><verse number="11" style="v" sid="EXO 17:11" /><char style="pn">摩西</char>舉起手的時候，<char style="pn">以色列</char>人就占優勢；他放下手的時候，<char style="pn">亞瑪力</char>人就占優勢。 <verse eid="EXO 17:11" /><verse number="12" style="v" sid="EXO 17:12" /><char style="pn">摩西</char>的雙手沉重，他們就搬來一塊石頭，放在<char style="pn">摩西</char>下面，他就坐在上面。<char style="pn">亞倫</char>和<char style="pn">戶珥</char>扶著<char style="pn">摩西</char>的手，一個在這邊，一個在那邊，他的雙手就穩住，直到日落。 <verse eid="EXO 17:12" /><verse number="13" style="v" sid="EXO 17:13" />這樣，<char style="pn">約書亞</char>用刀劍擊敗了<char style="pn">亞瑪力</char>王和他的百姓。<verse eid="EXO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14" />耶和華對<char style="pn">摩西</char>說：「你要把以下這話寫在書卷上作為記念，並要讀給<char style="pn">約書亞</char>聽：我必把<char style="pn">亞瑪力</char>的名號從天下全然抹掉。」<verse eid="EXO 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 17:15" />
    <char style="pn">摩西</char>築了一座祭壇，給它起名為「耶和華尼西<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">耶和華尼西——意思是「耶和華是我的旗幟」。</char></note>」； <verse eid="EXO 17:15" /><verse number="16" style="v" sid="EXO 17:16" />又說：「因為我的手向耶和華的寶座舉起<note caller="+" style="f"><char style="fr" closed="false">17:16 </char><char style="ft" closed="false">我的手向耶和華的寶座舉起——或譯作「他的手放在耶和華的寶座上起了誓」。</char></note>，世世代代耶和華必與<char style="pn">亞瑪力</char>人戰爭。」<verse eid="EXO 17:16" /></para>
  <chapter eid="EXO 17" />
  <chapter number="18" style="c" sid="EXO 18" />
  <para style="s">耶特羅訪問摩西</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1" />
    <char style="pn">摩西</char>的岳父<char style="pn">米甸</char>祭司<char style="pn">耶特羅</char>，聽見了神為<char style="pn">摩西</char>和神的子民<char style="pn">以色列</char>所做的一切，就是耶和華怎樣把<char style="pn">以色列</char>人從<char style="pn">埃及</char>領出來的事。<verse eid="EXO 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 18:2" />
    <char style="pn">摩西</char>的岳父<char style="pn">耶特羅</char>帶來了<char style="pn">摩西</char>的妻子<char style="pn">西坡拉</char>——她先前被送回家； <verse eid="EXO 18:2" /><verse number="3" style="v" sid="EXO 18:3" /><char style="pn">耶特羅</char>也帶來了<char style="pn">西坡拉</char>的兩個兒子，一個名叫<char style="pn">革順</char>，因為<char style="pn">摩西</char>說「我在外邦之地作了寄居者」； <verse eid="EXO 18:3" /><verse number="4" style="v" sid="EXO 18:4" />一個名叫<char style="pn">以利以謝</char>，因為<char style="pn">摩西</char>說「我父親的神是我的幫助者，他解救我脫離了法老的刀劍」。<verse eid="EXO 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 18:5" />
    <char style="pn">摩西</char>的岳父<char style="pn">耶特羅</char>與<char style="pn">摩西</char>的兩個兒子和<char style="pn">摩西</char>的妻子一同來到曠野<char style="pn">摩西</char>那裡，就是他在神的山紮營的地方。 <verse eid="EXO 18:5" /><verse number="6" style="v" sid="EXO 18:6" /><char style="pn">耶特羅</char>傳話給<char style="pn">摩西</char>說<note caller="+" style="f"><char style="fr" closed="false">18:6 </char><char style="ft" closed="false">傳話給摩西說——原文直譯「對摩西說」。</char></note>：「我，你的岳父<char style="pn">耶特羅</char>，與你的妻子和她的兩個兒子就要來到你這裡了。」<verse eid="EXO 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 18:7" />
    <char style="pn">摩西</char>就出來迎接他的岳父，向他下拜，親吻他，彼此問安，然後一起進入了帳篷。 <verse eid="EXO 18:7" /><verse number="8" style="v" sid="EXO 18:8" /><char style="pn">摩西</char>向他的岳父講述了耶和華為<char style="pn">以色列</char>的緣故對法老和<char style="pn">埃及</char>所做的一切事，以及<char style="pn">以色列</char>人在路上所遭遇的一切艱難，並耶和華怎樣解救了他們。<verse eid="EXO 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 18:9" />
    <char style="pn">耶特羅</char>因耶和華為<char style="pn">以色列</char>所做的一切美事，就是解救他們脫離<char style="pn">埃及</char>人之手的事，而歡樂喜悅。 <verse eid="EXO 18:9" /><verse number="10" style="v" sid="EXO 18:10" /><char style="pn">耶特羅</char>說：「耶和華是當受頌讚的！他解救你們脫離<char style="pn">埃及</char>人的手和法老的手，把這百姓從<char style="pn">埃及</char>人的手下解救出來。 <verse eid="EXO 18:10" /><verse number="11" style="v" sid="EXO 18:11" />現在，通過<char style="pn">埃及</char>人狂傲對待這百姓的後果，我知道耶和華偉大，超越一切神明。」<verse eid="EXO 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 18:12" />
    <char style="pn">摩西</char>的岳父<char style="pn">耶特羅</char>帶來了燔祭和祭物獻給神；<char style="pn">亞倫</char>和<char style="pn">以色列</char>所有的長老都來了，與<char style="pn">摩西</char>的岳父在神面前吃飯。<verse eid="EXO 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13" />第二天，<char style="pn">摩西</char>坐著為百姓施行審斷，百姓從早到晚站在<char style="pn">摩西</char>周圍。 <verse eid="EXO 18:13" /><verse number="14" style="v" sid="EXO 18:14" /><char style="pn">摩西</char>的岳父看見<char style="pn">摩西</char>為百姓所做的一切，就說：「你為百姓做的這是什麼事呢？為什麼你獨自坐著，而全體民眾從早到晚站在你周圍呢？」<verse eid="EXO 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 18:15" />
    <char style="pn">摩西</char>對他的岳父說：「這是因為百姓到我這裡來求問神。 <verse eid="EXO 18:15" /><verse number="16" style="v" sid="EXO 18:16" />他們之間發生了什麼事，就會到我這裡來，我就在雙方之間施行審斷，使他們明白神的律例和訓誨。」<verse eid="EXO 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 18:17" />
    <char style="pn">摩西</char>的岳父對他說：「你這樣做不好。 <verse eid="EXO 18:17" /><verse number="18" style="v" sid="EXO 18:18" />你和這些與你在一起的百姓都一定會疲憊不堪，因為這事對你太沉重，你獨自一人做不了。 <verse eid="EXO 18:18" /><verse number="19" style="v" sid="EXO 18:19" />現在你當聽從我的話，我給你提個建議，願神與你同在！你要在神的面前代表百姓，把他們的事帶到神那裡； <verse eid="EXO 18:19" /><verse number="20" style="v" sid="EXO 18:20" />你要用律例和訓誨警誡他們，使他們明白他們當走的路和當做的事； <verse eid="EXO 18:20" /><verse number="21" style="v" sid="EXO 18:21" />你要從全體民眾當中選出有才能的、敬畏神的、誠實的、恨惡私利的人，立他們作千夫長、百夫長、五十夫長、十夫長來管理百姓， <verse eid="EXO 18:21" /><verse number="22" style="v" sid="EXO 18:22" />讓他們隨時為百姓施行審斷——所有的大事都帶到你這裡來，而所有的小事都由他們自己審斷。這樣，你就可以輕省些，他們也可以與你一起分擔。 <verse eid="EXO 18:22" /><verse number="23" style="v" sid="EXO 18:23" />如果你這樣做，神也這樣吩咐你，你就能站立得住，全體民眾也能平安地回到自己的地方。」<verse eid="EXO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24" />
    <char style="pn">摩西</char>聽從了他岳父的話，照著他所說的一切做了。 <verse eid="EXO 18:24" /><verse number="25" style="v" sid="EXO 18:25" /><char style="pn">摩西</char>從全體<char style="pn">以色列</char>人中挑選了有才能的人，立他們作百姓的首領，作千夫長、百夫長、五十夫長、十夫長。 <verse eid="EXO 18:25" /><verse number="26" style="v" sid="EXO 18:26" />他們隨時為百姓施行審斷——難斷的事就帶到<char style="pn">摩西</char>那裡，而所有的小事都由他們自己審斷。<verse eid="EXO 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 18:27" />後來，<char style="pn">摩西</char>送走了他的岳父，他的岳父就回本地去了。<verse eid="EXO 18:27" /></para>
  <chapter eid="EXO 18" />
  <chapter number="19" style="c" sid="EXO 19" />
  <para style="s">以色列人在西奈山</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1" />
    <char style="pn">以色列</char>子孫從<char style="pn">埃及</char>地出來後的第三個月的初一<note caller="+" style="f"><char style="fr" closed="false">19:1 </char><char style="ft" closed="false">的初一——輔助詞語。</char></note>，就在那一天，他們來到<char style="pn">西奈</char>曠野。 <verse eid="EXO 19:1" /><verse number="2" style="v" sid="EXO 19:2" />他們從<char style="pn">利菲迪姆</char>起行，來到了<char style="pn">西奈</char>曠野，在曠野中紮營；<char style="pn">以色列</char>人就在那裡的山前紮了營。<verse eid="EXO 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 19:3" />
    <char style="pn">摩西</char>上到神那裡，耶和華從那山上向他呼喚說：「你要如此對<char style="pn">雅各</char>家說，如此告訴<char style="pn">以色列</char>子孫： <verse eid="EXO 19:3" /><verse number="4" style="v" sid="EXO 19:4" />『你們看見了我對<char style="pn">埃及</char>所做的事，以及我怎樣把你們背在如鷹的羽翼上，帶你們來到我這裡。 <verse eid="EXO 19:4" /><verse number="5" style="v" sid="EXO 19:5" />現在，如果你們留心聽我的聲音，遵守我的約，你們就會在萬民中作我珍貴的產業，因為全地都是屬於我的。 <verse eid="EXO 19:5" /><verse number="6" style="v" sid="EXO 19:6" />你們要歸我作祭司的國度和聖潔的國民。』這些話你要對<char style="pn">以色列</char>子孫說。」<verse eid="EXO 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 19:7" />
    <char style="pn">摩西</char>就去召來百姓的長老們，把耶和華指示他的這一切話都陳明在他們面前。 <verse eid="EXO 19:7" /><verse number="8" style="v" sid="EXO 19:8" />全體民眾一同回應說：「耶和華所說的一切，我們都會遵行。」<char style="pn">摩西</char>就把百姓的話帶回給耶和華。<verse eid="EXO 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 19:9" />耶和華對<char style="pn">摩西</char>說：「看哪，我要在厚密的雲彩中臨到你那裡，好讓子民聽見我與你說話，他們就會永遠相信你。」<char style="pn">摩西</char>把百姓的話告訴了耶和華。 <verse eid="EXO 19:9" /><verse number="10" style="v" sid="EXO 19:10" />耶和華對<char style="pn">摩西</char>說：「你到子民那裡去，今天和明天要把他們分別為聖，讓他們洗自己的衣服， <verse eid="EXO 19:10" /><verse number="11" style="v" sid="EXO 19:11" />為第三天預備好，因為第三天耶和華要在全體民眾眼前降臨在<char style="pn">西奈</char>山上。 <verse eid="EXO 19:11" /><verse number="12" style="v" sid="EXO 19:12" />你要在子民周圍定下界限，說：『你們要謹慎，不可上這山，也不可碰山的邊界。凡碰這山的，必須被處死； <verse eid="EXO 19:12" /><verse number="13" style="v" sid="EXO 19:13" />你們不可用手碰那人，必須用石頭砸死，或用箭射死；無論是牲畜還是人，都不得存活。』號角長鳴的時候，子民才可以上山。」<verse eid="EXO 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14" />
    <char style="pn">摩西</char>下了山到百姓那裡，把百姓分別為聖；他們都洗了自己的衣服。 <verse eid="EXO 19:14" /><verse number="15" style="v" sid="EXO 19:15" /><char style="pn">摩西</char>對百姓說：「你們要為第三天預備好，不要與女人親近。」<verse eid="EXO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16" />到了第三天早晨的時候，山上有雷聲、閃電和濃厚的雲彩，又有極其大的號角聲，營中的全體民眾都戰兢。 <verse eid="EXO 19:16" /><verse number="17" style="v" sid="EXO 19:17" /><char style="pn">摩西</char>把百姓從營地領出來迎接神，他們都站在山下。 <verse eid="EXO 19:17" /><verse number="18" style="v" sid="EXO 19:18" />那時整座<char style="pn">西奈</char>山都冒煙，因為耶和華在火中降臨到山上；山的濃煙上騰，像窯爐的煙那樣，整座山都大大震動。 <verse eid="EXO 19:18" /><verse number="19" style="v" sid="EXO 19:19" />號角聲越來越大，<char style="pn">摩西</char>說話，神就在雷聲中回應他。<verse eid="EXO 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 19:20" />耶和華降臨在<char style="pn">西奈</char>山，臨到山頂上。耶和華呼喚<char style="pn">摩西</char>上山頂，<char style="pn">摩西</char>就上去了。 <verse eid="EXO 19:20" /><verse number="21" style="v" sid="EXO 19:21" />耶和華對<char style="pn">摩西</char>說：「你下去警誡子民，免得他們闖過界限到耶和華這裡來看，以致他們中間有許多人滅亡<note caller="+" style="f"><char style="fr" closed="false">19:21 </char><char style="ft" closed="false">滅亡——原文直譯「倒下」。</char></note>； <verse eid="EXO 19:21" /><verse number="22" style="v" sid="EXO 19:22" />又告誡那些接近耶和華的祭司們把自己分別為聖，免得耶和華的怒氣<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="ft" closed="false">的怒氣——輔助詞語。</char></note>向他們發作。」<verse eid="EXO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23" />
    <char style="pn">摩西</char>對耶和華說：「百姓不能上<char style="pn">西奈</char>山，因為你已經警誡了我們，說：『要為這座山定下界限，把它分別為聖。』」 <verse eid="EXO 19:23" /><verse number="24" style="v" sid="EXO 19:24" />耶和華對他說：「你下去，與<char style="pn">亞倫</char>一起上來；但祭司們和子民不可闖過界限上到耶和華這裡，免得耶和華的怒氣<note caller="+" style="f"><char style="fr" closed="false">19:24 </char><char style="ft" closed="false">的怒氣——輔助詞語。</char></note>向他們發作。」 <verse eid="EXO 19:24" /><verse number="25" style="v" sid="EXO 19:25" />於是，<char style="pn">摩西</char>下到百姓那裡去告訴他們。<verse eid="EXO 19:25" /></para>
  <chapter eid="EXO 19" />
  <chapter number="20" style="c" sid="EXO 20" />
  <para style="s">十誡</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1" />神吩咐了以下這一切話，說：<verse eid="EXO 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 20:2" />「我是耶和華你的神，是把你從<char style="pn">埃及</char>地、從為奴之家領出來的那一位。 <verse eid="EXO 20:2" /><verse number="3" style="v" sid="EXO 20:3" />除我以外，你不可有別的神。<verse eid="EXO 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EXO 20:4" />不可為自己造偶像<note caller="+" style="f"><char style="fr" closed="false">20:4 </char><char style="ft" closed="false">偶像——或譯作「雕像」。</char></note>，不可造上天、下地和地底下水中之物的任何形象。 <verse eid="EXO 20:4" /><verse number="5" style="v" sid="EXO 20:5" />不可向它們下拜，也不可服事它們，因為我耶和華你的神是嫉憤的神。恨我的人，我必懲罰他們的罪孽，從父到子，直到三代、四代； <verse eid="EXO 20:5" /><verse number="6" style="v" sid="EXO 20:6" />愛我並遵守我誡命的人，我必向他們施慈愛，直到千代。<verse eid="EXO 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EXO 20:7" />不可妄稱你神耶和華的名，因為妄稱耶和華名的人，耶和華必不讓他免於罪罰。<verse eid="EXO 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EXO 20:8" />要記念安息日，把它分別為聖。 <verse eid="EXO 20:8" /><verse number="9" style="v" sid="EXO 20:9" />六天你要勞碌，做你一切工作； <verse eid="EXO 20:9" /><verse number="10" style="v" sid="EXO 20:10" />但第七日是你神耶和華的安息日，你和你的兒女、僕婢，你的牲畜，以及你城裡的寄居者，都不可做任何工作。 <verse eid="EXO 20:10" /><verse number="11" style="v" sid="EXO 20:11" />因為六日中耶和華造了諸天、大地、海和其中的萬有，在第七日他就安息了，所以耶和華祝福安息日，把它分別為聖。<verse eid="EXO 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EXO 20:12" />要孝敬父母，使你的日子在你神耶和華所賜給你的地上長久。<verse eid="EXO 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EXO 20:13" />不可殺人。<verse eid="EXO 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EXO 20:14" />不可通姦。<verse eid="EXO 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EXO 20:15" />不可偷竊。<verse eid="EXO 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EXO 20:16" />不可作假見證指證你的鄰人。<verse eid="EXO 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EXO 20:17" />不可貪愛你鄰人的房屋，不可貪愛你鄰人的妻子、僕婢、牛驢，以及任何屬於你鄰人的東西。」<verse eid="EXO 20:17" /></para>
  <para style="s">全體民眾顫抖</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18" />全體民眾都聽見<note caller="+" style="f"><char style="fr" closed="false">20:18 </char><char style="ft" closed="false">聽見——輔助詞語。</char></note>雷聲和號角聲，看見閃電和山上冒煙；百姓看見了就顫抖，遠遠地站著。 <verse eid="EXO 20:18" /><verse number="19" style="v" sid="EXO 20:19" />他們對<char style="pn">摩西</char>說：「你向我們說話吧，我們會聽；不要讓神向我們說話，免得我們死。」<verse eid="EXO 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 20:20" />
    <char style="pn">摩西</char>對百姓說：「不要害怕，因為神來臨是要試驗你們，好使你們常存對他的敬畏，不致犯罪。」 <verse eid="EXO 20:20" /><verse number="21" style="v" sid="EXO 20:21" />百姓就遠遠地站著，<char style="pn">摩西</char>卻接近神所在的幽暗之中。<verse eid="EXO 20:21" /></para>
  <para style="s">築壇的條例</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22" />耶和華對<char style="pn">摩西</char>說：「你要對<char style="pn">以色列</char>子孫如此說：『你們看見了我從天上與你們說話。 <verse eid="EXO 20:22" /><verse number="23" style="v" sid="EXO 20:23" />你們不可造別的神<note caller="+" style="f"><char style="fr" closed="false">20:23 </char><char style="ft" closed="false">別的神——輔助詞語。</char></note>與我並列——不可為自己造金銀神像。<verse eid="EXO 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 20:24" />「『你要為我造一座土祭壇，把你的燔祭、平安祭、羊和牛獻在其上。在我使人記念我名的每個地方，我都會來到你那裡祝福你。 <verse eid="EXO 20:24" /><verse number="25" style="v" sid="EXO 20:25" />如果你為我造一座石祭壇，不可用鑿過的石頭來築，因為你在石頭上一動鑿刀，就玷汙了石頭。 <verse eid="EXO 20:25" /><verse number="26" style="v" sid="EXO 20:26" />你不可用臺階登上我的祭壇，免得在其上顯露你的下體。』<verse eid="EXO 20:26" /></para>
  <chapter eid="EXO 20" />
  <chapter number="21" style="c" sid="EXO 21" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1" />「以下是你要在百姓面前立的法規：<verse eid="EXO 21:1" /></para>
  <para style="s">對待奴僕的條例</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 21:2" />「如果你買了一個<char style="pn">希伯來</char>奴僕，他要服事你六年，第七年他可以作為自由人無償離去。 <verse eid="EXO 21:2" /><verse number="3" style="v" sid="EXO 21:3" />如果他單身來，就可以單身離去；如果他是有婦之夫，他的妻子也可以與他一同離去。 <verse eid="EXO 21:3" /><verse number="4" style="v" sid="EXO 21:4" />如果他的主人給了他妻子，妻子又為他生了兒子或女兒，妻子和孩子就要歸主人，而他要單身離去。<verse eid="EXO 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 21:5" />「如果那奴僕明確地說『我愛我的主人、我的妻子兒女，我不願意自由離去』， <verse eid="EXO 21:5" /><verse number="6" style="v" sid="EXO 21:6" />他的主人就要把他帶到神<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="ft" closed="false">神——或譯作「審判官」。</char></note>面前，然後帶他到門前或門框那裡；他的主人要用錐子為他穿耳洞，他就要永遠服事主人。<verse eid="EXO 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7" />「如果有人把自己的女兒賣為女僕，女僕不可像男僕那樣離去。 <verse eid="EXO 21:7" /><verse number="8" style="v" sid="EXO 21:8" />如果她的主人選定她歸自己，後來卻不喜歡她，就要讓她贖身；主人既然對她失信，就沒有權力把她賣給外邦人。 <verse eid="EXO 21:8" /><verse number="9" style="v" sid="EXO 21:9" />如果主人選定她歸自己的兒子，就要照著待女兒的慣例對待她。 <verse eid="EXO 21:9" /><verse number="10" style="v" sid="EXO 21:10" />如果主人為自己另娶一個女人，不可減少原先那女人的食物、衣服和房事。 <verse eid="EXO 21:10" /><verse number="11" style="v" sid="EXO 21:11" />如果主人不為她做這三件事，她就可以無償離去，不用付贖金<note caller="+" style="f"><char style="fr" closed="false">21:11 </char><char style="ft" closed="false">贖金——原文直譯「銀子」。</char></note>。<verse eid="EXO 21:11" /></para>
  <para style="s">賠償傷害的條例</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12" />「打人致死的，必須被處死； <verse eid="EXO 21:12" /><verse number="13" style="v" sid="EXO 21:13" />但如果不是預謀殺人，而是神使那人落在他的手中，我就會給你指定一個地方，讓他可以逃到那裡。 <verse eid="EXO 21:13" /><verse number="14" style="v" sid="EXO 21:14" />如果有人蓄意針對他的鄰人，用詭計殺死他，你即使從我的祭壇那裡，也要把他抓去處死。<verse eid="EXO 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 21:15" />「打父母的，必須被處死。<verse eid="EXO 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 21:16" />「拐帶人口的，無論是把人賣了，或是把人留在手中，都必須被處死。<verse eid="EXO 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 21:17" />「詛咒父母的，必須被處死。<verse eid="EXO 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 21:18" />「如果人彼此相爭，一個用石頭或拳頭打另一個，被打的沒有死，而是躺在床上， <verse eid="EXO 21:18" /><verse number="19" style="v" sid="EXO 21:19" />後來他如果能起來用拐杖出外行走，那打他的就免於罪罰，但要賠償他誤工的損失，並負責他徹底痊癒。<verse eid="EXO 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 21:20" />「如果有人用棍打他的男僕或女僕，以致奴僕當場<note caller="+" style="f"><char style="fr" closed="false">21:20 </char><char style="ft" closed="false">當場——輔助詞語。</char></note>死在他的手下，他就必定受報應； <verse eid="EXO 21:20" /><verse number="21" style="v" sid="EXO 21:21" />但如果奴僕還挺了一兩天，那人就不會受報應，因為奴僕是他的財產<note caller="+" style="f"><char style="fr" closed="false">21:21 </char><char style="ft" closed="false">財產——原文直譯「銀子」。</char></note>。<verse eid="EXO 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 21:22" />「如果人彼此打架，傷到孕婦，以致她早產，但沒有其他損傷，那傷她的就必須照著那婦人的丈夫所要求的受懲罰，按審判官所判的來賠償； <verse eid="EXO 21:22" /><verse number="23" style="v" sid="EXO 21:23" />但如果有其他損傷，就要以命償命， <verse eid="EXO 21:23" /><verse number="24" style="v" sid="EXO 21:24" />以眼還眼，以牙還牙，以手還手，以腳還腳， <verse eid="EXO 21:24" /><verse number="25" style="v" sid="EXO 21:25" />以灼還灼，以傷還傷，以打還打。<verse eid="EXO 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 21:26" />「如果有人打他男僕的眼睛或女僕的眼睛，以致毀了一只眼睛，就要因眼睛的緣故讓奴僕走，作自由人。 <verse eid="EXO 21:26" /><verse number="27" style="v" sid="EXO 21:27" />如果有人打掉他男僕的牙齒或女僕的牙齒，就要因牙齒的緣故讓奴僕走，作自由人。<verse eid="EXO 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28" />「如果有牛頂男人或女人，以致人死了，那牛就必須用石頭砸死，牠的肉也不可以吃，不過牛的主人可以算為無罪； <verse eid="EXO 21:28" /><verse number="29" style="v" sid="EXO 21:29" />但如果那牛向來頂人，牠的主人也被告誡過，卻沒有把牛看好，以致牛把男人或女人頂死了，那牛就要用石頭砸死，牠的主人也要被處死。 <verse eid="EXO 21:29" /><verse number="30" style="v" sid="EXO 21:30" />如果他被要求了贖價，他就要照著所要求的來付上他性命的贖價。 <verse eid="EXO 21:30" /><verse number="31" style="v" sid="EXO 21:31" />牛無論頂了男孩<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="ft" closed="false">男孩——原文直譯「兒子」。</char></note>或頂了女孩<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="ft" closed="false">女孩——原文直譯「女兒」。</char></note>，都要照著這條規定處置牠的主人。 <verse eid="EXO 21:31" /><verse number="32" style="v" sid="EXO 21:32" />如果牛頂了男僕或女僕，牠的主人就要給奴僕的主人三十謝克爾<note caller="+" style="f"><char style="fr" closed="false">21:32 </char><char style="ft" closed="false">三十謝克爾——相當於342公克。1謝克爾=11.4公克。</char></note>銀子，而那牛要用石頭砸死。<verse eid="EXO 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 21:33" />「如果有人敞開坑口，或是挖了坑卻沒有遮蓋坑口，以致有牛或驢掉進裡面， <verse eid="EXO 21:33" /><verse number="34" style="v" sid="EXO 21:34" />那坑的主人就要賠償，付銀子給牲畜的主人，而死牲畜就歸自己。<verse eid="EXO 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 21:35" />「如果有人的牛傷了他鄰人的牛，以致鄰人的牛死了，就要把活牛賣了，平分銀子，也要平分死牛； <verse eid="EXO 21:35" /><verse number="36" style="v" sid="EXO 21:36" />但如果早已知道那牛向來頂人，牠的主人卻沒有把牛看好，牠的主人就必須以牛賠牛，而死牛就歸自己。<verse eid="EXO 21:36" /></para>
  <chapter eid="EXO 21" />
  <chapter number="22" style="c" sid="EXO 22" />
  <para style="s">保障個人財產的條例</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1" />「如果有人偷了牛或羊，並且把牠宰了或賣了，就要以五牛賠一牛，以四羊賠一羊。 <verse eid="EXO 22:1" /><verse number="2" style="v" sid="EXO 22:2" />如果竊賊潛入時被發現，被打致死，那打他的就沒有殺人流血的罪； <verse eid="EXO 22:2" /><verse number="3" style="v" sid="EXO 22:3" />但如果那時太陽已經升起了，那打他的就有殺人流血的罪。竊賊必須賠償；如果他一無所有，就要被賣，來賠償所偷的； <verse eid="EXO 22:3" /><verse number="4" style="v" sid="EXO 22:4" />如果所偷的，無論是牛，是驢，或是羊，確實被發現在他的手中還活著，他就要雙倍賠償。<verse eid="EXO 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 22:5" />「如果有人在田地裡或葡萄園中放牧，任憑自己的家畜到別人的田地吃食，他就必須用自己田地裡最好的，或自己葡萄園中最好的來賠償。<verse eid="EXO 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 22:6" />「如果有火燃起，蔓延到荊棘，以致吞噬了堆積的禾捆、未收割的莊稼，或是田地，那點火的必須賠償。<verse eid="EXO 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 22:7" />「如果有人把銀子或物品托給他的鄰人看管，東西卻從那人的家裡被偷走，當竊賊被抓到了，竊賊就要雙倍賠償； <verse eid="EXO 22:7" /><verse number="8" style="v" sid="EXO 22:8" />如果找不到竊賊，那家的主人就要被帶到神<note caller="+" style="f"><char style="fr" closed="false">22:8 </char><char style="ft" closed="false">神——或譯作「審判官」；下節同。</char></note>面前，看他是否伸手拿了他鄰人的財產。 <verse eid="EXO 22:8" /><verse number="9" style="v" sid="EXO 22:9" />任何占有行為<note caller="+" style="f"><char style="fr" closed="false">22:9 </char><char style="ft" closed="false">占有行為——原文直譯「過犯」。</char></note>的案件，無論有關牛、驢、羊、衣裳，或任何失物，如果有一方說『這是我的』，他們兩個人的案件就要帶到神面前，神定為有罪的那人，要給他的鄰人雙倍賠償。<verse eid="EXO 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 22:10" />「如果有人把驢、牛、羊，或任何牲畜托給他的鄰人看管，牲畜或死，或受傷，或丟失<note caller="+" style="f"><char style="fr" closed="false">22:10 </char><char style="ft" closed="false">丟失——原文直譯「被搶走」。</char></note>，而沒有人看見， <verse eid="EXO 22:10" /><verse number="11" style="v" sid="EXO 22:11" />他們兩個人就要在耶和華面前起誓，表明那看管的沒有伸手拿他鄰人的財產。如果牲畜的主人接受了，就不用賠償； <verse eid="EXO 22:11" /><verse number="12" style="v" sid="EXO 22:12" />但如果牲畜確實從看管的那裡被偷走了，看管的就要給牲畜的主人賠償； <verse eid="EXO 22:12" /><verse number="13" style="v" sid="EXO 22:13" />而如果牲畜確實是被野獸咬死了，他就要把被咬死的牲畜帶來作證，他就不用賠償了。<verse eid="EXO 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 22:14" />「如果有人向他的鄰人借牲畜，牲畜或受傷或死，牠的主人沒有在場，那借的人就必須賠償； <verse eid="EXO 22:14" /><verse number="15" style="v" sid="EXO 22:15" />但如果牠的主人在場，那借的人就不用賠償。如果牲畜是租來的，賠償已經包含在租金內了<note caller="+" style="f"><char style="fr" closed="false">22:15 </char><char style="ft" closed="false">賠償已經包含在租金內了——原文直譯「牲畜就是為租金而來的」。</char></note>。<verse eid="EXO 22:15" /></para>
  <para style="s">保障社會公義的條例</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16" />「如果有人引誘還沒有訂婚的處女，與她同睡，那人就必須交付聘禮，娶她為妻。 <verse eid="EXO 22:16" /><verse number="17" style="v" sid="EXO 22:17" />如果她的父親堅決不肯把女兒嫁給他，他就要照著處女的聘禮交付<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">交付——原文直譯「稱出」。</char></note>銀子。<verse eid="EXO 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 22:18" />「不可讓行巫術的女人存活。<verse eid="EXO 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 22:19" />「凡與動物交合的，都必須處死。<verse eid="EXO 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 22:20" />「不僅僅向耶和華獻祭，還向別的神明獻祭的，要被滅絕淨盡。<verse eid="EXO 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 22:21" />「不可欺負寄居者，也不可壓迫他，因為你們在<char style="pn">埃及</char>地也作過寄居者。<verse eid="EXO 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 22:22" />「不可苦待任何寡婦或孤兒。 <verse eid="EXO 22:22" /><verse number="23" style="v" sid="EXO 22:23" />如果你確實苦待了他們，一旦他們向我迫切地呼求，我就必定垂聽他們的呼聲， <verse eid="EXO 22:23" /><verse number="24" style="v" sid="EXO 22:24" />怒氣發作，用刀殺你們；這樣，你們的妻子就會成為寡婦，你們的兒子會成為孤兒。<verse eid="EXO 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 22:25" />「如果你借錢給我的子民，給你們中間的困苦人，不可像債主那樣對待他，不可向他收取利息。<verse eid="EXO 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 22:26" />「如果你確實拿了你鄰人的衣裳作抵押，就要在日落之前把衣裳還給他； <verse eid="EXO 22:26" /><verse number="27" style="v" sid="EXO 22:27" />因為那是他唯一的遮蓋，是他遮身的衣服；否則他蓋什麼睡覺呢？如果他向我呼求，我就會垂聽，因為我是有恩惠的。<verse eid="EXO 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 22:28" />「不可咒罵神，也不可咒罵你百姓中的領袖。<verse eid="EXO 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 22:29" />「你從豐收的五穀和滿溢的榨池中拿來奉獻的，不可遲延獻上。你兒子們中頭生的，要獻給我； <verse eid="EXO 22:29" /><verse number="30" style="v" sid="EXO 22:30" />你也要照樣對待你的牛和羊：讓牠與牠的母親在一起七天，第八天要把牠獻給我。<verse eid="EXO 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 22:31" />「你們要歸我作聖潔的人，因此你們不可吃田野中被咬死動物的肉，要把牠扔給狗。<verse eid="EXO 22:31" /></para>
  <chapter eid="EXO 22" />
  <chapter number="23" style="c" sid="EXO 23" />
  <para style="s">公義和公正的條例</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1" />「不可散布虛假的傳聞；不可與惡人聯手作惡毒的見證人。<verse eid="EXO 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 23:2" />「不可隨眾行惡；不可在爭訟的事上隨眾偏行，作證屈枉公義<note caller="+" style="f"><char style="fr" closed="false">23:2 </char><char style="ft" closed="false">公義——輔助詞語。</char></note>， <verse eid="EXO 23:2" /><verse number="3" style="v" sid="EXO 23:3" />也不可在爭訟的事上偏袒貧弱者。<verse eid="EXO 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4" />「如果你遇見仇敵的牛或驢迷失，就必須把牠帶回來給你的仇敵。<verse eid="EXO 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 23:5" />「如果你看見恨你之人的驢被壓臥在重擔之下，就不可置之不理留給驢的主人，必須與他一起挪開重擔。<verse eid="EXO 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 23:6" />「不可在貧窮人的爭訟上屈枉公正。 <verse eid="EXO 23:6" /><verse number="7" style="v" sid="EXO 23:7" />要遠離虛假的控告，不可殺死無辜人和義人，因為我不會稱惡人為義。 <verse eid="EXO 23:7" /><verse number="8" style="v" sid="EXO 23:8" />不可收取賄賂，因為賄賂會使明眼人眼瞎，又會歪曲義人的話。 <verse eid="EXO 23:8" /><verse number="9" style="v" sid="EXO 23:9" />不可壓迫寄居者，因為你們在<char style="pn">埃及</char>地作過寄居者，寄居者的心你們是知道的。<verse eid="EXO 23:9" /></para>
  <para style="s">安息和節期的條例</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10" />「六年你要耕種田地，收聚田地的出產， <verse eid="EXO 23:10" /><verse number="11" style="v" sid="EXO 23:11" />但第七年要讓田地歇息休耕，好使你百姓中的貧窮人有吃的；他們所剩下的，田野的走獸可以吃。你也要照樣對待你的葡萄園和橄欖園。<verse eid="EXO 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12" />「六天你要做工，但第七天要安息，好使你的牛和驢安歇，也使你女僕的兒子和寄居者恢復精力。<verse eid="EXO 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 23:13" />「我對你們所說的一切，你們都要謹守。別的神明的名號，你們不可提起，也不可讓人從你的口中聽到。<verse eid="EXO 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14" />「一年三次，你要向我守節期。 <verse eid="EXO 23:14" /><verse number="15" style="v" sid="EXO 23:15" />要守無酵節，照著我吩咐你的，在亞筆月所定的日期吃無酵餅七天，因為你是在這個月從<char style="pn">埃及</char>出來的；誰也不可空手朝見我。 <verse eid="EXO 23:15" /><verse number="16" style="v" sid="EXO 23:16" />要守收割節，就是收割你在田地播種、勞碌所得的初熟之物的節期。要守收藏節，就是在年底、你從田地收聚你勞碌所得之物的時候。 <verse eid="EXO 23:16" /><verse number="17" style="v" sid="EXO 23:17" />一年三次，你所有的男子都要朝見主耶和華。<verse eid="EXO 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 23:18" />「不可把我祭物的血與有酵之物一起獻祭，也不可使我節期祭牲<note caller="+" style="f"><char style="fr" closed="false">23:18 </char><char style="ft" closed="false">祭牲——輔助詞語。</char></note>的脂肪過夜留到早晨。<verse eid="EXO 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 23:19" />「要把你土地裡上好的初熟之物帶到你神耶和華的殿中。</para>
  <para style="p" vid="EXO 23:19">「不可用母山羊的奶煮牠的小山羊。<verse eid="EXO 23:19" /></para>
  <para style="s">應許和警誡</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20" />「看哪，我必派遣使者在你前面，為要在路上保守你，領你到我預備好的地方！ <verse eid="EXO 23:20" /><verse number="21" style="v" sid="EXO 23:21" />你們在他面前要謹慎，聽他的聲音，不要違背他；否則，他不會饒恕你們的悖逆，因為他是奉我名的<note caller="+" style="f"><char style="fr" closed="false">23:21 </char><char style="ft" closed="false">他是奉我名的——原文直譯「我的名在他裡面」。</char></note>。 <verse eid="EXO 23:21" /><verse number="22" style="v" sid="EXO 23:22" />如果你留心聽他的聲音，遵行我所說的一切，我就作你仇敵的仇敵，作你敵人的敵人。 <verse eid="EXO 23:22" /><verse number="23" style="v" sid="EXO 23:23" />我的使者必走在你前面，領你到<char style="pn">亞摩利</char>人、<char style="pn">赫提</char>人、<char style="pn">比利洗</char>人、<char style="pn">迦南</char>人、<char style="pn">希未</char>人、<char style="pn">耶布斯</char>人那裡；我必除滅他們。 <verse eid="EXO 23:23" /><verse number="24" style="v" sid="EXO 23:24" />你不可向他們的神明下拜，不可服事它們，也不可照著那些人所做的去做，而要把那些神明徹底除掉，把神柱完全打碎。 <verse eid="EXO 23:24" /><verse number="25" style="v" sid="EXO 23:25" />你們要服事耶和華你們的神，他就必祝福你的糧食和你的水。我必從你們當中除去疾病； <verse eid="EXO 23:25" /><verse number="26" style="v" sid="EXO 23:26" />在你的地上不會有流產的或不能生育的；我必使你滿了壽數。<verse eid="EXO 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27" />「我會在你前面發出威嚇，使你所到之處的所有民眾混亂，使你一切仇敵轉身而逃。 <verse eid="EXO 23:27" /><verse number="28" style="v" sid="EXO 23:28" />我會在你前面派出黃蜂，使牠們從你面前驅逐<char style="pn">希未</char>人、<char style="pn">迦南</char>人、<char style="pn">赫提</char>人。 <verse eid="EXO 23:28" /><verse number="29" style="v" sid="EXO 23:29" />我不會在一年之內就從你面前驅逐他們，免得那地變得荒涼，田野的走獸增多危害你。 <verse eid="EXO 23:29" /><verse number="30" style="v" sid="EXO 23:30" />我會一點一點地從你面前驅逐他們，直到你繁衍增多，繼承那地。 <verse eid="EXO 23:30" /><verse number="31" style="v" sid="EXO 23:31" />我會定下你的邊界，從<char style="pn">紅海</char>直到<char style="pn">非利士</char>人之海，又從曠野直到大河<note caller="+" style="f"><char style="fr" closed="false">23:31 </char><char style="ft" closed="false">大河——指幼發拉底河。</char></note>。我會把那地的居民交在你的手中，你要把他們從你面前驅逐出去。 <verse eid="EXO 23:31" /><verse number="32" style="v" sid="EXO 23:32" />你不可與他們和他們的神明立約； <verse eid="EXO 23:32" /><verse number="33" style="v" sid="EXO 23:33" />不可讓他們住在你的地上，免得他們使你犯罪敵對我。如果你服事他們的神明，這必定成為你的陷阱。」<verse eid="EXO 23:33" /></para>
  <chapter eid="EXO 23" />
  <chapter number="24" style="c" sid="EXO 24" />
  <para style="s">立約的血</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1" />耶和華對<char style="pn">摩西</char>說：「你和<char style="pn">亞倫</char>、<char style="pn">納達布</char>、<char style="pn">亞比戶</char>，以及<char style="pn">以色列</char>長老中的七十人，都要上到耶和華這裡來，在遠處下拜。 <verse eid="EXO 24:1" /><verse number="2" style="v" sid="EXO 24:2" />唯獨<char style="pn">摩西</char>可以接近耶和華，其他人不可接近，子民也不可與他一同上來。」<verse eid="EXO 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3" />
    <char style="pn">摩西</char>下來，把耶和華的一切話語和一切法規向百姓講述，全體民眾就同聲回應說：「耶和華所說的一切話，我們都會遵行。」 <verse eid="EXO 24:3" /><verse number="4" style="v" sid="EXO 24:4" /><char style="pn">摩西</char>把耶和華的一切話語都記下了。他清早起來，在山下築了一座祭壇，按著<char style="pn">以色列</char>的十二支派立了十二根石柱； <verse eid="EXO 24:4" /><verse number="5" style="v" sid="EXO 24:5" />又派<char style="pn">以色列</char>子孫中的年輕人去獻上燔祭，並向耶和華獻上公牛為平安祭物。 <verse eid="EXO 24:5" /><verse number="6" style="v" sid="EXO 24:6" /><char style="pn">摩西</char>取一半的血放在盆中，取另一半的血灑在祭壇上； <verse eid="EXO 24:6" /><verse number="7" style="v" sid="EXO 24:7" />然後拿起約書宣讀給百姓聽。他們說：「耶和華所說的一切，我們都會遵行，都會聽從。」<verse eid="EXO 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 24:8" />
    <char style="pn">摩西</char>就取了血灑在百姓身上說：「看哪，這是立約的血，這約是耶和華照著這一切話語與你們立的！」<verse eid="EXO 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 24:9" />
    <char style="pn">摩西</char>和<char style="pn">亞倫</char>、<char style="pn">納達布</char>、<char style="pn">亞比戶</char>，以及<char style="pn">以色列</char>長老中的七十人都上去了。 <verse eid="EXO 24:9" /><verse number="10" style="v" sid="EXO 24:10" />他們看見<char style="pn">以色列</char>的神；他的腳下彷彿是藍寶石鋪成的地面，像天空本身那樣清澄。 <verse eid="EXO 24:10" /><verse number="11" style="v" sid="EXO 24:11" />他沒有伸手對付<char style="pn">以色列</char>子孫的首領們；他們仰視神，而且吃喝。<verse eid="EXO 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12" />耶和華對<char style="pn">摩西</char>說：「你要上山到我這裡來，留在這裡；我要把我寫下的律法和誡命的石版賜給你，用來指教他們。」<verse eid="EXO 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 24:13" />於是<char style="pn">摩西</char>與事奉他的<char style="pn">約書亞</char>一同起來，<char style="pn">摩西</char>就上到神的山。 <verse eid="EXO 24:13" /><verse number="14" style="v" sid="EXO 24:14" /><char style="pn">摩西</char>對長老們說：「你們在這裡等我們，直到我們回到你們這裡。看哪，<char style="pn">亞倫</char>和<char style="pn">戶珥</char>與你們在一起，誰有爭訟的事，可以近前來到他們那裡。」 <verse eid="EXO 24:14" /><verse number="15" style="v" sid="EXO 24:15" /><char style="pn">摩西</char>上到那山，雲彩就把山遮蓋了。 <verse eid="EXO 24:15" /><verse number="16" style="v" sid="EXO 24:16" />耶和華的榮耀停留在<char style="pn">西奈</char>山上，雲彩把山遮蓋了六天；第七天，耶和華從雲彩中向<char style="pn">摩西</char>呼喚。 <verse eid="EXO 24:16" /><verse number="17" style="v" sid="EXO 24:17" />耶和華榮耀的樣子，在山頂上，在<char style="pn">以色列</char>子孫眼前，好像吞噬的烈火。 <verse eid="EXO 24:17" /><verse number="18" style="v" sid="EXO 24:18" /><char style="pn">摩西</char>進入雲彩中，上到那山；<char style="pn">摩西</char>在山上四十晝夜。<verse eid="EXO 24:18" /></para>
  <chapter eid="EXO 24" />
  <chapter number="25" style="c" sid="EXO 25" />
  <para style="s">為聖所收取供物</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="EXO 25:1" /><verse number="2" style="v" sid="EXO 25:2" />「你要吩咐<char style="pn">以色列</char>子孫拿供物給我；凡是甘心奉獻的人，你們就從他們收取給我的供物。 <verse eid="EXO 25:2" /><verse number="3" style="v" sid="EXO 25:3" />以下是你們要從他們收取的供物：金、銀、銅， <verse eid="EXO 25:3" /><verse number="4" style="v" sid="EXO 25:4" />藍色線、紫色線、朱紅色線、細麻、山羊毛， <verse eid="EXO 25:4" /><verse number="5" style="v" sid="EXO 25:5" />染紅的公綿羊皮、海獅皮<note caller="+" style="f"><char style="fr" closed="false">25:5 </char><char style="ft" closed="false">海獅皮——原文語義不確定，基本意思是一種精細的皮革；本卷下同。</char></note>，金合歡木， <verse eid="EXO 25:5" /><verse number="6" style="v" sid="EXO 25:6" />點燈的油、製作膏油和芬芳香的香料， <verse eid="EXO 25:6" /><verse number="7" style="v" sid="EXO 25:7" />以及以弗得和胸牌上用的紅瑪瑙石和鑲嵌的寶石。<verse eid="EXO 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 25:8" />「他們要為我造一個聖所，好使我住在他們中間。 <verse eid="EXO 25:8" /><verse number="9" style="v" sid="EXO 25:9" />我將向你指明的一切，就是帳幕的樣式和其中一切器具的樣式，你們要照著去做。<verse eid="EXO 25:9" /></para>
  <para style="s">見證櫃</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10" />「他們要用金合歡木做一個櫃，長二肘半<note caller="+" style="f"><char style="fr" closed="false">25:10 </char><char style="ft" closed="false">二肘半——相當於114.3公分；下同。1肘=45.7公分。</char></note>，寬一肘半<note caller="+" style="f"><char style="fr" closed="false">25:10 </char><char style="ft" closed="false">一肘半——相當於68.6公分；下同。</char></note>，高一肘半。 <verse eid="EXO 25:10" /><verse number="11" style="v" sid="EXO 25:11" />你要把它包上純金，裡裡外外都包上，並在它的四圍鑲上金邊； <verse eid="EXO 25:11" /><verse number="12" style="v" sid="EXO 25:12" />又要為它鑄四個金環，安裝在它的四個腳上，兩個環在一邊，兩個環在另一邊。 <verse eid="EXO 25:12" /><verse number="13" style="v" sid="EXO 25:13" />你要用金合歡木做兩根杠，把它們包上金， <verse eid="EXO 25:13" /><verse number="14" style="v" sid="EXO 25:14" />把杠穿進櫃兩邊的環中，用它們來抬櫃。 <verse eid="EXO 25:14" /><verse number="15" style="v" sid="EXO 25:15" />杠要留在櫃的環中，不可抽出來。 <verse eid="EXO 25:15" /><verse number="16" style="v" sid="EXO 25:16" />你要把我將賜給你的見證版安放在櫃裡。 <verse eid="EXO 25:16" /><verse number="17" style="v" sid="EXO 25:17" />你要用純金做施恩座<note caller="+" style="f"><char style="fr" closed="false">25:17 </char><char style="ft" closed="false">施恩座——或譯作「贖罪蓋」；下同。</char></note>，長二肘半，寬一肘半； <verse eid="EXO 25:17" /><verse number="18" style="v" sid="EXO 25:18" />又要在施恩座的兩端，用金子造兩個基路伯，錘擛成形—— <verse eid="EXO 25:18" /><verse number="19" style="v" sid="EXO 25:19" />一端造一個基路伯，另一端也造一個基路伯，從施恩座的兩端造出基路伯。 <verse eid="EXO 25:19" /><verse number="20" style="v" sid="EXO 25:20" />兩個基路伯要向上展開翅膀，用它們的翅膀遮掩施恩座；基路伯的臉要彼此相向，它們的臉要朝著施恩座。 <verse eid="EXO 25:20" /><verse number="21" style="v" sid="EXO 25:21" />你要把施恩座安放在櫃上面，把我將賜給你的見證版安放在櫃裡。 <verse eid="EXO 25:21" /><verse number="22" style="v" sid="EXO 25:22" />我要在那裡與你相會，並從施恩座上，從見證櫃上面的兩個基路伯之間，把我要吩咐你傳給<char style="pn">以色列</char>子孫的一切事告訴你。<verse eid="EXO 25:22" /></para>
  <para style="s">陳設餅的桌子</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23" />「你要用金合歡木做一張桌子，長二肘<note caller="+" style="f"><char style="fr" closed="false">25:23 </char><char style="ft" closed="false">二肘——相當於91.4公分。1肘=45.7公分。</char></note>，寬一肘<note caller="+" style="f"><char style="fr" closed="false">25:23 </char><char style="ft" closed="false">一肘——相當於45.7公分。</char></note>，高一肘半<note caller="+" style="f"><char style="fr" closed="false">25:23 </char><char style="ft" closed="false">一肘半——相當於68.6公分。</char></note>。 <verse eid="EXO 25:23" /><verse number="24" style="v" sid="EXO 25:24" />你要把它包上純金，並在它的四圍鑲上金邊； <verse eid="EXO 25:24" /><verse number="25" style="v" sid="EXO 25:25" />要在它的四圍做一掌寬<note caller="+" style="f"><char style="fr" closed="false">25:25 </char><char style="ft" closed="false">一掌寬——相當於7.4公分。</char></note>的邊框，並在它的邊框四圍鑲上金邊； <verse eid="EXO 25:25" /><verse number="26" style="v" sid="EXO 25:26" />又要為它做四個金環，安裝在它的四角，就是它的四個腿上。 <verse eid="EXO 25:26" /><verse number="27" style="v" sid="EXO 25:27" />環要靠近邊框，用來穿杠抬桌子。 <verse eid="EXO 25:27" /><verse number="28" style="v" sid="EXO 25:28" />你要用金合歡木做兩根杠，把它們包上金，用它們來抬桌子。 <verse eid="EXO 25:28" /><verse number="29" style="v" sid="EXO 25:29" />你要做桌子上澆奠用的盤、碟、壺和杯；這些都要用純金來做。 <verse eid="EXO 25:29" /><verse number="30" style="v" sid="EXO 25:30" />你要在桌子上擺放陳設餅，使陳設餅常在我面前。<verse eid="EXO 25:30" /></para>
  <para style="s">燈檯</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31" />「你要用純金做一個燈臺，燈臺要錘擛成形——它的底座、枝幹、花杯、花萼和花瓣都要與燈臺一體錘出。 <verse eid="EXO 25:31" /><verse number="32" style="v" sid="EXO 25:32" />從燈臺的兩邊要伸出六根枝幹，三根枝幹在一邊，三根枝幹在另一邊。 <verse eid="EXO 25:32" /><verse number="33" style="v" sid="EXO 25:33" />在一邊的每根枝幹上有三個杏花形狀的花杯，每個都有花萼和花瓣；在另一邊的每根枝幹上也有三個杏花形狀的花杯，每個都有花萼和花瓣；從燈臺伸出的六根枝幹都要這樣。 <verse eid="EXO 25:33" /><verse number="34" style="v" sid="EXO 25:34" />燈臺的主幹<note caller="+" style="f"><char style="fr" closed="false">25:34 </char><char style="ft" closed="false">的主幹——輔助詞語。</char></note>上有四個杏花形狀的花杯，每個都有花萼和花瓣； <verse eid="EXO 25:34" /><verse number="35" style="v" sid="EXO 25:35" />從燈臺伸出的第一對兩根枝幹下面有一個花萼，第二對兩根枝幹下面有一個花萼，第三對兩根枝幹下面也有一個花萼；從燈臺伸出的六根枝幹都要這樣。 <verse eid="EXO 25:35" /><verse number="36" style="v" sid="EXO 25:36" />它們的花萼和枝幹要與燈臺一體錘出，整個燈臺都要用同一塊純金錘成。<verse eid="EXO 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 25:37" />「你要做燈臺的七盞燈，把它們安裝在燈臺上，使燈照亮燈臺前方。 <verse eid="EXO 25:37" /><verse number="38" style="v" sid="EXO 25:38" />燈臺的燈剪和燈盤都要用純金做； <verse eid="EXO 25:38" /><verse number="39" style="v" sid="EXO 25:39" />要用一他連得<note caller="+" style="f"><char style="fr" closed="false">25:39 </char><char style="ft" closed="false">一他連得——相當於34.2公斤。</char></note>純金做燈臺和所有這些器具。 <verse eid="EXO 25:39" /><verse number="40" style="v" sid="EXO 25:40" />你當留意，要照著在山上向你指明的樣式去做！<verse eid="EXO 25:40" /></para>
  <chapter eid="EXO 25" />
  <chapter number="26" style="c" sid="EXO 26" />
  <para style="s">帳幕</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1" />「你要用十幅幔帳造帳幕，幔帳要用捻成的細麻線和藍色、紫色、朱紅色線編織，以精巧的工藝繡上基路伯。 <verse eid="EXO 26:1" /><verse number="2" style="v" sid="EXO 26:2" />每幅幔帳長二十八肘<note caller="+" style="f"><char style="fr" closed="false">26:2 </char><char style="ft" closed="false">二十八肘——相當於12.8公尺。1肘=45.7公分。</char></note>，每幅幔帳寬四肘<note caller="+" style="f"><char style="fr" closed="false">26:2 </char><char style="ft" closed="false">四肘——相當於1.8公尺。</char></note>，所有幔帳的尺寸都要一樣。 <verse eid="EXO 26:2" /><verse number="3" style="v" sid="EXO 26:3" />五幅幔帳要彼此相連，另五幅幔帳也要彼此相連。 <verse eid="EXO 26:3" /><verse number="4" style="v" sid="EXO 26:4" />在一組幔帳的最後一幅邊上，要用藍色線做扣環；在另一組幔帳的最後一幅邊上，也要照樣做。 <verse eid="EXO 26:4" /><verse number="5" style="v" sid="EXO 26:5" />在一組幔帳的邊上，要做五十個扣環；在另一組幔帳的邊上，也要做五十個扣環，扣環彼此相對。 <verse eid="EXO 26:5" /><verse number="6" style="v" sid="EXO 26:6" />你要做五十個金鉤，用這些鉤子把兩組幔帳彼此相連為一大幅<note caller="+" style="f"><char style="fr" closed="false">26:6 </char><char style="ft" closed="false">為一大幅——輔助詞語。</char></note>，好使帳幕成為一個整體。<verse eid="EXO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7" />「你要用山羊毛做幔帳，作為帳幕上的罩篷，要做十一幅幔帳。 <verse eid="EXO 26:7" /><verse number="8" style="v" sid="EXO 26:8" />每幅幔帳長三十肘<note caller="+" style="f"><char style="fr" closed="false">26:8 </char><char style="ft" closed="false">三十肘——相當於13.7公尺。1肘=45.7公分。</char></note>，每幅幔帳寬四肘<note caller="+" style="f"><char style="fr" closed="false">26:8 </char><char style="ft" closed="false">四肘——相當於1.8公尺。</char></note>，十一幅幔帳的尺寸都要一樣。 <verse eid="EXO 26:8" /><verse number="9" style="v" sid="EXO 26:9" />你要把五幅幔帳連成一組，把另外的六幅幔帳也連成一組，並把第六幅幔帳在罩篷的前部疊上去。 <verse eid="EXO 26:9" /><verse number="10" style="v" sid="EXO 26:10" />在一組幔帳的最後一幅邊上，要做五十個扣環；在另一組幔帳的邊上，也要做五十個扣環。 <verse eid="EXO 26:10" /><verse number="11" style="v" sid="EXO 26:11" />你要做五十個銅鉤，把這些鉤子鉤入扣環，把罩篷連起來，好使它成為一個整體。 <verse eid="EXO 26:11" /><verse number="12" style="v" sid="EXO 26:12" />罩篷幔帳遮蓋帳幕<note caller="+" style="f"><char style="fr" closed="false">26:12 </char><char style="ft" closed="false">遮蓋帳幕——輔助詞語。</char></note>多出的部分，就是多出的半幅幔帳，要垂在帳幕的後面。 <verse eid="EXO 26:12" /><verse number="13" style="v" sid="EXO 26:13" />罩篷幔帳遮蓋那大幅幔帳<note caller="+" style="f"><char style="fr" closed="false">26:13 </char><char style="ft" closed="false">遮蓋那大幅幔帳——輔助詞語。</char></note>多出的長度，要一肘在一邊，一肘在另一邊，垂在帳幕的兩邊——在一邊和另一邊，好遮蓋帳幕。 <verse eid="EXO 26:13" /><verse number="14" style="v" sid="EXO 26:14" />你要用染紅的公綿羊皮為罩篷做一個遮蓋，其上再用海獅皮做一個頂罩。<verse eid="EXO 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15" />「你要用金合歡木為帳幕做豎板。 <verse eid="EXO 26:15" /><verse number="16" style="v" sid="EXO 26:16" />每塊木板長十肘<note caller="+" style="f"><char style="fr" closed="false">26:16 </char><char style="ft" closed="false">十肘——相當於4.6公尺。1肘=45.7公分。</char></note>，每塊木板寬一肘半<note caller="+" style="f"><char style="fr" closed="false">26:16 </char><char style="ft" closed="false">一肘半——相當於0.7公尺。</char></note>。 <verse eid="EXO 26:16" /><verse number="17" style="v" sid="EXO 26:17" />每塊木板要有兩個榫頭，彼此並列<note caller="+" style="f"><char style="fr" closed="false">26:17 </char><char style="ft" closed="false">彼此並列——或譯作「使木板彼此連接」。</char></note>；帳幕所有的木板都要這樣做。 <verse eid="EXO 26:17" /><verse number="18" style="v" sid="EXO 26:18" />你要為帳幕做木板，為南邊，就是朝南的那邊，做二十塊木板； <verse eid="EXO 26:18" /><verse number="19" style="v" sid="EXO 26:19" />在這二十塊木板底下，做四十個銀底座；一塊木板底下有兩個底座連接它的兩個榫頭，下一塊木板底下也有兩個底座連接它的兩個榫頭。 <verse eid="EXO 26:19" /><verse number="20" style="v" sid="EXO 26:20" />你要為帳幕的另一邊，就是北邊，做二十塊木板， <verse eid="EXO 26:20" /><verse number="21" style="v" sid="EXO 26:21" />以及四十個銀底座；一塊木板底下有兩個底座，下一塊木板底下也有兩個底座。 <verse eid="EXO 26:21" /><verse number="22" style="v" sid="EXO 26:22" />你也要為帳幕的後部，就是西面，做六塊木板； <verse eid="EXO 26:22" /><verse number="23" style="v" sid="EXO 26:23" />並在帳幕後部的兩個邊角做兩塊木板， <verse eid="EXO 26:23" /><verse number="24" style="v" sid="EXO 26:24" />兩個邊角要雙層，雙層木板從下端到頂端完全對齊，頂端用一個環扣住；兩塊木板都要這樣，形成兩個凸角。 <verse eid="EXO 26:24" /><verse number="25" style="v" sid="EXO 26:25" />這樣共有八塊木板和十六個銀底座；一塊木板底下有兩個底座，下一塊木板底下也有兩個底座。<verse eid="EXO 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 26:26" />「你要用金合歡木做橫閂，為帳幕一邊的木板做五根， <verse eid="EXO 26:26" /><verse number="27" style="v" sid="EXO 26:27" />為帳幕另一邊的木板做五根橫閂，又為帳幕後邊，就是西面的木板，也做五根橫閂。 <verse eid="EXO 26:27" /><verse number="28" style="v" sid="EXO 26:28" />在木板中部，中間那根橫閂，從一端穿到另一端。 <verse eid="EXO 26:28" /><verse number="29" style="v" sid="EXO 26:29" />你要把木板包上金，又用金子做其上的環，用來穿橫閂；橫閂也要包上金。 <verse eid="EXO 26:29" /><verse number="30" style="v" sid="EXO 26:30" />你要照著在山上向你指明的規制，把帳幕立起來。<verse eid="EXO 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31" />「你要用藍色、紫色、朱紅色線和捻成的細麻線編織幔子，以精巧的工藝繡上基路伯。 <verse eid="EXO 26:31" /><verse number="32" style="v" sid="EXO 26:32" />你要把幔子垂掛在四根包金的金合歡木柱子上；柱子上有金鉤，柱子在四個銀底座上。 <verse eid="EXO 26:32" /><verse number="33" style="v" sid="EXO 26:33" />你要把幔子垂掛在鉤子之下，把見證櫃抬進幔子內；這幔子就為你們隔開了聖所和至聖所。 <verse eid="EXO 26:33" /><verse number="34" style="v" sid="EXO 26:34" />你要把施恩座安放在至聖所裡的見證櫃上。 <verse eid="EXO 26:34" /><verse number="35" style="v" sid="EXO 26:35" />你要把桌子放在幔子外，把燈臺放在桌子對面，在帳幕的南邊；桌子要安置在帳幕的北邊。<verse eid="EXO 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36" />「你要用藍色、紫色、朱紅色線和捻成的細麻線，以刺繡的工藝，為帳篷的入口編織簾幕。 <verse eid="EXO 26:36" /><verse number="37" style="v" sid="EXO 26:37" />你要用金合歡木為簾幕做五根柱子，把柱子包上金，柱子上有金鉤；又要為柱子鑄五個銅底座。<verse eid="EXO 26:37" /></para>
  <chapter eid="EXO 26" />
  <chapter number="27" style="c" sid="EXO 27" />
  <para style="s">祭壇</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1" />「你要用金合歡木造一座祭壇，長五肘<note caller="+" style="f"><char style="fr" closed="false">27:1 </char><char style="ft" closed="false">五肘——相當於2.3公尺；下同。1肘=45.7公分。</char></note>，寬五肘，祭壇是方形的，高三肘<note caller="+" style="f"><char style="fr" closed="false">27:1 </char><char style="ft" closed="false">三肘——相當於1.4公尺。</char></note>； <verse eid="EXO 27:1" /><verse number="2" style="v" sid="EXO 27:2" />要在祭壇的四角上做犄角，犄角從祭壇而出；又要把祭壇包上銅。 <verse eid="EXO 27:2" /><verse number="3" style="v" sid="EXO 27:3" />你要做一些桶，用來收去祭壇的灰，並要做一些鏟子、碗、肉叉和火盆；祭壇的一切器具，都要用銅做。 <verse eid="EXO 27:3" /><verse number="4" style="v" sid="EXO 27:4" />你要為祭壇做一個銅格網，在網的四角上做四個銅環， <verse eid="EXO 27:4" /><verse number="5" style="v" sid="EXO 27:5" />把網安放在祭壇的邊框之下，使網達到祭壇的半腰。 <verse eid="EXO 27:5" /><verse number="6" style="v" sid="EXO 27:6" />你要用金合歡木為祭壇做兩根杠，把它們包上銅， <verse eid="EXO 27:6" /><verse number="7" style="v" sid="EXO 27:7" />把杠穿進環中，抬祭壇時，杠就在祭壇的兩邊。 <verse eid="EXO 27:7" /><verse number="8" style="v" sid="EXO 27:8" />你要用木板把祭壇做成空心的，要照著在山上向你所指明的去做。<verse eid="EXO 27:8" /></para>
  <para style="s">院子</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9" />「你要做帳幕的院子。南邊要用捻成的細麻線編織院子的帷幔，邊長一百肘<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">一百肘——相當於45.7公尺；下同。1肘=45.7公分。</char></note>。 <verse eid="EXO 27:9" /><verse number="10" style="v" sid="EXO 27:10" />帷幔的柱子二十根，柱子的銅底座二十個，柱子上的鉤子和箍環都是銀的。 <verse eid="EXO 27:10" /><verse number="11" style="v" sid="EXO 27:11" />北邊的長度也一樣，帷幔長一百肘，帷幔的柱子二十根，柱子的銅底座二十個，柱子上的鉤子和箍環都是銀的。 <verse eid="EXO 27:11" /><verse number="12" style="v" sid="EXO 27:12" />院子的西邊，帷幔寬五十肘<note caller="+" style="f"><char style="fr" closed="false">27:12 </char><char style="ft" closed="false">五十肘——相當於22.9公尺；下同。1肘=45.7公分。</char></note>，帷幔的柱子十根，柱子的底座十個。 <verse eid="EXO 27:12" /><verse number="13" style="v" sid="EXO 27:13" />院子的東邊，就是日出的方向，寬五十肘： <verse eid="EXO 27:13" /><verse number="14" style="v" sid="EXO 27:14" />門的一邊，帷幔寬十五肘<note caller="+" style="f"><char style="fr" closed="false">27:14 </char><char style="ft" closed="false">十五肘——相當於6.9公尺；下同。1肘=45.7公分。</char></note>，帷幔的柱子三根，柱子的底座三個； <verse eid="EXO 27:14" /><verse number="15" style="v" sid="EXO 27:15" />門的另一邊，帷幔也寬十五肘，帷幔的柱子三根，柱子的底座三個； <verse eid="EXO 27:15" /><verse number="16" style="v" sid="EXO 27:16" />院子的門簾寬二十肘<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">二十肘——相當於9.1公尺。1肘=45.7公分。</char></note>，用藍色、紫色、朱紅色線和捻成的細麻線，以刺繡的工藝編織，帷幔的柱子四根，柱子的底座四個。<verse eid="EXO 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 27:17" />「院子四圍所有的柱子都要有銀箍環箍著，柱子上的鉤子都是銀的，柱子的底座都是銅的。 <verse eid="EXO 27:17" /><verse number="18" style="v" sid="EXO 27:18" />院子長一百肘<note caller="+" style="f"><char style="fr" closed="false">27:18 </char><char style="ft" closed="false">一百肘——相當於45.7公尺。1肘=45.7公分。</char></note>，兩邊各寬五十肘<note caller="+" style="f"><char style="fr" closed="false">27:18 </char><char style="ft" closed="false">五十肘——相當於22.9公尺。</char></note>；帷幔高五肘<note caller="+" style="f"><char style="fr" closed="false">27:18 </char><char style="ft" closed="false">五肘——相當於2.3公尺。</char></note>，用捻成的細麻線編織，柱子的底座都是銅的。 <verse eid="EXO 27:18" /><verse number="19" style="v" sid="EXO 27:19" />帳幕中各樣服事所用的一切器具，並帳幕所有的橛子，以及院子所有的橛子，都是銅的。<verse eid="EXO 27:19" /></para>
  <para style="s">燈檯之油</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20" />「你要吩咐<char style="pn">以色列</char>子孫，把壓榨的純橄欖油拿來給你，用來點燈，使燈持續點燃著。 <verse eid="EXO 27:20" /><verse number="21" style="v" sid="EXO 27:21" /><char style="pn">亞倫</char>和他的兒子們要在會幕中，在見證櫃前的幔子外，從傍晚到早晨，在耶和華面前照管燈。這是<char style="pn">以色列</char>子孫世世代代永遠的律例。<verse eid="EXO 27:21" /></para>
  <chapter eid="EXO 27" />
  <chapter number="28" style="c" sid="EXO 28" />
  <para style="s">祭司的聖衣</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1" />「你要從<char style="pn">以色列</char>子孫中，把你哥哥<char style="pn">亞倫</char>和他的兒子們帶到你這裡，使<char style="pn">亞倫</char>、<char style="pn">亞倫</char>的兒子<char style="pn">納達布</char>、<char style="pn">亞比戶</char>、<char style="pn">以利亞撒</char>和<char style="pn">以塔瑪爾</char>作祭司事奉我。 <verse eid="EXO 28:1" /><verse number="2" style="v" sid="EXO 28:2" />你要為你哥哥<char style="pn">亞倫</char>做聖衣，以顯出榮耀、華美。 <verse eid="EXO 28:2" /><verse number="3" style="v" sid="EXO 28:3" />你要吩咐一切有才能<note caller="+" style="f"><char style="fr" closed="false">28:3 </char><char style="ft" closed="false">有才能——原文直譯「心裡有智慧」。</char></note>的人，就是我用智慧的靈所充滿的人，他們要為<char style="pn">亞倫</char>做聖衣，使他分別為聖，作祭司事奉我。 <verse eid="EXO 28:3" /><verse number="4" style="v" sid="EXO 28:4" />以下是他們要做的衣裝：胸牌、以弗得、外袍、編織的袍子、頂冠、腰帶。他們要為你哥哥<char style="pn">亞倫</char>和他的兒子們做聖衣，使他們作祭司事奉我。 <verse eid="EXO 28:4" /><verse number="5" style="v" sid="EXO 28:5" />他們要拿金色、藍色、紫色、朱紅色線和細麻來做。<verse eid="EXO 28:5" /></para>
  <para style="s">以弗得</para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6" />「他們要用金色、藍色、紫色、朱紅色線和捻成的細麻線，以精巧的工藝做以弗得； <verse eid="EXO 28:6" /><verse number="7" style="v" sid="EXO 28:7" />以弗得要有兩條肩帶與它的兩端相連，使之相連在一起。 <verse eid="EXO 28:7" /><verse number="8" style="v" sid="EXO 28:8" />以弗得上的精巧織帶，要與以弗得的做法一樣，都從同樣的材料——金色、藍色、紫色、朱紅色線和捻成的細麻線織出。<verse eid="EXO 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 28:9" />「你要拿兩塊紅瑪瑙石，在它們上面雕刻<char style="pn">以色列</char>兒子們的名字： <verse eid="EXO 28:9" /><verse number="10" style="v" sid="EXO 28:10" />六個名字在一塊寶石上，六個名字在另一塊寶石上，都按著他們的家系； <verse eid="EXO 28:10" /><verse number="11" style="v" sid="EXO 28:11" />要用寶石匠雕刻印章的工藝，在這兩塊寶石上雕刻<char style="pn">以色列</char>兒子們的名字，再把寶石鑲嵌在金槽中。 <verse eid="EXO 28:11" /><verse number="12" style="v" sid="EXO 28:12" />你要把這兩塊寶石安在以弗得的肩帶上，為<char style="pn">以色列</char>子孫作記念石。<char style="pn">亞倫</char>要在耶和華面前把他們的名字背負在他的雙肩上，作為記念。 <verse eid="EXO 28:12" /><verse number="13" style="v" sid="EXO 28:13" />你要做兩個金槽， <verse eid="EXO 28:13" /><verse number="14" style="v" sid="EXO 28:14" />又要用編繩子的工藝做兩條純金的鏈子，把繩子一樣的鏈子接在槽上。<verse eid="EXO 28:14" /></para>
  <para style="s">胸牌</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15" />「你要以精巧的工藝做一個決斷胸牌，要與以弗得的做法一樣，用金色、藍色、紫色、朱紅色線和捻成的細麻線來做。 <verse eid="EXO 28:15" /><verse number="16" style="v" sid="EXO 28:16" />胸牌是方形的，疊為雙層，長一拃<note caller="+" style="f"><char style="fr" closed="false">28:16 </char><char style="ft" closed="false">一拃——約20公分；下同。</char></note>，寬一拃。 <verse eid="EXO 28:16" /><verse number="17" style="v" sid="EXO 28:17" />你要在胸牌上鑲嵌四行寶石：</para>
  <para style="q1" vid="EXO 28:17">第一行是紅寶石、黃玉、綠寶石，<verse eid="EXO 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 28:18" />第二行是綠松石、藍寶石、金剛石，<verse eid="EXO 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="EXO 28:19" />第三行是紅鋯石、白瑪瑙、紫晶，<verse eid="EXO 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="EXO 28:20" />第四行是黃水晶、紅瑪瑙、碧玉。</para>
  <para style="m" vid="EXO 28:20">這些都要鑲嵌在各自的金槽中。 <verse eid="EXO 28:20" /><verse number="21" style="v" sid="EXO 28:21" />這些寶石都要按著<char style="pn">以色列</char>兒子們的名字，十二塊都按著他們的名字，像雕刻印章那樣，按著各自的名字，代表十二個支派。<verse eid="EXO 28:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 28:22" />「你要在胸牌上用編繩子的工藝做純金的鏈子； <verse eid="EXO 28:22" /><verse number="23" style="v" sid="EXO 28:23" />你要在胸牌上做兩個金環，把兩個環接在胸牌上邊<note caller="+" style="f"><char style="fr" closed="false">28:23 </char><char style="ft" closed="false">上邊——輔助詞語。</char></note>的兩端； <verse eid="EXO 28:23" /><verse number="24" style="v" sid="EXO 28:24" />你要把兩條金鏈子接在胸牌上邊<note caller="+" style="f"><char style="fr" closed="false">28:24 </char><char style="ft" closed="false">上邊——輔助詞語。</char></note>兩端的兩個環中， <verse eid="EXO 28:24" /><verse number="25" style="v" sid="EXO 28:25" />把兩條鏈子的另兩端接在兩個槽上，連在以弗得前面的肩帶上。 <verse eid="EXO 28:25" /><verse number="26" style="v" sid="EXO 28:26" />你要再做兩個金環，把它們安在胸牌下邊<note caller="+" style="f"><char style="fr" closed="false">28:26 </char><char style="ft" closed="false">下邊——輔助詞語。</char></note>的兩端，在以弗得內側的邊上； <verse eid="EXO 28:26" /><verse number="27" style="v" sid="EXO 28:27" />又做兩個金環，把它們接在以弗得前面的兩條肩帶下面，靠近接縫處，在以弗得的精巧織帶上方。 <verse eid="EXO 28:27" /><verse number="28" style="v" sid="EXO 28:28" />你要用藍色的細繩把胸牌的環與以弗得的環連接，使胸牌貼在以弗得的精巧織帶上，使胸牌不致從以弗得上鬆脫。<verse eid="EXO 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29" />「<char style="pn">亞倫</char>進入聖所的時候，要把決斷胸牌上<char style="pn">以色列</char>兒子們的名字掛在他的胸前，在耶和華面前常作記念。 <verse eid="EXO 28:29" /><verse number="30" style="v" sid="EXO 28:30" />你要把烏陵和土明放在決斷胸牌裡；於是<char style="pn">亞倫</char>進到耶和華面前的時候，烏陵和土明就會在他的胸前。這樣，<char style="pn">亞倫</char>在耶和華面前就常在心中背負著決斷<char style="pn">以色列</char>子孫的責任。<verse eid="EXO 28:30" /></para>
  <para style="s">外袍</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31" />「你要做以弗得的外袍，整件都是藍色的。 <verse eid="EXO 28:31" /><verse number="32" style="v" sid="EXO 28:32" />外袍頭部的中間之處，要有一個領口，領口要有圍邊，用紡織的工藝做成，像戰袍的領口那樣，免得撕裂。 <verse eid="EXO 28:32" /><verse number="33" style="v" sid="EXO 28:33" />外袍下擺的圍邊上，要用藍色、紫色、朱紅色線做石榴，石榴之間要有金鈴鐺， <verse eid="EXO 28:33" /><verse number="34" style="v" sid="EXO 28:34" />一個金鈴鐺一個石榴，一個金鈴鐺一個石榴，在外袍下擺的圍邊上。 <verse eid="EXO 28:34" /><verse number="35" style="v" sid="EXO 28:35" /><char style="pn">亞倫</char>事奉的時候要把外袍穿上；他進入聖所到耶和華面前以及出來的時候，外袍上的鈴聲就會被聽見，他就不致死亡。<verse eid="EXO 28:35" /></para>
  <para style="s">禮冠</para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 28:36" />「你要用純金做一面牌子，像雕刻印章那樣，在牌子上面雕刻『歸耶和華為聖』。<verse eid="EXO 28:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 28:37" />「你要用一條藍色的細繩把金牌繫在頂冠上，就在頂冠的前面。 <verse eid="EXO 28:37" /><verse number="38" style="v" sid="EXO 28:38" />牌子要在<char style="pn">亞倫</char>的額頭上，<char style="pn">亞倫</char>要承擔有關神聖之物的罪責——神聖之物是<char style="pn">以色列</char>子孫分別為聖的所有神聖的禮物；牌子要常在<char style="pn">亞倫</char>的額頭上，好使他們在耶和華面前蒙悅納。<verse eid="EXO 28:38" /></para>
  <para style="s">祭司的其他衣飾</para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39" />「你要用細麻編織袍子，用細麻布做頂冠，以刺繡的工藝做腰帶。 <verse eid="EXO 28:39" /><verse number="40" style="v" sid="EXO 28:40" />你要為<char style="pn">亞倫</char>的兒子們做袍子，為他們做腰帶，為他們做頭巾，以顯出榮耀、華美。 <verse eid="EXO 28:40" /><verse number="41" style="v" sid="EXO 28:41" />你要把這些給你的哥哥<char style="pn">亞倫</char>和他的兒子們穿上，又膏抹他們，使他們承接聖職、分別為聖，作祭司事奉我。 <verse eid="EXO 28:41" /><verse number="42" style="v" sid="EXO 28:42" />你要用細麻布為他們做褲子，遮蔽下體，從腰間直到大腿。 <verse eid="EXO 28:42" /><verse number="43" style="v" sid="EXO 28:43" /><char style="pn">亞倫</char>和他的兒子們進入會幕，或接近祭壇，在聖所事奉的時候，要把褲子穿上，使他們不致承擔罪責而死。這要成為<char style="pn">亞倫</char>和他的後裔永遠的律例。<verse eid="EXO 28:43" /></para>
  <chapter eid="EXO 28" />
  <chapter number="29" style="c" sid="EXO 29" />
  <para style="s">祭司的聖職禮</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1" />「你要為他們做以下的事，使他們分別為聖，作祭司事奉我：取一頭公牛、兩隻無瑕疵的公綿羊， <verse eid="EXO 29:1" /><verse number="2" style="v" sid="EXO 29:2" />以及無酵餅、調了油的無酵餅和抹上油的無酵薄餅；你要用麥子的細麵粉做這些餅。 <verse eid="EXO 29:2" /><verse number="3" style="v" sid="EXO 29:3" />你要把這些餅放在一個籃子裡，用籃子帶來，也把公牛和兩隻公綿羊都帶來。 <verse eid="EXO 29:3" /><verse number="4" style="v" sid="EXO 29:4" />你要把<char style="pn">亞倫</char>和他的兒子們帶到會幕的入口，用水洗他們； <verse eid="EXO 29:4" /><verse number="5" style="v" sid="EXO 29:5" />拿來衣裝，給<char style="pn">亞倫</char>穿上袍子、以弗得的外袍、以弗得和胸牌，給他束上以弗得的精巧織帶； <verse eid="EXO 29:5" /><verse number="6" style="v" sid="EXO 29:6" />並且把頂冠戴在他的頭上，把聖冠安在頂冠上； <verse eid="EXO 29:6" /><verse number="7" style="v" sid="EXO 29:7" />又拿來膏油，澆在他的頭上，膏抹他。 <verse eid="EXO 29:7" /><verse number="8" style="v" sid="EXO 29:8" />然後你要把他的兒子們帶來，給他們穿上袍子， <verse eid="EXO 29:8" /><verse number="9" style="v" sid="EXO 29:9" />給<char style="pn">亞倫</char>和他的兒子們束上腰帶，戴上頭巾。這樣，他們就按著永遠的律例擁有祭司的職份。你要這樣使<char style="pn">亞倫</char>和他的兒子們承接聖職。<verse eid="EXO 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10" />「你要把公牛帶到會幕前，<char style="pn">亞倫</char>和他的兒子們要按手在這公牛的頭上。 <verse eid="EXO 29:10" /><verse number="11" style="v" sid="EXO 29:11" />你要在耶和華面前，在會幕的入口，宰殺這公牛， <verse eid="EXO 29:11" /><verse number="12" style="v" sid="EXO 29:12" />取一些公牛的血，用手指抹在祭壇犄角上，把其餘的血全都倒在祭壇的基座那裡。 <verse eid="EXO 29:12" /><verse number="13" style="v" sid="EXO 29:13" />你要取出所有覆蓋內臟的脂肪、肝葉、兩個腎臟和其上的脂肪，在祭壇上燒獻為煙。 <verse eid="EXO 29:13" /><verse number="14" style="v" sid="EXO 29:14" />至於公牛的肉、皮、糞便，都要在營地外面用火燒掉。這是贖罪祭。<verse eid="EXO 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15" />「你要取一隻公綿羊，<char style="pn">亞倫</char>和他的兒子們要按手在這公綿羊的頭上。 <verse eid="EXO 29:15" /><verse number="16" style="v" sid="EXO 29:16" />你要宰殺這公綿羊，取一些血，灑在祭壇四壁。 <verse eid="EXO 29:16" /><verse number="17" style="v" sid="EXO 29:17" />你要把公綿羊切成碎塊，洗淨內臟和腿，把它們與碎塊和頭放在一起， <verse eid="EXO 29:17" /><verse number="18" style="v" sid="EXO 29:18" />把整隻公綿羊在祭壇上燒獻為煙。這是獻給耶和華的燔祭，是獻給耶和華的馨香火祭。<verse eid="EXO 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19" />「你要取另一隻公綿羊，<char style="pn">亞倫</char>和他的兒子們要按手在這公綿羊的頭上。 <verse eid="EXO 29:19" /><verse number="20" style="v" sid="EXO 29:20" />你要宰殺這公綿羊，取一些血，抹在<char style="pn">亞倫</char>的右耳垂和他兒子們的右耳垂上，以及他們右手的拇指和右腳的拇趾上，把其餘的血灑在祭壇四壁。 <verse eid="EXO 29:20" /><verse number="21" style="v" sid="EXO 29:21" />你要取一些祭壇上的血，也取一些膏油，彈灑在<char style="pn">亞倫</char>和他的衣服上，以及他的兒子們和他們的衣服上。這樣，<char style="pn">亞倫</char>和他的衣服，他的兒子們和他們的衣服，就都分別為聖了。<verse eid="EXO 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22" />「你要從這公綿羊取出脂肪、肥尾巴、覆蓋內臟的脂肪、肝葉、兩個腎臟和其上的脂肪，以及右大腿，因為這是聖職禮所用的公綿羊； <verse eid="EXO 29:22" /><verse number="23" style="v" sid="EXO 29:23" />又要從耶和華面前的無酵餅籃子裡取一塊餅、一塊油餅和一塊薄餅； <verse eid="EXO 29:23" /><verse number="24" style="v" sid="EXO 29:24" />你要把這一切都放在<char style="pn">亞倫</char>的手中和他兒子們的手中，作為搖獻祭物在耶和華面前搖一搖。 <verse eid="EXO 29:24" /><verse number="25" style="v" sid="EXO 29:25" />然後，你要從他們的手中把這些取過來，連同燔祭在祭壇上燒獻為煙，作為耶和華面前的馨香之氣。這是獻給耶和華的火祭。<verse eid="EXO 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 29:26" />「你要取<char style="pn">亞倫</char>聖職禮所用的公綿羊的胸肉，作為搖獻祭物在耶和華面前搖一搖；這是你的份。 <verse eid="EXO 29:26" /><verse number="27" style="v" sid="EXO 29:27" />搖獻的胸肉和供物的大腿，就是<char style="pn">亞倫</char>和他的兒子們聖職禮所用的公綿羊身上取下被搖過被奉上的部分，你要分別為聖。 <verse eid="EXO 29:27" /><verse number="28" style="v" sid="EXO 29:28" />這是<char style="pn">亞倫</char>和他的子孫從<char style="pn">以色列</char>子孫所得永遠的份例，因為這是供物；這是從<char style="pn">以色列</char>子孫所得、從他們的平安祭物中取出的供物，獻給耶和華的供物。<verse eid="EXO 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29" />「<char style="pn">亞倫</char>的聖衣要傳給他的後代子孫，他們要穿著受膏抹，承接聖職。 <verse eid="EXO 29:29" /><verse number="30" style="v" sid="EXO 29:30" /><char style="pn">亞倫</char>的子孫中接替他作祭司的，進入會幕在聖所中事奉，都要穿聖衣七天。<verse eid="EXO 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31" />「你要取聖職禮所用的公綿羊，在神聖的地方煮牠的肉。 <verse eid="EXO 29:31" /><verse number="32" style="v" sid="EXO 29:32" /><char style="pn">亞倫</char>和他的兒子們要在會幕的入口吃公綿羊的肉和籃子裡的餅。 <verse eid="EXO 29:32" /><verse number="33" style="v" sid="EXO 29:33" />他們承接聖職、分別為聖時用來贖罪的那些祭物，只有他們可以吃，他們以外的人不可以吃，因為那些是神聖之物。 <verse eid="EXO 29:33" /><verse number="34" style="v" sid="EXO 29:34" />聖職禮所用的肉或餅，如果有剩下的留到早晨，就要用火燒掉，不可以吃，因為那是神聖之物。<verse eid="EXO 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 29:35" />「你要照著我吩咐你的一切，向<char style="pn">亞倫</char>和他的兒子們這樣做，用七天使他們承接聖職。 <verse eid="EXO 29:35" /><verse number="36" style="v" sid="EXO 29:36" />你要每天獻一頭公牛作為贖罪祭用來贖罪；你要為祭壇行贖罪禮，使它潔淨；要膏抹它，使它分別為聖。 <verse eid="EXO 29:36" /><verse number="37" style="v" sid="EXO 29:37" />你要為祭壇行贖罪禮七天，使它分別為聖。這樣，祭壇就成為至聖的，所有碰祭壇的也都分別為聖了。<verse eid="EXO 29:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38" />「以下是你要在祭壇上所獻的：每天兩隻一歲的羊羔，持續不斷； <verse eid="EXO 29:38" /><verse number="39" style="v" sid="EXO 29:39" />早晨獻上一隻羊羔，黃昏的時候獻上另一隻羊羔。 <verse eid="EXO 29:39" /><verse number="40" style="v" sid="EXO 29:40" />與第一隻羊羔一同獻上的，要有十分之一伊法<note caller="+" style="f"><char style="fr" closed="false">29:40 </char><char style="ft" closed="false">十分之一伊法——相當於2.2公升。1伊法=22公升。</char></note>細麵粉與四分之一欣<note caller="+" style="f"><char style="fr" closed="false">29:40 </char><char style="ft" closed="false">四分之一欣——相當於0.9公升；下同。1欣=3.7公升。</char></note>壓榨的油調和的素祭<note caller="+" style="f"><char style="fr" closed="false">29:40 </char><char style="ft" closed="false">素祭——輔助詞語。</char></note>，以及四分之一欣酒的酒祭。 <verse eid="EXO 29:40" /><verse number="41" style="v" sid="EXO 29:41" />第二隻羊羔要在黃昏的時候獻上，要一同獻上早晨那樣的素祭和酒祭。這是獻給耶和華的馨香火祭。 <verse eid="EXO 29:41" /><verse number="42" style="v" sid="EXO 29:42" />這要作為你們世世代代常獻的燔祭，在會幕的入口，在耶和華面前——在那裡我要與你們相會，在那裡向你說話。 <verse eid="EXO 29:42" /><verse number="43" style="v" sid="EXO 29:43" />在那裡我要與<char style="pn">以色列</char>子孫相會，那裡就必因我的榮耀分別為聖。 <verse eid="EXO 29:43" /><verse number="44" style="v" sid="EXO 29:44" />我要使會幕和祭壇分別為聖，也要使<char style="pn">亞倫</char>和他的兒子們分別為聖，作祭司事奉我。 <verse eid="EXO 29:44" /><verse number="45" style="v" sid="EXO 29:45" />我要住在<char style="pn">以色列</char>子孫中間，作他們的神。 <verse eid="EXO 29:45" /><verse number="46" style="v" sid="EXO 29:46" />這樣他們就知道：我是耶和華他們的神，是我把他們從<char style="pn">埃及</char>地領出來，為要居住在他們中間。我是耶和華他們的神。<verse eid="EXO 29:46" /></para>
  <chapter eid="EXO 29" />
  <chapter number="30" style="c" sid="EXO 30" />
  <para style="s">香壇</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1" />「你要造一座焚香的壇，用金合歡木來造， <verse eid="EXO 30:1" /><verse number="2" style="v" sid="EXO 30:2" />長一肘<note caller="+" style="f"><char style="fr" closed="false">30:2 </char><char style="ft" closed="false">一肘——相當於45.7公分；下同。</char></note>，寬一肘，是方形的，高二肘<note caller="+" style="f"><char style="fr" closed="false">30:2 </char><char style="ft" closed="false">二肘——相當於91.4公分。</char></note>；犄角從壇而出。 <verse eid="EXO 30:2" /><verse number="3" style="v" sid="EXO 30:3" />你要把壇包上純金，壇的頂部、壇的四邊和壇的犄角都要包上，並在壇的四圍鑲上金邊； <verse eid="EXO 30:3" /><verse number="4" style="v" sid="EXO 30:4" />又要在金邊之下、在壇的相對兩邊為壇做兩個金環，用來穿杠抬壇。 <verse eid="EXO 30:4" /><verse number="5" style="v" sid="EXO 30:5" />你要用金合歡木做兩根杠，把它們包上金。<verse eid="EXO 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 30:6" />「你要把壇放在靠近見證櫃的<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="ft" closed="false">靠近見證櫃的——原文直譯「見證櫃前面的」。</char></note>幔子前，對著見證櫃上的施恩座——我與你相會的地方。 <verse eid="EXO 30:6" /><verse number="7" style="v" sid="EXO 30:7" /><char style="pn">亞倫</char>要在壇上燒獻芬芳香：每天早晨他照管燈的時候，都要燒獻這香； <verse eid="EXO 30:7" /><verse number="8" style="v" sid="EXO 30:8" />黃昏<char style="pn">亞倫</char>點燈的時候，也要燒獻這香；這要作為你們世世代代在耶和華面前常獻的香。 <verse eid="EXO 30:8" /><verse number="9" style="v" sid="EXO 30:9" />你們不可在壇上獻異樣的香、燔祭、素祭，也不可在壇上澆奠酒祭。<verse eid="EXO 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 30:10" />「<char style="pn">亞倫</char>要一年一次在壇的犄角上贖罪，一年一次用贖罪祭牲的血在壇上贖罪；你們世世代代都要這樣做。這壇是歸耶和華為至聖的。」<verse eid="EXO 30:10" /></para>
  <para style="s">贖罪銀</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11" />耶和華指示<char style="pn">摩西</char>說： <verse eid="EXO 30:11" /><verse number="12" style="v" sid="EXO 30:12" />「當你統計<char style="pn">以色列</char>子孫的人口數點他們的時候，各人要在你數點他們的時候向耶和華付上他們性命的贖價；這樣災殃就不會在數點他們的時候臨到他們。 <verse eid="EXO 30:12" /><verse number="13" style="v" sid="EXO 30:13" />所有通過數點歸入被數之眾的人，都要付上這贖價：按聖所的謝克爾<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="ft" closed="false">謝克爾——重量單位；後來成為貨幣單位。1謝克爾=11.4公克。本章下同。</char></note>標準付上半謝克爾<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="ft" closed="false">半謝克爾——相當於5.7公克；下同。1謝克爾=11.4公克。</char></note>——一謝克爾是二十季拉<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="ft" closed="false">二十季拉——相當於11.4公克。1季拉=0.57公克。</char></note>——這半謝克爾是獻給耶和華的供物。 <verse eid="EXO 30:13" /><verse number="14" style="v" sid="EXO 30:14" />所有通過數點歸入被數之眾的人，二十歲以上的，都要把供物獻給耶和華。 <verse eid="EXO 30:14" /><verse number="15" style="v" sid="EXO 30:15" />富人不可多付，窮人不可少付，都要付半謝克爾，獻給耶和華作供物，為你們的性命贖罪。 <verse eid="EXO 30:15" /><verse number="16" style="v" sid="EXO 30:16" />你要從<char style="pn">以色列</char>子孫收取這贖罪銀，用在會幕的服事上，使它為<char style="pn">以色列</char>子孫在耶和華面前作記念，為你們的性命贖罪。」<verse eid="EXO 30:16" /></para>
  <para style="s">銅盆</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17" />耶和華指示<char style="pn">摩西</char>說： <verse eid="EXO 30:17" /><verse number="18" style="v" sid="EXO 30:18" />「你要做一個用於洗濯的銅盆和銅盆座，放在會幕和祭壇之間，盆中盛水。 <verse eid="EXO 30:18" /><verse number="19" style="v" sid="EXO 30:19" /><char style="pn">亞倫</char>和他的兒子們要在盆中洗手洗腳。 <verse eid="EXO 30:19" /><verse number="20" style="v" sid="EXO 30:20" />當他們進入會幕，或接近祭壇事奉、燒獻火祭給耶和華的時候，他們要用水洗濯，免得死亡； <verse eid="EXO 30:20" /><verse number="21" style="v" sid="EXO 30:21" />他們要洗手洗腳，免得死亡。這要成為<char style="pn">亞倫</char>和他的後裔世世代代永遠的定例。」<verse eid="EXO 30:21" /></para>
  <para style="s">膏油</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22" />耶和華指示<char style="pn">摩西</char>說： <verse eid="EXO 30:22" /><verse number="23" style="v" sid="EXO 30:23" />「你要取上等的香料：沒藥液五百謝克爾<note caller="+" style="f"><char style="fr" closed="false">30:23 </char><char style="ft" closed="false">五百謝克爾——相當於5.7公斤；下同。1謝克爾=11.4公克。</char></note>、香肉桂是沒藥的一半——兩百五十謝克爾<note caller="+" style="f"><char style="fr" closed="false">30:23 </char><char style="ft" closed="false">兩百五十謝克爾——相當於2.85公斤；下同。1謝克爾=11.4公克。</char></note>、香菖蒲兩百五十謝克爾、 <verse eid="EXO 30:23" /><verse number="24" style="v" sid="EXO 30:24" />桂皮五百謝克爾，都要按聖所的謝克爾標準；又要取橄欖油一欣<note caller="+" style="f"><char style="fr" closed="false">30:24 </char><char style="ft" closed="false">一欣——相當於3.7公升。</char></note>。 <verse eid="EXO 30:24" /><verse number="25" style="v" sid="EXO 30:25" />你要用這些來製作聖膏油，就是用調配師的做法調配的香膏。這要成為聖膏油。<verse eid="EXO 30:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 30:26" />「你要用它膏抹會幕和見證櫃、 <verse eid="EXO 30:26" /><verse number="27" style="v" sid="EXO 30:27" />桌子和桌子的一切器具、燈臺和燈臺的器具、香壇、 <verse eid="EXO 30:27" /><verse number="28" style="v" sid="EXO 30:28" />燔祭的祭壇和祭壇的一切器具、洗濯盆和盆座。 <verse eid="EXO 30:28" /><verse number="29" style="v" sid="EXO 30:29" />你要把它們分別為聖，它們就成為至聖的；所有碰它們的也都分別為聖了。 <verse eid="EXO 30:29" /><verse number="30" style="v" sid="EXO 30:30" />你要膏抹<char style="pn">亞倫</char>和他的兒子們，使他們分別為聖，作祭司事奉我。<verse eid="EXO 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 30:31" />「你要吩咐<char style="pn">以色列</char>子孫說：『你們世世代代要把這膏油歸我作聖膏油。 <verse eid="EXO 30:31" /><verse number="32" style="v" sid="EXO 30:32" />不可澆在一般人的身上，也不可照著它的配方去製作膏油；這膏油是神聖的，你們要把它當作神聖的。 <verse eid="EXO 30:32" /><verse number="33" style="v" sid="EXO 30:33" />任何人照著這膏油去調配，或把膏油抹在祭司以外的人身上，就要從民中被剪除。』」<verse eid="EXO 30:33" /></para>
  <para style="s">香</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34" />耶和華對<char style="pn">摩西</char>說：「你要取芬芳的香料：蘇合香、螺香、白松香；這些芬芳的香料和純淨的乳香，分量要相等。 <verse eid="EXO 30:34" /><verse number="35" style="v" sid="EXO 30:35" />你要用這些做香，就是用調配師的做法調配，是加鹽的、純淨的、神聖的。 <verse eid="EXO 30:35" /><verse number="36" style="v" sid="EXO 30:36" />你要把一些香搗成粉末，放一些在會幕中的見證櫃前——我與你相會的地方；你們要以這香為至聖。 <verse eid="EXO 30:36" /><verse number="37" style="v" sid="EXO 30:37" />你所做的這香，不可照著它的配方為自己做；你要把這香當作神聖的，歸給耶和華。 <verse eid="EXO 30:37" /><verse number="38" style="v" sid="EXO 30:38" />任何人照著這香去做，為要聞它的香味，就要從民中被剪除。」<verse eid="EXO 30:38" /></para>
  <chapter eid="EXO 30" />
  <chapter number="31" style="c" sid="EXO 31" />
  <para style="s">造會幕的技工</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1" />耶和華對<char style="pn">摩西</char>說： <verse eid="EXO 31:1" /><verse number="2" style="v" sid="EXO 31:2" />「你看，我已經提名召喚了<char style="pn">猶大</char>支派中<char style="pn">戶珥</char>的孫子、<char style="pn">烏利</char>的兒子<char style="pn">比撒列</char>！ <verse eid="EXO 31:2" /><verse number="3" style="v" sid="EXO 31:3" />我用神的靈充滿了他，使他有智慧、聰慧、知識、各樣的技藝， <verse eid="EXO 31:3" /><verse number="4" style="v" sid="EXO 31:4" />能構思藝術設計，能做金、銀、銅的工藝， <verse eid="EXO 31:4" /><verse number="5" style="v" sid="EXO 31:5" />能做鑲嵌寶石的石雕工藝，又能做木雕工藝，為要做各樣的工藝。 <verse eid="EXO 31:5" /><verse number="6" style="v" sid="EXO 31:6" />看哪，我指定了<char style="pn">但</char>支派中<char style="pn">亞希撒抹</char>的兒子<char style="pn">亞何利亞伯</char>與他一起！一切有才能<note caller="+" style="f"><char style="fr" closed="false">31:6 </char><char style="ft" closed="false">有才能——原文直譯「心裡有智慧」。</char></note>的，我在他們心裡賜下了智慧，好使他們做我吩咐你的一切： <verse eid="EXO 31:6" /><verse number="7" style="v" sid="EXO 31:7" />會幕、見證櫃和其上的施恩座、會幕中的一切器具、 <verse eid="EXO 31:7" /><verse number="8" style="v" sid="EXO 31:8" />桌子和桌子的器具、純金的燈臺和燈臺的一切器具、香壇、 <verse eid="EXO 31:8" /><verse number="9" style="v" sid="EXO 31:9" />燔祭的祭壇和祭壇的一切器具、洗濯盆和盆座、 <verse eid="EXO 31:9" /><verse number="10" style="v" sid="EXO 31:10" />編織的衣服——祭司<char style="pn">亞倫</char>的聖衣和他兒子們作祭司事奉時的衣服、 <verse eid="EXO 31:10" /><verse number="11" style="v" sid="EXO 31:11" />膏油和聖所用的芬芳香；他們要照著我吩咐你的一切去做。」<verse eid="EXO 31:11" /></para>
  <para style="s">安息日</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12" />耶和華指示<char style="pn">摩西</char>說： <verse eid="EXO 31:12" /><verse number="13" style="v" sid="EXO 31:13" />「你要吩咐<char style="pn">以色列</char>子孫說：『你們一定要謹守我的安息日，因為這是我與你們之間世世代代的標記，好使你們知道：我是把你們分別為聖的耶和華。 <verse eid="EXO 31:13" /><verse number="14" style="v" sid="EXO 31:14" />因此你們要謹守安息日，因為這日是給你們的聖日。凡褻瀆這日的，必須被處死；任何人在這日做工，就要從民中被剪除。 <verse eid="EXO 31:14" /><verse number="15" style="v" sid="EXO 31:15" />六天可以做工，但第七天是完全安息的安息日，是歸耶和華為聖的；任何人在安息日做工，就必須被處死。 <verse eid="EXO 31:15" /><verse number="16" style="v" sid="EXO 31:16" />因此<char style="pn">以色列</char>子孫要謹守安息日，他們世世代代要持守<note caller="+" style="f"><char style="fr" closed="false">31:16 </char><char style="ft" closed="false">持守——原文直譯「遵行」。</char></note>安息日，作為永遠的約。 <verse eid="EXO 31:16" /><verse number="17" style="v" sid="EXO 31:17" />這是我與<char style="pn">以色列</char>子孫之間的標記，直到永遠，因為六日中耶和華造了諸天和大地，在第七日他就安息、休息了。』」<verse eid="EXO 31:17" /></para>
  <para style="s">兩塊見證版</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 31:18" />耶和華在<char style="pn">西奈</char>山與<char style="pn">摩西</char>說完了話，就交給他兩塊見證版，就是神用手指寫下的石版。<verse eid="EXO 31:18" /></para>
  <chapter eid="EXO 31" />
  <chapter number="32" style="c" sid="EXO 32" />
  <para style="s">金牛犢</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1" />百姓見<char style="pn">摩西</char>遲遲不下山，就聚集到<char style="pn">亞倫</char>那裡，對他說：「起來！為我們造一個行走在我們前面的神明，因為那<char style="pn">摩西</char>，就是把我們從<char style="pn">埃及</char>地帶上來的那個人，我們不知道他發生了什麼事。」<verse eid="EXO 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 32:2" />
    <char style="pn">亞倫</char>對他們說：「把你們妻子兒女耳朵上的金環摘下，拿來給我！」 <verse eid="EXO 32:2" /><verse number="3" style="v" sid="EXO 32:3" />全體民眾就把他們耳朵上的金環摘下，拿來給<char style="pn">亞倫</char>。 <verse eid="EXO 32:3" /><verse number="4" style="v" sid="EXO 32:4" /><char style="pn">亞倫</char>從他們的手中接過來，用雕刻工具做模子，造了一個牛犢鑄像。</para>
  <para style="p" vid="EXO 32:4">他們就說：「<char style="pn">以色列</char>啊，這是你的神，是把你從<char style="pn">埃及</char>地帶上來的那一位！」<verse eid="EXO 32:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 32:5" />
    <char style="pn">亞倫</char>看見，就在牛犢前面築了一座祭壇；<char style="pn">亞倫</char>宣告說：「明天是耶和華的節期。」 <verse eid="EXO 32:5" /><verse number="6" style="v" sid="EXO 32:6" />第二天，他們早早起來獻上了燔祭，也帶來了平安祭，然後百姓坐下吃喝，起來玩樂。<verse eid="EXO 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7" />耶和華對<char style="pn">摩西</char>說：「你趕快下去！因為你從<char style="pn">埃及</char>地帶上來的百姓已經敗壞了。 <verse eid="EXO 32:7" /><verse number="8" style="v" sid="EXO 32:8" />他們很快就偏離了我指示他們的道路，為自己造了一個牛犢鑄像，向它下拜，向它獻祭，說：『<char style="pn">以色列</char>啊，這是你的神，是把你從<char style="pn">埃及</char>地帶上來的那一位！』」 <verse eid="EXO 32:8" /><verse number="9" style="v" sid="EXO 32:9" />耶和華又對<char style="pn">摩西</char>說：「我看見這子民，看哪，他們是硬著頸項的子民！ <verse eid="EXO 32:9" /><verse number="10" style="v" sid="EXO 32:10" />現在，你由著我，我的怒氣要向他們發作，我要滅絕他們，然後我要使你成為一個強大的民族。」<verse eid="EXO 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11" />
    <char style="pn">摩西</char>就懇求他的神耶和華的情面，說：「耶和華啊，你的怒氣為什麼要向你的子民發作呢？他們是你以偉大的能力，用大能的手，從<char style="pn">埃及</char>地領出來的。 <verse eid="EXO 32:11" /><verse number="12" style="v" sid="EXO 32:12" />為什麼要讓<char style="pn">埃及</char>人說『他出於惡意領他們出來，為要在山中殺死他們，從地面上滅絕他們』？求你轉消你猛烈的怒氣，改變心意，不向你的子民降災禍。 <verse eid="EXO 32:12" /><verse number="13" style="v" sid="EXO 32:13" />求你記念你的僕人<char style="pn">亞伯拉罕</char>、<char style="pn">以撒</char>和<char style="pn">以色列</char>；你曾經指著自己向他們起誓，對他們說：『我必使你們的後裔增多，如同天上的星辰，我必把我說過的這全地都賜給你們的後裔；他們必繼承這地，直到永遠。』」 <verse eid="EXO 32:13" /><verse number="14" style="v" sid="EXO 32:14" />於是，耶和華改變心意，不把他所說的災禍降在他的子民身上。<verse eid="EXO 32:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15" />
    <char style="pn">摩西</char>轉身從山上下來，手中拿著兩塊見證版；這版兩面都寫著字，正面背面都寫著字。 <verse eid="EXO 32:15" /><verse number="16" style="v" sid="EXO 32:16" />這版是神的工作，文字是神的文字，刻在版上。<verse eid="EXO 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17" />
    <char style="pn">約書亞</char>聽見百姓喊叫的聲音，就對<char style="pn">摩西</char>說：「營中有戰爭的聲音。」<verse eid="EXO 32:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18" />
    <char style="pn">摩西</char>說：</para>
  <para style="q1" vid="EXO 32:18">「這不是戰勝呼叫的聲音，</para>
  <para style="q1" vid="EXO 32:18">也不是戰敗呼叫的聲音，</para>
  <para style="q1" vid="EXO 32:18">我聽見的是歌唱的聲音。」<verse eid="EXO 32:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="EXO 32:19" />
    <char style="pn">摩西</char>靠近營地，看見牛犢，又看見人在跳舞，<char style="pn">摩西</char>就怒氣發作，他把兩塊版從手中扔出，摔碎在山下； <verse eid="EXO 32:19" /><verse number="20" style="v" sid="EXO 32:20" />又把他們造的牛犢拿過來，用火焚燒，磨成粉末，撒在水面上，讓<char style="pn">以色列</char>子孫喝。<verse eid="EXO 32:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 32:21" />
    <char style="pn">摩西</char>對<char style="pn">亞倫</char>說：「這百姓對你做了什麼，以致你把這大罪帶給了他們？」<verse eid="EXO 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 32:22" />
    <char style="pn">亞倫</char>說：「求我主不要怒氣發作；你是知道這百姓的，他們傾向罪惡<note caller="+" style="f"><char style="fr" closed="false">32:22 </char><char style="ft" closed="false">傾向罪惡——原文直譯「在罪惡中」。</char></note>。 <verse eid="EXO 32:22" /><verse number="23" style="v" sid="EXO 32:23" />他們對我說：『為我們造一個行走在我們前面的神明，因為那<char style="pn">摩西</char>，就是把我們從<char style="pn">埃及</char>地帶上來的那個人，我們不知道他發生了什麼事。』 <verse eid="EXO 32:23" /><verse number="24" style="v" sid="EXO 32:24" />我對他們說『誰有金子就摘下來』，他們就給了我；我把金子扔進火中，這牛犢就出來了！」<verse eid="EXO 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25" />
    <char style="pn">摩西</char>看見百姓放縱——因為<char style="pn">亞倫</char>放縱他們，使他們在敵人中成為笑柄—— <verse eid="EXO 32:25" /><verse number="26" style="v" sid="EXO 32:26" /><char style="pn">摩西</char>就站在營門口，說：「誰屬於耶和華，到我這裡來！」於是所有的<char style="pn">利未</char>子孫都聚集到他那裡。 <verse eid="EXO 32:26" /><verse number="27" style="v" sid="EXO 32:27" /><char style="pn">摩西</char>對他們說：「<char style="pn">以色列</char>的神耶和華如此說：『你們各人要把刀佩在大腿上，在營中往來，從一個門到另一個門，各人要殺死自己的兄弟、朋友和親屬。』」 <verse eid="EXO 32:27" /><verse number="28" style="v" sid="EXO 32:28" /><char style="pn">利未</char>的子孫就照著<char style="pn">摩西</char>的話去做了。那一天，百姓中倒下的約有三千人。 <verse eid="EXO 32:28" /><verse number="29" style="v" sid="EXO 32:29" /><char style="pn">摩西</char>說：「今天你們已經奉獻自己<note caller="+" style="f"><char style="fr" closed="false">32:29 </char><char style="ft" closed="false">已經奉獻自己——或譯作「要承接聖職」。</char></note>歸於耶和華，因為你們各人與自己的兒子和兄弟對立，今天給自己帶來了祝福。」<verse eid="EXO 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30" />第二天，<char style="pn">摩西</char>對百姓說：「你們犯了大罪，現在我要上到耶和華那裡去，或許我可以為你們贖罪。」<verse eid="EXO 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 32:31" />
    <char style="pn">摩西</char>回到耶和華那裡，說：「哦，這百姓犯了大罪，為自己造了金神像！ <verse eid="EXO 32:31" /><verse number="32" style="v" sid="EXO 32:32" />現在，求你饒恕他們的罪；不然，請你把我從你所記的冊子上抹掉吧！」<verse eid="EXO 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 32:33" />耶和華對<char style="pn">摩西</char>說：「誰對我犯罪，我就把誰從我的冊子上抹掉。 <verse eid="EXO 32:33" /><verse number="34" style="v" sid="EXO 32:34" />現在你去，引導子民到我所告訴你的地方！看哪，我的使者必行走在你的前面！不過，在我懲罰的日子，我必懲罰他們的罪。」 <verse eid="EXO 32:34" /><verse number="35" style="v" sid="EXO 32:35" />耶和華打擊百姓，是因為他們向<char style="pn">亞倫</char>造的牛犢所做的事。<verse eid="EXO 32:35" /></para>
  <chapter eid="EXO 32" />
  <chapter number="33" style="c" sid="EXO 33" />
  <para style="s">營地外面的會幕</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1" />耶和華對<char style="pn">摩西</char>說：「去，你和你從<char style="pn">埃及</char>地帶上來的百姓要從這裡上去，進入我起誓要給<char style="pn">亞伯拉罕</char>、<char style="pn">以撒</char>、<char style="pn">雅各</char>的那地——我曾對他們說：『我必把這地賜給你的後裔』。 <verse eid="EXO 33:1" /><verse number="2" style="v" sid="EXO 33:2" />我必派遣使者在你前面，我必驅逐<char style="pn">迦南</char>人、<char style="pn">亞摩利</char>人、<char style="pn">赫提</char>人、<char style="pn">比利洗</char>人、<char style="pn">希未</char>人、<char style="pn">耶布斯</char>人。 <verse eid="EXO 33:2" /><verse number="3" style="v" sid="EXO 33:3" />你們要上到那流奶與蜜之地。我不在你們中間同你們一起上去，因為你們是硬著頸項的子民，免得我在路上滅絕你們。」 <verse eid="EXO 33:3" /><verse number="4" style="v" sid="EXO 33:4" />百姓聽見這個壞消息就悲慟，沒有人佩戴裝飾。<verse eid="EXO 33:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 33:5" />耶和華對<char style="pn">摩西</char>說：「你要對<char style="pn">以色列</char>子孫說：『你們是硬著頸項的子民，如果我在你們中間同你們一起上去，哪怕只是一瞬間也會滅絕你們。現在，你們要從你們身上取下裝飾，我好知道要怎麼處置你們。』」 <verse eid="EXO 33:5" /><verse number="6" style="v" sid="EXO 33:6" />於是，從<char style="pn">何烈</char>山起，<char style="pn">以色列</char>子孫就摘掉了他們的裝飾。<verse eid="EXO 33:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7" />
    <char style="pn">摩西</char>一向拿帳篷支搭在營地外面，離營地有一段距離；<char style="pn">摩西</char>稱呼它為「會幕」。所有尋求耶和華的，就到營地外面的會幕去。 <verse eid="EXO 33:7" /><verse number="8" style="v" sid="EXO 33:8" />每當<char style="pn">摩西</char>出去到那帳篷的時候，全體民眾就都起來，各人站在自己帳篷的入口，望著<char style="pn">摩西</char>，直到他進入那帳篷。 <verse eid="EXO 33:8" /><verse number="9" style="v" sid="EXO 33:9" />每當<char style="pn">摩西</char>進入那帳篷的時候，雲柱就降下來，停留在那帳篷的入口，耶和華就與<char style="pn">摩西</char>說話。 <verse eid="EXO 33:9" /><verse number="10" style="v" sid="EXO 33:10" />全體民眾看見雲柱停留在帳篷入口的時候，就都起來，各人在自己帳篷的入口下拜。 <verse eid="EXO 33:10" /><verse number="11" style="v" sid="EXO 33:11" />耶和華與<char style="pn">摩西</char>面對面說話，就像人與朋友說話。<char style="pn">摩西</char>回到營地的時候，他的助手<note caller="+" style="f"><char style="fr" closed="false">33:11 </char><char style="ft" closed="false">助手——或譯作「侍從」。</char></note>，年輕人<char style="pn">嫩</char>的兒子<char style="pn">約書亞</char>卻不離開那帳篷。<verse eid="EXO 33:11" /></para>
  <para style="s">耶和華的榮耀</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12" />
    <char style="pn">摩西</char>對耶和華說：「看，你對我說『把這百姓帶上來』，卻沒有讓我知道你要派遣誰與我同去。你曾說：『我按你的名認識你，你也在我眼前蒙了恩。』 <verse eid="EXO 33:12" /><verse number="13" style="v" sid="EXO 33:13" />現在，如果我在你眼前蒙恩，求你使我明白你的道路，使我認識你，好讓我在你眼前蒙恩。看，這民是你的子民！」<verse eid="EXO 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14" />耶和華說：「我必親自與你同去，我必使你得安息。」<verse eid="EXO 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 33:15" />
    <char style="pn">摩西</char>對耶和華說：「如果你不親自與我們同去，就不要把我們從這裡帶上去。 <verse eid="EXO 33:15" /><verse number="16" style="v" sid="EXO 33:16" />人怎麼能知道我和你的子民在你眼前蒙恩呢？難道不是因為你與我們同去，才使我和你的子民從地面上的萬民中分別出來嗎？」<verse eid="EXO 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17" />耶和華對<char style="pn">摩西</char>說：「你所求的這事我必做，因為你在我眼前蒙恩，並且我按你的名認識你。」<verse eid="EXO 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18" />
    <char style="pn">摩西</char>說：「求你向我顯出你的榮耀。」<verse eid="EXO 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19" />耶和華說：「我要使我一切的美善在你面前經過，我要在你面前宣告耶和華的名。我要恩待誰就恩待誰，我要憐憫誰就憐憫誰。」 <verse eid="EXO 33:19" /><verse number="20" style="v" sid="EXO 33:20" />他又說：「你不能看見我的臉，因為沒有人看見我還能存活。」 <verse eid="EXO 33:20" /><verse number="21" style="v" sid="EXO 33:21" />耶和華說：「看哪，我這裡有個地方，你要站在磐石上！ <verse eid="EXO 33:21" /><verse number="22" style="v" sid="EXO 33:22" />我的榮耀經過的時候，我要把你放在磐石縫中，用我的手掌遮蔽你，直到我過去。 <verse eid="EXO 33:22" /><verse number="23" style="v" sid="EXO 33:23" />然後我會移開我的手掌，你就會看見我的背，卻不會看見我的臉。」<verse eid="EXO 33:23" /></para>
  <chapter eid="EXO 33" />
  <chapter number="34" style="c" sid="EXO 34" />
  <para style="s">新見證版</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1" />耶和華對<char style="pn">摩西</char>說：「你要鑿出兩塊石版，像先前的那樣；我要把你先前摔碎的石版上的話，寫在這兩塊石版上。 <verse eid="EXO 34:1" /><verse number="2" style="v" sid="EXO 34:2" />早晨之前，你要預備好；到了早晨，你要上<char style="pn">西奈</char>山，在山頂那裡站在我面前。 <verse eid="EXO 34:2" /><verse number="3" style="v" sid="EXO 34:3" />任何人都不可與你一同上來，整座山都不可有人，羊群和牛群也不可在這座山前面吃草。」<verse eid="EXO 34:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 34:4" />
    <char style="pn">摩西</char>就鑿出了兩塊石版，像先前的那樣；他清早起來，照著耶和華所指示他的，上到<char style="pn">西奈</char>山，手中拿著兩塊石版。<verse eid="EXO 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 34:5" />耶和華在雲彩中降臨，與<char style="pn">摩西</char>一同站在那裡，並宣告耶和華的名。 <verse eid="EXO 34:5" /><verse number="6" style="v" sid="EXO 34:6" />耶和華在<char style="pn">摩西</char>面前經過，宣告說：</para>
  <para style="mi" vid="EXO 34:6">「耶和華，耶和華，是有憐憫、有恩惠的神；他不輕易發怒，有豐盛的慈愛和信實， <verse eid="EXO 34:6" /><verse number="7" style="v" sid="EXO 34:7" />為千代存留慈愛，赦免罪孽、過犯和罪惡，但絕不會讓有罪的免於罪責，而會追究罪責，從父親到兒子、孫子，直到第三代、第四代。」<verse eid="EXO 34:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8" />
    <char style="pn">摩西</char>急忙俯身於地下拜。 <verse eid="EXO 34:8" /><verse number="9" style="v" sid="EXO 34:9" />他說：「主啊，如果我在你眼前蒙恩，求主在我們中間同我們一起去！雖然這是硬著頸項的百姓，但求你赦免我們的罪孽和罪惡，以我們為你的繼業。」<verse eid="EXO 34:9" /></para>
  <para style="s">重新立約</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10" />耶和華說：「看哪，我要立約！我要在你眾百姓面前行奇妙的事，是在全地、萬國中沒有行<note caller="+" style="f"><char style="fr" closed="false">34:10 </char><char style="ft" closed="false">行——原文直譯「創造」。</char></note>過的；你所在的萬民中，萬民必看見耶和華的作為，因為我向你行的是可畏的事。 <verse eid="EXO 34:10" /><verse number="11" style="v" sid="EXO 34:11" />我今天吩咐你的，你要遵守。看哪，我必從你們面前驅逐<char style="pn">亞摩利</char>人、<char style="pn">迦南</char>人、<char style="pn">赫提</char>人、<char style="pn">比利洗</char>人、<char style="pn">希未</char>人、<char style="pn">耶布斯</char>人！ <verse eid="EXO 34:11" /><verse number="12" style="v" sid="EXO 34:12" />你要謹慎，不可與你所去之地的居民立約，免得他們成為你們當中的陷阱。 <verse eid="EXO 34:12" /><verse number="13" style="v" sid="EXO 34:13" />你們要拆毀他們的祭壇，打碎他們的神柱，砍掉他們的<char style="pn">亞舍拉</char>柱。 <verse eid="EXO 34:13" /><verse number="14" style="v" sid="EXO 34:14" />你不可向別的神明下拜，因為耶和華他的名字是『嫉憤者』，他是嫉憤的神。<verse eid="EXO 34:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 34:15" />「你不可與那地的居民立約，因為他們行淫追隨他們的神明、向他們的神明獻祭的時候，有人邀請你，你就會吃他的祭物； <verse eid="EXO 34:15" /><verse number="16" style="v" sid="EXO 34:16" />你為你的兒子娶來他的女兒，他的女兒行淫追隨她們的神明，就會使你的兒子也行淫追隨她們的神明。<verse eid="EXO 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 34:17" />「不可為自己鑄造神像。<verse eid="EXO 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 34:18" />「你要守無酵節，照著我吩咐你的，在亞筆月所定的日期吃無酵餅七天，因為你是在亞筆月從<char style="pn">埃及</char>出來的。<verse eid="EXO 34:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 34:19" />「所有的頭胎都屬於我；你的牲畜中所有頭生的，無論是牛是羊，凡是公的都屬於我。 <verse eid="EXO 34:19" /><verse number="20" style="v" sid="EXO 34:20" />頭生的驢子，你要用羔羊贖回；如果不贖回，就要打斷牠的脖子。你兒子們中所有頭生的，你都要贖回；誰也不可空手朝見我。<verse eid="EXO 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21" />「六天你要勞碌，但第七天要安息；在耕種或收割的時候，也要安息。<verse eid="EXO 34:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 34:22" />「在收割初熟小麥的時候，你要守七七節；在過年的時候，你要守收藏節。 <verse eid="EXO 34:22" /><verse number="23" style="v" sid="EXO 34:23" />一年三次，你所有的男子都要朝見主耶和華<char style="pn">以色列</char>的神。 <verse eid="EXO 34:23" /><verse number="24" style="v" sid="EXO 34:24" />我必從你面前趕出列國，擴寬你的邊界；你一年三次上去朝見耶和華你神的時候，沒有人會貪圖你的土地。<verse eid="EXO 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25" />「不可把我祭物的血與有酵之物一起獻祭，也不可使逾越節的祭物過夜留到早晨。<verse eid="EXO 34:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 34:26" />「要把你土地裡上好的初熟之物帶到你神耶和華的殿中。</para>
  <para style="p" vid="EXO 34:26">「不可用母山羊的奶煮牠的小山羊。」<verse eid="EXO 34:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 34:27" />耶和華對<char style="pn">摩西</char>說：「你要把這些話語記下來，因為我是照著這些話語與你和<char style="pn">以色列</char>一起立約的。」<verse eid="EXO 34:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 34:28" />
    <char style="pn">摩西</char>在那裡與耶和華一起四十晝夜，沒有吃飯沒有喝水。耶和華把這約的話語，就是十誡，寫在兩塊版上。<verse eid="EXO 34:28" /></para>
  <para style="s">摩西臉皮發光</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29" />
    <char style="pn">摩西</char>從<char style="pn">西奈</char>山下來——下山的時候，<char style="pn">摩西</char>手中拿著兩塊見證版——<char style="pn">摩西</char>不知道自己的臉皮因他與耶和華說話而發光。 <verse eid="EXO 34:29" /><verse number="30" style="v" sid="EXO 34:30" /><char style="pn">亞倫</char>和所有的<char style="pn">以色列</char>子孫看見<char style="pn">摩西</char>，看哪，他的臉皮發光！他們就害怕接近他。 <verse eid="EXO 34:30" /><verse number="31" style="v" sid="EXO 34:31" /><char style="pn">摩西</char>呼叫他們，<char style="pn">亞倫</char>和所有的會眾領袖都回到他那裡，<char style="pn">摩西</char>就與他們說話。 <verse eid="EXO 34:31" /><verse number="32" style="v" sid="EXO 34:32" />之後，所有的<char style="pn">以色列</char>子孫近前來，<char style="pn">摩西</char>就把耶和華在<char style="pn">西奈</char>山上與他所說的一切都吩咐他們。 <verse eid="EXO 34:32" /><verse number="33" style="v" sid="EXO 34:33" /><char style="pn">摩西</char>與他們說完了話，就用帕子蒙上臉。 <verse eid="EXO 34:33" /><verse number="34" style="v" sid="EXO 34:34" />每當<char style="pn">摩西</char>來到耶和華面前與他說話的時候，<char style="pn">摩西</char>就把帕子取下，直到他出來；他出來後，就把耶和華所指示的告訴<char style="pn">以色列</char>子孫。 <verse eid="EXO 34:34" /><verse number="35" style="v" sid="EXO 34:35" /><char style="pn">以色列</char>子孫看見<char style="pn">摩西</char>的臉，見<char style="pn">摩西</char>的臉皮發光，<char style="pn">摩西</char>就再次用帕子蒙上臉，直到他進去與耶和華說話。<verse eid="EXO 34:35" /></para>
  <chapter eid="EXO 34" />
  <chapter number="35" style="c" sid="EXO 35" />
  <para style="s">安息日的條例</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1" />
    <char style="pn">摩西</char>招聚全體<char style="pn">以色列</char>會眾，對他們說：「以下是耶和華指示你們要做的事： <verse eid="EXO 35:1" /><verse number="2" style="v" sid="EXO 35:2" />六天可以做工，但第七天對你們是完全安息的安息日，是歸耶和華為聖的；任何人在這日做工，就要被處死。 <verse eid="EXO 35:2" /><verse number="3" style="v" sid="EXO 35:3" />在安息日，你們居住的任何地方都不可生火。」<verse eid="EXO 35:3" /></para>
  <para style="s">為會幕獻供物</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4" />
    <char style="pn">摩西</char>對全體<char style="pn">以色列</char>會眾說：「耶和華所指示的話是這樣的，他說： <verse eid="EXO 35:4" /><verse number="5" style="v" sid="EXO 35:5" />你們要從你們中間拿供物獻給耶和華；凡甘心樂意的，就把獻給耶和華的供物帶來：金、銀、銅， <verse eid="EXO 35:5" /><verse number="6" style="v" sid="EXO 35:6" />藍色線、紫色線、朱紅色線、細麻、山羊毛， <verse eid="EXO 35:6" /><verse number="7" style="v" sid="EXO 35:7" />染紅的公綿羊皮、海獅皮，金合歡木， <verse eid="EXO 35:7" /><verse number="8" style="v" sid="EXO 35:8" />點燈的油、製作膏油和芬芳香的香料， <verse eid="EXO 35:8" /><verse number="9" style="v" sid="EXO 35:9" />以及以弗得和胸牌上用的紅瑪瑙石和鑲嵌的寶石。<verse eid="EXO 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10" />「你們中間一切有才能<note caller="+" style="f"><char style="fr" closed="false">35:10 </char><char style="ft" closed="false">有才能——原文直譯「心裡有智慧」；本章下同。</char></note>的，都要來做耶和華所吩咐的一切： <verse eid="EXO 35:10" /><verse number="11" style="v" sid="EXO 35:11" />帳幕——帳幕的罩篷、頂罩、鉤子、木板、橫閂、柱子、底座、 <verse eid="EXO 35:11" /><verse number="12" style="v" sid="EXO 35:12" />櫃和櫃的杠、施恩座、簾幕的幔子、 <verse eid="EXO 35:12" /><verse number="13" style="v" sid="EXO 35:13" />桌子和桌子的杠、桌子的一切器具、陳設餅、 <verse eid="EXO 35:13" /><verse number="14" style="v" sid="EXO 35:14" />點燈的燈臺和燈臺的器具、燈和點燈的油、 <verse eid="EXO 35:14" /><verse number="15" style="v" sid="EXO 35:15" />香壇和香壇的杠、膏油和芬芳香、帳幕入口的門簾、 <verse eid="EXO 35:15" /><verse number="16" style="v" sid="EXO 35:16" />燔祭的祭壇、祭壇用的銅格網、祭壇的杠、祭壇的一切器具、洗濯盆和盆座、 <verse eid="EXO 35:16" /><verse number="17" style="v" sid="EXO 35:17" />院子的帷幔、帷幔的柱子、底座、院子的門簾、 <verse eid="EXO 35:17" /><verse number="18" style="v" sid="EXO 35:18" />帳幕的橛子、院子的橛子、帳幕和院子的繩子、 <verse eid="EXO 35:18" /><verse number="19" style="v" sid="EXO 35:19" />聖所事奉用的編織的衣服——祭司<char style="pn">亞倫</char>的聖衣和他兒子們作祭司事奉時的衣服。」<verse eid="EXO 35:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20" />全體<char style="pn">以色列</char>會眾就從<char style="pn">摩西</char>面前出去。 <verse eid="EXO 35:20" /><verse number="21" style="v" sid="EXO 35:21" />凡是心裡受激勵、甘心奉獻的人都來了，把獻給耶和華的供物帶來，用於做會幕的工作、各樣的服事和聖衣。 <verse eid="EXO 35:21" /><verse number="22" style="v" sid="EXO 35:22" />凡甘心樂意的男男女女都來了，把胸針、耳環、戒指、項鏈和一切的金器都帶來；他們每個人都把這些搖一搖，作為搖獻的金祭物，獻給耶和華。 <verse eid="EXO 35:22" /><verse number="23" style="v" sid="EXO 35:23" />凡有藍色線、紫色線、朱紅色線、細麻、山羊毛、染紅的公綿羊皮、海獅皮的人，都把它們帶來了。 <verse eid="EXO 35:23" /><verse number="24" style="v" sid="EXO 35:24" />凡奉上銀或銅為供物的，都把獻給耶和華的供物帶來了。凡有金合歡木用於工程上各樣工作的，都把它們帶來了。 <verse eid="EXO 35:24" /><verse number="25" style="v" sid="EXO 35:25" />凡有才能的女人都親手紡線，把所紡的藍色線、紫色線、朱紅色線和細麻都帶來了。 <verse eid="EXO 35:25" /><verse number="26" style="v" sid="EXO 35:26" />凡心裡受激勵、有智慧的女人，都紡山羊毛。 <verse eid="EXO 35:26" /><verse number="27" style="v" sid="EXO 35:27" />首領們把以弗得和胸牌上用的紅瑪瑙石和鑲嵌的寶石、 <verse eid="EXO 35:27" /><verse number="28" style="v" sid="EXO 35:28" />點燈的油、製作膏油和芬芳香的香料，都帶來了。 <verse eid="EXO 35:28" /><verse number="29" style="v" sid="EXO 35:29" />凡是甘心奉獻的<char style="pn">以色列</char>子孫，無論男女，都把甘心奉獻物帶來給耶和華，為要做耶和華藉著<char style="pn">摩西</char>所指示的一切工作。<verse eid="EXO 35:29" /></para>
  <para style="s">比撒列和亞何利亞伯</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30" />
    <char style="pn">摩西</char>對<char style="pn">以色列</char>子孫說：「你們看，耶和華已經提名召喚了<char style="pn">猶大</char>支派中<char style="pn">戶珥</char>的孫子、<char style="pn">烏利</char>的兒子<char style="pn">比撒列</char>！ <verse eid="EXO 35:30" /><verse number="31" style="v" sid="EXO 35:31" />耶和華用神的靈充滿了他，使他有智慧、聰慧、知識、各樣的技藝， <verse eid="EXO 35:31" /><verse number="32" style="v" sid="EXO 35:32" />能構思藝術設計，能做金、銀、銅的工藝， <verse eid="EXO 35:32" /><verse number="33" style="v" sid="EXO 35:33" />能做鑲嵌寶石的石雕工藝，又能做木雕工藝，為要做各樣的精巧工藝。 <verse eid="EXO 35:33" /><verse number="34" style="v" sid="EXO 35:34" />耶和華又把指教的能力放在他和<char style="pn">但</char>支派中<char style="pn">亞希撒抹</char>的兒子<char style="pn">亞何利亞伯</char>的心裡； <verse eid="EXO 35:34" /><verse number="35" style="v" sid="EXO 35:35" />並用智慧充滿他們的心，使他們擅長做各樣的工藝——雕刻，設計，用藍色、紫色、朱紅色線和細麻刺繡，以及紡織——使他們成為做各樣工藝的人和構思藝術設計的人。<verse eid="EXO 35:35" /></para>
  <chapter eid="EXO 35" />
  <chapter number="36" style="c" sid="EXO 36" />
  <para style="nb">
    <verse number="1" style="v" sid="EXO 36:1" />
    <char style="pn">比撒列</char>和<char style="pn">亞何利亞伯</char>，以及一切有才能<note caller="+" style="f"><char style="fr" closed="false">36:1 </char><char style="ft" closed="false">有才能——原文直譯「心裡有智慧」；本章下同。</char></note>的人，就是蒙耶和華賜智慧和聰慧在他們裡面、知道怎樣做聖所一切建造工作的人，都要照著耶和華所吩咐的一切去做。」<verse eid="EXO 36:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2" />
    <char style="pn">摩西</char>就召<char style="pn">比撒列</char>和<char style="pn">亞何利亞伯</char>，一切有才能的人，就是蒙耶和華賜智慧在他們心裡的人，以及所有心裡受激勵的人，近前來做這工作。 <verse eid="EXO 36:2" /><verse number="3" style="v" sid="EXO 36:3" />他們在<char style="pn">摩西</char>面前接受了<char style="pn">以色列</char>子孫為聖所的建造工作而帶來的一切供物。每天早晨，<char style="pn">以色列</char>子孫不斷地把甘心奉獻物帶來給<char style="pn">摩西</char>。<verse eid="EXO 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 36:4" />那些做聖所一切工作的巧匠<note caller="+" style="f"><char style="fr" closed="false">36:4 </char><char style="ft" closed="false">巧匠——原文直譯「智慧人」。</char></note>，各人放下自己在做的工作， <verse eid="EXO 36:4" /><verse number="5" style="v" sid="EXO 36:5" />來告訴<char style="pn">摩西</char>說：「百姓帶來的太多，已經超過了耶和華指示要做的建造工作所需要的。」<verse eid="EXO 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6" />於是<char style="pn">摩西</char>吩咐在營中傳令說：「無論男女都不必再為聖所奉獻任何供物。」這樣，百姓才被阻止，不再帶來供物； <verse eid="EXO 36:6" /><verse number="7" style="v" sid="EXO 36:7" />因為材料已經足夠做一切的工作，而且有餘。<verse eid="EXO 36:7" /></para>
  <para style="s">造帳幕</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8" />這些工作的人中，一切有才能的，用十幅幔帳造了帳幕；<char style="pn">比撒列</char>用捻成的細麻線和藍色、紫色、朱紅色線編織幔帳，以精巧的工藝繡上了基路伯。 <verse eid="EXO 36:8" /><verse number="9" style="v" sid="EXO 36:9" />每幅幔帳長二十八肘<note caller="+" style="f"><char style="fr" closed="false">36:9 </char><char style="ft" closed="false">二十八肘——相當於12.8公尺。1肘=45.7公分。</char></note>，每幅幔帳寬四肘<note caller="+" style="f"><char style="fr" closed="false">36:9 </char><char style="ft" closed="false">四肘——相當於1.8公尺。</char></note>，所有幔帳的尺寸都一樣。 <verse eid="EXO 36:9" /><verse number="10" style="v" sid="EXO 36:10" />五幅幔帳彼此相連，另五幅幔帳也彼此相連。 <verse eid="EXO 36:10" /><verse number="11" style="v" sid="EXO 36:11" />在一組幔帳的最後一幅邊上，用藍色線做扣環；另一組幔帳的最後一幅邊上，也照樣做。 <verse eid="EXO 36:11" /><verse number="12" style="v" sid="EXO 36:12" />在一組幔帳的邊上，做五十個扣環；在另一組幔帳的邊上，也做五十個扣環，扣環彼此相對。 <verse eid="EXO 36:12" /><verse number="13" style="v" sid="EXO 36:13" />他做了五十個金鉤，用這些鉤子把兩組幔帳彼此相連，好使帳幕成為一個整體。<verse eid="EXO 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14" />他用山羊毛做幔帳，作為帳幕上的罩篷，做了十一幅幔帳。 <verse eid="EXO 36:14" /><verse number="15" style="v" sid="EXO 36:15" />每幅幔帳長三十肘<note caller="+" style="f"><char style="fr" closed="false">36:15 </char><char style="ft" closed="false">三十肘——相當於13.7公尺。1肘=45.7公分。</char></note>，每幅幔帳寬四肘<note caller="+" style="f"><char style="fr" closed="false">36:15 </char><char style="ft" closed="false">四肘——相當於1.8公尺。</char></note>，十一幅幔帳的尺寸都一樣。 <verse eid="EXO 36:15" /><verse number="16" style="v" sid="EXO 36:16" />他把五幅幔帳連成一組，把另外的六幅幔帳也連成一組。 <verse eid="EXO 36:16" /><verse number="17" style="v" sid="EXO 36:17" />在一組幔帳的最後一幅邊上，做五十個扣環；在另一組幔帳的邊上，也做五十個扣環。 <verse eid="EXO 36:17" /><verse number="18" style="v" sid="EXO 36:18" />他做了五十個銅鉤，把罩篷連起來，好使它成為一個整體。 <verse eid="EXO 36:18" /><verse number="19" style="v" sid="EXO 36:19" />他用染紅的公綿羊皮為罩篷做一個頂罩，其上再用海獅皮做了一個頂罩。<verse eid="EXO 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 36:20" />他用金合歡木為帳幕做了豎板。 <verse eid="EXO 36:20" /><verse number="21" style="v" sid="EXO 36:21" />每塊木板長十肘<note caller="+" style="f"><char style="fr" closed="false">36:21 </char><char style="ft" closed="false">十肘——相當於4.6公尺。1肘=45.7公分。</char></note>，每塊木板寬一肘半<note caller="+" style="f"><char style="fr" closed="false">36:21 </char><char style="ft" closed="false">一肘半——相當於0.7公尺。</char></note>。 <verse eid="EXO 36:21" /><verse number="22" style="v" sid="EXO 36:22" />每塊木板有兩個榫頭，彼此並列<note caller="+" style="f"><char style="fr" closed="false">36:22 </char><char style="ft" closed="false">彼此並列——或譯作「使木板彼此連接」。</char></note>；帳幕所有的木板都這樣做。 <verse eid="EXO 36:22" /><verse number="23" style="v" sid="EXO 36:23" />他為帳幕做了木板，為南邊做了二十塊木板； <verse eid="EXO 36:23" /><verse number="24" style="v" sid="EXO 36:24" />在這二十塊木板底下，做了四十個銀底座；一塊木板底下有兩個底座連接它的兩個榫頭，下一塊木板底下也有兩個底座連接它的兩個榫頭。 <verse eid="EXO 36:24" /><verse number="25" style="v" sid="EXO 36:25" />他為帳幕的另一邊，就是北邊，做了二十塊木板， <verse eid="EXO 36:25" /><verse number="26" style="v" sid="EXO 36:26" />以及四十個銀底座；一塊木板底下有兩個底座，下一塊木板底下也有兩個底座。 <verse eid="EXO 36:26" /><verse number="27" style="v" sid="EXO 36:27" />他也為帳幕的後部，就是西面，做了六塊木板； <verse eid="EXO 36:27" /><verse number="28" style="v" sid="EXO 36:28" />並在帳幕後部的兩個邊角做兩塊木板， <verse eid="EXO 36:28" /><verse number="29" style="v" sid="EXO 36:29" />兩個邊角是雙層，雙層木板從下端到頂端完全對齊，頂端用一個環扣住；兩塊木板都是這樣，形成兩個凸角。 <verse eid="EXO 36:29" /><verse number="30" style="v" sid="EXO 36:30" />這樣共有八塊木板和十六個銀底座；每塊木板底下都有兩個底座。<verse eid="EXO 36:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 36:31" />他用金合歡木做橫閂，為帳幕一邊的木板做了五根， <verse eid="EXO 36:31" /><verse number="32" style="v" sid="EXO 36:32" />為帳幕另一邊的木板做了五根橫閂，又為帳幕後邊，就是西面的木板，也做了五根橫閂。 <verse eid="EXO 36:32" /><verse number="33" style="v" sid="EXO 36:33" />他使中間那根橫閂，在木板中部，從一端穿到另一端。 <verse eid="EXO 36:33" /><verse number="34" style="v" sid="EXO 36:34" />他把木板包上了金，又用金子做了其上的環，用來穿橫閂；也把橫閂包上了金。<verse eid="EXO 36:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35" />他用藍色、紫色、朱紅色線和捻成的細麻線編織幔子，以精巧的工藝繡上了基路伯。 <verse eid="EXO 36:35" /><verse number="36" style="v" sid="EXO 36:36" />他用金合歡木為幔子做了四根柱子，把它們包上了金；柱子上有金鉤；他又為柱子鑄了四個銀底座。<verse eid="EXO 36:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 36:37" />他用藍色、紫色、朱紅色線和捻成的細麻線，以刺繡的工藝，為帳篷的入口編織了簾幕。 <verse eid="EXO 36:37" /><verse number="38" style="v" sid="EXO 36:38" />他為簾幕做了五根柱子和柱子上的鉤子，把柱頂和柱子上的箍環包上了金；柱子有五個銅底座。<verse eid="EXO 36:38" /></para>
  <chapter eid="EXO 36" />
  <chapter number="37" style="c" sid="EXO 37" />
  <para style="s">做見證櫃</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1" />
    <char style="pn">比撒列</char>用金合歡木做了一個櫃，長二肘半<note caller="+" style="f"><char style="fr" closed="false">37:1 </char><char style="ft" closed="false">二肘半——相當於114.3公分。1肘=45.7公分。</char></note>，寬一肘半<note caller="+" style="f"><char style="fr" closed="false">37:1 </char><char style="ft" closed="false">一肘半——相當於68.6公分；下同。</char></note>，高一肘半。 <verse eid="EXO 37:1" /><verse number="2" style="v" sid="EXO 37:2" />他把櫃的裡裡外外都包上了純金，並在它的四圍鑲上了金邊； <verse eid="EXO 37:2" /><verse number="3" style="v" sid="EXO 37:3" />又為它鑄了四個金環，安裝在它的四個腳上，兩個環在一邊，兩個環在另一邊。 <verse eid="EXO 37:3" /><verse number="4" style="v" sid="EXO 37:4" />他用金合歡木做了兩根杠，把它們包上了金， <verse eid="EXO 37:4" /><verse number="5" style="v" sid="EXO 37:5" />把杠穿進櫃兩邊的環中，用來抬櫃。<verse eid="EXO 37:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 37:6" />他用純金做了施恩座<note caller="+" style="f"><char style="fr" closed="false">37:6 </char><char style="ft" closed="false">施恩座——或譯作「贖罪蓋」；下同。</char></note>，長二肘半<note caller="+" style="f"><char style="fr" closed="false">37:6 </char><char style="ft" closed="false">二肘半——相當於114.3公分。1肘=45.7公分。</char></note>，寬一肘半<note caller="+" style="f"><char style="fr" closed="false">37:6 </char><char style="ft" closed="false">一肘半——相當於68.6公分。</char></note>； <verse eid="EXO 37:6" /><verse number="7" style="v" sid="EXO 37:7" />又在施恩座的兩端，用金子造了兩個基路伯，錘擛成形—— <verse eid="EXO 37:7" /><verse number="8" style="v" sid="EXO 37:8" />一端造一個基路伯，另一端也造一個基路伯，從施恩座的兩端造出基路伯。 <verse eid="EXO 37:8" /><verse number="9" style="v" sid="EXO 37:9" />兩個基路伯向上展開翅膀，用它們的翅膀遮掩施恩座，它們的臉彼此相向；基路伯的臉朝向施恩座。<verse eid="EXO 37:9" /></para>
  <para style="s">做陳設餅的桌子</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10" />他用金合歡木做了一張桌子，長二肘<note caller="+" style="f"><char style="fr" closed="false">37:10 </char><char style="ft" closed="false">二肘——相當於91.4公分。</char></note>，寬一肘<note caller="+" style="f"><char style="fr" closed="false">37:10 </char><char style="ft" closed="false">一肘——相當於45.7公分。</char></note>，高一肘半<note caller="+" style="f"><char style="fr" closed="false">37:10 </char><char style="ft" closed="false">一肘半——相當於68.6公分。</char></note>。 <verse eid="EXO 37:10" /><verse number="11" style="v" sid="EXO 37:11" />他把桌子包上了純金，並在它的四圍鑲上了金邊； <verse eid="EXO 37:11" /><verse number="12" style="v" sid="EXO 37:12" />在它的四圍做了一掌寬<note caller="+" style="f"><char style="fr" closed="false">37:12 </char><char style="ft" closed="false">一掌寬——相當於7.4公分。</char></note>的邊框，並在它的邊框四圍鑲上了金邊； <verse eid="EXO 37:12" /><verse number="13" style="v" sid="EXO 37:13" />又為它鑄了四個金環，安裝在它的四角，就是它的四個腿上。 <verse eid="EXO 37:13" /><verse number="14" style="v" sid="EXO 37:14" />環靠近邊框，用來穿杠抬桌子。 <verse eid="EXO 37:14" /><verse number="15" style="v" sid="EXO 37:15" />他用金合歡木做了兩根杠，把它們包上了金，用來抬桌子。 <verse eid="EXO 37:15" /><verse number="16" style="v" sid="EXO 37:16" />他做了桌子上澆奠用的器具：盤、碟、壺和杯；這些都是純金的。<verse eid="EXO 37:16" /></para>
  <para style="s">做燈檯</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17" />他用純金做了一個燈臺，燈臺是錘擛成形的——它的底座、枝幹、花杯、花萼和花瓣都與燈臺一體錘出。 <verse eid="EXO 37:17" /><verse number="18" style="v" sid="EXO 37:18" />從燈臺的兩邊伸出六根枝幹，三根枝幹在一邊，三根枝幹在另一邊。 <verse eid="EXO 37:18" /><verse number="19" style="v" sid="EXO 37:19" />在一邊的每根枝幹上有三個杏花形狀的花杯，每個都有花萼和花瓣；在另一邊的每根枝幹上也有三個杏花形狀的花杯，每個都有花萼和花瓣；從燈臺伸出的六根枝幹都是這樣。 <verse eid="EXO 37:19" /><verse number="20" style="v" sid="EXO 37:20" />燈臺的主幹<note caller="+" style="f"><char style="fr" closed="false">37:20 </char><char style="ft" closed="false">的主幹——輔助詞語。</char></note>上有四個杏花形狀的花杯，每個都有花萼和花瓣； <verse eid="EXO 37:20" /><verse number="21" style="v" sid="EXO 37:21" />從燈臺伸出的第一對兩根枝幹下面有一個花萼，第二對兩根枝幹下面有一個花萼，第三對兩根枝幹下面也有一個花萼；從燈臺伸出的六根枝幹都是這樣。 <verse eid="EXO 37:21" /><verse number="22" style="v" sid="EXO 37:22" />它們的花萼和枝幹與燈臺一體錘出，整個燈臺都用同一塊純金錘成。 <verse eid="EXO 37:22" /><verse number="23" style="v" sid="EXO 37:23" />他做了燈臺的七盞燈，以及燈臺的燈剪和燈盤，都是純金的； <verse eid="EXO 37:23" /><verse number="24" style="v" sid="EXO 37:24" />用一他連得<note caller="+" style="f"><char style="fr" closed="false">37:24 </char><char style="ft" closed="false">一他連得——相當於34.2公斤。</char></note>純金做了燈臺和燈臺的一切器具。<verse eid="EXO 37:24" /></para>
  <para style="s">造香壇</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25" />他用金合歡木造了一座香壇，長一肘<note caller="+" style="f"><char style="fr" closed="false">37:25 </char><char style="ft" closed="false">一肘——相當於45.7公分；下同。</char></note>，寬一肘，是方形的，高二肘<note caller="+" style="f"><char style="fr" closed="false">37:25 </char><char style="ft" closed="false">二肘——相當於91.4公分。</char></note>；犄角從壇而出。 <verse eid="EXO 37:25" /><verse number="26" style="v" sid="EXO 37:26" />他把壇包上純金，壇的頂部、壇的四邊和壇的犄角都包上了，並在壇的四圍鑲上了金邊； <verse eid="EXO 37:26" /><verse number="27" style="v" sid="EXO 37:27" />又在金邊之下、在壇的相對兩邊為壇做了兩個金環，用來穿杠抬壇。 <verse eid="EXO 37:27" /><verse number="28" style="v" sid="EXO 37:28" />他用金合歡木做了兩根杠，把它們包上了金。<verse eid="EXO 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29" />他用調配師的做法製作了聖膏油和純淨的芬芳香。<verse eid="EXO 37:29" /></para>
  <chapter eid="EXO 37" />
  <chapter number="38" style="c" sid="EXO 38" />
  <para style="s">造燔祭的祭壇</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1" />他用金合歡木造了一座燔祭壇，長五肘<note caller="+" style="f"><char style="fr" closed="false">38:1 </char><char style="ft" closed="false">五肘——相當於2.3公尺。1肘=45.7公分。</char></note>，寬五肘，是方形的，高三肘<note caller="+" style="f"><char style="fr" closed="false">38:1 </char><char style="ft" closed="false">三肘——相當於1.4公尺。</char></note>； <verse eid="EXO 38:1" /><verse number="2" style="v" sid="EXO 38:2" />在祭壇的四角上做了犄角，犄角從祭壇而出；又把祭壇包上了銅。<verse eid="EXO 38:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 38:3" />他做了祭壇的一切器具：桶、鏟子、碗、肉叉和火盆；祭壇的一切器具，他都用銅做。 <verse eid="EXO 38:3" /><verse number="4" style="v" sid="EXO 38:4" />他為祭壇做了一個銅格網，安放在祭壇的邊框之下，使網達到祭壇的半腰。 <verse eid="EXO 38:4" /><verse number="5" style="v" sid="EXO 38:5" />他在銅格網的四角鑄了四個環，用來穿杠。 <verse eid="EXO 38:5" /><verse number="6" style="v" sid="EXO 38:6" />他用金合歡木做了杠，把它們包上銅， <verse eid="EXO 38:6" /><verse number="7" style="v" sid="EXO 38:7" />把杠穿進祭壇兩邊的環中，用來抬祭壇。他用木板把祭壇做成了空心的。<verse eid="EXO 38:7" /></para>
  <para style="s">做銅盆</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8" />他用會幕入口服事的女人的銅<note caller="+" style="f"><char style="fr" closed="false">38:8 </char><char style="ft" closed="false">銅——輔助詞語。</char></note>鏡做了一個銅盆和銅盆座。<verse eid="EXO 38:8" /></para>
  <para style="s">做院子</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9" />他做了院子。南邊用捻成的細麻線編織了院子的帷幔，共一百肘<note caller="+" style="f"><char style="fr" closed="false">38:9 </char><char style="ft" closed="false">一百肘——相當於45.7公尺。1肘=45.7公分。</char></note>。 <verse eid="EXO 38:9" /><verse number="10" style="v" sid="EXO 38:10" />帷幔的柱子二十根，柱子的銅底座二十個，柱子上的鉤子和箍環都是銀的。 <verse eid="EXO 38:10" /><verse number="11" style="v" sid="EXO 38:11" />北邊也是一百肘，帷幔的柱子二十根，柱子的銅底座二十個，柱子上的鉤子和箍環都是銀的。 <verse eid="EXO 38:11" /><verse number="12" style="v" sid="EXO 38:12" />西邊的帷幔是五十肘<note caller="+" style="f"><char style="fr" closed="false">38:12 </char><char style="ft" closed="false">五十肘——相當於22.9公尺；下同。1肘=45.7公分。</char></note>，帷幔的柱子十根，柱子的底座十個，柱子上的鉤子和箍環都是銀的。 <verse eid="EXO 38:12" /><verse number="13" style="v" sid="EXO 38:13" />東邊，就是日出的方向，也是五十肘： <verse eid="EXO 38:13" /><verse number="14" style="v" sid="EXO 38:14" />門的一邊，帷幔十五肘<note caller="+" style="f"><char style="fr" closed="false">38:14 </char><char style="ft" closed="false">十五肘——相當於6.9公尺；下同。</char></note>，帷幔的柱子三根，柱子的底座三個； <verse eid="EXO 38:14" /><verse number="15" style="v" sid="EXO 38:15" />門的另一邊也一樣，院子門口兩邊的帷幔各十五肘，帷幔的柱子三根，柱子的底座三個。 <verse eid="EXO 38:15" /><verse number="16" style="v" sid="EXO 38:16" />院子四圍所有的帷幔都是用捻成的細麻線編織的。 <verse eid="EXO 38:16" /><verse number="17" style="v" sid="EXO 38:17" />柱子的底座都是銅的，柱子上的鉤子和箍環都是銀的，包柱頂的也都是銀的；院子的所有柱子都有銀箍環箍著。<verse eid="EXO 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 38:18" />院子的門簾是用藍色、紫色、朱紅色線和捻成的細麻線，以刺繡的工藝編織；長二十肘<note caller="+" style="f"><char style="fr" closed="false">38:18 </char><char style="ft" closed="false">二十肘——相當於9.1公尺。1肘=45.7公分。</char></note>，寬五肘<note caller="+" style="f"><char style="fr" closed="false">38:18 </char><char style="ft" closed="false">五肘——相當於2.3公尺。</char></note>之高，與院子的帷幔一樣高。 <verse eid="EXO 38:18" /><verse number="19" style="v" sid="EXO 38:19" />帷幔的柱子四根，柱子的銅底座四個，柱子上的鉤子都是銀的，包柱頂的和箍環也都是銀的。 <verse eid="EXO 38:19" /><verse number="20" style="v" sid="EXO 38:20" />帳幕和院子四圍所有的橛子都是銅的。<verse eid="EXO 38:20" /></para>
  <para style="s">有關帳幕的清單</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21" />以下是有關帳幕，就是見證帳幕的清單，是照著<char style="pn">摩西</char>的吩咐清點的；這是祭司<char style="pn">亞倫</char>的兒子<char style="pn">以塔瑪爾</char>經手的<char style="pn">利未</char>人的服事。 <verse eid="EXO 38:21" /><verse number="22" style="v" sid="EXO 38:22" />耶和華所指示<char style="pn">摩西</char>的一切，<char style="pn">猶大</char>支派中<char style="pn">戶珥</char>的孫子、<char style="pn">烏利</char>的兒子<char style="pn">比撒列</char>都做了。 <verse eid="EXO 38:22" /><verse number="23" style="v" sid="EXO 38:23" />與他一起的，有<char style="pn">但</char>支派中<char style="pn">亞希撒抹</char>的兒子<char style="pn">亞何利亞伯</char>，能雕刻，能設計，又能用藍色、紫色、朱紅色線和細麻刺繡。<verse eid="EXO 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 38:24" />用於做聖所工程一切工作的所有金子，就是搖獻的金子，按聖所的謝克爾<note caller="+" style="f"><char style="fr" closed="false">38:24 </char><char style="ft" closed="false">謝克爾——重量單位；後來成為貨幣單位。1謝克爾=11.4公克。本章下同。</char></note>標準，是二十九他連得<note caller="+" style="f"><char style="fr" closed="false">38:24 </char><char style="ft" closed="false">二十九他連得——相當於991.8公斤。1他連得=34.2公斤。</char></note>七百三十謝克爾<note caller="+" style="f"><char style="fr" closed="false">38:24 </char><char style="ft" closed="false">七百三十謝克爾——相當於8.3公斤。</char></note>。 <verse eid="EXO 38:24" /><verse number="25" style="v" sid="EXO 38:25" />會眾中被數點的人所付的銀子，按聖所的謝克爾標準，是一百他連得<note caller="+" style="f"><char style="fr" closed="false">38:25 </char><char style="ft" closed="false">一百他連得——相當於3.4公噸；下同。1他連得=34.2公斤。</char></note>一千七百七十五謝克爾<note caller="+" style="f"><char style="fr" closed="false">38:25 </char><char style="ft" closed="false">一千七百七十五謝克爾——相當於20.2公斤；下同。</char></note>： <verse eid="EXO 38:25" /><verse number="26" style="v" sid="EXO 38:26" />所有通過數點歸入被數之眾的人，每人一比加<note caller="+" style="f"><char style="fr" closed="false">38:26 </char><char style="ft" closed="false">一比加——相當於5.7公克。1比加=0.5謝克爾=10季拉。</char></note>，按聖所的謝克爾標準，是半謝克爾<note caller="+" style="f"><char style="fr" closed="false">38:26 </char><char style="ft" closed="false">半謝克爾——相當於5.7公克。</char></note>；二十歲以上的，共六十萬三千五百五十人。 <verse eid="EXO 38:26" /><verse number="27" style="v" sid="EXO 38:27" />一百他連得銀子用來鑄聖所的底座和幔子的底座：一百個底座一百他連得，一個底座一他連得； <verse eid="EXO 38:27" /><verse number="28" style="v" sid="EXO 38:28" />一千七百七十五謝克爾銀子用來做柱子上的鉤子，包上柱頂，並做柱子的箍環。<verse eid="EXO 38:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 38:29" />搖獻的銅是七十他連得<note caller="+" style="f"><char style="fr" closed="false">38:29 </char><char style="ft" closed="false">七十他連得——相當於2.4公噸。1他連得=34.2公斤。</char></note>兩千四百謝克爾<note caller="+" style="f"><char style="fr" closed="false">38:29 </char><char style="ft" closed="false">兩千四百謝克爾——相當於27.4公斤。1謝克爾=11.4公克。</char></note>。 <verse eid="EXO 38:29" /><verse number="30" style="v" sid="EXO 38:30" />這些銅用來做會幕入口的底座、銅祭壇、祭壇用的銅格網、祭壇的一切器具、 <verse eid="EXO 38:30" /><verse number="31" style="v" sid="EXO 38:31" />院子四圍的底座、院子門口的底座、帳幕所有的橛子和院子四圍所有的橛子。<verse eid="EXO 38:31" /></para>
  <chapter eid="EXO 38" />
  <chapter number="39" style="c" sid="EXO 39" />
  <para style="s">做祭司的聖衣</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1" />他們用藍色、紫色、朱紅色線，做了聖所事奉用的編織的衣服，又為<char style="pn">亞倫</char>做了聖衣，是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 39:1" /></para>
  <para style="s">做以弗得</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 39:2" />
    <char style="pn">比撒列</char>用金色、藍色、紫色、朱紅色線和捻成的細麻線做了以弗得。 <verse eid="EXO 39:2" /><verse number="3" style="v" sid="EXO 39:3" />他們把金子錘成薄片，剪成細線，以精巧的工藝織入了藍色、紫色、朱紅色線和細麻之中； <verse eid="EXO 39:3" /><verse number="4" style="v" sid="EXO 39:4" />又為以弗得做了兩條相連的肩帶，與它的兩端相連。 <verse eid="EXO 39:4" /><verse number="5" style="v" sid="EXO 39:5" />以弗得上的精巧織帶，與以弗得的做法一樣，都從同樣的材料——金色、藍色、紫色、朱紅色線和捻成的細麻線織出，是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 39:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 39:6" />他們把兩塊紅瑪瑙石鑲嵌在金槽中，像雕刻印章那樣，雕刻了<char style="pn">以色列</char>兒子們的名字。 <verse eid="EXO 39:6" /><verse number="7" style="v" sid="EXO 39:7" />他把這兩塊寶石安在以弗得的肩帶上，作為<char style="pn">以色列</char>兒子們的記念石，是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 39:7" /></para>
  <para style="s">做胸牌</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8" />他以精巧的工藝做了一個胸牌，與以弗得的做法一樣，用金色、藍色、紫色、朱紅色線和捻成的細麻線來做。 <verse eid="EXO 39:8" /><verse number="9" style="v" sid="EXO 39:9" />胸牌是方形的；他們把胸牌做成了雙層，長一拃<note caller="+" style="f"><char style="fr" closed="false">39:9 </char><char style="ft" closed="false">一拃——約20公分；下同。</char></note>，寬一拃，疊為雙層。 <verse eid="EXO 39:9" /><verse number="10" style="v" sid="EXO 39:10" />他們在胸牌上鑲嵌了四行寶石：第一行是紅寶石、黃玉、綠寶石， <verse eid="EXO 39:10" /><verse number="11" style="v" sid="EXO 39:11" />第二行是綠松石、藍寶石、金剛石， <verse eid="EXO 39:11" /><verse number="12" style="v" sid="EXO 39:12" />第三行是紅鋯石、白瑪瑙、紫晶， <verse eid="EXO 39:12" /><verse number="13" style="v" sid="EXO 39:13" />第四行是黃水晶、紅瑪瑙、碧玉。這些都鑲嵌在各自的金槽中。 <verse eid="EXO 39:13" /><verse number="14" style="v" sid="EXO 39:14" />這些寶石都按著<char style="pn">以色列</char>兒子們的名字，十二塊都按著他們的名字，像雕刻印章那樣，按著各自的名字，代表十二個支派。<verse eid="EXO 39:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 39:15" />他們在胸牌上用編繩子的工藝做了純金的鏈子； <verse eid="EXO 39:15" /><verse number="16" style="v" sid="EXO 39:16" />他們做了兩個金槽和兩個金環，把兩個環接在胸牌上邊<note caller="+" style="f"><char style="fr" closed="false">39:16 </char><char style="ft" closed="false">上邊——輔助詞語。</char></note>的兩端； <verse eid="EXO 39:16" /><verse number="17" style="v" sid="EXO 39:17" />他們把兩條金鏈子接在胸牌上邊<note caller="+" style="f"><char style="fr" closed="false">39:17 </char><char style="ft" closed="false">上邊——輔助詞語。</char></note>兩端的兩個環中， <verse eid="EXO 39:17" /><verse number="18" style="v" sid="EXO 39:18" />把兩條鏈子的另兩端接在兩個槽上，把它們連在以弗得前面的肩帶上。 <verse eid="EXO 39:18" /><verse number="19" style="v" sid="EXO 39:19" />他們再做了兩個金環，安在胸牌下邊<note caller="+" style="f"><char style="fr" closed="false">39:19 </char><char style="ft" closed="false">下邊——輔助詞語。</char></note>的兩端，在以弗得內側的邊上； <verse eid="EXO 39:19" /><verse number="20" style="v" sid="EXO 39:20" />又做了兩個金環，把它們接在以弗得前面的兩條肩帶下面，靠近接縫處，在以弗得的精巧織帶上方。 <verse eid="EXO 39:20" /><verse number="21" style="v" sid="EXO 39:21" />他們用藍色的細繩把胸牌的環與以弗得的環連接，使胸牌貼在以弗得的精巧織帶上，使胸牌不致從以弗得上鬆脫，是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 39:21" /></para>
  <para style="s">做外袍</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22" />他用紡織的工藝做了以弗得的外袍，整件都是藍色的。 <verse eid="EXO 39:22" /><verse number="23" style="v" sid="EXO 39:23" />外袍的中間之處，有一個領口，像戰袍的領口那樣，領口有圍邊，免得撕裂。 <verse eid="EXO 39:23" /><verse number="24" style="v" sid="EXO 39:24" />他們在外袍的下擺上，用捻成的藍色、紫色、朱紅色線做了石榴， <verse eid="EXO 39:24" /><verse number="25" style="v" sid="EXO 39:25" />又用純金做了鈴鐺，把鈴鐺加在石榴之間，在外袍下擺圍邊上的石榴之間， <verse eid="EXO 39:25" /><verse number="26" style="v" sid="EXO 39:26" />一個鈴鐺一個石榴，一個鈴鐺一個石榴，在外袍下擺的圍邊上，是用於事奉，是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 39:26" /></para>
  <para style="s">做祭司的其他衣飾</para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 39:27" />他們用紡織的工藝，為<char style="pn">亞倫</char>和他的兒子們做了細麻袍子， <verse eid="EXO 39:27" /><verse number="28" style="v" sid="EXO 39:28" />細麻頂冠和細麻頭飾巾，用捻成的細麻線做了細麻褲子， <verse eid="EXO 39:28" /><verse number="29" style="v" sid="EXO 39:29" />又用藍色、紫色、朱紅色線和捻成的細麻線，以刺繡的工藝做了腰帶，是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 39:29" /></para>
  <para style="s">做聖冠</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 39:30" />他們用純金做了一面聖冠牌子，像雕刻印章那樣，在金牌上刻了字「歸耶和華為聖」； <verse eid="EXO 39:30" /><verse number="31" style="v" sid="EXO 39:31" />又用一條藍色的細繩把金牌繫在頂冠上面，是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 39:31" /></para>
  <para style="s">摩西查看會幕</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32" />這樣，會幕的一切工作都完成了。<char style="pn">以色列</char>子孫遵行耶和華所指示<char style="pn">摩西</char>的一切，都照著做了。 <verse eid="EXO 39:32" /><verse number="33" style="v" sid="EXO 39:33" />他們把帳幕帶到<char style="pn">摩西</char>那裡，就是帳篷和帳篷的一切器具：鉤子、木板、橫閂、柱子、底座、 <verse eid="EXO 39:33" /><verse number="34" style="v" sid="EXO 39:34" />染紅公綿羊皮的遮蓋、海獅皮的頂罩、簾幕的幔子、 <verse eid="EXO 39:34" /><verse number="35" style="v" sid="EXO 39:35" />見證櫃和櫃的杠、施恩座、 <verse eid="EXO 39:35" /><verse number="36" style="v" sid="EXO 39:36" />桌子和桌子的一切器具、陳設餅、 <verse eid="EXO 39:36" /><verse number="37" style="v" sid="EXO 39:37" />純金的燈臺、排列的燈、燈臺的一切器具、點燈的油、 <verse eid="EXO 39:37" /><verse number="38" style="v" sid="EXO 39:38" />金壇、膏油、芬芳香、帳篷的門簾、 <verse eid="EXO 39:38" /><verse number="39" style="v" sid="EXO 39:39" />銅祭壇、祭壇用的銅格網、祭壇的杠、祭壇的一切器具、洗濯盆和盆座、 <verse eid="EXO 39:39" /><verse number="40" style="v" sid="EXO 39:40" />院子的帷幔、帷幔的柱子、底座、院子的門簾、繩子、橛子、會幕的帳幕服事所用的一切器具、 <verse eid="EXO 39:40" /><verse number="41" style="v" sid="EXO 39:41" />聖所事奉用的編織的衣服——祭司<char style="pn">亞倫</char>的聖衣和他兒子們作祭司事奉時的衣服。 <verse eid="EXO 39:41" /><verse number="42" style="v" sid="EXO 39:42" />這樣，<char style="pn">以色列</char>子孫照著耶和華所指示<char style="pn">摩西</char>的一切，完成了一切工作。 <verse eid="EXO 39:42" /><verse number="43" style="v" sid="EXO 39:43" /><char style="pn">摩西</char>查看一切工作，看哪，他們遵行耶和華所指示的，都照著做了。於是，<char style="pn">摩西</char>祝福了他們。<verse eid="EXO 39:43" /></para>
  <chapter eid="EXO 39" />
  <chapter number="40" style="c" sid="EXO 40" />
  <para style="s">立起會幕</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="EXO 40:1" /><verse number="2" style="v" sid="EXO 40:2" />「一月一日，你要把會幕的帳幕立起來， <verse eid="EXO 40:2" /><verse number="3" style="v" sid="EXO 40:3" />把見證櫃安放在那裡，用幔子遮掩這櫃； <verse eid="EXO 40:3" /><verse number="4" style="v" sid="EXO 40:4" />把桌子搬進去，擺好桌子上應擺的東西；又把燈臺搬進去，點上燈。 <verse eid="EXO 40:4" /><verse number="5" style="v" sid="EXO 40:5" />你要把金香壇放在見證櫃前面，掛上帳幕的門簾； <verse eid="EXO 40:5" /><verse number="6" style="v" sid="EXO 40:6" />把燔祭的祭壇放在會幕的帳幕入口的前面； <verse eid="EXO 40:6" /><verse number="7" style="v" sid="EXO 40:7" />又把洗濯盆放在會幕和祭壇之間，盆中盛水。 <verse eid="EXO 40:7" /><verse number="8" style="v" sid="EXO 40:8" />你要在四圍設院子，掛上院子的門簾。<verse eid="EXO 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9" />「你要把膏油拿來，膏抹帳幕和帳幕裡的一切，使帳幕和帳幕的一切器具分別為聖，帳幕就成為神聖的。 <verse eid="EXO 40:9" /><verse number="10" style="v" sid="EXO 40:10" />你要膏抹燔祭的祭壇和祭壇的一切器具，使祭壇分別為聖，祭壇就成為至聖的。 <verse eid="EXO 40:10" /><verse number="11" style="v" sid="EXO 40:11" />你要膏抹洗濯盆和盆座，使盆分別為聖。<verse eid="EXO 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12" />「你要把<char style="pn">亞倫</char>和他的兒子們帶到會幕的入口，用水洗他們； <verse eid="EXO 40:12" /><verse number="13" style="v" sid="EXO 40:13" />給<char style="pn">亞倫</char>穿上聖衣，膏抹他，使他分別為聖，作祭司事奉我； <verse eid="EXO 40:13" /><verse number="14" style="v" sid="EXO 40:14" />又把他的兒子們帶來，給他們穿上袍子， <verse eid="EXO 40:14" /><verse number="15" style="v" sid="EXO 40:15" />膏抹他們，像膏抹他們的父親那樣，使他們作祭司事奉我。他們受膏抹，就使他們世世代代擁有永遠的祭司職份。」<verse eid="EXO 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 40:16" />
    <char style="pn">摩西</char>遵行耶和華所指示他的一切，都照著做了。 <verse eid="EXO 40:16" /><verse number="17" style="v" sid="EXO 40:17" />第二年一月一日，帳幕立了起來。 <verse eid="EXO 40:17" /><verse number="18" style="v" sid="EXO 40:18" /><char style="pn">摩西</char>把帳幕立了起來，安好帳幕的底座，豎起木板，穿上橫閂，立起柱子， <verse eid="EXO 40:18" /><verse number="19" style="v" sid="EXO 40:19" />把罩篷鋪在帳幕上，又把罩篷的頂罩安放其上，是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 40:20" />
    <char style="pn">摩西</char>把見證版拿來，安放在櫃裡，把杠穿在櫃的兩邊，把施恩座安放在櫃上面； <verse eid="EXO 40:20" /><verse number="21" style="v" sid="EXO 40:21" />又把櫃抬進帳幕，掛上簾幕的幔子來遮掩見證櫃，是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 40:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 40:22" />
    <char style="pn">摩西</char>把桌子安置在會幕中，在帳幕的北邊，幔子的外面； <verse eid="EXO 40:22" /><verse number="23" style="v" sid="EXO 40:23" />在桌子上擺好陳設餅，擺在耶和華面前，是照著耶和華指示<char style="pn">摩西</char>的。 <verse eid="EXO 40:23" /><verse number="24" style="v" sid="EXO 40:24" />他把燈臺放在會幕中，在桌子對面，在帳幕的南邊； <verse eid="EXO 40:24" /><verse number="25" style="v" sid="EXO 40:25" />又把燈點在耶和華面前，是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 40:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 40:26" />他把金壇安放在會幕中，幔子的前面； <verse eid="EXO 40:26" /><verse number="27" style="v" sid="EXO 40:27" />在壇上燒獻芬芳香，是照著耶和華指示<char style="pn">摩西</char>的。 <verse eid="EXO 40:27" /><verse number="28" style="v" sid="EXO 40:28" />他掛上帳幕的門簾。 <verse eid="EXO 40:28" /><verse number="29" style="v" sid="EXO 40:29" />他把燔祭的祭壇安放在會幕的帳幕入口，把燔祭和素祭獻在祭壇上，都是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 40:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 40:30" />他把洗濯盆安放在會幕和祭壇之間，盆中盛水，用來洗濯； <verse eid="EXO 40:30" /><verse number="31" style="v" sid="EXO 40:31" /><char style="pn">摩西</char>、<char style="pn">亞倫</char>和他的兒子們在盆中洗手洗腳。 <verse eid="EXO 40:31" /><verse number="32" style="v" sid="EXO 40:32" />當他們進入會幕，或接近祭壇的時候，他們就洗濯，是照著耶和華指示<char style="pn">摩西</char>的。<verse eid="EXO 40:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 40:33" />他在帳幕和祭壇的四圍設了院子，掛上院子的門簾。這樣，<char style="pn">摩西</char>就完成了工作。<verse eid="EXO 40:33" /></para>
  <para style="s">耶和華的榮耀</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34" />那時，雲彩遮蓋會幕，耶和華的榮耀充滿了帳幕。 <verse eid="EXO 40:34" /><verse number="35" style="v" sid="EXO 40:35" /><char style="pn">摩西</char>不能進入會幕，因為雲彩停留在會幕上，耶和華的榮耀充滿了帳幕。<verse eid="EXO 40:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 40:36" />在<char style="pn">以色列</char>子孫的整個行程中，每當雲彩從帳幕上收上去，他們就起行； <verse eid="EXO 40:36" /><verse number="37" style="v" sid="EXO 40:37" />如果雲彩不收上去，他們就不起行，直到雲彩收上去那天。 <verse eid="EXO 40:37" /><verse number="38" style="v" sid="EXO 40:38" />在他們的整個行程中，白天有耶和華的雲彩在帳幕上，夜間有火在雲彩中，就在<char style="pn">以色列</char>全家的眼前。<verse eid="EXO 40:38" /></para>
  <chapter eid="EXO 40" />
</usx>