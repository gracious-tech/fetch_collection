<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZR" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">以斯拉記</para>
  <para style="mt">以斯拉記</para>
  <chapter number="1" style="c" sid="EZR 1" />
  <para style="s">居魯士王發布通告</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1" />
    <char style="pn">波斯</char>王<char style="pn">居魯士</char>元年，為了應驗耶和華藉<char style="pn">耶利米</char>的口所說的話，耶和華觸動<char style="pn">波斯</char>王<char style="pn">居魯士</char>的心，使他向全國傳令，並且發文通告：<verse eid="EZR 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZR 1:2" />「<char style="pn">波斯</char>王<char style="pn">居魯士</char>如此說：</para>
  <para style="mi" vid="EZR 1:2">天上的神耶和華把地上的萬國都賜給了我，他也指派我在<char style="pn">猶大</char>的<char style="pn">耶路撒冷</char>為他建造殿宇。 <verse eid="EZR 1:2" /><verse number="3" style="v" sid="EZR 1:3" />所以你們當中無論是誰，凡是屬神的子民，願他的神與他同在，願他上<char style="pn">猶大</char>的<char style="pn">耶路撒冷</char>去，建造<char style="pn">以色列</char>的神耶和華的殿，耶和華就是那在<char style="pn">耶路撒冷</char>的神。 <verse eid="EZR 1:3" /><verse number="4" style="v" sid="EZR 1:4" />這些餘剩者，無論寄居在什麼地方，那地方的人都要用金銀、財物和牲畜支持他們，還要為<char style="pn">耶路撒冷</char>的神的殿奉獻甘心祭。」<verse eid="EZR 1:4" /></para>
  <para style="s">擄民回歸耶路撒冷</para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5" />於是，<char style="pn">猶大</char>和<char style="pn">便雅憫</char>的各父系首領，祭司、<char style="pn">利未</char>人，凡是被神觸動了心的人，都起來，要上去建造<char style="pn">耶路撒冷</char>的耶和華的殿。 <verse eid="EZR 1:5" /><verse number="6" style="v" sid="EZR 1:6" />他們周圍的人都用銀器、金子、財物、牲畜和珍寶來支持他們，還有各樣甘願奉獻的禮物。 <verse eid="EZR 1:6" /><verse number="7" style="v" sid="EZR 1:7" /><char style="pn">居魯士</char>王也拿出了耶和華殿的器皿，就是<char style="pn">尼布甲尼撒</char>從<char style="pn">耶路撒冷</char>取走，放在自己神明殿宇裡的那些器皿。 <verse eid="EZR 1:7" /><verse number="8" style="v" sid="EZR 1:8" /><char style="pn">波斯</char>王<char style="pn">居魯士</char>委派司庫官<char style="pn">米特利達</char>把它們拿出來，清點了交給<char style="pn">猶大</char>的領袖<char style="pn">設巴薩</char>。 <verse eid="EZR 1:8" /><verse number="9" style="v" sid="EZR 1:9" />它們的數目如下：金盤三十個，銀盤一千個，刀子<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">刀子——或譯作「香爐」。</char></note>二十九把， <verse eid="EZR 1:9" /><verse number="10" style="v" sid="EZR 1:10" />金碟三十個，成套的銀碟四百一十個<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">成套的銀碟四百一十個——七十士譯本作「銀碟兩千四百一十個」。</char></note>，別的器皿一千件； <verse eid="EZR 1:10" /><verse number="11" style="v" sid="EZR 1:11" />金銀器皿總共有五千四百件。<char style="pn">設巴薩</char>帶領那些擄民從<char style="pn">巴比倫</char>上<char style="pn">耶路撒冷</char>的時候，也把這些器皿都一同帶了上來。<verse eid="EZR 1:11" /></para>
  <chapter eid="EZR 1" />
  <chapter number="2" style="c" sid="EZR 2" />
  <para style="s">回歸的擄民</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 2:1" />以下是從流亡之地的擄民中上來的<char style="pn">猶大</char>省人，他們從前被<char style="pn">巴比倫</char>王<char style="pn">尼布甲尼撒</char>擄到了<char style="pn">巴比倫</char>，現在回歸<char style="pn">耶路撒冷</char>和<char style="pn">猶大</char>，各回本城。 <verse eid="EZR 2:1" /><verse number="2" style="v" sid="EZR 2:2" />他們是跟著<char style="pn">所羅巴伯</char>、<char style="pn">耶書亞</char>、<char style="pn">尼希米</char>、<char style="pn">西萊雅</char>、<char style="pn">利耶拉雅</char>、<char style="pn">末迪凱</char>、<char style="pn">比爾杉</char>、<char style="pn">米斯帕爾</char>、<char style="pn">比格瓦伊</char>、<char style="pn">利戶姆</char>、<char style="pn">巴納</char>一起回來的。</para>
  <para style="p" vid="EZR 2:2">這些<char style="pn">以色列</char>民眾，男人的數目如下：<verse eid="EZR 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZR 2:3" />
    <char style="pn">帕羅示</char>的子孫，兩千一百七十二人；<verse eid="EZR 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZR 2:4" />
    <char style="pn">示法提雅</char>的子孫，三百七十二人；<verse eid="EZR 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZR 2:5" />
    <char style="pn">阿拉赫</char>的子孫，七百七十五人；<verse eid="EZR 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZR 2:6" />
    <char style="pn">帕哈摩押</char>的子孫，就是<char style="pn">耶書亞</char>的子孫和<char style="pn">約押</char>的子孫，兩千八百一十二人；<verse eid="EZR 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZR 2:7" />
    <char style="pn">以攔</char>的子孫，一千兩百五十四人；<verse eid="EZR 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZR 2:8" />
    <char style="pn">薩圖</char>的子孫，九百四十五人；<verse eid="EZR 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZR 2:9" />
    <char style="pn">撒該</char>的子孫，七百六十人；<verse eid="EZR 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZR 2:10" />
    <char style="pn">巴尼</char>的子孫，六百四十二人；<verse eid="EZR 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZR 2:11" />
    <char style="pn">比巴伊</char>的子孫，六百二十三人；<verse eid="EZR 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZR 2:12" />
    <char style="pn">阿茲伽德</char>的子孫，一千兩百二十二人；<verse eid="EZR 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZR 2:13" />
    <char style="pn">亞多尼卡姆</char>的子孫，六百六十六人；<verse eid="EZR 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZR 2:14" />
    <char style="pn">比格瓦伊</char>的子孫，兩千零五十六人；<verse eid="EZR 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZR 2:15" />
    <char style="pn">阿丁</char>的子孫，四百五十四人；<verse eid="EZR 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZR 2:16" />
    <char style="pn">阿特爾</char>的子孫，就是<char style="pn">希西加</char>的後裔，九十八人；<verse eid="EZR 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZR 2:17" />
    <char style="pn">比扎伊</char>的子孫，三百二十三人；<verse eid="EZR 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZR 2:18" />
    <char style="pn">約拉</char>的子孫，一百一十二人；<verse eid="EZR 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="EZR 2:19" />
    <char style="pn">哈書姆</char>的子孫，兩百二十三人；<verse eid="EZR 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="EZR 2:20" />
    <char style="pn">格巴爾</char>的子孫，九十五人；<verse eid="EZR 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="EZR 2:21" />
    <char style="pn">伯利恆</char>人，一百二十三人；<verse eid="EZR 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="EZR 2:22" />
    <char style="pn">尼托法</char>人，五十六人；<verse eid="EZR 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="EZR 2:23" />
    <char style="pn">亞納圖</char>人，一百二十八人；<verse eid="EZR 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="EZR 2:24" />
    <char style="pn">阿茲瑪維</char>人，四十二人；<verse eid="EZR 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="EZR 2:25" />
    <char style="pn">基列-耶琳</char>人、<char style="pn">克非拉</char>人、<char style="pn">比錄</char>人，七百四十三人；<verse eid="EZR 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="EZR 2:26" />
    <char style="pn">拉瑪</char>人和<char style="pn">迦巴</char>人，六百二十一人；<verse eid="EZR 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="EZR 2:27" />
    <char style="pn">米克瑪</char>人，一百二十二人；<verse eid="EZR 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="EZR 2:28" />
    <char style="pn">伯特利</char>和<char style="pn">艾</char>城的人，兩百二十三人；<verse eid="EZR 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZR 2:29" />
    <char style="pn">尼波</char>人，五十二人；<verse eid="EZR 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="EZR 2:30" />
    <char style="pn">瑪革比士</char>人，一百五十六人；<verse eid="EZR 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZR 2:31" />另一個<char style="pn">以攔</char>的子孫，一千兩百五十四人；<verse eid="EZR 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="EZR 2:32" />
    <char style="pn">哈琳</char>的子孫，三百二十人；<verse eid="EZR 2:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZR 2:33" />
    <char style="pn">羅德</char>人、<char style="pn">哈迪</char>人、<char style="pn">阿挪</char>人，七百二十五人；<verse eid="EZR 2:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZR 2:34" />
    <char style="pn">耶利哥</char>人，三百四十五人；<verse eid="EZR 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="EZR 2:35" />
    <char style="pn">西納</char>人，三千六百三十人。<verse eid="EZR 2:35" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="36" style="v" sid="EZR 2:36" />祭司有：</para>
  <para style="q1" vid="EZR 2:36">
    <char style="pn">耶書亞</char>家族的<char style="pn">耶達亞</char>子孫，九百七十三人；<verse eid="EZR 2:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="EZR 2:37" />
    <char style="pn">伊梅爾</char>的子孫，一千零五十二人；<verse eid="EZR 2:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="EZR 2:38" />
    <char style="pn">帕示戶珥</char>的子孫，一千兩百四十七人；<verse eid="EZR 2:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="EZR 2:39" />
    <char style="pn">哈琳</char>的子孫，一千零一十七人。<verse eid="EZR 2:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="EZR 2:40" />
    <char style="pn">利未</char>人有：</para>
  <para style="q1" vid="EZR 2:40">
    <char style="pn">耶書亞</char>的子孫和<char style="pn">卡米爾</char>的子孫，就是<char style="pn">赫達維亞</char>的後裔，七十四人。<verse eid="EZR 2:40" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="EZR 2:41" />歌手有：</para>
  <para style="q1" vid="EZR 2:41">
    <char style="pn">亞薩</char>的子孫，一百二十八人。<verse eid="EZR 2:41" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="42" style="v" sid="EZR 2:42" />門衛的子孫有：</para>
  <para style="q1" vid="EZR 2:42">
    <char style="pn">沙勒姆</char>的子孫、<char style="pn">阿特爾</char>的子孫、</para>
  <para style="q1" vid="EZR 2:42">
    <char style="pn">達門</char>的子孫、<char style="pn">阿庫布</char>的子孫、</para>
  <para style="q1" vid="EZR 2:42">
    <char style="pn">哈迪達</char>的子孫、<char style="pn">朔拜</char>的子孫，</para>
  <para style="q1" vid="EZR 2:42">總共一百三十九人。<verse eid="EZR 2:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="EZR 2:43" />聖殿僕役有：</para>
  <para style="q1" vid="EZR 2:43">
    <char style="pn">西哈</char>的子孫、<char style="pn">哈蘇法</char>的子孫、<char style="pn">塔巴奧特</char>的子孫、<verse eid="EZR 2:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="EZR 2:44" />
    <char style="pn">卡羅斯</char>的子孫、<char style="pn">希阿哈</char>的子孫、<char style="pn">巴頓</char>的子孫、<verse eid="EZR 2:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="EZR 2:45" />
    <char style="pn">利巴納</char>的子孫、<char style="pn">哈伽巴</char>的子孫、<char style="pn">阿庫布</char>的子孫、<verse eid="EZR 2:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="EZR 2:46" />
    <char style="pn">哈伽布</char>的子孫、<char style="pn">沙勒邁</char>的子孫、<char style="pn">哈南</char>的子孫、<verse eid="EZR 2:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="EZR 2:47" />
    <char style="pn">吉德列</char>的子孫、<char style="pn">伽哈爾</char>的子孫、<char style="pn">利阿亞</char>的子孫、<verse eid="EZR 2:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="EZR 2:48" />
    <char style="pn">利汛</char>的子孫、<char style="pn">尼克達</char>的子孫、<char style="pn">伽扎姆</char>的子孫、<verse eid="EZR 2:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="EZR 2:49" />
    <char style="pn">烏撒</char>的子孫、<char style="pn">帕西亞</char>的子孫、<char style="pn">比薩伊</char>的子孫、<verse eid="EZR 2:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="EZR 2:50" />
    <char style="pn">阿斯納</char>的子孫、<char style="pn">米烏尼</char>的子孫、<char style="pn">尼弗舍欣</char>的子孫、<verse eid="EZR 2:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="EZR 2:51" />
    <char style="pn">巴布克</char>的子孫、<char style="pn">哈庫法</char>的子孫、<char style="pn">哈爾胡爾</char>的子孫、<verse eid="EZR 2:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="EZR 2:52" />
    <char style="pn">巴茲路特</char>的子孫、<char style="pn">米希達</char>的子孫、<char style="pn">哈爾沙</char>的子孫、<verse eid="EZR 2:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="EZR 2:53" />
    <char style="pn">巴爾克斯</char>的子孫、<char style="pn">西西拉</char>的子孫、<char style="pn">特瑪赫</char>的子孫、<verse eid="EZR 2:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="EZR 2:54" />
    <char style="pn">尼西亞</char>的子孫、<char style="pn">哈提法</char>的子孫。<verse eid="EZR 2:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="EZR 2:55" />
    <char style="pn">所羅門</char>臣僕的子孫有：</para>
  <para style="q1" vid="EZR 2:55">
    <char style="pn">索泰</char>的子孫、<char style="pn">索菲列</char>的子孫、<char style="pn">培魯達</char>的子孫、<verse eid="EZR 2:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="EZR 2:56" />
    <char style="pn">雅阿拉</char>的子孫、<char style="pn">達爾崑</char>的子孫、<char style="pn">吉德列</char>的子孫、<verse eid="EZR 2:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="EZR 2:57" />
    <char style="pn">示法提雅</char>的子孫、<char style="pn">哈提列</char>的子孫、</para>
  <para style="q1" vid="EZR 2:57">
    <char style="pn">波克列·澤巴音</char>的子孫、<char style="pn">亞米</char>的子孫。<verse eid="EZR 2:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="EZR 2:58" />聖殿僕役和<char style="pn">所羅門</char>臣僕的子孫，總共三百九十二人。<verse eid="EZR 2:58" /></para>
  <para style="b" />
  <para style="p">
    <verse number="59" style="v" sid="EZR 2:59" />從<char style="pn">特拉米拉</char>、<char style="pn">特拉哈薩</char>、<char style="pn">克魯布</char>、<char style="pn">亞丹</char>、<char style="pn">伊梅爾</char>上來的人，無法說明自己的父家和世系<note caller="+" style="f"><char style="fr" closed="false">2:59 </char><char style="ft" closed="false">世系——或譯作「後裔」。</char></note>是否屬於<char style="pn">以色列</char>，這些人有：<verse eid="EZR 2:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="EZR 2:60" />
    <char style="pn">德拉雅</char>的子孫、<char style="pn">托比亞</char>的子孫、</para>
  <para style="q1" vid="EZR 2:60">
    <char style="pn">尼克達</char>的子孫，共六百五十二人。<verse eid="EZR 2:60" /></para>
  <para style="b" />
  <para style="p">
    <verse number="61" style="v" sid="EZR 2:61" />另外，祭司的子孫中，有<char style="pn">哈巴雅</char>的子孫、<char style="pn">哈克茲</char>的子孫、<char style="pn">巴爾茲萊</char>的子孫——這<char style="pn">巴爾茲萊</char>娶了<char style="pn">基列</char>人<char style="pn">巴爾茲萊</char>的女兒為妻，所以照著岳父家的名字稱呼—— <verse eid="EZR 2:61" /><verse number="62" style="v" sid="EZR 2:62" />這些人在所記錄的家譜中尋找有關自己的記錄，卻找不到，於是被算為不潔而革除了祭司職份。 <verse eid="EZR 2:62" /><verse number="63" style="v" sid="EZR 2:63" />省長告誡他們，不可吃至聖物，直到有一位使用烏陵和土明的祭司興起。<verse eid="EZR 2:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="EZR 2:64" />全體會眾，一共四萬兩千三百六十人。<verse eid="EZR 2:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="EZR 2:65" />此外還有他們的僕婢，七千三百三十七人；</para>
  <para style="q1" vid="EZR 2:65">還有他們的男女歌手，兩百人。<verse eid="EZR 2:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="EZR 2:66" />他們的馬有七百三十六匹，</para>
  <para style="q1" vid="EZR 2:66">騾子有兩百四十五匹，<verse eid="EZR 2:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="EZR 2:67" />駱駝有四百三十五匹，</para>
  <para style="q1" vid="EZR 2:67">驢子有六千七百二十匹。<verse eid="EZR 2:67" /></para>
  <para style="s">為神的殿奉獻</para>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68" />各父系的首領來到耶和華在<char style="pn">耶路撒冷</char>的居所時，他們中的一些人為神的殿甘願奉獻，為要在原來的根基上重建神的殿。 <verse eid="EZR 2:68" /><verse number="69" style="v" sid="EZR 2:69" />人們照著自己的能力，給工程的銀庫捐獻了總共六萬一千達利克金幣<note caller="+" style="f"><char style="fr" closed="false">2:69 </char><char style="ft" closed="false">六萬一千達利克金幣——相當於512公斤金子。1達利克金幣=8.4公克。</char></note>，五千彌納銀幣<note caller="+" style="f"><char style="fr" closed="false">2:69 </char><char style="ft" closed="false">五千彌納銀幣——相當於2,850公斤銀子。1彌納銀幣=570公克。</char></note>，一百件祭司的禮服。<verse eid="EZR 2:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70" />那時，祭司、<char style="pn">利未</char>人、一些民眾、歌手、門衛和聖殿僕役住在各自的城中，其他<char style="pn">以色列</char>人也都住在各自的城中。<verse eid="EZR 2:70" /></para>
  <chapter eid="EZR 2" />
  <chapter number="3" style="c" sid="EZR 3" />
  <para style="s">恢復獻祭</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1" />到了七月，<char style="pn">以色列</char>子民都在各自的城中了。那時，民眾如同一人聚集到<char style="pn">耶路撒冷</char>。 <verse eid="EZR 3:1" /><verse number="2" style="v" sid="EZR 3:2" /><char style="pn">約薩達</char>的兒子<char style="pn">耶書亞</char>和他的兄弟眾祭司，以及<char style="pn">撒拉鐵</char>的兒子<char style="pn">所羅巴伯</char>和他的兄弟們，就起來重建<char style="pn">以色列</char>神的祭壇，要照著神人<char style="pn">摩西</char>的律法上所記的，在祭壇上獻燔祭。 <verse eid="EZR 3:2" /><verse number="3" style="v" sid="EZR 3:3" />雖然各地的民眾恐嚇他們，他們還是在原來的基座上修築了祭壇，在祭壇上向耶和華獻燔祭，就是清晨和傍晚的燔祭。 <verse eid="EZR 3:3" /><verse number="4" style="v" sid="EZR 3:4" />他們照著律法<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">律法——輔助詞語。</char></note>上所記的守住棚節，每天按照規定的份額、照著數目獻上當天的燔祭。 <verse eid="EZR 3:4" /><verse number="5" style="v" sid="EZR 3:5" />之後，他們獻上常獻的燔祭、新月節的祭物、耶和華神聖節期的所有祭物，以及甘願奉獻給耶和華的一切甘心祭。<verse eid="EZR 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 3:6" />從七月一日起，他們開始向耶和華獻上燔祭，那時耶和華的聖殿還沒有奠定根基。 <verse eid="EZR 3:6" /><verse number="7" style="v" sid="EZR 3:7" />他們又照著<char style="pn">波斯</char>王<char style="pn">居魯士</char>給他們的許可，把銀子交給石匠和木匠，又把食物、酒和油交給<char style="pn">西頓</char>人和<char style="pn">提爾</char>人，好讓他們把香柏木從<char style="pn">黎巴嫩</char>經海上運到<char style="pn">約帕</char>。<verse eid="EZR 3:7" /></para>
  <para style="s">重建聖殿</para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 3:8" />他們來到<char style="pn">耶路撒冷</char>的神的殿之後，在第二年的二月，<char style="pn">撒拉鐵</char>的兒子<char style="pn">所羅巴伯</char>、<char style="pn">約薩達</char>的兒子<char style="pn">耶書亞</char>，還有他們其餘的兄弟——那些祭司和<char style="pn">利未</char>人，以及擄民中所有歸回<char style="pn">耶路撒冷</char>的人，就開始動工。他們安排二十歲以上的<char style="pn">利未</char>人來監管耶和華殿的工程。 <verse eid="EZR 3:8" /><verse number="9" style="v" sid="EZR 3:9" />於是，<char style="pn">赫達維亞</char><note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">赫達維亞——或音譯「耶胡達、猶大」；參《以斯拉記》2:40。</char></note>的後裔<char style="pn">耶書亞</char>和他的兒子們、兄弟們以及<char style="pn">卡米爾</char>和他的兒子們，還有<char style="pn">利未</char>人<char style="pn">希納達</char>的子孫、兄弟們，一同合作監管那些在神的殿工作的人。<verse eid="EZR 3:9" /></para>
  <para style="s">奠定聖殿根基</para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10" />當工匠們奠定耶和華聖殿的根基時，祭司們穿著禮服、拿著號筒，<char style="pn">利未</char>人<char style="pn">亞薩</char>的子孫拿著大鈸，他們都照著<char style="pn">以色列</char>王<char style="pn">大衛</char>的規定站立著，讚美耶和華。 <verse eid="EZR 3:10" /><verse number="11" style="v" sid="EZR 3:11" />他們讚美稱謝耶和華，歌唱說：</para>
  <para style="q1" vid="EZR 3:11">「他是美善的，</para>
  <para style="q1" vid="EZR 3:11">他對<char style="pn">以色列</char>的慈愛永遠長存！」</para>
  <para style="b" vid="EZR 3:11" />
  <para style="p" vid="EZR 3:11">他們讚美耶和華的時候，全體民眾大聲呼喊，因為耶和華殿的根基奠定了。 <verse eid="EZR 3:11" /><verse number="12" style="v" sid="EZR 3:12" />有許多祭司、<char style="pn">利未</char>人和父系首領，就是那些見過先前殿宇的長老們，如今親眼看見這殿的根基奠定了，就放聲大哭，也有許多人揚聲歡呼慶祝。 <verse eid="EZR 3:12" /><verse number="13" style="v" sid="EZR 3:13" />人們甚至無法分辨歡呼慶祝的聲音和哭號的聲音，因為民眾大聲呼喊，聲音一直傳到遠處。<verse eid="EZR 3:13" /></para>
  <chapter eid="EZR 3" />
  <chapter number="4" style="c" sid="EZR 4" />
  <para style="s">重建聖殿受阻撓</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1" />
    <char style="pn">猶大</char>和<char style="pn">便雅憫</char>的敵人聽說那些回歸的擄民在為<char style="pn">以色列</char>的神耶和華重建聖殿， <verse eid="EZR 4:1" /><verse number="2" style="v" sid="EZR 4:2" />就來見<char style="pn">所羅巴伯</char>和各父系的首領，對他們說：「讓我們與你們一同建造吧！我們也像你們一樣尋求你們的神，從<char style="pn">亞述</char>王<char style="pn">以撒哈頓</char>把我們遷到這裡的日子以來，我們一直都向你們的神獻祭。」<verse eid="EZR 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3" />但<char style="pn">所羅巴伯</char>和<char style="pn">耶書亞</char>以及<char style="pn">以色列</char>其餘的父系首領對他們說：「我們為我們的神建造殿宇，與你們無關；我們是照著<char style="pn">波斯</char>的王——<char style="pn">居魯士</char>王所吩咐的，要自己為<char style="pn">以色列</char>的神耶和華建造。」<verse eid="EZR 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4" />於是，當地的人就使<char style="pn">猶大</char>民眾的手發軟，阻撓他們建造， <verse eid="EZR 4:4" /><verse number="5" style="v" sid="EZR 4:5" />還收買官員來反對他們，破壞他們的工程計劃。在<char style="pn">波斯</char>王<char style="pn">居魯士</char>所有的日子裡，一直到<char style="pn">波斯</char>王<char style="pn">大流士</char>在位時，都是這樣。<verse eid="EZR 4:5" /></para>
  <para style="s">重建耶路撒冷受阻撓</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6" />
    <char style="pn">亞哈隨魯</char>王在位初期，那些人寫了一封控告信，指控<char style="pn">猶大</char>和<char style="pn">耶路撒冷</char>的居民。 <verse eid="EZR 4:6" /><verse number="7" style="v" sid="EZR 4:7" /><char style="pn">亞達薛西</char>年間，<char style="pn">比施蘭</char>、<char style="pn">米特利達</char>、<char style="pn">塔別</char>以及他們其餘的同僚，上書<char style="pn">波斯</char>王<char style="pn">亞達薛西</char>，公文的文書是用<char style="pn">亞蘭</char>語寫下、用<char style="pn">亞蘭</char>語轉述的。 <verse eid="EZR 4:7" /><verse number="8" style="v" sid="EZR 4:8" />行政長官<char style="pn">利戶姆</char>和書記<char style="pn">希姆沙伊</char>也給<char style="pn">亞達薛西</char>王寫了一封指控<char style="pn">耶路撒冷</char>的奏章：<verse eid="EZR 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 4:9" />「謹有行政長官<char style="pn">利戶姆</char>、書記<char style="pn">希姆沙伊</char>和他們其餘的同僚，司法官、行政官員、各級官員，<char style="pn">波斯</char>人、<char style="pn">烏魯克</char>人、<char style="pn">巴比倫</char>人、<char style="pn">蘇薩</char>人——就是<char style="pn">以攔</char>人， <verse eid="EZR 4:9" /><verse number="10" style="v" sid="EZR 4:10" />以及其餘的民族，就是被偉大尊貴的<char style="pn">亞斯納巴</char>遷移，安置在<char style="pn">撒瑪利亞</char>城和<char style="pn">幼發拉底</char>河對岸其餘地區的民族，現在 <verse eid="EZR 4:10" /><verse number="11" style="v" sid="EZR 4:11" />有呈送給王的奏章副本如下：</para>
  <para style="mi" vid="EZR 4:11">致<char style="pn">亞達薛西</char>王，</para>
  <para style="mi" vid="EZR 4:11">我們是<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">我們是——輔助詞語。</char></note>你的臣民，是<char style="pn">幼發拉底</char>河對岸地區的人。現在 <verse eid="EZR 4:11" /><verse number="12" style="v" sid="EZR 4:12" />願王知道，從王那裡上到我們這裡的<char style="pn">猶太</char>人，已經到了<char style="pn">耶路撒冷</char>，正在重建這座邪惡、反叛的城，就要建好城牆，打好根基了。 <verse eid="EZR 4:12" /><verse number="13" style="v" sid="EZR 4:13" />如今願王知道，如果這城被重建，城牆被建好，他們就不會交納稅捐、貢物和路稅了，王的財政收入就會受損。 <verse eid="EZR 4:13" /><verse number="14" style="v" sid="EZR 4:14" />如今我們既然吃宮廷的鹽，就不應該看著王蒙受虧損<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">蒙受虧損——原文直譯「蒙羞」。</char></note>，因此我們上奏稟告， <verse eid="EZR 4:14" /><verse number="15" style="v" sid="EZR 4:15" />請王調查先王的記事檔案，從記事檔案中查找，就會明白這城是反叛之城，曾使君王和各省受損。從久遠的日子以來，這城就常常發生叛亂，因此才被摧毀。 <verse eid="EZR 4:15" /><verse number="16" style="v" sid="EZR 4:16" />我們稟告王：如果這城被重建，城牆被建好，那麼王在<char style="pn">幼發拉底</char>河對岸地區必將一無所有。」<verse eid="EZR 4:16" /></para>
  <para style="s">亞達薛西王的回覆</para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17" />王就發諭旨給行政長官<char style="pn">利戶姆</char>、書記<char style="pn">希姆沙伊</char>和他們其餘的同僚，就是住在<char style="pn">撒瑪利亞</char>和<char style="pn">幼發拉底</char>河對岸其餘地區的人：</para>
  <para style="mi" vid="EZR 4:17">「願你們平安！</para>
  <para style="mi" vid="EZR 4:17">現在 <verse eid="EZR 4:17" /><verse number="18" style="v" sid="EZR 4:18" />你們呈送來的公函，已經在我面前清楚地誦讀了。 <verse eid="EZR 4:18" /><verse number="19" style="v" sid="EZR 4:19" />我已下令調查，查出這城從久遠的日子以來就常常背叛王，發生造反和叛亂的事。 <verse eid="EZR 4:19" /><verse number="20" style="v" sid="EZR 4:20" />從前有強勢的君王管理<char style="pn">耶路撒冷</char>，有掌權者治理整個<char style="pn">幼發拉底</char>河對岸地區，那時稅捐、貢物和路稅都交給了他們。 <verse eid="EZR 4:20" /><verse number="21" style="v" sid="EZR 4:21" />現在你們要命令這些人停工；我若不下令，這城就不可重建。 <verse eid="EZR 4:21" /><verse number="22" style="v" sid="EZR 4:22" />你們當謹慎，做這件事不可疏忽。何必讓損害增加，使王受虧損呢？」<verse eid="EZR 4:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23" />
    <char style="pn">亞達薛西</char>王的公函副本在<char style="pn">利戶姆</char>、書記<char style="pn">希姆沙伊</char>和他們的同僚面前誦讀後，他們就急忙前往<char style="pn">耶路撒冷</char>，到<char style="pn">猶太</char>人那裡去，以強權和武力使他們停工。<verse eid="EZR 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 4:24" />這樣，<char style="pn">耶路撒冷</char>的神殿工程就停工了，一直停工到<char style="pn">波斯</char>王<char style="pn">大流士</char>執政的第二年。<verse eid="EZR 4:24" /></para>
  <chapter eid="EZR 4" />
  <chapter number="5" style="c" sid="EZR 5" />
  <para style="s">重啟聖殿工程</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1" />那時有兩位先知，就是先知<char style="pn">哈該</char>和<char style="pn">易多</char>的孫子<char style="pn">撒迦利亞</char>，奉那差遣他們的<char style="pn">以色列</char>神的名，說神言鼓勵那些在<char style="pn">猶大</char>和<char style="pn">耶路撒冷</char>的<char style="pn">猶太</char>人。 <verse eid="EZR 5:1" /><verse number="2" style="v" sid="EZR 5:2" />於是<char style="pn">撒拉鐵</char>的兒子<char style="pn">所羅巴伯</char>和<char style="pn">約薩達</char>的兒子<char style="pn">耶書亞</char>起來，開始重建<char style="pn">耶路撒冷</char>的神殿；神的眾先知與他們在一起，扶持他們。<verse eid="EZR 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3" />當時，<char style="pn">幼發拉底</char>河對岸地區的省長<char style="pn">達奈</char>，還有<char style="pn">示塔·波斯奈</char>和他們的同僚，來到<char style="pn">猶太</char>人那裡，對他們這樣說：「誰下令讓你們重建這殿宇，完成這建築的？」 <verse eid="EZR 5:3" /><verse number="4" style="v" sid="EZR 5:4" />又問他們：「重建這建築的那些人叫什麼名字？」<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">此節依據七十士譯本和有些古抄本；馬索拉文本作「我們如實告訴了他們，重建這建築的那些人叫什麼名字。」</char></note> <verse eid="EZR 5:4" /><verse number="5" style="v" sid="EZR 5:5" />然而，神的眼目一直看顧<char style="pn">猶太</char>人的長老們，那些人就沒有讓他們停工，而是等待報告送交<char style="pn">大流士</char>後，得到相關的回覆公函。<verse eid="EZR 5:5" /></para>
  <para style="s">呈給大流士王的奏章</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6" />
    <char style="pn">幼發拉底</char>河對岸地區的省長<char style="pn">達奈</char>，還有<char style="pn">示塔·波斯奈</char>和他的同僚，就是在<char style="pn">幼發拉底</char>河對岸地區的官員們，向<char style="pn">大流士</char>王呈送奏章副本。 <verse eid="EZR 5:6" /><verse number="7" style="v" sid="EZR 5:7" />他們呈送給王的報告，其中這樣寫著：</para>
  <para style="mi" vid="EZR 5:7">「致<char style="pn">大流士</char>王：</para>
  <para style="mi" vid="EZR 5:7">願王萬事平安！<verse eid="EZR 5:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="EZR 5:8" />願王知道，我們前往<char style="pn">猶大</char>省，到了偉大之神的殿。那殿正在用巨大的塊石重建，梁木也安置在牆中；這工作得到認真執行，在他們手中進展順利。 <verse eid="EZR 5:8" /><verse number="9" style="v" sid="EZR 5:9" />我們就問這些長老，對他們這樣說：『誰下令讓你們重建這殿宇，完成這建築的？』 <verse eid="EZR 5:9" /><verse number="10" style="v" sid="EZR 5:10" />我們還問了他們的名字，要把那些為首之人的名字寫下來，稟告王。<verse eid="EZR 5:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="EZR 5:11" />那些人這樣答覆我們說：</para>
  <para style="mi" vid="EZR 5:11">『我們是天地之神的僕人，正在重建這多年前所建造的殿宇。這是一位偉大的<char style="pn">以色列</char>王所建造並完成的， <verse eid="EZR 5:11" /><verse number="12" style="v" sid="EZR 5:12" />只是因為我們的祖先惹天上的神震怒，神就把他們交在<char style="pn">迦勒底</char>人<char style="pn">巴比倫</char>王<char style="pn">尼布甲尼撒</char>手中，<char style="pn">尼布甲尼撒</char>王拆毀了這殿宇，並把民眾遷移到<char style="pn">巴比倫</char>。 <verse eid="EZR 5:12" /><verse number="13" style="v" sid="EZR 5:13" />然而<char style="pn">巴比倫</char>王<char style="pn">居魯士</char>元年，<char style="pn">居魯士</char>王下令重建這座神殿。 <verse eid="EZR 5:13" /><verse number="14" style="v" sid="EZR 5:14" />而且神殿的金銀器皿，就是<char style="pn">尼布甲尼撒</char>從<char style="pn">耶路撒冷</char>的聖殿中取走帶到<char style="pn">巴比倫</char>殿宇的，<char style="pn">居魯士</char>王也從<char style="pn">巴比倫</char>的殿宇中拿出來，交給了王所設立的省長，名叫<char style="pn">設巴薩</char>。 <verse eid="EZR 5:14" /><verse number="15" style="v" sid="EZR 5:15" />王吩咐<char style="pn">設巴薩</char>把這些器皿帶上去，存放在<char style="pn">耶路撒冷</char>的聖殿裡，並在原處重建神的殿。 <verse eid="EZR 5:15" /><verse number="16" style="v" sid="EZR 5:16" />於是這<char style="pn">設巴薩</char>前來，立定了<char style="pn">耶路撒冷</char>神殿的根基。從那時直到如今，神的殿一直在建造，但沒有完工。』<verse eid="EZR 5:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="EZR 5:17" />現在如果王認為好，就請在<char style="pn">巴比倫</char>王室案卷的庫房裡調查，看<char style="pn">居魯士</char>王是否曾下令重建<char style="pn">耶路撒冷</char>這座神殿。然後請王下達關於這事的旨意給我們。」<verse eid="EZR 5:17" /></para>
  <chapter eid="EZR 5" />
  <chapter number="6" style="c" sid="EZR 6" />
  <para style="s">大流士王的調查</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1" />於是<char style="pn">大流士</char>王下令，在<char style="pn">巴比倫</char>存放案卷的檔案庫裡調查。 <verse eid="EZR 6:1" /><verse number="2" style="v" sid="EZR 6:2" />在<char style="pn">米底亞</char><note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">米底亞——原文作「瑪代」。</char></note>省的<char style="pn">亞馬塔</char>城堡中，他們找到一個書卷，其中這樣寫著：</para>
  <para style="mi" vid="EZR 6:2">「記事： <verse eid="EZR 6:2" /><verse number="3" style="v" sid="EZR 6:3" /><char style="pn">居魯士</char>王元年，<char style="pn">居魯士</char>王下令：關於在<char style="pn">耶路撒冷</char>的神殿，要重建這殿宇作為獻祭的地方，並且立定它的根基。這殿宇要高六十肘<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">六十肘——相當於27.4公尺；下同。1肘=45.7公分。</char></note>，寬六十肘， <verse eid="EZR 6:3" /><verse number="4" style="v" sid="EZR 6:4" />有三層大石頭和一層新木料；經費由王室提供。 <verse eid="EZR 6:4" /><verse number="5" style="v" sid="EZR 6:5" />至於神殿的金銀器皿，就是<char style="pn">尼布甲尼撒</char>從<char style="pn">耶路撒冷</char>的聖殿中取走帶到<char style="pn">巴比倫</char>的，也要帶回去，送到<char style="pn">耶路撒冷</char>聖殿中，各歸原處，存放在神的殿中。」<verse eid="EZR 6:5" /></para>
  <para style="s">大流士王的命令</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 6:6" />於是王下令<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">於是王下令——輔助詞語。</char></note>：</para>
  <para style="mi" vid="EZR 6:6">「現在，<char style="pn">幼發拉底</char>河對岸地區的省長<char style="pn">達奈</char>、<char style="pn">示塔·波斯奈</char>和你們的同僚，就是在<char style="pn">幼發拉底</char>河對岸地區的官員們，你們當遠離那裡。 <verse eid="EZR 6:6" /><verse number="7" style="v" sid="EZR 6:7" />不要干涉這座神殿的工程，要讓<char style="pn">猶太</char>人的省長和<char style="pn">猶太</char>人的長老們在原處重建這座神殿。<verse eid="EZR 6:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="EZR 6:8" />我下令指示你們怎樣協助這些<char style="pn">猶太</char>人的長老重建這座神殿：要從王的財政，就是<char style="pn">幼發拉底</char>河對岸地區的稅捐中，提供充足的經費給這些人，以免停工。 <verse eid="EZR 6:8" /><verse number="9" style="v" sid="EZR 6:9" />他們所需要的任何東西，無論是獻給天上的神作燔祭的公牛犢、公綿羊和公羊羔，還是小麥、鹽、酒和油，都要照著<char style="pn">耶路撒冷</char>的祭司們的吩咐，每天提供給他們，不可疏忽。 <verse eid="EZR 6:9" /><verse number="10" style="v" sid="EZR 6:10" />這樣，他們可以向天上的神獻上馨香之祭，並為王和王子們的福壽禱告。<verse eid="EZR 6:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="EZR 6:11" />我還下令：任何人更改這諭旨，就要從他的房屋上拆出一根梁木，把他舉起來釘在上面，他的家必因此成為廢堆。 <verse eid="EZR 6:11" /><verse number="12" style="v" sid="EZR 6:12" />任何君王或臣民，如果擅自更改這諭旨<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">擅自更改這諭旨——原文直譯「伸手更改」。</char></note>，毀壞<char style="pn">耶路撒冷</char>的這座神殿，就願那使自己的名安居其中的神滅絕他！我<char style="pn">大流士</char>已經下令，必須認真執行。」<verse eid="EZR 6:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13" />這樣，<char style="pn">幼發拉底</char>河對岸地區的省長<char style="pn">達奈</char>、<char style="pn">示塔·波斯奈</char>和他們的同僚，就遵照<char style="pn">大流士</char>王下達的命令<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">命令——輔助詞語。</char></note>，認真執行。 <verse eid="EZR 6:13" /><verse number="14" style="v" sid="EZR 6:14" /><char style="pn">猶太</char>人的長老們也在先知<char style="pn">哈該</char>和<char style="pn">易多</char>的孫子<char style="pn">撒迦利亞</char>的神言鼓勵下，繼續建造，進展順利。他們照著<char style="pn">以色列</char>的神的命令，照著<char style="pn">居魯士</char>、<char style="pn">大流士</char>、<char style="pn">波斯</char>王<char style="pn">亞達薛西</char>的命令，建造並完成了。 <verse eid="EZR 6:14" /><verse number="15" style="v" sid="EZR 6:15" />在<char style="pn">大流士</char>王執政的第六年，亞達月的第三日，這聖殿完工了。<verse eid="EZR 6:15" /></para>
  <para style="s">聖殿的奉獻禮和逾越節</para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16" />
    <char style="pn">以色列</char>人，包括祭司、<char style="pn">利未</char>人和其餘的回歸擄民，就歡歡喜喜地為這座神殿舉行奉獻禮。 <verse eid="EZR 6:16" /><verse number="17" style="v" sid="EZR 6:17" />他們為這座神殿的奉獻禮獻上一百頭公牛、兩百隻公綿羊、四百隻公羊羔；又按著<char style="pn">以色列</char>支派的數目，獻上十二隻公山羊，作為全<char style="pn">以色列</char>的贖罪祭。 <verse eid="EZR 6:17" /><verse number="18" style="v" sid="EZR 6:18" />他們還照著<char style="pn">摩西</char>的書上所記的，指派祭司和<char style="pn">利未</char>人按照班組班次，在<char style="pn">耶路撒冷</char>服事神。<verse eid="EZR 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19" />一月十四日，回歸的擄民守逾越節。 <verse eid="EZR 6:19" /><verse number="20" style="v" sid="EZR 6:20" />那時祭司和<char style="pn">利未</char>人同心合一潔淨自己，他們全都潔淨了，就為所有回歸的擄民、他們的兄弟眾祭司，以及他們自己，宰殺了逾越節的羔羊。 <verse eid="EZR 6:20" /><verse number="21" style="v" sid="EZR 6:21" />吃羔羊<note caller="+" style="f"><char style="fr" closed="false">6:21 </char><char style="ft" closed="false">羔羊——輔助詞語。</char></note>的人有從流亡之地回歸的<char style="pn">以色列</char>子孫，也有歸附<char style="pn">以色列</char>的當地人，這些人從外邦人的汙穢中分別出來，為要尋求耶和華<char style="pn">以色列</char>的神。 <verse eid="EZR 6:21" /><verse number="22" style="v" sid="EZR 6:22" />他們歡歡喜喜地守了七天除酵節，因為耶和華使他們歡喜；他使<char style="pn">亞述</char>王的心轉向他們，在<char style="pn">以色列</char>神的神殿工程上扶持他們的手。<verse eid="EZR 6:22" /></para>
  <chapter eid="EZR 6" />
  <chapter number="7" style="c" sid="EZR 7" />
  <para style="s">以斯拉回歸耶路撒冷</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1" />這些事以後，<char style="pn">波斯</char>王<char style="pn">亞達薛西</char>在位時，<char style="pn">以斯拉</char>回來了<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">回來了——輔助詞語。</char></note>——他是<char style="pn">西萊雅</char>的兒子，<char style="pn">西萊雅</char>是<char style="pn">亞撒利雅</char>的兒子，<char style="pn">亞撒利雅</char>是<char style="pn">希勒加</char>的兒子， <verse eid="EZR 7:1" /><verse number="2" style="v" sid="EZR 7:2" /><char style="pn">希勒加</char>是<char style="pn">沙勒姆</char>的兒子，<char style="pn">沙勒姆</char>是<char style="pn">撒督</char>的兒子，<char style="pn">撒督</char>是<char style="pn">亞希突</char>的兒子， <verse eid="EZR 7:2" /><verse number="3" style="v" sid="EZR 7:3" /><char style="pn">亞希突</char>是<char style="pn">亞瑪利雅</char>的兒子，<char style="pn">亞瑪利雅</char>是<char style="pn">亞撒利雅</char>的兒子，<char style="pn">亞撒利雅</char>是<char style="pn">米拉約</char>的兒子， <verse eid="EZR 7:3" /><verse number="4" style="v" sid="EZR 7:4" /><char style="pn">米拉約</char>是<char style="pn">西拉希雅</char>的兒子，<char style="pn">西拉希雅</char>是<char style="pn">烏基</char>的兒子，<char style="pn">烏基</char>是<char style="pn">布其</char>的兒子， <verse eid="EZR 7:4" /><verse number="5" style="v" sid="EZR 7:5" /><char style="pn">布其</char>是<char style="pn">亞比書</char>的兒子，<char style="pn">亞比書</char>是<char style="pn">非尼哈</char>的兒子，<char style="pn">非尼哈</char>是<char style="pn">以利亞撒</char>的兒子，<char style="pn">以利亞撒</char>是大祭司<char style="pn">亞倫</char>的兒子。 <verse eid="EZR 7:5" /><verse number="6" style="v" sid="EZR 7:6" />這<char style="pn">以斯拉</char>從<char style="pn">巴比倫</char>上來，他是經文士，精通<char style="pn">以色列</char>的神耶和華所賜下的<char style="pn">摩西</char>律法。王准許了他所求的一切，因為他的神耶和華的手幫助他。<verse eid="EZR 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 7:7" />這樣，在<char style="pn">亞達薛西</char>王第七年，一些<char style="pn">以色列</char>人、祭司、<char style="pn">利未</char>人、歌手、門衛和聖殿僕役，上<char style="pn">耶路撒冷</char>去。 <verse eid="EZR 7:7" /><verse number="8" style="v" sid="EZR 7:8" /><char style="pn">亞達薛西</char><note caller="+" style="f"><char style="fr" closed="false">7:8 </char><char style="ft" closed="false">亞達薛西——輔助詞語。</char></note>王第七年的五月，<char style="pn">以斯拉</char>來到了<char style="pn">耶路撒冷</char>。 <verse eid="EZR 7:8" /><verse number="9" style="v" sid="EZR 7:9" />他在一月一日從<char style="pn">巴比倫</char>起程上行，五月一日就來到<char style="pn">耶路撒冷</char>，是因他的神施恩的手幫助他。 <verse eid="EZR 7:9" /><verse number="10" style="v" sid="EZR 7:10" />因為<char style="pn">以斯拉</char>立定了心志，要研讀並遵行耶和華的律法，並在<char style="pn">以色列</char>人中教導這些律例和法規。<verse eid="EZR 7:10" /></para>
  <para style="s">亞達薛西王的公文</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11" />
    <char style="pn">亞達薛西</char>王將公文的副本交給了<char style="pn">以斯拉</char>，他是祭司，是經文士，精通耶和華的誡命和賜給<char style="pn">以色列</char>的律例。公文副本如下：<verse eid="EZR 7:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="EZR 7:12" />「王中之王<char style="pn">亞達薛西</char>致祭司<char style="pn">以斯拉</char>，那精通<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">精通——輔助詞語。</char></note>天上之神法令的經文士……<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">省略號——原文語義不明；或譯作「願你平安」。</char></note></para>
  <para style="mi" vid="EZR 7:12">現在 <verse eid="EZR 7:12" /><verse number="13" style="v" sid="EZR 7:13" />我下令：在我國中的<char style="pn">以色列</char>民以及他們的祭司和<char style="pn">利未</char>人，凡是甘願奉獻自己去<char style="pn">耶路撒冷</char>的，都可以與你一起去。 <verse eid="EZR 7:13" /><verse number="14" style="v" sid="EZR 7:14" />既然你從王和七位內閣大臣面前受了差派，照著你的神交託給你的法令去調查<char style="pn">猶大</char>和<char style="pn">耶路撒冷</char>的情況， <verse eid="EZR 7:14" /><verse number="15" style="v" sid="EZR 7:15" />並且帶去王和內閣大臣們甘願奉獻給住在<char style="pn">耶路撒冷</char>的<char style="pn">以色列</char>之神的金銀， <verse eid="EZR 7:15" /><verse number="16" style="v" sid="EZR 7:16" />還有你在<char style="pn">巴比倫</char>全省得到的一切金銀，以及民眾和祭司們甘願奉獻給<char style="pn">耶路撒冷</char>他們神殿宇的奉獻物， <verse eid="EZR 7:16" /><verse number="17" style="v" sid="EZR 7:17" />那麼，這些銀子要專用於購買公牛、公綿羊、公羊羔，以及同獻的素祭和酒祭，你要在<char style="pn">耶路撒冷</char>你們神殿的祭壇上把它們獻上。 <verse eid="EZR 7:17" /><verse number="18" style="v" sid="EZR 7:18" />其餘的金銀，你和你的兄弟們看怎樣好，就怎樣用，要照著你們神的旨意去做。 <verse eid="EZR 7:18" /><verse number="19" style="v" sid="EZR 7:19" />至於那些交給你，在你神的殿中事奉用的器皿，你要完全交付在<char style="pn">耶路撒冷</char>的神面前。 <verse eid="EZR 7:19" /><verse number="20" style="v" sid="EZR 7:20" />你神的殿由你負責的其餘需用，你可以從王的府庫裡支取。<verse eid="EZR 7:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="EZR 7:21" />我<char style="pn">亞達薛西</char>王向<char style="pn">幼發拉底</char>河對岸地區所有的司庫官下令：那精通<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="ft" closed="false">精通——輔助詞語。</char></note>天上之神法令的經文士，祭司<char style="pn">以斯拉</char>，他向你們要求的一切，你們都要認真照辦； <verse eid="EZR 7:21" /><verse number="22" style="v" sid="EZR 7:22" />銀子上限一百他連得<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">一百他連得——相當於3.4公噸。1他連得=34.2公斤。</char></note>，小麥上限一百柯珥<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">一百柯珥——相當於22,000公升。1柯珥=220公升。</char></note>，酒上限一百罷特<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">一百罷特——相當於2,200公升；下同。1罷特=22公升。</char></note>，油上限一百罷特，鹽不用記數。 <verse eid="EZR 7:22" /><verse number="23" style="v" sid="EZR 7:23" />凡是天上之神所命令的，都要為天上之神的殿盡心執行。何必讓震怒臨到王和王子們的國土呢？ <verse eid="EZR 7:23" /><verse number="24" style="v" sid="EZR 7:24" />你們還要知道：對於所有的祭司、<char style="pn">利未</char>人、歌手、門衛、聖殿僕役，以及在神的這殿宇事奉的人，你們都無權向他們徵收稅捐、貢物和路稅。<verse eid="EZR 7:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="EZR 7:25" />至於你<char style="pn">以斯拉</char>，你要照著你的神賜予你的智慧，指派那些明白你神的法令的人作司法官和審判官，讓他們治理<char style="pn">幼發拉底</char>河對岸地區的所有百姓；你們也要教導那些不明白法令的人。 <verse eid="EZR 7:25" /><verse number="26" style="v" sid="EZR 7:26" />任何人不遵行你神的法令和王的法令，他就要受到嚴厲的審判：或處死，或放逐，或沒收財產，或囚禁。」<verse eid="EZR 7:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27" />我們祖先的神耶和華是當受頌讚的！他把這樣的意念放在王的心中，為要使<char style="pn">耶路撒冷</char>耶和華的聖殿得榮耀。 <verse eid="EZR 7:27" /><verse number="28" style="v" sid="EZR 7:28" />他還在王和王的內閣大臣面前，以及王的所有高官面前向我施慈愛。這樣，因著我神耶和華的手幫助我，我就堅強，從<char style="pn">以色列</char>人中招聚首領們，與我一同上去。<verse eid="EZR 7:28" /></para>
  <chapter eid="EZR 7" />
  <chapter number="8" style="c" sid="EZR 8" />
  <para style="s">與以斯拉一同回歸的人</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 8:1" />
    <char style="pn">亞達薛西</char>王在位時，與我一同從<char style="pn">巴比倫</char>上來的人，他們各父系的首領和家譜記錄如下：<verse eid="EZR 8:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="EZR 8:2" />
    <char style="pn">非尼哈</char>的子孫，有<char style="pn">革順</char>；</para>
  <para style="mi" vid="EZR 8:2">
    <char style="pn">以塔瑪爾</char>的子孫，有<char style="pn">但以理</char>；</para>
  <para style="mi" vid="EZR 8:2">
    <char style="pn">大衛</char>的子孫，有<char style="pn">哈突施</char>， <verse eid="EZR 8:2" /><verse number="3" style="v" sid="EZR 8:3" />屬於<char style="pn">謝喀尼亞</char>的後裔；</para>
  <para style="mi" vid="EZR 8:3">
    <char style="pn">帕羅示</char>的子孫，有<char style="pn">撒迦利亞</char>，以及與他一起記錄在家譜中的男子一百五十人；<verse eid="EZR 8:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="EZR 8:4" />
    <char style="pn">帕哈摩押</char>的子孫，有<char style="pn">西拉希雅</char>的兒子<char style="pn">以利約奈</char>，以及與他一起的男子兩百人；<verse eid="EZR 8:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="EZR 8:5" />
    <char style="pn">薩圖</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">8:5 </char>
      <char style="ft" closed="false">薩圖——依據七十士譯本；馬索拉文本此處缺失名字。</char>
    </note>的子孫，有<char style="pn">雅哈希</char>的兒子<char style="pn">謝喀尼亞</char>，以及與他一起的男子三百人；<verse eid="EZR 8:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="EZR 8:6" />
    <char style="pn">阿丁</char>的子孫，有<char style="pn">約拿單</char>的兒子<char style="pn">伊別德</char>，以及與他一起的男子五十人；<verse eid="EZR 8:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="EZR 8:7" />
    <char style="pn">以攔</char>的子孫，有<char style="pn">亞塔利雅</char>的兒子<char style="pn">耶賽亞</char>，以及與他一起的男子七十人；<verse eid="EZR 8:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="EZR 8:8" />
    <char style="pn">示法提雅</char>的子孫，有<char style="pn">米迦勒</char>的兒子<char style="pn">希巴迪亞</char>，以及與他一起的男子八十人；<verse eid="EZR 8:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="EZR 8:9" />
    <char style="pn">約押</char>的子孫，有<char style="pn">耶希業</char>的兒子<char style="pn">俄巴底亞</char>，以及與他一起的男子兩百一十八人；<verse eid="EZR 8:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="EZR 8:10" />
    <char style="pn">巴尼</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">8:10 </char>
      <char style="ft" closed="false">巴尼——依據七十士譯本；馬索拉文本此處缺失名字。</char>
    </note>的子孫，有<char style="pn">約細斐</char>的兒子<char style="pn">示羅米</char>，以及與他一起的男子一百六十人；<verse eid="EZR 8:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="EZR 8:11" />
    <char style="pn">比巴伊</char>的子孫，有<char style="pn">比巴伊</char>的兒子<char style="pn">撒迦利亞</char>，以及與他一起的男子二十八人；<verse eid="EZR 8:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="EZR 8:12" />
    <char style="pn">阿茲伽德</char>的子孫，有<char style="pn">哈卡坦</char>的兒子<char style="pn">約哈南</char>，以及與他一起的男子一百一十人；<verse eid="EZR 8:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="EZR 8:13" />
    <char style="pn">亞多尼卡姆</char>的子孫是隨後來的，他們的名字是<char style="pn">以利菲烈</char>、<char style="pn">耶烏利</char>、<char style="pn">示瑪雅</char>，與他們一起的男子有六十人；<verse eid="EZR 8:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="EZR 8:14" />
    <char style="pn">比格瓦伊</char>的子孫，有<char style="pn">烏塔伊</char>和<char style="pn">扎克爾</char>，以及與他們一起的男子七十人。<verse eid="EZR 8:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15" />我把他們聚集到流向<char style="pn">亞哈瓦</char>的那條河邊，我們在那裡紮營三天。我在民眾和祭司中仔細查找，卻在那裡沒有找到一個<char style="pn">利未</char>子孫。 <verse eid="EZR 8:15" /><verse number="16" style="v" sid="EZR 8:16" />於是我派遣<char style="pn">以利以謝</char>、<char style="pn">亞利伊勒</char>、<char style="pn">示瑪雅</char>、<char style="pn">以利拿單</char>、<char style="pn">雅立</char>、<char style="pn">以利拿單</char>、<char style="pn">拿單</char>、<char style="pn">撒迦利亞</char>和<char style="pn">米書蘭</char>這些首領，以及教師<char style="pn">約雅立</char>和<char style="pn">以利拿單</char>。 <verse eid="EZR 8:16" /><verse number="17" style="v" sid="EZR 8:17" />我吩咐他們去見<char style="pn">卡西非亞</char>地區的首領<char style="pn">易多</char>，並交代他們要對<char style="pn">易多</char>和他在<char style="pn">卡西非亞</char>地區作聖殿僕役的兄弟們說什麼話，好為我們神的殿帶回來一些事奉的人。 <verse eid="EZR 8:17" /><verse number="18" style="v" sid="EZR 8:18" />因著我們的神施恩的手幫助我們，他們就從<char style="pn">以色列</char>之子<char style="pn">利未</char>的孫子<char style="pn">瑪赫利</char>的後裔中，給我們帶回來一個明達人<char style="pn">示利比</char>，以及他的兒子們和兄弟們十八人； <verse eid="EZR 8:18" /><verse number="19" style="v" sid="EZR 8:19" />還有<char style="pn">哈沙比雅</char>，並與他一起的<char style="pn">米拉利</char>子孫<char style="pn">耶賽亞</char>，以及他的兄弟們和他們的兒子二十人； <verse eid="EZR 8:19" /><verse number="20" style="v" sid="EZR 8:20" />還有一些聖殿僕役，是<char style="pn">大衛</char>和首領們從前所委派服事<char style="pn">利未</char>人的聖殿僕役的子孫<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">的子孫——輔助詞語。</char></note>，共有兩百二十人。他們全都被列入了名單。<verse eid="EZR 8:20" /></para>
  <para style="s">準備回歸</para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21" />那時我在<char style="pn">亞哈瓦</char>河邊宣告禁食，要在我們的神面前謙卑下來，為我們和我們的家屬以及我們所擁有的一切，向神祈求平安的行程。 <verse eid="EZR 8:21" /><verse number="22" style="v" sid="EZR 8:22" />我羞於求王派出軍隊和馬兵幫助我們對付路上的敵人，因為我們已經告訴王說：「我們神施恩的手必幫助所有尋求他的人，他的大能和怒氣必攻擊所有離棄他的人。」 <verse eid="EZR 8:22" /><verse number="23" style="v" sid="EZR 8:23" />我們為此禁食，向我們的神祈求，他就應允了我們的祈求。<verse eid="EZR 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24" />我從祭司首領中分別出來十二個人，就是<char style="pn">示利比</char>、<char style="pn">哈沙比雅</char>，以及他們兄弟中與他們同工的十個人。 <verse eid="EZR 8:24" /><verse number="25" style="v" sid="EZR 8:25" />我把那些金銀和器皿，就是王和內閣大臣們、首領們以及所有在<char style="pn">巴比倫</char>的<char style="pn">以色列</char>人獻給我們神殿的供物，都稱了交給他們。 <verse eid="EZR 8:25" /><verse number="26" style="v" sid="EZR 8:26" />我稱出來交到他們手中的，有：銀子六百五十他連得<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">六百五十他連得——相當於22.2公噸。1他連得=34.2公斤。</char></note>，銀器一百他連得<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">一百他連得——相當於3.4公噸；下同。</char></note>，金子一百他連得； <verse eid="EZR 8:26" /><verse number="27" style="v" sid="EZR 8:27" />金碟二十個，值一千達利克<note caller="+" style="f"><char style="fr" closed="false">8:27 </char><char style="ft" closed="false">一千達利克——相當於8.4公斤金子。1達利克金幣=8.4公克。</char></note>；拋光的上等銅器兩個，珍貴如金。 <verse eid="EZR 8:27" /><verse number="28" style="v" sid="EZR 8:28" />那時，我對他們說：「你們是歸於耶和華為聖的，這些器皿也是神聖的，這些金銀是甘心奉獻物，歸於耶和華你們祖先的神。 <verse eid="EZR 8:28" /><verse number="29" style="v" sid="EZR 8:29" />你們當警醒看守，直到你們在<char style="pn">耶路撒冷</char>耶和華殿的庫房，在祭司和<char style="pn">利未</char>人的首領們以及<char style="pn">以色列</char>各父系首領面前，把它們都過了秤。」 <verse eid="EZR 8:29" /><verse number="30" style="v" sid="EZR 8:30" />於是祭司和<char style="pn">利未</char>人接收了這些稱量過的金銀和器皿，要帶到<char style="pn">耶路撒冷</char>我們神的殿。<verse eid="EZR 8:30" /></para>
  <para style="s">到達耶路撒冷</para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31" />一月十二日，我們從<char style="pn">亞哈瓦</char>河邊起程，往<char style="pn">耶路撒冷</char>去。我們神的手幫助了我們，保守我們避開敵人和路上埋伏之人的手。 <verse eid="EZR 8:31" /><verse number="32" style="v" sid="EZR 8:32" />我們來到<char style="pn">耶路撒冷</char>，在那裡歇息了三天。 <verse eid="EZR 8:32" /><verse number="33" style="v" sid="EZR 8:33" />第四天，在我們神的殿中，我們把金銀和器皿過了秤，然後交到祭司<char style="pn">烏利亞</char>的兒子<char style="pn">米利莫</char>手中，與他同工的有<char style="pn">非尼哈</char>的兒子<char style="pn">以利亞撒</char>，還有<char style="pn">利未</char>人<char style="pn">耶書亞</char>的兒子<char style="pn">約撒巴</char>和<char style="pn">賓努伊</char>的兒子<char style="pn">挪亞迪</char>。 <verse eid="EZR 8:33" /><verse number="34" style="v" sid="EZR 8:34" />這一切都核對了數目和重量，重量全都在當時記下來了。<verse eid="EZR 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35" />從流亡之地回歸的那些擄民，向<char style="pn">以色列</char>的神獻上了燔祭：為全體<char style="pn">以色列</char>人獻上公牛十二頭，公綿羊九十六隻，公羊羔七十七隻，贖罪祭公山羊十二隻；這都是獻給耶和華的燔祭。<verse eid="EZR 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EZR 8:36" />他們也把王的法令交給王的行政官們和大河<note caller="+" style="f"><char style="fr" closed="false">8:36 </char><char style="ft" closed="false">大河——指幼發拉底河。</char></note>對岸的省長們，這些人就資助<char style="pn">以色列</char>民和神的殿。<verse eid="EZR 8:36" /></para>
  <chapter eid="EZR 8" />
  <chapter number="9" style="c" sid="EZR 9" />
  <para style="s">以色列人與外邦人通婚</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1" />這些事辦完後，首領們前來見我，說：「<char style="pn">以色列</char>民眾、祭司和<char style="pn">利未</char>人沒有從各地的民中分別出來，反而效法<char style="pn">迦南</char>人、<char style="pn">赫提</char>人、<char style="pn">比利洗</char>人、<char style="pn">耶布斯</char>人、<char style="pn">亞捫</char>人、<char style="pn">摩押</char>人、<char style="pn">埃及</char>人和<char style="pn">亞摩利</char>人的可憎行為。 <verse eid="EZR 9:1" /><verse number="2" style="v" sid="EZR 9:2" />他們竟然為自己、為自己的兒子娶了那些人的女兒，以致聖潔的種族與各地的民結交，而且首領們和官長們在這不忠之事上是首惡。」 <verse eid="EZR 9:2" /><verse number="3" style="v" sid="EZR 9:3" />我一聽見這事，就撕裂衣服和外袍，拔掉頭髮和鬍鬚，悲淒地坐下來。<verse eid="EZR 9:3" /></para>
  <para style="s">以斯拉的認罪告白</para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 9:4" />凡是因<char style="pn">以色列</char>神的話語戰兢的人，都為那些擄民的不忠而聚集到我這裡。我悲淒地坐著，直到獻晚祭的時候。 <verse eid="EZR 9:4" /><verse number="5" style="v" sid="EZR 9:5" />獻晚祭的時候，我從禁食<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">禁食——或譯作「自我苦待」。</char></note>中起來，穿著撕裂的衣服和外袍，屈膝跪下，向我的神耶和華伸開雙手， <verse eid="EZR 9:5" /><verse number="6" style="v" sid="EZR 9:6" />說：</para>
  <para style="mi" vid="EZR 9:6">「我的神哪，我抱愧羞慚！我的神哪，我不敢向你仰起我的臉！我們的罪孽漫過頭頂，我們的罪責高達諸天。 <verse eid="EZR 9:6" /><verse number="7" style="v" sid="EZR 9:7" />從祖先的日子起，我們就在極大的罪責中，直到今天。因我們的罪孽，我們和我們的君王、祭司們都被交在列國的王手中，被刀殺、被俘虜、被擄掠，滿臉都是羞恥，就像今日這樣。 <verse eid="EZR 9:7" /><verse number="8" style="v" sid="EZR 9:8" />如今在短暫的片刻，有恩典從我們的神耶和華而來，要給我們留下倖存者，並在他的聖地賜給我們一個安身之處<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">安身之處——原文直譯「橛子」。</char></note>，這樣我們的神使我們的眼目明亮，使我們在所受的奴役中稍稍復興。 <verse eid="EZR 9:8" /><verse number="9" style="v" sid="EZR 9:9" />雖然我們成了奴僕，但我們的神並沒有任憑我們受奴役，而是在<char style="pn">波斯</char>諸王面前向我們施慈愛，使我們復興，得以恢復我們神的殿，重建這殿的荒廢之處，使我們在<char style="pn">猶大</char>、在<char style="pn">耶路撒冷</char>有了圍護的牆。<verse eid="EZR 9:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="EZR 9:10" />「既然如此，我們的神哪，現在我們還有什麼可說的呢？我們確實離棄了你的誡命， <verse eid="EZR 9:10" /><verse number="11" style="v" sid="EZR 9:11" />就是你藉著你的僕人眾先知所吩咐說的：『你們將進去繼承的那地是汙穢之地，有各地之民的汙穢和他們的可憎之事，他們使那地從這邊到那邊充滿了他們的不潔。 <verse eid="EZR 9:11" /><verse number="12" style="v" sid="EZR 9:12" />所以不要把你們的女兒嫁給他們的兒子，也不要為你們的兒子娶他們的女兒，永遠不要為他們謀平安和福利，這樣你們就強盛，能吃這地的美物，並使你們的子孫永遠繼承這地。』 <verse eid="EZR 9:12" /><verse number="13" style="v" sid="EZR 9:13" />如今，因我們的惡行，因我們的大罪，我們遭遇了這一切——然而你，我們的神哪，你懲罰我們輕於我們犯罪所當受的<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">所當受的——輔助詞語。</char></note>，還使我們像這樣成為倖存者—— <verse eid="EZR 9:13" /><verse number="14" style="v" sid="EZR 9:14" />難道我們可以再次違背你的誡命，與這些行可憎之事的民族通婚嗎？難道你不會對我們發怒，直到滅絕我們，以致沒有一個餘剩者或倖存者嗎？ <verse eid="EZR 9:14" /><verse number="15" style="v" sid="EZR 9:15" />耶和華<char style="pn">以色列</char>的神哪，你是公義的，我們竟然被留下成為了倖存者，就像今日這樣。看哪，我們在你面前有罪了，為此實在沒有人能在你面前站立得住！」<verse eid="EZR 9:15" /></para>
  <chapter eid="EZR 9" />
  <chapter number="10" style="c" sid="EZR 10" />
  <para style="s">送走外邦妻子</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1" />
    <char style="pn">以斯拉</char>禱告、認罪，俯伏在神的殿前面哭泣的時候，<char style="pn">以色列</char>的廣大會眾——男人、女人和孩子，都聚集到他那裡，人們也痛哭流涕。 <verse eid="EZR 10:1" /><verse number="2" style="v" sid="EZR 10:2" /><char style="pn">以攔</char>的子孫<char style="pn">耶希業</char>的兒子<char style="pn">謝喀尼亞</char>就對<char style="pn">以斯拉</char>說：「我們對我們的神不忠，從當地百姓中娶了外邦女子。雖然這樣，<char style="pn">以色列</char>還有希望。 <verse eid="EZR 10:2" /><verse number="3" style="v" sid="EZR 10:3" />現在讓我們與我們的神立約吧，按著我主與那些因我們神的誡命而戰兢的人的意見，送走那些女人和她們所生的；這事要照著律法處理。 <verse eid="EZR 10:3" /><verse number="4" style="v" sid="EZR 10:4" />起來，這件事要靠你了；我們與你同心，你要堅強行事！」<verse eid="EZR 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5" />於是<char style="pn">以斯拉</char>起來，讓眾祭司首領、<char style="pn">利未</char>人和全體<char style="pn">以色列</char>人都起誓要照著這話語去做。他們就起了誓。 <verse eid="EZR 10:5" /><verse number="6" style="v" sid="EZR 10:6" />隨後，<char style="pn">以斯拉</char>從神的殿前面起身，來到<char style="pn">以利亞實</char>的兒子<char style="pn">約哈南</char>的房間。他待在那裡，不吃飯也不喝水，為那些擄民的不忠而極其悲慟。<verse eid="EZR 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7" />他們在<char style="pn">猶大</char>和<char style="pn">耶路撒冷</char>通告所有回歸的擄民，要他們聚集到<char style="pn">耶路撒冷</char>， <verse eid="EZR 10:7" /><verse number="8" style="v" sid="EZR 10:8" />任何人不照著首領和長老們所商議的在三天之內來到，他的一切財物都要成為奉獻物<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">成為奉獻物——或譯作「被沒收充公」。</char></note>，他自己也要從回歸的擄民會眾當中被革除。<verse eid="EZR 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 10:9" />於是，<char style="pn">猶大</char>和<char style="pn">便雅憫</char>的所有男人三天內都聚集到<char style="pn">耶路撒冷</char>。那是在九月的二十日，全體民眾坐在神殿的廣場上，他們因這事，又因下雨，都戰戰兢兢。 <verse eid="EZR 10:9" /><verse number="10" style="v" sid="EZR 10:10" />祭司<char style="pn">以斯拉</char>起身，對他們說：「你們不忠，娶了外邦女子，以致增添了<char style="pn">以色列</char>的罪責。 <verse eid="EZR 10:10" /><verse number="11" style="v" sid="EZR 10:11" />現在，你們要向你們祖先的神耶和華認罪<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">認罪——原文直譯「獻上感謝」。</char></note>，遵行他的旨意，與當地百姓和外邦女子分別開來。」<verse eid="EZR 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12" />全體會眾大聲回應說：「我們必照著你的話去做。 <verse eid="EZR 10:12" /><verse number="13" style="v" sid="EZR 10:13" />不過民眾很多，這時候又下雨，我們不能站在外面；而且這不是一天、兩天的事，因為在這事上我們有許多人犯罪<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">有許多人犯罪——或譯作「犯了大罪」。</char></note>。 <verse eid="EZR 10:13" /><verse number="14" style="v" sid="EZR 10:14" />請讓我們的首領們代表全體會眾留下來，以後讓我們各城所有娶了外邦女子的人，在指定的時候與各城的長老和審判官們一同前來。這樣，我們的神因這事而發的烈怒就會轉消。」 <verse eid="EZR 10:14" /><verse number="15" style="v" sid="EZR 10:15" />只有<char style="pn">亞撒暉</char>的兒子<char style="pn">約拿單</char>和<char style="pn">提克瓦</char>的兒子<char style="pn">雅哈謝</char>反對這事，<char style="pn">米書蘭</char>和<char style="pn">利未</char>人<char style="pn">沙比泰</char>也支持他們。<verse eid="EZR 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16" />於是，回歸的擄民就這樣做。祭司<char style="pn">以斯拉</char>把各父系首領中的一些人，按著他們的父家分別出來，並且全都列入了名單。他們在十月一日坐下來調查這事， <verse eid="EZR 10:16" /><verse number="17" style="v" sid="EZR 10:17" />直到一月一日，調查完了所有娶外邦女子的男人。<verse eid="EZR 10:17" /></para>
  <para style="s">娶外邦女子的人</para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 10:18" />祭司的子孫中，查出娶了外邦女子的是：</para>
  <para style="mi" vid="EZR 10:18">
    <char style="pn">約薩達</char>的兒子<char style="pn">耶書亞</char>和他兄弟們的子孫中，有<char style="pn">瑪西雅</char>、<char style="pn">以利以謝</char>、<char style="pn">雅立</char>、<char style="pn">基大利</char>； <verse eid="EZR 10:18" /><verse number="19" style="v" sid="EZR 10:19" />他們舉手承諾要送走他們的妻子，並且認罪，為自己的罪獻上了一隻公綿羊。<verse eid="EZR 10:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="EZR 10:20" />
    <char style="pn">伊梅爾</char>的子孫中，有<char style="pn">哈納尼</char>、<char style="pn">希巴迪亞</char>。<verse eid="EZR 10:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="EZR 10:21" />
    <char style="pn">哈琳</char>的子孫中，有<char style="pn">瑪西雅</char>、<char style="pn">以利亞</char>、<char style="pn">示瑪雅</char>、<char style="pn">耶希業</char>、<char style="pn">烏西雅</char>。<verse eid="EZR 10:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="EZR 10:22" />
    <char style="pn">帕示戶珥</char>的子孫中，有<char style="pn">以利約奈</char>、<char style="pn">瑪西雅</char>、<char style="pn">以實瑪利</char>、<char style="pn">拿旦業</char>、<char style="pn">約撒巴</char>、<char style="pn">以利亞薩</char>。<verse eid="EZR 10:22" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="23" style="v" sid="EZR 10:23" />
    <char style="pn">利未</char>人中，有<char style="pn">約撒巴</char>、<char style="pn">示每</char>、<char style="pn">基拉雅</char>——就是<char style="pn">基利達</char>，還有<char style="pn">佩塔希雅</char>、<char style="pn">猶大</char>、<char style="pn">以利以謝</char>。<verse eid="EZR 10:23" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="24" style="v" sid="EZR 10:24" />歌手中，有<char style="pn">以利亞實</char>。</para>
  <para style="mi" vid="EZR 10:24">門衛中，有<char style="pn">沙勒姆</char>、<char style="pn">特勒姆</char>、<char style="pn">烏利</char>。<verse eid="EZR 10:24" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="25" style="v" sid="EZR 10:25" />還有一些<char style="pn">以色列</char>人：</para>
  <para style="mi" vid="EZR 10:25">
    <char style="pn">帕羅示</char>的子孫中，有<char style="pn">拉姆亞</char>、<char style="pn">耶基雅</char>、<char style="pn">瑪基雅</char>、<char style="pn">米雅憫</char>、<char style="pn">以利亞撒</char>、<char style="pn">瑪基雅</char>、<char style="pn">比納雅</char>。<verse eid="EZR 10:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="EZR 10:26" />
    <char style="pn">以攔</char>的子孫中，有<char style="pn">瑪塔尼亞</char>、<char style="pn">撒迦利亞</char>、<char style="pn">耶希業</char>、<char style="pn">阿伯迪</char>、<char style="pn">耶利莫</char>、<char style="pn">以利亞</char>。<verse eid="EZR 10:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="EZR 10:27" />
    <char style="pn">薩圖</char>的子孫中，有<char style="pn">以利約奈</char>、<char style="pn">以利亞實</char>、<char style="pn">瑪塔尼亞</char>、<char style="pn">耶利莫</char>、<char style="pn">撒巴德</char>、<char style="pn">阿茲扎</char>。<verse eid="EZR 10:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="EZR 10:28" />
    <char style="pn">比巴伊</char>的子孫中，有<char style="pn">約哈南</char>、<char style="pn">哈納尼雅</char>、<char style="pn">扎巴伊</char>、<char style="pn">阿特萊</char>。<verse eid="EZR 10:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="EZR 10:29" />
    <char style="pn">巴尼</char>的子孫中，有<char style="pn">米書蘭</char>、<char style="pn">瑪盧克</char>、<char style="pn">亞達雅</char>、<char style="pn">雅實布</char>、<char style="pn">謝阿勒</char>、<char style="pn">耶利莫</char>。<verse eid="EZR 10:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="EZR 10:30" />
    <char style="pn">帕哈摩押</char>的子孫中，有<char style="pn">阿德納</char>、<char style="pn">基拉</char>、<char style="pn">比納雅</char>、<char style="pn">瑪西雅</char>、<char style="pn">瑪塔尼亞</char>、<char style="pn">比撒列</char>、<char style="pn">賓努伊</char>、<char style="pn">瑪拿西</char>。<verse eid="EZR 10:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="EZR 10:31" />
    <char style="pn">哈琳</char>的子孫中，有<char style="pn">以利以謝</char>、<char style="pn">伊示亞</char>、<char style="pn">瑪基雅</char>、<char style="pn">示瑪雅</char>、<char style="pn">西緬</char>、 <verse eid="EZR 10:31" /><verse number="32" style="v" sid="EZR 10:32" /><char style="pn">便雅憫</char>、<char style="pn">瑪盧克</char>、<char style="pn">示瑪利雅</char>。<verse eid="EZR 10:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="EZR 10:33" />
    <char style="pn">哈書姆</char>的子孫中，有<char style="pn">瑪特奈</char>、<char style="pn">瑪特塔</char>、<char style="pn">撒巴德</char>、<char style="pn">以利菲烈</char>、<char style="pn">耶利邁</char>、<char style="pn">瑪拿西</char>、<char style="pn">示每</char>。<verse eid="EZR 10:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="EZR 10:34" />
    <char style="pn">巴尼</char>的子孫中，有<char style="pn">瑪阿代</char>、<char style="pn">阿姆蘭</char>、<char style="pn">烏伊勒</char>、 <verse eid="EZR 10:34" /><verse number="35" style="v" sid="EZR 10:35" /><char style="pn">比納雅</char>、<char style="pn">比迪雅</char>、<char style="pn">克錄希</char>、 <verse eid="EZR 10:35" /><verse number="36" style="v" sid="EZR 10:36" /><char style="pn">瓦尼亞</char>、<char style="pn">米利莫</char>、<char style="pn">以利亞實</char>、 <verse eid="EZR 10:36" /><verse number="37" style="v" sid="EZR 10:37" /><char style="pn">瑪塔尼亞</char>、<char style="pn">瑪特奈</char>、<char style="pn">雅阿蘇</char>、 <verse eid="EZR 10:37" /><verse number="38" style="v" sid="EZR 10:38" /><char style="pn">巴尼</char>、<char style="pn">賓努伊</char>、<char style="pn">示每</char>、 <verse eid="EZR 10:38" /><verse number="39" style="v" sid="EZR 10:39" /><char style="pn">示勒米雅</char>、<char style="pn">拿單</char>、<char style="pn">亞達雅</char>、 <verse eid="EZR 10:39" /><verse number="40" style="v" sid="EZR 10:40" /><char style="pn">瑪赫拿德拜</char>、<char style="pn">沙沙伊</char>、<char style="pn">沙拉伊</char>、 <verse eid="EZR 10:40" /><verse number="41" style="v" sid="EZR 10:41" /><char style="pn">阿扎列</char>、<char style="pn">示勒米雅</char>、<char style="pn">示瑪利雅</char>、 <verse eid="EZR 10:41" /><verse number="42" style="v" sid="EZR 10:42" /><char style="pn">沙勒姆</char>、<char style="pn">亞瑪利雅</char>、<char style="pn">約瑟</char>。<verse eid="EZR 10:42" /></para>
  <para style="mi">
    <verse number="43" style="v" sid="EZR 10:43" />
    <char style="pn">尼波</char>的子孫中，有<char style="pn">耶伊列</char>、<char style="pn">瑪塔提雅</char>、<char style="pn">撒巴德</char>、<char style="pn">錫彼納</char>、<char style="pn">伊度</char>、<char style="pn">約珥</char>、<char style="pn">比納雅</char>。<verse eid="EZR 10:43" /></para>
  <para style="b" />
  <para style="p">
    <verse number="44" style="v" sid="EZR 10:44" />這些人全都娶了外邦女子，其中有些人的妻子還生了兒女<note caller="+" style="f"><char style="fr" closed="false">10:44 </char><char style="ft" closed="false">其中有些人的妻子還生了兒女——或譯作「現在他們把妻子連同孩子都送走了」。</char></note>。<verse eid="EZR 10:44" /></para>
  <chapter eid="EZR 10" />
</usx>