<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JDG" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">士師記</para>
  <para style="mt">士師記</para>
  <chapter number="1" style="c" sid="JDG 1" />
  <para style="s">猶大為首攻打迦南人</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 1:1" />
    <char style="pn">約書亞</char>死了以後，<char style="pn">以色列</char>子民求問耶和華說：「我們當中，誰先上去攻打<char style="pn">迦南</char>人，與他們爭戰呢？」<verse eid="JDG 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 1:2" />耶和華說：「<char style="pn">猶大</char>先上去。看哪，我已經把那地交在他手中了。」<verse eid="JDG 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 1:3" />
    <char style="pn">猶大</char>對他的兄弟<char style="pn">西緬</char>說：「請與我一同上去，到我抽籤所得之地，與<char style="pn">迦南</char>人爭戰。以後我也與你一同到你抽籤所得之地去。」<char style="pn">西緬</char>就與他一同去了。<verse eid="JDG 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 1:4" />
    <char style="pn">猶大</char>上去，耶和華把<char style="pn">迦南</char>人和<char style="pn">比利洗</char>人交在他們手中，他們在<char style="pn">貝澤克</char>擊殺了一萬人。 <verse eid="JDG 1:4" /><verse number="5" style="v" sid="JDG 1:5" />他們在<char style="pn">貝澤克</char>遇見<char style="pn">阿多尼·貝澤克</char>，與他爭戰，擊敗了<char style="pn">迦南</char>人和<char style="pn">比利洗</char>人。<verse eid="JDG 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 1:6" />
    <char style="pn">阿多尼·貝澤克</char>逃跑，他們追趕他，抓住了他，砍掉了他手腳的拇指。 <verse eid="JDG 1:6" /><verse number="7" style="v" sid="JDG 1:7" /><char style="pn">阿多尼·貝澤克</char>說：「從前有七十個王，被我砍掉了手腳的拇指，在我桌子底下撿吃的。現在神照著我所做的，如此回報我了。」他們把他帶到<char style="pn">耶路撒冷</char>，他就死在那裡。<verse eid="JDG 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 1:8" />
    <char style="pn">猶大</char>子孫攻打<char style="pn">耶路撒冷</char>，攻取了它，用刀擊殺城裡的人，又放火燒了那城。 <verse eid="JDG 1:8" /><verse number="9" style="v" sid="JDG 1:9" />之後，<char style="pn">猶大</char>子孫下去，與住在山地、南地<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">南地——音譯作「內蓋夫」；本章下同。</char></note>和丘陵地帶的<char style="pn">迦南</char>人爭戰。 <verse eid="JDG 1:9" /><verse number="10" style="v" sid="JDG 1:10" /><char style="pn">猶大</char>又去攻打住在<char style="pn">希伯崙</char>的<char style="pn">迦南</char>人，擊殺了<char style="pn">示篩</char>、<char style="pn">亞希幔</char>和<char style="pn">塔爾邁</char>；<char style="pn">希伯崙</char>從前名叫<char style="pn">基列-阿爾巴</char>。 <verse eid="JDG 1:10" /><verse number="11" style="v" sid="JDG 1:11" />他們又從那裡去攻打<char style="pn">底璧</char>的居民，<char style="pn">底璧</char>從前名叫<char style="pn">基列西弗</char>。<verse eid="JDG 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 1:12" />
    <char style="pn">迦勒</char>說：「誰攻打<char style="pn">基列西弗</char>，攻取那城，我就把女兒<char style="pn">婭撒</char>嫁給他為妻。」 <verse eid="JDG 1:12" /><verse number="13" style="v" sid="JDG 1:13" /><char style="pn">迦勒</char>的弟弟<char style="pn">基納斯</char>的兒子<char style="pn">俄陀聶</char>攻取了那城，<char style="pn">迦勒</char>就把女兒<char style="pn">婭撒</char>嫁給他為妻。 <verse eid="JDG 1:13" /><verse number="14" style="v" sid="JDG 1:14" /><char style="pn">婭撒</char>出嫁的時候，鼓動丈夫從她父親那裡求一塊田。她下了驢，<char style="pn">迦勒</char>問她：「你有什麼事呢？」 <verse eid="JDG 1:14" /><verse number="15" style="v" sid="JDG 1:15" />她就對父親說：「求你給我一個祝福：你既然把南地給了我，請你把水泉也給我。」於是<char style="pn">迦勒</char>把上泉和下泉都給了她。<verse eid="JDG 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 1:16" />
    <char style="pn">摩西</char>的內兄<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">內兄——或譯作「岳父」或「姻親」；參《士師記》4:11《民數記》10:29。</char></note>是<char style="pn">基尼</char>人，他的子孫與<char style="pn">猶大</char>子孫一起離開<char style="pn">棕櫚</char>城，上到<char style="pn">阿拉德</char>南地的<char style="pn">猶大</char>曠野，去與那裡的人住在一起。<verse eid="JDG 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 1:17" />
    <char style="pn">猶大</char>與他們的兄弟<char style="pn">西緬</char>同去，擊殺住在<char style="pn">洗法</char>的<char style="pn">迦南</char>人，滅絕了那城。他們就給那城起名為<char style="pn">霍爾瑪</char>。 <verse eid="JDG 1:17" /><verse number="18" style="v" sid="JDG 1:18" /><char style="pn">猶大</char>也攻取了<char style="pn">加沙</char>和它的四境，<char style="pn">阿實基倫</char>和它的四境，<char style="pn">以革倫</char>和它的四境。 <verse eid="JDG 1:18" /><verse number="19" style="v" sid="JDG 1:19" />耶和華與<char style="pn">猶大</char>同在，<char style="pn">猶大</char>就占領了山地，然而<char style="pn">猶大</char>不能趕出平原的居民，因為他們有鐵戰車。<verse eid="JDG 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 1:20" />
    <char style="pn">以色列</char>人照著<char style="pn">摩西</char>的吩咐，把<char style="pn">希伯崙</char>給了<char style="pn">迦勒</char>，<char style="pn">迦勒</char>從那裡趕出了三支<char style="pn">亞衲</char>子孫。<verse eid="JDG 1:20" /></para>
  <para style="s">便雅憫的失敗</para>
  <para style="p">
    <verse number="21" style="v" sid="JDG 1:21" />
    <char style="pn">便雅憫</char>人沒有把住在<char style="pn">耶路撒冷</char>的<char style="pn">耶布斯</char>人趕出去，所以<char style="pn">耶布斯</char>人與<char style="pn">便雅憫</char>人一起住在<char style="pn">耶路撒冷</char>，直到今日。<verse eid="JDG 1:21" /></para>
  <para style="s">約瑟家的成功</para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 1:22" />
    <char style="pn">約瑟</char>家也上去攻打<char style="pn">伯特利</char>，耶和華與他們同在。 <verse eid="JDG 1:22" /><verse number="23" style="v" sid="JDG 1:23" /><char style="pn">約瑟</char>家探察<char style="pn">伯特利</char>，這城從前名叫<char style="pn">路斯</char>； <verse eid="JDG 1:23" /><verse number="24" style="v" sid="JDG 1:24" />探子看見一個人從城裡出來，就對他說：「請指給我們進城的路，我們必以恩慈對待你。」 <verse eid="JDG 1:24" /><verse number="25" style="v" sid="JDG 1:25" />那人指給他們進城的路，他們就用刀擊殺城裡的人，但放走了那人和他的全家。 <verse eid="JDG 1:25" /><verse number="26" style="v" sid="JDG 1:26" />那人前往<char style="pn">赫提</char>人之地，建造了一座城，又給那城起名為<char style="pn">路斯</char>，至今還是這名。<verse eid="JDG 1:26" /></para>
  <para style="s">其他支派的失敗</para>
  <para style="p">
    <verse number="27" style="v" sid="JDG 1:27" />
    <char style="pn">瑪拿西</char>沒有趕出<char style="pn">伯珊</char>和附屬村鎮的居民，<char style="pn">特納克</char>和附屬村鎮的居民，<char style="pn">多珥</char>和附屬村鎮的居民，<char style="pn">以伯蓮</char>和附屬村鎮的居民，<char style="pn">米吉多</char>和附屬村鎮的居民；<char style="pn">迦南</char>人堅持住在這地。 <verse eid="JDG 1:27" /><verse number="28" style="v" sid="JDG 1:28" /><char style="pn">以色列</char>強盛的時候，就使<char style="pn">迦南</char>人服苦役，沒有完全趕出他們。<verse eid="JDG 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 1:29" />
    <char style="pn">以法蓮</char>沒有把住在<char style="pn">基色</char>的<char style="pn">迦南</char>人趕出去，於是<char style="pn">迦南</char>人住在<char style="pn">基色</char>，在<char style="pn">以法蓮</char>人當中。<verse eid="JDG 1:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JDG 1:30" />
    <char style="pn">西布倫</char>沒有把<char style="pn">基倫</char>的居民和<char style="pn">拿哈拉</char>的居民趕出去，於是<char style="pn">迦南</char>人住在<char style="pn">西布倫</char>人當中，成了服苦役的人。<verse eid="JDG 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JDG 1:31" />
    <char style="pn">亞設</char>沒有趕出<char style="pn">阿科</char>的居民和<char style="pn">西頓</char>的居民，以及<char style="pn">阿赫拉</char>、<char style="pn">阿克濟</char>、<char style="pn">赫勒巴</char>、<char style="pn">阿費克</char>和<char style="pn">利合</char>的居民。 <verse eid="JDG 1:31" /><verse number="32" style="v" sid="JDG 1:32" />於是<char style="pn">亞設</char>人住在那地的居民<char style="pn">迦南</char>人當中，因為他們沒有趕出<char style="pn">迦南</char>人。<verse eid="JDG 1:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JDG 1:33" />
    <char style="pn">拿弗他利</char>沒有把<char style="pn">伯示麥</char>的居民和<char style="pn">伯亞納</char>的居民趕出去，所以<char style="pn">拿弗他利</char>人住在那地的居民<char style="pn">迦南</char>人當中，但<char style="pn">伯示麥</char>和<char style="pn">伯亞納</char>的居民成了為他們服苦役的人。<verse eid="JDG 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JDG 1:34" />
    <char style="pn">亞摩利</char>人把<char style="pn">但</char>子孫壓制在山地，不讓他們下到平原來。 <verse eid="JDG 1:34" /><verse number="35" style="v" sid="JDG 1:35" /><char style="pn">亞摩利</char>人堅持住在<char style="pn">希列斯</char>山、<char style="pn">阿雅崙</char>和<char style="pn">沙勒賓</char>，當<char style="pn">約瑟</char>家的勢力強盛的時候，他們就成了服苦役的人。 <verse eid="JDG 1:35" /><verse number="36" style="v" sid="JDG 1:36" /><char style="pn">亞摩利</char>人的邊界從<char style="pn">阿克拉賓</char>斜坡起，從<char style="pn">西拉</char>往上延伸。<verse eid="JDG 1:36" /></para>
  <chapter eid="JDG 1" />
  <chapter number="2" style="c" sid="JDG 2" />
  <para style="s">犯罪與審判</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 2:1" />耶和華的使者從<char style="pn">吉甲</char>上到<char style="pn">波金</char>，說：「我把你們從<char style="pn">埃及</char>帶上來，領你們進入我起誓要給你們先祖的土地。那時我說：『我永不廢除我與你們所立的約， <verse eid="JDG 2:1" /><verse number="2" style="v" sid="JDG 2:2" />至於你們，不可與這地的居民立約，你們要拆毀他們的祭壇。』你們卻沒有聽從我的話。你們做的這是什麼事呢？ <verse eid="JDG 2:2" /><verse number="3" style="v" sid="JDG 2:3" />因此我說：我不再從你們面前驅逐這些居民，他們必成為你們肋旁的刺<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">刺——輔助詞語。</char></note>，他們的神明必成為你們的陷阱。」 <verse eid="JDG 2:3" /><verse number="4" style="v" sid="JDG 2:4" />耶和華的使者對全體<char style="pn">以色列</char>子民說這些話的時候，民眾都放聲大哭。 <verse eid="JDG 2:4" /><verse number="5" style="v" sid="JDG 2:5" />於是他們給那地方起名為<char style="pn">波金</char>，並在那裡向耶和華獻祭。<verse eid="JDG 2:5" /></para>
  <para style="s">約書亞去世</para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 2:6" />
    <char style="pn">約書亞</char>遣散了民眾，<char style="pn">以色列</char>子民就各到自己的繼業之地，擁有那地。 <verse eid="JDG 2:6" /><verse number="7" style="v" sid="JDG 2:7" /><char style="pn">約書亞</char>在世的日子以及他死後，那些見過耶和華為<char style="pn">以色列</char>所行一切大事的長老們還在世的日子，民眾都服事耶和華。<verse eid="JDG 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 2:8" />耶和華的僕人<char style="pn">嫩</char>的兒子<char style="pn">約書亞</char>死了，享年一百一十歲。 <verse eid="JDG 2:8" /><verse number="9" style="v" sid="JDG 2:9" />人們把他葬在他繼業的境內，在<char style="pn">迦實</char>山的北方，<char style="pn">以法蓮</char>山地的<char style="pn">亭拿-希列斯</char>。 <verse eid="JDG 2:9" /><verse number="10" style="v" sid="JDG 2:10" />那世代的人也都歸到他們列祖那裡去了，在他們之後另外的世代興起，不知道耶和華，也不知道耶和華為<char style="pn">以色列</char>所行的事。<verse eid="JDG 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 2:11" />
    <char style="pn">以色列</char>子民做耶和華眼中看為惡的事，服事眾<char style="pn">巴力</char>。 <verse eid="JDG 2:11" /><verse number="12" style="v" sid="JDG 2:12" />他們離棄了把他們從<char style="pn">埃及</char>地領出來的耶和華他們祖先的神，而跟從別的神，就是他們四圍各民族的神明，向它們下拜，惹怒了耶和華。 <verse eid="JDG 2:12" /><verse number="13" style="v" sid="JDG 2:13" />他們離棄耶和華，服事<char style="pn">巴力</char>和<char style="pn">亞斯她錄</char>。<verse eid="JDG 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 2:14" />於是耶和華對<char style="pn">以色列</char>發怒，把他們交在搶掠者手中，使他們被搶掠；又把他們交於<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">交於——原文直譯「賣到」。</char></note>四圍的仇敵手中，使他們在仇敵面前再也站立不住。 <verse eid="JDG 2:14" /><verse number="15" style="v" sid="JDG 2:15" />他們每次出戰，耶和華的手都以禍患攻擊他們，正如耶和華所說的，如耶和華對他們所起的誓。他們就陷入了極大的危難。<verse eid="JDG 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 2:16" />於是耶和華興起士師，拯救他們脫離搶掠者的手。 <verse eid="JDG 2:16" /><verse number="17" style="v" sid="JDG 2:17" />但他們連士師也不聽從，繼續行淫追隨別的神，向它們下拜，很快偏離了祖先所行的道路，不像他們祖先那樣聽從耶和華的誡命。 <verse eid="JDG 2:17" /><verse number="18" style="v" sid="JDG 2:18" />當耶和華為他們興起士師的時候，耶和華與士師同在；士師在世的日子，耶和華都拯救他們脫離仇敵的手。他們因壓迫和苦害他們之人而發出哀聲，耶和華就施憐憫<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">施憐憫——或譯作「感到後悔」。</char></note>。 <verse eid="JDG 2:18" /><verse number="19" style="v" sid="JDG 2:19" />可是當士師死了之後，他們就反轉，比他們的祖先更敗壞，去跟從別的神，服事那些神明，向它們下拜。他們總不離棄他們的惡行和頑梗行為。<verse eid="JDG 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 2:20" />於是耶和華對<char style="pn">以色列</char>人發怒，說：「既然這民違背我為他們祖先立定的約，不聽從我的話， <verse eid="JDG 2:20" /><verse number="21" style="v" sid="JDG 2:21" />那麼我也不再從他們面前，趕出<char style="pn">約書亞</char>死時還剩下的各族中任何一人。 <verse eid="JDG 2:21" /><verse number="22" style="v" sid="JDG 2:22" />我要藉著這些民族試驗<char style="pn">以色列</char>，看他們是否會像他們的祖先那樣，謹守遵行耶和華的道。」 <verse eid="JDG 2:22" /><verse number="23" style="v" sid="JDG 2:23" />這樣，耶和華留下了這些民族，沒有很快趕出他們，沒有把他們交在<char style="pn">約書亞</char>手中。<verse eid="JDG 2:23" /></para>
  <chapter eid="JDG 2" />
  <chapter number="3" style="c" sid="JDG 3" />
  <para style="s">耶和華試驗以色列</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 3:1" />以下是耶和華留下的那些民族，為要藉著他們試驗所有未曾經歷過<char style="pn">迦南</char>任何戰事的<char style="pn">以色列</char>人， <verse eid="JDG 3:1" /><verse number="2" style="v" sid="JDG 3:2" />特意讓<char style="pn">以色列</char>的子孫後代，特意讓以前沒有經歷過的人去經歷戰事，教導他們作戰。 <verse eid="JDG 3:2" /><verse number="3" style="v" sid="JDG 3:3" />所留下的有：<char style="pn">非利士</char>的五個首領；所有的<char style="pn">迦南</char>人；<char style="pn">西頓</char>人；從<char style="pn">巴力黑門</char>山直到<char style="pn">哈馬</char>隘口住在<char style="pn">黎巴嫩</char>山地的<char style="pn">希未</char>人。 <verse eid="JDG 3:3" /><verse number="4" style="v" sid="JDG 3:4" />這是為要藉著他們試驗<char style="pn">以色列</char>人，要知道他們是否會聽從耶和華藉著<char style="pn">摩西</char>所指示他們祖先的誡命。 <verse eid="JDG 3:4" /><verse number="5" style="v" sid="JDG 3:5" />然而，<char style="pn">以色列</char>子民住在<char style="pn">迦南</char>人、<char style="pn">赫提</char>人、<char style="pn">亞摩利</char>人、<char style="pn">比利洗</char>人、<char style="pn">希未</char>人和<char style="pn">耶布斯</char>人中間， <verse eid="JDG 3:5" /><verse number="6" style="v" sid="JDG 3:6" />娶他們的女兒為妻，又把自己的女兒嫁給他們的兒子，並且服事他們的神明。<verse eid="JDG 3:6" /></para>
  <para style="s">俄陀聶</para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 3:7" />
    <char style="pn">以色列</char>子民做耶和華眼中看為惡的事，忘記了耶和華他們的神，而服事<char style="pn">巴力</char>和<char style="pn">亞舍拉</char>。 <verse eid="JDG 3:7" /><verse number="8" style="v" sid="JDG 3:8" />於是耶和華對<char style="pn">以色列</char>發怒，把他們交於<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">交於——原文直譯「賣到」。</char></note><char style="pn">美索不達米亞</char><note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">美索不達米亞——原文直譯「兩河之間的亞蘭」。</char></note>王<char style="pn">古珊·利薩田</char>手中。<char style="pn">以色列</char>子民服事了<char style="pn">古珊·利薩田</char>八年。<verse eid="JDG 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 3:9" />
    <char style="pn">以色列</char>子民向耶和華哀求，耶和華就為<char style="pn">以色列</char>子民興起一位拯救者來救他們，就是<char style="pn">迦勒</char>的弟弟、<char style="pn">基納斯</char>的兒子<char style="pn">俄陀聶</char>。 <verse eid="JDG 3:9" /><verse number="10" style="v" sid="JDG 3:10" />耶和華的靈臨到<char style="pn">俄陀聶</char>身上，他就作了<char style="pn">以色列</char>的士師。他出去作戰，耶和華把<char style="pn">亞蘭</char>王<char style="pn">古珊·利薩田</char>交在他手中，他的手就制伏了<char style="pn">古珊·利薩田</char>。 <verse eid="JDG 3:10" /><verse number="11" style="v" sid="JDG 3:11" />於是國中太平了四十年，後來<char style="pn">基納斯</char>的兒子<char style="pn">俄陀聶</char>死了。<verse eid="JDG 3:11" /></para>
  <para style="s">以胡德</para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 3:12" />
    <char style="pn">以色列</char>子民又做耶和華眼中看為惡的事。於是耶和華使<char style="pn">摩押</char>王<char style="pn">伊磯倫</char>強盛，壓制<char style="pn">以色列</char>，因為他們做了耶和華眼中看為惡的事。 <verse eid="JDG 3:12" /><verse number="13" style="v" sid="JDG 3:13" /><char style="pn">伊磯倫</char>把<char style="pn">亞捫</char>人和<char style="pn">亞瑪力</char>人招聚到他那裡，來攻打<char style="pn">以色列</char>，占據了棕櫚城。 <verse eid="JDG 3:13" /><verse number="14" style="v" sid="JDG 3:14" /><char style="pn">以色列</char>子民服事了<char style="pn">摩押</char>王<char style="pn">伊磯倫</char>十八年。<verse eid="JDG 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 3:15" />
    <char style="pn">以色列</char>子民向耶和華哀求，耶和華就為他們興起一位拯救者，<char style="pn">便雅憫</char>人<char style="pn">基拉</char>的兒子<char style="pn">以胡德</char>，他是一個慣用左手的人。那時，<char style="pn">以色列</char>子民委託他呈送貢物給<char style="pn">摩押</char>王<char style="pn">伊磯倫</char>。 <verse eid="JDG 3:15" /><verse number="16" style="v" sid="JDG 3:16" /><char style="pn">以胡德</char>為自己打造了一把一肘<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">一肘——相當於45.7公分。</char></note>長的雙刃刀，綁在右大腿上衣袍裡面。 <verse eid="JDG 3:16" /><verse number="17" style="v" sid="JDG 3:17" />他把貢物獻給<char style="pn">摩押</char>王<char style="pn">伊磯倫</char>，<char style="pn">伊磯倫</char>是一個很肥胖的人。 <verse eid="JDG 3:17" /><verse number="18" style="v" sid="JDG 3:18" /><char style="pn">以胡德</char>獻完貢物以後，把抬貢物的人打發走了， <verse eid="JDG 3:18" /><verse number="19" style="v" sid="JDG 3:19" />他自己卻從<char style="pn">吉甲</char>附近的雕像群那裡返回，說：「王啊，我有機密的事要向你稟報。」王說：「先不要開口<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">先不要開口——原文直譯「安靜」。</char></note>！」他旁邊侍立的人都退了出去， <verse eid="JDG 3:19" /><verse number="20" style="v" sid="JDG 3:20" /><char style="pn">以胡德</char>來到王那裡，王正獨自坐在涼爽的閣樓裡。<char style="pn">以胡德</char>說：「我有神的話要向你稟報。」王就從寶座上起身。 <verse eid="JDG 3:20" /><verse number="21" style="v" sid="JDG 3:21" /><char style="pn">以胡德</char>伸出左手，從右腿上拔出刀來，刺進王的肚子， <verse eid="JDG 3:21" /><verse number="22" style="v" sid="JDG 3:22" />連刀柄也隨著刀鋒刺了進去；肥肉裹住了刀鋒，因此<char style="pn">以胡德</char>沒有把刀從王的肚子裡拔出；王的糞便都流了出來。 <verse eid="JDG 3:22" /><verse number="23" style="v" sid="JDG 3:23" /><char style="pn">以胡德</char>出來到走廊上，他把閣樓的門從裡面關上，鎖住了。<verse eid="JDG 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 3:24" />
    <char style="pn">以胡德</char>出去之後，王的臣僕們來了，他們觀看，發現閣樓的門鎖住了，就想：「王一定是在涼爽的裡間解手。」 <verse eid="JDG 3:24" /><verse number="25" style="v" sid="JDG 3:25" />他們一直等候，直到覺得尷尬，但王還是沒有打開閣樓的門。他們就拿鑰匙開門，看哪，主人已經倒在地上死了。<verse eid="JDG 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JDG 3:26" />在他們耽延的時候，<char style="pn">以胡德</char>已經逃離了。他經過雕像群那裡，逃往<char style="pn">西伊拉</char>。 <verse eid="JDG 3:26" /><verse number="27" style="v" sid="JDG 3:27" />到了那裡，他就在<char style="pn">以法蓮</char>山地吹響號角。<char style="pn">以色列</char>人與他一同下山，他在他們前面。 <verse eid="JDG 3:27" /><verse number="28" style="v" sid="JDG 3:28" /><char style="pn">以胡德</char>對他們說：「你們緊跟著我，耶和華已經把你們的仇敵<char style="pn">摩押</char>人交在你們手中了！」他們隨著他下去，占據通往<char style="pn">摩押</char>的<char style="pn">約旦</char>河渡口，不允許一人過去。 <verse eid="JDG 3:28" /><verse number="29" style="v" sid="JDG 3:29" />那時，他們擊殺了大約一萬<char style="pn">摩押</char>人，都是強壯的勇士，沒有一人逃脫。 <verse eid="JDG 3:29" /><verse number="30" style="v" sid="JDG 3:30" />那一天，<char style="pn">摩押</char>被制伏在<char style="pn">以色列</char>手下，於是國中太平了八十年。<verse eid="JDG 3:30" /></para>
  <para style="s">沙姆伽爾</para>
  <para style="p">
    <verse number="31" style="v" sid="JDG 3:31" />
    <char style="pn">以胡德</char>之後，有<char style="pn">亞拿</char>的兒子<char style="pn">沙姆伽爾</char>興起，他用趕牛棒擊殺了六百個<char style="pn">非利士</char>人，他也拯救了<char style="pn">以色列</char>。<verse eid="JDG 3:31" /></para>
  <chapter eid="JDG 3" />
  <chapter number="4" style="c" sid="JDG 4" />
  <para style="s">底波拉和巴拉克</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 4:1" />
    <char style="pn">以胡德</char>死後，<char style="pn">以色列</char>子民又做耶和華眼中看為惡的事。 <verse eid="JDG 4:1" /><verse number="2" style="v" sid="JDG 4:2" />於是耶和華把他們交於<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">交於——原文直譯「賣到」。</char></note><char style="pn">迦南</char>王<char style="pn">耶賓</char>手中；<char style="pn">耶賓</char>在<char style="pn">哈佐</char>作王，他的元帥是<char style="pn">西西拉</char>，住在<char style="pn">哈羅謝-哈格因</char>。 <verse eid="JDG 4:2" /><verse number="3" style="v" sid="JDG 4:3" />那時，<char style="pn">以色列</char>子民呼求耶和華，因為<char style="pn">耶賓</char>有九百輛鐵戰車，他殘暴壓迫<char style="pn">以色列</char>子民二十年。<verse eid="JDG 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 4:4" />那時，女先知<char style="pn">底波拉</char>作<char style="pn">以色列</char>的士師，她是<char style="pn">拉比多</char>的妻子。 <verse eid="JDG 4:4" /><verse number="5" style="v" sid="JDG 4:5" />她常坐在<char style="pn">以法蓮</char>山地<char style="pn">拉瑪</char>和<char style="pn">伯特利</char>之間的<char style="pn">底波拉</char>棕櫚樹下，<char style="pn">以色列</char>子民都上她那裡去尋求判斷。<verse eid="JDG 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 4:6" />
    <char style="pn">底波拉</char>派人從<char style="pn">拿弗他利</char>的<char style="pn">基低斯</char>把<char style="pn">亞比挪安</char>的兒子<char style="pn">巴拉克</char>召來，對他說：「<char style="pn">以色列</char>的神耶和華已經吩咐說：你去，帶領<char style="pn">拿弗他利</char>人和<char style="pn">西布倫</char>人一萬人，前往<char style="pn">他泊</char>山。 <verse eid="JDG 4:6" /><verse number="7" style="v" sid="JDG 4:7" />我會把<char style="pn">耶賓</char>的元帥<char style="pn">西西拉</char>和他的戰車、大軍引領到<char style="pn">基順</char>河，到你那裡；我必把他交在你手中。」<verse eid="JDG 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 4:8" />
    <char style="pn">巴拉克</char>對她說：「如果你與我同去，我就去；如果你不與我同去，我就不去。」<verse eid="JDG 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 4:9" />
    <char style="pn">底波拉</char>說：「我一定與你同去，不過你這次的行程將得不到榮耀，因為耶和華要把<char style="pn">西西拉</char>交於<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">交於——原文直譯「賣到」。</char></note>一個婦女手中。」<char style="pn">底波拉</char>就起來，與<char style="pn">巴拉克</char>一同前往<char style="pn">基低斯</char>。 <verse eid="JDG 4:9" /><verse number="10" style="v" sid="JDG 4:10" /><char style="pn">巴拉克</char>召集<char style="pn">西布倫</char>人和<char style="pn">拿弗他利</char>人到<char style="pn">基低斯</char>，有一萬人跟隨他上去，<char style="pn">底波拉</char>也與他一同上去。<verse eid="JDG 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 4:11" />那時，<char style="pn">基尼</char>人<char style="pn">希伯</char>離開了<char style="pn">摩西</char>內兄<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">內兄——或譯作「岳父」或「姻親」；參《民數記》10:29。</char></note><char style="pn">何巴</char>的子孫<char style="pn">基尼</char>族人，在<char style="pn">基低斯</char>附近的<char style="pn">撒拿音</char>橡樹那裡支搭帳篷。<verse eid="JDG 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 4:12" />有人告訴<char style="pn">西西拉</char>，<char style="pn">亞比挪安</char>的兒子<char style="pn">巴拉克</char>上了<char style="pn">他泊</char>山。 <verse eid="JDG 4:12" /><verse number="13" style="v" sid="JDG 4:13" /><char style="pn">西西拉</char>就召聚他所有的戰車，共九百輛鐵戰車，還有與他一起的所有軍兵，從<char style="pn">哈羅謝-哈格因</char>來到<char style="pn">基順</char>河。 <verse eid="JDG 4:13" /><verse number="14" style="v" sid="JDG 4:14" /><char style="pn">底波拉</char>對<char style="pn">巴拉克</char>說：「起來！今天就是耶和華把<char style="pn">西西拉</char>交在你手中的日子。耶和華不是已經在你前面出戰了嗎？」<char style="pn">巴拉克</char>就和跟隨他的一萬人下了<char style="pn">他泊</char>山。<verse eid="JDG 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 4:15" />耶和華用刀劍使<char style="pn">西西拉</char>和所有的戰車、軍兵在<char style="pn">巴拉克</char>面前潰亂。<char style="pn">西西拉</char>下了戰車，徒步逃走。 <verse eid="JDG 4:15" /><verse number="16" style="v" sid="JDG 4:16" /><char style="pn">巴拉克</char>追趕戰車和軍兵，直到<char style="pn">哈羅謝-哈格因</char>。<char style="pn">西西拉</char>的全軍倒在刀刃之下，一個也沒有剩下。<verse eid="JDG 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 4:17" />
    <char style="pn">西西拉</char>徒步逃走，到了<char style="pn">基尼</char>人<char style="pn">希伯</char>的妻子<char style="pn">雅億</char>的帳篷那裡，因為<char style="pn">哈佐</char>王<char style="pn">耶賓</char>和<char style="pn">基尼</char>人<char style="pn">希伯</char>一家和睦相處。 <verse eid="JDG 4:17" /><verse number="18" style="v" sid="JDG 4:18" /><char style="pn">雅億</char>出去迎接<char style="pn">西西拉</char>，對他說：「請我主過來，到我這裡來，不要害怕。」<char style="pn">西西拉</char>就到她那裡，進了她的帳篷。<char style="pn">雅億</char>用毯子蓋住他。 <verse eid="JDG 4:18" /><verse number="19" style="v" sid="JDG 4:19" /><char style="pn">西西拉</char>對她說：「我口渴了，請給我一點水喝。」<char style="pn">雅億</char>打開皮囊，給他奶喝，又蓋住他。 <verse eid="JDG 4:19" /><verse number="20" style="v" sid="JDG 4:20" /><char style="pn">西西拉</char>對<char style="pn">雅億</char>說：「你站在帳篷入口，如果有人來問你說這裡有没有人，你就說沒有。」 <verse eid="JDG 4:20" /><verse number="21" style="v" sid="JDG 4:21" /><char style="pn">西西拉</char>疲乏了，就沉沉入睡，這時<char style="pn">希伯</char>的妻子<char style="pn">雅億</char>取了一個帳篷橛子，手中拿著鐵錘，悄悄來到<char style="pn">西西拉</char>身旁，把橛子釘進他的鬢角，穿透到地裡。<char style="pn">西西拉</char>就死了。<verse eid="JDG 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 4:22" />這時，<char style="pn">巴拉克</char>追趕<char style="pn">西西拉</char>，<char style="pn">雅億</char>出去迎接他，對他說：「來，我給你看你正在找的人。」<char style="pn">巴拉克</char>進去，看見<char style="pn">西西拉</char>倒在那裡死了，橛子還在他的鬢角裡。<verse eid="JDG 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 4:23" />這一天，神在<char style="pn">以色列</char>子民面前制伏了<char style="pn">迦南</char>王<char style="pn">耶賓</char>。 <verse eid="JDG 4:23" /><verse number="24" style="v" sid="JDG 4:24" /><char style="pn">以色列</char>人的手對<char style="pn">迦南</char>王<char style="pn">耶賓</char>越來越強硬，最終把<char style="pn">迦南</char>王<char style="pn">耶賓</char>剪除了。<verse eid="JDG 4:24" /></para>
  <chapter eid="JDG 4" />
  <chapter number="5" style="c" sid="JDG 5" />
  <para style="s">底波拉的歌</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 5:1" />那一天，<char style="pn">底波拉</char>和<char style="pn">亞比挪安</char>的兒子<char style="pn">巴拉克</char>歌唱說：<verse eid="JDG 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JDG 5:2" />「首領們在<char style="pn">以色列</char>身先士卒，</para>
  <para style="q1" vid="JDG 5:2">子民也甘願奉獻自己；</para>
  <para style="q1" vid="JDG 5:2">你們要頌讚耶和華！<verse eid="JDG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JDG 5:3" />君王啊，你們要聽！</para>
  <para style="q1" vid="JDG 5:3">君主啊，你們要傾聽！</para>
  <para style="q1" vid="JDG 5:3">我要向耶和華歌唱，</para>
  <para style="q1" vid="JDG 5:3">我要歌頌耶和華<char style="pn">以色列</char>的神。<verse eid="JDG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JDG 5:4" />耶和華啊，當你從<char style="pn">西珥</char>出來，</para>
  <para style="q1" vid="JDG 5:4">當你從<char style="pn">以東</char>地前進，</para>
  <para style="q1" vid="JDG 5:4">大地就震動，</para>
  <para style="q1" vid="JDG 5:4">諸天也下沉，</para>
  <para style="q1" vid="JDG 5:4">烏雲也降下雨水。<verse eid="JDG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JDG 5:5" />群山在<char style="pn">西奈</char>山的這一位耶和華面前，</para>
  <para style="q1" vid="JDG 5:5">在<char style="pn">以色列</char>的神耶和華面前震動。<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">此節或譯作：群山在耶和華面前震動，西奈山在以色列的神耶和華面前震動。</char></note><verse eid="JDG 5:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JDG 5:6" />「在<char style="pn">亞拿</char>的兒子<char style="pn">沙姆伽爾</char>的年日，</para>
  <para style="q1" vid="JDG 5:6">在<char style="pn">雅億</char>的日子，</para>
  <para style="q1" vid="JDG 5:6">大道沉寂<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">大道沉寂——或譯作「商隊斷絕」。</char></note>，</para>
  <para style="q1" vid="JDG 5:6">行路的人都繞道而行。<verse eid="JDG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JDG 5:7" />鄉村也沉寂了，</para>
  <para style="q1" vid="JDG 5:7">在<char style="pn">以色列</char>沉寂了，</para>
  <para style="q1" vid="JDG 5:7">直到我<char style="pn">底波拉</char>興起，</para>
  <para style="q1" vid="JDG 5:7">興起作<char style="pn">以色列</char>的母親！<verse eid="JDG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JDG 5:8" />
    <char style="pn">以色列</char>選擇新的神，</para>
  <para style="q1" vid="JDG 5:8">戰爭就臨到城門口；</para>
  <para style="q1" vid="JDG 5:8">
    <char style="pn">以色列</char>四萬人中，</para>
  <para style="q1" vid="JDG 5:8">可否看到一個盾牌、一支長矛？<verse eid="JDG 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JDG 5:9" />我的心敬仰<char style="pn">以色列</char>的領袖們，</para>
  <para style="q1" vid="JDG 5:9">敬仰子民中甘願奉獻自己的人；</para>
  <para style="q1" vid="JDG 5:9">你們要頌讚耶和華！<verse eid="JDG 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JDG 5:10" />騎白驢的，</para>
  <para style="q1" vid="JDG 5:10">坐墊子的，</para>
  <para style="q1" vid="JDG 5:10">行路的，</para>
  <para style="q1" vid="JDG 5:10">你們都要頌揚！<verse eid="JDG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JDG 5:11" />在打水處有分攏羊群之人的聲音，</para>
  <para style="q1" vid="JDG 5:11">他們在那裡述說耶和華的公義，</para>
  <para style="q1" vid="JDG 5:11">述說他在<char style="pn">以色列</char>為鄉村施行的公義。</para>
  <para style="b" vid="JDG 5:11" />
  <para style="q1" vid="JDG 5:11">「那時耶和華的子民下到城門口：<verse eid="JDG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JDG 5:12" />『興起，興起，<char style="pn">底波拉</char>！</para>
  <para style="q1" vid="JDG 5:12">興起，興起，放聲歌唱！</para>
  <para style="q1" vid="JDG 5:12">起來，<char style="pn">亞比挪安</char>的兒子<char style="pn">巴拉克</char>，</para>
  <para style="q1" vid="JDG 5:12">擄掠你的俘虜吧！』<verse eid="JDG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JDG 5:13" />那時貴族中的倖存者下來，</para>
  <para style="q1" vid="JDG 5:13">耶和華的子民也下來，</para>
  <para style="q1" vid="JDG 5:13">為我攻擊那些勇士。<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">此節或譯作：那時倖存者下到貴族那裡，耶和華的子民也下到我這裡作勇士。</char></note><verse eid="JDG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JDG 5:14" />有人從<char style="pn">以法蓮</char>來，</para>
  <para style="q1" vid="JDG 5:14">他們的根在<char style="pn">亞瑪力</char>人之地；</para>
  <para style="q1" vid="JDG 5:14">
    <char style="pn">便雅憫</char>與你的族人一起跟隨你；</para>
  <para style="q1" vid="JDG 5:14">領袖們從<char style="pn">瑪吉</char>下來；</para>
  <para style="q1" vid="JDG 5:14">還有拿著權杖數點軍兵的從<char style="pn">西布倫</char>下來。<verse eid="JDG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JDG 5:15" />
    <char style="pn">以薩迦</char>的首領們與<char style="pn">底波拉</char>在一起；</para>
  <para style="q1" vid="JDG 5:15">
    <char style="pn">巴拉克</char>怎樣，<char style="pn">以薩迦</char>也怎樣，</para>
  <para style="q1" vid="JDG 5:15">他們跟著<char style="pn">巴拉克</char>衝入平原。</para>
  <para style="q1" vid="JDG 5:15">
    <char style="pn">魯本</char>的各支系，在深思熟慮<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">在深思熟慮——或譯作「心有大志」。下節同。</char></note>。<verse eid="JDG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JDG 5:16" />你為什麼還坐在羊圈中，</para>
  <para style="q1" vid="JDG 5:16">聽呼喚羊群的口哨聲呢？</para>
  <para style="q1" vid="JDG 5:16">
    <char style="pn">魯本</char>的各支系，在深思熟慮。<verse eid="JDG 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JDG 5:17" />
    <char style="pn">基列</char>人留在<char style="pn">約旦</char>河對岸。</para>
  <para style="q1" vid="JDG 5:17">
    <char style="pn">但</char>支派為什麼滯留在船上呢？</para>
  <para style="q1" vid="JDG 5:17">
    <char style="pn">亞設</char>坐在海邊，</para>
  <para style="q1" vid="JDG 5:17">留在港口。<verse eid="JDG 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JDG 5:18" />
    <char style="pn">西布倫</char>是捨生忘死的民，</para>
  <para style="q1" vid="JDG 5:18">
    <char style="pn">拿弗他利</char>在田野的高處也是如此。<verse eid="JDG 5:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JDG 5:19" />「眾王前來爭戰；</para>
  <para style="q1" vid="JDG 5:19">那時<char style="pn">迦南</char>的眾王在<char style="pn">米吉多</char>水邊的<char style="pn">特納克</char>爭戰，</para>
  <para style="q1" vid="JDG 5:19">卻得不到一點銀子為戰利品。<verse eid="JDG 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JDG 5:20" />眾星從天上爭戰，</para>
  <para style="q1" vid="JDG 5:20">從它們的軌道上與<char style="pn">西西拉</char>爭戰。<verse eid="JDG 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JDG 5:21" />
    <char style="pn">基順</char>的河流把他們沖走了，</para>
  <para style="q1" vid="JDG 5:21">古老的河流，<char style="pn">基順</char>河！</para>
  <para style="q1" vid="JDG 5:21">我的靈啊，你要奮力前行！<verse eid="JDG 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JDG 5:22" />那時戰馬揚蹄踐踏，</para>
  <para style="q1" vid="JDG 5:22">壯馬疾馳奔騰。<verse eid="JDG 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JDG 5:23" />耶和華的使者說：</para>
  <para style="q1" vid="JDG 5:23">『詛咒<char style="pn">米羅斯</char>，重重詛咒那裡的居民！</para>
  <para style="q1" vid="JDG 5:23">因為他們不來幫助耶和華，</para>
  <para style="q1" vid="JDG 5:23">不來幫助耶和華攻擊那些勇士。』<verse eid="JDG 5:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JDG 5:24" />「<char style="pn">基尼</char>人<char style="pn">希伯</char>的妻子<char style="pn">雅億</char>，</para>
  <para style="q1" vid="JDG 5:24">比眾婦人更有福，</para>
  <para style="q1" vid="JDG 5:24">比帳篷中的婦人更有福！<verse eid="JDG 5:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JDG 5:25" />
    <char style="pn">西西拉</char>要水，<char style="pn">雅億</char>給他奶喝，</para>
  <para style="q1" vid="JDG 5:25">用華貴的碗呈上乳酪。<verse eid="JDG 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JDG 5:26" />
    <char style="pn">雅億</char>左手拿起橛子，</para>
  <para style="q1" vid="JDG 5:26">右手拿起工匠的鐵錘；</para>
  <para style="q1" vid="JDG 5:26">她擊打<char style="pn">西西拉</char>，</para>
  <para style="q1" vid="JDG 5:26">重擊他的頭，</para>
  <para style="q1" vid="JDG 5:26">擊碎、穿透他的鬢角。<verse eid="JDG 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JDG 5:27" />他屈身仆倒，倒在<char style="pn">雅億</char>腳前，</para>
  <para style="q1" vid="JDG 5:27">屈身仆倒在<char style="pn">雅億</char>腳前；</para>
  <para style="q1" vid="JDG 5:27">就在屈身之處，他仆倒死亡。<verse eid="JDG 5:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="JDG 5:28" />「<char style="pn">西西拉</char>的母親從窗戶觀望，</para>
  <para style="q1" vid="JDG 5:28">從窗格那裡長嘆：</para>
  <para style="q1" vid="JDG 5:28">『他的戰車為什麼遲遲不歸呢？</para>
  <para style="q1" vid="JDG 5:28">他馬車的聲音為什麼遲延不來呢？』<verse eid="JDG 5:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JDG 5:29" />她那些智慧的女官回答她，</para>
  <para style="q1" vid="JDG 5:29">她也反覆對自己說：<verse eid="JDG 5:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JDG 5:30" />『他們一定是在</para>
  <para style="q2" vid="JDG 5:30">尋找、分配戰利品吧。</para>
  <para style="q1" vid="JDG 5:30">每人分得一兩個女子；</para>
  <para style="q1" vid="JDG 5:30">
    <char style="pn">西西拉</char>得了彩衣</para>
  <para style="q1" vid="JDG 5:30">——刺繡的彩衣為戰利品，</para>
  <para style="q1" vid="JDG 5:30">他們把雙面刺繡的彩衣</para>
  <para style="q2" vid="JDG 5:30">披在脖子上為戰利品。』<verse eid="JDG 5:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JDG 5:31" />「耶和華啊，</para>
  <para style="q1" vid="JDG 5:31">願你的一切仇敵都這樣滅亡；</para>
  <para style="q1" vid="JDG 5:31">願愛你的人如太陽升起，</para>
  <para style="q1" vid="JDG 5:31">光輝燦爛！」</para>
  <para style="b" vid="JDG 5:31" />
  <para style="p" vid="JDG 5:31">於是國中太平了四十年。<verse eid="JDG 5:31" /></para>
  <chapter eid="JDG 5" />
  <chapter number="6" style="c" sid="JDG 6" />
  <para style="s">米甸人壓迫以色列</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 6:1" />
    <char style="pn">以色列</char>子民又做耶和華眼中看為惡的事，耶和華就把他們交在<char style="pn">米甸</char>人手中七年。 <verse eid="JDG 6:1" /><verse number="2" style="v" sid="JDG 6:2" /><char style="pn">米甸</char>人的手制伏了<char style="pn">以色列</char>人。<char style="pn">以色列</char>子民因<char style="pn">米甸</char>人的緣故，就為自己修築山洞、洞穴和要塞。 <verse eid="JDG 6:2" /><verse number="3" style="v" sid="JDG 6:3" />每當<char style="pn">以色列</char>人撒種後，<char style="pn">米甸</char>人、<char style="pn">亞瑪力</char>人和東方人就上來攻打他們， <verse eid="JDG 6:3" /><verse number="4" style="v" sid="JDG 6:4" />對著他們紮營，毀掉地裡的農作物，直到<char style="pn">加沙</char>，不給<char style="pn">以色列</char>人留下一點口糧以及牛羊或驢。 <verse eid="JDG 6:4" /><verse number="5" style="v" sid="JDG 6:5" />因為他們帶著牲畜和帳篷上來，像大量的蝗蟲湧上來；他們的人和駱駝無法數算。他們進入那地，毀壞它。 <verse eid="JDG 6:5" /><verse number="6" style="v" sid="JDG 6:6" />這樣，<char style="pn">以色列</char>因<char style="pn">米甸</char>人的緣故極其窘迫，<char style="pn">以色列</char>子民就向耶和華哀求。<verse eid="JDG 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 6:7" />
    <char style="pn">以色列</char>子民因<char style="pn">米甸</char>人而向耶和華哀求時， <verse eid="JDG 6:7" /><verse number="8" style="v" sid="JDG 6:8" />耶和華就派遣一位先知到<char style="pn">以色列</char>子民那裡，對他們說：「<char style="pn">以色列</char>的神耶和華如此說：是我把你們從<char style="pn">埃及</char>帶上來，從為奴之家領出來。 <verse eid="JDG 6:8" /><verse number="9" style="v" sid="JDG 6:9" />我解救你們脫離<char style="pn">埃及</char>人的手，脫離一切壓迫你們之人的手，並且把他們從你們面前驅逐出去，把他們的土地賜給了你們。 <verse eid="JDG 6:9" /><verse number="10" style="v" sid="JDG 6:10" />我對你們說：『我是耶和華你們的神，你們不可敬畏<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">敬畏——或譯作「敬拜」。</char></note>你們所住之地<char style="pn">亞摩利</char>人的神明。』你們卻不聽從我的話。」<verse eid="JDG 6:10" /></para>
  <para style="s">耶和華呼召基甸</para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 6:11" />耶和華的使者前來，坐在<char style="pn">俄弗拉</char>的一棵橡樹底下，那是<char style="pn">亞比以謝</char>人<char style="pn">約阿施</char>的橡樹。當時<char style="pn">約阿施</char>的兒子<char style="pn">基甸</char>正在榨酒池裡打小麥，為要躲避<char style="pn">米甸</char>人。 <verse eid="JDG 6:11" /><verse number="12" style="v" sid="JDG 6:12" />耶和華的使者向<char style="pn">基甸</char>顯現，對他說：「大能的勇士啊，耶和華與你同在！」<verse eid="JDG 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 6:13" />
    <char style="pn">基甸</char>對他說：「哦，我主啊，如果耶和華與我們同在，我們為什麼還遭遇這一切呢？我們祖先向我們所講述的他一切奇妙作為在哪裡呢？他們說：『耶和華不是把我們從<char style="pn">埃及</char>帶上來了嗎？』但如今耶和華已經撇棄了我們，把我們交在<char style="pn">米甸</char>人手中了！」<verse eid="JDG 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 6:14" />耶和華轉向<char style="pn">基甸</char>，說：「靠著你這力量去吧，拯救<char style="pn">以色列</char>脫離<char style="pn">米甸</char>人的手。我不是派遣了你嗎？」<verse eid="JDG 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 6:15" />
    <char style="pn">基甸</char>對他說：「哦，我主啊，我憑什麼拯救<char style="pn">以色列</char>呢？看哪，我的宗族在<char style="pn">瑪拿西</char>中是最貧弱的，我在我父家又是最小的。」<verse eid="JDG 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 6:16" />耶和華對他說：「我必與你同在，你將擊敗<char style="pn">米甸</char>，如同擊敗一人。」<verse eid="JDG 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 6:17" />
    <char style="pn">基甸</char>又對他說：「如果我在你眼前蒙恩，求你給我一個徵兆，證明是你在與我說話。 <verse eid="JDG 6:17" /><verse number="18" style="v" sid="JDG 6:18" />請不要離開這裡，等我回來，把供物帶來擺在你面前。」</para>
  <para style="p" vid="JDG 6:18">耶和華說：「我會留在這裡，等你回來。」<verse eid="JDG 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 6:19" />
    <char style="pn">基甸</char>就去預備了一隻小山羊，用一斗<note caller="+" style="f"><char style="fr" closed="false">6:19 </char><char style="ft" closed="false">一斗——原文作「一伊法」。1伊法=22公升。</char></note>麵粉做了無酵餅，把肉放在籃子裡，把湯盛在小鍋裡，帶到橡樹下耶和華的使者那裡獻上。<verse eid="JDG 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 6:20" />神的使者對<char style="pn">基甸</char>說：「把肉和無酵餅拿來，放在這磐石上，把湯倒出來。」他就如此做了。<verse eid="JDG 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JDG 6:21" />耶和華的使者伸出手中的杖，杖頭一碰到肉和無酵餅，就有火從磐石中出來，吞噬了肉和無酵餅。隨後耶和華的使者從他眼前消失了。<verse eid="JDG 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 6:22" />於是，<char style="pn">基甸</char>看出他是耶和華的使者。<char style="pn">基甸</char>說：「唉，主耶和華啊！我竟然面對面看見了耶和華的使者。」<verse eid="JDG 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 6:23" />耶和華對他說：「願你平安！不要害怕，你不會死。」 <verse eid="JDG 6:23" /><verse number="24" style="v" sid="JDG 6:24" />於是<char style="pn">基甸</char>在那裡為耶和華築了一座祭壇，稱它為「耶和華沙龍」。這祭壇至今還在<char style="pn">亞比以謝</char>人的<char style="pn">俄弗拉</char>。<verse eid="JDG 6:24" /></para>
  <para style="s">基甸拆毀巴力祭壇</para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 6:25" />當天夜裡，耶和華對<char style="pn">基甸</char>說：「把你父親的公牛，就是那第二頭七歲的公牛牽來；並且拆毀你父親的<char style="pn">巴力</char>祭壇，砍倒祭壇旁的<char style="pn">亞舍拉</char>柱。 <verse eid="JDG 6:25" /><verse number="26" style="v" sid="JDG 6:26" />然後在這堡壘頂上，為你的神耶和華築一座規整的祭壇，把那第二頭公牛牽來，用你砍倒的<char style="pn">亞舍拉</char>柱作木柴把牠獻為燔祭。」 <verse eid="JDG 6:26" /><verse number="27" style="v" sid="JDG 6:27" /><char style="pn">基甸</char>就從他的僕人中選出十個人，照著耶和華吩咐他的去做。但他因為怕他的父家和那城的人，不敢在白天做，就在夜間做了。<verse eid="JDG 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JDG 6:28" />那城的人清早起來，看哪，<char style="pn">巴力</char>的祭壇被拆毀，旁邊的<char style="pn">亞舍拉</char>柱被砍倒，新築的祭壇上祭獻了那第二頭公牛。 <verse eid="JDG 6:28" /><verse number="29" style="v" sid="JDG 6:29" />他們彼此問：「這是誰做的呢？」他們調查尋問之後，說：「這是<char style="pn">約阿施</char>的兒子<char style="pn">基甸</char>做的。」<verse eid="JDG 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JDG 6:30" />於是那城的人對<char style="pn">約阿施</char>說：「把你兒子交出來！他必須死，因為他拆毀了<char style="pn">巴力</char>的祭壇，砍倒了祭壇旁的<char style="pn">亞舍拉</char>柱。」<verse eid="JDG 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JDG 6:31" />
    <char style="pn">約阿施</char>對所有起來攻擊他的人說：「你們是為<char style="pn">巴力</char>辯護嗎？你們要救助它嗎？誰為它辯護，誰就要在清晨被處死。如果<char style="pn">巴力</char>是神，既然有人拆毀了它的祭壇，就讓它為自己辯護吧！」 <verse eid="JDG 6:31" /><verse number="32" style="v" sid="JDG 6:32" />當天<char style="pn">約阿施</char>稱<char style="pn">基甸</char>為<char style="pn">耶路巴力</char>，意思說「讓<char style="pn">巴力</char>與他相爭」，因為他拆毀了<char style="pn">巴力</char>的祭壇。<verse eid="JDG 6:32" /></para>
  <para style="s">以羊毛為憑據</para>
  <para style="p">
    <verse number="33" style="v" sid="JDG 6:33" />那時，所有的<char style="pn">米甸</char>人、<char style="pn">亞瑪力</char>人和東方人聚集在一起，過了<char style="pn">約旦</char>河，在<char style="pn">耶斯列</char>平原紮營。<verse eid="JDG 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JDG 6:34" />耶和華的靈臨到<char style="pn">基甸</char>身上<note caller="+" style="f"><char style="fr" closed="false">6:34 </char><char style="ft" closed="false">臨到……身上——或譯作「覆蓋」。</char></note>，於是他吹響號角，<char style="pn">亞比以謝</char>人就被召集起來跟隨他。 <verse eid="JDG 6:34" /><verse number="35" style="v" sid="JDG 6:35" />他派遣使者到<char style="pn">瑪拿西</char>全地，<char style="pn">瑪拿西</char>人也被召集起來跟隨他；又派遣使者到<char style="pn">亞設</char>、<char style="pn">西布倫</char>和<char style="pn">拿弗他利</char>，那裡的人也上來與他們會合。<verse eid="JDG 6:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JDG 6:36" />於是<char style="pn">基甸</char>對神說：「如果你要照你所說的，藉著我的手拯救<char style="pn">以色列</char>， <verse eid="JDG 6:36" /><verse number="37" style="v" sid="JDG 6:37" />看哪，我把一團羊毛放在打穀場上，如果唯獨羊毛上有露水，而地上都是乾的，那麼我就知道，你要照你所說的，藉著我的手拯救<char style="pn">以色列</char>了。」 <verse eid="JDG 6:37" /><verse number="38" style="v" sid="JDG 6:38" />事情果然如此，<char style="pn">基甸</char>第二天早早起來，擰那羊毛，竟從羊毛裡擠出露水來，滿滿一碗。<verse eid="JDG 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JDG 6:39" />
    <char style="pn">基甸</char>又對神說：「求你不要對我發怒，容我再說這一次：請讓我用羊毛再試驗一次，這次唯願羊毛是乾的，而地上全是露水。」 <verse eid="JDG 6:39" /><verse number="40" style="v" sid="JDG 6:40" />當天夜裡，神也如此成就了：唯獨羊毛上是乾的，而地上全是露水。<verse eid="JDG 6:40" /></para>
  <chapter eid="JDG 6" />
  <chapter number="7" style="c" sid="JDG 7" />
  <para style="s">篩選基甸的軍兵</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 7:1" />
    <char style="pn">耶路巴力</char>——就是<char style="pn">基甸</char>——與跟隨他的全體軍兵清早起來，在<char style="pn">哈羅德</char>泉<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">哈羅德泉——或譯作「恩哈羅德」。</char></note>旁紮營。<char style="pn">米甸</char>營地在他們北邊，在<char style="pn">摩利</char>山下的平原上。 <verse eid="JDG 7:1" /><verse number="2" style="v" sid="JDG 7:2" />耶和華對<char style="pn">基甸</char>說：「跟隨你的人太多了，我不能把<char style="pn">米甸</char>人交在他們手中，免得<char style="pn">以色列</char>人向我自誇說：『是我們自己的手拯救了我們。』 <verse eid="JDG 7:2" /><verse number="3" style="v" sid="JDG 7:3" />現在，你要向軍兵宣告說：『誰懼怕、戰兢，他就可以回去，盡快離開<char style="pn">基列</char>山。』」於是有兩萬兩千人回去，一萬人留了下來。<verse eid="JDG 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 7:4" />耶和華對<char style="pn">基甸</char>說：「人還是太多了。你帶他們下到水邊，我要在那裡為你試驗他們。我對你說『這人可以與你同去』，他就可以與你同去；但我對你說『這人不可與你同去』，他就不可以去。」 <verse eid="JDG 7:4" /><verse number="5" style="v" sid="JDG 7:5" /><char style="pn">基甸</char>就把軍兵帶到水邊。耶和華對<char style="pn">基甸</char>說：「凡是用舌頭舔水，像狗舔水那樣的，你要把他們安置在一處；凡是雙膝跪下喝的，也要如此。」 <verse eid="JDG 7:5" /><verse number="6" style="v" sid="JDG 7:6" />這樣，用手捧到嘴邊舔水的數目有三百人，其餘的人都是雙膝跪下喝水。 <verse eid="JDG 7:6" /><verse number="7" style="v" sid="JDG 7:7" />耶和華對<char style="pn">基甸</char>說：「我要用這三百個舔水的人拯救你們，把<char style="pn">米甸</char>人交在你手中。其他所有的軍兵，就讓他們各回自己的地方去吧。」 <verse eid="JDG 7:7" /><verse number="8" style="v" sid="JDG 7:8" />於是，這三百人手中接過了軍兵的食物和號角，<char style="pn">基甸</char>打發其他<char style="pn">以色列</char>人各回自己的帳篷，只留下這三百人。<char style="pn">米甸</char>營地在他們下面的平原中。<verse eid="JDG 7:8" /></para>
  <para style="s">基甸探查敵營</para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 7:9" />當天夜裡，耶和華對<char style="pn">基甸</char>說：「起來，下去攻打那營地，因為我已經把它交在你手中了。 <verse eid="JDG 7:9" /><verse number="10" style="v" sid="JDG 7:10" />如果你害怕下去，你就與你的僕人<char style="pn">普拉</char>先下到那營地去， <verse eid="JDG 7:10" /><verse number="11" style="v" sid="JDG 7:11" />聽聽他們說什麼，隨後你就會堅強，可以下去攻打那營地。」於是<char style="pn">基甸</char>和他的僕人<char style="pn">普拉</char>下到那營地駐軍的前哨。<verse eid="JDG 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 7:12" />
    <char style="pn">米甸</char>人、<char style="pn">亞瑪力</char>人和所有的東方人散布在平原上，多如蝗蟲；他們的駱駝多如海邊的沙，無法數算。 <verse eid="JDG 7:12" /><verse number="13" style="v" sid="JDG 7:13" /><char style="pn">基甸</char>到了，正好有一個人在給同伴講述他的夢。他說：「看哪，我做了一個夢，夢見一個大麥餅滾進<char style="pn">米甸</char>營地，到了帳篷這裡，撞倒帳篷，帳篷就翻轉朝上倒塌了。」<verse eid="JDG 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 7:14" />他的同伴回答說：「這不是別的，而是<char style="pn">以色列</char>人<char style="pn">約阿施</char>之子<char style="pn">基甸</char>的刀！神已經把<char style="pn">米甸</char>和全營交在他手中了。」<verse eid="JDG 7:14" /></para>
  <para style="s">基甸攻打米甸人</para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 7:15" />
    <char style="pn">基甸</char>聽見了這夢的講述和解釋，就俯伏下拜，然後回到<char style="pn">以色列</char>營地，說：「起來，耶和華已經把<char style="pn">米甸</char>全營交在你們手中了！」 <verse eid="JDG 7:15" /><verse number="16" style="v" sid="JDG 7:16" /><char style="pn">基甸</char>把三百人分成三隊，把號角和空罐子交在他們每個人手中，罐子裡放進了火把。<verse eid="JDG 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 7:17" />
    <char style="pn">基甸</char>對他們說：「你們看著我，照樣去做。看哪，我到那營地邊上的時候，我怎樣做，你們也怎樣做。 <verse eid="JDG 7:17" /><verse number="18" style="v" sid="JDG 7:18" />當我和所有跟隨我的人吹響號角，你們也要在全營四圍吹響號角，並且呼喊：『為耶和華！為<char style="pn">基甸</char>！』」<verse eid="JDG 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 7:19" />剛到半夜的更次，守衛才換了崗的時候，<char style="pn">基甸</char>和跟隨他的一百人來到那營地邊上，吹響號角，打碎手中的罐子。 <verse eid="JDG 7:19" /><verse number="20" style="v" sid="JDG 7:20" />於是三隊的人都吹響號角，打破罐子，左手握住火把，右手拿著號角吹，並且呼喊：「為耶和華、為<char style="pn">基甸</char>舉刀！」 <verse eid="JDG 7:20" /><verse number="21" style="v" sid="JDG 7:21" />他們在那營地四圍各守其位。全營地的人都亂跑，一邊喊叫，一邊逃跑。 <verse eid="JDG 7:21" /><verse number="22" style="v" sid="JDG 7:22" />當三百人吹響號角時，耶和華使全營地的人彼此刀劍相向。那些軍兵往<char style="pn">西利拉</char>方向逃跑，逃到<char style="pn">伯哈示塔</char>，直到靠近<char style="pn">塔巴</char>的<char style="pn">亞貝勒-米何拉</char>邊緣。 <verse eid="JDG 7:22" /><verse number="23" style="v" sid="JDG 7:23" /><char style="pn">以色列</char>人就從<char style="pn">拿弗他利</char>、<char style="pn">亞設</char>和<char style="pn">瑪拿西</char>全地聚集起來，追擊<char style="pn">米甸</char>人。<verse eid="JDG 7:23" /></para>
  <para style="s">以法蓮人參戰</para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 7:24" />
    <char style="pn">基甸</char>派遣使者走遍全<char style="pn">以法蓮</char>山地，說：「你們下來迎戰<char style="pn">米甸</char>人，在他們之前占據<char style="pn">約旦</char>河的各渡口，直到<char style="pn">伯巴拉</char>。」於是，<char style="pn">以法蓮</char>人都被召集起來，占據<char style="pn">約旦</char>河的各渡口，直到<char style="pn">伯巴拉</char><note caller="+" style="f"><char style="fr" closed="false">7:24 </char><char style="ft" closed="false">占據約旦河的各渡口，直到伯巴拉——或譯作「守住直到伯巴拉的各渡口，守住約旦河」。</char></note>。 <verse eid="JDG 7:24" /><verse number="25" style="v" sid="JDG 7:25" />他們捉住<char style="pn">米甸</char>的兩個首領<char style="pn">俄立</char>和<char style="pn">西伊伯</char>，在<char style="pn">俄立</char>磐石那裡殺了<char style="pn">俄立</char>，在<char style="pn">西伊伯</char>榨酒池那裡殺了<char style="pn">西伊伯</char>。然後他們追趕<char style="pn">米甸</char>人，並把<char style="pn">俄立</char>和<char style="pn">西伊伯</char>的頭顱送到<char style="pn">約旦</char>河對岸<char style="pn">基甸</char>那裡。<verse eid="JDG 7:25" /></para>
  <chapter eid="JDG 7" />
  <chapter number="8" style="c" sid="JDG 8" />
  <para style="nb">
    <verse number="1" style="v" sid="JDG 8:1" />那時，<char style="pn">以法蓮</char>人對<char style="pn">基甸</char>說：「你去攻打<char style="pn">米甸</char>人，竟然不召喚我們！你怎麼這樣對待我們呢？」他們與<char style="pn">基甸</char>激烈地爭論。<verse eid="JDG 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 8:2" />
    <char style="pn">基甸</char>就對他們說：「我現在所做的，怎麼能與你們相比呢？<char style="pn">以法蓮</char>遺落的葡萄，不是比<char style="pn">亞比以謝</char>採收的葡萄更好嗎？ <verse eid="JDG 8:2" /><verse number="3" style="v" sid="JDG 8:3" />神已經把<char style="pn">米甸</char>首領<char style="pn">俄立</char>和<char style="pn">西伊伯</char>交在你們手中了，我能做什麼與你們相比呢？」<char style="pn">基甸</char>說了這話，<char style="pn">以法蓮</char>人的怒氣就平息了。<verse eid="JDG 8:3" /></para>
  <para style="s">基甸追擊米甸二王</para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 8:4" />
    <char style="pn">基甸</char>來到<char style="pn">約旦</char>河，他和跟隨他的三百人過了河，雖然疲乏，仍繼續追趕。 <verse eid="JDG 8:4" /><verse number="5" style="v" sid="JDG 8:5" /><char style="pn">基甸</char>對<char style="pn">疏割</char>人說：「請拿幾塊餅給這些跟隨我的人吃吧，因為他們疲乏了，我正在追趕<char style="pn">米甸</char>王<char style="pn">西巴</char>和<char style="pn">撒慕拿</char>。」<verse eid="JDG 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 8:6" />
    <char style="pn">疏割</char>的首領們回答：「<char style="pn">西巴</char>和<char style="pn">撒慕拿</char>已經在你手中了嗎？居然要我們送餅給你的隊伍！」<verse eid="JDG 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 8:7" />
    <char style="pn">基甸</char>就宣告：「那好！耶和華把<char style="pn">西巴</char>和<char style="pn">撒慕拿</char>交在我手中的時候，我必用曠野的荊棘和蒺藜抽打你們的身體。」 <verse eid="JDG 8:7" /><verse number="8" style="v" sid="JDG 8:8" />然後，<char style="pn">基甸</char>從那裡上到<char style="pn">毗努伊勒</char>，對那裡的人說同樣的話，但<char style="pn">毗努伊勒</char>人回應他像<char style="pn">疏割</char>人的回應一樣。 <verse eid="JDG 8:8" /><verse number="9" style="v" sid="JDG 8:9" /><char style="pn">基甸</char>也向<char style="pn">毗努伊勒</char>人宣告說：「我平安回來的時候，必拆毀這座塔樓。」<verse eid="JDG 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 8:10" />那時<char style="pn">西巴</char>和<char style="pn">撒慕拿</char>在<char style="pn">卡克爾</char>，跟隨他們的軍兵約有一萬五千人，是東方人剩下的全部軍兵，他們已經有十二萬拿刀劍的人倒下了。 <verse eid="JDG 8:10" /><verse number="11" style="v" sid="JDG 8:11" /><char style="pn">基甸</char>從<char style="pn">挪巴</char>和<char style="pn">約比哈</char>東面，沿著住帳篷之人的道路上去，在敵營毫無戒備的時候，攻打那營地。 <verse eid="JDG 8:11" /><verse number="12" style="v" sid="JDG 8:12" /><char style="pn">西巴</char>和<char style="pn">撒慕拿</char>就逃跑。<char style="pn">基甸</char>追趕他們，捉住了<char style="pn">米甸</char>的兩個王<char style="pn">西巴</char>和<char style="pn">撒慕拿</char>，使全軍潰亂。<verse eid="JDG 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 8:13" />
    <char style="pn">約阿施</char>的兒子<char style="pn">基甸</char>沿著<char style="pn">希列斯</char>山坡從戰場回來， <verse eid="JDG 8:13" /><verse number="14" style="v" sid="JDG 8:14" />捉住<char style="pn">疏割</char>的一個年輕人，訊問他。年輕人給他寫下了<char style="pn">疏割</char>的首領和長老的名字，共七十七人。 <verse eid="JDG 8:14" /><verse number="15" style="v" sid="JDG 8:15" />於是，<char style="pn">基甸</char>來到<char style="pn">疏割</char>人那裡，說：「你們曾經羞辱我說：『<char style="pn">西巴</char>和<char style="pn">撒慕拿</char>已經在你手中了嗎？居然要我們送餅給你那些疲乏的人。』看哪，這就是<char style="pn">西巴</char>和<char style="pn">撒慕拿</char>！」 <verse eid="JDG 8:15" /><verse number="16" style="v" sid="JDG 8:16" />於是他捉住那城的長老們，並拿來曠野的荊棘和蒺藜，用它們教訓了<char style="pn">疏割</char>人。 <verse eid="JDG 8:16" /><verse number="17" style="v" sid="JDG 8:17" />他又拆毀了<char style="pn">毗努伊勒</char>的塔樓，殺了城裡的人。<verse eid="JDG 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 8:18" />
    <char style="pn">基甸</char>問<char style="pn">西巴</char>和<char style="pn">撒慕拿</char>：「你們在<char style="pn">他泊</char>山所殺的，是怎樣的人？」他們回答：「都像你，個個都像王子的模樣。」<verse eid="JDG 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 8:19" />
    <char style="pn">基甸</char>說：「他們是我的兄弟，我母親的兒子。我指著耶和華的永生起誓：要是你們讓他們存活，我就不殺你們了。」 <verse eid="JDG 8:19" /><verse number="20" style="v" sid="JDG 8:20" />於是<char style="pn">基甸</char>對長子<char style="pn">耶特爾</char>說：「起來，把他們殺了！」但那年輕人沒有拔出刀來，因為他害怕，他還年輕。<verse eid="JDG 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JDG 8:21" />
    <char style="pn">西巴</char>和<char style="pn">撒慕拿</char>說：「你自己起來殺我們吧，大丈夫才有力量<note caller="+" style="f"><char style="fr" closed="false">8:21 </char><char style="ft" closed="false">大丈夫才有力量——或譯作「人怎樣，力量也怎樣」。</char></note>。」<char style="pn">基甸</char>就起來，殺了<char style="pn">西巴</char>和<char style="pn">撒慕拿</char>，並奪去他們駱駝脖子上的月牙圈。<verse eid="JDG 8:21" /></para>
  <para style="s">基甸後來的事</para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 8:22" />那時，<char style="pn">以色列</char>人對<char style="pn">基甸</char>說：「你既然救我們脫離<char style="pn">米甸</char>人的手，你和你的子子孫孫也管轄我們吧。」<verse eid="JDG 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 8:23" />但<char style="pn">基甸</char>對他們說：「我不管轄你們，我的兒子也不管轄你們；耶和華會管轄你們。」 <verse eid="JDG 8:23" /><verse number="24" style="v" sid="JDG 8:24" /><char style="pn">基甸</char>又對他們說：「我有一件事求你們，請你們各人把奪來的耳環給我一個。」原來敵軍是<char style="pn">以實瑪利</char>人，都戴金耳環。<verse eid="JDG 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 8:25" />他們說：「我們樂意給你。」於是他們鋪開外衣，各人把奪來的耳環扔在上面。 <verse eid="JDG 8:25" /><verse number="26" style="v" sid="JDG 8:26" /><char style="pn">基甸</char>要來的金耳環，其金子的重量是一千七百謝克爾<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">一千七百謝克爾——相當於19.4公斤。1謝克爾=11.4公克。</char></note>；此外，還有<char style="pn">米甸</char>王身上的月牙圈、耳墜和紫色衣服，以及駱駝脖子上的項圈。 <verse eid="JDG 8:26" /><verse number="27" style="v" sid="JDG 8:27" /><char style="pn">基甸</char>用這些製作了一個以弗得，放在本城<char style="pn">俄弗拉</char>。全<char style="pn">以色列</char>都在那裡行淫追隨這以弗得，這成了<char style="pn">基甸</char>和他家的陷阱。<verse eid="JDG 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JDG 8:28" />這樣，<char style="pn">米甸</char>人在<char style="pn">以色列</char>人面前被制伏，再也不能抬頭。在<char style="pn">基甸</char>的年日，國中太平四十年。 <verse eid="JDG 8:28" /><verse number="29" style="v" sid="JDG 8:29" /><char style="pn">約阿施</char>的兒子<char style="pn">耶路巴力</char>回去，住在自己家裡。<verse eid="JDG 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JDG 8:30" />
    <char style="pn">基甸</char>有七十個兒子，都是他親生的，因為他有許多妻子。 <verse eid="JDG 8:30" /><verse number="31" style="v" sid="JDG 8:31" />他在<char style="pn">示劍</char>的妾也為他生了一個兒子，<char style="pn">基甸</char>給這兒子取名為<char style="pn">亞比米勒</char>。 <verse eid="JDG 8:31" /><verse number="32" style="v" sid="JDG 8:32" /><char style="pn">約阿施</char>的兒子<char style="pn">基甸</char>盡享天年而死，葬在<char style="pn">亞比以謝</char>族的<char style="pn">俄弗拉</char>，在他父親<char style="pn">約阿施</char>的墳墓裡。<verse eid="JDG 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JDG 8:33" />
    <char style="pn">基甸</char>死後，<char style="pn">以色列</char>子民又轉去行淫追隨<char style="pn">巴力</char>，奉<char style="pn">巴力比利土</char>為他們的神。 <verse eid="JDG 8:33" /><verse number="34" style="v" sid="JDG 8:34" /><char style="pn">以色列</char>子民不記念耶和華他們的神，就是解救他們脫離四圍一切仇敵之手的那一位； <verse eid="JDG 8:34" /><verse number="35" style="v" sid="JDG 8:35" />也不照著<char style="pn">耶路巴力</char>——<char style="pn">基甸</char>向<char style="pn">以色列</char>所施的一切恩惠，以恩慈對待他的家。<verse eid="JDG 8:35" /></para>
  <chapter eid="JDG 8" />
  <chapter number="9" style="c" sid="JDG 9" />
  <para style="s">亞比米勒作王</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 9:1" />
    <char style="pn">耶路巴力</char>的兒子<char style="pn">亞比米勒</char>到<char style="pn">示劍</char>去見他的舅舅們，與他們和他外祖父的全家商議，說： <verse eid="JDG 9:1" /><verse number="2" style="v" sid="JDG 9:2" />「請問問所有的<char style="pn">示劍</char>人<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="ft" closed="false">示劍人——原文直譯「示劍的主人」；本章下同。</char></note>：『你們覺得哪一樣好：讓<char style="pn">耶路巴力</char>的兒子七十人都管轄你們，還是讓一個人管轄你們？』你們要記得，我是你們的骨肉之親。」<verse eid="JDG 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 9:3" />他的舅舅們把他這些話都說給所有的<char style="pn">示劍</char>人聽，他們的心就傾向<char style="pn">亞比米勒</char>，因為他們想：「<char style="pn">亞比米勒</char>是我們的兄弟。」 <verse eid="JDG 9:3" /><verse number="4" style="v" sid="JDG 9:4" />他們從<char style="pn">巴力比利土</char>的廟宇拿出七十錠銀子給了<char style="pn">亞比米勒</char>，<char style="pn">亞比米勒</char>用這些銀子雇用了一些無賴和流氓，他們就跟隨他。 <verse eid="JDG 9:4" /><verse number="5" style="v" sid="JDG 9:5" />然後他來到<char style="pn">俄弗拉</char>，到他的父家，在一塊磐石上把自己的兄弟，就是<char style="pn">耶路巴力</char>的七十個兒子都殺了，只剩下<char style="pn">耶路巴力</char>最小的兒子<char style="pn">約坦</char>，因為他躲藏了。 <verse eid="JDG 9:5" /><verse number="6" style="v" sid="JDG 9:6" />所有的<char style="pn">示劍</char>人和所有的<char style="pn">伯米羅</char>人聚集起來，到<char style="pn">示劍</char>的橡樹神柱旁，立<char style="pn">亞比米勒</char>為王。<verse eid="JDG 9:6" /></para>
  <para style="s">約坦的寓言</para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 9:7" />有人告訴了<char style="pn">約坦</char>，他就去站在<char style="pn">基利心</char>山頂上，放聲呼喊，對他們說：</para>
  <para style="q1" vid="JDG 9:7">「<char style="pn">示劍</char>的主人哪，你們聽我說，</para>
  <para style="q1" vid="JDG 9:7">願神也垂聽你們！<verse eid="JDG 9:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JDG 9:8" />有一天，樹木們執意要去膏立一個王統治他們。</para>
  <para style="q1" vid="JDG 9:8">他們對橄欖樹說：『你作王統治我們吧。』<verse eid="JDG 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JDG 9:9" />但橄欖樹回答他們：</para>
  <para style="q1" vid="JDG 9:9">『難道我要停止出產那讓神和人得尊榮的油，</para>
  <para style="q1" vid="JDG 9:9">而去飄摇在眾樹之上嗎？』<verse eid="JDG 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JDG 9:10" />樹木們又對無花果樹說：</para>
  <para style="q1" vid="JDG 9:10">『你來作王統治我們吧。』<verse eid="JDG 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JDG 9:11" />但無花果樹回答他們：</para>
  <para style="q1" vid="JDG 9:11">『難道我要停止出產甜美的果實，</para>
  <para style="q1" vid="JDG 9:11">而去飄摇在眾樹之上嗎？』<verse eid="JDG 9:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JDG 9:12" />樹木們又對葡萄樹說：</para>
  <para style="q1" vid="JDG 9:12">『你來作王統治我們吧。』<verse eid="JDG 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JDG 9:13" />但葡萄樹回答他們：</para>
  <para style="q1" vid="JDG 9:13">『難道我要停止出產讓神和人喜樂的新酒，</para>
  <para style="q1" vid="JDG 9:13">而去飄摇在眾樹之上嗎？』<verse eid="JDG 9:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JDG 9:14" />於是所有的樹木對荊棘說：</para>
  <para style="q1" vid="JDG 9:14">『你來作王統治我們吧。』<verse eid="JDG 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JDG 9:15" />荊棘回答樹木們：</para>
  <para style="q1" vid="JDG 9:15">『你們如果真誠地膏立我作王統治你們，</para>
  <para style="q1" vid="JDG 9:15">就來投靠在我的影子下吧！</para>
  <para style="q1" vid="JDG 9:15">否則，就願火從荊棘裡出來，</para>
  <para style="q1" vid="JDG 9:15">吞噬<char style="pn">黎巴嫩</char>的香柏樹。』<verse eid="JDG 9:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="JDG 9:16" />「現在，如果你們立<char style="pn">亞比米勒</char>為王是真誠無偽地行事，如果你們是善待<char style="pn">耶路巴力</char>和他的家，如果你們是照著他應得的對待他—— <verse eid="JDG 9:16" /><verse number="17" style="v" sid="JDG 9:17" />要知道，從前我父親為你們爭戰，捨命不顧，解救你們脫離了<char style="pn">米甸</char>人的手， <verse eid="JDG 9:17" /><verse number="18" style="v" sid="JDG 9:18" />今天你們卻起來攻擊我父親的家，在一塊磐石上殺死了他的七十個兒子，而立他婢女之子<char style="pn">亞比米勒</char>為<char style="pn">示劍</char>人的王，因『他是你們的兄弟』—— <verse eid="JDG 9:18" /><verse number="19" style="v" sid="JDG 9:19" />今天如果你們是真誠無偽地對待<char style="pn">耶路巴力</char>和他的家，你們就因<char style="pn">亞比米勒</char>而歡喜吧，也願他因你們而歡喜。 <verse eid="JDG 9:19" /><verse number="20" style="v" sid="JDG 9:20" />否則，就願火從<char style="pn">亞比米勒</char>發出，吞噬<char style="pn">示劍</char>人和<char style="pn">伯米羅</char>人；也願火從<char style="pn">示劍</char>人和<char style="pn">伯米羅</char>人發出，吞噬<char style="pn">亞比米勒</char>！」 <verse eid="JDG 9:20" /><verse number="21" style="v" sid="JDG 9:21" />隨後<char style="pn">約坦</char>就逃跑，逃到了<char style="pn">比爾</char>，住在那裡，躲避他的兄弟<char style="pn">亞比米勒</char>。<verse eid="JDG 9:21" /></para>
  <para style="s">亞比米勒的報應</para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 9:22" />
    <char style="pn">亞比米勒</char>統管治理<char style="pn">以色列</char>三年。 <verse eid="JDG 9:22" /><verse number="23" style="v" sid="JDG 9:23" />那時，神使攪擾之靈來到<char style="pn">亞比米勒</char>和<char style="pn">示劍</char>人之間，<char style="pn">示劍</char>人就背棄了<char style="pn">亞比米勒</char>。 <verse eid="JDG 9:23" /><verse number="24" style="v" sid="JDG 9:24" />這是為要<char style="pn">耶路巴力</char>七十個兒子被害的報應臨到，使他們的血債歸在那殺害他們的人——他們的兄弟<char style="pn">亞比米勒</char>身上，也歸到那些幫助<char style="pn">亞比米勒</char>去殺害自己兄弟的<char style="pn">示劍</char>人身上。 <verse eid="JDG 9:24" /><verse number="25" style="v" sid="JDG 9:25" /><char style="pn">示劍</char>人在山頂對<char style="pn">亞比米勒</char>設下埋伏，並且搶奪所有從他們那條路經過的人。有人把這事告訴了<char style="pn">亞比米勒</char>。<verse eid="JDG 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JDG 9:26" />那時<char style="pn">伊別德</char>的兒子<char style="pn">迦勒</char>和他的兄弟們前來，路過<char style="pn">示劍</char>，<char style="pn">示劍</char>人都信任他。 <verse eid="JDG 9:26" /><verse number="27" style="v" sid="JDG 9:27" />他們出去到田間，摘取葡萄園的葡萄踹酒，舉行慶典；然後進入他們神明的廟宇吃喝，並且詛咒<char style="pn">亞比米勒</char>。 <verse eid="JDG 9:27" /><verse number="28" style="v" sid="JDG 9:28" /><char style="pn">伊別德</char>的兒子<char style="pn">迦勒</char>說：「<char style="pn">亞比米勒</char>是誰，我們<char style="pn">示劍</char>人竟然要服事他？<char style="pn">亞比米勒</char>不是<char style="pn">耶路巴力</char>的兒子嗎？他的幫手不是<char style="pn">西布勒</char>嗎？你們當服事<char style="pn">示劍</char>之父<char style="pn">哈莫爾</char>的後人！我們為什麼要服事<char style="pn">亞比米勒</char>呢？ <verse eid="JDG 9:28" /><verse number="29" style="v" sid="JDG 9:29" />但願這民歸在我手下，我就除掉<char style="pn">亞比米勒</char>，我要對<char style="pn">亞比米勒</char>說：『增派你的軍隊出來吧！』」<verse eid="JDG 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JDG 9:30" />城主<char style="pn">西布勒</char>聽到<char style="pn">伊別德</char>的兒子<char style="pn">迦勒</char>的話，就發怒， <verse eid="JDG 9:30" /><verse number="31" style="v" sid="JDG 9:31" />暗中派遣使者到<char style="pn">亞比米勒</char>那裡，說：「看哪，<char style="pn">伊別德</char>的兒子<char style="pn">迦勒</char>和他的兄弟們來到了<char style="pn">示劍</char>，他們在煽動那城的人反對你。 <verse eid="JDG 9:31" /><verse number="32" style="v" sid="JDG 9:32" />現在，你和跟隨你的軍兵要在夜間動身，埋伏在田野， <verse eid="JDG 9:32" /><verse number="33" style="v" sid="JDG 9:33" />到清晨太陽升起的時候，你就早早起來衝向那城。看哪，當<char style="pn">迦勒</char>和跟隨他的人出來攻擊你時，你就全力<note caller="+" style="f"><char style="fr" closed="false">9:33 </char><char style="ft" closed="false">全力——原文直譯「照著手上所有的」。</char></note>對付他吧。」 <verse eid="JDG 9:33" /><verse number="34" style="v" sid="JDG 9:34" />於是<char style="pn">亞比米勒</char>和所有跟隨他的軍兵夜間動身，分成四隊，對<char style="pn">示劍</char>設下埋伏。<verse eid="JDG 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JDG 9:35" />當<char style="pn">伊別德</char>的兒子<char style="pn">迦勒</char>出來站在城門口的時候，<char style="pn">亞比米勒</char>和跟隨他的人就從埋伏的地方起來。 <verse eid="JDG 9:35" /><verse number="36" style="v" sid="JDG 9:36" /><char style="pn">迦勒</char>看見那些人，就對<char style="pn">西布勒</char>說：「看哪，有人正從山頂下來！」<char style="pn">西布勒</char>卻對他說：「你把山的影子看成人了。」<verse eid="JDG 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JDG 9:37" />
    <char style="pn">迦勒</char>又再次發話說：「看哪，有人正從山腰<note caller="+" style="f"><char style="fr" closed="false">9:37 </char><char style="ft" closed="false">山腰——或譯作「中心地帶」。</char></note>下來，還有一隊人正從『算命者橡樹』的方向前來。」 <verse eid="JDG 9:37" /><verse number="38" style="v" sid="JDG 9:38" /><char style="pn">西布勒</char>就對他說：「你曾經說過：『<char style="pn">亞比米勒</char>是誰，我們竟然要服事他。』現在你所誇口的在哪裡呢？這不是你所藐視的人嗎？現在請你出去，與他們爭戰吧！」<verse eid="JDG 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JDG 9:39" />於是<char style="pn">迦勒</char>率領<char style="pn">示劍</char>人出去，與<char style="pn">亞比米勒</char>爭戰。 <verse eid="JDG 9:39" /><verse number="40" style="v" sid="JDG 9:40" />結果<char style="pn">亞比米勒</char>追擊<char style="pn">迦勒</char>，<char style="pn">迦勒</char>從他面前逃跑，有許多人受傷仆倒，一直到城門口。 <verse eid="JDG 9:40" /><verse number="41" style="v" sid="JDG 9:41" />之後，<char style="pn">亞比米勒</char>住在<char style="pn">亞魯瑪</char>，<char style="pn">西布勒</char>趕走<char style="pn">迦勒</char>和他的兄弟們，不讓他們住在<char style="pn">示劍</char>。<verse eid="JDG 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JDG 9:42" />第二天，<char style="pn">示劍</char>人出去到田野，有人報告了<char style="pn">亞比米勒</char>。 <verse eid="JDG 9:42" /><verse number="43" style="v" sid="JDG 9:43" />他就帶領軍兵，分成三隊，埋伏在田野。他觀看，看見有人從城裡出來，他就起來擊殺他們。 <verse eid="JDG 9:43" /><verse number="44" style="v" sid="JDG 9:44" /><char style="pn">亞比米勒</char>和跟隨他的一隊人衝上去，守在城門口，另有兩隊人衝向所有在田野中的人，擊殺他們。 <verse eid="JDG 9:44" /><verse number="45" style="v" sid="JDG 9:45" /><char style="pn">亞比米勒</char>一整天攻打那城，攻取了它，殺了城裡的人。他還拆毀那城，並且撒上鹽。<verse eid="JDG 9:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JDG 9:46" />
    <char style="pn">示劍</char>樓所有的人都聽說了，就進入<char style="pn">伊勒比利特</char>廟宇的地下室。 <verse eid="JDG 9:46" /><verse number="47" style="v" sid="JDG 9:47" />有人報告<char style="pn">亞比米勒</char>說，<char style="pn">示劍</char>樓所有的人都聚集在一處， <verse eid="JDG 9:47" /><verse number="48" style="v" sid="JDG 9:48" />於是<char style="pn">亞比米勒</char>和跟隨他的所有軍兵上到<char style="pn">撒門</char>山。<char style="pn">亞比米勒</char>手拿斧頭，砍下一根樹枝，舉起來扛在肩上，然後吩咐跟隨他的軍兵：「你們看我怎麼做，也趕快照樣做！」 <verse eid="JDG 9:48" /><verse number="49" style="v" sid="JDG 9:49" />於是所有軍兵也各自砍下一根樹枝，跟隨<char style="pn">亞比米勒</char>，把樹枝堆在地下室上面，然後放火燒毀地下室。這樣，<char style="pn">示劍</char>樓的人也都死了，男人和女人約有一千人。<verse eid="JDG 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JDG 9:50" />接著<char style="pn">亞比米勒</char>前往<char style="pn">提貝斯</char>，對著<char style="pn">提貝斯</char>紮營，攻取了它。 <verse eid="JDG 9:50" /><verse number="51" style="v" sid="JDG 9:51" />城中有一座堅固的塔樓，那城所有的人，無論男女都逃到那裡，把自己關在裡面，上到塔樓的屋頂。 <verse eid="JDG 9:51" /><verse number="52" style="v" sid="JDG 9:52" /><char style="pn">亞比米勒</char>來到塔樓那裡，攻打它。他接近塔樓門口，要放火燒毀它。 <verse eid="JDG 9:52" /><verse number="53" style="v" sid="JDG 9:53" />這時有一個女人把一塊磨石扔到<char style="pn">亞比米勒</char>頭上，砸破了他的頭顱。 <verse eid="JDG 9:53" /><verse number="54" style="v" sid="JDG 9:54" />他趕快呼喚替他拿兵器的年輕人，對他說：「拔出你的刀來，把我殺了！免得人們論到我說：『一個女人殺了他。』」於是那年輕人把他刺死了。 <verse eid="JDG 9:54" /><verse number="55" style="v" sid="JDG 9:55" /><char style="pn">以色列</char>人看到<char style="pn">亞比米勒</char>死了，就各回自己的地方去了。<verse eid="JDG 9:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="JDG 9:56" />這樣，神報應了<char style="pn">亞比米勒</char>的惡行，就是他對父親作惡，殺了自己的七十個兄弟。 <verse eid="JDG 9:56" /><verse number="57" style="v" sid="JDG 9:57" />神也使<char style="pn">示劍</char>人的一切惡行報應到他們自己頭上，<char style="pn">耶路巴力</char>的兒子<char style="pn">約坦</char>的詛咒臨到了他們身上。<verse eid="JDG 9:57" /></para>
  <chapter eid="JDG 9" />
  <chapter number="10" style="c" sid="JDG 10" />
  <para style="s">陀拉和睚珥</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 10:1" />
    <char style="pn">亞比米勒</char>之後，<char style="pn">陀拉</char>興起，拯救<char style="pn">以色列</char>。他是<char style="pn">朵多</char>的孫子、<char style="pn">普瓦</char>的兒子，是<char style="pn">以薩迦</char>人，住在<char style="pn">以法蓮</char>山地的<char style="pn">沙米爾</char>。 <verse eid="JDG 10:1" /><verse number="2" style="v" sid="JDG 10:2" /><char style="pn">陀拉</char>作<char style="pn">以色列</char>的士師二十三年。<char style="pn">陀拉</char>死了，葬在<char style="pn">沙米爾</char>。<verse eid="JDG 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 10:3" />在他之後，有<char style="pn">基列</char>人<char style="pn">睚珥</char>興起，作<char style="pn">以色列</char>的士師二十二年。 <verse eid="JDG 10:3" /><verse number="4" style="v" sid="JDG 10:4" /><char style="pn">睚珥</char>有三十個兒子，騎著三十頭驢。他們有三十座城，被稱為<char style="pn">睚珥</char>鎮，直到今日；這些城都在<char style="pn">基列</char>地。 <verse eid="JDG 10:4" /><verse number="5" style="v" sid="JDG 10:5" /><char style="pn">睚珥</char>死了，葬在<char style="pn">加捫</char>。<verse eid="JDG 10:5" /></para>
  <para style="s">以色列的背叛與回轉</para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 10:6" />
    <char style="pn">以色列</char>子民又做耶和華眼中看為惡的事，服事眾<char style="pn">巴力</char>和<char style="pn">亞斯她錄</char>，以及<char style="pn">亞蘭</char>的神明、<char style="pn">西頓</char>的神明、<char style="pn">摩押</char>的神明、<char style="pn">亞捫</char>人的神明、<char style="pn">非利士</char>人的神明。他們離棄耶和華，不服事他。 <verse eid="JDG 10:6" /><verse number="7" style="v" sid="JDG 10:7" />於是耶和華對<char style="pn">以色列</char>發怒，把他們交於<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">交於——原文直譯「賣到」。</char></note><char style="pn">非利士</char>人和<char style="pn">亞捫</char>人手中。 <verse eid="JDG 10:7" /><verse number="8" style="v" sid="JDG 10:8" />那一年他們摧殘、壓迫<char style="pn">以色列</char>人，就是<char style="pn">約旦</char>河對岸<char style="pn">亞摩利</char>人之地、<char style="pn">基列</char>地的所有<char style="pn">以色列</char>人；這樣有十八年。 <verse eid="JDG 10:8" /><verse number="9" style="v" sid="JDG 10:9" /><char style="pn">亞捫</char>人還過<char style="pn">約旦</char>河，去與<char style="pn">猶大</char>、<char style="pn">便雅憫</char>和<char style="pn">以法蓮</char>家爭戰。<char style="pn">以色列</char>陷入極大的危難， <verse eid="JDG 10:9" /><verse number="10" style="v" sid="JDG 10:10" /><char style="pn">以色列</char>子孫就向耶和華哀求，說：「我們對你犯了罪！我們實在離棄了我們的神，去服事眾<char style="pn">巴力</char>。」<verse eid="JDG 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 10:11" />耶和華對<char style="pn">以色列</char>子民說：「從前<char style="pn">埃及</char>人、<char style="pn">亞摩利</char>人、<char style="pn">亞捫</char>人、<char style="pn">非利士</char>人、 <verse eid="JDG 10:11" /><verse number="12" style="v" sid="JDG 10:12" /><char style="pn">西頓</char>人、<char style="pn">亞瑪力</char>人、<char style="pn">瑪雲</char>人壓迫你們，那時你們向我呼求，難道我沒有拯救你們脫離他們的手嗎？ <verse eid="JDG 10:12" /><verse number="13" style="v" sid="JDG 10:13" />現在，你們卻離棄我，服事別的神！因此，我不再拯救你們了。 <verse eid="JDG 10:13" /><verse number="14" style="v" sid="JDG 10:14" />去向你們所選擇的神明哀求吧，在你們遭難時，讓他們拯救你們！」<verse eid="JDG 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 10:15" />
    <char style="pn">以色列</char>子民對耶和華說：「我們犯罪了！你看怎樣好就怎樣處置我們吧，只求你今天解救我們。」 <verse eid="JDG 10:15" /><verse number="16" style="v" sid="JDG 10:16" />於是<char style="pn">以色列</char>人除掉他們當中的外邦神明，服事耶和華，耶和華就因<char style="pn">以色列</char>的苦難而心中不忍。<verse eid="JDG 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 10:17" />那時<char style="pn">亞捫</char>人聚集起來，在<char style="pn">基列</char>紮營。<char style="pn">以色列</char>人也聚集起來，在<char style="pn">米斯巴</char>紮營。 <verse eid="JDG 10:17" /><verse number="18" style="v" sid="JDG 10:18" /><char style="pn">基列</char>的民眾和首領們，彼此說：「誰先開始與<char style="pn">亞捫</char>人爭戰，誰就作<char style="pn">基列</char>所有居民的領袖。」<verse eid="JDG 10:18" /></para>
  <chapter eid="JDG 10" />
  <chapter number="11" style="c" sid="JDG 11" />
  <para style="s">耶弗塔成為以色列的領袖</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 11:1" />
    <char style="pn">基列</char>人<char style="pn">耶弗塔</char>是個英勇的戰士，是一個妓女的兒子，<char style="pn">基列</char>與這妓女生了<char style="pn">耶弗塔</char>。 <verse eid="JDG 11:1" /><verse number="2" style="v" sid="JDG 11:2" /><char style="pn">基列</char>的妻子也給<char style="pn">基列</char>生了兒子，這些兒子們長大了，就趕走<char style="pn">耶弗塔</char>，說：「你不可在我們父親的家繼承產業，因為你是外女的兒子。」 <verse eid="JDG 11:2" /><verse number="3" style="v" sid="JDG 11:3" />於是，<char style="pn">耶弗塔</char>從他的兄弟們面前逃走，住在<char style="pn">陀伯</char>地。有一些無賴聚集到<char style="pn">耶弗塔</char>那裡，與他一同出入。<verse eid="JDG 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 11:4" />過了一些日子，<char style="pn">亞捫</char>人與<char style="pn">以色列</char>爭戰。 <verse eid="JDG 11:4" /><verse number="5" style="v" sid="JDG 11:5" />當<char style="pn">亞捫</char>人與<char style="pn">以色列</char>爭戰的時候，<char style="pn">基列</char>的長老們去請<char style="pn">耶弗塔</char>從<char style="pn">陀伯</char>地回來。 <verse eid="JDG 11:5" /><verse number="6" style="v" sid="JDG 11:6" />他們對<char style="pn">耶弗塔</char>說：「你來作我們的統帥吧，我們好與<char style="pn">亞捫</char>人爭戰。」<verse eid="JDG 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 11:7" />
    <char style="pn">耶弗塔</char>回答<char style="pn">基列</char>的長老們：「你們不是恨我嗎？你們把我從我父家趕走了，為什麼現在危難臨到你們，就來找我呢？」<verse eid="JDG 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 11:8" />
    <char style="pn">基列</char>的長老們對<char style="pn">耶弗塔</char>說：「我們現在回來找你，就是要你與我們同去，與<char style="pn">亞捫</char>人爭戰，你可以作我們<char style="pn">基列</char>所有居民的領袖。」<verse eid="JDG 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 11:9" />
    <char style="pn">耶弗塔</char>對<char style="pn">基列</char>的長老們說：「如果你們請我回去攻打<char style="pn">亞捫</char>人，而耶和華把他們交給我，那我就作你們的領袖。」<verse eid="JDG 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 11:10" />
    <char style="pn">基列</char>的長老們回答<char style="pn">耶弗塔</char>：「有耶和華在我們之間作證：我們一定照著你的話這樣做。」 <verse eid="JDG 11:10" /><verse number="11" style="v" sid="JDG 11:11" />於是<char style="pn">耶弗塔</char>與<char style="pn">基列</char>的長老們同去，民眾就立<char style="pn">耶弗塔</char>為他們的領袖和統帥。<char style="pn">耶弗塔</char>在<char style="pn">米斯巴</char>將他那些話全都在耶和華面前述說了。<verse eid="JDG 11:11" /></para>
  <para style="s">耶弗塔駁斥亞捫人</para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 11:12" />
    <char style="pn">耶弗塔</char>派遣使者去見<char style="pn">亞捫</char>人的王，說：「我與你有什麼相干，你竟然來我這裡，侵犯我的國土呢？」<verse eid="JDG 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 11:13" />
    <char style="pn">亞捫</char>人的王回答<char style="pn">耶弗塔</char>的使者們：「因為<char style="pn">以色列</char>從<char style="pn">埃及</char>上來的時候，奪取了我的土地，從<char style="pn">亞嫩</char>河直到<char style="pn">雅博</char>河、<char style="pn">約旦</char>河。所以現在，你要和平歸還這些土地。」<verse eid="JDG 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 11:14" />
    <char style="pn">耶弗塔</char>再次派遣使者去見<char style="pn">亞捫</char>人的王， <verse eid="JDG 11:14" /><verse number="15" style="v" sid="JDG 11:15" />對他說：「<char style="pn">耶弗塔</char>如此說：<char style="pn">以色列</char>並沒有奪取<char style="pn">摩押</char>地或<char style="pn">亞捫</char>人之地。 <verse eid="JDG 11:15" /><verse number="16" style="v" sid="JDG 11:16" />因為<char style="pn">以色列</char>從<char style="pn">埃及</char>上來的時候，走過曠野到<char style="pn">紅海</char>，然後來到<char style="pn">加低斯</char>， <verse eid="JDG 11:16" /><verse number="17" style="v" sid="JDG 11:17" /><char style="pn">以色列</char>派遣使者去見<char style="pn">以東</char>王，說：『請讓我們從你境內經過。』但<char style="pn">以東</char>王不聽。他們又派人去見<char style="pn">摩押</char>王，<char style="pn">摩押</char>王也不答應。於是<char style="pn">以色列</char>就留在<char style="pn">加低斯</char>。<verse eid="JDG 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 11:18" />「後來他們經過曠野，繞過<char style="pn">以東</char>地和<char style="pn">摩押</char>地，來到<char style="pn">摩押</char>地的東邊，在<char style="pn">亞嫩</char>河對岸紮營。他們並沒有進入<char style="pn">摩押</char>境內，因為<char style="pn">亞嫩</char>河是<char style="pn">摩押</char>的邊界。<verse eid="JDG 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 11:19" />「<char style="pn">以色列</char>又派遣使者去見<char style="pn">亞摩利</char>王，就是<char style="pn">希實本</char>王<char style="pn">西宏</char>，<char style="pn">以色列</char>對他說：『請讓我們從你境內經過，到我們的地方去。』 <verse eid="JDG 11:19" /><verse number="20" style="v" sid="JDG 11:20" />但<char style="pn">西宏</char>不信任<char style="pn">以色列</char>，不讓他們從他境內經過。<char style="pn">西宏</char>還招聚他的全軍，在<char style="pn">雅哈茲</char>紮營，與<char style="pn">以色列</char>作戰。 <verse eid="JDG 11:20" /><verse number="21" style="v" sid="JDG 11:21" /><char style="pn">以色列</char>的神耶和華把<char style="pn">西宏</char>和他的全軍交在<char style="pn">以色列</char>手中，<char style="pn">以色列</char>擊敗他們，占有了那地居民<char style="pn">亞摩利</char>人的全地。 <verse eid="JDG 11:21" /><verse number="22" style="v" sid="JDG 11:22" />這樣，他們占有了<char style="pn">亞摩利</char>人的全境，從<char style="pn">亞嫩</char>河直到<char style="pn">雅博</char>河，從曠野直到<char style="pn">約旦</char>河。<verse eid="JDG 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 11:23" />「現在，<char style="pn">以色列</char>的神耶和華已經把<char style="pn">亞摩利</char>人從他子民<char style="pn">以色列</char>面前趕出去了，你竟然要占有這地<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">竟然要占有這地——或譯作「卻要趕出以色列」。</char></note>嗎？ <verse eid="JDG 11:23" /><verse number="24" style="v" sid="JDG 11:24" />你不是占有了你的神<char style="pn">基抹</char>讓你占有的土地嗎？我們也占有我們的神耶和華讓我們占有的<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="ft" closed="false">讓我們占有的——或譯作「從我們面前趕出之人的」。</char></note>一切。 <verse eid="JDG 11:24" /><verse number="25" style="v" sid="JDG 11:25" />現在，難道你比<char style="pn">西撥</char>的兒子<char style="pn">摩押</char>王<char style="pn">巴勒</char>還強嗎？難道他與<char style="pn">以色列</char>爭論過，或者與他們爭戰過嗎？ <verse eid="JDG 11:25" /><verse number="26" style="v" sid="JDG 11:26" /><char style="pn">以色列</char>住在<char style="pn">希實本</char>和附屬的村鎮，<char style="pn">亞羅珥</char>和附屬的村鎮，以及<char style="pn">亞嫩</char>河沿岸所有的城鎮，已經三百年了，那時候你們為什麼不收回呢？ <verse eid="JDG 11:26" /><verse number="27" style="v" sid="JDG 11:27" />我並沒有得罪你，你卻侵犯我，要與我爭戰。願審判者耶和華今天在<char style="pn">以色列</char>人和<char style="pn">亞捫</char>人之間施行審判！」 <verse eid="JDG 11:27" /><verse number="28" style="v" sid="JDG 11:28" />但<char style="pn">亞捫</char>人的王不聽<char style="pn">耶弗塔</char>向他傳達的話。<verse eid="JDG 11:28" /></para>
  <para style="s">耶弗塔的誓言與燔祭</para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 11:29" />於是耶和華的靈臨到<char style="pn">耶弗塔</char>身上，他就穿過<char style="pn">基列</char>和<char style="pn">瑪拿西</char>，又穿過<char style="pn">基列</char>的<char style="pn">米斯巴</char>，然後從<char style="pn">基列</char>的<char style="pn">米斯巴</char>過去，到<char style="pn">亞捫</char>人那裡。 <verse eid="JDG 11:29" /><verse number="30" style="v" sid="JDG 11:30" /><char style="pn">耶弗塔</char>向耶和華許了一個願，說：「如果你確實把<char style="pn">亞捫</char>人交在我手中， <verse eid="JDG 11:30" /><verse number="31" style="v" sid="JDG 11:31" />當我從<char style="pn">亞捫</char>人那裡平安回來時，誰先從我家門出來迎接我，誰就歸給耶和華，我必把他獻上作為燔祭。」<verse eid="JDG 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JDG 11:32" />於是<char style="pn">耶弗塔</char>過去，到<char style="pn">亞捫</char>人那裡與他們交戰，耶和華就把<char style="pn">亞捫</char>人交在他手中。 <verse eid="JDG 11:32" /><verse number="33" style="v" sid="JDG 11:33" />他擊殺他們，從<char style="pn">亞羅珥</char>到<char style="pn">米尼特</char>隘口二十座城，直到<char style="pn">亞貝勒-基拉明</char>，那是一場極大的殺戮。這樣，<char style="pn">亞捫</char>人在<char style="pn">以色列</char>子民面前被制伏了。<verse eid="JDG 11:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JDG 11:34" />
    <char style="pn">耶弗塔</char>回到<char style="pn">米斯巴</char>自己的家，看哪，他的女兒拿著鈴鼓跳舞出來迎接他；<char style="pn">耶弗塔</char>只有這個獨生女，沒有別的兒女。 <verse eid="JDG 11:34" /><verse number="35" style="v" sid="JDG 11:35" /><char style="pn">耶弗塔</char>看見女兒，就撕裂衣服，說：「唉，我的女兒啊！你讓我愁苦至極，你給我帶來了困擾。我已經向耶和華開了口，不能收回啊！」<verse eid="JDG 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JDG 11:36" />他女兒對他說：「父親啊，你已經向耶和華開了口，耶和華已經在你仇敵<char style="pn">亞捫</char>人身上為你報仇，你就照著你說出的話對待我吧。」 <verse eid="JDG 11:36" /><verse number="37" style="v" sid="JDG 11:37" />她又對父親說：「願你准許我這件事：請寬限我兩個月，讓我與我的女伴們到山裡去，為我終身不嫁而哀哭。」<verse eid="JDG 11:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JDG 11:38" />
    <char style="pn">耶弗塔</char>說：「你去吧」，就讓她離開兩個月。她與她的女伴們到山裡，為她終身不嫁而哀哭。 <verse eid="JDG 11:38" /><verse number="39" style="v" sid="JDG 11:39" />過了兩個月，她回到父親那裡，父親照著所許的願對待她，她就終身沒有親近男人。於是在<char style="pn">以色列</char>有一個習俗： <verse eid="JDG 11:39" /><verse number="40" style="v" sid="JDG 11:40" /><char style="pn">以色列</char>的女子每年都會去紀念<char style="pn">基列</char>人<char style="pn">耶弗塔</char>的女兒，每年有四天。<verse eid="JDG 11:40" /></para>
  <chapter eid="JDG 11" />
  <chapter number="12" style="c" sid="JDG 12" />
  <para style="s">以法蓮人與耶弗塔爭戰</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 12:1" />
    <char style="pn">以法蓮</char>人聚集起來，過河到<char style="pn">撒芬</char><note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">撒芬——或譯作「北方」。</char></note>，對<char style="pn">耶弗塔</char>說：「你過去與<char style="pn">亞捫</char>人爭戰，為什麼不叫我們同去呢？我們要放火把你的房屋與你一起燒掉！」<verse eid="JDG 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 12:2" />
    <char style="pn">耶弗塔</char>對他們說：「我和我的族人與<char style="pn">亞捫</char>人起了極大的爭鬥，我向你們呼求，你們卻不救我脫離他們的手。 <verse eid="JDG 12:2" /><verse number="3" style="v" sid="JDG 12:3" />我見你們不救我，就冒著生命危險過去攻打<char style="pn">亞捫</char>人，耶和華把他們交在我手中了。今天，你們為什麼上我這裡來，與我爭戰呢？」<verse eid="JDG 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 12:4" />
    <char style="pn">耶弗塔</char>招聚所有<char style="pn">基列</char>人，與<char style="pn">以法蓮</char>人交戰。<char style="pn">基列</char>人擊殺<char style="pn">以法蓮</char>人，因為<char style="pn">以法蓮</char>人說：「<char style="pn">基列</char>人哪，你們在<char style="pn">以法蓮</char>和<char style="pn">瑪拿西</char>中間，不過是<char style="pn">以法蓮</char>的逃亡者！」 <verse eid="JDG 12:4" /><verse number="5" style="v" sid="JDG 12:5" /><char style="pn">基列</char>人占領通往<char style="pn">以法蓮</char>的<char style="pn">約旦</char>河渡口。當<char style="pn">以法蓮</char>逃脫的人說「讓我過去」，<char style="pn">基列</char>人就問他：「你是<char style="pn">以法蓮</char>人嗎？」如果他說「不是」， <verse eid="JDG 12:5" /><verse number="6" style="v" sid="JDG 12:6" />他們就對他說：「請說『示伯列』。」如果他發音不準，而說成「斯伯列」，<char style="pn">基列</char>人就抓住他，在<char style="pn">約旦</char>河渡口把他殺了。那時，<char style="pn">以法蓮</char>人中有四萬兩千人倒斃了。<verse eid="JDG 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 12:7" />
    <char style="pn">耶弗塔</char>作<char style="pn">以色列</char>的士師六年。<char style="pn">基列</char>人<char style="pn">耶弗塔</char>死了，葬在<char style="pn">基列</char>的城中。<verse eid="JDG 12:7" /></para>
  <para style="s">伊比贊、埃隆、阿布頓</para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 12:8" />
    <char style="pn">耶弗塔</char>之後，<char style="pn">伯利恆</char>人<char style="pn">伊比贊</char>作<char style="pn">以色列</char>的士師。 <verse eid="JDG 12:8" /><verse number="9" style="v" sid="JDG 12:9" />他有三十個兒子、三十個女兒，他把女兒都嫁到本族外去，又從本族外為自己的兒子娶來三十個女子。<char style="pn">伊比贊</char>作<char style="pn">以色列</char>的士師七年。 <verse eid="JDG 12:9" /><verse number="10" style="v" sid="JDG 12:10" /><char style="pn">伊比贊</char>死了，葬在<char style="pn">伯利恆</char>。<verse eid="JDG 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 12:11" />
    <char style="pn">伊比贊</char>之後，<char style="pn">西布倫</char>人<char style="pn">埃隆</char>作<char style="pn">以色列</char>的士師。他作<char style="pn">以色列</char>的士師十年。 <verse eid="JDG 12:11" /><verse number="12" style="v" sid="JDG 12:12" /><char style="pn">西布倫</char>人<char style="pn">埃隆</char>死了，葬在<char style="pn">西布倫</char>地的<char style="pn">阿雅崙</char>。<verse eid="JDG 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 12:13" />
    <char style="pn">埃隆</char>之後，<char style="pn">比拉頓</char>人<char style="pn">希列</char>的兒子<char style="pn">阿布頓</char>作<char style="pn">以色列</char>的士師。 <verse eid="JDG 12:13" /><verse number="14" style="v" sid="JDG 12:14" />他有四十個兒子、三十個孫子，他們騎著七十頭驢。<char style="pn">阿布頓</char>作<char style="pn">以色列</char>的士師八年。 <verse eid="JDG 12:14" /><verse number="15" style="v" sid="JDG 12:15" /><char style="pn">比拉頓</char>人<char style="pn">希列</char>的兒子<char style="pn">阿布頓</char>死了，葬在<char style="pn">以法蓮</char>地的<char style="pn">比拉頓</char>，就在<char style="pn">亞瑪力</char>人的山地。<verse eid="JDG 12:15" /></para>
  <chapter eid="JDG 12" />
  <chapter number="13" style="c" sid="JDG 13" />
  <para style="s">叁孫的出生</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 13:1" />
    <char style="pn">以色列</char>子民又做耶和華眼中看為惡的事，耶和華就把他們交在<char style="pn">非利士</char>人手中四十年。 <verse eid="JDG 13:1" /><verse number="2" style="v" sid="JDG 13:2" />有一個<char style="pn">但</char>家族的<char style="pn">佐拉</char>人，名叫<char style="pn">瑪挪亞</char>，他妻子不能生育，沒有孩子。 <verse eid="JDG 13:2" /><verse number="3" style="v" sid="JDG 13:3" />耶和華的使者向那婦人顯現，對她說：「看哪，你向來不能生育、沒有孩子，現在你必懷孕，生一個兒子。 <verse eid="JDG 13:3" /><verse number="4" style="v" sid="JDG 13:4" />因此你要謹慎，淡酒烈酒都不可喝，任何不潔淨的食物也不可吃。 <verse eid="JDG 13:4" /><verse number="5" style="v" sid="JDG 13:5" />看哪，你必懷孕，生一個兒子。絕不可在他頭上用剃刀，因為這孩子從母腹中就要歸於神作<char style="pn">拿細耳</char>人<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">拿細耳人——意思是「分別出來的人」；本章下同。</char></note>。他將起來拯救<char style="pn">以色列</char>脫離<char style="pn">非利士</char>人的手。」<verse eid="JDG 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 13:6" />那婦人就回去，告訴丈夫說：「有一位神人到我這裡來了，他的容貌好像神使者的容貌，極其可畏。我沒有問他從哪裡來，他也沒有把他的名告訴我。 <verse eid="JDG 13:6" /><verse number="7" style="v" sid="JDG 13:7" />他對我說：『看哪，你必懷孕，生一個兒子。所以，淡酒烈酒你都不可喝，任何不潔淨的食物也不可吃，因為這孩子從母腹中直到死的那天，都要歸於神作<char style="pn">拿細耳</char>人。』」<verse eid="JDG 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 13:8" />
    <char style="pn">瑪挪亞</char>向耶和華祈求，說：「哦，主啊，請讓你所派遣的神人再到我們這裡來，指示我們對這將要出生的孩子該怎樣做。」<verse eid="JDG 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 13:9" />神垂聽了<char style="pn">瑪挪亞</char>的話。於是神的使者再次來到婦人那裡，當時她正坐在田間，她丈夫<char style="pn">瑪挪亞</char>沒有與她在一起。 <verse eid="JDG 13:9" /><verse number="10" style="v" sid="JDG 13:10" />那婦人趕快跑去告訴丈夫，說：「看哪，那天到我這裡來的人又向我顯現了。」<verse eid="JDG 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 13:11" />
    <char style="pn">瑪挪亞</char>就起身，跟著妻子去了。他來到那人面前，問他：「對這婦人說話的人就是你嗎？」</para>
  <para style="p" vid="JDG 13:11">他說：「是我。」<verse eid="JDG 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 13:12" />
    <char style="pn">瑪挪亞</char>說：「現在，願你的話應驗！關於這孩子和他的工作，有什麼規定呢？」<verse eid="JDG 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 13:13" />耶和華的使者對<char style="pn">瑪挪亞</char>說：「我對這婦人所說的一切，她都要遵守。 <verse eid="JDG 13:13" /><verse number="14" style="v" sid="JDG 13:14" />葡萄樹所出產的一切，她都不可吃；淡酒烈酒她都不可喝；各樣不潔淨的食物，她都不可吃。我所吩咐她的一切，她都要遵守。」<verse eid="JDG 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 13:15" />
    <char style="pn">瑪挪亞</char>對耶和華的使者說：「請容我們挽留你，為你預備一隻小山羊。」<verse eid="JDG 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 13:16" />但耶和華的使者對<char style="pn">瑪挪亞</char>說：「你就算挽留我，我也不會吃你的食物。你如果要預備燔祭，就把它獻給耶和華吧。」原來<char style="pn">瑪挪亞</char>不知道那人是耶和華的使者。<verse eid="JDG 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 13:17" />
    <char style="pn">瑪挪亞</char>對耶和華的使者說：「你的名怎麼稱呼？到你的話應驗時，我們好尊崇你。」<verse eid="JDG 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 13:18" />耶和華的使者回答他：「你何必問我的名呢？我的名是奇妙的。」<verse eid="JDG 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 13:19" />
    <char style="pn">瑪挪亞</char>取來一隻小山羊和一些素祭，在磐石上獻給耶和華。於是發生了一件奇妙的事，<char style="pn">瑪挪亞</char>和他的妻子一直看著， <verse eid="JDG 13:19" /><verse number="20" style="v" sid="JDG 13:20" />當火焰從祭壇升上天的時候，耶和華的使者也隨著祭壇的火焰升上去了。<char style="pn">瑪挪亞</char>和他的妻子看見，就臉伏於地。 <verse eid="JDG 13:20" /><verse number="21" style="v" sid="JDG 13:21" />耶和華的使者再也沒有向<char style="pn">瑪挪亞</char>和他的妻子顯現了。這時，<char style="pn">瑪挪亞</char>才知道那人是耶和華的使者。<verse eid="JDG 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 13:22" />
    <char style="pn">瑪挪亞</char>就對他的妻子說：「我們必定死，因為我們看見了神。」<verse eid="JDG 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 13:23" />但他的妻子對他說：「耶和華如果想殺我們，就不會從我們手中接受燔祭和素祭了，也不會向我們顯示這一切，不會在這個時候告知我們這些事。」<verse eid="JDG 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 13:24" />後來那婦人生了一個兒子，給他起名為<char style="pn">叄孫</char>。孩子漸漸長大，耶和華祝福了他。 <verse eid="JDG 13:24" /><verse number="25" style="v" sid="JDG 13:25" />在<char style="pn">佐拉</char>和<char style="pn">以實陶</char>之間的<char style="pn">瑪哈尼但</char>，耶和華的靈開始催動<char style="pn">叄孫</char>。<verse eid="JDG 13:25" /></para>
  <chapter eid="JDG 13" />
  <chapter number="14" style="c" sid="JDG 14" />
  <para style="s">叁孫的謎語</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 14:1" />
    <char style="pn">叄孫</char>下到<char style="pn">亭拿</char>，在那裡見到一個女子，是<char style="pn">非利士</char>人的女兒。 <verse eid="JDG 14:1" /><verse number="2" style="v" sid="JDG 14:2" /><char style="pn">叄孫</char>回去告訴父母，說：「我在<char style="pn">亭拿</char>見到一個女子，是<char style="pn">非利士</char>人的女兒，現在請你們把她給我娶來為妻。」<verse eid="JDG 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 14:3" />他的父母對他說：「難道我們族兄弟的女兒中，或者所有的族人中沒有女子嗎？你竟然要到未受割禮的<char style="pn">非利士</char>人那裡娶妻。」</para>
  <para style="p" vid="JDG 14:3">
    <char style="pn">叄孫</char>對父親說：「請把她給我娶來，因為在我眼中，就她合適。」 <verse eid="JDG 14:3" /><verse number="4" style="v" sid="JDG 14:4" />他的父母不明白這是出於耶和華，耶和華在尋找時機攻擊<char style="pn">非利士</char>人。在那段時期，<char style="pn">非利士</char>人轄制著<char style="pn">以色列</char>。<verse eid="JDG 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 14:5" />
    <char style="pn">叄孫</char>與父母一起下<char style="pn">亭拿</char>去，來到了<char style="pn">亭拿</char>的葡萄園。忽然有一隻少壯獅子吼叫著向他撲過來， <verse eid="JDG 14:5" /><verse number="6" style="v" sid="JDG 14:6" />耶和華的靈大大臨到他，他就赤手空拳撕裂了獅子，如同撕裂小山羊。他沒有把所做的事告訴父母。 <verse eid="JDG 14:6" /><verse number="7" style="v" sid="JDG 14:7" /><char style="pn">叄孫</char>下去與那女子說話，在<char style="pn">叄孫</char>眼中她很合適。<verse eid="JDG 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 14:8" />過了一些日子，<char style="pn">叄孫</char>回去迎娶那女子。他轉往路旁去看那獅子的屍體，發現獅子的屍體裡有一群蜜蜂，還有蜂蜜。 <verse eid="JDG 14:8" /><verse number="9" style="v" sid="JDG 14:9" />他取了一些蜂蜜在手掌裡，然後繼續走，邊走邊吃。他走到父母那裡，把蜂蜜給了他們，他們也吃了，但他沒有告訴他們蜂蜜是從獅子的屍體裡取來的。<verse eid="JDG 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 14:10" />於是，<char style="pn">叄孫</char>的父親下去見那女子，<char style="pn">叄孫</char>就照著青年人的慣例，在那裡擺設了宴席。 <verse eid="JDG 14:10" /><verse number="11" style="v" sid="JDG 14:11" />那裡的人看見<char style="pn">叄孫</char>，就安排了三十個夥伴陪同他。<verse eid="JDG 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 14:12" />
    <char style="pn">叄孫</char>對他們說：「現在讓我給你們出一個謎語吧，如果你們在七天宴席期間能向我解答，我就給你們三十件細麻衣和三十套服裝。 <verse eid="JDG 14:12" /><verse number="13" style="v" sid="JDG 14:13" />如果你們不能向我解答，你們就給我三十件細麻衣和三十套服裝。」</para>
  <para style="p" vid="JDG 14:13">他們對他說：「請你出謎語吧，讓我們聽聽。」<verse eid="JDG 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 14:14" />
    <char style="pn">叄孫</char>就對他們說：</para>
  <para style="q1" vid="JDG 14:14">「吃的出於吃者，</para>
  <para style="q1" vid="JDG 14:14">甜的出於強者。」</para>
  <para style="b" vid="JDG 14:14" />
  <para style="p" vid="JDG 14:14">三天他們都不能解答那謎語。 <verse eid="JDG 14:14" /><verse number="15" style="v" sid="JDG 14:15" />這樣，到了第七天，他們對<char style="pn">叄孫</char>的妻子說：「你要引誘你的丈夫，讓他向我們解答這謎語，否則我們就放火燒了你和你的父家。你們邀請我們，難道是要搶奪我們，不是吧？」<verse eid="JDG 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 14:16" />
    <char style="pn">叄孫</char>的妻子就對丈夫哭鬧，說：「你一定是恨我，並不愛我！你出謎語給我的族人，卻不給我解答。」</para>
  <para style="p" vid="JDG 14:16">
    <char style="pn">叄孫</char>對她說：「看哪，我連父母都沒有告訴，怎能告訴你呢？」<verse eid="JDG 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 14:17" />七天宴席期間，她一直對<char style="pn">叄孫</char>哭鬧。這樣，到了第七天，因她催逼，<char style="pn">叄孫</char>就告訴了她。於是，她去向自己的族人解答了那謎語。 <verse eid="JDG 14:17" /><verse number="18" style="v" sid="JDG 14:18" />在第七天日落之前，那城的人對<char style="pn">叄孫</char>說：</para>
  <para style="q1" vid="JDG 14:18">「有什麼比蜂蜜更甜？</para>
  <para style="q1" vid="JDG 14:18">有什麼比獅子更強？」</para>
  <para style="b" vid="JDG 14:18" />
  <para style="p" vid="JDG 14:18">
    <char style="pn">叄孫</char>對他們說：</para>
  <para style="q1" vid="JDG 14:18">「要不是用我的小母牛耕作，</para>
  <para style="q1" vid="JDG 14:18">你們絕猜不出我的謎語。」<verse eid="JDG 14:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="JDG 14:19" />耶和華的靈大大臨到<char style="pn">叄孫</char>，他就下到<char style="pn">阿實基倫</char>，擊殺了三十個人，奪走他們的服裝，把那些服裝給了解答謎語的人，然後怒氣發作，回他父家去了。 <verse eid="JDG 14:19" /><verse number="20" style="v" sid="JDG 14:20" />之後，<char style="pn">叄孫</char>的妻子歸給了陪同<char style="pn">叄孫</char>的一個夥伴。<verse eid="JDG 14:20" /></para>
  <chapter eid="JDG 14" />
  <chapter number="15" style="c" sid="JDG 15" />
  <para style="s">叁孫的報復</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 15:1" />過了一些日子，在收割小麥的時候，<char style="pn">叄孫</char>帶著一隻小山羊去探望他的妻子。他說：「我要進內室見我的妻子」，他岳父卻不讓他進去。<verse eid="JDG 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 15:2" />岳父告訴他：「我本以為你恨透了她，就把她嫁給了你的夥伴。她的妹妹不是比她更美嗎？不如讓她妹妹代替她歸你。」<verse eid="JDG 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 15:3" />
    <char style="pn">叄孫</char>就對他們說：「這一次我加害<char style="pn">非利士</char>人，就沒有罪責了。」 <verse eid="JDG 15:3" /><verse number="4" style="v" sid="JDG 15:4" />於是，<char style="pn">叄孫</char>去捉了三百隻狐狸，又拿來火把，將牠們尾巴對尾巴綁起來，每兩條尾巴之間插一支火把。 <verse eid="JDG 15:4" /><verse number="5" style="v" sid="JDG 15:5" />然後他點燃火把，將狐狸放進<char style="pn">非利士</char>人的莊稼裡，把麥捆和莊稼，以及葡萄園、橄欖園，都燒毀了。<verse eid="JDG 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 15:6" />
    <char style="pn">非利士</char>人問：「這是誰乾的？」</para>
  <para style="p" vid="JDG 15:6">有人說：「是<char style="pn">亭拿</char>人的女婿<char style="pn">叄孫</char>，因為他岳父把他的妻子嫁給了他的夥伴。」<char style="pn">非利士</char>人就上去，放火燒死了那女子和她父親。<verse eid="JDG 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 15:7" />
    <char style="pn">叄孫</char>對<char style="pn">非利士</char>人說：「你們既然這樣做，我一定要報復你們才罷休！」 <verse eid="JDG 15:7" /><verse number="8" style="v" sid="JDG 15:8" /><char style="pn">叄孫</char>擊殺他們，砍腰斷腿，是一場極大的殺戮。然後他下去，住在<char style="pn">以坦</char>的岩石穴裡。<verse eid="JDG 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 15:9" />
    <char style="pn">非利士</char>人上來，在<char style="pn">猶大</char>紮營，散布在<char style="pn">利希</char>。 <verse eid="JDG 15:9" /><verse number="10" style="v" sid="JDG 15:10" /><char style="pn">猶大</char>人問：「你們為什麼上來攻打我們呢？」</para>
  <para style="p" vid="JDG 15:10">
    <char style="pn">非利士</char>人說：「我們上來是要捆綁<char style="pn">叄孫</char>。他怎樣對待我們，我們也要怎樣對待他。」<verse eid="JDG 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 15:11" />於是有三千<char style="pn">猶大</char>人下去，到<char style="pn">以坦</char>的岩石穴那裡，對<char style="pn">叄孫</char>說：「難道你不知道<char style="pn">非利士</char>人轄制著我們嗎？你對我們做的這是什麼事呢？」</para>
  <para style="p" vid="JDG 15:11">
    <char style="pn">叄孫</char>回答：「他們怎樣對待我，我也怎樣對待他們。」<verse eid="JDG 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 15:12" />
    <char style="pn">猶大</char>人對他說：「我們下來是要捆綁你，把你交在<char style="pn">非利士</char>人手中。」</para>
  <para style="p" vid="JDG 15:12">
    <char style="pn">叄孫</char>對他們說：「你們要向我起誓，你們自己不殺害我。」<verse eid="JDG 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 15:13" />他們答應他說：「不會的，我們只是把你牢牢捆住，交在<char style="pn">非利士</char>人手中。我們絕不會殺你。」於是他們用兩根新繩子把<char style="pn">叄孫</char>捆住，從岩石那裡帶上來。<verse eid="JDG 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 15:14" />
    <char style="pn">叄孫</char>到了<char style="pn">利希</char>，<char style="pn">非利士</char>人呼喊著迎上來。耶和華的靈大大臨到<char style="pn">叄孫</char>，他膀臂上的繩子就像被火燒的細麻那樣，綁繩從他的手上脫落下來了。 <verse eid="JDG 15:14" /><verse number="15" style="v" sid="JDG 15:15" />他看到一根還未乾的驢腮骨，就伸手撿起來，用它擊殺了一千人。 <verse eid="JDG 15:15" /><verse number="16" style="v" sid="JDG 15:16" /><char style="pn">叄孫</char>說：</para>
  <para style="q1" vid="JDG 15:16">「驢腮骨一根，橫尸一堆堆；</para>
  <para style="q1" vid="JDG 15:16">驢腮骨一根，殺倒一千人。」<verse eid="JDG 15:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="JDG 15:17" />說完這些，他順手扔掉驢腮骨。於是那地方被稱為<char style="pn">拉末利希</char><note caller="+" style="f"><char style="fr" closed="false">15:17 </char><char style="ft" closed="false">拉末利希——或譯作「腮骨高坡」。</char></note>。 <verse eid="JDG 15:17" /><verse number="18" style="v" sid="JDG 15:18" /><char style="pn">叄孫</char>非常口渴，就向耶和華呼求說：「你藉著你僕人的手賜下了這麼大的拯救<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">拯救——或譯作「勝利」。</char></note>，現在我卻要因乾渴而死，落在未受割禮之人手中嗎？」 <verse eid="JDG 15:18" /><verse number="19" style="v" sid="JDG 15:19" />神使<char style="pn">利希</char>的窪地裂開，湧出水來。<char style="pn">叄孫</char>喝了，就恢復了精神，充滿活力。因此他給這水泉起名為<char style="pn">哈克雷</char>泉<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="ft" closed="false">哈克雷泉——或譯作「恩哈克雷」。</char></note>，它至今還在<char style="pn">利希</char>。 <verse eid="JDG 15:19" /><verse number="20" style="v" sid="JDG 15:20" />在<char style="pn">非利士</char>人強盛<note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false">強盛——輔助詞語。</char></note>的那些日子，<char style="pn">叄孫</char>作<char style="pn">以色列</char>的士師二十年。<verse eid="JDG 15:20" /></para>
  <chapter eid="JDG 15" />
  <chapter number="16" style="c" sid="JDG 16" />
  <para style="s">叁孫與達莉拉</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 16:1" />後來<char style="pn">叄孫</char>去<char style="pn">加沙</char>，在那裡見到一個妓女，就與她同寢。 <verse eid="JDG 16:1" /><verse number="2" style="v" sid="JDG 16:2" /><char style="pn">加沙</char>人聽說<char style="pn">叄孫</char>到這裡來了，就把他圍住，整夜在城門口埋伏著。他們整夜靜默不動，心想：「等到早晨天一亮，我們就殺了他。」 <verse eid="JDG 16:2" /><verse number="3" style="v" sid="JDG 16:3" /><char style="pn">叄孫</char>睡到半夜，在半夜起來，抓住城門口的門扇和兩個門框，把它們與門閂一同拔出來，扛在肩膀上，抬到了<char style="pn">希伯崙</char>對面的山頂上。<verse eid="JDG 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 16:4" />此後，<char style="pn">叄孫</char>在<char style="pn">索列</char>溪谷愛上了一個女人，名叫<char style="pn">達莉拉</char>。 <verse eid="JDG 16:4" /><verse number="5" style="v" sid="JDG 16:5" /><char style="pn">非利士</char>的首領們上去見<char style="pn">達莉拉</char>，對她說：「你要引誘<char style="pn">叄孫</char>，探查他的力量為何這麼大，我們怎樣才能勝過他，把他捆住制伏他。我們每人會給你一千一百錠銀子。」<verse eid="JDG 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 16:6" />於是<char style="pn">達莉拉</char>對<char style="pn">叄孫</char>說：「請你告訴我，你的力量為何這麼大，怎樣才能把你捆住制伏你。」<verse eid="JDG 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 16:7" />
    <char style="pn">叄孫</char>告訴她：「如果用七條還沒有乾的新皮條捆住我，我就會軟弱無力，像普通人一樣。」<verse eid="JDG 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 16:8" />於是<char style="pn">非利士</char>的首領們給<char style="pn">達莉拉</char>送來七條還沒有乾的新皮條，她就用這些皮條捆住<char style="pn">叄孫</char>。 <verse eid="JDG 16:8" /><verse number="9" style="v" sid="JDG 16:9" />她預先讓埋伏的人在內室等著，然後對<char style="pn">叄孫</char>說：「<char style="pn">叄孫</char>，<char style="pn">非利士</char>人捉你來了！」<char style="pn">叄孫</char>掙斷皮條，像麻線一碰到火就斷了那樣。他力量的根源還是沒有人知道。<verse eid="JDG 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 16:10" />
    <char style="pn">達莉拉</char>對<char style="pn">叄孫</char>說：「看，你愚弄我，對我說謊！現在請告訴我，怎樣才能捆住你？」<verse eid="JDG 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 16:11" />
    <char style="pn">叄孫</char>告訴她：「如果用從來沒有使用過的新繩子牢牢捆住我，我就會軟弱無力，像普通人一樣。」<verse eid="JDG 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 16:12" />
    <char style="pn">達莉拉</char>就拿新繩子捆住<char style="pn">叄孫</char>，對他說：「<char style="pn">叄孫</char>，<char style="pn">非利士</char>人捉你來了！」埋伏的人預先在內室等著。<char style="pn">叄孫</char>掙斷膀臂上的繩子，如同掙斷一條絲帶。<verse eid="JDG 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 16:13" />
    <char style="pn">達莉拉</char>就對<char style="pn">叄孫</char>說：「你直到如今都在愚弄我，對我說謊！請告訴我，怎樣才能捆住你？」</para>
  <para style="p" vid="JDG 16:13">
    <char style="pn">叄孫</char>告訴她：「如果你把我頭上的七條辮子與織布機的緯線編在一起，用橛子牢牢釘住，我就會軟弱無力，像普通人一樣<note caller="+" style="f"><char style="fr" closed="false">16:13 </char><char style="ft" closed="false">用橛子牢牢釘住，我就會軟弱無力，像普通人一樣——依據七十士譯本；馬索拉文本無此句。</char></note>。」<verse eid="JDG 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 16:14" />於是，<char style="pn">達莉拉</char>趁<char style="pn">叄孫</char>睡覺的時候，把<char style="pn">叄孫</char>頭上的七條辮子與織布機的緯線編在一起<note caller="+" style="f"><char style="fr" closed="false">16:14 </char><char style="ft" closed="false">趁叁孫睡覺的時候，把叁孫頭上的七條辮子與織布機的緯線編在一起——依據七十士譯本；馬索拉文本無此句。</char></note>，用橛子釘牢，然後對他說：「<char style="pn">叄孫</char>，<char style="pn">非利士</char>人捉你來了！」<char style="pn">叄孫</char>就從沉睡中醒來，把橛子、織布機、緯線都拔了出來。<verse eid="JDG 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 16:15" />
    <char style="pn">達莉拉</char>對<char style="pn">叄孫</char>說：「你怎能說你愛我呢？你的心根本不在我身上！這三次你都愚弄我，沒有告訴我你的力量為何這麼大。」<verse eid="JDG 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 16:16" />這樣，<char style="pn">達莉拉</char>天天用話催逼他，糾纏他，以致他心中煩得要死。 <verse eid="JDG 16:16" /><verse number="17" style="v" sid="JDG 16:17" /><char style="pn">叄孫</char>就把心裡的一切都告訴了<char style="pn">達莉拉</char>。他對<char style="pn">達莉拉</char>說：「我頭上從來沒有用過剃刀，因為我在母腹中就已經歸於神作<char style="pn">拿細耳</char>人<note caller="+" style="f"><char style="fr" closed="false">16:17 </char><char style="ft" closed="false">拿細耳人——意思是「分別出來的人」。</char></note>。一旦我的頭髮被剃掉，我的力量就會離開我，我就會軟弱無力，像普通人一樣。」<verse eid="JDG 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 16:18" />
    <char style="pn">達莉拉</char>見<char style="pn">叄孫</char>把心裡的一切都告訴了她，就派人去叫來<char style="pn">非利士</char>的首領們，說：「你們再一次過來吧！他已經把心裡的一切都告訴我了。」<char style="pn">非利士</char>的首領們就上她那裡去，手裡拿著銀子。<verse eid="JDG 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 16:19" />
    <char style="pn">達莉拉</char>使<char style="pn">叄孫</char>在她的膝蓋上沉睡，然後叫人來，剃掉他頭上的七條辮子。這樣<char style="pn">達莉拉</char>就制伏<char style="pn">叄孫</char>，<char style="pn">叄孫</char>的力量離開了。 <verse eid="JDG 16:19" /><verse number="20" style="v" sid="JDG 16:20" /><char style="pn">達莉拉</char>說：「<char style="pn">叄孫</char>，<char style="pn">非利士</char>人捉你來了！」<char style="pn">叄孫</char>從沉睡中醒過來，心想：「我要像前幾次那樣，一抖脫身。」他卻不知道耶和華已經離開了他。<verse eid="JDG 16:20" /></para>
  <para style="s">叁孫敗亡</para>
  <para style="p">
    <verse number="21" style="v" sid="JDG 16:21" />
    <char style="pn">非利士</char>人抓住了<char style="pn">叄孫</char>，剜出他的雙眼，把他帶到<char style="pn">加沙</char>，用銅鏈捆住他，讓他在監獄裡推磨。 <verse eid="JDG 16:21" /><verse number="22" style="v" sid="JDG 16:22" />然而，他的頭髮被剃掉以後，又開始長出來了。<verse eid="JDG 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 16:23" />
    <char style="pn">非利士</char>的首領們聚集在一起，要向他們的神<char style="pn">大袞</char>獻大祭並歡慶，他們說：</para>
  <para style="q1" vid="JDG 16:23">「我們的神把我們的仇敵<char style="pn">叄孫</char></para>
  <para style="q1" vid="JDG 16:23">交在我們手中了。」<verse eid="JDG 16:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="JDG 16:24" />民眾看見<char style="pn">叄孫</char>，就讚美他們的神明，說：</para>
  <para style="q1" vid="JDG 16:24">「我們的神把我們的仇敵交在我們手中了，</para>
  <para style="q1" vid="JDG 16:24">這人曾使我們的土地荒廢，</para>
  <para style="q1" vid="JDG 16:24">殺害了我們許多人！」<verse eid="JDG 16:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="JDG 16:25" />那時，他們心裡高興，就說：「把<char style="pn">叄孫</char>叫來，在我們面前戲耍！」於是他們把<char style="pn">叄孫</char>從監獄裡叫出來，<char style="pn">叄孫</char>就在他們面前耍把戲。他們讓<char style="pn">叄孫</char>站在柱子中間。<verse eid="JDG 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JDG 16:26" />
    <char style="pn">叄孫</char>對拉著他手的少年人說：「放開我的手吧，讓我摸摸支撐廟宇的柱子，我好在柱子上靠一靠。」 <verse eid="JDG 16:26" /><verse number="27" style="v" sid="JDG 16:27" />那時廟宇裡擠滿了男人女人，<char style="pn">非利士</char>的首領全都在那裡，屋頂上約有三千男人和女人在觀看<char style="pn">叄孫</char>戲耍。 <verse eid="JDG 16:27" /><verse number="28" style="v" sid="JDG 16:28" /><char style="pn">叄孫</char>呼求耶和華說：「主耶和華啊，求你記念我！神哪，就這一次，求你賜我力量，讓我一次就向<char style="pn">非利士</char>人報了我雙眼的仇。」 <verse eid="JDG 16:28" /><verse number="29" style="v" sid="JDG 16:29" /><char style="pn">叄孫</char>就按住中央兩根支撐廟宇的柱子，右手一根，左手一根，抵住它們。 <verse eid="JDG 16:29" /><verse number="30" style="v" sid="JDG 16:30" /><char style="pn">叄孫</char>說：「讓我與<char style="pn">非利士</char>人一起死吧！」然後用力一推，廟宇就倒在裡面的首領和所有民眾身上。這樣，<char style="pn">叄孫</char>死時所殺的人，比生前所殺的還多。<verse eid="JDG 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JDG 16:31" />
    <char style="pn">叄孫</char>的兄弟們和他父親的全家一起下去，把他帶回來，葬在<char style="pn">佐拉</char>和<char style="pn">以實陶</char>之間他父親<char style="pn">瑪挪亞</char>的墳墓裡。<char style="pn">叄孫</char>作<char style="pn">以色列</char>的士師有二十年。<verse eid="JDG 16:31" /></para>
  <chapter eid="JDG 16" />
  <chapter number="17" style="c" sid="JDG 17" />
  <para style="s">米迦的祭司</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 17:1" />
    <char style="pn">以法蓮</char>山地有一個人，名叫<char style="pn">米迦</char>。 <verse eid="JDG 17:1" /><verse number="2" style="v" sid="JDG 17:2" />他對母親說：「你的一千一百錠銀子被人拿去了，因此你發出詛咒，也說給我聽了。看哪，銀子在我這裡，是我拿的。」</para>
  <para style="p" vid="JDG 17:2">他母親就說：「願我兒蒙耶和華祝福！」<verse eid="JDG 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 17:3" />
    <char style="pn">米迦</char>把那一千一百錠銀子還給母親，母親說：「我要為我兒把手中這銀子全都分別為聖歸於耶和華，造一個雕像和一個鑄像。現在，我把銀子交還給你。」 <verse eid="JDG 17:3" /><verse number="4" style="v" sid="JDG 17:4" /><char style="pn">米迦</char>把銀子還給母親以後，母親取了兩百錠銀子交給銀匠，造了一個雕像和一個鑄像，放在<char style="pn">米迦</char>的家裡。<verse eid="JDG 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 17:5" />這<char style="pn">米迦</char>有一個神堂。他又造了一個以弗得和一些家族神像，又使他的一個兒子承接聖職，作他的祭司。 <verse eid="JDG 17:5" /><verse number="6" style="v" sid="JDG 17:6" />在那些日子，<char style="pn">以色列</char>沒有王，各人做自己眼中看為正的事。<verse eid="JDG 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 17:7" />有一個年輕人，來自<char style="pn">猶大</char>的<char style="pn">伯利恆</char>，屬於<char style="pn">猶大</char>家族，他是個<char style="pn">利未</char>人，寄居在那裡。 <verse eid="JDG 17:7" /><verse number="8" style="v" sid="JDG 17:8" />這人離開了<char style="pn">猶大</char>的<char style="pn">伯利恆</char>城，要找一個寄居的地方，途中來到<char style="pn">以法蓮</char>山地，經過<char style="pn">米迦</char>的家。<verse eid="JDG 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 17:9" />
    <char style="pn">米迦</char>問他：「你從哪裡來？」</para>
  <para style="p" vid="JDG 17:9">他回答說：「我是<char style="pn">利未</char>人，來自<char style="pn">猶大</char>的<char style="pn">伯利恆</char>，我來要找一個寄居的地方。」<verse eid="JDG 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 17:10" />
    <char style="pn">米迦</char>對他說：「你就住在我這裡吧，作我的父、我的祭司。我每年給你十錠銀子、一套衣服，還有食物。」這<char style="pn">利未</char>人就來了。 <verse eid="JDG 17:10" /><verse number="11" style="v" sid="JDG 17:11" />這<char style="pn">利未</char>人同意與<char style="pn">米迦</char>住在一起，<char style="pn">米迦</char>對這年輕人就像對待自己的一個兒子。 <verse eid="JDG 17:11" /><verse number="12" style="v" sid="JDG 17:12" /><char style="pn">米迦</char>使這年輕的<char style="pn">利未</char>人承接聖職作祭司，他就留在<char style="pn">米迦</char>的家裡。 <verse eid="JDG 17:12" /><verse number="13" style="v" sid="JDG 17:13" /><char style="pn">米迦</char>說：「現在我知道耶和華要使我蒙福了，因為我有一個<char style="pn">利未</char>人作祭司。」<verse eid="JDG 17:13" /></para>
  <chapter eid="JDG 17" />
  <chapter number="18" style="c" sid="JDG 18" />
  <para style="s">但支派尋找安居之地</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 18:1" />在那些日子，<char style="pn">以色列</char>沒有王；那時<char style="pn">但</char>支派還在為自己尋找可安居的繼業之地，因為直到那時，他們還沒有在<char style="pn">以色列</char>眾支派當中分得繼業。 <verse eid="JDG 18:1" /><verse number="2" style="v" sid="JDG 18:2" /><char style="pn">但</char>支派的人從他們家族各群體中，從<char style="pn">佐拉</char>和<char style="pn">以實陶</char>派遣了五個人，都是勇士，要去窺視探查那地。他們吩咐這五人：「你們去探查那地。」</para>
  <para style="p" vid="JDG 18:2">這些人來到<char style="pn">以法蓮</char>山地，到了<char style="pn">米迦</char>的家，就在那裡過夜。 <verse eid="JDG 18:2" /><verse number="3" style="v" sid="JDG 18:3" />當時他們靠近<char style="pn">米迦</char>的家，認出那年輕<char style="pn">利未</char>人的聲音，就進到裡面去。他們問他：「誰帶你到這裡來的？你在這裡做什麼？你在這裡得了什麼？」 <verse eid="JDG 18:3" /><verse number="4" style="v" sid="JDG 18:4" />他就告訴他們<char style="pn">米迦</char>如此如此對待自己，說：「他雇用了我，我作他的祭司。」<verse eid="JDG 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 18:5" />他們對他說：「請你求問神，好讓我們知道我們的行程是否會順利。」<verse eid="JDG 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 18:6" />這祭司對他們說：「平安地去吧，耶和華必看顧你們的行程<note caller="+" style="f"><char style="fr" closed="false">18:6 </char><char style="ft" closed="false">耶和華必看顧你們的行程——原文直譯「你們行走的路必在耶和華面前」。</char></note>。」<verse eid="JDG 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 18:7" />五人繼續前行，來到<char style="pn">拉伊</char>，看見住在<char style="pn">拉伊</char>的人像<char style="pn">西頓</char>人那樣安然居住，平靜安穩。他們在那地沒有人轄制欺負他們<note caller="+" style="f"><char style="fr" closed="false">18:7 </char><char style="ft" closed="false">沒有人轄制欺負他們——或譯作「一無所缺，物產豐富」。</char></note>。他們離<char style="pn">西頓</char>人很遠，與其他人也沒有往來。<verse eid="JDG 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 18:8" />五人回到<char style="pn">佐拉</char>和<char style="pn">以實陶</char>他們的兄弟們那裡，兄弟們問他們：「情況怎樣呢？」<verse eid="JDG 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 18:9" />他們說：「起來，我們上去攻打那些人吧。我們察看了那地，發現那裡實在美好。你們還靜默嗎？不要猶豫，去吧，進去占領那地！ <verse eid="JDG 18:9" /><verse number="10" style="v" sid="JDG 18:10" />當你們進去，會來到安穩的民那裡，邊界寬廣的土地上。神已經把它交在你們手中了，那裡不缺地上的任何物產。」 <verse eid="JDG 18:10" /><verse number="11" style="v" sid="JDG 18:11" />於是<char style="pn">但</char>家族中，<char style="pn">佐拉</char>和<char style="pn">以實陶</char>有六百人佩帶兵器，從那裡出發了。 <verse eid="JDG 18:11" /><verse number="12" style="v" sid="JDG 18:12" />他們上去，在<char style="pn">猶大</char>的<char style="pn">基列-耶琳</char>紮營。因此那地方被稱為<char style="pn">瑪哈尼但</char><note caller="+" style="f"><char style="fr" closed="false">18:12 </char><char style="ft" closed="false">瑪哈尼但——或譯作「但的營地」。</char></note>，直到今日；看哪，就在<char style="pn">基列-耶琳</char>的西邊。 <verse eid="JDG 18:12" /><verse number="13" style="v" sid="JDG 18:13" />他們從那裡過去，到<char style="pn">以法蓮</char>山地，來到<char style="pn">米迦</char>的家。<verse eid="JDG 18:13" /></para>
  <para style="s">但支派與米迦的祭司</para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 18:14" />先前窺探<char style="pn">拉伊</char>地的那五個人告訴兄弟們，說：「你們知道嗎，這家有以弗得、家族神像、雕像和鑄像。現在你們應當知道該做什麼了。」 <verse eid="JDG 18:14" /><verse number="15" style="v" sid="JDG 18:15" />他們就轉往那裡去，來到<char style="pn">米迦</char>的家那年輕<char style="pn">利未</char>人的住處，向他問安。 <verse eid="JDG 18:15" /><verse number="16" style="v" sid="JDG 18:16" /><char style="pn">但</char>支派的那六百人，都佩帶兵器站在大門口。 <verse eid="JDG 18:16" /><verse number="17" style="v" sid="JDG 18:17" />先前窺探那地的五個人上前去，進到裡面拿走了雕像、以弗得、家族神像和鑄像。祭司和那些佩帶兵器的六百人，都站在大門口。<verse eid="JDG 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 18:18" />五人進入<char style="pn">米迦</char>的家裡拿走雕像、以弗得、家族神像和鑄像時，祭司問他們：「你們在做什麼？」<verse eid="JDG 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 18:19" />他們對他說：「捂住你的嘴，不要作聲。跟我們一起走吧，作我們的父、我們的祭司。你是作一人一家的祭司好呢，還是作<char style="pn">以色列</char>一個支派、一個家族的祭司好呢？」 <verse eid="JDG 18:19" /><verse number="20" style="v" sid="JDG 18:20" />這祭司心裡高興，就拿著以弗得、家族神像和雕像，加入了這些民眾。 <verse eid="JDG 18:20" /><verse number="21" style="v" sid="JDG 18:21" />他們轉身離去，安排家屬、牲畜和貴重物品走在隊伍的前面。<verse eid="JDG 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 18:22" />他們從<char style="pn">米迦</char>的家走遠後，<char style="pn">米迦</char>的家附近的鄰居被召集起來，追上了<char style="pn">但</char>支派的人。 <verse eid="JDG 18:22" /><verse number="23" style="v" sid="JDG 18:23" />他們呼叫<char style="pn">但</char>支派的人，那些人轉身對<char style="pn">米迦</char>說：「你召集人要做什麼？」<verse eid="JDG 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 18:24" />
    <char style="pn">米迦</char>說：「你們拿走了我造的神像，帶走了我的祭司，我還剩什麼呢？你們怎麼還問我『你要做什麼』？」<verse eid="JDG 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 18:25" />
    <char style="pn">但</char>支派的人對<char style="pn">米迦</char>說：「不要再讓我們聽見你的聲音，恐怕有暴躁的人攻擊你們，你和你的全家就喪命了！」 <verse eid="JDG 18:25" /><verse number="26" style="v" sid="JDG 18:26" />於是<char style="pn">但</char>支派的人繼續趕路；<char style="pn">米迦</char>見他們比自己強大，就轉身回家去了。<verse eid="JDG 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JDG 18:27" />他們帶著<char style="pn">米迦</char>製造的神像和<char style="pn">米迦</char>的祭司，來到<char style="pn">拉伊</char>，到了平靜安穩的民那裡。他們用刀擊殺那裡的人，放火燒毀了那城。 <verse eid="JDG 18:27" /><verse number="28" style="v" sid="JDG 18:28" />沒有人解救那城，因為它離<char style="pn">西頓</char>很遠，他們又與其他人沒有來往。這城在平原中靠近<char style="pn">伯利合</char>，<char style="pn">但</char>支派的人重建了這座城，住在其中。 <verse eid="JDG 18:28" /><verse number="29" style="v" sid="JDG 18:29" />他們以自己的祖先、<char style="pn">以色列</char>所生之子<char style="pn">但</char>的名字，給這城起名為<char style="pn">但</char>；<char style="pn">拉伊</char>是這城原先的名字。<verse eid="JDG 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JDG 18:30" />
    <char style="pn">但</char>支派的人把那雕像為自己豎立起來；<char style="pn">摩西</char><note caller="+" style="f"><char style="fr" closed="false">18:30 </char><char style="ft" closed="false">摩西——依據七十士譯本；馬索拉文本作「瑪拿西」。</char></note>的孫子、<char style="pn">革順</char>的兒子<char style="pn">約拿單</char>作祭司，他和他的子孫作<char style="pn">但</char>支派的祭司直到那地被擄之日。 <verse eid="JDG 18:30" /><verse number="31" style="v" sid="JDG 18:31" />神的居所在<char style="pn">示羅</char>的日子裡，<char style="pn">但</char>支派的人一直為自己豎立著<char style="pn">米迦</char>所造的雕像。<verse eid="JDG 18:31" /></para>
  <chapter eid="JDG 18" />
  <chapter number="19" style="c" sid="JDG 19" />
  <para style="s">便雅憫境內的暴行</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 19:1" />在<char style="pn">以色列</char>沒有王的那些日子，有一個<char style="pn">利未</char>人寄居在<char style="pn">以法蓮</char>山地深處，他從<char style="pn">猶大</char>的<char style="pn">伯利恆</char>娶了一個女子為妾。 <verse eid="JDG 19:1" /><verse number="2" style="v" sid="JDG 19:2" />他的妾厭惡他<note caller="+" style="f"><char style="fr" closed="false">19:2 </char><char style="ft" closed="false">厭惡他——七十士譯本作「對他惱怒」；馬索拉文本作「背叛他行淫」。</char></note>，離開他回到<char style="pn">猶大伯利恆</char>她的父家，留在那裡四個月。 <verse eid="JDG 19:2" /><verse number="3" style="v" sid="JDG 19:3" />她丈夫帶著一個僕人和兩頭驢起程去找她，為要對她說寬心的話，讓她回來。那女子把丈夫帶進父家，父親看見他，就高興地迎接他。 <verse eid="JDG 19:3" /><verse number="4" style="v" sid="JDG 19:4" />他的岳父，就是那女子的父親挽留他，他就在岳父那裡住了三天。他們又吃又喝，在那裡留宿。<verse eid="JDG 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 19:5" />到了第四天，他們清早起來，那人起身要離去，女子的父親對女婿說：「你吃點餅補充一下精力，然後再走吧。」 <verse eid="JDG 19:5" /><verse number="6" style="v" sid="JDG 19:6" />於是他們兩人又坐下來，一同吃喝。女子的父親對那人說：「請你再過一夜吧，讓你心裡暢快！」 <verse eid="JDG 19:6" /><verse number="7" style="v" sid="JDG 19:7" />那人起身要走，但他岳父再三勸說，他就又在那裡過了一夜。 <verse eid="JDG 19:7" /><verse number="8" style="v" sid="JDG 19:8" />第五天他清早起來要走，女子的父親又說：「你補充一下精力，等到下午再走吧。」於是他們兩人又一起吃飯。 <verse eid="JDG 19:8" /><verse number="9" style="v" sid="JDG 19:9" />然後那人帶著他的妾和僕人起身要走，他的岳父——女子的父親又對他說：「你看，天快要黑了，再過一夜吧。看哪，天晚了，就在這裡過夜吧，讓你心裡暢快，明天清早起來再上路回家<note caller="+" style="f"><char style="fr" closed="false">19:9 </char><char style="ft" closed="false">家——或譯作「自己的帳篷」。</char></note>。」<verse eid="JDG 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 19:10" />可是那人不願再過一夜了，就給兩頭驢備好鞍，帶著他的妾起身離去。他來到<char style="pn">耶布斯</char>對面，<char style="pn">耶布斯</char>就是<char style="pn">耶路撒冷</char>。 <verse eid="JDG 19:10" /><verse number="11" style="v" sid="JDG 19:11" />他們臨近<char style="pn">耶布斯</char>的時候，天已經很晚了，僕人就對主人說：「讓我們去，前往這<char style="pn">耶布斯</char>人的城，在那裡過夜吧。」<verse eid="JDG 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 19:12" />主人對他說：「我們不要進外邦人的城，那不是<char style="pn">以色列</char>人的地方；我們要前往<char style="pn">基比亞</char>。」 <verse eid="JDG 19:12" /><verse number="13" style="v" sid="JDG 19:13" />主人又對僕人說：「走吧，我們趕到<char style="pn">基比亞</char>或<char style="pn">拉瑪</char>，在其中一個地方過夜。」 <verse eid="JDG 19:13" /><verse number="14" style="v" sid="JDG 19:14" />他們就繼續往前走，臨近<char style="pn">便雅憫</char>的<char style="pn">基比亞</char>時，已經日落了。 <verse eid="JDG 19:14" /><verse number="15" style="v" sid="JDG 19:15" />於是他們前往那裡去，要在<char style="pn">基比亞</char>過夜。他們來到城中的廣場坐下，卻沒有人接待他們到家裡過夜。<verse eid="JDG 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 19:16" />看哪，有一個老人傍晚從田間勞作回來，他是<char style="pn">以法蓮</char>山地的人，寄居在<char style="pn">基比亞</char>；那裡是<char style="pn">便雅憫</char>人的地方。 <verse eid="JDG 19:16" /><verse number="17" style="v" sid="JDG 19:17" />老人舉目看見城中廣場上那個客旅，就問他說：「你從哪裡來，要往哪裡去呢？」<verse eid="JDG 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 19:18" />那人回答：「我們是過路的，從<char style="pn">猶大</char>的<char style="pn">伯利恆</char>到<char style="pn">以法蓮</char>山地的深處去，我原是那裡的人。我去了<char style="pn">猶大</char>的<char style="pn">伯利恆</char>，現在要回我的家鄉<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">現在要回我的家鄉——依據七十士譯本；馬索拉文本作「現在要去耶和華的家」，指的是「伯特利」。</char></note>，可是這裡沒有人接待我到家裡去。 <verse eid="JDG 19:18" /><verse number="19" style="v" sid="JDG 19:19" />其實我們有乾草和飼料餵我們的驢，你僕人我和你的這女僕，以及隨行的年輕人也有餅和酒；我們什麼都不缺。」<verse eid="JDG 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 19:20" />老人說：「願你平安！你有什麼需要，只管讓我來承擔，可不要在廣場上過夜。」 <verse eid="JDG 19:20" /><verse number="21" style="v" sid="JDG 19:21" />於是老人把他們帶回家，給驢拌了飼料，他們也洗了腳，然後吃喝。 <verse eid="JDG 19:21" /><verse number="22" style="v" sid="JDG 19:22" />他們正心裡暢快的時候，看哪，城裡的卑劣之徒圍住了房屋，擁擠著撞門<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="ft" closed="false">擁擠著撞門——或譯作「不斷拍門」。</char></note>，對那老家主說：「把來到你家的人帶出來，我們要與他交合。」<verse eid="JDG 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 19:23" />家主出來見他們，對他們說：「不要這樣，我的兄弟們，請不要作惡。既然這人已經進了我的家，就請你們不要做這醜惡的事。 <verse eid="JDG 19:23" /><verse number="24" style="v" sid="JDG 19:24" />看哪，我有個女兒還是處女，還有這人的妾，我把她們帶出來吧，你們可以玷辱她們，隨意對待她們<note caller="+" style="f"><char style="fr" closed="false">19:24 </char><char style="ft" closed="false">隨意對待她們——原文直譯「對她們做你們眼中看為好的」。</char></note>，只是不可對這人做如此醜惡的事。」<verse eid="JDG 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 19:25" />可是那些人不願聽他的。那人就拉住自己的妾，推到外面給了他們。他們與她交合，整夜凌辱她，直到早晨天亮的時候，才放她走。 <verse eid="JDG 19:25" /><verse number="26" style="v" sid="JDG 19:26" />天快亮的時候，那女人回來，倒在她丈夫留宿的老人家門口，直到天亮。<verse eid="JDG 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JDG 19:27" />她丈夫清早起來，打開房門出去，要繼續趕路，卻發現那女人——他的妾倒在房門口，雙手搭在門檻上。 <verse eid="JDG 19:27" /><verse number="28" style="v" sid="JDG 19:28" />丈夫對她說：「起來，我們走吧！」可是沒有回應。於是那人把她馱在驢背上，動身回本地去了。<verse eid="JDG 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 19:29" />回到家裡，他拿來刀，扶住他的妾，把她的屍體切成十二塊，送到<char style="pn">以色列</char>全境。 <verse eid="JDG 19:29" /><verse number="30" style="v" sid="JDG 19:30" />所有看見的人都說：「<char style="pn">以色列</char>子孫從<char style="pn">埃及</char>地上來的那天起，直到今天，從來沒有發生過、也沒有見到過這樣的事。大家要考慮、商議，對此表態。」<verse eid="JDG 19:30" /></para>
  <chapter eid="JDG 19" />
  <chapter number="20" style="c" sid="JDG 20" />
  <para style="s">攻打便雅憫</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 20:1" />於是全體<char style="pn">以色列</char>人出動，從<char style="pn">但</char>直到<char style="pn">比爾-謝巴</char>，還有<char style="pn">基列</char>地，會眾如同一人聚集到<char style="pn">米斯巴</char>，到耶和華面前。 <verse eid="JDG 20:1" /><verse number="2" style="v" sid="JDG 20:2" /><char style="pn">以色列</char>眾支派全體民眾的首領，都站在神子民的集會裡，拿刀劍的步兵共有四十萬。 <verse eid="JDG 20:2" /><verse number="3" style="v" sid="JDG 20:3" /><char style="pn">以色列</char>人上到<char style="pn">米斯巴</char>，<char style="pn">便雅憫</char>人也聽說了。</para>
  <para style="p" vid="JDG 20:3">
    <char style="pn">以色列</char>人說：「請說，這件惡事是怎麼發生的？」<verse eid="JDG 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 20:4" />那<char style="pn">利未</char>人，就是被殺的婦人的丈夫，回答說：「我和我的妾來到<char style="pn">便雅憫</char>的<char style="pn">基比亞</char>過夜。 <verse eid="JDG 20:4" /><verse number="5" style="v" sid="JDG 20:5" /><char style="pn">基比亞</char>的居民起來攻擊我，夜間包圍我的住處，想要殺我，隨後把我的妾玷辱致死了。 <verse eid="JDG 20:5" /><verse number="6" style="v" sid="JDG 20:6" />於是我扶住我的妾，把屍體切成塊，送到<char style="pn">以色列</char>得為繼業的全境，因為<char style="pn">基比亞</char>人在<char style="pn">以色列</char>做了淫穢醜惡的事。 <verse eid="JDG 20:6" /><verse number="7" style="v" sid="JDG 20:7" />現在，你們全體<char style="pn">以色列</char>人哪，請你們表態，給出建議吧！」<verse eid="JDG 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 20:8" />那時，全體民眾起來如同一人，說：「我們每個人都不回自己的帳篷，不回自己的家。 <verse eid="JDG 20:8" /><verse number="9" style="v" sid="JDG 20:9" />我們現在要這樣行事來對付<char style="pn">基比亞</char>：按著所抽的籤，上去攻打他們； <verse eid="JDG 20:9" /><verse number="10" style="v" sid="JDG 20:10" />在<char style="pn">以色列</char>各支派中，每一百人選十人，每一千人選一百人，每一萬人選一千人，為軍兵運送食物，等軍兵來到<char style="pn">便雅憫</char>的<char style="pn">基比亞</char>，就照著他們在<char style="pn">以色列</char>所做的一切醜惡之事處置他們。」<verse eid="JDG 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 20:11" />於是<char style="pn">以色列</char>眾人團結如同一人，聚集起來要攻擊那城。 <verse eid="JDG 20:11" /><verse number="12" style="v" sid="JDG 20:12" /><char style="pn">以色列</char>眾支派打發人到<char style="pn">便雅憫</char>支派各地，說：「你們中間為什麼有這樣的惡事呢？ <verse eid="JDG 20:12" /><verse number="13" style="v" sid="JDG 20:13" />現在，你們要把<char style="pn">基比亞</char>的那些卑劣之徒交出來，讓我們把他們處死，從<char style="pn">以色列</char>清除邪惡。」但<char style="pn">便雅憫</char>人不願聽從他們兄弟<char style="pn">以色列</char>人的話。 <verse eid="JDG 20:13" /><verse number="14" style="v" sid="JDG 20:14" /><char style="pn">便雅憫</char>人從各城聚集到<char style="pn">基比亞</char>，要出去與<char style="pn">以色列</char>人作戰。 <verse eid="JDG 20:14" /><verse number="15" style="v" sid="JDG 20:15" />那一天，各城被調集來的<char style="pn">便雅憫</char>人，有兩萬六千拿刀劍的，此外被調集的還有<char style="pn">基比亞</char>居民七百精兵。 <verse eid="JDG 20:15" /><verse number="16" style="v" sid="JDG 20:16" />這全軍當中，七百精兵都是慣用左手的，全都能用投石索甩石，毫髮不差。<verse eid="JDG 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 20:17" />
    <char style="pn">便雅憫</char>人之外的<char style="pn">以色列</char>人，調集了四十萬拿刀劍的，都是戰士。 <verse eid="JDG 20:17" /><verse number="18" style="v" sid="JDG 20:18" /><char style="pn">以色列</char>人起來，上<char style="pn">伯特利</char>去求問神，說：「我們當中，誰先上去與<char style="pn">便雅憫</char>人作戰呢？」</para>
  <para style="p" vid="JDG 20:18">耶和華說：「<char style="pn">猶大</char>先上去。」<verse eid="JDG 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 20:19" />
    <char style="pn">以色列</char>人清早起來，對著<char style="pn">基比亞</char>紮營。 <verse eid="JDG 20:19" /><verse number="20" style="v" sid="JDG 20:20" /><char style="pn">以色列</char>人出去，要與<char style="pn">便雅憫</char>人作戰。<char style="pn">以色列</char>人在<char style="pn">基比亞</char>對面擺陣迎戰， <verse eid="JDG 20:20" /><verse number="21" style="v" sid="JDG 20:21" /><char style="pn">便雅憫</char>人就從<char style="pn">基比亞</char>出來，當天把兩萬兩千<char style="pn">以色列</char>人擊殺在地。 <verse eid="JDG 20:21" /><verse number="22" style="v" sid="JDG 20:22" /><char style="pn">以色列</char>軍兵堅定心志，在第一天擺陣的地方再次擺開戰陣。 <verse eid="JDG 20:22" /><verse number="23" style="v" sid="JDG 20:23" /><char style="pn">以色列</char>人上前來，在耶和華面前哀哭，直到傍晚，他們求問耶和華說：「我們可以再過去與我們的兄弟<char style="pn">便雅憫</char>人作戰嗎？」</para>
  <para style="p" vid="JDG 20:23">耶和華說：「上去攻擊他們吧。」<verse eid="JDG 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 20:24" />第二天，<char style="pn">以色列</char>人又上前去攻打<char style="pn">便雅憫</char>人。 <verse eid="JDG 20:24" /><verse number="25" style="v" sid="JDG 20:25" /><char style="pn">便雅憫</char>人也在第二天從<char style="pn">基比亞</char>出來迎戰，又把<char style="pn">以色列</char>人一萬八千人擊殺在地，都是拿刀劍的。<verse eid="JDG 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JDG 20:26" />於是，全體<char style="pn">以色列</char>人，全體軍兵，都上到<char style="pn">伯特利</char>，坐在耶和華面前哀哭。那一天他們禁食直到傍晚，又在耶和華面前獻上燔祭和平安祭， <verse eid="JDG 20:26" /><verse number="27" style="v" sid="JDG 20:27" />然後<char style="pn">以色列</char>人求問耶和華。那些日子裡，神的約櫃是在<char style="pn">伯特利</char>， <verse eid="JDG 20:27" /><verse number="28" style="v" sid="JDG 20:28" /><char style="pn">亞倫</char>的孫子、<char style="pn">以利亞撒</char>的兒子<char style="pn">非尼哈</char>當時侍立在約櫃前。<char style="pn">以色列</char>人求問說：「我們應該再去攻打我們的兄弟<char style="pn">便雅憫</char>人呢，還是不要去呢？」</para>
  <para style="p" vid="JDG 20:28">耶和華說：「上去吧，明天我必把他們交在你們手中。」 <verse eid="JDG 20:28" /><verse number="29" style="v" sid="JDG 20:29" /><char style="pn">以色列</char>人就在<char style="pn">基比亞</char>四圍設下埋伏。 <verse eid="JDG 20:29" /><verse number="30" style="v" sid="JDG 20:30" />第三天，<char style="pn">以色列</char>人又上去攻打<char style="pn">便雅憫</char>人，像前幾次那樣在<char style="pn">基比亞</char>對面擺陣。 <verse eid="JDG 20:30" /><verse number="31" style="v" sid="JDG 20:31" /><char style="pn">便雅憫</char>人出來迎戰，被引誘出城。他們在兩條大道上，一條通往<char style="pn">伯特利</char>、一條通往<char style="pn">基比亞</char>，開始像前兩次那樣擊殺<char style="pn">以色列</char>人，在田野殺了大約三十個人。 <verse eid="JDG 20:31" /><verse number="32" style="v" sid="JDG 20:32" /><char style="pn">便雅憫</char>人想：「他們必像先前那樣敗在我們面前。」其實<char style="pn">以色列</char>人想的是：「我們要逃跑，引誘他們出城到大道上。」<verse eid="JDG 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JDG 20:33" />這樣，<char style="pn">以色列</char>所有軍兵從自己的位置起來，在<char style="pn">巴力塔瑪</char>擺陣；<char style="pn">以色列</char>的伏兵也從<char style="pn">基比亞</char>西面，從自己的位置衝上來。 <verse eid="JDG 20:33" /><verse number="34" style="v" sid="JDG 20:34" />全<char style="pn">以色列</char>中的一萬精兵，從正面進攻<char style="pn">基比亞</char>，戰鬥很激烈。<char style="pn">便雅憫</char>人並不知道，禍患已經臨近他們了。 <verse eid="JDG 20:34" /><verse number="35" style="v" sid="JDG 20:35" />耶和華在<char style="pn">以色列</char>面前打敗了<char style="pn">便雅憫</char>人；那一天，<char style="pn">以色列</char>人消滅了兩萬五千一百<char style="pn">便雅憫</char>人，都是拿刀劍的。 <verse eid="JDG 20:35" /><verse number="36" style="v" sid="JDG 20:36" /><char style="pn">便雅憫</char>人這才知道自己被打敗了。</para>
  <para style="p" vid="JDG 20:36">
    <char style="pn">以色列</char>人在<char style="pn">便雅憫</char>人面前退出陣地，是因為他們信賴那些在<char style="pn">基比亞</char>對面設下的伏兵。 <verse eid="JDG 20:36" /><verse number="37" style="v" sid="JDG 20:37" />這時伏兵急速衝進<char style="pn">基比亞</char>，伏兵擴散開，用刀擊殺全城。 <verse eid="JDG 20:37" /><verse number="38" style="v" sid="JDG 20:38" /><char style="pn">以色列</char>人事先與伏兵有約定：伏兵在城內升起烽火濃煙， <verse eid="JDG 20:38" /><verse number="39" style="v" sid="JDG 20:39" /><char style="pn">以色列</char>人就返回戰場。<char style="pn">便雅憫</char>人一開始擊殺了大約三十個<char style="pn">以色列</char>人，就說：「他們將要像先前的戰鬥那樣，徹底敗在我們面前了。」 <verse eid="JDG 20:39" /><verse number="40" style="v" sid="JDG 20:40" />然而，烽火的煙柱從城內開始上騰，<char style="pn">便雅憫</char>人回頭一看，全城煙氣衝天， <verse eid="JDG 20:40" /><verse number="41" style="v" sid="JDG 20:41" /><char style="pn">以色列</char>人又返回來了，<char style="pn">便雅憫</char>人就惶恐，因為看出禍患臨近他們了。 <verse eid="JDG 20:41" /><verse number="42" style="v" sid="JDG 20:42" />他們在<char style="pn">以色列</char>人面前轉身逃往曠野，卻被緊緊追擊<note caller="+" style="f"><char style="fr" closed="false">20:42 </char><char style="ft" closed="false">卻被緊緊追擊——原文直譯「戰鬥卻緊隨他們」。</char></note>，從各城出來的人也夾攻消滅他們。 <verse eid="JDG 20:42" /><verse number="43" style="v" sid="JDG 20:43" /><char style="pn">以色列</char>人包圍<char style="pn">便雅憫</char>人，追趕他們，從<char style="pn">挪哈</char><note caller="+" style="f"><char style="fr" closed="false">20:43 </char><char style="ft" closed="false">追趕他們，從挪哈——或譯作「不停歇地追趕他們」。</char></note>直到東邊的<char style="pn">基比亞</char>對面，踐踏他們。 <verse eid="JDG 20:43" /><verse number="44" style="v" sid="JDG 20:44" /><char style="pn">便雅憫</char>人中倒下的有一萬八千人，全都是勇士。 <verse eid="JDG 20:44" /><verse number="45" style="v" sid="JDG 20:45" />其餘的人轉身逃往曠野，到<char style="pn">臨門</char>岩石去。<char style="pn">以色列</char>人在大道上除掉了他們五千人，並追擊他們直到<char style="pn">基頓</char>，又擊殺了兩千人。<verse eid="JDG 20:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JDG 20:46" />那一天，<char style="pn">便雅憫</char>人中總共倒下了兩萬五千個拿刀劍的人，全都是勇士。 <verse eid="JDG 20:46" /><verse number="47" style="v" sid="JDG 20:47" />有六百人轉身逃往曠野，到<char style="pn">臨門</char>岩石去，在<char style="pn">臨門</char>岩石那裡停留了四個月。 <verse eid="JDG 20:47" /><verse number="48" style="v" sid="JDG 20:48" /><char style="pn">以色列</char>人回到<char style="pn">便雅憫</char>人那裡，用刀擊殺他們，擊殺全城包括牲畜以及所遇到的一切，又放火燒毀他們的所有城鎮。<verse eid="JDG 20:48" /></para>
  <chapter eid="JDG 20" />
  <chapter number="21" style="c" sid="JDG 21" />
  <para style="s">為便雅憫人娶妻</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 21:1" />
    <char style="pn">以色列</char>人曾在<char style="pn">米斯巴</char>起誓說：「我們當中誰也不可把女兒嫁給<char style="pn">便雅憫</char>人為妻。」 <verse eid="JDG 21:1" /><verse number="2" style="v" sid="JDG 21:2" />所以民眾來到<char style="pn">伯特利</char>，坐在神面前直到傍晚。他們放聲大哭， <verse eid="JDG 21:2" /><verse number="3" style="v" sid="JDG 21:3" />說：「<char style="pn">以色列</char>的神耶和華啊！為什麼在<char style="pn">以色列</char>發生這樣的事呢？今天<char style="pn">以色列</char>竟然少了一個支派。」 <verse eid="JDG 21:3" /><verse number="4" style="v" sid="JDG 21:4" />第二天，民眾清早起來，在那裡築了一座祭壇，獻上燔祭和平安祭。 <verse eid="JDG 21:4" /><verse number="5" style="v" sid="JDG 21:5" />那時，<char style="pn">以色列</char>人問：「<char style="pn">以色列</char>各支派中，誰沒有到耶和華面前來參加集會？」原來他們針對沒有上<char style="pn">米斯巴</char>到耶和華面前來的人，曾嚴厲起誓說：「那人必須被處死。」<verse eid="JDG 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 21:6" />
    <char style="pn">以色列</char>人為他們的兄弟<char style="pn">便雅憫</char>難過，說：「如今<char style="pn">以色列</char>中有一個支派被砍掉了！ <verse eid="JDG 21:6" /><verse number="7" style="v" sid="JDG 21:7" />我們怎樣才能使他們剩下的人有妻子呢？我們已經指著耶和華起了誓，不把我們的女兒嫁給<char style="pn">便雅憫</char>人為妻。」 <verse eid="JDG 21:7" /><verse number="8" style="v" sid="JDG 21:8" />他們就問：「<char style="pn">以色列</char>支派中誰沒有上<char style="pn">米斯巴</char>，到耶和華面前來呢？」結果發現<char style="pn">基列-雅比</char>沒有一個人到營地來參加集會。 <verse eid="JDG 21:8" /><verse number="9" style="v" sid="JDG 21:9" />他們數點民眾，發現<char style="pn">基列-雅比</char>的居民沒有一個人在場。<verse eid="JDG 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 21:10" />於是會眾從勇士中派出一萬兩千人，吩咐他們說：「你們去，用刀擊殺<char style="pn">基列-雅比</char>的居民，包括女人和孩童。 <verse eid="JDG 21:10" /><verse number="11" style="v" sid="JDG 21:11" />你們要這樣做：把所有的男人，以及所有與男人同房過的女人，都滅絕淨盡。」 <verse eid="JDG 21:11" /><verse number="12" style="v" sid="JDG 21:12" />他們在<char style="pn">基列-雅比</char>的居民中，找到四百個年輕處女，都是沒有與男人同房過的。他們就把這些處女帶到<char style="pn">迦南</char>地的<char style="pn">示羅</char>營地。<verse eid="JDG 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 21:13" />全體會眾派人去，到<char style="pn">臨門</char>岩石那裡與<char style="pn">便雅憫</char>人商談，向他們提議和好， <verse eid="JDG 21:13" /><verse number="14" style="v" sid="JDG 21:14" /><char style="pn">便雅憫</char>人就在那時回來了。<char style="pn">以色列</char>人把存活的<char style="pn">基列-雅比</char>女子給了<char style="pn">便雅憫</char>人為妻，卻發現不夠分給他們所有人。<verse eid="JDG 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 21:15" />人們為<char style="pn">便雅憫</char>人難過，因為耶和華使<char style="pn">以色列</char>眾支派有了破口。 <verse eid="JDG 21:15" /><verse number="16" style="v" sid="JDG 21:16" />會眾的長老們說：「<char style="pn">便雅憫</char>的女子都滅絕了，我們怎樣才能使剩下的人有妻子呢？」 <verse eid="JDG 21:16" /><verse number="17" style="v" sid="JDG 21:17" />他們又說：「<char style="pn">便雅憫</char>的倖存者必須有繼承產業的，免得<char style="pn">以色列</char>中一個支派被抹掉。 <verse eid="JDG 21:17" /><verse number="18" style="v" sid="JDG 21:18" />可是我們又不能把自己的女兒嫁給他們為妻。」因為<char style="pn">以色列</char>人已經起誓說，把女兒嫁給<char style="pn">便雅憫</char>人的必受詛咒。 <verse eid="JDG 21:18" /><verse number="19" style="v" sid="JDG 21:19" />他們就說：「看哪，<char style="pn">示羅</char>每年都有耶和華的節期。」<char style="pn">示羅</char>在<char style="pn">伯特利</char>以北，<char style="pn">伯特利</char>至<char style="pn">示劍</char>的大道東邊，<char style="pn">利波拿</char>的南邊。<verse eid="JDG 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 21:20" />於是他們吩咐<char style="pn">便雅憫</char>人說：「你們去埋伏在葡萄園裡， <verse eid="JDG 21:20" /><verse number="21" style="v" sid="JDG 21:21" />你們看著，一見<char style="pn">示羅</char>的女子出來繞著圈跳舞，你們就從葡萄園出來，各自搶走一個<char style="pn">示羅</char>女子為妻，帶回<char style="pn">便雅憫</char>地去。 <verse eid="JDG 21:21" /><verse number="22" style="v" sid="JDG 21:22" />當他們的父親或兄弟來與我們爭論的時候，我們會對他們說：『請看在我們的情面上恩待他們吧，因為我們在戰爭中沒有使他們每個人都娶到妻子。何況不是你們自己把女兒嫁給了他們，不然你們現在就要承擔罪責了。』」<verse eid="JDG 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 21:23" />
    <char style="pn">便雅憫</char>人就照著去做了。他們按著自己的人數，把他們搶奪的跳舞女子娶來為妻，然後回自己的繼業去，重建城鎮，住在其中。 <verse eid="JDG 21:23" /><verse number="24" style="v" sid="JDG 21:24" />那時，<char style="pn">以色列</char>人也離開那裡，各歸自己的支派和家族，各回自己的繼業去了。<verse eid="JDG 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 21:25" />在那些日子，<char style="pn">以色列</char>沒有王，各人做自己眼中看為正的事。<verse eid="JDG 21:25" /></para>
  <chapter eid="JDG 21" />
</usx>