<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">俄巴底亞書</para>
  <para style="mt">俄巴底亞書</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />
    <char style="pn">俄巴底亞</char>的異象<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">異象——或譯作「啟示」。</char></note>。</para>
  <para style="s" vid="OBA 1:1">以東必遭審判</para>
  <para style="p" vid="OBA 1:1">我們從耶和華聽見了消息，有一位信使被派到列國中，說：「起來！讓我們起來與<char style="pn">以東</char>作戰。」</para>
  <para style="p" vid="OBA 1:1">主耶和華論到<char style="pn">以東</char>如此說：<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />看哪，我要使你成為列國中最小的，</para>
  <para style="q1" vid="OBA 1:2">你必被極度藐視。<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />
    <char style="pn">以東</char>啊<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">以東啊——輔助詞語。</char></note>，你安居在山岩縫隙中，</para>
  <para style="q1" vid="OBA 1:3">穩坐在高峰上，</para>
  <para style="q1" vid="OBA 1:3">你心中的狂傲蒙蔽了你，</para>
  <para style="q1" vid="OBA 1:3">你心裡說：</para>
  <para style="q1" vid="OBA 1:3">「誰能把我拽落到地上呢？」<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />即使你如鷹在高處飛翔，</para>
  <para style="q1" vid="OBA 1:4">即使你在星辰之間搭窩，</para>
  <para style="q1" vid="OBA 1:4">我也要把你從那裡拽落下來。</para>
  <para style="q1" vid="OBA 1:4">這是耶和華的宣告。<verse eid="OBA 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />如果盜賊來到你那裡，</para>
  <para style="q1" vid="OBA 1:5">如果強盜夜間來到，</para>
  <para style="q1" vid="OBA 1:5">他們豈不是任意偷竊嗎？</para>
  <para style="q1" vid="OBA 1:5">如果摘葡萄的來到你那裡，</para>
  <para style="q1" vid="OBA 1:5">他們豈不是只留下遺落的葡萄嗎？</para>
  <para style="q1" vid="OBA 1:5">唉，你將怎樣被摧毀啊！<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />
    <char style="pn">以掃</char>將怎樣被搜刮一空，</para>
  <para style="q1" vid="OBA 1:6">他藏匿的財物將怎樣被搜出！<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />與你立約的盟友，</para>
  <para style="q1" vid="OBA 1:7">都將把你趕出境外；</para>
  <para style="q1" vid="OBA 1:7">與你和平相處的人，</para>
  <para style="q1" vid="OBA 1:7">將欺哄你，征服你；</para>
  <para style="q1" vid="OBA 1:7">與你同席吃飯的人，</para>
  <para style="q1" vid="OBA 1:7">將在你腳下布設網羅。</para>
  <para style="q1" vid="OBA 1:7">你在這些事上毫無聰明！<verse eid="OBA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />到那日，</para>
  <para style="q1" vid="OBA 1:8">我難道不會從<char style="pn">以東</char>消滅智慧人，</para>
  <para style="q1" vid="OBA 1:8">從<char style="pn">以掃</char>山地消滅聰明人嗎？</para>
  <para style="q1" vid="OBA 1:8">這是耶和華的宣告。<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />
    <char style="pn">提幔</char>哪，你的勇士們必喪膽，</para>
  <para style="q1" vid="OBA 1:9">以致<char style="pn">以掃</char>山地的人都被屠殺剪除。<verse eid="OBA 1:9" /></para>
  <para style="b" />
  <para style="s">以東對猶大的罪行</para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />因為你惡待你的兄弟<char style="pn">雅各</char>，</para>
  <para style="q1" vid="OBA 1:10">你必被羞恥淹沒，永遠被剪除。<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />當外族人擄走<char style="pn">雅各</char>的財富，</para>
  <para style="q1" vid="OBA 1:11">當外邦人闖入<char style="pn">雅各</char>的眾城門，</para>
  <para style="q1" vid="OBA 1:11">又為<char style="pn">耶路撒冷</char>抽籤的時候，</para>
  <para style="q1" vid="OBA 1:11">那日你卻站在一旁，</para>
  <para style="q1" vid="OBA 1:11">你甚至像他們中的一員。<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />在你兄弟遭災禍的日子，</para>
  <para style="q1" vid="OBA 1:12">你不該漠然觀望；</para>
  <para style="q1" vid="OBA 1:12">在<char style="pn">猶大</char>子孫滅亡的日子，</para>
  <para style="q1" vid="OBA 1:12">你不該幸災樂禍；</para>
  <para style="q1" vid="OBA 1:12">在那患難的日子，</para>
  <para style="q1" vid="OBA 1:12">你不該誇口自高；<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />在我子民遭難的日子，</para>
  <para style="q1" vid="OBA 1:13">你不該闖入他們的城門；</para>
  <para style="q1" vid="OBA 1:13">在他們遭難的日子，</para>
  <para style="q1" vid="OBA 1:13">你也不該漠然觀望他們的禍患；</para>
  <para style="q1" vid="OBA 1:13">在他們遭難的日子，</para>
  <para style="q1" vid="OBA 1:13">你不該伸手搶他們的財富；<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />在那患難的日子，</para>
  <para style="q1" vid="OBA 1:14">你不該站在岔路口</para>
  <para style="q1" vid="OBA 1:14">剪除他們逃脫的人，</para>
  <para style="q1" vid="OBA 1:14">不該把他們的倖存者交出去。<verse eid="OBA 1:14" /></para>
  <para style="b" />
  <para style="s">主審判萬國的日子</para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />耶和華的日子臨近萬國了，</para>
  <para style="q1" vid="OBA 1:15">他必照著你所行的對待你，</para>
  <para style="q1" vid="OBA 1:15">你的報應將歸到你頭上。<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />
    <char style="pn">猶大</char>人在我的聖山上</para>
  <para style="q1" vid="OBA 1:16">怎樣喝了苦杯<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">苦杯——輔助詞語。</char></note>，</para>
  <para style="q1" vid="OBA 1:16">萬國也將照樣不停地喝；</para>
  <para style="q1" vid="OBA 1:16">他們邊喝邊吞嚥，</para>
  <para style="q1" vid="OBA 1:16">醉得像是不曾存在。<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />但在<char style="pn">錫安</char>山上必有倖存者，</para>
  <para style="q1" vid="OBA 1:17">那山將成為聖地；</para>
  <para style="q1" vid="OBA 1:17">
    <char style="pn">雅各</char>家必得回自己的產業。<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />
    <char style="pn">雅各</char>家將成為烈火，</para>
  <para style="q1" vid="OBA 1:18">
    <char style="pn">約瑟</char>家將成為火焰；</para>
  <para style="q1" vid="OBA 1:18">
    <char style="pn">以掃</char>家卻將成為麥稭，</para>
  <para style="q1" vid="OBA 1:18">被點燃，被吞噬，</para>
  <para style="q1" vid="OBA 1:18">
    <char style="pn">以掃</char>家必沒有一人存活。</para>
  <para style="q1" vid="OBA 1:18">這是耶和華說的。<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="s">以色列未來的祝福</para>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />南地<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">南地——音譯作「內蓋夫」；下同。</char></note>的人將擁有<char style="pn">以掃</char>山地，</para>
  <para style="q1" vid="OBA 1:19">丘陵地帶的人將擁有<char style="pn">非利士</char>人之地<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">南地的人將擁有以掃山地，丘陵地帶的人將擁有非利士人之地——或譯作「以色列將擁有南地和以掃山地，丘陵地帶和非利士人之地」。</char></note>；</para>
  <para style="q1" vid="OBA 1:19">他們將擁有</para>
  <para style="q1" vid="OBA 1:19">
    <char style="pn">以法蓮</char>的土地和<char style="pn">撒瑪利亞</char>的土地；</para>
  <para style="q1" vid="OBA 1:19">
    <char style="pn">便雅憫</char>人將擁有<char style="pn">基列</char>地。<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />流亡在<char style="pn">哈臘</char><note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">在哈臘——或譯作「隊伍」；參《列王紀下》17:6。</char></note>的<char style="pn">以色列</char>子孫，</para>
  <para style="q1" vid="OBA 1:20">將擁有<char style="pn">迦南</char>人<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">迦南人——這裡特指腓尼基人。</char></note>之地，直到<char style="pn">撒勒法</char>；</para>
  <para style="q1" vid="OBA 1:20">流亡在<char style="pn">西法拉</char>的<char style="pn">耶路撒冷</char>人，</para>
  <para style="q1" vid="OBA 1:20">將擁有南地的城鎮。<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />得救的人<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">得救的人——或譯作「那些拯救者」。</char></note>將登上<char style="pn">錫安</char>山，</para>
  <para style="q1" vid="OBA 1:21">治理<char style="pn">以掃</char>山地；</para>
  <para style="q1" vid="OBA 1:21">國度將歸於耶和華。<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>