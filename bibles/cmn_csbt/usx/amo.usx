<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">阿摩司書</para>
  <para style="mt">阿摩司書</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />
    <char style="pn">提克亞</char>的一位牧人<char style="pn">阿摩司</char>的異象。在<char style="pn">猶大</char>王<char style="pn">烏西雅</char>年間、<char style="pn">約阿施</char>的兒子<char style="pn">以色列</char>王<char style="pn">耶羅波安</char>年間，就是大地震的前兩年，他見了有關<char style="pn">以色列</char>的異象。 <verse eid="AMO 1:1" /><verse number="2" style="v" sid="AMO 1:2" />他說：</para>
  <para style="q1" vid="AMO 1:2">耶和華從<char style="pn">錫安</char>吼叫，</para>
  <para style="q1" vid="AMO 1:2">從<char style="pn">耶路撒冷</char>發聲，</para>
  <para style="q1" vid="AMO 1:2">牧人們的草場就荒蕪，</para>
  <para style="q1" vid="AMO 1:2">
    <char style="pn">迦密</char>山頂也枯乾。<verse eid="AMO 1:2" /></para>
  <para style="s">審判以色列的鄰邦</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />耶和華如此說：</para>
  <para style="q1" vid="AMO 1:3">因<char style="pn">大馬士革</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 1:3">因他們用鐵碾滾軋<char style="pn">基列</char>，</para>
  <para style="q1" vid="AMO 1:3">我絕不撤回對它的審判<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">審判——輔助詞語；本章下同。</char></note>。<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />我要降火在<char style="pn">哈薛</char>的宮殿，</para>
  <para style="q1" vid="AMO 1:4">使火吞噬<char style="pn">本哈達</char>的城堡。<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />我要打斷<char style="pn">大馬士革</char>的門閂，</para>
  <para style="q1" vid="AMO 1:5">剪除<char style="pn">亞文</char>平原<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">亞文平原——意思是「邪惡平原」。</char></note>的居民<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">居民——或譯作「統治者」；本章下同。</char></note>，</para>
  <para style="q1" vid="AMO 1:5">剪除<char style="pn">伯伊甸</char><note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">伯伊甸——意思是「快樂之家」。</char></note>的掌權者，</para>
  <para style="q1" vid="AMO 1:5">
    <char style="pn">亞蘭</char>的民眾必被擄到<char style="pn">吉珥</char>。</para>
  <para style="q1" vid="AMO 1:5">這是耶和華說的。<verse eid="AMO 1:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />耶和華如此說：</para>
  <para style="q1" vid="AMO 1:6">因<char style="pn">加沙</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 1:6">因他們擄走全體擄民，</para>
  <para style="q1" vid="AMO 1:6">交給<char style="pn">以東</char>，</para>
  <para style="q1" vid="AMO 1:6">我絕不撤回對它的審判。<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />我要降火在<char style="pn">加沙</char>的城牆上，</para>
  <para style="q1" vid="AMO 1:7">使火吞噬它的城堡。<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />我要剪除<char style="pn">阿實突</char>的居民，</para>
  <para style="q1" vid="AMO 1:8">剪除<char style="pn">阿實基倫</char>的掌權者。</para>
  <para style="q1" vid="AMO 1:8">我要轉手對付<char style="pn">以革倫</char>，</para>
  <para style="q1" vid="AMO 1:8">
    <char style="pn">非利士</char>餘剩之民必滅亡。</para>
  <para style="q1" vid="AMO 1:8">這是主耶和華說的。<verse eid="AMO 1:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />耶和華如此說：</para>
  <para style="q1" vid="AMO 1:9">因<char style="pn">提爾</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 1:9">因他們不顧念兄弟盟約，</para>
  <para style="q1" vid="AMO 1:9">而把全體擄民交給<char style="pn">以東</char>，</para>
  <para style="q1" vid="AMO 1:9">我絕不撤回對它的審判。<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />我要降火在<char style="pn">提爾</char>的城牆上，</para>
  <para style="q1" vid="AMO 1:10">使火吞噬它的城堡。<verse eid="AMO 1:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />耶和華如此說：</para>
  <para style="q1" vid="AMO 1:11">因<char style="pn">以東</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 1:11">因他拿刀劍追趕兄弟，</para>
  <para style="q1" vid="AMO 1:11">泯滅了憐憫之心，</para>
  <para style="q1" vid="AMO 1:11">因他的怒氣長久發作，</para>
  <para style="q1" vid="AMO 1:11">他的盛怒持續不停，</para>
  <para style="q1" vid="AMO 1:11">我絕不撤回對它的審判。<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />我要降火在<char style="pn">提幔</char>，</para>
  <para style="q1" vid="AMO 1:12">使火吞噬<char style="pn">伯斯拉</char>的城堡。<verse eid="AMO 1:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />耶和華如此說：</para>
  <para style="q1" vid="AMO 1:13">因<char style="pn">亞捫</char>人三番四次地犯罪，</para>
  <para style="q1" vid="AMO 1:13">因他們為了擴張地界</para>
  <para style="q1" vid="AMO 1:13">而剖開<char style="pn">基列</char>的孕婦，</para>
  <para style="q1" vid="AMO 1:13">我絕不撤回對它的審判。<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />我要在爭戰之日的吶喊中，</para>
  <para style="q1" vid="AMO 1:14">在旋風之日的狂風中，</para>
  <para style="q1" vid="AMO 1:14">點火焚燒<char style="pn">拉巴</char>的城牆，</para>
  <para style="q1" vid="AMO 1:14">使火吞噬它的城堡。<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />他們的王必被擄去，</para>
  <para style="q1" vid="AMO 1:15">王和他的首領都將被擄。</para>
  <para style="q1" vid="AMO 1:15">這是耶和華說的。<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="nb">
    <verse number="1" style="v" sid="AMO 2:1" />耶和華如此說：</para>
  <para style="q1" vid="AMO 2:1">因<char style="pn">摩押</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 2:1">因他把<char style="pn">以東</char>王的骨頭焚燒成灰，</para>
  <para style="q1" vid="AMO 2:1">我絕不撤回對它的審判<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">審判——輔助詞語；本章下同。</char></note>。<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />我要降火在<char style="pn">摩押</char>，</para>
  <para style="q1" vid="AMO 2:2">使火吞噬<char style="pn">加略</char>的城堡，</para>
  <para style="q1" vid="AMO 2:2">
    <char style="pn">摩押</char>必在喧嚷、吶喊</para>
  <para style="q1" vid="AMO 2:2">和號角聲中死去。<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />我要剪除它當中的審判官，</para>
  <para style="q1" vid="AMO 2:3">連同它的首領全都殺死。</para>
  <para style="q1" vid="AMO 2:3">這是耶和華說的。<verse eid="AMO 2:3" /></para>
  <para style="s">審判猶大</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />耶和華如此說：</para>
  <para style="q1" vid="AMO 2:4">因<char style="pn">猶大</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 2:4">因他們厭棄耶和華的訓誨，</para>
  <para style="q1" vid="AMO 2:4">不遵守他的律例，</para>
  <para style="q1" vid="AMO 2:4">因他們祖先所隨從的假神<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">假神——或譯作「虛謊」。</char></note></para>
  <para style="q1" vid="AMO 2:4">使他們迷失，</para>
  <para style="q1" vid="AMO 2:4">我絕不撤回對它的審判。<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />我要降火在<char style="pn">猶大</char>，</para>
  <para style="q1" vid="AMO 2:5">使火吞噬<char style="pn">耶路撒冷</char>的城堡。<verse eid="AMO 2:5" /></para>
  <para style="s">審判以色列</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />耶和華如此說：</para>
  <para style="q1" vid="AMO 2:6">因<char style="pn">以色列</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 2:6">因他們把義人賣了獲得銀子，</para>
  <para style="q1" vid="AMO 2:6">把窮人賣了換取鞋子，</para>
  <para style="q1" vid="AMO 2:6">我絕不撤回對它的審判。<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />他們把貧弱者的頭踩在塵土中，</para>
  <para style="q1" vid="AMO 2:7">屈枉卑微人的義行。</para>
  <para style="q1" vid="AMO 2:7">兒子和父親與同一個女子行淫，</para>
  <para style="q1" vid="AMO 2:7">以致我的聖名被褻瀆。<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />他們在各祭壇旁</para>
  <para style="q1" vid="AMO 2:8">躺臥在作抵押的衣服上，</para>
  <para style="q1" vid="AMO 2:8">在他們神的殿中喝沒收<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">沒收——原文直譯「處罰」。</char></note>所得的酒。<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />是我把<char style="pn">亞摩利</char>人</para>
  <para style="q1" vid="AMO 2:9">從他們面前除滅了；</para>
  <para style="q1" vid="AMO 2:9">
    <char style="pn">亞摩利</char>人高如香柏樹、壯如橡樹，</para>
  <para style="q1" vid="AMO 2:9">我卻把這樹連同上面的果實、</para>
  <para style="q1" vid="AMO 2:9">下面的根都除滅了。<verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />是我把你們從<char style="pn">埃及</char>地帶了上來，</para>
  <para style="q1" vid="AMO 2:10">在曠野中引領你們四十年，</para>
  <para style="q1" vid="AMO 2:10">去占有<char style="pn">亞摩利</char>人之地。<verse eid="AMO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />是我從你們的子孫中</para>
  <para style="q1" vid="AMO 2:11">興起一些人作先知，</para>
  <para style="q1" vid="AMO 2:11">從你們的年輕人中</para>
  <para style="q1" vid="AMO 2:11">興起一些人作拿細耳人。</para>
  <para style="q1" vid="AMO 2:11">
    <char style="pn">以色列</char>人哪，難道不正是這樣嗎？</para>
  <para style="q1" vid="AMO 2:11">這是耶和華的宣告。<verse eid="AMO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />你們卻使拿細耳人喝酒，</para>
  <para style="q1" vid="AMO 2:12">又吩咐先知說：</para>
  <para style="q1" vid="AMO 2:12">「不要說神言。」<verse eid="AMO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />看哪，我要重壓你們，</para>
  <para style="q1" vid="AMO 2:13">像滿載的車子上壓緊了禾捆那樣。<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />跑得快的無處避難，</para>
  <para style="q1" vid="AMO 2:14">強壯的用不上力，</para>
  <para style="q1" vid="AMO 2:14">勇猛的不能救自己的性命。<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />拿弓的站立不住，</para>
  <para style="q1" vid="AMO 2:15">腳步飛快的不能逃脫，</para>
  <para style="q1" vid="AMO 2:15">騎馬的也不能救自己的性命。<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />到那日，勇士中最有膽量的</para>
  <para style="q1" vid="AMO 2:16">也將丟盔棄甲<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">丟盔棄甲——原文直譯「赤身」。</char></note>而逃。</para>
  <para style="q1" vid="AMO 2:16">這是耶和華的宣告。<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s">選民以色列受懲罰</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />
    <char style="pn">以色列</char>人哪，你們要聽這話！我耶和華針對你們，針對我從<char style="pn">埃及</char>地帶上來的<char style="pn">以色列</char>全家宣告說：<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />地上萬族中，我只揀選了<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">揀選了——原文直譯「認識」。</char></note>你們，</para>
  <para style="q1" vid="AMO 3:2">因此我要因你們的一切罪孽懲罰你們。<verse eid="AMO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />二人若不同心<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">同心——或譯作「會合」。</char></note>，豈能同行？<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />獅子沒有獵物，</para>
  <para style="q1" vid="AMO 3:4">怎會在森林中吼叫呢？</para>
  <para style="q1" vid="AMO 3:4">少壯獅子若無捕獲，</para>
  <para style="q1" vid="AMO 3:4">怎會從洞中發出吼聲呢？<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />沒有誘餌，</para>
  <para style="q1" vid="AMO 3:5">雀鳥怎會落入地上的網羅呢？</para>
  <para style="q1" vid="AMO 3:5">什麼都沒有捉住，</para>
  <para style="q1" vid="AMO 3:5">網羅怎會從地上彈起來呢？<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />城中若吹響號角，</para>
  <para style="q1" vid="AMO 3:6">民眾會不戰兢嗎？</para>
  <para style="q1" vid="AMO 3:6">城中若有災禍臨到，</para>
  <para style="q1" vid="AMO 3:6">難道不是耶和華所降的嗎？<verse eid="AMO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />若不先把奧祕啟示給僕人眾先知，</para>
  <para style="q1" vid="AMO 3:7">主耶和華就不會做什麼。<verse eid="AMO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />獅子吼叫，誰不害怕呢？</para>
  <para style="q1" vid="AMO 3:8">主耶和華發了話，誰不說神言呢？<verse eid="AMO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />要向<char style="pn">阿實突</char>的城堡</para>
  <para style="q1" vid="AMO 3:9">和<char style="pn">埃及</char>地的城堡傳告說：</para>
  <para style="q1" vid="AMO 3:9">「你們聚集到<char style="pn">撒瑪利亞</char>的山上，</para>
  <para style="q1" vid="AMO 3:9">看看城中的許多騷亂</para>
  <para style="q1" vid="AMO 3:9">和城中的欺壓吧！」<verse eid="AMO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />那些人在城堡裡積蓄惡行和迫害，</para>
  <para style="q1" vid="AMO 3:10">不知道去做正直的事。</para>
  <para style="q1" vid="AMO 3:10">這是耶和華的宣告。<verse eid="AMO 3:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11" />因此主耶和華如此說：</para>
  <para style="q1" vid="AMO 3:11">敵人必圍攻這地，</para>
  <para style="q1" vid="AMO 3:11">推倒你的堡壘<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">推倒你的堡壘——或譯作「使你的力量削弱」。</char></note>，</para>
  <para style="q1" vid="AMO 3:11">你的城堡將被掠奪。<verse eid="AMO 3:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />耶和華如此說：</para>
  <para style="q1" vid="AMO 3:12">牧人怎樣從獅子口中搶救出兩條腿，</para>
  <para style="q1" vid="AMO 3:12">或是一小塊耳朵，</para>
  <para style="q1" vid="AMO 3:12">住在<char style="pn">撒瑪利亞</char>的<char style="pn">以色列</char>人也將如此，</para>
  <para style="q1" vid="AMO 3:12">被搶救出的只是床榻的一角、床鋪的一邊。<verse eid="AMO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 3:13" />你們要聽，要警誡<char style="pn">雅各</char>家！</para>
  <para style="q1" vid="AMO 3:13">這是主耶和華萬軍之神的宣告。<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />在我懲罰<char style="pn">以色列</char>過犯的日子裡，</para>
  <para style="q1" vid="AMO 3:14">我必摧毀<char style="pn">伯特利</char>的祭壇，</para>
  <para style="q1" vid="AMO 3:14">祭壇的犄角將被砍斷，</para>
  <para style="q1" vid="AMO 3:14">掉落在地。<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />我要摧毀冬宮與夏宮，</para>
  <para style="q1" vid="AMO 3:15">象牙裝飾的房屋將消亡，</para>
  <para style="q1" vid="AMO 3:15">高大的樓房將化為烏有。</para>
  <para style="q1" vid="AMO 3:15">這是耶和華的宣告。<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s">社會和屬靈的敗壞</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />在<char style="pn">撒瑪利亞</char>山上的<char style="pn">巴珊</char>母牛啊，</para>
  <para style="q1" vid="AMO 4:1">你們要聽這話！</para>
  <para style="q1" vid="AMO 4:1">你們欺壓貧弱者，</para>
  <para style="q1" vid="AMO 4:1">壓迫窮人；</para>
  <para style="q1" vid="AMO 4:1">你們對丈夫<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">丈夫——原文直譯「主人」。</char></note>說：</para>
  <para style="q1" vid="AMO 4:1">「拿酒來，讓我們喝。」<verse eid="AMO 4:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="AMO 4:2" />主耶和華指著自己的神聖起誓：</para>
  <para style="q1" vid="AMO 4:2">「看哪，日子將臨到你們，</para>
  <para style="q1" vid="AMO 4:2">人必用鉤子把你們鉤去，</para>
  <para style="q1" vid="AMO 4:2">連你們最後一個也用魚鉤鉤去。<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />你們將各自從面前的城牆破口出去，</para>
  <para style="q1" vid="AMO 4:3">被押送到<char style="pn">哈爾蒙</char>。</para>
  <para style="q1" vid="AMO 4:3">這是耶和華的宣告。<verse eid="AMO 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />只管來<char style="pn">伯特利</char>悖逆，</para>
  <para style="q1" vid="AMO 4:4">來<char style="pn">吉甲</char>增添悖逆吧！</para>
  <para style="q1" vid="AMO 4:4">每早晨獻上你們的祭物，</para>
  <para style="q1" vid="AMO 4:4">每三天獻上你們的十分之一吧！<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />只管燒獻有酵的感謝祭，</para>
  <para style="q1" vid="AMO 4:5">宣告、傳揚你們的甘心祭吧！</para>
  <para style="q1" vid="AMO 4:5">
    <char style="pn">以色列</char>子孫哪，你們實在喜愛這樣做。</para>
  <para style="q1" vid="AMO 4:5">這是主耶和華的宣告。<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="s">主的管教與以色列的悖逆</para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />因此我使你們在所有的城中</para>
  <para style="q1" vid="AMO 4:6">都齒間乾淨，</para>
  <para style="q1" vid="AMO 4:6">在你們所有的地方都缺乏糧食，</para>
  <para style="q1" vid="AMO 4:6">然而你們仍不回轉歸向我。</para>
  <para style="q1" vid="AMO 4:6">這是耶和華的宣告。<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />而且我在收割前三個月不給你們降雨，</para>
  <para style="q1" vid="AMO 4:7">我在一個城市降雨，</para>
  <para style="q1" vid="AMO 4:7">而在另一個城市不降雨；</para>
  <para style="q1" vid="AMO 4:7">一塊田地降雨，</para>
  <para style="q1" vid="AMO 4:7">另一塊田地因沒有降雨而乾枯；<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />兩三個城市的人</para>
  <para style="q1" vid="AMO 4:8">漂泊到一個城市去喝水，</para>
  <para style="q1" vid="AMO 4:8">卻不夠喝；</para>
  <para style="q1" vid="AMO 4:8">然而你們仍不回轉歸向我。</para>
  <para style="q1" vid="AMO 4:8">這是耶和華的宣告。<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />我用枯焦和霉爛打擊你們，</para>
  <para style="q1" vid="AMO 4:9">你們的果園、葡萄園、</para>
  <para style="q1" vid="AMO 4:9">無花果樹和橄欖園大量<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">大量——或譯作「許多次」。</char></note>被飛蝗吞吃。</para>
  <para style="q1" vid="AMO 4:9">然而，你們仍不回轉歸向我。</para>
  <para style="q1" vid="AMO 4:9">這是耶和華的宣告。<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />我照著從前在<char style="pn">埃及</char>所行的，</para>
  <para style="q1" vid="AMO 4:10">降瘟疫到你們中間；</para>
  <para style="q1" vid="AMO 4:10">我用刀劍殺戮你們的青年人，</para>
  <para style="q1" vid="AMO 4:10">擄去你們的馬匹；</para>
  <para style="q1" vid="AMO 4:10">我使你們營地的臭氣上騰，</para>
  <para style="q1" vid="AMO 4:10">進入你們的鼻孔。</para>
  <para style="q1" vid="AMO 4:10">然而，你們仍不回轉歸向我。</para>
  <para style="q1" vid="AMO 4:10">這是耶和華的宣告。<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />我傾覆你們，</para>
  <para style="q1" vid="AMO 4:11">就像神從前覆滅<char style="pn">所多瑪</char>和<char style="pn">格摩拉</char>那樣；</para>
  <para style="q1" vid="AMO 4:11">你們像是從大火中搶救出的一根柴。</para>
  <para style="q1" vid="AMO 4:11">然而，你們仍不回轉歸向我。</para>
  <para style="q1" vid="AMO 4:11">這是耶和華的宣告。<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />因此，<char style="pn">以色列</char>啊，</para>
  <para style="q1" vid="AMO 4:12">我必這樣處置你。</para>
  <para style="q1" vid="AMO 4:12">因我要對你做這些事，</para>
  <para style="q1" vid="AMO 4:12">
    <char style="pn">以色列</char>啊，預備好迎見你的神吧！<verse eid="AMO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />看哪，</para>
  <para style="q1" vid="AMO 4:13">是他塑造群山、創造了風，</para>
  <para style="q1" vid="AMO 4:13">向人類宣告他的心意；</para>
  <para style="q1" vid="AMO 4:13">他使晨光變為漆黑，</para>
  <para style="q1" vid="AMO 4:13">踏行大地的高處；</para>
  <para style="q1" vid="AMO 4:13">萬軍之神耶和華是他的名。<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">哀悼以色列家</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />
    <char style="pn">以色列</char>家啊，你們要聽這話，這是我為你們作的一首哀歌：<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />少女<char style="pn">以色列</char>仆倒了，</para>
  <para style="q1" vid="AMO 5:2">再也不會起來！</para>
  <para style="q1" vid="AMO 5:2">她被撇棄在地上，</para>
  <para style="q1" vid="AMO 5:2">沒有人扶起她。<verse eid="AMO 5:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />是的，主耶和華如此說：</para>
  <para style="q1" vid="AMO 5:3">
    <char style="pn">以色列</char>家的城鎮，</para>
  <para style="q1" vid="AMO 5:3">一千人出戰只會剩下一百，</para>
  <para style="q1" vid="AMO 5:3">一百人出戰只會剩下十個。<verse eid="AMO 5:3" /></para>
  <para style="s">當求問主而存活</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />是的，主耶和華對<char style="pn">以色列</char>家如此說：</para>
  <para style="q1" vid="AMO 5:4">你們當求問我，使你們存活！<verse eid="AMO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 5:5" />不要到<char style="pn">伯特利</char>求問，</para>
  <para style="q1" vid="AMO 5:5">不要去<char style="pn">吉甲</char>，</para>
  <para style="q1" vid="AMO 5:5">不要前往<char style="pn">比爾-謝巴</char>，</para>
  <para style="q1" vid="AMO 5:5">因為<char style="pn">吉甲</char>人必被擄走，</para>
  <para style="q1" vid="AMO 5:5">
    <char style="pn">伯特利</char>將歸於無有。<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />你們當求問耶和華，使你們存活，</para>
  <para style="q1" vid="AMO 5:6">免得他如火衝入<char style="pn">約瑟</char>家，吞噬一切，</para>
  <para style="q1" vid="AMO 5:6">無人能為<char style="pn">伯特利</char>撲滅。<verse eid="AMO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />因為你們把公正變為苦艾，</para>
  <para style="q1" vid="AMO 5:7">把公義丟棄於地！<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />他創造了昴星和參星，</para>
  <para style="q1" vid="AMO 5:8">他使死蔭變為晨光，</para>
  <para style="q1" vid="AMO 5:8">使白天變為黑夜，</para>
  <para style="q1" vid="AMO 5:8">他召喚海水，把它們傾倒在地面上，</para>
  <para style="q1" vid="AMO 5:8">耶和華是他的名。<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />他使毀滅忽然臨到強者，</para>
  <para style="q1" vid="AMO 5:9">使毀滅臨到堡壘。<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />你們<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">你們——原文作「他們」。</char></note>恨惡在城門口主持公道的人，</para>
  <para style="q1" vid="AMO 5:10">厭惡說話真誠的人。<verse eid="AMO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />所以，因你們欺壓貧弱者，</para>
  <para style="q1" vid="AMO 5:11">向他強收糧食為稅捐，</para>
  <para style="q1" vid="AMO 5:11">你們將建造石砌的房屋卻不得住在其中，</para>
  <para style="q1" vid="AMO 5:11">栽種美好的葡萄園卻喝不到所出的酒。<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />我確實知道你們的過犯眾多，</para>
  <para style="q1" vid="AMO 5:12">你們的罪惡無數。</para>
  <para style="q1" vid="AMO 5:12">你們苦害義人，收取賄賂，</para>
  <para style="q1" vid="AMO 5:12">你們在城門口屈枉貧窮人。<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />因此明達人那時靜默不語，</para>
  <para style="q1" vid="AMO 5:13">因為這是邪惡的時期。<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />你們要尋求善，不要尋求惡，</para>
  <para style="q1" vid="AMO 5:14">好使你們存活；</para>
  <para style="q1" vid="AMO 5:14">這樣耶和華萬軍之神就會與你們同在，</para>
  <para style="q1" vid="AMO 5:14">正如你們所說的。<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />你們要憎恨惡事，喜愛美善，</para>
  <para style="q1" vid="AMO 5:15">在城門口確立公正，</para>
  <para style="q1" vid="AMO 5:15">或許耶和華萬軍之神</para>
  <para style="q1" vid="AMO 5:15">會恩待<char style="pn">約瑟</char>的餘剩之民。<verse eid="AMO 5:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />因此主耶和華萬軍之神如此說：</para>
  <para style="q1" vid="AMO 5:16">所有的廣場上都會有哀號，</para>
  <para style="q1" vid="AMO 5:16">所有的街道上人們都會說：</para>
  <para style="q1" vid="AMO 5:16">「哀哉！哀哉！」</para>
  <para style="q1" vid="AMO 5:16">他們還召農夫來哀悼，</para>
  <para style="q1" vid="AMO 5:16">請擅長舉哀的人來哀號。<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />所有的葡萄園中也將有哀號，</para>
  <para style="q1" vid="AMO 5:17">因為我要從你們當中經過。</para>
  <para style="q1" vid="AMO 5:17">這是耶和華說的。<verse eid="AMO 5:17" /></para>
  <para style="b" />
  <para style="s">主的日子</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />盼望耶和華的日子的人有禍了！</para>
  <para style="q1" vid="AMO 5:18">你們為什麼盼望耶和華的日子呢？</para>
  <para style="q1" vid="AMO 5:18">那是黑暗無光的日子，<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />就像人逃離了獅子又遇見熊，</para>
  <para style="q1" vid="AMO 5:19">回到家中手一扶牆，又被蛇咬。<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />難道不是嗎？</para>
  <para style="q1" vid="AMO 5:20">耶和華的日子黑暗無光，</para>
  <para style="q1" vid="AMO 5:20">幽暗沒有亮光。<verse eid="AMO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />我恨惡、厭棄你們的節期，</para>
  <para style="q1" vid="AMO 5:21">也不悅納你們的嚴肅集會。<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />即使你們向我獻上燔祭和素祭，</para>
  <para style="q1" vid="AMO 5:22">我也不悅納；</para>
  <para style="q1" vid="AMO 5:22">你們獻上肥畜為平安祭，我也不垂顧。<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />讓你們歌唱的喧囂遠離我吧！</para>
  <para style="q1" vid="AMO 5:23">你們里拉琴的樂曲，我也不願聽。<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />唯願公正如大水滔滔，</para>
  <para style="q1" vid="AMO 5:24">公義如溪水常流。<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />
    <char style="pn">以色列</char>家啊，你們在曠野四十年，何曾向我獻過祭物和供物？ <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />你們抬著<char style="pn">摩洛</char>的帳幕<note caller="+" style="f"><char style="fr" closed="false">5:26 </char><char style="ft" closed="false">摩洛的帳幕——依據七十士譯本；或譯作「你們的王撒古特」。</char></note>和你們的星神<char style="pn">迦溫</char>的雕像，就是你們為自己造的那些偶像。 <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />因此，我必把你們遷徙到<char style="pn">大馬士革</char>以外。這是耶和華說的，萬軍之神是他的名。<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">安逸的人有禍了</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />有禍了！</para>
  <para style="q1" vid="AMO 6:1">你們這些在<char style="pn">錫安</char>驕奢安逸的人，</para>
  <para style="q1" vid="AMO 6:1">在<char style="pn">撒瑪利亞</char>山上安然無慮的人，</para>
  <para style="q1" vid="AMO 6:1">以及<char style="pn">以色列</char>家所歸向的列強首領們。<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />你們到<char style="pn">卡勒尼</char>去看看，</para>
  <para style="q1" vid="AMO 6:2">也從那裡往<char style="pn">哈馬</char>大城去，</para>
  <para style="q1" vid="AMO 6:2">再下到<char style="pn">非利士</char>人的<char style="pn">迦特</char>看看：</para>
  <para style="q1" vid="AMO 6:2">你們比那些王國更優越嗎？</para>
  <para style="q1" vid="AMO 6:2">他們的邊界比你們的邊界更寬廣嗎？<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />你們拒絕接受禍患的日子，</para>
  <para style="q1" vid="AMO 6:3">卻使不法的統治<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">統治——原文直譯「座位」。</char></note>近在身邊。<verse eid="AMO 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />你們躺臥象牙床，</para>
  <para style="q1" vid="AMO 6:4">在床鋪上悠然愜意；</para>
  <para style="q1" vid="AMO 6:4">你們享用羊群中的羊羔，</para>
  <para style="q1" vid="AMO 6:4">還有牛圈中的牛犢；<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />你們伴著里拉琴的樂曲歡唱，</para>
  <para style="q1" vid="AMO 6:5">並像<char style="pn">大衛</char>那樣為自己設計各樣樂器；<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />你們大碗喝酒，</para>
  <para style="q1" vid="AMO 6:6">用最好的油抹身，</para>
  <para style="q1" vid="AMO 6:6">毫不為<char style="pn">約瑟</char>的敗亡而憂心。<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />因此，</para>
  <para style="q1" vid="AMO 6:7">現在你們必成為首先被擄走的人，</para>
  <para style="q1" vid="AMO 6:7">悠然愜意的宴樂必消失。<verse eid="AMO 6:7" /></para>
  <para style="s">審判以色列的傲慢</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />主耶和華指著自己起誓，這是萬軍之神耶和華的宣告：</para>
  <para style="q1" vid="AMO 6:8">我厭惡<char style="pn">雅各</char>的傲慢，</para>
  <para style="q1" vid="AMO 6:8">恨惡他的宮殿，</para>
  <para style="q1" vid="AMO 6:8">我必把這城和其中所充滿的</para>
  <para style="q1" vid="AMO 6:8">都交出去。<verse eid="AMO 6:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />那時，就算一處家宅只剩下十個人，他們也要死。 <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />殮葬的親屬把屍體搬起來，從家宅裡抬出去，然後問家宅深處的人：「你那裡還有死人嗎？」</para>
  <para style="p" vid="AMO 6:10">那人說：「沒有。」</para>
  <para style="p" vid="AMO 6:10">又說：「安靜！絕不要提說耶和華的名。」<verse eid="AMO 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />看哪，耶和華即將下令，</para>
  <para style="q1" vid="AMO 6:11">大房屋必被拆散，</para>
  <para style="q1" vid="AMO 6:11">小房屋必被打爛。<verse eid="AMO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />馬會在岩石上奔跑嗎？</para>
  <para style="q1" vid="AMO 6:12">牛會在海中<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">海中——或譯作「岩石上」。</char></note>耕作嗎？</para>
  <para style="q1" vid="AMO 6:12">你們卻把公正變為毒草，</para>
  <para style="q1" vid="AMO 6:12">把公義的果實變為苦艾。<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />你們為<char style="pn">羅迪巴</char>歡呼，說：</para>
  <para style="q1" vid="AMO 6:13">「難道我們不是憑著自己的力量</para>
  <para style="q1" vid="AMO 6:13">奪取了<char style="pn">加寧</char><note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">加寧——意思是「犄角、力量」。</char></note>嗎？」<verse eid="AMO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />看哪，我必興起一國</para>
  <para style="q1" vid="AMO 6:14">攻擊你們<char style="pn">以色列</char>家！</para>
  <para style="q1" vid="AMO 6:14">這是萬軍之神耶和華的宣告。</para>
  <para style="q1" vid="AMO 6:14">他們將壓迫你們，</para>
  <para style="q1" vid="AMO 6:14">從<char style="pn">哈馬</char>隘口直到<char style="pn">亞拉巴</char>流域。<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">第一個異象：蝗蟲</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />主耶和華讓我看到這事：看哪，他塑造了成群的蝗蟲，那時第二茬的莊稼剛剛長出來，是王的莊稼收割之後第二茬的莊稼。 <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />等蝗蟲吃盡地上的植物，我說：「主耶和華啊，求你赦免！<char style="pn">雅各</char>如此弱小，他怎能經受得住<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">經受得住——或譯作「站立得住」；下同。</char></note>呢？」<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />耶和華就為此改變心意，耶和華說：「這事不會發生了。」<verse eid="AMO 7:3" /></para>
  <para style="s">第二個異象：火</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />主耶和華又讓我看到：看哪，主耶和華呼喚火來責罰他們，火就吞噬巨大的深淵，吞噬<char style="pn">雅各</char>的地業。 <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />我說：「主耶和華啊，求你停手！<char style="pn">雅各</char>如此弱小，他怎能經受得住呢？」<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />耶和華就為此改變心意，主耶和華說：「這事也不會發生了。」<verse eid="AMO 7:6" /></para>
  <para style="s">第三個異象：鉛垂線</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />他又讓我看到：看哪，主站在一道吊著鉛垂線的牆上<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">吊著鉛垂線的牆上——或譯作「垂直的牆邊」。</char></note>，手裡拿著鉛垂線。 <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />耶和華對我說：「<char style="pn">阿摩司</char>，你看見了什麼？」</para>
  <para style="p" vid="AMO 7:8">我說：「一根鉛垂線。」</para>
  <para style="p" vid="AMO 7:8">主說：「看哪，我將要把鉛垂線吊在我的子民<char style="pn">以色列</char>當中，我絕不再放過他們。<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />
    <char style="pn">以撒</char>的高壇都將變得荒涼，</para>
  <para style="q1" vid="AMO 7:9">
    <char style="pn">以色列</char>的聖所都將荒廢；</para>
  <para style="q1" vid="AMO 7:9">我必起來用刀劍攻擊<char style="pn">耶羅波安</char>家。」<verse eid="AMO 7:9" /></para>
  <para style="s">亞瑪謝的陷害</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />那時，<char style="pn">伯特利</char>的祭司<char style="pn">亞瑪謝</char>派人到<char style="pn">以色列</char>王<char style="pn">耶羅波安</char>那裡說：「<char style="pn">阿摩司</char>在<char style="pn">以色列</char>家中密謀反叛你，這地不能容忍他的任何話語。 <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />因為<char style="pn">阿摩司</char>如此說：『<char style="pn">耶羅波安</char>將死在刀下，<char style="pn">以色列</char>人必從自己的國土被擄走。』」<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />
    <char style="pn">亞瑪謝</char>對<char style="pn">阿摩司</char>說：「你這先見，走吧，逃到<char style="pn">猶大</char>地去！在那裡找飯吃，在那裡說神言。 <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />不要繼續在<char style="pn">伯特利</char>說神言，因為這裡是王的聖所，是國家宮殿。」<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />
    <char style="pn">阿摩司</char>回應<char style="pn">亞瑪謝</char>說：「我原不是先知，也不是先知的門徒，我本來是牧人，我也看管西克莫無花果樹。 <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />但耶和華揀選我，使我不再牧放羊群，耶和華對我說：『你去，向我的子民<char style="pn">以色列</char>說神言！』<verse eid="AMO 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 7:16" />「現在，你要聽耶和華的話語。你說：</para>
  <para style="q1" vid="AMO 7:16">『不要說神言攻擊<char style="pn">以色列</char>，</para>
  <para style="q1" vid="AMO 7:16">不要傳道攻擊<char style="pn">以撒</char>家。』<verse eid="AMO 7:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />因此耶和華如此說：</para>
  <para style="q1" vid="AMO 7:17">你的妻子將在城中賣淫，</para>
  <para style="q1" vid="AMO 7:17">你的兒女必倒在刀下，</para>
  <para style="q1" vid="AMO 7:17">你的土地將被人用量繩瓜分，</para>
  <para style="q1" vid="AMO 7:17">你必死在不潔淨之地，</para>
  <para style="q1" vid="AMO 7:17">
    <char style="pn">以色列</char>人必從自己的國土被擄走。」<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">第四個異象：一筐夏天的果實</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />主耶和華又讓我看到：看哪，有一筐夏天的果實。 <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />他說：「<char style="pn">阿摩司</char>，你看見了什麼？」</para>
  <para style="p" vid="AMO 8:2">我說：「一筐夏天的果實。」</para>
  <para style="p" vid="AMO 8:2">耶和華對我說：「結局臨到了我的子民<char style="pn">以色列</char>，我絕不再放過他們。」<verse eid="AMO 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3" />到那日，聖殿的歌聲必變為哀號<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">聖殿的歌聲必變為哀號——或譯作「宮中的歌女必唱哀歌」。</char></note>。這是主耶和華的宣告。將有許多屍體被拋棄在各處，一片死寂。<verse eid="AMO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />你們這些人，</para>
  <para style="q1" vid="AMO 8:4">踐踏窮人、驅除地上的困苦人，</para>
  <para style="q1" vid="AMO 8:4">你們要聽這話！<verse eid="AMO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 8:5" />你們說：</para>
  <para style="q1" vid="AMO 8:5">「新月節什麼時候過去，我們好賣糧；</para>
  <para style="q1" vid="AMO 8:5">安息日什麼時候過去，我們好開倉買糧。</para>
  <para style="q1" vid="AMO 8:5">我們要縮小量斗<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">量斗——原文直譯「伊法」；相當於22公升的穀物量器。</char></note>，加重秤砣<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">秤砣——原文直譯「謝克爾」，是重量單位；後來成為貨幣單位。1謝克爾=11.4公克。</char></note>，</para>
  <para style="q1" vid="AMO 8:5">用欺詐的天平欺騙人。<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />我們要用銀子買來貧弱者，</para>
  <para style="q1" vid="AMO 8:6">用一雙鞋子換取貧窮人，</para>
  <para style="q1" vid="AMO 8:6">把摻雜的糧食賣出去。」<verse eid="AMO 8:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />耶和華指著<char style="pn">雅各</char>的傲慢起誓說：</para>
  <para style="q1" vid="AMO 8:7">我永不忘記他們所做的一切！<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />大地豈不因這些事而顫抖嗎？</para>
  <para style="q1" vid="AMO 8:8">其上所有的居民都將悲慟，</para>
  <para style="q1" vid="AMO 8:8">全地都像<char style="pn">尼羅</char>河那樣上漲，</para>
  <para style="q1" vid="AMO 8:8">又像<char style="pn">埃及</char>的<char style="pn">尼羅</char>河那樣翻湧、下沉。<verse eid="AMO 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 8:9" />這是主耶和華的宣告：</para>
  <para style="q1" vid="AMO 8:9">到那日，</para>
  <para style="q1" vid="AMO 8:9">我要使太陽在正午落下，</para>
  <para style="q1" vid="AMO 8:9">使大地在白天變為黑暗。<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />我要把你們的節期變為哀悼，</para>
  <para style="q1" vid="AMO 8:10">把你們的歌聲都變為哀歌，</para>
  <para style="q1" vid="AMO 8:10">使所有的人腰束麻布，</para>
  <para style="q1" vid="AMO 8:10">頭上光禿。</para>
  <para style="q1" vid="AMO 8:10">我要使那日像哀悼獨生子一樣，</para>
  <para style="q1" vid="AMO 8:10">最終都是痛苦的日子。<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />看哪，日子將到！</para>
  <para style="q1" vid="AMO 8:11">這是主耶和華的宣告。</para>
  <para style="q1" vid="AMO 8:11">我要把饑荒降在這地；</para>
  <para style="q1" vid="AMO 8:11">人飢餓不是因缺糧，</para>
  <para style="q1" vid="AMO 8:11">乾渴不是因缺水，</para>
  <para style="q1" vid="AMO 8:11">而是因聽不到耶和華的話語。<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />他們將從這海到那海四處漂泊，</para>
  <para style="q1" vid="AMO 8:12">從北方到東方往來奔走，</para>
  <para style="q1" vid="AMO 8:12">為要尋求耶和華的話語，</para>
  <para style="q1" vid="AMO 8:12">他們卻尋不見。<verse eid="AMO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 8:13" />到那日，</para>
  <para style="q1" vid="AMO 8:13">美麗的少女和年輕的男子</para>
  <para style="q1" vid="AMO 8:13">必因乾渴而發昏。<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />那些指著<char style="pn">撒瑪利亞</char>的偶像起誓的，</para>
  <para style="q1" vid="AMO 8:14">他們說：</para>
  <para style="q1" vid="AMO 8:14">「<char style="pn">但</char>支派啊，我指著你們神的生命起誓，</para>
  <para style="q1" vid="AMO 8:14">指著<char style="pn">比爾-謝巴</char>的神明起誓。」</para>
  <para style="q1" vid="AMO 8:14">這些人必仆倒，再也不能起來。<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">第五個異象：主在祭壇旁發話</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />我看見主站在祭壇旁邊，他說：</para>
  <para style="q1" vid="AMO 9:1">「擊打柱頂吧，使門檻震動，</para>
  <para style="q1" vid="AMO 9:1">使柱頂砸落在他們所有人頭上。</para>
  <para style="q1" vid="AMO 9:1">殘留的，我要用刀殺死；</para>
  <para style="q1" vid="AMO 9:1">逃跑的逃不掉，逃亡的不能逃脫。<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />就算他們鑽進陰間，</para>
  <para style="q1" vid="AMO 9:2">我的手也要從那裡把他們拽出來；</para>
  <para style="q1" vid="AMO 9:2">就算他們升到天上，</para>
  <para style="q1" vid="AMO 9:2">我也要從那裡把他們拉下來。<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />就算他們躲藏在<char style="pn">迦密</char>山頂，</para>
  <para style="q1" vid="AMO 9:3">我也要在那裡搜尋，</para>
  <para style="q1" vid="AMO 9:3">把他們抓出來。</para>
  <para style="q1" vid="AMO 9:3">就算他們從我眼前隱藏到海底，</para>
  <para style="q1" vid="AMO 9:3">我也要在那裡吩咐海蛇咬他們。<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />就算他們在仇敵面前被擄去，</para>
  <para style="q1" vid="AMO 9:4">我也要在那裡吩咐刀劍殺戮他們。</para>
  <para style="q1" vid="AMO 9:4">我要定睛在他們身上，</para>
  <para style="q1" vid="AMO 9:4">不是為了賜福，而是為了降災禍。」<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />主萬軍之耶和華觸碰大地，</para>
  <para style="q1" vid="AMO 9:5">大地就消融，</para>
  <para style="q1" vid="AMO 9:5">其上所有的居民都將悲慟，</para>
  <para style="q1" vid="AMO 9:5">全地都像<char style="pn">尼羅</char>河那樣上漲，</para>
  <para style="q1" vid="AMO 9:5">又像<char style="pn">埃及</char>的<char style="pn">尼羅</char>河那樣下沉。<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />他在天上建造樓閣，</para>
  <para style="q1" vid="AMO 9:6">在大地之上設立穹頂，</para>
  <para style="q1" vid="AMO 9:6">他召喚海水，</para>
  <para style="q1" vid="AMO 9:6">把它們傾倒在地面上，</para>
  <para style="q1" vid="AMO 9:6">耶和華是他的名。<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="s">宣告審判</para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />
    <char style="pn">以色列</char>人哪，</para>
  <para style="q1" vid="AMO 9:7">對我來說，你們與<char style="pn">庫實</char>人不是一樣嗎？</para>
  <para style="q1" vid="AMO 9:7">這是耶和華的宣告。</para>
  <para style="q1" vid="AMO 9:7">我難道不是把<char style="pn">以色列</char>從<char style="pn">埃及</char>地帶上來，</para>
  <para style="q1" vid="AMO 9:7">也把<char style="pn">非利士</char>人從<char style="pn">迦斐托</char>帶上來，</para>
  <para style="q1" vid="AMO 9:7">把<char style="pn">亞蘭</char>人從<char style="pn">吉珥</char>帶上來嗎？<verse eid="AMO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />看哪，主耶和華的眼目</para>
  <para style="q1" vid="AMO 9:8">察看那罪惡的國家。</para>
  <para style="q1" vid="AMO 9:8">我要把它從地面上除滅，</para>
  <para style="q1" vid="AMO 9:8">只是我不會把<char style="pn">雅各</char>家徹底除滅。</para>
  <para style="q1" vid="AMO 9:8">這是耶和華的宣告。<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />看哪，我將要下令，</para>
  <para style="q1" vid="AMO 9:9">我要在列國中篩<char style="pn">以色列</char>家，</para>
  <para style="q1" vid="AMO 9:9">像在篩子裡篩穀那樣，</para>
  <para style="q1" vid="AMO 9:9">但不會有一粒掉落在地上。<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />我子民中的罪人，</para>
  <para style="q1" vid="AMO 9:10">就是那些說「災禍不會追上我們，</para>
  <para style="q1" vid="AMO 9:10">不會臨到我們」的，</para>
  <para style="q1" vid="AMO 9:10">他們都將死在刀下。<verse eid="AMO 9:10" /></para>
  <para style="b" />
  <para style="s">宣告復興</para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 9:11" />到那日，</para>
  <para style="q1" vid="AMO 9:11">我要重建<char style="pn">大衛</char>倒塌的帳幕，</para>
  <para style="q1" vid="AMO 9:11">修補它的破口。</para>
  <para style="q1" vid="AMO 9:11">我要重建它的廢墟，</para>
  <para style="q1" vid="AMO 9:11">建造得像古時的日子那樣，<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />使他們獲得<char style="pn">以東</char>的餘剩之地<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">餘剩之地——或譯作「餘剩之民」。</char></note>，</para>
  <para style="q1" vid="AMO 9:12">以及所有曾被稱為我名下的國家。</para>
  <para style="q1" vid="AMO 9:12">這是耶和華的宣告，他必成就這事。<verse eid="AMO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 9:13" />看哪，這是耶和華的宣告：</para>
  <para style="q1" vid="AMO 9:13">日子將到，</para>
  <para style="q1" vid="AMO 9:13">那時耕作接續收割，</para>
  <para style="q1" vid="AMO 9:13">踹葡萄接續播種；</para>
  <para style="q1" vid="AMO 9:13">大山淌落甜酒，</para>
  <para style="q1" vid="AMO 9:13">小山都被浸透<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">被浸透——原文直譯「消融」。</char></note>。<verse eid="AMO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14" />我要使我流亡的子民<char style="pn">以色列</char>回歸<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">使我流亡的子民以色列回歸——或譯作「復興我子民以色列的繼業」。</char></note>，</para>
  <para style="q1" vid="AMO 9:14">他們將重建荒涼的城鎮居住。</para>
  <para style="q1" vid="AMO 9:14">他們將栽種葡萄園，喝所出的酒；</para>
  <para style="q1" vid="AMO 9:14">他們將修建果園，吃園中的果實。<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />我要把他們栽種在自己的土地上，</para>
  <para style="q1" vid="AMO 9:15">他們再也不會</para>
  <para style="q1" vid="AMO 9:15">從我賜給他們的土地上被拔出來。</para>
  <para style="q1" vid="AMO 9:15">這是你的神耶和華說的。<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>