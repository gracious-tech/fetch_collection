<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">歷代志上</para>
  <para style="mt">歷代志上</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s">從亞當到亞伯拉罕</para>
  <para style="mi">
    <verse number="1" style="v" sid="1CH 1:1" />
    <char style="pn">亞當</char>，<char style="pn">塞特</char>，<char style="pn">以挪士</char>，<verse eid="1CH 1:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 1:2" />
    <char style="pn">該南</char>，<char style="pn">瑪勒列</char>，<char style="pn">雅列</char>，<verse eid="1CH 1:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 1:3" />
    <char style="pn">以諾</char>，<char style="pn">瑪土撒拉</char>，<char style="pn">拉麥</char>，<verse eid="1CH 1:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 1:4" />
    <char style="pn">挪亞</char>，他的兒子<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">他的兒子——輔助詞語；依據七十士譯本。</char></note><char style="pn">閃</char>、<char style="pn">含</char>和<char style="pn">雅弗</char>。<verse eid="1CH 1:4" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="5" style="v" sid="1CH 1:5" />
    <char style="pn">雅弗</char>的兒子是<char style="pn">格梅爾</char>、<char style="pn">瑪格</char>、<char style="pn">瑪代</char>、<char style="pn">雅完</char>、<char style="pn">圖巴</char>、<char style="pn">米設</char>、<char style="pn">提拉</char>。<verse eid="1CH 1:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 1:6" />
    <char style="pn">格梅爾</char>的兒子是<char style="pn">阿實基拿</char>、<char style="pn">利法特</char>、<char style="pn">陀伽瑪</char>。<verse eid="1CH 1:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 1:7" />
    <char style="pn">雅完</char>的兒子是<char style="pn">以利沙</char>、<char style="pn">塔爾施</char>、<char style="pn">基提</char>、<char style="pn">羅單</char>。<verse eid="1CH 1:7" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="8" style="v" sid="1CH 1:8" />
    <char style="pn">含</char>的兒子是<char style="pn">庫實</char>、<char style="pn">麥西</char>、<char style="pn">普特</char>、<char style="pn">迦南</char>。<verse eid="1CH 1:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 1:9" />
    <char style="pn">庫實</char>的兒子是<char style="pn">西拔</char>、<char style="pn">哈腓拉</char>、<char style="pn">撒弗他</char>、<char style="pn">拉瑪</char>、<char style="pn">撒弗提迦</char>。</para>
  <para style="mi" vid="1CH 1:9">
    <char style="pn">拉瑪</char>的兒子是<char style="pn">示巴</char>、<char style="pn">底但</char>。<verse eid="1CH 1:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 1:10" />
    <char style="pn">庫實</char>又生了<char style="pn">寧錄</char>，<char style="pn">寧錄</char>是地上第一個強人。<verse eid="1CH 1:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 1:11" />
    <char style="pn">麥西</char>生了<char style="pn">呂底亞</char>人、<char style="pn">亞拿米</char>人、<char style="pn">利哈比</char>人、<char style="pn">拿弗土希</char>人、 <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" /><char style="pn">帕斯魯細</char>人、<char style="pn">迦斯路希</char>人、<char style="pn">迦斐托</char>人；<char style="pn">非利士</char>人來源於<char style="pn">迦斯路希</char>人。<verse eid="1CH 1:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 1:13" />
    <char style="pn">迦南</char>生了長子<char style="pn">西頓</char>，又生了<char style="pn">赫提</char>， <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />接著是<char style="pn">耶布斯</char>人、<char style="pn">亞摩利</char>人、<char style="pn">革迦撒</char>人、 <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" /><char style="pn">希未</char>人、<char style="pn">亞基</char>人、<char style="pn">西尼</char>人、 <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" /><char style="pn">亞瓦底</char>人、<char style="pn">洗瑪利</char>人、<char style="pn">哈馬</char>人。<verse eid="1CH 1:16" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="17" style="v" sid="1CH 1:17" />
    <char style="pn">閃</char>的兒子是<char style="pn">以攔</char>、<char style="pn">亞述</char>、<char style="pn">亞法撒</char>、<char style="pn">呂底亞</char>、<char style="pn">亞蘭</char>。</para>
  <para style="mi" vid="1CH 1:17">
    <char style="pn">亞蘭</char>的兒子是<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">亞蘭的兒子是——依據七十士譯本；參《創世記》10:23。</char></note><char style="pn">烏斯</char>、<char style="pn">戶勒</char>、<char style="pn">基帖</char>、<char style="pn">米設</char>。<verse eid="1CH 1:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 1:18" />
    <char style="pn">亞法撒</char>生<char style="pn">沙拉</char>，<char style="pn">沙拉</char>生<char style="pn">希伯</char>。<verse eid="1CH 1:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 1:19" />
    <char style="pn">希伯</char>生了兩個兒子，一個名叫<char style="pn">法勒</char>，因為在他的日子裡，地上的人分開了；<char style="pn">法勒</char>的兄弟名叫<char style="pn">約坍</char>。<verse eid="1CH 1:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 1:20" />
    <char style="pn">約坍</char>生了<char style="pn">亞摩達</char>、<char style="pn">沙列</char>、<char style="pn">哈薩瑪非</char>、<char style="pn">耶拉</char>、 <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" /><char style="pn">哈多蘭</char>、<char style="pn">烏薩</char>、<char style="pn">德拉</char>、 <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" /><char style="pn">以巴錄</char>、<char style="pn">亞比瑪利</char>、<char style="pn">示巴</char>、 <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" /><char style="pn">俄斐</char>、<char style="pn">哈腓拉</char>、<char style="pn">約巴</char>。這些全都是<char style="pn">約坍</char>的兒子。<verse eid="1CH 1:23" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="24" style="v" sid="1CH 1:24" />
    <char style="pn">閃</char>，<char style="pn">亞法撒</char>，<char style="pn">沙拉</char>，<verse eid="1CH 1:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 1:25" />
    <char style="pn">希伯</char>，<char style="pn">法勒</char>，<char style="pn">拉吳</char>，<verse eid="1CH 1:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 1:26" />
    <char style="pn">西鹿</char>，<char style="pn">拿鶴</char>，<char style="pn">塔拉</char>，<verse eid="1CH 1:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 1:27" />
    <char style="pn">亞伯蘭</char>，<char style="pn">亞伯蘭</char>就是<char style="pn">亞伯拉罕</char>。<verse eid="1CH 1:27" /></para>
  <para style="b" />
  <para style="s">亞伯拉罕的子孫</para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 1:28" />
    <char style="pn">亞伯拉罕</char>的兒子是<char style="pn">以撒</char>和<char style="pn">以實瑪利</char>。<verse eid="1CH 1:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 1:29" />以下是他們的家系：</para>
  <para style="mi" vid="1CH 1:29">
    <char style="pn">以實瑪利</char>的長子是<char style="pn">尼拜約</char>，其次是<char style="pn">基達</char>、<char style="pn">亞德別</char>、<char style="pn">米比衫</char>、 <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" /><char style="pn">米施瑪</char>、<char style="pn">度瑪</char>、<char style="pn">瑪撒</char>、<char style="pn">哈達</char>、<char style="pn">提瑪</char>、 <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" /><char style="pn">伊突</char>、<char style="pn">拿非施</char>、<char style="pn">基底瑪</char>。</para>
  <para style="mi" vid="1CH 1:31">這些是<char style="pn">以實瑪利</char>的兒子。<verse eid="1CH 1:31" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="32" style="v" sid="1CH 1:32" />
    <char style="pn">亞伯拉罕</char>的妾<char style="pn">基土拉</char>所生的兒子是<char style="pn">新蘭</char>、<char style="pn">約珊</char>、<char style="pn">米但</char>、<char style="pn">米甸</char>、<char style="pn">伊施巴</char>和<char style="pn">書亞</char>。</para>
  <para style="mi" vid="1CH 1:32">
    <char style="pn">約珊</char>的兒子是<char style="pn">示巴</char>和<char style="pn">底但</char>。<verse eid="1CH 1:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 1:33" />
    <char style="pn">米甸</char>的兒子是<char style="pn">以法</char>、<char style="pn">以弗</char>、<char style="pn">哈諾</char>、<char style="pn">亞比大</char>和<char style="pn">以勒大</char>。</para>
  <para style="mi" vid="1CH 1:33">這些全都是<char style="pn">基土拉</char>的子孫。<verse eid="1CH 1:33" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="34" style="v" sid="1CH 1:34" />
    <char style="pn">亞伯拉罕</char>生了<char style="pn">以撒</char>，<char style="pn">以撒</char>的兒子是<char style="pn">以掃</char>和<char style="pn">以色列</char>。<verse eid="1CH 1:34" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="35" style="v" sid="1CH 1:35" />
    <char style="pn">以掃</char>的兒子是<char style="pn">以利法</char>、<char style="pn">流珥</char>、<char style="pn">耶烏施</char>、<char style="pn">雅蘭</char>和<char style="pn">可拉</char>。<verse eid="1CH 1:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 1:36" />
    <char style="pn">以利法</char>的兒子是<char style="pn">提幔</char>、<char style="pn">阿抹</char>、<char style="pn">洗玻</char>、<char style="pn">迦坦</char>、<char style="pn">基納斯</char>、<char style="pn">亭納</char>和<char style="pn">亞瑪力</char>。<verse eid="1CH 1:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="1CH 1:37" />
    <char style="pn">流珥</char>的兒子是<char style="pn">拿哈</char>、<char style="pn">謝拉</char>、<char style="pn">沙瑪</char>和<char style="pn">米撒</char>。<verse eid="1CH 1:37" /></para>
  <para style="b" />
  <para style="s">以東人</para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 1:38" />
    <char style="pn">西珥</char>的兒子是<char style="pn">羅坍</char>、<char style="pn">朔巴</char>、<char style="pn">基比文</char>、<char style="pn">亞拿</char>、<char style="pn">底順</char>、<char style="pn">以察</char>和<char style="pn">底珊</char>。<verse eid="1CH 1:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 1:39" />
    <char style="pn">羅坍</char>的兒子是<char style="pn">何利</char>和<char style="pn">赫曼</char>，<char style="pn">羅坍</char>的妹妹是<char style="pn">亭娜</char>。<verse eid="1CH 1:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 1:40" />
    <char style="pn">朔巴</char>的兒子是<char style="pn">亞勒文</char>、<char style="pn">瑪拿哈</char>、<char style="pn">以巴錄</char>、<char style="pn">示玻</char>、<char style="pn">阿南</char>。</para>
  <para style="mi" vid="1CH 1:40">
    <char style="pn">基比文</char>的兒子是<char style="pn">阿亞</char>和<char style="pn">亞拿</char>。<verse eid="1CH 1:40" /></para>
  <para style="mi">
    <verse number="41" style="v" sid="1CH 1:41" />
    <char style="pn">亞拿</char>的兒子是<char style="pn">底順</char>。</para>
  <para style="mi" vid="1CH 1:41">
    <char style="pn">底順</char>的兒子是<char style="pn">哈默蘭</char>、<char style="pn">伊示班</char>、<char style="pn">益蘭</char>和<char style="pn">基蘭</char>。<verse eid="1CH 1:41" /></para>
  <para style="mi">
    <verse number="42" style="v" sid="1CH 1:42" />
    <char style="pn">以察</char>的兒子是<char style="pn">比勒罕</char>、<char style="pn">撒番</char>、<char style="pn">亞干</char>。</para>
  <para style="mi" vid="1CH 1:42">
    <char style="pn">底珊</char>的兒子是<char style="pn">烏斯</char>和<char style="pn">亞蘭</char>。<verse eid="1CH 1:42" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="43" style="v" sid="1CH 1:43" />
    <char style="pn">以色列</char>子孫還沒有君王統治的時候，統治<char style="pn">以東</char>地的君王如下：</para>
  <para style="mi" vid="1CH 1:43">
    <char style="pn">比珥</char>的兒子<char style="pn">比拉</char>，他的城名叫<char style="pn">亭哈巴</char>。<verse eid="1CH 1:43" /></para>
  <para style="mi">
    <verse number="44" style="v" sid="1CH 1:44" />
    <char style="pn">比拉</char>死後，<char style="pn">波斯拉</char>人<char style="pn">謝拉</char>的兒子<char style="pn">約巴</char>接替他作王。<verse eid="1CH 1:44" /></para>
  <para style="mi">
    <verse number="45" style="v" sid="1CH 1:45" />
    <char style="pn">約巴</char>死後，從<char style="pn">提幔</char>地來的<char style="pn">戶珊</char>接替他作王。<verse eid="1CH 1:45" /></para>
  <para style="mi">
    <verse number="46" style="v" sid="1CH 1:46" />
    <char style="pn">戶珊</char>死後，<char style="pn">比達</char>的兒子<char style="pn">哈達</char>接替他作王；</para>
  <para style="mi" vid="1CH 1:46">
    <char style="pn">哈達</char>曾在<char style="pn">摩押</char>地擊敗<char style="pn">米甸</char>人，他的城名叫<char style="pn">亞未得</char>。<verse eid="1CH 1:46" /></para>
  <para style="mi">
    <verse number="47" style="v" sid="1CH 1:47" />
    <char style="pn">哈達</char>死後，<char style="pn">瑪士利加</char>人<char style="pn">桑拉</char>接替他作王。<verse eid="1CH 1:47" /></para>
  <para style="mi">
    <verse number="48" style="v" sid="1CH 1:48" />
    <char style="pn">桑拉</char>死後，大河<note caller="+" style="f"><char style="fr" closed="false">1:48 </char><char style="ft" closed="false">大河——指幼發拉底河。</char></note>邊的<char style="pn">利河伯</char>人<char style="pn">掃羅</char>接替他作王。<verse eid="1CH 1:48" /></para>
  <para style="mi">
    <verse number="49" style="v" sid="1CH 1:49" />
    <char style="pn">掃羅</char>死後，<char style="pn">亞革波</char>的兒子<char style="pn">巴勒·哈南</char>接替他作王。<verse eid="1CH 1:49" /></para>
  <para style="mi">
    <verse number="50" style="v" sid="1CH 1:50" />
    <char style="pn">巴勒·哈南</char>死後，<char style="pn">哈達</char>接替他作王，他的城名叫<char style="pn">巴伊</char>；</para>
  <para style="mi" vid="1CH 1:50">他的妻子名叫<char style="pn">米赫塔別</char>，是<char style="pn">米·薩合</char>的孫女、<char style="pn">瑪特列</char>的女兒。<verse eid="1CH 1:50" /></para>
  <para style="mi">
    <verse number="51" style="v" sid="1CH 1:51" />之後<char style="pn">哈達</char>也死了。</para>
  <para style="b" vid="1CH 1:51" />
  <para style="mi" vid="1CH 1:51">
    <char style="pn">以東</char>人的族長有：<char style="pn">亭納</char>族長、<char style="pn">亞勒瓦</char>族長、<char style="pn">耶帖</char>族長、<verse eid="1CH 1:51" /></para>
  <para style="mi">
    <verse number="52" style="v" sid="1CH 1:52" />
    <char style="pn">阿何利巴瑪</char>族長、<char style="pn">以拉</char>族長、<char style="pn">比嫩</char>族長、<verse eid="1CH 1:52" /></para>
  <para style="mi">
    <verse number="53" style="v" sid="1CH 1:53" />
    <char style="pn">基納斯</char>族長、<char style="pn">提幔</char>族長、<char style="pn">米比薩</char>族長、<verse eid="1CH 1:53" /></para>
  <para style="mi">
    <verse number="54" style="v" sid="1CH 1:54" />
    <char style="pn">瑪基疊</char>族長、<char style="pn">以蘭</char>族長。</para>
  <para style="mi" vid="1CH 1:54">以上是<char style="pn">以東</char>人的各族長。<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s">以色列眾子</para>
  <para style="mi">
    <verse number="1" style="v" sid="1CH 2:1" />以下是<char style="pn">以色列</char>的眾子：</para>
  <para style="mi" vid="1CH 2:1">
    <char style="pn">魯本</char>、<char style="pn">西緬</char>、<char style="pn">利未</char>、</para>
  <para style="mi" vid="1CH 2:1">
    <char style="pn">猶大</char>、<char style="pn">以薩迦</char>、<char style="pn">西布倫</char>、<verse eid="1CH 2:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 2:2" />
    <char style="pn">但</char>、<char style="pn">約瑟</char>、<char style="pn">便雅憫</char>、</para>
  <para style="mi" vid="1CH 2:2">
    <char style="pn">拿弗他利</char>、<char style="pn">迦得</char>和<char style="pn">亞設</char>。<verse eid="1CH 2:2" /></para>
  <para style="b" />
  <para style="s">猶大子孫</para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 2:3" />
    <char style="pn">猶大</char>的兒子是<char style="pn">珥</char>、<char style="pn">俄南</char>和<char style="pn">示拉</char>，這三人是<char style="pn">迦南</char>女子<char style="pn">芭書婭</char>給他生的。<char style="pn">猶大</char>的長子<char style="pn">珥</char>做耶和華眼中看為惡的事，耶和華就把他擊殺了。 <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" /><char style="pn">猶大</char>的兒媳<char style="pn">塔瑪爾</char>給他生了<char style="pn">法勒斯</char>和<char style="pn">謝拉</char>。<char style="pn">猶大</char>總共有五個兒子。<verse eid="1CH 2:4" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="5" style="v" sid="1CH 2:5" />
    <char style="pn">法勒斯</char>的兒子是<char style="pn">希斯倫</char>和<char style="pn">哈姆勒</char>。<verse eid="1CH 2:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 2:6" />
    <char style="pn">謝拉</char>的兒子是<char style="pn">澤姆利</char>、<char style="pn">伊坦</char>、<char style="pn">希幔</char>、<char style="pn">卡珥克勒</char>、<char style="pn">達拉</char>，總共五人。<verse eid="1CH 2:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 2:7" />
    <char style="pn">迦米</char>的兒子是<char style="pn">亞干</char>，他違犯了當滅之物的禁令<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">的禁令——輔助詞語。</char></note>，給<char style="pn">以色列</char>帶來了禍患。<verse eid="1CH 2:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 2:8" />
    <char style="pn">伊坦</char>的兒子是<char style="pn">亞撒利雅</char>。<verse eid="1CH 2:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 2:9" />
    <char style="pn">希斯倫</char>所生的兒子是<char style="pn">耶拉米列</char>、<char style="pn">蘭</char>和<char style="pn">基路拜</char>。<verse eid="1CH 2:9" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="10" style="v" sid="1CH 2:10" />
    <char style="pn">蘭</char>生<char style="pn">亞米拿達</char>，</para>
  <para style="mi" vid="1CH 2:10">
    <char style="pn">亞米拿達</char>生<char style="pn">猶大</char>子孫的領袖<char style="pn">拿順</char>，<verse eid="1CH 2:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 2:11" />
    <char style="pn">拿順</char>生<char style="pn">撒門</char><note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">撒門——或音譯作「薩瑪」；下同。</char></note>，</para>
  <para style="mi" vid="1CH 2:11">
    <char style="pn">撒門</char>生<char style="pn">波阿斯</char>，<verse eid="1CH 2:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 2:12" />
    <char style="pn">波阿斯</char>生<char style="pn">俄備得</char>，</para>
  <para style="mi" vid="1CH 2:12">
    <char style="pn">俄備得</char>生<char style="pn">耶西</char>。<verse eid="1CH 2:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 2:13" />
    <char style="pn">耶西</char>生了長子<char style="pn">以利押</char>，</para>
  <para style="mi" vid="1CH 2:13">次子<char style="pn">亞比拿達</char>，三子<char style="pn">示米亞</char>，<verse eid="1CH 2:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 2:14" />四子<char style="pn">拿旦業</char>，五子<char style="pn">拉代</char>，<verse eid="1CH 2:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 2:15" />六子<char style="pn">阿鮮</char>，七子<char style="pn">大衛</char>。<verse eid="1CH 2:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 2:16" />他們的姐妹是<char style="pn">洗魯雅</char>和<char style="pn">婭比蓋</char>。</para>
  <para style="mi" vid="1CH 2:16">
    <char style="pn">洗魯雅</char>的兒子是<char style="pn">亞比篩</char>、<char style="pn">約押</char>、<char style="pn">亞撒暉</char>，共三人。<verse eid="1CH 2:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 2:17" />
    <char style="pn">婭比蓋</char>生<char style="pn">亞瑪撒</char>，</para>
  <para style="mi" vid="1CH 2:17">
    <char style="pn">亞瑪撒</char>的父親是<char style="pn">以實瑪利</char>人<char style="pn">耶特爾</char>。<verse eid="1CH 2:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 2:18" />
    <char style="pn">希斯倫</char>的兒子<char style="pn">迦勒</char>與妻子<char style="pn">阿蘇巴</char>和<char style="pn">耶略</char>生了兒子，這些兒子是<char style="pn">耶設</char>、<char style="pn">朔罷</char>、<char style="pn">押墩</char>。 <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" /><char style="pn">阿蘇巴</char>死後，<char style="pn">迦勒</char>又娶<char style="pn">以法她</char>，生了<char style="pn">戶珥</char>。 <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" /><char style="pn">戶珥</char>生<char style="pn">烏利</char>，<char style="pn">烏利</char>生<char style="pn">比撒列</char>。 <verse eid="1CH 2:20" /><verse number="21" style="v" sid="1CH 2:21" />後來<char style="pn">希斯倫</char>六十歲時，娶了<char style="pn">基列</char>之父<char style="pn">瑪吉</char>的女兒，與她同房，她就為<char style="pn">希斯倫</char>生了<char style="pn">西割</char>。 <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" /><char style="pn">西割</char>生<char style="pn">睚珥</char>，<char style="pn">睚珥</char>在<char style="pn">基列</char>地擁有二十三座城； <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />後來<char style="pn">基述</char>人和<char style="pn">亞蘭</char>人從他們手中奪取了這些<char style="pn">睚珥</char>鎮，以及<char style="pn">基納</char>和附屬的村鎮，共六十座城。這些都是<char style="pn">基列</char>之父<char style="pn">瑪吉</char>的子孫。 <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" /><char style="pn">希斯倫</char>死了以後，<char style="pn">迦勒</char>與父親<char style="pn">希斯倫</char>的妻子<char style="pn">以法她</char>同房，她為<char style="pn">迦勒</char>生了<char style="pn">提克亞</char>之祖<char style="pn">亞施戶</char>。<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">此節依據七十士譯本；馬索拉文本作「希斯倫在迦勒-以法他死了以後，希斯倫的妻子婭比雅為他生了提克亞之祖亞施戶。」</char></note><verse eid="1CH 2:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 2:25" />
    <char style="pn">希斯倫</char>長子<char style="pn">耶拉米列</char>的兒子是：長子<char style="pn">蘭</char>，以及<char style="pn">布拿</char>、<char style="pn">阿連</char>、<char style="pn">阿鮮</char>和<char style="pn">亞希雅</char>。 <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" /><char style="pn">耶拉米列</char>又有另外一個妻子，名叫<char style="pn">婭塔拉</char>，她是<char style="pn">阿南</char>的母親。<verse eid="1CH 2:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 2:27" />
    <char style="pn">耶拉米列</char>長子<char style="pn">蘭</char>的兒子是<char style="pn">瑪斯</char>、<char style="pn">雅憫</char>和<char style="pn">以結</char>。<verse eid="1CH 2:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 2:28" />
    <char style="pn">阿南</char>的兒子是<char style="pn">沙買</char>和<char style="pn">雅達</char>，</para>
  <para style="mi" vid="1CH 2:28">
    <char style="pn">沙買</char>的兒子是<char style="pn">納達布</char>和<char style="pn">亞比述</char>。 <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" /><char style="pn">亞比述</char>的妻子名叫<char style="pn">亞比亥</char>，她為<char style="pn">亞比述</char>生了<char style="pn">阿赫班</char>和<char style="pn">莫利德</char>。<verse eid="1CH 2:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 2:30" />
    <char style="pn">納達布</char>的兒子是<char style="pn">塞列德</char>和<char style="pn">阿帕因</char>，<char style="pn">塞列德</char>沒有兒子就死了。<verse eid="1CH 2:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 2:31" />
    <char style="pn">阿帕因</char>的兒子是<char style="pn">伊示</char>，</para>
  <para style="mi" vid="1CH 2:31">
    <char style="pn">伊示</char>的兒子是<char style="pn">示珊</char>，</para>
  <para style="mi" vid="1CH 2:31">
    <char style="pn">示珊</char>的兒子是<char style="pn">阿赫萊</char>。<verse eid="1CH 2:31" /></para>
  <para style="mi">
    <verse number="32" style="v" sid="1CH 2:32" />
    <char style="pn">沙買</char>兄弟<char style="pn">雅達</char>的兒子是<char style="pn">耶特爾</char>和<char style="pn">約拿單</char>，<char style="pn">耶特爾</char>沒有兒子就死了。<verse eid="1CH 2:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 2:33" />
    <char style="pn">約拿單</char>的兒子是<char style="pn">比勒</char>和<char style="pn">撒薩</char>。這些都是<char style="pn">耶拉米列</char>的子孫。<verse eid="1CH 2:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 2:34" />
    <char style="pn">示珊</char>沒有兒子，只有女兒。<char style="pn">示珊</char>有一個<char style="pn">埃及</char>奴僕，名叫<char style="pn">耶哈</char>。 <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" /><char style="pn">示珊</char>把女兒給奴僕<char style="pn">耶哈</char>為妻，生下<char style="pn">亞泰</char>歸他。<verse eid="1CH 2:35" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="36" style="v" sid="1CH 2:36" />
    <char style="pn">亞泰</char>生<char style="pn">拿單</char>，</para>
  <para style="mi" vid="1CH 2:36">
    <char style="pn">拿單</char>生<char style="pn">撒巴德</char>，<verse eid="1CH 2:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="1CH 2:37" />
    <char style="pn">撒巴德</char>生<char style="pn">以弗拉</char>，</para>
  <para style="mi" vid="1CH 2:37">
    <char style="pn">以弗拉</char>生<char style="pn">俄備得</char>，<verse eid="1CH 2:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 2:38" />
    <char style="pn">俄備得</char>生<char style="pn">耶戶</char>，</para>
  <para style="mi" vid="1CH 2:38">
    <char style="pn">耶戶</char>生<char style="pn">亞撒利雅</char>，<verse eid="1CH 2:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 2:39" />
    <char style="pn">亞撒利雅</char>生<char style="pn">希利斯</char>，</para>
  <para style="mi" vid="1CH 2:39">
    <char style="pn">希利斯</char>生<char style="pn">以利亞薩</char>，<verse eid="1CH 2:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 2:40" />
    <char style="pn">以利亞薩</char>生<char style="pn">西斯買</char>，</para>
  <para style="mi" vid="1CH 2:40">
    <char style="pn">西斯買</char>生<char style="pn">沙勒姆</char>，<verse eid="1CH 2:40" /></para>
  <para style="mi">
    <verse number="41" style="v" sid="1CH 2:41" />
    <char style="pn">沙勒姆</char>生<char style="pn">耶加米雅</char>，</para>
  <para style="mi" vid="1CH 2:41">
    <char style="pn">耶加米雅</char>生<char style="pn">以利沙瑪</char>。<verse eid="1CH 2:41" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="42" style="v" sid="1CH 2:42" />
    <char style="pn">耶拉米列</char>兄弟<char style="pn">迦勒</char>的兒子有：</para>
  <para style="mi" vid="1CH 2:42">長子<char style="pn">米沙</char>，他是<char style="pn">西弗</char>的父親；</para>
  <para style="mi" vid="1CH 2:42">次子<char style="pn">瑪利沙</char><note caller="+" style="f"><char style="fr" closed="false">2:42 </char><char style="ft" closed="false">次子瑪利沙——馬索拉文本作「瑪利沙的眾子」。</char></note>，是<char style="pn">希伯倫</char>的父親。<verse eid="1CH 2:42" /></para>
  <para style="mi">
    <verse number="43" style="v" sid="1CH 2:43" />
    <char style="pn">希伯倫</char>的兒子是<char style="pn">可拉</char>、<char style="pn">塔普阿</char>、<char style="pn">利肯</char>和<char style="pn">示瑪</char>。<verse eid="1CH 2:43" /></para>
  <para style="mi">
    <verse number="44" style="v" sid="1CH 2:44" />
    <char style="pn">示瑪</char>生了<char style="pn">約克安</char>之父<char style="pn">拉罕</char>。</para>
  <para style="mi" vid="1CH 2:44">
    <char style="pn">利肯</char>生了<char style="pn">沙買</char>。<verse eid="1CH 2:44" /></para>
  <para style="mi">
    <verse number="45" style="v" sid="1CH 2:45" />
    <char style="pn">沙買</char>的兒子是<char style="pn">瑪雲</char>，<char style="pn">瑪雲</char>是<char style="pn">伯促爾</char>的父親。<verse eid="1CH 2:45" /></para>
  <para style="mi">
    <verse number="46" style="v" sid="1CH 2:46" />
    <char style="pn">迦勒</char>的妾<char style="pn">以法</char>生了<char style="pn">哈蘭</char>、<char style="pn">莫扎</char>和<char style="pn">伽澤茲</char>，</para>
  <para style="mi" vid="1CH 2:46">
    <char style="pn">哈蘭</char>生<char style="pn">伽澤茲</char>。<verse eid="1CH 2:46" /></para>
  <para style="mi">
    <verse number="47" style="v" sid="1CH 2:47" />
    <char style="pn">雅代</char>的兒子是<char style="pn">利健</char>、<char style="pn">約坦</char>、<char style="pn">基珊</char>、<char style="pn">毗力</char>、<char style="pn">以法</char>和<char style="pn">沙亞弗</char>。<verse eid="1CH 2:47" /></para>
  <para style="mi">
    <verse number="48" style="v" sid="1CH 2:48" />
    <char style="pn">迦勒</char>的妾<char style="pn">瑪迦</char>生了<char style="pn">示別</char>、<char style="pn">特哈拿</char>， <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />又生<char style="pn">麥瑪拿</char>之父<char style="pn">沙亞弗</char>，<char style="pn">抹比拿</char>之父和<char style="pn">基比亞</char>之父<char style="pn">示法</char>。<char style="pn">迦勒</char>的女兒是<char style="pn">婭撒</char>。<verse eid="1CH 2:49" /></para>
  <para style="mi">
    <verse number="50" style="v" sid="1CH 2:50" />這些都是<char style="pn">迦勒</char>的子孫。</para>
  <para style="b" vid="1CH 2:50" />
  <para style="mi" vid="1CH 2:50">
    <char style="pn">以法她</char>的長子是<char style="pn">戶珥</char>，<char style="pn">戶珥</char>的兒子是：</para>
  <para style="mi" vid="1CH 2:50">
    <char style="pn">基列-耶琳</char>之祖<char style="pn">朔巴</char>、<verse eid="1CH 2:50" /></para>
  <para style="mi">
    <verse number="51" style="v" sid="1CH 2:51" />
    <char style="pn">伯利恆</char>之祖<char style="pn">撒門</char>、</para>
  <para style="mi" vid="1CH 2:51">
    <char style="pn">伯迦德</char>之祖<char style="pn">哈勒</char>。<verse eid="1CH 2:51" /></para>
  <para style="mi">
    <verse number="52" style="v" sid="1CH 2:52" />
    <char style="pn">基列-耶琳</char>之祖<char style="pn">朔巴</char>的子孫是<char style="pn">哈羅耶</char>，一半的<char style="pn">瑪拿哈</char>人， <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />以及<char style="pn">基列-耶琳</char>的各家族<char style="pn">以帖</char>人、<char style="pn">布特</char>人、<char style="pn">舒瑪</char>人和<char style="pn">米示拉</char>人；<char style="pn">佐拉</char>人和<char style="pn">以實陶</char>人也來源於這些家族。<verse eid="1CH 2:53" /></para>
  <para style="mi">
    <verse number="54" style="v" sid="1CH 2:54" />
    <char style="pn">撒門</char>的子孫是<char style="pn">伯利恆</char>人、<char style="pn">尼托法</char>人、<char style="pn">阿塔羅-伯約押</char>人、一半的<char style="pn">瑪拿哈</char>人、<char style="pn">佐拉</char>人； <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />還有住在<char style="pn">雅比斯</char>的文士家族：<char style="pn">特拉</char>人、<char style="pn">示米押</char>人和<char style="pn">蘇甲</char>人。他們都是<char style="pn">基尼</char>人，是<char style="pn">利甲</char>家的族長<char style="pn">哈末</char>的後人。<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s">大衛的兒女</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />以下是<char style="pn">大衛</char>在<char style="pn">希伯崙</char>所生的兒子：</para>
  <para style="mi" vid="1CH 3:1">長子<char style="pn">暗嫩</char>，由<char style="pn">耶斯列</char>人<char style="pn">婭希暖</char>所生；</para>
  <para style="mi" vid="1CH 3:1">次子<char style="pn">但以理</char>，由<char style="pn">迦密</char>人<char style="pn">婭比蓋</char>所生；<verse eid="1CH 3:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 3:2" />三子<char style="pn">押沙龍</char>，由<char style="pn">基述</char>王<char style="pn">塔爾邁</char>的女兒<char style="pn">瑪迦</char>所生；</para>
  <para style="mi" vid="1CH 3:2">四子<char style="pn">亞多尼雅</char>，是<char style="pn">哈及</char>的兒子；<verse eid="1CH 3:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 3:3" />五子<char style="pn">示法提雅</char>，由<char style="pn">亞比塔</char>所生；</para>
  <para style="mi" vid="1CH 3:3">六子<char style="pn">以特念</char>，由<char style="pn">大衛</char>的妻子<char style="pn">以格拉</char>所生。<verse eid="1CH 3:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 3:4" />六個都是他在<char style="pn">希伯崙</char>所生的，他在那裡統治了七年零六個月。</para>
  <para style="mi" vid="1CH 3:4">他在<char style="pn">耶路撒冷</char>統治了三十三年， <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />以下是他在<char style="pn">耶路撒冷</char>所生的：</para>
  <para style="mi" vid="1CH 3:5">
    <char style="pn">示米亞</char>、<char style="pn">朔罷</char>、<char style="pn">拿單</char>和<char style="pn">所羅門</char>，這四人由<char style="pn">亞米利</char>的女兒<char style="pn">芭書婭</char>所生；<verse eid="1CH 3:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 3:6" />還有<char style="pn">益轄</char>、<char style="pn">以利沙瑪</char>、<char style="pn">以利菲烈</char>、 <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" /><char style="pn">挪迦</char>、<char style="pn">尼斐</char>、<char style="pn">雅非亞</char>、 <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" /><char style="pn">以利沙瑪</char>、<char style="pn">以利雅大</char>和<char style="pn">以利菲烈</char>，共九人。<verse eid="1CH 3:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 3:9" />這都是<char style="pn">大衛</char>的兒子，此外還有妃嬪們所生的兒子，以及他們的妹妹<char style="pn">塔瑪爾</char>。<verse eid="1CH 3:9" /></para>
  <para style="b" />
  <para style="s">猶大列王</para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 3:10" />
    <char style="pn">所羅門</char>的兒子是<char style="pn">羅波安</char>，</para>
  <para style="mi" vid="1CH 3:10">
    <char style="pn">羅波安</char>的兒子是<char style="pn">亞比雅</char>，</para>
  <para style="mi" vid="1CH 3:10">
    <char style="pn">亞比雅</char>的兒子是<char style="pn">亞撒</char>，</para>
  <para style="mi" vid="1CH 3:10">
    <char style="pn">亞撒</char>的兒子是<char style="pn">約沙法</char>，<verse eid="1CH 3:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 3:11" />
    <char style="pn">約沙法</char>的兒子是<char style="pn">約蘭</char>，</para>
  <para style="mi" vid="1CH 3:11">
    <char style="pn">約蘭</char>的兒子是<char style="pn">亞哈謝</char>，</para>
  <para style="mi" vid="1CH 3:11">
    <char style="pn">亞哈謝</char>的兒子是<char style="pn">約阿施</char>，<verse eid="1CH 3:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 3:12" />
    <char style="pn">約阿施</char>的兒子是<char style="pn">亞瑪謝</char>，</para>
  <para style="mi" vid="1CH 3:12">
    <char style="pn">亞瑪謝</char>的兒子是<char style="pn">亞撒利雅</char><note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">亞撒利雅——又稱「烏西雅」；見《歷代志下》26:1。</char></note>，</para>
  <para style="mi" vid="1CH 3:12">
    <char style="pn">亞撒利雅</char>的兒子是<char style="pn">約坦</char>，<verse eid="1CH 3:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 3:13" />
    <char style="pn">約坦</char>的兒子是<char style="pn">亞哈斯</char>，</para>
  <para style="mi" vid="1CH 3:13">
    <char style="pn">亞哈斯</char>的兒子是<char style="pn">希西加</char>，</para>
  <para style="mi" vid="1CH 3:13">
    <char style="pn">希西加</char>的兒子是<char style="pn">瑪拿西</char>，<verse eid="1CH 3:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 3:14" />
    <char style="pn">瑪拿西</char>的兒子是<char style="pn">亞門</char>，</para>
  <para style="mi" vid="1CH 3:14">
    <char style="pn">亞門</char>的兒子是<char style="pn">約西亞</char>。<verse eid="1CH 3:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 3:15" />
    <char style="pn">約西亞</char>的兒子是</para>
  <para style="mi" vid="1CH 3:15">長子<char style="pn">約哈南</char>，次子<char style="pn">約雅敬</char>，</para>
  <para style="mi" vid="1CH 3:15">三子<char style="pn">西底加</char>，四子<char style="pn">沙勒姆</char>。<verse eid="1CH 3:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 3:16" />
    <char style="pn">約雅敬</char>的兒子是<char style="pn">耶哥尼雅</char>和<char style="pn">西底加</char>。<verse eid="1CH 3:16" /></para>
  <para style="b" />
  <para style="s">流亡期間的王室</para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 3:17" />被擄之人<char style="pn">耶哥尼雅</char>的子孫是：他的兒子<char style="pn">撒拉鐵</char>， <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />以及<char style="pn">瑪基蘭</char>、<char style="pn">皮達雅</char>、<char style="pn">示拿薩</char>、<char style="pn">耶加米雅</char>、<char style="pn">赫沙瑪</char>和<char style="pn">尼達比雅</char>。<verse eid="1CH 3:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 3:19" />
    <char style="pn">皮達雅</char>的子孫是：<char style="pn">所羅巴伯</char>和<char style="pn">示每</char>，<char style="pn">所羅巴伯</char>的兒子<char style="pn">米書蘭</char>、<char style="pn">哈納尼雅</char>，還有他們的妹妹<char style="pn">示羅米</char>， <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />以及<char style="pn">哈舒巴</char>、<char style="pn">歐黑爾</char>、<char style="pn">比利迦</char>、<char style="pn">哈撒迪亞</char>和<char style="pn">猶沙赫瑟</char>五人。<verse eid="1CH 3:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 3:21" />
    <char style="pn">哈納尼雅</char>的子孫是：<char style="pn">皮拉提</char>、<char style="pn">耶賽亞</char>，以及<char style="pn">勒法雅</char>的眾子，<char style="pn">亞珥楠</char>的眾子，<char style="pn">俄巴底亞</char>的眾子，<char style="pn">謝喀尼亞</char>的眾子。<verse eid="1CH 3:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 3:22" />
    <char style="pn">謝喀尼亞</char>的子孫是：<char style="pn">示瑪雅</char>，<char style="pn">示瑪雅</char>的兒子<char style="pn">哈突施</char>、<char style="pn">以甲</char>、<char style="pn">巴利亞</char>、<char style="pn">尼利雅</char>和<char style="pn">沙法</char>，共六人。<verse eid="1CH 3:22" /></para>
  <para style="mi">
    <verse number="23" style="v" sid="1CH 3:23" />
    <char style="pn">尼利雅</char>的子孫是：<char style="pn">以利約奈</char>、<char style="pn">希西加</char>和<char style="pn">亞斯利甘</char>，共三人。<verse eid="1CH 3:23" /></para>
  <para style="mi">
    <verse number="24" style="v" sid="1CH 3:24" />
    <char style="pn">以利約奈</char>的子孫是：<char style="pn">赫達耶瓦</char>、<char style="pn">以利亞實</char>、<char style="pn">佩拉雅</char>、<char style="pn">阿庫布</char>、<char style="pn">約哈南</char>、<char style="pn">德拉雅</char>和<char style="pn">阿納尼</char>，共七人。<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s">猶大子孫</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />
    <char style="pn">猶大</char>的子孫是<char style="pn">法勒斯</char>、<char style="pn">希斯倫</char>、<char style="pn">迦米</char>、<char style="pn">戶珥</char>和<char style="pn">朔巴</char>。<verse eid="1CH 4:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 4:2" />
    <char style="pn">朔巴</char>的兒子<char style="pn">利阿亞</char>生<char style="pn">雅哈</char>，</para>
  <para style="mi" vid="1CH 4:2">
    <char style="pn">雅哈</char>生<char style="pn">亞戶買</char>和<char style="pn">拉哈</char>；</para>
  <para style="mi" vid="1CH 4:2">這些是<char style="pn">佐拉</char>人的各家族。<verse eid="1CH 4:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 4:3" />
    <char style="pn">以坦</char>人之祖如下：<char style="pn">耶斯列</char>、<char style="pn">伊施瑪</char>、<char style="pn">伊得巴</char>，他們的妹妹名字是<char style="pn">哈慈勒珀妮</char>；<verse eid="1CH 4:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 4:4" />
    <char style="pn">毗努伊勒</char>是<char style="pn">格多</char>的父親；</para>
  <para style="mi" vid="1CH 4:4">
    <char style="pn">以謝爾</char>是<char style="pn">戶沙</char>的父親；</para>
  <para style="mi" vid="1CH 4:4">這些都是<char style="pn">伯利恆</char>之祖<char style="pn">戶珥</char>的子孫。<char style="pn">戶珥</char>是<char style="pn">以法她</char>的長子。<verse eid="1CH 4:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 4:5" />
    <char style="pn">提克亞</char>人之祖<char style="pn">亞施戶</char>有兩個妻子：<char style="pn">赫拉</char>和<char style="pn">拿拉</char>。 <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" /><char style="pn">拿拉</char>生了<char style="pn">亞戶撒</char>、<char style="pn">希弗</char>、<char style="pn">提米尼</char>、<char style="pn">阿哈示塔利</char>，這些都是<char style="pn">拿拉</char>的兒子。<verse eid="1CH 4:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 4:7" />
    <char style="pn">赫拉</char>的兒子是<char style="pn">洗列</char>、<char style="pn">瑣哈爾</char>和<char style="pn">伊提南</char>。<verse eid="1CH 4:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 4:8" />
    <char style="pn">克茲</char>生了<char style="pn">阿諾布</char>、<char style="pn">措比巴</char>，以及<char style="pn">哈崙</char>之子<char style="pn">阿哈黑爾</char>的各家族。<verse eid="1CH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />
    <char style="pn">雅比斯</char>比他的兄弟們更有尊榮。他母親給他起名為<char style="pn">雅比斯</char>，說：「我在痛苦中生的。」<verse eid="1CH 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 4:10" />
    <char style="pn">雅比斯</char>呼求<char style="pn">以色列</char>的神說：「但願你大大祝福我，擴大我的邊界！願你的手與我同在，願你使我脫離禍患，不受傷害！」神成全了他的祈求。<verse eid="1CH 4:10" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="11" style="v" sid="1CH 4:11" />
    <char style="pn">書哈</char>的兄弟<char style="pn">基律</char>生了<char style="pn">伊施屯</char>之父<char style="pn">米希爾</char>。<verse eid="1CH 4:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 4:12" />
    <char style="pn">伊施屯</char>生了<char style="pn">伯拉法</char>、<char style="pn">帕西亞</char>，以及<char style="pn">納哈什</char>城<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">納哈什城——或譯作「珥-納哈什」。</char></note>之祖<char style="pn">提欣納</char>；這些就是<char style="pn">利迦</char>人。<verse eid="1CH 4:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 4:13" />
    <char style="pn">基納斯</char>的兒子是<char style="pn">俄陀聶</char>和<char style="pn">西萊雅</char>。</para>
  <para style="mi" vid="1CH 4:13">
    <char style="pn">俄陀聶</char>的兒子是<char style="pn">哈塔</char>、 <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" /><char style="pn">梅諾泰</char>，<char style="pn">梅諾泰</char>生了<char style="pn">俄弗拉</char>。</para>
  <para style="mi" vid="1CH 4:14">
    <char style="pn">西萊雅</char>生了<char style="pn">哈拉欣</char>谷<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">哈拉欣谷——或譯作「格哈拉欣人」、「匠人谷」。</char></note>之祖<char style="pn">約押</char>，他們都是工匠。<verse eid="1CH 4:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 4:15" />
    <char style="pn">耶弗尼</char>之子<char style="pn">迦勒</char>的子孫是<char style="pn">以路</char>、<char style="pn">以拉</char>和<char style="pn">拿安</char>，<char style="pn">以拉</char>的兒子是<char style="pn">基納斯</char>。<verse eid="1CH 4:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 4:16" />
    <char style="pn">耶哈利勒</char>的兒子是<char style="pn">西弗</char>、<char style="pn">西法</char>、<char style="pn">提利</char>和<char style="pn">亞撒列</char>。<verse eid="1CH 4:16" /></para>
  <para style="mi">
    <verse number="17-18" style="v" sid="1CH 4:17-18" />
    <char style="pn">以斯拉</char>的兒子是<char style="pn">耶特爾</char>、<char style="pn">米列</char>、<char style="pn">以弗</char>和<char style="pn">雅倫</char>。<char style="pn">米列</char>所娶法老的女兒<char style="pn">比提婭</char>生了<char style="pn">米利暗</char>、<char style="pn">沙買</char>和<char style="pn">以實提莫</char>之祖<char style="pn">益巴</char>，這些是<char style="pn">比提婭</char>的兒子；<char style="pn">米列</char>的<char style="pn">猶大</char>妻子生了<char style="pn">格多</char>之祖<char style="pn">雅列</char>，<char style="pn">梭哥</char>之祖<char style="pn">希伯</char>和<char style="pn">撒挪亞</char>之祖<char style="pn">耶庫蒂爾</char>。 <verse eid="1CH 4:17-18" /><verse number="19" style="v" sid="1CH 4:19" /><char style="pn">霍迪亞</char>的妻子是<char style="pn">娜娢</char>的姐妹，她的兒子是<char style="pn">迦米</char>人<char style="pn">基伊拉</char>之祖，以及<char style="pn">瑪迦</char>人<char style="pn">以實提莫</char>之祖。<verse eid="1CH 4:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 4:20" />
    <char style="pn">示門</char>的兒子是<char style="pn">暗嫩</char>、<char style="pn">林拿</char>、<char style="pn">本哈南</char>和<char style="pn">提倫</char>。</para>
  <para style="mi" vid="1CH 4:20">
    <char style="pn">伊示</char>的子孫是<char style="pn">澤赫特</char>和<char style="pn">便澤赫特</char>。<verse eid="1CH 4:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="1CH 4:21" />
    <char style="pn">猶大</char>的兒子<char style="pn">示拉</char>的子孫是：<char style="pn">利迦</char>之祖<char style="pn">珥</char>，<char style="pn">瑪利沙</char>之祖<char style="pn">拉阿達</char>，在<char style="pn">伯亞實比</char>織造細麻布的各家族。 <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />還有<char style="pn">約敬</char>，<char style="pn">克則巴</char>人，在<char style="pn">摩押</char>作了主人的<char style="pn">約阿施</char>和<char style="pn">薩拉</char>，以及<char style="pn">雅叔比利恆</char>，這些是古代的記錄。 <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />他們都是陶匠，是<char style="pn">尼塔因</char>和<char style="pn">格德拉</char>的居民，他們住在那裡為王工作。<verse eid="1CH 4:23" /></para>
  <para style="b" />
  <para style="s">西緬子孫</para>
  <para style="mi">
    <verse number="24" style="v" sid="1CH 4:24" />
    <char style="pn">西緬</char>的子孫是<char style="pn">尼姆利</char>、<char style="pn">雅憫</char>、<char style="pn">雅立</char>、<char style="pn">謝拉</char>和<char style="pn">掃羅</char>；<verse eid="1CH 4:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 4:25" />
    <char style="pn">掃羅</char>的兒子<char style="pn">沙勒姆</char>，<char style="pn">沙勒姆</char>的兒子<char style="pn">米比衫</char>，<char style="pn">米比衫</char>的兒子<char style="pn">米施瑪</char>。<verse eid="1CH 4:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 4:26" />
    <char style="pn">米施瑪</char>的子孫是<char style="pn">米施瑪</char>的兒子<char style="pn">哈姆列</char>，<char style="pn">哈姆列</char>的兒子<char style="pn">扎克爾</char>，<char style="pn">扎克爾</char>的兒子<char style="pn">示每</char>。<verse eid="1CH 4:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />
    <char style="pn">示每</char>有十六個兒子，六個女兒，但他兄弟們的兒女不多，他們整個家族也不如<char style="pn">猶大</char>的子孫那樣眾多。 <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />他們住在<char style="pn">比爾-謝巴</char>、<char style="pn">漠拉達</char>、<char style="pn">哈薩書爾</char>、 <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" /><char style="pn">碧拉</char>、<char style="pn">埃曾</char>、<char style="pn">托拉德</char>、 <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" /><char style="pn">彼土利</char>、<char style="pn">霍爾瑪</char>、<char style="pn">洗革拉</char>、 <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" /><char style="pn">伯瑪克波</char>、<char style="pn">哈薩蘇撒</char>、<char style="pn">伯比利</char>和<char style="pn">沙拉音</char>。直到<char style="pn">大衛</char>作王，這些都是他們的城， <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />包括附屬的村莊；還有<char style="pn">以坦</char>、<char style="pn">阿音</char>、<char style="pn">臨門</char>、<char style="pn">托肯</char>和<char style="pn">阿珊</char>五座城， <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />以及這些城周圍所有的村莊，直到<char style="pn">巴力</char><note caller="+" style="f"><char style="fr" closed="false">4:33 </char><char style="ft" closed="false">巴力——或譯作「巴阿拉」；參《約書亞記》19:8。</char></note>；這些是他們居住的地方。他們也為自己記錄家譜：<verse eid="1CH 4:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 4:34" />有<char style="pn">米所巴</char>、<char style="pn">雅米勒</char>、<char style="pn">亞瑪謝</char>的兒子<char style="pn">約沙</char>、 <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" /><char style="pn">約珥</char>、<char style="pn">耶戶</char>；<char style="pn">耶戶</char>是<char style="pn">約示比</char>的兒子，<char style="pn">約示比</char>是<char style="pn">西萊雅</char>的兒子，<char style="pn">西萊雅</char>是<char style="pn">阿希業</char>的兒子。<verse eid="1CH 4:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 4:36" />還有<char style="pn">以利約奈</char>、<char style="pn">雅格巴</char>、<char style="pn">約朔海</char>、<char style="pn">亞撒雅</char>、<char style="pn">亞迪業</char>、<char style="pn">耶西瑪利</char>、<char style="pn">比納雅</char>、 <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" /><char style="pn">細撒</char>；<char style="pn">細撒</char>是<char style="pn">示非</char>的兒子，<char style="pn">示非</char>是<char style="pn">亞龍</char>的兒子，<char style="pn">亞龍</char>是<char style="pn">耶達雅</char>的兒子，<char style="pn">耶達雅</char>是<char style="pn">示姆利</char>的兒子，<char style="pn">示姆利</char>是<char style="pn">示瑪雅</char>的兒子。<verse eid="1CH 4:37" /></para>
  <para style="b" />
  <para style="p">
    <verse number="38" style="v" sid="1CH 4:38" />這些按名字記下來的，都是他們各家族的領袖；他們的父家繁衍眾多。 <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />他們往<char style="pn">格多</char>的路口去，直到山谷東邊，為自己的羊群尋找草場。 <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />他們找到了肥沃美好的草場，那地也邊界寬廣，平靜安穩，從前住在那裡的是<char style="pn">含</char>族的人。<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />這些按名字記下來的人，在<char style="pn">猶大</char>王<char style="pn">希西加</char>年間前來，攻擊<char style="pn">含</char>族人的帳篷和在那裡遇見的<char style="pn">米烏尼</char>人，把他們滅絕淨盡，直到今日；又取代他們住在那裡，因為有草場可以牧放他們的羊群。 <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />這些<char style="pn">西緬</char>子孫當中，有五百人往<char style="pn">西珥</char>山去，他們的首領是<char style="pn">伊示</char>的眾子<char style="pn">皮拉提</char>、<char style="pn">尼利雅</char>、<char style="pn">勒法雅</char>和<char style="pn">烏基業</char>。 <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />他們擊殺了<char style="pn">亞瑪力</char>人中逃脫的餘剩者，就住在那裡，直到今日。<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s">魯本子孫</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />以下是<char style="pn">以色列</char>的長子<char style="pn">魯本</char>的子孫。<char style="pn">魯本</char>雖然是長子，但他玷汙了父親的床榻，他的長子名份就被轉給<char style="pn">以色列</char>之子<char style="pn">約瑟</char>的兩個兒子，所以在家譜記錄中沒有長子名份。 <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" /><char style="pn">猶大</char>雖然在他兄弟們中強盛，領袖也是從他而出，但長子名份是屬於<char style="pn">約瑟</char>的。<verse eid="1CH 5:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 5:3" />
    <char style="pn">以色列</char>長子<char style="pn">魯本</char>的兒子是</para>
  <para style="mi" vid="1CH 5:3">
    <char style="pn">哈諾</char>、<char style="pn">法路</char>、<char style="pn">希斯倫</char>和<char style="pn">迦米</char>。<verse eid="1CH 5:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 5:4" />
    <char style="pn">約珥</char>的子孫是：他的兒子<char style="pn">示瑪雅</char>，</para>
  <para style="mi" vid="1CH 5:4">
    <char style="pn">示瑪雅</char>的兒子<char style="pn">歌革</char>，<char style="pn">歌革</char>的兒子<char style="pn">示每</char>，<verse eid="1CH 5:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 5:5" />
    <char style="pn">示每</char>的兒子<char style="pn">米迦</char>，<char style="pn">米迦</char>的兒子<char style="pn">利阿亞</char>，</para>
  <para style="mi" vid="1CH 5:5">
    <char style="pn">利阿亞</char>的兒子<char style="pn">巴力</char>， <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" /><char style="pn">巴力</char>的兒子<char style="pn">備拉</char>。</para>
  <para style="b" vid="1CH 5:6" />
  <para style="p" vid="1CH 5:6">
    <char style="pn">備拉</char>被<char style="pn">亞述</char>王<char style="pn">提革拉·毗列色</char>擄走了，他是<char style="pn">魯本</char>支派的領袖。 <verse eid="1CH 5:6" /><verse number="7" style="v" sid="1CH 5:7" /><char style="pn">備拉</char>的族兄弟，按著自己的家族，照著他們的家系記錄，有首領<char style="pn">耶伊列</char>、<char style="pn">撒迦利亞</char>、 <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" /><char style="pn">比拉</char>；<char style="pn">比拉</char>是<char style="pn">亞撒</char>的兒子，<char style="pn">亞撒</char>是<char style="pn">示瑪</char>的兒子，<char style="pn">示瑪</char>是<char style="pn">約珥</char>的兒子。<char style="pn">約珥</char>住在<char style="pn">亞羅珥</char>，直到<char style="pn">尼波</char>和<char style="pn">巴力梅翁</char>一帶； <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />他又到東邊居住，一直到<char style="pn">幼發拉底</char>河這邊曠野的入口，因為他們在<char style="pn">基列</char>地的牲畜增多了。 <verse eid="1CH 5:9" /><verse number="10" style="v" sid="1CH 5:10" /><char style="pn">掃羅</char>年間，他們與<char style="pn">哈格利</char>人作戰，<char style="pn">哈格利</char>人敗在他們手下，他們就住在<char style="pn">基列</char>東邊全域<char style="pn">哈格利</char>人的帳篷中。<verse eid="1CH 5:10" /></para>
  <para style="b" />
  <para style="s">迦得子孫</para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 5:11" />
    <char style="pn">迦得</char>的子孫在他們對面，住在<char style="pn">巴珊</char>地，直到<char style="pn">撒迦</char>。<verse eid="1CH 5:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 5:12" />他們有首領<char style="pn">約珥</char>，副首領<char style="pn">沙番</char>，還有<char style="pn">雅奈</char>和住在<char style="pn">巴珊</char>的<char style="pn">沙法</char>。<verse eid="1CH 5:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 5:13" />按著他們的父家，他們的族兄弟是<char style="pn">米迦勒</char>、<char style="pn">米書蘭</char>、<char style="pn">示巴</char>、<char style="pn">約賴</char>、<char style="pn">雅干</char>、<char style="pn">細亞</char>和<char style="pn">希伯</char>，共七人。<verse eid="1CH 5:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 5:14" />這些都是<char style="pn">亞比亥</char>的子孫；<char style="pn">亞比亥</char>是<char style="pn">戶利</char>的兒子，</para>
  <para style="mi" vid="1CH 5:14">
    <char style="pn">戶利</char>是<char style="pn">耶羅亞</char>的兒子，<char style="pn">耶羅亞</char>是<char style="pn">基列</char>的兒子，</para>
  <para style="mi" vid="1CH 5:14">
    <char style="pn">基列</char>是<char style="pn">米迦勒</char>的兒子，<char style="pn">米迦勒</char>是<char style="pn">耶示篩</char>的兒子，</para>
  <para style="mi" vid="1CH 5:14">
    <char style="pn">耶示篩</char>是<char style="pn">耶哈多</char>的兒子，<char style="pn">耶哈多</char>是<char style="pn">布斯</char>的兒子。<verse eid="1CH 5:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 5:15" />
    <char style="pn">古尼</char>的孫子、<char style="pn">押比疊</char>的兒子<char style="pn">亞希</char>，是他們父家的首領。 <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />他們住在<char style="pn">基列</char>、<char style="pn">巴珊</char>和附屬的村鎮，以及整個<char style="pn">沙崙</char>牧野，直到它的盡頭。 <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />他們全都在<char style="pn">猶大</char>王<char style="pn">約坦</char>年間和<char style="pn">以色列</char>王<char style="pn">耶羅波安</char>年間，被記錄在家譜中。<verse eid="1CH 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />
    <char style="pn">魯本</char>、<char style="pn">迦得</char>和<char style="pn">瑪拿西</char>半支派的勇士，那些拿盾牌刀劍、拉弓射箭、受過作戰訓練的，有四萬四千七百六十人，都能列隊出戰。 <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />他們與<char style="pn">哈格利</char>人、<char style="pn">伊突</char>人、<char style="pn">拿非施</char>人和<char style="pn">挪達</char>人作戰。 <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />他們得到幫助，<char style="pn">哈格利</char>人和所有與<char style="pn">哈格利</char>人同盟的人都被交在他們手中，因為他們在戰爭中向神哀求，神就因為他們信靠他而應允了他們的祈求。 <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />他們擄掠了<char style="pn">夏甲</char>人的牲畜，有駱駝五萬頭、羊二十五萬隻、驢子兩千隻；還擄掠了人口十萬。 <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />有許多<char style="pn">夏甲</char>人被殺倒下，因為這場戰爭是出於神。他們就取代<char style="pn">夏甲</char>人住下，直到被擄時期。<verse eid="1CH 5:22" /></para>
  <para style="s">瑪拿西半支派</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />
    <char style="pn">瑪拿西</char>半支派的子孫住在那地，從<char style="pn">巴珊</char>直到<char style="pn">巴力黑門</char>、<char style="pn">示尼珥</char>和<char style="pn">黑門</char>山；他們人數眾多。 <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />以下是他們父家的首領：<char style="pn">以弗</char>、<char style="pn">伊示</char>、<char style="pn">以利業</char>、<char style="pn">亞斯列</char>、<char style="pn">耶利米</char>、<char style="pn">赫達維亞</char>、<char style="pn">耶赫迪業</char>，都是英勇的戰士、有名望的人，是他們父家的首領。 <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />但他們對祖先的神不忠，行淫追隨當地之民的神明，這民是神從他們面前所除滅的。 <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />所以，<char style="pn">以色列</char>的神觸動了<char style="pn">亞述</char>王<char style="pn">普勒</char>——<char style="pn">亞述</char>王<char style="pn">提革拉·毗列色</char>的心，他就把<char style="pn">魯本</char>支派、<char style="pn">迦得</char>支派和<char style="pn">瑪拿西</char>半支派的人擄走，帶到了<char style="pn">哈臘</char>、<char style="pn">哈博</char>、<char style="pn">哈拉</char>，以及<char style="pn">歌散</char>河邊，直到今日。<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s">利未人</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">6:1 </char>
      <char style="ft" closed="false">此章在馬索拉文本為5:27至6:66。</char>
    </note>
    <char style="pn">利未</char>的兒子是<char style="pn">革順</char>、<char style="pn">哥轄</char>和<char style="pn">米拉利</char>。<verse eid="1CH 6:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 6:2" />
    <char style="pn">哥轄</char>的兒子是<char style="pn">阿姆蘭</char>、<char style="pn">以斯哈</char>、<char style="pn">希伯倫</char>和<char style="pn">烏基業</char>。<verse eid="1CH 6:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 6:3" />
    <char style="pn">阿姆蘭</char>的兒女是<char style="pn">亞倫</char>、<char style="pn">摩西</char>和<char style="pn">米利暗</char>。</para>
  <para style="mi" vid="1CH 6:3">
    <char style="pn">亞倫</char>的兒子是<char style="pn">納達布</char>、<char style="pn">亞比戶</char>、<char style="pn">以利亞撒</char>和<char style="pn">以塔瑪爾</char>。<verse eid="1CH 6:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 6:4" />
    <char style="pn">以利亞撒</char>生<char style="pn">非尼哈</char>，</para>
  <para style="mi" vid="1CH 6:4">
    <char style="pn">非尼哈</char>生<char style="pn">亞比書</char>，<verse eid="1CH 6:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 6:5" />
    <char style="pn">亞比書</char>生<char style="pn">布其</char>，</para>
  <para style="mi" vid="1CH 6:5">
    <char style="pn">布其</char>生<char style="pn">烏基</char>，<verse eid="1CH 6:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 6:6" />
    <char style="pn">烏基</char>生<char style="pn">西拉希雅</char>，</para>
  <para style="mi" vid="1CH 6:6">
    <char style="pn">西拉希雅</char>生<char style="pn">米拉約</char>，<verse eid="1CH 6:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 6:7" />
    <char style="pn">米拉約</char>生<char style="pn">亞瑪利雅</char>，</para>
  <para style="mi" vid="1CH 6:7">
    <char style="pn">亞瑪利雅</char>生<char style="pn">亞希突</char>，<verse eid="1CH 6:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 6:8" />
    <char style="pn">亞希突</char>生<char style="pn">撒督</char>，</para>
  <para style="mi" vid="1CH 6:8">
    <char style="pn">撒督</char>生<char style="pn">亞希瑪斯</char>，<verse eid="1CH 6:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 6:9" />
    <char style="pn">亞希瑪斯</char>生<char style="pn">亞撒利雅</char>，</para>
  <para style="mi" vid="1CH 6:9">
    <char style="pn">亞撒利雅</char>生<char style="pn">約哈南</char>，<verse eid="1CH 6:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 6:10" />
    <char style="pn">約哈南</char>生<char style="pn">亞撒利雅</char>——他在<char style="pn">所羅門</char>於<char style="pn">耶路撒冷</char>建造的聖殿中作祭司——<verse eid="1CH 6:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 6:11" />
    <char style="pn">亞撒利雅</char>生<char style="pn">亞瑪利雅</char>，</para>
  <para style="mi" vid="1CH 6:11">
    <char style="pn">亞瑪利雅</char>生<char style="pn">亞希突</char>，<verse eid="1CH 6:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 6:12" />
    <char style="pn">亞希突</char>生<char style="pn">撒督</char>，</para>
  <para style="mi" vid="1CH 6:12">
    <char style="pn">撒督</char>生<char style="pn">沙勒姆</char>，<verse eid="1CH 6:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 6:13" />
    <char style="pn">沙勒姆</char>生<char style="pn">希勒加</char>，</para>
  <para style="mi" vid="1CH 6:13">
    <char style="pn">希勒加</char>生<char style="pn">亞撒利雅</char>，<verse eid="1CH 6:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 6:14" />
    <char style="pn">亞撒利雅</char>生<char style="pn">西萊雅</char>，</para>
  <para style="mi" vid="1CH 6:14">
    <char style="pn">西萊雅</char>生<char style="pn">約薩達</char>，<verse eid="1CH 6:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 6:15" />在耶和華藉著<char style="pn">尼布甲尼撒</char>的手擄掠<char style="pn">猶大</char>和<char style="pn">耶路撒冷</char>的時候，<char style="pn">約薩達</char>也被擄去了。<verse eid="1CH 6:15" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="16" style="v" sid="1CH 6:16" />
    <char style="pn">利未</char>的兒子是<char style="pn">革順</char>、<char style="pn">哥轄</char>和<char style="pn">米拉利</char>。<verse eid="1CH 6:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 6:17" />
    <char style="pn">革順</char>的兒子名字是<char style="pn">立尼</char>和<char style="pn">示每</char>。<verse eid="1CH 6:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 6:18" />
    <char style="pn">哥轄</char>的兒子是<char style="pn">阿姆蘭</char>、<char style="pn">以斯哈</char>、<char style="pn">希伯倫</char>和<char style="pn">烏基業</char>。<verse eid="1CH 6:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 6:19" />
    <char style="pn">米拉利</char>的兒子是<char style="pn">瑪赫利</char>和<char style="pn">穆希</char>。</para>
  <para style="mi" vid="1CH 6:19">以下是按著他們的父系，<char style="pn">利未</char>人的各家族：<verse eid="1CH 6:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 6:20" />屬於<char style="pn">革順</char>的，是他的兒子<char style="pn">立尼</char>，</para>
  <para style="mi" vid="1CH 6:20">
    <char style="pn">立尼</char>的兒子<char style="pn">雅哈</char>，<char style="pn">雅哈</char>的兒子<char style="pn">津瑪</char>，<verse eid="1CH 6:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 6:21" />
    <char style="pn">津瑪</char>的兒子<char style="pn">約亞</char>，<char style="pn">約亞</char>的兒子<char style="pn">易多</char>，</para>
  <para style="mi" vid="1CH 6:21">
    <char style="pn">易多</char>的兒子<char style="pn">謝拉</char>，<char style="pn">謝拉</char>的兒子<char style="pn">耶特賴</char>。<verse eid="1CH 6:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 6:22" />
    <char style="pn">哥轄</char>的子孫，是<char style="pn">哥轄</char>的兒子<char style="pn">亞米拿達</char>，</para>
  <para style="mi" vid="1CH 6:22">
    <char style="pn">亞米拿達</char>的兒子<char style="pn">可拉</char>，<char style="pn">可拉</char>的兒子<char style="pn">亞惜</char>，<verse eid="1CH 6:22" /></para>
  <para style="mi">
    <verse number="23" style="v" sid="1CH 6:23" />
    <char style="pn">亞惜</char>的兒子<char style="pn">以利加拿</char>，<char style="pn">以利加拿</char>的兒子<char style="pn">伊比雅撒</char>，</para>
  <para style="mi" vid="1CH 6:23">
    <char style="pn">伊比雅撒</char>的兒子<char style="pn">亞惜</char>， <verse eid="1CH 6:23" /><verse number="24" style="v" sid="1CH 6:24" /><char style="pn">亞惜</char>的兒子<char style="pn">塔哈特</char>，</para>
  <para style="mi" vid="1CH 6:24">
    <char style="pn">塔哈特</char>的兒子<char style="pn">烏列</char>，<char style="pn">烏列</char>的兒子<char style="pn">烏西雅</char>，</para>
  <para style="mi" vid="1CH 6:24">
    <char style="pn">烏西雅</char>的兒子<char style="pn">掃羅</char>；<verse eid="1CH 6:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 6:25" />
    <char style="pn">以利加拿</char>的兒子<char style="pn">亞瑪賽</char>和<char style="pn">亞希莫</char>，<verse eid="1CH 6:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 6:26" />
    <char style="pn">亞希莫</char>的兒子<char style="pn">以利加拿</char>，<char style="pn">以利加拿</char>的兒子<char style="pn">瑣菲</char>，</para>
  <para style="mi" vid="1CH 6:26">
    <char style="pn">瑣菲</char>的兒子<char style="pn">拿哈</char>， <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" /><char style="pn">拿哈</char>的兒子<char style="pn">以利押</char>，</para>
  <para style="mi" vid="1CH 6:27">
    <char style="pn">以利押</char>的兒子<char style="pn">耶羅罕</char>，<char style="pn">耶羅罕</char>的兒子<char style="pn">以利加拿</char>。<verse eid="1CH 6:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 6:28" />
    <char style="pn">撒母耳</char>的兒子是長子<char style="pn">約珥</char>，次子<char style="pn">亞比雅</char>。<verse eid="1CH 6:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 6:29" />
    <char style="pn">米拉利</char>的子孫，是他的兒子<char style="pn">瑪赫利</char>，</para>
  <para style="mi" vid="1CH 6:29">
    <char style="pn">瑪赫利</char>的兒子<char style="pn">立尼</char>，<char style="pn">立尼</char>的兒子<char style="pn">示每</char>，</para>
  <para style="mi" vid="1CH 6:29">
    <char style="pn">示每</char>的兒子<char style="pn">烏撒</char>， <verse eid="1CH 6:29" /><verse number="30" style="v" sid="1CH 6:30" /><char style="pn">烏撒</char>的兒子<char style="pn">示米亞</char>，</para>
  <para style="mi" vid="1CH 6:30">
    <char style="pn">示米亞</char>的兒子<char style="pn">哈基雅</char>，<char style="pn">哈基雅</char>的兒子<char style="pn">亞撒雅</char>。<verse eid="1CH 6:30" /></para>
  <para style="s">唱詩班</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />以下是約櫃安定下來以後，<char style="pn">大衛</char>設立在耶和華殿中掌管歌唱的人。 <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />他們從前是在會幕的帳幕前用歌唱事奉的，直到<char style="pn">所羅門</char>在<char style="pn">耶路撒冷</char>建造了耶和華的殿，他們就照著慣例服事供職。 <verse eid="1CH 6:32" /><verse number="33" style="v" sid="1CH 6:33" />這些供職的人以及他們的子孫如下：</para>
  <para style="mi" vid="1CH 6:33">
    <char style="pn">哥轄</char>的子孫中有歌唱者<char style="pn">希幔</char>，</para>
  <para style="mi" vid="1CH 6:33">他是<char style="pn">約珥</char>的兒子，<char style="pn">約珥</char>是<char style="pn">撒母耳</char>的兒子，<verse eid="1CH 6:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 6:34" />
    <char style="pn">撒母耳</char>是<char style="pn">以利加拿</char>的兒子，<char style="pn">以利加拿</char>是<char style="pn">耶羅罕</char>的兒子，</para>
  <para style="mi" vid="1CH 6:34">
    <char style="pn">耶羅罕</char>是<char style="pn">以利業</char>的兒子，<char style="pn">以利業</char>是<char style="pn">托阿</char>的兒子，<verse eid="1CH 6:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 6:35" />
    <char style="pn">托阿</char>是<char style="pn">蘇弗</char>的兒子，<char style="pn">蘇弗</char>是<char style="pn">以利加拿</char>的兒子，</para>
  <para style="mi" vid="1CH 6:35">
    <char style="pn">以利加拿</char>是<char style="pn">瑪哈</char>的兒子，<char style="pn">瑪哈</char>是<char style="pn">亞瑪賽</char>的兒子，<verse eid="1CH 6:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 6:36" />
    <char style="pn">亞瑪賽</char>是<char style="pn">以利加拿</char>的兒子，<char style="pn">以利加拿</char>是<char style="pn">約珥</char>的兒子，</para>
  <para style="mi" vid="1CH 6:36">
    <char style="pn">約珥</char>是<char style="pn">亞撒利雅</char>的兒子，<char style="pn">亞撒利雅</char>是<char style="pn">西番雅</char>的兒子，<verse eid="1CH 6:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="1CH 6:37" />
    <char style="pn">西番雅</char>是<char style="pn">塔哈特</char>的兒子，<char style="pn">塔哈特</char>是<char style="pn">亞惜</char>的兒子，</para>
  <para style="mi" vid="1CH 6:37">
    <char style="pn">亞惜</char>是<char style="pn">伊比雅撒</char>的兒子，<char style="pn">伊比雅撒</char>是<char style="pn">可拉</char>的兒子，<verse eid="1CH 6:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 6:38" />
    <char style="pn">可拉</char>是<char style="pn">以斯哈</char>的兒子，<char style="pn">以斯哈</char>是<char style="pn">哥轄</char>的兒子，</para>
  <para style="mi" vid="1CH 6:38">
    <char style="pn">哥轄</char>是<char style="pn">利未</char>的兒子，<char style="pn">利未</char>是<char style="pn">以色列</char>的兒子。<verse eid="1CH 6:38" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="39" style="v" sid="1CH 6:39" />站在<char style="pn">希幔</char>右邊的是他的兄弟<char style="pn">亞薩</char>，</para>
  <para style="mi" vid="1CH 6:39">
    <char style="pn">亞薩</char>是<char style="pn">比利迦</char>的兒子，<char style="pn">比利迦</char>是<char style="pn">示米亞</char>的兒子，<verse eid="1CH 6:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 6:40" />
    <char style="pn">示米亞</char>是<char style="pn">米迦勒</char>的兒子，<char style="pn">米迦勒</char>是<char style="pn">巴西雅</char>的兒子，</para>
  <para style="mi" vid="1CH 6:40">
    <char style="pn">巴西雅</char>是<char style="pn">瑪基雅</char>的兒子， <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" /><char style="pn">瑪基雅</char>是<char style="pn">伊特尼</char>的兒子，</para>
  <para style="mi" vid="1CH 6:41">
    <char style="pn">伊特尼</char>是<char style="pn">謝拉</char>的兒子，<char style="pn">謝拉</char>是<char style="pn">亞達雅</char>的兒子，<verse eid="1CH 6:41" /></para>
  <para style="mi">
    <verse number="42" style="v" sid="1CH 6:42" />
    <char style="pn">亞達雅</char>是<char style="pn">伊坦</char>的兒子，<char style="pn">伊坦</char>是<char style="pn">津瑪</char>的兒子，</para>
  <para style="mi" vid="1CH 6:42">
    <char style="pn">津瑪</char>是<char style="pn">示每</char>的兒子， <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" /><char style="pn">示每</char>是<char style="pn">雅哈</char>的兒子，</para>
  <para style="mi" vid="1CH 6:43">
    <char style="pn">雅哈</char>是<char style="pn">革順</char>的兒子，<char style="pn">革順</char>是<char style="pn">利未</char>的兒子。<verse eid="1CH 6:43" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="44" style="v" sid="1CH 6:44" />他們的族兄弟<char style="pn">米拉利</char>的子孫<char style="pn">伊坦</char>站在左邊，</para>
  <para style="mi" vid="1CH 6:44">
    <char style="pn">伊坦</char>是<char style="pn">基示</char>的兒子，<char style="pn">基示</char>是<char style="pn">阿伯迪</char>的兒子，</para>
  <para style="mi" vid="1CH 6:44">
    <char style="pn">阿伯迪</char>是<char style="pn">瑪盧克</char>的兒子， <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" /><char style="pn">瑪盧克</char>是<char style="pn">哈沙比雅</char>的兒子，</para>
  <para style="mi" vid="1CH 6:45">
    <char style="pn">哈沙比雅</char>是<char style="pn">亞瑪謝</char>的兒子，<char style="pn">亞瑪謝</char>是<char style="pn">希勒加</char>的兒子，<verse eid="1CH 6:45" /></para>
  <para style="mi">
    <verse number="46" style="v" sid="1CH 6:46" />
    <char style="pn">希勒加</char>是<char style="pn">阿姆基</char>的兒子，<char style="pn">阿姆基</char>是<char style="pn">巴尼</char>的兒子，</para>
  <para style="mi" vid="1CH 6:46">
    <char style="pn">巴尼</char>是<char style="pn">謝梅爾</char>的兒子， <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" /><char style="pn">謝梅爾</char>是<char style="pn">瑪赫利</char>的兒子，</para>
  <para style="mi" vid="1CH 6:47">
    <char style="pn">瑪赫利</char>是<char style="pn">穆希</char>的兒子，<char style="pn">穆希</char>是<char style="pn">米拉利</char>的子孫，</para>
  <para style="mi" vid="1CH 6:47">
    <char style="pn">米拉利</char>是<char style="pn">利未</char>的兒子。<verse eid="1CH 6:47" /></para>
  <para style="s">亞倫子孫</para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />他們的<char style="pn">利未</char>兄弟們被指定辦理神殿中帳幕的一切服事。 <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" /><char style="pn">亞倫</char>和他的子孫照著神的僕人<char style="pn">摩西</char>所吩咐的一切，在燔祭壇和香壇上燒獻，負責至聖所的一切工作，為<char style="pn">以色列</char>贖罪。<verse eid="1CH 6:49" /></para>
  <para style="mi">
    <verse number="50" style="v" sid="1CH 6:50" />
    <char style="pn">亞倫</char>的子孫如下：<char style="pn">亞倫</char>的兒子<char style="pn">以利亞撒</char>，</para>
  <para style="mi" vid="1CH 6:50">
    <char style="pn">以利亞撒</char>的兒子<char style="pn">非尼哈</char>，<char style="pn">非尼哈</char>的兒子<char style="pn">亞比書</char>，<verse eid="1CH 6:50" /></para>
  <para style="mi">
    <verse number="51" style="v" sid="1CH 6:51" />
    <char style="pn">亞比書</char>的兒子<char style="pn">布其</char>，<char style="pn">布其</char>的兒子<char style="pn">烏基</char>，</para>
  <para style="mi" vid="1CH 6:51">
    <char style="pn">烏基</char>的兒子<char style="pn">西拉希雅</char>， <verse eid="1CH 6:51" /><verse number="52" style="v" sid="1CH 6:52" /><char style="pn">西拉希雅</char>的兒子<char style="pn">米拉約</char>，</para>
  <para style="mi" vid="1CH 6:52">
    <char style="pn">米拉約</char>的兒子<char style="pn">亞瑪利雅</char>，<char style="pn">亞瑪利雅</char>的兒子<char style="pn">亞希突</char>，<verse eid="1CH 6:52" /></para>
  <para style="mi">
    <verse number="53" style="v" sid="1CH 6:53" />
    <char style="pn">亞希突</char>的兒子<char style="pn">撒督</char>，<char style="pn">撒督</char>的兒子<char style="pn">亞希瑪斯</char>。<verse eid="1CH 6:53" /></para>
  <para style="s">利未人的居所</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />以下是他們在自己境內，按著各自的營寨居住的地方：</para>
  <para style="p" vid="1CH 6:54">
    <char style="pn">哥轄</char>家族中的<char style="pn">亞倫</char>子孫先抽籤， <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />分得了<char style="pn">猶大</char>地的<char style="pn">希伯崙</char>和周圍的牧野； <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />至於這城的田野和村莊，<char style="pn">以色列</char>人已經給了<char style="pn">耶弗尼</char>的兒子<char style="pn">迦勒</char>。<verse eid="1CH 6:56" /></para>
  <para style="mi">
    <verse number="57" style="v" sid="1CH 6:57" />
    <char style="pn">亞倫</char>子孫分得了逃城<char style="pn">希伯崙</char>，<char style="pn">立拿</char>和附屬的牧野，<char style="pn">雅提珥</char>，<char style="pn">以實提莫</char>和附屬的牧野， <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" /><char style="pn">希崙</char>和附屬的牧野，<char style="pn">底璧</char>和附屬的牧野， <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" /><char style="pn">阿珊</char>和附屬的牧野，<char style="pn">伯示麥</char>和附屬的牧野。 <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />又從<char style="pn">便雅憫</char>支派中，得了<char style="pn">迦巴</char>和附屬的牧野，<char style="pn">阿勒米特</char>和附屬的牧野，<char style="pn">亞納圖</char>和附屬的牧野。他們各家族總共得了十三座城。<verse eid="1CH 6:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="1CH 6:61" />至於<char style="pn">哥轄</char>其餘的子孫，從別的支派家族，就是從<char style="pn">瑪拿西</char>半支派中，抽籤得了十座城。<verse eid="1CH 6:61" /></para>
  <para style="b" />
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62" />
    <char style="pn">革順</char>子孫，按著他們的家族，從<char style="pn">以薩迦</char>支派、<char style="pn">亞設</char>支派、<char style="pn">拿弗他利</char>支派和在<char style="pn">巴珊</char>地的<char style="pn">瑪拿西</char>支派中，得了十三座城。<verse eid="1CH 6:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="1CH 6:63" />
    <char style="pn">米拉利</char>子孫，按著他們的家族，從<char style="pn">魯本</char>支派、<char style="pn">迦得</char>支派和<char style="pn">西布倫</char>支派中，抽籤得了十二座城。<verse eid="1CH 6:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="1CH 6:64" />這樣，<char style="pn">以色列</char>人把這些城和附屬的牧野分給了<char style="pn">利未</char>人。 <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />他們還按照抽籤，從<char style="pn">猶大</char>支派、<char style="pn">西緬</char>支派和<char style="pn">便雅憫</char>支派中，把那些點到名字的城分給了<char style="pn">利未</char>人。<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />
    <char style="pn">哥轄</char>子孫的一些家族，也得了<char style="pn">以法蓮</char>支派境內的城。<verse eid="1CH 6:66" /></para>
  <para style="mi">
    <verse number="67" style="v" sid="1CH 6:67" />他們分得了<char style="pn">以法蓮</char>山地的逃城<char style="pn">示劍</char>和附屬的牧野，<char style="pn">基色</char>和附屬的牧野， <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" /><char style="pn">約克緬</char>和附屬的牧野，<char style="pn">伯賀崙</char>和附屬的牧野， <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" /><char style="pn">阿雅崙</char>和附屬的牧野，<char style="pn">迦特臨門</char>和附屬的牧野。 <verse eid="1CH 6:69" /><verse number="70" style="v" sid="1CH 6:70" />還從<char style="pn">瑪拿西</char>半支派中，分給<char style="pn">哥轄</char>子孫其餘的家族：<char style="pn">阿內爾</char>和附屬的牧野，<char style="pn">比連</char>和附屬的牧野。<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="p">
    <verse number="71" style="v" sid="1CH 6:71" />
    <char style="pn">革順</char>子孫，</para>
  <para style="mi" vid="1CH 6:71">從<char style="pn">瑪拿西</char>半支派的家族中，得了<char style="pn">巴珊</char>的<char style="pn">戈蘭</char>和附屬的牧野，<char style="pn">亞斯他錄</char>和附屬的牧野； <verse eid="1CH 6:71" /><verse number="72" style="v" sid="1CH 6:72" />從<char style="pn">以薩迦</char>支派中，得了<char style="pn">基低斯</char>和附屬的牧野，<char style="pn">達比拉</char>和附屬的牧野， <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" /><char style="pn">拉末</char>和附屬的牧野，<char style="pn">亞年</char>和附屬的牧野； <verse eid="1CH 6:73" /><verse number="74" style="v" sid="1CH 6:74" />從<char style="pn">亞設</char>支派中，得了<char style="pn">瑪沙</char>和附屬的牧野，<char style="pn">阿布頓</char>和附屬的牧野， <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" /><char style="pn">戶割</char>和附屬的牧野，<char style="pn">利合</char>和附屬的牧野； <verse eid="1CH 6:75" /><verse number="76" style="v" sid="1CH 6:76" />從<char style="pn">拿弗他利</char>支派中，得了<char style="pn">加利利</char>的<char style="pn">基低斯</char>和附屬的牧野，<char style="pn">哈門</char>和附屬的牧野，<char style="pn">基列亭</char>和附屬的牧野。<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="p">
    <verse number="77" style="v" sid="1CH 6:77" />
    <char style="pn">米拉利</char>子孫——其餘的<char style="pn">利未</char>人，</para>
  <para style="mi" vid="1CH 6:77">從<char style="pn">西布倫</char>支派中，得了<char style="pn">臨摩挪</char>和附屬的牧野，<char style="pn">他泊</char>和附屬的牧野； <verse eid="1CH 6:77" /><verse number="78" style="v" sid="1CH 6:78" />從<char style="pn">魯本</char>支派中，在<char style="pn">耶利哥</char>的<char style="pn">約旦</char>河對面，就是<char style="pn">約旦</char>河東邊，得了在曠野中的<char style="pn">比冊爾</char>和附屬的牧野，<char style="pn">雅哈茲</char>和附屬的牧野， <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" /><char style="pn">基底莫</char>和附屬的牧野，<char style="pn">米法押</char>和附屬的牧野； <verse eid="1CH 6:79" /><verse number="80" style="v" sid="1CH 6:80" />從<char style="pn">迦得</char>支派中，得了<char style="pn">基列</char>的<char style="pn">拉末</char>和附屬的牧野，<char style="pn">瑪哈念</char>和附屬的牧野， <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" /><char style="pn">希實本</char>和附屬的牧野，<char style="pn">雅謝</char>和附屬的牧野。<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s">以薩迦子孫</para>
  <para style="mi">
    <verse number="1" style="v" sid="1CH 7:1" />
    <char style="pn">以薩迦</char>的兒子是<char style="pn">陀拉</char>、<char style="pn">普瓦</char>、<char style="pn">雅實布</char>和<char style="pn">希姆崙</char>，共四人。<verse eid="1CH 7:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 7:2" />
    <char style="pn">陀拉</char>的兒子是<char style="pn">烏基</char>、<char style="pn">勒法雅</char>、<char style="pn">耶勒</char>、<char style="pn">雅買</char>、<char style="pn">易伯散</char>和<char style="pn">撒母耳</char>，都是他們父家的首領，是<char style="pn">陀拉</char>族譜系中英勇的戰士，<char style="pn">大衛</char>年間他們的數目有兩萬兩千六百人。<verse eid="1CH 7:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 7:3" />
    <char style="pn">烏基</char>的兒子是<char style="pn">伊斯拉希雅</char>，<char style="pn">伊斯拉希雅</char>的兒子是<char style="pn">米迦勒</char>、<char style="pn">俄巴底亞</char>、<char style="pn">約珥</char>和<char style="pn">伊示亞</char>，共五人，都是首領。 <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />按著他們父家的譜系，跟隨他們的作戰軍兵有三萬六千人，因為他們的妻兒眾多。 <verse eid="1CH 7:4" /><verse number="5" style="v" sid="1CH 7:5" />他們的族兄弟，<char style="pn">以薩迦</char>所有家族中英勇的戰士，按著他們的家譜記錄，共有八萬七千人。<verse eid="1CH 7:5" /></para>
  <para style="b" />
  <para style="s">便雅憫子孫</para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 7:6" />
    <char style="pn">便雅憫</char>的兒子是<char style="pn">比拉</char>、<char style="pn">比結</char>和<char style="pn">耶迪阿業</char>，共三人。<verse eid="1CH 7:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 7:7" />
    <char style="pn">比拉</char>的兒子是<char style="pn">伊茲本</char>、<char style="pn">烏基</char>、<char style="pn">烏基業</char>、<char style="pn">耶利莫</char>和<char style="pn">以利</char>，共五人，都是他們父家的首領，是英勇的戰士。他們記錄家譜的，有兩萬兩千零三十四人。<verse eid="1CH 7:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 7:8" />
    <char style="pn">比結</char>的兒子是<char style="pn">細米拉</char>、<char style="pn">約阿施</char>、<char style="pn">以利以謝</char>、<char style="pn">以利約奈</char>、<char style="pn">歐姆利</char>、<char style="pn">耶利莫</char>、<char style="pn">亞比雅</char>、<char style="pn">亞納圖</char>和<char style="pn">阿勒米特</char>，這都是<char style="pn">比結</char>的兒子。 <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />他們按著各父家首領的譜系記錄了家譜，都是英勇的戰士，共兩萬零兩百人。<verse eid="1CH 7:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 7:10" />
    <char style="pn">耶迪阿業</char>的兒子是<char style="pn">比勒罕</char>，<char style="pn">比勒罕</char>的兒子是<char style="pn">耶烏施</char>、<char style="pn">便雅憫</char>、<char style="pn">以胡德</char>、<char style="pn">克拿阿納</char>、<char style="pn">細坦</char>、<char style="pn">塔爾施</char>和<char style="pn">亞希沙哈</char>。 <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />這些都是<char style="pn">耶迪阿業</char>的兒子，是各父系的首領、英勇的戰士；他們能上陣出戰的，共一萬七千兩百人。 <verse eid="1CH 7:11" /><verse number="12" style="v" sid="1CH 7:12" />此外還有<char style="pn">以珥</char>的兒子<char style="pn">書皮姆</char>和<char style="pn">戶皮姆</char>，<char style="pn">阿赫爾</char>的兒子<char style="pn">戶西姆</char>。<verse eid="1CH 7:12" /></para>
  <para style="b" />
  <para style="s">拿弗他利子孫</para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 7:13" />
    <char style="pn">拿弗他利</char>的兒子是<char style="pn">雅赫茲列</char>、<char style="pn">古尼</char>、<char style="pn">耶則爾</char>、<char style="pn">沙勒姆</char>。他們都是<char style="pn">碧拉</char>的子孫。<verse eid="1CH 7:13" /></para>
  <para style="b" />
  <para style="s">瑪拿西子孫</para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 7:14" />
    <char style="pn">瑪拿西</char>的兒子是<char style="pn">亞斯列</char>，是他的<char style="pn">亞蘭</char>妾所生的，她還生了<char style="pn">基列</char>的父親<char style="pn">瑪吉</char>。 <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" /><char style="pn">瑪吉</char>娶了一個妻子，是<char style="pn">戶皮姆</char>和<char style="pn">書皮姆</char>的妹妹，名叫<char style="pn">瑪迦</char>。<char style="pn">瑪吉</char>有另一繫的子孫<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="ft" closed="false">瑪吉……的子孫——輔助詞語；參《約書亞記》17:3。</char></note>名叫<char style="pn">西羅非哈</char>，<char style="pn">西羅非哈</char>只有女兒。 <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" /><char style="pn">瑪吉</char>的妻子<char style="pn">瑪迦</char>生了一個兒子，她給他起名為<char style="pn">佩雷示</char>；<char style="pn">佩雷示</char>的兄弟名叫<char style="pn">謝雷示</char>，<char style="pn">謝雷示</char>的兒子是<char style="pn">烏蘭</char>和<char style="pn">利肯</char>， <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" /><char style="pn">烏蘭</char>的兒子是<char style="pn">比丹</char>。</para>
  <para style="mi" vid="1CH 7:17">這些是<char style="pn">基列</char>的子孫，<char style="pn">基列</char>是<char style="pn">瑪吉</char>的兒子，<char style="pn">瑪吉</char>是<char style="pn">瑪拿西</char>的兒子。 <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" /><char style="pn">基列</char>的妹妹<char style="pn">哈莫莉克</char>生了<char style="pn">伊施赫德</char>、<char style="pn">亞比以謝</char>、<char style="pn">瑪拉</char>。<verse eid="1CH 7:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 7:19" />
    <char style="pn">謝米達</char>的兒子是<char style="pn">阿西揚</char>、<char style="pn">示劍</char>、<char style="pn">利克希</char>、<char style="pn">阿尼安</char>。<verse eid="1CH 7:19" /></para>
  <para style="b" />
  <para style="s">以法蓮子孫</para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 7:20" />
    <char style="pn">以法蓮</char>的兒子是<char style="pn">書提拉</char>，</para>
  <para style="mi" vid="1CH 7:20">
    <char style="pn">書提拉</char>的兒子是<char style="pn">貝列德</char>，</para>
  <para style="mi" vid="1CH 7:20">
    <char style="pn">貝列德</char>的兒子是<char style="pn">塔哈特</char>，</para>
  <para style="mi" vid="1CH 7:20">
    <char style="pn">塔哈特</char>的兒子是<char style="pn">伊拉達</char>，</para>
  <para style="mi" vid="1CH 7:20">
    <char style="pn">伊拉達</char>的兒子是<char style="pn">塔哈特</char>，<verse eid="1CH 7:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 7:21" />
    <char style="pn">塔哈特</char>的兒子是<char style="pn">撒巴德</char>，</para>
  <para style="mi" vid="1CH 7:21">
    <char style="pn">撒巴德</char>的兒子是<char style="pn">書提拉</char>。</para>
  <para style="mi" vid="1CH 7:21">
    <char style="pn">以法蓮</char>的兒子還有<char style="pn">以謝爾</char>和<char style="pn">以利亞德</char>，被當地的<char style="pn">迦特</char>人殺了，因為他們下去奪取<char style="pn">迦特</char>人的牲畜。 <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />他們的父親<char style="pn">以法蓮</char>悲慟了許多日子，他的族兄弟都來安慰他。 <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />後來<char style="pn">以法蓮</char>與妻子同房，她就懷孕，生了一個兒子，<char style="pn">以法蓮</char>給兒子起名為<char style="pn">比利亞</char>，因為他家裡遭了禍患。 <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />他的女兒是<char style="pn">謝伊拉</char>，<char style="pn">謝伊拉</char>建造了下<char style="pn">伯賀崙</char>和上<char style="pn">伯賀崙</char>，以及<char style="pn">烏曾-謝伊拉</char>。<verse eid="1CH 7:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 7:25" />
    <char style="pn">比利亞</char>的兒子是<char style="pn">利法</char>和<char style="pn">利謝</char>，</para>
  <para style="mi" vid="1CH 7:25">
    <char style="pn">利謝</char>的兒子是<char style="pn">特拉</char>，</para>
  <para style="mi" vid="1CH 7:25">
    <char style="pn">特拉</char>的兒子是<char style="pn">塔罕</char>，<verse eid="1CH 7:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 7:26" />
    <char style="pn">塔罕</char>的兒子是<char style="pn">拉丹</char>，</para>
  <para style="mi" vid="1CH 7:26">
    <char style="pn">拉丹</char>的兒子是<char style="pn">亞米忽</char>，</para>
  <para style="mi" vid="1CH 7:26">
    <char style="pn">亞米忽</char>的兒子是<char style="pn">以利沙瑪</char>，<verse eid="1CH 7:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 7:27" />
    <char style="pn">以利沙瑪</char>的兒子是<char style="pn">嫩</char>，</para>
  <para style="mi" vid="1CH 7:27">
    <char style="pn">嫩</char>的兒子是<char style="pn">約書亞</char>。<verse eid="1CH 7:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28" />他們的產業和居住的地方是<char style="pn">伯特利</char>和附屬的村鎮，東邊的<char style="pn">拿蘭</char>，西邊的<char style="pn">基色</char>和附屬的村鎮，以及<char style="pn">示劍</char>和附屬的村鎮，直到<char style="pn">艾雅</char>和附屬的村鎮； <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />還有靠近<char style="pn">瑪拿西</char>子孫邊界的<char style="pn">伯珊</char>和附屬的村鎮，<char style="pn">特納克</char>和附屬的村鎮，<char style="pn">米吉多</char>和附屬的村鎮，<char style="pn">多珥</char>和附屬的村鎮。<char style="pn">以色列</char>的兒子<char style="pn">約瑟</char>的子孫就住在這些地方。<verse eid="1CH 7:29" /></para>
  <para style="b" />
  <para style="s">亞設子孫</para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 7:30" />
    <char style="pn">亞設</char>的兒子是<char style="pn">伊姆納</char>、<char style="pn">伊施瓦</char>、<char style="pn">伊施韋</char>和<char style="pn">比利亞</char>，還有他們的妹妹<char style="pn">西拉</char>。<verse eid="1CH 7:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 7:31" />
    <char style="pn">比利亞</char>的兒子是<char style="pn">希伯</char>和<char style="pn">瑪結</char>，<char style="pn">瑪結</char>是<char style="pn">比爾仔特</char>的父親。<verse eid="1CH 7:31" /></para>
  <para style="mi">
    <verse number="32" style="v" sid="1CH 7:32" />
    <char style="pn">希伯</char>生了<char style="pn">雅弗列</char>、<char style="pn">朔梅爾</char>、<char style="pn">赫坦</char>和他們的妹妹<char style="pn">淑雅</char>。<verse eid="1CH 7:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 7:33" />
    <char style="pn">雅弗列</char>的兒子是<char style="pn">琶薩</char>、<char style="pn">賓哈勒</char>和<char style="pn">阿示瓦</char>，這些是<char style="pn">雅弗列</char>的兒子。<verse eid="1CH 7:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 7:34" />
    <char style="pn">朔梅爾</char>的兒子是<char style="pn">亞希</char>、<char style="pn">羅迦</char>、<char style="pn">戶巴</char><note caller="+" style="f"><char style="fr" closed="false">7:34 </char><char style="ft" closed="false">戶巴——傳統音譯作「耶戶巴」。</char></note>和<char style="pn">亞蘭</char>。<verse eid="1CH 7:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 7:35" />他的兄弟<char style="pn">希連</char>的兒子是<char style="pn">佐法</char>、<char style="pn">伊姆納</char>、<char style="pn">示列斯</char>和<char style="pn">亞瑪爾</char>。<verse eid="1CH 7:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 7:36" />
    <char style="pn">佐法</char>的兒子是<char style="pn">蘇阿赫</char>、<char style="pn">哈尼弗</char>、<char style="pn">書阿勒</char>、<char style="pn">比利</char>、<char style="pn">伊姆拉</char>、 <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" /><char style="pn">比冊爾</char>、<char style="pn">赫德</char>、<char style="pn">沙瑪</char>、<char style="pn">希勒沙</char>、<char style="pn">益蘭</char>、<char style="pn">比爾拉</char>。<verse eid="1CH 7:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 7:38" />
    <char style="pn">耶特爾</char>的兒子是<char style="pn">耶弗尼</char>、<char style="pn">皮斯巴</char>和<char style="pn">阿拉</char>。<verse eid="1CH 7:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 7:39" />
    <char style="pn">烏拉</char>的兒子是<char style="pn">阿拉赫</char>、<char style="pn">哈尼業</char>和<char style="pn">利茨業</char>。<verse eid="1CH 7:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 7:40" />這些人都是<char style="pn">亞設</char>的子孫，是他們父家的首領，是精選的勇士，在領袖中為首。他們的家譜記錄裡，能上陣出戰的，數目有兩萬六千人。<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s">便雅憫子孫</para>
  <para style="mi">
    <verse number="1" style="v" sid="1CH 8:1" />
    <char style="pn">便雅憫</char>生了長子<char style="pn">比拉</char>，</para>
  <para style="mi" vid="1CH 8:1">次子<char style="pn">阿實別</char>，三子<char style="pn">亞哈拉</char>，<verse eid="1CH 8:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 8:2" />四子<char style="pn">挪哈</char>，五子<char style="pn">勒法</char>。<verse eid="1CH 8:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 8:3" />
    <char style="pn">比拉</char>的兒子是<char style="pn">阿達爾</char>、<char style="pn">基拉</char>、<char style="pn">亞比忽</char>、<verse eid="1CH 8:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 8:4" />
    <char style="pn">亞比書</char>、<char style="pn">奈曼</char>、<char style="pn">亞何亞</char>、<verse eid="1CH 8:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 8:5" />
    <char style="pn">基拉</char>、<char style="pn">謝弗番</char>和<char style="pn">戶蘭</char>。<verse eid="1CH 8:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 8:6" />以下是<char style="pn">埃胡德</char>的子孫，他們這些人是<char style="pn">迦巴</char>居民各父系的首領，曾被遷徙到<char style="pn">瑪拿哈</char>； <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />有<char style="pn">奈曼</char>、<char style="pn">亞希雅</char>、<char style="pn">基拉</char>——是他使他們遷徙的——<char style="pn">基拉</char>生了<char style="pn">烏撒</char>和<char style="pn">亞希忽</char>。<verse eid="1CH 8:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 8:8" />
    <char style="pn">沙哈萊姆</char>休了他的兩個妻子<char style="pn">戶茜姆</char>和<char style="pn">巴阿拉</char>以後，又在<char style="pn">摩押</char>地生養孩子， <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />他的妻子<char style="pn">赫德示</char>生了<char style="pn">約巴</char>、<char style="pn">洗比雅</char>、<char style="pn">米沙</char>、<char style="pn">瑪勒幹</char>、 <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" /><char style="pn">耶烏茲</char>、<char style="pn">撒其亞</char>和<char style="pn">米爾瑪</char>；這些都是他的兒子，是各父系的首領。 <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />他與<char style="pn">戶茜姆</char>生了<char style="pn">阿比突</char>和<char style="pn">以利帕力</char>。<verse eid="1CH 8:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 8:12" />
    <char style="pn">以利帕力</char>的子孫是<char style="pn">希伯</char>、<char style="pn">米珊</char>和<char style="pn">謝梅德</char>，<char style="pn">謝梅德</char>建造了<char style="pn">阿挪</char>和<char style="pn">羅德</char>以及附屬的村鎮。<verse eid="1CH 8:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 8:13" />還有<char style="pn">比利亞</char>和<char style="pn">示瑪</char>，他們是<char style="pn">阿雅崙</char>的居民各父系的首領，他們曾經趕走了<char style="pn">迦特</char>的居民；<verse eid="1CH 8:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 8:14" />又有<char style="pn">亞希約</char>、<char style="pn">沙煞</char>、<char style="pn">耶利莫</char>、 <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" /><char style="pn">希巴迪亞</char>、<char style="pn">阿拉德</char>、<char style="pn">埃德</char>、 <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" /><char style="pn">米迦勒</char>、<char style="pn">伊施巴</char>和<char style="pn">約哈</char>，都是<char style="pn">比利亞</char>的兒子；<verse eid="1CH 8:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 8:17" />又有<char style="pn">希巴迪亞</char>、<char style="pn">米書蘭</char>、<char style="pn">希西基</char>、<char style="pn">希伯</char>、 <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" /><char style="pn">伊施米萊</char>、<char style="pn">伊斯利亞</char>和<char style="pn">約巴</char>。他們都是<char style="pn">以利帕力</char>的兒子。<verse eid="1CH 8:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 8:19" />還有<char style="pn">雅其姆</char>、<char style="pn">澤克利</char>、<char style="pn">扎布迪</char>、 <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" /><char style="pn">以利乃</char>、<char style="pn">洗勒太</char>、<char style="pn">以利業</char>、 <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" /><char style="pn">亞達雅</char>、<char style="pn">比拉雅</char>和<char style="pn">申拉</char>，都是<char style="pn">示每</char>的兒子；<verse eid="1CH 8:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 8:22" />
    <char style="pn">伊施班</char>、<char style="pn">希伯</char>、<char style="pn">以利業</char>、 <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" /><char style="pn">阿布頓</char>、<char style="pn">澤克利</char>、<char style="pn">哈南</char>、 <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" /><char style="pn">哈納尼雅</char>、<char style="pn">以攔</char>、<char style="pn">安陀提雅</char>、 <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" /><char style="pn">伊弗底雅</char>和<char style="pn">毗努伊勒</char>，都是<char style="pn">沙煞</char>的兒子；<verse eid="1CH 8:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 8:26" />
    <char style="pn">珊示萊</char>、<char style="pn">示哈利</char>、<char style="pn">亞塔利雅</char>、 <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" /><char style="pn">雅利西</char>、<char style="pn">以利亞</char>和<char style="pn">澤克利</char>，都是<char style="pn">耶羅罕</char>的兒子。<verse eid="1CH 8:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 8:28" />這些人都是各父系的首領，在他們的譜系中為首。他們住在<char style="pn">耶路撒冷</char>。<verse eid="1CH 8:28" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="29" style="v" sid="1CH 8:29" />
    <char style="pn">基遍</char>之祖<char style="pn">耶伊列</char><note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">耶伊列——輔助詞語；參《歷代志上》9:35。</char></note>住在<char style="pn">基遍</char>，他的妻子名叫<char style="pn">瑪迦</char>。 <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />他的長子是<char style="pn">阿布頓</char>，然後是<char style="pn">蘇珥</char>、<char style="pn">基士</char>、<char style="pn">巴力</char>、<char style="pn">納達布</char>、 <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" /><char style="pn">格多</char>、<char style="pn">亞希約</char>、<char style="pn">撒迦</char>、 <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" /><char style="pn">米克羅</char>；<char style="pn">米克羅</char>生了<char style="pn">示米亞</char>。他們也與族兄弟一同住在<char style="pn">耶路撒冷</char>，在他們眾兄弟對面。<verse eid="1CH 8:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 8:33" />
    <char style="pn">尼珥</char>生<char style="pn">基士</char>，<char style="pn">基士</char>生<char style="pn">掃羅</char>，<char style="pn">掃羅</char>生了<char style="pn">約拿單</char>、<char style="pn">麥基舒亞</char>、<char style="pn">亞比拿達</char>和<char style="pn">伊施巴力</char>。<verse eid="1CH 8:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 8:34" />
    <char style="pn">約拿單</char>的兒子是<char style="pn">米力巴力</char>，<char style="pn">米力巴力</char>生了<char style="pn">米迦</char>。<verse eid="1CH 8:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 8:35" />
    <char style="pn">米迦</char>的兒子是<char style="pn">皮敦</char>、<char style="pn">米勒</char>、<char style="pn">塔利亞</char>和<char style="pn">亞哈斯</char>。<verse eid="1CH 8:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 8:36" />
    <char style="pn">亞哈斯</char>生<char style="pn">耶赫阿達</char>，</para>
  <para style="mi" vid="1CH 8:36">
    <char style="pn">耶赫阿達</char>生<char style="pn">阿勒米特</char>、<char style="pn">阿茲瑪維</char>和<char style="pn">澤姆利</char>，</para>
  <para style="mi" vid="1CH 8:36">
    <char style="pn">澤姆利</char>生<char style="pn">莫扎</char>， <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" /><char style="pn">莫扎</char>生<char style="pn">比尼亞</char>，</para>
  <para style="mi" vid="1CH 8:37">
    <char style="pn">比尼亞</char>的兒子是<char style="pn">勒法</char>，<char style="pn">勒法</char>的兒子是<char style="pn">以利亞薩</char>，<char style="pn">以利亞薩</char>的兒子是<char style="pn">亞悉</char>。<verse eid="1CH 8:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 8:38" />
    <char style="pn">亞悉</char>有六個兒子，以下是他們的名字：<char style="pn">亞斯利甘</char>、<char style="pn">波基路</char>、<char style="pn">以實瑪利</char>、<char style="pn">示亞利雅</char>、<char style="pn">俄巴底亞</char>和<char style="pn">哈南</char>，這些都是<char style="pn">亞悉</char>的兒子。<verse eid="1CH 8:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 8:39" />
    <char style="pn">亞悉</char>的兄弟<char style="pn">以設</char>的兒子是：長子<char style="pn">烏蘭</char>，次子<char style="pn">耶烏施</char>，三子<char style="pn">以利菲烈</char>。<verse eid="1CH 8:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 8:40" />
    <char style="pn">烏蘭</char>的子孫都是英勇的戰士，是弓箭手。他們兒孫眾多，共一百五十人。</para>
  <para style="b" vid="1CH 8:40" />
  <para style="mi" vid="1CH 8:40">以上都是<char style="pn">便雅憫</char>子孫。<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="s">第一批回歸的流亡者</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />全體<char style="pn">以色列</char>人都記錄了家譜，看哪，被記在《<char style="pn">以色列</char>諸王紀》上。至於<char style="pn">猶大</char>，他們因對神不忠，就被擄到<char style="pn">巴比倫</char>去了。 <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />第一批回來居住在自己的產業、自己城中的，有<char style="pn">以色列</char>人、祭司、<char style="pn">利未</char>人和聖殿僕役。<verse eid="1CH 9:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 9:3" />住在<char style="pn">耶路撒冷</char>的，有<char style="pn">猶大</char>子孫、<char style="pn">便雅憫</char>子孫，<char style="pn">以法蓮</char>和<char style="pn">瑪拿西</char>子孫。<verse eid="1CH 9:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 9:4" />
    <char style="pn">猶大</char>兒子<char style="pn">法勒斯</char>的子孫中有<char style="pn">烏塔伊</char>，他是<char style="pn">亞米忽</char>的兒子、<char style="pn">歐姆利</char>的孫子、<char style="pn">伊姆利</char>的曾孫、<char style="pn">巴尼</char>的玄孫；<verse eid="1CH 9:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 9:5" />
    <char style="pn">示拉</char>的子孫<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">示拉的子孫——或譯作「示羅人」。</char></note>中有長子<char style="pn">亞撒雅</char>和他的兒子們；<verse eid="1CH 9:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 9:6" />
    <char style="pn">謝拉</char>的子孫中有<char style="pn">耶烏利</char>；</para>
  <para style="mi" vid="1CH 9:6">還有他們的族兄弟，共六百九十人。<verse eid="1CH 9:6" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="7" style="v" sid="1CH 9:7" />
    <char style="pn">便雅憫</char>的子孫中有<char style="pn">薩魯</char>，他是<char style="pn">米書蘭</char>的兒子、<char style="pn">赫達維亞</char>的孫子，<char style="pn">哈西努亞</char>的曾孫；<verse eid="1CH 9:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 9:8" />又有<char style="pn">伊比尼雅</char>，他是<char style="pn">耶羅罕</char>的兒子；</para>
  <para style="mi" vid="1CH 9:8">又有<char style="pn">以拉</char>，他是<char style="pn">烏基</char>的兒子、<char style="pn">米基立</char>的孫子；</para>
  <para style="mi" vid="1CH 9:8">又有<char style="pn">米書蘭</char>，他是<char style="pn">示法提雅</char>的兒子、<char style="pn">流珥</char>的孫子、<char style="pn">伊比尼雅</char>的曾孫；<verse eid="1CH 9:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 9:9" />還有他們的族兄弟，按著譜系共九百五十六人。</para>
  <para style="mi" vid="1CH 9:9">這些人都是他們父家各父系的首領。<verse eid="1CH 9:9" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="10" style="v" sid="1CH 9:10" />祭司中有<char style="pn">耶達亞</char>、<char style="pn">耶赫亞利</char>、<char style="pn">雅斤</char>；<verse eid="1CH 9:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 9:11" />又有神殿總管<char style="pn">亞撒利雅</char>，他是<char style="pn">希勒加</char>的兒子、<char style="pn">米書蘭</char>的孫子、<char style="pn">撒督</char>的曾孫、<char style="pn">米拉約</char>的玄孫、<char style="pn">亞希突</char>的來孫；<verse eid="1CH 9:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 9:12" />又有<char style="pn">亞達雅</char>，他是<char style="pn">耶羅罕</char>的兒子、<char style="pn">帕示戶珥</char>的孫子、<char style="pn">瑪基雅</char>的曾孫；</para>
  <para style="mi" vid="1CH 9:12">又有<char style="pn">瑪薩伊</char>，他是<char style="pn">亞迪業</char>的兒子、<char style="pn">雅赫則拉</char>的孫子、<char style="pn">米書蘭</char>的曾孫、<char style="pn">米實列莫</char>的玄孫、<char style="pn">伊梅爾</char>的來孫；<verse eid="1CH 9:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 9:13" />還有他們的族兄弟。他們都是父家的首領，共一千七百六十人，是在神殿的服事工作上有能力的人。<verse eid="1CH 9:13" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="14" style="v" sid="1CH 9:14" />
    <char style="pn">利未</char>人中有<char style="pn">示瑪雅</char>，他是<char style="pn">哈述</char>的兒子、<char style="pn">亞斯利甘</char>的孫子、<char style="pn">哈沙比雅</char>的曾孫，屬<char style="pn">米拉利</char>的後裔；<verse eid="1CH 9:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 9:15" />又有<char style="pn">巴赫巴克</char>、<char style="pn">赫列示</char>、<char style="pn">迦拉</char>和<char style="pn">瑪塔尼亞</char>，<char style="pn">瑪塔尼亞</char>是<char style="pn">米迦</char>的兒子、<char style="pn">澤克利</char>的孫子、<char style="pn">亞薩</char>的曾孫；<verse eid="1CH 9:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 9:16" />又有<char style="pn">俄巴底亞</char>，他是<char style="pn">示瑪雅</char>的兒子、<char style="pn">迦拉</char>的孫子、<char style="pn">耶杜頓</char>的曾孫；</para>
  <para style="mi" vid="1CH 9:16">還有<char style="pn">比利迦</char>，他是<char style="pn">亞撒</char>的兒子、<char style="pn">以利加拿</char>的孫子。</para>
  <para style="mi" vid="1CH 9:16">他們都住在<char style="pn">尼托法</char>人的村莊。<verse eid="1CH 9:16" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="17" style="v" sid="1CH 9:17" />門衛有<char style="pn">沙勒姆</char>、<char style="pn">阿庫布</char>、<char style="pn">達門</char>、<char style="pn">亞希幔</char>以及他們的族兄弟，</para>
  <para style="mi" vid="1CH 9:17">
    <char style="pn">沙勒姆</char>是首領， <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />他們看守東邊的王門直到如今；他們曾經是<char style="pn">利未</char>人營地的門衛。<verse eid="1CH 9:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 9:19" />
    <char style="pn">沙勒姆</char>是<char style="pn">可列</char>的兒子、<char style="pn">伊比雅撒</char>的孫子、<char style="pn">可拉</char>的曾孫；他和父家的族兄弟<char style="pn">可拉</char>子孫一起負責服事工作，看守會幕的門。他們的祖先曾經負責耶和華的營地，看守營地的入口； <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />從前<char style="pn">以利亞撒</char>的兒子<char style="pn">非尼哈</char>是他們的領袖，耶和華與他同在。<verse eid="1CH 9:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 9:21" />
    <char style="pn">米施利米雅</char>的兒子<char style="pn">撒迦利亞</char>是會幕入口的門衛。<verse eid="1CH 9:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22" />這些被選作門衛的，共兩百一十二人。他們在自己的村莊裡被記錄了家譜，他們是<char style="pn">大衛</char>和先見<char style="pn">撒母耳</char>所指定委任的。 <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />他們和他們的子孫負責在耶和華殿，也就是會幕的門口履行職責。 <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />東、西、南、北四方都有門衛； <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />他們那些在村莊裡的族兄弟，每七天定時來與他們同工。 <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />至於四個受委任作門衛長的，他們是<char style="pn">利未</char>人，負責神殿的房間和庫房。 <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />他們在神殿四圍過夜，因為他們負責看守，並且保管鑰匙，要每天早晨開門。<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />
    <char style="pn">利未</char>人中，有一些人管理服事用的器具：按照數目拿出去，也要按照數目送回來。 <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />還有一些人被指定管理器具，就是聖所的一切器具，以及細麵粉、酒、油、乳香和香料。 <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />祭司成員中，有一些人負責用香料調制膏油。 <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" /><char style="pn">利未</char>人<char style="pn">瑪塔提雅</char>是<char style="pn">可拉</char>子孫<char style="pn">沙勒姆</char>的長子，他受委任管理烤餅的工作。 <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />他們的族兄弟<char style="pn">哥轄</char>子孫中，有一些人負責為每個安息日預備陳設餅。<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />至於那些歌手，是<char style="pn">利未</char>人各父系的首領，住在聖殿的公房裡，免於其他事務，因為要日夜擔負本職工作。 <verse eid="1CH 9:33" /><verse number="34" style="v" sid="1CH 9:34" />這些人都是<char style="pn">利未</char>人各父系的首領，在他們的譜系中為首。他們住在<char style="pn">耶路撒冷</char>。<verse eid="1CH 9:34" /></para>
  <para style="b" />
  <para style="s">掃羅家族</para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 9:35" />
    <char style="pn">基遍</char>之祖<char style="pn">耶伊列</char>住在<char style="pn">基遍</char>，他的妻子名叫<char style="pn">瑪迦</char>。 <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />他的長子是<char style="pn">阿布頓</char>，然後是<char style="pn">蘇珥</char>、<char style="pn">基士</char>、<char style="pn">巴力</char>、<char style="pn">尼珥</char>、<char style="pn">納達布</char>、 <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" /><char style="pn">格多</char>、<char style="pn">亞希約</char>、<char style="pn">撒迦利亞</char>和<char style="pn">米克羅</char>； <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" /><char style="pn">米克羅</char>生了<char style="pn">示米亞</char>。他們也與族兄弟一同住在<char style="pn">耶路撒冷</char>，在他們眾兄弟對面。<verse eid="1CH 9:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 9:39" />
    <char style="pn">尼珥</char>生<char style="pn">基士</char>，<char style="pn">基士</char>生<char style="pn">掃羅</char>，<char style="pn">掃羅</char>生了<char style="pn">約拿單</char>、<char style="pn">麥基舒亞</char>、<char style="pn">亞比拿達</char>和<char style="pn">伊施巴力</char>。<verse eid="1CH 9:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 9:40" />
    <char style="pn">約拿單</char>的兒子是<char style="pn">米力巴力</char>，<char style="pn">米力巴力</char>生了<char style="pn">米迦</char>。<verse eid="1CH 9:40" /></para>
  <para style="mi">
    <verse number="41" style="v" sid="1CH 9:41" />
    <char style="pn">米迦</char>的兒子是<char style="pn">皮敦</char>、<char style="pn">米勒</char>、<char style="pn">塔利亞</char>、 <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" /><char style="pn">亞哈斯</char>。</para>
  <para style="mi" vid="1CH 9:42">
    <char style="pn">亞哈斯</char>生<char style="pn">雅拉</char><note caller="+" style="f"><char style="fr" closed="false">9:42 </char><char style="ft" closed="false">雅拉——有古抄本和古譯本作「約阿達」；參《歷代志上》8:36。</char></note>，<char style="pn">雅拉</char>生<char style="pn">阿勒米特</char>、<char style="pn">阿茲瑪維</char>和<char style="pn">澤姆利</char>，</para>
  <para style="mi" vid="1CH 9:42">
    <char style="pn">澤姆利</char>生<char style="pn">莫扎</char>， <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" /><char style="pn">莫扎</char>生<char style="pn">比尼亞</char>，</para>
  <para style="mi" vid="1CH 9:43">
    <char style="pn">比尼亞</char>的兒子是<char style="pn">勒法雅</char>，<char style="pn">勒法雅</char>的兒子是<char style="pn">以利亞薩</char>，<char style="pn">以利亞薩</char>的兒子是<char style="pn">亞悉</char>。<verse eid="1CH 9:43" /></para>
  <para style="mi">
    <verse number="44" style="v" sid="1CH 9:44" />
    <char style="pn">亞悉</char>有六個兒子，以下是他們的名字：<char style="pn">亞斯利甘</char>、<char style="pn">波基路</char>、<char style="pn">以實瑪利</char>、<char style="pn">示亞利雅</char>、<char style="pn">俄巴底亞</char>和<char style="pn">哈南</char>，這些都是<char style="pn">亞悉</char>的兒子。<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s">掃羅與兒子們之死</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />
    <char style="pn">非利士</char>人與<char style="pn">以色列</char>人爭戰，<char style="pn">以色列</char>人從<char style="pn">非利士</char>人面前逃跑，被殺的人倒在<char style="pn">基利波</char>山上。 <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" /><char style="pn">非利士</char>人追上<char style="pn">掃羅</char>和他的兒子們，<char style="pn">非利士</char>人殺死了<char style="pn">掃羅</char>的兒子<char style="pn">約拿單</char>、<char style="pn">亞比拿達</char>和<char style="pn">麥基舒亞</char>。 <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" /><char style="pn">掃羅</char>遭到猛烈的攻擊，弓箭手射中了他，他受到射手的重創。 <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" /><char style="pn">掃羅</char>對替他拿兵器的說：「拔出你的刀來，把我刺死！免得這些未受割禮的人來折辱我。」但拿兵器的人不肯，因為他極其害怕。於是<char style="pn">掃羅</char>拿起刀，伏在刀上。 <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />替他拿兵器的看見<char style="pn">掃羅</char>死了，自己也伏在刀上死了。 <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />這樣，<char style="pn">掃羅</char>和他三個兒子死了，還有他的家人全都死了。<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />所有在平原的<char style="pn">以色列</char>人，看到<char style="pn">以色列</char>人逃跑，並且<char style="pn">掃羅</char>和他兒子們死了，他們就棄城逃跑。於是<char style="pn">非利士</char>人來住在其中。<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />第二天，<char style="pn">非利士</char>人來剝去被殺之人的衣物，發現<char style="pn">掃羅</char>和他兒子們倒在<char style="pn">基利波</char>山上。 <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />他們就剝去他的衣物，拿了他的頭顱和裝備，然後派人到<char style="pn">非利士</char>地的四境，向他們的偶像和民眾傳揚這好消息。 <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />他們把<char style="pn">掃羅</char>的裝備放在他們神明的廟宇裡，把他的頭顱釘在<char style="pn">大袞</char>的廟宇中。<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />
    <char style="pn">基列-雅比</char>的人都聽說了<char style="pn">非利士</char>人對<char style="pn">掃羅</char>所做的這一切事， <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />勇士們就都動身，取回<char style="pn">掃羅</char>的屍體和他兒子們的屍體，帶到<char style="pn">雅比</char>，把他們的骸骨葬在<char style="pn">雅比</char>的那棵橡樹下，並且禁食七天。<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />
    <char style="pn">掃羅</char>死了，因他對耶和華行事不忠，不遵守耶和華的話語，甚至去找一個招魂的求問， <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />而沒有求問耶和華，所以耶和華使他被殺，把王位轉歸於<char style="pn">耶西</char>的兒子<char style="pn">大衛</char>。<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s">大衛受膏為王</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />全體<char style="pn">以色列</char>人聚集到<char style="pn">希伯崙</char>來見<char style="pn">大衛</char>，說：「看哪，我們是你的骨肉之親。 <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />從前<char style="pn">掃羅</char>作王的時候，帶領<char style="pn">以色列</char>出入的就是你，你的神耶和華也曾對你說：『你要牧養我的子民<char style="pn">以色列</char>，你要作我的子民<char style="pn">以色列</char>的領袖。』」<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />
    <char style="pn">以色列</char>的長老們都來到<char style="pn">希伯崙</char>見王，<char style="pn">大衛</char>在<char style="pn">希伯崙</char>，在耶和華面前與他們立約，他們就膏立<char style="pn">大衛</char>作<char style="pn">以色列</char>的王，正如耶和華藉著<char style="pn">撒母耳</char>所傳的話。<verse eid="1CH 11:3" /></para>
  <para style="s">大衛攻取耶路撒冷</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />
    <char style="pn">大衛</char>和<char style="pn">以色列</char>全軍來到<char style="pn">耶路撒冷</char>——就是<char style="pn">耶布斯</char>，那地的居民都是<char style="pn">耶布斯</char>人。 <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" /><char style="pn">耶布斯</char>的居民對<char style="pn">大衛</char>說：「你進不到這裡來！」然而<char style="pn">大衛</char>攻取了<char style="pn">錫安</char>的堡壘，就是後來的<char style="pn">大衛</char>城。<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />
    <char style="pn">大衛</char>說：「誰先擊殺<char style="pn">耶布斯</char>人，他就作元帥，作首領。」<char style="pn">洗魯雅</char>的兒子<char style="pn">約押</char>先攻上去，就作了元帥。<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />
    <char style="pn">大衛</char>住在這堡壘裡，因此人們稱它為「<char style="pn">大衛</char>城」。 <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" /><char style="pn">大衛</char>把城的周圍建造起來，從梯壘直到四圍城牆；<char style="pn">約押</char>修復城其餘的部分。 <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" /><char style="pn">大衛</char>越來越強大，因為萬軍之耶和華與他同在。<verse eid="1CH 11:9" /></para>
  <para style="s">大衛的勇士們</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />這些是<char style="pn">大衛</char>勇士們的首領，就是與全<char style="pn">以色列</char>一同極力擁護他王權的人，他們照著耶和華所應許<char style="pn">以色列</char>的，立他為王。 <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />以下是<char style="pn">大衛</char>的勇士們的名單：</para>
  <para style="p" vid="1CH 11:11">
    <char style="pn">哈克莫尼</char>人<char style="pn">雅朔班</char>，是眾軍官<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">眾軍官——或譯作「三十勇士」。</char></note>之首，他曾揮動長矛，一次擊殺了三百人。<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />其次是<char style="pn">阿赫阿</char>人<char style="pn">朵多</char>的兒子<char style="pn">以利亞撒</char>，他是三勇士之一。 <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />從前他與<char style="pn">大衛</char>在<char style="pn">巴斯達憫</char>，<char style="pn">非利士</char>人聚集在那裡要打仗，那裡有一塊長滿了大麥的田地。<char style="pn">以色列</char>軍兵從<char style="pn">非利士</char>人面前逃跑， <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />他們卻在那塊田中站立，守護那塊田，擊殺<char style="pn">非利士</char>人。這樣耶和華施行了大拯救。<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />有一次，三十個首領中的那三個人下去，到<char style="pn">亞杜蘭</char>山洞的磐石那裡去見<char style="pn">大衛</char>。<char style="pn">非利士</char>人的軍隊在<char style="pn">利乏音</char>谷紮營。 <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />那時<char style="pn">大衛</char>在要塞中，而<char style="pn">非利士</char>人的駐軍在<char style="pn">伯利恆</char>。 <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" /><char style="pn">大衛</char>心中渴望，說：「誰能把<char style="pn">伯利恆</char>城門旁水窖裡的水帶來給我喝啊！」 <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />那三個人就突破<char style="pn">非利士</char>人的防營，從<char style="pn">伯利恆</char>城門旁的水窖裡打水，提上來，帶回<char style="pn">大衛</char>那裡。但<char style="pn">大衛</char>不肯喝，而是把水澆奠在耶和華面前， <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />說：「我絕不可在我的神面前做這事！我怎麼能喝那些冒生命危險之人的血呢？這水是他們冒著生命危險取回來的。」所以<char style="pn">大衛</char>不肯喝。這些是三勇士的事蹟。<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />
    <char style="pn">約押</char>的弟弟<char style="pn">亞比篩</char>，是三十<note caller="+" style="f"><char style="fr" closed="false">11:20 </char><char style="ft" closed="false">三十—— 依據古敘利亞文譯本；馬索拉文本作「三」。</char></note>勇士之首；他曾揮動長矛殺了三百人，所以和那三勇士一樣有名。 <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />他在三十<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">三十—— 依據古敘利亞文譯本；馬索拉文本作「三」。</char></note>勇士中倍受尊崇，所以成為他們的首領，只是不及那三勇士。<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />
    <char style="pn">耶赫亞達</char>的兒子<char style="pn">比納雅</char>，是來自<char style="pn">卡布策勒</char>的勇士，有許多事蹟。他曾擊殺了<char style="pn">摩押</char>的兩個英雄，也曾在下雪的日子，下到坑裡殺了一隻獅子。 <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />他還擊殺了一個身高五肘<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">五肘——相當於2.3公尺。1肘=45.7公分。</char></note>的<char style="pn">埃及</char>人；這<char style="pn">埃及</char>人手中有長矛，<char style="pn">比納雅</char>卻拿著棍子下去攻擊他，從他手中搶奪了長矛，用那長矛把他殺了。 <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />這些是<char style="pn">耶赫亞達</char>的兒子<char style="pn">比納雅</char>的事蹟，他和三勇士一樣有名。 <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />看哪，他在三十勇士中受尊崇，但是不及那三勇士。<char style="pn">大衛</char>立他作侍衛長。<verse eid="1CH 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26" />軍隊中的勇士有：</para>
  <para style="mi" vid="1CH 11:26">
    <char style="pn">約押</char>的弟弟<char style="pn">亞撒暉</char>，</para>
  <para style="mi" vid="1CH 11:26">
    <char style="pn">伯利恆</char>人<char style="pn">朵多</char>的兒子<char style="pn">伊勒哈南</char>，<verse eid="1CH 11:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 11:27" />
    <char style="pn">哈律</char>人<char style="pn">沙瑪</char>，</para>
  <para style="mi" vid="1CH 11:27">
    <char style="pn">佩羅尼</char>人<char style="pn">希利斯</char>，<verse eid="1CH 11:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 11:28" />
    <char style="pn">提克亞</char>人<char style="pn">益吉</char>的兒子<char style="pn">伊拉</char>，</para>
  <para style="mi" vid="1CH 11:28">
    <char style="pn">亞拿突</char>人<char style="pn">亞比以謝</char>，<verse eid="1CH 11:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 11:29" />
    <char style="pn">戶沙</char>人<char style="pn">西比凱</char>，</para>
  <para style="mi" vid="1CH 11:29">
    <char style="pn">阿赫阿</char>人<char style="pn">伊萊</char>，<verse eid="1CH 11:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 11:30" />
    <char style="pn">尼托法</char>人<char style="pn">瑪哈萊</char>，</para>
  <para style="mi" vid="1CH 11:30">
    <char style="pn">尼托法</char>人<char style="pn">巴納</char>的兒子<char style="pn">希勒</char>，<verse eid="1CH 11:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 11:31" />
    <char style="pn">基比亞</char>的<char style="pn">便雅憫</char>人<char style="pn">利拜</char>的兒子<char style="pn">伊太</char>，</para>
  <para style="mi" vid="1CH 11:31">
    <char style="pn">比拉頓</char>人<char style="pn">比納雅</char>，<verse eid="1CH 11:31" /></para>
  <para style="mi">
    <verse number="32" style="v" sid="1CH 11:32" />
    <char style="pn">迦實</char>溪谷的人<char style="pn">戶萊</char>，</para>
  <para style="mi" vid="1CH 11:32">
    <char style="pn">亞拉巴</char>人<char style="pn">亞比耶</char>，<verse eid="1CH 11:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 11:33" />
    <char style="pn">巴魯米</char>人<char style="pn">阿茲瑪維</char>，</para>
  <para style="mi" vid="1CH 11:33">
    <char style="pn">沙本</char>人<char style="pn">以利雅哈巴</char>，<verse eid="1CH 11:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 11:34" />
    <char style="pn">基孫</char>人<char style="pn">哈善</char>的兒子們，</para>
  <para style="mi" vid="1CH 11:34">
    <char style="pn">哈拉</char>人<char style="pn">沙基</char>的兒子<char style="pn">約拿單</char>，<verse eid="1CH 11:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 11:35" />
    <char style="pn">哈拉</char>人<char style="pn">沙卡爾</char>的兒子<char style="pn">亞希暗</char>，</para>
  <para style="mi" vid="1CH 11:35">
    <char style="pn">吾珥</char>的兒子<char style="pn">以利法勒</char>，<verse eid="1CH 11:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 11:36" />
    <char style="pn">米基拉</char>人<char style="pn">希弗</char>，</para>
  <para style="mi" vid="1CH 11:36">
    <char style="pn">佩羅尼</char>人<char style="pn">亞希雅</char>，<verse eid="1CH 11:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="1CH 11:37" />
    <char style="pn">迦密</char>人<char style="pn">希斯羅</char>，</para>
  <para style="mi" vid="1CH 11:37">
    <char style="pn">伊斯拜</char>的兒子<char style="pn">拿萊</char>，<verse eid="1CH 11:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 11:38" />
    <char style="pn">拿單</char>的兄弟<char style="pn">約珥</char>，</para>
  <para style="mi" vid="1CH 11:38">
    <char style="pn">哈格利</char>的兒子<char style="pn">彌伯哈</char>，<verse eid="1CH 11:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 11:39" />
    <char style="pn">亞捫</char>人<char style="pn">洗勒</char>，</para>
  <para style="mi" vid="1CH 11:39">替<char style="pn">洗魯雅</char>之子<char style="pn">約押</char>拿兵器的<char style="pn">比錄</char>人<char style="pn">拿哈萊</char>，<verse eid="1CH 11:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 11:40" />
    <char style="pn">以帖</char>人<char style="pn">伊拉</char>，</para>
  <para style="mi" vid="1CH 11:40">
    <char style="pn">以帖</char>人<char style="pn">迦立</char>，<verse eid="1CH 11:40" /></para>
  <para style="mi">
    <verse number="41" style="v" sid="1CH 11:41" />
    <char style="pn">赫提</char>人<char style="pn">烏利亞</char>，</para>
  <para style="mi" vid="1CH 11:41">
    <char style="pn">阿赫萊</char>的兒子<char style="pn">撒巴德</char>，<verse eid="1CH 11:41" /></para>
  <para style="mi">
    <verse number="42" style="v" sid="1CH 11:42" />
    <char style="pn">魯本</char>人<char style="pn">示撒</char>的兒子<char style="pn">阿迪納</char>——他是<char style="pn">魯本</char>支派的一個首領，有三十人跟隨他，<verse eid="1CH 11:42" /></para>
  <para style="mi">
    <verse number="43" style="v" sid="1CH 11:43" />
    <char style="pn">瑪迦</char>的兒子<char style="pn">哈南</char>，</para>
  <para style="mi" vid="1CH 11:43">
    <char style="pn">彌特尼</char>人<char style="pn">約沙法</char>，<verse eid="1CH 11:43" /></para>
  <para style="mi">
    <verse number="44" style="v" sid="1CH 11:44" />
    <char style="pn">亞施塔拉</char>人<char style="pn">烏西亞</char>，</para>
  <para style="mi" vid="1CH 11:44">
    <char style="pn">亞羅珥</char>人<char style="pn">赫坦</char>的兒子<char style="pn">沙瑪</char>和<char style="pn">耶伊列</char>，<verse eid="1CH 11:44" /></para>
  <para style="mi">
    <verse number="45" style="v" sid="1CH 11:45" />
    <char style="pn">提洗</char>人<char style="pn">示姆利</char>的兒子<char style="pn">耶迪阿業</char>和他的兄弟<char style="pn">約哈</char>，<verse eid="1CH 11:45" /></para>
  <para style="mi">
    <verse number="46" style="v" sid="1CH 11:46" />
    <char style="pn">瑪哈維</char>人<char style="pn">以利業</char>，</para>
  <para style="mi" vid="1CH 11:46">
    <char style="pn">伊利納姆</char>的兒子<char style="pn">耶利拜</char>和<char style="pn">約沙維亞</char>，</para>
  <para style="mi" vid="1CH 11:46">
    <char style="pn">摩押</char>人<char style="pn">伊特瑪</char>，<verse eid="1CH 11:46" /></para>
  <para style="mi">
    <verse number="47" style="v" sid="1CH 11:47" />還有<char style="pn">以利業</char>、<char style="pn">俄備得</char>和<char style="pn">米瑣巴</char>人<char style="pn">雅西業</char>。<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s">大衛最初的支持者</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />以下是<char style="pn">大衛</char>被迫躲避<char style="pn">基士</char>的兒子<char style="pn">掃羅</char>時，來到<char style="pn">洗革拉大衛</char>那裡的人：他們都是勇士，幫助<char style="pn">大衛</char>爭戰； <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />他們裝備了弓箭，左右手都能投石、拉弓射箭；他們是<char style="pn">便雅憫</char>人，是<char style="pn">掃羅</char>的族兄弟。<verse eid="1CH 12:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 12:3" />為首的是<char style="pn">亞希以謝</char>，</para>
  <para style="mi" vid="1CH 12:3">其次是<char style="pn">約阿施</char>，</para>
  <para style="mi" vid="1CH 12:3">都是<char style="pn">基比亞</char>人<char style="pn">示米亞</char>的兒子；</para>
  <para style="mi" vid="1CH 12:3">還有<char style="pn">阿茲瑪維</char>的兒子<char style="pn">耶薛</char>和<char style="pn">毗力</char>，</para>
  <para style="mi" vid="1CH 12:3">
    <char style="pn">比拉卡</char>，<char style="pn">亞拿突</char>人<char style="pn">耶戶</char>，<verse eid="1CH 12:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 12:4" />
    <char style="pn">基遍</char>人<char style="pn">伊施瑪雅</char>，他是三十勇士之一，統領那三十人；</para>
  <para style="mi" vid="1CH 12:4">還有<char style="pn">耶利米</char>，<char style="pn">雅哈希</char>，<char style="pn">約哈南</char>，<char style="pn">基得拉</char>人<char style="pn">約撒巴</char>，<verse eid="1CH 12:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 12:5" />
    <char style="pn">伊利烏賽</char>，<char style="pn">耶利莫</char>，<char style="pn">比亞利雅</char>，<char style="pn">示瑪利雅</char>，</para>
  <para style="mi" vid="1CH 12:5">
    <char style="pn">哈律弗</char>人<char style="pn">示法提雅</char>，<verse eid="1CH 12:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 12:6" />又有<char style="pn">可拉</char>子孫<char style="pn">以利加拿</char>、<char style="pn">伊示亞</char>、<char style="pn">阿扎列</char>、<char style="pn">約以謝</char>和<char style="pn">雅朔班</char>，<verse eid="1CH 12:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 12:7" />
    <char style="pn">格多</char>人<char style="pn">耶羅罕</char>的兒子<char style="pn">猶拉</char>和<char style="pn">希巴迪亞</char>。<verse eid="1CH 12:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />
    <char style="pn">迦得</char>人中也有到曠野的要塞投奔<char style="pn">大衛</char>的，都是能作戰的英勇戰士，配備盾牌和長矛。他們臉像獅子的臉，速度快如山上的羚羊。<verse eid="1CH 12:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 12:9" />為首的是<char style="pn">以謝爾</char>，第二是<char style="pn">俄巴底亞</char>，第三是<char style="pn">以利押</char>，<verse eid="1CH 12:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 12:10" />第四是<char style="pn">彌施瑪拿</char>，第五是<char style="pn">耶利米</char>，<verse eid="1CH 12:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 12:11" />第六是<char style="pn">亞泰</char>，第七是<char style="pn">以利業</char>，<verse eid="1CH 12:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 12:12" />第八是<char style="pn">約哈南</char>，第九是<char style="pn">以利薩巴</char>，<verse eid="1CH 12:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 12:13" />第十是<char style="pn">耶利米</char>，第十一是<char style="pn">末巴奈</char>。<verse eid="1CH 12:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />這些都是<char style="pn">迦得</char>子孫，是隊伍中的首領，地位最小的帶領一百人，最大的帶領一千人。 <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />這些人曾在一月份河水漲過整個河岸的時候，渡過<char style="pn">約旦</char>河，使全平原的人東奔西逃。<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />
    <char style="pn">便雅憫</char>子孫和<char style="pn">猶大</char>子孫中，也有人來到要塞歸向<char style="pn">大衛</char>。 <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" /><char style="pn">大衛</char>出去面見他們，答覆他們說：「如果你們是和平地來幫助我，我的心就與你們契合；但如果你們要把我這手無惡行的人出賣給我的敵人，就願我們祖先的神鑒察、裁決！」<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />神的靈臨到三十勇士的首領<char style="pn">亞瑪賽</char>身上<note caller="+" style="f"><char style="fr" closed="false">12:18 </char><char style="ft" closed="false">臨到……身上——或譯作「覆蓋」。</char></note>，他說：</para>
  <para style="q1" vid="1CH 12:18">「<char style="pn">大衛</char>啊，我們是來歸向你的；</para>
  <para style="q1" vid="1CH 12:18">
    <char style="pn">耶西</char>的兒子啊，我們是擁護你的。</para>
  <para style="q1" vid="1CH 12:18">平安！願你平安，</para>
  <para style="q1" vid="1CH 12:18">願幫助你的也都平安，</para>
  <para style="q1" vid="1CH 12:18">因為你的神幫助你。」</para>
  <para style="m" vid="1CH 12:18">
    <char style="pn">大衛</char>就接收他們，委任他們作部隊首領。<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />
    <char style="pn">瑪拿西</char>人中也有來投靠<char style="pn">大衛</char>的。當時<char style="pn">大衛</char>要隨同<char style="pn">非利士</char>人去與<char style="pn">掃羅</char>作戰，但後來他沒有幫助<char style="pn">非利士</char>人，因為<char style="pn">非利士</char>的首領們商議後驅逐了他，說「恐怕<char style="pn">大衛</char>會拿我們的頭顱去歸降他主人<char style="pn">掃羅</char>」。 <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" /><char style="pn">大衛</char>回到<char style="pn">洗革拉</char>的時候，<char style="pn">瑪拿西</char>人<char style="pn">阿德納</char>、<char style="pn">約撒巴</char>、<char style="pn">耶迪阿業</char>、<char style="pn">米迦勒</char>、<char style="pn">約撒巴</char>、<char style="pn">以利戶</char>和<char style="pn">洗勒太</char>來投靠他，他們都是<char style="pn">瑪拿西</char>人的千夫長。 <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />他們幫助<char style="pn">大衛</char>打擊匪徒，他們全都是英勇的戰士，是軍隊的將領。 <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />那時每天都有人來歸向<char style="pn">大衛</char>，要幫助他，以至他們成為一支大軍，像神的軍隊那樣。<verse eid="1CH 12:22" /></para>
  <para style="s">大衛在希伯崙的隊伍</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />有全副武裝的隊伍來到<char style="pn">希伯崙大衛</char>那裡，要照著耶和華的吩咐把<char style="pn">掃羅</char>的王權轉歸於<char style="pn">大衛</char>，他們的人數如下：<verse eid="1CH 12:23" /></para>
  <para style="mi">
    <verse number="24" style="v" sid="1CH 12:24" />
    <char style="pn">猶大</char>子孫中，拿盾牌和長矛的武裝隊伍有六千八百人。<verse eid="1CH 12:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 12:25" />
    <char style="pn">西緬</char>子孫中，英勇善戰的人有七千一百。<verse eid="1CH 12:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 12:26" />
    <char style="pn">利未</char>子孫中，有四千六百人。 <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" /><char style="pn">耶赫亞達</char>是<char style="pn">亞倫</char>子孫的領袖，跟從他的有三千七百人； <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />還有年輕、英勇的戰士<char style="pn">撒督</char>，以及他父家的二十二個將領。<verse eid="1CH 12:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 12:29" />
    <char style="pn">便雅憫</char>子孫——<char style="pn">掃羅</char>的族兄弟中有三千人，直到那時他們大多數人仍然忠於<char style="pn">掃羅</char>家。<verse eid="1CH 12:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 12:30" />
    <char style="pn">以法蓮</char>子孫中，有兩萬零八百人，都是英勇的戰士，在他們父家是有名望的人。<verse eid="1CH 12:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 12:31" />
    <char style="pn">瑪拿西</char>半支派中，被列入名單的有一萬八千人，都來擁立<char style="pn">大衛</char>作王。<verse eid="1CH 12:31" /></para>
  <para style="mi">
    <verse number="32" style="v" sid="1CH 12:32" />
    <char style="pn">以薩迦</char>子孫中，有兩百個首領，都洞察時務、知道<char style="pn">以色列</char>該做什麼；他們所有的族兄弟都聽從他們的吩咐。<verse eid="1CH 12:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 12:33" />
    <char style="pn">西布倫</char>支派中，裝備各樣武器能列陣出戰的有五萬人，都是不懷二心來助戰的。<verse eid="1CH 12:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 12:34" />
    <char style="pn">拿弗他利</char>支派中，有一千個將領，跟隨他們帶著盾牌和長矛的，有三萬七千人。<verse eid="1CH 12:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 12:35" />
    <char style="pn">但</char>支派中，能列陣出戰的有兩萬八千六百人。<verse eid="1CH 12:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 12:36" />
    <char style="pn">亞設</char>支派中，能列陣出戰的有四萬人。<verse eid="1CH 12:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="1CH 12:37" />在<char style="pn">約旦</char>河東岸，<char style="pn">魯本</char>支派、<char style="pn">迦得</char>支派和<char style="pn">瑪拿西</char>半支派中，裝備各樣武器作戰的軍隊有十二萬人。<verse eid="1CH 12:37" /></para>
  <para style="b" />
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />所有這些戰士隊列整齊，來<char style="pn">希伯崙</char>全心擁立<char style="pn">大衛</char>作全<char style="pn">以色列</char>的王；<char style="pn">以色列</char>其餘的人也都一心要<char style="pn">大衛</char>作王。 <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />他們在那裡三天，與<char style="pn">大衛</char>一同吃喝，他們的族兄弟為他們預備了一切。 <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />還有他們附近的人，甚至從<char style="pn">以薩迦</char>、<char style="pn">西布倫</char>和<char style="pn">拿弗他利</char>來的人，用驢子、駱駝、騾子和牛運來食物，有大量的麵餅、無花果餅、葡萄餅、酒、油、牛、羊，因為在<char style="pn">以色列</char>充滿了喜樂。<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s">大衛遷移約櫃</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />
    <char style="pn">大衛</char>與千夫長、百夫長和所有的領袖一同商議， <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />然後<char style="pn">大衛</char>對<char style="pn">以色列</char>全體會眾說：「如果你們認為好，認為這事出於耶和華我們的神，我們就各處派人，去見仍留在<char style="pn">以色列</char>各地的同胞，以及與他們一起住在有牧野之城的祭司和<char style="pn">利未</char>人，讓他們聚集到我們這裡來， <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />然後我們把我們神的約櫃帶回到這裡。因為<char style="pn">掃羅</char>年間，我們一直沒有求問神。」 <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />全體會眾都同意這樣做，因為這事在全體民眾眼中看為好。<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />於是<char style="pn">大衛</char>把全體<char style="pn">以色列</char>人從<char style="pn">埃及</char>的<char style="pn">西赫</char>河直到<char style="pn">哈馬</char>隘口都招聚起來，要把神的約櫃從<char style="pn">基列-耶琳</char>接來。 <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" /><char style="pn">大衛</char>與全體<char style="pn">以色列</char>人前往<char style="pn">巴阿拉</char>，就是屬於<char style="pn">猶大</char>的<char style="pn">基列-耶琳</char>，要把神的約櫃從那裡抬上來；這約櫃是以坐在基路伯之上的耶和華而命名的。 <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />他們把神的約櫃安放在一輛新車上，從<char style="pn">亞比拿達</char>家裡運出來，由<char style="pn">烏撒</char>和<char style="pn">亞希約</char>引領著車。<verse eid="1CH 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 13:8" />
    <char style="pn">大衛</char>和全體<char style="pn">以色列</char>人伴著豎琴、里拉琴、鈴鼓、銅鈸和號筒，在神面前極力歡慶、歌唱。 <verse eid="1CH 13:8" /><verse number="9" style="v" sid="1CH 13:9" />當他們來到<char style="pn">基頓</char>禾場時，牛絆了一下，<char style="pn">烏撒</char>就伸手扶住約櫃。 <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />於是耶和華的怒氣向<char style="pn">烏撒</char>發作，擊殺了他，因為他伸手扶住了約櫃；他就當場死在神面前。<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />
    <char style="pn">大衛</char>很惱火，因為耶和華向<char style="pn">烏撒</char>怒氣爆發。因此那地方被稱為<char style="pn">佩勒斯-烏撒</char>，直到今日。 <verse eid="1CH 13:11" /><verse number="12" style="v" sid="1CH 13:12" />那一天，<char style="pn">大衛</char>懼怕神，說：「我怎能把神的約櫃接到我這裡來呢？」 <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />因此<char style="pn">大衛</char>沒有把約櫃遷移到<char style="pn">大衛</char>城自己那裡，而是把它轉運到<char style="pn">迦特</char>人<char style="pn">俄別·以東</char>的家。 <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />神的約櫃與<char style="pn">俄別·以東</char>一家同在，停留在他家三個月，耶和華祝福了<char style="pn">俄別·以東</char>的家和一切屬於他的。<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s">神祝福大衛</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />
    <char style="pn">提爾</char>王<char style="pn">希蘭</char>派遣使者到<char style="pn">大衛</char>那裡，送來香柏木、石匠和木匠，要為他建造宮殿。 <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" /><char style="pn">大衛</char>知道耶和華已經堅立他為<char style="pn">以色列</char>的王，並且為自己的子民<char style="pn">以色列</char>的緣故，高抬他的王權。<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />
    <char style="pn">大衛</char>在<char style="pn">耶路撒冷</char>又娶了妻妾，生了更多兒女。 <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />他在<char style="pn">耶路撒冷</char>所生的兒子名字如下：<char style="pn">沙慕亞</char>、<char style="pn">朔罷</char>、<char style="pn">拿單</char>、<char style="pn">所羅門</char>、 <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" /><char style="pn">益轄</char>、<char style="pn">以利書亞</char>、<char style="pn">以勒佩列</char>、 <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" /><char style="pn">挪迦</char>、<char style="pn">尼斐</char>、<char style="pn">雅非亞</char>、 <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" /><char style="pn">以利沙瑪</char>、<char style="pn">比利雅大</char>、<char style="pn">以利菲烈</char>。<verse eid="1CH 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />
    <char style="pn">非利士</char>人聽說<char style="pn">大衛</char>被膏立為全<char style="pn">以色列</char>的王，<char style="pn">非利士</char>全軍就上來尋索<char style="pn">大衛</char>。<char style="pn">大衛</char>聽說了，就出去迎擊他們。 <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" /><char style="pn">非利士</char>人來了，搶掠<char style="pn">利乏音</char>谷。 <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" /><char style="pn">大衛</char>求問神，說：「我可以上去攻打<char style="pn">非利士</char>人嗎？你會把他們交在我手中嗎？」</para>
  <para style="p" vid="1CH 14:10">耶和華對他說：「上去吧，我一定把他們交在你手中。」<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />
    <char style="pn">非利士</char>人上到<char style="pn">巴力批拉津</char>，<char style="pn">大衛</char>在那裡擊敗了他們。<char style="pn">大衛</char>說：「神藉著我的手沖潰我的仇敵，如同洪水沖破堤岸。」因此他們給那地方起名為<char style="pn">巴力批拉津</char>。 <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" /><char style="pn">非利士</char>人把他們的神像遺棄在那裡，<char style="pn">大衛</char>就吩咐人用火焚燒了。<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />
    <char style="pn">非利士</char>人再次搶掠<char style="pn">利乏音</char>谷。 <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" /><char style="pn">大衛</char>又求問神，神對他說：「不要直接上去追趕他們，要繞過他們，從桑樹林對面進攻。 <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />當你聽見桑樹林的樹梢上有行進的聲音，就要出去作戰，因為神已經在你前面出去攻打<char style="pn">非利士</char>的軍隊了。」 <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" /><char style="pn">大衛</char>就照著神所指示的去做，擊殺<char style="pn">非利士</char>的軍隊，從<char style="pn">基遍</char>直到<char style="pn">基色</char>。 <verse eid="1CH 14:16" /><verse number="17" style="v" sid="1CH 14:17" /><char style="pn">大衛</char>的名聲傳遍全地，耶和華使萬國都懼怕他。<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s">約櫃進入耶路撒冷</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />
    <char style="pn">大衛</char>在<char style="pn">大衛</char>城為自己建造宮殿，又為神的約櫃預備地方，為它支搭了一座帳篷。 <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />那時<char style="pn">大衛</char>說：「除了<char style="pn">利未</char>人以外，沒有人可以抬神的約櫃，因為耶和華揀選了他們抬耶和華的約櫃，並且永遠事奉他。」<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />
    <char style="pn">大衛</char>招聚全體<char style="pn">以色列</char>人到<char style="pn">耶路撒冷</char>，要把耶和華的約櫃抬上來放到<char style="pn">大衛</char>所預備的地方。 <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" /><char style="pn">大衛</char>又招聚<char style="pn">亞倫</char>的子孫和<char style="pn">利未</char>人：<verse eid="1CH 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 15:5" />
    <char style="pn">哥轄</char>的子孫中，有首領<char style="pn">烏列</char>和他的族兄弟一百二十人； <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" /><char style="pn">米拉利</char>的子孫中，有首領<char style="pn">亞撒雅</char>和他的族兄弟兩百二十人； <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" /><char style="pn">革順</char>的子孫中，有首領<char style="pn">約珥</char>和他的族兄弟一百三十人； <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" /><char style="pn">以利撒番</char>的子孫中，有首領<char style="pn">示瑪雅</char>和他的族兄弟兩百人； <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" /><char style="pn">希伯倫</char>的子孫中，有首領<char style="pn">以利業</char>和他的族兄弟八十人； <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" /><char style="pn">烏基業</char>的子孫中，有首領<char style="pn">亞米拿達</char>和他的族兄弟一百一十二人。<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />
    <char style="pn">大衛</char>召來<char style="pn">撒督</char>和<char style="pn">亞比亞特</char>兩位祭司，以及<char style="pn">利未</char>人<char style="pn">烏列</char>、<char style="pn">亞撒雅</char>、<char style="pn">約珥</char>、<char style="pn">示瑪雅</char>、<char style="pn">以利業</char>和<char style="pn">亞米拿達</char>， <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />對他們說：「你們是<char style="pn">利未</char>人各父系的首領，你們和你們的族兄弟要使自己分別為聖，好把<char style="pn">以色列</char>的神耶和華的約櫃抬上來放到我所預備的地方。 <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />因為上一次你們不在場，我們也沒有按照規定求問神，所以耶和華我們的神就對我們發怒。」 <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />於是祭司和<char style="pn">利未</char>人使自己分別為聖，為要把<char style="pn">以色列</char>的神耶和華的約櫃抬上來。 <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" /><char style="pn">利未</char>子孫照著耶和華的話，按<char style="pn">摩西</char>所吩咐的，用杠子把神的約櫃扛在肩上。<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />
    <char style="pn">大衛</char>吩咐<char style="pn">利未</char>人的首領指派他們的族兄弟作歌手，用里拉琴、豎琴、銅鈸等各種樂器伴奏，高唱喜樂的歌。 <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" /><char style="pn">利未</char>人就指派了<char style="pn">約珥</char>的兒子<char style="pn">希幔</char>和他的族兄弟<char style="pn">比利迦</char>的兒子<char style="pn">亞薩</char>，以及他們的族兄弟<char style="pn">米拉利</char>子孫中<char style="pn">古沙雅</char>的兒子<char style="pn">伊坦</char>； <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />其次是與他們一起的族兄弟：<char style="pn">撒迦利亞</char><note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">撒迦利亞——依據七十士譯本以及有些古抄本；馬索拉文本作「兒子撒迦利亞」。</char></note>、<char style="pn">雅阿基業</char>、<char style="pn">示米拉莫</char>、<char style="pn">耶希業</char>、<char style="pn">烏尼</char>、<char style="pn">以利押</char>、<char style="pn">比納雅</char>、<char style="pn">瑪西雅</char>、<char style="pn">瑪塔提雅</char>、<char style="pn">以利斐利戶</char>、<char style="pn">彌克尼雅</char>，以及門衛<char style="pn">俄別·以東</char>和<char style="pn">耶伊列</char>。 <verse eid="1CH 15:18" /><verse number="19" style="v" sid="1CH 15:19" />歌手<char style="pn">希幔</char>、<char style="pn">亞薩</char>和<char style="pn">伊坦</char>要敲響銅鈸； <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" /><char style="pn">撒迦利亞</char>、<char style="pn">雅基業</char>、<char style="pn">示米拉莫</char>、<char style="pn">耶希業</char>、<char style="pn">烏尼</char>、<char style="pn">以利押</char>、<char style="pn">瑪西雅</char>和<char style="pn">比納雅</char>彈里拉琴，用「少女」曲調<note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false">用「少女」曲調——或譯作「調用阿拉莫特」。</char></note>； <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" /><char style="pn">瑪塔提雅</char>、<char style="pn">以利斐利戶</char>、<char style="pn">彌克尼雅</char>、<char style="pn">俄別·以東</char>、<char style="pn">耶伊列</char>和<char style="pn">阿撒細雅</char>彈豎琴，用「第八」曲調<note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false">用「第八」曲調——或譯作「調用謝米尼特」。</char></note>領奏。 <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" /><char style="pn">克納尼雅</char>是<char style="pn">利未</char>人歌唱的領隊，教導人歌唱，因為他精通於此。 <verse eid="1CH 15:22" /><verse number="23" style="v" sid="1CH 15:23" /><char style="pn">比利迦</char>和<char style="pn">以利加拿</char>是看守約櫃的門衛。 <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />祭司<char style="pn">示巴尼</char>、<char style="pn">約沙法</char>、<char style="pn">拿旦業</char>、<char style="pn">亞瑪賽</char>、<char style="pn">撒迦利亞</char>、<char style="pn">比納雅</char>和<char style="pn">以利以謝</char>，在神的約櫃前吹號。<char style="pn">俄別·以東</char>和<char style="pn">耶希亞</char>也是看守約櫃的門衛。<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />於是<char style="pn">大衛</char>、<char style="pn">以色列</char>的長老們和千夫長們一起前去，歡歡喜喜地把耶和華的約櫃從<char style="pn">俄別·以東</char>家裡抬上來。 <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />神幫助那些抬耶和華約櫃的<char style="pn">利未</char>人，他們就祭獻了七頭公牛和七隻公綿羊。<verse eid="1CH 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 15:27" />
    <char style="pn">大衛</char>和所有抬約櫃的<char style="pn">利未</char>人，並歌手和歌手的首領<char style="pn">克納尼雅</char>，都穿著細麻布的外袍，<char style="pn">大衛</char>還穿著細麻布的以弗得。 <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />全體<char style="pn">以色列</char>人在歡呼和號角聲中，奏響號筒、銅鈸、里拉琴和豎琴，把耶和華的約櫃抬上來。 <verse eid="1CH 15:28" /><verse number="29" style="v" sid="1CH 15:29" />當耶和華的約櫃進入<char style="pn">大衛</char>城時，<char style="pn">掃羅</char>的女兒<char style="pn">米甲</char>透過窗戶俯看，看見<char style="pn">大衛</char>王跳躍歡慶，心裡就藐視他。<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="nb">
    <verse number="1" style="v" sid="1CH 16:1" />他們把神的約櫃抬來，安放在<char style="pn">大衛</char>為它支搭的帳篷內，然後在神面前獻上燔祭和平安祭。 <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" /><char style="pn">大衛</char>獻完了燔祭和平安祭，就奉耶和華的名祝福民眾， <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />又分給<char style="pn">以色列</char>所有的人，無論男女，每人一個餅、一個棗餅、一個葡萄餅。<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />
    <char style="pn">大衛</char>指定一些<char style="pn">利未</char>人在耶和華的約櫃前事奉，來記念、稱謝、讚美耶和華<char style="pn">以色列</char>的神。 <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />為首的是<char style="pn">亞薩</char>，其次是<char style="pn">撒迦利亞</char>、<char style="pn">耶伊列</char>、<char style="pn">示米拉莫</char>、<char style="pn">耶希業</char>、<char style="pn">瑪塔提雅</char>、<char style="pn">以利押</char>、<char style="pn">比納雅</char>、<char style="pn">俄別·以東</char>和<char style="pn">耶伊列</char>，他們彈奏里拉琴和豎琴等樂器，而<char style="pn">亞薩</char>奏響銅鈸。 <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" /><char style="pn">比納雅</char>和<char style="pn">雅哈希</char>兩位祭司常在神的約櫃前吹號。<verse eid="1CH 16:6" /></para>
  <para style="s">大衛的感恩詩歌</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />那一天，<char style="pn">大衛</char>首次指定<char style="pn">亞薩</char>和他的族兄弟負責稱謝耶和華：<verse eid="1CH 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />你們當稱謝耶和華，呼求他的名，</para>
  <para style="q1" vid="1CH 16:8">在萬民中傳揚他的作為；<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />當向他歌唱，歌頌他，</para>
  <para style="q1" vid="1CH 16:9">談論他一切的奇妙作為；<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />當以他的聖名誇耀，</para>
  <para style="q1" vid="1CH 16:10">願尋求耶和華的人心裡歡喜！<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />你們當尋求耶和華和他的力量，</para>
  <para style="q1" vid="1CH 16:11">一直尋求他的容面。<verse eid="1CH 16:11" /></para>
  <para style="q1">
    <verse number="12-13" style="v" sid="1CH 16:12-13" />他的僕人<char style="pn">以色列</char>的後裔啊，</para>
  <para style="q1" vid="1CH 16:12-13">他所揀選的<char style="pn">雅各</char>的子孫哪，</para>
  <para style="q1" vid="1CH 16:12-13">你們當記念他所行的奇妙作為，</para>
  <para style="q1" vid="1CH 16:12-13">記念他的奇事和他口中的法規！<verse eid="1CH 16:12-13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />他是耶和華我們的神，</para>
  <para style="q1" vid="1CH 16:14">他的公正充滿全地。<verse eid="1CH 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />他記念自己的約，直到永遠；</para>
  <para style="q1" vid="1CH 16:15">記念他所吩咐的話，直到千代——<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />就是他與<char style="pn">亞伯拉罕</char>所立的約，</para>
  <para style="q1" vid="1CH 16:16">向<char style="pn">以撒</char>所起的誓；<verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />又把這約給<char style="pn">雅各</char>立為律例，</para>
  <para style="q1" vid="1CH 16:17">給<char style="pn">以色列</char>立為永遠的約；<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />他說：「我要把<char style="pn">迦南</char>地賜給你，</para>
  <para style="q1" vid="1CH 16:18">作為你們分得的繼業。」<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />那時他們<note caller="+" style="f"><char style="fr" closed="false">16:19 </char><char style="ft" closed="false">他們——原文作「你們」；參《詩篇》105:12。</char></note>人數稀少，實在很少，</para>
  <para style="q1" vid="1CH 16:19">在那地是寄居的；<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />他們從這國流浪到那國，</para>
  <para style="q1" vid="1CH 16:20">從這邦流浪到那邦。<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />他不容任何人欺壓他們，</para>
  <para style="q1" vid="1CH 16:21">還為他們的緣故責備君王：<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />「你們不可碰我的受膏者，</para>
  <para style="q1" vid="1CH 16:22">不可惡待我的先知。」<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />全地啊，你們當向耶和華歌唱，</para>
  <para style="q1" vid="1CH 16:23">日復一日地傳揚他的救恩！<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />當在列國中講述他的榮耀，</para>
  <para style="q1" vid="1CH 16:24">在萬民中講述他的奇妙作為；<verse eid="1CH 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />因耶和華偉大，當受極大的讚美；</para>
  <para style="q1" vid="1CH 16:25">他超越一切神明，當受敬畏；<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />萬民的一切神明都是虛無的偶像，</para>
  <para style="q1" vid="1CH 16:26">而耶和華造了諸天。<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />尊榮和威嚴在他的面前，</para>
  <para style="q1" vid="1CH 16:27">力量和喜樂在他的居所。<verse eid="1CH 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />萬民萬族啊，你們當把榮耀和力量</para>
  <para style="q1" vid="1CH 16:28">歸給耶和華，歸給耶和華！<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />當把耶和華之名的榮耀歸給他，</para>
  <para style="q1" vid="1CH 16:29">帶著供物，來到他的面前。</para>
  <para style="q1" vid="1CH 16:29">當向聖潔威嚴的耶和華下拜；<verse eid="1CH 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30" />全地啊，你們當在他面前震撼！</para>
  <para style="b" vid="1CH 16:30" />
  <para style="q1" vid="1CH 16:30">是的，世界被確立，不致動搖！<verse eid="1CH 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />願諸天歡喜，願大地快樂，</para>
  <para style="q1" vid="1CH 16:31">願人們在列國中說：「耶和華作王了！」<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />願海洋和其中所充滿的澎湃如雷，</para>
  <para style="q1" vid="1CH 16:32">願田野和其中的一切都歡慶。<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />那時森林中的樹木將在耶和華面前歡呼，</para>
  <para style="q1" vid="1CH 16:33">因為他來要審判大地。<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />你們當稱謝耶和華，</para>
  <para style="q1" vid="1CH 16:34">他是美善的，他的慈愛永遠長存！<verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />你們要說：</para>
  <para style="q1" vid="1CH 16:35">「拯救我們的神哪，求你拯救我們！</para>
  <para style="q1" vid="1CH 16:35">求你從列國中招聚我們、解救我們，</para>
  <para style="q1" vid="1CH 16:35">好讓我們稱頌你的聖名，</para>
  <para style="q1" vid="1CH 16:35">以讚美你為福樂！」<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />
    <char style="pn">以色列</char>的神耶和華是當受頌讚的，</para>
  <para style="q1" vid="1CH 16:36">從永遠到永遠<note caller="+" style="f"><char style="fr" closed="false">16:36 </char><char style="ft" closed="false">永遠到永遠——或譯作「亙古到永遠」。</char></note>。</para>
  <para style="m" vid="1CH 16:36">全體民眾都說「阿們」，並且讚美耶和華。<verse eid="1CH 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />
    <char style="pn">大衛</char>安排<char style="pn">亞薩</char>和他的族兄弟在耶和華的約櫃前，要按著每天的任務，常在約櫃前事奉； <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />還有<char style="pn">俄別·以東</char>和他的族兄弟六十八人，<char style="pn">耶杜頓</char>的兒子<char style="pn">俄別·以東</char>以及<char style="pn">何薩</char>作門衛。 <verse eid="1CH 16:38" /><verse number="39" style="v" sid="1CH 16:39" /><char style="pn">大衛</char>又安排祭司<char style="pn">撒督</char>和他的兄弟眾祭司在<char style="pn">基遍</char>的高壇，在耶和華的帳幕前事奉， <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />要照著律法所記的一切，就是耶和華所吩咐<char style="pn">以色列</char>的，清晨和傍晚在燔祭的祭壇上向耶和華獻上常獻的燔祭。 <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />還有<char style="pn">希幔</char>、<char style="pn">耶杜頓</char>和其餘被選出、被指名的人，與他們一起稱謝耶和華：「他的慈愛永遠長存！」 <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" /><char style="pn">希幔</char>、<char style="pn">耶杜頓</char>與他們一同用號筒、銅鈸等各種樂器發聲歌頌神。<char style="pn">耶杜頓</char>的子孫守門。<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />於是全體民眾各回各家，<char style="pn">大衛</char>也回去為自己的家人祝福。<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s">大衛想建造聖殿</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />
    <char style="pn">大衛</char>住進自己的宮殿以後，對先知<char style="pn">拿單</char>說：「你看，我住在香柏木的宮殿裡，耶和華的約櫃卻在帳幕裡。」<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />
    <char style="pn">拿單</char>對<char style="pn">大衛</char>說：「你心裡所想的一切，只管去做，因為神與你同在。」<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />當天夜裡，神的話語臨到<char style="pn">拿單</char>，說： <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />「你去告訴我的僕人<char style="pn">大衛</char>：『耶和華如此說：不是你要為我建造殿宇居住。 <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />要知道，從我把<char style="pn">以色列</char>人帶上來的那天到今天，我從來沒有住過殿宇，我一直從這帳幕到那帳幕，從一個住所到另一個住所。 <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />在我與全體<char style="pn">以色列</char>人走過的哪一個地方，我何曾對哪一個<char style="pn">以色列</char>士師，就是我吩咐要牧養我子民的士師，說過這話：你們怎麼不為我建造一座香柏木的殿宇呢？』<verse eid="1CH 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 17:7" />「現在，你要對我的僕人<char style="pn">大衛</char>這樣說：『萬軍之耶和華如此說：是我把你從牧場上、從羊群後帶出來，作我子民<char style="pn">以色列</char>的領袖。 <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />在你所去的任何地方，我都與你同在，並且從你面前剪除了你的一切仇敵。我將為你成就大名，如同世上那些偉人的名。 <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />我必為我的子民<char style="pn">以色列</char>選定一個地方，栽植他們，使他們安居在那裡，不再受攪擾，也不再像先前那樣被不義之人迫害—— <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />從我吩咐士師治理我子民<char style="pn">以色列</char>的日子以來，他們一直被迫害。我要制伏你的一切仇敵。</para>
  <para style="p" vid="1CH 17:10">「『我向你宣告：耶和華將為你建立家室。 <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />當你壽數滿足，歸到你列祖那裡時，我必興起你的後裔——你親生的兒子接續你，我也必堅立他的王權。 <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />他將為我建造殿宇，我必堅立他的王位，直到永遠。 <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />我要作他的父親，他要作我的兒子；我不會使我的慈愛離開他，像離開在你之前的人那樣； <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />我要在我的家和我的國度裡永遠確立他，他的王位必永遠堅立。』」<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />
    <char style="pn">拿單</char>就把這一切話語，把這整個異象<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">異象——或譯作「啟示」。</char></note>，如實地告訴了<char style="pn">大衛</char>。<verse eid="1CH 17:15" /></para>
  <para style="s">大衛的感恩禱告</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />於是<char style="pn">大衛</char>王進去，坐在耶和華面前，說：「耶和華神哪，我是誰，我的家算什麼，你竟帶領我到這地步！ <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />神哪，這在你眼中還看為小事，你竟又提說僕人家的未來！耶和華神哪，你看待我像一個高貴的人<note caller="+" style="f"><char style="fr" closed="false">17:17 </char><char style="ft" closed="false">你看待我像一個高貴的人——或譯作「你向我顯明了人都渴望知道的事」。</char></note>。 <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />你賜給你僕人榮耀，<char style="pn">大衛</char>還能對你說什麼呢？你知道你的僕人。 <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />耶和華啊，你為你僕人的緣故，照著自己的心意行了這一切大事，為要顯明這一切偉大的事。<verse eid="1CH 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 17:20" />「耶和華啊，照著我們耳中所聽見的一切，沒有像你的，除你以外沒有別的神。 <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />世上有哪一國像你的子民<char style="pn">以色列</char>呢？神為自己贖回一個民族，為自己立名，行大而可畏的事，在你從<char style="pn">埃及</char>救贖的子民面前驅逐了列國。 <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />你使你的子民<char style="pn">以色列</char>永遠作你的子民；耶和華啊，你也作了他們的神。<verse eid="1CH 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 17:23" />「現在，耶和華啊，你所應許的有關你僕人和他家的話，求你永遠確立。求你照著你所應許的行事， <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />這樣，你的名就永遠確立、被尊為大，人必說：『<char style="pn">以色列</char>的神——萬軍之耶和華，就是<char style="pn">以色列</char>的神。』你僕人<char style="pn">大衛</char>的家也將在你面前被堅立， <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />因為你——我的神哪，是你親自啟示你的僕人<note caller="+" style="f"><char style="fr" closed="false">17:25 </char><char style="ft" closed="false">啟示你的僕人——原文直譯「開啟你僕人的耳朵」。</char></note>，要為他建立家室；所以你的僕人有了勇氣在你面前禱告。 <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />是的，耶和華啊，你是神，是你向你的僕人應許了這福份。 <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />現在，願你祝福你僕人的家，使它在你面前永遠長存，因為耶和華啊，你所祝福的，必永遠蒙福。」<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s">大衛的軍事勝利</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />此後，<char style="pn">大衛</char>擊敗<char style="pn">非利士</char>人，制伏了他們，從<char style="pn">非利士</char>人手中奪取了<char style="pn">迦特</char>和附屬的村鎮。 <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />他又擊敗<char style="pn">摩押</char>人，<char style="pn">摩押</char>就臣服於<char style="pn">大衛</char>，向他進貢。<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />當<char style="pn">瑣巴</char>王<char style="pn">哈大底謝</char>去建立他在<char style="pn">幼發拉底</char>河流域的掌控權時，<char style="pn">大衛</char>在<char style="pn">哈馬</char>擊敗了他。 <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" /><char style="pn">大衛</char>奪取了他一千輛戰車，俘虜了七千馬兵、兩萬步兵，<char style="pn">大衛</char>從拉戰車的馬中保留了一百匹，把其餘所有拉戰車的馬都砍斷了蹄筋。<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />
    <char style="pn">大馬士革</char>的<char style="pn">亞蘭</char>人來幫助<char style="pn">瑣巴</char>王<char style="pn">哈大底謝</char>時，<char style="pn">大衛</char>擊殺了<char style="pn">亞蘭</char>人兩萬兩千。 <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" /><char style="pn">大衛</char>在<char style="pn">大馬士革</char>的<char style="pn">亞蘭</char>地設立駐軍，這樣<char style="pn">亞蘭</char>人就臣服於<char style="pn">大衛</char>，向他進貢。<char style="pn">大衛</char>無論往哪裡去，耶和華都使他得勝。<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />
    <char style="pn">大衛</char>奪取<char style="pn">哈大底謝</char>臣僕們所拿的金盾牌，把它們帶回<char style="pn">耶路撒冷</char>。 <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" /><char style="pn">大衛</char>也從<char style="pn">哈大底謝</char>的城——<char style="pn">提巴</char>城和<char style="pn">昆</char>城中，奪走極多的銅；後來<char style="pn">所羅門</char>就是用這些銅製造銅海、柱子和各樣銅器的。<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />
    <char style="pn">哈馬</char>王<char style="pn">陀伊</char>聽說<char style="pn">大衛</char>擊敗了<char style="pn">瑣巴</char>王<char style="pn">哈大底謝</char>的全軍， <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />就派遣他兒子<char style="pn">哈多蘭</char>去見<char style="pn">大衛</char>王，向他問安，為他祝福，因為<char style="pn">大衛</char>攻打<char style="pn">哈大底謝</char>並擊敗了他；原來<char style="pn">哈大底謝</char>一直是<char style="pn">陀伊</char>的敵手。<char style="pn">哈多蘭</char>送來各樣金、銀、銅的器皿， <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" /><char style="pn">大衛</char>王把這些分別為聖歸於耶和華，就像他從各國獲得的金銀那樣——這些金銀是從<char style="pn">以東</char>人、<char style="pn">摩押</char>人、<char style="pn">亞捫</char>人、<char style="pn">非利士</char>人和<char style="pn">亞瑪力</char>人那裡獲得的。<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />
    <char style="pn">洗魯雅</char>的兒子<char style="pn">亞比篩</char>在<char style="pn">鹽谷</char>擊殺了一萬八千<char style="pn">以東</char>人。 <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" /><char style="pn">大衛</char>在<char style="pn">以東</char>設立駐軍，全<char style="pn">以東</char>就臣服於<char style="pn">大衛</char>。<char style="pn">大衛</char>無論往哪裡去，耶和華都使他得勝。<verse eid="1CH 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />
    <char style="pn">大衛</char>作王統治全<char style="pn">以色列</char>，為他所有百姓實行公正和公義。<verse eid="1CH 18:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 18:15" />
    <char style="pn">洗魯雅</char>的兒子<char style="pn">約押</char>統管軍隊，</para>
  <para style="mi" vid="1CH 18:15">
    <char style="pn">亞希律</char>的兒子<char style="pn">約沙法</char>作史官，<verse eid="1CH 18:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 18:16" />
    <char style="pn">亞希突</char>的兒子<char style="pn">撒督</char>和<char style="pn">亞比亞特</char>的兒子<char style="pn">亞希米勒</char>作祭司，</para>
  <para style="mi" vid="1CH 18:16">
    <char style="pn">沙威沙</char>作書記，<verse eid="1CH 18:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 18:17" />
    <char style="pn">耶赫亞達</char>的兒子<char style="pn">比納雅</char>統管<char style="pn">基利提</char>人和<char style="pn">比利提</char>人，</para>
  <para style="mi" vid="1CH 18:17">
    <char style="pn">大衛</char>的兒子們在王的身邊作內官。<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s">以色列戰勝亞捫人</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />此後，<char style="pn">亞捫</char>人的王<char style="pn">納哈什</char>死了，他的兒子接替他作王。 <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" /><char style="pn">大衛</char>說：「我要以恩慈對待<char style="pn">納哈什</char>的兒子<char style="pn">哈嫩</char>，因為他父親曾以恩慈對待我。」</para>
  <para style="p" vid="1CH 19:2">於是<char style="pn">大衛</char>派遣使者為<char style="pn">哈嫩</char>喪父的事安慰他。<char style="pn">大衛</char>的臣僕來到<char style="pn">亞捫</char>人之地見<char style="pn">哈嫩</char>，要安慰他， <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />但<char style="pn">亞捫</char>人的首領們對<char style="pn">哈嫩</char>說：「你以為<char style="pn">大衛</char>是尊敬你父親，所以派人來安慰你嗎？他的臣僕們來見你，難道不是為了探查、傾覆，為了窺探這地嗎？」 <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" /><char style="pn">哈嫩</char>就抓住<char style="pn">大衛</char>的臣僕，把他們的鬍鬚剃掉，又把他們的衣服從臀部以下割去一半，然後放他們走。<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />有人來把這些人遭遇的事向<char style="pn">大衛</char>報告，<char style="pn">大衛</char>就派人去迎接他們，因為這些人受了極大的羞辱。王說：「你們可以住在<char style="pn">耶利哥</char>，等鬍鬚長好了再回來。」<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />
    <char style="pn">亞捫</char>人知道他們被<char style="pn">大衛</char>厭惡，<char style="pn">哈嫩</char>和<char style="pn">亞捫</char>人就派人拿一千他連得<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">一千他連得——相當於34.2公噸。1他連得=34.2公斤。</char></note>銀子，從<char style="pn">美索不達米亞</char><note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">美索不達米亞——原文直譯「兩河之間的亞蘭」。</char></note>、<char style="pn">亞蘭-瑪迦</char>和<char style="pn">瑣巴</char>雇用戰車和馬兵。 <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />他們雇來了三萬兩千輛戰車，還有<char style="pn">瑪迦</char>王和他的軍兵。這些軍兵都來到<char style="pn">米底巴</char>前面紮營。<char style="pn">亞捫</char>人也從他們各城中聚集，出來作戰。<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />
    <char style="pn">大衛</char>聽說了，就派遣<char style="pn">約押</char>和全軍的勇士出戰。 <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" /><char style="pn">亞捫</char>人出來，在自己的城門口擺開戰陣；前來的諸王，他們單獨在郊外擺陣。 <verse eid="1CH 19:9" /><verse number="10" style="v" sid="1CH 19:10" /><char style="pn">約押</char>見自己腹背受敵，就從<char style="pn">以色列</char>所有精兵中挑選了一部分，擺陣迎戰<char style="pn">亞蘭</char>人， <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />其餘的人交在他兄弟<char style="pn">亞比篩</char>手下，擺陣迎戰<char style="pn">亞捫</char>人。<verse eid="1CH 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 19:12" />
    <char style="pn">約押</char>說：「如果<char style="pn">亞蘭</char>人強過我，你就過來幫助我；如果<char style="pn">亞捫</char>人強過你，我就過去幫助你。 <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />要堅強，我們要為我們的人民、為我們神的城鎮而堅強！願耶和華做他眼中看為好的事。」<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />於是<char style="pn">約押</char>和跟隨他的人上前與<char style="pn">亞蘭</char>人作戰，<char style="pn">亞蘭</char>人從他面前逃跑。 <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" /><char style="pn">亞捫</char>人見<char style="pn">亞蘭</char>人逃跑，也從<char style="pn">約押</char>的弟弟<char style="pn">亞比篩</char>面前逃跑，逃進城裡。於是<char style="pn">約押</char>就回<char style="pn">耶路撒冷</char>去了。<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />
    <char style="pn">亞蘭</char>人見自己敗在<char style="pn">以色列</char>人面前，就派遣使者去把大河<note caller="+" style="f"><char style="fr" closed="false">19:16 </char><char style="ft" closed="false">大河——指幼發拉底河。</char></note>對岸的<char style="pn">亞蘭</char>人調過來，由<char style="pn">哈大底謝</char>的元帥<char style="pn">朔法</char>率領他們。<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />有人向<char style="pn">大衛</char>報告，<char style="pn">大衛</char>就招聚<char style="pn">以色列</char>全軍，過了<char style="pn">約旦</char>河，來到<char style="pn">亞蘭</char>人那裡，對著他們擺陣。<char style="pn">大衛</char>擺陣迎戰<char style="pn">亞蘭</char>人，<char style="pn">亞蘭</char>人就與他交戰。 <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" /><char style="pn">亞蘭</char>人在<char style="pn">以色列</char>人面前逃跑，<char style="pn">大衛</char>殺了<char style="pn">亞蘭</char>的戰車兵七千<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">七千——《撒母耳記下》10:18為「七百」。</char></note>、步兵四萬，並且殺死了元帥<char style="pn">朔法</char>。 <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" /><char style="pn">哈大底謝</char>的臣屬見自己敗在<char style="pn">以色列</char>面前，就與<char style="pn">大衛</char>講和，臣服於他。於是<char style="pn">亞蘭</char>人不敢再幫助<char style="pn">亞捫</char>人了。<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s">攻取拉巴城</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />年初，正是諸王出戰的時候，<char style="pn">約押</char>率領軍兵毀壞了<char style="pn">亞捫</char>人之地，然後去圍困<char style="pn">拉巴</char>。那時<char style="pn">大衛</char>一直留在<char style="pn">耶路撒冷</char>。<char style="pn">約押</char>攻打<char style="pn">拉巴</char>，把城摧毀了。 <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" /><char style="pn">大衛</char>奪取了<char style="pn">亞捫</char>王<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">亞捫王——原文直譯「他們的王」；七十士譯本和有些古抄本作「米勒公」，就是亞捫人的神。</char></note>頭上的王冠，其金子的重量是一他連得<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">一他連得——相當於34.2公斤。</char></note>，其上有寶石；這王冠就戴在<char style="pn">大衛</char>的頭上。<char style="pn">大衛</char>從那城帶走了極多的戰利品， <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />並且把城裡的居民帶出來，讓他們用鋸子、鐵鎬、斧子做工；<char style="pn">大衛</char>對待<char style="pn">亞捫</char>人的各城都是這樣。然後<char style="pn">大衛</char>和全軍回<char style="pn">耶路撒冷</char>去了。<verse eid="1CH 20:3" /></para>
  <para style="s">擊殺非利士巨人</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />此後，<char style="pn">以色列</char>人與<char style="pn">非利士</char>人在<char style="pn">基色</char>起了戰爭；那時<char style="pn">戶沙</char>人<char style="pn">西比凱</char>擊殺了巨人<note caller="+" style="f"><char style="fr" closed="false">20:4 </char><char style="ft" closed="false">巨人——或譯作「利乏音人」。</char></note>的後裔<char style="pn">希派</char>，<char style="pn">非利士</char>人就被制伏了。<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />
    <char style="pn">以色列</char>人與<char style="pn">非利士</char>人又有戰爭。<char style="pn">雅雷</char>的兒子<char style="pn">伊勒哈南</char>擊殺了<char style="pn">迦特</char>人<char style="pn">歌利亞</char>的兄弟<char style="pn">拉哈米</char>，這人長矛的杆像織布的機軸那樣粗。<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />在<char style="pn">迦特</char>又有戰爭。有一個身材高大的人，手腳各有六個指頭，總共二十四個，他也是巨人的後裔。 <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />他向<char style="pn">以色列</char>罵陣，<char style="pn">大衛</char>的哥哥<char style="pn">示米亞</char>的兒子<char style="pn">約拿單</char>把他擊殺了。<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />這些人是<char style="pn">迦特</char>巨人的後裔，他們都倒在<char style="pn">大衛</char>和他臣僕們手下。<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s">數點軍隊人數</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />撒旦<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="ft" closed="false">撒旦——指那控告者。</char></note>起來攻擊<char style="pn">以色列</char>，誘導<char style="pn">大衛</char>去數點<char style="pn">以色列</char>人。 <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" /><char style="pn">大衛</char>對<char style="pn">約押</char>和軍兵的將領們說：「你們去，數點<char style="pn">以色列</char>人，從<char style="pn">比爾-謝巴</char>直到<char style="pn">但</char>，然後回來告訴我，我好知道他們的數目。」<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />
    <char style="pn">約押</char>說：「願耶和華使他的軍兵<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="ft" closed="false">軍兵——或譯作「子民」。</char></note>增添到現有的一百倍。我主我王啊！他們不全都是我主的臣僕嗎？我主何必想做這事呢？為什麼要使<char style="pn">以色列</char>陷入罪裡呢？」<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />但王的命令強過<char style="pn">約押</char>，<char style="pn">約押</char>就出去，走遍全<char style="pn">以色列</char>，之後回到了<char style="pn">耶路撒冷</char>。 <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" /><char style="pn">約押</char>把軍兵的統計數目呈報<char style="pn">大衛</char>：全<char style="pn">以色列</char>中拿刀劍的人有一百一十萬，<char style="pn">猶大</char>中拿刀劍的人有四十七萬。 <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />但是<char style="pn">利未</char>人和<char style="pn">便雅憫</char>人，他沒有數點在內，因為<char style="pn">約押</char>厭惡王這個命令。<verse eid="1CH 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7" />這事在神的眼中看為惡，於是他打擊了<char style="pn">以色列</char>。 <verse eid="1CH 21:7" /><verse number="8" style="v" sid="1CH 21:8" /><char style="pn">大衛</char>對神說：「我做這事，犯了大罪！現在，求你除去你僕人的罪孽，因我做了極其愚蠢的事！」<verse eid="1CH 21:8" /></para>
  <para style="s">大衛遭受懲罰</para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />耶和華吩咐<char style="pn">大衛</char>的先見<char style="pn">迦得</char>，說： <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />「你去告訴<char style="pn">大衛</char>說：『耶和華如此說：我給你三樣災，你從其中挑選一個，我就降在你身上。』」<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />
    <char style="pn">迦得</char>就來見<char style="pn">大衛</char>，對他說：「耶和華如此說：『任你選擇： <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />三年饑荒，或者三個月在敵人面前被驅逐，被仇敵的刀劍追逼，或者三天被耶和華的刀劍攻擊，國中發生瘟疫，耶和華的使者在<char style="pn">以色列</char>的全境施行毀滅。』現在，你看看我應該怎麼回話給派遣我來的那一位。」<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />
    <char style="pn">大衛</char>對<char style="pn">迦得</char>說：「這使我非常為難！還是讓我落在耶和華手中吧，因為他有極其豐盛的憐憫；請不要讓我落在人的手中。」<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />於是耶和華在<char style="pn">以色列</char>降下瘟疫，<char style="pn">以色列</char>中倒斃了七萬人。 <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />神派遣天使去毀滅<char style="pn">耶路撒冷</char>，天使正要毀滅時，耶和華見了就後悔降這禍患，他對施行毀滅的天使說：「夠了，住手吧！」那時耶和華的使者站在<char style="pn">耶布斯</char>人<char style="pn">歐珥楠</char>的打穀場那裡。<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />
    <char style="pn">大衛</char>舉目，看見耶和華的使者站在天地之間，手裡拿著拔出的刀，伸在<char style="pn">耶路撒冷</char>之上。<char style="pn">大衛</char>和長老們都披上麻布，臉伏於地。 <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" /><char style="pn">大衛</char>對神說：「吩咐數點人口的不是我嗎？是我犯了罪，是我行了大惡！這群羊，他們做了什麼呢？耶和華我的神哪，願你的手對付我和我的父家，不要讓瘟疫臨到你的子民。」<verse eid="1CH 21:17" /></para>
  <para style="s">大衛立壇獻祭</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />耶和華的使者吩咐<char style="pn">迦得</char>去告訴<char style="pn">大衛</char>，叫<char style="pn">大衛</char>上去，在<char style="pn">耶布斯</char>人<char style="pn">歐珥楠</char>的打穀場上為耶和華立一座祭壇。 <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" /><char style="pn">大衛</char>就照著<char style="pn">迦得</char>奉耶和華的名所說的話上去了。<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />那時<char style="pn">歐珥楠</char>正在踹小麥，<char style="pn">歐珥楠</char>轉過身來，看見了天使，就與他的四個兒子一同躲藏起來。 <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" /><char style="pn">大衛</char>來到<char style="pn">歐珥楠</char>那裡，<char style="pn">歐珥楠</char>看見<char style="pn">大衛</char>，就從打穀場出來，臉伏於地向<char style="pn">大衛</char>下拜。<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />
    <char style="pn">大衛</char>對<char style="pn">歐珥楠</char>說：「請把打穀場這塊地賣給我，我好在這裡為耶和華築一座祭壇；請按足價賣給我，使瘟疫在百姓中間止住。」<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />
    <char style="pn">歐珥楠</char>對<char style="pn">大衛</char>說：「只管拿去用，我主我王看怎樣好就怎樣做吧！看，我還送上牛作燔祭，打穀器具作木柴，小麥作素祭；這一切我都送給王。」<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />
    <char style="pn">大衛</char>王對<char style="pn">歐珥楠</char>說：「不，我一定要按足價購買，我不能拿你的東西給耶和華，也不能獻上無償的燔祭。」<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />
    <char style="pn">大衛</char>就為那塊地付了<char style="pn">歐珥楠</char>重六百謝克爾<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">六百謝克爾——相當於6.8公斤。1謝克爾=11.4公克。</char></note>的金子。 <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" /><char style="pn">大衛</char>在那裡為耶和華築了一座祭壇，獻上燔祭和平安祭。他向耶和華呼求，耶和華就從天上降火在燔祭的祭壇上，應允了他。<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />耶和華吩咐天使，天使就把劍收回鞘中。 <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />那時候，<char style="pn">大衛</char>見耶和華在<char style="pn">耶布斯</char>人<char style="pn">歐珥楠</char>的打穀場上回應了他，就在那裡獻祭—— <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" /><char style="pn">摩西</char>在曠野所造的耶和華的帳幕，以及燔祭的祭壇，那時候都在<char style="pn">基遍</char>的高壇—— <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />可是<char style="pn">大衛</char>不能夠來到神面前求問，因為耶和華使者的刀使他驚慌失措。<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="nb">
    <verse number="1" style="v" sid="1CH 22:1" />
    <char style="pn">大衛</char>說：「這裡是神耶和華的殿，這裡是<char style="pn">以色列</char>獻燔祭的祭壇。」<verse eid="1CH 22:1" /></para>
  <para style="s">大衛為聖殿籌備</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />
    <char style="pn">大衛</char>吩咐把<char style="pn">以色列</char>地的寄居者招聚起來，又安排石匠開鑿石頭，要用鑿好的料石建造神的殿。 <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" /><char style="pn">大衛</char>預備了大量的鐵，用來製作所有門扇上的釘子和連接件；又預備了銅，多得無法稱量； <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />還有無數的香柏木，因為<char style="pn">西頓</char>人和<char style="pn">提爾</char>人給<char style="pn">大衛</char>運來了大量的香柏木。 <verse eid="1CH 22:4" /><verse number="5" style="v" sid="1CH 22:5" /><char style="pn">大衛</char>想：「我兒子<char style="pn">所羅門</char>年少幼嫩，而要為耶和華建造的殿宇必須極其宏偉，名聲和榮耀傳遍全地。現在我就要為這殿宇<note caller="+" style="f"><char style="fr" closed="false">22:5 </char><char style="ft" closed="false">這殿宇——或譯作「他」。</char></note>做準備。」這樣<char style="pn">大衛</char>在死之前，做了許多的準備。<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />
    <char style="pn">大衛</char>召來他兒子<char style="pn">所羅門</char>，吩咐他要為<char style="pn">以色列</char>的神耶和華建造殿宇。 <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" /><char style="pn">大衛</char>對<char style="pn">所羅門</char>說：「我兒啊，我一直有心為我神耶和華的名建造殿宇， <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />只是耶和華的話語臨到我說：『你流了很多人的血，打過許多仗，你不可為我的名建造殿宇，因為你在我面前，在大地上流了很多人的血。 <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />看哪，你將生一個兒子，他必成為安息之人，我要使他安定，脫離四圍一切仇敵。他的名字要叫<char style="pn">所羅門</char>，他在位的日子，我要把和平、安寧賜給<char style="pn">以色列</char>。 <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />他要為我的名建造殿宇，並且他要作我的兒子，我要作他的父親。我必使他王位堅立，統治<char style="pn">以色列</char>直到永遠。』<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />「我兒啊，現在願耶和華與你同在，使你順利建造你的神耶和華的殿，正如他論到你所說的話。 <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />唯願耶和華賜給你見識和悟性，這樣他委任你統治<char style="pn">以色列</char>時，你就會遵守你的神耶和華的律法。 <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />那時，如果你謹守遵行耶和華指示<char style="pn">摩西</char>給<char style="pn">以色列</char>的律例和法規，就必亨通。你要堅強、勇敢！不要害怕，不要喪膽。<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />「看哪，我辛苦為耶和華的殿預備了金子十萬他連得<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">十萬他連得——相當於3,420公噸。1他連得=34.2公斤。</char></note>，銀子一百萬他連得<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">一百萬他連得——相當於34,200公噸。</char></note>，銅和鐵多得無法稱量；我也預備了木材和料石，你還可以增添。 <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />此外在你這裡有許多工人，石匠，雕刻木頭石頭的，以及一切能做各樣工藝的巧匠， <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />又有無數的金、銀、銅、鐵。起來行動吧，願耶和華與你同在！」<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />
    <char style="pn">大衛</char>又吩咐<char style="pn">以色列</char>所有的首領幫助他兒子<char style="pn">所羅門</char>，說： <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />「你們的神耶和華不是與你們同在嗎？他不是使你們四圍都安定嗎？因他已經把這地的居民交在我手中，這地在耶和華面前和他子民面前被征服了。 <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />現在你們要立定心志尋求耶和華你們的神，起來建造神耶和華的聖所，好把耶和華的約櫃和神的神聖器皿都搬進為耶和華的名所建造的殿宇。」<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s">分配利未人班組</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />
    <char style="pn">大衛</char>年邁，壽數滿足時，立他兒子<char style="pn">所羅門</char>為<char style="pn">以色列</char>的王。 <verse eid="1CH 23:1" /><verse number="2" style="v" sid="1CH 23:2" /><char style="pn">大衛</char>招聚<char style="pn">以色列</char>的所有首領，以及祭司和<char style="pn">利未</char>人。 <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />三十歲以上的<char style="pn">利未</char>人都被數點，按著他們的人頭，數目是男丁三萬八千。 <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />其中監管耶和華殿工作的有兩萬四千人，作官長和審判官的有六千人， <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />門衛有四千人，那些用<char style="pn">大衛</char>所預備的頌讚樂器來讚美耶和華的，有四千人。<verse eid="1CH 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6" />
    <char style="pn">大衛</char>又按著<char style="pn">利未</char>的兒子<char style="pn">革順</char>、<char style="pn">哥轄</char>和<char style="pn">米拉利</char>的宗族，給他們分配班組。<verse eid="1CH 23:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 23:7" />
    <char style="pn">革順</char>人有<char style="pn">拉丹</char>和<char style="pn">示每</char>。<verse eid="1CH 23:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 23:8" />
    <char style="pn">拉丹</char>的兒子，長子是<char style="pn">耶希業</char>，其次是<char style="pn">澤坦</char>和<char style="pn">約珥</char>，共三人。 <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />這些人是<char style="pn">拉丹</char>各父系的首領。</para>
  <para style="mi" vid="1CH 23:9">
    <char style="pn">示每</char>的兒子是<char style="pn">示羅米</char>、<char style="pn">哈薛</char>和<char style="pn">哈蘭</char>，共三人。<verse eid="1CH 23:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 23:10" />
    <char style="pn">示每</char>的子孫是<char style="pn">雅哈</char>、<char style="pn">細撒</char><note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="ft" closed="false">細撒——依據七十士譯本；馬索拉文本作「細拿」；參照下一節。</char></note>、<char style="pn">耶烏施</char>和<char style="pn">比利亞</char>，這四人都是<char style="pn">示每</char>的子孫。<verse eid="1CH 23:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 23:11" />
    <char style="pn">雅哈</char>是長子，<char style="pn">細撒</char>是次子；<char style="pn">耶烏施</char>和<char style="pn">比利亞</char>子孫不多，歸為一個父家，同屬一個職份。<verse eid="1CH 23:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 23:12" />
    <char style="pn">哥轄</char>的兒子是<char style="pn">阿姆蘭</char>、<char style="pn">以斯哈</char>、<char style="pn">希伯倫</char>和<char style="pn">烏基業</char>，共四人。<verse eid="1CH 23:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 23:13" />
    <char style="pn">阿姆蘭</char>的兒子是<char style="pn">亞倫</char>和<char style="pn">摩西</char>。</para>
  <para style="m" vid="1CH 23:13">
    <char style="pn">亞倫</char>和他的子孫永遠被分別出來，為要被分別為至聖的<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="ft" closed="false">為要被分別為至聖的——或譯作「為要把至聖之物分別為聖」。</char></note>，在耶和華面前燒香、事奉，奉耶和華的名祝福，直到永遠。 <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />至於神人<char style="pn">摩西</char>，他的子孫被算在<char style="pn">利未</char>支派中。<verse eid="1CH 23:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 23:15" />
    <char style="pn">摩西</char>的兒子是<char style="pn">革順</char>和<char style="pn">以利以謝</char>。<verse eid="1CH 23:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 23:16" />
    <char style="pn">革順</char>的兒子，有長子<char style="pn">謝布業</char>。<verse eid="1CH 23:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 23:17" />
    <char style="pn">以利以謝</char>的兒子，有頭生的<char style="pn">利哈比雅</char>；<char style="pn">以利以謝</char>沒有別的兒子，但<char style="pn">利哈比雅</char>的兒子卻很多。<verse eid="1CH 23:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 23:18" />
    <char style="pn">以斯哈</char>的兒子，有長子<char style="pn">示羅米</char>。 <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" /><char style="pn">希伯倫</char>的兒子，有長子<char style="pn">耶利雅</char>，</para>
  <para style="mi" vid="1CH 23:19">次子<char style="pn">亞瑪利雅</char>，三子<char style="pn">雅哈希</char>，</para>
  <para style="mi" vid="1CH 23:19">四子<char style="pn">耶咖緬</char>。<verse eid="1CH 23:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 23:20" />
    <char style="pn">烏基業</char>的兒子，有長子<char style="pn">米迦</char>，</para>
  <para style="mi" vid="1CH 23:20">次子<char style="pn">伊示亞</char>。<verse eid="1CH 23:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 23:21" />
    <char style="pn">米拉利</char>的兒子有<char style="pn">瑪赫利</char>和<char style="pn">穆希</char>，</para>
  <para style="mi" vid="1CH 23:21">
    <char style="pn">瑪赫利</char>的兒子有<char style="pn">以利亞撒</char>和<char style="pn">基士</char>。<verse eid="1CH 23:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 23:22" />
    <char style="pn">以利亞撒</char>死了，他沒有兒子，只有女兒，</para>
  <para style="mi" vid="1CH 23:22">她們的族兄弟——就是<char style="pn">基士</char>的眾子——娶了她們。<verse eid="1CH 23:22" /></para>
  <para style="mi">
    <verse number="23" style="v" sid="1CH 23:23" />
    <char style="pn">穆希</char>的兒子有<char style="pn">瑪赫利</char>、<char style="pn">伊德</char>和<char style="pn">耶利莫</char>，共三人。<verse eid="1CH 23:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />以上按著他們的父家，都是<char style="pn">利未</char>的子孫，是各父系的首領，按名單，按著他們的人頭數點，都在二十歲以上，為耶和華的殿服事做工。 <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />因為<char style="pn">大衛</char>說：「<char style="pn">以色列</char>的神耶和華已經使他的子民得享安息，他將永遠居住在<char style="pn">耶路撒冷</char>， <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" /><char style="pn">利未</char>人也不必再抬帳幕和其中一切用於服事的器具了。」 <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />根據<char style="pn">大衛</char>臨終的吩咐，他們都是二十歲以上被數點的<char style="pn">利未</char>子孫。 <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />他們的職任是協助<char style="pn">亞倫</char>子孫做耶和華殿的服事工作，管理庭院和公房，負責潔淨一切聖物，從事神殿的各樣服事工作； <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />負責陳設餅、素祭的細麵粉、無酵薄餅，烤製、揉拌，也負責所有的容量和尺寸； <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />每天早晨侍立，稱謝讚美耶和華，傍晚也是如此； <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />也負責向耶和華獻上一切燔祭，在安息日、新月節和各節期，按照數目，照著規定，把燔祭常獻在耶和華面前。 <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />他們要謹守會幕的職責、聖所的職責，以及協助他們的族兄弟<char style="pn">亞倫</char>子孫的職責，在耶和華的殿服事。<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s">分配祭司班組</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />
    <char style="pn">亞倫</char>子孫的班組如下：<char style="pn">亞倫</char>的兒子是<char style="pn">納達布</char>、<char style="pn">亞比戶</char>、<char style="pn">以利亞撒</char>和<char style="pn">以塔瑪爾</char>。 <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" /><char style="pn">納達布</char>和<char style="pn">亞比戶</char>比他們父親死的早，沒有子嗣，因此<char style="pn">以利亞撒</char>和<char style="pn">以塔瑪爾</char>作祭司。 <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" /><char style="pn">大衛</char>與<char style="pn">以利亞撒</char>的子孫<char style="pn">撒督</char>和<char style="pn">以塔瑪爾</char>的子孫<char style="pn">亞希米勒</char>，按著各人的監管職份，分派他們的服事工作， <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />可是發現<char style="pn">以利亞撒</char>子孫中作首領的比<char style="pn">以塔瑪爾</char>子孫多，就給他們分派如下：<char style="pn">以利亞撒</char>的子孫，按著父家，有十六人作首領；<char style="pn">以塔瑪爾</char>的子孫，按著父家，有八人。 <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />他們以抽籤的方式分派，彼此同等，因為<char style="pn">以利亞撒</char>的子孫和<char style="pn">以塔瑪爾</char>的子孫中，都有在聖所作首領的，以及在神面前作首領的。<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />有<char style="pn">利未</char>人<char style="pn">拿旦業</char>的兒子書記<char style="pn">示瑪雅</char>作記錄，在君王、眾首領、祭司<char style="pn">撒督</char>、<char style="pn">亞比亞特</char>的兒子<char style="pn">亞希米勒</char>，以及祭司和<char style="pn">利未</char>人各父系的首領面前，記錄他們的名字。為<char style="pn">以利亞撒</char>一個父家抽一籤，也為<char style="pn">以塔瑪爾</char>一個父家抽一籤。<verse eid="1CH 24:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 24:7" />第一支籤為<char style="pn">耶赫亞利</char>抽出，第二支為<char style="pn">耶達亞</char>，<verse eid="1CH 24:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 24:8" />第三支為<char style="pn">哈琳</char>，第四支為<char style="pn">梭琳</char>，<verse eid="1CH 24:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 24:9" />第五支為<char style="pn">瑪基雅</char>，第六支為<char style="pn">米雅憫</char>，<verse eid="1CH 24:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 24:10" />第七支為<char style="pn">哈克茲</char>，第八支為<char style="pn">亞比雅</char>，<verse eid="1CH 24:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 24:11" />第九支為<char style="pn">耶書亞</char>，第十支為<char style="pn">謝喀尼亞</char>，<verse eid="1CH 24:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 24:12" />第十一支為<char style="pn">以利亞實</char>，第十二支為<char style="pn">雅其姆</char>，<verse eid="1CH 24:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 24:13" />第十三支為<char style="pn">胡巴</char>，第十四支為<char style="pn">耶示比押</char>，<verse eid="1CH 24:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 24:14" />第十五支為<char style="pn">比勒伽</char>，第十六支為<char style="pn">伊梅爾</char>，<verse eid="1CH 24:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 24:15" />第十七支為<char style="pn">赫茲爾</char>，第十八支為<char style="pn">哈皮澤</char>，<verse eid="1CH 24:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 24:16" />第十九支為<char style="pn">佩塔希雅</char>，第二十支為<char style="pn">以西結</char>，<verse eid="1CH 24:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 24:17" />第二十一支為<char style="pn">雅斤</char>，第二十二支為<char style="pn">迦末</char>，<verse eid="1CH 24:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 24:18" />第二十三支為<char style="pn">德拉雅</char>，第二十四支為<char style="pn">瑪西亞</char>。<verse eid="1CH 24:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />以上就是他們監管職份的班組，為要照著規定進入耶和華的殿服事；這規定是先祖<char style="pn">亞倫</char>經手，照著<char style="pn">以色列</char>的神耶和華的指示所定的。<verse eid="1CH 24:19" /></para>
  <para style="b" />
  <para style="s">分配其餘的利未人</para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 24:20" />至於其餘的<char style="pn">利未</char>子孫：</para>
  <para style="mi" vid="1CH 24:20">
    <char style="pn">阿姆蘭</char>的子孫中有<char style="pn">書巴業</char>，</para>
  <para style="mi" vid="1CH 24:20">
    <char style="pn">書巴業</char>的子孫中有<char style="pn">耶希迪亞</char>。<verse eid="1CH 24:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 24:21" />還有<char style="pn">利哈比雅</char>，</para>
  <para style="mi" vid="1CH 24:21">
    <char style="pn">利哈比雅</char>的子孫中有為首的<char style="pn">伊示亞</char>。<verse eid="1CH 24:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 24:22" />
    <char style="pn">以斯哈</char>的子孫中有<char style="pn">示羅莫</char>，</para>
  <para style="mi" vid="1CH 24:22">
    <char style="pn">示羅莫</char>的子孫中有<char style="pn">雅哈</char>。<verse eid="1CH 24:22" /></para>
  <para style="mi">
    <verse number="23" style="v" sid="1CH 24:23" />還有<char style="pn">希伯倫</char>的兒子：</para>
  <para style="mi" vid="1CH 24:23">長子<char style="pn">耶利雅</char>，次子<char style="pn">亞瑪利雅</char>，</para>
  <para style="mi" vid="1CH 24:23">三子<char style="pn">雅哈希</char>，四子<char style="pn">耶咖緬</char>。<verse eid="1CH 24:23" /></para>
  <para style="mi">
    <verse number="24" style="v" sid="1CH 24:24" />
    <char style="pn">烏基業</char>的子孫中有<char style="pn">米迦</char>，</para>
  <para style="mi" vid="1CH 24:24">
    <char style="pn">米迦</char>的子孫中有<char style="pn">沙米爾</char>。<verse eid="1CH 24:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 24:25" />還有<char style="pn">米迦</char>的兄弟<char style="pn">伊示亞</char>，</para>
  <para style="mi" vid="1CH 24:25">
    <char style="pn">伊示亞</char>的子孫中有<char style="pn">撒迦利亞</char>。<verse eid="1CH 24:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 24:26" />
    <char style="pn">米拉利</char>的子孫中有<char style="pn">瑪赫利</char>、<char style="pn">穆希</char>，</para>
  <para style="mi" vid="1CH 24:26">以及他兒子<char style="pn">雅西雅</char>的子孫<note caller="+" style="f"><char style="fr" closed="false">24:26 </char><char style="ft" closed="false">他兒子雅西雅的子孫——或譯作「雅西雅的子孫比挪」。</char></note>。<verse eid="1CH 24:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 24:27" />
    <char style="pn">米拉利</char>子孫中，屬於<char style="pn">雅西雅</char>的有</para>
  <para style="mi" vid="1CH 24:27">
    <char style="pn">比挪</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24:27 </char>
      <char style="ft" closed="false">屬於雅西雅的有比挪——或譯作「屬於他兒子雅西雅的有」。</char>
    </note>、<char style="pn">朔含</char>、<char style="pn">扎克爾</char>、<char style="pn">伊比利</char>。<verse eid="1CH 24:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 24:28" />屬於<char style="pn">瑪赫利</char>的有<char style="pn">以利亞撒</char>，<char style="pn">以利亞撒</char>沒有兒子；<verse eid="1CH 24:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 24:29" />至於<char style="pn">基士</char>，<char style="pn">基士</char>的子孫中有<char style="pn">耶拉米列</char>。<verse eid="1CH 24:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 24:30" />還有<char style="pn">穆希</char>的兒子<char style="pn">瑪赫利</char>、<char style="pn">伊德</char>和<char style="pn">耶利莫</char>。</para>
  <para style="b" vid="1CH 24:30" />
  <para style="p" vid="1CH 24:30">以上按著他們的父家，都是<char style="pn">利未</char>的子孫。 <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />他們也與他們的族兄弟<char style="pn">亞倫</char>子孫一樣，在<char style="pn">大衛</char>王、<char style="pn">撒督</char>、<char style="pn">亞希米勒</char>，以及祭司和<char style="pn">利未</char>人各父系的首領面前抽籤；族長們與他們最小的族兄弟一樣抽籤。<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s">利未樂師</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />
    <char style="pn">大衛</char>和服事隊伍的首領們也把<char style="pn">亞薩</char>、<char style="pn">希幔</char>和<char style="pn">耶杜頓</char>的子孫分別出來<note caller="+" style="f"><char style="fr" closed="false">25:1 </char><char style="ft" closed="false">服事隊伍的首領們也把……分別出來——或譯作「軍隊的將領們也把……分別出來服事」。</char></note>，要他們伴著豎琴、里拉琴和銅鈸來說神言。他們的服事工作人數如下：<verse eid="1CH 25:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 25:2" />
    <char style="pn">亞薩</char>的兒子有</para>
  <para style="mi" vid="1CH 25:2">
    <char style="pn">扎克爾</char>、<char style="pn">約瑟</char>、<char style="pn">尼坦亞</char>和<char style="pn">亞撒利拉</char>；</para>
  <para style="mi" vid="1CH 25:2">
    <char style="pn">亞薩</char>的兒子們都在<char style="pn">亞薩</char>的指揮下，</para>
  <para style="mi" vid="1CH 25:2">
    <char style="pn">亞薩</char>受王的指示說神言。<verse eid="1CH 25:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 25:3" />屬<char style="pn">耶杜頓</char>的，有<char style="pn">耶杜頓</char>的兒子</para>
  <para style="mi" vid="1CH 25:3">
    <char style="pn">基大利</char>、<char style="pn">西利</char>、<char style="pn">耶賽亞</char>、<char style="pn">示每</char>、<char style="pn">哈沙比雅</char>和<char style="pn">瑪塔提雅</char>，共六人，都在他們父親<char style="pn">耶杜頓</char>的指揮下，伴著豎琴說神言，稱謝讚美耶和華。<verse eid="1CH 25:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 25:4" />屬<char style="pn">希幔</char>的，有<char style="pn">希幔</char>的兒子</para>
  <para style="mi" vid="1CH 25:4">
    <char style="pn">布其雅</char>、<char style="pn">瑪塔尼亞</char>、<char style="pn">烏基業</char>、<char style="pn">謝布業</char>、<char style="pn">耶利莫</char>、<char style="pn">哈納尼雅</char>、<char style="pn">哈納尼</char>、<char style="pn">以利亞塔</char>、<char style="pn">格達利提</char>、<char style="pn">羅幔提·以謝</char>、<char style="pn">約施比咖沙</char>、<char style="pn">瑪羅提</char>、<char style="pn">何提</char>和<char style="pn">瑪哈秀特</char>。 <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />這些都是王的先見<char style="pn">希幔</char>的兒子，是神照著應許，為要高抬他<note caller="+" style="f"><char style="fr" closed="false">25:5 </char><char style="ft" closed="false">高抬他——原文直譯「高舉犄角」。</char></note>而賜予的；神賜給<char style="pn">希幔</char>十四個兒子，三個女兒。<verse eid="1CH 25:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />這些人都在他們父親的指揮下，在耶和華殿中用詩歌，用銅鈸、豎琴和里拉琴做神殿中的服事。<char style="pn">亞薩</char>、<char style="pn">耶杜頓</char>和<char style="pn">希幔</char>受了王的指示服事。 <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />他們連同他們的族兄弟，就是所有在獻給耶和華的詩歌上受過訓練，精通歌唱的，數目共有兩百八十八人。 <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />他們無論尊卑，無論師徒，都一樣為職責抽籤。<verse eid="1CH 25:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 25:9" />第一支籤為<char style="pn">亞薩</char>的子孫<char style="pn">約瑟</char>抽出。第二支為<char style="pn">基大利</char>，以及他的族兄弟、兒子，共十二人。<verse eid="1CH 25:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 25:10" />第三支為<char style="pn">扎克爾</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 25:11" />第四支為<char style="pn">伊希利</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 25:12" />第五支為<char style="pn">尼坦亞</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 25:13" />第六支為<char style="pn">布其雅</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 25:14" />第七支為<char style="pn">耶薩利拉</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 25:15" />第八支為<char style="pn">耶賽亞</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 25:16" />第九支為<char style="pn">瑪塔尼亞</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 25:17" />第十支為<char style="pn">示每</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 25:18" />第十一支為<char style="pn">阿扎列</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 25:19" />第十二支為<char style="pn">哈沙比雅</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 25:20" />第十三支為<char style="pn">書巴業</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 25:21" />第十四支為<char style="pn">瑪塔提雅</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 25:22" />第十五支為<char style="pn">耶利莫</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:22" /></para>
  <para style="mi">
    <verse number="23" style="v" sid="1CH 25:23" />第十六支為<char style="pn">哈納尼雅</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:23" /></para>
  <para style="mi">
    <verse number="24" style="v" sid="1CH 25:24" />第十七支為<char style="pn">約施比咖沙</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 25:25" />第十八支為<char style="pn">哈納尼</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 25:26" />第十九支為<char style="pn">瑪羅提</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 25:27" />第二十支為<char style="pn">以利亞塔</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 25:28" />第二十一支為<char style="pn">何提</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 25:29" />第二十二支為<char style="pn">格達利提</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 25:30" />第二十三支為<char style="pn">瑪哈秀特</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 25:31" />第二十四支為<char style="pn">羅幔提·以謝</char>，以及他的兒子和族兄弟，共十二人。<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s">利未門衛</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />以下是門衛的班組：</para>
  <para style="mi" vid="1CH 26:1">
    <char style="pn">可拉</char>家系<char style="pn">亞薩</char>的子孫中，</para>
  <para style="mi" vid="1CH 26:1">有<char style="pn">可列</char>的兒子<char style="pn">米施利米雅</char>。<verse eid="1CH 26:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 26:2" />
    <char style="pn">米施利米雅</char>的兒子，</para>
  <para style="mi" vid="1CH 26:2">有長子<char style="pn">撒迦利亞</char>，次子<char style="pn">耶迪阿業</char>，</para>
  <para style="mi" vid="1CH 26:2">三子<char style="pn">希巴迪亞</char>，四子<char style="pn">亞特尼爾</char>，<verse eid="1CH 26:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 26:3" />五子<char style="pn">以攔</char>，六子<char style="pn">約哈南</char>，</para>
  <para style="mi" vid="1CH 26:3">七子<char style="pn">以利約奈</char>。<verse eid="1CH 26:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 26:4" />
    <char style="pn">俄別·以東</char>的兒子，</para>
  <para style="mi" vid="1CH 26:4">有長子<char style="pn">示瑪雅</char>，次子<char style="pn">約撒巴</char>，</para>
  <para style="mi" vid="1CH 26:4">三子<char style="pn">約亞</char>，四子<char style="pn">沙卡爾</char>，</para>
  <para style="mi" vid="1CH 26:4">五子<char style="pn">拿旦業</char>， <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />六子<char style="pn">亞米利</char>，</para>
  <para style="mi" vid="1CH 26:5">七子<char style="pn">以薩迦</char>，八子<char style="pn">佩烏利太</char>；</para>
  <para style="mi" vid="1CH 26:5">神實在祝福了<char style="pn">俄別·以東</char>。<verse eid="1CH 26:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 26:6" />他兒子<char style="pn">示瑪雅</char>所生的兒子，都是他們父家的領袖，因為他們是英勇的戰士。<verse eid="1CH 26:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 26:7" />
    <char style="pn">示瑪雅</char>的兒子有<char style="pn">俄得尼</char>、<char style="pn">利法益</char>、<char style="pn">俄備得</char>和<char style="pn">以利薩巴</char>，<char style="pn">以利薩巴</char>的兄弟<char style="pn">以利戶</char>和<char style="pn">西瑪迦</char>都是勇士。 <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />這些都是<char style="pn">俄別·以東</char>的子孫，他們和他們的兒子、族兄弟都是在服事上有能力有才幹的人。<char style="pn">俄別·以東</char>的子孫共有六十二人。<verse eid="1CH 26:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 26:9" />
    <char style="pn">米施利米雅</char>的兒子和族兄弟，都是勇士，共十八人。<verse eid="1CH 26:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 26:10" />
    <char style="pn">米拉利</char>子孫<char style="pn">何薩</char>的兒子，有長子<char style="pn">示姆利</char>——他並不是頭生的，但他父親立他為長子—— <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />次子<char style="pn">希勒加</char>，三子<char style="pn">底巴利雅</char>，四子<char style="pn">撒迦利亞</char>。<char style="pn">何薩</char>的兒子和族兄弟，共有十三個人。<verse eid="1CH 26:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />對於這些門衛的班組，作首領的人與他們的族兄弟一樣有職責，都在耶和華的殿中事奉。 <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />他們無論尊卑，都按著父家，為各門抽籤。<verse eid="1CH 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 26:14" />抽到東門的籤是<char style="pn">示勒米雅</char>。他兒子<char style="pn">撒迦利亞</char>是個有見識的謀士，他們抽籤，他的籤抽出來是北門。 <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" /><char style="pn">俄別·以東</char>抽到南門，他的兒子們抽到了庫房。 <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" /><char style="pn">書皮姆</char>與<char style="pn">何薩</char>抽到西門，連同斜坡大道上的<char style="pn">沙利基</char>門。</para>
  <para style="p" vid="1CH 26:16">守衛與守衛相對而立， <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />每天看守東門的有六個<char style="pn">利未</char>人，看守北門的有四個，看守南門的有四個，看守倉庫的是兩個、兩個輪流。 <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />看守西邊前院的，有四個人在大道上，兩個人在前院裡。<verse eid="1CH 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 26:19" />以上都是<char style="pn">可拉</char>子孫和<char style="pn">米拉利</char>子孫中的門衛班組。<verse eid="1CH 26:19" /></para>
  <para style="s">利未其他的職守</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />
    <char style="pn">利未</char>人<char style="pn">亞希雅</char>管理神殿的庫房，以及存放聖物的庫房。 <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" /><char style="pn">拉丹</char>的子孫，就是屬於<char style="pn">拉丹</char>的<char style="pn">革順</char>人，作<char style="pn">拉丹</char>父系首領的是<char style="pn">革順</char>人<char style="pn">耶希伊利</char>； <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" /><char style="pn">耶希伊利</char>的兒子，就是<char style="pn">澤坦</char>和他的兄弟<char style="pn">約珥</char>，管理耶和華殿中的庫房。<verse eid="1CH 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 26:23" />
    <char style="pn">阿姆蘭</char>家族、<char style="pn">以斯哈</char>家族、<char style="pn">希伯倫</char>家族和<char style="pn">烏基業</char>家族中： <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" /><char style="pn">摩西</char>的孫子、<char style="pn">革順</char>的兒子<char style="pn">謝布業</char>擔任庫房的總管。 <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" /><char style="pn">謝布業</char>的族兄弟是<char style="pn">以利以謝</char>，<char style="pn">以利以謝</char>的兒子是<char style="pn">利哈比雅</char>，<char style="pn">利哈比雅</char>的兒子是<char style="pn">耶賽亞</char>，<char style="pn">耶賽亞</char>的兒子是<char style="pn">約蘭</char>，<char style="pn">約蘭</char>的兒子是<char style="pn">澤克利</char>，<char style="pn">澤克利</char>的兒子是<char style="pn">示羅米</char>； <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />這<char style="pn">示羅米</char>和他的族兄弟們管理所有庫房的聖物，就是<char style="pn">大衛</char>王、各父系首領、千夫長、百夫長和將領們所分別為聖之物。 <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />他們把戰爭中的戰利品分別為聖，以備修繕耶和華的殿。 <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />先見<char style="pn">撒母耳</char>、<char style="pn">基士</char>的兒子<char style="pn">掃羅</char>、<char style="pn">尼珥</char>的兒子<char style="pn">押尼珥</char>和<char style="pn">洗魯雅</char>的兒子<char style="pn">約押</char>所分別為聖的一切，凡是分別為聖的，都由<char style="pn">示羅米</char>和他的族兄弟經手管理。<verse eid="1CH 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29" />
    <char style="pn">以斯哈</char>家族有<char style="pn">克納尼雅</char>和他的兒子們擔當聖殿以外的工作，作<char style="pn">以色列</char>的官長和審判官。 <verse eid="1CH 26:29" /><verse number="30" style="v" sid="1CH 26:30" /><char style="pn">希伯倫</char>家族有<char style="pn">哈沙比雅</char>和他的族兄弟，共一千七百個勇士，在<char style="pn">約旦</char>河西岸擔當<char style="pn">以色列</char>的監管職份，負責耶和華的一切工作和王的服事工作。 <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" /><char style="pn">希伯倫</char>家族的<char style="pn">耶利雅</char>，按著父家譜系是<char style="pn">希伯倫</char>家族的首領；<char style="pn">大衛</char>在位第四十年做普查，在<char style="pn">基列</char>的<char style="pn">雅謝</char>從他們家族中找到一些英勇的戰士。 <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" /><char style="pn">耶利雅</char>的族兄弟有兩千七百人，都是勇士，是各父系的首領。<char style="pn">大衛</char>王指派他們管理<char style="pn">魯本</char>支派、<char style="pn">迦得</char>支派和<char style="pn">瑪拿西</char>半支派中一切有關神的事務和王的事務。<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s">大衛的官吏</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />以下是<char style="pn">以色列</char>子孫各父系的首領、千夫長、百夫長，以及在一切事務上事奉王的官長們的數目。各班組在一年中所有的月份按月輪流出入，每個班組有兩萬四千人。<verse eid="1CH 27:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 27:2" />一月第一班組是<char style="pn">撒巴迪業</char>的兒子<char style="pn">雅朔班</char>負責，他的班組有兩萬四千人。 <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />他是<char style="pn">法勒斯</char>的子孫，是一月班組所有將領的首領。<verse eid="1CH 27:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 27:4" />二月第二班組是<char style="pn">阿赫阿</char>人<char style="pn">朵代</char>負責，領袖<char style="pn">米克羅</char>也在他班組；他的班組有兩萬四千人。<verse eid="1CH 27:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 27:5" />三月第三班組是祭司長<char style="pn">耶赫亞達</char>的兒子將領<char style="pn">比納雅</char>負責，他的班組有兩萬四千人。 <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />這<char style="pn">比納雅</char>是三十勇士之一，管理那三十人，他的兒子<char style="pn">暗米薩拔</char>也在他班組。<verse eid="1CH 27:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 27:7" />四月第四班組是<char style="pn">約押</char>的弟弟<char style="pn">亞撒暉</char>負責，接續他的是他兒子<char style="pn">希巴迪亞</char>；他的班組有兩萬四千人。<verse eid="1CH 27:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 27:8" />五月第五班組是首領<char style="pn">伊斯拉</char>人<char style="pn">珊合</char>負責，他的班組有兩萬四千人。<verse eid="1CH 27:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 27:9" />六月第六班組是<char style="pn">提克亞</char>人<char style="pn">益吉</char>的兒子<char style="pn">伊拉</char>負責，他的班組有兩萬四千人。<verse eid="1CH 27:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 27:10" />七月第七班組是<char style="pn">以法蓮</char>子孫<char style="pn">佩羅尼</char>人<char style="pn">希利斯</char>負責，他的班組有兩萬四千人。<verse eid="1CH 27:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 27:11" />八月第八班組是<char style="pn">謝拉</char>家族的<char style="pn">戶沙</char>人<char style="pn">西比凱</char>負責，他的班組有兩萬四千人。<verse eid="1CH 27:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 27:12" />九月第九班組是<char style="pn">便雅憫</char>子孫<char style="pn">亞拿突</char>人<char style="pn">亞比以謝</char>負責，他的班組有兩萬四千人。<verse eid="1CH 27:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 27:13" />十月第十班組是<char style="pn">謝拉</char>家族的<char style="pn">尼托法</char>人<char style="pn">瑪哈萊</char>負責，他的班組有兩萬四千人。<verse eid="1CH 27:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 27:14" />十一月第十一班組是<char style="pn">以法蓮</char>子孫<char style="pn">比拉頓</char>人<char style="pn">比納雅</char>負責，他的班組有兩萬四千人。<verse eid="1CH 27:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 27:15" />十二月第十二班組是<char style="pn">俄陀聶</char>家系<char style="pn">尼托法</char>人<char style="pn">赫爾達伊</char>負責，他的班組有兩萬四千人。<verse eid="1CH 27:15" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="16" style="v" sid="1CH 27:16" />以下是<char style="pn">以色列</char>各支派的負責人：</para>
  <para style="mi" vid="1CH 27:16">
    <char style="pn">魯本</char>支派的領袖，是<char style="pn">澤克利</char>的兒子<char style="pn">以利以謝</char>；</para>
  <para style="mi" vid="1CH 27:16">
    <char style="pn">西緬</char>支派，是<char style="pn">瑪迦</char>的兒子<char style="pn">示法提雅</char>；<verse eid="1CH 27:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 27:17" />
    <char style="pn">利未</char>支派，是<char style="pn">基姆利</char>的兒子<char style="pn">哈沙比雅</char>；</para>
  <para style="mi" vid="1CH 27:17">
    <char style="pn">亞倫</char>子孫，是<char style="pn">撒督</char>；<verse eid="1CH 27:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 27:18" />
    <char style="pn">猶大</char>支派，是<char style="pn">大衛</char>的哥哥<char style="pn">以利戶</char>；</para>
  <para style="mi" vid="1CH 27:18">
    <char style="pn">以薩迦</char>支派，是<char style="pn">米迦勒</char>的兒子<char style="pn">歐姆利</char>；<verse eid="1CH 27:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 27:19" />
    <char style="pn">西布倫</char>支派，是<char style="pn">俄巴底亞</char>的兒子<char style="pn">伊施瑪雅</char>；</para>
  <para style="mi" vid="1CH 27:19">
    <char style="pn">拿弗他利</char>支派，是<char style="pn">亞斯列</char>的兒子<char style="pn">耶利莫</char>；<verse eid="1CH 27:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 27:20" />
    <char style="pn">以法蓮</char>子孫，是<char style="pn">阿撒細雅</char>的兒子<char style="pn">何西阿</char>；</para>
  <para style="mi" vid="1CH 27:20">
    <char style="pn">瑪拿西</char>半支派，是<char style="pn">皮達雅</char>的兒子<char style="pn">約珥</char>；<verse eid="1CH 27:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 27:21" />
    <char style="pn">瑪拿西</char>在<char style="pn">基列</char>地的那半支派，是<char style="pn">撒迦利亞</char>的兒子<char style="pn">伊度</char>；</para>
  <para style="mi" vid="1CH 27:21">
    <char style="pn">便雅憫</char>支派，是<char style="pn">押尼珥</char>的兒子<char style="pn">雅西業</char>；<verse eid="1CH 27:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 27:22" />
    <char style="pn">但</char>支派，是<char style="pn">耶羅罕</char>的兒子<char style="pn">阿扎列</char>。</para>
  <para style="mi" vid="1CH 27:22">以上是<char style="pn">以色列</char>各支派的首領。<verse eid="1CH 27:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />
    <char style="pn">大衛</char>沒有統計二十歲以下之人的數目，因為耶和華已經應許，他要使<char style="pn">以色列</char>增多，如同天上的星辰。 <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" /><char style="pn">洗魯雅</char>的兒子<char style="pn">約押</char>曾經開始數點，但因著這事，耶和華的震怒臨到了<char style="pn">以色列</char>，所以他沒有完成，數目也沒有記在《<char style="pn">大衛</char>王年代志》上。<verse eid="1CH 27:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 27:25" />負責王室庫房的是<char style="pn">亞迪業</char>的兒子<char style="pn">阿茲瑪維</char>，</para>
  <para style="mi" vid="1CH 27:25">負責郊外、城鎮、鄉村和守望樓那些庫房的是<char style="pn">烏西雅</char>的兒子<char style="pn">約拿單</char>，<verse eid="1CH 27:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 27:26" />負責那些在田野做工、耕種土地之人的，是<char style="pn">基律</char>的兒子<char style="pn">以斯利</char>；<verse eid="1CH 27:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 27:27" />負責葡萄園的是<char style="pn">拉瑪</char>人<char style="pn">示每</char>，</para>
  <para style="mi" vid="1CH 27:27">負責葡萄園中酒庫的是<char style="pn">實弗米</char>人<char style="pn">扎布迪</char>，<verse eid="1CH 27:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 27:28" />負責丘陵上的橄欖園和西克莫無花果樹的是<char style="pn">基第利</char>人<char style="pn">巴勒·哈南</char>，</para>
  <para style="mi" vid="1CH 27:28">負責油庫的是<char style="pn">約阿施</char>，<verse eid="1CH 27:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 27:29" />負責那些牧放在<char style="pn">沙崙</char>的牛群的是<char style="pn">沙崙</char>人<char style="pn">希特賴</char>，</para>
  <para style="mi" vid="1CH 27:29">負責那些牧放在平原的牛群的是<char style="pn">亞第賚</char>的兒子<char style="pn">沙法</char>，<verse eid="1CH 27:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 27:30" />負責駱駝的是<char style="pn">以實瑪利</char>人<char style="pn">阿比勒</char>，</para>
  <para style="mi" vid="1CH 27:30">負責驢子的是<char style="pn">米倫</char>人<char style="pn">耶希迪亞</char>，<verse eid="1CH 27:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 27:31" />負責羊群的是<char style="pn">哈格利</char>人<char style="pn">雅悉</char>。</para>
  <para style="mi" vid="1CH 27:31">以上是為<char style="pn">大衛</char>王管理財物的官員。<verse eid="1CH 27:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />
    <char style="pn">大衛</char>的叔叔<char style="pn">約拿單</char>作謀士，他是有悟性的人，也是文士。<char style="pn">哈克莫尼</char>的兒子<char style="pn">耶希業</char>輔導王子們。 <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" /><char style="pn">亞希多弗</char>也是王的謀士。<char style="pn">亞基</char>人<char style="pn">戶篩</char>是王的朋友。 <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" /><char style="pn">亞希多弗</char>之後，<char style="pn">比納雅</char>的兒子<char style="pn">耶赫亞達</char>和<char style="pn">亞比亞特</char>作謀士。<char style="pn">約押</char>作王的元帥。<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s">大衛指定所羅門建聖殿</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />
    <char style="pn">大衛</char>把<char style="pn">以色列</char>所有的首領招聚到<char style="pn">耶路撒冷</char>，他們是各支派的首領、事奉王的各班組首領、千夫長、百夫長、為王和王子管理一切財物牲畜的官員，還有內臣和勇士們，以及所有英勇的戰士。 <verse eid="1CH 28:1" /><verse number="2" style="v" sid="1CH 28:2" /><char style="pn">大衛</char>王站起來，說：「我的兄弟，我的子民哪，請聽我說！我心中有意要為耶和華的約櫃、為我們神的腳凳建造一個安息之所，並且我已經預備好要建造， <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />然而神對我說：『你不可為我的名建造殿宇，因為你是個戰士，曾經流過人的血。』<verse eid="1CH 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4" />「<char style="pn">以色列</char>的神耶和華從我父的全家揀選我，永遠作<char style="pn">以色列</char>的王。他揀選了<char style="pn">猶大</char>作首領，在<char style="pn">猶大</char>家揀選我父家，又在我父的兒子中喜悅我，立我作全<char style="pn">以色列</char>的王。 <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />從我所有的兒子中——耶和華實在賜給了我許多兒子——他又揀選我兒子<char style="pn">所羅門</char>坐耶和華國度的王位，統治<char style="pn">以色列</char>。 <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />耶和華對我說：『是你的兒子<char style="pn">所羅門</char>，他將要建造我的殿宇和庭院，因為我已揀選他作我的兒子，我要作他的父親。 <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />如果他堅持遵行我的誡命和法規，像今日這樣，我就堅立他的王權，直到永遠。』<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />「現在，耶和華的會眾全體<char style="pn">以色列</char>人都在看，我們的神也在聽：你們要謹守並尋求你們神耶和華的一切誡命，好使你們可以繼承這美地，並且給你們的後代子孫為繼業，直到永遠。<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />「至於你，我兒<char style="pn">所羅門</char>哪，當認識你父親的神，要以完全的心、樂意的靈服事他，因為耶和華鑒察所有人的心，洞察人的每個意念動機。如果你尋求他，他必讓你尋見；如果你離棄他，他必永遠拋棄你。 <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />現在你看，耶和華已經揀選你來建造殿宇為聖所，你要堅強行事！」<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />
    <char style="pn">大衛</char>把聖殿的設計都交給他兒子<char style="pn">所羅門</char>，有門廊、房屋、府庫、樓閣、內殿和施恩座聖所。 <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />這設計包含他靈裡所領受的一切，有耶和華殿的庭院、四圍所有的房間、神殿中的庫房和存放聖物的庫房； <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />還有祭司和<char style="pn">利未</char>人的班組，耶和華殿中的各樣服事工作，以及耶和華殿中各樣服事器具的規格： <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />用於服事的各樣金器所需的金子重量；用於服事的各樣銀器、各樣器皿所需的銀子重量； <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />照著每個燈臺的服事用途，每個燈臺和它燈盞的重量，金燈臺和燈盞所需的金子重量，銀燈臺和燈盞所需的銀子重量； <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />按每張桌子計算，陳設餅的桌子所需的金子重量，銀桌子所需的銀子重量； <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />叉子、碗和壺所需的純金重量；各金碟所需的金子重量；各銀碟所需的銀子重量； <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />純金香壇所需的金子重量；還包括耶和華乘駕的<note caller="+" style="f"><char style="fr" closed="false">28:18 </char><char style="ft" closed="false">耶和華乘駕的——原文直譯「戰車」；參《撒母耳記下》22:11。</char></note>金基路伯的設計，它展翅遮掩著耶和華的約櫃。<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />
    <char style="pn">大衛</char>說：「因耶和華的手在我身上，我明悟了所記錄下來的這一切——這設計的所有細節。」<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />
    <char style="pn">大衛</char>又對他的兒子<char style="pn">所羅門</char>說：「你要堅強、勇敢行事！不要害怕，不要喪膽，因為耶和華神——我的神與你同在。他必不撇下你，也不離棄你，直到耶和華殿中服事所需的一切工作全都完成。 <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />你看，有各班組的祭司和<char style="pn">利未</char>人準備做神殿各樣的服事；那些在各樣工作上有才能並且甘心樂意的人都在你身邊，準備做各樣的服事；首領們和所有百姓都聽從你的一切指揮。」<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s">建聖殿的捐獻</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />
    <char style="pn">大衛</char>王對全體會眾說：「神特別揀選了我兒子<char style="pn">所羅門</char>，他還年少幼嫩，而這工程極大，因為這宮殿不是為人，而是為耶和華神建造的。 <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />我已經盡力為我神的殿預備了金器所需的金子、銀器所需的銀子、銅器所需的銅、鐵器所需的鐵、木器所需的木材，還有紅瑪瑙石、鑲嵌用的孔雀石，以及彩石、各樣的寶石和大量的大理石。 <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />此外，因我喜愛我神的殿，我除了為聖殿所預備的一切之外，也把我自己的金銀珍寶獻給了我神的殿， <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />有三千他連得<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">三千他連得——相當於100公噸。1他連得=34.2公斤。</char></note><char style="pn">俄斐</char>黃金、七千他連得<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">七千他連得——相當於240公噸。</char></note>純銀，要用來裝飾殿宇的牆， <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />並要用金子做金器，銀子做銀器，藉著工匠的手做成各樣的工藝品。今天誰甘願奉獻，全心歸於耶和華呢？」<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />於是各家族的首領、<char style="pn">以色列</char>各支派的首領、千夫長、百夫長和管理王事務的官員，都甘願奉獻。 <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />他們為神殿的服事捐獻了金子五千他連得零一萬達利克<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">五千他連得零一萬達利克——相當於171公噸又84公斤。1他連得=34.2公斤；1達利克金幣=8.4公克。</char></note>，銀子一萬他連得<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">一萬他連得——相當於342公噸。</char></note>，銅一萬八千他連得<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">一萬八千他連得——相當於616公噸。</char></note>，鐵十萬他連得<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">十萬他連得——相當於3,420公噸。</char></note>。 <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />那些有寶石的也捐獻寶石到耶和華殿的庫房裡，由<char style="pn">革順</char>人<char style="pn">耶希業</char>經手管理。 <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />民眾因這些人甘願奉獻而歡喜，因為他們是全心甘願奉獻給耶和華的；<char style="pn">大衛</char>王也極其歡喜快樂。<verse eid="1CH 29:9" /></para>
  <para style="s">大衛的禱告</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />於是<char style="pn">大衛</char>在全體會眾面前頌讚耶和華，<char style="pn">大衛</char>說：「我們先祖<char style="pn">以色列</char>的神耶和華啊，你是當受頌讚的，從永遠到永遠<note caller="+" style="f"><char style="fr" closed="false">29:10 </char><char style="ft" closed="false">永遠到永遠——或譯作「亙古到永遠」。</char></note>！ <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" />耶和華啊，尊大、權柄、榮耀、威嚴、尊榮都是你的，天上地上的萬有都是你的。耶和華啊，國度也是你的，你顯為尊崇，為萬有之首。 <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" />財富和榮耀都從你而來，是你掌管一切。你手中有能力和權柄；你的手使人偉大、強盛。 <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />我們的神哪，現在我們稱謝你，讚美你榮耀之名。<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />「我究竟算什麼呢？我的子民算什麼呢？我們竟然能這樣甘願奉獻！其實一切都從你而來，我們只是把從你手中得來的獻給你。 <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />我們是依靠你的外人，是寄居的，像我們所有的祖先那樣。我們在世的日子如同虛影，沒有盼望。 <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />耶和華我們的神哪，我們預備了這麼多，要為你的聖名建造殿宇，這些都是從你手中得來的，一切都是屬於你的。 <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />我的神哪，我知道你察驗人心，喜悅公平；我懷著正直的心，甘願奉獻了這一切，現在我也歡喜地看見你在這裡的子民都甘願奉獻給你。 <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />我們先祖<char style="pn">亞伯拉罕</char>、<char style="pn">以撒</char>、<char style="pn">以色列</char>的神耶和華啊，求你永遠保守你子民心中這樣的意念動機，使他們立定心志歸向你。 <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />求你賜我兒子<char style="pn">所羅門</char>一顆完全的心，好使他遵守你的誡命、法度和律例，去做成這一切，用我所預備的建造這殿宇。」<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />然後<char style="pn">大衛</char>對全體會眾說：「現在要頌讚耶和華你們的神！」全體會眾就頌讚耶和華他們祖先的神，俯身向耶和華、向王下拜。<verse eid="1CH 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />第二天他們向耶和華獻祭，向耶和華所獻的燔祭有公牛一千頭、公綿羊一千隻、綿羊羔一千隻，還有同獻的酒祭，以及為全體<char style="pn">以色列</char>人獻上的大量祭物。 <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />那一天，他們極其歡喜地在耶和華面前吃喝。</para>
  <para style="s" vid="1CH 29:22">所羅門繼位</para>
  <para style="p" vid="1CH 29:22">他們再次確立<char style="pn">大衛</char>的兒子<char style="pn">所羅門</char>作王，為耶和華膏立他作君王，又膏立<char style="pn">撒督</char>作祭司。 <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />於是<char style="pn">所羅門</char>坐在耶和華設立<note caller="+" style="f"><char style="fr" closed="false">29:23 </char><char style="ft" closed="false">設立——輔助詞語。</char></note>的寶座上，接替他父親<char style="pn">大衛</char>作王。他就亨通，全體<char style="pn">以色列</char>人都聽從他。 <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />所有的首領和勇士，以及<char style="pn">大衛</char>王所有的兒子，都舉手臣服<char style="pn">所羅門</char>王。 <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />耶和華在全體<char style="pn">以色列</char>人面前高抬<char style="pn">所羅門</char>，賜給他王權的尊榮，是在他之前任何一個<char style="pn">以色列</char>王都比不上的。<verse eid="1CH 29:25" /></para>
  <para style="s">大衛生平概述</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />
    <char style="pn">耶西</char>的兒子<char style="pn">大衛</char>作全<char style="pn">以色列</char>的王， <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />他統治<char style="pn">以色列</char>的日子有四十年：在<char style="pn">希伯崙</char>統治七年，在<char style="pn">耶路撒冷</char>統治三十三年。 <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" /><char style="pn">大衛</char>富貴榮華，盡享天年，壽數滿足而死，他的兒子<char style="pn">所羅門</char>接替他作王。 <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" /><char style="pn">大衛</char>王從始至終的事蹟，看哪，都記在《先見<char style="pn">撒母耳</char>紀事》《先知<char style="pn">拿單</char>紀事》和《先見<char style="pn">迦得</char>紀事》上。 <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />他的王權、他的武力，以及他和<char style="pn">以色列</char>並這地列國所經歷的時事，也都記在這些書上。<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>