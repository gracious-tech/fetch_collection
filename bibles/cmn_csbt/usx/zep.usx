<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">西番雅書</para>
  <para style="mt">西番雅書</para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />
    <char style="pn">亞門</char>的兒子<char style="pn">猶大</char>王<char style="pn">約西亞</char>年間，耶和華的話語臨到<char style="pn">西番雅</char>，他是<char style="pn">庫希</char>的兒子、<char style="pn">基大利</char>的孫子、<char style="pn">亞瑪利雅</char>的曾孫、<char style="pn">希西加</char>的玄孫。<verse eid="ZEP 1:1" /></para>
  <para style="b" />
  <para style="s">耶和華的大日子</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2" />耶和華宣告：</para>
  <para style="q1" vid="ZEP 1:2">我要把萬物從地面上徹底清除。<verse eid="ZEP 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3" />耶和華宣告：</para>
  <para style="q1" vid="ZEP 1:3">我必把人類和走獸清除，</para>
  <para style="q1" vid="ZEP 1:3">把天空的鳥和海裡的魚、</para>
  <para style="q1" vid="ZEP 1:3">敗壞的偶像<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">敗壞的偶像——或譯作「絆腳石」。</char></note>和惡人清除。</para>
  <para style="q1" vid="ZEP 1:3">我要把人類從地面上剪除。<verse eid="ZEP 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4" />我必伸手攻擊<char style="pn">猶大</char>，</para>
  <para style="q1" vid="ZEP 1:4">攻擊<char style="pn">耶路撒冷</char>的所有居民。</para>
  <para style="q1" vid="ZEP 1:4">我要從這地鏟除<char style="pn">巴力</char>的殘留痕跡，</para>
  <para style="q1" vid="ZEP 1:4">鏟除那些服事偶像的祭司和他們的名號；<verse eid="ZEP 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5" />剪除那些在屋頂上向天上萬象下拜的，</para>
  <para style="q1" vid="ZEP 1:5">那些敬拜耶和華並指著他起誓、</para>
  <para style="q1" vid="ZEP 1:5">又指著<char style="pn">米勒公</char>起誓的；<verse eid="ZEP 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6" />剪除那些背道不跟從耶和華、</para>
  <para style="q1" vid="ZEP 1:6">不尋求耶和華也不求問他的。<verse eid="ZEP 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7" />你們在主耶和華面前肅靜吧！</para>
  <para style="q1" vid="ZEP 1:7">因為耶和華的日子臨近了，</para>
  <para style="q1" vid="ZEP 1:7">耶和華已經預備了祭物，</para>
  <para style="q1" vid="ZEP 1:7">已經把他召喚的人分別為聖。<verse eid="ZEP 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8" />到了耶和華祭筵的日子，</para>
  <para style="q1" vid="ZEP 1:8">我必懲罰首領和王子們，</para>
  <para style="q1" vid="ZEP 1:8">以及所有穿外邦服裝的人。<verse eid="ZEP 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9" />到那日，</para>
  <para style="q1" vid="ZEP 1:9">我必懲罰所有躍過那門檻的人，</para>
  <para style="q1" vid="ZEP 1:9">他們使殘暴和欺詐充滿主人的神廟<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">神廟——或譯作「殿宇」。</char></note>。<verse eid="ZEP 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10" />耶和華宣告：</para>
  <para style="q1" vid="ZEP 1:10">到那日，必從魚門發出哀呼聲，</para>
  <para style="q1" vid="ZEP 1:10">從城中第二區發出哀號聲，</para>
  <para style="q1" vid="ZEP 1:10">從山間發出崩裂的巨響。<verse eid="ZEP 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11" />
    <char style="pn">瑪革提施</char>的居民哪，哀號吧！</para>
  <para style="q1" vid="ZEP 1:11">所有的<char style="pn">迦南</char>商人都滅亡了，</para>
  <para style="q1" vid="ZEP 1:11">所有稱量銀子的人都被剪除了。<verse eid="ZEP 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12" />到那時，我必提燈搜查<char style="pn">耶路撒冷</char>，</para>
  <para style="q1" vid="ZEP 1:12">懲罰那些安逸享樂<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">安逸享樂——原文直譯「沉醉在酒渣上」。</char></note>的人，</para>
  <para style="q1" vid="ZEP 1:12">他們心裡說：</para>
  <para style="q1" vid="ZEP 1:12">耶和華也不會降福，也不會降禍。<verse eid="ZEP 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13" />他們的財寶必成為擄物，</para>
  <para style="q1" vid="ZEP 1:13">他們的房屋要變為荒場。</para>
  <para style="q1" vid="ZEP 1:13">他們建造房屋，卻不得居住；</para>
  <para style="q1" vid="ZEP 1:13">他們栽種葡萄園，卻喝不到所出的酒。<verse eid="ZEP 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14" />耶和華的大日子臨近了，</para>
  <para style="q1" vid="ZEP 1:14">疾速臨近了！</para>
  <para style="q1" vid="ZEP 1:14">那是耶和華日子的聲音，</para>
  <para style="q1" vid="ZEP 1:14">勇士在那裡痛苦地吼叫！<verse eid="ZEP 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15" />那日是盛怒的日子，</para>
  <para style="q1" vid="ZEP 1:15">患難困苦的日子，</para>
  <para style="q1" vid="ZEP 1:15">毀滅荒蕪的日子，</para>
  <para style="q1" vid="ZEP 1:15">黑暗幽冥的日子，</para>
  <para style="q1" vid="ZEP 1:15">密雲幽暗的日子，<verse eid="ZEP 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 1:16" />是吹號吶喊的日子，</para>
  <para style="q1" vid="ZEP 1:16">要攻打堅固的城和高大的城樓。<verse eid="ZEP 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17" />我必使危難臨到人類，</para>
  <para style="q1" vid="ZEP 1:17">使他們行走如瞎眼的，</para>
  <para style="q1" vid="ZEP 1:17">因為他們對耶和華犯了罪。</para>
  <para style="q1" vid="ZEP 1:17">他們的血必傾灑如塵埃，</para>
  <para style="q1" vid="ZEP 1:17">他們的屍體必拋散如糞土。<verse eid="ZEP 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18" />在耶和華盛怒的日子裡，</para>
  <para style="q1" vid="ZEP 1:18">他們的金銀不能解救他們，</para>
  <para style="q1" vid="ZEP 1:18">全地都將被他的妒火吞噬；</para>
  <para style="q1" vid="ZEP 1:18">是的，</para>
  <para style="q1" vid="ZEP 1:18">他必瞬間向地上所有居民施行滅絕。<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s">呼籲悔改</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1" />不知羞恥的民族啊，</para>
  <para style="q1" vid="ZEP 2:1">你們要聚集起來，聚集起來，<verse eid="ZEP 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2" />要趁著諭旨還沒有實行，</para>
  <para style="q1" vid="ZEP 2:2">你們的日子還沒有像糠秕那樣散去，</para>
  <para style="q1" vid="ZEP 2:2">趁著耶和華猛烈的怒氣還沒有臨到你們，</para>
  <para style="q1" vid="ZEP 2:2">趁著耶和華烈怒的日子還沒有臨到你們！<verse eid="ZEP 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3" />地上所有遵行耶和華法規的卑微人哪，</para>
  <para style="q1" vid="ZEP 2:3">你們要尋求耶和華，</para>
  <para style="q1" vid="ZEP 2:3">尋求公義，尋求謙卑！</para>
  <para style="q1" vid="ZEP 2:3">或許在耶和華烈怒的日子裡，</para>
  <para style="q1" vid="ZEP 2:3">你們還可以藏身。<verse eid="ZEP 2:3" /></para>
  <para style="b" />
  <para style="s">審判列國</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4" />是的，<char style="pn">加沙</char>必被遺棄，</para>
  <para style="q1" vid="ZEP 2:4">
    <char style="pn">阿實基倫</char>要變為荒場，</para>
  <para style="q1" vid="ZEP 2:4">
    <char style="pn">阿實突</char>的居民將在正午被驅逐，</para>
  <para style="q1" vid="ZEP 2:4">
    <char style="pn">以革倫</char>必被拔出。<verse eid="ZEP 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5" />沿海之地的居民<char style="pn">基利提</char>族啊，</para>
  <para style="q1" vid="ZEP 2:5">你有禍了！</para>
  <para style="q1" vid="ZEP 2:5">
    <char style="pn">非利士</char>人之地<char style="pn">迦南</char>啊，</para>
  <para style="q1" vid="ZEP 2:5">這是耶和華針對你的話：</para>
  <para style="q1" vid="ZEP 2:5">我必毀滅你，使你無人居住。<verse eid="ZEP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6" />沿海之地必成為牧場，</para>
  <para style="q1" vid="ZEP 2:6">有牧人的住處和羊群的圍欄。<verse eid="ZEP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7" />這地必歸於<char style="pn">猶大</char>家的餘剩之民，</para>
  <para style="q1" vid="ZEP 2:7">他們將在那裡放牧，</para>
  <para style="q1" vid="ZEP 2:7">傍晚躺臥在<char style="pn">阿實基倫</char>的房屋裡；</para>
  <para style="q1" vid="ZEP 2:7">他們的神耶和華必眷顧他們，</para>
  <para style="q1" vid="ZEP 2:7">使他們的擄民回歸<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">使他們的擄民回歸——或譯作「復興他們的家業」。</char></note>。<verse eid="ZEP 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8" />我聽見了<char style="pn">摩押</char>的辱罵和<char style="pn">亞捫</char>人的毀謗，</para>
  <para style="q1" vid="ZEP 2:8">他們辱罵我的子民，</para>
  <para style="q1" vid="ZEP 2:8">向著我子民的地界自誇。<verse eid="ZEP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9" />因此，<char style="pn">以色列</char>的神萬軍之耶和華宣告：</para>
  <para style="q1" vid="ZEP 2:9">我指著我的永生起誓，</para>
  <para style="q1" vid="ZEP 2:9">
    <char style="pn">摩押</char>必像<char style="pn">所多瑪</char>，</para>
  <para style="q1" vid="ZEP 2:9">
    <char style="pn">亞捫</char>人必像<char style="pn">格摩拉</char>，</para>
  <para style="q1" vid="ZEP 2:9">成為雜草、鹽坑之地，永遠的荒場。</para>
  <para style="q1" vid="ZEP 2:9">我的餘剩之民必掠奪他們，</para>
  <para style="q1" vid="ZEP 2:9">我倖存的國民必繼承那地。<verse eid="ZEP 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10" />這事臨到他們，是由於他們驕傲，</para>
  <para style="q1" vid="ZEP 2:10">他們向著萬軍之耶和華的子民辱罵、自誇。<verse eid="ZEP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11" />耶和華要向他們顯為可畏，</para>
  <para style="q1" vid="ZEP 2:11">他必消滅地上的一切神明，</para>
  <para style="q1" vid="ZEP 2:11">那時列國眾海島將從各自的地方向他下拜。<verse eid="ZEP 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12" />
    <char style="pn">庫實</char>人哪，你們也必被我的刀劍所殺。<verse eid="ZEP 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13" />耶和華必伸手攻擊北方，消滅<char style="pn">亞述</char>；</para>
  <para style="q1" vid="ZEP 2:13">他必使<char style="pn">尼尼微</char>變為荒場，乾旱如同荒漠。<verse eid="ZEP 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14" />牲畜和各樣的走獸躺臥在其中，</para>
  <para style="q1" vid="ZEP 2:14">鵜鶘和豪豬也在柱頂上過夜，</para>
  <para style="q1" vid="ZEP 2:14">窗裡傳來鳴叫的回聲，</para>
  <para style="q1" vid="ZEP 2:14">門檻毀棄，香柏木破敗裸露。<verse eid="ZEP 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15" />這就是曾經歡騰、安然居住的城，</para>
  <para style="q1" vid="ZEP 2:15">她曾心裡說：</para>
  <para style="q1" vid="ZEP 2:15">「唯有我，沒有可比我的！」</para>
  <para style="q1" vid="ZEP 2:15">如今怎麼成了荒場，</para>
  <para style="q1" vid="ZEP 2:15">成了野獸躺臥之地呢？</para>
  <para style="q1" vid="ZEP 2:15">凡是從她旁邊經過的，</para>
  <para style="q1" vid="ZEP 2:15">都會嗤鼻搖手。<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s">耶路撒冷有禍了</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1" />這叛逆、汙穢、欺壓人的城有禍了！<verse eid="ZEP 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2" />她不聽話，不接受管教，</para>
  <para style="q1" vid="ZEP 3:2">不信靠耶和華，不親近她的神。<verse eid="ZEP 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3" />她的首領是吼叫的獅子，</para>
  <para style="q1" vid="ZEP 3:3">她的審判官是夜晚覓食的豺狼，</para>
  <para style="q1" vid="ZEP 3:3">什麼都不留到清晨。<verse eid="ZEP 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4" />她的眾先知是虛浮詭詐的人，</para>
  <para style="q1" vid="ZEP 3:4">她的祭司們褻瀆聖所、踐踏律法。<verse eid="ZEP 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5" />耶和華在這城中是公義的，</para>
  <para style="q1" vid="ZEP 3:5">他不行不義，</para>
  <para style="q1" vid="ZEP 3:5">每日清晨顯明他的公正，從不間斷；</para>
  <para style="q1" vid="ZEP 3:5">不義的人卻不知羞恥。<verse eid="ZEP 3:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6" />我除滅了列國，</para>
  <para style="q1" vid="ZEP 3:6">他們的城樓被摧毀；</para>
  <para style="q1" vid="ZEP 3:6">我使他們的街道荒涼，無人經過。</para>
  <para style="q1" vid="ZEP 3:6">他們的城鎮被毀滅，</para>
  <para style="q1" vid="ZEP 3:6">沒有人煙，無人居住。<verse eid="ZEP 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7" />我想，她只要敬畏我，接受管教，</para>
  <para style="q1" vid="ZEP 3:7">她的住處就不會因我的一切懲罰被剪除。</para>
  <para style="q1" vid="ZEP 3:7">然而，他們從一大早</para>
  <para style="q1" vid="ZEP 3:7">就開始敗壞自己的一切行為。<verse eid="ZEP 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8" />因此，你們要等候我，</para>
  <para style="q1" vid="ZEP 3:8">這是耶和華的宣告，</para>
  <para style="q1" vid="ZEP 3:8">等候我興起一個擄奪<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">興起一個擄奪——七十士譯本作「起來作證」。</char></note>的日子！</para>
  <para style="q1" vid="ZEP 3:8">我裁定了要招聚萬國，聚集列邦，</para>
  <para style="q1" vid="ZEP 3:8">向他們傾瀉我的憤怒、我所有猛烈的怒氣；</para>
  <para style="q1" vid="ZEP 3:8">是的，全地都將被我的妒火吞噬。<verse eid="ZEP 3:8" /></para>
  <para style="b" />
  <para style="s">應許最終的復興</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9" />那時，我要使百姓的嘴唇恢復純潔，</para>
  <para style="q1" vid="ZEP 3:9">好使他們都呼求耶和華的名，</para>
  <para style="q1" vid="ZEP 3:9">同心合意服事他。<verse eid="ZEP 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10" />那些敬拜我的人，</para>
  <para style="q1" vid="ZEP 3:10">就是我那些離散的子民<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">子民——原文直譯「女兒」。</char></note>，</para>
  <para style="q1" vid="ZEP 3:10">必從<char style="pn">庫實</char>河那邊帶來我的供物。<verse eid="ZEP 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11" />在那日，</para>
  <para style="q1" vid="ZEP 3:11">你必不再因那些反叛我的行為而羞愧；</para>
  <para style="q1" vid="ZEP 3:11">那時我必從你們中間除掉高傲自誇的人，</para>
  <para style="q1" vid="ZEP 3:11">你在我的聖山上絕不再高傲。<verse eid="ZEP 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12" />但我要在你們中間留下卑微貧苦的百姓，</para>
  <para style="q1" vid="ZEP 3:12">他們必投靠耶和華的名。<verse eid="ZEP 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13" />
    <char style="pn">以色列</char>的餘剩之民</para>
  <para style="q1" vid="ZEP 3:13">必不再行不義，不再說謊言，</para>
  <para style="q1" vid="ZEP 3:13">他們口中不會有詭詐的舌頭；</para>
  <para style="q1" vid="ZEP 3:13">他們吃喝躺臥，無人驚嚇。<verse eid="ZEP 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14" />女子<char style="pn">錫安</char>哪，你當歡唱！</para>
  <para style="q1" vid="ZEP 3:14">
    <char style="pn">以色列</char>啊，你當歡呼！</para>
  <para style="q1" vid="ZEP 3:14">女子<char style="pn">耶路撒冷</char>啊，你當盡情快樂歡騰！<verse eid="ZEP 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15" />耶和華已經免除對你們的審判，</para>
  <para style="q1" vid="ZEP 3:15">使你們的仇敵轉身離去；</para>
  <para style="q1" vid="ZEP 3:15">
    <char style="pn">以色列</char>的君王耶和華在你們中間，</para>
  <para style="q1" vid="ZEP 3:15">你們必不再懼怕災禍。<verse eid="ZEP 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16" />在那日，必有話對<char style="pn">耶路撒冷</char>說：</para>
  <para style="q1" vid="ZEP 3:16">「<char style="pn">錫安</char>哪，不要害怕，</para>
  <para style="q1" vid="ZEP 3:16">不要讓你的手發軟！<verse eid="ZEP 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17" />你的神耶和華在你們中間，</para>
  <para style="q1" vid="ZEP 3:17">他是施行拯救的勇士；</para>
  <para style="q1" vid="ZEP 3:17">他要因你而歡喜快樂，</para>
  <para style="q1" vid="ZEP 3:17">他是在愛中沉默<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">他是在愛中沉默——七十士譯本作「以他的愛更新你」；或譯作「以他的愛使你安穩」。</char></note>，</para>
  <para style="q1" vid="ZEP 3:17">卻要因你而喜樂歡呼。」<verse eid="ZEP 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18" />我必從你們中間</para>
  <para style="q1" vid="ZEP 3:18">招聚那些因沒有節期而憂傷的人，</para>
  <para style="q1" vid="ZEP 3:18">那曾是你們的重擔與羞辱。<verse eid="ZEP 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19" />看哪！那時我必對付一切苦待你的人。</para>
  <para style="q1" vid="ZEP 3:19">我必拯救瘸腿的，招聚被驅散的；</para>
  <para style="q1" vid="ZEP 3:19">我必使他們在各地所受的恥辱，</para>
  <para style="q1" vid="ZEP 3:19">變為稱讚與好名聲。<verse eid="ZEP 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20" />那時，我必招聚你們，領你們回來。</para>
  <para style="q1" vid="ZEP 3:20">當我在你們眼前使你們的擄民回歸<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">使你們的擄民回歸——或譯作「復興你們的家業」。</char></note>時，</para>
  <para style="q1" vid="ZEP 3:20">必使你們在地上萬民中得名聲和稱讚。</para>
  <para style="q1" vid="ZEP 3:20">這是耶和華說的。<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>