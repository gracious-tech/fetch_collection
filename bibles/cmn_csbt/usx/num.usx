<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NUM" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">民數記</para>
  <para style="mt">民數記</para>
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="s">數點以色列民</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />
    <char style="pn">以色列</char>人出<char style="pn">埃及</char>地之後，第二年二月一日，耶和華在<char style="pn">西奈</char>曠野、在會幕中指示<char style="pn">摩西</char>說： <verse eid="NUM 1:1" /><verse number="2" style="v" sid="NUM 1:2" />「你們要統計全體<char style="pn">以色列</char>會眾的人數；按著家族、父家，按名單<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">名單——原文直譯「人名的數目」；下同。</char></note>，按著他們的人頭統計所有的男子。 <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />你和<char style="pn">亞倫</char>要按著隊伍，數點<char style="pn">以色列</char>二十歲以上所有能出戰的。 <verse eid="NUM 1:3" /><verse number="4" style="v" sid="NUM 1:4" />每個支派要有一個人協助你們，都要是父家的首領。 <verse eid="NUM 1:4" /><verse number="5" style="v" sid="NUM 1:5" />這些協助你們的人，名字如下：</para>
  <para style="q1" vid="NUM 1:5">屬<char style="pn">魯本</char>支派的，是<char style="pn">謝德珥</char>的兒子<char style="pn">以利佐</char>。<verse eid="NUM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 1:6" />屬<char style="pn">西緬</char>支派的，是<char style="pn">蘇利沙代</char>的兒子<char style="pn">謝路米業</char>。<verse eid="NUM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 1:7" />屬<char style="pn">猶大</char>支派的，是<char style="pn">亞米拿達</char>的兒子<char style="pn">拿順</char>。<verse eid="NUM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 1:8" />屬<char style="pn">以薩迦</char>支派的，是<char style="pn">蘇押</char>的兒子<char style="pn">拿旦業</char>。<verse eid="NUM 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 1:9" />屬<char style="pn">西布倫</char>支派的，是<char style="pn">希倫</char>的兒子<char style="pn">以利押</char>。<verse eid="NUM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 1:10" />
    <char style="pn">約瑟</char>的子孫中，</para>
  <para style="q1" vid="NUM 1:10">屬<char style="pn">以法蓮</char>支派的，是<char style="pn">亞米忽</char>的兒子<char style="pn">以利沙瑪</char>；</para>
  <para style="q1" vid="NUM 1:10">屬<char style="pn">瑪拿西</char>支派的，是<char style="pn">佩達佐</char>的兒子<char style="pn">迦瑪列</char>。<verse eid="NUM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NUM 1:11" />屬<char style="pn">便雅憫</char>支派的，是<char style="pn">基多尼</char>的兒子<char style="pn">亞比但</char>。<verse eid="NUM 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NUM 1:12" />屬<char style="pn">但</char>支派的，是<char style="pn">亞米沙代</char>的兒子<char style="pn">亞希以謝</char>。<verse eid="NUM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NUM 1:13" />屬<char style="pn">亞設</char>支派的，是<char style="pn">俄蘭</char>的兒子<char style="pn">帕結</char>。<verse eid="NUM 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NUM 1:14" />屬<char style="pn">迦得</char>支派的，是<char style="pn">德珥</char>的兒子<char style="pn">以利雅薩</char>。<verse eid="NUM 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NUM 1:15" />屬<char style="pn">拿弗他利</char>支派的，是<char style="pn">恩南</char>的兒子<char style="pn">亞希拉</char>。<verse eid="NUM 1:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="NUM 1:16" />以上是會眾裡選召出來的人，都是他們父系支派的領袖，是<char style="pn">以色列</char>千軍的首領。」<verse eid="NUM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17" />於是，<char style="pn">摩西</char>和<char style="pn">亞倫</char>帶著這些被指名的人， <verse eid="NUM 1:17" /><verse number="18" style="v" sid="NUM 1:18" />在二月一日招聚全體會眾，按著家族、父家，按名單，按著他們的人頭，登記二十歲以上的男子。 <verse eid="NUM 1:18" /><verse number="19" style="v" sid="NUM 1:19" /><char style="pn">摩西</char>照著耶和華所指示的，在<char style="pn">西奈</char>曠野數點了他們。<verse eid="NUM 1:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="NUM 1:20" />
    <char style="pn">以色列</char>的長子<char style="pn">魯本</char>的子孫，他們的譜系：按著家族、父家，按名單，按著他們的人頭，二十歲以上所有能出戰的男子， <verse eid="NUM 1:20" /><verse number="21" style="v" sid="NUM 1:21" /><char style="pn">魯本</char>支派被數點的，共四萬六千五百人。<verse eid="NUM 1:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="NUM 1:22" />
    <char style="pn">西緬</char>子孫的譜系：按著家族、父家，按名單數點，按著他們的人頭，二十歲以上所有能出戰的男子， <verse eid="NUM 1:22" /><verse number="23" style="v" sid="NUM 1:23" /><char style="pn">西緬</char>支派被數點的，共五萬九千三百人。<verse eid="NUM 1:23" /></para>
  <para style="mi">
    <verse number="24" style="v" sid="NUM 1:24" />
    <char style="pn">迦得</char>子孫的譜系：按著家族、父家，按名單，二十歲以上所有能出戰的男子， <verse eid="NUM 1:24" /><verse number="25" style="v" sid="NUM 1:25" /><char style="pn">迦得</char>支派被數點的，共四萬五千六百五十人。<verse eid="NUM 1:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="NUM 1:26" />
    <char style="pn">猶大</char>子孫的譜系：按著家族、父家，按名單，二十歲以上所有能出戰的男子， <verse eid="NUM 1:26" /><verse number="27" style="v" sid="NUM 1:27" /><char style="pn">猶大</char>支派被數點的，共七萬四千六百人。<verse eid="NUM 1:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="NUM 1:28" />
    <char style="pn">以薩迦</char>子孫的譜系：按著家族、父家，按名單，二十歲以上所有能出戰的男子， <verse eid="NUM 1:28" /><verse number="29" style="v" sid="NUM 1:29" /><char style="pn">以薩迦</char>支派被數點的，共五萬四千四百人。<verse eid="NUM 1:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="NUM 1:30" />
    <char style="pn">西布倫</char>子孫的譜系：按著家族、父家，按名單，二十歲以上所有能出戰的男子， <verse eid="NUM 1:30" /><verse number="31" style="v" sid="NUM 1:31" /><char style="pn">西布倫</char>支派被數點的，共五萬七千四百人。<verse eid="NUM 1:31" /></para>
  <para style="mi">
    <verse number="32" style="v" sid="NUM 1:32" />
    <char style="pn">約瑟</char>的子孫中，</para>
  <para style="mi" vid="NUM 1:32">
    <char style="pn">以法蓮</char>子孫的譜系：按著家族、父家，按名單，二十歲以上所有能出戰的男子， <verse eid="NUM 1:32" /><verse number="33" style="v" sid="NUM 1:33" /><char style="pn">以法蓮</char>支派被數點的，共四萬零五百人。<verse eid="NUM 1:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="NUM 1:34" />
    <char style="pn">瑪拿西</char>子孫的譜系：按著家族、父家，按名單，二十歲以上所有能出戰的男子， <verse eid="NUM 1:34" /><verse number="35" style="v" sid="NUM 1:35" /><char style="pn">瑪拿西</char>支派被數點的，共三萬兩千兩百人。<verse eid="NUM 1:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="NUM 1:36" />
    <char style="pn">便雅憫</char>子孫的譜系：按著家族、父家，按名單，二十歲以上所有能出戰的男子， <verse eid="NUM 1:36" /><verse number="37" style="v" sid="NUM 1:37" /><char style="pn">便雅憫</char>支派被數點的，共三萬五千四百人。<verse eid="NUM 1:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="NUM 1:38" />
    <char style="pn">但</char>子孫的譜系：按著家族、父家，按名單，二十歲以上所有能出戰的男子， <verse eid="NUM 1:38" /><verse number="39" style="v" sid="NUM 1:39" /><char style="pn">但</char>支派被數點的，共六萬兩千七百人。<verse eid="NUM 1:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="NUM 1:40" />
    <char style="pn">亞設</char>子孫的譜系：按著家族、父家，按名單，二十歲以上所有能出戰的男子， <verse eid="NUM 1:40" /><verse number="41" style="v" sid="NUM 1:41" /><char style="pn">亞設</char>支派被數點的，共四萬一千五百人。<verse eid="NUM 1:41" /></para>
  <para style="mi">
    <verse number="42" style="v" sid="NUM 1:42" />
    <char style="pn">拿弗他利</char>子孫的譜系：按著家族、父家，按名單，二十歲以上所有能出戰的男子， <verse eid="NUM 1:42" /><verse number="43" style="v" sid="NUM 1:43" /><char style="pn">拿弗他利</char>支派被數點的，共五萬三千四百人。<verse eid="NUM 1:43" /></para>
  <para style="b" />
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44" />以上是被數點的人，是<char style="pn">摩西</char>和<char style="pn">亞倫</char>以及<char style="pn">以色列</char>的眾領袖所數點的，領袖有十二人，各人代表自己的父家。 <verse eid="NUM 1:44" /><verse number="45" style="v" sid="NUM 1:45" />這些按父家被數點的<char style="pn">以色列</char>子孫，都是<char style="pn">以色列</char>中二十歲以上所有能出戰的男子； <verse eid="NUM 1:45" /><verse number="46" style="v" sid="NUM 1:46" />被數點的總共有六十萬三千五百五十人。<verse eid="NUM 1:46" /></para>
  <para style="s">利未人的職責</para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47" />
    <char style="pn">利未</char>人沒有按著他們的父系支派與<char style="pn">以色列</char>子孫一起被數點， <verse eid="NUM 1:47" /><verse number="48" style="v" sid="NUM 1:48" />因為耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 1:48" /><verse number="49" style="v" sid="NUM 1:49" />「唯獨不可數點<char style="pn">利未</char>支派，不可將他們的人數與<char style="pn">以色列</char>子孫一起統計。 <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />你要指派<char style="pn">利未</char>人管理見證帳幕和其中的所有器具，以及屬於帳幕的一切。他們要抬帳幕和帳幕的所有器具，做帳幕的事奉，在帳幕的四圍紮營。 <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" />起行的時候，<char style="pn">利未</char>人要拆卸帳幕；紮營的時候，<char style="pn">利未</char>人要立起帳幕。接近帳幕的外人，必須被處死。<verse eid="NUM 1:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 1:52" />「<char style="pn">以色列</char>子孫紮營時，要各按自己的隊伍，各歸自己的營地，各歸自己的旗幟。 <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" />至於<char style="pn">利未</char>人，要紮營在見證帳幕的四圍，以免震怒臨到<char style="pn">以色列</char>會眾；<char style="pn">利未</char>人要謹守見證帳幕的職責。」<verse eid="NUM 1:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54" />
    <char style="pn">以色列</char>子孫就這樣做了；耶和華所指示<char style="pn">摩西</char>的一切，他們都照著做了。<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="s">營地的布置</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />耶和華指示<char style="pn">摩西</char>和<char style="pn">亞倫</char>說： <verse eid="NUM 2:1" /><verse number="2" style="v" sid="NUM 2:2" />「<char style="pn">以色列</char>子孫要各歸自己的旗幟，照著父家的標幟紮營，要對著會幕在四圍紮營。<verse eid="NUM 2:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="NUM 2:3" />「在東邊日出的方向按隊伍紮營的，是<char style="pn">猶大</char>營的旗幟；<char style="pn">猶大</char>子孫的領袖是<char style="pn">亞米拿達</char>的兒子<char style="pn">拿順</char>， <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />他的隊伍，那些被數點的共七萬四千六百人。 <verse eid="NUM 2:4" /><verse number="5" style="v" sid="NUM 2:5" />挨著他紮營的是<char style="pn">以薩迦</char>支派；<char style="pn">以薩迦</char>子孫的領袖是<char style="pn">蘇押</char>的兒子<char style="pn">拿旦業</char>， <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />他的隊伍，那些被數點的共五萬四千四百人。 <verse eid="NUM 2:6" /><verse number="7" style="v" sid="NUM 2:7" />然後是<char style="pn">西布倫</char>支派；<char style="pn">西布倫</char>子孫的領袖是<char style="pn">希倫</char>的兒子<char style="pn">以利押</char>， <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />他的隊伍，那些被數點的共五萬七千四百人。 <verse eid="NUM 2:8" /><verse number="9" style="v" sid="NUM 2:9" />所有屬<char style="pn">猶大</char>營、按隊伍被數點的，共十八萬六千四百人；他們要首先起行。<verse eid="NUM 2:9" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="10" style="v" sid="NUM 2:10" />「在南邊，按隊伍是<char style="pn">魯本</char>營的旗幟；<char style="pn">魯本</char>子孫的領袖是<char style="pn">謝德珥</char>的兒子<char style="pn">以利佐</char>， <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />他的隊伍，那些被數點的共四萬六千五百人。 <verse eid="NUM 2:11" /><verse number="12" style="v" sid="NUM 2:12" />挨著他紮營的是<char style="pn">西緬</char>支派；<char style="pn">西緬</char>子孫的領袖是<char style="pn">蘇利沙代</char>的兒子<char style="pn">謝路米業</char>， <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />他的隊伍，那些被數點的共五萬九千三百人。 <verse eid="NUM 2:13" /><verse number="14" style="v" sid="NUM 2:14" />然後是<char style="pn">迦得</char>支派；<char style="pn">迦得</char>子孫的領袖是<char style="pn">德珥</char>的兒子<char style="pn">以利雅薩</char>， <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />他的隊伍，那些被數點的共四萬五千六百五十人。 <verse eid="NUM 2:15" /><verse number="16" style="v" sid="NUM 2:16" />所有屬<char style="pn">魯本</char>營、按隊伍被數點的，共十五萬一千四百五十人；他們作為第二隊起行。<verse eid="NUM 2:16" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="17" style="v" sid="NUM 2:17" />「隨後，會幕和<char style="pn">利未</char>營要在眾營中間起行。他們怎樣紮營，也怎樣起行；各照自己的位置，各按自己的旗幟。<verse eid="NUM 2:17" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="18" style="v" sid="NUM 2:18" />「在西邊，按隊伍是<char style="pn">以法蓮</char>營的旗幟；<char style="pn">以法蓮</char>子孫的領袖是<char style="pn">亞米忽</char>的兒子<char style="pn">以利沙瑪</char>， <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />他的隊伍，那些被數點的共四萬零五百人。 <verse eid="NUM 2:19" /><verse number="20" style="v" sid="NUM 2:20" />挨著他是<char style="pn">瑪拿西</char>支派；<char style="pn">瑪拿西</char>子孫的領袖是<char style="pn">佩達佐</char>的兒子<char style="pn">迦瑪列</char>， <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />他的隊伍，那些被數點的共三萬兩千兩百人。 <verse eid="NUM 2:21" /><verse number="22" style="v" sid="NUM 2:22" />然後是<char style="pn">便雅憫</char>支派；<char style="pn">便雅憫</char>子孫的領袖是<char style="pn">基多尼</char>的兒子<char style="pn">亞比但</char>， <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />他的隊伍，那些被數點的共三萬五千四百人。 <verse eid="NUM 2:23" /><verse number="24" style="v" sid="NUM 2:24" />所有屬<char style="pn">以法蓮</char>營、按隊伍被數點的，共十萬八千一百人；他們作為第三隊起行。<verse eid="NUM 2:24" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="25" style="v" sid="NUM 2:25" />「在北邊，按隊伍是<char style="pn">但</char>營的旗幟；<char style="pn">但</char>子孫的領袖是<char style="pn">亞米沙代</char>的兒子<char style="pn">亞希以謝</char>， <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />他的隊伍，那些被數點的共六萬兩千七百人。 <verse eid="NUM 2:26" /><verse number="27" style="v" sid="NUM 2:27" />挨著他紮營的是<char style="pn">亞設</char>支派；<char style="pn">亞設</char>子孫的領袖是<char style="pn">俄蘭</char>的兒子<char style="pn">帕結</char>， <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />他的隊伍，那些被數點的共四萬一千五百人。 <verse eid="NUM 2:28" /><verse number="29" style="v" sid="NUM 2:29" />然後是<char style="pn">拿弗他利</char>支派；<char style="pn">拿弗他利</char>子孫的領袖是<char style="pn">恩南</char>的兒子<char style="pn">亞希拉</char>， <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />他的隊伍，那些被數點的共五萬三千四百人。 <verse eid="NUM 2:30" /><verse number="31" style="v" sid="NUM 2:31" />所有屬<char style="pn">但</char>營被數點的，共十五萬七千六百人；他們要隨自己的旗幟最後起行。」<verse eid="NUM 2:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32" />以上是按父家被數點的<char style="pn">以色列</char>子孫；眾營按隊伍被數點的，總共六十萬三千五百五十人。 <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />照著耶和華指示<char style="pn">摩西</char>的，<char style="pn">利未</char>人沒有與<char style="pn">以色列</char>子孫一起被數點。 <verse eid="NUM 2:33" /><verse number="34" style="v" sid="NUM 2:34" /><char style="pn">以色列</char>子孫就這樣做，他們照著耶和華所指示<char style="pn">摩西</char>的一切，按著自己的旗幟紮營，各按家族和父家起行。<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="s">亞倫的兒子和利未人</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />以下是<char style="pn">亞倫</char>和<char style="pn">摩西</char>的家系記事，那時耶和華在<char style="pn">西奈</char>山向<char style="pn">摩西</char>說話。<verse eid="NUM 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 3:2" />
    <char style="pn">亞倫</char>兒子們的名字是：長子<char style="pn">納達布</char>，還有<char style="pn">亞比戶</char>、<char style="pn">以利亞撒</char>、<char style="pn">以塔瑪爾</char>。 <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />這些是<char style="pn">亞倫</char>兒子們的名字，他們是受膏的祭司，<char style="pn">摩西</char>使他們承接聖職作祭司。 <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" /><char style="pn">納達布</char>和<char style="pn">亞比戶</char>在<char style="pn">西奈</char>曠野向耶和華獻上違規的火，就死在耶和華面前；他們沒有兒子。<char style="pn">以利亞撒</char>和<char style="pn">以塔瑪爾</char>在父親<char style="pn">亞倫</char>面前<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">面前——或譯作「活著時」。</char></note>作祭司。<verse eid="NUM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 3:5" /><verse number="6" style="v" sid="NUM 3:6" />「你要讓<char style="pn">利未</char>支派上前來，侍立在祭司<char style="pn">亞倫</char>面前，輔助他。 <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />他們要在會幕前為<char style="pn">亞倫</char>和全體會眾謹守職責，做帳幕的服事工作。 <verse eid="NUM 3:7" /><verse number="8" style="v" sid="NUM 3:8" />他們也要看管會幕的所有器具，並且為<char style="pn">以色列</char>子民謹守職責，做帳幕的服事工作。 <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />你要把<char style="pn">利未</char>人指派給<char style="pn">亞倫</char>和他的兒子們，這是從<char style="pn">以色列</char>子孫中特別指派給他們的。 <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />你要指派<char style="pn">亞倫</char>和他的兒子們謹守他們祭司的職份；接近帳幕的外人，必須被處死。」<verse eid="NUM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />耶和華又指示<char style="pn">摩西</char>說： <verse eid="NUM 3:11" /><verse number="12" style="v" sid="NUM 3:12" />「看哪，我已經從<char style="pn">以色列</char>子孫中揀選了<char style="pn">利未</char>人，代替<char style="pn">以色列</char>子孫中所有頭生的長子，所以<char style="pn">利未</char>人要歸屬我。 <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" />因為所有頭生的都屬於我；<char style="pn">埃及</char>地所有頭生的被我擊殺那天，我已經使<char style="pn">以色列</char>所有頭生的，無論是人還是牲畜，都分別為聖歸於我了，他們是屬於我的。我是耶和華。」<verse eid="NUM 3:13" /></para>
  <para style="s">數點利未人</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />耶和華在<char style="pn">西奈</char>曠野指示<char style="pn">摩西</char>說： <verse eid="NUM 3:14" /><verse number="15" style="v" sid="NUM 3:15" />「你要按父家和家族數點<char style="pn">利未</char>子孫；所有一個月以上的男性，你都要數點。」 <verse eid="NUM 3:15" /><verse number="16" style="v" sid="NUM 3:16" /><char style="pn">摩西</char>就按照耶和華的命令，照著所受的指示數點他們。<verse eid="NUM 3:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="NUM 3:17" />以下是<char style="pn">利未</char>兒子們的名字：<char style="pn">革順</char>，<char style="pn">哥轄</char>，<char style="pn">米拉利</char>。 <verse eid="NUM 3:17" /><verse number="18" style="v" sid="NUM 3:18" /><char style="pn">革順</char>兒子的名字，按家族是<char style="pn">立尼</char>、<char style="pn">示每</char>。 <verse eid="NUM 3:18" /><verse number="19" style="v" sid="NUM 3:19" /><char style="pn">哥轄</char>的兒子，按家族是<char style="pn">阿姆蘭</char>、<char style="pn">以斯哈</char>、<char style="pn">希伯倫</char>、<char style="pn">烏基業</char>。 <verse eid="NUM 3:19" /><verse number="20" style="v" sid="NUM 3:20" /><char style="pn">米拉利</char>的兒子，按家族是<char style="pn">瑪赫利</char>、<char style="pn">穆希</char>。這些是<char style="pn">利未</char>人的家族，各按他們的父家。<verse eid="NUM 3:20" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="21" style="v" sid="NUM 3:21" />屬<char style="pn">革順</char>的，有<char style="pn">立尼</char>家族和<char style="pn">示每</char>家族；這些是<char style="pn">革順</char>的家族。 <verse eid="NUM 3:21" /><verse number="22" style="v" sid="NUM 3:22" />他們被數點的，是所有一個月以上男性的數目，被數點的共七千五百人。 <verse eid="NUM 3:22" /><verse number="23" style="v" sid="NUM 3:23" /><char style="pn">革順</char>家族要在帳幕後面靠西邊紮營， <verse eid="NUM 3:23" /><verse number="24" style="v" sid="NUM 3:24" /><char style="pn">革順</char>人的父家領袖是<char style="pn">拉伊勒</char>的兒子<char style="pn">以利雅薩</char>。 <verse eid="NUM 3:24" /><verse number="25" style="v" sid="NUM 3:25" /><char style="pn">革順</char>子孫在會幕中負責：帳幕，罩篷，罩篷的頂罩，會幕入口的簾幕， <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />院子的帷幔，在帳幕和祭壇四圍的院子入口的簾幕，它們的繩子，以及相關的一切工作。<verse eid="NUM 3:26" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="27" style="v" sid="NUM 3:27" />屬<char style="pn">哥轄</char>的，有<char style="pn">阿姆蘭</char>家族、<char style="pn">以斯哈</char>家族、<char style="pn">希伯倫</char>家族、<char style="pn">烏基業</char>家族；這些是<char style="pn">哥轄</char>的家族。 <verse eid="NUM 3:27" /><verse number="28" style="v" sid="NUM 3:28" />所有一個月以上男性的數目，共八千六百<note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">八千六百——或譯作「八千三百」。</char></note>人；他們要謹守聖所的職責。 <verse eid="NUM 3:28" /><verse number="29" style="v" sid="NUM 3:29" /><char style="pn">哥轄</char>子孫的家族要在帳幕南邊紮營， <verse eid="NUM 3:29" /><verse number="30" style="v" sid="NUM 3:30" /><char style="pn">哥轄</char>家族的父家領袖是<char style="pn">烏基業</char>的兒子<char style="pn">以利撒番</char>。 <verse eid="NUM 3:30" /><verse number="31" style="v" sid="NUM 3:31" />他們負責：約櫃，桌子，燈臺，祭壇和香壇，事奉用的聖所器具，簾幕，以及相關的一切工作。 <verse eid="NUM 3:31" /><verse number="32" style="v" sid="NUM 3:32" /><char style="pn">利未</char>人眾領袖的主管是祭司<char style="pn">亞倫</char>的兒子<char style="pn">以利亞撒</char>，他是那些謹守聖所職責之人的監督。<verse eid="NUM 3:32" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="33" style="v" sid="NUM 3:33" />屬<char style="pn">米拉利</char>的，有<char style="pn">瑪賀利</char>家族和<char style="pn">穆希</char>家族；這些是<char style="pn">米拉利</char>的家族。 <verse eid="NUM 3:33" /><verse number="34" style="v" sid="NUM 3:34" />他們被數點的，所有一個月以上男性的數目，共六千兩百人。 <verse eid="NUM 3:34" /><verse number="35" style="v" sid="NUM 3:35" /><char style="pn">米拉利</char>家族的父家領袖是<char style="pn">亞比亥</char>的兒子<char style="pn">蘇列</char>，他們要在帳幕北邊紮營。 <verse eid="NUM 3:35" /><verse number="36" style="v" sid="NUM 3:36" /><char style="pn">米拉利</char>子孫所負責的是：帳幕的木板，門閂，柱子，底座，帳幕的所有器具，以及相關的一切工作， <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />還有院子四圍的柱子和它們的底座、橛子、繩子。<verse eid="NUM 3:37" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="38" style="v" sid="NUM 3:38" />在帳幕前面朝東，就是在會幕前面日出方向紮營的，是<char style="pn">摩西</char>和<char style="pn">亞倫</char>以及<char style="pn">亞倫</char>的兒子們。他們為聖所和<char style="pn">以色列</char>子民謹守職責<note caller="+" style="f"><char style="fr" closed="false">3:38 </char><char style="ft" closed="false">為聖所和以色列子民謹守職責——或譯作「代表以色列子民謹守聖所的職責」。</char></note>。接近帳幕的外人，必須被處死。<verse eid="NUM 3:38" /></para>
  <para style="b" />
  <para style="p">
    <verse number="39" style="v" sid="NUM 3:39" />所有被數點的<char style="pn">利未</char>人，就是<char style="pn">摩西</char>和<char style="pn">亞倫</char>按照耶和華的指示、按家族數點的，所有一個月以上的男性，總共兩萬兩千人。<verse eid="NUM 3:39" /></para>
  <para style="s">頭生者的贖價</para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />耶和華對<char style="pn">摩西</char>說：「你要數點<char style="pn">以色列</char>子孫中所有一個月以上的頭生男性，按名單統計他們。 <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />我是耶和華，你要揀選<char style="pn">利未</char>人歸於我，代替<char style="pn">以色列</char>子孫所有頭生的；並要用<char style="pn">利未</char>人的牲畜，代替<char style="pn">以色列</char>子孫所有頭生的牲畜。」 <verse eid="NUM 3:41" /><verse number="42" style="v" sid="NUM 3:42" /><char style="pn">摩西</char>就照著耶和華所指示的，數點<char style="pn">以色列</char>子孫中所有頭生的。 <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />按名單，所有一個月以上的頭生男性，被數點的有兩萬兩千兩百七十三人。<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 3:44" /><verse number="45" style="v" sid="NUM 3:45" />「你要揀選<char style="pn">利未</char>人，代替<char style="pn">以色列</char>子孫中所有頭生的；並要用<char style="pn">利未</char>人的牲畜，代替<char style="pn">以色列</char>子孫的牲畜。<char style="pn">利未</char>人要歸於我，我是耶和華。 <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" /><char style="pn">以色列</char>子孫頭生的男子比<char style="pn">利未</char>人多出了兩百七十三人，他們的贖價， <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />你要每人收取五謝克爾，按聖所的謝克爾<note caller="+" style="f"><char style="fr" closed="false">3:47 </char><char style="ft" closed="false">謝克爾——重量單位；後來成為貨幣單位。1謝克爾=11.4公克。本章下同。</char></note>標準收取，一謝克爾是二十季拉<note caller="+" style="f"><char style="fr" closed="false">3:47 </char><char style="ft" closed="false">二十季拉——相當於11.4公克。1季拉=0.57公克。</char></note>。 <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />你要把銀子，就是多出來之人的贖價，交給<char style="pn">亞倫</char>和他的兒子們。」<verse eid="NUM 3:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49" />
    <char style="pn">摩西</char>就在<char style="pn">利未</char>人所贖的人以外，向多出來的人收取贖價的銀子。 <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />他從這些<char style="pn">以色列</char>子孫的頭生子那裡收取了銀子，按聖所的謝克爾標準，共一千三百七十五謝克爾<note caller="+" style="f"><char style="fr" closed="false">3:50 </char><char style="ft" closed="false">一千三百七十五謝克爾——相當於15.7公斤。1謝克爾=11.4公克。</char></note>。 <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" /><char style="pn">摩西</char>按照耶和華的吩咐，把贖價銀子交給了<char style="pn">亞倫</char>和他的兒子們，正如耶和華所指示<char style="pn">摩西</char>的。<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="s">哥轄子孫的職責</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />耶和華指示<char style="pn">摩西</char>和<char style="pn">亞倫</char>說： <verse eid="NUM 4:1" /><verse number="2" style="v" sid="NUM 4:2" />「你們要按家族和父家，統計<char style="pn">利未</char>子孫中<char style="pn">哥轄</char>子孫的人數， <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />就是三十歲以上到五十歲，所有前來供職、在會幕中工作的人數。<verse eid="NUM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 4:4" />「<char style="pn">哥轄</char>子孫在會幕中有關至聖物的服事工作如下： <verse eid="NUM 4:4" /><verse number="5" style="v" sid="NUM 4:5" />當營隊起行時，<char style="pn">亞倫</char>和他的兒子們要進去，取下簾幕的幔子，用它遮蓋見證櫃。 <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />又放上海獅皮<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">海獅皮——原文語義不確定，基本意思是一種精細的皮革；本章下同。</char></note>的頂罩，再鋪上純藍色的布，然後穿進杠子。<verse eid="NUM 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7" />「<char style="pn">亞倫</char>和他的兒子們要在陳設餅的桌子上鋪藍色的布，其上擺放盤子、勺子、碗和酒祭用的壺，常獻的餅也必須在桌上。 <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />又在它們上面鋪朱紅色的布，再用海獅皮的頂罩遮蓋，然後穿進杠子。<verse eid="NUM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9" />「他們要取來藍色的布，遮蓋燈臺和燈臺的燈盞、燈剪、燈盤，以及所有的油罐，就是用來盛油的器皿。 <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />然後把燈臺和燈臺的所有器具放進海獅皮的頂罩內，放在臺架上。<verse eid="NUM 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11" />「他們要在金祭壇上鋪藍色的布，再用海獅皮的頂罩遮蓋，然後穿進杠子。 <verse eid="NUM 4:11" /><verse number="12" style="v" sid="NUM 4:12" />他們要把聖所中事奉用的所有器具取來，包在藍色的布裡，再用海獅皮的頂罩遮蓋它們，然後放在臺架上。<verse eid="NUM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13" />「他們要收去祭壇的灰，然後在祭壇上鋪紫色的布。 <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />又把祭壇上事奉用的所有器具，就是火盆、叉子、鏟子、碗，以及一切祭壇用具，都放在祭壇上；再鋪上海獅皮的頂罩，然後穿進杠子。<verse eid="NUM 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15" />「營隊起行的時候，<char style="pn">亞倫</char>和他的兒子們把聖物和聖所的所有器具都遮蓋完畢，之後<char style="pn">哥轄</char>的子孫要進來抬；他們不可觸碰聖物，免得死亡。這些就是會幕中<char style="pn">哥轄</char>子孫負責扛抬的。<verse eid="NUM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16" />「祭司<char style="pn">亞倫</char>的兒子<char style="pn">以利亞撒</char>所負責的，是燈油、芬芳香、常獻的素祭和膏油，並負責整個帳幕和帳幕裡的一切，聖所和聖所內的器具。」<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />耶和華指示<char style="pn">摩西</char>和<char style="pn">亞倫</char>說： <verse eid="NUM 4:17" /><verse number="18" style="v" sid="NUM 4:18" />「不要讓<char style="pn">哥轄</char>家族的支系從<char style="pn">利未</char>人中被除滅。 <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />要為他們這樣做：當他們接近至聖物的時候，<char style="pn">亞倫</char>和他的兒子們要進去，安排他們每個人的服事工作和各人要負責扛抬的；這樣他們就可以存活，不致死亡。 <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" />他們片刻都不可進去看聖物，免得他們死亡。」<verse eid="NUM 4:20" /></para>
  <para style="s">革順子孫的職責</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 4:21" /><verse number="22" style="v" sid="NUM 4:22" />「你也要按父家和家族，統計<char style="pn">革順</char>子孫的人數， <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />數點三十歲以上到五十歲，所有前來供職、在會幕中做服事的人。<verse eid="NUM 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24" />「<char style="pn">革順</char>家族的服事、扛抬工作如下： <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />他們要抬帳幕的幔帳、會幕和它的頂罩以及覆蓋其上的海獅皮頂罩，還有會幕入口的簾幕， <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />院子的帷幔，在帳幕和祭壇四圍的院子入口的簾幕，它們的繩子，以及服事用的一切器具；所有相關的工作，他們都要去做。<verse eid="NUM 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 4:27" />「<char style="pn">革順</char>子孫所有的服事，所有的扛抬和服事工作，都要遵照<char style="pn">亞倫</char>和他兒子們的吩咐；他們所有的扛抬工作，你們都要為他們指派相關的職責。 <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />這是<char style="pn">革順</char>子孫各家族在會幕中的服事，是在祭司<char style="pn">亞倫</char>的兒子<char style="pn">以塔瑪爾</char>手下履行的職責。<verse eid="NUM 4:28" /></para>
  <para style="s">米拉利子孫的職責</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />「<char style="pn">米拉利</char>的子孫，你也要按家族和父家數點他們， <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />數點三十歲以上到五十歲，所有前來供職、做會幕服事工作的人。<verse eid="NUM 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 4:31" />「他們在會幕中的一切服事，要負責的扛抬工作如下：帳幕的木板，門閂，柱子和底座， <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />院子四圍的柱子和它們的底座、橛子、繩子，以及相關的一切器具，相關的一切工作。你們要按名字指派他們負責扛抬的器具。 <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />這是<char style="pn">米拉利</char>子孫各家族的服事，是他們在會幕中的各樣服事，在祭司<char style="pn">亞倫</char>的兒子<char style="pn">以塔瑪爾</char>手下履行。」<verse eid="NUM 4:33" /></para>
  <para style="s">數點供職的利未人</para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34" />於是，<char style="pn">摩西</char>和<char style="pn">亞倫</char>以及會眾領袖們按家族和父家，數點<char style="pn">哥轄</char>的子孫。 <verse eid="NUM 4:34" /><verse number="35" style="v" sid="NUM 4:35" />三十歲以上到五十歲，所有前來供職、在會幕中服事的人， <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />按著家族被數點，有兩千七百五十人。 <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />這些就是<char style="pn">哥轄</char>家族所有在會幕中服事、被數點的人，<char style="pn">摩西</char>和<char style="pn">亞倫</char>按照耶和華藉著<char style="pn">摩西</char>所指示的，數點了他們。<verse eid="NUM 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38" />
    <char style="pn">革順</char>子孫被數點的，是按家族和父家， <verse eid="NUM 4:38" /><verse number="39" style="v" sid="NUM 4:39" />三十歲以上到五十歲，所有前來供職、在會幕中服事的人； <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />他們按家族和父家被數點的，有兩千六百三十人。 <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />這些就是<char style="pn">革順</char>子孫各家族所有在會幕中服事、被數點的人，是<char style="pn">摩西</char>和<char style="pn">亞倫</char>按照耶和華的指示數點的。<verse eid="NUM 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42" />
    <char style="pn">米拉利</char>子孫各家族被數點的，是按家族和父家， <verse eid="NUM 4:42" /><verse number="43" style="v" sid="NUM 4:43" />三十歲以上到五十歲，所有前來供職、在會幕中服事的人； <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />他們按家族被數點的，有三千兩百人。 <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />這些就是<char style="pn">米拉利</char>子孫各家族被數點的人，<char style="pn">摩西</char>和<char style="pn">亞倫</char>按照耶和華藉著<char style="pn">摩西</char>所指示的，數點了他們。<verse eid="NUM 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46" />
    <char style="pn">摩西</char>和<char style="pn">亞倫</char>以及<char style="pn">以色列</char>眾領袖數點<char style="pn">利未</char>人，所有被數點的，是按家族和父家， <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />三十歲以上到五十歲，所有前來在會幕中做服事工作和扛抬工作的人。 <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />他們被數點的，總共是八千五百八十人， <verse eid="NUM 4:48" /><verse number="49" style="v" sid="NUM 4:49" />都是按照耶和華的吩咐，藉著<char style="pn">摩西</char>數點的，各人負責自己的服事工作和扛抬工作。<char style="pn">摩西</char>照著耶和華所指示他的，數點了他們。<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="s">隔離不潔淨的人</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 5:1" /><verse number="2" style="v" sid="NUM 5:2" />「你要吩咐<char style="pn">以色列</char>子民：把所有患痲瘋病的、所有患漏症的、所有因接觸屍體而不潔淨的，都從營裡送出去。 <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" />無論男女，都要送出去。你們要把他們送到營地外面，以免玷汙了他們的營地，因為我居住在他們中間。」 <verse eid="NUM 5:3" /><verse number="4" style="v" sid="NUM 5:4" /><char style="pn">以色列</char>子民就這樣做，把他們送到營地外面。耶和華所指示<char style="pn">摩西</char>的，<char style="pn">以色列</char>子民都照著做了。<verse eid="NUM 5:4" /></para>
  <para style="s">贖罪賠償</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 5:5" /><verse number="6" style="v" sid="NUM 5:6" />「你要吩咐<char style="pn">以色列</char>子民：如果有男人或女人犯了人常犯的任何罪，以致不忠於耶和華，那人就要承擔罪責。 <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />他要承認自己所犯的罪，按全數對他的虧負作出賠償，並且加上五分之一，交給他所虧負的人。 <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />但如果被虧負的人沒有近親為他接受損害賠償，那麼，這損害賠償以及犯罪之人的贖罪祭公綿羊，都歸於耶和華，歸給祭司。 <verse eid="NUM 5:8" /><verse number="9" style="v" sid="NUM 5:9" /><char style="pn">以色列</char>子民帶到祭司那裡的所有聖物中，凡是供物，都要歸給祭司。 <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />各人的聖物原屬於自己，各人獻到祭司那裡的，要歸給祭司。」<verse eid="NUM 5:10" /></para>
  <para style="s">關於丈夫猜忌的條例</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 5:11" /><verse number="12" style="v" sid="NUM 5:12" />「你要吩咐<char style="pn">以色列</char>子民，對他們說：如果一個人的妻子行為不軌，對丈夫不忠， <verse eid="NUM 5:12" /><verse number="13" style="v" sid="NUM 5:13" />有男人與她同寢交合，但她瞞過了丈夫，隱藏了這事，她使自己受玷汙卻沒有見證人，也沒有被捉住—— <verse eid="NUM 5:13" /><verse number="14" style="v" sid="NUM 5:14" />無論是丈夫起了猜忌的心，猜忌妻子，而她確實玷汙了自己，或者是丈夫起了猜忌的心，猜忌妻子，而她並沒有玷汙自己—— <verse eid="NUM 5:14" /><verse number="15" style="v" sid="NUM 5:15" />這個人就要把自己的妻子帶到祭司那裡，並且為她帶來祭物，就是十分之一伊法<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">十分之一伊法——相當於2.2公升。1伊法＝22公升。</char></note>大麥粉。不可澆上油，也不可加上乳香，因為這是猜忌的素祭，是想起罪孽的反思素祭。<verse eid="NUM 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16" />「祭司要讓她上前來，站在耶和華面前。 <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />祭司要用瓦器取聖水，還要取一些在帳幕地面上的塵土，放在水中。 <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />祭司要讓那女人站在耶和華面前，散開那女人的頭髮，然後把反思素祭，就是猜忌的素祭，放在她手掌上。祭司要手裡端著會帶來詛咒的苦水， <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />讓那女人起誓，對她說：『如果沒有別的男人與你同寢，如果你在丈夫權下沒有行為不軌受玷汙，你就免於這詛咒苦水的罪罰。 <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />但如果你在丈夫權下行為不軌，與丈夫以外的男人交合，玷汙了自己——』 <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" />這時祭司要讓那女人以詛咒的誓言起誓，然後對那女人說：『當耶和華使你大腿萎縮、肚子腫脹的時候，願耶和華使你在族人中間成為詛咒和誓語。 <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" />願這帶來詛咒的水進入你的肚腹，使肚子腫脹、大腿萎縮。』那女人就要說：『阿們，阿們。』<verse eid="NUM 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23" />「祭司要將這些詛咒寫在書卷上，把這些字擦抹到苦水裡。 <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />之後要讓那女人喝這帶來詛咒的苦水，這詛咒的水就會進入她體内產生痛苦。 <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />祭司要從那女人手中接過猜忌的素祭，在耶和華面前把這素祭搖一搖，然後帶到祭壇那裡。 <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />祭司要從素祭中捧出一把，作為記念部分，在祭壇上燒獻為煙，然後讓女人喝那水。<verse eid="NUM 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 5:27" />「祭司讓她喝那水以後：如果她玷汙了自己，對她丈夫不忠，這帶來詛咒的水就會進到她體内，產生痛苦。她的肚子會腫脹，她的大腿會萎縮，那女人就在族人中間成為詛咒。 <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" />但如果那女人沒有使自己受玷汙，她是清白的，她就免於罪罰，仍然能懷孕生子。<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29" />「這就是關於猜忌的條例：如果妻子在丈夫權下行為不軌，玷汙了自己， <verse eid="NUM 5:29" /><verse number="30" style="v" sid="NUM 5:30" />或者丈夫起了猜忌的心，猜忌自己的妻子，就要讓那女人站在耶和華面前，祭司要對她執行這一切條例。 <verse eid="NUM 5:30" /><verse number="31" style="v" sid="NUM 5:31" />這樣丈夫就免於罪責，那女人卻要承擔自己的罪責。」<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="s">拿細耳人的離俗條例</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 6:1" /><verse number="2" style="v" sid="NUM 6:2" />「你要吩咐<char style="pn">以色列</char>子民，對他們說：如果有男人或女人許了特殊的願，就是<char style="pn">拿細耳</char>人<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">拿細耳人——意思是「分別出來的人」；本章下同。</char></note>的願，為要離俗歸於耶和華， <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />他就要遠離淡酒烈酒，也不可喝淡酒烈酒做的醋。任何葡萄汁，他都不可喝；鮮的或乾的葡萄，他也不可吃。 <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />在他離俗的所有日子，凡是葡萄樹所出產的，甚至是葡萄籽或葡萄皮的產物，他都不可吃。<verse eid="NUM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5" />「在他許願離俗的所有日子，他都不可用剃刀剃他的頭。他要分別為聖，任由頭髮變長，直到他離俗歸於耶和華的日子滿了。 <verse eid="NUM 6:5" /><verse number="6" style="v" sid="NUM 6:6" />他在離俗歸於耶和華的所有日子，都不可接近死人的屍體。 <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />即使那是他的父母、兄弟或姐妹，當他們死的時候，他也不可為他們玷汙自己，因為離俗歸神的標記在他頭上。 <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />在他離俗的所有日子，他都是歸耶和華為聖的。<verse eid="NUM 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9" />「如果有人突然死在他旁邊，以致玷汙了他離俗的頭，他就要在第七天，在得潔淨的日子剃頭。 <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />在第八天，他要把兩隻斑鳩或兩隻雛鴿帶到會幕入口給祭司。 <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />祭司要獻一隻作贖罪祭，一隻作燔祭，為他贖那因屍體而帶來的罪污。當天，他要使他的頭重新分別為聖， <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />重新把離俗的日子獻給耶和華，並且帶來一隻一歲的公羊羔作贖愆祭；先前的那些日子失效了，因為他的離俗已經被玷汙。<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />「拿細耳人有以下條例：在他離俗的日子滿了那天，要讓他來到會幕入口。 <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />他要向耶和華獻上他的祭物，一隻無瑕疵的一歲公羊羔作燔祭，一隻無瑕疵的一歲母羊羔作贖罪祭，一隻無瑕疵的公綿羊作平安祭， <verse eid="NUM 6:14" /><verse number="15" style="v" sid="NUM 6:15" />還有一籃子調了油的無酵細麵餅和抹了油的無酵薄餅，以及同獻的素祭和酒祭。<verse eid="NUM 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16" />「祭司要把這些祭物帶到耶和華面前，獻上那人的贖罪祭和燔祭， <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />並將那隻公綿羊連同那一籃子無酵餅獻給耶和華作平安祭，還要獻上同獻的素祭和酒祭。<verse eid="NUM 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18" />「拿細耳人要在會幕入口剃自己離俗的頭，把他的離俗頭髮拿去，放在平安祭下的火中。 <verse eid="NUM 6:18" /><verse number="19" style="v" sid="NUM 6:19" />他剃了自己離俗的頭之後，祭司要取出煮過的公綿羊前腿，並從籃子裡取出一個無酵餅和一個無酵薄餅，放在這拿細耳人手掌上。 <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" />然後祭司要把它們作為搖獻祭物，在耶和華面前搖一搖；這些連同搖獻祭物的胸肉以及供物的大腿，都是歸於祭司的聖物。之後拿細耳人就可以喝酒了。<verse eid="NUM 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21" />「這是拿細耳人的條例。如果他在離俗許願之外，還向耶和華許願獻上他所能負擔的祭物，他就要在離俗條例之外，也按照所許的願去做。」<verse eid="NUM 6:21" /></para>
  <para style="s">祭司祝福以色列子民</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 6:22" /><verse number="23" style="v" sid="NUM 6:23" />「你要吩咐<char style="pn">亞倫</char>和他的兒子們，要這樣祝福<char style="pn">以色列</char>子民，對他們說：<verse eid="NUM 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24" />願耶和華祝福你，保守你；<verse eid="NUM 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25" />願耶和華使他的臉光照你，恩待你；<verse eid="NUM 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26" />願耶和華向你顯出笑容，賜你平安。<verse eid="NUM 6:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27" />他們要這樣把我的名安置在<char style="pn">以色列</char>子民身上，我就祝福他們。」<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="s">領袖們的祭物</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />
    <char style="pn">摩西</char>立起了帳幕，就在當天膏抹帳幕，使帳幕和它的所有器具，祭壇和它的所有器具都分別為聖。他膏抹這些，使它們分別為聖之後， <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" /><char style="pn">以色列</char>的眾領袖，他們各父家的首領就來奉獻。他們是那些協助數點人口的各支派領袖。 <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />他們把自己的禮物帶到耶和華面前，就是六輛篷車和十二頭公牛，每兩個領袖一輛車，每一個首領一頭牛。他們在帳幕面前獻上這些， <verse eid="NUM 7:3" /><verse number="4" style="v" sid="NUM 7:4" />耶和華就指示<char style="pn">摩西</char>說： <verse eid="NUM 7:4" /><verse number="5" style="v" sid="NUM 7:5" />「你要收下他們的奉獻，用來做會幕的服事，並按照各人的服事，把牛和車交給<char style="pn">利未</char>人。」<verse eid="NUM 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6" />
    <char style="pn">摩西</char>就收下車和牛，交給了<char style="pn">利未</char>人。 <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />他按照<char style="pn">革順</char>子孫的服事，把兩輛車和四頭公牛交給他們。 <verse eid="NUM 7:7" /><verse number="8" style="v" sid="NUM 7:8" />又按照<char style="pn">米拉利</char>子孫在<char style="pn">亞倫</char>的兒子祭司<char style="pn">以塔瑪爾</char>手下的服事，把四輛車和八頭公牛交給他們。 <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />但他沒有把這些交給<char style="pn">哥轄</char>的子孫，因為他們的服事工作是用肩膀扛抬聖物。<verse eid="NUM 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10" />在膏抹祭壇的那天，領袖們帶來了祭壇奉獻禮的禮物。這些領袖把禮物帶到祭壇前， <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" />耶和華對<char style="pn">摩西</char>說：「他們要每天一個領袖，輪流<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">每天一個領袖，輪流——原文直譯「一天一個領袖、一天一個領袖」。</char></note>為祭壇的奉獻禮獻上各自的禮物。」<verse eid="NUM 7:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="NUM 7:12" />第一天獻上禮物的，是<char style="pn">猶大</char>支派<char style="pn">亞米拿達</char>的兒子<char style="pn">拿順</char>。 <verse eid="NUM 7:12" /><verse number="13" style="v" sid="NUM 7:13" />他的禮物是：一個銀盤，重一百三十謝克爾<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">一百三十謝克爾——相當於1,482公克；本章下同。1謝克爾=11.4公克。</char></note>，一個銀碗，重七十謝克爾<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">七十謝克爾——相當於798公克；本章下同。</char></note>，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:13" /><verse number="14" style="v" sid="NUM 7:14" />一個金勺子，重十謝克爾<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">十謝克爾——相當於114公克；本章下同。</char></note>，盛滿了香； <verse eid="NUM 7:14" /><verse number="15" style="v" sid="NUM 7:15" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:15" /><verse number="16" style="v" sid="NUM 7:16" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:16" /><verse number="17" style="v" sid="NUM 7:17" />兩頭公牛，五隻公綿羊，五隻公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">亞米拿達</char>的兒子<char style="pn">拿順</char>的禮物。<verse eid="NUM 7:17" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="18" style="v" sid="NUM 7:18" />第二天獻上的，是<char style="pn">以薩迦</char>的領袖，<char style="pn">蘇押</char>的兒子<char style="pn">拿旦業</char>。 <verse eid="NUM 7:18" /><verse number="19" style="v" sid="NUM 7:19" />他獻上的禮物是：一個銀盤，重一百三十謝克爾，一個銀碗，重七十謝克爾，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:19" /><verse number="20" style="v" sid="NUM 7:20" />一個金勺子，重十謝克爾，盛滿了香； <verse eid="NUM 7:20" /><verse number="21" style="v" sid="NUM 7:21" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:21" /><verse number="22" style="v" sid="NUM 7:22" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:22" /><verse number="23" style="v" sid="NUM 7:23" />兩頭公牛，五隻公綿羊，五隻公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">蘇押</char>的兒子<char style="pn">拿旦業</char>的禮物。<verse eid="NUM 7:23" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="24" style="v" sid="NUM 7:24" />第三天是<char style="pn">西布倫</char>子孫的領袖，<char style="pn">希倫</char>的兒子<char style="pn">以利押</char>。 <verse eid="NUM 7:24" /><verse number="25" style="v" sid="NUM 7:25" />他的禮物是：一個銀盤，重一百三十謝克爾，一個銀碗，重七十謝克爾，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:25" /><verse number="26" style="v" sid="NUM 7:26" />一個金勺子，重十謝克爾，盛滿了香； <verse eid="NUM 7:26" /><verse number="27" style="v" sid="NUM 7:27" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:27" /><verse number="28" style="v" sid="NUM 7:28" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:28" /><verse number="29" style="v" sid="NUM 7:29" />兩頭公牛，五隻公綿羊，五隻公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">希倫</char>的兒子<char style="pn">以利押</char>的禮物。<verse eid="NUM 7:29" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="30" style="v" sid="NUM 7:30" />第四天是<char style="pn">魯本</char>子孫的領袖，<char style="pn">謝德珥</char>的兒子<char style="pn">以利佐</char>。 <verse eid="NUM 7:30" /><verse number="31" style="v" sid="NUM 7:31" />他的禮物是：一個銀盤，重一百三十謝克爾，一個銀碗，重七十謝克爾，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:31" /><verse number="32" style="v" sid="NUM 7:32" />一個金勺子，重十謝克爾，盛滿了香； <verse eid="NUM 7:32" /><verse number="33" style="v" sid="NUM 7:33" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:33" /><verse number="34" style="v" sid="NUM 7:34" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:34" /><verse number="35" style="v" sid="NUM 7:35" />兩頭公牛，五隻公綿羊，五隻公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">謝德珥</char>的兒子<char style="pn">以利佐</char>的禮物。<verse eid="NUM 7:35" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="36" style="v" sid="NUM 7:36" />第五天是<char style="pn">西緬</char>子孫的領袖，<char style="pn">蘇利沙代</char>的兒子<char style="pn">謝路米業</char>。 <verse eid="NUM 7:36" /><verse number="37" style="v" sid="NUM 7:37" />他的禮物是：一個銀盤，重一百三十謝克爾，一個銀碗，重七十謝克爾，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:37" /><verse number="38" style="v" sid="NUM 7:38" />一個金勺子，重十謝克爾，盛滿了香； <verse eid="NUM 7:38" /><verse number="39" style="v" sid="NUM 7:39" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:39" /><verse number="40" style="v" sid="NUM 7:40" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:40" /><verse number="41" style="v" sid="NUM 7:41" />兩頭公牛，五隻公綿羊，五隻公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">蘇利沙代</char>的兒子<char style="pn">謝路米業</char>的禮物。<verse eid="NUM 7:41" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="42" style="v" sid="NUM 7:42" />第六天是<char style="pn">迦得</char>子孫的領袖，<char style="pn">德珥</char>的兒子<char style="pn">以利雅薩</char>。 <verse eid="NUM 7:42" /><verse number="43" style="v" sid="NUM 7:43" />他的禮物是：一個銀盤，重一百三十謝克爾，一個銀碗，重七十謝克爾，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:43" /><verse number="44" style="v" sid="NUM 7:44" />一個金勺子，重十謝克爾，盛滿了香； <verse eid="NUM 7:44" /><verse number="45" style="v" sid="NUM 7:45" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:45" /><verse number="46" style="v" sid="NUM 7:46" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:46" /><verse number="47" style="v" sid="NUM 7:47" />兩頭公牛，五隻公綿羊，五隻公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">德珥</char>的兒子<char style="pn">以利雅薩</char>的禮物。<verse eid="NUM 7:47" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="48" style="v" sid="NUM 7:48" />第七天是<char style="pn">以法蓮</char>子孫的領袖，<char style="pn">亞米忽</char>的兒子<char style="pn">以利沙瑪</char>。 <verse eid="NUM 7:48" /><verse number="49" style="v" sid="NUM 7:49" />他的禮物是：一個銀盤，重一百三十謝克爾，一個銀碗，重七十謝克爾，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:49" /><verse number="50" style="v" sid="NUM 7:50" />一個金勺子，重十謝克爾，盛滿了香； <verse eid="NUM 7:50" /><verse number="51" style="v" sid="NUM 7:51" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:51" /><verse number="52" style="v" sid="NUM 7:52" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:52" /><verse number="53" style="v" sid="NUM 7:53" />兩頭公牛，五隻公綿羊，五隻公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">亞米忽</char>的兒子<char style="pn">以利沙瑪</char>的禮物。<verse eid="NUM 7:53" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="54" style="v" sid="NUM 7:54" />第八天是<char style="pn">瑪拿西</char>子孫的領袖，<char style="pn">佩達佐</char>的兒子<char style="pn">迦瑪列</char>。 <verse eid="NUM 7:54" /><verse number="55" style="v" sid="NUM 7:55" />他的禮物是：一個銀盤，重一百三十謝克爾，一個銀碗，重七十謝克爾，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:55" /><verse number="56" style="v" sid="NUM 7:56" />一個金勺子，重十謝克爾，盛滿了香； <verse eid="NUM 7:56" /><verse number="57" style="v" sid="NUM 7:57" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:57" /><verse number="58" style="v" sid="NUM 7:58" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:58" /><verse number="59" style="v" sid="NUM 7:59" />兩頭公牛，五隻公綿羊，五隻公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">佩達佐</char>的兒子<char style="pn">迦瑪列</char>的禮物。<verse eid="NUM 7:59" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="60" style="v" sid="NUM 7:60" />第九天是<char style="pn">便雅憫</char>子孫的領袖，<char style="pn">基多尼</char>的兒子<char style="pn">亞比但</char>。 <verse eid="NUM 7:60" /><verse number="61" style="v" sid="NUM 7:61" />他的禮物是：一個銀盤，重一百三十謝克爾，一個銀碗，重七十謝克爾，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:61" /><verse number="62" style="v" sid="NUM 7:62" />一個金勺子，重十謝克爾，盛滿了香； <verse eid="NUM 7:62" /><verse number="63" style="v" sid="NUM 7:63" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:63" /><verse number="64" style="v" sid="NUM 7:64" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:64" /><verse number="65" style="v" sid="NUM 7:65" />兩頭公牛，五隻公綿羊，五只公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">基多尼</char>的兒子<char style="pn">亞比但</char>的禮物。<verse eid="NUM 7:65" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="66" style="v" sid="NUM 7:66" />第十天是<char style="pn">但</char>子孫的領袖，<char style="pn">亞米沙代</char>的兒子<char style="pn">亞希以謝</char>。 <verse eid="NUM 7:66" /><verse number="67" style="v" sid="NUM 7:67" />他的禮物是：一個銀盤，重一百三十謝克爾，一個銀碗，重七十謝克爾，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:67" /><verse number="68" style="v" sid="NUM 7:68" />一個金勺子，重十謝克爾，盛滿了香； <verse eid="NUM 7:68" /><verse number="69" style="v" sid="NUM 7:69" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:69" /><verse number="70" style="v" sid="NUM 7:70" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:70" /><verse number="71" style="v" sid="NUM 7:71" />兩頭公牛，五隻公綿羊，五隻公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">亞米沙代</char>的兒子<char style="pn">亞希以謝</char>的禮物。<verse eid="NUM 7:71" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="72" style="v" sid="NUM 7:72" />第十一天是<char style="pn">亞設</char>子孫的領袖，<char style="pn">俄蘭</char>的兒子<char style="pn">帕結</char>。 <verse eid="NUM 7:72" /><verse number="73" style="v" sid="NUM 7:73" />他的禮物是：一個銀盤，重一百三十謝克爾，一個銀碗，重七十謝克爾，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:73" /><verse number="74" style="v" sid="NUM 7:74" />一個金勺子，重十謝克爾，盛滿了香； <verse eid="NUM 7:74" /><verse number="75" style="v" sid="NUM 7:75" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:75" /><verse number="76" style="v" sid="NUM 7:76" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:76" /><verse number="77" style="v" sid="NUM 7:77" />兩頭公牛，五隻公綿羊，五隻公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">俄蘭</char>的兒子<char style="pn">帕結</char>的禮物。<verse eid="NUM 7:77" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="78" style="v" sid="NUM 7:78" />第十二天是<char style="pn">拿弗他利</char>子孫的領袖，<char style="pn">恩南</char>的兒子<char style="pn">亞希拉</char>。 <verse eid="NUM 7:78" /><verse number="79" style="v" sid="NUM 7:79" />他的禮物是：一個銀盤，重一百三十謝克爾，一個銀碗，重七十謝克爾，都按聖所的謝克爾標準，兩個器皿都盛滿調了油的細麵粉作素祭； <verse eid="NUM 7:79" /><verse number="80" style="v" sid="NUM 7:80" />一個金勺子，重十謝克爾，盛滿了香； <verse eid="NUM 7:80" /><verse number="81" style="v" sid="NUM 7:81" />一頭公牛，一隻公綿羊，一隻一歲的公羊羔，作燔祭； <verse eid="NUM 7:81" /><verse number="82" style="v" sid="NUM 7:82" />一隻公山羊，作贖罪祭； <verse eid="NUM 7:82" /><verse number="83" style="v" sid="NUM 7:83" />兩頭公牛，五隻公綿羊，五隻公山羊，五隻一歲的公羊羔，作平安祭。這是<char style="pn">恩南</char>的兒子<char style="pn">亞希拉</char>的禮物。<verse eid="NUM 7:83" /></para>
  <para style="b" />
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84" />以上是膏抹祭壇那天，<char style="pn">以色列</char>眾領袖為祭壇奉獻禮所帶來的禮物，總共有：十二個銀盤，十二個銀碗，十二個金勺子。 <verse eid="NUM 7:84" /><verse number="85" style="v" sid="NUM 7:85" />每個銀盤重一百三十謝克爾，每個碗七十謝克爾，所有器皿的銀子，都按聖所的謝克爾標準，共兩千四百謝克爾<note caller="+" style="f"><char style="fr" closed="false">7:85 </char><char style="ft" closed="false">兩千四百謝克爾——相當於27.4公斤。1謝克爾=11.4公克。</char></note>。 <verse eid="NUM 7:85" /><verse number="86" style="v" sid="NUM 7:86" />十二個盛滿了香的金勺子，都按聖所的謝克爾標準，每個勺子是十謝克爾，所有勺子的金子共一百二十謝克爾<note caller="+" style="f"><char style="fr" closed="false">7:86 </char><char style="ft" closed="false">一百二十謝克爾——相當於1,368公克。</char></note>。 <verse eid="NUM 7:86" /><verse number="87" style="v" sid="NUM 7:87" />作燔祭的牲畜，共有十二頭公牛，十二隻公綿羊，十二隻一歲的公羊羔；還有同獻的素祭；作贖罪祭的有十二隻公山羊； <verse eid="NUM 7:87" /><verse number="88" style="v" sid="NUM 7:88" />作平安祭的牲畜，共有二十四頭公牛，六十隻公綿羊，六十隻公山羊，六十隻一歲的公羊羔。這就是膏抹祭壇之後，祭壇奉獻禮的禮物。<verse eid="NUM 7:88" /></para>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89" />
    <char style="pn">摩西</char>進入會幕要與耶和華說話的時候，會聽見有聲音從見證櫃上面的施恩座上方、從兩個基路伯之間對他說話，耶和華就這樣對他說話。<verse eid="NUM 7:89" /></para>
  <chapter eid="NUM 7" />
  <chapter number="8" style="c" sid="NUM 8" />
  <para style="s">會幕的燈檯</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 8:1" /><verse number="2" style="v" sid="NUM 8:2" />「你要吩咐<char style="pn">亞倫</char>，對他說：點燈的時候，要讓七盞燈照亮燈臺的前面。」 <verse eid="NUM 8:2" /><verse number="3" style="v" sid="NUM 8:3" /><char style="pn">亞倫</char>就這樣做了。他照著耶和華所指示<char style="pn">摩西</char>的，點燃了燈照亮燈臺的前面。 <verse eid="NUM 8:3" /><verse number="4" style="v" sid="NUM 8:4" />燈臺的工藝是用金子錘擛，從底座到花朵都錘擛成形；<char style="pn">摩西</char>照著耶和華所顯示給他的樣式，做了燈臺。<verse eid="NUM 8:4" /></para>
  <para style="s">利未人承接聖職</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 8:5" /><verse number="6" style="v" sid="NUM 8:6" />「你要從<char style="pn">以色列</char>子孫中揀選<char style="pn">利未</char>人，為他們舉行潔淨禮。 <verse eid="NUM 8:6" /><verse number="7" style="v" sid="NUM 8:7" />你要對他們這樣做，使他們得潔淨：要把贖罪的水彈灑在他們身上，又讓他們用剃刀剃全身，並且洗自己的衣服，這樣他們就得潔淨了。<verse eid="NUM 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 8:8" />「然後他們要取來一頭公牛，還有同獻的素祭，就是調了油的細麵粉；你也要另外取來一頭公牛，作贖罪祭。 <verse eid="NUM 8:8" /><verse number="9" style="v" sid="NUM 8:9" />你要把<char style="pn">利未</char>人帶到會幕前面，並且招聚全體<char style="pn">以色列</char>會眾。 <verse eid="NUM 8:9" /><verse number="10" style="v" sid="NUM 8:10" />當你把<char style="pn">利未</char>人帶到了耶和華面前，<char style="pn">以色列</char>子孫就要按手在<char style="pn">利未</char>人身上。 <verse eid="NUM 8:10" /><verse number="11" style="v" sid="NUM 8:11" /><char style="pn">亞倫</char>要從<char style="pn">以色列</char>子孫中把<char style="pn">利未</char>人作為搖獻祭，奉獻在耶和華面前，使他們可以做服事耶和華的工作。 <verse eid="NUM 8:11" /><verse number="12" style="v" sid="NUM 8:12" /><char style="pn">利未</char>人要按手在兩頭公牛的頭上，一頭作贖罪祭，另一頭作燔祭，獻給耶和華，為<char style="pn">利未</char>人贖罪。<verse eid="NUM 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 8:13" />「你要讓<char style="pn">利未</char>人站在<char style="pn">亞倫</char>和他的兒子們面前，把他們作為搖獻祭，奉獻給耶和華。 <verse eid="NUM 8:13" /><verse number="14" style="v" sid="NUM 8:14" />這樣，你把<char style="pn">利未</char>人從<char style="pn">以色列</char>子孫中分別出來，<char style="pn">利未</char>人就歸屬我了。 <verse eid="NUM 8:14" /><verse number="15" style="v" sid="NUM 8:15" />此後，<char style="pn">利未</char>人要進入會幕服事。你要潔淨他們，把他們作為搖獻祭獻上。 <verse eid="NUM 8:15" /><verse number="16" style="v" sid="NUM 8:16" />因為他們是從<char style="pn">以色列</char>子孫中特定獻給我的，我已經揀選了他們，代替<char style="pn">以色列</char>子孫中所有的頭胎、所有的長子歸屬我。 <verse eid="NUM 8:16" /><verse number="17" style="v" sid="NUM 8:17" /><char style="pn">以色列</char>子孫中所有頭生的，無論是人還是牲畜，都屬於我；我在擊殺<char style="pn">埃及</char>地所有頭生的那一天，已經把他們分別為聖歸於我。 <verse eid="NUM 8:17" /><verse number="18" style="v" sid="NUM 8:18" />但我揀選<char style="pn">利未</char>人代替<char style="pn">以色列</char>子孫中所有頭生的； <verse eid="NUM 8:18" /><verse number="19" style="v" sid="NUM 8:19" />我從<char style="pn">以色列</char>子孫中把<char style="pn">利未</char>人作為奉獻，賜給<char style="pn">亞倫</char>和他的兒子們，在會幕中為<char style="pn">以色列</char>子民做服事，並為<char style="pn">以色列</char>子民贖罪，免得<char style="pn">以色列</char>子民接近聖所時，災殃臨到<char style="pn">以色列</char>子民。」<verse eid="NUM 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20" />
    <char style="pn">摩西</char>和<char style="pn">亞倫</char>以及全體<char style="pn">以色列</char>會眾就對<char style="pn">利未</char>人這樣做了；耶和華所指示<char style="pn">摩西</char>有關<char style="pn">利未</char>人的一切，<char style="pn">以色列</char>子民都照樣對他們做了。 <verse eid="NUM 8:20" /><verse number="21" style="v" sid="NUM 8:21" /><char style="pn">利未</char>人潔淨了自己，洗了自己的衣服，<char style="pn">亞倫</char>就把他們作為搖獻祭，奉獻在耶和華面前；<char style="pn">亞倫</char>又為他們贖罪，使他們得潔淨。 <verse eid="NUM 8:21" /><verse number="22" style="v" sid="NUM 8:22" />之後，<char style="pn">利未</char>人進去，在<char style="pn">亞倫</char>和他的兒子們面前，在會幕中做服事。耶和華所指示<char style="pn">摩西</char>有關<char style="pn">利未</char>人的一切，他們都照樣對<char style="pn">利未</char>人做了。<verse eid="NUM 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 8:23" /><verse number="24" style="v" sid="NUM 8:24" />「以下是關於<char style="pn">利未</char>人的安排：二十五歲以上的要前來，在會幕的服事上供職。 <verse eid="NUM 8:24" /><verse number="25" style="v" sid="NUM 8:25" />到了五十歲，他要退出服事工作，不再服事。 <verse eid="NUM 8:25" /><verse number="26" style="v" sid="NUM 8:26" />他可以在會幕中值守，輔助他的弟兄們，但不能做自己的服事。你要這樣安排<char style="pn">利未</char>人的職責。」<verse eid="NUM 8:26" /></para>
  <chapter eid="NUM 8" />
  <chapter number="9" style="c" sid="NUM 9" />
  <para style="s">出埃及後第一次守逾越節</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1" />他們出<char style="pn">埃及</char>地之後，第二年一月，耶和華在<char style="pn">西奈</char>曠野指示<char style="pn">摩西</char>說： <verse eid="NUM 9:1" /><verse number="2" style="v" sid="NUM 9:2" />「<char style="pn">以色列</char>子民要在所定的日期守逾越節。 <verse eid="NUM 9:2" /><verse number="3" style="v" sid="NUM 9:3" />你們要在這個月的十四日，黃昏的時候，按所定的日期守這節。你們要照著所有的律例和法規來守逾越節。」<verse eid="NUM 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 9:4" />於是<char style="pn">摩西</char>吩咐<char style="pn">以色列</char>子民要守逾越節。 <verse eid="NUM 9:4" /><verse number="5" style="v" sid="NUM 9:5" />他們就在一月十四日，黃昏的時候，在<char style="pn">西奈</char>曠野守逾越節。耶和華所指示<char style="pn">摩西</char>的一切，<char style="pn">以色列</char>子民都照著做了。<verse eid="NUM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6" />但有一些人因接觸人的屍體而不潔淨了，不能在那一天守逾越節，所以當天來到<char style="pn">摩西</char>和<char style="pn">亞倫</char>面前。 <verse eid="NUM 9:6" /><verse number="7" style="v" sid="NUM 9:7" />那些人對<char style="pn">摩西</char>說：「我們確實因接觸人的屍體而不潔淨，但為什麼被限制，不能在這節期與<char style="pn">以色列</char>子民一起獻上耶和華的祭物呢？」<verse eid="NUM 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8" />
    <char style="pn">摩西</char>回答他們：「你們在這裡等候，我要聆聽耶和華對你們有什麼指示。」<verse eid="NUM 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9" />隨後耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 9:9" /><verse number="10" style="v" sid="NUM 9:10" />「你要吩咐<char style="pn">以色列</char>子民：無論是你們還是你們的後代，如果有人因接觸屍體而不潔淨了，或者在遠方旅行，他還是可以向耶和華守逾越節。 <verse eid="NUM 9:10" /><verse number="11" style="v" sid="NUM 9:11" />他們要在下一個月的十四日，黃昏的時候守這節。羔羊的肉要與無酵餅和苦菜一起吃， <verse eid="NUM 9:11" /><verse number="12" style="v" sid="NUM 9:12" />一點也不可留到早晨，羔羊的骨頭一根也不可折斷；他們要照著逾越節的所有律例守這節。<verse eid="NUM 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 9:13" />「但那潔淨的、當時也不在旅行的人，如果沒有守逾越節，那人就要從民中被剪除。那人沒有在這節期獻上耶和華的祭物，所以要承擔自己的罪過。<verse eid="NUM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14" />「如果寄居在你們中間的外人，也想守耶和華的逾越節，他就要照著逾越節的律例和法規去做。無論是對外人還是對本族人<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">本族人——原文直譯「本地人」。</char></note>，你們要有同一個律例。」<verse eid="NUM 9:14" /></para>
  <para style="s">雲柱引領</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15" />在立起帳幕那一天，有雲彩遮蓋帳幕，就是見證會幕；到了晚上，雲彩停留在帳幕上方，像火的形狀，直到清晨。 <verse eid="NUM 9:15" /><verse number="16" style="v" sid="NUM 9:16" />此後一直如此，白天有雲彩遮蓋帳幕，夜間有火的形狀。 <verse eid="NUM 9:16" /><verse number="17" style="v" sid="NUM 9:17" />每當雲彩從會幕上方收上去，隨後<char style="pn">以色列</char>子民就起行；雲彩在哪個地方停留，<char style="pn">以色列</char>子民就在哪裡紮營。 <verse eid="NUM 9:17" /><verse number="18" style="v" sid="NUM 9:18" /><char style="pn">以色列</char>子民照著耶和華的指示起行，也照著耶和華的指示紮營；雲彩在帳幕上方停留多久，他們就紮營多久。 <verse eid="NUM 9:18" /><verse number="19" style="v" sid="NUM 9:19" />即使雲彩停留在帳幕上方許多天，<char style="pn">以色列</char>子民也謹守耶和華的吩咐不起行。 <verse eid="NUM 9:19" /><verse number="20" style="v" sid="NUM 9:20" />有時雲彩只停留在帳幕上方幾天，他們就照著耶和華的指示紮營，然後照著耶和華的指示起行。 <verse eid="NUM 9:20" /><verse number="21" style="v" sid="NUM 9:21" />有時雲彩從晚上停留到早晨，當雲彩在早晨收上去的時候，他們就起行。無論是白天還是夜間，只要雲彩收上去，他們就起行。 <verse eid="NUM 9:21" /><verse number="22" style="v" sid="NUM 9:22" />無論是兩天，還是一個月，或是一年<note caller="+" style="f"><char style="fr" closed="false">9:22 </char><char style="ft" closed="false">一年——或譯作「許多日子」。</char></note>，只要雲彩停留在帳幕上方，在那裡停住，<char style="pn">以色列</char>子民就紮營不起行；當雲彩收上去的時候，他們才起行。<verse eid="NUM 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 9:23" />他們按照耶和華的指示紮營，也按照耶和華的指示起行。他們遵照耶和華藉著<char style="pn">摩西</char>所指示的，謹守耶和華的吩咐。<verse eid="NUM 9:23" /></para>
  <chapter eid="NUM 9" />
  <chapter number="10" style="c" sid="NUM 10" />
  <para style="s">兩支銀號筒</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 10:1" /><verse number="2" style="v" sid="NUM 10:2" />「你要製作兩支銀號筒，用錘擛工藝製作，用來聚集會眾，也用來拔營起行。 <verse eid="NUM 10:2" /><verse number="3" style="v" sid="NUM 10:3" />當兩支號筒吹響時，全體會眾要到你那裡，在會幕入口集合； <verse eid="NUM 10:3" /><verse number="4" style="v" sid="NUM 10:4" />如果只吹響一支，領袖們，就是<char style="pn">以色列</char>千軍的首領，要到你那裡集合。<verse eid="NUM 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 10:5" />「當你們吹響警號時，紮營在東面的營隊要起行。 <verse eid="NUM 10:5" /><verse number="6" style="v" sid="NUM 10:6" />當你們第二次吹響警號時，紮營在南面的營隊要起行。讓會眾起程時，要吹響警號， <verse eid="NUM 10:6" /><verse number="7" style="v" sid="NUM 10:7" />招聚會眾時也要吹號，但不要吹警號。 <verse eid="NUM 10:7" /><verse number="8" style="v" sid="NUM 10:8" />那些作祭司的<char style="pn">亞倫</char>子孫要吹響號筒。這要作為你們世世代代永遠的律例。<verse eid="NUM 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 10:9" />「當你們在自己的土地上，與擾害你們的敵人作戰時，你們要用號筒吹警號。這樣，你們就能在你們的神耶和華面前蒙記念，得拯救，脫離你們的仇敵。 <verse eid="NUM 10:9" /><verse number="10" style="v" sid="NUM 10:10" />在你們喜樂的日子和所定的節期，以及月初，你們要為你們的燔祭和平安祭吹響號筒。這樣，它們就使你們在你們的神面前蒙記念。我是耶和華你們的神。」<verse eid="NUM 10:10" /></para>
  <para style="s">從西奈曠野到帕蘭曠野</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11" />到了第二年的二月二十日，雲彩從見證帳幕上方收上去了； <verse eid="NUM 10:11" /><verse number="12" style="v" sid="NUM 10:12" /><char style="pn">以色列</char>子民從<char style="pn">西奈</char>曠野起行，一程一程地前行，雲彩到<char style="pn">帕蘭</char>曠野就停住了。 <verse eid="NUM 10:12" /><verse number="13" style="v" sid="NUM 10:13" />這是他們第一次按照耶和華藉著<char style="pn">摩西</char>所指示的起行。<verse eid="NUM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14" />首先按隊伍起行的，是<char style="pn">猶大</char>子孫營隊的旗幟。統領<char style="pn">猶大</char>隊伍的，是<char style="pn">亞米拿達</char>的兒子<char style="pn">拿順</char>； <verse eid="NUM 10:14" /><verse number="15" style="v" sid="NUM 10:15" />統領<char style="pn">以薩迦</char>支派隊伍的，是<char style="pn">蘇押</char>的兒子<char style="pn">拿旦業</char>。 <verse eid="NUM 10:15" /><verse number="16" style="v" sid="NUM 10:16" />統領<char style="pn">西布倫</char>支派隊伍的，是<char style="pn">希倫</char>的兒子<char style="pn">以利押</char>。 <verse eid="NUM 10:16" /><verse number="17" style="v" sid="NUM 10:17" />然後，帳幕被拆下來，<char style="pn">革順</char>的子孫和<char style="pn">米拉利</char>的子孫抬著帳幕起行。<verse eid="NUM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18" />接著按隊伍起行的，是<char style="pn">魯本</char>營隊的旗幟。統領<char style="pn">魯本</char>隊伍的，是<char style="pn">謝德珥</char>的兒子<char style="pn">以利佐</char>； <verse eid="NUM 10:18" /><verse number="19" style="v" sid="NUM 10:19" />統領<char style="pn">西緬</char>支派隊伍的，是<char style="pn">蘇利沙代</char>的兒子<char style="pn">謝路米業</char>； <verse eid="NUM 10:19" /><verse number="20" style="v" sid="NUM 10:20" />統領<char style="pn">迦得</char>支派隊伍的，是<char style="pn">德珥</char>的兒子<char style="pn">以利雅薩</char>。 <verse eid="NUM 10:20" /><verse number="21" style="v" sid="NUM 10:21" />然後，<char style="pn">哥轄</char>人抬著聖物起行，帳幕要在他們到達之前立起來。<verse eid="NUM 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22" />接著按隊伍起行的，是<char style="pn">以法蓮</char>子孫營隊的旗幟。統領<char style="pn">以法蓮</char>隊伍的，是<char style="pn">亞米忽</char>的兒子<char style="pn">以利沙瑪</char>； <verse eid="NUM 10:22" /><verse number="23" style="v" sid="NUM 10:23" />統領<char style="pn">瑪拿西</char>支派隊伍的，是<char style="pn">佩達佐</char>的兒子<char style="pn">迦瑪列</char>； <verse eid="NUM 10:23" /><verse number="24" style="v" sid="NUM 10:24" />統領<char style="pn">便雅憫</char>支派隊伍的，是<char style="pn">基多尼</char>的兒子<char style="pn">亞比但</char>。<verse eid="NUM 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25" />最後按隊伍起行的，是<char style="pn">但</char>子孫營隊的旗幟，他們作全營的後衛隊。統領他們隊伍的，是<char style="pn">亞米沙代</char>的兒子<char style="pn">亞希以謝</char>； <verse eid="NUM 10:25" /><verse number="26" style="v" sid="NUM 10:26" />統領<char style="pn">亞設</char>支派隊伍的，是<char style="pn">俄蘭</char>的兒子<char style="pn">帕結</char>； <verse eid="NUM 10:26" /><verse number="27" style="v" sid="NUM 10:27" />統領<char style="pn">拿弗他利</char>支派隊伍的，是<char style="pn">恩南</char>的兒子<char style="pn">亞希拉</char>。 <verse eid="NUM 10:27" /><verse number="28" style="v" sid="NUM 10:28" />以上是<char style="pn">以色列</char>子孫按著隊伍的起程次序，他們就這樣起行。<verse eid="NUM 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29" />那時，<char style="pn">摩西</char>對他岳父<char style="pn">米甸</char>人<char style="pn">流珥</char>的兒子<char style="pn">何巴</char>說：「我們要起行，去耶和華所說『我要將它賜給你們』的那個地方，請你與我們一起去，我們會厚待你，耶和華已經向<char style="pn">以色列</char>應許了福份。」<verse eid="NUM 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30" />
    <char style="pn">何巴</char>回答說：「我不去，我寧願回我本地本族去。」<verse eid="NUM 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31" />
    <char style="pn">摩西</char>說：「請不要離開我們，因為你了解曠野紮營的地方，可以作我們的嚮導<note caller="+" style="f"><char style="fr" closed="false">10:31 </char><char style="ft" closed="false">嚮導——原文直譯「眼睛」。</char></note>； <verse eid="NUM 10:31" /><verse number="32" style="v" sid="NUM 10:32" />而且如果你與我們一起去，將來耶和華賜下福份，使我們蒙福，我們也必使你一同蒙福。」<verse eid="NUM 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33" />於是，他們離開耶和華的山，前行了三天的路程。這三天的路程中，耶和華的約櫃一直在他們前頭前行，為他們尋找安歇的地方。 <verse eid="NUM 10:33" /><verse number="34" style="v" sid="NUM 10:34" />他們從營地起行，白天總有耶和華的雲彩在他們上方。<verse eid="NUM 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 10:35" />每當約櫃起行時，<char style="pn">摩西</char>就說：</para>
  <para style="q1" vid="NUM 10:35">「耶和華啊，求你起來！</para>
  <para style="q1" vid="NUM 10:35">願你的仇敵四散，</para>
  <para style="q1" vid="NUM 10:35">願那些恨你的人從你面前奔逃！」<verse eid="NUM 10:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="NUM 10:36" />每當約櫃停下來，他就說：</para>
  <para style="q1" vid="NUM 10:36">「耶和華啊，</para>
  <para style="q1" vid="NUM 10:36">求你回到千千萬萬<char style="pn">以色列</char>人當中<note caller="+" style="f"><char style="fr" closed="false">10:36 </char><char style="ft" closed="false">耶和華啊，求你回到千千萬萬以色列人當中——或譯作「耶和華，以色列的萬軍啊，求你回來」。</char></note>！」<verse eid="NUM 10:36" /></para>
  <chapter eid="NUM 10" />
  <chapter number="11" style="c" sid="NUM 11" />
  <para style="s">民眾發怨言</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1" />當時，民眾發怨言，惡言上達耶和華耳中。耶和華聽見了就怒氣發作，耶和華的火在他們中間焚燒，吞噬了營地的邊緣。 <verse eid="NUM 11:1" /><verse number="2" style="v" sid="NUM 11:2" />民眾向<char style="pn">摩西</char>哀求，<char style="pn">摩西</char>向耶和華禱告，火就熄滅了。 <verse eid="NUM 11:2" /><verse number="3" style="v" sid="NUM 11:3" />於是那地方被起名為「<char style="pn">塔備拉</char>」，因為耶和華的火曾在他們中間焚燒。<verse eid="NUM 11:3" /></para>
  <para style="s">抱怨飲食</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4" />他們當中一些閒雜人貪圖口腹之欲，以致<char style="pn">以色列</char>子民也再次哭泣，說：「誰給我們肉吃呢？ <verse eid="NUM 11:4" /><verse number="5" style="v" sid="NUM 11:5" />真想念在<char style="pn">埃及</char>能隨意吃的魚、黃瓜、西瓜、韭菜、蔥和蒜。 <verse eid="NUM 11:5" /><verse number="6" style="v" sid="NUM 11:6" />現在我們什麼胃口都沒有了！我們眼前除了嗎哪以外，什麼都沒有。」<verse eid="NUM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7" />嗎哪彷彿芫荽的種子，外觀如同珍珠<note caller="+" style="f"><char style="fr" closed="false">11:7 </char><char style="ft" closed="false">珍珠——或譯作「紅玉」或「稀罕的香料」。</char></note>。 <verse eid="NUM 11:7" /><verse number="8" style="v" sid="NUM 11:8" />民眾四處走動，撿拾嗎哪，用磨碾碎或用臼搗碎，然後用鍋煮了，做成餅，味道就像是純橄欖油的味道。 <verse eid="NUM 11:8" /><verse number="9" style="v" sid="NUM 11:9" />夜間露水降在營地上的時候，嗎哪也與它一起降下。<verse eid="NUM 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10" />
    <char style="pn">摩西</char>聽見了百姓家家戶戶在帳篷門口哭，那時耶和華的怒氣大大發作，<char style="pn">摩西</char>也感到悲苦。 <verse eid="NUM 11:10" /><verse number="11" style="v" sid="NUM 11:11" /><char style="pn">摩西</char>對耶和華說：「你為什麼惡待你的僕人呢？為什麼我不在你眼前蒙恩，以致你把這全體民眾的重擔放在我身上呢？ <verse eid="NUM 11:11" /><verse number="12" style="v" sid="NUM 11:12" />是我懷上了這全體民眾嗎？是我生下了他們嗎？你竟然吩咐我把他們抱在懷中，像保姆抱吃奶的嬰兒那樣，帶到你起誓要賜給他們先祖的地方。 <verse eid="NUM 11:12" /><verse number="13" style="v" sid="NUM 11:13" />我從哪裡得肉給這全體民眾呢？他們竟然對我哭著說：『給我們肉吃！』 <verse eid="NUM 11:13" /><verse number="14" style="v" sid="NUM 11:14" />我不能夠獨自背負這全體民眾，這對我實在太沉重了。 <verse eid="NUM 11:14" /><verse number="15" style="v" sid="NUM 11:15" />如果你要這樣對待我，求你現在就殺了我；如果我在你眼前蒙恩，請不要讓我看到自己的悲苦。」<verse eid="NUM 11:15" /></para>
  <para style="s">揀選七十位長老</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16" />耶和華就對<char style="pn">摩西</char>說：「你要從<char style="pn">以色列</char>的長老中為我招聚七十個人，就是你所知道的那些民間長老和官長；要把他們帶到會幕，與你一同站在那裡。 <verse eid="NUM 11:16" /><verse number="17" style="v" sid="NUM 11:17" />我要降臨，在那裡與你說話，並且把你身上的靈分出一些，賜給他們。這樣，他們就與你一同背負這民眾的重擔，免得你獨自背負。<verse eid="NUM 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18" />「你要對民眾說：你們要為明天把自己分別為聖，你們將會有肉吃。因為你們在耶和華耳中哭著說：『誰給我們肉吃呢？我們在<char style="pn">埃及</char>多好！』所以，耶和華就要給你們肉吃了。 <verse eid="NUM 11:18" /><verse number="19" style="v" sid="NUM 11:19" />你們不是吃一天兩天，也不是五天十天，也不是二十天， <verse eid="NUM 11:19" /><verse number="20" style="v" sid="NUM 11:20" />而是整整一個月，直到肉從你們鼻孔裡出來，讓你們惡心<note caller="+" style="f"><char style="fr" closed="false">11:20 </char><char style="ft" closed="false">讓你們惡心——或譯作「使你們厭惡它」。</char></note>。因為你們厭棄在你們中間的耶和華，在他面前哭著說：『我們為什麼從<char style="pn">埃及</char>出來呢？』」<verse eid="NUM 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21" />
    <char style="pn">摩西</char>說：「與我一起的民眾，步行的男人<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">男人——輔助詞語；參《出埃及記》12:37。</char></note>有六十萬，你竟然說要給他們肉吃，吃一整個月？ <verse eid="NUM 11:21" /><verse number="22" style="v" sid="NUM 11:22" />難道把羊群和牛群都給他們宰殺了，就夠他們吃嗎？或者把海裡所有的魚都給他們聚攏起來，就夠他們吃嗎？」<verse eid="NUM 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23" />耶和華對<char style="pn">摩西</char>說：「難道耶和華的手臂縮短了嗎？現在你就要看到我的話是否向你應驗。」<verse eid="NUM 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24" />於是<char style="pn">摩西</char>出去，將耶和華的話告訴民眾，並從民間的長老中招聚了七十個人，讓他們站在會幕周圍。 <verse eid="NUM 11:24" /><verse number="25" style="v" sid="NUM 11:25" />耶和華在雲彩中降臨，對<char style="pn">摩西</char>說話，並把他身上的靈分出一些，賜給七十個長老。當那靈停留在他們身上時，他們就說神言；他們以後再沒有說過。 <verse eid="NUM 11:25" /><verse number="26" style="v" sid="NUM 11:26" />但有兩個人留在營中，一個名叫<char style="pn">伊利達</char>，另一個名叫<char style="pn">米達</char>，那靈也停留在他們身上，他們就在營中說神言；他們也在入選名單中，卻沒有出去到會幕那裡。 <verse eid="NUM 11:26" /><verse number="27" style="v" sid="NUM 11:27" />有個年輕人跑來報告<char style="pn">摩西</char>說：「<char style="pn">伊利達</char>和<char style="pn">米達</char>正在營中說神言。」<verse eid="NUM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 11:28" />
    <char style="pn">嫩</char>的兒子<char style="pn">約書亞</char>——他從年輕時就作<char style="pn">摩西</char>的助手<note caller="+" style="f"><char style="fr" closed="false">11:28 </char><char style="ft" closed="false">助手——或譯作「侍從」。</char></note>，他回應說：「我主<char style="pn">摩西</char>啊，請阻止他們。」<verse eid="NUM 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29" />
    <char style="pn">摩西</char>對他說：「你為我的緣故起了嫉妒嗎？但願耶和華所有的子民都是先知，願耶和華把他的靈賜給他們！」 <verse eid="NUM 11:29" /><verse number="30" style="v" sid="NUM 11:30" />之後，<char style="pn">摩西</char>和<char style="pn">以色列</char>的眾長老回到了營地。<verse eid="NUM 11:30" /></para>
  <para style="s">颳來鵪鶉</para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31" />有風從耶和華那裡颳起，從海上颳來鵪鶉，散落在營地，覆蓋營地四圍，一邊約有一天的路程遠，另一邊也約有一天的路程遠，在地面上高約有兩肘<note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="ft" closed="false">兩肘——相當於91.4公分。1肘=45.7公分。</char></note>。 <verse eid="NUM 11:31" /><verse number="32" style="v" sid="NUM 11:32" />民眾就起來，那一天的整天整夜，以及第二天的整天，他們都在收取鵪鶉，最少的也收取了十賀梅珥<note caller="+" style="f"><char style="fr" closed="false">11:32 </char><char style="ft" closed="false">十賀梅珥——相當於2,200公升。1賀梅珥=220公升。</char></note>，滿滿攤放在營地的四圍。<verse eid="NUM 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 11:33" />然而，那肉還在他們的口齒間沒有被嚼爛，耶和華的怒氣就向民眾發作了，耶和華用極重的災害打擊民眾。 <verse eid="NUM 11:33" /><verse number="34" style="v" sid="NUM 11:34" />那地方就被起名為「<char style="pn">基布羅-哈特瓦</char>」，因為在那裡埋葬了那些起貪慾的民眾。<verse eid="NUM 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35" />民眾從<char style="pn">基布羅-哈特瓦</char>前行到<char style="pn">哈洗錄</char>，就停留在<char style="pn">哈洗錄</char>。<verse eid="NUM 11:35" /></para>
  <chapter eid="NUM 11" />
  <chapter number="12" style="c" sid="NUM 12" />
  <para style="s">米利暗和亞倫毀謗摩西</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1" />
    <char style="pn">米利暗</char>和<char style="pn">亞倫</char>因<char style="pn">摩西</char>娶的是<char style="pn">庫實</char>女人，就攻擊<char style="pn">摩西</char>說：「他娶了一個<char style="pn">庫實</char>女人！」 <verse eid="NUM 12:1" /><verse number="2" style="v" sid="NUM 12:2" />還說：「難道耶和華僅僅藉著<char style="pn">摩西</char>說話嗎？他不也藉著我們說話嗎？」耶和華聽見了這些。<verse eid="NUM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 12:3" />
    <char style="pn">摩西</char>為人極其謙卑，超過世上所有的人。 <verse eid="NUM 12:3" /><verse number="4" style="v" sid="NUM 12:4" />那時，耶和華突然對<char style="pn">摩西</char>、<char style="pn">亞倫</char>和<char style="pn">米利暗</char>說：「你們三個人出來，到會幕那裡！」他們三個人就出來。 <verse eid="NUM 12:4" /><verse number="5" style="v" sid="NUM 12:5" />耶和華在雲柱中降臨，停留在會幕入口呼喚<char style="pn">亞倫</char>和<char style="pn">米利暗</char>，他們兩個人就上前來。 <verse eid="NUM 12:5" /><verse number="6" style="v" sid="NUM 12:6" />耶和華說：</para>
  <para style="q1" vid="NUM 12:6">「你們聽我說：</para>
  <para style="q1" vid="NUM 12:6">如果你們當中有先知，</para>
  <para style="q1" vid="NUM 12:6">我耶和華是在異象中向他顯現，</para>
  <para style="q1" vid="NUM 12:6">在夢中與他說話。<verse eid="NUM 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 12:7" />但我的僕人<char style="pn">摩西</char>不一樣，</para>
  <para style="q1" vid="NUM 12:7">他在我全家是忠誠的，<verse eid="NUM 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 12:8" />我是與他面對面說話，</para>
  <para style="q1" vid="NUM 12:8">清清楚楚，並不用謎語；</para>
  <para style="q1" vid="NUM 12:8">他可以看見耶和華的形象。</para>
  <para style="q1" vid="NUM 12:8">你們為什麼毀謗我的僕人<char style="pn">摩西</char>而不害怕呢？」<verse eid="NUM 12:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9" />耶和華對他們怒氣發作，然後離開了。<verse eid="NUM 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 12:10" />雲彩從會幕上方收回了，看哪，<char style="pn">米利暗</char>患了痲瘋病，像雪一樣。<char style="pn">亞倫</char>轉向<char style="pn">米利暗</char>，看見她患了痲瘋病。 <verse eid="NUM 12:10" /><verse number="11" style="v" sid="NUM 12:11" /><char style="pn">亞倫</char>就對<char style="pn">摩西</char>說：「哦，我主啊，請不要追究我們在愚昧中所犯的罪。 <verse eid="NUM 12:11" /><verse number="12" style="v" sid="NUM 12:12" />請不要讓她像那出母腹時肉已經腐爛一半的死胎那樣。」<verse eid="NUM 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13" />
    <char style="pn">摩西</char>向耶和華呼求說：「神哪，求求你！求你醫治她！」<verse eid="NUM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14" />耶和華對<char style="pn">摩西</char>說：「如果她父親吐唾沫在她臉上，難道她不會蒙羞七天嗎？你要把她隔離在營地外七天，之後帶回來。」 <verse eid="NUM 12:14" /><verse number="15" style="v" sid="NUM 12:15" />於是<char style="pn">米利暗</char>被隔離在營地外七天；民眾沒有前行，直到<char style="pn">米利暗</char>被帶回來。 <verse eid="NUM 12:15" /><verse number="16" style="v" sid="NUM 12:16" />之後民眾從<char style="pn">哈洗錄</char>起行，在<char style="pn">帕蘭</char>曠野紮營。<verse eid="NUM 12:16" /></para>
  <chapter eid="NUM 12" />
  <chapter number="13" style="c" sid="NUM 13" />
  <para style="s">探察迦南地</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 13:1" /><verse number="2" style="v" sid="NUM 13:2" />「你要派人去探察我賜給<char style="pn">以色列</char>子孫的<char style="pn">迦南</char>地，按父系支派，每支派差遣一人，都是他們當中的首領。」 <verse eid="NUM 13:2" /><verse number="3" style="v" sid="NUM 13:3" /><char style="pn">摩西</char>就按照耶和華的指示，從<char style="pn">帕蘭</char>曠野派出他們，全都是作<char style="pn">以色列</char>子民首領的人。 <verse eid="NUM 13:3" /><verse number="4" style="v" sid="NUM 13:4" />以下是他們的名字：</para>
  <para style="q1" vid="NUM 13:4">屬<char style="pn">魯本</char>支派的，是<char style="pn">扎克爾</char>的兒子<char style="pn">沙慕亞</char>；<verse eid="NUM 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 13:5" />屬<char style="pn">西緬</char>支派的，是<char style="pn">何利</char>的兒子<char style="pn">沙法</char>；<verse eid="NUM 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 13:6" />屬<char style="pn">猶大</char>支派的，是<char style="pn">耶弗尼</char>的兒子<char style="pn">迦勒</char>；<verse eid="NUM 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 13:7" />屬<char style="pn">以薩迦</char>支派的，是<char style="pn">約瑟</char>的兒子<char style="pn">以甲</char>；<verse eid="NUM 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 13:8" />屬<char style="pn">以法蓮</char>支派的，是<char style="pn">嫩</char>的兒子<char style="pn">何西阿</char>；<verse eid="NUM 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 13:9" />屬<char style="pn">便雅憫</char>支派的，是<char style="pn">拉弗</char>的兒子<char style="pn">帕爾提</char>；<verse eid="NUM 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 13:10" />屬<char style="pn">西布倫</char>支派的，是<char style="pn">索迪</char>的兒子<char style="pn">伽迪列</char>；<verse eid="NUM 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NUM 13:11" />屬<char style="pn">約瑟</char>支派，就是<char style="pn">瑪拿西</char>支派的，是<char style="pn">蘇希</char>的兒子<char style="pn">迦底</char>；<verse eid="NUM 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NUM 13:12" />屬<char style="pn">但</char>支派的，是<char style="pn">基瑪利</char>的兒子<char style="pn">亞米利</char>；<verse eid="NUM 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NUM 13:13" />屬<char style="pn">亞設</char>支派的，是<char style="pn">米迦勒</char>的兒子<char style="pn">西帖</char>；<verse eid="NUM 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NUM 13:14" />屬<char style="pn">拿弗他利</char>支派的，是<char style="pn">沃夫西</char>的兒子<char style="pn">拿比</char>；<verse eid="NUM 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NUM 13:15" />屬<char style="pn">迦得</char>支派的，是<char style="pn">瑪基</char>的兒子<char style="pn">格烏列</char>。<verse eid="NUM 13:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="NUM 13:16" />以上就是<char style="pn">摩西</char>派去探察那地的人的名字；<char style="pn">摩西</char>稱<char style="pn">嫩</char>的兒子<char style="pn">何西阿</char>為<char style="pn">約書亞</char>。<verse eid="NUM 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17" />
    <char style="pn">摩西</char>派他們去探察<char style="pn">迦南</char>地，對他們說：「你們前往南地<note caller="+" style="f"><char style="fr" closed="false">13:17 </char><char style="ft" closed="false">南地——音譯作「內蓋夫」；本章下同。</char></note>那裡，然後上到山地去。 <verse eid="NUM 13:17" /><verse number="18" style="v" sid="NUM 13:18" />你們要察看那地是怎樣的：住在那裡的民是強是弱、是少是多， <verse eid="NUM 13:18" /><verse number="19" style="v" sid="NUM 13:19" />他們所住的地方是好是壞，他們所住的城是營地是堡壘， <verse eid="NUM 13:19" /><verse number="20" style="v" sid="NUM 13:20" />那地是肥沃還是貧瘠，那裡有樹木沒有。你們要盡力帶一些當地的果實回來。」那時正是葡萄初熟的季節。<verse eid="NUM 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21" />於是他們上去探察那地，從<char style="pn">尋</char>的曠野直到<char style="pn">哈馬</char>隘口那裡的<char style="pn">利合</char>。 <verse eid="NUM 13:21" /><verse number="22" style="v" sid="NUM 13:22" />他們上到南地，來到<char style="pn">希伯崙</char>；那裡有<char style="pn">亞衲</char>人的後裔<char style="pn">亞希幔</char>、<char style="pn">示篩</char>和<char style="pn">塔爾邁</char>，<char style="pn">希伯崙</char>比<char style="pn">埃及</char>的<char style="pn">瑣安</char>早建造七年。 <verse eid="NUM 13:22" /><verse number="23" style="v" sid="NUM 13:23" />他們來到<char style="pn">以實格</char>溪谷，從那裡砍下一根葡萄枝，上面帶著一掛葡萄，由兩個人用杠子抬著，還帶了一些石榴和無花果。 <verse eid="NUM 13:23" /><verse number="24" style="v" sid="NUM 13:24" /><char style="pn">以色列</char>人給那地方起名為「<char style="pn">以實格</char>溪谷」，因為他們從那裡砍下了一掛葡萄。 <verse eid="NUM 13:24" /><verse number="25" style="v" sid="NUM 13:25" />四十天後，他們探察完那地回來了。<verse eid="NUM 13:25" /></para>
  <para style="s">報告迦南地的情況</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 13:26" />他們回到<char style="pn">帕蘭</char>曠野的<char style="pn">加低斯</char>，來到<char style="pn">摩西</char>和<char style="pn">亞倫</char>以及全體<char style="pn">以色列</char>會眾那裡，向他們和全體會眾報告，又給他們看那地的果實。 <verse eid="NUM 13:26" /><verse number="27" style="v" sid="NUM 13:27" />他們向<char style="pn">摩西</char>講述，說：「我們到了你派我們去的那地，果然是流奶與蜜之地，這就是那裡的果實。 <verse eid="NUM 13:27" /><verse number="28" style="v" sid="NUM 13:28" />不過住在那地的民強悍，城市極其堅固高大，我們在那裡還看見了<char style="pn">亞衲</char>人的後裔。 <verse eid="NUM 13:28" /><verse number="29" style="v" sid="NUM 13:29" /><char style="pn">亞瑪力</char>人住在南地，<char style="pn">赫提</char>人、<char style="pn">耶布斯</char>人和<char style="pn">亞摩利</char>人住在山地，<char style="pn">迦南</char>人住在海邊和<char style="pn">約旦</char>河沿岸。」<verse eid="NUM 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30" />
    <char style="pn">迦勒</char>讓民眾在<char style="pn">摩西</char>面前安靜下來，說：「我們儘管上去，占有那地！我們一定能征服它。」<verse eid="NUM 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31" />但那些與他一起上去探察<note caller="+" style="f"><char style="fr" closed="false">13:31 </char><char style="ft" closed="false">探察——輔助詞語。</char></note>的人說：「我們不能上去攻打那民，他們實在比我們強大。」 <verse eid="NUM 13:31" /><verse number="32" style="v" sid="NUM 13:32" />那些人還向<char style="pn">以色列</char>子民散布有關所探察之地的謠言，說：「我們過去探察的那地，是吞沒居民之地，而且我們在那裡看見的民都是身材高大的人。 <verse eid="NUM 13:32" /><verse number="33" style="v" sid="NUM 13:33" />我們在那裡也看見了巨人<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">巨人——或譯作「偉人」。</char></note>，就是巨人的後裔<char style="pn">亞衲</char>子孫。在我們眼中，我們就像是蚱蜢；在他們眼中，我們也是如此。」<verse eid="NUM 13:33" /></para>
  <chapter eid="NUM 13" />
  <chapter number="14" style="c" sid="NUM 14" />
  <para style="s">以色列人拒絕進迦南地</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1" />全體會眾就起來，大聲喧嚷，那天夜裡，民眾都哭泣。 <verse eid="NUM 14:1" /><verse number="2" style="v" sid="NUM 14:2" /><char style="pn">以色列</char>子民都向<char style="pn">摩西</char>和<char style="pn">亞倫</char>發怨言，全體會眾對他們說：「我們還不如死在<char style="pn">埃及</char>地，或者死在這曠野！ <verse eid="NUM 14:2" /><verse number="3" style="v" sid="NUM 14:3" />耶和華為什麼要把我們領到這地，使我們倒在刀下呢？我們的妻子和孩童要成為掠物了！我們回<char style="pn">埃及</char>不是更好嗎？」 <verse eid="NUM 14:3" /><verse number="4" style="v" sid="NUM 14:4" />他們又彼此說：「讓我們立一個首領，回<char style="pn">埃及</char>去吧！」<verse eid="NUM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5" />
    <char style="pn">摩西</char>和<char style="pn">亞倫</char>就在<char style="pn">以色列</char>子孫全體會眾面前臉伏於地。 <verse eid="NUM 14:5" /><verse number="6" style="v" sid="NUM 14:6" />那時，探察那地的人當中，<char style="pn">嫩</char>的兒子<char style="pn">約書亞</char>和<char style="pn">耶弗尼</char>的兒子<char style="pn">迦勒</char>撕裂衣服， <verse eid="NUM 14:6" /><verse number="7" style="v" sid="NUM 14:7" />對全體<char style="pn">以色列</char>會眾說：「我們過去探察的那地，是極其美好的地方。 <verse eid="NUM 14:7" /><verse number="8" style="v" sid="NUM 14:8" />如果耶和華喜悅我們，他必把我們帶進那地，把那流奶與蜜之地賜給我們； <verse eid="NUM 14:8" /><verse number="9" style="v" sid="NUM 14:9" />至於你們，不要背叛耶和華！不要怕那地的民，他們是我們的獵物；他們的保障已經離開他們了，但耶和華與我們同在。你們不要怕他們！」<verse eid="NUM 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10" />但全體會眾說要用石頭砸死這二人。這時，耶和華的榮耀在會幕中向全體<char style="pn">以色列</char>子民顯現。<verse eid="NUM 14:10" /></para>
  <para style="s">以色列子民受審判</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 14:11" />耶和華對<char style="pn">摩西</char>說：「這子民藐視我，要到什麼時候呢？我在他們當中行了這一切神蹟，他們還不相信我，要到什麼時候呢？ <verse eid="NUM 14:11" /><verse number="12" style="v" sid="NUM 14:12" />我要用瘟疫打擊他們，不讓他們繼承那地，卻使你成為一個比他們強大的民族。」<verse eid="NUM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13" />但<char style="pn">摩西</char>對耶和華說：「<char style="pn">埃及</char>人必聽見這事。要知道，你用你的大能將這子民從他們當中帶上來， <verse eid="NUM 14:13" /><verse number="14" style="v" sid="NUM 14:14" />他們會告訴這地的居民；這些居民也聽說了：你耶和華與這子民同在，你耶和華曾被人親眼看見，你的雲彩停留在子民上面，你白天在雲柱中、黑夜在火柱中，行走在他們前頭。 <verse eid="NUM 14:14" /><verse number="15" style="v" sid="NUM 14:15" />你如果把這子民全都<note caller="+" style="f"><char style="fr" closed="false">14:15 </char><char style="ft" closed="false">全都——原文直譯「如同一人」。</char></note>殺掉，那些聽過你名聲的民族就會議論說： <verse eid="NUM 14:15" /><verse number="16" style="v" sid="NUM 14:16" />『耶和華因為不能領這子民進入他起誓要給他們的那地，所以在曠野把他們宰殺了。』<verse eid="NUM 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 14:17" />「現在，願我主彰顯大能！正如你曾宣告說： <verse eid="NUM 14:17" /><verse number="18" style="v" sid="NUM 14:18" />『耶和華不輕易發怒，並有豐盛的慈愛；他赦免罪孽和過犯，但絕不會讓有罪的免於罪責，而會追究罪責，從父親到兒子，直到第三代、第四代』， <verse eid="NUM 14:18" /><verse number="19" style="v" sid="NUM 14:19" />求你照著你的大慈愛赦免這子民的罪孽，就像從<char style="pn">埃及</char>到如今你一直赦免這子民一樣。」<verse eid="NUM 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20" />耶和華說：「我已經照你的祈求赦免了他們。 <verse eid="NUM 14:20" /><verse number="21" style="v" sid="NUM 14:21" />然而我指著我的永生起誓，指著那充滿全地的耶和華的榮耀起誓： <verse eid="NUM 14:21" /><verse number="22" style="v" sid="NUM 14:22" />雖然這些人全都看見過我的榮耀，以及我在<char style="pn">埃及</char>、在曠野所行的神蹟，他們卻試探了我這十次，並沒有聽從我的話， <verse eid="NUM 14:22" /><verse number="23" style="v" sid="NUM 14:23" />所以，他們絕不會見到我所起誓賜給他們先祖的那地，所有藐視我的人都不會見到。 <verse eid="NUM 14:23" /><verse number="24" style="v" sid="NUM 14:24" />但我的僕人<char style="pn">迦勒</char>，因他有與他們不同的靈<note caller="+" style="f"><char style="fr" closed="false">14:24 </char><char style="ft" closed="false">與他們不同的靈——或譯作「不同的心志」。</char></note>，全心跟從我，我要把他帶進他曾進去的那地，他的後裔也必繼承那地。 <verse eid="NUM 14:24" /><verse number="25" style="v" sid="NUM 14:25" /><char style="pn">亞瑪力</char>人和<char style="pn">迦南</char>人住在山間平地，明天你們要轉回，沿著通往<char style="pn">紅海</char>的路往曠野前行。」<verse eid="NUM 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26" />耶和華又指示<char style="pn">摩西</char>和<char style="pn">亞倫</char>說： <verse eid="NUM 14:26" /><verse number="27" style="v" sid="NUM 14:27" />「這邪惡的會眾，他們向我發怨言要到什麼時候呢？<char style="pn">以色列</char>子民向我所發的怨言，我都聽見了。 <verse eid="NUM 14:27" /><verse number="28" style="v" sid="NUM 14:28" />你要對他們說，這是耶和華的宣告：我指著我的永生起誓，我必定照著你們在我耳中所說的話對待你們。 <verse eid="NUM 14:28" /><verse number="29" style="v" sid="NUM 14:29" />你們這些被數點過的，就是二十歲以上所有在名單中的，都將橫尸在這曠野中，因為你們向我發怨言。 <verse eid="NUM 14:29" /><verse number="30" style="v" sid="NUM 14:30" />除了<char style="pn">耶弗尼</char>的兒子<char style="pn">迦勒</char>和<char style="pn">嫩</char>的兒子<char style="pn">約書亞</char>以外，你們絕不會進入我舉手起誓要讓你們安居其中的那地； <verse eid="NUM 14:30" /><verse number="31" style="v" sid="NUM 14:31" />但你們的孩童，就是你們說將成為掠物的，我要帶他們進去，他們將得見你們所厭棄的那地。 <verse eid="NUM 14:31" /><verse number="32" style="v" sid="NUM 14:32" />至於你們，你們將橫尸在這曠野中， <verse eid="NUM 14:32" /><verse number="33" style="v" sid="NUM 14:33" />你們的子孫將在曠野遊牧四十年，承擔你們不忠貞的罪，直到你們全都橫尸在曠野中。 <verse eid="NUM 14:33" /><verse number="34" style="v" sid="NUM 14:34" />按你們探察那地的天數，共四十天，一天算一年，你們要承擔你們的罪責四十年。這樣你們就知道敵對我的後果<note caller="+" style="f"><char style="fr" closed="false">14:34 </char><char style="ft" closed="false">敵對我的後果——或譯作「我疏遠你們了」。</char></note>。 <verse eid="NUM 14:34" /><verse number="35" style="v" sid="NUM 14:35" />我耶和華發了話，就必如此對待這一切聚集起來敵對我的邪惡會眾，他們必在這曠野中滅盡，死在這裡。」<verse eid="NUM 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36" />
    <char style="pn">摩西</char>派去探察那地的人回來後，散布有關那地的謠言，以致全體會眾向<char style="pn">摩西</char>發怨言， <verse eid="NUM 14:36" /><verse number="37" style="v" sid="NUM 14:37" />這些散布那地可怕謠言的人就遭受瘟疫，死在耶和華面前。 <verse eid="NUM 14:37" /><verse number="38" style="v" sid="NUM 14:38" />這些去探察那地的人當中，只有<char style="pn">嫩</char>的兒子<char style="pn">約書亞</char>和<char style="pn">耶弗尼</char>的兒子<char style="pn">迦勒</char>活了下來。<verse eid="NUM 14:38" /></para>
  <para style="s">以色列被擊潰</para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39" />
    <char style="pn">摩西</char>將這些話告訴了全體<char style="pn">以色列</char>子民，人們就極其悲慟。 <verse eid="NUM 14:39" /><verse number="40" style="v" sid="NUM 14:40" />他們清早起來，上到山地高處，說：「我們來了，我們要上耶和華應許的那地方去！我們實在犯了罪。」<verse eid="NUM 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41" />
    <char style="pn">摩西</char>說：「你們為什麼又要違背耶和華的吩咐呢？這不會成功的。 <verse eid="NUM 14:41" /><verse number="42" style="v" sid="NUM 14:42" />你們不要上去，以免敗在你們仇敵面前，因為耶和華不在你們當中。 <verse eid="NUM 14:42" /><verse number="43" style="v" sid="NUM 14:43" /><char style="pn">亞瑪力</char>人和<char style="pn">迦南</char>人就在那裡，在你們前頭，你們必倒在刀下。因為你們既然轉離不跟從耶和華，耶和華也必不與你們同在。」<verse eid="NUM 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44" />他們卻擅自上山地高處去，儘管耶和華的約櫃和<char style="pn">摩西</char>都沒有從營地中出來。 <verse eid="NUM 14:44" /><verse number="45" style="v" sid="NUM 14:45" />於是住在那山地的<char style="pn">亞瑪力</char>人和<char style="pn">迦南</char>人下來擊殺他們，擊潰他們，直到<char style="pn">霍爾瑪</char>。<verse eid="NUM 14:45" /></para>
  <chapter eid="NUM 14" />
  <chapter number="15" style="c" sid="NUM 15" />
  <para style="s">獻祭的條例</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 15:1" /><verse number="2" style="v" sid="NUM 15:2" />「你要吩咐<char style="pn">以色列</char>子民，對他們說：你們進入了我賜給你們的安居之地後， <verse eid="NUM 15:2" /><verse number="3" style="v" sid="NUM 15:3" />向耶和華獻上火祭時，無論是燔祭或是別的祭物，無論是為了還特殊的願，或是作甘心祭，或是作各節期的祭，都要從牛群或羊群中取來，燒獻為馨香之氣給耶和華。 <verse eid="NUM 15:3" /><verse number="4" style="v" sid="NUM 15:4" />那向耶和華獻上祭物的人，還要獻上十分之一伊法<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">十分之一伊法——相當於2.2公升。1伊法=22公升。</char></note>細麵粉為素祭，用四分之一欣<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">四分之一欣——相當於0.9公升。1欣=3.7公升。</char></note>油調和。 <verse eid="NUM 15:4" /><verse number="5" style="v" sid="NUM 15:5" />在燔祭或別的祭物之外，你還要為每隻綿羊羔預備四分之一欣的酒作酒祭。 <verse eid="NUM 15:5" /><verse number="6" style="v" sid="NUM 15:6" />或是為每隻公綿羊預備十分之二伊法<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">十分之二伊法——相當於4.4公升。1伊法=22公升。</char></note>細麵粉為素祭，用三分之一欣<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">三分之一欣——相當於1.2公升。1欣=3.7公升。</char></note>油調和； <verse eid="NUM 15:6" /><verse number="7" style="v" sid="NUM 15:7" />還要獻上三分之一欣的酒作酒祭，燒獻為馨香之氣給耶和華。<verse eid="NUM 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 15:8" />「當你預備一頭公牛作燔祭或別的祭物獻給耶和華，無論是為了還特殊的願或是作平安祭， <verse eid="NUM 15:8" /><verse number="9" style="v" sid="NUM 15:9" />都要與公牛一起獻上十分之三伊法<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">十分之三伊法——相當於6.6公升。1伊法=22公升。</char></note>細麵粉為素祭，用半欣<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">半欣——相當於1.9公升。1欣=3.7公升。</char></note>油調和。 <verse eid="NUM 15:9" /><verse number="10" style="v" sid="NUM 15:10" />還要獻上半欣的酒為酒祭，作為馨香的火祭獻給耶和華。 <verse eid="NUM 15:10" /><verse number="11" style="v" sid="NUM 15:11" />為每頭公牛、每隻公綿羊、每隻綿羊羔或山羊羔，都要這樣預備； <verse eid="NUM 15:11" /><verse number="12" style="v" sid="NUM 15:12" />無論為多少牛羊，都要照著牠們的數量，這樣為每一隻祭牲預備。<verse eid="NUM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 15:13" />「任何本族人<note caller="+" style="f"><char style="fr" closed="false">15:13 </char><char style="ft" closed="false">本族人——原文直譯「本地人」；本章下同。</char></note>向耶和華獻上馨香的火祭，都要這樣預備。 <verse eid="NUM 15:13" /><verse number="14" style="v" sid="NUM 15:14" />如果寄居在你們中間的外人，或世世代代在你們中間的外人，想要向耶和華獻上馨香的火祭，那麼，你們怎樣做，他也要怎樣做。 <verse eid="NUM 15:14" /><verse number="15" style="v" sid="NUM 15:15" />無論是對你們還是對寄居的外人，會眾要有同一個律例。這是你們世世代代永遠的律例。在耶和華面前，你們怎樣，外人也要怎樣。 <verse eid="NUM 15:15" /><verse number="16" style="v" sid="NUM 15:16" />你們和寄居在你們中間的外人，是同一個條例、同一個規定。」<verse eid="NUM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 15:17" /><verse number="18" style="v" sid="NUM 15:18" />「你要吩咐<char style="pn">以色列</char>子民，對他們說：當你們進入我要帶你們去的那地， <verse eid="NUM 15:18" /><verse number="19" style="v" sid="NUM 15:19" />享用那地的出產時，你們要奉上一份供物給耶和華。 <verse eid="NUM 15:19" /><verse number="20" style="v" sid="NUM 15:20" />你們要用初熟五穀的麵團做餅，作為供物奉上，就像打穀場的供物一樣把它奉上。 <verse eid="NUM 15:20" /><verse number="21" style="v" sid="NUM 15:21" />你們世世代代都要從你們初熟五穀的麵團中，把一份供物獻給耶和華。<verse eid="NUM 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22" />「如果你們無意中有了過失，沒有遵行耶和華吩咐<char style="pn">摩西</char>的這一切誡命， <verse eid="NUM 15:22" /><verse number="23" style="v" sid="NUM 15:23" />就是耶和華藉著<char style="pn">摩西</char>所指示你們的一切——從耶和華指示你們的那天起，之後世世代代， <verse eid="NUM 15:23" /><verse number="24" style="v" sid="NUM 15:24" />如果是會眾沒有察覺而無意中有了過失，全體會眾就要獻上一頭公牛為燔祭，作馨香之氣獻給耶和華，並按照規定獻上同獻的素祭和酒祭；還有一隻公山羊為贖罪祭。 <verse eid="NUM 15:24" /><verse number="25" style="v" sid="NUM 15:25" />祭司要為全體<char style="pn">以色列</char>會眾贖罪，他們就得赦免，因為這是無意的過失。他們要為自己無意的過失帶來祭物，就是獻給耶和華的火祭和贖罪祭，帶到耶和華面前。 <verse eid="NUM 15:25" /><verse number="26" style="v" sid="NUM 15:26" />全體<char style="pn">以色列</char>會眾和寄居在他們中間的外人，都必得赦免，因為這是全體民眾無意的過失。<verse eid="NUM 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27" />「如果是一個人無意中犯了罪，他就要獻上一隻一歲的母山羊作贖罪祭。 <verse eid="NUM 15:27" /><verse number="28" style="v" sid="NUM 15:28" />祭司要為那無意中過失犯罪的人贖罪；祭司在耶和華面前為他贖罪，他就必得赦免。 <verse eid="NUM 15:28" /><verse number="29" style="v" sid="NUM 15:29" />無論是<char style="pn">以色列</char>子孫中的本族人，還是寄居在他們中間的外人，你們無意中有過失的人都是同一個條例。<verse eid="NUM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30" />「但狂妄行事的人，無論是本族人或是外人，那人是在褻瀆耶和華，必須從民中被剪除。 <verse eid="NUM 15:30" /><verse number="31" style="v" sid="NUM 15:31" />那人既然藐視耶和華的話語，違背他的誡命，就必須被剪除，他的罪責要歸在自己身上。」<verse eid="NUM 15:31" /></para>
  <para style="s">違犯安息日</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32" />
    <char style="pn">以色列</char>子孫在曠野的時候，人們發現有一個人在安息日撿木柴。 <verse eid="NUM 15:32" /><verse number="33" style="v" sid="NUM 15:33" />那些發現他在撿木柴的人，就把他帶到<char style="pn">摩西</char>和<char style="pn">亞倫</char>以及全體會眾那裡。 <verse eid="NUM 15:33" /><verse number="34" style="v" sid="NUM 15:34" />他們把他拘押起來，因為還不明確該怎樣處置他。 <verse eid="NUM 15:34" /><verse number="35" style="v" sid="NUM 15:35" />耶和華對<char style="pn">摩西</char>說：「那人必須被處死，全體會眾要在營地外用石頭砸死他。」 <verse eid="NUM 15:35" /><verse number="36" style="v" sid="NUM 15:36" />於是全體會眾把那人帶到營地外，用石頭砸死了他，正如耶和華所指示<char style="pn">摩西</char>的。<verse eid="NUM 15:36" /></para>
  <para style="s">衣服繸子的規條</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 15:37" /><verse number="38" style="v" sid="NUM 15:38" />「你要吩咐<char style="pn">以色列</char>子民，告訴他們要世世代代在外衣的衣擺上做繸子，並給衣擺的繸子加上一根藍色的細帶子。 <verse eid="NUM 15:38" /><verse number="39" style="v" sid="NUM 15:39" />你們要這樣做繸子，使你們看見就想起並遵行耶和華的一切誡命，而不隨從自己慣於行淫的欲念和眼目； <verse eid="NUM 15:39" /><verse number="40" style="v" sid="NUM 15:40" />也使你們牢記並遵行我的一切誡命，成為聖潔的，歸於你們的神。 <verse eid="NUM 15:40" /><verse number="41" style="v" sid="NUM 15:41" />我是耶和華你們的神，是我把你們從<char style="pn">埃及</char>地領了出來，為要作你們的神。我是耶和華你們的神。」<verse eid="NUM 15:41" /></para>
  <chapter eid="NUM 15" />
  <chapter number="16" style="c" sid="NUM 16" />
  <para style="s">可拉煽動叛亂</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1" />
    <char style="pn">以斯哈</char>的兒子<char style="pn">可拉</char>，是<char style="pn">利未</char>之子<char style="pn">哥轄</char>的孫子，他帶著<char style="pn">魯本</char>子孫<char style="pn">以利押</char>的兒子<char style="pn">大坍</char>和<char style="pn">亞比蘭</char>，以及<char style="pn">比勒</char>的兒子<char style="pn">奧恩</char>， <verse eid="NUM 16:1" /><verse number="2" style="v" sid="NUM 16:2" />起來對抗<char style="pn">摩西</char>，隨同他們的還有<char style="pn">以色列</char>子孫中的兩百五十人，都是議會選召出來的會眾領袖，是有名望的人。 <verse eid="NUM 16:2" /><verse number="3" style="v" sid="NUM 16:3" />他們聚集起來對抗<char style="pn">摩西</char>和<char style="pn">亞倫</char>，說：「你們僭越了！其實全體會眾每一個都是聖潔的，耶和華也與他們同在，你們為何高抬自己，站在耶和華的會眾之上呢？」<verse eid="NUM 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4" />
    <char style="pn">摩西</char>聽見了，就臉伏於地。 <verse eid="NUM 16:4" /><verse number="5" style="v" sid="NUM 16:5" />他對<char style="pn">可拉</char>和<char style="pn">可拉</char>的所有同黨說：「明天早晨，耶和華會顯明誰是屬於他的，誰是分別為聖的，他會讓那人親近他，讓他所揀選的人親近他。 <verse eid="NUM 16:5" /><verse number="6" style="v" sid="NUM 16:6" />你們要這樣做：<char style="pn">可拉</char>和<char style="pn">可拉</char>的所有同黨，你們拿來香爐， <verse eid="NUM 16:6" /><verse number="7" style="v" sid="NUM 16:7" />明天在耶和華面前，給香爐裡盛上火，加上香。那時，耶和華揀選了誰，誰就是分別為聖的。<char style="pn">利未</char>的子孫哪，是你們僭越了！」<verse eid="NUM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8" />
    <char style="pn">摩西</char>又對<char style="pn">可拉</char>說：「<char style="pn">利未</char>的子孫哪，你們聽著！ <verse eid="NUM 16:8" /><verse number="9" style="v" sid="NUM 16:9" /><char style="pn">以色列</char>的神將你們從<char style="pn">以色列</char>會眾當中分別出來，讓你們親近他，做耶和華帳幕的服事工作，並站在會眾面前事奉他們，這對你們是小事嗎？ <verse eid="NUM 16:9" /><verse number="10" style="v" sid="NUM 16:10" />耶和華讓你和你所有的弟兄，就是與你一起的<char style="pn">利未</char>子孫，都親近他，現在你們還想謀求祭司的職份嗎？ <verse eid="NUM 16:10" /><verse number="11" style="v" sid="NUM 16:11" />其實，你和你所有的同黨聚集起來是在敵對耶和華！<char style="pn">亞倫</char>算什麼，你們竟然向他發怨言？」<verse eid="NUM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12" />
    <char style="pn">摩西</char>派人去把<char style="pn">以利押</char>的兒子<char style="pn">大坍</char>和<char style="pn">亞比蘭</char>召來，他們卻說：「我們不過去。 <verse eid="NUM 16:12" /><verse number="13" style="v" sid="NUM 16:13" />你把我們從流奶與蜜之地帶上來，讓我們死在曠野，這算小事嗎？你還想自立為王統治我們！ <verse eid="NUM 16:13" /><verse number="14" style="v" sid="NUM 16:14" />況且，你並沒有把我們領到流奶與蜜之地，也沒有賜給我們田地和葡萄園為繼業。難道你想剜出我們這些人的眼睛嗎？我們不過去！」<verse eid="NUM 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15" />
    <char style="pn">摩西</char>就非常惱火，他對耶和華說：「求你不要悅納他們的供物。我並沒有奪走過他們一頭驢子，也沒有傷害過他們任何一人。」<verse eid="NUM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16" />
    <char style="pn">摩西</char>對<char style="pn">可拉</char>說：「明天你和你的所有同黨都要到耶和華面前，你和他們，還有<char style="pn">亞倫</char>都要在場。 <verse eid="NUM 16:16" /><verse number="17" style="v" sid="NUM 16:17" />你們各自拿來香爐，放上香。他們各人要在耶和華面前呈上自己的香爐，共兩百五十個香爐，你和<char style="pn">亞倫</char>也要呈上自己的香爐。」<verse eid="NUM 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 16:18" />於是他們各自拿來香爐，給香爐裡盛上火，加上香，與<char style="pn">摩西</char>和<char style="pn">亞倫</char>一起站在會幕入口。 <verse eid="NUM 16:18" /><verse number="19" style="v" sid="NUM 16:19" /><char style="pn">可拉</char>把全體會眾都招聚到會幕入口，對抗<char style="pn">摩西</char>和<char style="pn">亞倫</char>。那時，耶和華的榮耀向全體會眾顯現， <verse eid="NUM 16:19" /><verse number="20" style="v" sid="NUM 16:20" />耶和華指示<char style="pn">摩西</char>和<char style="pn">亞倫</char>說： <verse eid="NUM 16:20" /><verse number="21" style="v" sid="NUM 16:21" />「你們從這會眾當中分離出來，我要一瞬間消滅他們！」<verse eid="NUM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22" />
    <char style="pn">摩西</char>和<char style="pn">亞倫</char>就臉伏於地，說：「神哪，使一切肉體有氣息<note caller="+" style="f"><char style="fr" closed="false">16:22 </char><char style="ft" closed="false">使一切肉體有氣息——或譯作「賜予全人類氣息」。</char></note>的神！一個人犯罪，你就對全體會眾發怒嗎？」<verse eid="NUM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23" />於是，耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 16:23" /><verse number="24" style="v" sid="NUM 16:24" />「你要吩咐會眾說：你們都從<char style="pn">可拉</char>、<char style="pn">大坍</char>和<char style="pn">亞比蘭</char>的帳幕周圍離開！」<verse eid="NUM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25" />於是<char style="pn">摩西</char>起來，到<char style="pn">大坍</char>和<char style="pn">亞比蘭</char>那裡去，<char style="pn">以色列</char>的長老們跟隨著他。 <verse eid="NUM 16:25" /><verse number="26" style="v" sid="NUM 16:26" />他告訴會眾說：「你們要遠離這些惡人的帳篷，不要碰任何屬於他們的東西，免得你們因他們的一切罪惡而被除滅。」 <verse eid="NUM 16:26" /><verse number="27" style="v" sid="NUM 16:27" />會眾就從<char style="pn">可拉</char>、<char style="pn">大坍</char>、<char style="pn">亞比蘭</char>的帳篷四圍離開了。<char style="pn">大坍</char>和<char style="pn">亞比蘭</char>，還有他們的妻子、兒女和孩童都出來，站在他們的帳篷入口。<verse eid="NUM 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 16:28" />
    <char style="pn">摩西</char>說：「藉著這事，你們必知道，是耶和華派遣了我來做這一切工作，而不是我隨從自己的心意做事。 <verse eid="NUM 16:28" /><verse number="29" style="v" sid="NUM 16:29" />如果這些人的死如世人的死，他們的遭遇如世人的遭遇，耶和華就沒有派遣我。 <verse eid="NUM 16:29" /><verse number="30" style="v" sid="NUM 16:30" />但如果耶和華行一件新事，使地張口吞掉他們和屬於他們的一切，使他們活活地下到陰間，你們就明白：這些人確實藐視了耶和華。」<verse eid="NUM 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31" />他剛說完這一切話，那些人脚下的土地就裂開了。 <verse eid="NUM 16:31" /><verse number="32" style="v" sid="NUM 16:32" />地張口吞掉他們和他們的家人，以及所有屬於<char style="pn">可拉</char>的人和財物。 <verse eid="NUM 16:32" /><verse number="33" style="v" sid="NUM 16:33" />他們和所有屬於他們的，都活活地下到陰間，地掩埋了他們，他們就從會眾當中消失了。 <verse eid="NUM 16:33" /><verse number="34" style="v" sid="NUM 16:34" />因他們的叫聲周圍所有的<char style="pn">以色列</char>人都逃跑了，他們說：「恐怕地要把我們也吞掉了！」 <verse eid="NUM 16:34" /><verse number="35" style="v" sid="NUM 16:35" />還有火從耶和華那裡出來，吞滅了那兩百五十個呈上香的人。<verse eid="NUM 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36" />
    <note caller="+" style="f">
      <char style="fr" closed="false">16:36 </char>
      <char style="ft" closed="false">此節至17:13在馬索拉文本為17:1至17:28。</char>
    </note>耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 16:36" /><verse number="37" style="v" sid="NUM 16:37" />「你要吩咐祭司<char style="pn">亞倫</char>的兒子<char style="pn">以利亞撒</char>，讓他從燃燒的火中拿起那些香爐，將火撒在遠處，因為那些香爐都分別為聖了。 <verse eid="NUM 16:37" /><verse number="38" style="v" sid="NUM 16:38" />至於那些犯罪喪命之人的香爐，要錘成薄片，用來包祭壇，因為這些香爐已經被獻在耶和華面前，分別為聖了；它們要給<char style="pn">以色列</char>子孫作鑒戒。」<verse eid="NUM 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39" />於是，祭司<char style="pn">以利亞撒</char>取來那些被燒死的人所獻的銅香爐，人們把香爐錘成薄片，用來包祭壇， <verse eid="NUM 16:39" /><verse number="40" style="v" sid="NUM 16:40" />為<char style="pn">以色列</char>子孫作記念，免得那不屬於<char style="pn">亞倫</char>後裔的外人靠近耶和華面前燒香，以致有<char style="pn">可拉</char>和他的同黨一樣的遭遇。這都是照耶和華藉著<char style="pn">摩西</char>所吩咐<char style="pn">以利亞撒</char>的。<verse eid="NUM 16:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41" />但第二天，全體<char style="pn">以色列</char>會眾向<char style="pn">摩西</char>和<char style="pn">亞倫</char>發怨言，說：「你們殺了耶和華的子民！」 <verse eid="NUM 16:41" /><verse number="42" style="v" sid="NUM 16:42" />正當會眾聚集起來對抗<char style="pn">摩西</char>和<char style="pn">亞倫</char>的時候，他們轉向會幕，看哪，雲彩遮蓋會幕，耶和華的榮耀顯現了。<verse eid="NUM 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="NUM 16:43" />
    <char style="pn">摩西</char>和<char style="pn">亞倫</char>來到會幕前面， <verse eid="NUM 16:43" /><verse number="44" style="v" sid="NUM 16:44" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 16:44" /><verse number="45" style="v" sid="NUM 16:45" />「你們從這會眾當中離開，我要一瞬間消滅他們！」<char style="pn">摩西</char>和<char style="pn">亞倫</char>就臉伏於地。<verse eid="NUM 16:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 16:46" />
    <char style="pn">摩西</char>對<char style="pn">亞倫</char>說：「你拿來香爐，香爐裡盛上祭壇的火，加上香，趕快到會眾那裡去，為他們贖罪，因為有震怒從耶和華面前發出，瘟疫已經開始了。」<verse eid="NUM 16:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 16:47" />
    <char style="pn">亞倫</char>照著<char style="pn">摩西</char>所說的拿來香爐，跑到會眾當中。看哪，瘟疫已經在子民中開始了！他就呈上香<note caller="+" style="f"><char style="fr" closed="false">16:47 </char><char style="ft" closed="false">呈上香——或譯作「給香爐放上香」。</char></note>，為子民贖罪。 <verse eid="NUM 16:47" /><verse number="48" style="v" sid="NUM 16:48" />他站在死人和活人之間，瘟疫就止住了。 <verse eid="NUM 16:48" /><verse number="49" style="v" sid="NUM 16:49" />除了因<char style="pn">可拉</char>事件而死的人以外，死於瘟疫的有一萬四千七百人。 <verse eid="NUM 16:49" /><verse number="50" style="v" sid="NUM 16:50" /><char style="pn">亞倫</char>回到會幕入口<char style="pn">摩西</char>那裡，瘟疫已經止住了。<verse eid="NUM 16:50" /></para>
  <chapter eid="NUM 16" />
  <chapter number="17" style="c" sid="NUM 17" />
  <para style="s">亞倫的杖被選中</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">17:1 </char>
      <char style="ft" closed="false">此章在馬索拉文本為17:16至17:28。</char>
    </note>耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 17:1" /><verse number="2" style="v" sid="NUM 17:2" />「你告訴<char style="pn">以色列</char>子民，要按父家從他們那裡取來木杖，每個父家一根，從所有的父家領袖那裡取來十二根杖。你要把各人的名字寫在各自的杖上， <verse eid="NUM 17:2" /><verse number="3" style="v" sid="NUM 17:3" />也把<char style="pn">亞倫</char>的名字寫在<char style="pn">利未</char>的杖上，這樣一根杖代表一個父家首領。 <verse eid="NUM 17:3" /><verse number="4" style="v" sid="NUM 17:4" />你要把這些杖放在會幕裡見證櫃的前面，那裡是我與你們相會的地方。 <verse eid="NUM 17:4" /><verse number="5" style="v" sid="NUM 17:5" />我所揀選的那個人，他的杖將會發芽，這樣我就從我面前平息了<char style="pn">以色列</char>子民向你們所發的怨言。」<verse eid="NUM 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6" />於是<char style="pn">摩西</char>吩咐<char style="pn">以色列</char>子民，他們所有的領袖就按父家把木杖交給他，一根杖代表一個領袖，共十二根杖，<char style="pn">亞倫</char>的杖也在他們的杖中間。 <verse eid="NUM 17:6" /><verse number="7" style="v" sid="NUM 17:7" /><char style="pn">摩西</char>就把這些杖安置在見證會幕內耶和華面前。<verse eid="NUM 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8" />到了第二天，<char style="pn">摩西</char>進入見證會幕，看哪，<char style="pn">利未</char>家<char style="pn">亞倫</char>的杖發了芽，吐出花苞，開了花，結了杏。 <verse eid="NUM 17:8" /><verse number="9" style="v" sid="NUM 17:9" /><char style="pn">摩西</char>把所有的木杖從耶和華面前拿出來，給所有的<char style="pn">以色列</char>子民。他們看了，各人就取回自己的杖。 <verse eid="NUM 17:9" /><verse number="10" style="v" sid="NUM 17:10" />耶和華對<char style="pn">摩西</char>說：「<char style="pn">亞倫</char>的杖要放回見證櫃前面，保存下來給悖逆的人作鑒戒。這樣他們的怨言就可以從我面前止息，以免他們死亡。」 <verse eid="NUM 17:10" /><verse number="11" style="v" sid="NUM 17:11" /><char style="pn">摩西</char>遵行耶和華所指示他的，都照著做了。<verse eid="NUM 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12" />那時，<char style="pn">以色列</char>子民對<char style="pn">摩西</char>說：「看哪，我們喪命了！我們滅亡了！我們全都滅亡了！ <verse eid="NUM 17:12" /><verse number="13" style="v" sid="NUM 17:13" />凡是靠近耶和華帳幕的人都要死，難道我們全都要喪命嗎？」<verse eid="NUM 17:13" /></para>
  <chapter eid="NUM 17" />
  <chapter number="18" style="c" sid="NUM 18" />
  <para style="s">會幕的聖職</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1" />於是，耶和華對<char style="pn">亞倫</char>說：「你和你的兒子們以及你的父家，要一同承擔與聖所相關的罪責；你和你的兒子們，要一同承擔與你們祭司職份相關的罪責。 <verse eid="NUM 18:1" /><verse number="2" style="v" sid="NUM 18:2" />你還要帶你<char style="pn">利未</char>支派的弟兄，就是你父系支派的人，與你一同上前事奉。他們要從屬你，輔助你。當你和你的兒子們一同在見證會幕前面時， <verse eid="NUM 18:2" /><verse number="3" style="v" sid="NUM 18:3" />他們要為你和整個會幕謹守職責，只是他們不可靠近聖所的器具和祭壇，以免他們和你們都死亡。 <verse eid="NUM 18:3" /><verse number="4" style="v" sid="NUM 18:4" />他們要從屬你，為帳幕的一切服事謹守會幕的職責；外人不可靠近你們。<verse eid="NUM 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 18:5" />「你們要謹守聖所的職責和祭壇的職責，以免震怒再臨到<char style="pn">以色列</char>子孫。 <verse eid="NUM 18:5" /><verse number="6" style="v" sid="NUM 18:6" />看哪，我已經從<char style="pn">以色列</char>子孫中揀選了你的弟兄<char style="pn">利未</char>人，賞賜給你們，獻於耶和華做會幕的服事工作。 <verse eid="NUM 18:6" /><verse number="7" style="v" sid="NUM 18:7" />你和你的兒子們要為祭壇和幔子內的一切事務，謹守祭司的職份，做好服事。我把祭司職份作為服事工作賞賜給你們，凡是接近的外人，都要被處死。」<verse eid="NUM 18:7" /></para>
  <para style="s">祭司和利未人的份例</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8" />耶和華又對<char style="pn">亞倫</char>說：「看哪，我已經把奉獻供物的職責交給了你。至於<char style="pn">以色列</char>子孫所有的聖物，我把它們賜給你作受膏的份，也給你的兒子們作永遠的份例。 <verse eid="NUM 18:8" /><verse number="9" style="v" sid="NUM 18:9" />人們帶來獻給我的至聖物，就是所有的祭物，包括所有的素祭、所有的贖罪祭、所有的贖愆祭，其中沒有燒獻的要歸屬你；這些是至聖的，歸於你和你的子孫。 <verse eid="NUM 18:9" /><verse number="10" style="v" sid="NUM 18:10" />你要把它作為至聖物吃，只有男的才可以吃；你要把它當作神聖的。<verse eid="NUM 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11" />「<char style="pn">以色列</char>子孫奉獻的供物，就是他們所有的搖獻祭物，也歸於你；我把它們賜給你和與你一起的兒女們，作永遠的份例，你家裡所有潔淨的人都可以吃。 <verse eid="NUM 18:11" /><verse number="12" style="v" sid="NUM 18:12" />所有最好的新油、最好的新酒，以及人們獻給耶和華的初熟五穀，我也賜給你。 <verse eid="NUM 18:12" /><verse number="13" style="v" sid="NUM 18:13" />他們地裡的一切初熟之物，就是他們帶來獻給耶和華的，都歸屬你。你家裡所有潔淨的人都可以吃。<verse eid="NUM 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14" />「<char style="pn">以色列</char>中一切永獻之物都歸屬你。 <verse eid="NUM 18:14" /><verse number="15" style="v" sid="NUM 18:15" />他們向耶和華獻上的所有頭胎的活物，無論是人還是牲畜，都歸屬你。只是你必須讓他們把頭生的人贖回，還有頭生的不潔淨牲畜，也要贖回。 <verse eid="NUM 18:15" /><verse number="16" style="v" sid="NUM 18:16" />出生一個月以後要贖回的，要照你所估的價，用五謝克爾銀子贖回；按聖所的謝克爾<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">謝克爾——重量單位；後來成為貨幣單位。1謝克爾=11.4公克。</char></note>標準，一謝克爾是二十季拉<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">二十季拉——相當於11.4公克。1季拉=0.57公克。</char></note>。<verse eid="NUM 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 18:17" />「但是頭生的公牛，或頭生的綿羊，或頭生的山羊，不可贖回；牠們是聖物。你要把牠們的血灑在祭壇上，把牠們的脂肪燒獻為火祭，作馨香之氣獻給耶和華。 <verse eid="NUM 18:17" /><verse number="18" style="v" sid="NUM 18:18" />牠們的肉要歸屬你，就像搖獻祭物的胸肉和右腿一樣歸屬你。<verse eid="NUM 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 18:19" />「<char style="pn">以色列</char>子孫向耶和華奉上的一切神聖供物，我都賜給你和與你一起的兒女們，作永遠的份例。這是你和與你一起的後裔在耶和華面前永遠的鹽約。」<verse eid="NUM 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20" />耶和華對<char style="pn">亞倫</char>說：「你不可在<char style="pn">以色列</char>子孫的土地中分得繼業，你在他們中間沒有繼業的份。在<char style="pn">以色列</char>子孫中，我就是你的份，你的產業。<verse eid="NUM 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21" />「至於<char style="pn">利未</char>的子孫，看哪，我把<char style="pn">以色列</char>中所有出產的十分之一賜給了他們為產業，回報他們所做的會幕服事工作。 <verse eid="NUM 18:21" /><verse number="22" style="v" sid="NUM 18:22" /><char style="pn">以色列</char>子孫不可再靠近會幕，以免他們承擔罪過而死。 <verse eid="NUM 18:22" /><verse number="23" style="v" sid="NUM 18:23" /><char style="pn">利未</char>人要做會幕的服事工作，他們要承擔與聖所相關的罪責。這是你們世世代代永遠的律例：他們不可在<char style="pn">以色列</char>子孫中分得繼業。 <verse eid="NUM 18:23" /><verse number="24" style="v" sid="NUM 18:24" />因為我已經把<char style="pn">以色列</char>子孫的十分之一出產，就是他們向耶和華奉上的供物，賜給了<char style="pn">利未</char>人作產業。因此我對他們說，他們不可在<char style="pn">以色列</char>子孫中分得繼業。」<verse eid="NUM 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 18:25" /><verse number="26" style="v" sid="NUM 18:26" />「你要吩咐<char style="pn">利未</char>人，對他們說：當你們從<char style="pn">以色列</char>子孫獲得了我所賜給你們的那十分之一出產為產業，你們要再從那十分之一中奉上十分之一，作為獻給耶和華的供物。 <verse eid="NUM 18:26" /><verse number="27" style="v" sid="NUM 18:27" />這算為你們奉獻的供物，就像你們打穀場上的五穀，酒榨中滿盈的酒一樣。 <verse eid="NUM 18:27" /><verse number="28" style="v" sid="NUM 18:28" />這樣，你們從<char style="pn">以色列</char>子孫獲得的全部十分之一出產，也要從中奉上耶和華的供物，把這份獻給耶和華的供物交給祭司<char style="pn">亞倫</char>。 <verse eid="NUM 18:28" /><verse number="29" style="v" sid="NUM 18:29" />你們要從你們的一切禮物中，從一切最好的、至聖的部分中，奉上耶和華的各樣供物。<verse eid="NUM 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30" />「你要對<char style="pn">利未</char>人說：『當你們從其中把最好的奉獻之後，其餘的就算為<char style="pn">利未</char>人的，就像打穀場的收成和酒榨的收成。 <verse eid="NUM 18:30" /><verse number="31" style="v" sid="NUM 18:31" />你們和你們的家人可以在任何地方吃它，因為這是你們的酬報，以回報你們在會幕裡的服事。 <verse eid="NUM 18:31" /><verse number="32" style="v" sid="NUM 18:32" />當你們把其中最好的奉獻之後，你們就不會因它而承擔罪過了；你們不可褻瀆<char style="pn">以色列</char>子孫的聖物，免得你們死亡。」<verse eid="NUM 18:32" /></para>
  <chapter eid="NUM 18" />
  <chapter number="19" style="c" sid="NUM 19" />
  <para style="s">潔淨禮</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1" />耶和華指示<char style="pn">摩西</char>和<char style="pn">亞倫</char>說： <verse eid="NUM 19:1" /><verse number="2" style="v" sid="NUM 19:2" />「以下是耶和華所吩咐的律法條例：你要告訴<char style="pn">以色列</char>子民，把一頭沒有殘疾、沒有負過軛的無瑕疵紅母牛帶到你這裡。 <verse eid="NUM 19:2" /><verse number="3" style="v" sid="NUM 19:3" />你們要把這牛交給祭司<char style="pn">以利亞撒</char>，然後領到營地外，在他面前宰殺了。 <verse eid="NUM 19:3" /><verse number="4" style="v" sid="NUM 19:4" />祭司<char style="pn">以利亞撒</char>要用手指蘸一些母牛的血，向著會幕前面彈灑七次。 <verse eid="NUM 19:4" /><verse number="5" style="v" sid="NUM 19:5" />然後這母牛要在他眼前被焚燒，皮、肉、血，連同糞便都要燒掉。 <verse eid="NUM 19:5" /><verse number="6" style="v" sid="NUM 19:6" />祭司要拿來香柏木、牛膝草和朱紅色線，扔進焚燒母牛的火中。 <verse eid="NUM 19:6" /><verse number="7" style="v" sid="NUM 19:7" />祭司要洗衣服，用水洗身，之後才可以進入營地；祭司會不潔淨直到傍晚。 <verse eid="NUM 19:7" /><verse number="8" style="v" sid="NUM 19:8" />那焚燒母牛的人，也要用水洗衣服，用水洗身；他會不潔淨直到傍晚。<verse eid="NUM 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9" />「要有一個潔淨的人收取那母牛的灰燼，放置在營地外潔淨的地方，為<char style="pn">以色列</char>會眾保存下來，用於調制除汙穢的水；這是除罪用的。 <verse eid="NUM 19:9" /><verse number="10" style="v" sid="NUM 19:10" />那收取母牛灰燼的人要洗衣服，他會不潔淨直到傍晚。這要作為<char style="pn">以色列</char>子孫和寄居在他們中間的外人永遠的律例。<verse eid="NUM 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11" />「凡是觸碰死屍的人，無論那是誰的屍體，他都會不潔淨七天。 <verse eid="NUM 19:11" /><verse number="12" style="v" sid="NUM 19:12" />他要在第三天和第七天用那除汙穢的水潔淨自己，他就得潔淨了；如果他在第三天和第七天不潔淨自己，他就不得潔淨。 <verse eid="NUM 19:12" /><verse number="13" style="v" sid="NUM 19:13" />凡是觸碰死人屍體的，如果不潔淨自己，他就玷汙了耶和華的帳幕，這人必須從<char style="pn">以色列</char>中被剪除。因為那除汙穢的水沒有灑在他身上，他仍是不潔淨的，他的汙穢還在他身上。<verse eid="NUM 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14" />「以下是有人死在帳篷裡時的條例：所有進入那帳篷的人或已經在那帳篷裡的人，都會不潔淨七天。 <verse eid="NUM 19:14" /><verse number="15" style="v" sid="NUM 19:15" />帳篷裡所有敞口的器皿，就是沒有扣上蓋子的，都會不潔淨。 <verse eid="NUM 19:15" /><verse number="16" style="v" sid="NUM 19:16" />另外，任何人在田野上觸碰被刀劍所殺的，或自然<note caller="+" style="f"><char style="fr" closed="false">19:16 </char><char style="ft" closed="false">自然——輔助詞語。</char></note>死去的，或人的骨頭，或墳墓，他也會不潔淨七天。 <verse eid="NUM 19:16" /><verse number="17" style="v" sid="NUM 19:17" />他們要為不潔淨的人取來那贖罪祭牲燒成的灰，放在器皿裡，加上活水。 <verse eid="NUM 19:17" /><verse number="18" style="v" sid="NUM 19:18" />要有一個潔淨的人拿牛膝草蘸那水，灑在帳篷上、所有器具上以及帳篷裡的人身上，也灑在那觸碰了人骨頭的，或觸碰被殺的、自然<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">自然——輔助詞語。</char></note>死的，或觸碰墳墓的人身上。<verse eid="NUM 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 19:19" />「潔淨的人要在第三天和第七天把那水灑在不潔淨的人身上，這樣就使他在第七天得潔淨；他要洗衣服，用水洗身，到傍晚就潔淨了。 <verse eid="NUM 19:19" /><verse number="20" style="v" sid="NUM 19:20" />凡是不潔淨的人，如果沒有潔淨自己，這人就要從會眾當中被剪除，因為他玷汙了耶和華的聖所；那除汙穢的水沒有灑在他身上，他就是不潔淨的。 <verse eid="NUM 19:20" /><verse number="21" style="v" sid="NUM 19:21" />這要作為他們永遠的律例。灑這除汙穢之水的人，要洗自己的衣服；凡是觸碰除汙穢之水的人，都會不潔淨直到傍晚。 <verse eid="NUM 19:21" /><verse number="22" style="v" sid="NUM 19:22" />那不潔淨的人碰過的任何東西都不潔淨，觸碰那些東西的人也會不潔淨直到傍晚。」<verse eid="NUM 19:22" /></para>
  <chapter eid="NUM 19" />
  <chapter number="20" style="c" sid="NUM 20" />
  <para style="s">岩石出水</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1" />一月的時候，<char style="pn">以色列</char>全體會眾來到<char style="pn">尋</char>的曠野，民眾就住在<char style="pn">加低斯</char>。<char style="pn">米利暗</char>死在那裡，也葬在那裡。<verse eid="NUM 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2" />那時，會眾沒有水了，就聚集起來對抗<char style="pn">摩西</char>和<char style="pn">亞倫</char>。 <verse eid="NUM 20:2" /><verse number="3" style="v" sid="NUM 20:3" />民眾向<char style="pn">摩西</char>爭鬧，開口說：「我們的兄弟在耶和華面前喪命時，還不如讓我們也死了！ <verse eid="NUM 20:3" /><verse number="4" style="v" sid="NUM 20:4" />你們為什麼把耶和華的會眾領到這曠野，使我們和我們的牲畜死在這裡呢？ <verse eid="NUM 20:4" /><verse number="5" style="v" sid="NUM 20:5" />為什麼把我們從<char style="pn">埃及</char>帶上來，領我們到這樣惡劣的地方呢？這裡沒有撒種的地方，沒有無花果樹、葡萄樹、石榴樹，也沒有水喝。」<verse eid="NUM 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6" />
    <char style="pn">摩西</char>和<char style="pn">亞倫</char>就從會眾面前來到會幕的入口，臉伏於地。耶和華的榮耀向他們顯現， <verse eid="NUM 20:6" /><verse number="7" style="v" sid="NUM 20:7" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 20:7" /><verse number="8" style="v" sid="NUM 20:8" />「你把那根杖取來，然後你和你哥哥<char style="pn">亞倫</char>招聚會眾，在他們眼前吩咐岩石流出水來。這樣，你就使水從岩石中流出來，給會眾和他們的牲畜喝。」<verse eid="NUM 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 20:9" />於是，<char style="pn">摩西</char>照著耶和華指示他的，從耶和華面前取來那根杖。 <verse eid="NUM 20:9" /><verse number="10" style="v" sid="NUM 20:10" /><char style="pn">摩西</char>和<char style="pn">亞倫</char>招聚會眾到岩石前面，對他們說：「悖逆的人哪，你們聽著！難道我們必須使這岩石給你們流出水嗎？」 <verse eid="NUM 20:10" /><verse number="11" style="v" sid="NUM 20:11" /><char style="pn">摩西</char>舉起手，用他的杖擊打岩石兩次，就有大量的水流出來，會眾和他們的牲畜都喝了。<verse eid="NUM 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12" />然而，耶和華對<char style="pn">摩西</char>和<char style="pn">亞倫</char>說：「由於你們沒有信我，沒有在<char style="pn">以色列</char>子民眼前尊我為聖，因此你們不能帶領這會眾進入我賜給他們的那地。」 <verse eid="NUM 20:12" /><verse number="13" style="v" sid="NUM 20:13" />這就是「<char style="pn">米利巴</char>水」，因<char style="pn">以色列</char>子民向耶和華爭鬧，耶和華就在他們中間顯為聖。<verse eid="NUM 20:13" /></para>
  <para style="s">以東拒絕以色列過境</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14" />
    <char style="pn">摩西</char>從<char style="pn">加低斯</char>派遣使者去見<char style="pn">以東</char>王，說：「你的兄弟<char style="pn">以色列</char>如此說：你知道我們所遭遇的一切艱難。 <verse eid="NUM 20:14" /><verse number="15" style="v" sid="NUM 20:15" />我們的祖先下到<char style="pn">埃及</char>，我們在<char style="pn">埃及</char>住了許多日子，<char style="pn">埃及</char>人惡待我們和我們的祖先。 <verse eid="NUM 20:15" /><verse number="16" style="v" sid="NUM 20:16" />我們向耶和華呼求，他垂聽了我們的呼聲，派遣一位使者把我們從<char style="pn">埃及</char>帶了出來。現在，我們到了你邊境的<char style="pn">加低斯</char>城。 <verse eid="NUM 20:16" /><verse number="17" style="v" sid="NUM 20:17" />請讓我們從你境內經過；我們不會進入田間或葡萄園，也不喝井裡的水。我們只走大道，不偏左右，直到我們過了你的地界。」<verse eid="NUM 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18" />
    <char style="pn">以東</char>卻答覆說：「你不可從我這裡經過，否則我會帶著刀劍出來迎擊你。」<verse eid="NUM 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19" />
    <char style="pn">以色列</char>人對他說：「我們只從大道上過去；如果我們和我們的牲畜喝了你的水，我們會付水錢。我們沒有別的要求，只願讓我們徒步經過！」<verse eid="NUM 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20" />但他回答：「你們不可經過。」<char style="pn">以東</char>就帶著大軍，強勢出來迎擊<char style="pn">以色列</char>。 <verse eid="NUM 20:20" /><verse number="21" style="v" sid="NUM 20:21" /><char style="pn">以東</char>拒絕讓<char style="pn">以色列</char>經過他的境內，於是<char style="pn">以色列</char>轉身離開了他。<verse eid="NUM 20:21" /></para>
  <para style="s">亞倫去世</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22" />
    <char style="pn">以色列</char>全體會眾從<char style="pn">加低斯</char>起行，來到了<char style="pn">何珥</char>山。 <verse eid="NUM 20:22" /><verse number="23" style="v" sid="NUM 20:23" />在<char style="pn">以東</char>地邊界的<char style="pn">何珥</char>山，耶和華對<char style="pn">摩西</char>和<char style="pn">亞倫</char>說： <verse eid="NUM 20:23" /><verse number="24" style="v" sid="NUM 20:24" />「<char style="pn">亞倫</char>要歸到他的先人那裡了。他不得進入我賜給<char style="pn">以色列</char>子孫的那地，因為你們在<char style="pn">米利巴</char>水邊違背了我的命令。 <verse eid="NUM 20:24" /><verse number="25" style="v" sid="NUM 20:25" />你要帶來<char style="pn">亞倫</char>和他的兒子<char style="pn">以利亞撒</char>，把他們帶到<char style="pn">何珥</char>山上。 <verse eid="NUM 20:25" /><verse number="26" style="v" sid="NUM 20:26" />你要脫下<char style="pn">亞倫</char>的聖衣，給他的兒子<char style="pn">以利亞撒</char>穿上。然後，<char style="pn">亞倫</char>會歸到先人那裡，死在山上。」<verse eid="NUM 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27" />
    <char style="pn">摩西</char>就照著耶和華所指示的去做，他們在全體會眾眼前上了<char style="pn">何珥</char>山。 <verse eid="NUM 20:27" /><verse number="28" style="v" sid="NUM 20:28" /><char style="pn">摩西</char>脫下<char style="pn">亞倫</char>的聖衣，給他的兒子<char style="pn">以利亞撒</char>穿上，<char style="pn">亞倫</char>就死在山頂上。隨後，<char style="pn">摩西</char>和<char style="pn">以利亞撒</char>從山上下來。 <verse eid="NUM 20:28" /><verse number="29" style="v" sid="NUM 20:29" />全體會眾看到<char style="pn">亞倫</char>去世了，<char style="pn">以色列</char>全家就為<char style="pn">亞倫</char>哀哭三十天。<verse eid="NUM 20:29" /></para>
  <chapter eid="NUM 20" />
  <chapter number="21" style="c" sid="NUM 21" />
  <para style="s">擊敗迦南王</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1" />
    <char style="pn">迦南</char>的<char style="pn">阿拉德</char>王住在南地<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="ft" closed="false">南地——音譯作「內蓋夫」。</char></note>，聽說<char style="pn">以色列</char>沿著通往<char style="pn">阿塔林</char>的路來了，就攻打<char style="pn">以色列</char>，俘虜了他們一些人。 <verse eid="NUM 21:1" /><verse number="2" style="v" sid="NUM 21:2" /><char style="pn">以色列</char>向耶和華許願說：「如果你把這民確實交在我手中，我就把他們的城鎮都毀滅淨盡。」 <verse eid="NUM 21:2" /><verse number="3" style="v" sid="NUM 21:3" />耶和華垂聽了<char style="pn">以色列</char>的祈求，交出<char style="pn">迦南</char>人。<char style="pn">以色列</char>人把他們和他們的城鎮都毀滅淨盡，那地方就被起名為「<char style="pn">霍爾瑪</char>」。<verse eid="NUM 21:3" /></para>
  <para style="s">舉起銅蛇</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4" />他們離開<char style="pn">何珥</char>山，沿著通往<char style="pn">紅海</char>的路前行，要繞過<char style="pn">以東</char>地，民眾在路上失去耐心。 <verse eid="NUM 21:4" /><verse number="5" style="v" sid="NUM 21:5" />民眾攻擊神和<char style="pn">摩西</char>說：「你們為什麼把我們從<char style="pn">埃及</char>帶上來，使我們死在曠野呢？這裡既沒有食物，也沒有水，我們的心也厭煩了這淡而無味的食物！」 <verse eid="NUM 21:5" /><verse number="6" style="v" sid="NUM 21:6" />於是耶和華派出毒蛇<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="ft" closed="false">毒蛇——或譯作「火蛇」；本章下同。</char></note>到民眾當中咬他們，<char style="pn">以色列</char>死了許多人。<verse eid="NUM 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 21:7" />民眾來見<char style="pn">摩西</char>，說：「我們犯罪了，我們攻擊了耶和華和你。求你向耶和華禱告，讓蛇離開我們。」於是<char style="pn">摩西</char>就為民眾禱告。<verse eid="NUM 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8" />耶和華對<char style="pn">摩西</char>說：「你要鑄造一條毒蛇，掛在旗杆上。凡是被咬的人，一看見它就能存活。」 <verse eid="NUM 21:8" /><verse number="9" style="v" sid="NUM 21:9" /><char style="pn">摩西</char>就鑄造了一條銅蛇，掛在旗杆上。凡是被蛇咬了的人，只要仰望那銅蛇，就得以存活。<verse eid="NUM 21:9" /></para>
  <para style="s">繞行摩押地界</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10" />
    <char style="pn">以色列</char>子民起行，紮營在<char style="pn">奧伯特</char>。 <verse eid="NUM 21:10" /><verse number="11" style="v" sid="NUM 21:11" />又從<char style="pn">奧伯特</char>起行，紮營在<char style="pn">伊耶-亞巴琳</char>，就在<char style="pn">摩押</char>東面的曠野。 <verse eid="NUM 21:11" /><verse number="12" style="v" sid="NUM 21:12" />又從那裡起行，紮營在<char style="pn">撒烈</char>溪谷。 <verse eid="NUM 21:12" /><verse number="13" style="v" sid="NUM 21:13" />又從那裡起行，紮營在<char style="pn">亞嫩</char>河對岸。這條河在曠野中，從<char style="pn">亞摩利</char>人的邊界流出來；<char style="pn">亞嫩</char>河就是<char style="pn">摩押</char>的邊界，位於<char style="pn">摩押</char>和<char style="pn">亞摩利</char>之間。 <verse eid="NUM 21:13" /><verse number="14" style="v" sid="NUM 21:14" />因此在《耶和華戰記》上說：</para>
  <para style="q1" vid="NUM 21:14">「<char style="pn">蘇法</char>的<char style="pn">哇哈伯</char>，<char style="pn">亞嫩</char>河的溪谷，<verse eid="NUM 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NUM 21:15" />以及往<char style="pn">亞珥</char>居住地延伸的溪谷斜坡，</para>
  <para style="q1" vid="NUM 21:15">都緊靠<char style="pn">摩押</char>的邊界。」<verse eid="NUM 21:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="NUM 21:16" />他們從那裡來到<char style="pn">比爾</char>，就是在這井旁，耶和華曾對<char style="pn">摩西</char>說：「招聚民眾來，我要賜給他們水。」 <verse eid="NUM 21:16" /><verse number="17" style="v" sid="NUM 21:17" />那時<char style="pn">以色列</char>唱了這首歌：</para>
  <para style="q1" vid="NUM 21:17">「井啊，湧上水來！</para>
  <para style="q1" vid="NUM 21:17">你們要為這井歌唱。<verse eid="NUM 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18" />這井是首領們所挖的，</para>
  <para style="q1" vid="NUM 21:18">是民中的貴族用權杖、用手杖開鑿的。」</para>
  <para style="b" vid="NUM 21:18" />
  <para style="p" vid="NUM 21:18">然後，他們從曠野來到<char style="pn">瑪塔納</char>。 <verse eid="NUM 21:18" /><verse number="19" style="v" sid="NUM 21:19" />又從<char style="pn">瑪塔納</char>到<char style="pn">拿哈列</char>，從<char style="pn">拿哈列</char>到<char style="pn">巴末</char>， <verse eid="NUM 21:19" /><verse number="20" style="v" sid="NUM 21:20" />從<char style="pn">巴末</char>到<char style="pn">摩押</char>境內的山谷，在那裡的<char style="pn">毗斯迦</char>山頂可以俯看荒漠。<verse eid="NUM 21:20" /></para>
  <para style="s">擊敗亞摩利王</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21" />
    <char style="pn">以色列</char>派使者去見<char style="pn">亞摩利</char>王<char style="pn">西宏</char>，說： <verse eid="NUM 21:21" /><verse number="22" style="v" sid="NUM 21:22" />「請讓我們從你境內經過，我們不進入田間和葡萄園，也不喝井裡的水。我們只走大道，直到過了你的地界。」 <verse eid="NUM 21:22" /><verse number="23" style="v" sid="NUM 21:23" />但<char style="pn">西宏</char>不允許<char style="pn">以色列</char>經過他的境內。<char style="pn">西宏</char>招聚他的全軍，出來在曠野迎擊<char style="pn">以色列</char>。他來到<char style="pn">雅哈茲</char>，與<char style="pn">以色列</char>交戰。 <verse eid="NUM 21:23" /><verse number="24" style="v" sid="NUM 21:24" /><char style="pn">以色列</char>用刀擊殺他，占有了他的領土，從<char style="pn">亞嫩</char>河到<char style="pn">雅博</char>河，直到<char style="pn">亞捫</char>人那裡，因為<char style="pn">亞捫</char>人的邊防穩固。<verse eid="NUM 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 21:25" />
    <char style="pn">以色列</char>奪取了那些城，就住在<char style="pn">亞摩利</char>人的所有城鎮，包括<char style="pn">希實本</char>和它的所有村鎮。 <verse eid="NUM 21:25" /><verse number="26" style="v" sid="NUM 21:26" /><char style="pn">希實本</char>是<char style="pn">亞摩利</char>王<char style="pn">西宏</char>的都城，<char style="pn">西宏</char>曾與<char style="pn">摩押</char>先前的王交戰，從他手中奪取了他的全地，直到<char style="pn">亞嫩</char>河， <verse eid="NUM 21:26" /><verse number="27" style="v" sid="NUM 21:27" />因此那些唱歌謠的人說：</para>
  <para style="q1" vid="NUM 21:27">「來<char style="pn">希實本</char>吧！</para>
  <para style="q1" vid="NUM 21:27">願<char style="pn">西宏</char>的城被建造，得堅立！<verse eid="NUM 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28" />有火從<char style="pn">希實本</char>出來，</para>
  <para style="q1" vid="NUM 21:28">有火焰從<char style="pn">西宏</char>的城發出，</para>
  <para style="q1" vid="NUM 21:28">吞噬了<char style="pn">摩押</char>的<char style="pn">亞珥</char>，</para>
  <para style="q1" vid="NUM 21:28">以及<char style="pn">亞嫩</char>河的高壇之主。<verse eid="NUM 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29" />
    <char style="pn">摩押</char>啊，你有禍了！</para>
  <para style="q1" vid="NUM 21:29">
    <char style="pn">基抹</char>的民哪，你們滅亡了！</para>
  <para style="q1" vid="NUM 21:29">
    <char style="pn">基抹</char>任憑自己的兒子逃亡，</para>
  <para style="q1" vid="NUM 21:29">任憑女兒被<char style="pn">亞摩利</char>王<char style="pn">西宏</char>擄去。<verse eid="NUM 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30" />我們射殺了他們，</para>
  <para style="q1" vid="NUM 21:30">
    <char style="pn">希實本</char>滅亡了，直到<char style="pn">迪本</char>；</para>
  <para style="q1" vid="NUM 21:30">我們使它荒涼，</para>
  <para style="q1" vid="NUM 21:30">直到<char style="pn">挪法</char>，直到<char style="pn">米底巴</char>。」<verse eid="NUM 21:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31" />這樣，<char style="pn">以色列</char>就住在<char style="pn">亞摩利</char>人之地。 <verse eid="NUM 21:31" /><verse number="32" style="v" sid="NUM 21:32" /><char style="pn">摩西</char>又派人去窺探<char style="pn">雅謝</char>，隨後攻取<char style="pn">雅謝</char>的村鎮，趕出了那裡的<char style="pn">亞摩利</char>人。<verse eid="NUM 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 21:33" />然後他們轉身，沿著通往<char style="pn">巴珊</char>的路上去。<char style="pn">巴珊</char>王<char style="pn">歐革</char>帶著他的全軍出來迎戰他們，在<char style="pn">伊德賴</char>作戰。 <verse eid="NUM 21:33" /><verse number="34" style="v" sid="NUM 21:34" />耶和華對<char style="pn">摩西</char>說：「不要怕他，我已經把他和他的全軍以及他的領土，都交在你手中了。你要像對待住<char style="pn">希實本</char>的<char style="pn">亞摩利</char>王<char style="pn">西宏</char>那樣對待他。」 <verse eid="NUM 21:34" /><verse number="35" style="v" sid="NUM 21:35" />於是他們擊殺了<char style="pn">歐革</char>和他的兒子們以及他的全軍，沒有給他留下一人存活，並且占有了他的領土。<verse eid="NUM 21:35" /></para>
  <chapter eid="NUM 21" />
  <chapter number="22" style="c" sid="NUM 22" />
  <para style="s">巴勒雇傭巴蘭</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1" />
    <char style="pn">以色列</char>子民起行，在<char style="pn">耶利哥</char>東邊<char style="pn">約旦</char>河對面的<char style="pn">摩押</char>平原紮營。 <verse eid="NUM 22:1" /><verse number="2" style="v" sid="NUM 22:2" /><char style="pn">以色列</char>對<char style="pn">亞摩利</char>人所做的一切，<char style="pn">西撥</char>的兒子<char style="pn">巴勒</char>都看到了。 <verse eid="NUM 22:2" /><verse number="3" style="v" sid="NUM 22:3" /><char style="pn">摩押</char>就非常懼怕這民，因為他們人數眾多。<char style="pn">摩押</char>因<char style="pn">以色列</char>人的緣故而憂心， <verse eid="NUM 22:3" /><verse number="4" style="v" sid="NUM 22:4" />對<char style="pn">米甸</char>的長老們說：「恐怕這部族要吃光我們周圍的一切，就像牛吃光田野的青草一樣。」</para>
  <para style="p" vid="NUM 22:4">那時，<char style="pn">西撥</char>的兒子<char style="pn">巴勒</char>是<char style="pn">摩押</char>王。 <verse eid="NUM 22:4" /><verse number="5" style="v" sid="NUM 22:5" />他就派遣使者到他本族人之地大河<note caller="+" style="f"><char style="fr" closed="false">22:5 </char><char style="ft" closed="false">大河——指幼發拉底河。</char></note>邊的<char style="pn">佩托爾</char>，去見<char style="pn">比珥</char>的兒子<char style="pn">巴蘭</char>，要召他來，說：「你看，有一個民族從<char style="pn">埃及</char>出來，他們遮滿了地面，在我對面駐紮。 <verse eid="NUM 22:5" /><verse number="6" style="v" sid="NUM 22:6" />現在請你來，為我詛咒這民族，因為他們比我強大。這樣，或許我能夠擊敗他們，把他們從這地驅逐出去。因為我知道，你祝福的人必受祝福，你詛咒的人必受詛咒。」<verse eid="NUM 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7" />
    <char style="pn">摩押</char>的長老們和<char style="pn">米甸</char>的長老們，手裡帶著占卜的酬金就去了。他們來見<char style="pn">巴蘭</char>，將<char style="pn">巴勒</char>的話告訴了他。 <verse eid="NUM 22:7" /><verse number="8" style="v" sid="NUM 22:8" /><char style="pn">巴蘭</char>對他們說：「你們今晚在這裡過夜吧。我將照著耶和華吩咐我的，回覆你們。」於是<char style="pn">摩押</char>的首領們就住在<char style="pn">巴蘭</char>那裡。<verse eid="NUM 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9" />神臨到<char style="pn">巴蘭</char>，說：「那些在你這裡的人是誰？」<verse eid="NUM 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10" />
    <char style="pn">巴蘭</char>對神說：「<char style="pn">西撥</char>的兒子<char style="pn">摩押</char>王<char style="pn">巴勒</char>派了人到我這裡來，說： <verse eid="NUM 22:10" /><verse number="11" style="v" sid="NUM 22:11" />『你看，有一個民族從<char style="pn">埃及</char>出來，遮滿了地面。現在請你來，為我詛咒他們，或許我能擊敗他們，驅逐他們。』」<verse eid="NUM 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12" />神對<char style="pn">巴蘭</char>說：「你不可跟著他們去，不可詛咒那民族，因為他們是蒙祝福的。」<verse eid="NUM 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13" />
    <char style="pn">巴蘭</char>清晨起來，對<char style="pn">巴勒</char>的首領們說：「你們回本地去吧，因為耶和華不允許我跟著你們去。」<verse eid="NUM 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14" />
    <char style="pn">摩押</char>的首領們就起身，回到<char style="pn">巴勒</char>那裡，說：「<char style="pn">巴蘭</char>不願跟著我們來。」<verse eid="NUM 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15" />於是，<char style="pn">巴勒</char>再次派遣一批首領，比先前的更多更尊貴。 <verse eid="NUM 22:15" /><verse number="16" style="v" sid="NUM 22:16" />他們來到<char style="pn">巴蘭</char>那裡，對他說：「<char style="pn">西撥</char>的兒子<char style="pn">巴勒</char>如此說：請不要推辭來我這裡， <verse eid="NUM 22:16" /><verse number="17" style="v" sid="NUM 22:17" />我一定使你大得尊榮。無論你告訴我什麼，我都會照辦。來吧，請為我詛咒這民族。」<verse eid="NUM 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18" />
    <char style="pn">巴蘭</char>回答<char style="pn">巴勒</char>的臣僕，說：「即使<char style="pn">巴勒</char>把他滿屋的金銀都給我，我也不能違背我的神耶和華的吩咐，無論做小事還是大事。 <verse eid="NUM 22:18" /><verse number="19" style="v" sid="NUM 22:19" />所以，請你們今晚也住在這裡吧，我要知道耶和華還會對我說什麼。」<verse eid="NUM 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20" />夜間，神臨到<char style="pn">巴蘭</char>對他說：「既然這些人來邀請你，你就起來跟著他們去吧，只是你要做我吩咐你的事。」 <verse eid="NUM 22:20" /><verse number="21" style="v" sid="NUM 22:21" />於是<char style="pn">巴蘭</char>清晨起來，備好驢，跟著<char style="pn">摩押</char>的首領們去了。<verse eid="NUM 22:21" /></para>
  <para style="s">天使和巴蘭的驢子</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 22:22" />因<char style="pn">巴蘭</char>前往，神就怒氣發作。耶和華的一位使者站在路上敵對他。當時，<char style="pn">巴蘭</char>騎在驢上，他的兩個僕人跟隨著他。 <verse eid="NUM 22:22" /><verse number="23" style="v" sid="NUM 22:23" />驢看見耶和華的使者站在路上，手裡有拔出的刀，驢就轉離那條路，走到田野中。<char style="pn">巴蘭</char>打驢，要使牠轉回那條路。 <verse eid="NUM 22:23" /><verse number="24" style="v" sid="NUM 22:24" />於是，耶和華的使者站在葡萄園之間的窄路上，這邊有圍牆，那邊也有圍牆。 <verse eid="NUM 22:24" /><verse number="25" style="v" sid="NUM 22:25" />驢看見耶和華的使者，就擠到牆邊，把<char style="pn">巴蘭</char>的腳也擠到牆邊上，<char style="pn">巴蘭</char>就又打牠。 <verse eid="NUM 22:25" /><verse number="26" style="v" sid="NUM 22:26" />耶和華的使者再上前去，站到左右都無路可轉的狹窄地方。 <verse eid="NUM 22:26" /><verse number="27" style="v" sid="NUM 22:27" />驢看見耶和華的使者，就趴在<char style="pn">巴蘭</char>身下。<char style="pn">巴蘭</char>怒氣發作，用杖打驢。<verse eid="NUM 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 22:28" />於是耶和華開了驢的口，驢對<char style="pn">巴蘭</char>說：「我對你做了什麼，你竟打我這三次？」<verse eid="NUM 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29" />
    <char style="pn">巴蘭</char>對驢說：「因為你捉弄我！要是我手裡有刀，我現在就宰了你。」<verse eid="NUM 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30" />驢對<char style="pn">巴蘭</char>說：「我不就是你至今一直在騎的那頭驢嗎？我往常對你這樣做過嗎？」</para>
  <para style="p" vid="NUM 22:30">
    <char style="pn">巴蘭</char>說：「沒有。」<verse eid="NUM 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31" />耶和華打開<char style="pn">巴蘭</char>的眼睛，他看見耶和華的使者站在路上，手裡拿著拔出的刀，他就俯身，臉伏於地。 <verse eid="NUM 22:31" /><verse number="32" style="v" sid="NUM 22:32" />耶和華的使者對他說：「你為什麼這三次打你的驢呢？看哪，我出來敵對你，因為這條路在我面前是邪僻的。 <verse eid="NUM 22:32" /><verse number="33" style="v" sid="NUM 22:33" />驢看見我，所以從我面前轉開了這三次。如果牠不從我面前轉開，我早已經把你殺了，只讓牠存活。」<verse eid="NUM 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34" />
    <char style="pn">巴蘭</char>對耶和華的使者說：「我有罪了！我實在不知道你站在路上阻擋我。現在如果你不喜悅，我就回去吧。」<verse eid="NUM 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35" />耶和華的使者對<char style="pn">巴蘭</char>說：「你跟著這些人去吧，但只可以說我吩咐你的話。」於是<char style="pn">巴蘭</char>就跟著<char style="pn">巴勒</char>的首領們去了。<verse eid="NUM 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36" />
    <char style="pn">巴勒</char>聽見<char style="pn">巴蘭</char>來了就出去，到<char style="pn">摩押</char>的都城迎接他，這城在<char style="pn">亞嫩</char>河的邊界，在邊界線上。 <verse eid="NUM 22:36" /><verse number="37" style="v" sid="NUM 22:37" /><char style="pn">巴勒</char>對<char style="pn">巴蘭</char>說：「我不是迫切派人去召你來嗎？你為什麼不來我這裡呢？難道我不會真的使你得尊榮嗎？」<verse eid="NUM 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38" />
    <char style="pn">巴蘭</char>對<char style="pn">巴勒</char>說：「看，我已經來到你這裡了。難道現在我就能擅自說什麼嗎？神把什麼話放在我口中，我就說什麼。」<verse eid="NUM 22:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 22:39" />於是<char style="pn">巴蘭</char>跟著<char style="pn">巴勒</char>去，來到了<char style="pn">基列-胡作</char>。 <verse eid="NUM 22:39" /><verse number="40" style="v" sid="NUM 22:40" /><char style="pn">巴勒</char>祭獻了牛羊，然後把肉送給<char style="pn">巴蘭</char>以及與他一起的首領們。 <verse eid="NUM 22:40" /><verse number="41" style="v" sid="NUM 22:41" />到了清晨，<char style="pn">巴勒</char>帶<char style="pn">巴蘭</char>登上<char style="pn">巴力</char>高原，從那裡可以看到<char style="pn">以色列</char>民營地的邊緣。<verse eid="NUM 22:41" /></para>
  <chapter eid="NUM 22" />
  <chapter number="23" style="c" sid="NUM 23" />
  <para style="s">巴蘭領受神諭</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1" />
    <char style="pn">巴蘭</char>對<char style="pn">巴勒</char>說：「請在這裡為我築七座祭壇，並在這裡為我預備七頭公牛、七隻公綿羊。」 <verse eid="NUM 23:1" /><verse number="2" style="v" sid="NUM 23:2" /><char style="pn">巴勒</char>就照著<char style="pn">巴蘭</char>所說的做了。<char style="pn">巴勒</char>和<char style="pn">巴蘭</char>在每座祭壇上獻一頭公牛、一隻公綿羊。 <verse eid="NUM 23:2" /><verse number="3" style="v" sid="NUM 23:3" /><char style="pn">巴蘭</char>對<char style="pn">巴勒</char>說：「你站在你的燔祭旁邊，我要往前去，或許耶和華會臨到，接見我。他指示我什麼信息，我都會告訴你。」然後，<char style="pn">巴蘭</char>走到一片光禿的高地。<verse eid="NUM 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 23:4" />神臨到<char style="pn">巴蘭</char>，<char style="pn">巴蘭</char>對神說：「我預備了七座祭壇，在每座祭壇上獻了一頭公牛、一隻公綿羊。」 <verse eid="NUM 23:4" /><verse number="5" style="v" sid="NUM 23:5" />耶和華就把話放在<char style="pn">巴蘭</char>的口中，說：「你回<char style="pn">巴勒</char>那裡去，要如此如此說。」<verse eid="NUM 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 23:6" />他回到<char style="pn">巴勒</char>那裡，看哪，<char style="pn">巴勒</char>和<char style="pn">摩押</char>全體首領都站在燔祭旁邊。<verse eid="NUM 23:6" /></para>
  <para style="s">第一個神諭</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 23:7" />
    <char style="pn">巴蘭</char>發佈諭示，說：</para>
  <para style="q1" vid="NUM 23:7">「<char style="pn">巴勒</char>請我從<char style="pn">亞蘭</char>來，</para>
  <para style="q1" vid="NUM 23:7">
    <char style="pn">摩押</char>王請我出東山，他說：</para>
  <para style="q1" vid="NUM 23:7">『來吧，為我詛咒<char style="pn">雅各</char>；</para>
  <para style="q1" vid="NUM 23:7">來吧，向<char style="pn">以色列</char>宣判！』<verse eid="NUM 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8" />神沒有詛咒的，我怎麼能詛咒？</para>
  <para style="q1" vid="NUM 23:8">耶和華沒有宣判，我怎麼能宣判？<verse eid="NUM 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9" />我從岩壁的頂峰觀望他，</para>
  <para style="q1" vid="NUM 23:9">從山崗上注視他</para>
  <para style="q1" vid="NUM 23:9">——看，這獨居的民族，</para>
  <para style="q1" vid="NUM 23:9">不把自己算在列國之中。<verse eid="NUM 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10" />誰能數點<char style="pn">雅各</char>的塵沙，</para>
  <para style="q1" vid="NUM 23:10">誰能數算<char style="pn">以色列</char>的煙塵<note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="ft" closed="false">煙塵——或譯作「四分之一」。</char></note>？</para>
  <para style="q1" vid="NUM 23:10">願我死如正直人的死，</para>
  <para style="q1" vid="NUM 23:10">願我的結局像他一樣。」<verse eid="NUM 23:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11" />
    <char style="pn">巴勒</char>對<char style="pn">巴蘭</char>說：「你對我做了什麼事！我帶你來詛咒我的仇敵，看哪，你卻大大祝福他們。」<verse eid="NUM 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12" />
    <char style="pn">巴蘭</char>回答說：「耶和華放在我口中的話，我怎麼能不忠實傳講呢？」<verse eid="NUM 23:12" /></para>
  <para style="s">第二個神諭</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13" />
    <char style="pn">巴勒</char>對<char style="pn">巴蘭</char>說：「來吧，請與我一起到另外一個地方，你可以從那裡看到那民族；只會看到他們營地的邊緣，不能看見全部。請在那裡為我詛咒他們。」 <verse eid="NUM 23:13" /><verse number="14" style="v" sid="NUM 23:14" />於是<char style="pn">巴勒</char>帶<char style="pn">巴蘭</char>到<char style="pn">瑣腓</char>野外，<char style="pn">毗斯迦</char>山頂上<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">瑣腓野外，毗斯迦山頂上——或譯作「毗斯迦山頂的守望臺」。</char></note>。<char style="pn">巴勒</char>築了七座祭壇，在每座祭壇上獻一頭公牛、一隻公綿羊。<verse eid="NUM 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15" />
    <char style="pn">巴蘭</char>對<char style="pn">巴勒</char>說：「你站在你的燔祭旁邊，我要到那邊受接見。」<verse eid="NUM 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16" />耶和華接見<char style="pn">巴蘭</char>，把話語放在他口中，說：「你回<char style="pn">巴勒</char>那裡去，要如此如此說。」<verse eid="NUM 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17" />
    <char style="pn">巴蘭</char>回到<char style="pn">巴勒</char>那裡，看哪，<char style="pn">巴勒</char>站在燔祭旁邊，<char style="pn">摩押</char>的首領們也與他在一起。<char style="pn">巴勒</char>問他：「耶和華說了什麼？」<verse eid="NUM 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18" />
    <char style="pn">巴蘭</char>發佈諭示，說：</para>
  <para style="q1" vid="NUM 23:18">「<char style="pn">巴勒</char>啊，你起來聽著；</para>
  <para style="q1" vid="NUM 23:18">
    <char style="pn">西撥</char>的兒子啊，聽我說！<verse eid="NUM 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19" />神不是會說謊的人，</para>
  <para style="q1" vid="NUM 23:19">也不是會後悔的人類。</para>
  <para style="q1" vid="NUM 23:19">難道他說了會不做嗎？</para>
  <para style="q1" vid="NUM 23:19">他發話了，會不成就嗎？<verse eid="NUM 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20" />看哪，我奉命祝福；</para>
  <para style="q1" vid="NUM 23:20">神已經祝福了，</para>
  <para style="q1" vid="NUM 23:20">我不能翻轉。<verse eid="NUM 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21" />神使<char style="pn">雅各</char>中看不到禍患，</para>
  <para style="q1" vid="NUM 23:21">使<char style="pn">以色列</char>中看不見苦難。</para>
  <para style="q1" vid="NUM 23:21">他的神耶和華與他同在，</para>
  <para style="q1" vid="NUM 23:21">歡呼君王的聲音在他們中間。<verse eid="NUM 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22" />神把他們從<char style="pn">埃及</char>領出來，</para>
  <para style="q1" vid="NUM 23:22">像野牛的角為他們爭戰<note caller="+" style="f"><char style="fr" closed="false">23:22 </char><char style="ft" closed="false">爭戰——輔助詞語。</char></note>。<verse eid="NUM 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23" />實在沒有法術對付<char style="pn">雅各</char>，</para>
  <para style="q1" vid="NUM 23:23">也沒有占卜對付<char style="pn">以色列</char>，</para>
  <para style="q1" vid="NUM 23:23">每當論到<char style="pn">雅各</char>，</para>
  <para style="q1" vid="NUM 23:23">論到<char style="pn">以色列</char>，人都會說：</para>
  <para style="q1" vid="NUM 23:23">『神成就了何等的事啊！』<verse eid="NUM 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24" />看，這民族起來如母獅，</para>
  <para style="q1" vid="NUM 23:24">挺身像公獅。</para>
  <para style="q1" vid="NUM 23:24">它不吞吃獵物，不喝被殺之人的血，</para>
  <para style="q1" vid="NUM 23:24">就絕不躺下。」<verse eid="NUM 23:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25" />
    <char style="pn">巴勒</char>對<char style="pn">巴蘭</char>說：「既然你一點也不詛咒他們，那就一點也不要祝福他們。」<verse eid="NUM 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26" />
    <char style="pn">巴蘭</char>回答<char style="pn">巴勒</char>說：「我不是告訴過你，耶和華所說的一切我必須遵行嗎？」<verse eid="NUM 23:26" /></para>
  <para style="s">第三個神諭</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27" />於是<char style="pn">巴勒</char>對<char style="pn">巴蘭</char>說：「來，請讓我帶你到另外一個地方。或許在神的眼中，你從那裡為我詛咒他們是合宜的。」 <verse eid="NUM 23:27" /><verse number="28" style="v" sid="NUM 23:28" /><char style="pn">巴勒</char>就帶<char style="pn">巴蘭</char>到<char style="pn">毗珥</char>山頂，在那裡可以俯看荒漠。<verse eid="NUM 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29" />
    <char style="pn">巴蘭</char>對<char style="pn">巴勒</char>說：「請在這裡為我築七座祭壇，並在這裡為我預備七頭公牛、七隻公綿羊。」 <verse eid="NUM 23:29" /><verse number="30" style="v" sid="NUM 23:30" /><char style="pn">巴勒</char>就照著<char style="pn">巴蘭</char>所說的做了，在每座祭壇上獻一頭公牛、一隻公綿羊。<verse eid="NUM 23:30" /></para>
  <chapter eid="NUM 23" />
  <chapter number="24" style="c" sid="NUM 24" />
  <para style="nb">
    <verse number="1" style="v" sid="NUM 24:1" />
    <char style="pn">巴蘭</char>看到祝福<char style="pn">以色列</char>能取悅耶和華，就沒有像前幾次那樣嘗試用法術，而是把臉轉向曠野。 <verse eid="NUM 24:1" /><verse number="2" style="v" sid="NUM 24:2" /><char style="pn">巴蘭</char>舉目，看見<char style="pn">以色列</char>按各自的支派安居，神的靈就臨到他身上。 <verse eid="NUM 24:2" /><verse number="3" style="v" sid="NUM 24:3" />他發佈諭示，說：</para>
  <para style="q1" vid="NUM 24:3">「這是<char style="pn">比珥</char>的兒子<char style="pn">巴蘭</char>的宣告，</para>
  <para style="q1" vid="NUM 24:3">眼睛開啟之人的宣告；<verse eid="NUM 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4" />這聽到神的話語之人，</para>
  <para style="q1" vid="NUM 24:4">看到全能者的異象，</para>
  <para style="q1" vid="NUM 24:4">俯伏著，雙眼被開啟，</para>
  <para style="q1" vid="NUM 24:4">他的宣告如下：<verse eid="NUM 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5" />
    <char style="pn">雅各</char>啊，你的帳篷多麼美好；</para>
  <para style="q1" vid="NUM 24:5">
    <char style="pn">以色列</char>啊，你的帳幕何等華美！<verse eid="NUM 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6" />它們像綿延的溪谷，</para>
  <para style="q1" vid="NUM 24:6">像河邊的園林；</para>
  <para style="q1" vid="NUM 24:6">像耶和華栽種的沉香樹，</para>
  <para style="q1" vid="NUM 24:6">像水邊的香柏樹。<verse eid="NUM 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7" />露水從他的枝幹滴落<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">露水從他的枝幹滴落——或譯作「水從他的桶裡流出」。</char></note>，</para>
  <para style="q1" vid="NUM 24:7">他的根<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">根——或譯作「種子」。</char></note>在水源豐富之地；</para>
  <para style="q1" vid="NUM 24:7">他的君王必高過<char style="pn">亞甲</char>，</para>
  <para style="q1" vid="NUM 24:7">他的王權必被高舉。<verse eid="NUM 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8" />神把他從<char style="pn">埃及</char>領出來，</para>
  <para style="q1" vid="NUM 24:8">像野牛的角為他爭戰<note caller="+" style="f"><char style="fr" closed="false">24:8 </char><char style="ft" closed="false">爭戰——輔助詞語。</char></note>。</para>
  <para style="q1" vid="NUM 24:8">他必吞噬那些敵對他的國家，</para>
  <para style="q1" vid="NUM 24:8">壓碎他們的骨頭，</para>
  <para style="q1" vid="NUM 24:8">用箭射透他們。<verse eid="NUM 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9" />他屈身躺臥如公獅和母獅，</para>
  <para style="q1" vid="NUM 24:9">誰敢招惹他？</para>
  <para style="q1" vid="NUM 24:9">凡祝福你的，必受祝福；</para>
  <para style="q1" vid="NUM 24:9">凡詛咒你的，必受詛咒！」<verse eid="NUM 24:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10" />
    <char style="pn">巴勒</char>就對<char style="pn">巴蘭</char>發怒，拍掌對<char style="pn">巴蘭</char>說：「我召你來是為了詛咒我的仇敵，看哪，你竟然祝福了他們這三次！ <verse eid="NUM 24:10" /><verse number="11" style="v" sid="NUM 24:11" />現在趕緊回你本地去吧！我曾說要使你大得尊榮，看哪，耶和華卻阻擋你得尊榮。」<verse eid="NUM 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12" />
    <char style="pn">巴蘭</char>回答<char style="pn">巴勒</char>：「我不是告訴過你派來見我的那些使者嗎？我說： <verse eid="NUM 24:12" /><verse number="13" style="v" sid="NUM 24:13" />即使<char style="pn">巴勒</char>把他滿屋的金銀給我，我也不能違背耶和華的吩咐，憑自己的心意做好做歹。耶和華說什麼，我就說什麼。 <verse eid="NUM 24:13" /><verse number="14" style="v" sid="NUM 24:14" />現在，看哪，我將要回我的族人那裡去了。請讓我告訴你，日後那民族會怎樣對待你的子民。」<verse eid="NUM 24:14" /></para>
  <para style="s">第四個神諭</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 24:15" />於是<char style="pn">巴蘭</char>發佈諭示，說：</para>
  <para style="q1" vid="NUM 24:15">「這是<char style="pn">比珥</char>的兒子<char style="pn">巴蘭</char>的宣告，</para>
  <para style="q1" vid="NUM 24:15">眼睛開啟之人的宣告；<verse eid="NUM 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16" />這聽到神的話語之人，</para>
  <para style="q1" vid="NUM 24:16">明白至高者的知識，</para>
  <para style="q1" vid="NUM 24:16">看到全能者的異象，</para>
  <para style="q1" vid="NUM 24:16">俯伏著，雙眼被開啟，</para>
  <para style="q1" vid="NUM 24:16">他的宣告如下：<verse eid="NUM 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17" />我看見他，卻不是現在；</para>
  <para style="q1" vid="NUM 24:17">我望見他，卻不在近處。</para>
  <para style="q1" vid="NUM 24:17">有一顆星從<char style="pn">雅各</char>發出，</para>
  <para style="q1" vid="NUM 24:17">有一根杖從<char style="pn">以色列</char>興起；</para>
  <para style="q1" vid="NUM 24:17">他將擊碎<char style="pn">摩押</char>的額角，</para>
  <para style="q1" vid="NUM 24:17">擊潰所有的<char style="pn">謝特</char>人<note caller="+" style="f"><char style="fr" closed="false">24:17 </char><char style="ft" closed="false">擊潰所有的謝特人——有古卷作「打破所有謝特人的頭顱」；參《耶利米書》48:45。</char></note>。<verse eid="NUM 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18" />
    <char style="pn">以東</char>將成為他的領地，</para>
  <para style="q1" vid="NUM 24:18">他的仇敵<char style="pn">西珥</char>將被他占領，</para>
  <para style="q1" vid="NUM 24:18">
    <char style="pn">以色列</char>必做大能的事。<verse eid="NUM 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19" />有一位出自<char style="pn">雅各</char>的必執掌大權，</para>
  <para style="q1" vid="NUM 24:19">他將滅絕城裡的倖存者。」<verse eid="NUM 24:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20" />然後他觀看<char style="pn">亞瑪力</char>，發佈諭示說：</para>
  <para style="q1" vid="NUM 24:20">「<char style="pn">亞瑪力</char>是列國之首，</para>
  <para style="q1" vid="NUM 24:20">但他最終歸向滅亡。」<verse eid="NUM 24:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21" />
    <char style="pn">巴蘭</char>又觀看<char style="pn">基尼</char>人，發佈諭示說：</para>
  <para style="q1" vid="NUM 24:21">「你的住處穩固，</para>
  <para style="q1" vid="NUM 24:21">你在岩石中築巢。<verse eid="NUM 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22" />然而<char style="pn">基尼</char>必被燒毀，</para>
  <para style="q1" vid="NUM 24:22">最終<char style="pn">亞述</char>要把你擄去。」<verse eid="NUM 24:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23" />
    <char style="pn">巴蘭</char>又發佈諭示，說：</para>
  <para style="q1" vid="NUM 24:23">「有禍了！</para>
  <para style="q1" vid="NUM 24:23">神定意如此，誰能存活呢？<verse eid="NUM 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 24:24" />有船隊從<char style="pn">基提</char>海岸而來，</para>
  <para style="q1" vid="NUM 24:24">要制伏<char style="pn">亞述</char>、制伏<char style="pn">希伯</char>，</para>
  <para style="q1" vid="NUM 24:24">但它也歸向滅亡。」<verse eid="NUM 24:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25" />然後，<char style="pn">巴蘭</char>起身離開，回本地去，<char style="pn">巴勒</char>也上路回去了。<verse eid="NUM 24:25" /></para>
  <chapter eid="NUM 24" />
  <chapter number="25" style="c" sid="NUM 25" />
  <para style="s">以色列敬拜巴力</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1" />
    <char style="pn">以色列</char>住在<char style="pn">什亭</char>的時候，民眾開始與<char style="pn">摩押</char>女子行淫。 <verse eid="NUM 25:1" /><verse number="2" style="v" sid="NUM 25:2" />這些女子邀請民眾參加她們神明的祭祀，民眾吃了祭物，又向她們的神明下拜。 <verse eid="NUM 25:2" /><verse number="3" style="v" sid="NUM 25:3" />這樣，<char style="pn">以色列</char>與<char style="pn">毗珥</char>的<char style="pn">巴力</char>聯合，耶和華的怒氣就向<char style="pn">以色列</char>發作。 <verse eid="NUM 25:3" /><verse number="4" style="v" sid="NUM 25:4" />耶和華對<char style="pn">摩西</char>說：「你把民眾的首領都帶來，在日光之下，在耶和華面前把他們處死示眾，好讓耶和華的烈怒轉離<char style="pn">以色列</char>。」<verse eid="NUM 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 25:5" />
    <char style="pn">摩西</char>就對<char style="pn">以色列</char>的審判官們說：「你們各人要把你們當中與<char style="pn">毗珥</char>的<char style="pn">巴力</char>聯合的人殺掉。」<verse eid="NUM 25:5" /></para>
  <para style="s">非尼哈果斷行動</para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6" />
    <char style="pn">摩西</char>和全體<char style="pn">以色列</char>會眾正在會幕的入口哭泣時，看哪，<char style="pn">以色列</char>子民中有一個人前來，在他們眼前把一個<char style="pn">米甸</char>女子帶到弟兄們那裡。 <verse eid="NUM 25:6" /><verse number="7" style="v" sid="NUM 25:7" />祭司<char style="pn">亞倫</char>的孫子、<char style="pn">以利亞撒</char>的兒子<char style="pn">非尼哈</char>看見了，就從會眾當中起身，手拿長矛， <verse eid="NUM 25:7" /><verse number="8" style="v" sid="NUM 25:8" />跟在那<char style="pn">以色列</char>人後面進了帳篷，用長矛把那<char style="pn">以色列</char>人和女子兩人刺透，一直刺入女子的肚腹。這樣，瘟疫就從<char style="pn">以色列</char>子民中止住了。 <verse eid="NUM 25:8" /><verse number="9" style="v" sid="NUM 25:9" />當時死於瘟疫的，有兩萬四千人。<verse eid="NUM 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 25:10" /><verse number="11" style="v" sid="NUM 25:11" />「祭司<char style="pn">亞倫</char>的孫子、<char style="pn">以利亞撒</char>的兒子<char style="pn">非尼哈</char>使我的怒火轉離了<char style="pn">以色列</char>子民，因為他在他們中間因我的妒火而發熱心，使我沒有在妒火中滅絕<char style="pn">以色列</char>子民。 <verse eid="NUM 25:11" /><verse number="12" style="v" sid="NUM 25:12" />因此你要告訴他：看哪，我把我的平安之約賜給他， <verse eid="NUM 25:12" /><verse number="13" style="v" sid="NUM 25:13" />這約將成為他和他後裔永遠擔任祭司的約，因為他為他的神而嫉憤，為<char style="pn">以色列</char>子民贖了罪。」<verse eid="NUM 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14" />那個與<char style="pn">米甸</char>女子一同被殺的<char style="pn">以色列</char>人，名叫<char style="pn">澤姆利</char>，是<char style="pn">薩魯</char>的兒子，是<char style="pn">西緬</char>一個宗族的領袖。 <verse eid="NUM 25:14" /><verse number="15" style="v" sid="NUM 25:15" />那個被殺的<char style="pn">米甸</char>女子名叫<char style="pn">柯茲比</char>，是<char style="pn">蘇珥</char>的女兒，<char style="pn">蘇珥</char>是<char style="pn">米甸</char>一個宗族的首領。<verse eid="NUM 25:15" /></para>
  <para style="s">報復米甸人</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 25:16" /><verse number="17" style="v" sid="NUM 25:17" />「你要擾害<char style="pn">米甸</char>人，擊殺他們。 <verse eid="NUM 25:17" /><verse number="18" style="v" sid="NUM 25:18" />因為他們以詭計擾害你們，就是在<char style="pn">毗珥</char>的事情上，以及他們的姐妹、<char style="pn">米甸</char>領袖的女兒<char style="pn">柯茲比</char>的事情上行詭詐對付你們；這<char style="pn">柯茲比</char>，已經在瘟疫的日子裡，因<char style="pn">毗珥</char>的事情而被殺。」<verse eid="NUM 25:18" /></para>
  <chapter eid="NUM 25" />
  <chapter number="26" style="c" sid="NUM 26" />
  <para style="s">第二次人口普查</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1" />瘟疫之後，耶和華告訴<char style="pn">摩西</char>和祭司<char style="pn">亞倫</char>的兒子<char style="pn">以利亞撒</char>，說： <verse eid="NUM 26:1" /><verse number="2" style="v" sid="NUM 26:2" />「你們要按著父家，統計全體<char style="pn">以色列</char>會眾，就是<char style="pn">以色列</char>中二十歲以上所有能出戰的男子的人數。」<verse eid="NUM 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 26:3" />於是，在<char style="pn">耶利哥</char>東邊<char style="pn">約旦</char>河對面的<char style="pn">摩押</char>平原，<char style="pn">摩西</char>和祭司<char style="pn">以利亞撒</char>吩咐<char style="pn">以色列</char>人說， <verse eid="NUM 26:3" /><verse number="4" style="v" sid="NUM 26:4" />要統計二十歲以上的男子，正如耶和華向<char style="pn">摩西</char>和出<char style="pn">埃及</char>地的<char style="pn">以色列</char>子民所指示的。<verse eid="NUM 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 26:5" />
    <char style="pn">魯本</char>是<char style="pn">以色列</char>的長子。</para>
  <para style="q1" vid="NUM 26:5">
    <char style="pn">魯本</char>的子孫有：</para>
  <para style="q1" vid="NUM 26:5">屬<char style="pn">哈諾</char>的，<char style="pn">哈諾</char>家族；</para>
  <para style="q1" vid="NUM 26:5">屬<char style="pn">法路</char>的，<char style="pn">法路</char>家族；<verse eid="NUM 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 26:6" />屬<char style="pn">希斯倫</char>的，<char style="pn">希斯倫</char>家族；</para>
  <para style="q1" vid="NUM 26:6">屬<char style="pn">迦米</char>的，<char style="pn">迦米</char>家族。<verse eid="NUM 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 26:7" />以上是<char style="pn">魯本</char>的家族，</para>
  <para style="q1" vid="NUM 26:7">他們被數點的，共四萬三千七百三十人。<verse eid="NUM 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 26:8" />
    <char style="pn">法路</char>的兒子是<char style="pn">以利押</char>。<verse eid="NUM 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 26:9" />
    <char style="pn">以利押</char>的兒子是<char style="pn">尼姆利</char>、<char style="pn">大坍</char>、<char style="pn">亞比蘭</char>。</para>
  <para style="b" vid="NUM 26:9" />
  <para style="p" vid="NUM 26:9">這<char style="pn">大坍</char>和<char style="pn">亞比蘭</char>是會眾裡選召出來的領袖，在<char style="pn">可拉</char>同黨對抗耶和華的時候，與他們一起對抗<char style="pn">摩西</char>和<char style="pn">亞倫</char>。 <verse eid="NUM 26:9" /><verse number="10" style="v" sid="NUM 26:10" />那時地張開口，把他們和<char style="pn">可拉</char>一起吞掉了，那些同黨也死了，火吞噬了兩百五十人。這樣，他們就成為一個鑒戒。 <verse eid="NUM 26:10" /><verse number="11" style="v" sid="NUM 26:11" />然而，<char style="pn">可拉</char>的子孫並沒有全都死掉。<verse eid="NUM 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NUM 26:12" />
    <char style="pn">西緬</char>的子孫，按家族有：</para>
  <para style="q1" vid="NUM 26:12">屬<char style="pn">尼姆利</char>的，<char style="pn">尼姆利</char>家族；</para>
  <para style="q1" vid="NUM 26:12">屬<char style="pn">雅憫</char>的，<char style="pn">雅憫</char>家族；</para>
  <para style="q1" vid="NUM 26:12">屬<char style="pn">雅斤</char>的，<char style="pn">雅斤</char>家族；<verse eid="NUM 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NUM 26:13" />屬<char style="pn">謝拉</char>的，<char style="pn">謝拉</char>家族；</para>
  <para style="q1" vid="NUM 26:13">屬<char style="pn">掃羅</char>的，<char style="pn">掃羅</char>家族。<verse eid="NUM 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NUM 26:14" />以上是<char style="pn">西緬</char>的家族，</para>
  <para style="q1" vid="NUM 26:14">共兩萬兩千兩百人。<verse eid="NUM 26:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="NUM 26:15" />
    <char style="pn">迦得</char>的子孫，按家族有：</para>
  <para style="q1" vid="NUM 26:15">屬<char style="pn">洗分</char>的，<char style="pn">洗分</char>家族；</para>
  <para style="q1" vid="NUM 26:15">屬<char style="pn">哈基</char>的，<char style="pn">哈基</char>家族；</para>
  <para style="q1" vid="NUM 26:15">屬<char style="pn">書尼</char>的，<char style="pn">書尼</char>家族；<verse eid="NUM 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 26:16" />屬<char style="pn">阿茲尼</char>的，<char style="pn">阿茲尼</char>家族；</para>
  <para style="q1" vid="NUM 26:16">屬<char style="pn">伊利</char>的，<char style="pn">伊利</char>家族；<verse eid="NUM 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 26:17" />屬<char style="pn">阿羅迪</char>的，<char style="pn">阿羅迪</char>家族；</para>
  <para style="q1" vid="NUM 26:17">屬<char style="pn">阿爾耶利</char>的，<char style="pn">阿爾耶利</char>家族。<verse eid="NUM 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 26:18" />以上是<char style="pn">迦得</char>子孫的家族，</para>
  <para style="q1" vid="NUM 26:18">他們被數點的，</para>
  <para style="q1" vid="NUM 26:18">共四萬零五百人。<verse eid="NUM 26:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="NUM 26:19" />
    <char style="pn">猶大</char>的兒子是<char style="pn">珥</char>和<char style="pn">俄南</char>，</para>
  <para style="q1" vid="NUM 26:19">但<char style="pn">珥</char>和<char style="pn">俄南</char>已經死在<char style="pn">迦南</char>地。<verse eid="NUM 26:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 26:20" />
    <char style="pn">猶大</char>的子孫，按家族有：</para>
  <para style="q1" vid="NUM 26:20">屬<char style="pn">示拉</char>的，<char style="pn">示拉</char>家族；</para>
  <para style="q1" vid="NUM 26:20">屬<char style="pn">法勒斯</char>的，<char style="pn">法勒斯</char>家族；</para>
  <para style="q1" vid="NUM 26:20">屬<char style="pn">謝拉</char>的，<char style="pn">謝拉</char>家族；<verse eid="NUM 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 26:21" />
    <char style="pn">法勒斯</char>的子孫有：</para>
  <para style="q1" vid="NUM 26:21">屬<char style="pn">希斯倫</char>的，<char style="pn">希斯倫</char>家族；</para>
  <para style="q1" vid="NUM 26:21">屬<char style="pn">哈姆勒</char>的，<char style="pn">哈姆勒</char>家族。<verse eid="NUM 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 26:22" />以上是<char style="pn">猶大</char>的家族，</para>
  <para style="q1" vid="NUM 26:22">按著被數點的，</para>
  <para style="q1" vid="NUM 26:22">共七萬六千五百人。<verse eid="NUM 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="NUM 26:23" />
    <char style="pn">以薩迦</char>的子孫，按家族有：</para>
  <para style="q1" vid="NUM 26:23">屬<char style="pn">陀拉</char>的，<char style="pn">陀拉</char>家族；</para>
  <para style="q1" vid="NUM 26:23">屬<char style="pn">普瓦</char>的，<char style="pn">普瓦</char>家族；<verse eid="NUM 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 26:24" />屬<char style="pn">雅實布</char>的，<char style="pn">雅實布</char>家族；</para>
  <para style="q1" vid="NUM 26:24">屬<char style="pn">希姆崙</char>的，<char style="pn">希姆崙</char>家族；<verse eid="NUM 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 26:25" />以上是<char style="pn">以薩迦</char>的家族，</para>
  <para style="q1" vid="NUM 26:25">他們被數點的，</para>
  <para style="q1" vid="NUM 26:25">共六萬四千三百人。<verse eid="NUM 26:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="NUM 26:26" />
    <char style="pn">西布倫</char>的子孫，按家族有：</para>
  <para style="q1" vid="NUM 26:26">屬<char style="pn">西列德</char>的，<char style="pn">西列德</char>家族；</para>
  <para style="q1" vid="NUM 26:26">屬<char style="pn">埃隆</char>的，<char style="pn">埃隆</char>家族；</para>
  <para style="q1" vid="NUM 26:26">屬<char style="pn">雅赫列</char>的，<char style="pn">雅赫列</char>家族。<verse eid="NUM 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="NUM 26:27" />以上是<char style="pn">西布倫</char>的家族，</para>
  <para style="q1" vid="NUM 26:27">他們被數點的，</para>
  <para style="q1" vid="NUM 26:27">共六萬零五百人。<verse eid="NUM 26:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="NUM 26:28" />
    <char style="pn">約瑟</char>的兒子，按家族有：</para>
  <para style="q1" vid="NUM 26:28">
    <char style="pn">瑪拿西</char>和<char style="pn">以法蓮</char>。<verse eid="NUM 26:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 26:29" />
    <char style="pn">瑪拿西</char>的子孫有：</para>
  <para style="q1" vid="NUM 26:29">屬<char style="pn">瑪吉</char>的，<char style="pn">瑪吉</char>家族。</para>
  <para style="q1" vid="NUM 26:29">
    <char style="pn">瑪吉</char>生了<char style="pn">基列</char>，</para>
  <para style="q1" vid="NUM 26:29">屬<char style="pn">基列</char>的有<char style="pn">基列</char>家族。<verse eid="NUM 26:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 26:30" />
    <char style="pn">基列</char>的子孫如下：</para>
  <para style="q1" vid="NUM 26:30">屬<char style="pn">伊以謝</char>的，<char style="pn">伊以謝</char>家族；</para>
  <para style="q1" vid="NUM 26:30">屬<char style="pn">希勒</char>的，<char style="pn">希勒</char>家族；<verse eid="NUM 26:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="NUM 26:31" />屬<char style="pn">亞斯列</char>的，<char style="pn">亞斯列</char>家族；</para>
  <para style="q1" vid="NUM 26:31">屬<char style="pn">示劍</char>的，<char style="pn">示劍</char>家族；<verse eid="NUM 26:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="NUM 26:32" />屬<char style="pn">謝米達</char>的，<char style="pn">謝米達</char>家族；</para>
  <para style="q1" vid="NUM 26:32">屬<char style="pn">希弗</char>的，<char style="pn">希弗</char>家族。<verse eid="NUM 26:32" /></para>
  <para style="b" />
  <para style="p">
    <verse number="33" style="v" sid="NUM 26:33" />
    <char style="pn">希弗</char>的兒子<char style="pn">西羅非哈</char>沒有兒子，只有女兒。<char style="pn">西羅非哈</char>的女兒名字是<char style="pn">瑪拉</char>、<char style="pn">挪阿</char>、<char style="pn">霍格拉</char>、<char style="pn">米爾卡</char>、<char style="pn">提爾撒</char>。<verse eid="NUM 26:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="NUM 26:34" />以上是<char style="pn">瑪拿西</char>的家族，</para>
  <para style="q1" vid="NUM 26:34">他們被數點的，</para>
  <para style="q1" vid="NUM 26:34">共五萬兩千七百人。<verse eid="NUM 26:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="NUM 26:35" />
    <char style="pn">以法蓮</char>的子孫如下，按家族有：</para>
  <para style="q1" vid="NUM 26:35">屬<char style="pn">書提拉</char>的，<char style="pn">書提拉</char>家族；</para>
  <para style="q1" vid="NUM 26:35">屬<char style="pn">比結</char>的，<char style="pn">比結</char>家族；</para>
  <para style="q1" vid="NUM 26:35">屬<char style="pn">塔罕</char>的，<char style="pn">塔罕</char>家族。<verse eid="NUM 26:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="NUM 26:36" />
    <char style="pn">書提拉</char>的子孫有：</para>
  <para style="q1" vid="NUM 26:36">屬<char style="pn">伊蘭</char>的，<char style="pn">伊蘭</char>家族。<verse eid="NUM 26:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="NUM 26:37" />以上是<char style="pn">以法蓮</char>子孫的家族，</para>
  <para style="q1" vid="NUM 26:37">他們被數點的，</para>
  <para style="q1" vid="NUM 26:37">共三萬兩千五百人。</para>
  <para style="q1" vid="NUM 26:37">按家族，這些都是<char style="pn">約瑟</char>的子孫。<verse eid="NUM 26:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="NUM 26:38" />
    <char style="pn">便雅憫</char>的子孫，按家族有：</para>
  <para style="q1" vid="NUM 26:38">屬<char style="pn">比拉</char>的，<char style="pn">比拉</char>家族；</para>
  <para style="q1" vid="NUM 26:38">屬<char style="pn">阿實別</char>的，<char style="pn">阿實別</char>家族；</para>
  <para style="q1" vid="NUM 26:38">屬<char style="pn">阿希蘭</char>的，<char style="pn">阿希蘭</char>家族；<verse eid="NUM 26:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="NUM 26:39" />屬<char style="pn">謝弗番</char>的，<char style="pn">謝弗番</char>家族；</para>
  <para style="q1" vid="NUM 26:39">屬<char style="pn">戶番</char>的，<char style="pn">戶番</char>家族。<verse eid="NUM 26:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="NUM 26:40" />
    <char style="pn">比拉</char>的兒子是<char style="pn">阿爾德</char>、<char style="pn">奈曼</char>，他們有：</para>
  <para style="q1" vid="NUM 26:40">屬<char style="pn">阿爾德</char>的，<char style="pn">阿爾德</char>家族；</para>
  <para style="q1" vid="NUM 26:40">屬<char style="pn">奈曼</char>的，<char style="pn">奈曼</char>家族。<verse eid="NUM 26:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="NUM 26:41" />以上是<char style="pn">便雅憫</char>的子孫，</para>
  <para style="q1" vid="NUM 26:41">他們按家族被數點的，</para>
  <para style="q1" vid="NUM 26:41">共四萬五千六百人。<verse eid="NUM 26:41" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="42" style="v" sid="NUM 26:42" />
    <char style="pn">但</char>的子孫如下，按家族有：</para>
  <para style="q1" vid="NUM 26:42">屬<char style="pn">書含</char>的，<char style="pn">書含</char>家族。</para>
  <para style="q1" vid="NUM 26:42">按家族，這就是<char style="pn">但</char>的家族。<verse eid="NUM 26:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="NUM 26:43" />
    <char style="pn">書含</char>全家族被數點的，</para>
  <para style="q1" vid="NUM 26:43">共六萬四千四百人。<verse eid="NUM 26:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="NUM 26:44" />
    <char style="pn">亞設</char>的子孫，按家族有：</para>
  <para style="q1" vid="NUM 26:44">屬<char style="pn">伊姆納</char>的，<char style="pn">伊姆納</char>家族；</para>
  <para style="q1" vid="NUM 26:44">屬<char style="pn">伊施韋</char>的，<char style="pn">伊施韋</char>家族；</para>
  <para style="q1" vid="NUM 26:44">屬<char style="pn">比利亞</char>的，<char style="pn">比利亞</char>家族；<verse eid="NUM 26:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="NUM 26:45" />
    <char style="pn">比利亞</char>的子孫有：</para>
  <para style="q1" vid="NUM 26:45">屬<char style="pn">希伯</char>的，<char style="pn">希伯</char>家族；</para>
  <para style="q1" vid="NUM 26:45">屬<char style="pn">瑪結</char>的，<char style="pn">瑪結</char>家族。<verse eid="NUM 26:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="NUM 26:46" />
    <char style="pn">亞設</char>的女兒名叫<char style="pn">西拉</char>。<verse eid="NUM 26:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="NUM 26:47" />以上是<char style="pn">亞設</char>子孫的家族，</para>
  <para style="q1" vid="NUM 26:47">他們被數點的，</para>
  <para style="q1" vid="NUM 26:47">共五萬三千四百人。<verse eid="NUM 26:47" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="NUM 26:48" />
    <char style="pn">拿弗他利</char>的子孫，按家族有：</para>
  <para style="q1" vid="NUM 26:48">屬<char style="pn">雅赫茲列</char>的，<char style="pn">雅赫茲列</char>家族；</para>
  <para style="q1" vid="NUM 26:48">屬<char style="pn">古尼</char>的，<char style="pn">古尼</char>家族；<verse eid="NUM 26:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="NUM 26:49" />屬<char style="pn">耶則爾</char>的，<char style="pn">耶則爾</char>家族；</para>
  <para style="q1" vid="NUM 26:49">屬<char style="pn">謝勒姆</char>的，<char style="pn">謝勒姆</char>家族。<verse eid="NUM 26:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="NUM 26:50" />以上是<char style="pn">拿弗他利</char>的家族，</para>
  <para style="q1" vid="NUM 26:50">他們按家族被數點的，</para>
  <para style="q1" vid="NUM 26:50">共四萬五千四百人。<verse eid="NUM 26:50" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="51" style="v" sid="NUM 26:51" />以上就是被數點的<char style="pn">以色列</char>子孫，</para>
  <para style="q1" vid="NUM 26:51">共六十萬零一千七百三十人。<verse eid="NUM 26:51" /></para>
  <para style="b" />
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 26:52" /><verse number="53" style="v" sid="NUM 26:53" />「要按名單，把那地分給這些人為繼業。 <verse eid="NUM 26:53" /><verse number="54" style="v" sid="NUM 26:54" />人多的，你要多給他們產業；人少的，你要少給他們產業；他們各自要按著被數點的人口分得繼業。 <verse eid="NUM 26:54" /><verse number="55" style="v" sid="NUM 26:55" />只是他們要以抽籤的方式分地，按自己父系支派的名字得繼業。 <verse eid="NUM 26:55" /><verse number="56" style="v" sid="NUM 26:56" />各支派無論人多人少，都要按所抽的籤分配繼業。」<verse eid="NUM 26:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="NUM 26:57" />以下是被數點的<char style="pn">利未</char>人，按家族有：</para>
  <para style="q1" vid="NUM 26:57">屬<char style="pn">革順</char>的，<char style="pn">革順</char>家族；</para>
  <para style="q1" vid="NUM 26:57">屬<char style="pn">哥轄</char>的，<char style="pn">哥轄</char>家族；</para>
  <para style="q1" vid="NUM 26:57">屬<char style="pn">米拉利</char>的，<char style="pn">米拉利</char>家族。<verse eid="NUM 26:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="NUM 26:58" />
    <char style="pn">利未</char>的家族有：</para>
  <para style="q1" vid="NUM 26:58">
    <char style="pn">立尼</char>家族、</para>
  <para style="q1" vid="NUM 26:58">
    <char style="pn">希伯倫</char>家族、</para>
  <para style="q1" vid="NUM 26:58">
    <char style="pn">瑪賀利</char>家族、</para>
  <para style="q1" vid="NUM 26:58">
    <char style="pn">穆希</char>家族、</para>
  <para style="q1" vid="NUM 26:58">
    <char style="pn">可拉</char>家族。</para>
  <para style="b" vid="NUM 26:58" />
  <para style="p" vid="NUM 26:58">
    <char style="pn">哥轄</char>生了<char style="pn">阿姆蘭</char>。 <verse eid="NUM 26:58" /><verse number="59" style="v" sid="NUM 26:59" /><char style="pn">阿姆蘭</char>的妻子名叫<char style="pn">約基別</char>，是<char style="pn">利未</char>在<char style="pn">埃及</char>所生的女兒；她為<char style="pn">阿姆蘭</char>生了<char style="pn">亞倫</char>、<char style="pn">摩西</char>和他們的姐姐<char style="pn">米利暗</char>。 <verse eid="NUM 26:59" /><verse number="60" style="v" sid="NUM 26:60" /><char style="pn">亞倫</char>生了<char style="pn">納達布</char>、<char style="pn">亞比戶</char>、<char style="pn">以利亞撒</char>、<char style="pn">以塔瑪爾</char>， <verse eid="NUM 26:60" /><verse number="61" style="v" sid="NUM 26:61" /><char style="pn">納達布</char>和<char style="pn">亞比戶</char>向耶和華獻上違規的火，就死了。 <verse eid="NUM 26:61" /><verse number="62" style="v" sid="NUM 26:62" /><char style="pn">利未</char>人被數點的所有一個月以上的男性，有兩萬三千人。他們並沒有與<char style="pn">以色列</char>子孫一起被數點，因為他們不在<char style="pn">以色列</char>子孫中分得繼業。<verse eid="NUM 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63" />這些就是<char style="pn">摩西</char>和祭司<char style="pn">以利亞撒</char>數點的人，他們在<char style="pn">耶利哥</char>東邊<char style="pn">約旦</char>河對面的<char style="pn">摩押</char>平原數點了<char style="pn">以色列</char>子孫。 <verse eid="NUM 26:63" /><verse number="64" style="v" sid="NUM 26:64" />這些人中，沒有一個是<char style="pn">摩西</char>和祭司<char style="pn">亞倫</char>從前在<char style="pn">西奈</char>曠野數點<char style="pn">以色列</char>子孫時數點過的， <verse eid="NUM 26:64" /><verse number="65" style="v" sid="NUM 26:65" />因為耶和華曾論到這些人說：「他們必須死在曠野；除了<char style="pn">耶弗尼</char>的兒子<char style="pn">迦勒</char>和<char style="pn">嫩</char>的兒子<char style="pn">約書亞</char>以外，他們當中沒有一個人會存留下來。」<verse eid="NUM 26:65" /></para>
  <chapter eid="NUM 26" />
  <chapter number="27" style="c" sid="NUM 27" />
  <para style="s">女兒繼承地業的案例</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1" />那時，<char style="pn">西羅非哈</char>的女兒們上前來——<char style="pn">西羅非哈</char>是<char style="pn">希弗</char>的兒子、<char style="pn">基列</char>的孫子、<char style="pn">瑪吉</char>的曾孫、<char style="pn">瑪拿西</char>的玄孫，屬於<char style="pn">約瑟</char>兒子<char style="pn">瑪拿西</char>的家族；他女兒的名字是：<char style="pn">瑪拉</char>、<char style="pn">挪阿</char>、<char style="pn">霍格拉</char>、<char style="pn">米爾卡</char>、<char style="pn">提爾撒</char>—— <verse eid="NUM 27:1" /><verse number="2" style="v" sid="NUM 27:2" />她們站在會幕的入口，在<char style="pn">摩西</char>、祭司<char style="pn">以利亞撒</char>和領袖們，以及全體會眾面前說： <verse eid="NUM 27:2" /><verse number="3" style="v" sid="NUM 27:3" />「我們的父親死在曠野，他不在那些聚衆反對耶和華的一夥人當中，不屬於<char style="pn">可拉</char>同黨，而是因自己的罪過死了；他沒有兒子。 <verse eid="NUM 27:3" /><verse number="4" style="v" sid="NUM 27:4" />為什麼因我們的父親沒有兒子，就要把他的名字從他家族中除去呢？求你在我們父親的兄弟中分給我們一份地業。」<verse eid="NUM 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5" />
    <char style="pn">摩西</char>就把她們的案件呈到耶和華面前。 <verse eid="NUM 27:5" /><verse number="6" style="v" sid="NUM 27:6" />耶和華告訴<char style="pn">摩西</char>說： <verse eid="NUM 27:6" /><verse number="7" style="v" sid="NUM 27:7" />「<char style="pn">西羅非哈</char>的女兒們說得對，你一定要在她們父親的兄弟中分給她們一份可繼承的地業，把她們父親的繼業轉給她們。 <verse eid="NUM 27:7" /><verse number="8" style="v" sid="NUM 27:8" />你還要吩咐<char style="pn">以色列</char>子民說：如果一個人死了，並且沒有兒子，就要把他的繼業轉給他的女兒。 <verse eid="NUM 27:8" /><verse number="9" style="v" sid="NUM 27:9" />如果他沒有女兒，就要把他的繼業轉給他的兄弟。 <verse eid="NUM 27:9" /><verse number="10" style="v" sid="NUM 27:10" />如果他沒有兄弟，就要把他的繼業轉給他父親的兄弟。 <verse eid="NUM 27:10" /><verse number="11" style="v" sid="NUM 27:11" />如果他父親也沒有兄弟，就要把他的繼業給他家族中與他最近的親屬，那人可以擁有這繼業。」這要成為<char style="pn">以色列</char>子孫的律例法規，正如耶和華所指示<char style="pn">摩西</char>的。<verse eid="NUM 27:11" /></para>
  <para style="s">約書亞受命接替摩西</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12" />耶和華對<char style="pn">摩西</char>說：「你到這<char style="pn">亞巴琳</char>山上去，觀看我賜給<char style="pn">以色列</char>子孫的土地。 <verse eid="NUM 27:12" /><verse number="13" style="v" sid="NUM 27:13" />你觀看了那地之後，你也要歸到你的先人那裡，像你的哥哥<char style="pn">亞倫</char>歸到先人那裡一樣。 <verse eid="NUM 27:13" /><verse number="14" style="v" sid="NUM 27:14" />因為在<char style="pn">尋</char>的曠野，當會眾爭鬧時，你們違背了我的命令，沒有在那水邊在他們眼前尊我為聖。」那水就是<char style="pn">尋</char>的曠野中的<char style="pn">米利巴-加低斯</char>水。<verse eid="NUM 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15" />於是，<char style="pn">摩西</char>請求耶和華說： <verse eid="NUM 27:15" /><verse number="16" style="v" sid="NUM 27:16" />「願耶和華——那使一切肉體有氣息<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">使一切肉體有氣息——或譯作「賜予全人類氣息」。</char></note>的神，指派一個人管理會眾， <verse eid="NUM 27:16" /><verse number="17" style="v" sid="NUM 27:17" />這人要在他們前面出入。他要帶領他們出入，以免耶和華的會眾像沒有牧人的羊群那樣。」<verse eid="NUM 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18" />耶和華就對<char style="pn">摩西</char>說：「你把<char style="pn">嫩</char>的兒子<char style="pn">約書亞</char>帶來，他是一個心中有聖靈的人。你要按手在他頭上， <verse eid="NUM 27:18" /><verse number="19" style="v" sid="NUM 27:19" />讓他站在祭司<char style="pn">以利亞撒</char>和全體會眾面前，在他們眼前任命他； <verse eid="NUM 27:19" /><verse number="20" style="v" sid="NUM 27:20" />並將你的一些尊榮加給他，好讓全體<char style="pn">以色列</char>會眾都聽從他。 <verse eid="NUM 27:20" /><verse number="21" style="v" sid="NUM 27:21" />他要站在祭司<char style="pn">以利亞撒</char>面前；<char style="pn">以利亞撒</char>要在耶和華面前憑藉烏陵的裁決為他求問。<char style="pn">約書亞</char>和所有與他一起的<char style="pn">以色列</char>子民，就是全體會眾，都要照著<char style="pn">以利亞撒</char>的命令出入。」<verse eid="NUM 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22" />
    <char style="pn">摩西</char>就照著耶和華所指示的去做。他把<char style="pn">約書亞</char>帶來，讓他站在祭司<char style="pn">以利亞撒</char>和全體會眾面前， <verse eid="NUM 27:22" /><verse number="23" style="v" sid="NUM 27:23" />按手在他頭上，任命他，正如耶和華藉著<char style="pn">摩西</char>所說的。<verse eid="NUM 27:23" /></para>
  <chapter eid="NUM 27" />
  <chapter number="28" style="c" sid="NUM 28" />
  <para style="s">規定要獻燔祭</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 28:1" /><verse number="2" style="v" sid="NUM 28:2" />「你要吩咐<char style="pn">以色列</char>子民，對他們說：你們務必在所定的日期向我獻上祭物作馨香之氣，作為獻給我的火祭食物。 <verse eid="NUM 28:2" /><verse number="3" style="v" sid="NUM 28:3" />你要對他們說，獻給耶和華的火祭如下：</para>
  <para style="s" vid="NUM 28:3">每日常獻的燔祭</para>
  <para style="p" vid="NUM 28:3">「兩隻無瑕疵的一歲公羊羔，作為每天常獻的燔祭， <verse eid="NUM 28:3" /><verse number="4" style="v" sid="NUM 28:4" />早晨獻一隻羊羔，黃昏的時候獻另一隻羊羔； <verse eid="NUM 28:4" /><verse number="5" style="v" sid="NUM 28:5" />還有十分之一伊法<note caller="+" style="f"><char style="fr" closed="false">28:5 </char><char style="ft" closed="false">十分之一伊法——相當於2.2公升；本章下同。1伊法＝22公升。</char></note>細麵粉，用四分之一欣<note caller="+" style="f"><char style="fr" closed="false">28:5 </char><char style="ft" closed="false">四分之一欣——相當於0.9公升；本章下同。1欣=3.7公升。</char></note>壓榨的油調和作素祭。 <verse eid="NUM 28:5" /><verse number="6" style="v" sid="NUM 28:6" />這常獻的燔祭是在<char style="pn">西奈</char>山規定的，是獻給耶和華的馨香火祭。 <verse eid="NUM 28:6" /><verse number="7" style="v" sid="NUM 28:7" />還要為每一隻公羊羔同獻四分之一欣的酒祭，在聖所中將醇酒的酒祭澆奠給耶和華。 <verse eid="NUM 28:7" /><verse number="8" style="v" sid="NUM 28:8" />你要在黃昏的時候獻第二隻羊羔，像早晨的素祭和酒祭一樣獻上，作馨香的火祭獻給耶和華。<verse eid="NUM 28:8" /></para>
  <para style="s">安息日的燔祭</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9" />「在安息日，要獻兩隻無瑕疵的一歲公羊羔，還有十分之二伊法<note caller="+" style="f"><char style="fr" closed="false">28:9 </char><char style="ft" closed="false">十分之二伊法——相當於4.4公升；本章下同。1伊法=22公升。</char></note>調了油的細麵粉為素祭，以及同獻的酒祭。 <verse eid="NUM 28:9" /><verse number="10" style="v" sid="NUM 28:10" />這是在常獻的燔祭和同獻的酒祭以外，每個安息日都要獻的燔祭。<verse eid="NUM 28:10" /></para>
  <para style="s">月初的燔祭</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11" />「在每個月的第一天，你們要向耶和華獻上燔祭：兩頭公牛、一隻公綿羊、七隻無瑕疵的一歲公羊羔。 <verse eid="NUM 28:11" /><verse number="12" style="v" sid="NUM 28:12" />為每一頭公牛，獻上十分之三伊法<note caller="+" style="f"><char style="fr" closed="false">28:12 </char><char style="ft" closed="false">十分之三伊法——相當於6.6公升；本章下同。1伊法=22公升。</char></note>調了油的細麵粉作素祭；為每一隻公綿羊，獻上十分之二伊法調了油的細麵粉作素祭； <verse eid="NUM 28:12" /><verse number="13" style="v" sid="NUM 28:13" />為每一隻羊羔，獻上十分之一伊法調了油的細麵粉作素祭。這是燔祭，作馨香的火祭獻給耶和華。 <verse eid="NUM 28:13" /><verse number="14" style="v" sid="NUM 28:14" />還有同獻的酒祭，每頭公牛要二分之一欣<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">二分之一欣——相當於1.9公升。1欣=3.7公升。</char></note>酒，每隻公綿羊要三分之一欣<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">三分之一欣——相當於1.2公升。</char></note>酒，每隻羊羔要四分之一欣<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">四分之一欣——相當於0.9公升。</char></note>酒。這是一年之中每個月都要獻上的新月燔祭。 <verse eid="NUM 28:14" /><verse number="15" style="v" sid="NUM 28:15" />除了常獻的燔祭和同獻的酒祭以外，還要獻給耶和華一隻公山羊作贖罪祭。<verse eid="NUM 28:15" /></para>
  <para style="s">逾越節的燔祭</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16" />「一月十四日是耶和華的逾越節， <verse eid="NUM 28:16" /><verse number="17" style="v" sid="NUM 28:17" />這個月的十五日是節期，要吃無酵餅七天。 <verse eid="NUM 28:17" /><verse number="18" style="v" sid="NUM 28:18" />第一天要有神聖的聚會，任何日常工作都不可做。 <verse eid="NUM 28:18" /><verse number="19" style="v" sid="NUM 28:19" />你們要獻上兩頭公牛、一隻公綿羊、七隻一歲的公羊羔，都必須是無瑕疵的，作為火祭，作為燔祭獻給耶和華。 <verse eid="NUM 28:19" /><verse number="20" style="v" sid="NUM 28:20" />還有同獻的素祭，就是調了油的細麵粉：為每頭公牛，要獻十分之三伊法麵粉；為每隻公綿羊，要獻十分之二伊法麵粉； <verse eid="NUM 28:20" /><verse number="21" style="v" sid="NUM 28:21" />至於那七隻公羊羔，要為每一隻羊羔獻十分之一伊法麵粉。 <verse eid="NUM 28:21" /><verse number="22" style="v" sid="NUM 28:22" />還要獻一隻贖罪祭公山羊，為你們贖罪。 <verse eid="NUM 28:22" /><verse number="23" style="v" sid="NUM 28:23" />除了清晨的燔祭，就是常獻的燔祭以外，你們還要獻以上這些祭物。 <verse eid="NUM 28:23" /><verse number="24" style="v" sid="NUM 28:24" />在常獻的燔祭和同獻的酒祭以外，一連七天，每天都要這樣獻上火祭的食物，作馨香之氣獻給耶和華。 <verse eid="NUM 28:24" /><verse number="25" style="v" sid="NUM 28:25" />第七天要有神聖的聚會，任何日常工作都不可做。<verse eid="NUM 28:25" /></para>
  <para style="s">七七節的燔祭</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26" />「在初熟之日，當你們在七七節向耶和華獻上新的素祭時，要有神聖的聚會，任何日常工作都不可做。 <verse eid="NUM 28:26" /><verse number="27" style="v" sid="NUM 28:27" />你們要獻上兩頭公牛、一隻公綿羊、七隻一歲的公羊羔為燔祭，作馨香之氣獻給耶和華。 <verse eid="NUM 28:27" /><verse number="28" style="v" sid="NUM 28:28" />還有同獻的素祭，就是調了油的細麵粉：為每頭公牛，要獻十分之三伊法麵粉；為每一隻公綿羊，要獻十分之二伊法麵粉； <verse eid="NUM 28:28" /><verse number="29" style="v" sid="NUM 28:29" />至於那七隻公羊羔，要為每一隻羊羔獻十分之一伊法麵粉。 <verse eid="NUM 28:29" /><verse number="30" style="v" sid="NUM 28:30" />還要獻一隻公山羊，為你們贖罪。 <verse eid="NUM 28:30" /><verse number="31" style="v" sid="NUM 28:31" />你們要在常獻的燔祭和同獻的素祭以外，獻上這些無瑕疵的燔祭和同獻的酒祭。<verse eid="NUM 28:31" /></para>
  <chapter eid="NUM 28" />
  <chapter number="29" style="c" sid="NUM 29" />
  <para style="s">吹角節的燔祭</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1" />「七月的第一日，你們要有神聖的聚會，任何日常工作都不可做，這是你們長鳴號角的日子。 <verse eid="NUM 29:1" /><verse number="2" style="v" sid="NUM 29:2" />你們要獻一頭公牛、一隻公綿羊、七隻無瑕疵的一歲公羊羔為燔祭，作馨香之氣獻給耶和華。 <verse eid="NUM 29:2" /><verse number="3" style="v" sid="NUM 29:3" />還有同獻的素祭，就是調了油的細麵粉：為每頭公牛，要獻十分之三伊法<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="ft" closed="false">十分之三伊法——相當於6.6公升；本章下同。1伊法=22公升。</char></note>麵粉；為每隻公綿羊，要獻十分之二伊法<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="ft" closed="false">十分之二伊法——相當於4.4公升；本章下同。1伊法=22公升。</char></note>麵粉； <verse eid="NUM 29:3" /><verse number="4" style="v" sid="NUM 29:4" />至於那七隻公羊羔，要為每隻羊羔獻十分之一伊法<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">十分之一伊法——相當於2.2公升；本章下同。1伊法＝22公升。</char></note>麵粉。 <verse eid="NUM 29:4" /><verse number="5" style="v" sid="NUM 29:5" />還要獻一隻公山羊作贖罪祭，為你們贖罪。 <verse eid="NUM 29:5" /><verse number="6" style="v" sid="NUM 29:6" />你們要在新月燔祭和同獻的素祭、常獻的燔祭和同獻的素祭，以及照著法規同獻的酒祭以外，把這些作為馨香的火祭獻給耶和華。<verse eid="NUM 29:6" /></para>
  <para style="s">贖罪日的燔祭</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7" />「七月十日，你們要有神聖的聚會，要刻苦己心，任何工作都不可做。 <verse eid="NUM 29:7" /><verse number="8" style="v" sid="NUM 29:8" />你們要獻上一頭公牛、一隻公綿羊、七隻一歲的公羊羔，都必須是無瑕疵的，作為馨香的燔祭獻給耶和華。 <verse eid="NUM 29:8" /><verse number="9" style="v" sid="NUM 29:9" />還有同獻的素祭，就是調了油的細麵粉：為每頭公牛，要獻十分之三伊法麵粉；為每隻公綿羊，要獻十分之二伊法麵粉； <verse eid="NUM 29:9" /><verse number="10" style="v" sid="NUM 29:10" />至於那七隻公羊羔，要為每隻羊羔獻十分之一伊法麵粉。 <verse eid="NUM 29:10" /><verse number="11" style="v" sid="NUM 29:11" />還要獻一隻公山羊作贖罪祭。這是在贖罪祭、常獻的燔祭和同獻的素祭，以及同獻的酒祭以外的燔祭。<verse eid="NUM 29:11" /></para>
  <para style="s">住棚節的燔祭</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12" />「七月十五日，你們要有神聖的聚會，任何日常工作都不可做，你們要向耶和華守節期七天。 <verse eid="NUM 29:12" /><verse number="13" style="v" sid="NUM 29:13" />你們要獻上十三頭公牛、兩隻公綿羊、十四隻一歲的公羊羔，都必須是無瑕疵的，作為燔祭，作為馨香的火祭獻給耶和華。 <verse eid="NUM 29:13" /><verse number="14" style="v" sid="NUM 29:14" />還有同獻的素祭，就是調了油的細麵粉：十三頭公牛，為每頭公牛要獻十分之三伊法麵粉；兩隻公綿羊，為每一隻公綿羊要獻十分之二伊法麵粉； <verse eid="NUM 29:14" /><verse number="15" style="v" sid="NUM 29:15" />十四隻公羊羔，為每一隻羊羔要獻十分之一伊法麵粉。 <verse eid="NUM 29:15" /><verse number="16" style="v" sid="NUM 29:16" />還要獻一隻公山羊作贖罪祭。這是在常獻的燔祭和同獻的素祭，以及同獻的酒祭以外的燔祭。<verse eid="NUM 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17" />「第二天，要獻十二頭公牛、兩隻公綿羊、十四隻一歲的公羊羔，都是無瑕疵的。 <verse eid="NUM 29:17" /><verse number="18" style="v" sid="NUM 29:18" />還有為公牛、公綿羊和羊羔同獻的素祭和酒祭，都要按數目、照法規獻上。 <verse eid="NUM 29:18" /><verse number="19" style="v" sid="NUM 29:19" />還要獻一隻公山羊作贖罪祭。這是在常獻的燔祭和同獻的素祭，以及同獻的酒祭以外的燔祭。<verse eid="NUM 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20" />「第三天，要獻十一頭公牛、兩隻公綿羊、十四隻一歲的公羊羔，都是無瑕疵的。 <verse eid="NUM 29:20" /><verse number="21" style="v" sid="NUM 29:21" />還有為公牛、公綿羊和公羊羔同獻的素祭和酒祭，都要按數目、照法規獻上。 <verse eid="NUM 29:21" /><verse number="22" style="v" sid="NUM 29:22" />還要獻一隻公山羊作贖罪祭。這是在常獻的燔祭和同獻的素祭，以及同獻的酒祭以外的燔祭。<verse eid="NUM 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23" />「第四天，要獻十頭公牛、兩隻公綿羊、十四隻一歲的公羊羔，都是無瑕疵的。 <verse eid="NUM 29:23" /><verse number="24" style="v" sid="NUM 29:24" />還有為公牛、公綿羊和公羊羔同獻的素祭和酒祭，都要按數目、照法規獻上。 <verse eid="NUM 29:24" /><verse number="25" style="v" sid="NUM 29:25" />還要獻一隻公山羊作贖罪祭。這是在常獻的燔祭和同獻的素祭，以及同獻的酒祭以外的燔祭。<verse eid="NUM 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26" />「第五天，要獻九頭公牛、兩隻公綿羊、十四隻一歲的公羊羔，都是無瑕疵的。 <verse eid="NUM 29:26" /><verse number="27" style="v" sid="NUM 29:27" />還有為公牛、公綿羊和公羊羔同獻的素祭和酒祭，都要按數目、照法規獻上。 <verse eid="NUM 29:27" /><verse number="28" style="v" sid="NUM 29:28" />還要獻一隻公山羊作贖罪祭。這是在常獻的燔祭和同獻的素祭，以及同獻的酒祭以外的燔祭。<verse eid="NUM 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29" />「第六天，要獻八頭公牛、兩隻公綿羊、十四隻一歲的公羊羔，都是無瑕疵的。 <verse eid="NUM 29:29" /><verse number="30" style="v" sid="NUM 29:30" />還有為公牛、公綿羊和公羊羔同獻的素祭和酒祭，都要按數目、照法規獻上。 <verse eid="NUM 29:30" /><verse number="31" style="v" sid="NUM 29:31" />還要獻一隻公山羊作贖罪祭。這是在常獻的燔祭和同獻的素祭，以及同獻的酒祭以外的燔祭。<verse eid="NUM 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32" />「第七天，要獻七頭公牛、兩隻公綿羊、十四隻一歲的公羊羔，都是無瑕疵的。 <verse eid="NUM 29:32" /><verse number="33" style="v" sid="NUM 29:33" />還有為公牛、公綿羊和公羊羔同獻的素祭和酒祭，都要按數目、照法規獻上。 <verse eid="NUM 29:33" /><verse number="34" style="v" sid="NUM 29:34" />還要獻一隻公山羊作贖罪祭。這是在常獻的燔祭和同獻的素祭，以及同獻的酒祭以外的燔祭。<verse eid="NUM 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35" />「第八天，你們要有嚴肅集會，任何日常工作都不可做。 <verse eid="NUM 29:35" /><verse number="36" style="v" sid="NUM 29:36" />你們要獻上一頭公牛、一隻公綿羊、七隻一歲的公羊羔，都是無瑕疵的，作為燔祭，作為馨香的火祭獻給耶和華。 <verse eid="NUM 29:36" /><verse number="37" style="v" sid="NUM 29:37" />還有為公牛、公綿羊和公羊羔同獻的素祭和酒祭，都要按數目、照法規獻上。 <verse eid="NUM 29:37" /><verse number="38" style="v" sid="NUM 29:38" />還要獻一隻公山羊作贖罪祭。這是在常獻的燔祭和同獻的素祭，以及同獻的酒祭以外的燔祭。<verse eid="NUM 29:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39" />「你們在所定的日期，在還願祭和甘心祭的燔祭、素祭、酒祭和平安祭以外，還要把這些獻給耶和華。」<verse eid="NUM 29:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40" />於是，<char style="pn">摩西</char>照著耶和華所指示他的，把一切都告訴了<char style="pn">以色列</char>子民。<verse eid="NUM 29:40" /></para>
  <chapter eid="NUM 29" />
  <chapter number="30" style="c" sid="NUM 30" />
  <para style="s">關於許願的條例</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1" />
    <char style="pn">摩西</char>吩咐<char style="pn">以色列</char>子民各支派的首領說：「這是耶和華所指示的話： <verse eid="NUM 30:1" /><verse number="2" style="v" sid="NUM 30:2" />一個男人如果向耶和華許了願，或者起了誓，以誓約來約束自己，他就不可食言，必須照著他口中說出的一切去做。<verse eid="NUM 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3" />「一個女人年輕時在她的父家，如果向耶和華許了願，以誓約來約束自己， <verse eid="NUM 30:3" /><verse number="4" style="v" sid="NUM 30:4" />她的父親也聽到她所許的願以及她約束自己的誓約，卻對她保持沉默，她所許的願就全都有效，她約束自己的一切誓約也都有效。 <verse eid="NUM 30:4" /><verse number="5" style="v" sid="NUM 30:5" />但如果她父親在聽到的那天反對她，她所許的願和她約束自己的誓約，就全都無效；耶和華也會赦免她，因為她父親反對了她。<verse eid="NUM 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6" />「如果她嫁人時，還有所許的願在身，或者有約束自己的冒失話從她口中說出， <verse eid="NUM 30:6" /><verse number="7" style="v" sid="NUM 30:7" />她丈夫聽到了，卻在聽到的那天對她保持沉默，她所許的願就仍舊有效，她約束自己的誓約也仍舊有效。 <verse eid="NUM 30:7" /><verse number="8" style="v" sid="NUM 30:8" />但如果她丈夫在聽到的那天反對她，丈夫就廢除了她身上所許的願，以及她口中說出約束自己的冒失話，而耶和華也會赦免她。<verse eid="NUM 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9" />「至於寡婦或被休的婦人所許的願，她所約束自己的一切誓約，都有效。<verse eid="NUM 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10" />「如果女人在她丈夫家裡許了願，或者以誓約來約束自己， <verse eid="NUM 30:10" /><verse number="11" style="v" sid="NUM 30:11" />她丈夫聽到了，卻對她保持沉默，沒有反對她，她所許的願就全都有效，她約束自己的一切誓約也都有效。 <verse eid="NUM 30:11" /><verse number="12" style="v" sid="NUM 30:12" />但如果她丈夫在聽到的那天把它們明確廢除了，她口中說出的一切，無論是所許的願還是她的誓約，就全都無效，她丈夫把它們廢除了；而耶和華也會赦免她。 <verse eid="NUM 30:12" /><verse number="13" style="v" sid="NUM 30:13" />她所許的任何願，以及刻苦約束自己的任何誓約，她丈夫都可以使它有效，或者把它廢除。 <verse eid="NUM 30:13" /><verse number="14" style="v" sid="NUM 30:14" />她丈夫如果天天對她保持沉默，就使她所許的任何願或她身上的任何誓約都有效了。她丈夫既然在聽到的那天對她保持沉默，就使這些都有效了。 <verse eid="NUM 30:14" /><verse number="15" style="v" sid="NUM 30:15" />但如果她丈夫在聽到之後，明確廢除它們，丈夫就要承擔她的罪責。」<verse eid="NUM 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16" />這些是耶和華指示<char style="pn">摩西</char>的律例，涉及丈夫對妻子的責任<note caller="+" style="f"><char style="fr" closed="false">30:16 </char><char style="ft" closed="false">對……的責任——原文直譯「與……之間」；下同。</char></note>，以及女兒年輕在父家時父親對女兒的責任。<verse eid="NUM 30:16" /></para>
  <chapter eid="NUM 30" />
  <chapter number="31" style="c" sid="NUM 31" />
  <para style="s">與米甸人作戰</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 31:1" /><verse number="2" style="v" sid="NUM 31:2" />「你要向<char style="pn">米甸</char>人報<char style="pn">以色列</char>人的仇，然後你將歸到你的先人那裡。」<verse eid="NUM 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3" />
    <char style="pn">摩西</char>就吩咐民眾：「你們當中要有一些人武裝起來去作戰，攻打<char style="pn">米甸</char>人，向<char style="pn">米甸</char>人施行耶和華的報復。 <verse eid="NUM 31:3" /><verse number="4" style="v" sid="NUM 31:4" /><char style="pn">以色列</char>所有支派中，每支派要派遣一千人去作戰。」 <verse eid="NUM 31:4" /><verse number="5" style="v" sid="NUM 31:5" />於是，從<char style="pn">以色列</char>千軍中選出了一萬兩千武裝起來作戰的人，每支派有一千人。 <verse eid="NUM 31:5" /><verse number="6" style="v" sid="NUM 31:6" /><char style="pn">摩西</char>派他們去作戰，每支派有一千人。他們和祭司<char style="pn">以利亞撒</char>的兒子<char style="pn">非尼哈</char>一起去作戰，<char style="pn">非尼哈</char>手裡帶著聖所的器具和發令的號角。<verse eid="NUM 31:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 31:7" />他們就照著耶和華指示<char style="pn">摩西</char>的，與<char style="pn">米甸</char>人作戰，殺死了<char style="pn">米甸</char>所有的男子。 <verse eid="NUM 31:7" /><verse number="8" style="v" sid="NUM 31:8" />在這些被殺的人以外，他們還殺了<char style="pn">米甸</char>的王，就是<char style="pn">埃維</char>、<char style="pn">利肯</char>、<char style="pn">蘇珥</char>、<char style="pn">戶珥</char>、<char style="pn">利巴</char>五個<char style="pn">米甸</char>王，並且用刀殺了<char style="pn">比珥</char>的兒子<char style="pn">巴蘭</char>。 <verse eid="NUM 31:8" /><verse number="9" style="v" sid="NUM 31:9" /><char style="pn">以色列</char>人擄走了<char style="pn">米甸</char>人的婦女和孩童，還掠奪了他們所有的牛羊牲畜和財物， <verse eid="NUM 31:9" /><verse number="10" style="v" sid="NUM 31:10" />又用火燒了他們所住的一切城鎮，以及他們所有的營寨。 <verse eid="NUM 31:10" /><verse number="11" style="v" sid="NUM 31:11" />他們把所有的掠物和所有的擄物，連人和牲畜都帶走了。 <verse eid="NUM 31:11" /><verse number="12" style="v" sid="NUM 31:12" />他們把俘虜、擄物和掠物都帶到營地，就在<char style="pn">耶利哥</char>東邊<char style="pn">約旦</char>河對面的<char style="pn">摩押</char>平原那裡，帶給<char style="pn">摩西</char>和祭司<char style="pn">以利亞撒</char>以及<char style="pn">以色列</char>會眾。<verse eid="NUM 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13" />
    <char style="pn">摩西</char>和祭司<char style="pn">以利亞撒</char>，以及所有的會眾領袖都出去，到營地外面迎接他們。 <verse eid="NUM 31:13" /><verse number="14" style="v" sid="NUM 31:14" />然而，<char style="pn">摩西</char>對那些從戰陣上回來的軍官千夫長和百夫長發怒。 <verse eid="NUM 31:14" /><verse number="15" style="v" sid="NUM 31:15" /><char style="pn">摩西</char>對他們說：「你們怎麼讓所有的女人都存活呢？ <verse eid="NUM 31:15" /><verse number="16" style="v" sid="NUM 31:16" />看哪，正是她們按照<char style="pn">巴蘭</char>的計謀，使<char style="pn">以色列</char>子民在<char style="pn">毗珥</char>的事情上背叛耶和華，以致瘟疫臨到了耶和華的會眾！ <verse eid="NUM 31:16" /><verse number="17" style="v" sid="NUM 31:17" />現在，你們要把<char style="pn">米甸</char>所有的男孩殺死，也要把所有與男人同床共寢過的女人殺死； <verse eid="NUM 31:17" /><verse number="18" style="v" sid="NUM 31:18" />只有那些不曾與男人同寢過的女孩，可以讓她們存活，歸於你們。<verse eid="NUM 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 31:19" />「至於你們，要在營地外停留七天。你們和你們的俘虜，所有殺了人的、所有觸碰了被殺之人的，都要在第三天和第七天潔淨自己。 <verse eid="NUM 31:19" /><verse number="20" style="v" sid="NUM 31:20" />你們還要潔淨每件衣服、每件皮具、每件羊毛織品和每件木器。」<verse eid="NUM 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21" />祭司<char style="pn">以利亞撒</char>對那些作戰回來的軍人說：「這是耶和華指示<char style="pn">摩西</char>的律法條例： <verse eid="NUM 31:21" /><verse number="22" style="v" sid="NUM 31:22" />唯獨金、銀、銅、鐵、錫、鉛， <verse eid="NUM 31:22" /><verse number="23" style="v" sid="NUM 31:23" />這些經得起火燒的東西，你們要使它們經火潔淨，但還要用除汙穢的水使它們得潔淨；至於那些經不起火燒的，要使它們經水潔淨。 <verse eid="NUM 31:23" /><verse number="24" style="v" sid="NUM 31:24" />第七天，你們洗衣服，就潔淨了，然後可以回營地。」<verse eid="NUM 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 31:25" /><verse number="26" style="v" sid="NUM 31:26" />「你和祭司<char style="pn">以利亞撒</char>，以及會眾各父系的首領，要統計所擄來的擄物——連人帶牲畜的數目。 <verse eid="NUM 31:26" /><verse number="27" style="v" sid="NUM 31:27" />你要在那些出征的戰士和全體會眾之間，同分擄物。 <verse eid="NUM 31:27" /><verse number="28" style="v" sid="NUM 31:28" />你還要從出征的戰士所得的人、牛、驢和羊中，每五百個取一個，作為貢物獻給耶和華。 <verse eid="NUM 31:28" /><verse number="29" style="v" sid="NUM 31:29" />你們要從他們那一半中取出這些，作為獻給耶和華的供物交給祭司<char style="pn">以利亞撒</char>； <verse eid="NUM 31:29" /><verse number="30" style="v" sid="NUM 31:30" />也要從<char style="pn">以色列</char>子孫的這一半中，就是從人、牛、驢、羊以及各樣牲畜中，每五十個取一個，交給謹守耶和華帳幕職責的<char style="pn">利未</char>人。」<verse eid="NUM 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 31:31" />
    <char style="pn">摩西</char>和祭司<char style="pn">以利亞撒</char>就照耶和華指示<char style="pn">摩西</char>的去做。 <verse eid="NUM 31:31" /><verse number="32" style="v" sid="NUM 31:32" />那些擄物，就是軍兵所掠奪存留下來的掠物有：</para>
  <para style="q1" vid="NUM 31:32">羊六十七萬五千隻；<verse eid="NUM 31:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="NUM 31:33" />牛七萬兩千頭；<verse eid="NUM 31:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="NUM 31:34" />驢六萬一千匹；<verse eid="NUM 31:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="NUM 31:35" />人口總共三萬兩千，都是沒有與男人同寢過的女人。<verse eid="NUM 31:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="NUM 31:36" />出征的人分得的那一半：</para>
  <para style="q1" vid="NUM 31:36">羊的數目是三十三萬七千五百隻，<verse eid="NUM 31:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="NUM 31:37" />這些羊中歸於耶和華的貢物有六百七十五隻；<verse eid="NUM 31:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="NUM 31:38" />牛三萬六千頭，</para>
  <para style="q1" vid="NUM 31:38">其中歸於耶和華的貢物有七十二頭；<verse eid="NUM 31:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="NUM 31:39" />驢三萬零五百匹，</para>
  <para style="q1" vid="NUM 31:39">其中歸於耶和華的貢物有六十一匹；<verse eid="NUM 31:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="NUM 31:40" />人口一萬六千，</para>
  <para style="q1" vid="NUM 31:40">其中歸於耶和華的貢物有三十二人。<verse eid="NUM 31:40" /></para>
  <para style="b" />
  <para style="p">
    <verse number="41" style="v" sid="NUM 31:41" />
    <char style="pn">摩西</char>把貢物，就是獻給耶和華的供物，交給了祭司<char style="pn">以利亞撒</char>，正如耶和華所指示<char style="pn">摩西</char>的。<verse eid="NUM 31:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42" />
    <char style="pn">以色列</char>子孫的那一半，是<char style="pn">摩西</char>從作戰的人取來分給他們的， <verse eid="NUM 31:42" /><verse number="43" style="v" sid="NUM 31:43" />會眾的一半有：</para>
  <para style="q1" vid="NUM 31:43">羊三十三萬七千五百隻，<verse eid="NUM 31:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="NUM 31:44" />牛三萬六千頭，<verse eid="NUM 31:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="NUM 31:45" />驢三萬零五百匹，<verse eid="NUM 31:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="NUM 31:46" />人口一萬六千。<verse eid="NUM 31:46" /></para>
  <para style="b" />
  <para style="p">
    <verse number="47" style="v" sid="NUM 31:47" />
    <char style="pn">摩西</char>從<char style="pn">以色列</char>子孫的那一半中，無論是人還是牲畜，每五十個抽出一個，交給了謹守耶和華帳幕職責的<char style="pn">利未</char>人，正如耶和華所指示<char style="pn">摩西</char>的。<verse eid="NUM 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48" />那些率領千軍的軍官，就是千夫長、百夫長，來到<char style="pn">摩西</char>那裡， <verse eid="NUM 31:48" /><verse number="49" style="v" sid="NUM 31:49" />對<char style="pn">摩西</char>說：「你的僕人已經統計了我們手下戰士的人數，我們沒有少一個人。 <verse eid="NUM 31:49" /><verse number="50" style="v" sid="NUM 31:50" />我們帶來了耶和華的祭物，就是各人所獲得的金器——臂環、鐲子、戒指、耳環、項鏈，要在耶和華面前為我們贖罪。」<verse eid="NUM 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51" />
    <char style="pn">摩西</char>和祭司<char style="pn">以利亞撒</char>接受了他們的金器，全都是精工的首飾。 <verse eid="NUM 31:51" /><verse number="52" style="v" sid="NUM 31:52" />他們獻給耶和華為供物的金子，就是千夫長和百夫長獻出的，共有一萬六千七百五十謝克爾<note caller="+" style="f"><char style="fr" closed="false">31:52 </char><char style="ft" closed="false">一萬六千七百五十謝克爾——相當於191公斤。1謝克爾=11.4公克。</char></note>； <verse eid="NUM 31:52" /><verse number="53" style="v" sid="NUM 31:53" />軍人們掠奪的，各歸自己。 <verse eid="NUM 31:53" /><verse number="54" style="v" sid="NUM 31:54" /><char style="pn">摩西</char>和祭司<char style="pn">以利亞撒</char>接受了千夫長和百夫長的金子，帶進會幕，為<char style="pn">以色列</char>子孫在耶和華面前作記念。<verse eid="NUM 31:54" /></para>
  <chapter eid="NUM 31" />
  <chapter number="32" style="c" sid="NUM 32" />
  <para style="s">外約旦河之地</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1" />
    <char style="pn">魯本</char>子孫和<char style="pn">迦得</char>子孫有許多牲畜，極其興旺。他們觀看<char style="pn">雅謝</char>地和<char style="pn">基列</char>地，發現那地方很適合放牧牲畜。 <verse eid="NUM 32:1" /><verse number="2" style="v" sid="NUM 32:2" />於是<char style="pn">迦得</char>子孫和<char style="pn">魯本</char>子孫前來，對<char style="pn">摩西</char>和祭司<char style="pn">以利亞撒</char>，以及會眾領袖們說： <verse eid="NUM 32:2" /><verse number="3" style="v" sid="NUM 32:3" />「<char style="pn">亞塔羅</char>、<char style="pn">迪本</char>、<char style="pn">雅謝</char>、<char style="pn">寧拉</char>、<char style="pn">希實本</char>、<char style="pn">以利亞利</char>、<char style="pn">謝巴姆</char>、<char style="pn">尼波</char>、<char style="pn">比穩</char>， <verse eid="NUM 32:3" /><verse number="4" style="v" sid="NUM 32:4" />就是耶和華在<char style="pn">以色列</char>會眾面前所征服的土地，很適合放牧牲畜，而你的僕人們有許多牲畜。」 <verse eid="NUM 32:4" /><verse number="5" style="v" sid="NUM 32:5" />他們接著說：「如果我們在你眼前蒙恩，就請把這地分給你的僕人作產業，不要領我們過<char style="pn">約旦</char>河。」<verse eid="NUM 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6" />
    <char style="pn">摩西</char>對<char style="pn">迦得</char>子孫和<char style="pn">魯本</char>子孫說：「難道你們的弟兄去作戰，你們卻要坐在這裡嗎？ <verse eid="NUM 32:6" /><verse number="7" style="v" sid="NUM 32:7" />你們為什麼不過河前往耶和華賜給<char style="pn">以色列</char>子孫的土地，以致他們灰心喪膽呢？ <verse eid="NUM 32:7" /><verse number="8" style="v" sid="NUM 32:8" />我從<char style="pn">加低斯-巴尼亞</char>派你們的父輩去察看那地時，他們也這樣做過。 <verse eid="NUM 32:8" /><verse number="9" style="v" sid="NUM 32:9" />他們上到<char style="pn">以實格</char>溪谷，察看了那地後，卻使<char style="pn">以色列</char>子民灰心喪膽，不願進入耶和華賜給他們的土地。 <verse eid="NUM 32:9" /><verse number="10" style="v" sid="NUM 32:10" />所以在那天，耶和華怒氣發作，起誓說： <verse eid="NUM 32:10" /><verse number="11" style="v" sid="NUM 32:11" />『從<char style="pn">埃及</char>上來的二十歲以上的男子，絕不會見到我起誓給<char style="pn">亞伯拉罕</char>、<char style="pn">以撒</char>、<char style="pn">雅各</char>的那地，因為他們沒有全心跟從我。 <verse eid="NUM 32:11" /><verse number="12" style="v" sid="NUM 32:12" />只有<char style="pn">基尼洗</char>人<char style="pn">耶弗尼</char>的兒子<char style="pn">迦勒</char>和<char style="pn">嫩</char>的兒子<char style="pn">約書亞</char>例外，因為他們全心跟隨耶和華。』 <verse eid="NUM 32:12" /><verse number="13" style="v" sid="NUM 32:13" />耶和華的怒氣向<char style="pn">以色列</char>發作，使他們在曠野漂泊四十年，直到在耶和華眼前作惡的那整個世代都滅盡了。 <verse eid="NUM 32:13" /><verse number="14" style="v" sid="NUM 32:14" />看哪，你們這罪人的族類，你們起來接續你們的父輩，再次增添耶和華對<char style="pn">以色列</char>的猛烈怒氣。 <verse eid="NUM 32:14" /><verse number="15" style="v" sid="NUM 32:15" />如果你們轉離不跟從他，他必再次把<char style="pn">以色列</char>撇棄在曠野，那樣你們就毀了這整個民族。」<verse eid="NUM 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16" />於是，他們近前來說：「我們是要在這裡為我們的牲畜建造圍欄，為我們的家屬建造城鎮。 <verse eid="NUM 32:16" /><verse number="17" style="v" sid="NUM 32:17" />然後我們必武裝起來，在<char style="pn">以色列</char>子孫前面領先前行，直到把他們帶到他們的地方；我們的家屬要留在堅固的城裡，躲避這地的居民。 <verse eid="NUM 32:17" /><verse number="18" style="v" sid="NUM 32:18" />在<char style="pn">以色列</char>子孫各自繼承他們的產業之前，我們絕不回自己的家； <verse eid="NUM 32:18" /><verse number="19" style="v" sid="NUM 32:19" />我們也不會在<char style="pn">約旦</char>河對岸那一帶與大家同分產業，因為我們已經在<char style="pn">約旦</char>河東邊分得了自己的產業。」<verse eid="NUM 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20" />
    <char style="pn">摩西</char>就對他們說：「如果你們是要這樣做，如果你們在耶和華面前武裝起來去作戰， <verse eid="NUM 32:20" /><verse number="21" style="v" sid="NUM 32:21" />你們所有武裝起來的人就要在耶和華面前渡過<char style="pn">約旦</char>河，直到耶和華將仇敵從他面前趕出去。 <verse eid="NUM 32:21" /><verse number="22" style="v" sid="NUM 32:22" />當那地在耶和華面前被征服之後，你們才可以回來。這樣你們就對耶和華和<char style="pn">以色列</char>盡責了，這地就在耶和華面前成為你們的產業。 <verse eid="NUM 32:22" /><verse number="23" style="v" sid="NUM 32:23" />但如果你們不這樣做，看哪，你們就對耶和華犯罪了！要知道，你們的罪必找上你們。 <verse eid="NUM 32:23" /><verse number="24" style="v" sid="NUM 32:24" />你們就為家屬建造城鎮、為羊群建造圍欄吧！但你們口裡說出的，一定要實行。」<verse eid="NUM 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25" />
    <char style="pn">迦得</char>子孫和<char style="pn">魯本</char>子孫回答<char style="pn">摩西</char>說：「你的僕人們必照著我主所吩咐的去做。 <verse eid="NUM 32:25" /><verse number="26" style="v" sid="NUM 32:26" />我們的孩童、妻子，以及我們的牛羊和所有的牲畜，都會留在<char style="pn">基列</char>各城。 <verse eid="NUM 32:26" /><verse number="27" style="v" sid="NUM 32:27" />但你的僕人們，凡是武裝起來的軍兵，都會照著我主所吩咐的，在耶和華面前過河去作戰。」<verse eid="NUM 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28" />於是，<char style="pn">摩西</char>就為了他們吩咐祭司<char style="pn">以利亞撒</char>和<char style="pn">嫩</char>的兒子<char style="pn">約書亞</char>，以及<char style="pn">以色列</char>子孫各支派父系的首領。 <verse eid="NUM 32:28" /><verse number="29" style="v" sid="NUM 32:29" /><char style="pn">摩西</char>說：「<char style="pn">迦得</char>子孫和<char style="pn">魯本</char>子孫，凡是武裝起來在耶和華面前去作戰的人，如果與你們一同過<char style="pn">約旦</char>河，並且那地在你們面前被征服了，你們就要把<char style="pn">基列</char>地分給他們作產業。 <verse eid="NUM 32:29" /><verse number="30" style="v" sid="NUM 32:30" />但如果他們不願武裝起來與你們一同過河，他們就要在<char style="pn">迦南</char>地與你們同分產業。」<verse eid="NUM 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31" />
    <char style="pn">迦得</char>子孫和<char style="pn">魯本</char>子孫回應說：「耶和華所吩咐你僕人們的，我們都必照樣遵行。 <verse eid="NUM 32:31" /><verse number="32" style="v" sid="NUM 32:32" />我們會武裝起來，在耶和華面前過河到<char style="pn">迦南</char>地，而我們繼承的地業是在<char style="pn">約旦</char>河這邊。」<verse eid="NUM 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33" />於是，<char style="pn">摩西</char>把<char style="pn">亞摩利</char>王<char style="pn">西宏</char>的王國和<char style="pn">巴珊</char>王<char style="pn">歐革</char>的王國，就是他們境內的土地連同城鎮，以及周圍的土地和城鎮，都分給了<char style="pn">迦得</char>子孫和<char style="pn">魯本</char>子孫，以及<char style="pn">約瑟</char>的兒子<char style="pn">瑪拿西</char>半支派。 <verse eid="NUM 32:33" /><verse number="34" style="v" sid="NUM 32:34" /><char style="pn">迦得</char>子孫就建造了<char style="pn">迪本</char>、<char style="pn">亞塔羅</char>、<char style="pn">亞羅珥</char>、 <verse eid="NUM 32:34" /><verse number="35" style="v" sid="NUM 32:35" /><char style="pn">亞他錄-朔反</char>、<char style="pn">雅謝</char>、<char style="pn">約比哈</char>、 <verse eid="NUM 32:35" /><verse number="36" style="v" sid="NUM 32:36" /><char style="pn">伯寧拉</char>、<char style="pn">伯哈蘭</char>，都是堅固的城，並建造了牲畜圍欄。 <verse eid="NUM 32:36" /><verse number="37" style="v" sid="NUM 32:37" /><char style="pn">魯本</char>子孫建造了<char style="pn">希實本</char>、<char style="pn">以利亞利</char>、<char style="pn">基列亭</char>、 <verse eid="NUM 32:37" /><verse number="38" style="v" sid="NUM 32:38" /><char style="pn">尼波</char>、<char style="pn">巴力梅翁</char>（這些名字是被改的）、<char style="pn">西比瑪</char>。他們給所建造的城都起了別的名字。<verse eid="NUM 32:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39" />
    <char style="pn">瑪拿西</char>的兒子<char style="pn">瑪吉</char>的子孫往<char style="pn">基列</char>去，攻取那地，把那裡的<char style="pn">亞摩利</char>人趕了出去。 <verse eid="NUM 32:39" /><verse number="40" style="v" sid="NUM 32:40" />於是<char style="pn">摩西</char>把<char style="pn">基列</char>分給<char style="pn">瑪拿西</char>的兒子<char style="pn">瑪吉</char>，他就住在那裡。 <verse eid="NUM 32:40" /><verse number="41" style="v" sid="NUM 32:41" /><char style="pn">瑪拿西</char>的兒子<char style="pn">睚珥</char>也前去，攻取了<char style="pn">亞摩利</char>人的一些村鎮，就稱它們為<char style="pn">睚珥</char>鎮。 <verse eid="NUM 32:41" /><verse number="42" style="v" sid="NUM 32:42" /><char style="pn">挪巴</char>也前去，攻取了<char style="pn">基納</char>和附屬的村鎮，就以自己的名字稱<char style="pn">基納</char>為<char style="pn">挪巴</char>。<verse eid="NUM 32:42" /></para>
  <chapter eid="NUM 32" />
  <chapter number="33" style="c" sid="NUM 33" />
  <para style="s">曠野行程回顧</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1" />以下是<char style="pn">以色列</char>子民在<char style="pn">摩西</char>和<char style="pn">亞倫</char>的指揮下，按隊伍出<char style="pn">埃及</char>地的行程。 <verse eid="NUM 33:1" /><verse number="2" style="v" sid="NUM 33:2" /><char style="pn">摩西</char>照著耶和華的指示，記下他們每段行程的起點，以下是他們行程的各起點：<verse eid="NUM 33:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="NUM 33:3" />一月十五日，就是逾越節的第二天，<char style="pn">以色列</char>子孫從<char style="pn">拉美西斯</char>起程，在全體<char style="pn">埃及</char>人眼前昂然無懼地<note caller="+" style="f"><char style="fr" closed="false">33:3 </char><char style="ft" closed="false">昂然無懼地——原文直譯「高舉著手」。</char></note>出來了。 <verse eid="NUM 33:3" /><verse number="4" style="v" sid="NUM 33:4" />那時<char style="pn">埃及</char>人正在埋葬他們的長子，就是耶和華在他們中間所擊殺的；耶和華也對他們的神明施行了審判。 <verse eid="NUM 33:4" /><verse number="5" style="v" sid="NUM 33:5" /><char style="pn">以色列</char>子孫從<char style="pn">拉美西斯</char>起程，在<char style="pn">疏割</char>紮營。<verse eid="NUM 33:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 33:6" />然後從<char style="pn">疏割</char>起行，在曠野邊緣的<char style="pn">伊坦</char>紮營。<verse eid="NUM 33:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="NUM 33:7" />又從<char style="pn">伊坦</char>起行，然後轉回到<char style="pn">巴力洗分</char>前面的<char style="pn">比哈希錄</char>，在<char style="pn">密奪</char>附近紮營。<verse eid="NUM 33:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="NUM 33:8" />然後從<char style="pn">比哈希錄</char>前面起行，從海裡走過，到了曠野；又在<char style="pn">伊坦</char>曠野走了三天的路程，在<char style="pn">瑪拉</char>紮營。<verse eid="NUM 33:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="NUM 33:9" />再從<char style="pn">瑪拉</char>起行，來到<char style="pn">伊利姆</char>，<char style="pn">伊利姆</char>有十二股水泉和七十棵棕櫚樹；他們在那裡紮營。<verse eid="NUM 33:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 33:10" />然後從<char style="pn">伊利姆</char>起行，在<char style="pn">紅海</char>邊紮營。<verse eid="NUM 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NUM 33:11" />又從<char style="pn">紅海</char>起行，在<char style="pn">汛</char>的曠野紮營。<verse eid="NUM 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NUM 33:12" />然後從<char style="pn">汛</char>的曠野起行，在<char style="pn">多夫卡</char>紮營。<verse eid="NUM 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NUM 33:13" />又從<char style="pn">多夫卡</char>起行，在<char style="pn">阿盧什</char>紮營。<verse eid="NUM 33:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="NUM 33:14" />再從<char style="pn">阿盧什</char>起行，在<char style="pn">利菲迪姆</char>紮營；</para>
  <para style="q1" vid="NUM 33:14">在那裡，百姓沒有水喝。<verse eid="NUM 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NUM 33:15" />從<char style="pn">利菲迪姆</char>起行，在<char style="pn">西奈</char>曠野紮營。<verse eid="NUM 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 33:16" />從<char style="pn">西奈</char>曠野起行，在<char style="pn">基布羅-哈特瓦</char>紮營。<verse eid="NUM 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 33:17" />從<char style="pn">基布羅-哈特瓦</char>起行，在<char style="pn">哈洗錄</char>紮營。<verse eid="NUM 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 33:18" />從<char style="pn">哈洗錄</char>起行，在<char style="pn">利提瑪</char>紮營。<verse eid="NUM 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 33:19" />從<char style="pn">利提瑪</char>起行，在<char style="pn">臨門-法勒斯</char>紮營。<verse eid="NUM 33:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 33:20" />從<char style="pn">臨門-法勒斯</char>起行，在<char style="pn">立拿</char>紮營。<verse eid="NUM 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 33:21" />從<char style="pn">立拿</char>起行，在<char style="pn">利撒</char>紮營。<verse eid="NUM 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 33:22" />從<char style="pn">利撒</char>起行，在<char style="pn">克希拉塔</char>紮營。<verse eid="NUM 33:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 33:23" />從<char style="pn">克希拉塔</char>起行，在<char style="pn">沙斐</char>山紮營。<verse eid="NUM 33:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 33:24" />從<char style="pn">沙斐</char>山起行，在<char style="pn">哈拉達</char>紮營。<verse eid="NUM 33:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 33:25" />從<char style="pn">哈拉達</char>起行，在<char style="pn">瑪克希錄</char>紮營。<verse eid="NUM 33:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 33:26" />從<char style="pn">瑪克希錄</char>起行，在<char style="pn">塔哈特</char>紮營。<verse eid="NUM 33:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="NUM 33:27" />從<char style="pn">塔哈特</char>起行，在<char style="pn">塔拉</char>紮營。<verse eid="NUM 33:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 33:28" />從<char style="pn">塔拉</char>起行，在<char style="pn">米特卡</char>紮營。<verse eid="NUM 33:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 33:29" />從<char style="pn">米特卡</char>起行，在<char style="pn">哈什莫納</char>紮營。<verse eid="NUM 33:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 33:30" />從<char style="pn">哈什莫納</char>起行，在<char style="pn">莫西洛</char>紮營。<verse eid="NUM 33:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="NUM 33:31" />從<char style="pn">莫西洛</char>起行，在<char style="pn">比尼-亞干</char>紮營。<verse eid="NUM 33:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="NUM 33:32" />從<char style="pn">比尼-亞干</char>起行，在<char style="pn">霍-哈吉加德</char>紮營。<verse eid="NUM 33:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="NUM 33:33" />從<char style="pn">霍-哈吉加德</char>起行，在<char style="pn">約特瓦塔</char>紮營。<verse eid="NUM 33:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="NUM 33:34" />從<char style="pn">約特瓦塔</char>起行，在<char style="pn">阿博拿</char>紮營。<verse eid="NUM 33:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="NUM 33:35" />從<char style="pn">阿博拿</char>起行，在<char style="pn">以旬迦別</char>紮營。<verse eid="NUM 33:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="NUM 33:36" />從<char style="pn">以旬迦別</char>起行，在<char style="pn">尋</char>的曠野，就是<char style="pn">加低斯</char>紮營。<verse eid="NUM 33:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="NUM 33:37" />然後從<char style="pn">加低斯</char>起行，在<char style="pn">以東</char>地邊界的<char style="pn">何珥</char>山紮營。 <verse eid="NUM 33:37" /><verse number="38" style="v" sid="NUM 33:38" /><char style="pn">以色列</char>子孫出<char style="pn">埃及</char>地之後，第四十年的五月一日，祭司<char style="pn">亞倫</char>按照耶和華的指示上<char style="pn">何珥</char>山，然後死在那裡。 <verse eid="NUM 33:38" /><verse number="39" style="v" sid="NUM 33:39" /><char style="pn">亞倫</char>死在<char style="pn">何珥</char>山上的時候，一百二十三歲。 <verse eid="NUM 33:39" /><verse number="40" style="v" sid="NUM 33:40" />那時，住在<char style="pn">迦南</char>地南方<note caller="+" style="f"><char style="fr" closed="false">33:40 </char><char style="ft" closed="false">南方——音譯作「尼革夫」。</char></note>的<char style="pn">迦南</char>王<char style="pn">阿拉德</char>，聽說<char style="pn">以色列</char>人來了。<verse eid="NUM 33:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="NUM 33:41" />
    <char style="pn">以色列</char>子孫又從<char style="pn">何珥</char>山起行，在<char style="pn">撒摩拿</char>紮營。<verse eid="NUM 33:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="NUM 33:42" />然後從<char style="pn">撒摩拿</char>起行，在<char style="pn">普嫩</char>紮營。<verse eid="NUM 33:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="NUM 33:43" />從<char style="pn">普嫩</char>起行，在<char style="pn">奧伯特</char>紮營。<verse eid="NUM 33:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="NUM 33:44" />從<char style="pn">奧伯特</char>起行，在<char style="pn">摩押</char>邊界上的<char style="pn">伊耶-亞巴琳</char>紮營。<verse eid="NUM 33:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="NUM 33:45" />從<char style="pn">伊音</char><note caller="+" style="f"><char style="fr" closed="false">33:45 </char><char style="ft" closed="false">伊音——指伊耶-亞巴琳。</char></note>起行，在<char style="pn">迪本-迦得</char>紮營。<verse eid="NUM 33:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="NUM 33:46" />從<char style="pn">迪本-迦得</char>起行，在<char style="pn">阿勒蒙-迪布拉泰姆</char>紮營。<verse eid="NUM 33:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="NUM 33:47" />從<char style="pn">阿勒蒙-迪布拉泰姆</char>起行，在<char style="pn">尼波</char>對面的<char style="pn">亞巴琳</char>山紮營。<verse eid="NUM 33:47" /></para>
  <para style="mi">
    <verse number="48" style="v" sid="NUM 33:48" />從<char style="pn">亞巴琳</char>山起行，在<char style="pn">耶利哥</char>東邊<char style="pn">約旦</char>河對面的<char style="pn">摩押</char>平原紮營。 <verse eid="NUM 33:48" /><verse number="49" style="v" sid="NUM 33:49" />他們在<char style="pn">摩押</char>平原沿著<char style="pn">約旦</char>河紮營，從<char style="pn">伯耶西莫</char>直到<char style="pn">阿貝勒什亭</char>。<verse eid="NUM 33:49" /></para>
  <para style="s">繼承迦南的指示</para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50" />那時，耶和華在<char style="pn">耶利哥</char>東邊<char style="pn">約旦</char>河對面的<char style="pn">摩押</char>平原指示<char style="pn">摩西</char>說： <verse eid="NUM 33:50" /><verse number="51" style="v" sid="NUM 33:51" />「你要吩咐<char style="pn">以色列</char>子民，對他們說：當你們過了<char style="pn">約旦</char>河，到<char style="pn">迦南</char>地時， <verse eid="NUM 33:51" /><verse number="52" style="v" sid="NUM 33:52" />要把那地的居民全都從你們面前趕出去，並且毀掉他們所有的雕像，毀掉他們所鑄造的一切偶像，拆毀他們所有的高壇。 <verse eid="NUM 33:52" /><verse number="53" style="v" sid="NUM 33:53" />你們要占有那地，住在其中，因為我已經把那地賜給你們，讓你們繼承它。 <verse eid="NUM 33:53" /><verse number="54" style="v" sid="NUM 33:54" />你們要按家族，以抽籤的方式分得那地為繼業。人多的，多給他們繼業；人少的，少給他們繼業；籤抽到哪裡，哪裡就歸屬那人。你們要按你們的父系支派分得繼業。 <verse eid="NUM 33:54" /><verse number="55" style="v" sid="NUM 33:55" />但如果你們不把那地的居民從你們面前趕出去，你所留下的那些人必成為你們眼中的刺、肋旁的荊棘，他們會在你們所住的地上擾害你們； <verse eid="NUM 33:55" /><verse number="56" style="v" sid="NUM 33:56" />而且，我曾怎樣計劃對待他們，也將怎樣對待你們。」<verse eid="NUM 33:56" /></para>
  <chapter eid="NUM 33" />
  <chapter number="34" style="c" sid="NUM 34" />
  <para style="s">應許之地的邊界</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 34:1" /><verse number="2" style="v" sid="NUM 34:2" />「你要吩咐<char style="pn">以色列</char>子民，對他們說：你們進入<char style="pn">迦南</char>地之後分得為繼業的<char style="pn">迦南</char>之地，其邊界如下：<verse eid="NUM 34:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="NUM 34:3" />你們的南端是從<char style="pn">尋</char>的曠野起，沿著<char style="pn">以東</char>的邊境延伸；南面的邊界是從鹽海的東邊開始。 <verse eid="NUM 34:3" /><verse number="4" style="v" sid="NUM 34:4" />邊界從<char style="pn">阿克拉賓</char>斜坡的南邊轉過去，經過<char style="pn">尋</char>的曠野，抵達<char style="pn">加低斯-巴尼亞</char>南邊的盡頭，然後延伸到<char style="pn">哈薩-阿達爾</char>，再經過<char style="pn">阿茲蒙</char>。 <verse eid="NUM 34:4" /><verse number="5" style="v" sid="NUM 34:5" />邊界接著從<char style="pn">阿茲蒙</char>轉到<char style="pn">埃及</char>河，終點是大海<note caller="+" style="f"><char style="fr" closed="false">34:5 </char><char style="ft" closed="false">大海——指地中海；下同。</char></note>。<verse eid="NUM 34:5" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="6" style="v" sid="NUM 34:6" />至於你們西面的邊界，是大海和海岸線；這就是你們西面的邊界。<verse eid="NUM 34:6" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="7" style="v" sid="NUM 34:7" />你們北面的邊界如下：從大海開始，劃界到<char style="pn">何珥</char>山。 <verse eid="NUM 34:7" /><verse number="8" style="v" sid="NUM 34:8" />又從<char style="pn">何珥</char>山劃界到<char style="pn">哈馬</char>隘口，終點是<char style="pn">澤達德</char>。 <verse eid="NUM 34:8" /><verse number="9" style="v" sid="NUM 34:9" />邊界又延伸到<char style="pn">基弗侖</char>，終點是<char style="pn">哈薩耶楠</char>。這就是你們北面的邊界。<verse eid="NUM 34:9" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="10" style="v" sid="NUM 34:10" />你們東面的邊界，要從<char style="pn">哈薩耶楠</char>劃界到<char style="pn">謝法姆</char>。 <verse eid="NUM 34:10" /><verse number="11" style="v" sid="NUM 34:11" />邊界從<char style="pn">謝法姆</char>下到<char style="pn">阿音</char>東邊的<char style="pn">利比拉</char>，然後往下，<char style="pn">伸展</char>到<char style="pn">革尼勒</char>湖<note caller="+" style="f"><char style="fr" closed="false">34:11 </char><char style="ft" closed="false">革尼勒湖——指加利利海；又稱「革尼撒勒湖、太巴列湖」。</char></note>的東側。 <verse eid="NUM 34:11" /><verse number="12" style="v" sid="NUM 34:12" />又下到<char style="pn">約旦</char>河，終點是鹽海。</para>
  <para style="b" vid="NUM 34:12" />
  <para style="mi" vid="NUM 34:12">以上就是你們土地四圍的邊界。」<verse eid="NUM 34:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13" />於是，<char style="pn">摩西</char>吩咐<char style="pn">以色列</char>子民說：「這是你們要以抽籤的方式來繼承的土地，是耶和華指示要分給九個半支派的。 <verse eid="NUM 34:13" /><verse number="14" style="v" sid="NUM 34:14" />因為<char style="pn">魯本</char>支派按父家取得了他們的繼業，<char style="pn">迦得</char>支派按父家取得了他們的繼業，<char style="pn">瑪拿西</char>半支派也取得了他們的繼業， <verse eid="NUM 34:14" /><verse number="15" style="v" sid="NUM 34:15" />這兩個半支派已經在<char style="pn">耶利哥</char>對面，<char style="pn">約旦</char>河東邊日出的方向，取得了他們的繼業。」<verse eid="NUM 34:15" /></para>
  <para style="s">分配土地的領袖們</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 34:16" /><verse number="17" style="v" sid="NUM 34:17" />「以下是要為你們分配地業之人的名字：祭司<char style="pn">以利亞撒</char>，<char style="pn">嫩</char>的兒子<char style="pn">約書亞</char>。 <verse eid="NUM 34:17" /><verse number="18" style="v" sid="NUM 34:18" />還要從每支派選出一位領袖，來協助分配土地為繼業， <verse eid="NUM 34:18" /><verse number="19" style="v" sid="NUM 34:19" />這些人的名字是：</para>
  <para style="q1" vid="NUM 34:19">
    <char style="pn">耶弗尼</char>的兒子<char style="pn">迦勒</char>，</para>
  <para style="q1" vid="NUM 34:19">屬<char style="pn">猶大</char>支派；<verse eid="NUM 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 34:20" />
    <char style="pn">亞米忽</char>的兒子<char style="pn">撒母耳</char>，</para>
  <para style="q1" vid="NUM 34:20">屬<char style="pn">西緬</char>支派；<verse eid="NUM 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 34:21" />
    <char style="pn">基斯倫</char>的兒子<char style="pn">伊利達德</char>，</para>
  <para style="q1" vid="NUM 34:21">屬<char style="pn">便雅憫</char>支派；<verse eid="NUM 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 34:22" />
    <char style="pn">約格力</char>的兒子<char style="pn">布其</char>，</para>
  <para style="q1" vid="NUM 34:22">是<char style="pn">但</char>支派的領袖；<verse eid="NUM 34:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 34:23" />
    <char style="pn">約瑟</char>子孫<char style="pn">以弗</char>的兒子<char style="pn">哈尼業</char>，</para>
  <para style="q1" vid="NUM 34:23">是<char style="pn">瑪拿西</char>支派的領袖；<verse eid="NUM 34:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 34:24" />
    <char style="pn">示弗坦</char>的兒子<char style="pn">基姆利</char>，</para>
  <para style="q1" vid="NUM 34:24">是<char style="pn">以法蓮</char>支派的領袖；<verse eid="NUM 34:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 34:25" />
    <char style="pn">帕爾納克</char>的兒子<char style="pn">以利撒番</char>，</para>
  <para style="q1" vid="NUM 34:25">是<char style="pn">西布倫</char>支派的領袖；<verse eid="NUM 34:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 34:26" />
    <char style="pn">阿贊</char>的兒子<char style="pn">帕爾提業</char>，</para>
  <para style="q1" vid="NUM 34:26">是<char style="pn">以薩迦</char>支派的領袖；<verse eid="NUM 34:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="NUM 34:27" />
    <char style="pn">示羅米</char>的兒子<char style="pn">亞希忽</char>，</para>
  <para style="q1" vid="NUM 34:27">是<char style="pn">亞設</char>支派的領袖；<verse eid="NUM 34:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 34:28" />
    <char style="pn">亞米忽</char>的兒子<char style="pn">佩達業</char>，</para>
  <para style="q1" vid="NUM 34:28">是<char style="pn">拿弗他利</char>支派的領袖。<verse eid="NUM 34:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="NUM 34:29" />以上就是耶和華所吩咐，要在<char style="pn">迦南</char>地給<char style="pn">以色列</char>子孫分配繼業的人。」<verse eid="NUM 34:29" /></para>
  <chapter eid="NUM 34" />
  <chapter number="35" style="c" sid="NUM 35" />
  <para style="s">利未人的城</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1" />耶和華在<char style="pn">耶利哥</char>東邊<char style="pn">約旦</char>河對面的<char style="pn">摩押</char>平原，指示<char style="pn">摩西</char>說： <verse eid="NUM 35:1" /><verse number="2" style="v" sid="NUM 35:2" />「你要吩咐<char style="pn">以色列</char>子民，讓他們從所得的繼業中，分給<char style="pn">利未</char>人一些城居住，也把這些城周圍的牧野給<char style="pn">利未</char>人。 <verse eid="NUM 35:2" /><verse number="3" style="v" sid="NUM 35:3" />這些城要用來給他們居住，而牧野用來安置他們所擁有的牛羊<note caller="+" style="f"><char style="fr" closed="false">35:3 </char><char style="ft" closed="false">他們所擁有的牛羊——或譯作「他們的牛羊、他們的財物」。</char></note>和一切牲畜。 <verse eid="NUM 35:3" /><verse number="4" style="v" sid="NUM 35:4" />你們給<char style="pn">利未</char>人的那些城郊牧野，要從城牆算起，四圍向外一千肘<note caller="+" style="f"><char style="fr" closed="false">35:4 </char><char style="ft" closed="false">一千肘——相當於457公尺。1肘=45.7公分。</char></note>； <verse eid="NUM 35:4" /><verse number="5" style="v" sid="NUM 35:5" />然後從城外那裡測量，向東邊兩千肘<note caller="+" style="f"><char style="fr" closed="false">35:5 </char><char style="ft" closed="false">兩千肘——相當於914公尺；下同。</char></note>，向南邊兩千肘，向西邊兩千肘，向北邊兩千肘，城要在中間。這是給他們的城郊牧野。<verse eid="NUM 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6" />「你們給<char style="pn">利未</char>人的城，其中要有六座逃城，讓過失殺人者可以逃到那裡；在六座之外，還要給他們四十二座城。 <verse eid="NUM 35:6" /><verse number="7" style="v" sid="NUM 35:7" />你們要給<char style="pn">利未</char>人的城一共是四十八座城，還包括城郊的牧野。 <verse eid="NUM 35:7" /><verse number="8" style="v" sid="NUM 35:8" />你們從<char style="pn">以色列</char>子孫的產業中分給<char style="pn">利未</char>人那些城，多的要多給，少的要少給。各支派要根據所得的繼業，把一些城分給<char style="pn">利未</char>人。」<verse eid="NUM 35:8" /></para>
  <para style="s">逃城</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9" />耶和華指示<char style="pn">摩西</char>說： <verse eid="NUM 35:9" /><verse number="10" style="v" sid="NUM 35:10" />「你要吩咐<char style="pn">以色列</char>子民，對他們說：當你們過了<char style="pn">約旦</char>河，到<char style="pn">迦南</char>地時， <verse eid="NUM 35:10" /><verse number="11" style="v" sid="NUM 35:11" />要為自己選定幾座城作逃城，使無意中殺了人的凶手可以逃到那裡。 <verse eid="NUM 35:11" /><verse number="12" style="v" sid="NUM 35:12" />這些城要作你們逃避報血仇者的避難所，這樣過失殺人者就不至於死，等候站在會眾面前受審判。 <verse eid="NUM 35:12" /><verse number="13" style="v" sid="NUM 35:13" />你們分給<char style="pn">利未</char>人的城，有六座要為你們作逃城： <verse eid="NUM 35:13" /><verse number="14" style="v" sid="NUM 35:14" />在<char style="pn">約旦</char>河對岸指定三座城，在<char style="pn">迦南</char>地也指定三座城，作為逃城。 <verse eid="NUM 35:14" /><verse number="15" style="v" sid="NUM 35:15" />這六座城要給<char style="pn">以色列</char>子孫，以及那些外人和寄居在他們中間的人作避難所，好讓任何無意中殺了人的可以逃到那裡。<verse eid="NUM 35:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16" />「但如果有人用鐵器打人致死，他就是故意殺人的，這凶手必須被處死。 <verse eid="NUM 35:16" /><verse number="17" style="v" sid="NUM 35:17" />如果有人手裡拿著可打死人的石頭打人致死，他就是故意殺人的，這凶手必須被處死。 <verse eid="NUM 35:17" /><verse number="18" style="v" sid="NUM 35:18" />或者有人手裡拿著可打死人的木器打人致死，他就是故意殺人的，這凶手必須被處死。 <verse eid="NUM 35:18" /><verse number="19" style="v" sid="NUM 35:19" />報血仇的人要親自把凶手處死，遇見他時，就要處死他。 <verse eid="NUM 35:19" /><verse number="20" style="v" sid="NUM 35:20" />如果有人因仇恨推倒人或故意向人扔東西，致其死亡， <verse eid="NUM 35:20" /><verse number="21" style="v" sid="NUM 35:21" />或者因仇恨動手打人致死，這打死人的必須被處死，他是故意殺人的。報血仇的人遇見凶手時，就要把他處死。<verse eid="NUM 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22" />「如果有人毫無仇恨而突然推倒了人，或者並非故意把任何器具扔在人身上， <verse eid="NUM 35:22" /><verse number="23" style="v" sid="NUM 35:23" />或者因沒看見而把任何可打死人的石頭砸在人身上，致其死亡，他本不是那人的仇敵，也不是謀害那人， <verse eid="NUM 35:23" /><verse number="24" style="v" sid="NUM 35:24" />會眾就要在這凶手和報血仇的人之間，按照這些法規審判。 <verse eid="NUM 35:24" /><verse number="25" style="v" sid="NUM 35:25" />會眾要從報血仇的人手中救出這過失殺人者，讓他回到他曾逃入的逃城。他要住在城中，直到以聖油膏立的大祭司去世。<verse eid="NUM 35:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26" />「但如果那過失殺人者擅自出了他所逃入的逃城的地界， <verse eid="NUM 35:26" /><verse number="27" style="v" sid="NUM 35:27" />報血仇的人在逃城地界外遇見那殺人者，把他殺了，報血仇的人並不負血債。 <verse eid="NUM 35:27" /><verse number="28" style="v" sid="NUM 35:28" />因為那過失殺人者應該留在逃城，直到大祭司去世；大祭司去世以後，他才可以回到他產業之地。 <verse eid="NUM 35:28" /><verse number="29" style="v" sid="NUM 35:29" />這要在你們居住的任何地方，作你們世世代代的律例法規。<verse eid="NUM 35:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30" />「無論誰殺了人，都要憑幾個見證人的口來處決凶手；不可只憑一個見證人的指證來處死人。 <verse eid="NUM 35:30" /><verse number="31" style="v" sid="NUM 35:31" />你們不可接受贖金來保全殺人者的性命，他犯了死罪，必須被處死。 <verse eid="NUM 35:31" /><verse number="32" style="v" sid="NUM 35:32" />你們也不可接受那逃入逃城之人的贖金，讓他在大祭司去世之前回本地居住。<verse eid="NUM 35:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 35:33" />「這樣，你們就不會玷汙你們所在之地，因為血會使地玷汙；如果有血流在地上，除非藉著那流人血之人的血，地就無法贖清罪污。 <verse eid="NUM 35:33" /><verse number="34" style="v" sid="NUM 35:34" />你們不可玷汙所住之地，因為我也住在那裡，我耶和華就住在<char style="pn">以色列</char>子民中間。」<verse eid="NUM 35:34" /></para>
  <chapter eid="NUM 35" />
  <chapter number="36" style="c" sid="NUM 36" />
  <para style="s">西羅非哈女兒們的產業</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1" />
    <char style="pn">約瑟</char>子孫的家族中，<char style="pn">瑪拿西</char>的孫子、<char style="pn">瑪吉</char>的兒子<char style="pn">基列</char>的子孫各家族的父系首領上前來，在<char style="pn">摩西</char>和領袖們——<char style="pn">以色列</char>子孫的各父系首領們面前申訴， <verse eid="NUM 36:1" /><verse number="2" style="v" sid="NUM 36:2" />說：「耶和華曾吩咐我主以抽籤的方式把地分給<char style="pn">以色列</char>子孫為繼業，我主又受耶和華的吩咐，要把我們兄弟<char style="pn">西羅非哈</char>的繼業給他的女兒們。 <verse eid="NUM 36:2" /><verse number="3" style="v" sid="NUM 36:3" />可是，如果她們嫁給<char style="pn">以色列</char>子孫其他支派的人，那麼她們的繼業就會從我們祖先的繼業中減去，加到她們丈夫<note caller="+" style="f"><char style="fr" closed="false">36:3 </char><char style="ft" closed="false">丈夫——原文直譯「所屬的」；下同。</char></note>那個支派的繼業上，這繼業就從我們抽籤所得的繼業中減去了。 <verse eid="NUM 36:3" /><verse number="4" style="v" sid="NUM 36:4" />即使到了<char style="pn">以色列</char>子孫的禧年，她們的繼業也會被加到她們丈夫那個支派的繼業上。這樣，她們的繼業就從我們父家支派的繼業中減去了。」<verse eid="NUM 36:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5" />
    <char style="pn">摩西</char>按照耶和華的指示，吩咐<char style="pn">以色列</char>子民說：「<char style="pn">約瑟</char>支派的人說得對。 <verse eid="NUM 36:5" /><verse number="6" style="v" sid="NUM 36:6" />這是耶和華關於<char style="pn">西羅非哈</char>的女兒們所指示的話：她們可以嫁給自己眼中看為好的，只是必須嫁給自己父系支派家族的人。 <verse eid="NUM 36:6" /><verse number="7" style="v" sid="NUM 36:7" />這樣，<char style="pn">以色列</char>子孫的繼業就不會從一個支派轉到另一個支派了；<char style="pn">以色列</char>子孫必須守住各自父家支派的繼業。 <verse eid="NUM 36:7" /><verse number="8" style="v" sid="NUM 36:8" /><char style="pn">以色列</char>子孫各支派中凡是繼承產業的女子，只能嫁給她父系支派家族中的人，好讓<char style="pn">以色列</char>子孫能各自繼承自己祖先的產業。 <verse eid="NUM 36:8" /><verse number="9" style="v" sid="NUM 36:9" />這樣，繼業就不會從一個支派轉到另一個支派了；<char style="pn">以色列</char>子孫各支派必須守住各自的繼業。」<verse eid="NUM 36:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10" />耶和華怎樣指示<char style="pn">摩西</char>，<char style="pn">西羅非哈</char>的女兒們就怎樣做。 <verse eid="NUM 36:10" /><verse number="11" style="v" sid="NUM 36:11" /><char style="pn">西羅非哈</char>的女兒<char style="pn">瑪拉</char>、<char style="pn">提爾撒</char>、<char style="pn">霍格拉</char>、<char style="pn">米爾卡</char>、<char style="pn">挪阿</char>，嫁給了她們叔伯的兒子們為妻。 <verse eid="NUM 36:11" /><verse number="12" style="v" sid="NUM 36:12" />她們嫁給<char style="pn">約瑟</char>的兒子<char style="pn">瑪拿西</char>子孫家族中的人，這樣她們的繼業就留在了她們父系家族的支派中。<verse eid="NUM 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13" />以上是耶和華在<char style="pn">耶利哥</char>東邊<char style="pn">約旦</char>河對面的<char style="pn">摩押</char>平原，藉著<char style="pn">摩西</char>向<char style="pn">以色列</char>子民頒布的誡命和法規。<verse eid="NUM 36:13" /></para>
  <chapter eid="NUM 36" />
</usx>